        linarith
      have hzb : z ∈ Metric.ball y₁ r := hcbr z hz2.le
      obtain ⟨_, hell, hbd, _⟩ := H z hzb
      have hsec := s3 h hhC z hzloc
      have hpair := s1 (A z) (Matrix.of fun i j => partialDeriv i (partialDeriv j h) z)
