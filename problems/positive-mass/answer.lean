        volume ({z : E3 | @inner ℝ E3 _ (-q₂) z < 0 ∧
          @inner ℝ E3 _ (q₂ + δ • q₁) z < 0} \ L) = 0) →
      ∃ (E : Set E3) (q₁ q₂ p₁ p₂ : E3), (E = L ∨ E = Lᶜ) ∧ ‖q₁‖ = 1 ∧ ‖q₂‖ = 1 ∧
        LinearIndependent ℝ ![q₁, q₂] ∧
        (∀ z : E3, @inner ℝ E3 _ q₁ z ≤ 0 → @inner ℝ E3 _ q₂ z ≤ 0 →
          (@inner ℝ E3 _ q₁ z = 0 ∧ @inner ℝ E3 _ q₂ z = 0) ∨
          (@inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0)) ∧
        volume ({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩
          {z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧ @inner ℝ E3 _ q₂ z < 0} ∩ E) = 0 ∧
        volume (({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩
          {z : E3 | 0 < @inner ℝ E3 _ q₁ z ∨ 0 < @inner ℝ E3 _ q₂ z}) \ E) = 0 := by
    intro q₁ q₂ a b δ hq₁ hq₂ hind hδ ha1 ha2 hb2 hb1 hBa hBb hH₁ hH₂ hQ hT₁ hT₂
    obtain ⟨E, hE, hQE⟩ : ∃ E : Set E3, (E = L ∨ E = Lᶜ) ∧
        volume ({z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧ @inner ℝ E3 _ q₂ z < 0} ∩ E) = 0 := by
      rcases hQ with h | h
      · exact ⟨L, Or.inl rfl, h⟩
      · exact ⟨Lᶜ, Or.inr rfl, by rwa [← Set.diff_eq]⟩
    have hFa : ∀ S : Set E3, (volume (S ∩ L) = 0 ∨ volume (S \ L) = 0) →
        (volume (S ∩ E) = 0 ∨ volume (S \ E) = 0) := by
      rcases hE with rfl | rfl
      · exact fun S h => h
      · intro S h
        rcases h with h | h
        · right; rwa [Set.diff_compl]
        · left; rwa [← Set.diff_eq]
    have hFb : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) →
        ∀ N ∈ 𝓝 z, volume (N ∩ E) ≠ 0 := by
      rcases hE with rfl | rfl
      · exact fun z h N hN => (h N hN).1
      · intro z h N hN
        rw [← Set.diff_eq]
        exact (h N hN).2
    have hp1 : ∀ z : E3, @inner ℝ E3 _ (q₁ + δ • q₂) z =
        @inner ℝ E3 _ q₁ z + δ * @inner ℝ E3 _ q₂ z := by
      intro z; rw [inner_add_left, real_inner_smul_left]
    have hp2 : ∀ z : E3, @inner ℝ E3 _ (q₂ + δ • q₁) z =
        @inner ℝ E3 _ q₂ z + δ * @inner ℝ E3 _ q₁ z := by
      intro z; rw [inner_add_left, real_inner_smul_left]
    have hT1E : volume ({z : E3 | @inner ℝ E3 _ (-q₁) z < 0 ∧
        @inner ℝ E3 _ (q₁ + δ • q₂) z < 0} \ E) = 0 := by
      rcases hFa _ hT₁ with h | h
      · exfalso
        have hopen : IsOpen {z : E3 | @inner ℝ E3 _ q₂ z < 0 ∧
            @inner ℝ E3 _ (q₁ + δ • q₂) z < 0} :=
          (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ q₂ z) (by fun_prop)
            continuous_const).inter
            (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ (q₁ + δ • q₂) z) (by fun_prop)
              continuous_const)
        have hamem : a ∈ {z : E3 | @inner ℝ E3 _ q₂ z < 0 ∧
            @inner ℝ E3 _ (q₁ + δ • q₂) z < 0} := by
          refine ⟨ha2, ?_⟩
          rw [hp1, ha1, zero_add]
          exact mul_neg_of_pos_of_neg hδ ha2
        apply hFb a hBa _ (hopen.mem_nhds hamem)
        refine measure_mono_null ?_ (measure_union_null (measure_union_null hQE h) hH₁)
        rintro z ⟨⟨hz2, hzp⟩, hzE⟩
        rcases lt_trichotomy (@inner ℝ E3 _ q₁ z) 0 with h' | h' | h'
        · exact Or.inl (Or.inl ⟨⟨h', hz2⟩, hzE⟩)
        · exact Or.inr h'
        · refine Or.inl (Or.inr ⟨⟨?_, hzp⟩, hzE⟩)
          rw [inner_neg_left]; linarith
      · exact h
    have hT2E : volume ({z : E3 | @inner ℝ E3 _ (-q₂) z < 0 ∧
        @inner ℝ E3 _ (q₂ + δ • q₁) z < 0} \ E) = 0 := by
      rcases hFa _ hT₂ with h | h
      · exfalso
        have hopen : IsOpen {z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧
            @inner ℝ E3 _ (q₂ + δ • q₁) z < 0} :=
          (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ q₁ z) (by fun_prop)
            continuous_const).inter
            (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ (q₂ + δ • q₁) z) (by fun_prop)
              continuous_const)
        have hbmem : b ∈ {z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧
            @inner ℝ E3 _ (q₂ + δ • q₁) z < 0} := by
          refine ⟨hb1, ?_⟩
          rw [hp2, hb2, zero_add]
          exact mul_neg_of_pos_of_neg hδ hb1
        apply hFb b hBb _ (hopen.mem_nhds hbmem)
        refine measure_mono_null ?_ (measure_union_null (measure_union_null hQE h) hH₂)
        rintro z ⟨⟨hz1, hzp⟩, hzE⟩
        rcases lt_trichotomy (@inner ℝ E3 _ q₂ z) 0 with h' | h' | h'
        · exact Or.inl (Or.inl ⟨⟨hz1, h'⟩, hzE⟩)
        · exact Or.inr h'
        · refine Or.inl (Or.inr ⟨⟨?_, hzp⟩, hzE⟩)
          rw [inner_neg_left]; linarith
      · exact h
    refine ⟨E, q₁, q₂, q₁ + δ • q₂, q₂ + δ • q₁, hE, hq₁, hq₂, hind, ?_, ?_, ?_⟩
    · intro z hz1 hz2
      rw [hp1, hp2]
      rcases hz1.lt_or_eq with h1' | h1' <;> rcases hz2.lt_or_eq with h2' | h2'
      · right
        have := mul_neg_of_pos_of_neg hδ h1'
        have := mul_neg_of_pos_of_neg hδ h2'
        constructor <;> linarith
      · right
        have := mul_neg_of_pos_of_neg hδ h1'
        rw [h2']
        constructor <;> linarith
      · right
        have := mul_neg_of_pos_of_neg hδ h2'
        rw [h1']
        constructor <;> linarith
      · left; exact ⟨h1', h2'⟩
    · refine measure_mono_null ?_ hQE
      intro z hz
      exact ⟨hz.1.2, hz.2⟩
    · refine measure_mono_null ?_ (measure_union_null hT1E hT2E)
      rintro z ⟨⟨hP, h | h⟩, hzE⟩
      · refine Or.inl ⟨⟨?_, hP.1⟩, hzE⟩
        rw [inner_neg_left]; linarith
      · refine Or.inr ⟨⟨?_, hP.2⟩, hzE⟩
        rw [inner_neg_left]; linarith
  
  obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : Finset E3, Ψ = Φ.filter
      (fun φ => ∀ N ∈ 𝓝 φ, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) := ⟨_, rfl⟩
  have hΨmem : ∀ ψ : E3, ψ ∈ Ψ ↔
      ψ ∈ Φ ∧ ∀ N ∈ 𝓝 ψ, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0 := by
    intro ψ; rw [hΨdef, Finset.mem_filter]
  have hΨunit : ∀ ψ ∈ Ψ, ‖ψ‖ = 1 := fun ψ h => (hΦ ψ ((hΨmem ψ).1 h).1).1
  have hΨe : ∀ ψ ∈ Ψ, @inner ℝ E3 _ e ψ = 0 := fun ψ h => (hΦ ψ ((hΨmem ψ).1 h).1).2
  have hspan : ∀ a ∈ Ψ, ∀ b ∈ Ψ, LinearIndependent ℝ ![a, b] → ∀ v ∈ Ψ,
      ∃ s t : ℝ, v = s • a + t • b :=
    fun a ha b hb hab v hv => s4 a b v (hΨe a ha) (hΨe b hb) hab (hΨe v hv)
  have hcolor : ∀ x y : E3, @inner ℝ E3 _ e x = 0 → @inner ℝ E3 _ e y = 0 →
      (∀ φ ∈ Ψ, ¬ (@inner ℝ E3 _ x φ < 0 ∧ @inner ℝ E3 _ y φ < 0)) →
      volume ({z : E3 | @inner ℝ E3 _ x z < 0 ∧ @inner ℝ E3 _ y z < 0} ∩ L) = 0 ∨
        volume ({z : E3 | @inner ℝ E3 _ x z < 0 ∧ @inner ℝ E3 _ y z < 0} \ L) = 0 := by
    intro x y hex hey hav
    exact s1 L _ (s2 x y) (s3 x y hex hey (fun φ hφ hB => hav φ ((hΨmem φ).2 ⟨hφ, hB⟩)))
  have hne0 : ∀ q : E3, ‖q‖ = 1 → q ≠ 0 := by
    intro q hq h; rw [h, norm_zero] at hq; exact zero_ne_one hq
  rcases s5 Ψ hΨunit hspan with ⟨a, ha, b, hb, hab, hcorner⟩ | hdep
  · right
    obtain ⟨q₁, q₂, δ, hq₁, hq₂, hind, hδ, heq₁, heq₂, ha1, ha2, hb2, hb1, hiff, hav₁, hav₂⟩ :=
      s9 a b Ψ (hΨunit a ha) (hΨunit b hb) (hΨe a ha) (hΨe b hb) hab
    have hQ := hcolor q₁ q₂ heq₁ heq₂ (fun φ hφ h => hcorner φ hφ ((hiff φ).1 h))
    have he1 : @inner ℝ E3 _ e (-q₁) = 0 := by rw [inner_neg_right, heq₁, neg_zero]
    have he2 : @inner ℝ E3 _ e (-q₂) = 0 := by rw [inner_neg_right, heq₂, neg_zero]
    have he3 : @inner ℝ E3 _ e (q₁ + δ • q₂) = 0 := by
      rw [inner_add_right, real_inner_smul_right, heq₁, heq₂, mul_zero, add_zero]
    have he4 : @inner ℝ E3 _ e (q₂ + δ • q₁) = 0 := by
      rw [inner_add_right, real_inner_smul_right, heq₁, heq₂, mul_zero, add_zero]
    have hT₁ := hcolor (-q₁) (q₁ + δ • q₂) he1 he3 hav₁
    have hT₂ := hcolor (-q₂) (q₂ + δ • q₁) he2 he4 hav₂
    exact s10 q₁ q₂ a b δ hq₁ hq₂ hind hδ ha1 ha2 hb2 hb1 ((hΨmem a).1 ha).2
      ((hΨmem b).1 hb).2 (s7 q₁ (hne0 q₁ hq₁)) (s7 q₂ (hne0 q₂ hq₂)) hQ hT₁ hT₂
  · left
    obtain ⟨n, hn, hen, hall⟩ : ∃ n : E3, ‖n‖ = 1 ∧ @inner ℝ E3 _ e n = 0 ∧
        ∀ φ ∈ Ψ, @inner ℝ E3 _ n φ = 0 := by
      by_cases hne : Ψ.Nonempty
      · obtain ⟨a, ha⟩ := hne
        obtain ⟨n, hn, hen, han⟩ := s6 a
        refine ⟨n, hn, hen, fun φ hφ => ?_⟩
        have hnd := hdep a ha φ hφ
        rw [LinearIndependent.pair_iff] at hnd
        push_neg at hnd
        obtain ⟨s, t, hst, hst0⟩ := hnd
        have h := congrArg (fun w => @inner ℝ E3 _ n w) hst
        simp only [inner_add_right, real_inner_smul_right, inner_zero_right] at h
        have hna : @inner ℝ E3 _ n a = 0 := by rw [real_inner_comm]; exact han
        rw [hna, mul_zero, zero_add] at h
        rcases mul_eq_zero.1 h with ht | ht
        · exfalso
          have hs : s ≠ 0 := fun hs0 => hst0 hs0 ht
          rw [ht, zero_smul, add_zero] at hst
          rcases smul_eq_zero.1 hst with h' | h'
          · exact hs h'
          · exact hne0 a (hΨunit a ha) h'
        · exact ht
      · rw [Finset.not_nonempty_iff_eq_empty] at hne
        obtain ⟨n, hn, hen, -⟩ := s6 e
        refine ⟨n, hn, hen, fun φ hφ => ?_⟩
        rw [hne] at hφ
        simp at hφ
    have hA := hcolor n n hen hen (fun φ hφ h => by
      rw [hall φ hφ] at h; exact lt_irrefl _ h.1)
    have hen' : @inner ℝ E3 _ e (-n) = 0 := by rw [inner_neg_right, hen, neg_zero]
    have hB := hcolor (-n) (-n) hen' hen' (fun φ hφ h => by
      rw [inner_neg_left, hall φ hφ, neg_zero] at h; exact lt_irrefl _ h.1)
    exact s8 n hn (s7 n (hne0 n hn)) hA hB

theorem wedge_orthoframe (q₁ q₂ : E3) (hq₁ : ‖q₁‖ = 1) (hq₂ : ‖q₂‖ = 1) (hind : LinearIndependent ℝ ![q₁, q₂]) : ∃ (β : OrthonormalBasis (Fin 3) ℝ E3) (σ τ : ℝ), 0 < σ ∧ 0 < τ ∧ q₁ = (-σ) • β 0 + τ • β 1 ∧ q₂ = (-σ) • β 0 + (-τ) • β 1 :=
by
  have hsum : q₁ + q₂ ≠ 0 := by
    intro h
    have := (LinearIndependent.pair_iff.mp hind) 1 1 (by rw [one_smul, one_smul]; exact h)
    exact one_ne_zero this.1
  have hdiff : q₁ - q₂ ≠ 0 := by
    intro h
    have := (LinearIndependent.pair_iff.mp hind) 1 (-1)
      (by rw [one_smul, neg_one_smul, ← sub_eq_add_neg]; exact h)
    exact one_ne_zero this.1
  have hA0 : ‖q₁ + q₂‖ ≠ 0 := norm_ne_zero_iff.mpr hsum
  have hB0 : ‖q₁ - q₂‖ ≠ 0 := norm_ne_zero_iff.mpr hdiff
  have hApos : 0 < ‖q₁ + q₂‖ := norm_pos_iff.mpr hsum
  have hBpos : 0 < ‖q₁ - q₂‖ := norm_pos_iff.mpr hdiff
  obtain ⟨b, hb⟩ : ∃ b : E3, b = (-‖q₁ + q₂‖⁻¹) • (q₁ + q₂) := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : E3, c = ‖q₁ - q₂‖⁻¹ • (q₁ - q₂) := ⟨_, rfl⟩
  have hbn : ‖b‖ = 1 := by
    rw [hb, norm_smul, norm_neg, norm_inv, norm_norm, inv_mul_cancel₀ hA0]
  have hcn : ‖c‖ = 1 := by
    rw [hc, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hB0]
  have horth : @inner ℝ E3 _ (q₁ + q₂) (q₁ - q₂) = 0 :=
    (real_inner_add_sub_eq_zero_iff q₁ q₂).mpr (hq₁.trans hq₂.symm)
  have hbc : @inner ℝ E3 _ b c = 0 := by
    rw [hb, hc, real_inner_smul_left, real_inner_smul_right, horth, mul_zero, mul_zero]
  have hcb : @inner ℝ E3 _ c b = 0 := by
    rw [real_inner_comm]; exact hbc
  have hbb : @inner ℝ E3 _ b b = 1 := by
    rw [real_inner_self_eq_norm_sq, hbn, one_pow]
  have hcc : @inner ℝ E3 _ c c = 1 := by
    rw [real_inner_self_eq_norm_sq, hcn, one_pow]
  have hON : Orthonormal ℝ (({0, 1} : Set (Fin 3)).restrict ![b, c, 0]) := by
    rw [orthonormal_iff_ite]
    rintro ⟨i, hi⟩ ⟨j, hj⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hi hj
    rcases hi with rfl | rfl <;> rcases hj with rfl | rfl <;>
      simp [Set.restrict, hbb, hcc, hbc, hcb, hbn, hcn]
  have hdim : Module.finrank ℝ E3 = Fintype.card (Fin 3) := finrank_euclideanSpace
  obtain ⟨β, hβ⟩ := Orthonormal.exists_orthonormalBasis_extension_of_card_eq hdim hON
  have hβ0 : β 0 = b := by
    have := hβ 0 (by simp)
    simpa using this
  have hβ1 : β 1 = c := by
    have := hβ 1 (by simp)
    simpa using this
  refine ⟨β, ‖q₁ + q₂‖ / 2, ‖q₁ - q₂‖ / 2, by positivity, by positivity, ?_, ?_⟩
  · have h1 : -(‖q₁ + q₂‖ / 2) * -‖q₁ + q₂‖⁻¹ = 1 / 2 := by
      rw [neg_mul_neg, div_mul_eq_mul_div, mul_inv_cancel₀ hA0]
    have h2 : ‖q₁ - q₂‖ / 2 * ‖q₁ - q₂‖⁻¹ = 1 / 2 := by
      rw [div_mul_eq_mul_div, mul_inv_cancel₀ hB0]
    rw [hβ0, hβ1, hb, hc, smul_smul, smul_smul, h1, h2]
    module
  · have h1 : -(‖q₁ + q₂‖ / 2) * -‖q₁ + q₂‖⁻¹ = 1 / 2 := by
      rw [neg_mul_neg, div_mul_eq_mul_div, mul_inv_cancel₀ hA0]
    have h2 : -(‖q₁ - q₂‖ / 2) * ‖q₁ - q₂‖⁻¹ = -(1 / 2) := by
      rw [neg_mul, div_mul_eq_mul_div, mul_inv_cancel₀ hB0]
    rw [hβ0, hβ1, hb, hc, smul_smul, smul_smul, h1, h2]
    module

theorem cylPt_measurePreserving : MeasureTheory.MeasurePreserving (fun p : ℝ × ℝ × ℝ => cylPt p.1 p.2.1 p.2.2) volume volume :=
by
  have hA : MeasureTheory.MeasurePreserving
      (Prod.map id ⇑MeasurableEquiv.finTwoArrow.symm : ℝ × ℝ × ℝ → ℝ × (Fin 2 → ℝ))
      volume volume :=
    (MeasureTheory.MeasurePreserving.id (volume : MeasureTheory.Measure ℝ)).prod
      ((MeasureTheory.volume_preserving_finTwoArrow ℝ).symm _)
  have hB : MeasureTheory.MeasurePreserving
      (⇑(MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm :
        ℝ × (Fin 2 → ℝ) → (Fin 3 → ℝ)) volume volume :=
    (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm _
  have hC : MeasureTheory.MeasurePreserving
      (WithLp.toLp 2 : (Fin 3 → ℝ) → E3) volume volume :=
    PiLp.volume_preserving_toLp (Fin 3)
  have h := hC.comp (hB.comp hA)
  have heq : (fun p : ℝ × ℝ × ℝ => cylPt p.1 p.2.1 p.2.2) =
      (WithLp.toLp 2 : (Fin 3 → ℝ) → E3) ∘
        ((⇑(MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm :
          ℝ × (Fin 2 → ℝ) → (Fin 3 → ℝ)) ∘
          (Prod.map id ⇑MeasurableEquiv.finTwoArrow.symm : ℝ × ℝ × ℝ → ℝ × (Fin 2 → ℝ))) := by
    funext p
    obtain ⟨t, a, b⟩ := p
    apply PiLp.ext
    intro j
    fin_cases j <;>
      simp [cylPt, e, EuclideanSpace.single_apply, MeasurableEquiv.piFinSuccAbove_symm_apply,
        Fin.insertNthEquiv_apply, Fin.insertNth_zero', MeasurableEquiv.finTwoArrow_symm_apply] <;>
      rfl
  rw [heq]
  exact h

theorem prod3_shear_measurePreserving (c : ℝ) : MeasureTheory.MeasurePreserving (fun p : ℝ × ℝ × ℝ => (p.1, c * p.1 + p.2.1, p.2.2)) volume volume :=
by
  have hg : ∀ x : ℝ, MeasureTheory.Measure.map (fun q : ℝ × ℝ => (c * x + q.1, q.2))
      (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) = MeasureTheory.volume := by
    intro x
    have h := (MeasureTheory.measurePreserving_add_left
      (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) ((c * x, (0:ℝ)) : ℝ × ℝ)).map_eq
    have hfun : (fun q : ℝ × ℝ => (c * x + q.1, q.2)) = (fun q : ℝ × ℝ => ((c * x, (0:ℝ)) : ℝ × ℝ) + q) := by
      funext q
      ext <;> simp
    rw [hfun]
    exact h
  have hm : Measurable (Function.uncurry (fun (x : ℝ) (q : ℝ × ℝ) => (c * x + q.1, q.2))) := by
    have hc : Continuous (fun z : ℝ × ℝ × ℝ => (c * z.1 + z.2.1, z.2.2)) := by fun_prop
    exact hc.measurable
  exact (MeasureTheory.MeasurePreserving.id (MeasureTheory.volume : MeasureTheory.Measure ℝ)).skew_product
    (g := fun (x : ℝ) (q : ℝ × ℝ) => (c * x + q.1, q.2)) hm (Filter.Eventually.of_forall hg)

theorem cylShear_hasDerivAt (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (c t u s : ℝ) (i : Fin 3) : HasDerivAt (fun x : ℝ => X (cylPt x (c * x + u) s) i) (partialDeriv 0 (fun w => X w i) (cylPt t (c * t + u) s) + c * partialDeriv 1 (fun w => X w i) (cylPt t (c * t + u) s)) t ∧ HasDerivAt (fun x : ℝ => X (cylPt t (c * t + x) s) i) (partialDeriv 1 (fun w => X w i) (cylPt t (c * t + u) s)) u ∧ HasDerivAt (fun x : ℝ => X (cylPt t (c * t + u) x) i) (partialDeriv 2 (fun w => X w i) (cylPt t (c * t + u) s)) s :=
by
  have hf : ContDiff ℝ ∞ (fun w : E3 => X w i) := by
    have h := (EuclideanSpace.proj i : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).contDiff.comp hX
    exact h
  have hfd : Differentiable ℝ (fun w : E3 => X w i) := hf.differentiable (by simp)
  have hF : HasFDerivAt (fun w : E3 => X w i)
      (fderiv ℝ (fun w : E3 => X w i) (cylPt t (c * t + u) s)) (cylPt t (c * t + u) s) :=
    (hfd _).hasFDerivAt
  have g1 : HasDerivAt (fun x : ℝ => cylPt x (c * x + u) s) (e 0 + c • e 1) t := by
    have h := (((hasDerivAt_id' t).smul_const (e 0)).add
      ((((hasDerivAt_id' t).const_mul c).add_const u).smul_const (e 1))).add_const (s • e 2)
    unfold cylPt
    convert h using 1
    simp
  have g2 : HasDerivAt (fun x : ℝ => cylPt t (c * t + x) s) (e 1) u := by
    have h := ((((hasDerivAt_id' u).const_add (c * t)).smul_const (e 1)).const_add
      (t • e 0)).add_const (s • e 2)
    unfold cylPt
    convert h using 1
    simp
  have g3 : HasDerivAt (fun x : ℝ => cylPt t (c * t + u) x) (e 2) s := by
    have h := ((hasDerivAt_id' s).smul_const (e 2)).const_add (t • e 0 + (c * t + u) • e 1)
    unfold cylPt
    convert h using 1
    simp
  have h1 := HasFDerivAt.comp_hasDerivAt (x := t) (l := fun w : E3 => X w i) hF g1
  have h2 := HasFDerivAt.comp_hasDerivAt (x := u) (l := fun w : E3 => X w i) hF g2
  have h3 := HasFDerivAt.comp_hasDerivAt (x := s) (l := fun w : E3 => X w i) hF g3
  refine ⟨?_, h2, h3⟩
  convert h1 using 1
  rw [map_add, map_smul, smul_eq_mul]
  rfl

theorem divField_props (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (hc : HasCompactSupport X) (hpos : tsupport X ⊆ {z : E3 | 0 < z 0}) : (∀ i j : Fin 3, Continuous (fun z : E3 => partialDeriv j (fun w => X w i) z) ∧ HasCompactSupport (fun z : E3 => partialDeriv j (fun w => X w i) z)) ∧ (∀ i : Fin 3, Continuous (fun z : E3 => X z i) ∧ HasCompactSupport (fun z : E3 => X z i)) ∧ (∀ z : E3, z 0 ≤ 0 → ∀ i j : Fin 3, X z i = 0 ∧ partialDeriv j (fun w => X w i) z = 0) :=
by
  have hcomp : ∀ i : Fin 3, (fun w => X w i) = (EuclideanSpace.proj (𝕜 := ℝ) i : E3 →L[ℝ] ℝ) ∘ X := by
    intro i
    funext w
    rfl
  have hsm : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w => X w i) := by
    intro i
    rw [hcomp i]
    exact (EuclideanSpace.proj (𝕜 := ℝ) i : E3 →L[ℝ] ℝ).contDiff.comp hX
  have hcs : ∀ i : Fin 3, HasCompactSupport (fun w => X w i) := by
    intro i
    rw [hcomp i]
    exact hc.comp_left (by simp)
  have hts : ∀ i : Fin 3, tsupport (fun w => X w i) ⊆ tsupport X := by
    intro i
    rw [hcomp i]
    exact tsupport_comp_subset (by simp) X
  refine ⟨fun i j => ⟨?_, ?_⟩, fun i => ⟨(hsm i).continuous, hcs i⟩, fun z hz i j => ⟨?_, ?_⟩⟩
  · have hfd : Continuous (fderiv ℝ (fun w => X w i)) :=
      (hsm i).continuous_fderiv (by simp)
    exact hfd.clm_apply continuous_const
  · exact (hcs i).fderiv_apply ℝ (e j)
  · have hz' : z ∉ tsupport X := by
      intro h
      have := hpos h
      simp only [Set.mem_setOf_eq] at this
      linarith
    rw [image_eq_zero_of_notMem_tsupport hz']
    rfl
  · have hz' : z ∉ tsupport (fun w => X w i) := by
      intro h
      have := hpos (hts i h)
      simp only [Set.mem_setOf_eq] at this
      linarith
    show fderiv ℝ (fun w => X w i) z (e j) = 0
    rw [fderiv_of_notMem_tsupport ℝ hz']
    rfl

theorem cylShear_comp_compactSupport (g : E3 → ℝ) (hg : Continuous g) (hgc : HasCompactSupport g) (c : ℝ) : Continuous (fun p : ℝ × ℝ × ℝ => g (cylPt p.1 (c * p.1 + p.2.1) p.2.2)) ∧ HasCompactSupport (fun p : ℝ × ℝ × ℝ => g (cylPt p.1 (c * p.1 + p.2.1) p.2.2)) ∧ Continuous (fun q : ℝ × ℝ => g (cylPt q.1 (c * q.1) q.2)) ∧ HasCompactSupport (fun q : ℝ × ℝ => g (cylPt q.1 (c * q.1) q.2)) :=
by
  have hc0 : ∀ a b d : ℝ, (cylPt a b d) 0 = a := by
    intro a b d; simp [cylPt, e, EuclideanSpace.single_apply]
  have hc1 : ∀ a b d : ℝ, (cylPt a b d) 1 = b := by
    intro a b d; simp [cylPt, e, EuclideanSpace.single_apply]
  have hc2 : ∀ a b d : ℝ, (cylPt a b d) 2 = d := by
    intro a b d; simp [cylPt, e, EuclideanSpace.single_apply]
  have hΦ : Continuous (fun p : ℝ × ℝ × ℝ => cylPt p.1 (c * p.1 + p.2.1) p.2.2) := by
    unfold cylPt
    exact ((continuous_fst.smul continuous_const).add
      (((continuous_const.mul continuous_fst).add (continuous_fst.comp continuous_snd)).smul
        continuous_const)).add ((continuous_snd.comp continuous_snd).smul continuous_const)
  have hφ : Continuous (fun q : ℝ × ℝ => cylPt q.1 (c * q.1) q.2) := by
    unfold cylPt
    exact ((continuous_fst.smul continuous_const).add
      ((continuous_const.mul continuous_fst).smul continuous_const)).add
        (continuous_snd.smul continuous_const)
  have hcoord : ∀ i : Fin 3, Continuous (fun z : E3 => z i) := fun i => by fun_prop
  have hΨ : Continuous (fun z : E3 => (z 0, z 1 - c * z 0, z 2)) :=
    (hcoord 0).prodMk (((hcoord 1).sub (continuous_const.mul (hcoord 0))).prodMk (hcoord 2))
  have hψ : Continuous (fun z : E3 => (z 0, z 2)) := (hcoord 0).prodMk (hcoord 2)
  refine ⟨hg.comp hΦ, ?_, hg.comp hφ, ?_⟩
  · refine HasCompactSupport.intro (hgc.isCompact.image hΨ) ?_
    intro p hp
    by_contra h
    apply hp
    refine ⟨cylPt p.1 (c * p.1 + p.2.1) p.2.2, subset_tsupport g h, ?_⟩
    simp only [hc0, hc1, hc2, add_sub_cancel_left]
  · refine HasCompactSupport.intro (hgc.isCompact.image hψ) ?_
    intro q hq
    by_contra h
    apply hq
    refine ⟨cylPt q.1 (c * q.1) q.2, subset_tsupport g h, ?_⟩
    simp only [hc0, hc2]

theorem prod3_deriv_fst_integral_zero (F F' : ℝ × ℝ × ℝ → ℝ) (hF : HasCompactSupport F) (hF'c : Continuous F') (hF's : HasCompactSupport F') (hd : ∀ t u s : ℝ, HasDerivAt (fun x : ℝ => F (x, u, s)) (F' (t, u, s)) t) (A : Set ℝ) (hA : MeasurableSet A) : ∫ p in {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}, F' p = 0 :=
by
  
  have hslice : ∀ (G : ℝ × ℝ × ℝ → ℝ), HasCompactSupport G → ∀ u s : ℝ,
      HasCompactSupport (fun x : ℝ => G (x, u, s)) := by
    intro G hG u s
    refine HasCompactSupport.intro (hG.isCompact.image continuous_fst) ?_
    intro x hx
    apply image_eq_zero_of_notMem_tsupport
    intro hmem
    exact hx ⟨(x, u, s), hmem, rfl⟩
  have hsl0 : ∀ u s : ℝ, ∫ x : ℝ, F' (x, u, s) = 0 := by
    intro u s
    have hd' : ∀ x : ℝ, HasDerivAt (fun x : ℝ => F (x, u, s)) (F' (x, u, s)) x :=
      fun x => hd x u s
    have hfc : Continuous (fun x : ℝ => F (x, u, s)) :=
      continuous_iff_continuousAt.2 (fun x => (hd' x).continuousAt)
    have hf'c : Continuous (fun x : ℝ => F' (x, u, s)) :=
      hF'c.comp (continuous_id.prodMk continuous_const)
    have hfi : MeasureTheory.Integrable (fun x : ℝ => F (x, u, s)) :=
      hfc.integrable_of_hasCompactSupport (hslice F hF u s)
    have hf'i : MeasureTheory.Integrable (fun x : ℝ => F' (x, u, s)) :=
      hf'c.integrable_of_hasCompactSupport (hslice F' hF's u s)
    exact MeasureTheory.integral_eq_zero_of_hasDerivAt_of_integrable hd' hf'i hfi
  have hS : MeasurableSet {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} :=
    hA.preimage (measurable_fst.comp measurable_snd)
  have hI : MeasureTheory.Integrable F' := hF'c.integrable_of_hasCompactSupport hF's
  have hIS : MeasureTheory.Integrable ({p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F')
      ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod
        (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ))) := hI.indicator hS
  rw [← MeasureTheory.integral_indicator hS]
  show ∫ p, {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' p ∂((MeasureTheory.volume :
      MeasureTheory.Measure ℝ).prod (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ))) = 0
  rw [MeasureTheory.integral_prod_symm _ hIS]
  have hinner : ∀ y : ℝ × ℝ,
      ∫ x : ℝ, {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (x, y) = 0 := by
    rintro ⟨u, s⟩
    by_cases hu : u ∈ A
    · have : (fun x : ℝ => {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (x, u, s)) =
          fun x => F' (x, u, s) := by
        funext x
        exact Set.indicator_of_mem (show (x, u, s) ∈ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hu) _
      rw [this]
      exact hsl0 u s
    · have : (fun x : ℝ => {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (x, u, s)) =
          fun _ => (0 : ℝ) := by
        funext x
        exact Set.indicator_of_notMem (show (x, u, s) ∉ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hu) _
      rw [this]
      exact MeasureTheory.integral_zero _ _
  simp only [hinner]
  exact MeasureTheory.integral_zero _ _

theorem prod3_deriv_thd_integral_zero (F F' : ℝ × ℝ × ℝ → ℝ) (hF : HasCompactSupport F) (hF'c : Continuous F') (hF's : HasCompactSupport F') (hd : ∀ t u s : ℝ, HasDerivAt (fun x : ℝ => F (t, u, x)) (F' (t, u, s)) s) (A : Set ℝ) (hA : MeasurableSet A) : ∫ p in {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}, F' p = 0 :=
by
  have hS : MeasurableSet {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} :=
    hA.preimage (measurable_fst.comp measurable_snd)
  have hI : MeasureTheory.Integrable F' := hF'c.integrable_of_hasCompactSupport hF's
  have hI2 : MeasureTheory.Integrable ({p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F') :=
    hI.indicator hS
  rw [← MeasureTheory.integral_indicator hS]
  have hslice : ∀ t u : ℝ, ∫ s : ℝ, F' (t, u, s) = 0 := by
    intro t u
    have hc' : Continuous (fun s : ℝ => F' (t, u, s)) :=
      hF'c.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id))
    have hcs' : HasCompactSupport (fun s : ℝ => F' (t, u, s)) := by
      refine HasCompactSupport.intro
        (hF's.isCompact.image (continuous_snd.comp continuous_snd)) ?_
      intro s hs
      apply image_eq_zero_of_notMem_tsupport
      intro hmem
      exact hs ⟨(t, u, s), hmem, rfl⟩
    have hc : Continuous (fun s : ℝ => F (t, u, s)) :=
      continuous_iff_continuousAt.2 (fun s => (hd t u s).continuousAt)
    have hcs : HasCompactSupport (fun s : ℝ => F (t, u, s)) := by
      refine HasCompactSupport.intro
        (hF.isCompact.image (continuous_snd.comp continuous_snd)) ?_
      intro s hs
      apply image_eq_zero_of_notMem_tsupport
      intro hmem
      exact hs ⟨(t, u, s), hmem, rfl⟩
    exact MeasureTheory.integral_eq_zero_of_hasDerivAt_of_integrable (hd t u)
      (hc'.integrable_of_hasCompactSupport hcs') (hc.integrable_of_hasCompactSupport hcs)
  have hinner : ∀ t : ℝ,
      ∫ q : ℝ × ℝ, {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (t, q) = 0 := by
    intro t
    have hct : Continuous (fun q : ℝ × ℝ => F' (t, q)) :=
      hF'c.comp (continuous_const.prodMk continuous_id)
    have hcst : HasCompactSupport (fun q : ℝ × ℝ => F' (t, q)) := by
      refine HasCompactSupport.intro (hF's.isCompact.image continuous_snd) ?_
      intro q hq
      apply image_eq_zero_of_notMem_tsupport
      intro hmem
      exact hq ⟨(t, q), hmem, rfl⟩
    have heq : (fun q : ℝ × ℝ => {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (t, q)) =
        (Prod.fst ⁻¹' A).indicator (fun q : ℝ × ℝ => F' (t, q)) := by
      funext q
      by_cases hq : q.1 ∈ A
      · rw [Set.indicator_of_mem (show (t, q) ∈ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hq),
          Set.indicator_of_mem (show q ∈ Prod.fst ⁻¹' A from hq)]
      · rw [Set.indicator_of_notMem (show (t, q) ∉ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hq),
          Set.indicator_of_notMem (show q ∉ Prod.fst ⁻¹' A from hq)]
    have hIt : MeasureTheory.Integrable
        (fun q : ℝ × ℝ => {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (t, q)) := by
      rw [heq]
      exact (hct.integrable_of_hasCompactSupport hcst).indicator (measurable_fst hA)
    have hu : ∀ u : ℝ, ∫ s : ℝ, {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (t, (u, s)) = 0 := by
      intro u
      by_cases hu : u ∈ A
      · rw [← hslice t u]
        congr 1
        funext s
        exact Set.indicator_of_mem (show (t, (u, s)) ∈ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hu) _
      · have h0 : (fun s : ℝ => {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}.indicator F' (t, (u, s))) =
            fun _ => (0 : ℝ) :=
          funext fun s =>
            Set.indicator_of_notMem (show (t, (u, s)) ∉ {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} from hu) _
        rw [h0, MeasureTheory.integral_zero]
    refine (MeasureTheory.integral_prod _ hIt).trans ?_
    simp only [hu, MeasureTheory.integral_zero]
  refine (MeasureTheory.integral_prod _ hI2).trans ?_
  simp only [hinner, MeasureTheory.integral_zero]

theorem prod3_deriv_snd_halfline (F F' : ℝ × ℝ × ℝ → ℝ) (hFc : Continuous F) (hF : HasCompactSupport F) (hF'c : Continuous F') (hF's : HasCompactSupport F') (hd : ∀ t u s : ℝ, HasDerivAt (fun x : ℝ => F (t, x, s)) (F' (t, u, s)) u) : (∫ p in {p : ℝ × ℝ × ℝ | 0 < p.2.1}, F' p = -∫ q : ℝ × ℝ, F (q.1, 0, q.2)) ∧ (∫ p in {p : ℝ × ℝ × ℝ | p.2.1 < 0}, F' p = ∫ q : ℝ × ℝ, F (q.1, 0, q.2)) :=
by
  obtain ⟨R₁, -, hv₁⟩ := hF.exists_pos_le_norm
  obtain ⟨R₂, -, hv₂⟩ := hF's.exists_pos_le_norm
  have hvan : ∀ t s x : ℝ, max R₁ R₂ ≤ |x| → F (t, x, s) = 0 ∧ F' (t, x, s) = 0 := by
    intro t s x hx
    have h1 : |x| ≤ ‖((t, x, s) : ℝ × ℝ × ℝ)‖ := by
      have a : ‖x‖ ≤ ‖(x, s)‖ := norm_fst_le (x, s)
      have b : ‖(x, s)‖ ≤ ‖((t, (x, s)) : ℝ × ℝ × ℝ)‖ := norm_snd_le (t, (x, s))
      rw [Real.norm_eq_abs] at a
      exact a.trans b
    exact ⟨hv₁ _ (le_trans (le_max_left _ _) (hx.trans h1)),
      hv₂ _ (le_trans (le_max_right _ _) (hx.trans h1))⟩
  have ftc : ∀ (f f' : ℝ → ℝ), Continuous f' → (∀ x, HasDerivAt f (f' x) x) →
      (∀ x, max R₁ R₂ ≤ |x| → f x = 0 ∧ f' x = 0) →
      (∫ x in Set.Ioi (0:ℝ), f' x = -f 0) ∧ (∫ x in Set.Iio (0:ℝ), f' x = f 0) := by
    intro f f' hf'c hdf hv
    have hfc : Continuous f := continuous_iff_continuousAt.2 (fun x => (hdf x).continuousAt)
    have hcs : HasCompactSupport f' := by
      refine HasCompactSupport.intro (isCompact_Icc (a := -max R₁ R₂) (b := max R₁ R₂)) ?_
      intro x hx
      have : max R₁ R₂ ≤ |x| := by
        by_contra h
        push_neg at h
        exact hx (abs_le.1 h.le)
      exact (hv x this).2
    have hint : Integrable f' := hf'c.integrable_of_hasCompactSupport hcs
    have htop : Tendsto f atTop (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_ge_atTop (max R₁ R₂)] with x hx
      exact ((hv x (hx.trans (le_abs_self x))).1).symm
    have hbot : Tendsto f atBot (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_le_atBot (-max R₁ R₂)] with x hx
      exact ((hv x (by linarith [neg_le_abs x])).1).symm
    refine ⟨?_, ?_⟩
    · rw [integral_Ioi_of_hasDerivAt_of_tendsto hfc.continuousWithinAt (fun x _ => hdf x)
        hint.integrableOn htop, zero_sub]
    · rw [← integral_Iic_eq_integral_Iio, integral_Iic_of_hasDerivAt_of_tendsto
        hfc.continuousWithinAt (fun x _ => hdf x) hint.integrableOn hbot, sub_zero]
  have hφ : MeasurePreserving (fun w : (ℝ × ℝ) × ℝ => (w.1.1, w.2, w.1.2)) volume volume := by
    have h1 := measurePreserving_prodAssoc (volume : Measure ℝ) (volume : Measure ℝ)
      (volume : Measure ℝ)
    have h2 := (MeasurePreserving.id (volume : Measure ℝ)).prod
      (Measure.measurePreserving_swap (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ)))
    exact h2.comp h1
  have hemb : MeasurableEmbedding (fun w : (ℝ × ℝ) × ℝ => (w.1.1, w.2, w.1.2)) :=
    (MeasurableEquiv.prodAssoc.trans
      ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.prodComm)).measurableEmbedding
  have hF'int : Integrable F' := hF'c.integrable_of_hasCompactSupport hF's
  have htr : ∀ A : Set ℝ, ∫ p in {p : ℝ × ℝ × ℝ | p.2.1 ∈ A}, F' p =
      ∫ q : ℝ × ℝ, ∫ u in A, F' (q.1, u, q.2) := by
    intro A
    have hpre : (fun w : (ℝ × ℝ) × ℝ => (w.1.1, w.2, w.1.2)) ⁻¹' {p : ℝ × ℝ × ℝ | p.2.1 ∈ A} =
        (Set.univ : Set (ℝ × ℝ)) ×ˢ A := by
      ext ⟨⟨t, s⟩, u⟩
      simp [Set.mem_prod]
    have hi : IntegrableOn (fun w : (ℝ × ℝ) × ℝ => F' (w.1.1, w.2, w.1.2))
        ((Set.univ : Set (ℝ × ℝ)) ×ˢ A) ((volume : Measure (ℝ × ℝ)).prod (volume : Measure ℝ)) := by
      rw [← hpre]
      exact (hφ.integrableOn_comp_preimage hemb).2 hF'int.integrableOn
    rw [← hφ.setIntegral_preimage_emb hemb, hpre, Measure.volume_eq_prod, setIntegral_prod _ hi,
      Measure.restrict_univ]
  have slice : ∀ q : ℝ × ℝ, (∫ u in Set.Ioi (0:ℝ), F' (q.1, u, q.2) = -F (q.1, 0, q.2)) ∧
      (∫ u in Set.Iio (0:ℝ), F' (q.1, u, q.2) = F (q.1, 0, q.2)) := fun q =>
    ftc (fun x => F (q.1, x, q.2)) (fun x => F' (q.1, x, q.2))
      (hF'c.comp (continuous_const.prodMk (continuous_id.prodMk continuous_const)))
      (fun x => hd q.1 x q.2) (fun x hx => hvan q.1 q.2 x hx)
  have eP : ∫ p in {p : ℝ × ℝ × ℝ | 0 < p.2.1}, F' p =
      ∫ q : ℝ × ℝ, ∫ u in Set.Ioi (0:ℝ), F' (q.1, u, q.2) := htr (Set.Ioi 0)
  have eM : ∫ p in {p : ℝ × ℝ × ℝ | p.2.1 < 0}, F' p =
      ∫ q : ℝ × ℝ, ∫ u in Set.Iio (0:ℝ), F' (q.1, u, q.2) := htr (Set.Iio 0)
  refine ⟨?_, ?_⟩
  · rw [eP, ← integral_neg]
    congr 1
    funext q
    exact (slice q).1
  · rw [eM]
    congr 1
    funext q
    exact (slice q).2

theorem wedge_model_flux (k : ℝ) (X : E3 → E3) (hk : 0 < k) (hX : ContDiff ℝ ∞ X) (hc : HasCompactSupport X) (hpos : tsupport X ⊆ {z : E3 | 0 < z 0}) : ∫ z in {z : E3 | k * z 0 < |z 1|}, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z = ∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), (k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1)) :=
by
  classical
  have hcont : ∀ i : Fin 3, Continuous (fun z : E3 => z i) := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  have hc0 : ∀ a b d : ℝ, (cylPt a b d) 0 = a := by
    intro a b d; simp [cylPt, EuclideanSpace.single_apply]
  have hc1 : ∀ a b d : ℝ, (cylPt a b d) 1 = b := by
    intro a b d; simp [cylPt, EuclideanSpace.single_apply]
  obtain ⟨hdp, hXp, hvan⟩ := divField_props X hX hc hpos
  
