      exact h.2
    have hsB : ψ p hp y' (f p hp y) ∈ W' p hp ∩ U ∩ N ∩ {x | 0 < f p hp x * f p hp y} := hy'B
    have hfs : f p hp (ψ p hp y' (f p hp y)) = f p hp y := by
      rw [((hψ p hp y' hy'W).2.2 _ htI).2, hfy', zero_add]
    have hsV : ψ p hp y' (f p hp y) ∈ V p hp := (hWQ p hp (hW'W p hp hsB.1.1.1)).1
    refine ⟨⟨⟨⟨hsB, Set.mem_iUnion₂.2 ⟨p, hp, hsB.1.1.1⟩⟩, hsB.1.1.2⟩, hsB.1.2⟩, ?_, ?_⟩
    · show σ (ψ p hp y' (f p hp y)) = σ y
      rw [hσf p hp _ ⟨⟨hsV, hsB.1.1.2⟩, hsB.1.2⟩, hfs, hσy]
    · show prn (ψ p hp y' (f p hp y)) = y'
      rw [hLF p hp _ ⟨hsB.1.1.1, hsB.1.1.2, hsB.1.2⟩, hfs]
      exact hψinv p hp y' hy'W _ (by linarith) (hW'W p hp hsB.1.1.1)
  · intro w hw hσw
    obtain ⟨⟨⟨hwB, hwA⟩, hwU⟩, hwN⟩ := hw
    have hwB' : w ∈ W' p hp ∩ U ∩ N ∩ {x | 0 < f p hp x * f p hp y} := hwB
    have hwW' : w ∈ W' p hp := hwB'.1.1.1
    have hwW := hW'W p hp hwW'
    have hwV : w ∈ V p hp := (hWQ p hp hwW).1
    have hfw : f p hp w = f p hp y := by
      have h1 : |f p hp w| = |f p hp y| := by
        rw [← hσf p hp w ⟨⟨hwV, hwU⟩, hwN⟩, hσw, hσy]
      have h2 : 0 < f p hp w * f p hp y := hwB'.2
      rcases abs_eq_abs.1 h1 with h | h
      · exact h
      · rw [h] at h2
        nlinarith [mul_self_pos.2 ht0]
    have hprw : prn w = ψ p hp w (-f p hp y) := by
      rw [hLF p hp w ⟨hwW', hwU, hwN⟩, hfw]
    have hmemW : ψ p hp w (-f p hp y) ∈ W p hp :=
      hW'ψ p hp w hwW' (-f p hp y) (by rw [abs_neg]; exact htη)
    have hback : ψ p hp (ψ p hp w (-f p hp y)) (f p hp y) = w := by
      have h := hψinv p hp w hwW (-f p hp y) (by rw [abs_neg]; linarith) hmemW
      rwa [neg_neg] at h
    rw [hprw]
    refine ⟨⟨hmemW, ?_⟩, hback⟩
    show ψ p hp (ψ p hp w (-f p hp y)) (f p hp y) ∈
      W' p hp ∩ U ∩ N ∩ {x | 0 < f p hp x * f p hp y}
    rw [hback]
    exact hwB'

theorem patched_surface_pullback {X : Type*} [TopologicalSpace X] (S T : Set X)
    (P : EigPatchedSurface X S) (hT : IsCompact T) (D : Set X) (hD : IsOpen D) (hTD : T ⊆ D)
    (pr : X → X) (hprc : ContinuousOn pr D) (hprS : ∀ w ∈ T, pr w ∈ S)
    (hsec : ∀ w ∈ T, ∃ (A Ω : Set X) (s : X → X), IsOpen A ∧ w ∈ A ∧ IsOpen Ω ∧
      ContinuousOn s (Ω ∩ S) ∧ (∀ y ∈ Ω ∩ S, s y ∈ A ∩ T ∧ pr (s y) = y) ∧
      ∀ w' ∈ A ∩ T, pr w' ∈ Ω ∧ s (pr w') = w') :
    ∃ (Q : EigPatchedSurface X T) (κ : Fin Q.n → Fin P.n), ∀ j,
      Q.W j ⊆ P.W (κ j) ∧ Q.h j = P.h (κ j) ∧ ∀ x ∈ Q.W j, pr (Q.param j x) = P.param (κ j) x :=
by
  classical
  
  have hfin : ∃ (m : ℕ) (A' Ω' : Fin m → Set X) (s' : Fin m → X → X),
      (∀ i, IsOpen (A' i)) ∧ (∀ i, IsOpen (Ω' i)) ∧
      (∀ i, ContinuousOn (s' i) (Ω' i ∩ S)) ∧
      (∀ i, ∀ y ∈ Ω' i ∩ S, s' i y ∈ A' i ∩ T ∧ pr (s' i y) = y) ∧
      (∀ i, ∀ w' ∈ A' i ∩ T, pr w' ∈ Ω' i ∧ s' i (pr w') = w') ∧
      ∀ w ∈ T, ∃ i, w ∈ A' i := by
    choose A Ω s hAo hwA hΩo hsc hs1 hs2 using fun v : ↥T => hsec v.1 v.2
    obtain ⟨t, ht⟩ := hT.elim_finite_subcover A hAo
      (fun w hw => Set.mem_iUnion.2 ⟨⟨w, hw⟩, hwA ⟨w, hw⟩⟩)
    refine ⟨t.card, fun i => A (t.equivFin.symm i : ↥T),
      fun i => Ω (t.equivFin.symm i : ↥T),
      fun i => s (t.equivFin.symm i : ↥T),
      fun i => hAo _, fun i => hΩo _, fun i => hsc _, fun i => hs1 _,
      fun i => hs2 _, ?_⟩
    intro w hw
    obtain ⟨u, hu, hwu⟩ := Set.mem_iUnion₂.1 (ht hw)
    refine ⟨t.equivFin ⟨u, hu⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hwu
  obtain ⟨m, A', Ω', s', hAo, hΩo, hsc, hs1, hs2, hC⟩ := hfin
  
  obtain ⟨kk, ii, hkk⟩ : ∃ (kk : Fin (P.n * m) → Fin P.n) (ii : Fin (P.n * m) → Fin m),
      ∀ k i, ∃ j, kk j = k ∧ ii j = i :=
    ⟨fun j => (finProdFinEquiv.symm j).1, fun j => (finProdFinEquiv.symm j).2,
      fun k i => ⟨finProdFinEquiv (k, i), by simp⟩⟩
  
  have hBM : ∀ k, ∀ x ∈ P.W k, P.param k x ∈ P.O k ∩ S := fun k x hx => by
    rw [← P.image_eq k]
    exact Set.mem_image_of_mem _ hx
  
  have hKI : ∀ j, ∀ x ∈ P.W (kk j) ∩ P.param (kk j) ⁻¹' Ω' (ii j),
      s' (ii j) (P.param (kk j) x) ∈ A' (ii j) ∩ T ∧
        pr (s' (ii j) (P.param (kk j) x)) = P.param (kk j) x :=
    fun j x hx => hs1 (ii j) _ ⟨hx.2, (hBM _ x hx.1).2⟩
  have hWo : ∀ j, IsOpen (P.W (kk j) ∩ P.param (kk j) ⁻¹' Ω' (ii j)) := fun j =>
    (P.param_cont (kk j)).isOpen_inter_preimage (P.W_open _) (hΩo _)
  have hdom : ∀ j j', ∀ x ∈ (P.W (kk j) ∩ P.param (kk j) ⁻¹' Ω' (ii j)) ∩
      (fun x => s' (ii j) (P.param (kk j) x)) ⁻¹'
        (A' (ii j') ∩ (D ∩ pr ⁻¹' (P.O (kk j') ∩ Ω' (ii j')))),
      x ∈ P.W (kk j) ∩ P.param (kk j) ⁻¹' P.O (kk j') := by
    intro j j' x hx
    refine ⟨hx.1.1, ?_⟩
    have h1 : pr (s' (ii j) (P.param (kk j) x)) ∈ P.O (kk j') := hx.2.2.2.1
    rw [(hKI j x hx.1).2] at h1
    exact h1
  have heq : ∀ j j', ∀ x ∈ P.W (kk j) ∩ P.param (kk j) ⁻¹' Ω' (ii j),
      P.proj (kk j') (pr (s' (ii j) (P.param (kk j) x))) =
        P.proj (kk j') (P.param (kk j) x) := by
    intro j j' x hx
    rw [(hKI j x hx).2]
  refine ⟨EigPatchedSurface.mk (P.n * m)
      (fun j => P.W (kk j) ∩ P.param (kk j) ⁻¹' Ω' (ii j))
      (fun j x => s' (ii j) (P.param (kk j) x))
      (fun j w => P.proj (kk j) (pr w))
      (fun j => A' (ii j) ∩ (D ∩ pr ⁻¹' (P.O (kk j) ∩ Ω' (ii j))))
      (fun j => P.h (kk j))
      hWo
      (fun j => (hAo _).inter
        (hprc.isOpen_inter_preimage hD ((P.O_open _).inter (hΩo _))))
      (fun j => (hsc (ii j)).comp
        ((P.param_cont (kk j)).mono Set.inter_subset_left)
        (fun x hx => ⟨hx.2, (hBM _ x hx.1).2⟩))
      (fun j => (P.proj_cont (kk j)).comp
        (hprc.mono (fun w hw => hw.2.1)) (fun w hw => hw.2.2.1))
      ?_ ?_ ?_ ?_
      (fun j a b => (P.h_smooth (kk j) a b).mono Set.inter_subset_left)
      (fun j x hx => P.h_posDef (kk j) x hx.1)
      ?_, kk, fun j => ⟨Set.inter_subset_left, rfl,
        fun x hx => (hKI j x hx).2⟩⟩
  · 
    intro j
    ext w
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨hmem, hpr⟩ := hKI j x hx
      refine ⟨⟨hmem.1, hTD hmem.2, ?_⟩, hmem.2⟩
      show pr (s' (ii j) (P.param (kk j) x)) ∈ P.O (kk j) ∩ Ω' (ii j)
      rw [hpr]
      exact ⟨(hBM _ x hx.1).1, hx.2⟩
    · rintro ⟨⟨hwA, hwD, hwO, hwΩ⟩, hwT⟩
      have hS : pr w ∈ P.O (kk j) ∩ S := ⟨hwO, hprS w hwT⟩
      rw [← P.image_eq] at hS
      obtain ⟨x, hx, hxe⟩ := hS
      refine ⟨x, ⟨hx, ?_⟩, ?_⟩
      · show P.param (kk j) x ∈ Ω' (ii j)
        rw [hxe]
        exact hwΩ
      · show s' (ii j) (P.param (kk j) x) = w
        rw [hxe]
        exact (hs2 (ii j) w ⟨hwA, hwT⟩).2
  · 
    intro j x hx
    show P.proj (kk j) (pr (s' (ii j) (P.param (kk j) x))) = x
    rw [(hKI j x hx).2]
    exact P.proj_param _ x hx.1
  · 
    intro w hw
    obtain ⟨i, hwi⟩ := hC w hw
    obtain ⟨k, hk⟩ := Set.mem_iUnion.1 (P.cover (hprS w hw))
    obtain ⟨j, rfl, rfl⟩ := hkk k i
    exact Set.mem_iUnion.2 ⟨j, hwi, hTD hw, hk, (hs2 (ii j) w ⟨hwi, hw⟩).1⟩
  · 
    intro j j'
    exact ((P.trans_smooth (kk j) (kk j')).mono (hdom j j')).congr
      (fun x hx => heq j j' x hx.1)
  · 
    intro j j' x hx a b
    have hx' := hdom j j' x hx
    have hev : (fun x' => P.proj (kk j') (pr (s' (ii j) (P.param (kk j) x')))) =ᶠ[𝓝 x]
        (fun x' => P.proj (kk j') (P.param (kk j) x')) :=
      Filter.eventuallyEq_of_mem ((hWo j).mem_nhds hx.1) (fun x' hx'' => heq j j' x' hx'')
    have hfd := hev.fderiv_eq (𝕜 := ℝ)
    have hval := heq j j' x hx.1
    show P.h (kk j) x a b = ∑ c : Fin 2, ∑ d : Fin 2,
      fderiv ℝ (fun x' => P.proj (kk j') (pr (s' (ii j) (P.param (kk j) x')))) x (e2 a) c *
        P.h (kk j') (P.proj (kk j') (pr (s' (ii j) (P.param (kk j) x)))) c d *
        fderiv ℝ (fun x' => P.proj (kk j') (pr (s' (ii j) (P.param (kk j) x')))) x (e2 b) d
    rw [hfd, hval]
    exact P.h_compat (kk j) (kk j') x hx' a b

theorem local_section_component_image {X : Type*} [TopologicalSpace X] [T2Space X]
    (S T : Set X) (hT : IsCompact T) (pr : X → X) (hprc : ContinuousOn pr T)
    (hprS : ∀ w ∈ T, pr w ∈ S)
    (hTloc : ∀ q ∈ T, ∃ O : Set X, IsOpen O ∧ q ∈ O ∧ O ∩ T ⊆ connectedComponentIn T q)
    (hsec : ∀ w ∈ T, ∃ (A Ω : Set X) (s : X → X), IsOpen A ∧ w ∈ A ∧ IsOpen Ω ∧
      ContinuousOn s (Ω ∩ S) ∧ (∀ y ∈ Ω ∩ S, s y ∈ A ∩ T ∧ pr (s y) = y) ∧
      ∀ w' ∈ A ∩ T, pr w' ∈ Ω ∧ s (pr w') = w') :
    ∀ q ∈ T, pr '' connectedComponentIn T q = connectedComponentIn S (pr q) :=
by
  intro q hq
  have hCT : connectedComponentIn T q ⊆ T := connectedComponentIn_subset T q
  have hqC : q ∈ connectedComponentIn T q := mem_connectedComponentIn hq
  
  have hCloc : ∀ w ∈ connectedComponentIn T q, ∃ O : Set X, IsOpen O ∧ w ∈ O ∧
      O ∩ T ⊆ connectedComponentIn T q := by
    intro w hw
    obtain ⟨O, hO, hwO, hOT⟩ := hTloc w (hCT hw)
    refine ⟨O, hO, hwO, ?_⟩
    rw [connectedComponentIn_eq hw]
    exact hOT
  
  have hCc : IsCompact (connectedComponentIn T q) := by
    obtain ⟨K, hKdef⟩ : ∃ K : Set X,
        K = ⋃₀ {O : Set X | IsOpen O ∧ O ∩ connectedComponentIn T q = ∅} := ⟨_, rfl⟩
    have hK : IsOpen K := by
      rw [hKdef]
      exact isOpen_sUnion (fun O hO => hO.1)
    have hEq : connectedComponentIn T q = T ∩ Kᶜ := by
      ext z
      constructor
      · intro hz
        refine ⟨hCT hz, ?_⟩
        intro hzK
        rw [hKdef] at hzK
        obtain ⟨O, hO, hzO⟩ := hzK
        have hmem : z ∈ O ∩ connectedComponentIn T q := ⟨hzO, hz⟩
        rw [hO.2] at hmem
        exact hmem
      · rintro ⟨hzT, hzK⟩
        by_contra hzC
        obtain ⟨O, hO, hzO, hOT⟩ := hTloc z hzT
        apply hzK
        rw [hKdef]
        refine ⟨O, ⟨hO, ?_⟩, hzO⟩
        ext x
        constructor
        · rintro ⟨hxO, hxC⟩
          have hx1 : x ∈ connectedComponentIn T z := hOT ⟨hxO, hCT hxC⟩
          apply hzC
          rw [connectedComponentIn_eq hxC, ← connectedComponentIn_eq hx1]
          exact mem_connectedComponentIn hzT
        · intro hx
          exact hx.elim
    rw [hEq]
    exact hT.inter_right hK.isClosed_compl
  have hprC : ContinuousOn pr (connectedComponentIn T q) := hprc.mono hCT
  have himS : pr '' connectedComponentIn T q ⊆ S := by
    rintro _ ⟨w, hw, rfl⟩
    exact hprS w (hCT hw)
  have hpqS : pr q ∈ S := hprS q hq
  
  have hsub1 : pr '' connectedComponentIn T q ⊆ connectedComponentIn S (pr q) :=
    (isPreconnected_connectedComponentIn.image pr hprC).subset_connectedComponentIn
      (Set.mem_image_of_mem pr hqC) himS
  
  have hclosed : IsClosed (pr '' connectedComponentIn T q) :=
    (hCc.image_of_continuousOn hprC).isClosed
  
  obtain ⟨V, hVo, hCV, hVS⟩ : ∃ V : Set X, IsOpen V ∧ pr '' connectedComponentIn T q ⊆ V ∧
      V ∩ S ⊆ pr '' connectedComponentIn T q := by
    refine ⟨⋃₀ {W : Set X | IsOpen W ∧ W ∩ S ⊆ pr '' connectedComponentIn T q},
      isOpen_sUnion (fun W hW => hW.1), ?_, ?_⟩
    · rintro _ ⟨w, hw, rfl⟩
      obtain ⟨A, Ω, s, _hAo, hwA, hΩo, hsc, hsmap, hsinv⟩ := hsec w (hCT hw)
      obtain ⟨O, hOo, hwO, hOT⟩ := hCloc w hw
      obtain ⟨u, huo, hu⟩ := continuousOn_iff'.mp hsc O hOo
      obtain ⟨hprΩ, hspr⟩ := hsinv w ⟨hwA, hCT hw⟩
      refine ⟨u ∩ Ω, ⟨huo.inter hΩo, ?_⟩, ?_⟩
      · rintro y ⟨⟨hyu, hyΩ⟩, hyS⟩
        have hy : y ∈ s ⁻¹' O ∩ (Ω ∩ S) := by
          rw [hu]
          exact ⟨hyu, hyΩ, hyS⟩
        obtain ⟨⟨_, hsyT⟩, hprsy⟩ := hsmap y ⟨hyΩ, hyS⟩
        exact ⟨s y, hOT ⟨hy.1, hsyT⟩, hprsy⟩
      · have hy : pr w ∈ s ⁻¹' O ∩ (Ω ∩ S) := by
          refine ⟨?_, hprΩ, hprS w (hCT hw)⟩
          show s (pr w) ∈ O
          rw [hspr]
          exact hwO
        rw [hu] at hy
        exact ⟨hy.1, hprΩ⟩
    · rintro y ⟨⟨W, hW, hyW⟩, hyS⟩
      exact hW.2 ⟨hyW, hyS⟩
  
  have hsub2 : connectedComponentIn S (pr q) ⊆ pr '' connectedComponentIn T q := by
    have hD : IsPreconnected (connectedComponentIn S (pr q)) :=
      isPreconnected_connectedComponentIn
    have hDS : connectedComponentIn S (pr q) ⊆ S := connectedComponentIn_subset S (pr q)
    have hcover : connectedComponentIn S (pr q) ⊆ V ∪ (pr '' connectedComponentIn T q)ᶜ := by
      intro z _
      by_cases hzI : z ∈ pr '' connectedComponentIn T q
      · exact Or.inl (hCV hzI)
      · exact Or.inr hzI
    have hdisj : connectedComponentIn S (pr q) ∩ (V ∩ (pr '' connectedComponentIn T q)ᶜ) = ∅ := by
      ext z
      constructor
      · rintro ⟨hz, hzV, hzn⟩
        exact absurd (hVS ⟨hzV, hDS hz⟩) hzn
      · intro h
        exact h.elim
    rcases isPreconnected_iff_subset_of_disjoint.mp hD V (pr '' connectedComponentIn T q)ᶜ hVo
        hclosed.isOpen_compl hcover hdisj with h | h
    · intro z hz
      exact hVS ⟨h hz, hDS hz⟩
    · exact absurd (Set.mem_image_of_mem pr hqC) (h (mem_connectedComponentIn hpqS))
  exact Set.Subset.antisymm hsub1 hsub2

theorem good_collar_leaf_patched [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U) (hFc : IsCompact (frontier U))
    (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hNc : IsCompact (closure N)) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc c d))
    (hσi : ∀ δ : ℝ, 0 < δ → δ < ε → IsClosed (frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic δ)))
    (hσ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ σ ⁻¹' Set.Iio δ)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|) :
    ∃ (P : EigPatchedSurface M (U ∩ N ∩ σ ⁻¹' {ε / 2})) (pr : M → M),
      (∀ j, ∃ (z : M) (F : E2 → E3), eigSurfParam (frontier U) z (P.W j) F ∧
        (∀ x ∈ P.W j, pr (P.param j x) = (chartAt E3 z).symm (F x)) ∧
        P.h j = pullMetric2 (g.coeff (chartAt E3 z).symm) F) ∧
      ∀ q ∈ U ∩ N ∩ σ ⁻¹' {ε / 2},
        pr '' connectedComponentIn (U ∩ N ∩ σ ⁻¹' {ε / 2}) q =
          connectedComponentIn (frontier U) (pr q) :=
by
  classical
  
  have hX : IsOpen (U ∩ N) := hUo.inter hNo
  have hLc : IsCompact (U ∩ N ∩ σ ⁻¹' {ε / 2}) := by
    have h := hσp (ε / 2) (ε / 2) (by linarith) (by linarith)
    rwa [Set.Icc_self] at h
  have hLX : U ∩ N ∩ σ ⁻¹' {ε / 2} ⊆ U ∩ N := Set.inter_subset_left
  
  obtain ⟨PF, hPF, -⟩ := eig_patched_atlas g (frontier U) hFc
    (fun p hp => eig_graph_chart_exists g (frontier U) hfront p hp)
  
  obtain ⟨Ng, hNg1, hNg2, hNg3⟩ := normalized_gradient_operator g
  obtain ⟨Θ, hΘX, hΘ0, hΘadd, hΘc⟩ :=
    collar_global_flow g (U ∩ N) hX σ 0 ε hσs hσr hσb hσp
  obtain ⟨A, prn, hAo, hFA, hprnc, hprnF, hloc⟩ :=
    near_frontier_projection U hUo N σ hNo hFN hσs hσr (fun x hx => (hσb x hx).1) hgood
      Ng hNg1 hNg2 hNg3
  
  have hthin0 : ∀ O : Set M, IsOpen O → frontier U ⊆ O →
      ∃ δ : ℝ, 0 < δ ∧ δ < ε ∧ U ∩ N ∩ σ ⁻¹' Set.Iic δ ⊆ O := by
    intro O hOo hFO
    by_contra hcon
    have hbad : ∀ δ : ℝ, 0 < δ → δ < ε → ∃ x, x ∈ U ∩ N ∩ σ ⁻¹' Set.Iic δ ∧ x ∉ O := by
      intro δ h1 h2
      by_contra h3
      apply hcon
      refine ⟨δ, h1, h2, ?_⟩
      intro x hx
      by_contra hxO
      exact h3 ⟨x, hx, hxO⟩
    let d : ℕ → ℝ := fun n => ε / ((n : ℝ) + 2)
    have hd0 : ∀ n, 0 < d n := fun n => div_pos hε (by positivity)
    have hdlt : ∀ n, d n < ε := fun n =>
      div_lt_self hε (by have := Nat.cast_nonneg (α := ℝ) n; linarith)
    have hmono : ∀ n, d (n + 1) ≤ d n := by
      intro n
      apply div_le_div_of_nonneg_left hε.le (by positivity)
      push_cast
      linarith
    let t : ℕ → Set M := fun n => (frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic (d n))) ∩ Oᶜ
    have htdec : ∀ n, t (n + 1) ⊆ t n := by
      intro n x hx
      refine ⟨?_, hx.2⟩
      rcases hx.1 with h | ⟨hxUN, hxle⟩
      · exact Or.inl h
      · right
        refine ⟨hxUN, ?_⟩
        show σ x ≤ d n
        exact le_trans hxle (hmono n)
    have htne : ∀ n, (t n).Nonempty := by
      intro n
      obtain ⟨x, hx, hxO⟩ := hbad (d n) (hd0 n) (hdlt n)
      exact ⟨x, Or.inr hx, hxO⟩
    have htcl : ∀ n, IsClosed (t n) := fun n =>
      (hσi (d n) (hd0 n) (hdlt n)).inter hOo.isClosed_compl
    have htc : IsCompact (t 0) := by
      refine hNc.of_isClosed_subset (htcl 0) ?_
      intro x hx
      rcases hx.1 with h | h
      · exact subset_closure (hFN h)
      · exact subset_closure h.1.2
    obtain ⟨x, hx⟩ :=
      IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed t htdec htne htc htcl
    rw [Set.mem_iInter] at hx
    have hxn : ∀ n, x ∈ U ∩ N ∧ σ x ≤ d n := by
      intro n
      have h := hx n
      rcases h.1 with h1 | h1
      · exact absurd (hFO h1) h.2
      · exact ⟨h1.1, h1.2⟩
    have hfx : 0 < σ x := (hσb x (hxn 0).1).1
    obtain ⟨n, hn⟩ := exists_nat_gt (ε / σ x)
    have h1 : ε < (n : ℝ) * σ x := (div_lt_iff₀ hfx).mp hn
    have h2 : d n < σ x := by
      show ε / ((n : ℝ) + 2) < σ x
      rw [div_lt_iff₀ (by positivity)]
      nlinarith
    have h3 := (hxn n).2
    linarith
  obtain ⟨δ, hδ0, hδε, hδsub⟩ := hthin0 A hAo hFA
  have hthin : ∀ x ∈ U ∩ N, σ x ≤ δ → x ∈ A := fun x hx hle => hδsub ⟨hx, hle⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : M → M, ∀ x, Φ x = Θ x (δ - σ x) := ⟨_, fun _ => rfl⟩
  obtain ⟨pr, hpr⟩ : ∃ pr : M → M, ∀ x, pr x = prn (Φ x) := ⟨_, fun _ => rfl⟩
  
  have hΦX : ∀ x ∈ U ∩ N, Φ x ∈ A ∩ U ∩ N ∧ σ (Φ x) = δ := by
    intro x hx
    have h1 := hΘX x hx (δ - σ x) (by linarith) (by linarith)
    rw [← hΦ x] at h1
    have hσΦ : σ (Φ x) = δ := by rw [h1.2]; ring
    have hA : Φ x ∈ A := hthin (Φ x) h1.1 (le_of_eq hσΦ)
    exact ⟨⟨⟨hA, h1.1.1⟩, h1.1.2⟩, hσΦ⟩
  
  have hΦc : ContinuousOn Φ (U ∩ N) := by
    have h1 : ContinuousOn (fun x : M => (x, δ - σ x)) (U ∩ N) :=
      continuousOn_id.prodMk (continuousOn_const.sub hσs.continuousOn)
    have h2 := hΘc.comp h1 (fun x hx => by
      show x ∈ U ∩ N ∧ 0 < σ x + (δ - σ x) ∧ σ x + (δ - σ x) < ε
      exact ⟨hx, by linarith, by linarith⟩)
    exact h2.congr (fun x _ => hΦ x)
  have hprc : ContinuousOn pr (U ∩ N) := by
    have h := hprnc.comp hΦc (fun x hx => (hΦX x hx).1)
    exact h.congr (fun x _ => hpr x)
  
  have hprF : ∀ w ∈ U ∩ N ∩ σ ⁻¹' {ε / 2}, pr w ∈ frontier U := by
    intro w hw
    rw [hpr w]
    exact hprnF (Φ w) (hΦX w (hLX hw)).1
  
  have hsec : ∀ w ∈ U ∩ N ∩ σ ⁻¹' {ε / 2}, ∃ (A' Ω : Set M) (s : M → M), IsOpen A' ∧ w ∈ A' ∧
      IsOpen Ω ∧ ContinuousOn s (Ω ∩ frontier U) ∧
      (∀ y ∈ Ω ∩ frontier U, s y ∈ A' ∩ (U ∩ N ∩ σ ⁻¹' {ε / 2}) ∧ pr (s y) = y) ∧
      ∀ w' ∈ A' ∩ (U ∩ N ∩ σ ⁻¹' {ε / 2}), pr w' ∈ Ω ∧ s (pr w') = w' := by
    intro w hw
    have hwX : w ∈ U ∩ N := hw.1
    obtain ⟨hyA, hyσ⟩ := hΦX w hwX
    obtain ⟨B, Ω, sec, hBo, hyB, hΩo, hsecc, hsec1, hsec2⟩ := hloc (Φ w) hyA
    refine ⟨U ∩ N ∩ Φ ⁻¹' B, Ω, fun y' => Θ (sec y') (ε / 2 - δ),
      hΦc.isOpen_inter_preimage hX hBo, ⟨hwX, hyB⟩, hΩo, ?_, ?_, ?_⟩
    · 
      have h1 : ContinuousOn (fun y' : M => (sec y', ε / 2 - δ)) (Ω ∩ frontier U) :=
        hsecc.prodMk continuousOn_const
      refine hΘc.comp h1 (fun y' hy' => ?_)
      obtain ⟨hx', hx'σ, -⟩ := hsec1 y' hy'
      show sec y' ∈ U ∩ N ∧ 0 < σ (sec y') + (ε / 2 - δ) ∧ σ (sec y') + (ε / 2 - δ) < ε
      rw [hx'σ, hyσ]
      exact ⟨⟨hx'.1.2, hx'.2⟩, by linarith, by linarith⟩
    · intro y' hy'
      obtain ⟨hx', hx'σ, hx'pr⟩ := hsec1 y' hy'
      have hx'X : sec y' ∈ U ∩ N := ⟨hx'.1.2, hx'.2⟩
      have hσx' : σ (sec y') = δ := by rw [hx'σ, hyσ]
      have h1 := hΘX (sec y') hx'X (ε / 2 - δ) (by linarith) (by linarith)
      have hσs' : σ (Θ (sec y') (ε / 2 - δ)) = ε / 2 := by rw [h1.2, hσx']; ring
      have hΦs : Φ (Θ (sec y') (ε / 2 - δ)) = sec y' := by
        rw [hΦ, hσs']
        rw [hΘadd (sec y') hx'X (ε / 2 - δ) (δ - ε / 2) (by linarith) (by linarith)
          (by linarith) (by linarith)]
        rw [show ε / 2 - δ + (δ - ε / 2) = 0 by ring, hΘ0 (sec y') hx'X]
      refine ⟨⟨⟨h1.1, ?_⟩, h1.1, hσs'⟩, ?_⟩
      · show Φ (Θ (sec y') (ε / 2 - δ)) ∈ B
        rw [hΦs]
        exact hx'.1.1.1
      · show pr (Θ (sec y') (ε / 2 - δ)) = y'
        rw [hpr, hΦs, hx'pr]
    · intro w' hw'
      obtain ⟨⟨hw'X, hw'B⟩, -, hw'σ⟩ := hw'
      have hw'σ' : σ w' = ε / 2 := hw'σ
      obtain ⟨hΦw'A, hΦw'σ⟩ := hΦX w' hw'X
      have hmem : Φ w' ∈ B ∩ A ∩ U ∩ N := ⟨⟨⟨hw'B, hΦw'A.1.1⟩, hΦw'A.1.2⟩, hΦw'A.2⟩
      obtain ⟨hΩ, hsecpr⟩ := hsec2 (Φ w') hmem (by rw [hΦw'σ, hyσ])
      refine ⟨by rw [hpr]; exact hΩ, ?_⟩
      show Θ (sec (pr w')) (ε / 2 - δ) = w'
      rw [hpr, hsecpr, hΦ, hw'σ']
      rw [hΘadd w' hw'X (δ - ε / 2) (ε / 2 - δ) (by linarith) (by linarith)
        (by linarith) (by linarith)]
      rw [show δ - ε / 2 + (ε / 2 - δ) = 0 by ring, hΘ0 w' hw'X]
  
  have hcomp_nhds : ∀ (S : Set M) (P : EigPatchedSurface M S) (q : M), q ∈ S →
      ∃ O : Set M, IsOpen O ∧ q ∈ O ∧ O ∩ S ⊆ connectedComponentIn S q := by
    intro S P q hq
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hq)
    have hmem : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hj, hq⟩
    obtain ⟨x₀, hx₀, hqx⟩ := hmem
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x₀ hx₀
    have hpc : IsPreconnected (P.param j '' Metric.ball x₀ r) :=
      (convex_ball x₀ r).isPreconnected.image _ ((P.param_cont j).mono hball)
    have hsubS : P.param j '' Metric.ball x₀ r ⊆ S := by
      rintro _ ⟨x, hx, rfl⟩
      have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hball hx, rfl⟩
      rw [P.image_eq j] at h
      exact h.2
    have hsubC : P.param j '' Metric.ball x₀ r ⊆ connectedComponentIn S q :=
      hpc.subset_connectedComponentIn ⟨x₀, Metric.mem_ball_self hr, hqx⟩ hsubS
    refine ⟨P.O j ∩ P.proj j ⁻¹' Metric.ball x₀ r,
      (P.proj_cont j).isOpen_inter_preimage (P.O_open j) Metric.isOpen_ball, ⟨hj, ?_⟩, ?_⟩
    · show P.proj j q ∈ Metric.ball x₀ r
      rw [← hqx, P.proj_param j x₀ hx₀]
      exact Metric.mem_ball_self hr
    · rintro w ⟨⟨hwO, hwB⟩, hwS⟩
      have hw : w ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hwO, hwS⟩
      obtain ⟨x, hx, rfl⟩ := hw
      apply hsubC
      refine ⟨x, ?_, rfl⟩
      have h : P.proj j (P.param j x) ∈ Metric.ball x₀ r := hwB
      rwa [P.proj_param j x hx] at h
  
  obtain ⟨Q, κ, hQ⟩ := patched_surface_pullback (frontier U) (U ∩ N ∩ σ ⁻¹' {ε / 2}) PF hLc
    (U ∩ N) hX hLX pr hprc hprF hsec
  refine ⟨Q, pr, fun j => ?_, ?_⟩
  · obtain ⟨hWsub, hheq, hKI⟩ := hQ j
    obtain ⟨z, Fk, hFk, hparam, hh⟩ := hPF (κ j)
    refine ⟨z, Fk, ⟨Q.W_open j, hFk.2.1.mono hWsub, fun x hx => hFk.2.2 x (hWsub hx)⟩,
      fun x hx => ?_, ?_⟩
    · rw [hKI x hx, hparam]
    · rw [hheq, hh]
  · exact local_section_component_image (frontier U) (U ∩ N ∩ σ ⁻¹' {ε / 2}) hLc pr
      (hprc.mono hLX) hprF
      (fun q hq => hcomp_nhds (U ∩ N ∩ σ ⁻¹' {ε / 2}) Q q hq) hsec

theorem patched_component_reps {X : Type*} [TopologicalSpace X] (S : Set X) (hS : IsCompact S)
    (P : EigPatchedSurface X S) :
    ∃ (m : ℕ) (q : Fin m → X), (∀ i, q i ∈ S) ∧ ∀ p ∈ S, ∃ i, q i ∈ connectedComponentIn S p :=
by
  have hloc : ∀ p ∈ S, connectedComponentIn S p ∪ Sᶜ ∈ 𝓝 p := by
    intro p hp
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hp)
    have hpS : p ∈ P.param j '' P.W j := by
      rw [P.image_eq j]; exact ⟨hj, hp⟩
    obtain ⟨x₀, hx₀, hx₀p⟩ := hpS
    obtain ⟨r, hr, hBW⟩ := Metric.isOpen_iff.1 (P.W_open j) x₀ hx₀
    have hVo : IsOpen (P.O j ∩ P.proj j ⁻¹' Metric.ball x₀ r) :=
      (P.proj_cont j).isOpen_inter_preimage (P.O_open j) Metric.isOpen_ball
    have hpV : p ∈ P.O j ∩ P.proj j ⁻¹' Metric.ball x₀ r := by
      refine ⟨hj, ?_⟩
      show P.proj j p ∈ Metric.ball x₀ r
      rw [← hx₀p, P.proj_param j x₀ hx₀]
      exact Metric.mem_ball_self hr
    have hTc : IsPreconnected (P.param j '' Metric.ball x₀ r) :=
      (convex_ball x₀ r).isPreconnected.image (P.param j) ((P.param_cont j).mono hBW)
    have hTS : P.param j '' Metric.ball x₀ r ⊆ S := by
      rintro _ ⟨x, hx, rfl⟩
      have : P.param j x ∈ P.param j '' P.W j := ⟨x, hBW hx, rfl⟩
      rw [P.image_eq j] at this
      exact this.2
    have hpT : p ∈ P.param j '' Metric.ball x₀ r :=
      ⟨x₀, Metric.mem_ball_self hr, hx₀p⟩
    have hTcc : P.param j '' Metric.ball x₀ r ⊆ connectedComponentIn S p :=
      hTc.subset_connectedComponentIn hpT hTS
    refine Filter.mem_of_superset (hVo.mem_nhds hpV) ?_
    intro y hy
    by_cases hyS : y ∈ S
    · left
      have hy' : y ∈ P.param j '' P.W j := by
        rw [P.image_eq j]; exact ⟨hy.1, hyS⟩
      obtain ⟨x₁, hx₁, rfl⟩ := hy'
      have h2 : P.proj j (P.param j x₁) ∈ Metric.ball x₀ r := hy.2
      rw [P.proj_param j x₁ hx₁] at h2
      exact hTcc ⟨x₁, h2, rfl⟩
    · right
      exact hyS
  obtain ⟨t, htS, hcov⟩ := hS.elim_nhds_subcover (fun x => connectedComponentIn S x ∪ Sᶜ) hloc
  refine ⟨t.card, fun i => ((t.equivFin).symm i : X), fun i => htS _ ((t.equivFin).symm i).2, ?_⟩
  intro p hp
  obtain ⟨x, hxt, hpx⟩ := Set.mem_iUnion₂.1 (hcov hp)
  have hpx' : p ∈ connectedComponentIn S x := by
    rcases hpx with h | h
    · exact h
    · exact absurd hp h
  refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  rw [← connectedComponentIn_eq hpx']
  exact mem_connectedComponentIn (htS x hxt)

theorem eig_patched_square_refine {X : Type*} [TopologicalSpace X] (S : Set X) (hS : IsCompact S)
    (P : EigPatchedSurface X S) (m : ℕ) (jm : Fin m → Fin P.n) (xm : Fin m → E2)
    (hxm : ∀ i, xm i ∈ P.W (jm i)) :
    ∃ (P' : EigPatchedSurface X S) (ι : Fin P'.n → Fin P.n),
      (∀ l, ∃ a b s : ℝ, 0 < s ∧
        P'.W l = {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s}) ∧
      (∀ l, P'.W l ⊆ P.W (ι l)) ∧ (∀ l, P'.param l = P.param (ι l)) ∧
      (∀ l, P'.h l = P.h (ι l)) ∧ ∀ i, ∃ l, ι l = jm i ∧ xm i ∈ P'.W l :=
by
  classical
  
  have hSqO : ∀ a b s : ℝ,
      IsOpen {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} := by
    intro a b s
    have c0 : Continuous fun x : E2 => x 0 := PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) 0
    have c1 : Continuous fun x : E2 => x 1 := PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) 1
    exact (isOpen_lt continuous_const c0).inter ((isOpen_lt c0 continuous_const).inter
      ((isOpen_lt continuous_const c1).inter (isOpen_lt c1 continuous_const)))
  
  have hSqN : ∀ U : Set E2, IsOpen U → ∀ y ∈ U, ∃ a b s : ℝ, 0 < s ∧
      y ∈ {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} ∧
      {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} ⊆ U := by
    intro U hU y hy
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU y hy
    refine ⟨y 0 - ε / 2, y 1 - ε / 2, ε, hε, ?_, ?_⟩
    · exact ⟨by linarith, by linarith, by linarith, by linarith⟩
    · rintro x ⟨h1, h2, h3, h4⟩
      apply hball
      have e0 : (x 0 - y 0) ^ 2 < ε ^ 2 / 4 := by
        nlinarith [mul_pos (show (0 : ℝ) < y 0 + ε / 2 - x 0 by linarith)
          (show (0 : ℝ) < x 0 - (y 0 - ε / 2) by linarith)]
      have e1 : (x 1 - y 1) ^ 2 < ε ^ 2 / 4 := by
        nlinarith [mul_pos (show (0 : ℝ) < y 1 + ε / 2 - x 1 by linarith)
          (show (0 : ℝ) < x 1 - (y 1 - ε / 2) by linarith)]
      rw [Metric.mem_ball, EuclideanSpace.dist_eq, Fin.sum_univ_two, Real.dist_eq, Real.dist_eq,
        sq_abs, sq_abs, Real.sqrt_lt' hε]
      nlinarith
  
  have hloc : ∀ q : S, ∃ (j : Fin P.n) (a b s : ℝ), 0 < s ∧
      {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} ⊆ P.W j ∧
      (q : X) ∈ P.O j ∧
      P.proj j q ∈ {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} := by
    intro q
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover q.2)
    have hq : (q : X) ∈ P.param j '' P.W j := by
      rw [P.image_eq j]; exact ⟨hj, q.2⟩
    obtain ⟨y, hy, hyq⟩ := hq
    obtain ⟨a, b, s, hs, hys, hsub⟩ := hSqN (P.W j) (P.W_open j) y hy
    refine ⟨j, a, b, s, hs, hsub, hj, ?_⟩
    rw [← hyq, P.proj_param j y hy]
    exact hys
  choose J A B Sd hpos hsub hO hproj using hloc
  obtain ⟨t, ht⟩ := hS.elim_finite_subcover
    (fun q : S => P.O (J q) ∩ P.proj (J q) ⁻¹'
      {x : E2 | A q < x 0 ∧ x 0 < A q + Sd q ∧ B q < x 1 ∧ x 1 < B q + Sd q})
    (fun q => (P.proj_cont (J q)).isOpen_inter_preimage (P.O_open (J q)) (hSqO _ _ _))
    (fun p hp => Set.mem_iUnion.2 ⟨⟨p, hp⟩, hO _, hproj _⟩)
  
  choose am bm sm hsm hxin hsubm using
    fun i => hSqN (P.W (jm i)) (P.W_open (jm i)) (xm i) (hxm i)
  
  let e := t.equivFin
  let pt : Fin t.card → S := fun l => (e.symm l).1
  let D : Fin (t.card + m) → Fin P.n × ℝ × ℝ × ℝ :=
    Fin.append (fun l => (J (pt l), A (pt l), B (pt l), Sd (pt l)))
      (fun i => (jm i, am i, bm i, sm i))
  let Q : Fin (t.card + m) → Set E2 := fun l =>
    {x : E2 | (D l).2.1 < x 0 ∧ x 0 < (D l).2.1 + (D l).2.2.2 ∧
      (D l).2.2.1 < x 1 ∧ x 1 < (D l).2.2.1 + (D l).2.2.2}
  have F1 : ∀ l, 0 < (D l).2.2.2 := by
    intro l
    induction l using Fin.addCases with
    | left l => simp only [D, Fin.append_left]; exact hpos _
    | right i => simp only [D, Fin.append_right]; exact hsm i
  have F2 : ∀ l, Q l ⊆ P.W (D l).1 := by
    intro l
    induction l using Fin.addCases with
    | left l => simp only [Q, D, Fin.append_left]; exact hsub _
    | right i => simp only [Q, D, Fin.append_right]; exact hsubm i
  have F3 : ∀ l, IsOpen (Q l) := fun l => hSqO _ _ _
  have F4 : ∀ l, IsOpen (P.O (D l).1 ∩ P.proj (D l).1 ⁻¹' Q l) := fun l =>
    (P.proj_cont _).isOpen_inter_preimage (P.O_open _) (F3 l)
  have hIm : ∀ l, P.param (D l).1 '' Q l = (P.O (D l).1 ∩ P.proj (D l).1 ⁻¹' Q l) ∩ S := by
    intro l
    ext p
    constructor
    · rintro ⟨x, hx, rfl⟩
      have hxW := F2 l hx
      have hm : P.param (D l).1 x ∈ P.O (D l).1 ∩ S := by
        rw [← P.image_eq]; exact ⟨x, hxW, rfl⟩
      refine ⟨⟨hm.1, ?_⟩, hm.2⟩
      show P.proj (D l).1 (P.param (D l).1 x) ∈ Q l
      rw [P.proj_param _ x hxW]
      exact hx
    · rintro ⟨⟨hpO, hpQ⟩, hpS⟩
      have hm : p ∈ P.param (D l).1 '' P.W (D l).1 := by
        rw [P.image_eq]; exact ⟨hpO, hpS⟩
      obtain ⟨y, hy, rfl⟩ := hm
      refine ⟨y, ?_, rfl⟩
      have h' : P.proj (D l).1 (P.param (D l).1 y) ∈ Q l := hpQ
      rwa [P.proj_param _ y hy] at h'
  have hcov : S ⊆ ⋃ l, P.O (D l).1 ∩ P.proj (D l).1 ⁻¹' Q l := by
    intro p hp
    obtain ⟨q, hq, hpq⟩ := Set.mem_iUnion₂.1 (ht hp)
    refine Set.mem_iUnion.2 ⟨Fin.castAdd m (e ⟨q, hq⟩), ?_⟩
    have hpt : pt (e ⟨q, hq⟩) = q := by
      simp only [pt, Equiv.symm_apply_apply]
    have hD : D (Fin.castAdd m (e ⟨q, hq⟩)) = (J q, A q, B q, Sd q) := by
      simp only [D, Fin.append_left, hpt]
    simp only [Q, hD]
    exact hpq
  let P' : EigPatchedSurface X S :=
    { n := t.card + m
      W := Q
      param := fun l => P.param (D l).1
      proj := fun l => P.proj (D l).1
      O := fun l => P.O (D l).1 ∩ P.proj (D l).1 ⁻¹' Q l
      h := fun l => P.h (D l).1
      W_open := F3
      O_open := F4
      param_cont := fun l => (P.param_cont _).mono (F2 l)
      proj_cont := fun l => (P.proj_cont _).mono Set.inter_subset_left
      image_eq := hIm
      proj_param := fun l x hx => P.proj_param _ x (F2 l hx)
      cover := hcov
      trans_smooth := fun l k =>
        (P.trans_smooth (D l).1 (D k).1).mono (fun x hx => ⟨F2 l hx.1, hx.2.1⟩)
      h_smooth := fun l a b => (P.h_smooth _ a b).mono (F2 l)
      h_posDef := fun l x hx => P.h_posDef _ x (F2 l hx)
      h_compat := fun l k x hx a b =>
        P.h_compat (D l).1 (D k).1 x ⟨F2 l hx.1, hx.2.1⟩ a b }
  refine ⟨P', fun l => (D l).1, fun l => ⟨(D l).2.1, (D l).2.2.1, (D l).2.2.2, F1 l, rfl⟩,
    fun l => F2 l, fun l => rfl, fun l => rfl, fun i => ⟨Fin.natAdd t.card i, ?_, ?_⟩⟩
  · simp only [D, Fin.append_right]
  · show xm i ∈ Q (Fin.natAdd t.card i)
    simp only [Q, D, Fin.append_right]
    exact hxin i

theorem patched_circle_smooth_approx {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (hS : IsCompact S) (P : EigPatchedSurface X S) (θ : C(S, Circle)) :
    ∃ (Ψ : X → Circle) (ψ : C(S, ℝ)),
      (∀ j, ContDiffOn ℝ ∞ (fun x => (Ψ (P.param j x) : ℂ)) (P.W j)) ∧
      ∀ x : S, θ x = Ψ x * Circle.exp (ψ x) :=
by
  classical
  haveI : CompactSpace S := isCompact_iff_compactSpace.mp hS
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  
  have hcontS : ∀ F : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => F (P.param j x)) (P.W j)) →
      Continuous (fun s : S => F s) := by
    intro F hF
    have huc : ContinuousOn F S := by
      intro s hs
      obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (P.cover hs)
      have hc : ContinuousOn (fun p => F (P.param l (P.proj l p))) (P.O l ∩ S) := by
        refine (hF l).continuousOn.comp ((P.proj_cont l).mono Set.inter_subset_left) ?_
        intro p hp
        have : p ∈ P.param l '' P.W l := by rw [P.image_eq l]; exact hp
        obtain ⟨y, hy, rfl⟩ := this
        rw [P.proj_param l y hy]; exact hy
      have hc' : ContinuousOn F (P.O l ∩ S) := by
        refine hc.congr ?_
        intro p hp
        have : p ∈ P.param l '' P.W l := by rw [P.image_eq l]; exact hp
        obtain ⟨y, hy, rfl⟩ := this
        simp only [P.proj_param l y hy]
      refine (hc' s ⟨hl, hs⟩).mono_of_mem_nhdsWithin ?_
      rw [Set.inter_comm]
      exact inter_mem_nhdsWithin S ((P.O_open l).mem_nhds hl)
    exact continuousOn_iff_continuous_restrict.1 huc
  
  have hlift : ∀ (k : Fin P.n) (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ P.W k →
      ∀ j, ContDiffOn ℝ ∞
        (fun x => (fun q => if q ∈ P.O k then ζ (P.proj k q) else 0) (P.param j x)) (P.W j) := by
    intro k ζ hζ hc hs
    set F : Set X := P.param k '' tsupport ζ with hFdef
    have hFO : F ⊆ P.O k := by
      rintro _ ⟨y, hy, rfl⟩
      exact (hP1 k y (hs hy)).1
    have hFc : IsClosed F :=
      (hc.isCompact.image_of_continuousOn ((P.param_cont k).mono hs)).isClosed
    set Z : X → ℝ := fun q => if q ∈ P.O k then ζ (P.proj k q) else 0 with hZdef
    have hZ0 : ∀ q, q ∉ P.O k → Z q = 0 := fun q hq => by simp only [hZdef, if_neg hq]
    have hZf : ∀ q ∈ P.O k, Z q = ζ (P.proj k q) := fun q hq => by simp only [hZdef, if_pos hq]
    have hstar : ∀ q ∈ S, q ∉ F → Z q = 0 := by
      intro q hqS hqF
      by_cases hqO : q ∈ P.O k
      · have hq : q ∈ P.O k ∩ S := ⟨hqO, hqS⟩
        rw [← P.image_eq k] at hq
        obtain ⟨y, hy, hyq⟩ := hq
        rw [hZf q hqO, ← hyq, P.proj_param k y hy]
        by_contra hne
        exact hqF ⟨y, subset_tsupport ζ (Function.mem_support.mpr hne), hyq⟩
      · exact hZ0 q hqO
    have hNopen : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' Fᶜ) := fun j =>
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) hFc.isOpen_compl
    have hNzero : ∀ j, ∀ x' ∈ P.W j ∩ P.param j ⁻¹' Fᶜ, Z (P.param j x') = 0 := by
      intro j x' hx'
      exact hstar _ (hP1 j x' hx'.1).2 hx'.2
    intro j
    show ContDiffOn ℝ ∞ (fun x => Z (P.param j x)) (P.W j)
    refine contDiffOn_of_locally_contDiffOn (fun x hx => ?_)
    by_cases hxO : P.param j x ∈ P.O k
    · refine ⟨P.W j ∩ P.param j ⁻¹' P.O k,
        (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k), ⟨hx, hxO⟩, ?_⟩
      have h1 : ContDiffOn ℝ ∞ (fun x' => ζ (P.proj k (P.param j x')))
          (P.W j ∩ P.param j ⁻¹' P.O k) := hζ.comp_contDiffOn (P.trans_smooth j k)
      refine (h1.mono Set.inter_subset_right).congr ?_
      intro y hy
      exact hZf _ hy.2.2
    · have hxF : P.param j x ∉ F := fun h => hxO (hFO h)
      refine ⟨P.W j ∩ P.param j ⁻¹' Fᶜ, hNopen j, ⟨hx, hxF⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
      intro y hy
      exact hNzero j y hy.2
  
  have hsep : ∀ x y : X, x ∈ S → y ∈ S → x ≠ y → ∃ Z : X → ℝ,
      (∀ j, ContDiffOn ℝ ∞ (fun z => Z (P.param j z)) (P.W j)) ∧ Z x ≠ Z y := by
    intro x y hx hy hxy
    obtain ⟨k, hk⟩ := Set.mem_iUnion.1 (P.cover hx)
    have hxk : x ∈ P.param k '' P.W k := by rw [P.image_eq k]; exact ⟨hk, hx⟩
    obtain ⟨a, ha, hax⟩ := hxk
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp (P.W_open k) a ha
    have hR : ∃ R : ℝ, 0 < R ∧ R < ε ∧ ∀ b ∈ P.W k, P.param k b = y → R ≤ dist b a := by
      by_cases hyO : y ∈ P.O k
      · have hyk : y ∈ P.param k '' P.W k := by rw [P.image_eq k]; exact ⟨hyO, hy⟩
        obtain ⟨b₁, hb₁, hb₁y⟩ := hyk
        have hne : b₁ ≠ a := by
          intro h
          apply hxy
          rw [← hax, ← hb₁y, h]
        have hd : 0 < dist b₁ a := dist_pos.mpr hne
        refine ⟨min (ε / 2) (dist b₁ a / 2), lt_min (by linarith) (by linarith),
          lt_of_le_of_lt (min_le_left _ _) (by linarith), ?_⟩
        intro b hb hby
        have hbb : b = b₁ := by
          rw [← P.proj_param k b hb, ← P.proj_param k b₁ hb₁, hby, hb₁y]
        rw [hbb]
        exact le_trans (min_le_right _ _) (by linarith)
      · refine ⟨ε / 2, by linarith, by linarith, ?_⟩
        intro b hb hby
        exact absurd (hby ▸ (hP1 k b hb).1) hyO
    obtain ⟨R, hR0, hRε, hRy⟩ := hR
    let ζ : ContDiffBump a := ⟨R / 2, R, by linarith, by linarith⟩
    have hζs : tsupport ζ ⊆ P.W k := by
      rw [ζ.tsupport_eq]
      intro z hz
      apply hball
      rw [Metric.mem_ball]
      rw [Metric.mem_closedBall] at hz
      exact lt_of_le_of_lt hz (by simpa using hRε)
    refine ⟨fun q => if q ∈ P.O k then ζ (P.proj k q) else 0,
      hlift k ζ ζ.contDiff ζ.hasCompactSupport hζs, ?_⟩
    have hZx : (if x ∈ P.O k then ζ (P.proj k x) else 0) = 1 := by
      rw [if_pos hk, ← hax, P.proj_param k a ha]
      exact ζ.one_of_mem_closedBall (Metric.mem_closedBall_self ζ.rIn_pos.le)
    have hZy : (if y ∈ P.O k then ζ (P.proj k y) else 0) = 0 := by
      by_cases hyO : y ∈ P.O k
      · rw [if_pos hyO]
        have hyk : y ∈ P.param k '' P.W k := by rw [P.image_eq k]; exact ⟨hyO, hy⟩
        obtain ⟨b₁, hb₁, hb₁y⟩ := hyk
        rw [← hb₁y, P.proj_param k b₁ hb₁]
        apply Function.notMem_support.mp
        rw [ζ.support_eq, Metric.mem_ball]
        have := hRy b₁ hb₁ hb₁y
        simp only [ζ]
        linarith
      · rw [if_neg hyO]
    show (if x ∈ P.O k then ζ (P.proj k x) else 0) ≠ (if y ∈ P.O k then ζ (P.proj k y) else 0)
    rw [hZx, hZy]
    exact one_ne_zero
  
  let A : Subalgebra ℝ C(S, ℝ) :=
    { carrier := {g | ∃ F : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => F (P.param j x)) (P.W j)) ∧
        ∀ s : S, g s = F s}
      mul_mem' := by
        rintro g₁ g₂ ⟨F₁, hF₁, e₁⟩ ⟨F₂, hF₂, e₂⟩
        exact ⟨fun p => F₁ p * F₂ p, fun j => (hF₁ j).mul (hF₂ j),
          fun s => by simp [e₁, e₂]⟩
      add_mem' := by
        rintro g₁ g₂ ⟨F₁, hF₁, e₁⟩ ⟨F₂, hF₂, e₂⟩
        exact ⟨fun p => F₁ p + F₂ p, fun j => (hF₁ j).add (hF₂ j),
          fun s => by simp [e₁, e₂]⟩
      algebraMap_mem' := by
        intro r
        exact ⟨fun _ => r, fun j => contDiffOn_const,
          fun s => by simp [Algebra.algebraMap_eq_smul_one]⟩ }
  have hA : A.SeparatesPoints := by
    intro s t hst
    have hst' : (s : X) ≠ (t : X) := Subtype.coe_ne_coe.mpr hst
    obtain ⟨Z, hZ, hZst⟩ := hsep s t s.2 t.2 hst'
    exact ⟨fun u : S => Z u, ⟨⟨fun u : S => Z u, hcontS Z hZ⟩, ⟨Z, hZ, fun u => rfl⟩, rfl⟩, hZst⟩
  have happrox : ∀ f : C(S, ℝ), ∃ F : X → ℝ,
      (∀ j, ContDiffOn ℝ ∞ (fun x => F (P.param j x)) (P.W j)) ∧ ∀ s : S, |F s - f s| < 1 / 4 := by
    intro f
    obtain ⟨g, hg⟩ :=
      ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints A hA f (1 / 4)
        (by norm_num)
    obtain ⟨F, hF, hgF⟩ := g.2
    refine ⟨F, hF, fun s => ?_⟩
    have h1 := ContinuousMap.norm_coe_le_norm ((g : C(S, ℝ)) - f) s
    rw [ContinuousMap.sub_apply, Real.norm_eq_abs, hgF s] at h1
    exact lt_of_le_of_lt h1 hg
  
  set θc : S → ℂ := fun s => ((θ s : Circle) : ℂ) with hθcdef
  have hθcc : Continuous θc := continuous_subtype_val.comp θ.continuous
  let f₁ : C(S, ℝ) := ⟨fun s => (θc s).re, Complex.continuous_re.comp hθcc⟩
  let f₂ : C(S, ℝ) := ⟨fun s => (θc s).im, Complex.continuous_im.comp hθcc⟩
  obtain ⟨a, ha, hac⟩ := happrox f₁
  obtain ⟨b, hb, hbc⟩ := happrox f₂
  
  set F : X → ℂ := fun p => (a p : ℂ) + (b p : ℂ) * Complex.I with hFdef
  have hFre : ∀ p, (F p).re = a p := by intro p; simp [F]
  have hFim : ∀ p, (F p).im = b p := by intro p; simp [F]
  have hFclose : ∀ s : S, ‖F s - θc s‖ < 1 / 2 := by
    intro s
    have h1 := Complex.norm_le_abs_re_add_abs_im (F s - θc s)
    rw [Complex.sub_re, Complex.sub_im, hFre, hFim] at h1
    have h2 : |a s - (θc s).re| < 1 / 4 := hac s
    have h3 : |b s - (θc s).im| < 1 / 4 := hbc s
    linarith
  have hθn : ∀ s : S, ‖θc s‖ = 1 := fun s => Circle.norm_coe (θ s)
  have hFa : ∀ s : S, |‖F s‖ - 1| < 1 / 2 := by
    intro s
    have h := abs_norm_sub_norm_le (F s) (θc s)
    rw [hθn s] at h
    exact lt_of_le_of_lt h (hFclose s)
  have hFpos : ∀ s : S, 0 < ‖F s‖ := by
    intro s
    have h := hFa s
    rw [abs_lt] at h
    linarith [h.1]
  have hF0 : ∀ s : S, F s ≠ 0 := fun s => norm_pos_iff.mp (hFpos s)
  
  have hid : ∀ z : ℂ, z ≠ 0 →
      ((Circle.exp (Complex.arg z) : Circle) : ℂ) = ((‖z‖⁻¹ : ℝ) : ℂ) * z := by
    intro z hz
    have hn : (‖z‖ : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.mpr hz
    have h := Complex.norm_mul_exp_arg_mul_I z
    rw [Circle.coe_exp]
    calc Complex.exp (↑(Complex.arg z) * Complex.I)
        = (‖z‖ : ℂ)⁻¹ * ((‖z‖ : ℂ) * Complex.exp (↑(Complex.arg z) * Complex.I)) := by
          rw [← mul_assoc, inv_mul_cancel₀ hn, one_mul]
      _ = ((‖z‖⁻¹ : ℝ) : ℂ) * z := by rw [h, Complex.ofReal_inv]
  set Ψ : X → Circle := fun p => Circle.exp (Complex.arg (F p)) with hΨdef
  
  have hΨs : ∀ j, ContDiffOn ℝ ∞ (fun x => (Ψ (P.param j x) : ℂ)) (P.W j) := by
    intro j
    have hGa : ContDiffOn ℝ ∞ (fun x => (a (P.param j x) : ℂ)) (P.W j) :=
      Complex.ofRealCLM.contDiff.comp_contDiffOn (ha j)
    have hGb : ContDiffOn ℝ ∞ (fun x => (b (P.param j x) : ℂ)) (P.W j) :=
      Complex.ofRealCLM.contDiff.comp_contDiffOn (hb j)
    have hG : ContDiffOn ℝ ∞ (fun x => F (P.param j x)) (P.W j) :=
      hGa.add (hGb.mul contDiffOn_const)
    have hG0 : ∀ x ∈ P.W j, F (P.param j x) ≠ 0 := fun x hx =>
      hF0 ⟨P.param j x, (hP1 j x hx).2⟩
    have hN : ContDiffOn ℝ ∞ (fun x => ‖F (P.param j x)‖⁻¹ • F (P.param j x)) (P.W j) := by
      intro x hx
      have hGx : ContDiffAt ℝ ∞ (fun x => F (P.param j x)) x :=
        hG.contDiffAt ((P.W_open j).mem_nhds hx)
      have h1 : ContDiffAt ℝ ∞ (fun z : ℂ => ‖z‖⁻¹) (F (P.param j x)) :=
        (contDiffAt_norm ℝ (hG0 x hx)).inv (norm_ne_zero_iff.mpr (hG0 x hx))
      have h2 : ContDiffAt ℝ ∞ ((fun z : ℂ => ‖z‖⁻¹) ∘ (fun x => F (P.param j x))) x :=
        h1.comp x hGx
      exact (h2.smul hGx).contDiffWithinAt
    refine hN.congr ?_
    intro x hx
    simp only [Ψ]
    rw [hid _ (hG0 x hx), Complex.real_smul]
  
  set N : S → ℂ := fun s => ((‖F s‖⁻¹ : ℝ) : ℂ) * F s with hNdef
  have hNn : ∀ s, ‖N s‖ = 1 := by
    intro s
    simp only [N, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr (hFpos s))]
    exact inv_mul_cancel₀ (hFpos s).ne'
  have hFSc : Continuous (fun s : S => F s) := by
    have hca := hcontS a ha
    have hcb := hcontS b hb
    exact (Complex.continuous_ofReal.comp hca).add
      ((Complex.continuous_ofReal.comp hcb).mul continuous_const)
  have hNc : Continuous N := by
    refine (Complex.continuous_ofReal.comp ?_).mul hFSc
    exact (continuous_norm.comp hFSc).inv₀ (fun s => (hFpos s).ne')
  have hΨN : ∀ s : S, ((Ψ s : Circle) : ℂ) = N s := fun s => hid _ (hF0 s)
  have hNmem : ∀ s, N s ∈ Submonoid.unitSphere ℂ := by
    intro s
    show N s ∈ Metric.sphere (0 : ℂ) 1
    rw [mem_sphere_zero_iff_norm]
    exact hNn s
  have hΨSc : Continuous (fun s : S => Ψ s) := by
    have heq : (fun s : S => Ψ s) = fun s => (⟨N s, hNmem s⟩ : Circle) := by
      funext s
      apply Circle.ext
      rw [hΨN s]
    rw [heq]
    exact hNc.subtype_mk hNmem
  have hNclose : ∀ s, ‖θc s - N s‖ < 1 := by
    intro s
    have hpos := hFpos s
    have e1 : F s - N s = ((1 - ‖F s‖⁻¹ : ℝ) : ℂ) * F s := by
      simp only [N]; push_cast; ring
    have e2 : ‖F s - N s‖ = |‖F s‖ - 1| := by
      rw [e1, norm_mul, Complex.norm_real, Real.norm_eq_abs, ← abs_of_pos hpos, ← abs_mul,
        abs_of_pos hpos]
      congr 1
      field_simp
    calc ‖θc s - N s‖ = ‖(θc s - F s) + (F s - N s)‖ := by ring_nf
      _ ≤ ‖θc s - F s‖ + ‖F s - N s‖ := norm_add_le _ _
      _ = ‖F s - θc s‖ + ‖F s - N s‖ := by rw [norm_sub_rev]
      _ < 1 := by rw [e2]; linarith [hFclose s, hFa s]
  
  let w : C(S, Circle) := ⟨fun s => θ s * (Ψ s)⁻¹, θ.continuous.mul hΨSc.inv⟩
  have hwcoe : ∀ s, ((w s : Circle) : ℂ) = θc s * (N s)⁻¹ := by
    intro s
    show ((θ s * (Ψ s)⁻¹ : Circle) : ℂ) = _
    rw [Circle.coe_mul, Circle.coe_inv, hΨN]
  have hwn : ∀ s, ‖((w s : Circle) : ℂ) - 1‖ < 1 := by
    intro s
    have hN0 : N s ≠ 0 := by
      intro h; have := hNn s; rw [h, norm_zero] at this; exact zero_ne_one this
    have e : θc s * (N s)⁻¹ - 1 = (θc s - N s) * (N s)⁻¹ := by
      field_simp
    rw [hwcoe, e, norm_mul, norm_inv, hNn s, inv_one, mul_one]
    exact hNclose s
  have hslit : ∀ s, ((w s : Circle) : ℂ) ∈ Complex.slitPlane := by
    intro s
    apply Complex.mem_slitPlane_iff.mpr
    left
    have h1 := Complex.abs_re_le_norm (((w s : Circle) : ℂ) - 1)
    have h2 := hwn s
    rw [Complex.sub_re, Complex.one_re] at h1
    have h4 : |(((w s : Circle) : ℂ)).re - 1| < 1 := lt_of_le_of_lt h1 h2
    rw [abs_lt] at h4
    linarith [h4.1]
  let ψ : C(S, ℝ) := ⟨fun s => Complex.arg ((w s : Circle) : ℂ),
    Complex.continuousOn_arg.comp_continuous (continuous_subtype_val.comp w.continuous) hslit⟩
  have hψ : ∀ s, Circle.exp (ψ s) = w s := fun s => Circle.exp_arg (w s)
  refine ⟨Ψ, ψ, hΨs, fun s => ?_⟩
  rw [hψ s]
  show θ s = Ψ s * (θ s * (Ψ s)⁻¹)
  rw [mul_comm (θ s), ← mul_assoc, mul_inv_cancel, one_mul]

theorem convex_circle_smooth_lift (W : Set E2) (hW : IsOpen W) (hWc : Convex ℝ W)
    (Ψ : E2 → Circle) (hΨ : ContDiffOn ℝ ∞ (fun x => (Ψ x : ℂ)) W) :
    ∃ θ : E2 → ℝ, ContDiffOn ℝ ∞ θ W ∧ ∀ x ∈ W, Ψ x = Circle.exp (θ x) :=
by
  
  have hcont : ∃ θ : E2 → ℝ, ContinuousOn θ W ∧ ∀ x ∈ W, Ψ x = Circle.exp (θ x) := by
    classical
    rcases W.eq_empty_or_nonempty with hE | ⟨x₀, hx₀⟩
    · refine ⟨fun _ => 0, ?_, ?_⟩
      · rw [hE]; exact continuousOn_empty _
      · intro x hx; rw [hE] at hx; exact absurd hx (Set.notMem_empty x)
    have hΨc : ContinuousOn Ψ W :=
      ((Topology.IsInducing.subtypeVal : Topology.IsInducing ((↑) : Circle → ℂ)).continuousOn_iff).2
        hΨ.continuousOn
    have hres : Continuous (W.restrict Ψ) := hΨc.restrict
    let seg : C(unitInterval × W, W) :=
      ⟨fun p => ⟨x₀ + (p.1 : ℝ) • ((p.2 : E2) - x₀),
        hWc.add_smul_sub_mem hx₀ p.2.2 ⟨p.1.2.1, p.1.2.2⟩⟩, by
        refine Continuous.subtype_mk ?_ _
        fun_prop⟩
    let H : C(unitInterval × W, Circle) :=
      ⟨fun p => W.restrict Ψ (seg p), hres.comp seg.continuous⟩
    let f : C(W, ℝ) := ContinuousMap.const W (Complex.arg (Ψ x₀ : ℂ))
    have H0 : ∀ a, H (0, a) = Circle.exp (f a) := by
      intro a
      simp [H, seg, f, Circle.exp_arg]
    let Θ := Circle.isCoveringMap_exp.liftHomotopy H f H0
    have hlift := Circle.isCoveringMap_exp.liftHomotopy_lifts H f H0
    refine ⟨fun x => if hx : x ∈ W then Θ (1, ⟨x, hx⟩) else 0, ?_, ?_⟩
    · rw [continuousOn_iff_continuous_restrict]
      have hr : W.restrict (fun x => if hx : x ∈ W then Θ (1, ⟨x, hx⟩) else 0) =
          fun a => Θ (1, a) := by
        funext a
        simp [Set.restrict, a.2]
      rw [hr]
      exact Θ.continuous.comp (continuous_const.prodMk continuous_id)
    · intro x hx
      simp only [dif_pos hx]
      have h1 := congrFun hlift (1, ⟨x, hx⟩)
      simp only [Function.comp] at h1
      rw [h1]
      simp [H, seg]
  obtain ⟨θ, hθc, hθ⟩ := hcont
  refine ⟨θ, ?_, hθ⟩
  
  intro x₁ hx₁
  have hWx₁ : W ∈ 𝓝 x₁ := hW.mem_nhds hx₁
  apply ContDiffAt.contDiffWithinAt
  set c : ℂ := (((Ψ x₁)⁻¹ : Circle) : ℂ) with hc
  set z : E2 → ℂ := fun x => (Ψ x : ℂ) * c with hzdef
  have hz1 : z x₁ = 1 := by
    simp only [hzdef, hc]
    rw [← Circle.coe_mul, mul_inv_cancel, Circle.coe_one]
  set φ : E2 → ℝ := fun x => θ x₁ + (Complex.log (z x)).im with hφdef
  have hzd : ContDiffAt ℝ ∞ z x₁ := (hΨ.contDiffAt hWx₁).mul contDiffAt_const
  have hlog : ContDiffAt ℝ ∞ Complex.log (z x₁) := by
    rw [hz1]
    exact (Complex.contDiffAt_log Complex.one_mem_slitPlane).restrict_scalars ℝ
  have hφd : ContDiffAt ℝ ∞ φ x₁ :=
    contDiffAt_const.add (Complex.imCLM.contDiff.comp_contDiffAt x₁ (hlog.comp x₁ hzd))
  have hexp : ∀ x ∈ W, Circle.exp (φ x) = Circle.exp (θ x) := by
    intro x hx
    have hw : z x = ((Ψ x * (Ψ x₁)⁻¹ : Circle) : ℂ) := by
      simp only [hzdef, hc, Circle.coe_mul]
    simp only [hφdef]
    rw [Circle.exp_add, Complex.log_im, hw, Circle.exp_arg, ← hθ x₁ hx₁, ← hθ x hx,
      mul_comm (Ψ x), mul_inv_cancel_left]
  have hθφ : θ =ᶠ[𝓝 x₁] φ := by
    have hcd : ContinuousAt (fun x => |θ x - φ x|) x₁ :=
      ((hθc.continuousAt hWx₁).sub hφd.continuousAt).abs
    have h0 : |θ x₁ - φ x₁| = 0 := by
      simp [hφdef, hz1]
    have hp : (0 : ℝ) < 2 * Real.pi := by positivity
    have hev : ∀ᶠ x in 𝓝 x₁, |θ x - φ x| < 2 * Real.pi :=
      hcd.eventually_lt continuousAt_const (by rw [h0]; exact hp)
    filter_upwards [hev, hWx₁] with x hx hxW
    obtain ⟨m, hm⟩ := Circle.exp_eq_exp.1 (hexp x hxW).symm
    have hm' : |(m : ℝ)| < 1 := by
      rw [hm, add_sub_cancel_left, abs_mul, abs_of_pos hp] at hx
      nlinarith
    have hm0 : m = 0 := by
      rw [← Int.abs_lt_one_iff]
      exact_mod_cast hm'
    rw [hm, hm0]
    simp
  exact hφd.congr_of_eventuallyEq hθφ

theorem circle_exp_eq_fderiv_eq (W : Set E2) (hW : IsOpen W) (f g : E2 → ℝ)
    (hf : ContDiffOn ℝ ∞ f W) (hg : ContDiffOn ℝ ∞ g W)
    (heq : ∀ x ∈ W, Circle.exp (f x) = Circle.exp (g x)) :
    ∀ x ∈ W, fderiv ℝ f x = fderiv ℝ g x :=
by
  intro x hx
  have hWx : W ∈ 𝓝 x := hW.mem_nhds hx
  have hfc : ContinuousAt f x := hf.continuousOn.continuousAt hWx
  have hgc : ContinuousAt g x := hg.continuousOn.continuousAt hWx
  have hhc : ContinuousAt (fun y => f y - g y) x := hfc.sub hgc
  have hpi : 0 < 2 * Real.pi := by have := Real.pi_pos; linarith
  have hnear : ∀ᶠ y in 𝓝 x, dist (f y - g y) (f x - g x) < 2 * Real.pi :=
    (Metric.tendsto_nhds.mp hhc) _ hpi
  have hev : f =ᶠ[𝓝 x] (fun y => g y + (f x - g x)) := by
    filter_upwards [hWx, hnear] with y hy hd
    obtain ⟨m, hm⟩ := Circle.exp_eq_exp.mp (heq y hy)
    obtain ⟨n, hn⟩ := Circle.exp_eq_exp.mp (heq x hx)
    rw [Real.dist_eq] at hd
    have hk : (f y - g y) - (f x - g x) = ((m - n : ℤ) : ℝ) * (2 * Real.pi) := by
      push_cast
      linear_combination hm - hn
    rw [hk, abs_mul, abs_of_pos hpi] at hd
    have h1 : |((m - n : ℤ) : ℝ)| < 1 := by
      by_contra hcon
      push_neg at hcon
      nlinarith
    rw [abs_lt] at h1
    obtain ⟨h2, h3⟩ := h1
    have h4 : (-1 : ℤ) < m - n := by exact_mod_cast h2
    have h5 : m - n < 1 := by exact_mod_cast h3
    have h6 : m = n := by omega
    subst h6
    linarith
  rw [hev.fderiv_eq, fderiv_add_const]

theorem eig_form_pair_compat {X : Type*} [TopologicalSpace X] (S : Set X)
    (P : EigPatchedSurface X S) (f g : Fin P.n → E2 → ℝ)
    (hf : ∀ j, ContDiffOn ℝ ∞ (f j) (P.W j)) (hg : ∀ j, ContDiffOn ℝ ∞ (g j) (P.W j))
    (hcf : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (f j) x = fderiv ℝ (fun x' => f k (P.proj k (P.param j x'))) x)
    (hcg : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (g j) x = fderiv ℝ (fun x' => g k (P.proj k (P.param j x'))) x)
    (j k : Fin P.n) (x : E2) (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) :
    ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a (f j) x * pd2 b (g j) x =
      ∑ a : Fin 2, ∑ b : Fin 2, (P.h k (P.proj k (P.param j x)))⁻¹ a b *
        pd2 a (f k) (P.proj k (P.param j x)) * pd2 b (g k) (P.proj k (P.param j x)) :=
by
  classical
  have hD : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hP3 : ∀ x' ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x') ∈ P.W k ∧ P.param k (P.proj k (P.param j x')) = P.param j x' := by
    intro x' hx'
    have h1 : P.param j x' ∈ P.O j ∩ S := by
      rw [← P.image_eq j]; exact ⟨x', hx'.1, rfl⟩
    have h2 : P.param j x' ∈ P.param k '' P.W k := by
      rw [P.image_eq k]; exact ⟨hx'.2, h1.2⟩
    obtain ⟨y', hy', hyeq⟩ := h2
    rw [← hyeq, P.proj_param k y' hy']
    exact ⟨hy', rfl⟩
  have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
    ((P.trans_smooth j k).contDiffAt (hD.mem_nhds hx)).differentiableAt (by simp)
  have hyW : P.proj k (P.param j x) ∈ P.W k := (hP3 x hx).1
  have chain : ∀ (φ : Fin P.n → E2 → ℝ), (∀ i, ContDiffOn ℝ ∞ (φ i) (P.W i)) →
      fderiv ℝ (φ j) x = fderiv ℝ (fun x' => φ k (P.proj k (P.param j x'))) x →
      ∀ b : Fin 2, pd2 b (φ j) x =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c *
          pd2 c (φ k) (P.proj k (P.param j x)) := by
    intro φ hφ hcφ b
    have hfd : DifferentiableAt ℝ (φ k) (P.proj k (P.param j x)) :=
      ((hφ k).contDiffAt ((P.W_open k).mem_nhds hyW)).differentiableAt (by simp)
    unfold pd2
    rw [hcφ, show (fun x' => φ k (P.proj k (P.param j x'))) =
      (φ k) ∘ (fun x' => P.proj k (P.param j x')) from rfl,
      fderiv_comp x hfd hτd, ContinuousLinearMap.comp_apply]
    have hw' : fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c • e2 c := by
      ext i
      fin_cases i <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
    conv_lhs => rw [hw']
    simp only [map_sum, map_smul, smul_eq_mul]
  set J : Matrix (Fin 2) (Fin 2) ℝ :=
    Matrix.of fun c a => fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c with hJ
  have hKJ : P.h j x = J.transpose * P.h k (P.proj k (P.param j x)) * J := by
    ext a b
    rw [P.h_compat j k x hx a b]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply, Fin.sum_univ_two]
    ring
  have hdetK : 0 < (P.h j x).det := (P.h_posDef j x hx.1).det_pos
  have hJdet : IsUnit J.det := by
    rw [isUnit_iff_ne_zero]
    intro h0
    have : (P.h j x).det = 0 := by
      rw [hKJ, Matrix.det_mul, Matrix.det_mul, h0]; simp
    linarith
  have hJTdet : IsUnit J.transpose.det := by rwa [Matrix.det_transpose]
  have hinv : J * (P.h j x)⁻¹ * J.transpose = (P.h k (P.proj k (P.param j x)))⁻¹ := by
    rw [hKJ, Matrix.mul_inv_rev, Matrix.mul_inv_rev, ← Matrix.mul_assoc J J⁻¹,
      Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul, Matrix.mul_assoc,
      Matrix.nonsing_inv_mul J.transpose hJTdet, Matrix.mul_one]
  have e : ∀ c d : Fin 2, (J * (P.h j x)⁻¹ * J.transpose) c d =
      (P.h k (P.proj k (P.param j x)))⁻¹ c d := fun c d => by rw [hinv]
  have e00 := e 0 0
  have e01 := e 0 1
  have e10 := e 1 0
  have e11 := e 1 1
  simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
    Fin.sum_univ_two] at e00 e01 e10 e11
  have cf := chain f hf (hcf j k x hx)
  have cg := chain g hg (hcg j k x hx)
  simp only [Fin.sum_univ_two]
  rw [cf 0, cf 1, cg 0, cg 1]
  simp only [Fin.sum_univ_two]
  linear_combination
    (pd2 0 (f k) (P.proj k (P.param j x)) * pd2 0 (g k) (P.proj k (P.param j x))) * e00 +
    (pd2 0 (f k) (P.proj k (P.param j x)) * pd2 1 (g k) (P.proj k (P.param j x))) * e01 +
    (pd2 1 (f k) (P.proj k (P.param j x)) * pd2 0 (g k) (P.proj k (P.param j x))) * e10 +
    (pd2 1 (f k) (P.proj k (P.param j x)) * pd2 1 (g k) (P.proj k (P.param j x))) * e11

theorem chart_dirichlet_form_facts (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) :
    (∀ f g : E2 → ℝ, ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W →
      ContinuousOn (fun x => ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b g x) W) ∧
    (∀ f : E2 → ℝ, ∀ x ∈ W, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) ∧
    (∀ f g : E2 → ℝ, ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W → ∀ x ∈ W, ∀ t : ℝ,
      ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a (fun y => f y - t * g y) x *
          pd2 b (fun y => f y - t * g y) x =
        ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x
        - 2 * t * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a g x * pd2 b f x
        + t ^ 2 * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a g x * pd2 b g x) ∧
    ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, 0 ≤ C ∧ ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      ∫ x in L, ∑ k : Fin 2, (pd2 k f x) ^ 2 ≤
        C * ∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) *
          Real.sqrt (h x).det :=
by
  classical
  
  have hinvsym : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef → A⁻¹ 1 0 = A⁻¹ 0 1 := by
    intro A hA
    have := hA.isHermitian.inv.apply 0 1
    simpa using this
  have alg : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef → ∀ v : Fin 2 → ℝ,
      0 < A 0 0 + A 1 1 ∧
        (∑ k : Fin 2, v k ^ 2) ≤ (A 0 0 + A 1 1) * ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * v a * v b ∧
        0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * v a * v b := by
    intro A hA v
    have hsym : A 1 0 = A 0 1 := by
      have := hA.isHermitian.apply 0 1
      simpa using this
    have hD : 0 < A.det := hA.det_pos
    have hdet : A.det = A 0 0 * A 1 1 - A 0 1 * A 0 1 := by
      rw [Matrix.det_fin_two, hsym]
    have hE : 0 < A 0 0 := hA.diag_pos
    have hG : 0 < A 1 1 := hA.diag_pos
    have hinv : ∀ a b, A⁻¹ a b = A.det⁻¹ * A.adjugate a b := by
      intro a b
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    have i00 : A⁻¹ 0 0 = A.det⁻¹ * A 1 1 := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    have i01 : A⁻¹ 0 1 = A.det⁻¹ * (-A 0 1) := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    have i10 : A⁻¹ 1 0 = A.det⁻¹ * (-A 0 1) := by
      rw [hinv]; simp [Matrix.adjugate_fin_two, hsym]
    have i11 : A⁻¹ 1 1 = A.det⁻¹ * A 0 0 := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    have htr : 0 < A 0 0 + A 1 1 := by linarith
    simp only [Fin.sum_univ_two, i00, i01, i10, i11]
    have ht : A.det⁻¹ * (A 0 0 * A 1 1 - A 0 1 * A 0 1) = 1 := by
      rw [← hdet]; exact inv_mul_cancel₀ hD.ne'
    have key : (A 0 0 + A 1 1) * (A.det⁻¹ * A 1 1 * v 0 * v 0 + A.det⁻¹ * (-A 0 1) * v 0 * v 1 +
        (A.det⁻¹ * (-A 0 1) * v 1 * v 0 + A.det⁻¹ * A 0 0 * v 1 * v 1)) - (v 0 ^ 2 + v 1 ^ 2) =
        A.det⁻¹ * ((A 1 1 * v 0 - A 0 1 * v 1) ^ 2 + (A 0 1 * v 0 - A 0 0 * v 1) ^ 2) := by
      linear_combination (v 0 ^ 2 + v 1 ^ 2) * ht
    have hnn : 0 ≤ A.det⁻¹ * ((A 1 1 * v 0 - A 0 1 * v 1) ^ 2 + (A 0 1 * v 0 - A 0 0 * v 1) ^ 2) :=
      mul_nonneg (inv_nonneg.2 hD.le) (add_nonneg (sq_nonneg _) (sq_nonneg _))
    have hle : v 0 ^ 2 + v 1 ^ 2 ≤ (A 0 0 + A 1 1) * (A.det⁻¹ * A 1 1 * v 0 * v 0 +
        A.det⁻¹ * (-A 0 1) * v 0 * v 1 +
        (A.det⁻¹ * (-A 0 1) * v 1 * v 0 + A.det⁻¹ * A 0 0 * v 1 * v 1)) := by linarith
    refine ⟨htr, hle, ?_⟩
    by_contra hneg
    push_neg at hneg
    have := mul_neg_of_pos_of_neg htr hneg
    nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
  
  have hc : ∀ a b : Fin 2, ContinuousOn (fun x => h x a b) W := fun a b => (hh a b).continuousOn
  have hdetc : ContinuousOn (fun x => (h x).det) W := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    rw [e]
    exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
  have hσc : ContinuousOn (fun x => Real.sqrt (h x).det) W := hdetc.sqrt
  have hσpos : ∀ x ∈ W, 0 < Real.sqrt (h x).det :=
    fun x hx => Real.sqrt_pos.2 (hpos x hx).det_pos
  have hdetinv : ContinuousOn (fun x => ((h x).det)⁻¹) W :=
    hdetc.inv₀ (fun x hx => (hpos x hx).det_pos.ne')
  have hadjc : ∀ a b : Fin 2, ContinuousOn (fun x => (h x).adjugate a b) W := by
    intro a b
    fin_cases a <;> fin_cases b <;> simp [Matrix.adjugate_fin_two] <;>
      first
        | exact hc _ _
        | exact (hc _ _).neg
        | fun_prop
  have hinvc : ∀ a b : Fin 2, ContinuousOn (fun x => (h x)⁻¹ a b) W := by
    intro a b
    have e : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b := by
      funext x
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [e]
    exact hdetinv.mul (hadjc a b)
  
  have hpdc : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ k : Fin 2,
      ContinuousOn (fun x => pd2 k f x) W := by
    intro f hf k
    unfold pd2
    exact (hf.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
  
  have P1 : ∀ f g : E2 → ℝ, ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W →
      ContinuousOn (fun x => ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b g x) W := by
    intro f g hf hg
    exact continuousOn_finset_sum _ (fun a _ => continuousOn_finset_sum _
      (fun b _ => ((hinvc a b).mul (hpdc f hf a)).mul (hpdc g hg b)))
  
  have P2 : ∀ f : E2 → ℝ, ∀ x ∈ W,
      0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x := by
    intro f x hx
    exact (alg (h x) (hpos x hx) (fun k => pd2 k f x)).2.2
  
  have hlin : ∀ f g : E2 → ℝ, ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W → ∀ x ∈ W, ∀ t : ℝ,
      ∀ a : Fin 2, pd2 a (fun y => f y - t * g y) x = pd2 a f x - t * pd2 a g x := by
    intro f g hf hg x hx t a
    have hWx : W ∈ 𝓝 x := hW.mem_nhds hx
    have hdf : DifferentiableAt ℝ f x := (hf.contDiffAt hWx).differentiableAt (by simp)
    have hdg : DifferentiableAt ℝ g x := (hg.contDiffAt hWx).differentiableAt (by simp)
    have hd : HasFDerivAt (fun y => f y - t * g y) (fderiv ℝ f x - t • fderiv ℝ g x) x :=
      hdf.hasFDerivAt.sub (hdg.hasFDerivAt.const_mul t)
    unfold pd2
    rw [hd.fderiv]
    simp
  
  have P3 : ∀ f g : E2 → ℝ, ContDiffOn ℝ ∞ f W → ContDiffOn ℝ ∞ g W → ∀ x ∈ W, ∀ t : ℝ,
      ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a (fun y => f y - t * g y) x *
          pd2 b (fun y => f y - t * g y) x =
        ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x
        - 2 * t * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a g x * pd2 b f x
        + t ^ 2 * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a g x * pd2 b g x := by
    intro f g hf hg x hx t
    have hB := hinvsym (h x) (hpos x hx)
    simp only [hlin f g hf hg x hx t, Fin.sum_univ_two, hB]
    ring
  
  have P4 : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, 0 ≤ C ∧ ∀ f : E2 → ℝ,
      ContDiffOn ℝ ∞ f W →
      ∫ x in L, ∑ k : Fin 2, (pd2 k f x) ^ 2 ≤
        C * ∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) *
          Real.sqrt (h x).det := by
    intro L hL hLW
    have htc : ContinuousOn (fun x => h x 0 0 + h x 1 1) W :=
      (hh 0 0).continuousOn.add (hh 1 1).continuousOn
    have hspos : ∀ x ∈ L, 0 < Real.sqrt (h x).det := fun x hx => hσpos x (hLW hx)
    obtain ⟨m, hm0, hm⟩ := hL.exists_forall_le' (hσc.mono hLW) hspos
    obtain ⟨B, hB⟩ := hL.exists_bound_of_continuousOn (htc.mono hLW)
    set T : ℝ := max B 0 with hTdef
    have hT0 : 0 ≤ T := le_max_right _ _
    have hTb : ∀ x ∈ L, h x 0 0 + h x 1 1 ≤ T := by
      intro x hx
      have h1 := hB x hx
      rw [Real.norm_eq_abs] at h1
      exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
    refine ⟨T / m, div_nonneg hT0 hm0.le, ?_⟩
    intro f hf
    have hpt : ∀ x ∈ L, (∑ k : Fin 2, (pd2 k f x) ^ 2) ≤
        T / m * ((∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) *
          Real.sqrt (h x).det) := by
      intro x hx
      obtain ⟨hτ, hPQ, hQ0⟩ := alg (h x) (hpos x (hLW hx)) (fun k => pd2 k f x)
      have hPQ' : (∑ k : Fin 2, (pd2 k f x) ^ 2) ≤ (h x 0 0 + h x 1 1) *
          ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x := hPQ
      have hQ0' : 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x := hQ0
      set P := ∑ k : Fin 2, (pd2 k f x) ^ 2 with hPdef
      set Q := ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x with hQdef
      set σ := Real.sqrt (h x).det with hσdef
      set τ := h x 0 0 + h x 1 1 with hτdef
      have hτT : τ ≤ T := hTb x hx
      have hPT : P ≤ T * Q := hPQ'.trans (mul_le_mul_of_nonneg_right hτT hQ0')
      have hmσ : m ≤ σ := hm x hx
      have hY : 0 ≤ T * Q * (σ - m) :=
        mul_nonneg (mul_nonneg hT0 hQ0') (sub_nonneg.2 hmσ)
      have hZ : P * m ≤ T * Q * m := mul_le_mul_of_nonneg_right hPT hm0.le
      rw [div_mul_eq_mul_div, le_div_iff₀ hm0]
      nlinarith [hY, hZ]
    have hfc : ContinuousOn (fun x => ∑ k : Fin 2, (pd2 k f x) ^ 2) W :=
      continuousOn_finset_sum _ (fun k _ => (hpdc f hf k).pow 2)
    have hgc : ContinuousOn (fun x => (∑ a : Fin 2, ∑ b : Fin 2,
        (h x)⁻¹ a b * pd2 a f x * pd2 b f x) * Real.sqrt (h x).det) W :=
      (P1 f f hf hf).mul hσc
    have hf_int := (hfc.mono hLW).integrableOn_compact (μ := MeasureTheory.volume) hL
    have hg_int := (hgc.mono hLW).integrableOn_compact (μ := MeasureTheory.volume) hL
    calc ∫ x in L, ∑ k : Fin 2, (pd2 k f x) ^ 2
        ≤ ∫ x in L, T / m * ((∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) *
          Real.sqrt (h x).det) :=
          MeasureTheory.setIntegral_mono_on hf_int (hg_int.const_mul _) hL.measurableSet hpt
      _ = T / m * ∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a f x * pd2 b f x) *
          Real.sqrt (h x).det := by
          rw [MeasureTheory.integral_const_mul]
  exact ⟨P1, P2, P3, P4⟩

theorem dirichlet_variational_sequence {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (hS : IsCompact S) (P : EigPatchedSurface X S)
    (θ : Fin P.n → E2 → ℝ) (hθ : ∀ j, ContDiffOn ℝ ∞ (θ j) (P.W j))
    (hcomp : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (θ j) x = fderiv ℝ (fun x' => θ k (P.proj k (P.param j x'))) x) :
    ∃ (u : ℕ → X → ℝ) (δ : ℕ → ℝ),
      (∀ n j, ContDiffOn ℝ ∞ (fun x => u n (P.param j x)) (P.W j)) ∧
      Tendsto δ atTop (𝓝 0) ∧
      (∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∃ C : ℝ, ∀ n,
        ∫ x in L, ∑ k : Fin 2, (pd2 k (fun x' => θ j x' - u n (P.param j x')) x) ^ 2 ≤ C) ∧
      ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j →
        ∃ M : ℝ, ∀ n (t : ℝ), 0 ≤ δ n + 2 * t * (∫ x, ∑ a : Fin 2, ∑ b : Fin 2,
          Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a b *
            pd2 b (fun x' => θ j x' - u n (P.param j x')) x * pd2 a ζ x) + t ^ 2 * M :=
by
  classical
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  have hP3 : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j k x hx
    have hq : P.param j x ∈ P.O k ∩ S := ⟨hx.2, (hP1 j x hx.1).2⟩
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, hyx⟩ := hq
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hOv : ∀ j k, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j k =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hτ : ∀ j k, Set.MapsTo (fun x => P.proj k (P.param j x))
      (P.W j ∩ P.param j ⁻¹' P.O k) (P.W k) := fun j k x hx => (hP3 j k x hx).1
  
  obtain ⟨ρ, K, hρnn, hρs, hρ1, hK, hρK, hρO⟩ :=
    eig_partition_unity S hS P (fun k ζ h1 h2 h3 => eig_lift_smooth S P k ζ h1 h2 h3)
  have hρc : ∀ j k, ContinuousOn (fun x => ρ j (P.param k x)) (P.W k) :=
    fun j k => (hρs j k).continuousOn
  obtain ⟨hlin, -, hcongr, -, hnn, -, -⟩ :=
    eig_wint_facts S P ρ K hρnn (fun j => hρc j j) hK hρK
  have hF := fun j =>
    chart_dirichlet_form_facts (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)
  
  obtain ⟨Cl, hCl⟩ : ∃ Cl : Set (X → ℝ), ∀ w, w ∈ Cl ↔
      ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j) :=
    ⟨{w | ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)}, fun w => Iff.rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : Fin P.n → (E2 → ℝ) → (E2 → ℝ) → E2 → ℝ, ∀ j f g x,
      Q j f g x = ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a f x * pd2 b g x :=
    ⟨fun j f g x => ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a f x * pd2 b g x,
      fun _ _ _ _ => rfl⟩
  obtain ⟨FE, hFE⟩ : ∃ FE : (X → ℝ) → Fin P.n → E2 → ℝ, ∀ w j x,
      FE w j x = Q j (fun x' => θ j x' - w (P.param j x')) (fun x' => θ j x' - w (P.param j x')) x :=
    ⟨fun w j x => Q j (fun x' => θ j x' - w (P.param j x'))
      (fun x' => θ j x' - w (P.param j x')) x, fun _ _ _ => rfl⟩
  obtain ⟨FB, hFB⟩ : ∃ FB : (X → ℝ) → (X → ℝ) → Fin P.n → E2 → ℝ, ∀ w z j x,
      FB w z j x = Q j (fun x' => z (P.param j x')) (fun x' => θ j x' - w (P.param j x')) x :=
    ⟨fun w z j x => Q j (fun x' => z (P.param j x')) (fun x' => θ j x' - w (P.param j x')) x,
      fun _ _ _ _ => rfl⟩
  obtain ⟨FD, hFD⟩ : ∃ FD : (X → ℝ) → Fin P.n → E2 → ℝ, ∀ z j x,
      FD z j x = Q j (fun x' => z (P.param j x')) (fun x' => z (P.param j x')) x :=
    ⟨fun z j x => Q j (fun x' => z (P.param j x')) (fun x' => z (P.param j x')) x,
      fun _ _ _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : (X → ℝ) → ℝ, ∀ w, E w = eigWInt P ρ (FE w) :=
    ⟨fun w => eigWInt P ρ (FE w), fun _ => rfl⟩
  obtain ⟨Bil, hBil⟩ : ∃ Bil : (X → ℝ) → (X → ℝ) → ℝ, ∀ w z, Bil w z = eigWInt P ρ (FB w z) :=
    ⟨fun w z => eigWInt P ρ (FB w z), fun _ _ => rfl⟩
  obtain ⟨D, hD⟩ : ∃ D : (X → ℝ) → ℝ, ∀ z, D z = eigWInt P ρ (FD z) :=
    ⟨fun z => eigWInt P ρ (FD z), fun _ => rfl⟩
  have hV : ∀ w : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      ∀ j, ContDiffOn ℝ ∞ (fun x' => θ j x' - w (P.param j x')) (P.W j) :=
    fun w hw j => (hθ j).sub (hw j)
  have hFEc : ∀ w : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      ∀ j, ContinuousOn (FE w j) (P.W j) := by
    intro w hw j
    exact ((hF j).1 _ _ (hV w hw j) (hV w hw j)).congr (fun x _ => by rw [hFE, hQ])
  have hFBc : ∀ w z : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      (∀ j, ContDiffOn ℝ ∞ (fun x => z (P.param j x)) (P.W j)) →
      ∀ j, ContinuousOn (FB w z j) (P.W j) := by
    intro w z hw hz j
    exact ((hF j).1 _ _ (hz j) (hV w hw j)).congr (fun x _ => by rw [hFB, hQ])
  have hFDc : ∀ z : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => z (P.param j x)) (P.W j)) →
      ∀ j, ContinuousOn (FD z j) (P.W j) := by
    intro z hz j
    exact ((hF j).1 _ _ (hz j) (hz j)).congr (fun x _ => by rw [hFD, hQ])
  have hFEnn : ∀ w : X → ℝ, ∀ j, ∀ x ∈ P.W j, 0 ≤ FE w j x := by
    intro w j x hx
    rw [hFE, hQ]
    exact (hF j).2.1 _ x hx
  have hC0 : (0 : X → ℝ) ∈ Cl := by
    rw [hCl]
    intro j
    simp only [Pi.zero_apply]
    exact contDiffOn_const
  have hC : ∀ w ∈ Cl, ∀ z ∈ Cl, ∀ t : ℝ, w + t • z ∈ Cl := by
    intro w hw z hz t
    rw [hCl] at hw hz ⊢
    intro j
    exact (hw j).add ((hz j).const_smul t)
  
  have hCglob : ∀ (z : X → ℝ) (j k : Fin P.n), ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (fun x' => z (P.param j x')) x =
        fderiv ℝ (fun x' => z (P.param k (P.proj k (P.param j x')))) x := by
    intro z j k x hx
    have hev : (fun x' => z (P.param k (P.proj k (P.param j x')))) =ᶠ[𝓝 x]
        (fun x' => z (P.param j x')) :=
      Filter.eventually_of_mem ((hOv j k).mem_nhds hx)
        (fun y hy => by simp only [(hP3 j k y hy).2])
    rw [hev.fderiv_eq]
  have hCpot : ∀ w : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      ∀ (j k : Fin P.n), ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (fun x' => θ j x' - w (P.param j x')) x =
        fderiv ℝ (fun x' => θ k (P.proj k (P.param j x')) -
          w (P.param k (P.proj k (P.param j x')))) x := by
    intro w hw j k x hx
    have hnx : P.W j ∩ P.param j ⁻¹' P.O k ∈ 𝓝 x := (hOv j k).mem_nhds hx
    have hWx : P.W j ∈ 𝓝 x := (P.W_open j).mem_nhds hx.1
    have hd1 : DifferentiableAt ℝ (θ j) x :=
      ((hθ j).contDiffAt hWx).differentiableAt (by simp)
    have hd2 : DifferentiableAt ℝ (fun x' => w (P.param j x')) x :=
      ((hw j).contDiffAt hWx).differentiableAt (by simp)
    have hd3 : DifferentiableAt ℝ (fun x' => θ k (P.proj k (P.param j x'))) x :=
      (((hθ k).comp (P.trans_smooth j k) (hτ j k)).contDiffAt hnx).differentiableAt (by simp)
    have hev : (fun x' => θ k (P.proj k (P.param j x')) -
        w (P.param k (P.proj k (P.param j x')))) =ᶠ[𝓝 x]
        (fun x' => θ k (P.proj k (P.param j x'))) - (fun x' => w (P.param j x')) := by
      filter_upwards [hnx] with y hy
      simp only [Pi.sub_apply]
      rw [(hP3 j k y hy).2]
    rw [hev.fderiv_eq, fderiv_sub hd3 hd2]
    show fderiv ℝ ((θ j) - (fun x' => w (P.param j x'))) x = _
    rw [fderiv_sub hd1 hd2, hcomp j k x hx]
  have hFEcompat : ∀ w : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      ∀ k j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, FE w j x = FE w k (P.proj k (P.param j x)) := by
    intro w hw k j x hx
    rw [hFE, hFE, hQ, hQ]
    exact eig_form_pair_compat S P (fun j x' => θ j x' - w (P.param j x'))
      (fun j x' => θ j x' - w (P.param j x')) (hV w hw) (hV w hw)
      (fun j k x hx => hCpot w hw j k x hx) (fun j k x hx => hCpot w hw j k x hx) j k x hx
  have hFBcompat : ∀ w z : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      (∀ j, ContDiffOn ℝ ∞ (fun x => z (P.param j x)) (P.W j)) →
      ∀ k j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        FB w z j x = FB w z k (P.proj k (P.param j x)) := by
    intro w z hw hz k j x hx
    rw [hFB, hFB, hQ, hQ]
    exact eig_form_pair_compat S P (fun j x' => z (P.param j x'))
      (fun j x' => θ j x' - w (P.param j x')) hz (hV w hw)
      (fun j k x hx => hCglob z j k x hx) (fun j k x hx => hCpot w hw j k x hx) j k x hx
  
  have hE0 : ∀ w ∈ Cl, 0 ≤ E w := by
    intro w _
    rw [hE]
    exact hnn _ (fun j x hx => hFEnn w j x ((hK j).2 hx))
  have hq : ∀ w ∈ Cl, ∀ z ∈ Cl, ∀ t : ℝ,
      E (w + t • z) = E w - 2 * t * Bil w z + t ^ 2 * D z := by
    intro w hw z hz t
    rw [hCl] at hw hz
    have e := hlin (FE w) (FB w z) (FD z) (hFEc w hw) (hFBc w z hw hz) (hFDc z hz)
      1 (-2 * t) (t ^ 2)
    have hc : eigWInt P ρ (FE (w + t • z)) = eigWInt P ρ
        (fun j x => 1 * FE w j x + (-2 * t) * FB w z j x + t ^ 2 * FD z j x) := by
      apply hcongr
      intro j x hx
      have hfun : (fun x' => θ j x' - (w + t • z) (P.param j x')) =
          fun y => θ j y - w (P.param j y) - t * z (P.param j y) := by
        funext y
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        ring
      have h3 : ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
            pd2 a (fun y => θ j y - w (P.param j y) - t * z (P.param j y)) x *
            pd2 b (fun y => θ j y - w (P.param j y) - t * z (P.param j y)) x =
          ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
              pd2 a (fun x' => θ j x' - w (P.param j x')) x *
              pd2 b (fun x' => θ j x' - w (P.param j x')) x
          - 2 * t * ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
              pd2 a (fun x' => z (P.param j x')) x * pd2 b (fun x' => θ j x' - w (P.param j x')) x
          + t ^ 2 * ∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
              pd2 a (fun x' => z (P.param j x')) x * pd2 b (fun x' => z (P.param j x')) x :=
        (hF j).2.2.1 _ _ (hV w hw j) (hz j) x hx t
      rw [hFE, hFE, hFB, hFD, hQ, hQ, hQ, hQ, hfun, h3]
      ring
    rw [hE, hE, hBil, hD, hc.trans e]
    ring
  
  have hTne : (E '' Cl).Nonempty := ⟨E 0, 0, hC0, rfl⟩
  have hTbdd : BddBelow (E '' Cl) := ⟨0, by rintro _ ⟨w, hw, rfl⟩; exact hE0 w hw⟩
  have hmle : ∀ w ∈ Cl, sInf (E '' Cl) ≤ E w := fun w hw => csInf_le hTbdd ⟨w, hw, rfl⟩
  have hexu : ∀ n : ℕ, ∃ w ∈ Cl, E w < sInf (E '' Cl) + 1 / ((n : ℝ) + 1) := by
    intro n
    have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨a, ⟨w, hw, rfl⟩, ha⟩ := exists_lt_of_csInf_lt hTne
      (by linarith : sInf (E '' Cl) < sInf (E '' Cl) + 1 / ((n : ℝ) + 1))
    exact ⟨w, hw, ha⟩
  choose u huC hult using hexu
  have hu : ∀ n j, ContDiffOn ℝ ∞ (fun x => u n (P.param j x)) (P.W j) :=
    fun n => (hCl _).1 (huC n)
  have hδ : Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hδle : ∀ n : ℕ, 1 / ((n : ℝ) + 1) ≤ 1 := by
    intro n
    rw [div_le_one (by positivity)]
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hEb : ∀ n, E (u n) ≤ E 0 + 1 := by
    intro n
    have h1 := hult n
    have h2 := hmle 0 hC0
    have h3 := hδle n
    linarith
  have hEL0 : ∀ z ∈ Cl, ∀ (n : ℕ) (t : ℝ),
      0 ≤ 1 / ((n : ℝ) + 1) + 2 * t * Bil (u n) z + t ^ 2 * D z := by
    intro z hz n t
    have h1 := hmle _ (hC (u n) (huC n) z hz (-t))
    rw [hq (u n) (huC n) z hz (-t)] at h1
    have h2 := hult n
    nlinarith
  
  have hgrad : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∃ C : ℝ, ∀ n,
      ∫ x in L, ∑ k : Fin 2, (pd2 k (fun x' => θ j x' - u n (P.param j x')) x) ^ 2 ≤ C := by
    intro j L hL hLW
    obtain ⟨CL, hCL0, hCL⟩ := (hF j).2.2.2 L hL hLW
    refine ⟨CL * (E 0 + 1), fun n => ?_⟩
    have hloc := eig_integral_localize S P ρ K hρnn hρc hρ1 hK hρK hρO j
      (fun j' G => eig_chart_cov S P j' j G)
    have h2 := (hloc (FE (u n)) (hFEc (u n) (hu n)) (hFEcompat (u n) (hu n) j)).2
      (fun j' x hx => hFEnn (u n) j' x hx) L hL hLW
    have h3 : ∫ x in L, FE (u n) j x * Real.sqrt (P.h j x).det ≤ E 0 + 1 := by
      rw [← hE] at h2
      exact h2.trans (hEb n)
    have h4 : (∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
        pd2 a (fun x' => θ j x' - u n (P.param j x')) x *
        pd2 b (fun x' => θ j x' - u n (P.param j x')) x) * Real.sqrt (P.h j x).det) =
        ∫ x in L, FE (u n) j x * Real.sqrt (P.h j x).det := by
      simp only [hFE, hQ]
    calc ∫ x in L, ∑ k : Fin 2, (pd2 k (fun x' => θ j x' - u n (P.param j x')) x) ^ 2
        ≤ CL * ∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
            pd2 a (fun x' => θ j x' - u n (P.param j x')) x *
            pd2 b (fun x' => θ j x' - u n (P.param j x')) x) * Real.sqrt (P.h j x).det :=
          hCL _ (hV (u n) (hu n) j)
      _ = CL * ∫ x in L, FE (u n) j x * Real.sqrt (P.h j x).det := by rw [h4]
      _ ≤ CL * (E 0 + 1) := mul_le_mul_of_nonneg_left h3 hCL0
  
  have hEL : ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j →
      ∃ M : ℝ, ∀ (n : ℕ) (t : ℝ), 0 ≤ 1 / ((n : ℝ) + 1) + 2 * t * (∫ x, ∑ a : Fin 2, ∑ b : Fin 2,
        Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a b *
          pd2 b (fun x' => θ j x' - u n (P.param j x')) x * pd2 a ζ x) + t ^ 2 * M := by
    intro k ζ hζ hc hs
    obtain ⟨Z, hZs, -, hZf, hZev⟩ := eig_lift_smooth S P k ζ hζ hc hs
    refine ⟨D Z, fun n t => ?_⟩
    have h0 := hEL0 Z ((hCl Z).2 hZs) n t
    have hun := hu n
    have hloc := eig_integral_localize S P ρ K hρnn hρc hρ1 hK hρK hρO k
      (fun j' G => eig_chart_cov S P j' k G) (FB (u n) Z) (hFBc (u n) Z hun hZs)
      (hFBcompat (u n) Z hun hZs k)
    have hB1 := hloc.1 (tsupport ζ) hc.isCompact hs (by
      intro j x hx hnot
      have hev : (fun x' => Z (P.param j x')) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := hZev j x hx hnot
      have hpd : ∀ a, pd2 a (fun x' => Z (P.param j x')) x = 0 := by
        intro a
        unfold pd2
        rw [hev.fderiv_eq]
        simp
      rw [hFB, hQ]
      simp [hpd])
    have hZk : ∀ x ∈ P.W k, Z (P.param k x) = ζ x := fun x hx => by
      rw [hZf _ (hP1 k x hx).1, P.proj_param k x hx]
    have hZkd : ∀ x ∈ P.W k, ∀ a, pd2 a (fun x' => Z (P.param k x')) x = pd2 a ζ x := by
      intro x hx a
      have hev : (fun x' => Z (P.param k x')) =ᶠ[𝓝 x] ζ :=
        Filter.eventually_of_mem ((P.W_open k).mem_nhds hx) hZk
      unfold pd2
      rw [hev.fderiv_eq]
    have hBeq : (∫ x, ∑ a : Fin 2, ∑ b : Fin 2,
        Real.sqrt (P.h k x).det * (P.h k x)⁻¹ a b *
          pd2 b (fun x' => θ k x' - u n (P.param k x')) x * pd2 a ζ x) = Bil (u n) Z := by
      rw [hBil, hB1]
      refine (setIntegral_eq_integral_of_forall_compl_eq_zero (s := P.W k) ?_).symm.trans ?_
      · intro x hx
        have hxs : x ∉ tsupport ζ := fun h => hx (hs h)
        have hev : ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := notMem_tsupport_iff_eventuallyEq.1 hxs
        have hpd : ∀ a, pd2 a ζ x = 0 := by
          intro a
          unfold pd2
          rw [hev.fderiv_eq]
          simp
        simp [hpd]
      · refine setIntegral_congr_fun (P.W_open k).measurableSet (fun x hx => ?_)
        simp only [hFB, hQ, hZkd x hx, Fin.sum_univ_two]
        ring
    rw [hBeq]
    exact h0
  exact ⟨u, fun n => 1 / ((n : ℝ) + 1), hu, hδ, hgrad, hEL⟩

theorem square_poincare_normalize (a b s : ℝ) (hs : 0 < s) (v : ℕ → E2 → ℝ)
    (hv : ∀ n, ContDiffOn ℝ ∞ (v n) {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s})
    (hgrad : ∀ L : Set E2, IsCompact L →
      L ⊆ {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} →
      ∃ C : ℝ, ∀ n, ∫ x in L, ∑ k : Fin 2, (pd2 k (v n) x) ^ 2 ≤ C) :
    ∃ c : ℕ → ℝ, ∀ L : Set E2, IsCompact L →
      L ⊆ {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} →
      ∃ C : ℝ, ∀ n, ∫ x in L, ((v n x - c n) ^ 2 +
        ∑ k : Fin 2, (pd2 k (fun x' => v n x' - c n) x) ^ 2) ≤ C :=
by
  have hc0 : Continuous (fun x : E2 => x 0) := by fun_prop
  have hc1 : Continuous (fun x : E2 => x 1) := by fun_prop
  set S : Set E2 := {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s} with hSdef
  have hSo : IsOpen S :=
    (isOpen_lt continuous_const hc0).inter ((isOpen_lt hc0 continuous_const).inter
      ((isOpen_lt continuous_const hc1).inter (isOpen_lt hc1 continuous_const)))
  
  have hcpt : ∀ α β σ : ℝ,
      IsCompact {x : E2 | α ≤ x 0 ∧ x 0 ≤ α + σ ∧ β ≤ x 1 ∧ x 1 ≤ β + σ} := by
    intro α β σ
    apply Metric.isCompact_of_isClosed_isBounded
    · exact (isClosed_le continuous_const hc0).inter ((isClosed_le hc0 continuous_const).inter
        ((isClosed_le continuous_const hc1).inter (isClosed_le hc1 continuous_const)))
    · rw [Metric.isBounded_iff_subset_closedBall 0]
      refine ⟨|α| + |β| + 2 * |σ|, fun x hx => ?_⟩
      obtain ⟨h1, h2, h3, h4⟩ := hx
      rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq, Fin.sum_univ_two]
      have e0 : |x 0| ≤ |α| + |σ| := by
        rw [abs_le]; constructor <;> cases abs_cases α <;> cases abs_cases σ <;> linarith
      have e1 : |x 1| ≤ |β| + |σ| := by
        rw [abs_le]; constructor <;> cases abs_cases β <;> cases abs_cases σ <;> linarith
      rw [Real.sqrt_le_left]
      · simp only [Real.norm_eq_abs, sq_abs]
        nlinarith [abs_nonneg (x 0), abs_nonneg (x 1), abs_nonneg α, abs_nonneg β, abs_nonneg σ,
          sq_abs (x 0), sq_abs (x 1)]
      · positivity
  
  have hpos : ∀ α β σ : ℝ, 0 < σ →
      0 < volume.real {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} := by
    intro α β σ hσ
    have hU : IsOpen {x : E2 | α < x 0 ∧ x 0 < α + σ ∧ β < x 1 ∧ x 1 < β + σ} :=
      (isOpen_lt continuous_const hc0).inter ((isOpen_lt hc0 continuous_const).inter
        ((isOpen_lt continuous_const hc1).inter (isOpen_lt hc1 continuous_const)))
    have hne : ({x : E2 | α < x 0 ∧ x 0 < α + σ ∧ β < x 1 ∧ x 1 < β + σ}).Nonempty := by
      refine ⟨EuclideanSpace.single 0 (α + σ / 2) + EuclideanSpace.single 1 (β + σ / 2), ?_⟩
      have e0 : (EuclideanSpace.single 0 (α + σ / 2) + EuclideanSpace.single 1 (β + σ / 2) : E2) 0
          = α + σ / 2 := by simp
      have e1 : (EuclideanSpace.single 0 (α + σ / 2) + EuclideanSpace.single 1 (β + σ / 2) : E2) 1
          = β + σ / 2 := by simp
      simp only [Set.mem_setOf_eq]
      rw [e0, e1]
      exact ⟨by linarith, by linarith, by linarith, by linarith⟩
    have h1 := hU.measure_pos volume hne
    have hsub1 : {x : E2 | α < x 0 ∧ x 0 < α + σ ∧ β < x 1 ∧ x 1 < β + σ} ⊆
        {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} :=
      fun x hx => ⟨hx.1.le, hx.2.1, hx.2.2.1.le, hx.2.2.2⟩
    have hsub2 : {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} ⊆
        {x : E2 | α ≤ x 0 ∧ x 0 ≤ α + σ ∧ β ≤ x 1 ∧ x 1 ≤ β + σ} :=
      fun x hx => ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
    have hfin := lt_of_le_of_lt (measure_mono (μ := volume) hsub2)
      ((hcpt α β σ).measure_lt_top (μ := volume))
    rw [measureReal_def]
    exact ENNReal.toReal_pos (ne_of_gt (lt_of_lt_of_le h1 (measure_mono hsub1))) hfin.ne
  
  have hnest : ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w S → ∀ α β σ : ℝ, 0 < σ →
      {x : E2 | α ≤ x 0 ∧ x 0 ≤ α + σ ∧ β ≤ x 1 ∧ x 1 ≤ β + σ} ⊆ S →
      ∀ Q₀ : Set E2, Q₀ ⊆ {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} →
      0 < volume.real Q₀ →
      ∫ x in {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ},
          (w x - (∫ y in Q₀, w y) / volume.real Q₀) ^ 2 ≤
        2 * σ ^ 2 * (1 + volume.real {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} /
          volume.real Q₀) *
        ∫ x in {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ},
          ∑ k : Fin 2, (pd2 k w x) ^ 2 := by
    intro w hw α β σ hσ hKS Q₀ hQ₀ hV₀
    set Q : Set E2 := {x : E2 | α ≤ x 0 ∧ x 0 < α + σ ∧ β ≤ x 1 ∧ x 1 < β + σ} with hQdef
    set K : Set E2 := {x : E2 | α ≤ x 0 ∧ x 0 ≤ α + σ ∧ β ≤ x 1 ∧ x 1 ≤ β + σ} with hKdef
    have hQK : Q ⊆ K := fun x hx => ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
    have hKc : IsCompact K := hcpt α β σ
    have hwK : ContinuousOn w K := hw.continuousOn.mono hKS
    have hQfin : volume Q ≠ ⊤ := (lt_of_le_of_lt (measure_mono hQK) hKc.measure_lt_top).ne
    have hV₀V : volume.real Q₀ ≤ volume.real Q := measureReal_mono hQ₀ hQfin
    have hVpos : 0 < volume.real Q := lt_of_lt_of_le hV₀ hV₀V
    have hint : ∀ f : E2 → ℝ, ContinuousOn f K → IntegrableOn f Q := fun f hf =>
      (hf.integrableOn_compact hKc).mono_set hQK
    have hint0 : ∀ f : E2 → ℝ, ContinuousOn f K → IntegrableOn f Q₀ := fun f hf =>
      (hint f hf).mono_set hQ₀
    set V := volume.real Q with hVdef
    set V₀ := volume.real Q₀ with hV₀def
    set G := ∫ x in Q, ∑ k : Fin 2, (pd2 k w x) ^ 2 with hGdef
    set m := (∫ x in Q, w x) / V with hm
    set c := (∫ y in Q₀, w y) / V₀ with hc
    
    have hmean : ∫ x in Q, (w x - m) = 0 := by
      rw [integral_sub (hint w hwK) (hint (fun _ => m) continuousOn_const), setIntegral_const,
        smul_eq_mul]
      have : V * m = ∫ x in Q, w x := by rw [hm]; field_simp
      linarith
    have hP : ∫ x in Q, (w x - m) ^ 2 ≤ (∫ x in Q, (w x - m)) ^ 2 / σ ^ 2 +
        σ ^ 2 * ∫ x in Q, ∑ k : Fin 2, (pd2 k (fun x => w x - m) x) ^ 2 :=
      poincare_halfopen_square S hSo (fun x => w x - m) (hw.sub contDiffOn_const) α β σ hσ hKS
    have hpd : ∀ (k : Fin 2) (x : E2), pd2 k (fun x => w x - m) x = pd2 k w x := by
      intro k x; simp only [pd2, fderiv_sub_const]
    have hG' : ∫ x in Q, ∑ k : Fin 2, (pd2 k (fun x => w x - m) x) ^ 2 = G := by
      simp only [hpd, hGdef]
    rw [hmean, hG'] at hP
    have hI1 : ∫ x in Q, (w x - m) ^ 2 ≤ σ ^ 2 * G := by
      have h0 : (0 : ℝ) ^ 2 / σ ^ 2 = 0 := by simp
      linarith
    
    have hmean0 : ∫ x in Q₀, (w x - c) = 0 := by
      rw [integral_sub (hint0 w hwK) (hint0 (fun _ => c) continuousOn_const), setIntegral_const,
        smul_eq_mul]
      have : V₀ * c = ∫ y in Q₀, w y := by rw [hc]; field_simp
      linarith
    have hb1 : ∫ x in Q₀, (2 * (c - m) * (w x - c) + (c - m) ^ 2) ≤
        ∫ x in Q₀, (w x - m) ^ 2 := by
      refine setIntegral_mono (hint0 _ ((continuousOn_const.mul
        (hwK.sub continuousOn_const)).add continuousOn_const))
        (hint0 _ ((hwK.sub continuousOn_const).pow 2)) (fun x => ?_)
      dsimp only
      nlinarith [sq_nonneg (w x - c)]
    have hb2 : ∫ x in Q₀, (2 * (c - m) * (w x - c) + (c - m) ^ 2) = V₀ * (c - m) ^ 2 := by
      rw [integral_add (hint0 _ (continuousOn_const.mul (hwK.sub continuousOn_const)))
        (hint0 (fun _ => (c - m) ^ 2) continuousOn_const), integral_const_mul, hmean0,
        setIntegral_const, smul_eq_mul]
      ring
    have hb3 : ∫ x in Q₀, (w x - m) ^ 2 ≤ ∫ x in Q, (w x - m) ^ 2 :=
      setIntegral_mono_set (hint _ ((hwK.sub continuousOn_const).pow 2))
        (Filter.Eventually.of_forall (fun x => show (0 : ℝ) ≤ (w x - m) ^ 2 from sq_nonneg _))
        hQ₀.eventuallyLE
    have hb : V₀ * (c - m) ^ 2 ≤ ∫ x in Q, (w x - m) ^ 2 := by
      rw [← hb2]; exact hb1.trans hb3
    
    have hc1 : ∫ x in Q, (w x - c) ^ 2 ≤ ∫ x in Q, (2 * (w x - m) ^ 2 + 2 * (m - c) ^ 2) := by
      refine setIntegral_mono (hint _ ((hwK.sub continuousOn_const).pow 2))
        (hint _ ((continuousOn_const.mul ((hwK.sub continuousOn_const).pow 2)).add
          continuousOn_const)) (fun x => ?_)
      dsimp only
      nlinarith [sq_nonneg (w x - m - (m - c))]
    have hc2 : ∫ x in Q, (2 * (w x - m) ^ 2 + 2 * (m - c) ^ 2) =
        2 * (∫ x in Q, (w x - m) ^ 2) + V * (2 * (m - c) ^ 2) := by
      rw [integral_add (hint _ (continuousOn_const.mul ((hwK.sub continuousOn_const).pow 2)))
        (hint (fun _ => 2 * (m - c) ^ 2) continuousOn_const), integral_const_mul,
        setIntegral_const, smul_eq_mul]
    have hr : 0 ≤ V / V₀ := div_nonneg hVpos.le hV₀.le
    have h1 : V * (2 * (m - c) ^ 2) ≤ 2 * (V / V₀ * (∫ x in Q, (w x - m) ^ 2)) := by
      have e : V * (2 * (m - c) ^ 2) = 2 * (V / V₀ * (V₀ * (c - m) ^ 2)) := by
        field_simp
        ring
      rw [e]
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hb hr) (by norm_num)
    have h2 : (1 + V / V₀) * (∫ x in Q, (w x - m) ^ 2) ≤ (1 + V / V₀) * (σ ^ 2 * G) :=
      mul_le_mul_of_nonneg_left hI1 (by linarith)
    rw [hc2] at hc1
    calc ∫ x in Q, (w x - c) ^ 2
        ≤ 2 * (∫ x in Q, (w x - m) ^ 2) + V * (2 * (m - c) ^ 2) := hc1
      _ ≤ 2 * (∫ x in Q, (w x - m) ^ 2) + 2 * (V / V₀ * (∫ x in Q, (w x - m) ^ 2)) := by
          linarith
      _ = 2 * ((1 + V / V₀) * (∫ x in Q, (w x - m) ^ 2)) := by ring
      _ ≤ 2 * ((1 + V / V₀) * (σ ^ 2 * G)) := by linarith
      _ = 2 * σ ^ 2 * (1 + V / V₀) * G := by ring
  
  set Q₀ : Set E2 := {x : E2 | a + s / 4 ≤ x 0 ∧ x 0 < a + s / 4 + s / 2 ∧
    b + s / 4 ≤ x 1 ∧ x 1 < b + s / 4 + s / 2} with hQ₀def
  have hV₀ : 0 < volume.real Q₀ := hpos (a + s / 4) (b + s / 4) (s / 2) (by linarith)
  refine ⟨fun n => (∫ y in Q₀, v n y) / volume.real Q₀, ?_⟩
  intro L hL hLS
  
  obtain ⟨ε, hε0, hεs, hεL⟩ : ∃ ε : ℝ, 0 < ε ∧ ε < s / 4 ∧
      ∀ x ∈ L, a + ε < x 0 ∧ x 0 < a + s - ε ∧ b + ε < x 1 ∧ x 1 < b + s - ε := by
    rcases L.eq_empty_or_nonempty with hLe | hLne
    · exact ⟨s / 8, by linarith, by linarith, fun x hx => by simp [hLe] at hx⟩
    · have hφc : Continuous (fun x : E2 =>
          min (min (x 0 - a) (a + s - x 0)) (min (x 1 - b) (b + s - x 1))) :=
        ((hc0.sub continuous_const).min (continuous_const.sub hc0)).min
          ((hc1.sub continuous_const).min (continuous_const.sub hc1))
      obtain ⟨x₀, hx₀L, hmin⟩ := hL.exists_isMinOn hLne hφc.continuousOn
      set μ := min (min (x₀ 0 - a) (a + s - x₀ 0)) (min (x₀ 1 - b) (b + s - x₀ 1)) with hμdef
      have hμ : 0 < μ := by
        obtain ⟨h1, h2, h3, h4⟩ := hLS hx₀L
        simp only [hμdef, lt_min_iff]
        exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
      refine ⟨min (μ / 2) (s / 8), lt_min (by linarith) (by linarith),
        lt_of_le_of_lt (min_le_right _ _) (by linarith), fun x hx => ?_⟩
      have hx' := isMinOn_iff.mp hmin x hx
      simp only [le_min_iff] at hx'
      have hε1 : min (μ / 2) (s / 8) ≤ μ / 2 := min_le_left _ _
      obtain ⟨⟨k1, k2⟩, k3, k4⟩ := hx'
      exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  have hσ : 0 < s - 2 * ε := by linarith
  set Q : Set E2 := {x : E2 | a + ε ≤ x 0 ∧ x 0 < a + ε + (s - 2 * ε) ∧
    b + ε ≤ x 1 ∧ x 1 < b + ε + (s - 2 * ε)} with hQdef
  set K : Set E2 := {x : E2 | a + ε ≤ x 0 ∧ x 0 ≤ a + ε + (s - 2 * ε) ∧
    b + ε ≤ x 1 ∧ x 1 ≤ b + ε + (s - 2 * ε)} with hKdef
  have hKS : K ⊆ S := by
    rintro x ⟨h1, h2, h3, h4⟩
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  have hLQ : L ⊆ Q := by
    intro x hx
    obtain ⟨h1, h2, h3, h4⟩ := hεL x hx
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  have hQ₀Q : Q₀ ⊆ Q := by
    rintro x ⟨h1, h2, h3, h4⟩
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  have hQK : Q ⊆ K := fun x hx => ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
  have hKc : IsCompact K := hcpt (a + ε) (b + ε) (s - 2 * ε)
  obtain ⟨CK, hCK⟩ := hgrad K hKc hKS
  obtain ⟨CL, hCL⟩ := hgrad L hL hLS
  refine ⟨2 * (s - 2 * ε) ^ 2 * (1 + volume.real Q / volume.real Q₀) * CK + CL, fun n => ?_⟩
  set cn := (∫ y in Q₀, v n y) / volume.real Q₀ with hcn
  show ∫ x in L, ((v n x - cn) ^ 2 + ∑ k : Fin 2, (pd2 k (fun x' => v n x' - cn) x) ^ 2) ≤ _
  have hvn := hv n
  have hpdc : ∀ k : Fin 2, ContinuousOn (fun x => pd2 k (v n) x) S := by
    intro k
    show ContinuousOn (fun x => fderiv ℝ (v n) x (e2 k)) S
    exact (hvn.continuousOn_fderiv_of_isOpen hSo (by simp)).clm_apply continuousOn_const
  have hsumc : ContinuousOn (fun x => ∑ k : Fin 2, (pd2 k (v n) x) ^ 2) S :=
    continuousOn_finset_sum _ (fun k _ => (hpdc k).pow 2)
  have hsqc : ContinuousOn (fun x => (v n x - cn) ^ 2) S :=
    (hvn.continuousOn.sub continuousOn_const).pow 2
  have hpdsub : ∀ (k : Fin 2) (x : E2), pd2 k (fun x' => v n x' - cn) x = pd2 k (v n) x := by
    intro k x; simp only [pd2, fderiv_sub_const]
  have hrw : ∫ x in L, ((v n x - cn) ^ 2 + ∑ k : Fin 2, (pd2 k (fun x' => v n x' - cn) x) ^ 2) =
      ∫ x in L, ((v n x - cn) ^ 2 + ∑ k : Fin 2, (pd2 k (v n) x) ^ 2) := by
    simp only [hpdsub]
  rw [hrw, integral_add ((hsqc.mono hLS).integrableOn_compact hL)
    ((hsumc.mono hLS).integrableOn_compact hL)]
  have e1 : ∫ x in L, (v n x - cn) ^ 2 ≤ ∫ x in Q, (v n x - cn) ^ 2 :=
    setIntegral_mono_set (((hsqc.mono hKS).integrableOn_compact hKc).mono_set hQK)
      (Filter.Eventually.of_forall (fun x => show (0 : ℝ) ≤ (v n x - cn) ^ 2 from sq_nonneg _))
      hLQ.eventuallyLE
  have e2 : ∫ x in Q, (v n x - cn) ^ 2 ≤
      2 * (s - 2 * ε) ^ 2 * (1 + volume.real Q / volume.real Q₀) *
        ∫ x in Q, ∑ k : Fin 2, (pd2 k (v n) x) ^ 2 :=
    hnest (v n) hvn (a + ε) (b + ε) (s - 2 * ε) hσ hKS Q₀ hQ₀Q hV₀
  have e3 : ∫ x in Q, ∑ k : Fin 2, (pd2 k (v n) x) ^ 2 ≤
      ∫ x in K, ∑ k : Fin 2, (pd2 k (v n) x) ^ 2 :=
    setIntegral_mono_set ((hsumc.mono hKS).integrableOn_compact hKc)
      (Filter.Eventually.of_forall (fun x => show (0 : ℝ) ≤ ∑ k : Fin 2, (pd2 k (v n) x) ^ 2 from
        Finset.sum_nonneg (fun k _ => sq_nonneg _)))
      hQK.eventuallyLE
  have e4 := hCK n
  have e5 := hCL n
  have hB : 0 ≤ 2 * (s - 2 * ε) ^ 2 * (1 + volume.real Q / volume.real Q₀) := by
    have : 0 ≤ volume.real Q / volume.real Q₀ := div_nonneg measureReal_nonneg hV₀.le
    exact mul_nonneg (by positivity) (by linarith)
  have e6 := mul_le_mul_of_nonneg_left (e3.trans e4) hB
  linarith

theorem overlap_diff_l2_conv {X : Type*} [TopologicalSpace X] (S : Set X)
    (P : EigPatchedSurface X S) (j k : Fin P.n) (f g : ℕ → E2 → ℝ) (wj wk : E2 → ℝ)
    (hf : ∀ m, ContinuousOn (f m) (P.W j)) (hg : ∀ m, ContinuousOn (g m) (P.W k))
    (hwj : ContinuousOn wj (P.W j)) (hwk : ContinuousOn wk (P.W k))
    (hfc : ∀ L : Set E2, IsCompact L → L ⊆ P.W j →
      Tendsto (fun m => ∫ x in L, (f m x - wj x) ^ 2) atTop (𝓝 0))
    (hgc : ∀ L : Set E2, IsCompact L → L ⊆ P.W k →
      Tendsto (fun m => ∫ x in L, (g m x - wk x) ^ 2) atTop (𝓝 0)) :
    ∀ L : Set E2, IsCompact L → L ⊆ P.W j ∩ P.param j ⁻¹' P.O k →
      Tendsto (fun m => ∫ x in L, ((f m x - g m (P.proj k (P.param j x))) -
        (wj x - wk (P.proj k (P.param j x)))) ^ 2) atTop (𝓝 0) :=
by
  intro L hL hLU
  let τ : E2 → E2 := fun x => P.proj k (P.param j x)
  let σ : E2 → E2 := fun y => P.proj j (P.param k y)
  
  have hOj : ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro x hx
    rw [← P.image_eq j]
    exact ⟨x, hx, rfl⟩
  have F1 : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      τ x ∈ P.W k ∧ P.param k (τ x) = P.param j x := by
    intro x hx
    have hk : P.param j x ∈ P.param k '' P.W k := by
      rw [P.image_eq k]
      exact ⟨hx.2, (hOj x hx.1).2⟩
    obtain ⟨y, hy, hyx⟩ := hk
    show P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hτV : Set.MapsTo τ (P.W j ∩ P.param j ⁻¹' P.O k) (P.W k ∩ P.param k ⁻¹' P.O j) := by
    intro x hx
    refine ⟨(F1 x hx).1, ?_⟩
    show P.param k (τ x) ∈ P.O j
    rw [(F1 x hx).2]
    exact (hOj x hx.1).1
  have hστ : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, σ (τ x) = x := by
    intro x hx
    show P.proj j (P.param k (τ x)) = x
    rw [(F1 x hx).2, P.proj_param j x hx.1]
  have hVo : IsOpen (P.W k ∩ P.param k ⁻¹' P.O j) :=
    (P.param_cont k).isOpen_inter_preimage (P.W_open k) (P.O_open j)
  have hσ : ContDiffOn ℝ ∞ σ (P.W k ∩ P.param k ⁻¹' P.O j) := P.trans_smooth k j
  have hτc : ContinuousOn τ (P.W j ∩ P.param j ⁻¹' P.O k) := (P.trans_smooth j k).continuousOn
  
  have hL'c : IsCompact (τ '' L) := hL.image_of_continuousOn (hτc.mono hLU)
  have hL'V : τ '' L ⊆ P.W k ∩ P.param k ⁻¹' P.O j := by
    rintro _ ⟨x, hx, rfl⟩
    exact hτV (hLU hx)
  have hL'W : τ '' L ⊆ P.W k := fun y hy => (hL'V hy).1
  have hLW : L ⊆ P.W j := fun x hx => (hLU hx).1
  have hL'm : MeasurableSet (τ '' L) := hL'c.measurableSet
  have hLm : MeasurableSet L := hL.measurableSet
  
  have hDc : ContinuousOn (fun y => |(fderiv ℝ σ y).det|) (P.W k ∩ P.param k ⁻¹' P.O j) := by
    have h1 : ContinuousOn (fderiv ℝ σ) (P.W k ∩ P.param k ⁻¹' P.O j) :=
      hσ.continuousOn_fderiv_of_isOpen hVo (by simp)
    exact (ContinuousLinearMap.continuous_det.comp_continuousOn h1).abs
  obtain ⟨C₀, hC₀⟩ := hL'c.exists_bound_of_continuousOn (hDc.mono hL'V)
  have hC0 : 0 ≤ max C₀ 0 := le_max_right _ _
  have hDC : ∀ y ∈ τ '' L, |(fderiv ℝ σ y).det| ≤ max C₀ 0 := by
    intro y hy
    have h := hC₀ y hy
    rw [Real.norm_eq_abs, abs_abs] at h
    exact h.trans (le_max_left _ _)
  have hderiv : ∀ y ∈ τ '' L, HasFDerivWithinAt σ (fderiv ℝ σ y) (τ '' L) y := by
    intro y hy
    have hd : DifferentiableAt ℝ σ y :=
      (hσ.differentiableOn (by simp)).differentiableAt (hVo.mem_nhds (hL'V hy))
    exact hd.hasFDerivAt.hasFDerivWithinAt
  have hinj : Set.InjOn σ (τ '' L) := by
    rintro _ ⟨x₁, hx₁, rfl⟩ _ ⟨x₂, hx₂, rfl⟩ h
    have e1 := hστ x₁ (hLU hx₁)
    have e2 := hστ x₂ (hLU hx₂)
    have h12 : x₁ = x₂ := by rw [← e1, ← e2]; exact h
    rw [h12]
  have himg : σ '' (τ '' L) = L := by
    ext x
    constructor
    · rintro ⟨_, ⟨x', hx', rfl⟩, rfl⟩
      rw [hστ x' (hLU hx')]
      exact hx'
    · intro hx
      exact ⟨τ x, ⟨x, hx, rfl⟩, hστ x (hLU hx)⟩
  have hτσ : ∀ y ∈ τ '' L, τ (σ y) = y := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hστ x (hLU hx)]
  have hcov : ∀ F : E2 → ℝ, ContinuousOn F (τ '' L) → (∀ y, 0 ≤ F y) →
      ∫ x in L, F (τ x) ≤ max C₀ 0 * ∫ y in τ '' L, F y := by
    intro F hF hF0
    have hcv := integral_image_eq_integral_abs_det_fderiv_smul volume hL'm hderiv hinj
      (fun x => F (τ x))
    rw [himg] at hcv
    rw [hcv]
    have hcongr : ∫ y in τ '' L, |(fderiv ℝ σ y).det| • F (τ (σ y)) =
        ∫ y in τ '' L, |(fderiv ℝ σ y).det| * F y := by
      refine setIntegral_congr_fun hL'm (fun y hy => ?_)
      simp only [smul_eq_mul, hτσ y hy]
    rw [hcongr, ← integral_const_mul]
    refine setIntegral_mono_on ?_ ?_ hL'm (fun y hy => ?_)
    · exact ((hDc.mono hL'V).mul hF).integrableOn_compact hL'c
    · exact (continuousOn_const.mul hF).integrableOn_compact hL'c
    · exact mul_le_mul_of_nonneg_right (hDC y hy) (hF0 y)
  
  have hmapsL : Set.MapsTo τ L (P.W k) := fun x hx => (F1 x (hLU hx)).1
  have hbound : ∀ m, ∫ x in L, ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2 ≤
      2 * (∫ x in L, (f m x - wj x) ^ 2) +
        2 * (max C₀ 0 * ∫ y in τ '' L, (g m y - wk y) ^ 2) := by
    intro m
    have ha : ContinuousOn (fun x => f m x - wj x) L := ((hf m).mono hLW).sub (hwj.mono hLW)
    have hb : ContinuousOn (fun x => g m (τ x) - wk (τ x)) L :=
      ((hg m).comp (hτc.mono hLU) hmapsL).sub (hwk.comp (hτc.mono hLU) hmapsL)
    have hpt : ∀ x, ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2 ≤
        2 * (f m x - wj x) ^ 2 + 2 * (g m (τ x) - wk (τ x)) ^ 2 := by
      intro x
      nlinarith [sq_nonneg ((f m x - wj x) + (g m (τ x) - wk (τ x)))]
    have hc1 : ContinuousOn (fun x => ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2) L := by
      refine ((ha.sub hb).pow 2).congr (fun x _ => ?_)
      show ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2 =
        ((f m x - wj x) - (g m (τ x) - wk (τ x))) ^ 2
      ring
    have hI1 : IntegrableOn (fun x => ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2) L :=
      hc1.integrableOn_compact hL
    have hIa : IntegrableOn (fun x => (f m x - wj x) ^ 2) L := (ha.pow 2).integrableOn_compact hL
    have hIb : IntegrableOn (fun x => (g m (τ x) - wk (τ x)) ^ 2) L :=
      (hb.pow 2).integrableOn_compact hL
    have h1 : ∫ x in L, ((f m x - g m (τ x)) - (wj x - wk (τ x))) ^ 2 ≤
        ∫ x in L, (2 * (f m x - wj x) ^ 2 + 2 * (g m (τ x) - wk (τ x)) ^ 2) :=
      setIntegral_mono_on hI1 ((hIa.const_mul 2).add (hIb.const_mul 2)) hLm (fun x _ => hpt x)
    have h2 : ∫ x in L, (2 * (f m x - wj x) ^ 2 + 2 * (g m (τ x) - wk (τ x)) ^ 2) =
        2 * (∫ x in L, (f m x - wj x) ^ 2) + 2 * (∫ x in L, (g m (τ x) - wk (τ x)) ^ 2) := by
      rw [integral_add (hIa.const_mul 2) (hIb.const_mul 2), integral_const_mul,
        integral_const_mul]
    have hFc : ContinuousOn (fun y => (g m y - wk y) ^ 2) (τ '' L) :=
      (((hg m).sub hwk).pow 2).mono hL'W
    have h3 := hcov (fun y => (g m y - wk y) ^ 2) hFc (fun y => sq_nonneg _)
    linarith
  
  have hlim : Tendsto (fun m => 2 * (∫ x in L, (f m x - wj x) ^ 2) +
      2 * (max C₀ 0 * ∫ y in τ '' L, (g m y - wk y) ^ 2)) atTop (𝓝 0) := by
    have h := ((hfc L hL hLW).const_mul 2).add (((hgc (τ '' L) hL'c hL'W).const_mul
      (max C₀ 0)).const_mul 2)
    simpa using h
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim
    (fun m => integral_nonneg (fun x => sq_nonneg _)) hbound

theorem l2loc_const_limit (U : Set E2) (hU : IsOpen U) (D ψ : E2 → ℝ) (a : ℕ → ℝ)
    (hD : ContDiffOn ℝ ∞ D U) (hD0 : ∀ x ∈ U, fderiv ℝ D x = 0) (hψ : ContinuousOn ψ U)
    (hconv : ∀ L : Set E2, IsCompact L → L ⊆ U →
      Tendsto (fun m => ∫ x in L, (D x - a m - ψ x) ^ 2) atTop (𝓝 0)) :
    ∃ e : ℝ, (U.Nonempty → Tendsto a atTop (𝓝 e)) ∧ ∀ x ∈ U, ψ x = D x - e :=
by
  classical
  have hmono : ∀ L : Set E2, IsCompact L → ∀ f g : E2 → ℝ, ContinuousOn f L → ContinuousOn g L →
      (∀ x ∈ L, f x ≤ g x) → ∫ x in L, f x ≤ ∫ x in L, g x := by
    intro L hL f g hf hg h
    exact setIntegral_mono_on (hf.integrableOn_compact hL) (hg.integrableOn_compact hL)
      hL.measurableSet h
  have hlin : ∀ L : Set E2, IsCompact L → ∀ f g : E2 → ℝ, ContinuousOn f L → ContinuousOn g L →
      ∫ x in L, (2 * f x + 2 * g x) = 2 * (∫ x in L, f x) + 2 * ∫ x in L, g x := by
    intro L hL f g hf hg
    rw [integral_add ((hf.integrableOn_compact hL).integrable.const_mul 2)
      ((hg.integrableOn_compact hL).integrable.const_mul 2), integral_const_mul,
      integral_const_mul]
  have hvol : ∀ (x : E2) (r : ℝ), 0 < r → 0 < volume.real (closedBall x r) := by
    intro x r hr
    rw [measureReal_def]
    exact ENNReal.toReal_pos (measure_closedBall_pos volume x hr).ne'
      measure_closedBall_lt_top.ne
  by_cases hne : U.Nonempty
  swap
  · exact ⟨0, fun h => absurd h hne, fun x hx => absurd ⟨x, hx⟩ hne⟩
  obtain ⟨x₀, hx₀⟩ := hne
  obtain ⟨F, hFdef⟩ : ∃ F : E2 → ℝ, F = fun x => D x - ψ x := ⟨_, rfl⟩
  have hFc : ContinuousOn F U := by
    rw [hFdef]; exact hD.continuousOn.sub hψ
  have hconvF : ∀ L : Set E2, IsCompact L → L ⊆ U →
      Tendsto (fun m => ∫ x in L, (F x - a m) ^ 2) atTop (𝓝 0) := by
    intro L hL hLU
    refine Tendsto.congr (fun m => ?_) (hconv L hL hLU)
    congr 1
    funext x
    simp only [hFdef]
    ring
  
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hU x₀ hx₀
  have hL0U : closedBall x₀ (r / 2) ⊆ U :=
    (closedBall_subset_ball (by linarith)).trans hball
  have hL0c : IsCompact (closedBall x₀ (r / 2)) := isCompact_closedBall x₀ (r / 2)
  have hV0 := hvol x₀ (r / 2) (by linarith)
  have hF0 : ContinuousOn F (closedBall x₀ (r / 2)) := hFc.mono hL0U
  have hcau : CauchySeq a := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    have hη : 0 < ε ^ 2 * volume.real (closedBall x₀ (r / 2)) / 4 := by
      have := mul_pos (pow_pos hε 2) hV0
      linarith
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp (hconvF _ hL0c hL0U) _ hη
    refine ⟨N, fun m hm l hl => ?_⟩
    have h1 := hN m hm
    have h2 := hN l hl
    rw [Real.dist_eq, sub_zero] at h1 h2
    have h1' := (abs_lt.mp h1).2
    have h2' := (abs_lt.mp h2).2
    have hb : ∫ x in closedBall x₀ (r / 2), (a m - a l) ^ 2 ≤
        2 * (∫ x in closedBall x₀ (r / 2), (F x - a m) ^ 2) +
          2 * ∫ x in closedBall x₀ (r / 2), (F x - a l) ^ 2 :=
      (hmono _ hL0c (fun _ => (a m - a l) ^ 2)
        (fun x => 2 * (F x - a m) ^ 2 + 2 * (F x - a l) ^ 2) continuousOn_const
        (by fun_prop) (fun x _ => by nlinarith [sq_nonneg (2 * F x - a m - a l)])).trans
        (hlin _ hL0c (fun x => (F x - a m) ^ 2) (fun x => (F x - a l) ^ 2)
          (by fun_prop) (by fun_prop)).le
    rw [setIntegral_const, smul_eq_mul] at hb
    have hsq : (a m - a l) ^ 2 < ε ^ 2 := by
      by_contra hc
      push_neg at hc
      have : volume.real (closedBall x₀ (r / 2)) * ε ^ 2 ≤
          volume.real (closedBall x₀ (r / 2)) * (a m - a l) ^ 2 :=
        mul_le_mul_of_nonneg_left hc hV0.le
      linarith
    rw [Real.dist_eq]
    exact abs_lt_of_sq_lt_sq hsq hε.le
  obtain ⟨e, he⟩ := cauchySeq_tendsto_of_complete hcau
  refine ⟨e, fun _ => he, fun x hx => ?_⟩
  by_contra hψx
  have hFx : F x ≠ e := by
    intro h
    apply hψx
    rw [hFdef] at h
    simp only at h
    linarith
  have hc : 0 < (F x - e) ^ 2 := by
    have : F x - e ≠ 0 := sub_ne_zero.mpr hFx
    positivity
  have hFxc : ContinuousAt F x := hFc.continuousAt (hU.mem_nhds hx)
  have hg : ContinuousAt (fun y => (F y - e) ^ 2) x := (hFxc.sub continuousAt_const).pow 2
  have hev : ∀ᶠ y in 𝓝 x, (F x - e) ^ 2 / 2 < (F y - e) ^ 2 ∧ y ∈ U :=
    (Filter.Tendsto.eventually hg
      (lt_mem_nhds (by linarith : (F x - e) ^ 2 / 2 < (F x - e) ^ 2))).and (hU.mem_nhds hx)
  obtain ⟨ε, hε, hεP⟩ := Metric.eventually_nhds_iff.mp hev
  have hLsub : ∀ y ∈ closedBall x (ε / 2), (F x - e) ^ 2 / 2 < (F y - e) ^ 2 ∧ y ∈ U := by
    intro y hy
    apply hεP
    rw [mem_closedBall] at hy
    linarith
  have hLU : closedBall x (ε / 2) ⊆ U := fun y hy => (hLsub y hy).2
  have hLc : IsCompact (closedBall x (ε / 2)) := isCompact_closedBall x _
  have hV := hvol x (ε / 2) (by linarith)
  have hFL : ContinuousOn F (closedBall x (ε / 2)) := hFc.mono hLU
  have hbound : ∀ m, volume.real (closedBall x (ε / 2)) * ((F x - e) ^ 2 / 2) ≤
      2 * (∫ y in closedBall x (ε / 2), (F y - a m) ^ 2) +
        2 * (volume.real (closedBall x (ε / 2)) * (a m - e) ^ 2) := by
    intro m
    have h1 : ∫ y in closedBall x (ε / 2), (F x - e) ^ 2 / 2 ≤
        ∫ y in closedBall x (ε / 2), (F y - e) ^ 2 :=
      hmono _ hLc (fun _ => (F x - e) ^ 2 / 2) (fun y => (F y - e) ^ 2) continuousOn_const
        (by fun_prop) (fun y hy => (hLsub y hy).1.le)
    have h2 : ∫ y in closedBall x (ε / 2), (F y - e) ^ 2 ≤
        2 * (∫ y in closedBall x (ε / 2), (F y - a m) ^ 2) +
          2 * ∫ y in closedBall x (ε / 2), (a m - e) ^ 2 :=
      (hmono _ hLc (fun y => (F y - e) ^ 2)
        (fun y => 2 * (F y - a m) ^ 2 + 2 * (a m - e) ^ 2) (by fun_prop) (by fun_prop)
        (fun y _ => by nlinarith [sq_nonneg (F y - 2 * a m + e)])).trans
        (hlin _ hLc (fun y => (F y - a m) ^ 2) (fun _ => (a m - e) ^ 2)
          (by fun_prop) continuousOn_const).le
    rw [setIntegral_const, smul_eq_mul] at h1 h2
    linarith
  have hlim : Tendsto (fun m => 2 * (∫ y in closedBall x (ε / 2), (F y - a m) ^ 2) +
        2 * (volume.real (closedBall x (ε / 2)) * (a m - e) ^ 2)) atTop (𝓝 0) := by
    have h1 := hconvF _ hLc hLU
    have h2 : Tendsto (fun m => (a m - e) ^ 2) atTop (𝓝 0) := by
      have := (he.sub_const e).pow 2
      simpa using this
    have := (h1.const_mul 2).add ((h2.const_mul (volume.real (closedBall x (ε / 2)))).const_mul 2)
    simpa using this
  have hle := ge_of_tendsto' hlim hbound
  have : 0 < volume.real (closedBall x (ε / 2)) * ((F x - e) ^ 2 / 2) :=
    mul_pos hV (by linarith)
  linarith

theorem patched_dirichlet_harmonic {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (hS : IsCompact S) (P : EigPatchedSurface X S)
    (hsq : ∀ j, ∃ a b s : ℝ, 0 < s ∧
      P.W j = {x : E2 | a < x 0 ∧ x 0 < a + s ∧ b < x 1 ∧ x 1 < b + s})
    (θ : Fin P.n → E2 → ℝ) (hθ : ∀ j, ContDiffOn ℝ ∞ (θ j) (P.W j))
    (hcomp : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (θ j) x = fderiv ℝ (fun x' => θ k (P.proj k (P.param j x'))) x) :
    ∃ u : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) ∧
      ∀ j, ∀ x ∈ P.W j, lap2 (P.h j) (fun x' => θ j x' - u (P.param j x')) x = 0 :=
by
  classical
  
  have F1 : ∀ (j k : Fin P.n) (x : E2), x ∈ P.W j → P.param j x ∈ P.O k →
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j k x hx hxk
    have hS' : P.param j x ∈ P.O j ∩ S := by
      rw [← P.image_eq j]; exact ⟨x, hx, rfl⟩
    have hk : P.param j x ∈ P.param k '' P.W k := by
      rw [P.image_eq k]; exact ⟨hxk, hS'.2⟩
    obtain ⟨y, hy, hyx⟩ := hk
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hOvopen : ∀ j k, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j k =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hτmaps : ∀ j k, Set.MapsTo (fun x => P.proj k (P.param j x))
      (P.W j ∩ P.param j ⁻¹' P.O k) (P.W k) := fun j k x hx => (F1 j k x hx.1 hx.2).1
  
  obtain ⟨u, δ, hus, hδ, hgr, hEL1⟩ := dirichlet_variational_sequence S hS P θ hθ hcomp
  have hnorm : ∀ j, ∃ c : ℕ → ℝ, ∀ L : Set E2, IsCompact L → L ⊆ P.W j →
      ∃ C : ℝ, ∀ n, ∫ x in L, ((θ j x - u n (P.param j x) - c n) ^ 2 +
        ∑ k : Fin 2, (pd2 k (fun x' => θ j x' - u n (P.param j x') - c n) x) ^ 2) ≤ C := by
    intro j
    obtain ⟨a, b, s, hs, heq⟩ := hsq j
    obtain ⟨c, hc⟩ := square_poincare_normalize a b s hs
      (fun n x => θ j x - u n (P.param j x))
      (fun n => by rw [← heq]; exact (hθ j).sub (hus n j))
      (fun L hL hLs => hgr j L hL (by rw [heq]; exact hLs))
    exact ⟨c, fun L hL hLs => hc L hL (by rw [← heq]; exact hLs)⟩
  choose cc hcc using hnorm
  
  obtain ⟨ψ, w, G, hψ, hL2, hconv, hgw, hweak⟩ := eig_local_weak_limit P.n P.W P.W_open P.h
    P.h_smooth P.h_posDef (fun _ _ => 0) (fun _ => contDiffOn_const)
    (fun n i x => θ i x - u n (P.param i x) - cc i n)
    (fun n i => ((hθ i).sub (hus n i)).sub contDiffOn_const)
    (fun i L hL hLs => hcc i L hL hLs) δ hδ
    (by
      intro i ζ h1 h2 h3
      obtain ⟨M, hM⟩ := hEL1 i ζ h1 h2 h3
      refine ⟨M, fun n t => ?_⟩
      have hMnt := hM n t
      simp only [pd2, fderiv_sub_const, zero_mul, sub_zero] at hMnt ⊢
      exact hMnt)
  
  have hreg : ∀ i, ∃ w' : E2 → ℝ, ContDiffOn ℝ ∞ w' (P.W i) ∧
      (∀ᵐ x ∂(volume.restrict (P.W i)), w i x = w' x) ∧
      ∀ x ∈ P.W i, lap2 (P.h i) w' x = 0 := by
    intro i
    obtain ⟨w'', h1, h2, h3⟩ := eig_local_regularity (P.W i) (P.W_open i) (P.h i) (P.h_smooth i)
      (P.h_posDef i) (fun _ => 0) contDiffOn_const (w i) (G i) (hL2 i) (hgw i) (hweak i)
    exact ⟨w'', h1, h2, fun x hx => by simpa using h3 x hx⟩
  choose w' hw's hae hharm using hreg
  have hconv' : ∀ i (L : Set E2), IsCompact L → L ⊆ P.W i →
      Tendsto (fun m => ∫ x in L, (θ i x - u (ψ m) (P.param i x) - cc i (ψ m) - w' i x) ^ 2)
        atTop (𝓝 0) := by
    intro i L hL hLs
    refine Tendsto.congr (fun m => ?_) (hconv i L hL hLs)
    refine setIntegral_congr_ae hL.measurableSet ?_
    have h1 := hae i
    rw [ae_restrict_iff' (P.W_open i).measurableSet] at h1
    filter_upwards [h1] with x hx hxL
    rw [hx (hLs hxL)]
  
  have hpair : ∀ j k, ∃ e : ℝ, ((P.W j ∩ P.param j ⁻¹' P.O k).Nonempty →
      Tendsto (fun m => cc j (ψ m) - cc k (ψ m)) atTop (𝓝 e)) ∧
      ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        w' j x - w' k (P.proj k (P.param j x)) =
          (θ j x - θ k (P.proj k (P.param j x))) - e := by
    intro j k
    have hs5 := overlap_diff_l2_conv S P j k
      (fun m x => θ j x - u (ψ m) (P.param j x) - cc j (ψ m))
      (fun m y => θ k y - u (ψ m) (P.param k y) - cc k (ψ m)) (w' j) (w' k)
      (fun m => (((hθ j).sub (hus (ψ m) j)).sub contDiffOn_const).continuousOn)
      (fun m => (((hθ k).sub (hus (ψ m) k)).sub contDiffOn_const).continuousOn)
      (hw's j).continuousOn (hw's k).continuousOn
      (fun L hL hLs => hconv' j L hL hLs) (fun L hL hLs => hconv' k L hL hLs)
    have hD : ContDiffOn ℝ ∞ (fun x => θ j x - θ k (P.proj k (P.param j x)))
        (P.W j ∩ P.param j ⁻¹' P.O k) :=
      ((hθ j).mono Set.inter_subset_left).sub ((hθ k).comp (P.trans_smooth j k) (hτmaps j k))
    have hD0 : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        fderiv ℝ (fun x => θ j x - θ k (P.proj k (P.param j x))) x = 0 := by
      intro x hx
      have hnx : P.W j ∩ P.param j ⁻¹' P.O k ∈ 𝓝 x := (hOvopen j k).mem_nhds hx
      have hWx : P.W j ∈ 𝓝 x := (P.W_open j).mem_nhds hx.1
      have hd1 : DifferentiableAt ℝ (θ j) x :=
        ((hθ j).contDiffAt hWx).differentiableAt (by simp)
      have hd3 : DifferentiableAt ℝ (fun x' => θ k (P.proj k (P.param j x'))) x :=
        (((hθ k).comp (P.trans_smooth j k) (hτmaps j k)).contDiffAt hnx).differentiableAt
          (by simp)
      rw [show (fun x => θ j x - θ k (P.proj k (P.param j x))) =
          (θ j) - (fun x' => θ k (P.proj k (P.param j x'))) from rfl, fderiv_sub hd1 hd3,
        hcomp j k x hx, sub_self]
    have hψc : ContinuousOn (fun x => w' j x - w' k (P.proj k (P.param j x)))
        (P.W j ∩ P.param j ⁻¹' P.O k) :=
      ((hw's j).continuousOn.mono Set.inter_subset_left).sub
        ((hw's k).continuousOn.comp (P.trans_smooth j k).continuousOn (hτmaps j k))
    have hcv : ∀ L : Set E2, IsCompact L → L ⊆ P.W j ∩ P.param j ⁻¹' P.O k →
        Tendsto (fun m => ∫ x in L, ((θ j x - θ k (P.proj k (P.param j x))) -
          (cc j (ψ m) - cc k (ψ m)) - (w' j x - w' k (P.proj k (P.param j x)))) ^ 2)
          atTop (𝓝 0) := by
      intro L hL hLs
      refine Tendsto.congr (fun m => ?_) (hs5 L hL hLs)
      refine setIntegral_congr_fun hL.measurableSet (fun x hx => ?_)
      have hx' := hLs hx
      have h2 := (F1 j k x hx'.1 hx'.2).2
      simp only [h2]
      ring
    obtain ⟨e, he1, he2⟩ := l2loc_const_limit (P.W j ∩ P.param j ⁻¹' P.O k) (hOvopen j k)
      (fun x => θ j x - θ k (P.proj k (P.param j x)))
      (fun x => w' j x - w' k (P.proj k (P.param j x)))
      (fun m => cc j (ψ m) - cc k (ψ m)) hD hD0 hψc hcv
    exact ⟨e, he1, he2⟩
  choose e he1 he2 using hpair
  
  have hcob : ∃ c' : Fin P.n → ℝ, ∀ j k, (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty →
      e j k = c' j - c' k := by
    let Lm : (Fin P.n → ℝ) →ₗ[ℝ] (Fin P.n → Fin P.n → ℝ) :=
      { toFun := fun c j k => if (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty then c j - c k else 0
        map_add' := by
          intro c d
          funext j k
          simp only [Pi.add_apply]
          split_ifs <;> ring
        map_smul' := by
          intro r c
          funext j k
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
          split_ifs <;> ring }
    have hclosed : IsClosed ((LinearMap.range Lm : Submodule ℝ (Fin P.n → Fin P.n → ℝ)) :
        Set (Fin P.n → Fin P.n → ℝ)) :=
      Submodule.closed_of_finiteDimensional _
    have hlim : Tendsto (fun m => Lm (fun j => cc j (ψ m))) atTop
        (𝓝 (fun j k => if (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty then e j k else 0)) := by
      rw [tendsto_pi_nhds]
      intro j
      rw [tendsto_pi_nhds]
      intro k
      show Tendsto (fun m => if (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty then
        cc j (ψ m) - cc k (ψ m) else 0) atTop _
      by_cases hV : (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty
      · simp only [if_pos hV]
        exact he1 j k hV
      · simp only [if_neg hV]
        exact tendsto_const_nhds
    have hmem := hclosed.mem_of_tendsto hlim
      (Eventually.of_forall (fun m => LinearMap.mem_range_self Lm _))
    obtain ⟨c', hc'⟩ := hmem
    refine ⟨c', fun j k hV => ?_⟩
    have h1 := congrFun (congrFun hc' j) k
    change (if (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty then c' j - c' k else 0) =
      (if (P.W j ∩ P.param j ⁻¹' P.O k).Nonempty then e j k else 0) at h1
    rw [if_pos hV, if_pos hV] at h1
    exact h1.symm
  obtain ⟨cs, hcs⟩ := hcob
  
  have hcompat : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      θ j x - w' j x - cs j =
        θ k (P.proj k (P.param j x)) - w' k (P.proj k (P.param j x)) - cs k := by
    intro j k x hx
    have h1 := he2 j k x hx
    have h2 := hcs j k ⟨x, hx⟩
    linarith
  have hglue : ∃ U : X → ℝ, ∀ j, ∀ x ∈ P.W j, U (P.param j x) = θ j x - w' j x - cs j := by
    refine ⟨fun q => if hq : ∃ j, q ∈ P.O j ∧ q ∈ S then
      θ hq.choose (P.proj hq.choose q) - w' hq.choose (P.proj hq.choose q) - cs hq.choose
      else 0, ?_⟩
    intro j x hx
    have hq : P.param j x ∈ P.O j ∩ S := by
      rw [← P.image_eq j]; exact ⟨x, hx, rfl⟩
    have hex : ∃ j', P.param j x ∈ P.O j' ∧ P.param j x ∈ S := ⟨j, hq.1, hq.2⟩
    simp only [dif_pos hex]
    exact (hcompat j hex.choose x ⟨hx, hex.choose_spec.1⟩).symm
  obtain ⟨U, hU⟩ := hglue
  
  refine ⟨U, fun j => ?_, fun j x hx => ?_⟩
  · exact (((hθ j).sub (hw's j)).sub contDiffOn_const).congr (fun x hx => hU j x hx)
  · have hev : (fun x' => θ j x' - U (P.param j x')) =ᶠ[𝓝 x] (fun x' => w' j x' + cs j) := by
      filter_upwards [(P.W_open j).mem_nhds hx] with y hy
      rw [hU j y hy]
      ring
    have hpd1 : ∀ k, pd2 k (fun x' => w' j x' + cs j) = pd2 k (w' j) := by
      intro k
      funext y
      simp only [pd2, fderiv_add_const]
    have hpdx : ∀ k, pd2 k (fun x' => θ j x' - U (P.param j x')) x = pd2 k (w' j) x := by
      intro k
      rw [← hpd1 k]
      unfold pd2
      rw [hev.fderiv_eq]
    have hpd2 : ∀ k l, pd2 l (pd2 k (fun x' => θ j x' - U (P.param j x'))) x =
        pd2 l (pd2 k (w' j)) x := by
      intro k l
      have hev2 : pd2 k (fun x' => θ j x' - U (P.param j x')) =ᶠ[𝓝 x] pd2 k (w' j) := by
        filter_upwards [hev.eventuallyEq_nhds] with y hy
        rw [← hpd1 k]
        unfold pd2
        rw [hy.fderiv_eq]
      exact congrArg (fun T : E2 →L[ℝ] ℝ => T (e2 l)) hev2.fderiv_eq
    have hh := hharm j x hx
    unfold lap2 at hh ⊢
    simp only [hpdx, hpd2]
    exact hh

theorem bl2_grad_Q (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef)
    (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w W) :
    ∀ y ∈ W, ∀ c : Fin 2,
      pd2 c (fun z => ∑ a : Fin 2, ∑ b : Fin 2, (h z)⁻¹ a b * pd2 a w z * pd2 b w z) y =
        2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h y)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) c a y * pd2 b w y :=
by
  intro y hy c
  have hsymm : ∀ z ∈ W, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have h1 := (hpos z hz).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  have G := gs2_metric_calculus h W hW hh hsymm hpos
  have hPd : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x => (h x)⁻¹ a b) y := fun a b =>
    ((G.1 a b).differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
  have hω : ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a w) W := by
    intro a
    have h1 := hw.fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hωd : ∀ a : Fin 2, DifferentiableAt ℝ (pd2 a w) y := fun a =>
    ((hω a).differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
  have hprod3 : ∀ (p q u : E2 → ℝ), DifferentiableAt ℝ p y → DifferentiableAt ℝ q y →
      DifferentiableAt ℝ u y →
      pd2 c (fun x => p x * q x * u x) y =
        pd2 c p y * q y * u y + p y * pd2 c q y * u y + p y * q y * pd2 c u y := by
    intro p q u hp hq hu
    unfold pd2
    have hpq : DifferentiableAt ℝ (fun x => p x * q x) y := hp.mul hq
    rw [fderiv_fun_mul hpq hu, fderiv_fun_mul hp hq]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hsum : ∀ (F : Fin 2 → E2 → ℝ), (∀ i, DifferentiableAt ℝ (F i) y) →
      pd2 c (fun x => ∑ i : Fin 2, F i x) y = ∑ i : Fin 2, pd2 c (F i) y := by
    intro F hF
    unfold pd2
    rw [fderiv_fun_sum (fun i _ => hF i), ContinuousLinearMap.sum_apply]
  have hD : ∀ a b : Fin 2, DifferentiableAt ℝ
      (fun x => (h x)⁻¹ a b * pd2 a w x * pd2 b w x) y := fun a b =>
    ((hPd a b).mul (hωd a)).mul (hωd b)
  have d1 : ∀ a : Fin 2, DifferentiableAt ℝ
      (fun x => ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a w x * pd2 b w x) y :=
    fun a => DifferentiableAt.fun_sum (fun b _ => hD a b)
  have e1 : pd2 c (fun z => ∑ a : Fin 2, ∑ b : Fin 2, (h z)⁻¹ a b * pd2 a w z * pd2 b w z) y =
      ∑ a : Fin 2, ∑ b : Fin 2, pd2 c (fun x => (h x)⁻¹ a b * pd2 a w x * pd2 b w x) y := by
    rw [hsum _ d1]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hsum _ (fun b => hD a b)]
  have e2 : ∀ a b : Fin 2, pd2 c (fun x => (h x)⁻¹ a b * pd2 a w x * pd2 b w x) y =
      pd2 c (fun x => (h x)⁻¹ a b) y * pd2 a w y * pd2 b w y
        + (h y)⁻¹ a b * pd2 c (pd2 a w) y * pd2 b w y
        + (h y)⁻¹ a b * pd2 a w y * pd2 c (pd2 b w) y := fun a b =>
    hprod3 _ _ _ (hPd a b) (hωd a) (hωd b)
  have hg : (h y)⁻¹ 1 0 = (h y)⁻¹ 0 1 := G.2.1 y hy 1 0
  rw [e1]
  simp only [e2, G.2.2.2.2.2 y hy c]
  simp only [gsCovD1, Fin.sum_univ_two]
  rw [hg]
  ring

theorem bl2_hess_V (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef)
    (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W) (i j : Fin 2) :
    pd2 i (fun y => 2 * ∑ a : Fin 2, ∑ b : Fin 2,
        (h y)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a y * pd2 b w y) x
      - ∑ k : Fin 2, christoffel2 h k i j x *
        (2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h x)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) k a x * pd2 b w x) =
    2 * ∑ a : Fin 2, ∑ b : Fin 2,
        (h x)⁻¹ a b * gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x * pd2 b w x
      + 2 * ∑ a : Fin 2, ∑ b : Fin 2,
        (h x)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a x * gsCovD1 h (fun r => pd2 r w) i b x :=
by
  have hsymm : ∀ y ∈ W, ∀ i j : Fin 2, h y i j = h y j i := by
    intro y hy i j
    have h1 := (hpos y hy).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  have G := gs2_metric_calculus h W hW hh hsymm hpos
  have hω : ∀ b : Fin 2, ContDiffOn ℝ ∞ (pd2 b w) W := by
    intro b
    have h1 := hw.fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hωω : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (pd2 a (pd2 b w)) W := by
    intro a b
    have h1 := (hω b).fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hH : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (gsCovD1 h (fun r => pd2 r w) i j) W := by
    intro i j
    have e : gsCovD1 h (fun r => pd2 r w) i j = fun y =>
        pd2 i (pd2 j w) y - ∑ m : Fin 2, christoffel2 h m i j y * pd2 m w y := by
      funext y; rfl
    rw [e]
    exact (hωω i j).sub (ContDiffOn.sum (fun m _ => (G.2.2.1 m i j).mul (hω m)))
  have hdiff : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → DifferentiableAt ℝ f x := fun f hf =>
    (hf.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)
  have hA : ∀ a b : Fin 2, DifferentiableAt ℝ (fun y => (h y)⁻¹ a b) x :=
    fun a b => hdiff _ (G.1 a b)
  have hB : ∀ a : Fin 2, DifferentiableAt ℝ (gsCovD1 h (fun r => pd2 r w) j a) x :=
    fun a => hdiff _ (hH j a)
  have hC : ∀ b : Fin 2, DifferentiableAt ℝ (pd2 b w) x := fun b => hdiff _ (hω b)
  have key : ∀ a b : Fin 2, HasFDerivAt (fun y => (h y)⁻¹ a b *
      gsCovD1 h (fun r => pd2 r w) j a y * pd2 b w y)
      (((h x)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a x) • fderiv ℝ (pd2 b w) x +
        pd2 b w x • ((h x)⁻¹ a b • fderiv ℝ (gsCovD1 h (fun r => pd2 r w) j a) x +
          gsCovD1 h (fun r => pd2 r w) j a x • fderiv ℝ (fun y => (h y)⁻¹ a b) x)) x :=
    fun a b => ((hA a b).hasFDerivAt.mul (hB a).hasFDerivAt).mul (hC b).hasFDerivAt
  have hF := (HasFDerivAt.fun_sum (u := Finset.univ) (fun a _ =>
    HasFDerivAt.fun_sum (u := Finset.univ) (fun b _ => key a b))).const_mul (2 : ℝ)
  have hL : pd2 i (fun y => 2 * ∑ a : Fin 2, ∑ b : Fin 2,
      (h y)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a y * pd2 b w y) x =
    2 * ∑ a : Fin 2, ∑ b : Fin 2,
      (pd2 i (fun z => (h z)⁻¹ a b) x * gsCovD1 h (fun r => pd2 r w) j a x * pd2 b w x
       + (h x)⁻¹ a b * pd2 i (gsCovD1 h (fun r => pd2 r w) j a) x * pd2 b w x
       + (h x)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a x * pd2 i (pd2 b w) x) := by
    show fderiv ℝ _ x (e2 i) = _
    rw [hF.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sum_apply,
      ContinuousLinearMap.add_apply, smul_eq_mul]
    simp only [Fin.sum_univ_two]
    unfold pd2
    ring
  have hdG : ∀ a b : Fin 2, pd2 i (fun z => (h z)⁻¹ a b) x =
      -∑ m : Fin 2, (christoffel2 h a i m x * (h x)⁻¹ m b + christoffel2 h b i m x * (h x)⁻¹ a m) :=
    fun a b => G.2.2.2.2.2 x hx i a b
  have hdω : ∀ b : Fin 2, pd2 i (pd2 b w) x =
      gsCovD1 h (fun r => pd2 r w) i b x + ∑ m : Fin 2, christoffel2 h m i b x * pd2 m w x := by
    intro b
    simp only [gsCovD1]
    ring
  rw [hL]
  simp only [gsCovD2]
  simp only [hdG, hdω]
  simp only [Fin.sum_univ_two]
  ring

theorem bl2_oneform_ricci (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef)
    (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W) (l i k : Fin 2) :
    gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) l i k x
      - gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i l k x =
    -∑ m : Fin 2, gsRiem2 h m l i k x * pd2 m w x :=
by
  have hsymm : ∀ y ∈ W, ∀ i j : Fin 2, h y i j = h y j i := by
    intro y hy i j
    have h1 := (hpos y hy).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  have G := gs2_metric_calculus h W hW hh hsymm hpos
  have hU : W ∈ 𝓝 x := hW.mem_nhds hx
  have hω : ∀ b : Fin 2, ContDiffOn ℝ ∞ (pd2 b w) W := by
    intro b
    have h1 := hw.fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hωω : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (pd2 a (pd2 b w)) W := by
    intro a b
    have h1 := (hω b).fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have dΓ : ∀ m a b : Fin 2, DifferentiableAt ℝ (christoffel2 h m a b) x := fun m a b =>
    ((G.2.2.1 m a b).contDiffAt hU).differentiableAt (by simp)
  have dω : ∀ m : Fin 2, DifferentiableAt ℝ (pd2 m w) x := fun m =>
    ((hω m).contDiffAt hU).differentiableAt (by simp)
  have dωω : ∀ a b : Fin 2, DifferentiableAt ℝ (pd2 a (pd2 b w)) x := fun a b =>
    ((hωω a b).contDiffAt hU).differentiableAt (by simp)
  
  have schwarz : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ a b : Fin 2,
      pd2 a (pd2 b f) x = pd2 b (pd2 a f) x := by
    intro f hf a b
    have hfx : ContDiffAt ℝ ∞ f x := hf.contDiffAt hU
    have hsym : IsSymmSndFDerivAt ℝ f x := hfx.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; norm_cast)
    have hdf : DifferentiableAt ℝ (fderiv ℝ f) x :=
      ((((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hf).2).contDiffAt hU).differentiableAt
        (by simp)
    have key : ∀ a b : Fin 2, pd2 a (pd2 b f) x = fderiv ℝ (fderiv ℝ f) x (e2 a) (e2 b) := by
      intro a b
      have H : HasFDerivAt (pd2 b f)
          ((fderiv ℝ f x).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ f) x).flip (e2 b)) x :=
        hdf.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 b) x)
      show fderiv ℝ (pd2 b f) x (e2 a) = _
      rw [H.fderiv]
      simp
    rw [key a b, key b a]
    exact hsym (e2 a) (e2 b)
  
  have expand : ∀ a b c : Fin 2, pd2 a (gsCovD1 h (fun r => pd2 r w) b c) x =
      pd2 a (pd2 b (pd2 c w)) x
        - ∑ m : Fin 2, (pd2 a (christoffel2 h m b c) x * pd2 m w x
            + christoffel2 h m b c x * pd2 a (pd2 m w) x) := by
    intro a b c
    have H : HasFDerivAt (fun y => pd2 b (pd2 c w) y
          - ∑ m : Fin 2, christoffel2 h m b c y * pd2 m w y)
        (fderiv ℝ (pd2 b (pd2 c w)) x
          - ∑ m : Fin 2, (christoffel2 h m b c x • fderiv ℝ (pd2 m w) x
              + pd2 m w x • fderiv ℝ (christoffel2 h m b c) x)) x :=
      (dωω b c).hasFDerivAt.sub
        (HasFDerivAt.sum (u := Finset.univ) fun m _ =>
          (dΓ m b c).hasFDerivAt.mul (dω m).hasFDerivAt)
    show fderiv ℝ (fun y => pd2 b (pd2 c w) y
          - ∑ m : Fin 2, christoffel2 h m b c y * pd2 m w y) x (e2 a) = _
    rw [H.fderiv]
    simp only [pd2, ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  
  simp only [gsCovD2]
  rw [expand l i k, expand i l k, schwarz (pd2 k w) (hω k) l i]
  simp only [gsCovD1, gsRiem2, Fin.sum_univ_two]
  rw [G.2.2.2.1 x hx 0 i l, G.2.2.2.1 x hx 1 i l]
  ring

theorem bochner_lap2_identity (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef)
    (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W) :
    lap2 h (fun y => ∑ a : Fin 2, ∑ b : Fin 2, (h y)⁻¹ a b * pd2 a w y * pd2 b w y) x =
      2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
          (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
          (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) +
        2 * (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a w x * pd2 b (lap2 h w) x) +
        2 * gaussCurv2 h x * (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a w x * pd2 b w x) :=
by
  
  have hsymm : ∀ y ∈ W, ∀ i j : Fin 2, h y i j = h y j i := by
    intro y hy i j
    have h1 := (hpos y hy).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  have G := gs2_metric_calculus h W hW hh hsymm hpos
  have CL := gs2_contraction_leibniz h W hW G.1 G.2.2.2.2.2
  have hω : ∀ b : Fin 2, ContDiffOn ℝ ∞ (pd2 b w) W := by
    intro b
    have h1 := hw.fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hωω : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (pd2 a (pd2 b w)) W := by
    intro a b
    have h1 := (hω b).fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hH : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (gsCovD1 h (fun r => pd2 r w) i j) W := by
    intro i j
    have e : gsCovD1 h (fun r => pd2 r w) i j = fun y =>
        pd2 i (pd2 j w) y - ∑ m : Fin 2, christoffel2 h m i j y * pd2 m w y := by
      funext y; rfl
    rw [e]
    exact (hωω i j).sub (ContDiffOn.sum (fun m _ => (G.2.2.1 m i j).mul (hω m)))
  
  have hschwarz : ∀ (f : E2 → ℝ) (y : E2), ContDiffAt ℝ ∞ f y → ∀ i j : Fin 2,
      pd2 i (pd2 j f) y = pd2 j (pd2 i f) y := by
    intro f y hf i j
    have h2 : minSmoothness ℝ 2 ≤ ∞ := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact WithTop.coe_le_coe.mpr (le_top : (2 : ℕ∞) ≤ ⊤)
    have hdf : DifferentiableAt ℝ (fderiv ℝ f) y :=
      (hf.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)
    have key : ∀ a b : Fin 2, pd2 a (pd2 b f) y = fderiv ℝ (fderiv ℝ f) y (e2 a) (e2 b) := by
      intro a b
      show fderiv ℝ (fun z => fderiv ℝ f z (e2 b)) y (e2 a) = _
      rw [fderiv_clm_apply hdf (differentiableAt_const (e2 b))]
      simp
    rw [key, key]
    exact (hf.isSymmSndFDerivAt h2) (e2 i) (e2 j)
  
  have hS4 : ∀ y ∈ W, ∀ i j : Fin 2,
      gsCovD1 h (fun r => pd2 r w) i j y = gsCovD1 h (fun r => pd2 r w) j i y := by
    intro y hy i j
    simp only [gsCovD1]
    rw [hschwarz w y (hw.contDiffAt (hW.mem_nhds hy)) i j]
    congr 1
    exact Finset.sum_congr rfl (fun m _ => by rw [G.2.2.2.1 y hy m i j])
  
  have hpd0 : ∀ a b c d : Fin 2, pd2 a (gsCovD2 h (fun i j y => h y i j) b c d) x = 0 := by
    intro a b c d
    have hev : gsCovD2 h (fun i j y => h y i j) b c d =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => G.2.2.2.2.1 y hy b c d)
    show fderiv ℝ _ x (e2 a) = 0
    rw [hev.fderiv_eq]
    simp
  have hRiem : ∀ m l i k : Fin 2, gsRiem2 h m l i k x = gaussCurv2 h x *
      (h x i k * (if m = l then 1 else 0) - h x l k * (if m = i then 1 else 0)) := by
    refine gs2_curvature_2d h x (hpos x hx) ?_
    intro l i k j
    have hR := gs2_ricci_identity h W hW G.2.2.1 G.2.2.2.1 (fun i j y => h y i j) hh x hx l i k j
    have hz : ∀ a b c d : Fin 2, gsCovD3 h (gsCovD2 h (fun i j y => h y i j)) a b c d x = 0 := by
      intro a b c d
      simp [gsCovD3, hpd0, G.2.2.2.2.1 x hx]
    rw [hz, hz] at hR
    try simp only at hR
    linarith
  have hRc : ∀ i a j : Fin 2, ∑ m : Fin 2, gsRiem2 h m i a j x * pd2 m w x =
      gaussCurv2 h x * (h x a j * pd2 i w x - h x i j * pd2 a w x) := by
    intro i a j
    simp only [hRiem]
    simp only [mul_sub, sub_mul, Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero, ite_mul,
      zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  
  have hdet : IsUnit (h x).det := isUnit_iff_ne_zero.mpr (hpos x hx).det_pos.ne'
  have hI : ∀ i k : Fin 2, ∑ j : Fin 2, h x i j * (h x)⁻¹ j k = if i = k then 1 else 0 := by
    intro i k
    have := congrFun (congrFun (Matrix.mul_nonsing_inv (h x) hdet) i) k
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  have hcontr : ∀ a : Fin 2,
      ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * (h x a j * pd2 i w x) = pd2 a w x := by
    intro a
    have e1 : ∀ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * (h x a j * pd2 i w x) =
        (∑ j : Fin 2, h x a j * (h x)⁻¹ j i) * pd2 i w x := by
      intro i
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [G.2.1 x hx i j]; ring
    simp only [e1, hI]
    simp
  have htrace : ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * h x i j = 2 := by
    have e1 : ∀ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * h x i j =
        ∑ j : Fin 2, h x i j * (h x)⁻¹ j i := by
      intro i
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [G.2.1 x hx i j]; ring
    simp only [e1, hI]
    norm_num [Fin.sum_univ_two]
  
  have hDsym : ∀ i j a : Fin 2,
      gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x =
        gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i a j x := by
    intro i j a
    have hev : gsCovD1 h (fun r => pd2 r w) j a =ᶠ[𝓝 x] gsCovD1 h (fun r => pd2 r w) a j :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => hS4 y hy j a)
    have hpd : pd2 i (gsCovD1 h (fun r => pd2 r w) j a) x =
        pd2 i (gsCovD1 h (fun r => pd2 r w) a j) x := by
      show fderiv ℝ _ x (e2 i) = fderiv ℝ _ x (e2 i)
      rw [hev.fderiv_eq]
    simp only [gsCovD2, Fin.sum_univ_two]
    rw [hpd, hS4 x hx 0 a, hS4 x hx 1 a, hS4 x hx j 0, hS4 x hx j 1]
    ring
  
  have s6 : ∀ a : Fin 2, ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
      gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x =
      pd2 a (lap2 h w) x + gaussCurv2 h x * pd2 a w x := by
    intro a
    have htr : gsTrace h (gsCovD1 h (fun r => pd2 r w)) = lap2 h w := by
      funext y; rfl
    have e6c : pd2 a (lap2 h w) x = ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l *
        gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) a k l x := by
      have := CL.1 _ hH x hx a
      rwa [htr] at this
    have key : ∀ i j : Fin 2, gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x =
        gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) a i j x -
          gaussCurv2 h x * (h x a j * pd2 i w x - h x i j * pd2 a w x) := by
      intro i j
      have e3 := bl2_oneform_ricci W hW h hh hpos w hw x hx i a j
      rw [hRc i a j] at e3
      rw [hDsym i j a]
      linarith
    have hsum : ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
        gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x =
        ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
        (gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) a i j x -
          gaussCurv2 h x * (h x a j * pd2 i w x - h x i j * pd2 a w x)) :=
      Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by rw [key i j]))
    rw [hsum, e6c]
    have hc := hcontr a
    have ht := htrace
    simp only [Fin.sum_univ_two] at hc ht ⊢
    linear_combination (-(gaussCurv2 h x)) * hc + (gaussCurv2 h x * pd2 a w x) * ht
  
  have e7 : ∀ i j : Fin 2,
      pd2 i (pd2 j (fun y => ∑ a : Fin 2, ∑ b : Fin 2, (h y)⁻¹ a b * pd2 a w y * pd2 b w y)) x -
        ∑ k : Fin 2, christoffel2 h k i j x *
          pd2 k (fun y => ∑ a : Fin 2, ∑ b : Fin 2, (h y)⁻¹ a b * pd2 a w y * pd2 b w y) x =
      2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h x)⁻¹ a b * gsCovD2 h (gsCovD1 h (fun r => pd2 r w)) i j a x * pd2 b w x
        + 2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h x)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a x *
            gsCovD1 h (fun r => pd2 r w) i b x := by
    intro i j
    have hev : pd2 j (fun y => ∑ a : Fin 2, ∑ b : Fin 2, (h y)⁻¹ a b * pd2 a w y * pd2 b w y)
        =ᶠ[𝓝 x] (fun y => 2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h y)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a y * pd2 b w y) :=
      Filter.eventually_of_mem (hW.mem_nhds hx)
        (fun y hy => bl2_grad_Q W hW h hh hpos w hw y hy j)
    have h1 : pd2 i (pd2 j (fun y => ∑ a : Fin 2, ∑ b : Fin 2,
        (h y)⁻¹ a b * pd2 a w y * pd2 b w y)) x =
        pd2 i (fun y => 2 * ∑ a : Fin 2, ∑ b : Fin 2,
          (h y)⁻¹ a b * gsCovD1 h (fun r => pd2 r w) j a y * pd2 b w y) x := by
      show fderiv ℝ _ x (e2 i) = fderiv ℝ _ x (e2 i)
      rw [hev.fderiv_eq]
    rw [h1]
    simp only [bl2_grad_Q W hW h hh hpos w hw x hx]
    exact bl2_hess_V W hW h hh hpos w hw x hx i j
  rw [lap2]
  simp only [e7]
  have s60 := s6 0
  have s61 := s6 1
  have hg : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := G.2.1 x hx 1 0
  have hHx : ∀ a b : Fin 2, gsCovD1 h (fun r => pd2 r w) a b x =
      pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x := fun a b => rfl
  simp only [hHx]
  simp only [Fin.sum_univ_two] at s60 s61 ⊢
  simp only [hg] at s60 s61 ⊢
  linear_combination (2 * ((h x)⁻¹ 0 0 * pd2 0 w x + (h x)⁻¹ 0 1 * pd2 1 w x)) * s60 +
    (2 * ((h x)⁻¹ 0 1 * pd2 0 w x + (h x)⁻¹ 1 1 * pd2 1 w x)) * s61

theorem posDef_inv_quad_facts (A : Matrix (Fin 2) (Fin 2) ℝ) (hA : A.PosDef) :
    (∀ ξ : Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b ∧
      (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b = 0 → ξ = 0)) ∧
    (∀ H : Fin 2 → Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        A⁻¹ a c * A⁻¹ b d * H a b * H c d) :=
by
  have hB : A⁻¹.PosDef := hA.inv
  have hsym : A⁻¹ 1 0 = A⁻¹ 0 1 := by
    have h := hB.isHermitian.apply 0 1
    simpa using h
  have hp : 0 < A⁻¹ 0 0 := hB.diag_pos
  have hdet : 0 < A⁻¹.det := hB.det_pos
  rw [Matrix.det_fin_two, hsym] at hdet
  have hδ : 0 < A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2 := by nlinarith
  have key1 : ∀ ξ : Fin 2 → ℝ,
      A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) =
        (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1) ^ 2 +
          (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * ξ 1 ^ 2 := by
    intro ξ
    simp only [Fin.sum_univ_two, hsym]
    ring
  have key2 : ∀ H : Fin 2 → Fin 2 → ℝ,
      A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        A⁻¹ a c * A⁻¹ b d * H a b * H c d) =
        (A⁻¹ 0 0 ^ 2 * H 0 0 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 0 1 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 1 0
            + A⁻¹ 0 1 ^ 2 * H 1 1) ^ 2
          + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 0 1 + A⁻¹ 0 1 * H 1 1) ^ 2
          + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 1 0 + A⁻¹ 0 1 * H 1 1) ^ 2
          + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) ^ 2 * H 1 1 ^ 2 := by
    intro H
    simp only [Fin.sum_univ_two, hsym]
    ring
  refine ⟨fun ξ => ⟨?_, fun h0 => ?_⟩, fun H => ?_⟩
  · have h1 := key1 ξ
    have h2 : 0 ≤ A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) := by
      rw [h1]
      exact add_nonneg (sq_nonneg _) (mul_nonneg hδ.le (sq_nonneg _))
    exact nonneg_of_mul_nonneg_right h2 hp
  · have h1 := key1 ξ
    rw [h0, mul_zero] at h1
    have hs1 := sq_nonneg (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1)
    have hs2 := mul_nonneg hδ.le (sq_nonneg (ξ 1))
    have e1 : (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * ξ 1 ^ 2 = 0 := by linarith
    have hx1 : ξ 1 = 0 := by
      rcases mul_eq_zero.mp e1 with h | h
      · exact absurd h hδ.ne'
      · exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h
    have e2 : (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1) ^ 2 = 0 := by linarith
    rw [hx1, mul_zero, add_zero] at e2
    have e3 : A⁻¹ 0 0 * ξ 0 = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp e2
    have hx0 : ξ 0 = 0 := by
      rcases mul_eq_zero.mp e3 with h | h
      · exact absurd h hp.ne'
      · exact h
    funext i
    fin_cases i
    · simpa using hx0
    · simpa using hx1
  · have h1 := key2 H
    have h2 : 0 ≤ A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        A⁻¹ a c * A⁻¹ b d * H a b * H c d) := by
      rw [h1]
      exact add_nonneg (add_nonneg (add_nonneg (sq_nonneg _)
        (mul_nonneg hδ.le (sq_nonneg _))) (mul_nonneg hδ.le (sq_nonneg _)))
        (mul_nonneg (sq_nonneg _) (sq_nonneg _))
    exact nonneg_of_mul_nonneg_right h2 (pow_pos hp 2)

theorem esm_hopf_touching_super (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ) (w : E2 → ℝ) (hA : ∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) (hB : ∀ k : Fin 2, ContinuousOn (fun x => B x k) W) (hAs : ∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i) (hApos : ∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) (hw : ContDiffOn ℝ ∞ w W) (hnn : ∀ x ∈ W, 0 ≤ w x) (hsup : ∀ x ∈ W, ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x + ∑ k : Fin 2, B x k * pd2 k w x ≤ 0) (z x₁ : E2) (R : ℝ) (hR : 0 < R) (hball : Metric.closedBall z R ⊆ W) (hpos : ∀ x ∈ Metric.ball z R, 0 < w x) (hx₁ : dist x₁ z = R) (hw₁ : w x₁ = 0) : False :=
by
  
  have hconst : ∀ (W : Set E2) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ)
      (w c : E2 → ℝ), (∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) →
      (∀ k : Fin 2, ContinuousOn (fun x => B x k) W) →
      (∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) →
      ContinuousOn w W → ContinuousOn c W → ∀ (z : E2) (R : ℝ), 0 < R →
      Metric.closedBall z R ⊆ W → (∀ x ∈ Metric.ball z R, 0 < w x) →
      ∃ m₀ Λ β Γ m : ℝ, 0 < m₀ ∧ 0 ≤ Λ ∧ 0 ≤ β ∧ 0 ≤ Γ ∧ 0 < m ∧
        (∀ x : E2, R / 2 ≤ dist x z → dist x z ≤ R →
          m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j ∧
          (∀ i : Fin 2, |A x i i| ≤ Λ) ∧ (∀ k : Fin 2, |B x k| ≤ β) ∧ |c x| ≤ Γ) ∧
        ∀ x : E2, dist x z = R / 2 → m ≤ w x := by
    intro W A B w c hA hB hApos hwc hc z R hR hball hpos
    have P1 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
        (∀ x ∈ K, 0 < f x) → ∃ m : ℝ, 0 < m ∧ ∀ x ∈ K, m ≤ f x := by
      intro K f hK hf hfpos
      rcases Set.eq_empty_or_nonempty K with hK0 | hKne
      · refine ⟨1, one_pos, ?_⟩
        intro x hx
        rw [hK0] at hx
        exact absurd hx (Set.notMem_empty x)
      · obtain ⟨x₀, hx₀, hmin⟩ := hK.exists_isMinOn hKne hf
        exact ⟨f x₀, hfpos x₀ hx₀, fun x hx => hmin hx⟩
    have P2 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
        ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ K, |f x| ≤ C := by
      intro K f hK hf
      obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf
      refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
      have := hC x hx
      rw [Real.norm_eq_abs] at this
      exact le_trans this (le_max_left _ _)
    set K : Set E2 := {x | R / 2 ≤ dist x z ∧ dist x z ≤ R} with hKdef
    have hKcl : IsClosed K :=
      (isClosed_le continuous_const (continuous_id.dist continuous_const)).inter
        (isClosed_le (continuous_id.dist continuous_const) continuous_const)
    have hKsub : K ⊆ Metric.closedBall z R := fun x hx => Metric.mem_closedBall.mpr hx.2
    have hKc : IsCompact K := (isCompact_closedBall z R).of_isClosed_subset hKcl hKsub
    have hKW : K ⊆ W := hKsub.trans hball
    have hSc : IsCompact (Metric.sphere z (R / 2)) := isCompact_sphere z (R / 2)
    have hSball : Metric.sphere z (R / 2) ⊆ Metric.ball z R :=
      Metric.sphere_subset_ball (by linarith)
    have hSW : Metric.sphere z (R / 2) ⊆ W :=
      hSball.trans (Metric.ball_subset_closedBall.trans hball)
    have hcoord : ∀ i : Fin 2, Continuous (fun x : E2 => (x - z) i) := fun i =>
      (PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) i).comp (continuous_id.sub continuous_const)
