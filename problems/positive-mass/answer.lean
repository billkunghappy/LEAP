        intro z hz
        by_contra hneg
        push_neg at hneg
        have hO : IsOpen (interior N ∩ (Metric.ball y₀ ρ ∩
            (fun z => (if s ⟨0, hk⟩ then (1 : ℝ) else -1) * f ⟨0, hk⟩ z) ⁻¹' Set.Iio 0)) :=
          isOpen_interior.inter (hcont.isOpen_inter_preimage Metric.isOpen_ball isOpen_Iio)
