      have hK2 : 0 ≤ (1 + A) ^ 2 * t * τ := by positivity
      have f5 : A * t * ((1 + A) ^ 2 * t * τ) ≤ 1 / 1000 * ((1 + A) ^ 2 * t * τ) :=
        mul_le_mul_of_nonneg_right hAt hK2
      have f6 : t * τ ≤ (1 + A) ^ 2 * t * τ := by nlinarith
      nlinarith
    
    set Q := ∑ i, ∑ j, H i j * p i * p j with hQdef
    set a1 := ∑ i, ∑ j, H i j * (-(2 * τ * M i j) - ∑ k, Γ k i j * p k) with ha1def
