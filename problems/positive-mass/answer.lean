    have hA : volume (Metric.ball (0 : E2) (1 / 4)) ≠ ⊤ := measure_ball_lt_top.ne
    have hB : volume ({x | ℓ x < υ x} ∩ Metric.ball (0 : E2) (1 / 4)) ≠ ⊤ :=
      ne_top_of_le_ne_top hA (measure_mono Set.inter_subset_right)
    exact ENNReal.add_ne_top.2 ⟨hA, ENNReal.mul_ne_top ENNReal.ofNat_ne_top hB⟩
  
  have hkey : ∀ η : ℝ, 0 < η →
      ENNReal.ofReal ((9 / 10) * ((volume (Metric.ball (0 : E2) (1 / 4)) +
        2 * volume ({x | ℓ x < υ x} ∩ Metric.ball (0 : E2) (1 / 4))).toReal - η)) ≤
        sepPerG G F (hpCyl (1 / 4) (1 / 4)) := by
    intro η hη
    obtain ⟨n, hn⟩ := hpSL_sup_limit I {x | ℓ x < υ x} hImeas hb7 hT7 (η / 2) (by linarith)
    obtain ⟨c, hcs, hc0, hc1, hcc, hct, hcI⟩ :=
      hpSL_bump_select n I hImeas hb8 (η / 2) (by linarith)
    obtain ⟨hΨs, hΨc, hΨt, hΨ1, hΨint⟩ := hpSL_product_field F hF (n + 1) c ψ
      (fun z => ∑ k ∈ Finset.range (n + 1), c k (hpProj z) * ψ k (z 0)) (fun z => rfl)
      hcs hc0 hc1 hcc hct (fun k => (hψprop k).1) (fun k => (hψprop k).2.1)
      (fun k => (hψprop k).2.2)
    have hcal := hpSL_calib G F hG hclose _ hΨs hΨc hΨt hΨ1
    refine le_trans (ENNReal.ofReal_le_ofReal ?_) hcal
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    rw [hΨint]
    have heq : (∫ x, ∑ k ∈ Finset.range (n + 1), c k x * hpSliceInt {t | hpLift t x ∈ F} (ψ k)) =
        ∫ x, ∑ k ∈ Finset.range (n + 1), c k x * I k x := by
      simp only [hIdef]
    rw [heq]
    linarith
  
  set X := volume (Metric.ball (0 : E2) (1 / 4)) +
    2 * volume ({x | ℓ x < υ x} ∩ Metric.ball (0 : E2) (1 / 4)) with hXdef
  rw [show ENNReal.ofReal (9 / 10) * X = ENNReal.ofReal ((9 / 10) * X.toReal) by
    rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_toReal hXfin]]
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  have hε' : (0 : ℝ) < ε := NNReal.coe_pos.2 hε
  calc ENNReal.ofReal ((9 / 10) * X.toReal)
      ≤ ENNReal.ofReal ((9 / 10) * (X.toReal - ε) + ε) :=
        ENNReal.ofReal_le_ofReal (by linarith)
    _ ≤ ENNReal.ofReal ((9 / 10) * (X.toReal - ε)) + ENNReal.ofReal ε := ENNReal.ofReal_add_le
    _ ≤ sepPerG G F (hpCyl (1 / 4) (1 / 4)) + ε := by
        rw [ENNReal.ofReal_coe_nnreal]
        gcongr
        exact hkey ε hε'

theorem hpDensDiv_calculus (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (O : Set E3) (Y : E3 → E3)
    (hO : IsOpen O) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) O)
    (hdet : ∀ z ∈ O, 0 < (G z).det) (hY : ContDiff ℝ ∞ Y) (hYc : HasCompactSupport Y)
    (hYO : tsupport Y ⊆ O) :
    (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Y z i)) ∧
    Continuous (sepDensDiv G Y) ∧ HasCompactSupport (sepDensDiv G Y) ∧
    ∀ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ → ∀ z : E3,
      sepDensDiv G (fun w => ψ w • Y w) z =
        ψ z * sepDensDiv G Y z + Real.sqrt (G z).det * fderiv ℝ ψ z (Y z) :=
by
  have h0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  have hw : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Y z i) := by
    intro i
    have hYi : ContDiff ℝ ∞ (fun z => Y z i) :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hY
    have hdetC : ContDiffOn ℝ ∞ (fun z => (G z).det) O := by
      have hfe : (fun z => (G z).det) = fun z =>
          G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
            - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
            + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 := by
        funext z
        exact Matrix.det_fin_three _
      rw [hfe]
      exact (((((((hG 0 0).mul (hG 1 1)).mul (hG 2 2)).sub
        (((hG 0 0).mul (hG 1 2)).mul (hG 2 1))).sub
        (((hG 0 1).mul (hG 1 0)).mul (hG 2 2))).add
        (((hG 0 1).mul (hG 1 2)).mul (hG 2 0))).add
        (((hG 0 2).mul (hG 1 0)).mul (hG 2 1))).sub
        (((hG 0 2).mul (hG 1 1)).mul (hG 2 0))
    have hs : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) O :=
      hdetC.sqrt (fun z hz => (hdet z hz).ne')
    have hc : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det * Y z i) O :=
      hs.mul hYi.contDiffOn
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ O
    · exact hc.contDiffAt (hO.mem_nhds hz)
    · have hzt : z ∉ tsupport Y := fun h => hz (hYO h)
      have hev : Y =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hzt
      have hev' : (fun z => Real.sqrt (G z).det * Y z i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
        filter_upwards [hev] with w hw
        simp [hw]
      exact (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq hev'
  
  have hcont : Continuous (sepDensDiv G Y) := by
    have hfe : sepDensDiv G Y = fun z => ∑ i : Fin 3,
        fderiv ℝ (fun z => Real.sqrt (G z).det * Y z i) z (e i) := by
      funext z
      simp only [sepDensDiv, partialDeriv]
    rw [hfe]
    exact continuous_finset_sum _ fun i _ =>
      ((hw i).continuous_fderiv h0).clm_apply continuous_const
  
  have hsupp : HasCompactSupport (sepDensDiv G Y) := by
    refine HasCompactSupport.mono' hYc ?_
    intro z hz
    by_contra hzt
    apply hz
    have hev : Y =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hzt
    simp only [sepDensDiv, partialDeriv]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev' : (fun z => Real.sqrt (G z).det * Y z i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
      filter_upwards [hev] with w hw
      simp [hw]
    rw [hev'.fderiv_eq]
    simp
  
  refine ⟨hw, hcont, hsupp, ?_⟩
  intro ψ hψ z
  have hψd : DifferentiableAt ℝ ψ z := hψ.differentiable h0 z
  have hwd : ∀ i : Fin 3, DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * Y w i) z :=
    fun i => (hw i).differentiable h0 z
  have hfun : ∀ i : Fin 3, (fun w => Real.sqrt (G w).det * (ψ w • Y w) i) =
      fun w => ψ w * (Real.sqrt (G w).det * Y w i) := by
    intro i
    funext w
    simp only [PiLp.smul_apply, smul_eq_mul]
    ring
  have hder : ∀ i : Fin 3, fderiv ℝ (fun w => Real.sqrt (G w).det * (ψ w • Y w) i) z (e i) =
      ψ z * fderiv ℝ (fun w => Real.sqrt (G w).det * Y w i) z (e i) +
        Real.sqrt (G z).det * (Y z i * fderiv ℝ ψ z (e i)) := by
    intro i
    rw [hfun i, fderiv_fun_mul hψd (hwd i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hY3 : Y z = Y z 0 • e 0 + Y z 1 • e 1 + Y z 2 • e 2 := by
    ext j
    fin_cases j <;> simp [e, EuclideanSpace.single_apply]
  have hexp : fderiv ℝ ψ z (Y z) = ∑ i : Fin 3, Y z i * fderiv ℝ ψ z (e i) := by
    conv_lhs => rw [hY3]
    simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_three]
  simp only [sepDensDiv, partialDeriv]
  rw [Finset.sum_congr rfl (fun i _ => hder i), Finset.sum_add_distrib, hexp,
    ← Finset.mul_sum, ← Finset.mul_sum]

theorem hpNearId_algebra (A : Matrix (Fin 3) (Fin 3) ℝ) (hA : ∀ i j, A i j = A j i)
    (hc : ∀ i j : Fin 3, |A i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) :
    (24 / 25 ≤ A.det ∧ A.det ≤ 26 / 25) ∧
    (∀ v : E3, ‖v‖ ^ 2 ≤ (100 / 97) * ∑ i : Fin 3, ∑ j : Fin 3, A i j * v i * v j) ∧
    (∀ v : E3, ∑ i : Fin 3, ∑ j : Fin 3, A i j * v i * v j ≤ 1 → A.det * (v 0) ^ 2 ≤ (101 / 100) ^ 2) :=
by
  have key : ∀ a b c d e f : ℝ, |a - 1| ≤ 1 / 100 → |b| ≤ 1 / 100 → |c| ≤ 1 / 100 →
      |d - 1| ≤ 1 / 100 → |e| ≤ 1 / 100 → |f - 1| ≤ 1 / 100 →
      (24 / 25 ≤ a * d * f - a * e ^ 2 - f * b ^ 2 - d * c ^ 2 + 2 * b * c * e ∧
        a * d * f - a * e ^ 2 - f * b ^ 2 - d * c ^ 2 + 2 * b * c * e ≤ 26 / 25) ∧
      (∀ x y z : ℝ, x ^ 2 + y ^ 2 + z ^ 2 ≤ (100 / 97) *
        (a * x ^ 2 + d * y ^ 2 + f * z ^ 2 + 2 * b * x * y + 2 * c * x * z + 2 * e * y * z)) ∧
      (∀ x y z : ℝ,
        a * x ^ 2 + d * y ^ 2 + f * z ^ 2 + 2 * b * x * y + 2 * c * x * z + 2 * e * y * z ≤ 1 →
        (a * d * f - a * e ^ 2 - f * b ^ 2 - d * c ^ 2 + 2 * b * c * e) * x ^ 2 ≤
          (101 / 100) ^ 2) := by
    intro a b c d e f ha hb hc' hd he hf
    obtain ⟨ha1, ha2⟩ := abs_le.mp ha
    obtain ⟨hb1, hb2⟩ := abs_le.mp hb
    obtain ⟨hc1, hc2⟩ := abs_le.mp hc'
    obtain ⟨hd1, hd2⟩ := abs_le.mp hd
    obtain ⟨he1, he2⟩ := abs_le.mp he
    obtain ⟨hf1, hf2⟩ := abs_le.mp hf
    have pad1 : 9801 / 10000 ≤ a * d := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ a - 99 / 100 by linarith)
        (show (0:ℝ) ≤ d - 99 / 100 by linarith)]
    have pad2 : a * d ≤ 10201 / 10000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 101 / 100 - a by linarith)
        (show (0:ℝ) ≤ d by linarith)]
    have padf1 : 970299 / 1000000 ≤ a * d * f := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ a * d - 9801 / 10000 by linarith)
        (show (0:ℝ) ≤ f - 99 / 100 by linarith)]
    have padf2 : a * d * f ≤ 1030301 / 1000000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 10201 / 10000 - a * d by linarith)
        (show (0:ℝ) ≤ f by linarith)]
    have pdf1 : 9801 / 10000 ≤ d * f := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ d - 99 / 100 by linarith)
        (show (0:ℝ) ≤ f - 99 / 100 by linarith)]
    have pdf2 : d * f ≤ 10201 / 10000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 101 / 100 - d by linarith)
        (show (0:ℝ) ≤ f by linarith)]
    have pe2 : e ^ 2 ≤ 1 / 10000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 1 / 100 - e by linarith)
        (show (0:ℝ) ≤ 1 / 100 + e by linarith)]
    have pb2 : b ^ 2 ≤ 1 / 10000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 1 / 100 - b by linarith)
        (show (0:ℝ) ≤ 1 / 100 + b by linarith)]
    have pc2 : c ^ 2 ≤ 1 / 10000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 1 / 100 - c by linarith)
        (show (0:ℝ) ≤ 1 / 100 + c by linarith)]
    have pae0 : 0 ≤ a * e ^ 2 := mul_nonneg (by linarith) (sq_nonneg e)
    have pfb0 : 0 ≤ f * b ^ 2 := mul_nonneg (by linarith) (sq_nonneg b)
    have pdc0 : 0 ≤ d * c ^ 2 := mul_nonneg (by linarith) (sq_nonneg c)
    have pae1 : a * e ^ 2 ≤ 101 / 1000000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 101 / 100 - a by linarith) (sq_nonneg e)]
    have pfb1 : f * b ^ 2 ≤ 101 / 1000000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 101 / 100 - f by linarith) (sq_nonneg b)]
    have pdc1 : d * c ^ 2 ≤ 101 / 1000000 := by
      nlinarith [mul_nonneg (show (0:ℝ) ≤ 101 / 100 - d by linarith) (sq_nonneg c)]
    have pbce : |b * c * e| ≤ 1 / 100 * (1 / 100) * (1 / 100) := by
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul hb hc' (abs_nonneg _) (by norm_num)) he (abs_nonneg _)
        (by norm_num)
    obtain ⟨pbce1, pbce2⟩ := abs_le.mp pbce
    refine ⟨⟨by linarith, by linarith⟩, ?_, ?_⟩
    · intro x y z
      have hQ : (97 / 100) * (x ^ 2 + y ^ 2 + z ^ 2) ≤
          a * x ^ 2 + d * y ^ 2 + f * z ^ 2 + 2 * b * x * y + 2 * c * x * z + 2 * e * y * z := by
        nlinarith [mul_nonneg (show (0:ℝ) ≤ a - 1 + 1 / 100 by linarith) (sq_nonneg x),
          mul_nonneg (show (0:ℝ) ≤ d - 1 + 1 / 100 by linarith) (sq_nonneg y),
          mul_nonneg (show (0:ℝ) ≤ f - 1 + 1 / 100 by linarith) (sq_nonneg z),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 + b by linarith) (sq_nonneg (x + y)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 - b by linarith) (sq_nonneg (x - y)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 + c by linarith) (sq_nonneg (x + z)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 - c by linarith) (sq_nonneg (x - z)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 + e by linarith) (sq_nonneg (y + z)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 - e by linarith) (sq_nonneg (y - z))]
      linarith
    · intro x y z hQ1
      have key2 : ∀ p q : ℝ, 0 ≤ f * p ^ 2 - 2 * e * p * q + d * q ^ 2 := by
        intro p q
        nlinarith [mul_nonneg (show (0:ℝ) ≤ f - 1 / 100 by linarith) (sq_nonneg p),
          mul_nonneg (show (0:ℝ) ≤ d - 1 / 100 by linarith) (sq_nonneg q),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 - e by linarith) (sq_nonneg (p + q)),
          mul_nonneg (show (0:ℝ) ≤ 1 / 100 + e by linarith) (sq_nonneg (p - q))]
      have hS := key2 (d * y + e * z + b * x) (e * y + f * z + c * x)
      have hid : (d * f - e ^ 2) *
            (a * x ^ 2 + d * y ^ 2 + f * z ^ 2 + 2 * b * x * y + 2 * c * x * z + 2 * e * y * z)
            - (a * d * f - a * e ^ 2 - f * b ^ 2 - d * c ^ 2 + 2 * b * c * e) * x ^ 2 =
          f * (d * y + e * z + b * x) ^ 2 - 2 * e * (d * y + e * z + b * x) * (e * y + f * z + c * x)
            + d * (e * y + f * z + c * x) ^ 2 := by ring
      have hC0 : 0 ≤ d * f - e ^ 2 := by linarith
      have hCQ := mul_nonneg hC0 (sub_nonneg.2 hQ1)
      nlinarith [hid, hS, hCQ, pdf2, sq_nonneg e]
  have hdet : A.det = A 0 0 * A 1 1 * A 2 2 - A 0 0 * A 1 2 ^ 2 - A 2 2 * A 0 1 ^ 2
      - A 1 1 * A 0 2 ^ 2 + 2 * A 0 1 * A 0 2 * A 1 2 := by
    rw [Matrix.det_fin_three, hA 1 0, hA 2 0, hA 2 1]; ring
  have hQ : ∀ v : E3, ∑ i : Fin 3, ∑ j : Fin 3, A i j * v i * v j =
      A 0 0 * v 0 ^ 2 + A 1 1 * v 1 ^ 2 + A 2 2 * v 2 ^ 2 + 2 * A 0 1 * v 0 * v 1
        + 2 * A 0 2 * v 0 * v 2 + 2 * A 1 2 * v 1 * v 2 := by
    intro v
    simp only [Fin.sum_univ_three]
    rw [hA 1 0, hA 2 0, hA 2 1]; ring
  have hN : ∀ v : E3, ‖v‖ ^ 2 = v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by
    intro v
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have h00 : |A 0 0 - 1| ≤ 1 / 100 := by simpa using hc 0 0
  have h11 : |A 1 1 - 1| ≤ 1 / 100 := by simpa using hc 1 1
  have h22 : |A 2 2 - 1| ≤ 1 / 100 := by simpa using hc 2 2
  have h01 : |A 0 1| ≤ 1 / 100 := by simpa using hc 0 1
  have h02 : |A 0 2| ≤ 1 / 100 := by simpa using hc 0 2
  have h12 : |A 1 2| ≤ 1 / 100 := by simpa using hc 1 2
  obtain ⟨k1, k2, k3⟩ := key (A 0 0) (A 0 1) (A 0 2) (A 1 1) (A 1 2) (A 2 2)
    h00 h01 h02 h11 h12 h22
  refine ⟨?_, ?_, ?_⟩
  · rw [hdet]; exact k1
  · intro v
    rw [hN v, hQ v]
    exact k2 (v 0) (v 1) (v 2)
  · intro v hv
    rw [hQ v] at hv
    rw [hdet]
    exact k3 (v 0) (v 1) (v 2) hv

theorem hpHalf_flux_identity (w : Fin 3 → E3 → ℝ) (a : ℝ) (hw : ∀ i, ContDiff ℝ 1 (w i))
    (hwc : ∀ i, HasCompactSupport (w i)) :
    ∫ z in {z : E3 | z 0 < a}, ∑ i : Fin 3, partialDeriv i (w i) z = ∫ x : E2, w 0 (hpLift a x) :=
by
  
  have hcoord : ∀ (t : ℝ) (x : E2),
      hpLift t x = (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x) : Fin 3 → ℝ) : E3) := by
    intro t x
    ext j
    fin_cases j <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply] <;> rfl
  have hc0 : ∀ (t : ℝ) (x : E2), (hpLift t x) 0 = t := by
    intro t x; simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hc1 : ∀ (t : ℝ) (x : E2), (hpLift t x) 1 = x 0 := by
    intro t x; simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hc2 : ∀ (t : ℝ) (x : E2), (hpLift t x) 2 = x 1 := by
    intro t x; simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hnorm : ∀ (t : ℝ) (x : E2), ‖hpLift t x‖ ^ 2 = t ^ 2 + ‖x‖ ^ 2 := by
    intro t x
    rw [EuclideanSpace.norm_sq_eq (hpLift t x), EuclideanSpace.norm_sq_eq x, Fin.sum_univ_three,
      Fin.sum_univ_two, hc0, hc1, hc2]
    simp only [Real.norm_eq_abs, sq_abs]
    ring
  
  have hfun : (fun p : E2 × ℝ => hpLift p.2 p.1) =
      (WithLp.toLp 2 ∘ (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm ∘
        Prod.swap ∘ Prod.map WithLp.ofLp id) := by
    funext p
    rw [hcoord]
    simp [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply,
      Fin.insertNth_zero'] <;> rfl
  have hΘ : MeasureTheory.MeasurePreserving (fun p : E2 × ℝ => hpLift p.2 p.1)
      (volume.prod volume) volume := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin 2)).prod
      (MeasureTheory.MeasurePreserving.id (volume : Measure ℝ))
    have h2 := MeasureTheory.Measure.measurePreserving_swap
      (μ := (volume : Measure (Fin 2 → ℝ))) (ν := (volume : Measure ℝ))
    have h3 := MeasureTheory.MeasurePreserving.symm
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
      (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
    have h4 := PiLp.volume_preserving_toLp (Fin 3)
    have H := h4.comp (h3.comp (h2.comp h1))
    rw [hfun]
    exact H
  have hemb : MeasurableEmbedding (fun p : E2 × ℝ => hpLift p.2 p.1) := by
    rw [hfun]
    exact (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).measurableEmbedding.comp
      ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm.measurableEmbedding.comp
        (MeasurableEquiv.prodComm.measurableEmbedding.comp
          (MeasurableEmbedding.prodMap (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.measurableEmbedding
            MeasurableEmbedding.id)))
  
  have hH : MeasurableSet {z : E3 | z 0 < a} :=
    (isOpen_lt (by fun_prop) continuous_const).measurableSet
  have hfub : ∀ F : E3 → ℝ, Integrable F →
      (∫ z in {z : E3 | z 0 < a}, F z = ∫ x : E2, ∫ t in Set.Iio a, F (hpLift t x)) ∧
      (∫ z in {z : E3 | z 0 < a}, F z = ∫ t in Set.Iio a, ∫ x : E2, F (hpLift t x)) := by
    intro F hF
    have hpt : ∀ p : E2 × ℝ, {z : E3 | z 0 < a}.indicator F (hpLift p.2 p.1) =
        (Set.Iio a).indicator (fun s => F (hpLift s p.1)) p.2 := by
      intro p
      by_cases h : p.2 < a
      · rw [Set.indicator_of_mem (show hpLift p.2 p.1 ∈ {z : E3 | z 0 < a} by simp [hc0, h]),
          Set.indicator_of_mem (show p.2 ∈ Set.Iio a from h)]
      · rw [Set.indicator_of_notMem (show hpLift p.2 p.1 ∉ {z : E3 | z 0 < a} by simp [hc0, h]),
          Set.indicator_of_notMem (show p.2 ∉ Set.Iio a from h)]
    have hG : Integrable (fun p : E2 × ℝ => (Set.Iio a).indicator (fun s => F (hpLift s p.1)) p.2)
        (volume.prod volume) := by
      have := (hΘ.integrable_comp_emb hemb).2 (hF.indicator hH)
      refine this.congr (Filter.Eventually.of_forall fun p => ?_)
      exact hpt p
    have hpull : ∫ z in {z : E3 | z 0 < a}, F z =
        ∫ p : E2 × ℝ, (Set.Iio a).indicator (fun s => F (hpLift s p.1)) p.2 ∂(volume.prod volume) := by
      rw [← integral_indicator hH, ← hΘ.integral_comp hemb]
      exact integral_congr_ae (Filter.Eventually.of_forall hpt)
    refine ⟨?_, ?_⟩
    · rw [hpull, integral_prod _ hG]
      congr 1
      funext x
      exact integral_indicator measurableSet_Iio
    · rw [hpull, integral_prod_symm _ hG]
      have hin : ∀ t : ℝ, ∫ x : E2, (Set.Iio a).indicator (fun s => F (hpLift s x)) t =
          (Set.Iio a).indicator (fun s => ∫ x : E2, F (hpLift s x)) t := by
        intro t
        by_cases h : t < a
        · simp [Set.indicator_of_mem (show t ∈ Set.Iio a from h)]
        · simp [Set.indicator_of_notMem (show t ∉ Set.Iio a from h)]
      simp_rw [hin]
      exact integral_indicator measurableSet_Iio
  
  have htan : ∀ v : E3 → ℝ, ContDiff ℝ 1 v → HasCompactSupport v → ∀ (t : ℝ) (j : Fin 3), j ≠ 0 →
      ∫ x : E2, partialDeriv j v (hpLift t x) = 0 := by
    intro v hv hvc t j hj
    let L : E2 →L[ℝ] E3 := (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1) +
      (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 2)
    have hL : ∀ x : E2, hpLift t x = t • e 0 + L x := by
      intro x; ext k; fin_cases k <;> simp [L, hpLift, cylPt, e, EuclideanSpace.single_apply]
    have hdv : Differentiable ℝ v := hv.differentiable one_ne_zero
    have hfe : (fun x : E2 => v (hpLift t x)) = v ∘ (fun y : E2 => t • e 0 + L y) := by
      funext y; simp only [Function.comp, hL y]
    have hgfd : ∀ x, HasFDerivAt (fun x : E2 => v (hpLift t x))
        ((fderiv ℝ v (hpLift t x)).comp L) x := by
      intro x
      have h1 : HasFDerivAt (fun y : E2 => t • e 0 + L y) L x := L.hasFDerivAt.const_add _
      have h2 := (hdv (t • e 0 + L x)).hasFDerivAt
      have h3 := h2.comp x h1
      rw [hfe, hL x]
      exact h3
    have hgd : ∀ x u, fderiv ℝ (fun x : E2 => v (hpLift t x)) x u =
        fderiv ℝ v (hpLift t x) (L u) := fun x u => by
      rw [(hgfd x).fderiv]; rfl
    have hgC : ContDiff ℝ 1 (fun x : E2 => v (hpLift t x)) := by
      rw [hfe]; exact hv.comp (contDiff_const.add L.contDiff)
    obtain ⟨R, hR⟩ := hvc.isCompact.isBounded.subset_closedBall 0
    have hgc : HasCompactSupport (fun x : E2 => v (hpLift t x)) := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : E2) R) ?_
      intro x hx
      rw [mem_closedBall_zero_iff, not_le] at hx
      have hle : ‖x‖ ≤ ‖hpLift t x‖ := by
        nlinarith [hnorm t x, norm_nonneg x, norm_nonneg (hpLift t x), sq_nonneg t]
      apply image_eq_zero_of_notMem_tsupport
      intro hm
      have := hR hm
      rw [mem_closedBall_zero_iff] at this
      linarith
    obtain ⟨u, hu⟩ : ∃ u : E2, L u = e j := by
      fin_cases j
      · exact (hj rfl).elim
      · exact ⟨e2 0, by ext k; fin_cases k <;> simp [L, e, e2, EuclideanSpace.single_apply]⟩
      · exact ⟨e2 1, by ext k; fin_cases k <;> simp [L, e, e2, EuclideanSpace.single_apply]⟩
    have hint_eq : (fun x => partialDeriv j v (hpLift t x)) =
        fun x => (fun _ : E2 => (1 : ℝ)) x * fderiv ℝ (fun x : E2 => v (hpLift t x)) x u := by
      funext x; rw [one_mul, hgd, hu]; rfl
    rw [hint_eq]
    have hcontg : Continuous (fun x => fderiv ℝ (fun x : E2 => v (hpLift t x)) x u) :=
      (hgC.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hcsg : HasCompactSupport (fun x => fderiv ℝ (fun x : E2 => v (hpLift t x)) x u) :=
      (hgc.fderiv ℝ).comp_left (g := fun T : E2 →L[ℝ] ℝ => T u) (by simp)
    rw [integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : E2 => (1 : ℝ)) (g := fun x : E2 => v (hpLift t x)) (v := u) ?_ ?_ ?_
      (differentiable_const _) (hgC.differentiable one_ne_zero)]
    · simp
    · simp
    · simpa using hcontg.integrable_of_hasCompactSupport hcsg
    · simpa using hgC.continuous.integrable_of_hasCompactSupport hgc
  
  have hnor : ∀ v : E3 → ℝ, ContDiff ℝ 1 v → HasCompactSupport v → ∀ x : E2,
      ∫ t in Set.Iio a, partialDeriv 0 v (hpLift t x) = v (hpLift a x) := by
    intro v hv hvc x
    have hA : ∀ t : ℝ, hpLift t x = t • e 0 + hpLift 0 x := by
      intro t; ext k; fin_cases k <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
    have hdv : Differentiable ℝ v := hv.differentiable one_ne_zero
    have hfe : (fun s => v (hpLift s x)) = v ∘ (fun s : ℝ => s • e 0 + hpLift 0 x) := by
      funext s; simp only [Function.comp, ← hA s]
    have hder : ∀ t : ℝ, HasDerivAt (fun s => v (hpLift s x)) (partialDeriv 0 v (hpLift t x)) t := by
      intro t
      have h1 : HasDerivAt (fun s : ℝ => s • e 0 + hpLift 0 x) (e 0) t := by
        simpa using ((hasDerivAt_id t).smul_const (e 0)).add_const (hpLift 0 x)
      have h2 := (hdv (t • e 0 + hpLift 0 x)).hasFDerivAt.comp_hasDerivAt t h1
      rw [hfe, hA t]
      exact h2
    obtain ⟨R, hR⟩ := hvc.isCompact.isBounded.subset_closedBall 0
    have hout : ∀ t : ℝ, R < |t| → hpLift t x ∉ tsupport v := by
      intro t ht hm
      have := hR hm
      rw [mem_closedBall_zero_iff] at this
      have hle : |t| ≤ ‖hpLift t x‖ := by
        nlinarith [hnorm t x, norm_nonneg x, norm_nonneg (hpLift t x), sq_abs t, abs_nonneg t]
      linarith
    have hcont : Continuous (fun t : ℝ => partialDeriv 0 v (hpLift t x)) := by
      have hc : Continuous (fun t : ℝ => hpLift t x) := by
        have : (fun t : ℝ => hpLift t x) = fun t => t • e 0 + hpLift 0 x := funext hA
        rw [this]; fun_prop
      exact ((hv.continuous_fderiv one_ne_zero).comp hc).clm_apply continuous_const
    have hcs : HasCompactSupport (fun t : ℝ => partialDeriv 0 v (hpLift t x)) := by
      refine HasCompactSupport.intro (isCompact_Icc (a := -(|R| + 1)) (b := |R| + 1)) ?_
      intro t ht
      have ht' : R < |t| := by
        rw [Set.mem_Icc, not_and_or, not_le, not_le] at ht
        rcases ht with h | h
        · rw [abs_of_neg (by linarith [abs_nonneg R])]; linarith [le_abs_self R]
        · rw [abs_of_pos (by linarith [abs_nonneg R])]; linarith [le_abs_self R]
      have : hpLift t x ∉ tsupport (fderiv ℝ v) := fun h => hout t ht' (tsupport_fderiv_subset ℝ h)
      simp [partialDeriv, image_eq_zero_of_notMem_tsupport this]
    have hlim : Tendsto (fun s => v (hpLift s x)) atBot (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Filter.eventually_le_atBot (-(|R| + 1))] with s hs
      have : R < |s| := by
        rw [abs_of_neg (by linarith [abs_nonneg R])]; linarith [le_abs_self R]
      exact (image_eq_zero_of_notMem_tsupport (hout s this)).symm
    rw [← integral_Iic_eq_integral_Iio,
      integral_Iic_of_hasDerivAt_of_tendsto' (fun t _ => hder t)
        (hcont.integrable_of_hasCompactSupport hcs).integrableOn hlim]
    simp
  
  have hint : ∀ i j : Fin 3, Integrable (fun z => partialDeriv j (w i) z) := by
    intro i j
    have hc : Continuous (fun z => partialDeriv j (w i) z) :=
      ((hw i).continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hs : HasCompactSupport (fun z => partialDeriv j (w i) z) :=
      ((hwc i).fderiv ℝ).comp_left (g := fun T : E3 →L[ℝ] ℝ => T (e j)) (by simp)
    exact hc.integrable_of_hasCompactSupport hs
  
  rw [integral_finset_sum Finset.univ (fun i _ => (hint i i).integrableOn), Fin.sum_univ_three]
  have h0 : ∫ z in {z : E3 | z 0 < a}, partialDeriv 0 (w 0) z = ∫ x : E2, w 0 (hpLift a x) := by
    rw [(hfub _ (hint 0 0)).1]
    congr 1
    funext x
    exact hnor (w 0) (hw 0) (hwc 0) x
  have h1 : ∫ z in {z : E3 | z 0 < a}, partialDeriv 1 (w 1) z = 0 := by
    rw [(hfub _ (hint 1 1)).2]
    simp [htan (w 1) (hw 1) (hwc 1) _ 1 (by decide)]
  have h2 : ∫ z in {z : E3 | z 0 < a}, partialDeriv 2 (w 2) z = 0 := by
    rw [(hfub _ (hint 2 2)).2]
    simp [htan (w 2) (hw 2) (hwc 2) _ 2 (by decide)]
  rw [h0, h1, h2]
  ring

theorem hpHalf_flux_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Z : E3 → E3) (a ρ : ℝ)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (Metric.ball (0 : E3) 1))
    (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i)
    (hclose : ∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100)
    (hρ : 0 < ρ) (hZ : ContDiff ℝ ∞ Z) (hZc : HasCompactSupport Z)
    (hZs : tsupport Z ⊆ Metric.ball (0 : E3) 1 ∩ {z : E3 | z 1 ^ 2 + z 2 ^ 2 < ρ ^ 2})
    (hZG : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1) :
    ∫ z in {z : E3 | z 0 < a}, sepDensDiv G Z z ≤
      (101 / 100) * (volume (Metric.ball (0 : E2) ρ)).toReal :=
by
  
  have hdet : ∀ z ∈ Metric.ball (0 : E3) 1, 0 < (G z).det := fun z hz =>
    lt_of_lt_of_le (by norm_num) (hpNearId_algebra (G z) (hsymm z) (hclose z hz)).1.1
  
  have hw : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Z z i) := by
    intro i
    have hZi : ContDiff ℝ ∞ (fun z => Z z i) :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hZ
    have hdetC : ContDiffOn ℝ ∞ (fun z => (G z).det) (Metric.ball (0 : E3) 1) := by
      have hfe : (fun z => (G z).det) = fun z =>
          G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
            - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
            + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 := by
        funext z
        exact Matrix.det_fin_three _
      rw [hfe]
      exact (((((((hG 0 0).mul (hG 1 1)).mul (hG 2 2)).sub
        (((hG 0 0).mul (hG 1 2)).mul (hG 2 1))).sub
        (((hG 0 1).mul (hG 1 0)).mul (hG 2 2))).add
        (((hG 0 1).mul (hG 1 2)).mul (hG 2 0))).add
        (((hG 0 2).mul (hG 1 0)).mul (hG 2 1))).sub
        (((hG 0 2).mul (hG 1 1)).mul (hG 2 0))
    have hs : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) (Metric.ball (0 : E3) 1) :=
      hdetC.sqrt (fun z hz => (hdet z hz).ne')
    have hc : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det * Z z i) (Metric.ball (0 : E3) 1) :=
      hs.mul hZi.contDiffOn
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ Metric.ball (0 : E3) 1
    · exact hc.contDiffAt (Metric.isOpen_ball.mem_nhds hz)
    · have hzt : z ∉ tsupport Z := fun h => hz (hZs h).1
      have hev : Z =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hzt
      have hev' : (fun z => Real.sqrt (G z).det * Z z i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
        filter_upwards [hev] with y hy
        simp [hy]
      exact (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq hev'
  have hwc : ∀ i : Fin 3, HasCompactSupport (fun z => Real.sqrt (G z).det * Z z i) := by
    intro i
    refine HasCompactSupport.mono' hZc ?_
    intro z hz
    apply subset_tsupport
    intro h
    apply hz
    simp [h]
  
  have hflux := hpHalf_flux_identity (fun i z => Real.sqrt (G z).det * Z z i) a
    (fun i => (hw i).of_le (by exact_mod_cast le_top)) hwc
  have hLHS : (∫ z in {z : E3 | z 0 < a}, sepDensDiv G Z z) =
      ∫ x : E2, Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0 := hflux
  
  have hpt : ∀ x : E2, Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0 ≤
      (Metric.ball (0 : E2) ρ).indicator (fun _ => (101 / 100 : ℝ)) x := by
    intro x
    by_cases h0 : Z (hpLift a x) 0 = 0
    · rw [h0, mul_zero]
      exact Set.indicator_nonneg (fun _ _ => by norm_num) x
    · have hZne : Z (hpLift a x) ≠ 0 := fun h => h0 (by rw [h]; rfl)
      have hmem : hpLift a x ∈ tsupport Z := subset_tsupport _ hZne
      obtain ⟨hB, hcyl⟩ := hZs hmem
      have h1 : (hpLift a x) 1 = x 0 := by
        simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
      have h2 : (hpLift a x) 2 = x 1 := by
        simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
      have hn : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
        rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
          Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs]
      have hx : x ∈ Metric.ball (0 : E2) ρ := by
        rw [mem_ball_zero_iff]
        have hc : (hpLift a x) 1 ^ 2 + (hpLift a x) 2 ^ 2 < ρ ^ 2 := hcyl
        rw [h1, h2, ← hn] at hc
        by_contra hneg
        push_neg at hneg
        nlinarith
      rw [Set.indicator_of_mem hx]
      have hD := hpNearId_algebra (G (hpLift a x)) (hsymm _) (hclose _ hB)
      have hD0 : 0 ≤ (G (hpLift a x)).det := le_trans (by norm_num) hD.1.1
      have hq := hD.2.2 (Z (hpLift a x)) (hZG _)
      have habs : |Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0| =
          Real.sqrt ((G (hpLift a x)).det * Z (hpLift a x) 0 ^ 2) := by
        rw [Real.sqrt_mul hD0, Real.sqrt_sq_eq_abs, abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
      have hle : Real.sqrt ((G (hpLift a x)).det * Z (hpLift a x) 0 ^ 2) ≤ 101 / 100 := by
        calc Real.sqrt ((G (hpLift a x)).det * Z (hpLift a x) 0 ^ 2)
            ≤ Real.sqrt ((101 / 100) ^ 2) := Real.sqrt_le_sqrt hq
          _ = 101 / 100 := Real.sqrt_sq (by norm_num)
      have hs := le_abs_self (Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0)
      linarith
  
  have hχ : Integrable ((Metric.ball (0 : E2) ρ).indicator (fun _ => (101 / 100 : ℝ))) :=
    (integrable_indicator_iff measurableSet_ball).2 (integrableOn_const measure_ball_lt_top.ne)
  have hχint : ∫ x, (Metric.ball (0 : E2) ρ).indicator (fun _ => (101 / 100 : ℝ)) x =
      (volume (Metric.ball (0 : E2) ρ)).toReal * (101 / 100) := by
    rw [integral_indicator_const _ measurableSet_ball, measureReal_def, smul_eq_mul]
  rw [hLHS]
  by_cases hi : Integrable (fun x : E2 => Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0)
  · calc (∫ x : E2, Real.sqrt (G (hpLift a x)).det * Z (hpLift a x) 0)
        ≤ ∫ x, (Metric.ball (0 : E2) ρ).indicator (fun _ => (101 / 100 : ℝ)) x :=
          integral_mono hi hχ hpt
      _ = (101 / 100) * (volume (Metric.ball (0 : E2) ρ)).toReal := by rw [hχint]; ring
  · rw [integral_undef hi]
    exact mul_nonneg (by norm_num) ENNReal.toReal_nonneg

theorem hpCollar_cutoff : ∃ M : ℝ, 0 ≤ M ∧ ∀ h : ℝ, 0 < h → h ≤ 1 / 200 →
    ∃ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ ∧ (∀ z, 0 ≤ ψ z ∧ ψ z ≤ 1) ∧
      (∀ z : E3, z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h / 3) ^ 2 → |z 0| < 1 / 4 + h / 3 → ψ z = 1) ∧
      tsupport ψ ⊆ hpCyl (1 / 4 + h) (1 / 4 + h) ∧
      ∀ z : E3, |z 0| ≤ 1 / 8 → ‖fderiv ℝ ψ z‖ ≤ M / h :=
by
  
  have hST1 : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff
  have hSTd : Differentiable ℝ Real.smoothTransition := hST1.differentiable (by norm_num)
  have hvan : ∀ x ∉ Set.Icc (0:ℝ) 1, deriv Real.smoothTransition x = 0 := by
    intro x hx
    rw [Set.mem_Icc, not_and_or, not_le, not_le] at hx
    rcases hx with hx | hx
    · have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (0:ℝ) :=
        Filter.eventually_of_mem (isOpen_Iio.mem_nhds hx)
          (fun y hy => Real.smoothTransition.zero_of_nonpos (le_of_lt hy))
      rw [hev.deriv_eq, deriv_const]
    · have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (1:ℝ) :=
        Filter.eventually_of_mem (isOpen_Ioi.mem_nhds hx)
          (fun y hy => Real.smoothTransition.one_of_one_le (le_of_lt hy))
      rw [hev.deriv_eq, deriv_const]
  obtain ⟨K, hK0, hK⟩ : ∃ K : ℝ, 0 ≤ K ∧ ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ K := by
    have hcont : Continuous (deriv Real.smoothTransition) := hST1.continuous_deriv le_rfl
    have hcs : HasCompactSupport (deriv Real.smoothTransition) :=
      HasCompactSupport.intro isCompact_Icc hvan
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous hcont
    exact ⟨max C 0, le_max_right _ _, fun x => by
      rw [← Real.norm_eq_abs]; exact (hC x).trans (le_max_left _ _)⟩
  refine ⟨24 * K, by positivity, ?_⟩
  intro h hh0 hh1
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (1 / 4 + h / 3) ^ 2 := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = (1 / 4 + 2 * h / 3) ^ 2 := ⟨_, rfl⟩
  have hD : h / 6 ≤ B - A := by rw [hA, hB]; nlinarith
  have hDpos : 0 < B - A := by linarith
  have hB1 : B < 1 := by rw [hB]; nlinarith
  have hBR : B < (1 / 4 + h) ^ 2 := by rw [hB]; nlinarith
  have hA64 : 1 / 64 < A := by rw [hA]; nlinarith
  
  set g : ℝ → ℝ := fun s => Real.smoothTransition ((B - s) / (B - A)) with hgdef
  have hgs : ContDiff ℝ ∞ g :=
    Real.smoothTransition.contDiff.comp ((contDiff_const.sub contDiff_id).div_const _)
  have hg01 : ∀ s, 0 ≤ g s ∧ g s ≤ 1 := fun s =>
    ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hg1 : ∀ s, s ≤ A → g s = 1 := by
    intro s hs
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ hDpos]; linarith
  have hg0 : ∀ s, B ≤ s → g s = 0 := by
    intro s hs
    apply Real.smoothTransition.zero_of_nonpos
    rw [div_le_iff₀ hDpos]; linarith
  have hgd : ∀ s, HasDerivAt g
      (deriv Real.smoothTransition ((B - s) / (B - A)) * (-1 / (B - A))) s := by
    intro s
    have h1 : HasDerivAt (fun s : ℝ => (B - s) / (B - A)) (-1 / (B - A)) s :=
      ((hasDerivAt_id' s).const_sub B).div_const (B - A)
    exact (hSTd _).hasDerivAt.comp s h1
  have hgdb : ∀ s, |deriv Real.smoothTransition ((B - s) / (B - A)) * (-1 / (B - A))|
      ≤ K / (B - A) := by
    intro s
    rw [abs_mul, abs_div, abs_neg, abs_one, abs_of_pos hDpos, mul_one_div]
    gcongr
    exact hK _
  have hgd0 : ∀ s, B < s →
      deriv Real.smoothTransition ((B - s) / (B - A)) * (-1 / (B - A)) = 0 := by
    intro s hs
    have : (B - s) / (B - A) < 0 := div_neg_of_neg_of_pos (by linarith) hDpos
    rw [hvan _ (fun hm => absurd hm.1 (not_le.mpr this)), zero_mul]
  
  refine ⟨fun z => g (z 0 ^ 2) * g (z 1 ^ 2 + z 2 ^ 2), ?_, ?_, ?_, ?_, ?_⟩
  · have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : E3 => z i) := fun i =>
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff
    exact (hgs.comp ((hc 0).pow 2)).mul (hgs.comp (((hc 1).pow 2).add ((hc 2).pow 2)))
  · intro z
    exact ⟨mul_nonneg (hg01 _).1 (hg01 _).1, mul_le_one₀ (hg01 _).2 (hg01 _).1 (hg01 _).2⟩
  · intro z hz1 hz0
    have h0 : z 0 ^ 2 < A := by
      rw [hA]; nlinarith [abs_nonneg (z 0), sq_abs (z 0)]
    show g (z 0 ^ 2) * g (z 1 ^ 2 + z 2 ^ 2) = 1
    rw [hg1 _ h0.le, hg1 _ (by rw [hA]; exact hz1.le), one_mul]
  · have hT : IsClosed {z : E3 | z 0 ^ 2 ≤ B ∧ z 1 ^ 2 + z 2 ^ 2 ≤ B} := by
      rw [Set.setOf_and]
      exact (isClosed_le (by fun_prop) continuous_const).inter
        (isClosed_le (by fun_prop) continuous_const)
    refine (closure_minimal ?_ hT).trans ?_
    · intro z hz
      have hz' : g (z 0 ^ 2) * g (z 1 ^ 2 + z 2 ^ 2) ≠ 0 := hz
      refine ⟨?_, ?_⟩
      · by_contra hc
        exact hz' (by rw [hg0 _ (le_of_lt (not_le.mp hc)), zero_mul])
      · by_contra hc
        exact hz' (by rw [hg0 _ (le_of_lt (not_le.mp hc)), mul_zero])
    · rintro z ⟨h0, h12⟩
      refine ⟨by linarith, ?_⟩
      exact abs_lt_of_sq_lt_sq (by linarith) (by linarith)
  · intro z hz
    have hz0 : z 0 ^ 2 < A := by nlinarith [abs_nonneg (z 0), sq_abs (z 0)]
    have hN : {w : E3 | w 0 ^ 2 < A} ∈ 𝓝 z :=
      (isOpen_lt (by fun_prop) continuous_const).mem_nhds hz0
    have hev : (fun w : E3 => g (w 0 ^ 2) * g (w 1 ^ 2 + w 2 ^ 2)) =ᶠ[𝓝 z]
        fun w => g (w 1 ^ 2 + w 2 ^ 2) :=
      Filter.eventually_of_mem hN (fun w hw => by
        show g (w 0 ^ 2) * g (w 1 ^ 2 + w 2 ^ 2) = g (w 1 ^ 2 + w 2 ^ 2)
        rw [hg1 _ (le_of_lt hw), one_mul])
    rw [hev.fderiv_eq]
    set q' : E3 →L[ℝ] ℝ := (2 * z 1) • (EuclideanSpace.proj 1 : E3 →L[ℝ] ℝ) +
      (2 * z 2) • (EuclideanSpace.proj 2 : E3 →L[ℝ] ℝ) with hq'
    have hP : ∀ i : Fin 3, HasFDerivAt (fun w : E3 => w i)
        (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) z := fun i =>
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt
    have hq : HasFDerivAt (fun w : E3 => w 1 ^ 2 + w 2 ^ 2) q' z := by
      have h1 := ((hP 1).mul (hP 1)).add ((hP 2).mul (hP 2))
      convert h1 using 1
      · funext w
        simp only [Pi.add_apply, Pi.mul_apply]
        ring
      · rw [hq']; ext v; simp; ring
    have hcomp := (hgd (z 1 ^ 2 + z 2 ^ 2)).comp_hasFDerivAt z hq
    rw [show (fun w : E3 => g (w 1 ^ 2 + w 2 ^ 2)) = g ∘ (fun w : E3 => w 1 ^ 2 + w 2 ^ 2)
      from rfl, hcomp.fderiv, norm_smul, Real.norm_eq_abs]
    by_cases hqB : B < z 1 ^ 2 + z 2 ^ 2
    · rw [hgd0 _ hqB, abs_zero, zero_mul]; positivity
    · push_neg at hqB
      have hz1 : |z 1| ≤ 1 := by
        rw [abs_le]; constructor <;> nlinarith [sq_nonneg (z 2), sq_nonneg (z 1 - 1), sq_nonneg (z 1 + 1)]
      have hz2 : |z 2| ≤ 1 := by
        rw [abs_le]; constructor <;> nlinarith [sq_nonneg (z 1), sq_nonneg (z 2 - 1), sq_nonneg (z 2 + 1)]
      have hq'4 : ‖q'‖ ≤ 4 := by
        refine ContinuousLinearMap.opNorm_le_bound _ (by norm_num) (fun v => ?_)
        have hv1 : |v 1| ≤ ‖v‖ := by
          have := PiLp.norm_apply_le v 1; rwa [Real.norm_eq_abs] at this
        have hv2 : |v 2| ≤ ‖v‖ := by
          have := PiLp.norm_apply_le v 2; rwa [Real.norm_eq_abs] at this
        have hval : q' v = 2 * z 1 * v 1 + 2 * z 2 * v 2 := by rw [hq']; simp
        rw [hval, Real.norm_eq_abs]
        calc |2 * z 1 * v 1 + 2 * z 2 * v 2|
            ≤ |2 * z 1 * v 1| + |2 * z 2 * v 2| := abs_add_le _ _
          _ = 2 * (|z 1| * |v 1|) + 2 * (|z 2| * |v 2|) := by
              rw [abs_mul, abs_mul, abs_mul, abs_mul, abs_two]; ring
          _ ≤ 2 * (1 * ‖v‖) + 2 * (1 * ‖v‖) := by
              gcongr
          _ = 4 * ‖v‖ := by ring
      calc |deriv Real.smoothTransition ((B - (z 1 ^ 2 + z 2 ^ 2)) / (B - A)) * (-1 / (B - A))|
            * ‖q'‖ ≤ K / (B - A) * 4 :=
            mul_le_mul (hgdb _) hq'4 (norm_nonneg _) (by positivity)
        _ ≤ K / (h / 6) * 4 := by
            gcongr
        _ = 24 * K / h := by field_simp; ring

theorem hpCollar_volume (a b h : ℝ) (hab : a ≤ b) (hh : 0 ≤ h) :
    volume {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧ z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧
        a ≤ z 0 ∧ z 0 ≤ b} ≤
      ENNReal.ofReal ((b - a) * (8 * h + 16 * h ^ 2)) * volume (Metric.ball (0 : E2) (1 / 4)) :=
by
  
  set A' : Set (Fin 2 → ℝ) :=
    {g | 1 / 16 < g 0 ^ 2 + g 1 ^ 2 ∧ g 0 ^ 2 + g 1 ^ 2 < (1 / 4 + h) ^ 2} with hA'
  set A : Set E2 :=
    {x | 1 / 16 < x 0 ^ 2 + x 1 ^ 2 ∧ x 0 ^ 2 + x 1 ^ 2 < (1 / 4 + h) ^ 2} with hA
  have hA'm : MeasurableSet A' := by
    rw [hA', Set.setOf_and]
    exact (measurableSet_lt measurable_const (by fun_prop)).inter
      (measurableSet_lt (by fun_prop) measurable_const)
  
  have hP : MeasurePreserving
      (fun z : E3 => MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 (WithLp.ofLp z))
      volume ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ))) := by
    rw [← Measure.volume_eq_prod]
    exact (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).comp
      (PiLp.volume_preserving_ofLp (Fin 3))
  have hSeq : {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧ z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧
        a ≤ z 0 ∧ z 0 ≤ b} =
      (fun z : E3 => MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 (WithLp.ofLp z)) ⁻¹'
        (Set.Icc a b ×ˢ A') := by
    ext z
    have e0 : (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 (WithLp.ofLp z)).1 = z 0 :=
      rfl
    have e1 : (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 (WithLp.ofLp z)).2 0 = z 1 :=
      rfl
    have e2 : (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0 (WithLp.ofLp z)).2 1 = z 2 :=
      rfl
    simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_prod, Set.mem_Icc, hA', e0, e1, e2]
    tauto
  have hS : volume {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧ z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧
        a ≤ z 0 ∧ z 0 ≤ b} = ENNReal.ofReal (b - a) * volume A' := by
    rw [hSeq, hP.measure_preimage (measurableSet_Icc.prod hA'm).nullMeasurableSet,
      Measure.prod_prod, Real.volume_Icc]
  have hAA' : volume A = volume A' := by
    have : A = WithLp.ofLp ⁻¹' A' := rfl
    rw [this, (PiLp.volume_preserving_ofLp (Fin 2)).measure_preimage hA'm.nullMeasurableSet]
  
  have hnsq : ∀ x : E2, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  set V : ENNReal := volume (Metric.ball (0 : E2) 1) with hV
  have hVfin : V ≠ ⊤ := measure_ball_lt_top.ne
  have hfr : Module.finrank ℝ E2 = 2 := finrank_euclideanSpace_fin
  have hq : ((1 : ℝ) / 4) ^ 2 = 1 / 16 := by norm_num
  have hball : volume (Metric.ball (0 : E2) (1 / 4)) = ENNReal.ofReal (1 / 16) * V := by
    rw [Measure.addHaar_ball volume 0 (by norm_num), hfr, hq]
  have hD : volume (Metric.closedBall (0 : E2) (1 / 4)) = ENNReal.ofReal (1 / 16) * V := by
    rw [Measure.addHaar_closedBall volume 0 (by norm_num), hfr, hq]
  have hR0 : (0 : ℝ) ≤ 1 / 4 + h := by linarith
  have hBR : volume (Metric.closedBall (0 : E2) (1 / 4 + h)) =
      ENNReal.ofReal ((1 / 4 + h) ^ 2) * V := by
    rw [Measure.addHaar_closedBall volume 0 hR0, hfr]
  have hdisj : Disjoint A (Metric.closedBall (0 : E2) (1 / 4)) := by
    rw [Set.disjoint_left]
    intro x hx hxD
    rw [mem_closedBall_zero_iff] at hxD
    have h1 := hnsq x
    have h2 : ‖x‖ ^ 2 ≤ (1 / 4) ^ 2 := pow_le_pow_left₀ (norm_nonneg x) hxD 2
    have h3 := hx.1
    linarith
  have hsub : A ∪ Metric.closedBall (0 : E2) (1 / 4) ⊆ Metric.closedBall (0 : E2) (1 / 4 + h) := by
    apply Set.union_subset
    · intro x hx
      rw [mem_closedBall_zero_iff]
      have h1 := hnsq x
      have h3 := hx.2
      nlinarith [norm_nonneg x]
    · intro x hx
      rw [mem_closedBall_zero_iff] at hx ⊢
      linarith
  have hunion : volume A + ENNReal.ofReal (1 / 16) * V ≤
      ENNReal.ofReal (h / 2 + h ^ 2) * V + ENNReal.ofReal (1 / 16) * V := by
    rw [← hD, ← measure_union hdisj measurableSet_closedBall, hD, ← add_mul,
      ← ENNReal.ofReal_add (by positivity) (by norm_num)]
    have : h / 2 + h ^ 2 + 1 / 16 = (1 / 4 + h) ^ 2 := by ring
    rw [this, ← hBR]
    exact measure_mono hsub
  have hAle : volume A ≤ ENNReal.ofReal (h / 2 + h ^ 2) * V :=
    ENNReal.le_of_add_le_add_right (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hVfin) hunion
  
  have hba : 0 ≤ b - a := sub_nonneg.2 hab
  have hRHS : ENNReal.ofReal ((b - a) * (8 * h + 16 * h ^ 2)) *
      volume (Metric.ball (0 : E2) (1 / 4)) =
      ENNReal.ofReal (b - a) * (ENNReal.ofReal (h / 2 + h ^ 2) * V) := by
    have hX : 0 ≤ (b - a) * (8 * h + 16 * h ^ 2) := mul_nonneg hba (by positivity)
    rw [hball, ← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul hX, ← ENNReal.ofReal_mul hba]
    congr 2
    ring
  rw [hS, hRHS, ← hAA']
  exact mul_le_mul_left' hAle _

theorem hpHalf_collar_error : ∃ C : ℝ, 0 ≤ C ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : Set E3) (a b ε : ℝ) (Y : E3 → E3),
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (Metric.ball (0 : E3) 1)) →
    (∀ (z : E3) (i j : Fin 3), G z i j = G z j i) →
    (∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) →
    MeasurableSet F → -(1 / 8) ≤ a → a ≤ b → b ≤ 1 / 8 →
    volume ((Metric.ball (0 : E3) 1 ∩ {z | z 0 < a}) \ F) = 0 →
    volume (Metric.ball (0 : E3) 1 ∩ {z | b < z 0} ∩ F) = 0 →
    0 < ε → ContDiff ℝ ∞ Y → HasCompactSupport Y →
    tsupport Y ⊆ hpCyl (51 / 200) (51 / 200) →
    (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) →
    ∃ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ ∧ (∀ z, 0 ≤ ψ z ∧ ψ z ≤ 1) ∧
      (∃ O : Set E3, IsOpen O ∧
        {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} ⊆ O ∧ ∀ z ∈ O, ψ z = 1) ∧
      tsupport ψ ⊆ hpCyl (51 / 200) (51 / 200) ∧
      (∫ z in (F \ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4}) ∪
          ({z : E3 | z 0 < a} ∩ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4}),
          sepDensDiv G (fun w => ψ w • Y w) z) -
        (∫ z in {z : E3 | z 0 < a}, sepDensDiv G (fun w => ψ w • Y w) z) ≤
        C * (b - a) * (volume (Metric.ball (0 : E2) (1 / 4))).toReal + ε :=
by
  have hAE : ∀ (g : E3 → ℝ) (F E : Set E3) (a b B : ℝ),
      Integrable g → MeasurableSet F → MeasurableSet E → volume E ≠ ⊤ → 0 ≤ B → a ≤ b →
      volume ((Metric.ball (0 : E3) 1 ∩ {z | z 0 < a}) \ F) = 0 →
      volume (Metric.ball (0 : E3) 1 ∩ {z | b < z 0} ∩ F) = 0 →
      (∀ z, g z ≠ 0 → z ∈ Metric.ball (0 : E3) 1) →
      (∀ z, g z ≠ 0 → z ∉ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} →
        a ≤ z 0 → z 0 ≤ b → z ∈ E ∧ |g z| ≤ B) →
      (∫ z in (F \ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4}) ∪
          ({z : E3 | z 0 < a} ∩ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4}), g z) -
        (∫ z in {z : E3 | z 0 < a}, g z) ≤ B * (volume E).toReal := by
    intro g F E a b B hg hF hE hEfin hB hab hbot htop hsupp hslab
    set K : Set E3 := {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} with hKdef
    set H : Set E3 := {z : E3 | z 0 < a} with hHdef
    have hKm : MeasurableSet K := by
      rw [hKdef, Set.setOf_and]
      exact ((isClosed_le (by fun_prop) continuous_const).inter
        (isClosed_le (by fun_prop) continuous_const)).measurableSet
    have hHm : MeasurableSet H := (isOpen_lt (by fun_prop) continuous_const).measurableSet
    have hF'm : MeasurableSet ((F \ K) ∪ (H ∩ K)) := (hF.diff hKm).union (hHm.inter hKm)
    rw [← integral_indicator hF'm, ← integral_indicator hHm,
      ← integral_sub (hg.indicator hF'm) (hg.indicator hHm)]
    have hEi : Integrable (E.indicator (fun _ => B)) :=
      (integrable_indicator_iff hE).2 (integrableOn_const hEfin)
    have hint : ∫ z, E.indicator (fun _ => B) z = (volume E).toReal * B := by
      rw [integral_indicator_const _ hE, smul_eq_mul, Measure.real]
    have hN := measure_union_null hbot htop
    have hae : ∀ᵐ z ∂(volume : Measure E3),
        ((F \ K) ∪ (H ∩ K)).indicator g z - H.indicator g z ≤ E.indicator (fun _ => B) z := by
      filter_upwards [measure_eq_zero_iff_ae_notMem.1 hN] with z hz
      simp only [Set.mem_union, not_or] at hz
      obtain ⟨hz1, hz2⟩ := hz
      have hR0 : 0 ≤ E.indicator (fun _ => B) z := Set.indicator_nonneg (fun _ _ => hB) z
      by_cases hg0 : g z = 0
      · rw [Set.indicator_apply_eq_zero.2 (fun _ => hg0),
          Set.indicator_apply_eq_zero.2 (fun _ => hg0), sub_self]
        exact hR0
      have hzB := hsupp z hg0
      by_cases hzK : z ∈ K
      · have hiff : z ∈ (F \ K) ∪ (H ∩ K) ↔ z ∈ H := by
          simp only [Set.mem_union, Set.mem_diff, Set.mem_inter_iff]
          tauto
        by_cases hzH : z ∈ H
        · rw [Set.indicator_of_mem (hiff.2 hzH), Set.indicator_of_mem hzH, sub_self]
          exact hR0
        · rw [Set.indicator_of_notMem (fun h' => hzH (hiff.1 h')),
            Set.indicator_of_notMem hzH, sub_self]
          exact hR0
      · have hiff : z ∈ (F \ K) ∪ (H ∩ K) ↔ z ∈ F := by
          simp only [Set.mem_union, Set.mem_diff, Set.mem_inter_iff]
          tauto
        rcases lt_or_ge (z 0) a with hza | hza
        · have hzF : z ∈ F := by
            by_contra hzF
            exact hz1 ⟨⟨hzB, hza⟩, hzF⟩
          rw [Set.indicator_of_mem (hiff.2 hzF), Set.indicator_of_mem (show z ∈ H from hza),
            sub_self]
          exact hR0
        have hzH : z ∉ H := fun h' => by
          have : z 0 < a := h'
          linarith
        rcases lt_or_ge b (z 0) with hzb | hzb
        · have hzF : z ∉ F := fun hzF => hz2 ⟨⟨hzB, hzb⟩, hzF⟩
          rw [Set.indicator_of_notMem (fun h' => hzF (hiff.1 h')), Set.indicator_of_notMem hzH,
            sub_self]
          exact hR0
        · obtain ⟨hzE, hgB⟩ := hslab z hg0 hzK hza hzb
          rw [Set.indicator_of_notMem hzH, Set.indicator_of_mem hzE, sub_zero]
          by_cases hzF' : z ∈ (F \ K) ∪ (H ∩ K)
          · rw [Set.indicator_of_mem hzF']
            exact (le_abs_self _).trans hgB
          · rw [Set.indicator_of_notMem hzF']
            exact hB
    calc ∫ z, (((F \ K) ∪ (H ∩ K)).indicator g z - H.indicator g z)
        ≤ ∫ z, E.indicator (fun _ => B) z :=
          integral_mono_ae ((hg.indicator hF'm).sub (hg.indicator hHm)) hEi hae
      _ = B * (volume E).toReal := by rw [hint, mul_comm]
  obtain ⟨M, hM0, hcut⟩ := hpCollar_cutoff
  refine ⟨10 * M, by positivity, ?_⟩
  intro G F a b ε Y hG hsymm hclose hF ha hab hb hbot htop hε hY hYc hYs hYq
  
  have hnsq : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcylball : ∀ z ∈ hpCyl (51 / 200) (51 / 200), z ∈ Metric.ball (0 : E3) 1 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hz
    rw [mem_ball_zero_iff]
    have h3 : z 0 ^ 2 < (51 / 200) ^ 2 := sq_lt_sq' (abs_lt.1 h2).1 (abs_lt.1 h2).2
    have h4 := hnsq z
    have h5 : ‖z‖ ^ 2 < 1 := by nlinarith
    nlinarith [norm_nonneg z]
  have hdetpos : ∀ z ∈ Metric.ball (0 : E3) 1, 0 < (G z).det := by
    intro z hz
    have := (hpNearId_algebra (G z) (hsymm z) (hclose z hz)).1.1
    linarith
  have hYball : tsupport Y ⊆ Metric.ball (0 : E3) 1 := fun z hz => hcylball z (hYs hz)
  obtain ⟨-, hdYc, hdYcs, hprod⟩ := hpDensDiv_calculus G (Metric.ball (0 : E3) 1) Y
    Metric.isOpen_ball hG hdetpos hY hYc hYball
  obtain ⟨C₀, hC₀⟩ := hdYcs.exists_bound_of_continuous hdYc
  set B : ℝ := max C₀ 0 with hBdef
  have hB0 : 0 ≤ B := le_max_right _ _
  have hdivY : ∀ z, |sepDensDiv G Y z| ≤ B := by
    intro z
    have := hC₀ z
    rw [Real.norm_eq_abs] at this
    exact this.trans (le_max_left _ _)
  set A_r : ℝ := (volume (Metric.ball (0 : E2) (1 / 4))).toReal with hAdef
  have hApos : 0 < A_r :=
    ENNReal.toReal_pos (Metric.measure_ball_pos volume _ (by norm_num)).ne' measure_ball_lt_top.ne
  
  set h : ℝ := min (1 / 200) (ε / (3 * (B + 1) * (A_r + 1))) with hhdef
  have hden : 0 < 3 * (B + 1) * (A_r + 1) := by positivity
  have hh0 : 0 < h := lt_min (by norm_num) (div_pos hε hden)
  have hh1 : h ≤ 1 / 200 := min_le_left _ _
  have hhε : h * (3 * (B + 1) * (A_r + 1)) ≤ ε := (le_div_iff₀ hden).1 (min_le_right _ _)
  obtain ⟨ψ, hψ, hψ01, hψ1, hψs, hψd⟩ := hcut h hh0 hh1
  have hψs' : tsupport ψ ⊆ hpCyl (51 / 200) (51 / 200) := by
    intro z hz
    obtain ⟨h1, h2⟩ := hψs hz
    have h3 : (1 / 4 + h) ^ 2 ≤ (51 / 200) ^ 2 := by nlinarith
    exact ⟨lt_of_lt_of_le h1 h3, by linarith⟩
  have hc12 : Continuous (fun z : E3 => z 1 ^ 2 + z 2 ^ 2) := by fun_prop
  have hcz : Continuous (fun z : E3 => z 0) := by fun_prop
  have hcza : Continuous (fun z : E3 => |z 0|) := by fun_prop
  have hOopen : IsOpen {z : E3 | z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h / 3) ^ 2 ∧
      |z 0| < 1 / 4 + h / 3} := by
    rw [Set.setOf_and]
    exact (isOpen_lt hc12 continuous_const).inter (isOpen_lt hcza continuous_const)
  have hKO : {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} ⊆
      {z : E3 | z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h / 3) ^ 2 ∧ |z 0| < 1 / 4 + h / 3} := by
    rintro z ⟨h1, h2⟩
    have h3 : (1 / 4 : ℝ) ^ 2 < (1 / 4 + h / 3) ^ 2 := by nlinarith
    exact ⟨lt_of_le_of_lt h1 h3, by linarith⟩
  refine ⟨ψ, hψ, hψ01, ⟨_, hOopen, hKO, fun z hz => hψ1 z hz.1 hz.2⟩, hψs', ?_⟩
  
  set X : E3 → E3 := fun w => ψ w • Y w with hXdef
  have hXs : ContDiff ℝ ∞ X := hψ.smul hY
  have hXsupp : Function.support X ⊆ Function.support Y :=
    fun w hw h' => hw (by simp [hXdef, h'])
  have hXc : HasCompactSupport X := hYc.mono hXsupp
  have hXt : tsupport X ⊆ Metric.ball (0 : E3) 1 := (closure_mono hXsupp).trans hYball
  obtain ⟨-, hgc, hgcs, -⟩ := hpDensDiv_calculus G (Metric.ball (0 : E3) 1) X
    Metric.isOpen_ball hG hdetpos hXs hXc hXt
  have hgi : Integrable (sepDensDiv G X) := hgc.integrable_of_hasCompactSupport hgcs
  have hgprod : ∀ z, sepDensDiv G X z =
      ψ z * sepDensDiv G Y z + Real.sqrt (G z).det * fderiv ℝ ψ z (Y z) := hprod ψ hψ
  have hgsupp : ∀ z, sepDensDiv G X z ≠ 0 → z ∈ tsupport ψ := by
    intro z hz
    by_contra hzt
    have h1 : ψ z = 0 := image_eq_zero_of_notMem_tsupport hzt
    have h2 : fderiv ℝ ψ z = 0 := by
      by_contra h2
      exact hzt (support_fderiv_subset ℝ h2)
    apply hz
    rw [hgprod, h1, h2]
    simp
  have hgball : ∀ z, sepDensDiv G X z ≠ 0 → z ∈ Metric.ball (0 : E3) 1 :=
    fun z hz => hcylball z (hψs' (hgsupp z hz))
  
  set B' : ℝ := B + 11 / 10 * (M / h) with hB'def
  have hMh0 : 0 ≤ M / h := div_nonneg hM0 hh0.le
  have hB'0 : 0 ≤ B' := by positivity
  have hslab : ∀ z, sepDensDiv G X z ≠ 0 →
      z ∉ {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} →
      a ≤ z 0 → z 0 ≤ b →
      z ∈ {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧ z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧
        a ≤ z 0 ∧ z 0 ≤ b} ∧ |sepDensDiv G X z| ≤ B' := by
    intro z hz hzK hza hzb
    have hz0 : |z 0| ≤ 1 / 8 := abs_le.2 ⟨by linarith, by linarith⟩
    refine ⟨⟨?_, (hψs (hgsupp z hz)).1, hza, hzb⟩, ?_⟩
    · by_contra hr
      push_neg at hr
      exact hzK ⟨by linarith, by linarith⟩
    · have hzB := hgball z hz
      obtain ⟨⟨hd1, hd2⟩, hq, -⟩ := hpNearId_algebra (G z) (hsymm z) (hclose z hzB)
      have hY2 : ‖Y z‖ ^ 2 ≤ 100 / 97 := by
        have h1 := hq (Y z)
        have h2 := hYq z
        nlinarith
      have hsq : (Real.sqrt (G z).det * ‖Y z‖) ^ 2 ≤ (11 / 10) ^ 2 := by
        rw [mul_pow, Real.sq_sqrt (by linarith)]
        calc (G z).det * ‖Y z‖ ^ 2 ≤ 26 / 25 * (100 / 97) :=
              mul_le_mul hd2 hY2 (sq_nonneg _) (by norm_num)
          _ ≤ (11 / 10) ^ 2 := by norm_num
      have hpos : 0 ≤ Real.sqrt (G z).det * ‖Y z‖ := by positivity
      have hle : Real.sqrt (G z).det * ‖Y z‖ ≤ 11 / 10 := by nlinarith
      have hfd : ‖fderiv ℝ ψ z‖ ≤ M / h := hψd z hz0
      have hop : |fderiv ℝ ψ z (Y z)| ≤ ‖fderiv ℝ ψ z‖ * ‖Y z‖ := by
        rw [← Real.norm_eq_abs]
        exact ContinuousLinearMap.le_opNorm _ _
      have t1 : |ψ z * sepDensDiv G Y z| ≤ B := by
        rw [abs_mul, abs_of_nonneg (hψ01 z).1]
        have := hdivY z
        have := hψ01 z
        nlinarith [abs_nonneg (sepDensDiv G Y z)]
      have t2 : |Real.sqrt (G z).det * fderiv ℝ ψ z (Y z)| ≤ 11 / 10 * (M / h) := by
        rw [abs_mul, abs_of_nonneg (Real.sqrt_nonneg _)]
        have hs0 := Real.sqrt_nonneg (G z).det
        calc Real.sqrt (G z).det * |fderiv ℝ ψ z (Y z)|
            ≤ Real.sqrt (G z).det * (‖fderiv ℝ ψ z‖ * ‖Y z‖) :=
              mul_le_mul_of_nonneg_left hop hs0
          _ = (Real.sqrt (G z).det * ‖Y z‖) * ‖fderiv ℝ ψ z‖ := by ring
          _ ≤ 11 / 10 * (M / h) :=
              mul_le_mul hle hfd (norm_nonneg _) (by norm_num)
      rw [hgprod]
      calc |ψ z * sepDensDiv G Y z + Real.sqrt (G z).det * fderiv ℝ ψ z (Y z)|
          ≤ |ψ z * sepDensDiv G Y z| + |Real.sqrt (G z).det * fderiv ℝ ψ z (Y z)| :=
            abs_add_le _ _
        _ ≤ B' := by rw [hB'def]; linarith
  
  have hEm : MeasurableSet {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧
      z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧ a ≤ z 0 ∧ z 0 ≤ b} := by
    simp only [Set.setOf_and]
    exact (measurableSet_lt measurable_const hc12.measurable).inter
      ((measurableSet_lt hc12.measurable measurable_const).inter
        ((measurableSet_le measurable_const hcz.measurable).inter
          (measurableSet_le hcz.measurable measurable_const)))
  have hvol := hpCollar_volume a b h hab hh0.le
  have hRfin : ENNReal.ofReal ((b - a) * (8 * h + 16 * h ^ 2)) *
      volume (Metric.ball (0 : E2) (1 / 4)) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top measure_ball_lt_top.ne
  have hEfin := ne_top_of_le_ne_top hRfin hvol
  have hD := hAE (sepDensDiv G X) F _ a b B' hgi hF hEm hEfin hB'0 hab hbot htop
    hgball hslab
  have hvolr : (volume {z : E3 | 1 / 16 < z 1 ^ 2 + z 2 ^ 2 ∧
      z 1 ^ 2 + z 2 ^ 2 < (1 / 4 + h) ^ 2 ∧ a ≤ z 0 ∧ z 0 ≤ b}).toReal ≤
      (b - a) * (8 * h + 16 * h ^ 2) * A_r := by
    have := ENNReal.toReal_mono hRfin hvol
    rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal
      (mul_nonneg (sub_nonneg.2 hab) (by positivity))] at this
  have hba : 0 ≤ b - a := sub_nonneg.2 hab
  have hba4 : b - a ≤ 1 / 4 := by linarith
  have t1 : (b - a) * (8 * h + 16 * h ^ 2) * A_r ≤ 9 * h * (b - a) * A_r := by
    have h16 : 8 * h + 16 * h ^ 2 ≤ 9 * h := by nlinarith
    have := mul_nonneg hba hApos.le
    nlinarith
  have t2 := hD.trans (mul_le_mul_of_nonneg_left (hvolr.trans t1) hB'0)
  have hMh : M / h * h = M := div_mul_cancel₀ M hh0.ne'
  have t3 : B' * (9 * h * (b - a) * A_r) =
      9 * B * h * (b - a) * A_r + 99 / 10 * (M / h * h) * (b - a) * A_r := by
    rw [hB'def]; ring
  rw [hMh] at t3
  have e1 : B * A_r ≤ (B + 1) * (A_r + 1) := by nlinarith
  have e0 : 0 ≤ h * (B * A_r) := by positivity
  have e2 : 9 * B * h * (b - a) * A_r ≤ 9 / 4 * (h * (B * A_r)) := by
    nlinarith [mul_nonneg (sub_nonneg.2 hba4) e0]
  have e3 : h * (B * A_r) ≤ h * ((B + 1) * (A_r + 1)) := mul_le_mul_of_nonneg_left e1 hh0.le
  have e4 : 0 ≤ M * (b - a) * A_r := mul_nonneg (mul_nonneg hM0 hba) hApos.le
  show _ ≤ 10 * M * (b - a) * A_r + ε
  linarith

theorem hpHarn_halfspace_upper : ∃ C₆ : ℝ, 0 ≤ C₆ ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (a b : ℝ),
    IsOpen U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U) →
    (∀ (z : E3) (i j : Fin 3), G z i j = G z j i) → (∀ z ∈ U, (G z).PosDef) →
    sepIsPerMin G F U → Metric.closedBall (0 : E3) 1 ⊆ U →
    (∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) →
    -(1 / 8) ≤ a → a ≤ b → b ≤ 1 / 8 →
    volume ((Metric.ball (0 : E3) 1 ∩ {z | z 0 < a}) \ F) = 0 →
    volume (Metric.ball (0 : E3) 1 ∩ {z | b < z 0} ∩ F) = 0 →
    sepPerG G F (hpCyl (1 / 4) (1 / 4)) ≤
      ENNReal.ofReal (11 / 10 + C₆ * (b - a)) * volume (Metric.ball (0 : E2) (1 / 4)) :=
by
  obtain ⟨C, hC, hcol⟩ := hpHalf_collar_error
  refine ⟨C, hC, ?_⟩
  intro G F U a b hU hG hsymm hpd hmin hcb hclose ha hab hb hbot htop
  
  have hnsq : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hball1 : Metric.ball (0 : E3) 1 ⊆ U := Metric.ball_subset_closedBall.trans hcb
  have hG1 : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (Metric.ball (0 : E3) 1) :=
    fun i j => (hG i j).mono hball1
  have hdet : ∀ z ∈ Metric.ball (0 : E3) 1, 0 < (G z).det :=
    fun z hz => (hpd z (hball1 hz)).det_pos
  have hc1 : Continuous (fun z : E3 => z 1 ^ 2 + z 2 ^ 2) := by fun_prop
  have hc0 : Continuous (fun z : E3 => |z 0|) := by fun_prop
  have hcz : Continuous (fun z : E3 => z 0) := by fun_prop
  have hcylOpen : ∀ ρ h : ℝ, IsOpen (hpCyl ρ h) := fun ρ h =>
    (isOpen_lt hc1 continuous_const).inter (isOpen_lt hc0 continuous_const)
  have hV'ball : hpCyl (51 / 200) (51 / 200) ⊆ Metric.ball (0 : E3) 1 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hz
    rw [mem_ball_zero_iff]
    have h3 : z 0 ^ 2 < (51 / 200) ^ 2 := sq_lt_sq' (abs_lt.1 h2).1 (abs_lt.1 h2).2
    have h4 := hnsq z
    have h5 : ‖z‖ ^ 2 < 1 := by nlinarith
    nlinarith [norm_nonneg z]
  set K : Set E3 := {z : E3 | z 1 ^ 2 + z 2 ^ 2 ≤ (1 / 4) ^ 2 ∧ |z 0| ≤ 1 / 4} with hKdef
  set V' : Set E3 := hpCyl (51 / 200) (51 / 200) with hV'def
  set V0 : Set E3 := hpCyl (1 / 4) (1 / 4) with hV0def
  set H : Set E3 := {z : E3 | z 0 < a} with hHdef
  set F' : Set E3 := (F \ K) ∪ (H ∩ K) with hF'def
  have hKclosed : IsClosed K :=
    (isClosed_le hc1 continuous_const).inter (isClosed_le hc0 continuous_const)
  have hKV' : K ⊆ V' := by
    rintro z ⟨h1, h2⟩
    exact ⟨lt_of_le_of_lt h1 (by norm_num), lt_of_le_of_lt h2 (by norm_num)⟩
  have hKcpt : IsCompact K := by
    refine (isCompact_closedBall (0 : E3) 1).of_isClosed_subset hKclosed ?_
    intro z hz
    exact Metric.ball_subset_closedBall (hV'ball (hKV' hz))
  have hV0K : V0 ⊆ K := fun z hz => ⟨hz.1.le, hz.2.le⟩
  have hV'open : IsOpen V' := hcylOpen _ _
  have hclV' : closure V' ⊆ Metric.closedBall (0 : E3) 1 :=
    closure_minimal (hV'ball.trans Metric.ball_subset_closedBall) Metric.isClosed_closedBall
  have hclV'c : IsCompact (closure V') :=
    (isCompact_closedBall (0 : E3) 1).of_isClosed_subset isClosed_closure hclV'
  have hclV'U : closure V' ⊆ U := hclV'.trans hcb
  have hFm : MeasurableSet F := hmin.1
  have hKm : MeasurableSet K := hKclosed.measurableSet
  have hHm : MeasurableSet H := (isOpen_lt hcz continuous_const).measurableSet
  have hF'm : MeasurableSet F' := (hFm.diff hKm).union (hHm.inter hKm)
  have hoff : ∀ z, z ∉ K → (z ∈ F' ↔ z ∈ F) := by
    intro z hz
    simp only [hF'def, Set.mem_union, Set.mem_diff, Set.mem_inter_iff]
    tauto
  have hsd : symmDiff F F' ⊆ K := by
    intro z hz
    by_contra hzK
    rw [Set.mem_symmDiff] at hz
    have := hoff z hzK
    tauto
  set A : ENNReal := volume (Metric.ball (0 : E2) (1 / 4)) with hAdef
  have hAtop : A ≠ ⊤ := measure_ball_lt_top.ne
  have hApos : 0 < A.toReal :=
    ENNReal.toReal_pos (Metric.measure_ball_pos volume _ (by norm_num)).ne' hAtop
  have hball51 : (volume (Metric.ball (0 : E2) (51 / 200))).toReal = (51 / 50) ^ 2 * A.toReal := by
    rw [hAdef, Measure.addHaar_ball volume (0 : E2) (by norm_num : (0 : ℝ) ≤ 51 / 200),
      Measure.addHaar_ball volume (0 : E2) (by norm_num : (0 : ℝ) ≤ 1 / 4),
      ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
      ENNReal.toReal_ofReal (by positivity)]
    simp only [finrank_euclideanSpace, Fintype.card_fin]
    ring
  have hmono : ∀ S T : Set E3, S ⊆ T → sepPerG G F S ≤ sepPerG G F T := by
    intro S T hST
    unfold sepPerG
    exact iSup₂_mono' fun X hX => ⟨X, ⟨hX.1, hX.2.1, hX.2.2.1.trans hST, hX.2.2.2⟩, le_rfl⟩
  set B : ℝ := 11 / 10 + C * (b - a) with hBdef
  have hB0 : 0 ≤ B := by
    have := mul_nonneg hC (sub_nonneg.2 hab)
    rw [hBdef]
    linarith
  have hscale : ∀ t q : ℝ, 0 ≤ t → t ≤ 1 → q ≤ 1 → t * q ≤ 1 := by
    intro t q h0 h1 hq
    rcases le_total 0 q with h | h
    · nlinarith
    · nlinarith
  
  have hfield : ∀ Y : E3 → E3, ContDiff ℝ ∞ Y → HasCompactSupport Y → tsupport Y ⊆ V' →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) →
      ENNReal.ofReal (∫ z in F', sepDensDiv G Y z) ≤
        sepPerG G F (V' \ K) + ENNReal.ofReal (B * A.toReal) := by
    intro Y hY hYc hYs hYq
    obtain ⟨ψ, hψ, hψ01, ⟨O, hOo, hKO, hψO⟩, hψs, hineq⟩ :=
      hcol G F a b (A.toReal / 100) Y hG1 hsymm hclose hFm ha hab hb hbot htop (by positivity)
        hY hYc hYs hYq
    set X₁ : E3 → E3 := fun w => (1 - ψ w) • Y w with hX₁
    set X₂ : E3 → E3 := fun w => ψ w • Y w with hX₂
    have hYball : tsupport Y ⊆ Metric.ball (0 : E3) 1 := hYs.trans hV'ball
    obtain ⟨-, -, -, hprod⟩ := hpDensDiv_calculus G (Metric.ball (0 : E3) 1) Y
      Metric.isOpen_ball hG1 hdet hY hYc hYball
    have h1ψ : ContDiff ℝ ∞ (fun w => 1 - ψ w) := contDiff_const.sub hψ
    have hX₁s : ContDiff ℝ ∞ X₁ := h1ψ.smul hY
    have hX₂s : ContDiff ℝ ∞ X₂ := hψ.smul hY
    have hX₁supp : Function.support X₁ ⊆ Function.support Y :=
      fun w hw h => hw (by simp [hX₁, h])
    have hX₂supp : Function.support X₂ ⊆ Function.support ψ :=
      fun w hw h => hw (by simp [hX₂, h])
    have hX₂suppY : Function.support X₂ ⊆ Function.support Y :=
      fun w hw h => hw (by simp [hX₂, h])
    have hX₁c : HasCompactSupport X₁ := hYc.mono hX₁supp
    have hX₂c : HasCompactSupport X₂ := hYc.mono hX₂suppY
    have hX₁t : tsupport X₁ ⊆ tsupport Y := closure_mono hX₁supp
    have hX₂t : tsupport X₂ ⊆ tsupport ψ := closure_mono hX₂supp
    obtain ⟨-, hd1c, hd1cs, -⟩ := hpDensDiv_calculus G (Metric.ball (0 : E3) 1) X₁
      Metric.isOpen_ball hG1 hdet hX₁s hX₁c (hX₁t.trans hYball)
    obtain ⟨-, hd2c, hd2cs, -⟩ := hpDensDiv_calculus G (Metric.ball (0 : E3) 1) X₂
      Metric.isOpen_ball hG1 hdet hX₂s hX₂c (hX₂t.trans (hψs.trans hV'ball))
    have hi1 : Integrable (sepDensDiv G X₁) := hd1c.integrable_of_hasCompactSupport hd1cs
    have hi2 : Integrable (sepDensDiv G X₂) := hd2c.integrable_of_hasCompactSupport hd2cs
    
    have hsplit : sepDensDiv G Y = fun z => sepDensDiv G X₁ z + sepDensDiv G X₂ z := by
      funext z
      have e1 : sepDensDiv G X₁ z = (1 - ψ z) * sepDensDiv G Y z +
          Real.sqrt (G z).det * fderiv ℝ (fun w => 1 - ψ w) z (Y z) := hprod (fun w => 1 - ψ w) h1ψ z
      have e2 : sepDensDiv G X₂ z = ψ z * sepDensDiv G Y z +
          Real.sqrt (G z).det * fderiv ℝ ψ z (Y z) := hprod ψ hψ z
      have e3 : fderiv ℝ (fun w => 1 - ψ w) z (Y z) = -(fderiv ℝ ψ z (Y z)) := by
        rw [fderiv_const_sub, ContinuousLinearMap.neg_apply]
      rw [e1, e2, e3]
      ring
    have hint_split : ∫ z in F', sepDensDiv G Y z =
        (∫ z in F', sepDensDiv G X₁ z) + ∫ z in F', sepDensDiv G X₂ z := by
      rw [hsplit]
      exact integral_add hi1.integrableOn hi2.integrableOn
    
    have hX₁O : ∀ z ∈ O, X₁ z = 0 := by
      intro z hz
      simp [hX₁, hψO z hz]
    have hdX₁O : ∀ z ∈ O, sepDensDiv G X₁ z = 0 := by
      intro z hz
      unfold sepDensDiv
      refine Finset.sum_eq_zero fun i _ => ?_
      unfold partialDeriv
      have hev : (fun w => Real.sqrt (G w).det * X₁ w i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
        filter_upwards [hOo.mem_nhds hz] with w hw
        rw [hX₁O w hw]
        simp
      rw [hev.fderiv_eq]
      simp
    have hind : F'.indicator (sepDensDiv G X₁) = F.indicator (sepDensDiv G X₁) := by
      funext z
      by_cases hzK : z ∈ K
      · have h0 := hdX₁O z (hKO hzK)
        rw [Set.indicator_apply_eq_zero.2 (fun _ => h0), Set.indicator_apply_eq_zero.2 (fun _ => h0)]
      · by_cases hzF : z ∈ F
        · rw [Set.indicator_of_mem hzF, Set.indicator_of_mem ((hoff z hzK).2 hzF)]
        · rw [Set.indicator_apply_eq_zero.2 (fun h => absurd h hzF),
            Set.indicator_apply_eq_zero.2 (fun h => absurd ((hoff z hzK).1 h) hzF)]
    have hX₁F : ∫ z in F', sepDensDiv G X₁ z = ∫ z in F, sepDensDiv G X₁ z := by
      rw [← integral_indicator hF'm, ← integral_indicator hFm, hind]
    
    have hq1 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X₁ y i * X₁ y j =
        (1 - ψ y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j := by
      intro y
      simp only [hX₁, PiLp.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    have hq2 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X₂ y i * X₂ y j =
        ψ y ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j := by
      intro y
      simp only [hX₂, PiLp.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    have hX₁adm : ContDiff ℝ ∞ X₁ ∧ HasCompactSupport X₁ ∧ tsupport X₁ ⊆ V' \ K ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X₁ y i * X₁ y j ≤ 1 := by
      refine ⟨hX₁s, hX₁c, ?_, ?_⟩
      · intro z hz
        refine ⟨hYs (hX₁t hz), ?_⟩
        have hsub : tsupport X₁ ⊆ Oᶜ :=
          closure_minimal (fun w hw hwO => hw (hX₁O w hwO)) hOo.isClosed_compl
        exact fun hzK => hsub hz (hKO hzK)
      · intro y
        rw [hq1]
        have := hψ01 y
        exact hscale _ _ (sq_nonneg _) (by nlinarith) (hYq y)
    have hX₁le : ENNReal.ofReal (∫ z in F, sepDensDiv G X₁ z) ≤ sepPerG G F (V' \ K) := by
      unfold sepPerG
      exact le_iSup₂_of_le X₁ hX₁adm le_rfl
    
    have hX₂q : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X₂ y i * X₂ y j ≤ 1 := by
      intro y
      rw [hq2]
      have := hψ01 y
      exact hscale _ _ (sq_nonneg _) (by nlinarith) (hYq y)
    have hX₂ts : tsupport X₂ ⊆
        Metric.ball (0 : E3) 1 ∩ {z : E3 | z 1 ^ 2 + z 2 ^ 2 < (51 / 200) ^ 2} := by
      intro z hz
      have hzV := hψs (hX₂t hz)
      exact ⟨hV'ball hzV, hzV.1⟩
    have hflux := hpHalf_flux_bound G X₂ a (51 / 200) hG1 hsymm hclose (by norm_num) hX₂s hX₂c
      hX₂ts hX₂q
    rw [hball51] at hflux
    
    have hineq' : (∫ z in F', sepDensDiv G X₂ z) - (∫ z in H, sepDensDiv G X₂ z) ≤
        C * (b - a) * A.toReal + A.toReal / 100 := hineq
    have hBA : B * A.toReal = 11 / 10 * A.toReal + C * (b - a) * A.toReal := by
      rw [hBdef]; ring
    have hreal : ∫ z in F', sepDensDiv G Y z ≤ (∫ z in F, sepDensDiv G X₁ z) + B * A.toReal := by
      rw [hint_split, hX₁F, hBA]
      have hflux' : ∫ z in H, sepDensDiv G X₂ z ≤ (101 / 100) * ((51 / 50) ^ 2 * A.toReal) := hflux
      nlinarith
    calc ENNReal.ofReal (∫ z in F', sepDensDiv G Y z)
        ≤ ENNReal.ofReal ((∫ z in F, sepDensDiv G X₁ z) + B * A.toReal) :=
          ENNReal.ofReal_le_ofReal hreal
      _ ≤ ENNReal.ofReal (∫ z in F, sepDensDiv G X₁ z) + ENNReal.ofReal (B * A.toReal) :=
          ENNReal.ofReal_add_le
      _ ≤ sepPerG G F (V' \ K) + ENNReal.ofReal (B * A.toReal) := by gcongr
  
  have hcomp : sepPerG G F' V' ≤ sepPerG G F (V' \ K) + ENNReal.ofReal (B * A.toReal) := by
    unfold sepPerG
    exact iSup₂_le fun Y hY => hfield Y hY.1 hY.2.1 hY.2.2.1 hY.2.2.2
  
  have hminF : sepPerG G F V' ≤ sepPerG G F' V' :=
    hmin.2.2 F' V' K hF'm hV'open hclV'c hclV'U hKcpt hKV' hsd
  have hd : Disjoint V0 (V' \ K) := Set.disjoint_left.2 fun z hz hz' => hz'.2 (hV0K hz)
  have hdisj : Pairwise (fun k l => Disjoint ((![V0, V' \ K] : Fin 2 → Set E3) k)
      ((![V0, V' \ K] : Fin 2 → Set E3) l)) := by
    intro k l hkl
    fin_cases k <;> fin_cases l
    · exact absurd rfl hkl
    · exact hd
    · exact hd.symm
    · exact absurd rfl hkl
  have hsum := sepPerG_sum_le G F hFm 2 ![V0, V' \ K] hdisj
  rw [Fin.sum_univ_two] at hsum
  have hUnion : (⋃ k, (![V0, V' \ K] : Fin 2 → Set E3) k) ⊆ V' := by
    refine Set.iUnion_subset fun k => ?_
    fin_cases k
    · exact hV0K.trans hKV'
    · exact Set.diff_subset
  
  have hP1fin : sepPerG G F (V' \ K) ≠ ⊤ :=
    ((hmono _ _ Set.diff_subset).trans_lt (hmin.2.1 V' hV'open hclV'c hclV'U)).ne
  have hchain : sepPerG G F V0 + sepPerG G F (V' \ K) ≤
      ENNReal.ofReal (B * A.toReal) + sepPerG G F (V' \ K) := by
    calc sepPerG G F V0 + sepPerG G F (V' \ K)
        = sepPerG G F ((![V0, V' \ K] : Fin 2 → Set E3) 0) +
            sepPerG G F ((![V0, V' \ K] : Fin 2 → Set E3) 1) := rfl
      _ ≤ sepPerG G F (⋃ k, (![V0, V' \ K] : Fin 2 → Set E3) k) := hsum
      _ ≤ sepPerG G F V' := hmono _ _ hUnion
      _ ≤ sepPerG G F' V' := hminF
      _ ≤ sepPerG G F (V' \ K) + ENNReal.ofReal (B * A.toReal) := hcomp
      _ = ENNReal.ofReal (B * A.toReal) + sepPerG G F (V' \ K) := add_comm _ _
  have hfin := ENNReal.le_of_add_le_add_right hP1fin hchain
  
  rw [ENNReal.ofReal_mul hB0, ENNReal.ofReal_toReal hAtop] at hfin
  exact hfin

theorem quadSurface_meanCurv_approx : ∀ A κ : ℝ, 0 < A → 0 < κ → ∃ t : ℝ, 0 < t ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (ν b x w : E3) (M : Matrix (Fin 3) (Fin 3) ℝ)
      (ρ τ c : ℝ),
    ‖ν‖ = 1 → 0 < ρ → 0 < τ → τ ≤ t → (∀ i j, M i j = M j i) → (∀ i, ∑ j, M i j * ν j = 0) →
    ‖b‖ ≤ A → (∀ i j, |M i j| ≤ A) → ‖w - x‖ ≤ ρ →
    (∀ i j : Fin 3, |G w i j - (if i = j then (1 : ℝ) else 0)| ≤ t ∧
       ‖fderiv ℝ (fun y => G y i j) w‖ * ρ ≤ t * τ) →
    |ρ * levelMeanCurvCoord G (fun y => @inner ℝ E3 _ ν (y - x) -
         τ * ρ * (@inner ℝ E3 _ b (ρ⁻¹ • (y - x)) +
           ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - x)) i * (ρ⁻¹ • (y - x)) j + c)) w +
       2 * τ * ∑ i, M i i| ≤ κ * τ :=
by
  
  have core : ∀ (H M : Matrix (Fin 3) (Fin 3) ℝ) (p ν : Fin 3 → ℝ)
      (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (A t τ : ℝ),
      0 ≤ A → 0 < τ → τ ≤ t → 1000 * (1 + A) * t ≤ 1 →
      ∑ i, ν i ^ 2 = 1 → (∀ i, |ν i| ≤ 1) →
      (∀ k, |p k - ν k| ≤ 7 * A * τ) →
      (∀ i j, |H i j - (if i = j then (1:ℝ) else 0)| ≤ 2 * t) →
      (∀ k i j, |Γ k i j| ≤ 9 * t * τ) →
      (∀ i j, |M i j| ≤ A) → (∀ i j, M i j = M j i) → (∀ i, ∑ j, M i j * ν j = 0) →
      |(∑ i, ∑ j, H i j * (-(2 * τ * M i j) - ∑ k, Γ k i j * p k)) /
          Real.sqrt (∑ i, ∑ j, H i j * p i * p j) -
        (∑ i, ∑ j, ∑ a, ∑ b, H i a * p a * (H j b * p b) *
            (-(2 * τ * M i j) - ∑ k, Γ k i j * p k)) /
          Real.sqrt (∑ i, ∑ j, H i j * p i * p j) ^ 3 +
        2 * τ * ∑ i, M i i| ≤ 5000 * (1 + A) ^ 2 * t * τ := by
    intro H M p ν Γ A t τ hA hτ hτt hKt hν2 hν1 hd hH hΓ hMA hMs hMν
    have hs3 : ∀ (g : Fin 3 → ℝ) (B : ℝ), (∀ i, |g i| ≤ B) → |∑ i, g i| ≤ 3 * B := by
      intro g B h
      rw [Fin.sum_univ_three]
      have h0 := abs_le.1 (h 0)
      have h1 := abs_le.1 (h 1)
      have h2 := abs_le.1 (h 2)
      rw [abs_le]
      constructor <;> linarith [h0.1, h0.2, h1.1, h1.2, h2.1, h2.2]
    have hm : ∀ a b A B : ℝ, |a| ≤ A → |b| ≤ B → |a * b| ≤ A * B := by
      intro a b A B h1 h2
      rw [abs_mul]
      exact mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
    have hsub : ∀ a b : ℝ, |a - b| ≤ |a| + |b| := fun a b => by
      simpa [sub_eq_add_neg, abs_neg] using abs_add_le a (-b)
    have htri : ∀ a b : ℝ, |a| ≤ |a - b| + |b| := fun a b => by
      simpa using abs_add_le (a - b) b
    have ht0 : 0 ≤ t := by linarith
    have hKt' : (1 + A) * t ≤ 1 / 1000 := by linarith
    have hAt0 : 0 ≤ A * t := mul_nonneg hA ht0
    have hAt : A * t ≤ 1 / 1000 := by nlinarith
    have ht1 : t ≤ 1 / 1000 := by nlinarith
    have hAτ : A * τ ≤ A * t := mul_le_mul_of_nonneg_left hτt hA
    have htτ : 0 ≤ t * τ := mul_nonneg ht0 hτ.le
    have hAtτ : 0 ≤ A * t * τ := mul_nonneg hAt0 hτ.le
    have hAAtτ : 0 ≤ A * A * t * τ := mul_nonneg (mul_nonneg (mul_nonneg hA hA) ht0) hτ.le
    have hd' : ∀ k, |p k - ν k| ≤ 7 * ((1 + A) * t) := by
      intro k; have := hd k; nlinarith
    have hp2 : ∀ k, |p k| ≤ 2 := by
      intro k
      have h1 := hd' k
      have h2 := hν1 k
      have h3 := htri (p k) (ν k)
      linarith
    have hdel : ∀ i j : Fin 3, |(if i = j then (1:ℝ) else 0)| ≤ 1 := by
      intro i j; split_ifs <;> simp
    have hH2 : ∀ i j, |H i j| ≤ 2 := by
      intro i j
      have h1 := hH i j
      have h2 := hdel i j
      have h3 := htri (H i j) (if i = j then (1:ℝ) else 0)
      linarith
    
    have hQid : (∑ i, ∑ j, H i j * p i * p j) - 1 =
        ∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * p i * p j +
        ∑ i, (p i - ν i) * (p i + ν i) := by
      simp only [Fin.sum_univ_three] at hν2 ⊢
      simp only [Fin.isValue, Fin.reduceEq, if_true, if_false]
      linear_combination hν2
    have hQ1 : |(∑ i, ∑ j, H i j * p i * p j) - 1| ≤ 135 * ((1 + A) * t) := by
      rw [hQid]
      have e1 : |∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * p i * p j| ≤
          3 * (3 * (2 * t * 2 * 2)) :=
        hs3 _ _ fun i => hs3 _ _ fun j => hm _ _ _ _ (hm _ _ _ _ (hH i j) (hp2 i)) (hp2 j)
      have e2 : |∑ i, (p i - ν i) * (p i + ν i)| ≤ 3 * (7 * ((1 + A) * t) * 3) := by
