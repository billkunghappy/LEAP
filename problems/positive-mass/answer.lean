      _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3,
            |partialDeriv l (fun z => partialDeriv i' (fun y => partialDeriv j' w y) z) x| :=
          Finset.single_le_sum
            (f := fun i' => ∑ j' : Fin 3,
              |partialDeriv l (fun z => partialDeriv i' (fun y => partialDeriv j' w y) z) x|)
            (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ i)
