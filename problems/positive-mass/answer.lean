    have hfin : (volume : Measure E3) (Metric.closedBall (0:E3) (c + 1)) ≠ ⊤ :=
      measure_closedBall_lt_top.ne
    have hSfin : (volume : Measure E3) (Metric.closedBall (0:E3) (c + 1) \ Metric.ball 0 c) ≠ ⊤ :=
