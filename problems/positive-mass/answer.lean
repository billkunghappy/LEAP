        + sg * (df i * (∑ j : Fin 3, ∑ k : Fin 3, P j k * A i j k
              - ∑ j : Fin 3, ∑ k : Fin 3, P i j * A k k j)
          - ∑ j : Fin 3, ((∑ a : Fin 3, ∑ b : Fin 3, (dP i i a * Hm a b * P b j
                  + P i a * dH i a b * P b j + P i a * Hm a b * dP i b j)
                - (dP i i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b
                  + P i j * ∑ a : Fin 3, ∑ b : Fin 3, (dP i a b * Hm a b + P a b * dH i a b)))
                * df j
              + (∑ a : Fin 3, ∑ b : Fin 3, P i a * Hm a b * P b j
                  - P i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b) * ddf i j))) =
        -(sg * (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
              P a c * P b d * Hm a b * hess c d
            - lap * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b)) := by
      simp only [hlap, hhess]
      simp only [hsg, hdP', hA]
      simp only [Fin.sum_univ_three, p10, p20, p21, h10, h20, h21, g10, g20, g21, e10, e20, e21]
      ring
    
    have hXT : ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          P a c * P b d * Hm a b * Ric c d =
        ∑ j : Fin 3, ∑ k : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, P j a * Hm a b * P b k) * Ric j k := by
      simp only [Fin.sum_univ_three, p10, p20, p21]
      ring
    
    have hTG : ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          P a c * P b d * Hm a b * Gm c d =
        ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b := by
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      have h1 : ∑ c : Fin 3, ∑ d : Fin 3, P a c * P b d * Hm a b * Gm c d =
          ∑ c : Fin 3, P a c * Hm a b * ∑ d : Fin 3, P b d * Gm d c := by
        refine Finset.sum_congr rfl fun c _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [hGm c d]
        ring
      rw [h1]
      simp only [hGP', mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    simp only [hL]
    simp only [Fin.sum_univ_three] at hPal hHess hXT hTG ⊢
    linear_combination f0 * hPal + f0 * sg * hXT + sg * lap * hTG - hHess
  exact master (fun a b => (G y)⁻¹ a b) (fun a b => H y a b) (fun a b => G y a b) (fun j k => ricci G j k y) (fun c d => hessLoc G f c d y)
    (fun i j => partialDeriv i (partialDeriv j f) y) (fun k i j => christoffel G k i j y)
    (fun k i j => fvChristoffelVar G H k i j y)
    (fun m a b => partialDeriv m (fun z => (G z)⁻¹ a b) y)
    (fun m a b => partialDeriv m (fun z => H z a b) y)
    (fun m k i j => partialDeriv m (fvChristoffelVar G H k i j) y)
    (Real.sqrt (G y).det) (f y) (lapLoc G f y)
    (fun m => partialDeriv m (fun z => Real.sqrt (G z).det) y) (fun k => partialDeriv k f y)
    (fun i => partialDeriv i (fvField G H f i) y)
    hPs (hHs y) hΓs hdHs hJac hdP (fun k i j => rfl) (hGs y) hGP (fun c d => rfl) rfl
    (fun i => leib (fun z => Real.sqrt (G z).det) f (fun a b z => (G z)⁻¹ a b)
      (fun a b z => H z a b) (fvChristoffelVar G H) (fun j => partialDeriv j f) i
      hsd hfd hPd hHd hAd hdfd)

theorem first_variation_regularity (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U K : Set E3) (hU : IsOpen U) (hKc : IsClosed K)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHK : ∀ y, y ∉ K → H y = 0)
    (hf : ContDiffOn ℝ ∞ f U) :
    (∀ i : Fin 3, ContDiffOn ℝ ∞ (fvField G H f i) U) ∧
    (∀ i : Fin 3, ∀ y ∈ U, y ∉ K → fvField G H f i y = 0) ∧
    (∀ c d : Fin 3, ContinuousOn (staticLoc G f c d) U) ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U) ∧
    ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U :=
by
  classical
  have hdet : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpos y hy).ne'
  have hpd : ∀ h : E3 → ℝ, ContDiffOn ℝ ∞ h U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c h) U := by
    intro h hh c
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hh).2
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y (e c)) U
    exact hD.clm_apply contDiffOn_const
  have hdetgen : ∀ F : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) U) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) U := by
    intro F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := U) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) U := by
    intro i j
    simp only [Matrix.adjugate_apply]
    refine hdetgen (fun z => (G z).updateRow j (Pi.single i 1)) ?_
    intro a b
    by_cases hab : a = j
    · subst hab
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hab]
      exact hG a b
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) U := by
    intro i j
    have heq : (fun z => (G z)⁻¹ i j) =
        fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen _ hG).inv hdet).mul (hadj i j)
  have hsq : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U :=
    (hdetgen _ hG).sqrt hdet
  have hpar : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) U :=
    fun a b c => hpd _ (hG a b) c
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => christoffel G k i j y) U
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinv k l).mul (((hpar j l i).add (hpar i l j)).sub (hpar i j l))))
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) U := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ricci G j k y) U
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun p _ =>
        ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k)))))
    exact (hpd _ (hΓ i j k) i).sub (hpd _ (hΓ i i k) j)
  have hHU : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U :=
    fun a b => (hH a b).contDiffOn
  have hdH : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => H z a b) y) U :=
    fun a b c => hpd _ (hHU a b) c
  have hdf : ∀ j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv j f) U := fun j => hpd f hf j
  have hΓ' : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (fvChristoffelVar G H k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => fvChristoffelVar G H k i j y) U
    unfold fvChristoffelVar
    exact (contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
        (hinv k l).mul (((hdH j l i).add (hdH i l j)).sub (hdH i j l)))).sub
      (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
        ((hinv k a).mul (hHU a b)).mul (hΓ b i j))
  have hFsm : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fvField G H f i) U := by
    intro i
    have hV : ContDiffOn ℝ ∞ (fun y =>
        ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ j k * fvChristoffelVar G H i j k y
          - ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ i j * fvChristoffelVar G H k k j y) U :=
      (ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ => (hinv j k).mul (hΓ' i j k)).sub
        (ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ => (hinv i j).mul (hΓ' k k j))
    have hN : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun y =>
        (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ i a * H y a b * (G y)⁻¹ b j
          - (G y)⁻¹ i j * ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * H y a b)
          * partialDeriv j f y) U := by
      intro j
      exact ((ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          ((hinv i a).mul (hHU a b)).mul (hinv b j)).sub
        ((hinv i j).mul (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          (hinv a b).mul (hHU a b)))).mul (hdf j)
    show ContDiffOn ℝ ∞ (fun y => fvField G H f i y) U
    unfold fvField
    exact hsq.mul ((hf.mul hV).sub (ContDiffOn.sum fun j _ => hN j))
  have hHess : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => hessLoc G f i j y) U
    unfold hessLoc
    exact (hpd _ (hdf j) i).sub (ContDiffOn.sum (fun k _ => (hΓ k i j).mul (hdf k)))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G f) U := by
    show ContDiffOn ℝ ∞ (fun y => lapLoc G f y) U
    unfold lapLoc
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ => (hinv i j).mul (hHess i j)))
  have hSt : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticLoc G f i j y) U
    unfold staticLoc
    exact ((hf.mul (hRic i j)).sub (hHess i j)).add (hLap.mul (hG i j))
  have hF0 : ∀ i : Fin 3, ∀ y ∈ U, y ∉ K → fvField G H f i y = 0 := by
    intro i y _ hyK
    have hnhds : Kᶜ ∈ 𝓝 y := hKc.isOpen_compl.mem_nhds hyK
    have hb2 : ∀ a b : Fin 3, H y a b = 0 := by
      intro a b; rw [hHK y hyK]; rfl
    have hb3 : ∀ a b c : Fin 3, partialDeriv c (fun z => H z a b) y = 0 := by
      intro a b c
      have hev : (fun z => H z a b) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) := by
        filter_upwards [hnhds] with z hz
        rw [hHK z hz]; rfl
      show fderiv ℝ (fun z => H z a b) y (e c) = 0
      rw [hev.fderiv_eq, fderiv_const_apply]
      rfl
    have hb4 : ∀ k i' j : Fin 3, fvChristoffelVar G H k i' j y = 0 := by
      intro k i' j
      unfold fvChristoffelVar
      simp [hb2, hb3]
    unfold fvField
    simp [hb2, hb4]
  exact ⟨hFsm, hF0, fun c d => (hSt c d).continuousOn, hinv, hsq⟩

theorem flux_integral_estimate (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (φ ρ δ σ σ₀ u : E3 → ℝ) (M : Fin 3 → Fin 3 → E3 → ℝ) (t P Q C₂ C₃ D B₀ : ℝ)
    (ht : 0 < t) (hP : 0 ≤ P) (hQ : 0 ≤ Q) (hC₂ : 0 ≤ C₂) (hC₃ : 0 ≤ C₃) (hD : 0 ≤ D)
    (hB₀ : 0 ≤ B₀)
    (hφc : ContinuousOn φ K) (hdφc : ∀ i : Fin 3, ContinuousOn (partialDeriv i φ) K)
    (hρc : ContinuousOn ρ K) (hδc : ContinuousOn δ K) (hσc : ContinuousOn σ K)
    (hσ₀c : ContinuousOn σ₀ K) (hMc : ∀ i j : Fin 3, ContinuousOn (M i j) K)
    (hu : ContDiffOn ℝ 1 u U)
    (hφb : ∀ y ∈ K, |φ y| ≤ P ∧ ∀ i : Fin 3, |partialDeriv i φ y| ≤ P)
    (hσb : ∀ y ∈ K, |σ y| ≤ Q)
    (hρb : ∀ y ∈ K, |ρ y - t * δ y| ≤ C₂ * t ^ 2 ∧ |ρ y| ≤ C₃ * t ∧ |δ y| ≤ D)
    (hσσ : ∀ y ∈ K, |σ y - σ₀ y| ≤ C₂ * t)
    (hMb : ∀ y ∈ K, ∀ i j : Fin 3, |M i j y| ≤ C₂ * t)
    (hint : ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤ B₀ * t) :
    |(∫ y in K, (φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y))
      - t / 8 * ∫ y in K, φ y * δ y * σ₀ y|
      ≤ (MeasureTheory.volume.real K * P * C₂ * (Q + D) / 8 + P * C₃ * Q * B₀ / 8
          + 9 * C₂ * P * B₀) * t ^ 2 :=
by
  classical
  have hKm : MeasurableSet K := hK.measurableSet
  have huc : ContinuousOn u K := hu.continuousOn.mono hKU
  have hdu : ContinuousOn (fun y => fderiv ℝ u y) K :=
    (hu.continuousOn_fderiv_of_isOpen hU le_rfl).mono hKU
  have hduj : ∀ j : Fin 3, ContinuousOn (partialDeriv j u) K := by
    intro j
    show ContinuousOn (fun y => fderiv ℝ u y (e j)) K
    exact hdu.clm_apply continuousOn_const
  have hwc : ContinuousOn (fun y => |u y| + ‖fderiv ℝ u y‖) K := huc.abs.add hdu.norm
  have hFc : ContinuousOn (fun y => φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y) K := by
    refine ContinuousOn.add ?_ ?_
    · exact (hφc.mul ((hρc.mul (continuousOn_const.add huc)).div_const 8)).mul hσc
    · exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        ((hMc i j).mul (hdφc i)).mul (hduj j)
  have hGc : ContinuousOn (fun y => φ y * δ y * σ₀ y) K := (hφc.mul hδc).mul hσ₀c
  have hpd : ∀ (y : E3) (j : Fin 3), |partialDeriv j u y| ≤ ‖fderiv ℝ u y‖ := by
    intro y j
    have h1 := (fderiv ℝ u y).le_opNorm (e j)
    have h2 : ‖(e j : E3)‖ = 1 := by simp [e, EuclideanSpace.norm_single]
    rw [h2, mul_one] at h1
    rw [← Real.norm_eq_abs]
    exact h1
  have hC₂t : 0 ≤ C₂ * t := mul_nonneg hC₂ ht.le
  have hb0 : 0 ≤ (P * C₃ * Q / 8 + 9 * C₂ * P) * t := by
    have h1 : 0 ≤ P * C₃ * Q / 8 := by
      have := mul_nonneg (mul_nonneg hP hC₃) hQ
      linarith
    have h2 : 0 ≤ 9 * C₂ * P := mul_nonneg (mul_nonneg (by norm_num) hC₂) hP
    exact mul_nonneg (add_nonneg h1 h2) ht.le
  
  have hpt : ∀ y ∈ K, ‖(φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y)
        - t / 8 * (φ y * δ y * σ₀ y)‖ ≤ P * C₂ * (Q + D) / 8 * t ^ 2 +
          (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖) := by
    intro y hy
    rw [Real.norm_eq_abs]
    obtain ⟨hφ, hdφ⟩ := hφb y hy
    have hσ := hσb y hy
    obtain ⟨hρδ, hρ, hδ⟩ := hρb y hy
    have hss := hσσ y hy
    have hN0 : 0 ≤ ‖fderiv ℝ u y‖ := norm_nonneg _
    have hu0 : 0 ≤ |u y| := abs_nonneg _
    set S := ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y with hS
    have hid : (φ y * (ρ y * (1 + u y) / 8) * σ y + S) - t / 8 * (φ y * δ y * σ₀ y) =
        φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8 + S := by ring
    have h8 : |(8 : ℝ)| = 8 := abs_of_pos (by norm_num)
    have e1 : |φ y * (ρ y - t * δ y) * σ y / 8| ≤ P * (C₂ * t ^ 2) * Q / 8 := by
      have hp : |φ y| * |ρ y - t * δ y| * |σ y| ≤ P * (C₂ * t ^ 2) * Q :=
        mul_le_mul (mul_le_mul hφ hρδ (abs_nonneg _) hP) hσ (abs_nonneg _)
          (mul_nonneg hP (mul_nonneg hC₂ (sq_nonneg t)))
      rw [abs_div, abs_mul, abs_mul, h8]
      linarith
    have e2 : |φ y * t * δ y * (σ y - σ₀ y) / 8| ≤ P * t * D * (C₂ * t) / 8 := by
      have hp : |φ y| * t * |δ y| * |σ y - σ₀ y| ≤ P * t * D * (C₂ * t) :=
        mul_le_mul (mul_le_mul (mul_le_mul hφ le_rfl ht.le hP) hδ (abs_nonneg _)
          (mul_nonneg hP ht.le)) hss (abs_nonneg _) (mul_nonneg (mul_nonneg hP ht.le) hD)
      rw [abs_div, abs_mul, abs_mul, abs_mul, abs_of_pos ht, h8]
      linarith
    have e3 : |φ y * ρ y * u y * σ y / 8| ≤ P * (C₃ * t) * |u y| * Q / 8 := by
      have hp : |φ y| * |ρ y| * |u y| * |σ y| ≤ P * (C₃ * t) * |u y| * Q :=
        mul_le_mul (mul_le_mul (mul_le_mul hφ hρ (abs_nonneg _) hP) le_rfl hu0
          (mul_nonneg hP (mul_nonneg hC₃ ht.le))) hσ (abs_nonneg _)
          (mul_nonneg (mul_nonneg hP (mul_nonneg hC₃ ht.le)) hu0)
      rw [abs_div, abs_mul, abs_mul, abs_mul, h8]
      linarith
    have eS : |S| ≤ 9 * (C₂ * t * P * ‖fderiv ℝ u y‖) := by
      have hterm : ∀ i j : Fin 3,
          |M i j y * partialDeriv i φ y * partialDeriv j u y| ≤ C₂ * t * P * ‖fderiv ℝ u y‖ := by
        intro i j
        rw [abs_mul, abs_mul]
        exact mul_le_mul (mul_le_mul (hMb y hy i j) (hdφ i) (abs_nonneg _) hC₂t) (hpd y j)
          (abs_nonneg _) (mul_nonneg hC₂t hP)
      rw [hS]
      calc |∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y|
          ≤ ∑ i : Fin 3, |∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, |M i j y * partialDeriv i φ y * partialDeriv j u y| :=
            Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, C₂ * t * P * ‖fderiv ℝ u y‖ :=
            Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hterm i j
        _ = 9 * (C₂ * t * P * ‖fderiv ℝ u y‖) := by
            simp only [Fin.sum_univ_three]; ring
    have tri : |φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8 + S| ≤
        |φ y * (ρ y - t * δ y) * σ y / 8| + |φ y * t * δ y * (σ y - σ₀ y) / 8| +
          |φ y * ρ y * u y * σ y / 8| + |S| := by
      have a1 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8) S
      have a2 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8)
          (φ y * ρ y * u y * σ y / 8)
      have a3 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8) (φ y * t * δ y * (σ y - σ₀ y) / 8)
      linarith
    have n1 : 0 ≤ P * C₃ * Q * t * ‖fderiv ℝ u y‖ :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hP hC₃) hQ) ht.le) hN0
    have n2 : 0 ≤ C₂ * P * t * |u y| :=
      mul_nonneg (mul_nonneg (mul_nonneg hC₂ hP) ht.le) hu0
    rw [hid]
    linarith [tri, e1, e2, e3, eS, n1, n2]
  
  have hFi : IntegrableOn (fun y => φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y) K :=
    hFc.integrableOn_compact hK
  have hGi : IntegrableOn (fun y => φ y * δ y * σ₀ y) K := hGc.integrableOn_compact hK
  have hwi : IntegrableOn (fun y => |u y| + ‖fderiv ℝ u y‖) K := hwc.integrableOn_compact hK
  have hci : IntegrableOn (fun _ : E3 => P * C₂ * (Q + D) / 8 * t ^ 2) K :=
    continuousOn_const.integrableOn_compact hK
  have hlin : (∫ y in K, (φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y))
      - t / 8 * ∫ y in K, φ y * δ y * σ₀ y =
      ∫ y in K, ((φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y)
        - t / 8 * (φ y * δ y * σ₀ y)) := by
    rw [← integral_const_mul]
    exact (integral_sub hFi (hGi.const_mul (t / 8))).symm
  have hgi : Integrable (fun y => P * C₂ * (Q + D) / 8 * t ^ 2 +
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖)) (volume.restrict K) :=
    hci.add (hwi.const_mul _)
  have hnorm := norm_integral_le_of_norm_le hgi (ae_restrict_of_forall_mem hKm hpt)
  have hgeq : ∫ y in K, (P * C₂ * (Q + D) / 8 * t ^ 2 +
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖)) =
      MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) := by
    rw [integral_add hci (hwi.const_mul _), setIntegral_const, integral_const_mul, smul_eq_mul]
  rw [hgeq, Real.norm_eq_abs] at hnorm
  have hfin : (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (B₀ * t) := mul_le_mul_of_nonneg_left hint hb0
  rw [hlin]
  calc _ ≤ MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) := hnorm
    _ ≤ MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (B₀ * t) := by linarith
    _ = (MeasureTheory.volume.real K * P * C₂ * (Q + D) / 8 + P * C₃ * Q * B₀ / 8
          + 9 * C₂ * P * B₀) * t ^ 2 := by ring

theorem flux_first_order_expansion (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hR : ∀ y ∈ U, scalarCurvatureLocal G y = 0)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i)
    (hHK : ∀ y, y ∉ K → H y = 0) (hf : ContDiffOn ℝ ∞ f U) :
    ∃ t₂ C₃ : ℝ, 0 < t₂ ∧ 0 ≤ C₃ ∧
      (∀ t : ℝ, |t| ≤ t₂ → ∀ y ∈ K,
        |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ C₃ * |t|) ∧
      ∀ B₀ : ℝ, 0 ≤ B₀ → ∃ C₄ : ℝ, 0 ≤ C₄ ∧ ∀ t : ℝ, 0 < t → t ≤ t₂ →
        ∀ u : E3 → ℝ, ContDiffOn ℝ 1 u U →
          ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤ B₀ * t →
          |(∫ y in K, (f y * (scalarCurvatureLocal (fun z => G z + t • H z) y * (1 + u y) / 8) *
                Real.sqrt (G y + t • H y).det +
              ∑ i : Fin 3, ∑ j : Fin 3,
                ((G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
                  (G y)⁻¹ i j * Real.sqrt (G y).det) * partialDeriv i f y * partialDeriv j u y))
            - t / 8 * (-∫ y in K, (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
                (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) *
                Real.sqrt (G y).det)| ≤ C₄ * t ^ 2 :=
by
  classical
  
  have hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) K :=
    fun i j => (hG i j).continuousOn.mono hKU
  have hHc : ∀ i j : Fin 3, ContinuousOn (fun y => H y i j) K :=
    fun i j => (hH i j).continuous.continuousOn
  obtain ⟨t₁a, Ca, ht₁a, ht₁a1, hCa, hs1⟩ :=
    sqrt_det_perturbation G H K hK hGc hHc (fun y hy => hGpos y (hKU hy))
  
  obtain ⟨hWo, -, hΦ⟩ := perturbed_curvature_contDiffOn G H U hU hG hH
  have hKW : ∀ y ∈ K,
      ((0 : ℝ), y) ∈ {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    intro y hy
    show y ∈ U ∧ (G y + (0 : ℝ) • H y).det ≠ 0
    refine ⟨hKU hy, ?_⟩
    rw [zero_smul, add_zero]
    exact (hGpos y (hKU hy)).ne'
  obtain ⟨t₁b, Cb, ht₁b, hCb, hDRc, hTay⟩ :=
    param_taylor_compact
      (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2) _ hWo
      (hΦ.of_le (WithTop.coe_le_coe.2 le_top)) K hK hKW
  obtain ⟨DR, hDRdef⟩ : ∃ DR : E3 → ℝ,
      DR = fun y => deriv (fun s : ℝ => scalarCurvatureLocal (fun z => G z + s • H z) y) 0 :=
    ⟨_, rfl⟩
  have hDRc' : ContinuousOn DR K := by rw [hDRdef]; exact hDRc
  have hR0 : ∀ y ∈ K, scalarCurvatureLocal (fun z => G z + (0 : ℝ) • H z) y = 0 := by
    intro y hy
    have h : (fun z => G z + (0 : ℝ) • H z) = G := by
      funext z; rw [zero_smul, add_zero]
    rw [h]; exact hR y (hKU hy)
  have hTay' : ∀ t : ℝ, |t| ≤ t₁b → ∀ y ∈ K,
      |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| ≤ Cb * t ^ 2 := by
    intro t ht y hy
    have h : |scalarCurvatureLocal (fun z => G z + t • H z) y
        - scalarCurvatureLocal (fun z => G z + (0 : ℝ) • H z) y - t * DR y| ≤ Cb * t ^ 2 := by
      rw [hDRdef]; exact (hTay t ht y hy).2
    rw [hR0 y hy, sub_zero] at h
    exact h
  
  obtain ⟨D₀, hD₀⟩ := hK.exists_bound_of_continuousOn hDRc'
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = max D₀ 0 := ⟨_, rfl⟩
  have hD : 0 ≤ D := by rw [hDdef]; exact le_max_right _ _
  have hDb : ∀ y ∈ K, |DR y| ≤ D := by
    intro y hy
    have h := hD₀ y hy
    rw [Real.norm_eq_abs] at h
    rw [hDdef]; exact h.trans (le_max_left _ _)
  
  obtain ⟨C₂, hC₂def⟩ : ∃ C₂ : ℝ, C₂ = max Ca Cb := ⟨_, rfl⟩
  have hCaC₂ : Ca ≤ C₂ := by rw [hC₂def]; exact le_max_left _ _
  have hCbC₂ : Cb ≤ C₂ := by rw [hC₂def]; exact le_max_right _ _
  have hC₂ : 0 ≤ C₂ := hCa.trans hCaC₂
  have hC₃ : 0 ≤ D + C₂ := add_nonneg hD hC₂
  
  have hcl1 : ∀ t : ℝ, |t| ≤ min t₁a t₁b → ∀ y ∈ K,
      |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ (D + C₂) * |t| := by
    intro t ht y hy
    have hta : |t| ≤ t₁a := ht.trans (min_le_left _ _)
    have htb : |t| ≤ t₁b := ht.trans (min_le_right _ _)
    have h1 := hTay' t htb y hy
    have h2 := hDb y hy
    have ht1 : |t| ≤ 1 := hta.trans ht₁a1
    have hsq : t ^ 2 ≤ |t| := by
      nlinarith [mul_nonneg (abs_nonneg t) (sub_nonneg.2 ht1), sq_abs t]
    have h3 : |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤
        |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| + |t| * |DR y| := by
      have h := abs_sub_abs_le_abs_sub (scalarCurvatureLocal (fun z => G z + t • H z) y)
        (t * DR y)
      rw [abs_mul] at h
      linarith
    have h4 : |t| * |DR y| ≤ |t| * D := mul_le_mul_of_nonneg_left h2 (abs_nonneg t)
    have h5 : Cb * t ^ 2 ≤ Cb * |t| := mul_le_mul_of_nonneg_left hsq hCb
    have h6 : Cb * |t| ≤ C₂ * |t| := mul_le_mul_of_nonneg_right hCbC₂ (abs_nonneg t)
    nlinarith
  
  obtain ⟨hFsm, hF0, hstc, hPsm, hsqsm⟩ :=
    first_variation_regularity G H f U K hU hK.isClosed hG hGpos hH hHK hf
  have hfv := first_variation_divergence_pointwise G H f U hU hG hGs hGpos hH hHs hf
  have hderiv := scalar_first_variation_hasDerivAt G H U hU hG hGs hGpos hH hHs
  have hDReq : ∀ y ∈ U, DR y = fvScalarVar G H y := by
    intro y hy
    rw [hDRdef]
    exact (hderiv y hy).deriv
  have hKm : MeasurableSet K := hK.measurableSet
  have hXc : ContinuousOn (fun y => (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
      (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det) K := by
    refine ContinuousOn.mul ?_ (hsqsm.continuousOn.mono hKU)
    refine continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
      continuousOn_finset_sum _ fun c _ => continuousOn_finset_sum _ fun d _ => ?_
    exact ((((hPsm a c).continuousOn.mono hKU).mul ((hPsm b d).continuousOn.mono hKU)).mul
      (hHc a b)).mul ((hstc c d).mono hKU)
  have hdivc : ContinuousOn (fun y => ∑ i : Fin 3, partialDeriv i (fvField G H f i) y) K := by
    refine continuousOn_finset_sum _ fun i _ => ?_
    have h1 : ContinuousOn (fun y => fderiv ℝ (fvField G H f i) y) U :=
      (hFsm i).continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)
    show ContinuousOn (fun y => fderiv ℝ (fvField G H f i) y (e i)) K
    exact (h1.clm_apply continuousOn_const).mono hKU
  have hI10 : ∫ y in K, f y * DR y * Real.sqrt (G y).det =
      -∫ y in K, (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det := by
    have h1 : ∫ y in K, f y * DR y * Real.sqrt (G y).det =
        ∫ y in K, ((∑ i : Fin 3, partialDeriv i (fvField G H f i) y) -
          (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
            (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) *
              Real.sqrt (G y).det) := by
      refine setIntegral_congr_fun hKm fun y hy => ?_
      rw [hDReq y (hKU hy), hfv y (hKU hy)]
      ring
    rw [h1, integral_sub (hdivc.integrableOn_compact hK) (hXc.integrableOn_compact hK),
      divergence_setIntegral_eq_zero U K hU hK hKU (fvField G H f)
        (fun i => (hFsm i).of_le (by exact_mod_cast le_top)) hF0, zero_sub]
  
  have hdfU : ∀ i : Fin 3, ContinuousOn (partialDeriv i f) U := by
    intro i
    have h1 : ContinuousOn (fun y => fderiv ℝ f y) U :=
      hf.continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)
    show ContinuousOn (fun y => fderiv ℝ f y (e i)) U
    exact h1.clm_apply continuousOn_const
  obtain ⟨P₀, hP₀⟩ := hK.exists_bound_of_continuousOn (hf.continuousOn.mono hKU)
  have hPi : ∀ i : Fin 3, ∃ C : ℝ, ∀ y ∈ K, ‖partialDeriv i f y‖ ≤ C :=
    fun i => hK.exists_bound_of_continuousOn ((hdfU i).mono hKU)
  choose Pd hPd using hPi
  obtain ⟨PP, hPPdef⟩ : ∃ PP : ℝ, PP = max P₀ 0 + ∑ j : Fin 3, |Pd j| := ⟨_, rfl⟩
  have hPPs : 0 ≤ ∑ j : Fin 3, |Pd j| := Finset.sum_nonneg fun j _ => abs_nonneg _
  have hPP : 0 ≤ PP := by rw [hPPdef]; exact add_nonneg (le_max_right _ _) hPPs
  have hPb : ∀ y ∈ K, |f y| ≤ PP ∧ ∀ i : Fin 3, |partialDeriv i f y| ≤ PP := by
    intro y hy
    refine ⟨?_, fun i => ?_⟩
    · have h := hP₀ y hy
      rw [Real.norm_eq_abs] at h
      rw [hPPdef]
      linarith [le_max_left P₀ 0]
    · have h := hPd i y hy
      rw [Real.norm_eq_abs] at h
      have hsum : Pd i ≤ ∑ j : Fin 3, |Pd j| :=
        (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |Pd j|)
          (fun j _ => abs_nonneg _) (Finset.mem_univ i))
      rw [hPPdef]
      linarith [le_max_right P₀ 0]
  refine ⟨min t₁a t₁b, D + C₂, lt_min ht₁a ht₁b, hC₃, hcl1, ?_⟩
  intro B₀ hB₀
  have hC₄ : 0 ≤ MeasureTheory.volume.real K * PP * C₂ * (Ca + D) / 8 + PP * (D + C₂) * Ca * B₀ / 8
      + 9 * C₂ * PP * B₀ := by
    have hv : 0 ≤ MeasureTheory.volume.real K := MeasureTheory.measureReal_nonneg
    have a1 : 0 ≤ MeasureTheory.volume.real K * PP * C₂ * (Ca + D) / 8 :=
      div_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hv hPP) hC₂) (add_nonneg hCa hD))
        (by norm_num)
    have a2 : 0 ≤ PP * (D + C₂) * Ca * B₀ / 8 :=
      div_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hPP hC₃) hCa) hB₀) (by norm_num)
    have a3 : 0 ≤ 9 * C₂ * PP * B₀ :=
      mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₂) hPP) hB₀
    linarith
  refine ⟨_, hC₄, ?_⟩
  intro t ht0 htt u hu hint
  have htabs : |t| = t := abs_of_pos ht0
  have htm : |t| ≤ min t₁a t₁b := by rw [htabs]; exact htt
  have hta : |t| ≤ t₁a := htm.trans (min_le_left _ _)
  have htb : |t| ≤ t₁b := htm.trans (min_le_right _ _)
  obtain ⟨hsqc, hPtc, hpt⟩ := hs1 t hta
  have hρc : ContinuousOn (fun y => scalarCurvatureLocal (fun z => G z + t • H z) y) K := by
    have hmaps : Set.MapsTo (fun y : E3 => (t, y)) K
        {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
      intro y hy
      show y ∈ U ∧ (G y + t • H y).det ≠ 0
      exact ⟨hKU hy, (hpt y hy).1.ne'⟩
    have hcont : ContinuousOn (fun y : E3 => ((t, y) : ℝ × E3)) K :=
      (Continuous.prodMk (continuous_const (y := t)) continuous_id).continuousOn
    have hcomp := ContinuousOn.comp
      (g := fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2)
      (f := fun y : E3 => ((t, y) : ℝ × E3)) hΦ.continuousOn hcont hmaps
    refine hcomp.congr ?_
    intro y _
    rfl
  have hMc : ∀ i j : Fin 3, ContinuousOn (fun y => (G y + t • H y)⁻¹ i j *
      Real.sqrt (G y + t • H y).det - (G y)⁻¹ i j * Real.sqrt (G y).det) K := fun i j =>
    ((hPtc i j).mul hsqc).sub
      (((hPsm i j).continuousOn.mono hKU).mul (hsqsm.continuousOn.mono hKU))
  have hσb : ∀ y ∈ K, |Real.sqrt (G y + t • H y).det| ≤ Ca := by
    intro y hy
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    exact (hpt y hy).2.1
  have hρb : ∀ y ∈ K, |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| ≤ C₂ * t ^ 2 ∧
      |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ (D + C₂) * t ∧ |DR y| ≤ D := by
    intro y hy
    refine ⟨(hTay' t htb y hy).trans (mul_le_mul_of_nonneg_right hCbC₂ (sq_nonneg t)), ?_,
      hDb y hy⟩
    have h := hcl1 t htm y hy
    rw [htabs] at h
    exact h
  have hσσ : ∀ y ∈ K, |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C₂ * t := by
    intro y hy
    have h := (hpt y hy).2.2.1
    rw [htabs] at h
    exact h.trans (mul_le_mul_of_nonneg_right hCaC₂ ht0.le)
  have hMb : ∀ y ∈ K, ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j *
      Real.sqrt (G y + t • H y).det - (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C₂ * t := by
    intro y hy i j
    have h := (hpt y hy).2.2.2 i j
    rw [htabs] at h
    exact h.trans (mul_le_mul_of_nonneg_right hCaC₂ ht0.le)
  have key := flux_integral_estimate U K hU hK hKU f
    (fun y => scalarCurvatureLocal (fun z => G z + t • H z) y) DR
    (fun y => Real.sqrt (G y + t • H y).det) (fun y => Real.sqrt (G y).det) u
    (fun i j y => (G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
      (G y)⁻¹ i j * Real.sqrt (G y).det)
    t PP Ca C₂ (D + C₂) D B₀ ht0 hPP hCa hC₂ hC₃ hD hB₀
    (hf.continuousOn.mono hKU) (fun i => (hdfU i).mono hKU) hρc hDRc' hsqc
    (hsqsm.continuousOn.mono hKU) hMc hu hPb hσb hρb hσσ hMb hint
  beta_reduce at key
  rw [← hI10]
  exact key

theorem conformal_scalar_flat [IsManifold 𝓘(ℝ, E3) ∞ M] (h g' : RiemannianMetric3 M) (v : M → ℝ)
    (hv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v) (hvpos : ∀ p : M, 0 < 1 + v p)
    (hg' : ∀ x, g'.g x = ((1 + v x) ^ 4) • h.g x)
    (hveq : ∀ p : M, -8 * h.lapM v p + h.scalarCurvature p * (1 + v p) = 0) :
    ∀ p : M, g'.scalarCurvature p = 0 :=
by
  intro p
  have hU : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hG : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun x => h.coeff (chartAt E3 p).symm x i j) (chartAt E3 p).target :=
    fun i j => h.smooth p i j
  have hsymm : ∀ (x : E3) (i j : Fin 3),
      h.coeff (chartAt E3 p).symm x i j = h.coeff (chartAt E3 p).symm x j i :=
    fun x i j => h.symm _ _ _
  have hdet : ∀ x ∈ (chartAt E3 p).target, (h.coeff (chartAt E3 p).symm x).det ≠ 0 :=
    fun x hx => (coeff_chart_symm_posDef h p x hx).det_pos.ne'
  have hw : ContDiffOn ℝ ∞ (fun y => v ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hv.comp_contMDiffOn contMDiffOn_chart_symm)
  have hu : ContDiffOn ℝ ∞ (fun y => 1 + v ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contDiffOn_const.add hw
  have hupos : ∀ x ∈ (chartAt E3 p).target, 0 < 1 + v ((chartAt E3 p).symm x) :=
    fun x _ => hvpos _
  have hy : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have key := conformal_scalarCurvatureLocal (h.coeff (chartAt E3 p).symm)
    (fun y => 1 + v ((chartAt E3 p).symm y)) _ hU hG hsymm hdet hu hupos _ hy
  have hcoeff : g'.coeff (chartAt E3 p).symm =
      fun x => ((1 + v ((chartAt E3 p).symm x)) ^ 4) • h.coeff (chartAt E3 p).symm x := by
    funext y
    ext i j
    show g'.g ((chartAt E3 p).symm y) _ _ =
      (1 + v ((chartAt E3 p).symm y)) ^ 4 * h.g ((chartAt E3 p).symm y) _ _
    rw [hg' ((chartAt E3 p).symm y), ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hpd : ∀ k : Fin 3, partialDeriv k (fun y => 1 + v ((chartAt E3 p).symm y)) =
      partialDeriv k (fun y => v ((chartAt E3 p).symm y)) := by
    intro k
    funext z
    simp only [partialDeriv, fderiv_const_add]
  have hlap : lapLocal (h.coeff (chartAt E3 p).symm) (fun y => 1 + v ((chartAt E3 p).symm y))
      (chartAt E3 p p) = h.lapM v p := by
    simp only [lapLocal, RiemannianMetric3.lapM, lapLoc, hessLoc, hpd]
  have hleft : (chartAt E3 p).symm (chartAt E3 p p) = p :=
    (chartAt E3 p).left_inv (mem_chart_source E3 p)
  show scalarCurvatureLocal (g'.coeff (chartAt E3 p).symm) (chartAt E3 p p) = 0
  refine (congrArg (fun G => scalarCurvatureLocal G (chartAt E3 p p)) hcoeff).trans ?_
  refine key.trans ?_
  show ((1 + v ((chartAt E3 p).symm (chartAt E3 p p))) ^ 5)⁻¹ *
      (-8 * lapLocal (h.coeff (chartAt E3 p).symm) (fun y => 1 + v ((chartAt E3 p).symm y))
          (chartAt E3 p p) +
        h.scalarCurvature p * (1 + v ((chartAt E3 p).symm (chartAt E3 p p)))) = 0
  rw [hlap, hleft, hveq p, mul_zero]

theorem isCompleteRiemannian_of_equiv [IsManifold 𝓘(ℝ, E3) ∞ M] (g g' : RiemannianMetric3 M)
    (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hlo : ∀ (p : M) (ξ : E3), c₁ * g.g p ξ ξ ≤ g'.g p ξ ξ)
    (hhi : ∀ (p : M) (ξ : E3), g'.g p ξ ξ ≤ c₂ * g.g p ξ ξ) (hC : g.IsCompleteRiemannian) :
    g'.IsCompleteRiemannian :=
by
  
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (L : E3 →L[ℝ] E3) (w : E3),
      B (L w) (L w) = ∑ i : Fin 3, ∑ j : Fin 3, w i * w j * B (L (e i)) (L (e j)) := by
    intro B L w
    have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
      ext k
      fin_cases k <;> simp [e]
    conv_lhs => rw [hw]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_smul',
      Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hsum3 : ∀ (t₀ : ℝ) (f : Fin 3 → ℝ → ℝ), (∀ i, ContinuousAt (f i) t₀) →
      ContinuousAt (fun s => ∑ i : Fin 3, f i s) t₀ := by
    intro t₀ f hf
    simp only [Fin.sum_univ_three]
    exact ((hf 0).add (hf 1)).add (hf 2)
  
  have hspeed : ∀ (h : RiemannianMetric3 M) (γ : ℝ → M), ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 γ →
      Continuous (fun t => h.g (γ t) (RiemannianMetric3.velocity γ t)
        (RiemannianMetric3.velocity γ t)) := by
    intro h γ hγ
    rw [continuous_iff_continuousAt]
    intro t₀
    obtain ⟨c, hc⟩ : ∃ c, c = chartAt E3 (γ t₀) := ⟨_, rfl⟩
    have hcatlas : c ∈ atlas E3 M := by rw [hc]; exact chart_mem_atlas E3 (γ t₀)
    obtain ⟨U, hU⟩ : ∃ U : Set ℝ, U = γ ⁻¹' c.source := ⟨_, rfl⟩
    have hUo : IsOpen U := by rw [hU]; exact c.open_source.preimage hγ.continuous
    have ht₀ : t₀ ∈ U := by rw [hU, hc]; exact mem_chart_source E3 (γ t₀)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : ℝ → E3, ψ = fun s => c (γ s) := ⟨_, rfl⟩
    have hψm : ContMDiffOn 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 ψ U := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 c c.source := by
        rw [hc]; exact contMDiffOn_chart
      rw [hψ]
      exact h1.comp hγ.contMDiffOn (fun s hs => by rw [hU] at hs; exact hs)
    have hψd : ContDiffOn ℝ 1 ψ U := contMDiffOn_iff_contDiffOn.mp hψm
    have hdc : ContinuousOn (deriv ψ) U := hψd.continuousOn_deriv_of_isOpen hUo le_rfl
    have hvel : ∀ s ∈ U, RiemannianMetric3.velocity γ s =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s) (deriv ψ s) := by
      intro s hs
      have hUs : U ∈ 𝓝 s := hUo.mem_nhds hs
      have hs' : γ s ∈ c.source := by rw [hU] at hs; exact hs
      have heq : γ =ᶠ[𝓝 s] (c.symm ∘ ψ) := by
        filter_upwards [hUs] with s' hs''
        rw [hU] at hs''
        simp only [Function.comp, hψ]
        exact (c.left_inv hs'').symm
      have h1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s) := by
        have : ψ s = c (γ s) := by rw [hψ]
        rw [this]
        exact mdifferentiableAt_atlas_symm hcatlas (c.map_source hs')
      have h2 : MDifferentiableAt 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) ψ s :=
        (hψm.contMDiffAt hUs).mdifferentiableAt one_ne_zero
      unfold RiemannianMetric3.velocity
      have hB : (mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) ψ s) (1 : ℝ) = deriv ψ s := by
        rw [mfderiv_eq_fderiv]
        rfl
      rw [heq.mfderiv_eq, mfderiv_comp s h1 h2]
      exact congrArg (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s)) hB
    obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, F = fun s => ∑ i : Fin 3, ∑ j : Fin 3,
        deriv ψ s i * deriv ψ s j * coeffMatrix h.g c.symm (ψ s) i j := ⟨_, rfl⟩
    have hFeq : F =ᶠ[𝓝 t₀] (fun t => h.g (γ t) (RiemannianMetric3.velocity γ t)
        (RiemannianMetric3.velocity γ t)) := by
      filter_upwards [hUo.mem_nhds ht₀] with s hs
      have hs' : γ s ∈ c.source := by rw [hU] at hs; exact hs
      have hγs : γ s = c.symm (ψ s) := by rw [hψ]; exact (c.left_inv hs').symm
      rw [hvel s hs, hF]
      simp only [coeffMatrix]
      rw [hγs]
      exact (hexp _ _ _).symm
    have hFc : ContinuousAt F t₀ := by
      rw [hF]
      have hψc : ContinuousAt ψ t₀ := hψd.continuousOn.continuousAt (hUo.mem_nhds ht₀)
      have hdct : ContinuousAt (deriv ψ) t₀ := hdc.continuousAt (hUo.mem_nhds ht₀)
      have hwi : ∀ i : Fin 3, ContinuousAt (fun s => deriv ψ s i) t₀ := fun i =>
        (PiLp.continuous_apply 2 _ i).continuousAt.comp hdct
      have hψt : ψ t₀ ∈ c.target := by
        have : ψ t₀ = c (γ t₀) := by rw [hψ]
        rw [this]
        have hs' : γ t₀ ∈ c.source := by rw [hU] at ht₀; exact ht₀
        exact c.map_source hs'
      have hcoef : ∀ i j : Fin 3, ContinuousAt (fun s => coeffMatrix h.g c.symm (ψ s) i j) t₀ := by
        intro i j
        have h1 : ContinuousAt (fun y => coeffMatrix h.g c.symm y i j) (ψ t₀) := by
          have := h.smooth (γ t₀) i j
          rw [← hc] at this
          exact this.continuousOn.continuousAt (c.open_target.mem_nhds hψt)
        exact h1.comp hψc
      exact hsum3 t₀ _ (fun i => hsum3 t₀ _ (fun j => ((hwi i).mul (hwi j)).mul (hcoef i j)))
    exact hFc.congr hFeq
  
  have hnn : ∀ (h : RiemannianMetric3 M) (p q : M), 0 ≤ h.riemannianDist p q := by
    intro h p q
    unfold RiemannianMetric3.riemannianDist RiemannianMetric3.curveLength
    exact Real.iInf_nonneg (fun i =>
      intervalIntegral.integral_nonneg zero_le_one (fun t _ => Real.sqrt_nonneg _))
  have hcmp : ∀ (h₁ h₂ : RiemannianMetric3 M) (a : ℝ), 0 ≤ a →
      (∀ (p : M) (ξ : E3), a * h₁.g p ξ ξ ≤ h₂.g p ξ ξ) →
      ∀ p q : M, Real.sqrt a * h₁.riemannianDist p q ≤ h₂.riemannianDist p q := by
    intro h₁ h₂ a ha hle p q
    have hL : ∀ γ : ℝ → M, ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 γ →
        0 ≤ h₁.curveLength γ ∧ Real.sqrt a * h₁.curveLength γ ≤ h₂.curveLength γ := by
      intro γ hγ
      have c1 := (hspeed h₁ γ hγ).sqrt
      have c2 := (hspeed h₂ γ hγ).sqrt
      unfold RiemannianMetric3.curveLength
      refine ⟨intervalIntegral.integral_nonneg zero_le_one (fun t _ => Real.sqrt_nonneg _), ?_⟩
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_mono_on zero_le_one
        ((c1.intervalIntegrable 0 1).const_mul _) (c2.intervalIntegrable 0 1) (fun t _ => ?_)
      rw [← Real.sqrt_mul ha]
      exact Real.sqrt_le_sqrt (hle _ _)
    unfold RiemannianMetric3.riemannianDist
    rw [Real.mul_iInf_of_nonneg (Real.sqrt_nonneg a)]
    exact ciInf_mono ⟨0, by
        rintro _ ⟨i, rfl⟩; exact mul_nonneg (Real.sqrt_nonneg _) (hL i.1 i.2.1).1⟩
      (fun i => (hL i.1 i.2.1).2)
  
  have hgnn : ∀ (p : M) (ξ : E3), 0 ≤ g.g p ξ ξ := by
    intro p ξ
    by_cases hξ : ξ = 0
    · subst hξ; simp
    · exact (g.posDef p ξ hξ).le
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = max c₂ 1 := ⟨_, rfl⟩
  have hCpos : 0 < C := by rw [hCdef]; exact lt_max_of_lt_right one_pos
  have hle2 : ∀ (p : M) (ξ : E3), (1 / C) * g'.g p ξ ξ ≤ g.g p ξ ξ := by
    intro p ξ
    have h1 : g'.g p ξ ξ ≤ C * g.g p ξ ξ := (hhi p ξ).trans
      (mul_le_mul_of_nonneg_right (by rw [hCdef]; exact le_max_left _ _) (hgnn p ξ))
    rw [div_mul_eq_mul_div, one_mul, div_le_iff₀ hCpos]
    linarith
  have hd1 := hcmp g g' c₁ hc₁.le hlo
  have hd2 := hcmp g' g (1 / C) (by positivity) hle2
  have hk : 0 < Real.sqrt (1 / C) := Real.sqrt_pos.2 (by positivity)
  intro u hu
  have hu' : ∀ ε > 0, ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, g.riemannianDist (u m) (u n) < ε := by
    intro ε hε
    obtain ⟨N, hN⟩ := hu (Real.sqrt c₁ * ε) (mul_pos (Real.sqrt_pos.2 hc₁) hε)
    refine ⟨N, fun m hm n hn => ?_⟩
    have h3 : Real.sqrt c₁ * g.riemannianDist (u m) (u n) < Real.sqrt c₁ * ε :=
      lt_of_le_of_lt (hd1 _ _) (hN m hm n hn)
    exact lt_of_mul_lt_mul_left h3 (Real.sqrt_nonneg _)
  obtain ⟨p, hp⟩ := hC u hu'
  refine ⟨p, ?_⟩
  have ht : Tendsto (fun n => (Real.sqrt (1 / C))⁻¹ * g.riemannianDist (u n) p) atTop (𝓝 0) := by
    simpa using hp.const_mul (Real.sqrt (1 / C))⁻¹
  refine squeeze_zero (fun n => hnn g' (u n) p) (fun n => ?_) ht
  rw [le_inv_mul_iff₀ hk]
  exact hd2 (u n) p

theorem conformal_factor_decay (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (q q' R : ℝ) (hq : 0 < q) (hq' : 0 < q') (hR : 1 ≤ R)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hu : ContDiffOn ℝ ∞ u {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hudec : ∀ l : ℕ, l ≤ 2 → (fun x : E3 => ‖iteratedFDeriv ℝ l u x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q' - (l : ℝ)))
    (hG' : ∀ x : E3, R < ‖x‖ → G' x = ((1 + u x) ^ 4) • G x) :
    ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G' y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-(min q q') - (l : ℝ)) :=
by
  intro i j l hl
  have hev : ∀ᶠ x in Bornology.cobounded E3, 1 < ‖x‖ :=
    tendsto_norm_cobounded_atTop.eventually_gt_atTop 1
  have hopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have t_mono : ∀ (s s' : ℝ), s ≤ s' →
      (fun x : E3 => ‖x‖ ^ s) =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ s' := by
    intro s s' hss
    refine Asymptotics.IsBigO.of_bound 1 ?_
    filter_upwards [hev] with x hx
    rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
      Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _), one_mul]
    exact Real.rpow_le_rpow_of_exponent_le hx.le hss
  
  have t_lincomb : ∀ (f g : E3 → ℝ) (m₁ m₂ m α β : ℝ), m₁ ≤ m → m₂ ≤ m →
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => α * f y + β * g y) m := by
    intro f g m₁ m₂ m α β h₁ h₂ hf hg
    refine ⟨(contDiffOn_const.mul hf.1).add (contDiffOn_const.mul hg.1), fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => α * f y + β * g y) x‖‖ ≤
          1 * ‖|α| * ‖iteratedFDeriv ℝ l f x‖ + |β| * ‖iteratedFDeriv ℝ l g x‖‖ := by
      filter_upwards [hev] with x hx
      have hfx : ContDiffAt ℝ l f x :=
        (hf.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have hgx : ContDiffAt ℝ l g x :=
        (hg.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have e : (fun y => α * f y + β * g y) = α • f + β • g := by
        funext y; simp [smul_eq_mul]
      have hfs : ContDiffAt ℝ l (α • f) x := hfx.const_smul α
      have hgs : ContDiffAt ℝ l (β • g) x := hgx.const_smul β
      rw [e, iteratedFDeriv_add_apply hfs hgs,
        iteratedFDeriv_const_smul_apply hfx, iteratedFDeriv_const_smul_apply hgx, norm_norm,
        one_mul, Real.norm_of_nonneg (by positivity)]
      calc _ ≤ ‖α • iteratedFDeriv ℝ l f x‖ + ‖β • iteratedFDeriv ℝ l g x‖ := norm_add_le _ _
        _ = _ := by rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
    have b1 := ((hf.2 l hl).const_mul_left |α|).trans (t_mono (m₁ - l) (m - l) (by linarith))
    have b2 := ((hg.2 l hl).const_mul_left |β|).trans (t_mono (m₂ - l) (m - l) (by linarith))
    exact (Asymptotics.IsBigO.of_bound 1 key).trans (b1.add b2)
  
  have t_mul : ∀ (f g : E3 → ℝ) (m₁ m₂ : ℝ),
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => f y * g y) (m₁ + m₂) := by
    intro f g m₁ m₂ hf hg
    refine ⟨hf.1.mul hg.1, fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => f y * g y) x‖‖ ≤
          1 * ‖∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) * ‖iteratedFDeriv ℝ k f x‖ *
            ‖iteratedFDeriv ℝ (l - k) g x‖‖ := by
      filter_upwards [hev] with x hx
      have h := norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hopen.uniqueDiffOn hx (n := l)
        (by exact_mod_cast le_top)
      have hw : ∀ (n : ℕ) (u : E3 → ℝ),
          iteratedFDerivWithin ℝ n u {x : E3 | 1 < ‖x‖} x = iteratedFDeriv ℝ n u x :=
        fun n u => iteratedFDerivWithin_of_isOpen n hopen hx
      simp only [hw] at h
      rw [norm_norm, one_mul, Real.norm_of_nonneg (Finset.sum_nonneg (fun k _ => by positivity))]
      exact h
    have hsum : (fun x => ∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) *
        ‖iteratedFDeriv ℝ k f x‖ * ‖iteratedFDeriv ℝ (l - k) g x‖) =O[Bornology.cobounded E3]
        (fun x : E3 => ‖x‖ ^ (m₁ + m₂ - (l : ℝ))) := by
      apply Asymptotics.IsBigO.sum
      intro k hk
      have hkl : k ≤ l := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have h1 :=
        ((hf.2 k (by omega)).const_mul_left (l.choose k : ℝ)).mul (hg.2 (l - k) (by omega))
      refine h1.congr' (Eventually.of_forall fun x => rfl) ?_
      filter_upwards [hev] with x hx
      rw [← Real.rpow_add (by linarith)]
      congr 1
      rw [Nat.cast_sub hkl]
      ring
    exact (Asymptotics.IsBigO.of_bound 1 key).trans hsum
  
  have hus : cdecaySym u (-q') := ⟨hu, hudec⟩
  
  have hu2 := t_mul _ _ _ _ hus hus
  have hu3 := t_mul _ _ _ _ hu2 hus
  have hu4 := t_mul _ _ _ _ hu3 hus
  have hA := t_lincomb _ _ _ _ (-q') 4 6 le_rfl (by linarith) hus hu2
  have hB := t_lincomb _ _ _ _ (-q') 4 1 (by linarith) (by linarith) hu3 hu4
  have hV' := t_lincomb _ _ _ _ (-q') 1 1 le_rfl le_rfl hA hB
  obtain ⟨V, hVdef⟩ : ∃ V : E3 → ℝ, V = fun y => (1 + u y) ^ 4 - 1 := ⟨_, rfl⟩
  have hV : cdecaySym V (-q') := by
    have e : V = fun y => 1 * (4 * u y + 6 * (u y * u y)) +
        1 * (4 * (u y * u y * u y) + 1 * (u y * u y * u y * u y)) := by
      rw [hVdef]; funext y; ring
    rw [e]; exact hV'
  
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = if i = j then (1 : ℝ) else 0 := ⟨_, rfl⟩
  obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun y => G y i j - c := ⟨_, rfl⟩
  have hh : cdecaySym h (-q) := by
    refine ⟨?_, ?_⟩
    · rw [hhdef]; exact (hsmooth i j).sub contDiffOn_const
    · intro l hl
      rw [hhdef, hc]
      exact hdecay i j l hl
  have hVh := t_mul _ _ _ _ hV hh
  have hmin1 := min_le_left q q'
  have hmin2 := min_le_right q q'
  have hT := t_lincomb _ _ (-q) (-q' + -q) (-(min q q')) 1 1 (by linarith) (by linarith) hh hVh
  have hH := t_lincomb _ _ (-(min q q')) (-q') (-(min q q')) 1 c le_rfl (by linarith) hT hV
  have hfarnhds : ∀ x : E3, R < ‖x‖ →
      (fun y => G' y i j - if i = j then (1 : ℝ) else 0) =ᶠ[𝓝 x]
        (fun y => 1 * (1 * h y + 1 * (V y * h y)) + c * V y) := by
    intro x hx
    refine Filter.eventuallyEq_of_mem
      ((isOpen_lt continuous_const continuous_norm).mem_nhds hx) ?_
    intro y hy
    have hy' : R < ‖y‖ := hy
    have hGy : G' y i j = (1 + u y) ^ 4 * G y i j := by
      rw [hG' y hy', Matrix.smul_apply, smul_eq_mul]
    simp only
    rw [hGy, ← hc, hhdef, hVdef]
    ring
  refine (hH.2 l hl).congr' ?_ (EventuallyEq.rfl)
  filter_upwards [tendsto_norm_cobounded_atTop.eventually_gt_atTop R] with x hx
  rw [((hfarnhds x hx).iteratedFDeriv ℝ l).eq_of_nhds]

theorem conformal_flux_difference (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (q q' R : ℝ) (hq : 1 / 2 < q) (hq' : 1 / 2 < q') (hR : 1 ≤ R)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hu : ContDiffOn ℝ ∞ u {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hudec : ∀ l : ℕ, l ≤ 2 → (fun x : E3 => ‖iteratedFDeriv ℝ l u x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q' - (l : ℝ)))
    (hG' : ∀ x : E3, R < ‖x‖ → G' x = ((1 + u x) ^ 4) • G x) :
    Tendsto (fun r : ℝ => fluxLocal G' r - fluxLocal G r -
      4 * fluxLocal (fun x => (1 + u x) • (1 : Matrix (Fin 3) (Fin 3) ℝ)) r) atTop (𝓝 0) :=
by
  classical
  
  have hnorm : ∀ r : ℝ, 0 < r → ∀ θ : sphere (0 : E3) 1, ‖r • (θ : E3)‖ = r := by
    intro r hr θ
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr, norm_eq_of_mem_sphere θ, mul_one]
  have hθle : ∀ (θ : sphere (0 : E3) 1) (i : Fin 3), |(θ : E3) i| ≤ 1 := by
    intro θ i
    have h := PiLp.norm_apply_le (θ : E3) i
    rw [norm_eq_of_mem_sphere θ, Real.norm_eq_abs] at h
    exact h
  have hSopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hUopen : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hpd : ∀ (f : E3 → ℝ) (k : Fin 3) (y : E3), |partialDeriv k f y| ≤ ‖fderiv ℝ f y‖ := by
    intro f k y
