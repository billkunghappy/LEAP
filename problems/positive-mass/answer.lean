          (Y ((chartAt E3 (q j)).symm y)) →
        wZ = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
          (Z ((chartAt E3 (q j)).symm y)) →
        ∀ i : Fin 3,
          wV i = (1 - calTheta r η (ρ ((chartAt E3 (q j)).symm y))) * wY i +
            calTheta r η (ρ ((chartAt E3 (q j)).symm y)) *
              calUnitNormal (g.coeff (chartAt E3 (q j)).symm)
                (fun z => ρ ((chartAt E3 (q j)).symm z)) y i ∧
          wZ i = calTheta r η (ρ ((chartAt E3 (q j)).symm y)) *
              calUnitNormal (g.coeff (chartAt E3 (q j)).symm)
                (fun z => ρ ((chartAt E3 (q j)).symm z)) y i := by
    intro η hη
    have hθ := ccs_theta_props r η hη
    have hΘs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => μ x * calTheta r η (ρ x)) :=
      hμs.mul (hθ.1.comp_contMDiff hρ)
    have hΘ01 : ∀ x, 0 ≤ μ x * calTheta r η (ρ x) ∧ μ x * calTheta r η (ρ x) ≤ 1 :=
      fun x => ⟨mul_nonneg (hμ01 x).1 (hθ.2.1 _),
        mul_le_one₀ (hμ01 x).2 (hθ.2.1 _) (hθ.2.2.1 _)⟩
    have hΘT : tsupport (fun x => μ x * calTheta r η (ρ x)) ⊆ T :=
      (tsupport_mul_subset_left).trans hμT
    obtain ⟨V, Z, hV, hV1, hZ, hVZ⟩ := slab_blend_field g ρ (fun x => μ x * calTheta r η (ρ x))
      T hρ hT hN hΘs hΘ01 hΘT Y hY hY1
    refine ⟨V, Z, hV, hV1, hZ, fun j y hy hyφ wV wY wZ hwV hwY hwZ i => ?_⟩
    have h := hVZ (q j) y hy wV wY wZ hwV hwY hwZ i
    simp only [hμφ j _ hyφ, one_mul] at h
    exact h
  
  obtain ⟨V₁, Z₁, -, -, -, hVZ₁⟩ := blend 1 one_pos
  have hint0 : ∀ j, MeasureTheory.IntegrableOn (fun y => φ j ((chartAt E3 (q j)).symm y) *
        g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)
        (chartAt E3 (q j) '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 (q j)).source)) ∧
      MeasureTheory.IntegrableOn (fun y => sepDensDiv (g.coeff (chartAt E3 (q j)).symm)
        (calPiece (q j) (φ j) Y) y)
        (chartAt E3 (q j) '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have h := slab_chart_step g ρ r 1 T F hρ hT hF one_pos (q j)
      (fun y hy hyT => hN (q j) y hy hyT) (φ j) (hφ.1 j) (hφ.2.1 j) (hφ.2.2.2 j).1 (hφT j)
      Y V₁ Z₁ hY hY1 (hVZ₁ j)
    exact ⟨h.1, h.2.1⟩
  refine ⟨fun j => (hint0 j).1, ?_⟩
  
  obtain ⟨S, hSdef⟩ : ∃ S : Fin n → Set E3, S = fun j => chartAt E3 (q j) ''
      ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 (q j)).source) := ⟨_, rfl⟩
  obtain ⟨f, hfdef⟩ : ∃ f : Fin n → E3 → ℝ, f = fun j y => ρ ((chartAt E3 (q j)).symm y) :=
    ⟨_, rfl⟩
  obtain ⟨d, hddef⟩ : ∃ d : Fin n → E3 → ℝ, d = fun j y => φ j ((chartAt E3 (q j)).symm y) *
      g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  obtain ⟨ee, heedef⟩ : ∃ ee : Fin n → E3 → ℝ, ee = fun j y =>
      sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) Y) y := ⟨_, rfl⟩
  have hSm : ∀ j, MeasurableSet (S j) := by
    intro j
    rw [hSdef]
    exact hDm (q j)
  have hSt : ∀ j, S j ⊆ (chartAt E3 (q j)).target := by
    intro j
    rw [hSdef]
    rintro _ ⟨x, ⟨_, hxs⟩, rfl⟩
    exact (chartAt E3 (q j)).map_source hxs
  have hfc : ∀ j, ContinuousOn (f j) (S j) := by
    intro j
    have h : ContinuousOn (fun y => ρ ((chartAt E3 (q j)).symm y)) (S j) :=
      hρc.comp_continuousOn ((chartAt E3 (q j)).continuousOn_symm.mono (hSt j))
    rw [hfdef]
    exact h
  have hfS : ∀ j, ∀ y ∈ S j, r < f j y := by
    intro j y hy
    rw [hSdef] at hy
    obtain ⟨x, ⟨hxD, hxs⟩, rfl⟩ := hy
    rw [hfdef]
    show r < ρ ((chartAt E3 (q j)).symm (chartAt E3 (q j) x))
    rw [(chartAt E3 (q j)).left_inv hxs]
    exact hxD.2
  have hint : ∀ j, IntegrableOn (d j) (S j) ∧ IntegrableOn (ee j) (S j) := by
    intro j
    rw [hSdef, hddef, heedef]
    exact hint0 j
  
  have hlim : ∀ (T' : Set E3), MeasurableSet T' → ∀ (u w : E3 → ℝ), ContinuousOn u T' →
      (∀ y ∈ T', r < u y) → IntegrableOn w T' →
      Tendsto (fun η : ℝ => ∫ y in T', calTheta r η (u y) * w y) (𝓝[>] 0)
        (𝓝 (∫ y in T', w y)) := by
    intro T' hT' u w hu huT hw
    refine tendsto_integral_filter_of_dominated_convergence (fun y => ‖w y‖) ?_ ?_ hw.norm ?_
    · refine Filter.Eventually.of_forall (fun η => ?_)
      have hθ : Continuous (fun t : ℝ => calTheta r η t) := by
        unfold calTheta
        exact Real.smoothTransition.continuous.comp (by fun_prop)
      exact ((hθ.comp_continuousOn hu).aestronglyMeasurable hT').mul hw.aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun η => Filter.Eventually.of_forall (fun y => ?_))
      have h0 := Real.smoothTransition.nonneg (2 * ((u y - r) / η) - 1)
      have h1 := Real.smoothTransition.le_one (2 * ((u y - r) / η) - 1)
      have hle : ‖calTheta r η (u y)‖ ≤ 1 := by
        unfold calTheta
        rw [Real.norm_eq_abs, abs_of_nonneg h0]
        exact h1
      rw [norm_mul]
      calc ‖calTheta r η (u y)‖ * ‖w y‖ ≤ 1 * ‖w y‖ :=
            mul_le_mul_of_nonneg_right hle (norm_nonneg _)
        _ = ‖w y‖ := one_mul _
    · refine ae_restrict_of_forall_mem hT' (fun y hy => ?_)
      have hδ : 0 < u y - r := sub_pos.2 (huT y hy)
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hδ] with η hη
      have hη0 : 0 < η := hη.1
      have h1 : 1 ≤ 2 * ((u y - r) / η) - 1 := by
        have h2 : 1 < (u y - r) / η := by
          rw [lt_div_iff₀ hη0]
          linarith [hη.2]
        linarith
      unfold calTheta
      rw [Real.smoothTransition.one_of_one_le h1, one_mul]
  
  have hΦ : Tendsto (fun η : ℝ => ∑ j, ((∫ y in S j, calTheta r η (f j y) * d j y) +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r η (f j y) * ee j y))) (𝓝[>] 0)
      (𝓝 (∑ j, ((∫ y in S j, d j y) + ((∫ y in S j, ee j y) - ∫ y in S j, ee j y)))) :=
    tendsto_finset_sum _ (fun j _ => (hlim _ (hSm j) _ _ (hfc j) (hfS j) (hint j).1).add
      (tendsto_const_nhds.sub (hlim _ (hSm j) _ _ (hfc j) (hfS j) (hint j).2)))
  have hL : (∑ j, ((∫ y in S j, d j y) + ((∫ y in S j, ee j y) - ∫ y in S j, ee j y))) =
      calVolSum g q φ (F ∩ T ∩ {x | r < ρ x}) (fun x => g.levelMeanCurv ρ x) := by
    simp only [sub_self, add_zero]
    rw [hSdef, hddef]
    rfl
  rw [hL] at hΦ
  obtain ⟨η, hηΦ, hη⟩ := ((hΦ.eventually (lt_mem_nhds (sub_lt_self _ hε))).and
    eventually_mem_nhdsWithin).exists
  have hη0 : 0 < η := hη
  
  obtain ⟨V, Z, hV, hV1, hZ, hVZ⟩ := blend η hη0
  refine ⟨V, hV, hV1, ?_⟩
  obtain ⟨Mt, hMdef⟩ : ∃ Mt : Fin n → ℝ, Mt = fun j => ∫ y in S j,
      Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (Z ((chartAt E3 (q j)).symm y)) : E3) := ⟨_, rfl⟩
  
  have hcancel : ∑ j, Mt j = 0 := by
    rw [hMdef, hSdef]
    exact cal_partition_div_cancel g Ω q φ hφ O hO hφ1 Z hZ _ hDm hDO
  
  have hineq : ∀ j, ((∫ y in S j, calTheta r η (f j y) * d j y) + Mt j +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r η (f j y) * ee j y)) ≤
      (∫ y in chartAt E3 (q j) '' (F ∩ (chartAt E3 (q j)).source),
          sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) V) y) -
        ∫ y in chartAt E3 (q j) '' ((F \ (T ∩ {x | r < ρ x})) ∩ (chartAt E3 (q j)).source),
          sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) Y) y := by
    intro j
    have h := slab_chart_step g ρ r η T F hρ hT hF hη0 (q j)
      (fun y hy hyT => hN (q j) y hy hyT) (φ j) (hφ.1 j) (hφ.2.1 j) (hφ.2.2.2 j).1 (hφT j)
      Y V Z hY hY1 (hVZ j)
    rw [hMdef, hSdef, hfdef, hddef, heedef]
    exact h.2.2
  have hsum := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => hineq j)
  have e1 : ∑ j, ((∫ y in S j, calTheta r η (f j y) * d j y) + Mt j +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r η (f j y) * ee j y)) =
      ∑ j, ((∫ y in S j, calTheta r η (f j y) * d j y) +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r η (f j y) * ee j y)) + ∑ j, Mt j := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  rw [e1, hcancel, add_zero, Finset.sum_sub_distrib] at hsum
  unfold calDivSum
  linarith

theorem calVolSum_pos_null [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω : Set M) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (D : Set M) (hD : sepChartMeas D) (hD1 : ∀ x ∈ D, ∑ j, φ j x = 1) (h : M → ℝ) (hpos : ∀ x ∈ D, 0 < h x) (hint : ∀ j, MeasureTheory.IntegrableOn (fun y => φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) * Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) (chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source))) (h0 : calVolSum g q φ D h ≤ 0) : sepChartNull D :=
by
  classical
  
  have hposdef : ∀ (p : M) (y : E3), y ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro p y hy
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos' := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos'
  
  have htrans : ∀ (p : M) (N : Set M), N ⊆ (chartAt E3 p).source →
      volume (chartAt E3 p '' N) = 0 → sepChartNull N := by
    intro p N hN hN0 r
    have hs0 : volume (chartAt E3 p '' (N ∩ (chartAt E3 r).source)) = 0 :=
      measure_mono_null (Set.image_mono Set.inter_subset_left) hN0
    have himg : (chartAt E3 r ∘ (chartAt E3 p).symm) ''
        (chartAt E3 p '' (N ∩ (chartAt E3 r).source))
        = chartAt E3 r '' (N ∩ (chartAt E3 r).source) := by
      rw [Set.image_image]
      refine Set.EqOn.image_eq ?_
      intro x hx
      simp only [Function.comp_apply]
      rw [(chartAt E3 p).left_inv (hN hx.1)]
    have hsm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 r ∘ (chartAt E3 p).symm)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 r).source) :=
      (contMDiffOn_chart (x := r)).comp
        ((contMDiffOn_chart_symm (x := p)).mono Set.inter_subset_left) Set.inter_subset_right
    have hcd : ContDiffOn ℝ ∞ (chartAt E3 r ∘ (chartAt E3 p).symm)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 r).source) :=
      contMDiffOn_iff_contDiffOn.mp hsm
    have hsub : chartAt E3 p '' (N ∩ (chartAt E3 r).source) ⊆
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 r).source) := by
      rintro _ ⟨x, hx, rfl⟩
      refine ⟨(chartAt E3 p).map_source (hN hx.1), ?_⟩
      show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 r).source
      rw [(chartAt E3 p).left_inv (hN hx.1)]
      exact hx.2
    have hdiff : DifferentiableOn ℝ (chartAt E3 r ∘ (chartAt E3 p).symm)
        (chartAt E3 p '' (N ∩ (chartAt E3 r).source)) :=
      (hcd.differentiableOn (by simp)).mono hsub
    rw [← himg]
    exact MeasureTheory.addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume
      hdiff hs0
  
  have hfacts : ∀ j, ∀ y ∈ chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      0 ≤ φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := by
    rintro j _ ⟨x, ⟨hxD, hxs⟩, rfl⟩
    rw [(chartAt E3 (q j)).left_inv hxs]
    exact mul_nonneg (mul_nonneg (hφ.2.1 j x) (hpos x hxD).le) (Real.sqrt_nonneg _)
  have hnn : ∀ j, 0 ≤ ∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det :=
    fun j => MeasureTheory.setIntegral_nonneg (hD (q j)) (hfacts j)
  
  have hzero : ∀ j, (∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) = 0 := by
    have h0' : ∑ j, (∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
        φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
          Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) ≤ 0 := h0
    have h1 := le_antisymm h0' (Finset.sum_nonneg fun j _ => hnn j)
    intro j
    exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hnn j)).1 h1 j (Finset.mem_univ j)
  
  have hnull : ∀ j, volume (chartAt E3 (q j) ''
      (D ∩ (chartAt E3 (q j)).source ∩ {x | φ j x ≠ 0})) = 0 := by
    intro j
    have hae := (MeasureTheory.setIntegral_eq_zero_iff_of_nonneg_ae
      (MeasureTheory.ae_restrict_of_forall_mem (hD (q j)) (hfacts j)) (hint j)).1 (hzero j)
    rw [Filter.EventuallyEq, MeasureTheory.ae_restrict_iff' (hD (q j)),
      MeasureTheory.ae_iff] at hae
    refine measure_mono_null ?_ hae
    rintro _ ⟨x, ⟨⟨hxD, hxs⟩, hx0⟩, rfl⟩
    show ¬ _
    intro hc
    have hc' := hc ⟨x, ⟨hxD, hxs⟩, rfl⟩
    simp only [Pi.zero_apply] at hc'
    rw [(chartAt E3 (q j)).left_inv hxs] at hc'
    have hdet := (hposdef (q j) _ ((chartAt E3 (q j)).map_source hxs)).det_pos
    exact (mul_ne_zero (mul_ne_zero hx0 (hpos x hxD).ne') (Real.sqrt_pos.2 hdet).ne') hc'
  have hNnull : ∀ j, sepChartNull (D ∩ (chartAt E3 (q j)).source ∩ {x | φ j x ≠ 0}) :=
    fun j => htrans (q j) _ (fun x hx => hx.1.2) (hnull j)
  
  intro p
  have hsub : chartAt E3 p '' (D ∩ (chartAt E3 p).source) ⊆
      ⋃ j, chartAt E3 p '' ((D ∩ (chartAt E3 (q j)).source ∩ {x | φ j x ≠ 0}) ∩
        (chartAt E3 p).source) := by
    rintro _ ⟨x, ⟨hxD, hxp⟩, rfl⟩
    have hne : ∑ j, φ j x ≠ 0 := by
      rw [hD1 x hxD]
      exact one_ne_zero
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    have hxs : x ∈ (chartAt E3 (q j)).source :=
      ((hφ.2.2.2 j).2 (subset_tsupport _ (Function.mem_support.2 hj))).2
    exact Set.mem_iUnion.2 ⟨j, x, ⟨⟨⟨hxD, hxs⟩, hj⟩, hxp⟩, rfl⟩
  exact measure_mono_null hsub (measure_iUnion_null fun j => hNnull j p)

theorem hullMinimizer_slab_null [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F U K T : Set M) (w : M → ℝ) (b c : ℝ) (hU : IsOpen U) (hK : IsClosed K) (hT : IsOpen T) (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w T) (hb : 0 < b) (hc : 0 < c) (hslab : IsCompact (closure (T ∩ {x | -c ≤ w x ∧ w x ≤ b}))) (hslabT : closure (T ∩ {x | -c ≤ w x ∧ w x ≤ b}) ⊆ T ∩ U) (hdw : ∀ x ∈ T, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) (hmc : ∀ x ∈ T, -c ≤ w x → w x ≤ b → g.levelMeanCurv w x < 0) (hKT : ∀ x ∈ K ∩ T, w x = 0) (hFm : sepChartMeas F) (hFT : ∀ x ∈ F ∩ T, 0 < w x) (hfin : hullRiemPer g F U K < ⊤) (hmin : hullRiemPer g F U K ≤ hullRiemPer g (F \ (T ∩ {x | w x < b})) U K) : sepChartNull (F ∩ T ∩ {x | w x < b}) :=
by
  classical
  
  
  
  have himg : ∀ (X : Set M) (p : M), chartAt E3 p '' (X ∩ (chartAt E3 p).source) =
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' X := by
    intro X p
    rw [Set.inter_comm]
    exact (chartAt E3 p).image_source_inter_eq' X
  have hOpenMeas : ∀ A : Set M, IsOpen A → sepChartMeas A := by
    intro A hA p
    exact ((chartAt E3 p).isOpen_image_of_subset_source (hA.inter (chartAt E3 p).open_source)
      Set.inter_subset_right).measurableSet
  have hMeasInter : ∀ A B : Set M, sepChartMeas A → IsOpen B → sepChartMeas (A ∩ B) := by
    intro A B hA hB p
    have h1 := hA p
    have h2 := hOpenMeas B hB p
    rw [himg] at h1 h2 ⊢
    have heq : (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (A ∩ B) =
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' A) ∩
          ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' B) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage]
      tauto
    rw [heq]
    exact h1.inter h2
  have hMeasDiff : ∀ A B : Set M, sepChartMeas A → IsOpen B → sepChartMeas (A \ B) := by
    intro A B hA hB p
    have h1 := hA p
    have h2 := hOpenMeas B hB p
    rw [himg] at h1 h2 ⊢
    have heq : (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (A \ B) =
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' A) \
          ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' B) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff]
      tauto
    rw [heq]
    exact h1.diff h2
  have hmonoG : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (A U K₁ K₂ : Set E3), K₁ ⊆ K₂ →
      hullPerG G A U K₁ ≤ hullPerG G A U K₂ := by
    intro G A U K₁ K₂ h
    unfold hullPerG
    refine iSup_mono fun X => iSup_le fun hX => ?_
    refine le_iSup_of_le (⟨fun y hy => hX.1 y (fun h' => hy (h h')), hX.2⟩ :
      (∀ y, y ∉ K₂ → ContDiffAt ℝ ∞ X y) ∧ HasCompactSupport X ∧
      tsupport X ⊆ U ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) ∧
      ∃ C : ℝ, ∀ y, |sepDensDiv G X y| ≤ C) le_rfl
  have hmono : ∀ (A U K₁ K₂ : Set M), K₁ ⊆ K₂ →
      hullRiemPer g A U K₁ ≤ hullRiemPer g A U K₂ := by
    intro A U K₁ K₂ h
    unfold hullRiemPer
    refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun _ => ?_
    exact Finset.sum_le_sum fun k _ =>
      hmonoG _ _ _ _ _ (Set.image_subset _ (Set.inter_subset_inter_left _ h))
  have hwc : ContinuousOn w T := hw.continuousOn
  
  
  
  obtain ⟨Z, hZdef⟩ : ∃ Z : Set M, Z = T ∩ {x | w x < b} := ⟨_, rfl⟩
  rw [← hZdef] at hmin
  obtain ⟨F', hF'def⟩ : ∃ F' : Set M, F' = F \ Z := ⟨_, rfl⟩
  rw [← hF'def] at hmin
  obtain ⟨D, hDdef⟩ : ∃ D : Set M, D = F ∩ T ∩ {x | w x < b} := ⟨_, rfl⟩
  rw [← hDdef]
  obtain ⟨Sl, hSldef⟩ : ∃ Sl : Set M, Sl = closure (T ∩ {x | -c ≤ w x ∧ w x ≤ b}) := ⟨_, rfl⟩
  rw [← hSldef] at hslab hslabT
  have hZo : IsOpen Z := by rw [hZdef]; exact hwc.isOpen_inter_preimage hT isOpen_Iio
  have hF'm : sepChartMeas F' := by rw [hF'def]; exact hMeasDiff F Z hFm hZo
  have hDZ : D = F ∩ Z := by rw [hDdef, hZdef, Set.inter_assoc]
  have hDm : sepChartMeas D := by rw [hDZ]; exact hMeasInter F Z hFm hZo
  have hSlT : Sl ⊆ T := fun x hx => (hslabT hx).1
  have hSlU : Sl ⊆ U := fun x hx => (hslabT hx).2
  have hmemSl : ∀ x ∈ T, -c ≤ w x → w x ≤ b → x ∈ Sl := fun x hx h1 h2 => by
    rw [hSldef]; exact subset_closure ⟨hx, h1, h2⟩
  have hDSl : D ⊆ Sl := by
    intro x hx
    rw [hDdef] at hx
    obtain ⟨⟨hxF, hxT⟩, hxb⟩ := hx
    have h0 := hFT x ⟨hxF, hxT⟩
    have hxb' : w x < b := hxb
    exact hmemSl x hxT (by linarith) hxb'.le
  have hFF' : ∀ x, x ∉ D → (x ∈ F' ↔ x ∈ F) := by
    intro x hxD
    rw [hF'def]
