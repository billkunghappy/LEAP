  have hNfacts : ∀ i : Fin r, ContDiffOn ℝ ∞ (hcrNormalField G (φ i)) (V i ∩ U) ∧
      ∀ z ∈ V i ∩ U, ∀ w : E3, ∑ a : Fin 3, ∑ b : Fin 3, G z a b * w a * w b ≤ 1 →
        |fderiv ℝ (φ i) z w| ≤ fderiv ℝ (φ i) z (hcrNormalField G (φ i) z) := by
    intro i
