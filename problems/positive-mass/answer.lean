          rw [bm.support_normed_eq]
          intro hmem
          rw [Metric.mem_ball, dist_zero_right] at hmem
          have hy0 : (x + (2 * bm.rOut) • e 0 - t) 0 = x 0 + 2 * bm.rOut - t 0 := by simp
          have hyabs : |(x + (2 * bm.rOut) • e 0 - t) 0| ≤ ‖x + (2 * bm.rOut) • e 0 - t‖ := by
