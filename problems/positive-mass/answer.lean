        rw [dist_eq_norm, dist_eq_norm]
        calc ‖t - c‖ = ‖(t - (4 * bm.rOut) • e 0 - c) + (4 * bm.rOut) • e 0‖ := by
              congr 1; abel
          _ ≤ _ := norm_add_le _ _
      refine ⟨?_, ?_⟩
      · show dist t c < s + 4 * bm.rOut
        linarith
      · show (0 : ℝ) < t 0
        linarith
  
  have hvanT : ∀ (bm : ContDiffBump (0 : E3)) (u : E3 → ℝ), (∀ t, t ∉ fcrHalf c s₂ → u t = 0) →
