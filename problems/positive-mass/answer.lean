    have h2 : (b - a) * P ≤ ℓ (hpProj z) - ℓ x₀ := by
      have h3 : P ≤ (ℓ (hpProj z) - a) / (b - a) - (ℓ x₀ - a) / (b - a) := by linarith
      rw [div_sub_div_same, le_div_iff₀ hε] at h3
      linarith
    linarith
  · intro φ hφ x₀ hx₀ hle heq hgrad
    by_contra hcon
    push_neg at hcon
    have hx₀' : ‖x₀‖ < 1 / 2 := mem_ball_zero_iff.1 hx₀
    obtain ⟨hl1, hl2, hl3⟩ := hi x₀ hx₀
    have hm : |υ x₀| < 1 / 2 := abs_lt.2 ⟨by linarith, by linarith⟩
    obtain ⟨N, hN, hNle⟩ := hle.exists_mem
    obtain ⟨W, f, hWo, hWU, hf, hpW, hf0, hsign, hset⟩ :=
      hcase (-1) υ φ x₀ N (Or.inr rfl) hφ hx₀' hm hN hgrad hcon
    refine (htouch W f (hpLift (υ x₀) x₀) hWo hWU hf hpW hf0 (hii x₀ hx₀).2).2
      (fun z hz => by have := hsign z hz; linarith) ?_
    refine measure_mono_null ?_ hiv2
    rintro z ⟨⟨hzW, hfz⟩, hzF⟩
    obtain ⟨hzc, hzN, P, hfeq, hP⟩ := hset z hzW
    refine ⟨⟨hzc, ?_⟩, hzF⟩
    have h1 : φ (hpProj z) ≤ (b - υ (hpProj z)) / (b - a) := hNle _ hzN
    have heq' : φ x₀ = (b - υ x₀) / (b - a) := heq
    have hfz' : 0 < f z := hfz
    rw [hfeq] at hfz'
    have h2 : (b - a) * P ≤ υ x₀ - υ (hpProj z) := by
      have h3 : P ≤ (b - υ (hpProj z)) / (b - a) - (b - υ x₀) / (b - a) := by linarith
      rw [div_sub_div_same, le_div_iff₀ hε] at h3
      linarith
    linarith

theorem hpWH_rpow_ball : ∀ (x : E2) (a : ℝ), 0 ≤ a → a < 2 →
    ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-a)) ≤
      ENNReal.ofReal (2 * Real.pi / (2 - a)) :=
by
  intro x a _ha0 ha2
  set φ : ℝ → ℝ := (Set.Iio (1 : ℝ)).indicator (fun r : ℝ => r ^ (-a)) with hφ
  
  have hEq : Set.EqOn (fun y : ℝ => y * φ y)
      ((Set.Iio (1 : ℝ)).indicator (fun y : ℝ => y ^ (1 - a))) (Set.Ioi 0) := by
    intro y hy
    have hy0 : (0 : ℝ) < y := hy
    by_cases h1 : y < 1
    · have hm : y ∈ Set.Iio (1 : ℝ) := h1
      simp only [hφ, Set.indicator_of_mem hm]
      rw [show (1 - a) = 1 + (-a) by ring, Real.rpow_add hy0, Real.rpow_one]
    · have hm : y ∉ Set.Iio (1 : ℝ) := h1
      simp only [hφ, Set.indicator_of_notMem hm, mul_zero]
  have hgi : MeasureTheory.IntegrableOn (fun y : ℝ => y ^ (1 - a)) (Set.Ioo 0 1) :=
    (intervalIntegrable_iff_integrableOn_Ioo_of_le zero_le_one).1
      (intervalIntegral.intervalIntegrable_rpow' (by linarith))
  have hHint : MeasureTheory.IntegrableOn
      ((Set.Iio (1 : ℝ)).indicator (fun y : ℝ => y ^ (1 - a))) (Set.Ioi 0) := by
    rw [MeasureTheory.IntegrableOn, MeasureTheory.integrable_indicator_iff measurableSet_Iio,
      MeasureTheory.IntegrableOn, MeasureTheory.Measure.restrict_restrict measurableSet_Iio,
      Set.Iio_inter_Ioi]
    exact hgi
  have hFint : MeasureTheory.IntegrableOn (fun y : ℝ => y * φ y) (Set.Ioi 0) :=
    hHint.congr_fun hEq.symm measurableSet_Ioi
  have hFval : (∫ y in Set.Ioi (0 : ℝ), y * φ y) = 1 / (2 - a) := by
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi hEq,
      MeasureTheory.setIntegral_indicator measurableSet_Iio, Set.Ioi_inter_Iio,
      ← MeasureTheory.integral_Ioc_eq_integral_Ioo,
      ← intervalIntegral.integral_of_le zero_le_one,
      integral_rpow (Or.inl (by linarith))]
    have h2a : (2 - a) ≠ 0 := by linarith
    rw [show 1 - a + 1 = 2 - a by ring, Real.one_rpow, Real.zero_rpow h2a]
    simp
  
  have hfin : Module.finrank ℝ E2 = 2 := finrank_euclideanSpace_fin
  have hrad : (fun y : ℝ => y ^ (Module.finrank ℝ E2 - 1) • φ y) = fun y : ℝ => y * φ y := by
    funext y
    rw [hfin]
    simp
  have hint : MeasureTheory.Integrable (fun z : E2 => φ ‖z‖) MeasureTheory.volume := by
    rw [MeasureTheory.integrable_fun_norm_addHaar MeasureTheory.volume, hrad]
    exact hFint
  have hnn : 0 ≤ᵐ[MeasureTheory.volume] fun z : E2 => φ ‖z‖ := by
    refine Filter.Eventually.of_forall (fun z => ?_)
    show 0 ≤ φ ‖z‖
    by_cases h : ‖z‖ < 1
    · have hm : ‖z‖ ∈ Set.Iio (1 : ℝ) := h
      simp only [hφ, Set.indicator_of_mem hm]
      exact Real.rpow_nonneg (norm_nonneg z) _
    · have hm : ‖z‖ ∉ Set.Iio (1 : ℝ) := h
      simp only [hφ, Set.indicator_of_notMem hm, le_refl]
  have hval : (∫ z : E2, φ ‖z‖) = 2 * Real.pi / (2 - a) := by
    rw [MeasureTheory.integral_fun_norm_addHaar MeasureTheory.volume φ, hrad, hFval, hfin,
      MeasureTheory.measureReal_def, EuclideanSpace.volume_ball_fin_two, ENNReal.ofReal_one,
      one_pow, one_mul, ENNReal.toReal_ofReal Real.pi_pos.le]
    have h2a : (2 - a) ≠ 0 := by linarith
    rw [nsmul_eq_mul, smul_eq_mul]
    field_simp
    push_cast
    ring
  
  have htrans : (∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-a))) =
      ∫⁻ z : E2, ENNReal.ofReal (φ ‖z‖) := by
    rw [← MeasureTheory.lintegral_indicator measurableSet_ball]
    have hpt : ∀ y : E2,
        (Metric.ball x 1).indicator (fun y => ENNReal.ofReal (‖x - y‖ ^ (-a))) y =
          (fun z : E2 => ENNReal.ofReal (φ ‖z‖)) (x - y) := by
      intro y
      by_cases hy : y ∈ Metric.ball x 1
      · have h' : ‖x - y‖ ∈ Set.Iio (1 : ℝ) := by
          have := hy
          rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev] at this
          exact this
        simp only [Set.indicator_of_mem hy, hφ, Set.indicator_of_mem h']
      · have h' : ‖x - y‖ ∉ Set.Iio (1 : ℝ) := by
          have := hy
          rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev] at this
          exact this
        simp only [Set.indicator_of_notMem hy, hφ, Set.indicator_of_notMem h',
          ENNReal.ofReal_zero]
    exact (MeasureTheory.lintegral_congr hpt).trans
      (MeasureTheory.lintegral_sub_left_eq_self (fun z : E2 => ENNReal.ofReal (φ ‖z‖)) x)
  rw [htrans, ← MeasureTheory.ofReal_integral_eq_lintegral_ofReal hint hnn, hval]

theorem hpWH_kernel : ∀ ρ s : ℝ, 0 < ρ → 0 < s → ∃ g : E2 → ℝ, ContDiff ℝ ∞ g ∧ HasCompactSupport g ∧
    (∀ w : E2, w ≠ 0 → ‖w‖ < 1 → g w ≤ ‖w‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ))) ∧
    ∀ w : E2, ρ < ‖w‖ → ‖w‖ < 1 →
      (g w = ‖w‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) ∧
      ‖fderiv ℝ g w‖ ≤ (1 / 2) * ‖w‖ ^ (-(3 / 2 : ℝ)) ∧
      ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) w (e2 i) =
        (1 / 4) * ‖w‖ ^ (-(5 / 2 : ℝ)) ∧
      ‖fderiv ℝ (fderiv ℝ g) w‖ ≤ (7 / 4) * ‖w‖ ^ (-(5 / 2 : ℝ))) :=
by
  intro ρ s hρ _hs
  have hP : (0 : ℝ) < ρ ^ 2 := by positivity
  
  obtain ⟨m, hmC, hm1, hm2⟩ : ∃ m : ℝ → ℝ, ContDiff ℝ ∞ m ∧
      (∀ u : ℝ, 0 ≤ u → u ≤ m u ∧ ρ ^ 2 / 2 ≤ m u) ∧ ∀ u : ℝ, ρ ^ 2 ≤ u → m u = u := by
    refine ⟨fun u => u + ρ ^ 2 * (1 - Real.smoothTransition (2 * u / ρ ^ 2 - 1)), ?_, ?_, ?_⟩
    · have h1 : ContDiff ℝ ∞ (fun u : ℝ => 2 * u / ρ ^ 2 - 1) :=
        ((contDiff_const.mul contDiff_id).div_const _).sub contDiff_const
      exact contDiff_id.add (contDiff_const.mul (contDiff_const.sub
        (Real.smoothTransition.contDiff.comp h1)))
    · intro u hu
      have hle := Real.smoothTransition.le_one (2 * u / ρ ^ 2 - 1)
      have hnn : 0 ≤ ρ ^ 2 * (1 - Real.smoothTransition (2 * u / ρ ^ 2 - 1)) :=
        mul_nonneg hP.le (by linarith)
      refine ⟨by linarith, ?_⟩
      by_cases h : u ≤ ρ ^ 2 / 2
      · have h0 : 2 * u / ρ ^ 2 - 1 ≤ 0 := by
          rw [sub_nonpos, div_le_one hP]; linarith
        show ρ ^ 2 / 2 ≤ u + ρ ^ 2 * (1 - Real.smoothTransition (2 * u / ρ ^ 2 - 1))
        rw [Real.smoothTransition.zero_of_nonpos h0]
        linarith
      · push_neg at h
        linarith
    · intro u hu
      have h1 : 1 ≤ 2 * u / ρ ^ 2 - 1 := by
        rw [le_sub_iff_add_le, le_div_iff₀ hP]; linarith
      show u + ρ ^ 2 * (1 - Real.smoothTransition (2 * u / ρ ^ 2 - 1)) = u
      rw [Real.smoothTransition.one_of_one_le h1]; ring
  
  obtain ⟨g, hgC, hgS, hgUp, hgEq⟩ : ∃ g : E2 → ℝ, ContDiff ℝ ∞ g ∧ HasCompactSupport g ∧
      (∀ w : E2, w ≠ 0 → ‖w‖ < 1 → g w ≤ ‖w‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ))) ∧
      ∀ w : E2, ρ < ‖w‖ → ‖w‖ < 1 → g w = ‖w‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) := by
    let χ : ContDiffBump (0 : E2) := ⟨1, 2, one_pos, one_lt_two⟩
    have hpos : ∀ w : E2, 0 < m (‖w‖ ^ 2) := fun w =>
      lt_of_lt_of_le (by positivity) (hm1 _ (sq_nonneg _)).2
    have hId : ∀ w : E2, (‖w‖ ^ 2) ^ (-(1 / 4 : ℝ)) = ‖w‖ ^ (-(1 / 2 : ℝ)) := by
      intro w
      rw [← Real.rpow_natCast_mul (norm_nonneg w)]
      norm_num
    have hOne : ∀ w : E2, ‖w‖ ≤ 1 → χ w = 1 := fun w hw =>
      χ.one_of_mem_closedBall (by rw [mem_closedBall_zero_iff]; exact hw)
    refine ⟨fun w => χ w * (m (‖w‖ ^ 2) ^ (-(1 / 4 : ℝ)) - s ^ (-(1 / 2 : ℝ))), ?_, ?_, ?_, ?_⟩
    · exact χ.contDiff.mul (((hmC.comp (contDiff_norm_sq ℝ)).rpow_const_of_ne
        (fun w => (hpos w).ne')).sub contDiff_const)
    · exact χ.hasCompactSupport.mul_right
    · intro w hw0 hw1
      have hx : 0 < ‖w‖ ^ 2 := by
        have := norm_pos_iff.mpr hw0
        positivity
      have hle := Real.rpow_le_rpow_of_nonpos hx (hm1 _ hx.le).1
        (by norm_num : (-(1 / 4 : ℝ)) ≤ 0)
      show χ w * (m (‖w‖ ^ 2) ^ (-(1 / 4 : ℝ)) - s ^ (-(1 / 2 : ℝ))) ≤ _
      rw [hOne w hw1.le, one_mul, ← hId w]
      linarith
    · intro w hw1 hw2
      have h2 : ρ ^ 2 ≤ ‖w‖ ^ 2 := by nlinarith
      show χ w * (m (‖w‖ ^ 2) ^ (-(1 / 4 : ℝ)) - s ^ (-(1 / 2 : ℝ))) = _
      rw [hOne w hw2.le, one_mul, hm2 _ h2, hId w]
  
  have hD : ∀ (p : ℝ) (u : E2), u ≠ 0 →
      HasFDerivAt (fun x : E2 => ‖x‖ ^ p) ((p * ‖u‖ ^ (p - 2)) • innerSL ℝ u) u := by
    intro p u hu
    have hfun : (fun x : E2 => ‖x‖ ^ p) = fun x => (‖x‖ ^ 2) ^ (p / 2) := by
      funext x
      rw [← Real.rpow_natCast_mul (norm_nonneg x)]
      congr 1
      push_cast
      ring
    have h2 := (hasStrictFDerivAt_norm_sq u).hasFDerivAt
    have h3 := h2.rpow_const (p := p / 2) (Or.inl (pow_ne_zero 2 (norm_ne_zero_iff.mpr hu)))
    have e1 : (‖u‖ ^ 2) ^ (p / 2 - 1) = ‖u‖ ^ (p - 2) := by
      rw [← Real.rpow_natCast_mul (norm_nonneg u)]
      congr 1
      push_cast
      ring
    rw [hfun]
    convert h3 using 1
    ext v
    simp only [ContinuousLinearMap.smul_apply, innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul, e1]
    push_cast
    ring
  
  refine ⟨g, hgC, hgS, hgUp, fun w hw1 hw2 => ?_⟩
  have hU : IsOpen {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have hwU : w ∈ {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} := ⟨hw1, hw2⟩
  have hgF : ∀ x : E2, ρ < ‖x‖ → ‖x‖ < 1 →
      fderiv ℝ g x = (-(1 / 2) * ‖x‖ ^ (-(5 / 2 : ℝ))) • innerSL ℝ x := by
    intro x hx1 hx2
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, norm_zero] at hx1
      linarith
    have hev : g =ᶠ[𝓝 x] fun y => ‖y‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) := by
      filter_upwards [hU.mem_nhds (show x ∈ {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} from ⟨hx1, hx2⟩)]
        with y hy
      exact hgEq y hy.1 hy.2
    have h := ((hD (-(1 / 2)) x hx0).sub_const (s ^ (-(1 / 2 : ℝ)))).congr_of_eventuallyEq hev
    have e : (-(1 / 2 : ℝ)) - 2 = -(5 / 2) := by norm_num
    rw [h.fderiv, e]
  have hw0 : w ≠ 0 := by
    intro h
    rw [h, norm_zero] at hw1
    linarith
  have hr : 0 < ‖w‖ := norm_pos_iff.mpr hw0
  obtain ⟨L, hL⟩ : ∃ L : E2 →L[ℝ] E2 →L[ℝ] ℝ, ∀ x y : E2, L x y = @inner ℝ E2 _ x y :=
    ⟨innerSL ℝ, fun x y => rfl⟩
  have hLx : ∀ x : E2, L x = innerSL ℝ x := fun x => by
    ext y
    rw [hL, innerSL_apply_apply]
  have hLn : ‖L‖ ≤ 1 := ContinuousLinearMap.opNorm_le_bound₂ L zero_le_one (fun x y => by
    rw [hL, one_mul, Real.norm_eq_abs]
    exact abs_real_inner_le_norm x y)
  have hT : HasFDerivAt (fderiv ℝ g)
      ((-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L +
        ((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight
          (L w)) w := by
    have ha : HasFDerivAt (fun x : E2 => -(1 / 2 : ℝ) * ‖x‖ ^ (-(5 / 2 : ℝ)))
        ((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)) w := by
      have h := hD (-(5 / 2)) w hw0
      have e : (-(5 / 2 : ℝ)) - 2 = -(9 / 2) := by norm_num
      rw [e] at h
      exact h.const_mul _
    have hi : HasFDerivAt (fun x : E2 => L x) L w := L.hasFDerivAt
    refine (ha.smul hi).congr_of_eventuallyEq ?_
    filter_upwards [hU.mem_nhds hwU] with y hy
    rw [hgF y hy.1 hy.2]
    show _ = (-(1 / 2) * ‖y‖ ^ (-(5 / 2 : ℝ))) • L y
    rw [hLx]
  
  have R1 : ‖w‖ ^ (-(5 / 2 : ℝ)) * ‖w‖ = ‖w‖ ^ (-(3 / 2 : ℝ)) := by
    rw [← Real.rpow_add_one hr.ne']
    norm_num
  have R2 : ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ ^ 2 = ‖w‖ ^ (-(5 / 2 : ℝ)) := by
    rw [← Real.rpow_two, ← Real.rpow_add hr]
    norm_num
  have hA : 0 < ‖w‖ ^ (-(5 / 2 : ℝ)) := Real.rpow_pos_of_pos hr _
  have hB : 0 < ‖w‖ ^ (-(9 / 2 : ℝ)) := Real.rpow_pos_of_pos hr _
  refine ⟨hgEq w hw1 hw2, ?_, ?_, ?_⟩
  · rw [hgF w hw1 hw2, norm_smul, innerSL_apply_norm, Real.norm_eq_abs]
    have : |-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))| = 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hA]
      norm_num
    rw [this, mul_assoc, R1]
  · have hTv : ∀ v : E2, fderiv ℝ (fun u => fderiv ℝ g u v) w v =
        -(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ)) * @inner ℝ E2 _ v v +
          (5 / 4) * ‖w‖ ^ (-(9 / 2 : ℝ)) * @inner ℝ E2 _ w v ^ 2 := by
      intro v
      rw [(hT.clm_apply (hasFDerivAt_const v w)).fderiv]
      simp [hL]
      ring
    have hn : ‖w‖ ^ 2 = w 0 ^ 2 + w 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
        sq_abs, sq_abs]
    rw [Fin.sum_univ_two, hTv, hTv]
    simp [EuclideanSpace.inner_single_right]
    linear_combination (5 / 4 : ℝ) * R2 - (5 / 4 : ℝ) * ‖w‖ ^ (-(9 / 2 : ℝ)) * hn
  · rw [hT.fderiv]
    have hadd := norm_add_le ((-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L)
      (((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight (L w))
    have h1 : |-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))| = 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hA]
      norm_num
    have h2 : |-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))| = 5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hB]
      norm_num
    have h3 : |(-(1 / 2) : ℝ)| = 1 / 2 := by norm_num
    have b1 : ‖(-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L‖ ≤ 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      refine le_trans (ContinuousLinearMap.opNorm_smul_le
        (-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ)) : ℝ) L) ?_
      rw [Real.norm_eq_abs, h1]
      exact mul_le_of_le_one_right (by positivity) hLn
    have hX : ‖(-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w‖ ≤
        5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ := by
      refine le_trans (norm_smul_le (-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ)) : ℝ) (innerSL ℝ w)) ?_
      rw [Real.norm_eq_abs, h2, innerSL_apply_norm]
    have ha1 : ‖(-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)‖ ≤
        1 / 2 * (5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖) := by
      refine le_trans (norm_smul_le (-(1 / 2) : ℝ)
        ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)) ?_
      rw [Real.norm_eq_abs, h3]
      exact mul_le_mul_of_nonneg_left hX (by norm_num)
    have b2 : ‖((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight
        (L w)‖ ≤ 5 / 4 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [ContinuousLinearMap.norm_smulRight_apply, hLx, innerSL_apply_norm]
      calc _ ≤ 1 / 2 * (5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖) * ‖w‖ :=
            mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)
        _ = 5 / 4 * (‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ ^ 2) := by ring
        _ = 5 / 4 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by rw [R2]
    exact le_trans hadd (le_trans (add_le_add b1 b2) (le_of_eq (by ring)))

theorem hpWH_conv_calculus : ∀ (K : Set E2) (g ψ : E2 → ℝ) (c : ℝ), IsCompact K →
    ContDiff ℝ ∞ g → HasCompactSupport g → 0 ≤ c → (∀ x, ψ x = c * ∫ y in K, g (x - y)) →
    ContDiff ℝ ∞ ψ ∧ ∀ x : E2,
      ‖fderiv ℝ ψ x‖ ≤ c * (∫ y in K, ‖fderiv ℝ g (x - y)‖) ∧
      ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ ψ u (e2 i)) x (e2 i) =
        c * (∫ y in K, ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) (x - y) (e2 i)) ∧
      ‖fderiv ℝ (fderiv ℝ ψ) x‖ ≤ c * (∫ y in K, ‖fderiv ℝ (fderiv ℝ g) (x - y)‖) :=
by
  intro K g ψ c hK hg hgc hc hψ
  
  have hA : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (h : E2 → F),
      ContDiff ℝ 1 h → HasCompactSupport h → ∀ x : E2,
      HasFDerivAt (fun u => ∫ y in K, h (u - y)) (∫ y in K, fderiv ℝ h (x - y)) x := by
    intro F _ _ h hh hhc x
    have hcont : Continuous h := hh.continuous
    have hdcont : Continuous (fderiv ℝ h) := hh.continuous_fderiv (by norm_num)
    obtain ⟨C, hC⟩ := hdcont.bounded_above_of_compact_support (hhc.fderiv ℝ)
    have hdiff : Differentiable ℝ h := hh.differentiable (by norm_num)
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume.restrict K)
      (F := fun u y => h (u - y)) (F' := fun u y => fderiv ℝ h (u - y)) (x₀ := x)
      (s := Set.univ) (bound := fun _ => C) Filter.univ_mem ?_ ?_ ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall (fun u =>
        (hcont.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
    · exact (hcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact hK
    · exact ((hdcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact
        hK).aestronglyMeasurable
    · exact ae_of_all _ (fun y u _ => hC (u - y))
    · exact continuousOn_const.integrableOn_compact hK
    · refine ae_of_all _ (fun y u _ => ?_)
      have h1 := (hdiff (u - y)).hasFDerivAt.comp u ((hasFDerivAt_id u).sub_const y)
      simpa using h1
  have hg1 : ContDiff ℝ 1 g := hg.of_le (by exact_mod_cast le_top)
  have hDg : ContDiff ℝ 1 (fderiv ℝ g) :=
    (contDiff_infty_iff_fderiv.mp hg).2.of_le (by exact_mod_cast le_top)
  have hDgc : HasCompactSupport (fderiv ℝ g) := hgc.fderiv ℝ
  have hDgcont : Continuous (fderiv ℝ g) := hg1.continuous_fderiv (by norm_num)
  
  have hsmooth : ContDiff ℝ ∞ (fun u => ∫ y in K, g (u - y)) := by
    have hloc : LocallyIntegrable (K.indicator (fun _ => (1 : ℝ))) volume :=
      ((integrable_indicator_iff hK.measurableSet).2
        (continuousOn_const.integrableOn_compact hK)).locallyIntegrable
    have hconv := HasCompactSupport.contDiff_convolution_right (n := ⊤)
      (ContinuousLinearMap.lsmul ℝ ℝ) hgc hloc hg
    have heq : (fun u => ∫ y in K, g (u - y)) =
        convolution (K.indicator (fun _ => (1 : ℝ))) g (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
      funext u
      rw [convolution_def, ← integral_indicator hK.measurableSet]
      congr 1
      funext t
      by_cases ht : t ∈ K
      · simp [Set.indicator_of_mem ht]
      · simp [Set.indicator_of_notMem ht]
    rw [heq]
    exact hconv
  have hψeq : ψ = fun u => c * ∫ y in K, g (u - y) := funext hψ
  have hψd : ∀ u, HasFDerivAt ψ (c • ∫ y in K, fderiv ℝ g (u - y)) u := by
    intro u
    rw [hψeq]
    exact (hA g hg1 hgc u).const_mul c
  have hfd : fderiv ℝ ψ = fun u => c • ∫ y in K, fderiv ℝ g (u - y) :=
    funext fun u => (hψd u).fderiv
  have hHess : ∀ x, fderiv ℝ (fderiv ℝ ψ) x =
      c • ∫ y in K, fderiv ℝ (fderiv ℝ g) (x - y) := by
    intro x
    rw [hfd]
    exact ((hA (fderiv ℝ g) hDg hDgc x).const_smul c).fderiv
  have hint1 : ∀ u, Integrable (fun y => fderiv ℝ g (u - y)) (volume.restrict K) := fun u =>
    (hDgcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact hK
  
  have hpart : ∀ (i : Fin 2) (x : E2),
      fderiv ℝ (fun u => fderiv ℝ ψ u (e2 i)) x (e2 i) =
        c * ∫ y in K, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) (x - y) (e2 i) := by
    intro i x
    have hi1 : ContDiff ℝ 1 (fun w => fderiv ℝ g w (e2 i)) := hDg.clm_apply contDiff_const
    have hic : HasCompactSupport (fun w => fderiv ℝ g w (e2 i)) := hgc.fderiv_apply ℝ (e2 i)
    have hicont : Continuous (fderiv ℝ (fun w => fderiv ℝ g w (e2 i))) :=
