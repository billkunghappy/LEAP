    have hlin : ∀ j, calPiece (q j) (φ j) V = fun z => ∑ k, calPiece (q j) (φ j) (Yf k) z := by
      intro j
      funext z
      unfold calPiece
      by_cases hz : z ∈ (chartAt E3 (q j)).target
      · simp only [Set.indicator_of_mem hz, hV, map_sum, Finset.smul_sum]
      · simp only [Set.indicator_of_notMem hz, Finset.sum_const_zero]
