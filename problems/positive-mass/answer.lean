    rw [show (fun x => ∑ a : Fin 3, partialDeriv a (fun z => cutoffPiolaField G Y R₁ c z a) x)
        = {x : E3 | R₃ < ‖x‖}.indicator
          (fun x => (fderiv ℝ Y x).det * (F₁ (Y x) + F₂ (Y x))) from funext hpt]
    exact setIntegral_indicator hΩm
  have e2 : (∫ y : E3, (∑ j : Fin 3, admVec G y j * (y j / ‖y‖)) *
      deriv Real.smoothTransition (‖y‖ - c)) = ∫ y, F₁ y := by
    rw [hF₁]
  have e3 : (∫ y : E3, |fluxDivLocal G y| * Real.smoothTransition (‖y‖ - c))
      = ∫ y, |F₂ y| := by
    congr 1
    funext y
    rw [hF₂, abs_mul, abs_of_nonneg (Real.smoothTransition.nonneg _)]
  rw [e1, e2, e3]
  exact key

theorem exists_cylinder_flux_le (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ)
    (hq : 1 / 2 < q) (hq1 : q < 1)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hsymm : ∀ (x : E3) (i j : Fin 3), G x i j = G x j i)
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
        |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
        ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
        ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2))
    (hint : IntegrableOn (fun x : E3 => scalarCurvatureLocal G x * Real.sqrt (G x).det)
      {x : E3 | 2 < ‖x‖})
    (m : ℝ) (hm : Tendsto (fluxLocal G) atTop (𝓝 m))
    (X Y : E3 → E3) (R₀ R₁ C₁ : ℝ) (hXY : CoordChange X Y q R₀ R₁ C₁)
    (hsmooth' : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun x => pullbackMetric G Y x a b) {x : E3 | R₁ < ‖x‖})
    (R₂ C₂ : ℝ) (hR₂ : R₁ ≤ R₂) (hdec' : Dec1 (pullbackMetric G Y) q R₂ C₂) :
    ∀ ε : ℝ, 0 < ε → ∀ L₀ : ℝ, ∃ L : ℝ, L₀ ≤ L ∧
      cylFlux (admVec (pullbackMetric G Y)) L ≤ 16 * Real.pi * m + ε :=
by
  intro ε hε L₀
  have hq0 : 0 < q := by linarith
  have hR02 : 2 ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hYs : ContDiffOn ℝ ∞ Y {x : E3 | R₁ < ‖x‖} := hXY.2.2.2.2.1
  have hYX : ∀ x : E3, R₁ < ‖x‖ → R₀ < ‖Y x‖ ∧ X (Y x) = x := hXY.2.2.2.2.2.1
  have hb' : ∀ y : E3, R < ‖y‖ → ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖y‖ ^ (-q) ∧
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ C * ‖y‖ ^ (-q - 1) := by
    intro y hy i j
    exact ⟨((hb y hy).2 i j 0).1, ((hb y hy).2 i j 0).2.1⟩
  
  obtain ⟨Rd, Cd, hdecomp⟩ := scalar_curvature_div_decomp G q hq0 hsmooth hsymm R C hR hC hb
  obtain ⟨R', hD⟩ := div_integrable_exterior G q hq hsmooth R C hR hC hb hint Rd Cd hdecomp
  obtain ⟨-, hτ⟩ := smoothed_tail_tendsto_zero (fun y : E3 => |fluxDivLocal G y|) R'
    (MeasureTheory.Integrable.abs hD)
  
  obtain ⟨R₃, K, hR13, hK, hYb⟩ := coordChange_inverse_bounds X Y q R₀ R₁ C₁ hq0 hq1 hXY
  
  obtain ⟨R₄, K₄, hR34, hK4, hE⟩ := adm_pullback_piola_decomp G q R C hq0 hR hC hsmooth hb'
    Y R₃ K hK (hYs.mono fun x hx => lt_of_le_of_lt hR13 hx)
    (fun x hx => ⟨(hYb x hx).1, (hYb x hx).2.2.1, (hYb x hx).2.2.2⟩)
  have hT1 : Tendsto (fun ℓ : ℝ => cylFlux (admVec (pullbackMetric G Y)) ℓ
      - cylFlux (piolaVec Y (admVec G)) ℓ) atTop (𝓝 0) := by
    have hlim : Tendsto (fun ℓ : ℝ => 12 * Real.pi * K₄ * ℓ ^ (-(2 * q - 1))) atTop (𝓝 0) := by
      have h := (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < 2 * q - 1)).const_mul
        (12 * Real.pi * K₄)
      rwa [mul_zero] at h
    refine squeeze_zero_norm' ?_ hlim
    filter_upwards [eventually_gt_atTop R₄] with ℓ hℓ
    have hR1ℓ : R₁ < ℓ := by linarith
    have hℓpos : 0 < ℓ := by linarith
    have hsplit := cyl_flux_three_split G Y R₁ ℓ (by linarith) hR1ℓ hsmooth hYs
      (fun x hx => by have := (hYX x hx).1; linarith) hsmooth'
    have hcurl := cyl_flux_jacCurl_zero Y R₁ ℓ (by linarith) hR1ℓ hYs
    have hbound := cylFlux_abs_le
      (fun x b => admVec (pullbackMetric G Y) x b - piolaVec Y (admVec G) x b - jacCurlVec Y x b)
      ℓ (K₄ * ℓ ^ (-2 * q - 1)) hℓpos.le (mul_nonneg hK4 (Real.rpow_nonneg hℓpos.le _)) (by
        intro x hx k
        have h1 := hE x (by linarith) k
        have h2 : ‖x‖ ^ (-2 * q - 1) ≤ ℓ ^ (-2 * q - 1) :=
          Real.rpow_le_rpow_of_nonpos hℓpos hx (by linarith)
        exact h1.trans (mul_le_mul_of_nonneg_left h2 hK4))
    have hpow : ℓ ^ 2 * ℓ ^ (-2 * q - 1) = ℓ ^ (-(2 * q - 1)) := by
      rw [← Real.rpow_natCast ℓ 2, ← Real.rpow_add hℓpos]
      congr 1
      push_cast
      ring
    have heq : cylFlux (admVec (pullbackMetric G Y)) ℓ - cylFlux (piolaVec Y (admVec G)) ℓ
        = cylFlux (fun x b => admVec (pullbackMetric G Y) x b - piolaVec Y (admVec G) x b
            - jacCurlVec Y x b) ℓ := by
      linarith [hsplit, hcurl]
    rw [Real.norm_eq_abs, heq]
    calc _ ≤ 12 * Real.pi * ℓ ^ 2 * (K₄ * ℓ ^ (-2 * q - 1)) := hbound
      _ = 12 * Real.pi * K₄ * (ℓ ^ 2 * ℓ ^ (-2 * q - 1)) := by ring
      _ = 12 * Real.pi * K₄ * ℓ ^ (-(2 * q - 1)) := by rw [hpow]
  
  obtain ⟨c₁, hc₁⟩ := cutoffPiolaField_props G hsmooth X Y q R₀ R₁ C₁ hq0 hXY R₃ hR13
    (fun x hx => (hYb x hx).1)
  obtain ⟨c₂, hc₂⟩ := cutoffPiola_div_integral_bound G hsmooth X Y q R₀ R₁ C₁ hq0 hXY R₃ hR13
    (fun x hx => (hYb x hx).2.1) R' hD
  have hA := smoothed_flux_tendsto G hsmooth m hm
  have hT2 : Tendsto (fun ℓ : ℝ => cylFlux (piolaVec Y (admVec G)) ℓ) atTop
      (𝓝 (16 * Real.pi * m)) := by
    rw [Metric.tendsto_atTop]
    intro δ hδ
    have hpi : 0 < Real.pi := Real.pi_pos
    obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp hA (δ / (32 * Real.pi)) (by positivity)
    obtain ⟨N₂, hN₂⟩ := Metric.tendsto_atTop.mp hτ (δ / 2) (by positivity)
    obtain ⟨c, hcN₁, hcN₂, hcc₁, hcc₂, hc2⟩ :
        ∃ c : ℝ, N₁ ≤ c ∧ N₂ ≤ c ∧ c₁ ≤ c ∧ c₂ ≤ c ∧ (2 : ℝ) ≤ c :=
      ⟨max (max N₁ N₂) (max c₁ (max c₂ 2)),
        le_trans (le_max_left _ _) (le_max_left _ _),
        le_trans (le_max_right _ _) (le_max_left _ _),
        le_trans (le_max_left _ _) (le_max_right _ _),
        le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) (le_max_right _ _),
        le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (le_max_right _ _)⟩
    refine ⟨max (R₃ + 1) (2 * c + 2), fun ℓ hℓ => ?_⟩
    have hℓ1 : R₃ + 1 ≤ ℓ := le_trans (le_max_left _ _) hℓ
    have hℓ2 : 2 * c + 2 ≤ ℓ := le_trans (le_max_right _ _) hℓ
    have hℓpos : 0 < ℓ := by linarith
    obtain ⟨hCD, hflux⟩ := hc₁ c hcc₁
    have e1 := hflux ℓ (by linarith) hℓ2
    have e2 := cyl_divergence_theorem (cutoffPiolaField G Y R₁ c) hCD ℓ hℓpos
    have e3 := hc₂ c hcc₂ ℓ hℓ2
    have e4 := radial_cutoff_flux_integral G hsmooth c hc2
    have e5 := hN₁ c hcN₁
    have e6 := hN₂ c hcN₂
    beta_reduce at e5 e6
    rw [Real.dist_eq] at e5 e6 ⊢
    rw [sub_zero] at e6
    rw [← e1, e2]
    rw [e4] at e3
    have h5 := abs_lt.mp e5
    have h3 := abs_le.mp e3
    have h6 := abs_lt.mp e6
    have h16 : (0 : ℝ) < 16 * Real.pi := by positivity
    have k : 16 * Real.pi * (δ / (32 * Real.pi)) = δ / 2 := by
      field_simp
      ring
    have m1 := mul_lt_mul_of_pos_left h5.2 h16
    have m2 := mul_lt_mul_of_pos_left h5.1 h16
    rw [k] at m1
    rw [mul_neg, k] at m2
    rw [abs_lt]
    constructor
    · nlinarith
    · nlinarith
  
  have hlim : Tendsto (fun ℓ : ℝ => cylFlux (admVec (pullbackMetric G Y)) ℓ) atTop
      (𝓝 (16 * Real.pi * m)) := by
    have h := hT1.add hT2
    rw [zero_add] at h
    exact h.congr (fun ℓ => sub_add_cancel _ _)
  have hev := (hlim.eventually
    (gt_mem_nhds (by linarith : 16 * Real.pi * m < 16 * Real.pi * m + ε))).and
    (eventually_ge_atTop L₀)
  obtain ⟨L, hL1, hL2⟩ := hev.exists
  exact ⟨L, hL2, hL1.le⟩

theorem mass_nonneg [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds) (m : ℝ)
    (hm : Tendsto (fun r : ℝ => admFlux g (hAF.ends k) r) atTop (𝓝 m)) :
    0 ≤ m :=
by
  
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hsmooth : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends k).Φ x i j) {x : E3 | 1 < ‖x‖} := by
    intro i j
    rw [← hsrc]
    exact coeff_contDiffOn_source g (hAF.ends k).Φ i j
  have hsymm : ∀ (x : E3) (i j : Fin 3),
      g.coeff (hAF.ends k).Φ x i j = g.coeff (hAF.ends k).Φ x j i := by
    intro x i j
    exact g.symm _ _ _
  have hint : IntegrableOn
      (fun x : E3 => scalarCurvatureLocal (g.coeff (hAF.ends k).Φ) x *
        Real.sqrt (g.coeff (hAF.ends k).Φ x).det) {x : E3 | 2 < ‖x‖} := by
    refine (hAF.integrable_scalarCurvature k).congr_fun ?_
      (measurableSet_lt measurable_const measurable_norm)
    intro x hx
    have hx' : x ∈ (hAF.ends k).Φ.source := by
      have h2 : (2 : ℝ) < ‖x‖ := hx
      rw [hsrc]
      show (1 : ℝ) < ‖x‖
      linarith
    simp only
    rw [scalarCurvature_eq_scalarCurvatureLocal_coeff g (hAF.ends k).Φ x hx']
  have hm' : Tendsto (fluxLocal (g.coeff (hAF.ends k).Φ)) atTop (𝓝 m) := hm
  
  have hq0 : 0 < hAF.q := lt_trans (by norm_num) hAF.q_gt
  have hq'half : (1 / 2 : ℝ) < min hAF.q (3 / 4) := lt_min hAF.q_gt (by norm_num)
  have hq'le : min hAF.q (3 / 4) ≤ hAF.q := min_le_left _ _
  have hq'lt1 : min hAF.q (3 / 4) < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  obtain ⟨R, C, hR1, hC0, hb⟩ :=
    metric_coeff_bounds (g.coeff (hAF.ends k).Φ) hAF.q hq0 hsmooth (hAF.decay k)
  have hb' : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (g.coeff (hAF.ends k).Φ x).det ∧
      ∀ i j l : Fin 3,
        |g.coeff (hAF.ends k).Φ x i j - (if i = j then (1 : ℝ) else 0)|
          ≤ C * ‖x‖ ^ (-(min hAF.q (3 / 4))) ∧
        ‖fderiv ℝ (fun y => g.coeff (hAF.ends k).Φ y i j) x‖
          ≤ C * ‖x‖ ^ (-(min hAF.q (3 / 4)) - 1) ∧
        ‖fderiv ℝ (fun y => partialDeriv l (fun z => g.coeff (hAF.ends k).Φ z i j) y) x‖
          ≤ C * ‖x‖ ^ (-(min hAF.q (3 / 4)) - 2) := by
    intro x hx
    have hx1 : (1 : ℝ) ≤ ‖x‖ := by linarith
    obtain ⟨hdet, hrest⟩ := hb x hx
    refine ⟨hdet, fun i j l => ?_⟩
    obtain ⟨h0, h1, h2⟩ := hrest i j l
    have e0 : ‖x‖ ^ (-hAF.q) ≤ ‖x‖ ^ (-(min hAF.q (3 / 4))) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    have e1 : ‖x‖ ^ (-hAF.q - 1) ≤ ‖x‖ ^ (-(min hAF.q (3 / 4)) - 1) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    have e2 : ‖x‖ ^ (-hAF.q - 2) ≤ ‖x‖ ^ (-(min hAF.q (3 / 4)) - 2) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    exact ⟨h0.trans (mul_le_mul_of_nonneg_left e0 hC0),
      h1.trans (mul_le_mul_of_nonneg_left e1 hC0),
      h2.trans (mul_le_mul_of_nonneg_left e2 hC0)⟩
  have hDecG : Dec1 (g.coeff (hAF.ends k).Φ) (min hAF.q (3 / 4)) R C := by
    intro x hx i j
    obtain ⟨_, hrest⟩ := hb' x hx
    refine ⟨(hrest i j 0).1, fun l => ?_⟩
    have h1 := (hrest i j l).2.1
    calc |partialDeriv l (fun y => g.coeff (hAF.ends k).Φ y i j) x|
        = ‖fderiv ℝ (fun y => g.coeff (hAF.ends k).Φ y i j) x (e l)‖ := by
          rw [Real.norm_eq_abs]; rfl
      _ ≤ ‖fderiv ℝ (fun y => g.coeff (hAF.ends k).Φ y i j) x‖ * ‖e l‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (fun y => g.coeff (hAF.ends k).Φ y i j) x‖ := by
          simp [EuclideanSpace.norm_single]
      _ ≤ _ := h1
  
  obtain ⟨R₀, R₁, C₁, X, Y, hXY, hgauge, L₁, hstern⟩ :=
    stern_harmonic_cylinder_bound g hComplete hAF hR k
  have hR02 : 2 ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  
  obtain ⟨hsymm', hsmooth', R₂, C₂, hR12, hC2, hdec'⟩ :=
    pullback_metric_decay (g.coeff (hAF.ends k).Φ) (min hAF.q (3 / 4)) (by linarith) hq'lt1
      hsmooth hsymm R C hDecG X Y R₀ R₁ C₁ hXY
  have hR2one : (1 : ℝ) ≤ R₂ := by linarith
  have hsmooth₂ : ∀ a b : Fin 3, ContDiffOn ℝ ∞
      (fun x => pullbackMetric (g.coeff (hAF.ends k).Φ) Y x a b) {x : E3 | R₂ < ‖x‖} := by
    intro a b
    exact (hsmooth' a b).mono (fun x hx => lt_of_le_of_lt hR12 hx)
  have hgauge₂ : ∀ x : E3, R₂ < ‖x‖ →
      ∑ i : Fin 3, ∑ j : Fin 3,
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ i j *
          christoffel (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) 0 i j x = 0 := by
    intro x hx
    exact hgauge x (lt_of_le_of_lt hR12 hx)
  
  have hT4 := cyl_grad_term_asymptotics (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)
    (min hAF.q (3 / 4)) R₂ C₂ hq'half hR2one hC2 hsmooth₂ hsymm' hdec' hgauge₂
  have hT5 := cyl_curv_term_asymptotics (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)
    (min hAF.q (3 / 4)) R₂ C₂ hq'half hR2one hC2 hsmooth₂ hsymm' hdec'
  have hT : Tendsto (fun L : ℝ =>
      (cylFlux (gradVec (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)) L
          - P1 (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L)
        - (curvTerm (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L
          - P2 (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L)) atTop (𝓝 0) := by
    have h := hT4.sub hT5
    rwa [sub_zero] at h
  have hD : Tendsto (fun L : ℝ =>
      sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L
        - (1 / 2 : ℝ) * cylFlux (admVec (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)) L)
      atTop (𝓝 0) := by
    refine hT.congr' ?_
    filter_upwards [eventually_gt_atTop R₂] with L hL
    have hsplit := cyl_adm_flux_split (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) R₂ L hL
      hsmooth₂ hsymm'
    simp only [sternBoundary]
    linarith
  
  by_contra hneg
  have hneg' : m < 0 := lt_of_not_ge hneg
  have hpm : Real.pi * m < 0 := mul_neg_of_pos_of_neg Real.pi_pos hneg'
  obtain ⟨L₀', hL₀'⟩ := Metric.tendsto_atTop.mp hD (-(2 * Real.pi * m)) (by linarith)
  obtain ⟨L, hL, hLflux⟩ := exists_cylinder_flux_le (g.coeff (hAF.ends k).Φ) (min hAF.q (3 / 4))
    hq'half hq'lt1 hsmooth hsymm R C hR1 hC0 hb' hint m hm' X Y R₀ R₁ C₁ hXY hsmooth'
    R₂ C₂ hR12 hdec' (-(4 * Real.pi * m)) (by linarith) (max L₀' L₁)
  have h1 := hL₀' L (le_trans (le_max_left _ _) hL)
  have h2 := hstern L (le_trans (le_max_right _ _) hL)
  rw [Real.dist_eq, sub_zero] at h1
  have h3 := (abs_lt.mp h1).2
  linarith

theorem conformal_scalarCurvatureLocal (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) U)
    (hsymm : ∀ (x : E3) (i j : Fin 3), G x i j = G x j i)
    (hdet : ∀ x ∈ U, (G x).det ≠ 0) (hu : ContDiffOn ℝ ∞ u U) (hupos : ∀ x ∈ U, 0 < u x)
    (y : E3) (hy : y ∈ U) :
    scalarCurvatureLocal (fun x => (u x ^ 4) • G x) y =
      (u y ^ 5)⁻¹ * (-8 * lapLocal G u y + scalarCurvatureLocal G y * u y) :=
by
  
  
  have inv_entry_partialDeriv : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (x : E3)
      (hG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x)
      (hdet : (G x).det ≠ 0) (m : Fin 3),
      ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
        partialDeriv m (fun y => (G y)⁻¹ k l) x =
          -∑ a : Fin 3, ∑ b : Fin 3,
            (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := (by
  intro G x hG hdet m
  have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
      DifferentiableAt ℝ (fun y => (H y).det) x := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
        - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
        + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y; exact Matrix.det_fin_three (H y)
    rw [hfun]
    have h00 := hH 0 0
    have h01 := hH 0 1
    have h02 := hH 0 2
    have h10 := hH 1 0
    have h11 := hH 1 1
    have h12 := hH 1 2
    have h20 := hH 2 0
    have h21 := hH 2 1
    have h22 := hH 2 2
    fun_prop
  have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
  have hP : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
    intro k l
    have hfun : (fun y => (G y)⁻¹ k l) =
        fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
        smul_eq_mul]
    rw [hfun]
    refine (hD.inv hdet).mul (hdetD _ ?_)
    intro a b
    by_cases hal : a = l
    · subst hal
      simp only [Matrix.updateRow_self]
      exact differentiableAt_const _
    · simp only [Matrix.updateRow_ne hal]
      exact hG a b
  have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
  have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
      + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
    intro a l
    have h1 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
        (∑ b : Fin 3, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
          + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
      have hs := HasFDerivAt.sum (u := Finset.univ)
        (A := fun b y => G y a b * (G y)⁻¹ b l)
        (fun b _ => (hG a b).hasFDerivAt.mul (hP b l).hasFDerivAt)
      convert hs using 1
    have h2 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
        (0 : E3 →L[ℝ] ℝ) x := by
      apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
      filter_upwards [hev] with y hy
      have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
      rw [Matrix.mul_apply, Matrix.one_apply] at this
      exact this
    have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
    unfold partialDeriv
    rw [← h3, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro b _
    ring
  intro k l
  refine ⟨hP k l, ?_⟩
  let X : Matrix (Fin 3) (Fin 3) ℝ :=
    Matrix.of fun b l => partialDeriv m (fun y => (G y)⁻¹ b l) x
  let D : Matrix (Fin 3) (Fin 3) ℝ :=
    Matrix.of fun a b => partialDeriv m (fun y => G y a b) x
  have hM : G x * X = -(D * (G x)⁻¹) := by
    ext a l'
    rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
    simp only [X, D, Matrix.of_apply]
    exact hE a l'
  have hX : X = -((G x)⁻¹ * (D * (G x)⁻¹)) := by
    calc X = ((G x)⁻¹ * G x) * X := by
          rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
      _ = (G x)⁻¹ * (G x * X) := Matrix.mul_assoc _ _ _
      _ = _ := by rw [hM, Matrix.mul_neg]
  have hkl := congrFun (congrFun hX k) l
  simp only [X, D, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
  rw [hkl]
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b _
  ring)

  have conformal_christoffel_pointwise : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
      (z : E3)
      (hG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun x => G x a b) z) (hu : DifferentiableAt ℝ u z)
      (hsymm : ∀ a b : Fin 3, G z a b = G z b a) (hdet : (G z).det ≠ 0) (hu0 : u z ≠ 0)
      (k i j : Fin 3),
      christoffel (fun x => (u x ^ 4) • G x) k i j z = christoffel G k i j z +
        ((if k = i then 2 * (u z)⁻¹ * partialDeriv j u z else 0) +
          (if k = j then 2 * (u z)⁻¹ * partialDeriv i u z else 0) -
          G z i j * ∑ l : Fin 3, (G z)⁻¹ k l * (2 * (u z)⁻¹ * partialDeriv l u z)) := (by
  intro G u z hG hu hsymm hdet hu0 k i j
  have hu4 : u z ^ 4 ≠ 0 := pow_ne_zero 4 hu0
  have hinvz : (u z ^ 4 • G z)⁻¹ = (u z ^ 4)⁻¹ • (G z)⁻¹ := by
    apply Matrix.inv_eq_right_inv
    rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet),
      smul_smul, mul_inv_cancel₀ hu4, one_smul]
  have hprod : ∀ c a b, partialDeriv c (fun x => u x ^ 4 * G x a b) z =
      u z ^ 4 * partialDeriv c (fun x => G x a b) z + G z a b * (4 * u z ^ 3 * partialDeriv c u z) := by
    intro c a b
