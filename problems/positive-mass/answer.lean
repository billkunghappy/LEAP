      unfold pd2
      rw [hev.fderiv_eq, hmul.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have k00 := key 0 0 (fun y => h y 1 1) _ (hdiff 1 1) (fun y hy => (hadj y hy).1)
    have k01 := key 0 1 (fun y => -h y 0 1) _ (hdiff 0 1).neg (fun y hy => (hadj y hy).2.1)
    have k10 := key 1 0 (fun y => -h y 0 1) _ (hdiff 0 1).neg (fun y hy => (hadj y hy).2.2.1)
    have k11 := key 1 1 (fun y => h y 0 0) _ (hdiff 0 0) (fun y hy => (hadj y hy).2.2.2)
