  have hA : 0 ≤ A₀ * M := mul_nonneg hA₀ hM
  have hiter := giaquinta_iteration
    (fun t K => ∀ x ∈ Metric.ball (0 : E3) t, ∀ y ∈ Metric.ball (0 : E3) t, ∀ i j : Fin 3,
