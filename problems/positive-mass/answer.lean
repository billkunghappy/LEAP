        Real.sqrt (g.gradInner u u ((chartAt E3 (q j)).symm y)))
      {y | y ∈ (chartAt E3 (q j)).target ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0} := by
    intro j
    have hreps := stern_phi_chart_reps g u hu 1 one_pos (q j)
    have hUo : IsOpen {x : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0} := hreps.2.2.1
    have hNs := hreps.2.2.2
    have hgI : ContinuousOn (fun y =>
        g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) ((chartAt E3 (q j)).symm y))
        {y | y ∈ (chartAt E3 (q j)).target ∧
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0} :=
      stern_gradInner_chart g β (fun x => Real.sqrt (g.gradInner u u x)) _ hUo hβ.1 hNs (q j)
    have hNc : ContinuousOn (fun y => Real.sqrt (g.gradInner u u ((chartAt E3 (q j)).symm y)))
        {y | y ∈ (chartAt E3 (q j)).target ∧
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0} :=
      ContinuousOn.comp (g := fun x => Real.sqrt (g.gradInner u u x)) hNs.continuousOn
        ((chartAt E3 (q j)).continuousOn_symm.mono (fun y hy => hy.1)) (fun y hy => hy.2)
    exact ((continuousOn_const.mul (hβj' j)).mul hgI).div hNc
      (fun y hy => (hNpos _ hy.2).ne')
  obtain ⟨i2, e2⟩ := gen (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
      g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p / Real.sqrt (g.gradInner u u p))
    (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
      g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p)
    hw2
    (fun p hp hpA => (div_mul_cancel₀ _ (hNpos p (hreg p hp hpA)).ne').symm)
  refine ⟨i1.sub i2, ?_⟩
  show calVolSum g q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A)
      (fun p => Real.smoothTransition (β p / s) * Real.sqrt (g.gradInner u u p) *
        sternGaussM g u p) -
    calVolSum g q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A)
      (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
        g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p) =
    ∫ t in A, (sbgbSliceInt g u q φ (sternDomain (hAF.ends k) β Y L) t
        (fun p => Real.smoothTransition (β p / s) * sternGaussM g u p) -
      sbgbSliceInt g u q φ (sternDomain (hAF.ends k) β Y L) t
        (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
          g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
          Real.sqrt (g.gradInner u u p)))
  rw [e1, e2, MeasureTheory.integral_sub i1 i2]

theorem level_set_chart_area_bound (f : E3 → ℝ) (O : Set E3) (hO : IsOpen O)
    (hf : ContDiffOn ℝ 1 f O) (Kc : Set E3) (hKc : IsCompact Kc) (hKO : Kc ⊆ O)
    (hdf : ∀ y ∈ Kc, fderiv ℝ f y ≠ 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ,
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Kc ∩ f ⁻¹' {t}) ≤ ENNReal.ofReal C :=
by
  classical
  
  have hexpv : ∀ Δ : E3, Δ = ∑ b : Fin 3, Δ b • EuclideanSpace.single b (1 : ℝ) := by
    intro Δ
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr Δ
    simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] at h
    exact h.symm
  have hnormle : ∀ Δ : E3, ‖Δ‖ ≤ ∑ b : Fin 3, |Δ b| := by
    intro Δ
    calc ‖Δ‖ = ‖∑ b : Fin 3, Δ b • EuclideanSpace.single b (1 : ℝ)‖ := by rw [← hexpv Δ]
      _ ≤ ∑ b : Fin 3, ‖Δ b • EuclideanSpace.single b (1 : ℝ)‖ := norm_sum_le _ _
      _ = ∑ b : Fin 3, |Δ b| := by
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  
  have hloc : ∀ y₀ ∈ Kc, ∃ (a : Fin 3) (r : ℝ), 0 < r ∧ ∀ z ∈ Metric.ball y₀ r,
      ∀ z' ∈ Metric.ball y₀ r, f z = f z' →
      ‖z' - z‖ ≤ 6 * ‖(fun k : Fin 2 => z' (a.succAbove k)) - (fun k : Fin 2 => z (a.succAbove k))‖ := by
    intro y₀ hy₀
    set L := fderiv ℝ f y₀ with hLdef
    obtain ⟨a, -, ha⟩ := Finset.exists_max_image Finset.univ
      (fun b => |L (EuclideanSpace.single b (1 : ℝ))|) Finset.univ_nonempty
    set m := |L (EuclideanSpace.single a (1 : ℝ))| with hm
    have hexp : ∀ Δ : E3, L Δ = ∑ b : Fin 3, Δ b * L (EuclideanSpace.single b (1 : ℝ)) := by
      intro Δ
      conv_lhs => rw [hexpv Δ]
      rw [map_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [map_smul, smul_eq_mul]
    have hm0 : 0 < m := by
      rcases (abs_nonneg (L (EuclideanSpace.single a (1 : ℝ)))).lt_or_eq with h | h
      · exact h
      · exfalso
        apply hdf y₀ hy₀
        rw [← hLdef]
        ext Δ
        rw [hexp Δ]
        simp only [ContinuousLinearMap.zero_apply]
        refine Finset.sum_eq_zero fun b _ => ?_
        have hb := ha b (Finset.mem_univ b)
        have : |L (EuclideanSpace.single b (1 : ℝ))| = 0 :=
          le_antisymm (hb.trans (le_of_eq h.symm)) (abs_nonneg _)
        rw [abs_eq_zero.mp this, mul_zero]
    have hcont : ContinuousAt (fderiv ℝ f) y₀ :=
      (hf.continuousOn_fderiv_of_isOpen hO le_rfl).continuousAt (hO.mem_nhds (hKO hy₀))
    obtain ⟨δ, hδ, hδL⟩ := Metric.continuousAt_iff.mp hcont (m / 4) (by positivity)
    obtain ⟨ε₀, hε₀, hball⟩ := Metric.isOpen_iff.mp hO y₀ (hKO hy₀)
    refine ⟨a, min δ ε₀, lt_min hδ hε₀, ?_⟩
    intro z hz z' hz' hzz
    have hBO : ball y₀ (min δ ε₀) ⊆ O := (ball_subset_ball (min_le_right _ _)).trans hball
    have hdiff : ∀ y ∈ ball y₀ (min δ ε₀), DifferentiableAt ℝ (f - ⇑L) y := by
      intro y hy
      exact ((hf.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hBO hy))).sub
        L.differentiableAt
    have hbd : ∀ y ∈ ball y₀ (min δ ε₀), ‖fderiv ℝ (f - ⇑L) y‖ ≤ m / 4 := by
      intro y hy
      have hfd := (hf.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds (hBO hy))
      rw [fderiv_sub hfd L.differentiableAt, ContinuousLinearMap.fderiv]
      have := hδL (lt_of_lt_of_le (mem_ball.mp hy) (min_le_left _ _))
      rw [dist_eq_norm] at this
      exact this.le
    have hmv := Convex.norm_image_sub_le_of_norm_fderiv_le hdiff hbd (convex_ball _ _) hz hz'
    have hLΔ : |L (z' - z)| ≤ m / 4 * ‖z' - z‖ := by
      have heq : (f - ⇑L) z' - (f - ⇑L) z = -L (z' - z) := by
        simp only [Pi.sub_apply, map_sub, hzz]
        ring
      rw [heq, norm_neg, Real.norm_eq_abs] at hmv
      exact hmv
    set H := ‖(fun k : Fin 2 => z' (a.succAbove k)) - (fun k : Fin 2 => z (a.succAbove k))‖ with hH
    have hH0 : 0 ≤ H := norm_nonneg _
    have hcoord : ∀ k : Fin 2, |(z' - z) (a.succAbove k)| ≤ H := by
      intro k
      have := norm_le_pi_norm
        ((fun k : Fin 2 => z' (a.succAbove k)) - (fun k : Fin 2 => z (a.succAbove k))) k
      simpa [Real.norm_eq_abs] using this
    set Δ := z' - z with hΔ
    have hsplitL : L Δ = Δ a * L (EuclideanSpace.single a (1 : ℝ)) +
        (Δ (a.succAbove 0) * L (EuclideanSpace.single (a.succAbove 0) (1 : ℝ)) +
          Δ (a.succAbove 1) * L (EuclideanSpace.single (a.succAbove 1) (1 : ℝ))) := by
      rw [hexp Δ, Fin.sum_univ_succAbove _ a, Fin.sum_univ_two]
    have hsplitN : ‖Δ‖ ≤ |Δ a| + (|Δ (a.succAbove 0)| + |Δ (a.succAbove 1)|) := by
      have := hnormle Δ
      rw [Fin.sum_univ_succAbove _ a, Fin.sum_univ_two] at this
      exact this
    have h0 := hcoord 0
    have h1 := hcoord 1
    have hl0 : |L (EuclideanSpace.single (a.succAbove 0) (1 : ℝ))| ≤ m := ha _ (Finset.mem_univ _)
    have hl1 : |L (EuclideanSpace.single (a.succAbove 1) (1 : ℝ))| ≤ m := ha _ (Finset.mem_univ _)
    have p0 : |Δ (a.succAbove 0) * L (EuclideanSpace.single (a.succAbove 0) (1 : ℝ))| ≤ H * m := by
      rw [abs_mul]; exact mul_le_mul h0 hl0 (abs_nonneg _) hH0
    have p1 : |Δ (a.succAbove 1) * L (EuclideanSpace.single (a.succAbove 1) (1 : ℝ))| ≤ H * m := by
      rw [abs_mul]; exact mul_le_mul h1 hl1 (abs_nonneg _) hH0
    have pa : |Δ a * L (EuclideanSpace.single a (1 : ℝ))| = |Δ a| * m := by rw [abs_mul]
    have tri : |Δ a * L (EuclideanSpace.single a (1 : ℝ))| ≤ |L Δ| + H * m + H * m := by
      have e1 := le_abs_self (L Δ)
      have e2 := neg_abs_le (L Δ)
      have q0 := abs_le.mp p0
      have q1 := abs_le.mp p1
      rw [abs_le]
      constructor <;> linarith
    have hN : m / 4 * ‖Δ‖ ≤ m / 4 * (|Δ a| + 2 * H) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    have key : m * (3 / 4 * |Δ a|) ≤ m * (5 / 2 * H) := by nlinarith
    have hΔa : 3 / 4 * |Δ a| ≤ 5 / 2 * H := le_of_mul_le_mul_left key hm0
    linarith
  
  have hmeas : ∀ (a : Fin 3) (y₀ : E3) (r : ℝ), 0 < r → ∀ P : Set E3, P ⊆ ball y₀ r →
      (∀ z ∈ P, ∀ z' ∈ P, ‖z' - z‖ ≤
        6 * ‖(fun k : Fin 2 => z' (a.succAbove k)) - (fun k : Fin 2 => z (a.succAbove k))‖) →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) P ≤ ENNReal.ofReal (36 * (2 * r) ^ 2) := by
    intro a y₀ r hr P hP hlip
    set π : E3 → (Fin 2 → ℝ) := fun z k => z (a.succAbove k) with hπ
    set S := π '' P with hS
    set g := Function.invFunOn π P with hg
    have hgS : ∀ x ∈ S, g x ∈ P ∧ π (g x) = x :=
      fun x hx => ⟨Function.invFunOn_mem hx, Function.invFunOn_eq hx⟩
    have hLip : LipschitzOnWith 6 g S := by
      refine LipschitzOnWith.of_dist_le_mul fun x hx w hw => ?_
      obtain ⟨h1, h2⟩ := hgS x hx
      obtain ⟨h3, h4⟩ := hgS w hw
      have := hlip _ h3 _ h1
      have h2' : (fun k : Fin 2 => g x (a.succAbove k)) = x := h2
      have h4' : (fun k : Fin 2 => g w (a.succAbove k)) = w := h4
      rw [h2', h4'] at this
      rw [dist_eq_norm, dist_eq_norm]
      simpa using this
    have hPsub : P ⊆ g '' S := by
      intro z hz
      have hx : π z ∈ S := ⟨z, hz, rfl⟩
      obtain ⟨h1, h2⟩ := hgS _ hx
      have := hlip _ hz _ h1
      have h2' : (fun k : Fin 2 => g (π z) (a.succAbove k)) = π z := h2
      rw [h2'] at this
      have h0 : (π z) - (fun k : Fin 2 => z (a.succAbove k)) = 0 := sub_self _
      rw [h0, norm_zero, mul_zero] at this
      exact ⟨π z, hx, sub_eq_zero.mp (norm_le_zero_iff.mp this)⟩
    have hSsub : S ⊆ ball (π y₀) r := by
      rintro _ ⟨z, hz, rfl⟩
      rw [mem_ball, dist_pi_lt_iff hr]
      intro k
      have h1 := hP hz
      rw [mem_ball, dist_eq_norm] at h1
      have h2 := PiLp.norm_apply_le (z - y₀) (a.succAbove k)
      rw [Real.dist_eq]
      calc |z (a.succAbove k) - y₀ (a.succAbove k)| = ‖(z - y₀).ofLp (a.succAbove k)‖ := by
            simp [Real.norm_eq_abs]
        _ ≤ ‖z - y₀‖ := h2
        _ < r := h1
    have h := hLip.hausdorffMeasure_image_le (d := 2) (by norm_num)
    have h6 : (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
        MeasureTheory.Measure (Fin 2 → ℝ)) = MeasureTheory.volume := by
      simpa using (MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2))
    rw [h6] at h
    calc MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) P
        ≤ MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (g '' S) := measure_mono hPsub
      _ ≤ ((6 : NNReal) : ENNReal) ^ (2 : ℝ) * MeasureTheory.volume S := h
      _ ≤ ((6 : NNReal) : ENNReal) ^ (2 : ℝ) * MeasureTheory.volume (ball (π y₀) r) := by
          gcongr
      _ = ENNReal.ofReal (36 * (2 * r) ^ 2) := by
          rw [Real.volume_pi_ball _ hr, Fintype.card_fin, ENNReal.ofReal_mul (by norm_num)]
          congr 1
          rw [ENNReal.rpow_two]
          norm_num
  
  choose! a r hr hL using hloc
  obtain ⟨I, hIK, hcov⟩ := hKc.elim_nhds_subcover (fun y => ball y (r y))
    (fun y hy => ball_mem_nhds y (hr y hy))
  refine ⟨∑ i ∈ I, 36 * (2 * r i) ^ 2, Finset.sum_nonneg (fun i _ => by positivity), fun t => ?_⟩
  calc MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Kc ∩ f ⁻¹' {t})
      ≤ MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (⋃ i ∈ I, ball i (r i) ∩ f ⁻¹' {t}) := by
        apply measure_mono
        rintro z ⟨hzK, hzt⟩
        obtain ⟨i, hi, hzi⟩ := Set.mem_iUnion₂.mp (hcov hzK)
        exact Set.mem_iUnion₂.mpr ⟨i, hi, hzi, hzt⟩
    _ ≤ ∑ i ∈ I, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (ball i (r i) ∩ f ⁻¹' {t}) :=
        measure_biUnion_finset_le _ _
    _ ≤ ∑ i ∈ I, ENNReal.ofReal (36 * (2 * r i) ^ 2) := by
        apply Finset.sum_le_sum
        intro i hi
        apply hmeas (a i) i (r i) (hr i (hIK i hi)) _ Set.inter_subset_left
        intro z hz z' hz'
        exact hL i (hIK i hi) z hz.1 z' hz'.1
          ((show f z = t from hz.2).trans (show f z' = t from hz'.2).symm)
    _ = ENNReal.ofReal (∑ i ∈ I, 36 * (2 * r i) ^ 2) :=
        (ENNReal.ofReal_sum_of_nonneg (fun i _ => by positivity)).symm

theorem level_edge_null (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ 1 f O)
    (hb : ContDiffOn ℝ 1 b O) (Kc : Set E3) (hKO : Kc ⊆ O)
    (hind : ∀ y ∈ Kc, b y = 0 → ∀ a c : ℝ,
      a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0) :
    ∀ t : ℝ,
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Kc ∩ f ⁻¹' {t} ∩ b ⁻¹' {0}) = 0 :=
by
  
  have s1 : ∀ h : E3 → ℝ, ContDiffOn ℝ 1 h O → ∀ y₀ ∈ O, ∀ c : ℝ, 0 < c →
      ∃ r : ℝ, 0 < r ∧ ∀ y ∈ Metric.ball y₀ r, ∀ y' ∈ Metric.ball y₀ r,
        |h y' - h y - fderiv ℝ h y₀ (y' - y)| ≤ c * ‖y' - y‖ := by
    intro h hh y₀ hy₀ c hc
    have hcont : ContinuousOn (fderiv ℝ h) O := hh.continuousOn_fderiv_of_isOpen hO le_rfl
    have hca : ContinuousAt (fderiv ℝ h) y₀ := hcont.continuousAt (hO.mem_nhds hy₀)
    obtain ⟨δ, hδ, hδc⟩ := Metric.continuousAt_iff.mp hca c hc
    obtain ⟨ρ, hρ, hρO⟩ := Metric.isOpen_iff.mp hO y₀ hy₀
    refine ⟨min δ ρ, lt_min hδ hρ, fun y hy y' hy' => ?_⟩
    have hsub : Metric.ball y₀ (min δ ρ) ⊆ O :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hρO
    have hdiff : ∀ ξ ∈ Metric.ball y₀ (min δ ρ), DifferentiableAt ℝ h ξ := by
      intro ξ hξ
      exact (hh.differentiableOn one_ne_zero ξ (hsub hξ)).differentiableAt
        (hO.mem_nhds (hsub hξ))
    have hbound : ∀ ξ ∈ Metric.ball y₀ (min δ ρ), ‖fderiv ℝ h ξ - fderiv ℝ h y₀‖ ≤ c := by
      intro ξ hξ
      have h1 : dist ξ y₀ < δ := lt_of_lt_of_le hξ (min_le_left _ _)
      have h2 := hδc h1
      rw [dist_eq_norm] at h2
      exact h2.le
    have := Convex.norm_image_sub_le_of_norm_fderiv_le' hdiff hbound (convex_ball y₀ _) hy hy'
    rw [← Real.norm_eq_abs]
    exact this
  intro t
  apply measure_null_of_locally_null
  rintro y₀ ⟨⟨hy₀K, hy₀f⟩, hy₀b⟩
  have hy₀O : y₀ ∈ O := hKO hy₀K
  have hy₀b' : b y₀ = 0 := hy₀b
  have hAB := hind y₀ hy₀K hy₀b'
  set A := fderiv ℝ f y₀ with hA
  set B := fderiv ℝ b y₀ with hB
  set L : E3 →ₗ[ℝ] ℝ × ℝ := ((B.prod A : E3 →L[ℝ] ℝ × ℝ) : E3 →ₗ[ℝ] ℝ × ℝ) with hLdef
  
  have hrange : LinearMap.range L = ⊤ := by
    by_contra hne
    obtain ⟨φ, hφ0, hφ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
    have hzero : (φ ((1 : ℝ), (0 : ℝ))) • B + (φ ((0 : ℝ), (1 : ℝ))) • A = 0 := by
      refine ContinuousLinearMap.ext fun v => ?_
      have hv : φ (L v) = 0 := hφ (LinearMap.mem_range_self L v)
      have hLv : L v = (B v) • ((1 : ℝ), (0 : ℝ)) + (A v) • ((0 : ℝ), (1 : ℝ)) := by
        simp [hLdef]
      rw [hLv, map_add, map_smul, map_smul] at hv
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
        ContinuousLinearMap.zero_apply]
      simp only [smul_eq_mul] at hv
      linarith
    obtain ⟨ha, hc⟩ := hAB _ _ hzero
    apply hφ0
    refine LinearMap.ext fun x => ?_
    have hx : x = x.1 • ((1 : ℝ), (0 : ℝ)) + x.2 • ((0 : ℝ), (1 : ℝ)) := by
      ext <;> simp
    rw [hx, map_add, map_smul, map_smul, ha, hc]
    simp
  have hN : Module.finrank ℝ (LinearMap.ker L) ≤ 1 := by
    have h1 := LinearMap.finrank_range_add_finrank_ker L
    have h3 : Module.finrank ℝ E3 = 3 := finrank_euclideanSpace_fin
    rw [hrange, finrank_top, Module.finrank_prod, Module.finrank_self, h3] at h1
    omega
  
  set N := LinearMap.ker L with hNdef
  set P : E3 →L[ℝ] N := N.orthogonalProjection with hPdef
  set T : E3 →L[ℝ] (ℝ × ℝ) × N := (B.prod A).prod P with hTdef
  have hTinj : Function.Injective (T : E3 →ₗ[ℝ] (ℝ × ℝ) × N) := by
    rw [injective_iff_map_eq_zero]
    intro v hv
    have h1 : (B.prod A) v = 0 := by
      have := congrArg Prod.fst hv
      simpa [hTdef] using this
    have h2 : P v = 0 := by
      have := congrArg Prod.snd hv
      simpa [hTdef] using this
    have hvN : v ∈ N := by
      rw [hNdef, LinearMap.mem_ker]
      exact h1
    have h3 : P v = ⟨v, hvN⟩ := Submodule.orthogonalProjection_mem_subspace_eq_self ⟨v, hvN⟩
    rw [h2] at h3
    have h4 := congrArg Subtype.val h3
    simpa using h4.symm
  obtain ⟨K, hK, hanti⟩ := (LinearMap.injective_iff_antilipschitz _).mp hTinj
  have hK' : (0 : ℝ) < K := hK
  have hTv : ∀ v : E3, ‖v‖ ≤ K * ‖T v‖ := by
    intro v
    have := hanti.le_mul_dist v 0
    simpa [dist_eq_norm] using this
  set c : ℝ := 1 / (2 * (K : ℝ)) with hcdef
  have hc : 0 < c := by positivity
  have hKc : (K : ℝ) * c = 1 / 2 := by
    rw [hcdef]
    field_simp
  have kstar : ∀ v : E3, |A v| ≤ c * ‖v‖ → |B v| ≤ c * ‖v‖ → ‖v‖ ≤ K * ‖P v‖ := by
    intro v hAv hBv
    have h1 : ‖T v‖ ≤ max (c * ‖v‖) ‖P v‖ := by
      refine norm_prod_le_iff.mpr ⟨norm_prod_le_iff.mpr ⟨?_, ?_⟩, ?_⟩
      · show ‖B v‖ ≤ _
        rw [Real.norm_eq_abs]
        exact hBv.trans (le_max_left _ _)
      · show ‖A v‖ ≤ _
        rw [Real.norm_eq_abs]
        exact hAv.trans (le_max_left _ _)
      · show ‖P v‖ ≤ _
        exact le_max_right _ _
    have h2 : ‖v‖ ≤ K * max (c * ‖v‖) ‖P v‖ :=
      (hTv v).trans (mul_le_mul_of_nonneg_left h1 hK'.le)
    rcases le_total (c * ‖v‖) ‖P v‖ with h | h
    · rw [max_eq_right h] at h2
      exact h2
    · rw [max_eq_left h] at h2
      have h3 : (K : ℝ) * (c * ‖v‖) = ‖v‖ / 2 := by
        rw [← mul_assoc, hKc]
        ring
      have h4 : ‖v‖ ≤ 0 := by linarith
      have h5 : 0 ≤ (K : ℝ) * ‖P v‖ := mul_nonneg hK'.le (norm_nonneg _)
      linarith
  
  obtain ⟨r₁, hr₁, hf1⟩ := s1 f hf y₀ hy₀O c hc
  obtain ⟨r₂, hr₂, hb1⟩ := s1 b hb y₀ hy₀O c hc
  refine ⟨Kc ∩ f ⁻¹' {t} ∩ b ⁻¹' {0} ∩ Metric.ball y₀ (min r₁ r₂),
    inter_mem_nhdsWithin _ (Metric.ball_mem_nhds y₀ (lt_min hr₁ hr₂)), ?_⟩
  set U := Kc ∩ f ⁻¹' {t} ∩ b ⁻¹' {0} ∩ Metric.ball y₀ (min r₁ r₂) with hUdef
  have hinc : ∀ y ∈ U, ∀ y' ∈ U, ‖y' - y‖ ≤ K * ‖P (y' - y)‖ := by
    rintro y ⟨⟨⟨_, hyf⟩, hyb⟩, hyr⟩ y' ⟨⟨⟨_, hyf'⟩, hyb'⟩, hyr'⟩
    have hyf2 : f y = t := hyf
    have hyb2 : b y = 0 := hyb
    have hyf2' : f y' = t := hyf'
    have hyb2' : b y' = 0 := hyb'
    have hy1 : y ∈ Metric.ball y₀ r₁ := Metric.ball_subset_ball (min_le_left _ _) hyr
    have hy2 : y ∈ Metric.ball y₀ r₂ := Metric.ball_subset_ball (min_le_right _ _) hyr
    have hy1' : y' ∈ Metric.ball y₀ r₁ := Metric.ball_subset_ball (min_le_left _ _) hyr'
    have hy2' : y' ∈ Metric.ball y₀ r₂ := Metric.ball_subset_ball (min_le_right _ _) hyr'
    have eA := hf1 y hy1 y' hy1'
    have eB := hb1 y hy2 y' hy2'
    rw [hyf2, hyf2', sub_self, zero_sub, abs_neg] at eA
    rw [hyb2, hyb2', sub_self, zero_sub, abs_neg] at eB
    exact kstar _ eA eB
  let p : U → N := fun y => P (y : E3)
  have hp : AntilipschitzWith K p := by
    refine AntilipschitzWith.of_le_mul_dist fun y y' => ?_
    rw [Subtype.dist_eq, dist_eq_norm, dist_eq_norm]
    have h1 := hinc y'.1 y'.2 y.1 y.2
    have h2 : p y - p y' = P (y.1 - y'.1) := by
      simp only [p, map_sub]
    rw [h2]
    exact h1
  have hdim : dimH U ≤ 1 := by
    calc dimH U = dimH ((Subtype.val : U → E3) '' Set.univ) := by rw [Subtype.coe_image_univ]
      _ = dimH (Set.univ : Set U) := isometry_subtype_coe.dimH_image _
      _ ≤ dimH (p '' Set.univ) := hp.le_dimH_image _
      _ ≤ dimH (Set.univ : Set N) := dimH_mono (Set.subset_univ _)
      _ = Module.finrank ℝ N := Real.dimH_univ_eq_finrank N
      _ ≤ 1 := by exact_mod_cast hN
  have hlt : dimH U < ((2 : NNReal) : ENNReal) := lt_of_le_of_lt hdim (by norm_num)
  have h := hausdorffMeasure_of_dimH_lt hlt
  rwa [NNReal.coe_ofNat] at h

theorem slice_bulk_chart_limit [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hβr : ∀ p : M, β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (Ω : Set M) (hΩ : IsClosed Ω) (hΩβ : ∀ p ∈ Ω, 0 ≤ β p)
    (A : Set ℝ) (hA : IsCompact A)
    (hreg : ∀ p ∈ Ω, u p ∈ A → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0)
    (q : M) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ)
    (hφc : IsCompact (tsupport φ)) (hφs : tsupport φ ⊆ (chartAt E3 q).source) :
    ∃ C : ℝ, ∀ t ∈ A,
      (∀ s : ℝ, 0 < s → |sclBulk g β u q φ Ω t s| ≤ C) ∧
      Tendsto (fun s => sclBulk g β u q φ Ω t s) (𝓝[>] (0 : ℝ))
        (𝓝 (sclBulkLim g u q φ Ω t)) :=
by
  classical
  
  have hDCT : ∀ (μ : Measure E3) (E : Set E3) (kk bb : E3 → ℝ) (Bk : ℝ), MeasurableSet E →
      μ E < ⊤ → ContinuousOn kk E → ContinuousOn bb E → (∀ y ∈ E, 0 ≤ bb y) →
      (∀ y ∈ E, |kk y| ≤ Bk) → μ (E ∩ bb ⁻¹' {0}) = 0 →
      (∀ s : ℝ, ‖∫ y in E, Real.smoothTransition (bb y / s) * kk y ∂μ‖ ≤ Bk * μ.real E) ∧
      Tendsto (fun s => ∫ y in E, Real.smoothTransition (bb y / s) * kk y ∂μ) (𝓝[>] (0 : ℝ))
        (𝓝 (∫ y in E, kk y ∂μ)) := by
    intro μ E kk bb Bk hE hμE hkk hbb hbb0 hkB hnul
    have hpt : ∀ s : ℝ, ∀ y ∈ E, ‖Real.smoothTransition (bb y / s) * kk y‖ ≤ Bk := by
      intro s y hy
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (Real.smoothTransition.nonneg _)]
      exact (mul_le_of_le_one_left (abs_nonneg _) (Real.smoothTransition.le_one _)).trans
        (hkB y hy)
    refine ⟨fun s => norm_setIntegral_le_of_norm_le_const hμE (hpt s), ?_⟩
    refine tendsto_integral_filter_of_dominated_convergence (fun _ => Bk) ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall fun s =>
        ((Real.smoothTransition.continuous.comp_continuousOn (hbb.div_const s)).mul
          hkk).aestronglyMeasurable hE
    · exact Filter.Eventually.of_forall fun s =>
        (ae_restrict_iff' hE).mpr (Filter.Eventually.of_forall fun y hy => hpt s y hy)
    · exact integrableOn_const hμE.ne
    · have hae : ∀ᵐ y ∂μ, y ∉ E ∩ bb ⁻¹' {0} := measure_eq_zero_iff_ae_notMem.mp hnul
      refine (ae_restrict_iff' hE).mpr (hae.mono fun y hy hyE => ?_)
      have hbpos : 0 < bb y := by
        rcases (hbb0 y hyE).lt_or_eq with h | h
        · exact h
        · exact (hy ⟨hyE, h.symm⟩).elim
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hbpos] with s hs
      rw [Real.smoothTransition.one_of_one_le ((one_le_div hs.1).mpr hs.2.le), one_mul]
  
  have hcl : ∀ t : ℝ, IsClosed (Ω ∩ u ⁻¹' {t}) := fun t =>
    hΩ.inter (isClosed_singleton.preimage hu.continuous)
  have hKc : IsCompact (tsupport φ ∩ Ω ∩ u ⁻¹' A) :=
    (hφc.inter_right hΩ).inter_right (hA.isClosed.preimage hu.continuous)
  have hKsrc : tsupport φ ∩ Ω ∩ u ⁻¹' A ⊆ (chartAt E3 q).source := fun p hp => hφs hp.1.1
  obtain ⟨Z, hZdef⟩ : ∃ Z : Set E3, Z = chartAt E3 q '' (tsupport φ ∩ Ω ∩ u ⁻¹' A) :=
    ⟨_, rfl⟩
  have hZc : IsCompact Z := by
    rw [hZdef]
    exact hKc.image_of_continuousOn ((chartAt E3 q).continuousOn.mono hKsrc)
  have hZT : Z ⊆ (chartAt E3 q).target := by
    rw [hZdef]
    rintro y ⟨p, hp, rfl⟩
    exact (chartAt E3 q).map_source (hKsrc hp)
  have hZu : ∀ y ∈ Z, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm y) ≠ 0 := by
    rw [hZdef]
    rintro y ⟨p, hp, rfl⟩
    rw [(chartAt E3 q).left_inv (hKsrc hp)]
    exact hreg p hp.1.2 hp.2
  
  obtain ⟨hfs, hgrad, hcont⟩ := chart_pullback_gradInner g u hu q
  have hbs : ContDiffOn ℝ ∞ (fun y => β ((chartAt E3 q).symm y)) (chartAt E3 q).target :=
    (chart_pullback_gradInner g β hβ q).1
  have hpos : ∀ y ∈ Z, 0 < g.gradInner u u ((chartAt E3 q).symm y) := by
    intro y hy
    rw [hgrad y (hZT hy)]
    exact chart_Nsq_pos g u hu q y (hZT hy) (hZu y hy)
  have hind := fun y (hy : y ∈ Z) =>
    stern_bad_chart_indep g β u hβ hβr hu hneu q y (hZT hy) (hpos y hy)
  obtain ⟨k, hk⟩ : ∃ k : E3 → ℝ, k = fun y => φ ((chartAt E3 q).symm y) *
      sternGaussM g u ((chartAt E3 q).symm y) *
      sbgbAreaDens (g.coeff (chartAt E3 q).symm) (fun z => u ((chartAt E3 q).symm z)) y :=
    ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : E3 → ℝ, b = fun z => β ((chartAt E3 q).symm z) := ⟨_, rfl⟩
  have hkc : ContinuousOn k Z := by
    have h1 : ContinuousOn (fun y => φ ((chartAt E3 q).symm y)) Z :=
      hφ.continuous.comp_continuousOn ((chartAt E3 q).continuousOn_symm.mono hZT)
    have h2 : ContinuousOn (fun y => sternGaussM g u ((chartAt E3 q).symm y)) Z :=
      (stern_gauss_chart g u hu q).mono (fun y hy => ⟨hZT hy, hZu y hy⟩)
    have hnum : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det *
        Real.sqrt (gradSqLoc (g.coeff (chartAt E3 q).symm)
          (fun z => u ((chartAt E3 q).symm z)) y)) (chartAt E3 q).target := by
      refine hcont.congr fun y hy => ?_
      show _ = Real.sqrt (g.coeff (chartAt E3 q).symm y).det *
        Real.sqrt (g.gradInner u u ((chartAt E3 q).symm y))
      rw [hgrad y hy]
      rfl
    have hden : ContinuousOn (fun y => ‖fderiv ℝ (fun z => u ((chartAt E3 q).symm z)) y‖)
        (chartAt E3 q).target :=
      continuous_norm.comp_continuousOn
        (hfs.continuousOn_fderiv_of_isOpen (chartAt E3 q).open_target (by simp))
    have h3 : ContinuousOn (fun y => sbgbAreaDens (g.coeff (chartAt E3 q).symm)
        (fun z => u ((chartAt E3 q).symm z)) y) Z := by
      refine (((continuousOn_const : ContinuousOn (fun _ : E3 => sbgbAreaConst) Z).mul
        (hnum.mono hZT)).div (hden.mono hZT)
          fun y hy => norm_ne_zero_iff.mpr (hind y hy).1).congr fun y _ => ?_
      simp only [sbgbAreaDens, Pi.div_apply]
      ring
    rw [hk]
    exact (h1.mul h2).mul h3
  obtain ⟨B₀, hB₀⟩ := hZc.exists_bound_of_continuousOn hkc
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = max B₀ 0 := ⟨_, rfl⟩
  have hB0 : 0 ≤ B := by rw [hBdef]; exact le_max_right _ _
  have hkB : ∀ y ∈ Z, |k y| ≤ B := by
    intro y hy
    rw [hBdef, ← Real.norm_eq_abs]
    exact (hB₀ y hy).trans (le_max_left _ _)
  
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by simp
  obtain ⟨CA, hCA0, hCA⟩ := level_set_chart_area_bound (fun z => u ((chartAt E3 q).symm z))
    (chartAt E3 q).target (chartAt E3 q).open_target (hfs.of_le h1le) Z hZc hZT
    (fun y hy => (hind y hy).1)
  have hnull := level_edge_null (fun z => u ((chartAt E3 q).symm z))
    (fun z => β ((chartAt E3 q).symm z)) (chartAt E3 q).target (chartAt E3 q).open_target
    (hfs.of_le h1le) (hbs.of_le h1le) Z hZT (fun y hy => (hind y hy).2)
  
  refine ⟨B * CA, fun t ht => ?_⟩
  obtain ⟨E', hE'def⟩ : ∃ E' : Set E3,
      E' = chartAt E3 q '' (tsupport φ ∩ (Ω ∩ u ⁻¹' {t})) := ⟨_, rfl⟩
  have hE'src : tsupport φ ∩ (Ω ∩ u ⁻¹' {t}) ⊆ (chartAt E3 q).source := fun p hp => hφs hp.1
  have hE'c : IsCompact E' := by
    rw [hE'def]
    exact (hφc.inter_right (hcl t)).image_of_continuousOn
      ((chartAt E3 q).continuousOn.mono hE'src)
  have hE'm : MeasurableSet E' := hE'c.measurableSet
  have hE'Z : E' ⊆ Z ∩ (fun z => u ((chartAt E3 q).symm z)) ⁻¹' {t} := by
    rw [hE'def, hZdef]
    rintro y ⟨p, ⟨hp1, hp2, hp3⟩, rfl⟩
    have hp3' : u p = t := hp3
    refine ⟨⟨p, ⟨⟨hp1, hp2⟩, ?_⟩, rfl⟩, ?_⟩
    · show u p ∈ A
      rw [hp3']
      exact ht
    · show u ((chartAt E3 q).symm (chartAt E3 q p)) ∈ ({t} : Set ℝ)
      rw [(chartAt E3 q).left_inv (hφs hp1)]
      exact hp3
  have hEm : MeasurableSet (chartAt E3 q '' (Ω ∩ u ⁻¹' {t} ∩ (chartAt E3 q).source)) := by
    have hopen := (chartAt E3 q).continuousOn_symm.isOpen_inter_preimage
      (chartAt E3 q).open_target (hcl t).isOpen_compl
    have heq : chartAt E3 q '' (Ω ∩ u ⁻¹' {t} ∩ (chartAt E3 q).source) =
        (chartAt E3 q).target \
          ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (Ω ∩ u ⁻¹' {t})ᶜ) := by
      rw [(chartAt E3 q).image_eq_target_inter_inv_preimage Set.inter_subset_right]
      ext y
      constructor
      · rintro ⟨hy, h1, _⟩
        exact ⟨hy, fun h => h.2 h1⟩
      · rintro ⟨hy, h⟩
        exact ⟨hy, Classical.byContradiction fun h' => h ⟨hy, h'⟩,
          (chartAt E3 q).map_target hy⟩
    rw [heq]
    exact (chartAt E3 q).open_target.measurableSet.diff hopen.measurableSet
  have hsub : E' ⊆ chartAt E3 q '' (Ω ∩ u ⁻¹' {t} ∩ (chartAt E3 q).source) := by
    rw [hE'def]
    rintro y ⟨p, ⟨hp1, hp2⟩, rfl⟩
    exact ⟨p, ⟨hp2, hφs hp1⟩, rfl⟩
  have hvan : ∀ y ∈ chartAt E3 q '' (Ω ∩ u ⁻¹' {t} ∩ (chartAt E3 q).source) \ E',
      φ ((chartAt E3 q).symm y) = 0 := by
    rintro y ⟨⟨p, hp, rfl⟩, hy'⟩
    rw [(chartAt E3 q).left_inv hp.2]
    apply image_eq_zero_of_notMem_tsupport
    intro hpt
    apply hy'
    rw [hE'def]
    exact ⟨p, ⟨hpt, hp.1⟩, rfl⟩
  have hrw1 : ∀ s : ℝ, sclBulk g β u q φ Ω t s =
      ∫ y in E', Real.smoothTransition (b y / s) * k y
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
    intro s
    unfold sclBulk
    rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero hEm hsub
      (fun y hy => by simp only [hvan y hy, zero_mul])]
    congr 1
    funext y
    simp only [hk, hb]
    ring
  have hrw2 : sclBulkLim g u q φ Ω t =
      ∫ y in E', k y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
    unfold sclBulkLim
    rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero hEm hsub
      (fun y hy => by simp only [hvan y hy, zero_mul])]
    simp only [hk]
  have hfin : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) E' ≤ ENNReal.ofReal CA :=
    (measure_mono hE'Z).trans (hCA t)
  have hnullE : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (E' ∩ b ⁻¹' {0}) = 0 := by
    have hsubN : E' ∩ b ⁻¹' {0} ⊆ Z ∩ (fun z => u ((chartAt E3 q).symm z)) ⁻¹' {t} ∩
        (fun z => β ((chartAt E3 q).symm z)) ⁻¹' {0} := by
      intro y hy
      refine ⟨hE'Z hy.1, ?_⟩
      have h2 := hy.2
      rw [hb] at h2
      exact h2
    exact measure_mono_null hsubN (hnull t)
  have hbc : ContinuousOn b E' := by
    rw [hb]
    exact hβ.continuous.comp_continuousOn
      ((chartAt E3 q).continuousOn_symm.mono (fun y hy => hZT (hE'Z hy).1))
  have hb0 : ∀ y ∈ E', 0 ≤ b y := by
    rw [hE'def, hb]
    rintro y ⟨p, ⟨hp1, hp2, _⟩, rfl⟩
    show 0 ≤ β ((chartAt E3 q).symm (chartAt E3 q p))
    rw [(chartAt E3 q).left_inv (hφs hp1)]
    exact hΩβ p hp2
  have hkE : ∀ y ∈ E', |k y| ≤ B := fun y hy => hkB y (hE'Z hy).1
  obtain ⟨hbd, hlim⟩ := hDCT (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) E' k b B hE'm
    (lt_of_le_of_lt hfin ENNReal.ofReal_lt_top) (hkc.mono fun y hy => (hE'Z hy).1) hbc hb0 hkE
    hnullE
  refine ⟨fun s _ => ?_, ?_⟩
  · rw [hrw1 s, ← Real.norm_eq_abs]
    refine (hbd s).trans (mul_le_mul_of_nonneg_left ?_ hB0)
    exact ENNReal.toReal_le_of_le_ofReal hCA0 hfin
  · have hfun : (fun s => sclBulk g β u q φ Ω t s) = fun s =>
        ∫ y in E', Real.smoothTransition (b y / s) * k y
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := funext hrw1
    rw [hfun, hrw2]
    exact hlim

theorem indep_collar_localization (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O)
    (hf : ContDiffOn ℝ ∞ f O) (hb : ContDiffOn ℝ ∞ b O) (Kc : Set E3) (hKc : IsCompact Kc)
    (hKO : Kc ⊆ O)
    (hind : ∀ y ∈ Kc, b y = 0 → ∀ a c : ℝ,
      a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0) :
    ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ y ∈ Kc, |b y| ≤ s₂ → ∀ a c : ℝ,
      a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0 :=
by
  classical
  have hDb : ContinuousOn (fderiv ℝ b) O := hb.continuousOn_fderiv_of_isOpen hO (by simp)
  have hDf : ContinuousOn (fderiv ℝ f) O := hf.continuousOn_fderiv_of_isOpen hO (by simp)
  have hbc : ContinuousOn b O := hb.continuousOn
  set S : Set (ℝ × ℝ) := Metric.sphere (0 : ℝ × ℝ) 1 with hS
  set K : Set (E3 × (ℝ × ℝ)) := Kc ×ˢ S with hK
  set H : E3 × (ℝ × ℝ) → ℝ := fun p =>
    |b p.1| + ‖p.2.1 • fderiv ℝ b p.1 + p.2.2 • fderiv ℝ f p.1‖ with hH
  have hKcpt : IsCompact K := hKc.prod (isCompact_sphere _ _)
  have hmaps : Set.MapsTo (fun p : E3 × (ℝ × ℝ) => p.1) K O := fun p hp => hKO hp.1
  have hHc : ContinuousOn H K := by
    have h1 : ContinuousOn (fun p : E3 × (ℝ × ℝ) => b p.1) K :=
      hbc.comp continuous_fst.continuousOn hmaps
    have h2 : ContinuousOn (fun p : E3 × (ℝ × ℝ) => fderiv ℝ b p.1) K :=
      hDb.comp continuous_fst.continuousOn hmaps
    have h3 : ContinuousOn (fun p : E3 × (ℝ × ℝ) => fderiv ℝ f p.1) K :=
      hDf.comp continuous_fst.continuousOn hmaps
    have h4 : ContinuousOn (fun p : E3 × (ℝ × ℝ) => p.2.1) K := continuous_snd.fst.continuousOn
    have h5 : ContinuousOn (fun p : E3 × (ℝ × ℝ) => p.2.2) K := continuous_snd.snd.continuousOn
    exact h1.abs.add ((h4.smul h2).add (h5.smul h3)).norm
  have hHpos : ∀ p ∈ K, 0 < H p := by
    rintro ⟨y, v⟩ ⟨hy, hv⟩
    have hv1 : ‖v‖ = 1 := mem_sphere_zero_iff_norm.mp hv
    by_contra hle
    push_neg at hle
    have ha := abs_nonneg (b y)
    have hn := norm_nonneg (v.1 • fderiv ℝ b y + v.2 • fderiv ℝ f y)
    simp only [hH] at hle
    have hb0 : |b y| = 0 := by linarith
    have hn0 : ‖v.1 • fderiv ℝ b y + v.2 • fderiv ℝ f y‖ = 0 := by linarith
    obtain ⟨h1, h2⟩ := hind y hy (abs_eq_zero.mp hb0) v.1 v.2 (norm_eq_zero.mp hn0)
    have hv0 : v = 0 := Prod.ext h1 h2
    rw [hv0, norm_zero] at hv1
    exact zero_ne_one hv1
  by_cases hne : K.Nonempty
  · obtain ⟨p₀, hp₀, hmin⟩ := hKcpt.exists_isMinOn hne hHc
    have hm : 0 < H p₀ := hHpos p₀ hp₀
    refine ⟨H p₀ / 2, half_pos hm, ?_⟩
    intro y hy hby a c hac
    by_contra hnot
    have hw : (a, c) ≠ (0 : ℝ × ℝ) := by
      intro h
      apply hnot
      exact ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩
    have hn : 0 < ‖(a, c)‖ := norm_pos_iff.mpr hw
    set v : ℝ × ℝ := ‖(a, c)‖⁻¹ • (a, c) with hvdef
    have hv1 : ‖v‖ = 1 := by
      rw [hvdef, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hn),
        inv_mul_cancel₀ hn.ne']
    have hvK : (y, v) ∈ K := Set.mk_mem_prod hy (mem_sphere_zero_iff_norm.mpr hv1)
    have hcomb : v.1 • fderiv ℝ b y + v.2 • fderiv ℝ f y = 0 := by
      have e : v.1 • fderiv ℝ b y + v.2 • fderiv ℝ f y =
          ‖(a, c)‖⁻¹ • (a • fderiv ℝ b y + c • fderiv ℝ f y) := by
        simp only [hvdef, Prod.smul_mk, smul_eq_mul, smul_add, mul_smul]
      rw [e, hac, smul_zero]
    have hHv : H (y, v) = |b y| := by
      simp only [hH, hcomb, norm_zero, add_zero]
    have hle : H p₀ ≤ H (y, v) := isMinOn_iff.mp hmin (y, v) hvK
    rw [hHv] at hle
    linarith
  · refine ⟨1, one_pos, ?_⟩
    intro y hy _ a c _
    exact absurd ⟨(y, (1, 0)), Set.mk_mem_prod hy
      (mem_sphere_zero_iff_norm.mpr (by simp [Prod.norm_def]))⟩ hne

theorem flow_box_chart (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (y₀ : E3) (hy₀ : y₀ ∈ O)
    (hind₀ : ∀ a c : ℝ, a • fderiv ℝ b y₀ + c • fderiv ℝ f y₀ = 0 → a = 0 ∧ c = 0) :
    ∃ (k : Fin 3) (δ Lp : ℝ) (U : Set E3) (P : E3 → E3), 0 < δ ∧ IsOpen U ∧ y₀ ∈ U ∧ U ⊆ O ∧
      ContDiffOn ℝ ∞ P {w : E3 | |w 0 - f y₀| < δ ∧ |w 1 - b y₀| < δ ∧ |w 2 - y₀ k| < δ} ∧
      (∀ w : E3, |w 0 - f y₀| < δ ∧ |w 1 - b y₀| < δ ∧ |w 2 - y₀ k| < δ →
        ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
          (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w) ∧
      (∀ y ∈ U, (|f y - f y₀| < δ ∧ |b y - b y₀| < δ ∧ |y k - y₀ k| < δ) ∧
        P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y) :=
by
  
  have hdec : ∀ v : E3, v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
    intro v
    ext i
    fin_cases i <;> simp [e, EuclideanSpace.single_apply]
  have hrep : ∀ (ℓ : E3 →L[ℝ] ℝ) (v : E3),
      ℓ v = v 0 * ℓ (e 0) + v 1 * ℓ (e 1) + v 2 * ℓ (e 2) := by
    intro ℓ v
    conv_lhs => rw [hdec v]
    simp only [map_add, map_smul, smul_eq_mul]
  have hli : LinearIndependent ℝ
      ![fun i => fderiv ℝ f y₀ (e i), fun i => fderiv ℝ b y₀ (e i)] := by
    rw [LinearIndependent.pair_iff]
    intro s t hst
    have h0 := congrFun hst 0
    have h1 := congrFun hst 1
    have h2 := congrFun hst 2
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h0 h1 h2
    have hfun : t • fderiv ℝ b y₀ + s • fderiv ℝ f y₀ = 0 := by
      refine ContinuousLinearMap.ext fun v => ?_
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
        ContinuousLinearMap.zero_apply]
      rw [hrep (fderiv ℝ b y₀) v, hrep (fderiv ℝ f y₀) v]
      linear_combination v 0 * h0 + v 1 * h1 + v 2 * h2
    obtain ⟨ht, hs⟩ := hind₀ t s hfun
    exact ⟨hs, ht⟩
  have hcr : crossProduct (fun i => fderiv ℝ f y₀ (e i)) (fun i => fderiv ℝ b y₀ (e i)) ≠ 0 :=
    crossProduct_ne_zero_iff_linearIndependent.mpr hli
  obtain ⟨k, hk⟩ := Function.ne_iff.mp hcr
  have hker : ∀ v : E3, fderiv ℝ f y₀ v = 0 → fderiv ℝ b y₀ v = 0 → v k = 0 → v = 0 := by
    intro v h1 h2 h3
    rw [hrep (fderiv ℝ f y₀) v] at h1
    rw [hrep (fderiv ℝ b y₀) v] at h2
    have hk3 : k = 0 ∨ k = 1 ∨ k = 2 := by fin_cases k <;> simp
    rcases hk3 with rfl | rfl | rfl
    · have hd : fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 2)
          - fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 1) ≠ 0 := by
        simpa [cross_apply] using hk
      have hv1 : v 1 = 0 := by
        have : v 1 * (fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 2)
            - fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 1)) = 0 := by
          linear_combination fderiv ℝ b y₀ (e 2) * h1 - fderiv ℝ f y₀ (e 2) * h2
            - (fderiv ℝ b y₀ (e 2) * fderiv ℝ f y₀ (e 0)
              - fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 0)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      have hv2 : v 2 = 0 := by
        have : v 2 * (fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 2)
            - fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 1)) = 0 := by
          linear_combination -(fderiv ℝ b y₀ (e 1)) * h1 + fderiv ℝ f y₀ (e 1) * h2
            - (fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 0)
              - fderiv ℝ b y₀ (e 1) * fderiv ℝ f y₀ (e 0)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      rw [hdec v, h3, hv1, hv2]
      simp
    · have hd : fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 0)
          - fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 2) ≠ 0 := by
        simpa [cross_apply] using hk
      have hv0 : v 0 = 0 := by
        have : v 0 * (fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 0)
            - fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 2)) = 0 := by
          linear_combination -(fderiv ℝ b y₀ (e 2)) * h1 + fderiv ℝ f y₀ (e 2) * h2
            - (fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 1)
              - fderiv ℝ b y₀ (e 2) * fderiv ℝ f y₀ (e 1)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      have hv2 : v 2 = 0 := by
        have : v 2 * (fderiv ℝ f y₀ (e 2) * fderiv ℝ b y₀ (e 0)
            - fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 2)) = 0 := by
          linear_combination fderiv ℝ b y₀ (e 0) * h1 - fderiv ℝ f y₀ (e 0) * h2
            - (fderiv ℝ b y₀ (e 0) * fderiv ℝ f y₀ (e 1)
              - fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 1)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      rw [hdec v, h3, hv0, hv2]
      simp
    · have hd : fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 1)
          - fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 0) ≠ 0 := by
        simpa [cross_apply] using hk
      have hv0 : v 0 = 0 := by
        have : v 0 * (fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 1)
            - fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 0)) = 0 := by
          linear_combination fderiv ℝ b y₀ (e 1) * h1 - fderiv ℝ f y₀ (e 1) * h2
            - (fderiv ℝ b y₀ (e 1) * fderiv ℝ f y₀ (e 2)
              - fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 2)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      have hv1 : v 1 = 0 := by
        have : v 1 * (fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 1)
            - fderiv ℝ f y₀ (e 1) * fderiv ℝ b y₀ (e 0)) = 0 := by
          linear_combination -(fderiv ℝ b y₀ (e 0)) * h1 + fderiv ℝ f y₀ (e 0) * h2
            - (fderiv ℝ f y₀ (e 0) * fderiv ℝ b y₀ (e 2)
              - fderiv ℝ b y₀ (e 0) * fderiv ℝ f y₀ (e 2)) * h3
        exact (mul_eq_zero.mp this).resolve_right hd
      rw [hdec v, h3, hv0, hv1]
      simp
  
  set Θ : E3 → E3 := fun y => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k] with hΘdef
  have hΘc : ∀ y, Θ y 0 = f y ∧ Θ y 1 = b y ∧ Θ y 2 = y k := by
    intro y
    refine ⟨?_, ?_, ?_⟩ <;> rfl
  have hΘs : ContDiffOn ℝ ∞ Θ O := by
    refine (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp_contDiffOn ?_
    refine contDiffOn_pi.mpr fun i => ?_
    fin_cases i
    · simpa using hf
    · simpa using hb
    · show ContDiffOn ℝ ∞ (fun x : E3 => x k) O
      exact (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).contDiff.contDiffOn
  have hΘat : ∀ y ∈ O, ContDiffAt ℝ ∞ Θ y := fun y hy => hΘs.contDiffAt (hO.mem_nhds hy)
  have hΘd : ∀ y ∈ O, DifferentiableAt ℝ Θ y :=
    fun y hy => (hΘat y hy).differentiableAt (by simp)
  have hD0 : HasFDerivAt Θ (fderiv ℝ Θ y₀) y₀ := (hΘd y₀ hy₀).hasFDerivAt
  have hproj : ∀ i : Fin 3, HasFDerivAt (fun y => Θ y i)
      ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).comp (fderiv ℝ Θ y₀)) y₀ :=
    fun i => (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt.comp y₀ hD0
  have hf0 : (fun y => Θ y 0) = f := funext fun y => (hΘc y).1
  have hb1 : (fun y => Θ y 1) = b := funext fun y => (hΘc y).2.1
  have hk2 : (fun y => Θ y 2) = fun y : E3 => y k := funext fun y => (hΘc y).2.2
  have hinj : ∀ v : E3, fderiv ℝ Θ y₀ v = 0 → v = 0 := by
    intro v hv
    have e0 := hproj 0
    rw [hf0] at e0
    have e1 := hproj 1
    rw [hb1] at e1
    have e2 := hproj 2
    rw [hk2] at e2
    have e2' : HasFDerivAt (fun y : E3 => y k) (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) y₀ :=
      (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt
    have hu := e2.unique e2'
    apply hker v
    · rw [e0.fderiv]
      simp [hv]
    · rw [e1.fderiv]
      simp [hv]
    · have := congrArg (fun L : E3 →L[ℝ] ℝ => L v) hu
      simp only [ContinuousLinearMap.comp_apply, hv, map_zero] at this
      exact this.symm
  have hinj' : Function.Injective ((fderiv ℝ Θ y₀ : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) :=
    (injective_iff_map_eq_zero _).mpr (fun v hv => hinj v hv)
  let L₀ : E3 ≃L[ℝ] E3 := (LinearEquiv.ofInjectiveEndo _ hinj').toContinuousLinearEquiv
  have hL₀ : (L₀ : E3 →L[ℝ] E3) = fderiv ℝ Θ y₀ := by
    refine ContinuousLinearMap.ext fun v => ?_
    rfl
  
  have hD : HasFDerivAt Θ (L₀ : E3 →L[ℝ] E3) y₀ := by
    rw [hL₀]
    exact hD0
  let hom := ContDiffAt.toOpenPartialHomeomorph Θ (hΘat y₀ hy₀) hD (by simp)
  have hcoe : (hom : E3 → E3) = Θ := ContDiffAt.toOpenPartialHomeomorph_coe _ _ _
  have hy₀s : y₀ ∈ hom.source := ContDiffAt.mem_toOpenPartialHomeomorph_source _ _ _
  have hO'o : IsOpen (O ∩ (fderiv ℝ Θ) ⁻¹' Set.range
      (ContinuousLinearEquiv.toContinuousLinearMap : (E3 ≃L[ℝ] E3) → (E3 →L[ℝ] E3))) :=
    (hΘs.continuousOn_fderiv_of_isOpen hO (by simp)).isOpen_inter_preimage hO
      ContinuousLinearEquiv.isOpen
  set O' := O ∩ (fderiv ℝ Θ) ⁻¹' Set.range
      (ContinuousLinearEquiv.toContinuousLinearMap : (E3 ≃L[ℝ] E3) → (E3 →L[ℝ] E3)) with hO'def
  have hy₀O' : y₀ ∈ O' := ⟨hy₀, L₀, hL₀⟩
  have hVo : IsOpen (hom.source ∩ O') := hom.open_source.inter hO'o
  have hTo : IsOpen (hom.target ∩ hom.symm ⁻¹' O') :=
    hom.continuousOn_symm.isOpen_inter_preimage hom.open_target hO'o
  have hVO : hom.source ∩ O' ⊆ O := fun y hy => hy.2.1
  have hPT : ∀ w ∈ hom.target ∩ hom.symm ⁻¹' O',
      hom.symm w ∈ hom.source ∩ O' ∧ Θ (hom.symm w) = w := by
    intro w hw
    refine ⟨⟨hom.map_target hw.1, hw.2⟩, ?_⟩
    rw [← hcoe]
    exact hom.right_inv hw.1
  have hVT : ∀ y ∈ hom.source ∩ O',
      Θ y ∈ hom.target ∩ hom.symm ⁻¹' O' ∧ hom.symm (Θ y) = y := by
    intro y hy
    rw [← hcoe]
    refine ⟨⟨hom.map_source hy.1, ?_⟩, hom.left_inv hy.1⟩
    show hom.symm (hom y) ∈ O'
    rw [hom.left_inv hy.1]
    exact hy.2
  have hPs : ContDiffOn ℝ ∞ hom.symm (hom.target ∩ hom.symm ⁻¹' O') := by
    intro a ha
    obtain ⟨haT, haO, L, hL⟩ := ha
    refine (hom.contDiffAt_symm (f₀' := L) haT ?_ ?_).contDiffWithinAt
    · rw [hcoe, hL]
      exact (hΘd _ haO).hasFDerivAt
    · rw [hcoe]
      exact hΘat _ haO
  
  have hcT : Θ y₀ ∈ hom.target ∩ hom.symm ⁻¹' O' := (hVT y₀ ⟨hy₀s, hy₀O'⟩).1
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hTo (Θ y₀) hcT
  obtain ⟨c0, c1, c2⟩ := hΘc y₀
  have hBK : ∀ w : E3, |w 0 - f y₀| < ε / 4 ∧ |w 1 - b y₀| < ε / 4 ∧ |w 2 - y₀ k| < ε / 4 →
      w ∈ Metric.closedBall (Θ y₀) (ε / 2) := by
    rintro w ⟨h0, h1, h2⟩
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq, Fin.sum_univ_three, Real.dist_eq,
      Real.dist_eq, Real.dist_eq, sq_abs, sq_abs, sq_abs, c0, c1, c2]
    have q0 : (w 0 - f y₀) ^ 2 ≤ (ε / 4) ^ 2 :=
      sq_le_sq' (by linarith [(abs_lt.mp h0).1]) (abs_lt.mp h0).2.le
    have q1 : (w 1 - b y₀) ^ 2 ≤ (ε / 4) ^ 2 :=
      sq_le_sq' (by linarith [(abs_lt.mp h1).1]) (abs_lt.mp h1).2.le
    have q2 : (w 2 - y₀ k) ^ 2 ≤ (ε / 4) ^ 2 :=
      sq_le_sq' (by linarith [(abs_lt.mp h2).1]) (abs_lt.mp h2).2.le
    rw [show ε / 2 = Real.sqrt ((ε / 2) ^ 2) from (Real.sqrt_sq (by linarith)).symm]
    apply Real.sqrt_le_sqrt
    have h4 : (ε / 2) ^ 2 = 4 * (ε / 4) ^ 2 := by ring
    have h5 := sq_nonneg (ε / 4)
    linarith
  have hKT : Metric.closedBall (Θ y₀) (ε / 2) ⊆ hom.target ∩ hom.symm ⁻¹' O' :=
    fun w hw => hball (Metric.closedBall_subset_ball (by linarith) hw)
  obtain ⟨Lp, hLp⟩ := (isCompact_closedBall (Θ y₀) (ε / 2)).exists_bound_of_continuousOn
    ((hPs.continuousOn_fderiv_of_isOpen hTo (by simp)).mono hKT)
  have hBo : IsOpen {w : E3 | |w 0 - f y₀| < ε / 4 ∧ |w 1 - b y₀| < ε / 4 ∧
      |w 2 - y₀ k| < ε / 4} := by
    have hc : ∀ (i : Fin 3) (r : ℝ), Continuous fun w : E3 => |w i - r| := fun i r =>
      ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).continuous.sub continuous_const).abs
    exact (isOpen_lt (hc 0 _) continuous_const).inter
      ((isOpen_lt (hc 1 _) continuous_const).inter (isOpen_lt (hc 2 _) continuous_const))
  refine ⟨k, ε / 4, Lp, (hom.source ∩ O') ∩ Θ ⁻¹' {w : E3 | |w 0 - f y₀| < ε / 4 ∧
      |w 1 - b y₀| < ε / 4 ∧ |w 2 - y₀ k| < ε / 4}, hom.symm, by positivity,
    (hΘs.continuousOn.mono hVO).isOpen_inter_preimage hVo hBo, ⟨⟨hy₀s, hy₀O'⟩, ?_⟩,
    fun y hy => hVO hy.1, hPs.mono (fun w hw => hKT (hBK w hw)), ?_, ?_⟩
  · show |Θ y₀ 0 - f y₀| < ε / 4 ∧ |Θ y₀ 1 - b y₀| < ε / 4 ∧ |Θ y₀ 2 - y₀ k| < ε / 4
    rw [c0, c1, c2]
    simp only [sub_self, abs_zero]
    exact ⟨by positivity, by positivity, by positivity⟩
  · intro w hw
    obtain ⟨hPV, hPw⟩ := hPT w (hKT (hBK w hw))
    refine ⟨hLp w (hBK w hw), ⟨hPV, ?_⟩, hPw⟩
    rw [Set.mem_preimage, hPw]
    exact hw
  · intro y hy
    obtain ⟨hyV, hyB⟩ := hy
    obtain ⟨_, hPΘ⟩ := hVT y hyV
    obtain ⟨d0, d1, d2⟩ := hΘc y
    have hyB' : |Θ y 0 - f y₀| < ε / 4 ∧ |Θ y 1 - b y₀| < ε / 4 ∧ |Θ y 2 - y₀ k| < ε / 4 := hyB
    rw [d0, d1, d2] at hyB'
    exact ⟨hyB', hPΘ⟩

theorem half_plane_kernel_limit (g : E2 → ℝ) (hg : Continuous g) (hc : HasCompactSupport g)
    (σ R M : ℝ) (hR0 : 0 ≤ R) (hM : ∀ z, |g z| ≤ M) (hR : ∀ z : E2, R < |z 1 - σ| → g z = 0) :
    (∀ s : ℝ, 0 < s →
      |∫ z in {z : E2 | 0 ≤ z 0}, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g z| ≤ 2 * R * M) ∧
    Tendsto (fun s => ∫ z in {z : E2 | 0 ≤ z 0}, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g z)
      (𝓝[>] (0:ℝ)) (𝓝 (∫ x : ℝ, g ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]))) :=
by
  
  have hη1 : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff (n := 1)
  have hk : Continuous (deriv Real.smoothTransition) := hη1.continuous_deriv le_rfl
  have hk0 : ∀ x, 0 ≤ deriv Real.smoothTransition x :=
    fun x => Real.smoothTransition.monotone.deriv_nonneg
  have hkn : ∀ x : ℝ, x ≤ 0 → deriv Real.smoothTransition x = 0 := by
    intro x hx
    have hmin : IsMinOn Real.smoothTransition Set.univ x := by
      rw [isMinOn_univ_iff]
      intro y
      rw [Real.smoothTransition.zero_of_nonpos hx]
      exact Real.smoothTransition.nonneg y
    exact (hmin.isLocalMin Filter.univ_mem).deriv_eq_zero
  have hk1 : ∀ x : ℝ, 1 ≤ x → deriv Real.smoothTransition x = 0 := by
    intro x hx
    have hmax : IsMaxOn Real.smoothTransition Set.univ x := by
      rw [isMaxOn_univ_iff]
      intro y
      rw [Real.smoothTransition.one_of_one_le hx]
      exact Real.smoothTransition.le_one y
    exact (hmax.isLocalMax Filter.univ_mem).deriv_eq_zero
  have hint01 : ∫ x in (0:ℝ)..1, deriv Real.smoothTransition x = 1 := by
    rw [intervalIntegral.integral_deriv_eq_sub (fun x _ => (hη1.differentiable one_ne_zero) x)
      (hk.intervalIntegrable _ _)]
    rw [Real.smoothTransition.one_of_one_le le_rfl, Real.smoothTransition.zero_of_nonpos le_rfl]
    norm_num
  have hkI : ∫ x, deriv Real.smoothTransition x = 1 := by
    have hz : ∀ x, x ∉ Set.Ioc (0:ℝ) 1 → deriv Real.smoothTransition x = 0 := by
      intro x hx
      simp only [Set.mem_Ioc, not_and_or, not_lt, not_le] at hx
      rcases hx with h | h
      · exact hkn x h
      · exact hk1 x h.le
    have h := setIntegral_eq_integral_of_forall_compl_eq_zero (μ := volume) hz
    rw [← h, ← intervalIntegral.integral_of_le zero_le_one, hint01]
  set k : ℝ → ℝ := deriv Real.smoothTransition with hkdef
  
  have hks0 : ∀ s : ℝ, 0 < s → ∀ u : ℝ, 0 ≤ s⁻¹ * k (u / s) :=
    fun s hs u => mul_nonneg (inv_nonneg.mpr hs.le) (hk0 _)
  have hksz : ∀ s : ℝ, 0 < s → ∀ u : ℝ, (u < 0 ∨ s < u) → s⁻¹ * k (u / s) = 0 := by
    intro s hs u hu
    rcases hu with h | h
    · rw [hkn _ (div_nonpos_of_nonpos_of_nonneg h.le hs.le), mul_zero]
    · rw [hk1 _ ((one_le_div hs).mpr h.le), mul_zero]
  have hksI : ∀ s : ℝ, 0 < s → ∫ u, s⁻¹ * k (u / s) = 1 := by
    intro s hs
    rw [integral_const_mul, Measure.integral_comp_div k s, hkI, abs_of_pos hs, smul_eq_mul,
      mul_one, inv_mul_cancel₀ hs.ne']
  have hksint : ∀ s : ℝ, 0 < s → ∀ φ : ℝ → ℝ, Continuous φ →
      Integrable (fun u => s⁻¹ * k (u / s) * φ u) := by
    intro s hs φ hφ
    apply Continuous.integrable_of_hasCompactSupport
    · exact (continuous_const.mul (hk.comp (continuous_id.div_const s))).mul hφ
    · apply HasCompactSupport.intro (isCompact_Icc (a := (0:ℝ)) (b := s))
      intro u hu
      simp only [Set.mem_Icc, not_and_or, not_le] at hu
      rw [hksz s hs u hu, zero_mul]
  have hkerA : ∀ s : ℝ, 0 < s → ∀ h : ℝ → ℝ, Continuous h → ∀ B : ℝ,
      (∀ u : ℝ, 0 ≤ u → u ≤ s → |h u| ≤ B) → |∫ u, s⁻¹ * k (u / s) * h u| ≤ B := by
    intro s hs h hh B hB
    have hpt : ∀ u, ‖s⁻¹ * k (u / s) * h u‖ ≤ s⁻¹ * k (u / s) * B := by
      intro u
      by_cases hu : 0 ≤ u ∧ u ≤ s
      · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hks0 s hs u)]
        exact mul_le_mul_of_nonneg_left (hB u hu.1 hu.2) (hks0 s hs u)
      · have hu' : u < 0 ∨ s < u := by
          rcases not_and_or.mp hu with h1 | h1
          · exact Or.inl (not_le.mp h1)
          · exact Or.inr (not_le.mp h1)
        rw [hksz s hs u hu']
        simp
    have hI := norm_integral_le_of_norm_le
      (hksint s hs (fun _ => B) continuous_const : Integrable (fun u => s⁻¹ * k (u / s) * B))
      (Filter.Eventually.of_forall hpt)
    rw [integral_mul_const, hksI s hs, one_mul, Real.norm_eq_abs] at hI
    exact hI
  have hkerB : ∀ s : ℝ, 0 < s → ∀ h : ℝ → ℝ, Continuous h → ∀ B : ℝ,
      (∀ u : ℝ, 0 ≤ u → u ≤ s → |h u - h 0| ≤ B) →
      |(∫ u, s⁻¹ * k (u / s) * h u) - h 0| ≤ B := by
    intro s hs h hh B hB
    have hi1 : Integrable (fun u => s⁻¹ * k (u / s) * h u) := hksint s hs h hh
    have hi2 : Integrable (fun u => s⁻¹ * k (u / s) * h 0) :=
      hksint s hs (fun _ => h 0) continuous_const
    have h3 : ∫ u, s⁻¹ * k (u / s) * (h u - h 0) =
        (∫ u, s⁻¹ * k (u / s) * h u) - ∫ u, s⁻¹ * k (u / s) * h 0 := by
      rw [← integral_sub hi1 hi2]
      congr 1
      funext u
      ring
    have heq : (∫ u, s⁻¹ * k (u / s) * h u) - h 0 = ∫ u, s⁻¹ * k (u / s) * (h u - h 0) := by
      rw [h3, integral_mul_const, hksI s hs, one_mul]
    rw [heq]
    exact hkerA s hs (fun u => h u - h 0) (hh.sub continuous_const) B hB
  
  obtain ⟨ι, hι⟩ : ∃ ι : ℝ → ℝ → E2,
      ∀ u x, ι u x = (EuclideanSpace.equiv (Fin 2) ℝ).symm ![u, x] := ⟨_, fun _ _ => rfl⟩
  have hι0 : ∀ u x, ι u x 0 = u := fun u x => by rw [hι]; rfl
  have hι1 : ∀ u x, ι u x 1 = x := fun u x => by rw [hι]; rfl
  have hιu : ∀ x, Continuous (fun u => ι u x) := by
    intro x
    simp only [hι]
    first
      | exact (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp
          (continuous_id.matrixVecCons continuous_const)
      | fun_prop
  have hιx : ∀ u, Continuous (fun x => ι u x) := by
    intro u
    simp only [hι]
    first
      | exact (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp
          (continuous_const.matrixVecCons (continuous_id.matrixVecCons continuous_const))
      | fun_prop
  have hιu' : ∀ x, Continuous (fun u => g (ι u x)) := fun x => hg.comp (hιu x)
  have hιx' : ∀ u, Continuous (fun x => g (ι u x)) := fun u => hg.comp (hιx u)
  have hdist : ∀ u x, dist (ι u x) (ι 0 x) = |u| := by
    intro u x
    rw [hι, hι, EuclideanSpace.dist_eq]
    simp [Fin.sum_univ_two, Real.dist_eq, Real.sqrt_sq_eq_abs]
  
  let eM : ℝ × ℝ ≃ᵐ E2 :=
    MeasurableEquiv.finTwoArrow.symm.trans (MeasurableEquiv.toLp 2 (Fin 2 → ℝ))
  have heM : ∀ u x, eM (u, x) = ι u x := fun u x => by rw [hι]; rfl
  have hmp : MeasurePreserving (⇑eM) volume volume :=
    (PiLp.volume_preserving_toLp (Fin 2)).comp (volume_preserving_finTwoArrow ℝ).symm
  have hfub : ∀ F : E2 → ℝ, Integrable F →
      Integrable (fun x => ∫ u, F (ι u x)) ∧ ∫ z, F z = ∫ x, ∫ u, F (ι u x) := by
    intro F hF
    have hFe : Integrable (fun p : ℝ × ℝ => F (eM p))
        ((volume : Measure ℝ).prod (volume : Measure ℝ)) :=
      hmp.integrable_comp_of_integrable hF
    refine ⟨?_, ?_⟩
    · have h1 := hFe.integral_prod_right
      simp only [heM] at h1
      exact h1
    · calc ∫ z, F z = ∫ p, F (eM p) ∂((volume : Measure ℝ).prod (volume : Measure ℝ)) :=
            (hmp.integral_comp' F).symm
        _ = ∫ x, ∫ u, F (eM (u, x)) := integral_prod_symm _ hFe
        _ = ∫ x, ∫ u, F (ι u x) := by simp only [heM]
  
  have hrep : ∀ s : ℝ, 0 < s →
      Integrable (fun x => ∫ u, s⁻¹ * k (u / s) * g (ι u x)) ∧
      ∫ z in {z : E2 | 0 ≤ z 0}, s⁻¹ * k (z 0 / s) * g z =
        ∫ x, ∫ u, s⁻¹ * k (u / s) * g (ι u x) := by
    intro s hs
    have hc0 : Continuous (fun z : E2 => z 0) := by
      first
        | exact PiLp.continuous_apply 2 _ 0
        | exact (EuclideanSpace.proj (0 : Fin 2)).continuous
        | fun_prop
    have hKc : Continuous (fun z : E2 => s⁻¹ * k (z 0 / s) * g z) :=
      (continuous_const.mul (hk.comp (hc0.div_const s))).mul hg
    have hKs : HasCompactSupport (fun z : E2 => s⁻¹ * k (z 0 / s) * g z) := hc.mul_left
    have hKi : Integrable (fun z : E2 => s⁻¹ * k (z 0 / s) * g z) :=
      hKc.integrable_of_hasCompactSupport hKs
    obtain ⟨h1, h2⟩ := hfub _ hKi
    simp only [hι0] at h1 h2
    refine ⟨h1, ?_⟩
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero, h2]
    intro z hz
    simp only [Set.mem_setOf_eq, not_le] at hz
    rw [hkn _ (div_nonpos_of_nonpos_of_nonneg hz.le hs.le), mul_zero, zero_mul]
  
  have hV : ∀ x, x ∉ Set.Icc (σ - R) (σ + R) → ∀ u, g (ι u x) = 0 := by
    intro x hx u
    apply hR
    rw [hι1]
    simp only [Set.mem_Icc, not_and_or, not_le] at hx
    rw [lt_abs]
    rcases hx with h | h
    · right; linarith
    · left; linarith
  have hJvol : volume.real (Set.Icc (σ - R) (σ + R)) = 2 * R := by
    rw [Real.volume_real_Icc_of_le (by linarith)]
    ring
  have hJint : ∀ c : ℝ, Integrable ((Set.Icc (σ - R) (σ + R)).indicator (fun _ => c)) :=
    fun c => (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  refine ⟨fun s hs => ?_, ?_⟩
  · 
    obtain ⟨hAi, hIeq⟩ := hrep s hs
    rw [hIeq]
    have hpt : ∀ x, ‖∫ u, s⁻¹ * k (u / s) * g (ι u x)‖ ≤
        (Set.Icc (σ - R) (σ + R)).indicator (fun _ => M) x := by
      intro x
      rw [Real.norm_eq_abs]
      by_cases hx : x ∈ Set.Icc (σ - R) (σ + R)
      · rw [Set.indicator_of_mem hx]
        exact hkerA s hs _ (hιu' x) M (fun u _ _ => hM _)
      · rw [Set.indicator_of_notMem hx]
        exact hkerA s hs _ (hιu' x) 0 (fun u _ _ => by rw [hV x hx u, abs_zero])
    have hI := norm_integral_le_of_norm_le (hJint M) (Filter.Eventually.of_forall hpt)
    rw [integral_indicator_const M measurableSet_Icc, hJvol, smul_eq_mul,
      Real.norm_eq_abs] at hI
    exact hI
  · 
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    have h2R : 0 < 2 * R + 1 := by linarith
    have hε'0 : 0 < ε / (2 * R + 1) := div_pos hε h2R
    obtain ⟨δ, hδ, hδg⟩ :=
      Metric.uniformContinuous_iff.mp (hc.uniformContinuous_of_continuous hg) _ hε'0
    refine ⟨δ, hδ, ?_⟩
    intro s hs hsd
    have hs0 : 0 < s := hs
    have hsδ : s < δ := by
      rw [Real.dist_eq, sub_zero, abs_of_pos hs0] at hsd
      exact hsd
    obtain ⟨hAi, hIeq⟩ := hrep s hs0
    have hG0i : Integrable (fun x => g (ι 0 x)) := by
      apply (hιx' 0).integrable_of_hasCompactSupport
      apply HasCompactSupport.intro (isCompact_Icc (a := σ - R) (b := σ + R))
      intro x hx
      exact hV x hx 0
    have hpt : ∀ x, ‖(∫ u, s⁻¹ * k (u / s) * g (ι u x)) - g (ι 0 x)‖ ≤
        (Set.Icc (σ - R) (σ + R)).indicator (fun _ => ε / (2 * R + 1)) x := by
      intro x
      rw [Real.norm_eq_abs]
      by_cases hx : x ∈ Set.Icc (σ - R) (σ + R)
      · rw [Set.indicator_of_mem hx]
        refine hkerB s hs0 _ (hιu' x) _ (fun u hu0 hus => ?_)
        have hd : dist (ι u x) (ι 0 x) < δ := by
          rw [hdist, abs_of_nonneg hu0]
          linarith
        have h4 := hδg hd
        rw [Real.dist_eq] at h4
        exact h4.le
      · rw [Set.indicator_of_notMem hx]
        refine hkerB s hs0 _ (hιu' x) 0 (fun u _ _ => ?_)
        rw [hV x hx u, hV x hx 0, sub_zero, abs_zero]
    have hint := norm_integral_le_of_norm_le (hJint _) (Filter.Eventually.of_forall hpt)
    rw [integral_sub hAi hG0i, integral_indicator_const _ measurableSet_Icc, hJvol, smul_eq_mul,
      Real.norm_eq_abs] at hint
    have hL : ∫ x : ℝ, g ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) =
        ∫ x : ℝ, g (ι 0 x) := by
      simp only [hι]
    try dsimp only
    rw [Real.dist_eq, hIeq, hL]
    have hfin : 2 * R * (ε / (2 * R + 1)) < ε := by
      rw [mul_div_assoc', div_lt_iff₀ h2R]
      nlinarith
    linarith

theorem box_profile_props (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U)
    (J : E3 → ℝ)
    (hJ : ∀ w : E3, J w = Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
        (fun j => fderiv ℝ P w (e 2) j) i) ^ 2))
    (g : ℝ → E2 → ℝ)
    (hg : ∀ (t : ℝ) (z : E2), g t z = if |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ then
        ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) *
          J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) else 0) :
    ∃ M : ℝ, ∀ t : ℝ, Continuous (g t) ∧ HasCompactSupport (g t) ∧ (∀ z : E2, |g t z| ≤ M) ∧
      (∀ z : E2, δ < |z 1 - σ₀| → g t z = 0) :=
by
  classical
  
  obtain ⟨L, hL⟩ : ∃ L : ℝ → E2 → E3, ∀ (t : ℝ) (z : E2),
      L t z = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] := ⟨_, fun _ _ => rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : E3 → E3, ∀ y : E3,
      Θ y = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k] := ⟨_, fun _ => rfl⟩
  obtain ⟨V, hVdef⟩ : ∃ V : Set E3,
      V = {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := ⟨_, rfl⟩
  rw [← hVdef] at hP
  have hmemV : ∀ w : E3, w ∈ V ↔ (|w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ) := by
    intro w; rw [hVdef]; rfl
  have hLc : ∀ (t : ℝ) (z : E2), L t z 0 = t ∧ L t z 1 = z 0 ∧ L t z 2 = z 1 := by
    intro t z; rw [hL]; exact ⟨rfl, rfl, rfl⟩
  have hΘc : ∀ y : E3, Θ y 0 = f y ∧ Θ y 1 = b y ∧ Θ y 2 = y k := by
    intro y; rw [hΘ]; exact ⟨rfl, rfl, rfl⟩
  have hcoord : ∀ i : Fin 3, Continuous fun w : E3 => w i := fun i => PiLp.continuous_apply 2 _ i
  
  have hV : IsOpen V := by
    rw [hVdef]
    exact (isOpen_lt (continuous_abs.comp ((hcoord 0).sub continuous_const)) continuous_const).and
      ((isOpen_lt (continuous_abs.comp ((hcoord 1).sub continuous_const)) continuous_const).and
        (isOpen_lt (continuous_abs.comp ((hcoord 2).sub continuous_const)) continuous_const))
  
  have hLiso : ∀ t : ℝ, Isometry (L t) := by
    intro t
    refine Isometry.of_dist_eq (fun z z' => ?_)
    rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq, Fin.sum_univ_three, Fin.sum_univ_two]
    obtain ⟨a0, a1, a2⟩ := hLc t z
    obtain ⟨b0, b1, b2⟩ := hLc t z'
    rw [a0, a1, a2, b0, b1, b2, dist_self]
    congr 1
    ring
  
  have hΘO : ContinuousOn Θ O := by
    have hΘeq : Θ = fun y => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k] := funext hΘ
    rw [hΘeq]
    refine (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp_continuousOn ?_
    refine continuousOn_pi.mpr (fun i => ?_)
    fin_cases i
    · exact hf.continuousOn
    · exact hb.continuousOn
    · exact (hcoord k).continuousOn
  
  have hcond : ∀ (t : ℝ) (z : E2), (|t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ) ↔
      L t z ∈ V := by
    intro t z
    rw [hmemV]
    obtain ⟨h0, h1, h2⟩ := hLc t z
    rw [h0, h1, h2]
  have hg' : ∀ (t : ℝ) (z : E2), g t z = if |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ then
      ψ (P (L t z)) * J (L t z) else 0 := by
    intro t z
    rw [hg t z, ← hL t z]
  have hgW : ∀ (t : ℝ) (z : E2), L t z ∈ V → g t z = ψ (P (L t z)) * J (L t z) := by
    intro t z h
    rw [hg' t z, if_pos ((hcond t z).2 h)]
  have hg0 : ∀ (t : ℝ) (z : E2), L t z ∉ V → g t z = 0 := by
    intro t z h
    rw [hg' t z, if_neg (fun h' => h ((hcond t z).1 h'))]
  have hPV' : ∀ w ∈ V, ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧ Θ (P w) = w := by
    intro w hw
    rw [hΘ]
    exact hPV w ((hmemV w).1 hw)
  have hΘV : ∀ y ∈ U, Θ y ∈ V := by
    intro y hy
    rw [hmemV]
    obtain ⟨a0, a1, a2⟩ := hΘc y
    rw [a0, a1, a2]
    exact (hPU y hy).1
  
  have hLag : ∀ u v : Fin 3 → ℝ, ∑ i : Fin 3, (crossProduct u v i) ^ 2 ≤
      (∑ i : Fin 3, u i ^ 2) * (∑ i : Fin 3, v i ^ 2) := by
    intro u v
    have key : ∑ i : Fin 3, (crossProduct u v i) ^ 2 =
        (∑ i : Fin 3, u i ^ 2) * (∑ i : Fin 3, v i ^ 2) -
          (u 0 * v 0 + u 1 * v 1 + u 2 * v 2) ^ 2 := by
      simp [cross_apply, Fin.sum_univ_three]
      ring
    rw [key]
    nlinarith [sq_nonneg (u 0 * v 0 + u 1 * v 1 + u 2 * v 2)]
  have hJle : ∀ w ∈ V, 0 ≤ J w ∧ J w ≤ Lp ^ 2 := by
    intro w hwV
    have hw := (hPV' w hwV).1
    rw [hJ w]
    refine ⟨Real.sqrt_nonneg _, ?_⟩
    have hq : ∀ j : Fin 3, ∑ i : Fin 3, (fderiv ℝ P w (e j) i) ^ 2 ≤ Lp ^ 2 := by
      intro j
      have h1 : ‖fderiv ℝ P w (e j)‖ ≤ Lp := by
        calc ‖fderiv ℝ P w (e j)‖ ≤ ‖fderiv ℝ P w‖ * ‖e j‖ := (fderiv ℝ P w).le_opNorm _
          _ = ‖fderiv ℝ P w‖ := by simp [e, EuclideanSpace.norm_single]
          _ ≤ Lp := hw
      have h2 : ‖fderiv ℝ P w (e j)‖ ^ 2 = ∑ i : Fin 3, (fderiv ℝ P w (e j) i) ^ 2 := by
        rw [EuclideanSpace.norm_sq_eq]
        simp [Real.norm_eq_abs, sq_abs]
      rw [← h2]
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2
    have h3 := hLag (fun j => fderiv ℝ P w (e 1) j) (fun j => fderiv ℝ P w (e 2) j)
    have h4 : (∑ i : Fin 3, (fun j => fderiv ℝ P w (e 1) j) i ^ 2) *
        (∑ i : Fin 3, (fun j => fderiv ℝ P w (e 2) j) i ^ 2) ≤ Lp ^ 2 * Lp ^ 2 :=
      mul_le_mul (hq 1) (hq 2) (Finset.sum_nonneg (fun i _ => sq_nonneg _)) (sq_nonneg _)
    calc Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
          (fun j => fderiv ℝ P w (e 2) j) i) ^ 2) ≤ Real.sqrt ((Lp ^ 2) ^ 2) :=
          Real.sqrt_le_sqrt (by nlinarith)
      _ = Lp ^ 2 := Real.sqrt_sq (sq_nonneg _)
  
  have hJc : ContinuousOn J V := by
    have hD : ContinuousOn (fderiv ℝ P) V := hP.continuousOn_fderiv_of_isOpen hV (by simp)
    have hcomp : ∀ j i : Fin 3, ContinuousOn (fun w => fderiv ℝ P w (e j) i) V := by
      intro j i
      exact (hcoord i).comp_continuousOn (hD.clm_apply continuousOn_const)
    have a0 := hcomp 1 0
    have a1 := hcomp 1 1
    have a2 := hcomp 1 2
    have b0 := hcomp 2 0
    have b1 := hcomp 2 1
    have b2 := hcomp 2 2
    have hcr : ∀ i : Fin 3, ContinuousOn (fun w => crossProduct (fun j => fderiv ℝ P w (e 1) j)
        (fun j => fderiv ℝ P w (e 2) j) i) V := by
      intro i
      fin_cases i <;> simp [cross_apply] <;> fun_prop
    have heq : J = fun w => Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
        (fun j => fderiv ℝ P w (e 2) j) i) ^ 2) := funext hJ
    rw [heq]
    exact (continuousOn_finset_sum _ (fun i _ => (hcr i).pow 2)).sqrt
  
  obtain ⟨Cψ, hCψ⟩ := hψ.bounded_above_of_compact_support hψc
  have hCψ0 : 0 ≤ Cψ := (norm_nonneg _).trans (hCψ 0)
  have hKimg : IsCompact (Θ '' tsupport ψ) :=
    hψc.image_of_continuousOn (hΘO.mono (hψU.trans hUO))
  refine ⟨Cψ * Lp ^ 2, fun t => ?_⟩
  have hKt : IsCompact (L t ⁻¹' (Θ '' tsupport ψ)) :=
    (hLiso t).isClosedEmbedding.isCompact_preimage hKimg
  have hS : ∀ z : E2, g t z ≠ 0 → z ∈ L t ⁻¹' (Θ '' tsupport ψ) := by
    intro z hz
    by_cases h : L t z ∈ V
    · rw [hgW t z h] at hz
      have hψne : ψ (P (L t z)) ≠ 0 := left_ne_zero_of_mul hz
      obtain ⟨-, -, hΘP⟩ := hPV' _ h
      exact ⟨P (L t z), subset_tsupport _ hψne, hΘP⟩
    · exact absurd (hg0 t z h) hz
  have hKW : L t ⁻¹' (Θ '' tsupport ψ) ⊆ L t ⁻¹' V := by
    rintro z ⟨y, hy, hyz⟩
    show L t z ∈ V
    rw [← hyz]
    exact hΘV y (hψU hy)
  have htsupp : tsupport (g t) ⊆ L t ⁻¹' (Θ '' tsupport ψ) :=
    closure_minimal (fun z hz => hS z hz) hKt.isClosed
  have hgcont : ContinuousOn (g t) (L t ⁻¹' V) := by
    have h1 : ContinuousOn (fun z => ψ (P (L t z)) * J (L t z)) (L t ⁻¹' V) := by
      refine ContinuousOn.mul ?_ ?_
      · exact hψ.comp_continuousOn
          (hP.continuousOn.comp (hLiso t).continuous.continuousOn (fun z hz => hz))
      · exact hJc.comp (hLiso t).continuous.continuousOn (fun z hz => hz)
    exact h1.congr (fun z hz => hgW t z hz)
  refine ⟨hgcont.continuous_of_tsupport_subset (hV.preimage (hLiso t).continuous)
    (htsupp.trans hKW), HasCompactSupport.intro hKt (fun z hz => by_contra fun h => hz (hS z h)),
    ?_, ?_⟩
  · intro z
    by_cases h : L t z ∈ V
    · rw [hgW t z h, abs_mul, abs_of_nonneg (hJle _ h).1]
      have hψb : |ψ (P (L t z))| ≤ Cψ := by
        have := hCψ (P (L t z))
        rwa [Real.norm_eq_abs] at this
      exact mul_le_mul hψb (hJle _ h).2 (hJle _ h).1 hCψ0
    · rw [hg0 t z h, abs_zero]
      exact mul_nonneg hCψ0 (sq_nonneg _)
  · intro z hz
    apply hg0
    intro h
    have h3 := ((hmemV _).1 h).2.2
    rw [(hLc t z).2.2] at h3
    linarith

theorem sbgb_linear_area (hspec : 0 < sbgbAreaConst ∧ ∀ S : Set E2,
      ENNReal.ofReal sbgbAreaConst * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) S =
        MeasureTheory.volume S)
    (A : E2 →L[ℝ] E3) (hA : Function.Injective A) (S : Set E2) :
    MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (A '' S) =
      ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2)) *
        MeasureTheory.volume S :=
by
  obtain ⟨hc, hsp⟩ := hspec
  
  have hAy : ∀ (y : E2) (i : Fin 3), A y i = y 0 * A (e2 0) i + y 1 * A (e2 1) i := by
    intro y i
    have hdecomp : y = y 0 • e2 0 + y 1 • e2 1 := by
      ext j
      fin_cases j <;> simp [EuclideanSpace.single_apply]
    conv_lhs => rw [hdecomp]
    simp only [map_add, map_smul, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
  have hnormE3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
    simp only [Real.norm_eq_abs, sq_abs]
  have hnormE2 : ∀ x : E2, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
    simp only [Real.norm_eq_abs, sq_abs]
  have hext : ∀ x y : E2, x 0 = y 0 → x 1 = y 1 → x = y := by
    intro x y h0 h1
    ext i
    fin_cases i
    · exact h0
    · exact h1
  have hlin : ∀ (N : Matrix (Fin 2) (Fin 2) ℝ) (z : E2) (i : Fin 2),
      Matrix.toLin (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis
        (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis N z i = N i 0 * z 0 + N i 1 * z 1 := by
    intro N z i
    rw [Matrix.toLin_apply]
    fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two, EuclideanSpace.single_apply]
  
  obtain ⟨u0, hu0⟩ : ∃ r : ℝ, A (e2 0) 0 = r := ⟨_, rfl⟩
  obtain ⟨u1, hu1⟩ : ∃ r : ℝ, A (e2 0) 1 = r := ⟨_, rfl⟩
  obtain ⟨u2, hu2⟩ : ∃ r : ℝ, A (e2 0) 2 = r := ⟨_, rfl⟩
  obtain ⟨v0, hv0⟩ : ∃ r : ℝ, A (e2 1) 0 = r := ⟨_, rfl⟩
  obtain ⟨v1, hv1⟩ : ∃ r : ℝ, A (e2 1) 1 = r := ⟨_, rfl⟩
  obtain ⟨v2, hv2⟩ : ∃ r : ℝ, A (e2 1) 2 = r := ⟨_, rfl⟩
  have hA0 : ∀ y : E2, A y 0 = y 0 * u0 + y 1 * v0 := fun y => by rw [hAy, hu0, hv0]
  have hA1 : ∀ y : E2, A y 1 = y 0 * u1 + y 1 * v1 := fun y => by rw [hAy, hu1, hv1]
  have hA2 : ∀ y : E2, A y 2 = y 0 * u2 + y 1 * v2 := fun y => by rw [hAy, hu2, hv2]
  obtain ⟨P, hP⟩ : ∃ r : ℝ, r = u0 ^ 2 + u1 ^ 2 + u2 ^ 2 := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ r : ℝ, r = v0 ^ 2 + v1 ^ 2 + v2 ^ 2 := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ r : ℝ, r = u0 * v0 + u1 * v1 + u2 * v2 := ⟨_, rfl⟩
  have hgram : ∀ a γ : ℝ, (a * u0 + γ * v0) ^ 2 + (a * u1 + γ * v1) ^ 2 + (a * u2 + γ * v2) ^ 2 =
      a ^ 2 * P + 2 * a * γ * B + γ ^ 2 * Q := by
    intro a γ
    rw [hP, hQ, hB]
    ring
  have hcross : ∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2 =
      (u1 * v2 - u2 * v1) ^ 2 + (u2 * v0 - u0 * v2) ^ 2 + (u0 * v1 - u1 * v0) ^ 2 := by
    simp only [gsCrossN, gsTan, ContinuousLinearMap.fderiv, Fin.sum_univ_three,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons]
    rw [hu0, hu1, hu2, hv0, hv1, hv2]
  have hD : ∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2 = P * Q - B ^ 2 := by
    rw [hcross, hP, hQ, hB]
    ring
  
  have he0 : (e2 0 : E2) ≠ 0 := by
    intro h
    have h' := congrArg (fun x : E2 => x 0) h
    simp at h'
  have hPpos : 0 < P := by
    have hune : A (e2 0) ≠ 0 := fun h => he0 (hA (by rw [h, map_zero]))
    have h1 : 0 < ‖A (e2 0)‖ ^ 2 := pow_pos (norm_pos_iff.2 hune) 2
    rw [hnormE3, hu0, hu1, hu2] at h1
    rw [hP]
    exact h1
  have hDpos : 0 < P * Q - B ^ 2 := by
    obtain ⟨w, hw⟩ : ∃ w : E2, w = (-B) • e2 0 + P • e2 1 := ⟨_, rfl⟩
    have hw0 : w 0 = -B := by simp [hw]
    have hw1 : w 1 = P := by simp [hw]
    have hwne : w ≠ 0 := by
      intro h
      rw [h] at hw1
      simp at hw1
      linarith
    have hAw : A w ≠ 0 := fun h => hwne (hA (by rw [h, map_zero]))
    have h1 : 0 < ‖A w‖ ^ 2 := pow_pos (norm_pos_iff.2 hAw) 2
    rw [hnormE3, hA0, hA1, hA2, hw0, hw1, hgram] at h1
    have h2 : (-B) ^ 2 * P + 2 * (-B) * P * B + P ^ 2 * Q = P * (P * Q - B ^ 2) := by ring
    rw [h2] at h1
    by_contra hcon
    push_neg at hcon
    have := mul_nonpos_of_nonneg_of_nonpos hPpos.le hcon
    linarith
  
  obtain ⟨s, hs⟩ : ∃ r : ℝ, r = Real.sqrt P := ⟨_, rfl⟩
  have hs0 : 0 < s := by rw [hs]; exact Real.sqrt_pos.2 hPpos
  have hs2 : s ^ 2 = P := by rw [hs]; exact Real.sq_sqrt hPpos.le
  have ht0 : 0 < Real.sqrt (∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2) := by
    rw [hD]; exact Real.sqrt_pos.2 hDpos
  have ht2 : Real.sqrt (∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2) ^ 2 = P * Q - B ^ 2 := by
    rw [hD]; exact Real.sq_sqrt hDpos.le
  generalize htdef : Real.sqrt (∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2) = t at ht0 ht2 ⊢
  obtain ⟨si, hsi⟩ : ∃ r : ℝ, s * r = 1 := ⟨s⁻¹, mul_inv_cancel₀ hs0.ne'⟩
  obtain ⟨ti, hti⟩ : ∃ r : ℝ, t * r = 1 := ⟨t⁻¹, mul_inv_cancel₀ ht0.ne'⟩
  
  obtain ⟨R, hRdef⟩ : ∃ R : E2 →ₗ[ℝ] E2, R = Matrix.toLin (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis
      (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis !![s, B * si; 0, t * si] := ⟨_, rfl⟩
  obtain ⟨Ri, hRidef⟩ : ∃ R : E2 →ₗ[ℝ] E2, R = Matrix.toLin (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis
      (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis !![si, -(B * si * ti); 0, s * ti] := ⟨_, rfl⟩
  have hR0 : ∀ z : E2, R z 0 = s * z 0 + B * si * z 1 := fun z => by rw [hRdef, hlin]; simp
  have hR1 : ∀ z : E2, R z 1 = t * si * z 1 := fun z => by rw [hRdef, hlin]; simp
  have hRi0 : ∀ z : E2, Ri z 0 = si * z 0 + -(B * si * ti) * z 1 := fun z => by
    rw [hRidef, hlin]; simp
  have hRi1 : ∀ z : E2, Ri z 1 = s * ti * z 1 := fun z => by rw [hRidef, hlin]; simp
  have hdet : LinearMap.det R = t := by
    rw [hRdef, LinearMap.det_toLin, Matrix.det_fin_two_of]
    linear_combination t * hsi
  have hRiR : ∀ z : E2, Ri (R z) = z := by
    intro z
    apply hext
    · rw [hRi0, hR0, hR1]
      linear_combination z 0 * hsi - B * si ^ 2 * z 1 * hti
    · rw [hRi1, hR1]
      linear_combination z 1 * t * ti * hsi + z 1 * hti
  
  set Ψ : E2 →ₗ[ℝ] E3 := (A : E2 →ₗ[ℝ] E3) ∘ₗ Ri with hΨdef
  have hΨapp : ∀ w : E2, Ψ w = A (Ri w) := fun w => rfl
  have hΨR : ∀ z : E2, Ψ (R z) = A z := fun z => by rw [hΨapp, hRiR]
  have hΨiso : Isometry Ψ := by
    refine AddMonoidHomClass.isometry_of_norm Ψ (fun w => ?_)
    have hsq : ‖Ψ w‖ ^ 2 = ‖w‖ ^ 2 := by
      rw [hΨapp, hnormE3, hA0, hA1, hA2, hgram, hnormE2, hRi0, hRi1]
      linear_combination ((s * si + 1) * (w 0 - B * ti * w 1) ^ 2 +
          2 * (w 0 - B * ti * w 1) * ti * w 1 * B) * hsi + (t * ti + 1) * w 1 ^ 2 * hti +
        (ti ^ 2 * w 1 ^ 2 * Q - si ^ 2 * (w 0 - B * ti * w 1) ^ 2) * hs2 - ti ^ 2 * w 1 ^ 2 * ht2
    exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) (by norm_num : (2 : ℕ) ≠ 0)).1 hsq
  
  have himg : ⇑A '' S = ⇑Ψ '' (⇑R '' S) := by
    rw [Set.image_image]
    exact Set.image_congr (fun z _ => (hΨR z).symm)
  have hne : ENNReal.ofReal sbgbAreaConst ≠ 0 := (ENNReal.ofReal_pos.2 hc).ne'
  have htop : ENNReal.ofReal sbgbAreaConst ≠ ⊤ := ENNReal.ofReal_ne_top
  have hμT : ∀ T : Set E2, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) T =
      (ENNReal.ofReal sbgbAreaConst)⁻¹ * MeasureTheory.volume T := by
    intro T
    rw [← hsp T, ← mul_assoc, ENNReal.inv_mul_cancel hne htop, one_mul]
  rw [himg, hΨiso.hausdorffMeasure_image (Or.inl (by norm_num)), hμT,
    MeasureTheory.Measure.addHaar_image_linearMap, hdet, abs_of_pos ht0,
    ENNReal.ofReal_mul (inv_nonneg.2 hc.le), ENNReal.ofReal_inv_of_pos hc]
  ring

theorem sbgb_local_compare (hlin : ∀ (A : E2 →L[ℝ] E3), Function.Injective A → ∀ S : Set E2,
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (A '' S) =
        ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN (⇑A) 0 k ^ 2)) *
          MeasureTheory.volume S)
    (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W)
    (hdF : ∀ x ∈ W, Function.Injective (fderiv ℝ F x))
    (x₀ : E2) (hx₀ : x₀ ∈ W) (ε : ℝ) (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ r : ℝ, 0 < r ∧ Metric.ball x₀ r ⊆ W ∧
      (∀ x ∈ Metric.ball x₀ r,
        (1 - ε) * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2) ≤
            Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ∧
          Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ≤
            (1 + ε) * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) ∧
      ∀ S : Set E2, S ⊆ Metric.ball x₀ r →
        MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S) ≤
            ENNReal.ofReal ((1 + ε) ^ 2) *
              (ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) *
                MeasureTheory.volume S) ∧
          ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) *
              MeasureTheory.volume S ≤
            ENNReal.ofReal ((1 - ε)⁻¹ ^ 2) *
              MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S) :=
by
  set A : E2 →L[ℝ] E3 := fderiv ℝ F x₀ with hAdef
  have hA : Function.Injective A := hdF x₀ hx₀
  
  have hcross : gsCrossN (⇑A) 0 = gsCrossN F x₀ := by
    have h1 : ∀ i, gsTan (⇑A) i 0 = gsTan F i x₀ := by
      intro i
      show (fderiv ℝ (⇑A) 0) (e2 i) = A (e2 i)
      rw [ContinuousLinearMap.fderiv]
    simp only [gsCrossN, h1]
  
  have hexp : ∀ x, ∑ k : Fin 3, gsCrossN F x k ^ 2 =
      (gsTan F 0 x 1 * gsTan F 1 x 2 - gsTan F 0 x 2 * gsTan F 1 x 1) ^ 2 +
      (gsTan F 0 x 2 * gsTan F 1 x 0 - gsTan F 0 x 0 * gsTan F 1 x 2) ^ 2 +
      (gsTan F 0 x 0 * gsTan F 1 x 1 - gsTan F 0 x 1 * gsTan F 1 x 0) ^ 2 := by
    intro x
    simp [Fin.sum_univ_three, gsCrossN]
  
  have hsumpos : 0 < ∑ k : Fin 3, gsCrossN F x₀ k ^ 2 := by
    rw [hexp x₀]
    have hu : gsTan F 0 x₀ = A (e2 0) := rfl
    have hv : gsTan F 1 x₀ = A (e2 1) := rfl
    rw [hu, hv]
    set u := A (e2 0) with hudef
    set v := A (e2 1) with hvdef
    by_contra hle
    push_neg at hle
    have q0 := sq_nonneg (u 1 * v 2 - u 2 * v 1)
    have q1 := sq_nonneg (u 2 * v 0 - u 0 * v 2)
    have q2 := sq_nonneg (u 0 * v 1 - u 1 * v 0)
    have c0 : u 1 * v 2 - u 2 * v 1 = 0 :=
      pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) q0)
    have c1 : u 2 * v 0 - u 0 * v 2 = 0 :=
      pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) q1)
    have c2 : u 0 * v 1 - u 1 * v 0 = 0 :=
      pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) q2)
    set a : ℝ := u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 with hadef
    set b : ℝ := u 0 * v 0 + u 1 * v 1 + u 2 * v 2 with hbdef
    have hz : A (a • e2 1 - b • e2 0) = A 0 := by
      rw [map_sub, map_smul, map_smul, map_zero, ← hudef, ← hvdef]
      ext j
      fin_cases j
      · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, PiLp.zero_apply]
        simp only [Fin.zero_eta, Fin.isValue]
        linear_combination (-(u 1)) * c2 + u 2 * c1
      · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, PiLp.zero_apply]
        simp only [Fin.mk_one, Fin.isValue]
        linear_combination u 0 * c2 - u 2 * c0
      · simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, PiLp.zero_apply]
        simp only [Fin.reduceFinMk, Fin.isValue]
        linear_combination (-(u 0)) * c1 + u 1 * c0
    have hz' := congrArg (fun w : E2 => w 1) (hA hz)
    simp at hz'
    have ha0 : a = 0 := by simpa using hz'
    rw [hadef] at ha0
    have s0 := sq_nonneg (u 0)
    have s1 := sq_nonneg (u 1)
    have s2 := sq_nonneg (u 2)
    have hu0 : u 0 = 0 := pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) s0)
    have hu1 : u 1 = 0 := pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) s1)
    have hu2 : u 2 = 0 := pow_eq_zero_iff two_ne_zero |>.mp (le_antisymm (by linarith) s2)
    have huz : A (e2 0) = A 0 := by
      rw [map_zero, ← hudef]
      ext j
      fin_cases j
      · simpa using hu0
      · simpa using hu1
      · simpa using hu2
    have he := congrArg (fun w : E2 => w 0) (hA huz)
    simp at he
  have hJ0 : 0 < Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2) := Real.sqrt_pos.mpr hsumpos
  
  have hFd : ContinuousAt (fderiv ℝ F) x₀ :=
    (hF.continuousOn_fderiv_of_isOpen hW (by simp)).continuousAt (hW.mem_nhds hx₀)
  have ht : ∀ (i : Fin 2) (j : Fin 3), ContinuousAt (fun x => gsTan F i x j) x₀ := by
    intro i j
    have h1 : ContinuousAt (fun x => fderiv ℝ F x (e2 i)) x₀ := hFd.clm_apply continuousAt_const
    exact (EuclideanSpace.proj j : E3 →L[ℝ] ℝ).continuous.continuousAt.comp h1
  have hJc : ContinuousAt (fun x => Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) x₀ := by
    have e1 : (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) = fun x =>
        (gsTan F 0 x 1 * gsTan F 1 x 2 - gsTan F 0 x 2 * gsTan F 1 x 1) ^ 2 +
        (gsTan F 0 x 2 * gsTan F 1 x 0 - gsTan F 0 x 0 * gsTan F 1 x 2) ^ 2 +
        (gsTan F 0 x 0 * gsTan F 1 x 1 - gsTan F 0 x 1 * gsTan F 1 x 0) ^ 2 := by
      funext x
      exact hexp x
    have h2 : ContinuousAt (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) x₀ := by
      rw [e1]
      exact (((((ht 0 1).mul (ht 1 2)).sub ((ht 0 2).mul (ht 1 1))).pow 2).add
        ((((ht 0 2).mul (ht 1 0)).sub ((ht 0 0).mul (ht 1 2))).pow 2)).add
        ((((ht 0 0).mul (ht 1 1)).sub ((ht 0 1).mul (ht 1 0))).pow 2)
    exact Real.continuous_sqrt.continuousAt.comp h2
  
  obtain ⟨K, hKpos, hK⟩ :=
    LinearMap.exists_antilipschitzWith (A : E2 →ₗ[ℝ] E3) (LinearMap.ker_eq_bot.mpr hA)
  have hKr : (0 : ℝ) < K := hKpos
  have hcoer : ∀ h : E2, ‖h‖ ≤ K * ‖A h‖ := by
    intro h
    have := hK.le_mul_dist h 0
    simpa [dist_zero_right] using this
  
  obtain ⟨r₁, hr₁, hr₁W⟩ := Metric.isOpen_iff.mp hW x₀ hx₀
  obtain ⟨r₂, hr₂, hr₂d⟩ := Metric.continuousAt_iff.mp hFd (ε / K) (by positivity)
  obtain ⟨r₃, hr₃, hr₃J⟩ := Metric.continuousAt_iff.mp hJc
    (ε * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) (by positivity)
  set r := min r₁ (min r₂ r₃) with hrdef
  have hr : 0 < r := lt_min hr₁ (lt_min hr₂ hr₃)
  have hrr₁ : r ≤ r₁ := min_le_left _ _
  have hrr₂ : r ≤ r₂ := le_trans (min_le_right _ _) (min_le_left _ _)
  have hrr₃ : r ≤ r₃ := le_trans (min_le_right _ _) (min_le_right _ _)
  have hballW : Metric.ball x₀ r ⊆ W :=
    (Metric.ball_subset_ball hrr₁).trans hr₁W
  
  have hE : ∀ x ∈ Metric.ball x₀ r, ∀ y ∈ Metric.ball x₀ r,
      (1 - ε) * ‖A (x - y)‖ ≤ ‖F x - F y‖ ∧ ‖F x - F y‖ ≤ (1 + ε) * ‖A (x - y)‖ := by
    intro x hx y hy
    have hdiff : ∀ z ∈ Metric.ball x₀ r, DifferentiableAt ℝ (fun w => F w - A w) z := by
      intro z hz
      have hFz : DifferentiableAt ℝ F z :=
        (hF.contDiffAt (hW.mem_nhds (hballW hz))).differentiableAt (by simp)
      exact hFz.sub A.differentiableAt
    have hbound : ∀ z ∈ Metric.ball x₀ r, ‖fderiv ℝ (fun w => F w - A w) z‖ ≤ ε / K := by
      intro z hz
      have hFz : DifferentiableAt ℝ F z :=
        (hF.contDiffAt (hW.mem_nhds (hballW hz))).differentiableAt (by simp)
      have hd : HasFDerivAt (fun w => F w - A w) (fderiv ℝ F z - A) z :=
        hFz.hasFDerivAt.sub A.hasFDerivAt
      rw [hd.fderiv]
      have hzd : dist z x₀ < r₂ := lt_of_lt_of_le (Metric.mem_ball.mp hz) hrr₂
      have := hr₂d hzd
      rw [dist_eq_norm] at this
      exact this.le
    have hmvt := (convex_ball x₀ r).norm_image_sub_le_of_norm_fderiv_le hdiff hbound hy hx
    have hrw : (F x - A x) - (F y - A y) = (F x - F y) - A (x - y) := by
      rw [map_sub]; abel
    rw [hrw] at hmvt
    have hc := hcoer (x - y)
    have hD : ‖(F x - F y) - A (x - y)‖ ≤ ε * ‖A (x - y)‖ := by
      calc ‖(F x - F y) - A (x - y)‖ ≤ ε / K * ‖x - y‖ := hmvt
        _ ≤ ε / K * (K * ‖A (x - y)‖) := by gcongr
        _ = ε * ‖A (x - y)‖ := by field_simp
    have t1 : ‖F x - F y‖ ≤ ‖A (x - y)‖ + ‖(F x - F y) - A (x - y)‖ := by
      have := norm_add_le (A (x - y)) ((F x - F y) - A (x - y))
      simpa using this
    have t2 : ‖A (x - y)‖ ≤ ‖F x - F y‖ + ‖(F x - F y) - A (x - y)‖ := by
      have := norm_sub_le (F x - F y) ((F x - F y) - A (x - y))
      simpa using this
    constructor <;> nlinarith
  
  have hcoef : ∀ t : ℝ, 0 ≤ t →
      ((Real.toNNReal t : NNReal) : ENNReal) ^ (2 : ℝ) = ENNReal.ofReal (t ^ 2) := by
    intro t ht
    show ENNReal.ofReal t ^ (2 : ℝ) = ENNReal.ofReal (t ^ 2)
    rw [ENNReal.ofReal_rpow_of_nonneg ht (by norm_num), Real.rpow_two]
  refine ⟨r, hr, hballW, ?_, ?_⟩
  · intro x hx
    have hxd : dist x x₀ < r₃ := lt_of_lt_of_le (Metric.mem_ball.mp hx) hrr₃
    have h := hr₃J hxd
    rw [Real.dist_eq, abs_sub_lt_iff] at h
    obtain ⟨h1, h2⟩ := h
    constructor <;> nlinarith
  · intro S hS
    have hES : ∀ x ∈ S, ∀ y ∈ S,
        (1 - ε) * ‖A (x - y)‖ ≤ ‖F x - F y‖ ∧ ‖F x - F y‖ ≤ (1 + ε) * ‖A (x - y)‖ :=
      fun x hx y hy => hE x (hS hx) y (hS hy)
    have hL := hlin A hA S
    rw [hcross] at hL
    have h1e : (0 : ℝ) < 1 - ε := by linarith
    
    have hup : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S) ≤
        ENNReal.ofReal ((1 + ε) ^ 2) * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (A '' S) := by
      have hGlip : LipschitzOnWith (Real.toNNReal (1 + ε)) (F ∘ Function.invFun A) (A '' S) := by
        apply LipschitzOnWith.of_dist_le'
        rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
        simp only [Function.comp, Function.leftInverse_invFun hA x,
          Function.leftInverse_invFun hA y, dist_eq_norm]
        rw [← map_sub]
        exact (hES x hx y hy).2
      have himg : (F ∘ Function.invFun A) '' (A '' S) = F '' S := by
        rw [Set.image_image]
        apply Set.image_congr
        intro x _
        simp only [Function.comp, Function.leftInverse_invFun hA x]
      have := hGlip.hausdorffMeasure_image_le (by norm_num : (0 : ℝ) ≤ 2)
      rw [himg, hcoef _ (by linarith)] at this
      exact this
    
    have hinj : Set.InjOn F S := by
      intro x hx y hy hxy
      have h := (hES x hx y hy).1
      rw [hxy, sub_self, norm_zero] at h
      have hn : ‖A (x - y)‖ = 0 := by
        have := norm_nonneg (A (x - y))
        nlinarith
      have h0 : A (x - y) = A 0 := by rw [map_zero]; exact norm_eq_zero.mp hn
      exact sub_eq_zero.mp (hA h0)
    have hlow : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (A '' S) ≤
        ENNReal.ofReal ((1 - ε)⁻¹ ^ 2) * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S) := by
      have hli := hinj.leftInvOn_invFunOn
      have hHlip : LipschitzOnWith (Real.toNNReal (1 - ε)⁻¹) (⇑A ∘ Function.invFunOn F S)
          (F '' S) := by
        apply LipschitzOnWith.of_dist_le'
        rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
        simp only [Function.comp, hli hx, hli hy, dist_eq_norm]
        rw [← map_sub, le_inv_mul_iff₀ h1e]
        exact (hES x hx y hy).1
      have himg : (⇑A ∘ Function.invFunOn F S) '' (F '' S) = A '' S := by
        rw [Set.image_image]
        apply Set.image_congr
        intro x hx
        simp only [Function.comp, hli hx]
      have := hHlip.hausdorffMeasure_image_le (by norm_num : (0 : ℝ) ≤ 2)
      rw [himg, hcoef _ (by positivity)] at this
      exact this
    rw [← hL]
    exact ⟨hup, hlow⟩

theorem sbgb_measure_form (hc : 0 < sbgbAreaConst) (F : E2 → E3) (W : Set E2) (hW : IsOpen W)
    (hinj : Set.InjOn F W) (hFc : ContinuousOn F W)
    (hloc : ∀ x₀ ∈ W, ∀ ε : ℝ, 0 < ε → ε < 1 →
      ∃ r : ℝ, 0 < r ∧ Metric.ball x₀ r ⊆ W ∧
        (∀ x ∈ Metric.ball x₀ r,
          (1 - ε) * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2) ≤
              Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ∧
            Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ≤
              (1 + ε) * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) ∧
        ∀ S : Set E2, S ⊆ Metric.ball x₀ r →
          MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S) ≤
              ENNReal.ofReal ((1 + ε) ^ 2) *
                (ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) *
                  MeasureTheory.volume S) ∧
            ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x₀ k ^ 2)) *
                MeasureTheory.volume S ≤
              ENNReal.ofReal ((1 - ε)⁻¹ ^ 2) *
                MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' S))
    (T : Set E2) (hT : MeasurableSet T) (hTW : T ⊆ W) :
    MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' T) =
      ∫⁻ x in T, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) :=
by
  classical
  rcases Set.eq_empty_or_nonempty W with hWe | hWne
  · have hTe : T = ∅ := Set.subset_empty_iff.mp (hWe ▸ hTW)
    subst hTe
    simp
  
  have squeeze : ∀ a b : ENNReal, (∀ ε : ℝ, 0 < ε → ε < 1 →
      a ≤ ENNReal.ofReal ((1 + ε) ^ 2 * (1 - ε)⁻¹) * b ∧
      b ≤ ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹ ^ 2) * a) → a = b := by
    intro a b h
    have key : ∀ (k : ℝ → ℝ) (x y : ENNReal), ContinuousAt k 0 → k 0 = 1 →
        (∀ ε : ℝ, 0 < ε → ε < 1 → x ≤ ENNReal.ofReal (k ε) * y) → x ≤ y := by
      intro k x y hk hk0 hxy
      have h1 : Filter.Tendsto k (nhdsWithin 0 (Set.Ioi 0)) (nhds 1) := by
        have := hk.tendsto
        rw [hk0] at this
        exact this.mono_left nhdsWithin_le_nhds
      have h2 : Filter.Tendsto (fun ε => ENNReal.ofReal (k ε)) (nhdsWithin 0 (Set.Ioi 0))
          (nhds 1) := by
        have := ENNReal.tendsto_ofReal h1
        rwa [ENNReal.ofReal_one] at this
      have h3 : Filter.Tendsto (fun ε => ENNReal.ofReal (k ε) * y) (nhdsWithin 0 (Set.Ioi 0))
          (nhds (1 * y)) :=
        ENNReal.Tendsto.mul_const h2 (Or.inl one_ne_zero)
      rw [one_mul] at h3
      have hev : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), x ≤ ENNReal.ofReal (k ε) * y := by
        filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε
        exact hxy ε hε.1 hε.2
      exact ge_of_tendsto h3 hev
    refine le_antisymm ?_ ?_
    · refine key (fun ε => (1 + ε) ^ 2 * (1 - ε)⁻¹) a b ?_ (by norm_num)
        (fun ε h0 h1 => (h ε h0 h1).1)
      exact ((continuous_const.add continuous_id).pow 2).continuousAt.mul
        ((continuous_const.sub continuous_id).continuousAt.inv₀ (by norm_num))
    · refine key (fun ε => (1 + ε) * (1 - ε)⁻¹ ^ 2) b a ?_ (by norm_num)
        (fun ε h0 h1 => (h ε h0 h1).2)
      exact (continuous_const.add continuous_id).continuousAt.mul
        (((continuous_const.sub continuous_id).continuousAt.inv₀ (by norm_num)).pow 2)
  
  have piece : ∀ (ε : ℝ), 0 < ε → ε < 1 → ∀ (J0 : ℝ) (S : Set E2), MeasurableSet S →
      (∀ x ∈ S, (1 - ε) * J0 ≤ Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ∧
        Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) ≤ (1 + ε) * J0) →
      ∀ m : ENNReal,
      m ≤ ENNReal.ofReal ((1 + ε) ^ 2) *
        (ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S) →
      ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S ≤
        ENNReal.ofReal ((1 - ε)⁻¹ ^ 2) * m →
      m ≤ ENNReal.ofReal ((1 + ε) ^ 2 * (1 - ε)⁻¹) *
          ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) ∧
        ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) ≤
          ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹ ^ 2) * m := by
    intro ε hε hε1 J0 S hS hJ m hup hlo
    have hci : 0 ≤ sbgbAreaConst⁻¹ := inv_nonneg.mpr hc.le
    have h1e : 0 ≤ 1 + ε := by linarith
    have h1me : 0 < 1 - ε := by linarith
    have hne : 1 - ε ≠ 0 := h1me.ne'
    have hinv : 0 ≤ (1 - ε)⁻¹ := inv_nonneg.mpr h1me.le
    have hpu : ∀ x ∈ S, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
        ≤ ENNReal.ofReal (1 + ε) * ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) := by
      intro x hx
      rw [← ENNReal.ofReal_mul h1e]
      apply ENNReal.ofReal_le_ofReal
      have h2 := mul_le_mul_of_nonneg_left (hJ x hx).2 hci
      exact le_of_le_of_eq h2 (by ring)
    have hpl : ∀ x ∈ S, ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) ≤ ENNReal.ofReal ((1 - ε)⁻¹) *
        ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) := by
      intro x hx
      rw [← ENNReal.ofReal_mul hinv]
      apply ENNReal.ofReal_le_ofReal
      have h2 := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hJ x hx).1 hci) hinv
      refine le_of_eq_of_le ?_ h2
      rw [show (1 - ε)⁻¹ * (sbgbAreaConst⁻¹ * ((1 - ε) * J0)) =
          ((1 - ε)⁻¹ * (1 - ε)) * (sbgbAreaConst⁻¹ * J0) by ring, inv_mul_cancel₀ hne, one_mul]
    have hI_le : ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
        ≤ ENNReal.ofReal (1 + ε) * ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S := by
      calc _ ≤ ∫⁻ x in S, ENNReal.ofReal (1 + ε) * ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) :=
            MeasureTheory.setLIntegral_mono' hS hpu
        _ = _ := MeasureTheory.setLIntegral_const _ _
    have hV_le : ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S ≤
        ENNReal.ofReal ((1 - ε)⁻¹) *
          ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) := by
      calc _ = ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) :=
            (MeasureTheory.setLIntegral_const _ _).symm
        _ ≤ ∫⁻ x in S, ENNReal.ofReal ((1 - ε)⁻¹) *
            ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) :=
            MeasureTheory.setLIntegral_mono' hS hpl
        _ = _ := MeasureTheory.lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    constructor
    · calc m ≤ ENNReal.ofReal ((1 + ε) ^ 2) *
            (ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S) := hup
        _ ≤ ENNReal.ofReal ((1 + ε) ^ 2) * (ENNReal.ofReal ((1 - ε)⁻¹) *
            ∫⁻ x in S, ENNReal.ofReal (sbgbAreaConst⁻¹ *
              Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))) := by gcongr
        _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    · calc _ ≤ ENNReal.ofReal (1 + ε) *
            (ENNReal.ofReal (sbgbAreaConst⁻¹ * J0) * MeasureTheory.volume S) := by
            rw [← mul_assoc]; exact hI_le
        _ ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal ((1 - ε)⁻¹ ^ 2) * m) := by gcongr
        _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul h1e]
  
  apply squeeze
  intro ε hε hε1
  choose! r hr0 hrW hrJ hrS using fun x hx => hloc x hx ε hε hε1
  obtain ⟨Tc, hTcW, hTcc, hTcU⟩ := TopologicalSpace.isOpen_biUnion_countable W
    (fun x => Metric.ball x (r x)) (fun x _ => Metric.isOpen_ball)
  have hWsub : W ⊆ ⋃ x ∈ W, Metric.ball x (r x) := fun x hx =>
    Set.mem_iUnion₂.mpr ⟨x, hx, Metric.mem_ball_self (hr0 x hx)⟩
  have hTcne : Tc.Nonempty := by
    obtain ⟨w, hw⟩ := hWne
    have hw' := hWsub hw
    rw [← hTcU] at hw'
    obtain ⟨x, hx, _⟩ := Set.mem_iUnion₂.mp hw'
    exact ⟨x, hx⟩
  obtain ⟨c, rfl⟩ := hTcc.exists_eq_range hTcne
  have hcW : ∀ n, c n ∈ W := fun n => hTcW ⟨n, rfl⟩
  set B : ℕ → Set E2 := fun n => Metric.ball (c n) (r (c n)) with hB
  set P := disjointed B with hP
  have hPm : ∀ n, MeasurableSet (P n) :=
    MeasurableSet.disjointed (fun n => measurableSet_ball)
  have hPd : Pairwise (Function.onFun Disjoint P) := disjoint_disjointed B
  have hPB : ∀ n, P n ⊆ B n := disjointed_subset B
  have hcov : W ⊆ ⋃ n, P n := by
    rw [hP, iUnion_disjointed]
    intro x hx
    have hx' := hWsub hx
    rw [← hTcU, Set.biUnion_range] at hx'
    exact hx'
  set Tn : ℕ → Set E2 := fun n => T ∩ P n with hTn
  have hTnm : ∀ n, MeasurableSet (Tn n) := fun n => hT.inter (hPm n)
  have hTnd : Pairwise (Function.onFun Disjoint Tn) := fun i j hij =>
    (hPd hij).mono Set.inter_subset_right Set.inter_subset_right
  have hTnW : ∀ n, Tn n ⊆ W := fun n => Set.inter_subset_left.trans hTW
  have hTnB : ∀ n, Tn n ⊆ Metric.ball (c n) (r (c n)) := fun n =>
    Set.inter_subset_right.trans (hPB n)
  have hTU : T = ⋃ n, Tn n := by
    ext x
    constructor
    · intro hx
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp (hcov (hTW hx))
      exact Set.mem_iUnion.mpr ⟨n, hx, hn⟩
    · intro hx
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hx
      exact hn.1
  have hA : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' T) =
      ∑' n, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' Tn n) := by
    have hA' : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' ⋃ n, Tn n) =
        ∑' n, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' Tn n) := by
      rw [Set.image_iUnion]
      refine MeasureTheory.measure_iUnion ?_ ?_
      · intro i j hij
        rw [Function.onFun, Set.disjoint_left]
        rintro y ⟨p, hp, rfl⟩ ⟨q, hq, hpq⟩
        have hqp := hinj (hTnW j hq) (hTnW i hp) hpq
        subst hqp
        exact Set.disjoint_left.mp (hTnd hij) hp hq
      · intro n
        exact (hTnm n).image_of_continuousOn_injOn (hFc.mono (hTnW n)) (hinj.mono (hTnW n))
    rw [← hTU] at hA'
    exact hA'
  have hB2 : ∫⁻ x in T, ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) =
      ∑' n, ∫⁻ x in Tn n,
        ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) := by
    have h := MeasureTheory.lintegral_iUnion (μ := MeasureTheory.volume) hTnm hTnd
      (fun x => ENNReal.ofReal (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)))
    rw [← hTU] at h
    exact h
  have hpc := fun n => piece ε hε hε1 (Real.sqrt (∑ k : Fin 3, gsCrossN F (c n) k ^ 2)) (Tn n)
    (hTnm n) (fun x hx => hrJ (c n) (hcW n) x (hTnB n hx))
    (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' Tn n))
    (hrS (c n) (hcW n) (Tn n) (hTnB n)).1 (hrS (c n) (hcW n) (Tn n) (hTnB n)).2
  rw [hA, hB2]
  constructor
  · exact (ENNReal.tsum_le_tsum fun n => (hpc n).1).trans (le_of_eq ENNReal.tsum_mul_left)
  · exact (ENNReal.tsum_le_tsum fun n => (hpc n).2).trans (le_of_eq ENNReal.tsum_mul_left)

theorem sbgb_hausdorff_area_formula (F : E2 → E3) (W : Set E2) (hW : IsOpen W)
    (hF : ContDiffOn ℝ ∞ F W) (hinj : Set.InjOn F W)
    (hdF : ∀ x ∈ W, Function.Injective (fderiv ℝ F x))
    (W' : Set E2) (hW' : MeasurableSet W') (hW'W : W' ⊆ W) (h : E3 → ℝ) :
    ∫ y in F '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
      sbgbAreaConst⁻¹ * ∫ x in W', h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) :=
by
  
  have hspec := sbgb_area_const_spec
  have hc : 0 < sbgbAreaConst := hspec.1
  
  have hlin := sbgb_linear_area hspec
  have hloc := fun x₀ hx₀ ε hε hε1 =>
    sbgb_local_compare hlin F W hW hF hdF x₀ hx₀ ε hε hε1
  have hmeas : ∀ T : Set E2, MeasurableSet T → T ⊆ W →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' T) =
        ∫⁻ x in T, ENNReal.ofReal
          (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) :=
    fun T hT hTW => sbgb_measure_form hc F W hW hinj hF.continuousOn hloc T hT hTW
  
  set ρ : E2 → ℝ := fun x => sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)
    with hρdef
  have hρnn : ∀ x, 0 ≤ ρ x := fun x => mul_nonneg (inv_nonneg.mpr hc.le) (Real.sqrt_nonneg _)
  have htan : ∀ (i : Fin 2) (j : Fin 3), Measurable (fun x => gsTan F i x j) := by
    intro i j
    have h1 : Measurable (fun x => fderiv ℝ F x (e2 i)) := measurable_fderiv_apply_const ℝ F _
    exact (EuclideanSpace.proj j : E3 →L[ℝ] ℝ).continuous.measurable.comp h1
  have hρm : Measurable ρ := by
    have hsum : Measurable (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) := by
      have e1 : (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) = fun x =>
          (gsTan F 0 x 1 * gsTan F 1 x 2 - gsTan F 0 x 2 * gsTan F 1 x 1) ^ 2 +
          (gsTan F 0 x 2 * gsTan F 1 x 0 - gsTan F 0 x 0 * gsTan F 1 x 2) ^ 2 +
          (gsTan F 0 x 0 * gsTan F 1 x 1 - gsTan F 0 x 1 * gsTan F 1 x 0) ^ 2 := by
        funext x
        simp [Fin.sum_univ_three, gsCrossN]
      rw [e1]
      have a01 := htan 0 1; have a02 := htan 0 2; have a00 := htan 0 0
      have b01 := htan 1 1; have b02 := htan 1 2; have b00 := htan 1 0
      exact ((((a01.mul b02).sub (a02.mul b01)).pow_const 2).add
        (((a02.mul b00).sub (a00.mul b02)).pow_const 2)).add
        (((a00.mul b01).sub (a01.mul b00)).pow_const 2)
    exact measurable_const.mul hsum.sqrt
  have he : MeasurableEmbedding (W'.restrict F) :=
    ContinuousOn.measurableEmbedding hW' (hF.continuousOn.mono hW'W) (hinj.mono hW'W)
  set μ' : MeasureTheory.Measure W' := MeasureTheory.Measure.comap Subtype.val MeasureTheory.volume
    with hμ'
  set f : W' → NNReal := fun x => (ρ x).toNNReal with hfdef
  have hf : Measurable f := (hρm.comp measurable_subtype_coe).real_toNNReal
  have key : MeasureTheory.Measure.map (W'.restrict F) (μ'.withDensity (fun x => (f x : ENNReal))) =
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)).restrict (F '' W') := by
    ext B hB
    rw [he.map_apply, MeasureTheory.withDensity_apply _ (he.measurable hB),
      MeasureTheory.Measure.restrict_apply hB]
    have hT : Subtype.val '' ((W'.restrict F) ⁻¹' B) = W' ∩ F ⁻¹' B := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨y.2, hy⟩
      · rintro ⟨hx1, hx2⟩
        exact ⟨⟨x, hx1⟩, hx2, rfl⟩
    have hTm : MeasurableSet (W' ∩ F ⁻¹' B) := by
      rw [← hT]
      exact (MeasurableEmbedding.subtype_coe hW').measurableSet_image' (he.measurable hB)
    have h1 : ∫⁻ x in (W'.restrict F) ⁻¹' B, (f x : ENNReal) ∂μ' =
        ∫⁻ x in (W'.restrict F) ⁻¹' B, (fun y : E2 => ENNReal.ofReal (ρ y)) (x : E2) ∂μ' := rfl
    rw [h1, hμ', MeasureTheory.setLIntegral_subtype hW' _ (fun y : E2 => ENNReal.ofReal (ρ y)), hT,
      ← hmeas (W' ∩ F ⁻¹' B) hTm (Set.inter_subset_left.trans hW'W),
      Set.image_inter_preimage, Set.inter_comm]
  calc ∫ y in F '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))
      = ∫ y, h y ∂(MeasureTheory.Measure.map (W'.restrict F)
          (μ'.withDensity (fun x => (f x : ENNReal)))) := by rw [key]
    _ = ∫ x : W', h (W'.restrict F x) ∂(μ'.withDensity (fun x => (f x : ENNReal))) :=
        he.integral_map h
    _ = ∫ x : W', f x • h (W'.restrict F x) ∂μ' :=
        integral_withDensity_eq_integral_smul hf _
    _ = ∫ x : W', (fun y : E2 => ρ y * h (F y)) (x : E2) ∂μ' := by
        congr 1
        funext x
        simp only [hfdef, NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (hρnn x),
          Set.restrict_apply]
    _ = ∫ x in W', ρ x * h (F x) := by
        rw [hμ']
        exact MeasureTheory.integral_subtype_comap hW' (fun y : E2 => ρ y * h (F y))
    _ = sbgbAreaConst⁻¹ * ∫ x in W', h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) := by
        rw [← MeasureTheory.integral_const_mul]
        congr 1
        funext x
        simp only [hρdef]
        ring

theorem box_area_side (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U)
    (J : E3 → ℝ)
    (hJ : ∀ w : E3, J w = Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
        (fun j => fderiv ℝ P w (e 2) j) i) ^ 2))
    (g : ℝ → E2 → ℝ)
    (hg : ∀ (t : ℝ) (z : E2), g t z = if |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ then
        ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) *
          J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) else 0) :
    ∀ t s : ℝ, 0 < s → sbgbAreaConst *
      ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
        s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
      ∫ z in {z : E2 | 0 ≤ z 0}, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g t z :=
by
  intro t s hs
  obtain ⟨hc0, -⟩ := sbgb_area_const_spec
  
  have hco : ∀ a a' a'' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, a', a'']) 0 = a ∧
      ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, a', a'']) 1 = a' ∧
      ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, a', a'']) 2 = a'' := fun a a' a'' => by simp
  have hco2 : ∀ a a' : ℝ, ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![a, a']) 0 = a ∧
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![a, a']) 1 = a' := fun a a' => by simp
  have hcoord : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      f (P w) = w 0 ∧ b (P w) = w 1 ∧ (P w) k = w 2 := by
    intro w hw
    have h := (hPV w hw).2.2
    refine ⟨?_, ?_, ?_⟩
    · have h' := congrArg (fun x : E3 => x 0) h
      simpa using h'
    · have h' := congrArg (fun x : E3 => x 1) h
      simpa using h'
    · have h' := congrArg (fun x : E3 => x 2) h
      simpa using h'
  have hVopen : IsOpen {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    simp only [Set.setOf_and]
    exact (isOpen_lt (by fun_prop) continuous_const).inter
      ((isOpen_lt (by fun_prop) continuous_const).inter (isOpen_lt (by fun_prop) continuous_const))
  
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : E2 →L[ℝ] E3, ∀ v : E2,
      Λ v = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![0, v 0, v 1] :=
    ⟨(EuclideanSpace.equiv (Fin 3) ℝ).symm.toContinuousLinearMap.comp
      (ContinuousLinearMap.pi ![0, EuclideanSpace.proj 0, EuclideanSpace.proj 1]),
      fun v => by ext i; fin_cases i <;> simp⟩
  have hΛe : Λ (e2 0) = e 1 ∧ Λ (e2 1) = e 2 := by
    constructor
    · ext j; fin_cases j <;> simp [hΛ, EuclideanSpace.single_apply]
    · ext j; fin_cases j <;> simp [hΛ, EuclideanSpace.single_apply]
  obtain ⟨ι, hιdef⟩ : ∃ ι : E2 → E3,
      ι = fun z => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, 0] + Λ z := ⟨_, rfl⟩
  have hιeq : ∀ z : E2, ι z = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] := by
    intro z
    simp only [hιdef]
    ext i; fin_cases i <;> simp [hΛ]
  have hιcd : ContDiff ℝ ∞ ι := by
    rw [hιdef]; exact contDiff_const.add Λ.contDiff
  have hιd : ∀ z : E2, HasFDerivAt ι Λ z := by
    intro z; rw [hιdef]; exact Λ.hasFDerivAt.const_add _
  have hιc : ∀ z : E2, ι z 0 = t ∧ ι z 1 = z 0 ∧ ι z 2 = z 1 := by
    intro z; rw [hιeq z]; exact hco t (z 0) (z 1)
  obtain ⟨F, hFdef⟩ : ∃ F : E2 → E3, F = P ∘ ι := ⟨_, rfl⟩
  have hFι : ∀ z, F z = P (ι z) := by intro z; rw [hFdef]; rfl
  have hFeq : ∀ z : E2, F z = P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) := by
    intro z; rw [hFι, hιeq]
  
  obtain ⟨W, hW⟩ : ∃ W : Set E2,
      W = {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ} := ⟨_, rfl⟩
  have hmemW : ∀ z, z ∈ W ↔ (|t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ) := by
    intro z; simp only [hW, Set.mem_setOf_eq]
  obtain ⟨S, hS⟩ : ∃ S : Set E2,
      S = {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ ∧ 0 ≤ z 0} := ⟨_, rfl⟩
  have hmemS : ∀ z, z ∈ S ↔ (|t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ ∧ 0 ≤ z 0) := by
    intro z; simp only [hS, Set.mem_setOf_eq]
  have hWopen : IsOpen W := by
    rw [hW]
    simp only [Set.setOf_and]
    exact (isOpen_lt continuous_const continuous_const).inter
      ((isOpen_lt (by fun_prop) continuous_const).inter (isOpen_lt (by fun_prop) continuous_const))
  have hSmeas : MeasurableSet S := by
    rw [hS]
    simp only [Set.setOf_and]
    exact (isOpen_lt continuous_const continuous_const).measurableSet.inter
      ((isOpen_lt (by fun_prop) continuous_const).measurableSet.inter
        ((isOpen_lt (by fun_prop) continuous_const).measurableSet.inter
          (isClosed_le continuous_const (by fun_prop)).measurableSet))
  have hSW : S ⊆ W := by
    intro z hz
    obtain ⟨a1, a2, a3, -⟩ := (hmemS z).1 hz
    exact (hmemW z).2 ⟨a1, a2, a3⟩
  have hmaps : ∀ z ∈ W, ι z ∈ {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    intro z hz
    obtain ⟨a1, a2, a3⟩ := hιc z
    obtain ⟨b1, b2, b3⟩ := (hmemW z).1 hz
    show |ι z 0 - τ₀| < δ ∧ |ι z 1 - β₀| < δ ∧ |ι z 2 - σ₀| < δ
    rw [a1, a2, a3]
    exact ⟨b1, b2, b3⟩
  have hcoord' : ∀ z ∈ W, f (F z) = t ∧ b (F z) = z 0 ∧ (F z) k = z 1 := by
    intro z hz
    obtain ⟨a1, a2, a3⟩ := hcoord (ι z) (hmaps z hz)
    obtain ⟨c1, c2, c3⟩ := hιc z
    rw [hFι z]
    exact ⟨a1.trans c1, a2.trans c2, a3.trans c3⟩
  have hFU : ∀ z ∈ W, F z ∈ U := by
    intro z hz
    rw [hFι z]
    exact (hPV _ (hmaps z hz)).2.1
  
  have hFcd : ContDiffOn ℝ ∞ F W := by
    rw [hFdef]
    exact hP.comp hιcd.contDiffOn (fun z hz => hmaps z hz)
  have hFinj : Set.InjOn F W := by
    intro z hz z' hz' hzz
    have a := hcoord' z hz
    have a' := hcoord' z' hz'
    have e0 : z 0 = z' 0 := by rw [← a.2.1, ← a'.2.1, hzz]
    have e1 : z 1 = z' 1 := by rw [← a.2.2, ← a'.2.2, hzz]
    ext i; fin_cases i <;> simp [e0, e1]
  have hdF : ∀ z ∈ W, Function.Injective (fderiv ℝ F z) := by
    intro z hz
    have hFd : DifferentiableAt ℝ F z :=
      (hFcd.contDiffAt (hWopen.mem_nhds hz)).differentiableAt (by simp)
    have hbd : DifferentiableAt ℝ b (F z) :=
      (hb.contDiffAt (hO.mem_nhds (hUO (hFU z hz)))).differentiableAt (by simp)
    have hev0 : (b ∘ F) =ᶠ[𝓝 z] (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ) := by
      filter_upwards [hWopen.mem_nhds hz] with z' hz'
      rw [Function.comp_apply, (hcoord' z' hz').2.1]
      simp
    have hev1 : ((EuclideanSpace.proj k : E3 →L[ℝ] ℝ) ∘ F) =ᶠ[𝓝 z]
        (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ) := by
      filter_upwards [hWopen.mem_nhds hz] with z' hz'
      rw [Function.comp_apply]
      simp [(hcoord' z' hz').2.2]
    have hd0 : (fderiv ℝ b (F z)).comp (fderiv ℝ F z) =
        (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ) := by
      rw [← fderiv_comp z hbd hFd, hev0.fderiv_eq (𝕜 := ℝ), ContinuousLinearMap.fderiv]
    have hd1 : (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).comp (fderiv ℝ F z) =
        (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ) := by
      have h := fderiv_comp z (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).differentiableAt hFd
      rw [hev1.fderiv_eq (𝕜 := ℝ)] at h
      simp only [ContinuousLinearMap.fderiv] at h
      exact h.symm
    rw [injective_iff_map_eq_zero]
    intro v hv
    have e0 : v 0 = 0 := by
      have h := congrArg (fun L : E2 →L[ℝ] ℝ => L v) hd0
      simp only [ContinuousLinearMap.comp_apply, hv, map_zero] at h
      simpa using h.symm
    have e1 : v 1 = 0 := by
      have h := congrArg (fun L : E2 →L[ℝ] ℝ => L v) hd1
      simp only [ContinuousLinearMap.comp_apply, hv, map_zero] at h
      simpa using h.symm
    ext i; fin_cases i <;> simp [e0, e1]
  
  have hcross : ∀ z ∈ W, Real.sqrt (∑ k : Fin 3, gsCrossN F z k ^ 2) =
      J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) := by
    intro z hz
    have hPd : DifferentiableAt ℝ P (ι z) :=
      (hP.contDiffAt (hVopen.mem_nhds (hmaps z hz))).differentiableAt (by simp)
    have hFd : fderiv ℝ F z = (fderiv ℝ P (ι z)).comp Λ := by
      rw [hFdef]; exact (hPd.hasFDerivAt.comp z (hιd z)).fderiv
    have h1 : fderiv ℝ F z (e2 0) = fderiv ℝ P (ι z) (e 1) := by
      rw [hFd, ContinuousLinearMap.comp_apply, hΛe.1]
    have h2 : fderiv ℝ F z (e2 1) = fderiv ℝ P (ι z) (e 2) := by
      rw [hFd, ContinuousLinearMap.comp_apply, hΛe.2]
    rw [hJ, ← hιeq z]
    simp only [gsCrossN, gsTan, h1, h2, cross_apply]
  
  have hslice : {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U = F '' S := by
    ext y
    constructor
    · rintro ⟨⟨hyO, hft, hb0⟩, hyU⟩
      obtain ⟨⟨h1, h2, h3⟩, hPy⟩ := hPU y hyU
      obtain ⟨hz0, hz1⟩ := hco2 (b y) (y k)
      refine ⟨(EuclideanSpace.equiv (Fin 2) ℝ).symm ![b y, y k], ?_, ?_⟩
      · refine (hmemS _).2 ⟨?_, ?_, ?_, ?_⟩
        · rw [← hft]; exact h1
        · rw [hz0]; exact h2
        · rw [hz1]; exact h3
        · rw [hz0]; exact hb0
      · rw [hFeq, hz0, hz1, ← hft]
        exact hPy
    · rintro ⟨z, hz, rfl⟩
      have hz' := (hmemS z).1 hz
      have hzW : z ∈ W := hSW hz
      have hc := hcoord' z hzW
      refine ⟨⟨hUO (hFU z hzW), hc.1, ?_⟩, hFU z hzW⟩
      rw [hc.2.1]; exact hz'.2.2.2
  
  have hDmeas : MeasurableSet {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} := by
    have h1 : IsOpen (O ∩ f ⁻¹' {t}ᶜ) :=
      hf.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have h2 : IsOpen (O ∩ b ⁻¹' Set.Iio 0) :=
      hb.continuousOn.isOpen_inter_preimage hO isOpen_Iio
    have heq : {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} =
        O \ ((O ∩ f ⁻¹' {t}ᶜ) ∪ (O ∩ b ⁻¹' Set.Iio 0)) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_union, Set.mem_inter_iff,
        Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_Iio]
      constructor
      · rintro ⟨hyO, hft, hb0⟩
        refine ⟨hyO, ?_⟩
        rintro (⟨_, h⟩ | ⟨_, h⟩)
        · exact h hft
        · exact absurd h (not_lt.mpr hb0)
      · rintro ⟨hyO, hn⟩
        refine ⟨hyO, ?_, ?_⟩
        · by_contra h; exact hn (Or.inl ⟨hyO, h⟩)
        · by_contra h; exact hn (Or.inr ⟨hyO, lt_of_not_ge h⟩)
    rw [heq]
    exact hO.measurableSet.diff (h1.union h2).measurableSet
  
  have hzero1 : ∀ y ∈ {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} \
      ({y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U),
      s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y = 0 := by
    rintro y ⟨hyD, hyn⟩
    have hyU : y ∉ U := fun h => hyn ⟨hyD, h⟩
    have hψ0 : ψ y = 0 := image_eq_zero_of_notMem_tsupport (fun h => hyU (hψU h))
    rw [hψ0, mul_zero]
  
  have hB := sbgb_hausdorff_area_formula F W hWopen hFcd hFinj hdF S hSmeas hSW
    (fun y => s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y)
  
  have hC : ∫ x in S, s⁻¹ * deriv Real.smoothTransition (b (F x) / s) * ψ (F x) *
        Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
      ∫ z in S, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g t z := by
    refine setIntegral_congr_fun hSmeas (fun z hz => ?_)
    have hz' := (hmemS z).1 hz
    have hzW : z ∈ W := hSW hz
    have hgz : g t z = ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) *
        J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) := by
      rw [hg, if_pos ⟨hz'.1, hz'.2.1, hz'.2.2.1⟩]
    dsimp only
    rw [(hcoord' z hzW).2.1, hcross z hzW, hgz, hFeq z]
    ring
  
  have hHmeas : MeasurableSet {z : E2 | 0 ≤ z 0} :=
    (isClosed_le (f := fun _ : E2 => (0 : ℝ)) (g := fun z : E2 => z 0) continuous_const
      (by fun_prop)).measurableSet
  have hSH : S ⊆ {z : E2 | 0 ≤ z 0} := fun z hz => ((hmemS z).1 hz).2.2.2
  have hzero2 : ∀ z ∈ {z : E2 | 0 ≤ z 0} \ S,
      s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g t z = 0 := by
    rintro z ⟨hzH, hzS⟩
    have hgz : g t z = 0 := by
      rw [hg, if_neg]
      rintro ⟨a1, a2, a3⟩
      exact hzS ((hmemS z).2 ⟨a1, a2, a3, hzH⟩)
    rw [hgz, mul_zero]
  have hD : ∫ z in {z : E2 | 0 ≤ z 0}, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g t z =
      ∫ z in S, s⁻¹ * deriv Real.smoothTransition (z 0 / s) * g t z :=
    setIntegral_eq_of_subset_of_forall_diff_eq_zero hHmeas hSH hzero2
  rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero hDmeas Set.inter_subset_left hzero1, hslice,
    hB, mul_inv_cancel_left₀ hc0.ne', hD]
  exact hC

theorem box_collar_integrable (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O)
    (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U) :
    ∀ t s : ℝ, 0 < s → MeasureTheory.IntegrableOn
      (fun y => s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y)
      {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) :=
by
  intro t s _hs
  
  have hc0 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 0 = a :=
    fun _ _ _ => rfl
  have hc1 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 1 = b' :=
    fun _ _ _ => rfl
  have hc2 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 2 = c' :=
    fun _ _ _ => rfl
  obtain ⟨L, hL⟩ : ∃ L : E2 → E3, ∀ z : E2,
      L z = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] := ⟨_, fun _ => rfl⟩
  
  have hVo : IsOpen {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    have h0 : IsOpen {w : E3 | |w 0 - τ₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    have h1 : IsOpen {w : E3 | |w 1 - β₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    have h2 : IsOpen {w : E3 | |w 2 - σ₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    exact h0.inter (h1.inter h2)
  
  have hcoord : ∀ (x y : E3) (a b' : ℝ), 0 ≤ a → 0 ≤ b' → a + b' = 1 → ∀ (i : Fin 3) (c' : ℝ),
      |x i - c'| < δ → |y i - c'| < δ → |(a • x + b' • y) i - c'| < δ := by
    intro x y a b' ha hb hab i c' h1 h2
    have e : (a • x + b' • y) i - c' = a * (x i - c') + b' * (y i - c') := by
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      linear_combination c' * hab
    rw [e]
    calc |a * (x i - c') + b' * (y i - c')|
        ≤ |a * (x i - c')| + |b' * (y i - c')| := abs_add_le _ _
      _ = a * |x i - c'| + b' * |y i - c'| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ ≤ a * max |x i - c'| |y i - c'| + b' * max |x i - c'| |y i - c'| :=
          add_le_add (mul_le_mul_of_nonneg_left (le_max_left _ _) ha)
            (mul_le_mul_of_nonneg_left (le_max_right _ _) hb)
      _ = max |x i - c'| |y i - c'| := by rw [← add_mul, hab, one_mul]
      _ < δ := max_lt h1 h2
  have hVc : Convex ℝ {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    intro x hx y hy a b' ha hb hab
    obtain ⟨hx0, hx1, hx2⟩ := hx
    obtain ⟨hy0, hy1, hy2⟩ := hy
    exact ⟨hcoord x y a b' ha hb hab 0 τ₀ hx0 hy0, hcoord x y a b' ha hb hab 1 β₀ hx1 hy1,
      hcoord x y a b' ha hb hab 2 σ₀ hx2 hy2⟩
  
  have hPlip : LipschitzOnWith (Real.toNNReal Lp) P
      {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ) (fun w hw => ?_)
      (fun w hw => ?_) hVc
    · exact (hP.contDiffAt (hVo.mem_nhds hw)).differentiableAt (by simp)
    · rw [← norm_toNNReal]
      exact Real.toNNReal_le_toNNReal (hPV w hw).1
  
  have hLiso : Isometry L := by
    refine Isometry.of_dist_eq (fun z z' => ?_)
    rw [EuclideanSpace.dist_eq, EuclideanSpace.dist_eq, Fin.sum_univ_three, Fin.sum_univ_two]
    simp only [hL, hc0, hc1, hc2, dist_self]
    norm_num
  
  have hmaps : Set.MapsTo L {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ}
      {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    intro z hz
    obtain ⟨h1, h2, h3⟩ := hz
    show |L z 0 - τ₀| < δ ∧ |L z 1 - β₀| < δ ∧ |L z 2 - σ₀| < δ
    rw [hL, hc0, hc1, hc2]
    exact ⟨h1, h2, h3⟩
  
  have hFlip : LipschitzOnWith (Real.toNNReal Lp * 1) (P ∘ L)
      {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ} :=
    hPlip.comp hLiso.lipschitz.lipschitzOnWith hmaps
  
  have hWb : Bornology.IsBounded {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ} := by
    rw [isBounded_iff_forall_norm_le]
    refine ⟨|β₀| + |σ₀| + 2 * δ, fun z hz => ?_⟩
    obtain ⟨_, h1, h2⟩ := hz
    have e1 : |z 0| ≤ |β₀| + δ := by
      have := abs_sub_abs_le_abs_sub (z 0) β₀
      linarith
    have e2 : |z 1| ≤ |σ₀| + δ := by
      have := abs_sub_abs_le_abs_sub (z 1) σ₀
      linarith
    have hn : ‖z‖ ≤ |z 0| + |z 1| := by
      rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
      simp only [Real.norm_eq_abs, sq_abs]
      have hsq : (z 0) ^ 2 + (z 1) ^ 2 ≤ (|z 0| + |z 1|) ^ 2 := by
        nlinarith [abs_nonneg (z 0), abs_nonneg (z 1), sq_abs (z 0), sq_abs (z 1)]
      have h3 := Real.sqrt_le_sqrt hsq
      rw [Real.sqrt_sq (by positivity)] at h3
      exact h3
    linarith
  
  have hfinE2 : ∀ S : Set E2, Bornology.IsBounded S →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) S < ⊤ := by
    intro S hS
    have hS' : Bornology.IsBounded ((EuclideanSpace.equiv (Fin 2) ℝ) '' S) :=
      (EuclideanSpace.equiv (Fin 2) ℝ).toContinuousLinearMap.lipschitz.isBounded_image hS
    have hvol : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
        ((EuclideanSpace.equiv (Fin 2) ℝ) '' S) < ⊤ := by
      have h := MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2)
      simp only [Fintype.card_fin, Nat.cast_ofNat] at h
      rw [h]
      exact hS'.measure_lt_top
    have heq : S = (EuclideanSpace.equiv (Fin 2) ℝ).symm ''
        ((EuclideanSpace.equiv (Fin 2) ℝ) '' S) := by
      rw [Set.image_image]; simp
    rw [heq]
    exact lt_of_le_of_lt
      (((EuclideanSpace.equiv (Fin 2) ℝ).symm.toContinuousLinearMap.lipschitz.lipschitzOnWith
        (s := (EuclideanSpace.equiv (Fin 2) ℝ) '' S)).hausdorffMeasure_image_le (by norm_num))
      (ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.coe_ne_top) hvol)
  have hWfin : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
      {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ} < ⊤ := hfinE2 _ hWb
  have himg : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
      ((P ∘ L) '' {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ}) < ⊤ :=
    lt_of_le_of_lt (hFlip.hausdorffMeasure_image_le (by norm_num))
      (ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.coe_ne_top) hWfin)
  
  have hsub : {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U ⊆
      (P ∘ L) '' {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ} := by
    rintro y ⟨⟨_, hft, _⟩, hyU⟩
    obtain ⟨⟨h1, h2, h3⟩, hPy⟩ := hPU y hyU
    refine ⟨(EuclideanSpace.equiv (Fin 2) ℝ).symm ![b y, y k], ⟨?_, ?_, ?_⟩, ?_⟩
    · rw [← hft]; exact h1
    · exact h2
    · exact h3
    · show P (L _) = y
      rw [hL, ← hft]
      exact hPy
  
  have hDm : MeasurableSet {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} := by
    have h1 : IsOpen (O ∩ f ⁻¹' {t}ᶜ) :=
      hf.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have h2 : IsOpen (O ∩ b ⁻¹' Set.Iio 0) :=
      hb.continuousOn.isOpen_inter_preimage hO isOpen_Iio
    have heq : {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} =
        O \ ((O ∩ f ⁻¹' {t}ᶜ) ∪ (O ∩ b ⁻¹' Set.Iio 0)) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_union, Set.mem_inter_iff,
        Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_Iio, not_or,
        not_and, not_not, not_lt]
      tauto
    rw [heq]
    exact hO.measurableSet.diff (h1.union h2).measurableSet
  
  have hη : Continuous (deriv Real.smoothTransition) :=
    ContDiff.continuous_deriv (Real.smoothTransition.contDiff (n := 1)) le_rfl
  have hφc : ContinuousOn (fun y => s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y) O :=
    (continuousOn_const.mul (hη.comp_continuousOn (hb.continuousOn.div_const s))).mul
      hψ.continuousOn
  obtain ⟨B, hB⟩ := hψc.exists_bound_of_continuousOn (hφc.mono (hψU.trans hUO))
  have hbound : ∀ y, ‖s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y‖ ≤ max B 0 := by
    intro y
    by_cases hy : y ∈ tsupport ψ
    · exact (hB y hy).trans (le_max_left _ _)
    · rw [image_eq_zero_of_notMem_tsupport hy, mul_zero, norm_zero]
      exact le_max_right _ _
  have hDU : MeasurableSet ({y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U) :=
    hDm.inter hU.measurableSet
  have hμ : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
      ({y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U) < ⊤ :=
    lt_of_le_of_lt (MeasureTheory.measure_mono hsub) himg
  have hint : MeasureTheory.IntegrableOn
      (fun y => s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y)
      ({y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U)
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) :=
    MeasureTheory.IntegrableOn.of_bound hμ
      ((hφc.mono (fun y hy => hy.1.1)).aestronglyMeasurable hDU) (max B 0)
      (MeasureTheory.ae_of_all _ hbound)
  refine hint.of_forall_diff_eq_zero hDm (fun y hy => ?_)
  have hyU : y ∉ U := fun h => hy.2 ⟨hy.1, h⟩
  have hyψ : y ∉ tsupport ψ := fun h => hyU (hψU h)
  simp [image_eq_zero_of_notMem_tsupport hyψ]

theorem box_slice_geometry (f b : E3 → ℝ) (O : Set E3) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (U : Set E3)
    (hUO : U ⊆ O) (P : E3 → E3)
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y) :
    (∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      f (P w) = w 0 ∧ b (P w) = w 1 ∧ (P w) k = w 2) ∧
    ∀ t : ℝ, {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} ∩ U =
        (fun z : E2 => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) ''
          {z : E2 | |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ ∧ 0 ≤ z 0} ∧
      {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U =
        (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) ''
          {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ} :=
by
  have hA : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      f (P w) = w 0 ∧ b (P w) = w 1 ∧ (P w) k = w 2 := by
    intro w hw
    have H := (hPV w hw).2.2
    refine ⟨?_, ?_, ?_⟩
    · have := congrArg (fun v : E3 => v 0) H
      exact this
    · have := congrArg (fun v : E3 => v 1) H
      exact this
    · have := congrArg (fun v : E3 => v 2) H
      exact this
  refine ⟨hA, fun t => ⟨?_, ?_⟩⟩
  · ext y
    constructor
    · rintro ⟨⟨_, hft, hb⟩, hyU⟩
      obtain ⟨⟨h1, h2, h3⟩, hP⟩ := hPU y hyU
      refine ⟨(EuclideanSpace.equiv (Fin 2) ℝ).symm ![b y, y k], ⟨?_, ?_, ?_, ?_⟩, ?_⟩
      · rw [← hft]; exact h1
      · exact h2
      · exact h3
      · exact hb
      · show P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, b y, y k]) = y
        rw [← hft]; exact hP
    · rintro ⟨z, ⟨ht, hz0, hz1, hnn⟩, rfl⟩
      have hw : |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] 0 - τ₀| < δ ∧
          |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] 1 - β₀| < δ ∧
          |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1] 2 - σ₀| < δ := ⟨ht, hz0, hz1⟩
      obtain ⟨-, hU, -⟩ := hPV _ hw
      obtain ⟨e1, e2, -⟩ := hA _ hw
      exact ⟨⟨hUO hU, e1, hnn.trans_eq e2.symm⟩, hU⟩
  · ext y
    constructor
    · rintro ⟨⟨_, hft, hb0⟩, hyU⟩
      obtain ⟨⟨h1, h2, h3⟩, hP⟩ := hPU y hyU
      refine ⟨y k, ⟨?_, ?_, h3⟩, ?_⟩
      · rw [← hft]; exact h1
      · rw [hb0] at h2; exact h2
      · have e : (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, y k] =
            (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k] := by rw [hft, hb0]
        show P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, y k]) = y
        rw [e]; exact hP
    · rintro ⟨x, ⟨ht, h0, hx⟩, rfl⟩
      have hw : |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x] 0 - τ₀| < δ ∧
          |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x] 1 - β₀| < δ ∧
          |(EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x] 2 - σ₀| < δ := ⟨ht, h0, hx⟩
      obtain ⟨-, hU, -⟩ := hPV _ hw
      obtain ⟨e1, e2, -⟩ := hA _ hw
      exact ⟨⟨hUO hU, e1, e2⟩, hU⟩

theorem box_chart_calculus (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (U : Set E3) (hUO : U ⊆ O)
    (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w) :
    ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      Function.Injective (fderiv ℝ P w) ∧
      0 < ∑ i : Fin 3, sbgbCross f b (P w) i ^ 2 ∧
      ‖fderiv ℝ f (P w)‖ / Real.sqrt (∑ i : Fin 3, sbgbCross f b (P w) i ^ 2) *
          ‖fderiv ℝ P w (e 2)‖ =
        Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
          (fun j => fderiv ℝ P w (e 2) j) i) ^ 2) :=
by
  intro w hw
  
  have hnorm : ∀ ℓ : E3 →L[ℝ] ℝ, ‖ℓ‖ = Real.sqrt (∑ i : Fin 3, ℓ (e i) ^ 2) := by
    intro ℓ
    set v := (InnerProductSpace.toDual ℝ E3).symm ℓ with hvdef
    have hv : ‖ℓ‖ = ‖v‖ := by simp [v]
    have hvi : ∀ i, v i = ℓ (e i) := by
      intro i
      have h1 : inner ℝ v (e i) = ℓ (e i) := InnerProductSpace.toDual_symm_apply
      rw [EuclideanSpace.inner_single_right] at h1
      simpa using h1
    rw [hv, EuclideanSpace.norm_eq]
    simp [hvi, Real.norm_eq_abs, sq_abs]
  have hexp : ∀ (ℓ : E3 →L[ℝ] ℝ) (x : E3), ℓ x = ∑ i : Fin 3, ℓ (e i) * x i := by
    intro ℓ x
    have hx : x = x 0 • e 0 + x 1 • e 1 + x 2 • e 2 := by
      ext j
      fin_cases j <;> simp [e]
    conv_lhs => rw [hx]
    simp [Fin.sum_univ_three, map_add, map_smul, mul_comm]
  
  have alg : ∀ a0 a1 a2 c0 c1 c2 r0 r1 r2 x00 x01 x02 x10 x11 x12 x20 x21 x22 : ℝ,
      a0 * x00 + a1 * x01 + a2 * x02 = 1 → a0 * x10 + a1 * x11 + a2 * x12 = 0 →
      a0 * x20 + a1 * x21 + a2 * x22 = 0 →
      c0 * x00 + c1 * x01 + c2 * x02 = 0 → c0 * x10 + c1 * x11 + c2 * x12 = 1 →
      c0 * x20 + c1 * x21 + c2 * x22 = 0 →
      r0 * x00 + r1 * x01 + r2 * x02 = 0 → r0 * x10 + r1 * x11 + r2 * x12 = 0 →
      r0 * x20 + r1 * x21 + r2 * x22 = 1 →
      0 < (a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2 ∧
      Real.sqrt (a0 ^ 2 + a1 ^ 2 + a2 ^ 2) /
          Real.sqrt ((a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2) *
          Real.sqrt (x20 ^ 2 + x21 ^ 2 + x22 ^ 2) =
        Real.sqrt ((x11 * x22 - x12 * x21) ^ 2 + (x12 * x20 - x10 * x22) ^ 2 +
          (x10 * x21 - x11 * x20) ^ 2) := by
    intro a0 a1 a2 c0 c1 c2 r0 r1 r2 x00 x01 x02 x10 x11 x12 x20 x21 x22
      h00 h01 h02 h10 h11 h12 h20 h21 h22
    obtain ⟨D, hD⟩ : ∃ D : ℝ, D = x00 * (x11 * x22 - x12 * x21) + x01 * (x12 * x20 - x10 * x22) +
        x02 * (x10 * x21 - x11 * x20) := ⟨_, rfl⟩
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = a0 * (c1 * r2 - c2 * r1) + a1 * (c2 * r0 - c0 * r2) +
        a2 * (c0 * r1 - c1 * r0) := ⟨_, rfl⟩
    
    have hy0 : x11 * x22 - x12 * x21 = D * a0 := by
      linear_combination (-a0) * hD + (-(x11 * x22 - x12 * x21)) * h00 +
        (-(x21 * x02 - x22 * x01)) * h01 + (-(x01 * x12 - x02 * x11)) * h02
    have hy1 : x12 * x20 - x10 * x22 = D * a1 := by
      linear_combination (-a1) * hD + (-(x12 * x20 - x10 * x22)) * h00 +
        (-(x22 * x00 - x20 * x02)) * h01 + (-(x02 * x10 - x00 * x12)) * h02
    have hy2 : x10 * x21 - x11 * x20 = D * a2 := by
      linear_combination (-a2) * hD + (-(x10 * x21 - x11 * x20)) * h00 +
        (-(x20 * x01 - x21 * x00)) * h01 + (-(x00 * x11 - x01 * x10)) * h02
    
    have hc0 : a1 * c2 - a2 * c1 = E * x20 := by
      linear_combination (-x20) * hE + (-(a1 * c2 - a2 * c1)) * h22 +
        (-(c1 * r2 - c2 * r1)) * h02 + (-(r1 * a2 - r2 * a1)) * h12
    have hc1 : a2 * c0 - a0 * c2 = E * x21 := by
      linear_combination (-x21) * hE + (-(a2 * c0 - a0 * c2)) * h22 +
        (-(c2 * r0 - c0 * r2)) * h02 + (-(r2 * a0 - r0 * a2)) * h12
    have hc2 : a0 * c1 - a1 * c0 = E * x22 := by
      linear_combination (-x22) * hE + (-(a0 * c1 - a1 * c0)) * h22 +
        (-(c0 * r1 - c1 * r0)) * h02 + (-(r0 * a1 - r1 * a0)) * h12
    
    have hED : E * D = 1 := by
      linear_combination D * hE +
        (a0 * (c1 * r2 - c2 * r1) + a1 * (c2 * r0 - c0 * r2) + a2 * (c0 * r1 - c1 * r0)) * hD +
        ((c0 * x10 + c1 * x11 + c2 * x12) * (r0 * x20 + r1 * x21 + r2 * x22) -
          (c0 * x20 + c1 * x21 + c2 * x22) * (r0 * x10 + r1 * x11 + r2 * x12)) * h00 +
        (r0 * x20 + r1 * x21 + r2 * x22) * h11 + h22 -
        (r0 * x10 + r1 * x11 + r2 * x12) * h12 -
        ((c0 * x00 + c1 * x01 + c2 * x02) * (r0 * x20 + r1 * x21 + r2 * x22) -
          (c0 * x20 + c1 * x21 + c2 * x22) * (r0 * x00 + r1 * x01 + r2 * x02)) * h01 +
        ((c0 * x00 + c1 * x01 + c2 * x02) * (r0 * x10 + r1 * x11 + r2 * x12) -
          (c0 * x10 + c1 * x11 + c2 * x12) * (r0 * x00 + r1 * x01 + r2 * x02)) * h02
    have hE0 : E ≠ 0 := left_ne_zero_of_mul_eq_one hED
    have hN : 0 < x20 ^ 2 + x21 ^ 2 + x22 ^ 2 := by
      by_contra hcon
      push_neg at hcon
      have e0 : x20 ^ 2 = 0 := by linarith [sq_nonneg x20, sq_nonneg x21, sq_nonneg x22]
      have e1 : x21 ^ 2 = 0 := by linarith [sq_nonneg x20, sq_nonneg x21, sq_nonneg x22]
      have e2 : x22 ^ 2 = 0 := by linarith [sq_nonneg x20, sq_nonneg x21, sq_nonneg x22]
      have f0 : x20 = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp e0
      have f1 : x21 = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp e1
      have f2 : x22 = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp e2
      rw [f0, f1, f2] at h22
      norm_num at h22
    have hQ : (a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2 =
        E ^ 2 * (x20 ^ 2 + x21 ^ 2 + x22 ^ 2) := by
      rw [hc0, hc1, hc2]; ring
    have hT : (x11 * x22 - x12 * x21) ^ 2 + (x12 * x20 - x10 * x22) ^ 2 +
        (x10 * x21 - x11 * x20) ^ 2 = D ^ 2 * (a0 ^ 2 + a1 ^ 2 + a2 ^ 2) := by
      rw [hy0, hy1, hy2]; ring
    have hE2 : 0 < E ^ 2 := by positivity
    refine ⟨by rw [hQ]; exact mul_pos hE2 hN, ?_⟩
    rw [hQ, hT, Real.sqrt_mul (sq_nonneg E), Real.sqrt_mul (sq_nonneg D), Real.sqrt_sq_eq_abs,
      Real.sqrt_sq_eq_abs]
    have hsN : 0 < Real.sqrt (x20 ^ 2 + x21 ^ 2 + x22 ^ 2) := Real.sqrt_pos.mpr hN
    have hEa : 0 < |E| := abs_pos.mpr hE0
    have hEDabs : |E| * |D| = 1 := by rw [← abs_mul, hED, abs_one]
    rw [div_mul_eq_mul_div, div_eq_iff (ne_of_gt (mul_pos hEa hsN))]
    linear_combination (-(Real.sqrt (a0 ^ 2 + a1 ^ 2 + a2 ^ 2) *
      Real.sqrt (x20 ^ 2 + x21 ^ 2 + x22 ^ 2))) * hEDabs
  
  have hVo : IsOpen {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    have c0 : Continuous (fun w : E3 => |w 0 - τ₀|) := by fun_prop
    have c1 : Continuous (fun w : E3 => |w 1 - β₀|) := by fun_prop
    have c2 : Continuous (fun w : E3 => |w 2 - σ₀|) := by fun_prop
    exact (isOpen_lt c0 continuous_const).inter
      ((isOpen_lt c1 continuous_const).inter (isOpen_lt c2 continuous_const))
  have hVn : {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} ∈ 𝓝 w :=
    hVo.mem_nhds hw
  have hPwU : P w ∈ U := (hPV w hw).2.1
  have hOn : O ∈ 𝓝 (P w) := hO.mem_nhds (hUO hPwU)
  have hfd : HasFDerivAt f (fderiv ℝ f (P w)) (P w) :=
    ((hf.contDiffAt hOn).differentiableAt (by simp)).hasFDerivAt
  have hbd : HasFDerivAt b (fderiv ℝ b (P w)) (P w) :=
    ((hb.contDiffAt hOn).differentiableAt (by simp)).hasFDerivAt
  have hPd : HasFDerivAt P (fderiv ℝ P w) w :=
    ((hP.contDiffAt hVn).differentiableAt (by simp)).hasFDerivAt
  have hcoord : ∀ w' : E3, |w' 0 - τ₀| < δ ∧ |w' 1 - β₀| < δ ∧ |w' 2 - σ₀| < δ →
      f (P w') = w' 0 ∧ b (P w') = w' 1 ∧ (P w') k = w' 2 := by
    intro w' hw'
    have h := (hPV w' hw').2.2
    refine ⟨?_, ?_, ?_⟩
    · exact congrArg (fun v : E3 => v 0) h
    · exact congrArg (fun v : E3 => v 1) h
    · exact congrArg (fun v : E3 => v 2) h
  have hL0 : (fderiv ℝ f (P w)).comp (fderiv ℝ P w) =
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) := by
    have h1 := hfd.comp w hPd
    have h2 : HasFDerivAt (f ∘ P) (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) w := by
      apply (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt.congr_of_eventuallyEq
      filter_upwards [hVn] with w' hw'
      exact (hcoord w' hw').1
    exact h1.unique h2
  have hL1 : (fderiv ℝ b (P w)).comp (fderiv ℝ P w) =
      (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ) := by
    have h1 := hbd.comp w hPd
    have h2 : HasFDerivAt (b ∘ P) (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ) w := by
      apply (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt.congr_of_eventuallyEq
      filter_upwards [hVn] with w' hw'
      exact (hcoord w' hw').2.1
    exact h1.unique h2
  have hL2 : (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).comp (fderiv ℝ P w) =
      (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ) := by
    have h1 := (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt.comp w hPd
    have h2 : HasFDerivAt ((EuclideanSpace.proj k : E3 →L[ℝ] ℝ) ∘ P)
        (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ) w := by
      apply (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt.congr_of_eventuallyEq
      filter_upwards [hVn] with w' hw'
      exact (hcoord w' hw').2.2
    exact h1.unique h2
  have r0 : ∀ v : E3, fderiv ℝ f (P w) (fderiv ℝ P w v) = v 0 := fun v =>
    congrArg (fun T : E3 →L[ℝ] ℝ => T v) hL0
  have r1 : ∀ v : E3, fderiv ℝ b (P w) (fderiv ℝ P w v) = v 1 := fun v =>
    congrArg (fun T : E3 →L[ℝ] ℝ => T v) hL1
  have r2 : ∀ v : E3, (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) (fderiv ℝ P w v) = v 2 := fun v =>
    congrArg (fun T : E3 →L[ℝ] ℝ => T v) hL2
  
  have hinj : Function.Injective (fderiv ℝ P w) := by
    rw [injective_iff_map_eq_zero]
    intro v hv
    have a0 : v 0 = 0 := by rw [← r0 v, hv, map_zero]
    have a1 : v 1 = 0 := by rw [← r1 v, hv, map_zero]
    have a2 : v 2 = 0 := by rw [← r2 v, hv, map_zero]
    ext i
    fin_cases i <;> simp [a0, a1, a2]
  
  have rel : ∀ (ℓ : E3 →L[ℝ] ℝ) (j : Fin 3), ℓ (fderiv ℝ P w (e j)) =
      ℓ (e 0) * fderiv ℝ P w (e j) 0 + ℓ (e 1) * fderiv ℝ P w (e j) 1 +
        ℓ (e 2) * fderiv ℝ P w (e j) 2 := by
    intro ℓ j
    rw [hexp ℓ (fderiv ℝ P w (e j)), Fin.sum_univ_three]
  have h00 := (rel (fderiv ℝ f (P w)) 0).symm.trans (r0 (e 0))
  have h01 := (rel (fderiv ℝ f (P w)) 1).symm.trans (r0 (e 1))
  have h02 := (rel (fderiv ℝ f (P w)) 2).symm.trans (r0 (e 2))
  have h10 := (rel (fderiv ℝ b (P w)) 0).symm.trans (r1 (e 0))
  have h11 := (rel (fderiv ℝ b (P w)) 1).symm.trans (r1 (e 1))
  have h12 := (rel (fderiv ℝ b (P w)) 2).symm.trans (r1 (e 2))
  have h20 := (rel (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) 0).symm.trans (r2 (e 0))
  have h21 := (rel (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) 1).symm.trans (r2 (e 1))
  have h22 := (rel (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) 2).symm.trans (r2 (e 2))
  have v00 : (e 0 : E3) 0 = 1 := by simp [e]
  have v10 : (e 1 : E3) 0 = 0 := by simp [e]
  have v20 : (e 2 : E3) 0 = 0 := by simp [e]
  have v01 : (e 0 : E3) 1 = 0 := by simp [e]
  have v11 : (e 1 : E3) 1 = 1 := by simp [e]
  have v21 : (e 2 : E3) 1 = 0 := by simp [e]
  have v02 : (e 0 : E3) 2 = 0 := by simp [e]
  have v12 : (e 1 : E3) 2 = 0 := by simp [e]
  have v22 : (e 2 : E3) 2 = 1 := by simp [e]
  rw [v00] at h00
  rw [v10] at h01
  rw [v20] at h02
  rw [v01] at h10
  rw [v11] at h11
  rw [v21] at h12
  rw [v02] at h20
  rw [v12] at h21
  rw [v22] at h22
  obtain ⟨hQpos, hid⟩ := alg _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    h00 h01 h02 h10 h11 h12 h20 h21 h22
  
  have hQeq : ∑ i : Fin 3, sbgbCross f b (P w) i ^ 2 =
      (fderiv ℝ f (P w) (e 1) * fderiv ℝ b (P w) (e 2) -
          fderiv ℝ f (P w) (e 2) * fderiv ℝ b (P w) (e 1)) ^ 2 +
        (fderiv ℝ f (P w) (e 2) * fderiv ℝ b (P w) (e 0) -
          fderiv ℝ f (P w) (e 0) * fderiv ℝ b (P w) (e 2)) ^ 2 +
        (fderiv ℝ f (P w) (e 0) * fderiv ℝ b (P w) (e 1) -
          fderiv ℝ f (P w) (e 1) * fderiv ℝ b (P w) (e 0)) ^ 2 := by
    rw [Fin.sum_univ_three]
    rfl
  have hTeq : ∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
      (fun j => fderiv ℝ P w (e 2) j) i) ^ 2 =
      (fderiv ℝ P w (e 1) 1 * fderiv ℝ P w (e 2) 2 -
          fderiv ℝ P w (e 1) 2 * fderiv ℝ P w (e 2) 1) ^ 2 +
        (fderiv ℝ P w (e 1) 2 * fderiv ℝ P w (e 2) 0 -
          fderiv ℝ P w (e 1) 0 * fderiv ℝ P w (e 2) 2) ^ 2 +
        (fderiv ℝ P w (e 1) 0 * fderiv ℝ P w (e 2) 1 -
          fderiv ℝ P w (e 1) 1 * fderiv ℝ P w (e 2) 0) ^ 2 := by
    rw [Fin.sum_univ_three, cross_apply]
    rfl
  have hNeq : ‖fderiv ℝ P w (e 2)‖ = Real.sqrt (fderiv ℝ P w (e 2) 0 ^ 2 +
      fderiv ℝ P w (e 2) 1 ^ 2 + fderiv ℝ P w (e 2) 2 ^ 2) := by
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
    simp only [Real.norm_eq_abs, sq_abs]
  have hFeq : ‖fderiv ℝ f (P w)‖ = Real.sqrt (fderiv ℝ f (P w) (e 0) ^ 2 +
      fderiv ℝ f (P w) (e 1) ^ 2 + fderiv ℝ f (P w) (e 2) ^ 2) := by
    rw [hnorm, Fin.sum_univ_three]
  refine ⟨hinj, ?_, ?_⟩
  · rw [hQeq]; exact hQpos
  · rw [hFeq, hQeq, hNeq, hTeq]; exact hid

theorem box_edge_curve_calculus (f b : E3 → ℝ) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (U : Set E3)
    (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (t : ℝ) :
    IsOpen {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ} ∧
    ContDiffOn ℝ ∞ (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]))
      {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ} ∧
    Set.InjOn (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]))
      {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ} ∧
    ∀ x ∈ {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
      deriv (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) x =
        fderiv ℝ P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) (e 2) :=
by
  have hAff : (fun x : ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) =
      fun x : ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, 0] + x • e 2 := by
    funext x
    ext i
    fin_cases i <;> simp [e, EuclideanSpace.single_apply]
  have hAd : ∀ x : ℝ, HasDerivAt (fun x : ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])
      (e 2) x := by
    intro x
    rw [hAff]
    have h := ((hasDerivAt_id x).smul_const (e 2)).const_add
      ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, 0])
    simpa using h
  have hAs : ContDiff ℝ ∞ (fun x : ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) := by
    rw [hAff]
    exact contDiff_const.add (contDiff_id.smul contDiff_const)
  have hc : ∀ i : Fin 3, Continuous (fun w : E3 => w i) := fun i => PiLp.continuous_apply 2 _ i
  have hVopen : IsOpen {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    refine IsOpen.and ?_ (IsOpen.and ?_ ?_)
    · exact isOpen_lt (((hc 0).sub continuous_const).abs) continuous_const
    · exact isOpen_lt (((hc 1).sub continuous_const).abs) continuous_const
    · exact isOpen_lt (((hc 2).sub continuous_const).abs) continuous_const
  have hmaps : Set.MapsTo (fun x : ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])
      {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ}
      {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := fun x hx => hx
  refine ⟨?_, ?_, ?_, ?_⟩
  · refine IsOpen.and ?_ (IsOpen.and ?_ ?_)
    · exact isOpen_lt continuous_const continuous_const
    · exact isOpen_lt continuous_const continuous_const
    · exact isOpen_lt ((continuous_id.sub continuous_const).abs) continuous_const
  · exact hP.comp hAs.contDiffOn hmaps
  · intro x hx x' hx' hxx
    have hxx' : P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) =
        P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x']) := hxx
    have h1 := (hPV _ (hmaps hx)).2.2
    have h2 := (hPV _ (hmaps hx')).2.2
    rw [hxx'] at h1
    have h3 := congrArg (fun v : E3 => v 2) (h1.symm.trans h2)
    exact h3
  · intro x hx
    have hPd : HasFDerivAt P (fderiv ℝ P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]))
        ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) :=
      ((hP.contDiffAt (hVopen.mem_nhds (hmaps hx))).differentiableAt (by simp)).hasFDerivAt
    exact (hPd.comp_hasDerivAt x (hAd x)).deriv

theorem sbgb_curve_length_formula (γ : ℝ → E3) (W : Set ℝ) (hW : IsOpen W)
    (hγ : ContDiffOn ℝ ∞ γ W) (hinj : Set.InjOn γ W) (hdγ : ∀ x ∈ W, deriv γ x ≠ 0)
    (W' : Set ℝ) (hW' : MeasurableSet W') (hW'W : W' ⊆ W) (h : E3 → ℝ) :
    ∫ y in γ '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) =
      ∫ x in W', h (γ x) * ‖deriv γ x‖ :=
by
  classical
  
  
  
  have hloc : ∀ x₀ ∈ W, ∀ ε : ℝ, 0 < ε → ε < 1 →
      ∃ r : ℝ, 0 < r ∧ Metric.ball x₀ r ⊆ W ∧
        (∀ x ∈ Metric.ball x₀ r,
          (1 - ε) * ‖deriv γ x₀‖ ≤ ‖deriv γ x‖ ∧ ‖deriv γ x‖ ≤ (1 + ε) * ‖deriv γ x₀‖) ∧
        ∀ S : Set ℝ, S ⊆ Metric.ball x₀ r →
          MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S) ≤
              ENNReal.ofReal (1 + ε) * (ENNReal.ofReal ‖deriv γ x₀‖ * MeasureTheory.volume S) ∧
            ENNReal.ofReal ‖deriv γ x₀‖ * MeasureTheory.volume S ≤
              ENNReal.ofReal ((1 - ε)⁻¹) *
                MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S) := by
    intro x₀ hx₀ ε hε hε1
    have hm0 : 0 < ‖deriv γ x₀‖ := norm_pos_iff.mpr (hdγ x₀ hx₀)
    have hdc : ContinuousAt (deriv γ) x₀ :=
      (hγ.continuousOn_deriv_of_isOpen hW (by simp)).continuousAt (hW.mem_nhds hx₀)
    obtain ⟨r₁, hr₁, hr₁W⟩ := Metric.isOpen_iff.mp hW x₀ hx₀
    obtain ⟨r₂, hr₂, hr₂d⟩ := Metric.continuousAt_iff.mp hdc (ε * ‖deriv γ x₀‖) (by positivity)
    have hr : 0 < min r₁ r₂ := lt_min hr₁ hr₂
    have hballW : Metric.ball x₀ (min r₁ r₂) ⊆ W :=
      (Metric.ball_subset_ball (min_le_left _ _)).trans hr₁W
    have hdv : ∀ x ∈ Metric.ball x₀ (min r₁ r₂), ‖deriv γ x - deriv γ x₀‖ < ε * ‖deriv γ x₀‖ := by
      intro x hx
      have hxd : dist x x₀ < r₂ := lt_of_lt_of_le (Metric.mem_ball.mp hx) (min_le_right _ _)
      have := hr₂d hxd
      rwa [dist_eq_norm] at this
    have hE : ∀ x ∈ Metric.ball x₀ (min r₁ r₂), ∀ y ∈ Metric.ball x₀ (min r₁ r₂),
        (1 - ε) * (‖deriv γ x₀‖ * |x - y|) ≤ ‖γ x - γ y‖ ∧
          ‖γ x - γ y‖ ≤ (1 + ε) * (‖deriv γ x₀‖ * |x - y|) := by
      intro x hx y hy
      have hdiff : ∀ z ∈ Metric.ball x₀ (min r₁ r₂),
          DifferentiableAt ℝ (fun w => γ w - w • deriv γ x₀) z := by
        intro z hz
        have hγz : DifferentiableAt ℝ γ z :=
          (hγ.contDiffAt (hW.mem_nhds (hballW hz))).differentiableAt (by simp)
        exact hγz.sub (differentiableAt_id.smul_const (deriv γ x₀))
      have hbound : ∀ z ∈ Metric.ball x₀ (min r₁ r₂),
          ‖deriv (fun w => γ w - w • deriv γ x₀) z‖ ≤ ε * ‖deriv γ x₀‖ := by
        intro z hz
        have hγz : DifferentiableAt ℝ γ z :=
          (hγ.contDiffAt (hW.mem_nhds (hballW hz))).differentiableAt (by simp)
        have hd : HasDerivAt (fun w => γ w - w • deriv γ x₀)
            (deriv γ z - (1 : ℝ) • deriv γ x₀) z :=
          hγz.hasDerivAt.sub ((hasDerivAt_id z).smul_const (deriv γ x₀))
        rw [hd.deriv, one_smul]
        exact (hdv z hz).le
      have hmvt := (convex_ball x₀ (min r₁ r₂)).norm_image_sub_le_of_norm_deriv_le hdiff hbound hy hx
      have hrw : (γ x - x • deriv γ x₀) - (γ y - y • deriv γ x₀) =
          (γ x - γ y) - (x - y) • deriv γ x₀ := by
        rw [sub_smul]; abel
      rw [hrw, Real.norm_eq_abs (x - y)] at hmvt
      have hn : ‖(x - y) • deriv γ x₀‖ = ‖deriv γ x₀‖ * |x - y| := by
        rw [norm_smul, Real.norm_eq_abs, mul_comm]
      have t1 : ‖γ x - γ y‖ ≤ ‖(x - y) • deriv γ x₀‖ +
          ‖(γ x - γ y) - (x - y) • deriv γ x₀‖ := by
        have := norm_add_le ((x - y) • deriv γ x₀) ((γ x - γ y) - (x - y) • deriv γ x₀)
        simpa using this
      have t2 : ‖(x - y) • deriv γ x₀‖ ≤ ‖γ x - γ y‖ +
          ‖(γ x - γ y) - (x - y) • deriv γ x₀‖ := by
        have := norm_sub_le (γ x - γ y) ((γ x - γ y) - (x - y) • deriv γ x₀)
        simpa using this
      rw [hn] at t1 t2
      constructor <;> nlinarith
    refine ⟨min r₁ r₂, hr, hballW, ?_, ?_⟩
    · intro x hx
      have h1 := hdv x hx
      have h2 := abs_norm_sub_norm_le (deriv γ x) (deriv γ x₀)
      rw [abs_le] at h2
      obtain ⟨h2a, h2b⟩ := h2
      constructor <;> nlinarith
    · intro S hS
      have hES : ∀ x ∈ S, ∀ y ∈ S,
          (1 - ε) * (‖deriv γ x₀‖ * |x - y|) ≤ ‖γ x - γ y‖ ∧
            ‖γ x - γ y‖ ≤ (1 + ε) * (‖deriv γ x₀‖ * |x - y|) :=
        fun x hx y hy => hE x (hS hx) y (hS hy)
      have h1e : (0 : ℝ) < 1 - ε := by linarith
      have hp : 0 < (1 - ε) * ‖deriv γ x₀‖ := mul_pos h1e hm0
      
      have hup : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S) ≤
          ENNReal.ofReal ((1 + ε) * ‖deriv γ x₀‖) * MeasureTheory.volume S := by
        have hlip : LipschitzOnWith (Real.toNNReal ((1 + ε) * ‖deriv γ x₀‖)) γ S := by
          apply LipschitzOnWith.of_dist_le'
          intro x hx y hy
          rw [dist_eq_norm, Real.dist_eq]
          have := (hES x hx y hy).2
          linarith
        have := hlip.hausdorffMeasure_image_le (by norm_num : (0 : ℝ) ≤ 1)
        rw [ENNReal.rpow_one, MeasureTheory.hausdorffMeasure_real] at this
        exact this
      
      have hinjS : Set.InjOn γ S := by
        intro x hx y hy hxy
        have h := (hES x hx y hy).1
        rw [hxy, sub_self, norm_zero] at h
        have h0 : |x - y| = 0 := by
          have := abs_nonneg (x - y)
          nlinarith
        exact sub_eq_zero.mp (abs_eq_zero.mp h0)
      have hlow : MeasureTheory.volume S ≤ ENNReal.ofReal (((1 - ε) * ‖deriv γ x₀‖)⁻¹) *
          MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S) := by
        have hli := hinjS.leftInvOn_invFunOn
        have hHlip : LipschitzOnWith (Real.toNNReal ((1 - ε) * ‖deriv γ x₀‖)⁻¹)
            (Function.invFunOn γ S) (γ '' S) := by
          apply LipschitzOnWith.of_dist_le'
          rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
          rw [hli hx, hli hy, Real.dist_eq, dist_eq_norm, le_inv_mul_iff₀ hp]
          have := (hES x hx y hy).1
          linarith
        have himg : Function.invFunOn γ S '' (γ '' S) = S := by
          ext z
          constructor
          · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
            rw [hli hx]
            exact hx
          · intro hz
            exact ⟨γ z, ⟨z, hz, rfl⟩, hli hz⟩
        have := hHlip.hausdorffMeasure_image_le (by norm_num : (0 : ℝ) ≤ 1)
        rw [himg, ENNReal.rpow_one, MeasureTheory.hausdorffMeasure_real] at this
        exact this
      constructor
      · rw [← mul_assoc, ← ENNReal.ofReal_mul (by linarith)]
        exact hup
      · have hcoef : ‖deriv γ x₀‖ * ((1 - ε) * ‖deriv γ x₀‖)⁻¹ = (1 - ε)⁻¹ := by
          rw [mul_inv, mul_left_comm, mul_inv_cancel₀ hm0.ne', mul_one]
        calc ENNReal.ofReal ‖deriv γ x₀‖ * MeasureTheory.volume S
            ≤ ENNReal.ofReal ‖deriv γ x₀‖ * (ENNReal.ofReal (((1 - ε) * ‖deriv γ x₀‖)⁻¹) *
                MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S)) := by gcongr
          _ = ENNReal.ofReal (‖deriv γ x₀‖ * ((1 - ε) * ‖deriv γ x₀‖)⁻¹) *
                MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' S) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hm0.le]
          _ = _ := by rw [hcoef]
  
  
  
  have hγc : ContinuousOn γ W := hγ.continuousOn
  have hmeas : ∀ T : Set ℝ, MeasurableSet T → T ⊆ W →
      MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' T) =
        ∫⁻ x in T, ENNReal.ofReal ‖deriv γ x‖ := by
    intro T hT hTW
    rcases Set.eq_empty_or_nonempty W with hWe | hWne
    · have hTe : T = ∅ := Set.subset_empty_iff.mp (hWe ▸ hTW)
      subst hTe
      simp
    
    have squeeze : ∀ a b : ENNReal, (∀ ε : ℝ, 0 < ε → ε < 1 →
        a ≤ ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹) * b ∧
        b ≤ ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹) * a) → a = b := by
      intro a b h
      have key : ∀ (k : ℝ → ℝ) (x y : ENNReal), ContinuousAt k 0 → k 0 = 1 →
          (∀ ε : ℝ, 0 < ε → ε < 1 → x ≤ ENNReal.ofReal (k ε) * y) → x ≤ y := by
        intro k x y hk hk0 hxy
        have h1 : Filter.Tendsto k (nhdsWithin 0 (Set.Ioi 0)) (nhds 1) := by
          have := hk.tendsto
          rw [hk0] at this
          exact this.mono_left nhdsWithin_le_nhds
        have h2 : Filter.Tendsto (fun ε => ENNReal.ofReal (k ε)) (nhdsWithin 0 (Set.Ioi 0))
            (nhds 1) := by
          have := ENNReal.tendsto_ofReal h1
          rwa [ENNReal.ofReal_one] at this
        have h3 : Filter.Tendsto (fun ε => ENNReal.ofReal (k ε) * y) (nhdsWithin 0 (Set.Ioi 0))
            (nhds (1 * y)) :=
          ENNReal.Tendsto.mul_const h2 (Or.inl one_ne_zero)
        rw [one_mul] at h3
        have hev : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), x ≤ ENNReal.ofReal (k ε) * y := by
          filter_upwards [Ioo_mem_nhdsGT (zero_lt_one' ℝ)] with ε hε
          exact hxy ε hε.1 hε.2
        exact ge_of_tendsto h3 hev
      have hk : ContinuousAt (fun ε : ℝ => (1 + ε) * (1 - ε)⁻¹) 0 :=
        (continuous_const.add continuous_id).continuousAt.mul
          ((continuous_const.sub continuous_id).continuousAt.inv₀ (by norm_num))
      refine le_antisymm ?_ ?_
      · exact key _ a b hk (by norm_num) (fun ε h0 h1 => (h ε h0 h1).1)
      · exact key _ b a hk (by norm_num) (fun ε h0 h1 => (h ε h0 h1).2)
    
    have piece : ∀ (ε : ℝ), 0 < ε → ε < 1 → ∀ (J0 : ℝ) (S : Set ℝ), MeasurableSet S →
        (∀ x ∈ S, (1 - ε) * J0 ≤ ‖deriv γ x‖ ∧ ‖deriv γ x‖ ≤ (1 + ε) * J0) →
        ∀ m : ENNReal,
        m ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal J0 * MeasureTheory.volume S) →
        ENNReal.ofReal J0 * MeasureTheory.volume S ≤ ENNReal.ofReal ((1 - ε)⁻¹) * m →
        m ≤ ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹) * ∫⁻ x in S, ENNReal.ofReal ‖deriv γ x‖ ∧
          ∫⁻ x in S, ENNReal.ofReal ‖deriv γ x‖ ≤ ENNReal.ofReal ((1 + ε) * (1 - ε)⁻¹) * m := by
      intro ε hε hε1 J0 S hS hJ m hup hlo
      have h1e : 0 ≤ 1 + ε := by linarith
      have h1me : 0 < 1 - ε := by linarith
      have hne : 1 - ε ≠ 0 := h1me.ne'
      have hinv : 0 ≤ (1 - ε)⁻¹ := inv_nonneg.mpr h1me.le
      have hpu : ∀ x ∈ S, ENNReal.ofReal ‖deriv γ x‖ ≤
          ENNReal.ofReal (1 + ε) * ENNReal.ofReal J0 := by
        intro x hx
        rw [← ENNReal.ofReal_mul h1e]
        exact ENNReal.ofReal_le_ofReal (hJ x hx).2
      have hpl : ∀ x ∈ S, ENNReal.ofReal J0 ≤
          ENNReal.ofReal ((1 - ε)⁻¹) * ENNReal.ofReal ‖deriv γ x‖ := by
        intro x hx
        rw [← ENNReal.ofReal_mul hinv]
        apply ENNReal.ofReal_le_ofReal
        have h2 := mul_le_mul_of_nonneg_left (hJ x hx).1 hinv
        refine le_of_eq_of_le ?_ h2
        rw [← mul_assoc, inv_mul_cancel₀ hne, one_mul]
      have hI_le : ∫⁻ x in S, ENNReal.ofReal ‖deriv γ x‖ ≤
          ENNReal.ofReal (1 + ε) * ENNReal.ofReal J0 * MeasureTheory.volume S := by
        calc _ ≤ ∫⁻ x in S, ENNReal.ofReal (1 + ε) * ENNReal.ofReal J0 :=
              MeasureTheory.setLIntegral_mono' hS hpu
          _ = _ := MeasureTheory.setLIntegral_const _ _
      have hV_le : ENNReal.ofReal J0 * MeasureTheory.volume S ≤
          ENNReal.ofReal ((1 - ε)⁻¹) * ∫⁻ x in S, ENNReal.ofReal ‖deriv γ x‖ := by
        calc _ = ∫⁻ x in S, ENNReal.ofReal J0 := (MeasureTheory.setLIntegral_const _ _).symm
          _ ≤ ∫⁻ x in S, ENNReal.ofReal ((1 - ε)⁻¹) * ENNReal.ofReal ‖deriv γ x‖ :=
              MeasureTheory.setLIntegral_mono' hS hpl
          _ = _ := MeasureTheory.lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      constructor
      · calc m ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal J0 * MeasureTheory.volume S) := hup
          _ ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal ((1 - ε)⁻¹) *
              ∫⁻ x in S, ENNReal.ofReal ‖deriv γ x‖) := by gcongr
          _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul h1e]
      · calc _ ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal J0 * MeasureTheory.volume S) := by
              rw [← mul_assoc]; exact hI_le
          _ ≤ ENNReal.ofReal (1 + ε) * (ENNReal.ofReal ((1 - ε)⁻¹) * m) := by gcongr
          _ = _ := by rw [← mul_assoc, ← ENNReal.ofReal_mul h1e]
    
    apply squeeze
    intro ε hε hε1
    choose! r hr0 hrW hrJ hrS using fun x hx => hloc x hx ε hε hε1
    obtain ⟨Tc, hTcW, hTcc, hTcU⟩ := TopologicalSpace.isOpen_biUnion_countable W
      (fun x => Metric.ball x (r x)) (fun x _ => Metric.isOpen_ball)
    have hWsub : W ⊆ ⋃ x ∈ W, Metric.ball x (r x) := fun x hx =>
      Set.mem_iUnion₂.mpr ⟨x, hx, Metric.mem_ball_self (hr0 x hx)⟩
    have hTcne : Tc.Nonempty := by
      obtain ⟨w, hw⟩ := hWne
      have hw' := hWsub hw
      rw [← hTcU] at hw'
      obtain ⟨x, hx, _⟩ := Set.mem_iUnion₂.mp hw'
      exact ⟨x, hx⟩
    obtain ⟨c, rfl⟩ := hTcc.exists_eq_range hTcne
    have hcW : ∀ n, c n ∈ W := fun n => hTcW ⟨n, rfl⟩
    set B : ℕ → Set ℝ := fun n => Metric.ball (c n) (r (c n)) with hB
    set P := disjointed B with hP
    have hPm : ∀ n, MeasurableSet (P n) :=
      MeasurableSet.disjointed (fun n => measurableSet_ball)
    have hPd : Pairwise (Function.onFun Disjoint P) := disjoint_disjointed B
    have hPB : ∀ n, P n ⊆ B n := disjointed_subset B
    have hcov : W ⊆ ⋃ n, P n := by
      rw [hP, iUnion_disjointed]
      intro x hx
      have hx' := hWsub hx
      rw [← hTcU, Set.biUnion_range] at hx'
      exact hx'
    set Tn : ℕ → Set ℝ := fun n => T ∩ P n with hTn
    have hTnm : ∀ n, MeasurableSet (Tn n) := fun n => hT.inter (hPm n)
    have hTnd : Pairwise (Function.onFun Disjoint Tn) := fun i j hij =>
      (hPd hij).mono Set.inter_subset_right Set.inter_subset_right
    have hTnW : ∀ n, Tn n ⊆ W := fun n => Set.inter_subset_left.trans hTW
    have hTnB : ∀ n, Tn n ⊆ Metric.ball (c n) (r (c n)) := fun n =>
      Set.inter_subset_right.trans (hPB n)
    have hTU : T = ⋃ n, Tn n := by
      ext x
      constructor
      · intro hx
        obtain ⟨n, hn⟩ := Set.mem_iUnion.mp (hcov (hTW hx))
        exact Set.mem_iUnion.mpr ⟨n, hx, hn⟩
      · intro hx
        obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hx
        exact hn.1
    have hA : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' T) =
        ∑' n, MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' Tn n) := by
      have hA' : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' ⋃ n, Tn n) =
          ∑' n, MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' Tn n) := by
        rw [Set.image_iUnion]
        refine MeasureTheory.measure_iUnion ?_ ?_
        · intro i j hij
          rw [Function.onFun, Set.disjoint_left]
          rintro y ⟨p, hp, rfl⟩ ⟨q, hq, hpq⟩
          have hqp := hinj (hTnW j hq) (hTnW i hp) hpq
          subst hqp
          exact Set.disjoint_left.mp (hTnd hij) hp hq
        · intro n
          exact (hTnm n).image_of_continuousOn_injOn (hγc.mono (hTnW n)) (hinj.mono (hTnW n))
      rw [← hTU] at hA'
      exact hA'
    have hB2 : ∫⁻ x in T, ENNReal.ofReal ‖deriv γ x‖ =
        ∑' n, ∫⁻ x in Tn n, ENNReal.ofReal ‖deriv γ x‖ := by
      have h := MeasureTheory.lintegral_iUnion (μ := MeasureTheory.volume) hTnm hTnd
        (fun x => ENNReal.ofReal ‖deriv γ x‖)
      rw [← hTU] at h
      exact h
    have hpc := fun n => piece ε hε hε1 ‖deriv γ (c n)‖ (Tn n)
      (hTnm n) (fun x hx => hrJ (c n) (hcW n) x (hTnB n hx))
      (MeasureTheory.Measure.hausdorffMeasure (1 : ℝ) (γ '' Tn n))
      (hrS (c n) (hcW n) (Tn n) (hTnB n)).1 (hrS (c n) (hcW n) (Tn n) (hTnB n)).2
    rw [hA, hB2]
    constructor
    · exact (ENNReal.tsum_le_tsum fun n => (hpc n).1).trans (le_of_eq ENNReal.tsum_mul_left)
    · exact (ENNReal.tsum_le_tsum fun n => (hpc n).2).trans (le_of_eq ENNReal.tsum_mul_left)
  
  
  
  have hρm : Measurable (fun x => ‖deriv γ x‖) := (measurable_deriv γ).norm
  have he : MeasurableEmbedding (W'.restrict γ) :=
    ContinuousOn.measurableEmbedding hW' (hγc.mono hW'W) (hinj.mono hW'W)
  set μ' : MeasureTheory.Measure W' := MeasureTheory.Measure.comap Subtype.val MeasureTheory.volume
    with hμ'
  set f : W' → NNReal := fun x => (‖deriv γ x‖).toNNReal with hfdef
  have hf : Measurable f := (hρm.comp measurable_subtype_coe).real_toNNReal
  have key : MeasureTheory.Measure.map (W'.restrict γ) (μ'.withDensity (fun x => (f x : ENNReal))) =
      (MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)).restrict (γ '' W') := by
    ext B hB
    rw [he.map_apply, MeasureTheory.withDensity_apply _ (he.measurable hB),
      MeasureTheory.Measure.restrict_apply hB]
    have hT : Subtype.val '' ((W'.restrict γ) ⁻¹' B) = W' ∩ γ ⁻¹' B := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨y.2, hy⟩
      · rintro ⟨hx1, hx2⟩
        exact ⟨⟨x, hx1⟩, hx2, rfl⟩
    have hTm : MeasurableSet (W' ∩ γ ⁻¹' B) := by
      rw [← hT]
      exact (MeasurableEmbedding.subtype_coe hW').measurableSet_image' (he.measurable hB)
    have h1 : ∫⁻ x in (W'.restrict γ) ⁻¹' B, (f x : ENNReal) ∂μ' =
        ∫⁻ x in (W'.restrict γ) ⁻¹' B, (fun y : ℝ => ENNReal.ofReal ‖deriv γ y‖) (x : ℝ) ∂μ' := rfl
    rw [h1, hμ', MeasureTheory.setLIntegral_subtype hW' _
        (fun y : ℝ => ENNReal.ofReal ‖deriv γ y‖), hT,
      ← hmeas (W' ∩ γ ⁻¹' B) hTm (Set.inter_subset_left.trans hW'W),
      Set.image_inter_preimage, Set.inter_comm]
  calc ∫ y in γ '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ))
      = ∫ y, h y ∂(MeasureTheory.Measure.map (W'.restrict γ)
          (μ'.withDensity (fun x => (f x : ENNReal)))) := by rw [key]
    _ = ∫ x : W', h (W'.restrict γ x) ∂(μ'.withDensity (fun x => (f x : ENNReal))) :=
        he.integral_map h
    _ = ∫ x : W', f x • h (W'.restrict γ x) ∂μ' :=
        integral_withDensity_eq_integral_smul hf _
    _ = ∫ x : W', (fun y : ℝ => ‖deriv γ y‖ * h (γ y)) (x : ℝ) ∂μ' := by
        congr 1
        funext x
        simp only [hfdef, NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (norm_nonneg _),
          Set.restrict_apply]
    _ = ∫ x in W', ‖deriv γ x‖ * h (γ x) := by
        rw [hμ']
        exact MeasureTheory.integral_subtype_comap hW' (fun y : ℝ => ‖deriv γ y‖ * h (γ y))
    _ = ∫ x in W', h (γ x) * ‖deriv γ x‖ := by
        congr 1
        funext x
        exact mul_comm _ _

theorem box_edge_side (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U)
    (J : E3 → ℝ)
    (hJ : ∀ w : E3, J w = Real.sqrt (∑ i : Fin 3, (crossProduct (fun j => fderiv ℝ P w (e 1) j)
        (fun j => fderiv ℝ P w (e 2) j) i) ^ 2))
    (g : ℝ → E2 → ℝ)
    (hg : ∀ (t : ℝ) (z : E2), g t z = if |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ then
        ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) *
          J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) else 0) :
    ∀ t : ℝ, ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
        ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
        ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) =
      ∫ x : ℝ, g t ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) :=
by
  intro t
  
  have hΓm : MeasurableSet {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} := by
    have h1 : IsOpen (O ∩ f ⁻¹' {t}ᶜ) :=
      hf.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have h2 : IsOpen (O ∩ b ⁻¹' {0}ᶜ) :=
      hb.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have heq : {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} =
        O \ ((O ∩ f ⁻¹' {t}ᶜ) ∪ (O ∩ b ⁻¹' {0}ᶜ)) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_union, Set.mem_inter_iff,
        Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
      tauto
    rw [heq]
    exact hO.measurableSet.diff (h1.union h2).measurableSet
  
  have hrestrict : ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
        ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
        ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) =
      ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U,
        ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
        ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) := by
    refine MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hΓm
      Set.inter_subset_left ?_
    intro y hy
    have hyU : y ∉ U := fun h => hy.2 ⟨hy.1, h⟩
    have hψ0 : ψ y = 0 := image_eq_zero_of_notMem_tsupport (fun h => hyU (hψU h))
    rw [hψ0, zero_mul]
  
  have hgeo := ((box_slice_geometry f b O k τ₀ β₀ σ₀ δ Lp U hUO P hPV hPU).2 t).2
  
  obtain ⟨hIo, hγs, hγi, hγd⟩ := box_edge_curve_calculus f b k τ₀ β₀ σ₀ δ Lp U P hP hPV t
  have hchart := box_chart_calculus f b O hO hf hb k τ₀ β₀ σ₀ δ Lp U hUO P hP hPV
  have hmem : ∀ x ∈ {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
      |((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 0 - τ₀| < δ ∧
      |((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 1 - β₀| < δ ∧
      |((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 2 - σ₀| < δ := by
    intro x hx
    have h0 : ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 0 = t := rfl
    have h1 : ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 1 = 0 := rfl
    have h2 : ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]) 2 = x := rfl
    rw [h0, h1, h2]
    exact hx
  have hdne : ∀ x ∈ {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
      deriv (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) x ≠ 0 := by
    intro x hx
    rw [hγd x hx]
    intro hzero
    have hinj := (hchart _ (hmem x hx)).1
    have he0 : (e 2 : E3) = 0 := hinj (by rw [hzero, map_zero])
    have hc := congrArg (fun v : E3 => v 2) he0
    simp [e] at hc
  have hlen : ∫ y in (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) ''
        {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
        ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
        ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) =
      ∫ x in {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
        ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) *
          (‖fderiv ℝ f (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x]))‖ /
            Real.sqrt (∑ k : Fin 3,
              sbgbCross f b (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) k ^ 2)) *
          ‖deriv (fun x : ℝ => P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x])) x‖ :=
    sbgb_curve_length_formula _ _ hIo hγs hγi hdne _ hIo.measurableSet subset_rfl
      (fun y => ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)))
  
  have hext : ∫ x in {x : ℝ | |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ},
        g t ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) =
      ∫ x : ℝ, g t ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) := by
    refine MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => ?_)
    have hz0 : ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) 0 = 0 := rfl
    have hz1 : ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) 1 = x := rfl
    rw [hg, hz0, hz1,
      if_neg (show ¬ (|t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ) from hx)]
  rw [hrestrict, hgeo, hlen, ← hext]
  
  refine MeasureTheory.setIntegral_congr_fun hIo.measurableSet ?_
  intro x hx
  beta_reduce
  obtain ⟨-, -, hcr⟩ := hchart _ (hmem x hx)
  have hz0 : ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) 0 = 0 := rfl
  have hz1 : ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![0, x]) 1 = x := rfl
  rw [hg, hz0, hz1, if_pos (show |t - τ₀| < δ ∧ |0 - β₀| < δ ∧ |x - σ₀| < δ from hx),
    hγd x hx, mul_assoc, hcr, ← hJ]

theorem box_edge_integrable (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O)
    (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U) :
    ∀ t : ℝ, MeasureTheory.IntegrableOn
      (fun y => ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)))
      {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} (MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) :=
by
  intro t
  
  have hc0 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 0 = a :=
    fun _ _ _ => rfl
  have hc1 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 1 = b' :=
    fun _ _ _ => rfl
  have hc2 : ∀ a b' c' : ℝ, ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![a, b', c']) 2 = c' :=
    fun _ _ _ => rfl
  
  have hVo : IsOpen {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    have h0 : IsOpen {w : E3 | |w 0 - τ₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    have h1 : IsOpen {w : E3 | |w 1 - β₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    have h2 : IsOpen {w : E3 | |w 2 - σ₀| < δ} := isOpen_lt (by fun_prop) continuous_const
    exact h0.inter (h1.inter h2)
  
  have hcoord : ∀ (x y : E3) (a b' : ℝ), 0 ≤ a → 0 ≤ b' → a + b' = 1 → ∀ (i : Fin 3) (c' : ℝ),
      |x i - c'| < δ → |y i - c'| < δ → |(a • x + b' • y) i - c'| < δ := by
    intro x y a b' ha hb hab i c' h1 h2
    have e' : (a • x + b' • y) i - c' = a * (x i - c') + b' * (y i - c') := by
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      linear_combination c' * hab
    rw [e']
    calc |a * (x i - c') + b' * (y i - c')|
        ≤ |a * (x i - c')| + |b' * (y i - c')| := abs_add_le _ _
      _ = a * |x i - c'| + b' * |y i - c'| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ ≤ a * max |x i - c'| |y i - c'| + b' * max |x i - c'| |y i - c'| :=
          add_le_add (mul_le_mul_of_nonneg_left (le_max_left _ _) ha)
            (mul_le_mul_of_nonneg_left (le_max_right _ _) hb)
      _ = max |x i - c'| |y i - c'| := by rw [← add_mul, hab, one_mul]
      _ < δ := max_lt h1 h2
  have hVc : Convex ℝ {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    intro x hx y hy a b' ha hb hab
    obtain ⟨hx0, hx1, hx2⟩ := hx
    obtain ⟨hy0, hy1, hy2⟩ := hy
    exact ⟨hcoord x y a b' ha hb hab 0 τ₀ hx0 hy0, hcoord x y a b' ha hb hab 1 β₀ hx1 hy1,
      hcoord x y a b' ha hb hab 2 σ₀ hx2 hy2⟩
  
  have hPlip : LipschitzOnWith (Real.toNNReal Lp) P
      {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ) (fun w hw => ?_)
      (fun w hw => ?_) hVc
    · exact (hP.contDiffAt (hVo.mem_nhds hw)).differentiableAt (by simp)
    · rw [← norm_toNNReal]
      exact Real.toNNReal_le_toNNReal (hPV w hw).1
  
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℝ → E3, ∀ x : ℝ,
      ℓ x = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, 0, x] := ⟨_, fun _ => rfl⟩
  have hℓiso : Isometry ℓ := by
    refine Isometry.of_dist_eq (fun x x' => ?_)
    rw [EuclideanSpace.dist_eq, Fin.sum_univ_three]
    simp only [hℓ, hc0, hc1, hc2, dist_self]
    have h0 : (0 : ℝ) ^ 2 + 0 ^ 2 + dist x x' ^ 2 = dist x x' ^ 2 := by ring
    rw [h0, Real.sqrt_sq dist_nonneg]
  
  have hmaps : Set.MapsTo ℓ {x : ℝ | |t - τ₀| < δ ∧ |(0 : ℝ) - β₀| < δ ∧ |x - σ₀| < δ}
      {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
    intro x hx
    obtain ⟨h1, h2, h3⟩ := hx
    show |ℓ x 0 - τ₀| < δ ∧ |ℓ x 1 - β₀| < δ ∧ |ℓ x 2 - σ₀| < δ
    rw [hℓ, hc0, hc1, hc2]
    exact ⟨h1, h2, h3⟩
  have hFlip : LipschitzOnWith (Real.toNNReal Lp * 1) (P ∘ ℓ)
      {x : ℝ | |t - τ₀| < δ ∧ |(0 : ℝ) - β₀| < δ ∧ |x - σ₀| < δ} :=
    hPlip.comp hℓiso.lipschitz.lipschitzOnWith hmaps
  
  have hIfin : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)
      {x : ℝ | |t - τ₀| < δ ∧ |(0 : ℝ) - β₀| < δ ∧ |x - σ₀| < δ} < ⊤ := by
    rw [MeasureTheory.hausdorffMeasure_real]
    refine lt_of_le_of_lt (MeasureTheory.measure_mono ?_)
      (measure_Ioo_lt_top (a := σ₀ - δ) (b := σ₀ + δ))
    intro x hx
    obtain ⟨_, _, h3⟩ := hx
    rw [abs_lt] at h3
    rw [Set.mem_Ioo]
    constructor <;> linarith [h3.1, h3.2]
  have himg : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)
      ((P ∘ ℓ) '' {x : ℝ | |t - τ₀| < δ ∧ |(0 : ℝ) - β₀| < δ ∧ |x - σ₀| < δ}) < ⊤ :=
    lt_of_le_of_lt (hFlip.hausdorffMeasure_image_le (by norm_num))
      (ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.coe_ne_top) hIfin)
  
  have hsub : {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U ⊆
      (P ∘ ℓ) '' {x : ℝ | |t - τ₀| < δ ∧ |(0 : ℝ) - β₀| < δ ∧ |x - σ₀| < δ} := by
    rintro y ⟨⟨_, hft, hb0⟩, hyU⟩
    obtain ⟨⟨h1, h2, h3⟩, hPy⟩ := hPU y hyU
    refine ⟨y k, ⟨?_, ?_, h3⟩, ?_⟩
    · rw [← hft]; exact h1
    · rw [← hb0]; exact h2
    · show P (ℓ (y k)) = y
      rw [hℓ, ← hft, ← hb0]
      exact hPy
  
  have hΓm : MeasurableSet {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} := by
    have h1 : IsOpen (O ∩ f ⁻¹' {t}ᶜ) :=
      hf.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have h2 : IsOpen (O ∩ b ⁻¹' {0}ᶜ) :=
      hb.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have heq : {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} =
        O \ ((O ∩ f ⁻¹' {t}ᶜ) ∪ (O ∩ b ⁻¹' {0}ᶜ)) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_union, Set.mem_inter_iff,
        Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
      tauto
    rw [heq]
    exact hO.measurableSet.diff (h1.union h2).measurableSet
  
  have hCS : ∀ X0 X1 X2 Y0 Y1 Y2 : ℝ,
      (X0 * Y0 + X1 * Y1 + X2 * Y2) ^ 2 ≤ (X0 ^ 2 + X1 ^ 2 + X2 ^ 2) * (Y0 ^ 2 + Y1 ^ 2 + Y2 ^ 2) := by
    intro X0 X1 X2 Y0 Y1 Y2
    nlinarith [sq_nonneg (X0 * Y1 - X1 * Y0), sq_nonneg (X0 * Y2 - X2 * Y0),
      sq_nonneg (X1 * Y2 - X2 * Y1)]
  have halg : ∀ a0 a1 a2 c0 c1 c2 u0 u1 u2 v0 v1 v2 L : ℝ,
      a0 * u0 + a1 * u1 + a2 * u2 = 1 → a0 * v0 + a1 * v1 + a2 * v2 = 0 →
      c0 * u0 + c1 * u1 + c2 * u2 = 0 → c0 * v0 + c1 * v1 + c2 * v2 = 1 →
      u0 ^ 2 + u1 ^ 2 + u2 ^ 2 ≤ L ^ 2 → v0 ^ 2 + v1 ^ 2 + v2 ^ 2 ≤ L ^ 2 →
      1 ≤ ((a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2) * L ^ 4 := by
    intro a0 a1 a2 c0 c1 c2 u0 u1 u2 v0 v1 v2 L hau hav hcu hcv hu hv
    have hXY : (a1 * c2 - a2 * c1) * (u1 * v2 - u2 * v1) + (a2 * c0 - a0 * c2) * (u2 * v0 - u0 * v2)
        + (a0 * c1 - a1 * c0) * (u0 * v1 - u1 * v0) = 1 := by
      have h : (a1 * c2 - a2 * c1) * (u1 * v2 - u2 * v1) + (a2 * c0 - a0 * c2) * (u2 * v0 - u0 * v2)
          + (a0 * c1 - a1 * c0) * (u0 * v1 - u1 * v0) =
          (a0 * u0 + a1 * u1 + a2 * u2) * (c0 * v0 + c1 * v1 + c2 * v2)
            - (a0 * v0 + a1 * v1 + a2 * v2) * (c0 * u0 + c1 * u1 + c2 * u2) := by ring
      rw [h, hau, hav, hcu, hcv]; ring
    have hY : (u1 * v2 - u2 * v1) ^ 2 + (u2 * v0 - u0 * v2) ^ 2 + (u0 * v1 - u1 * v0) ^ 2 ≤
        (u0 ^ 2 + u1 ^ 2 + u2 ^ 2) * (v0 ^ 2 + v1 ^ 2 + v2 ^ 2) := by
      nlinarith [sq_nonneg (u0 * v0 + u1 * v1 + u2 * v2)]
    have hUV : (u0 ^ 2 + u1 ^ 2 + u2 ^ 2) * (v0 ^ 2 + v1 ^ 2 + v2 ^ 2) ≤ L ^ 2 * L ^ 2 :=
      mul_le_mul hu hv (by positivity) (by positivity)
    have h1 := hCS (a1 * c2 - a2 * c1) (a2 * c0 - a0 * c2) (a0 * c1 - a1 * c0)
      (u1 * v2 - u2 * v1) (u2 * v0 - u0 * v2) (u0 * v1 - u1 * v0)
    rw [hXY, one_pow] at h1
    have hXn : 0 ≤ (a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2 := by
      positivity
    calc (1 : ℝ) ≤ _ := h1
      _ ≤ ((a1 * c2 - a2 * c1) ^ 2 + (a2 * c0 - a0 * c2) ^ 2 + (a0 * c1 - a1 * c0) ^ 2) *
          (L ^ 2 * L ^ 2) := mul_le_mul_of_nonneg_left (hY.trans hUV) hXn
      _ = _ := by ring
  
  have hexp : ∀ (L : E3 →L[ℝ] ℝ) (z : E3),
      L z = L (e 0) * z 0 + L (e 1) * z 1 + L (e 2) * z 2 := by
    intro L z
    have hz : z = z 0 • e 0 + z 1 • e 1 + z 2 • e 2 := by
      ext i; fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    conv_lhs => rw [hz]
    simp only [map_add, map_smul, smul_eq_mul]
    ring
  have hnsq : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  
  have hkey : ∀ y ∈ U, 1 ≤ (∑ i : Fin 3, sbgbCross f b y i ^ 2) * Lp ^ 4 := by
    intro y hyU
    obtain ⟨hwV, hPy⟩ := hPU y hyU
    obtain ⟨w, hw⟩ : ∃ w : E3, w = (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k] :=
      ⟨_, rfl⟩
    have hwV' : w ∈ {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ} := by
      show |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ
      rw [hw, hc0, hc1, hc2]
      exact hwV
    rw [← hw] at hPy
    have hnorm : ‖fderiv ℝ P w‖ ≤ Lp := (hPV w hwV').1
    have hPd : HasFDerivAt P (fderiv ℝ P w) w :=
      ((hP.contDiffAt (hVo.mem_nhds hwV')).differentiableAt (by simp)).hasFDerivAt
    have hfd : HasFDerivAt f (fderiv ℝ f y) (P w) := by
      rw [hPy]
      exact ((hf.contDiffAt (hO.mem_nhds (hUO hyU))).differentiableAt (by simp)).hasFDerivAt
    have hbd : HasFDerivAt b (fderiv ℝ b y) (P w) := by
      rw [hPy]
      exact ((hb.contDiffAt (hO.mem_nhds (hUO hyU))).differentiableAt (by simp)).hasFDerivAt
    have hpr0 : HasFDerivAt (⇑(EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ))
        (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) w := ContinuousLinearMap.hasFDerivAt _
    have hpr1 : HasFDerivAt (⇑(EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ))
        (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ) w := ContinuousLinearMap.hasFDerivAt _
    have hfP : HasFDerivAt (f ∘ P) (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) w := by
      refine hpr0.congr_of_eventuallyEq
        (Filter.eventually_of_mem (hVo.mem_nhds hwV') (fun w' hw' => ?_))
      have h3 := congrArg (fun z : E3 => z 0) (hPV w' hw').2.2
      exact h3
    have hbP : HasFDerivAt (b ∘ P) (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ) w := by
      refine hpr1.congr_of_eventuallyEq
        (Filter.eventually_of_mem (hVo.mem_nhds hwV') (fun w' hw' => ?_))
      have h3 := congrArg (fun z : E3 => z 1) (hPV w' hw').2.2
      exact h3
    have hEf := (hfd.comp w hPd).unique hfP
    have hEb := (hbd.comp w hPd).unique hbP
    have hfu : fderiv ℝ f y (fderiv ℝ P w (e 0)) = 1 := by
      have := congrArg (fun L : E3 →L[ℝ] ℝ => L (e 0)) hEf
      simpa [e] using this
    have hfv : fderiv ℝ f y (fderiv ℝ P w (e 1)) = 0 := by
      have := congrArg (fun L : E3 →L[ℝ] ℝ => L (e 1)) hEf
      simpa [e] using this
    have hbu : fderiv ℝ b y (fderiv ℝ P w (e 0)) = 0 := by
      have := congrArg (fun L : E3 →L[ℝ] ℝ => L (e 0)) hEb
      simpa [e] using this
    have hbv : fderiv ℝ b y (fderiv ℝ P w (e 1)) = 1 := by
      have := congrArg (fun L : E3 →L[ℝ] ℝ => L (e 1)) hEb
      simpa [e] using this
    have hle : ∀ i : Fin 3, ‖fderiv ℝ P w (e i)‖ ^ 2 ≤ Lp ^ 2 := by
      intro i
      have h1 : ‖fderiv ℝ P w (e i)‖ ≤ Lp :=
        calc ‖fderiv ℝ P w (e i)‖ ≤ ‖fderiv ℝ P w‖ * ‖e i‖ := (fderiv ℝ P w).le_opNorm _
          _ = ‖fderiv ℝ P w‖ := by simp [e, EuclideanSpace.norm_single]
          _ ≤ Lp := hnorm
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2
    have hu2 := hle 0
    have hv2 := hle 1
    rw [hnsq] at hu2 hv2
    have hS : ∑ i : Fin 3, sbgbCross f b y i ^ 2 =
        (partialDeriv 1 f y * partialDeriv 2 b y - partialDeriv 2 f y * partialDeriv 1 b y) ^ 2 +
        (partialDeriv 2 f y * partialDeriv 0 b y - partialDeriv 0 f y * partialDeriv 2 b y) ^ 2 +
        (partialDeriv 0 f y * partialDeriv 1 b y - partialDeriv 1 f y * partialDeriv 0 b y) ^ 2 := by
      rw [Fin.sum_univ_three]; rfl
    rw [hS]
    exact halg (partialDeriv 0 f y) (partialDeriv 1 f y) (partialDeriv 2 f y)
      (partialDeriv 0 b y) (partialDeriv 1 b y) (partialDeriv 2 b y)
      (fderiv ℝ P w (e 0) 0) (fderiv ℝ P w (e 0) 1) (fderiv ℝ P w (e 0) 2)
      (fderiv ℝ P w (e 1) 0) (fderiv ℝ P w (e 1) 1) (fderiv ℝ P w (e 1) 2) Lp
      ((hexp _ _).symm.trans hfu) ((hexp _ _).symm.trans hfv)
      ((hexp _ _).symm.trans hbu) ((hexp _ _).symm.trans hbv) hu2 hv2
  
  have hfc : ContinuousOn (fun y => ‖fderiv ℝ f y‖) (tsupport ψ) :=
    ((hf.continuousOn_fderiv_of_isOpen hO (by simp)).norm).mono (hψU.trans hUO)
  obtain ⟨Mψ, hMψ⟩ := hψc.exists_bound_of_continuousOn hψ.continuousOn
  obtain ⟨Mf, hMf⟩ := hψc.exists_bound_of_continuousOn hfc
  have hbound : ∀ y ∈ U,
      ‖ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))‖ ≤
        max Mψ 0 * (max Mf 0 * Lp ^ 2) := by
    intro y hyU
    by_cases hyK : y ∈ tsupport ψ
    · have h1 := hkey y hyU
      have hS0 : 0 ≤ ∑ k : Fin 3, sbgbCross f b y k ^ 2 :=
        Finset.sum_nonneg (fun i _ => sq_nonneg _)
      have hSpos : 0 < ∑ k : Fin 3, sbgbCross f b y k ^ 2 := by
        rcases hS0.lt_or_eq with h | h
        · exact h
        · rw [← h] at h1; norm_num at h1
      have hr : 0 < Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) := Real.sqrt_pos.mpr hSpos
      have hrsq : Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) ^ 2 =
          ∑ k : Fin 3, sbgbCross f b y k ^ 2 := Real.sq_sqrt hS0
      have hLr : 1 ≤ Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) := by
        have h2 : 1 ≤ (Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)) ^ 2 := by
          calc (1 : ℝ) ≤ (∑ k : Fin 3, sbgbCross f b y k ^ 2) * Lp ^ 4 := h1
            _ = (Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)) ^ 2 := by
              rw [mul_pow, hrsq]; ring
        have h3 : 0 ≤ Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) := by positivity
        nlinarith
      have hN0 : 0 ≤ ‖fderiv ℝ f y‖ := norm_nonneg _
      have hNr : ‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) ≤
          ‖fderiv ℝ f y‖ * Lp ^ 2 := by
        rw [div_le_iff₀ hr]
        calc ‖fderiv ℝ f y‖ = ‖fderiv ℝ f y‖ * 1 := (mul_one _).symm
          _ ≤ ‖fderiv ℝ f y‖ * (Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)) :=
            mul_le_mul_of_nonneg_left hLr hN0
          _ = ‖fderiv ℝ f y‖ * Lp ^ 2 * Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) := by ring
      have hNr0 : 0 ≤ ‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2) :=
        div_nonneg hN0 hr.le
      have hψb : |ψ y| ≤ max Mψ 0 := by
        have := hMψ y hyK
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _)
      have hNb : ‖fderiv ℝ f y‖ ≤ max Mf 0 := by
        have := hMf y hyK
        simp only [norm_norm] at this
        exact this.trans (le_max_left _ _)
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hNr0]
      exact mul_le_mul hψb (hNr.trans (mul_le_mul_of_nonneg_right hNb (sq_nonneg _))) hNr0
        (le_max_right _ _)
    · rw [image_eq_zero_of_notMem_tsupport hyK, zero_mul, norm_zero]
      exact mul_nonneg (le_max_right _ _) (mul_nonneg (le_max_right _ _) (sq_nonneg _))
  
  have hpd : ∀ (g : E3 → ℝ) (i : Fin 3), Measurable (fun y => partialDeriv i g y) :=
    fun g i => measurable_fderiv_apply_const ℝ g (e i)
  have hcross : ∀ i : Fin 3, Measurable (fun y => sbgbCross f b y i) := by
    intro i
    fin_cases i
    · exact ((hpd f 1).mul (hpd b 2)).sub ((hpd f 2).mul (hpd b 1))
    · exact ((hpd f 2).mul (hpd b 0)).sub ((hpd f 0).mul (hpd b 2))
    · exact ((hpd f 0).mul (hpd b 1)).sub ((hpd f 1).mul (hpd b 0))
  have hmeas : Measurable
      (fun y => ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))) := by
    refine hψ.measurable.mul ((measurable_fderiv ℝ f).norm.div ?_)
    exact (Finset.measurable_sum Finset.univ (fun i _ => (hcross i).pow_const 2)).sqrt
  
  have hΓU : MeasurableSet ({y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U) :=
    hΓm.inter hU.measurableSet
  have hμ : MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)
      ({y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U) < ⊤ :=
    lt_of_le_of_lt (MeasureTheory.measure_mono hsub) himg
  have hint : MeasureTheory.IntegrableOn
      (fun y => ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)))
      ({y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} ∩ U)
      (MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) :=
    MeasureTheory.IntegrableOn.of_bound hμ hmeas.aestronglyMeasurable
      (max Mψ 0 * (max Mf 0 * Lp ^ 2))
      (MeasureTheory.ae_restrict_of_forall_mem hΓU (fun y hy => hbound y hy.2))
  refine hint.of_forall_diff_eq_zero hΓm (fun y hy => ?_)
  have hyU : y ∉ U := fun h => hy.2 ⟨hy.1, h⟩
  have hyψ : y ∉ tsupport ψ := fun h => hyU (hψU h)
  simp [image_eq_zero_of_notMem_tsupport hyψ]

theorem box_trace_limit (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O) (hf : ContDiffOn ℝ ∞ f O)
    (hb : ContDiffOn ℝ ∞ b O) (k : Fin 3) (τ₀ β₀ σ₀ δ Lp : ℝ) (hδ : 0 < δ) (U : Set E3)
    (hU : IsOpen U) (hUO : U ⊆ O) (P : E3 → E3)
    (hP : ContDiffOn ℝ ∞ P {w : E3 | |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ})
    (hPV : ∀ w : E3, |w 0 - τ₀| < δ ∧ |w 1 - β₀| < δ ∧ |w 2 - σ₀| < δ →
      ‖fderiv ℝ P w‖ ≤ Lp ∧ P w ∈ U ∧
        (EuclideanSpace.equiv (Fin 3) ℝ).symm ![f (P w), b (P w), (P w) k] = w)
    (hPU : ∀ y ∈ U, (|f y - τ₀| < δ ∧ |b y - β₀| < δ ∧ |y k - σ₀| < δ) ∧
      P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![f y, b y, y k]) = y)
    (ψ : E3 → ℝ) (hψ : Continuous ψ) (hψc : IsCompact (tsupport ψ)) (hψU : tsupport ψ ⊆ U) :
    ∃ C : ℝ, ∀ t : ℝ,
      (∀ s : ℝ, 0 < s →
        MeasureTheory.IntegrableOn
          (fun y => s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y)
          {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y} (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ∧
        |∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
          s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))| ≤ C) ∧
      MeasureTheory.IntegrableOn
        (fun y => ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)))
        {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} (MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) ∧
      Tendsto (fun s => sbgbAreaConst *
          ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
            s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
            ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) (𝓝[>] (0 : ℝ))
        (𝓝 (∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
          ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
          ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)))) :=
by
  obtain ⟨hc0, -⟩ := sbgb_area_const_spec
  obtain ⟨J, hJ⟩ : ∃ J : E3 → ℝ, ∀ w : E3, J w = Real.sqrt (∑ i : Fin 3,
      (crossProduct (fun j => fderiv ℝ P w (e 1) j) (fun j => fderiv ℝ P w (e 2) j) i) ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨g, hg⟩ : ∃ g : ℝ → E2 → ℝ, ∀ (t : ℝ) (z : E2),
      g t z = if |t - τ₀| < δ ∧ |z 0 - β₀| < δ ∧ |z 1 - σ₀| < δ then
        ψ (P ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1])) *
          J ((EuclideanSpace.equiv (Fin 3) ℝ).symm ![t, z 0, z 1]) else 0 :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨M, hM⟩ := box_profile_props f b O hO hf hb k τ₀ β₀ σ₀ δ Lp hδ U hU hUO P hP hPV hPU
    ψ hψ hψc hψU J hJ g hg
  have harea := box_area_side f b O hO hf hb k τ₀ β₀ σ₀ δ Lp hδ U hU hUO P hP hPV hPU
    ψ hψ hψc hψU J hJ g hg
  have hedge := box_edge_side f b O hO hf hb k τ₀ β₀ σ₀ δ Lp hδ U hU hUO P hP hPV hPU
    ψ hψ hψc hψU J hJ g hg
  have hcint := box_collar_integrable f b O hO hf hb k τ₀ β₀ σ₀ δ Lp hδ U hU hUO P hP hPV hPU
    ψ hψ hψc hψU
  have heint := box_edge_integrable f b O hO hf hb k τ₀ β₀ σ₀ δ Lp hδ U hU hUO P hP hPV hPU
    ψ hψ hψc hψU
  refine ⟨2 * δ * M / sbgbAreaConst, fun t => ?_⟩
  obtain ⟨hgc, hgs, hgM, hgv⟩ := hM t
  obtain ⟨hbd, hlim⟩ := half_plane_kernel_limit (g t) hgc hgs σ₀ δ M hδ.le hgM hgv
  refine ⟨fun s hs => ⟨hcint t s hs, ?_⟩, heint t, ?_⟩
  · have h1 := harea t s hs
    have h2 := hbd s hs
    rw [← h1, abs_mul, abs_of_pos hc0] at h2
    rw [le_div_iff₀ hc0]
    linarith
  · rw [hedge t]
    refine hlim.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    exact (harea t s hs).symm

theorem chart_collar_trace_limit (f b : E3 → ℝ) (O : Set E3) (hO : IsOpen O)
    (hf : ContDiffOn ℝ ∞ f O) (hb : ContDiffOn ℝ ∞ b O) (ψ : E3 → ℝ) (hψ : Continuous ψ)
    (Kc : Set E3) (hKc : IsCompact Kc) (hKO : Kc ⊆ O) (hψK : ∀ y, y ∉ Kc → ψ y = 0)
    (hind : ∀ y ∈ Kc, b y = 0 → ∀ a c : ℝ,
      a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0) :
    ∃ s₁ : ℝ, 0 < s₁ ∧ ∃ C : ℝ,
      (∀ t s : ℝ, 0 < s → s < s₁ →
        |∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
          s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))| ≤ C) ∧
      ∀ t : ℝ, Tendsto (fun s => sbgbAreaConst *
          ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
            s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
            ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) (𝓝[>] (0 : ℝ))
        (𝓝 (∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
          ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
          ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)))) :=
by
  classical
  
  have hη0 : ∀ x : ℝ, x ≤ 0 → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMin.deriv_eq_zero
    show ∀ᶠ y in 𝓝 x, Real.smoothTransition x ≤ Real.smoothTransition y
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.zero_of_nonpos hx]
    exact Real.smoothTransition.nonneg y
  have hη1 : ∀ x : ℝ, 1 ≤ x → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMax.deriv_eq_zero
    show ∀ᶠ y in 𝓝 x, Real.smoothTransition y ≤ Real.smoothTransition x
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.one_of_one_le hx]
    exact Real.smoothTransition.le_one y
  
  obtain ⟨s₂, hs₂, hind₂⟩ := indep_collar_localization f b O hO hf hb Kc hKc hKO hind
  set K₁ : Set E3 := Kc ∩ {y | |b y| ≤ s₂} with hK₁def
  have hK₁ : IsCompact K₁ := by
    have hcl : IsClosed K₁ :=
      (continuous_abs.comp_continuousOn (hb.continuousOn.mono hKO)).preimage_isClosed_of_isClosed
        hKc.isClosed (isClosed_Iic (a := s₂))
    exact hKc.of_isClosed_subset hcl Set.inter_subset_left
  
  have hbox := fun (y : E3) (hy : y ∈ K₁) =>
    flow_box_chart f b O hO hf hb y (hKO hy.1) (hind₂ y hy.1 hy.2)
  choose! kk δδ LL UU PP hδ hUo hyU hUO hPs hPV hPU using hbox
  
  have hball : ∀ y ∈ K₁, ∃ r : ℝ, 0 < r ∧ Metric.closedBall y r ⊆ UU y := by
    intro y hy
    obtain ⟨ε, hε, hεs⟩ := Metric.isOpen_iff.mp (hUo y hy) y (hyU y hy)
    exact ⟨ε / 2, half_pos hε, (Metric.closedBall_subset_ball (half_lt_self hε)).trans hεs⟩
  choose! r hr hrU using hball
  obtain ⟨T, hTK, hcover⟩ := hK₁.elim_nhds_subcover (fun y => Metric.ball y (r y))
    (fun y hy => Metric.ball_mem_nhds y (hr y hy))
  obtain ⟨ρ, hρ⟩ := PartitionOfUnity.exists_isSubordinate hK₁.isClosed
    (fun i : T => Metric.ball (i : E3) (r i)) (fun i => Metric.isOpen_ball) (by
      intro y hy
      have hy' := hcover hy
      simp only [Set.mem_iUnion] at hy' ⊢
      obtain ⟨x, hx, hyx⟩ := hy'
      exact ⟨⟨x, hx⟩, hyx⟩)
  have hsumone : ∀ y ∈ K₁, ∑ i : T, ρ i y = 1 := by
    intro y hy
    rw [← finsum_eq_sum_of_fintype]
    exact ρ.sum_eq_one hy
  have hψi_sub : ∀ i : T, tsupport (fun y => ρ i y * ψ y) ⊆ Metric.closedBall (i : E3) (r i) :=
    fun i => tsupport_mul_subset_left.trans ((hρ i).trans Metric.ball_subset_closedBall)
  
  have hres := fun i : T => box_trace_limit f b O hO hf hb (kk (i : E3)) (f (i : E3))
    (b (i : E3)) ((i : E3) (kk (i : E3))) (δδ (i : E3)) (LL (i : E3)) (hδ (i : E3) (hTK _ i.2))
    (UU (i : E3)) (hUo (i : E3) (hTK _ i.2)) (hUO (i : E3) (hTK _ i.2)) (PP (i : E3))
    (hPs (i : E3) (hTK _ i.2)) (hPV (i : E3) (hTK _ i.2)) (hPU (i : E3) (hTK _ i.2))
    (fun y => ρ i y * ψ y) ((ρ i).continuous.mul hψ)
    ((isCompact_closedBall _ _).of_isClosed_subset (isClosed_tsupport _) (hψi_sub i))
    ((hψi_sub i).trans (hrU (i : E3) (hTK _ i.2)))
  choose CC hCC using hres
  
  have hcol : ∀ s : ℝ, 0 < s → s < s₂ → ∀ y : E3,
      s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y =
        ∑ i : T, s⁻¹ * deriv Real.smoothTransition (b y / s) * (ρ i y * ψ y) := by
    intro s hs hss y
    have hsum : ∑ i : T, s⁻¹ * deriv Real.smoothTransition (b y / s) * (ρ i y * ψ y) =
        s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y * ∑ i : T, ρ i y := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    rw [hsum]
    by_cases hyK : y ∈ K₁
    · rw [hsumone y hyK, mul_one]
    · by_cases hyc : y ∈ Kc
      · have hb' : s₂ < |b y| := lt_of_not_ge (fun h => hyK ⟨hyc, h⟩)
        have hd : deriv Real.smoothTransition (b y / s) = 0 := by
          rcases le_or_gt (b y) 0 with h | h
          · apply hη0
            rw [div_le_iff₀ hs]
            simpa using h
          · apply hη1
            rw [abs_of_pos h] at hb'
            rw [le_div_iff₀ hs]
            linarith
        simp [hd]
      · simp [hψK y hyc]
  have hedge : ∀ y : E3, b y = 0 →
      ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)) =
        ∑ i : T, ρ i y * ψ y *
          (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2)) := by
    intro y hy0
    rw [← Finset.sum_mul, ← Finset.sum_mul]
    by_cases hyc : y ∈ Kc
    · have hyK : y ∈ K₁ := ⟨hyc, by show |b y| ≤ s₂; rw [hy0, abs_zero]; exact hs₂.le⟩
      rw [hsumone y hyK, one_mul]
    · simp [hψK y hyc]
  
  have hΓm : ∀ t : ℝ, MeasurableSet {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} := by
    intro t
    have h1 : IsOpen (O ∩ f ⁻¹' {t}ᶜ) :=
      hf.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have h2 : IsOpen (O ∩ b ⁻¹' {0}ᶜ) :=
      hb.continuousOn.isOpen_inter_preimage hO isOpen_compl_singleton
    have heq : {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0} =
        O \ ((O ∩ f ⁻¹' {t}ᶜ) ∪ (O ∩ b ⁻¹' {0}ᶜ)) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_union, Set.mem_inter_iff,
        Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
      tauto
    rw [heq]
    exact hO.measurableSet.diff (h1.union h2).measurableSet
  
  have hI : ∀ t s : ℝ, 0 < s → s < s₂ →
      ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
          s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        ∑ i : T, ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
          s⁻¹ * deriv Real.smoothTransition (b y / s) * (ρ i y * ψ y)
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
    intro t s hs hss
    calc _ = ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
          ∑ i : T, s⁻¹ * deriv Real.smoothTransition (b y / s) * (ρ i y * ψ y)
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
            congr 1
            funext y
            exact hcol s hs hss y
      _ = _ := integral_finset_sum _ (fun i _ => ((hCC i t).1 s hs).1)
  have hE : ∀ t : ℝ,
      ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
          ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
          ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) =
        ∑ i : T, ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
          ρ i y * ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
          ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) := by
    intro t
    calc _ = ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
          ∑ i : T, ρ i y * ψ y *
            (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
          ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)) :=
            setIntegral_congr_fun (hΓm t) (fun y hy => hedge y hy.2.2)
      _ = _ := integral_finset_sum _ (fun i _ => (hCC i t).2.1)
  
  refine ⟨s₂, hs₂, ∑ i : T, CC i, ?_, ?_⟩
  · intro t s hs hss
    rw [hI t s hs hss]
    exact (Finset.abs_sum_le_sum_abs _ _).trans
      (Finset.sum_le_sum (fun i _ => ((hCC i t).1 s hs).2))
  · intro t
    rw [hE t]
    have hlim := tendsto_finset_sum (Finset.univ : Finset T) (fun i _ => (hCC i t).2.2)
    refine hlim.congr' ?_
    filter_upwards [Ioo_mem_nhdsGT hs₂] with s hs
    rw [hI t s hs.1 hs.2, Finset.mul_sum]

theorem slice_collar_chart_limit [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hTrace : ∀ (f b : E3 → ℝ) (O : Set E3), IsOpen O →
      ContDiffOn ℝ ∞ f O → ContDiffOn ℝ ∞ b O → ∀ (ψ : E3 → ℝ), Continuous ψ →
      ∀ (Kc : Set E3), IsCompact Kc → Kc ⊆ O → (∀ y, y ∉ Kc → ψ y = 0) →
      (∀ y ∈ Kc, b y = 0 → ∀ a c : ℝ,
        a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0) →
      ∃ s₁ : ℝ, 0 < s₁ ∧ ∃ C : ℝ,
        (∀ t s : ℝ, 0 < s → s < s₁ →
          |∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
            s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
            ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))| ≤ C) ∧
        ∀ t : ℝ, Tendsto (fun s => sbgbAreaConst *
            ∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ 0 ≤ b y},
              s⁻¹ * deriv Real.smoothTransition (b y / s) * ψ y
              ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) (𝓝[>] (0 : ℝ))
          (𝓝 (∫ y in {y : E3 | y ∈ O ∧ f y = t ∧ b y = 0},
            ψ y * (‖fderiv ℝ f y‖ / Real.sqrt (∑ k : Fin 3, sbgbCross f b y k ^ 2))
            ∂(MeasureTheory.Measure.hausdorffMeasure (1 : ℝ)))))
    (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hβr : ∀ p : M, β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (Ω : Set M) (hΩ : IsClosed Ω) (hΩβ : ∀ p ∈ Ω, 0 ≤ β p)
    (Bad : Set M) (hBad : IsClosed Bad) (hΩBad : ∀ p : M, 0 ≤ β p → p ∉ Bad → p ∈ Ω)
    (s₀ : ℝ) (hs₀ : 0 < s₀) (hloc : ∀ p ∈ Ω, β p < s₀ → p ∉ Bad)
    (A : Set ℝ) (hA : IsCompact A)
    (hreg : ∀ p ∈ Ω, u p ∈ A → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0)
    (q : M) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ)
    (hφc : IsCompact (tsupport φ)) (hφs : tsupport φ ⊆ (chartAt E3 q).source) :
    ∃ s₁ : ℝ, 0 < s₁ ∧ ∃ C : ℝ, ∀ t ∈ A,
      (∀ s : ℝ, 0 < s → s < s₁ → |sclCollar g β u q φ Ω t s| ≤ C) ∧
      Tendsto (fun s => sclCollar g β u q φ Ω t s) (𝓝[>] (0 : ℝ))
        (𝓝 (sclEdge g β u q φ Ω t)) :=
by
  classical
  
  have hη' : ∀ x : ℝ, deriv Real.smoothTransition x ≠ 0 → 0 < x ∧ x < 1 := by
    intro x hx
    by_contra hcon
    apply hx
    rcases not_and_or.mp hcon with h | h
    · push_neg at h
      have hmin : ∀ y, Real.smoothTransition x ≤ Real.smoothTransition y := fun y => by
        rw [Real.smoothTransition.zero_of_nonpos h]; exact Real.smoothTransition.nonneg y
      exact IsLocalMin.deriv_eq_zero (Filter.Eventually.of_forall hmin)
    · push_neg at h
      have hmax : ∀ y, Real.smoothTransition y ≤ Real.smoothTransition x := fun y => by
        rw [Real.smoothTransition.one_of_one_le h]; exact Real.smoothTransition.le_one y
      exact IsLocalMax.deriv_eq_zero (Filter.Eventually.of_forall hmax)
  
  have hmeasP : ∀ (V : Set E3) (F : E3 → ℝ) (K : Set ℝ), IsOpen V → ContinuousOn F V →
      IsClosed K → MeasurableSet (V ∩ F ⁻¹' K) := by
    intro V F K hV hF hK
    have h1 : V ∩ F ⁻¹' K = V \ (V ∩ F ⁻¹' Kᶜ) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_preimage, Set.mem_compl_iff]
      tauto
