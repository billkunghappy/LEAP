    exact (lt_of_lt_of_le hpos (h.trans (measure_mono hsub))).ne'
  have hK0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ K) ≠ 0 := by
    intro N hN
    obtain ⟨ε, hε, hεN⟩ := Metric.mem_nhds_iff.1 hN
    have hs : 0 < min ε 1 := lt_min hε one_pos
    have h := (hdK (min ε 1) hs (min_le_right _ _)).1
    have hpos : 0 < ENNReal.ofReal (c₀ * (min ε 1) ^ 3) :=
      ENNReal.ofReal_pos.2 (mul_pos hc₀ (pow_pos hs 3))
    have hsub : K ∩ Metric.ball (0:E3) (min ε 1) ⊆ N ∩ K := fun y hy =>
      ⟨hεN (Metric.ball_subset_ball (min_le_left _ _) hy.2), hy.1⟩
    exact (lt_of_lt_of_le hpos (h.trans (measure_mono hsub))).ne'
  
  have hfmono : Monotone (fun ρ : ℝ =>
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ)) :=
    fun a b hab => hmono _ _ _ _ (Metric.ball_subset_ball hab)
  have hffin : ∀ ρ : ℝ,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ) ≠ ⊤ := by
    intro ρ
    exact ne_top_of_le_ne_top (hKfin (max ρ 1) (lt_of_lt_of_le one_pos (le_max_right _ _))).ne
      (hfmono (le_max_left ρ 1))
  have hae := sepMonotone_ae_rightCont _ hfmono hffin
  refine ⟨ψ, K, hψ, hconvK, hKmin, hK1, hK0, ?_⟩
  filter_upwards [hae] with ρ hρ hρpos
  rw [tendsto_order]
  refine ⟨fun a ha => hlsc _ a ha, fun b hb => ?_⟩
  obtain ⟨ρ', hρρ', hρ'b⟩ := hρ b hb
  have hρ'pos : 0 < ρ' := lt_trans hρpos hρρ'
  exact hUP (Metric.ball 0 ρ) (Metric.ball 0 ρ') K b Metric.isOpen_ball Metric.isOpen_ball
    (by rw [hclb ρ hρpos]; exact isCompact_closedBall _ _)
    (by rw [hclb ρ hρpos]; exact Metric.closedBall_subset_ball hρρ')
    (by rw [hclb ρ' hρ'pos]; exact isCompact_closedBall _ _) hKm
    (by rw [symmDiff_self]; exact Set.empty_subset _) hρ'b

theorem sepMetric_lip_zero (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (h0U : (0 : E3) ∈ U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hI : G 0 = 1) : ∃ ρ C : ℝ, 0 < ρ ∧ 0 ≤ C ∧ Metric.closedBall (0 : E3) ρ ⊆ U ∧ ∀ y ∈ Metric.closedBall (0 : E3) ρ, ∀ i j : Fin 3, |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖y‖ :=
by
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (hU.mem_nhds h0U)
  have hρ : 0 < ε / 2 := half_pos hε
  have hB : Metric.closedBall (0 : E3) (ε / 2) ⊆ U :=
    (Metric.closedBall_subset_ball (half_lt_self hε)).trans hball
  have hbound : ∀ i j : Fin 3, ∃ M : ℝ, ∀ x ∈ Metric.closedBall (0 : E3) (ε / 2),
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ M := by
    intro i j
    have hc : ContinuousOn (fderiv ℝ (fun y => G y i j)) U :=
      (hG i j).continuousOn_fderiv_of_isOpen hU (by simp)
    exact (isCompact_closedBall (0 : E3) (ε / 2)).exists_bound_of_continuousOn (hc.mono hB)
  choose M hM using hbound
  set C : ℝ := ∑ i : Fin 3, ∑ j : Fin 3, max (M i j) 0 with hCdef
  have hC : 0 ≤ C :=
    Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => le_max_right _ _))
  have hMC : ∀ i j : Fin 3, M i j ≤ C := by
    intro i j
    calc M i j ≤ max (M i j) 0 := le_max_left _ _
      _ ≤ ∑ j' : Fin 3, max (M i j') 0 :=
          Finset.single_le_sum (f := fun j' => max (M i j') 0)
            (fun j' _ => le_max_right _ _) (Finset.mem_univ j)
      _ ≤ C :=
          Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, max (M i' j') 0)
            (fun i' _ => Finset.sum_nonneg (fun j' _ => le_max_right _ _)) (Finset.mem_univ i)
  refine ⟨ε / 2, C, hρ, hC, hB, ?_⟩
  intro y hy i j
  have hdiff : ∀ x ∈ Metric.closedBall (0 : E3) (ε / 2),
      DifferentiableAt ℝ (fun y => G y i j) x := by
    intro x hx
    exact ((hG i j).differentiableOn (by simp)).differentiableAt (hU.mem_nhds (hB hx))
  have hmvt := (convex_closedBall (0 : E3) (ε / 2)).norm_image_sub_le_of_norm_fderiv_le
    hdiff (hM i j) (Metric.mem_closedBall_self hρ.le) hy
  rw [sub_zero, Real.norm_eq_abs] at hmvt
  have h0 : G 0 i j = if i = j then (1 : ℝ) else 0 := by
    rw [hI, Matrix.one_apply]
  rw [← h0]
  exact hmvt.trans (mul_le_mul_of_nonneg_right (hMC i j) (norm_nonneg y))

theorem sepPerMin_euclid_quasiMin (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (ρ C : ℝ) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hmin : sepIsPerMin G F U) (hρ : 0 < ρ) (hC : 0 ≤ C) (hCρ : C * ρ ≤ 1 / 12) (hball : Metric.closedBall (0 : E3) ρ ⊆ U) (hlip : ∀ y ∈ Metric.closedBall (0 : E3) ρ, ∀ i j : Fin 3, |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖y‖) : (∀ t : ℝ, 0 < t → t ≤ ρ → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 t) < ⊤) ∧ ∀ (r r' : ℝ) (F' : Set E3), 0 < r → r < r' → r' ≤ ρ → MeasurableSet F' → symmDiff F F' ⊆ Metric.closedBall 0 r → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 r') ≤ ENNReal.ofReal (((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) ^ 2) * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F' (Metric.ball 0 r') :=
by
  have hcmp : ∀ t : ℝ, 0 < t → t ≤ ρ → ∀ S : Set E3,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (Metric.ball 0 t) ≤
          ENNReal.ofReal ((1 + 4 * (C * t)) / (1 - 4 * (C * t))) * sepPerG G S (Metric.ball 0 t) ∧
        sepPerG G S (Metric.ball 0 t) ≤
          ENNReal.ofReal ((1 + 4 * (C * t)) / (1 - 4 * (C * t))) *
            sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (Metric.ball 0 t) := by
    intro t ht htρ S
    have hBρ : Metric.ball (0:E3) t ⊆ Metric.closedBall 0 ρ :=
      Metric.ball_subset_closedBall.trans (Metric.closedBall_subset_closedBall htρ)
    refine sepPerG_near_id_compare G (Metric.ball 0 t) (C * t) Metric.isOpen_ball
      (fun i j => (hG i j).mono (hBρ.trans hball)) (mul_nonneg hC ht.le) ?_ ?_ S
    · have := mul_le_mul_of_nonneg_left htρ hC
      linarith
    · intro y hy i j
      refine (hlip y (hBρ hy) i j).trans ?_
      rw [mem_ball_zero_iff] at hy
      exact mul_le_mul_of_nonneg_left hy.le hC
  have hclo : ∀ t : ℝ, 0 < t → t ≤ ρ →
      IsCompact (closure (Metric.ball (0:E3) t)) ∧ closure (Metric.ball (0:E3) t) ⊆ U := by
    intro t ht htρ
    rw [closure_ball (0:E3) ht.ne']
    exact ⟨isCompact_closedBall 0 t, (Metric.closedBall_subset_closedBall htρ).trans hball⟩
  refine ⟨fun t ht htρ => ?_, fun r r' F' hr hrr' hr'ρ hF' hsd => ?_⟩
  · have h1 := hmin.2.1 (Metric.ball 0 t) Metric.isOpen_ball (hclo t ht htρ).1 (hclo t ht htρ).2
    exact lt_of_le_of_lt (hcmp t ht htρ F).1 (ENNReal.mul_lt_top ENNReal.ofReal_lt_top h1)
  · have hr' : 0 < r' := hr.trans hrr'
    have h3 := hmin.2.2 F' (Metric.ball 0 r') (Metric.closedBall 0 r) hF' Metric.isOpen_ball
      (hclo r' hr' hr'ρ).1 (hclo r' hr' hr'ρ).2 (isCompact_closedBall 0 r)
      (Metric.closedBall_subset_ball hrr') hsd
    have hCr : C * r' ≤ C * ρ := mul_le_mul_of_nonneg_left hr'ρ hC
    have hCr0 : 0 ≤ C * r' := mul_nonneg hC hr'.le
    have hl0 : 0 ≤ (1 + 4 * (C * r')) / (1 - 4 * (C * r')) :=
      div_nonneg (by linarith) (by linarith)
    calc sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 r')
        ≤ ENNReal.ofReal ((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) *
            sepPerG G F (Metric.ball 0 r') := (hcmp r' hr' hr'ρ F).1
      _ ≤ ENNReal.ofReal ((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) *
            sepPerG G F' (Metric.ball 0 r') := by gcongr
      _ ≤ ENNReal.ofReal ((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) *
            (ENNReal.ofReal ((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) *
              sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F' (Metric.ball 0 r')) := by
          gcongr
          exact (hcmp r' hr' hr'ρ F').2
      _ = ENNReal.ofReal (((1 + 4 * (C * r')) / (1 - 4 * (C * r'))) ^ 2) *
            sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F' (Metric.ball 0 r') := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hl0, sq]

theorem sepPerG_piola_image (Φ : E3 → E3) (hΦ : ContDiff ℝ ∞ Φ) (hinj : Function.Injective Φ) (hdet : ∀ y, 0 < (jacMat Φ y).det) (hprop : ∀ S : Set E3, IsCompact S → IsCompact (Φ ⁻¹' S)) (F V W : Set E3) (hF : MeasurableSet F) (hVW : Φ ⁻¹' V ⊆ W) (M : ℝ) (hM : 0 < M) (hbd : ∀ y ∈ W, ∀ v : Fin 3 → ℝ, ∑ a : Fin 3, (∑ i : Fin 3, (jacMat Φ y).adjugate a i * v i) ^ 2 ≤ M ^ 2 * ∑ i : Fin 3, v i ^ 2) : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (Φ '' F) V ≤ ENNReal.ofReal M * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F W :=
by
  classical
  
  have hq : ∀ v : E3, ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * v i * v j
      = ∑ i : Fin 3, v i ^ 2 := by
    intro v
    simp [Fin.sum_univ_three, Matrix.one_apply] <;> ring
  
  have hdd : ∀ (Z : E3 → E3) (w : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Z w
        = ∑ i : Fin 3, partialDeriv i (fun z => Z z i) w := by
    intro Z w
    simp [sepDensDiv, Matrix.det_one]
  
  have hJ : ∀ i a : Fin 3, ContDiff ℝ ∞ (fun z => jacMat Φ z i a) := by
    intro i a
    have h1 : ContDiff ℝ ∞ (fderiv ℝ Φ) := (contDiff_infty_iff_fderiv.1 hΦ).2
    have h2 : ContDiff ℝ ∞ (fun z => fderiv ℝ Φ z (e a)) := h1.clm_apply contDiff_const
    have h3 := (contDiff_piLp 2).1 h2 i
    simp only [jacMat, Matrix.of_apply]
    exact h3
  
  have hAdj : ∀ a i : Fin 3, ContDiff ℝ ∞ (fun z => (jacMat Φ z).adjugate a i) := by
    have h00 := hJ 0 0
    have h01 := hJ 0 1
    have h02 := hJ 0 2
    have h10 := hJ 1 0
    have h11 := hJ 1 1
    have h12 := hJ 1 2
    have h20 := hJ 2 0
    have h21 := hJ 2 1
    have h22 := hJ 2 2
    intro a i
    simp only [Matrix.adjugate_fin_three]
    fin_cases a <;> fin_cases i <;> simp <;> fun_prop
  
  have hdetEq : ∀ y, (fderiv ℝ Φ y).det = (jacMat Φ y).det := by
    intro y
    show LinearMap.det (fderiv ℝ Φ y : E3 →ₗ[ℝ] E3) = _
    rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
    congr 1
  
  have hcov : ∀ g : E3 → ℝ, ∫ x in Φ '' F, g x = ∫ y in F, (jacMat Φ y).det * g (Φ y) := by
    intro g
    rw [integral_image_eq_integral_abs_det_fderiv_smul volume hF
      (fun y _ => (hΦ.differentiable (by simp) y).hasFDerivAt.hasFDerivWithinAt) hinj.injOn g]
    refine integral_congr_ae (ae_of_all _ (fun y => ?_))
    simp only [smul_eq_mul, hdetEq, abs_of_pos (hdet y)]
  
  unfold sepPerG
  apply iSup₂_le
  intro X hX
  obtain ⟨hXs, hXc, hXV, hX1⟩ := hX
  have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w => X w i) := fun i => (contDiff_piLp 2).1 hXs i
  
  obtain ⟨Y, hYa⟩ : ∃ Y : E3 → E3, ∀ (z : E3) (a : Fin 3),
      Y z a = ∑ i : Fin 3, (jacMat Φ z).adjugate a i * (M⁻¹ * X (Φ z) i) :=
    ⟨fun z => WithLp.toLp 2 (fun a => ∑ i : Fin 3, (jacMat Φ z).adjugate a i * (M⁻¹ * X (Φ z) i)),
      fun z a => rfl⟩
  have hYfun : ∀ a : Fin 3, (fun z => Y z a)
      = fun z => ∑ i : Fin 3, (jacMat Φ z).adjugate a i * (M⁻¹ * X (Φ z) i) :=
    fun a => funext fun z => hYa z a
  have hYs : ContDiff ℝ ∞ Y := by
    refine (contDiff_piLp 2).2 fun a => ?_
    have e1 := hYfun a
    simp only at e1
    rw [e1]
    exact ContDiff.sum fun i _ => (hAdj a i).mul (contDiff_const.mul ((hXi i).comp hΦ))
  have hY0 : ∀ z, X (Φ z) = 0 → Y z = 0 := by
    intro z hz
    ext a
    rw [hYa]
    simp [hz]
  have hsuppY : tsupport Y ⊆ Φ ⁻¹' tsupport X := by
    refine closure_minimal (fun z hz => ?_) ((isClosed_tsupport X).preimage hΦ.continuous)
    by_contra h
    exact hz (hY0 z (image_eq_zero_of_notMem_tsupport h))
  have hYc : HasCompactSupport Y :=
    (hprop _ hXc).of_isClosed_subset (isClosed_tsupport Y) hsuppY
  have hYW : tsupport Y ⊆ W := hsuppY.trans ((Set.preimage_mono hXV).trans hVW)
  have hY1 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * Y y i * Y y j ≤ 1 := by
    intro y
    rw [hq]
    by_cases hy : y ∈ W
    · have hX : ∑ i : Fin 3, X (Φ y) i ^ 2 ≤ 1 := by
        rw [← hq]
        exact hX1 (Φ y)
      have h := hbd y hy (fun i => M⁻¹ * X (Φ y) i)
      have hM2 : M ^ 2 * (M⁻¹) ^ 2 = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hM.ne', one_pow]
      have e2 : ∑ a : Fin 3, Y y a ^ 2 = ∑ a : Fin 3,
          (∑ i : Fin 3, (jacMat Φ y).adjugate a i * (fun i => M⁻¹ * X (Φ y) i) i) ^ 2 := by
        simp only [hYa]
      rw [e2]
      refine h.trans (Eq.trans_le ?_ hX)
      simp only [Fin.sum_univ_three, mul_pow]
      linear_combination (X (Φ y) 0 ^ 2 + X (Φ y) 1 ^ 2 + X (Φ y) 2 ^ 2) * hM2
    · have hX0 : X (Φ y) = 0 := image_eq_zero_of_notMem_tsupport (fun h => hy (hVW (hXV h)))
      rw [hY0 y hX0]
      simp
  
  have hdiv : ∀ y, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y
      = (jacMat Φ y).det * (M⁻¹ * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X (Φ y)) := by
    intro y
    rw [hdd, hdd]
    obtain ⟨hA, hP⟩ := piola_adjugate_div_zero Φ Set.univ isOpen_univ hΦ.contDiffOn y
      (Set.mem_univ y)
    have hW : ∀ i : Fin 3, DifferentiableAt ℝ (fun w => M⁻¹ * X w i) (Φ y) :=
      fun i => ((contDiff_const.mul (hXi i)).differentiable (by simp)) _
    have h : ∑ a : Fin 3, partialDeriv a
        (fun z => ∑ i : Fin 3, (jacMat Φ z).adjugate a i * (M⁻¹ * X (Φ z) i)) y
        = (jacMat Φ y).det * ∑ i : Fin 3, partialDeriv i (fun w => M⁻¹ * X w i) (Φ y) :=
      piola_div_of_null Φ (fun w i => M⁻¹ * X w i) y (hΦ.differentiable (by simp) y) hA hW hP
    rw [Finset.sum_congr rfl (fun a _ => by rw [hYfun a]), h]
    congr 1
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    unfold partialDeriv
    rw [fderiv_const_mul ((hXi i).differentiable (by simp) _), ContinuousLinearMap.smul_apply,
      smul_eq_mul]
  
  have hMinv : M * M⁻¹ = 1 := mul_inv_cancel₀ hM.ne'
  have hint : ∫ x in Φ '' F, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X x
      = M * ∫ y in F, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y := by
    rw [hcov, ← integral_const_mul]
    refine integral_congr_ae (ae_of_all _ (fun y => ?_))
    simp only [hdiv y]
    linear_combination
      (-((jacMat Φ y).det * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X (Φ y))) * hMinv
  rw [hint, ENNReal.ofReal_mul hM.le]
  refine mul_le_mul_left' ?_ _
  exact le_iSup₂_of_le Y ⟨hYs, hYc, hYW, hY1⟩ le_rfl

theorem sepRadial_jac_adj_bound (P : ℝ → ℝ) (hP : ContDiff ℝ ∞ P) (y : E3) : (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y).det = P (‖y‖ ^ 2) * (P (‖y‖ ^ 2) * (P (‖y‖ ^ 2) + 2 * ‖y‖ ^ 2 * deriv P (‖y‖ ^ 2))) ∧ ∀ M : ℝ, P (‖y‖ ^ 2) ^ 2 ≤ M → 0 ≤ P (‖y‖ ^ 2) * (P (‖y‖ ^ 2) + 2 * ‖y‖ ^ 2 * deriv P (‖y‖ ^ 2)) → P (‖y‖ ^ 2) * (P (‖y‖ ^ 2) + 2 * ‖y‖ ^ 2 * deriv P (‖y‖ ^ 2)) ≤ M → ∀ v : Fin 3 → ℝ, ∑ a : Fin 3, (∑ i : Fin 3, (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y).adjugate a i * v i) ^ 2 ≤ M ^ 2 * ∑ i : Fin 3, v i ^ 2 :=
by
  
  have hA : ∀ i a : Fin 3, jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y i a =
      P (‖y‖ ^ 2) * (if i = a then 1 else 0) + 2 * deriv P (‖y‖ ^ 2) * y a * y i := by
    intro i a
    have hN : HasFDerivAt (fun z : E3 => ‖z‖ ^ 2) (2 • innerSL ℝ y) y :=
      (hasStrictFDerivAt_norm_sq y).hasFDerivAt
    have hPd : HasDerivAt P (deriv P (‖y‖ ^ 2)) (‖y‖ ^ 2) :=
      ((hP.differentiable (by simp)) _).hasDerivAt
    have hC : HasFDerivAt (fun z : E3 => P (‖z‖ ^ 2))
        (deriv P (‖y‖ ^ 2) • 2 • innerSL ℝ y) y :=
      hPd.comp_hasFDerivAt y hN
    have hF := hC.smul (hasFDerivAt_id y)
    have hfd : fderiv ℝ (fun z : E3 => P (‖z‖ ^ 2) • z) y = _ := hF.fderiv
    simp only [jacMat, Matrix.of_apply]
    rw [hfd]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply, id,
      PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, EuclideanSpace.single_apply,
      EuclideanSpace.inner_single_right, conj_trivial, nsmul_eq_mul]
    split_ifs <;> push_cast <;> ring
  
  have s2 : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (p d u : ℝ),
      y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 = u →
      (∀ i a : Fin 3, A i a = p * (if i = a then 1 else 0) + 2 * d * y a * y i) →
      A.det = p * (p * (p + 2 * u * d)) ∧ ∀ a i : Fin 3,
        A.adjugate a i = p * (p + 2 * u * d) * (if a = i then 1 else 0)
          - 2 * p * d * y a * y i := by
    intro A p d u hu hA
    subst hu
    constructor
    · rw [Matrix.det_fin_three]
      simp only [hA]
      simp
      ring
    · intro a i
      rw [Matrix.adjugate_fin_three]
      fin_cases a <;> fin_cases i <;> simp [hA] <;> ring
  
  have s3 : ∀ (B : Matrix (Fin 3) (Fin 3) ℝ) (p d u : ℝ),
      y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 = u →
      (∀ a i : Fin 3, B a i = p * (p + 2 * u * d) * (if a = i then 1 else 0)
        - 2 * p * d * y a * y i) →
      ∀ M : ℝ, p ^ 2 ≤ M → 0 ≤ p * (p + 2 * u * d) → p * (p + 2 * u * d) ≤ M →
      ∀ v : Fin 3 → ℝ, ∑ a : Fin 3, (∑ i : Fin 3, B a i * v i) ^ 2 ≤
        M ^ 2 * ∑ i : Fin 3, v i ^ 2 := by
    intro B p d u hu hB M h1 h2 h3 v
    have hrow : ∀ a : Fin 3, ∑ i : Fin 3, B a i * v i =
        p * (p + 2 * u * d) * v a - 2 * p * d * y a * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2) := by
      intro a
      simp only [Fin.sum_univ_three, hB]
      fin_cases a <;> simp <;> ring
    rw [Finset.sum_congr rfl (fun a _ => by rw [hrow a])]
    simp only [Fin.sum_univ_three]
    have hid : (p * (p + 2 * u * d) * v 0
          - 2 * p * d * y 0 * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2)) ^ 2 +
        (p * (p + 2 * u * d) * v 1 - 2 * p * d * y 1 * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2)) ^ 2 +
        (p * (p + 2 * u * d) * v 2 - 2 * p * d * y 2 * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2)) ^ 2
        = (p * (p + 2 * u * d)) ^ 2 * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2) +
          (-4 * p ^ 2 * d * (p + u * d)) * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2) ^ 2 := by
      rw [← hu]; ring
    rw [hid]
    have hkey : (p * (p + 2 * u * d)) ^ 2 + (-4 * p ^ 2 * d * (p + u * d)) * u
        = (p ^ 2) ^ 2 := by ring
    have hV : 0 ≤ v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by positivity
    have hs2 : (y 0 * v 0 + y 1 * v 1 + y 2 * v 2) ^ 2 ≤ u * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2) := by
      rw [← hu]
      nlinarith [sq_nonneg (y 0 * v 1 - y 1 * v 0), sq_nonneg (y 0 * v 2 - y 2 * v 0),
        sq_nonneg (y 1 * v 2 - y 2 * v 1)]
    have hp2 : 0 ≤ p ^ 2 := sq_nonneg p
    have hM2a : (p * (p + 2 * u * d)) ^ 2 ≤ M ^ 2 := pow_le_pow_left₀ h2 h3 2
    have hM2p : (p ^ 2) ^ 2 ≤ M ^ 2 := pow_le_pow_left₀ hp2 h1 2
    rcases le_or_gt (-4 * p ^ 2 * d * (p + u * d)) 0 with hc | hc
    · have h4 : (-4 * p ^ 2 * d * (p + u * d)) * (y 0 * v 0 + y 1 * v 1 + y 2 * v 2) ^ 2 ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg hc (sq_nonneg _)
      have h5 := mul_le_mul_of_nonneg_right hM2a hV
      linarith
    · have h4 := mul_le_mul_of_nonneg_left hs2 hc.le
      have h5 := mul_le_mul_of_nonneg_right hM2p hV
      have h6 : (p * (p + 2 * u * d)) ^ 2 * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2) +
          (-4 * p ^ 2 * d * (p + u * d)) * (u * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2)) =
          (p ^ 2) ^ 2 * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2) := by
        rw [← hkey]; ring
      linarith
  
  have hu : y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 = ‖y‖ ^ 2 := by
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  obtain ⟨hdet, hadj⟩ := s2 (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y) (P (‖y‖ ^ 2))
    (deriv P (‖y‖ ^ 2)) (‖y‖ ^ 2) hu hA
  exact ⟨hdet, fun M h1 h2 h3 v => s3 _ (P (‖y‖ ^ 2)) (deriv P (‖y‖ ^ 2)) (‖y‖ ^ 2) hu hadj
    M h1 h2 h3 v⟩

theorem sepRadial_map_props (P : ℝ → ℝ) (r : ℝ) (hr : 0 ≤ r) (hP : ContDiff ℝ ∞ P) (hPpos : ∀ u, 0 < P u) (hP1 : ∀ u, r ^ 2 ≤ u → P u = 1) (hmono : ∀ u, 0 ≤ u → 0 < P u * (P u + 2 * u * deriv P u)) : ContDiff ℝ ∞ (fun y : E3 => P (‖y‖ ^ 2) • y) ∧ Function.Injective (fun y : E3 => P (‖y‖ ^ 2) • y) ∧ (∀ y : E3, r ≤ ‖y‖ → P (‖y‖ ^ 2) • y = y) ∧ (∀ S : Set E3, IsCompact S → IsCompact ((fun y : E3 => P (‖y‖ ^ 2) • y) ⁻¹' S)) ∧ StrictMonoOn (fun s : ℝ => s * P (s ^ 2)) (Set.Ici 0) ∧ ∀ y : E3, ‖P (‖y‖ ^ 2) • y‖ = ‖y‖ * P (‖y‖ ^ 2) :=
by
  
  have hΦ : ContDiff ℝ ∞ (fun y : E3 => P (‖y‖ ^ 2) • y) :=
    (hP.comp (contDiff_norm_sq ℝ)).smul contDiff_id
  
  have hnorm : ∀ y : E3, ‖P (‖y‖ ^ 2) • y‖ = ‖y‖ * P (‖y‖ ^ 2) := by
    intro y
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (hPpos _), mul_comm]
  
  have hfix : ∀ y : E3, r ≤ ‖y‖ → P (‖y‖ ^ 2) • y = y := by
    intro y hy
    rw [hP1 _ (pow_le_pow_left₀ hr hy 2), one_smul]
  
  have hk : StrictMonoOn (fun s : ℝ => s * P (s ^ 2)) (Set.Ici 0) := by
    apply strictMonoOn_of_deriv_pos (convex_Ici 0)
    · exact (continuous_id.mul (hP.continuous.comp (continuous_pow 2))).continuousOn
    · intro s hs
      rw [interior_Ici] at hs
      have hPd : DifferentiableAt ℝ P (s ^ 2) := hP.differentiable (by simp) (s ^ 2)
      have hsq : HasDerivAt (fun x : ℝ => x ^ 2) (2 * s) s := by
        simpa using hasDerivAt_pow 2 s
      have hc : HasDerivAt (fun x : ℝ => P (x ^ 2)) (deriv P (s ^ 2) * (2 * s)) s :=
        HasDerivAt.comp (h := fun x : ℝ => x ^ 2) s hPd.hasDerivAt hsq
      have hm : HasDerivAt (fun x : ℝ => x * P (x ^ 2))
          (1 * P (s ^ 2) + s * (deriv P (s ^ 2) * (2 * s))) s :=
        (hasDerivAt_id' s).mul hc
      rw [hm.deriv]
      have hpos := hmono (s ^ 2) (sq_nonneg s)
      have hb : 0 < P (s ^ 2) + 2 * s ^ 2 * deriv P (s ^ 2) :=
        pos_of_mul_pos_right hpos (hPpos _).le
      have heq : 1 * P (s ^ 2) + s * (deriv P (s ^ 2) * (2 * s)) =
          P (s ^ 2) + 2 * s ^ 2 * deriv P (s ^ 2) := by ring
      rw [heq]
      exact hb
  
  have hinj : Function.Injective (fun y : E3 => P (‖y‖ ^ 2) • y) := by
    intro y₁ y₂ h
    have h' : P (‖y₁‖ ^ 2) • y₁ = P (‖y₂‖ ^ 2) • y₂ := h
    have hn : ‖y₁‖ * P (‖y₁‖ ^ 2) = ‖y₂‖ * P (‖y₂‖ ^ 2) := by
      rw [← hnorm y₁, ← hnorm y₂, h']
    have hn' : ‖y₁‖ = ‖y₂‖ :=
      hk.injOn (Set.mem_Ici.2 (norm_nonneg y₁)) (Set.mem_Ici.2 (norm_nonneg y₂)) hn
    rw [hn'] at h'
    exact smul_right_injective E3 (hPpos (‖y₂‖ ^ 2)).ne' h'
  
  have hprop : ∀ S : Set E3, IsCompact S →
      IsCompact ((fun y : E3 => P (‖y‖ ^ 2) • y) ⁻¹' S) := by
    intro S hS
    have hcl : IsClosed ((fun y : E3 => P (‖y‖ ^ 2) • y) ⁻¹' S) :=
      hS.isClosed.preimage hΦ.continuous
    have hsub : (fun y : E3 => P (‖y‖ ^ 2) • y) ⁻¹' S ⊆ S ∪ Metric.closedBall 0 r := by
      intro y hy
      rcases le_or_gt r ‖y‖ with h | h
      · left
        have hy' : P (‖y‖ ^ 2) • y ∈ S := hy
        rw [hfix y h] at hy'
        exact hy'
      · right
        exact mem_closedBall_zero_iff.2 h.le
    have hbd : Bornology.IsBounded ((fun y : E3 => P (‖y‖ ^ 2) • y) ⁻¹' S) :=
      (hS.isBounded.union Metric.isBounded_closedBall).subset hsub
    exact Metric.isCompact_of_isClosed_isBounded hcl hbd
  exact ⟨hΦ, hinj, hfix, hprop, hk, hnorm⟩

theorem sepRadialProfile_inv_exists (a b r K : ℝ) (hb : 0 < b) (hba : b < a) (har : a < r) (hK : (r ^ 2 - b ^ 2) / (r ^ 2 - a ^ 2) < K) : ∃ P : ℝ → ℝ, ContDiff ℝ ∞ P ∧ (∀ u, 0 < P u) ∧ (∀ u, u ≤ a ^ 2 → P u = b / a) ∧ (∀ u, u < a ^ 2 → deriv P u = 0) ∧ (∀ u, r ^ 2 ≤ u → P u = 1) ∧ ∀ u, 0 ≤ u → P u ^ 2 ≤ K ∧ 0 < P u * (P u + 2 * u * deriv P u) ∧ P u * (P u + 2 * u * deriv P u) ≤ K :=
by
  
  have hS2 : ∀ (α β c T K : ℝ), α < β → 0 < c → c < 1 → β - α < T → T < K * (β - α) →
      ∃ g : ℝ → ℝ, ContDiff ℝ ∞ g ∧ (∀ u, u ≤ α → g u = c) ∧
      (∀ u, β ≤ u → g u = 1) ∧ (∀ u, 0 < g u ∧ g u ≤ K) ∧ ∫ u in α..β, g u = T := by
    intro α β c T K hαβ hc0 hc1 hLT hTK
    have hL0 : 0 < β - α := by linarith
    have hT0 : 0 < T := by linarith
    have hK0 : 0 < K := by
      by_contra h
      push_neg at h
      nlinarith
    have hK1 : 1 < K := by nlinarith
    have hTKL : T / K < β - α := by rw [div_lt_iff₀ hK0]; linarith
    have hTK0 : 0 < T / K := div_pos hT0 hK0
    have hKTK : K * (T / K) = T := mul_div_cancel₀ T hK0.ne'
    obtain ⟨σ, hσdef⟩ : ∃ σ : ℝ, σ = (β - α - T / K) / 4 := ⟨_, rfl⟩
    have hσ0 : 0 < σ := by rw [hσdef]; linarith
    have hσL : 4 * σ < β - α := by rw [hσdef]; linarith
    
    have hstep : ∀ p q : ℝ, p < q → ∃ τ : ℝ → ℝ, ContDiff ℝ ∞ τ ∧ (∀ u, u ≤ p → τ u = 0) ∧
        (∀ u, q ≤ u → τ u = 1) ∧ (∀ u, 0 ≤ τ u) ∧ (∀ u, τ u ≤ 1) := by
      intro p q hpq
      have hqp : 0 < q - p := by linarith
      refine ⟨fun u => Real.smoothTransition ((u - p) / (q - p)), ?_, ?_, ?_, ?_, ?_⟩
      · exact Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const _)
      · intro u hu
        apply Real.smoothTransition.zero_of_nonpos
        exact div_nonpos_of_nonpos_of_nonneg (by linarith) hqp.le
      · intro u hu
        apply Real.smoothTransition.one_of_one_le
        rw [le_div_iff₀ hqp]
        linarith
      · intro u
        exact Real.smoothTransition.nonneg _
      · intro u
        exact Real.smoothTransition.le_one _
    obtain ⟨τ₁, hτ₁s, hτ₁0, hτ₁1, hτ₁nn, hτ₁le⟩ := hstep α (α + σ) (by linarith)
    obtain ⟨τ₂, hτ₂s, hτ₂0, hτ₂1, hτ₂nn, hτ₂le⟩ := hstep (β - σ) β (by linarith)
    have hτ₁c : Continuous τ₁ := hτ₁s.continuous
    have hτ₂c : Continuous τ₂ := hτ₂s.continuous
    have h21 : ∀ u, τ₂ u ≤ τ₁ u := by
      intro u
      rcases le_or_gt (α + σ) u with h | h
      · rw [hτ₁1 u h]; exact hτ₂le u
      · rw [hτ₂0 u (by linarith)]; exact hτ₁nn u
    
    have hec : Continuous (fun u => c * (1 - τ₁ u) + τ₂ u) := by fun_prop
    have hdc : Continuous (fun u => τ₁ u - τ₂ u) := by fun_prop
    have he01 : ∀ u, 0 ≤ c * (1 - τ₁ u) + τ₂ u ∧ c * (1 - τ₁ u) + τ₂ u ≤ 1 := by
      intro u
      rcases le_or_gt (α + σ) u with h | h
      · rw [hτ₁1 u h]
        constructor
        · nlinarith [hτ₂nn u]
        · nlinarith [hτ₂le u]
      · rw [hτ₂0 u (by linarith)]
        have h1 := hτ₁nn u
        have h2 := hτ₁le u
        constructor
        · nlinarith
        · nlinarith
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = ∫ u in α..β, (c * (1 - τ₁ u) + τ₂ u) := ⟨_, rfl⟩
    obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = ∫ u in α..β, (τ₁ u - τ₂ u) := ⟨_, rfl⟩
    have hA0 : 0 ≤ A := by
      rw [hAdef]
      exact intervalIntegral.integral_nonneg hαβ.le (fun u _ => (he01 u).1)
    have hAL : A ≤ β - α := by
      rw [hAdef]
      have h := intervalIntegral.integral_mono_on hαβ.le
        (hec.intervalIntegrable (μ := volume) α β)
        (intervalIntegrable_const (c := (1 : ℝ))) (fun u _ => (he01 u).2)
      rw [intervalIntegral.integral_const, smul_eq_mul, mul_one] at h
      exact h
    have hBL : β - α - 2 * σ ≤ B := by
      rw [hBdef]
      have hI := fun x y => hdc.intervalIntegrable (μ := volume) x y
      rw [← intervalIntegral.integral_add_adjacent_intervals (hI α (α + σ)) (hI (α + σ) β),
        ← intervalIntegral.integral_add_adjacent_intervals (hI (α + σ) (β - σ)) (hI (β - σ) β)]
      have h1 : 0 ≤ ∫ u in α..(α + σ), (τ₁ u - τ₂ u) :=
        intervalIntegral.integral_nonneg (by linarith) (fun u _ => sub_nonneg.2 (h21 u))
      have h3 : 0 ≤ ∫ u in (β - σ)..β, (τ₁ u - τ₂ u) :=
        intervalIntegral.integral_nonneg (by linarith) (fun u _ => sub_nonneg.2 (h21 u))
      have h2 : ∫ u in (α + σ)..(β - σ), (τ₁ u - τ₂ u) = (β - σ) - (α + σ) := by
        have heq : Set.EqOn (fun u => τ₁ u - τ₂ u) (fun _ => (1 : ℝ))
            (Set.uIcc (α + σ) (β - σ)) := by
          intro u hu
          rw [Set.uIcc_of_le (by linarith)] at hu
          simp only
          rw [hτ₁1 u hu.1, hτ₂0 u hu.2, sub_zero]
        rw [intervalIntegral.integral_congr heq, intervalIntegral.integral_const, smul_eq_mul,
          mul_one]
      rw [h2]
      linarith
    have hB0 : 0 < B := by linarith
    obtain ⟨m, hmdef⟩ : ∃ m : ℝ, m = (T - A) / B := ⟨_, rfl⟩
    have hm0 : 0 < m := by rw [hmdef]; exact div_pos (by linarith) hB0
    have hmB : m * B = T - A := by rw [hmdef]; exact div_mul_cancel₀ _ hB0.ne'
    have hmK : m < K := by
      rw [hmdef, div_lt_iff₀ hB0]
      have h1 : K * (β - α - 2 * σ) ≤ K * B := mul_le_mul_of_nonneg_left hBL hK0.le
      have h2 : K * (β - α - 2 * σ) = (K * (β - α) + T) / 2 := by
        rw [hσdef]
        linear_combination (1 / 2 : ℝ) * hKTK
      linarith
    refine ⟨fun u => c * (1 - τ₁ u) + τ₂ u + m * (τ₁ u - τ₂ u), ?_, ?_, ?_, ?_, ?_⟩
    · have h1 : ContDiff ℝ ∞ (fun _ : ℝ => c) := contDiff_const
      have h2 : ContDiff ℝ ∞ (fun _ : ℝ => m) := contDiff_const
      have h3 : ContDiff ℝ ∞ (fun _ : ℝ => (1 : ℝ)) := contDiff_const
      exact ((h1.mul (h3.sub hτ₁s)).add hτ₂s).add (h2.mul (hτ₁s.sub hτ₂s))
    · intro u hu
      simp only
      rw [hτ₁0 u hu, hτ₂0 u (by linarith)]
      ring
    · intro u hu
      simp only
      rw [hτ₁1 u (by linarith), hτ₂1 u hu]
      ring
    · intro u
      simp only
      have hw0 : 0 ≤ 1 - τ₁ u := sub_nonneg.2 (hτ₁le u)
      have hw1 : 0 ≤ τ₁ u - τ₂ u := sub_nonneg.2 (h21 u)
      have hw2 : 0 ≤ τ₂ u := hτ₂nn u
      have hμc : min c m ≤ c := min_le_left _ _
      have hμm : min c m ≤ m := min_le_right _ _
      have hμ0 : 0 < min c m := lt_min hc0 hm0
      constructor
      · nlinarith [mul_nonneg hw0 (sub_nonneg.2 hμc), mul_nonneg hw1 (sub_nonneg.2 hμm),
          mul_nonneg hw2 (sub_nonneg.2 (show min c m ≤ 1 by linarith))]
      · nlinarith [mul_nonneg hw0 (sub_nonneg.2 (show c ≤ K by linarith)),
          mul_nonneg hw1 (sub_nonneg.2 hmK.le),
          mul_nonneg hw2 (sub_nonneg.2 hK1.le)]
    · rw [intervalIntegral.integral_add (hec.intervalIntegrable α β)
        ((continuous_const.mul hdc).intervalIntegrable α β), intervalIntegral.integral_const_mul,
        ← hAdef, ← hBdef, hmB]
      ring
  
  have hS3 : ∀ (α β c K : ℝ) (g : ℝ → ℝ), 0 < α → ContDiff ℝ ∞ g →
      (∀ u, u ≤ α → g u = c) → (∀ u, β ≤ u → g u = 1) → (∀ u, 0 < g u ∧ g u ≤ K) →
      ∫ u in α..β, g u = β - c * α → ∃ H : ℝ → ℝ, ContDiff ℝ ∞ H ∧
      (∀ u, HasDerivAt H (g u) u) ∧ (∀ u, u ≤ α → H u = c * u) ∧ (∀ u, β ≤ u → H u = u) ∧
      (∀ u, 0 < u → 0 < H u) ∧ (∀ u, 0 ≤ u → H u ≤ K * u) := by
    intro α β c K g hα hg hgc hg1 hgb hint
    have hgC : Continuous g := hg.continuous
    have hI : ∀ x y : ℝ, IntervalIntegrable g volume x y :=
      fun x y => hgC.intervalIntegrable x y
    have hd : ∀ u, HasDerivAt (fun u => ∫ t in (0 : ℝ)..u, g t) (g u) u :=
      fun u => (hgC.integral_hasStrictDerivAt 0 u).hasDerivAt
    have hleft : ∀ u, u ≤ α → ∫ t in (0 : ℝ)..u, g t = c * u := by
      intro u hu
      have heq : Set.EqOn g (fun _ => c) (Set.uIcc 0 u) := by
        intro t ht
        apply hgc
        rcases Set.mem_uIcc.1 ht with h | h
        · linarith [h.2]
        · linarith [h.2]
      rw [intervalIntegral.integral_congr heq, intervalIntegral.integral_const, smul_eq_mul]
      ring
    refine ⟨fun u => ∫ t in (0 : ℝ)..u, g t, ?_, hd, hleft, ?_, ?_, ?_⟩
    · have hder : deriv (fun u => ∫ t in (0 : ℝ)..u, g t) = g := funext fun u => (hd u).deriv
      exact contDiff_infty_iff_deriv.2 ⟨fun u => (hd u).differentiableAt, by rw [hder]; exact hg⟩
    · intro u hu
      simp only
      rw [← intervalIntegral.integral_add_adjacent_intervals (hI 0 α) (hI α u),
        ← intervalIntegral.integral_add_adjacent_intervals (hI α β) (hI β u), hleft α le_rfl,
        hint]
      have heq : Set.EqOn g (fun _ => (1 : ℝ)) (Set.uIcc β u) := by
        intro t ht
        rw [Set.uIcc_of_le hu] at ht
        exact hg1 t ht.1
      rw [intervalIntegral.integral_congr heq, intervalIntegral.integral_const, smul_eq_mul]
      ring
    · intro u hu
      exact intervalIntegral.intervalIntegral_pos_of_pos_on (hI 0 u) (fun x _ => (hgb x).1) hu
    · intro u hu
      have h := intervalIntegral.integral_mono_on hu (hI 0 u) (intervalIntegrable_const (c := K))
        (fun x _ => (hgb x).2)
      rw [intervalIntegral.integral_const, smul_eq_mul] at h
      simp only
      linarith
  
  have hS4 : ∀ (α β c K : ℝ) (H g : ℝ → ℝ), 0 < α → α < β → 0 < c → c ≤ K →
      ContDiff ℝ ∞ H → (∀ u, HasDerivAt H (g u) u) → (∀ u, u ≤ α → H u = c * u) →
      (∀ u, β ≤ u → H u = u) → (∀ u, 0 < u → 0 < H u) → (∀ u, 0 ≤ u → H u ≤ K * u) →
      (∀ u, 0 ≤ u → 0 < g u ∧ g u ≤ K) → ∃ P : ℝ → ℝ, ContDiff ℝ ∞ P ∧ (∀ u, 0 < P u) ∧
      (∀ u, u ≤ α → P u = Real.sqrt c) ∧ (∀ u, u < α → deriv P u = 0) ∧
      (∀ u, β ≤ u → P u = 1) ∧
      ∀ u, 0 ≤ u → P u ^ 2 ≤ K ∧ 0 < P u * (P u + 2 * u * deriv P u) ∧
        P u * (P u + 2 * u * deriv P u) ≤ K := by
    intro α β c K H g hα hαβ hc hcK hH hHd hHc hH1 hHpos hHK hg
    obtain ⟨R, hR0, hRpos, hRs, hRc⟩ : ∃ R : ℝ → ℝ, (∀ t, 0 < t → R t = H t / t) ∧
        (∀ u, 0 < R u) ∧ ContDiff ℝ ∞ R ∧ (∀ u, u ≤ α → R u = c) := by
      have hR0' : ∀ t, 0 < t → (if t ≤ α then c else H t / t) = H t / t := by
        intro t ht
        split_ifs with h
        · rw [hHc t h, mul_div_cancel_right₀ c ht.ne']
        · rfl
      refine ⟨fun u => if u ≤ α then c else H u / u, hR0', ?_, ?_, ?_⟩
      · intro u
        simp only
        split_ifs with h
        · exact hc
        · push_neg at h
          exact div_pos (hHpos u (hα.trans h)) (hα.trans h)
      · rw [contDiff_iff_contDiffAt]
        intro x
        rcases lt_or_ge x α with hx | hx
        · apply (contDiffAt_const (c := c)).congr_of_eventuallyEq
          filter_upwards [Iio_mem_nhds hx] with t ht
          exact if_pos (le_of_lt ht)
        · have hx0 : 0 < x := hα.trans_le hx
          have h1 : ContDiffAt ℝ ∞ (fun t => H t / t) x :=
            hH.contDiffAt.div contDiffAt_id hx0.ne'
          apply h1.congr_of_eventuallyEq
          filter_upwards [Ioi_mem_nhds hx0] with t ht
          exact hR0' t ht
      · intro u hu
        exact if_pos hu
    have hPs : ContDiff ℝ ∞ (fun u => Real.sqrt (R u)) := hRs.sqrt (fun u => (hRpos u).ne')
    have hPsq : ∀ u, Real.sqrt (R u) ^ 2 = R u := fun u => Real.sq_sqrt (hRpos u).le
    have hPd0 : ∀ u, u < α → deriv (fun u => Real.sqrt (R u)) u = 0 := by
      intro u hu
      have hev : (fun u => Real.sqrt (R u)) =ᶠ[𝓝 u] (fun _ => Real.sqrt c) := by
        filter_upwards [Iio_mem_nhds hu] with t ht
        rw [hRc t (le_of_lt ht)]
      rw [hev.deriv_eq, deriv_const]
    have hkey : ∀ u, 0 < u → Real.sqrt (R u) * (Real.sqrt (R u) + 2 * u *
        deriv (fun u => Real.sqrt (R u)) u) = g u := by
      intro u hu
      have hPd : HasDerivAt (fun u => Real.sqrt (R u)) (deriv (fun u => Real.sqrt (R u)) u) u :=
        ((hPs.differentiable (by simp)) u).hasDerivAt
      have h1 := (hasDerivAt_id' u).mul (hPd.pow 2)
      have hev : (fun t => t * Real.sqrt (R t) ^ 2) =ᶠ[𝓝 u] H := by
        filter_upwards [Ioi_mem_nhds hu] with t ht
        rw [hPsq t, hR0 t ht, mul_div_cancel₀ _ (ne_of_gt ht)]
      have h2 : HasDerivAt (fun t => t * Real.sqrt (R t) ^ 2) (g u) u :=
        (hHd u).congr_of_eventuallyEq hev
      have h3 := h1.unique h2
      norm_num at h3
      linear_combination h3
    refine ⟨fun u => Real.sqrt (R u), hPs, fun u => Real.sqrt_pos.2 (hRpos u), ?_, hPd0, ?_, ?_⟩
    · intro u hu
      simp only
      rw [hRc u hu]
    · intro u hu
      simp only
      have hu0 : 0 < u := by linarith
      rw [hR0 u hu0, hH1 u hu, div_self hu0.ne', Real.sqrt_one]
    · intro u hu
      refine ⟨?_, ?_⟩
      · rw [hPsq u]
        rcases le_or_gt u α with h | h
        · rw [hRc u h]; exact hcK
        · have hu0 : 0 < u := hα.trans h
          rw [hR0 u hu0, div_le_iff₀ hu0]
          exact hHK u hu
      · rcases lt_or_ge u α with h | h
        · rw [hPd0 u h, mul_zero, add_zero, ← sq, hPsq u, hRc u h.le]
          exact ⟨hc, hcK⟩
        · rw [hkey u (hα.trans_le h)]
          exact hg u hu
  
  have ha : 0 < a := hb.trans hba
  have hα : 0 < a ^ 2 := pow_pos ha 2
  have hαβ : a ^ 2 < r ^ 2 := by nlinarith
  have hab : 0 < b / a := div_pos hb ha
  have hab1 : b / a < 1 := (div_lt_one ha).2 hba
  have hc0 : 0 < (b / a) ^ 2 := by positivity
  have hc1 : (b / a) ^ 2 < 1 := by nlinarith
  have hcα : (b / a) ^ 2 * a ^ 2 = b ^ 2 := by
    rw [div_pow, div_mul_cancel₀ _ (pow_ne_zero 2 ha.ne')]
  have hLT : r ^ 2 - a ^ 2 < r ^ 2 - b ^ 2 := by nlinarith
  have hTK : r ^ 2 - b ^ 2 < K * (r ^ 2 - a ^ 2) := by
    rwa [div_lt_iff₀ (by linarith)] at hK
  have hK1 : 1 < K := by nlinarith
  obtain ⟨g, hg, hgc, hg1, hgb, hgint⟩ :=
    hS2 (a ^ 2) (r ^ 2) ((b / a) ^ 2) (r ^ 2 - b ^ 2) K hαβ hc0 hc1 hLT hTK
  have hgint' : ∫ u in a ^ 2..r ^ 2, g u = r ^ 2 - (b / a) ^ 2 * a ^ 2 := by
    rw [hgint, hcα]
  obtain ⟨H, hH, hHd, hHc, hH1, hHpos, hHK⟩ :=
    hS3 (a ^ 2) (r ^ 2) ((b / a) ^ 2) K g hα hg hgc hg1 hgb hgint'
  obtain ⟨P, hPs, hPpos, hPc, hPd0, hP1, hPb⟩ :=
    hS4 (a ^ 2) (r ^ 2) ((b / a) ^ 2) K H g hα hαβ hc0 (by linarith) hH hHd hHc hH1 hHpos hHK
      (fun u _ => hgb u)
  refine ⟨P, hPs, hPpos, ?_, hPd0, hP1, hPb⟩
  intro u hu
  rw [hPc u hu, Real.sqrt_sq hab.le]

theorem sepCone_competitor_bound (F : Set E3) (hF : MeasurableSet F) (a b r r' K κ : ℝ) (hb : 0 < b) (hba : b < a) (har : a < r) (hrr' : r < r') (hκ0 : 0 < κ) (hκ1 : κ < 1) (hK : (r ^ 2 - b ^ 2) / (r ^ 2 - a ^ 2) < K) : ∃ F' : Set E3, MeasurableSet F' ∧ symmDiff F F' ⊆ Metric.closedBall 0 r ∧ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F' (Metric.ball 0 r') ≤ ENNReal.ofReal ((b / a) ^ 2) * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 a) + ENNReal.ofReal K * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} :=
by
  
  have ha : 0 < a := hb.trans hba
  have hr0 : 0 < r := ha.trans har
  have hr'0 : 0 < r' := hr0.trans hrr'
  have hKpos : 0 < K := by
    have h1 : 0 < r ^ 2 - b ^ 2 := by nlinarith
    have h2 : 0 < r ^ 2 - a ^ 2 := by nlinarith
    exact lt_trans (div_pos h1 h2) hK
  obtain ⟨P, hPs, hPpos, hPin, hPd0, hP1, hPb⟩ :=
    sepRadialProfile_inv_exists a b r K hb hba har hK
  obtain ⟨hΦs, hinj, hfix, hprop, hk, hnorm⟩ :=
    sepRadial_map_props P r hr0.le hPs hPpos hP1 (fun u hu => (hPb u hu).2.1)
  have hdet : ∀ y : E3, 0 < (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y).det := by
    intro y
    rw [(sepRadial_jac_adj_bound P hPs y).1]
    exact mul_pos (hPpos _) (hPb _ (sq_nonneg _)).2.1
  have hnorm' : ∀ y : E3, ‖(fun z : E3 => P (‖z‖ ^ 2) • z) y‖ = ‖y‖ * P (‖y‖ ^ 2) := hnorm
  have hfix' : ∀ y : E3, r ≤ ‖y‖ → (fun z : E3 => P (‖z‖ ^ 2) • z) y = y := hfix
  
  have hκa0 : 0 ≤ (1 - κ) * a := mul_nonneg (by linarith) ha.le
  have hka : a * P (a ^ 2) = b := by
    rw [hPin _ le_rfl]
    field_simp
  have hkκ : (1 - κ) * a * P (((1 - κ) * a) ^ 2) = (1 - κ) * b := by
    have hle : (1 - κ) * a ≤ a := by nlinarith
    have hsq : ((1 - κ) * a) ^ 2 ≤ a ^ 2 := pow_le_pow_left₀ hκa0 hle 2
    rw [hPin _ hsq]
    field_simp
  have hkr : r * P (r ^ 2) = r := by rw [hP1 _ le_rfl, mul_one]
  have hkr' : r' * P (r' ^ 2) = r' := by
    have hsq : r ^ 2 ≤ r' ^ 2 := pow_le_pow_left₀ hr0.le hrr'.le 2
    rw [hP1 _ hsq, mul_one]
  
  have hF' : MeasurableSet ((fun z : E3 => P (‖z‖ ^ 2) • z) '' F) :=
    hF.image_of_continuousOn_injOn hΦs.continuous.continuousOn hinj.injOn
  have hsd : symmDiff F ((fun z : E3 => P (‖z‖ ^ 2) • z) '' F) ⊆ Metric.closedBall 0 r := by
    intro x hx
    rw [mem_closedBall_zero_iff]
    by_contra hlt
    push_neg at hlt
    rw [Set.mem_symmDiff] at hx
    rcases hx with ⟨hxF, hxF'⟩ | ⟨hxF', hxF⟩
    · exact hxF' ⟨x, hxF, hfix' x hlt.le⟩
    · obtain ⟨y, hyF, hyx⟩ := hxF'
      by_cases hy : r ≤ ‖y‖
      · rw [hfix' y hy] at hyx
        rw [← hyx] at hxF
        exact hxF hyF
      · push_neg at hy
        have h1 := hnorm' y
        rw [hyx] at h1
        have h2 : ‖y‖ * P (‖y‖ ^ 2) < r * P (r ^ 2) :=
          hk (Set.mem_Ici.2 (norm_nonneg y)) (Set.mem_Ici.2 hr0.le) hy
        linarith
  
  have hmonoV : ∀ (S V V' : Set E3), V ⊆ V' →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V' := by
    intro S V V' hVV'
    unfold sepPerG
    apply iSup₂_le
    intro X hX
    exact le_iSup₂_of_le X ⟨hX.1, hX.2.1, hX.2.2.1.trans hVV', hX.2.2.2⟩ le_rfl
  have hcov : Metric.ball (0 : E3) r' ⊆
      Metric.ball 0 b ∪ {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'} := by
    intro x hx
    rw [mem_ball_zero_iff] at hx
    by_cases h : ‖x‖ < b
    · left
      rw [mem_ball_zero_iff]
      exact h
    · right
      push_neg at h
      refine ⟨?_, hx⟩
      nlinarith
  have hAnnOpen : IsOpen {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'} :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have hunion := sepPerG_union_le (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Set.univ
    ((fun z : E3 => P (‖z‖ ^ 2) • z) '' F) (Metric.ball 0 b)
    {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'} isOpen_univ
    (fun i j => contDiffOn_const) (fun y _ => by simp) hF' Metric.isOpen_ball hAnnOpen
    (Set.subset_univ _) (Set.subset_univ _)
  
  have hVWin : (fun z : E3 => P (‖z‖ ^ 2) • z) ⁻¹' Metric.ball 0 b ⊆ Metric.ball 0 a := by
    intro y hy
    have hy' : ‖(fun z : E3 => P (‖z‖ ^ 2) • z) y‖ < b := mem_ball_zero_iff.1 hy
    rw [hnorm' y] at hy'
    rw [mem_ball_zero_iff]
    by_contra hc
    push_neg at hc
    have h : a * P (a ^ 2) ≤ ‖y‖ * P (‖y‖ ^ 2) :=
      hk.monotoneOn (Set.mem_Ici.2 ha.le) (Set.mem_Ici.2 (norm_nonneg y)) hc
    linarith
  have hin : ∀ y ∈ Metric.ball (0 : E3) a, ∀ v : Fin 3 → ℝ,
      ∑ c : Fin 3, (∑ i : Fin 3,
        (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y).adjugate c i * v i) ^ 2 ≤
        ((b / a) ^ 2) ^ 2 * ∑ i : Fin 3, v i ^ 2 := by
    intro y hy v
    rw [mem_ball_zero_iff] at hy
    have hu : ‖y‖ ^ 2 < a ^ 2 := by
      have := norm_nonneg y
      nlinarith
    have h1 : P (‖y‖ ^ 2) = b / a := hPin _ hu.le
    have h2 : deriv P (‖y‖ ^ 2) = 0 := hPd0 _ hu
    have hab : 0 < b / a := div_pos hb ha
    refine (sepRadial_jac_adj_bound P hPs y).2 ((b / a) ^ 2) ?_ ?_ ?_ v
    · exact le_of_eq (by rw [h1])
    · rw [h1, h2]
      positivity
    · rw [h1, h2]
      exact le_of_eq (by ring)
  have hinner := sepPerG_piola_image (fun z : E3 => P (‖z‖ ^ 2) • z) hΦs hinj hdet hprop F
    (Metric.ball 0 b) (Metric.ball 0 a) hF hVWin ((b / a) ^ 2) (by positivity) hin
  
  have hVWout : (fun z : E3 => P (‖z‖ ^ 2) • z) ⁻¹' {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'} ⊆
      {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} := by
    intro y hy
    have hy' : (1 - κ) * b < ‖(fun z : E3 => P (‖z‖ ^ 2) • z) y‖ ∧
        ‖(fun z : E3 => P (‖z‖ ^ 2) • z) y‖ < r' := hy
    rw [hnorm' y] at hy'
    refine ⟨?_, ?_⟩
    · by_contra hc
      push_neg at hc
      have h : ‖y‖ * P (‖y‖ ^ 2) ≤ (1 - κ) * a * P (((1 - κ) * a) ^ 2) :=
        hk.monotoneOn (Set.mem_Ici.2 (norm_nonneg y)) (Set.mem_Ici.2 hκa0) hc
      linarith [hy'.1]
    · by_contra hc
      push_neg at hc
      have h : r' * P (r' ^ 2) ≤ ‖y‖ * P (‖y‖ ^ 2) :=
        hk.monotoneOn (Set.mem_Ici.2 hr'0.le) (Set.mem_Ici.2 (norm_nonneg y)) hc
      linarith [hy'.2]
  have hout : ∀ y ∈ {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}, ∀ v : Fin 3 → ℝ,
      ∑ c : Fin 3, (∑ i : Fin 3,
        (jacMat (fun z : E3 => P (‖z‖ ^ 2) • z) y).adjugate c i * v i) ^ 2 ≤
        K ^ 2 * ∑ i : Fin 3, v i ^ 2 := by
    intro y _ v
    obtain ⟨h1, h2, h3⟩ := hPb (‖y‖ ^ 2) (sq_nonneg _)
    exact (sepRadial_jac_adj_bound P hPs y).2 K h1 h2.le h3 v
  have houter := sepPerG_piola_image (fun z : E3 => P (‖z‖ ^ 2) • z) hΦs hinj hdet hprop F
    {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'} {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} hF
    hVWout K hKpos hout
  
  refine ⟨(fun z : E3 => P (‖z‖ ^ 2) • z) '' F, hF', hsd, ?_⟩
  calc sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        ((fun z : E3 => P (‖z‖ ^ 2) • z) '' F) (Metric.ball 0 r')
      ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        ((fun z : E3 => P (‖z‖ ^ 2) • z) '' F)
        (Metric.ball 0 b ∪ {y : E3 | (1 - κ) * b < ‖y‖ ∧ ‖y‖ < r'}) := hmonoV _ _ _ hcov
    _ ≤ _ := hunion
    _ ≤ _ := add_le_add hinner houter

theorem sepCone_ode_limit (p lam : ℝ → ℝ) (r R d : ℝ) (hr : 0 < r) (hrR : r < R) (hd : HasDerivAt p d r) (hlam : ContinuousAt lam r) (hcmp : ∀ a b r' K κ : ℝ, 0 < b → b < a → a < r → r < r' → r' < R → 0 < κ → κ < 1 → (r ^ 2 - b ^ 2) / (r ^ 2 - a ^ 2) < K → p r ≤ lam r' * ((b / a) ^ 2 * p a + K * (p r' - p ((1 - κ) * a)))) : 2 * p r ≤ lam r * r * d :=
by
  have hr0 : r ≠ 0 := hr.ne'
  have hc0 : 0 < min (r / 3) (min (1 / 2) (R - r)) :=
    lt_min (by linarith) (lt_min (by norm_num) (by linarith))
  
  have hev : ∀ᶠ ε in 𝓝[>] (0:ℝ), p r ≤ lam (r + ε ^ 2) * ((ε / (r - ε)) ^ 2 * p (r - ε) +
      (((r ^ 2 - ε ^ 2) / (2 * r - ε) * ε + ε ^ 3) * slope p r (r + ε ^ 2) +
       (((r ^ 2 - ε ^ 2) / (2 * r - ε) + ε ^ 2) * (1 + ε * r - ε ^ 2)) *
         slope p r ((1 - ε ^ 2) * (r - ε)))) := by
    filter_upwards [Ioo_mem_nhdsGT hc0] with ε hε
    obtain ⟨hε0, hε1⟩ := hε
    have h1 : ε < r / 3 := lt_of_lt_of_le hε1 (min_le_left _ _)
    have h2 : ε < 1 / 2 := lt_of_lt_of_le hε1 ((min_le_right _ _).trans (min_le_left _ _))
    have h3 : ε < R - r := lt_of_lt_of_le hε1 ((min_le_right _ _).trans (min_le_right _ _))
    have hε2 : 0 < ε ^ 2 := by positivity
    have hε2' : ε ^ 2 < ε := by nlinarith
    have key := hcmp (r - ε) ε (r + ε ^ 2) ((r ^ 2 - ε ^ 2) / (r ^ 2 - (r - ε) ^ 2) + ε) (ε ^ 2)
      hε0 (by linarith) (by linarith) (by linarith) (by linarith) hε2 (by nlinarith)
      (lt_add_of_pos_right _ hε0)
    have hpos : 0 < 1 + ε * r - ε ^ 2 := by nlinarith
    have h2r : 2 * r - ε ≠ 0 := by linarith
    have hεne : ε ≠ 0 := hε0.ne'
    have hsplit : ((r ^ 2 - ε ^ 2) / (r ^ 2 - (r - ε) ^ 2) + ε) *
        (p (r + ε ^ 2) - p ((1 - ε ^ 2) * (r - ε))) =
        ((r ^ 2 - ε ^ 2) / (2 * r - ε) * ε + ε ^ 3) * slope p r (r + ε ^ 2) +
        (((r ^ 2 - ε ^ 2) / (2 * r - ε) + ε ^ 2) * (1 + ε * r - ε ^ 2)) *
          slope p r ((1 - ε ^ 2) * (r - ε)) := by
      rw [slope_def_field, slope_def_field]
      have ex : r + ε ^ 2 - r = ε ^ 2 := by ring
      have ey : (1 - ε ^ 2) * (r - ε) - r = -(ε * (1 + ε * r - ε ^ 2)) := by ring
      have hden : r ^ 2 - (r - ε) ^ 2 = ε * (2 * r - ε) := by ring
      rw [ex, ey, hden]
      have hpne : 1 + ε * r - ε ^ 2 ≠ 0 := hpos.ne'
      generalize 1 + ε * r - ε ^ 2 = Q at hpne ⊢
      generalize 2 * r - ε = D at h2r ⊢
      generalize p (r + ε ^ 2) = A
      generalize p ((1 - ε ^ 2) * (r - ε)) = B
      generalize p r = C
      field_simp
      ring
    rw [hsplit] at key
    exact key
  
  have hid : Filter.Tendsto (fun ε : ℝ => ε) (𝓝[>] (0:ℝ)) (𝓝 0) :=
    tendsto_nhdsWithin_of_tendsto_nhds Filter.tendsto_id
  have hS : Filter.Tendsto (slope p r) (𝓝[≠] r) (𝓝 d) := hasDerivAt_iff_tendsto_slope.mp hd
  have hxt : Filter.Tendsto (fun ε : ℝ => r + ε ^ 2) (𝓝[>] (0:ℝ)) (𝓝 r) := by
    simpa using (tendsto_const_nhds (x := r)).add (hid.pow 2)
  have hyt : Filter.Tendsto (fun ε : ℝ => (1 - ε ^ 2) * (r - ε)) (𝓝[>] (0:ℝ)) (𝓝 r) := by
    simpa using ((tendsto_const_nhds (x := (1:ℝ))).sub (hid.pow 2)).mul
      ((tendsto_const_nhds (x := r)).sub hid)
  have hrt : Filter.Tendsto (fun ε : ℝ => r - ε) (𝓝[>] (0:ℝ)) (𝓝 r) := by
    simpa using (tendsto_const_nhds (x := r)).sub hid
  have hgx : Filter.Tendsto (fun ε : ℝ => r + ε ^ 2) (𝓝[>] (0:ℝ)) (𝓝[≠] r) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨hxt, ?_⟩
    filter_upwards [self_mem_nhdsWithin] with ε hε
    have hε' : (0:ℝ) < ε := hε
    have : 0 < ε ^ 2 := by positivity
    exact ne_of_gt (by linarith)
  have hgy : Filter.Tendsto (fun ε : ℝ => (1 - ε ^ 2) * (r - ε)) (𝓝[>] (0:ℝ)) (𝓝[≠] r) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨hyt, ?_⟩
    filter_upwards [Ioo_mem_nhdsGT one_pos] with ε hε
    obtain ⟨hε0, hε1⟩ := hε
    have hpos : 0 < ε * (1 + ε * r - ε ^ 2) := mul_pos hε0 (by nlinarith)
    have ey : (1 - ε ^ 2) * (r - ε) = r - ε * (1 + ε * r - ε ^ 2) := by ring
    show (1 - ε ^ 2) * (r - ε) ≠ r
    rw [ey]
    exact ne_of_lt (by linarith)
  have hSx : Filter.Tendsto (fun ε : ℝ => slope p r (r + ε ^ 2)) (𝓝[>] (0:ℝ)) (𝓝 d) :=
    hS.comp hgx
  have hSy : Filter.Tendsto (fun ε : ℝ => slope p r ((1 - ε ^ 2) * (r - ε))) (𝓝[>] (0:ℝ))
      (𝓝 d) :=
    hS.comp hgy
  have h2r0 : (2:ℝ) * r - 0 ≠ 0 := by simp [hr0]
  have hα : Filter.Tendsto (fun ε : ℝ => (r ^ 2 - ε ^ 2) / (2 * r - ε) * ε + ε ^ 3)
      (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have := ((((tendsto_const_nhds (x := r ^ 2)).sub (hid.pow 2)).div
      ((tendsto_const_nhds (x := 2 * r)).sub hid) h2r0).mul hid).add (hid.pow 3)
    simpa using this
  have hβ : Filter.Tendsto
      (fun ε : ℝ => ((r ^ 2 - ε ^ 2) / (2 * r - ε) + ε ^ 2) * (1 + ε * r - ε ^ 2))
      (𝓝[>] (0:ℝ)) (𝓝 (r / 2)) := by
    have := ((((tendsto_const_nhds (x := r ^ 2)).sub (hid.pow 2)).div
      ((tendsto_const_nhds (x := 2 * r)).sub hid) h2r0).add (hid.pow 2)).mul
      (((tendsto_const_nhds (x := (1:ℝ))).add (hid.mul (tendsto_const_nhds (x := r)))).sub
        (hid.pow 2))
    have e : ((r ^ 2 - 0 ^ 2) / (2 * r - 0) + 0 ^ 2) * (1 + 0 * r - 0 ^ 2) = r / 2 := by
      field_simp
      ring
    rwa [e] at this
  have hq : Filter.Tendsto (fun ε : ℝ => (ε / (r - ε)) ^ 2 * p (r - ε)) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have hr0' : r - 0 ≠ 0 := by simp [hr0]
    have := ((hid.div ((tendsto_const_nhds (x := r)).sub hid) hr0').pow 2).mul
      (hd.continuousAt.tendsto.comp hrt)
    simpa using this
  have hlam' : Filter.Tendsto (fun ε : ℝ => lam (r + ε ^ 2)) (𝓝[>] (0:ℝ)) (𝓝 (lam r)) :=
    hlam.tendsto.comp hxt
  have hlim := hlam'.mul (hq.add ((hα.mul hSx).add (hβ.mul hSy)))
  have hfin := ge_of_tendsto hlim hev
  have e : lam r * (0 + (0 * d + r / 2 * d)) = lam r * r * d / 2 := by ring
  rw [e] at hfin
  linarith

theorem sepMono_log_integrate (m : ℝ → ℝ) (R C : ℝ) (hR : 0 < R) (hC : 0 ≤ C) (hmono : Monotone m) (hnn : ∀ t, 0 ≤ m t) (hder : ∀ t, 0 < t → t < R → ∀ d : ℝ, HasDerivAt m d t → 2 * m t ≤ (1 + C * t) * t * d) : ∀ s t : ℝ, 0 < s → s ≤ t → t < R → Real.exp (2 * C * s) * m s / s ^ 2 ≤ Real.exp (2 * C * t) * m t / t ^ 2 :=
by
  intro s t hs hst htR
  have ht : 0 < t := lt_of_lt_of_le hs hst
  rcases eq_or_lt_of_le (hnn s) with h0 | hms
  · rw [← h0, mul_zero, zero_div]
    exact div_nonneg (mul_nonneg (Real.exp_pos _).le (hnn t)) (sq_nonneg t)
  have hpos : ∀ x, s ≤ x → 0 < m x := fun x hx => lt_of_lt_of_le hms (hmono hx)
  have hmt : 0 < m t := hpos t hst
  have hu : Set.uIcc s t = Set.Icc s t := Set.uIcc_of_le hst
  have hfmono : MonotoneOn (fun u => Real.log (m u)) (Set.uIcc s t) := by
    rw [hu]
    intro u hu' v _ huv
    exact Real.log_le_log (hpos u hu'.1) (hmono huv)
  have hg : ∀ x ∈ Set.uIcc s t,
      HasDerivAt (fun u => 2 * Real.log u - 2 * C * u) ((fun u => 2 * u⁻¹ - 2 * C) x) x := by
    intro x hx
    rw [hu] at hx
    have hx0 : x ≠ 0 := (lt_of_lt_of_le hs hx.1).ne'
    have h := ((Real.hasDerivAt_log hx0).const_mul 2).sub ((hasDerivAt_id x).const_mul (2 * C))
    convert h using 1
    simp
  have hg'c : ContinuousOn (fun u : ℝ => 2 * u⁻¹ - 2 * C) (Set.uIcc s t) := by
    rw [hu]
    apply ContinuousOn.sub _ continuousOn_const
    apply ContinuousOn.mul continuousOn_const
    apply ContinuousOn.inv₀ continuousOn_id
    intro x hx
    exact (lt_of_lt_of_le hs hx.1).ne'
  have hint_g' : IntervalIntegrable (fun u : ℝ => 2 * u⁻¹ - 2 * C) MeasureTheory.volume s t :=
    hg'c.intervalIntegrable
  have hint_f : IntervalIntegrable (deriv (fun u => Real.log (m u))) MeasureTheory.volume s t :=
    hfmono.intervalIntegrable_deriv
  have hFTC : ∫ x in s..t, (fun u : ℝ => 2 * u⁻¹ - 2 * C) x =
      (fun u => 2 * Real.log u - 2 * C * u) t - (fun u => 2 * Real.log u - 2 * C * u) s :=
    intervalIntegral.integral_eq_sub_of_hasDerivAt hg hint_g'
  have hmem := hfmono.intervalIntegral_deriv_mem_uIcc
  have hfst : Real.log (m s) ≤ Real.log (m t) := Real.log_le_log hms (hmono hst)
  rw [Set.uIcc_of_le (sub_nonneg.mpr hfst)] at hmem
  have hae : ∀ᵐ x ∂MeasureTheory.volume, x ∈ Set.Icc s t →
      (fun u : ℝ => 2 * u⁻¹ - 2 * C) x ≤ deriv (fun u => Real.log (m u)) x := by
    filter_upwards [hmono.ae_differentiableAt] with x hx hxI
    have hx0 : 0 < x := lt_of_lt_of_le hs hxI.1
    have hxR : x < R := lt_of_le_of_lt hxI.2 htR
    have hmx : 0 < m x := hpos x hxI.1
    have hd := hx.hasDerivAt
    have hle := hder x hx0 hxR (deriv m x) hd
    have hlog : HasDerivAt (fun u => Real.log (m u)) (deriv m x / m x) x := hd.log hmx.ne'
    rw [hlog.deriv]
    show 2 * x⁻¹ - 2 * C ≤ deriv m x / m x
    rw [le_div_iff₀ hmx]
    have hxP : 0 < x * (1 + C * x) := by positivity
    have hxinv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx0.ne'
    have key : (2 * x⁻¹ - 2 * C) * m x * (x * (1 + C * x)) ≤ deriv m x * (x * (1 + C * x)) := by
      have e : (2 * x⁻¹ - 2 * C) * m x * (x * (1 + C * x)) = (2 - 2 * C ^ 2 * x ^ 2) * m x := by
        linear_combination (2 * m x * (1 + C * x)) * hxinv
      rw [e]
      nlinarith [mul_nonneg (sq_nonneg (C * x)) hmx.le]
    exact le_of_mul_le_mul_right key hxP
  have hcmp : ∫ x in s..t, (fun u : ℝ => 2 * u⁻¹ - 2 * C) x ≤
      ∫ x in s..t, deriv (fun u => Real.log (m u)) x :=
    intervalIntegral.integral_mono_ae_restrict hst hint_g' hint_f
      ((MeasureTheory.ae_restrict_iff' measurableSet_Icc).2 hae)
  have hlog : (2 * Real.log t - 2 * C * t) - (2 * Real.log s - 2 * C * s) ≤
      Real.log (m t) - Real.log (m s) := by
    have := hcmp.trans hmem.2
    rw [hFTC] at this
    simpa using this
  have hX : 0 < Real.exp (2 * C * s) * m s / s ^ 2 := by positivity
  have hY : 0 < Real.exp (2 * C * t) * m t / t ^ 2 := by positivity
  rw [← Real.log_le_log_iff hX hY]
  have hes : 0 < Real.exp (2 * C * s) * m s := by positivity
  have het : 0 < Real.exp (2 * C * t) * m t := by positivity
  rw [Real.log_div hes.ne' (pow_ne_zero 2 hs.ne'), Real.log_div het.ne' (pow_ne_zero 2 ht.ne'),
    Real.log_mul (Real.exp_pos _).ne' hms.ne', Real.log_mul (Real.exp_pos _).ne' hmt.ne',
    Real.log_exp, Real.log_exp, Real.log_pow, Real.log_pow]
  push_cast
  linarith

theorem sepPerMin_monotonicity (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (hU : IsOpen U) (h0U : (0 : E3) ∈ U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef) (hI : G 0 = 1) (hmin : sepIsPerMin G F U) : ∃ Λ r₀ : ℝ, 0 < r₀ ∧ (∀ t : ℝ, 0 < t → t < r₀ → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 t) < ⊤) ∧ ∀ s t : ℝ, 0 < s → s ≤ t → t < r₀ → Real.exp (Λ * s) * (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 s)).toReal / s ^ 2 ≤ Real.exp (Λ * t) * (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 t)).toReal / t ^ 2 :=
by
  classical
  
  obtain ⟨ρ₁, C₁, hρ₁, hC₁, hball₁, hlip₁⟩ := sepMetric_lip_zero G U hU h0U hG hI
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min ρ₁ (1 / (12 * (C₁ + 1))) := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; exact lt_min hρ₁ (by positivity)
  have hρρ₁ : ρ ≤ ρ₁ := by rw [hρdef]; exact min_le_left _ _
  have hball : Metric.closedBall (0 : E3) ρ ⊆ U :=
    (Metric.closedBall_subset_closedBall hρρ₁).trans hball₁
  have hlip : ∀ y ∈ Metric.closedBall (0 : E3) ρ, ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C₁ * ‖y‖ :=
    fun y hy => hlip₁ y (Metric.closedBall_subset_closedBall hρρ₁ hy)
  have hCρ : C₁ * ρ ≤ 1 / 12 := by
    have h1 : ρ ≤ 1 / (12 * (C₁ + 1)) := by rw [hρdef]; exact min_le_right _ _
    have h2 : C₁ * ρ ≤ C₁ * (1 / (12 * (C₁ + 1))) := mul_le_mul_of_nonneg_left h1 hC₁
    have h3 : C₁ * (1 / (12 * (C₁ + 1))) ≤ 1 / 12 := by
      rw [mul_one_div, div_le_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    linarith
  obtain ⟨hfin, hqm⟩ := sepPerMin_euclid_quasiMin G F U ρ C₁ hU hG hmin hρ hC₁ hCρ hball hlip
  
  have hmonoV : ∀ (S V V' : Set E3), V ⊆ V' →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V' := by
    intro S V V' hVV'
    unfold sepPerG
    apply iSup₂_le
    intro X hX
    exact le_iSup₂_of_le X ⟨hX.1, hX.2.1, hX.2.2.1.trans hVV', hX.2.2.2⟩ le_rfl
  obtain ⟨P, hP⟩ : ∃ P : ℝ → ENNReal, ∀ t,
      P t = sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 t) :=
    ⟨_, fun t => rfl⟩
  have hPmono : ∀ s t : ℝ, s ≤ t → P s ≤ P t := by
    intro s t h
    rw [hP, hP]
    exact hmonoV F _ _ (Metric.ball_subset_ball h)
  have hPfin : ∀ t, 0 < t → t ≤ ρ → P t ≠ ⊤ := by
    intro t ht htρ
    rw [hP]
    exact (hfin t ht htρ).ne
  have hPρ : P ρ ≠ ⊤ := hPfin ρ hρ le_rfl
  
  obtain ⟨m, hm⟩ : ∃ m : ℝ → ℝ, ∀ t, m t = (P (min t ρ)).toReal :=
    ⟨fun t => (P (min t ρ)).toReal, fun t => rfl⟩
  have hmmono : Monotone m := by
    intro s t hst
    rw [hm, hm]
    exact ENNReal.toReal_mono (ne_top_of_le_ne_top hPρ (hPmono _ _ (min_le_right _ _)))
      (hPmono _ _ (min_le_min hst le_rfl))
  have hmnn : ∀ t, 0 ≤ m t := fun t => by rw [hm]; exact ENNReal.toReal_nonneg
  have hmeq : ∀ t, t ≤ ρ → m t = (P t).toReal := fun t ht => by rw [hm, min_eq_left ht]
  
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ → ℝ, ∀ t,
      lam t = ((1 + 4 * (C₁ * t)) / (1 - 4 * (C₁ * t))) ^ 2 := ⟨_, fun t => rfl⟩
  have hlam_le : ∀ t, 0 ≤ t → t ≤ ρ → lam t ≤ 1 + 36 * C₁ * t := by
    intro t ht0 htρ
    rw [hlam]
    have hx0 : 0 ≤ 4 * (C₁ * t) := by positivity
    have hCt : C₁ * t ≤ C₁ * ρ := mul_le_mul_of_nonneg_left htρ hC₁
    have hx1 : 4 * (C₁ * t) ≤ 1 / 3 := by linarith
    have hden : 0 < 1 - 4 * (C₁ * t) := by linarith
    have hq : (1 + 4 * (C₁ * t)) / (1 - 4 * (C₁ * t)) ≤ 1 + 3 * (4 * (C₁ * t)) := by
      rw [div_le_iff₀ hden]
      nlinarith
    have hq0 : 0 ≤ (1 + 4 * (C₁ * t)) / (1 - 4 * (C₁ * t)) := div_nonneg (by linarith) hden.le
    have hsq : ((1 + 4 * (C₁ * t)) / (1 - 4 * (C₁ * t))) ^ 2 ≤ (1 + 3 * (4 * (C₁ * t))) ^ 2 := by
      rw [sq, sq]
      exact mul_le_mul hq hq hq0 (by linarith)
    nlinarith
  have hlamc : ∀ t, 0 ≤ t → t ≤ ρ → ContinuousAt lam t := by
    intro t ht0 htρ
    have hfun : lam = fun t => ((1 + 4 * (C₁ * t)) / (1 - 4 * (C₁ * t))) ^ 2 := funext hlam
    rw [hfun]
    have hCt : C₁ * t ≤ C₁ * ρ := mul_le_mul_of_nonneg_left htρ hC₁
    have hden : (1 - 4 * (C₁ * t)) ≠ 0 := ne_of_gt (by linarith)
    have hnum : ContinuousAt (fun t : ℝ => 1 + 4 * (C₁ * t)) t := by fun_prop
    have hdenc : ContinuousAt (fun t : ℝ => 1 - 4 * (C₁ * t)) t := by fun_prop
    exact (hnum.div hdenc hden).pow 2
  
  have hcmp : ∀ r, 0 < r → r < ρ → ∀ a b r' K κ : ℝ, 0 < b → b < a → a < r → r < r' →
      r' < ρ → 0 < κ → κ < 1 → (r ^ 2 - b ^ 2) / (r ^ 2 - a ^ 2) < K →
      m r ≤ lam r' * ((b / a) ^ 2 * m a + K * (m r' - m ((1 - κ) * a))) := by
    intro r hr hrρ a b r' K κ hb hba har hrr' hr'ρ hκ0 hκ1 hK
    obtain ⟨F', hF', hsd, hbd⟩ :=
      sepCone_competitor_bound F hmin.1 a b r r' K κ hb hba har hrr' hκ0 hκ1 hK
    have hqm' := hqm r r' F' hr hrr' hr'ρ.le hF' hsd
    simp only [← hP] at hqm' hbd
    have ha : 0 < a := hb.trans hba
    have hKpos : 0 < K := by
      have h1 : 0 < r ^ 2 - b ^ 2 := by nlinarith
      have h2 : 0 < r ^ 2 - a ^ 2 := by nlinarith
      exact lt_trans (div_pos h1 h2) hK
    have hκa : 0 < (1 - κ) * a := mul_pos (by linarith) ha
    have hκaa : (1 - κ) * a < a := by nlinarith
    have hκa' : (1 - κ) * a < r' := by linarith
    
    have h12 : Disjoint (Metric.ball (0 : E3) ((1 - κ) * a))
        {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} := by
      rw [Set.disjoint_left]
      intro y hy1 hy2
      rw [Metric.mem_ball, dist_zero_right] at hy1
      exact absurd hy2.1 (not_lt.2 hy1.le)
    have hdisj : Pairwise (fun k l : Fin 2 =>
        Disjoint (![Metric.ball (0 : E3) ((1 - κ) * a),
          {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}] k)
          (![Metric.ball (0 : E3) ((1 - κ) * a),
          {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}] l)) := by
      intro k l hkl
      fin_cases k <;> fin_cases l
      · exact absurd rfl hkl
      · exact h12
      · exact h12.symm
      · exact absurd rfl hkl
    have hU2 : (⋃ k, ![Metric.ball (0 : E3) ((1 - κ) * a),
        {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}] k) ⊆ Metric.ball (0 : E3) r' := by
      intro y hy
      rw [Set.mem_iUnion] at hy
      obtain ⟨k, hk⟩ := hy
      fin_cases k
      · have hy1 : y ∈ Metric.ball (0 : E3) ((1 - κ) * a) := hk
        exact Metric.ball_subset_ball hκa'.le hy1
      · have hy2 : y ∈ {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} := hk
        rw [Metric.mem_ball, dist_zero_right]
        exact hy2.2
    have hsum := (sepPerG_sum_le (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F hmin.1 2
      ![Metric.ball (0 : E3) ((1 - κ) * a), {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}]
      hdisj).trans (hmonoV _ _ _ hU2)
    rw [Fin.sum_univ_two] at hsum
    have hsum' : P ((1 - κ) * a) + sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
        {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} ≤ P r' := by
      rw [hP, hP]
      exact hsum
    
    have hA : P a ≠ ⊤ := hPfin a ha (by linarith)
    have hc : P ((1 - κ) * a) ≠ ⊤ := hPfin _ hκa (by linarith)
    have hy : P r' ≠ ⊤ := hPfin r' (by linarith) hr'ρ.le
    have hB : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
        {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} ≠ ⊤ :=
      ne_top_of_le_ne_top hy (le_trans le_add_self hsum')
    have hmain : P r ≤ ENNReal.ofReal (lam r') * (ENNReal.ofReal ((b / a) ^ 2) * P a +
        ENNReal.ofReal K * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
          {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}) := by
      calc P r ≤ P r' := hPmono _ _ hrr'.le
        _ ≤ ENNReal.ofReal (lam r') *
            sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F' (Metric.ball 0 r') := by
          rw [hlam]; exact hqm'
        _ ≤ _ := mul_le_mul_left' hbd _
    have hAm : ENNReal.ofReal ((b / a) ^ 2) * P a ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top hA
    have hBm : ENNReal.ofReal K * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
        {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'} ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top hB
    have hR : ENNReal.ofReal (lam r') * (ENNReal.ofReal ((b / a) ^ 2) * P a +
        ENNReal.ofReal K * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
          {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}) ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.add_ne_top.2 ⟨hAm, hBm⟩)
    have h1 := ENNReal.toReal_mono hR hmain
    have hlam0 : 0 ≤ lam r' := by rw [hlam]; positivity
    rw [ENNReal.toReal_mul, ENNReal.toReal_add hAm hBm, ENNReal.toReal_mul, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal hlam0, ENNReal.toReal_ofReal (by positivity),
      ENNReal.toReal_ofReal hKpos.le] at h1
    have h2 := ENNReal.toReal_mono hy hsum'
    rw [ENNReal.toReal_add hc hB] at h2
    rw [hmeq r hrρ.le, hmeq a (by linarith), hmeq r' hr'ρ.le, hmeq _ (by linarith)]
    calc (P r).toReal ≤ lam r' * ((b / a) ^ 2 * (P a).toReal +
          K * (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
            {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}).toReal) := h1
      _ ≤ lam r' * ((b / a) ^ 2 * (P a).toReal +
          K * ((P r').toReal - (P ((1 - κ) * a)).toReal)) := by
        apply mul_le_mul_of_nonneg_left _ hlam0
        have hBle : (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F
            {y : E3 | (1 - κ) * a < ‖y‖ ∧ ‖y‖ < r'}).toReal ≤
            (P r').toReal - (P ((1 - κ) * a)).toReal := by linarith
        have hKB := mul_le_mul_of_nonneg_left hBle hKpos.le
        linarith
  
  have hder : ∀ t, 0 < t → t < ρ → ∀ d : ℝ, HasDerivAt m d t →
      2 * m t ≤ (1 + 36 * C₁ * t) * t * d := by
    intro r hr hrρ d hd
    have h4 := sepCone_ode_limit m lam r ρ d hr hrρ hd (hlamc r hr.le hrρ.le) (hcmp r hr hrρ)
    have hd0 : 0 ≤ d := by
      have h := hmmono.deriv_nonneg (x := r)
      rwa [hd.deriv] at h
    have hl := hlam_le r hr.le hrρ.le
    have hrd : 0 ≤ r * d := mul_nonneg hr.le hd0
    calc 2 * m r ≤ lam r * r * d := h4
      _ = lam r * (r * d) := by ring
      _ ≤ (1 + 36 * C₁ * r) * (r * d) := mul_le_mul_of_nonneg_right hl hrd
      _ = (1 + 36 * C₁ * r) * r * d := by ring
  refine ⟨2 * (36 * C₁), ρ, hρ, fun t ht htρ => hfin t ht htρ.le, ?_⟩
  intro s t hs hst htρ
  have h5 := sepMono_log_integrate m ρ (36 * C₁) hρ (by positivity) hmmono hmnn hder
    s t hs hst htρ
  rw [hmeq s (by linarith), hmeq t htρ.le, hP, hP] at h5
  exact h5

theorem sepDensityRatio_limit (P : ℝ → ENNReal) (Λ r₀ : ℝ) (hr₀ : 0 < r₀) (hfin : ∀ t : ℝ, 0 < t → t < r₀ → P t < ⊤) (hmono : ∀ s t : ℝ, 0 < s → s ≤ t → t < r₀ → Real.exp (Λ * s) * (P s).toReal / s ^ 2 ≤ Real.exp (Λ * t) * (P t).toReal / t ^ 2) : ∃ Θ₀ : ℝ, 0 ≤ Θ₀ ∧ ∀ (r : ℕ → ℝ), (∀ k, 0 < r k) → Tendsto r atTop (𝓝 0) → ∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => ENNReal.ofReal ((r k)⁻¹ ^ 2) * P (r k * ρ)) atTop (𝓝 (ENNReal.ofReal (Θ₀ * ρ ^ 2))) :=
by
  set f : ℝ → ℝ := fun t => Real.exp (Λ * t) * (P t).toReal / t ^ 2 with hf_def
  have hf0 : ∀ t, 0 ≤ f t := fun t => by
    simp only [hf_def]
    positivity
  have hmon : MonotoneOn f (Set.Ioo 0 r₀) := by
    intro s hs t ht hst
    exact hmono s t hs.1 hst ht.2
  have hne : (Set.Ioo (0:ℝ) r₀).Nonempty := ⟨r₀ / 2, half_pos hr₀, half_lt_self hr₀⟩
  have hbdd : BddBelow (f '' Set.Ioo 0 r₀) := ⟨0, by rintro _ ⟨t, _, rfl⟩; exact hf0 t⟩
  have hlim0 := MonotoneOn.tendsto_nhdsWithin_Ioo_right hne hmon hbdd
  refine ⟨sInf (f '' Set.Ioo 0 r₀), Real.sInf_nonneg (by rintro _ ⟨t, _, rfl⟩; exact hf0 t), ?_⟩
  intro r hrpos hr ρ hρ
  have htpos : ∀ k, 0 < r k * ρ := fun k => mul_pos (hrpos k) hρ
  have ht0 : Tendsto (fun k => r k * ρ) atTop (𝓝 0) := by
    have := hr.mul_const ρ
    rwa [zero_mul] at this
  have htw : Tendsto (fun k => r k * ρ) atTop (𝓝[>] 0) :=
    tendsto_nhdsWithin_iff.2 ⟨ht0, Filter.Eventually.of_forall (fun k => htpos k)⟩
  have hft : Tendsto (fun k => f (r k * ρ)) atTop (𝓝 (sInf (f '' Set.Ioo 0 r₀))) :=
    hlim0.comp htw
  have hev : ∀ᶠ k in atTop, r k * ρ < r₀ := (tendsto_order.1 ht0).2 r₀ hr₀
  have hexp : Tendsto (fun k => Real.exp (-(Λ * (r k * ρ)))) atTop (𝓝 1) := by
    have h1 := ((ht0.const_mul Λ).neg)
    have h2 := (Real.continuous_exp.tendsto _).comp h1
    simpa using h2
  have hreal : Tendsto (fun k => ρ ^ 2 * (Real.exp (-(Λ * (r k * ρ))) * f (r k * ρ))) atTop
      (𝓝 (sInf (f '' Set.Ioo 0 r₀) * ρ ^ 2)) := by
    have h := (hexp.mul hft).const_mul (ρ ^ 2)
    convert h using 2
    ring
  have hen := ENNReal.tendsto_ofReal hreal
  refine hen.congr' ?_
  filter_upwards [hev] with k hk
  have hPne : P (r k * ρ) ≠ ⊤ := (hfin _ (htpos k) hk).ne
  rw [← ENNReal.ofReal_toReal hPne, ← ENNReal.ofReal_mul (sq_nonneg _)]
  congr 1
  have hr0 : r k ≠ 0 := (hrpos k).ne'
  have hρ0 : ρ ≠ 0 := hρ.ne'
  have hE : Real.exp (-(Λ * (r k * ρ))) * Real.exp (Λ * (r k * ρ)) = 1 := by
    rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
  simp only [hf_def]
  calc ρ ^ 2 * (Real.exp (-(Λ * (r k * ρ))) *
        (Real.exp (Λ * (r k * ρ)) * (P (r k * ρ)).toReal / (r k * ρ) ^ 2))
      = ρ ^ 2 * ((Real.exp (-(Λ * (r k * ρ))) * Real.exp (Λ * (r k * ρ))) *
        (P (r k * ρ)).toReal / (r k * ρ) ^ 2) := by ring
    _ = (r k)⁻¹ ^ 2 * (P (r k * ρ)).toReal := by
        rw [hE]
        field_simp

theorem sepPerG_ball_eq_of_ae (K : Set E3) (c : ℝ) (hc : 0 ≤ c) (h : ∀ᵐ ρ ∂(volume : Measure ℝ), 0 < ρ → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ) = ENNReal.ofReal (c * ρ ^ 2)) : ∀ ρ : ℝ, 0 < ρ → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ) = ENNReal.ofReal (c * ρ ^ 2) :=
by
  intro ρ hρ
  set P : ℝ → ENNReal := fun r =>
    sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 r) with hPdef
  set g : ℝ → ENNReal := fun r => ENNReal.ofReal (c * r ^ 2) with hgdef
  show P ρ = g ρ
  have hmono : ∀ r₁ r₂ : ℝ, r₁ ≤ r₂ → P r₁ ≤ P r₂ := by
    intro r₁ r₂ hr
    simp only [hPdef, sepPerG]
    refine iSup_mono fun X => iSup_mono' fun hX => ⟨⟨hX.1, hX.2.1,
      hX.2.2.1.trans (Metric.ball_subset_ball hr), hX.2.2.2⟩, le_rfl⟩
  have hgood : ∀ u v : ℝ, u < v → ∃ x ∈ Set.Ioo u v, 0 < x → P x = g x := by
    intro u v huv
    have hne : (volume : Measure ℝ) (Set.Ioo u v) ≠ 0 := by
      rw [Real.volume_Ioo]
      exact (ENNReal.ofReal_pos.2 (sub_pos.2 huv)).ne'
    exact Measure.exists_mem_of_measure_ne_zero_of_ae hne (ae_restrict_of_ae h)
  have hδ : ∀ n : ℕ, (0 : ℝ) < 1 / ((n : ℝ) + 1) := fun n => by positivity
  have hA : ∀ n : ℕ, ∃ x ∈ Set.Ioo ρ (ρ + 1 / ((n : ℝ) + 1)), 0 < x → P x = g x :=
    fun n => hgood _ _ (by linarith [hδ n])
  have hB : ∀ n : ℕ, ∃ x ∈ Set.Ioo (max (ρ / 2) (ρ - 1 / ((n : ℝ) + 1))) ρ,
      0 < x → P x = g x :=
    fun n => hgood _ _ (max_lt (by linarith) (by linarith [hδ n]))
  choose a ha haP using hA
  choose b hb hbP using hB
  have hapos : ∀ n, 0 < a n := fun n => lt_trans hρ (ha n).1
  have hbpos : ∀ n, 0 < b n := fun n =>
    lt_trans (lt_of_lt_of_le (half_pos hρ) (le_max_left _ _)) (hb n).1
  have hup : ∀ n, P ρ ≤ g (a n) := fun n => by
    rw [← haP n (hapos n)]
    exact hmono _ _ (ha n).1.le
  have hlow : ∀ n, g (b n) ≤ P ρ := fun n => by
    rw [← hbP n (hbpos n)]
    exact hmono _ _ (hb n).2.le
  have hδt : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) Filter.atTop (𝓝 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hplus : Filter.Tendsto (fun n : ℕ => ρ + 1 / ((n : ℝ) + 1)) Filter.atTop (𝓝 ρ) := by
    have := (tendsto_const_nhds (x := ρ)).add hδt
    rwa [add_zero] at this
  have hminus : Filter.Tendsto (fun n : ℕ => ρ - 1 / ((n : ℝ) + 1)) Filter.atTop (𝓝 ρ) := by
    have := (tendsto_const_nhds (x := ρ)).sub hδt
    rwa [sub_zero] at this
  have halim : Filter.Tendsto a Filter.atTop (𝓝 ρ) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hplus
      (fun n => (ha n).1.le) (fun n => (ha n).2.le)
  have hblim : Filter.Tendsto b Filter.atTop (𝓝 ρ) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le hminus tendsto_const_nhds
      (fun n => le_trans (le_max_right _ _) (hb n).1.le) (fun n => (hb n).2.le)
  have hgc : Continuous g :=
    ENNReal.continuous_ofReal.comp (continuous_const.mul (continuous_pow 2))
  have h1 : Filter.Tendsto (fun n => g (a n)) Filter.atTop (𝓝 (g ρ)) :=
    (hgc.tendsto ρ).comp halim
  have h2 : Filter.Tendsto (fun n => g (b n)) Filter.atTop (𝓝 (g ρ)) :=
    (hgc.tendsto ρ).comp hblim
  exact le_antisymm (ge_of_tendsto' h1 hup) (le_of_tendsto' h2 hlow)

theorem sepGG_component_functional (K : Set E3) (hK : MeasurableSet K) (hfin : ∀ r : ℝ, 0 < r → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 r) < ⊤) (i : Fin 3) : (∀ φ ψ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ContDiff ℝ ∞ ψ → HasCompactSupport ψ → ∫ y in K, partialDeriv i (φ + ψ) y = (∫ y in K, partialDeriv i φ y) + ∫ y in K, partialDeriv i ψ y) ∧ (∀ (c : ℝ) (φ : E3 → ℝ), ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ y in K, partialDeriv i (c • φ) y = c * ∫ y in K, partialDeriv i φ y) ∧ (∀ r : ℝ, 0 < r → ∃ C : ℝ, 0 ≤ C ∧ ∀ φ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ Metric.closedBall 0 r → ∀ s : ℝ, (∀ y, |φ y| ≤ s) → |∫ y in K, partialDeriv i φ y| ≤ C * s) :=
by
  have hint : ∀ φ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
      Integrable (fun y => partialDeriv i φ y) := by
    intro φ hφ hφc
    apply Continuous.integrable_of_hasCompactSupport
    · exact (hφ.continuous_fderiv (by simp)).clm_apply continuous_const
    · exact hφc.fderiv_apply ℝ (e i)
  refine ⟨?_, ?_, ?_⟩
  · intro φ ψ hφ hφc hψ hψc
    have hpt : ∀ y, partialDeriv i (φ + ψ) y = partialDeriv i φ y + partialDeriv i ψ y := by
      intro y
      have hdφ : DifferentiableAt ℝ φ y := (hφ.differentiable (by simp)) y
      have hdψ : DifferentiableAt ℝ ψ y := (hψ.differentiable (by simp)) y
      show fderiv ℝ (φ + ψ) y (e i) = _
      rw [fderiv_add hdφ hdψ]
      rfl
    simp only [hpt]
    exact integral_add (hint φ hφ hφc).integrableOn (hint ψ hψ hψc).integrableOn
  · intro c φ hφ hφc
    have hpt : ∀ y, partialDeriv i (c • φ) y = c * partialDeriv i φ y := by
      intro y
      have hd : DifferentiableAt ℝ φ y := (hφ.differentiable (by simp)) y
      show fderiv ℝ (c • φ) y (e i) = _
      rw [fderiv_const_smul hd c]
      rfl
    simp only [hpt]
    exact integral_const_mul c _
  · intro r hr
    have hR : (0 : ℝ) < r + 1 := by linarith
    have hfinR := hfin (r + 1) hR
    refine ⟨(sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 (r + 1))).toReal,
      ENNReal.toReal_nonneg, ?_⟩
    intro φ hφ hφc hsupp s hs
    have hs0 : 0 ≤ s := le_trans (abs_nonneg _) (hs 0)
    have key : ∀ c : ℝ, |c| * s ≤ 1 → c * (∫ y in K, partialDeriv i φ y) ≤
        (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 (r + 1))).toReal := by
      intro c hc
      obtain ⟨Y, hY⟩ : ∃ Y : E3 → E3, Y = fun z => (c * φ z) • e i := ⟨_, rfl⟩
      have hYs : ContDiff ℝ ∞ Y := by
        rw [hY]
        exact (contDiff_const.mul hφ).smul contDiff_const
      have hsuppY : Function.support Y ⊆ Function.support φ := by
        intro z hz h0
        apply hz
        simp [hY, h0]
      have hYcs : HasCompactSupport Y := hφc.mono hsuppY
      have hYt : tsupport Y ⊆ Metric.ball 0 (r + 1) :=
        ((closure_mono hsuppY : tsupport Y ⊆ tsupport φ).trans hsupp).trans
          (Metric.closedBall_subset_ball (by linarith))
      have hYn : ∀ y, ∑ j : Fin 3, ∑ k : Fin 3,
          (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j k * Y y j * Y y k ≤ 1 := by
        intro y
        have hsq : ∑ j : Fin 3, ∑ k : Fin 3,
            (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j k * Y y j * Y y k = ‖Y y‖ ^ 2 := by
          rw [EuclideanSpace.norm_sq_eq]
          simp [Matrix.one_apply, Fin.sum_univ_three, sq]
        have hnorm : ‖Y y‖ = |c| * |φ y| := by
          rw [hY]
          simp only
          rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs, abs_mul]
        have h1 : |c| * |φ y| ≤ 1 :=
          le_trans (mul_le_mul_of_nonneg_left (hs y) (abs_nonneg c)) hc
        have h2 : 0 ≤ |c| * |φ y| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
        rw [hsq, hnorm]
        nlinarith
      have hdiv : ∀ y, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y =
          c * partialDeriv i φ y := by
        intro y
        have hd : DifferentiableAt ℝ φ y := (hφ.differentiable (by simp)) y
        have hj : ∀ j : Fin 3, partialDeriv j (fun z => Y z j) y =
            (if j = i then c else 0) * partialDeriv j φ y := by
          intro j
          have hfun : (fun z => Y z j) = fun z => (if j = i then c else 0) * φ z := by
            funext z
            rw [hY]
            by_cases hji : j = i
            · subst hji
              simp
            · simp [hji, EuclideanSpace.single_apply]
          rw [hfun]
          unfold partialDeriv
          rw [fderiv_const_mul hd]
          rfl
        simp only [sepDensDiv, Matrix.det_one, Real.sqrt_one, one_mul]
        rw [Finset.sum_congr rfl (fun j _ => hj j)]
        simp
      have hint_eq : (∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y) =
          c * ∫ y in K, partialDeriv i φ y := by
        simp only [hdiv]
        exact integral_const_mul c _
      have hle : ENNReal.ofReal (∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y)
          ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 (r + 1)) := by
        unfold sepPerG
        exact le_iSup₂_of_le Y ⟨hYs, hYcs, hYt, hYn⟩ le_rfl
      rw [hint_eq] at hle
      exact (ENNReal.ofReal_le_iff_le_toReal hfinR.ne).1 hle
    rcases hs0.lt_or_eq with hspos | hs0'
    · have hinv : 0 < s⁻¹ := inv_pos.2 hspos
      have h1 := key s⁻¹ (by rw [abs_of_pos hinv, inv_mul_cancel₀ hspos.ne'])
      have h2 := key (-s⁻¹) (by rw [abs_neg, abs_of_pos hinv, inv_mul_cancel₀ hspos.ne'])
      rw [neg_mul] at h2
      have hL : s * (s⁻¹ * (∫ y in K, partialDeriv i φ y)) = ∫ y in K, partialDeriv i φ y := by
        rw [← mul_assoc, mul_inv_cancel₀ hspos.ne', one_mul]
      have h3 := mul_le_mul_of_nonneg_left h1 hspos.le
      have h4 := mul_le_mul_of_nonneg_left h2 hspos.le
      rw [abs_le]
      constructor
      · nlinarith
      · nlinarith
    · have hφ0 : φ = 0 := by
        funext y
        have := hs y
        rw [← hs0'] at this
        exact abs_nonpos_iff.1 this
      subst hφ0
      rw [← hs0']
      simp [partialDeriv]

theorem sepGG_order0_extend (ℓ : (E3 → ℝ) → ℝ) (hadd : ∀ φ ψ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ContDiff ℝ ∞ ψ → HasCompactSupport ψ → ℓ (φ + ψ) = ℓ φ + ℓ ψ) (hsmul : ∀ (c : ℝ) (φ : E3 → ℝ), ContDiff ℝ ∞ φ → HasCompactSupport φ → ℓ (c • φ) = c * ℓ φ) (hbd : ∀ r : ℝ, 0 < r → ∃ C : ℝ, 0 ≤ C ∧ ∀ φ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ Metric.closedBall 0 r → ∀ s : ℝ, (∀ y, |φ y| ≤ s) → |ℓ φ| ≤ C * s) : ∃ Λ : CompactlySupportedContinuousMap E3 ℝ →ₗ[ℝ] ℝ, (∀ f : CompactlySupportedContinuousMap E3 ℝ, ContDiff ℝ ∞ (f : E3 → ℝ) → Λ f = ℓ (f : E3 → ℝ)) ∧ ∀ r : ℝ, 0 < r → ∃ C : ℝ, 0 ≤ C ∧ ∀ f : CompactlySupportedContinuousMap E3 ℝ, tsupport (f : E3 → ℝ) ⊆ Metric.closedBall 0 r → ∀ s : ℝ, (∀ y, |f y| ≤ s) → |Λ f| ≤ C * s :=
by
  
  have hs1 : ∀ (f : E3 → ℝ), Continuous f → HasCompactSupport f → ∀ U : Set E3, IsOpen U →
      tsupport f ⊆ U → ∀ δ : ℝ, 0 < δ → ∃ g : E3 → ℝ, ContDiff ℝ ∞ g ∧ HasCompactSupport g ∧
        tsupport g ⊆ U ∧ ∀ x, |g x - f x| ≤ δ := by
    intro f hf hfc U hU hfU δ hδ
    obtain ⟨ε₀, hε₀, hthick⟩ := hfc.isCompact.exists_thickening_subset_open hU hfU
    obtain ⟨η, hη, hηf⟩ := Metric.uniformContinuous_iff.1
      (hfc.uniformContinuous_of_continuous hf) δ hδ
    have hrO0 : 0 < min (ε₀ / 2) η := lt_min (by linarith) hη
    let ρ : ContDiffBump (0 : E3) :=
      ⟨min (ε₀ / 2) η / 2, min (ε₀ / 2) η, by linarith, by linarith⟩
    refine ⟨convolution (ρ.normed volume) f (ContinuousLinearMap.lsmul ℝ ℝ) volume,
      ?_, ?_, ?_, ?_⟩
    · exact HasCompactSupport.contDiff_convolution_left (𝕜 := ℝ) (n := ⊤) _
        ρ.hasCompactSupport_normed ρ.contDiff_normed hf.locallyIntegrable
    · exact HasCompactSupport.convolution _ ρ.hasCompactSupport_normed hfc
    · have hsupp : Function.support
          (convolution (ρ.normed volume) f (ContinuousLinearMap.lsmul ℝ ℝ) volume) ⊆
            thickening (min (ε₀ / 2) η) (tsupport f) := by
        refine (support_convolution_subset _).trans ?_
        rw [ρ.support_normed_eq]
        intro y hy
        obtain ⟨a, ha, b, hb, rfl⟩ := Set.mem_add.1 hy
        rw [mem_thickening_iff]
        refine ⟨b, subset_tsupport _ hb, ?_⟩
        rw [dist_eq_norm, add_sub_cancel_right]
        have ha' : a ∈ ball (0 : E3) (min (ε₀ / 2) η) := ha
        simpa using ha'
      have hlt : min (ε₀ / 2) η < ε₀ := lt_of_le_of_lt (min_le_left _ _) (by linarith)
      calc tsupport (convolution (ρ.normed volume) f (ContinuousLinearMap.lsmul ℝ ℝ) volume)
          ⊆ closure (thickening (min (ε₀ / 2) η) (tsupport f)) := closure_mono hsupp
        _ ⊆ cthickening (min (ε₀ / 2) η) (tsupport f) :=
            closure_thickening_subset_cthickening _ _
        _ ⊆ thickening ε₀ (tsupport f) := cthickening_subset_thickening' hε₀ hlt _
        _ ⊆ U := hthick
    · intro x
      have h := ContDiffBump.dist_normed_convolution_le (φ := ρ) (μ := volume) (x₀ := x)
        (ε := δ) hf.aestronglyMeasurable (by
          intro y hy
          have hy' : dist y x < min (ε₀ / 2) η := hy
          have : dist y x < η := lt_of_lt_of_le hy' (min_le_right _ _)
          exact (hηf this).le)
      rw [Real.dist_eq] at h
      exact h
  
  have hsub : ∀ a b : E3 → ℝ, ContDiff ℝ ∞ a → HasCompactSupport a → ContDiff ℝ ∞ b →
      HasCompactSupport b → ℓ (a - b) = ℓ a - ℓ b := by
    intro a b ha hac hb hbc
    have hb' : ContDiff ℝ ∞ ((-1 : ℝ) • b) := by rw [neg_one_smul]; exact hb.neg
    have hbc' : HasCompactSupport ((-1 : ℝ) • b) := by rw [neg_one_smul]; exact hbc.neg
    have e1 : a - b = a + (-1 : ℝ) • b := by rw [neg_one_smul, sub_eq_add_neg]
    rw [e1, hadd a _ ha hac hb' hbc', hsmul (-1) b hb hbc]
    ring
  
  have hlip : ∀ R : ℝ, 0 < R → ∃ C : ℝ, 0 ≤ C ∧ ∀ a b : E3 → ℝ, ContDiff ℝ ∞ a →
      HasCompactSupport a → tsupport a ⊆ closedBall 0 R → ContDiff ℝ ∞ b →
      HasCompactSupport b → tsupport b ⊆ closedBall 0 R → ∀ t : ℝ,
      (∀ y, |a y - b y| ≤ t) → |ℓ a - ℓ b| ≤ C * t := by
    intro R hR
    obtain ⟨C, hC0, hC⟩ := hbd R hR
    refine ⟨C, hC0, fun a b ha hac haR hb hbc hbR t ht => ?_⟩
    rw [← hsub a b ha hac hb hbc]
    exact hC (a - b) (ha.sub hb) (hac.sub hbc)
      ((tsupport_sub a b).trans (Set.union_subset haR hbR)) t (fun y => ht y)
  
  have hclose : ∀ (f : E3 → ℝ) (φ ψ : ℕ → E3 → ℝ) (R : ℝ), sepGGApx f φ R → sepGGApx f ψ R →
      ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n m, N ≤ n → N ≤ m → |ℓ (φ n) - ℓ (ψ m)| ≤ ε := by
    intro f φ ψ R hφ hψ ε hε
    obtain ⟨hR, hφs, hφc, hφR, hφf⟩ := hφ
    obtain ⟨-, hψs, hψc, hψR, hψf⟩ := hψ
    obtain ⟨C, hC0, hC⟩ := hlip R hR
    have hC1 : C + 1 ≠ 0 := ne_of_gt (by linarith)
    obtain ⟨η, hη, hηe⟩ : ∃ η : ℝ, 0 < η ∧ 2 * η * (C + 1) = ε :=
      ⟨ε / (2 * (C + 1)), div_pos hε (by linarith), by field_simp⟩
    obtain ⟨N₁, hN₁⟩ := hφf η hη
    obtain ⟨N₂, hN₂⟩ := hψf η hη
    refine ⟨max N₁ N₂, fun n m hn hm => ?_⟩
    have h1 := hC (φ n) (ψ m) (hφs n) (hφc n) (hφR n) (hψs m) (hψc m) (hψR m)
      (2 * η) (fun y => by
        have a1 := hN₁ n (le_trans (le_max_left _ _) hn) y
        have a2 := hN₂ m (le_trans (le_max_right _ _) hm) y
        rw [abs_le] at a1 a2 ⊢
        constructor <;> linarith [a1.1, a1.2, a2.1, a2.2])
    have h2 : C * (2 * η) ≤ 2 * η * (C + 1) := by nlinarith
    linarith
  
  have hs2 : ∀ (f : E3 → ℝ) (φ ψ : ℕ → E3 → ℝ) (R : ℝ), sepGGApx f φ R → sepGGApx f ψ R →
      ∃ L : ℝ, Tendsto (fun n => ℓ (φ n)) atTop (𝓝 L) ∧
        Tendsto (fun n => ℓ (ψ n)) atTop (𝓝 L) := by
    intro f φ ψ R hφ hψ
    have hcs : CauchySeq (fun n => ℓ (φ n)) := by
      rw [Metric.cauchySeq_iff']
      intro ε hε
      obtain ⟨N, hN⟩ := hclose f φ φ R hφ hφ (ε / 2) (by linarith)
      refine ⟨N, fun n hn => ?_⟩
      rw [Real.dist_eq]
      have := hN n N hn le_rfl
      linarith
    obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcs
    refine ⟨L, hL, ?_⟩
    rw [Metric.tendsto_atTop] at hL ⊢
    intro ε hε
    obtain ⟨N₁, hN₁⟩ := hL (ε / 2) (by linarith)
    obtain ⟨N₂, hN₂⟩ := hclose f φ ψ R hφ hψ (ε / 2) (by linarith)
    refine ⟨max N₁ N₂, fun n hn => ?_⟩
    have a1 := hN₁ n (le_trans (le_max_left _ _) hn)
    have a2 := hN₂ n n (le_trans (le_max_right _ _) hn) (le_trans (le_max_right _ _) hn)
    rw [Real.dist_eq] at a1 ⊢
    rw [abs_lt] at a1 ⊢
    rw [abs_le] at a2
    constructor <;> linarith [a1.1, a1.2, a2.1, a2.2]
  
  have hmono : ∀ (f : E3 → ℝ) (φ : ℕ → E3 → ℝ) (R R' : ℝ), sepGGApx f φ R → R ≤ R' →
      sepGGApx f φ R' := by
    intro f φ R R' h hRR'
    obtain ⟨hR, h1, h2, h3, h4⟩ := h
    exact ⟨lt_of_lt_of_le hR hRR', h1, h2,
      fun n => (h3 n).trans (closedBall_subset_closedBall hRR'), h4⟩
  
  have hs3 : ∀ f : CompactlySupportedContinuousMap E3 ℝ, ∃ r : ℝ, 0 < r ∧
      tsupport (f : E3 → ℝ) ⊆ closedBall 0 r := by
    intro f
    obtain ⟨r₀, hr₀⟩ := (isBounded_iff_subset_closedBall (0 : E3)).1
      f.hasCompactSupport.isCompact.isBounded
    exact ⟨max r₀ 1, lt_of_lt_of_le one_pos (le_max_right _ _),
      hr₀.trans (closedBall_subset_closedBall (le_max_left _ _))⟩
  
  have hs4 : ∀ f : CompactlySupportedContinuousMap E3 ℝ, ∀ r : ℝ, 0 < r →
      tsupport (f : E3 → ℝ) ⊆ closedBall 0 r → ∃ A : ℕ → E3 → ℝ,
        sepGGApx (f : E3 → ℝ) A (r + 1) ∧ ∀ n y, |A n y| ≤ |f y| + 1 / ((n : ℝ) + 1) := by
    intro f r hr hfr
    have hfU : tsupport (f : E3 → ℝ) ⊆ ball 0 (r + 1) :=
      hfr.trans (closedBall_subset_ball (by linarith))
    have hex : ∀ n : ℕ, ∃ g : E3 → ℝ, ContDiff ℝ ∞ g ∧ HasCompactSupport g ∧
        tsupport g ⊆ ball 0 (r + 1) ∧ ∀ x, |g x - f x| ≤ 1 / ((n : ℝ) + 1) :=
      fun n => hs1 f f.continuous f.hasCompactSupport _ isOpen_ball hfU _ (by positivity)
    choose A hAs hAc hAU hAf using hex
    refine ⟨A, ⟨by linarith, hAs, hAc, fun n => (hAU n).trans ball_subset_closedBall, ?_⟩, ?_⟩
    · intro ε hε
      obtain ⟨N, hN⟩ := exists_nat_one_div_lt hε
      refine ⟨N, fun n hn y => ?_⟩
      have h1 : 1 / ((n : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) := Nat.one_div_le_one_div hn
      linarith [hAf n y]
    · intro n y
      have h := hAf n y
      rw [abs_le] at h
      exact abs_le.2 ⟨by linarith [neg_abs_le (f y), h.1], by linarith [le_abs_self (f y), h.2]⟩
  
  have hs5 : ∀ f : CompactlySupportedContinuousMap E3 ℝ, ∃ L : ℝ, ∀ (φ : ℕ → E3 → ℝ) (R : ℝ),
      sepGGApx (f : E3 → ℝ) φ R → Tendsto (fun n => ℓ (φ n)) atTop (𝓝 L) := by
    intro f
    obtain ⟨r, hr, hfr⟩ := hs3 f
    obtain ⟨A, hA, -⟩ := hs4 f r hr hfr
    obtain ⟨L, hL, -⟩ := hs2 f A A (r + 1) hA hA
    refine ⟨L, fun φ R hφ => ?_⟩
    obtain ⟨L', h1, h2⟩ := hs2 f A φ (max (r + 1) R)
      (hmono _ _ _ _ hA (le_max_left _ _)) (hmono _ _ _ _ hφ (le_max_right _ _))
    rw [tendsto_nhds_unique hL h1]
    exact h2
  
  choose Λ₀ hΛ₀ using hs5
  
  have hApx_add : ∀ (f g : E3 → ℝ) (φ ψ : ℕ → E3 → ℝ) (R R' : ℝ), sepGGApx f φ R →
      sepGGApx g ψ R' → sepGGApx (f + g) (fun n => φ n + ψ n) (max R R') := by
    intro f g φ ψ R R' hφ hψ
    obtain ⟨hR, hφs, hφc, hφR, hφf⟩ := hφ
    obtain ⟨hR', hψs, hψc, hψR, hψf⟩ := hψ
    refine ⟨lt_of_lt_of_le hR (le_max_left _ _), fun n => (hφs n).add (hψs n),
      fun n => (hφc n).add (hψc n), fun n => ?_, ?_⟩
    · exact (tsupport_add (φ n) (ψ n)).trans (Set.union_subset
        ((hφR n).trans (closedBall_subset_closedBall (le_max_left _ _)))
        ((hψR n).trans (closedBall_subset_closedBall (le_max_right _ _))))
    · intro ε hε
      obtain ⟨N₁, hN₁⟩ := hφf (ε / 2) (by linarith)
      obtain ⟨N₂, hN₂⟩ := hψf (ε / 2) (by linarith)
      refine ⟨max N₁ N₂, fun n hn y => ?_⟩
      have a1 := hN₁ n (le_trans (le_max_left _ _) hn) y
      have a2 := hN₂ n (le_trans (le_max_right _ _) hn) y
      simp only [Pi.add_apply]
      rw [abs_le] at a1 a2 ⊢
      constructor <;> linarith [a1.1, a1.2, a2.1, a2.2]
  have hApx_smul : ∀ (c : ℝ) (f : E3 → ℝ) (φ : ℕ → E3 → ℝ) (R : ℝ), sepGGApx f φ R →
      sepGGApx (c • f) (fun n => c • φ n) R := by
    intro c f φ R hφ
    obtain ⟨hR, hφs, hφc, hφR, hφf⟩ := hφ
    refine ⟨hR, fun n => (hφs n).const_smul c, fun n => (hφc n).smul_left (f := fun _ => c),
      fun n => ((tsupport_smul_subset_right (fun _ => c) (φ n))).trans (hφR n), ?_⟩
    intro ε hε
    have hc1 : 0 < |c| + 1 := by positivity
    obtain ⟨N, hN⟩ := hφf (ε / (|c| + 1)) (div_pos hε hc1)
    refine ⟨N, fun n hn y => ?_⟩
    have a1 := hN n hn y
    have e1 : (fun n => c • φ n) n y - (c • f) y = c * (φ n y - f y) := by
      simp only [Pi.smul_apply, smul_eq_mul]
      ring
    rw [e1, abs_mul]
    calc |c| * |φ n y - f y| ≤ |c| * (ε / (|c| + 1)) :=
          mul_le_mul_of_nonneg_left a1 (abs_nonneg c)
      _ ≤ ε := by
          rw [mul_div_assoc', div_le_iff₀ hc1]
          nlinarith [abs_nonneg c]
  
  have hΛadd : ∀ f g : CompactlySupportedContinuousMap E3 ℝ, Λ₀ (f + g) = Λ₀ f + Λ₀ g := by
    intro f g
    obtain ⟨r₁, hr₁, hf₁⟩ := hs3 f
    obtain ⟨r₂, hr₂, hg₂⟩ := hs3 g
    obtain ⟨A, hA, -⟩ := hs4 f r₁ hr₁ hf₁
    obtain ⟨B, hB, -⟩ := hs4 g r₂ hr₂ hg₂
    have hS := hApx_add _ _ _ _ _ _ hA hB
    rw [← CompactlySupportedContinuousMap.coe_add] at hS
    have h1 := hΛ₀ (f + g) _ _ hS
    have h2 : Tendsto (fun n => ℓ (A n + B n)) atTop (𝓝 (Λ₀ f + Λ₀ g)) := by
      have e : (fun n => ℓ (A n + B n)) = fun n => ℓ (A n) + ℓ (B n) := by
        funext n
        exact hadd _ _ (hA.2.1 n) (hA.2.2.1 n) (hB.2.1 n) (hB.2.2.1 n)
      rw [e]
      exact (hΛ₀ f _ _ hA).add (hΛ₀ g _ _ hB)
    exact tendsto_nhds_unique h1 h2
  
  have hΛsmul : ∀ (c : ℝ) (f : CompactlySupportedContinuousMap E3 ℝ),
      Λ₀ (c • f) = c * Λ₀ f := by
    intro c f
    obtain ⟨r, hr, hfr⟩ := hs3 f
    obtain ⟨A, hA, -⟩ := hs4 f r hr hfr
    have hT := hApx_smul c _ _ _ hA
    rw [← CompactlySupportedContinuousMap.coe_smul] at hT
    have h1 := hΛ₀ (c • f) _ _ hT
    have h2 : Tendsto (fun n => ℓ (c • A n)) atTop (𝓝 (c * Λ₀ f)) := by
      have e : (fun n => ℓ (c • A n)) = fun n => c * ℓ (A n) := by
        funext n
        exact hsmul c _ (hA.2.1 n) (hA.2.2.1 n)
      rw [e]
      exact (hΛ₀ f _ _ hA).const_mul c
    exact tendsto_nhds_unique h1 h2
  
  let Λ : CompactlySupportedContinuousMap E3 ℝ →ₗ[ℝ] ℝ :=
    { toFun := Λ₀
      map_add' := hΛadd
      map_smul' := fun c f => by
        simp only [RingHom.id_apply, smul_eq_mul]
        exact hΛsmul c f }
  refine ⟨Λ, ?_, ?_⟩
  
  · intro f hf
    show Λ₀ f = ℓ (f : E3 → ℝ)
    obtain ⟨r, hr, hfr⟩ := hs3 f
    have hc : sepGGApx (f : E3 → ℝ) (fun _ => (f : E3 → ℝ)) r :=
      ⟨hr, fun _ => hf, fun _ => f.hasCompactSupport, fun _ => hfr,
        fun ε hε => ⟨0, fun n _ y => by simp [hε.le]⟩⟩
    have h1 := hΛ₀ f _ _ hc
    exact tendsto_nhds_unique h1 tendsto_const_nhds
  
  · intro r hr
    obtain ⟨C, hC0, hC⟩ := hbd (r + 1) (by linarith)
    refine ⟨C, hC0, fun f hfr s hs => ?_⟩
    obtain ⟨A, hA, hAb⟩ := hs4 f r hr hfr
    have hle : ∀ n : ℕ, |ℓ (A n)| ≤ C * (s + 1 / ((n : ℝ) + 1)) := by
      intro n
      refine hC (A n) (hA.2.1 n) (hA.2.2.1 n) (hA.2.2.2.1 n) _ (fun y => ?_)
      linarith [hAb n y, hs y]
    have h1 : Tendsto (fun n => |ℓ (A n)|) atTop (𝓝 |Λ₀ f|) := (hΛ₀ f _ _ hA).abs
    have h2 : Tendsto (fun n : ℕ => C * (s + 1 / ((n : ℝ) + 1))) atTop (𝓝 (C * (s + 0))) :=
      (tendsto_one_div_add_atTop_nhds_zero_nat.const_add s).const_mul C
    rw [add_zero] at h2
    show |Λ₀ f| ≤ C * s
    exact le_of_tendsto_of_tendsto' h1 h2 hle

theorem sepGG_riesz_signed (Λ : CompactlySupportedContinuousMap E3 ℝ →ₗ[ℝ] ℝ) (hbd : ∀ r : ℝ, 0 < r → ∃ C : ℝ, 0 ≤ C ∧ ∀ f : CompactlySupportedContinuousMap E3 ℝ, tsupport (f : E3 → ℝ) ⊆ Metric.closedBall 0 r → ∀ s : ℝ, (∀ y, |f y| ≤ s) → |Λ f| ≤ C * s) : ∃ μp μm : Measure E3, (∀ r : ℝ, μp (Metric.ball 0 r) < ⊤) ∧ (∀ r : ℝ, μm (Metric.ball 0 r) < ⊤) ∧ ∀ f : CompactlySupportedContinuousMap E3 ℝ, Λ f = (∫ x, f x ∂μp) - ∫ x, f x ∂μm :=
by
  classical
  
  obtain ⟨S, hS⟩ : ∃ S : CompactlySupportedContinuousMap E3 ℝ → Set ℝ, S = fun f =>
      {t : ℝ | ∃ g : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ g x ∧ g x ≤ f x) ∧ Λ g = t} :=
    ⟨_, rfl⟩
  have hmem : ∀ f t, t ∈ S f ↔
      ∃ g : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ g x ∧ g x ≤ f x) ∧ Λ g = t := by
    intro f t; rw [hS]; rfl
  
  have hbdd : ∀ f, BddAbove (S f) := by
    intro f
    obtain ⟨r₀, hr₀⟩ := (Metric.isBounded_iff_subset_closedBall (0 : E3)).1
      f.hasCompactSupport.isCompact.isBounded
    obtain ⟨C, _, hC⟩ := hbd (max r₀ 1) (lt_of_lt_of_le one_pos (le_max_right _ _))
    obtain ⟨B, hB⟩ := HasCompactSupport.exists_bound_of_continuous f.hasCompactSupport
      (map_continuous f)
    refine ⟨C * B, ?_⟩
    rintro t ht
    rw [hmem] at ht
    obtain ⟨g, hg, rfl⟩ := ht
    have hsupp : tsupport (g : E3 → ℝ) ⊆ Metric.closedBall 0 (max r₀ 1) := by
      refine (closure_mono ?_).trans
        (hr₀.trans (Metric.closedBall_subset_closedBall (le_max_left _ _)))
      intro x hx
      rw [Function.mem_support] at hx ⊢
      intro hfx
      apply hx
      have h := hg x
      rw [hfx] at h
      exact le_antisymm h.2 h.1
    have hgB : ∀ y, |g y| ≤ B := by
      intro y
      rw [abs_of_nonneg (hg y).1]
      have hy := hB y
      rw [Real.norm_eq_abs] at hy
      exact (hg y).2.trans ((le_abs_self _).trans hy)
    exact (le_abs_self _).trans (hC g hsupp B hgB)
  have hzero : ∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → (0 : ℝ) ∈ S f := by
    intro f hf
    rw [hmem]
    exact ⟨0, fun x => by simp [hf x], map_zero Λ⟩
  have hself : ∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → Λ f ∈ S f := by
    intro f hf
    rw [hmem]
    exact ⟨f, fun x => ⟨hf x, le_rfl⟩, rfl⟩
  
  have hadd : ∀ f₁ f₂ : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f₁ x) →
      (∀ x, 0 ≤ f₂ x) → sSup (S (f₁ + f₂)) = sSup (S f₁) + sSup (S f₂) := by
    intro f₁ f₂ h₁ h₂
    have h12 : ∀ x, 0 ≤ (f₁ + f₂) x := fun x => by
      simp only [CompactlySupportedContinuousMap.add_apply]; linarith [h₁ x, h₂ x]
    apply le_antisymm
    · apply csSup_le ⟨0, hzero _ h12⟩
      intro t ht
      rw [hmem] at ht
      obtain ⟨g, hg, rfl⟩ := ht
      have hg1 : Λ (g ⊓ f₁) ∈ S f₁ := by
        rw [hmem]
        refine ⟨g ⊓ f₁, fun x => ?_, rfl⟩
        simp only [CompactlySupportedContinuousMap.inf_apply]
        exact ⟨le_inf (hg x).1 (h₁ x), inf_le_right⟩
      have hg2 : Λ (g - g ⊓ f₁) ∈ S f₂ := by
        rw [hmem]
        refine ⟨g - g ⊓ f₁, fun x => ?_, rfl⟩
        simp only [CompactlySupportedContinuousMap.sub_apply,
          CompactlySupportedContinuousMap.inf_apply]
        obtain ⟨hgx1, hgx2⟩ := hg x
        simp only [CompactlySupportedContinuousMap.add_apply] at hgx2
        have hm : g x ⊓ f₁ x ≤ g x := inf_le_left
        constructor
        · linarith
        · rcases le_total (g x) (f₁ x) with h | h
          · rw [inf_eq_left.2 h]; linarith [h₂ x]
          · rw [inf_eq_right.2 h]; linarith
      have hsplit : Λ g = Λ (g ⊓ f₁) + Λ (g - g ⊓ f₁) := by
        rw [← map_add]; congr 1; abel
      rw [hsplit]
      exact add_le_add (le_csSup (hbdd _) hg1) (le_csSup (hbdd _) hg2)
    · have key : ∀ t₁ ∈ S f₁, ∀ t₂ ∈ S f₂, t₁ + t₂ ≤ sSup (S (f₁ + f₂)) := by
        intro t₁ ht₁ t₂ ht₂
        rw [hmem] at ht₁ ht₂
        obtain ⟨g₁, hg₁, rfl⟩ := ht₁
        obtain ⟨g₂, hg₂, rfl⟩ := ht₂
        apply le_csSup (hbdd _)
        rw [hmem]
        refine ⟨g₁ + g₂, fun x => ?_, map_add Λ g₁ g₂⟩
        simp only [CompactlySupportedContinuousMap.add_apply]
        obtain ⟨a1, a2⟩ := hg₁ x
        obtain ⟨b1, b2⟩ := hg₂ x
        constructor <;> linarith
      have h2 : ∀ t₂ ∈ S f₂, sSup (S f₁) ≤ sSup (S (f₁ + f₂)) - t₂ := by
        intro t₂ ht₂
        apply csSup_le ⟨0, hzero _ h₁⟩
        intro t₁ ht₁
        linarith [key t₁ ht₁ t₂ ht₂]
      have h3 : sSup (S f₂) ≤ sSup (S (f₁ + f₂)) - sSup (S f₁) := by
        apply csSup_le ⟨0, hzero _ h₂⟩
        intro t₂ ht₂
        linarith [h2 t₂ ht₂]
      linarith
  
  have hsmul : ∀ (c : ℝ) (f : CompactlySupportedContinuousMap E3 ℝ), 0 ≤ c →
      sSup (S (c • f)) = c * sSup (S f) := by
    intro c f hc
    rcases hc.lt_or_eq with hc | rfl
    · open scoped Pointwise in
      have hset : S (c • f) = c • S f := by
        ext t
        rw [Set.mem_smul_set, hmem]
        constructor
        · rintro ⟨g, hg, rfl⟩
          refine ⟨Λ (c⁻¹ • g), ?_, ?_⟩
          · rw [hmem]
            refine ⟨c⁻¹ • g, fun x => ?_, rfl⟩
            obtain ⟨h1, h2⟩ := hg x
            simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul] at h1 h2 ⊢
            constructor
            · exact mul_nonneg (inv_nonneg.2 hc.le) h1
            · rw [inv_mul_le_iff₀ hc]; exact h2
          · rw [map_smul, smul_eq_mul, smul_eq_mul, mul_inv_cancel_left₀ hc.ne']
        · rintro ⟨y, hy, rfl⟩
          rw [hmem] at hy
          obtain ⟨g, hg, rfl⟩ := hy
          refine ⟨c • g, fun x => ?_, ?_⟩
          · simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
            obtain ⟨h1, h2⟩ := hg x
            exact ⟨mul_nonneg hc.le h1, mul_le_mul_of_nonneg_left h2 hc.le⟩
          · rw [map_smul]
      rw [hset, Real.sSup_smul_of_nonneg hc.le, smul_eq_mul]
    · have hset : S ((0 : ℝ) • f) = {0} := by
        ext t
        rw [hmem, Set.mem_singleton_iff]
        constructor
        · rintro ⟨g, hg, rfl⟩
          have hg0 : g = 0 := by
            ext x
            have h := hg x
            simp only [zero_smul, CompactlySupportedContinuousMap.zero_apply] at h ⊢
            exact le_antisymm h.2 h.1
          rw [hg0, map_zero]
        · rintro rfl
          exact ⟨0, fun x => by simp, map_zero Λ⟩
      rw [hset, csSup_singleton, zero_mul]
  
  obtain ⟨p, hp⟩ : ∃ p : CompactlySupportedContinuousMap E3 ℝ → ℝ, p = fun f => sSup (S f) :=
    ⟨_, rfl⟩
  have hpadd : ∀ f g : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → (∀ x, 0 ≤ g x) →
      p (f + g) = p f + p g := by
    intro f g hf hg; rw [hp]; exact hadd f g hf hg
  have hpsmul : ∀ (c : ℝ) (f : CompactlySupportedContinuousMap E3 ℝ), 0 ≤ c →
      p (c • f) = c * p f := by
    intro c f hc; rw [hp]; exact hsmul c f hc
  have hp0 : p 0 = 0 := by
    have h := hpsmul 0 0 le_rfl
    rw [zero_smul, zero_mul] at h
    exact h
  have npos : ∀ (f : CompactlySupportedContinuousMap E3 ℝ) x, 0 ≤ (f ⊔ 0) x := by
    intro f x
    simp only [CompactlySupportedContinuousMap.sup_apply, CompactlySupportedContinuousMap.zero_apply]
    exact le_sup_right
  have hdec : ∀ (f : CompactlySupportedContinuousMap E3 ℝ) x, (f ⊔ 0) x - ((-f) ⊔ 0) x = f x := by
    intro f x
    simp only [CompactlySupportedContinuousMap.sup_apply, CompactlySupportedContinuousMap.zero_apply,
      CompactlySupportedContinuousMap.neg_apply]
    rcases le_total 0 (f x) with h | h
    · rw [sup_eq_left.2 h, sup_eq_right.2 (by linarith)]; ring
    · rw [sup_eq_right.2 h, sup_eq_left.2 (by linarith)]; ring
  have K : ∀ f a b : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ a x) → (∀ x, 0 ≤ b x) →
      (∀ x, f x = a x - b x) → p (f ⊔ 0) - p ((-f) ⊔ 0) = p a - p b := by
    intro f a b ha hb hfab
    have e : f ⊔ 0 + b = a + (-f) ⊔ 0 := by
      ext x
      simp only [CompactlySupportedContinuousMap.add_apply]
      linarith [hdec f x, hfab x]
    have h1 := hpadd (f ⊔ 0) b (npos f) hb
    have h2 := hpadd a ((-f) ⊔ 0) ha (npos (-f))
    rw [e] at h1
    linarith
  let P : CompactlySupportedContinuousMap E3 ℝ →ₗ[ℝ] ℝ :=
    { toFun := fun f => p (f ⊔ 0) - p ((-f) ⊔ 0)
      map_add' := by
        intro f g
        show p ((f + g) ⊔ 0) - p ((-(f + g)) ⊔ 0) =
          (p (f ⊔ 0) - p ((-f) ⊔ 0)) + (p (g ⊔ 0) - p ((-g) ⊔ 0))
        rw [K (f + g) (f ⊔ 0 + g ⊔ 0) ((-f) ⊔ 0 + (-g) ⊔ 0)
          (fun x => by
            simp only [CompactlySupportedContinuousMap.add_apply]
            linarith [npos f x, npos g x])
          (fun x => by
            simp only [CompactlySupportedContinuousMap.add_apply]
            linarith [npos (-f) x, npos (-g) x])
          (fun x => by
            simp only [CompactlySupportedContinuousMap.add_apply]
            linarith [hdec f x, hdec g x])]
        rw [hpadd _ _ (npos f) (npos g), hpadd _ _ (npos (-f)) (npos (-g))]
        ring
      map_smul' := by
        intro c f
        show p ((c • f) ⊔ 0) - p ((-(c • f)) ⊔ 0) = c • (p (f ⊔ 0) - p ((-f) ⊔ 0))
        rw [smul_eq_mul]
        rcases le_total 0 c with hc | hc
        · rw [K (c • f) (c • (f ⊔ 0)) (c • ((-f) ⊔ 0))
            (fun x => by
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              exact mul_nonneg hc (npos f x))
            (fun x => by
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              exact mul_nonneg hc (npos (-f) x))
            (fun x => by
              have h := hdec f x
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              linear_combination (-c) * h)]
          rw [hpsmul c _ hc, hpsmul c _ hc]
          ring
        · have hc' : 0 ≤ -c := by linarith
          rw [K (c • f) ((-c) • ((-f) ⊔ 0)) ((-c) • (f ⊔ 0))
            (fun x => by
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              exact mul_nonneg hc' (npos (-f) x))
            (fun x => by
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              exact mul_nonneg hc' (npos f x))
            (fun x => by
              have h := hdec f x
              simp only [CompactlySupportedContinuousMap.smul_apply, smul_eq_mul]
              linear_combination (-c) * h)]
          rw [hpsmul (-c) _ hc', hpsmul (-c) _ hc']
          ring }
  have hPapp : ∀ f, P f = p (f ⊔ 0) - p ((-f) ⊔ 0) := fun f => rfl
  have hPcone : ∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → P f = p f := by
    intro f hf
    rw [hPapp, K f f 0 hf (fun x => by simp) (fun x => by simp), hp0, sub_zero]
  
  have hrmk : ∀ Q : CompactlySupportedContinuousMap E3 ℝ →ₗ[ℝ] ℝ,
      (∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → 0 ≤ Q f) →
      ∃ μ : Measure E3, (∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) ∧
        ∀ f : CompactlySupportedContinuousMap E3 ℝ, Q f = ∫ x, f x ∂μ := by
    intro Q hQ
    let Q' : CompactlySupportedContinuousMap E3 ℝ →ₚ[ℝ] ℝ :=
      PositiveLinearMap.mk₀ Q (fun f hf => hQ f (fun x => by
        simpa using CompactlySupportedContinuousMap.le_def.mp hf x))
    refine ⟨RealRMK.rieszMeasure Q', fun r => ?_, fun f => ?_⟩
    · exact lt_of_le_of_lt (measure_mono Metric.ball_subset_closedBall)
        (isCompact_closedBall (0 : E3) r).measure_lt_top
    · exact (RealRMK.integral_rieszMeasure Q' f).symm
  
  have hPpos : ∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → 0 ≤ P f := by
    intro f hf
    rw [hPcone f hf, hp]
    exact le_csSup (hbdd f) (hzero f hf)
  have hQpos : ∀ f : CompactlySupportedContinuousMap E3 ℝ, (∀ x, 0 ≤ f x) → 0 ≤ (P - Λ) f := by
    intro f hf
    rw [LinearMap.sub_apply, hPcone f hf, hp, sub_nonneg]
    exact le_csSup (hbdd f) (hself f hf)
  obtain ⟨μp, hμp, hrepP⟩ := hrmk P hPpos
  obtain ⟨μm, hμm, hrepQ⟩ := hrmk (P - Λ) hQpos
  refine ⟨μp, μm, hμp, hμm, fun f => ?_⟩
  rw [← hrepP f, ← hrepQ f, LinearMap.sub_apply]
  ring

theorem sepGG_polar (μp μm : Fin 3 → Measure E3) (hp : ∀ (i : Fin 3) (r : ℝ), μp i (Metric.ball 0 r) < ⊤) (hm : ∀ (i : Fin 3) (r : ℝ), μm i (Metric.ball 0 r) < ⊤) : ∃ (μ : Measure E3) (ν : E3 → E3), (∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) ∧ Measurable ν ∧ (∀ x, ‖ν x‖ = 1) ∧ ∀ X : E3 → E3, Continuous X → HasCompactSupport X → ∑ i : Fin 3, ((∫ x, X x i ∂(μp i)) - ∫ x, X x i ∂(μm i)) = ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ :=
by
  classical
  
  have hLF : ∀ ρ : Measure E3, (∀ r : ℝ, ρ (Metric.ball 0 r) < ⊤) →
      IsFiniteMeasureOnCompacts ρ := by
    intro ρ hρ
    refine ⟨fun K hK => ?_⟩
    obtain ⟨r, hr⟩ := (Metric.isBounded_iff_subset_ball (0 : E3)).1 hK.isBounded
    exact lt_of_le_of_lt (measure_mono hr) (hρ r)
  
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : Measure E3, ρ = ∑ i : Fin 3, (μp i + μm i) := ⟨_, rfl⟩
  have hρapp : ∀ s, ρ s = ∑ i : Fin 3, (μp i s + μm i s) := by
    intro s
    rw [hρdef, Measure.finset_sum_apply]
    simp only [Measure.add_apply]
  have hρ : ∀ r : ℝ, ρ (Metric.ball 0 r) < ⊤ := by
    intro r
    rw [hρapp]
    exact ENNReal.sum_lt_top.mpr (fun i _ => ENNReal.add_lt_top.mpr ⟨hp i r, hm i r⟩)
  haveI : IsFiniteMeasureOnCompacts ρ := hLF ρ hρ
  haveI : SigmaFinite ρ := sigmaFinite_of_locallyFinite
  have hlep : ∀ i, μp i ≤ ρ := by
    intro i
    refine Measure.le_iff.mpr (fun s _ => ?_)
    rw [hρapp]
    calc μp i s ≤ μp i s + μm i s := le_self_add
      _ ≤ ∑ j : Fin 3, (μp j s + μm j s) :=
        Finset.single_le_sum (f := fun j => μp j s + μm j s) (fun j _ => zero_le _)
          (Finset.mem_univ i)
  have hlem : ∀ i, μm i ≤ ρ := by
    intro i
    refine Measure.le_iff.mpr (fun s _ => ?_)
    rw [hρapp]
    calc μm i s ≤ μp i s + μm i s := le_add_self
      _ ≤ ∑ j : Fin 3, (μp j s + μm j s) :=
        Finset.single_le_sum (f := fun j => μp j s + μm j s) (fun j _ => zero_le _)
          (Finset.mem_univ i)
  
  have hrn : ∀ μ' : Measure E3, μ' ≤ ρ → ∃ a : E3 → ℝ, Measurable a ∧
      (∀ x, 0 ≤ a x ∧ a x ≤ 1) ∧ ∀ φ : E3 → ℝ, ∫ x, φ x ∂μ' = ∫ x, a x * φ x ∂ρ := by
    intro μ' hle
    haveI : SigmaFinite μ' := Measure.sigmaFinite_of_le ρ hle
    haveI : μ'.HaveLebesgueDecomposition ρ :=
      Measure.haveLebesgueDecomposition_of_sigmaFinite μ' ρ
    have hac : μ' ≪ ρ := Measure.absolutelyContinuous_of_le hle
    refine ⟨fun x => min 1 ((μ'.rnDeriv ρ x).toReal),
      measurable_const.min (Measure.measurable_rnDeriv μ' ρ).ennreal_toReal,
      fun x => ⟨le_min zero_le_one ENNReal.toReal_nonneg, min_le_left _ _⟩, fun φ => ?_⟩
    rw [← integral_rnDeriv_smul hac]
    refine integral_congr_ae ?_
    filter_upwards [Measure.rnDeriv_le_one_of_le hle] with x hx
    have hx' : μ'.rnDeriv ρ x ≤ 1 := hx
    have h1 : (μ'.rnDeriv ρ x).toReal ≤ 1 := by
      have := ENNReal.toReal_mono ENNReal.one_ne_top hx'
      simpa using this
    simp only [smul_eq_mul, min_eq_right h1]
  
  choose a ha_meas ha_bd ha_int using fun i => hrn (μp i) (hlep i)
  choose b hb_meas hb_bd hb_int using fun i => hrn (μm i) (hlem i)
  
  obtain ⟨ξ, hξdef⟩ : ∃ ξ : E3 → E3,
      ξ = fun x => ∑ i : Fin 3, (a i x - b i x) • EuclideanSpace.single i (1 : ℝ) := ⟨_, rfl⟩
  have hξm : Measurable ξ := by
    rw [hξdef]
    exact Finset.measurable_sum _ (fun i _ => ((ha_meas i).sub (hb_meas i)).smul_const _)
  have hξ3 : ∀ x, ‖ξ x‖ ≤ 3 := by
    intro x
    have hterm : ∀ i : Fin 3,
        ‖(a i x - b i x) • EuclideanSpace.single i (1 : ℝ)‖ ≤ (1 : ℝ) := by
      intro i
      rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
      exact abs_sub_le_iff.mpr ⟨by linarith [(ha_bd i x).2, (hb_bd i x).1],
        by linarith [(ha_bd i x).1, (hb_bd i x).2]⟩
    calc ‖ξ x‖ ≤ ∑ i : Fin 3, ‖(a i x - b i x) • EuclideanSpace.single i (1 : ℝ)‖ := by
          rw [hξdef]; exact norm_sum_le _ _
      _ ≤ ∑ i : Fin 3, (1 : ℝ) := Finset.sum_le_sum (fun i _ => hterm i)
      _ = 3 := by simp
  have hinner : ∀ x (v : E3), @inner ℝ E3 _ v (ξ x) = ∑ i : Fin 3, (a i x - b i x) * v i := by
    intro x v
    rw [hξdef]
    simp [inner_sum, real_inner_smul_right, EuclideanSpace.inner_single_right]
  
  obtain ⟨μ, hμdef⟩ : ∃ μ : Measure E3,
      μ = ρ.withDensity (fun x => ((‖ξ x‖₊ : NNReal) : ENNReal)) := ⟨_, rfl⟩
  obtain ⟨ν, hνdef⟩ : ∃ ν : E3 → E3, ν = fun x =>
      if ξ x = 0 then EuclideanSpace.single (0 : Fin 3) (1 : ℝ) else ‖ξ x‖⁻¹ • ξ x := ⟨_, rfl⟩
  have hνm : Measurable ν := by
    rw [hνdef]
    exact Measurable.ite (measurableSet_eq_fun hξm measurable_const) measurable_const
      (hξm.norm.inv.smul hξm)
  have hν1 : ∀ x, ‖ν x‖ = 1 := by
    intro x
    by_cases h : ξ x = 0
    · simp [hνdef, h, EuclideanSpace.norm_single]
    · simp only [hνdef, h, if_false]
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr h)]
  have hK : ∀ x, ‖ξ x‖ • ν x = ξ x := by
    intro x
    by_cases h : ξ x = 0
    · simp [hνdef, h]
    · simp only [hνdef, h, if_false]
      rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr h), one_smul]
  have hμ : ∀ r : ℝ, μ (Metric.ball 0 r) < ⊤ := by
    intro r
    rw [hμdef, withDensity_apply _ measurableSet_ball]
    calc ∫⁻ x in Metric.ball 0 r, ((‖ξ x‖₊ : NNReal) : ENNReal) ∂ρ
        ≤ ∫⁻ x in Metric.ball 0 r, (3 : ENNReal) ∂ρ := by
          refine lintegral_mono (fun x => ?_)
          have h3 : ‖ξ x‖₊ ≤ 3 := by
            rw [← NNReal.coe_le_coe]
            simpa using hξ3 x
          have h3' := ENNReal.coe_le_coe.mpr h3
          simpa using h3'
      _ = 3 * ρ (Metric.ball 0 r) := by rw [setLIntegral_const]
      _ < ⊤ := ENNReal.mul_lt_top (by simp) (hρ r)
  have hpolar : ∀ X : E3 → E3, ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ =
      ∫ x, @inner ℝ E3 _ (X x) (ξ x) ∂ρ := by
    intro X
    rw [hμdef, integral_withDensity_eq_integral_smul hξm.nnnorm]
    congr 1
    funext x
    rw [NNReal.smul_def, coe_nnnorm, smul_eq_mul, ← real_inner_smul_right, hK]
  
  refine ⟨μ, ν, hμ, hνm, hν1, fun X hX hXc => ?_⟩
  rw [hpolar X]
  have hXi : ∀ i : Fin 3, Continuous (fun x => X x i) := fun i =>
    (EuclideanSpace.proj i).continuous.comp hX
  have hXic : ∀ i : Fin 3, HasCompactSupport (fun x => X x i) := fun i =>
    hXc.comp_left (g := fun v : E3 => v i) rfl
  have hint : ∀ (c : E3 → ℝ), Measurable c → (∀ x, |c x| ≤ 1) → ∀ i : Fin 3,
      Integrable (fun x => c x * X x i) ρ := by
    intro c hc hc1 i
    have hf : Integrable (fun x => X x i) ρ :=
      (hXi i).integrable_of_hasCompactSupport (hXic i)
    exact hf.bdd_mul (c := 1) hc.aestronglyMeasurable
      (Eventually.of_forall fun x => by rw [Real.norm_eq_abs]; exact hc1 x)
  have Ia : ∀ i : Fin 3, Integrable (fun x => a i x * X x i) ρ := fun i =>
    hint (a i) (ha_meas i)
      (fun x => abs_le.mpr ⟨by linarith [(ha_bd i x).1], (ha_bd i x).2⟩) i
  have Ib : ∀ i : Fin 3, Integrable (fun x => b i x * X x i) ρ := fun i =>
    hint (b i) (hb_meas i)
      (fun x => abs_le.mpr ⟨by linarith [(hb_bd i x).1], (hb_bd i x).2⟩) i
  calc ∑ i : Fin 3, ((∫ x, X x i ∂(μp i)) - ∫ x, X x i ∂(μm i))
      = ∑ i : Fin 3, ((∫ x, a i x * X x i ∂ρ) - ∫ x, b i x * X x i ∂ρ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [ha_int i, hb_int i]
    _ = ∑ i : Fin 3, ∫ x, (a i x * X x i - b i x * X x i) ∂ρ := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [integral_sub (Ia i) (Ib i)]
    _ = ∫ x, ∑ i : Fin 3, (a i x * X x i - b i x * X x i) ∂ρ := by
        rw [integral_finset_sum]
        exact fun i _ => (Ia i).sub (Ib i)
    _ = ∫ x, @inner ℝ E3 _ (X x) (ξ x) ∂ρ := by
        congr 1
        funext x
        rw [hinner]
        exact Finset.sum_congr rfl (fun i _ => by ring)

theorem sepGG_dual_norm (μ : Measure E3) (hμ : ∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) (ν : E3 → E3) (hνm : Measurable ν) (hν1 : ∀ x, ‖ν x‖ = 1) (V : Set E3) (hV : IsOpen V) : μ V ≤ ⨆ (X : E3 → E3) (_ : ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ V ∧ ∀ y, ‖X y‖ ≤ 1), ENNReal.ofReal (∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ) :=
by
  classical
  
  have hfc : IsFiniteMeasureOnCompacts μ := ⟨fun K hK => by
    obtain ⟨r, hr⟩ := hK.isBounded.subset_ball 0
    exact (measure_mono hr).trans_lt (hμ r)⟩
  haveI := hfc
  haveI : IsLocallyFiniteMeasure μ := isLocallyFiniteMeasure_of_isFiniteMeasureOnCompacts
  haveI hreg : μ.Regular := Measure.Regular.of_sigmaCompactSpace_of_isLocallyFiniteMeasure μ
  
  refine le_of_forall_lt (fun c hc => ?_)
  rw [hV.measure_eq_iSup_isCompact μ] at hc
  obtain ⟨C, hc⟩ := lt_iSup_iff.mp hc
  obtain ⟨hCV, hc⟩ := lt_iSup_iff.mp hc
  obtain ⟨hC, hcC⟩ := lt_iSup_iff.mp hc
  have hCfin : μ C < ⊤ := hC.measure_lt_top
  have hctop : c ≠ ⊤ := ne_top_of_lt hcC
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = c.toReal := ⟨_, rfl⟩
  obtain ⟨m, hm⟩ : ∃ m : ℝ, m = (μ C).toReal := ⟨_, rfl⟩
  have ha0 : 0 ≤ a := ha ▸ ENNReal.toReal_nonneg
  have ham : a < m := by
    rw [ha, hm]; exact (ENNReal.toReal_lt_toReal hctop hCfin.ne).mpr hcC
  have hca : c = ENNReal.ofReal a := by rw [ha, ENNReal.ofReal_toReal hctop]
  
  obtain ⟨W, hWo, hCW, hWV, hWc⟩ := exists_open_between_and_isCompact_closure hC hV hCV
  obtain ⟨χ, hχs, hχr, hχsupp, hχ1⟩ :=
    exists_contMDiff_support_eq_eq_one_iff 𝓘(ℝ, E3) (n := ⊤) hWo hC.isClosed hCW
  have hχ : ContDiff ℝ ∞ χ := contMDiff_iff_contDiff.mp hχs
  have hχ01 : ∀ x, 0 ≤ χ x ∧ χ x ≤ 1 := fun x => hχr ⟨x, rfl⟩
  have hχC : ∀ x ∈ C, χ x = 1 := fun x hx => (hχ1 x).mp hx
  have hχ0 : ∀ x, x ∉ closure W → χ x = 0 := fun x hx => by
    have h' : x ∉ Function.support χ := by
      rw [hχsupp]; exact fun h => hx (subset_closure h)
    simpa using h'
  have hCWc : C ⊆ closure W := hCW.trans subset_closure
  have hWcfin : μ (closure W) < ⊤ := hWc.measure_lt_top
  obtain ⟨w, hw⟩ : ∃ w : ℝ, w = (μ (closure W)).toReal := ⟨_, rfl⟩
  have hw0 : 0 ≤ w := hw ▸ ENNReal.toReal_nonneg
  
  have hfint : Integrable (C.indicator ν) μ := by
    rw [integrable_indicator_iff hC.measurableSet]
    refine Integrable.mono' (show IntegrableOn (fun _ => (1 : ℝ)) C μ from
      integrableOn_const hCfin.ne) hνm.aestronglyMeasurable ?_
    exact Filter.Eventually.of_forall (fun x => (hν1 x).le)
  have hε : 0 < (m - a) / 4 := by linarith
  obtain ⟨g, -, hgL1, hgc, hgi⟩ := hfint.exists_hasCompactSupport_integral_sub_le hε
  
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = (m - a) / (8 * (w + 1)) := ⟨_, rfl⟩
  have hδ : 0 < δ := by rw [hδdef]; exact div_pos (by linarith) (by linarith)
  have hδeq : 8 * (δ * w) + 8 * δ = m - a := by
    rw [hδdef]; field_simp
  have hρc : Continuous (fun x => (max 1 ‖g x‖)⁻¹ • g x) :=
    ((continuous_const.max hgc.norm).inv₀
      (fun x => (lt_of_lt_of_le one_pos (le_max_left _ _)).ne')).smul hgc
  obtain ⟨Sm, hSm⟩ := exists_contMDiffMap_forall_mem_convex_of_local_const 𝓘(ℝ, E3) (n := ⊤)
    (t := fun x => Metric.ball ((max 1 ‖g x‖)⁻¹ • g x) δ) (fun x => convex_ball _ _)
    (fun x => ⟨(max 1 ‖g x‖)⁻¹ • g x, Filter.Eventually.mono
      (hρc.continuousAt (Metric.ball_mem_nhds _ hδ)) (fun y hy => Metric.mem_ball_comm.mp hy)⟩)
  have hS : ContDiff ℝ ∞ (fun x => Sm x) := contMDiff_iff_contDiff.mp Sm.contMDiff
  have hSδ : ∀ x, ‖Sm x - (max 1 ‖g x‖)⁻¹ • g x‖ < δ := fun x => by
    have h' := hSm x
    rwa [Metric.mem_ball, dist_eq_norm] at h'
  
  have key : ∀ (νv gv Sv : E3) (cc : ℝ), ‖νv‖ = 1 → 0 ≤ cc → cc ≤ 1 →
      ‖Sv - (max 1 ‖gv‖)⁻¹ • gv‖ < δ →
      ‖((1 + δ)⁻¹ * cc) • Sv‖ ≤ 1 ∧
      (cc = 1 → 1 - 2 * δ - 2 * ‖gv - νv‖ ≤ @inner ℝ E3 _ (((1 + δ)⁻¹ * cc) • Sv) νv) ∧
      -(2 * δ) - 2 * ‖gv‖ ≤ @inner ℝ E3 _ (((1 + δ)⁻¹ * cc) • Sv) νv := by
    intro νv gv Sv cc hνv hc0 hc1 hSv
    obtain ⟨t, ht⟩ : ∃ t : ℝ, t = (max 1 ‖gv‖)⁻¹ := ⟨_, rfl⟩
    rw [← ht] at hSv
    have htprop : 0 < t ∧ t ≤ 1 ∧ t * ‖gv‖ ≤ 1 ∧ (t = 1 ∨ t * ‖gv‖ = 1) := by
      rcases le_total ‖gv‖ 1 with h | h
      · rw [max_eq_left h, inv_one] at ht
        subst ht
        exact ⟨one_pos, le_rfl, by linarith, Or.inl rfl⟩
      · rw [max_eq_right h] at ht
        have hg0 : 0 < ‖gv‖ := by linarith
        have h1 : t * ‖gv‖ = 1 := by rw [ht]; exact inv_mul_cancel₀ hg0.ne'
        refine ⟨by rw [ht]; exact inv_pos.mpr hg0, ?_, h1.le, Or.inr h1⟩
        rw [ht]; exact inv_le_one_of_one_le₀ h
    obtain ⟨ht0, ht1, htg, hcase⟩ := htprop
    have hng : 0 ≤ ‖gv‖ := norm_nonneg _
    have hρn : ‖t • gv‖ = t * ‖gv‖ := by
      rw [norm_smul, Real.norm_of_nonneg ht0.le]
    have hρg : ‖t • gv - gv‖ = (1 - t) * ‖gv‖ := by
      have : t • gv - gv = (t - 1) • gv := by rw [sub_smul, one_smul]
      rw [this, norm_smul, Real.norm_of_nonpos (by linarith)]
      ring
    have hR2 : (1 - t) * ‖gv‖ ≤ ‖gv - νv‖ := by
      rcases hcase with h | h
      · rw [h]; simp
      · have := norm_sub_norm_le gv νv
        rw [hνv] at this
        have e1 : (1 - t) * ‖gv‖ = ‖gv‖ - t * ‖gv‖ := by ring
        rw [e1, h]
        exact this
    have hSn : ‖Sv‖ ≤ t * ‖gv‖ + δ := by
      have := norm_sub_norm_le Sv (t • gv)
      rw [hρn] at this
      linarith
    obtain ⟨q, hq⟩ : ∃ q : ℝ, q = (1 + δ)⁻¹ := ⟨_, rfl⟩
    rw [← hq]
    have hq0 : 0 < q := by rw [hq]; exact inv_pos.mpr (by linarith)
    have hqe : q * (1 + δ) = 1 := by rw [hq]; exact inv_mul_cancel₀ (by linarith)
    have hqe' : q + q * δ = 1 := by rw [← hqe]; ring
    have hq1 : q ≤ 1 := by
      have := mul_pos hq0 hδ
      linarith
    have hk0 : 0 ≤ q * cc := mul_nonneg hq0.le hc0
    have hk1 : q * cc ≤ 1 := mul_le_one₀ hq1 hc0 hc1
    have hXn : ‖(q * cc) • Sv‖ = q * cc * ‖Sv‖ := by
      rw [norm_smul, Real.norm_of_nonneg hk0]
    have hSn0 : 0 ≤ ‖Sv‖ := norm_nonneg _
    refine ⟨?_, ?_, ?_⟩
    · rw [hXn]
      have h1 : ‖Sv‖ ≤ 1 + δ := by linarith
      calc q * cc * ‖Sv‖ ≤ q * cc * (1 + δ) := mul_le_mul_of_nonneg_left h1 hk0
        _ = cc * (q * (1 + δ)) := by ring
        _ ≤ 1 := by rw [hqe]; linarith
    · intro hcc
      rw [hcc, mul_one, real_inner_smul_left]
      have hI1 : -(‖Sv - t • gv‖ * ‖νv‖) ≤ @inner ℝ E3 _ (Sv - t • gv) νv :=
        neg_le_of_abs_le (abs_real_inner_le_norm _ _)
      have hI2 : -(‖t • gv - νv‖ * ‖νv‖) ≤ @inner ℝ E3 _ (t • gv - νv) νv :=
        neg_le_of_abs_le (abs_real_inner_le_norm _ _)
      have hνν : @inner ℝ E3 _ νv νv = 1 := by
        rw [real_inner_self_eq_norm_sq, hνv]; norm_num
      have hsplit : @inner ℝ E3 _ Sv νv =
          @inner ℝ E3 _ (Sv - t • gv) νv + @inner ℝ E3 _ (t • gv - νv) νv + @inner ℝ E3 _ νv νv := by
        rw [inner_sub_left, inner_sub_left]; ring
      have htri : ‖t • gv - νv‖ ≤ ‖t • gv - gv‖ + ‖gv - νv‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
      rw [hνv, mul_one] at hI1 hI2
      have hI : 1 - δ - 2 * ‖gv - νv‖ ≤ @inner ℝ E3 _ Sv νv := by
        rw [hsplit, hνν]; linarith
      set b := 1 - δ - 2 * ‖gv - νv‖ with hb
      have hb1 : b ≤ 1 := by have := norm_nonneg (gv - νv); linarith
      have hqI : q * b ≤ q * @inner ℝ E3 _ Sv νv := mul_le_mul_of_nonneg_left hI hq0.le
      have hqb : b - δ ≤ q * b := by
        rcases le_total 0 b with hb0 | hb0
        · have hbq : b * q ≤ 1 := by
            calc b * q ≤ 1 * 1 := mul_le_mul hb1 hq1 hq0.le zero_le_one
              _ = 1 := one_mul 1
          have e2 : q * b - (b - δ) = δ * (1 - b * q) := by linear_combination b * hqe
          have := mul_nonneg hδ.le (sub_nonneg.mpr hbq)
          linarith
        · have e3 : (q - 1) * b = q * b - b := by ring
          have := mul_nonneg_of_nonpos_of_nonpos (by linarith : q - 1 ≤ 0) hb0
          linarith
      linarith
    · rw [real_inner_smul_left]
      have hI : -(‖Sv‖ * ‖νv‖) ≤ @inner ℝ E3 _ Sv νv :=
        neg_le_of_abs_le (abs_real_inner_le_norm _ _)
      rw [hνv, mul_one] at hI
      have hgt : ‖Sv‖ ≤ ‖gv‖ + δ := by
        have := mul_le_of_le_one_left hng ht1
        linarith
      have hIabs : |@inner ℝ E3 _ Sv νv| ≤ ‖Sv‖ := by
        have := abs_real_inner_le_norm Sv νv
        rwa [hνv, mul_one] at this
      have : -(q * cc * ‖Sv‖) ≤ q * cc * @inner ℝ E3 _ Sv νv := by
        have := mul_le_mul_of_nonneg_left (neg_le_of_abs_le hIabs) hk0
        linarith
      have h2 : q * cc * ‖Sv‖ ≤ ‖Sv‖ := mul_le_of_le_one_left hSn0 hk1
      linarith
  
  set X : E3 → E3 := fun x => ((1 + δ)⁻¹ * χ x) • Sm x with hXdef
  have hXs : ContDiff ℝ ∞ X := (contDiff_const.mul hχ).smul hS
  have hX0 : ∀ x, x ∉ closure W → X x = 0 := fun x hx => by
    simp [hXdef, hχ0 x hx]
  have hXc : HasCompactSupport X := HasCompactSupport.intro' hWc isClosed_closure hX0
  have hsuppW : Function.support X ⊆ closure W := fun x hx =>
    by_contra (fun h => (Function.mem_support.mp hx) (hX0 x h))
  have hXV : tsupport X ⊆ V := (closure_minimal hsuppW isClosed_closure).trans hWV
  have hX1 : ∀ y, ‖X y‖ ≤ 1 := fun y =>
    (key (ν y) (g y) (Sm y) (χ y) (hν1 y) (hχ01 y).1 (hχ01 y).2 (hSδ y)).1
  
  have hC1 : Integrable (C.indicator (1 : E3 → ℝ)) μ := by
    rw [integrable_indicator_iff hC.measurableSet]; exact integrableOn_const hCfin.ne
  have hW1 : Integrable ((closure W).indicator (1 : E3 → ℝ)) μ := by
    rw [integrable_indicator_iff isClosed_closure.measurableSet]; exact integrableOn_const hWcfin.ne
  have hN : Integrable (fun x => ‖C.indicator ν x - g x‖) μ := (hfint.sub hgi).norm
  have hInn : Integrable (fun x => @inner ℝ E3 _ (X x) (ν x)) μ := by
    refine Integrable.mono' hW1 (hXs.continuous.measurable.inner hνm).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun x => ?_)
    by_cases hx : x ∈ closure W
    · rw [Set.indicator_of_mem hx, Pi.one_apply, Real.norm_eq_abs]
      calc |@inner ℝ E3 _ (X x) (ν x)| ≤ ‖X x‖ * ‖ν x‖ := abs_real_inner_le_norm _ _
        _ ≤ 1 := by rw [hν1 x, mul_one]; exact hX1 x
    · rw [Set.indicator_of_notMem hx, hX0 x hx, inner_zero_left, norm_zero]
  have hpt : ∀ x, C.indicator (1 : E3 → ℝ) x - 2 * δ * (closure W).indicator (1 : E3 → ℝ) x
      - 2 * ‖C.indicator ν x - g x‖ ≤ @inner ℝ E3 _ (X x) (ν x) := by
    intro x
    have hk := key (ν x) (g x) (Sm x) (χ x) (hν1 x) (hχ01 x).1 (hχ01 x).2 (hSδ x)
    by_cases hxC : x ∈ C
    · rw [Set.indicator_of_mem hxC, Set.indicator_of_mem (hCWc hxC), Set.indicator_of_mem hxC,
        Pi.one_apply, norm_sub_rev]
      have := hk.2.1 (hχC x hxC)
      simp only [hXdef]
      linarith
    · by_cases hxW : x ∈ closure W
      · rw [Set.indicator_of_notMem hxC, Set.indicator_of_mem hxW, Set.indicator_of_notMem hxC,
          Pi.one_apply]
        simp only [zero_sub, norm_neg, mul_one]
        have := hk.2.2
        simp only [hXdef]
        linarith
      · rw [Set.indicator_of_notMem hxC, Set.indicator_of_notMem hxW, Set.indicator_of_notMem hxC,
          hX0 x hxW, inner_zero_left]
        simp only [zero_sub, norm_neg, mul_zero, neg_zero]
        have := norm_nonneg (g x)
        linarith
  have hW2 : Integrable (fun x => 2 * δ * (closure W).indicator (1 : E3 → ℝ) x) μ :=
    hW1.const_mul (2 * δ)
  have hA : Integrable (fun x => C.indicator (1 : E3 → ℝ) x
      - 2 * δ * (closure W).indicator (1 : E3 → ℝ) x) μ := hC1.sub hW2
  have hB : Integrable (fun x => 2 * ‖C.indicator ν x - g x‖) μ := hN.const_mul 2
  have hH : Integrable (fun x => C.indicator (1 : E3 → ℝ) x
      - 2 * δ * (closure W).indicator (1 : E3 → ℝ) x - 2 * ‖C.indicator ν x - g x‖) μ := hA.sub hB
  have hmono := integral_mono hH hInn hpt
  have hcalc : ∫ x, (C.indicator (1 : E3 → ℝ) x - 2 * δ * (closure W).indicator (1 : E3 → ℝ) x
      - 2 * ‖C.indicator ν x - g x‖) ∂μ = m - 2 * δ * w - 2 * ∫ x, ‖C.indicator ν x - g x‖ ∂μ := by
    rw [integral_sub hA hB, integral_sub hC1 hW2, integral_const_mul, integral_const_mul,
      integral_indicator_one hC.measurableSet, integral_indicator_one isClosed_closure.measurableSet,
      hm, hw]
    rfl
  rw [hcalc] at hmono
  
  have hlt : a < ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ := by
    linarith
  rw [hca]
  calc ENNReal.ofReal a < ENNReal.ofReal (∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ) :=
        (ENNReal.ofReal_lt_ofReal_iff (by linarith)).mpr hlt
    _ ≤ _ := le_iSup₂_of_le (f := fun (Y : E3 → E3) (_ : ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧
          tsupport Y ⊆ V ∧ ∀ y, ‖Y y‖ ≤ 1) => ENNReal.ofReal (∫ x, @inner ℝ E3 _ (Y x) (ν x) ∂μ))
          X ⟨hXs, hXc, hXV, hX1⟩ le_rfl

theorem sepGaussGreen_measure (K : Set E3) (hK : MeasurableSet K) (hfin : ∀ r : ℝ, 0 < r → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 r) < ⊤) : ∃ (μ : Measure E3) (ν : E3 → E3), (∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) ∧ Measurable ν ∧ (∀ x, ‖ν x‖ = 1) ∧ (∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → ∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y = ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ) ∧ (∀ V : Set E3, IsOpen V → μ V = sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K V) :=
by
  classical
  
  have hF1 : ∀ (X : E3 → E3) (y : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y =
        ∑ i : Fin 3, partialDeriv i (fun z => X z i) y := by
    intro X y
    simp only [sepDensDiv, Matrix.det_one, Real.sqrt_one, one_mul]
  
  have hF2 : ∀ v : E3,
      ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * v i * v j = ‖v‖ ^ 2 := by
    intro v
    rw [EuclideanSpace.norm_sq_eq]
    simp [Matrix.one_apply, Fin.sum_univ_three, sq]
  have hadm : ∀ v : E3,
      (∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * v i * v j ≤ 1) ↔
        ‖v‖ ≤ 1 := by
    intro v
    rw [hF2]
    have h0 := norm_nonneg v
    constructor
    · intro h; nlinarith
    · intro h; nlinarith
  
  have hcomp : ∀ i : Fin 3, ∃ μp μm : Measure E3, (∀ r : ℝ, μp (Metric.ball 0 r) < ⊤) ∧
      (∀ r : ℝ, μm (Metric.ball 0 r) < ⊤) ∧
      ∀ φ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
        ∫ y in K, partialDeriv i φ y = (∫ x, φ x ∂μp) - ∫ x, φ x ∂μm := by
    intro i
    obtain ⟨hadd, hsmul, hbd⟩ := sepGG_component_functional K hK hfin i
    obtain ⟨Λ, hΛ, hΛbd⟩ :=
      sepGG_order0_extend (fun φ => ∫ y in K, partialDeriv i φ y) hadd hsmul hbd
    obtain ⟨μp, μm, hp, hm, hrep⟩ := sepGG_riesz_signed Λ hΛbd
    refine ⟨μp, μm, hp, hm, fun φ hφ hφc => ?_⟩
    let f : CompactlySupportedContinuousMap E3 ℝ := ⟨⟨φ, hφ.continuous⟩, hφc⟩
    have h1 : Λ f = ∫ y in K, partialDeriv i φ y := hΛ f hφ
    have h2 : Λ f = (∫ x, φ x ∂μp) - ∫ x, φ x ∂μm := hrep f
    rw [← h1, h2]
  choose μp μm hp hm hrep using hcomp
  obtain ⟨μ, ν, hμ, hνm, hν1, hpol⟩ := sepGG_polar μp μm hp hm
  
  have hGG : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X →
      ∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y =
        ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ := by
    intro X hX hXc
    have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i => contDiff_euclidean.mp hX i
    have hXic : ∀ i : Fin 3, HasCompactSupport (fun z => X z i) := fun i =>
      hXc.comp_left (g := fun v : E3 => v i) rfl
    have hint : ∀ i : Fin 3, Integrable (fun y => partialDeriv i (fun z => X z i) y) := by
      intro i
      apply Continuous.integrable_of_hasCompactSupport
      · exact ((hXi i).continuous_fderiv (by simp)).clm_apply continuous_const
      · exact (hXic i).fderiv_apply ℝ (e i)
    rw [← hpol X hX.continuous hXc]
    rw [integral_congr_ae (Filter.Eventually.of_forall (fun y => hF1 X y))]
    rw [integral_finset_sum _ (fun i _ => (hint i).integrableOn)]
    exact Finset.sum_congr rfl (fun i _ => hrep i _ (hXi i) (hXic i))
  refine ⟨μ, ν, hμ, hνm, hν1, hGG, ?_⟩
  
  intro V hV
  apply le_antisymm
  · refine (sepGG_dual_norm μ hμ ν hνm hν1 V hV).trans ?_
    refine iSup₂_le (fun X hX => ?_)
    obtain ⟨hXs, hXc, hXV, hX1⟩ := hX
    rw [← hGG X hXs hXc]
    unfold sepPerG
    exact le_iSup₂_of_le X ⟨hXs, hXc, hXV, fun y => (hadm (X y)).2 (hX1 y)⟩ le_rfl
  · unfold sepPerG
    refine iSup₂_le (fun X hX => ?_)
    obtain ⟨hXs, hXc, hXV, hX1⟩ := hX
    rw [hGG X hXs hXc]
    by_cases hVt : μ V = ⊤
    · rw [hVt]; exact le_top
    have hpt : ∀ x, @inner ℝ E3 _ (X x) (ν x) ≤ V.indicator (1 : E3 → ℝ) x := by
      intro x
      by_cases hxV : x ∈ V
      · rw [Set.indicator_of_mem hxV, Pi.one_apply]
        calc @inner ℝ E3 _ (X x) (ν x) ≤ ‖X x‖ * ‖ν x‖ := real_inner_le_norm _ _
          _ ≤ 1 := by
            rw [hν1 x, mul_one]
            exact (hadm (X x)).1 (hX1 x)
      · rw [Set.indicator_of_notMem hxV]
        have hX0 : X x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hxV (hXV h))
        rw [hX0, inner_zero_left]
    have hind : Integrable (V.indicator (1 : E3 → ℝ)) μ := by
      rw [integrable_indicator_iff hV.measurableSet]
      exact integrableOn_const hVt
    have hle : ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ ≤ μ.real V := by
      by_cases hint : Integrable (fun x => @inner ℝ E3 _ (X x) (ν x)) μ
      · rw [← integral_indicator_one hV.measurableSet]
        exact integral_mono hint hind hpt
      · rw [integral_undef hint]
        exact ENNReal.toReal_nonneg
    calc ENNReal.ofReal (∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ)
        ≤ ENNReal.ofReal (μ.real V) := ENNReal.ofReal_le_ofReal hle
      _ = μ V := by rw [Measure.real, ENNReal.ofReal_toReal hVt]

theorem sepFV_adj_expansion_bound (β : ℝ) (hβ : 0 ≤ β) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (B : Matrix (Fin 3) (Fin 3) ℝ) (t : ℝ) (v : Fin 3 → ℝ), (∀ i a : Fin 3, |B i a| ≤ β) → |t| ≤ 1 → ∑ a : Fin 3, v a ^ 2 = 1 → Real.sqrt (∑ i : Fin 3, (∑ a : Fin 3, (1 + t • B).adjugate a i * v a) ^ 2) ≤ 1 + t * (Matrix.trace B - ∑ a : Fin 3, ∑ i : Fin 3, v a * B a i * v i) + C * t ^ 2 :=
by
  refine ⟨(3 / 2) * ((6 * β + 6 * β ^ 2) ^ 2 + 2 * (6 * β ^ 2)), by positivity, ?_⟩
  intro B t v hB ht hv
  
  have hv1 : ∀ a : Fin 3, |v a| ≤ 1 := by
    intro a
    have h1 : v a ^ 2 ≤ ∑ b : Fin 3, v b ^ 2 :=
      Finset.single_le_sum (f := fun b => v b ^ 2) (fun b _ => sq_nonneg _) (Finset.mem_univ a)
    rw [hv] at h1
    exact (sq_le_one_iff_abs_le_one _).1 h1
  have hv' : v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 = 1 := by
    rw [Fin.sum_univ_three] at hv; exact hv
  
  have hadj : ∀ a i : Fin 3, (1 + t • B).adjugate a i = (if a = i then (1 : ℝ) else 0)
      + t * ((if a = i then Matrix.trace B else 0) - B a i) + t ^ 2 * B.adjugate a i := by
    intro a i
    rw [Matrix.adjugate_fin_three, Matrix.adjugate_fin_three, Matrix.trace_fin_three]
    fin_cases a <;> fin_cases i <;>
      simp [Matrix.add_apply, Matrix.one_apply, Matrix.smul_apply, smul_eq_mul] <;> ring
  
  obtain ⟨u, hu⟩ : ∃ u : Fin 3 → ℝ, u = fun i => Matrix.trace B * v i - ∑ a : Fin 3, B a i * v a :=
    ⟨_, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : Fin 3 → ℝ, z = fun i => ∑ a : Fin 3, B.adjugate a i * v a := ⟨_, rfl⟩
  have hw : ∀ i : Fin 3, ∑ a : Fin 3, (1 + t • B).adjugate a i * v a
      = v i + t * u i + t ^ 2 * z i := by
    intro i
    simp only [hadj, hu, hz]
    fin_cases i <;> simp [Fin.sum_univ_three] <;> ring
  
  have hBv : ∀ j k a : Fin 3, |B j k * v a| ≤ β := by
    intro j k a
    rw [abs_mul]
    calc |B j k| * |v a| ≤ β * 1 := mul_le_mul (hB j k) (hv1 a) (abs_nonneg _) hβ
      _ = β := mul_one β
  have hBB : ∀ j k l m : Fin 3, |B j k * B l m| ≤ β ^ 2 := by
    intro j k l m
    rw [abs_mul, sq]
    exact mul_le_mul (hB j k) (hB l m) (abs_nonneg _) hβ
  have key : ∀ p q : ℝ, |p| ≤ β ^ 2 → |q| ≤ β ^ 2 →
      |p - q| ≤ 2 * β ^ 2 ∧ |-p + q| ≤ 2 * β ^ 2 := by
    intro p q hp hq
    have hp' := abs_le.1 hp
    have hq' := abs_le.1 hq
    constructor <;> rw [abs_le] <;> constructor <;> linarith
  have hadjB : ∀ a i : Fin 3, |B.adjugate a i| ≤ 2 * β ^ 2 := by
    intro a i
    rw [Matrix.adjugate_fin_three]
    fin_cases a <;> fin_cases i <;> simp <;>
      first
      | exact (key _ _ (hBB _ _ _ _) (hBB _ _ _ _)).1
      | exact (key _ _ (hBB _ _ _ _) (hBB _ _ _ _)).2
  have hAv : ∀ a i : Fin 3, |B.adjugate a i * v a| ≤ 2 * β ^ 2 := by
    intro a i
    rw [abs_mul]
    calc |B.adjugate a i| * |v a| ≤ (2 * β ^ 2) * 1 :=
          mul_le_mul (hadjB a i) (hv1 a) (abs_nonneg _) (by positivity)
      _ = 2 * β ^ 2 := mul_one _
  have hub : ∀ i : Fin 3, |u i| ≤ 6 * β := by
    intro i
    have e : u i = B 0 0 * v i + B 1 1 * v i + B 2 2 * v i
        - (B 0 i * v 0 + B 1 i * v 1 + B 2 i * v 2) := by
      rw [hu]; simp only [Fin.sum_univ_three, Matrix.trace_fin_three]; ring
    rw [e, abs_le]
    have h1 := abs_le.1 (hBv 0 0 i)
    have h2 := abs_le.1 (hBv 1 1 i)
    have h3 := abs_le.1 (hBv 2 2 i)
    have h4 := abs_le.1 (hBv 0 i 0)
    have h5 := abs_le.1 (hBv 1 i 1)
    have h6 := abs_le.1 (hBv 2 i 2)
    constructor <;> linarith
  have hzb : ∀ i : Fin 3, |z i| ≤ 6 * β ^ 2 := by
    intro i
    have e : z i = B.adjugate 0 i * v 0 + B.adjugate 1 i * v 1 + B.adjugate 2 i * v 2 := by
      rw [hz]; simp only [Fin.sum_univ_three]
    rw [e, abs_le]
    have h1 := abs_le.1 (hAv 0 i)
    have h2 := abs_le.1 (hAv 1 i)
    have h3 := abs_le.1 (hAv 2 i)
    constructor <;> linarith
  
  have hlin : ∑ i : Fin 3, v i * u i
      = Matrix.trace B - ∑ a : Fin 3, ∑ i : Fin 3, v a * B a i * v i := by
    rw [hu]
    simp only [Fin.sum_univ_three, Matrix.trace_fin_three]
    linear_combination (B 0 0 + B 1 1 + B 2 2) * hv'
  
  have star : ∀ p q r : ℝ, |p| ≤ 1 → |q| ≤ 6 * β → |r| ≤ 6 * β ^ 2 →
      (p + t * q + t ^ 2 * r) ^ 2 ≤ p ^ 2 + 2 * t * (p * q)
        + ((6 * β + 6 * β ^ 2) ^ 2 + 2 * (6 * β ^ 2)) * t ^ 2 := by
    intro p q r hp hq hr
    have e : (p + t * q + t ^ 2 * r) ^ 2
        = p ^ 2 + 2 * t * (p * q) + t ^ 2 * ((q + t * r) ^ 2 + 2 * (p * r)) := by ring
    have htr : |t * r| ≤ 6 * β ^ 2 := by
      rw [abs_mul]
      calc |t| * |r| ≤ 1 * (6 * β ^ 2) := mul_le_mul ht hr (abs_nonneg _) zero_le_one
        _ = 6 * β ^ 2 := one_mul _
    have hqr : |q + t * r| ≤ 6 * β + 6 * β ^ 2 :=
      (abs_add_le _ _).trans (add_le_add hq htr)
    have hsq : (q + t * r) ^ 2 ≤ (6 * β + 6 * β ^ 2) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) hqr 2
    have hpr : p * r ≤ 6 * β ^ 2 := by
      calc p * r ≤ |p * r| := le_abs_self _
        _ = |p| * |r| := abs_mul _ _
        _ ≤ 1 * (6 * β ^ 2) := mul_le_mul hp hr (abs_nonneg _) zero_le_one
        _ = 6 * β ^ 2 := one_mul _
    have hb : t ^ 2 * ((q + t * r) ^ 2 + 2 * (p * r))
        ≤ t ^ 2 * ((6 * β + 6 * β ^ 2) ^ 2 + 2 * (6 * β ^ 2)) :=
      mul_le_mul_of_nonneg_left (by linarith) (sq_nonneg t)
    rw [e]
    linarith
  
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ∑ i : Fin 3, (∑ a : Fin 3, (1 + t • B).adjugate a i * v a) ^ 2 :=
    ⟨_, rfl⟩
  obtain ⟨g, hg⟩ : ∃ g : ℝ, g = Matrix.trace B - ∑ a : Fin 3, ∑ i : Fin 3, v a * B a i * v i :=
    ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (6 * β + 6 * β ^ 2) ^ 2 + 2 * (6 * β ^ 2) := ⟨_, rfl⟩
  have hS0 : 0 ≤ S := by
    rw [hS]; exact Finset.sum_nonneg (fun i _ => sq_nonneg _)
  have hSle : S ≤ 1 + 2 * t * g + 3 * K * t ^ 2 := by
    have hsum : S = ∑ i : Fin 3, (v i + t * u i + t ^ 2 * z i) ^ 2 := by
      rw [hS]; exact Finset.sum_congr rfl (fun i _ => by rw [hw i])
    have hlin' : v 0 * u 0 + v 1 * u 1 + v 2 * u 2 = g := by
      rw [hg, ← hlin, Fin.sum_univ_three]
    rw [hsum, Fin.sum_univ_three]
    have s0 := star (v 0) (u 0) (z 0) (hv1 0) (hub 0) (hzb 0)
    have s1 := star (v 1) (u 1) (z 1) (hv1 1) (hub 1) (hzb 1)
    have s2 := star (v 2) (u 2) (z 2) (hv1 2) (hub 2) (hzb 2)
    rw [← hK] at s0 s1 s2
    have e : 2 * t * g = 2 * t * (v 0 * u 0) + 2 * t * (v 1 * u 1) + 2 * t * (v 2 * u 2) := by
      rw [← hlin']; ring
    rw [e]
    linarith
  have hsqrt : Real.sqrt S ≤ (1 + S) / 2 := by
    nlinarith [Real.sq_sqrt hS0, sq_nonneg (Real.sqrt S - 1)]
  rw [← hS, ← hg]
  have e2 : (3 / 2) * ((6 * β + 6 * β ^ 2) ^ 2 + 2 * (6 * β ^ 2)) = (3 / 2) * K := by rw [hK]
  rw [e2]
  nlinarith [hsqrt, hSle]

theorem sepFV_deformation_props (T : E3 → E3) (hT : ContDiff ℝ ∞ T) (hTc : HasCompactSupport T) : ∃ β t₀ : ℝ, 0 ≤ β ∧ 0 < t₀ ∧ t₀ ≤ 1 ∧ (∀ (x : E3) (i a : Fin 3), |jacMat T x i a| ≤ β) ∧ ∀ t : ℝ, |t| ≤ t₀ → Function.Injective (fun y : E3 => y + t • T y) ∧ ∀ x : E3, jacMat (fun y : E3 => y + t • T y) x = 1 + t • jacMat T x ∧ 1 / 2 ≤ (jacMat (fun y : E3 => y + t • T y) x).det :=
by
  have hT' : Differentiable ℝ T := hT.differentiable (by simp)
  have hc : Continuous (fderiv ℝ T) := hT.continuous_fderiv (by simp)
  have hs : HasCompactSupport (fderiv ℝ T) := hTc.fderiv ℝ
  obtain ⟨C₀, hC₀⟩ := hc.bounded_above_of_compact_support hs
  obtain ⟨β, hβdef⟩ : ∃ β : ℝ, β = max C₀ 0 := ⟨_, rfl⟩
  have hβ0 : 0 ≤ β := by rw [hβdef]; exact le_max_right _ _
  have hβ : ∀ x, ‖fderiv ℝ T x‖ ≤ β := fun x => by
    rw [hβdef]; exact (hC₀ x).trans (le_max_left _ _)
  
  have hJ : ∀ (x : E3) (i a : Fin 3), |jacMat T x i a| ≤ β := by
    intro x i a
    have h1 : |jacMat T x i a| ≤ ‖fderiv ℝ T x (e a)‖ := by
      simp only [jacMat, Matrix.of_apply]
      rw [← Real.norm_eq_abs]
      exact PiLp.norm_apply_le _ _
    have h2 : ‖fderiv ℝ T x (e a)‖ ≤ ‖fderiv ℝ T x‖ * ‖e a‖ :=
      ContinuousLinearMap.le_opNorm _ _
    have h3 : ‖e a‖ = 1 := by simp [e, EuclideanSpace.norm_single]
    rw [h3, mul_one] at h2
    linarith [hβ x]
  
  have hjac : ∀ (t : ℝ) (x : E3),
      jacMat (fun y : E3 => y + t • T y) x = 1 + t • jacMat T x := by
    intro t x
    have hD : HasFDerivAt (fun y : E3 => y + t • T y)
        (ContinuousLinearMap.id ℝ E3 + t • fderiv ℝ T x) x :=
      (hasFDerivAt_id x).add ((hT' x).hasFDerivAt.const_smul t)
    ext i a
    simp only [jacMat, Matrix.of_apply, hD.fderiv]
    simp [Matrix.one_apply, e, EuclideanSpace.single_apply]
  
  have hinj : ∀ t : ℝ, |t| * β < 1 → Function.Injective (fun y : E3 => y + t • T y) := by
    intro t ht y y' hyy
    simp only at hyy
    have hL : LipschitzWith ⟨β, hβ0⟩ T := lipschitzWith_of_nnnorm_fderiv_le hT' (fun x => by
      rw [← NNReal.coe_le_coe, coe_nnnorm]; exact hβ x)
    have h1 : y - y' = t • (T y' - T y) := by
      rw [smul_sub]
      calc y - y' = (y + t • T y) - t • T y - y' := by abel
        _ = (y' + t • T y') - t • T y - y' := by rw [hyy]
        _ = t • T y' - t • T y := by abel
    have h2 : ‖T y' - T y‖ ≤ β * ‖y' - y‖ := hL.norm_sub_le y' y
    have h3 : ‖y - y'‖ ≤ |t| * β * ‖y - y'‖ := by
      calc ‖y - y'‖ = |t| * ‖T y' - T y‖ := by rw [h1, norm_smul, Real.norm_eq_abs]
        _ ≤ |t| * (β * ‖y' - y‖) := mul_le_mul_of_nonneg_left h2 (abs_nonneg t)
        _ = |t| * β * ‖y - y'‖ := by rw [norm_sub_rev y' y]; ring
    have h5 := norm_nonneg (y - y')
    have h4 : ‖y - y'‖ = 0 := by
      refine le_antisymm ?_ h5
      nlinarith
    exact sub_eq_zero.mp (norm_eq_zero.mp h4)
  
  have hdet : ∀ m : Matrix (Fin 3) (Fin 3) ℝ, (∀ i a, |m i a| ≤ 1 / 100) →
      1 / 2 ≤ (1 + m).det := by
    intro m hm
    have hexp : (1 + m).det = 1 + (m 0 0 + m 1 1 + m 2 2)
        + (m 0 0 * m 1 1 + m 0 0 * m 2 2 + m 1 1 * m 2 2 - m 1 2 * m 2 1 - m 0 1 * m 1 0
            - m 0 2 * m 2 0)
        + (m 0 0 * m 1 1 * m 2 2 - m 0 0 * m 1 2 * m 2 1 - m 0 1 * m 1 0 * m 2 2
            + m 0 1 * m 1 2 * m 2 0 + m 0 2 * m 1 0 * m 2 1 - m 0 2 * m 1 1 * m 2 0) := by
      rw [Matrix.det_fin_three]
      simp [Matrix.one_apply]
      ring
    have P2 : ∀ x y : ℝ, |x| ≤ 1 / 100 → |y| ≤ 1 / 100 → |x * y| ≤ 1 / 10000 := by
      intro x y hx hy
      rw [abs_mul]
      calc |x| * |y| ≤ (1 / 100) * (1 / 100) := mul_le_mul hx hy (abs_nonneg _) (by norm_num)
        _ = 1 / 10000 := by norm_num
    have P3 : ∀ x y z : ℝ, |x| ≤ 1 / 100 → |y| ≤ 1 / 100 → |z| ≤ 1 / 100 →
        |x * y * z| ≤ 1 / 1000000 := by
      intro x y z hx hy hz
      rw [abs_mul, abs_mul]
      calc |x| * |y| * |z| ≤ (1 / 100) * (1 / 100) * (1 / 100) :=
            mul_le_mul (mul_le_mul hx hy (abs_nonneg _) (by norm_num)) hz (abs_nonneg _)
              (by norm_num)
        _ = 1 / 1000000 := by norm_num
    rw [hexp]
    have l1 := abs_le.mp (hm 0 0)
    have l2 := abs_le.mp (hm 1 1)
    have l3 := abs_le.mp (hm 2 2)
    have q1 := abs_le.mp (P2 _ _ (hm 0 0) (hm 1 1))
    have q2 := abs_le.mp (P2 _ _ (hm 0 0) (hm 2 2))
    have q3 := abs_le.mp (P2 _ _ (hm 1 1) (hm 2 2))
    have q4 := abs_le.mp (P2 _ _ (hm 1 2) (hm 2 1))
    have q5 := abs_le.mp (P2 _ _ (hm 0 1) (hm 1 0))
    have q6 := abs_le.mp (P2 _ _ (hm 0 2) (hm 2 0))
    have c1 := abs_le.mp (P3 _ _ _ (hm 0 0) (hm 1 1) (hm 2 2))
    have c2 := abs_le.mp (P3 _ _ _ (hm 0 0) (hm 1 2) (hm 2 1))
    have c3 := abs_le.mp (P3 _ _ _ (hm 0 1) (hm 1 0) (hm 2 2))
    have c4 := abs_le.mp (P3 _ _ _ (hm 0 1) (hm 1 2) (hm 2 0))
    have c5 := abs_le.mp (P3 _ _ _ (hm 0 2) (hm 1 0) (hm 2 1))
    have c6 := abs_le.mp (P3 _ _ _ (hm 0 2) (hm 1 1) (hm 2 0))
    linarith [l1.1, l2.1, l3.1, q1.1, q2.1, q3.1, q4.2, q5.2, q6.2,
      c1.1, c2.2, c3.2, c4.1, c5.1, c6.2]
  
  obtain ⟨t₀, ht₀def⟩ : ∃ t₀ : ℝ, t₀ = 1 / (100 * (β + 1)) := ⟨_, rfl⟩
  have hpos : 0 < 100 * (β + 1) := by positivity
  have ht₀ : 0 < t₀ := by rw [ht₀def]; positivity
  have hmul : t₀ * (100 * (β + 1)) = 1 := by
    rw [ht₀def]; field_simp
  have ht₀1 : t₀ ≤ 1 := by nlinarith
  have ht₀β : t₀ * β ≤ 1 / 100 := by nlinarith
  refine ⟨β, t₀, hβ0, ht₀, ht₀1, hJ, fun t ht => ⟨hinj t ?_, fun x => ⟨hjac t x, ?_⟩⟩⟩
  · have : |t| * β ≤ t₀ * β := mul_le_mul_of_nonneg_right ht hβ0
    linarith
  · rw [hjac t x]
    apply hdet
    intro i a
    rw [Matrix.smul_apply, smul_eq_mul, abs_mul]
    calc |t| * |jacMat T x i a| ≤ |t| * β := mul_le_mul_of_nonneg_left (hJ x i a) (abs_nonneg t)
      _ ≤ t₀ * β := mul_le_mul_of_nonneg_right ht hβ0
      _ ≤ 1 / 100 := ht₀β

theorem sepFV_piola_field (Φ : E3 → E3) (hΦ : ContDiff ℝ ∞ Φ) (C : Set E3) (hC : IsCompact C) (hΦC : ∀ x : E3, x ∉ C → Φ x = x) (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) : ContDiff ℝ ∞ (fun x : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) ∧ HasCompactSupport (fun x : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) ∧ ∀ x : E3, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (fun y : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ y).adjugate a i * X (Φ y) i)) x = (jacMat Φ x).det * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X (Φ x) :=
by
  classical
  
  have hadj : ∀ (J : Matrix (Fin 3) (Fin 3) ℝ) (a i : Fin 3),
      J.adjugate a i = J (i+1) (a+1) * J (i+2) (a+2) - J (i+1) (a+2) * J (i+2) (a+1) := by
    intro J a i
    fin_cases a <;> fin_cases i <;> simp [Matrix.adjugate_fin_three] <;> ring
  
  have hnull : ∀ (Y : E3 → E3) (x : E3), ContDiffAt ℝ ∞ Y x →
      (∀ a i : Fin 3, DifferentiableAt ℝ (fun z => (jacMat Y z).adjugate a i) x) ∧
      ∀ i : Fin 3, ∑ a : Fin 3, partialDeriv a (fun z => (jacMat Y z).adjugate a i) x = 0 := by
    intro Y x hYc
    have hD1 : ContDiffAt ℝ 1 (fderiv ℝ Y) x := hYc.fderiv_right (m := 1)
      (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
    have hDd : DifferentiableAt ℝ (fderiv ℝ Y) x := hD1.differentiableAt one_ne_zero
    have hsymm : IsSymmSndFDerivAt ℝ Y x :=
      hYc.isSymmSndFDerivAt (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
    obtain ⟨L, hB, hLsym⟩ : ∃ L : Fin 3 → Fin 3 → E3 →L[ℝ] ℝ,
        (∀ k a, HasFDerivAt (fun z => jacMat Y z k a) (L k a) x) ∧
        ∀ k a b, L k a (e b) = L k b (e a) := by
      refine ⟨fun k a => ((EuclideanSpace.proj k).comp
        (ContinuousLinearMap.apply ℝ E3 (e a))).comp (fderiv ℝ (fderiv ℝ Y) x), ?_, ?_⟩
      · intro k a
        have h := ((EuclideanSpace.proj k).comp
          (ContinuousLinearMap.apply ℝ E3 (e a))).hasFDerivAt.comp x hDd.hasFDerivAt
        convert h using 1
      · intro k a b
        simp only [ContinuousLinearMap.coe_comp', Function.comp_apply,
          ContinuousLinearMap.apply_apply]
        rw [hsymm (e b) (e a)]
    have hA : ∀ a i : Fin 3, HasFDerivAt (fun z => (jacMat Y z).adjugate a i)
        ((jacMat Y x (i+1) (a+1) • L (i+2) (a+2) + jacMat Y x (i+2) (a+2) • L (i+1) (a+1)) -
          (jacMat Y x (i+1) (a+2) • L (i+2) (a+1) + jacMat Y x (i+2) (a+1) • L (i+1) (a+2))) x := by
      intro a i
      have hfun : (fun z => (jacMat Y z).adjugate a i) = fun z =>
          jacMat Y z (i+1) (a+1) * jacMat Y z (i+2) (a+2) -
            jacMat Y z (i+1) (a+2) * jacMat Y z (i+2) (a+1) :=
        funext fun z => hadj (jacMat Y z) a i
      rw [hfun]
      exact ((hB (i+1) (a+1)).fun_mul (hB (i+2) (a+2))).fun_sub
        ((hB (i+1) (a+2)).fun_mul (hB (i+2) (a+1)))
    refine ⟨fun a i => (hA a i).differentiableAt, ?_⟩
    have h01 : ∀ k, L k 1 (e 0) = L k 0 (e 1) := fun k => hLsym k 1 0
    have h02 : ∀ k, L k 2 (e 0) = L k 0 (e 2) := fun k => hLsym k 2 0
    have h12 : ∀ k, L k 2 (e 1) = L k 1 (e 2) := fun k => hLsym k 2 1
    intro i
    simp only [partialDeriv, fun a => (hA a i).fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    fin_cases i <;>
    · simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceAdd, Fin.zero_eta, Fin.mk_one]
      simp only [h01, h02, h12]
      ring
  
  have hpiola : ∀ (Y : E3 → E3) (W : E3 → Fin 3 → ℝ) (x : E3),
      DifferentiableAt ℝ Y x →
      (∀ a i : Fin 3, DifferentiableAt ℝ (fun z => (jacMat Y z).adjugate a i) x) →
      (∀ i : Fin 3, DifferentiableAt ℝ (fun y => W y i) (Y x)) →
      (∀ i : Fin 3,
        ∑ a : Fin 3, partialDeriv a (fun z => (jacMat Y z).adjugate a i) x = 0) →
      ∑ a : Fin 3, partialDeriv a (fun z => ∑ i : Fin 3, (jacMat Y z).adjugate a i * W (Y z) i) x
        = (jacMat Y x).det * ∑ i : Fin 3, partialDeriv i (fun y => W y i) (Y x) := by
    intro Y W x hY hA hW hP
    have hchain : ∀ f : E3 → ℝ, DifferentiableAt ℝ f (Y x) → ∀ a : Fin 3,
        partialDeriv a (fun z => f (Y z)) x =
          ∑ k : Fin 3, jacMat Y x k a * partialDeriv k f (Y x) := by
      intro f hf a
      unfold partialDeriv
      rw [fderiv_comp' x hf hY, ContinuousLinearMap.comp_apply]
      have hv : ∀ v : E3, v = ∑ k : Fin 3, v k • e k := by
        intro v
        ext j
        fin_cases j <;> simp [Fin.sum_univ_three, e, EuclideanSpace.single_apply]
      conv_lhs => rw [hv (fderiv ℝ Y x (e a))]
      rw [map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_smul, smul_eq_mul]
      rfl
    have hWi : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => W (Y z) i) x :=
      fun i => (hW i).comp x hY
    have hprod : ∀ a : Fin 3,
        partialDeriv a (fun z => ∑ i : Fin 3, (jacMat Y z).adjugate a i * W (Y z) i) x
          = ∑ i : Fin 3, (partialDeriv a (fun z => (jacMat Y z).adjugate a i) x * W (Y x) i
            + (jacMat Y x).adjugate a i * partialDeriv a (fun z => W (Y z) i) x) := by
      intro a
      unfold partialDeriv
      rw [fderiv_fun_sum (fun i _ => (hA a i).fun_mul (hWi i)), ContinuousLinearMap.sum_apply]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [fderiv_fun_mul (hA a i) (hWi i)]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hc : ∀ a i : Fin 3, partialDeriv a (fun z => W (Y z) i) x =
        ∑ k : Fin 3, jacMat Y x k a * partialDeriv k (fun y => W y i) (Y x) :=
      fun a i => hchain (fun y => W y i) (hW i) a
    have hK : ∀ k i : Fin 3, ∑ a : Fin 3, jacMat Y x k a * (jacMat Y x).adjugate a i
        = (jacMat Y x).det * (1 : Matrix (Fin 3) (Fin 3) ℝ) k i := by
      intro k i
      rw [← Matrix.mul_apply, Matrix.mul_adjugate, Matrix.smul_apply, smul_eq_mul]
    have h00 := hK 0 0
    have h01 := hK 0 1
    have h02 := hK 0 2
    have h10 := hK 1 0
    have h11 := hK 1 1
    have h12 := hK 1 2
    have h20 := hK 2 0
    have h21 := hK 2 1
    have h22 := hK 2 2
    have hP0 := hP 0
    have hP1 := hP 1
    have hP2 := hP 2
    rw [Finset.sum_congr rfl (fun a _ => hprod a)]
    simp only [hc]
    simp only [Fin.sum_univ_three, Matrix.one_apply_eq] at h00 h11 h22 hP0 hP1 hP2 ⊢
    simp only [Fin.sum_univ_three, Matrix.one_apply_ne (by decide : (0 : Fin 3) ≠ 1),
      Matrix.one_apply_ne (by decide : (0 : Fin 3) ≠ 2), Matrix.one_apply_ne (by decide : (1 : Fin 3) ≠ 0),
      Matrix.one_apply_ne (by decide : (1 : Fin 3) ≠ 2), Matrix.one_apply_ne (by decide : (2 : Fin 3) ≠ 0),
      Matrix.one_apply_ne (by decide : (2 : Fin 3) ≠ 1)] at h01 h02 h10 h12 h20 h21
    linear_combination W (Y x) 0 * hP0 + W (Y x) 1 * hP1 + W (Y x) 2 * hP2
      + partialDeriv 0 (fun y => W y 0) (Y x) * h00
      + partialDeriv 0 (fun y => W y 1) (Y x) * h01
      + partialDeriv 0 (fun y => W y 2) (Y x) * h02
      + partialDeriv 1 (fun y => W y 0) (Y x) * h10
      + partialDeriv 1 (fun y => W y 1) (Y x) * h11
      + partialDeriv 1 (fun y => W y 2) (Y x) * h12
      + partialDeriv 2 (fun y => W y 0) (Y x) * h20
      + partialDeriv 2 (fun y => W y 1) (Y x) * h21
      + partialDeriv 2 (fun y => W y 2) (Y x) * h22
  
  have hD : ContDiff ℝ ∞ (fderiv ℝ Φ) := (contDiff_infty_iff_fderiv.1 hΦ).2
  have hJ : ∀ k l : Fin 3, ContDiff ℝ ∞ (fun x => jacMat Φ x k l) := by
    intro k l
    have h1 : ContDiff ℝ ∞ (fun x => fderiv ℝ Φ x (e l)) := hD.clm_apply contDiff_const
    exact (contDiff_piLp 2).1 h1 k
  have hAdjS : ∀ a i : Fin 3, ContDiff ℝ ∞ (fun x => (jacMat Φ x).adjugate a i) := by
    intro a i
    have hfun : (fun z => (jacMat Φ z).adjugate a i) = fun z =>
        jacMat Φ z (i+1) (a+1) * jacMat Φ z (i+2) (a+2) -
          jacMat Φ z (i+1) (a+2) * jacMat Φ z (i+2) (a+1) :=
      funext fun z => hadj (jacMat Φ z) a i
    rw [hfun]
    exact ((hJ _ _).mul (hJ _ _)).sub ((hJ _ _).mul (hJ _ _))
  have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun y => X y i) := fun i => (contDiff_piLp 2).1 hX i
  refine ⟨?_, ?_, ?_⟩
  · refine (contDiff_piLp 2).2 (fun a => ?_)
    show ContDiff ℝ ∞ fun x => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i
    exact ContDiff.sum (fun i _ => (hAdjS a i).mul ((hXi i).comp hΦ))
  · refine HasCompactSupport.intro (hC.union hXc.isCompact) ?_
    intro x hx
    rw [Set.mem_union, not_or] at hx
    have hΦx : Φ x = x := hΦC x hx.1
    have hX0 : X x = 0 := image_eq_zero_of_notMem_tsupport hx.2
    ext a
    show ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i = (0 : E3) a
    rw [hΦx, hX0]
    simp
  · intro x
    have h1 : Real.sqrt (Matrix.det (1 : Matrix (Fin 3) (Fin 3) ℝ)) = 1 := by
      rw [Matrix.det_one, Real.sqrt_one]
    simp only [sepDensDiv, h1, one_mul]
    obtain ⟨hA, hP⟩ := hnull Φ x (hΦ.contDiffAt)
    have hY : DifferentiableAt ℝ Φ x := hΦ.differentiable (by simp) x
    have hW : ∀ i : Fin 3, DifferentiableAt ℝ (fun y => X y i) (Φ x) :=
      fun i => (hXi i).differentiable (by simp) (Φ x)
    exact hpiola Φ (fun y i => X y i) x hY hA hW hP

theorem sepFV_transport_bound (K : Set E3) (hK : MeasurableSet K) (μ : Measure E3) (ν : E3 → E3) (hμ : ∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) (hνm : Measurable ν) (hν1 : ∀ x, ‖ν x‖ = 1) (hGG : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → ∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y = ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ) (Φ : E3 → E3) (hΦ : ContDiff ℝ ∞ Φ) (hinj : Function.Injective Φ) (hdet : ∀ x : E3, 0 < (jacMat Φ x).det) (R : ℝ) (hΦR : ∀ x : E3, Φ x ∈ Metric.ball (0 : E3) R → x ∈ Metric.ball (0 : E3) R) (hZ : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → ContDiff ℝ ∞ (fun x : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) ∧ HasCompactSupport (fun x : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) ∧ ∀ x : E3, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (fun y : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ y).adjugate a i * X (Φ y) i)) x = (jacMat Φ x).det * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X (Φ x)) : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (Φ '' K) (Metric.ball 0 R) ≤ ENNReal.ofReal (∫ x, (Metric.ball (0 : E3) R).indicator (fun y : E3 => Real.sqrt (∑ i : Fin 3, (∑ a : Fin 3, (jacMat Φ y).adjugate a i * ν y a) ^ 2)) x ∂μ) :=
by
  classical
  obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun y : E3 => Real.sqrt (∑ i : Fin 3,
      (∑ a : Fin 3, (jacMat Φ y).adjugate a i * ν y a) ^ 2) := ⟨_, rfl⟩
  
  have hdetEq : ∀ x : E3, (fderiv ℝ Φ x).det = (jacMat Φ x).det := by
    intro x
    show LinearMap.det (fderiv ℝ Φ x : E3 →ₗ[ℝ] E3) = _
    rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
    congr 1
    all_goals (ext i a; simp [LinearMap.toMatrix_apply, jacMat])
  
  have hCV : ∀ f : E3 → ℝ, ∫ y in Φ '' K, f y = ∫ x in K, (jacMat Φ x).det * f (Φ x) := by
    intro f
    rw [integral_image_eq_integral_abs_det_fderiv_smul volume hK
      (fun x _ => (hΦ.differentiable (by simp) x).hasFDerivAt.hasFDerivWithinAt) hinj.injOn f]
    refine integral_congr_ae (ae_of_all _ fun x => ?_)
    simp only [smul_eq_mul, hdetEq x, abs_of_pos (hdet x)]
  
  have hνsq : ∀ y : E3, ∑ a : Fin 3, (ν y a) ^ 2 = 1 := by
    intro y
    have h1 := hν1 y
    rw [EuclideanSpace.norm_eq] at h1
    have h2 := (Real.sqrt_eq_one).1 h1
    simpa [Real.norm_eq_abs, sq_abs] using h2
  have hνc : ∀ (y : E3) (a : Fin 3), |ν y a| ≤ 1 := by
    intro y a
    have h1 : (ν y a) ^ 2 ≤ ∑ b : Fin 3, (ν y b) ^ 2 :=
      Finset.single_le_sum (f := fun b => (ν y b) ^ 2) (fun b _ => sq_nonneg _)
        (Finset.mem_univ a)
    rw [hνsq y] at h1
    exact (sq_le_one_iff_abs_le_one _).1 h1
  
  have hJc : ∀ i a : Fin 3, Continuous (fun y => jacMat Φ y i a) := by
    intro i a
    have h1 : Continuous (fun y => fderiv ℝ Φ y (e a)) :=
      (hΦ.continuous_fderiv (by simp)).clm_apply continuous_const
    exact (EuclideanSpace.proj i).continuous.comp h1
  have hJcont : Continuous (fun y => jacMat Φ y) :=
    continuous_pi fun i => continuous_pi fun a => hJc i a
  have hAdjc : ∀ a i : Fin 3, Continuous (fun y => (jacMat Φ y).adjugate a i) := by
    intro a i
    exact (continuous_apply i).comp ((continuous_apply a).comp hJcont.matrix_adjugate)
  have hνmc : ∀ a : Fin 3, Measurable (fun y => ν y a) :=
    fun a => (EuclideanSpace.proj a).continuous.measurable.comp hνm
  have hhm : Measurable h := by
    rw [hhdef]
    refine Measurable.sqrt ?_
    refine Finset.measurable_sum _ (fun i _ => ?_)
    refine Measurable.pow_const ?_ 2
    exact Finset.measurable_sum _ (fun a _ => (hAdjc a i).measurable.mul (hνmc a))
  
  have hHc : Continuous (fun y : E3 => Real.sqrt (∑ i : Fin 3,
      (∑ a : Fin 3, |(jacMat Φ y).adjugate a i|) ^ 2)) := by
    refine Real.continuous_sqrt.comp ?_
    refine continuous_finset_sum _ (fun i _ => ?_)
    refine Continuous.pow ?_ 2
    exact continuous_finset_sum _ (fun a _ => (hAdjc a i).abs)
  have hhle : ∀ y : E3, h y ≤ Real.sqrt (∑ i : Fin 3,
      (∑ a : Fin 3, |(jacMat Φ y).adjugate a i|) ^ 2) := by
    intro y
    rw [hhdef]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    have hw : |∑ a : Fin 3, (jacMat Φ y).adjugate a i * ν y a| ≤
        ∑ a : Fin 3, |(jacMat Φ y).adjugate a i| := by
      calc _ ≤ ∑ a : Fin 3, |(jacMat Φ y).adjugate a i * ν y a| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ a : Fin 3, |(jacMat Φ y).adjugate a i| := by
          apply Finset.sum_le_sum
          intro a _
          rw [abs_mul]
          exact mul_le_of_le_one_right (abs_nonneg _) (hνc y a)
    calc (∑ a : Fin 3, (jacMat Φ y).adjugate a i * ν y a) ^ 2
        = |∑ a : Fin 3, (jacMat Φ y).adjugate a i * ν y a| ^ 2 := (sq_abs _).symm
      _ ≤ (∑ a : Fin 3, |(jacMat Φ y).adjugate a i|) ^ 2 :=
          pow_le_pow_left₀ (abs_nonneg _) hw 2
  have hhnn : ∀ y : E3, 0 ≤ h y := by
    intro y
    rw [hhdef]
    exact Real.sqrt_nonneg _
  have hG : Integrable (fun x => (Metric.ball (0 : E3) R).indicator h x) μ := by
    obtain ⟨C, hC⟩ :=
      (isCompact_closedBall (0 : E3) R).exists_bound_of_continuousOn hHc.continuousOn
    have hon : IntegrableOn h (Metric.ball (0 : E3) R) μ := by
      refine Measure.integrableOn_of_bounded (M := C) (hμ R).ne hhm.aestronglyMeasurable ?_
      refine (ae_restrict_iff' measurableSet_ball).2 (ae_of_all _ fun y hy => ?_)
      have h1 := hC y (Metric.ball_subset_closedBall hy)
      rw [Real.norm_eq_abs, abs_of_nonneg (hhnn y)]
      rw [Real.norm_eq_abs] at h1
      exact (hhle y).trans ((le_abs_self _).trans h1)
    exact hon.integrable_indicator measurableSet_ball
  have hGnn : 0 ≤ ∫ x, (Metric.ball (0 : E3) R).indicator h x ∂μ :=
    integral_nonneg (fun x => Set.indicator_nonneg (fun y _ => hhnn y) x)
  
  unfold sepPerG
  refine iSup₂_le (fun X hX => ?_)
  obtain ⟨hXs, hXc, hXB, hX1⟩ := hX
  obtain ⟨hZs, hZc, hZd⟩ := hZ X hXs hXc
  
  have hpt : ∀ x : E3, @inner ℝ E3 _ ((EuclideanSpace.equiv (Fin 3) ℝ).symm
      (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) (ν x) ≤
      (Metric.ball (0 : E3) R).indicator h x := by
    intro x
    have hinner : @inner ℝ E3 _ ((EuclideanSpace.equiv (Fin 3) ℝ).symm
        (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) (ν x) =
        ∑ i : Fin 3, X (Φ x) i * ∑ a : Fin 3, (jacMat Φ x).adjugate a i * ν x a := by
      simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
      simp [Fin.sum_univ_three, EuclideanSpace.equiv]
      ring
    rw [hinner]
    by_cases hx : x ∈ Metric.ball (0 : E3) R
    · rw [Set.indicator_of_mem hx, hhdef]
      have hu : ∑ i : Fin 3, (X (Φ x) i) ^ 2 ≤ 1 := by
        have h1 := hX1 (Φ x)
        simp [Fin.sum_univ_three, Matrix.one_apply] at h1
        simp only [Fin.sum_univ_three]
        nlinarith [h1]
      have hCS := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun i => X (Φ x) i)
        (fun i => ∑ a : Fin 3, (jacMat Φ x).adjugate a i * ν x a)
      have hw0 : 0 ≤ ∑ i : Fin 3, (∑ a : Fin 3, (jacMat Φ x).adjugate a i * ν x a) ^ 2 :=
        Finset.sum_nonneg (fun i _ => sq_nonneg _)
      have h2 : (∑ i : Fin 3, X (Φ x) i * ∑ a : Fin 3, (jacMat Φ x).adjugate a i * ν x a) ^ 2 ≤
          ∑ i : Fin 3, (∑ a : Fin 3, (jacMat Φ x).adjugate a i * ν x a) ^ 2 :=
        hCS.trans (mul_le_of_le_one_left hw0 hu)
      exact (le_abs_self _).trans (Real.abs_le_sqrt h2)
    · have hΦx : Φ x ∉ tsupport X := fun h' => hx (hΦR x (hXB h'))
      have hX0 : X (Φ x) = 0 := image_eq_zero_of_notMem_tsupport hΦx
      rw [Set.indicator_of_notMem hx, hX0]
      simp
  subst hhdef
  apply ENNReal.ofReal_le_ofReal
  rw [hCV]
  have e1 : ∫ x in K, (jacMat Φ x).det *
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X (Φ x) =
      ∫ x in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        (fun y : E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm
          (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ y).adjugate a i * X (Φ y) i)) x :=
    integral_congr_ae (ae_of_all _ fun x => (hZd x).symm)
  rw [e1, hGG _ hZs hZc]
  by_cases hF : Integrable (fun x => @inner ℝ E3 _ ((EuclideanSpace.equiv (Fin 3) ℝ).symm
      (fun a : Fin 3 => ∑ i : Fin 3, (jacMat Φ x).adjugate a i * X (Φ x) i)) (ν x)) μ
  · exact integral_mono hF hG hpt
  · exact (le_of_eq (integral_undef hF)).trans hGnn

theorem sepFV_first_order_vanish (μ : Measure E3) (V : Set E3) (hV : MeasurableSet V) (hμV : μ V < ⊤) (g : E3 → ℝ) (hg : Measurable g) (M : ℝ) (hgM : ∀ x, |g x| ≤ M) (hgV : ∀ x, x ∉ V → g x = 0) (h : ℝ → E3 → ℝ) (C t₀ : ℝ) (hC : 0 ≤ C) (ht₀ : 0 < t₀) (hpos : ∀ t x, 0 ≤ h t x) (hh : ∀ t : ℝ, |t| ≤ t₀ → ∀ x ∈ V, h t x ≤ 1 + t * g x + C * t ^ 2) (hle : ∀ t : ℝ, |t| ≤ t₀ → (μ V).toReal ≤ ∫ x, V.indicator (h t) x ∂μ) : ∫ x, g x ∂μ = 0 :=
by
  have hsupp : Function.support g ⊆ V := Function.support_subset_iff'.2 hgV
  have hgOn : IntegrableOn g V μ :=
    Measure.integrableOn_of_bounded (M := M) hμV.ne hg.aestronglyMeasurable
      (Filter.Eventually.of_forall (fun x => by rw [Real.norm_eq_abs]; exact hgM x))
  have hgI : Integrable g μ := (integrableOn_iff_integrable_of_support_subset hsupp).1 hgOn
  set I := ∫ x, g x ∂μ with hIdef
  set m := (μ V).toReal with hmdef
  have hm0 : 0 ≤ m := ENNReal.toReal_nonneg
  set K := C * m with hKdef
  have hK : 0 ≤ K := mul_nonneg hC hm0
  have key : ∀ t : ℝ, |t| ≤ t₀ → 0 ≤ t * I + K * t ^ 2 := by
    intro t ht
    have hcI : Integrable (fun x => V.indicator (fun _ => 1 + C * t ^ 2) x) μ :=
      (integrableOn_const hμV.ne).integrable_indicator hV
    have hGint : Integrable (fun x => V.indicator (fun _ => 1 + C * t ^ 2) x + t * g x) μ :=
      hcI.add (hgI.const_mul t)
    have hGval : ∫ x, (V.indicator (fun _ => 1 + C * t ^ 2) x + t * g x) ∂μ
        = m * (1 + C * t ^ 2) + t * I := by
      rw [integral_add hcI (hgI.const_mul t), integral_indicator_const _ hV, integral_const_mul,
        measureReal_def, smul_eq_mul]
    have hmono : ∫ x, V.indicator (h t) x ∂μ ≤
        ∫ x, (V.indicator (fun _ => 1 + C * t ^ 2) x + t * g x) ∂μ := by
      refine integral_mono_of_nonneg
        (Filter.Eventually.of_forall (fun x => Set.indicator_nonneg (fun x _ => hpos t x) x))
        hGint (Filter.Eventually.of_forall (fun x => ?_))
      by_cases hx : x ∈ V
      · simp only [Set.indicator_of_mem hx]
        have := hh t ht x hx
        linarith
      · simp only [Set.indicator_of_notMem hx, hgV x hx]
        simp
    have h1 := hle t ht
    rw [hGval] at hmono
    have e1 : m * (1 + C * t ^ 2) = m + K * t ^ 2 := by rw [hKdef]; ring
    linarith
  by_contra hI0
  have ha : 0 < |I| := abs_pos.mpr hI0
  set ε := min t₀ (|I| / (2 * (K + 1))) with hεdef
  have hε : 0 < ε := lt_min ht₀ (by positivity)
  have hεt : ε ≤ t₀ := min_le_left _ _
  have hεa : ε * (2 * (K + 1)) ≤ |I| := by
    have := min_le_right t₀ (|I| / (2 * (K + 1)))
    rw [le_div_iff₀ (by positivity)] at this
    exact this
  have hmain : 0 ≤ -(ε * |I|) + K * ε ^ 2 := by
    rcases lt_or_gt_of_ne hI0 with hneg | hposI
    · have := key ε (by rw [abs_of_pos hε]; exact hεt)
      rw [abs_of_neg hneg]
      have e2 : -(ε * -I) = ε * I := by ring
      rw [e2]
      exact this
    · have := key (-ε) (by rw [abs_neg, abs_of_pos hε]; exact hεt)
      rw [abs_of_pos hposI]
      have e2 : -ε * I + K * (-ε) ^ 2 = -(ε * I) + K * ε ^ 2 := by ring
      rw [e2] at this
      exact this
  nlinarith [mul_le_mul_of_nonneg_left hεa hε.le, mul_pos hε hε, mul_nonneg hK (sq_nonneg ε)]

theorem sepFV_integrand_matrix_form (T : E3 → E3) (x v : E3) (hT : DifferentiableAt ℝ T x) : ∑ i : Fin 3, partialDeriv i (fun z => T z i) x - @inner ℝ E3 _ v (fderiv ℝ T x v) = Matrix.trace (jacMat T x) - ∑ a : Fin 3, ∑ i : Fin 3, v a * jacMat T x a i * v i :=
by
  have hD := hT.hasFDerivAt
  have h1 : ∀ i : Fin 3, partialDeriv i (fun z => T z i) x = jacMat T x i i := by
    intro i
    have hc : HasFDerivAt (fun z => T z i)
        ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).comp (fderiv ℝ T x)) x :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt.comp x hD
    unfold partialDeriv
    rw [hc.fderiv]
    rfl
  have h2 : ∑ i : Fin 3, partialDeriv i (fun z => T z i) x = Matrix.trace (jacMat T x) := by
    rw [Finset.sum_congr rfl (fun i _ => h1 i)]
    rfl
  have hv : v = ∑ i : Fin 3, v i • e i := by
    ext j
    simp [e, EuclideanSpace.single_apply, Pi.single_apply]
  have h4 : ∀ a : Fin 3, (fderiv ℝ T x v) a = ∑ i : Fin 3, v i * jacMat T x a i := by
    intro a
    conv_lhs => rw [hv]
    simp [map_sum, map_smul, jacMat]
  have h5 : @inner ℝ E3 _ v (fderiv ℝ T x v)
      = ∑ a : Fin 3, ∑ i : Fin 3, v a * jacMat T x a i * v i := by
    rw [PiLp.inner_apply]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    simp only [RCLike.inner_apply, conj_trivial, h4 a, Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    ring
  rw [h2, h5]

theorem sepEuclMin_first_variation (K : Set E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (μ : Measure E3) (ν : E3 → E3) (hμ : ∀ r : ℝ, μ (Metric.ball 0 r) < ⊤) (hνm : Measurable ν) (hν1 : ∀ x, ‖ν x‖ = 1) (hGG : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → ∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y = ∫ x, @inner ℝ E3 _ (X x) (ν x) ∂μ) (hper : ∀ V : Set E3, IsOpen V → μ V = sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K V) (T : E3 → E3) (hT : ContDiff ℝ ∞ T) (hTc : HasCompactSupport T) : ∫ x, (∑ i : Fin 3, partialDeriv i (fun z => T z i) x - @inner ℝ E3 _ (ν x) (fderiv ℝ T x (ν x))) ∂μ = 0 :=
by
  classical
  
  obtain ⟨β, t₀, hβ, ht₀, ht₀1, hJb, hdef⟩ := sepFV_deformation_props T hT hTc
  obtain ⟨C₁, hC₁, hexp⟩ := sepFV_adj_expansion_bound β hβ
  
  obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_ball (0 : E3)).1 hTc.isCompact.isBounded
  have hoff : ∀ x : E3, x ∉ Metric.ball (0 : E3) R → x ∉ tsupport T :=
    fun x hx h => hx (hR h)
  have hBc : IsCompact (closure (Metric.ball (0 : E3) R)) :=
    (isCompact_closedBall (0 : E3) R).of_isClosed_subset isClosed_closure
      Metric.closure_ball_subset_closedBall
  
  obtain ⟨g, hgdef⟩ : ∃ g : E3 → ℝ, g = fun x => ∑ i : Fin 3, partialDeriv i (fun z => T z i) x
      - @inner ℝ E3 _ (ν x) (fderiv ℝ T x (ν x)) := ⟨_, rfl⟩
  obtain ⟨h, hhdef⟩ : ∃ h : ℝ → E3 → ℝ, h = fun t y => Real.sqrt (∑ i : Fin 3,
      (∑ a : Fin 3, (jacMat (fun y : E3 => y + t • T y) y).adjugate a i * ν y a) ^ 2) :=
    ⟨_, rfl⟩
  have hTd : ∀ y : E3, DifferentiableAt ℝ T y := fun y => hT.differentiable (by simp) y
  have hgform : ∀ y : E3, g y = Matrix.trace (jacMat T y)
      - ∑ a : Fin 3, ∑ i : Fin 3, ν y a * jacMat T y a i * ν y i := by
    intro y
    rw [hgdef]
    exact sepFV_integrand_matrix_form T y (ν y) (hTd y)
  
  have hνsq : ∀ y : E3, ∑ a : Fin 3, (ν y a) ^ 2 = 1 := by
    intro y
    have h1 := hν1 y
    rw [EuclideanSpace.norm_eq] at h1
    have h2 := (Real.sqrt_eq_one).1 h1
    simpa [Real.norm_eq_abs, sq_abs] using h2
  have hνc : ∀ (y : E3) (a : Fin 3), |ν y a| ≤ 1 := by
    intro y a
    have h1 : (ν y a) ^ 2 ≤ ∑ b : Fin 3, (ν y b) ^ 2 :=
      Finset.single_le_sum (f := fun b => (ν y b) ^ 2) (fun b _ => sq_nonneg _)
        (Finset.mem_univ a)
    rw [hνsq y] at h1
    exact (sq_le_one_iff_abs_le_one _).1 h1
  
  have hJc : ∀ i a : Fin 3, Continuous (fun y => jacMat T y i a) := by
    intro i a
    have h1 : Continuous (fun y => fderiv ℝ T y (e a)) :=
      (hT.continuous_fderiv (by simp)).clm_apply continuous_const
    exact (EuclideanSpace.proj i).continuous.comp h1
  have hνmc : ∀ a : Fin 3, Measurable (fun y => ν y a) :=
    fun a => (EuclideanSpace.proj a).continuous.measurable.comp hνm
  have hg : Measurable g := by
    have e1 : g = fun y => Matrix.trace (jacMat T y)
        - ∑ a : Fin 3, ∑ i : Fin 3, ν y a * jacMat T y a i * ν y i := funext hgform
    rw [e1]
    refine Measurable.sub ?_ ?_
    · change Measurable fun y => ∑ i : Fin 3, jacMat T y i i
      exact Finset.measurable_sum _ (fun i _ => (hJc i i).measurable)
    · refine Finset.measurable_sum _ (fun a _ => Finset.measurable_sum _ (fun i _ => ?_))
      exact ((hνmc a).mul (hJc a i).measurable).mul (hνmc i)
  have hgM : ∀ y : E3, |g y| ≤ 12 * β := by
    intro y
    rw [hgform y]
    have h1 : |Matrix.trace (jacMat T y)| ≤ 3 * β := by
      rw [Matrix.trace_fin_three]
      have := hJb y 0 0
      have := hJb y 1 1
      have := hJb y 2 2
      calc _ ≤ |jacMat T y 0 0| + |jacMat T y 1 1| + |jacMat T y 2 2| := abs_add_three _ _ _
        _ ≤ 3 * β := by linarith
    have h2 : |∑ a : Fin 3, ∑ i : Fin 3, ν y a * jacMat T y a i * ν y i| ≤ 9 * β := by
      calc _ ≤ ∑ a : Fin 3, |∑ i : Fin 3, ν y a * jacMat T y a i * ν y i| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ a : Fin 3, ∑ i : Fin 3, |ν y a * jacMat T y a i * ν y i| :=
            Finset.sum_le_sum (fun a _ => Finset.abs_sum_le_sum_abs _ _)
        _ ≤ ∑ a : Fin 3, ∑ i : Fin 3, β := by
            apply Finset.sum_le_sum
            intro a _
            apply Finset.sum_le_sum
            intro i _
            rw [abs_mul, abs_mul]
            have h3 := hνc y a
            have h4 := hνc y i
            have h5 := hJb y a i
            calc |ν y a| * |jacMat T y a i| * |ν y i| ≤ 1 * β * 1 := by gcongr
              _ = β := by ring
        _ = 9 * β := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            push_cast
            ring
    have h1' := abs_le.1 h1
    have h2' := abs_le.1 h2
    rw [abs_le]
    constructor <;> linarith
  have hgV : ∀ y : E3, y ∉ Metric.ball (0 : E3) R → g y = 0 := by
    intro y hy
    have hyT := hoff y hy
    have hfd0 : fderiv ℝ T y = 0 :=
      Function.notMem_support.1 (fun h' => hyT (support_fderiv_subset ℝ h'))
    have hJ0 : jacMat T y = 0 := by
      ext i a
      simp [jacMat, hfd0]
    rw [hgform y, hJ0]
    simp
  
  have hle : ∀ t : ℝ, |t| ≤ t₀ → (μ (Metric.ball (0 : E3) R)).toReal ≤
      ∫ x, (Metric.ball (0 : E3) R).indicator (h t) x ∂μ := by
    intro t ht
    obtain ⟨hinj, hjd⟩ := hdef t ht
    have hΦs : ContDiff ℝ ∞ (fun y : E3 => y + t • T y) := contDiff_id.add (hT.const_smul t)
    have hΦC : ∀ x : E3, x ∉ tsupport T → (fun y : E3 => y + t • T y) x = x := by
      intro x hx
      simp [image_eq_zero_of_notMem_tsupport hx]
    have hΦR : ∀ x : E3, (fun y : E3 => y + t • T y) x ∈ Metric.ball (0 : E3) R →
        x ∈ Metric.ball (0 : E3) R := by
      intro x hx
      by_contra hxB
      rw [hΦC x (hoff x hxB)] at hx
      exact hxB hx
    have hdet : ∀ x : E3, 0 < (jacMat (fun y : E3 => y + t • T y) x).det := by
      intro x
      have := (hjd x).2
      linarith
    have hZ := fun X hX hXc =>
      sepFV_piola_field (fun y : E3 => y + t • T y) hΦs (tsupport T) hTc.isCompact hΦC X hX hXc
    have htr := sepFV_transport_bound K hmin.1 μ ν hμ hνm hν1 hGG (fun y : E3 => y + t • T y)
      hΦs hinj hdet R hΦR hZ
    
    have hF' : MeasurableSet ((fun y : E3 => y + t • T y) '' K) :=
      MeasurableSet.image_of_continuousOn_injOn hmin.1 hΦs.continuous.continuousOn hinj.injOn
    have hsd : symmDiff K ((fun y : E3 => y + t • T y) '' K) ⊆ tsupport T := by
      intro x hx
      by_contra hxT
      rw [Set.mem_symmDiff] at hx
      rcases hx with ⟨hxK, hxF⟩ | ⟨hxF, hxK⟩
      · exact hxF ⟨x, hxK, hΦC x hxT⟩
      · obtain ⟨y, hyK, hyx⟩ := hxF
        have hxy : (fun y : E3 => y + t • T y) x = (fun y : E3 => y + t • T y) y := by
          rw [hΦC x hxT, hyx]
        have hxy' := hinj hxy
        apply hxK
        rw [hxy']
        exact hyK
    have hcmp := hmin.2.2 _ (Metric.ball (0 : E3) R) (tsupport T) hF' Metric.isOpen_ball hBc
      (Set.subset_univ _) hTc.isCompact hR hsd
    
    have hA0 : 0 ≤ ∫ x, (Metric.ball (0 : E3) R).indicator (h t) x ∂μ :=
      integral_nonneg (fun x => Set.indicator_nonneg (fun y _ => by
        rw [hhdef]
        exact Real.sqrt_nonneg _) x)
    have hμB : μ (Metric.ball (0 : E3) R) ≤
        ENNReal.ofReal (∫ x, (Metric.ball (0 : E3) R).indicator (h t) x ∂μ) := by
      rw [hper _ Metric.isOpen_ball, hhdef]
      exact hcmp.trans htr
    exact ENNReal.toReal_le_of_le_ofReal hA0 hμB
  
  have hh : ∀ t : ℝ, |t| ≤ t₀ → ∀ x ∈ Metric.ball (0 : E3) R,
      h t x ≤ 1 + t * g x + C₁ * t ^ 2 := by
    intro t ht x _
    have hjac := ((hdef t ht).2 x).1
    have h1 := hexp (jacMat T x) t (fun a => ν x a) (hJb x) (le_trans ht ht₀1) (hνsq x)
    rw [hhdef]
    simp only
    rw [hjac, hgform x]
    exact h1
  have hpos : ∀ t x, 0 ≤ h t x := by
    intro t x
    rw [hhdef]
    exact Real.sqrt_nonneg _
  
  have hfin := sepFV_first_order_vanish μ (Metric.ball (0 : E3) R) measurableSet_ball (hμ R) g hg
    (12 * β) hgM hgV h C₁ t₀ hC₁ ht₀ hpos hh hle
  rw [hgdef] at hfin
  exact hfin

theorem sepRadial_normal_vanish (μ : Measure E3) (ν : E3 → E3) (c : ℝ) (hνm : Measurable ν) (hν1 : ∀ x, ‖ν x‖ = 1) (hFV : ∀ T : E3 → E3, ContDiff ℝ ∞ T → HasCompactSupport T → ∫ x, (∑ i : Fin 3, partialDeriv i (fun z => T z i) x - @inner ℝ E3 _ (ν x) (fderiv ℝ T x (ν x))) ∂μ = 0) (hball : ∀ r : ℝ, 0 < r → μ (Metric.ball 0 r) = ENNReal.ofReal (c * r ^ 2)) : ∀ᵐ x ∂μ, @inner ℝ E3 _ x (ν x) = 0 :=
by
  
  have t1 : μ.map (fun x : E3 => ‖x‖ ^ 2) =
      ENNReal.ofReal c • (volume : Measure ℝ).restrict (Set.Ioi 0) := by
    have hqm : Measurable (fun x : E3 => ‖x‖ ^ 2) := (continuous_norm.pow 2).measurable
    set v : ℝ → ENNReal := fun s => if s ≤ 0 then 0 else ENNReal.ofReal (c * s) with hv
    have h1 : ∀ s, μ.map (fun x : E3 => ‖x‖ ^ 2) (Set.Iio s) = v s := by
      intro s
      rw [Measure.map_apply hqm measurableSet_Iio]
      by_cases hs : s ≤ 0
      · have : (fun x : E3 => ‖x‖ ^ 2) ⁻¹' Set.Iio s = ∅ := by
          ext x
          simp only [Set.mem_preimage, Set.mem_Iio, Set.mem_empty_iff_false, iff_false, not_lt]
          exact le_trans hs (by positivity)
        rw [this, measure_empty]
        simp [hv, hs]
      · push_neg at hs
        have : (fun x : E3 => ‖x‖ ^ 2) ⁻¹' Set.Iio s = Metric.ball 0 (Real.sqrt s) := by
          ext x
          simp only [Set.mem_preimage, Set.mem_Iio, mem_ball_zero_iff]
          rw [Real.lt_sqrt (norm_nonneg x)]
        rw [this, hball _ (Real.sqrt_pos.2 hs), Real.sq_sqrt hs.le]
        simp [hv, not_le.2 hs]
    have h2 : ∀ s, (ENNReal.ofReal c • (volume : Measure ℝ).restrict (Set.Ioi 0)) (Set.Iio s)
        = v s := by
      intro s
      rw [Measure.smul_apply, Measure.restrict_apply measurableSet_Iio, smul_eq_mul]
      by_cases hs : s ≤ 0
      · have : Set.Iio s ∩ Set.Ioi (0:ℝ) = ∅ := by
          ext x
          simp only [Set.mem_inter_iff, Set.mem_Iio, Set.mem_Ioi, Set.mem_empty_iff_false,
            iff_false, not_and, not_lt]
          intro h
          linarith
        rw [this, measure_empty, mul_zero]
        simp [hv, hs]
      · push_neg at hs
        have : Set.Iio s ∩ Set.Ioi (0:ℝ) = Set.Ioo 0 s := by
          ext x
          simp [and_comm]
        rw [this, Real.volume_Ioo, sub_zero]
        simp only [hv, not_le.2 hs, if_false]
        rcases le_or_gt 0 c with hc | hc
        · rw [ENNReal.ofReal_mul hc]
        · rw [ENNReal.ofReal_of_nonpos hc.le, zero_mul, ENNReal.ofReal_of_nonpos]
          nlinarith
    have hvfin : ∀ s, v s ≠ ⊤ := by
      intro s
      simp only [hv]
      split_ifs <;> simp
    apply Measure.ext_of_Ico'
    · intro a b hab
      refine ne_top_of_le_ne_top (hvfin b) ?_
      rw [← h1 b]
      exact measure_mono Set.Ico_subset_Iio_self
    · intro a b hab
      have hsub : Set.Ico a b = Set.Iio b \ Set.Iio a := by
        ext x
        simp [and_comm]
      have hab' : Set.Iio a ⊆ Set.Iio b := Set.Iio_subset_Iio hab.le
      rw [hsub, measure_diff hab' measurableSet_Iio.nullMeasurableSet (by rw [h1]; exact hvfin a),
        measure_diff hab' measurableSet_Iio.nullMeasurableSet (by rw [h2]; exact hvfin a),
        h1, h1, h2, h2]
  
  have t2 : ∀ (ψ : ℝ → ℝ), Differentiable ℝ ψ → ∀ (T : E3 → E3),
      (∀ z, T z = ψ (‖z‖ ^ 2) • z) → ∀ (x v : E3), ‖v‖ = 1 →
      (∑ i : Fin 3, partialDeriv i (fun z => T z i) x) - @inner ℝ E3 _ v (fderiv ℝ T x v)
        = 2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2))
          - 2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x v) ^ 2 := by
    intro ψ hψ T hT x v hv
    have hTf : T = fun z => ψ (‖z‖ ^ 2) • z := funext hT
    have hq : HasFDerivAt (fun z : E3 => ‖z‖ ^ 2) (2 • innerSL ℝ x) x :=
      (hasStrictFDerivAt_norm_sq x).hasFDerivAt
    have hs : HasFDerivAt (fun z : E3 => ψ (‖z‖ ^ 2)) (deriv ψ (‖x‖ ^ 2) • (2 • innerSL ℝ x)) x :=
      (hψ _).hasDerivAt.comp_hasFDerivAt x hq
    have hTd : HasFDerivAt T (ψ (‖x‖ ^ 2) • ContinuousLinearMap.id ℝ E3 +
        (deriv ψ (‖x‖ ^ 2) • 2 • innerSL ℝ x).smulRight x) x := by
      rw [hTf]
      exact hs.smul (hasFDerivAt_id x)
    have hTw : ∀ w, fderiv ℝ T x w
        = ψ (‖x‖ ^ 2) • w + (2 * deriv ψ (‖x‖ ^ 2) * @inner ℝ E3 _ x w) • x := by
      intro w
      rw [hTd.fderiv]
      simp
      ring_nf
    have hpi : ∀ i : Fin 3, partialDeriv i (fun z => T z i) x = (fderiv ℝ T x (e i)) i := by
      intro i
      have h := ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt).comp x hTd
      unfold partialDeriv
      rw [show (fun z => T z i) = (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) ∘ T from rfl, h.fderiv,
        hTd.fderiv]
      rfl
    have hdiv : ∑ i : Fin 3, partialDeriv i (fun z => T z i) x
        = 3 * ψ (‖x‖ ^ 2) + 2 * deriv ψ (‖x‖ ^ 2) * ‖x‖ ^ 2 := by
      simp only [hpi, hTw]
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three, Fin.sum_univ_three]
      simp [EuclideanSpace.inner_single_right]
      ring
    have hnor : @inner ℝ E3 _ v (fderiv ℝ T x v)
        = ψ (‖x‖ ^ 2) + 2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x v) ^ 2 := by
      rw [hTw, inner_add_right, real_inner_smul_right, real_inner_smul_right,
        real_inner_self_eq_norm_sq, hv, real_inner_comm v x]
      ring
    rw [hdiv, hnor]
    ring
  
  have t3 : ∀ b : ℝ, ContDiff ℝ ∞ (fun s : ℝ => expNegInvGlue (b - s)) ∧
      (∀ s : ℝ, b ≤ s → expNegInvGlue (b - s) = 0) ∧
      (∀ s : ℝ, b < s → deriv (fun s : ℝ => expNegInvGlue (b - s)) s = 0) ∧
      (∀ s : ℝ, s < b → deriv (fun s : ℝ => expNegInvGlue (b - s)) s < 0) ∧
      (∀ s : ℝ, deriv (fun s : ℝ => expNegInvGlue (b - s)) s ≤ 0) := by
    intro b
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · exact (expNegInvGlue.contDiff (n := ⊤)).comp (contDiff_const.sub contDiff_id)
    · intro s hs
      exact expNegInvGlue.zero_of_nonpos (by linarith)
    · intro s hs
      have : (fun s : ℝ => expNegInvGlue (b - s)) =ᶠ[𝓝 s] fun _ => (0:ℝ) := by
        filter_upwards [lt_mem_nhds hs] with t ht
        exact expNegInvGlue.zero_of_nonpos (by linarith)
      rw [this.deriv_eq, deriv_const]
    · intro s hs
      have hbs : 0 < b - s := by linarith
      have h1 : HasDerivAt (fun t : ℝ => b - t) (-1) s := by
        simpa using (hasDerivAt_id s).const_sub b
      have h3 : HasDerivAt (fun t : ℝ => Real.exp (-(b - t)⁻¹))
          (Real.exp (-(b - s)⁻¹) * -(- -1 / (b - s) ^ 2)) s := (h1.inv hbs.ne').neg.exp
      have hev : (fun t : ℝ => expNegInvGlue (b - t)) =ᶠ[𝓝 s]
          fun t => Real.exp (-(b - t)⁻¹) := by
        filter_upwards [gt_mem_nhds hs] with t ht
        have : 0 < b - t := by linarith
        simp [expNegInvGlue, not_le.2 this]
      rw [hev.deriv_eq, h3.deriv]
      apply mul_neg_of_pos_of_neg (Real.exp_pos _)
      have hp : 0 < 1 / (b - s) ^ 2 := by positivity
      have : -(-(-1:ℝ) / (b - s) ^ 2) = -(1 / (b - s) ^ 2) := by ring
      rw [this]
      linarith
    · intro s
      apply Antitone.deriv_nonpos
      exact expNegInvGlue.monotone.comp_antitone (fun x y h => sub_le_sub_left h b)
  
  have t4 : ∀ (ψ : ℝ → ℝ) (b : ℝ), ContDiff ℝ 1 ψ → (∀ s : ℝ, b ≤ s → ψ s = 0) →
      ∫ s in Set.Ioi (0:ℝ), (ψ s + s * deriv ψ s) = 0 := by
    intro ψ b hψ hzero
    have hdiff : Differentiable ℝ ψ := hψ.differentiable one_ne_zero
    have hD : ∀ s, HasDerivAt (fun t => t * ψ t) (ψ s + s * deriv ψ s) s := by
      intro s
      have := (hasDerivAt_id s).mul (hdiff s).hasDerivAt
      simpa using this
    have hf0 : ∀ s, b < s → ψ s + s * deriv ψ s = 0 := by
      intro s hs
      have hev : ψ =ᶠ[𝓝 s] fun _ => (0:ℝ) := by
        filter_upwards [lt_mem_nhds hs] with t ht using hzero t ht.le
      rw [hzero s hs.le, hev.deriv_eq, deriv_const]
      ring
    have hcont : Continuous (fun s => ψ s + s * deriv ψ s) :=
      hψ.continuous.add (continuous_id.mul (hψ.continuous_deriv le_rfl))
    have hint : IntegrableOn (fun s => ψ s + s * deriv ψ s) (Set.Ioi 0) := by
      have h1 : IntegrableOn (fun s => ψ s + s * deriv ψ s) (Set.Icc 0 (max b 0)) :=
        hcont.continuousOn.integrableOn_Icc
      have h2 : IntegrableOn (fun s => ψ s + s * deriv ψ s) (Set.Ioi (max b 0)) := by
        refine (integrableOn_zero).congr_fun
          (fun s hs => (hf0 s (lt_of_le_of_lt (le_max_left _ _) hs)).symm) measurableSet_Ioi
      refine (h1.union h2).mono_set ?_
      intro s hs
      by_cases h : s ≤ max b 0
      · exact Or.inl ⟨le_of_lt hs, h⟩
      · exact Or.inr (not_le.1 h)
    have hlim : Tendsto (fun t => t * ψ t) atTop (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_ge_atTop b] with t ht
      rw [hzero t ht, mul_zero]
    have := integral_Ioi_of_hasDerivAt_of_tendsto (f := fun t => t * ψ t) (a := 0)
      ((continuous_id.mul hψ.continuous).continuousWithinAt) (fun s _ => hD s) hint hlim
    rw [this]
    simp
  
  have t5 : ∀ (f : E3 → ℝ) (R M : ℝ), μ (Metric.ball 0 R) ≠ ⊤ → AEStronglyMeasurable f μ →
      (∀ x, |f x| ≤ M) → (∀ x, R ≤ ‖x‖ → f x = 0) → Integrable f μ := by
    intro f R M hμ hf hM hsupp
    have hg : Integrable ((Metric.ball (0:E3) R).indicator (fun _ => M)) μ :=
      (integrableOn_const hμ).integrable_indicator measurableSet_ball
    refine hg.mono' hf (ae_of_all _ fun x => ?_)
    by_cases hx : x ∈ Metric.ball (0:E3) R
    · rw [Set.indicator_of_mem hx, Real.norm_eq_abs]
      exact hM x
    · have hx' : R ≤ ‖x‖ := by
        rw [mem_ball_zero_iff, not_lt] at hx
        exact hx
      simp [hx, hsupp x hx']
  
  have hP : ∀ n : ℕ, ∀ᵐ x ∂μ, ‖x‖ ^ 2 < (n : ℝ) + 1 → @inner ℝ E3 _ x (ν x) = 0 := by
    intro n
    obtain ⟨b, hb⟩ : ∃ b : ℝ, b = (n : ℝ) + 1 := ⟨_, rfl⟩
    have hb1 : 1 ≤ b := by
      have := Nat.cast_nonneg (α := ℝ) n
      linarith
    obtain ⟨ψ, hψdef⟩ : ∃ ψ : ℝ → ℝ, ψ = fun s => expNegInvGlue (b - s) := ⟨_, rfl⟩
    obtain ⟨hψs, hψ0', hψd0, hψneg, hψle⟩ := t3 b
    rw [← hψdef] at hψs hψd0 hψneg hψle
    have hψ0 : ∀ s, b ≤ s → ψ s = 0 := fun s hs => by rw [hψdef]; exact hψ0' s hs
    have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have hψ1 : ContDiff ℝ 1 ψ := hψs.of_le h1inf
    have hdiffψ : Differentiable ℝ ψ := hψ1.differentiable one_ne_zero
    have hdc : Continuous (deriv ψ) := hψ1.continuous_deriv le_rfl
    have hψc : Continuous ψ := hψ1.continuous
    obtain ⟨R, hR⟩ : ∃ R : ℝ, R = b + 1 := ⟨_, rfl⟩
    have hR0 : 0 < R := by linarith
    have hstar : ∀ x : E3, R ≤ ‖x‖ → b < ‖x‖ ^ 2 := by
      intro x hx
      nlinarith
    have hTs : ContDiff ℝ ∞ (fun z : E3 => ψ (‖z‖ ^ 2) • z) :=
      (hψs.comp (contDiff_norm_sq ℝ)).smul contDiff_id
    have hTc : HasCompactSupport (fun z : E3 => ψ (‖z‖ ^ 2) • z) := by
      apply HasCompactSupport.intro (isCompact_closedBall (0:E3) R)
      intro x hx
      rw [mem_closedBall_zero_iff, not_le] at hx
      show ψ (‖x‖ ^ 2) • x = 0
      rw [hψ0 _ (hstar x hx.le).le, zero_smul]
    have hint0 := hFV _ hTs hTc
    have hI : ∀ x, (∑ i : Fin 3, partialDeriv i (fun z => (fun z : E3 => ψ (‖z‖ ^ 2) • z) z i) x
        - @inner ℝ E3 _ (ν x) (fderiv ℝ (fun z : E3 => ψ (‖z‖ ^ 2) • z) x (ν x)))
        = 2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2))
          + -(2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x (ν x)) ^ 2) := by
      intro x
      rw [t2 ψ hdiffψ _ (fun z => rfl) x (ν x) (hν1 x)]
      ring
    have hGc : Continuous (fun s : ℝ => 2 * (ψ s + s * deriv ψ s)) :=
      continuous_const.mul (hψc.add (continuous_id.mul hdc))
    have hG0 : ∀ s, b < s → 2 * (ψ s + s * deriv ψ s) = 0 := by
      intro s hs
      rw [hψ0 s hs.le, hψd0 s hs]
      ring
    have hμR : μ (Metric.ball 0 R) ≠ ⊤ := by
      rw [hball R hR0]
      exact ENNReal.ofReal_ne_top
    have hin : ∀ x : E3, ‖x‖ < R → ‖x‖ ^ 2 ∈ Set.Icc 0 (R ^ 2) := fun x hx =>
      ⟨by positivity, by nlinarith [norm_nonneg x]⟩
    have h0mem : (0:ℝ) ∈ Set.Icc 0 (R ^ 2) := ⟨le_rfl, by positivity⟩
    obtain ⟨C₁, hC₁⟩ := (isCompact_Icc (a := (0:ℝ)) (b := R ^ 2)).exists_bound_of_continuousOn
      hGc.continuousOn
    obtain ⟨D, hD⟩ := (isCompact_Icc (a := (0:ℝ)) (b := R ^ 2)).exists_bound_of_continuousOn
      hdc.continuousOn
    have hC₁0 : 0 ≤ C₁ := le_trans (norm_nonneg _) (hC₁ 0 h0mem)
    have hD0 : 0 ≤ D := le_trans (norm_nonneg _) (hD 0 h0mem)
    have hint1 : Integrable
        (fun x : E3 => 2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2))) μ := by
      refine t5 _ R C₁ hμR (hGc.comp (continuous_norm.pow 2)).aestronglyMeasurable ?_ ?_
      · intro x
        by_cases hx : ‖x‖ < R
        · have := hC₁ _ (hin x hx)
          rw [Real.norm_eq_abs] at this
          exact this
        · rw [hG0 _ (hstar x (not_lt.1 hx)), abs_zero]
          exact hC₁0
      · intro x hx
        exact hG0 _ (hstar x hx)
    have hint2 : Integrable
        (fun x : E3 => -(2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x (ν x)) ^ 2)) μ := by
      have hm : Measurable
          (fun x : E3 => -(2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x (ν x)) ^ 2)) :=
        ((measurable_const.mul (hdc.comp (continuous_norm.pow 2)).measurable).mul
          ((measurable_id.inner hνm).pow_const 2)).neg
      refine t5 _ R (2 * D * R ^ 2) hμR hm.aestronglyMeasurable ?_ ?_
      · intro x
        by_cases hx : ‖x‖ < R
        · have hd := hD _ (hin x hx)
          rw [Real.norm_eq_abs] at hd
          have hi := abs_real_inner_le_norm x (ν x)
          rw [hν1, mul_one] at hi
          have hi2 : (@inner ℝ E3 _ x (ν x)) ^ 2 ≤ ‖x‖ ^ 2 := by
            nlinarith [abs_nonneg (@inner ℝ E3 _ x (ν x)), sq_abs (@inner ℝ E3 _ x (ν x))]
          have hx2 : ‖x‖ ^ 2 ≤ R ^ 2 := (hin x hx).2
          rw [abs_neg, abs_mul, abs_mul, abs_two,
            abs_of_nonneg (sq_nonneg (@inner ℝ E3 _ x (ν x)))]
          have h3 : |deriv ψ (‖x‖ ^ 2)| * (@inner ℝ E3 _ x (ν x)) ^ 2 ≤ D * R ^ 2 :=
            mul_le_mul hd (hi2.trans hx2) (sq_nonneg _) hD0
          nlinarith
        · rw [hψd0 _ (hstar x (not_lt.1 hx))]
          simp only [mul_zero, zero_mul, neg_zero, abs_zero]
          positivity
      · intro x hx
        rw [hψd0 _ (hstar x hx)]
        ring
    have hf1zero : ∫ x, 2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2)) ∂μ = 0 := by
      have hm : ∫ x, 2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2)) ∂μ
          = ∫ s, 2 * (ψ s + s * deriv ψ s) ∂(μ.map (fun x : E3 => ‖x‖ ^ 2)) :=
        (integral_map (continuous_norm.pow 2).measurable.aemeasurable
          hGc.aestronglyMeasurable).symm
      rw [hm, t1, integral_smul_measure, integral_const_mul, t4 ψ b hψ1 hψ0, mul_zero, smul_zero]
    have hsum : ∫ x, (2 * (ψ (‖x‖ ^ 2) + ‖x‖ ^ 2 * deriv ψ (‖x‖ ^ 2))
        + -(2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x (ν x)) ^ 2)) ∂μ = 0 := by
      rw [← hint0]
      congr 1
      funext x
      exact (hI x).symm
    rw [integral_add hint1 hint2, hf1zero, zero_add] at hsum
    have hnn : (0 : E3 → ℝ) ≤
        fun x : E3 => -(2 * deriv ψ (‖x‖ ^ 2) * (@inner ℝ E3 _ x (ν x)) ^ 2) := by
      intro x
      have := hψle (‖x‖ ^ 2)
      have := sq_nonneg (@inner ℝ E3 _ x (ν x))
      simp only [Pi.zero_apply]
      nlinarith
    have hae := (integral_eq_zero_iff_of_nonneg hnn hint2).1 hsum
    filter_upwards [hae] with x hx hxb
    have hd : deriv ψ (‖x‖ ^ 2) < 0 := hψneg _ (by rw [hb]; exact hxb)
    simp only [Pi.zero_apply] at hx
    rcases mul_eq_zero.1 (neg_eq_zero.1 hx) with h | h
    · exfalso
      linarith
    · exact (pow_eq_zero_iff two_ne_zero).1 h
  
  have hall := ae_all_iff.2 hP
  filter_upwards [hall] with x hx
  obtain ⟨n, hn⟩ := exists_nat_gt (‖x‖ ^ 2)
  exact hx n (by linarith)

theorem sepCone_of_radial_flux (K : Set E3) (hK : MeasurableSet K) (hflux : ∀ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → ∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (fun z => ψ z • z) y = 0) : ∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ K} K) = 0 :=
by
  
  have s1 : ∀ (φ : E3 → ℝ) (t : ℝ), 0 < t →
      ∫ z in {z : E3 | t • z ∈ K}, φ z = t⁻¹ ^ 3 * ∫ y in K, φ (t⁻¹ • y) := by
    intro φ t ht
    have hKt : MeasurableSet {z : E3 | t • z ∈ K} := hK.preimage (measurable_const_smul t)
    rw [← integral_indicator hKt, ← integral_indicator hK]
    have hpt : ∀ z : E3, Set.indicator {z : E3 | t • z ∈ K} φ z =
        K.indicator (fun y => φ (t⁻¹ • y)) (t • z) := by
      intro z
      by_cases hz : t • z ∈ K
      · rw [Set.indicator_of_mem (show z ∈ {z : E3 | t • z ∈ K} from hz),
          Set.indicator_of_mem hz, inv_smul_smul₀ ht.ne']
      · rw [Set.indicator_of_notMem (show z ∉ {z : E3 | t • z ∈ K} from hz),
          Set.indicator_of_notMem hz]
    simp_rw [hpt]
    rw [Measure.integral_comp_smul volume (fun y => K.indicator (fun y => φ (t⁻¹ • y)) y) t]
    rw [finrank_euclideanSpace, Fintype.card_fin, smul_eq_mul, abs_of_pos (by positivity),
      inv_pow]
  
  have s2 : ∀ (φ : E3 → ℝ), Differentiable ℝ φ → ∀ (s : ℝ) (y : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (fun z => φ (s • z) • z) y
        = 3 * φ (s • y) + s * fderiv ℝ φ (s • y) y := by
    intro φ hφ s y
    have hψ : HasFDerivAt (fun z : E3 => φ (s • z))
        ((fderiv ℝ φ (s • y)).comp (s • ContinuousLinearMap.id ℝ E3)) y := by
      have h1 : HasFDerivAt (fun z : E3 => s • z) (s • ContinuousLinearMap.id ℝ E3) y :=
        (hasFDerivAt_id y).const_smul s
      exact (hφ (s • y)).hasFDerivAt.comp y h1
    have hi : ∀ i : Fin 3, partialDeriv i (fun z => φ (s • z) * z i) y
        = φ (s • y) + s * fderiv ℝ φ (s • y) (e i) * y i := by
      intro i
      have hproj : HasFDerivAt (fun z : E3 => z i) (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) y :=
        (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt
      have hprod : HasFDerivAt (fun z : E3 => φ (s • z) * z i)
          (φ (s • y) • (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) +
            y i • (fderiv ℝ φ (s • y)).comp (s • ContinuousLinearMap.id ℝ E3)) y :=
        hψ.mul hproj
      unfold partialDeriv
      rw [hprod.fderiv]
      simp [e, EuclideanSpace.single_apply]
      ring
    have hy : ∑ i : Fin 3, y i • e i = y := by
      have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr y
      simpa [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using this
    have hL : fderiv ℝ φ (s • y) y = ∑ i : Fin 3, y i * fderiv ℝ φ (s • y) (e i) := by
      calc fderiv ℝ φ (s • y) y = fderiv ℝ φ (s • y) (∑ i : Fin 3, y i • e i) := by rw [hy]
        _ = _ := by simp [map_sum, map_smul, smul_eq_mul]
    rw [sepDensDiv]
    simp only [Matrix.det_one, Real.sqrt_one, one_mul, PiLp.smul_apply, smul_eq_mul]
    simp only [hi, hL, Fin.sum_univ_three]
    ring
  
  have s3 : ∀ (φ : E3 → ℝ), ContDiff ℝ ∞ φ → HasCompactSupport φ → ∀ s : ℝ, 0 < s →
      HasDerivAt (fun r : ℝ => r ^ 3 * ∫ y in K, φ (r • y))
        (s ^ 2 * ∫ y in K, (3 * φ (s • y) + s * fderiv ℝ φ (s • y) y)) s := by
    intro φ hφ hφc s hs
    have hdiff : Differentiable ℝ φ := hφ.differentiable (by simp)
    have hcfd : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv (by simp)
    obtain ⟨R₀, hR₀⟩ : ∃ R₀ : ℝ, tsupport φ ⊆ closedBall 0 R₀ :=
      (Metric.isBounded_iff_subset_closedBall 0).1 hφc.isCompact.isBounded
    set R : ℝ := max R₀ 0 with hRdef
    have hR0 : 0 ≤ R := le_max_right _ _
    have hRsupp : tsupport φ ⊆ closedBall 0 R :=
      hR₀.trans (closedBall_subset_closedBall (le_max_left _ _))
    obtain ⟨M, hM⟩ : ∃ M, ∀ x, ‖fderiv ℝ φ x‖ ≤ M :=
      hcfd.bounded_above_of_compact_support (hφc.fderiv (𝕜 := ℝ))
    have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM 0)
    set ρ : ℝ := 2 * R / s with hρdef
    have hρ0 : 0 ≤ ρ := by positivity
    have hρs : s / 2 * ρ = R := by rw [hρdef]; field_simp
    set μ : Measure E3 := volume.restrict K with hμ
    set bound : E3 → ℝ := (closedBall (0 : E3) ρ).indicator (fun _ => M * ρ) with hbound
    have hF_meas : ∀ᶠ r in 𝓝 s, AEStronglyMeasurable (fun y : E3 => φ (r • y)) μ :=
      Filter.Eventually.of_forall
        (fun r => (hφ.continuous.comp (continuous_const_smul r)).aestronglyMeasurable)
    have hF_int : Integrable (fun y : E3 => φ (s • y)) μ :=
      ((hφ.continuous.comp (continuous_const_smul s)).integrable_of_hasCompactSupport
        (hφc.comp_smul hs.ne')).integrableOn
    have hF'_meas : AEStronglyMeasurable (fun y : E3 => fderiv ℝ φ (s • y) y) μ :=
      ((hcfd.comp (continuous_const_smul s)).clm_apply continuous_id).aestronglyMeasurable
    have h_bound : ∀ᵐ y ∂μ, ∀ r ∈ ball s (s / 2), ‖fderiv ℝ φ (r • y) y‖ ≤ bound y := by
      refine Filter.Eventually.of_forall (fun y r hr => ?_)
      rw [mem_ball, Real.dist_eq] at hr
      have hr' : s / 2 < r := by
        have := (abs_lt.1 hr).1
        linarith
      have hrpos : 0 < r := by linarith
      by_cases hy : ‖y‖ ≤ ρ
      · rw [hbound, Set.indicator_of_mem (mem_closedBall_zero_iff.2 hy)]
        exact (ContinuousLinearMap.le_opNorm _ _).trans
          (mul_le_mul (hM _) hy (norm_nonneg _) hM0)
      · push_neg at hy
        have hnot : r • y ∉ tsupport φ := by
          intro hmem
          have h1 := mem_closedBall_zero_iff.1 (hRsupp hmem)
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos] at h1
          nlinarith [mul_pos hrpos (sub_pos.2 hy), mul_nonneg (sub_nonneg.2 hr'.le) hρ0]
        have h0 : fderiv ℝ φ (r • y) = 0 := by
          by_contra h
          exact hnot (support_fderiv_subset ℝ (Function.mem_support.2 h))
        rw [h0, ContinuousLinearMap.zero_apply, norm_zero, hbound,
          Set.indicator_of_notMem (fun h => by
            have := mem_closedBall_zero_iff.1 h
            linarith)]
    have bound_int : Integrable bound μ :=
      ((integrable_indicator_iff measurableSet_closedBall).2
        (integrableOn_const measure_closedBall_lt_top.ne)).restrict
    have h_diff : ∀ᵐ y ∂μ, ∀ r ∈ ball s (s / 2),
        HasDerivAt (fun r : ℝ => φ (r • y)) (fderiv ℝ φ (r • y) y) r := by
      refine Filter.Eventually.of_forall (fun y r _ => ?_)
      have h := (hdiff (r • y)).hasFDerivAt.comp_hasDerivAt r ((hasDerivAt_id r).smul_const y)
      simpa using h
    obtain ⟨hint', hderiv⟩ := hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (μ := μ) (F := fun r y => φ (r • y)) (F' := fun r y => fderiv ℝ φ (r • y) y)
      (ball_mem_nhds s (half_pos hs)) hF_meas hF_int hF'_meas h_bound bound_int h_diff
    have hprod := (hasDerivAt_pow 3 s).mul hderiv
    convert hprod using 1
    rw [integral_add (hF_int.const_mul 3) (hint'.const_mul s), integral_const_mul,
      integral_const_mul]
    norm_num
    ring
  
  intro t ht
  have hKt : MeasurableSet {z : E3 | t • z ∈ K} := hK.preimage (measurable_const_smul t)
  have key : ∀ φ : E3 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
      ∫ z in {z : E3 | t • z ∈ K}, φ z = ∫ z in K, φ z := by
    intro φ hφ hφc
    have hdiff : Differentiable ℝ φ := hφ.differentiable (by simp)
    have hH0 : ∀ r ∈ Set.Ioi (0 : ℝ),
        HasDerivAt (fun r : ℝ => r ^ 3 * ∫ y in K, φ (r • y)) 0 r := by
      intro r hr
      have hr' : 0 < r := hr
      have h3 := s3 φ hφ hφc r hr'
      have hint : ∫ y in K, (3 * φ (r • y) + r * fderiv ℝ φ (r • y) y) = 0 := by
        have h := hflux (fun z => φ (r • z)) (hφ.comp (contDiff_const_smul r))
          (hφc.comp_smul hr'.ne')
        refine Eq.trans ?_ h
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        exact (s2 φ hdiff r y).symm
      rw [hint, mul_zero] at h3
      exact h3
    have hconst := IsOpen.is_const_of_deriv_eq_zero isOpen_Ioi isPreconnected_Ioi
      (fun r hr => (hH0 r hr).differentiableAt.differentiableWithinAt)
      (fun r hr => (hH0 r hr).deriv) (inv_pos.2 ht) (one_pos : (0 : ℝ) < 1)
    rw [s1 φ t ht]
    simpa only [one_pow, one_mul, one_smul] using hconst
  
  set f : E3 → ℝ := fun x => Set.indicator {z : E3 | t • z ∈ K} (fun _ => (1 : ℝ)) x -
    K.indicator (fun _ => (1 : ℝ)) x with hfdef
  have hf : LocallyIntegrable f volume :=
    ((locallyIntegrable_const (1 : ℝ)).indicator hKt).sub
      ((locallyIntegrable_const (1 : ℝ)).indicator hK)
  have hzero : ∀ g : E3 → ℝ, ContDiff ℝ ∞ g → HasCompactSupport g → ∫ x, g x • f x = 0 := by
    intro g hg hgc
    have hgi : Integrable g := hg.continuous.integrable_of_hasCompactSupport hgc
    have e1 : (fun x => g x • f x) =
        fun x => Set.indicator {z : E3 | t • z ∈ K} g x - K.indicator g x := by
      funext x
      simp only [hfdef, smul_eq_mul, mul_sub]
      have a1 : ∀ S : Set E3, g x * S.indicator (fun _ => (1 : ℝ)) x = S.indicator g x := by
        intro S
        by_cases h : x ∈ S
        · rw [Set.indicator_of_mem h, Set.indicator_of_mem h, mul_one]
        · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem h, mul_zero]
      rw [a1, a1]
    rw [e1, integral_sub (hgi.indicator hKt) (hgi.indicator hK), integral_indicator hKt,
      integral_indicator hK, key g hg hgc, sub_self]
  have hae := ae_eq_zero_of_integral_contDiff_smul_eq_zero hf hzero
  rw [ae_iff] at hae
  refine measure_mono_null ?_ hae
  intro x hx
  rcases Set.mem_symmDiff.1 hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · show f x ≠ 0
    rw [hfdef]
    simp only [Set.indicator_of_mem h1, Set.indicator_of_notMem h2]
    norm_num
  · show f x ≠ 0
    rw [hfdef]
    simp only [Set.indicator_of_mem h1, Set.indicator_of_notMem h2]
    norm_num

theorem sepEuclMin_cone_of_const_density (K : Set E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (c : ℝ) (hc : ∀ r : ℝ, 0 < r → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 r) = ENNReal.ofReal (c * r ^ 2)) : ∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ K} K) = 0 :=
by
  have hK : MeasurableSet K := hmin.1
  have hfin : ∀ r : ℝ, 0 < r →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 r) < ⊤ := by
    intro r hr
    rw [hc r hr]
    exact ENNReal.ofReal_lt_top
  obtain ⟨μ, ν, hμ, hνm, hν1, hGG, hper⟩ := sepGaussGreen_measure K hK hfin
  have hFV := fun T hT hTc =>
    sepEuclMin_first_variation K hmin μ ν hμ hνm hν1 hGG hper T hT hTc
  have hball : ∀ r : ℝ, 0 < r → μ (Metric.ball 0 r) = ENNReal.ofReal (c * r ^ 2) := by
    intro r hr
    rw [hper _ Metric.isOpen_ball, hc r hr]
  have hae := sepRadial_normal_vanish μ ν c hνm hν1 hFV hball
  apply sepCone_of_radial_flux K hK
  intro ψ hψ hψc
  have hX : ContDiff ℝ ∞ (fun z : E3 => ψ z • z) := hψ.smul contDiff_id
  have hXc : HasCompactSupport (fun z : E3 => ψ z • z) := hψc.smul_right
  rw [hGG _ hX hXc]
  have h0 : (fun x : E3 => @inner ℝ E3 _ (ψ x • x) (ν x)) =ᵐ[μ] fun _ => (0 : ℝ) := by
    filter_upwards [hae] with x hx
    rw [real_inner_smul_left, hx, mul_zero]
  rw [integral_congr_ae h0, integral_zero]

theorem sepMeasBdry_invariant (K : Set E3) (v : E3) (hcone : ∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ K} K) = 0) (hv : ∀ s : ℝ, volume (symmDiff {z : E3 | z + s • v ∈ K} K) = 0) : (∀ t : ℝ, 0 < t → ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) → ∀ N ∈ 𝓝 (t • z), volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) ∧ (∀ s : ℝ, ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) → ∀ N ∈ 𝓝 (z + s • v), volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) :=
by
  have T : ∀ (f : E3 → E3) (z : E3), Continuous f →
      (∀ S : Set E3, volume S = 0 → volume (f ⁻¹' S) = 0) →
      volume (symmDiff (f ⁻¹' K) K) = 0 →
      (∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      ∀ N ∈ 𝓝 (f z), volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0 := by
    intro f z hf hnull hD hz N hN
    have hN' : f ⁻¹' N ∈ 𝓝 z := hf.continuousAt.preimage_mem_nhds hN
    obtain ⟨hA, hB⟩ := hz (f ⁻¹' N) hN'
    refine ⟨fun h0 => hA ?_, fun h0 => hB ?_⟩
    · have h1 : volume (f ⁻¹' (N ∩ K)) = 0 := hnull _ h0
      have hsub : f ⁻¹' N ∩ K ⊆ f ⁻¹' (N ∩ K) ∪ symmDiff (f ⁻¹' K) K := by
        intro x hx
        by_cases hfx : f x ∈ K
        · exact Or.inl ⟨hx.1, hfx⟩
        · refine Or.inr ?_
          rw [Set.mem_symmDiff]
          exact Or.inr ⟨hx.2, hfx⟩
      exact MeasureTheory.measure_mono_null hsub (MeasureTheory.measure_union_null h1 hD)
    · have h1 : volume (f ⁻¹' (N \ K)) = 0 := hnull _ h0
      have hsub : f ⁻¹' N \ K ⊆ f ⁻¹' (N \ K) ∪ symmDiff (f ⁻¹' K) K := by
        intro x hx
        by_cases hfx : f x ∈ K
        · refine Or.inr ?_
          rw [Set.mem_symmDiff]
          exact Or.inl ⟨hfx, hx.2⟩
        · exact Or.inl ⟨hx.1, hfx⟩
      exact MeasureTheory.measure_mono_null hsub (MeasureTheory.measure_union_null h1 hD)
  refine ⟨fun t ht z hz => ?_, fun s z hz => ?_⟩
  · have hnull : ∀ S : Set E3, volume S = 0 → volume ((fun x : E3 => t • x) ⁻¹' S) = 0 := by
      intro S hS
      rw [MeasureTheory.Measure.addHaar_preimage_smul volume (ne_of_gt ht) S, hS, mul_zero]
    exact T (fun x : E3 => t • x) z (continuous_const_smul t) hnull (hcone t ht) hz
  · have hnull : ∀ S : Set E3, volume S = 0 → volume ((fun x : E3 => x + s • v) ⁻¹' S) = 0 := by
      intro S hS
      rw [MeasureTheory.measure_preimage_add_right volume (s • v) S]
      exact hS
    exact T (fun x : E3 => x + s • v) z (continuous_add_right (s • v)) hnull (hv s) hz

theorem sepMinBdry_null (K : Set E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) : volume {z : E3 | ∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0} = 0 :=
by
  classical
  
  
  have hlow : ∀ (S : Set E3) (c : ℝ), MeasurableSet S → 0 < c →
      volume {x : E3 | x ∉ S ∧ ∀ r : ℝ, 0 < r →
        ENNReal.ofReal (c * r ^ 3) ≤ volume (S ∩ Metric.ball x r)} = 0 := by
    intro S c hS hc
    have hω0 : volume (Metric.closedBall (0:E3) 1) ≠ 0 :=
      (Metric.measure_closedBall_pos volume (0:E3) one_pos).ne'
    have hωtop : volume (Metric.closedBall (0:E3) 1) ≠ ⊤ := measure_closedBall_lt_top.ne
    have hball : ∀ (x : E3) (r : ℝ), 0 < r → volume (Metric.closedBall x r) =
        ENNReal.ofReal (r ^ 3) * volume (Metric.closedBall (0:E3) 1) := by
      intro x r hr
      rw [Measure.addHaar_closedBall' volume x hr.le, finrank_euclideanSpace_fin]
    have hae := Besicovitch.ae_tendsto_measure_inter_div_of_measurableSet volume hS
    refine measure_mono_null ?_ (ae_iff.1 hae)
    rintro x ⟨hxS, hx⟩ hlim
    rw [Set.indicator_of_notMem hxS] at hlim
    have hpos : 0 < ENNReal.ofReal c / volume (Metric.closedBall (0:E3) 1) :=
      ENNReal.div_pos (ENNReal.ofReal_pos.2 hc).ne' hωtop
    have hle : ∀ᶠ r in 𝓝[>] (0:ℝ), ENNReal.ofReal c / volume (Metric.closedBall (0:E3) 1) ≤
        volume (S ∩ Metric.closedBall x r) / volume (Metric.closedBall x r) := by
      filter_upwards [self_mem_nhdsWithin] with r hr
      have hr' : (0:ℝ) < r := hr
      have ht0 : ENNReal.ofReal (r ^ 3) ≠ 0 := (ENNReal.ofReal_pos.2 (pow_pos hr' 3)).ne'
      have httop : ENNReal.ofReal (r ^ 3) ≠ ⊤ := ENNReal.ofReal_ne_top
      rw [hball x r hr']
      calc ENNReal.ofReal c / volume (Metric.closedBall (0:E3) 1)
          = ENNReal.ofReal c * ENNReal.ofReal (r ^ 3) /
              (volume (Metric.closedBall (0:E3) 1) * ENNReal.ofReal (r ^ 3)) :=
            (ENNReal.mul_div_mul_right _ _ ht0 httop).symm
        _ = ENNReal.ofReal (c * r ^ 3) /
              (ENNReal.ofReal (r ^ 3) * volume (Metric.closedBall (0:E3) 1)) := by
            rw [ENNReal.ofReal_mul hc.le, mul_comm (volume (Metric.closedBall (0:E3) 1))]
        _ ≤ volume (S ∩ Metric.closedBall x r) /
              (ENNReal.ofReal (r ^ 3) * volume (Metric.closedBall (0:E3) 1)) := by
            apply ENNReal.div_le_div_right
            exact (hx r hr').trans
              (measure_mono (Set.inter_subset_inter_right _ Metric.ball_subset_closedBall))
    have h0 := ge_of_tendsto hlim hle
    have h0' : ENNReal.ofReal c / volume (Metric.closedBall (0:E3) 1) ≤ 0 := by
      simpa using h0
    exact absurd h0' (not_le.2 hpos)
  
  obtain ⟨η₁, c₀, hη₁, hc₀, -, hD⟩ := sepPerMin_density_lower
  have hDK : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      ∀ s : ℝ, 0 < s → ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (K ∩ Metric.ball z s) ∧
        ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball z s \ K) := by
    intro z hz s hs
    refine hD (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ z s isOpen_univ
      (fun i j => contDiffOn_const) (fun y i j => ?_) (fun y _ => Matrix.PosDef.one)
      (fun y _ i j => ?_) hmin hs (Set.subset_univ _) hz
    · show (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) j i
      rcases eq_or_ne i j with h | h
      · subst h; rfl
      · rw [Matrix.one_apply_ne h, Matrix.one_apply_ne h.symm]
    · show |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j - (if i = j then (1 : ℝ) else 0)| ≤ η₁
      rw [Matrix.one_apply, sub_self, abs_zero]
      exact hη₁.le
  
  have hA := hlow K c₀ hmin.1 hc₀
  have hB := hlow Kᶜ c₀ hmin.1.compl hc₀
  refine measure_mono_null ?_ (measure_union_null hA hB)
  intro z hz
  by_cases hzK : z ∈ K
  · right
    refine ⟨fun h => h hzK, fun r hr => ?_⟩
    have h2 := (hDK z hz r hr).2
    rwa [Set.diff_eq, Set.inter_comm] at h2
  · left
    exact ⟨hzK, fun r hr => (hDK z hz r hr).1⟩

theorem sepGraph_measBdry (K : Set E3) (a : Fin 3) (x : E3) (u : E3 → ℝ) (ρ δ : ℝ) (hu : Continuous u) (hside : (volume ((sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ K) = 0) ∨ (volume ((sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ K) = 0)) : ∀ z ∈ sepCyl a x ρ δ, ((∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) ↔ z a = u (sepPlaneProj a z)) :=
by
  classical
  have hcoord : Continuous (fun w : E3 => w a) := PiLp.continuous_apply 2 _ a
  have hP : Continuous (sepPlaneProj a) := by
    unfold sepPlaneProj
    exact continuous_id.sub (hcoord.smul continuous_const)
  have hC : IsOpen (sepCyl a x ρ δ) := by
    unfold sepCyl
    rw [Set.setOf_and]
    exact (isOpen_lt (continuous_norm.comp (hP.comp (continuous_id.sub continuous_const)))
      continuous_const).inter (isOpen_lt ((hcoord.sub continuous_const).abs) continuous_const)
  have hB : IsOpen {z : E3 | z a < u (sepPlaneProj a z)} := isOpen_lt hcoord (hu.comp hP)
  have hA : IsOpen {z : E3 | u (sepPlaneProj a z) < z a} := isOpen_lt (hu.comp hP) hcoord
  have hshift : ∀ (w : E3) (s : ℝ), sepPlaneProj a (w + s • e a) = sepPlaneProj a w ∧
      (w + s • e a) a = w a + s := by
    intro w s
    have h1 : (w + s • e a) a = w a + s := by
      simp [e, EuclideanSpace.single_apply]
    refine ⟨?_, h1⟩
    unfold sepPlaneProj
    rw [h1, add_smul]
    abel
  have hnorm : ∀ s : ℝ, ‖s • e a‖ = |s| := by
    intro s
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  have hmass : ∀ (S N O : Set E3), IsOpen O → O.Nonempty → O ⊆ N → O ⊆ S →
      (volume (S \ K) = 0 → volume (N ∩ K) ≠ 0) ∧ (volume (S ∩ K) = 0 → volume (N \ K) ≠ 0) := by
    intro S N O hO hne hON hOS
    have hpos : volume O ≠ 0 := hO.measure_ne_zero volume hne
    constructor
    · intro hS hNK
      apply hpos
      refine measure_mono_null (t := (N ∩ K) ∪ (S \ K)) ?_ (measure_union_null hNK hS)
      intro w hw
      by_cases hwK : w ∈ K
      · exact Or.inl ⟨hON hw, hwK⟩
      · exact Or.inr ⟨hOS hw, hwK⟩
    · intro hS hNK
      apply hpos
      refine measure_mono_null (t := (N \ K) ∪ (S ∩ K)) ?_ (measure_union_null hNK hS)
      intro w hw
      by_cases hwK : w ∈ K
      · exact Or.inr ⟨hOS hw, hwK⟩
      · exact Or.inl ⟨hON hw, hwK⟩
  intro z hzC
  constructor
  · intro hbd
    rcases lt_trichotomy (z a) (u (sepPlaneProj a z)) with hlt | heq | hgt
    · exfalso
      have hN : sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)} ∈ 𝓝 z :=
        (hC.inter hB).mem_nhds ⟨hzC, hlt⟩
      obtain ⟨h1, h2⟩ := hbd _ hN
      rcases hside with ⟨hs1, hs2⟩ | ⟨hs1, hs2⟩
      · exact h2 hs1
      · exact h1 hs2
    · exact heq
    · exfalso
      have hN : sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a} ∈ 𝓝 z :=
        (hC.inter hA).mem_nhds ⟨hzC, hgt⟩
      obtain ⟨h1, h2⟩ := hbd _ hN
      rcases hside with ⟨hs1, hs2⟩ | ⟨hs1, hs2⟩
      · exact h1 hs2
      · exact h2 hs1
  · intro hz N hN
    have hNC : N ∩ sepCyl a x ρ δ ∈ 𝓝 z := Filter.inter_mem hN (hC.mem_nhds hzC)
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.1 hNC
    have ht0 : 0 < ε / 2 := by positivity
    have htε : ε / 2 < ε := by linarith
    obtain ⟨hPm, hcm⟩ := hshift z (-(ε / 2))
    obtain ⟨hPp, hcp⟩ := hshift z (ε / 2)
    have hmball : z + (-(ε / 2)) • e a ∈ Metric.ball z ε := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, hnorm, abs_neg, abs_of_pos ht0]
      exact htε
    have hpball : z + (ε / 2) • e a ∈ Metric.ball z ε := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, hnorm, abs_of_pos ht0]
      exact htε
    have hOmo : IsOpen (Metric.ball z ε ∩ (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)})) :=
      Metric.isOpen_ball.inter (hC.inter hB)
    have hOpo : IsOpen (Metric.ball z ε ∩ (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a})) :=
      Metric.isOpen_ball.inter (hC.inter hA)
    have hOmne : (Metric.ball z ε ∩
        (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)})).Nonempty := by
      refine ⟨z + (-(ε / 2)) • e a, hmball, (hball hmball).2, ?_⟩
      show (z + (-(ε / 2)) • e a) a < u (sepPlaneProj a (z + (-(ε / 2)) • e a))
      rw [hcm, hPm, ← hz]
      linarith
    have hOpne : (Metric.ball z ε ∩
        (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a})).Nonempty := by
      refine ⟨z + (ε / 2) • e a, hpball, (hball hpball).2, ?_⟩
      show u (sepPlaneProj a (z + (ε / 2) • e a)) < (z + (ε / 2) • e a) a
      rw [hcp, hPp, ← hz]
      linarith
    have hOmN : Metric.ball z ε ∩ (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)}) ⊆ N :=
      fun w hw => (hball hw.1).1
    have hOpN : Metric.ball z ε ∩ (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a}) ⊆ N :=
      fun w hw => (hball hw.1).1
    have hm := hmass _ N _ hOmo hOmne hOmN Set.inter_subset_right
    have hp := hmass _ N _ hOpo hOpne hOpN Set.inter_subset_right
    rcases hside with ⟨hs1, hs2⟩ | ⟨hs1, hs2⟩
    · exact ⟨hm.1 hs1, hp.2 hs2⟩
    · exact ⟨hp.1 hs1, hm.2 hs2⟩

theorem sepGlobal_planes (K : Set E3) (h1 : ∀ N ∈ 𝓝 (0:E3), volume (N \ K) ≠ 0) (h0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ K) ≠ 0) (hloc : ∀ x : E3, x ≠ 0 → (∀ N ∈ 𝓝 x, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) → ∃ (m : E3) (N : Set E3), ‖m‖ = 1 ∧ N ∈ 𝓝 x ∧ volume ((N ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 ∧ volume (N ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0) : ∃ ν : E3, ‖ν‖ = 1 ∧ volume (symmDiff K {z : E3 | @inner ℝ E3 _ ν z < 0}) = 0 :=
by
  
  have t_ray : ∀ (y v : E3) (M : Set E3), M ∈ 𝓝 y →
      ∃ t : ℝ, 0 < t ∧ y + t • v ∈ interior M := by
    intro y v M hM
    have hcont : Continuous fun t : ℝ => y + t • v :=
      continuous_const.add (continuous_id.smul continuous_const)
    have hev : ∀ᶠ t in 𝓝[>] (0:ℝ), y + t • v ∈ interior M := by
      apply nhdsWithin_le_nhds
      apply hcont.continuousAt.preimage_mem_nhds
      simpa using interior_mem_nhds.mpr hM
    obtain ⟨t, htM, ht⟩ := (hev.and self_mem_nhdsWithin).exists
    exact ⟨t, ht, htM⟩
  
  have t_s1 : ∀ m : E3, m ≠ 0 → volume {z : E3 | @inner ℝ E3 _ m z = 0} = 0 := by
    intro m hm
    have hset : {z : E3 | @inner ℝ E3 _ m z = 0} =
        (((ℝ ∙ m)ᗮ : Submodule ℝ E3) : Set E3) := by
      ext z
      simp [Submodule.mem_orthogonal_singleton_iff_inner_right]
    rw [hset]
    apply Measure.addHaar_submodule
    intro h
    have : m ∈ (ℝ ∙ m)ᗮ := h ▸ Submodule.mem_top
    rw [Submodule.mem_orthogonal_singleton_iff_inner_right] at this
    exact hm (inner_self_eq_zero.mp this)
  
  have t_s2 : ∀ (K : Set E3) (m m' y : E3), ‖m‖ = 1 → ‖m'‖ = 1 →
      @inner ℝ E3 _ m y = 0 → @inner ℝ E3 _ m' y = 0 →
      ∀ (M : Set E3), M ∈ 𝓝 y →
      volume ((M ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 →
      volume (M ∩ {z | 0 < @inner ℝ E3 _ m' z} ∩ K) = 0 → m = m' := by
    intro K m m' y hm hm' hy hy' M hM hneg hpos'
    by_contra hne
    have hmm : @inner ℝ E3 _ m m = 1 := by rw [real_inner_self_eq_norm_sq, hm]; norm_num
    have hmm' : @inner ℝ E3 _ m' m' = 1 := by rw [real_inner_self_eq_norm_sq, hm']; norm_num
    have hlt : @inner ℝ E3 _ m m' < 1 := by
      by_contra hge
      push_neg at hge
      apply hne
      have h := norm_sub_sq_real m m'
      rw [hm, hm'] at h
      have h2 : ‖m - m'‖ ^ 2 = 0 := by nlinarith [sq_nonneg ‖m - m'‖]
      exact sub_eq_zero.mp (norm_eq_zero.mp (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2))
    have hv1 : @inner ℝ E3 _ m (m' - m) < 0 := by
      rw [inner_sub_right, hmm]; linarith
    have hv2 : 0 < @inner ℝ E3 _ m' (m' - m) := by
      rw [inner_sub_right, hmm', real_inner_comm m m']; linarith
    obtain ⟨t, ht, htM⟩ := t_ray y (m' - m) M hM
    have hO : IsOpen (interior M ∩ {z | @inner ℝ E3 _ m z < 0} ∩
        {z | 0 < @inner ℝ E3 _ m' z}) :=
      (isOpen_interior.inter
        (isOpen_lt (continuous_const.inner continuous_id) continuous_const)).inter
        (isOpen_lt continuous_const (continuous_const.inner continuous_id))
    have hpO : y + t • (m' - m) ∈ interior M ∩ {z | @inner ℝ E3 _ m z < 0} ∩
        {z | 0 < @inner ℝ E3 _ m' z} := by
      refine ⟨⟨htM, ?_⟩, ?_⟩
      · show @inner ℝ E3 _ m (y + t • (m' - m)) < 0
        rw [inner_add_right, real_inner_smul_right, hy]
        nlinarith
      · show 0 < @inner ℝ E3 _ m' (y + t • (m' - m))
        rw [inner_add_right, real_inner_smul_right, hy']
        nlinarith
    apply hO.measure_ne_zero volume ⟨_, hpO⟩
    refine measure_mono_null ?_ (measure_union_null hneg hpos')
    rintro z ⟨⟨hzM, hz1⟩, hz2⟩
    by_cases hzK : z ∈ K
    · exact Or.inr ⟨⟨interior_subset hzM, hz2⟩, hzK⟩
    · exact Or.inl ⟨⟨interior_subset hzM, hz1⟩, hzK⟩
  
  have t_s3 : ∀ (K : Set E3) (m y : E3), ‖m‖ = 1 → @inner ℝ E3 _ m y = 0 →
      ∀ (N₀ : Set E3), N₀ ∈ 𝓝 y →
      volume ((N₀ ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 →
      volume (N₀ ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 →
      ∀ N ∈ 𝓝 y, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0 := by
    intro K m y hm hy N₀ hN₀ hneg hpos N hN
    have hmm : @inner ℝ E3 _ m m = 1 := by rw [real_inner_self_eq_norm_sq, hm]; norm_num
    have hNN : N ∩ N₀ ∈ 𝓝 y := Filter.inter_mem hN hN₀
    constructor
    · intro h0
      obtain ⟨t, ht, htM⟩ := t_ray y (-m) (N ∩ N₀) hNN
      have hO : IsOpen (interior (N ∩ N₀) ∩ {z | @inner ℝ E3 _ m z < 0}) :=
        isOpen_interior.inter (isOpen_lt (continuous_const.inner continuous_id) continuous_const)
      have hpO : y + t • (-m) ∈ interior (N ∩ N₀) ∩ {z | @inner ℝ E3 _ m z < 0} := by
        refine ⟨htM, ?_⟩
        show @inner ℝ E3 _ m (y + t • (-m)) < 0
        rw [inner_add_right, real_inner_smul_right, inner_neg_right, hy, hmm]
        linarith
      apply hO.measure_ne_zero volume ⟨_, hpO⟩
      refine measure_mono_null ?_ (measure_union_null h0 hneg)
      rintro z ⟨hzM, hz1⟩
      have hzM' := interior_subset hzM
      by_cases hzK : z ∈ K
      · exact Or.inl ⟨hzM'.1, hzK⟩
      · exact Or.inr ⟨⟨hzM'.2, hz1⟩, hzK⟩
    · intro h0
      obtain ⟨t, ht, htM⟩ := t_ray y m (N ∩ N₀) hNN
      have hO : IsOpen (interior (N ∩ N₀) ∩ {z | 0 < @inner ℝ E3 _ m z}) :=
        isOpen_interior.inter (isOpen_lt continuous_const (continuous_const.inner continuous_id))
      have hpO : y + t • m ∈ interior (N ∩ N₀) ∩ {z | 0 < @inner ℝ E3 _ m z} := by
        refine ⟨htM, ?_⟩
        show 0 < @inner ℝ E3 _ m (y + t • m)
        rw [inner_add_right, real_inner_smul_right, hy, hmm]
        linarith
      apply hO.measure_ne_zero volume ⟨_, hpO⟩
      refine measure_mono_null ?_ (measure_union_null h0 hpos)
      rintro z ⟨hzM, hz1⟩
      have hzM' := interior_subset hzM
      by_cases hzK : z ∈ K
      · exact Or.inr ⟨⟨hzM'.2, hz1⟩, hzK⟩
      · exact Or.inl ⟨hzM'.1, hzK⟩
  
  have t_s4 : ∀ (K : Set E3) (m y : E3),
      (∀ N ∈ 𝓝 y, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      ∀ (N₀ : Set E3), N₀ ∈ 𝓝 y →
      volume ((N₀ ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 →
      volume (N₀ ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 →
      @inner ℝ E3 _ m y = 0 := by
    intro K m y hy N₀ hN₀ hneg hpos
    rcases lt_trichotomy (@inner ℝ E3 _ m y) 0 with hc | hc | hc
    · exfalso
      have hN : N₀ ∩ {z | @inner ℝ E3 _ m z < 0} ∈ 𝓝 y :=
        Filter.inter_mem hN₀ ((isOpen_lt (continuous_const.inner continuous_id)
          continuous_const).mem_nhds hc)
      exact (hy _ hN).2 hneg
    · exact hc
    · exfalso
      have hN : N₀ ∩ {z | 0 < @inner ℝ E3 _ m z} ∈ 𝓝 y :=
        Filter.inter_mem hN₀ ((isOpen_lt continuous_const
          (continuous_const.inner continuous_id)).mem_nhds hc)
      exact (hy _ hN).1 hpos
  
  have t_s5 : ∀ (K U : Set E3), IsPreconnected U →
      (∀ x ∈ U, ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0 ∨ volume (N \ K) = 0) →
      volume (U ∩ K) = 0 ∨ volume (U \ K) = 0 := by
    intro K U hU hloc
    have hR : IsOpen {x : E3 | ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0} := by
      rw [isOpen_iff_mem_nhds]
      rintro x ⟨N, hN, hN0⟩
      filter_upwards [eventually_eventually_nhds.mpr hN] with x' hx'
      exact ⟨N, hx', hN0⟩
    have hQ : IsOpen {x : E3 | ∃ N ∈ 𝓝 x, volume (N \ K) = 0} := by
      rw [isOpen_iff_mem_nhds]
      rintro x ⟨N, hN, hN0⟩
      filter_upwards [eventually_eventually_nhds.mpr hN] with x' hx'
      exact ⟨N, hx', hN0⟩
    have hdisj : Disjoint {x : E3 | ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0}
        {x : E3 | ∃ N ∈ 𝓝 x, volume (N \ K) = 0} := by
      rw [Set.disjoint_left]
      rintro x ⟨N, hN, hN0⟩ ⟨N', hN', hN'0⟩
      have hpos := Measure.measure_pos_of_mem_nhds volume (Filter.inter_mem hN hN')
      refine hpos.ne' (measure_mono_null ?_ (measure_union_null hN0 hN'0))
      rintro z ⟨hzN, hzN'⟩
      by_cases hzK : z ∈ K
      · exact Or.inl ⟨hzN, hzK⟩
      · exact Or.inr ⟨hzN', hzK⟩
    have hcover : U ⊆ {x : E3 | ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0} ∪
        {x : E3 | ∃ N ∈ 𝓝 x, volume (N \ K) = 0} := by
      intro x hx
      obtain ⟨N, hN, h | h⟩ := hloc x hx
      · exact Or.inl ⟨N, hN, h⟩
      · exact Or.inr ⟨N, hN, h⟩
    rcases hU.subset_or_subset hR hQ hdisj hcover with hUR | hUQ
    · left
      apply measure_null_of_locally_null
      rintro x ⟨hxU, hxK⟩
      obtain ⟨N, hN, hN0⟩ := hUR hxU
      exact ⟨(U ∩ K) ∩ N, inter_mem_nhdsWithin _ hN,
        measure_mono_null (fun z (hz : z ∈ (U ∩ K) ∩ N) => (⟨hz.2, hz.1.2⟩ : z ∈ N ∩ K)) hN0⟩
    · right
      apply measure_null_of_locally_null
      rintro x ⟨hxU, hxK⟩
      obtain ⟨N, hN, hN0⟩ := hUQ hxU
      exact ⟨(U \ K) ∩ N, inter_mem_nhdsWithin _ hN,
        measure_mono_null (fun z (hz : z ∈ (U \ K) ∩ N) => (⟨hz.2, hz.1.2⟩ : z ∈ N \ K)) hN0⟩
  
  have t_s6pre : ∀ m : E3, m ≠ 0 →
      IsPreconnected ({z : E3 | @inner ℝ E3 _ m z = 0} \ {0}) := by
    intro m hm
    haveI : Fact (Module.finrank ℝ E3 = 2 + 1) := ⟨by simp⟩
    have hfr : Module.finrank ℝ (ℝ ∙ m)ᗮ = 2 := Submodule.finrank_orthogonal_span_singleton hm
    have hrank : 1 < Module.rank ℝ (ℝ ∙ m)ᗮ := by
      rw [← Module.finrank_eq_rank, hfr]
      norm_num
    have hc := isConnected_compl_singleton_of_one_lt_rank hrank (0 : (ℝ ∙ m)ᗮ)
    have himg : (Subtype.val '' ({0}ᶜ : Set (ℝ ∙ m)ᗮ)) =
        {z : E3 | @inner ℝ E3 _ m z = 0} \ {0} := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        refine ⟨?_, ?_⟩
        · exact (Submodule.mem_orthogonal_singleton_iff_inner_right).mp w.2
        · intro h
          apply hw
          exact Subtype.ext h
      · rintro ⟨hz, hz0⟩
        refine ⟨⟨z, (Submodule.mem_orthogonal_singleton_iff_inner_right).mpr hz⟩, ?_, rfl⟩
        intro h
        apply hz0
        have := congrArg Subtype.val h
        simpa using this
    rw [← himg]
    exact (hc.image _ continuous_subtype_val.continuousOn).isPreconnected
  
  have t_s7 : ∀ m m' : E3,
      ∃ w : E3, w ≠ 0 ∧ @inner ℝ E3 _ m w = 0 ∧ @inner ℝ E3 _ m' w = 0 := by
    intro m m'
    let f : E3 →ₗ[ℝ] ℝ × ℝ := (innerₛₗ ℝ m).prod (innerₛₗ ℝ m')
    have hlt : Module.finrank ℝ (ℝ × ℝ) < Module.finrank ℝ E3 := by simp
    have hker := LinearMap.ker_ne_bot_of_finrank_lt (f := f) hlt
    obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff _).mp hker
    rw [LinearMap.mem_ker] at hw
    have h1 := congrArg Prod.fst hw
    have h2 := congrArg Prod.snd hw
    simp [f] at h1 h2
    exact ⟨w, hw0, h1, h2⟩
  
  have t_s8 : ∀ (m : E3), ‖m‖ = 1 → ∀ (y : E3), y ≠ 0 →
      y ∈ closure (({z : E3 | @inner ℝ E3 _ m z = 0} \ {0}) ∩
        {z : E3 | ∃ N ∈ 𝓝 z, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
          volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0}) →
      ∃ N ∈ 𝓝 y, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
        volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0 := by
    intro m hm y hy0 hcl
    have hb : ∀ N ∈ 𝓝 y, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0 := by
      intro N hN
      obtain ⟨y', hy'N, ⟨hy'P, -⟩, N', hN', hA1, hA2⟩ :=
        mem_closure_iff.mp hcl (interior N) isOpen_interior (mem_interior_iff_mem_nhds.mpr hN)
      have h := t_s3 K m y' hm hy'P N' hN' hA1 hA2 (interior N) (isOpen_interior.mem_nhds hy'N)
      exact ⟨fun h0 => h.1 (measure_mono_null (Set.inter_subset_inter_left _ interior_subset) h0),
        fun h0 => h.2 (measure_mono_null (Set.diff_subset_diff_left interior_subset) h0)⟩
    obtain ⟨m', N₁, hm', hN₁, hB1, hB2⟩ := hloc y hy0 hb
    obtain ⟨y', hy'N, ⟨hy'P, -⟩, N', hN', hA1, hA2⟩ :=
      mem_closure_iff.mp hcl (interior N₁) isOpen_interior (mem_interior_iff_mem_nhds.mpr hN₁)
    have hN₁y' : N₁ ∈ 𝓝 y' :=
      Filter.mem_of_superset (isOpen_interior.mem_nhds hy'N) interior_subset
    have hby' := t_s3 K m y' hm hy'P N' hN' hA1 hA2
    have hy'P' := t_s4 K m' y' hby' N₁ hN₁y' hB1 hB2
    have hM1 : volume (((N' ∩ N₁) ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 :=
      measure_mono_null (by intro z hz; exact ⟨⟨hz.1.1.1, hz.1.2⟩, hz.2⟩) hA1
    have hM2 : volume ((N' ∩ N₁) ∩ {z | 0 < @inner ℝ E3 _ m' z} ∩ K) = 0 :=
      measure_mono_null (by intro z hz; exact ⟨⟨hz.1.1.2, hz.1.2⟩, hz.2⟩) hB2
    have heq : m = m' := t_s2 K m m' y' hm hm' hy'P hy'P' (N' ∩ N₁)
      (Filter.inter_mem hN' hN₁y') hM1 hM2
    subst heq
    exact ⟨N₁, hN₁, hB1, hB2⟩
  
  have t_s9 : ∀ (m : E3), ‖m‖ = 1 → ∀ (x₀ : E3), @inner ℝ E3 _ m x₀ = 0 →
      ∀ (N₀ : Set E3), N₀ ∈ 𝓝 x₀ →
      volume ((N₀ ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 →
      volume (N₀ ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 →
      (∀ y : E3, @inner ℝ E3 _ m y ≠ 0 →
        ∃ N ∈ 𝓝 y, volume (N ∩ K) = 0 ∨ volume (N \ K) = 0) →
      volume (symmDiff K {z : E3 | @inner ℝ E3 _ m z < 0}) = 0 := by
    intro m hm x₀ hx₀ N₀ hN₀ hneg hpos hbdry
    have hmm : @inner ℝ E3 _ m m = 1 := by rw [real_inner_self_eq_norm_sq, hm]; norm_num
    have hm0 : m ≠ 0 := by
      intro h
      rw [h, norm_zero] at hm
      exact zero_ne_one hm
    have hlin : IsLinearMap ℝ (fun z : E3 => @inner ℝ E3 _ m z) :=
      ⟨fun x y => inner_add_right _ _ _, fun c x => real_inner_smul_right _ _ _⟩
    have hpc1 : IsPreconnected {z : E3 | @inner ℝ E3 _ m z < 0} :=
      (convex_halfSpace_lt hlin 0).isPreconnected
    have hpc2 : IsPreconnected {z : E3 | 0 < @inner ℝ E3 _ m z} :=
      (convex_halfSpace_gt hlin 0).isPreconnected
    have hA := t_s5 K _ hpc1 (fun x hx => hbdry x (ne_of_lt hx))
    have hB := t_s5 K _ hpc2 (fun x hx => hbdry x (ne_of_gt hx))
    have hneg' : volume ({z : E3 | @inner ℝ E3 _ m z < 0} \ K) = 0 := by
      rcases hA with h | h
      · exfalso
        obtain ⟨t, ht, htM⟩ := t_ray x₀ (-m) N₀ hN₀
        have hO : IsOpen (interior N₀ ∩ {z | @inner ℝ E3 _ m z < 0}) :=
          isOpen_interior.inter (isOpen_lt (continuous_const.inner continuous_id) continuous_const)
        have hpO : x₀ + t • (-m) ∈ interior N₀ ∩ {z | @inner ℝ E3 _ m z < 0} := by
          refine ⟨htM, ?_⟩
          show @inner ℝ E3 _ m (x₀ + t • (-m)) < 0
          rw [inner_add_right, real_inner_smul_right, inner_neg_right, hx₀, hmm]
          linarith
        apply hO.measure_ne_zero volume ⟨_, hpO⟩
        refine measure_mono_null ?_ (measure_union_null h hneg)
        rintro z ⟨hzM, hz1⟩
        by_cases hzK : z ∈ K
        · exact Or.inl ⟨hz1, hzK⟩
        · exact Or.inr ⟨⟨interior_subset hzM, hz1⟩, hzK⟩
      · exact h
    have hpos' : volume ({z : E3 | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 := by
      rcases hB with h | h
      · exact h
      · exfalso
        obtain ⟨t, ht, htM⟩ := t_ray x₀ m N₀ hN₀
        have hO : IsOpen (interior N₀ ∩ {z | 0 < @inner ℝ E3 _ m z}) :=
          isOpen_interior.inter (isOpen_lt continuous_const (continuous_const.inner continuous_id))
        have hpO : x₀ + t • m ∈ interior N₀ ∩ {z | 0 < @inner ℝ E3 _ m z} := by
          refine ⟨htM, ?_⟩
          show 0 < @inner ℝ E3 _ m (x₀ + t • m)
          rw [inner_add_right, real_inner_smul_right, hx₀, hmm]
          linarith
        apply hO.measure_ne_zero volume ⟨_, hpO⟩
        refine measure_mono_null ?_ (measure_union_null h hpos)
        rintro z ⟨hzM, hz1⟩
        by_cases hzK : z ∈ K
        · exact Or.inr ⟨⟨interior_subset hzM, hz1⟩, hzK⟩
        · exact Or.inl ⟨hz1, hzK⟩
    refine measure_mono_null ?_ (measure_union_null (measure_union_null hneg' hpos') (t_s1 m hm0))
    intro z hz
    rw [Set.mem_symmDiff] at hz
    rcases hz with ⟨hzK, hzH⟩ | ⟨hzH, hzK⟩
    · have hzH' : ¬ (@inner ℝ E3 _ m z < 0) := hzH
      rcases (not_lt.mp hzH').lt_or_eq with h | h
      · exact Or.inl (Or.inr ⟨h, hzK⟩)
      · exact Or.inr h.symm
    · exact Or.inl (Or.inl ⟨hzH, hzK⟩)
  
  have hnb : ∀ x : E3, ¬ (∀ N ∈ 𝓝 x, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0 ∨ volume (N \ K) = 0 := by
    intro x hx
    push_neg at hx
    obtain ⟨N, hN, hN'⟩ := hx
    by_cases h : volume (N ∩ K) = 0
    · exact ⟨N, hN, Or.inl h⟩
    · exact ⟨N, hN, Or.inr (hN' h)⟩
  
  have hex : ∃ x₀ : E3, x₀ ≠ 0 ∧ ∀ N ∈ 𝓝 x₀, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0 := by
    by_contra hcon
    have hall : ∀ x ∈ ({0}ᶜ : Set E3), ∃ N ∈ 𝓝 x, volume (N ∩ K) = 0 ∨ volume (N \ K) = 0 :=
      fun x hx => hnb x (fun hb => hcon ⟨x, hx, hb⟩)
    have hrank : 1 < Module.rank ℝ E3 := by
      rw [← Module.finrank_eq_rank, finrank_euclideanSpace]
      simp
    have hconn := (isConnected_compl_singleton_of_one_lt_rank hrank (0:E3)).isPreconnected
    rcases t_s5 K _ hconn hall with h | h
    · apply h0 Set.univ Filter.univ_mem
      refine measure_mono_null ?_ (measure_union_null (measure_singleton (0:E3)) h)
      intro z hz
      by_cases hz0 : z = 0
      · exact Or.inl hz0
      · exact Or.inr ⟨hz0, hz.2⟩
    · apply h1 Set.univ Filter.univ_mem
      refine measure_mono_null ?_ (measure_union_null (measure_singleton (0:E3)) h)
      intro z hz
      by_cases hz0 : z = 0
      · exact Or.inl hz0
      · exact Or.inr ⟨hz0, hz.2⟩
  
  obtain ⟨x₀, hx₀0, hx₀b⟩ := hex
  obtain ⟨m₀, N₀, hm₀, hN₀, hneg₀, hpos₀⟩ := hloc x₀ hx₀0 hx₀b
  have hx₀P := t_s4 K m₀ x₀ hx₀b N₀ hN₀ hneg₀ hpos₀
  
  have hprop : ∀ m : E3, ‖m‖ = 1 → ∀ x : E3, @inner ℝ E3 _ m x = 0 → x ≠ 0 →
      (∃ N ∈ 𝓝 x, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
        volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0) →
      ∀ y : E3, @inner ℝ E3 _ m y = 0 → y ≠ 0 →
      ∃ N ∈ 𝓝 y, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
        volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0 := by
    intro m hm x hx hx0 hxu y hy hy0
    have hm0 : m ≠ 0 := by
      intro h
      rw [h, norm_zero] at hm
      exact zero_ne_one hm
    have huo : IsOpen {z : E3 | ∃ N ∈ 𝓝 z,
        volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
        volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0} := by
      rw [isOpen_iff_mem_nhds]
      rintro z ⟨N, hN, hA⟩
      filter_upwards [eventually_eventually_nhds.mpr hN] with z' hz'
      exact ⟨N, hz', hA⟩
    have hs := t_s6pre m hm0
    by_contra hyu
    have hcov : ({z : E3 | @inner ℝ E3 _ m z = 0} \ {0}) ⊆
        {z : E3 | ∃ N ∈ 𝓝 z, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
          volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0} ∪
        (closure (({z : E3 | @inner ℝ E3 _ m z = 0} \ {0}) ∩
          {z : E3 | ∃ N ∈ 𝓝 z, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
            volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0}))ᶜ := by
      intro z hz
      by_cases hzc : z ∈ closure (({z : E3 | @inner ℝ E3 _ m z = 0} \ {0}) ∩
          {z : E3 | ∃ N ∈ 𝓝 z, volume ((N ∩ {w | @inner ℝ E3 _ m w < 0}) \ K) = 0 ∧
            volume (N ∩ {w | 0 < @inner ℝ E3 _ m w} ∩ K) = 0})
      · exact Or.inl (t_s8 m hm z hz.2 hzc)
      · exact Or.inr hzc
    obtain ⟨z, hzs, hzu, hzc⟩ := hs _ _ huo isClosed_closure.isOpen_compl hcov
      ⟨x, ⟨hx, hx0⟩, hxu⟩ ⟨y, ⟨hy, hy0⟩, fun hyc => hyu (t_s8 m hm y hy0 hyc)⟩
    exact hzc (subset_closure ⟨hzs, hzu⟩)
  
  have hallP : ∀ y : E3, y ≠ 0 → (∀ N ∈ 𝓝 y, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      @inner ℝ E3 _ m₀ y = 0 := by
    intro y hy0 hyb
    obtain ⟨m, N₁, hm, hN₁, hB1, hB2⟩ := hloc y hy0 hyb
    have hyP := t_s4 K m y hyb N₁ hN₁ hB1 hB2
    obtain ⟨w, hw0, hwm, hwm₀⟩ := t_s7 m m₀
    obtain ⟨Na, hNa, hNa1, hNa2⟩ := hprop m hm y hyP hy0 ⟨N₁, hN₁, hB1, hB2⟩ w hwm hw0
    obtain ⟨Nb, hNb, hNb1, hNb2⟩ :=
      hprop m₀ hm₀ x₀ hx₀P hx₀0 ⟨N₀, hN₀, hneg₀, hpos₀⟩ w hwm₀ hw0
    have hM1 : volume (((Na ∩ Nb) ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 :=
      measure_mono_null (by intro z hz; exact ⟨⟨hz.1.1.1, hz.1.2⟩, hz.2⟩) hNa1
    have hM2 : volume ((Na ∩ Nb) ∩ {z | 0 < @inner ℝ E3 _ m₀ z} ∩ K) = 0 :=
      measure_mono_null (by intro z hz; exact ⟨⟨hz.1.1.2, hz.1.2⟩, hz.2⟩) hNb2
    have heq : m = m₀ := t_s2 K m m₀ w hm hm₀ hwm hwm₀ (Na ∩ Nb) (Filter.inter_mem hNa hNb)
      hM1 hM2
    rw [← heq]
    exact hyP
  
  refine ⟨m₀, hm₀, t_s9 m₀ hm₀ x₀ hx₀P N₀ hN₀ hneg₀ hpos₀ ?_⟩
  intro y hy
  apply hnb
  intro hyb
  have hy0 : y ≠ 0 := by
    rintro rfl
    exact hy (inner_zero_right _)
  exact hy (hallP y hy0 hyb)

theorem smth_perMin_compl (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U F : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpd : ∀ y ∈ U, (G y).PosDef)
    (hmin : sepIsPerMin G F U) : sepIsPerMin G Fᶜ U :=
by
  
  have s1 : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ U →
      ∀ i : Fin 3, ContDiff ℝ 1 (fun z => Real.sqrt (G z).det * X z i) ∧
        HasCompactSupport (fun z => Real.sqrt (G z).det * X z i) := by
    intro X hX hXc hXU i
    have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) U := by
      have hfun : (fun y => (G y).det) = fun y =>
          G y 0 0 * G y 1 1 * G y 2 2 - G y 0 0 * G y 1 2 * G y 2 1
            - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
            + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three _
      rw [hfun]
      exact ((((((hG 0 0).mul (hG 1 1)).mul (hG 2 2)).sub
        (((hG 0 0).mul (hG 1 2)).mul (hG 2 1))).sub
        (((hG 0 1).mul (hG 1 0)).mul (hG 2 2))).add
        (((hG 0 1).mul (hG 1 2)).mul (hG 2 0))).add
        (((hG 0 2).mul (hG 1 0)).mul (hG 2 1)) |>.sub
        (((hG 0 2).mul (hG 1 1)).mul (hG 2 0))
    have hXi : ContDiff ℝ ∞ (fun z => X z i) :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hX
    refine ⟨?_, ?_⟩
    · have hsm : ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) := by
        rw [contDiff_iff_contDiffAt]
        intro z
        by_cases hz : z ∈ U
        · have h1 : ContDiffAt ℝ ∞ (fun y => (G y).det) z := hdet.contDiffAt (hU.mem_nhds hz)
          have h2 := h1.sqrt (hpd z hz).det_pos.ne'
          exact h2.mul hXi.contDiffAt
        · have hz' : z ∉ tsupport X := fun h => hz (hXU h)
          have hev : X =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.mp hz'
          have hev' : (fun y => Real.sqrt (G y).det * X y i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
            filter_upwards [hev] with y hy
            rw [hy]; simp
          exact contDiffAt_const.congr_of_eventuallyEq hev'
      exact hsm.of_le (by exact_mod_cast le_top)
    · have hc : HasCompactSupport (fun z => X z i) := hXc.comp_left (g := fun v : E3 => v i) rfl
      exact hc.mul_left
  
  have s2 : ∀ h : E3 → ℝ, ContDiff ℝ 1 h → HasCompactSupport h → ∀ i : Fin 3,
      Integrable (partialDeriv i h) ∧ ∫ y, partialDeriv i h y = 0 := by
    intro h hh hc i
    have hcont : Continuous (partialDeriv i h) := by
      unfold partialDeriv
      exact (hh.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hint : Integrable (partialDeriv i h) :=
      hcont.integrable_of_hasCompactSupport (hc.fderiv_apply (𝕜 := ℝ) (e i))
    refine ⟨hint, ?_⟩
    have hhint : Integrable h := hh.continuous.integrable_of_hasCompactSupport hc
    have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : E3 => (1 : ℝ)) (g := h) (v := e i) (by simp) (by simpa using hint)
      (by simpa using hhint) (differentiable_const 1) (hh.differentiable one_ne_zero)
    simpa [partialDeriv] using key
  
  have hflux : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ U →
      Integrable (sepDensDiv G X) ∧ ∫ y, sepDensDiv G X y = 0 := by
    intro X hX hXc hXU
    have hs : ∀ i : Fin 3,
        Integrable (partialDeriv i (fun z => Real.sqrt (G z).det * X z i)) ∧
          ∫ y, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y = 0 :=
      fun i => s2 _ (s1 X hX hXc hXU i).1 (s1 X hX hXc hXU i).2 i
    have he : sepDensDiv G X =
        fun y => ∑ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y := rfl
    rw [he]
    refine ⟨integrable_finset_sum _ (fun i _ => (hs i).1), ?_⟩
    rw [integral_finset_sum _ (fun i _ => (hs i).1)]
    exact Finset.sum_eq_zero (fun i _ => (hs i).2)
  
  have hneg : ∀ X : E3 → E3, sepDensDiv G (-X) = fun y => -sepDensDiv G X y := by
    intro X
    funext y
    unfold sepDensDiv
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have hf : (fun z => Real.sqrt (G z).det * (-X) z i) =
        -(fun z => Real.sqrt (G z).det * X z i) := by
      funext z; simp
    unfold partialDeriv
    rw [hf, fderiv_neg, ContinuousLinearMap.neg_apply]
  
  have hle1 : ∀ B V : Set E3, MeasurableSet B → V ⊆ U → sepPerG G Bᶜ V ≤ sepPerG G B V := by
    intro B V hB hVU
    unfold sepPerG
    refine iSup₂_le (fun X hXadm => ?_)
    obtain ⟨hX, hXc, hXV, hX1⟩ := hXadm
    obtain ⟨hint, h0⟩ := hflux X hX hXc (hXV.trans hVU)
    have hadd := integral_add_compl hB hint
    have hadm : ContDiff ℝ ∞ (-X) ∧ HasCompactSupport (-X) ∧ tsupport (-X) ⊆ V ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (-X) y i * (-X) y j ≤ 1 := by
      refine ⟨hX.neg, hXc.neg, by rw [tsupport_neg]; exact hXV, fun y => ?_⟩
      have := hX1 y
      simpa using this
    have heq : ∫ y in Bᶜ, sepDensDiv G X y = ∫ y in B, sepDensDiv G (-X) y := by
      rw [hneg X, integral_neg]; linarith
    rw [heq]
    exact le_iSup₂ (f := fun (X : E3 → E3) (_ : ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
      tsupport X ⊆ V ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) =>
        ENNReal.ofReal (∫ y in B, sepDensDiv G X y)) (-X) hadm
  
  have hcompl : ∀ A V : Set E3, MeasurableSet A → V ⊆ U → sepPerG G Aᶜ V = sepPerG G A V := by
    intro A V hA hVU
    refine le_antisymm (hle1 A V hA hVU) ?_
    have h := hle1 Aᶜ V hA.compl hVU
    rwa [compl_compl] at h
  
  obtain ⟨hF, hfin, hle⟩ := hmin
  refine ⟨hF.compl, ?_, ?_⟩
  · intro V hVo hVc hVU
    rw [hcompl F V hF (subset_closure.trans hVU)]
    exact hfin V hVo hVc hVU
  · intro F' V K hF' hVo hVc hVU hK hKV hsd
    have hV' : V ⊆ U := subset_closure.trans hVU
    have hsd' : symmDiff F F'ᶜ ⊆ K := by
      rw [← compl_symmDiff_compl, compl_compl]; exact hsd
    rw [hcompl F V hF hV', ← hcompl F' V hF' hV']
    exact hle F'ᶜ V K hF'.compl hVo hVc hVU hK hKV hsd'

theorem smth_graph_null (a : Fin 3) (w : E3 → ℝ) (hw : Continuous w) :
    volume {z : E3 | z a = w (sepPlaneProj a z)} = 0 :=
by
  classical
  have hea : ∀ (z : E3) (c : ℝ), (z + c • e a) a = z a + c := by
    intro z c
    simp [e, EuclideanSpace.single_apply]
  have hproj : ∀ (z : E3) (c : ℝ), sepPlaneProj a (z + c • e a) = sepPlaneProj a z := by
    intro z c
    unfold sepPlaneProj
    rw [hea, add_smul]
    abel
  have hcoord : Continuous (fun z : E3 => z a) := PiLp.continuous_apply 2 _ a
  have hpc : Continuous (sepPlaneProj a) := by
    have : sepPlaneProj a = fun z : E3 => z - (z a) • e a := by
      funext z
      rfl
    rw [this]
    exact continuous_id.sub (hcoord.smul continuous_const)
  let A : ℝ → Set E3 := fun t => {z : E3 | z a = w (sepPlaneProj a z) + t}
  have hAm : ∀ t, MeasurableSet (A t) := fun t =>
    (isClosed_eq hcoord ((hw.comp hpc).add continuous_const)).measurableSet
  have hAd : Pairwise (Function.onFun Disjoint A) := by
    intro s t hst
    rw [Function.onFun, Set.disjoint_left]
    intro z hs ht
    apply hst
    have h1 : z a = w (sepPlaneProj a z) + s := hs
    have h2 : z a = w (sepPlaneProj a z) + t := ht
    linarith
  have hApre : ∀ t, A t = (fun h : E3 => h + (-t) • e a) ⁻¹'
      {z : E3 | z a = w (sepPlaneProj a z)} := by
    intro t
    ext h
    simp only [Set.mem_preimage, Set.mem_setOf_eq, A, hea, hproj]
    constructor <;> intro hh <;> linarith
  have hAv : ∀ t, volume (A t) = volume {z : E3 | z a = w (sepPlaneProj a z)} := by
    intro t
    rw [hApre t]
    exact measure_preimage_add_right volume _ _
  have hc := Measure.countable_meas_pos_of_disjoint_iUnion (μ := (volume : Measure E3)) hAm hAd
  by_contra hne
  have hpos : 0 < volume {z : E3 | z a = w (sepPlaneProj a z)} := pos_iff_ne_zero.mpr hne
  have huniv : {t : ℝ | 0 < volume (A t)} = Set.univ :=
    Set.eq_univ_of_forall (fun t => by
      show 0 < volume (A t)
      rw [hAv t]
      exact hpos)
  rw [huniv] at hc
  exact Cardinal.not_countable_real hc

theorem smth_sepPerG_ae_congr (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F F' V : Set E3)
    (hF : MeasurableSet F) (hF' : MeasurableSet F') (h0 : volume (symmDiff F F' ∩ V) = 0) :
    sepPerG G F V = sepPerG G F' V :=
by
  have key : ∀ X : E3 → E3, tsupport X ⊆ V →
      ∫ y in F, sepDensDiv G X y = ∫ y in F', sepDensDiv G X y := by
    intro X hXV
    have hTm : MeasurableSet (tsupport X) := (isClosed_tsupport X).measurableSet
    have hzero : ∀ y, y ∉ tsupport X → sepDensDiv G X y = 0 := by
      intro y hy
      have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
      unfold sepDensDiv
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have hev' : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] (fun _ => (0:ℝ)) := by
        filter_upwards [hev] with z hz
        rw [hz]
        simp
      unfold partialDeriv
      rw [hev'.fderiv_eq]
      simp
    have hind : sepDensDiv G X = (tsupport X).indicator (sepDensDiv G X) := by
      funext y
      by_cases hy : y ∈ tsupport X
      · rw [Set.indicator_of_mem hy]
      · rw [Set.indicator_of_notMem hy, hzero y hy]
    have hae : (F ∩ tsupport X : Set E3) =ᵐ[volume] (F' ∩ tsupport X : Set E3) := by
      rw [ae_eq_set]
      constructor
      · refine measure_mono_null ?_ h0
        rintro z ⟨⟨hzF, hzT⟩, hz⟩
        exact ⟨Set.mem_symmDiff.mpr (Or.inl ⟨hzF, fun hzF' => hz ⟨hzF', hzT⟩⟩), hXV hzT⟩
      · refine measure_mono_null ?_ h0
        rintro z ⟨⟨hzF', hzT⟩, hz⟩
        exact ⟨Set.mem_symmDiff.mpr (Or.inr ⟨hzF', fun hzF => hz ⟨hzF, hzT⟩⟩), hXV hzT⟩
    rw [hind, setIntegral_indicator hTm, setIntegral_indicator hTm]
    exact setIntegral_congr_set hae
  unfold sepPerG
  refine iSup_congr fun X => iSup_congr fun hX => ?_
  rw [key X hX.2.2.1]

theorem smth_gauss_green_subgraph (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v)
    (Z : Fin 3 → E3 → ℝ) (hZ : ∀ i, ContDiff ℝ 1 (Z i)) (hZc : ∀ i, HasCompactSupport (Z i)) :
    ∫ z in {z : E3 | z a < v (smthHoriz a z)}, ∑ i : Fin 3, partialDeriv i (Z i) z =
      ∫ x : Fin 2 → ℝ, ∑ i : Fin 3, Z i (smthLift a x (v x)) * smthCovec a (smthGrad v x) i :=
by
  classical
  have hLa : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    simp [smthLift]
  have hHL : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro x t; funext k; simp [smthLift, smthHoriz]
  have hlin : ∀ (x : Fin 2 → ℝ) (t : ℝ),
      smthLift a x t = t • e a + ∑ j : Fin 2, x j • e (a.succAbove j) := by
    intro x t
    ext i
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · simp [smthLift, EuclideanSpace.single_apply]
    · simp [smthLift, EuclideanSpace.single_apply]
      fin_cases k <;> simp
  have hHc : Continuous (smthHoriz a) := by
    unfold smthHoriz
    fun_prop
  have hcoord : Continuous (fun z : E3 => z a) := by fun_prop
  have hLc : ∀ {X : Type} [TopologicalSpace X] (f : X → Fin 2 → ℝ) (g : X → ℝ),
      Continuous f → Continuous g → Continuous (fun p => smthLift a (f p) (g p)) := by
    intro X _ f g hf hg
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp (Continuous.finInsertNth a hg hf)
  have hloc : ∀ φ : E3 → ℝ, HasCompactSupport φ → ∃ K : Set (Fin 2 → ℝ), IsCompact K ∧
      ∃ R : ℝ, ∀ x t, φ (smthLift a x t) ≠ 0 → x ∈ K ∧ |t| ≤ R := by
    intro φ hφ
    obtain ⟨R, hR⟩ := hφ.isCompact.exists_bound_of_continuousOn hcoord.continuousOn
    refine ⟨smthHoriz a '' tsupport φ, hφ.isCompact.image hHc, R, fun x t hne => ?_⟩
    have hmem : smthLift a x t ∈ tsupport φ := subset_tsupport _ hne
    refine ⟨⟨_, hmem, hHL x t⟩, ?_⟩
    have := hR _ hmem
    rw [Real.norm_eq_abs, hLa] at this
    exact this
  have hvc : Continuous v := hv.continuous
  have hcs : ∀ φ : E3 → ℝ, HasCompactSupport φ →
      HasCompactSupport (fun p : (Fin 2 → ℝ) × ℝ => φ (smthLift a p.1 (p.2 + v p.1))) ∧
      (∀ s : ℝ, HasCompactSupport (fun x : Fin 2 → ℝ => φ (smthLift a x (s + v x)))) ∧
      (∀ x : Fin 2 → ℝ, HasCompactSupport (fun s : ℝ => φ (smthLift a x (s + v x)))) ∧
      HasCompactSupport (fun x : Fin 2 → ℝ => φ (smthLift a x (v x))) := by
    intro φ hφ
    obtain ⟨K, hK, R, hKR⟩ := hloc φ hφ
    obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn hvc.continuousOn
    refine ⟨?_, fun s => ?_, fun x => ?_, ?_⟩
    · refine HasCompactSupport.intro (hK.prod (isCompact_Icc (a := -(R + M)) (b := R + M)))
        (fun p hp => ?_)
      by_contra hne
      obtain ⟨h1, h2⟩ := hKR _ _ hne
      apply hp
      refine ⟨h1, ?_⟩
      have h3 := hM _ h1
      rw [Real.norm_eq_abs] at h3
      have h4 : |p.2| ≤ R + M := by
        calc |p.2| = |(p.2 + v p.1) - v p.1| := by ring_nf
          _ ≤ |p.2 + v p.1| + |v p.1| := abs_sub _ _
          _ ≤ R + M := add_le_add h2 h3
      exact abs_le.1 h4
    · refine HasCompactSupport.intro hK (fun x hx => ?_)
      by_contra hne
      exact hx (hKR _ _ hne).1
    · refine HasCompactSupport.intro (isCompact_Icc (a := -(R + |v x|)) (b := R + |v x|))
        (fun s hs => ?_)
      by_contra hne
      obtain ⟨_, h2⟩ := hKR _ _ hne
      apply hs
      have h4 : |s| ≤ R + |v x| := by
        calc |s| = |(s + v x) - v x| := by ring_nf
          _ ≤ |s + v x| + |v x| := abs_sub _ _
          _ ≤ R + |v x| := add_le_add h2 le_rfl
      exact abs_le.1 h4
    · refine HasCompactSupport.intro hK (fun x hx => ?_)
      by_contra hne
      exact hx (hKR _ _ hne).1
  
  have hpd : ∀ Y : E3 → ℝ, ContDiff ℝ 1 Y → HasCompactSupport Y → ∀ j : Fin 3,
      Continuous (partialDeriv j Y) ∧ HasCompactSupport (partialDeriv j Y) := by
    intro Y hY hYc j
    refine ⟨?_, ?_⟩
    · show Continuous (fun z => fderiv ℝ Y z (e j))
      exact (hY.continuous_fderiv one_ne_zero).clm_apply continuous_const
    · exact hYc.fderiv_apply (𝕜 := ℝ) (e j)
  have hgradc : ∀ k : Fin 2, Continuous (fun x => smthGrad v x k) := by
    intro k
    show Continuous (fun x => fderiv ℝ v x (Pi.single k 1))
    exact (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hξc : ∀ i : Fin 3, Continuous (fun x => smthCovec a (smthGrad v x) i) := by
    intro i
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · simp only [smthCovec, Fin.insertNth_apply_same]
      exact continuous_const
    · simp only [smthCovec, Fin.insertNth_apply_succAbove, Pi.neg_apply]
      exact (hgradc k).neg
  have hΨc : Continuous (fun p : (Fin 2 → ℝ) × ℝ => smthLift a p.1 (p.2 + v p.1)) :=
    hLc _ _ continuous_fst (continuous_snd.add (hvc.comp continuous_fst))
  have hint : ∀ c : (Fin 2 → ℝ) → ℝ, Continuous c → ∀ φ : E3 → ℝ, Continuous φ →
      HasCompactSupport φ →
      Integrable (fun p : (Fin 2 → ℝ) × ℝ => c p.1 * φ (smthLift a p.1 (p.2 + v p.1))) := by
    intro c hc φ hφ hφc
    exact ((hc.comp continuous_fst).mul (hφ.comp hΨc)).integrable_of_hasCompactSupport
      (hcs φ hφc).1.mul_left
  have hint2 : ∀ c : (Fin 2 → ℝ) → ℝ, Continuous c → ∀ φ : E3 → ℝ, Continuous φ →
      HasCompactSupport φ →
      Integrable (fun x : Fin 2 → ℝ => c x * φ (smthLift a x (v x))) := by
    intro c hc φ hφ hφc
    exact (hc.mul (hφ.comp (hLc _ _ continuous_id hvc))).integrable_of_hasCompactSupport
      (hcs φ hφc).2.2.2.mul_left
  have hHmeas : (volume : Measure ((Fin 2 → ℝ) × ℝ)).restrict {p | p.2 < 0} =
      (volume : Measure (Fin 2 → ℝ)).prod ((volume : Measure ℝ).restrict (Set.Iio 0)) := by
    have hset : {p : (Fin 2 → ℝ) × ℝ | p.2 < 0} = Set.univ ×ˢ Set.Iio 0 := by
      ext p; simp
    rw [hset, Measure.volume_eq_prod, ← Measure.prod_restrict, Measure.restrict_univ]
  
  have hs1 : ∀ g : E3 → ℝ, ∫ z, g z = ∫ p : (Fin 2 → ℝ) × ℝ, g (smthLift a p.1 p.2) := by
    intro g
    have hA : MeasurePreserving
        (MeasurableEquiv.prodComm : (Fin 2 → ℝ) × ℝ ≃ᵐ ℝ × (Fin 2 → ℝ)) volume volume :=
      Measure.measurePreserving_swap (μ := (volume : Measure (Fin 2 → ℝ)))
          (ν := (volume : Measure ℝ))
    have hB : MeasurePreserving (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) a).symm
        (volume : Measure (ℝ × (Fin 2 → ℝ))) (volume : Measure (Fin 3 → ℝ)) :=
      (measurePreserving_piFinSuccAbove (fun _ : Fin 3 => (volume : Measure ℝ)) a).symm
    have hC : MeasurePreserving (MeasurableEquiv.toLp 2 (Fin 3 → ℝ))
        (volume : Measure (Fin 3 → ℝ)) (volume : Measure E3) :=
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3)).symm
    have h1 := hA.trans (hB.trans hC)
    rw [← h1.integral_comp' g]
    congr 1
  have hs2 : ∀ h : (Fin 2 → ℝ) × ℝ → ℝ,
      ∫ p, h p = ∫ p : (Fin 2 → ℝ) × ℝ, h (p.1, p.2 + v p.1) := by
    intro h
    let σ : (Fin 2 → ℝ) × ℝ ≃ᵐ (Fin 2 → ℝ) × ℝ :=
      { toFun := fun p => (p.1, p.2 + v p.1)
        invFun := fun p => (p.1, p.2 - v p.1)
        left_inv := fun p => by simp
        right_inv := fun p => by simp
        measurable_toFun := by
          show Measurable (fun p : (Fin 2 → ℝ) × ℝ => (p.1, p.2 + v p.1))
          apply Continuous.measurable; fun_prop
        measurable_invFun := by
          show Measurable (fun p : (Fin 2 → ℝ) × ℝ => (p.1, p.2 - v p.1))
          apply Continuous.measurable; fun_prop }
    have hσ : MeasurePreserving σ volume volume := by
      have := MeasurePreserving.skew_product (MeasurePreserving.id (volume : Measure (Fin 2 → ℝ)))
        (g := fun x s => s + v x) (μc := (volume : Measure ℝ)) (μd := (volume : Measure ℝ))
        (by apply Continuous.measurable; fun_prop)
        (Filter.Eventually.of_forall (fun x => map_add_right_eq_self volume (v x)))
      exact this
    rw [← hσ.integral_comp' h]
    congr 1
  
  have hΩ : MeasurableSet {z : E3 | z a < v (smthHoriz a z)} :=
    measurableSet_lt hcoord.measurable (hvc.comp hHc).measurable
  have hH : MeasurableSet {p : (Fin 2 → ℝ) × ℝ | p.2 < 0} :=
    measurableSet_lt measurable_snd measurable_const
  have htr : ∀ F : E3 → ℝ, ∫ z in {z : E3 | z a < v (smthHoriz a z)}, F z =
      ∫ p in {p : (Fin 2 → ℝ) × ℝ | p.2 < 0}, F (smthLift a p.1 (p.2 + v p.1)) := by
    intro F
    rw [← integral_indicator hΩ]
    refine (hs1 _).trans ((hs2 (fun p => Set.indicator {z : E3 | z a < v (smthHoriz a z)} F
      (smthLift a p.1 p.2))).trans ?_)
    rw [← integral_indicator hH]
    congr 1
    funext p
    simp only [Set.indicator_apply, Set.mem_setOf_eq, hLa, hHL, add_lt_iff_neg_right]
  
  have hvert : ∀ c : (Fin 2 → ℝ) → ℝ, Continuous c → ∀ Y : E3 → ℝ, ContDiff ℝ 1 Y →
      HasCompactSupport Y →
      ∫ p in {p : (Fin 2 → ℝ) × ℝ | p.2 < 0}, c p.1 * partialDeriv a Y (smthLift a p.1 (p.2 + v p.1))
        = ∫ x, c x * Y (smthLift a x (v x)) := by
    intro c hc Y hY hYc
    obtain ⟨hpc, hpcs⟩ := hpd Y hY hYc a
    have hI := (hint c hc _ hpc hpcs).restrict (s := {p : (Fin 2 → ℝ) × ℝ | p.2 < 0})
    rw [hHmeas] at hI
    rw [hHmeas, integral_prod _ hI]
    congr 1
    funext x
    have hfun : (fun s : ℝ => smthLift a x (s + v x)) =
        fun s => (s + v x) • e a + ∑ j : Fin 2, x j • e (a.succAbove j) :=
      funext fun s => hlin x _
    have hderiv : ∀ s : ℝ, HasDerivAt (fun s => c x * Y (smthLift a x (s + v x)))
        (c x * partialDeriv a Y (smthLift a x (s + v x))) s := by
      intro s
      have hL : HasDerivAt (fun s : ℝ => smthLift a x (s + v x)) (e a) s := by
        rw [hfun]
        simpa using (((hasDerivAt_id s).add_const (v x)).smul_const (e a)).add_const
          (∑ j : Fin 2, x j • e (a.succAbove j))
      exact ((hY.differentiable one_ne_zero _).hasFDerivAt.comp_hasDerivAt s hL).const_mul (c x)
    have hcont' : Continuous (fun s : ℝ => c x * partialDeriv a Y (smthLift a x (s + v x))) :=
      continuous_const.mul (hpc.comp (hLc _ _ continuous_const (continuous_id.add continuous_const)))
    have hIon : IntegrableOn (fun s : ℝ => c x * partialDeriv a Y (smthLift a x (s + v x)))
        (Set.Iic 0) :=
      (hcont'.integrable_of_hasCompactSupport ((hcs _ hpcs).2.2.1 x).mul_left).integrableOn
    have htend : Tendsto (fun s : ℝ => c x * Y (smthLift a x (s + v x))) atBot (𝓝 0) :=
      (((hcs Y hYc).2.2.1 x).mul_left (f := fun _ => c x)).is_zero_at_infty.mono_left
        atBot_le_cocompact
    show ∫ s in Set.Iio 0, c x * partialDeriv a Y (smthLift a x (s + v x)) =
      c x * Y (smthLift a x (v x))
    rw [← integral_Iic_eq_integral_Iio,
      integral_Iic_of_hasDerivAt_of_tendsto' (fun s _ => hderiv s) hIon htend]
    simp
  
  have hhor : ∀ Y : E3 → ℝ, ContDiff ℝ 1 Y → HasCompactSupport Y → ∀ k : Fin 2,
      ∫ p in {p : (Fin 2 → ℝ) × ℝ | p.2 < 0},
        (partialDeriv (a.succAbove k) Y (smthLift a p.1 (p.2 + v p.1)) +
          smthGrad v p.1 k * partialDeriv a Y (smthLift a p.1 (p.2 + v p.1))) = 0 := by
    intro Y hY hYc k
    obtain ⟨hc1, hcs1⟩ := hpd Y hY hYc (a.succAbove k)
    obtain ⟨hc2, hcs2⟩ := hpd Y hY hYc a
    have hI : Integrable (fun p : (Fin 2 → ℝ) × ℝ =>
        partialDeriv (a.succAbove k) Y (smthLift a p.1 (p.2 + v p.1)) +
          smthGrad v p.1 k * partialDeriv a Y (smthLift a p.1 (p.2 + v p.1))) := by
      have h1 := hint (fun _ => 1) continuous_const _ hc1 hcs1
      have h2 := hint (fun x => smthGrad v x k) (hgradc k) _ hc2 hcs2
      simpa using h1.add h2
    have hI' := hI.restrict (s := {p : (Fin 2 → ℝ) × ℝ | p.2 < 0})
    rw [hHmeas] at hI'
    have hinner : ∀ s : ℝ, ∫ x : Fin 2 → ℝ,
        (partialDeriv (a.succAbove k) Y (smthLift a x (s + v x)) +
          smthGrad v x k * partialDeriv a Y (smthLift a x (s + v x))) = 0 := by
      intro s
      have hfun : (fun x : Fin 2 → ℝ => smthLift a x (s + v x)) =
          fun x => (s + v x) • e a + ∑ j : Fin 2, x j • e (a.succAbove j) :=
        funext fun x => hlin x _
      have hL : ∀ x : Fin 2 → ℝ, HasFDerivAt (fun x : Fin 2 → ℝ => smthLift a x (s + v x))
          ((fderiv ℝ v x).smulRight (e a) + ∑ j : Fin 2,
            (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight (e (a.succAbove j))) x := by
        intro x
        rw [hfun]
        have hS : HasFDerivAt (∑ j : Fin 2, fun y : Fin 2 → ℝ => y j • e (a.succAbove j))
            (∑ j : Fin 2, (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight
              (e (a.succAbove j))) x :=
          HasFDerivAt.sum fun j _ => (hasFDerivAt_apply j x).smul_const (e (a.succAbove j))
        have hS' : HasFDerivAt (fun y : Fin 2 → ℝ => ∑ j : Fin 2, y j • e (a.succAbove j))
            (∑ j : Fin 2, (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight
              (e (a.succAbove j))) x := by
          convert hS using 1
        exact (((hv.differentiable one_ne_zero x).hasFDerivAt.const_add s).smul_const (e a)).add hS'
      have hg : ∀ x : Fin 2 → ℝ, HasFDerivAt (fun x => Y (smthLift a x (s + v x)))
          ((fderiv ℝ Y (smthLift a x (s + v x))).comp ((fderiv ℝ v x).smulRight (e a) +
            ∑ j : Fin 2, (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight
              (e (a.succAbove j)))) x := by
        intro x
        exact (hY.differentiable one_ne_zero _).hasFDerivAt.comp x (hL x)
      have hval : ∀ x : Fin 2 → ℝ,
          fderiv ℝ (fun x => Y (smthLift a x (s + v x))) x (Pi.single k 1) =
            partialDeriv (a.succAbove k) Y (smthLift a x (s + v x)) +
              smthGrad v x k * partialDeriv a Y (smthLift a x (s + v x)) := by
        intro x
        rw [(hg x).fderiv]
        have hsum : ∑ j : Fin 2, (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ)
            (Pi.single k 1) • e (a.succAbove j) = e (a.succAbove k) := by
          simp [Pi.single_apply]
        simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.sum_apply, ContinuousLinearMap.smulRight_apply, map_add,
          map_smul, smul_eq_mul, partialDeriv, smthGrad]
        rw [hsum]
        ring
      have hFc : Continuous (fun x : Fin 2 → ℝ =>
          partialDeriv (a.succAbove k) Y (smthLift a x (s + v x)) +
            smthGrad v x k * partialDeriv a Y (smthLift a x (s + v x))) := by
        have hl : Continuous (fun x : Fin 2 → ℝ => smthLift a x (s + v x)) :=
          hLc _ _ continuous_id (continuous_const.add hvc)
        exact (hc1.comp hl).add ((hgradc k).mul (hc2.comp hl))
      have hFcs : HasCompactSupport (fun x : Fin 2 → ℝ =>
          partialDeriv (a.succAbove k) Y (smthLift a x (s + v x)) +
            smthGrad v x k * partialDeriv a Y (smthLift a x (s + v x))) :=
        ((hcs _ hcs1).2.1 s).add (((hcs _ hcs2).2.1 s).mul_left)
      have hgc : Continuous (fun x : Fin 2 → ℝ => Y (smthLift a x (s + v x))) :=
        hY.continuous.comp (hLc _ _ continuous_id (continuous_const.add hvc))
      have hIBP := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
        (f := fun _ : Fin 2 → ℝ => (1 : ℝ)) (g := fun x => Y (smthLift a x (s + v x)))
        (v := Pi.single k 1) (by simp)
        (by
          simp only [one_mul, hval]
          exact hFc.integrable_of_hasCompactSupport hFcs)
        (by
          simp only [one_mul]
          exact hgc.integrable_of_hasCompactSupport ((hcs Y hYc).2.1 s))
        (differentiable_const _) (fun x => (hg x).differentiableAt)
      have h0 : ∀ x : Fin 2 → ℝ, fderiv ℝ (fun _ : Fin 2 → ℝ => (1 : ℝ)) x = 0 :=
        fun x => fderiv_const_apply _
      simp only [h0, ContinuousLinearMap.zero_apply, zero_mul, integral_zero, neg_zero,
        one_mul, hval] at hIBP
      exact hIBP
    rw [hHmeas, integral_prod_symm _ hI']
    exact (integral_congr_ae (Filter.Eventually.of_forall hinner)).trans (integral_zero _ _)
  
  have hpt : ∀ p : (Fin 2 → ℝ) × ℝ,
      ∑ i : Fin 3, partialDeriv i (Z i) (smthLift a p.1 (p.2 + v p.1)) =
        ∑ i : Fin 3, smthCovec a (smthGrad v p.1) i *
            partialDeriv a (Z i) (smthLift a p.1 (p.2 + v p.1)) +
          ∑ k : Fin 2, (partialDeriv (a.succAbove k) (Z (a.succAbove k))
              (smthLift a p.1 (p.2 + v p.1)) +
            smthGrad v p.1 k * partialDeriv a (Z (a.succAbove k))
              (smthLift a p.1 (p.2 + v p.1))) := by
    intro p
    rw [Fin.sum_univ_succAbove _ a, Fin.sum_univ_succAbove _ a]
    simp only [smthCovec, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove, Pi.neg_apply]
    simp only [Fin.sum_univ_two]
    ring
  
  have hIA : ∀ i : Fin 3, Integrable (fun p : (Fin 2 → ℝ) × ℝ =>
      smthCovec a (smthGrad v p.1) i * partialDeriv a (Z i) (smthLift a p.1 (p.2 + v p.1)))
      ((volume : Measure ((Fin 2 → ℝ) × ℝ)).restrict {p | p.2 < 0}) := by
    intro i
    obtain ⟨h1, h2⟩ := hpd (Z i) (hZ i) (hZc i) a
    exact (hint _ (hξc i) _ h1 h2).restrict
  have hIB : ∀ k : Fin 2, Integrable (fun p : (Fin 2 → ℝ) × ℝ =>
      partialDeriv (a.succAbove k) (Z (a.succAbove k)) (smthLift a p.1 (p.2 + v p.1)) +
        smthGrad v p.1 k * partialDeriv a (Z (a.succAbove k)) (smthLift a p.1 (p.2 + v p.1)))
      ((volume : Measure ((Fin 2 → ℝ) × ℝ)).restrict {p | p.2 < 0}) := by
    intro k
    obtain ⟨h1, h2⟩ := hpd (Z (a.succAbove k)) (hZ _) (hZc _) (a.succAbove k)
    obtain ⟨h3, h4⟩ := hpd (Z (a.succAbove k)) (hZ _) (hZc _) a
    have := (hint (fun _ => 1) continuous_const _ h1 h2).add
      (hint (fun x => smthGrad v x k) (hgradc k) _ h3 h4)
    simp only [one_mul] at this
    exact this.restrict
  rw [htr, integral_congr_ae (Filter.Eventually.of_forall hpt),
    integral_add (integrable_finset_sum _ fun i _ => hIA i)
      (integrable_finset_sum _ fun k _ => hIB k),
    integral_finset_sum _ fun i _ => hIA i, integral_finset_sum _ fun k _ => hIB k]
  simp only [fun i => hvert _ (hξc i) (Z i) (hZ i) (hZc i),
    fun k => hhor (Z (a.succAbove k)) (hZ _) (hZc _) k, Finset.sum_const_zero, add_zero]
  rw [← integral_finset_sum _ fun i _ => hint2 _ (hξc i) (Z i) (hZ i).continuous (hZc i)]
  congr 1
  funext x
  exact Finset.sum_congr rfl fun i _ => mul_comm _ _

theorem smth_density_contDiff (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpd : ∀ y ∈ U, (G y).PosDef)
    (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) (hXU : tsupport X ⊆ U)
    (i : Fin 3) :
    ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) ∧
      HasCompactSupport (fun z => Real.sqrt (G z).det * X z i) :=
by
  have hd : ContDiffOn ℝ ∞ (fun y => (G y).det) U := by
    have e : (fun y => (G y).det) = fun y =>
        G y 0 0 * G y 1 1 * G y 2 2 - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      rw [Matrix.det_fin_three]
    rw [e]
    exact (((((((hG 0 0).mul (hG 1 1)).mul (hG 2 2)).sub (((hG 0 0).mul (hG 1 2)).mul (hG 2 1))).sub
      (((hG 0 1).mul (hG 1 0)).mul (hG 2 2))).add (((hG 0 1).mul (hG 1 2)).mul (hG 2 0))).add
      (((hG 0 2).mul (hG 1 0)).mul (hG 2 1))).sub (((hG 0 2).mul (hG 1 1)).mul (hG 2 0))
  have hxi : ContDiff ℝ ∞ (fun z => X z i) :=
    (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff.comp hX
  have hzero : ∀ z, X z = 0 → Real.sqrt (G z).det * X z i = 0 := by
    intro z hz
    rw [hz]
    simp
  refine ⟨?_, ?_⟩
  · refine contDiff_iff_contDiffAt.mpr (fun y => ?_)
    by_cases hy : y ∈ U
    · have h1 : ContDiffAt ℝ ∞ (fun y => (G y).det) y := hd.contDiffAt (hU.mem_nhds hy)
      have h2 : ContDiffAt ℝ ∞ (fun z => Real.sqrt (G z).det) y :=
        h1.sqrt (ne_of_gt (hpd y hy).det_pos)
      exact h2.mul hxi.contDiffAt
    · have hy' : y ∉ tsupport X := fun h => hy (hXU h)
      have hO : (tsupport X)ᶜ ∈ 𝓝 y := (isClosed_tsupport X).isOpen_compl.mem_nhds hy'
      have hev : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
        Filter.eventually_of_mem hO (fun z hz => hzero z (image_eq_zero_of_notMem_tsupport hz))
      exact contDiffAt_const.congr_of_eventuallyEq hev
  · refine hXc.mono ?_
    intro z hz
    by_contra h
    exact hz (hzero z (Function.notMem_support.mp h))

theorem smth_quad_cauchySchwarz (A : Matrix (Fin 3) (Fin 3) ℝ) (hA : A.PosDef)
    (X ξ : Fin 3 → ℝ) :
    (∑ i : Fin 3, X i * ξ i) ^ 2 ≤
      (∑ i : Fin 3, ∑ j : Fin 3, A i j * X i * X j) *
        (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * ξ i * ξ j) :=
by
  classical
  have hdet : IsUnit A.det := (Matrix.isUnit_iff_isUnit_det A).mp hA.isUnit
  have hAinv : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hdet
  obtain ⟨y, hy⟩ : ∃ y : Fin 3 → ℝ, y = Matrix.mulVec A⁻¹ ξ := ⟨_, rfl⟩
  have h3a : Matrix.mulVec A y = ξ := by
    rw [hy, Matrix.mulVec_mulVec, hAinv, Matrix.one_mulVec]
  have hT : A.transpose = A :=
    (Matrix.conjTranspose_eq_transpose_of_trivial A).symm.trans hA.isHermitian.eq
  have hsym : ∀ u v : Fin 3 → ℝ,
      dotProduct u (Matrix.mulVec A v) = dotProduct v (Matrix.mulVec A u) := by
    intro u v
    rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hT, dotProduct_comm]
  have e1 : ∑ i : Fin 3, X i * ξ i = dotProduct X ξ := rfl
  have e2 : ∑ i : Fin 3, ∑ j : Fin 3, A i j * X i * X j = dotProduct X (Matrix.mulVec A X) := by
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
  have e3 : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * ξ i * ξ j =
      dotProduct ξ (Matrix.mulVec A⁻¹ ξ) := by
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
  have hQy : dotProduct ξ (Matrix.mulVec A⁻¹ ξ) = dotProduct y (Matrix.mulVec A y) := by
    rw [← hy, h3a, dotProduct_comm]
  have hB : dotProduct X ξ = dotProduct X (Matrix.mulVec A y) := by
    rw [h3a]
  have h5 : ∀ t : ℝ, 0 ≤ dotProduct y (Matrix.mulVec A y) * (t * t) +
      (2 * dotProduct X (Matrix.mulVec A y)) * t + dotProduct X (Matrix.mulVec A X) := by
    intro t
    have h := hA.posSemidef.dotProduct_mulVec_nonneg (t • y + X)
    have hs : star (t • y + X) = t • y + X := by
      funext i
      simp
    simp only [hs, Matrix.mulVec_add, Matrix.mulVec_smul, dotProduct_add, add_dotProduct,
      dotProduct_smul, smul_dotProduct, smul_eq_mul] at h
    rw [hsym y X] at h
    nlinarith [h]
  have hd := discrim_le_zero h5
  unfold discrim at hd
  rw [e1, e2, e3, hQy, hB]
  nlinarith [hd]

theorem smth_lag_graph_continuousOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hpd : ∀ y ∈ U, (G y).PosDef) (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v)
    (W : Set (Fin 2 → ℝ)) (hW : ∀ x ∈ W, smthLift a x (v x) ∈ U) :
    ContinuousOn (fun x => smthLag G a (x, v x, smthGrad v x)) W :=
by
  have hvc : Continuous v := hv.continuous
  have hgrad : Continuous (fun x => smthGrad v x) := by
    unfold smthGrad
    exact continuous_pi (fun k => (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const)
  have hζ : Continuous (fun x => smthLift a x (v x)) := by
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a hvc continuous_id)
  have hGe : ∀ i j : Fin 3, ContinuousOn (fun x => G (smthLift a x (v x)) i j) W := by
    intro i j
    exact (hG i j).continuousOn.comp hζ.continuousOn (fun x hx => hW x hx)
  have hGm : ContinuousOn (fun x => G (smthLift a x (v x))) W :=
    continuousOn_pi.2 (fun i => continuousOn_pi.2 (fun j => hGe i j))
  have hdet : ContinuousOn (fun x => (G (smthLift a x (v x))).det) W :=
    (continuous_id.matrix_det).comp_continuousOn hGm
  have hinv : ContinuousOn (fun x => (G (smthLift a x (v x)))⁻¹) W := by
    intro x hx
    have hne : (G (smthLift a x (v x))).det ≠ 0 := (hpd _ (hW x hx)).det_pos.ne'
    have hca : ContinuousAt Ring.inverse (G (smthLift a x (v x))).det := by
      rw [Ring.inverse_eq_inv']
      exact continuousAt_inv₀ hne
    exact (continuousAt_matrix_inv _ hca).comp_continuousWithinAt
      (f := fun x => G (smthLift a x (v x))) (hGm x hx)
  have hinve : ∀ i j : Fin 3, ContinuousOn (fun x => (G (smthLift a x (v x)))⁻¹ i j) W :=
    fun i j => (continuous_id.matrix_elem i j).comp_continuousOn hinv
  have hξ : ∀ i : Fin 3, Continuous (fun x => smthCovec a (smthGrad v x) i) := by
    intro i
    have hc : Continuous (fun x => (Fin.insertNth a (1 : ℝ) (-smthGrad v x) : Fin 3 → ℝ)) :=
      Continuous.finInsertNth a continuous_const hgrad.neg
    exact (continuous_apply i).comp hc
  show ContinuousOn (fun x => Real.sqrt (G (smthLift a x (v x))).det *
    Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (smthLift a x (v x)))⁻¹ i j *
      smthCovec a (smthGrad v x) i * smthCovec a (smthGrad v x) j)) W
  refine hdet.sqrt.mul (ContinuousOn.sqrt ?_)
  refine continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ => ?_))
  exact ((hinve i j).mul (hξ i).continuousOn).mul (hξ j).continuousOn

theorem smth_metric_inv_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpd : ∀ y ∈ U, (G y).PosDef) :
    ContDiffOn ℝ ∞ (fun y => (G y).det) U ∧
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U :=
by
  have hdetgen : ∀ M : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => M y k l) U) →
      ContDiffOn ℝ ∞ (fun y => (M y).det) U := by
    intro M hM
    have t1 := ((hM 0 0).mul (hM 1 1)).mul (hM 2 2)
    have t2 := ((hM 0 0).mul (hM 1 2)).mul (hM 2 1)
    have t3 := ((hM 0 1).mul (hM 1 0)).mul (hM 2 2)
    have t4 := ((hM 0 1).mul (hM 1 2)).mul (hM 2 0)
    have t5 := ((hM 0 2).mul (hM 1 0)).mul (hM 2 1)
    have t6 := ((hM 0 2).mul (hM 1 1)).mul (hM 2 0)
    have hpoly := ((((t1.sub t2).sub t3).add t4).add t5).sub t6
    exact hpoly.congr (fun y _ => Matrix.det_fin_three (M y))
  have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdetgen G hG
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) U := by
    intro i j
    have h := hdetgen (fun y => (G y).updateRow j (Pi.single i 1)) (by
      intro k l
      by_cases hk : k = j
      · subst hk
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hk]
        exact hG k l)
    exact h.congr (fun y _ => Matrix.adjugate_apply (G y) i j)
  have hinvformula : ∀ (y : E3) (i j : Fin 3),
      (G y)⁻¹ i j = ((G y).det)⁻¹ * (G y).adjugate i j := by
    intro y i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  refine ⟨hdet, fun i j => ?_⟩
  have h := (hdet.inv (fun y hy => (hpd y hy).det_pos.ne')).mul (hadj i j)
  exact h.congr (fun y _ => hinvformula y i j)

theorem smth_cyl_cutoff (a : Fin 3) (c : E3) (r₁ ρ h₁ h : ℝ) (hr₁ : 0 < r₁) (hr₁ρ : r₁ < ρ)
    (hh₁ : 0 ≤ h₁) (hh₁h : h₁ < h) :
    ∃ χ : E3 → ℝ, ContDiff ℝ ∞ χ ∧ HasCompactSupport χ ∧ tsupport χ ⊆ sepCyl a c ρ h ∧
      (∀ z, 0 ≤ χ z ∧ χ z ≤ 1) ∧
      (∀ z : E3, ∑ k : Fin 2, (z (a.succAbove k) - c (a.succAbove k)) ^ 2 ≤ r₁ ^ 2 →
        |z a - c a| ≤ h₁ → χ z = 1) :=
by
  
  obtain ⟨r₂, hr₂def⟩ : ∃ r₂ : ℝ, r₂ = (r₁ + ρ) / 2 := ⟨_, rfl⟩
  obtain ⟨h₂, hh₂def⟩ : ∃ h₂ : ℝ, h₂ = (h₁ + h) / 2 := ⟨_, rfl⟩
  have hr12 : r₁ < r₂ := by rw [hr₂def]; linarith
  have hr2ρ : r₂ < ρ := by rw [hr₂def]; linarith
  have hr2 : 0 < r₂ := by linarith
  have hh12 : h₁ < h₂ := by rw [hh₂def]; linarith
  have hh2h : h₂ < h := by rw [hh₂def]; linarith
  have hh2 : 0 < h₂ := by linarith
  have hDr : 0 < r₂ ^ 2 - r₁ ^ 2 := by nlinarith
  have hDh : 0 < h₂ ^ 2 - h₁ ^ 2 := by nlinarith
  have hr2ρ2 : r₂ ^ 2 < ρ ^ 2 := by nlinarith
  have hh2h2 : h₂ ^ 2 < h ^ 2 := by nlinarith
  
  obtain ⟨σ, hσdef⟩ : ∃ σ : E3 → ℝ,
      σ = fun z => ∑ k : Fin 2, (z (a.succAbove k) - c (a.succAbove k)) ^ 2 := ⟨_, rfl⟩
  obtain ⟨τ, hτdef⟩ : ∃ τ : E3 → ℝ, τ = fun z => (z a - c a) ^ 2 := ⟨_, rfl⟩
  have hσ : ∀ z, σ z = ∑ k : Fin 2, (z (a.succAbove k) - c (a.succAbove k)) ^ 2 :=
    fun z => by rw [hσdef]
  have hτ : ∀ z, τ z = (z a - c a) ^ 2 := fun z => by rw [hτdef]
  have hcoord : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : E3 => z i) := fun i =>
    (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff
  have hσs : ContDiff ℝ ∞ σ := by
    rw [hσdef]
    exact ContDiff.sum (fun k _ => ((hcoord _).sub contDiff_const).pow 2)
  have hτs : ContDiff ℝ ∞ τ := by
    rw [hτdef]
    exact ((hcoord _).sub contDiff_const).pow 2
  
  obtain ⟨χ, hχdef⟩ : ∃ χ : E3 → ℝ, χ = fun z =>
      Real.smoothTransition ((r₂ ^ 2 - σ z) / (r₂ ^ 2 - r₁ ^ 2)) *
        Real.smoothTransition ((h₂ ^ 2 - τ z) / (h₂ ^ 2 - h₁ ^ 2)) := ⟨_, rfl⟩
  have hχ : ∀ z, χ z = Real.smoothTransition ((r₂ ^ 2 - σ z) / (r₂ ^ 2 - r₁ ^ 2)) *
        Real.smoothTransition ((h₂ ^ 2 - τ z) / (h₂ ^ 2 - h₁ ^ 2)) := fun z => by rw [hχdef]
  
  have hχs : ContDiff ℝ ∞ χ := by
    rw [hχdef]
    have hT : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff (n := ⊤)
    exact (hT.comp ((contDiff_const.sub hσs).div_const _)).mul
      (hT.comp ((contDiff_const.sub hτs).div_const _))
  
  have h01 : ∀ z, 0 ≤ χ z ∧ χ z ≤ 1 := by
    intro z
    rw [hχ]
    exact ⟨mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _),
      mul_le_one₀ (Real.smoothTransition.le_one _) (Real.smoothTransition.nonneg _)
        (Real.smoothTransition.le_one _)⟩
  
  have hone : ∀ z : E3, ∑ k : Fin 2, (z (a.succAbove k) - c (a.succAbove k)) ^ 2 ≤ r₁ ^ 2 →
      |z a - c a| ≤ h₁ → χ z = 1 := by
    intro z hz1 hz2
    have hτ1 : (z a - c a) ^ 2 ≤ h₁ ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) hz2 2
    have e1 : Real.smoothTransition ((r₂ ^ 2 - σ z) / (r₂ ^ 2 - r₁ ^ 2)) = 1 := by
      apply Real.smoothTransition.one_of_one_le
      rw [le_div_iff₀ hDr, hσ z]
      linarith
    have e2 : Real.smoothTransition ((h₂ ^ 2 - τ z) / (h₂ ^ 2 - h₁ ^ 2)) = 1 := by
      apply Real.smoothTransition.one_of_one_le
      rw [le_div_iff₀ hDh, hτ z]
      linarith
    rw [hχ, e1, e2, mul_one]
  
  have hsupp : Function.support χ ⊆ {z | σ z ≤ r₂ ^ 2} ∩ {z | τ z ≤ h₂ ^ 2} := by
    intro z hz
    rw [Function.mem_support, hχ] at hz
    have hA := left_ne_zero_of_mul hz
    have hB := right_ne_zero_of_mul hz
    refine ⟨?_, ?_⟩
    · show σ z ≤ r₂ ^ 2
      by_contra hc
      push_neg at hc
      apply hA
      apply Real.smoothTransition.zero_of_nonpos
      rw [div_le_iff₀ hDr, zero_mul]
      linarith
    · show τ z ≤ h₂ ^ 2
      by_contra hc
      push_neg at hc
      apply hB
      apply Real.smoothTransition.zero_of_nonpos
      rw [div_le_iff₀ hDh, zero_mul]
      linarith
  have hKc : IsClosed ({z | σ z ≤ r₂ ^ 2} ∩ {z | τ z ≤ h₂ ^ 2}) :=
    (isClosed_le hσs.continuous continuous_const).inter
      (isClosed_le hτs.continuous continuous_const)
  have hts : tsupport χ ⊆ {z | σ z ≤ r₂ ^ 2} ∩ {z | τ z ≤ h₂ ^ 2} :=
    closure_minimal hsupp hKc
  
  have hPa : ∀ w : E3, (sepPlaneProj a w) a = 0 := by
    intro w; simp [sepPlaneProj]
  have hPs : ∀ (w : E3) (k : Fin 2), (sepPlaneProj a w) (a.succAbove k) = w (a.succAbove k) := by
    intro w k; simp [sepPlaneProj]
  have hnormsq : ∀ w : E3, ‖w‖ ^ 2 = w a ^ 2 + ∑ k : Fin 2, w (a.succAbove k) ^ 2 := by
    intro w
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_succAbove (fun i => ‖w i‖ ^ 2) a]
    simp [Real.norm_eq_abs, sq_abs]
  have hN1 : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ^ 2 = σ z := by
    intro z
    rw [hnormsq, hPa, hσ]
    simp only [hPs, PiLp.sub_apply]
    ring
  have hN2 : ∀ z : E3, ‖z - c‖ ^ 2 = τ z + σ z := by
    intro z
    rw [hnormsq, hσ, hτ]
    simp only [PiLp.sub_apply]
  
  have hKcyl : {z | σ z ≤ r₂ ^ 2} ∩ {z | τ z ≤ h₂ ^ 2} ⊆ sepCyl a c ρ h := by
    rintro z ⟨hz1, hz2⟩
    have hz1' : σ z ≤ r₂ ^ 2 := hz1
    have hz2' : τ z ≤ h₂ ^ 2 := hz2
    have hA : ‖sepPlaneProj a (z - c)‖ < ρ := by
      have h1 : ‖sepPlaneProj a (z - c)‖ ^ 2 < ρ ^ 2 := by rw [hN1]; linarith
      have h2 := abs_lt_of_sq_lt_sq h1 (by linarith)
      rwa [abs_of_nonneg (norm_nonneg _)] at h2
    have hB : |z a - c a| < h := by
      have h1 : (z a - c a) ^ 2 < h ^ 2 := by rw [← hτ z]; linarith
      exact abs_lt_of_sq_lt_sq h1 (by linarith)
    exact ⟨hA, hB⟩
  
  have hKball : {z | σ z ≤ r₂ ^ 2} ∩ {z | τ z ≤ h₂ ^ 2} ⊆ Metric.closedBall c (h₂ + r₂) := by
    rintro z ⟨hz1, hz2⟩
    have hz1' : σ z ≤ r₂ ^ 2 := hz1
    have hz2' : τ z ≤ h₂ ^ 2 := hz2
    rw [Metric.mem_closedBall, dist_eq_norm]
    have h1 : ‖z - c‖ ^ 2 ≤ (h₂ + r₂) ^ 2 := by rw [hN2]; nlinarith
    nlinarith [norm_nonneg (z - c)]
  refine ⟨χ, hχs, ?_, hts.trans hKcyl, h01, hone⟩
  exact ((isCompact_closedBall c (h₂ + r₂)).of_isClosed_subset hKc hKball).of_isClosed_subset
    (isClosed_tsupport χ) hts

theorem smth_unit_field_contDiff (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U)
    (hpd : ∀ y ∈ U, (G y).PosDef) (χ : E3 → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχU : tsupport χ ⊆ U)
    (ζ : E3 → Fin 3 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζ0 : ∀ z, ζ z ≠ 0) :
    ContDiff ℝ ∞ (fun z => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i =>
      χ z * ((∑ k : Fin 3, (G z)⁻¹ i k * ζ z k) /
        Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l)))) :=
by
  have hζk : ∀ k : Fin 3, ContDiff ℝ ∞ (fun z => ζ z k) := fun k => contDiff_pi.1 hζ k
  have hN : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => ∑ k : Fin 3, (G z)⁻¹ i k * ζ z k) U := by
    intro i
    exact ContDiffOn.sum (fun k _ => (hinv i k).mul (hζk k).contDiffOn)
  have hq : ContDiffOn ℝ ∞
      (fun z => ∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l) U := by
    exact ContDiffOn.sum (fun k _ => ContDiffOn.sum (fun l _ =>
      ((hinv k l).mul (hζk k).contDiffOn).mul (hζk l).contDiffOn))
  have hqpos : ∀ y ∈ U, 0 < ∑ k : Fin 3, ∑ l : Fin 3, (G y)⁻¹ k l * ζ y k * ζ y l := by
    intro y hy
    have h0 := (hpd y hy).inv.dotProduct_mulVec_pos (hζ0 y)
    have e : dotProduct (star (ζ y)) (Matrix.mulVec (G y)⁻¹ (ζ y)) =
        ∑ k : Fin 3, ∑ l : Fin 3, (G y)⁻¹ k l * ζ y k * ζ y l := by
      simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    linarith
  have hsq : ContDiffOn ℝ ∞
      (fun z => Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l)) U :=
    hq.sqrt (fun y hy => (hqpos y hy).ne')
  have hsqne : ∀ y ∈ U,
      Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G y)⁻¹ k l * ζ y k * ζ y l) ≠ 0 :=
    fun y hy => (Real.sqrt_pos.2 (hqpos y hy)).ne'
  have hcomp : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => χ z * ((∑ k : Fin 3, (G z)⁻¹ i k * ζ z k) /
      Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l))) := by
    intro i
    have hon : ContDiffOn ℝ ∞ (fun z => χ z * ((∑ k : Fin 3, (G z)⁻¹ i k * ζ z k) /
        Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l))) U :=
      hχ.contDiffOn.mul ((hN i).div hsq hsqne)
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ U
    · exact hon.contDiffAt (hU.mem_nhds hz)
    · have hzs : z ∉ tsupport χ := fun h => hz (hχU h)
      have hev := (notMem_tsupport_iff_eventuallyEq).1 hzs
      refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [hev] with w hw
      simp only [Pi.zero_apply] at hw
      simp [hw]
  have hΦ : ContDiff ℝ ∞ (fun z => (fun i => χ z * ((∑ k : Fin 3, (G z)⁻¹ i k * ζ z k) /
      Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * ζ z k * ζ z l))) : E3 → Fin 3 → ℝ) :=
    contDiff_pi.2 hcomp
  exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp hΦ

theorem smth_conormal_lower (A : Matrix (Fin 3) (Fin 3) ℝ) (hA : A.PosDef) (ζ ξ : Fin 3 → ℝ)
    (hζ : ζ ≠ 0) (δ C g Cg η t : ℝ) (hδ : 0 ≤ δ) (hC : ∑ i : Fin 3, ∑ j : Fin 3, |A⁻¹ i j| ≤ C)
    (hd : ∀ i : Fin 3, |ζ i - ξ i| ≤ δ) (hg : Real.sqrt g ≤ Cg) (hη : 2 * Cg * Real.sqrt C * δ ≤ η)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    t * (Real.sqrt g * Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * ξ i * ξ j)) - η ≤
      ∑ i : Fin 3, Real.sqrt g *
        (t * ((∑ k : Fin 3, A⁻¹ i k * ζ k) /
          Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l))) * ξ i :=
by
  
  have hBpd : (A⁻¹).PosDef := hA.inv
  have hsym : ∀ i j : Fin 3, A⁻¹ i j = A⁻¹ j i := by
    intro i j
    have h := hBpd.isHermitian.apply i j
    simp only [star_trivial] at h
    exact h.symm
  have hqf : ∀ u : Fin 3 → ℝ, dotProduct (star u) (Matrix.mulVec A⁻¹ u) =
      ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * u i * u j := by
    intro u
    simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
  
  have hquad : ∀ x y : ℝ, ∑ i : Fin 3, ∑ j : Fin 3,
      A⁻¹ i j * (x * (ξ i - ζ i) + y * ζ i) * (x * (ξ j - ζ j) + y * ζ j) =
      x ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) +
        2 * x * y * ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * (ξ i - ζ i) +
        y ^ 2 * ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l := by
    intro x y
    simp only [Fin.sum_univ_three]
    rw [hsym 1 0, hsym 2 0, hsym 2 1]
    ring
  have hnn : ∀ x y : ℝ, 0 ≤
      x ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) +
        2 * x * y * ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * (ξ i - ζ i) +
        y ^ 2 * ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l := by
    intro x y
    have h := hBpd.posSemidef.dotProduct_mulVec_nonneg (fun i => x * (ξ i - ζ i) + y * ζ i)
    rw [hqf] at h
    rw [← hquad x y]
    exact h
  have hQpos : 0 < ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l := by
    have h := hBpd.dotProduct_mulVec_pos hζ
    rw [hqf] at h
    exact h
  have hqd0 : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) := by
    have := hBpd.posSemidef.dotProduct_mulVec_nonneg (fun i => ξ i - ζ i)
    rw [hqf] at this
    exact this
  have hP : ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * ξ i =
      ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l +
        ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * (ξ i - ζ i) := by
    simp only [Fin.sum_univ_three]; ring
  have hexp : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * ξ i * ξ j =
      ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l +
        2 * ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * (ξ i - ζ i) +
        ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) := by
    simp only [Fin.sum_univ_three]
    rw [hsym 1 0, hsym 2 0, hsym 2 1]
    ring
  have hqdC : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) ≤ C * δ ^ 2 := by
    have hdi : ∀ i : Fin 3, |ξ i - ζ i| ≤ δ := fun i => by rw [abs_sub_comm]; exact hd i
    have hterm : ∀ i j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) ≤ |A⁻¹ i j| * δ ^ 2 := by
      intro i j
      calc A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j)
          ≤ |A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j)| := le_abs_self _
        _ = |A⁻¹ i j| * (|ξ i - ζ i| * |ξ j - ζ j|) := by rw [abs_mul, abs_mul, mul_assoc]
        _ ≤ |A⁻¹ i j| * (δ * δ) := by
            apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
            exact mul_le_mul (hdi i) (hdi j) (abs_nonneg _) hδ
        _ = |A⁻¹ i j| * δ ^ 2 := by ring
    calc ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j)
        ≤ ∑ i : Fin 3, ∑ j : Fin 3, |A⁻¹ i j| * δ ^ 2 :=
          Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ => hterm i j))
      _ = (∑ i : Fin 3, ∑ j : Fin 3, |A⁻¹ i j|) * δ ^ 2 := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.sum_mul]
      _ ≤ C * δ ^ 2 := mul_le_mul_of_nonneg_right hC (sq_nonneg δ)
  have hRHS : ∑ i : Fin 3, Real.sqrt g *
        (t * ((∑ k : Fin 3, A⁻¹ i k * ζ k) /
          Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l))) * ξ i =
      t * Real.sqrt g * ((∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * ξ i) /
          Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l)) := by
    simp only [Fin.sum_univ_three]; ring
  rw [hRHS]
  
  generalize hQ : ∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * ζ k * ζ l = Q at *
  generalize hqξ : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * ξ i * ξ j = qξ at *
  generalize hqd : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * (ξ i - ζ i) * (ξ j - ζ j) = qd at *
  generalize hc : ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * (ξ i - ζ i) = c at *
  generalize hPP : ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * ξ i = P at *
  
  have hCS : c ^ 2 ≤ Q * qd := by
    have h := hnn Q (-c)
    nlinarith
  have ha : 0 < Real.sqrt Q := Real.sqrt_pos.2 hQpos
  have ha2 : Real.sqrt Q ^ 2 = Q := Real.sq_sqrt hQpos.le
  have hs0 : 0 ≤ Real.sqrt qd := Real.sqrt_nonneg _
  have hs2 : Real.sqrt qd ^ 2 = qd := Real.sq_sqrt hqd0
  have has : c ^ 2 ≤ (Real.sqrt Q * Real.sqrt qd) ^ 2 := by
    rw [mul_pow, ha2, hs2]; exact hCS
  obtain ⟨hcl, hcu⟩ := abs_le_of_sq_le_sq' has (mul_nonneg ha.le hs0)
  have hb : Real.sqrt qξ ≤ Real.sqrt Q + Real.sqrt qd := by
    have h1 : qξ ≤ (Real.sqrt Q + Real.sqrt qd) ^ 2 := by nlinarith
    calc Real.sqrt qξ ≤ Real.sqrt ((Real.sqrt Q + Real.sqrt qd) ^ 2) := Real.sqrt_le_sqrt h1
      _ = Real.sqrt Q + Real.sqrt qd := Real.sqrt_sq (by positivity)
  have hPa : Real.sqrt Q - Real.sqrt qd ≤ P / Real.sqrt Q := by
    rw [le_div_iff₀ ha]; nlinarith
  have hsC : Real.sqrt qd ≤ Real.sqrt C * δ := by
    calc Real.sqrt qd ≤ Real.sqrt (C * δ ^ 2) := Real.sqrt_le_sqrt hqdC
      _ = Real.sqrt C * Real.sqrt (δ ^ 2) := Real.sqrt_mul' C (sq_nonneg δ)
      _ = Real.sqrt C * δ := by rw [Real.sqrt_sq hδ]
  have hD0 : 0 ≤ 2 * (Real.sqrt C * δ) := by positivity
  have hdiff : Real.sqrt qξ - P / Real.sqrt Q ≤ 2 * (Real.sqrt C * δ) := by linarith
  have hS0 : 0 ≤ Real.sqrt g := Real.sqrt_nonneg _
  have hK0 : 0 ≤ t * Real.sqrt g := mul_nonneg ht0 hS0
  have hKC : t * Real.sqrt g ≤ Cg := le_trans (mul_le_of_le_one_left hS0 ht1) hg
  have h1 := mul_le_mul_of_nonneg_left hdiff hK0
  have h2 := mul_le_mul_of_nonneg_right hKC hD0
  nlinarith

theorem smth_good_field (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (a : Fin 3) (c : E3) (ρ h : ℝ) (hρ : 0 < ρ) (hh : 0 < h)
    (hcl : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ≤ ρ → |z a - c a| ≤ h → z ∈ U)
    (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v)
    (hin : ∀ x : Fin 2 → ℝ, ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 ≤ ρ ^ 2 →
      |v x - c a| < h)
    (r₁ η : ℝ) (hr₁ : 0 < r₁) (hr₁ρ : r₁ < ρ) (hη : 0 < η) :
    ∃ X : E3 → E3,
      (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ sepCyl a c ρ h ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) ∧
      (∀ x ∈ smthDisc a c r₁, smthLag G a (x, v x, smthGrad v x) - η ≤
        ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det * X (smthLift a x (v x)) i *
          smthCovec a (smthGrad v x) i) ∧
      (∀ x ∈ smthDisc a c ρ, -η ≤
        ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det * X (smthLift a x (v x)) i *
          smthCovec a (smthGrad v x) i) :=
by
  classical
  
  have hLa : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    simp [smthLift]
  have hLs : ∀ (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2), (smthLift a x t) (a.succAbove k) = x k := by
    intro x t k
    simp [smthLift]
  have hHL : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro x t; funext k; exact hLs x t k
  have hPa : ∀ w : E3, (sepPlaneProj a w) a = 0 := by
    intro w; simp [sepPlaneProj]
  have hPs : ∀ (w : E3) (k : Fin 2), (sepPlaneProj a w) (a.succAbove k) = w (a.succAbove k) := by
    intro w k; simp [sepPlaneProj]
  have hnormsq : ∀ w : E3, ‖w‖ ^ 2 = w a ^ 2 + ∑ k : Fin 2, w (a.succAbove k) ^ 2 := by
    intro w
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_succAbove (fun i => ‖w i‖ ^ 2) a]
    simp [Real.norm_eq_abs, sq_abs]
  have hGc : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ^ 2 =
      ∑ k : Fin 2, (smthHoriz a z k - c (a.succAbove k)) ^ 2 := by
    intro z
    rw [hnormsq, hPa]
    simp only [hPs, smthHoriz]
    simp
  obtain ⟨s, hs⟩ : ∃ s : (Fin 2 → ℝ) → ℝ, ∀ x, s x = ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  have hsfun : s = fun x => ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 := funext hs
  have hscont : Continuous s := by
    rw [hsfun]; fun_prop
  have hsGc : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ^ 2 = s (smthHoriz a z) := by
    intro z; rw [hs]; exact hGc z
  
  have hGe : ∀ x, s x ≤ ρ ^ 2 → dist x (smthHoriz a c) ≤ ρ := by
    intro x hx
    refine (dist_pi_le_iff hρ.le).2 (fun k => ?_)
    rw [Real.dist_eq]
    rw [hs] at hx
    have hk : (x k - c (a.succAbove k)) ^ 2 ≤ ρ ^ 2 :=
      le_trans (Finset.single_le_sum (f := fun k => (x k - c (a.succAbove k)) ^ 2)
        (fun _ _ => sq_nonneg _) (Finset.mem_univ k)) hx
    exact (sq_le_sq.1 hk).trans_eq (abs_of_pos hρ)
  have hKd : IsCompact {x : Fin 2 → ℝ | s x ≤ ρ ^ 2} := by
    refine Metric.isCompact_of_isClosed_isBounded (isClosed_le hscont continuous_const) ?_
    exact (Metric.isBounded_closedBall (x := smthHoriz a c) (r := ρ)).subset
      (fun x hx => Metric.mem_closedBall.2 (hGe x hx))
  have hc0 : s (smthHoriz a c) = 0 := by
    rw [hs]; simp [smthHoriz]
  have hKne : ({x : Fin 2 → ℝ | s x ≤ ρ ^ 2}).Nonempty :=
    ⟨smthHoriz a c, show s (smthHoriz a c) ≤ ρ ^ 2 by rw [hc0]; positivity⟩
  
  have hzU : ∀ x ∈ {x : Fin 2 → ℝ | s x ≤ ρ ^ 2}, smthLift a x (v x) ∈ U := by
    intro x hx
    have hx' : s x ≤ ρ ^ 2 := hx
    refine hcl _ ?_ ?_
    · have e1 := hsGc (smthLift a x (v x))
      rw [hHL] at e1
      nlinarith [norm_nonneg (sepPlaneProj a (smthLift a x (v x) - c))]
    · rw [hLa]
      have hx'' := hx'
      rw [hs] at hx''
      exact (hin x hx'').le
  
  have hVU : sepCyl a c ρ h ⊆ U := fun z hz => hcl z hz.1.le hz.2.le
  
  have hliftc : Continuous (fun x : Fin 2 → ℝ => smthLift a x (v x)) := by
    have hins : Continuous (fun x : Fin 2 → ℝ => (Fin.insertNth a (v x) x : Fin 3 → ℝ)) := by
      refine continuous_pi (fun i => ?_)
      rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
      · simp only [Fin.insertNth_apply_same]
        exact hv.continuous
      · simp only [Fin.insertNth_apply_succAbove]
        exact continuous_apply k
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp hins
  have hgc : Continuous (smthGrad v) := by
    refine continuous_pi (fun k => ?_)
    exact (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
  
  have hHc : ContDiff ℝ ∞ (smthHoriz a) := by
    refine contDiff_pi.2 (fun k => ?_)
    exact (EuclideanSpace.proj (a.succAbove k) : E3 →L[ℝ] ℝ).contDiff
  have hcovs : ContDiff ℝ ∞ (smthCovec a) := by
    refine contDiff_pi.2 (fun i => ?_)
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · simp only [smthCovec, Fin.insertNth_apply_same]
      exact contDiff_const
    · simp only [smthCovec, Fin.insertNth_apply_succAbove]
      exact (contDiff_apply ℝ ℝ k).neg
  
  have hvc : Continuous v := hv.continuous
  obtain ⟨x₀, hx₀K, hx₀max⟩ := hKd.exists_isMaxOn hKne
    (f := fun x => |v x - c a|) (by fun_prop : Continuous fun x => |v x - c a|).continuousOn
  have hbound : ∀ x, s x ≤ ρ ^ 2 → |v x - c a| ≤ |v x₀ - c a| :=
    fun x hx => isMaxOn_iff.1 hx₀max x hx
  have hh₁ : 0 ≤ |v x₀ - c a| := abs_nonneg _
  have hh₁h : |v x₀ - c a| < h := by
    have h0 : s x₀ ≤ ρ ^ 2 := hx₀K
    rw [hs] at h0
    exact hin x₀ h0
  
  obtain ⟨χ, hχs, hχc, hχV, hχ01, hχ1⟩ :=
    smth_cyl_cutoff a c r₁ ρ |v x₀ - c a| h hr₁ hr₁ρ hh₁ hh₁h
  have hχU : tsupport χ ⊆ U := hχV.trans hVU
  
  obtain ⟨hdetS, hinvS⟩ := smth_metric_inv_contDiffOn G U hG hpd
  
  have hF1 : ContinuousOn (fun x => Real.sqrt (G (smthLift a x (v x))).det)
