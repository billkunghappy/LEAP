  have hUo : IsOpen U := by
    subst hU
    exact hslab_open _ hΩo
  have hVo : IsOpen V := by
    subst hV
    exact hslab_open _ (P.W_open k)
  have hGsV : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G k y a b) V := by
    subst hV
    exact hGs k
  have hτcd : ContDiffOn ℝ ∞ (fun y : E3 => P.proj k (P.param j (hpProj y))) U := by
    subst hU
    exact (P.trans_smooth j k).comp (hprojCD ∞).contDiffOn (fun y hy => hy.2)
  have hTcd : ContDiffOn ℝ ∞ T U := by
    rw [hT]
    exact (((hc0 ∞ 0).contDiffOn.smul contDiffOn_const).add
      (((hc2 ∞ 0).comp_contDiffOn hτcd).smul contDiffOn_const)).add
      (((hc2 ∞ 1).comp_contDiffOn hτcd).smul contDiffOn_const)
  have hTUV : ∀ y ∈ U, T y ∈ V := by
    intro y hy
    have hy' := (hmemU y).mp hy
    rw [hmemV, hTapp, hlift0, hproj_lift]
    exact ⟨hy'.1, (hpatch _ hy'.2).2.1⟩
  have hfk : ContDiffOn ℝ 2 (fun y : E3 => y 0 - u (P.param k (hpProj y))) V := by
    subst hV
    exact (hc0 2 0).contDiffOn.sub ((hu k).comp (hprojCD 2).contDiffOn (fun y hy => hy.2))
  have hTd : ∀ w ∈ U, DifferentiableAt ℝ T w := fun w hw =>
    (hTcd.contDiffAt (hUo.mem_nhds hw)).differentiableAt (by simp)
  
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : E3, y₀ = hpLift (u (P.param j x)) x := ⟨_, rfl⟩
  have hy₀0 : y₀ 0 = u (P.param j x) := by rw [hy₀, hlift0]
  have hy₀p : hpProj y₀ = x := by rw [hy₀, hproj_lift]
  have hy₀1 : |y₀ 0| < s₁ := by
    rw [hy₀0]
    exact hus _ (hpatch x hx).1
  have hy₀U : y₀ ∈ U := by
    rw [hmemU, hy₀p]
    exact ⟨hy₀1, hx⟩
  have hTy₀ : T y₀ = hpLift (u (P.param k (P.proj k (P.param j x)))) (P.proj k (P.param j x)) := by
    rw [hTapp, hy₀0, hy₀p, (hpatch x hx).2.2]
  
  have hGev : G j =ᶠ[𝓝 y₀] (fun w => Matrix.of fun a b : Fin 3 => ∑ c : Fin 3, ∑ d : Fin 3,
      partialDeriv a (fun v => T v c) w * G k (T w) c d * partialDeriv b (fun v => T v d) w) := by
    filter_upwards [hUo.mem_nhds hy₀U] with w hw
    have hw' := (hmemU w).mp hw
    have h1 := hGc j k (w 0) (abs_lt.mp hw'.1) (hpProj w) hw'.2
    rw [hlift_proj] at h1
    have h1' : G j w = pullbackMetric (G k) T w := by
      rw [hT]
      exact h1
    rw [h1']
    ext a b
    simp only [pullbackMetric, Matrix.of_apply, hcompo T w (hTd w hw)]
  have hfev : (fun y : E3 => y 0 - u (P.param j (hpProj y))) =ᶠ[𝓝 y₀]
      (fun w => (fun y : E3 => y 0 - u (P.param k (hpProj y))) (T w)) := by
    filter_upwards [hUo.mem_nhds hy₀U] with w hw
    have hw' := (hmemU w).mp hw
    simp only [hTapp, hlift0, hproj_lift, (hpatch _ hw'.2).2.2]
  
  have hTy₀V := (hmemV _).mp (hTUV y₀ hy₀U)
  have hdetGm : (G k (T y₀)).det ≠ 0 := (hGpd k (T y₀) hTy₀V.1 hTy₀V.2).det_pos.ne'
  have hGy₀ : G j y₀ = Matrix.of fun a b : Fin 3 => ∑ c : Fin 3, ∑ d : Fin 3,
      partialDeriv a (fun v => T v c) y₀ * G k (T y₀) c d * partialDeriv b (fun v => T v d) y₀ :=
    hGev.eq_of_nhds
  have hdetJ : (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => T w a) y₀).det ≠ 0 := by
    intro h0
    have hGt' : (Matrix.of fun a b : Fin 3 => ∑ c : Fin 3, ∑ d : Fin 3,
        partialDeriv a (fun v => T v c) y₀ * G k (T y₀) c d * partialDeriv b (fun v => T v d) y₀) =
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => T w a) y₀).transpose * G k (T y₀) *
          (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => T w a) y₀) := by
      ext a b
      simp only [Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hpos := (hGpd j y₀ hy₀1 (by rw [hy₀p]; exact hx.1)).det_pos
    rw [hGy₀, hGt', Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, h0] at hpos
    simp at hpos
  
  have hkey := key y₀ T (G k) (fun y : E3 => y 0 - u (P.param k (hpProj y))) U V hUo hVo hTcd
    hTUV hGsV (hGsymm k) hfk hy₀U hdetGm hdetJ
  have hL := lmc_congr (G j) _ _ _ y₀ hGev hfev
  show levelMeanCurvCoord (G j) (fun y => y 0 - u (P.param j (hpProj y)))
      (hpLift (u (P.param j x)) x) =
    levelMeanCurvCoord (G k) (fun y => y 0 - u (P.param k (hpProj y)))
      (hpLift (u (P.param k (P.proj k (P.param j x)))) (P.proj k (P.param j x)))
  rw [← hy₀, hL, ← hTy₀]
  exact hkey

theorem pcr_lmc_symbol (W : Set E2) (hW : IsOpen W) (s₁ : ℝ)
    (G : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W})
    (hGsymm : ∀ (y : E3) (a b : Fin 3), G y a b = G y b a)
    (hGpd : ∀ y : E3, |y 0| < s₁ → hpProj y ∈ W → (G y).PosDef) :
    ∃ Ψ : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ,
      ContDiffOn ℝ ∞ Ψ {z | z.1 ∈ W ∧ |z.2.1| < s₁} ∧
      (∀ (w : E2 → ℝ) (x : E2), x ∈ W → |w x| < s₁ → ContDiffAt ℝ 2 w x →
        pcrH G w x = Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)) ∧
      (∀ (w p : E2 → ℝ) (x : E2), x ∈ W → |w x| < s₁ → ContDiffAt ℝ 2 w x →
        ContDiffAt ℝ 2 p x →
        HasDerivAt (fun ε : ℝ => pcrH G (fun x' => w x' + ε * p x') x)
          (fderiv ℝ Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)
            (0, p x, fderiv ℝ p x, fderiv ℝ (fderiv ℝ p) x)) 0) :=
by
  
  
  
  have hP1 : ∀ y : E3, hpProj y 0 = y 1 := by
    intro y; simp [hpProj]
  have hP2 : ∀ y : E3, hpProj y 1 = y 2 := by
    intro y; simp [hpProj]
  have hL0 : ∀ (t : ℝ) (x : E2), (hpLift t x) 0 = t := by
    intro t x; simp [hpLift, cylPt, EuclideanSpace.single_apply]
  have hL1 : ∀ (t : ℝ) (x : E2), (hpLift t x) 1 = x 0 := by
    intro t x; simp [hpLift, cylPt, EuclideanSpace.single_apply]
  have hL2 : ∀ (t : ℝ) (x : E2), (hpLift t x) 2 = x 1 := by
    intro t x; simp [hpLift, cylPt, EuclideanSpace.single_apply]
  have hLP : ∀ (t : ℝ) (x : E2), hpProj (hpLift t x) = x := by
    intro t x; ext k; fin_cases k
    · simp [hP1, hL1]
    · simp [hP2, hL2]
  have hP0 : hpProj (e 0) = 0 := by
    ext k; fin_cases k
    · simp [hP1, EuclideanSpace.single_apply]
    · simp [hP2, EuclideanSpace.single_apply]
  let Pl : E3 →ₗ[ℝ] E2 :=
    { toFun := hpProj
      map_add' := by
        intro y y'; ext k; fin_cases k
        · simp [hP1]
        · simp [hP2]
      map_smul' := by
        intro c y; ext k; fin_cases k
        · simp [hP1]
        · simp [hP2] }
  let P : E3 →L[ℝ] E2 := LinearMap.toContinuousLinearMap Pl
  have hP : ∀ y, P y = hpProj y := fun y => rfl
  have hPf : hpProj = ⇑P := funext fun y => (hP y).symm
  let Ll : ℝ × E2 →ₗ[ℝ] E3 :=
    { toFun := fun p => hpLift p.1 p.2
      map_add' := by
        intro p p'; ext k; fin_cases k
        · simp [hL0]
        · simp [hL1]
        · simp [hL2]
      map_smul' := by
        intro c p; ext k; fin_cases k
        · simp [hL0]
        · simp [hL1]
        · simp [hL2] }
  let L : ℝ × E2 →L[ℝ] E3 := LinearMap.toContinuousLinearMap Ll
  have hL : ∀ t x, L (t, x) = hpLift t x := fun t x => rfl
  let π0 : E3 →L[ℝ] ℝ := EuclideanSpace.proj (0 : Fin 3)
  have hπ0 : ∀ y : E3, π0 y = y 0 := fun y => rfl
  
  
  
  set Sl : Set E3 := {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W} with hSl
  have hSlo : IsOpen Sl := by
    have hcP : Continuous hpProj := by rw [hPf]; exact P.continuous
    exact IsOpen.and (isOpen_lt π0.continuous.abs continuous_const) (hW.preimage hcP)
  set S' : Set (E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ)) :=
    {z | z.1 ∈ W ∧ |z.2.1| < s₁} with hS'
  have hS'o : IsOpen S' :=
    IsOpen.and (hW.preimage continuous_fst) (isOpen_lt continuous_snd.fst.abs continuous_const)
  
  
  
  have hdet : ∀ M : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => M y a b) Sl) →
      ContDiffOn ℝ ∞ (fun y => (M y).det) Sl := by
    intro M hM
    simp only [Matrix.det_fin_three]
    have h00 := hM 0 0; have h01 := hM 0 1; have h02 := hM 0 2
    have h10 := hM 1 0; have h11 := hM 1 1; have h12 := hM 1 2
    have h20 := hM 2 0; have h21 := hM 2 1; have h22 := hM 2 2
    fun_prop
  have hGpd' : ∀ y ∈ Sl, (G y).PosDef := fun y hy => hGpd y hy.1 hy.2
  have hinv : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b) Sl := by
    intro a b
    have hadj : ContDiffOn ℝ ∞ (fun y => (G y).adjugate a b) Sl := by
      simp only [Matrix.adjugate_apply]
      apply hdet
      intro c d
      simp only [Matrix.updateRow_apply]
      split_ifs
      · exact contDiffOn_const
      · exact hGs c d
    have hd : ContDiffOn ℝ ∞ (fun y => ((G y).det)⁻¹) Sl :=
      (hdet G hGs).inv fun y hy => ((hGpd' y hy).det_pos).ne'
    have heq : (fun y => (G y)⁻¹ a b) = fun y => ((G y).det)⁻¹ * (G y).adjugate a b := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv', smul_eq_mul]
    rw [heq]
    exact hd.mul hadj
  have hpd : ∀ a b c : Fin 3, ContDiffOn ℝ ∞ (partialDeriv c (fun z => G z a b)) Sl := by
    intro a b c
    have h1 := (hGs a b).fderiv_of_isOpen hSlo (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hchr : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) Sl := by
    intro k i j
    unfold christoffel
    apply ContDiffOn.mul contDiffOn_const
    apply ContDiffOn.sum
    intro l _
    exact (hinv k l).mul (((hpd j l i).add (hpd i l j)).sub (hpd i j l))
  have hpos : ∀ y ∈ Sl, ∀ v : Fin 3 → ℝ, v ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j := by
    intro y hy v hv
    have h := (hGpd' y hy).inv.dotProduct_mulVec_pos hv
    simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum] at h
    convert h using 2 with i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  
  
  
  have hgraph : ∀ (w : E2 → ℝ) (x : E2) (t : ℝ), ContDiffAt ℝ 2 w x →
      (∀ i : Fin 3, partialDeriv i (fun y => y 0 - w (hpProj y)) (hpLift t x) =
          (e i) 0 - fderiv ℝ w x (hpProj (e i))) ∧
      (∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun y => y 0 - w (hpProj y))) (hpLift t x) =
          -(fderiv ℝ (fderiv ℝ w) x (hpProj (e i)) (hpProj (e j)))) := by
    intro w x t hw
    have hPx : P (hpLift t x) = x := by rw [hP, hLP]
    have hev : ∀ᶠ x' in 𝓝 x, ContDiffAt ℝ 2 w x' := hw.eventually (by decide)
    have hev' : ∀ᶠ y in 𝓝 (hpLift t x), DifferentiableAt ℝ w (P y) := by
      have hT : Tendsto P (𝓝 (hpLift t x)) (𝓝 x) := by
        have := P.continuous.tendsto (hpLift t x)
        rwa [hPx] at this
      exact (hT.eventually hev).mono fun y hy => hy.differentiableAt (by norm_num)
    have hderiv : ∀ y, DifferentiableAt ℝ w (P y) → ∀ j : Fin 3,
        partialDeriv j (fun y => y 0 - w (hpProj y)) y = (e j) 0 - fderiv ℝ w (P y) (P (e j)) := by
      intro y hy j
      have h1 : HasFDerivAt (fun y : E3 => y 0 - w (hpProj y))
          (π0 - (fderiv ℝ w (P y)).comp P) y := by
        rw [hPf]
        exact π0.hasFDerivAt.sub (hy.hasFDerivAt.comp y P.hasFDerivAt)
      unfold partialDeriv
      rw [h1.fderiv]
      simp [hπ0]
    have hx2 : DifferentiableAt ℝ (fderiv ℝ w) x :=
      (hw.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    refine ⟨fun i => ?_, fun i j => ?_⟩
    · rw [hderiv _ (hev'.self_of_nhds) i, hPx, hP]
    · have heq : partialDeriv j (fun y => y 0 - w (hpProj y)) =ᶠ[𝓝 (hpLift t x)]
          fun y => (e j) 0 - fderiv ℝ w (P y) (P (e j)) :=
        hev'.mono fun y hy => hderiv y hy j
      have hA : HasFDerivAt (fun y => fderiv ℝ w (P y))
          ((fderiv ℝ (fderiv ℝ w) x).comp P) (hpLift t x) := by
        have := hx2.hasFDerivAt
        rw [← hPx] at this
        have h2 := this.comp (hpLift t x) P.hasFDerivAt
        rw [hPx] at h2
        exact h2
      have hB : HasFDerivAt (fun y => (e j) 0 - fderiv ℝ w (P y) (P (e j)))
          (-(((fderiv ℝ (fderiv ℝ w) x).comp P).flip (P (e j)))) (hpLift t x) := by
        have h3 := hA.clm_apply (hasFDerivAt_const (P (e j)) (hpLift t x))
        have h4 := h3.const_sub ((e j) 0)
        convert h4 using 1
        ext v
        simp
      change fderiv ℝ (partialDeriv j (fun y => y 0 - w (hpProj y))) (hpLift t x) (e i) = _
      rw [heq.fderiv_eq, hB.fderiv]
      simp [hP]
  
  
  
  have hjet : ∀ (w p : E2 → ℝ) (x : E2), ContDiffAt ℝ 2 w x → ContDiffAt ℝ 2 p x → ∀ ε : ℝ,
      ContDiffAt ℝ 2 (fun x' => w x' + ε * p x') x ∧
      fderiv ℝ (fun x' => w x' + ε * p x') x = fderiv ℝ w x + ε • fderiv ℝ p x ∧
      fderiv ℝ (fderiv ℝ (fun x' => w x' + ε * p x')) x =
        fderiv ℝ (fderiv ℝ w) x + ε • fderiv ℝ (fderiv ℝ p) x := by
    intro w p x hw hp ε
    have hev : ∀ᶠ x' in 𝓝 x, fderiv ℝ (fun x' => w x' + ε * p x') x' =
        fderiv ℝ w x' + ε • fderiv ℝ p x' := by
      filter_upwards [hw.eventually (by decide), hp.eventually (by decide)] with x' hw' hp'
      exact ((hw'.differentiableAt (by norm_num)).hasFDerivAt.add
        ((hp'.differentiableAt (by norm_num)).hasFDerivAt.const_mul ε)).fderiv
    have hw2 : DifferentiableAt ℝ (fderiv ℝ w) x :=
      (hw.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    have hp2 : DifferentiableAt ℝ (fderiv ℝ p) x :=
      (hp.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    refine ⟨hw.add (contDiffAt_const.mul hp), hev.self_of_nhds, ?_⟩
    have hev2 : fderiv ℝ (fun x' => w x' + ε * p x') =ᶠ[𝓝 x]
        fun x' => fderiv ℝ w x' + ε • fderiv ℝ p x' := hev
    rw [hev2.fderiv_eq]
    exact (hw2.hasFDerivAt.add (hp2.hasFDerivAt.const_smul ε)).fderiv
  
  
  
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ,
      Ψ = fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
        (∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            (-(q.2.2.2 (hpProj (e i)) (hpProj (e j))) -
              ∑ k : Fin 3, christoffel G k i j (hpLift q.2.1 q.1) *
                ((e k) 0 - q.2.2.1 (hpProj (e k))))) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j)))) -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
            (G (hpLift q.2.1 q.1))⁻¹ i a * ((e a) 0 - q.2.2.1 (hpProj (e a))) *
              ((G (hpLift q.2.1 q.1))⁻¹ j b * ((e b) 0 - q.2.2.1 (hpProj (e b)))) *
              (-(q.2.2.2 (hpProj (e i)) (hpProj (e j))) -
                ∑ k : Fin 3, christoffel G k i j (hpLift q.2.1 q.1) *
                  ((e k) 0 - q.2.2.1 (hpProj (e k))))) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j)))) ^ 3 :=
    ⟨_, rfl⟩
  
  
  
  have hB : ∀ (w : E2 → ℝ) (x : E2), ContDiffAt ℝ 2 w x →
      pcrH G w x = Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x) := by
    intro w x hw
    obtain ⟨h1, h2⟩ := hgraph w x (w x) hw
    rw [hΨ]
    unfold pcrH levelMeanCurvCoord lapLoc hessLoc
    simp only [h1, h2]
  
  
  
  have hA : ContDiffOn ℝ ∞ Ψ S' := by
    have hY : ContDiff ℝ ∞ (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
        hpLift q.2.1 q.1) := by
      have : (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) => hpLift q.2.1 q.1) =
          fun q => L (q.2.1, q.1) := rfl
      rw [this]
      exact L.contDiff.comp (contDiff_snd.fst.prodMk contDiff_fst)
    have hmaps : Set.MapsTo (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
        hpLift q.2.1 q.1) S' Sl := by
      intro q hq
      exact ⟨by rw [hL0]; exact hq.2, by rw [hLP]; exact hq.1⟩
    have hGi : ∀ a b : Fin 3, ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          (G (hpLift q.2.1 q.1))⁻¹ a b) S' :=
      fun a b => (hinv a b).comp hY.contDiffOn hmaps
    have hCh : ∀ k i j : Fin 3, ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          christoffel G k i j (hpLift q.2.1 q.1)) S' :=
      fun k i j => (hchr k i j).comp hY.contDiffOn hmaps
    have hDF : ∀ k : Fin 3, ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          (e k) 0 - q.2.2.1 (hpProj (e k))) S' := by
      intro k
      exact contDiffOn_const.sub ((contDiff_snd.snd.fst.clm_apply contDiff_const).contDiffOn)
    have hD2 : ∀ i j : Fin 3, ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          -(q.2.2.2 (hpProj (e i)) (hpProj (e j)))) S' := by
      intro i j
      exact (((contDiff_snd.snd.snd.clm_apply contDiff_const).clm_apply
        contDiff_const).neg).contDiffOn
    have hHS : ∀ i j : Fin 3, ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          -(q.2.2.2 (hpProj (e i)) (hpProj (e j))) -
            ∑ k : Fin 3, christoffel G k i j (hpLift q.2.1 q.1) *
              ((e k) 0 - q.2.2.1 (hpProj (e k)))) S' :=
      fun i j => (hD2 i j).sub (ContDiffOn.sum fun k _ => (hCh k i j).mul (hDF k))
    have hrad : ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          ∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j)))) S' :=
      ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ((hGi i j).mul (hDF i)).mul (hDF j)
    have hradpos : ∀ q ∈ S', 0 < ∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
        ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j))) := by
      intro q hq
      have hv : (fun k : Fin 3 => (e k) 0 - q.2.2.1 (hpProj (e k))) ≠ 0 := by
        intro h
        have := congrFun h 0
        simp [hP0] at this
      exact hpos _ (hmaps hq) _ hv
    have hN : ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j))))) S' :=
      hrad.sqrt fun q hq => (hradpos q hq).ne'
    have hNne : ∀ q ∈ S', Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
        ((e i) 0 - q.2.2.1 (hpProj (e i))) * ((e j) 0 - q.2.2.1 (hpProj (e j)))) ≠ 0 :=
      fun q hq => (Real.sqrt_pos.2 (hradpos q hq)).ne'
    have hnum1 : ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          ∑ i : Fin 3, ∑ j : Fin 3, (G (hpLift q.2.1 q.1))⁻¹ i j *
            (-(q.2.2.2 (hpProj (e i)) (hpProj (e j))) -
              ∑ k : Fin 3, christoffel G k i j (hpLift q.2.1 q.1) *
                ((e k) 0 - q.2.2.1 (hpProj (e k))))) S' :=
      ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hGi i j).mul (hHS i j)
    have hnum2 : ContDiffOn ℝ ∞
        (fun q : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) =>
          ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
            (G (hpLift q.2.1 q.1))⁻¹ i a * ((e a) 0 - q.2.2.1 (hpProj (e a))) *
              ((G (hpLift q.2.1 q.1))⁻¹ j b * ((e b) 0 - q.2.2.1 (hpProj (e b)))) *
              (-(q.2.2.2 (hpProj (e i)) (hpProj (e j))) -
                ∑ k : Fin 3, christoffel G k i j (hpLift q.2.1 q.1) *
                  ((e k) 0 - q.2.2.1 (hpProj (e k))))) S' :=
      ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ContDiffOn.sum fun a _ =>
        ContDiffOn.sum fun b _ =>
          (((hGi i a).mul (hDF a)).mul ((hGi j b).mul (hDF b))).mul (hHS i j)
    rw [hΨ]
    exact (hnum1.div hN hNne).sub (hnum2.div (hN.pow 3) fun q hq => pow_ne_zero 3 (hNne q hq))
  
  
  
  have hC : ∀ (w p : E2 → ℝ) (x : E2), x ∈ W → |w x| < s₁ → ContDiffAt ℝ 2 w x →
      ContDiffAt ℝ 2 p x →
      HasDerivAt (fun ε : ℝ => pcrH G (fun x' => w x' + ε * p x') x)
        (fderiv ℝ Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)
          (0, p x, fderiv ℝ p x, fderiv ℝ (fderiv ℝ p) x)) 0 := by
    intro w p x hx hwx hw hp
    have hJ : (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x) ∈ S' := ⟨hx, hwx⟩
    have hd0 := ((hA.contDiffAt (hS'o.mem_nhds hJ)).differentiableAt (by simp)).hasFDerivAt
    have hfun : (fun ε : ℝ => pcrH G (fun x' => w x' + ε * p x') x) =
        fun ε : ℝ => Ψ (x, w x + ε * p x, fderiv ℝ w x + ε • fderiv ℝ p x,
          fderiv ℝ (fderiv ℝ w) x + ε • fderiv ℝ (fderiv ℝ p) x) := by
      funext ε
      obtain ⟨h1, h2, h3⟩ := hjet w p x hw hp ε
      rw [hB _ x h1, h2, h3]
    have hγ := ((hasDerivAt_id' (x := (0 : ℝ))).smul_const
        ((0 : E2), p x, fderiv ℝ p x, fderiv ℝ (fderiv ℝ p) x)).const_add
        (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)
    have hc := hd0.comp_hasDerivAt_of_eq (0 : ℝ) hγ (by simp)
    rw [hfun]
    convert hc using 1
    · funext ε
      simp
    · simp
  exact ⟨Ψ, hA, fun w x _ _ hw => hB w x hw, hC⟩

theorem pcr_balls_exist {X : Type*} [TopologicalSpace X] (S : Set X) (hSc : IsCompact S)
    (P : EigPatchedSurface X S) : Nonempty (PcrBalls P) :=
by
  classical
  let ι := {τ : Fin P.n × E2 × ℝ // 0 < τ.2.2 ∧ Metric.closedBall τ.2.1 τ.2.2 ⊆ P.W τ.1}
  let V : ι → Set X := fun τ => P.O τ.1.1 ∩ P.proj τ.1.1 ⁻¹' Metric.ball τ.1.2.1 τ.1.2.2
  have hVo : ∀ τ, IsOpen (V τ) := fun τ =>
    (P.proj_cont τ.1.1).isOpen_inter_preimage (P.O_open τ.1.1) Metric.isOpen_ball
  have hM : ∀ τ : ι, ∀ q ∈ V τ, q ∈ S →
      ∃ x ∈ Metric.ball τ.1.2.1 τ.1.2.2, P.param τ.1.1 x = q := by
    intro τ q hq hqS
    have hq' : q ∈ P.param τ.1.1 '' P.W τ.1.1 := by
      rw [P.image_eq]; exact ⟨hq.1, hqS⟩
    obtain ⟨x, hx, rfl⟩ := hq'
    refine ⟨x, ?_, rfl⟩
    have h2 : P.proj τ.1.1 (P.param τ.1.1 x) ∈ Metric.ball τ.1.2.1 τ.1.2.2 := hq.2
    rwa [P.proj_param _ x hx] at h2
  have hcov : S ⊆ ⋃ τ, V τ := by
    intro q hqS
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hqS)
    have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq]; exact ⟨hj, hqS⟩
    obtain ⟨x₀, hx₀, rfl⟩ := hq'
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x₀ hx₀
    let τ : ι := ⟨(j, x₀, ε / 2), half_pos hε,
      (Metric.closedBall_subset_ball (half_lt_self hε)).trans hball⟩
    refine Set.mem_iUnion.2 ⟨τ, hj, ?_⟩
    show P.proj j (P.param j x₀) ∈ Metric.ball x₀ (ε / 2)
    rw [P.proj_param j x₀ hx₀]
    exact Metric.mem_ball_self (half_pos hε)
  obtain ⟨t, ht⟩ := hSc.elim_finite_subcover V hVo hcov
  let τf : Fin t.card → ι := fun i => (t.equivFin.symm i : ι)
  refine ⟨{
    N := t.card
    j := (fun i => (τf i).1.1)
    c := (fun i => (τf i).1.2.1)
    ρ := (fun i => (τf i).1.2.2)
    ρ_pos := (fun i => (τf i).2.1)
    sub := (fun i => (τf i).2.2)
    cover := ?_ }⟩
  intro q hqS
  obtain ⟨τ', hτ't, hqV⟩ := Set.mem_iUnion₂.1 (ht hqS)
  refine ⟨t.equivFin ⟨τ', hτ't⟩, ?_⟩
  have hτ : τf (t.equivFin ⟨τ', hτ't⟩) = τ' := by simp [τf]
  show ∃ x ∈ Metric.ball (τf (t.equivFin ⟨τ', hτ't⟩)).1.2.1 (τf (t.equivFin ⟨τ', hτ't⟩)).1.2.2,
    P.param (τf (t.equivFin ⟨τ', hτ't⟩)).1.1 x = q
  rw [hτ]
  exact hM τ' q hqV hqS

theorem pcr_holLoc_mono (U : Set E2) (hU : IsOpen U) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1)
    (m m' : ℕ) (hm : m ≤ m') (w : E2 → ℝ) (hw : pcrHolLoc α m' w U) : pcrHolLoc α m w U :=
by
  rcases Nat.eq_or_lt_of_le hm with h | h
  · subst h
    exact hw
  refine ⟨hw.1.of_le (by exact_mod_cast hm), fun x hx => ?_⟩
  have hxa : ContDiffAt ℝ m' w x := hw.1.contDiffAt (hU.mem_nhds hx)
  have h1 : ContDiffAt ℝ 1 (iteratedFDeriv ℝ m w) x := by
    apply hxa.iteratedFDeriv_right
    have : (1 + m : ℕ) ≤ m' := by omega
    exact_mod_cast this
  obtain ⟨K, t, ht, hL⟩ := h1.exists_lipschitzOnWith
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (Filter.inter_mem (hU.mem_nhds hx) ht)
  have hρ : 0 < min ε (1 / 2) := lt_min hε (by norm_num)
  have hsub : Metric.ball x (min ε (1 / 2)) ⊆ U ∩ t :=
    (Metric.ball_subset_ball (min_le_left _ _)).trans hball
  refine ⟨min ε (1 / 2), hρ, fun y hy => (hsub hy).1, (K : ℝ), fun y hy z hz => ?_⟩
  have hdy : dist y x < min ε (1 / 2) := Metric.mem_ball.mp hy
  have hdz : dist z x < min ε (1 / 2) := Metric.mem_ball.mp hz
  have hhalf : min ε (1 / 2) ≤ 1 / 2 := min_le_right _ _
  have hd1 : dist y z ≤ 1 := by
    have := dist_triangle y x z
    rw [dist_comm x z] at this
    linarith
  have hdα : dist y z ≤ dist y z ^ α := by
    have := Real.rpow_le_rpow_of_exponent_ge' dist_nonneg hd1 hα0.le hα1.le
    rwa [Real.rpow_one] at this
  have hLip : ‖iteratedFDeriv ℝ m w y - iteratedFDeriv ℝ m w z‖ ≤ (K : ℝ) * dist y z := by
    rw [← dist_eq_norm]
    exact hL.dist_le_mul y (hsub hy).2 z (hsub hz).2
  exact hLip.trans (mul_le_mul_of_nonneg_left hdα K.coe_nonneg)

theorem pcr_holLoc_jet_comp (U : Set E2) (hU : IsOpen U) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1)
    (k : ℕ) (w : E2 → ℝ) (hw : pcrHolLoc α (k + 2) w U)
    (D : Set (E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ))) (hD : IsOpen D)
    (Ψ : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ) (hΨ : ContDiffOn ℝ ∞ Ψ D)
    (hjet : ∀ x ∈ U, (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x) ∈ D) :
    pcrHolLoc α k (fun x => Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)) U :=
by
  
  have F0 : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (f : E2 → G) (y z : E2),
      ‖iteratedFDeriv ℝ 0 f y - iteratedFDeriv ℝ 0 f z‖ = ‖f y - f z‖ := by
    intro G _ _ f y z
    rw [iteratedFDeriv_zero_eq_comp]
    simp only [Function.comp_apply]
    rw [← map_sub, LinearIsometryEquiv.norm_map]
  
  have s1 : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (m : ℕ) (f : E2 → G),
      pcrHolV α (m + 1) f U ↔ DifferentiableOn ℝ f U ∧ pcrHolV α m (fderiv ℝ f) U := by
    intro G _ _ m f
    have hnorm : ∀ y z, ‖iteratedFDeriv ℝ (m + 1) f y - iteratedFDeriv ℝ (m + 1) f z‖ =
        ‖iteratedFDeriv ℝ m (fderiv ℝ f) y - iteratedFDeriv ℝ m (fderiv ℝ f) z‖ := by
      intro y z
      rw [iteratedFDeriv_succ_eq_comp_right, iteratedFDeriv_succ_eq_comp_right]
      simp only [Function.comp_apply]
      rw [← LinearIsometryEquiv.map_sub, LinearIsometryEquiv.norm_map]
    have hω : ((m : ℕ) : WithTop ℕ∞) ≠ ω := WithTop.natCast_ne_top m
    have hcd : ContDiffOn ℝ ((m + 1 : ℕ) : WithTop ℕ∞) f U ↔
        DifferentiableOn ℝ f U ∧ ContDiffOn ℝ ((m : ℕ) : WithTop ℕ∞) (fderiv ℝ f) U := by
      rw [show ((m + 1 : ℕ) : WithTop ℕ∞) = ((m : ℕ) : WithTop ℕ∞) + 1 by push_cast; rfl,
        contDiffOn_succ_iff_fderiv_of_isOpen hU]
      constructor
      · rintro ⟨h1, -, h3⟩
        exact ⟨h1, h3⟩
      · rintro ⟨h1, h3⟩
        exact ⟨h1, fun h => absurd h hω, h3⟩
    unfold pcrHolV
    rw [hcd]
    simp only [hnorm]
    exact and_assoc
  
  have s2 : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (m : ℕ) (f : E2 → G),
      ContDiffOn ℝ ((m + 1 : ℕ) : WithTop ℕ∞) f U → pcrHolV α m f U := by
    intro G _ _ m f hf
    refine ⟨hf.of_le (by exact_mod_cast Nat.le_succ m), fun x hx => ?_⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
    have hcb : Metric.closedBall x (ε / 2) ⊆ U :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hcont : ContinuousOn (iteratedFDeriv ℝ (m + 1) f) U :=
      (hf.continuousOn_iteratedFDerivWithin le_rfl hU.uniqueDiffOn).congr
        (fun y hy => (iteratedFDerivWithin_of_isOpen (m + 1) hU hy).symm)
    obtain ⟨L, hL⟩ := (isCompact_closedBall x (ε / 2)).exists_bound_of_continuousOn
      (hcont.mono hcb)
    have hdiff : ∀ v ∈ Metric.ball x (ε / 2), DifferentiableAt ℝ (iteratedFDeriv ℝ m f) v := by
      intro v hv
      exact (hf.contDiffAt (hU.mem_nhds (hcb (Metric.ball_subset_closedBall hv)))).differentiableAt_iteratedFDeriv
        (by exact_mod_cast Nat.lt_succ_self m)
    have hbd : ∀ v ∈ Metric.ball x (ε / 2), ‖fderiv ℝ (iteratedFDeriv ℝ m f) v‖ ≤ max L 0 := by
      intro v hv
      rw [norm_fderiv_iteratedFDeriv]
      exact (hL v (Metric.ball_subset_closedBall hv)).trans (le_max_left _ _)
    refine ⟨ε / 2, by linarith, (Metric.ball_subset_ball (by linarith)).trans hball,
      max L 0 * ε ^ (1 - α), ?_⟩
    intro y hy z hz
    have hmv := (convex_ball x (ε / 2)).norm_image_sub_le_of_norm_fderiv_le hdiff hbd hz hy
    rw [← dist_eq_norm y z] at hmv
    have hd : dist y z < ε := by
      have hy' : dist y x < ε / 2 := hy
      have hz' : dist z x < ε / 2 := hz
      calc dist y z ≤ dist y x + dist z x := dist_triangle_right y z x
        _ < ε / 2 + ε / 2 := add_lt_add hy' hz'
        _ = ε := by ring
    have key : dist y z ≤ ε ^ (1 - α) * dist y z ^ α := by
      rcases (dist_nonneg (x := y) (y := z)).eq_or_lt with h | h
      · rw [← h, Real.zero_rpow hα0.ne']
        simp
      · calc dist y z = dist y z ^ (1 - α) * dist y z ^ α := by
              rw [← Real.rpow_add h]; simp
          _ ≤ ε ^ (1 - α) * dist y z ^ α :=
              mul_le_mul_of_nonneg_right (Real.rpow_le_rpow h.le hd.le (by linarith))
                (Real.rpow_nonneg h.le _)
    calc ‖iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z‖ ≤ max L 0 * dist y z := hmv
      _ ≤ max L 0 * (ε ^ (1 - α) * dist y z ^ α) :=
          mul_le_mul_of_nonneg_left key (le_max_right _ _)
      _ = max L 0 * ε ^ (1 - α) * dist y z ^ α := by ring
  
  have s3 : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (m : ℕ) (f g : E2 → G),
      pcrHolV α m f U → pcrHolV α m g U → pcrHolV α m (fun x => f x + g x) U := by
    intro G _ _ m f g hf hg
    refine ⟨hf.1.add hg.1, fun x hx => ?_⟩
    obtain ⟨ρf, hρf, hbf, Cf, hCf⟩ := hf.2 x hx
    obtain ⟨ρg, hρg, hbg, Cg, hCg⟩ := hg.2 x hx
    refine ⟨min ρf ρg, lt_min hρf hρg, (Metric.ball_subset_ball (min_le_left _ _)).trans hbf,
      Cf + Cg, ?_⟩
    intro y hy z hz
    have hyf := Metric.ball_subset_ball (min_le_left _ _) hy
    have hzf := Metric.ball_subset_ball (min_le_left _ _) hz
    have hyg := Metric.ball_subset_ball (min_le_right _ _) hy
    have hzg := Metric.ball_subset_ball (min_le_right _ _) hz
    have hadd : ∀ v ∈ U, iteratedFDeriv ℝ m (fun x => f x + g x) v =
        iteratedFDeriv ℝ m f v + iteratedFDeriv ℝ m g v := fun v hv =>
      iteratedFDeriv_add_apply (hf.1.contDiffAt (hU.mem_nhds hv)) (hg.1.contDiffAt (hU.mem_nhds hv))
    rw [hadd y (hbf hyf), hadd z (hbf hzf)]
    calc ‖iteratedFDeriv ℝ m f y + iteratedFDeriv ℝ m g y -
          (iteratedFDeriv ℝ m f z + iteratedFDeriv ℝ m g z)‖
        = ‖(iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z) +
            (iteratedFDeriv ℝ m g y - iteratedFDeriv ℝ m g z)‖ := by congr 1; abel
      _ ≤ ‖iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z‖ +
            ‖iteratedFDeriv ℝ m g y - iteratedFDeriv ℝ m g z‖ := norm_add_le _ _
      _ ≤ Cf * dist y z ^ α + Cg * dist y z ^ α :=
          add_le_add (hCf y hyf z hzf) (hCg y hyg z hzg)
      _ = (Cf + Cg) * dist y z ^ α := by ring
  
  have s3b : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (m : ℕ) (f g : E2 → G),
      (∀ x ∈ U, f x = g x) → pcrHolV α m f U → pcrHolV α m g U := by
    intro G _ _ m f g hfg hf
    have heq : ∀ y ∈ U, iteratedFDeriv ℝ m g y = iteratedFDeriv ℝ m f y := by
      intro y hy
      have hev : g =ᶠ[𝓝 y] f :=
        Filter.eventually_of_mem (hU.mem_nhds hy) (fun v hv => (hfg v hv).symm)
      exact (hev.iteratedFDeriv ℝ m).eq_of_nhds
    refine ⟨hf.1.congr (fun y hy => (hfg y hy).symm), fun x hx => ?_⟩
    obtain ⟨ρ, hρ, hb, C, hC⟩ := hf.2 x hx
    refine ⟨ρ, hρ, hb, C, fun y hy z hz => ?_⟩
    rw [heq y (hb hy), heq z (hb hz)]
    exact hC y hy z hz
  
  have s4 : ∀ (m : ℕ) {G₁ G₂ G₃ : Type} [NormedAddCommGroup G₁] [NormedSpace ℝ G₁]
      [NormedAddCommGroup G₂] [NormedSpace ℝ G₂] [NormedAddCommGroup G₃] [NormedSpace ℝ G₃]
      (β : G₁ →L[ℝ] G₂ →L[ℝ] G₃) (a : E2 → G₁) (b : E2 → G₂),
      pcrHolV α m a U → pcrHolV α m b U → pcrHolV α m (fun x => β (a x) (b x)) U := by
    intro m
    induction m with
    | zero =>
      intro G₁ G₂ G₃ _ _ _ _ _ _ β a b ha hb
      refine ⟨(β.contDiff.comp_contDiffOn ha.1).clm_apply hb.1, fun x hx => ?_⟩
      obtain ⟨ρa, hρa, hba, Ca, hCa⟩ := ha.2 x hx
      obtain ⟨ρb, hρb, hbb, Cb, hCb⟩ := hb.2 x hx
      have hρ0 : 0 < min ρa ρb := lt_min hρa hρb
      have hb0 : Metric.ball x (min ρa ρb) ⊆ U :=
        (Metric.ball_subset_ball (min_le_left _ _)).trans hba
      have hcb : Metric.closedBall x (min ρa ρb / 2) ⊆ Metric.ball x (min ρa ρb) :=
        Metric.closedBall_subset_ball (by linarith)
      obtain ⟨Ma, hMa⟩ := (isCompact_closedBall x (min ρa ρb / 2)).exists_bound_of_continuousOn
        (ha.1.continuousOn.mono (hcb.trans hb0))
      obtain ⟨Mb, hMb⟩ := (isCompact_closedBall x (min ρa ρb / 2)).exists_bound_of_continuousOn
        (hb.1.continuousOn.mono (hcb.trans hb0))
      refine ⟨min ρa ρb / 2, by linarith, (Metric.ball_subset_closedBall.trans hcb).trans hb0,
        ‖β‖ * (Ca * max Mb 0 + max Ma 0 * Cb), ?_⟩
      intro y hy z hz
      rw [F0]
      have hyc : y ∈ Metric.closedBall x (min ρa ρb / 2) := Metric.ball_subset_closedBall hy
      have hzc : z ∈ Metric.closedBall x (min ρa ρb / 2) := Metric.ball_subset_closedBall hz
      have hya : y ∈ Metric.ball x ρa := Metric.ball_subset_ball (min_le_left _ _) (hcb hyc)
      have hza : z ∈ Metric.ball x ρa := Metric.ball_subset_ball (min_le_left _ _) (hcb hzc)
      have hyb : y ∈ Metric.ball x ρb := Metric.ball_subset_ball (min_le_right _ _) (hcb hyc)
      have hzb : z ∈ Metric.ball x ρb := Metric.ball_subset_ball (min_le_right _ _) (hcb hzc)
      have h1 : ‖a y - a z‖ ≤ Ca * dist y z ^ α := by rw [← F0]; exact hCa y hya z hza
      have h2 : ‖b y - b z‖ ≤ Cb * dist y z ^ α := by rw [← F0]; exact hCb y hyb z hzb
      have hMa' : ‖a z‖ ≤ max Ma 0 := (hMa z hzc).trans (le_max_left _ _)
      have hMb' : ‖b y‖ ≤ max Mb 0 := (hMb y hyc).trans (le_max_left _ _)
      have hsplit : β (a y) (b y) - β (a z) (b z) =
          β (a y - a z) (b y) + β (a z) (b y - b z) := by
        simp only [map_sub, ContinuousLinearMap.sub_apply]
        abel
      calc ‖β (a y) (b y) - β (a z) (b z)‖
          = ‖β (a y - a z) (b y) + β (a z) (b y - b z)‖ := by rw [hsplit]
        _ ≤ ‖β (a y - a z) (b y)‖ + ‖β (a z) (b y - b z)‖ := norm_add_le _ _
        _ ≤ ‖β‖ * ‖a y - a z‖ * ‖b y‖ + ‖β‖ * ‖a z‖ * ‖b y - b z‖ :=
            add_le_add (β.le_opNorm₂ _ _) (β.le_opNorm₂ _ _)
        _ ≤ ‖β‖ * (Ca * dist y z ^ α) * max Mb 0 + ‖β‖ * max Ma 0 * (Cb * dist y z ^ α) :=
            add_le_add
              (mul_le_mul (mul_le_mul_of_nonneg_left h1 (by positivity)) hMb' (by positivity)
                (mul_nonneg (by positivity) ((norm_nonneg _).trans h1)))
              (mul_le_mul (mul_le_mul_of_nonneg_left hMa' (by positivity)) h2 (by positivity)
                (mul_nonneg (by positivity) (le_max_right _ _)))
        _ = ‖β‖ * (Ca * max Mb 0 + max Ma 0 * Cb) * dist y z ^ α := by ring
    | succ m ih =>
      intro G₁ G₂ G₃ _ _ _ _ _ _ β a b ha hb
      obtain ⟨hda, ha'⟩ := (s1 m a).1 ha
      obtain ⟨hdb, hb'⟩ := (s1 m b).1 hb
      have ha0 : pcrHolV α m a U := s2 m a ha.1
      have hb0 : pcrHolV α m b U := s2 m b hb.1
      have T1 := ih (ContinuousLinearMap.precompR E2 β) a (fderiv ℝ b) ha0 hb'
      have T2 := ih (ContinuousLinearMap.precompL E2 β) (fderiv ℝ a) b ha' hb0
      have T := s3 m _ _ T1 T2
      have hder : ∀ x ∈ U, HasFDerivAt (fun y => β (a y) (b y))
          (ContinuousLinearMap.precompR E2 β (a x) (fderiv ℝ b x) +
            ContinuousLinearMap.precompL E2 β (fderiv ℝ a x) (b x)) x := fun x hx =>
        β.hasFDerivAt_of_bilinear (hda.differentiableAt (hU.mem_nhds hx)).hasFDerivAt
          (hdb.differentiableAt (hU.mem_nhds hx)).hasFDerivAt
      exact (s1 m _).2 ⟨fun x hx => (hder x hx).differentiableAt.differentiableWithinAt,
        s3b m _ _ (fun x hx => (hder x hx).fderiv.symm) T⟩
  
  have s5 : ∀ (m : ℕ) {G H : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
      [NormedAddCommGroup H] [NormedSpace ℝ H] (D' : Set G), IsOpen D' →
      ∀ (Φ : G → H), ContDiffOn ℝ ∞ Φ D' → ∀ (g : E2 → G), pcrHolV α m g U →
      (∀ x ∈ U, g x ∈ D') → pcrHolV α m (fun x => Φ (g x)) U := by
    intro m
    induction m with
    | zero =>
      intro G H _ _ _ _ D' hD' Φ hΦ g hg hgD
      refine ⟨(hΦ.of_le (by exact_mod_cast le_top)).comp hg.1 hgD, fun x hx => ?_⟩
      have hcf : ContinuousOn (fderiv ℝ Φ) D' := hΦ.continuousOn_fderiv_of_isOpen hD' (by simp)
      obtain ⟨ε₁, hε₁, hfε⟩ := Metric.continuousAt_iff.1
        (hcf.continuousAt (hD'.mem_nhds (hgD x hx))) 1 one_pos
      obtain ⟨ε₂, hε₂, hballD⟩ := Metric.isOpen_iff.1 hD' (g x) (hgD x hx)
      have hdiffΦ : ∀ v ∈ Metric.ball (g x) (min ε₁ ε₂), DifferentiableAt ℝ Φ v := fun v hv =>
        (hΦ.differentiableOn (by simp)).differentiableAt
          (hD'.mem_nhds (hballD (Metric.ball_subset_ball (min_le_right _ _) hv)))
      have hbdΦ : ∀ v ∈ Metric.ball (g x) (min ε₁ ε₂),
          ‖fderiv ℝ Φ v‖ ≤ ‖fderiv ℝ Φ (g x)‖ + 1 := by
        intro v hv
        have h := hfε (Metric.ball_subset_ball (min_le_left _ _) hv)
        rw [dist_eq_norm] at h
        have := norm_sub_norm_le (fderiv ℝ Φ v) (fderiv ℝ Φ (g x))
        linarith
      obtain ⟨δ, hδ, hgδ⟩ := Metric.continuousAt_iff.1
        (hg.1.continuousOn.continuousAt (hU.mem_nhds hx)) (min ε₁ ε₂) (lt_min hε₁ hε₂)
      obtain ⟨ρg, hρg, hbg, Cg, hCg⟩ := hg.2 x hx
      refine ⟨min δ ρg, lt_min hδ hρg, (Metric.ball_subset_ball (min_le_right _ _)).trans hbg,
        (‖fderiv ℝ Φ (g x)‖ + 1) * Cg, ?_⟩
      intro y hy z hz
      rw [F0]
      have hy' : g y ∈ Metric.ball (g x) (min ε₁ ε₂) :=
        hgδ (Metric.ball_subset_ball (min_le_left _ _) hy)
      have hz' : g z ∈ Metric.ball (g x) (min ε₁ ε₂) :=
        hgδ (Metric.ball_subset_ball (min_le_left _ _) hz)
      have hmv := (convex_ball (g x) (min ε₁ ε₂)).norm_image_sub_le_of_norm_fderiv_le
        hdiffΦ hbdΦ hz' hy'
      have hgH : ‖g y - g z‖ ≤ Cg * dist y z ^ α := by
        rw [← F0]
        exact hCg y (Metric.ball_subset_ball (min_le_right _ _) hy) z
          (Metric.ball_subset_ball (min_le_right _ _) hz)
      calc ‖Φ (g y) - Φ (g z)‖ ≤ (‖fderiv ℝ Φ (g x)‖ + 1) * ‖g y - g z‖ := hmv
        _ ≤ (‖fderiv ℝ Φ (g x)‖ + 1) * (Cg * dist y z ^ α) :=
            mul_le_mul_of_nonneg_left hgH (by positivity)
        _ = (‖fderiv ℝ Φ (g x)‖ + 1) * Cg * dist y z ^ α := by ring
    | succ m ih =>
      intro G H _ _ _ _ D' hD' Φ hΦ g hg hgD
      obtain ⟨hdg, hg'⟩ := (s1 m g).1 hg
      have hg0 : pcrHolV α m g U := s2 m g hg.1
      obtain ⟨hdΦ, hΦ'⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hD').1 hΦ
      have hA := ih D' hD' (fderiv ℝ Φ) hΦ' g hg0 hgD
      have hB := s4 m (ContinuousLinearMap.compL ℝ E2 G H) (fun x => fderiv ℝ Φ (g x))
        (fderiv ℝ g) hA hg'
      have hder : ∀ x ∈ U, HasFDerivAt (fun y => Φ (g y))
          (ContinuousLinearMap.compL ℝ E2 G H (fderiv ℝ Φ (g x)) (fderiv ℝ g x)) x := by
        intro x hx
        have h1 := (hdΦ.differentiableAt (hD'.mem_nhds (hgD x hx))).hasFDerivAt
        have h2 := (hdg.differentiableAt (hU.mem_nhds hx)).hasFDerivAt
        rw [ContinuousLinearMap.compL_apply]
        exact h1.comp x h2
      exact (s1 m _).2 ⟨fun x hx => (hder x hx).differentiableAt.differentiableWithinAt,
        s3b m _ _ (fun x hx => (hder x hx).fderiv.symm) hB⟩
  
  have hw' : pcrHolV α (k + 2) w U := hw
  obtain ⟨-, h1'⟩ := (s1 (k + 1) w).1 hw'
  obtain ⟨-, h2⟩ := (s1 k (fderiv ℝ w)).1 h1'
  have h1 : pcrHolV α k (fderiv ℝ w) U := s2 k _ h1'.1
  have h0 : pcrHolV α k w U :=
    s2 k w (hw'.1.of_le (by exact_mod_cast (by omega : k + 1 ≤ k + 2)))
  have hid : pcrHolV α k (fun x : E2 => x) U := s2 k _ contDiffOn_id
  have pair : ∀ {A B : Type} [NormedAddCommGroup A] [NormedSpace ℝ A] [NormedAddCommGroup B]
      [NormedSpace ℝ B] (p : E2 → A) (q : E2 → B), pcrHolV α k p U → pcrHolV α k q U →
      pcrHolV α k (fun x => (p x, q x)) U := by
    intro A B _ _ _ _ p q hp hq
    have hl := s5 k Set.univ isOpen_univ (ContinuousLinearMap.inl ℝ A B)
      (ContinuousLinearMap.inl ℝ A B).contDiff.contDiffOn p hp (fun _ _ => Set.mem_univ _)
    have hr := s5 k Set.univ isOpen_univ (ContinuousLinearMap.inr ℝ A B)
      (ContinuousLinearMap.inr ℝ A B).contDiff.contDiffOn q hq (fun _ _ => Set.mem_univ _)
    refine s3b k _ _ (fun x _ => ?_) (s3 k _ _ hl hr)
    simp
  have hJ := pair _ _ hid (pair _ _ h0 (pair _ _ h1 h2))
  exact s5 k D hD Ψ hΨ _ hJ hjet

theorem pcr_locRel_exists (c : E2) (ρ : ℝ) (hρ : 0 < ρ) (U : Set E2) (hU : IsOpen U)
    (hKU : Metric.closedBall c ρ ⊆ U) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (m : ℕ)
    (w : E2 → ℝ) (hw : pcrHolLoc α m w U) : ∃ h : pcrLocAmb c ρ m, pcrLocRel c ρ α m w h :=
by
  classical
  
  have unif : ∀ n : ℕ, pcrHolLoc α n w U → ∃ C : ℝ, ∀ y ∈ Metric.closedBall c ρ,
      ∀ z ∈ Metric.closedBall c ρ,
        ‖iteratedFDeriv ℝ n w y - iteratedFDeriv ℝ n w z‖ ≤ C * dist y z ^ α := by
    intro n hn
    have hK : IsCompact (Metric.closedBall c ρ) := isCompact_closedBall c ρ
    have hcont : ContinuousOn (iteratedFDeriv ℝ n w) U :=
      (hn.1.continuousOn_iteratedFDerivWithin le_rfl hU.uniqueDiffOn).congr
        (iteratedFDerivWithin_of_isOpen n hU).symm
    obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn (hcont.mono hKU)
    choose r hr hrU Cx hCx using fun x : Metric.closedBall c ρ => hn.2 x (hKU x.2)
    have hcov : Metric.closedBall c ρ ⊆
        ⋃ x : Metric.closedBall c ρ, Metric.ball (x : E2) (r x) := by
      intro y hy
      exact Set.mem_iUnion.2 ⟨⟨y, hy⟩, Metric.mem_ball_self (hr _)⟩
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover
      (fun x : Metric.closedBall c ρ => Metric.ball (x : E2) (r x))
      (fun _ => Metric.isOpen_ball) hcov
    have hcov2 : Metric.closedBall c ρ ⊆
        ⋃ i : {x : Metric.closedBall c ρ // x ∈ t}, Metric.ball ((i : Metric.closedBall c ρ) : E2)
          (r i) := by
      intro y hy
      obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 (ht hy)
      exact Set.mem_iUnion.2 ⟨⟨x, hx⟩, hyx⟩
    obtain ⟨δ, hδ, hleb⟩ :=
      lebesgue_number_lemma_of_metric hK (fun _ => Metric.isOpen_ball) hcov2
    have hδα : 0 < δ ^ α := Real.rpow_pos_of_pos hδ α
    have hS : 0 ≤ ∑ x ∈ t, |Cx x| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hT : 0 ≤ 2 * |M| / δ ^ α := div_nonneg (by positivity) hδα.le
    refine ⟨(∑ x ∈ t, |Cx x|) + 2 * |M| / δ ^ α, fun y hy z hz => ?_⟩
    have hdα : 0 ≤ dist y z ^ α := Real.rpow_nonneg dist_nonneg α
    rcases lt_or_ge (dist y z) δ with hd | hd
    · obtain ⟨⟨x, hx⟩, hsub⟩ := hleb y hy
      have hy' : y ∈ Metric.ball (x : E2) (r x) := hsub (Metric.mem_ball_self hδ)
      have hz' : z ∈ Metric.ball (x : E2) (r x) :=
        hsub (by rw [Metric.mem_ball, dist_comm]; exact hd)
      have h1 := hCx x y hy' z hz'
      have h2 : Cx x ≤ ∑ x ∈ t, |Cx x| := (le_abs_self _).trans
        (Finset.single_le_sum (f := fun x => |Cx x|) (fun _ _ => abs_nonneg _) hx)
      calc _ ≤ Cx x * dist y z ^ α := h1
        _ ≤ ((∑ x ∈ t, |Cx x|) + 2 * |M| / δ ^ α) * dist y z ^ α :=
          mul_le_mul_of_nonneg_right (by linarith) hdα
    · have h1 : ‖iteratedFDeriv ℝ n w y - iteratedFDeriv ℝ n w z‖ ≤ 2 * |M| := by
        have e1 := norm_sub_le (iteratedFDeriv ℝ n w y) (iteratedFDeriv ℝ n w z)
        have e2 := hM y hy
        have e3 := hM z hz
        have e4 := le_abs_self M
        linarith
      have h2 : δ ^ α ≤ dist y z ^ α := Real.rpow_le_rpow hδ.le hd hα0.le
      have h3 : 2 * |M| = 2 * |M| / δ ^ α * δ ^ α := (div_mul_cancel₀ _ hδα.ne').symm
      calc _ ≤ 2 * |M| := h1
        _ = 2 * |M| / δ ^ α * δ ^ α := h3
        _ ≤ 2 * |M| / δ ^ α * dist y z ^ α := mul_le_mul_of_nonneg_left h2 hT
        _ ≤ ((∑ x ∈ t, |Cx x|) + 2 * |M| / δ ^ α) * dist y z ^ α :=
          mul_le_mul_of_nonneg_right (by linarith) hdα
  
  have hcontl : ∀ l : Fin (m + 1), ContinuousOn (iteratedFDeriv ℝ (l : ℕ) w) U := by
    intro l
    have hl : ((l : ℕ) : WithTop ℕ∞) ≤ (m : WithTop ℕ∞) := by
      exact_mod_cast Nat.lt_succ_iff.mp l.isLt
    exact (hw.1.continuousOn_iteratedFDerivWithin hl hU.uniqueDiffOn).congr
      (iteratedFDerivWithin_of_isOpen (l : ℕ) hU).symm
  
  have unifLow : ∀ n : ℕ, n < m → ∃ C : ℝ, ∀ y ∈ Metric.closedBall c ρ,
      ∀ z ∈ Metric.closedBall c ρ,
        ‖iteratedFDeriv ℝ n w y - iteratedFDeriv ℝ n w z‖ ≤ C * dist y z ^ α := by
    intro n hn
    have hK : IsCompact (Metric.closedBall c ρ) := isCompact_closedBall c ρ
    have hn' : ((n : ℕ) : WithTop ℕ∞) < (m : WithTop ℕ∞) := by exact_mod_cast hn
    have hdiff : DifferentiableOn ℝ (iteratedFDeriv ℝ n w) U :=
      (hw.1.differentiableOn_iteratedFDerivWithin hn' hU.uniqueDiffOn).congr
        (iteratedFDerivWithin_of_isOpen n hU).symm
    have hn1 : (((n + 1 : ℕ)) : WithTop ℕ∞) ≤ (m : WithTop ℕ∞) := by exact_mod_cast hn
    have hcont1 : ContinuousOn (iteratedFDeriv ℝ (n + 1) w) U :=
      (hw.1.continuousOn_iteratedFDerivWithin hn1 hU.uniqueDiffOn).congr
        (iteratedFDerivWithin_of_isOpen (n + 1) hU).symm
    obtain ⟨M, hM⟩ := hK.exists_bound_of_continuousOn (hcont1.mono hKU)
    refine ⟨|M| * (2 * ρ) ^ (1 - α), fun y hy z hz => ?_⟩
    have hmvt : ‖iteratedFDeriv ℝ n w y - iteratedFDeriv ℝ n w z‖ ≤ |M| * ‖y - z‖ :=
      (convex_closedBall c ρ).norm_image_sub_le_of_norm_fderiv_le
        (fun x hx => hdiff.differentiableAt (hU.mem_nhds (hKU hx)))
        (fun x hx => by
          rw [norm_fderiv_iteratedFDeriv]
          exact (hM x hx).trans (le_abs_self M)) hz hy
    rw [← dist_eq_norm] at hmvt
    have hd2 : dist y z ≤ 2 * ρ := by
      have e1 := dist_triangle_right y z c
      have e2 : dist y c ≤ ρ := Metric.mem_closedBall.1 hy
      have e3 : dist z c ≤ ρ := Metric.mem_closedBall.1 hz
      linarith
    have hsplit : dist y z = dist y z ^ α * dist y z ^ (1 - α) := by
      rw [← Real.rpow_add' dist_nonneg (by norm_num : α + (1 - α) ≠ 0)]
      norm_num
    have hpow : dist y z ^ (1 - α) ≤ (2 * ρ) ^ (1 - α) :=
      Real.rpow_le_rpow dist_nonneg hd2 (by linarith)
    have hdα : 0 ≤ dist y z ^ α := Real.rpow_nonneg dist_nonneg α
    calc _ ≤ |M| * dist y z := hmvt
      _ = |M| * (dist y z ^ α * dist y z ^ (1 - α)) := by rw [← hsplit]
      _ ≤ |M| * (dist y z ^ α * (2 * ρ) ^ (1 - α)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hpow hdα) (abs_nonneg _)
      _ = |M| * (2 * ρ) ^ (1 - α) * dist y z ^ α := by ring
  have hall : ∀ n : ℕ, n ≤ m → ∃ C : ℝ, ∀ y ∈ Metric.closedBall c ρ,
      ∀ z ∈ Metric.closedBall c ρ,
        ‖iteratedFDeriv ℝ n w y - iteratedFDeriv ℝ n w z‖ ≤ C * dist y z ^ α := by
    intro n hn
    rcases hn.lt_or_eq with h | h
    · exact unifLow n h
    · rw [h]; exact unif m hw
  choose C hC using fun l : Fin (m + 1) => hall l (Nat.lt_succ_iff.mp l.isLt)
  haveI : CompactSpace (Metric.closedBall c ρ) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall c ρ)
  have hpos : ∀ p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2},
      0 < dist (p.1.1 : E2) (p.1.2 : E2) ^ α := by
    intro p
    apply Real.rpow_pos_of_pos
    apply dist_pos.2
    intro h
    exact p.2 (Subtype.ext h)
  have hπ1 : Continuous
      (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
        (p.1.1 : E2)) :=
    continuous_subtype_val.comp (continuous_fst.comp continuous_subtype_val)
  have hπ2 : Continuous
      (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
        (p.1.2 : E2)) :=
    continuous_subtype_val.comp (continuous_snd.comp continuous_subtype_val)
  have hqc : ∀ l : Fin (m + 1), Continuous
      (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
        (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
          (iteratedFDeriv ℝ l w p.1.1 - iteratedFDeriv ℝ l w p.1.2)) := by
    intro l
    have hd : Continuous
        (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
          dist (p.1.1 : E2) (p.1.2 : E2) ^ α) :=
      (hπ1.dist hπ2).rpow_const (fun _ => Or.inr hα0.le)
    have h1 : Continuous
        (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
          iteratedFDeriv ℝ l w p.1.1) :=
      ((hcontl l).mono hKU).comp_continuous hπ1 (fun p => p.1.1.2)
    have h2 : Continuous
        (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
          iteratedFDeriv ℝ l w p.1.2) :=
      ((hcontl l).mono hKU).comp_continuous hπ2 (fun p => p.1.2.2)
    exact (hd.inv₀ (fun p => (hpos p).ne')).smul (h1.sub h2)
  have hqb : ∀ (l : Fin (m + 1))
      (p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}),
      ‖(dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
          (iteratedFDeriv ℝ l w p.1.1 - iteratedFDeriv ℝ l w p.1.2)‖ ≤ C l := by
    intro l p
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.2 (hpos p).le)]
    calc _ ≤ (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ *
          (C l * dist (p.1.1 : E2) (p.1.2 : E2) ^ α) :=
          mul_le_mul_of_nonneg_left (hC l _ p.1.1.2 _ p.1.2.2) (inv_nonneg.2 (hpos p).le)
      _ = C l := by rw [mul_comm (C l), inv_mul_cancel_left₀ (hpos p).ne']
  refine ⟨fun l => (BoundedContinuousFunction.mkOfCompact
      ⟨fun x => iteratedFDeriv ℝ l w x, ((hcontl l).mono hKU).restrict⟩,
    BoundedContinuousFunction.ofNormedAddCommGroup _ (hqc l) (C l) (hqb l)), ?_⟩
  intro l
  exact ⟨fun x => rfl, fun p => rfl⟩

theorem pcr_sp_mem_iff {X : Type*} [TopologicalSpace X] {S : Set X} (P : EigPatchedSurface X S)
    (B : PcrBalls P) (α : ℝ) (m : ℕ) (g : pcrAmb B m) :
    g ∈ pcrSp B α m ↔ ∃ u : X → ℝ, pcrClass P α m u ∧
      ∀ i, pcrLocRel (B.c i) (B.ρ i) α m (fun x => u (P.param (B.j i) x)) (g i) :=
by
  have hCD : ∀ (w : E2 → ℝ) (U : Set E2), IsOpen U → ContDiffOn ℝ m w U → ∀ y ∈ U,
      ∀ l : ℕ, l ≤ m → ContDiffAt ℝ l w y := by
    intro w U hU hw y hy l hl
    exact (hw.contDiffAt (hU.mem_nhds hy)).of_le (by exact_mod_cast hl)
  constructor
  · intro hg
    unfold pcrSp at hg
    induction hg using Submodule.span_induction with
    | mem x hx => exact hx
    | zero =>
      refine ⟨fun _ => 0, ⟨fun q _ => rfl, fun j => ⟨contDiffOn_const, fun x hx => ?_⟩⟩,
        fun i l => ⟨fun x => ?_, fun p => ?_⟩⟩
      · obtain ⟨ε, hε, hb⟩ := Metric.isOpen_iff.mp (P.W_open j) x hx
        refine ⟨ε, hε, hb, 0, fun y _ z _ => ?_⟩
        simp [iteratedFDeriv_zero_fun]
      · have h0 : ((0 : pcrAmb B m) i l) = 0 := rfl
        rw [h0]
        simp [iteratedFDeriv_zero_fun]
      · have h0 : ((0 : pcrAmb B m) i l) = 0 := rfl
        rw [h0]
        simp [iteratedFDeriv_zero_fun]
    | add x y _ _ hx hy =>
      obtain ⟨u, hu, hr⟩ := hx
      obtain ⟨u', hu', hr'⟩ := hy
      have e : ∀ j, (fun x => (u + u') (P.param j x)) =
          (fun x => u (P.param j x)) + (fun x => u' (P.param j x)) := fun j => rfl
      refine ⟨u + u', ⟨fun q hq => by simp [hu.1 q hq, hu'.1 q hq], fun j => ⟨?_, fun x hx => ?_⟩⟩,
        fun i l => ⟨fun x => ?_, fun p => ?_⟩⟩
      · exact (hu.2 j).1.add (hu'.2 j).1
      · obtain ⟨ρ₁, hρ₁, hb₁, C₁, hC₁⟩ := (hu.2 j).2 x hx
        obtain ⟨ρ₂, hρ₂, hb₂, C₂, hC₂⟩ := (hu'.2 j).2 x hx
        refine ⟨min ρ₁ ρ₂, lt_min hρ₁ hρ₂,
          (Metric.ball_subset_ball (min_le_left _ _)).trans hb₁, C₁ + C₂, fun y hy z hz => ?_⟩
        have hy₁ : y ∈ Metric.ball x ρ₁ := Metric.ball_subset_ball (min_le_left _ _) hy
        have hz₁ : z ∈ Metric.ball x ρ₁ := Metric.ball_subset_ball (min_le_left _ _) hz
        have hy₂ : y ∈ Metric.ball x ρ₂ := Metric.ball_subset_ball (min_le_right _ _) hy
        have hz₂ : z ∈ Metric.ball x ρ₂ := Metric.ball_subset_ball (min_le_right _ _) hz
        rw [e j, iteratedFDeriv_add_apply (hCD _ _ (P.W_open j) (hu.2 j).1 y (hb₁ hy₁) m le_rfl)
            (hCD _ _ (P.W_open j) (hu'.2 j).1 y (hb₁ hy₁) m le_rfl),
          iteratedFDeriv_add_apply (hCD _ _ (P.W_open j) (hu.2 j).1 z (hb₁ hz₁) m le_rfl)
            (hCD _ _ (P.W_open j) (hu'.2 j).1 z (hb₁ hz₁) m le_rfl),
          add_sub_add_comm]
        calc _ ≤ _ := norm_add_le _ _
          _ ≤ C₁ * dist y z ^ α + C₂ * dist y z ^ α :=
            add_le_add (hC₁ y hy₁ z hz₁) (hC₂ y hy₂ z hz₂)
          _ = (C₁ + C₂) * dist y z ^ α := by ring
      · have hl : (l : ℕ) ≤ m := Nat.lt_succ_iff.mp l.isLt
        have hxW : (x : E2) ∈ P.W (B.j i) := B.sub i x.2
        rw [e (B.j i), iteratedFDeriv_add_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ hxW l hl)
            (hCD _ _ (P.W_open _) (hu'.2 _).1 _ hxW l hl),
          ← (hr i l).1 x, ← (hr' i l).1 x]
        rfl
      · have hl : (l : ℕ) ≤ m := Nat.lt_succ_iff.mp l.isLt
        have h1W : (p.1.1 : E2) ∈ P.W (B.j i) := B.sub i p.1.1.2
        have h2W : (p.1.2 : E2) ∈ P.W (B.j i) := B.sub i p.1.2.2
        rw [e (B.j i), iteratedFDeriv_add_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ h1W l hl)
            (hCD _ _ (P.W_open _) (hu'.2 _).1 _ h1W l hl),
          iteratedFDeriv_add_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ h2W l hl)
            (hCD _ _ (P.W_open _) (hu'.2 _).1 _ h2W l hl),
          add_sub_add_comm, smul_add, ← (hr i l).2 p, ← (hr' i l).2 p]
        rfl
    | smul a x _ hx =>
      obtain ⟨u, hu, hr⟩ := hx
      have e : ∀ j, (fun x => (a • u) (P.param j x)) = a • (fun x => u (P.param j x)) :=
        fun j => rfl
      refine ⟨a • u, ⟨fun q hq => by simp [hu.1 q hq], fun j => ⟨?_, fun x hx => ?_⟩⟩,
        fun i l => ⟨fun x => ?_, fun p => ?_⟩⟩
      · exact (hu.2 j).1.const_smul a
      · obtain ⟨ρ₁, hρ₁, hb₁, C₁, hC₁⟩ := (hu.2 j).2 x hx
        refine ⟨ρ₁, hρ₁, hb₁, |a| * C₁, fun y hy z hz => ?_⟩
        rw [e j, iteratedFDeriv_const_smul_apply
            (hCD _ _ (P.W_open j) (hu.2 j).1 y (hb₁ hy) m le_rfl),
          iteratedFDeriv_const_smul_apply
            (hCD _ _ (P.W_open j) (hu.2 j).1 z (hb₁ hz) m le_rfl),
          ← smul_sub, norm_smul, Real.norm_eq_abs, mul_assoc]
        exact mul_le_mul_of_nonneg_left (hC₁ y hy z hz) (abs_nonneg a)
      · have hl : (l : ℕ) ≤ m := Nat.lt_succ_iff.mp l.isLt
        have hxW : (x : E2) ∈ P.W (B.j i) := B.sub i x.2
        rw [e (B.j i), iteratedFDeriv_const_smul_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ hxW l hl), ← (hr i l).1 x]
        rfl
      · have hl : (l : ℕ) ≤ m := Nat.lt_succ_iff.mp l.isLt
        have h1W : (p.1.1 : E2) ∈ P.W (B.j i) := B.sub i p.1.1.2
        have h2W : (p.1.2 : E2) ∈ P.W (B.j i) := B.sub i p.1.2.2
        rw [e (B.j i), iteratedFDeriv_const_smul_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ h1W l hl),
          iteratedFDeriv_const_smul_apply
            (hCD _ _ (P.W_open _) (hu.2 _).1 _ h2W l hl),
          ← smul_sub, smul_comm _ a, ← (hr i l).2 p]
        rfl
  · intro h
    exact Submodule.subset_span h

theorem pcr_holLoc_comp_smooth (U V : Set E2) (hU : IsOpen U) (hV : IsOpen V) (α : ℝ)
    (hα0 : 0 < α) (hα1 : α < 1) (m : ℕ) (f : E2 → ℝ) (hf : pcrHolLoc α m f V)
    (τ : E2 → E2) (hτ : ContDiffOn ℝ ∞ τ U) (hτUV : Set.MapsTo τ U V) :
    pcrHolLoc α m (fun x => f (τ x)) U :=
by
  
  have F0 : ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (f : E2 → G) (y z : E2),
      ‖iteratedFDeriv ℝ 0 f y - iteratedFDeriv ℝ 0 f z‖ = ‖f y - f z‖ := by
    intro G _ _ f y z
    rw [iteratedFDeriv_zero_eq_comp]
    simp only [Function.comp_apply]
    rw [← map_sub, LinearIsometryEquiv.norm_map]
  
  have s1 : ∀ (W : Set E2), IsOpen W → ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
      (m : ℕ) (f : E2 → G),
      pcrHolV α (m + 1) f W ↔ DifferentiableOn ℝ f W ∧ pcrHolV α m (fderiv ℝ f) W := by
    intro W hW G _ _ m f
    have hnorm : ∀ y z, ‖iteratedFDeriv ℝ (m + 1) f y - iteratedFDeriv ℝ (m + 1) f z‖ =
        ‖iteratedFDeriv ℝ m (fderiv ℝ f) y - iteratedFDeriv ℝ m (fderiv ℝ f) z‖ := by
      intro y z
      rw [iteratedFDeriv_succ_eq_comp_right, iteratedFDeriv_succ_eq_comp_right]
      simp only [Function.comp_apply]
      rw [← LinearIsometryEquiv.map_sub, LinearIsometryEquiv.norm_map]
    have hω : ((m : ℕ) : WithTop ℕ∞) ≠ ω := WithTop.natCast_ne_top m
    have hcd : ContDiffOn ℝ ((m + 1 : ℕ) : WithTop ℕ∞) f W ↔
        DifferentiableOn ℝ f W ∧ ContDiffOn ℝ ((m : ℕ) : WithTop ℕ∞) (fderiv ℝ f) W := by
      rw [show ((m + 1 : ℕ) : WithTop ℕ∞) = ((m : ℕ) : WithTop ℕ∞) + 1 by push_cast; rfl,
        contDiffOn_succ_iff_fderiv_of_isOpen hW]
      constructor
      · rintro ⟨h1, -, h3⟩
        exact ⟨h1, h3⟩
      · rintro ⟨h1, h3⟩
        exact ⟨h1, fun h => absurd h hω, h3⟩
    unfold pcrHolV
    rw [hcd]
    simp only [hnorm]
    exact and_assoc
  
  have s2 : ∀ (W : Set E2), IsOpen W → ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
      (m : ℕ) (f : E2 → G),
      ContDiffOn ℝ ((m + 1 : ℕ) : WithTop ℕ∞) f W → pcrHolV α m f W := by
    intro W hW G _ _ m f hf
    refine ⟨hf.of_le (by exact_mod_cast Nat.le_succ m), fun x hx => ?_⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hW x hx
    have hcb : Metric.closedBall x (ε / 2) ⊆ W :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hcont : ContinuousOn (iteratedFDeriv ℝ (m + 1) f) W :=
      (hf.continuousOn_iteratedFDerivWithin le_rfl hW.uniqueDiffOn).congr
        (fun y hy => (iteratedFDerivWithin_of_isOpen (m + 1) hW hy).symm)
    obtain ⟨L, hL⟩ := (isCompact_closedBall x (ε / 2)).exists_bound_of_continuousOn
      (hcont.mono hcb)
    have hdiff : ∀ v ∈ Metric.ball x (ε / 2), DifferentiableAt ℝ (iteratedFDeriv ℝ m f) v := by
      intro v hv
      exact (hf.contDiffAt (hW.mem_nhds (hcb (Metric.ball_subset_closedBall hv)))).differentiableAt_iteratedFDeriv
        (by exact_mod_cast Nat.lt_succ_self m)
    have hbd : ∀ v ∈ Metric.ball x (ε / 2), ‖fderiv ℝ (iteratedFDeriv ℝ m f) v‖ ≤ max L 0 := by
      intro v hv
      rw [norm_fderiv_iteratedFDeriv]
      exact (hL v (Metric.ball_subset_closedBall hv)).trans (le_max_left _ _)
    refine ⟨ε / 2, by linarith, (Metric.ball_subset_ball (by linarith)).trans hball,
      max L 0 * ε ^ (1 - α), ?_⟩
    intro y hy z hz
    have hmv := (convex_ball x (ε / 2)).norm_image_sub_le_of_norm_fderiv_le hdiff hbd hz hy
    rw [← dist_eq_norm y z] at hmv
    have hd : dist y z < ε := by
      have hy' : dist y x < ε / 2 := hy
      have hz' : dist z x < ε / 2 := hz
      calc dist y z ≤ dist y x + dist z x := dist_triangle_right y z x
        _ < ε / 2 + ε / 2 := add_lt_add hy' hz'
        _ = ε := by ring
    have key : dist y z ≤ ε ^ (1 - α) * dist y z ^ α := by
      rcases (dist_nonneg (x := y) (y := z)).eq_or_lt with h | h
      · rw [← h, Real.zero_rpow hα0.ne']
        simp
      · calc dist y z = dist y z ^ (1 - α) * dist y z ^ α := by
              rw [← Real.rpow_add h]; simp
          _ ≤ ε ^ (1 - α) * dist y z ^ α :=
              mul_le_mul_of_nonneg_right (Real.rpow_le_rpow h.le hd.le (by linarith))
                (Real.rpow_nonneg h.le _)
    calc ‖iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z‖ ≤ max L 0 * dist y z := hmv
      _ ≤ max L 0 * (ε ^ (1 - α) * dist y z ^ α) :=
          mul_le_mul_of_nonneg_left key (le_max_right _ _)
      _ = max L 0 * ε ^ (1 - α) * dist y z ^ α := by ring
  
  have s3 : ∀ (W : Set E2), IsOpen W → ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
      (m : ℕ) (f g : E2 → G),
      pcrHolV α m f W → pcrHolV α m g W → pcrHolV α m (fun x => f x + g x) W := by
    intro W hW G _ _ m f g hf hg
    refine ⟨hf.1.add hg.1, fun x hx => ?_⟩
    obtain ⟨ρf, hρf, hbf, Cf, hCf⟩ := hf.2 x hx
    obtain ⟨ρg, hρg, hbg, Cg, hCg⟩ := hg.2 x hx
    refine ⟨min ρf ρg, lt_min hρf hρg, (Metric.ball_subset_ball (min_le_left _ _)).trans hbf,
      Cf + Cg, ?_⟩
    intro y hy z hz
    have hyf := Metric.ball_subset_ball (min_le_left _ _) hy
    have hzf := Metric.ball_subset_ball (min_le_left _ _) hz
    have hyg := Metric.ball_subset_ball (min_le_right _ _) hy
    have hzg := Metric.ball_subset_ball (min_le_right _ _) hz
    have hadd : ∀ v ∈ W, iteratedFDeriv ℝ m (fun x => f x + g x) v =
        iteratedFDeriv ℝ m f v + iteratedFDeriv ℝ m g v := fun v hv =>
      iteratedFDeriv_add_apply (hf.1.contDiffAt (hW.mem_nhds hv)) (hg.1.contDiffAt (hW.mem_nhds hv))
    rw [hadd y (hbf hyf), hadd z (hbf hzf)]
    calc ‖iteratedFDeriv ℝ m f y + iteratedFDeriv ℝ m g y -
          (iteratedFDeriv ℝ m f z + iteratedFDeriv ℝ m g z)‖
        = ‖(iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z) +
            (iteratedFDeriv ℝ m g y - iteratedFDeriv ℝ m g z)‖ := by congr 1; abel
      _ ≤ ‖iteratedFDeriv ℝ m f y - iteratedFDeriv ℝ m f z‖ +
            ‖iteratedFDeriv ℝ m g y - iteratedFDeriv ℝ m g z‖ := norm_add_le _ _
      _ ≤ Cf * dist y z ^ α + Cg * dist y z ^ α :=
          add_le_add (hCf y hyf z hzf) (hCg y hyg z hzg)
      _ = (Cf + Cg) * dist y z ^ α := by ring
  
  have s3b : ∀ (W : Set E2), IsOpen W → ∀ {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
      (m : ℕ) (f g : E2 → G),
      (∀ x ∈ W, f x = g x) → pcrHolV α m f W → pcrHolV α m g W := by
    intro W hW G _ _ m f g hfg hf
    have heq : ∀ y ∈ W, iteratedFDeriv ℝ m g y = iteratedFDeriv ℝ m f y := by
      intro y hy
      have hev : g =ᶠ[𝓝 y] f :=
        Filter.eventually_of_mem (hW.mem_nhds hy) (fun v hv => (hfg v hv).symm)
      exact (hev.iteratedFDeriv ℝ m).eq_of_nhds
    refine ⟨hf.1.congr (fun y hy => (hfg y hy).symm), fun x hx => ?_⟩
    obtain ⟨ρ, hρ, hb, C, hC⟩ := hf.2 x hx
    refine ⟨ρ, hρ, hb, C, fun y hy z hz => ?_⟩
    rw [heq y (hb hy), heq z (hb hz)]
    exact hC y hy z hz
  
  have s4 : ∀ (W : Set E2), IsOpen W → ∀ (m : ℕ) {G₁ G₂ G₃ : Type}
      [NormedAddCommGroup G₁] [NormedSpace ℝ G₁]
      [NormedAddCommGroup G₂] [NormedSpace ℝ G₂] [NormedAddCommGroup G₃] [NormedSpace ℝ G₃]
      (β : G₁ →L[ℝ] G₂ →L[ℝ] G₃) (a : E2 → G₁) (b : E2 → G₂),
      pcrHolV α m a W → pcrHolV α m b W → pcrHolV α m (fun x => β (a x) (b x)) W := by
    intro W hW m
    induction m with
    | zero =>
      intro G₁ G₂ G₃ _ _ _ _ _ _ β a b ha hb
      refine ⟨(β.contDiff.comp_contDiffOn ha.1).clm_apply hb.1, fun x hx => ?_⟩
      obtain ⟨ρa, hρa, hba, Ca, hCa⟩ := ha.2 x hx
      obtain ⟨ρb, hρb, hbb, Cb, hCb⟩ := hb.2 x hx
      have hρ0 : 0 < min ρa ρb := lt_min hρa hρb
      have hb0 : Metric.ball x (min ρa ρb) ⊆ W :=
        (Metric.ball_subset_ball (min_le_left _ _)).trans hba
      have hcb : Metric.closedBall x (min ρa ρb / 2) ⊆ Metric.ball x (min ρa ρb) :=
        Metric.closedBall_subset_ball (by linarith)
      obtain ⟨Ma, hMa⟩ := (isCompact_closedBall x (min ρa ρb / 2)).exists_bound_of_continuousOn
        (ha.1.continuousOn.mono (hcb.trans hb0))
      obtain ⟨Mb, hMb⟩ := (isCompact_closedBall x (min ρa ρb / 2)).exists_bound_of_continuousOn
        (hb.1.continuousOn.mono (hcb.trans hb0))
      refine ⟨min ρa ρb / 2, by linarith, (Metric.ball_subset_closedBall.trans hcb).trans hb0,
        ‖β‖ * (Ca * max Mb 0 + max Ma 0 * Cb), ?_⟩
      intro y hy z hz
      rw [F0]
      have hyc : y ∈ Metric.closedBall x (min ρa ρb / 2) := Metric.ball_subset_closedBall hy
      have hzc : z ∈ Metric.closedBall x (min ρa ρb / 2) := Metric.ball_subset_closedBall hz
      have hya : y ∈ Metric.ball x ρa := Metric.ball_subset_ball (min_le_left _ _) (hcb hyc)
      have hza : z ∈ Metric.ball x ρa := Metric.ball_subset_ball (min_le_left _ _) (hcb hzc)
      have hyb : y ∈ Metric.ball x ρb := Metric.ball_subset_ball (min_le_right _ _) (hcb hyc)
      have hzb : z ∈ Metric.ball x ρb := Metric.ball_subset_ball (min_le_right _ _) (hcb hzc)
      have h1 : ‖a y - a z‖ ≤ Ca * dist y z ^ α := by rw [← F0]; exact hCa y hya z hza
      have h2 : ‖b y - b z‖ ≤ Cb * dist y z ^ α := by rw [← F0]; exact hCb y hyb z hzb
      have hMa' : ‖a z‖ ≤ max Ma 0 := (hMa z hzc).trans (le_max_left _ _)
      have hMb' : ‖b y‖ ≤ max Mb 0 := (hMb y hyc).trans (le_max_left _ _)
      have hsplit : β (a y) (b y) - β (a z) (b z) =
          β (a y - a z) (b y) + β (a z) (b y - b z) := by
        simp only [map_sub, ContinuousLinearMap.sub_apply]
        abel
      calc ‖β (a y) (b y) - β (a z) (b z)‖
          = ‖β (a y - a z) (b y) + β (a z) (b y - b z)‖ := by rw [hsplit]
        _ ≤ ‖β (a y - a z) (b y)‖ + ‖β (a z) (b y - b z)‖ := norm_add_le _ _
        _ ≤ ‖β‖ * ‖a y - a z‖ * ‖b y‖ + ‖β‖ * ‖a z‖ * ‖b y - b z‖ :=
            add_le_add (β.le_opNorm₂ _ _) (β.le_opNorm₂ _ _)
        _ ≤ ‖β‖ * (Ca * dist y z ^ α) * max Mb 0 + ‖β‖ * max Ma 0 * (Cb * dist y z ^ α) :=
            add_le_add
              (mul_le_mul (mul_le_mul_of_nonneg_left h1 (by positivity)) hMb' (by positivity)
                (mul_nonneg (by positivity) ((norm_nonneg _).trans h1)))
              (mul_le_mul (mul_le_mul_of_nonneg_left hMa' (by positivity)) h2 (by positivity)
                (mul_nonneg (by positivity) (le_max_right _ _)))
        _ = ‖β‖ * (Ca * max Mb 0 + max Ma 0 * Cb) * dist y z ^ α := by ring
    | succ m ih =>
      intro G₁ G₂ G₃ _ _ _ _ _ _ β a b ha hb
      obtain ⟨hda, ha'⟩ := (s1 W hW m a).1 ha
      obtain ⟨hdb, hb'⟩ := (s1 W hW m b).1 hb
      have ha0 : pcrHolV α m a W := s2 W hW m a ha.1
      have hb0 : pcrHolV α m b W := s2 W hW m b hb.1
      have T1 := ih (ContinuousLinearMap.precompR E2 β) a (fderiv ℝ b) ha0 hb'
      have T2 := ih (ContinuousLinearMap.precompL E2 β) (fderiv ℝ a) b ha' hb0
      have T := s3 W hW m _ _ T1 T2
      have hder : ∀ x ∈ W, HasFDerivAt (fun y => β (a y) (b y))
          (ContinuousLinearMap.precompR E2 β (a x) (fderiv ℝ b x) +
            ContinuousLinearMap.precompL E2 β (fderiv ℝ a x) (b x)) x := fun x hx =>
        β.hasFDerivAt_of_bilinear (hda.differentiableAt (hW.mem_nhds hx)).hasFDerivAt
          (hdb.differentiableAt (hW.mem_nhds hx)).hasFDerivAt
      exact (s1 W hW m _).2 ⟨fun x hx => (hder x hx).differentiableAt.differentiableWithinAt,
        s3b W hW m _ _ (fun x hx => (hder x hx).fderiv.symm) T⟩
  
  have s5 : ∀ (m : ℕ) {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] (f : E2 → G),
      pcrHolV α m f V → pcrHolV α m (fun x => f (τ x)) U := by
    intro m
    induction m with
    | zero =>
      intro G _ _ f hf
      refine ⟨hf.1.comp (hτ.of_le (by exact_mod_cast le_top)) hτUV, fun x hx => ?_⟩
      obtain ⟨ρ', hρ', hb', C', hC'⟩ := hf.2 (τ x) (hτUV hx)
      obtain ⟨ε, hε, hballU⟩ := Metric.isOpen_iff.1 hU x hx
      obtain ⟨δ, hδ, hτδ⟩ := Metric.continuousAt_iff.1
        (hτ.continuousOn.continuousAt (hU.mem_nhds hx)) ρ' hρ'
      have hmin : 0 < min δ ε := lt_min hδ hε
      have hrδ : min δ ε / 2 < δ := by have := min_le_left δ ε; linarith
      have hcb : Metric.closedBall x (min δ ε / 2) ⊆ U :=
        (Metric.closedBall_subset_ball (show min δ ε / 2 < min δ ε by linarith)).trans
          ((Metric.ball_subset_ball (min_le_right δ ε)).trans hballU)
      obtain ⟨K, hK⟩ := (hτ.mono hcb).exists_lipschitzOnWith (by simp)
        (convex_closedBall x (min δ ε / 2)) (isCompact_closedBall x (min δ ε / 2))
      refine ⟨min δ ε / 2, by linarith, Metric.ball_subset_closedBall.trans hcb,
        max C' 0 * (K : ℝ) ^ α, ?_⟩
      intro y hy z hz
      rw [F0]
      have hyc : y ∈ Metric.closedBall x (min δ ε / 2) := Metric.ball_subset_closedBall hy
      have hzc : z ∈ Metric.closedBall x (min δ ε / 2) := Metric.ball_subset_closedBall hz
      have hyδ : dist y x < δ := by
        have : dist y x < min δ ε / 2 := hy
        linarith
      have hzδ : dist z x < δ := by
        have : dist z x < min δ ε / 2 := hz
        linarith
      have hτy : τ y ∈ Metric.ball (τ x) ρ' := hτδ hyδ
      have hτz : τ z ∈ Metric.ball (τ x) ρ' := hτδ hzδ
      have h1 : ‖f (τ y) - f (τ z)‖ ≤ C' * dist (τ y) (τ z) ^ α := by
        rw [← F0]; exact hC' _ hτy _ hτz
      have hL : dist (τ y) (τ z) ≤ (K : ℝ) * dist y z := hK.dist_le_mul y hyc z hzc
      have h2 : dist (τ y) (τ z) ^ α ≤ ((K : ℝ) * dist y z) ^ α :=
        Real.rpow_le_rpow dist_nonneg hL hα0.le
      have h3 : ((K : ℝ) * dist y z) ^ α = (K : ℝ) ^ α * dist y z ^ α :=
        Real.mul_rpow K.coe_nonneg dist_nonneg
      calc ‖f (τ y) - f (τ z)‖ ≤ C' * dist (τ y) (τ z) ^ α := h1
        _ ≤ max C' 0 * dist (τ y) (τ z) ^ α :=
            mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg dist_nonneg _)
        _ ≤ max C' 0 * ((K : ℝ) * dist y z) ^ α :=
            mul_le_mul_of_nonneg_left h2 (le_max_right _ _)
        _ = max C' 0 * (K : ℝ) ^ α * dist y z ^ α := by rw [h3]; ring
    | succ m ih =>
      intro G _ _ f hf
      obtain ⟨hdf, hf'⟩ := (s1 V hV m f).1 hf
      have hA := ih (fderiv ℝ f) hf'
      obtain ⟨hdτ, hτ'⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hτ
      have hB : pcrHolV α m (fderiv ℝ τ) U :=
        s2 U hU m (fderiv ℝ τ) (hτ'.of_le (by exact_mod_cast le_top))
      have hC := s4 U hU m (ContinuousLinearMap.compL ℝ E2 E2 G) (fun x => fderiv ℝ f (τ x))
        (fderiv ℝ τ) hA hB
      have hder : ∀ x ∈ U, HasFDerivAt (fun y => f (τ y))
          (ContinuousLinearMap.compL ℝ E2 E2 G (fderiv ℝ f (τ x)) (fderiv ℝ τ x)) x := by
        intro x hx
        have h1 := (hdf.differentiableAt (hV.mem_nhds (hτUV hx))).hasFDerivAt
        have h2 := (hdτ.differentiableAt (hU.mem_nhds hx)).hasFDerivAt
        rw [ContinuousLinearMap.compL_apply]
        exact h1.comp x h2
      exact (s1 U hU m _).2 ⟨fun x hx => (hder x hx).differentiableAt.differentiableWithinAt,
        s3b U hU m _ _ (fun x hx => (hder x hx).fderiv.symm) hC⟩
  have hf' : pcrHolV α m f V := hf
  exact s5 m f hf'

theorem pcr_unif_limit_iteratedFDeriv (U : Set E2) (hU : IsOpen U) (m : ℕ)
    (w : ℕ → E2 → ℝ) (hw : ∀ n, ContDiffOn ℝ m (w n) U) (f : E2 → ℝ)
    (G : ∀ l : Fin (m + 1), E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ)
    (hG : ∀ l : Fin (m + 1),
      TendstoUniformlyOn (fun n x => iteratedFDeriv ℝ l (w n) x) (G l) atTop U)
    (hf : ∀ x ∈ U, Tendsto (fun n => w n x) atTop (𝓝 (f x))) :
    ContDiffOn ℝ m f U ∧ ∀ l : Fin (m + 1), ∀ x ∈ U, iteratedFDeriv ℝ l f x = G l x :=
by
  have hcda : ∀ n, ∀ x ∈ U, ContDiffAt ℝ m (w n) x :=
    fun n x hx => (hw n).contDiffAt (hU.mem_nhds hx)
  
  have hstep : ∀ (k : ℕ) (hk : k + 1 < m + 1), ∀ x ∈ U,
      HasFDerivAt (G ⟨k, by omega⟩)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => E2) ℝ
          (G ⟨k + 1, hk⟩ x)) x := by
    intro k hk x hx
    have hfd : ∀ n y, fderiv ℝ (iteratedFDeriv ℝ k (w n)) y =
        continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => E2) ℝ
          (iteratedFDeriv ℝ (k + 1) (w n) y) := by
      intro n y
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply,
        LinearIsometryEquiv.apply_symm_apply]
    have hunif : TendstoUniformlyOn (fun n y => fderiv ℝ (iteratedFDeriv ℝ k (w n)) y)
        (fun y => continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => E2) ℝ
          (G ⟨k + 1, hk⟩ y)) atTop U := by
      have h := UniformContinuous.comp_tendstoUniformlyOn
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => E2) ℝ).isometry.uniformContinuous
        (hG ⟨k + 1, hk⟩)
      have e1 : (fun n y => fderiv ℝ (iteratedFDeriv ℝ k (w n)) y) = fun n =>
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => E2) ℝ) ∘
            (fun y => iteratedFDeriv ℝ (k + 1) (w n) y) := by
        funext n y
        exact hfd n y
      rw [e1]
      exact h
    refine hasFDerivAt_of_tendstoUniformlyOn hU hunif (fun n y hy => ?_)
      (fun y hy => (hG ⟨k, by omega⟩).tendsto_at hy) hx
    have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ k (w n)) y :=
      (hcda n y hy).differentiableAt_iteratedFDeriv (by exact_mod_cast (show k < m by omega))
    exact hd.hasFDerivAt
  
  have hid : ∀ k (hk : k < m + 1), ∀ x ∈ U, iteratedFDeriv ℝ k f x = G ⟨k, hk⟩ x := by
    intro k
    induction k with
    | zero =>
      intro hk x hx
      have h1 : Tendsto (fun n => iteratedFDeriv ℝ 0 (w n) x) atTop (𝓝 (G ⟨0, hk⟩ x)) :=
        (hG ⟨0, hk⟩).tendsto_at hx
      have h2 : Tendsto (fun n => iteratedFDeriv ℝ 0 (w n) x (fun _ => 0)) atTop
          (𝓝 (G ⟨0, hk⟩ x (fun _ => 0))) :=
        ((continuous_eval_const (fun _ : Fin 0 => (0 : E2))).tendsto _).comp h1
      simp only [iteratedFDeriv_zero_apply] at h2
      have h3 := tendsto_nhds_unique (hf x hx) h2
      ext v
      rw [iteratedFDeriv_zero_apply, Subsingleton.elim v (fun _ => 0)]
      exact h3
    | succ k ih =>
      intro hk x hx
      have hev : iteratedFDeriv ℝ k f =ᶠ[𝓝 x] G ⟨k, by omega⟩ :=
        Filter.eventually_of_mem (hU.mem_nhds hx) (fun y hy => ih (by omega) y hy)
      have hd := (hstep k hk x hx).congr_of_eventuallyEq hev
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply, hd.fderiv,
        LinearIsometryEquiv.symm_apply_apply]
  have hcont : ∀ k (hk : k < m + 1), ContinuousOn (G ⟨k, hk⟩) U := by
    intro k hk
    refine (hG ⟨k, hk⟩).continuousOn (Filter.Frequently.of_forall fun n => ?_)
    intro y hy
    exact ((hcda n y hy).continuousAt_iteratedFDeriv
      (by exact_mod_cast (show k ≤ m by omega))).continuousWithinAt
  refine ⟨?_, fun l x hx => hid l.val l.isLt x hx⟩
  apply contDiffOn_of_continuousOn_differentiableOn
  · intro j hj
    have hj' : j ≤ m := by exact_mod_cast hj
    exact (hcont j (by omega)).congr (fun y hy =>
      (iteratedFDerivWithin_of_isOpen j hU hy).trans (hid j (by omega) y hy))
  · intro j hj y hy
    have hj' : j < m := by exact_mod_cast hj
    have hev : iteratedFDeriv ℝ j f =ᶠ[𝓝 y] G ⟨j, by omega⟩ :=
      Filter.eventually_of_mem (hU.mem_nhds hy) (fun z hz => hid j (by omega) z hz)
    have hd := (hstep j (by omega) y hy).congr_of_eventuallyEq hev
    exact hd.differentiableAt.differentiableWithinAt.congr
      (fun z hz => iteratedFDerivWithin_of_isOpen j hU hz)
      (iteratedFDerivWithin_of_isOpen j hU hy)

theorem pcr_sp_closed {X : Type*} [TopologicalSpace X] {S : Set X} (P : EigPatchedSurface X S)
    (B : PcrBalls P) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (m : ℕ) :
    IsClosed ((pcrSp B α m : Submodule ℝ (pcrAmb B m)) : Set (pcrAmb B m)) :=
by
  classical
  
  have Pa : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S ∧ P.param j x ∈ P.O j := by
    intro j x hx
    have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq] at h
    exact ⟨h.2, h.1⟩
  have hval0 : ∀ (c : E2) (ρ : ℝ) (w : E2 → ℝ) (h : pcrLocAmb c ρ m),
      pcrLocRel c ρ α m w h → ∀ x : Metric.closedBall c ρ,
        (h ⟨0, Nat.succ_pos m⟩).1 x (fun _ => 0) = w x := by
    intro c ρ w h hr x
    have h1 := congrArg (fun T => T (fun _ => (0 : E2))) ((hr ⟨0, Nat.succ_pos m⟩).1 x)
    exact h1.trans (iteratedFDeriv_zero_apply _)
  have G1 : ∀ (h : pcrAmb B m) (v : X → ℝ), pcrClass P α m v →
      (∀ i, pcrLocRel (B.c i) (B.ρ i) α m (fun x => v (P.param (B.j i) x)) (h i)) →
      pcrEval B m h = v := by
    intro h v hv hrel
    funext q
    simp only [pcrEval, LinearMap.coe_mk, AddHom.coe_mk]
    split_ifs with hh
    · exact (hval0 _ _ _ _ (hrel hh.choose) _).trans
        (congrArg v hh.choose_spec.choose_spec.2)
    · have hq : q ∉ S := fun hq => hh (B.cover q hq)
      exact (hv.1 q hq).symm
  have hT0 : ∀ T : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => E2) ℝ,
      ‖T (fun _ => 0)‖ ≤ ‖T‖ := fun T => by simpa using T.le_opNorm (fun _ => 0)
  have hnormB : ∀ (h : pcrAmb B m) (i : Fin B.N), ‖(h i ⟨0, Nat.succ_pos m⟩).1‖ ≤ ‖h‖ := by
    intro h i
    calc ‖(h i ⟨0, Nat.succ_pos m⟩).1‖ ≤ ‖h i ⟨0, Nat.succ_pos m⟩‖ := norm_fst_le _
      _ ≤ ‖h i‖ := norm_le_pi_norm (h i) _
      _ ≤ ‖h‖ := norm_le_pi_norm h i
  have G4 : ∀ (h : pcrAmb B m) (q : X), |pcrEval B m h q| ≤ ‖h‖ := by
    intro h q
    simp only [pcrEval, LinearMap.coe_mk, AddHom.coe_mk]
    split_ifs with hh
    · rw [← Real.norm_eq_abs]
      exact (hT0 _).trans ((BoundedContinuousFunction.norm_coe_le_norm _ _).trans
        (hnormB h hh.choose))
    · simp
  
  refine isClosed_of_closure_subset fun g hg => ?_
  obtain ⟨gs, hgsmem, hgs⟩ := mem_closure_iff_seq_limit.1 hg
  have hex : ∀ n, ∃ v : X → ℝ, pcrClass P α m v ∧
      ∀ i, pcrLocRel (B.c i) (B.ρ i) α m (fun x => v (P.param (B.j i) x)) (gs n i) :=
    fun n => (pcr_sp_mem_iff P B α m (gs n)).1 (hgsmem n)
  choose us hus hrel using hex
  
  obtain ⟨u, hconv⟩ : ∃ u : X → ℝ, ∀ q, Tendsto (fun n => us n q) atTop (𝓝 (u q)) := by
    refine ⟨pcrEval B m g, fun q => ?_⟩
    let lam : pcrAmb B m →L[ℝ] ℝ := LinearMap.mkContinuous
      ((LinearMap.proj (R := ℝ) (φ := fun _ : X => ℝ) q).comp (pcrEval B m)) 1
      (fun f => by
        rw [one_mul, Real.norm_eq_abs]
        exact G4 f q)
    have h1 : Tendsto (fun n => lam (gs n)) atTop (𝓝 (lam g)) :=
      (lam.continuous.tendsto g).comp hgs
    have h2 : (fun n => lam (gs n)) = fun n => us n q := funext fun n => by
      show pcrEval B m (gs n) q = us n q
      rw [G1 (gs n) (us n) (hus n) (hrel n)]
    rw [h2] at h1
    exact h1
  have hU0 : ∀ q, q ∉ S → u q = 0 := by
    intro q hq
    have h1 := hconv q
    have h2 : (fun n => us n q) = fun _ => (0 : ℝ) := funext fun n => (hus n).1 q hq
    rw [h2] at h1
    exact tendsto_nhds_unique h1 tendsto_const_nhds
  
  obtain ⟨Gi, hGi⟩ : ∃ Gi : ∀ (i : Fin B.N) (l : Fin (m + 1)),
      E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ, ∀ i l x,
      Gi i l x = if hx : x ∈ Metric.closedBall (B.c i) (B.ρ i) then (g i l).1 ⟨x, hx⟩ else 0 :=
    ⟨_, fun _ _ _ => rfl⟩
  have hunif : ∀ i (l : Fin (m + 1)), TendstoUniformlyOn
      (fun n x => iteratedFDeriv ℝ l (fun x' => us n (P.param (B.j i) x')) x) (Gi i l) atTop
      (Metric.ball (B.c i) (B.ρ i)) := by
    intro i l
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 hgs ε hε
    refine Filter.eventually_atTop.2 ⟨N, fun n hn x hx => ?_⟩
    have hxK : x ∈ Metric.closedBall (B.c i) (B.ρ i) := Metric.ball_subset_closedBall hx
    have e1 : Gi i l x = (g i l).1 ⟨x, hxK⟩ := by rw [hGi, dif_pos hxK]
    have e2 : iteratedFDeriv ℝ l (fun x' => us n (P.param (B.j i) x')) x =
        (gs n i l).1 ⟨x, hxK⟩ := ((hrel n i l).1 ⟨x, hxK⟩).symm
    rw [e1, e2]
    calc dist ((g i l).1 ⟨x, hxK⟩) ((gs n i l).1 ⟨x, hxK⟩) ≤ dist (g i l).1 (gs n i l).1 :=
          BoundedContinuousFunction.dist_coe_le_dist _
      _ ≤ dist (g i l) (gs n i l) := le_trans (le_max_left _ _) Prod.dist_eq.ge
      _ ≤ dist (g i) (gs n i) := dist_le_pi_dist _ _ l
      _ ≤ dist g (gs n) := dist_le_pi_dist _ _ i
      _ = dist (gs n) g := dist_comm _ _
      _ < ε := hN n hn
  have hball : ∀ i, ContDiffOn ℝ m (fun x => u (P.param (B.j i) x))
      (Metric.ball (B.c i) (B.ρ i)) ∧
      ∀ l : Fin (m + 1), ∀ x ∈ Metric.ball (B.c i) (B.ρ i),
        iteratedFDeriv ℝ l (fun x => u (P.param (B.j i) x)) x = Gi i l x := fun i =>
    pcr_unif_limit_iteratedFDeriv _ Metric.isOpen_ball m (fun n x => us n (P.param (B.j i) x))
      (fun n => ((hus n).2 (B.j i)).1.mono (Metric.ball_subset_closedBall.trans (B.sub i)))
      (fun x => u (P.param (B.j i) x)) (Gi i) (hunif i) (fun x _ => hconv _)
  
  have hq : ∀ i (l : Fin (m + 1))
      (p : {p : Metric.closedBall (B.c i) (B.ρ i) × Metric.closedBall (B.c i) (B.ρ i) //
        p.1 ≠ p.2}),
      (g i l).2 p = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
        ((g i l).1 p.1.1 - (g i l).1 p.1.2) := by
    intro i l p
    have hc1 : Continuous fun k : pcrAmb B m => k i l :=
      (continuous_apply l).comp (continuous_apply i)
    have hcont : Continuous fun k : pcrAmb B m =>
        (k i l).2 p - (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
          ((k i l).1 p.1.1 - (k i l).1 p.1.2) := by
      have a := (BoundedContinuousFunction.continuous_eval_const p).comp (continuous_snd.comp hc1)
      have b := (BoundedContinuousFunction.continuous_eval_const p.1.1).comp
        (continuous_fst.comp hc1)
      have c := (BoundedContinuousFunction.continuous_eval_const p.1.2).comp
        (continuous_fst.comp hc1)
      exact a.sub ((b.sub c).const_smul _)
    have h1 : Tendsto (fun n => (gs n i l).2 p - (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
        ((gs n i l).1 p.1.1 - (gs n i l).1 p.1.2)) atTop
        (𝓝 ((g i l).2 p - (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
          ((g i l).1 p.1.1 - (g i l).1 p.1.2))) := (hcont.tendsto g).comp hgs
    have h2 : (fun n => (gs n i l).2 p - (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
        ((gs n i l).1 p.1.1 - (gs n i l).1 p.1.2)) = fun _ => 0 := by
      funext n
      rw [(hrel n i l).2 p, (hrel n i l).1 p.1.1, (hrel n i l).1 p.1.2, sub_self]
    rw [h2] at h1
    exact sub_eq_zero.1 (tendsto_nhds_unique h1 tendsto_const_nhds)
  
  have hhol : ∀ i (x y : Metric.closedBall (B.c i) (B.ρ i)),
      ‖(g i (Fin.last m)).1 x - (g i (Fin.last m)).1 y‖ ≤ ‖g‖ * dist (x : E2) (y : E2) ^ α := by
    intro i x y
    by_cases hxy : x = y
    · rw [hxy, sub_self, norm_zero]
      exact mul_nonneg (norm_nonneg _) (Real.rpow_nonneg dist_nonneg _)
    · have hd : 0 < dist (x : E2) (y : E2) := dist_pos.2 (fun h => hxy (Subtype.ext h))
      have hdα : 0 < dist (x : E2) (y : E2) ^ α := Real.rpow_pos_of_pos hd α
      have e : (g i (Fin.last m)).2 ⟨(x, y), hxy⟩ = (dist (x : E2) (y : E2) ^ α)⁻¹ •
          ((g i (Fin.last m)).1 x - (g i (Fin.last m)).1 y) := hq i _ _
      have e' : (g i (Fin.last m)).1 x - (g i (Fin.last m)).1 y =
          dist (x : E2) (y : E2) ^ α • (g i (Fin.last m)).2 ⟨(x, y), hxy⟩ := by
        rw [e, smul_inv_smul₀ hdα.ne']
      rw [e', norm_smul, Real.norm_of_nonneg hdα.le, mul_comm]
      refine mul_le_mul_of_nonneg_right ?_ hdα.le
      calc ‖(g i (Fin.last m)).2 ⟨(x, y), hxy⟩‖ ≤ ‖(g i (Fin.last m)).2‖ :=
            BoundedContinuousFunction.norm_coe_le_norm _ _
        _ ≤ ‖g i (Fin.last m)‖ := norm_snd_le _
        _ ≤ ‖g i‖ := norm_le_pi_norm (g i) _
        _ ≤ ‖g‖ := norm_le_pi_norm g i
  
  have hvhol : ∀ i, pcrHolLoc α m (fun x => u (P.param (B.j i) x))
      (Metric.ball (B.c i) (B.ρ i)) := by
    intro i
    refine ⟨(hball i).1, fun x hx => ?_⟩
    have hx' : dist x (B.c i) < B.ρ i := hx
    refine ⟨B.ρ i - dist x (B.c i), by linarith, Metric.ball_subset_ball' (by linarith), ‖g‖,
      fun y hy z hz => ?_⟩
    have hyB : y ∈ Metric.ball (B.c i) (B.ρ i) := Metric.ball_subset_ball' (by linarith) hy
    have hzB : z ∈ Metric.ball (B.c i) (B.ρ i) := Metric.ball_subset_ball' (by linarith) hz
    have ey := (hball i).2 (Fin.last m) y hyB
    have ez := (hball i).2 (Fin.last m) z hzB
    rw [hGi, dif_pos (Metric.ball_subset_closedBall hyB)] at ey
    rw [hGi, dif_pos (Metric.ball_subset_closedBall hzB)] at ez
    simp only [Fin.val_last] at ey ez
    rw [ey, ez]
    exact hhol i _ _
  
  have hloc : ∀ j, ∀ x₀ ∈ P.W j, ∃ V : Set E2, IsOpen V ∧ x₀ ∈ V ∧ V ⊆ P.W j ∧
      pcrHolLoc α m (fun x => u (P.param j x)) V := by
    intro j x₀ hx₀
    obtain ⟨i, y₀, hy₀, hpy₀⟩ := B.cover _ (Pa j x₀ hx₀).1
    have hy₀W : y₀ ∈ P.W (B.j i) := B.sub i (Metric.ball_subset_closedBall hy₀)
    have hqO : P.param j x₀ ∈ P.O (B.j i) := by
      rw [← hpy₀]
      exact (Pa _ y₀ hy₀W).2
    have hΩ : IsOpen (P.W j ∩ P.param j ⁻¹' P.O (B.j i)) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open _)
    have hτ := P.trans_smooth j (B.j i)
    have hΩ' : IsOpen ((P.W j ∩ P.param j ⁻¹' P.O (B.j i)) ∩
        (fun x => P.proj (B.j i) (P.param j x)) ⁻¹' Metric.ball (B.c i) (B.ρ i)) :=
      hτ.continuousOn.isOpen_inter_preimage hΩ Metric.isOpen_ball
    refine ⟨_, hΩ', ⟨⟨hx₀, hqO⟩, ?_⟩, fun x hx => hx.1.1, ?_⟩
    · show P.proj (B.j i) (P.param j x₀) ∈ Metric.ball (B.c i) (B.ρ i)
      rw [← hpy₀, P.proj_param _ y₀ hy₀W]
      exact hy₀
    · have hcomp := pcr_holLoc_comp_smooth _ _ hΩ' Metric.isOpen_ball α hα0 hα1 m _ (hvhol i)
        (fun x => P.proj (B.j i) (P.param j x)) (hτ.mono Set.inter_subset_left)
        (fun x hx => hx.2)
      have hff' : ∀ x ∈ (P.W j ∩ P.param j ⁻¹' P.O (B.j i)) ∩
          (fun x => P.proj (B.j i) (P.param j x)) ⁻¹' Metric.ball (B.c i) (B.ρ i),
          u (P.param (B.j i) (P.proj (B.j i) (P.param j x))) = u (P.param j x) := by
        intro x hx
        have hS : P.param j x ∈ P.O (B.j i) ∩ S := ⟨hx.1.2, (Pa j x hx.1.1).1⟩
        rw [← P.image_eq] at hS
        obtain ⟨z, hz, hzx⟩ := hS
        rw [← hzx, P.proj_param _ z hz]
      have key : ∀ y ∈ (P.W j ∩ P.param j ⁻¹' P.O (B.j i)) ∩
          (fun x => P.proj (B.j i) (P.param j x)) ⁻¹' Metric.ball (B.c i) (B.ρ i),
          iteratedFDeriv ℝ m (fun x => u (P.param j x)) y =
            iteratedFDeriv ℝ m (fun x => u (P.param (B.j i) (P.proj (B.j i) (P.param j x)))) y :=
        fun y hy => (Filter.EventuallyEq.iteratedFDeriv ℝ (Filter.eventually_of_mem
          (hΩ'.mem_nhds hy) (fun z hz => (hff' z hz).symm)) m).eq_of_nhds
      refine ⟨hcomp.1.congr (fun x hx => (hff' x hx).symm), fun x hx => ?_⟩
      obtain ⟨ρ, hρ, hb, C, hC⟩ := hcomp.2 x hx
      refine ⟨ρ, hρ, hb, C, fun y hy z hz => ?_⟩
      rw [key y (hb hy), key z (hb hz)]
      exact hC y hy z hz
  have hpatch : ∀ j, pcrHolLoc α m (fun x => u (P.param j x)) (P.W j) := by
    intro j
    refine ⟨contDiffOn_of_locally_contDiffOn fun x hx => ?_, fun x hx => ?_⟩
    · obtain ⟨V, hV, hxV, -, hh⟩ := hloc j x hx
      exact ⟨V, hV, hxV, hh.1.mono Set.inter_subset_right⟩
    · obtain ⟨V, hV, hxV, hVW, hh⟩ := hloc j x hx
      obtain ⟨ρ, hρ, hb, C, hC⟩ := hh.2 x hxV
      exact ⟨ρ, hρ, hb.trans hVW, C, hC⟩
  
  have hrelg : ∀ i, pcrLocRel (B.c i) (B.ρ i) α m (fun x => u (P.param (B.j i) x)) (g i) := by
    intro i
    have hfirst : ∀ (l : Fin (m + 1)) (x : Metric.closedBall (B.c i) (B.ρ i)),
        (g i l).1 x = iteratedFDeriv ℝ l (fun x => u (P.param (B.j i) x)) x := by
      intro l
      have hA : ContinuousOn (Gi i l) (Metric.closedBall (B.c i) (B.ρ i)) := by
        rw [continuousOn_iff_continuous_restrict]
        have : (Metric.closedBall (B.c i) (B.ρ i)).restrict (Gi i l) = (g i l).1 := by
          funext x
          rw [Set.restrict_apply, hGi, dif_pos x.2]
        rw [this]
        exact (g i l).1.continuous
      have hD : ContinuousOn (iteratedFDeriv ℝ l (fun x => u (P.param (B.j i) x)))
          (Metric.closedBall (B.c i) (B.ρ i)) := by
        have h1 := ((hpatch (B.j i)).1).continuousOn_iteratedFDerivWithin (m := l)
          (by exact_mod_cast l.is_le) (P.W_open _).uniqueDiffOn
        exact (h1.congr (fun y hy =>
          (iteratedFDerivWithin_of_isOpen _ (P.W_open _) hy).symm)).mono (B.sub i)
      have hEq := Set.EqOn.of_subset_closure (fun x hx => ((hball i).2 l x hx).symm) hA hD
        Metric.ball_subset_closedBall (closure_ball _ (B.ρ_pos i).ne').symm.subset
      intro x
      have := hEq x.2
      rw [hGi, dif_pos x.2] at this
      exact this
    intro l
    refine ⟨hfirst l, fun p => ?_⟩
    rw [hq i l p, hfirst l p.1.1, hfirst l p.1.2]
  exact (pcr_sp_mem_iff P B α m g).2 ⟨u, ⟨hU0, hpatch⟩, hrelg⟩

theorem pcr_contDiffOn_of_isometry_comp {E F A : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    [NormedAddCommGroup A] [NormedSpace ℝ A] (ι : F →ₗᵢ[ℝ] A) (f : E → F) (s : Set E)
    (hs : IsOpen s) (h : ContDiffOn ℝ ∞ (fun x => ι (f x)) s) : ContDiffOn ℝ ∞ f s :=
by
  have key : ∀ (F' A' : Type) [NormedAddCommGroup F'] [NormedSpace ℝ F'] [CompleteSpace F']
      [NormedAddCommGroup A'] [NormedSpace ℝ A'] (ι' : F' →ₗᵢ[ℝ] A') (f' : E → F') (x : E),
      DifferentiableAt ℝ (fun y => ι' (f' y)) x →
      DifferentiableAt ℝ f' x ∧
        fderiv ℝ (fun y => ι' (f' y)) x = ι'.toContinuousLinearMap.comp (fderiv ℝ f' x) := by
    intro F' A' _ _ _ _ _ ι' f' x hd
    set L := fderiv ℝ (fun y => ι' (f' y)) x with hLdef
    have hL : HasFDerivAt (fun y => ι' (f' y)) L x := hd.hasFDerivAt
    have hK : IsClosed (Set.range ι') :=
      (ι'.isometry.isUniformInducing.isComplete_range).isClosed
    have hmem : ∀ v, L v ∈ Set.range ι' := by
      intro v
      have ht := hL.lim v (c := fun n : ℕ => (n : ℝ)) (l := Filter.atTop) (by
        simpa [Real.norm_natCast] using tendsto_natCast_atTop_atTop)
      refine hK.mem_of_tendsto ht (Filter.Eventually.of_forall fun n => ?_)
      exact ⟨(n : ℝ) • (f' (x + (n : ℝ)⁻¹ • v) - f' x), by simp [map_sub, map_smul]⟩
    choose M₀ hM₀ using hmem
    have hadd : ∀ v w, M₀ (v + w) = M₀ v + M₀ w := fun v w =>
      ι'.injective (by simp [hM₀, map_add])
    have hsmul : ∀ (c : ℝ) v, M₀ (c • v) = c • M₀ v := fun c v =>
      ι'.injective (by simp [hM₀, map_smul])
    let M : E →L[ℝ] F' := LinearMap.mkContinuous
      { toFun := M₀, map_add' := hadd, map_smul' := hsmul } ‖L‖ (fun v => by
        show ‖M₀ v‖ ≤ ‖L‖ * ‖v‖
        rw [← ι'.norm_map, hM₀]
        exact L.le_opNorm v)
    have hMv : ∀ v, M v = M₀ v := fun v => rfl
    have hfd : HasFDerivAt f' M x := by
      rw [hasFDerivAt_iff_isLittleO_nhds_zero] at hL ⊢
      have h1 := Asymptotics.isLittleO_norm_left.mpr hL
      refine Asymptotics.isLittleO_norm_left.mp (h1.congr_left fun k => ?_)
      rw [show ι' (f' (x + k)) - ι' (f' x) - L k = ι' (f' (x + k) - f' x - M₀ k) by
        rw [map_sub, map_sub, hM₀], LinearIsometry.norm_map, hMv]
    refine ⟨hfd.differentiableAt, ?_⟩
    rw [hfd.fderiv]
    ext v
    show L v = ι' (M v)
    rw [hMv, hM₀]
  have P : ∀ n : ℕ, ∀ (F' A' : Type) [NormedAddCommGroup F'] [NormedSpace ℝ F'] [CompleteSpace F']
      [NormedAddCommGroup A'] [NormedSpace ℝ A'] (ι' : F' →ₗᵢ[ℝ] A') (f' : E → F'),
      ContDiffOn ℝ n (fun x => ι' (f' x)) s → ContDiffOn ℝ n f' s := by
    intro n
    induction n with
    | zero =>
      intro F' A' _ _ _ _ _ ι' f' hc
      rw [Nat.cast_zero, contDiffOn_zero] at hc ⊢
      exact (ι'.isometry.comp_continuousOn_iff).mp hc
    | succ n ih =>
      intro F' A' _ _ _ _ _ ι' f' hc
      have hn : ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 := by push_cast; rfl
      rw [hn, contDiffOn_succ_iff_fderiv_of_isOpen hs] at hc ⊢
      obtain ⟨hd, -, hc'⟩ := hc
      let Φ : (E →L[ℝ] F') →ₗᵢ[ℝ] (E →L[ℝ] A') :=
        { toLinearMap := (ContinuousLinearMap.compL ℝ E F' A' ι'.toContinuousLinearMap).toLinearMap
          norm_map' := fun L => by
            show ‖ι'.toContinuousLinearMap.comp L‖ = ‖L‖
            exact ι'.norm_toContinuousLinearMap_comp }
      have hpt : ∀ x ∈ s, DifferentiableAt ℝ f' x ∧
          fderiv ℝ (fun y => ι' (f' y)) x = Φ (fderiv ℝ f' x) := fun x hx =>
        key F' A' ι' f' x (hd.differentiableAt (hs.mem_nhds hx))
      refine ⟨fun x hx => (hpt x hx).1.differentiableWithinAt, ?_, ?_⟩
      · intro hω
        exact absurd hω (by simp)
      refine ih (E →L[ℝ] F') (E →L[ℝ] A') Φ (fderiv ℝ f') ?_
      exact hc'.congr fun x hx => ((hpt x hx).2).symm
  exact contDiffOn_infty.mpr fun n => P n F A ι f (contDiffOn_infty.mp h n)

theorem pcr_nem_jet_formula (W : Set E2) (hW : IsOpen W) (s : ℝ)
    (Ψ : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ)
    (hΨ : ContDiffOn ℝ ∞ Ψ {z | z.1 ∈ W ∧ |z.2.1| < s}) (l : ℕ) :
    ∃ Φ : E2 × (∀ r : Fin (l + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
        ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ,
      ContDiffOn ℝ ∞ Φ {z | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s} ∧
      ∀ (w : E2 → ℝ) (U : Set E2), IsOpen U → U ⊆ W →
        ContDiffOn ℝ (l + 2 : ℕ) w U → (∀ x ∈ U, |w x| < s) →
        ∀ x ∈ U, iteratedFDeriv ℝ l (fun y => Ψ (y, w y, fderiv ℝ w y, fderiv ℝ (fderiv ℝ w) y)) x =
          Φ (x, fun r => iteratedFDeriv ℝ r w x) :=
by
  have hDomOpen : ∀ n : ℕ, IsOpen {z : E2 × (∀ r : Fin (n + 1),
      ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s} :=
    fun n => (hW.preimage continuous_fst).inter
      (isOpen_lt ((continuous_apply _).comp continuous_snd).norm continuous_const)
  have hjet : ∀ (n : ℕ) (w : E2 → ℝ) (x : E2), ContDiffAt ℝ ((n + 1 : ℕ) : WithTop ℕ∞) w x →
      HasFDerivAt (fun y => (fun r : Fin (n + 1) => iteratedFDeriv ℝ r w y :
        ∀ r : Fin (n + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ))
      (ContinuousLinearMap.pi fun r : Fin (n + 1) =>
        continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin ((r : ℕ) + 1) => E2) ℝ
          (iteratedFDeriv ℝ ((r : ℕ) + 1) w x)) x := by
    intro n w x hw
    refine (hasFDerivAt_pi (φ := fun r : Fin (n + 1) => iteratedFDeriv ℝ (r : ℕ) w)).2 fun r => ?_
    have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ r w) x :=
      hw.differentiableAt_iteratedFDeriv (by exact_mod_cast r.isLt)
    have h := hd.hasFDerivAt
    rw [fderiv_iteratedFDeriv] at h
    exact h
  induction l with
  | zero =>
    let e0 := continuousMultilinearCurryFin0 ℝ E2 ℝ
    let e1 := continuousMultilinearCurryFin1 ℝ E2 ℝ
    let cL1 := continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin 2 => E2) ℝ
    let Λ : E2 × (∀ r : Fin (0 + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
        E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) :=
      fun z => (z.1, e0 (z.2 ⟨0, by omega⟩), e1 (z.2 ⟨1, by omega⟩),
        (e1.toContinuousLinearEquiv.toContinuousLinearMap).comp (cL1 (z.2 ⟨2, by omega⟩)))
    have hΛ : ContDiff ℝ ∞ Λ := by
      refine contDiff_fst.prodMk (ContDiff.prodMk ?_ (ContDiff.prodMk ?_ ?_))
      · exact e0.contDiff.comp ((ContinuousLinearMap.proj (R := ℝ)
          (φ := fun r : Fin (0 + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
          ⟨0, by omega⟩).contDiff.comp contDiff_snd)
      · exact e1.contDiff.comp ((ContinuousLinearMap.proj (R := ℝ)
          (φ := fun r : Fin (0 + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
          ⟨1, by omega⟩).contDiff.comp contDiff_snd)
      · have hcl1 : ContDiff ℝ ∞ cL1 := by
          set_option synthInstance.maxHeartbeats 400000 in
          exact LinearIsometryEquiv.contDiff _
        have h2 : ContDiff ℝ ∞ (fun z : E2 × (∀ r : Fin (0 + 2 + 1),
            ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) => cL1 (z.2 ⟨2, by omega⟩)) :=
          hcl1.comp ((ContinuousLinearMap.proj (R := ℝ)
          (φ := fun r : Fin (0 + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
          ⟨2, by omega⟩).contDiff.comp contDiff_snd)
        exact contDiff_const.clm_comp h2
    refine ⟨fun z => e0.symm (Ψ (Λ z)), ?_, ?_⟩
    · refine e0.symm.contDiff.comp_contDiffOn (hΨ.comp hΛ.contDiffOn ?_)
      intro z hz
      refine ⟨hz.1, ?_⟩
      show |e0 (z.2 ⟨0, by omega⟩)| < s
      rw [← Real.norm_eq_abs, LinearIsometryEquiv.norm_map]
      exact hz.2
    · intro w U hU hUW hw hws x hx
      rw [iteratedFDeriv_zero_eq_comp, Function.comp_apply]
      congr 2
      show (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x) =
        (x, e0 (iteratedFDeriv ℝ 0 w x), e1 (iteratedFDeriv ℝ 1 w x),
          (e1.toContinuousLinearEquiv.toContinuousLinearMap).comp (cL1 (iteratedFDeriv ℝ 2 w x)))
      refine Prod.ext rfl (Prod.ext ?_ (Prod.ext ?_ ?_))
      · simp [e0]
      · ext v
        simp [e1, iteratedFDeriv_one_apply, Fin.snoc]
      · ext a b
        simp [e1, cL1, iteratedFDeriv_two_apply, Fin.snoc]
  | succ l ih =>
    obtain ⟨Φ, hΦs, hΦr⟩ := ih
    let cL := continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
    let A : (∀ r : Fin (l + 1 + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
        (E2 →L[ℝ] E2 × (∀ r : Fin (l + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)) :=
      fun j => (ContinuousLinearMap.id ℝ E2).prod (ContinuousLinearMap.pi fun r : Fin (l + 2 + 1) =>
        continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin ((r : ℕ) + 1) => E2) ℝ (j r.succ))
    let π : E2 × (∀ r : Fin (l + 1 + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
        E2 × (∀ r : Fin (l + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) :=
      fun z => (z.1, fun r => z.2 (Fin.castSucc r))
    refine ⟨fun z => cL.symm ((fderiv ℝ Φ (π z)).comp (A z.2)), ?_, ?_⟩
    · have hπ : ContDiff ℝ ∞ π := by
        refine contDiff_fst.prodMk (contDiff_pi.2 fun r => ?_)
        exact (ContinuousLinearMap.proj (R := ℝ)
          (φ := fun r : Fin (l + 1 + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
          (Fin.castSucc r)).contDiff.comp contDiff_snd
      have hA : ContDiff ℝ ∞ (fun z : E2 × (∀ r : Fin (l + 1 + 2 + 1),
          ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) => A z.2) := by
        refine contDiff_clm_apply_iff.2 fun h => ?_
        refine contDiff_const.prodMk (contDiff_pi.2 fun r => ?_)
        have hcl : ContDiff ℝ ∞ (continuousMultilinearCurryLeftEquiv ℝ
            (fun _ : Fin ((r : ℕ) + 1) => E2) ℝ) := by
          set_option synthInstance.maxHeartbeats 400000 in
          exact LinearIsometryEquiv.contDiff _
        have hc : ContDiff ℝ ∞ (fun z : E2 × (∀ r : Fin (l + 1 + 2 + 1),
            ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) =>
            continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin ((r : ℕ) + 1) => E2) ℝ (z.2 r.succ)) :=
          hcl.comp
            ((ContinuousLinearMap.proj (R := ℝ)
            (φ := fun r : Fin (l + 1 + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
            r.succ).contDiff.comp contDiff_snd)
        exact hc.clm_apply contDiff_const
      have hmaps : Set.MapsTo π {z : E2 × (∀ r : Fin (l + 1 + 2 + 1),
          ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s}
          {z : E2 × (∀ r : Fin (l + 2 + 1),
          ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s} :=
        fun z hz => hz
      have hg := (hΦs.fderiv_of_isOpen (hDomOpen (l + 2)) (m := ∞) le_rfl).comp hπ.contDiffOn hmaps
      exact cL.symm.contDiff.comp_contDiffOn (hg.clm_comp hA.contDiffOn)
    · intro w U hU hUW hw hws x hx
      have hw2 : ContDiffOn ℝ ((l + 2 : ℕ) : WithTop ℕ∞) w U :=
        hw.of_le (by exact_mod_cast (by omega : l + 2 ≤ l + 1 + 2))
      have hIH := hΦr w U hU hUW hw2 hws
      have hev : iteratedFDeriv ℝ l (fun y => Ψ (y, w y, fderiv ℝ w y, fderiv ℝ (fderiv ℝ w) y))
          =ᶠ[𝓝 x] fun y => Φ (y, fun r => iteratedFDeriv ℝ r w y) :=
        Filter.eventually_of_mem (hU.mem_nhds hx) hIH
      have hwx : ContDiffAt ℝ ((l + 2 + 1 : ℕ) : WithTop ℕ∞) w x := hw.contDiffAt (hU.mem_nhds hx)
      have hJ := hjet (l + 2) w x hwx
      have hp : (x, fun r : Fin (l + 2 + 1) => iteratedFDeriv ℝ r w x) ∈
          {z : E2 × (∀ r : Fin (l + 2 + 1),
          ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s} := by
        refine ⟨hUW hx, ?_⟩
        show ‖iteratedFDeriv ℝ 0 w x‖ < s
        rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs]
        exact hws x hx
      have hΦd : DifferentiableAt ℝ Φ (x, fun r : Fin (l + 2 + 1) => iteratedFDeriv ℝ r w x) :=
        (hΦs.differentiableOn (by simp)).differentiableAt ((hDomOpen (l + 2)).mem_nhds hp)
      have hchain : HasFDerivAt (fun y => Φ (y, fun r : Fin (l + 2 + 1) => iteratedFDeriv ℝ r w y))
          ((fderiv ℝ Φ (x, fun r : Fin (l + 2 + 1) => iteratedFDeriv ℝ r w x)).comp
            ((ContinuousLinearMap.id ℝ E2).prod (ContinuousLinearMap.pi fun r : Fin (l + 2 + 1) =>
              continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin ((r : ℕ) + 1) => E2) ℝ
                (iteratedFDeriv ℝ ((r : ℕ) + 1) w x)))) x :=
        hΦd.hasFDerivAt.comp x ((hasFDerivAt_id x).prodMk hJ)
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply, hev.fderiv_eq, hchain.fderiv]
      rfl

theorem pcr_nem_omega {Z E V G : Type} [TopologicalSpace Z] [CompactSpace Z]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup V] [NormedSpace ℝ V]
    [NormedAddCommGroup G] [NormedSpace ℝ G]
    (π : C(Z, E)) (O : Set (E × V)) (hO : IsOpen O) (F : E × V → G) (hF : ContDiffOn ℝ ∞ F O) :
    IsOpen {g : BoundedContinuousFunction Z V | ∀ z, (π z, g z) ∈ O} ∧
    ∃ N : BoundedContinuousFunction Z V → BoundedContinuousFunction Z G,
      ContDiffOn ℝ ∞ N {g | ∀ z, (π z, g z) ∈ O} ∧
      ∀ g : BoundedContinuousFunction Z V, (∀ z, (π z, g z) ∈ O) → ∀ z, N g z = F (π z, g z) :=
by
  classical
  set U : Set (BoundedContinuousFunction Z V) := {g | ∀ z, (π z, g z) ∈ O} with hUdef
  
  have tube : ∀ g : BoundedContinuousFunction Z V, (∀ z, (π z, g z) ∈ O) →
      ∃ δ : ℝ, 0 < δ ∧ ∀ (z : Z) (v : V), dist v (g z) < δ → (π z, v) ∈ O := by
    intro g hg
    have hc : Continuous (fun z => (π z, g z)) := π.continuous.prodMk g.continuous
    obtain ⟨δ, hδ, hsub⟩ := (isCompact_range hc).exists_thickening_subset_open hO
      (Set.range_subset_iff.2 hg)
    refine ⟨δ, hδ, fun z v hv => hsub ?_⟩
    rw [Metric.mem_thickening_iff]
    refine ⟨(π z, g z), Set.mem_range_self z, ?_⟩
    rw [Prod.dist_eq, dist_self, max_eq_right dist_nonneg]
    exact hv
  
  have hUo : IsOpen U := by
    rw [Metric.isOpen_iff]
    intro g hg
    obtain ⟨δ, hδ, ht⟩ := tube g hg
    refine ⟨δ, hδ, fun g' hg' z => ht z _ ?_⟩
    exact lt_of_le_of_lt (BoundedContinuousFunction.dist_coe_le_dist z) hg'
  
  have opEx : ∀ (G' : Type) [NormedAddCommGroup G'] [NormedSpace ℝ G'] (F' : E × V → G'),
      ContinuousOn F' O → ∃ N : BoundedContinuousFunction Z V → BoundedContinuousFunction Z G',
        ∀ g ∈ U, ∀ z, N g z = F' (π z, g z) := by
    intro G' _ _ F' hF'
    refine ⟨fun g => if h : (∀ z, (π z, g z) ∈ O) then
      BoundedContinuousFunction.mkOfCompact ⟨fun z => F' (π z, g z),
        hF'.comp_continuous (π.continuous.prodMk g.continuous) h⟩ else 0, ?_⟩
    intro g hg z
    have hg' : ∀ z, (π z, g z) ∈ O := hg
    simp only [dif_pos hg']
    rfl
  
  have Mex : ∀ (G' : Type) [NormedAddCommGroup G'] [NormedSpace ℝ G'],
      ∃ M : BoundedContinuousFunction Z (V →L[ℝ] G') →L[ℝ] BoundedContinuousFunction Z V →L[ℝ]
        BoundedContinuousFunction Z G', ∀ a b z, M a b z = a z (b z) := by
    intro G' _ _
    have key : ∀ (C : Type) [NormedAddCommGroup C] [NormedSpace ℝ C] (β : C →L[ℝ] V →L[ℝ] G'),
        ∃ M : BoundedContinuousFunction Z C →L[ℝ] BoundedContinuousFunction Z V →L[ℝ]
          BoundedContinuousFunction Z G', ∀ a b z, M a b z = β (a z) (b z) := by
      intro C _ _ β
      have hb : ∀ (a : BoundedContinuousFunction Z C)
          (b : BoundedContinuousFunction Z V) (z : Z),
          ‖β (a z) (b z)‖ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
        intro a b z
        calc ‖β (a z) (b z)‖ ≤ ‖β‖ * ‖a z‖ * ‖b z‖ := β.le_opNorm₂ _ _
          _ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
            gcongr
            · exact a.norm_coe_le_norm z
            · exact b.norm_coe_le_norm z
      let app : BoundedContinuousFunction Z C → BoundedContinuousFunction Z V →
          BoundedContinuousFunction Z G' := fun a b =>
        BoundedContinuousFunction.ofNormedAddCommGroup (fun z => β (a z) (b z))
          ((β.continuous.comp a.continuous).clm_apply b.continuous) (‖β‖ * ‖a‖ * ‖b‖)
          (hb a b)
      have happ : ∀ a b z, app a b z = β (a z) (b z) := fun _ _ _ => rfl
      let L := LinearMap.mk₂ ℝ app
        (fun a₁ a₂ b => by
          ext z
          simp only [happ, BoundedContinuousFunction.add_apply, map_add,
            ContinuousLinearMap.add_apply])
        (fun c a b => by
          ext z
          simp only [happ, BoundedContinuousFunction.smul_apply, map_smul,
            ContinuousLinearMap.smul_apply])
        (fun a b₁ b₂ => by
          ext z
          simp only [happ, BoundedContinuousFunction.add_apply, map_add])
        (fun c a b => by
          ext z
          simp only [happ, BoundedContinuousFunction.smul_apply, map_smul])
      have hbound : ∀ a b, ‖L a b‖ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
        intro a b
        exact BoundedContinuousFunction.norm_ofNormedAddCommGroup_le _
          (by positivity) (hb a b)
      exact ⟨L.mkContinuous₂ ‖β‖ hbound, fun a b z => rfl⟩
    obtain ⟨M, hM⟩ := key (V →L[ℝ] G') (ContinuousLinearMap.id ℝ (V →L[ℝ] G'))
    exact ⟨M, fun a b z => by rw [hM]; rfl⟩
  
  have hderiv : ∀ (G' : Type) [NormedAddCommGroup G'] [NormedSpace ℝ G'] (F' : E × V → G'),
      ContDiffOn ℝ ∞ F' O →
      ∀ N : BoundedContinuousFunction Z V → BoundedContinuousFunction Z G',
      (∀ g ∈ U, ∀ z, N g z = F' (π z, g z)) →
      ∀ M : BoundedContinuousFunction Z (V →L[ℝ] G') →L[ℝ] BoundedContinuousFunction Z V →L[ℝ]
        BoundedContinuousFunction Z G', (∀ a b z, M a b z = a z (b z)) →
      ∀ g ∈ U, ∀ Dg : BoundedContinuousFunction Z (V →L[ℝ] G'),
      (∀ z, Dg z = (fderiv ℝ F' (π z, g z)).comp (ContinuousLinearMap.inr ℝ E V)) →
      HasFDerivAt N (M Dg) g := by
    intro G' _ _ F' hF' N hN M hM g hg Dg hDg
    have hg' : ∀ z, (π z, g z) ∈ O := hg
    obtain ⟨δ₀, hδ₀, ht⟩ := tube g hg'
    obtain ⟨hFd, hFds⟩ := (contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hF'
    set D2 : E × V → V →L[ℝ] G' :=
      fun y => (fderiv ℝ F' y).comp (ContinuousLinearMap.inr ℝ E V) with hD2
    have hD2c : ContinuousOn D2 O := hFds.continuousOn.clm_comp continuousOn_const
    have hc : Continuous (fun z => (π z, g z)) := π.continuous.prodMk g.continuous
    have hC := isCompact_range hc
    rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
    intro ε hε
    have hent := hC.uniformContinuousAt_of_continuousAt D2
      (fun a ha => by
        obtain ⟨z, rfl⟩ := ha
        exact hD2c.continuousAt (hO.mem_nhds (hg' z)))
      (Metric.dist_mem_uniformity hε)
    obtain ⟨δ₁, hδ₁, hu⟩ := Metric.mem_uniformity_dist.1 hent
    have hδ : 0 < min δ₀ δ₁ := lt_min hδ₀ hδ₁
    filter_upwards [Metric.ball_mem_nhds (0 : BoundedContinuousFunction Z V) hδ] with h hh
    rw [mem_ball_zero_iff] at hh
    have hhz : ∀ z, ‖h z‖ < min δ₀ δ₁ := fun z => lt_of_le_of_lt (h.norm_coe_le_norm z) hh
    have hgh : ∀ z, (π z, (g + h) z) ∈ O := by
      intro z
      apply ht
      rw [BoundedContinuousFunction.coe_add, Pi.add_apply, dist_eq_norm, add_sub_cancel_left]
      exact lt_of_lt_of_le (hhz z) (min_le_left _ _)
    show ‖N (g + h) - N g - M Dg h‖ ≤ ε * ‖h‖
    refine (BoundedContinuousFunction.norm_le (by positivity)).2 (fun z => ?_)
    simp only [BoundedContinuousFunction.coe_sub, Pi.sub_apply]
    rw [hN _ hgh z, hN g hg z, hM, BoundedContinuousFunction.coe_add, Pi.add_apply]
    have hφd : ∀ v ∈ Metric.ball (g z) (min δ₀ δ₁),
        HasFDerivWithinAt (fun v => F' (π z, v) - Dg z v) (D2 (π z, v) - Dg z)
          (Metric.ball (g z) (min δ₀ δ₁)) v := by
      intro v hv
      have hvO : (π z, v) ∈ O := ht z v (lt_of_lt_of_le hv (min_le_left _ _))
      have h1 : HasFDerivAt (fun v => F' (π z, v)) (D2 (π z, v)) v :=
        ((hFd.differentiableAt (hO.mem_nhds hvO)).hasFDerivAt).comp v
          (hasFDerivAt_prodMk_right (π z) v)
      exact (h1.sub (Dg z).hasFDerivAt).hasFDerivWithinAt
    have hbd : ∀ v ∈ Metric.ball (g z) (min δ₀ δ₁), ‖D2 (π z, v) - Dg z‖ ≤ ε := by
      intro v hv
      rw [hDg z]
      have hdist : dist (π z, g z) (π z, v) < δ₁ := by
        rw [Prod.dist_eq, dist_self, max_eq_right dist_nonneg, dist_comm]
        exact lt_of_lt_of_le hv (min_le_right _ _)
      have h2 : dist (D2 (π z, g z)) (D2 (π z, v)) < ε := hu hdist ⟨z, rfl⟩
      rw [dist_eq_norm, norm_sub_rev] at h2
      exact h2.le
    have hmem : g z + h z ∈ Metric.ball (g z) (min δ₀ δ₁) := by
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
      exact hhz z
    have hmv := (convex_ball (g z) (min δ₀ δ₁)).norm_image_sub_le_of_norm_hasFDerivWithin_le
      (f := fun v => F' (π z, v) - Dg z v) (f' := fun v => D2 (π z, v) - Dg z) hφd hbd
      (Metric.mem_ball_self hδ) hmem
    have heq : (F' (π z, g z + h z) - Dg z (g z + h z)) - (F' (π z, g z) - Dg z (g z)) =
        F' (π z, g z + h z) - F' (π z, g z) - Dg z (h z) := by
      rw [map_add]; abel
    rw [add_sub_cancel_left] at hmv
    rw [← heq]
    calc _ ≤ ε * ‖h z‖ := hmv
      _ ≤ ε * ‖h‖ := mul_le_mul_of_nonneg_left (h.norm_coe_le_norm z) hε.le
  
  have pre : ∀ (G' : Type) [NormedAddCommGroup G'] [NormedSpace ℝ G'] (F' : E × V → G'),
      ContDiffOn ℝ ∞ F' O →
      ∀ N : BoundedContinuousFunction Z V → BoundedContinuousFunction Z G',
      (∀ g ∈ U, ∀ z, N g z = F' (π z, g z)) →
      ∃ (M : BoundedContinuousFunction Z (V →L[ℝ] G') →L[ℝ] BoundedContinuousFunction Z V →L[ℝ]
        BoundedContinuousFunction Z G')
        (N' : BoundedContinuousFunction Z V → BoundedContinuousFunction Z (V →L[ℝ] G')),
        (∀ g ∈ U, ∀ z, N' g z =
          (fun y => (fderiv ℝ F' y).comp (ContinuousLinearMap.inr ℝ E V)) (π z, g z)) ∧
        ContDiffOn ℝ ∞ (fun y => (fderiv ℝ F' y).comp (ContinuousLinearMap.inr ℝ E V)) O ∧
        ∀ g ∈ U, HasFDerivAt N (M (N' g)) g := by
    intro G' _ _ F' hF' N hN
    obtain ⟨M, hM⟩ := Mex G'
    have hD2s : ContDiffOn ℝ ∞
        (fun y => (fderiv ℝ F' y).comp (ContinuousLinearMap.inr ℝ E V)) O :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hF').2.clm_comp contDiffOn_const
    obtain ⟨N', hN'⟩ := opEx (V →L[ℝ] G') _ hD2s.continuousOn
    exact ⟨M, N', hN', hD2s, fun g hg => hderiv G' F' hF' N hN M hM g hg (N' g) (hN' g hg)⟩
  
  have boot : ∀ n : ℕ, ∀ (G' : Type) [NormedAddCommGroup G'] [NormedSpace ℝ G']
      (F' : E × V → G'), ContDiffOn ℝ ∞ F' O →
      ∀ N : BoundedContinuousFunction Z V → BoundedContinuousFunction Z G',
      (∀ g ∈ U, ∀ z, N g z = F' (π z, g z)) → ContDiffOn ℝ n N U := by
    intro n
    induction n with
    | zero =>
      intro G' _ _ F' hF' N hN
      obtain ⟨M, N', _, _, hD⟩ := pre G' F' hF' N hN
      rw [Nat.cast_zero, contDiffOn_zero]
      exact fun g hg => (hD g hg).continuousAt.continuousWithinAt
    | succ n ih =>
      intro G' _ _ F' hF' N hN
      obtain ⟨M, N', hN', hD2s, hD⟩ := pre G' F' hF' N hN
      have hN's : ContDiffOn ℝ n N' U := ih (V →L[ℝ] G') _ hD2s N' hN'
      have hfd : ContDiffOn ℝ n (fderiv ℝ N) U :=
        (M.contDiff.comp_contDiffOn hN's).congr (fun g hg => by
          rw [(hD g hg).fderiv]; rfl)
      rw [Nat.cast_add_one]
      exact (contDiffOn_succ_iff_fderiv_of_isOpen hUo).2
        ⟨fun g hg => (hD g hg).differentiableAt.differentiableWithinAt,
          fun h => absurd h (by simp), hfd⟩
  obtain ⟨N, hN⟩ := opEx G F hF.continuousOn
  exact ⟨hUo, N, contDiffOn_infty.2 (fun n => boot n G F hF N hN), hN⟩

theorem pcr_nem_bcf_linear {Z A B ι : Type} [TopologicalSpace Z] [NormedAddCommGroup A]
    [NormedSpace ℝ A] [NormedAddCommGroup B] [NormedSpace ℝ B] [Fintype ι] {Fi : ι → Type}
    [∀ i, NormedAddCommGroup (Fi i)] [∀ i, NormedSpace ℝ (Fi i)] :
    (∃ M : BoundedContinuousFunction Z (A →L[ℝ] B) →L[ℝ] BoundedContinuousFunction Z A →L[ℝ]
        BoundedContinuousFunction Z B, ∀ a b z, M a b z = a z (b z)) ∧
    (∃ P : (BoundedContinuousFunction Z A × BoundedContinuousFunction Z B) →L[ℝ]
        BoundedContinuousFunction Z (A × B), ∀ ab z, P ab z = (ab.1 z, ab.2 z)) ∧
    (∃ Lp : (∀ i, BoundedContinuousFunction Z (Fi i)) →L[ℝ] BoundedContinuousFunction Z (∀ i, Fi i),
        ∀ f z i, Lp f z i = f i z) :=
by
  classical
  refine ⟨?_, ?_, ?_⟩
  · have key : ∀ (C : Type) [NormedAddCommGroup C] [NormedSpace ℝ C] (β : C →L[ℝ] A →L[ℝ] B),
        ∃ M : BoundedContinuousFunction Z C →L[ℝ] BoundedContinuousFunction Z A →L[ℝ]
          BoundedContinuousFunction Z B, ∀ a b z, M a b z = β (a z) (b z) := by
      intro C _ _ β
      have hb : ∀ (a : BoundedContinuousFunction Z C)
          (b : BoundedContinuousFunction Z A) (z : Z),
          ‖β (a z) (b z)‖ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
        intro a b z
        calc ‖β (a z) (b z)‖ ≤ ‖β‖ * ‖a z‖ * ‖b z‖ := β.le_opNorm₂ _ _
          _ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
            gcongr
            · exact a.norm_coe_le_norm z
            · exact b.norm_coe_le_norm z
      let app : BoundedContinuousFunction Z C → BoundedContinuousFunction Z A →
          BoundedContinuousFunction Z B := fun a b =>
        BoundedContinuousFunction.ofNormedAddCommGroup (fun z => β (a z) (b z))
          ((β.continuous.comp a.continuous).clm_apply b.continuous) (‖β‖ * ‖a‖ * ‖b‖)
          (hb a b)
      have happ : ∀ a b z, app a b z = β (a z) (b z) := fun _ _ _ => rfl
      let L := LinearMap.mk₂ ℝ app
        (fun a₁ a₂ b => by
          ext z
          simp only [happ, BoundedContinuousFunction.add_apply, map_add,
            ContinuousLinearMap.add_apply])
        (fun c a b => by
          ext z
          simp only [happ, BoundedContinuousFunction.smul_apply, map_smul,
            ContinuousLinearMap.smul_apply])
        (fun a b₁ b₂ => by
          ext z
          simp only [happ, BoundedContinuousFunction.add_apply, map_add])
        (fun c a b => by
          ext z
          simp only [happ, BoundedContinuousFunction.smul_apply, map_smul])
      have hbound : ∀ a b, ‖L a b‖ ≤ ‖β‖ * ‖a‖ * ‖b‖ := by
        intro a b
        exact BoundedContinuousFunction.norm_ofNormedAddCommGroup_le _
          (by positivity) (hb a b)
      exact ⟨L.mkContinuous₂ ‖β‖ hbound, fun a b z => rfl⟩
    obtain ⟨M, hM⟩ := key (A →L[ℝ] B) (ContinuousLinearMap.id ℝ (A →L[ℝ] B))
    exact ⟨M, fun a b z => by rw [hM]; rfl⟩
  · refine ⟨(ContinuousLinearMap.compLeftContinuousBounded Z
        (ContinuousLinearMap.inl ℝ A B)).coprod
      (ContinuousLinearMap.compLeftContinuousBounded Z (ContinuousLinearMap.inr ℝ A B)),
      fun ab z => ?_⟩
    simp
  · refine ⟨∑ i : ι, (ContinuousLinearMap.compLeftContinuousBounded Z
        (ContinuousLinearMap.single ℝ Fi i)).comp (ContinuousLinearMap.proj i),
      fun f z i => ?_⟩
    simp [ContinuousLinearMap.sum_apply, BoundedContinuousFunction.sum_apply,
      Finset.sum_apply]

theorem pcr_nem_holder_omega (c : E2) (ρ : ℝ) (hρ : 0 < ρ) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1)
    {V G : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] [NormedAddCommGroup G] [NormedSpace ℝ G]
    [CompleteSpace G]
    (O : Set (E2 × V)) (hO : IsOpen O) (Φ : E2 × V → G) (hΦ : ContDiffOn ℝ ∞ Φ O)
    (hconv : ∀ a ∈ O, ∀ b ∈ O, a.1 ∈ Metric.closedBall c ρ → b.1 ∈ Metric.closedBall c ρ →
      ∀ t ∈ Set.Icc (0 : ℝ) 1, a + t • (b - a) ∈ O) :
    ∃ Nq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
        BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V →
        BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} G,
      ContDiffOn ℝ ∞ Nq {gq | ∀ x : Metric.closedBall c ρ, ((x : E2), gq.1 x) ∈ O} ∧
      ∀ gq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
          BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V,
        (∀ x : Metric.closedBall c ρ, ((x : E2), gq.1 x) ∈ O) →
        (∀ p, gq.2 p = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ • (gq.1 p.1.1 - gq.1 p.1.2)) →
        ∀ p, Nq gq p = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
            (Φ ((p.1.1 : E2), gq.1 p.1.1) - Φ ((p.1.2 : E2), gq.1 p.1.2)) :=
by
  haveI : CompactSpace (Metric.closedBall c ρ) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall c ρ)
  
  have hdpos : ∀ p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2},
      0 < dist (p.1.1 : E2) (p.1.2 : E2) := by
    intro p
    refine dist_pos.mpr ?_
    intro h
    exact p.2 (Subtype.ext h)
  have hdle : ∀ p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2},
      dist (p.1.1 : E2) (p.1.2 : E2) ≤ 2 * ρ := by
    intro p
    have h1 := Metric.mem_closedBall.mp p.1.1.2
    have h2 := Metric.mem_closedBall.mp p.1.2.2
    calc dist (p.1.1 : E2) (p.1.2 : E2) ≤ dist (p.1.1 : E2) c + dist c (p.1.2 : E2) :=
          dist_triangle _ _ _
      _ ≤ ρ + ρ := by rw [dist_comm c]; exact add_le_add h1 h2
      _ = 2 * ρ := by ring
  let fD : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} → E2 :=
    fun p => (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ • ((p.1.1 : E2) - (p.1.2 : E2))
  have hxc : Continuous (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
      (p.1.1 : E2)) :=
    continuous_subtype_val.comp (continuous_fst.comp continuous_subtype_val)
  have hyc : Continuous (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
      (p.1.2 : E2)) :=
    continuous_subtype_val.comp (continuous_snd.comp continuous_subtype_val)
  have hfDc : Continuous fD := by
    have hdα : Continuous (fun p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} =>
        dist (p.1.1 : E2) (p.1.2 : E2) ^ α) :=
      (hxc.dist hyc).rpow_const (fun p => Or.inl (hdpos p).ne')
    exact (hdα.inv₀ (fun p => (Real.rpow_pos_of_pos (hdpos p) α).ne')).smul (hxc.sub hyc)
  have hfDb : ∀ p, ‖fD p‖ ≤ max 1 (2 * ρ) := by
    intro p
    have hd := hdpos p
    have hdα := Real.rpow_pos_of_pos hd α
    have hn : ‖fD p‖ = dist (p.1.1 : E2) (p.1.2 : E2) / dist (p.1.1 : E2) (p.1.2 : E2) ^ α := by
      simp only [fD, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hdα, ← dist_eq_norm]
      ring
    rw [hn, div_le_iff₀ hdα]
    rcases le_total (dist (p.1.1 : E2) (p.1.2 : E2)) 1 with h1 | h1
    · have h2 : dist (p.1.1 : E2) (p.1.2 : E2) ≤ dist (p.1.1 : E2) (p.1.2 : E2) ^ α := by
        calc dist (p.1.1 : E2) (p.1.2 : E2) = dist (p.1.1 : E2) (p.1.2 : E2) ^ (1 : ℝ) :=
              (Real.rpow_one _).symm
          _ ≤ _ := Real.rpow_le_rpow_of_exponent_ge hd h1 hα1.le
      nlinarith [le_max_left 1 (2 * ρ)]
    · have h2 : 1 ≤ dist (p.1.1 : E2) (p.1.2 : E2) ^ α := Real.one_le_rpow h1 hα0.le
      have h3 := hdle p
      have h4 := le_max_right 1 (2 * ρ)
      have h5 : (0 : ℝ) ≤ max 1 (2 * ρ) := le_trans zero_le_one (le_max_left _ _)
      nlinarith [mul_le_mul_of_nonneg_left h2 h5]
  let Dα : BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} E2 :=
    BoundedContinuousFunction.ofNormedAddCommGroup fD hfDc (max 1 (2 * ρ)) hfDb
  
  have hγc : ∀ f : BoundedContinuousFunction (Metric.closedBall c ρ) V,
      Continuous (fun z : (Metric.closedBall c ρ × Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1 =>
        f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2)) := by
    intro f
    exact (f.continuous.comp (continuous_snd.comp continuous_fst)).add
      ((continuous_subtype_val.comp continuous_snd).smul
        ((f.continuous.comp (continuous_fst.comp continuous_fst)).sub
          (f.continuous.comp (continuous_snd.comp continuous_fst))))
  have hγb : ∀ (f : BoundedContinuousFunction (Metric.closedBall c ρ) V)
      (z : (Metric.closedBall c ρ × Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1),
      ‖f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2)‖ ≤ 3 * ‖f‖ := by
    intro f z
    have ht0 : 0 ≤ (z.2 : ℝ) := z.2.2.1
    have ht1 : (z.2 : ℝ) ≤ 1 := z.2.2.2
    have h1 := f.norm_coe_le_norm z.1.1
    have h2 := f.norm_coe_le_norm z.1.2
    have h3 : ‖f z.1.1 - f z.1.2‖ ≤ ‖f‖ + ‖f‖ := (norm_sub_le _ _).trans (add_le_add h1 h2)
    have h4 : ‖(z.2 : ℝ) • (f z.1.1 - f z.1.2)‖ = (z.2 : ℝ) * ‖f z.1.1 - f z.1.2‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0]
    have h5 := norm_add_le (f z.1.2) ((z.2 : ℝ) • (f z.1.1 - f z.1.2))
    have h6 := mul_le_mul_of_nonneg_left h3 ht0
    have h7 := norm_nonneg f
    nlinarith
  let γL : BoundedContinuousFunction (Metric.closedBall c ρ) V →ₗ[ℝ]
      BoundedContinuousFunction ((Metric.closedBall c ρ × Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1) V :=
    { toFun := fun f => BoundedContinuousFunction.ofNormedAddCommGroup
        (fun z => f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2)) (hγc f) (3 * ‖f‖) (hγb f)
      map_add' := fun f g => by
        ext z
        rw [BoundedContinuousFunction.add_apply]
        show (f + g) z.1.2 + (z.2 : ℝ) • ((f + g) z.1.1 - (f + g) z.1.2) =
          (f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2)) + (g z.1.2 + (z.2 : ℝ) • (g z.1.1 - g z.1.2))
        simp only [BoundedContinuousFunction.add_apply]
        module
      map_smul' := fun r f => by
        ext z
        rw [BoundedContinuousFunction.smul_apply]
        show (r • f) z.1.2 + (z.2 : ℝ) • ((r • f) z.1.1 - (r • f) z.1.2) =
          (RingHom.id ℝ) r • (f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2))
        simp only [BoundedContinuousFunction.smul_apply, RingHom.id_apply]
        module }
  let Γ := γL.mkContinuous 3 (fun f => (BoundedContinuousFunction.norm_le (by positivity)).mpr (hγb f))
  have hΓ : ∀ f z, Γ f z = f z.1.2 + (z.2 : ℝ) • (f z.1.1 - f z.1.2) := fun f z => rfl
  
  let ι0 : ℝ → Set.Icc (0 : ℝ) 1 := Set.projIcc (0 : ℝ) 1 zero_le_one
  have hι0 : Continuous ι0 := continuous_projIcc
  have hIgen : ∀ (Y Y' H : Type) [TopologicalSpace Y] [TopologicalSpace Y'] [NormedAddCommGroup H]
      [NormedSpace ℝ H] (φ : C(Y', Y)),
      ∃ I : BoundedContinuousFunction (Y × Set.Icc (0 : ℝ) 1) H →L[ℝ] BoundedContinuousFunction Y' H,
        ∀ a y', I a y' = ∫ t in (0 : ℝ)..1, a (φ y', ι0 t) := by
    intro Y Y' H _ _ _ _ φ
    have hIc : ∀ a : BoundedContinuousFunction (Y × Set.Icc (0 : ℝ) 1) H,
        Continuous (fun y' : Y' => ∫ t in (0 : ℝ)..1, a (φ y', ι0 t)) := by
      intro a
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun y' t => a (φ y', ι0 t))
        (a.continuous.comp ((φ.continuous.comp continuous_fst).prodMk
          (hι0.comp continuous_snd))) 0 1
    have hIb : ∀ (a : BoundedContinuousFunction (Y × Set.Icc (0 : ℝ) 1) H) (y' : Y'),
        ‖∫ t in (0 : ℝ)..1, a (φ y', ι0 t)‖ ≤ ‖a‖ := by
      intro a y'
      have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1) (C := ‖a‖)
        (f := fun t => a (φ y', ι0 t)) (fun t _ => a.norm_coe_le_norm _)
      simpa using h
    have hIi : ∀ (a : BoundedContinuousFunction (Y × Set.Icc (0 : ℝ) 1) H) (q : Y),
        IntervalIntegrable (fun t => a (q, ι0 t)) MeasureTheory.volume 0 1 := by
      intro a q
      exact (a.continuous.comp (continuous_const.prodMk hι0)).intervalIntegrable 0 1
    let IL : BoundedContinuousFunction (Y × Set.Icc (0 : ℝ) 1) H →ₗ[ℝ]
        BoundedContinuousFunction Y' H :=
      { toFun := fun a => BoundedContinuousFunction.ofNormedAddCommGroup
          (fun y' => ∫ t in (0 : ℝ)..1, a (φ y', ι0 t)) (hIc a) ‖a‖ (hIb a)
        map_add' := fun a b => by
          refine BoundedContinuousFunction.ext (fun y' => ?_)
          rw [BoundedContinuousFunction.add_apply]
          show ∫ t in (0 : ℝ)..1, (a + b) (φ y', ι0 t) =
            (∫ t in (0 : ℝ)..1, a (φ y', ι0 t)) + ∫ t in (0 : ℝ)..1, b (φ y', ι0 t)
          simp only [BoundedContinuousFunction.add_apply]
          exact intervalIntegral.integral_add (hIi a (φ y')) (hIi b (φ y'))
        map_smul' := fun r a => by
          refine BoundedContinuousFunction.ext (fun y' => ?_)
          rw [BoundedContinuousFunction.smul_apply]
          show ∫ t in (0 : ℝ)..1, (r • a) (φ y', ι0 t) =
            (RingHom.id ℝ) r • ∫ t in (0 : ℝ)..1, a (φ y', ι0 t)
          simp only [BoundedContinuousFunction.smul_apply, RingHom.id_apply]
          exact intervalIntegral.integral_smul r _ }
    have hILb : ∀ a, ‖IL a‖ ≤ 1 * ‖a‖ := fun a => by
      rw [one_mul]
      exact (BoundedContinuousFunction.norm_le (f := IL a) (norm_nonneg a)).mpr (fun y' => hIb a y')
    exact ⟨IL.mkContinuous 1 hILb, fun a y' => rfl⟩
  obtain ⟨I, hI⟩ := hIgen (Metric.closedBall c ρ × Metric.closedBall c ρ)
    {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} (E2 × V →L[ℝ] G)
    ⟨Subtype.val, continuous_subtype_val⟩
  
  let π' : C((Metric.closedBall c ρ × Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1, E2) :=
    ⟨fun z => (z.1.2 : E2) + (z.2 : ℝ) • ((z.1.1 : E2) - (z.1.2 : E2)),
      (continuous_subtype_val.comp (continuous_snd.comp continuous_fst)).add
        ((continuous_subtype_val.comp continuous_snd).smul
          ((continuous_subtype_val.comp (continuous_fst.comp continuous_fst)).sub
            (continuous_subtype_val.comp (continuous_snd.comp continuous_fst))))⟩
  obtain ⟨-, N', hN's, hN'v⟩ := pcr_nem_omega π' O hO (fderiv ℝ Φ)
    (hΦ.fderiv_of_isOpen (m := ∞) hO le_rfl)
  
  obtain ⟨⟨M, hM⟩, -, -⟩ := pcr_nem_bcf_linear
    (Z := {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}) (A := E2 × V) (B := G)
    (ι := Unit) (Fi := fun _ => ℝ)
  obtain ⟨-, ⟨P, hP⟩, -⟩ := pcr_nem_bcf_linear
    (Z := {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}) (A := E2) (B := V)
    (ι := Unit) (Fi := fun _ => ℝ)
  
  have hseg : ∀ (f : BoundedContinuousFunction (Metric.closedBall c ρ) V)
      (z : (Metric.closedBall c ρ × Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1),
      (π' z, Γ f z) = ((z.1.2 : E2), f z.1.2) +
        (z.2 : ℝ) • (((z.1.1 : E2), f z.1.1) - ((z.1.2 : E2), f z.1.2)) := by
    intro f z
    rw [hΓ, Prod.mk_sub_mk, Prod.smul_mk, Prod.mk_add_mk]
    rfl
  have hU : ∀ gq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
      BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V,
      (∀ x : Metric.closedBall c ρ, ((x : E2), gq.1 x) ∈ O) →
      ∀ z, (π' z, Γ gq.1 z) ∈ O := by
    intro gq hgq z
    rw [hseg]
    exact hconv _ (hgq z.1.2) _ (hgq z.1.1) z.1.2.2 z.1.1.2 _ z.2.2
  
  have hftc : ∀ a b : E2 × V, (∀ t ∈ Set.Icc (0 : ℝ) 1, a + t • (b - a) ∈ O) →
      (∫ t in (0 : ℝ)..1, fderiv ℝ Φ (a + t • (b - a))) (b - a) = Φ b - Φ a := by
    intro a b hab
    have hcont : ContinuousOn (fun t : ℝ => fderiv ℝ Φ (a + t • (b - a))) (Set.uIcc 0 1) := by
      rw [Set.uIcc_of_le zero_le_one]
      refine (hΦ.continuousOn_fderiv_of_isOpen hO (by simp)).comp ?_ hab
      exact (continuous_const.add (continuous_id.smul continuous_const)).continuousOn
    rw [ContinuousLinearMap.intervalIntegral_apply hcont.intervalIntegrable]
    have hderiv : ∀ t ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt (fun t : ℝ => Φ (a + t • (b - a)))
        (fderiv ℝ Φ (a + t • (b - a)) (b - a)) t := by
      intro t ht
      rw [Set.uIcc_of_le zero_le_one] at ht
      have hl : HasDerivAt (fun t : ℝ => a + t • (b - a)) (b - a) t := by
        simpa using ((hasDerivAt_id t).smul_const (b - a)).const_add a
      have hd : DifferentiableAt ℝ Φ (a + t • (b - a)) :=
        (hΦ.differentiableOn (by simp)).differentiableAt (hO.mem_nhds (hab t ht))
      exact hd.hasFDerivAt.comp_hasDerivAt t hl
    have hint2 : IntervalIntegrable (fun t => fderiv ℝ Φ (a + t • (b - a)) (b - a))
        MeasureTheory.volume 0 1 :=
      (hcont.clm_apply continuousOn_const).intervalIntegrable
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint2]
    simp
  
  refine ⟨fun gq => M (I (N' (Γ gq.1))) (P (Dα, gq.2)), ?_, ?_⟩
  · have hΓs : ContDiff ℝ ∞ (fun gq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
        BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V =>
        Γ gq.1) := Γ.contDiff.comp contDiff_fst
    have h1 : ContDiffOn ℝ ∞ (fun gq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
        BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V =>
        N' (Γ gq.1)) {gq | ∀ x : Metric.closedBall c ρ, ((x : E2), gq.1 x) ∈ O} :=
      hN's.comp hΓs.contDiffOn (fun gq hgq => hU gq hgq)
    have hIs : ContDiff ℝ ∞ (fun a : BoundedContinuousFunction ((Metric.closedBall c ρ ×
        Metric.closedBall c ρ) × Set.Icc (0 : ℝ) 1) (E2 × V →L[ℝ] G) => I a) := I.contDiff
    have hMs : ContDiff ℝ ∞ M := by fun_prop
    have h2 := (hMs.comp hIs).comp_contDiffOn h1
    have h3 : ContDiff ℝ ∞ (fun gq : BoundedContinuousFunction (Metric.closedBall c ρ) V ×
        BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2} V =>
        P (Dα, gq.2)) := P.contDiff.comp (contDiff_const.prodMk contDiff_snd)
    exact h2.clm_apply h3.contDiffOn
  · intro gq hgq hq p
    have e1 : M (I (N' (Γ gq.1))) (P (Dα, gq.2)) p = (I (N' (Γ gq.1)) p) (Dα p, gq.2 p) := by
      rw [hM, hP]
    have hint : I (N' (Γ gq.1)) p = ∫ t in (0 : ℝ)..1,
        fderiv ℝ Φ (((p.1.2 : E2), gq.1 p.1.2) +
          t • (((p.1.1 : E2), gq.1 p.1.1) - ((p.1.2 : E2), gq.1 p.1.2))) := by
      rw [hI]
      apply intervalIntegral.integral_congr
      intro t ht
      rw [Set.uIcc_of_le zero_le_one] at ht
      have h' : ((ι0 t : Set.Icc (0 : ℝ) 1) : ℝ) = t := by
        rw [show ι0 t = ⟨t, ht⟩ from Set.projIcc_of_mem _ ht]
      show N' (Γ gq.1) (p.1, ι0 t) = _
      rw [hN'v _ (hU gq hgq) (p.1, ι0 t), hseg]
      dsimp only
      rw [h']
    have hpair : (Dα p, gq.2 p) = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ •
        (((p.1.1 : E2), gq.1 p.1.1) - ((p.1.2 : E2), gq.1 p.1.2)) := by
      rw [hq p, Prod.mk_sub_mk, Prod.smul_mk]
      rfl
    show M (I (N' (Γ gq.1))) (P (Dα, gq.2)) p = _
    rw [e1, hint, hpair, ContinuousLinearMap.map_smul,
      hftc _ _ (fun t ht => hconv _ (hgq p.1.2) _ (hgq p.1.1) p.1.2.2 p.1.1.2 t ht)]

theorem pcr_loc_nemytskii_smooth (c : E2) (ρ : ℝ) (hρ : 0 < ρ) (W : Set E2) (hW : IsOpen W)
    (hKW : Metric.closedBall c ρ ⊆ W) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (s : ℝ) (hs : 0 < s)
    (Ψ : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ)
    (hΨ : ContDiffOn ℝ ∞ Ψ {z | z.1 ∈ W ∧ |z.2.1| < s}) (k : ℕ)
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    (T : E' →L[ℝ] pcrLocAmb c ρ (k + 2))
    (hT : ∀ e : E', ∃ w : E2 → ℝ, pcrHolLoc α (k + 2) w W ∧ pcrLocRel c ρ α (k + 2) w (T e)) :
    ∃ N : E' → pcrLocAmb c ρ k,
      ContDiffOn ℝ ∞ N {e | ‖(T e ⟨0, by omega⟩).1‖ < s} ∧
      ∀ e : E', ‖(T e ⟨0, by omega⟩).1‖ < s → ∀ w : E2 → ℝ,
        pcrHolLoc α (k + 2) w W → pcrLocRel c ρ α (k + 2) w (T e) →
        pcrLocRel c ρ α k (fun x => Ψ (x, w x, fderiv ℝ w x, fderiv ℝ (fderiv ℝ w) x)) (N e) :=
by
  set_option synthInstance.maxHeartbeats 400000 in
  classical
  haveI hKc : CompactSpace (Metric.closedBall c ρ) :=
    isCompact_iff_compactSpace.mp (isCompact_closedBall c ρ)
  
  obtain ⟨O, hOdef⟩ : ∃ O : Set (E2 × (∀ r : Fin (k + 2 + 1),
      ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)),
      O = {z | z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s} := ⟨_, rfl⟩
  have hmemO : ∀ z, z ∈ O ↔ z.1 ∈ W ∧ ‖z.2 ⟨0, by omega⟩‖ < s := by
    intro z; rw [hOdef]; rfl
  have hO : IsOpen O := by
    rw [hOdef]
    exact (hW.preimage continuous_fst).inter
      (isOpen_lt ((continuous_apply _).comp continuous_snd).norm continuous_const)
  have hconv : ∀ a ∈ O, ∀ b ∈ O, a.1 ∈ Metric.closedBall c ρ → b.1 ∈ Metric.closedBall c ρ →
      ∀ t ∈ Set.Icc (0 : ℝ) 1, a + t • (b - a) ∈ O := by
    intro a ha b hb ha1 hb1 t ht
    rw [hmemO] at ha hb ⊢
    refine ⟨hKW ((convex_closedBall c ρ).add_smul_sub_mem ha1 hb1 ht), ?_⟩
    have h := (convex_ball (0 : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => E2) ℝ) s).add_smul_sub_mem
      (mem_ball_zero_iff.mpr ha.2) (mem_ball_zero_iff.mpr hb.2) ht
    exact mem_ball_zero_iff.mp h
  
  have hFl : ∀ l : Fin (k + 1), ∃ Fl : E2 × (∀ r : Fin (k + 2 + 1),
      ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
        ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ,
      ContDiffOn ℝ ∞ Fl O ∧
      ∀ (w : E2 → ℝ) (U : Set E2), IsOpen U → U ⊆ W →
        ContDiffOn ℝ ((l : ℕ) + 2 : ℕ) w U → (∀ x ∈ U, |w x| < s) →
        ∀ x ∈ U, Fl (x, fun r => iteratedFDeriv ℝ r w x) =
          iteratedFDeriv ℝ l (fun y => Ψ (y, w y, fderiv ℝ w y, fderiv ℝ (fderiv ℝ w) y)) x := by
    intro l
    obtain ⟨Φl, hΦs, hΦr⟩ := pcr_nem_jet_formula W hW s Ψ hΨ (l : ℕ)
    let prl : (∀ r : Fin (k + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →L[ℝ]
        (∀ r : Fin ((l : ℕ) + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) :=
      ContinuousLinearMap.pi fun r =>
        ContinuousLinearMap.proj (R := ℝ)
          (φ := fun r : Fin (k + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
          (Fin.castLE (by have := l.isLt; omega) r)
    refine ⟨fun z => Φl (z.1, prl z.2), ?_, ?_⟩
    · refine hΦs.comp (contDiff_fst.prodMk (prl.contDiff.comp contDiff_snd)).contDiffOn ?_
      intro z hz
      rw [hmemO] at hz
      exact And.intro hz.1 hz.2
    · intro w U hU hUW hwU hws x hx
      exact (hΦr w U hU hUW hwU hws x hx).symm
  choose Fl hFls hFlr using hFl
  
  obtain ⟨-, -, Lp, hLp⟩ := pcr_nem_bcf_linear (Z := ↥(Metric.closedBall c ρ)) (A := ℝ) (B := ℝ)
    (ι := Fin (k + 2 + 1))
    (Fi := fun r : Fin (k + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
  obtain ⟨-, -, Lq, hLq⟩ := pcr_nem_bcf_linear
    (Z := {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}) (A := ℝ) (B := ℝ)
    (ι := Fin (k + 2 + 1))
    (Fi := fun r : Fin (k + 2 + 1) => ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)
  let Tv : E' →L[ℝ] (∀ r : Fin (k + 2 + 1), BoundedContinuousFunction (Metric.closedBall c ρ)
      (ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)) :=
    { toFun := fun e r => (T e r).1
      map_add' := fun a b => by
        funext r
        show (T (a + b) r).1 = (T a r).1 + (T b r).1
        rw [map_add]; rfl
      map_smul' := fun a b => by
        funext r
        show (T (a • b) r).1 = a • (T b r).1
        rw [map_smul]; rfl
      cont := continuous_pi fun r => continuous_fst.comp ((continuous_apply r).comp T.continuous) }
  let Tq : E' →L[ℝ] (∀ r : Fin (k + 2 + 1),
      BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}
      (ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ)) :=
    { toFun := fun e r => (T e r).2
      map_add' := fun a b => by
        funext r
        show (T (a + b) r).2 = (T a r).2 + (T b r).2
        rw [map_add]; rfl
      map_smul' := fun a b => by
        funext r
        show (T (a • b) r).2 = a • (T b r).2
        rw [map_smul]; rfl
      cont := continuous_pi fun r => continuous_snd.comp ((continuous_apply r).comp T.continuous) }
  let Jm : E' →L[ℝ] BoundedContinuousFunction (Metric.closedBall c ρ)
      (∀ r : Fin (k + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) := Lp.comp Tv
  let Qm : E' →L[ℝ]
      BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}
      (∀ r : Fin (k + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) := Lq.comp Tq
  have hJm : ∀ (e : E') (x : Metric.closedBall c ρ) (r : Fin (k + 2 + 1)),
      Jm e x r = (T e r).1 x := fun e x r => hLp (Tv e) x r
  have hQm : ∀ (e : E') (p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2})
      (r : Fin (k + 2 + 1)), Qm e p r = (T e r).2 p := fun e p r => hLq (Tq e) p r
  have hJmO : ∀ e ∈ {e : E' | ‖(T e ⟨0, by omega⟩).1‖ < s}, ∀ x : Metric.closedBall c ρ,
      ((x : E2), Jm e x) ∈ O := by
    intro e he x
    rw [hmemO]
    refine ⟨hKW x.2, ?_⟩
    show ‖Jm e x ⟨0, by omega⟩‖ < s
    rw [hJm e x]
    exact lt_of_le_of_lt (BoundedContinuousFunction.norm_coe_le_norm _ _) he
  
  have hS2 : ∀ l : Fin (k + 1), ∃ Nv : BoundedContinuousFunction (Metric.closedBall c ρ)
      (∀ r : Fin (k + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ) →
      BoundedContinuousFunction (Metric.closedBall c ρ)
        (ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ),
      ContDiffOn ℝ ∞ Nv {g | ∀ z : Metric.closedBall c ρ, ((z : E2), g z) ∈ O} ∧
      ∀ g : BoundedContinuousFunction (Metric.closedBall c ρ)
          (∀ r : Fin (k + 2 + 1), ContinuousMultilinearMap ℝ (fun _ : Fin r => E2) ℝ),
        (∀ z : Metric.closedBall c ρ, ((z : E2), g z) ∈ O) →
        ∀ z : Metric.closedBall c ρ, Nv g z = Fl l ((z : E2), g z) :=
    fun l => (pcr_nem_omega (⟨Subtype.val, continuous_subtype_val⟩ : C(Metric.closedBall c ρ, E2))
      O hO (Fl l) (hFls l)).2
  choose Nv hNvs hNvv using hS2
  have hS4 := fun l : Fin (k + 1) =>
    pcr_nem_holder_omega c ρ hρ α hα0 hα1 O hO (Fl l) (hFls l) hconv
  choose Nq hNqs hNqv using hS4
  refine ⟨fun e => ((fun l => (Nv l (Jm e), Nq l (Jm e, Qm e))) : pcrLocAmb c ρ k), ?_, ?_⟩
  · have h : ∀ l : Fin (k + 1), ContDiffOn ℝ ∞ (fun e => (Nv l (Jm e), Nq l (Jm e, Qm e)))
        {e : E' | ‖(T e ⟨0, by omega⟩).1‖ < s} := by
      intro l
      have hJs : ContDiff ℝ ∞ Jm := by fun_prop
      have hQs : ContDiff ℝ ∞ Qm := by fun_prop
      refine ContDiffOn.prodMk ?_ ?_
      · exact (hNvs l).comp hJs.contDiffOn (fun e he => hJmO e he)
      · exact (hNqs l).comp (hJs.prodMk hQs).contDiffOn (fun e he => hJmO e he)
    exact (contDiffOn_pi (F' := fun l : Fin (k + 1) =>
      BoundedContinuousFunction (Metric.closedBall c ρ)
        (ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) ×
      BoundedContinuousFunction {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2}
        (ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ))).2 h
  · intro e he w hw hr l
    have hwK : ∀ x : Metric.closedBall c ρ, |w x| < s := by
      intro x
      have h1 : ‖(T e ⟨0, by omega⟩).1 x‖ ≤ ‖(T e ⟨0, by omega⟩).1‖ :=
        BoundedContinuousFunction.norm_coe_le_norm _ _
      have h2 : ‖(T e ⟨0, by omega⟩).1 x‖ = |w x| := by
        rw [(hr ⟨0, by omega⟩).1 x]
        exact (norm_iteratedFDeriv_zero).trans (Real.norm_eq_abs _)
      have h3 : ‖(T e ⟨0, by omega⟩).1‖ < s := he
      linarith
    have hUo : IsOpen (W ∩ w ⁻¹' Set.Ioo (-s) s) :=
      hw.1.continuousOn.isOpen_inter_preimage hW isOpen_Ioo
    have hJw : ∀ x : Metric.closedBall c ρ,
        Jm e x = fun r : Fin (k + 2 + 1) => iteratedFDeriv ℝ (r : ℕ) w x :=
      fun x => funext fun r => (hJm e x r).trans ((hr r).1 x)
    have hval : ∀ x : Metric.closedBall c ρ, Fl l ((x : E2), Jm e x) =
        iteratedFDeriv ℝ l (fun y => Ψ (y, w y, fderiv ℝ w y, fderiv ℝ (fderiv ℝ w) y)) x := by
      intro x
      rw [hJw x]
      refine hFlr l w _ hUo Set.inter_subset_left ?_ ?_ x ⟨hKW x.2, ?_⟩
      · exact (hw.1.mono Set.inter_subset_left).of_le
          (by exact_mod_cast (show (l : ℕ) + 2 ≤ k + 2 by have := l.isLt; omega))
      · intro y hy
        exact abs_lt.mpr hy.2
      · exact abs_lt.mp (hwK x)
    refine ⟨fun x => ?_, fun p => ?_⟩
    · show Nv l (Jm e) x = _
      rw [hNvv l (Jm e) (hJmO e he) x]
      exact hval x
    · show Nq l (Jm e, Qm e) p = _
      have hQ : ∀ p : {p : Metric.closedBall c ρ × Metric.closedBall c ρ // p.1 ≠ p.2},
          Qm e p = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ • (Jm e p.1.1 - Jm e p.1.2) := by
        intro p
        funext r
        show Qm e p r = (dist (p.1.1 : E2) (p.1.2 : E2) ^ α)⁻¹ • (Jm e p.1.1 r - Jm e p.1.2 r)
        rw [hQm e p r, (hr r).2 p, hJm, hJm, (hr r).1, (hr r).1]
      rw [hNqv l (Jm e, Qm e) (hJmO e he) hQ p]
      simp only [hval]

theorem pcr_transfer {X : Type*} [TopologicalSpace X] {S : Set X} (P : EigPatchedSurface X S)
    (B : PcrBalls P) (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (k : ℕ)
    (I : Set ℝ) (hI : IsOpen I) (γ : ℝ → pcrSp B α (k + 2)) (hγ : ContDiffOn ℝ ∞ γ I)
    (U : ℝ → X → ℝ)
    (hU : ∀ t, pcrClass P α (k + 2) (U t) ∧ ∀ i, pcrLocRel (B.c i) (B.ρ i) α (k + 2)
      (fun x => U t (P.param (B.j i) x)) ((γ t : pcrAmb B (k + 2)) i))
    (j : Fin P.n) :
    ContDiffOn ℝ k (fun p : ℝ × E2 => U p.1 (P.param j p.2)) (I ×ˢ P.W j) :=
by
  
  have s1 : ∀ {E G : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
      [NormedAddCommGroup G] [NormedSpace ℝ G]
      (Ω : Set E2) (hΩ : IsOpen Ω) (A : E → E2 → G) (D : E → E2 → (E2 →L[ℝ] G))
      (hadd : ∀ (v w : E), ∀ z ∈ Ω, A (v + w) z = A v z + A w z)
      (hsmul : ∀ (a : ℝ) (v : E), ∀ z ∈ Ω, A (a • v) z = a • A v z)
      (hA : ∀ (v : E), ∀ z ∈ Ω, ‖A v z‖ ≤ ‖v‖)
      (hD : ∀ (v : E), ∀ z ∈ Ω, ‖D v z‖ ≤ ‖v‖)
      (hder : ∀ (v : E), ∀ z ∈ Ω, HasFDerivAt (A v) (D v z) z)
      (c : ℝ → E) (c' : E) (t : ℝ) (hc : HasDerivAt c c' t) (z : E2) (hz : z ∈ Ω),
      HasFDerivAt (fun p : ℝ × E2 => A (c p.1) p.2)
        ((ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A c' z) +
          (D (c t) z).comp (ContinuousLinearMap.snd ℝ ℝ E2)) (t, z) := by
    intro E G _ _ _ _ Ω hΩ A D hadd hsmul hA hD hder c c' t hc z hz
    rw [hasFDerivAt_iff_isLittleO_nhds_zero]
    refine Asymptotics.IsLittleO.of_bound fun ε hε => ?_
    have hε3 : 0 < ε / 3 := by positivity
    have h1 : ∀ᶠ d in 𝓝 (0 : E2), ‖A (c t) (z + d) - A (c t) z - D (c t) z d‖ ≤ ε / 3 * ‖d‖ :=
      (hasFDerivAt_iff_isLittleO_nhds_zero.1 (hder (c t) z hz)).def hε3
    have h2 : ∀ᶠ s in 𝓝 (0 : ℝ), ‖c (t + s) - c t - s • c'‖ ≤ ε / 3 * ‖s‖ :=
      (hasDerivAt_iff_isLittleO_nhds_zero.1 hc).def hε3
    have hct : Tendsto (fun s : ℝ => c (t + s) - c t) (𝓝 0) (𝓝 0) := by
      have h : ContinuousAt (fun s : ℝ => c (t + s) - c t) 0 :=
        (hc.continuousAt.comp_of_eq ((continuous_const.add continuous_id).continuousAt)
          (by simp)).sub continuousAt_const
      simpa using h.tendsto
    have h3 : ∀ᶠ s in 𝓝 (0 : ℝ), ‖c (t + s) - c t‖ < ε / 3 := by
      filter_upwards [Metric.tendsto_nhds.1 hct (ε / 3) hε3] with s hs
      simpa using hs
    obtain ⟨δ, hδ, hδΩ⟩ := Metric.isOpen_iff.1 hΩ z hz
    have h4 : ∀ᶠ d in 𝓝 (0 : E2), z + d ∈ ball z δ := by
      filter_upwards [Metric.ball_mem_nhds (0 : E2) hδ] with d hd
      rw [mem_ball, dist_eq_norm, add_sub_cancel_left]
      simpa using hd
    have hfst : Tendsto (fun p : ℝ × E2 => p.1) (𝓝 0) (𝓝 0) := by
      simpa using (continuous_fst.tendsto (0 : ℝ × E2))
    have hsnd : Tendsto (fun p : ℝ × E2 => p.2) (𝓝 0) (𝓝 0) := by
      simpa using (continuous_snd.tendsto (0 : ℝ × E2))
    filter_upwards [hfst.eventually h2, hfst.eventually h3, hsnd.eventually h1,
      hsnd.eventually h4] with p hp2 hp3 hp1 hp4
    obtain ⟨s, d⟩ := p
    simp only at hp2 hp3 hp1 hp4
    have hzd : z + d ∈ Ω := hδΩ hp4
    have hs_le : ‖s‖ ≤ ‖(s, d)‖ := norm_fst_le (s, d)
    have hd_le : ‖d‖ ≤ ‖(s, d)‖ := norm_snd_le (s, d)
    have e1 : A (c (t + s)) (z + d) = A (c t) (z + d) + A (c (t + s) - c t) (z + d) := by
      rw [← hadd _ _ _ hzd, add_sub_cancel]
    have e2 : A (c (t + s) - c t) z = A (c (t + s) - c t - s • c') z + s • A c' z := by
      rw [← hsmul _ _ _ hz, ← hadd _ _ _ hz, sub_add_cancel]
    have key : A (c ((t, z) + (s, d)).1) ((t, z) + (s, d)).2 - A (c (t, z).1) (t, z).2 -
        ((ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A c' z) +
          (D (c t) z).comp (ContinuousLinearMap.snd ℝ ℝ E2)) (s, d) =
        (A (c t) (z + d) - A (c t) z - D (c t) z d) +
          (A (c (t + s) - c t) (z + d) - A (c (t + s) - c t) z) +
          A (c (t + s) - c t - s • c') z := by
      simp only [Prod.mk_add_mk, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.coe_fst',
        ContinuousLinearMap.comp_apply, ContinuousLinearMap.coe_snd']
      rw [e1, e2]
      abel
    have hT2 : ‖A (c (t + s) - c t) (z + d) - A (c (t + s) - c t) z‖ ≤
        ‖c (t + s) - c t‖ * ‖(z + d) - z‖ := by
      refine (convex_ball z δ).norm_image_sub_le_of_norm_hasFDerivWithin_le
        (f' := D (c (t + s) - c t)) (fun y hy => (hder _ y (hδΩ hy)).hasFDerivWithinAt)
        (fun y hy => hD _ y (hδΩ hy)) (mem_ball_self hδ) hp4
    rw [add_sub_cancel_left] at hT2
    have hT3 : ‖A (c (t + s) - c t - s • c') z‖ ≤ ‖c (t + s) - c t - s • c'‖ := hA _ z hz
    rw [key]
    calc _ ≤ ‖A (c t) (z + d) - A (c t) z - D (c t) z d‖ +
          ‖A (c (t + s) - c t) (z + d) - A (c (t + s) - c t) z‖ +
          ‖A (c (t + s) - c t - s • c') z‖ := norm_add₃_le
      _ ≤ ε / 3 * ‖(s, d)‖ + ε / 3 * ‖(s, d)‖ + ε / 3 * ‖(s, d)‖ := by
          gcongr
          · exact hp1.trans (by gcongr)
          · exact hT2.trans (mul_le_mul hp3.le hd_le (norm_nonneg _) hε3.le)
          · exact hT3.trans (hp2.trans (by gcongr))
      _ = ε * ‖(s, d)‖ := by ring
  
  have s2 : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
      (Ω : Set E2) (hΩ : IsOpen Ω) (n : ℕ)
      (A : (l : ℕ) → E → E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ)
      (hjoint : ∀ l, l < n → ∀ (c : ℝ → E) (c' : E) (t : ℝ) (y : E2),
        HasDerivAt c c' t → y ∈ Ω →
        HasFDerivAt (fun p : ℝ × E2 => A l (c p.1) p.2)
          ((ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A l c' y) +
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (A (l + 1) (c t) y)).comp (ContinuousLinearMap.snd ℝ ℝ E2)) (t, y))
      (r : ℕ) (c : ℝ → E) (hc : ContDiffOn ℝ ∞ c I) (l : ℕ) (hlr : l + r < n),
      ContDiffOn ℝ r (fun p : ℝ × E2 => A l (c p.1) p.2) (I ×ˢ Ω) := by
    intro E _ _ Ω hΩ n A hjoint r
    induction r with
    | zero =>
      intro c hc l hlr
      have hd : ∀ t ∈ I, HasDerivAt c (deriv c t) t := fun t ht =>
        ((hc.differentiableOn (by simp)) t ht).differentiableAt (hI.mem_nhds ht) |>.hasDerivAt
      rw [Nat.cast_zero, contDiffOn_zero]
      intro p hp
      exact (hjoint l (by omega) c _ p.1 p.2 (hd p.1 hp.1) hp.2).continuousAt.continuousWithinAt
    | succ r ih =>
      intro c hc l hlr
      obtain ⟨hcd, hc'⟩ := (contDiffOn_infty_iff_deriv_of_isOpen hI).1 hc
      have hd : ∀ t ∈ I, HasDerivAt c (deriv c t) t := fun t ht =>
        (hcd t ht).differentiableAt (hI.mem_nhds ht) |>.hasDerivAt
      have hF : ∀ p ∈ I ×ˢ Ω, HasFDerivAt (fun p : ℝ × E2 => A l (c p.1) p.2)
          ((ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A l (deriv c p.1) p.2) +
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (A (l + 1) (c p.1) p.2)).comp (ContinuousLinearMap.snd ℝ ℝ E2)) p :=
        fun p hp => hjoint l (by omega) c _ p.1 p.2 (hd p.1 hp.1) hp.2
      have hopen : IsOpen (I ×ˢ Ω) := hI.prod hΩ
      rw [Nat.cast_succ, contDiffOn_succ_iff_fderiv_of_isOpen hopen]
      refine ⟨fun p hp => (hF p hp).differentiableAt.differentiableWithinAt, ?_, ?_⟩
      · intro h
        exact absurd h (by simp)
      · have h1 := ih (deriv c) hc' l (by omega)
        have h2 := ih c hc (l + 1) (by omega)
        have hΛ : ContDiffOn ℝ r (fun p : ℝ × E2 =>
            (ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A l (deriv c p.1) p.2) +
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (A (l + 1) (c p.1) p.2)).comp (ContinuousLinearMap.snd ℝ ℝ E2)) (I ×ˢ Ω) := by
          refine (contDiffOn_const.smulRight h1).add ?_
          have hcL : ContDiff ℝ r
              (fun x : ContinuousMultilinearMap ℝ (fun _ : Fin (l + 1) => E2) ℝ =>
                continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ x) := by
            apply LinearIsometryEquiv.contDiff
          have h3 : ContDiffOn ℝ r (fun p : ℝ × E2 =>
              continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
                (A (l + 1) (c p.1) p.2)) (I ×ˢ Ω) :=
            hcL.comp_contDiffOn h2
          exact h3.clm_comp contDiffOn_const
        exact hΛ.congr fun p hp => (hF p hp).fderiv
  
  have s3 : ∀ (c : E2) (ρ : ℝ) (m : ℕ) (U' : Set E2), IsOpen U' → Metric.closedBall c ρ ⊆ U' →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ m w U' → ∀ (h : pcrLocAmb c ρ m), pcrLocRel c ρ α m w h →
      ∀ (l : ℕ) (hl : l + 1 < m + 1) (z : E2) (hz : z ∈ Metric.ball c ρ),
      HasFDerivAt (fun z' : E2 => if hz' : dist z' c ≤ ρ then (h ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
          ((h ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩)) z := by
    intro c ρ m U' hU' hKU w hw h hrel l hl z hz
    have hzU : z ∈ U' := hKU (Metric.ball_subset_closedBall hz)
    have hcd : ContDiffAt ℝ m w z := hw.contDiffAt (hU'.mem_nhds hzU)
    have hdiff : DifferentiableAt ℝ (iteratedFDeriv ℝ l w) z :=
      hcd.differentiableAt_iteratedFDeriv (by exact_mod_cast (by omega : l < m))
    have heq : (fun z' : E2 => if hz' : dist z' c ≤ ρ then (h ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0)
        =ᶠ[𝓝 z] iteratedFDeriv ℝ l w := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hz] with z' hz'
      have hd : dist z' c ≤ ρ := le_of_lt hz'
      rw [dif_pos hd]
      exact (hrel ⟨l, by omega⟩).1 ⟨z', hd⟩
    have hD : continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
          ((h ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) =
        fderiv ℝ (iteratedFDeriv ℝ l w) z := by
      rw [(hrel ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩]
      show continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
        (iteratedFDeriv ℝ (l + 1) w z) = _
      rw [iteratedFDeriv_succ_eq_comp_left]
      simp
    rw [hD]
    exact hdiff.hasFDerivAt.congr_of_eventuallyEq heq
  
  have Pa : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S ∧ P.param j x ∈ P.O j := by
    intro j x hx
    have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq] at h
    exact ⟨h.2, h.1⟩
  have s4 : ∀ x₀ ∈ P.W j, ∃ (i : Fin B.N) (Ω' : Set E2), IsOpen Ω' ∧ x₀ ∈ Ω' ∧ Ω' ⊆ P.W j ∧
      ContDiffOn ℝ ∞ (fun x => P.proj (B.j i) (P.param j x)) Ω' ∧
      (∀ x ∈ Ω', P.proj (B.j i) (P.param j x) ∈ Metric.ball (B.c i) (B.ρ i)) ∧
      ∀ x ∈ Ω', P.param (B.j i) (P.proj (B.j i) (P.param j x)) = P.param j x := by
    intro x₀ hx₀
    obtain ⟨i, y₀, hy₀, hq⟩ := B.cover _ (Pa j x₀ hx₀).1
    have hy₀W : y₀ ∈ P.W (B.j i) := B.sub i (Metric.ball_subset_closedBall hy₀)
    have hqO : P.param j x₀ ∈ P.O (B.j i) := by rw [← hq]; exact (Pa _ y₀ hy₀W).2
    have hΩ₀ : IsOpen (P.W j ∩ P.param j ⁻¹' P.O (B.j i)) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open _)
    have hτ := P.trans_smooth j (B.j i)
    refine ⟨i, (P.W j ∩ P.param j ⁻¹' P.O (B.j i)) ∩
        (fun x => P.proj (B.j i) (P.param j x)) ⁻¹' Metric.ball (B.c i) (B.ρ i),
      hτ.continuousOn.isOpen_inter_preimage hΩ₀ Metric.isOpen_ball, ⟨⟨hx₀, hqO⟩, ?_⟩,
      fun x hx => hx.1.1, hτ.mono Set.inter_subset_left, fun x hx => hx.2, ?_⟩
    · show P.proj (B.j i) (P.param j x₀) ∈ Metric.ball (B.c i) (B.ρ i)
      rw [← hq, P.proj_param _ y₀ hy₀W]
      exact hy₀
    · intro x hx
      have hmem : P.param j x ∈ P.param (B.j i) '' P.W (B.j i) := by
        rw [P.image_eq]
        exact ⟨hx.1.2, (Pa j x hx.1.1).1⟩
      obtain ⟨x', hx', hpx⟩ := hmem
      rw [← hpx, P.proj_param _ x' hx']
  
  have s5 : ∀ i : Fin B.N, ContDiffOn ℝ k (fun p : ℝ × E2 => U p.1 (P.param (B.j i) p.2))
      (I ×ˢ Metric.ball (B.c i) (B.ρ i)) := by
    intro i
    obtain ⟨A, hA⟩ : ∃ A : (l : ℕ) → pcrSp B α (k + 2) → E2 →
        ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ, ∀ l v z, A l v z =
          if hl : l < k + 2 + 1 then
            (if hz : dist z (B.c i) ≤ B.ρ i then
              (((v : pcrAmb B (k + 2)) i) ⟨l, hl⟩).1 ⟨z, hz⟩ else 0) else 0 :=
      ⟨_, fun _ _ _ => rfl⟩
    have hAe : ∀ l (hl : l < k + 2 + 1) (v : pcrSp B α (k + 2)) z (hz : dist z (B.c i) ≤ B.ρ i),
        A l v z = (((v : pcrAmb B (k + 2)) i) ⟨l, hl⟩).1 ⟨z, hz⟩ := by
      intro l hl v z hz
      rw [hA, dif_pos hl, dif_pos hz]
    have hAb : ∀ l (hl : l < k + 2 + 1) (v : pcrSp B α (k + 2)) z (hz : dist z (B.c i) ≤ B.ρ i),
        ‖A l v z‖ ≤ ‖v‖ := by
      intro l hl v z hz
      rw [hAe l hl v z hz]
      calc _ ≤ ‖(((v : pcrAmb B (k + 2)) i) ⟨l, hl⟩).1‖ :=
            BoundedContinuousFunction.norm_coe_le_norm _ _
        _ ≤ ‖((v : pcrAmb B (k + 2)) i) ⟨l, hl⟩‖ := norm_fst_le _
        _ ≤ ‖(v : pcrAmb B (k + 2)) i‖ := norm_le_pi_norm ((v : pcrAmb B (k + 2)) i) _
        _ ≤ ‖(v : pcrAmb B (k + 2))‖ := norm_le_pi_norm (v : pcrAmb B (k + 2)) i
        _ = ‖v‖ := rfl
    have hgen : ∀ g ∈ pcrSp B α (k + 2), ∀ (l : ℕ) (hl : l + 1 < k + 2 + 1) (z : E2)
        (hz : z ∈ Metric.ball (B.c i) (B.ρ i)),
        HasFDerivAt (fun z' : E2 => if hz' : dist z' (B.c i) ≤ B.ρ i then
            ((g : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0)
          (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
            (((g : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1
              ⟨z, Metric.ball_subset_closedBall hz⟩)) z := by
      intro g hg
      induction hg using Submodule.span_induction with
      | mem g hg =>
        obtain ⟨u, hu, hr⟩ := hg
        intro l hl z hz
        exact s3 (B.c i) (B.ρ i) (k + 2) (P.W (B.j i)) (P.W_open _) (B.sub i)
          (fun x => u (P.param (B.j i) x)) (hu.2 (B.j i)).1 (g i) (hr i) l hl z hz
      | zero =>
        intro l hl z hz
        have e : ((fun z' : E2 => if hz' : dist z' (B.c i) ≤ B.ρ i then
            ((0 : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
              E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) = fun _ => 0 := by
          funext z'
          split_ifs <;> rfl
        have hd : continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
            (((0 : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) = 0 := by
          rw [← LinearIsometryEquiv.map_zero
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ)]
          rfl
        rw [e, hd]
        exact hasFDerivAt_const _ _
      | add g g' _ _ ihg ihg' =>
        intro l hl z hz
        have e : ((fun z' : E2 => if hz' : dist z' (B.c i) ≤ B.ρ i then
            ((g + g' : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
              E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) =
            fun z' => ((if hz' : dist z' (B.c i) ≤ B.ρ i then
              ((g : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
                ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) +
              ((if hz' : dist z' (B.c i) ≤ B.ρ i then
              ((g' : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
                ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) := by
          funext z'
          split_ifs
          · rfl
          · simp
        have hd : continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
            (((g + g' : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) =
            continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (((g : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) +
            continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (((g' : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) := by
          rw [← LinearIsometryEquiv.map_add]
          rfl
        rw [e, hd]
        exact (ihg l hl z hz).add (ihg' l hl z hz)
      | smul a g _ ihg =>
        intro l hl z hz
        have e : ((fun z' : E2 => if hz' : dist z' (B.c i) ≤ B.ρ i then
            ((a • g : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
              E2 → ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) =
            fun z' => a • ((if hz' : dist z' (B.c i) ≤ B.ρ i then
              ((g : pcrAmb B (k + 2)) i ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0) :
                ContinuousMultilinearMap ℝ (fun _ : Fin l => E2) ℝ) := by
          funext z'
          split_ifs
          · rfl
          · simp
        have hd : continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
            (((a • g : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) =
            a • continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (((g : pcrAmb B (k + 2)) i ⟨l + 1, hl⟩).1 ⟨z, Metric.ball_subset_closedBall hz⟩) := by
          rw [← LinearIsometryEquiv.map_smul]
          rfl
        rw [e, hd]
        exact (ihg l hl z hz).const_smul a
    have hjoint : ∀ l, l < k + 2 → ∀ (c : ℝ → pcrSp B α (k + 2)) (c' : pcrSp B α (k + 2))
        (t : ℝ) (y : E2), HasDerivAt c c' t → y ∈ Metric.ball (B.c i) (B.ρ i) →
        HasFDerivAt (fun p : ℝ × E2 => A l (c p.1) p.2)
          ((ContinuousLinearMap.fst ℝ ℝ E2).smulRight (A l c' y) +
            (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
              (A (l + 1) (c t) y)).comp (ContinuousLinearMap.snd ℝ ℝ E2)) (t, y) := by
      intro l hl c c' t y hc hy
      refine s1 (Metric.ball (B.c i) (B.ρ i)) Metric.isOpen_ball (A l)
        (fun v z => continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
          (A (l + 1) v z)) ?_ ?_ ?_ ?_ ?_ c c' t hc y hy
      · intro v w z hz
        rw [hAe l (by omega) _ z (Metric.mem_ball.1 hz).le, hAe l (by omega) _ z (Metric.mem_ball.1 hz).le,
          hAe l (by omega) _ z (Metric.mem_ball.1 hz).le]
        rfl
      · intro a v z hz
        rw [hAe l (by omega) _ z (Metric.mem_ball.1 hz).le, hAe l (by omega) _ z (Metric.mem_ball.1 hz).le]
        rfl
      · intro v z hz
        exact hAb l (by omega) v z (Metric.mem_ball.1 hz).le
      · intro v z hz
        rw [LinearIsometryEquiv.norm_map]
        exact hAb (l + 1) (by omega) v z (Metric.mem_ball.1 hz).le
      · intro v z hz
        have hfun : A l v = fun z' : E2 => if hz' : dist z' (B.c i) ≤ B.ρ i then
            (((v : pcrAmb B (k + 2)) i) ⟨l, by omega⟩).1 ⟨z', hz'⟩ else 0 := by
          funext z'
          rw [hA, dif_pos (show l < k + 2 + 1 by omega)]
        show HasFDerivAt (A l v) (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (l + 1) => E2) ℝ
          (A (l + 1) v z)) z
        rw [hfun, hAe (l + 1) (by omega) v z (Metric.mem_ball.1 hz).le]
        exact hgen (v : pcrAmb B (k + 2)) v.2 l (by omega) z hz
    have hs2 := s2 (Metric.ball (B.c i) (B.ρ i)) Metric.isOpen_ball (k + 2) A hjoint k
      (fun t => γ t) hγ 0 (by omega)
    have heval : ∀ t, ∀ z ∈ Metric.ball (B.c i) (B.ρ i),
        U t (P.param (B.j i) z) = continuousMultilinearCurryFin0 ℝ E2 ℝ (A 0 (γ t) z) := by
      intro t z hz
      rw [hAe 0 (by omega) (γ t) z (Metric.mem_ball.1 hz).le, continuousMultilinearCurryFin0_apply]
      have h1 := congrArg (fun T => T (fun _ => (0 : E2)))
        (((hU t).2 i ⟨0, by omega⟩).1 ⟨z, (Metric.mem_ball.1 hz).le⟩)
      exact (h1.trans (iteratedFDeriv_zero_apply _)).symm
    have hev : ContDiff ℝ k
        (fun T : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => E2) ℝ =>
          continuousMultilinearCurryFin0 ℝ E2 ℝ T) := by
      apply LinearIsometryEquiv.contDiff
    refine (hev.comp_contDiffOn hs2).congr ?_
    rintro ⟨t, z⟩ ⟨_, hz⟩
    exact heval t z hz
  
  refine contDiffOn_of_locally_contDiffOn ?_
  rintro ⟨t₀, x₀⟩ ⟨_, hx₀⟩
  obtain ⟨i, Ω', hΩ'o, hx₀Ω', _, hτ, hτb, hτp⟩ := s4 x₀ hx₀
  refine ⟨Set.univ ×ˢ Ω', isOpen_univ.prod hΩ'o, ⟨Set.mem_univ _, hx₀Ω'⟩, ?_⟩
  have hψ : ContDiffOn ℝ k (fun p : ℝ × E2 => (p.1, P.proj (B.j i) (P.param j p.2)))
      ((I ×ˢ P.W j) ∩ Set.univ ×ˢ Ω') :=
    contDiffOn_fst.prodMk ((hτ.of_le (by exact_mod_cast le_top)).comp contDiffOn_snd
      (fun p hp => hp.2.2))
  have hmaps : Set.MapsTo (fun p : ℝ × E2 => (p.1, P.proj (B.j i) (P.param j p.2)))
      ((I ×ˢ P.W j) ∩ Set.univ ×ˢ Ω') (I ×ˢ Metric.ball (B.c i) (B.ρ i)) :=
    fun p hp => ⟨hp.1.1, hτb _ hp.2.2⟩
  refine ((s5 i).comp hψ hmaps).congr ?_
  rintro ⟨t, x⟩ hp
  show U t (P.param j x) = U t (P.param (B.j i) (P.proj (B.j i) (P.param j x)))
  rw [hτp x hp.2.2]

theorem pcr_holder_scale {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (hSc : IsCompact S) (P : EigPatchedSurface X S)
    (α : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (s₁ : ℝ) (hs₁ : 0 < s₁)
    (Ψ : Fin P.n → E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) → ℝ)
    (hΨ : ∀ j, ContDiffOn ℝ ∞ (Ψ j) {z | z.1 ∈ P.W j ∧ |z.2.1| < s₁})
    (hcompat : ∀ u : X → ℝ, pcrClass P α 2 u → (∀ q ∈ S, |u q| < s₁) →
      ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        Ψ j (x, u (P.param j x), fderiv ℝ (fun x' => u (P.param j x')) x,
            fderiv ℝ (fderiv ℝ (fun x' => u (P.param j x'))) x) =
          Ψ k (P.proj k (P.param j x), u (P.param k (P.proj k (P.param j x))),
            fderiv ℝ (fun x' => u (P.param k x')) (P.proj k (P.param j x)),
            fderiv ℝ (fderiv ℝ (fun x' => u (P.param k x'))) (P.proj k (P.param j x)))) :
    ∃ (B : BanachScale) (evE : ∀ k, B.E k →ₗ[ℝ] (X → ℝ)) (evF : ∀ k, B.F k →ₗ[ℝ] (X → ℝ))
      (Hop : ∀ k, B.E k → B.F k) (r C : ℝ),
      0 < r ∧ 0 ≤ C ∧
      (∀ k, Function.Injective (evE k)) ∧ (∀ k, Function.Injective (evF k)) ∧
      (∀ k (u : X → ℝ), (∃ v, evE k v = u) ↔ pcrClass P α (k + 2) u) ∧
      (∀ k (f : X → ℝ), (∃ g, evF k g = f) ↔ pcrClass P α k f) ∧
      (∀ k v, evE 0 (B.ιE k v) = evE k v) ∧ (∀ k g, evF 0 (B.ιF k g) = evF k g) ∧
      (∀ v, B.ιE 0 v = v) ∧
      (∀ v q, q ∈ S → |evE 0 v q| ≤ C * ‖v‖) ∧
      (∀ k, ContDiffOn ℝ ∞ (Hop k) {v | ‖B.ιE k v‖ < r}) ∧
      (∀ k v, B.ιF k (Hop k v) = Hop 0 (B.ιE k v)) ∧
      (∀ v : B.E 0, ‖v‖ < r → (∀ q ∈ S, |evE 0 v q| < s₁) ∧
        ∀ j, ∀ x ∈ P.W j,
          evF 0 (Hop 0 v) (P.param j x) =
            Ψ j (x, evE 0 v (P.param j x), fderiv ℝ (fun x' => evE 0 v (P.param j x')) x,
              fderiv ℝ (fderiv ℝ (fun x' => evE 0 v (P.param j x'))) x) ∧
          ∀ p : B.E 0, evF 0 (fderiv ℝ (Hop 0) v p) (P.param j x) =
            fderiv ℝ (Ψ j) (x, evE 0 v (P.param j x),
                fderiv ℝ (fun x' => evE 0 v (P.param j x')) x,
                fderiv ℝ (fderiv ℝ (fun x' => evE 0 v (P.param j x'))) x)
              (0, evE 0 p (P.param j x), fderiv ℝ (fun x' => evE 0 p (P.param j x')) x,
                fderiv ℝ (fderiv ℝ (fun x' => evE 0 p (P.param j x'))) x)) ∧
      (∀ (k : ℕ) (I : Set ℝ), IsOpen I → ∀ γ : ℝ → B.E k, ContDiffOn ℝ ∞ γ I →
        ∀ j, ContDiffOn ℝ k (fun p : ℝ × E2 => evE k (γ p.1) (P.param j p.2)) (I ×ˢ P.W j)) :=
by
  classical
  obtain ⟨Bl⟩ := pcr_balls_exist S hSc P
  
  have Pa : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S ∧ P.param j x ∈ P.O j := by
    intro j x hx
    have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq] at h
    exact ⟨h.2, h.1⟩
  
  have hval0 : ∀ (c : E2) (ρ : ℝ) (m : ℕ) (w : E2 → ℝ) (h : pcrLocAmb c ρ m),
      pcrLocRel c ρ α m w h → ∀ x : Metric.closedBall c ρ,
        (h ⟨0, Nat.succ_pos m⟩).1 x (fun _ => 0) = w x := by
    intro c ρ m w h hr x
    have h1 := congrArg (fun T => T (fun _ => (0 : E2))) ((hr ⟨0, Nat.succ_pos m⟩).1 x)
    exact h1.trans (iteratedFDeriv_zero_apply _)
  
  have G1 : ∀ m (g : pcrAmb Bl m) (u : X → ℝ), pcrClass P α m u →
      (∀ i, pcrLocRel (Bl.c i) (Bl.ρ i) α m (fun x => u (P.param (Bl.j i) x)) (g i)) →
      pcrEval Bl m g = u := by
    intro m g u hu hrel
    funext q
    simp only [pcrEval, LinearMap.coe_mk, AddHom.coe_mk]
    split_ifs with h
    · exact (hval0 _ _ _ _ _ (hrel h.choose) _).trans
        (congrArg u h.choose_spec.choose_spec.2)
    · have hq : q ∉ S := fun hq => h (Bl.cover q hq)
      exact (hu.1 q hq).symm
  
  have hT0 : ∀ T : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => E2) ℝ,
      ‖T (fun _ => 0)‖ ≤ ‖T‖ := fun T => by simpa using T.le_opNorm (fun _ => 0)
  have hnormB : ∀ m (g : pcrAmb Bl m) (i : Fin Bl.N), ‖(g i ⟨0, Nat.succ_pos m⟩).1‖ ≤ ‖g‖ := by
    intro m g i
    calc ‖(g i ⟨0, Nat.succ_pos m⟩).1‖ ≤ ‖g i ⟨0, Nat.succ_pos m⟩‖ := norm_fst_le _
      _ ≤ ‖g i‖ := norm_le_pi_norm (g i) _
      _ ≤ ‖g‖ := norm_le_pi_norm g i
  have G4 : ∀ m (g : pcrAmb Bl m) (q : X), |pcrEval Bl m g q| ≤ ‖g‖ := by
    intro m g q
    simp only [pcrEval, LinearMap.coe_mk, AddHom.coe_mk]
    split_ifs with h
    · rw [← Real.norm_eq_abs]
      exact (hT0 _).trans ((BoundedContinuousFunction.norm_coe_le_norm _ _).trans
        (hnormB m g h.choose))
    · simp
  
  have G2 : ∀ (c : E2) (ρ : ℝ) (m : ℕ) (w : E2 → ℝ) (h h' : pcrLocAmb c ρ m),
      pcrLocRel c ρ α m w h → pcrLocRel c ρ α m w h' → h = h' := by
    intro c ρ m w h h' hr hr'
    funext l
    refine Prod.ext ?_ ?_
    · exact BoundedContinuousFunction.ext fun x => ((hr l).1 x).trans ((hr' l).1 x).symm
    · exact BoundedContinuousFunction.ext fun p => ((hr l).2 p).trans ((hr' l).2 p).symm
  have G3 : ∀ (c : E2) (ρ : ℝ) (m : ℕ) (O : Set E2), IsOpen O → Metric.closedBall c ρ ⊆ O →
      ∀ (w w' : E2 → ℝ), (∀ x ∈ O, w x = w' x) → ∀ h : pcrLocAmb c ρ m,
        pcrLocRel c ρ α m w h → pcrLocRel c ρ α m w' h := by
    intro c ρ m O hO hK w w' hww' h hr l
    have key : ∀ y ∈ Metric.closedBall c ρ,
        iteratedFDeriv ℝ l w y = iteratedFDeriv ℝ l w' y := fun y hy =>
      (Filter.EventuallyEq.iteratedFDeriv ℝ
        (Filter.eventually_of_mem (hO.mem_nhds (hK hy)) hww') l).eq_of_nhds
    refine ⟨fun x => ((hr l).1 x).trans (key x x.2), fun p => ((hr l).2 p).trans ?_⟩
    rw [key _ p.1.1.2, key _ p.1.2.2]
  
  have hHolCongr : ∀ (m : ℕ) (U : Set E2), IsOpen U → ∀ f f' : E2 → ℝ,
      (∀ x ∈ U, f x = f' x) → pcrHolLoc α m f U → pcrHolLoc α m f' U := by
    intro m U hU f f' hff' hf
    have key : ∀ y ∈ U, iteratedFDeriv ℝ m f' y = iteratedFDeriv ℝ m f y := fun y hy =>
      (Filter.EventuallyEq.iteratedFDeriv ℝ (Filter.eventually_of_mem (hU.mem_nhds hy)
        (fun z hz => (hff' z hz).symm)) m).eq_of_nhds
    refine ⟨hf.1.congr (fun x hx => (hff' x hx).symm), fun x hx => ?_⟩
    obtain ⟨ρ, hρ, hball, C, hC⟩ := hf.2 x hx
    refine ⟨ρ, hρ, hball, C, fun y hy z hz => ?_⟩
    rw [key y (hball hy), key z (hball hz)]
    exact hC y hy z hz
  
  have P1 : ∀ (m m' : ℕ) (h : m ≤ m') (i : Fin Bl.N) (w : E2 → ℝ) (g : pcrAmb Bl m'),
      pcrLocRel (Bl.c i) (Bl.ρ i) α m' w (g i) →
        pcrLocRel (Bl.c i) (Bl.ρ i) α m w (pcrLevelProj Bl h g i) := by
    intro m m' h i w g hr l
    exact hr (Fin.castLE (Nat.succ_le_succ h) l)
  have P2 : ∀ (m m' : ℕ) (h : m ≤ m') (g : pcrAmb Bl m'),
      pcrEval Bl m (pcrLevelProj Bl h g) = pcrEval Bl m' g := by
    intro m m' h g
    rfl
  have P4 : ∀ (m m' : ℕ) (h : m ≤ m') (g : pcrAmb Bl m'), g ∈ pcrSp Bl α m' →
      pcrLevelProj Bl h g ∈ pcrSp Bl α m := by
    intro m m' h g hg
    obtain ⟨u, hu, hr⟩ := (pcr_sp_mem_iff P Bl α m' g).1 hg
    exact (pcr_sp_mem_iff P Bl α m _).2 ⟨u, ⟨hu.1, fun j =>
      pcr_holLoc_mono _ (P.W_open j) α hα0 hα1 m m' h _ (hu.2 j)⟩,
      fun i => P1 m m' h i _ g (hr i)⟩
  have hrep : ∀ m (v : pcrSp Bl α m), ∃ u : X → ℝ, pcrClass P α m u ∧
      (∀ i, pcrLocRel (Bl.c i) (Bl.ρ i) α m (fun x => u (P.param (Bl.j i) x))
        ((v : pcrAmb Bl m) i)) ∧ pcrEval Bl m v = u := by
    intro m v
    obtain ⟨u, hu, hr⟩ := (pcr_sp_mem_iff P Bl α m v).1 v.2
    exact ⟨u, hu, hr, G1 m v u hu hr⟩
  have hVc : ∀ m, CompleteSpace (pcrSp Bl α m) := fun m =>
    (pcr_sp_closed P Bl α hα0 hα1 m).completeSpace_coe
  
  let ιE : ∀ k, pcrSp Bl α (k + 2) →L[ℝ] pcrSp Bl α 2 := fun k =>
    ((pcrLevelProj Bl (show 2 ≤ k + 2 by omega)).comp (pcrSp Bl α (k + 2)).subtypeL).codRestrict
      (pcrSp Bl α 2) (fun v => P4 2 (k + 2) (by omega) (v : pcrAmb Bl (k + 2)) v.2)
  let ιF : ∀ k, pcrSp Bl α k →L[ℝ] pcrSp Bl α 0 := fun k =>
    ((pcrLevelProj Bl (show 0 ≤ k by omega)).comp (pcrSp Bl α k).subtypeL).codRestrict
      (pcrSp Bl α 0) (fun v => P4 0 k (by omega) (v : pcrAmb Bl k) v.2)
  let B : BanachScale :=
    { E := fun k => pcrSp Bl α (k + 2)
      nE := fun _ => inferInstance
      sE := fun _ => inferInstance
      cE := fun k => hVc (k + 2)
      F := fun k => pcrSp Bl α k
      nF := fun _ => inferInstance
      sF := fun _ => inferInstance
      cF := fun k => hVc k
      ιE := ιE
      ιF := ιF }
  let evE : ∀ k, B.E k →ₗ[ℝ] (X → ℝ) := fun k =>
    (pcrEval Bl (k + 2)).comp (pcrSp Bl α (k + 2)).subtype
  let evF : ∀ k, B.F k →ₗ[ℝ] (X → ℝ) := fun k => (pcrEval Bl k).comp (pcrSp Bl α k).subtype
  have hinj : ∀ m (v v' : pcrSp Bl α m), pcrEval Bl m v = pcrEval Bl m v' → v = v' := by
    intro m v v' h
    obtain ⟨u, hu, hr, he⟩ := hrep m v
    obtain ⟨u', hu', hr', he'⟩ := hrep m v'
    have huu : u = u' := he.symm.trans (h.trans he')
    subst huu
    exact Subtype.ext (funext fun i => G2 _ _ _ _ _ _ (hr i) (hr' i))
  have hrange : ∀ m (u : X → ℝ), (∃ v : pcrSp Bl α m, pcrEval Bl m v = u) ↔ pcrClass P α m u := by
    intro m u
    constructor
    · rintro ⟨v, rfl⟩
      obtain ⟨u, hu, -, he⟩ := hrep m v
      rw [he]
      exact hu
    · intro hu
      choose h hh using fun i => pcr_locRel_exists (Bl.c i) (Bl.ρ i) (Bl.ρ_pos i)
        (P.W (Bl.j i)) (P.W_open _) (Bl.sub i) α hα0 hα1 m _ (hu.2 (Bl.j i))
      have hg : (h : pcrAmb Bl m) ∈ pcrSp Bl α m := (pcr_sp_mem_iff P Bl α m h).2 ⟨u, hu, hh⟩
      exact ⟨⟨h, hg⟩, G1 m h u hu hh⟩
  have hιE0 : ∀ v : pcrSp Bl α 2, ιE 0 v = v := fun v => Subtype.ext rfl
  have hext : ∀ m (g g' : pcrAmb Bl m), (∀ i, g i = g' i) → g = g' := fun m g g' h => funext h
  
  let projI : ∀ m (i : Fin Bl.N), pcrAmb Bl m →L[ℝ] pcrLocAmb (Bl.c i) (Bl.ρ i) m := fun m i =>
    { toFun := fun g => g i
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      cont := continuous_apply i }
  let T : ∀ k (i : Fin Bl.N), pcrSp Bl α (k + 2) →L[ℝ] pcrLocAmb (Bl.c i) (Bl.ρ i) (k + 2) :=
    fun k i => (projI (k + 2) i).comp (pcrSp Bl α (k + 2)).subtypeL
  have hT : ∀ k i (e : pcrSp Bl α (k + 2)), ∃ w : E2 → ℝ, pcrHolLoc α (k + 2) w (P.W (Bl.j i)) ∧
      pcrLocRel (Bl.c i) (Bl.ρ i) α (k + 2) w (T k i e) := by
    intro k i e
    obtain ⟨u, hu, hr, -⟩ := hrep (k + 2) e
    exact ⟨_, hu.2 (Bl.j i), hr i⟩
  choose N hNs hNrel using fun k i => pcr_loc_nemytskii_smooth (Bl.c i) (Bl.ρ i) (Bl.ρ_pos i)
    (P.W (Bl.j i)) (P.W_open _) (Bl.sub i) α hα0 hα1 s₁ hs₁ (Ψ (Bl.j i)) (hΨ (Bl.j i)) k
    (T k i) (hT k i)
  have hD : ∀ k (v : pcrSp Bl α (k + 2)) i,
      ‖(T k i v ⟨0, by omega⟩).1‖ ≤ ‖ιE k v‖ := fun k v i =>
    hnormB 2 (ιE k v : pcrAmb Bl 2) i
  have hDopen : ∀ j, IsOpen {z : E2 × ℝ × (E2 →L[ℝ] ℝ) × (E2 →L[ℝ] E2 →L[ℝ] ℝ) |
      z.1 ∈ P.W j ∧ |z.2.1| < s₁} := fun j =>
    ((P.W_open j).preimage continuous_fst).inter
      (isOpen_lt (continuous_abs.comp (continuous_fst.comp continuous_snd)) continuous_const)
  
  obtain ⟨Gl, hGl⟩ : ∃ Gl : (X → ℝ) → X → ℝ, ∀ u q, Gl u q =
      if h : ∃ j', q ∈ S ∧ q ∈ P.O j' then
        Ψ h.choose (P.proj h.choose q, u (P.param h.choose (P.proj h.choose q)),
          fderiv ℝ (fun x' => u (P.param h.choose x')) (P.proj h.choose q),
          fderiv ℝ (fderiv ℝ (fun x' => u (P.param h.choose x'))) (P.proj h.choose q))
      else 0 := ⟨_, fun _ _ => rfl⟩
  have H1 : ∀ u : X → ℝ, pcrClass P α 2 u → (∀ q ∈ S, |u q| < s₁) → ∀ j, ∀ x ∈ P.W j,
      Gl u (P.param j x) = Ψ j (x, u (P.param j x), fderiv ℝ (fun x' => u (P.param j x')) x,
        fderiv ℝ (fderiv ℝ (fun x' => u (P.param j x'))) x) := by
    intro u hu hus j x hx
    have hex : ∃ j', P.param j x ∈ S ∧ P.param j x ∈ P.O j' := ⟨j, Pa j x hx⟩
    rw [hGl, dif_pos hex]
    exact (hcompat u hu hus j hex.choose x ⟨hx, hex.choose_spec.2⟩).symm
  
  have hM : ∀ k (v : pcrSp Bl α (k + 2)), ‖ιE k v‖ < s₁ → ∀ u : X → ℝ, pcrClass P α (k + 2) u →
      (∀ i, pcrLocRel (Bl.c i) (Bl.ρ i) α (k + 2) (fun x => u (P.param (Bl.j i) x))
        ((v : pcrAmb Bl (k + 2)) i)) →
      pcrClass P α k (Gl u) ∧
        ∀ i, pcrLocRel (Bl.c i) (Bl.ρ i) α k (fun x => Gl u (P.param (Bl.j i) x)) (N k i v) := by
    intro k v hv u hu hr
    have he : pcrEval Bl (k + 2) (v : pcrAmb Bl (k + 2)) = u := G1 _ _ u hu hr
    have hus : ∀ q ∈ S, |u q| < s₁ := by
      intro q _
      rw [← he, ← P2 2 (k + 2) (by omega) (v : pcrAmb Bl (k + 2))]
      exact lt_of_le_of_lt (G4 2 _ q) hv
    have hu2 : pcrClass P α 2 u := ⟨hu.1, fun j =>
      pcr_holLoc_mono _ (P.W_open j) α hα0 hα1 2 (k + 2) (by omega) _ (hu.2 j)⟩
    refine ⟨⟨fun q hq => ?_, fun j => ?_⟩, fun i => ?_⟩
    · rw [hGl, dif_neg]
      rintro ⟨j', hq', -⟩
      exact hq hq'
    · have h4 := pcr_holLoc_jet_comp (P.W j) (P.W_open j) α hα0 hα1 k
        (fun x => u (P.param j x)) (hu.2 j) _ (hDopen j) (Ψ j) (hΨ j)
        (fun x hx => ⟨hx, hus _ (Pa j x hx).1⟩)
      exact hHolCongr k (P.W j) (P.W_open j) _ _ (fun x hx => (H1 u hu2 hus j x hx).symm) h4
    · have h9 := hNrel k i v (lt_of_le_of_lt (hD k v i) hv) (fun x => u (P.param (Bl.j i) x))
        (hu.2 _) (hr i)
      exact G3 _ _ _ (P.W (Bl.j i)) (P.W_open _) (Bl.sub i) _ _
        (fun x hx => (H1 u hu2 hus (Bl.j i) x hx).symm) _ h9
  have hMem : ∀ k (v : pcrSp Bl α (k + 2)), ‖ιE k v‖ < s₁ →
      ((fun i => N k i v : pcrAmb Bl k)) ∈ pcrSp Bl α k := by
    intro k v hv
    obtain ⟨u, hu, hr, -⟩ := hrep (k + 2) v
    exact (pcr_sp_mem_iff P Bl α k _).2 ⟨Gl u, hM k v hv u hu hr⟩
  obtain ⟨Hop, hHop⟩ : ∃ Hop : ∀ k, pcrSp Bl α (k + 2) → pcrSp Bl α k, ∀ k v, Hop k v =
      if h : ‖ιE k v‖ < s₁ then ⟨(fun i => N k i v : pcrAmb Bl k), hMem k v h⟩ else 0 :=
    ⟨_, fun _ _ => rfl⟩
  have hOpen : ∀ k, IsOpen {v : pcrSp Bl α (k + 2) | ‖ιE k v‖ < s₁} := fun k =>
    isOpen_lt ((ιE k).continuous.norm) continuous_const
  
  have hHs : ∀ k, ContDiffOn ℝ ∞ (Hop k) {v : pcrSp Bl α (k + 2) | ‖ιE k v‖ < s₁} := by
    intro k
    haveI := hVc k
    have hN : ContDiffOn ℝ ∞ (fun v => ((fun i => N k i v : pcrAmb Bl k)))
        {v : pcrSp Bl α (k + 2) | ‖ιE k v‖ < s₁} :=
      (contDiffOn_pi (F' := fun i => pcrLocAmb (Bl.c i) (Bl.ρ i) k)).2 fun i =>
        (hNs k i).mono fun v hv => lt_of_le_of_lt (hD k v i) hv
    have hcg : ∀ v ∈ {v : pcrSp Bl α (k + 2) | ‖ιE k v‖ < s₁},
        (pcrSp Bl α k).subtypeₗᵢ (Hop k v) = ((fun i => N k i v : pcrAmb Bl k)) := by
      intro v hv
      have hv' : ‖ιE k v‖ < s₁ := hv
      rw [hHop, dif_pos hv']
      rfl
    exact pcr_contDiffOn_of_isometry_comp (pcrSp Bl α k).subtypeₗᵢ (Hop k) _ (hOpen k)
      (hN.congr hcg)
  
  have hHc : ∀ k (v : pcrSp Bl α (k + 2)), ιF k (Hop k v) = Hop 0 (ιE k v) := by
    intro k v
    by_cases hv : ‖ιE k v‖ < s₁
    · have hv0 : ‖ιE 0 (ιE k v)‖ < s₁ := by rwa [hιE0]
      rw [hHop k v, dif_pos hv, hHop 0 (ιE k v), dif_pos hv0]
      obtain ⟨u, hu, hr, -⟩ := hrep (k + 2) v
      have hu2 : pcrClass P α 2 u := ⟨hu.1, fun j =>
        pcr_holLoc_mono _ (P.W_open j) α hα0 hα1 2 (k + 2) (by omega) _ (hu.2 j)⟩
      have hr2 : ∀ i, pcrLocRel (Bl.c i) (Bl.ρ i) α 2 (fun x => u (P.param (Bl.j i) x))
          ((ιE k v : pcrAmb Bl 2) i) := fun i => P1 2 (k + 2) (by omega) i _ _ (hr i)
      refine Subtype.ext (hext 0 _ _ fun i => ?_)
      have hL := P1 0 k (by omega) i _ (fun i => N k i v) ((hM k v hv u hu hr).2 i)
      have hR := (hM 0 (ιE k v) hv0 u hu2 hr2).2 i
      exact G2 _ _ _ _ _ _ hL hR
    · have hv0 : ¬ ‖ιE 0 (ιE k v)‖ < s₁ := by rwa [hιE0]
      rw [hHop k v, dif_neg hv, hHop 0 (ιE k v), dif_neg hv0, map_zero]
  
  have hValF : ∀ v : pcrSp Bl α 2, ‖v‖ < s₁ → ∀ j, ∀ x ∈ P.W j,
      pcrEval Bl 0 (Hop 0 v : pcrAmb Bl 0) (P.param j x) =
        Ψ j (x, pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x),
          fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x')) x,
          fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x'))) x) := by
    intro v hv j x hx
    have hv' : ‖ιE 0 v‖ < s₁ := by rwa [hιE0]
    obtain ⟨u, hu, hr, he⟩ := hrep 2 v
    have hus : ∀ q ∈ S, |u q| < s₁ := fun q _ => he ▸ lt_of_le_of_lt (G4 2 _ q) hv
    have h1 : pcrEval Bl 0 (Hop 0 v : pcrAmb Bl 0) = Gl u := by
      rw [hHop 0 v, dif_pos hv']
      exact G1 0 _ (Gl u) (hM 0 v hv' u hu hr).1 (hM 0 v hv' u hu hr).2
    rw [h1, he]
    exact H1 u hu hus j x hx
  
  have hjetlin : ∀ (a b : E2 → ℝ) (U : Set E2), IsOpen U → ContDiffOn ℝ (2 : ℕ) a U →
      ContDiffOn ℝ (2 : ℕ) b U → ∀ x ∈ U, ∀ ε : ℝ,
        fderiv ℝ (fun y => a y + ε * b y) x = fderiv ℝ a x + ε • fderiv ℝ b x ∧
        fderiv ℝ (fderiv ℝ (fun y => a y + ε * b y)) x =
          fderiv ℝ (fderiv ℝ a) x + ε • fderiv ℝ (fderiv ℝ b) x := by
    intro a b U hU ha hb x hx ε
    have hda : ∀ y ∈ U, DifferentiableAt ℝ a y := fun y hy =>
      (ha.differentiableOn (by norm_num)).differentiableAt (hU.mem_nhds hy)
    have hdb : ∀ y ∈ U, DifferentiableAt ℝ b y := fun y hy =>
      (hb.differentiableOn (by norm_num)).differentiableAt (hU.mem_nhds hy)
    have h1 : ∀ y ∈ U, fderiv ℝ (fun y => a y + ε * b y) y = fderiv ℝ a y + ε • fderiv ℝ b y :=
      fun y hy => ((hda y hy).hasFDerivAt.add ((hdb y hy).hasFDerivAt.const_mul ε)).fderiv
    have hfa : DifferentiableAt ℝ (fderiv ℝ a) x :=
      ((ha.fderiv_of_isOpen (m := 1) hU (by norm_num)).differentiableOn (by norm_num)).differentiableAt
        (hU.mem_nhds hx)
    have hfb : DifferentiableAt ℝ (fderiv ℝ b) x :=
      ((hb.fderiv_of_isOpen (m := 1) hU (by norm_num)).differentiableOn (by norm_num)).differentiableAt
        (hU.mem_nhds hx)
    refine ⟨h1 x hx, ?_⟩
    have hev : fderiv ℝ (fun y => a y + ε * b y) =ᶠ[𝓝 x]
        fun y => fderiv ℝ a y + ε • fderiv ℝ b y := Filter.eventually_of_mem (hU.mem_nhds hx) h1
    rw [hev.fderiv_eq]
    exact (hfa.hasFDerivAt.add (hfb.hasFDerivAt.const_smul ε)).fderiv
  have hC2 : ∀ (w : pcrSp Bl α 2) j,
      ContDiffOn ℝ (2 : ℕ) (fun x => pcrEval Bl 2 (w : pcrAmb Bl 2) (P.param j x)) (P.W j) :=
    fun w j => (((hrange 2 _).1 ⟨w, rfl⟩).2 j).1
  
  have hDerF : ∀ v : pcrSp Bl α 2, ‖v‖ < s₁ → ∀ j, ∀ x ∈ P.W j, ∀ p : pcrSp Bl α 2,
      pcrEval Bl 0 (fderiv ℝ (Hop 0) v p : pcrAmb Bl 0) (P.param j x) =
        fderiv ℝ (Ψ j) (x, pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x),
            fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x')) x,
            fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x'))) x)
          (0, pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x),
            fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x')) x,
            fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x'))) x) := by
    intro v hv j x hx p
    have hv' : ‖ιE 0 v‖ < s₁ := by rwa [hιE0]
    let lam : pcrSp Bl α 0 →L[ℝ] ℝ := LinearMap.mkContinuous
      ((LinearMap.proj (R := ℝ) (φ := fun _ : X => ℝ) (P.param j x)).comp
        ((pcrEval Bl 0).comp (pcrSp Bl α 0).subtype)) 1
      (fun f => by
        rw [one_mul, Real.norm_eq_abs]
        exact G4 0 (f : pcrAmb Bl 0) (P.param j x))
    have hlam : ∀ f : pcrSp Bl α 0, lam f = pcrEval Bl 0 (f : pcrAmb Bl 0) (P.param j x) :=
      fun f => rfl
    have hdiff : DifferentiableAt ℝ (Hop 0) v :=
      ((hHs 0).differentiableOn (by simp)).differentiableAt ((hOpen 0).mem_nhds hv')
    have hline : HasDerivAt (fun ε : ℝ => v + ε • p) p 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const p).const_add v
    have h2 : HasDerivAt (fun ε : ℝ => Hop 0 (v + ε • p)) (fderiv ℝ (Hop 0) v p) 0 :=
      hdiff.hasFDerivAt.comp_hasDerivAt_of_eq 0 hline (by simp)
    have hφ : HasDerivAt (fun ε : ℝ => lam (Hop 0 (v + ε • p))) (lam (fderiv ℝ (Hop 0) v p)) 0 :=
      lam.hasFDerivAt.comp_hasDerivAt 0 h2
    have hsmall : ∀ᶠ ε in 𝓝 (0 : ℝ), ‖v + ε • p‖ < s₁ :=
      hline.continuousAt.norm.eventually_lt continuousAt_const (by simpa using hv)
    have hus : |pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x)| < s₁ :=
      lt_of_le_of_lt (G4 2 _ _) hv
    have hlin : ∀ ε : ℝ, (fun x' => pcrEval Bl 2 ((v + ε • p : pcrSp Bl α 2) : pcrAmb Bl 2)
        (P.param j x')) = fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x') +
          ε * pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x') := by
      intro ε
      funext x'
      simp [map_add, map_smul]
    have hEv : (fun ε : ℝ => lam (Hop 0 (v + ε • p))) =ᶠ[𝓝 0] fun ε : ℝ => Ψ j
        ((x, pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x),
            fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x')) x,
            fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x'))) x) +
          ε • ((0 : E2), pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x),
            fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x')) x,
            fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x'))) x)) := by
      filter_upwards [hsmall] with ε hε
      have hpt := congrFun (hlin ε) x
      obtain ⟨e1, e2⟩ := hjetlin _ _ (P.W j) (P.W_open j) (hC2 v j) (hC2 p j) x hx ε
      beta_reduce at hpt e1 e2
      rw [hlam, hValF (v + ε • p) hε j x hx, hpt, hlin ε, e1, e2]
      simp only [Prod.smul_mk, Prod.mk_add_mk, smul_zero, add_zero, smul_eq_mul]
    have hΨd : DifferentiableAt ℝ (Ψ j) (x, pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x),
        fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x')) x,
        fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x'))) x) :=
      ((hΨ j).differentiableOn (by simp)).differentiableAt ((hDopen j).mem_nhds ⟨hx, hus⟩)
    have hlz := ((hasDerivAt_id (0 : ℝ)).smul_const ((0 : E2), pcrEval Bl 2 (p : pcrAmb Bl 2)
        (P.param j x), fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x')) x,
        fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (p : pcrAmb Bl 2) (P.param j x'))) x)).const_add
      (x, pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x),
        fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x')) x,
        fderiv ℝ (fderiv ℝ (fun x' => pcrEval Bl 2 (v : pcrAmb Bl 2) (P.param j x'))) x)
    simp only [id, one_smul] at hlz
    have hψ := hΨd.hasFDerivAt.comp_hasDerivAt_of_eq 0 hlz (by simp)
    have hfin := (hψ.congr_of_eventuallyEq hEv).unique hφ
    rw [← hlam]
    exact hfin.symm
  
  refine ⟨B, evE, evF, Hop, s₁, 1, hs₁, zero_le_one, fun k => hinj (k + 2), fun k => hinj k,
    fun k u => hrange (k + 2) u, fun k u => hrange k u, fun k v => rfl, fun k g => rfl, hιE0,
    fun v q _ => by rw [one_mul]; exact G4 2 (v : pcrAmb Bl 2) q, hHs, hHc,
    fun v hv => ⟨fun q _ => lt_of_le_of_lt (G4 2 (v : pcrAmb Bl 2) q) hv,
      fun j x hx => ⟨hValF v hv j x hx, hDerF v hv j x hx⟩⟩, ?_⟩
  intro k I hI γ hγ j
  exact pcr_transfer P Bl α hα0 hα1 k I hI γ hγ (fun t => pcrEval Bl (k + 2) (γ t : pcrAmb Bl (k + 2)))
    (fun t => by
      obtain ⟨u, hu, hr, he⟩ := hrep (k + 2) (γ t)
      beta_reduce
      rw [he]
      exact ⟨hu, hr⟩) j

theorem pcr_l0_coeff_regular (U : Set E3) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) U)
    (hGsymm : ∀ (y : E3) (a b : Fin 3), G y a b = G y b a)
    (hGpd : ∀ y ∈ U, (G y).PosDef) :
    (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b) U) ∧
    (∀ y ∈ U, 0 < (G y).det) ∧
    ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U ∧
    (∀ y ∈ U, ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a) ∧
    (∀ y ∈ U, ∀ v : Fin 3 → ℝ, v ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j) ∧
    (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => pcrL0A G y a b) U) ∧
    (∀ y ∈ U, (pcrL0A G y).PosDef) :=
by
  
  have hdetS : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have e : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
        - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
        + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [e]
    exact (((((((hH 0 0).mul (hH 1 1)).mul (hH 2 2)).sub
      (((hH 0 0).mul (hH 1 2)).mul (hH 2 1))).sub
      (((hH 0 1).mul (hH 1 0)).mul (hH 2 2))).add
      (((hH 0 1).mul (hH 1 2)).mul (hH 2 0))).add
      (((hH 0 2).mul (hH 1 0)).mul (hH 2 1))).sub
      (((hH 0 2).mul (hH 1 1)).mul (hH 2 0))
  
  have hadjS : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate a b) U := by
    intro a b
    have e : (fun y => (G y).adjugate a b) =
        fun y => ((G y).updateRow b (Pi.single a 1)).det := by
      funext y
      exact Matrix.adjugate_apply _ _ _
    rw [e]
    apply hdetS
    intro i j
    by_cases hi : i = b
    · subst hi
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hi]
      exact hGs i j
  have hinv_eq : ∀ y (a b : Fin 3), (G y)⁻¹ a b = ((G y).det)⁻¹ * (G y).adjugate a b := by
    intro y a b
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hdetpos : ∀ y ∈ U, 0 < (G y).det := fun y hy => (hGpd y hy).det_pos
  have hdetne : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hdetpos y hy).ne'
  have hdS := hdetS G hGs
  have T1 : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b) U := by
    intro a b
    have e : (fun y => (G y)⁻¹ a b) = fun y => ((G y).det)⁻¹ * (G y).adjugate a b :=
      funext fun y => hinv_eq y a b
    rw [e]
    exact (hdS.inv hdetne).mul (hadjS a b)
  have T3 : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U := hdS.sqrt hdetne
  have T4 : ∀ y ∈ U, ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a := by
    intro y hy a b
    have h := (hGpd y hy).inv.isHermitian.apply a b
    rw [star_trivial] at h
    exact h.symm
  have T5 : ∀ y ∈ U, ∀ v : Fin 3 → ℝ, v ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j := by
    intro y hy v hv
    have h := (hGpd y hy).inv.dotProduct_mulVec_pos hv
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three] at h ⊢
    convert h using 1
    ring
  have hM00 : ∀ y ∈ U, 0 < (G y)⁻¹ 0 0 := fun y hy => (hGpd y hy).inv.diag_pos
  have hsS : ContDiffOn ℝ ∞ (fun y => Real.sqrt ((G y)⁻¹ 0 0)) U :=
    (T1 0 0).sqrt (fun y hy => (hM00 y hy).ne')
  have hsne : ∀ y ∈ U, Real.sqrt ((G y)⁻¹ 0 0) ≠ 0 :=
    fun y hy => (Real.sqrt_pos.mpr (hM00 y hy)).ne'
  have T6 : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => pcrL0A G y a b) U := by
    intro a b
    exact T3.mul (((T1 a.succ b.succ).div hsS hsne).sub
      (((T1 a.succ 0).mul (T1 b.succ 0)).div (hsS.pow 3)
        (fun y hy => pow_ne_zero 3 (hsne y hy))))
  have T7 : ∀ y ∈ U, (pcrL0A G y).PosDef := by
    intro y hy
    have hMpd : ((G y)⁻¹).PosDef := (hGpd y hy).inv
    have hMs := T4 y hy
    have hm00 : 0 < (G y)⁻¹ 0 0 := hM00 y hy
    have hσ : 0 < Real.sqrt (G y).det := Real.sqrt_pos.mpr (hdetpos y hy)
    have hs : 0 < Real.sqrt ((G y)⁻¹ 0 0) := Real.sqrt_pos.mpr hm00
    have hs2 : Real.sqrt ((G y)⁻¹ 0 0) ^ 2 = (G y)⁻¹ 0 0 := Real.sq_sqrt hm00.le
    have hA : ∀ a b, pcrL0A G y a b = Real.sqrt (G y).det *
        ((G y)⁻¹ a.succ b.succ / Real.sqrt ((G y)⁻¹ 0 0) -
          (G y)⁻¹ a.succ 0 * (G y)⁻¹ b.succ 0 / Real.sqrt ((G y)⁻¹ 0 0) ^ 3) :=
      fun a b => rfl
    set Mi := (G y)⁻¹ with hMi
    set σ := Real.sqrt (G y).det with hσdef
    set s := Real.sqrt (Mi 0 0) with hsdef
    refine Matrix.PosDef.of_dotProduct_mulVec_pos ?_ ?_
    · refine Matrix.IsHermitian.ext fun i j => ?_
      rw [star_trivial, hA, hA, hMs j.succ i.succ, mul_comm (Mi j.succ 0)]
    · intro v hv
      have hv' : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
        by_contra hc
        push_neg at hc
        apply hv
        funext i
        fin_cases i
        · simpa using hc.1
        · simpa using hc.2
      have hu : (![-(Mi 1 0 * v 0 + Mi 2 0 * v 1), Mi 0 0 * v 0, Mi 0 0 * v 1] : Fin 3 → ℝ)
          ≠ 0 := by
        intro h0
        have h1 : Mi 0 0 * v 0 = 0 := by simpa using congrFun h0 1
        have h2 : Mi 0 0 * v 1 = 0 := by simpa using congrFun h0 2
        rcases hv' with h | h
        · exact h ((mul_eq_zero.mp h1).resolve_left hm00.ne')
        · exact h ((mul_eq_zero.mp h2).resolve_left hm00.ne')
      have hQ := hMpd.dotProduct_mulVec_pos hu
      have hQ' : dotProduct (star (![-(Mi 1 0 * v 0 + Mi 2 0 * v 1), Mi 0 0 * v 0,
            Mi 0 0 * v 1] : Fin 3 → ℝ))
          (Matrix.mulVec Mi (![-(Mi 1 0 * v 0 + Mi 2 0 * v 1), Mi 0 0 * v 0, Mi 0 0 * v 1] :
            Fin 3 → ℝ)) =
          Mi 0 0 * (Mi 0 0 * (Mi 1 1 * v 0 * v 0 + Mi 1 2 * v 0 * v 1 + Mi 2 1 * v 1 * v 0 +
            Mi 2 2 * v 1 * v 1) - (Mi 1 0 * v 0 + Mi 2 0 * v 1) ^ 2) := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
          Matrix.tail_cons]
        rw [hMs 0 1, hMs 0 2]
        ring
      rw [hQ'] at hQ
      have hX : 0 < Mi 0 0 * (Mi 1 1 * v 0 * v 0 + Mi 1 2 * v 0 * v 1 + Mi 2 1 * v 1 * v 0 +
            Mi 2 2 * v 1 * v 1) - (Mi 1 0 * v 0 + Mi 2 0 * v 1) ^ 2 :=
        (mul_pos_iff_of_pos_left hm00).mp hQ
      have hsne' : s ≠ 0 := hs.ne'
      have hQA : dotProduct (star v) (Matrix.mulVec (pcrL0A G y) v) =
          σ * (s ^ 2 * (Mi 1 1 * v 0 * v 0 + Mi 1 2 * v 0 * v 1 + Mi 2 1 * v 1 * v 0 +
            Mi 2 2 * v 1 * v 1) - (Mi 1 0 * v 0 + Mi 2 0 * v 1) ^ 2) / s ^ 3 := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two, hA,
          Fin.succ_zero_eq_one, Fin.succ_one_eq_two]
        field_simp
        ring
      rw [hQA, hs2]
      exact div_pos (mul_pos hσ hX) (pow_pos hs 3)
  exact ⟨T1, hdetpos, T3, T4, T5, T6, T7⟩

theorem pcr_l0_coeff_compat (Gj Gk : E3 → Matrix (Fin 3) (Fin 3) ℝ) (τ : E2 → E2) (x : E2)
    (hτ : DifferentiableAt ℝ τ x) (hGjpd : (Gj (hpLift 0 x)).PosDef)
    (hc : Gj (hpLift 0 x) =
      pullbackMetric Gk (fun y => hpLift (y 0) (τ (hpProj y))) (hpLift 0 x)) :
    Real.sqrt (Gj (hpLift 0 x)).det =
        |(fderiv ℝ τ x).det| * Real.sqrt (Gk (hpLift 0 (τ x))).det ∧
      ∀ c d : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
          fderiv ℝ τ x (e2 a) c * pcrL0A Gj (hpLift 0 x) a b * fderiv ℝ τ x (e2 b) d =
        |(fderiv ℝ τ x).det| * pcrL0A Gk (hpLift 0 (τ x)) c d :=
by
  classical
  
  have hlift0 : ∀ (t : ℝ) (u : E2), (hpLift t u) 0 = t := by
    intro t u
    simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hpx : ∀ (t : ℝ) (u : E2), hpProj (hpLift t u) = u := by
    intro t u
    ext i
    fin_cases i <;> simp [hpLift, cylPt, hpProj, e, EuclideanSpace.single_apply]
  
  let Lp : E3 →L[ℝ] E2 := (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e2 0) +
    (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e2 1)
  have hLp : ∀ z : E3, Lp z = hpProj z := by
    intro z
    ext i
    fin_cases i <;> simp [Lp, hpProj, EuclideanSpace.single_apply]
  have hprojfun : hpProj = ⇑Lp := funext fun z => (hLp z).symm
  have h1 : HasFDerivAt (fun y => τ (hpProj y)) ((fderiv ℝ τ x).comp Lp) (hpLift 0 x) := by
    have hτ' : HasFDerivAt τ (fderiv ℝ τ x) (Lp (hpLift 0 x)) := by
      rw [hLp, hpx]
      exact hτ.hasFDerivAt
    rw [hprojfun]
    exact hτ'.comp (hpLift 0 x) Lp.hasFDerivAt
  have h2 : ∀ c : Fin 2, HasFDerivAt (fun y => τ (hpProj y) c)
      ((EuclideanSpace.proj c : E2 →L[ℝ] ℝ).comp ((fderiv ℝ τ x).comp Lp)) (hpLift 0 x) :=
    fun c => (EuclideanSpace.proj c : E2 →L[ℝ] ℝ).hasFDerivAt.comp (hpLift 0 x) h1
  have h0 : HasFDerivAt (fun y : E3 => y 0) (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ)
      (hpLift 0 x) := (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt
  have hTfun : (fun y : E3 => hpLift (y 0) (τ (hpProj y))) =
      fun y => (y 0) • e 0 + (τ (hpProj y) 0) • e 1 + (τ (hpProj y) 1) • e 2 := by
    funext y
    simp [hpLift, cylPt]
  have hTd : HasFDerivAt (fun y : E3 => hpLift (y 0) (τ (hpProj y)))
      ((EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e 0) +
        ((EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).comp
          ((fderiv ℝ τ x).comp Lp)).smulRight (e 1) +
        ((EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).comp
          ((fderiv ℝ τ x).comp Lp)).smulRight (e 2)) (hpLift 0 x) := by
    rw [hTfun]
    exact ((h0.smul_const (e 0)).add ((h2 0).smul_const (e 1))).add ((h2 1).smul_const (e 2))
  have hJ : ∀ (i a : Fin 3),
      (fderiv ℝ (fun y : E3 => hpLift (y 0) (τ (hpProj y))) (hpLift 0 x) (e a)) i =
      (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ) i a := by
    intro i a
    rw [hTd.fderiv]
    fin_cases i <;> fin_cases a <;> simp [Lp, EuclideanSpace.single_apply]
  
  have hGmat : Gj (hpLift 0 x) =
      (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ).transpose *
        Gk (hpLift 0 (τ x)) *
      (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ) := by
    rw [hc]
    ext a b
    simp only [pullbackMetric, hJ, hlift0, hpx, Matrix.mul_apply, Matrix.transpose_apply,
      Finset.sum_mul]
    rw [Finset.sum_comm]
  
  have hdetL : (fderiv ℝ τ x).det = fderiv ℝ τ x (e2 0) 0 * fderiv ℝ τ x (e2 1) 1 -
      fderiv ℝ τ x (e2 1) 0 * fderiv ℝ τ x (e2 0) 1 := by
    rw [ContinuousLinearMap.det,
      ← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis, Matrix.det_fin_two]
    simp [LinearMap.toMatrix_apply]
  have hdetJ : (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ).det =
      (fderiv ℝ τ x).det := by
    rw [hdetL, Matrix.det_fin_three]
    simp
    try ring
  have hdetG : (Gj (hpLift 0 x)).det = (fderiv ℝ τ x).det ^ 2 * (Gk (hpLift 0 (τ x))).det := by
    rw [hGmat, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hdetJ]
    ring
  have hσ : Real.sqrt (Gj (hpLift 0 x)).det =
      |(fderiv ℝ τ x).det| * Real.sqrt (Gk (hpLift 0 (τ x))).det := by
    rw [hdetG, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  refine ⟨hσ, ?_⟩
  
  have hpos : 0 < (Gj (hpLift 0 x)).det := hGjpd.det_pos
  have hJ0 : (fderiv ℝ τ x).det ≠ 0 := by
    intro h0
    rw [hdetG, h0] at hpos
    simp at hpos
  have hJu : IsUnit (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ).det := by
    rw [hdetJ]
    exact isUnit_iff_ne_zero.mpr hJ0
  have hJTu : IsUnit (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] :
          Matrix (Fin 3) (Fin 3) ℝ).transpose.det := by
    rw [Matrix.det_transpose]
    exact hJu
  have hinv : (Gk (hpLift 0 (τ x)))⁻¹ =
      (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ) *
        (Gj (hpLift 0 x))⁻¹ *
      (!![1, 0, 0; 0, fderiv ℝ τ x (e2 0) 0, fderiv ℝ τ x (e2 1) 0;
        0, fderiv ℝ τ x (e2 0) 1, fderiv ℝ τ x (e2 1) 1] : Matrix (Fin 3) (Fin 3) ℝ).transpose := by
    rw [hGmat, Matrix.mul_inv_rev, Matrix.mul_inv_rev]
    simp only [Matrix.mul_assoc]
    rw [Matrix.nonsing_inv_mul _ hJTu, Matrix.mul_one, ← Matrix.mul_assoc,
      Matrix.mul_nonsing_inv _ hJu, Matrix.one_mul]
  have h00 : (Gk (hpLift 0 (τ x)))⁻¹ 0 0 = (Gj (hpLift 0 x))⁻¹ 0 0 := by
    rw [hinv]
    simp [Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three]
  have hs0 : ∀ c : Fin 2, (Gk (hpLift 0 (τ x)))⁻¹ c.succ 0 =
      ∑ a : Fin 2, fderiv ℝ τ x (e2 a) c * (Gj (hpLift 0 x))⁻¹ a.succ 0 := by
    intro c
    rw [hinv]
    fin_cases c <;>
      simp [Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three, Fin.sum_univ_two] <;>
      ring
  have hss : ∀ c d : Fin 2, (Gk (hpLift 0 (τ x)))⁻¹ c.succ d.succ =
      ∑ a : Fin 2, ∑ b : Fin 2, fderiv ℝ τ x (e2 a) c * (Gj (hpLift 0 x))⁻¹ a.succ b.succ *
        fderiv ℝ τ x (e2 b) d := by
    intro c d
    rw [hinv]
    fin_cases c <;> fin_cases d <;>
      simp [Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three, Fin.sum_univ_two] <;>
      ring
  
  intro c d
  simp only [pcrL0A]
  rw [hσ, h00, hs0 c, hs0 d, hss c d]
  simp only [Fin.sum_univ_two]
  ring

theorem pcr_lmc_div_form (U : Set E3) (hU : IsOpen U) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) U)
    (hGsymm : ∀ (y : E3) (a b : Fin 3), G y a b = G y b a)
    (hGpd : ∀ y ∈ U, (G y).PosDef)
    (hMs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b) U)
    (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U)
    (hS : ∀ y ∈ U, 0 < ∑ k : Fin 3, ∑ l : Fin 3,
      (G y)⁻¹ k l * partialDeriv k f y * partialDeriv l f y)
    (y : E3) (hy : y ∈ U) :
    Real.sqrt (G y).det * levelMeanCurvCoord G f y =
      ∑ i : Fin 3, partialDeriv i (pcrL0Z G f i) y :=
by
  have h := ccs_divx G f U hU hGs hGsymm hGpd hf (hcrNormalField G f) (fun _ _ _ => rfl)
    y hy (hS y hy)
  have s2 : ∀ i : Fin 3,
      (fun z => Real.sqrt (G z).det * hcrNormalField G f z i) = pcrL0Z G f i := by
    intro i
    funext z
    show Real.sqrt (G z).det * calUnitNormal G f z i = pcrL0Z G f i z
    unfold calUnitNormal pcrL0Z
    rw [div_eq_mul_inv]
    ring
  unfold sepDensDiv at h
  simp only [s2] at h
  exact h.symm

theorem pcr_l0_jet_congr (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (w T : E2 → ℝ) (x : E2)
    (hw : ContDiffAt ℝ 2 w x) (hT : ContDiffAt ℝ 2 T x)
    (h0 : T x = w x) (h1 : fderiv ℝ T x = fderiv ℝ w x)
    (h2 : fderiv ℝ (fderiv ℝ T) x = fderiv ℝ (fderiv ℝ w) x) (ε : ℝ) :
    pcrH G (fun x' => ε * w x') x = pcrH G (fun x' => ε * T x') x :=
by
  
  
  
  have hP1 : ∀ y : E3, hpProj y 0 = y 1 := by
    intro y; simp [hpProj]
  have hP2 : ∀ y : E3, hpProj y 1 = y 2 := by
    intro y; simp [hpProj]
  have hL1 : ∀ (t : ℝ) (x : E2), (hpLift t x) 1 = x 0 := by
    intro t x; simp [hpLift, cylPt, EuclideanSpace.single_apply]
  have hL2 : ∀ (t : ℝ) (x : E2), (hpLift t x) 2 = x 1 := by
    intro t x; simp [hpLift, cylPt, EuclideanSpace.single_apply]
  have hLP : ∀ (t : ℝ) (x : E2), hpProj (hpLift t x) = x := by
    intro t x; ext k; fin_cases k
    · simp [hP1, hL1]
    · simp [hP2, hL2]
  let Pl : E3 →ₗ[ℝ] E2 :=
    { toFun := hpProj
      map_add' := by
        intro y y'; ext k; fin_cases k
        · simp [hP1]
        · simp [hP2]
      map_smul' := by
        intro c y; ext k; fin_cases k
        · simp [hP1]
        · simp [hP2] }
  let P : E3 →L[ℝ] E2 := LinearMap.toContinuousLinearMap Pl
  have hP : ∀ y, P y = hpProj y := fun y => rfl
  have hPf : hpProj = ⇑P := funext fun y => (hP y).symm
  let π0 : E3 →L[ℝ] ℝ := EuclideanSpace.proj (0 : Fin 3)
  have hπ0 : ∀ y : E3, π0 y = y 0 := fun y => rfl
  
  
  
  have hgraph : ∀ (w : E2 → ℝ) (x : E2) (t : ℝ), ContDiffAt ℝ 2 w x →
      (∀ i : Fin 3, partialDeriv i (fun y => y 0 - w (hpProj y)) (hpLift t x) =
          (e i) 0 - fderiv ℝ w x (hpProj (e i))) ∧
      (∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun y => y 0 - w (hpProj y))) (hpLift t x) =
          -(fderiv ℝ (fderiv ℝ w) x (hpProj (e i)) (hpProj (e j)))) := by
    intro w x t hw
    have hPx : P (hpLift t x) = x := by rw [hP, hLP]
    have hev : ∀ᶠ x' in 𝓝 x, ContDiffAt ℝ 2 w x' := hw.eventually (by decide)
    have hev' : ∀ᶠ y in 𝓝 (hpLift t x), DifferentiableAt ℝ w (P y) := by
      have hT : Tendsto P (𝓝 (hpLift t x)) (𝓝 x) := by
        have := P.continuous.tendsto (hpLift t x)
        rwa [hPx] at this
      exact (hT.eventually hev).mono fun y hy => hy.differentiableAt (by norm_num)
    have hderiv : ∀ y, DifferentiableAt ℝ w (P y) → ∀ j : Fin 3,
        partialDeriv j (fun y => y 0 - w (hpProj y)) y = (e j) 0 - fderiv ℝ w (P y) (P (e j)) := by
      intro y hy j
      have h1 : HasFDerivAt (fun y : E3 => y 0 - w (hpProj y))
          (π0 - (fderiv ℝ w (P y)).comp P) y := by
        rw [hPf]
        exact π0.hasFDerivAt.sub (hy.hasFDerivAt.comp y P.hasFDerivAt)
      unfold partialDeriv
      rw [h1.fderiv]
      simp [hπ0]
    have hx2 : DifferentiableAt ℝ (fderiv ℝ w) x :=
      (hw.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    refine ⟨fun i => ?_, fun i j => ?_⟩
    · rw [hderiv _ (hev'.self_of_nhds) i, hPx, hP]
    · have heq : partialDeriv j (fun y => y 0 - w (hpProj y)) =ᶠ[𝓝 (hpLift t x)]
          fun y => (e j) 0 - fderiv ℝ w (P y) (P (e j)) :=
        hev'.mono fun y hy => hderiv y hy j
      have hA : HasFDerivAt (fun y => fderiv ℝ w (P y))
          ((fderiv ℝ (fderiv ℝ w) x).comp P) (hpLift t x) := by
        have := hx2.hasFDerivAt
        rw [← hPx] at this
        have h2 := this.comp (hpLift t x) P.hasFDerivAt
        rw [hPx] at h2
        exact h2
      have hB : HasFDerivAt (fun y => (e j) 0 - fderiv ℝ w (P y) (P (e j)))
          (-(((fderiv ℝ (fderiv ℝ w) x).comp P).flip (P (e j)))) (hpLift t x) := by
        have h3 := hA.clm_apply (hasFDerivAt_const (P (e j)) (hpLift t x))
        have h4 := h3.const_sub ((e j) 0)
        convert h4 using 1
        ext v
        simp
      change fderiv ℝ (partialDeriv j (fun y => y 0 - w (hpProj y))) (hpLift t x) (e i) = _
      rw [heq.fderiv_eq, hB.fderiv]
      simp [hP]
  
  
  
  have hcongr : ∀ (u v : E2 → ℝ), ContDiffAt ℝ 2 u x → ContDiffAt ℝ 2 v x →
      u x = v x → fderiv ℝ u x = fderiv ℝ v x →
      fderiv ℝ (fderiv ℝ u) x = fderiv ℝ (fderiv ℝ v) x → pcrH G u x = pcrH G v x := by
    intro u v hu hv huv0 huv1 huv2
    obtain ⟨au, bu⟩ := hgraph u x (v x) hu
    obtain ⟨av, bv⟩ := hgraph v x (v x) hv
    unfold pcrH
    rw [huv0]
    unfold levelMeanCurvCoord lapLoc hessLoc
    simp only [au, bu, av, bv, huv1, huv2]
  
  
  
  have hjet : ∀ (g : E2 → ℝ), ContDiffAt ℝ 2 g x →
      ContDiffAt ℝ 2 (fun x' => ε * g x') x ∧
      fderiv ℝ (fun x' => ε * g x') x = ε • fderiv ℝ g x ∧
      fderiv ℝ (fderiv ℝ (fun x' => ε * g x')) x = ε • fderiv ℝ (fderiv ℝ g) x := by
    intro g hg
    have hev : ∀ᶠ x' in 𝓝 x, fderiv ℝ (fun x' => ε * g x') x' = ε • fderiv ℝ g x' := by
      filter_upwards [hg.eventually (by decide)] with x' hg'
      exact ((hg'.differentiableAt (by norm_num)).hasFDerivAt.const_mul ε).fderiv
    have hg2 : DifferentiableAt ℝ (fderiv ℝ g) x :=
      (hg.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    refine ⟨contDiffAt_const.mul hg, hev.self_of_nhds, ?_⟩
    have hev2 : fderiv ℝ (fun x' => ε * g x') =ᶠ[𝓝 x]
        fun x' => ε • fderiv ℝ g x' := hev
    rw [hev2.fderiv_eq]
    exact (hg2.hasFDerivAt.const_smul ε).fderiv
  obtain ⟨cw, dw1, dw2⟩ := hjet w hw
  obtain ⟨cT, dT1, dT2⟩ := hjet T hT
  exact hcongr _ _ cw cT (by simp only [h0]) (by rw [dw1, dT1, h1])
    (by rw [dw2, dT2, h2])

theorem pcr_l0_taylor_reduce (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w : E2 → ℝ) (x : E2)
    (hA : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x' => A x' a b) x)
    (hw : ContDiffAt ℝ 2 w x) :
    ∃ T : E2 → ℝ, ContDiff ℝ ∞ T ∧ T x = w x ∧ fderiv ℝ T x = fderiv ℝ w x ∧
      fderiv ℝ (fderiv ℝ T) x = fderiv ℝ (fderiv ℝ w) x ∧
      ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b T x') x =
        ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w x') x :=
by
  
  have formula : ∀ u : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ u) x →
      ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b u x') x =
      ∑ a : Fin 2, ∑ b : Fin 2,
        (fderiv ℝ (fun x' => A x' a b) x (e2 a) * fderiv ℝ u x (e2 b) +
          A x a b * fderiv ℝ (fderiv ℝ u) x (e2 a) (e2 b)) := by
    intro u hu
    refine Finset.sum_congr rfl (fun a _ => ?_)
    have hpd : ∀ b : Fin 2, HasFDerivAt (fun x' => pd2 b u x')
        ((fderiv ℝ (fderiv ℝ u) x).flip (e2 b)) x := by
      intro b
      have h := hu.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 b) x)
      unfold pd2
      convert h using 1
      ext v
      simp
    have hsum : HasFDerivAt (fun x' => ∑ b : Fin 2, A x' a b * pd2 b u x')
        (∑ b : Fin 2, (A x a b • (fderiv ℝ (fderiv ℝ u) x).flip (e2 b) +
          pd2 b u x • fderiv ℝ (fun x' => A x' a b) x)) x := by
      apply HasFDerivAt.fun_sum
      intro b _
      exact (hA a b).hasFDerivAt.mul (hpd b)
    show fderiv ℝ _ x (e2 a) = _
    rw [hsum.fderiv]
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.flip_apply, smul_eq_mul, pd2]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    ring
  
  have jet : ∃ T : E2 → ℝ, ContDiff ℝ ∞ T ∧ T x = w x ∧ fderiv ℝ T x = fderiv ℝ w x ∧
      fderiv ℝ (fderiv ℝ T) x = fderiv ℝ (fderiv ℝ w) x ∧
      DifferentiableAt ℝ (fderiv ℝ T) x := by
    obtain ⟨L, hLdef⟩ : ∃ L, L = fderiv ℝ w x := ⟨_, rfl⟩
    obtain ⟨B, hBdef⟩ : ∃ B, B = fderiv ℝ (fderiv ℝ w) x := ⟨_, rfl⟩
    have hsymm : ∀ v v', B v v' = B v' v := by
      have hS := hw.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
      intro v v'
      rw [hBdef]
      exact hS v v'
    have h1 : ∀ y : E2, HasFDerivAt (fun y : E2 => y - x) (ContinuousLinearMap.id ℝ E2) y :=
      fun y => (hasFDerivAt_id y).sub_const x
    have hT : ∀ y : E2, HasFDerivAt
        (fun y : E2 => w x + L (y - x) + (1 / 2 : ℝ) * B (y - x) (y - x))
        (L + (1 / 2 : ℝ) • (B (y - x) + B.flip (y - x))) y := by
      intro y
      have hL : HasFDerivAt (fun y : E2 => L (y - x)) L y := by
        have := L.hasFDerivAt.comp y (h1 y)
        rwa [ContinuousLinearMap.comp_id] at this
      have hB : HasFDerivAt (fun y : E2 => B (y - x)) B y := by
        have := B.hasFDerivAt.comp y (h1 y)
        rwa [ContinuousLinearMap.comp_id] at this
      have hBB : HasFDerivAt (fun y : E2 => B (y - x) (y - x))
          (B (y - x) + B.flip (y - x)) y := by
        have := hB.clm_apply (h1 y)
        simpa using this
      have := ((hasFDerivAt_const (w x) y).add hL).add (hBB.const_mul (1 / 2 : ℝ))
      convert this using 1
      simp
    have hfT : fderiv ℝ (fun y : E2 => w x + L (y - x) + (1 / 2 : ℝ) * B (y - x) (y - x)) =
        fun y => L + (1 / 2 : ℝ) • ((B + B.flip) (y - x)) := by
      funext y
      rw [(hT y).fderiv]
      simp
    have hΦ : HasFDerivAt (fun y : E2 => L + (1 / 2 : ℝ) • ((B + B.flip) (y - x)))
        ((1 / 2 : ℝ) • (B + B.flip)) x := by
      have := (((B + B.flip).hasFDerivAt.comp x (h1 x)).const_smul (1 / 2 : ℝ)).const_add L
      simpa using this
    refine ⟨fun y : E2 => w x + L (y - x) + (1 / 2 : ℝ) * B (y - x) (y - x), ?_, ?_, ?_, ?_, ?_⟩
    · have hs : ContDiff ℝ ∞ (fun y : E2 => y - x) := contDiff_id.sub contDiff_const
      exact (contDiff_const.add (L.contDiff.comp hs)).add
        (contDiff_const.mul ((B.contDiff.comp hs).clm_apply hs))
    · simp
    · rw [(hT x).fderiv, hLdef]
      simp
    · rw [hfT, hΦ.fderiv, ← hBdef]
      ext v v'
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.flip_apply, smul_eq_mul]
      rw [hsymm v' v]
      ring
    · rw [hfT]
      exact hΦ.differentiableAt
  obtain ⟨T, hTs, h0, h1, h2, hT'⟩ := jet
  have hw' : DifferentiableAt ℝ (fderiv ℝ w) x :=
    (hw.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  refine ⟨T, hTs, h0, h1, h2, ?_⟩
  rw [formula T hT', formula w hw', h1, h2]

theorem pcr_l0_vert_deriv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (w : E2 → ℝ) (y : E3)
    (hGsymm : ∀ a b : Fin 3, G y a b = G y b a) (hGpd : (G y).PosDef)
    (hw : DifferentiableAt ℝ w (hpProj y)) :
    HasDerivAt (fun ε : ℝ => pcrL0Z G (fun y' => y' 0 - ε * w (hpProj y')) 0 y) 0 0 ∧
    ∀ a : Fin 2, HasDerivAt
      (fun ε : ℝ => pcrL0Z G (fun y' => y' 0 - ε * w (hpProj y')) a.succ y)
      (-∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)) 0 :=
by
  classical
  
  have key : ∀ (σ A B C D E : ℝ) (N S : ℝ → ℝ), (∀ ε, N ε = A + ε * B) →
      (∀ ε, S ε = C + ε * D + ε ^ 2 * E) → 0 < C →
      HasDerivAt (fun ε => σ * N ε / Real.sqrt (S ε))
        ((σ * B * Real.sqrt C - σ * A * (D / (2 * Real.sqrt C))) / (Real.sqrt C) ^ 2) 0 := by
    intro σ A B C D E N S hN hS hC
    have hNf : N = fun ε => A + ε * B := funext hN
    have hSf : S = fun ε => C + ε * D + ε ^ 2 * E := funext hS
    subst hNf hSf
    have h1 : HasDerivAt (fun ε : ℝ => σ * (A + ε * B)) (σ * B) 0 := by
      have := (((hasDerivAt_id (0:ℝ)).mul_const B).const_add A).const_mul σ
      simpa using this
    have h2 : HasDerivAt (fun ε : ℝ => C + ε * D + ε ^ 2 * E) D 0 := by
      have := (((hasDerivAt_id (0:ℝ)).mul_const D).const_add C).add
        ((hasDerivAt_pow 2 (0:ℝ)).mul_const E)
      simpa using this
    have h3 : HasDerivAt (fun ε : ℝ => Real.sqrt (C + ε * D + ε ^ 2 * E))
        (D / (2 * Real.sqrt C)) 0 := by
      have := h2.sqrt (by simp; exact hC.ne')
      simpa using this
    have hne : Real.sqrt (C + 0 * D + 0 ^ 2 * E) ≠ 0 := by
      have : C + 0 * D + 0 ^ 2 * E = C := by ring
      rw [this]
      exact Real.sqrt_ne_zero'.mpr hC
    have h4 := h1.div h3 hne
    have e1 : (fun ε : ℝ => σ * (A + ε * B) / Real.sqrt (C + ε * D + ε ^ 2 * E)) =
        (fun ε : ℝ => σ * (A + ε * B)) / (fun ε => Real.sqrt (C + ε * D + ε ^ 2 * E)) := rfl
    rw [e1]
    convert h4 using 2 <;> simp
  simp only [pcrL0A, pcrL0Z]
  set M : Matrix (Fin 3) (Fin 3) ℝ := (G y)⁻¹ with hMdef
  set σ : ℝ := Real.sqrt (G y).det with hσdef
  have hMsymm : ∀ k l : Fin 3, M k l = M l k := by
    intro k l
    have h := hGpd.inv.isHermitian.apply k l
    simp only [star_trivial] at h
    exact h.symm
  have hM0 : 0 < M 0 0 := hGpd.inv.diag_pos
  
  obtain ⟨L, hL⟩ : ∃ L : E3 →L[ℝ] E2, ∀ z, L z = hpProj z := by
    refine ⟨LinearMap.toContinuousLinearMap
      { toFun := hpProj, map_add' := ?_, map_smul' := ?_ }, fun z => rfl⟩
    · intro a b; ext i; fin_cases i <;> simp [hpProj]
    · intro c a; ext i; fin_cases i <;> simp [hpProj]
  have hLe0 : hpProj (e 0) = 0 := by
    ext i; fin_cases i <;> simp [hpProj, e, EuclideanSpace.single_apply]
  have hLe1 : hpProj (e 1) = e2 0 := by
    ext i; fin_cases i <;> simp [hpProj, e, e2, EuclideanSpace.single_apply]
  have hLe2 : hpProj (e 2) = e2 1 := by
    ext i; fin_cases i <;> simp [hpProj, e, e2, EuclideanSpace.single_apply]
  
  have hD : ∀ ε : ℝ, HasFDerivAt (fun y' : E3 => y' 0 - ε * w (hpProj y'))
      ((EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) - ε • (fderiv ℝ w (hpProj y)).comp L) y := by
    intro ε
    have hw' : HasFDerivAt w (fderiv ℝ w (hpProj y)) (L y) := by
      rw [hL]; exact hw.hasFDerivAt
    have h1 : HasFDerivAt (fun y' : E3 => w (hpProj y')) ((fderiv ℝ w (hpProj y)).comp L) y := by
      have h := hw'.comp y L.hasFDerivAt
      have hfun : (fun y' : E3 => w (hpProj y')) = w ∘ ⇑L := by
        funext z; simp [hL]
      rw [hfun]; exact h
    have h0 : HasFDerivAt (fun y' : E3 => y' 0) (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) y :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt
    exact h0.sub (h1.const_mul ε)
  have hP0 : ∀ ε : ℝ, partialDeriv 0 (fun y' : E3 => y' 0 - ε * w (hpProj y')) y = 1 := by
    intro ε
    unfold partialDeriv
    rw [(hD ε).fderiv, ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, hL, hLe0]
    simp
  have hP1 : ∀ ε : ℝ, partialDeriv 1 (fun y' : E3 => y' 0 - ε * w (hpProj y')) y =
      -ε * pd2 0 w (hpProj y) := by
    intro ε
    unfold partialDeriv
    rw [(hD ε).fderiv, ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, hL, hLe1]
    simp [pd2]
  have hP2 : ∀ ε : ℝ, partialDeriv 2 (fun y' : E3 => y' 0 - ε * w (hpProj y')) y =
      -ε * pd2 1 w (hpProj y) := by
    intro ε
    unfold partialDeriv
    rw [(hD ε).fderiv, ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, hL, hLe2]
    simp [pd2]
  
  have hN : ∀ (i : Fin 3) (ε : ℝ),
      ∑ j : Fin 3, M i j * partialDeriv j (fun y' : E3 => y' 0 - ε * w (hpProj y')) y =
        M i 0 + ε * (-(M i 1 * pd2 0 w (hpProj y) + M i 2 * pd2 1 w (hpProj y))) := by
    intro i ε
    rw [Fin.sum_univ_three, hP0, hP1, hP2]
    ring
  have hS : ∀ ε : ℝ,
      ∑ k : Fin 3, ∑ l : Fin 3, M k l * partialDeriv k (fun y' : E3 => y' 0 - ε * w (hpProj y')) y *
          partialDeriv l (fun y' : E3 => y' 0 - ε * w (hpProj y')) y =
        M 0 0 + ε * (-((M 0 1 + M 1 0) * pd2 0 w (hpProj y) + (M 0 2 + M 2 0) * pd2 1 w (hpProj y)))
          + ε ^ 2 * (M 1 1 * pd2 0 w (hpProj y) ^ 2 +
            (M 1 2 + M 2 1) * pd2 0 w (hpProj y) * pd2 1 w (hpProj y) +
            M 2 2 * pd2 1 w (hpProj y) ^ 2) := by
    intro ε
    simp only [Fin.sum_univ_three, hP0, hP1, hP2]
    ring
  have hderiv := fun i : Fin 3 => key σ (M i 0) _ (M 0 0) _ _
    (fun ε : ℝ => ∑ j : Fin 3, M i j *
      partialDeriv j (fun y' : E3 => y' 0 - ε * w (hpProj y')) y)
    (fun ε : ℝ => ∑ k : Fin 3, ∑ l : Fin 3,
      M k l * partialDeriv k (fun y' : E3 => y' 0 - ε * w (hpProj y')) y *
        partialDeriv l (fun y' : E3 => y' 0 - ε * w (hpProj y')) y)
    (hN i) hS hM0
  have hs : Real.sqrt (M 0 0) ≠ 0 := Real.sqrt_ne_zero'.mpr hM0
  have hs2 : Real.sqrt (M 0 0) ^ 2 = M 0 0 := Real.sq_sqrt hM0.le
  refine ⟨?_, fun a => ?_⟩
  · convert hderiv 0 using 1
    rw [hMsymm 1 0, hMsymm 2 0]
    generalize Real.sqrt (M 0 0) = s at hs hs2 ⊢
    rw [← hs2]
    field_simp
    ring
  · convert hderiv a.succ using 1
    rw [Fin.sum_univ_two]
    simp only [Fin.succ_zero_eq_one, Fin.succ_one_eq_two]
    rw [hMsymm 1 0, hMsymm 2 0]
    field_simp
    ring

theorem pcr_l0_smooth_lin (W : Set E2) (hW : IsOpen W) (s₁ : ℝ) (hs₁ : 0 < s₁)
    (G : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hMs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W})
    (hσs : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W})
    (hσpos : ∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W}, 0 < Real.sqrt (G y).det)
    (hMpos : ∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W}, ∀ v : Fin 3 → ℝ, v ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j)
    (hAs : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => pcrL0A G y a b)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W})
    (w : E2 → ℝ) (hw : ContDiff ℝ ∞ w)
    (hdiv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W} →
      (∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W},
        0 < ∑ k : Fin 3, ∑ l : Fin 3, (G y)⁻¹ k l * partialDeriv k f y * partialDeriv l f y) →
      ∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W},
        Real.sqrt (G y).det * levelMeanCurvCoord G f y =
          ∑ i : Fin 3, partialDeriv i (pcrL0Z G f i) y)
    (hV : ∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W},
      HasDerivAt (fun ε : ℝ => pcrL0Z G (fun y' => y' 0 - ε * w (hpProj y')) 0 y) 0 0 ∧
      ∀ a : Fin 2, HasDerivAt
        (fun ε : ℝ => pcrL0Z G (fun y' => y' 0 - ε * w (hpProj y')) a.succ y)
        (-∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)) 0)
    (x : E2) (hx : x ∈ W)
    (hleaf : levelMeanCurvCoord G (fun y => y 0) (hpLift 0 x) = 0 ∧
      HasDerivAt (fun s => levelMeanCurvCoord G (fun y => y 0) (hpLift s x)) 0 0) :
    HasDerivAt (fun ε : ℝ => pcrH G (fun x' => ε * w x') x)
      (-(Real.sqrt (G (hpLift 0 x)).det)⁻¹ * ∑ a : Fin 2,
        pd2 a (fun x' => ∑ b : Fin 2, pcrL0A G (hpLift 0 x') a b * pd2 b w x') x) 0 :=
by
  classical
  
  have hL0 : ∀ (t : ℝ) (x' : E2), (hpLift t x') 0 = t := by
    intro t x'; simp [hpLift, cylPt]
  have hPL : ∀ (t : ℝ) (x' : E2), hpProj (hpLift t x') = x' := by
    intro t x'; ext i; fin_cases i <;> simp [hpProj, hpLift, cylPt]
  have hLift : ∀ (t : ℝ) (x' : E2), hpLift t x' = hpLift 0 x' + t • e 0 := by
    intro t x'; ext i; fin_cases i <;> simp [hpLift, cylPt]
  obtain ⟨P, hPeq⟩ : ∃ P : E3 →L[ℝ] E2, ∀ z, hpProj z = P z :=
    ⟨(EuclideanSpace.proj (1:Fin 3)).smulRight (e2 0) +
      (EuclideanSpace.proj (2:Fin 3)).smulRight (e2 1),
     fun z => by ext k; fin_cases k <;> simp [hpProj]⟩
  have hPe0 : P (e 0) = 0 := by rw [← hPeq]; ext k; fin_cases k <;> simp [hpProj]
  obtain ⟨L, hLeq⟩ : ∃ L : E2 →L[ℝ] E3, ∀ x', hpLift 0 x' = L x' :=
    ⟨(EuclideanSpace.proj (0:Fin 2)).smulRight (e 1) +
      (EuclideanSpace.proj (1:Fin 2)).smulRight (e 2),
     fun x' => by ext k; fin_cases k <;> simp [hpLift, cylPt]⟩
  have hLe : ∀ a : Fin 2, L (e2 a) = e a.succ := by
    intro a; rw [← hLeq]; ext k; fin_cases a <;> fin_cases k <;> simp [hpLift, cylPt]
  have hPs : ContDiff ℝ ∞ hpProj := by
    rw [show hpProj = ⇑P from funext hPeq]; exact P.contDiff
  have h0s' : ContDiff ℝ ∞ (fun q : E3 => q 0) := by fun_prop
  
  obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Set E3, Ω = {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ W} := ⟨_, rfl⟩
  rw [← hΩdef] at hMs hσs hσpos hMpos hAs hdiv hV
  have hΩo : IsOpen Ω := by
    rw [hΩdef]
    exact (isOpen_lt (continuous_abs.comp (EuclideanSpace.proj (0 : Fin 3)).continuous)
      continuous_const).inter (hW.preimage hPs.continuous)
  have hy₀ : hpLift 0 x ∈ Ω := by
    rw [hΩdef]; exact ⟨by rw [hL0, abs_zero]; exact hs₁, by rw [hPL]; exact hx⟩
  have hUo : IsOpen (Set.univ ×ˢ Ω : Set (ℝ × E3)) := isOpen_univ.prod hΩo
  
  have hwd : Differentiable ℝ w := hw.differentiable (by simp)
  have hfd : ∀ (ε : ℝ) (y : E3), HasFDerivAt (fun y' : E3 => y' 0 - ε * w (hpProj y'))
      (EuclideanSpace.proj (0:Fin 3) - ε • (fderiv ℝ w (hpProj y)).comp P) y := by
    intro ε y
    have h1 : HasFDerivAt (fun y' : E3 => w (hpProj y'))
        ((fderiv ℝ w (hpProj y)).comp P) y := by
      have := (hwd (P y)).hasFDerivAt.comp y P.hasFDerivAt
      simpa [Function.comp_def, hPeq] using this
    exact (EuclideanSpace.proj (0:Fin 3)).hasFDerivAt.sub (h1.const_mul ε)
  have hQ0 : ∀ (ε : ℝ) (y : E3),
      partialDeriv 0 (fun y' : E3 => y' 0 - ε * w (hpProj y')) y = 1 := by
    intro ε y
    rw [partialDeriv, (hfd ε y).fderiv]
    simp [hPe0]
  have hrad : ∀ (ε : ℝ), ∀ y ∈ Ω, 0 < ∑ k : Fin 3, ∑ l : Fin 3, (G y)⁻¹ k l *
      partialDeriv k (fun y' : E3 => y' 0 - ε * w (hpProj y')) y *
      partialDeriv l (fun y' : E3 => y' 0 - ε * w (hpProj y')) y := by
    intro ε y hy
    apply hMpos y hy (fun k => partialDeriv k (fun y' : E3 => y' 0 - ε * w (hpProj y')) y)
    intro h
    have h' := congrFun h 0
    simp only [Pi.zero_apply] at h'
    rw [hQ0] at h'
    exact one_ne_zero h'
  have hfs : ∀ ε : ℝ, ContDiff ℝ ∞ (fun y' : E3 => y' 0 - ε * w (hpProj y')) := fun ε =>
    h0s'.sub (contDiff_const.mul (hw.comp hPs))
  have hK : ∀ ε : ℝ, ∀ y ∈ Ω, Real.sqrt (G y).det *
      levelMeanCurvCoord G (fun y' : E3 => y' 0 - ε * w (hpProj y')) y =
      ∑ i : Fin 3, partialDeriv i (pcrL0Z G (fun y' : E3 => y' 0 - ε * w (hpProj y')) i) y :=
    fun ε => hdiv _ (hfs ε).contDiffOn (hrad ε)
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Fin 3 → ℝ × E3 → ℝ, ∀ i p,
      Φ i p = pcrL0Z G (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) i p.2 :=
    ⟨fun i p => pcrL0Z G (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) i p.2, fun _ _ => rfl⟩
  have hZΦ : ∀ (ε : ℝ) (i : Fin 3),
      pcrL0Z G (fun y' : E3 => y' 0 - ε * w (hpProj y')) i = fun y' => Φ i (ε, y') :=
    fun ε i => funext fun y' => (hΦ i (ε, y')).symm
  have hΦε : ∀ (i : Fin 3) (y : E3), (fun ε : ℝ => Φ i (ε, y)) =
      fun ε => pcrL0Z G (fun y' : E3 => y' 0 - ε * w (hpProj y')) i y :=
    fun i y => funext fun ε => hΦ i (ε, y)
  have hpd2 : ∀ b, ContDiff ℝ ∞ (pd2 b w) := fun b =>
    (hw.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
  have hFs : ContDiff ℝ ∞ (fun q : (ℝ × E3) × E3 => q.2 0 - q.1.1 * w (hpProj q.2)) :=
    ((EuclideanSpace.proj (0:Fin 3)).contDiff.comp contDiff_snd).sub
      ((contDiff_fst.comp contDiff_fst).mul (hw.comp (hPs.comp contDiff_snd)))
  have hQs : ∀ j : Fin 3, ContDiff ℝ ∞ (fun p : ℝ × E3 =>
      partialDeriv j (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) p.2) := by
    intro j
    exact (hFs.fderiv (f := fun (p : ℝ × E3) (y' : E3) => y' 0 - p.1 * w (hpProj y'))
      contDiff_snd (by simp)).clm_apply contDiff_const
  have hΦs : ∀ i, ContDiffOn ℝ ∞ (Φ i) (Set.univ ×ˢ Ω) := by
    intro i
    have hσ' : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => Real.sqrt (G p.2).det) (Set.univ ×ˢ Ω) :=
      hσs.comp contDiffOn_snd (fun p hp => hp.2)
    have hM' : ∀ a b, ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2)⁻¹ a b) (Set.univ ×ˢ Ω) :=
      fun a b => (hMs a b).comp contDiffOn_snd (fun p hp => hp.2)
    have hnum : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => Real.sqrt (G p.2).det *
        ∑ j : Fin 3, (G p.2)⁻¹ i j *
          partialDeriv j (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) p.2) (Set.univ ×ˢ Ω) :=
      hσ'.mul (ContDiffOn.sum fun j _ => (hM' i j).mul (hQs j).contDiffOn)
    have hr : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => ∑ k : Fin 3, ∑ l : Fin 3, (G p.2)⁻¹ k l *
        partialDeriv k (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) p.2 *
        partialDeriv l (fun y' : E3 => y' 0 - p.1 * w (hpProj y')) p.2) (Set.univ ×ˢ Ω) :=
      ContDiffOn.sum fun k _ => ContDiffOn.sum fun l _ =>
        ((hM' k l).mul (hQs k).contDiffOn).mul (hQs l).contDiffOn
    have hsq := hr.sqrt (fun p hp => (hrad p.1 p.2 hp.2).ne')
    have hdiv' := hnum.div hsq (fun p hp => (Real.sqrt_pos.mpr (hrad p.1 p.2 hp.2)).ne')
    refine hdiv'.congr (fun p _ => ?_)
    rw [hΦ]; rfl
  have hΦd : ∀ i, ∀ p ∈ (Set.univ ×ˢ Ω : Set (ℝ × E3)), DifferentiableAt ℝ (Φ i) p :=
    fun i p hp => ((hΦs i).contDiffAt (hUo.mem_nhds hp)).differentiableAt (by simp)
  
  have hslot : ∀ (i : Fin 3) (t : ℝ) (z : E3), z ∈ Ω →
      partialDeriv i (fun y' => Φ i (t, y')) z = fderiv ℝ (Φ i) (t, z) ((0:ℝ), e i) := by
    intro i t z hz
    have h1 : HasFDerivAt (fun y' : E3 => Φ i (t, y'))
        ((fderiv ℝ (Φ i) (t, z)).comp (ContinuousLinearMap.inr ℝ ℝ E3)) z :=
      (hΦd i (t, z) ⟨Set.mem_univ _, hz⟩).hasFDerivAt.comp z (hasFDerivAt_prodMk_right t z)
    rw [partialDeriv, h1.fderiv]
    simp
  have hεslot : ∀ (i : Fin 3) (y : E3), y ∈ Ω →
      HasDerivAt (fun ε : ℝ => Φ i (ε, y)) (fderiv ℝ (Φ i) ((0:ℝ), y) ((1:ℝ), (0:E3))) 0 := by
    intro i y hy
    have hc : HasDerivAt (fun ε : ℝ => (ε, y)) ((1:ℝ), (0:E3)) 0 :=
      (hasDerivAt_id (0:ℝ)).prodMk (hasDerivAt_const (0:ℝ) y)
    exact (hΦd i _ ⟨Set.mem_univ _, hy⟩).hasFDerivAt.comp_hasDerivAt_of_eq 0 hc rfl
  have hE0 : ∀ y ∈ Ω, fderiv ℝ (Φ 0) ((0:ℝ), y) ((1:ℝ), (0:E3)) = 0 := fun y hy =>
    (hεslot 0 y hy).unique (by rw [hΦε]; exact (hV y hy).1)
  have hEs : ∀ (a : Fin 2), ∀ y ∈ Ω, fderiv ℝ (Φ a.succ) ((0:ℝ), y) ((1:ℝ), (0:E3)) =
      -∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y) := fun a y hy =>
    (hεslot a.succ y hy).unique (by rw [hΦε]; exact (hV y hy).2 a)
  
  have hp₀ : ((0:ℝ), hpLift 0 x) ∈ (Set.univ ×ˢ Ω : Set (ℝ × E3)) := ⟨Set.mem_univ _, hy₀⟩
  have hΦat : ∀ i, ContDiffAt ℝ ∞ (Φ i) ((0:ℝ), hpLift 0 x) :=
    fun i => (hΦs i).contDiffAt (hUo.mem_nhds hp₀)
  obtain ⟨B, hBdef⟩ : ∃ B : Fin 3 → (ℝ × E3) →L[ℝ] (ℝ × E3) →L[ℝ] ℝ,
      ∀ i, B i = fderiv ℝ (fderiv ℝ (Φ i)) ((0:ℝ), hpLift 0 x) := ⟨_, fun _ => rfl⟩
  have hB : ∀ i, HasFDerivAt (fderiv ℝ (Φ i)) (B i) ((0:ℝ), hpLift 0 x) := by
    intro i
    rw [hBdef i]
    have h12 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
      rw [one_add_one_eq_two]; exact WithTop.coe_le_coe.mpr le_top
    exact (((hΦat i).fderiv_right h12).differentiableAt one_ne_zero).hasFDerivAt
  have hsym : ∀ i (v v' : ℝ × E3), B i v v' = B i v' v := by
    intro i v v'
    rw [hBdef i]
    exact ((hΦat i).isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)).eq v v'
  have hD : ∀ i (v : ℝ × E3), HasFDerivAt (fun p => fderiv ℝ (Φ i) p v) ((B i).flip v)
      ((0:ℝ), hpLift 0 x) := by
    intro i v
    have h := (hB i).clm_apply (hasFDerivAt_const v ((0:ℝ), hpLift 0 x))
    simpa using h
  have hEder : ∀ i, HasFDerivAt (fun y => fderiv ℝ (Φ i) ((0:ℝ), y) ((1:ℝ), (0:E3)))
      (((B i).flip ((1:ℝ), (0:E3))).comp (ContinuousLinearMap.inr ℝ ℝ E3)) (hpLift 0 x) :=
    fun i => (hD i ((1:ℝ), (0:E3))).comp (hpLift 0 x) (hasFDerivAt_prodMk_right (0:ℝ) (hpLift 0 x))
  
  have hV0 : B 0 ((0:ℝ), e 0) ((1:ℝ), (0:E3)) = 0 := by
    have h1 := (hEder 0).congr_of_eventuallyEq (f₁ := fun _ => (0:ℝ))
      (Filter.eventually_of_mem (hΩo.mem_nhds hy₀) (fun y hy => (hE0 y hy).symm))
    have h2 := h1.unique (hasFDerivAt_const (0:ℝ) (hpLift 0 x))
    have h3 := congrArg (fun T => T (e 0)) h2
    simpa using h3
  have hAd : ∀ a b, DifferentiableAt ℝ (fun y => pcrL0A G y a b) (hpLift 0 x) := fun a b =>
    ((hAs a b).contDiffAt (hΩo.mem_nhds hy₀)).differentiableAt (by simp)
  have hga : ∀ a : Fin 2, DifferentiableAt ℝ
      (fun y => ∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)) (hpLift 0 x) := by
    intro a
    apply DifferentiableAt.fun_sum
    intro b _
    exact (hAd a b).mul ((((hpd2 b).comp hPs).differentiable (by simp)) _)
  have hVs : ∀ a : Fin 2, B a.succ ((0:ℝ), e a.succ) ((1:ℝ), (0:E3)) =
      -pd2 a (fun x' => ∑ b : Fin 2, pcrL0A G (hpLift 0 x') a b * pd2 b w x') x := by
    intro a
    have h1 := (hEder a.succ).congr_of_eventuallyEq
      (f₁ := fun y => -(∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)))
      (Filter.eventually_of_mem (hΩo.mem_nhds hy₀) (fun y hy => (hEs a y hy).symm))
    have h2 := h1.unique (hga a).hasFDerivAt.neg
    have h3 := congrArg (fun T => T (e a.succ)) h2
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply,
      ContinuousLinearMap.flip_apply, ContinuousLinearMap.neg_apply] at h3
    rw [h3]
    congr 1
    have hfun : (fun x' : E2 => ∑ b : Fin 2, pcrL0A G (hpLift 0 x') a b * pd2 b w x') =
        fun x' => ∑ b : Fin 2, pcrL0A G (L x') a b * pd2 b w (hpProj (L x')) := by
      funext x'; rw [← hLeq x', hPL]
    have hga' : DifferentiableAt ℝ
        (fun y => ∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)) (L x) := by
      rw [← hLeq x]; exact hga a
    have hcomp : HasFDerivAt
        (fun x' => ∑ b : Fin 2, pcrL0A G (L x') a b * pd2 b w (hpProj (L x')))
        ((fderiv ℝ (fun y => ∑ b : Fin 2, pcrL0A G y a b * pd2 b w (hpProj y)) (L x)).comp L)
        x :=
      hga'.hasFDerivAt.comp x L.hasFDerivAt
    show _ = fderiv ℝ (fun x' : E2 => ∑ b : Fin 2, pcrL0A G (hpLift 0 x') a b * pd2 b w x') x
      (e2 a)
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, hLe, ← hLeq x]
  
  obtain ⟨u, hu⟩ : ∃ u : E3, u = w x • e 0 := ⟨_, rfl⟩
  have hγ : ∀ s : ℝ, hpLift 0 x + s • u = hpLift (s * w x) x := by
    intro s; rw [hu, smul_smul, hLift (s * w x) x]
  have hγd : HasDerivAt (fun s : ℝ => hpLift 0 x + s • u) u 0 := by
    simpa using ((hasDerivAt_id (0:ℝ)).smul_const u).const_add (hpLift 0 x)
  have hγev : ∀ᶠ ε in 𝓝 (0:ℝ), hpLift 0 x + ε • u ∈ Ω := by
    have hmem : Ω ∈ 𝓝 (hpLift 0 x + (0:ℝ) • u) := by
      rw [zero_smul, add_zero]; exact hΩo.mem_nhds hy₀
    exact hγd.continuousAt.preimage_mem_nhds hmem
  have hσd : DifferentiableAt ℝ (fun y => Real.sqrt (G y).det) (hpLift 0 x) :=
    (hσs.contDiffAt (hΩo.mem_nhds hy₀)).differentiableAt (by simp)
  have hσγ : HasDerivAt (fun s : ℝ => Real.sqrt (G (hpLift 0 x + s • u)).det)
      (fderiv ℝ (fun y => Real.sqrt (G y).det) (hpLift 0 x) u) 0 :=
    hσd.hasFDerivAt.comp_hasDerivAt_of_eq 0 hγd (by simp)
  have hlin : HasDerivAt (fun s : ℝ => s * w x) (w x) 0 := by
    simpa using (hasDerivAt_id (0:ℝ)).mul_const (w x)
  have hl2 : HasDerivAt (fun t => levelMeanCurvCoord G (fun y => y 0) (hpLift t x)) 0
      (0 * w x) := by
    rw [zero_mul]; exact hleaf.2
  have hf0 : (fun y' : E3 => y' 0 - (0:ℝ) * w (hpProj y')) = fun y => y 0 := by
    funext y; simp
  have hleafeq : ∀ s : ℝ, hpLift 0 x + s • u ∈ Ω →
      ∑ i : Fin 3, fderiv ℝ (Φ i) ((0:ℝ), hpLift 0 x + s • u) ((0:ℝ), e i) =
        Real.sqrt (G (hpLift 0 x + s • u)).det *
          ((fun t => levelMeanCurvCoord G (fun y => y 0) (hpLift t x)) ∘ fun s => s * w x) s := by
    intro s hs
    have h1 : ∑ i : Fin 3, fderiv ℝ (Φ i) ((0:ℝ), hpLift 0 x + s • u) ((0:ℝ), e i) =
        ∑ i : Fin 3, partialDeriv i (pcrL0Z G (fun y' : E3 => y' 0 - (0:ℝ) * w (hpProj y')) i)
          (hpLift 0 x + s • u) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hZΦ 0 i, hslot i 0 _ hs]
    rw [h1, ← hK 0 _ hs, hf0, hγ s]
    rfl
  
  have hleafterm : ∑ i : Fin 3, B i ((0:ℝ), u) ((0:ℝ), e i) = 0 := by
    have hc' : HasDerivAt (fun s : ℝ => ((0:ℝ), hpLift 0 x + s • u)) ((0:ℝ), u) 0 :=
      (hasDerivAt_const (0:ℝ) (0:ℝ)).prodMk hγd
    have hc0' : ((0:ℝ), hpLift 0 x) = (fun s : ℝ => ((0:ℝ), hpLift 0 x + s • u)) 0 := by simp
    have hLd : HasDerivAt
        (fun s : ℝ => ∑ i : Fin 3, fderiv ℝ (Φ i) ((0:ℝ), hpLift 0 x + s • u) ((0:ℝ), e i))
        (∑ i : Fin 3, B i ((0:ℝ), u) ((0:ℝ), e i)) 0 := by
      apply HasDerivAt.fun_sum
      intro i _
      have h := (hD i ((0:ℝ), e i)).comp_hasDerivAt_of_eq (0:ℝ) hc' hc0'
      rw [ContinuousLinearMap.flip_apply] at h
      exact h
    have hRd := (hσγ.mul (hl2.comp 0 hlin)).congr_of_eventuallyEq
      (hγev.mono fun s hs => hleafeq s hs)
    rw [hLd.unique hRd]
    simp [hleaf.1]
  
  have hF' : ∑ i : Fin 3, B i ((1:ℝ), u) ((0:ℝ), e i) =
      -∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, pcrL0A G (hpLift 0 x') a b * pd2 b w x') x := by
    have hsplit : ∀ i, B i ((1:ℝ), u) ((0:ℝ), e i) =
        B i ((0:ℝ), e i) ((1:ℝ), (0:E3)) + B i ((0:ℝ), u) ((0:ℝ), e i) := by
      intro i
      have : ((1:ℝ), u) = ((1:ℝ), (0:E3)) + ((0:ℝ), u) := by ext <;> simp
      rw [this, map_add, ContinuousLinearMap.add_apply, hsym i ((1:ℝ), (0:E3))]
    rw [Finset.sum_congr rfl (fun i _ => hsplit i), Finset.sum_add_distrib, hleafterm, add_zero,
      Fin.sum_univ_succ, hV0, zero_add, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun a _ => hVs a)
  have hFd : HasDerivAt
      (fun ε : ℝ => ∑ i : Fin 3, fderiv ℝ (Φ i) (ε, hpLift 0 x + ε • u) ((0:ℝ), e i))
      (∑ i : Fin 3, B i ((1:ℝ), u) ((0:ℝ), e i)) 0 := by
    have hc : HasDerivAt (fun ε : ℝ => (ε, hpLift 0 x + ε • u)) ((1:ℝ), u) 0 :=
      (hasDerivAt_id (0:ℝ)).prodMk hγd
    have hc0 : ((0:ℝ), hpLift 0 x) = (fun ε : ℝ => (ε, hpLift 0 x + ε • u)) 0 := by simp
    apply HasDerivAt.fun_sum
    intro i _
    have h := (hD i ((0:ℝ), e i)).comp_hasDerivAt_of_eq (0:ℝ) hc hc0
    rw [ContinuousLinearMap.flip_apply] at h
    exact h
  have hσne : Real.sqrt (G (hpLift 0 x)).det ≠ 0 := (hσpos _ hy₀).ne'
  have hsc0 : Real.sqrt (G (hpLift 0 x + (0:ℝ) • u)).det = Real.sqrt (G (hpLift 0 x)).det := by
    rw [zero_smul, add_zero]
  have hscne : Real.sqrt (G (hpLift 0 x + (0:ℝ) • u)).det ≠ 0 := by rw [hsc0]; exact hσne
  have hF0 : ∑ i : Fin 3, fderiv ℝ (Φ i) ((0:ℝ), hpLift 0 x + (0:ℝ) • u) ((0:ℝ), e i) = 0 := by
    rw [hleafeq 0 (by rw [zero_smul, add_zero]; exact hy₀)]
    simp [hleaf.1]
  have hmaineq : ∀ ε : ℝ, hpLift 0 x + ε • u ∈ Ω →
      pcrH G (fun x' => ε * w x') x =
        (∑ i : Fin 3, fderiv ℝ (Φ i) (ε, hpLift 0 x + ε • u) ((0:ℝ), e i)) /
          Real.sqrt (G (hpLift 0 x + ε • u)).det := by
    intro ε hε
    have h1 : pcrH G (fun x' => ε * w x') x =
        levelMeanCurvCoord G (fun y' : E3 => y' 0 - ε * w (hpProj y')) (hpLift 0 x + ε • u) := by
      rw [hγ ε]; rfl
    have h3 : ∑ i : Fin 3, partialDeriv i (pcrL0Z G (fun y' : E3 => y' 0 - ε * w (hpProj y')) i)
        (hpLift 0 x + ε • u) =
        ∑ i : Fin 3, fderiv ℝ (Φ i) (ε, hpLift 0 x + ε • u) ((0:ℝ), e i) :=
      Finset.sum_congr rfl (fun i _ => by rw [hZΦ ε i, hslot i ε _ hε])
    rw [h1, eq_div_iff (hσpos _ hε).ne', mul_comm, hK ε _ hε, h3]
  refine HasDerivAt.congr_deriv
    (HasDerivAt.congr_of_eventuallyEq (hFd.div hσγ hscne) ?_) ?_
  · exact hγev.mono fun ε hε => hmaineq ε hε
  · rw [hF', hF0, hsc0]
    field_simp
    ring

theorem pcr_lin0_divergence {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (s₁ : ℝ) (hs₁ : 0 < s₁)
    (G : Fin P.n → E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hGs : ∀ j (a b : Fin 3), ContDiffOn ℝ ∞ (fun y => G j y a b)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j})
    (hGsymm : ∀ j (y : E3) (a b : Fin 3), G j y a b = G j y b a)
    (hGpd : ∀ j, ∀ y : E3, |y 0| < s₁ → hpProj y ∈ P.W j → (G j y).PosDef)
    (hGc : ∀ j k, ∀ s ∈ Set.Ioo (-s₁) s₁, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      G j (hpLift s x) = pullbackMetric (G k)
        (fun y => hpLift (y 0) (P.proj k (P.param j (hpProj y)))) (hpLift s x))
    (hleaf : ∀ j, ∀ x ∈ P.W j,
      levelMeanCurvCoord (G j) (fun y => y 0) (hpLift 0 x) = 0 ∧
      HasDerivAt (fun s => levelMeanCurvCoord (G j) (fun y => y 0) (hpLift s x)) 0 0) :
    ∃ (wd : Fin P.n → E2 → ℝ) (A : Fin P.n → E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ j, ContDiffOn ℝ ∞ (wd j) (P.W j)) ∧ (∀ j, ∀ x ∈ P.W j, 0 < wd j x) ∧
      (∀ j (a b : Fin 2), ContDiffOn ℝ ∞ (fun x => A j x a b) (P.W j)) ∧
      (∀ j, ∀ x ∈ P.W j, (A j x).PosDef) ∧
      (∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        wd j x = |(fderiv ℝ (fun x' => P.proj k (P.param j x')) x).det| *
          wd k (P.proj k (P.param j x)) ∧
        ∀ c d : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
            fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c * A j x a b *
              fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) d =
          |(fderiv ℝ (fun x' => P.proj k (P.param j x')) x).det| *
            A k (P.proj k (P.param j x)) c d) ∧
      (∀ j (w : E2 → ℝ) (x : E2), x ∈ P.W j → ContDiffAt ℝ 2 w x →
        HasDerivAt (fun ε : ℝ => pcrH (G j) (fun x' => ε * w x') x)
          (-(wd j x)⁻¹ * ∑ a : Fin 2,
            pd2 a (fun x' => ∑ b : Fin 2, A j x' a b * pd2 b w x') x) 0) :=
by
  classical
  have hL0 : ∀ (t : ℝ) (x : E2), (hpLift t x) 0 = t := by
    intro t x
    simp [hpLift, cylPt]
  have hPL : ∀ (t : ℝ) (x : E2), hpProj (hpLift t x) = x := by
    intro t x
    ext i
    fin_cases i <;> simp [hpProj, hpLift, cylPt]
  have hPcont : Continuous hpProj := by
    unfold hpProj
    refine (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp
      (f := fun z : E3 => ![z 1, z 2]) ?_
    refine continuous_pi fun i => ?_
    fin_cases i
    · exact (EuclideanSpace.proj (1 : Fin 3)).continuous
    · exact (EuclideanSpace.proj (2 : Fin 3)).continuous
  have hιs : ContDiff ℝ ∞ (fun x : E2 => hpLift 0 x) := by
    unfold hpLift cylPt
    fun_prop
  have hΩo : ∀ j, IsOpen {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j} := by
    intro j
    exact (isOpen_lt (continuous_abs.comp (EuclideanSpace.proj (0 : Fin 3)).continuous)
      continuous_const).inter ((P.W_open j).preimage hPcont)
  have hmaps : ∀ j, Set.MapsTo (fun x : E2 => hpLift 0 x) (P.W j)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j} := by
    intro j x hx
    refine ⟨?_, ?_⟩
    · rw [hL0, abs_zero]; exact hs₁
    · rw [hPL]; exact hx
  have hGpd' : ∀ j, ∀ y ∈ {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j}, (G j y).PosDef :=
    fun j y hy => hGpd j y hy.1 hy.2
  have R1 := fun j => pcr_l0_coeff_regular {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j} (G j)
    (hGs j) (hGsymm j) (hGpd' j)
  refine ⟨fun j x => Real.sqrt (G j (hpLift 0 x)).det,
    fun j x => pcrL0A (G j) (hpLift 0 x), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro j
    exact (R1 j).2.2.1.comp hιs.contDiffOn (hmaps j)
  · intro j x hx
    exact Real.sqrt_pos.mpr ((R1 j).2.1 _ (hmaps j hx))
  · intro j a b
    exact ((R1 j).2.2.2.2.2.1 a b).comp hιs.contDiffOn (hmaps j)
  · intro j x hx
    exact (R1 j).2.2.2.2.2.2 _ (hmaps j hx)
  · intro j k x hx
    have hopen : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
    have hτ : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
      ((P.trans_smooth j k).differentiableOn (by simp)).differentiableAt (hopen.mem_nhds hx)
    exact pcr_l0_coeff_compat (G j) (G k) (fun x' => P.proj k (P.param j x')) x hτ
      (hGpd' j _ (hmaps j hx.1)) (hGc j k 0 ⟨by linarith, hs₁⟩ x hx)
  · intro j w x hx hw2
    have hA : ∀ a b : Fin 2,
        DifferentiableAt ℝ (fun x' => pcrL0A (G j) (hpLift 0 x') a b) x :=
      fun a b => ((((R1 j).2.2.2.2.2.1 a b).comp hιs.contDiffOn (hmaps j)).differentiableOn
        (by simp)).differentiableAt ((P.W_open j).mem_nhds hx)
    obtain ⟨T, hTs, hT0, hT1, hT2, hRHS⟩ :
        ∃ T : E2 → ℝ, ContDiff ℝ ∞ T ∧ T x = w x ∧ fderiv ℝ T x = fderiv ℝ w x ∧
          fderiv ℝ (fderiv ℝ T) x = fderiv ℝ (fderiv ℝ w) x ∧
          ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2,
              pcrL0A (G j) (hpLift 0 x') a b * pd2 b T x') x =
            ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2,
              pcrL0A (G j) (hpLift 0 x') a b * pd2 b w x') x :=
      pcr_l0_taylor_reduce (fun x' => pcrL0A (G j) (hpLift 0 x')) w x hA hw2
    have hT2' : ContDiffAt ℝ 2 T x := hTs.contDiffAt.of_le
      (by first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | norm_num
        | simp)
    have hfun : (fun ε : ℝ => pcrH (G j) (fun x' => ε * w x') x) =
        (fun ε : ℝ => pcrH (G j) (fun x' => ε * T x') x) :=
      funext (fun ε => pcr_l0_jet_congr (G j) w T x hw2 hT2' hT0 hT1 hT2 ε)
    obtain ⟨hM, hdet, hσ, -, hMpos, hAs, -⟩ := R1 j
    have key := pcr_l0_smooth_lin (P.W j) (P.W_open j) s₁ hs₁ (G j) hM hσ
      (fun y hy => Real.sqrt_pos.mpr (hdet y hy)) hMpos hAs T hTs
      (fun f hf hS y hy => pcr_lmc_div_form _ (hΩo j) (G j) (hGs j) (hGsymm j) (hGpd' j) hM
        f hf hS y hy)
      (fun y hy => pcr_l0_vert_deriv (G j) T y (hGsymm j y) (hGpd' j y hy)
        (hTs.differentiable (by simp) _))
      x hx (hleaf j x hx)
    rw [hfun]
    show HasDerivAt _ (-(Real.sqrt (G j (hpLift 0 x)).det)⁻¹ * ∑ a : Fin 2,
      pd2 a (fun x' => ∑ b : Fin 2, pcrL0A (G j) (hpLift 0 x') a b * pd2 b w x') x) 0
    rw [← hRHS]
    exact key

theorem pcr_div_holLoc_toolkit (α : ℝ) (hα0 : 0 < α) (hα1 : α ≤ 1) (U : Set E2) (hU : IsOpen U) :
    (∀ (m : ℕ) (w₁ w₂ : E2 → ℝ), pcrHolLoc α m w₁ U → Set.EqOn w₁ w₂ U → pcrHolLoc α m w₂ U) ∧
    (∀ (m : ℕ) (w : E2 → ℝ) (c : ℝ), pcrHolLoc α m w U → pcrHolLoc α m (fun x => w x - c) U) ∧
    (∀ (g φ : E2 → ℝ) (κ : ℝ), pcrHolLoc α 0 g U → ContDiffOn ℝ 1 φ U →
      pcrHolLoc α 0 (fun x => (g x + κ) * φ x) U) :=
by
  have h0 : ∀ (f : E2 → ℝ) (y z : E2),
      ‖iteratedFDeriv ℝ 0 f y - iteratedFDeriv ℝ 0 f z‖ = |f y - f z| := by
    intro f y z
    rw [iteratedFDeriv_zero_eq_comp]
    simp only [Function.comp_apply]
    rw [← map_sub, LinearIsometryEquiv.norm_map, Real.norm_eq_abs]
  refine ⟨?_, ?_, ?_⟩
  · intro m w₁ w₂ h₁ heq
    refine ⟨h₁.1.congr (fun x hx => (heq hx).symm), fun x hx => ?_⟩
    obtain ⟨ρ, hρ, hb, C, hC⟩ := h₁.2 x hx
    have hit : ∀ u ∈ U, iteratedFDeriv ℝ m w₂ u = iteratedFDeriv ℝ m w₁ u := by
      intro u hu
      have hev : w₂ =ᶠ[nhds u] w₁ :=
        Filter.eventually_of_mem (hU.mem_nhds hu) (fun y hy => (heq hy).symm)
      exact (hev.iteratedFDeriv ℝ m).eq_of_nhds
    refine ⟨ρ, hρ, hb, C, fun y hy z hz => ?_⟩
    rw [hit y (hb hy), hit z (hb hz)]
    exact hC y hy z hz
  · intro m w c hw
    refine ⟨hw.1.sub contDiffOn_const, fun x hx => ?_⟩
    obtain ⟨ρ, hρ, hb, C, hC⟩ := hw.2 x hx
    refine ⟨ρ, hρ, hb, C, fun y hy z hz => ?_⟩
    rcases Nat.eq_zero_or_pos m with hm | hm
    · subst hm
      have h1 := hC y hy z hz
      rw [h0] at h1
      refine (h0 _ y z).trans_le ?_
      show |(w y - c) - (w z - c)| ≤ _
      rw [sub_sub_sub_cancel_right]
      exact h1
    · have hit : ∀ u ∈ U, iteratedFDeriv ℝ m (fun x => w x - c) u =
          iteratedFDeriv ℝ m w u := by
        intro u hu
        have e : (fun x => w x - c) = (fun x => w x + (fun _ : E2 => -c) x) := by
          funext x
          simp [sub_eq_add_neg]
        rw [e, iteratedFDeriv_add_apply' (hw.1.contDiffAt (hU.mem_nhds hu)) contDiffAt_const,
          iteratedFDeriv_const_of_ne (by omega : m ≠ 0) (-c)]
        simp
      rw [hit y (hb hy), hit z (hb hz)]
      exact hC y hy z hz
  · intro g φ κ hg hφ
    refine ⟨?_, fun x hx => ?_⟩
    · have h1 : ContDiffOn ℝ ((0 : ℕ) : WithTop ℕ∞) φ U := hφ.of_le (by simp)
      exact (hg.1.add contDiffOn_const).mul h1
    obtain ⟨ρ₁, hρ₁, hb₁, C, hC⟩ := hg.2 x hx
    obtain ⟨K, t, ht, hK⟩ := (hφ.contDiffAt (hU.mem_nhds hx)).exists_lipschitzOnWith
    obtain ⟨ρ₂, hρ₂, hb₂⟩ := Metric.mem_nhds_iff.mp ht
    have hρ : 0 < min (min ρ₁ ρ₂) (1 / 2 : ℝ) := lt_min (lt_min hρ₁ hρ₂) (by norm_num)
    have hs1 : Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)) ⊆ Metric.ball x ρ₁ :=
      Metric.ball_subset_ball ((min_le_left _ _).trans (min_le_left _ _))
    have hs2 : Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)) ⊆ Metric.ball x ρ₂ :=
      Metric.ball_subset_ball ((min_le_left _ _).trans (min_le_right _ _))
    have hρh : min (min ρ₁ ρ₂) (1 / 2 : ℝ) ≤ 1 / 2 := min_le_right _ _
    have hgH : ∀ y ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)),
        ∀ z ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)),
        |g y - g z| ≤ |C| * dist y z ^ α := by
      intro y hy z hz
      have h1 := hC y (hs1 hy) z (hs1 hz)
      rw [h0] at h1
      exact h1.trans (mul_le_mul_of_nonneg_right (le_abs_self C)
        (Real.rpow_nonneg dist_nonneg _))
    have hφL : ∀ y ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)),
        ∀ z ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)),
        |φ y - φ z| ≤ (K : ℝ) * dist y z := by
      intro y hy z hz
      have h1 := hK.dist_le_mul y (hb₂ (hs2 hy)) z (hb₂ (hs2 hz))
      rwa [Real.dist_eq] at h1
    have hdlt : ∀ y ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)),
        ∀ z ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)), dist y z ≤ 1 := by
      intro y hy z hz
      rw [Metric.mem_ball] at hy hz
      have h1 := dist_triangle y x z
      rw [dist_comm x z] at h1
      linarith
    have hpow1 : ∀ d : ℝ, 0 ≤ d → d ≤ 1 → d ^ α ≤ 1 :=
      fun d h0' h1 => Real.rpow_le_one h0' h1 hα0.le
    have hpowd : ∀ d : ℝ, 0 ≤ d → d ≤ 1 → d ≤ d ^ α := by
      intro d h0' h1
      have h2 := Real.rpow_le_rpow_of_exponent_ge' h0' h1 hα0.le hα1
      rwa [Real.rpow_one] at h2
    have hxb : x ∈ Metric.ball x (min (min ρ₁ ρ₂) (1 / 2 : ℝ)) := Metric.mem_ball_self hρ
    refine ⟨min (min ρ₁ ρ₂) (1 / 2 : ℝ), hρ, hs1.trans hb₁,
      |C| * (|φ x| + K) + (|g x + κ| + |C|) * K, fun y hy z hz => ?_⟩
    refine (h0 _ y z).trans_le ?_
    show |(g y + κ) * φ y - (g z + κ) * φ z| ≤ _
    have hd0 : 0 ≤ dist y z := dist_nonneg
    have hd1 : dist y z ≤ 1 := hdlt y hy z hz
    have hda0 : 0 ≤ dist y z ^ α := Real.rpow_nonneg hd0 _
    have hdda := hpowd (dist y z) hd0 hd1
    have hK0 : (0 : ℝ) ≤ K := K.coe_nonneg
    have hC0 : 0 ≤ |C| := abs_nonneg C
    have hφy : |φ y| ≤ |φ x| + K := by
      have h1 := hφL y hy x hxb
      have h2 : dist y x ≤ 1 := hdlt y hy x hxb
      have h3 : |φ y - φ x| ≤ K := h1.trans (by nlinarith)
      have h4 := abs_sub_abs_le_abs_sub (φ y) (φ x)
      linarith
    have hgz : |g z + κ| ≤ |g x + κ| + |C| := by
      have h1 := hgH z hz x hxb
      have h2 : dist z x ^ α ≤ 1 := hpow1 _ dist_nonneg (hdlt z hz x hxb)
      have h3 : |g z - g x| ≤ |C| := h1.trans (by nlinarith)
      have e : g z + κ = (g x + κ) + (g z - g x) := by ring
      rw [e]
      exact (abs_add_le _ _).trans (by linarith)
    have hgyz := hgH y hy z hz
    have hφyz := hφL y hy z hz
    have e : (g y + κ) * φ y - (g z + κ) * φ z =
        (g y - g z) * φ y + (g z + κ) * (φ y - φ z) := by ring
    rw [e]
    calc |(g y - g z) * φ y + (g z + κ) * (φ y - φ z)|
        ≤ |g y - g z| * |φ y| + |g z + κ| * |φ y - φ z| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ (|C| * dist y z ^ α) * (|φ x| + K) + (|g x + κ| + |C|) * (K * dist y z ^ α) := by
          apply add_le_add
          · exact mul_le_mul hgyz hφy (abs_nonneg _) (by positivity)
          · exact mul_le_mul hgz (hφyz.trans (mul_le_mul_of_nonneg_left hdda hK0))
              (abs_nonneg _) (by positivity)
      _ = (|C| * (|φ x| + K) + (|g x + κ| + |C|) * K) * dist y z ^ α := by ring

theorem pcr_div_op_toolkit (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) W) :
    (∀ w₁ w₂ : E2 → ℝ, ContDiffOn ℝ 2 w₁ W → ContDiffOn ℝ 2 w₂ W → ∀ x ∈ W,
      ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b (fun y => w₁ y - w₂ y) x') x =
        ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w₁ x') x -
          ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w₂ x') x) ∧
    (∀ w₁ w₂ : E2 → ℝ, Set.EqOn w₁ w₂ W → ∀ x ∈ W,
      ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w₁ x') x =
        ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w₂ x') x) ∧
    (∀ (w : E2 → ℝ) (c : ℝ), Set.EqOn w (fun _ => c) W → ∀ x ∈ W,
      ∑ a : Fin 2, pd2 a (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w x') x = 0) :=
by
  have loc : ∀ (f g : E2 → ℝ), Set.EqOn f g W → ∀ z ∈ W, ∀ i : Fin 2,
      pd2 i f z = pd2 i g z := by
    intro f g hfg z hz i
    have hev : f =ᶠ[𝓝 z] g := Filter.eventually_of_mem (hW.mem_nhds hz) (fun y hy => hfg hy)
    unfold pd2
    rw [hev.fderiv_eq]
  have hsub : ∀ (f g : E2 → ℝ) (z : E2) (i : Fin 2), DifferentiableAt ℝ f z →
      DifferentiableAt ℝ g z → pd2 i (fun y => f y - g y) z = pd2 i f z - pd2 i g z := by
    intro f g z i hf hg
    unfold pd2
    rw [fderiv_fun_sub hf hg]
    rfl
  refine ⟨?_, ?_, ?_⟩
  · intro w₁ w₂ h1 h2 x hx
    have hd : ∀ (w : E2 → ℝ), ContDiffOn ℝ 2 w W → ∀ x' ∈ W, DifferentiableAt ℝ w x' :=
      fun w hw x' hx' => (hw.differentiableOn (by norm_num)).differentiableAt (hW.mem_nhds hx')
    have hinner : ∀ a : Fin 2, Set.EqOn
        (fun x' => ∑ b : Fin 2, A x' a b * pd2 b (fun y => w₁ y - w₂ y) x')
        (fun x' => (∑ b : Fin 2, A x' a b * pd2 b w₁ x') - ∑ b : Fin 2, A x' a b * pd2 b w₂ x')
        W := by
      intro a x' hx'
      simp only
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [← mul_sub, hsub w₁ w₂ x' b (hd w₁ h1 x' hx') (hd w₂ h2 x' hx')]
    have hpd : ∀ (w : E2 → ℝ), ContDiffOn ℝ 2 w W → ∀ b : Fin 2,
        ContDiffOn ℝ 1 (fun x' => pd2 b w x') W := by
      intro w hw b
      have := hw.fderiv_of_isOpen hW (by norm_num : (1 : WithTop ℕ∞) + 1 ≤ 2)
      exact this.clm_apply contDiffOn_const
    have hΦ : ∀ (w : E2 → ℝ), ContDiffOn ℝ 2 w W → ∀ a : Fin 2,
        DifferentiableAt ℝ (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w x') x := by
      intro w hw a
      have hm := hW.mem_nhds hx
      refine DifferentiableAt.fun_sum (fun b _ => ?_)
      refine DifferentiableAt.fun_mul ?_ ?_
      · exact ((hA a b).differentiableOn (by simp)).differentiableAt hm
      · exact ((hpd w hw b).differentiableOn (by norm_num)).differentiableAt hm
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [loc _ _ (hinner a) x hx a]
    exact hsub _ _ x a (hΦ w₁ h1 a) (hΦ w₂ h2 a)
  · intro w₁ w₂ h x hx
    refine Finset.sum_congr rfl (fun a _ => loc _ _ ?_ x hx a)
    intro x' hx'
    simp only
    refine Finset.sum_congr rfl (fun b _ => ?_)
    rw [loc w₁ w₂ h x' hx' b]
  · intro w c h x hx
    refine Finset.sum_eq_zero (fun a _ => ?_)
    have h0 : Set.EqOn (fun x' => ∑ b : Fin 2, A x' a b * pd2 b w x') (fun _ => (0 : ℝ)) W := by
      intro x' hx'
      simp only
      refine Finset.sum_eq_zero (fun b _ => ?_)
      rw [loc w (fun _ => c) h x' hx' b]
      simp [pd2]
    rw [loc _ _ h0 x hx a]
    simp [pd2]

theorem pcr_kc_hess_trace_sign (W : Set E2) (hW : IsOpen W) (w : E2 → ℝ) (hw : ContDiffOn ℝ 2 w W)
    (x₀ : E2) (hx₀ : x₀ ∈ W) (A₀ : Matrix (Fin 2) (Fin 2) ℝ) (hA₀ : A₀.PosDef) :
    (IsLocalMax w x₀ → ∑ a : Fin 2, ∑ b : Fin 2, A₀ a b * pd2 a (pd2 b w) x₀ ≤ 0) ∧
    (IsLocalMin w x₀ → 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A₀ a b * pd2 a (pd2 b w) x₀) :=
by
  
  have hdir : ∀ u : E2 → ℝ, ContDiffOn ℝ 2 u W → IsLocalMax u x₀ → ∀ ξ : E2,
      fderiv ℝ (fderiv ℝ u) x₀ ξ ξ ≤ 0 := by
    intro u hu hmax ξ
    have hfd : ContDiffOn ℝ 1 (fderiv ℝ u) W := hu.fderiv_of_isOpen hW (by norm_num)
    have hD : DifferentiableAt ℝ (fderiv ℝ u) x₀ :=
      (hfd.contDiffAt (hW.mem_nhds hx₀)).differentiableAt one_ne_zero
    have hdiff : ∀ y ∈ W, DifferentiableAt ℝ u y := fun y hy =>
      (hu.contDiffAt (hW.mem_nhds hy)).differentiableAt two_ne_zero
    have hℓ : ∀ t : ℝ, HasDerivAt (fun t : ℝ => x₀ + t • ξ) ξ t := by
      intro t
      have := ((hasDerivAt_id t).smul_const ξ).const_add x₀
      simpa using this
    have hℓ0 : (fun t : ℝ => x₀ + t • ξ) 0 = x₀ := by simp
    have hℓc : Continuous (fun t : ℝ => x₀ + t • ξ) :=
      continuous_const.add (continuous_id.smul continuous_const)
    have hT : (fun t : ℝ => x₀ + t • ξ) ⁻¹' W ∈ 𝓝 (0:ℝ) := by
      apply hℓc.continuousAt.preimage_mem_nhds
      simp only [zero_smul, add_zero]; exact hW.mem_nhds hx₀
    have hgk : deriv (fun t : ℝ => u (x₀ + t • ξ)) =ᶠ[𝓝 0]
        (fun t : ℝ => fderiv ℝ u (x₀ + t • ξ) ξ) := by
      filter_upwards [hT] with t ht
      have h1 := (hdiff (x₀ + t • ξ) ht).hasFDerivAt.comp_hasDerivAt t (hℓ t)
      exact h1.deriv
    have hk : HasDerivAt (fun t : ℝ => fderiv ℝ u (x₀ + t • ξ) ξ)
        (fderiv ℝ (fderiv ℝ u) x₀ ξ ξ) 0 := by
      have h1 : HasFDerivAt (fun y => fderiv ℝ u y ξ)
          ((fderiv ℝ u x₀).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ u) x₀).flip ξ) x₀ :=
        hD.hasFDerivAt.clm_apply (hasFDerivAt_const ξ x₀)
      have h1' : HasFDerivAt (fun y => fderiv ℝ u y ξ)
          ((fderiv ℝ u x₀).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ u) x₀).flip ξ)
          ((fun t : ℝ => x₀ + t • ξ) 0) := by
        rw [hℓ0]; exact h1
      have h2 := h1'.comp_hasDerivAt (0:ℝ) (hℓ 0)
      simpa using h2
    have hdd : deriv (deriv (fun t : ℝ => u (x₀ + t • ξ))) 0 = fderiv ℝ (fderiv ℝ u) x₀ ξ ξ := by
      rw [hgk.deriv_eq]; exact hk.deriv
    have hd0 : deriv (fun t : ℝ => u (x₀ + t • ξ)) 0 = 0 := by
      rw [hgk.self_of_nhds]
      simp [hmax.fderiv_eq_zero]
    have hmaxg : IsLocalMax (fun t : ℝ => u (x₀ + t • ξ)) 0 := by
      have : IsLocalMax u (x₀ + (0:ℝ) • ξ) := by simpa using hmax
      exact IsLocalMax.comp_continuous (g := fun t : ℝ => x₀ + t • ξ) (b := (0:ℝ)) this
        hℓc.continuousAt
    have hgc : ContinuousAt (fun t : ℝ => u (x₀ + t • ξ)) 0 := by
      have hx' : x₀ + (0:ℝ) • ξ ∈ W := by simpa using hx₀
      exact ((hdiff _ hx').hasFDerivAt.comp_hasDerivAt (0:ℝ) (hℓ 0)).continuousAt
    by_contra hpos
    push_neg at hpos
    have hming : IsLocalMin (fun t : ℝ => u (x₀ + t • ξ)) 0 :=
      isLocalMin_of_deriv_deriv_pos (by rw [hdd]; exact hpos) hd0 hgc
    have hconst : (fun t : ℝ => u (x₀ + t • ξ)) =ᶠ[𝓝 0] fun _ => u (x₀ + (0:ℝ) • ξ) :=
      (Filter.Eventually.and hmaxg hming).mono (fun t ht => le_antisymm ht.1 ht.2)
    have hdg : deriv (fun t : ℝ => u (x₀ + t • ξ)) =ᶠ[𝓝 0] fun _ => (0:ℝ) := by
      filter_upwards [hconst.eventuallyEq_nhds] with t ht
      rw [ht.deriv_eq, deriv_const]
    have h0 : deriv (deriv (fun t : ℝ => u (x₀ + t • ξ))) 0 = 0 := by
      rw [hdg.deriv_eq, deriv_const]
    linarith
  
  have halg : ∀ H : Fin 2 → Fin 2 → ℝ,
      (∀ s t : ℝ, s ^ 2 * H 0 0 + s * t * (H 0 1 + H 1 0) + t ^ 2 * H 1 1 ≤ 0) →
      ∑ a : Fin 2, ∑ b : Fin 2, A₀ a b * H a b ≤ 0 := by
    intro H hQ
    have hsym : A₀ 1 0 = A₀ 0 1 := by
      have := hA₀.isHermitian.apply 0 1
      simpa using this
    have ha : 0 < A₀ 0 0 := hA₀.diag_pos
    have hdet : 0 < A₀ 0 0 * A₀ 1 1 - A₀ 0 1 * A₀ 1 0 := by
      have := hA₀.det_pos
      rwa [Matrix.det_fin_two] at this
    have h1 := hQ (A₀ 0 0) (A₀ 0 1)
    have h2 := hQ 0 1
    norm_num at h2
    simp only [Fin.sum_univ_two]
    rw [hsym] at hdet ⊢
    have hp := mul_nonpos_of_nonneg_of_nonpos hdet.le h2
    have key : A₀ 0 0 * (A₀ 0 0 * H 0 0 + A₀ 0 1 * H 0 1 + (A₀ 0 1 * H 1 0 + A₀ 1 1 * H 1 1)) =
        (A₀ 0 0 ^ 2 * H 0 0 + A₀ 0 0 * A₀ 0 1 * (H 0 1 + H 1 0) + A₀ 0 1 ^ 2 * H 1 1) +
          (A₀ 0 0 * A₀ 1 1 - A₀ 0 1 * A₀ 0 1) * H 1 1 := by ring
    by_contra hneg
    push_neg at hneg
    have := mul_pos ha hneg
    linarith
  
  have hentry : ∀ u : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ u) x₀ → ∀ a b : Fin 2,
      pd2 a (pd2 b u) x₀ = fderiv ℝ (fderiv ℝ u) x₀ (e2 a) (e2 b) := by
    intro u hD a b
    have h1 : HasFDerivAt (fun y => fderiv ℝ u y (e2 b))
        ((fderiv ℝ u x₀).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ u) x₀).flip (e2 b)) x₀ :=
      hD.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 b) x₀)
    show fderiv ℝ (fun y => fderiv ℝ u y (e2 b)) x₀ (e2 a) = _
    rw [h1.fderiv]
    simp
  
  have key : ∀ u : E2 → ℝ, ContDiffOn ℝ 2 u W → IsLocalMax u x₀ →
      ∑ a : Fin 2, ∑ b : Fin 2, A₀ a b * pd2 a (pd2 b u) x₀ ≤ 0 := by
    intro u hu hmax
    have hfd : ContDiffOn ℝ 1 (fderiv ℝ u) W := hu.fderiv_of_isOpen hW (by norm_num)
    have hD : DifferentiableAt ℝ (fderiv ℝ u) x₀ :=
      (hfd.contDiffAt (hW.mem_nhds hx₀)).differentiableAt one_ne_zero
    simp only [hentry u hD]
    apply halg (fun a b => fderiv ℝ (fderiv ℝ u) x₀ (e2 a) (e2 b))
    intro s t
    have := hdir u hu hmax (s • e2 0 + t • e2 1)
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul] at this
    nlinarith [this]
  refine ⟨key w hw, fun hmin => ?_⟩
  have h := key (fun x => -w x) hw.neg hmin.neg
  have hneg : ∀ b : Fin 2, pd2 b (fun x => -w x) = fun x => -(pd2 b w x) := by
    intro b
    funext x
    simp only [pd2]
    rw [fderiv_fun_neg]
    rfl
  have hneg2 : ∀ a b : Fin 2, pd2 a (fun x => -(pd2 b w x)) x₀ = -(pd2 a (pd2 b w) x₀) := by
    intro a b
    simp only [pd2]
    rw [fderiv_fun_neg]
    rfl
  simp only [hneg, hneg2, mul_neg, Finset.sum_neg_distrib] at h
  linarith

theorem pcr_kc_hopf_touch (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (B : E2 → Fin 2 → ℝ) (w : E2 → ℝ) (M : ℝ)
    (hA : ∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W)
    (hB : ∀ k : Fin 2, ContinuousOn (fun x => B x k) W)
    (hApd : ∀ x ∈ W, (A x).PosDef)
    (hw : ContDiffOn ℝ 2 w W) (hle : ∀ x ∈ W, w x ≤ M)
    (hsub : ∀ x ∈ W, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x +
      ∑ k : Fin 2, B x k * pd2 k w x)
    (z x₁ : E2) (R : ℝ) (hR : 0 < R) (hball : Metric.closedBall z R ⊆ W)
    (hlt : ∀ x ∈ Metric.ball z R, w x < M) (hx₁ : dist x₁ z = R) (hw₁ : w x₁ = M) : False :=
by
  
  have hAs : ∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i := by
    intro x hx i j
    simpa [star_trivial] using (hApd x hx).isHermitian.apply j i
  have hApos : ∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j := by
    intro x hx ξ hξ
    have hξv : WithLp.ofLp ξ ≠ 0 := fun h' => hξ ((WithLp.ofLp_eq_zero 2).mp h')
    have h1 := (hApd x hx).dotProduct_mulVec_pos hξv
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two] at h1
    simp only [Fin.sum_univ_two]
    linarith
  
  suffices core : ∀ w : E2 → ℝ, ContDiffOn ℝ 2 w W → (∀ x ∈ W, 0 ≤ w x) →
      (∀ x ∈ W, ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x +
        ∑ k : Fin 2, B x k * pd2 k w x ≤ 0) →
      (∀ x ∈ Metric.ball z R, 0 < w x) → w x₁ = 0 → False by
    have hd1 : ∀ (k : Fin 2) (x : E2), pd2 k (fun y => M - w y) x = -pd2 k w x := by
      intro k x
      show fderiv ℝ (fun y => M - w y) x (e2 k) = -(fderiv ℝ w x (e2 k))
      rw [fderiv_const_sub]
      rfl
    have hd1f : ∀ k : Fin 2, pd2 k (fun y => M - w y) = fun x => -pd2 k w x :=
      fun k => funext (hd1 k)
    have hd2 : ∀ (i j : Fin 2) (x : E2),
        pd2 i (pd2 j (fun y => M - w y)) x = -pd2 i (pd2 j w) x := by
      intro i j x
      rw [hd1f j]
      show fderiv ℝ (fun y => -pd2 j w y) x (e2 i) = -(fderiv ℝ (pd2 j w) x (e2 i))
      rw [fderiv_fun_neg]
      rfl
    refine core (fun y => M - w y) (contDiffOn_const.sub hw) ?_ ?_ ?_ ?_
    · intro x hx
      have := hle x hx
      show 0 ≤ M - w x
      linarith
    · intro x hx
      have := hsub x hx
      simp only [hd1, hd2, mul_neg, Finset.sum_neg_distrib]
      linarith
    · intro x hx
      have := hlt x hx
      show 0 < M - w x
      linarith
    · show M - w x₁ = 0
      rw [hw₁, sub_self]
  intro w hw hnn hsup hpos hw₁
  
  have hconst : ∀ (W : Set E2) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ)
      (w c : E2 → ℝ), (∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) →
      (∀ k : Fin 2, ContinuousOn (fun x => B x k) W) →
      (∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) →
      ContinuousOn w W → ContinuousOn c W → ∀ (z : E2) (R : ℝ), 0 < R →
      Metric.closedBall z R ⊆ W → (∀ x ∈ Metric.ball z R, 0 < w x) →
      ∃ m₀ Λ β Γ m : ℝ, 0 < m₀ ∧ 0 ≤ Λ ∧ 0 ≤ β ∧ 0 ≤ Γ ∧ 0 < m ∧
        (∀ x : E2, R / 2 ≤ dist x z → dist x z ≤ R →
          m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j ∧
          (∀ i : Fin 2, |A x i i| ≤ Λ) ∧ (∀ k : Fin 2, |B x k| ≤ β) ∧ |c x| ≤ Γ) ∧
        ∀ x : E2, dist x z = R / 2 → m ≤ w x := by
    intro W A B w c hA hB hApos hwc hc z R hR hball hpos
    have P1 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
        (∀ x ∈ K, 0 < f x) → ∃ m : ℝ, 0 < m ∧ ∀ x ∈ K, m ≤ f x := by
      intro K f hK hf hfpos
      rcases Set.eq_empty_or_nonempty K with hK0 | hKne
      · refine ⟨1, one_pos, ?_⟩
        intro x hx
        rw [hK0] at hx
        exact absurd hx (Set.notMem_empty x)
      · obtain ⟨x₀, hx₀, hmin⟩ := hK.exists_isMinOn hKne hf
        exact ⟨f x₀, hfpos x₀ hx₀, fun x hx => hmin hx⟩
    have P2 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
        ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ K, |f x| ≤ C := by
      intro K f hK hf
      obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf
      refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
      have := hC x hx
      rw [Real.norm_eq_abs] at this
      exact le_trans this (le_max_left _ _)
    set K : Set E2 := {x | R / 2 ≤ dist x z ∧ dist x z ≤ R} with hKdef
    have hKcl : IsClosed K :=
      (isClosed_le continuous_const (continuous_id.dist continuous_const)).inter
        (isClosed_le (continuous_id.dist continuous_const) continuous_const)
    have hKsub : K ⊆ Metric.closedBall z R := fun x hx => Metric.mem_closedBall.mpr hx.2
    have hKc : IsCompact K := (isCompact_closedBall z R).of_isClosed_subset hKcl hKsub
    have hKW : K ⊆ W := hKsub.trans hball
    have hSc : IsCompact (Metric.sphere z (R / 2)) := isCompact_sphere z (R / 2)
    have hSball : Metric.sphere z (R / 2) ⊆ Metric.ball z R :=
      Metric.sphere_subset_ball (by linarith)
    have hSW : Metric.sphere z (R / 2) ⊆ W :=
      hSball.trans (Metric.ball_subset_closedBall.trans hball)
    have hcoord : ∀ i : Fin 2, Continuous (fun x : E2 => (x - z) i) := fun i =>
      (PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) i).comp (continuous_id.sub continuous_const)
    have hq : ContinuousOn
        (fun x => ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j) W := by
      apply continuousOn_finset_sum
      intro i _
      apply continuousOn_finset_sum
      intro j _
      exact (((hcoord i).continuousOn).mul (hA i j)).mul (hcoord j).continuousOn
    have hqpos : ∀ x ∈ K, 0 < ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j := by
      intro x hx
      have hd : 0 < dist x z := lt_of_lt_of_le (by linarith) hx.1
      have hne : x - z ≠ 0 := sub_ne_zero.mpr (dist_pos.mp hd)
      exact hApos x (hKW hx) (x - z) hne
    obtain ⟨m₀, hm₀, hm₀K⟩ := P1 K _ hKc (hq.mono hKW) hqpos
    obtain ⟨C₀, hC₀, hC₀K⟩ := P2 K (fun x => A x 0 0) hKc ((hA 0 0).mono hKW)
    obtain ⟨C₁, hC₁, hC₁K⟩ := P2 K (fun x => A x 1 1) hKc ((hA 1 1).mono hKW)
    obtain ⟨D₀, hD₀, hD₀K⟩ := P2 K (fun x => B x 0) hKc ((hB 0).mono hKW)
    obtain ⟨D₁, hD₁, hD₁K⟩ := P2 K (fun x => B x 1) hKc ((hB 1).mono hKW)
    obtain ⟨Γ, hΓ, hΓK⟩ := P2 K c hKc (hc.mono hKW)
    obtain ⟨m, hm, hmS⟩ := P1 (Metric.sphere z (R / 2)) w hSc (hwc.mono hSW)
      (fun x hx => hpos x (hSball hx))
    refine ⟨m₀, C₀ + C₁, D₀ + D₁, Γ, m, hm₀, add_nonneg hC₀ hC₁, add_nonneg hD₀ hD₁, hΓ, hm,
      ?_, ?_⟩
    · intro x h1 h2
      have hxK : x ∈ K := ⟨h1, h2⟩
      have a0 : |A x 0 0| ≤ C₀ := hC₀K x hxK
      have a1 : |A x 1 1| ≤ C₁ := hC₁K x hxK
      have b0 : |B x 0| ≤ D₀ := hD₀K x hxK
      have b1 : |B x 1| ≤ D₁ := hD₁K x hxK
      refine ⟨hm₀K x hxK, ?_, ?_, hΓK x hxK⟩
      · rw [Fin.forall_fin_two]
        exact ⟨by linarith, by linarith⟩
      · rw [Fin.forall_fin_two]
        exact ⟨by linarith, by linarith⟩
    · intro x hx
      exact hmS x (Metric.mem_sphere.mpr hx)
  
  have hbarrier : ∀ (z : E2) (α R : ℝ) (v : E2 → ℝ),
      (∀ x, v x = Real.exp (-α * ‖x - z‖ ^ 2) - Real.exp (-α * R ^ 2)) →
      ContDiff ℝ ∞ v ∧ (∀ x d : E2, fderiv ℝ v x d =
        -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2)) ∧
      (∀ (x : E2) (j : Fin 2), pd2 j v x = -2 * α * (x - z) j * Real.exp (-α * ‖x - z‖ ^ 2)) ∧
      ∀ (x : E2) (i j : Fin 2), pd2 i (pd2 j v) x = (4 * α ^ 2 * (x - z) i * (x - z) j
        - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖x - z‖ ^ 2) := by
    intro z α R v hv
    have hv' : v = fun y => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2) := funext hv
    subst hv'
    have hinner : ∀ x d : E2, inner ℝ (x - z) d = ∑ k : Fin 2, (x - z) k * d k := by
      intro x d
      simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
      exact Finset.sum_congr rfl (fun k _ => mul_comm _ _)
    have hE : ∀ x : E2, ∃ E' : E2 →L[ℝ] ℝ,
        HasFDerivAt (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2)) E' x ∧
        ∀ d : E2, E' d = -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2) := by
      intro x
      have h1 : HasFDerivAt (fun y : E2 => y - z) (ContinuousLinearMap.id ℝ E2) x :=
        (hasFDerivAt_id x).sub_const z
      refine ⟨_, (h1.norm_sq.const_mul (-α)).exp, fun d => ?_⟩
      rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.id_apply, innerSL_apply_apply, hinner]
      simp only [smul_eq_mul, nsmul_eq_mul]
      push_cast
      ring
    have h2 : ∀ x d : E2, fderiv ℝ (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2)) x d
        = -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2) := by
      intro x d
      obtain ⟨E', hE1, hE2⟩ := hE x
      rw [(hE1.sub_const (Real.exp (-α * R ^ 2))).fderiv, hE2]
    have hsingle : ∀ (x : E2) (j : Fin 2), ∑ k : Fin 2, (x - z) k * (e2 j) k = (x - z) j := by
      intro x j
      simp [e2, EuclideanSpace.single_apply]
    have h3 : ∀ (x : E2) (j : Fin 2),
        pd2 j (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2)) x
          = -2 * α * (x - z) j * Real.exp (-α * ‖x - z‖ ^ 2) := by
      intro x j
      show fderiv ℝ _ x (e2 j) = _
      rw [h2, hsingle]
    refine ⟨?_, h2, h3, ?_⟩
    · exact ((contDiff_const.mul ((contDiff_id.sub contDiff_const).norm_sq ℝ)).exp).sub
        contDiff_const
    · intro x i j
      have hfun : pd2 j (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2))
          = fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2)) := by
        funext y
        rw [h3]
        ring
      rw [hfun]
      show fderiv ℝ (fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2))) x (e2 i) = _
      have hc : HasFDerivAt (fun y : E2 => (y - z) j) (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j) x := by
        have h0 : HasFDerivAt (fun f : E2 => f.ofLp j) (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j) x :=
          PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 x j
        have h := h0.sub_const (z j)
        refine h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
        simp
      obtain ⟨E', hE1, hE2⟩ := hE x
      have hP : HasFDerivAt (fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2)))
          ((-2 * α) • ((x - z) j • E' + Real.exp (-α * ‖x - z‖ ^ 2) •
            PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j)) x :=
        (hc.mul hE1).const_mul (-2 * α)
      rw [hP.fderiv]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, smul_eq_mul,
        hE2, PiLp.proj_apply, hsingle]
      simp only [e2, EuclideanSpace.single_apply]
      by_cases hij : i = j
      · subst hij
        simp only [if_true]
        ring
      · simp only [hij, Ne.symm hij, if_false]
        ring
  
  have hminp : ∀ (W : Set E2), IsOpen W → ∀ (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
      (B : E2 → Fin 2 → ℝ) (u : E2 → ℝ) (Γ : ℝ) (z : E2) (R : ℝ), 0 < R →
      Metric.closedBall z R ⊆ W → ContDiffOn ℝ 2 u W →
      (∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i) →
      (∀ x ∈ W, ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) → 0 ≤ Γ →
      (∀ x : E2, R / 2 < dist x z → dist x z < R → ∑ i : Fin 2, ∑ j : Fin 2,
        A x i j * pd2 i (pd2 j u) x + ∑ k : Fin 2, B x k * pd2 k u x - Γ * u x < 0) →
      (∀ x : E2, dist x z = R / 2 → 0 ≤ u x) → (∀ x : E2, dist x z = R → 0 ≤ u x) →
      ∀ x : E2, R / 2 ≤ dist x z → dist x z ≤ R → 0 ≤ u x := by
    intro W hW A B u Γ z R hR hball hu hAs hApsd hΓ hstrict hin hout
    have s2 : ∀ (g : ℝ → ℝ) (a : ℝ), IsLocalMin g a → ContinuousAt g a →
        0 ≤ deriv (deriv g) a := by
      intro g a hmin hc
      by_contra h
      push_neg at h
      have hd : deriv g a = 0 := hmin.deriv_eq_zero
      have hmax : IsLocalMax g a := isLocalMax_of_deriv_deriv_neg h hd hc
      have hconst : g =ᶠ[𝓝 a] fun _ => g a :=
        (hmin.and hmax).mono fun t ht => le_antisymm ht.2 ht.1
      have h0 : deriv g =ᶠ[𝓝 a] fun _ => (0 : ℝ) :=
        hconst.deriv.mono fun t ht => by rw [ht, deriv_const]
      have h00 : deriv (deriv g) a = 0 := by
        rw [h0.deriv_eq, deriv_const]
      linarith
    have s4 : ∀ (M H : Matrix (Fin 2) (Fin 2) ℝ), (∀ i j : Fin 2, M i j = M j i) →
        (∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * M i j * ξ j) →
        (∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * H i j * ξ j) →
        0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, M i j * H i j := by
      intro M H hMs hM hH
      have key : ∀ (N : Matrix (Fin 2) (Fin 2) ℝ) (a b : ℝ),
          ∑ i : Fin 2, ∑ j : Fin 2, (!₂[a, b] : E2) i * N i j * (!₂[a, b] : E2) j
            = a * N 0 0 * a + a * N 0 1 * b + (b * N 1 0 * a + b * N 1 1 * b) := by
        intro N a b
        simp [Fin.sum_univ_two]
      have kH : ∀ a b : ℝ, 0 ≤ a * H 0 0 * a + a * H 0 1 * b + (b * H 1 0 * a + b * H 1 1 * b) := by
        intro a b
        have := hH !₂[a, b]
        rwa [key] at this
      have kM : ∀ a b : ℝ, 0 ≤ a * M 0 0 * a + a * M 0 1 * b + (b * M 1 0 * a + b * M 1 1 * b) := by
        intro a b
        have := hM !₂[a, b]
        rwa [key] at this
      have hM10 : M 1 0 = M 0 1 := hMs 1 0
      simp only [Fin.sum_univ_two]
      have hp := kH 1 0
      have hs := kH 0 1
      have hd := kM 0 1
      have h4 := kH (-((H 0 1 + H 1 0) / 2)) (H 0 0)
      have h5 := kM (H 0 0) ((H 0 1 + H 1 0) / 2)
      rw [hM10] at h5 ⊢
      have hp' : 0 ≤ H 0 0 := by linarith
      have hs' : 0 ≤ H 1 1 := by linarith
      have hd' : 0 ≤ M 1 1 := by linarith
      rcases hp'.lt_or_eq with hpos | hzero
      · have e4 : H 0 0 * (H 0 0 * H 1 1 - ((H 0 1 + H 1 0) / 2) ^ 2) ≥ 0 := by
          nlinarith
        have hdisc : 0 ≤ H 0 0 * H 1 1 - ((H 0 1 + H 1 0) / 2) ^ 2 := by
          by_contra hc
          push_neg at hc
          have := mul_neg_of_pos_of_neg hpos hc
          linarith
        have e5 : H 0 0 * (M 0 0 * H 0 0 + M 0 1 * H 0 1 + (M 0 1 * H 1 0 + M 1 1 * H 1 1))
            = (H 0 0 * M 0 0 * H 0 0 + H 0 0 * M 0 1 * ((H 0 1 + H 1 0) / 2)
                + (((H 0 1 + H 1 0) / 2) * M 0 1 * H 0 0
                  + ((H 0 1 + H 1 0) / 2) * M 1 1 * ((H 0 1 + H 1 0) / 2)))
