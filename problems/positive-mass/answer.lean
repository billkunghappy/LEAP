    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y q R₀ R₁ C) :
    (∀ (x : E3) (a b : Fin 3), pullbackMetric G Y x a b = pullbackMetric G Y x b a) ∧
