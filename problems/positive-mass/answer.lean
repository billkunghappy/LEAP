      have h2 : (0 : ℝ) < (t - (4 * bm.rOut) • e 0) 0 := hmem.2
      have h3 : (t - (4 * bm.rOut) • e 0) 0 = t 0 - 4 * bm.rOut := by simp
      have hn : ‖(4 * bm.rOut) • e 0‖ = 4 * bm.rOut := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
