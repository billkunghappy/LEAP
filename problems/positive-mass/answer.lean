  have hdir : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      w (P.param j x) = 0 ∧ fderiv ℝ (fun y => w (P.param j y)) x ≠ 0 := by
    intro j x hx hb0
