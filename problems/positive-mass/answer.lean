        mul_le_mul hRα hg0 (mul_nonneg hd₀p.le (norm_nonneg _)) (Real.rpow_nonneg hR.le _)
      have hA4 : 2 * (K : ℝ) * (R * R ^ (α : ℝ) + 8 * K * R ^ (α : ℝ) / τ') ≤ L * e := by
