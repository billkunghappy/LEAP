      exact Real.rpow_le_rpow_of_exponent_le hr1 (by linarith)
    have hWV : ‖y‖ ^ (-q') * ‖y‖ ^ (-q₁ - 1) ≤ ‖y‖ ^ (-σ - q' - 1) := by
      rw [← Real.rpow_add hr0]
