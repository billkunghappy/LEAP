  have hinvmul : (h x)⁻¹ * h x = 1 := Matrix.nonsing_inv_mul _ hunitx
  have I00 : (h x)⁻¹ 0 0 * h x 0 0 + (h x)⁻¹ 0 1 * h x 1 0 = 1 := by
    have := congrFun (congrFun hinvmul 0) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have I01 : (h x)⁻¹ 0 0 * h x 0 1 + (h x)⁻¹ 0 1 * h x 1 1 = 0 := by
    have := congrFun (congrFun hinvmul 0) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have I10 : (h x)⁻¹ 1 0 * h x 0 0 + (h x)⁻¹ 1 1 * h x 1 0 = 0 := by
    have := congrFun (congrFun hinvmul 1) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have I11 : (h x)⁻¹ 1 0 * h x 0 1 + (h x)⁻¹ 1 1 * h x 1 1 = 1 := by
    have := congrFun (congrFun hinvmul 1) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have hdhi : ∀ k l q : Fin 2, pd2 k (fun z => (h z)⁻¹ l q) x =
      -∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ l a * pd2 k (fun z => h z a b) x * (h x)⁻¹ b q := by
    intro k
    simp only [Fin.forall_fin_two, Fin.sum_univ_two]
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · linear_combination (h x)⁻¹ 0 0 * hE k 0 0 + (h x)⁻¹ 0 1 * hE k 1 0
        - pd2 k (fun z => (h z)⁻¹ 0 0) x * I00 - pd2 k (fun z => (h z)⁻¹ 1 0) x * I01
    · linear_combination (h x)⁻¹ 0 0 * hE k 0 1 + (h x)⁻¹ 0 1 * hE k 1 1
        - pd2 k (fun z => (h z)⁻¹ 0 1) x * I00 - pd2 k (fun z => (h z)⁻¹ 1 1) x * I01
    · linear_combination (h x)⁻¹ 1 0 * hE k 0 0 + (h x)⁻¹ 1 1 * hE k 1 0
        - pd2 k (fun z => (h z)⁻¹ 0 0) x * I10 - pd2 k (fun z => (h z)⁻¹ 1 0) x * I11
    · linear_combination (h x)⁻¹ 1 0 * hE k 0 1 + (h x)⁻¹ 1 1 * hE k 1 1
        - pd2 k (fun z => (h z)⁻¹ 0 1) x * I10 - pd2 k (fun z => (h z)⁻¹ 1 1) x * I11
  
  have hΓfun : ∀ l i j : Fin 2,
      christoffel2 h l i j = fun z => ∑ q : Fin 2, (h z)⁻¹ l q * ggeGam1 h q i j z := by
    intro l i j
    funext z
    simp only [christoffel2, ggeGam1, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q _
    ring
  have hΓx : ∀ l i j : Fin 2,
      christoffel2 h l i j x = ∑ q : Fin 2, (h x)⁻¹ l q * ggeGam1 h q i j x := by
    intro l i j
    rw [hΓfun l i j]
  have hdΓ : ∀ k l i j : Fin 2, pd2 k (christoffel2 h l i j) x =
      ∑ q : Fin 2, pd2 k (fun z => (h z)⁻¹ l q) x * ggeGam1 h q i j x +
        ∑ q : Fin 2, (h x)⁻¹ l q * pd2 k (ggeGam1 h q i j) x := by
    intro k l i j
    rw [hΓfun l i j]
    simp only [Fin.sum_univ_two]
    rw [pd_add _ _ _ _ (dmul _ _ _ (hinvd l 0) (hΓ1d 0 i j x hx))
        (dmul _ _ _ (hinvd l 1) (hΓ1d 1 i j x hx)),
      pd_mul _ _ _ _ (hinvd l 0) (hΓ1d 0 i j x hx), pd_mul _ _ _ _ (hinvd l 1) (hΓ1d 1 i j x hx)]
    ring
  
  have hS : pd2 0 (ggeGam1 h 1 1 0) x - pd2 1 (ggeGam1 h 1 0 0) x
      + pd2 0 (ggeGam1 h 0 1 1) x - pd2 1 (ggeGam1 h 0 0 1) x = 0 := by
    have hA : pd2 0 (pd2 1 (fun w => h w 1 0)) x =
        pd2 0 (ggeGam1 h 1 1 0) x + pd2 0 (ggeGam1 h 0 1 1) x := by
      have hev : pd2 1 (fun w => h w 1 0) =ᶠ[𝓝 x]
          fun z => ggeGam1 h 1 1 0 z + ggeGam1 h 0 1 1 z := by
        filter_upwards [hs.mem_nhds hx] with z hz
        exact hcompat z hz 1 1 0
      rw [pd_congr _ _ x 0 hev, pd_add _ _ _ _ (hΓ1d 1 1 0 x hx) (hΓ1d 0 1 1 x hx)]
    have hB : pd2 1 (pd2 0 (fun w => h w 1 0)) x =
        pd2 1 (ggeGam1 h 1 0 0) x + pd2 1 (ggeGam1 h 0 0 1) x := by
      have hev : pd2 0 (fun w => h w 1 0) =ᶠ[𝓝 x]
          fun z => ggeGam1 h 1 0 0 z + ggeGam1 h 0 0 1 z := by
        filter_upwards [hs.mem_nhds hx] with z hz
        exact hcompat z hz 0 1 0
      rw [pd_congr _ _ x 1 hev, pd_add _ _ _ _ (hΓ1d 1 0 0 x hx) (hΓ1d 0 0 1 x hx)]
    have hf : ContDiffAt ℝ ∞ (fun w => h w 1 0) x := (hh 1 0).contDiffAt (hs.mem_nhds hx)
    have hdf : DifferentiableAt ℝ (fderiv ℝ (fun w => h w 1 0)) x :=
      (hf.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)
    have hsym : IsSymmSndFDerivAt ℝ (fun w => h w 1 0) x :=
      hf.isSymmSndFDerivAt (by simp <;> norm_cast)
    have e2e : ∀ i j : Fin 2, pd2 i (pd2 j (fun w => h w 1 0)) x =
        fderiv ℝ (fderiv ℝ (fun w => h w 1 0)) x (e2 i) (e2 j) := by
      intro i j
      show fderiv ℝ (fun z => fderiv ℝ (fun w => h w 1 0) z (e2 j)) x (e2 i) = _
      rw [fderiv_clm_apply hdf (differentiableAt_const _)]
      simp
    have hsw : pd2 0 (pd2 1 (fun w => h w 1 0)) x = pd2 1 (pd2 0 (fun w => h w 1 0)) x := by
      rw [e2e, e2e]
      exact hsym (e2 0) (e2 1)
    linarith
  
  have hT : Matrix.transpose (h x) = h x := by
    ext i j
    exact hhsymm x hx j i
  have hsymi : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := by
    have := congrFun (congrFun (Matrix.transpose_nonsing_inv (h x)) 0) 1
    rw [hT] at this
    simpa [Matrix.transpose_apply] using this
  have hdetrel : (h x).det * ((h x)⁻¹ 0 0 * (h x)⁻¹ 1 1 - (h x)⁻¹ 0 1 * (h x)⁻¹ 0 1) = 1 := by
    have := Matrix.det_nonsing_inv_mul_det (h x) hunitx
    rw [Matrix.det_fin_two, hsymi] at this
    linarith
  have hc : (h x)⁻¹ 0 0 * (h x)⁻¹ 1 1 - (h x)⁻¹ 0 1 * (h x)⁻¹ 0 1 ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hdetrel
    exact zero_ne_one hdetrel
  have hcx : ∀ k a b : Fin 2,
      pd2 k (fun w => h w a b) x = ggeGam1 h a k b x + ggeGam1 h b k a x := hcompat x hx
  
  refine mul_right_cancel₀ hc ?_
  rw [mul_assoc (gaussCurv2 h x), hdetrel, mul_one]
  simp only [gaussCurv2, ricci2, ggeRiem0110, Fin.sum_univ_two]
  simp only [hdΓ, hΓx, Fin.sum_univ_two]
  simp only [hdhi, Fin.sum_univ_two]
  simp only [hcx, hsymi]
  linear_combination
    (-((h x)⁻¹ 0 0 * (h x)⁻¹ 1 1 - (h x)⁻¹ 0 1 * (h x)⁻¹ 0 1) / 2) * hS

theorem gge_koszul_tangent (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) : ∀ z ∈ s, ∀ m i j : Fin 2, ggeGam1 (pullMetric2 G F) m i j z = ∑ a : Fin 3, ∑ b : Fin 3, gsTan F m z a * G (F z) a b * gsCovHess G F i j z b :=
by
  
  have alg : ∀ (Gm : Matrix (Fin 3) (Fin 3) ℝ), (∀ a b : Fin 3, Gm a b = Gm b a) →
      ∀ (dG Γ : Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ a c d : Fin 3, ∑ b : Fin 3, Gm a b * Γ b c d =
        1 / 2 * (dG c d a + dG d c a - dG a c d)) →
      ∀ (D : Fin 3 → Fin 2 → ℝ) (A : Fin 3 → Fin 2 → Fin 2 → ℝ),
      (∀ (c : Fin 3) (i j : Fin 2), A c i j = A c j i) →
      ∀ (dh : Fin 2 → Fin 2 → Fin 2 → ℝ),
      (∀ m i j : Fin 2, dh m i j = ∑ k : Fin 3, ∑ l : Fin 3,
        (A k m i * Gm k l * D l j + D k i * Gm k l * A l m j +
          D k i * (∑ r : Fin 3, dG r k l * D r m) * D l j)) →
      ∀ m i j : Fin 2, 1 / 2 * (dh i j m + dh j i m - dh m i j) =
        ∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b *
          (A b i j + ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c i * D d j) := by
    intro Gm hGs dG Γ hlow D A hA dh hdh m i j
    have hR : ∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b *
          (A b i j + ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c i * D d j) =
        ∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b * A b i j +
          ∑ a : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
            D a m * D c i * D d j * (∑ b : Fin 3, Gm a b * Γ b c d) := by
      simp only [Fin.sum_univ_three]; ring
    rw [hR, hdh i j m, hdh j i m, hdh m i j]
    simp only [hlow]
    simp only [Fin.sum_univ_three, fun c => hA c j i, fun c => hA c i m, fun c => hA c j m,
      hGs 1 0, hGs 2 0, hGs 2 1]
    ring
  intro z hz m i j
  have hzs : s ∈ 𝓝 z := hs.mem_nhds hz
  have hUy : U ∈ 𝓝 (F z) := hU.mem_nhds (hFU z hz)
  have h1 : (1 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have hFdx : DifferentiableAt ℝ F z :=
    ((hF.contDiffAt hzs).of_le h1).differentiableAt one_ne_zero
  have hFd : DifferentiableAt ℝ (fderiv ℝ F) z :=
    ((hF.fderiv_of_isOpen hs (m := 1) (WithTop.coe_le_coe.mpr le_top)).contDiffAt
      hzs).differentiableAt one_ne_zero
  have hGd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => G y k l) (F z) :=
    fun k l => (((hG k l).contDiffAt hUy).of_le h1).differentiableAt one_ne_zero
  have hcol : ∀ (w : E2) (k : Fin 3), DifferentiableAt ℝ (fun x' => (fderiv ℝ F x' w) k) z := by
    intro w k
    let Λ : (E2 →L[ℝ] E3) →L[ℝ] ℝ :=
      (EuclideanSpace.proj k).comp (ContinuousLinearMap.apply ℝ E3 w)
    have hfun : (fun x' => (fderiv ℝ F x' w) k) = Λ ∘ fderiv ℝ F := rfl
    rw [hfun]
    exact Λ.differentiableAt.comp z hFd
  have hBd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun x' => G (F x') k l) z :=
    fun k l => (hGd k l).comp z hFdx
  have hexp : ∀ (ℓ : E3 →L[ℝ] ℝ) (u : E3), ℓ u = ∑ r : Fin 3, ℓ (e r) * u r := by
    intro ℓ u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp only [map_sum, map_smul, smul_eq_mul, EuclideanSpace.basisFun_repr,
      EuclideanSpace.basisFun_apply]
    exact Finset.sum_congr rfl (fun r _ => mul_comm _ _)
  have hB' : ∀ (m' : Fin 2) (k l : Fin 3), fderiv ℝ (fun x' => G (F x') k l) z (e2 m') =
      ∑ r : Fin 3, partialDeriv r (fun y => G y k l) (F z) * (fderiv ℝ F z (e2 m')) r := by
    intro m' k l
    have hc : (fun x' => G (F x') k l) = (fun y => G y k l) ∘ F := rfl
    rw [hc, fderiv_comp z (hGd k l) hFdx, ContinuousLinearMap.comp_apply,
      hexp (fderiv ℝ (fun y => G y k l) (F z))]
    rfl
  
  have hpull : ∀ m' i' j' : Fin 2, pd2 m' (fun w => pullMetric2 G F w i' j') z =
      ∑ k : Fin 3, ∑ l : Fin 3,
        (pd2 m' (fun x' => (fderiv ℝ F x' (e2 i')) k) z * G (F z) k l * (fderiv ℝ F z (e2 j')) l +
          (fderiv ℝ F z (e2 i')) k * G (F z) k l * pd2 m' (fun x' => (fderiv ℝ F x' (e2 j')) l) z +
          (fderiv ℝ F z (e2 i')) k *
            (∑ r : Fin 3, partialDeriv r (fun y => G y k l) (F z) * (fderiv ℝ F z (e2 m')) r) *
            (fderiv ℝ F z (e2 j')) l) := by
    intro m' i' j'
    have hT : ∀ k l : Fin 3, HasFDerivAt
        (fun w => (fderiv ℝ F w (e2 i')) k * G (F w) k l * (fderiv ℝ F w (e2 j')) l)
        (((fderiv ℝ F z (e2 i')) k * G (F z) k l) • fderiv ℝ (fun w => (fderiv ℝ F w (e2 j')) l) z
          + (fderiv ℝ F z (e2 j')) l • ((fderiv ℝ F z (e2 i')) k • fderiv ℝ (fun w => G (F w) k l) z
            + G (F z) k l • fderiv ℝ (fun w => (fderiv ℝ F w (e2 i')) k) z)) z := by
      intro k l
      exact ((hcol (e2 i') k).hasFDerivAt.fun_mul (hBd k l).hasFDerivAt).fun_mul
        (hcol (e2 j') l).hasFDerivAt
    have hsum := HasFDerivAt.fun_sum (u := Finset.univ)
      (fun k _ => HasFDerivAt.fun_sum (u := Finset.univ) (fun l _ => hT k l))
    show fderiv ℝ (fun w => ∑ k : Fin 3, ∑ l : Fin 3,
      (fderiv ℝ F w (e2 i')) k * G (F w) k l * (fderiv ℝ F w (e2 j')) l) z (e2 m') = _
    rw [hsum.fderiv]
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => ?_))
    rw [hB' m' k l]
    simp only [pd2]
    ring
  
  have hcoord : ∀ (m' i' : Fin 2) (k : Fin 3),
      pd2 m' (fun x' => (fderiv ℝ F x' (e2 i')) k) z = gsHessF F m' i' z k := by
    intro m' i' k
    have hL : DifferentiableAt ℝ (fun y => fderiv ℝ F y (e2 i')) z :=
      hFd.clm_apply (differentiableAt_const _)
    have hproj : (fun x' => (fderiv ℝ F x' (e2 i')) k) =
        (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) ∘ (fun y => fderiv ℝ F y (e2 i')) := by
      funext y; rfl
    unfold pd2
    rw [hproj, fderiv_comp z (EuclideanSpace.proj k).differentiableAt hL,
      ContinuousLinearMap.fderiv, ContinuousLinearMap.comp_apply]
    rfl
  have hdh : ∀ m' i' j' : Fin 2, pd2 m' (fun w => pullMetric2 G F w i' j') z =
      ∑ k : Fin 3, ∑ l : Fin 3,
        (gsHessF F m' i' z k * G (F z) k l * gsTan F j' z l +
          gsTan F i' z k * G (F z) k l * gsHessF F m' j' z l +
          gsTan F i' z k * (∑ r : Fin 3, partialDeriv r (fun y => G y k l) (F z) * gsTan F m' z r) *
            gsTan F j' z l) := by
    intro m' i' j'
    rw [hpull m' i' j']
    simp only [hcoord]
    rfl
  
  have hA : ∀ (c : Fin 3) (i' j' : Fin 2), gsHessF F i' j' z c = gsHessF F j' i' z c := by
    have hFat : ContDiffAt ℝ ∞ F z := hF.contDiffAt hzs
    have hH : ∀ i' j' : Fin 2,
        gsHessF F i' j' z = fderiv ℝ (fderiv ℝ F) z (e2 i') (e2 j') := by
      intro i' j'
      unfold gsHessF
      rw [fderiv_clm_apply hFd (differentiableAt_const _)]
      simp
    have hsymF : IsSymmSndFDerivAt ℝ F z := hFat.isSymmSndFDerivAt (by simp <;> norm_cast)
    intro c i' j'
    rw [hH i' j', hH j' i', hsymF (e2 i') (e2 j')]
  
  have hGz : (G (F z)).PosDef := hGpos (F z) (hFU z hz)
  have hGi : G (F z) * (G (F z))⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hGz.det_pos.ne')
  have hδ : ∀ a l : Fin 3, ∑ b : Fin 3, G (F z) a b * (G (F z))⁻¹ b l = if a = l then 1 else 0 := by
    intro a l
    rw [← Matrix.mul_apply, hGi, Matrix.one_apply]
  have hlow : ∀ a c d : Fin 3, ∑ b : Fin 3, G (F z) a b * christoffel G b c d (F z) =
      1 / 2 * (partialDeriv c (fun y => G y d a) (F z) + partialDeriv d (fun y => G y c a) (F z)
        - partialDeriv a (fun y => G y c d) (F z)) := by
    intro a c d
    have e1 : ∀ b : Fin 3, G (F z) a b * christoffel G b c d (F z) =
        ∑ l : Fin 3, 1 / 2 * (partialDeriv c (fun y => G y d l) (F z) +
          partialDeriv d (fun y => G y c l) (F z) - partialDeriv l (fun y => G y c d) (F z)) *
          (G (F z) a b * (G (F z))⁻¹ b l) := by
      intro b
      simp only [christoffel, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun l _ => by ring)
    rw [Finset.sum_congr rfl (fun b _ => e1 b), Finset.sum_comm]
    simp only [← Finset.mul_sum, hδ, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
      Finset.mem_univ, if_true]
  
  have key := alg (G (F z)) (hGsymm (F z))
    (fun r k l => partialDeriv r (fun y => G y k l) (F z))
    (fun b c d => christoffel G b c d (F z)) hlow
    (fun c i' => gsTan F i' z c) (fun c m' i' => gsHessF F m' i' z c) hA
    (fun m' i' j' => pd2 m' (fun w => pullMetric2 G F w i' j') z) hdh m i j
  unfold ggeGam1 gsCovHess
  exact key

theorem gge_koszul_deriv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) : ∀ x ∈ s, ∀ k m i j : Fin 2, pd2 k (fun z => ∑ a : Fin 3, ∑ b : Fin 3, gsTan F m z a * G (F z) a b * gsCovHess G F i j z b) x = ∑ a : Fin 3, ∑ b : Fin 3, (gsHessF F k m x a * G (F x) a b * gsCovHess G F i j x b + gsTan F m x a * (∑ r : Fin 3, partialDeriv r (fun y => G y a b) (F x) * gsTan F k x r) * gsCovHess G F i j x b + gsTan F m x a * G (F x) a b * (pd2 k (fun z => gsHessF F i j z b) x + ∑ c : Fin 3, ∑ d : Fin 3, ((∑ r : Fin 3, partialDeriv r (christoffel G b c d) (F x) * gsTan F k x r) * gsTan F i x c * gsTan F j x d + christoffel G b c d (F x) * (gsHessF F k i x c * gsTan F j x d + gsTan F i x c * gsHessF F k j x d)))) :=
by
  intro x hx k m i j
  
  have hmul : ∀ f g : E2 → ℝ, DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
    intro f g hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hadd : ∀ f g : E2 → ℝ, DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
    intro f g hf hg
    unfold pd2
    rw [fderiv_fun_add hf hg, ContinuousLinearMap.add_apply]
  have hsum : ∀ f : Fin 3 → E2 → ℝ, (∀ a, DifferentiableAt ℝ (f a) x) →
      pd2 k (fun z => ∑ a : Fin 3, f a z) x = ∑ a : Fin 3, pd2 k (f a) x := by
    intro f hf
    unfold pd2
    rw [fderiv_fun_sum (u := Finset.univ) (fun a _ => hf a), ContinuousLinearMap.sum_apply]
  
  have hexp : ∀ (ℓ : E3 →L[ℝ] ℝ) (v : E3), ℓ v = ∑ c : Fin 3, v c * ℓ (e c) := by
    intro ℓ v
    have hv : v = ∑ c : Fin 3, v c • e c := by
      ext t
      fin_cases t <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul]
  have hFd : DifferentiableAt ℝ F x :=
    (hF.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hx)
  have hchain : ∀ w : E3 → ℝ, DifferentiableAt ℝ w (F x) →
      pd2 k (fun z => w (F z)) x = ∑ r : Fin 3, partialDeriv r w (F x) * gsTan F k x r := by
    intro w hw
    show fderiv ℝ (fun z => w (F z)) x (e2 k) = _
    rw [fderiv_comp' x hw hFd, ContinuousLinearMap.comp_apply, hexp]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [mul_comm]
    rfl
  
  have hcoord : ∀ φ : E2 → E3, ContDiffOn ℝ ∞ φ s → ∀ c : Fin 3,
      DifferentiableAt ℝ (fun z => φ z c) x ∧
        pd2 k (fun z => φ z c) x = fderiv ℝ φ x (e2 k) c := by
    intro φ hφ c
    have hφd : DifferentiableAt ℝ φ x :=
      (hφ.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hx)
    have hfun : (fun z => φ z c) = (EuclideanSpace.proj c : E3 →L[ℝ] ℝ) ∘ φ := rfl
    refine ⟨?_, ?_⟩
    · rw [hfun]
      exact (EuclideanSpace.proj c).differentiableAt.comp x hφd
    · unfold pd2
      rw [hfun, fderiv_comp x (EuclideanSpace.proj c).differentiableAt hφd,
        ContinuousLinearMap.fderiv, ContinuousLinearMap.comp_apply]
      rfl
  have hFfd : ContDiffOn ℝ ∞ (fderiv ℝ F) s :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hF).2
  have hΨ : ∀ p : Fin 2, ContDiffOn ℝ ∞ (fun y => fderiv ℝ F y (e2 p)) s :=
    fun p => hFfd.clm_apply contDiffOn_const
  have hHs : ∀ p q : Fin 2, ContDiffOn ℝ ∞ (fun z => gsHessF F p q z) s := by
    intro p q
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => fderiv ℝ F y (e2 q))) s :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 (hΨ q)).2
    exact h1.clm_apply contDiffOn_const
  have dT : ∀ (p : Fin 2) (a : Fin 3), DifferentiableAt ℝ (fun z => gsTan F p z a) x :=
    fun p a => (hcoord _ (hΨ p) a).1
  have pT : ∀ (p : Fin 2) (a : Fin 3), pd2 k (fun z => gsTan F p z a) x = gsHessF F k p x a :=
    fun p a => (hcoord _ (hΨ p) a).2
  have dH : ∀ b : Fin 3, DifferentiableAt ℝ (fun z => gsHessF F i j z b) x :=
    fun b => (hcoord _ (hHs i j) b).1
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ r : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv r f) U := by
    intro f hf r
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpos y hy).det_pos.ne'
  have hGi : ∀ p q : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ p q) U := by
    intro p q
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow q (Pi.single p 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = q
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  have hdG : ∀ r a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv r (fun z => G z a b)) U :=
    fun r a b => hpdv _ (hG a b) r
  have hΓ : ∀ b c d : Fin 3, ContDiffOn ℝ ∞ (christoffel G b c d) U := by
    intro b c d
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi b l).mul (((hdG c d l).add (hdG d c l)).sub (hdG l c d)))
  have hFxU : U ∈ 𝓝 (F x) := hU.mem_nhds (hFU x hx)
  have dG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) (F x) :=
    fun a b => ((hG a b).differentiableOn (by simp)).differentiableAt hFxU
  have dΓ : ∀ b c d : Fin 3, DifferentiableAt ℝ (christoffel G b c d) (F x) :=
    fun b c d => ((hΓ b c d).differentiableOn (by simp)).differentiableAt hFxU
  have dGF : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G (F z) a b) x :=
    fun a b => (dG a b).comp x hFd
  have dΓF : ∀ b c d : Fin 3, DifferentiableAt ℝ (fun z => christoffel G b c d (F z)) x :=
    fun b c d => (dΓ b c d).comp x hFd
  
  have hV : ∀ b : Fin 3, DifferentiableAt ℝ (fun z => gsCovHess G F i j z b) x ∧
      pd2 k (fun z => gsCovHess G F i j z b) x = pd2 k (fun z => gsHessF F i j z b) x +
        ∑ c : Fin 3, ∑ d : Fin 3, ((∑ r : Fin 3, partialDeriv r (christoffel G b c d) (F x) *
          gsTan F k x r) * gsTan F i x c * gsTan F j x d + christoffel G b c d (F x) *
          (gsHessF F k i x c * gsTan F j x d + gsTan F i x c * gsHessF F k j x d)) := by
    intro b
    have hVeq : (fun z => gsCovHess G F i j z b) = fun z => gsHessF F i j z b +
        ∑ c : Fin 3, ∑ d : Fin 3,
          christoffel G b c d (F z) * gsTan F i z c * gsTan F j z d := rfl
    have d3 : ∀ c d : Fin 3, DifferentiableAt ℝ
        (fun z => christoffel G b c d (F z) * gsTan F i z c * gsTan F j z d) x :=
      fun c d => ((dΓF b c d).fun_mul (dT i c)).fun_mul (dT j d)
    have d2 : ∀ c : Fin 3, DifferentiableAt ℝ
        (fun z => ∑ d : Fin 3, christoffel G b c d (F z) * gsTan F i z c * gsTan F j z d) x :=
      fun c => DifferentiableAt.fun_sum (fun d _ => d3 c d)
    have d1 : DifferentiableAt ℝ (fun z => ∑ c : Fin 3, ∑ d : Fin 3,
        christoffel G b c d (F z) * gsTan F i z c * gsTan F j z d) x :=
      DifferentiableAt.fun_sum (fun c _ => d2 c)
    refine ⟨?_, ?_⟩
    · rw [hVeq]
      exact (dH b).fun_add d1
    · rw [hVeq, hadd _ _ (dH b) d1, hsum _ d2]
      congr 1
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [hsum _ (d3 c)]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      rw [hmul _ _ ((dΓF b c d).fun_mul (dT i c)) (dT j d), hmul _ _ (dΓF b c d) (dT i c),
        hchain _ (dΓ b c d), pT, pT]
      ring
  
  have dTg : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => gsTan F m z a * G (F z) a b) x :=
    fun a b => (dT m a).fun_mul (dGF a b)
  have dTgV : ∀ a b : Fin 3, DifferentiableAt ℝ
      (fun z => gsTan F m z a * G (F z) a b * gsCovHess G F i j z b) x :=
    fun a b => (dTg a b).fun_mul (hV b).1
  have dS : ∀ a : Fin 3, DifferentiableAt ℝ
      (fun z => ∑ b : Fin 3, gsTan F m z a * G (F z) a b * gsCovHess G F i j z b) x :=
    fun a => DifferentiableAt.fun_sum (fun b _ => dTgV a b)
  rw [hsum _ dS]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [hsum _ (dTgV a)]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  rw [hmul _ _ (dTg a b) (hV b).1, hmul _ _ (dT m a) (dGF a b), pT, (hV b).2,
    hchain _ (dG a b)]
  ring

theorem gge_normal_split (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (x : E2) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : (G (F x)).PosDef) (hinj : Function.Injective (fderiv ℝ F x)) (P Q : Fin 3 → ℝ) : ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * Q d = ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b * (∑ c : Fin 3, ∑ d : Fin 3, gsTan F a x c * G (F x) c d * P d) * (∑ c : Fin 3, ∑ d : Fin 3, gsTan F b x c * G (F x) c d * Q d) + (∑ c : Fin 3, gsCrossN F x c * P c) * (∑ c : Fin 3, gsCrossN F x c * Q c) / gsNormLen G F x ^ 2 :=
by
  
  have core : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (D : Fin 2 → Fin 3 → ℝ) (N : Fin 3 → ℝ)
      (h : Matrix (Fin 2) (Fin 2) ℝ) (P Q : Fin 3 → ℝ),
      (∀ i j, A i j = A j i) →
      N = ![D 0 1 * D 1 2 - D 0 2 * D 1 1, D 0 2 * D 1 0 - D 0 0 * D 1 2,
        D 0 0 * D 1 1 - D 0 1 * D 1 0] →
      (∀ i j, h i j = ∑ k : Fin 3, ∑ l : Fin 3, D i k * A k l * D j l) →
      (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) ≠ 0 →
      ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d =
        ∑ a : Fin 2, ∑ b : Fin 2, h⁻¹ a b *
            (∑ c : Fin 3, ∑ d : Fin 3, D a c * A c d * P d) *
            (∑ c : Fin 3, ∑ d : Fin 3, D b c * A c d * Q d) +
          (∑ c : Fin 3, N c * P c) * (∑ c : Fin 3, N c * Q c) /
            (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) := by
    intro A D N h P Q hsym hN hh hS
    have n0 : N 0 = D 0 1 * D 1 2 - D 0 2 * D 1 1 := by rw [hN]; rfl
    have n1 : N 1 = D 0 2 * D 1 0 - D 0 0 * D 1 2 := by rw [hN]; rfl
    have n2 : N 2 = D 0 0 * D 1 1 - D 0 1 * D 1 0 := by rw [hN]; rfl
    have k00 : A.adjugate 0 0 = A 1 1 * A 2 2 - A 1 2 * A 2 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k01 : A.adjugate 0 1 = -(A 0 1 * A 2 2) + A 0 2 * A 2 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k02 : A.adjugate 0 2 = A 0 1 * A 1 2 - A 0 2 * A 1 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k10 : A.adjugate 1 0 = -(A 1 0 * A 2 2) + A 1 2 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k11 : A.adjugate 1 1 = A 0 0 * A 2 2 - A 0 2 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k12 : A.adjugate 1 2 = -(A 0 0 * A 1 2) + A 0 2 * A 1 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k20 : A.adjugate 2 0 = A 1 0 * A 2 1 - A 1 1 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k21 : A.adjugate 2 1 = -(A 0 0 * A 2 1) + A 0 1 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k22 : A.adjugate 2 2 = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have a00 : h.adjugate 0 0 = h 1 1 := by rw [Matrix.adjugate_fin_two]; rfl
    have a01 : h.adjugate 0 1 = -h 0 1 := by rw [Matrix.adjugate_fin_two]; rfl
    have a10 : h.adjugate 1 0 = -h 1 0 := by rw [Matrix.adjugate_fin_two]; rfl
    have a11 : h.adjugate 1 1 = h 0 0 := by rw [Matrix.adjugate_fin_two]; rfl
    have hAi : A⁻¹ = A.det⁻¹ • A.adjugate := by rw [Matrix.inv_def, Ring.inverse_eq_inv']
    have hSs : (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) =
        A.det⁻¹ * ∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l := by
      rw [hAi]
      simp only [Matrix.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      ring
    have hCB : h.det = ∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l := by
      rw [Matrix.det_fin_two]
      simp only [hh, Fin.sum_univ_three, k00, k01, k02, k10, k11, k12, k20, k21, k22, n0, n1, n2]
      rw [hsym 1 0, hsym 2 0, hsym 2 1]
      ring
    have key : (∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l) *
          (∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d) =
        ∑ a : Fin 2, ∑ b : Fin 2, h.adjugate a b *
            (∑ c : Fin 3, ∑ d : Fin 3, D a c * A c d * P d) *
            (∑ c : Fin 3, ∑ d : Fin 3, D b c * A c d * Q d) +
          A.det * ((∑ c : Fin 3, N c * P c) * (∑ c : Fin 3, N c * Q c)) := by
      rw [Matrix.det_fin_three]
      simp only [Fin.sum_univ_two, a00, a01, a10, a11, hh, Fin.sum_univ_three,
        k00, k01, k02, k10, k11, k12, k20, k21, k22, n0, n1, n2]
      rw [hsym 1 0, hsym 2 0, hsym 2 1]
      ring
    generalize hs : (∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l) = s at hSs hCB key
    have hs0 : s ≠ 0 := by
      intro h0; apply hS; rw [hSs, h0, mul_zero]
    have hinv : h⁻¹ = s⁻¹ • h.adjugate := by rw [Matrix.inv_def, Ring.inverse_eq_inv', hCB]
    have hL : ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d =
        s⁻¹ * (s * ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d) := by
      rw [← mul_assoc, inv_mul_cancel₀ hs0, one_mul]
    rw [hL, key, hSs, hinv]
    simp only [Matrix.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    field_simp
  
  have hN : gsCrossN F x ≠ 0 := by
    intro hN0
    have n0 : gsTan F 0 x 1 * gsTan F 1 x 2 - gsTan F 0 x 2 * gsTan F 1 x 1 = 0 := by
      have := congrFun hN0 0; exact this
    have n1 : gsTan F 0 x 2 * gsTan F 1 x 0 - gsTan F 0 x 0 * gsTan F 1 x 2 = 0 := by
      have := congrFun hN0 1; exact this
    have n2 : gsTan F 0 x 0 * gsTan F 1 x 1 - gsTan F 0 x 1 * gsTan F 1 x 0 = 0 := by
      have := congrFun hN0 2; exact this
    have hLa : fderiv ℝ F x (e2 0) = gsTan F 0 x := rfl
    have hLb : fderiv ℝ F x (e2 1) = gsTan F 1 x := rfl
    set a := gsTan F 0 x with ha
    set b := gsTan F 1 x with hb
    have hv : fderiv ℝ F x ((b 0 ^ 2 + b 1 ^ 2 + b 2 ^ 2) • e2 0 -
        (a 0 * b 0 + a 1 * b 1 + a 2 * b 2) • e2 1) = 0 := by
      rw [map_sub, map_smul, map_smul, hLa, hLb]
      ext m
      fin_cases m
      · simp
        linear_combination b 1 * n2 - b 2 * n1
      · simp
        linear_combination b 2 * n0 - b 0 * n2
      · simp
        linear_combination b 0 * n1 - b 1 * n0
    have hv0 := hinj (hv.trans (map_zero _).symm)
    have hβ : b 0 ^ 2 + b 1 ^ 2 + b 2 ^ 2 = 0 := by
      have := congrArg (fun v : E2 => v 0) hv0
      simpa using this
    have hb0 : b 0 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb1 : b 1 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb2 : b 2 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb' : fderiv ℝ F x (e2 1) = 0 := by
      rw [hLb]
      ext m
      fin_cases m <;> simp [hb0, hb1, hb2]
    have h1 := hinj (hb'.trans (map_zero _).symm)
    have h2 := congrArg (fun v : E2 => v 1) h1
    simp at h2
  
  have hSpos : 0 < ∑ k : Fin 3, ∑ l : Fin 3,
      (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
    have h1 := hGpos.inv.dotProduct_mulVec_pos hN
    have e : dotProduct (star (gsCrossN F x)) ((G (F x))⁻¹.mulVec (gsCrossN F x)) =
        ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
      simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      ring
    rw [← e]; exact h1
  have hlen : gsNormLen G F x ^ 2 = ∑ k : Fin 3, ∑ l : Fin 3,
      (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := Real.sq_sqrt hSpos.le
  rw [hlen]
  exact core (G (F x)) (fun i c => gsTan F i x c) (gsCrossN F x) (pullMetric2 G F x) P Q
    (hGsymm _) rfl (fun i j => rfl) hSpos.ne'

theorem gge_gauss_extrinsic_alg (Gm Gi : Matrix (Fin 3) (Fin 3) ℝ) (hGi : Gm * Gi = 1) (hGs : ∀ a b : Fin 3, Gm a b = Gm b a) (dG : Fin 3 → Fin 3 → Fin 3 → ℝ) (hdG : ∀ r a b : Fin 3, dG r a b = dG r b a) (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (hΓ : ∀ k a b : Fin 3, Γ k a b = 1 / 2 * ∑ l : Fin 3, Gi k l * (dG a b l + dG b a l - dG l a b)) (dΓ : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (D : Fin 3 → Fin 2 → ℝ) (A : Fin 3 → Fin 2 → Fin 2 → ℝ) (hA : ∀ c : Fin 3, A c 0 1 = A c 1 0) (T : Fin 3 → Fin 2 → Fin 2 → Fin 2 → ℝ) (hT : ∀ b : Fin 3, T b 0 1 1 = T b 1 0 1) (V : Fin 3 → Fin 2 → Fin 2 → ℝ) (hV : ∀ (b : Fin 3) (i j : Fin 2), V b i j = A b i j + ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c i * D d j) (Γ1 : Fin 2 → Fin 2 → Fin 2 → ℝ) (dΓ1 : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) (hdΓ1 : ∀ k m i j : Fin 2, dΓ1 k m i j = ∑ a : Fin 3, ∑ b : Fin 3, (A a k m * Gm a b * V b i j + D a m * (∑ r : Fin 3, dG r a b * D r k) * V b i j + D a m * Gm a b * (T b k i j + ∑ c : Fin 3, ∑ d : Fin 3, ((∑ r : Fin 3, dΓ r b c d * D r k) * D c i * D d j + Γ b c d * (A c k i * D d j + D c i * A d k j))))) (hi : Matrix (Fin 2) (Fin 2) ℝ) (Γ2 : Fin 2 → Fin 2 → Fin 2 → ℝ) (hΓ2 : ∀ l i j : Fin 2, Γ2 l i j = ∑ q : Fin 2, hi l q * Γ1 q i j) (II : Fin 2 → Fin 2 → ℝ) (hsplit : ∀ k m i j : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * V c k m * V d i j = ∑ a : Fin 2, ∑ b : Fin 2, hi a b * Γ1 a k m * Γ1 b i j + II k m * II i j) : dΓ1 0 0 1 1 - dΓ1 1 0 0 1 - ∑ l : Fin 2, Γ1 l 0 0 * Γ2 l 1 1 + ∑ l : Fin 2, Γ1 l 1 0 * Γ2 l 0 1 = (∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3, Gm m l * (dΓ i l j k - dΓ j l i k + ∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) * D i 0 * D j 1 * D k 1 * D m 0) + (II 0 0 * II 1 1 - II 0 1 * II 1 0) :=
by
  
  have hδ : ∀ x q : Fin 3, ∑ l : Fin 3, Gm l x * Gi l q = if x = q then 1 else 0 := by
    intro x q
    have h := congrFun (congrFun hGi x) q
    rw [Matrix.mul_apply, Matrix.one_apply] at h
    rw [← h]
    exact Finset.sum_congr rfl (fun l _ => by rw [hGs l x])
  have hhalf : ∀ x r a : Fin 3, ∑ l : Fin 3, Gm l x * Γ l r a
      = 1 / 2 * (dG r a x + dG a r x - dG x r a) := by
    intro x r a
    have e : ∑ l : Fin 3, Gm l x * Γ l r a = 1 / 2 * ∑ q : Fin 3,
        (∑ l : Fin 3, Gm l x * Gi l q) * (dG r a q + dG a r q - dG q r a) := by
      simp only [hΓ, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun q _ => Finset.sum_congr rfl (fun l _ => by ring))
    rw [e]
    simp only [hδ, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  have hcomp : ∀ r a b : Fin 3, dG r a b = ∑ l : Fin 3, (Gm l b * Γ l r a + Gm a l * Γ l r b) := by
    intro r a b
    rw [Finset.sum_add_distrib]
    have e2 : ∑ l : Fin 3, Gm a l * Γ l r b = ∑ l : Fin 3, Gm l a * Γ l r b :=
      Finset.sum_congr rfl (fun l _ => by rw [hGs a l])
    rw [e2, hhalf b r a, hhalf a r b]
    linarith [hdG r a b]
  
  have hII : ∀ k m i j : Fin 2, ∑ l : Fin 2, Γ1 l k m * Γ2 l i j
      = (∑ c : Fin 3, ∑ d : Fin 3, Gm c d * V c k m * V d i j) - II k m * II i j := by
    intro k m i j
    rw [hsplit k m i j]
    simp only [hΓ2, Fin.sum_univ_two]
    ring
  
  have hP : ∀ k m i j : Fin 2, dΓ1 k m i j =
      (∑ a : Fin 3, ∑ b : Fin 3, A a k m * Gm a b * V b i j)
      + (∑ a : Fin 3, ∑ b : Fin 3, D a m * (∑ r : Fin 3, dG r a b * D r k) * V b i j)
      + (∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b * T b k i j)
      + (∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
          (∑ r : Fin 3, dΓ r b c d * D r k) * D c i * D d j)
      + (∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
          Γ b c d * (A c k i * D d j + D c i * A d k j)) := by
    intro k m i j
    rw [hdΓ1]
    simp only [Finset.sum_add_distrib, mul_add]
    ring
  
  have hT3 : (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * T b 0 1 1)
      = (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * T b 1 0 1) := by
    simp only [hT]
  
  have hC6 : (∑ a : Fin 3, ∑ b : Fin 3, A a 0 0 * Gm a b * V b 1 1)
      - (∑ a : Fin 3, ∑ b : Fin 3, A a 1 0 * Gm a b * V b 0 1)
      - (∑ c : Fin 3, ∑ d : Fin 3, Gm c d * V c 0 0 * V d 1 1)
      + (∑ c : Fin 3, ∑ d : Fin 3, Gm c d * V c 1 0 * V d 0 1)
      = -(∑ a : Fin 3, ∑ b : Fin 3, Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ a c d * D c 0 * D d 0) * V b 1 1)
        + ∑ a : Fin 3, ∑ b : Fin 3, Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ a c d * D c 1 * D d 0) * V b 0 1 := by
    simp only [fun b => hV b 0 0, fun b => hV b 1 0]
    simp only [Fin.sum_univ_three]
    ring
  
  have hC2 : ∀ k m i j : Fin 2,
      ∑ a : Fin 3, ∑ b : Fin 3, D a m * (∑ r : Fin 3, dG r a b * D r k) * V b i j
      = ∑ a : Fin 3, ∑ b : Fin 3, Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ a c d * D c k * D d m) * V b i j
        + ∑ a : Fin 3, ∑ b : Fin 3, D a m * Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c k * V d i j) := by
    intro k m i j
    simp only [hcomp]
    simp only [Fin.sum_univ_three]
    ring
  
  have hC3 : (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
        (∑ r : Fin 3, dΓ r b c d * D r 0) * D c 1 * D d 1)
      - (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
        (∑ r : Fin 3, dΓ r b c d * D r 1) * D c 0 * D d 1)
      = ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          Gm m l * (dΓ i l j k - dΓ j l i k) * D i 0 * D j 1 * D k 1 * D m 0 := by
    simp only [Fin.sum_univ_three]
    ring
  
  have hC4 : (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * V d 1 1))
      - (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * V d 0 1))
      + (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
          Γ b c d * (A c 0 1 * D d 1 + D c 1 * A d 0 1))
      - (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b * ∑ c : Fin 3, ∑ d : Fin 3,
          Γ b c d * (A c 1 0 * D d 1 + D c 0 * A d 1 1))
      = ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          ((∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1))
           - ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1)) := by
    have Ib : ∀ b : Fin 3,
        (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * V d 1 1)
        - (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * V d 0 1)
        + (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * (A c 0 1 * D d 1 + D c 1 * A d 0 1))
        - (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * (A c 1 0 * D d 1 + D c 0 * A d 1 1))
        = (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1))
           - ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1) := by
      intro b
      simp only [hV, hA, Fin.sum_univ_three]
      ring
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    rw [← Ib b]
    ring
  
  have hC5a : ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        Gm m l * (∑ p : Fin 3, Γ l i p * Γ p j k) * D i 0 * D j 1 * D k 1 * D m 0
      = ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1)) := by
    simp only [Fin.sum_univ_three]
    ring
  have hC5b : ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        Gm m l * (∑ p : Fin 3, Γ l j p * Γ p i k) * D i 0 * D j 1 * D k 1 * D m 0
      = ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1)) := by
    simp only [Fin.sum_univ_three]
    ring
  have hC5 : ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        Gm m l * (∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) * D i 0 * D j 1 * D k 1 * D m 0
      = ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          ((∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1))
           - ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1)) := by
    have e1 : ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        Gm m l * (∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) * D i 0 * D j 1 * D k 1 * D m 0
        = (∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            Gm m l * (∑ p : Fin 3, Γ l i p * Γ p j k) * D i 0 * D j 1 * D k 1 * D m 0)
          - ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            Gm m l * (∑ p : Fin 3, Γ l j p * Γ p i k) * D i 0 * D j 1 * D k 1 * D m 0 := by
      simp only [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun i _ =>
        Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ =>
        Finset.sum_congr rfl (fun m _ => by rw [Finset.sum_sub_distrib]; ring)))))
    have e2 : ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          ((∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1))
           - ∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1))
        = (∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 0 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 1 * D f 1)))
          - ∑ a : Fin 3, ∑ b : Fin 3, D a 0 * Gm a b *
          (∑ c : Fin 3, ∑ d : Fin 3, Γ b c d * D c 1 * (∑ e : Fin 3, ∑ f : Fin 3, Γ d e f * D e 0 * D f 1)) := by
      simp only [mul_sub, Finset.sum_sub_distrib]
    rw [e1, e2, hC5a, hC5b]
  
  have hR : (∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3, Gm m l * (dΓ i l j k - dΓ j l i k + ∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) * D i 0 * D j 1 * D k 1 * D m 0)
      = (∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          Gm m l * (dΓ i l j k - dΓ j l i k) * D i 0 * D j 1 * D k 1 * D m 0)
        + ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          Gm m l * (∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) * D i 0 * D j 1 * D k 1 * D m 0 := by
    simp only [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun i _ =>
      Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ =>
      Finset.sum_congr rfl (fun m _ => by ring)))))
  
  have hPa := hP 0 0 1 1
  have hPb := hP 1 0 0 1
  have hII00 := hII 0 0 1 1
  have hII10 := hII 1 0 0 1
  have hC2a := hC2 0 0 1 1
  have hC2b := hC2 1 0 0 1
  linear_combination hPa - hPb - hII00 + hII10 + hC6 + hC2a - hC2b + hT3 + hC3 + hC4 - hC5 - hR

theorem gs_gauss_equation (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, gaussCurv2 (pullMetric2 G F) x = gsAmbPlane G F x / (pullMetric2 G F x).det + (gsMeanCurv G F x ^ 2 - gsSffSq G F x) / 2 :=
by
  intro x hx
  obtain ⟨hh, hhsymm, hhpos, -, hSsymm, -, -⟩ :=
    gs_regularity G U hU hG hGsymm hGpos F s hs hF hFU hinj
  have hdetpos : 0 < (pullMetric2 G F x).det := (hhpos x hx).det_pos
  have hdet : (pullMetric2 G F x).det ≠ 0 := hdetpos.ne'
  have hGx : (G (F x)).PosDef := hGpos (F x) (hFU x hx)
  
  have hint := gge_gauss_intrinsic (pullMetric2 G F) s hs hh hhsymm hhpos x hx
  
  have hkos := gge_koszul_tangent G U hU hG hGsymm hGpos F s hs hF hFU
  
  have hder := gge_koszul_deriv G U hU hG hGpos F s hs hF hFU x hx
  have hdΓ1 : ∀ k m i j : Fin 2, pd2 k (ggeGam1 (pullMetric2 G F) m i j) x =
      pd2 k (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
        gsTan F m z a * G (F z) a b * gsCovHess G F i j z b) x := by
    intro k m i j
    have hev : ggeGam1 (pullMetric2 G F) m i j =ᶠ[𝓝 x] (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
        gsTan F m z a * G (F z) a b * gsCovHess G F i j z b) :=
      Filter.eventually_of_mem (hs.mem_nhds hx) (fun z hz => hkos z hz m i j)
    unfold pd2
    rw [hev.fderiv_eq]
  
  have hcl : ∀ {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] (c : E2 → E2 →L[ℝ] W)
      (u v : E2), DifferentiableAt ℝ c x → fderiv ℝ (fun z => c z u) x v = fderiv ℝ c x v u := by
    intro W _ _ c u v hc
    rw [fderiv_clm_apply hc (differentiableAt_const _)]
    simp
  have hs4 : (∀ i j : Fin 2, gsHessF F i j x = gsHessF F j i x) ∧
      ∀ (k i j : Fin 2) (b : Fin 3), pd2 k (fun z => gsHessF F i j z b) x =
        pd2 i (fun z => gsHessF F k j z b) x := by
    have hFat : ∀ z ∈ s, ContDiffAt ℝ ∞ F z := fun z hz => hF.contDiffAt (hs.mem_nhds hz)
    have hD1at : ∀ z ∈ s, ContDiffAt ℝ ∞ (fderiv ℝ F) z :=
      fun z hz => (hFat z hz).fderiv_right (m := ∞) (by simp)
    have hD2at : ∀ z ∈ s, ContDiffAt ℝ ∞ (fderiv ℝ (fderiv ℝ F)) z :=
      fun z hz => (hD1at z hz).fderiv_right (m := ∞) (by simp)
    have hH : ∀ z ∈ s, ∀ i j : Fin 2,
        gsHessF F i j z = fderiv ℝ (fderiv ℝ F) z (e2 i) (e2 j) := by
      intro z hz i j
      have hd : DifferentiableAt ℝ (fderiv ℝ F) z := (hD1at z hz).differentiableAt (by simp)
      unfold gsHessF
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    have hsymF : IsSymmSndFDerivAt ℝ F x :=
      (hFat x hx).isSymmSndFDerivAt (by simp <;> norm_cast)
    have hsymD1 : IsSymmSndFDerivAt ℝ (fderiv ℝ F) x :=
      (hD1at x hx).isSymmSndFDerivAt (by simp <;> norm_cast)
    have hD2d : DifferentiableAt ℝ (fderiv ℝ (fderiv ℝ F)) x :=
      (hD2at x hx).differentiableAt (by simp)
    have hT3 : ∀ (k i j : Fin 2) (b : Fin 3), pd2 k (fun z => gsHessF F i j z b) x =
        fderiv ℝ (fderiv ℝ (fderiv ℝ F)) x (e2 k) (e2 i) (e2 j) b := by
      intro k i j b
      have hev : (fun z => gsHessF F i j z b) =ᶠ[𝓝 x]
          (fun z => fderiv ℝ (fderiv ℝ F) z (e2 i) (e2 j) b) :=
        Filter.eventually_of_mem (hs.mem_nhds hx) (fun z hz => by dsimp only; rw [hH z hz i j])
      unfold pd2
      rw [hev.fderiv_eq]
      have hL : DifferentiableAt ℝ (fun z => fderiv ℝ (fderiv ℝ F) z (e2 i) (e2 j)) x :=
        (hD2d.clm_apply (differentiableAt_const _)).clm_apply (differentiableAt_const _)
      have hproj : (fun z => fderiv ℝ (fderiv ℝ F) z (e2 i) (e2 j) b) =
          (EuclideanSpace.proj b : E3 →L[ℝ] ℝ) ∘
            (fun z => fderiv ℝ (fderiv ℝ F) z (e2 i) (e2 j)) := by
        funext z; rfl
      rw [hproj, fderiv_comp x (EuclideanSpace.proj b).differentiableAt hL,
        ContinuousLinearMap.fderiv, ContinuousLinearMap.comp_apply]
      have e1 := hcl (fun z => fderiv ℝ (fderiv ℝ F) z (e2 i)) (e2 j) (e2 k)
        (hD2d.clm_apply (differentiableAt_const _))
      have e2' := hcl (fderiv ℝ (fderiv ℝ F)) (e2 i) (e2 k) hD2d
      rw [e1, e2']
      rfl
    refine ⟨fun i j => ?_, fun k i j b => ?_⟩
    · rw [hH x hx i j, hH x hx j i]
      exact hsymF (e2 i) (e2 j)
    · rw [hT3 k i j b, hT3 i k j b, hsymD1 (e2 k) (e2 i)]
  obtain ⟨hA, hT⟩ := hs4
  
  have hsplit : ∀ k m i j : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3,
      G (F x) c d * gsCovHess G F k m x c * gsCovHess G F i j x d =
      ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b *
        ggeGam1 (pullMetric2 G F) a k m x * ggeGam1 (pullMetric2 G F) b i j x +
      gsSff G F k m x * gsSff G F i j x := by
    intro k m i j
    have h5 := gge_normal_split G F x hGsymm hGx (hinj x hx)
      (fun c => gsCovHess G F k m x c) (fun d => gsCovHess G F i j x d)
    simp only [← hkos x hx] at h5
    rw [h5]
    congr 1
    simp only [gsSff]
    rw [div_mul_div_comm, sq]
  
  have hΓ2 : ∀ l i j : Fin 2, christoffel2 (pullMetric2 G F) l i j x =
      ∑ q : Fin 2, (pullMetric2 G F x)⁻¹ l q * ggeGam1 (pullMetric2 G F) q i j x := by
    intro l i j
    simp only [christoffel2, ggeGam1, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q _
    ring
  have hGi : G (F x) * (G (F x))⁻¹ = 1 :=
    Matrix.mul_nonsing_inv (G (F x)) (isUnit_iff_ne_zero.mpr hGx.det_pos.ne')
  have hdG : ∀ r a b : Fin 3, partialDeriv r (fun y => G y a b) (F x) =
      partialDeriv r (fun y => G y b a) (F x) := by
    intro r a b
    have : (fun y => G y a b) = (fun y => G y b a) := funext fun y => hGsymm y a b
    rw [this]
  
  have key := gge_gauss_extrinsic_alg (G (F x)) (G (F x))⁻¹ hGi (hGsymm (F x))
    (fun r a b => partialDeriv r (fun y => G y a b) (F x)) hdG
    (fun k a b => christoffel G k a b (F x)) (fun k a b => rfl)
    (fun r b c d => partialDeriv r (christoffel G b c d) (F x))
    (fun a i => gsTan F i x a) (fun a k i => gsHessF F k i x a)
    (fun c => by simp only [hA 0 1])
    (fun b k i j => pd2 k (fun z => gsHessF F i j z b) x)
    (fun b => hT 0 1 1 b)
    (fun b i j => gsCovHess G F i j x b) (fun b i j => rfl)
    (fun m i j => ggeGam1 (pullMetric2 G F) m i j x)
    (fun k m i j => pd2 k (ggeGam1 (pullMetric2 G F) m i j) x)
    (fun k m i j => by simp only []; rw [hdΓ1 k m i j]; exact hder k m i j)
    ((pullMetric2 G F x)⁻¹)
    (fun l i j => christoffel2 (pullMetric2 G F) l i j x) hΓ2
    (fun i j => gsSff G F i j x) hsplit
  have key' : ggeRiem0110 (pullMetric2 G F) x = gsAmbPlane G F x +
      (gsSff G F 0 0 x * gsSff G F 1 1 x - gsSff G F 0 1 x * gsSff G F 1 0 x) := key
  
  have hcay : (gsSff G F 0 0 x * gsSff G F 1 1 x - gsSff G F 0 1 x * gsSff G F 1 0 x) /
      (pullMetric2 G F x).det = (gsTrace (pullMetric2 G F) (gsSff G F) x ^ 2 -
        gsInner (pullMetric2 G F) (gsSff G F) (gsSff G F) x) / 2 := by
    have hinv : (pullMetric2 G F x)⁻¹ = (pullMetric2 G F x).det⁻¹ •
        !![pullMetric2 G F x 1 1, -pullMetric2 G F x 0 1;
          -pullMetric2 G F x 1 0, pullMetric2 G F x 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have h10 := hhsymm x hx 1 0
    have s10 := hSsymm x hx 1 0
    have hdet' := hdet
    rw [Matrix.det_fin_two, h10] at hdet'
    have hD2 : pullMetric2 G F x 0 0 * pullMetric2 G F x 1 1 - pullMetric2 G F x 0 1 ^ 2 ≠ 0 := by
      rw [sq]; exact hdet'
    simp only [gsTrace, gsInner, Fin.sum_univ_two, hinv, Matrix.smul_apply, Matrix.of_apply,
      Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Matrix.empty_val', Matrix.cons_val_fin_one, smul_eq_mul]
    rw [Matrix.det_fin_two, h10, s10]
    field_simp
    ring
  have hK : gaussCurv2 (pullMetric2 G F) x =
      ggeRiem0110 (pullMetric2 G F) x / (pullMetric2 G F x).det := by
    rw [eq_div_iff hdet]
    exact hint
  rw [hK, key', add_div, hcay]
  rfl

theorem amb_rm_antisymm (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) : ∀ y ∈ U, ∀ i j k m : Fin 3, ∑ l : Fin 3, G y m l * riemannLocal G l i j k y = -∑ l : Fin 3, G y k l * riemannLocal G l i j m y :=
by
  
  have lower : ∀ (g gi : Matrix (Fin 3) (Fin 3) ℝ) (T : Fin 3 → ℝ), g * gi = 1 →
      ∀ m : Fin 3, ∑ l : Fin 3, g m l * (1 / 2 * ∑ q : Fin 3, gi l q * T q) = 1 / 2 * T m := by
    intro g gi T h1 m
    have hδ : ∀ q : Fin 3, ∑ l : Fin 3, g m l * gi l q = if m = q then 1 else 0 := by
      intro q
      have := congrFun (congrFun h1 m) q
      rwa [Matrix.mul_apply, Matrix.one_apply] at this
    have e : ∑ l : Fin 3, g m l * (1 / 2 * ∑ q : Fin 3, gi l q * T q) =
        1 / 2 * ∑ q : Fin 3, (∑ l : Fin 3, g m l * gi l q) * T q := by
      simp only [Fin.sum_univ_three]; ring
    rw [e]
    simp only [hδ, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
  
  have core : ∀ (g gi : Matrix (Fin 3) (Fin 3) ℝ) (Γ dg : Fin 3 → Fin 3 → Fin 3 → ℝ)
      (ddg dΓ : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
      g * gi = 1 → (∀ a b : Fin 3, g a b = g b a) → (∀ c a b : Fin 3, dg c a b = dg c b a) →
      (∀ c d a b : Fin 3, ddg c d a b = ddg d c a b) →
      (∀ l j k : Fin 3, Γ l j k = 1 / 2 * ∑ q : Fin 3, gi l q * (dg j k q + dg k j q - dg q j k)) →
      (∀ i m j k : Fin 3, ∑ l : Fin 3, (dg i m l * Γ l j k + g m l * dΓ i l j k) =
          1 / 2 * (ddg i j k m + ddg i k j m - ddg i m j k)) →
      ∀ i j k m : Fin 3, ∑ l : Fin 3, g m l * (dΓ i l j k - dΓ j l i k +
          ∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) =
        -∑ l : Fin 3, g k l * (dΓ i l j m - dΓ j l i m +
          ∑ p : Fin 3, (Γ l i p * Γ p j m - Γ l j p * Γ p i m)) := by
    intro g gi Γ dg ddg dΓ h1 hg h3 h4 h5 h6 i j k m
    have ha : ∀ m j k : Fin 3, ∑ l : Fin 3, g m l * Γ l j k =
        1 / 2 * (dg j k m + dg k j m - dg m j k) := by
      intro m j k
      simp only [h5]
      exact lower g gi (fun q => dg j k q + dg k j q - dg q j k) h1 m
    have hD : ∀ i m j k : Fin 3, ∑ l : Fin 3, g m l * dΓ i l j k =
        1 / 2 * (ddg i j k m + ddg i k j m - ddg i m j k) - ∑ l : Fin 3, dg i m l * Γ l j k := by
      intro i m j k
      have := h6 i m j k
      rw [Finset.sum_add_distrib] at this
      linarith
    have hQ : ∀ m a b c : Fin 3, ∑ l : Fin 3, g m l * ∑ p : Fin 3, Γ l a p * Γ p b c =
        ∑ p : Fin 3, 1 / 2 * (dg a p m + dg p a m - dg m a p) * Γ p b c := by
      intro m a b c
      have e : ∑ l : Fin 3, g m l * ∑ p : Fin 3, Γ l a p * Γ p b c =
          ∑ p : Fin 3, (∑ l : Fin 3, g m l * Γ l a p) * Γ p b c := by
        simp only [Fin.sum_univ_three]; ring
      rw [e]
      simp only [ha]
    have hMC : ∀ i m j k : Fin 3, ∑ l : Fin 3, dg i m l * Γ l j k =
        ∑ p : Fin 3, 1 / 2 * (dg i p m + dg p i m - dg m i p) * Γ p j k +
        ∑ l : Fin 3, 1 / 2 * (dg i m l + dg m i l - dg l i m) * Γ l j k := by
      intro i m j k
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [h3 i l m]
      ring
    have hS0 : ∀ a b c d : Fin 3, ∑ l : Fin 3, (∑ q : Fin 3, g l q * Γ q a b) * Γ l c d =
        ∑ l : Fin 3, (∑ q : Fin 3, g l q * Γ q c d) * Γ l a b := by
      intro a b c d
      simp only [Fin.sum_univ_three]
      rw [hg 1 0, hg 2 0, hg 2 1]
      ring
    have hS : ∀ a b c d : Fin 3, ∑ l : Fin 3, 1 / 2 * (dg a b l + dg b a l - dg l a b) * Γ l c d =
        ∑ l : Fin 3, 1 / 2 * (dg c d l + dg d c l - dg l c d) * Γ l a b := by
      intro a b c d
      have := hS0 a b c d
      simp only [ha] at this
      exact this
    have hE : ∀ i j k m : Fin 3, ∑ l : Fin 3, g m l * (dΓ i l j k - dΓ j l i k +
          ∑ p : Fin 3, (Γ l i p * Γ p j k - Γ l j p * Γ p i k)) =
        ∑ l : Fin 3, g m l * dΓ i l j k - ∑ l : Fin 3, g m l * dΓ j l i k +
          ∑ l : Fin 3, g m l * ∑ p : Fin 3, Γ l i p * Γ p j k -
          ∑ l : Fin 3, g m l * ∑ p : Fin 3, Γ l j p * Γ p i k := by
      intro i j k m
      simp only [Fin.sum_univ_three]; ring
    have e1 := hE i j k m
    have e2 := hE i j m k
    have d1 := hD i m j k
    have d2 := hD j m i k
    have d3 := hD i k j m
    have d4 := hD j k i m
    have q1 := hQ m i j k
    have q2 := hQ m j i k
    have q3 := hQ k i j m
    have q4 := hQ k j i m
    have c1 := hMC i m j k
    have c2 := hMC j m i k
    have c3 := hMC i k j m
    have c4 := hMC j k i m
    have s1 := hS j m i k
    have s2 := hS j k i m
    have w1 := h4 i j k m
    have w2 := h4 i j m k
    linarith
  
  have hinv : ∀ z ∈ U, G z * (G z)⁻¹ = 1 := fun z hz =>
    Matrix.mul_nonsing_inv (G z) (isUnit_iff_ne_zero.mpr (hGpos z hz).det_pos.ne')
  
  have hlow : ∀ z ∈ U, ∀ m j k : Fin 3, ∑ l : Fin 3, G z m l * christoffel G l j k z =
      1 / 2 * (partialDeriv j (fun w => G w k m) z + partialDeriv k (fun w => G w j m) z -
        partialDeriv m (fun w => G w j k) z) := by
    intro z hz m j k
    exact lower (G z) (G z)⁻¹ (fun q => partialDeriv j (fun w => G w k q) z +
      partialDeriv k (fun w => G w j q) z - partialDeriv q (fun w => G w j k) z) (hinv z hz) m
  
  have pd_add : ∀ (c : Fin 3) (f h : E3 → ℝ) (y : E3), DifferentiableAt ℝ f y →
      DifferentiableAt ℝ h y →
      partialDeriv c (fun z => f z + h z) y = partialDeriv c f y + partialDeriv c h y := by
    intro c f h y hf hh
    simp only [partialDeriv]
    rw [fderiv_fun_add hf hh]
    rfl
  have pd_sub : ∀ (c : Fin 3) (f h : E3 → ℝ) (y : E3), DifferentiableAt ℝ f y →
      DifferentiableAt ℝ h y →
      partialDeriv c (fun z => f z - h z) y = partialDeriv c f y - partialDeriv c h y := by
    intro c f h y hf hh
    simp only [partialDeriv]
    rw [fderiv_fun_sub hf hh]
    rfl
  have pd_mul : ∀ (c : Fin 3) (f h : E3 → ℝ) (y : E3), DifferentiableAt ℝ f y →
      DifferentiableAt ℝ h y →
      partialDeriv c (fun z => f z * h z) y = partialDeriv c f y * h y + f y * partialDeriv c h y := by
    intro c f h y hf hh
    simp only [partialDeriv]
    rw [fderiv_fun_mul hf hh]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pd_cmul : ∀ (c : Fin 3) (a : ℝ) (f : E3 → ℝ) (y : E3), DifferentiableAt ℝ f y →
      partialDeriv c (fun z => a * f z) y = a * partialDeriv c f y := by
    intro c a f y hf
    simp only [partialDeriv]
    rw [fderiv_const_mul hf a]
    rfl
  have pd_sum : ∀ (c : Fin 3) (F : Fin 3 → E3 → ℝ) (y : E3), (∀ l, DifferentiableAt ℝ (F l) y) →
      partialDeriv c (fun z => ∑ l : Fin 3, F l z) y = ∑ l : Fin 3, partialDeriv c (F l) y := by
    intro c F y hF
    simp only [partialDeriv]
    rw [fderiv_fun_sum (fun l _ => hF l)]
    simp only [ContinuousLinearMap.sum_apply]
  
  have hpd : ∀ c a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv c (fun z => G z a b)) U := by
    intro c a b
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => G z a b) y (e c)) U
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 (hG a b)).2.clm_apply contDiffOn_const
  
  have h6all : ∀ y ∈ U, ∀ i m j k : Fin 3, ∑ l : Fin 3,
      (partialDeriv i (fun z => G z m l) y * christoffel G l j k y +
        G y m l * partialDeriv i (christoffel G l j k) y) =
      1 / 2 * (partialDeriv i (fun z => partialDeriv j (fun w => G w k m) z) y +
        partialDeriv i (fun z => partialDeriv k (fun w => G w j m) z) y -
        partialDeriv i (fun z => partialDeriv m (fun w => G w j k) z) y) := by
    intro y hy i m j k
    have hy' : U ∈ 𝓝 y := hU.mem_nhds hy
    have dG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y := fun a b =>
      ((hG a b).contDiffAt hy').differentiableAt (by simp)
    have dC : ∀ l : Fin 3, DifferentiableAt ℝ (christoffel G l j k) y := fun l =>
      ((hΓ l j k).contDiffAt hy').differentiableAt (by simp)
    have dP : ∀ c a b : Fin 3, DifferentiableAt ℝ (partialDeriv c (fun z => G z a b)) y :=
      fun c a b => ((hpd c a b).contDiffAt hy').differentiableAt (by simp)
    have hev : (fun z => ∑ l : Fin 3, G z m l * christoffel G l j k z) =ᶠ[𝓝 y]
        (fun z => 1 / 2 * (partialDeriv j (fun w => G w k m) z +
          partialDeriv k (fun w => G w j m) z - partialDeriv m (fun w => G w j k) z)) :=
      Filter.eventuallyEq_of_mem hy' (fun z hz => hlow z hz m j k)
    have key : partialDeriv i (fun z => ∑ l : Fin 3, G z m l * christoffel G l j k z) y =
        partialDeriv i (fun z => 1 / 2 * (partialDeriv j (fun w => G w k m) z +
          partialDeriv k (fun w => G w j m) z - partialDeriv m (fun w => G w j k) z)) y :=
      congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hev.fderiv_eq
    have hL : partialDeriv i (fun z => ∑ l : Fin 3, G z m l * christoffel G l j k z) y =
        ∑ l : Fin 3, (partialDeriv i (fun z => G z m l) y * christoffel G l j k y +
          G y m l * partialDeriv i (christoffel G l j k) y) := by
      rw [pd_sum i (fun l z => G z m l * christoffel G l j k z) y
        (fun l => (dG m l).mul (dC l))]
      refine Finset.sum_congr rfl fun l _ => ?_
      exact pd_mul i (fun z => G z m l) (christoffel G l j k) y (dG m l) (dC l)
    have hR : partialDeriv i (fun z => 1 / 2 * (partialDeriv j (fun w => G w k m) z +
          partialDeriv k (fun w => G w j m) z - partialDeriv m (fun w => G w j k) z)) y =
        1 / 2 * (partialDeriv i (fun z => partialDeriv j (fun w => G w k m) z) y +
          partialDeriv i (fun z => partialDeriv k (fun w => G w j m) z) y -
          partialDeriv i (fun z => partialDeriv m (fun w => G w j k) z) y) := by
      rw [pd_cmul i (1 / 2) (fun z => partialDeriv j (fun w => G w k m) z +
          partialDeriv k (fun w => G w j m) z - partialDeriv m (fun w => G w j k) z) y
          (((dP j k m).add (dP k j m)).sub (dP m j k))]
      rw [pd_sub i (fun z => partialDeriv j (fun w => G w k m) z +
          partialDeriv k (fun w => G w j m) z) (partialDeriv m (fun w => G w j k)) y
          ((dP j k m).add (dP k j m)) (dP m j k)]
      rw [pd_add i (partialDeriv j (fun w => G w k m)) (partialDeriv k (fun w => G w j m)) y
          (dP j k m) (dP k j m)]
    rw [← hL, key, hR]
  
  have hschwarz : ∀ y ∈ U, ∀ c d a b : Fin 3,
      partialDeriv c (fun z => partialDeriv d (fun w => G w a b) z) y =
      partialDeriv d (fun z => partialDeriv c (fun w => G w a b) z) y := by
    intro y hy c d a b
    have hf : ContDiffAt ℝ ∞ (fun w => G w a b) y := (hG a b).contDiffAt (hU.mem_nhds hy)
    have hsym : IsSymmSndFDerivAt ℝ (fun w => G w a b) y := by
      apply hf.isSymmSndFDerivAt
      rw [minSmoothness_of_isRCLikeNormedField]
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | simp
        | norm_num
    have hdf : DifferentiableAt ℝ (fderiv ℝ (fun w => G w a b)) y :=
      (hf.fderiv_right (m := 1) (by
        first
          | exact_mod_cast (le_top : ((1 + 1 : ℕ) : ℕ∞) ≤ ⊤)
          | exact WithTop.coe_le_coe.mpr le_top
          | simp
          | norm_num)).differentiableAt (by simp)
    have conv : ∀ c d : Fin 3, partialDeriv c (fun z => partialDeriv d (fun w => G w a b) z) y =
        fderiv ℝ (fderiv ℝ (fun w => G w a b)) y (e c) (e d) := by
      intro c d
      show fderiv ℝ (fun z => fderiv ℝ (fun w => G w a b) z (e d)) y (e c) = _
      rw [fderiv_clm_apply hdf (differentiableAt_const (e d))]
      simp
    rw [conv, conv]
    exact hsym.eq (e c) (e d)
  
  intro y hy i j k m
  have hc := core (G y) ((G y)⁻¹) (fun l j k => christoffel G l j k y)
    (fun c a b => partialDeriv c (fun z => G z a b) y)
    (fun c d a b => partialDeriv c (fun z => partialDeriv d (fun w => G w a b) z) y)
    (fun i l j k => partialDeriv i (christoffel G l j k) y)
    (hinv y hy) (hGsymm y)
    (fun c a b => by
      show partialDeriv c (fun z => G z a b) y = partialDeriv c (fun z => G z b a) y
      rw [show (fun z => G z a b) = (fun z => G z b a) from funext fun z => hGsymm z a b])
    (fun c d a b => hschwarz y hy c d a b)
    (fun l j k => rfl)
    (fun i m j k => h6all y hy i m j k) i j k m
  simpa only [riemannLocal] using hc

theorem gs_amb_plane_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (B : Set E3) (hB : IsCompact B) (hBU : B ⊆ U) : ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ y ∈ B, ∀ X Y : E3, |∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3, G y m l * riemannLocal G l i j k y * X i * Y j * Y k * X m| ≤ K₀ * ((∑ a : Fin 3, ∑ b : Fin 3, X a * G y a b * X b) * (∑ a : Fin 3, ∑ b : Fin 3, Y a * G y a b * Y b) - (∑ a : Fin 3, ∑ b : Fin 3, X a * G y a b * Y b) ^ 2) :=
by
  classical
  
  have hGinv := ginv_contDiffOn G U hG hGpos
  
  have hpd : ∀ c a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv c (fun z => G z a b)) U := by
    intro c a b
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => G z a b) y (e c)) U
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 (hG a b)).2.clm_apply contDiffOn_const
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    have e1 : christoffel G k i j = fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y) := rfl
    rw [e1]
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGinv k l).mul (((hpd i j l).add (hpd j i l)).sub (hpd l i j)))
  
  have hanti := amb_rm_antisymm G U hU hG hGsymm hGpos hΓ
  
  obtain ⟨μ, hμ, hcoer⟩ : ∃ μ : ℝ, 0 < μ ∧ ∀ y ∈ B, ∀ v : E3,
      μ * ∑ a : Fin 3, v a ^ 2 ≤ ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b := by
    rcases B.eq_empty_or_nonempty with hBe | hBne
    · exact ⟨1, one_pos, fun y hy => by simp [hBe] at hy⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : E3 × E3 → ℝ, ∀ p, φ p = ∑ a : Fin 3, ∑ b : Fin 3,
        p.2 a * G p.1 a b * p.2 b := ⟨_, fun p => rfl⟩
    have hK : IsCompact (B ×ˢ Metric.sphere (0 : E3) 1) := hB.prod (isCompact_sphere 0 1)
    have hKne : (B ×ˢ Metric.sphere (0 : E3) 1).Nonempty :=
      hBne.prod (NormedSpace.sphere_nonempty.mpr zero_le_one)
    have hφc : ContinuousOn φ (B ×ˢ Metric.sphere (0 : E3) 1) := by
      have hφ' : φ = fun p => ∑ a : Fin 3, ∑ b : Fin 3, p.2 a * G p.1 a b * p.2 b := funext hφ
      rw [hφ']
      have hc2 : ∀ a : Fin 3, Continuous (fun p : E3 × E3 => p.2 a) := fun a =>
        (PiLp.continuous_apply 2 _ a).comp continuous_snd
      have hc1 : ∀ a b : Fin 3, ContinuousOn (fun p : E3 × E3 => G p.1 a b)
          (B ×ˢ Metric.sphere (0 : E3) 1) := fun a b =>
        ((hG a b).continuousOn.mono hBU).comp continuous_fst.continuousOn (fun p hp => hp.1)
      apply continuousOn_finset_sum
      intro a _
      apply continuousOn_finset_sum
      intro b _
      exact (((hc2 a).continuousOn).mul (hc1 a b)).mul (hc2 b).continuousOn
    obtain ⟨p₀, hp₀K, hp₀min⟩ := hK.exists_isMinOn hKne hφc
    refine ⟨φ p₀, ?_, ?_⟩
    · obtain ⟨hy₀, hv₀⟩ := hp₀K
      have hv0 : p₀.2 ≠ 0 := by
        intro h
        rw [Metric.mem_sphere, h, dist_self] at hv₀
        norm_num at hv₀
      have hx : (fun a => p₀.2 a) ≠ 0 := by
        intro h
        apply hv0
        ext a
        exact congrFun h a
      have hpos := (hGpos p₀.1 (hBU hy₀)).dotProduct_mulVec_pos hx
      have e2 : φ p₀ = star (fun a => p₀.2 a) ⬝ᵥ ((G p₀.1).mulVec (fun a => p₀.2 a)) := by
        rw [hφ]
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
        ring
      rw [e2]
      exact hpos
    · intro y hy v
      by_cases hv : v = 0
      · subst hv
        simp
      · have hr : 0 < ‖v‖ := norm_pos_iff.mpr hv
        have hu : ‖v‖⁻¹ • v ∈ Metric.sphere (0 : E3) 1 := by
          rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hr.ne']
        have hmin : φ p₀ ≤ φ (y, ‖v‖⁻¹ • v) := isMinOn_iff.1 hp₀min _ ⟨hy, hu⟩
        have hN : ∑ a : Fin 3, v a ^ 2 = ‖v‖ ^ 2 := by
          rw [EuclideanSpace.norm_sq_eq]
          simp [Real.norm_eq_abs, sq_abs]
        have hφu : φ (y, ‖v‖⁻¹ • v) = (‖v‖ ^ 2)⁻¹ *
            ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b := by
          rw [hφ]
          simp only [PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
          field_simp
        rw [hφu] at hmin
        rw [hN]
        have hr2 : 0 < ‖v‖ ^ 2 := by positivity
        have := mul_le_mul_of_nonneg_left hmin hr2.le
        rw [← mul_assoc, mul_inv_cancel₀ hr2.ne', one_mul] at this
        linarith
  
  obtain ⟨M, hM0, hM⟩ : ∃ M : ℝ, 0 ≤ M ∧ ∀ y ∈ B, ∀ i j k m : Fin 3,
      |∑ l : Fin 3, G y m l * riemannLocal G l i j k y| ≤ M := by
    have hdΓ : ∀ c l j k : Fin 3, ContinuousOn (partialDeriv c (christoffel G l j k)) U := by
      intro c l j k
      show ContinuousOn (fun y => fderiv ℝ (christoffel G l j k) y (e c)) U
      exact ((hΓ l j k).continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
    have hR : ∀ l i j k : Fin 3, ContinuousOn (riemannLocal G l i j k) U := by
      intro l i j k
      have e1 : riemannLocal G l i j k = fun y => partialDeriv i (christoffel G l j k) y
          - partialDeriv j (christoffel G l i k) y
          + ∑ p : Fin 3, (christoffel G l i p y * christoffel G p j k y
              - christoffel G l j p y * christoffel G p i k y) := rfl
      rw [e1]
      exact ((hdΓ i l j k).sub (hdΓ j l i k)).add (continuousOn_finset_sum _ fun p _ =>
        (((hΓ l i p).continuousOn.mul (hΓ p j k).continuousOn).sub
          ((hΓ l j p).continuousOn.mul (hΓ p i k).continuousOn)))
    obtain ⟨F, hFdef⟩ : ∃ F : E3 → (Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
        ∀ y i j k m, F y i j k m = ∑ l : Fin 3, G y m l * riemannLocal G l i j k y :=
      ⟨fun y i j k m => ∑ l : Fin 3, G y m l * riemannLocal G l i j k y, fun _ _ _ _ _ => rfl⟩
    have hF : ContinuousOn F B := by
      refine continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => continuousOn_pi.2 fun k =>
        continuousOn_pi.2 fun m => ?_
      simp only [hFdef]
      exact (continuousOn_finset_sum _ fun l _ => (hG m l).continuousOn.mul (hR l i j k)).mono hBU
    obtain ⟨C, hC⟩ := hB.exists_bound_of_continuousOn hF
    refine ⟨max C 0, le_max_right _ _, fun y hy i j k m => ?_⟩
    have h := hC y hy
    calc |∑ l : Fin 3, G y m l * riemannLocal G l i j k y| = ‖F y i j k m‖ := by
          rw [Real.norm_eq_abs, hFdef]
      _ ≤ ‖F y i j k‖ := norm_le_pi_norm _ m
      _ ≤ ‖F y i j‖ := norm_le_pi_norm _ k
      _ ≤ ‖F y i‖ := norm_le_pi_norm _ j
      _ ≤ ‖F y‖ := norm_le_pi_norm _ i
      _ ≤ max C 0 := h.trans (le_max_left _ _)
  
  have key : ∀ (P : Matrix (Fin 3) (Fin 3) ℝ) (A : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ a b : Fin 3, P a b = P b a) →
      (∀ v : E3, μ * ∑ a : Fin 3, v a ^ 2 ≤ ∑ a : Fin 3, ∑ b : Fin 3, v a * P a b * v b) →
      (∀ i j k m : Fin 3, A i j k m = -A j i k m) →
      (∀ i j k m : Fin 3, A i j k m = -A i j m k) →
      (∀ i j k m : Fin 3, |A i j k m| ≤ M) →
      ∀ X Y : E3, |∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j k m * X i * Y j * Y k * X m| ≤
        9 * M / μ ^ 2 * ((∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * X b) *
          (∑ a : Fin 3, ∑ b : Fin 3, Y a * P a b * Y b) -
          (∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * Y b) ^ 2) := by
    intro P A hP hcoerP hA1 hA2 hAM X Y
    have V1 : ∀ u v w : E3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        A i j k m * u i * u j * v k * w m = 0 := by
      intro u v w
      have h1 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j k m * u i * u j * v k * w m = ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          ∑ m : Fin 3, A j i k m * u j * u i * v k * w m := Finset.sum_comm
      have h2 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A j i k m * u j * u i * v k * w m = -∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          ∑ m : Fin 3, A i j k m * u i * u j * v k * w m := by
        simp only [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
          Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun m _ => ?_
        rw [hA1 j i k m]
        ring
      linarith
    have V2 : ∀ u v w : E3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        A i j k m * u i * v j * w k * w m = 0 := by
      intro u v w
      have h1 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j k m * u i * v j * w k * w m = ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          ∑ m : Fin 3, A i j m k * u i * v j * w m * w k :=
        Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => Finset.sum_comm
      have h2 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j m k * u i * v j * w m * w k = -∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          ∑ m : Fin 3, A i j k m * u i * v j * w k * w m := by
        simp only [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
          Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun m _ => ?_
        rw [hA2 i j m k]
        ring
      linarith
    have shift : ∀ c : ℝ, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        A i j k m * X i * (Y - c • X) j * (Y - c • X) k * X m =
        ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j k m * X i * Y j * Y k * X m := by
      intro c
      have e1 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          A i j k m * X i * (Y - c • X) j * (Y - c • X) k * X m =
          ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            A i j k m * X i * Y j * Y k * X m
          - c * (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            A i j k m * X i * X j * Y k * X m)
          - c * (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            A i j k m * X i * Y j * X k * X m)
          + c ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            A i j k m * X i * X j * X k * X m) := by
        simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
        ring
      rw [e1, V1 X Y X, V2 X Y X, V1 X X X]
      ring
    have crude : ∀ u v : E3, |∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        A i j k m * u i * v j * v k * u m| ≤
        M * (∑ i : Fin 3, |u i|) ^ 2 * (∑ j : Fin 3, |v j|) ^ 2 := by
      intro u v
      calc _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            |A i j k m * u i * v j * v k * u m| := by
            refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
            refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
            refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun k _ => ?_)
            exact Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
            M * (|u i| * |v j| * |v k| * |u m|) := by
            refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ =>
              Finset.sum_le_sum fun k _ => Finset.sum_le_sum fun m _ => ?_
            rw [abs_mul, abs_mul, abs_mul, abs_mul]
            have h0 : 0 ≤ |u i| * |v j| * |v k| * |u m| := by positivity
            calc |A i j k m| * |u i| * |v j| * |v k| * |u m|
                = |A i j k m| * (|u i| * |v j| * |v k| * |u m|) := by ring
              _ ≤ M * (|u i| * |v j| * |v k| * |u m|) :=
                mul_le_mul_of_nonneg_right (hAM i j k m) h0
        _ = M * (∑ i : Fin 3, |u i|) ^ 2 * (∑ j : Fin 3, |v j|) ^ 2 := by
            simp only [Fin.sum_univ_three]
            ring
    have hsq : ∀ u : E3, (∑ i : Fin 3, |u i|) ^ 2 ≤ 3 * ∑ i : Fin 3, u i ^ 2 := by
      intro u
      simp only [Fin.sum_univ_three]
      have h0 := sq_abs (u 0)
      have h1 := sq_abs (u 1)
      have h2 := sq_abs (u 2)
      nlinarith [sq_nonneg (|u 0| - |u 1|), sq_nonneg (|u 1| - |u 2|),
        sq_nonneg (|u 0| - |u 2|)]
    have hN0 : ∀ u : E3, 0 ≤ ∑ i : Fin 3, u i ^ 2 := fun u =>
      Finset.sum_nonneg fun i _ => sq_nonneg _
    have hcX := hcoerP X
    by_cases ha : (∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * X b) = 0
    · 
      have hNX : ∑ i : Fin 3, X i ^ 2 ≤ 0 := by
        rw [ha] at hcX
        by_contra hcon
        push_neg at hcon
        have := mul_pos hμ hcon
        linarith
      simp only [Fin.sum_univ_three] at hNX
      have e0 : X 0 = 0 := pow_eq_zero_iff two_ne_zero |>.1
        (le_antisymm (by nlinarith [sq_nonneg (X 0), sq_nonneg (X 1), sq_nonneg (X 2)])
          (sq_nonneg _))
      have e1 : X 1 = 0 := pow_eq_zero_iff two_ne_zero |>.1
        (le_antisymm (by nlinarith [sq_nonneg (X 0), sq_nonneg (X 1), sq_nonneg (X 2)])
          (sq_nonneg _))
      have e2 : X 2 = 0 := pow_eq_zero_iff two_ne_zero |>.1
        (le_antisymm (by nlinarith [sq_nonneg (X 0), sq_nonneg (X 1), sq_nonneg (X 2)])
          (sq_nonneg _))
      simp [Fin.sum_univ_three, e0, e1, e2]
    · have hapos : 0 < ∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * X b := by
        have := mul_nonneg hμ.le (hN0 X)
        exact lt_of_le_of_ne (by linarith) (Ne.symm ha)
      set qa := ∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * X b with hqa
      set qb := ∑ a : Fin 3, ∑ b : Fin 3, X a * P a b * Y b with hqb
      set qd := ∑ a : Fin 3, ∑ b : Fin 3, Y a * P a b * Y b with hqd
      have hBexp : ∑ a : Fin 3, ∑ b : Fin 3, (Y - (qb / qa) • X) a * P a b *
          (Y - (qb / qa) • X) b = qd - (qb / qa) * qb
            - (qb / qa) * (∑ a : Fin 3, ∑ b : Fin 3, Y a * P a b * X b)
            + (qb / qa) ^ 2 * qa := by
        simp only [hqa, hqb, hqd, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul,
          Fin.sum_univ_three]
        ring
      have hsym : ∑ a : Fin 3, ∑ b : Fin 3, Y a * P a b * X b = qb := by
        simp only [hqb, Fin.sum_univ_three]
        rw [hP 1 0, hP 2 0, hP 2 1]
        ring
      have hgram : qa * (∑ a : Fin 3, ∑ b : Fin 3, (Y - (qb / qa) • X) a * P a b *
          (Y - (qb / qa) • X) b) = qa * qd - qb ^ 2 := by
        rw [hBexp, hsym]
        field_simp
        ring
      set Y' := Y - (qb / qa) • X with hY'
      set Bp := ∑ a : Fin 3, ∑ b : Fin 3, Y' a * P a b * Y' b with hBp
      have hcY := hcoerP Y'
      have hS := shift (qb / qa)
      rw [← hS]
      have hc := crude X Y'
      have hs1 := hsq X
      have hs2 := hsq Y'
      have hs1n : 0 ≤ (∑ i : Fin 3, |X i|) ^ 2 := sq_nonneg _
      have hs2n : 0 ≤ (∑ i : Fin 3, |Y' i|) ^ 2 := sq_nonneg _
      have hNY := hN0 Y'
      have hNX := hN0 X
      have e1 : μ * (∑ i : Fin 3, |X i|) ^ 2 ≤ 3 * qa := by nlinarith
      have e2 : μ * (∑ i : Fin 3, |Y' i|) ^ 2 ≤ 3 * Bp := by nlinarith
      have e3 : μ ^ 2 * ((∑ i : Fin 3, |X i|) ^ 2 * (∑ i : Fin 3, |Y' i|) ^ 2) ≤
          9 * (qa * Bp) := by
        have := mul_le_mul e1 e2 (by positivity) (by linarith)
        nlinarith
      have e4 : M * (∑ i : Fin 3, |X i|) ^ 2 * (∑ j : Fin 3, |Y' j|) ^ 2 ≤
          9 * M / μ ^ 2 * (qa * Bp) := by
        rw [show 9 * M / μ ^ 2 * (qa * Bp) = M * (9 * (qa * Bp)) / μ ^ 2 by ring,
          le_div_iff₀ (by positivity)]
        nlinarith [mul_le_mul_of_nonneg_left e3 hM0]
      rw [← hgram]
      exact hc.trans e4
  
  refine ⟨9 * M / μ ^ 2, div_nonneg (by linarith) (by positivity), fun y hy X Y => ?_⟩
  have hR1 : ∀ l i j k : Fin 3, riemannLocal G l i j k y = -riemannLocal G l j i k y := by
    intro l i j k
    simp only [riemannLocal, Finset.sum_sub_distrib]
    ring
  have hrearr : ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
      G y m l * riemannLocal G l i j k y * X i * Y j * Y k * X m =
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        (∑ l : Fin 3, G y m l * riemannLocal G l i j k y) * X i * Y j * Y k * X m := by
    simp only [Fin.sum_univ_three]
    ring
  rw [hrearr]
  refine key (G y) (fun i j k m => ∑ l : Fin 3, G y m l * riemannLocal G l i j k y)
    (hGsymm y) (hcoer y hy) ?_ (fun i j k m => hanti y (hBU hy) i j k m)
    (fun i j k m => hM y hy i j k m) X Y
  intro i j k m
  show ∑ l : Fin 3, G y m l * riemannLocal G l i j k y =
    -∑ l : Fin 3, G y m l * riemannLocal G l j i k y
  rw [← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [hR1 l i j k]
  ring

theorem pullback_gauss_upper_bound [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ k : ℝ, 0 ≤ k ∧ ∀ Sig : Set M, IsMinimalSurfaceSet g Sig → ∀ (ρ : ℝ) (F : E2 → E3), ContDiffOn ℝ ∞ F (Metric.ball 0 ρ) → (∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.ball (chartAt E3 z z) (2 * r) ∧ (chartAt E3 z).symm (F x) ∈ Sig ∧ Function.Injective (fderiv ℝ F x)) → ∀ x ∈ Metric.ball (0 : E2) ρ, gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) x ≤ k :=
by
  classical
  
  have hU : IsOpen (chartAt E3 z).target := (chartAt E3 z).open_target
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j)
      (chartAt E3 z).target := fun i j => g.smooth z i j
  have hGsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  have hGpos : ∀ y ∈ (chartAt E3 z).target, (g.coeff (chartAt E3 z).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y hy
  have hB : IsCompact (Metric.closedBall (chartAt E3 z z) (2 * r)) := isCompact_closedBall _ _
  have hBU : Metric.closedBall (chartAt E3 z z) (2 * r) ⊆ (chartAt E3 z).target :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball
  obtain ⟨K₀, hK₀, hamb⟩ := gs_amb_plane_bound _ _ hU hGs hGsymm hGpos _ hB hBU
  refine ⟨K₀, hK₀, ?_⟩
  intro Sig hSig ρ F hF hFx
  have hs : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
  have hFB : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.closedBall (chartAt E3 z z) (2 * r) :=
    fun x hx => Metric.ball_subset_closedBall (hFx x hx).1
  have hFU : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ (chartAt E3 z).target :=
    fun x hx => hBU (hFB x hx)
  have hinj : ∀ x ∈ Metric.ball (0 : E2) ρ, Function.Injective (fderiv ℝ F x) :=
    fun x hx => (hFx x hx).2.2
  obtain ⟨-, hhsymm, hhpos, -, -, -, ha0⟩ :=
    gs_regularity _ _ hU hGs hGsymm hGpos F _ hs hF hFU hinj
  
  have hkey : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ (V : Set M) (f : M → ℝ), IsOpen V →
      (chartAt E3 z).symm (F x) ∈ V → V ⊆ (chartAt E3 z).source →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) →
      V ∩ Sig = V ∩ f ⁻¹' {0} →
        (levelMeanCurvCoord (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y))
            (F x) = 0 ↔ gsMeanCurv (g.coeff (chartAt E3 z).symm) F x = 0) := by
    intro x hx V f hV hpV _hVs hf hdf hVS
    have hpsrc : (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source :=
      (chartAt E3 z).map_target (hFU x hx)
    have hκp : chartAt E3 z ((chartAt E3 z).symm (F x)) = F x :=
      (chartAt E3 z).right_inv (hFU x hx)
    have hcm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 z).symm) (chartAt E3 z).target :=
      hf.comp_contMDiffOn contMDiffOn_chart_symm
    have hcd : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z).target :=
      contMDiffOn_iff_contDiffOn.mp hcm
    have hcda : ContDiffAt ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (F x) :=
      hcd.contDiffAt (hU.mem_nhds (hFU x hx))
    have hf2 : ContDiffAt ℝ 2 (fun y => f ((chartAt E3 z).symm y)) (F x) :=
      hcda.of_le (by norm_cast)
    have hdf' : fderiv ℝ (fun y => f ((chartAt E3 z).symm y)) (F x) ≠ 0 := by
      intro h0
      apply hdf _ hpV
      have h0' : fderiv ℝ (fun y => f ((chartAt E3 z).symm y))
          (chartAt E3 z ((chartAt E3 z).symm (F x))) = 0 := by
        rw [hκp]; exact h0
      have heq : f =ᶠ[𝓝 ((chartAt E3 z).symm (F x))]
          ((fun y => f ((chartAt E3 z).symm y)) ∘ (chartAt E3 z)) := by
        filter_upwards [(chartAt E3 z).open_source.mem_nhds hpsrc] with q hq
        simp only [Function.comp_apply, (chartAt E3 z).left_inv hq]
      have hmem : chartAt E3 z ((chartAt E3 z).symm (F x)) ∈ (chartAt E3 z).target :=
        (chartAt E3 z).map_source hpsrc
      have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y => f ((chartAt E3 z).symm y))
          (chartAt E3 z ((chartAt E3 z).symm (F x))) :=
        (hcm.contMDiffAt (hU.mem_nhds hmem)).mdifferentiableAt (by simp)
      have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z) ((chartAt E3 z).symm (F x)) :=
        mdifferentiableAt_atlas (chart_mem_atlas _ _) hpsrc
      rw [heq.mfderiv_eq, mfderiv_comp _ hd1 hd2, mfderiv_eq_fderiv, h0']
      exact ContinuousLinearMap.zero_comp _
    have hzero : ∀ᶠ y in 𝓝 x, (fun y => f ((chartAt E3 z).symm y)) (F y) = 0 := by
      have hW : (chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V ∈ 𝓝 (F x) :=
        ((chartAt E3 z).isOpen_inter_preimage_symm hV).mem_nhds ⟨hFU x hx, hpV⟩
      have hFc : ContinuousAt F x := hF.continuousOn.continuousAt (hs.mem_nhds hx)
      filter_upwards [hFc.preimage_mem_nhds hW, hs.mem_nhds hx] with y hy hys
      have h1 : (chartAt E3 z).symm (F y) ∈ V ∩ Sig := ⟨hy.2, (hFx y hys).2.1⟩
      rw [hVS] at h1
      exact h1.2
    exact (gs_levelset_param _ F _ _ hs x hx hF (hinj x hx) hGsymm (hGpos _ (hFU x hx)) hf2 hdf'
      hzero).2
  
  have hH : ∀ x ∈ Metric.ball (0 : E2) ρ, gsMeanCurv (g.coeff (chartAt E3 z).symm) F x = 0 := by
    intro x hx
    have hpsrc : (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source :=
      (chartAt E3 z).map_target (hFU x hx)
    obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, hHf, -, -⟩ :=
      hSig.2 _ (hFx x hx).2.1 _ ((chartAt E3 z).open_source.mem_nhds hpsrc)
    have hf0 : f ((chartAt E3 z).symm (F x)) = 0 := by
      have h1 : (chartAt E3 z).symm (F x) ∈ V ∩ Sig := ⟨hpV, (hFx x hx).2.1⟩
      rw [hVS] at h1
      exact h1.2
    have hlmc := hHf _ hpV hf0
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 z).symm.toPartialEquiv
        open_source := (chartAt E3 z).open_target
        open_target := (chartAt E3 z).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hc := levelMeanCurv_eq_coord g Φ f (fun y => f ((chartAt E3 z).symm y)) hf (F x)
      (hFU x hx) (Filter.Eventually.of_forall fun _ => rfl)
    have hΦ : (Φ : E3 → M) (F x) = (chartAt E3 z).symm (F x) := rfl
    rw [hΦ, hlmc] at hc
    exact (hkey x hx V f hVo hpV hVO hf hdf hVS).1 hc.symm
  
  intro x hx
  have hgauss := gs_gauss_equation _ _ hU hGs hGsymm hGpos F _ hs hF hFU hinj x hx
  rw [hH x hx] at hgauss
  have hdetpos : 0 < (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det :=
    (hhpos x hx).det_pos
  have hdet : (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det =
      pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 0 *
        pullMetric2 (g.coeff (chartAt E3 z).symm) F x 1 1 -
      pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 1 ^ 2 := by
    rw [Matrix.det_fin_two, hhsymm x hx 1 0]
    ring
  have hb := hamb (F x) (hFB x hx) (gsTan F 0 x) (gsTan F 1 x)
  change |gsAmbPlane (g.coeff (chartAt E3 z).symm) F x| ≤
      K₀ * (pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 0 *
        pullMetric2 (g.coeff (chartAt E3 z).symm) F x 1 1 -
      pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 1 ^ 2) at hb
  rw [← hdet] at hb
  have hA : |gsAmbPlane (g.coeff (chartAt E3 z).symm) F x /
      (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det| ≤ K₀ := by
    rw [abs_div, abs_of_pos hdetpos, div_le_iff₀ hdetpos]
    exact hb
  obtain ⟨-, hA2⟩ := abs_le.mp hA
  have hax := ha0 x hx
  rw [hgauss]
  linarith

theorem normal_form_center_eq_one (ρ : ℝ) (hρ : 0 < ρ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) : h 0 = 1 :=
by
  ext i j
  have hcont : ContinuousAt (fun x => h x i j) (0 : E2) :=
    ((hs i j).continuousOn).continuousAt
      (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ))
  set v : E2 := EuclideanSpace.single j (1 : ℝ) with hv
  have hpath : Filter.Tendsto (fun t : ℝ => t • v) (nhdsWithin (0 : ℝ) (Set.Ioi 0))
      (nhds (0 : E2)) := by
    have h0 : Filter.Tendsto (fun t : ℝ => t • v) (nhds (0 : ℝ)) (nhds ((0 : ℝ) • v)) :=
      (continuous_id.smul continuous_const).tendsto 0
    rw [zero_smul] at h0
    exact h0.mono_left nhdsWithin_le_nhds
  have hlim := hcont.tendsto.comp hpath
  have hev : ∀ᶠ t in nhdsWithin (0 : ℝ) (Set.Ioi 0),
      (1 : Matrix (Fin 2) (Fin 2) ℝ) i j = ((fun x => h x i j) ∘ (fun t : ℝ => t • v)) t := by
    have hIoo : Set.Ioo (0 : ℝ) ρ ∈ nhdsWithin (0 : ℝ) (Set.Ioi 0) := Ioo_mem_nhdsGT hρ
    filter_upwards [hIoo] with t ht
    have hmem : t • v ∈ Metric.ball (0 : E2) ρ := by
      rw [mem_ball_zero_iff, norm_smul, hv, EuclideanSpace.norm_single, norm_one, mul_one,
        Real.norm_eq_abs, abs_of_pos ht.1]
      exact ht.2
    have h1 := hnf _ hmem i
    have h2 : ∑ k : Fin 2, h (t • v) i k * (t • v) k = h (t • v) i j * t := by
      rw [Finset.sum_eq_single j]
      · simp [hv]
      · intro b _ hb
        simp [hv, hb]
      · simp
    have h3 : (t • v) i = t * (1 : Matrix (Fin 2) (Fin 2) ℝ) i j := by
      simp [hv, Matrix.one_apply, EuclideanSpace.single_apply]
    rw [h2, h3] at h1
    have ht0 : t ≠ 0 := ht.1.ne'
    show (1 : Matrix (Fin 2) (Fin 2) ℝ) i j = h (t • v) i j
    exact (mul_right_cancel₀ ht0 (by rw [h1, mul_comm])).symm
  exact tendsto_nhds_unique hlim (tendsto_const_nhds.congr' hev)

theorem posDef_two_iff (H : Matrix (Fin 2) (Fin 2) ℝ) (hsym : H 0 1 = H 1 0) : H.PosDef ↔ 0 < H 0 0 ∧ 0 < H.det :=
by
  constructor
  · intro hH
    exact ⟨hH.diag_pos (i := 0), hH.det_pos⟩
  · rintro ⟨ha, hdet⟩
    rw [Matrix.det_fin_two] at hdet
    refine Matrix.PosDef.of_dotProduct_mulVec_pos ?_ ?_
    · refine Matrix.IsHermitian.ext ?_
      intro i j
      fin_cases i <;> fin_cases j <;> simp [hsym]
    · intro x hx
      have hx' : x 0 ≠ 0 ∨ x 1 ≠ 0 := by
        by_contra hc
        push_neg at hc
        apply hx
        funext i
        fin_cases i
        · simpa using hc.1
        · simpa using hc.2
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial]
      rw [← hsym] at hdet ⊢
      have key : H 0 0 * (x 0 * (H 0 0 * x 0 + H 0 1 * x 1) + x 1 * (H 0 1 * x 0 + H 1 1 * x 1))
          = (H 0 0 * x 0 + H 0 1 * x 1) ^ 2 + (H 0 0 * H 1 1 - H 0 1 * H 0 1) * x 1 ^ 2 := by
        ring
      by_contra hQ
      push_neg at hQ
      have h1 := mul_nonpos_of_nonneg_of_nonpos ha.le hQ
      rcases hx' with h0 | h1'
      · by_cases hx1 : x 1 = 0
        · rw [hx1] at key h1
          have : 0 < (H 0 0 * x 0) ^ 2 := by
            have : H 0 0 * x 0 ≠ 0 := mul_ne_zero ha.ne' h0
            positivity
          nlinarith
        · have : 0 < (H 0 0 * H 1 1 - H 0 1 * H 0 1) * x 1 ^ 2 := by
            have : 0 < x 1 ^ 2 := by positivity
            exact mul_pos hdet this
          nlinarith [sq_nonneg (H 0 0 * x 0 + H 0 1 * x 1)]
      · have : 0 < (H 0 0 * H 1 1 - H 0 1 * H 0 1) * x 1 ^ 2 := by
          have : 0 < x 1 ^ 2 := by positivity
          exact mul_pos hdet this
        nlinarith [sq_nonneg (H 0 0 * x 0 + H 0 1 * x 1)]

theorem normal_form_posDef_iff (H : Matrix (Fin 2) (Fin 2) ℝ) (hsym : H 0 1 = H 1 0) (x : E2) (hx : x ≠ 0) (hnf : ∀ i : Fin 2, ∑ j : Fin 2, H i j * x j = x i) : H.PosDef ↔ 0 < H 0 0 * x 1 ^ 2 - 2 * H 0 1 * x 0 * x 1 + H 1 1 * x 0 ^ 2 :=
by
  have h0 : H 0 0 * x 0 + H 0 1 * x 1 = x 0 := by
    have h := hnf 0
    rw [Fin.sum_univ_two] at h
    exact h
  have h1 : H 0 1 * x 0 + H 1 1 * x 1 = x 1 := by
    have h := hnf 1
    rw [Fin.sum_univ_two] at h
    rw [hsym]
    exact h
  have hx' : x 0 ≠ 0 ∨ x 1 ≠ 0 := by
    by_contra hc
    push_neg at hc
    apply hx
    ext i
    fin_cases i <;> simp [hc.1, hc.2]
  have hn : 0 < x 0 ^ 2 + x 1 ^ 2 := by
    rcases hx' with h | h
    · nlinarith [sq_pos_of_ne_zero h, sq_nonneg (x 1)]
    · nlinarith [sq_pos_of_ne_zero h, sq_nonneg (x 0)]
  have hquad : ∀ v : Fin 2 → ℝ, dotProduct (star v) (H.mulVec v) =
      v 0 * (H 0 0 * v 0 + H 0 1 * v 1) + v 1 * (H 1 0 * v 0 + H 1 1 * v 1) := by
    intro v
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
  have hherm : H.IsHermitian := by
    apply Matrix.IsHermitian.ext
    intro i j
    fin_cases i <;> fin_cases j <;> simp [hsym]
  have key : ∀ n Q m α β : ℝ, 0 < n → 0 < Q → 0 < m → α ^ 2 + β ^ 2 = n * m →
      0 < n * α ^ 2 + Q * β ^ 2 := by
    intro n Q m α β hn hQ hm hab
    rcases eq_or_ne α 0 with ha | ha
    · subst ha
      have hb : 0 < β ^ 2 := by nlinarith [mul_pos hn hm]
      nlinarith [mul_pos hQ hb]
    · have ha2 : 0 < α ^ 2 := by positivity
      nlinarith [mul_pos hn ha2, mul_nonneg hQ.le (sq_nonneg β)]
  constructor
  · intro hP
    have hv : (![x 1, -x 0] : Fin 2 → ℝ) ≠ 0 := by
      intro h
      have e0 := congrFun h 0
      have e1 := congrFun h 1
      simp at e0 e1
      rcases hx' with h' | h'
      · exact h' e1
      · exact h' e0
    have hpos := hP.dotProduct_mulVec_pos hv
    rw [hquad] at hpos
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hpos
    rw [← hsym] at hpos
    linarith
  · intro hQ
    refine Matrix.PosDef.of_dotProduct_mulVec_pos hherm ?_
    intro v hv
    rw [hquad, ← hsym]
    have hv' : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
      by_contra hc
      push_neg at hc
      apply hv
      funext i
      fin_cases i <;> simp [hc.1, hc.2]
    have hm : 0 < v 0 ^ 2 + v 1 ^ 2 := by
      rcases hv' with h | h
      · nlinarith [sq_pos_of_ne_zero h, sq_nonneg (v 1)]
      · nlinarith [sq_pos_of_ne_zero h, sq_nonneg (v 0)]
    have hid : (x 0 ^ 2 + x 1 ^ 2) ^ 2 *
        (v 0 * (H 0 0 * v 0 + H 0 1 * v 1) + v 1 * (H 0 1 * v 0 + H 1 1 * v 1)) =
        (x 0 ^ 2 + x 1 ^ 2) * (v 0 * x 0 + v 1 * x 1) ^ 2 +
          (H 0 0 * x 1 ^ 2 - 2 * H 0 1 * x 0 * x 1 + H 1 1 * x 0 ^ 2) *
            (v 0 * x 1 - v 1 * x 0) ^ 2 := by
      linear_combination
        ((v 0 * x 0 + v 1 * x 1) ^ 2 * x 0 +
          2 * (v 0 * x 0 + v 1 * x 1) * (v 0 * x 1 - v 1 * x 0) * x 1) * h0 +
        ((v 0 * x 0 + v 1 * x 1) ^ 2 * x 1 -
          2 * (v 0 * x 0 + v 1 * x 1) * (v 0 * x 1 - v 1 * x 0) * x 0) * h1
    have hlag : (v 0 * x 0 + v 1 * x 1) ^ 2 + (v 0 * x 1 - v 1 * x 0) ^ 2 =
        (x 0 ^ 2 + x 1 ^ 2) * (v 0 ^ 2 + v 1 ^ 2) := by ring
    have hpos := key _ _ _ _ _ hn hQ hm hlag
    rw [← hid] at hpos
    by_contra hF
    push_neg at hF
    have hn2 : 0 ≤ (x 0 ^ 2 + x 1 ^ 2) ^ 2 := by positivity
    nlinarith [mul_nonpos_iff.mpr (Or.inl ⟨hn2, hF⟩)]

theorem gaussCurv2_orthogonal_comp (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (L : E2 →L[ℝ] E2) (A : Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ i j : Fin 2, L (e2 j) i = A i j) (hAA : A.transpose * A = 1) (U : Set E2) (hU : IsOpen U) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) U) (hdet : ∀ x ∈ U, (h x).det ≠ 0) (y₀ : E2) (hy₀ : L y₀ ∈ U) : gaussCurv2 (fun y => A.transpose * h (L y) * A) y₀ = gaussCurv2 h (L y₀) :=
by
  
  have hAA' : A * A.transpose = 1 := mul_eq_one_comm.mp hAA
  have e00 : A 0 0 * A 0 0 + A 0 1 * A 0 1 = 1 := by
    have h1 := congrFun (congrFun hAA' 0) 0
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h1
    linear_combination h1
  have e01 : A 0 0 * A 1 0 + A 0 1 * A 1 1 = 0 := by
    have h1 := congrFun (congrFun hAA' 0) 1
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h1
    linear_combination h1
  have e11 : A 1 0 * A 1 0 + A 1 1 * A 1 1 = 1 := by
    have h1 := congrFun (congrFun hAA' 1) 1
    simp [Matrix.mul_apply, Fin.sum_univ_two] at h1
    linear_combination h1
  have hstar : ∀ E : Fin 2 → Fin 2 → ℝ,
      ∑ l : Fin 2, ∑ q : Fin 2, ∑ d : Fin 2, A q l * A d l * E q d = ∑ q : Fin 2, E q q := by
    intro E
    simp only [Fin.sum_univ_two]
    linear_combination E 0 0 * e00 + (E 0 1 + E 1 0) * e01 + E 1 1 * e11
  
  have hinv : ∀ M : Matrix (Fin 2) (Fin 2) ℝ, (A.transpose * M * A)⁻¹ = A.transpose * M⁻¹ * A := by
    intro M
    rw [Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.inv_eq_left_inv hAA,
      Matrix.inv_eq_left_inv hAA', Matrix.mul_assoc]
  
  have s4 : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (dH dHt : Fin 2 → Fin 2 → Fin 2 → ℝ),
      (∀ c i j : Fin 2, dHt c i j =
        ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * ∑ d : Fin 2, A d c * dH d a b) →
      ∀ k i j : Fin 2, (1 / 2 : ℝ) * ∑ l : Fin 2, (A.transpose * H * A) k l *
          (dHt i j l + dHt j i l - dHt l i j) =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, A p k * A a i * A b j *
          ((1 / 2 : ℝ) * ∑ l : Fin 2, H p l * (dH a b l + dH b a l - dH l a b)) := by
    intro H dH dHt hd k i j
    have hM : ∀ l : Fin 2, (A.transpose * H * A) k l =
        ∑ p : Fin 2, ∑ q : Fin 2, A p k * H p q * A q l := by
      intro l; simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two]; ring
    calc (1 / 2 : ℝ) * ∑ l : Fin 2, (A.transpose * H * A) k l *
          (dHt i j l + dHt j i l - dHt l i j)
        = (1 / 2 : ℝ) * ∑ l : Fin 2, ∑ q : Fin 2, ∑ d : Fin 2, A q l * A d l *
            (∑ p : Fin 2, A p k * H p q * ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j *
              (dH a b d + dH b a d - dH d a b)) := by
          simp only [hM, hd, Fin.sum_univ_two]; ring
      _ = (1 / 2 : ℝ) * ∑ q : Fin 2, (∑ p : Fin 2, A p k * H p q * ∑ a : Fin 2, ∑ b : Fin 2,
            A a i * A b j * (dH a b q + dH b a q - dH q a b)) := by
          rw [hstar (fun q d => ∑ p : Fin 2, A p k * H p q * ∑ a : Fin 2, ∑ b : Fin 2,
            A a i * A b j * (dH a b d + dH b a d - dH d a b))]
      _ = _ := by simp only [Fin.sum_univ_two]; ring
  
  have s5 : ∀ (G Gt : Fin 2 → Fin 2 → Fin 2 → ℝ) (D Dt : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ),
      (∀ k i j : Fin 2, Gt k i j =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, A p k * A a i * A b j * G p a b) →
      (∀ c k i j : Fin 2, Dt c k i j = ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
        A p k * A a i * A b j * ∑ d : Fin 2, A d c * D d p a b) →
      ∀ j k : Fin 2,
      (∑ i : Fin 2, (Dt i i j k - Dt j i i k) +
        ∑ i : Fin 2, ∑ p : Fin 2, (Gt i i p * Gt p j k - Gt i j p * Gt p i k)) =
        ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * (∑ i : Fin 2, (D i i a b - D a i i b) +
          ∑ i : Fin 2, ∑ p : Fin 2, (G i i p * G p a b - G i a p * G p i b)) := by
    intro G Gt D Dt hG hD j k
    have hD1 : ∑ i : Fin 2, Dt i i j k =
        ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * ∑ i : Fin 2, D i i a b := by
      calc ∑ i : Fin 2, Dt i i j k
          = ∑ i : Fin 2, ∑ p : Fin 2, ∑ d : Fin 2, A p i * A d i *
              (∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * D d p a b) := by
            simp only [hD, Fin.sum_univ_two]; ring
        _ = ∑ p : Fin 2, (∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * D p p a b) :=
            hstar (fun p d => ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * D d p a b)
        _ = _ := by simp only [Fin.sum_univ_two]; ring
    have hD2 : ∑ i : Fin 2, Dt j i i k =
        ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * ∑ i : Fin 2, D a i i b := by
      calc ∑ i : Fin 2, Dt j i i k
          = ∑ i : Fin 2, ∑ p : Fin 2, ∑ a : Fin 2, A p i * A a i *
              (∑ b : Fin 2, ∑ d : Fin 2, A b k * A d j * D d p a b) := by
            simp only [hD, Fin.sum_univ_two]; ring
        _ = ∑ p : Fin 2, (∑ b : Fin 2, ∑ d : Fin 2, A b k * A d j * D d p p b) :=
            hstar (fun p a => ∑ b : Fin 2, ∑ d : Fin 2, A b k * A d j * D d p a b)
        _ = _ := by simp only [Fin.sum_univ_two]; ring
    have hQ1 : ∑ i : Fin 2, ∑ p : Fin 2, Gt i i p * Gt p j k =
        ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * ∑ i : Fin 2, ∑ p : Fin 2, G i i p * G p a b := by
      calc ∑ i : Fin 2, ∑ p : Fin 2, Gt i i p * Gt p j k
          = ∑ i : Fin 2, ∑ q : Fin 2, ∑ a : Fin 2, A q i * A a i *
              (∑ p : Fin 2, ∑ b : Fin 2, A b p * G q a b * Gt p j k) := by
            simp only [hG, Fin.sum_univ_two]; ring
        _ = ∑ q : Fin 2, (∑ p : Fin 2, ∑ b : Fin 2, A b p * G q q b * Gt p j k) :=
            hstar (fun q a => ∑ p : Fin 2, ∑ b : Fin 2, A b p * G q a b * Gt p j k)
        _ = ∑ p : Fin 2, ∑ b : Fin 2, ∑ r : Fin 2, A b p * A r p *
              ((∑ q : Fin 2, G q q b) * ∑ a : Fin 2, ∑ c : Fin 2, A a j * A c k * G r a c) := by
            simp only [hG, Fin.sum_univ_two]; ring
        _ = ∑ b : Fin 2, ((∑ q : Fin 2, G q q b) *
              ∑ a : Fin 2, ∑ c : Fin 2, A a j * A c k * G b a c) :=
            hstar (fun b r => (∑ q : Fin 2, G q q b) *
              ∑ a : Fin 2, ∑ c : Fin 2, A a j * A c k * G r a c)
        _ = _ := by simp only [Fin.sum_univ_two]; ring
    have hQ2 : ∑ i : Fin 2, ∑ p : Fin 2, Gt i j p * Gt p i k =
        ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * ∑ i : Fin 2, ∑ p : Fin 2, G i a p * G p i b := by
      calc ∑ i : Fin 2, ∑ p : Fin 2, Gt i j p * Gt p i k
          = ∑ i : Fin 2, ∑ q : Fin 2, ∑ s : Fin 2, A q i * A s i *
              (∑ p : Fin 2, (∑ a : Fin 2, ∑ b : Fin 2, A a j * A b p * G q a b) *
                (∑ r : Fin 2, ∑ c : Fin 2, A r p * A c k * G r s c)) := by
            simp only [hG, Fin.sum_univ_two]; ring
        _ = ∑ q : Fin 2, (∑ p : Fin 2, (∑ a : Fin 2, ∑ b : Fin 2, A a j * A b p * G q a b) *
                (∑ r : Fin 2, ∑ c : Fin 2, A r p * A c k * G r q c)) :=
            hstar (fun q s => ∑ p : Fin 2, (∑ a : Fin 2, ∑ b : Fin 2, A a j * A b p * G q a b) *
                (∑ r : Fin 2, ∑ c : Fin 2, A r p * A c k * G r s c))
        _ = ∑ p : Fin 2, ∑ b : Fin 2, ∑ r : Fin 2, A b p * A r p *
              (∑ q : Fin 2, (∑ a : Fin 2, A a j * G q a b) * (∑ c : Fin 2, A c k * G r q c)) := by
            simp only [Fin.sum_univ_two]; ring
        _ = ∑ b : Fin 2, (∑ q : Fin 2, (∑ a : Fin 2, A a j * G q a b) *
              (∑ c : Fin 2, A c k * G b q c)) :=
            hstar (fun b r => ∑ q : Fin 2, (∑ a : Fin 2, A a j * G q a b) *
              (∑ c : Fin 2, A c k * G r q c))
        _ = _ := by simp only [Fin.sum_univ_two]; ring
    have split : (∑ i : Fin 2, (Dt i i j k - Dt j i i k) +
        ∑ i : Fin 2, ∑ p : Fin 2, (Gt i i p * Gt p j k - Gt i j p * Gt p i k)) =
        (∑ i : Fin 2, Dt i i j k - ∑ i : Fin 2, Dt j i i k) +
        (∑ i : Fin 2, ∑ p : Fin 2, Gt i i p * Gt p j k -
          ∑ i : Fin 2, ∑ p : Fin 2, Gt i j p * Gt p i k) := by
      simp only [Fin.sum_univ_two]; ring
    rw [split, hD1, hD2, hQ1, hQ2]
    simp only [Fin.sum_univ_two]; ring
  
  have s6 : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (Rm Rt : Fin 2 → Fin 2 → ℝ),
      (∀ j k : Fin 2, Rt j k = ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * Rm a b) →
      (1 / 2 : ℝ) * ∑ j : Fin 2, ∑ k : Fin 2, (A.transpose * H * A) j k * Rt j k =
        (1 / 2 : ℝ) * ∑ j : Fin 2, ∑ k : Fin 2, H j k * Rm j k := by
    intro H Rm Rt hR
    have hM : ∀ j k : Fin 2, (A.transpose * H * A) j k =
        ∑ p : Fin 2, ∑ q : Fin 2, A p j * H p q * A q k := by
      intro j k; simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two]; ring
    congr 1
    calc ∑ j : Fin 2, ∑ k : Fin 2, (A.transpose * H * A) j k * Rt j k
        = ∑ j : Fin 2, ∑ p : Fin 2, ∑ a : Fin 2, A p j * A a j *
            (∑ k : Fin 2, ∑ q : Fin 2, ∑ b : Fin 2, A q k * A b k * (H p q * Rm a b)) := by
          simp only [hM, hR, Fin.sum_univ_two]; ring
      _ = ∑ p : Fin 2, (∑ k : Fin 2, ∑ q : Fin 2, ∑ b : Fin 2, A q k * A b k * (H p q * Rm p b)) :=
          hstar (fun p a => ∑ k : Fin 2, ∑ q : Fin 2, ∑ b : Fin 2, A q k * A b k * (H p q * Rm a b))
      _ = ∑ k : Fin 2, ∑ q : Fin 2, ∑ b : Fin 2, A q k * A b k * (∑ p : Fin 2, H p q * Rm p b) := by
          simp only [Fin.sum_univ_two]; ring
      _ = ∑ q : Fin 2, ∑ p : Fin 2, H p q * Rm p q := hstar (fun q b => ∑ p : Fin 2, H p q * Rm p b)
      _ = ∑ j : Fin 2, ∑ k : Fin 2, H j k * Rm j k := by simp only [Fin.sum_univ_two]; ring
  
  have hLe : ∀ c : Fin 2, L (e2 c) = ∑ d : Fin 2, A d c • e2 d := by
    intro c
    ext m
    rw [hA]
    fin_cases m <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply]
  have hchain : ∀ (φ : E2 → ℝ) (y : E2), DifferentiableAt ℝ φ (L y) → ∀ c : Fin 2,
      pd2 c (fun z => φ (L z)) y = ∑ d : Fin 2, A d c * pd2 d φ (L y) := by
    intro φ y hφ c
    have h1 : HasFDerivAt (fun z => φ (L z)) ((fderiv ℝ φ (L y)).comp L) y :=
      hφ.hasFDerivAt.comp y L.hasFDerivAt
    simp only [pd2, h1.fderiv, ContinuousLinearMap.comp_apply, hLe, map_sum, map_smul, smul_eq_mul]
  have hd2 : ∀ (w : Fin 2 → Fin 2 → ℝ) (φ : Fin 2 → Fin 2 → E2 → ℝ) (x : E2),
      (∀ a b, DifferentiableAt ℝ (φ a b) x) →
      DifferentiableAt ℝ (fun z => ∑ a : Fin 2, ∑ b : Fin 2, w a b * φ a b z) x ∧
      ∀ c : Fin 2, pd2 c (fun z => ∑ a : Fin 2, ∑ b : Fin 2, w a b * φ a b z) x =
        ∑ a : Fin 2, ∑ b : Fin 2, w a b * pd2 c (φ a b) x := by
    intro w φ x hφ
    have H : HasFDerivAt (fun z => ∑ a : Fin 2, ∑ b : Fin 2, w a b * φ a b z)
        (∑ a : Fin 2, ∑ b : Fin 2, w a b • fderiv ℝ (φ a b) x) x := by
      apply HasFDerivAt.fun_sum; intro a _
      apply HasFDerivAt.fun_sum; intro b _
      exact (hφ a b).hasFDerivAt.const_mul (w a b)
    refine ⟨H.differentiableAt, fun c => ?_⟩
    simp only [pd2, H.fderiv, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
  have hd3 : ∀ (w : Fin 2 → Fin 2 → Fin 2 → ℝ) (φ : Fin 2 → Fin 2 → Fin 2 → E2 → ℝ) (x : E2),
      (∀ p a b, DifferentiableAt ℝ (φ p a b) x) →
      DifferentiableAt ℝ (fun z => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, w p a b * φ p a b z) x ∧
      ∀ c : Fin 2, pd2 c (fun z => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, w p a b * φ p a b z) x =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, w p a b * pd2 c (φ p a b) x := by
    intro w φ x hφ
    have H : HasFDerivAt (fun z => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, w p a b * φ p a b z)
        (∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, w p a b • fderiv ℝ (φ p a b) x) x := by
      apply HasFDerivAt.fun_sum; intro p _
      apply HasFDerivAt.fun_sum; intro a _
      apply HasFDerivAt.fun_sum; intro b _
      exact (hφ p a b).hasFDerivAt.const_mul (w p a b)
    refine ⟨H.differentiableAt, fun c => ?_⟩
    simp only [pd2, H.fderiv, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
  have hdiff : ∀ x ∈ U, ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x :=
    fun x hx a b => ((hs a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)
  have hpdiff : ∀ x ∈ U, ∀ i a b : Fin 2, DifferentiableAt ℝ (pd2 i (fun z => h z a b)) x := by
    intro x hx i a b
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => h z a b) y) U :=
      (hs a b).fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => h z a b) y (e2 i)) U :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)
  have hinvdiff : ∀ x ∈ U, ∀ k l : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ k l) x := by
    intro x hx k l
    have e : (fun z => (h z)⁻¹ k l) = fun z =>
        (h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0)⁻¹ * (h z).adjugate k l := by
      funext z
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv', Matrix.det_fin_two]
    have hD : DifferentiableAt ℝ (fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0) x :=
      ((hdiff x hx 0 0).mul (hdiff x hx 1 1)).sub ((hdiff x hx 0 1).mul (hdiff x hx 1 0))
    have hne : h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 ≠ 0 := by
      have := hdet x hx
      rwa [Matrix.det_fin_two] at this
    rw [e]
    refine (hD.fun_inv hne).mul ?_
    fin_cases k <;> fin_cases l <;> simp [Matrix.adjugate_fin_two, hdiff x hx]
  have hΓdiff : ∀ x ∈ U, ∀ k i j : Fin 2, DifferentiableAt ℝ (christoffel2 h k i j) x := by
    intro x hx k i j
    have e : christoffel2 h k i j = fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
        (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x) := by
      funext x; rfl
    rw [e]
    refine DifferentiableAt.const_mul ?_ _
    simp only [Fin.sum_univ_two]
    refine DifferentiableAt.add ?_ ?_ <;>
    exact (hinvdiff x hx _ _).mul
      (((hpdiff x hx _ _ _).add (hpdiff x hx _ _ _)).sub (hpdiff x hx _ _ _))
  have hconj : ∀ y : E2, L y ∈ U → ∀ c i j : Fin 2,
      pd2 c (fun z => (A.transpose * h (L z) * A) i j) y =
        ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j *
          ∑ d : Fin 2, A d c * pd2 d (fun x => h x a b) (L y) := by
    intro y hy c i j
    obtain ⟨hD, hP⟩ := hd2 (fun a b => A a i * A b j) (fun a b x => h x a b) (L y)
      (fun a b => hdiff (L y) hy a b)
    have hP' : ∀ d : Fin 2,
        pd2 d (fun x => ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * h x a b) (L y) =
          ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * pd2 d (fun x => h x a b) (L y) :=
      fun d => hP d
    calc pd2 c (fun z => (A.transpose * h (L z) * A) i j) y
        = pd2 c (fun z => (fun x => ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * h x a b) (L z)) y := by
          congr 1; funext z
          simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two]; ring
      _ = ∑ d : Fin 2, A d c *
            pd2 d (fun x => ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * h x a b) (L y) :=
          hchain (fun x => ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * h x a b) y hD c
      _ = ∑ d : Fin 2, A d c *
            ∑ a : Fin 2, ∑ b : Fin 2, A a i * A b j * pd2 d (fun x => h x a b) (L y) := by
          simp only [hP']
      _ = _ := by simp only [Fin.sum_univ_two]; ring
  have hΓ : ∀ y : E2, L y ∈ U → ∀ k i j : Fin 2,
      christoffel2 (fun y => A.transpose * h (L y) * A) k i j y =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, A p k * A a i * A b j * christoffel2 h p a b (L y) := by
    intro y hy k i j
    have key := s4 (h (L y))⁻¹ (fun d a b => pd2 d (fun x => h x a b) (L y))
      (fun c a b => pd2 c (fun z => (A.transpose * h (L z) * A) a b) y)
      (fun c a b => hconj y hy c a b) k i j
    simp only [christoffel2, hinv]
    exact key
  have hV : IsOpen (L ⁻¹' U) := hU.preimage L.continuous
  have hDΓ : ∀ c k i j : Fin 2,
      pd2 c (christoffel2 (fun y => A.transpose * h (L y) * A) k i j) y₀ =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, A p k * A a i * A b j *
          ∑ d : Fin 2, A d c * pd2 d (christoffel2 h p a b) (L y₀) := by
    intro c k i j
    have hev : christoffel2 (fun y => A.transpose * h (L y) * A) k i j =ᶠ[𝓝 y₀]
        fun y => (fun x => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
          A p k * A a i * A b j * christoffel2 h p a b x) (L y) :=
      Filter.eventually_of_mem (hV.mem_nhds hy₀) (fun y hy => hΓ y hy k i j)
    obtain ⟨hD, hP⟩ := hd3 (fun p a b => A p k * A a i * A b j) (christoffel2 h) (L y₀)
      (fun p a b => hΓdiff (L y₀) hy₀ p a b)
    have hP' : ∀ d : Fin 2, pd2 d (fun x => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
          A p k * A a i * A b j * christoffel2 h p a b x) (L y₀) =
        ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
          A p k * A a i * A b j * pd2 d (christoffel2 h p a b) (L y₀) :=
      fun d => hP d
    calc pd2 c (christoffel2 (fun y => A.transpose * h (L y) * A) k i j) y₀
        = pd2 c (fun y => (fun x => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
            A p k * A a i * A b j * christoffel2 h p a b x) (L y)) y₀ := by
          unfold pd2; rw [hev.fderiv_eq]
      _ = ∑ d : Fin 2, A d c * pd2 d (fun x => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
            A p k * A a i * A b j * christoffel2 h p a b x) (L y₀) :=
          hchain (fun x => ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
            A p k * A a i * A b j * christoffel2 h p a b x) y₀ hD c
      _ = ∑ d : Fin 2, A d c * ∑ p : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
            A p k * A a i * A b j * pd2 d (christoffel2 h p a b) (L y₀) := by
          simp only [hP']
      _ = _ := by simp only [Fin.sum_univ_two]; ring
  have hRic : ∀ j k : Fin 2, ricci2 (fun y => A.transpose * h (L y) * A) j k y₀ =
      ∑ a : Fin 2, ∑ b : Fin 2, A a j * A b k * ricci2 h a b (L y₀) := by
    intro j k
    have key := s5 (fun p a b => christoffel2 h p a b (L y₀))
      (fun k i j => christoffel2 (fun y => A.transpose * h (L y) * A) k i j y₀)
      (fun d p a b => pd2 d (christoffel2 h p a b) (L y₀))
      (fun c k i j => pd2 c (christoffel2 (fun y => A.transpose * h (L y) * A) k i j) y₀)
      (fun k i j => hΓ y₀ hy₀ k i j) hDΓ j k
    simp only [ricci2]
    exact key
  have key := s6 (h (L y₀))⁻¹ (fun a b => ricci2 h a b (L y₀))
    (fun j k => ricci2 (fun y => A.transpose * h (L y) * A) j k y₀) hRic
  simp only [gaussCurv2, hinv]
  exact key

theorem ball_subset_of_closedBall_step (ρ : ℝ) (hρ : 0 < ρ) (P : Set E2) (hP : IsOpen P) (h0 : (0 : E2) ∈ P) (hstep : ∀ S : ℝ, 0 < S → S < ρ → Metric.ball (0 : E2) S ⊆ P → Metric.closedBall (0 : E2) S ⊆ P) : Metric.ball (0 : E2) ρ ⊆ P :=
by
  intro x hx
  by_contra hxP
  have hT : IsClosed Pᶜ := hP.isClosed_compl
  have hne : (Pᶜ).Nonempty := ⟨x, hxP⟩
  have h0T : (0 : E2) ∉ Pᶜ := fun h => h h0
  have hSpos : 0 < Metric.infDist (0 : E2) Pᶜ := (hT.notMem_iff_infDist_pos hne).1 h0T
  have hSle : Metric.infDist (0 : E2) Pᶜ ≤ dist (0 : E2) x := Metric.infDist_le_dist_of_mem hxP
  have hxρ : dist (0 : E2) x < ρ := by
    rw [dist_comm]; exact Metric.mem_ball.1 hx
  have hball : Metric.ball (0 : E2) (Metric.infDist (0 : E2) Pᶜ) ⊆ P := by
    intro y hy
    have hy' : dist (0 : E2) y < Metric.infDist (0 : E2) Pᶜ := by
      rw [dist_comm]; exact Metric.mem_ball.1 hy
    have := Metric.notMem_of_dist_lt_infDist hy'
    simpa using this
  have hcl := hstep _ hSpos (lt_of_le_of_lt hSle hxρ) hball
  obtain ⟨y, hyT, hyd⟩ := hT.exists_infDist_eq_dist hne (0 : E2)
  have hyc : y ∈ Metric.closedBall (0 : E2) (Metric.infDist (0 : E2) Pᶜ) := by
    rw [Metric.mem_closedBall, dist_comm, hyd]
  exact hyT (hcl hyc)

theorem normal_form_axis_curvature (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hsymm : ∀ (x : E2) (i j : Fin 2), h x i j = h x j i) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (t : ℝ) (ht : 0 < t) (U : Set E2) (hU : IsOpen U) (hUρ : U ⊆ Metric.ball 0 ρ) (htU : t • e2 0 ∈ U) (hdet : ∀ x ∈ U, (h x).det ≠ 0) (q : ℝ → ℝ) (hq : ∀ τ : ℝ, q τ = h (τ • e2 0) 1 1) : 4 * t * q t ^ 2 * gaussCurv2 h (t • e2 0) = t * deriv q t ^ 2 - 2 * t * q t * deriv (deriv q) t - 4 * q t * deriv q t :=
by
  have ht0 : t ≠ 0 := ht.ne'
  
  have hsU : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) U := fun i j => (hs i j).mono hUρ
  have hdiff : ∀ x ∈ U, ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x :=
    fun x hx a b => ((hsU a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)
  have hpdiff : ∀ x ∈ U, ∀ i a b : Fin 2, DifferentiableAt ℝ (pd2 i (fun z => h z a b)) x := by
    intro x hx i a b
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => h z a b) y) U :=
      (hsU a b).fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => h z a b) y (e2 i)) U :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)
  have hinvE : ∀ (z : E2) (k l : Fin 2), (h z)⁻¹ k l =
      (h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0)⁻¹ * (h z).adjugate k l := by
    intro z k l
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv', Matrix.det_fin_two]
  have hinvdiff : ∀ x ∈ U, ∀ k l : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ k l) x := by
    intro x hx k l
    have e : (fun z => (h z)⁻¹ k l) = fun z =>
        (h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0)⁻¹ * (h z).adjugate k l := by
      funext z
      exact hinvE z k l
    have hD : DifferentiableAt ℝ (fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0) x :=
      ((hdiff x hx 0 0).mul (hdiff x hx 1 1)).sub ((hdiff x hx 0 1).mul (hdiff x hx 1 0))
    have hne : h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 ≠ 0 := by
      have := hdet x hx
      rwa [Matrix.det_fin_two] at this
    rw [e]
    refine (hD.fun_inv hne).mul ?_
    fin_cases k <;> fin_cases l <;> simp [Matrix.adjugate_fin_two, hdiff x hx]
  
  have hcoord : ∀ (j : Fin 2) (y : E2),
      HasFDerivAt (fun z : E2 => z j) (EuclideanSpace.proj j : E2 →L[ℝ] ℝ) y :=
    fun j y => (EuclideanSpace.proj j : E2 →L[ℝ] ℝ).hasFDerivAt
  have hpc : ∀ (m j : Fin 2) (y : E2), pd2 m (fun z : E2 => z j) y = if m = j then 1 else 0 := by
    intro m j y
    simp only [pd2, (hcoord j y).fderiv]
    fin_cases m <;> fin_cases j <;> simp [EuclideanSpace.single_apply]
  have hpn : ∀ (m j : Fin 2) (y : E2), pd2 m (fun z : E2 => -(z j)) y = -(if m = j then 1 else 0) := by
    intro m j y
    have H : HasFDerivAt (fun z : E2 => -(z j)) (-(EuclideanSpace.proj j : E2 →L[ℝ] ℝ)) y :=
      (hcoord j y).neg
    simp only [pd2, H.fderiv]
    fin_cases m <;> fin_cases j <;> simp [EuclideanSpace.single_apply]
  
  have hconst : ∀ (f0 g0 f1 g1 r : E2 → ℝ) (c : ℝ) (y : E2), y ∈ U →
      DifferentiableAt ℝ f0 y → DifferentiableAt ℝ g0 y → DifferentiableAt ℝ f1 y →
      DifferentiableAt ℝ g1 y → DifferentiableAt ℝ r y →
      (∀ z ∈ U, f0 z * g0 z + f1 z * g1 z + r z = c) → ∀ m : Fin 2,
      pd2 m f0 y * g0 y + f0 y * pd2 m g0 y + (pd2 m f1 y * g1 y + f1 y * pd2 m g1 y) +
        pd2 m r y = 0 := by
    intro f0 g0 f1 g1 r c y hy h0 h0' h1 h1' hr hid m
    have H : HasFDerivAt (fun z => f0 z * g0 z + f1 z * g1 z + r z)
        (f0 y • fderiv ℝ g0 y + g0 y • fderiv ℝ f0 y + (f1 y • fderiv ℝ g1 y + g1 y • fderiv ℝ f1 y)
          + fderiv ℝ r y) y :=
      ((h0.hasFDerivAt.mul h0'.hasFDerivAt).add (h1.hasFDerivAt.mul h1'.hasFDerivAt)).add
        hr.hasFDerivAt
    have H2 : HasFDerivAt (fun z => f0 z * g0 z + f1 z * g1 z + r z) (0 : E2 →L[ℝ] ℝ) y :=
      (hasFDerivAt_const c y).congr_of_eventuallyEq (Filter.eventually_of_mem (hU.mem_nhds hy) hid)
    have := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 m)) (H.unique H2)
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
      ContinuousLinearMap.zero_apply] at this
    simp only [pd2]
    linarith
  
  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : E2, x₀ = t • e2 0 := ⟨_, rfl⟩
  have hxU : x₀ ∈ U := by rw [hx₀]; exact htU
  have hx0 : x₀ 0 = t := by rw [hx₀]; simp
  have hx1 : x₀ 1 = 0 := by rw [hx₀]; simp
  have hxB : x₀ ∈ Metric.ball (0 : E2) ρ := hUρ hxU
  have h00 : h x₀ 0 0 = 1 := by
    have e := hnf x₀ hxB 0
    rw [Fin.sum_univ_two, hx0, hx1] at e
    have : (h x₀ 0 0 - 1) * t = 0 := by linear_combination e
    have := (mul_eq_zero.1 this).resolve_right ht0
    linarith
  have h10 : h x₀ 1 0 = 0 := by
    have e := hnf x₀ hxB 1
    rw [Fin.sum_univ_two, hx0, hx1] at e
    have : h x₀ 1 0 * t = 0 := by linear_combination e
    exact (mul_eq_zero.1 this).resolve_right ht0
  have h01 : h x₀ 0 1 = 0 := by rw [hsymm]; exact h10
  have hQ0 : h x₀ 1 1 ≠ 0 := by
    have := hdet x₀ hxU
    rw [Matrix.det_fin_two, h00, h01, h10] at this
    simpa using this
  have hi00 : (h x₀)⁻¹ 0 0 = 1 := by
    rw [hinvE]; simp [Matrix.adjugate_fin_two, h00, h01, h10, hQ0]
  have hi01 : (h x₀)⁻¹ 0 1 = 0 := by
    rw [hinvE]; simp [Matrix.adjugate_fin_two, h00, h01, h10]
  have hi10 : (h x₀)⁻¹ 1 0 = 0 := by
    rw [hinvE]; simp [Matrix.adjugate_fin_two, h00, h01, h10]
  have hi11 : (h x₀)⁻¹ 1 1 = (h x₀ 1 1)⁻¹ := by
    rw [hinvE]; simp [Matrix.adjugate_fin_two, h00, h01, h10]
  have hfs : (fun z => h z 0 1) = (fun z => h z 1 0) := funext fun z => hsymm z 0 1
  
  have J1 : ∀ z ∈ U, ∀ i k : Fin 2, pd2 k (fun w => h w i 0) z * z 0 +
      pd2 k (fun w => h w i 1) z * z 1 + h z i k = if i = k then 1 else 0 := by
    intro z hz i k
    have e := hconst (fun w => h w i 0) (fun w => w 0) (fun w => h w i 1) (fun w => w 1)
      (fun w => -(w i)) 0 z hz (hdiff z hz i 0) (hcoord 0 z).differentiableAt (hdiff z hz i 1)
      (hcoord 1 z).differentiableAt (hcoord i z).neg.differentiableAt
      (by
        intro w hw
        have := hnf w (hUρ hw) i
        rw [Fin.sum_univ_two] at this
        linarith) k
    simp only [hpc, hpn] at e
    fin_cases i <;> fin_cases k <;> simp at e ⊢ <;> linarith
  have J2 : ∀ i k l : Fin 2, pd2 l (pd2 k (fun w => h w i 0)) x₀ * x₀ 0 +
      pd2 k (fun w => h w i 0) x₀ * (if l = 0 then 1 else 0) +
      (pd2 l (pd2 k (fun w => h w i 1)) x₀ * x₀ 1 +
        pd2 k (fun w => h w i 1) x₀ * (if l = 1 then 1 else 0)) +
      pd2 l (fun w => h w i k) x₀ = 0 := by
    intro i k l
    have e := hconst (pd2 k (fun w => h w i 0)) (fun w => w 0) (pd2 k (fun w => h w i 1))
      (fun w => w 1) (fun w => h w i k) (if i = k then 1 else 0) x₀ hxU (hpdiff x₀ hxU k i 0)
      (hcoord 0 x₀).differentiableAt (hpdiff x₀ hxU k i 1) (hcoord 1 x₀).differentiableAt
      (hdiff x₀ hxU i k) (fun z hz => J1 z hz i k) l
    simpa only [hpc] using e
  have d000 : pd2 0 (fun z => h z 0 0) x₀ = 0 := by
    have e := J1 x₀ hxU 0 0
    rw [if_pos rfl, hx0, hx1, h00] at e
    have : pd2 0 (fun z => h z 0 0) x₀ * t = 0 := by linear_combination e
    exact (mul_eq_zero.1 this).resolve_right ht0
  have d100 : pd2 1 (fun z => h z 0 0) x₀ = 0 := by
    have e := J1 x₀ hxU 0 1
    rw [if_neg (by decide), hx0, hx1, h01] at e
    have : pd2 1 (fun z => h z 0 0) x₀ * t = 0 := by linear_combination e
    exact (mul_eq_zero.1 this).resolve_right ht0
  have d010 : pd2 0 (fun z => h z 1 0) x₀ = 0 := by
    have e := J1 x₀ hxU 1 0
    rw [if_neg (by decide), hx0, hx1, h10] at e
    have : pd2 0 (fun z => h z 1 0) x₀ * t = 0 := by linear_combination e
    exact (mul_eq_zero.1 this).resolve_right ht0
  have d110 : pd2 1 (fun z => h z 1 0) x₀ = (1 - h x₀ 1 1) / t := by
    have e := J1 x₀ hxU 1 1
    rw [if_pos rfl, hx0, hx1] at e
    rw [eq_div_iff ht0]
    linear_combination e
  have d001 : pd2 0 (fun z => h z 0 1) x₀ = 0 := by rw [hfs]; exact d010
  have d101 : pd2 1 (fun z => h z 0 1) x₀ = (1 - h x₀ 1 1) / t := by rw [hfs]; exact d110
  have e1100 : pd2 1 (pd2 1 (fun z => h z 0 0)) x₀ = -(2 * pd2 1 (fun z => h z 0 1) x₀) / t := by
    have e := J2 0 1 1
    rw [if_neg (by decide), if_pos rfl, hx0, hx1] at e
    rw [eq_div_iff ht0]
    linear_combination e
  have e1010 : pd2 1 (pd2 0 (fun z => h z 1 0)) x₀ =
      -(pd2 0 (fun z => h z 1 1) x₀ + pd2 1 (fun z => h z 1 0) x₀) / t := by
    have e := J2 1 0 1
    rw [if_neg (by decide), if_pos rfl, hx0, hx1] at e
    rw [eq_div_iff ht0]
    linear_combination e
  have e0110 : pd2 0 (pd2 1 (fun z => h z 1 0)) x₀ =
      -(pd2 1 (fun z => h z 1 0) x₀ + pd2 0 (fun z => h z 1 1) x₀) / t := by
    have e := J2 1 1 0
    rw [if_pos rfl, if_neg (by decide), hx0, hx1] at e
    rw [eq_div_iff ht0]
    linear_combination e
  have e1001 : pd2 1 (pd2 0 (fun z => h z 0 1)) x₀ =
      -(pd2 0 (fun z => h z 1 1) x₀ + pd2 1 (fun z => h z 1 0) x₀) / t := by rw [hfs]; exact e1010
  have e0101 : pd2 0 (pd2 1 (fun z => h z 0 1)) x₀ =
      -(pd2 1 (fun z => h z 1 0) x₀ + pd2 0 (fun z => h z 1 1) x₀) / t := by rw [hfs]; exact e0110
  
  have hmul : ∀ z ∈ U, ∀ a l : Fin 2,
      h z a 0 * (h z)⁻¹ 0 l + h z a 1 * (h z)⁻¹ 1 l + 0 = if a = l then 1 else 0 := by
    intro z hz a l
    have hu : IsUnit (h z).det := isUnit_iff_ne_zero.mpr (hdet z hz)
    have := congrFun (congrFun (Matrix.mul_nonsing_inv (h z) hu) a) l
    simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply] at this
    rw [add_zero, this]
  have hDHi : ∀ a l m : Fin 2, pd2 m (fun z => h z a 0) x₀ * (h x₀)⁻¹ 0 l +
      h x₀ a 0 * pd2 m (fun z => (h z)⁻¹ 0 l) x₀ +
      (pd2 m (fun z => h z a 1) x₀ * (h x₀)⁻¹ 1 l + h x₀ a 1 * pd2 m (fun z => (h z)⁻¹ 1 l) x₀) +
      pd2 m (fun _ => (0 : ℝ)) x₀ = 0 :=
    fun a l m => hconst (fun z => h z a 0) (fun z => (h z)⁻¹ 0 l) (fun z => h z a 1)
      (fun z => (h z)⁻¹ 1 l) (fun _ => 0) (if a = l then 1 else 0) x₀ hxU (hdiff x₀ hxU a 0)
      (hinvdiff x₀ hxU 0 l) (hdiff x₀ hxU a 1) (hinvdiff x₀ hxU 1 l) (differentiableAt_const _)
      (fun z hz => hmul z hz a l) m
  have hpd0 : ∀ m : Fin 2, pd2 m (fun _ => (0 : ℝ)) x₀ = 0 := by intro m; simp [pd2]
  have dHi0_00 : pd2 0 (fun z => (h z)⁻¹ 0 0) x₀ = 0 := by
    have e := hDHi 0 0 0
    rw [d000, d001, hi00, hi10, h00, h01, hpd0] at e
    linarith
  have dHi0_01 : pd2 0 (fun z => (h z)⁻¹ 0 1) x₀ = 0 := by
    have e := hDHi 0 1 0
    rw [d000, d001, h00, h01, hpd0] at e
    linarith
  have dHi0_11 : pd2 0 (fun z => (h z)⁻¹ 1 1) x₀ =
      -(pd2 0 (fun z => h z 1 1) x₀) / h x₀ 1 1 ^ 2 := by
    have e := hDHi 1 1 0
    rw [d010, h10, hi11, hpd0] at e
    rw [eq_div_iff (pow_ne_zero 2 hQ0)]
    field_simp at e
    linear_combination e
  have dHi1_01 : pd2 1 (fun z => (h z)⁻¹ 0 1) x₀ =
      -(pd2 1 (fun z => h z 0 1) x₀) / h x₀ 1 1 := by
    have e := hDHi 0 1 1
    rw [d100, h00, h01, hi11, hpd0] at e
    rw [eq_div_iff hQ0]
    field_simp at e
    linear_combination e
  
  have hDΓ : ∀ k i j m : Fin 2, pd2 m (christoffel2 h k i j) x₀ = (1 / 2 : ℝ) * ∑ l : Fin 2,
      (pd2 m (fun z => (h z)⁻¹ k l) x₀ *
          (pd2 i (fun z => h z j l) x₀ + pd2 j (fun z => h z i l) x₀ - pd2 l (fun z => h z i j) x₀) +
        (h x₀)⁻¹ k l * (pd2 m (pd2 i (fun z => h z j l)) x₀ + pd2 m (pd2 j (fun z => h z i l)) x₀ -
          pd2 m (pd2 l (fun z => h z i j)) x₀)) := by
    intro k i j m
    have hB : ∀ l : Fin 2, HasFDerivAt (fun x => (h x)⁻¹ k l *
        (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x))
        ((h x₀)⁻¹ k l • (fderiv ℝ (pd2 i (fun z => h z j l)) x₀ +
            fderiv ℝ (pd2 j (fun z => h z i l)) x₀ - fderiv ℝ (pd2 l (fun z => h z i j)) x₀) +
          (pd2 i (fun z => h z j l) x₀ + pd2 j (fun z => h z i l) x₀ -
            pd2 l (fun z => h z i j) x₀) • fderiv ℝ (fun z => (h z)⁻¹ k l) x₀) x₀ := by
      intro l
      exact (hinvdiff x₀ hxU k l).hasFDerivAt.mul
        ((((hpdiff x₀ hxU i j l).hasFDerivAt).add (hpdiff x₀ hxU j i l).hasFDerivAt).sub
          (hpdiff x₀ hxU l i j).hasFDerivAt)
    have H : HasFDerivAt (christoffel2 h k i j) ((1 / 2 : ℝ) • ∑ l : Fin 2,
        ((h x₀)⁻¹ k l • (fderiv ℝ (pd2 i (fun z => h z j l)) x₀ +
            fderiv ℝ (pd2 j (fun z => h z i l)) x₀ - fderiv ℝ (pd2 l (fun z => h z i j)) x₀) +
          (pd2 i (fun z => h z j l) x₀ + pd2 j (fun z => h z i l) x₀ -
            pd2 l (fun z => h z i j) x₀) • fderiv ℝ (fun z => (h z)⁻¹ k l) x₀)) x₀ := by
      have e : christoffel2 h k i j = fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
          (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x) := by
        funext x; rfl
      rw [e]
      apply HasFDerivAt.const_mul
      apply HasFDerivAt.fun_sum
      intro l _
      exact hB l
    show fderiv ℝ (christoffel2 h k i j) x₀ (e2 m) = _
    rw [H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, Fin.sum_univ_two]
    simp only [pd2]
    ring
  
  have Γ000 : christoffel2 h 0 0 0 x₀ = 0 := by
    simp only [christoffel2, Fin.sum_univ_two, hi00, hi01, d000, d100, d001]
    ring
  have Γ001 : christoffel2 h 0 0 1 x₀ = 0 := by
    simp only [christoffel2, Fin.sum_univ_two, hi00, hi01, d100, d001, d010, d101]
    ring
  have Γ010 : christoffel2 h 0 1 0 x₀ = 0 := by
    simp only [christoffel2, Fin.sum_univ_two, hi00, hi01, d100, d010, d101, d110]
    ring
  have Γ011 : christoffel2 h 0 1 1 x₀ =
      (1 - h x₀ 1 1) / t - pd2 0 (fun z => h z 1 1) x₀ / 2 := by
    simp only [christoffel2, Fin.sum_univ_two, hi00, hi01, d110]
    ring
  have Γ100 : christoffel2 h 1 0 0 x₀ = 0 := by
    simp only [christoffel2, Fin.sum_univ_two, hi10, hi11, d000, d100, d001]
    ring
  have Γ101 : christoffel2 h 1 0 1 x₀ = pd2 0 (fun z => h z 1 1) x₀ / (2 * h x₀ 1 1) := by
    simp only [christoffel2, Fin.sum_univ_two, hi10, hi11, d100, d010, d101]
    field_simp
    ring
  have Γ110 : christoffel2 h 1 1 0 x₀ = pd2 0 (fun z => h z 1 1) x₀ / (2 * h x₀ 1 1) := by
    simp only [christoffel2, Fin.sum_univ_two, hi10, hi11, d010, d101, d110]
    field_simp
    ring
  have Γ111 : christoffel2 h 1 1 1 x₀ = pd2 1 (fun z => h z 1 1) x₀ / (2 * h x₀ 1 1) := by
    simp only [christoffel2, Fin.sum_univ_two, hi10, hi11, d110]
    field_simp
    ring
  
  have P1 : pd2 1 (christoffel2 h 1 0 0) x₀ =
      -(pd2 0 (fun z => h z 1 1) x₀ / (h x₀ 1 1 * t)) := by
    rw [hDΓ]
    simp only [Fin.sum_univ_two, hi10, hi11, d000, d100, d001, d101, d110, e1100, e1001]
    field_simp
    ring
  have P2 : pd2 0 (christoffel2 h 1 1 0) x₀ =
      (pd2 0 (pd2 0 (fun z => h z 1 1)) x₀ / h x₀ 1 1 -
        pd2 0 (fun z => h z 1 1) x₀ ^ 2 / h x₀ 1 1 ^ 2) / 2 := by
    rw [hDΓ]
    simp only [Fin.sum_univ_two, hi10, hi11, d100, d010, d101, d110, e0101, e0110, dHi0_11]
    field_simp
    ring
  have P3 : pd2 0 (christoffel2 h 0 1 1) x₀ =
      -((pd2 0 (fun z => h z 1 1) x₀ + (1 - h x₀ 1 1) / t) / t) -
        pd2 0 (pd2 0 (fun z => h z 1 1)) x₀ / 2 := by
    rw [hDΓ]
    simp only [Fin.sum_univ_two, hi00, hi01, d110, e0110, dHi0_00, dHi0_01]
    field_simp
    ring
  have P4 : pd2 1 (christoffel2 h 0 0 1) x₀ =
      -((1 - h x₀ 1 1) * pd2 0 (fun z => h z 1 1) x₀ / (2 * t * h x₀ 1 1)) -
        (1 - h x₀ 1 1) / t ^ 2 := by
    rw [hDΓ]
    simp only [Fin.sum_univ_two, hi00, hi01, d100, d001, d010, d101, d110, e1010, e1100,
      e1001, dHi1_01]
    field_simp
    ring
  
  have hray : ∀ (w : E2 → ℝ) (τ : ℝ), DifferentiableAt ℝ w (τ • e2 0) →
      HasDerivAt (fun s : ℝ => w (s • e2 0)) (pd2 0 w (τ • e2 0)) τ := by
    intro w τ hw
    have h1 : HasDerivAt (fun s : ℝ => s • e2 0) ((1 : ℝ) • e2 0) τ :=
      (hasDerivAt_id' τ).smul_const (e2 0)
    have h2 := hw.hasFDerivAt.comp_hasDerivAt τ h1
    simpa [pd2, Function.comp_def] using h2
  have hV : IsOpen {s : ℝ | s • e2 0 ∈ U} := hU.preimage (continuous_id.smul continuous_const)
  have hqfun : q = fun s => h (s • e2 0) 1 1 := funext hq
  have hdq : ∀ s ∈ {s : ℝ | s • e2 0 ∈ U}, deriv q s = pd2 0 (fun z => h z 1 1) (s • e2 0) := by
    intro s hs
    rw [hqfun]
    exact (hray (fun z => h z 1 1) s (hdiff _ hs 1 1)).deriv
  have hdq_t : deriv q t = pd2 0 (fun z => h z 1 1) x₀ := by rw [hdq t htU, hx₀]
  have hddq_t : deriv (deriv q) t = pd2 0 (pd2 0 (fun z => h z 1 1)) x₀ := by
    have hev : deriv q =ᶠ[𝓝 t] fun s => pd2 0 (fun z => h z 1 1) (s • e2 0) :=
      Filter.eventually_of_mem (hV.mem_nhds htU) hdq
    rw [hev.deriv_eq, hx₀]
    exact (hray (pd2 0 (fun z => h z 1 1)) t (hpdiff _ htU 0 1 1)).deriv
  have hqt : q t = h x₀ 1 1 := by rw [hq t, hx₀]
  
  rw [← hx₀, hdq_t, hddq_t, hqt]
  simp only [gaussCurv2, ricci2, Fin.sum_univ_two, hi00, hi01, hi10, hi11, Γ000, Γ001, Γ010, Γ011,
    Γ100, Γ101, Γ110, Γ111, P1, P2, P3, P4]
  field_simp
  ring

theorem normal_form_rotate (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hsymm : ∀ (x : E2) (i j : Fin 2), h x i j = h x j i) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (θ : E2) (hθ : ‖θ‖ = 1) : ∃ (L : E2 →L[ℝ] E2) (A : Matrix (Fin 2) (Fin 2) ℝ), (∀ i j : Fin 2, L (e2 j) i = A i j) ∧ A.transpose * A = 1 ∧ (∀ y : E2, ‖L y‖ = ‖y‖) ∧ (∀ τ : ℝ, L (τ • e2 0) = τ • θ) ∧ (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (A.transpose * h (L y) * A) i j) (Metric.ball 0 ρ)) ∧ (∀ (y : E2) (i j : Fin 2), (A.transpose * h (L y) * A) i j = (A.transpose * h (L y) * A) j i) ∧ (∀ y ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, (A.transpose * h (L y) * A) i j * y j = y i) ∧ (∀ y : E2, (A.transpose * h (L y) * A).det = (h (L y)).det) ∧ (∀ τ : ℝ, (A.transpose * h (L (τ • e2 0)) * A) 1 1 = h (τ • θ) 0 0 * θ 1 ^ 2 - 2 * h (τ • θ) 0 1 * θ 0 * θ 1 + h (τ • θ) 1 1 * θ 0 ^ 2) :=
by
  have hθsq : θ 0 ^ 2 + θ 1 ^ 2 = 1 := by
    have h1 := EuclideanSpace.norm_eq θ
    rw [hθ, Fin.sum_univ_two] at h1
    have h2 : (1 : ℝ) ^ 2 = (Real.sqrt (‖θ 0‖ ^ 2 + ‖θ 1‖ ^ 2)) ^ 2 := by rw [← h1]
    rw [Real.sq_sqrt (by positivity), Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs] at h2
    linarith
  let A : Matrix (Fin 2) (Fin 2) ℝ := !![θ 0, -θ 1; θ 1, θ 0]
  let L : E2 →L[ℝ] E2 := Matrix.toEuclideanCLM (𝕜 := ℝ) A
  have hA00 : A 0 0 = θ 0 := rfl
  have hA01 : A 0 1 = -θ 1 := rfl
  have hA10 : A 1 0 = θ 1 := rfl
  have hA11 : A 1 1 = θ 0 := rfl
  have hLc : ∀ (y : E2) (i : Fin 2), L y i = ∑ j : Fin 2, A i j * y j := by
    intro y i
    have := congrFun (Matrix.ofLp_toEuclideanCLM (𝕜 := ℝ) A y) i
    rw [this]
    simp [Matrix.mulVec, dotProduct]
  have hL0 : ∀ y : E2, L y 0 = θ 0 * y 0 - θ 1 * y 1 := by
    intro y
    rw [hLc, Fin.sum_univ_two, hA00, hA01] <;> ring
  have hL1 : ∀ y : E2, L y 1 = θ 1 * y 0 + θ 0 * y 1 := by
    intro y
    rw [hLc, Fin.sum_univ_two, hA10, hA11] <;> ring
  have hentry : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2), (A.transpose * H * A) i j =
      (A 0 i * H 0 0 + A 1 i * H 1 0) * A 0 j + (A 0 i * H 0 1 + A 1 i * H 1 1) * A 1 j := by
    intro H i j
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two]
  have hAA : A.transpose * A = 1 := by
    have e : ∀ i j : Fin 2, (A.transpose * A) i j = A 0 i * A 0 j + A 1 i * A 1 j := by
      intro i j
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_two]
    ext i j
    rw [e]
    fin_cases i <;> fin_cases j
    · show A 0 0 * A 0 0 + A 1 0 * A 1 0 = 1
      rw [hA00, hA10]; linear_combination hθsq
    · show A 0 0 * A 0 1 + A 1 0 * A 1 1 = 0
      rw [hA00, hA01, hA10, hA11]; ring
    · show A 0 1 * A 0 0 + A 1 1 * A 1 0 = 0
      rw [hA00, hA01, hA10, hA11]; ring
    · show A 0 1 * A 0 1 + A 1 1 * A 1 1 = 1
      rw [hA01, hA11]; linear_combination hθsq
  have hLn : ∀ y : E2, ‖L y‖ = ‖y‖ := by
    intro y
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq, Fin.sum_univ_two, Fin.sum_univ_two]
    congr 1
    simp only [Real.norm_eq_abs, sq_abs]
    rw [hL0, hL1]
    linear_combination (y 0 ^ 2 + y 1 ^ 2) * hθsq
  have hc1 : ∀ i j : Fin 2, L (e2 j) i = A i j := by
    intro i j
    rw [hLc]
    fin_cases i <;> fin_cases j <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
  have hc4 : ∀ τ : ℝ, L (τ • e2 0) = τ • θ := by
    intro τ
    apply PiLp.ext
    intro i
    fin_cases i
    · show L (τ • e2 0) 0 = (τ • θ) 0
      rw [hL0]
      simp [e2, EuclideanSpace.single_apply] <;> ring
    · show L (τ • e2 0) 1 = (τ • θ) 1
      rw [hL1]
      simp [e2, EuclideanSpace.single_apply] <;> ring
  have hmaps : Set.MapsTo L (Metric.ball (0 : E2) ρ) (Metric.ball (0 : E2) ρ) := by
    intro y hy
    rw [mem_ball_zero_iff] at hy ⊢
    rw [hLn]
    exact hy
  have hcomp : ∀ b e : Fin 2, ContDiffOn ℝ ∞ (fun y => h (L y) b e) (Metric.ball 0 ρ) :=
    fun b e => (hs b e).comp L.contDiff.contDiffOn hmaps
  have hc5 : ∀ i j : Fin 2,
      ContDiffOn ℝ ∞ (fun y => (A.transpose * h (L y) * A) i j) (Metric.ball 0 ρ) := by
    intro i j
    have hf : (fun y => (A.transpose * h (L y) * A) i j) = fun y =>
        (A 0 i * h (L y) 0 0 + A 1 i * h (L y) 1 0) * A 0 j +
          (A 0 i * h (L y) 0 1 + A 1 i * h (L y) 1 1) * A 1 j :=
      funext fun y => hentry _ i j
    rw [hf]
    exact (((contDiffOn_const.mul (hcomp 0 0)).add (contDiffOn_const.mul (hcomp 1 0))).mul
      contDiffOn_const).add
      (((contDiffOn_const.mul (hcomp 0 1)).add (contDiffOn_const.mul (hcomp 1 1))).mul
        contDiffOn_const)
  have hc6 : ∀ (y : E2) (i j : Fin 2),
      (A.transpose * h (L y) * A) i j = (A.transpose * h (L y) * A) j i := by
    intro y i j
    rw [hentry, hentry, hsymm (L y) 1 0]
    ring
  have hc7 : ∀ y ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2,
      ∑ j : Fin 2, (A.transpose * h (L y) * A) i j * y j = y i := by
    intro y hy i
    have E0 := hnf (L y) (hmaps hy) 0
    have E1 := hnf (L y) (hmaps hy) 1
    rw [Fin.sum_univ_two, hL0, hL1] at E0 E1
    have key0 : ∑ j : Fin 2, (A.transpose * h (L y) * A) 0 j * y j = y 0 := by
      rw [Fin.sum_univ_two, hentry, hentry, hA00, hA01, hA10, hA11]
      linear_combination θ 0 * E0 + θ 1 * E1 + y 0 * hθsq
    have key1 : ∑ j : Fin 2, (A.transpose * h (L y) * A) 1 j * y j = y 1 := by
      rw [Fin.sum_univ_two, hentry, hentry, hA00, hA01, hA10, hA11]
      linear_combination (-θ 1) * E0 + θ 0 * E1 + y 1 * hθsq
    fin_cases i
    · exact key0
    · exact key1
  have hdetA : A.det * A.det = 1 := by
    have := congrArg Matrix.det hAA
    rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at this
  have hc8 : ∀ y : E2, (A.transpose * h (L y) * A).det = (h (L y)).det := by
    intro y
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    linear_combination (h (L y)).det * hdetA
  have hc9 : ∀ τ : ℝ, (A.transpose * h (L (τ • e2 0)) * A) 1 1 =
      h (τ • θ) 0 0 * θ 1 ^ 2 - 2 * h (τ • θ) 0 1 * θ 0 * θ 1 + h (τ • θ) 1 1 * θ 0 ^ 2 := by
    intro τ
    rw [hc4, hentry, hA01, hA11, hsymm (τ • θ) 1 0]
    ring
  exact ⟨L, A, hc1, hAA, hLn, hc4, hc5, hc6, hc7, hc8, hc9⟩

theorem sturm_q_lower_bound (k S : ℝ) (hk : 0 ≤ k) (hS : 0 < S) (hkS : k * S ^ 2 ≤ 1) (q q1 q2 : ℝ → ℝ) (hq : ∀ τ ∈ Set.Ico 0 S, HasDerivAt q (q1 τ) τ) (hq1 : ∀ τ ∈ Set.Ico 0 S, HasDerivAt q1 (q2 τ) τ) (hq0 : q 0 = 1) (hpos : ∀ τ ∈ Set.Ico 0 S, 0 < q τ) (hode : ∀ τ ∈ Set.Ioo 0 S, τ * q1 τ ^ 2 - 2 * τ * q τ * q2 τ - 4 * q τ * q1 τ ≤ 4 * k * τ * q τ ^ 2) : ∀ τ ∈ Set.Ioo 0 S, 1 / 4 ≤ q τ :=
by
  
  have mono : ∀ (f f' : ℝ → ℝ), (∀ τ ∈ Set.Ico 0 S, HasDerivAt f (f' τ) τ) →
      (∀ τ ∈ Set.Ioo 0 S, 0 ≤ f' τ) → ∀ τ ∈ Set.Ico 0 S, f 0 ≤ f τ := by
    intro f f' hf hf' τ hτ
    have hmono : MonotoneOn f (Set.Ico 0 S) := by
      apply monotoneOn_of_deriv_nonneg (convex_Ico 0 S)
      · exact HasDerivAt.continuousOn hf
      · rw [interior_Ico]
        intro x hx
        exact (hf x (Set.Ioo_subset_Ico_self hx)).differentiableAt.differentiableWithinAt
      · rw [interior_Ico]
        intro x hx
        rw [(hf x (Set.Ioo_subset_Ico_self hx)).deriv]
        exact hf' x hx
    exact hmono ⟨le_refl 0, lt_of_le_of_lt hτ.1 hτ.2⟩ hτ hτ.1
  
  have hp : ∀ τ ∈ Set.Ico 0 S, 1 / 2 ≤ 1 - k * τ ^ 2 / 2 ∧ 1 - k * τ ^ 2 / 2 ≤ 1 := by
    intro τ hτ
    have h1 : τ ^ 2 ≤ S ^ 2 := pow_le_pow_left₀ hτ.1 hτ.2.le 2
    have h2 : k * τ ^ 2 ≤ k * S ^ 2 := mul_le_mul_of_nonneg_left h1 hk
    have h3 : 0 ≤ k * τ ^ 2 := mul_nonneg hk (sq_nonneg τ)
    constructor <;> linarith
  
  have hP : ∀ τ : ℝ, HasDerivAt (fun t : ℝ => 1 - k * t ^ 2 / 2) (-(k * τ)) τ := by
    intro τ
    have := (((hasDerivAt_pow 2 τ).const_mul k).div_const 2).const_sub 1
    convert this using 1
    push_cast
    ring
  
  have hPhi : ∀ τ ∈ Set.Ico 0 S, HasDerivAt
      (fun t => t ^ 2 * (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t) / Real.sqrt (q t))
      ((2 * q τ * (2 * τ * q1 τ * (1 - k * τ ^ 2 / 2) + 6 * k * τ ^ 2 * q τ
          + τ ^ 2 * q2 τ * (1 - k * τ ^ 2 / 2) + k * τ ^ 3 * q1 τ)
        - q1 τ * (τ ^ 2 * (q1 τ * (1 - k * τ ^ 2 / 2) + 2 * k * τ * q τ)))
        / (2 * q τ * Real.sqrt (q τ))) τ := by
    intro τ hτ
    have hqd := hq τ hτ
    have hq1d := hq1 τ hτ
    have hqp := hpos τ hτ
    have h2kt : HasDerivAt (fun t : ℝ => 2 * k * t) (2 * k) τ := by
      simpa using (hasDerivAt_id τ).const_mul (2 * k)
    have hN : HasDerivAt (fun t => t ^ 2 * (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t))
        (2 * τ * q1 τ * (1 - k * τ ^ 2 / 2) + 6 * k * τ ^ 2 * q τ
          + τ ^ 2 * q2 τ * (1 - k * τ ^ 2 / 2) + k * τ ^ 3 * q1 τ) τ := by
      have := (hasDerivAt_pow 2 τ).mul ((hq1d.mul (hP τ)).add (h2kt.mul hqd))
      convert this using 1
      simp only [Pi.mul_apply, Pi.add_apply]
      push_cast
      ring
    have hsq : HasDerivAt (fun t => Real.sqrt (q t)) (q1 τ / (2 * Real.sqrt (q τ))) τ :=
      hqd.sqrt hqp.ne'
    have hs : 0 < Real.sqrt (q τ) := Real.sqrt_pos.2 hqp
    have hdiv := hN.div hsq hs.ne'
    convert hdiv using 1
    have hss : q τ = Real.sqrt (q τ) ^ 2 := (Real.sq_sqrt hqp.le).symm
    set s := Real.sqrt (q τ) with hsdef
    rw [hss]
    field_simp
  
  have hH : ∀ τ ∈ Set.Ico 0 S, HasDerivAt (fun t => q t / (1 - k * t ^ 2 / 2) ^ 2)
      ((q1 τ * (1 - k * τ ^ 2 / 2) + 2 * k * τ * q τ) / (1 - k * τ ^ 2 / 2) ^ 3) τ := by
    intro τ hτ
    have hpne : 1 - k * τ ^ 2 / 2 ≠ 0 := by
      have := (hp τ hτ).1
      intro h
      linarith
    have hdiv := (hq τ hτ).div ((hP τ).pow 2) (pow_ne_zero 2 hpne)
    convert hdiv using 1
    simp only [Pi.pow_apply]
    push_cast
    field_simp
    ring
  
  have hPhid : ∀ t ∈ Set.Ioo 0 S,
      0 ≤ (2 * q t * (2 * t * q1 t * (1 - k * t ^ 2 / 2) + 6 * k * t ^ 2 * q t
          + t ^ 2 * q2 t * (1 - k * t ^ 2 / 2) + k * t ^ 3 * q1 t)
        - q1 t * (t ^ 2 * (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t)))
        / (2 * q t * Real.sqrt (q t)) := by
    intro t ht
    have htI := Set.Ioo_subset_Ico_self ht
    have hqp := hpos t htI
    obtain ⟨hp1, hp2⟩ := hp t htI
    have hs : 0 < Real.sqrt (q t) := Real.sqrt_pos.2 hqp
    apply div_nonneg _ (by positivity)
    have key := hode t ht
    have htp : 0 ≤ t * (1 - k * t ^ 2 / 2) := mul_nonneg ht.1.le (by linarith)
    have h1 := mul_le_mul_of_nonneg_left key htp
    have h2 : 0 ≤ k * t ^ 2 * q t ^ 2 * (3 - (1 - k * t ^ 2 / 2)) := by
      apply mul_nonneg
      · positivity
      · linarith
    have hid : 2 * q t * (2 * t * q1 t * (1 - k * t ^ 2 / 2) + 6 * k * t ^ 2 * q t
          + t ^ 2 * q2 t * (1 - k * t ^ 2 / 2) + k * t ^ 3 * q1 t)
        - q1 t * (t ^ 2 * (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t))
        = -(t * (1 - k * t ^ 2 / 2)) * (t * q1 t ^ 2 - 2 * t * q t * q2 t - 4 * q t * q1 t)
          + 12 * k * t ^ 2 * q t ^ 2 := by ring
    rw [hid]
    nlinarith [h1, h2]
  
  have hV : ∀ t ∈ Set.Ioo 0 S, 0 ≤ q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t := by
    intro t ht
    have htI := Set.Ioo_subset_Ico_self ht
    have hs : 0 < Real.sqrt (q t) := Real.sqrt_pos.2 (hpos t htI)
    have hΦ := mono _ _ hPhi hPhid t htI
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, zero_mul,
      zero_div] at hΦ
    rw [le_div_iff₀ hs, zero_mul] at hΦ
    by_contra hneg
    push_neg at hneg
    have : t ^ 2 * (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t) < 0 :=
      mul_neg_of_pos_of_neg (by have := ht.1; positivity) hneg
    linarith
  
  have hHd : ∀ t ∈ Set.Ioo 0 S,
      0 ≤ (q1 t * (1 - k * t ^ 2 / 2) + 2 * k * t * q t) / (1 - k * t ^ 2 / 2) ^ 3 := by
    intro t ht
    have := (hp t (Set.Ioo_subset_Ico_self ht)).1
    apply div_nonneg (hV t ht)
    have : 0 < 1 - k * t ^ 2 / 2 := by linarith
    positivity
  intro τ hτ
  have hτI := Set.Ioo_subset_Ico_self hτ
  have hHm := mono _ _ hH hHd τ hτI
  simp only [hq0, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero,
    zero_div, sub_zero, one_pow, div_one] at hHm
  obtain ⟨hp1, hp2⟩ := hp τ hτI
  have hp0 : 0 < (1 - k * τ ^ 2 / 2) ^ 2 := by
    have : 0 < 1 - k * τ ^ 2 / 2 := by linarith
    positivity
  rw [le_div_iff₀ hp0, one_mul] at hHm
  nlinarith [hHm, hp1]

theorem normal_form_posDef_extends (k ρ : ℝ) (hk : 0 ≤ k) (hρ : 0 < ρ) (hkρ : Real.sqrt k * ρ ≤ 1) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hsymm : ∀ (x : E2) (i j : Fin 2), h x i j = h x j i) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (hK : ∀ s : ℝ, 0 < s → s ≤ ρ → (∀ x ∈ Metric.ball (0 : E2) s, (h x).PosDef) → ∀ x ∈ Metric.ball (0 : E2) s, gaussCurv2 h x ≤ k) : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef :=
by
  
  have h0 : h 0 = 1 := normal_form_center_eq_one ρ hρ h hs hnf
  
  have hPiff : ∀ y ∈ Metric.ball (0 : E2) ρ,
      y ∈ {x : E2 | x ∈ Metric.ball (0 : E2) ρ ∧ 0 < h x 0 0 ∧ 0 < (h x).det} ↔
        (h y).PosDef := by
    intro y hy
    rw [posDef_two_iff (h y) (hsymm y 0 1)]
    exact ⟨fun hP => hP.2, fun hP => ⟨hy, hP⟩⟩
  have hc : ∀ i j : Fin 2, ContinuousOn (fun x => h x i j) (Metric.ball (0 : E2) ρ) :=
    fun i j => (hs i j).continuousOn
  have hdetc : ContinuousOn (fun x => (h x).det) (Metric.ball (0 : E2) ρ) := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x
      rw [Matrix.det_fin_two]
    rw [e]
    exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
  have hPopen : IsOpen {x : E2 | x ∈ Metric.ball (0 : E2) ρ ∧ 0 < h x 0 0 ∧ 0 < (h x).det} := by
    have h1 : IsOpen (Metric.ball (0 : E2) ρ ∩ (fun x => h x 0 0) ⁻¹' Set.Ioi 0) :=
      (hc 0 0).isOpen_inter_preimage Metric.isOpen_ball isOpen_Ioi
    have h2 : IsOpen ((Metric.ball (0 : E2) ρ ∩ (fun x => h x 0 0) ⁻¹' Set.Ioi 0) ∩
        (fun x => (h x).det) ⁻¹' Set.Ioi 0) :=
      (hdetc.mono Set.inter_subset_left).isOpen_inter_preimage h1 isOpen_Ioi
    convert h2 using 1
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Ioi]
    tauto
  have hP0 : (0 : E2) ∈ {x : E2 | x ∈ Metric.ball (0 : E2) ρ ∧ 0 < h x 0 0 ∧ 0 < (h x).det} := by
    refine ⟨Metric.mem_ball_self hρ, ?_, ?_⟩
    · rw [h0]; simp
    · rw [h0]; simp
  
  have hstep : ∀ S : ℝ, 0 < S → S < ρ →
      Metric.ball (0 : E2) S ⊆
        {x : E2 | x ∈ Metric.ball (0 : E2) ρ ∧ 0 < h x 0 0 ∧ 0 < (h x).det} →
      Metric.closedBall (0 : E2) S ⊆
        {x : E2 | x ∈ Metric.ball (0 : E2) ρ ∧ 0 < h x 0 0 ∧ 0 < (h x).det} := by
    intro S hS hSρ hBS x hx
    rw [mem_closedBall_zero_iff] at hx
    rcases lt_or_eq_of_le hx with hlt | heq
    · exact hBS (mem_ball_zero_iff.2 hlt)
    have hxρ : x ∈ Metric.ball (0 : E2) ρ := mem_ball_zero_iff.2 (by rw [heq]; exact hSρ)
    rw [hPiff x hxρ]
    have hSρ' : Metric.ball (0 : E2) S ⊆ Metric.ball (0 : E2) ρ := Metric.ball_subset_ball hSρ.le
    have hPDS : ∀ y ∈ Metric.ball (0 : E2) S, (h y).PosDef :=
      fun y hy => (hPiff y (hSρ' hy)).1 (hBS hy)
    have hKS := hK S hS hSρ.le hPDS
    have hdetS : ∀ y ∈ Metric.ball (0 : E2) S, (h y).det ≠ 0 :=
      fun y hy => (hPDS y hy).det_pos.ne'
    obtain ⟨θ, hθ, rfl⟩ : ∃ θ : E2, ‖θ‖ = 1 ∧ x = S • θ := by
      refine ⟨S⁻¹ • x, ?_, ?_⟩
      · rw [norm_smul, heq, norm_inv, Real.norm_eq_abs, abs_of_pos hS, inv_mul_cancel₀ hS.ne']
      · rw [smul_smul, mul_inv_cancel₀ hS.ne', one_smul]
    have hθsq : θ 0 ^ 2 + θ 1 ^ 2 = 1 := by
      have h1 := EuclideanSpace.norm_eq θ
      rw [hθ, Fin.sum_univ_two] at h1
      have h2 := congrArg (fun t => t ^ 2) h1
      simp only at h2
      rw [Real.sq_sqrt (by positivity)] at h2
      simp only [Real.norm_eq_abs, sq_abs] at h2
      linarith
    have hnτ : ∀ τ : ℝ, ‖τ • θ‖ = |τ| := by
      intro τ
      rw [norm_smul, hθ, mul_one, Real.norm_eq_abs]
    have hcoord : ∀ (τ : ℝ) (i : Fin 2), (τ • θ) i = τ * θ i := by
      intro τ i
      simp [PiLp.smul_apply]
    set q : ℝ → ℝ := fun τ => h (τ • θ) 0 0 * θ 1 ^ 2 - 2 * h (τ • θ) 0 1 * θ 0 * θ 1 +
      h (τ • θ) 1 1 * θ 0 ^ 2 with hqdef
    
    have hmaps : Set.MapsTo (fun τ : ℝ => τ • θ) (Set.Ioo (-ρ) ρ) (Metric.ball (0 : E2) ρ) := by
      intro τ hτ
      rw [mem_ball_zero_iff, hnτ, abs_lt]
      exact ⟨hτ.1, hτ.2⟩
    have hray : ContDiff ℝ ∞ (fun τ : ℝ => τ • θ) := contDiff_id.smul contDiff_const
    have hcomp : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun τ : ℝ => h (τ • θ) i j) (Set.Ioo (-ρ) ρ) :=
      fun i j => (hs i j).comp hray.contDiffOn hmaps
    have hqcd : ContDiffOn ℝ ∞ q (Set.Ioo (-ρ) ρ) :=
      (((hcomp 0 0).mul contDiffOn_const).sub
        (((contDiffOn_const.mul (hcomp 0 1)).mul contDiffOn_const).mul contDiffOn_const)).add
        ((hcomp 1 1).mul contDiffOn_const)
    have hdq : ContDiffOn ℝ ∞ (deriv q) (Set.Ioo (-ρ) ρ) :=
      hqcd.deriv_of_isOpen isOpen_Ioo (by simp)
    have hIoo : ∀ τ ∈ Set.Ioo (-ρ) ρ, Set.Ioo (-ρ) ρ ∈ 𝓝 τ :=
      fun τ hτ => isOpen_Ioo.mem_nhds hτ
    have hqd : ∀ τ ∈ Set.Ioo (-ρ) ρ, HasDerivAt q (deriv q τ) τ := fun τ hτ =>
      ((hqcd.differentiableOn (by simp)).differentiableAt (hIoo τ hτ)).hasDerivAt
    have hdqd : ∀ τ ∈ Set.Ioo (-ρ) ρ, HasDerivAt (deriv q) (deriv (deriv q) τ) τ := fun τ hτ =>
      ((hdq.differentiableOn (by simp)).differentiableAt (hIoo τ hτ)).hasDerivAt
    have hIco : Set.Ico 0 S ⊆ Set.Ioo (-ρ) ρ :=
      fun τ hτ => ⟨by linarith [hτ.1], by linarith [hτ.2]⟩
    
    have hq0 : q 0 = 1 := by
      have e : q 0 = (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0 * θ 1 ^ 2 -
          2 * (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 1 * θ 0 * θ 1 +
          (1 : Matrix (Fin 2) (Fin 2) ℝ) 1 1 * θ 0 ^ 2 := by
        simp only [hqdef, zero_smul, h0]
      rw [e]
      simp
      linarith
    
    have hfq : ∀ τ : ℝ, h (τ • θ) 0 0 * (τ • θ) 1 ^ 2 - 2 * h (τ • θ) 0 1 * (τ • θ) 0 * (τ • θ) 1 +
        h (τ • θ) 1 1 * (τ • θ) 0 ^ 2 = τ ^ 2 * q τ := by
      intro τ
      simp only [hqdef, hcoord]
      ring
    
    have hpos : ∀ τ ∈ Set.Ico 0 S, 0 < q τ := by
      intro τ hτ
      rcases eq_or_lt_of_le hτ.1 with h0τ | hτpos
      · rw [← h0τ, hq0]; norm_num
      · have hmem : τ • θ ∈ Metric.ball (0 : E2) S := by
          rw [mem_ball_zero_iff, hnτ, abs_of_pos hτpos]; exact hτ.2
        have hne : τ • θ ≠ 0 := by
          intro h0'
          have := hnτ τ
          rw [h0', norm_zero, abs_of_pos hτpos] at this
          linarith
        have hf := (normal_form_posDef_iff (h (τ • θ)) (hsymm _ 0 1) (τ • θ) hne
          (hnf _ (hSρ' hmem))).1 (hPDS _ hmem)
        rw [hfq τ] at hf
        by_contra hn
        push_neg at hn
        nlinarith [sq_nonneg τ]
    
    have hode : ∀ τ ∈ Set.Ioo 0 S, τ * deriv q τ ^ 2 - 2 * τ * q τ * deriv (deriv q) τ -
        4 * q τ * deriv q τ ≤ 4 * k * τ * q τ ^ 2 := by
      intro τ hτ
      have hmem : τ • θ ∈ Metric.ball (0 : E2) S := by
        rw [mem_ball_zero_iff, hnτ, abs_of_pos hτ.1]; exact hτ.2
      obtain ⟨L, A, hA, hAA, hLn, hLe, hT5, hT6, hT7, hT8, hT9⟩ :=
        normal_form_rotate ρ h hs hsymm hnf θ hθ
      have hτe : τ • e2 0 ∈ Metric.ball (0 : E2) S := by
        rw [mem_ball_zero_iff, norm_smul, EuclideanSpace.norm_single, norm_one, mul_one,
          Real.norm_eq_abs, abs_of_pos hτ.1]
        exact hτ.2
      have hrot := gaussCurv2_orthogonal_comp h L A hA hAA (Metric.ball (0 : E2) S)
        Metric.isOpen_ball (fun i j => (hs i j).mono hSρ') hdetS (τ • e2 0)
        (by rw [hLe]; exact hmem)
      rw [hLe] at hrot
      have hax := normal_form_axis_curvature ρ (fun y => A.transpose * h (L y) * A) hT5 hT6 hT7
        τ hτ.1 (Metric.ball (0 : E2) S) Metric.isOpen_ball hSρ' hτe
        (fun y hy => by
          rw [hT8 y]
          exact hdetS (L y) (by rw [mem_ball_zero_iff, hLn]; exact mem_ball_zero_iff.1 hy))
        q (fun τ' => (hT9 τ').symm)
      rw [hrot] at hax
      have hKle := hKS (τ • θ) hmem
      have hnn : 0 ≤ 4 * τ * q τ ^ 2 := by
        have := hτ.1
        positivity
      have := mul_le_mul_of_nonneg_left hKle hnn
      linarith
    
    have hkS : k * S ^ 2 ≤ 1 := by
      have h1 : Real.sqrt k * S ≤ 1 :=
        le_trans (mul_le_mul_of_nonneg_left hSρ.le (Real.sqrt_nonneg k)) hkρ
      have h2 : 0 ≤ Real.sqrt k * S := mul_nonneg (Real.sqrt_nonneg k) hS.le
      have h3 : k * S ^ 2 = (Real.sqrt k * S) ^ 2 := by rw [mul_pow, Real.sq_sqrt hk]
      rw [h3]
      nlinarith
    
    have hq14 := sturm_q_lower_bound k S hk hS hkS q (deriv q) (deriv (deriv q))
      (fun τ hτ => hqd τ (hIco hτ)) (fun τ hτ => hdqd τ (hIco hτ)) hq0 hpos hode
    have hSmem : S ∈ Set.Ioo (-ρ) ρ := ⟨by linarith, hSρ⟩
    have hqcont : ContinuousAt q S := (hqd S hSmem).continuousAt
    have hqS : 1 / 4 ≤ q S := by
      have ht : Tendsto q (𝓝[<] S) (𝓝 (q S)) := tendsto_nhdsWithin_of_tendsto_nhds hqcont
      refine ge_of_tendsto ht ?_
      filter_upwards [Ioo_mem_nhdsLT hS] with τ hτ
      exact hq14 τ hτ
    have hne : S • θ ≠ 0 := by
      intro h0'
      have := hnτ S
      rw [h0', norm_zero, abs_of_pos hS] at this
      linarith
    rw [normal_form_posDef_iff (h (S • θ)) (hsymm _ 0 1) (S • θ) hne (hnf _ hxρ), hfq S]
    have : 0 < S ^ 2 := by positivity
    nlinarith
  
  have hsub := ball_subset_of_closedBall_step ρ hρ _ hPopen hP0 hstep
  intro x hx
  exact (hPiff x hx).1 (hsub hx)

theorem surface_normal_disc [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ ρ₁ : ℝ, 0 < ρ₁ ∧ ∀ Sig : Set M, IsCompact Sig → IsMinimalSurfaceSet g Sig → ∀ q ∈ Sig, q ∈ (chartAt E3 z).source → chartAt E3 z q ∈ Metric.ball (chartAt E3 z z) r → ∀ ρ : ℝ, 0 < ρ → ρ ≤ ρ₁ → ∃ F : E2 → E3, F 0 = chartAt E3 z q ∧ ContDiffOn ℝ ∞ F (Metric.ball 0 ρ) ∧ (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => pullMetric2 (g.coeff (chartAt E3 z).symm) F x i j) (Metric.ball 0 ρ)) ∧ ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.ball (chartAt E3 z z) (2 * r) ∧ (chartAt E3 z).symm (F x) ∈ Sig ∧ Function.Injective (fderiv ℝ F x) ∧ (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, pullMetric2 (g.coeff (chartAt E3 z).symm) F x i j * x j = x i :=
by
  obtain ⟨ρ₂, hρ₂, hS2⟩ := surface_radial_geodesic_map g z r hr hball
  obtain ⟨k, hk, hS4⟩ := pullback_gauss_upper_bound g z r hr hball
  have hsk : 0 ≤ Real.sqrt k := Real.sqrt_nonneg k
  have hpos1 : 0 < 1 / (Real.sqrt k + 1) := by positivity
  refine ⟨min ρ₂ (1 / (Real.sqrt k + 1)), lt_min hρ₂ hpos1, ?_⟩
  intro Sig hSc hSm q hq hqs hqb ρ hρ hρle
  have hρ₁pos : 0 < min ρ₂ (1 / (Real.sqrt k + 1)) := lt_min hρ₂ hpos1
  have hρ₁₂ : min ρ₂ (1 / (Real.sqrt k + 1)) ≤ ρ₂ := min_le_left _ _
  have hkρ : Real.sqrt k * min ρ₂ (1 / (Real.sqrt k + 1)) ≤ 1 := by
    have h1 : min ρ₂ (1 / (Real.sqrt k + 1)) ≤ 1 / (Real.sqrt k + 1) := min_le_right _ _
    have h2 : Real.sqrt k * min ρ₂ (1 / (Real.sqrt k + 1)) ≤
        Real.sqrt k * (1 / (Real.sqrt k + 1)) :=
      mul_le_mul_of_nonneg_left h1 hsk
    have h3 : Real.sqrt k * (1 / (Real.sqrt k + 1)) ≤ 1 := by
      rw [mul_one_div, div_le_one (by positivity)]
      linarith
    linarith
  obtain ⟨F, hF0, hF, hFx⟩ := hS2 Sig hSc hSm q hq hqs hqb
  
  have hFt : ∀ x ∈ Metric.ball (0 : E2) ρ₂, F x ∈ (chartAt E3 z).target := by
    intro x hx
    apply hball
    have := (hFx x hx).1
    rw [Metric.mem_ball] at this
    rw [Metric.mem_closedBall]
    linarith
  have hGs : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  have hGsm : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j) (chartAt E3 z).target :=
    fun i j => g.smooth z i j
  
  have hdF : ContDiffOn ℝ ∞ (fderiv ℝ F) (Metric.ball 0 ρ₂) :=
    hF.fderiv_of_isOpen Metric.isOpen_ball (by simp)
  have hcomp : ∀ (i : Fin 2) (a : Fin 3),
      ContDiffOn ℝ ∞ (fun x => (fderiv ℝ F x (e2 i)) a) (Metric.ball 0 ρ₂) := by
    intro i a
    have h1 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ F x (e2 i)) (Metric.ball 0 ρ₂) :=
      hdF.clm_apply contDiffOn_const
    exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
  have hGF : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun x => g.coeff (chartAt E3 z).symm (F x) a b) (Metric.ball 0 ρ₂) :=
    fun a b => (hGsm a b).comp hF (fun x hx => hFt x hx)
  have hhs : ∀ i j : Fin 2, ContDiffOn ℝ ∞
      (fun x => pullMetric2 (g.coeff (chartAt E3 z).symm) F x i j) (Metric.ball 0 ρ₂) := by
    intro i j
    unfold pullMetric2
    exact ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun b _ =>
      ((hcomp i a).mul (hGF a b)).mul (hcomp j b)))
  
  have hhsymm : ∀ (x : E2) (i j : Fin 2),
      pullMetric2 (g.coeff (chartAt E3 z).symm) F x i j =
        pullMetric2 (g.coeff (chartAt E3 z).symm) F x j i := by
    intro x i j
    unfold pullMetric2
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    rw [hGs (F x) b a]
    ring
  
  have hinj : ∀ x : E2, (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).PosDef →
      Function.Injective (fderiv ℝ F x) := by
    intro x hpd
    rw [injective_iff_map_eq_zero]
    intro w hw
    by_contra hne
    have hv : (fun i => w i) ≠ 0 := by
      intro h0
      apply hne
      ext i
      exact congrFun h0 i
    have hpos := hpd.dotProduct_mulVec_pos hv
    have hw' : w = w 0 • e2 0 + w 1 • e2 1 := by
      ext i
      fin_cases i <;> simp [EuclideanSpace.single_apply]
    rw [hw', map_add, map_smul, map_smul] at hw
    have hu : ∀ a : Fin 3, w 0 * (fderiv ℝ F x (e2 0)) a + w 1 * (fderiv ℝ F x (e2 1)) a = 0 := by
      intro a
      have := congrArg (fun v : E3 => v a) hw
      simpa using this
    have key : dotProduct (star (fun i => w i))
        (Matrix.mulVec (pullMetric2 (g.coeff (chartAt E3 z).symm) F x) fun i => w i) =
        ∑ a : Fin 3, ∑ b : Fin 3,
          (w 0 * (fderiv ℝ F x (e2 0)) a + w 1 * (fderiv ℝ F x (e2 1)) a) *
            g.coeff (chartAt E3 z).symm (F x) a b *
            (w 0 * (fderiv ℝ F x (e2 0)) b + w 1 * (fderiv ℝ F x (e2 1)) b) := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, pullMetric2,
        Fin.sum_univ_three, Pi.star_apply]
      ring
    rw [key] at hpos
    simp only [hu, zero_mul, Finset.sum_const_zero] at hpos
    exact lt_irrefl _ hpos
  
  have hdet : ∀ y ∈ (chartAt E3 z).target, (g.coeff (chartAt E3 z).symm y).det ≠ 0 :=
    fun y hy => (coeff_chart_symm_posDef g z y hy).det_pos.ne'
  have hnf := radial_geodesic_normal_form (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target
    (chartAt E3 z).open_target hGsm hGs hdet ρ₂ F hF hFt (fun x hx => (hFx x hx).2.2.1)
    (fun x hx => (hFx x hx).2.2.2)
  have hsub : Metric.ball (0 : E2) (min ρ₂ (1 / (Real.sqrt k + 1))) ⊆ Metric.ball 0 ρ₂ :=
    Metric.ball_subset_ball hρ₁₂
  have hPD := normal_form_posDef_extends k (min ρ₂ (1 / (Real.sqrt k + 1))) hk hρ₁pos hkρ
    (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
    (fun i j => (hhs i j).mono hsub) hhsymm (fun x hx => hnf x (hsub hx))
    (by
      intro s hs0 hsle hpdS x hx
      have hsub' : Metric.ball (0 : E2) s ⊆ Metric.ball 0 ρ₂ :=
        Metric.ball_subset_ball (hsle.trans hρ₁₂)
      exact hS4 Sig hSm s F (hF.mono hsub')
        (fun y hy => ⟨(hFx y (hsub' hy)).1, (hFx y (hsub' hy)).2.1, hinj y (hpdS y hy)⟩) x hx)
  have hsubρ : Metric.ball (0 : E2) ρ ⊆ Metric.ball 0 (min ρ₂ (1 / (Real.sqrt k + 1))) :=
    Metric.ball_subset_ball hρle
  refine ⟨F, hF0, hF.mono (hsubρ.trans hsub), fun i j => (hhs i j).mono (hsubρ.trans hsub), ?_⟩
  intro x hx
  have hx1 := hsubρ hx
  have hx2 := hsub hx1
  exact ⟨(hFx x hx2).1, (hFx x hx2).2.1, hinj x (hPD x hx1), hPD x hx1, hnf x hx2⟩

theorem gs2_metric_calculus (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) s) (hhsymm : ∀ x ∈ s, ∀ i j : Fin 2, h x i j = h x j i) (hhpos : ∀ x ∈ s, (h x).PosDef) : (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) s) ∧ (∀ y ∈ s, ∀ i j : Fin 2, (h y)⁻¹ i j = (h y)⁻¹ j i) ∧ (∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) s) ∧ (∀ y ∈ s, ∀ k i j : Fin 2, christoffel2 h k i j y = christoffel2 h k j i y) ∧ (∀ y ∈ s, ∀ k i j : Fin 2, gsCovD2 h (fun i j y => h y i j) k i j y = 0) ∧ (∀ y ∈ s, ∀ k i j : Fin 2, pd2 k (fun z => (h z)⁻¹ i j) y = -∑ m : Fin 2, (christoffel2 h i k m y * (h y)⁻¹ m j + christoffel2 h j k m y * (h y)⁻¹ i m)) :=
by
  
  have hD : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f s → ∀ y ∈ s, DifferentiableAt ℝ f y :=
    fun f hf y hy => (hf.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hy)
  
  have hDr : ∀ (f : E2 → ℝ) (k : Fin 2), ContDiffOn ℝ ∞ f s →
      ContDiffOn ℝ ∞ (fun x => pd2 k f x) s :=
    fun f k hf => ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hf).2.clm_apply contDiffOn_const
  
  have hL : ∀ (f g : E2 → ℝ) (y : E2), y ∈ s → (∀ z ∈ s, f z = g z) →
      ∀ k : Fin 2, pd2 k f y = pd2 k g y := by
    intro f g y hy hfg k
    have hev : f =ᶠ[𝓝 y] g := Filter.eventually_of_mem (hs.mem_nhds hy) hfg
    unfold pd2
    rw [hev.fderiv_eq]
  have hdetpos : ∀ y ∈ s, 0 < (h y).det := fun y hy => (hhpos y hy).det_pos
  
  have hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) s := by
    have hdet : ContDiffOn ℝ ∞ (fun y => (h y).det) s := by
      have e : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
        funext y
        exact Matrix.det_fin_two _
      rw [e]
      exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
    have hdi : ContDiffOn ℝ ∞ (fun y => ((h y).det)⁻¹) s :=
      hdet.inv (fun y hy => (hdetpos y hy).ne')
    intro i j
    have e : (fun y => (h y)⁻¹ i j) = fun y => ((h y).det)⁻¹ * (h y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
    rw [e]
    refine hdi.mul ?_
    simp only [Matrix.adjugate_fin_two]
    fin_cases i <;> fin_cases j <;> simp <;>
      first
      | exact hh _ _
      | exact (hh _ _).neg
  
  have hinvsymm : ∀ y ∈ s, ∀ i j : Fin 2, (h y)⁻¹ i j = (h y)⁻¹ j i := by
    intro y hy i j
    have := ((hhpos y hy).isHermitian.inv).apply i j
    simpa using this.symm
  
  have hPH : ∀ y ∈ s, ∀ i j : Fin 2,
      ∑ m : Fin 2, (h y)⁻¹ i m * h y m j = if i = j then 1 else 0 := by
    intro y hy i j
    have hu : IsUnit (h y).det := isUnit_iff_ne_zero.2 (hdetpos y hy).ne'
    have := congrFun (congrFun (Matrix.nonsing_inv_mul (h y) hu) i) j
    rw [Matrix.mul_apply, Matrix.one_apply] at this
    exact this
  have hHP : ∀ y ∈ s, ∀ i j : Fin 2,
      ∑ m : Fin 2, h y i m * (h y)⁻¹ m j = if i = j then 1 else 0 := by
    intro y hy i j
    have hu : IsUnit (h y).det := isUnit_iff_ne_zero.2 (hdetpos y hy).ne'
    have := congrFun (congrFun (Matrix.mul_nonsing_inv (h y) hu) i) j
    rw [Matrix.mul_apply, Matrix.one_apply] at this
    exact this
  have hPHt : ∀ y ∈ s, ∀ l j : Fin 2,
      ∑ m : Fin 2, (h y)⁻¹ m l * h y m j = if l = j then 1 else 0 := by
    intro y hy l j
    rw [← hPH y hy l j]
    exact Finset.sum_congr rfl (fun m _ => by rw [hinvsymm y hy m l])
  
  have hΓ : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) s := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => christoffel2 h k i j x) s
    unfold christoffel2
    refine contDiffOn_const.mul (ContDiffOn.sum fun l _ => ?_)
    exact (hinv k l).mul (((hDr _ i (hh j l)).add (hDr _ j (hh i l))).sub (hDr _ l (hh i j)))
  
  have hΓsymm : ∀ y ∈ s, ∀ k i j : Fin 2, christoffel2 h k i j y = christoffel2 h k j i y := by
    intro y hy k i j
    have hloc : ∀ l : Fin 2, pd2 l (fun z => h z j i) y = pd2 l (fun z => h z i j) y :=
      fun l => hL _ _ y hy (fun z hz => hhsymm z hz j i) l
    unfold christoffel2
    congr 1
    exact Finset.sum_congr rfl (fun l _ => by rw [hloc l]; ring)
  
  have hcompat : ∀ y ∈ s, ∀ k i j : Fin 2, gsCovD2 h (fun i j y => h y i j) k i j y = 0 := by
    intro y hy k i j
    have hloc : pd2 k (fun z => h z j i) y = pd2 k (fun z => h z i j) y :=
      hL _ _ y hy (fun z hz => hhsymm z hz j i) k
    have K1 : ∑ l : Fin 2, (pd2 k (fun z => h z i l) y + pd2 i (fun z => h z k l) y
        - pd2 l (fun z => h z k i) y) * ∑ m : Fin 2, (h y)⁻¹ m l * h y m j =
        pd2 k (fun z => h z i j) y + pd2 i (fun z => h z k j) y
          - pd2 j (fun z => h z k i) y := by
      simp [hPHt y hy]
    have K2 : ∑ l : Fin 2, (pd2 k (fun z => h z j l) y + pd2 j (fun z => h z k l) y
        - pd2 l (fun z => h z k j) y) * ∑ m : Fin 2, h y i m * (h y)⁻¹ m l =
        pd2 k (fun z => h z j i) y + pd2 j (fun z => h z k i) y
          - pd2 i (fun z => h z k j) y := by
      simp [hHP y hy]
    show pd2 k (fun z => h z i j) y - ∑ m : Fin 2, christoffel2 h m k i y * h y m j
      - ∑ m : Fin 2, christoffel2 h m k j y * h y i m = 0
    simp only [christoffel2, Fin.sum_univ_two] at K1 K2 ⊢
    linear_combination (-1 / 2 : ℝ) * K1 - (1 / 2 : ℝ) * K2 - (1 / 2 : ℝ) * hloc
  
  have hS1 : ∀ y ∈ s, ∀ k a b : Fin 2, ∑ m : Fin 2, ((h y)⁻¹ a m * pd2 k (fun z => h z m b) y
      + h y m b * pd2 k (fun z => (h z)⁻¹ a m) y) = 0 := by
    intro y hy k a b
    have dP : ∀ a m : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ a m) y :=
      fun a m => hD _ (hinv a m) y hy
    have dH : ∀ m b : Fin 2, DifferentiableAt ℝ (fun z => h z m b) y :=
      fun m b => hD _ (hh m b) y hy
    have h1 : pd2 k (fun z => ∑ m : Fin 2, (h z)⁻¹ a m * h z m b) y = 0 := by
      rw [hL (fun z => ∑ m : Fin 2, (h z)⁻¹ a m * h z m b)
        (fun _ => if a = b then (1 : ℝ) else 0) y hy (fun z hz => hPH z hz a b) k]
      simp [pd2]
    have h2 : pd2 k (fun z => ∑ m : Fin 2, (h z)⁻¹ a m * h z m b) y =
        ∑ m : Fin 2, ((h y)⁻¹ a m * pd2 k (fun z => h z m b) y
          + h y m b * pd2 k (fun z => (h z)⁻¹ a m) y) := by
      simp only [pd2, Fin.sum_univ_two]
      have hd : HasFDerivAt (fun z => (h z)⁻¹ a 0 * h z 0 b + (h z)⁻¹ a 1 * h z 1 b)
          (((h y)⁻¹ a 0 • fderiv ℝ (fun z => h z 0 b) y
              + h y 0 b • fderiv ℝ (fun z => (h z)⁻¹ a 0) y)
            + ((h y)⁻¹ a 1 • fderiv ℝ (fun z => h z 1 b) y
              + h y 1 b • fderiv ℝ (fun z => (h z)⁻¹ a 1) y)) y :=
        ((dP a 0).hasFDerivAt.mul (dH 0 b).hasFDerivAt).add
          ((dP a 1).hasFDerivAt.mul (dH 1 b).hasFDerivAt)
      rw [hd.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [← h2, h1]
  
  have hdinv : ∀ y ∈ s, ∀ k i j : Fin 2, pd2 k (fun z => (h z)⁻¹ i j) y =
      -∑ m : Fin 2, (christoffel2 h i k m y * (h y)⁻¹ m j
        + christoffel2 h j k m y * (h y)⁻¹ i m) := by
    intro y hy k i j
    have hC : ∀ a b : Fin 2, pd2 k (fun z => h z a b) y
        - ∑ p : Fin 2, christoffel2 h p k a y * h y p b
        - ∑ p : Fin 2, christoffel2 h p k b y * h y a p = 0 :=
      fun a b => hcompat y hy k a b
    have T1 : ∑ b : Fin 2, (h y)⁻¹ b j * ∑ m : Fin 2, ((h y)⁻¹ i m * pd2 k (fun z => h z m b) y
        + h y m b * pd2 k (fun z => (h z)⁻¹ i m) y) = 0 :=
      Finset.sum_eq_zero (fun b _ => by rw [hS1 y hy k i b, mul_zero])
    have T2 : ∑ a : Fin 2, pd2 k (fun z => (h z)⁻¹ i a) y * ∑ m : Fin 2, h y a m * (h y)⁻¹ m j =
        pd2 k (fun z => (h z)⁻¹ i j) y := by
      simp [hHP y hy]
    have T3 : ∑ a : Fin 2, ∑ b : Fin 2, (h y)⁻¹ i a * (pd2 k (fun z => h z a b) y
        - ∑ p : Fin 2, christoffel2 h p k a y * h y p b
        - ∑ p : Fin 2, christoffel2 h p k b y * h y a p) * (h y)⁻¹ b j = 0 :=
      Finset.sum_eq_zero (fun a _ => Finset.sum_eq_zero (fun b _ => by rw [hC a b]; ring))
    have T4 : ∑ a : Fin 2, ∑ p : Fin 2, (h y)⁻¹ i a * christoffel2 h p k a y *
        ∑ m : Fin 2, h y p m * (h y)⁻¹ m j =
        ∑ a : Fin 2, (h y)⁻¹ i a * christoffel2 h j k a y := by
      simp [hHP y hy]
    have T5 : ∑ b : Fin 2, ∑ p : Fin 2, (∑ m : Fin 2, (h y)⁻¹ i m * h y m p) *
        christoffel2 h p k b y * (h y)⁻¹ b j =
        ∑ b : Fin 2, christoffel2 h i k b y * (h y)⁻¹ b j := by
      simp [hPH y hy]
    simp only [Fin.sum_univ_two] at T1 T2 T3 T4 T5 ⊢
    linear_combination T1 - T2 - T3 - T4 - T5
  exact ⟨hinv, hinvsymm, hΓ, hΓsymm, hcompat, hdinv⟩

theorem gs2_covd_smooth (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) s) (hΓ : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) s) : (∀ A : Fin 2 → Fin 2 → E2 → ℝ, (∀ i j : Fin 2, ContDiffOn ℝ ∞ (A i j) s) → ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (gsCovD2 h A k i j) s) ∧ (∀ A B : Fin 2 → Fin 2 → E2 → ℝ, (∀ i j : Fin 2, ContDiffOn ℝ ∞ (A i j) s) → (∀ i j : Fin 2, ContDiffOn ℝ ∞ (B i j) s) → ContDiffOn ℝ ∞ (gsInner h A B) s) :=
by
  have hpd : ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f s → ∀ k : Fin 2,
      ContDiffOn ℝ ∞ (fun x => pd2 k f x) s := by
    intro f hf k
    have hf' : ContDiffOn ℝ ∞ (fderiv ℝ f) s :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hf).2
    exact hf'.clm_apply (contDiffOn_const (c := e2 k))
  refine ⟨fun A hA k i j => ?_, fun A B hA hB => ?_⟩
  · show ContDiffOn ℝ ∞ (fun x => pd2 k (A i j) x - ∑ m : Fin 2, christoffel2 h m k i x * A m j x
      - ∑ m : Fin 2, christoffel2 h m k j x * A i m x) s
    exact ((hpd (A i j) (hA i j) k).sub
      (ContDiffOn.sum fun m _ => (hΓ m k i).mul (hA m j))).sub
      (ContDiffOn.sum fun m _ => (hΓ m k j).mul (hA i m))
  · show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
      (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) s
    exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ContDiffOn.sum fun a _ =>
      ContDiffOn.sum fun b _ => (((hinv i a).mul (hinv j b)).mul (hA i j)).mul (hB a b)

theorem gs2_inner_leibniz (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) s) (hdinv : ∀ y ∈ s, ∀ k i j : Fin 2, pd2 k (fun z => (h z)⁻¹ i j) y = -∑ m : Fin 2, (christoffel2 h i k m y * (h y)⁻¹ m j + christoffel2 h j k m y * (h y)⁻¹ i m)) (A B : Fin 2 → Fin 2 → E2 → ℝ) (hA : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (A i j) s) (hB : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (B i j) s) : ∀ y ∈ s, ∀ k : Fin 2, pd2 k (gsInner h A B) y = gsInner h (gsCovD2 h A k) B y + gsInner h A (gsCovD2 h B k) y :=
by
  intro y hy k
  have hPd : ∀ i j : Fin 2, DifferentiableAt ℝ (fun x => (h x)⁻¹ i j) y := fun i j =>
    ((hinv i j).differentiableOn (by simp)).differentiableAt (hs.mem_nhds hy)
  have hAd : ∀ i j : Fin 2, DifferentiableAt ℝ (A i j) y := fun i j =>
    ((hA i j).differentiableOn (by simp)).differentiableAt (hs.mem_nhds hy)
  have hBd : ∀ i j : Fin 2, DifferentiableAt ℝ (B i j) y := fun i j =>
    ((hB i j).differentiableOn (by simp)).differentiableAt (hs.mem_nhds hy)
  have hprod : ∀ (p q u v : E2 → ℝ), DifferentiableAt ℝ p y → DifferentiableAt ℝ q y →
      DifferentiableAt ℝ u y → DifferentiableAt ℝ v y →
      pd2 k (fun x => p x * q x * u x * v x) y =
        pd2 k p y * q y * u y * v y + p y * pd2 k q y * u y * v y +
          p y * q y * pd2 k u y * v y + p y * q y * u y * pd2 k v y := by
    intro p q u v hp hq hu hv
    unfold pd2
    have hpq : DifferentiableAt ℝ (fun x => p x * q x) y := hp.mul hq
    have hpqu : DifferentiableAt ℝ (fun x => p x * q x * u x) y := hpq.mul hu
    rw [fderiv_fun_mul hpqu hv, fderiv_fun_mul hpq hu, fderiv_fun_mul hp hq]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hsum : ∀ (F : Fin 2 → E2 → ℝ), (∀ i, DifferentiableAt ℝ (F i) y) →
      pd2 k (fun x => ∑ i : Fin 2, F i x) y = ∑ i : Fin 2, pd2 k (F i) y := by
    intro F hF
    unfold pd2
    rw [fderiv_fun_sum (fun i _ => hF i), ContinuousLinearMap.sum_apply]
  have hD4 : ∀ i j a b : Fin 2, DifferentiableAt ℝ
      (fun x => (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y := fun i j a b =>
    (((hPd i a).mul (hPd j b)).mul (hAd i j)).mul (hBd a b)
  have d3 : ∀ i j a : Fin 2, DifferentiableAt ℝ
      (fun x => ∑ b : Fin 2, (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y :=
    fun i j a => DifferentiableAt.fun_sum (fun b _ => hD4 i j a b)
  have d2 : ∀ i j : Fin 2, DifferentiableAt ℝ
      (fun x => ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y :=
    fun i j => DifferentiableAt.fun_sum (fun a _ => d3 i j a)
  have d1 : ∀ i : Fin 2, DifferentiableAt ℝ
      (fun x => ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
        (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y :=
    fun i => DifferentiableAt.fun_sum (fun j _ => d2 i j)
  have e1 : pd2 k (gsInner h A B) y = ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
      pd2 k (fun x => (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y := by
    show pd2 k (fun x => ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
      (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y = _
    rw [hsum _ d1]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hsum _ (d2 i)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hsum _ (d3 i j)]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hsum _ (fun b => hD4 i j a b)]
  have e2 : ∀ i j a b : Fin 2,
      pd2 k (fun x => (h x)⁻¹ i a * (h x)⁻¹ j b * A i j x * B a b x) y =
        pd2 k (fun x => (h x)⁻¹ i a) y * (h y)⁻¹ j b * A i j y * B a b y +
          (h y)⁻¹ i a * pd2 k (fun x => (h x)⁻¹ j b) y * A i j y * B a b y +
          (h y)⁻¹ i a * (h y)⁻¹ j b * pd2 k (A i j) y * B a b y +
          (h y)⁻¹ i a * (h y)⁻¹ j b * A i j y * pd2 k (B a b) y := fun i j a b =>
    hprod _ _ _ _ (hPd i a) (hPd j b) (hAd i j) (hBd a b)
  rw [e1]
  simp only [e2, hdinv y hy k]
  simp only [gsInner, gsCovD2, Fin.sum_univ_two]
  ring

theorem gs2_contraction_leibniz (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) s) (hdinv : ∀ y ∈ s, ∀ k i j : Fin 2, pd2 k (fun z => (h z)⁻¹ i j) y = -∑ m : Fin 2, (christoffel2 h i k m y * (h y)⁻¹ m j + christoffel2 h j k m y * (h y)⁻¹ i m)) : (∀ T : Fin 2 → Fin 2 → E2 → ℝ, (∀ i j : Fin 2, ContDiffOn ℝ ∞ (T i j) s) → ∀ y ∈ s, ∀ b : Fin 2, pd2 b (gsTrace h T) y = ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD2 h T b k l y) ∧ (∀ D : Fin 2 → Fin 2 → Fin 2 → E2 → ℝ, (∀ i j k : Fin 2, ContDiffOn ℝ ∞ (D i j k) s) → ∀ y ∈ s, ∀ a b : Fin 2, ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD3 h D a l k b y = gsCovD1 h (fun b' z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * D l k b' z) a b y) :=
by
  have prod : ∀ (P T : Fin 2 → Fin 2 → E2 → ℝ) (y : E2),
      (∀ k l : Fin 2, DifferentiableAt ℝ (P k l) y) →
      (∀ k l : Fin 2, DifferentiableAt ℝ (T k l) y) → ∀ b : Fin 2,
      pd2 b (fun z => ∑ k : Fin 2, ∑ l : Fin 2, P k l z * T k l z) y =
        ∑ k : Fin 2, ∑ l : Fin 2, (pd2 b (P k l) y * T k l y + P k l y * pd2 b (T k l) y) := by
    intro P T y hP hT b
    unfold pd2
    have hd : ∀ k ∈ (Finset.univ : Finset (Fin 2)),
        DifferentiableAt ℝ (fun z => ∑ l : Fin 2, P k l z * T k l z) y :=
      fun k _ => DifferentiableAt.fun_sum (fun l _ => (hP k l).fun_mul (hT k l))
    rw [fderiv_fun_sum hd, ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [fderiv_fun_sum (fun l _ => (hP k l).fun_mul (hT k l)), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [fderiv_fun_mul (hP k l) (hT k l)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hdiff : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f s → ∀ y ∈ s, DifferentiableAt ℝ f y :=
    fun f hf y hy => (hf.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hy)
  refine ⟨fun T hT y hy b => ?_, fun D hD y hy a b => ?_⟩
  · have e := prod (fun k l z => (h z)⁻¹ k l) T y (fun k l => hdiff _ (hinv k l) y hy)
      (fun k l => hdiff _ (hT k l) y hy) b
    show pd2 b (fun z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * T k l z) y = _
    rw [e]
    simp only [hdinv y hy, gsCovD2, Fin.sum_univ_two]
    ring
  · have e := prod (fun k l z => (h z)⁻¹ k l) (fun k l => D l k b) y
      (fun k l => hdiff _ (hinv k l) y hy) (fun k l => hdiff _ (hD l k b) y hy) a
    show _ = pd2 a (fun z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * D l k b z) y -
      ∑ m : Fin 2, christoffel2 h m a b y *
        (∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * D l k m y)
    rw [e]
    simp only [hdinv y hy, gsCovD3, Fin.sum_univ_two]
    ring

theorem gs2_ricci_identity (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hΓ : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) s) (hΓsymm : ∀ y ∈ s, ∀ k i j : Fin 2, christoffel2 h k i j y = christoffel2 h k j i y) (T : Fin 2 → Fin 2 → E2 → ℝ) (hT : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (T i j) s) : ∀ x ∈ s, ∀ l i k j : Fin 2, gsCovD3 h (gsCovD2 h T) l i k j x - gsCovD3 h (gsCovD2 h T) i l k j x = -∑ m : Fin 2, gsRiem2 h m l i k x * T m j x - ∑ m : Fin 2, gsRiem2 h m l i j x * T k m x :=
by
  intro x hx l i k j
  have hU : s ∈ 𝓝 x := hs.mem_nhds hx
  
  have dΓ : ∀ m a b : Fin 2, DifferentiableAt ℝ (christoffel2 h m a b) x := fun m a b =>
    ((hΓ m a b).contDiffAt hU).differentiableAt (by simp)
  have dT : ∀ a b : Fin 2, DifferentiableAt ℝ (T a b) x := fun a b =>
    ((hT a b).contDiffAt hU).differentiableAt (by simp)
  have dpT : ∀ c a b : Fin 2, DifferentiableAt ℝ (pd2 c (T a b)) x := by
    intro c a b
    have hf' : ContDiffOn ℝ ∞ (fderiv ℝ (T a b)) s :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 (hT a b)).2
    have h2 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (T a b) y (e2 c)) s :=
      hf'.clm_apply (contDiffOn_const (c := e2 c))
    exact (h2.contDiffAt hU).differentiableAt (by simp)
  
  have schwarz : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f s → ∀ a b : Fin 2,
      pd2 a (pd2 b f) x = pd2 b (pd2 a f) x := by
    intro f hf a b
    have hfx : ContDiffAt ℝ ∞ f x := hf.contDiffAt hU
    have hsym : IsSymmSndFDerivAt ℝ f x := hfx.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; norm_cast)
    have hdf : DifferentiableAt ℝ (fderiv ℝ f) x :=
      ((((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hf).2).contDiffAt hU).differentiableAt
        (by simp)
    have key : ∀ a b : Fin 2, pd2 a (pd2 b f) x = fderiv ℝ (fderiv ℝ f) x (e2 a) (e2 b) := by
      intro a b
      have H : HasFDerivAt (pd2 b f)
          ((fderiv ℝ f x).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ f) x).flip (e2 b)) x :=
        hdf.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 b) x)
      show fderiv ℝ (pd2 b f) x (e2 a) = _
      rw [H.fderiv]
      simp
    rw [key a b, key b a]
    exact hsym (e2 a) (e2 b)
  
  have expand : ∀ a b c d : Fin 2, pd2 a (gsCovD2 h T b c d) x =
      pd2 a (pd2 b (T c d)) x
        - ∑ m : Fin 2, (pd2 a (christoffel2 h m b c) x * T m d x
            + christoffel2 h m b c x * pd2 a (T m d) x)
        - ∑ m : Fin 2, (pd2 a (christoffel2 h m b d) x * T c m x
            + christoffel2 h m b d x * pd2 a (T c m) x) := by
    intro a b c d
    have H : HasFDerivAt (fun y => pd2 b (T c d) y
          - ∑ m : Fin 2, christoffel2 h m b c y * T m d y
          - ∑ m : Fin 2, christoffel2 h m b d y * T c m y)
        (fderiv ℝ (pd2 b (T c d)) x
          - ∑ m : Fin 2, (christoffel2 h m b c x • fderiv ℝ (T m d) x
              + T m d x • fderiv ℝ (christoffel2 h m b c) x)
          - ∑ m : Fin 2, (christoffel2 h m b d x • fderiv ℝ (T c m) x
              + T c m x • fderiv ℝ (christoffel2 h m b d) x)) x :=
      ((dpT b c d).hasFDerivAt.sub
        (HasFDerivAt.sum (u := Finset.univ) fun m _ =>
          (dΓ m b c).hasFDerivAt.mul (dT m d).hasFDerivAt)).sub
        (HasFDerivAt.sum (u := Finset.univ) fun m _ =>
          (dΓ m b d).hasFDerivAt.mul (dT c m).hasFDerivAt)
    show fderiv ℝ (fun y => pd2 b (T c d) y
          - ∑ m : Fin 2, christoffel2 h m b c y * T m d y
          - ∑ m : Fin 2, christoffel2 h m b d y * T c m y) x (e2 a) = _
    rw [H.fderiv]
    simp only [pd2, ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  
  simp only [gsCovD3]
  rw [expand l i k j, expand i l k j, schwarz (T k j) (hT k j) i l]
  simp only [gsCovD2, gsRiem2, Fin.sum_univ_two]
  rw [hΓsymm x hx 0 i l, hΓsymm x hx 1 i l]
  ring

theorem gs2_curvature_2d (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2) (hpos : (h x).PosDef) (hanti : ∀ l i k j : Fin 2, ∑ m : Fin 2, gsRiem2 h m l i k x * h x m j + ∑ m : Fin 2, gsRiem2 h m l i j x * h x k m = 0) : ∀ m l i k : Fin 2, gsRiem2 h m l i k x = gaussCurv2 h x * (h x i k * (if m = l then 1 else 0) - h x l k * (if m = i then 1 else 0)) :=
by
  classical
  
  have alg : ∀ (H P : Matrix (Fin 2) (Fin 2) ℝ) (r : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) (K : ℝ),
      H 1 0 = H 0 1 → H 0 0 * H 1 1 - H 0 1 * H 0 1 ≠ 0 →
      (H 0 0 * H 1 1 - H 0 1 * H 0 1) * P 0 0 = H 1 1 →
      (H 0 0 * H 1 1 - H 0 1 * H 0 1) * P 0 1 = -H 0 1 →
      (H 0 0 * H 1 1 - H 0 1 * H 0 1) * P 1 0 = -H 0 1 →
      (H 0 0 * H 1 1 - H 0 1 * H 0 1) * P 1 1 = H 0 0 →
      (∀ m l i k : Fin 2, r m i l k = -r m l i k) →
      (∀ l i k j : Fin 2, ∑ m : Fin 2, r m l i k * H m j + ∑ m : Fin 2, r m l i j * H k m = 0) →
      K = (1 / 2 : ℝ) * ∑ a : Fin 2, ∑ b : Fin 2, P a b * ∑ c : Fin 2, r c c a b →
      ∀ m l i k : Fin 2, r m l i k =
        K * (H i k * (if m = l then 1 else 0) - H l k * (if m = i then 1 else 0)) := by
    intro H P r K hsymm hd hP00 hP01 hP10 hP11 hr hant hK
    have hdiag : ∀ m l k : Fin 2, r m l l k = 0 := fun m l k => by linarith [hr m l l k]
    have hswap : ∀ m k : Fin 2, r m 1 0 k = -r m 0 1 k := fun m k => hr m 0 1 k
    have hK' : K = (1 / 2 : ℝ) * (-P 0 0 * r 1 0 1 0 - P 0 1 * r 1 0 1 1
        + P 1 0 * r 0 0 1 0 + P 1 1 * r 0 0 1 1) := by
      rw [hK]
      simp only [Fin.sum_univ_two]
      rw [hdiag 0 0 0, hdiag 0 0 1, hdiag 1 1 0, hdiag 1 1 1, hswap 1 0, hswap 1 1]
      ring
    have h1 := hant 0 1 0 0
    have h2 := hant 0 1 1 1
    have h3 := hant 0 1 0 1
    simp only [Fin.sum_univ_two, hsymm] at h1 h2 h3
    have hN : (H 0 0 * H 1 1 - H 0 1 * H 0 1) * (2 * K) =
        -H 1 1 * r 1 0 1 0 + H 0 1 * r 1 0 1 1 - H 0 1 * r 0 0 1 0 + H 0 0 * r 0 0 1 1 := by
      linear_combination (2 * (H 0 0 * H 1 1 - H 0 1 * H 0 1)) * hK'
        + (-r 1 0 1 0) * hP00 + (-r 1 0 1 1) * hP01 + (r 0 0 1 0) * hP10 + (r 0 0 1 1) * hP11
    have c00 : (H 0 0 * H 1 1 - H 0 1 * H 0 1) * (2 * r 0 0 1 0 - 2 * K * H 0 1) = 0 := by
      linear_combination H 1 1 * h1 - H 0 1 * h3 - H 0 1 * hN
    have c01 : (H 0 0 * H 1 1 - H 0 1 * H 0 1) * (2 * r 0 0 1 1 - 2 * K * H 1 1) = 0 := by
      linear_combination H 1 1 * h3 - H 0 1 * h2 - H 1 1 * hN
    have c10 : (H 0 0 * H 1 1 - H 0 1 * H 0 1) * (2 * r 1 0 1 0 + 2 * K * H 0 0) = 0 := by
      linear_combination H 0 0 * h3 - H 0 1 * h1 + H 0 0 * hN
    have c11 : (H 0 0 * H 1 1 - H 0 1 * H 0 1) * (2 * r 1 0 1 1 + 2 * K * H 0 1) = 0 := by
      linear_combination H 0 0 * h2 - H 0 1 * h3 + H 0 1 * hN
    have E00 : r 0 0 1 0 = K * H 0 1 := by
      have := (mul_eq_zero.mp c00).resolve_left hd; linarith
    have E01 : r 0 0 1 1 = K * H 1 1 := by
      have := (mul_eq_zero.mp c01).resolve_left hd; linarith
    have E10 : r 1 0 1 0 = -(K * H 0 0) := by
      have := (mul_eq_zero.mp c10).resolve_left hd; linarith
    have E11 : r 1 0 1 1 = -(K * H 0 1) := by
      have := (mul_eq_zero.mp c11).resolve_left hd; linarith
    intro m l i k
    fin_cases m <;> fin_cases l <;> fin_cases i <;> fin_cases k <;>
      simp [hsymm, hdiag, hswap, E00, E01, E10, E11] <;> ring
  
  have hR2 : ∀ m l i k : Fin 2, gsRiem2 h m i l k x = -gsRiem2 h m l i k x := by
    intro m l i k
    simp only [gsRiem2, Fin.sum_univ_two]
    ring
  
  have hR1 : ∀ a b : Fin 2, ricci2 h a b x = ∑ c : Fin 2, gsRiem2 h c c a b x := by
    intro a b
    simp only [ricci2, gsRiem2, Fin.sum_univ_two]
    ring
  have hK : gaussCurv2 h x = (1 / 2 : ℝ) * ∑ a : Fin 2, ∑ b : Fin 2,
      (h x)⁻¹ a b * ∑ c : Fin 2, gsRiem2 h c c a b x := by
    unfold gaussCurv2
    simp only [hR1]
  
  have hs : h x 1 0 = h x 0 1 := by
    have := hpos.isHermitian.apply 1 0
    simpa using this.symm
  have hdet : 0 < (h x).det := hpos.det_pos
  have hdpos : 0 < h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 := by
    have e := Matrix.det_fin_two (h x)
    rw [hs] at e
    rw [← e]
    exact hdet
  have hU : IsUnit (h x).det := isUnit_iff_ne_zero.mpr (ne_of_gt hdet)
  have hmul : h x * (h x)⁻¹ = 1 := Matrix.mul_nonsing_inv (h x) hU
  have m00 : h x 0 0 * (h x)⁻¹ 0 0 + h x 0 1 * (h x)⁻¹ 1 0 = 1 := by
    have := congrFun (congrFun hmul 0) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have m01 : h x 0 0 * (h x)⁻¹ 0 1 + h x 0 1 * (h x)⁻¹ 1 1 = 0 := by
    have := congrFun (congrFun hmul 0) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have m10 : h x 1 0 * (h x)⁻¹ 0 0 + h x 1 1 * (h x)⁻¹ 1 0 = 0 := by
    have := congrFun (congrFun hmul 1) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have m11 : h x 1 0 * (h x)⁻¹ 0 1 + h x 1 1 * (h x)⁻¹ 1 1 = 1 := by
    have := congrFun (congrFun hmul 1) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  rw [hs] at m10 m11
  have hP00 : (h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1) * (h x)⁻¹ 0 0 = h x 1 1 := by
    linear_combination h x 1 1 * m00 - h x 0 1 * m10
  have hP01 : (h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1) * (h x)⁻¹ 0 1 = -h x 0 1 := by
    linear_combination h x 1 1 * m01 - h x 0 1 * m11
  have hP10 : (h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1) * (h x)⁻¹ 1 0 = -h x 0 1 := by
    linear_combination h x 0 0 * m10 - h x 0 1 * m00
  have hP11 : (h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1) * (h x)⁻¹ 1 1 = h x 0 0 := by
    linear_combination h x 0 0 * m11 - h x 0 1 * m01
  
  exact alg (h x) (h x)⁻¹ (fun m l i k => gsRiem2 h m l i k x) (gaussCurv2 h x)
    hs (ne_of_gt hdpos) hP00 hP01 hP10 hP11 hR2 hanti hK

theorem gs2_grad_sq_nonneg (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (D : Fin 2 → Fin 2 → Fin 2 → E2 → ℝ) (x : E2) (hpos : (h x).PosDef) : 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * gsInner h (D i) (D j) x :=
by
  have hP : ((h x)⁻¹).PosDef := hpos.inv
  have hp : 0 < (h x)⁻¹ 0 0 := hP.diag_pos
  have hsym : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := by
    have h1 := hP.isHermitian.apply 1 0
    simp only [star_trivial] at h1
    exact h1.symm
  have hdet0 : 0 < ((h x)⁻¹).det := hP.det_pos
  rw [Matrix.det_fin_two, hsym] at hdet0
  simp only [gsInner, Fin.sum_univ_two]
  simp only [hsym]
  set p := (h x)⁻¹ 0 0 with hpdef
  set q := (h x)⁻¹ 0 1 with hqdef
  set r := (h x)⁻¹ 1 1 with hrdef
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = p * r - q ^ 2 := ⟨_, rfl⟩
  have hδ : 0 ≤ δ := by rw [hδdef]; nlinarith
  have hp3 : 0 < p ^ 3 := pow_pos hp 3
  rw [← mul_nonneg_iff_of_pos_left hp3]
  have hR : 0 ≤
      (p * (p * (p * D 0 0 0 x + q * D 0 0 1 x) + q * (p * D 0 1 0 x + q * D 0 1 1 x))
        + q * (p * (p * D 1 0 0 x + q * D 1 0 1 x) + q * (p * D 1 1 0 x + q * D 1 1 1 x))) ^ 2
      + δ * (p * (p * D 0 0 1 x + q * D 0 1 1 x) + q * (p * D 1 0 1 x + q * D 1 1 1 x)) ^ 2
      + δ * (p * (p * D 0 1 0 x + q * D 0 1 1 x) + q * (p * D 1 1 0 x + q * D 1 1 1 x)) ^ 2
      + δ ^ 2 * (p * D 0 1 1 x + q * D 1 1 1 x) ^ 2
      + δ * (p * (p * D 1 0 0 x + q * D 1 0 1 x) + q * (p * D 1 1 0 x + q * D 1 1 1 x)) ^ 2
      + δ ^ 2 * (p * D 1 0 1 x + q * D 1 1 1 x) ^ 2
      + δ ^ 2 * (p * D 1 1 0 x + q * D 1 1 1 x) ^ 2
      + δ ^ 3 * (D 1 1 1 x) ^ 2 := by
    exact add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg
      (sq_nonneg _) (mul_nonneg hδ (sq_nonneg _))) (mul_nonneg hδ (sq_nonneg _)))
      (mul_nonneg (pow_nonneg hδ 2) (sq_nonneg _))) (mul_nonneg hδ (sq_nonneg _)))
      (mul_nonneg (pow_nonneg hδ 2) (sq_nonneg _))) (mul_nonneg (pow_nonneg hδ 2) (sq_nonneg _)))
      (mul_nonneg (pow_nonneg hδ 3) (sq_nonneg _))
  refine hR.trans_eq ?_
  rw [hδdef]
  ring

theorem gs2_bochner (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (S : Fin 2 → Fin 2 → E2 → ℝ) (s : Set E2) (hs : IsOpen s) (hinvsymm : ∀ y ∈ s, ∀ i j : Fin 2, (h y)⁻¹ i j = (h y)⁻¹ j i) (hIn : ∀ j : Fin 2, ContDiffOn ℝ ∞ (gsInner h S (gsCovD2 h S j)) s) (hL1 : ∀ y ∈ s, ∀ k : Fin 2, pd2 k (gsInner h S S) y = gsInner h (gsCovD2 h S k) S y + gsInner h S (gsCovD2 h S k) y) (hL2 : ∀ y ∈ s, ∀ j k : Fin 2, pd2 k (gsInner h S (gsCovD2 h S j)) y = gsInner h (gsCovD2 h S k) (gsCovD2 h S j) y + gsInner h S (gsCovD2 h (gsCovD2 h S j) k) y) : ∀ x ∈ s, lap2 h (gsInner h S S) x = 2 * ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * gsInner h (gsCovD2 h S i) (gsCovD2 h S j) x + 2 * gsInner h S (fun a b y => ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b y) x :=
by
  intro x hx
  have hsx : s ∈ 𝓝 x := hs.mem_nhds hx
  
  have s1 : ∀ y ∈ s, ∀ A B : Fin 2 → Fin 2 → E2 → ℝ, gsInner h A B y = gsInner h B A y := by
    intro y hy A B
    simp only [gsInner, Fin.sum_univ_two]
    rw [hinvsymm y hy 1 0]
    ring
  
  have hd1 : ∀ y ∈ s, ∀ k : Fin 2,
      pd2 k (gsInner h S S) y = 2 * gsInner h S (gsCovD2 h S k) y := by
    intro y hy k
    rw [hL1 y hy k, s1 y hy (gsCovD2 h S k) S]
    ring
  
  have s3 : ∀ i j : Fin 2, pd2 i (pd2 j (gsInner h S S)) x =
      2 * (gsInner h (gsCovD2 h S i) (gsCovD2 h S j) x +
        gsInner h S (gsCovD2 h (gsCovD2 h S j) i) x) := by
    intro i j
    have hev : pd2 j (gsInner h S S) =ᶠ[𝓝 x] (fun y => 2 * gsInner h S (gsCovD2 h S j) y) :=
      Filter.eventually_of_mem hsx (fun y hy => hd1 y hy j)
    have hdiff : DifferentiableAt ℝ (gsInner h S (gsCovD2 h S j)) x :=
      ((hIn j).differentiableOn (by simp)).differentiableAt hsx
    have e1 : pd2 i (pd2 j (gsInner h S S)) x =
        fderiv ℝ (pd2 j (gsInner h S S)) x (e2 i) := rfl
    have e2' : fderiv ℝ (gsInner h S (gsCovD2 h S j)) x (e2 i) =
        pd2 i (gsInner h S (gsCovD2 h S j)) x := rfl
    rw [e1, hev.fderiv_eq, fderiv_const_mul hdiff 2, ContinuousLinearMap.smul_apply,
      smul_eq_mul, e2', hL2 x hx j i]
  
  have s5 : ∀ i j a b : Fin 2, gsCovD3 h (gsCovD2 h S) i j a b x =
      gsCovD2 h (gsCovD2 h S j) i a b x -
        ∑ m : Fin 2, christoffel2 h m i j x * gsCovD2 h S m a b x := by
    intro i j a b
    simp only [gsCovD3, gsCovD2]
    ring
  
  have s6 : gsInner h S (fun a b y => ∑ k : Fin 2, ∑ l : Fin 2,
        (h y)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b y) x =
      ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l *
        (gsInner h S (gsCovD2 h (gsCovD2 h S k) l) x -
          ∑ m : Fin 2, christoffel2 h m l k x * gsInner h S (gsCovD2 h S m) x) := by
    simp only [gsInner, s5, Fin.sum_univ_two]
    ring
  
  rw [s6, lap2]
  simp only [s3, hd1 x hx, Fin.sum_univ_two]
  rw [hinvsymm x hx 1 0]
  ring

theorem gs2_weitzenbock (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (S : Fin 2 → Fin 2 → E2 → ℝ) (s : Set E2) (hs : IsOpen s) (hhpos : ∀ x ∈ s, (h x).PosDef) (hSsymm : ∀ x ∈ s, ∀ i j : Fin 2, S i j x = S j i x) (htr : ∀ x ∈ s, gsTrace h S x = 0) (hinvsymm : ∀ y ∈ s, ∀ i j : Fin 2, (h y)⁻¹ i j = (h y)⁻¹ j i) (hDS : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (gsCovD2 h S k i j) s) (hRic : ∀ x ∈ s, ∀ l i k j : Fin 2, gsCovD3 h (gsCovD2 h S) l i k j x - gsCovD3 h (gsCovD2 h S) i l k j x = -∑ m : Fin 2, gsRiem2 h m l i k x * S m j x - ∑ m : Fin 2, gsRiem2 h m l i j x * S k m x) (hK : ∀ x ∈ s, ∀ m l i k : Fin 2, gsRiem2 h m l i k x = gaussCurv2 h x * (h x i k * (if m = l then 1 else 0) - h x l k * (if m = i then 1 else 0))) (hTr : ∀ y ∈ s, ∀ b : Fin 2, pd2 b (gsTrace h S) y = ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD2 h S b k l y) (hCon : ∀ y ∈ s, ∀ a b : Fin 2, ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD3 h (gsCovD2 h S) a l k b y = gsCovD1 h (fun b' z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * gsCovD2 h S l k b' z) a b y) : ∀ x ∈ s, ∀ a b : Fin 2, ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b x = 2 * gaussCurv2 h x * S a b x + gsSimonsE h (gsCodazzi h S) a b x :=
by
  intro x hx a b
  
  have hdiff : ∀ k i j : Fin 2, DifferentiableAt ℝ (gsCovD2 h S k i j) x := fun k i j =>
    ((hDS k i j).differentiableOn (by simp)).differentiableAt (hs.mem_nhds hx)
  have hpdC : ∀ l k i j : Fin 2, pd2 l (gsCodazzi h S k i j) x =
      pd2 l (gsCovD2 h S k i j) x - pd2 l (gsCovD2 h S i k j) x := by
    intro l k i j
    have e : gsCodazzi h S k i j = fun y => gsCovD2 h S k i j y - gsCovD2 h S i k j y := rfl
    rw [e]
    unfold pd2
    rw [fderiv_fun_sub (hdiff k i j) (hdiff i k j), ContinuousLinearMap.sub_apply]
  have s1 : ∀ l k : Fin 2, gsCovD3 h (gsCovD2 h S) l k a b x =
      gsCovD3 h (gsCovD2 h S) l a k b x + gsCovD3 h (gsCodazzi h S) l k a b x := by
    intro l k
    rw [gsCovD3, gsCovD3, gsCovD3, hpdC]
    simp only [gsCodazzi, Fin.sum_univ_two]
    ring
  
  have hU : IsUnit (h x).det := IsUnit.mk0 _ (hhpos x hx).det_pos.ne'
  have I1 : ∀ i l : Fin 2, ∑ k : Fin 2, h x i k * (h x)⁻¹ k l = if i = l then 1 else 0 := by
    intro i l
    have e := congrFun (congrFun (Matrix.mul_nonsing_inv (h x) hU) i) l
    rwa [Matrix.mul_apply, Matrix.one_apply] at e
  have I2 : ∀ k j : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * h x l j = if k = j then 1 else 0 := by
    intro k j
    have e := congrFun (congrFun (Matrix.nonsing_inv_mul (h x) hU) k) j
    rwa [Matrix.mul_apply, Matrix.one_apply] at e
  have htr' := htr x hx
  unfold gsTrace at htr'
  simp only [Fin.sum_univ_two] at htr'
  have s2 : ∀ a b : Fin 2, ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l *
      (-∑ m : Fin 2, gsRiem2 h m l a k x * S m b x - ∑ m : Fin 2, gsRiem2 h m l a b x * S k m x) =
      2 * gaussCurv2 h x * S a b x := by
    intro a b
    simp only [hK x hx]
    have ha : a = 0 ∨ a = 1 := by fin_cases a <;> simp
    have hb : b = 0 ∨ b = 1 := by fin_cases b <;> simp
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · have c1 := I1 0 0; have c2 := I1 0 1; have c3 := I2 0 0; have c4 := I2 1 1
      have c5 := I2 0 0; have c6 := I2 1 0; have c7 := hSsymm x hx 0 0
      simp only [Fin.sum_univ_two, Fin.isValue, eq_self_iff_true, if_true, if_false,
        Fin.reduceEq, ↓reduceIte] at c1 c2 c3 c4 c5 c6 ⊢
      linear_combination (-gaussCurv2 h x) * S 0 0 x * c1 + (-gaussCurv2 h x) * S 1 0 x * c2
        + gaussCurv2 h x * S 0 0 x * c3 + gaussCurv2 h x * S 0 0 x * c4
        - gaussCurv2 h x * h x 0 0 * htr' + gaussCurv2 h x * S 0 0 x * c5
        + gaussCurv2 h x * S 1 0 x * c6 - gaussCurv2 h x * c7
    · have c1 := I1 0 0; have c2 := I1 0 1; have c3 := I2 0 0; have c4 := I2 1 1
      have c5 := I2 0 1; have c6 := I2 1 1; have c7 := hSsymm x hx 0 1
      simp only [Fin.sum_univ_two, Fin.isValue, eq_self_iff_true, if_true, if_false,
        Fin.reduceEq, ↓reduceIte] at c1 c2 c3 c4 c5 c6 ⊢
      linear_combination (-gaussCurv2 h x) * S 0 1 x * c1 + (-gaussCurv2 h x) * S 1 1 x * c2
        + gaussCurv2 h x * S 0 1 x * c3 + gaussCurv2 h x * S 0 1 x * c4
        - gaussCurv2 h x * h x 0 1 * htr' + gaussCurv2 h x * S 0 0 x * c5
        + gaussCurv2 h x * S 1 0 x * c6 - gaussCurv2 h x * c7
    · have c1 := I1 1 0; have c2 := I1 1 1; have c3 := I2 0 0; have c4 := I2 1 1
      have c5 := I2 0 0; have c6 := I2 1 0; have c7 := hSsymm x hx 1 0
      simp only [Fin.sum_univ_two, Fin.isValue, eq_self_iff_true, if_true, if_false,
        Fin.reduceEq, ↓reduceIte] at c1 c2 c3 c4 c5 c6 ⊢
      linear_combination (-gaussCurv2 h x) * S 0 0 x * c1 + (-gaussCurv2 h x) * S 1 0 x * c2
        + gaussCurv2 h x * S 1 0 x * c3 + gaussCurv2 h x * S 1 0 x * c4
        - gaussCurv2 h x * h x 1 0 * htr' + gaussCurv2 h x * S 0 1 x * c5
        + gaussCurv2 h x * S 1 1 x * c6 - gaussCurv2 h x * c7
    · have c1 := I1 1 0; have c2 := I1 1 1; have c3 := I2 0 0; have c4 := I2 1 1
      have c5 := I2 0 1; have c6 := I2 1 1; have c7 := hSsymm x hx 1 1
      simp only [Fin.sum_univ_two, Fin.isValue, eq_self_iff_true, if_true, if_false,
        Fin.reduceEq, ↓reduceIte] at c1 c2 c3 c4 c5 c6 ⊢
      linear_combination (-gaussCurv2 h x) * S 0 1 x * c1 + (-gaussCurv2 h x) * S 1 1 x * c2
        + gaussCurv2 h x * S 1 1 x * c3 + gaussCurv2 h x * S 1 1 x * c4
        - gaussCurv2 h x * h x 1 1 * htr' + gaussCurv2 h x * S 0 1 x * c5
        + gaussCurv2 h x * S 1 1 x * c6 - gaussCurv2 h x * c7
  
  have hpdS : ∀ y ∈ s, ∀ k i j : Fin 2, pd2 k (S i j) y = pd2 k (S j i) y := by
    intro y hy k i j
    have hev : S i j =ᶠ[𝓝 y] S j i :=
      Filter.eventually_of_mem (hs.mem_nhds hy) (fun z hz => hSsymm z hz i j)
    unfold pd2
    rw [hev.fderiv_eq]
  have Dsym : ∀ y ∈ s, ∀ k i j : Fin 2, gsCovD2 h S k i j y = gsCovD2 h S k j i y := by
    intro y hy k i j
    simp only [gsCovD2, Fin.sum_univ_two]
    linear_combination hpdS y hy k i j - christoffel2 h 0 k i y * hSsymm y hy 0 j
      - christoffel2 h 1 k i y * hSsymm y hy 1 j - christoffel2 h 0 k j y * hSsymm y hy i 0
      - christoffel2 h 1 k j y * hSsymm y hy i 1
  have T0 : ∀ y ∈ s, ∀ c : Fin 2,
      ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD2 h S c k l y = 0 := by
    intro y hy c
    rw [← hTr y hy c]
    have hev : gsTrace h S =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hs.mem_nhds hy) (fun z hz => htr z hz)
    unfold pd2
    rw [hev.fderiv_eq]
    simp
  have veq : ∀ y ∈ s, ∀ c : Fin 2,
      ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD2 h S l k c y =
        ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCodazzi h S k c l y := by
    intro y hy c
    have t := T0 y hy c
    simp only [Fin.sum_univ_two] at t
    simp only [gsCodazzi, Fin.sum_univ_two]
    linear_combination -((h y)⁻¹ 0 0) * Dsym y hy 0 c 0 - (h y)⁻¹ 0 1 * Dsym y hy 0 c 1
      - (h y)⁻¹ 1 0 * Dsym y hy 1 c 0 - (h y)⁻¹ 1 1 * Dsym y hy 1 c 1
      + (gsCovD2 h S 1 0 c y - gsCovD2 h S 0 1 c y) * hinvsymm y hy 0 1 + t
  have s3 : gsCovD1 h (fun b' z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * gsCovD2 h S l k b' z)
        a b x =
      gsCovD1 h (fun j' y => ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCodazzi h S k j' l y)
        a b x := by
    have hev : (fun z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * gsCovD2 h S l k b z) =ᶠ[𝓝 x]
        (fun y => ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCodazzi h S k b l y) :=
      Filter.eventually_of_mem (hs.mem_nhds hx) (fun y hy => veq y hy b)
    have e1 : pd2 a (fun z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * gsCovD2 h S l k b z) x =
        pd2 a (fun y => ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCodazzi h S k b l y) x := by
      unfold pd2
      rw [hev.fderiv_eq]
    unfold gsCovD1
    rw [e1]
    simp only [veq x hx]
  
  have hQ : ∀ k l : Fin 2, gsCovD3 h (gsCovD2 h S) l k a b x =
      gsCovD3 h (gsCovD2 h S) a l k b x +
        (-∑ m : Fin 2, gsRiem2 h m l a k x * S m b x - ∑ m : Fin 2, gsRiem2 h m l a b x * S k m x)
        + gsCovD3 h (gsCodazzi h S) l k a b x := by
    intro k l
    have e1 := s1 l k
    have e2 := hRic x hx l a k b
    linarith
  have hsum : ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b x =
      ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * gsCovD3 h (gsCovD2 h S) a l k b x
        + ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l *
          (-∑ m : Fin 2, gsRiem2 h m l a k x * S m b x - ∑ m : Fin 2, gsRiem2 h m l a b x * S k m x)
        + ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * gsCovD3 h (gsCodazzi h S) l k a b x := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [hQ k l]
    ring
  rw [hsum, hCon x hx a b, s2 a b, s3, gsSimonsE]
  ring

theorem gs_simons_intrinsic (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (S : Fin 2 → Fin 2 → E2 → ℝ) (s : Set E2) (hs : IsOpen s) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) s) (hhsymm : ∀ x ∈ s, ∀ i j : Fin 2, h x i j = h x j i) (hhpos : ∀ x ∈ s, (h x).PosDef) (hS : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (S i j) s) (hSsymm : ∀ x ∈ s, ∀ i j : Fin 2, S i j x = S j i x) (htr : ∀ x ∈ s, gsTrace h S x = 0) : ∀ x ∈ s, 4 * gaussCurv2 h x * gsInner h S S x + 2 * gsInner h S (gsSimonsE h (gsCodazzi h S)) x ≤ lap2 h (gsInner h S S) x :=
by
  intro x hx
  
  obtain ⟨hinv, hinvsymm, hΓ, hΓsymm, hcompat, hdinv⟩ :=
    gs2_metric_calculus h s hs hh hhsymm hhpos
  
  obtain ⟨hcov, hinner⟩ := gs2_covd_smooth h s hs hinv hΓ
  have hDS : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (gsCovD2 h S k i j) s := hcov S hS
  have hIn : ∀ j : Fin 2, ContDiffOn ℝ ∞ (gsInner h S (gsCovD2 h S j)) s :=
    fun j => hinner S (gsCovD2 h S j) hS (fun a b => hDS j a b)
  
  have hL1 : ∀ y ∈ s, ∀ k : Fin 2, pd2 k (gsInner h S S) y =
      gsInner h (gsCovD2 h S k) S y + gsInner h S (gsCovD2 h S k) y :=
    gs2_inner_leibniz h s hs hinv hdinv S S hS hS
  have hL2 : ∀ y ∈ s, ∀ j k : Fin 2, pd2 k (gsInner h S (gsCovD2 h S j)) y =
      gsInner h (gsCovD2 h S k) (gsCovD2 h S j) y +
        gsInner h S (gsCovD2 h (gsCovD2 h S j) k) y :=
    fun y hy j k => gs2_inner_leibniz h s hs hinv hdinv S (gsCovD2 h S j) hS
      (fun a b => hDS j a b) y hy k
  
  obtain ⟨hTrGen, hConGen⟩ := gs2_contraction_leibniz h s hs hinv hdinv
  have hTr : ∀ y ∈ s, ∀ b : Fin 2, pd2 b (gsTrace h S) y =
      ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * gsCovD2 h S b k l y := hTrGen S hS
  have hCon : ∀ y ∈ s, ∀ a b : Fin 2, ∑ k : Fin 2, ∑ l : Fin 2,
      (h y)⁻¹ k l * gsCovD3 h (gsCovD2 h S) a l k b y =
        gsCovD1 h (fun b' z => ∑ k : Fin 2, ∑ l : Fin 2, (h z)⁻¹ k l * gsCovD2 h S l k b' z)
          a b y := hConGen (gsCovD2 h S) hDS
  
  have hRic := gs2_ricci_identity h s hs hΓ hΓsymm S hS
  have hRich := gs2_ricci_identity h s hs hΓ hΓsymm (fun i j y => h y i j) (fun i j => hh i j)
  
  have hzero3 : ∀ y ∈ s, ∀ l i k j : Fin 2,
      gsCovD3 h (gsCovD2 h (fun i j y => h y i j)) l i k j y = 0 := by
    intro y hy l i k j
    have hev : gsCovD2 h (fun i j y => h y i j) i k j =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hs.mem_nhds hy) (fun z hz => hcompat z hz i k j)
    have hpd : pd2 l (gsCovD2 h (fun i j y => h y i j) i k j) y = 0 := by
      unfold pd2
      rw [hev.fderiv_eq]
      simp
    rw [gsCovD3, hpd]
    simp [hcompat y hy]
  
  have hK : ∀ y ∈ s, ∀ m l i k : Fin 2, gsRiem2 h m l i k y =
      gaussCurv2 h y * (h y i k * (if m = l then 1 else 0) -
        h y l k * (if m = i then 1 else 0)) := by
    intro y hy
    apply gs2_curvature_2d h y (hhpos y hy)
    intro l i k j
    have e : gsCovD3 h (gsCovD2 h (fun i j y => h y i j)) l i k j y -
        gsCovD3 h (gsCovD2 h (fun i j y => h y i j)) i l k j y =
        -∑ m : Fin 2, gsRiem2 h m l i k y * h y m j -
          ∑ m : Fin 2, gsRiem2 h m l i j y * h y k m := hRich y hy l i k j
    rw [hzero3 y hy l i k j, hzero3 y hy i l k j] at e
    linarith
  
  have hW := gs2_weitzenbock h S s hs hhpos hSsymm htr hinvsymm hDS hRic hK hTr hCon
  
  have hB := gs2_bochner h S s hs hinvsymm hIn hL1 hL2 x hx
  
  have hN := gs2_grad_sq_nonneg h (gsCovD2 h S) x (hhpos x hx)
  
  have hLx : gsInner h S (fun a b y => ∑ k : Fin 2, ∑ l : Fin 2,
        (h y)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b y) x =
      2 * gaussCurv2 h x * gsInner h S S x + gsInner h S (gsSimonsE h (gsCodazzi h S)) x := by
    have e : ∀ a b : Fin 2, (∑ k : Fin 2, ∑ l : Fin 2,
        (h x)⁻¹ k l * gsCovD3 h (gsCovD2 h S) l k a b x) =
        2 * gaussCurv2 h x * S a b x + gsSimonsE h (gsCodazzi h S) a b x := hW x hx
    simp only [gsInner]
    simp only [e]
    simp only [Fin.sum_univ_two]
    ring
  
  rw [hB, hLx]
  linarith

theorem gc_ricci_commute (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (W : E2 → Fin 3 → ℝ) (hW : ∀ c : Fin 3, ContDiffOn ℝ ∞ (fun y => W y c) s) : ∀ x ∈ s, ∀ (k i : Fin 2) (l : Fin 3), gcCovAlong G F (fun y c => gcCovAlong G F W i y c) k x l - gcCovAlong G F (fun y c => gcCovAlong G F W k y c) i x l = ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, riemannLocal G l a b c (F x) * gsTan F k x a * gsTan F i x b * W x c :=
by
  classical
  intro x hx k i l
  have hx' : s ∈ 𝓝 x := hs.mem_nhds hx
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact (((((t1.sub t2).sub t3).add t4).add t5).sub t6).congr
      (fun y _ => Matrix.det_fin_three (H y))
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpos y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hΓU : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  
  have hFd : DifferentiableAt ℝ F x := (hF.contDiffAt hx').differentiableAt (by simp)
  have hD : ContDiffOn ℝ ∞ (fderiv ℝ F) s := ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hF).2
  have hT : ∀ j : Fin 2, ContDiffOn ℝ ∞ (fun y => fderiv ℝ F y (e2 j)) s := fun j =>
    hD.clm_apply (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : E2 => e2 j) s)
  have htan : ∀ (j : Fin 2) (c : Fin 3), ContDiffOn ℝ ∞ (fun y => gsTan F j y c) s := by
    intro j c
    exact ((EuclideanSpace.proj c : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn (hT j)).congr
      (fun y _ => rfl)
  have htanD : ∀ (j k : Fin 2) (c : Fin 3),
      fderiv ℝ (fun y => gsTan F j y c) x (e2 k) = gsHessF F k j x c := by
    intro j k c
    have hφ : DifferentiableAt ℝ (fun y => fderiv ℝ F y (e2 j)) x :=
      ((hT j).contDiffAt hx').differentiableAt (by simp)
    have he : (fun y => gsTan F j y c) =
        (EuclideanSpace.proj c : E3 →L[ℝ] ℝ) ∘ (fun y => fderiv ℝ F y (e2 j)) := rfl
    rw [he, fderiv_comp x (EuclideanSpace.proj c : E3 →L[ℝ] ℝ).differentiableAt hφ,
      ContinuousLinearMap.comp_apply, ContinuousLinearMap.fderiv]
    rfl
  
  have hchain : ∀ g : E3 → ℝ, ContDiffOn ℝ ∞ g U → ∀ j : Fin 2,
      fderiv ℝ (fun y => g (F y)) x (e2 j) = ∑ r : Fin 3, partialDeriv r g (F x) * gsTan F j x r := by
    intro g hg j
    have hgd : DifferentiableAt ℝ g (F x) :=
      (hg.contDiffAt (hU.mem_nhds (hFU x hx))).differentiableAt (by simp)
    rw [show (fun y => g (F y)) = g ∘ F from rfl, fderiv_comp x hgd hFd,
      ContinuousLinearMap.comp_apply]
    have hv : fderiv ℝ F x (e2 j) = ∑ r : Fin 3, (fderiv ℝ F x (e2 j)) r • e r := by
      ext m
      simp [EuclideanSpace.single_apply, Pi.single_apply]
    rw [hv, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_smul, smul_eq_mul, mul_comm]
    simp [partialDeriv, gsTan, EuclideanSpace.single_apply]
  
  have schwarz : ∀ {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (f : E2 → V),
      ContDiffOn ℝ ∞ f s → ∀ a b : Fin 2,
      fderiv ℝ (fun y => fderiv ℝ f y (e2 b)) x (e2 a) =
        fderiv ℝ (fun y => fderiv ℝ f y (e2 a)) x (e2 b) := by
    intro V _ _ f hf a b
    have hc : ContDiffAt ℝ ∞ f x := hf.contDiffAt hx'
    have h2' : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
    have h2 : minSmoothness ℝ 2 ≤ ∞ := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact h2'
    have hsym : IsSymmSndFDerivAt ℝ f x := hc.isSymmSndFDerivAt h2
    have h12 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
      rw [one_add_one_eq_two]
      exact h2'
    have hd : DifferentiableAt ℝ (fderiv ℝ f) x :=
      (hc.fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have key : ∀ a b : Fin 2, fderiv ℝ (fun y => fderiv ℝ f y (e2 b)) x (e2 a) =
        fderiv ℝ (fderiv ℝ f) x (e2 a) (e2 b) := by
      intro a b
      have h3 := fderiv_clm_apply (c := fderiv ℝ f) (u := fun _ : E2 => e2 b) hd
        (differentiableAt_const (e2 b))
      rw [h3]
      simp
    rw [key a b, key b a]
    exact hsym.eq (e2 a) (e2 b)
  
  have key1 : ∀ (k i : Fin 2), pd2 k (fun y => gcCovAlong G F W i y l) x =
      pd2 k (pd2 i (fun y => W y l)) x + ∑ a : Fin 3, ∑ b : Fin 3,
        ((∑ r : Fin 3, partialDeriv r (christoffel G l a b) (F x) * gsTan F k x r) *
            gsTan F i x a * W x b +
          christoffel G l a b (F x) * gsHessF F k i x a * W x b +
          christoffel G l a b (F x) * gsTan F i x a * pd2 k (fun y => W y b) x) := by
    intro k i
    have hθ : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun y' => W y' l) y (e2 i)) s :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 (hW l)).2.clm_apply contDiffOn_const
    have d1 : DifferentiableAt ℝ (fun y => pd2 i (fun y' => W y' l) y) x :=
      (hθ.contDiffAt hx').differentiableAt (by simp)
    have dΓ : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => christoffel G l a b (F y)) x :=
      fun a b => (((hΓU l a b).contDiffAt (hU.mem_nhds (hFU x hx))).differentiableAt
        (by simp)).comp x hFd
    have dT : ∀ a : Fin 3, DifferentiableAt ℝ (fun y => gsTan F i y a) x :=
      fun a => ((htan i a).contDiffAt hx').differentiableAt (by simp)
    have dW : ∀ b : Fin 3, DifferentiableAt ℝ (fun y => W y b) x :=
      fun b => ((hW b).contDiffAt hx').differentiableAt (by simp)
    have dP : ∀ a b : Fin 3, DifferentiableAt ℝ
        (fun y => christoffel G l a b (F y) * gsTan F i y a * W y b) x :=
      fun a b => ((dΓ a b).mul (dT a)).mul (dW b)
    have dS : ∀ a : Fin 3, DifferentiableAt ℝ
        (fun y => ∑ b : Fin 3, christoffel G l a b (F y) * gsTan F i y a * W y b) x :=
      fun a => (DifferentiableAt.sum (u := Finset.univ) fun b _ => dP a b).congr_of_eventuallyEq
        (Filter.Eventually.of_forall fun y => by simp [Finset.sum_apply])
    have dSS : DifferentiableAt ℝ
        (fun y => ∑ a : Fin 3, ∑ b : Fin 3, christoffel G l a b (F y) * gsTan F i y a * W y b) x :=
      (DifferentiableAt.sum (u := Finset.univ) fun a _ => dS a).congr_of_eventuallyEq
        (Filter.Eventually.of_forall fun y => by simp [Finset.sum_apply])
    show fderiv ℝ (fun y => pd2 i (fun y' => W y' l) y +
        ∑ a : Fin 3, ∑ b : Fin 3, christoffel G l a b (F y) * gsTan F i y a * W y b) x (e2 k) = _
    rw [fderiv_fun_add d1 dSS, ContinuousLinearMap.add_apply,
      fderiv_fun_sum (fun a _ => dS a), ContinuousLinearMap.sum_apply]
    congr 1
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [fderiv_fun_sum (fun b _ => dP a b),
      ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [fderiv_fun_mul (show DifferentiableAt ℝ
        (fun y => christoffel G l a b (F y) * gsTan F i y a) x from (dΓ a b).mul (dT a)) (dW b),
      fderiv_fun_mul (dΓ a b) (dT a)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hchain _ (hΓU l a b) k, htanD i k a]
    simp only [pd2]
    ring
  
  have u1 : ∀ k i : Fin 2, gcCovAlong G F (fun y c => gcCovAlong G F W i y c) k x l =
      pd2 k (fun y => gcCovAlong G F W i y l) x + ∑ a : Fin 3, ∑ b : Fin 3,
        christoffel G l a b (F x) * gsTan F k x a * gcCovAlong G F W i x b := fun _ _ => rfl
  have hAB : pd2 k (pd2 i (fun y => W y l)) x = pd2 i (pd2 k (fun y => W y l)) x :=
    schwarz (fun y => W y l) (hW l) k i
  have hHF : gsHessF F k i x = gsHessF F i k x := schwarz F hF k i
  rw [u1 k i, u1 i k, key1 k i, key1 i k, hAB, hHF]
  simp only [gcCovAlong, riemannLocal, Fin.sum_univ_three]
  ring

theorem gc_frame (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (x : E2) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : (G (F x)).PosDef) (hinj : Function.Injective (fderiv ℝ F x)) : 0 < gsNormLen G F x ∧ (∀ m : Fin 2, ∑ c : Fin 3, gsCrossN F x c * gsTan F m x c = 0) ∧ (∀ P : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * gcNu G F x d = (∑ c : Fin 3, gsCrossN F x c * P c) / gsNormLen G F x) ∧ (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcNu G F x c * gcNu G F x d = 1) ∧ (∀ P Q : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * Q d = ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b * (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F a x c * P d) * (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F b x c * Q d) + (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * gcNu G F x d) * (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * Q c * gcNu G F x d)) :=
by
  classical
  
  have hdet : (G (F x)).det ≠ 0 := hGpos.det_pos.ne'
  have hGG : G (F x) * (G (F x))⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet)
  have hR : ∀ c k : Fin 3, ∑ d : Fin 3, G (F x) c d * (G (F x))⁻¹ d k = if c = k then 1 else 0 := by
    intro c k
    have h := congrFun (congrFun hGG c) k
    rw [Matrix.mul_apply, Matrix.one_apply] at h
    exact h
  have key : ∀ X : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * X c *
      (∑ k : Fin 3, (G (F x))⁻¹ d k * gsCrossN F x k) = ∑ c : Fin 3, gsCrossN F x c * X c := by
    intro X
    refine Finset.sum_congr rfl fun c _ => ?_
    have e1 : ∑ d : Fin 3, G (F x) c d * X c * (∑ k : Fin 3, (G (F x))⁻¹ d k * gsCrossN F x k) =
        ∑ k : Fin 3, X c * gsCrossN F x k * (∑ d : Fin 3, G (F x) c d * (G (F x))⁻¹ d k) := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun d _ => ?_
      ring
    rw [e1]
    simp only [hR, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    ring
  
  have crossNe : ∀ (D : E2 →L[ℝ] E3), Function.Injective D →
      ¬ (D (e2 0) 1 * D (e2 1) 2 - D (e2 0) 2 * D (e2 1) 1 = 0 ∧
         D (e2 0) 2 * D (e2 1) 0 - D (e2 0) 0 * D (e2 1) 2 = 0 ∧
         D (e2 0) 0 * D (e2 1) 1 - D (e2 0) 1 * D (e2 1) 0 = 0) := by
    intro D hDi hN
    obtain ⟨n0, n1, n2⟩ := hN
    have hb : D (e2 1) ≠ 0 := by
      intro h0
      have h1 : e2 1 = 0 := hDi (by rw [h0, map_zero])
      have h2 := congrArg (fun v : E2 => v 1) h1
      simp at h2
    apply hb
    have c0 : ∀ m : Fin 3,
        ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
          D (e2 0) - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
            D (e2 0) 2 * D (e2 1) 2) • D (e2 1)) m = (0 : E3) m := by
      have key : ∀ m : Fin 3,
          ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
            D (e2 0) - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) • D (e2 1)) m =
          (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) m - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) m := by
        intro m
        simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      have k0 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 0 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 0 = 0 := by
        linear_combination (D (e2 1) 1) * n2 - (D (e2 1) 2) * n1
      have k1 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 1 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 1 = 0 := by
        linear_combination (D (e2 1) 2) * n0 - (D (e2 1) 0) * n2
      have k2 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 2 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 2 = 0 := by
        linear_combination (D (e2 1) 0) * n1 - (D (e2 1) 1) * n0
      intro m
      rw [key m, PiLp.zero_apply]
      fin_cases m
      · exact k0
      · exact k1
      · exact k2
    have hv : D ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
          e2 0 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
            D (e2 0) 2 * D (e2 1) 2) • e2 1) = D 0 := by
      rw [map_sub, map_smul, map_smul, map_zero]
      exact PiLp.ext c0
    have hv0 := congrArg (fun v : E2 => v 0) (hDi hv)
    simp at hv0
    have s0 := sq_nonneg (D (e2 1) 0)
    have s1 := sq_nonneg (D (e2 1) 1)
    have s2 := sq_nonneg (D (e2 1) 2)
    have z0 : D (e2 1) 0 = 0 := by nlinarith
    have z1 : D (e2 1) 1 = 0 := by nlinarith
    have z2 : D (e2 1) 2 = 0 := by nlinarith
    refine PiLp.ext fun m => ?_
    fin_cases m
    · simpa using z0
    · simpa using z1
    · simpa using z2
  have hNne : gsCrossN F x ≠ 0 := by
    intro hN0
    apply crossNe (fderiv ℝ F x) hinj
    refine ⟨?_, ?_, ?_⟩
    · simpa [gsCrossN, gsTan] using congrFun hN0 0
    · simpa [gsCrossN, gsTan] using congrFun hN0 1
    · simpa [gsCrossN, gsTan] using congrFun hN0 2
  have hq0 : 0 < ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
    have hpos := hGpos.inv.dotProduct_mulVec_pos hNne
    have e : dotProduct (star (gsCrossN F x)) (Matrix.mulVec (G (F x))⁻¹ (gsCrossN F x)) =
        ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Pi.star_apply, star_trivial]
      ring
    rw [← e]
    exact hpos
  obtain ⟨q, hqdef⟩ : ∃ q : ℝ,
      q = ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l :=
    ⟨_, rfl⟩
  have hq : 0 < q := by rw [hqdef]; exact hq0
  have hnpos : 0 < gsNormLen G F x := Real.sqrt_pos.mpr hq0
  have hnn : gsNormLen G F x * gsNormLen G F x = q := by
    rw [hqdef]; exact Real.mul_self_sqrt hq0.le
  
  have htan : ∀ m : Fin 2, ∑ c : Fin 3, gsCrossN F x c * gsTan F m x c = 0 := by
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · simp [gsCrossN, Fin.sum_univ_three]
      ring
    · simp [gsCrossN, Fin.sum_univ_three]
      ring
  
  have hb : ∀ P : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * gcNu G F x d =
      (∑ c : Fin 3, gsCrossN F x c * P c) / gsNormLen G F x := by
    intro P
    rw [← key P, Finset.sum_div]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun d _ => ?_
    simp only [gcNu]
    ring
  
  have hNnu : ∑ c : Fin 3, gsCrossN F x c * gcNu G F x c = q / gsNormLen G F x := by
    rw [hqdef, Finset.sum_div]
    refine Finset.sum_congr rfl fun c _ => ?_
    simp only [gcNu]
    rw [mul_div_assoc', Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  have hd : ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcNu G F x c * gcNu G F x d = 1 := by
    rw [hb (gcNu G F x), hNnu, div_div, hnn, div_self hq.ne']
  
  obtain ⟨ip, hip⟩ : ∃ ip : (Fin 3 → ℝ) → (Fin 3 → ℝ) → ℝ,
      ∀ X Y, ip X Y = ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * X c * Y d := ⟨_, fun _ _ => rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : Fin 2 → Fin 3 → ℝ, ∀ a c, t a c = gsTan F a x c :=
    ⟨fun a c => gsTan F a x c, fun _ _ => rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : Fin 3 → ℝ, ∀ d, w d = ∑ k : Fin 3, (G (F x))⁻¹ d k * gsCrossN F x k :=
    ⟨_, fun _ => rfl⟩
  have hsym : ∀ X Y, ip X Y = ip Y X := by
    intro X Y
    rw [hip, hip, Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    rw [hGsymm (F x) d c]
    ring
  have hNt : gsCrossN F x = ![t 0 1 * t 1 2 - t 0 2 * t 1 1, t 0 2 * t 1 0 - t 0 0 * t 1 2,
      t 0 0 * t 1 1 - t 0 1 * t 1 0] := by
    simp only [ht]
    rfl
  have hA : ∀ Z : Fin 3 → ℝ, (Matrix.of fun c i => ![t 0 c, t 1 c, Z c] i).det =
      ∑ c : Fin 3, gsCrossN F x c * Z c := by
    intro Z
    rw [Matrix.det_fin_three, hNt]
    simp [Fin.sum_univ_three]
    ring
  have gram : ∀ X Y : Fin 3 → ℝ,
      (!![ip (t 0) (t 0), ip (t 0) (t 1), ip (t 0) Y;
          ip (t 1) (t 0), ip (t 1) (t 1), ip (t 1) Y;
          ip X (t 0), ip X (t 1), ip X Y] : Matrix (Fin 3) (Fin 3) ℝ).det =
        (∑ c : Fin 3, gsCrossN F x c * X c) * (G (F x)).det *
          (∑ c : Fin 3, gsCrossN F x c * Y c) := by
    intro X Y
    have hM : (!![ip (t 0) (t 0), ip (t 0) (t 1), ip (t 0) Y;
          ip (t 1) (t 0), ip (t 1) (t 1), ip (t 1) Y;
          ip X (t 0), ip X (t 1), ip X Y] : Matrix (Fin 3) (Fin 3) ℝ) =
        Matrix.transpose (Matrix.of fun c i => ![t 0 c, t 1 c, X c] i) * G (F x) *
          (Matrix.of fun c i => ![t 0 c, t 1 c, Y c] i) := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [Matrix.mul_apply, Fin.sum_univ_three, hip] <;> ring
    rw [hM, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hA, hA]
  have gram' : ∀ X Y : Fin 3 → ℝ,
      ip (t 0) (t 0) * ip (t 1) (t 1) * ip X Y - ip (t 0) (t 0) * ip (t 1) Y * ip X (t 1)
        - ip (t 0) (t 1) * ip (t 1) (t 0) * ip X Y + ip (t 0) (t 1) * ip (t 1) Y * ip X (t 0)
        + ip (t 0) Y * ip (t 1) (t 0) * ip X (t 1) - ip (t 0) Y * ip (t 1) (t 1) * ip X (t 0) =
      (∑ c : Fin 3, gsCrossN F x c * X c) * (G (F x)).det *
          (∑ c : Fin 3, gsCrossN F x c * Y c) := by
    intro X Y
    rw [← gram X Y, Matrix.det_fin_three]
    rfl
  have hipw : ∀ X, ip X w = ∑ c : Fin 3, gsCrossN F x c * X c := by
    intro X
    rw [hip, ← key X]
    simp only [hw]
  have htw : ∀ a : Fin 2, ip (t a) w = 0 := by
    intro a
    rw [hipw]
    simp only [ht]
    exact htan a
  have hNw : ∑ c : Fin 3, gsCrossN F x c * w c = q := by
    rw [hqdef]
    simp only [hw, Finset.mul_sum]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun k _ => ?_
    ring
  have hD : ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0) =
      q * (G (F x)).det := by
    have g := gram' w w
    rw [hsym w (t 0), hsym w (t 1), htw 0, htw 1, hipw w, hNw] at g
    have h2 : (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0)
        - q * (G (F x)).det) * q = 0 := by
      linear_combination g
    rcases mul_eq_zero.mp h2 with h | h
    · linarith
    · exact absurd h hq.ne'
  have hh : ∀ a b : Fin 2, pullMetric2 G F x a b = ip (t a) (t b) := by
    intro a b
    rw [hip]
    simp only [pullMetric2, ht, gsTan]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    ring
  have he : ∀ P Q : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * Q d =
      ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b *
        (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F a x c * P d) *
        (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F b x c * Q d) +
      (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * P c * gcNu G F x d) *
        (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * Q c * gcNu G F x d) := by
    intro P Q
    rw [hb P, hb Q, div_mul_div_comm, hnn, ← hip P Q]
    have eP : ∀ a : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F a x c * P d =
        ip (t a) P := by
      intro a; rw [hip]; simp only [ht]
    have eQ : ∀ a : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F a x c * Q d =
        ip (t a) Q := by
      intro a; rw [hip]; simp only [ht]
    simp only [eP, eQ]
    rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv', Matrix.det_fin_two]
    simp only [Fin.sum_univ_two, Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons, smul_eq_mul, hh]
    have g := gram' P Q
    rw [hsym P (t 0), hsym P (t 1)] at g
    have hDne : ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0) ≠ 0 := by
      rw [hD]; exact mul_ne_zero hq.ne' hdet
    have hu : (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0))⁻¹ *
        (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0)) = 1 :=
      inv_mul_cancel₀ hDne
    have hv : q⁻¹ * q = 1 := inv_mul_cancel₀ hq.ne'
    linear_combination
      (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0))⁻¹ * g +
      (-(ip P Q) + (∑ c : Fin 3, gsCrossN F x c * P c) * (∑ c : Fin 3, gsCrossN F x c * Q c) *
          q⁻¹) * hu +
      (-((∑ c : Fin 3, gsCrossN F x c * P c) * (∑ c : Fin 3, gsCrossN F x c * Q c)) *
          (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0))⁻¹ *
          (G (F x)).det) * hv +
      (-((∑ c : Fin 3, gsCrossN F x c * P c) * (∑ c : Fin 3, gsCrossN F x c * Q c)) *
          (ip (t 0) (t 0) * ip (t 1) (t 1) - ip (t 0) (t 1) * ip (t 1) (t 0))⁻¹ * q⁻¹) * hD
  exact ⟨hnpos, htan, hb, hd, he⟩

theorem gc_jets (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : (∀ (i : Fin 2) (c : Fin 3), ContDiffOn ℝ ∞ (fun y => gsTan F i y c) s) ∧ (∀ y ∈ s, ∀ (k i : Fin 2) (c : Fin 3), pd2 k (fun y' => gsTan F i y' c) y = gsHessF F k i y c) ∧ (∀ y ∈ s, ∀ k i : Fin 2, gsHessF F k i y = gsHessF F i k y) ∧ (∀ (i j : Fin 2) (c : Fin 3), ContDiffOn ℝ ∞ (fun y => gsCovHess G F i j y c) s) ∧ (∀ l : Fin 3, ContDiffOn ℝ ∞ (fun y => gcNu G F y l) s) ∧ (∀ a b c : Fin 3, ContDiffOn ℝ ∞ (christoffel G a b c) U) :=
by
  classical
  have hFU' : Set.MapsTo F s U := fun x hx => hFU x hx
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact (((((t1.sub t2).sub t3).add t4).add t5).sub t6).congr
      (fun y _ => Matrix.det_fin_three (H y))
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpos y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hΓU : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  
  have hD : ContDiffOn ℝ ∞ (fderiv ℝ F) s := ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hF).2
  have hT : ∀ j : Fin 2, ContDiffOn ℝ ∞ (fun x => fderiv ℝ F x (e2 j)) s := fun j =>
    hD.clm_apply (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : E2 => e2 j) s)
  have htan : ∀ (i : Fin 2) (k : Fin 3), ContDiffOn ℝ ∞ (fun x => gsTan F i x k) s := by
    intro i k
    exact ((EuclideanSpace.proj k : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn (hT i)).congr
      (fun x _ => rfl)
  have hT2 : ∀ j : Fin 2, ContDiffOn ℝ ∞ (fderiv ℝ (fun y => fderiv ℝ F y (e2 j))) s :=
    fun j => ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 (hT j)).2
  have hhess : ∀ (i j : Fin 2) (k : Fin 3), ContDiffOn ℝ ∞ (fun x => gsHessF F i j x k) s := by
    intro i j k
    exact ((EuclideanSpace.proj k : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn
      ((hT2 j).clm_apply (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : E2 => e2 i) s))).congr
      (fun x _ => rfl)
  
  have hJ2 : ∀ y ∈ s, ∀ (k i : Fin 2) (c : Fin 3),
      pd2 k (fun y' => gsTan F i y' c) y = gsHessF F k i y c := by
    intro y hy k i c
    have hφ : DifferentiableAt ℝ (fun y' => fderiv ℝ F y' (e2 i)) y :=
      ((hT i).contDiffAt (hs.mem_nhds hy)).differentiableAt (by simp)
    have e1 : (fun y' => gsTan F i y' c) =
        fun y' => (EuclideanSpace.proj c : E3 →L[ℝ] ℝ) (fderiv ℝ F y' (e2 i)) := rfl
    unfold pd2
    rw [e1, fderiv_comp' y (EuclideanSpace.proj c : E3 →L[ℝ] ℝ).differentiableAt hφ,
      ContinuousLinearMap.fderiv]
    rfl
  
  have hHsym : ∀ x ∈ s, ∀ i j : Fin 2, gsHessF F i j x = gsHessF F j i x := by
    intro x hx i j
    have hc : ContDiffAt ℝ ∞ F x := hF.contDiffAt (hs.mem_nhds hx)
    have h2' : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
    have h2 : minSmoothness ℝ 2 ≤ ∞ := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact h2'
    have hsym : IsSymmSndFDerivAt ℝ F x := hc.isSymmSndFDerivAt h2
    have h12 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
      rw [one_add_one_eq_two]
      exact h2'
    have hd : DifferentiableAt ℝ (fderiv ℝ F) x :=
      (hc.fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have key : ∀ a b : Fin 2, gsHessF F a b x = fderiv ℝ (fderiv ℝ F) x (e2 a) (e2 b) := by
      intro a b
      have h3 := fderiv_clm_apply (c := fderiv ℝ F) (u := fun _ : E2 => e2 b) hd
        (differentiableAt_const (e2 b))
      show fderiv ℝ (fun y => fderiv ℝ F y (e2 b)) x (e2 a) = _
      rw [h3]
      simp
    rw [key i j, key j i]
    exact hsym.eq (e2 i) (e2 j)
  
  have crossNe : ∀ (D : E2 →L[ℝ] E3), Function.Injective D →
      ¬ (D (e2 0) 1 * D (e2 1) 2 - D (e2 0) 2 * D (e2 1) 1 = 0 ∧
         D (e2 0) 2 * D (e2 1) 0 - D (e2 0) 0 * D (e2 1) 2 = 0 ∧
         D (e2 0) 0 * D (e2 1) 1 - D (e2 0) 1 * D (e2 1) 0 = 0) := by
    intro D hDi hN
    obtain ⟨n0, n1, n2⟩ := hN
    have hb : D (e2 1) ≠ 0 := by
      intro h0
      have h1 : e2 1 = 0 := hDi (by rw [h0, map_zero])
      have h2 := congrArg (fun v : E2 => v 1) h1
      simp at h2
    apply hb
    have c0 : ∀ m : Fin 3,
        ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
          D (e2 0) - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
            D (e2 0) 2 * D (e2 1) 2) • D (e2 1)) m = (0 : E3) m := by
      have key : ∀ m : Fin 3,
          ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
            D (e2 0) - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) • D (e2 1)) m =
          (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) m - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) m := by
        intro m
        simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      have k0 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 0 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 0 = 0 := by
        linear_combination (D (e2 1) 1) * n2 - (D (e2 1) 2) * n1
      have k1 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 1 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 1 = 0 := by
        linear_combination (D (e2 1) 2) * n0 - (D (e2 1) 0) * n2
      have k2 : (D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) *
            D (e2 0) 2 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
              D (e2 0) 2 * D (e2 1) 2) * D (e2 1) 2 = 0 := by
        linear_combination (D (e2 1) 0) * n1 - (D (e2 1) 1) * n0
      intro m
      rw [key m, PiLp.zero_apply]
      fin_cases m
      · exact k0
      · exact k1
      · exact k2
    have hv : D ((D (e2 1) 0 * D (e2 1) 0 + D (e2 1) 1 * D (e2 1) 1 + D (e2 1) 2 * D (e2 1) 2) •
          e2 0 - (D (e2 0) 0 * D (e2 1) 0 + D (e2 0) 1 * D (e2 1) 1 +
            D (e2 0) 2 * D (e2 1) 2) • e2 1) = D 0 := by
      rw [map_sub, map_smul, map_smul, map_zero]
      exact PiLp.ext c0
    have hv0 := congrArg (fun v : E2 => v 0) (hDi hv)
    simp at hv0
    have s0 := sq_nonneg (D (e2 1) 0)
    have s1 := sq_nonneg (D (e2 1) 1)
    have s2 := sq_nonneg (D (e2 1) 2)
    have z0 : D (e2 1) 0 = 0 := by nlinarith
    have z1 : D (e2 1) 1 = 0 := by nlinarith
    have z2 : D (e2 1) 2 = 0 := by nlinarith
    refine PiLp.ext fun m => ?_
    fin_cases m
    · simpa using z0
    · simpa using z1
    · simpa using z2
  have hq : ∀ x ∈ s,
      0 < ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
    intro x hx
    have hNne : gsCrossN F x ≠ 0 := by
      intro hN0
      apply crossNe (fderiv ℝ F x) (hinj x hx)
      refine ⟨?_, ?_, ?_⟩
      · simpa [gsCrossN, gsTan] using congrFun hN0 0
      · simpa [gsCrossN, gsTan] using congrFun hN0 1
      · simpa [gsCrossN, gsTan] using congrFun hN0 2
    have hpos := (hGpos (F x) (hFU x hx)).inv.dotProduct_mulVec_pos hNne
    have e : dotProduct (star (gsCrossN F x)) (Matrix.mulVec (G (F x))⁻¹ (gsCrossN F x)) =
        ∑ k : Fin 3, ∑ l : Fin 3, (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Pi.star_apply, star_trivial]
      ring
    rw [← e]
    exact hpos
  
  have hinvF : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun x => (G (F x))⁻¹ k l) s :=
    fun k l => (hGi k l).comp hF hFU'
  have hchrF : ∀ k m n : Fin 3, ContDiffOn ℝ ∞ (fun x => christoffel G k m n (F x)) s :=
    fun k m n => (hΓU k m n).comp hF hFU'
  have hN : ∀ k : Fin 3, ContDiffOn ℝ ∞ (fun x => gsCrossN F x k) s := by
    intro k
    fin_cases k
    · exact (((htan 0 1).mul (htan 1 2)).sub ((htan 0 2).mul (htan 1 1))).congr
        (fun x _ => rfl)
    · exact (((htan 0 2).mul (htan 1 0)).sub ((htan 0 0).mul (htan 1 2))).congr
        (fun x _ => rfl)
    · exact (((htan 0 0).mul (htan 1 1)).sub ((htan 0 1).mul (htan 1 0))).congr
        (fun x _ => rfl)
  have hCov : ∀ (i j : Fin 2) (k : Fin 3),
      ContDiffOn ℝ ∞ (fun x => gsCovHess G F i j x k) s := fun i j k =>
    ((hhess i j k).add (ContDiffOn.sum fun m _ => ContDiffOn.sum fun n _ =>
      ((hchrF k m n).mul (htan i m)).mul (htan j n))).congr (fun x _ => rfl)
  have hQ : ContDiffOn ℝ ∞ (fun x => ∑ k : Fin 3, ∑ l : Fin 3,
      (G (F x))⁻¹ k l * gsCrossN F x k * gsCrossN F x l) s :=
    ContDiffOn.sum fun k _ => ContDiffOn.sum fun l _ => ((hinvF k l).mul (hN k)).mul (hN l)
  have hLen : ContDiffOn ℝ ∞ (gsNormLen G F) s :=
    (hQ.sqrt (fun x hx => (hq x hx).ne')).congr (fun x _ => rfl)
  have hLen0 : ∀ x ∈ s, gsNormLen G F x ≠ 0 := fun x hx => (Real.sqrt_pos.mpr (hq x hx)).ne'
  have hNu : ∀ l : Fin 3, ContDiffOn ℝ ∞ (fun y => gcNu G F y l) s := fun l =>
    ((ContDiffOn.sum fun k _ => (hinvF l k).mul (hN k)).div hLen hLen0).congr (fun x _ => rfl)
  exact ⟨htan, hJ2, fun y hy k i => hHsym y hy k i, hCov, hNu, hΓU⟩

theorem gc_metric_compat (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (V W : E2 → Fin 3 → ℝ) (x : E2) (hx : x ∈ s) (hV : ∀ c : Fin 3, DifferentiableAt ℝ (fun y => V y c) x) (hW : ∀ c : Fin 3, DifferentiableAt ℝ (fun y => W y c) x) (k : Fin 2) : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * V y c * W y d) x = ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcCovAlong G F V k x c * W x d + ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * V x c * gcCovAlong G F W k x d :=
by
  classical
  have hx' : s ∈ 𝓝 x := hs.mem_nhds hx
  have hFd : DifferentiableAt ℝ F x := (hF.contDiffAt hx').differentiableAt (by simp)
  have hGd : ∀ c d : Fin 3, DifferentiableAt ℝ (fun z => G z c d) (F x) := fun c d =>
    ((hG c d).contDiffAt (hU.mem_nhds (hFU x hx))).differentiableAt (by simp)
  have hA : ∀ c d : Fin 3, DifferentiableAt ℝ (fun y => G (F y) c d) x := fun c d =>
    (hGd c d).comp x hFd
  
  have hchain : ∀ c d : Fin 3, pd2 k (fun y => G (F y) c d) x =
      ∑ r : Fin 3, partialDeriv r (fun z => G z c d) (F x) * gsTan F k x r := by
    intro c d
    show fderiv ℝ (fun y => G (F y) c d) x (e2 k) = _
    rw [show (fun y => G (F y) c d) = (fun z => G z c d) ∘ F from rfl,
      fderiv_comp x (hGd c d) hFd, ContinuousLinearMap.comp_apply]
    have hv : fderiv ℝ F x (e2 k) = ∑ r : Fin 3, (fderiv ℝ F x (e2 k)) r • e r := by
      ext m
      simp [EuclideanSpace.single_apply, Pi.single_apply]
    rw [hv, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_smul, smul_eq_mul, mul_comm]
    simp [partialDeriv, gsTan, EuclideanSpace.single_apply]
  
  have hprod : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * V y c * W y d) x =
      ∑ c : Fin 3, ∑ d : Fin 3, (pd2 k (fun y => G (F y) c d) x * V x c * W x d +
        G (F x) c d * pd2 k (fun y => V y c) x * W x d +
        G (F x) c d * V x c * pd2 k (fun y => W y d) x) := by
    have dP : ∀ c d : Fin 3, DifferentiableAt ℝ (fun y => G (F y) c d * V y c * W y d) x :=
      fun c d => ((hA c d).mul (hV c)).mul (hW d)
    have dS : ∀ c : Fin 3,
        DifferentiableAt ℝ (fun y => ∑ d : Fin 3, G (F y) c d * V y c * W y d) x :=
      fun c => (DifferentiableAt.sum (u := Finset.univ) fun d _ => dP c d).congr_of_eventuallyEq
        (Filter.Eventually.of_forall fun y => by simp [Finset.sum_apply])
    unfold pd2
    rw [fderiv_fun_sum (fun c _ => dS c), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [fderiv_fun_sum (fun d _ => dP c d), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [fderiv_fun_mul (show DifferentiableAt ℝ (fun y => G (F y) c d * V y c) x from
        (hA c d).mul (hV c)) (hW d), fderiv_fun_mul (hA c d) (hV c)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hdet : IsUnit (G (F x)).det :=
    isUnit_iff_ne_zero.mpr (hGpos _ (hFU x hx)).det_pos.ne'
  have hmul : G (F x) * (G (F x))⁻¹ = 1 := Matrix.mul_nonsing_inv _ hdet
  have hL : ∀ d a b : Fin 3, ∑ c : Fin 3, G (F x) d c * christoffel G c a b (F x) =
      1 / 2 * (partialDeriv a (fun z => G z b d) (F x) + partialDeriv b (fun z => G z a d) (F x)
        - partialDeriv d (fun z => G z a b) (F x)) := by
    intro d a b
    have e : ∀ l : Fin 3, ∑ c : Fin 3, G (F x) d c * (G (F x))⁻¹ c l =
        if d = l then 1 else 0 := by
      intro l
      have := congrFun (congrFun hmul d) l
      rwa [Matrix.mul_apply, Matrix.one_apply] at this
    have hr : ∑ c : Fin 3, G (F x) d c * christoffel G c a b (F x) =
        1 / 2 * ∑ l : Fin 3, (∑ c : Fin 3, G (F x) d c * (G (F x))⁻¹ c l) *
          (partialDeriv a (fun z => G z b l) (F x) + partialDeriv b (fun z => G z a l) (F x)
            - partialDeriv l (fun z => G z a b) (F x)) := by
      simp only [christoffel, Fin.sum_univ_three]
      ring
    rw [hr]
    simp only [e, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  have hL1 : ∀ d a b : Fin 3, ∑ c : Fin 3, G (F x) c d * christoffel G c a b (F x) =
      1 / 2 * (partialDeriv a (fun z => G z b d) (F x) + partialDeriv b (fun z => G z a d) (F x)
        - partialDeriv d (fun z => G z a b) (F x)) := by
    intro d a b
    rw [← hL d a b]
    exact Finset.sum_congr rfl fun c _ => by rw [hGsymm (F x) c d]
  have hdG : ∀ r a b : Fin 3, partialDeriv r (fun z => G z a b) (F x) =
      partialDeriv r (fun z => G z b a) (F x) := by
    intro r a b
    rw [show (fun z => G z a b) = (fun z => G z b a) from funext fun z => hGsymm z a b]
  
  have alg : ∀ (Gm : Matrix (Fin 3) (Fin 3) ℝ) (Γ dG : Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ r a b : Fin 3, dG r a b = dG r b a) →
      (∀ d a b : Fin 3, ∑ c : Fin 3, Gm c d * Γ c a b = 1 / 2 * (dG a b d + dG b a d - dG d a b)) →
      (∀ c a b : Fin 3, ∑ d : Fin 3, Gm c d * Γ d a b = 1 / 2 * (dG a b c + dG b a c - dG c a b)) →
      ∀ t v w pv pw : Fin 3 → ℝ,
      ∑ c : Fin 3, ∑ d : Fin 3, ((∑ r : Fin 3, dG r c d * t r) * v c * w d + Gm c d * pv c * w d +
          Gm c d * v c * pw d) =
        ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * (pv c + ∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * t a * v b) *
            w d +
          ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * v c *
            (pw d + ∑ a : Fin 3, ∑ b : Fin 3, Γ d a b * t a * w b) := by
    intro Gm Γ dG hdG' hL1' hL2' t v w pv pw
    have R1 : ∑ c : Fin 3, ∑ d : Fin 3,
        Gm c d * (pv c + ∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * t a * v b) * w d =
        ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * pv c * w d +
          ∑ d : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, (∑ c : Fin 3, Gm c d * Γ c a b) * t a * v b) *
            w d := by
      simp only [Fin.sum_univ_three]; ring
    have R2 : ∑ c : Fin 3, ∑ d : Fin 3,
        Gm c d * v c * (pw d + ∑ a : Fin 3, ∑ b : Fin 3, Γ d a b * t a * w b) =
        ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * v c * pw d +
          ∑ c : Fin 3, v c *
            (∑ a : Fin 3, ∑ b : Fin 3, (∑ d : Fin 3, Gm c d * Γ d a b) * t a * w b) := by
      simp only [Fin.sum_univ_three]; ring
    rw [R1, R2]
    simp only [hL1', hL2']
    simp only [Fin.sum_univ_three]
    simp only [hdG' 0 1 0, hdG' 1 1 0, hdG' 2 1 0, hdG' 0 2 0, hdG' 1 2 0, hdG' 2 2 0,
      hdG' 0 2 1, hdG' 1 2 1, hdG' 2 2 1]
    ring
  rw [hprod]
  simp only [hchain, gcCovAlong]
  exact alg (G (F x)) (fun c a b => christoffel G c a b (F x))
    (fun r a b => partialDeriv r (fun z => G z a b) (F x)) hdG hL1 (fun c a b => hL c a b)
    (fun a => gsTan F k x a) (fun c => V x c) (fun d => W x d)
    (fun c => pd2 k (fun y => V y c) x) (fun d => pd2 k (fun y => W y d) x)

theorem gc_koszul (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, ∀ i j m : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsCovHess G F i j x c * gsTan F m x d = ∑ p : Fin 2, christoffel2 (pullMetric2 G F) p i j x * pullMetric2 G F x p m :=
by
  intro x hx i j
  have R := gs_regularity G U hU hG hGsymm hGpos F s hs hF hFU hinj
  have hsym := R.2.1 x hx
  have hpos := R.2.2.1 x hx
  
  have hL : ∀ m : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsCovHess G F i j x c *
      gsTan F m x d = ggeGam1 (pullMetric2 G F) m i j x := by
    intro m
    rw [gge_koszul_tangent G U hU hG hGsymm hGpos F s hs hF hFU x hx m i j, Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    rw [hGsymm (F x) d c]
    ring
  
  have hC : ∀ p : Fin 2, christoffel2 (pullMetric2 G F) p i j x =
      ∑ l : Fin 2, (pullMetric2 G F x)⁻¹ p l * ggeGam1 (pullMetric2 G F) l i j x := by
    intro p
    simp only [christoffel2, ggeGam1, Fin.sum_univ_two]
    ring
  
  have hh : pullMetric2 G F x * (pullMetric2 G F x)⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hpos.det_pos.ne')
  have e : ∀ a b : Fin 2, ∑ q : Fin 2, pullMetric2 G F x a q * (pullMetric2 G F x)⁻¹ q b =
      if a = b then 1 else 0 := by
    intro a b
    have := congrFun (congrFun hh a) b
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  have e00 := e 0 0
  have e01 := e 0 1
  have e10 := e 1 0
  have e11 := e 1 1
  simp only [Fin.sum_univ_two, if_true, Fin.isValue] at e00 e01 e10 e11
  norm_num at e00 e01 e10 e11
  have s10 := hsym 1 0
  
  intro m
  rw [hL m]
  simp only [hC, Fin.sum_univ_two]
  revert m
  rw [Fin.forall_fin_two]
  constructor
  · linear_combination (-ggeGam1 (pullMetric2 G F) 0 i j x) * e00 +
      (-ggeGam1 (pullMetric2 G F) 1 i j x) * e01 +
      (-((pullMetric2 G F x)⁻¹ 1 0 * ggeGam1 (pullMetric2 G F) 0 i j x +
        (pullMetric2 G F x)⁻¹ 1 1 * ggeGam1 (pullMetric2 G F) 1 i j x)) * s10
  · linear_combination (-ggeGam1 (pullMetric2 G F) 0 i j x) * e10 +
      (-ggeGam1 (pullMetric2 G F) 1 i j x) * e11 +
      ((pullMetric2 G F x)⁻¹ 0 0 * ggeGam1 (pullMetric2 G F) 0 i j x +
        (pullMetric2 G F x)⁻¹ 0 1 * ggeGam1 (pullMetric2 G F) 1 i j x) * s10

theorem gc_weingarten (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, ∀ k : Fin 2, (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcCovAlong G F (gcNu G F) k x c * gcNu G F x d = 0) ∧ (∀ m : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F m x c * gcCovAlong G F (gcNu G F) k x d = -gsSff G F k m x) :=
by
  intro x hx k
  obtain ⟨J1, J2, -, -, J5, -⟩ := gc_jets G U hU hG hGsymm hGpos F s hs hF hFU hinj
  have hdiff : ∀ φ : E2 → ℝ, ContDiffOn ℝ ∞ φ s → DifferentiableAt ℝ φ x := fun φ h =>
    (h.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hx)
  have hνd : ∀ c : Fin 3, DifferentiableAt ℝ (fun y => gcNu G F y c) x := fun c => hdiff _ (J5 c)
  have htd : ∀ (m : Fin 2) (c : Fin 3), DifferentiableAt ℝ (fun y => gsTan F m y c) x :=
    fun m c => hdiff _ (J1 m c)
  have hSW : ∀ u v : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * u c * v d =
      ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * v c * u d := by
    intro u v
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    rw [hGsymm (F x) d c]
    ring
  have hfx := gc_frame G F x hGsymm (hGpos _ (hFU x hx)) (hinj x hx)
  refine ⟨?_, fun m => ?_⟩
  · 
    have h1 : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
        G (F y) c d * gcNu G F y c * gcNu G F y d) x = 0 := by
      have hev : (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
          G (F y) c d * gcNu G F y c * gcNu G F y d) =ᶠ[𝓝 x] (fun _ => (1 : ℝ)) :=
        Filter.eventually_of_mem (hs.mem_nhds hx) (fun y hy =>
          (gc_frame G F y hGsymm (hGpos _ (hFU y hy)) (hinj y hy)).2.2.2.1)
      unfold pd2
      rw [hev.fderiv_eq]
      simp
    have hpr : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
        G (F y) c d * gcNu G F y c * gcNu G F y d) x =
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcCovAlong G F (gcNu G F) k x c * gcNu G F x d +
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcNu G F x c * gcCovAlong G F (gcNu G F) k x d :=
      gc_metric_compat G U hU hG hGsymm hGpos F s hs hF hFU (gcNu G F) (gcNu G F) x hx hνd hνd k
    have hB : ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcNu G F x c *
        gcCovAlong G F (gcNu G F) k x d =
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcCovAlong G F (gcNu G F) k x c *
        gcNu G F x d :=
      hSW (gcNu G F x) (fun d => gcCovAlong G F (gcNu G F) k x d)
    linarith
  · 
    have h2 : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
        G (F y) c d * gsTan F m y c * gcNu G F y d) x = 0 := by
      have hev : (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
          G (F y) c d * gsTan F m y c * gcNu G F y d) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) := by
        refine Filter.eventually_of_mem (hs.mem_nhds hx) (fun y hy => ?_)
        have fr := gc_frame G F y hGsymm (hGpos _ (hFU y hy)) (hinj y hy)
        show ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * gsTan F m y c * gcNu G F y d = 0
        rw [show ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * gsTan F m y c * gcNu G F y d =
            (∑ c : Fin 3, gsCrossN F y c * gsTan F m y c) / gsNormLen G F y from
            fr.2.2.1 (fun c => gsTan F m y c), fr.2.1 m, zero_div]
      unfold pd2
      rw [hev.fderiv_eq]
      simp
    have hpr : pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
        G (F y) c d * gsTan F m y c * gcNu G F y d) x =
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
          gcCovAlong G F (fun y c' => gsTan F m y c') k x c * gcNu G F x d +
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F m x c *
          gcCovAlong G F (gcNu G F) k x d :=
      gc_metric_compat G U hU hG hGsymm hGpos F s hs hF hFU (fun y c' => gsTan F m y c')
        (gcNu G F) x hx (htd m) hνd k
    have hDt : ∀ c : Fin 3, gcCovAlong G F (fun y c' => gsTan F m y c') k x c =
        gsCovHess G F k m x c := by
      intro c
      unfold gcCovAlong gsCovHess
      rw [J2 x hx k m c]
    have hA : ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
        gcCovAlong G F (fun y c' => gsTan F m y c') k x c * gcNu G F x d = gsSff G F k m x := by
      simp only [hDt]
      exact hfx.2.2.1 (fun c => gsCovHess G F k m x c)
    linarith

theorem gc_dII (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, ∀ k i j : Fin 2, pd2 k (gsSff G F i j) x = ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gcCovAlong G F (fun y c' => gsCovHess G F i j y c') k x c * gcNu G F x d - ∑ p : Fin 2, christoffel2 (pullMetric2 G F) p i j x * gsSff G F k p x :=
by
  intro x hx k i j
  obtain ⟨-, -, -, J4, J5, -⟩ := gc_jets G U hU hG hGsymm hGpos F s hs hF hFU hinj
  
  have hloc : gsSff G F i j =ᶠ[𝓝 x] (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
      G (F y) c d * gsCovHess G F i j y c * gcNu G F y d) := by
    filter_upwards [hs.mem_nhds hx] with y hy
    rw [(gc_frame G F y hGsymm (hGpos _ (hFU y hy)) (hinj y hy)).2.2.1
      (fun c => gsCovHess G F i j y c)]
    rfl
  have hA : pd2 k (gsSff G F i j) x = pd2 k (fun y => ∑ c : Fin 3, ∑ d : Fin 3,
      G (F y) c d * gsCovHess G F i j y c * gcNu G F y d) x := by
    unfold pd2
    rw [hloc.fderiv_eq]
  
  have hdiff : ∀ φ : E2 → ℝ, ContDiffOn ℝ ∞ φ s → DifferentiableAt ℝ φ x := fun φ h =>
    (h.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hx)
  have hB := gc_metric_compat G U hU hG hGsymm hGpos F s hs hF hFU
    (fun y c => gsCovHess G F i j y c) (gcNu G F) x hx
    (fun c => hdiff _ (J4 i j c)) (fun c => hdiff _ (J5 c)) k
  rw [hA, hB]
  
  obtain ⟨-, -, -, -, hpars⟩ := gc_frame G F x hGsymm (hGpos _ (hFU x hx)) (hinj x hx)
  have hT2 := hpars (fun c => gsCovHess G F i j x c) (fun d => gcCovAlong G F (gcNu G F) k x d)
  obtain ⟨hW1, hW2⟩ := gc_weingarten G U hU hG hGsymm hGpos F s hs hF hFU hinj x hx k
  have hSW : ∀ u v : Fin 3 → ℝ, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * u c * v d =
      ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * v c * u d := by
    intro u v
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    rw [hGsymm (F x) d c]
    ring
  have hK : ∀ a : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * gsTan F a x c *
      gsCovHess G F i j x d = ∑ p : Fin 2, christoffel2 (pullMetric2 G F) p i j x *
        pullMetric2 G F x p a := by
    intro a
    rw [hSW (fun c => gsTan F a x c) (fun d => gsCovHess G F i j x d)]
    exact gc_koszul G U hU hG hGsymm hGpos F s hs hF hFU hinj x hx i j a
  simp only [hK, hW2, hW1, mul_zero, add_zero] at hT2
  rw [hT2]
  
  have hpos := (gs_regularity G U hU hG hGsymm hGpos F s hs hF hFU hinj).2.2.1 x hx
  have hh : pullMetric2 G F x * (pullMetric2 G F x)⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hpos.det_pos.ne')
  have e : ∀ p b : Fin 2, ∑ a : Fin 2, pullMetric2 G F x p a * (pullMetric2 G F x)⁻¹ a b =
      if p = b then 1 else 0 := by
    intro p b
    have := congrFun (congrFun hh p) b
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  have e00 := e 0 0
  have e01 := e 0 1
  have e10 := e 1 0
  have e11 := e 1 1
  simp only [Fin.sum_univ_two, if_true, Fin.isValue] at e00 e01 e10 e11
  norm_num at e00 e01 e10 e11
  simp only [Fin.sum_univ_two]
  linear_combination
    (-(christoffel2 (pullMetric2 G F) 0 i j x * gsSff G F k 0 x)) * e00 +
    (-(christoffel2 (pullMetric2 G F) 0 i j x * gsSff G F k 1 x)) * e01 +
    (-(christoffel2 (pullMetric2 G F) 1 i j x * gsSff G F k 0 x)) * e10 +
    (-(christoffel2 (pullMetric2 G F) 1 i j x * gsSff G F k 1 x)) * e11

theorem gs_codazzi (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, ∀ k i j : Fin 2, gsCodazzi (pullMetric2 G F) (gsSff G F) k i j x = gsAmbCod G F k i j x :=
by
  intro x hx k i j
  obtain ⟨g1, g2, -, -, -, -⟩ := gc_jets G U hU hG hGsymm hGpos F s hs hF hFU hinj
  have hframe := gc_frame G F x hGsymm (hGpos _ (hFU x hx)) (hinj x hx)
  
  have hsym : ∀ (z : E2) (a b : Fin 2), pullMetric2 G F z a b = pullMetric2 G F z b a := by
    intro z a b
    simp only [pullMetric2]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
    rw [hGsymm (F z) q p]
    ring
  have hfun : (fun z => pullMetric2 G F z k i) = (fun z => pullMetric2 G F z i k) :=
    funext fun z => hsym z k i
  have hΓ2 : ∀ m : Fin 2, christoffel2 (pullMetric2 G F) m k i x =
      christoffel2 (pullMetric2 G F) m i k x := by
    intro m
    unfold christoffel2
    rw [hfun]
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  
  have hlocal : ∀ (V V' : E2 → Fin 3 → ℝ), (∀ y ∈ s, ∀ c : Fin 3, V y c = V' y c) →
      ∀ (c' : Fin 2) (l : Fin 3), gcCovAlong G F V c' x l = gcCovAlong G F V' c' x l := by
    intro V V' hV c' l
    have hev : (fun y => V y l) =ᶠ[𝓝 x] (fun y => V' y l) :=
      Filter.eventually_of_mem (hs.mem_nhds hx) (fun y hy => hV y hy l)
    unfold gcCovAlong pd2
    rw [hev.fderiv_eq]
    simp only [hV x hx]
  have htC : ∀ a b : Fin 2, ∀ y ∈ s, ∀ c : Fin 3,
      gcCovAlong G F (fun y' c'' => gsTan F b y' c'') a y c = gsCovHess G F a b y c := by
    intro a b y hy c
    unfold gcCovAlong gsCovHess
    rw [g2 y hy a b c]
  
  have hric := gc_ricci_commute G U hU hG hGpos F s hs hF hFU
    (fun y c => gsTan F j y c) (g1 j) x hx k i
  have hcov : ∀ l : Fin 3,
      gcCovAlong G F (fun y c' => gsCovHess G F i j y c') k x l -
        gcCovAlong G F (fun y c' => gsCovHess G F k j y c') i x l =
      ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3,
        riemannLocal G l a b c (F x) * gsTan F k x a * gsTan F i x b * gsTan F j x c := by
    intro l
    rw [← hlocal _ _ (htC i j) k l, ← hlocal _ _ (htC k j) i l]
    exact hric l
  
  have hd1 := gc_dII G U hU hG hGsymm hGpos F s hs hF hFU hinj x hx k i j
  have hd2 := gc_dII G U hU hG hGsymm hGpos F s hs hF hFU hinj x hx i k j
  
  have hcod : gsCodazzi (pullMetric2 G F) (gsSff G F) k i j x =
      (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
          gcCovAlong G F (fun y c' => gsCovHess G F i j y c') k x c * gcNu G F x d) -
        ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
          gcCovAlong G F (fun y c' => gsCovHess G F k j y c') i x c * gcNu G F x d := by
    simp only [gsCodazzi, gsCovD2]
    rw [hd1, hd2]
    simp only [hΓ2]
    ring
  
  have hdiff : (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
          gcCovAlong G F (fun y c' => gsCovHess G F i j y c') k x c * gcNu G F x d) -
        (∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
          gcCovAlong G F (fun y c' => gsCovHess G F k j y c') i x c * gcNu G F x d) =
      ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d *
        (∑ a : Fin 3, ∑ b : Fin 3, ∑ e : Fin 3,
          riemannLocal G c a b e (F x) * gsTan F k x a * gsTan F i x b * gsTan F j x e) *
        gcNu G F x d := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [← hcov c]
    ring
  rw [hcod, hdiff, hframe.2.2.1]
  unfold gsAmbCod
  congr 1
  simp only [Finset.mul_sum, mul_assoc]

theorem gsr_curv_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U) : (∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) ∧ ∀ a b c m : Fin 3, ContDiffOn ℝ ∞ (gsrRm G a b c m) U :=
by
  have hP : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c f) U := by
    intro f hf c
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) U := hf.fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGinv k l).mul (((hP _ (hG j l) i).add (hP _ (hG i l) j)).sub (hP _ (hG i j) l)))
  have hRiem : ∀ l i j k : Fin 3, ContDiffOn ℝ ∞ (riemannLocal G l i j k) U := by
    intro l i j k
    unfold riemannLocal
    exact ((hP _ (hΓ l j k) i).sub (hP _ (hΓ l i k) j)).add (ContDiffOn.sum fun p _ =>
      ((hΓ l i p).mul (hΓ p j k)).sub ((hΓ l j p).mul (hΓ p i k)))
  have hRm : ∀ a b c m : Fin 3, ContDiffOn ℝ ∞ (gsrRm G a b c m) U := by
    intro a b c m
    unfold gsrRm
    exact ContDiffOn.sum fun l _ => (hG m l).mul (hRiem l a b c)
  exact ⟨hΓ, hRm⟩

theorem gsr_curv_bounds (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpos : ∀ y ∈ U, (G y).PosDef) (hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) (hRm : ∀ a b c m : Fin 3, ContDiffOn ℝ ∞ (gsrRm G a b c m) U) (B : Set E3) (hB : IsCompact B) (hBU : B ⊆ U) : ∃ A₀ A₁ : ℝ, 0 ≤ A₀ ∧ 0 ≤ A₁ ∧ ∀ y ∈ B, (∀ X Y Z W : Fin 3 → ℝ, ∑ a : Fin 3, ∑ b : Fin 3, X a * G y a b * X b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Y a * G y a b * Y b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Z a * G y a b * Z b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, W a * G y a b * W b ≤ 1 → |gsrF4 (fun a b c m => gsrRm G a b c m y) X Y Z W| ≤ A₀) ∧ (∀ V X Y Z W : Fin 3 → ℝ, ∑ a : Fin 3, ∑ b : Fin 3, V a * G y a b * V b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, X a * G y a b * X b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Y a * G y a b * Y b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Z a * G y a b * Z b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, W a * G y a b * W b ≤ 1 → |gsrF5 (fun r a b c m => gsrDRm G r a b c m y) V X Y Z W| ≤ A₁) :=
by
  
  obtain ⟨μ, hμ, hcoer⟩ : ∃ μ : ℝ, 0 < μ ∧ ∀ y ∈ B, ∀ v : Fin 3 → ℝ,
      μ * ‖v‖ ^ 2 ≤ ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b := by
    rcases B.eq_empty_or_nonempty with hBe | hBne
    · exact ⟨1, one_pos, fun y hy => by simp [hBe] at hy⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : E3 × (Fin 3 → ℝ) → ℝ, ∀ p, φ p = ∑ a : Fin 3, ∑ b : Fin 3,
        p.2 a * G p.1 a b * p.2 b := ⟨_, fun p => rfl⟩
    have hK : IsCompact (B ×ˢ Metric.sphere (0 : Fin 3 → ℝ) 1) :=
      hB.prod (isCompact_sphere 0 1)
    have hKne : (B ×ˢ Metric.sphere (0 : Fin 3 → ℝ) 1).Nonempty :=
      hBne.prod (NormedSpace.sphere_nonempty.mpr zero_le_one)
    have hφc : ContinuousOn φ (B ×ˢ Metric.sphere (0 : Fin 3 → ℝ) 1) := by
      have hφ' : φ = fun p => ∑ a : Fin 3, ∑ b : Fin 3, p.2 a * G p.1 a b * p.2 b := funext hφ
      rw [hφ']
      have hc2 : ∀ a : Fin 3, Continuous (fun p : E3 × (Fin 3 → ℝ) => p.2 a) := fun a =>
        (continuous_apply a).comp continuous_snd
      have hc1 : ∀ a b : Fin 3, ContinuousOn (fun p : E3 × (Fin 3 → ℝ) => G p.1 a b)
          (B ×ˢ Metric.sphere (0 : Fin 3 → ℝ) 1) := fun a b =>
        ((hG a b).continuousOn.mono hBU).comp continuous_fst.continuousOn (fun p hp => hp.1)
      apply continuousOn_finset_sum
      intro a _
      apply continuousOn_finset_sum
      intro b _
      exact (((hc2 a).continuousOn).mul (hc1 a b)).mul (hc2 b).continuousOn
    obtain ⟨p₀, hp₀K, hp₀min⟩ := hK.exists_isMinOn hKne hφc
    refine ⟨φ p₀, ?_, ?_⟩
    · obtain ⟨hy₀, hv₀⟩ := hp₀K
      have hv0 : p₀.2 ≠ 0 := by
        intro h
        rw [Metric.mem_sphere, h, dist_self] at hv₀
        norm_num at hv₀
      have hpos := (hGpos p₀.1 (hBU hy₀)).dotProduct_mulVec_pos hv0
      have e2 : φ p₀ = star p₀.2 ⬝ᵥ ((G p₀.1).mulVec p₀.2) := by
        rw [hφ]
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
        ring
      rw [e2]
      exact hpos
    · intro y hy v
      by_cases hv : v = 0
      · subst hv
        simp
      · have hr : 0 < ‖v‖ := norm_pos_iff.mpr hv
        have hu : ‖v‖⁻¹ • v ∈ Metric.sphere (0 : Fin 3 → ℝ) 1 := by
          rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hr.ne']
        have hmin : φ p₀ ≤ φ (y, ‖v‖⁻¹ • v) := isMinOn_iff.1 hp₀min _ ⟨hy, hu⟩
        have hφu : φ (y, ‖v‖⁻¹ • v) = (‖v‖⁻¹) ^ 2 *
            ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b := by
          rw [hφ]
          simp only [Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
          ring
        rw [hφu] at hmin
        have hr2 : 0 < ‖v‖ ^ 2 := by positivity
        have := mul_le_mul_of_nonneg_left hmin hr2.le
        have e3 : ‖v‖ ^ 2 * ((‖v‖⁻¹) ^ 2 * ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b) =
            ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b := by
          rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ hr.ne', one_pow, one_mul]
        rw [e3] at this
        linarith
  
  obtain ⟨κ, hκ, hvec⟩ : ∃ κ : ℝ, 0 ≤ κ ∧ ∀ y ∈ B, ∀ v : Fin 3 → ℝ,
      ∑ a : Fin 3, ∑ b : Fin 3, v a * G y a b * v b ≤ 1 → ∀ a : Fin 3, |v a| ≤ κ := by
    refine ⟨Real.sqrt (1 / μ), Real.sqrt_nonneg _, ?_⟩
    intro y hy v hv a
    apply Real.abs_le_sqrt
    have h1 : μ * ‖v‖ ^ 2 ≤ 1 := (hcoer y hy v).trans hv
    have h2 : ‖v‖ ^ 2 ≤ 1 / μ := by
      rw [le_div_iff₀ hμ]
      linarith
    have h3 : |v a| ≤ ‖v‖ := by
      rw [← Real.norm_eq_abs]
      exact norm_le_pi_norm v a
    have h4 : |v a| ^ 2 ≤ ‖v‖ ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h3 2
    rw [sq_abs] at h4
    linarith
  
  have hRc : ∀ a b c m : Fin 3, ContinuousOn (gsrRm G a b c m) U :=
    fun a b c m => (hRm a b c m).continuousOn
  have hΓc : ∀ k i j : Fin 3, ContinuousOn (christoffel G k i j) U :=
    fun k i j => (hΓ k i j).continuousOn
  have hdRc : ∀ r a b c m : Fin 3, ContinuousOn (partialDeriv r (gsrRm G a b c m)) U := by
    intro r a b c m
    show ContinuousOn (fun y => fderiv ℝ (gsrRm G a b c m) y (e r)) U
    exact ((hRm a b c m).continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
  have hDc : ∀ r a b c m : Fin 3, ContinuousOn (gsrDRm G r a b c m) U := by
    intro r a b c m
    have e1 : gsrDRm G r a b c m = fun y => partialDeriv r (gsrRm G a b c m) y
        - ∑ q : Fin 3, (christoffel G q r a y * gsrRm G q b c m y
          + christoffel G q r b y * gsrRm G a q c m y
          + christoffel G q r c y * gsrRm G a b q m y
          + christoffel G q r m y * gsrRm G a b c q y) := rfl
    rw [e1]
    exact (hdRc r a b c m).sub (continuousOn_finset_sum _ fun q _ =>
      ((((hΓc q r a).mul (hRc q b c m)).add ((hΓc q r b).mul (hRc a q c m))).add
        ((hΓc q r c).mul (hRc a b q m))).add ((hΓc q r m).mul (hRc a b c q)))
  obtain ⟨M₀, hM₀, hM0b⟩ : ∃ M₀ : ℝ, 0 ≤ M₀ ∧ ∀ y ∈ B, ∀ a b c m : Fin 3,
      |gsrRm G a b c m y| ≤ M₀ := by
    obtain ⟨F, hFdef⟩ : ∃ F : E3 → (Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
        ∀ y a b c m, F y a b c m = gsrRm G a b c m y :=
      ⟨fun y a b c m => gsrRm G a b c m y, fun _ _ _ _ _ => rfl⟩
    have hF : ContinuousOn F B := by
      refine continuousOn_pi.2 fun a => continuousOn_pi.2 fun b => continuousOn_pi.2 fun c =>
        continuousOn_pi.2 fun m => ?_
      simp only [hFdef]
      exact (hRc a b c m).mono hBU
    obtain ⟨C, hC⟩ := hB.exists_bound_of_continuousOn hF
    refine ⟨max C 0, le_max_right _ _, fun y hy a b c m => ?_⟩
    have h := hC y hy
    calc |gsrRm G a b c m y| = ‖F y a b c m‖ := by
          rw [Real.norm_eq_abs, hFdef]
      _ ≤ ‖F y a b c‖ := norm_le_pi_norm _ m
      _ ≤ ‖F y a b‖ := norm_le_pi_norm _ c
      _ ≤ ‖F y a‖ := norm_le_pi_norm _ b
      _ ≤ ‖F y‖ := norm_le_pi_norm _ a
      _ ≤ max C 0 := h.trans (le_max_left _ _)
  obtain ⟨M₁, hM₁, hM1b⟩ : ∃ M₁ : ℝ, 0 ≤ M₁ ∧ ∀ y ∈ B, ∀ r a b c m : Fin 3,
      |gsrDRm G r a b c m y| ≤ M₁ := by
    obtain ⟨F, hFdef⟩ : ∃ F : E3 → (Fin 3 → Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
        ∀ y r a b c m, F y r a b c m = gsrDRm G r a b c m y :=
      ⟨fun y r a b c m => gsrDRm G r a b c m y, fun _ _ _ _ _ _ => rfl⟩
    have hF : ContinuousOn F B := by
      refine continuousOn_pi.2 fun r => continuousOn_pi.2 fun a => continuousOn_pi.2 fun b =>
        continuousOn_pi.2 fun c => continuousOn_pi.2 fun m => ?_
      simp only [hFdef]
      exact (hDc r a b c m).mono hBU
    obtain ⟨C, hC⟩ := hB.exists_bound_of_continuousOn hF
    refine ⟨max C 0, le_max_right _ _, fun y hy r a b c m => ?_⟩
    have h := hC y hy
    calc |gsrDRm G r a b c m y| = ‖F y r a b c m‖ := by
          rw [Real.norm_eq_abs, hFdef]
      _ ≤ ‖F y r a b c‖ := norm_le_pi_norm _ m
      _ ≤ ‖F y r a b‖ := norm_le_pi_norm _ c
      _ ≤ ‖F y r a‖ := norm_le_pi_norm _ b
      _ ≤ ‖F y r‖ := norm_le_pi_norm _ a
      _ ≤ ‖F y‖ := norm_le_pi_norm _ r
      _ ≤ max C 0 := h.trans (le_max_left _ _)
  
  have step : ∀ p q s : ℝ, p ≤ q → 0 ≤ q → |s| ≤ κ → p * |s| ≤ q * κ :=
    fun p q s h1 h2 h3 => mul_le_mul h1 h3 (abs_nonneg _) h2
  have n1 : ∀ M : ℝ, 0 ≤ M → 0 ≤ M * κ := fun M hM => mul_nonneg hM hκ
  refine ⟨81 * M₀ * κ ^ 4, 243 * M₁ * κ ^ 5,
    mul_nonneg (mul_nonneg (by norm_num) hM₀) (pow_nonneg hκ 4),
    mul_nonneg (mul_nonneg (by norm_num) hM₁) (pow_nonneg hκ 5), ?_⟩
  intro y hy
  refine ⟨fun X Y Z W hX hY hZ hW => ?_, fun V X Y Z W hV hX hY hZ hW => ?_⟩
  · have bX := hvec y hy X hX
    have bY := hvec y hy Y hY
    have bZ := hvec y hy Z hZ
    have bW := hvec y hy W hW
