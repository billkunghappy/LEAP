    obtain ⟨Cb, s₀, hs₀, hband⟩ := stern_thin_band_volume β hβs hβ.2.1 (q j) Kc hKcc hKT
    obtain ⟨Λ, hΛ0, hΛ⟩ := stern_chart_integral_compare D Kc hDm hKcc hKD
      (fun y => β (c.symm y)) _ _ (hbc.mono hKT) hAf hCf Cb s₀ hband
    refine ⟨Λ, s₀, hs₀, hΛ0, fun ε s hε hs hss => ?_⟩
    obtain ⟨hφεs, hlapc, -, -⟩ := stern_phi_chart_reps g u hu ε hε (q j)
    have hgφ : ContinuousOn (fun y => g.gradInner β (sternPhiM g u ε) (c.symm y)) Kc :=
      (stern_gradInner_chart g β (sternPhiM g u ε) Set.univ isOpen_univ hβs hφεs.contMDiffOn
        (q j)).mono (fun y hy => ⟨hKT hy, Set.mem_univ _⟩)
    have hηc : ContinuousOn (fun y => Real.smoothTransition (β (c.symm y) / s)) Kc :=
      Real.smoothTransition.continuous.comp_continuousOn ((hbc.mono hKT).div_const s)
    have hη'c : ContinuousOn (fun y => deriv Real.smoothTransition (β (c.symm y) / s)) Kc :=
      hdc.comp_continuousOn ((hbc.mono hKT).div_const s)
    refine hΛ ε s hε hs hss _ _ _ _
      (((hψc.mono hKT).mul (hηc.mul (hlapc.mono hKT))).mul (hsd.mono hKT))
      (((hψc.mono hKT).mul ((continuousOn_const.mul hη'c).mul hgφ)).mul (hsd.mono hKT))
      (((hψc.mono hKT).mul ((hηc.mul hsqQ).mul hKgc)).mul (hsd.mono hKT))
      (((hψc.mono hKT).mul ((continuousOn_const.mul hη'c).mul hXc)).mul (hsd.mono hKT))
      ?_ ?_ ?_
    · intro y hy
      have h0 := hvan0 y hy
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [h0, zero_mul]
    · intro y hy
      beta_reduce
      obtain ⟨hQp, hlapb, -, -, -⟩ :=
        stern_band_pointwise g hR β u hβc hu hharm (c.symm y) (hKreg y hy) ε hε
      have ha : 0 ≤ φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det :=
        mul_nonneg (hφ0 j _) (Real.sqrt_nonneg _)
      have hN : 0 < Real.sqrt (g.gradInner u u (c.symm y)) := Real.sqrt_pos.2 hQp
      have hB : 0 ≤ |sternGaussM g u (c.symm y)| * ε /
          (2 * Real.sqrt (g.gradInner u u (c.symm y))) := by positivity
      have hη0 := Real.smoothTransition.nonneg (β (c.symm y) / s)
      have hη1 := Real.smoothTransition.le_one (β (c.symm y) / s)
      have eAf : ε * (φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det *
          |sternGaussM g u (c.symm y)| * (2 * Real.sqrt (g.gradInner u u (c.symm y)))⁻¹) =
          (φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det) *
            (|sternGaussM g u (c.symm y)| * ε / (2 * Real.sqrt (g.gradInner u u (c.symm y)))) := by
        ring
      rw [eAf]
      by_cases hβp : 0 < β (c.symm y)
      · have hT := hlapb hβp
        have h1 := mul_nonneg (mul_nonneg ha hη0) (by linarith : 0 ≤
          g.lapM (sternPhiM g u ε) (c.symm y) +
            Real.sqrt (g.gradInner u u (c.symm y)) * sternGaussM g u (c.symm y) +
            |sternGaussM g u (c.symm y)| * ε / (2 * Real.sqrt (g.gradInner u u (c.symm y))))
        have h2 := mul_nonneg (mul_nonneg ha hB) (sub_nonneg.2 hη1)
        nlinarith [h1, h2]
      · have hz : Real.smoothTransition (β (c.symm y) / s) = 0 :=
          Real.smoothTransition.zero_of_nonpos (div_nonpos_iff.mpr (Or.inr ⟨not_lt.mp hβp, hs.le⟩))
        rw [hz]
        have := mul_nonneg ha hB
        nlinarith [this]
    · intro y hy
      beta_reduce
      obtain ⟨hQp, -, hgrad, hr0, hr1⟩ :=
        stern_band_pointwise g hR β u hβc hu hharm (c.symm y) (hKreg y hy) ε hε
      rw [hgrad]
      have hP : 0 ≤ φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det * s⁻¹ :=
        mul_nonneg (mul_nonneg (hφ0 j _) (Real.sqrt_nonneg _)) (inv_nonneg.2 hs.le)
