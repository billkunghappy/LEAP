          · show (b : ℝ) ≤ g x
            rw [hb]
          · show ¬ (b : ℝ) ≤ f x
            rw [ha]
            push_neg
            exact_mod_cast h
      · refine ⟨a, ?_, ?_, hxS⟩
        · rw [Finset.mem_Icc]; exact ⟨by linarith, by linarith⟩
        · rw [Set.mem_symmDiff]
          left
          refine ⟨?_, ?_⟩
          · show (a : ℝ) ≤ f x
            rw [ha]
          · show ¬ (a : ℝ) ≤ g x
            rw [hb]
            push_neg
            exact_mod_cast h
    have hsum : ∑ j ∈ I, volume (symmDiff {x | (j : ℝ) ≤ f x} {x | (j : ℝ) ≤ g x} ∩ S) ≤
