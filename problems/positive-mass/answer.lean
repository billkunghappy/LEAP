  have hsign : ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → ∀ x₀ : E3, ρ < ‖x₀‖ → σ * u x₀ ≤ A * w x₀ := by
    intro σ hσ x₀ hx₀
    by_contra hcon
    push_neg at hcon
    have habsσ : ∀ y, σ * u y ≤ |u y| := by
      intro y
      rcases hσ with h | h
      · rw [h, one_mul]; exact le_abs_self _
      · rw [h, neg_one_mul]; exact neg_le_abs _
    obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = (σ * u x₀ - A * w x₀) / 2 := ⟨_, rfl⟩
    have hε : 0 < ε := by rw [hεdef]; linarith
    obtain ⟨Rε, hRε⟩ := hlim ε hε
    obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = max Rε ‖x₀‖ + 1 := ⟨_, rfl⟩
    have hT1 : Rε < T := by have := le_max_left Rε ‖x₀‖; linarith
    have hT2 : ‖x₀‖ < T := by have := le_max_right Rε ‖x₀‖; linarith
    obtain ⟨K, hKdef⟩ : ∃ K : Set E3, K = {y : E3 | ρ ≤ ‖y‖ ∧ ‖y‖ ≤ T} := ⟨_, rfl⟩
    have hKc : IsCompact K := by
      apply (isCompact_closedBall (0 : E3) T).of_isClosed_subset
      · rw [hKdef]
        exact (isClosed_le continuous_const continuous_norm).inter
          (isClosed_le continuous_norm continuous_const)
      · intro y hy
        rw [hKdef] at hy
        exact mem_closedBall_zero_iff.mpr hy.2
    have hx₀K : x₀ ∈ K := by rw [hKdef]; exact ⟨hx₀.le, hT2.le⟩
    have hKsub : K ⊆ {x : E3 | R₀ < ‖x‖} := by
      intro y hy; rw [hKdef] at hy; exact lt_of_lt_of_le hR₀ρ hy.1
    obtain ⟨z, hzdef⟩ : ∃ z : E3 → ℝ, z = fun y => σ * u y - A * w y - ε := ⟨_, rfl⟩
    have hzc : ContinuousOn z K := by
      rw [hzdef]
      exact ((continuousOn_const.mul (hucont.mono hKsub)).sub
        (continuousOn_const.mul hwcont.continuousOn)).sub continuousOn_const
    obtain ⟨xs, hxsK, hxsmax⟩ := hKc.exists_isMaxOn ⟨x₀, hx₀K⟩ hzc
    have hzx₀ : z x₀ = ε := by rw [hzdef, hεdef]; ring
    have hzxs : ε ≤ z xs := hzx₀ ▸ isMaxOn_iff.mp hxsmax x₀ hx₀K
    have hzxs' : ε ≤ σ * u xs - A * w xs - ε := by rw [hzdef] at hzxs; exact hzxs
    have hxsK' : ρ ≤ ‖xs‖ ∧ ‖xs‖ ≤ T := by rw [hKdef] at hxsK; exact hxsK
    have hAw : 0 < A * w xs := mul_pos hApos (hwpos xs)
    rcases eq_or_lt_of_le hxsK'.1 with hρeq | hρlt
    · have hy : xs ∈ sphere (0 : E3) ρ := mem_sphere_zero_iff_norm.mpr hρeq.symm
      have h1 := hAsph xs hy
      have h2 := habsσ xs
      linarith
    rcases eq_or_lt_of_le hxsK'.2 with hTeq | hTlt
    · have hu' := hRε xs (by rw [hTeq]; exact hT1)
      have h2 := habsσ xs
      linarith
    · have hKn : K ∈ 𝓝 xs := by
        apply Filter.mem_of_superset (((isOpen_lt continuous_const continuous_norm).inter
          (isOpen_lt continuous_norm continuous_const)).mem_nhds ⟨hρlt, hTlt⟩)
        intro y hy
        rw [hKdef]
        exact ⟨hy.1.le, hy.2.le⟩
      have hloc : IsLocalMax z xs := hxsmax.isLocalMax hKn
      have hz2 : ContDiffOn ℝ 2 z U := by
        rw [hzdef]
        exact ((contDiffOn_const.mul (hu2.mono hUsub)).sub
          (contDiffOn_const.mul hw.contDiffOn)).sub contDiffOn_const
      have hle := hmaxp z xs hρlt hz2 hloc
      have heq := hlin σ A ε xs hρlt
      rw [hlapU xs hρlt] at heq
      rw [hzdef, heq] at hle
      have hw' := hbar xs (lt_trans hR₁ρ hρlt)
      have hneg : A * lapLoc G w xs < 0 := mul_neg_of_pos_of_neg hApos hw'
      linarith
  have hAu : ∀ x : E3, ρ < ‖x‖ → |u x| ≤ A * w x := by
    intro x hx
    have hp := hsign 1 (Or.inl rfl) x hx
    have hn := hsign (-1) (Or.inr rfl) x hx
    rw [abs_le]
    constructor <;> linarith
  
  have hwle : ∀ x : E3, 0 < ‖x‖ → w x ≤ ‖x‖ ^ (-p) := by
    intro x hx
    have hx2 : (0 : ℝ) < ‖x‖ ^ 2 := by positivity
    have hle : w x ≤ (‖x‖ ^ 2) ^ (-p / 2) :=
      Real.rpow_le_rpow_of_nonpos hx2 (by linarith) (by linarith)
    have heq : (‖x‖ ^ 2) ^ (-p / 2) = ‖x‖ ^ (-p) := by
      rw [show (‖x‖ ^ 2 : ℝ) = ‖x‖ ^ (2 : ℝ) by norm_cast, ← Real.rpow_mul (norm_nonneg x)]
      congr 1; ring
    rw [heq] at hle
    exact hle
  have hρpos : 0 < ρ := by linarith
  have hv0 : ∀ x : E3, ρ < ‖x‖ → |u x| ≤ A * ‖x‖ ^ (-p) := by
    intro x hx
    exact (hAu x hx).trans (mul_le_mul_of_nonneg_left (hwle x (by linarith)) hA)
  obtain ⟨R', C', hR'ρ, hC', hder⟩ :=
    exterior_scaled_estimate G q hq0 hsmooth R C hR hC hb u (-p) A ρ hRρ hA (hu.mono hUsub) hv0
      (fun x hx => by
        rw [hlapU x hx, abs_zero]
        exact mul_nonneg hA (Real.rpow_nonneg (norm_nonneg _) _))
      (fun x hx => by
        have hev : lapLoc G u =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
          Filter.eventually_of_mem (hUo.mem_nhds hx) hlapU
        rw [hev.fderiv_eq]
        simp only [fderiv_const_apply, norm_zero]
        exact mul_nonneg hA (Real.rpow_nonneg (norm_nonneg _) _))
  have hρR' : ∀ x : E3, R' < ‖x‖ → ρ < ‖x‖ := fun x hx => lt_of_le_of_lt hR'ρ hx
  obtain ⟨Cm, hCmdef⟩ : ∃ Cm : ℝ, Cm = max A C' := ⟨_, rfl⟩
  have hCm1 : A ≤ Cm := hCmdef ▸ le_max_left _ _
  have hCm2 : C' ≤ Cm := hCmdef ▸ le_max_right _ _
  have hCm0 : 0 ≤ Cm := le_trans hA hCm1
  have hUo' : IsOpen {x : E3 | R' < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hu' : ContDiffOn ℝ ∞ u {x : E3 | R' < ‖x‖} :=
    hu.mono (fun y hy => lt_trans hR₀ρ (hρR' y hy))
  have hevc : ∀ᶠ x in Bornology.cobounded E3, R' < ‖x‖ :=
    tendsto_norm_cobounded_atTop.eventually (Filter.eventually_gt_atTop R')
  have key : ∀ x : E3, R' < ‖x‖ →
      ‖iteratedFDeriv ℝ l u x‖ ≤ 9 * Cm * ‖x‖ ^ (-p - (l : ℝ)) := by
    intro x hx
    have hrp : ∀ e : ℝ, 0 ≤ ‖x‖ ^ e := fun e => Real.rpow_nonneg (norm_nonneg _) e
    interval_cases l
    · rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs]
      have h0 := hv0 x (hρR' x hx)
      have h0' : A * ‖x‖ ^ (-p) ≤ Cm * ‖x‖ ^ (-p) := mul_le_mul_of_nonneg_right hCm1 (hrp _)
