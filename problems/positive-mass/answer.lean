  have hLφ : L ⟨φ, hφV⟩ = ∫ x in ndsHalf (A.c j) (A.r j),
      Real.sqrt (g.coeff (A.κ j) x).det * f (A.κ j x) * ζ x := by
    rw [hL]
    show ndsInt g A (fun q => f q * φ q) = _
    rw [← (nds_int_localize g A (fun q => f q * φ q)
      (fun k => (hfc k).mul ((hcc k _ _ hφs hφs).1.continuousOn)) j).2
      (fun q _ hq => by simp [hφ0 q (hout q hq)])]
    refine setIntegral_congr_fun (hHb j).1 (fun x hx => ?_)
    beta_reduce
    rw [hφκ x (by rw [hball j]; exact (hHb j).2.1 hx)]
    ring
  have hpz : ∀ x ∈ Metric.ball (A.c j) (A.r j), ∀ i : Fin 3,
      partialDeriv i (fun z => φ (A.κ j z)) x = partialDeriv i ζ x := by
    intro x hx i
    have hev : (fun z => φ (A.κ j z)) =ᶠ[𝓝 x] ζ := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hx] with z hz
      exact hφκ z (by rw [hball j]; exact hz)
    unfold partialDeriv
    rw [hev.fderiv_eq]
  obtain ⟨w, hw⟩ : ∃ w : Fin 3 → Fin 3 → E3 → ℝ, ∀ a b x,
      w a b x = Real.sqrt (g.coeff (A.κ j) x).det * (g.coeff (A.κ j) x)⁻¹ a b *
        partialDeriv a ζ x := ⟨_, fun _ _ _ => rfl⟩
  have hζd : ∀ a : Fin 3, Continuous (partialDeriv a ζ) := by
    intro a
