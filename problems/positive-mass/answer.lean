        intro j; rw [abs_mul]; exact mul_le_mul (haij j) (hgj j) (abs_nonneg _) hδ0
      have hnum : |F (x₀ + ρ • ζ) i - F x₀ i -
          ∑ j : Fin 2, (a (x₀ + ρ • ζ) i j - a x₀ i j) * smthGrad w x₀ j| ≤
