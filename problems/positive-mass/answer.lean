  obtain ⟨m₀, Λ, β, Γ, m, hm₀, hΛ, hβ, hΓ, hm, hK, hSin⟩ :=
    hconst W A B w (fun _ => 0) hA hB hApos hw.continuousOn continuousOn_const z R hR hball hpos
  obtain ⟨α, hα⟩ : ∃ α : ℝ, α = 1 + (4 * Λ + 4 * β * R + Γ) / (4 * m₀) := ⟨_, rfl⟩
  have hα1 : 1 ≤ α := by
    have : 0 ≤ (4 * Λ + 4 * β * R + Γ) / (4 * m₀) := by positivity
    linarith
  have hα0 : 0 < α := by linarith
  have hbar : ∀ (a : Matrix (Fin 2) (Fin 2) ℝ) (b : Fin 2 → ℝ) (y : E2),
      m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j → (∀ i : Fin 2, |a i i| ≤ Λ) →
      (∀ k : Fin 2, |b k| ≤ β) → ‖y‖ ≤ R →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, b k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2))
        - Γ * (Real.exp (-α * ‖y‖ ^ 2) - Real.exp (-α * R ^ 2)) := by
    intro a b y hq ha hb hy
    have hE := Real.exp_pos (-α * ‖y‖ ^ 2)
    have hER := Real.exp_pos (-α * R ^ 2)
    have hy0 : |y 0| ≤ R := by
      have := PiLp.norm_apply_le y 0
      rw [Real.norm_eq_abs] at this
      linarith
    have hy1 : |y 1| ≤ R := by
      have := PiLp.norm_apply_le y 1
      rw [Real.norm_eq_abs] at this
      linarith
    have htr : a 0 0 + a 1 1 ≤ 2 * Λ := by
      have h0 := le_abs_self (a 0 0)
      have h1 := le_abs_self (a 1 1)
      linarith [ha 0, ha 1]
    have hb0 : b 0 * y 0 ≤ β * R := by
      calc b 0 * y 0 ≤ |b 0 * y 0| := le_abs_self _
        _ = |b 0| * |y 0| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hb 0) hy0 (abs_nonneg _) hβ
    have hb1 : b 1 * y 1 ≤ β * R := by
      calc b 1 * y 1 ≤ |b 1 * y 1| := le_abs_self _
        _ = |b 1| * |y 1| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hb 1) hy1 (abs_nonneg _) hβ
    have h4 : 4 * α * m₀ = 4 * m₀ + 4 * Λ + 4 * β * R + Γ := by
      rw [hα]
      field_simp
      ring
    set q := ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j with hqdef
    have hP : 0 < 4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1) - 2 * α * (b 0 * y 0 + b 1 * y 1) - Γ := by
      have e1 : 4 * α ^ 2 * m₀ ≤ 4 * α ^ 2 * q := by
        have : 0 ≤ 4 * α ^ 2 := by positivity
        exact mul_le_mul_of_nonneg_left hq this
      have e2 : 2 * α * (a 0 0 + a 1 1) ≤ 2 * α * (2 * Λ) :=
        mul_le_mul_of_nonneg_left htr (by positivity)
      have e3 : 2 * α * (b 0 * y 0 + b 1 * y 1) ≤ 2 * α * (2 * β * R) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have e4 : 4 * α ^ 2 * m₀ - 4 * α * Λ - 4 * α * β * R - Γ = 4 * α * m₀ + (α - 1) * Γ := by
        linear_combination α * h4
      have e5 : 0 < 4 * α * m₀ + (α - 1) * Γ := by
        have : 0 ≤ (α - 1) * Γ := mul_nonneg (by linarith) hΓ
        have : 0 < 4 * α * m₀ := by positivity
        linarith
      nlinarith
    have hkey : ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, b k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2))
        - Γ * (Real.exp (-α * ‖y‖ ^ 2) - Real.exp (-α * R ^ 2))
        = Real.exp (-α * ‖y‖ ^ 2) * (4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1)
          - 2 * α * (b 0 * y 0 + b 1 * y 1) - Γ) + Γ * Real.exp (-α * R ^ 2) := by
      rw [hqdef]
      simp only [Fin.sum_univ_two, if_pos (rfl : (0 : Fin 2) = 0), if_pos (rfl : (1 : Fin 2) = 1),
        if_neg (show ¬((0 : Fin 2) = 1) by decide), if_neg (show ¬((1 : Fin 2) = 0) by decide),
        if_true]
      ring
    rw [hkey]
    have := mul_pos hE hP
    have := mul_nonneg hΓ hER.le
    linarith
  obtain ⟨v, hv⟩ : ∃ v : E2 → ℝ, ∀ x, v x = Real.exp (-α * ‖x - z‖ ^ 2) - Real.exp (-α * R ^ 2) :=
    ⟨_, fun x => rfl⟩
  obtain ⟨hvs, hvD, hv1, hv2⟩ := hbarrier z α R v hv
  have hV1 : ∀ x, dist x z = R → v x = 0 := by
    intro x hx
    rw [hv, ← dist_eq_norm, hx, sub_self]
  have hV2 : ∀ x, v x ≤ 1 := by
    intro x
    have h1 : Real.exp (-α * ‖x - z‖ ^ 2) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have := sq_nonneg ‖x - z‖
      nlinarith
    have h2 := Real.exp_pos (-α * R ^ 2)
    rw [hv]
    linarith
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : E2, y₀ = (1 / 2 : ℝ) • (z - x₁) := ⟨_, rfl⟩
  have hV3 : 0 < fderiv ℝ v x₁ y₀ := by
    rw [hvD x₁ y₀]
    have hs : ∑ k : Fin 2, (x₁ - z) k * y₀ k = -(1 / 2) * ‖x₁ - z‖ ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [hy₀, Fin.sum_univ_two, Real.norm_eq_abs, sq_abs]
      ring
    rw [hs, ← dist_eq_norm, hx₁]
    rw [show -2 * α * (-(1 / 2) * R ^ 2) = α * R ^ 2 by ring]
    positivity
  
  have hu : ContDiffOn ℝ ∞ (fun x => w x - m * v x) W :=
    hw.sub (contDiffOn_const.mul hvs.contDiffOn)
  have hlin : ∀ x ∈ W, fderiv ℝ (fun y => w y - m * v y) x = fderiv ℝ w x - m • fderiv ℝ v x ∧
      (∀ k : Fin 2, pd2 k (fun y => w y - m * v y) x = pd2 k w x - m * pd2 k v x) ∧
      ∀ i j : Fin 2, pd2 i (pd2 j (fun y => w y - m * v y)) x
        = pd2 i (pd2 j w) x - m * pd2 i (pd2 j v) x := by
    intro x hx
    have hdf : ∀ y ∈ W, DifferentiableAt ℝ w y := fun y hy =>
      (hw.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
    have hdg : ∀ y, DifferentiableAt ℝ v y := fun y => hvs.differentiable (by simp) y
    have h1 : ∀ y ∈ W, fderiv ℝ (fun y => w y - m * v y) y = fderiv ℝ w y - m • fderiv ℝ v y := by
      intro y hy
      exact ((hdf y hy).hasFDerivAt.sub ((hdg y).hasFDerivAt.const_mul m)).fderiv
    have h2 : ∀ y ∈ W, ∀ k : Fin 2,
        pd2 k (fun y => w y - m * v y) y = pd2 k w y - m * pd2 k v y := by
      intro y hy k
      show fderiv ℝ (fun y => w y - m * v y) y (e2 k)
        = fderiv ℝ w y (e2 k) - m * fderiv ℝ v y (e2 k)
      rw [h1 y hy]
      rfl
    have hdpf : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ w y (e2 j)) x := by
      intro j
      have hc : ContDiffOn ℝ ∞ (fun y => fderiv ℝ w y (e2 j)) W :=
        (hw.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
      exact (hc.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hdpg : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ v y (e2 j)) x := by
      intro j
      have hc : ContDiff ℝ ∞ (fun y => fderiv ℝ v y (e2 j)) :=
        (hvs.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
      exact hc.differentiable (by simp) x
    refine ⟨h1 x hx, h2 x hx, fun i j => ?_⟩
    have hev : pd2 j (fun y => w y - m * v y) =ᶠ[𝓝 x]
        fun y => fderiv ℝ w y (e2 j) - m * fderiv ℝ v y (e2 j) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => h2 y hy j)
    show fderiv ℝ (pd2 j (fun y => w y - m * v y)) x (e2 i)
      = fderiv ℝ (fun y => fderiv ℝ w y (e2 j)) x (e2 i)
        - m * fderiv ℝ (fun y => fderiv ℝ v y (e2 j)) x (e2 i)
    rw [hev.fderiv_eq]
    have hD := ((hdpf j).hasFDerivAt.sub ((hdpg j).hasFDerivAt.const_mul m)).fderiv
    exact congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) hD
  have hstrict : ∀ x : E2, R / 2 < dist x z → dist x z < R →
      ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j (fun x => w x - m * v x)) x
        + ∑ k : Fin 2, B x k * pd2 k (fun x => w x - m * v x) x
        - Γ * (fun x => w x - m * v x) x < 0 := by
    intro x h1 h2
    have hxW : x ∈ W := hball (by rw [Metric.mem_closedBall]; exact h2.le)
    obtain ⟨-, hp1, hp2⟩ := hlin x hxW
    obtain ⟨hq, ha, hb, -⟩ := hK x h1.le h2.le
    have hineq := hbar (A x) (B x) (x - z) hq ha hb
      (by rw [← dist_eq_norm]; exact h2.le)
    have hs := hsup x hxW
    have hgw : 0 ≤ Γ * w x := mul_nonneg hΓ (hnn x hxW)
    have hTv := mul_pos hm hineq
    simp only [hp1, hp2, hv1, hv2, hv x] at hTv ⊢
    simp only [Fin.sum_univ_two] at hTv hs ⊢
    linarith
  have hout : ∀ x : E2, dist x z = R → 0 ≤ (fun x => w x - m * v x) x := by
    intro x hx
    have hxW : x ∈ W := hball (by rw [Metric.mem_closedBall, hx])
    show 0 ≤ w x - m * v x
    rw [hV1 x hx, mul_zero, sub_zero]
    exact hnn x hxW
  have hin : ∀ x : E2, dist x z = R / 2 → 0 ≤ (fun x => w x - m * v x) x := by
    intro x hx
    have h1 := hSin x hx
    have h2 := hV2 x
    show 0 ≤ w x - m * v x
    nlinarith
  
  have hApsd : ∀ x ∈ W, ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j := by
    intro x hx ξ
    by_cases hξ : ξ = 0
    · subst hξ
      simp
    · exact (hApos x hx ξ hξ).le
  have hmp := hminp W hW A B (fun x => w x - m * v x) Γ z R hR hball hu hAs
    hApsd hΓ hstrict hin hout
  
  have hu1 : w x₁ - m * v x₁ = 0 := by
    rw [hw₁, hV1 x₁ hx₁]
    ring
  have hseg : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      (fun x => w x - m * v x) x₁ ≤ (fun x => w x - m * v x) (x₁ + t • y₀) := by
    intro t ht0 ht1
    have hd : dist (x₁ + t • y₀) z = (1 - t / 2) * R := by
      have e1 : x₁ + t • y₀ - z = (1 - t / 2) • (x₁ - z) := by
        rw [hy₀]
        module
      rw [dist_eq_norm, e1, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith),
        ← dist_eq_norm, hx₁]
    show w x₁ - m * v x₁ ≤ w (x₁ + t • y₀) - m * v (x₁ + t • y₀)
    rw [hu1]
    exact hmp _ (by rw [hd]; nlinarith) (by rw [hd]; nlinarith)
  have hdu : DifferentiableAt ℝ (fun x => w x - m * v x) x₁ :=
    (hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx₁W)
  have h11 : 0 ≤ fderiv ℝ (fun x => w x - m * v x) x₁ y₀ := by
    have hminOn : IsLocalMinOn (fun x => w x - m * v x) (segment ℝ x₁ (x₁ + y₀)) x₁ := by
      apply Filter.eventually_of_mem self_mem_nhdsWithin
      intro p hp
      rw [segment_eq_image'] at hp
      obtain ⟨θ, ⟨h0, h1⟩, rfl⟩ := hp
      have := hseg θ h0 h1
      simpa only [add_sub_cancel_left] using this
    exact hminOn.hasFDerivWithinAt_nonneg hdu.hasFDerivAt.hasFDerivWithinAt
      (mem_posTangentConeAt_of_segment_subset subset_rfl)
  
  obtain ⟨hf1, -, -⟩ := hlin x₁ hx₁W
  rw [hf1, hdw1] at h11
  simp only [ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.neg_apply, smul_eq_mul, zero_sub] at h11
  nlinarith [mul_pos hm hV3]

theorem patched_harmonic_form_vanish {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (hS : IsCompact S) (P : EigPatchedSurface X S) (w : Fin P.n → E2 → ℝ)
    (hw : ∀ j, ContDiffOn ℝ ∞ (w j) (P.W j))
    (hharm : ∀ j, ∀ x ∈ P.W j, lap2 (P.h j) (w j) x = 0)
    (hcomp : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      fderiv ℝ (w j) x = fderiv ℝ (fun x' => w k (P.proj k (P.param j x'))) x)
    (hK : ∀ j, ∀ x ∈ P.W j, 0 ≤ gaussCurv2 (P.h j) x)
    (hK' : ∀ q ∈ S, ∃ j, ∃ x ∈ P.W j, P.param j x ∈ connectedComponentIn S q ∧
      0 < gaussCurv2 (P.h j) x) :
    ∀ j, ∀ x ∈ P.W j, fderiv ℝ (w j) x = 0 :=
by
  classical
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem.2
  have hP2 : ∀ j, ∀ r ∈ P.O j, r ∈ S → P.proj j r ∈ P.W j ∧ P.param j (P.proj j r) = r := by
    intro j r hrO hrS
    have hmem : r ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hrO, hrS⟩
    obtain ⟨x, hx, rfl⟩ := hmem
    rw [P.proj_param j x hx]
    exact ⟨hx, rfl⟩
  have hsymm : ∀ j, ∀ x ∈ P.W j, ∀ a b : Fin 2, P.h j x a b = P.h j x b a := by
    intro j x hx a b
    have h1 := (P.h_posDef j x hx).isHermitian.apply a b
    rw [star_trivial] at h1
    exact h1.symm
  
  obtain ⟨qf, hqdef⟩ : ∃ qf : Fin P.n → E2 → ℝ, ∀ j y, qf j y =
      ∑ a : Fin 2, ∑ b : Fin 2, (P.h j y)⁻¹ a b * pd2 a (w j) y * pd2 b (w j) y :=
    ⟨_, fun _ _ => rfl⟩
  have hqfun : ∀ j, qf j = fun y =>
      ∑ a : Fin 2, ∑ b : Fin 2, (P.h j y)⁻¹ a b * pd2 a (w j) y * pd2 b (w j) y :=
    fun j => funext (hqdef j)
  have hpd_smooth : ∀ j (a : Fin 2), ContDiffOn ℝ ∞ (pd2 a (w j)) (P.W j) := by
    intro j a
    have h1 := (hw j).fderiv_of_isOpen (P.W_open j) (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  have hq_smooth : ∀ j, ContDiffOn ℝ ∞ (qf j) (P.W j) := by
    intro j
    have hG := gs2_metric_calculus (P.h j) (P.W j) (P.W_open j) (P.h_smooth j) (hsymm j)
      (P.h_posDef j)
    rw [hqfun j]
    refine ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun b _ => ?_))
    exact ((hG.1 a b).mul (hpd_smooth j a)).mul (hpd_smooth j b)
  
  have hq_nonneg : ∀ j, ∀ x ∈ P.W j, 0 ≤ qf j x := by
    intro j x hx
    rw [hqdef]
    exact ((posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hx)).1 (fun a => pd2 a (w j) x)).1
  
  have hboch : ∀ j, ∀ x ∈ P.W j, 2 * gaussCurv2 (P.h j) x * qf j x ≤ lap2 (P.h j) (qf j) x := by
    intro j x hx
    have hB := bochner_lap2_identity (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)
      (w j) (hw j) x hx
    have hB' : lap2 (P.h j) (qf j) x =
        2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (P.h j x)⁻¹ a c * (P.h j x)⁻¹ b d *
          (pd2 a (pd2 b (w j)) x - ∑ k : Fin 2, christoffel2 (P.h j) k a b x * pd2 k (w j) x) *
          (pd2 c (pd2 d (w j)) x - ∑ k : Fin 2, christoffel2 (P.h j) k c d x * pd2 k (w j) x)) +
        2 * (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a (w j) x *
          pd2 b (lap2 (P.h j) (w j)) x) +
        2 * gaussCurv2 (P.h j) x *
          (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a (w j) x * pd2 b (w j) x) := by
      rw [hqfun j]
      exact hB
    have hlapw : lap2 (P.h j) (w j) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      filter_upwards [(P.W_open j).mem_nhds hx] with y hy using hharm j y hy
    have hcross : ∀ b : Fin 2, pd2 b (lap2 (P.h j) (w j)) x = 0 := by
      intro b
      show fderiv ℝ (lap2 (P.h j) (w j)) x (e2 b) = 0
      rw [hlapw.fderiv_eq]
      simp
    have hcr : (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b * pd2 a (w j) x *
        pd2 b (lap2 (P.h j) (w j)) x) = 0 := by
      simp [hcross]
    have hHH : 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        (P.h j x)⁻¹ a c * (P.h j x)⁻¹ b d *
          (pd2 a (pd2 b (w j)) x - ∑ k : Fin 2, christoffel2 (P.h j) k a b x * pd2 k (w j) x) *
          (pd2 c (pd2 d (w j)) x - ∑ k : Fin 2, christoffel2 (P.h j) k c d x * pd2 k (w j) x) :=
      (posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hx)).2
        (fun a b => pd2 a (pd2 b (w j)) x - ∑ k : Fin 2, christoffel2 (P.h j) k a b x * pd2 k (w j) x)
    rw [hB', hcr, hqdef j x]
    linarith
  
  have hsubq : ∀ j, ∀ x ∈ P.W j, 0 ≤ lap2 (P.h j) (qf j) x := by
    intro j x hx
    have h1 := hboch j x hx
    have h2 := mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) (hK j x hx)) (hq_nonneg j x hx)
    linarith
  
  have hqcompat : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      qf j x = qf k (P.proj k (P.param j x)) := by
    intro j k x hx
    rw [hqdef, hqdef]
    exact eig_form_pair_compat S P w w hw hw hcomp hcomp j k x hx
  obtain ⟨Q, hQ⟩ : ∃ Q : X → ℝ, ∀ j, ∀ x ∈ P.W j, Q (P.param j x) = qf j x := by
    refine ⟨fun r => if hr : ∃ k, r ∈ P.O k ∧ r ∈ S then
      qf (Classical.choose hr) (P.proj (Classical.choose hr) r) else 0, ?_⟩
    intro j x hx
    have hr : ∃ k, P.param j x ∈ P.O k ∧ P.param j x ∈ S := by
      have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
      rw [P.image_eq j] at hmem
      exact ⟨j, hmem⟩
    dsimp only
    rw [dif_pos hr]
    exact (hqcompat j _ x ⟨hx, (Classical.choose_spec hr).1⟩).symm
  have hQs : ∀ j, ContDiffOn ℝ ∞ (fun x => Q (P.param j x)) (P.W j) :=
    fun j => (hq_smooth j).congr (fun x hx => hQ j x hx)
  have hQ0 : ∀ r ∈ S, 0 ≤ Q r := by
    intro r hr
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hr)
    obtain ⟨h1, h2⟩ := hP2 j r hj hr
    have h3 := hQ j _ h1
    rw [h2] at h3
    rw [h3]
    exact hq_nonneg j _ h1
  have hQc : ContinuousOn Q S := by
    intro s hs
    obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (P.cover hs)
    have hc : ContinuousOn (fun p => Q (P.param l (P.proj l p))) (P.O l ∩ S) := by
      refine (hQs l).continuousOn.comp ((P.proj_cont l).mono Set.inter_subset_left) ?_
      intro p hp
      exact (hP2 l p hp.1 hp.2).1
    have hc' : ContinuousOn Q (P.O l ∩ S) := by
      refine hc.congr ?_
      intro p hp
      simp only [(hP2 l p hp.1 hp.2).2]
    refine (hc' s ⟨hl, hs⟩).mono_of_mem_nhdsWithin ?_
    rw [Set.inter_comm]
    exact inter_mem_nhdsWithin S ((P.O_open l).mem_nhds hl)
  
  have hgerm : ∀ (hh : E2 → Matrix (Fin 2) (Fin 2) ℝ) (f₁ f₂ : E2 → ℝ) (x : E2),
      f₁ =ᶠ[𝓝 x] f₂ → lap2 hh f₁ x = lap2 hh f₂ x := by
    intro hh f₁ f₂ x hev
    have h1 : ∀ k : Fin 2, pd2 k f₁ x = pd2 k f₂ x := by
      intro k
      show fderiv ℝ f₁ x (e2 k) = fderiv ℝ f₂ x (e2 k)
      rw [hev.fderiv_eq]
    have h2 : ∀ i k : Fin 2, pd2 i (pd2 k f₁) x = pd2 i (pd2 k f₂) x := by
      intro i k
      have hev2 : pd2 k f₁ =ᶠ[𝓝 x] pd2 k f₂ := by
        filter_upwards [hev.eventuallyEq_nhds] with y hy
        show fderiv ℝ f₁ y (e2 k) = fderiv ℝ f₂ y (e2 k)
        rw [hy.fderiv_eq]
      show fderiv ℝ (pd2 k f₁) x (e2 i) = fderiv ℝ (pd2 k f₂) x (e2 i)
      rw [hev2.fderiv_eq]
    simp only [lap2, h1, h2]
  have hQlap : ∀ j, ∀ x ∈ P.W j,
      lap2 (P.h j) (fun x' => Q (P.param j x')) x = lap2 (P.h j) (qf j) x := by
    intro j x hx
    exact hgerm _ _ _ x (by
      filter_upwards [(P.W_open j).mem_nhds hx] with y hy using hQ j y hy)
  
  have hlap_neg : ∀ (hh : E2 → Matrix (Fin 2) (Fin 2) ℝ) (c : ℝ) (f : E2 → ℝ) (y : E2),
      lap2 hh (fun x => c - f x) y = -lap2 hh f y := by
    intro hh c f y
    have hpdv : ∀ k : Fin 2, pd2 k (fun x => c - f x) = fun x => -pd2 k f x := by
      intro k
      funext x
      show fderiv ℝ (fun x => c - f x) x (e2 k) = -fderiv ℝ f x (e2 k)
      rw [fderiv_const_sub]
      rfl
    have hpdv2 : ∀ i k : Fin 2, pd2 i (pd2 k (fun x => c - f x)) y = -pd2 i (pd2 k f) y := by
      intro i k
      rw [hpdv k]
      show fderiv ℝ (fun x => -pd2 k f x) y (e2 i) = -fderiv ℝ (pd2 k f) y (e2 i)
      rw [show (fun x => -pd2 k f x) = -(pd2 k f) from rfl, fderiv_neg]
      rfl
    have hpdv1 : ∀ k : Fin 2, pd2 k (fun x => c - f x) y = -pd2 k f y := fun k => by
      rw [hpdv k]
    simp only [lap2, hpdv1, hpdv2]
    simp only [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun k _ => ?_))
    simp only [mul_neg, Finset.sum_neg_distrib]
    ring
  
  intro j₀ x₀ hx₀
  have hSne : S.Nonempty := ⟨_, hP1 j₀ x₀ hx₀⟩
  obtain ⟨p, hp, hmax⟩ := hS.exists_isMaxOn hSne hQc
  have hmax' : ∀ r ∈ S, Q r ≤ Q p := fun r hr => isMaxOn_iff.1 hmax r hr
  
  have hsmax : ∀ j, ∀ x₀ ∈ P.W j, Q (P.param j x₀) = Q p →
      ∀ᶠ y in 𝓝 x₀, Q (P.param j y) = Q p := by
    intro j x₀ hx₀ hxmax
    obtain ⟨v, hv⟩ : ∃ v : E2 → ℝ, v = fun y => Q p - Q (P.param j y) := ⟨_, rfl⟩
    have hv_smooth : ContDiffOn ℝ ∞ v (P.W j) := by
      rw [hv]
      exact contDiffOn_const.sub (hQs j)
    have hnnW : ∀ x ∈ P.W j, 0 ≤ v x := by
      intro x hx
      rw [hv]
      show 0 ≤ Q p - Q (P.param j x)
      linarith [hmax' _ (hP1 j x hx)]
    have hw0 : v x₀ = 0 := by
      rw [hv]
      show Q p - Q (P.param j x₀) = 0
      linarith
    obtain ⟨A, B, hA, hB, hAs, hApos, hid⟩ :=
      esm_lap2_coeff_form (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)
    have hsup : ∀ x ∈ P.W j, ∑ i : Fin 2, ∑ k : Fin 2, A x i k * pd2 i (pd2 k v) x
        + ∑ k : Fin 2, B x k * pd2 k v x ≤ 0 := by
      intro x hx
      rw [← hid, hv, hlap_neg, hQlap j x hx]
      linarith [hsubq j x hx]
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x₀ hx₀
    have hρ : 0 < ε / 3 := by positivity
    have hcb : Metric.closedBall x₀ (2 * (ε / 3)) ⊆ P.W j :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    refine Filter.eventually_of_mem (Metric.ball_mem_nhds x₀ hρ) ?_
    intro z hz
    by_contra hne
    have hwz : v z ≠ 0 := by
      rw [hv]
      show Q p - Q (P.param j z) ≠ 0
      intro h
      apply hne
      linarith
    have hDc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3))) := isCompact_closedBall _ _
    have hZcl : IsClosed (Metric.closedBall x₀ (2 * (ε / 3)) ∩ v ⁻¹' {0}) :=
      (hv_smooth.continuousOn.mono hcb).preimage_isClosed_of_isClosed Metric.isClosed_closedBall
        isClosed_singleton
    have hZc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3)) ∩ v ⁻¹' {0}) :=
      hDc.of_isClosed_subset hZcl Set.inter_subset_left
    have hx₀Z : x₀ ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩ v ⁻¹' {0} :=
      ⟨Metric.mem_closedBall_self (by linarith), hw0⟩
    obtain ⟨x₁, hx₁Z, hmin⟩ := hZc.exists_isMinOn ⟨x₀, hx₀Z⟩
      (continuous_id.dist continuous_const).continuousOn
    have hmin' := isMinOn_iff.1 hmin
    have hRle : dist x₁ z ≤ dist x₀ z := hmin' x₀ hx₀Z
    have hz' : dist z x₀ < ε / 3 := hz
    have hR : 0 < dist x₁ z := by
      rcases (dist_nonneg (x := x₁) (y := z)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hx1z : x₁ = z := dist_eq_zero.1 h.symm
        apply hwz
        rw [← hx1z]
        exact hx₁Z.2
    have hsub : Metric.closedBall z (dist x₁ z) ⊆ Metric.closedBall x₀ (2 * (ε / 3)) := by
      intro x hx
      rw [Metric.mem_closedBall] at hx ⊢
      have h1 := dist_triangle x z x₀
      rw [dist_comm x₀ z] at hRle
      linarith
    have hpos : ∀ x ∈ Metric.ball z (dist x₁ z), 0 < v x := by
      intro x hx
      have hxD : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) := hsub (Metric.ball_subset_closedBall hx)
      rcases (hnnW x (hcb hxD)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hxZ : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩ v ⁻¹' {0} := ⟨hxD, h.symm⟩
        have h2 : dist x₁ z ≤ dist x z := hmin' x hxZ
        rw [Metric.mem_ball] at hx
        linarith
    exact esm_hopf_touching_super (P.W j) (P.W_open j) A B v hA hB hAs hApos hv_smooth hnnW hsup
      z x₁ (dist x₁ z) hR (hsub.trans hcb) hpos rfl hx₁Z.2
  
  obtain ⟨φ, hφ⟩ : ∃ φ : X → ℝ, ∀ r, φ r = Q p - Q r := ⟨_, fun _ => rfl⟩
  have hφc : ∀ j, ContinuousOn (fun x => φ (P.param j x)) (P.W j) := fun j =>
    (continuousOn_const.sub (hQs j).continuousOn).congr (fun x _ => hφ _)
  have hloc : ∀ j, ∀ x ∈ P.W j, φ (P.param j x) = 0 → ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0 := by
    intro j x hx h0
    rw [hφ] at h0
    have h1 := hsmax j x hx (by linarith)
    exact h1.mono (fun y hy => by rw [hφ, hy]; ring)
  have h0 : φ p = 0 := by rw [hφ]; ring
  have hprop : ∀ r ∈ connectedComponentIn S p, φ r = 0 := by
    intro q hq
    have hA'o : ∀ j, IsOpen ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j) :=
      fun j => isOpen_setOf_eventually_nhds.inter (P.W_open j)
    have hB'o : ∀ j, IsOpen (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ) :=
      fun j => (hφc j).isOpen_inter_preimage (P.W_open j) isOpen_compl_singleton
    have hU₁o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) :=
      isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hA'o j)
    have hU₂o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) :=
      isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hB'o j)
    have hcov : S ⊆ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) ∪
        (⋃ j, (P.O j ∩ P.proj j ⁻¹' (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) := by
      intro r hrS
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hrS)
      obtain ⟨hxW, hxr⟩ := hP2 j r hj hrS
      by_cases hr0 : φ r = 0
      · left
        refine Set.mem_iUnion.2 ⟨j, hj, ?_, hxW⟩
        exact hloc j _ hxW (by rw [hxr]; exact hr0)
      · right
        refine Set.mem_iUnion.2 ⟨j, hj, hxW, ?_⟩
        show φ (P.param j (P.proj j r)) ∈ ({0}ᶜ : Set ℝ)
        rw [hxr]
        exact hr0
    have hU₁z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) → φ r = 0 := by
      intro r hrS hr1
      obtain ⟨j, hj, hA, -⟩ := Set.mem_iUnion.1 hr1
      have hA' : ∀ᶠ y in 𝓝 (P.proj j r), φ (P.param j y) = 0 := hA
      have h1 := hA'.self_of_nhds
      rwa [(hP2 j r hj hrS).2] at h1
    have hU₂z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) → φ r ≠ 0 := by
      intro r hrS hr2
      obtain ⟨j, hj, -, hB⟩ := Set.mem_iUnion.1 hr2
      have h1 : φ (P.param j (P.proj j r)) ≠ 0 := hB
      rwa [(hP2 j r hj hrS).2] at h1
    have hCS : connectedComponentIn S p ⊆ S := connectedComponentIn_subset S p
    have hdisj : connectedComponentIn S p ∩ ((⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) ∩
        (⋃ j, (P.O j ∩ P.proj j ⁻¹' (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ)))) = ∅ := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
      rintro ⟨hxC, hx1, hx2⟩
      exact hU₂z x (hCS hxC) hx2 (hU₁z x (hCS hxC) hx1)
    rcases (isPreconnected_iff_subset_of_disjoint.1 (isPreconnected_connectedComponentIn (F := S)
        (x := p))) _ _ hU₁o hU₂o (hCS.trans hcov) hdisj with h | h
    · exact hU₁z q (hCS hq) (h hq)
    · exact absurd h0 (hU₂z p hp (h (mem_connectedComponentIn hp)))
  
  have hM : Q p ≤ 0 := by
    obtain ⟨j, x, hx, hxc, hKpos⟩ := hK' p hp
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x hx
    have hT : P.param j '' Metric.ball x r ⊆ connectedComponentIn S p := by
      have hpre : IsPreconnected (P.param j '' Metric.ball x r) :=
        (convex_ball x r).isPreconnected.image _ ((P.param_cont j).mono hball)
      have hTS : P.param j '' Metric.ball x r ⊆ S := by
        rintro _ ⟨y, hy, rfl⟩
        exact hP1 j y (hball hy)
      have h1 := hpre.subset_connectedComponentIn ⟨x, Metric.mem_ball_self hr, rfl⟩ hTS
      rwa [← connectedComponentIn_eq hxc] at h1
    have hev : qf j =ᶠ[𝓝 x] fun _ => Q p := by
      filter_upwards [Metric.ball_mem_nhds x hr] with y hy
      rw [← hQ j y (hball hy)]
      have h1 := hprop _ (hT ⟨y, hy, rfl⟩)
      rw [hφ] at h1
      linarith
    have hc0 : ∀ k : Fin 2, pd2 k (fun _ : E2 => Q p) = fun _ => 0 := by
      intro k
      funext y
      simp [pd2]
    have hc00 : ∀ i : Fin 2, pd2 i (fun _ : E2 => (0 : ℝ)) x = 0 := by
      intro i
      simp [pd2]
    have hlap0 : lap2 (P.h j) (qf j) x = 0 := by
      rw [hgerm _ _ _ x hev]
      simp [lap2, hc0, hc00]
    have hqx : qf j x = Q p := hev.self_of_nhds
    have h1 := hboch j x hx
    rw [hlap0, hqx] at h1
    by_contra hcon
    push_neg at hcon
    have h2 := mul_pos (mul_pos (by norm_num : (0 : ℝ) < 2) hKpos) hcon
    linarith
  
  have hq0 : qf j₀ x₀ = 0 := by
    have h1 := hQ j₀ x₀ hx₀
    have h2 := hmax' _ (hP1 j₀ x₀ hx₀)
    have h3 := hq_nonneg j₀ x₀ hx₀
    linarith
  rw [hqdef] at hq0
  have hξ := ((posDef_inv_quad_facts (P.h j₀ x₀) (P.h_posDef j₀ x₀ hx₀)).1
    (fun a => pd2 a (w j₀) x₀)).2 hq0
  have hzero : ∀ a : Fin 2, fderiv ℝ (w j₀) x₀ (e2 a) = 0 := fun a => congrFun hξ a
  apply ContinuousLinearMap.coe_injective
  refine (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis.ext (fun i => ?_)
  simpa using hzero i

theorem patched_conformal_curvature_liftable {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (hS : IsCompact S) (P : EigPatchedSurface X S) (Φ : X → ℝ)
    (hΦs : ∀ j, ContDiffOn ℝ ∞ (fun x => Φ (P.param j x)) (P.W j))
    (hΦp : ∀ q ∈ S, 0 < Φ q)
    (hK : ∀ j, ∀ x ∈ P.W j, 0 ≤ gaussCurv2 (fun y => (Φ (P.param j y)) ^ 2 • P.h j y) x)
    (hK' : ∀ q ∈ S, ∃ j, ∃ x ∈ P.W j, P.param j x ∈ connectedComponentIn S q ∧
      0 < gaussCurv2 (fun y => (Φ (P.param j y)) ^ 2 • P.h j y) x) :
    CircleLiftable S :=
by
  
  have F1 : ∀ (Q : EigPatchedSurface X S) (j k : Fin Q.n) (x : E2), x ∈ Q.W j →
      Q.param j x ∈ Q.O k →
      Q.proj k (Q.param j x) ∈ Q.W k ∧ Q.param k (Q.proj k (Q.param j x)) = Q.param j x := by
    intro Q j k x hx hxk
    have hS' : Q.param j x ∈ Q.O j ∩ S := by
      rw [← Q.image_eq j]; exact ⟨x, hx, rfl⟩
    have hk : Q.param j x ∈ Q.param k '' Q.W k := by
      rw [Q.image_eq k]; exact ⟨hxk, hS'.2⟩
    obtain ⟨y, hy, hyx⟩ := hk
    rw [← hyx, Q.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hparamS : ∀ (Q : EigPatchedSurface X S) (j : Fin Q.n) (x : E2), x ∈ Q.W j →
      Q.param j x ∈ S := by
    intro Q j x hx
    have : Q.param j x ∈ Q.O j ∩ S := by rw [← Q.image_eq j]; exact ⟨x, hx, rfl⟩
    exact this.2
  
  have h_smooth' : ∀ j (a b : Fin 2), ContDiffOn ℝ ∞
      (fun x => ((Φ (P.param j x)) ^ 2 • P.h j x) a b) (P.W j) := by
    intro j a b
    simp only [Matrix.smul_apply, smul_eq_mul]
    exact ((hΦs j).pow 2).mul (P.h_smooth j a b)
  have h_posDef' : ∀ j, ∀ x ∈ P.W j, ((Φ (P.param j x)) ^ 2 • P.h j x).PosDef := by
    intro j x hx
    exact (P.h_posDef j x hx).smul (pow_pos (hΦp _ (hparamS P j x hx)) 2)
  have h_compat' : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, ∀ a b : Fin 2,
      ((Φ (P.param j x)) ^ 2 • P.h j x) a b = ∑ c : Fin 2, ∑ d : Fin 2,
        fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c *
          ((Φ (P.param k (P.proj k (P.param j x)))) ^ 2 • P.h k (P.proj k (P.param j x))) c d *
          fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) d := by
    intro j k x hx a b
    rw [(F1 P j k x hx.1 hx.2).2]
    simp only [Matrix.smul_apply, smul_eq_mul]
    rw [P.h_compat j k x hx a b, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    ring
  let P' : EigPatchedSurface X S :=
    { n := P.n, W := P.W, param := P.param, proj := P.proj, O := P.O,
      h := fun j y => (Φ (P.param j y)) ^ 2 • P.h j y,
      W_open := P.W_open, O_open := P.O_open, param_cont := P.param_cont,
      proj_cont := P.proj_cont, image_eq := P.image_eq, proj_param := P.proj_param,
      cover := P.cover, trans_smooth := P.trans_smooth, h_smooth := h_smooth',
      h_posDef := h_posDef', h_compat := h_compat' }
  
  obtain ⟨m, q, hqS, hqrep⟩ := patched_component_reps S hS P
  have hwit : ∀ i, ∃ j, ∃ x ∈ P.W j, P.param j x ∈ connectedComponentIn S (q i) ∧
      0 < gaussCurv2 (fun y => (Φ (P.param j y)) ^ 2 • P.h j y) x :=
    fun i => hK' (q i) (hqS i)
  choose jm xm hxm hcc hpos using hwit
  
  obtain ⟨P'', ι, hsq, hWsub, hparam, hh, hmark⟩ :=
    eig_patched_square_refine S hS P' m jm xm hxm
  have hK2 : ∀ l, ∀ x ∈ P''.W l, 0 ≤ gaussCurv2 (P''.h l) x := by
    intro l x hx
    rw [hh l]
    exact hK (ι l) x (hWsub l hx)
  have hK3 : ∀ q' ∈ S, ∃ l, ∃ x ∈ P''.W l, P''.param l x ∈ connectedComponentIn S q' ∧
      0 < gaussCurv2 (P''.h l) x := by
    intro q' hq'
    obtain ⟨i, hi⟩ := hqrep q' hq'
    obtain ⟨l, hl1, hl2⟩ := hmark i
    refine ⟨l, xm i, hl2, ?_, ?_⟩
    · rw [hparam l, hl1, connectedComponentIn_eq hi]
      exact hcc i
    · rw [hh l, hl1]
      exact hpos i
  
  intro θ
  obtain ⟨Ψ, ψ, hΨ, hθΨ⟩ := patched_circle_smooth_approx S hS P'' θ
  
  have hconv : ∀ l, Convex ℝ (P''.W l) := by
    intro l
    obtain ⟨a, b, s, hs, heq⟩ := hsq l
    rw [heq]
    intro x hx y hy t r ht hr htr
    have key : ∀ p p' c : ℝ, c < p → c < p' → c < t * p + r * p' := by
      intro p p' c hp hp'
      have hr' : r = 1 - t := by linarith
      subst hr'
      rcases ht.lt_or_eq with ht' | ht'
      · nlinarith [mul_pos ht' (sub_pos.mpr hp), mul_nonneg hr (sub_nonneg.mpr hp'.le)]
      · rw [← ht']; linarith
    have key2 : ∀ p p' c : ℝ, p < c → p' < c → t * p + r * p' < c := by
      intro p p' c hp hp'
      have := key (-p) (-p') (-c) (by linarith) (by linarith)
      linarith
    obtain ⟨hx1, hx2, hx3, hx4⟩ := hx
    obtain ⟨hy1, hy2, hy3, hy4⟩ := hy
    simp only [Set.mem_setOf_eq, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    exact ⟨key _ _ _ hx1 hy1, key2 _ _ _ hx2 hy2, key _ _ _ hx3 hy3, key2 _ _ _ hx4 hy4⟩
  
  have hlift : ∀ l, ∃ θl : E2 → ℝ, ContDiffOn ℝ ∞ θl (P''.W l) ∧
      ∀ x ∈ P''.W l, Ψ (P''.param l x) = Circle.exp (θl x) := fun l =>
    convex_circle_smooth_lift (P''.W l) (P''.W_open l) (hconv l)
      (fun x => Ψ (P''.param l x)) (hΨ l)
  choose θl hθs hθe using hlift
  
  have hOvopen : ∀ l k, IsOpen (P''.W l ∩ P''.param l ⁻¹' P''.O k) := fun l k =>
    (P''.param_cont l).isOpen_inter_preimage (P''.W_open l) (P''.O_open k)
  have hτmaps : ∀ l k, Set.MapsTo (fun x => P''.proj k (P''.param l x))
      (P''.W l ∩ P''.param l ⁻¹' P''.O k) (P''.W k) := fun l k x hx =>
    (F1 P'' l k x hx.1 hx.2).1
  
  have hcompθ : ∀ l k, ∀ x ∈ P''.W l ∩ P''.param l ⁻¹' P''.O k,
      fderiv ℝ (θl l) x = fderiv ℝ (fun x' => θl k (P''.proj k (P''.param l x'))) x := by
    intro l k x hx
    refine circle_exp_eq_fderiv_eq _ (hOvopen l k) (θl l)
      (fun x' => θl k (P''.proj k (P''.param l x')))
      ((hθs l).mono Set.inter_subset_left)
      ((hθs k).comp (P''.trans_smooth l k) (hτmaps l k)) ?_ x hx
    intro y hy
    show Circle.exp (θl l y) = Circle.exp (θl k (P''.proj k (P''.param l y)))
    rw [← hθe l y hy.1, ← hθe k _ (hτmaps l k hy), (F1 P'' l k y hy.1 hy.2).2]
  
  obtain ⟨u, hus, hharm⟩ := patched_dirichlet_harmonic S hS P'' hsq θl hθs hcompθ
  let w : Fin P''.n → E2 → ℝ := fun l x => θl l x - u (P''.param l x)
  have hws : ∀ l, ContDiffOn ℝ ∞ (w l) (P''.W l) := fun l => (hθs l).sub (hus l)
  have hwharm : ∀ l, ∀ x ∈ P''.W l, lap2 (P''.h l) (w l) x = 0 := hharm
  have hwcomp : ∀ l k, ∀ x ∈ P''.W l ∩ P''.param l ⁻¹' P''.O k,
      fderiv ℝ (w l) x = fderiv ℝ (fun x' => w k (P''.proj k (P''.param l x'))) x := by
    intro l k x hx
    have hnx : P''.W l ∩ P''.param l ⁻¹' P''.O k ∈ 𝓝 x := (hOvopen l k).mem_nhds hx
    have hWx : P''.W l ∈ 𝓝 x := (P''.W_open l).mem_nhds hx.1
    have hd1 : DifferentiableAt ℝ (θl l) x :=
      ((hθs l).contDiffAt hWx).differentiableAt (by simp)
    have hd2 : DifferentiableAt ℝ (fun x' => u (P''.param l x')) x :=
      ((hus l).contDiffAt hWx).differentiableAt (by simp)
    have hd3 : DifferentiableAt ℝ (fun x' => θl k (P''.proj k (P''.param l x'))) x :=
      (((hθs k).comp (P''.trans_smooth l k) (hτmaps l k)).contDiffAt hnx).differentiableAt
        (by simp)
    have hev : (fun x' => w k (P''.proj k (P''.param l x'))) =ᶠ[𝓝 x]
        (fun x' => θl k (P''.proj k (P''.param l x'))) - (fun x' => u (P''.param l x')) := by
      filter_upwards [hnx] with y hy
      simp only [w, Pi.sub_apply]
      rw [(F1 P'' l k y hy.1 hy.2).2]
    rw [hev.fderiv_eq, fderiv_sub hd3 hd2]
    show fderiv ℝ ((θl l) - (fun x' => u (P''.param l x'))) x = _
    rw [fderiv_sub hd1 hd2, hcompθ l k x hx]
  
  have hdw := patched_harmonic_form_vanish S hS P'' w hws hwharm hwcomp hK2 hK3
  have hwconst : ∀ l, ∀ x ∈ P''.W l, ∀ y ∈ P''.W l, w l x = w l y := by
    intro l x hx y hy
    exact (P''.W_open l).is_const_of_fderiv_eq_zero (hconv l).isPreconnected
      ((hws l).differentiableOn (by simp)) (fun z hz => hdw l z hz) hx hy
  
  have huc : ContinuousOn u S := by
    intro s hs
    obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (P''.cover hs)
    have hc : ContinuousOn (fun p => u (P''.param l (P''.proj l p))) (P''.O l ∩ S) := by
      refine (hus l).continuousOn.comp ((P''.proj_cont l).mono Set.inter_subset_left) ?_
      intro p hp
      have : p ∈ P''.param l '' P''.W l := by rw [P''.image_eq l]; exact hp
      obtain ⟨y, hy, rfl⟩ := this
      rw [P''.proj_param l y hy]; exact hy
    have hc' : ContinuousOn u (P''.O l ∩ S) := by
      refine hc.congr ?_
      intro p hp
      have : p ∈ P''.param l '' P''.W l := by rw [P''.image_eq l]; exact hp
      obtain ⟨y, hy, rfl⟩ := this
      simp only [P''.proj_param l y hy]
    refine (hc' s ⟨hl, hs⟩).mono_of_mem_nhdsWithin ?_
    rw [Set.inter_comm]
    exact inter_mem_nhdsWithin S ((P''.O_open l).mem_nhds hl)
  
  let Λ : S → Circle := fun s => Ψ s * Circle.exp (-(u s))
  have hΛ : IsLocallyConstant Λ := by
    rw [IsLocallyConstant.iff_exists_open]
    intro s
    obtain ⟨l, hl⟩ := Set.mem_iUnion.1 (P''.cover s.2)
    refine ⟨Subtype.val ⁻¹' P''.O l, (P''.O_open l).preimage continuous_subtype_val, hl, ?_⟩
    have key : ∀ t : S, (t : X) ∈ P''.O l → ∃ y ∈ P''.W l, Λ t = Circle.exp (w l y) := by
      intro t ht
      have : (t : X) ∈ P''.param l '' P''.W l := by rw [P''.image_eq l]; exact ⟨ht, t.2⟩
      obtain ⟨y, hy, hyt⟩ := this
      refine ⟨y, hy, ?_⟩
      simp only [Λ, w]
      rw [← hyt, hθe l y hy, sub_eq_add_neg, Circle.exp_add]
    intro t ht
    obtain ⟨y, hy, hy'⟩ := key t ht
    obtain ⟨y0, hy0, hy0'⟩ := key s hl
    rw [hy', hy0', hwconst l y hy y0 hy0]
  have hcont_c : Continuous (fun s : S => Complex.arg (Λ s : ℂ)) :=
    (hΛ.comp (fun z : Circle => Complex.arg (z : ℂ))).continuous
  have hucS : Continuous (fun s : S => u s) := continuousOn_iff_continuous_restrict.1 huc
  have hcg : ∀ a b c : Circle, a * b * (c * b⁻¹) = c * a := by
    intro a b c
    rw [mul_comm c, ← mul_assoc, mul_assoc a, mul_inv_cancel, mul_one, mul_comm]
  refine ⟨⟨fun s => ψ s + u s + Complex.arg (Λ s : ℂ), (ψ.continuous.add hucS).add hcont_c⟩, ?_⟩
  intro s
  show θ s = Circle.exp (ψ s + u s + Complex.arg (Λ s : ℂ))
  rw [Circle.exp_add, Circle.exp_add, Circle.exp_arg, hθΨ s]
  simp only [Λ, Circle.exp_neg]
  exact (hcg _ _ _).symm

theorem degenerate_component_flat [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U)
    (hfront : IsMinimalSurfaceSet g (frontier U)) (φ lam : M → ℝ)
    (hdata : ∀ p ∈ frontier U, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ frontier U, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
          g.jacobiDeriv f x = lam x / φ x)
    (p₀ : M) (hp₀ : p₀ ∈ frontier U)
    (hdeg : ∀ q ∈ connectedComponentIn (frontier U) p₀, lam q = 0 ∧ g.scalarCurvature q = 0 ∧
      ∃ (z : M) (W : Set E2) (F : E2 → E3) (x : E2), eigSurfParam (frontier U) z W F ∧ x ∈ W ∧
        (chartAt E3 z).symm (F x) = q ∧ gsSffSq (g.coeff (chartAt E3 z).symm) F x = 0 ∧
        fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x = 0)
    (z : M) (W : Set E2) (F : E2 → E3) (hF : eigSurfParam (frontier U) z W F)
    (hFS : ∀ x ∈ W, (chartAt E3 z).symm (F x) ∈ connectedComponentIn (frontier U) p₀) :
    ∀ x ∈ W, gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) x = 0 :=
by
  classical
  
  have hWo : IsOpen W := hF.1
  have hFs : ContDiffOn ℝ ∞ F W := hF.2.1
  have hFt : ∀ y ∈ W, F y ∈ (chartAt E3 z).target := fun y hy => (hF.2.2 y hy).1
  have hFS' : ∀ y ∈ W, (chartAt E3 z).symm (F y) ∈ frontier U := fun y hy => (hF.2.2 y hy).2.1
  have hinj : ∀ y ∈ W, Function.Injective (fderiv ℝ F y) := fun y hy => (hF.2.2 y hy).2.2
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j)
      (chartAt E3 z).target := fun i j => g.smooth z i j
  have hGsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  have hGpos : ∀ y ∈ (chartAt E3 z).target, (g.coeff (chartAt E3 z).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y hy
  
  have hframe : ∀ y ∈ (chartAt E3 z).target, (chartAt E3 z).symm y ∈ frontier U →
      ∃ (U₀ : Set E3) (Φ : E3 → ℝ), IsOpen U₀ ∧ y ∈ U₀ ∧ U₀ ⊆ (chartAt E3 z).target ∧
        ContDiffOn ℝ ∞ Φ U₀ ∧ (∀ w ∈ U₀, fderiv ℝ Φ w ≠ 0) ∧
        ∀ w ∈ U₀, (chartAt E3 z).symm w ∈ frontier U → Φ w = 0 ∧
          φ ((chartAt E3 z).symm w) = ejpPsi (g.coeff (chartAt E3 z).symm) Φ w ∧
          ejpJac (g.coeff (chartAt E3 z).symm) Φ w =
            lam ((chartAt E3 z).symm w) / φ ((chartAt E3 z).symm w) := by
    intro y hyt hyS
    obtain ⟨-, V, f, hVo, hyV, hf, hdf, hVS, hnorm⟩ := hdata _ hyS
    obtain ⟨hfs, htr⟩ := ejp_chart_transfer g z f hf
    have hUo : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V) :=
      (chartAt E3 z).continuousOn_symm.isOpen_inter_preimage (chartAt E3 z).open_target hVo
    refine ⟨(chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V, fun w => f ((chartAt E3 z).symm w),
      hUo, ⟨hyt, hyV⟩, Set.inter_subset_left, hfs.mono Set.inter_subset_left, ?_, ?_⟩
    · rintro w ⟨hwt, hwV⟩
      have hp : (chartAt E3 z).symm w ∈ (chartAt E3 z).source := (chartAt E3 z).map_target hwt
      have h1 := (htr _ hp (hdf _ hwV)).1
      rwa [(chartAt E3 z).right_inv hwt] at h1
    · rintro w ⟨hwt, hwV⟩ hS
      have hp : (chartAt E3 z).symm w ∈ (chartAt E3 z).source := (chartAt E3 z).map_target hwt
      obtain ⟨-, hS', hJ'⟩ := htr _ hp (hdf _ hwV)
      rw [(chartAt E3 z).right_inv hwt] at hS' hJ'
      have hf0 : f ((chartAt E3 z).symm w) = 0 := by
        have h' : (chartAt E3 z).symm w ∈ V ∩ frontier U := ⟨hwV, hS⟩
        rw [hVS] at h'
        exact h'.2
      obtain ⟨hn1, hn2⟩ := hnorm _ ⟨hwV, hS⟩
      refine ⟨hf0, ?_, ?_⟩
      · rw [hS'] at hn1
        unfold ejpPsi
        exact eq_inv_of_mul_eq_one_right hn1
      · rw [← hJ']
        exact hn2
  
  have hlin : ∀ (L₁ L₂ : E2 →L[ℝ] E3) (ℓ m : E3 →L[ℝ] ℝ), Function.Injective L₂ → ℓ ≠ 0 →
      ℓ.comp L₁ = 0 → ℓ.comp L₂ = 0 → m.comp L₂ = 0 → m.comp L₁ = 0 := by
    intro L₁ L₂ ℓ m hinj₂ hℓ h1 h2 hm
    have hle : LinearMap.range (L₂ : E2 →ₗ[ℝ] E3) ≤ LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ) := by
      rintro _ ⟨v, rfl⟩
      have := congrArg (fun L : E2 →L[ℝ] ℝ => L v) h2
      simpa using this
    have hr : Module.finrank ℝ (LinearMap.range (L₂ : E2 →ₗ[ℝ] E3)) = 2 := by
      rw [LinearMap.finrank_range_of_inj hinj₂]
      simp
    have hk : Module.finrank ℝ (LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ)) < 3 := by
      have hlt : LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ) ≠ ⊤ := by
        intro htop
        apply hℓ
        ext v
        have : v ∈ LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ) := htop ▸ Submodule.mem_top
        simpa using this
      have := Submodule.finrank_lt hlt
      simpa using this
    have heq : LinearMap.range (L₂ : E2 →ₗ[ℝ] E3) = LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ) :=
      Submodule.eq_of_le_of_finrank_le hle (by omega)
    ext w
    have hw : (L₁ : E2 →ₗ[ℝ] E3) w ∈ LinearMap.ker (ℓ : E3 →ₗ[ℝ] ℝ) := by
      have := congrArg (fun L : E2 →L[ℝ] ℝ => L w) h1
      simpa using this
    rw [← heq] at hw
    obtain ⟨v, hv⟩ := hw
    have := congrArg (fun L : E2 →L[ℝ] ℝ => L v) hm
    simp only [ContinuousLinearMap.coe_coe] at hv
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply] at this ⊢
    rw [← hv]
    exact this
  
  have hdu : ∀ x' ∈ W, fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x' = 0 := by
    intro x' hx'
    obtain ⟨-, -, z', W', F', x'', hF', hx'', hq'', -, hd'⟩ := hdeg _ (hFS x' hx')
    have hy₀t : F x' ∈ (chartAt E3 z).target := hFt x' hx'
    obtain ⟨U₀, Φ, hU₀o, hy₀U, hU₀t, hΦs, hdΦ, hloc⟩ := hframe _ hy₀t (hFS' x' hx')
    obtain ⟨-, -, hψs, -⟩ := ejp_level_regularity (g.coeff (chartAt E3 z).symm) Φ U₀ hU₀o
      (fun i j => (hGs i j).mono hU₀t) (fun y hy => hGpos y (hU₀t hy)) hΦs hdΦ
    have hw₀t : F' x'' ∈ (chartAt E3 z').target := (hF'.2.2 x'' hx'').1
    have hq'src : (chartAt E3 z').symm (F' x'') ∈ (chartAt E3 z).source := by
      rw [hq'']; exact (chartAt E3 z).map_target hy₀t
    have hq'src' : (chartAt E3 z).symm (F x') ∈ (chartAt E3 z').source := by
      rw [← hq'']; exact (chartAt E3 z').map_target hw₀t
    have hTx : chartAt E3 z ((chartAt E3 z').symm (F' x'')) = F x' := by
      rw [hq'']; exact (chartAt E3 z).right_inv hy₀t
    
    have hD₀o : IsOpen ((chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹' (chartAt E3 z).source) :=
      (chartAt E3 z').continuousOn_symm.isOpen_inter_preimage (chartAt E3 z').open_target
        (chartAt E3 z).open_source
    have hD₁o : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' (chartAt E3 z').source) :=
      (chartAt E3 z).continuousOn_symm.isOpen_inter_preimage (chartAt E3 z).open_target
        (chartAt E3 z').open_source
    have hTs : ContDiffOn ℝ ∞ (fun w => chartAt E3 z ((chartAt E3 z').symm w))
        ((chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹' (chartAt E3 z).source) :=
      contMDiffOn_iff_contDiffOn.mp ((contMDiffOn_chart (x := z)).comp
        (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun w hw => hw.2))
    have hT's : ContDiffOn ℝ ∞ (fun w => chartAt E3 z' ((chartAt E3 z).symm w))
        ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' (chartAt E3 z').source) :=
      contMDiffOn_iff_contDiffOn.mp ((contMDiffOn_chart (x := z')).comp
        (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun w hw => hw.2))
    have hw₀D : F' x'' ∈ (chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹' (chartAt E3 z).source :=
      ⟨hw₀t, hq'src⟩
    have hTd : DifferentiableAt ℝ (fun w => chartAt E3 z ((chartAt E3 z').symm w)) (F' x'') :=
      (hTs.contDiffAt (hD₀o.mem_nhds hw₀D)).differentiableAt (by simp)
    have hy₀D : F x' ∈ (chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' (chartAt E3 z').source :=
      ⟨hy₀t, hq'src'⟩
    have hT'd : DifferentiableAt ℝ (fun w => chartAt E3 z' ((chartAt E3 z).symm w))
        (chartAt E3 z ((chartAt E3 z').symm (F' x''))) := by
      rw [hTx]
      exact (hT's.contDiffAt (hD₁o.mem_nhds hy₀D)).differentiableAt (by simp)
    have hTinj : Function.Injective
        (fderiv ℝ (fun w => chartAt E3 z ((chartAt E3 z').symm w)) (F' x'')) := by
      have hid : ((fun w => chartAt E3 z' ((chartAt E3 z).symm w)) ∘
          (fun w => chartAt E3 z ((chartAt E3 z').symm w))) =ᶠ[𝓝 (F' x'')] id := by
        filter_upwards [hD₀o.mem_nhds hw₀D] with w hw
        simp only [Function.comp_apply, id_eq]
        rw [(chartAt E3 z).left_inv hw.2, (chartAt E3 z').right_inv hw.1]
      have hc := fderiv_comp (F' x'') hT'd hTd
      rw [hid.fderiv_eq, fderiv_id] at hc
      intro v₁ v₂ hv
      have e1 := congrArg (fun L : E3 →L[ℝ] E3 => L v₁) hc
      have e2 := congrArg (fun L : E3 →L[ℝ] E3 => L v₂) hc
      simp only [ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply] at e1 e2
      rw [e1, e2, hv]
    have hF'd : DifferentiableAt ℝ F' x'' :=
      (hF'.2.1.contDiffAt (hF'.1.mem_nhds hx'')).differentiableAt (by simp)
    have hF''d : DifferentiableAt ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'' :=
      hTd.comp x'' hF'd
    have hL₂ : fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'' =
        (fderiv ℝ (fun w => chartAt E3 z ((chartAt E3 z').symm w)) (F' x'')).comp
          (fderiv ℝ F' x'') :=
      fderiv_comp x'' hTd hF'd
    have hL₂inj : Function.Injective
        (fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'') := by
      rw [hL₂, ContinuousLinearMap.coe_comp']
      exact hTinj.comp (hF'.2.2 x'' hx'').2.2
    
    have hs₂o : IsOpen (W' ∩ F' ⁻¹' ((chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹'
        ((chartAt E3 z).source ∩ chartAt E3 z ⁻¹' U₀))) := by
      have h1 : IsOpen ((chartAt E3 z).source ∩ chartAt E3 z ⁻¹' U₀) :=
        (chartAt E3 z).continuousOn.isOpen_inter_preimage (chartAt E3 z).open_source hU₀o
      have h2 := (chartAt E3 z').continuousOn_symm.isOpen_inter_preimage
        (chartAt E3 z').open_target h1
      exact hF'.2.1.continuousOn.isOpen_inter_preimage hF'.1 h2
    have hx''s : x'' ∈ W' ∩ F' ⁻¹' ((chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹'
        ((chartAt E3 z).source ∩ chartAt E3 z ⁻¹' U₀)) := by
      refine ⟨hx'', hw₀t, hq'src, ?_⟩
      show chartAt E3 z ((chartAt E3 z').symm (F' x'')) ∈ U₀
      rw [hTx]
      exact hy₀U
    have hon₂ : ∀ y ∈ W' ∩ F' ⁻¹' ((chartAt E3 z').target ∩ (chartAt E3 z').symm ⁻¹'
        ((chartAt E3 z).source ∩ chartAt E3 z ⁻¹' U₀)),
        chartAt E3 z ((chartAt E3 z').symm (F' y)) ∈ U₀ ∧
        (chartAt E3 z).symm (chartAt E3 z ((chartAt E3 z').symm (F' y))) =
          (chartAt E3 z').symm (F' y) ∧
        (chartAt E3 z').symm (F' y) ∈ frontier U := by
      rintro y ⟨hyW, -, hysrc, hyU⟩
      exact ⟨hyU, (chartAt E3 z).left_inv hysrc, (hF'.2.2 y hyW).2.1⟩
    have hΦ0₂ : (fun y => Φ (chartAt E3 z ((chartAt E3 z').symm (F' y)))) =ᶠ[𝓝 x'']
        fun _ => (0 : ℝ) := by
      filter_upwards [hs₂o.mem_nhds hx''s] with y hy
      obtain ⟨hyU, hyl, hyS⟩ := hon₂ y hy
      exact (hloc _ hyU (by rw [hyl]; exact hyS)).1
    have hψ₂ : (fun y => φ ((chartAt E3 z').symm (F' y))) =ᶠ[𝓝 x'']
        fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ
          (chartAt E3 z ((chartAt E3 z').symm (F' y))) := by
      filter_upwards [hs₂o.mem_nhds hx''s] with y hy
      obtain ⟨hyU, hyl, hyS⟩ := hon₂ y hy
      have := (hloc _ hyU (by rw [hyl]; exact hyS)).2.1
      rw [hyl] at this
      exact this
    
    have hs₁o : IsOpen (W ∩ F ⁻¹' U₀) := hFs.continuousOn.isOpen_inter_preimage hWo hU₀o
    have hx's : x' ∈ W ∩ F ⁻¹' U₀ := ⟨hx', hy₀U⟩
    have hΦ0₁ : (fun y => Φ (F y)) =ᶠ[𝓝 x'] fun _ => (0 : ℝ) := by
      filter_upwards [hs₁o.mem_nhds hx's] with y hy
      exact (hloc _ hy.2 (hFS' y hy.1)).1
    have hψ₁ : (fun y => φ ((chartAt E3 z).symm (F y))) =ᶠ[𝓝 x']
        fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F y) := by
      filter_upwards [hs₁o.mem_nhds hx's] with y hy
      exact (hloc _ hy.2 (hFS' y hy.1)).2.1
    have hΦd : DifferentiableAt ℝ Φ (F x') :=
      (hΦs.contDiffAt (hU₀o.mem_nhds hy₀U)).differentiableAt (by simp)
    have hψd : DifferentiableAt ℝ (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) (F x') :=
      (hψs.contDiffAt (hU₀o.mem_nhds hy₀U)).differentiableAt (by simp)
    have hFd : DifferentiableAt ℝ F x' :=
      (hFs.contDiffAt (hWo.mem_nhds hx')).differentiableAt (by simp)
    have hΦd' : DifferentiableAt ℝ Φ (chartAt E3 z ((chartAt E3 z').symm (F' x''))) := by
      rw [hTx]; exact hΦd
    have hψd' : DifferentiableAt ℝ (ejpPsi (g.coeff (chartAt E3 z).symm) Φ)
        (chartAt E3 z ((chartAt E3 z').symm (F' x''))) := by
      rw [hTx]; exact hψd
    have h1 : (fderiv ℝ Φ (F x')).comp (fderiv ℝ F x') = 0 := by
      have hc : fderiv ℝ (fun y => Φ (F y)) x' = (fderiv ℝ Φ (F x')).comp (fderiv ℝ F x') :=
        fderiv_comp x' hΦd hFd
      rw [← hc, hΦ0₁.fderiv_eq]
      exact fderiv_const_apply _
    have h2 : (fderiv ℝ Φ (F x')).comp
        (fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'') = 0 := by
      have hc : fderiv ℝ (fun y => Φ (chartAt E3 z ((chartAt E3 z').symm (F' y)))) x'' =
          (fderiv ℝ Φ (F x')).comp
            (fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'') := by
        rw [← hTx]; exact fderiv_comp x'' hΦd' hF''d
      rw [← hc, hΦ0₂.fderiv_eq]
      exact fderiv_const_apply _
    have h3 : (fderiv ℝ (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) (F x')).comp
        (fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'') = 0 := by
      have hc : fderiv ℝ (fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ
          (chartAt E3 z ((chartAt E3 z').symm (F' y)))) x'' =
          (fderiv ℝ (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) (F x')).comp
            (fderiv ℝ (fun y => chartAt E3 z ((chartAt E3 z').symm (F' y))) x'') := by
        rw [← hTx]; exact fderiv_comp x'' hψd' hF''d
      rw [← hc, ← hψ₂.fderiv_eq]
      exact hd'
    have hc1 : fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x' =
        (fderiv ℝ (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) (F x')).comp (fderiv ℝ F x') := by
      rw [hψ₁.fderiv_eq]; exact fderiv_comp x' hψd hFd
    rw [hc1]
    exact hlin _ _ _ _ hL₂inj (hdΦ _ hy₀U) h1 h2 h3
  
  have hsffP : ∀ (z₀ : M) (W₀ : Set E2) (F₀ : E2 → E3) (x₀ : E2),
      eigSurfParam (frontier U) z₀ W₀ F₀ → x₀ ∈ W₀ →
      ∀ (V : Set M) (f : M → ℝ), IsOpen V → (chartAt E3 z₀).symm (F₀ x₀) ∈ V →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) →
      V ∩ frontier U = V ∩ f ⁻¹' {0} →
      secondFundSq (g.coeff (chartAt E3 z₀).symm) (fun y => f ((chartAt E3 z₀).symm y)) (F₀ x₀) =
          gsSffSq (g.coeff (chartAt E3 z₀).symm) F₀ x₀ ∧
        (levelMeanCurvCoord (g.coeff (chartAt E3 z₀).symm) (fun y => f ((chartAt E3 z₀).symm y))
          (F₀ x₀) = 0 ↔ gsMeanCurv (g.coeff (chartAt E3 z₀).symm) F₀ x₀ = 0) := by
    intro z₀ W₀ F₀ x₀ hF₀ hx₀ V f hVo hV hf hdf hVS
    obtain ⟨hfs, htr⟩ := ejp_chart_transfer g z₀ f hf
    have hFt₀ : F₀ x₀ ∈ (chartAt E3 z₀).target := (hF₀.2.2 x₀ hx₀).1
    have hp₀ : (chartAt E3 z₀).symm (F₀ x₀) ∈ (chartAt E3 z₀).source :=
      (chartAt E3 z₀).map_target hFt₀
    have hdf' := (htr _ hp₀ (hdf _ hV)).1
    rw [(chartAt E3 z₀).right_inv hFt₀] at hdf'
    have hf2 : ContDiffAt ℝ 2 (fun y => f ((chartAt E3 z₀).symm y)) (F₀ x₀) :=
      (hfs.contDiffAt ((chartAt E3 z₀).open_target.mem_nhds hFt₀)).of_le
        (WithTop.coe_le_coe.mpr le_top)
    have hUo : IsOpen ((chartAt E3 z₀).target ∩ (chartAt E3 z₀).symm ⁻¹' V) :=
      (chartAt E3 z₀).continuousOn_symm.isOpen_inter_preimage (chartAt E3 z₀).open_target hVo
    have hso : IsOpen (W₀ ∩ F₀ ⁻¹' ((chartAt E3 z₀).target ∩ (chartAt E3 z₀).symm ⁻¹' V)) :=
      hF₀.2.1.continuousOn.isOpen_inter_preimage hF₀.1 hUo
    have hxs : x₀ ∈ W₀ ∩ F₀ ⁻¹' ((chartAt E3 z₀).target ∩ (chartAt E3 z₀).symm ⁻¹' V) :=
      ⟨hx₀, hFt₀, hV⟩
    have hzero : ∀ᶠ y in 𝓝 x₀, f ((chartAt E3 z₀).symm (F₀ y)) = 0 := by
      filter_upwards [hso.mem_nhds hxs] with y hy
      have h' : (chartAt E3 z₀).symm (F₀ y) ∈ V ∩ frontier U := ⟨hy.2.2, (hF₀.2.2 y hy.1).2.1⟩
      rw [hVS] at h'
      exact h'.2
    exact gs_levelset_param (g.coeff (chartAt E3 z₀).symm) F₀ (fun y => f ((chartAt E3 z₀).symm y))
      _ hso x₀ hxs (hF₀.2.1.mono Set.inter_subset_left) (hF₀.2.2 x₀ hx₀).2.2
      (fun y i j => g.symm _ _ _) (coeff_chart_symm_posDef g z₀ _ hFt₀) hf2 hdf' hzero
  
  intro x hx
  have hq : (chartAt E3 z).symm (F x) ∈ frontier U := hFS' x hx
  obtain ⟨hlam0, hR0, z₁, W₁, F₁, x₁, hF₁, hx₁, hq₁, hA₁, -⟩ := hdeg _ (hFS x hx)
  have hqsrc : (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source :=
    (chartAt E3 z).map_target (hFt x hx)
  
  have hFt₁ : F₁ x₁ ∈ (chartAt E3 z₁).target := (hF₁.2.2 x₁ hx₁).1
  have hqsrc₁ : (chartAt E3 z).symm (F x) ∈ (chartAt E3 z₁).source := by
    rw [← hq₁]; exact (chartAt E3 z₁).map_target hFt₁
  obtain ⟨t₁, -, hA2z, hA2q⟩ := surfA2_chart_invariant g (frontier U) hfront z _ hq hqsrc
  obtain ⟨t₂, -, hA2z₁, hA2q₁⟩ := surfA2_chart_invariant g (frontier U) hfront z₁ _ hq hqsrc₁
  have hOn : (chartAt E3 z).source ∩ (chartAt E3 z₁).source ∩
      (chartAt E3 ((chartAt E3 z).symm (F x))).source ∈ 𝓝 ((chartAt E3 z).symm (F x)) :=
    Filter.inter_mem (Filter.inter_mem ((chartAt E3 z).open_source.mem_nhds hqsrc)
      ((chartAt E3 z₁).open_source.mem_nhds hqsrc₁)) (chart_source_mem_nhds E3 _)
  obtain ⟨V, f, hVO, hVo, hqV, hf, hdf, hVS, -⟩ := hfront.2 _ hq _ hOn
  have ht : t₁ = t₂ := by
    rw [← hA2q V f hVo hqV (fun y hy => (hVO hy).2) hf hdf hVS,
      ← hA2q₁ V f hVo hqV (fun y hy => (hVO hy).2) hf hdf hVS]
  have hA : gsSffSq (g.coeff (chartAt E3 z).symm) F x = 0 := by
    have e1 := hA2z V f hVo hqV (fun y hy => (hVO hy).1.1) hf hdf hVS
    rw [(chartAt E3 z).right_inv (hFt x hx)] at e1
    have e2 := hA2z₁ V f hVo hqV (fun y hy => (hVO hy).1.2) hf hdf hVS
    rw [← hq₁, (chartAt E3 z₁).right_inv hFt₁] at e2
    rw [← (hsffP z W F x hF hx V f hVo hqV hf hdf hVS).1, e1, ht, ← e2,
      (hsffP z₁ W₁ F₁ x₁ hF₁ hx₁ V f hVo (by rw [hq₁]; exact hqV) hf hdf hVS).1]
    exact hA₁
  
  obtain ⟨V₁, f₁, -, hV₁o, hqV₁, hf₁, hdf₁, hV₁S, hH₁, -, -⟩ :=
    hfront.2 _ hq Set.univ Filter.univ_mem
  have hf₁q : f₁ ((chartAt E3 z).symm (F x)) = 0 := by
    have h' : (chartAt E3 z).symm (F x) ∈ V₁ ∩ frontier U := ⟨hqV₁, hq⟩
    rw [hV₁S] at h'
    exact h'.2
  have hlmc := hH₁ _ hqV₁ hf₁q
  obtain ⟨-, hcunc⟩ := chart_unit_normal_calculus g V₁ f₁ hV₁o hf₁.contMDiffOn hdf₁ z
  have hc2 := (hcunc _ ⟨hqV₁, hqsrc⟩).2.1
  rw [(chartAt E3 z).right_inv (hFt x hx), hlmc] at hc2
  have hH : gsMeanCurv (g.coeff (chartAt E3 z).symm) F x = 0 :=
    (hsffP z W F x hF hx V₁ f₁ hV₁o hqV₁ hf₁ hdf₁ hV₁S).2.mp hc2.symm
  
  obtain ⟨U₀, Φ, hU, hFxU, hUt, hΦ, hdΦ, hloc⟩ := hframe _ (hFt x hx) hq
  have hGU : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j) U₀ :=
    fun i j => (hGs i j).mono hUt
  have hGposU : ∀ y ∈ U₀, (g.coeff (chartAt E3 z).symm y).PosDef := fun y hy => hGpos y (hUt hy)
  obtain ⟨-, -, hψ, -⟩ :=
    ejp_level_regularity (g.coeff (chartAt E3 z).symm) Φ U₀ hU hGU hGposU hΦ hdΦ
  have hs : IsOpen (W ∩ F ⁻¹' U₀) := hFs.continuousOn.isOpen_inter_preimage hWo hU
  have hxs : x ∈ W ∩ F ⁻¹' U₀ := ⟨hx, hFxU⟩
  obtain ⟨-, hux, hjac⟩ := hloc _ hFxU hq
  have hzero : ∀ᶠ y in 𝓝 x, Φ (F y) = 0 :=
    Filter.eventually_of_mem (hs.mem_nhds hxs) (fun y hy => (hloc _ hy.2 (hFS' y hy.1)).1)
  have hev : (fun y => φ ((chartAt E3 z).symm (F y))) =ᶠ[𝓝 x]
      (fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F y)) :=
    Filter.eventually_of_mem (hs.mem_nhds hxs) (fun y hy => (hloc _ hy.2 (hFS' y hy.1)).2.1)
  have hu0 : 0 < φ ((chartAt E3 z).symm (F x)) := (hdata _ hq).1
  have hlapc : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w₁ w₂ : E2 → ℝ), w₁ =ᶠ[𝓝 x] w₂ →
      lap2 h w₁ x = lap2 h w₂ x := by
    intro h w₁ w₂ hw
    have h1 : ∀ i j : Fin 2, pd2 i (pd2 j w₁) x = pd2 i (pd2 j w₂) x := by
      intro i j
      have hj : pd2 j w₁ =ᶠ[𝓝 x] pd2 j w₂ := by
        filter_upwards [hw.eventuallyEq_nhds] with y hy
        show fderiv ℝ w₁ y (e2 j) = fderiv ℝ w₂ y (e2 j)
        rw [hy.fderiv_eq]
      show fderiv ℝ (pd2 j w₁) x (e2 i) = fderiv ℝ (pd2 j w₂) x (e2 i)
      rw [hj.fderiv_eq]
    have h2 : ∀ k : Fin 2, pd2 k w₁ x = pd2 k w₂ x := by
      intro k
      show fderiv ℝ w₁ x (e2 k) = fderiv ℝ w₂ x (e2 k)
      rw [hw.fderiv_eq]
    simp only [lap2, h1, h2]
  have hlapψ := ejp_immersion_lap2 (g.coeff (chartAt E3 z).symm) Φ
    (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) U₀ hU hGU hGsymm hGposU hΦ hdΦ hψ F
    (W ∩ F ⁻¹' U₀) hs (hFs.mono Set.inter_subset_left)
    (fun y hy => ⟨hy.2, (hloc _ hy.2 (hFS' y hy.1)).1, hinj y hy.1⟩) x hxs
  have hamb := ejp_ambient_identity (g.coeff (chartAt E3 z).symm) Φ U₀ hU hGU hGsymm hGposU
    hΦ hdΦ (F x) hFxU
  rw [← hux, hjac] at hamb
  have hL : lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun y => φ ((chartAt E3 z).symm (F y))) x =
      -(ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x)) * φ ((chartAt E3 z).symm (F x)) -
        φ ((chartAt E3 z).symm (F x)) * lam ((chartAt E3 z).symm (F x)) := by
    rw [hlapc _ _ _ hev, hlapψ]
    have e1 : φ ((chartAt E3 z).symm (F x)) ^ 2 *
        (lam ((chartAt E3 z).symm (F x)) / φ ((chartAt E3 z).symm (F x))) =
        φ ((chartAt E3 z).symm (F x)) * lam ((chartAt E3 z).symm (F x)) := by
      field_simp <;> ring
    linear_combination hamb - e1
  
  have hlap0 : lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun y => φ ((chartAt E3 z).symm (F y))) x = 0 := by
    have hpd1 : ∀ k : Fin 2, pd2 k (fun y => φ ((chartAt E3 z).symm (F y))) x = 0 := by
      intro k
      show fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x (e2 k) = 0
      rw [hdu x hx]
      simp
    have hpd2 : ∀ i j : Fin 2,
        pd2 i (pd2 j (fun y => φ ((chartAt E3 z).symm (F y)))) x = 0 := by
      intro i j
      have hj : pd2 j (fun y => φ ((chartAt E3 z).symm (F y))) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [hWo.mem_nhds hx] with y hy
        show fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) y (e2 j) = 0
        rw [hdu y hy]
        simp
      show fderiv ℝ (pd2 j (fun y => φ ((chartAt E3 z).symm (F y)))) x (e2 i) = 0
      rw [hj.fderiv_eq, fderiv_const_apply]
      simp
    simp only [lap2, hpd1, hpd2]
    simp
  
  have hΦ2 : ContDiffAt ℝ 2 Φ (F x) :=
    (hΦ.contDiffAt (hU.mem_nhds hFxU)).of_le (WithTop.coe_le_coe.mpr le_top)
  have hsff := (gs_levelset_param (g.coeff (chartAt E3 z).symm) F Φ (W ∩ F ⁻¹' U₀) hs x hxs
    (hFs.mono Set.inter_subset_left) (hinj x hx) hGsymm (hGpos _ (hFt x hx)) hΦ2
    (hdΦ _ hFxU) hzero).1
  have hpot : ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x) =
      gsSffSq (g.coeff (chartAt E3 z).symm) F x +
        ejpRic (g.coeff (chartAt E3 z).symm) Φ (F x) := by
    rw [← hsff]
    rfl
  
  have htan : ∀ i : Fin 2, fderiv ℝ Φ (F x) (fderiv ℝ F x (e2 i)) = 0 := by
    intro i
    have hΦd : DifferentiableAt ℝ Φ (F x) :=
      (hΦ.contDiffAt (hU.mem_nhds hFxU)).differentiableAt (by simp)
    have hFd : DifferentiableAt ℝ F x :=
      (hFs.contDiffAt (hWo.mem_nhds hx)).differentiableAt (by simp)
    have hc : fderiv ℝ (fun y => Φ (F y)) x = (fderiv ℝ Φ (F x)).comp (fderiv ℝ F x) :=
      fderiv_comp x hΦd hFd
    have h0 : fderiv ℝ (fun y => Φ (F y)) x = 0 := by
      rw [(show (fun y => Φ (F y)) =ᶠ[𝓝 x] fun _ => (0 : ℝ) from hzero).fderiv_eq]
      exact fderiv_const_apply _
    have h3 := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) (hc.symm.trans h0)
    simpa using h3
  have htrace := jcc_scalar_trace (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target
    (chartAt E3 z).open_target hGs hGsymm hGpos Φ F x (hFt x hx) (hinj x hx) (hdΦ _ hFxU) htan
  let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    { toPartialEquiv := (chartAt E3 z).symm.toPartialEquiv
      open_source := (chartAt E3 z).open_target
      open_target := (chartAt E3 z).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  have hR : g.scalarCurvature ((chartAt E3 z).symm (F x)) =
      scalarCurvatureLocal (g.coeff (chartAt E3 z).symm) (F x) :=
    scalarCurvature_eq_scalarCurvatureLocal_coeff g Φc (F x) (hFt x hx)
  
  have hgauss := gs_gauss_equation (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target
    (chartAt E3 z).open_target hGs hGsymm hGpos F W hWo hFs hFt hinj x hx
  
  have hPu : ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x) * φ ((chartAt E3 z).symm (F x)) = 0 := by
    have h := hL
    rw [hlap0, hlam0] at h
    linear_combination h
  have hP0 : ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x) = 0 :=
    (mul_eq_zero.mp hPu).resolve_right hu0.ne'
  have hRic0 : ejpRic (g.coeff (chartAt E3 z).symm) Φ (F x) = 0 := by
    rw [hpot, hA] at hP0
    linarith
  have hR' : scalarCurvatureLocal (g.coeff (chartAt E3 z).symm) (F x) = 0 := by
    rw [← hR]
    exact hR0
  have hAmb : gsAmbPlane (g.coeff (chartAt E3 z).symm) F x /
      (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det = 0 := by
    rw [htrace, hRic0, mul_div_assoc] at hR'
    linarith
  rw [hgauss, hAmb, hH, hA]
  ring

theorem coeff_posDef [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3) (hy : y ∈ φ.source) :
    (g.coeff φ y).PosDef :=
by
  classical
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ φ hy
  have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y w = 0 → w = 0 := by
    intro w hw
    have hL : ∀ u : E3, (hloc.mfderivToContinuousLinearEquiv hn) u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u := by
      intro u
      rw [← hloc.mfderivToContinuousLinearEquiv_coe hn]
      rfl
    apply (hloc.mfderivToContinuousLinearEquiv hn).injective
    rw [hL, hw, map_zero]
  apply Matrix.PosDef.of_dotProduct_mulVec_pos
  · apply Matrix.IsHermitian.ext
    intro i j
    simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
    exact g.symm _ _ _
  · intro x hx
    have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
      intro h0
      apply hx
      funext j
      have h1 := congrArg (fun u : E3 => u j) h0
      fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
    have hDv := fun h => hvx (hDinj _ h)
    have hpos := g.posDef (φ y) _ hDv
    have key : star x ⬝ᵥ (g.coeff φ y).mulVec x =
        g.g (φ y)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3)) := by
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
        ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
        RiemannianMetric3.coeff, coeffMatrix]
      ring
    rw [key]
    exact hpos

theorem coeff_comp_apply [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Φ : E3 → M)
    (τ : E3 → E3) (y : E3) (hτ : DifferentiableAt ℝ τ y)
    (hΦ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y)) (i j : Fin 3) :
    g.coeff (Φ ∘ τ) y i j = ∑ a : Fin 3, ∑ b : Fin 3,
      fderiv ℝ τ y (e i) a * g.coeff Φ (τ y) a b * fderiv ℝ τ y (e j) b :=
by
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    ext k
    simp [EuclideanSpace.single_apply, Pi.single_apply]
  set L : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y) with hLdef
  set B : E3 →L[ℝ] E3 →L[ℝ] ℝ := g.g (Φ (τ y)) with hBdef
  have hL : ∀ v : E3, L v = ∑ a : Fin 3, v a • L (e a) := by
    intro v
    conv_lhs => rw [hexp v]
    rw [map_sum]
    simp only [map_smul]
  have hchain : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y v = L (fderiv ℝ τ y v) := by
    intro v
    rw [mfderiv_comp_apply y hΦ hτ.mdifferentiableAt, mfderiv_eq_fderiv]
    rfl
  have hlhs : g.coeff (Φ ∘ τ) y i j = B (L (fderiv ℝ τ y (e i))) (L (fderiv ℝ τ y (e j))) := by
    show g.g (Φ (τ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e i))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e j)) = _
    rw [hchain, hchain]
  have hc : ∀ a b : Fin 3, g.coeff Φ (τ y) a b = B (L (e a)) (L (e b)) := fun a b => rfl
  rw [hlhs, hL (fderiv ℝ τ y (e i)), hL (fderiv ℝ τ y (e j))]
  simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
    smul_eq_mul, Finset.mul_sum, hc]
  conv_lhs => rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
  ring

theorem normalized_gradient_smooth [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) :
    ∃ Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x,
      (∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), Ng x (-ℓ) = -Ng x ℓ) ∧
      (∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → ℓ (Ng x ℓ) = 1) ∧
      ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
        (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
        ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
          (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x :=
by
  classical
  
  have vec_expand : ∀ v : E3, v = ∑ i : Fin 3, v i • e i := by
    intro v
    ext j
    simp [Pi.single_apply]
  have bil_expand : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (z c : Fin 3 → ℝ),
      B (∑ a, z a • e a) (∑ b, c b • e b) =
        dotProduct z (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b)) c) := by
    intro B z c
    simp [map_sum, map_smul, ContinuousLinearMap.sum_apply, Matrix.mulVec, dotProduct,
      Finset.mul_sum, mul_comm, mul_left_comm]
    rw [Finset.sum_comm]
  have lin_expand : ∀ (ℓ : E3 →L[ℝ] ℝ) (c : Fin 3 → ℝ),
      ℓ (∑ b, c b • e b) = ∑ b, c b * ℓ (e b) := by
    intro ℓ c
    simp [map_sum, map_smul]
  have bil_detpos : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) →
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 := by
    intro B hB hdet
    obtain ⟨z, hz0, hz⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hv : (∑ a, z a • e a) ≠ 0 := by
      intro h0; apply hz0; funext j
      have := congrArg (fun v : E3 => v j) h0
      simpa [EuclideanSpace.single_apply, Pi.single_apply] using this
    have := hB _ hv
    rw [bil_expand, hz] at this
    simp at this
  have bil_riesz : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (ξ : Fin 3 → ℝ),
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 → ∀ v : E3,
      B v (∑ i, (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b))⁻¹ ξ) i • e i) =
        ∑ j, v j * ξ j := by
    intro B ξ hdet v
    conv_lhs => rw [vec_expand v]
    rw [bil_expand, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet),
      Matrix.one_mulVec]
    simp [dotProduct]
  have bil_unique : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) → ∀ w₁ w₂ : E3,
      (∀ v, B v w₁ = B v w₂) → w₁ = w₂ := by
    intro B hB w₁ w₂ h
    by_contra hne
    have := hB (w₁ - w₂) (sub_ne_zero.mpr hne)
    rw [(B (w₁ - w₂)).map_sub w₁ w₂, h (w₁ - w₂), sub_self] at this
    exact lt_irrefl _ this
  
  have det_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ ∞ (fun y => H y i j) y₀) →
      ContDiffAt ℝ ∞ (fun y => (H y).det) y₀ := by
    intro H y₀ hH
    have : (fun y => (H y).det) = fun y => ∑ σ : Equiv.Perm (Fin 3),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, H y (σ i) i := by
      funext y; exact Matrix.det_apply' _
    rw [this]
    refine ContDiffAt.sum fun σ _ => contDiffAt_const.mul ?_
    exact contDiffAt_prod fun i _ => hH _ _
  have inv_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ ∞ (fun y => H y i j) y₀) → (H y₀).det ≠ 0 → ∀ i k : Fin 3,
      ContDiffAt ℝ ∞ (fun y => (H y)⁻¹ i k) y₀ := by
    intro H y₀ hH hd i k
    have hinv : ∀ y, (H y)⁻¹ i k = ((H y).det)⁻¹ * (H y).adjugate i k := by
      intro y
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
      simp [Matrix.smul_apply]
    simp only [hinv]
    refine ((det_contDiffAt H y₀ hH).inv hd).mul ?_
    simp only [Matrix.adjugate_apply]
    refine det_contDiffAt _ y₀ fun a b => ?_
    by_cases h : a = k
    · subst h; simp [Matrix.updateRow_apply, contDiffAt_const]
    · simp only [Matrix.updateRow_apply, h, if_false]; exact hH a b
  
  have chart_inv : ∀ (x₀ x : M), x ∈ (chartAt E3 x₀).source →
      (∀ u, tangentCoordChange 𝓘(ℝ, E3) x x₀ x
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) u) = u) ∧
      (∀ v, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
        (tangentCoordChange 𝓘(ℝ, E3) x x₀ x v) = v) := by
    intro x₀ x hx
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hx
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hx
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 x₀) hx
    have hT : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x =
        tangentCoordChange 𝓘(ℝ, E3) x x₀ x :=
      mfderiv_chartAt_eq_tangentCoordChange hx
    constructor
    · intro u
      have hd2' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀)
          ((chartAt E3 x₀).symm (chartAt E3 x₀ x)) := by rw [hxy]; exact hd2
      have hc := mfderiv_comp (chartAt E3 x₀ x) hd2' hd1
      have hid : ((chartAt E3 x₀) ∘ (chartAt E3 x₀).symm) =ᶠ[𝓝 (chartAt E3 x₀ x)] id := by
        filter_upwards [(chartAt E3 x₀).eventually_right_inverse hy] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hxy, hT] at hc
      have := congrArg (fun L => L u) hc
      simpa using this.symm
    · intro v
      have hc := mfderiv_comp x hd1 hd2
      have hid : ((chartAt E3 x₀).symm ∘ (chartAt E3 x₀)) =ᶠ[𝓝 x] id := by
        filter_upwards [(chartAt E3 x₀).eventually_left_inverse hx] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hT] at hc
      have := congrArg (fun L => L v) hc
      simpa using this.symm
  
  have section_cmd : ∀ (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (x₀ : M) (W : E3 → E3),
      ContDiffAt ℝ ∞ W (chartAt E3 x₀ x₀) →
      (∀ᶠ x in 𝓝 x₀, tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x)) →
      ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
        (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀ := by
    intro V x₀ W hW hV
    rw [Bundle.contMDiffAt_section]
    have hc : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 x₀) x₀ := by
      have := contMDiffAt_extChartAt (I := 𝓘(ℝ, E3)) (n := ∞) (x := x₀)
      simpa [extChartAt_coe] using this
    have h1 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun x => W (chartAt E3 x₀ x)) x₀ :=
      hW.contMDiffAt.comp x₀ hc
    refine h1.congr_of_eventuallyEq ?_
    filter_upwards [hV] with x hx
    rw [← hx, tangentCoordChange_def, TangentBundle.trivializationAt_apply]
    rfl
  
  let wf : (x : M) → (E3 →L[ℝ] ℝ) → E3 := fun x ℓ =>
    ∑ i, (Matrix.mulVec (Matrix.of fun a b => g.g x (e a) (e b))⁻¹ (fun j => ℓ (e j))) i • e i
  have hwR : ∀ x (ℓ : E3 →L[ℝ] ℝ) v, g.g x v (wf x ℓ) = ℓ v := by
    intro x ℓ v
    have h1 := bil_riesz (g.g x) (fun j => ℓ (e j)) (bil_detpos _ (g.posDef x)) v
    calc g.g x v (wf x ℓ) = ∑ j, v j * ℓ (e j) := h1
      _ = ℓ (∑ i, v i • e i) := (lin_expand ℓ (fun i => v i)).symm
      _ = ℓ v := by rw [← vec_expand v]
  have hposℓ : ∀ x (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → 0 < ℓ (wf x ℓ) := by
    intro x ℓ hℓ
    have hw0 : wf x ℓ ≠ 0 := by
      intro h0
      apply hℓ
      ext v
      have := hwR x ℓ v
      rw [h0, map_zero] at this
      simpa using this.symm
    have := g.posDef x (wf x ℓ) hw0
    rwa [hwR] at this
  refine ⟨fun x ℓ => (ℓ (wf x ℓ))⁻¹ • wf x ℓ, ?_, ?_, ?_⟩
  · 
    intro x ℓ
    have hneg : wf x (-ℓ) = -wf x ℓ := by
      refine bil_unique (g.g x) (g.posDef x) _ _ (fun v => ?_)
      rw [hwR, map_neg, hwR]
      rfl
    show ((-ℓ) (wf x (-ℓ)))⁻¹ • wf x (-ℓ) = -((ℓ (wf x ℓ))⁻¹ • wf x ℓ)
    rw [hneg, ContinuousLinearMap.neg_apply, map_neg, neg_neg, smul_neg]
  · 
    intro x ℓ hℓ
    show ℓ ((ℓ (wf x ℓ))⁻¹ • wf x ℓ) = 1
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ (hposℓ x ℓ hℓ).ne']
  
  intro X τ hX hτs hτr x₀ hx₀
  have chain_tau : ∀ (x₀ : M) (y : E3), y ∈ (chartAt E3 x₀).target →
      (chartAt E3 x₀).symm y ∈ X → ∀ v : E3,
      fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y v =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y v) := by
    intro x₀ y hy hyX v
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hτd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y) :=
      (hτs.contMDiffAt (hX.mem_nhds hyX)).mdifferentiableAt (by simp)
    have hc := mfderiv_comp y hτd hd1
    rw [mfderiv_eq_fderiv] at hc
    exact congrArg (fun L => L v) hc
  have xi_smooth : ∀ (x₀ : M), x₀ ∈ X → ∀ j : Fin 3,
      ContDiffAt ℝ ∞ (fun y => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j))
        (chartAt E3 x₀ x₀) := by
    intro x₀ hx₀ j
    have hO : IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      (chartAt E3 x₀).isOpen_inter_preimage_symm hX
    have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X :=
      ⟨mem_chart_target E3 x₀, by
        show (chartAt E3 x₀).symm (chartAt E3 x₀ x₀) ∈ X
        rw [(chartAt E3 x₀).left_inv (mem_chart_source E3 x₀)]; exact hx₀⟩
    have hf : ContDiffOn ℝ ∞ (fun z => τ ((chartAt E3 x₀).symm z))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) := by
      have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (τ ∘ (chartAt E3 x₀).symm)
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
        hτs.comp (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun y hy => hy.2)
      exact contMDiffOn_iff_contDiffOn.mp this
    have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hf).2
    exact (hfd.clm_apply contDiffOn_const).contDiffAt (hO.mem_nhds hy₀)
  let ℓ : M → E3 →L[ℝ] ℝ := fun x => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x
  let w : M → E3 := fun x => wf x (ℓ x)
  let V : (x : M) → TangentSpace 𝓘(ℝ, E3) x := fun x => (ℓ x (w x))⁻¹ • w x
  show ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
    (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀
  have hwR' : ∀ x v, g.g x v (w x) = ℓ x v := fun x v => hwR x (ℓ x) v
  have hpos : ∀ x ∈ X, 0 < ℓ x (w x) := fun x hx => hposℓ x (ℓ x) (hτr x hx)
  let G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 x₀).symm
  let ξ : E3 → Fin 3 → ℝ := fun y j => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j)
  let c : E3 → Fin 3 → ℝ := fun y => Matrix.mulVec (G y)⁻¹ (ξ y)
  let W : E3 → E3 := fun y => (∑ i, c y i * ξ y i)⁻¹ • ∑ i, c y i • e i
  
  have hK : ∀ x ∈ (chartAt E3 x₀).source ∩ X,
      tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x) ∧
      ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
    rintro x ⟨hxs, hxX⟩
    obtain ⟨hTA0, hAT0⟩ := chart_inv x₀ x hxs
    let A : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
    let T : E3 →L[ℝ] E3 := tangentCoordChange 𝓘(ℝ, E3) x x₀ x
    have hTA : ∀ u, T (A u) = u := hTA0
    have hAT : ∀ v, A (T v) = v := hAT0
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hxs
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hxs
    have hG : G (chartAt E3 x₀ x) =
        Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b) := by
      ext a b
      simp only [G, RiemannianMetric3.coeff, coeffMatrix, Matrix.of_apply,
        ContinuousLinearMap.bilinearComp_apply]
      rw [hxy]
      rfl
    have hξ : ξ (chartAt E3 x₀ x) = fun j => ℓ x (A (e j)) := by
      funext j
      simp only [ξ]
      rw [chain_tau x₀ _ hy (by rw [hxy]; exact hxX), hxy]
      rfl
    have hdetB : (Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b)).det ≠ 0 := by
      refine bil_detpos _ (fun v hv => ?_)
      rw [ContinuousLinearMap.bilinearComp_apply]
      apply g.posDef
      intro h0
      apply hv
      rw [← hTA v]
      exact (congrArg T h0).trans (map_zero T)
    let u : E3 := ∑ i, c (chartAt E3 x₀ x) i • e i
    have hRu : ∀ v, (g.g x).bilinearComp A A v u = ∑ j, v j * ℓ x (A (e j)) := by
      intro v
      have := bil_riesz ((g.g x).bilinearComp A A) (fun j => ℓ x (A (e j))) hdetB v
      simp only [u, c, hG, hξ]
      exact this
    have hAu : ∀ v, g.g x v (A u) = ℓ x v := by
      intro v
      have h1 := hRu (T v)
      rw [ContinuousLinearMap.bilinearComp_apply, hAT v] at h1
      rw [h1]
      calc ∑ j, (T v) j * ℓ x (A (e j)) = ((ℓ x).comp A) (∑ i, (T v) i • e i) :=
            (lin_expand ((ℓ x).comp A) (fun i => (T v) i)).symm
        _ = ℓ x v := by
            rw [← vec_expand (T v), ContinuousLinearMap.comp_apply, hAT v]
    have hwAu : w x = A u :=
      bil_unique (g.g x) (g.posDef x) _ _ (fun v => (hwR' x v).trans (hAu v).symm)
    have hlw : ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
      rw [hwAu, hξ]
      exact lin_expand ((ℓ x).comp A) (c (chartAt E3 x₀ x))
    refine ⟨?_, hlw⟩
    show T ((ℓ x (w x))⁻¹ • w x) = W (chartAt E3 x₀ x)
    rw [hlw, hwAu, map_smul, hTA]
  
  have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target := mem_chart_target E3 x₀
  have hGs : ∀ i j, ContDiffAt ℝ ∞ (fun y => G y i j) (chartAt E3 x₀ x₀) := fun i j =>
    (g.smooth x₀ i j).contDiffAt ((chartAt E3 x₀).open_target.mem_nhds hy₀)
  have hK₀ := hK x₀ ⟨mem_chart_source E3 x₀, hx₀⟩
  have hdetG : (G (chartAt E3 x₀ x₀)).det ≠ 0 := by
    intro h0
    have hc0 : c (chartAt E3 x₀ x₀) = 0 := by
      simp only [c, Matrix.inv_def, h0, Ring.inverse_zero, zero_smul, Matrix.zero_mulVec]
    have := hpos x₀ hx₀
    rw [hK₀.2, hc0] at this
    simp at this
  have hξs : ∀ j, ContDiffAt ℝ ∞ (fun y => ξ y j) (chartAt E3 x₀ x₀) := fun j =>
    xi_smooth x₀ hx₀ j
  have hcs : ∀ i, ContDiffAt ℝ ∞ (fun y => c y i) (chartAt E3 x₀ x₀) := by
    intro i
    simp only [c, Matrix.mulVec, dotProduct]
    exact ContDiffAt.sum fun k _ => (inv_contDiffAt G _ hGs hdetG i k).mul (hξs k)
  have hden : ContDiffAt ℝ ∞ (fun y => ∑ i, c y i * ξ y i) (chartAt E3 x₀ x₀) :=
    ContDiffAt.sum fun i _ => (hcs i).mul (hξs i)
  have hden0 : ∑ i, c (chartAt E3 x₀ x₀) i * ξ (chartAt E3 x₀ x₀) i ≠ 0 := by
    rw [← hK₀.2]; exact (hpos x₀ hx₀).ne'
  have hWs : ContDiffAt ℝ ∞ W (chartAt E3 x₀ x₀) :=
    (hden.inv hden0).smul (ContDiffAt.sum fun i _ => (hcs i).smul contDiffAt_const)
  refine section_cmd V x₀ W hWs ?_
  filter_upwards [((chartAt E3 x₀).open_source.inter hX).mem_nhds
    ⟨mem_chart_source E3 x₀, hx₀⟩] with x hx using (hK x hx).1

theorem collar_side_dichotomy [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U)
    (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (hNo : IsOpen N) (hFN : frontier U ⊆ N) (x₀ : M)
    (hFCpc : IsPreconnected (closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U)) :
    (∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∃ V : Set M,
        IsOpen V ∧ p ∈ V ∧ V \ frontier U ⊆ connectedComponentIn (U ∩ N) x₀) ∨
    (∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∀ V : Set M,
        IsOpen V → p ∈ V → ¬ (V \ frontier U ⊆ connectedComponentIn (U ∩ N) x₀)) :=
by
  
  have fermat : ∀ (f : M → ℝ) (q : M), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → f q = 0 →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f q ≠ 0 → ∀ O ∈ 𝓝 q,
      (∃ z ∈ O, 0 < f z) ∧ (∃ z ∈ O, f z < 0) := by
    intro f q hf hq hdf O hO
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f q := hf.mdifferentiableAt (by simp)
    have heq : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f q =
        fderiv ℝ (f ∘ (extChartAt 𝓘(ℝ, E3) q).symm) (extChartAt 𝓘(ℝ, E3) q q) := by
      rw [hmd.mfderiv]
      simp [writtenInExtChartAt, fderivWithin_univ]
    have hc : ContinuousAt (extChartAt 𝓘(ℝ, E3) q).symm (extChartAt 𝓘(ℝ, E3) q q) :=
      continuousAt_extChartAt_symm q
    constructor
    · by_contra hneg
      push_neg at hneg
      have hmax : IsLocalMax f q :=
        Filter.eventually_of_mem hO (fun z hz => by rw [hq]; exact hneg z hz)
      have h2 : IsLocalMax (f ∘ (extChartAt 𝓘(ℝ, E3) q).symm) (extChartAt 𝓘(ℝ, E3) q q) := by
        apply IsLocalMax.comp_continuous
        · rw [extChartAt_to_inv]; exact hmax
        · exact hc
      exact hdf (heq.trans h2.fderiv_eq_zero)
    · by_contra hneg
      push_neg at hneg
      have hmin : IsLocalMin f q :=
        Filter.eventually_of_mem hO (fun z hz => by rw [hq]; exact hneg z hz)
      have h2 : IsLocalMin (f ∘ (extChartAt 𝓘(ℝ, E3) q).symm) (extChartAt 𝓘(ℝ, E3) q q) := by
        apply IsLocalMin.comp_continuous
        · rw [extChartAt_to_inv]; exact hmin
        · exact hc
      exact hdf (heq.trans h2.fderiv_eq_zero)
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  have hCsub : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  
  have absorb : ∀ H : Set M, IsPreconnected H → H ⊆ N → (∀ y ∈ H, y ∉ frontier U) →
      (H ∩ C).Nonempty → H ⊆ C := by
    intro H hH hHN hHF hne
    obtain ⟨y, hyH, hyC⟩ := hne
    have hcov : H ⊆ U ∪ (closure U)ᶜ := by
      intro x hx
      by_cases hxU : x ∈ U
      · exact Or.inl hxU
      · right
        intro hxc
        apply hHF x hx
        rw [hUo.frontier_eq]
        exact ⟨hxc, hxU⟩
    have hHU : H ⊆ U :=
      IsPreconnected.subset_left_of_subset_union hUo isClosed_closure.isOpen_compl
        (Disjoint.mono_left subset_closure disjoint_compl_right) hcov
        ⟨y, hyH, (hCsub hyC).1⟩ hH
    have h1 : H ⊆ connectedComponentIn (U ∩ N) y :=
      hH.subset_connectedComponentIn hyH (fun x hx => ⟨hHU hx, hHN hx⟩)
    intro x hx
    have hx1 := h1 hx
    rwa [← connectedComponentIn_eq hyC] at hx1
  
  have spread : ∀ p ∈ frontier U,
      (∀ V : Set M, IsOpen V → p ∈ V → ¬ (V \ frontier U ⊆ C)) →
      ∃ W : Set M, IsOpen W ∧ p ∈ W ∧ ∀ q ∈ W ∩ frontier U, ∀ V : Set M, IsOpen V → q ∈ V →
        ¬ (V \ frontier U ⊆ C) := by
    intro p hpF hp
    obtain ⟨V₀, f, hV₀N, hV₀o, hpV₀, hf, hdf, hV₀S, -, hP, hNn⟩ :=
      hfront.2 p hpF N (hNo.mem_nhds (hFN hpF))
    have hzero : ∀ y ∈ V₀, (y ∈ frontier U ↔ f y = 0) := by
      intro y hy
      constructor
      · intro h
        have h' : y ∈ V₀ ∩ frontier U := ⟨hy, h⟩
        rw [hV₀S] at h'
        exact h'.2
      · intro h
        have h' : y ∈ V₀ ∩ f ⁻¹' {0} := ⟨hy, h⟩
        rw [← hV₀S] at h'
        exact h'.2
    obtain ⟨y₀, ⟨hy₀V, hy₀F⟩, hy₀C⟩ := Set.not_subset.1 (hp V₀ hV₀o hpV₀)
    have hfy₀ : f y₀ ≠ 0 := fun h => hy₀F ((hzero y₀ hy₀V).2 h)
    refine ⟨V₀, hV₀o, hpV₀, ?_⟩
    rintro q ⟨hqV, hqF⟩ V hV hqV' hsub
    have hfq : f q = 0 := (hzero q hqV).1 hqF
    have hsc := fermat f q hf hfq (hdf q hqV) (V₀ ∩ V) ((hV₀o.inter hV).mem_nhds ⟨hqV, hqV'⟩)
    rcases lt_or_gt_of_ne hfy₀ with hlt | hgt
    · have hdisj : ¬ ((V₀ ∩ {x | f x < 0}) ∩ C).Nonempty := by
        intro hne
        have hHC := absorb _ hNn (fun x hx => hV₀N hx.1)
          (fun x hx hxF => (ne_of_lt (show f x < 0 from hx.2)) ((hzero x hx.1).1 hxF)) hne
        exact hy₀C (hHC ⟨hy₀V, hlt⟩)
      obtain ⟨z, hzO, hz⟩ := hsc.2
      have hzF : z ∉ frontier U := fun h => (ne_of_lt hz) ((hzero z hzO.1).1 h)
      exact hdisj ⟨z, ⟨hzO.1, hz⟩, hsub ⟨hzO.2, hzF⟩⟩
    · have hdisj : ¬ ((V₀ ∩ {x | 0 < f x}) ∩ C).Nonempty := by
        intro hne
        have hHC := absorb _ hP (fun x hx => hV₀N hx.1)
          (fun x hx hxF => (ne_of_gt (show 0 < f x from hx.2)) ((hzero x hx.1).1 hxF)) hne
        exact hy₀C (hHC ⟨hy₀V, hgt⟩)
      obtain ⟨z, hzO, hz⟩ := hsc.1
      have hzF : z ∉ frontier U := fun h => (ne_of_gt hz) ((hzero z hzO.1).1 h)
      exact hdisj ⟨z, ⟨hzO.1, hz⟩, hsub ⟨hzO.2, hzF⟩⟩
  
  set A := ⋃₀ {V : Set M | IsOpen V ∧ V \ frontier U ⊆ C} with hAdef
  have hAo : IsOpen A := isOpen_sUnion (fun V hV => hV.1)
  have memA : ∀ p, p ∈ A ↔ ∃ V : Set M, IsOpen V ∧ p ∈ V ∧ V \ frontier U ⊆ C := by
    intro p
    constructor
    · rintro ⟨V, ⟨hV, hsub⟩, hpV⟩
      exact ⟨V, hV, hpV, hsub⟩
    · rintro ⟨V, hV, hpV, hsub⟩
      exact ⟨V, ⟨hV, hsub⟩, hpV⟩
  by_cases hall : ∀ p ∈ closure C ∩ frontier U, p ∈ A
  · left
    intro p hp
    exact (memA p).1 (hall p hp)
  · right
    push_neg at hall
    obtain ⟨p₁, hp₁, hp₁A⟩ := hall
    intro p hp V hV hpV hsub
    have hpA : p ∈ A := (memA p).2 ⟨V, hV, hpV, hsub⟩
    have hBo : IsOpen (⋃₀ {W : Set M | IsOpen W ∧ ∀ q ∈ W ∩ frontier U, q ∉ A}) :=
      isOpen_sUnion (fun W hW => hW.1)
    have hcov : closure C ∩ frontier U ⊆
        A ∪ ⋃₀ {W : Set M | IsOpen W ∧ ∀ q ∈ W ∩ frontier U, q ∉ A} := by
      intro x hx
      by_cases hxA : x ∈ A
      · exact Or.inl hxA
      · right
        have hx' : ∀ V : Set M, IsOpen V → x ∈ V → ¬ (V \ frontier U ⊆ C) :=
          fun V hV hxV hs => hxA ((memA x).2 ⟨V, hV, hxV, hs⟩)
        obtain ⟨W, hWo, hxW, hW⟩ := spread x hx.2 hx'
        refine ⟨W, ⟨hWo, fun q hq hqA => ?_⟩, hxW⟩
        obtain ⟨V', hV', hqV', hs'⟩ := (memA q).1 hqA
        exact hW q hq V' hV' hqV' hs'
    obtain ⟨x, hx, hxA, hxB⟩ := hFCpc A _ hAo hBo hcov ⟨p, hp, hpA⟩
      ⟨p₁, hp₁, (hcov hp₁).resolve_left hp₁A⟩
    obtain ⟨W, ⟨hWo, hW⟩, hxW⟩ := hxB
    exact hW x ⟨hxW, hx.2⟩ hxA

theorem frontier_sign_change (f : M → ℝ) (x : M) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) (hx : f x = 0) (hdf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) : ∀ O ∈ 𝓝 x, (∃ z ∈ O, 0 < f z) ∧ (∃ z ∈ O, f z < 0) :=
by
  intro O hO
  have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x := by
    by_contra h
    exact hdf (mfderiv_zero_of_not_mdifferentiableAt h)
  have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x =
      fderiv ℝ (f ∘ (extChartAt 𝓘(ℝ, E3) x).symm) (extChartAt 𝓘(ℝ, E3) x x) := by
    rw [hmd.mfderiv, ModelWithCorners.range_eq_univ, fderivWithin_univ]
    congr 1
  have hc : ContinuousAt (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) :=
    continuousAt_extChartAt_symm x
  have hinv : (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) = x :=
    extChartAt_to_inv x
  refine ⟨?_, ?_⟩
  · by_contra h
    push_neg at h
    have hmax : IsLocalMax f ((extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x)) := by
      rw [hinv]
      exact Filter.eventually_of_mem hO (fun z hz => (h z hz).trans_eq hx.symm)
    exact hdf (hmf.trans (hmax.comp_continuous hc).fderiv_eq_zero)
  · by_contra h
    push_neg at h
    have hmin : IsLocalMin f ((extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x)) := by
      rw [hinv]
      exact Filter.eventually_of_mem hO (fun z hz => hx.trans_le (h z hz))
    exact hdf (hmf.trans (hmin.comp_continuous hc).fderiv_eq_zero)

theorem sq_eq_local_sign [IsManifold 𝓘(ℝ, E3) ∞ M] (f h : M → ℝ) (W : Set M) (x : M)
    (hW : IsOpen W) (hxW : x ∈ W)
    (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) (hh : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h)
    (hsq : ∀ y ∈ W, f y ^ 2 = h y ^ 2)
    (hdh : h x = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) h x ≠ 0) :
    ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f y = e * h y :=
by
  classical
  
  have s1 : ∀ (P Q : M → ℝ), Continuous P → (∀ᶠ y in 𝓝 x, P y * Q y = 0) →
      (∀ᶠ y in 𝓝 x, ∃ᶠ z in 𝓝 y, Q z ≠ 0) → ∀ᶠ y in 𝓝 x, P y = 0 := by
    intro P Q hP hPQ hQ
    filter_upwards [hPQ.eventually_nhds, hQ] with y hy1 hy2
    by_contra hPy
    have h3 : ∀ᶠ z in 𝓝 y, Q z = 0 := by
      filter_upwards [hy1, hP.continuousAt.eventually_ne hPy] with z hz1 hz2
      exact (mul_eq_zero.mp hz1).resolve_left hz2
    obtain ⟨z, hz1, hz2⟩ := (hy2.and_eventually h3).exists
    exact hz1 hz2
  
  have s2 : ∀ (G : E3 → ℝ) (s : Set E3) (a : E3), IsOpen s → a ∈ s → ContDiffOn ℝ ∞ G s →
      fderiv ℝ G a ≠ 0 → ∀ᶠ z in 𝓝 a, ∃ᶠ w in 𝓝 z, G w ≠ 0 := by
    intro G s a hs ha hG hda
    have hc : ContinuousOn (fderiv ℝ G) s := hG.continuousOn_fderiv_of_isOpen hs (by simp)
    filter_upwards [(hc.continuousAt (hs.mem_nhds ha)).eventually_ne hda] with z hz
    by_contra hfr
    rw [Filter.not_frequently] at hfr
    have hev : G =ᶠ[𝓝 z] fun _ => (0 : ℝ) := hfr.mono fun w hw => by simpa using hw
    exact hz (by rw [hev.fderiv_eq]; exact fderiv_const_apply _)
  set φ := extChartAt 𝓘(ℝ, E3) x with hφ
  
  have s3a : ∀ Q : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ Q →
      ContDiffOn ℝ ∞ (fun w => Q (φ.symm w)) φ.target := by
    intro Q hQ
    exact contMDiffOn_iff_contDiffOn.mp (hQ.comp_contMDiffOn (contMDiffOn_extChartAt_symm x))
  
  have s3b : ∀ Q : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ Q →
      fderiv ℝ (fun w => Q (φ.symm w)) (φ x) = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) Q x := by
    intro Q hQ
    have hd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) Q x := hQ.mdifferentiableAt (by simp)
    rw [hd.mfderiv, ModelWithCorners.range_eq_univ, fderivWithin_univ]
    rfl
  
  have s4 : ∀ Q : M → ℝ, (∀ᶠ z in 𝓝 (φ x), ∃ᶠ w in 𝓝 z, Q (φ.symm w) ≠ 0) →
      ∀ᶠ y in 𝓝 x, ∃ᶠ y' in 𝓝 y, Q y' ≠ 0 := by
    intro Q hQ
    filter_upwards [(continuousAt_extChartAt x).tendsto.eventually hQ,
      extChartAt_source_mem_nhds (I := 𝓘(ℝ, E3)) x] with y hy hys
    by_contra hfr
    rw [Filter.not_frequently] at hfr
    have hc : ContinuousAt φ.symm (φ y) := continuousAt_extChartAt_symm' hys
    have hc' : Filter.Tendsto φ.symm (𝓝 (φ y)) (𝓝 y) := by
      have := hc.tendsto
      rwa [φ.left_inv hys] at this
    have h0 : ∀ᶠ w in 𝓝 (φ y), ¬ Q (φ.symm w) ≠ 0 := hc'.eventually hfr
    obtain ⟨w, hw1, hw2⟩ := (hy.and_eventually h0).exists
    exact hw2 hw1
  
  have hWn : ∀ᶠ y in 𝓝 x, y ∈ W := hW.mem_nhds hxW
  have hPQ1 : ∀ᶠ y in 𝓝 x, (f y - h y) * (f y + h y) = 0 := hWn.mono fun y hy => by
    rw [show (f y - h y) * (f y + h y) = f y ^ 2 - h y ^ 2 by ring, hsq y hy, sub_self]
  have hPQ2 : ∀ᶠ y in 𝓝 x, (f y + h y) * (f y - h y) = 0 := hWn.mono fun y hy => by
    rw [show (f y + h y) * (f y - h y) = f y ^ 2 - h y ^ 2 by ring, hsq y hy, sub_self]
  have hfc := hf.continuous
  have hhc := hh.continuous
  have key : (∀ᶠ y in 𝓝 x, ∃ᶠ z in 𝓝 y, f z + h z ≠ 0) ∨
      (∀ᶠ y in 𝓝 x, ∃ᶠ z in 𝓝 y, f z - h z ≠ 0) := by
    by_cases hx0 : h x = 0
    · have hdx := hdh hx0
      have hT : IsOpen φ.target := isOpen_extChartAt_target x
      have ha : φ x ∈ φ.target := mem_extChartAt_target x
      have hFc := s3a f hf
      have hHc := s3a h hh
      have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
      have hFd := (hFc.differentiableOn hne).differentiableAt (hT.mem_nhds ha)
      have hHd := (hHc.differentiableOn hne).differentiableAt (hT.mem_nhds ha)
      have hadd : fderiv ℝ (fun w => f (φ.symm w) + h (φ.symm w)) (φ x) =
          fderiv ℝ (fun w => f (φ.symm w)) (φ x) + fderiv ℝ (fun w => h (φ.symm w)) (φ x) :=
        fderiv_add hFd hHd
      have hsub : fderiv ℝ (fun w => f (φ.symm w) - h (φ.symm w)) (φ x) =
          fderiv ℝ (fun w => f (φ.symm w)) (φ x) - fderiv ℝ (fun w => h (φ.symm w)) (φ x) :=
        fderiv_sub hFd hHd
      by_cases hp : fderiv ℝ (fun w => f (φ.symm w) + h (φ.symm w)) (φ x) = 0
      · right
        have hm : fderiv ℝ (fun w => f (φ.symm w) - h (φ.symm w)) (φ x) ≠ 0 := by
          intro hm
          apply hdx
          rw [← s3b h hh]
          refine ContinuousLinearMap.ext fun v => ?_
          show fderiv ℝ (fun w => h (φ.symm w)) (φ x) v = (0 : ℝ)
          have e1 := congrArg (fun L : E3 →L[ℝ] ℝ => L v) (hadd.symm.trans hp)
          have e2 := congrArg (fun L : E3 →L[ℝ] ℝ => L v) (hsub.symm.trans hm)
          simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
            ContinuousLinearMap.zero_apply] at e1 e2 ⊢
          linarith
        exact s4 (fun y => f y - h y) (s2 _ _ _ hT ha (hFc.sub hHc) hm)
      · left
        exact s4 (fun y => f y + h y) (s2 _ _ _ hT ha (hFc.add hHc) hp)
    · by_cases hp : f x + h x = 0
      · right
        have hm : f x - h x ≠ 0 := by
          intro hm
          apply hx0
          linarith
        have hev := (hfc.sub hhc).continuousAt.eventually_ne hm
        exact hev.eventually_nhds.mono fun y hy => hy.frequently
      · left
        have hev := (hfc.add hhc).continuousAt.eventually_ne hp
        exact hev.eventually_nhds.mono fun y hy => hy.frequently
  rcases key with hk | hk
  · refine ⟨1, Or.inl rfl, ?_⟩
    have hz := s1 (fun y => f y - h y) (fun y => f y + h y) (hfc.sub hhc) hPQ1 hk
    filter_upwards [hz] with y hy
    linarith
  · refine ⟨-1, Or.inr rfl, ?_⟩
    have hz := s1 (fun y => f y + h y) (fun y => f y - h y) (hfc.add hhc) hPQ2 hk
    filter_upwards [hz] with y hy
    linarith

theorem collar_two_sided_family [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (U : Set M) (hUo : IsOpen U) (hFc : IsCompact (frontier U))
    (N : Set M) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (x₀ : M)
    (hTwo : ∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∃ V : Set M,
      IsOpen V ∧ p ∈ V ∧ V \ frontier U ⊆ connectedComponentIn (U ∩ N) x₀) :
    ∃ (m : ℕ) (B : Fin m → Set M) (f : Fin m → M → ℝ),
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ ⋃ i, B i ∧
      (∀ i, IsOpen (B i) ∧ B i ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i) ∧
        (∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0) ∧
        B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0} ∧
        B i ∩ frontier U ⊆ closure (connectedComponentIn (U ∩ N) x₀)) ∧
      (∀ i, ∀ x ∈ B i, 0 < f i x → x ∈ connectedComponentIn (U ∩ N) x₀) ∧
      (∀ i, ∀ x ∈ B i, x ∈ connectedComponentIn (U ∩ N) x₀ → σ x = |f i x|) ∧
      (∀ i k, ∀ x ∈ B i ∩ B k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f i y = e * f k y) :=
by
  classical
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  have hCX : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hKc : IsCompact (closure C ∩ frontier U) :=
    hFc.of_isClosed_subset (isClosed_closure.inter isClosed_frontier) Set.inter_subset_right
  have hloc : ∀ p : ↥(closure C ∩ frontier U), ∃ (B : Set M) (f : M → ℝ), IsOpen B ∧
      (p : M) ∈ B ∧ B ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x ∈ B, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      B ∩ frontier U = B ∩ f ⁻¹' {0} ∧ B \ frontier U ⊆ C ∧
      (∀ x ∈ B, x ∈ C → σ x = |f x|) := by
    rintro ⟨p, hp⟩
    obtain ⟨V, hVo, hpV, hVC⟩ := hTwo p hp
    obtain ⟨Vg, f, hVgo, hpVg, hf, hdf, hVgF, hσ⟩ := hgood p hp.2
    refine ⟨V ∩ Vg ∩ N, f, (hVo.inter hVgo).inter hNo, ⟨⟨hpV, hpVg⟩, hFN hp.2⟩,
      Set.inter_subset_right, hf, fun x hx => hdf x hx.1.2, ?_, ?_, ?_⟩
    · ext x
      constructor
      · rintro ⟨hxB, hxF⟩
        have hx' : x ∈ Vg ∩ frontier U := ⟨hxB.1.2, hxF⟩
        rw [hVgF] at hx'
        exact ⟨hxB, hx'.2⟩
      · rintro ⟨hxB, hx0⟩
        have hx' : x ∈ Vg ∩ f ⁻¹' {0} := ⟨hxB.1.2, hx0⟩
        rw [← hVgF] at hx'
        exact ⟨hxB, hx'.2⟩
    · rintro x ⟨hxB, hxF⟩
      exact hVC ⟨hxB.1.1, hxF⟩
    · intro x hxB hxC
      exact hσ x ⟨⟨hxB.1.2, (hCX hxC).1⟩, (hCX hxC).2⟩
  choose B₀ f₀ hB₀ using hloc
  have hZ : ∀ i, ∀ x ∈ B₀ i, (x ∈ frontier U ↔ f₀ i x = 0) := by
    intro i x hx
    have h := (hB₀ i).2.2.2.2.2.1
    constructor
    · intro hF
      have hx' : x ∈ B₀ i ∩ frontier U := ⟨hx, hF⟩
      rw [h] at hx'
      exact hx'.2
    · intro h0
      have hx' : x ∈ B₀ i ∩ f₀ i ⁻¹' {0} := ⟨hx, h0⟩
      rw [← h] at hx'
      exact hx'.2
  have hP1 : ∀ i, ∀ x ∈ B₀ i, 0 < f₀ i x → x ∈ C := by
    intro i x hx hpos
    have hxF : x ∉ frontier U := fun hF => (ne_of_gt hpos) ((hZ i x hx).1 hF)
    exact (hB₀ i).2.2.2.2.2.2.1 ⟨hx, hxF⟩
  have hcl : ∀ i, B₀ i ∩ frontier U ⊆ closure C := by
    rintro i q ⟨hqB, hqF⟩
    rw [mem_closure_iff_nhds]
    intro O hO
    obtain ⟨⟨z, hz, hzpos⟩, -⟩ := frontier_sign_change (f₀ i) q (hB₀ i).2.2.2.1
      ((hZ i q hqB).1 hqF) ((hB₀ i).2.2.2.2.1 q hqB) (O ∩ B₀ i)
      (Filter.inter_mem hO ((hB₀ i).1.mem_nhds hqB))
    exact ⟨z, hz.1, hP1 i z hz.2 hzpos⟩
  have hP3 : ∀ i k, ∀ x ∈ B₀ i ∩ B₀ k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧
      ∀ᶠ y in 𝓝 x, f₀ i y = e * f₀ k y := by
    intro i k x hx
    apply sq_eq_local_sign (f₀ i) (f₀ k) (B₀ i ∩ B₀ k) x ((hB₀ i).1.inter (hB₀ k).1) hx
      (hB₀ i).2.2.2.1 (hB₀ k).2.2.2.1
    · intro y hy
      by_cases hyF : y ∈ frontier U
      · rw [(hZ i y hy.1).1 hyF, (hZ k y hy.2).1 hyF]
      · have hyC : y ∈ C := (hB₀ i).2.2.2.2.2.2.1 ⟨hy.1, hyF⟩
        have h1 := (hB₀ i).2.2.2.2.2.2.2 y hy.1 hyC
        have h2 := (hB₀ k).2.2.2.2.2.2.2 y hy.2 hyC
        rw [← sq_abs (f₀ i y), ← sq_abs (f₀ k y), ← h1, ← h2]
    · intro _
      exact (hB₀ k).2.2.2.2.1 x hx.2
  obtain ⟨t, ht⟩ := hKc.elim_finite_subcover B₀ (fun i => (hB₀ i).1) (by
    intro y hy
    exact Set.mem_iUnion.2 ⟨⟨y, hy⟩, (hB₀ ⟨y, hy⟩).2.1⟩)
  refine ⟨t.card, fun j => B₀ (t.equivFin.symm j).1, fun j => f₀ (t.equivFin.symm j).1, ?_,
    fun j => ⟨(hB₀ _).1, (hB₀ _).2.2.1, (hB₀ _).2.2.2.1, (hB₀ _).2.2.2.2.1,
      (hB₀ _).2.2.2.2.2.1, hcl _⟩,
    fun j => hP1 _, fun j => (hB₀ _).2.2.2.2.2.2.2, fun j k => hP3 _ _⟩
  intro y hy
  obtain ⟨i, hi, hyi⟩ := Set.mem_iUnion₂.1 (ht hy)
  refine Set.mem_iUnion.2 ⟨t.equivFin ⟨i, hi⟩, ?_⟩
  simp only [Equiv.symm_apply_apply]
  exact hyi

theorem collar_one_sided_family [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U) (hFc : IsCompact (frontier U))
    (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (x₀ : M)
    (hOne : ∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∀ V : Set M,
      IsOpen V → p ∈ V → ¬ (V \ frontier U ⊆ connectedComponentIn (U ∩ N) x₀)) :
    ∃ (m : ℕ) (B : Fin m → Set M) (f : Fin m → M → ℝ),
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ ⋃ i, B i ∧
      (∀ i, IsOpen (B i) ∧ B i ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i) ∧
        (∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0) ∧
        B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0} ∧
        B i ∩ frontier U ⊆ closure (connectedComponentIn (U ∩ N) x₀)) ∧
      (∀ i, ∀ x ∈ B i, 0 < f i x → x ∈ connectedComponentIn (U ∩ N) x₀) ∧
      (∀ i, ∀ x ∈ B i, x ∈ connectedComponentIn (U ∩ N) x₀ → σ x = |f i x|) ∧
      (∀ i k, ∀ x ∈ B i ∩ B k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f i y = e * f k y) :=
by
  classical
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  set K := closure C ∩ frontier U with hKdef
  have hCX : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hFU : ∀ x ∈ frontier U, x ∉ U := by
    intro x hx
    rw [hUo.frontier_eq] at hx
    exact hx.2
  have hCF : ∀ x ∈ C, x ∉ frontier U := fun x hx hxF => hFU x hxF (hCX hx).1
  
  rcases K.eq_empty_or_nonempty with hKe | hKne
  · refine ⟨0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
    rw [hKe]
    exact Set.empty_subset _
  
  have hhalf : ∀ H : Set M, IsPreconnected H → H ⊆ N → (∀ y ∈ H, y ∉ frontier U) →
      (H ∩ C).Nonempty → H ⊆ C := by
    intro H hH hHN hHF hne
    obtain ⟨y, hyH, hyC⟩ := hne
    have hcov : H ⊆ U ∪ (closure U)ᶜ := by
      intro x hx
      by_cases hxU : x ∈ U
      · exact Or.inl hxU
      · right
        intro hxc
        exact hHF x hx (by rw [hUo.frontier_eq]; exact ⟨hxc, hxU⟩)
    have hdisj : Disjoint U (closure U)ᶜ :=
      Disjoint.mono_left subset_closure disjoint_compl_right
    have hHU : H ⊆ U :=
      IsPreconnected.subset_left_of_subset_union hUo isClosed_closure.isOpen_compl hdisj hcov
        ⟨y, hyH, (hCX hyC).1⟩ hH
    have h1 := hH.subset_connectedComponentIn hyH
      (show H ⊆ U ∩ N from fun x hx => ⟨hHU hx, hHN hx⟩)
    rw [← connectedComponentIn_eq hyC] at h1
    exact h1
  
  have hclaim : ∀ p ∈ K, ∀ (V A B : Set M) (h₀ : M → ℝ) (z : M),
      IsOpen V → p ∈ V → V ⊆ N →
      IsPreconnected A → IsPreconnected B → A ⊆ V → B ⊆ V →
      (∀ x ∈ A, x ∉ frontier U) → (∀ x ∈ B, x ∉ frontier U) →
      (∀ x ∈ V, x ∉ frontier U → x ∈ A ∨ x ∈ B) →
      z ∈ A → z ∈ C →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h₀ → (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) h₀ x ≠ 0) →
      (∀ x ∈ V, x ∈ frontier U ↔ h₀ x = 0) → (∀ x ∈ V, x ∈ C → σ x = |h₀ x|) → 0 < h₀ z →
      ∃ (V' : Set M) (h : M → ℝ), IsOpen V' ∧ p ∈ V' ∧
        V' ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h ∧
        (∀ x ∈ V', mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) h x ≠ 0) ∧
        (∀ x ∈ V', x ∈ frontier U ↔ h x = 0) ∧ (∀ x ∈ V', 0 < h x ↔ x ∈ C) ∧
        (∀ x ∈ V', x ∈ C → σ x = h x) := by
    intro p hp V A B h₀ z hVo hpV hVN hA hB hAV hBV hAF hBF hcov hzA hzC hh₀ hdh₀ hF₀ hσ₀ hz0
    have hAC : A ⊆ C := hhalf A hA (hAV.trans hVN) hAF ⟨z, hzA, hzC⟩
    have hBC : ∀ x ∈ B, x ∉ C := by
      intro x hxB hxC
      have hBC' : B ⊆ C := hhalf B hB (hBV.trans hVN) hBF ⟨x, hxB, hxC⟩
      apply hOne p hp V hVo hpV
      rintro y ⟨hyV, hyF⟩
      rcases hcov y hyV hyF with hy | hy
      · exact hAC hy
      · exact hBC' hy
    have hcont : Continuous h₀ := hh₀.continuous
    have hne : ∀ x ∈ V, x ∉ frontier U → h₀ x ≠ 0 := fun x hx hxF h0 => hxF ((hF₀ x hx).2 h0)
    have hApos : ∀ x ∈ A, 0 < h₀ x := by
      intro x hxA
      by_contra hle
      push_neg at hle
      have hlt : h₀ x < 0 := lt_of_le_of_ne hle (hne x (hAV hxA) (hAF x hxA))
      obtain ⟨c, hcA, hc0⟩ := hA.intermediate_value hxA hzA hcont.continuousOn
        (show (0 : ℝ) ∈ Set.Icc (h₀ x) (h₀ z) from ⟨hlt.le, hz0.le⟩)
      exact hne c (hAV hcA) (hAF c hcA) hc0
    have hp0 : h₀ p = 0 := (hF₀ p hpV).1 hp.2
    obtain ⟨-, w, hwV, hw0⟩ :=
      frontier_sign_change h₀ p hh₀ hp0 (hdh₀ p hpV) V (hVo.mem_nhds hpV)
    have hwF : w ∉ frontier U := fun h => (ne_of_lt hw0) ((hF₀ w hwV).1 h)
    have hwB : w ∈ B := by
      rcases hcov w hwV hwF with h | h
      · exact absurd (hApos w h) (not_lt.2 hw0.le)
      · exact h
    have hBneg : ∀ x ∈ B, h₀ x < 0 := by
      intro x hxB
      by_contra hle
      push_neg at hle
      have hlt : 0 < h₀ x := lt_of_le_of_ne hle (hne x (hBV hxB) (hBF x hxB)).symm
      obtain ⟨c, hcB, hc0⟩ := hB.intermediate_value hwB hxB hcont.continuousOn
        (show (0 : ℝ) ∈ Set.Icc (h₀ w) (h₀ x) from ⟨hw0.le, hlt.le⟩)
      exact hne c (hBV hcB) (hBF c hcB) hc0
    have hposC : ∀ x ∈ V, 0 < h₀ x ↔ x ∈ C := by
      intro x hxV
      constructor
      · intro hx
        have hxF : x ∉ frontier U := fun h => (ne_of_gt hx) ((hF₀ x hxV).1 h)
        rcases hcov x hxV hxF with h | h
        · exact hAC h
        · exact absurd (hBneg x h) (not_lt.2 hx.le)
      · intro hxC
        rcases hcov x hxV (hCF x hxC) with h | h
        · exact hApos x h
        · exact absurd hxC (hBC x h)
    refine ⟨V, h₀, hVo, hpV, hVN, hh₀, hdh₀, hF₀, hposC, ?_⟩
    intro x hxV hxC
    rw [hσ₀ x hxV hxC, abs_of_pos ((hposC x hxV).2 hxC)]
  
  have hloc : ∀ p ∈ K, ∃ (V : Set M) (h : M → ℝ), IsOpen V ∧ p ∈ V ∧
        V ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h ∧
        (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) h x ≠ 0) ∧
        (∀ x ∈ V, x ∈ frontier U ↔ h x = 0) ∧ (∀ x ∈ V, 0 < h x ↔ x ∈ C) ∧
        (∀ x ∈ V, x ∈ C → σ x = h x) := by
    intro p hp
    obtain ⟨Vg, fg, hVgo, hpVg, hfg, hdfg, hVgF, hσg⟩ := hgood p hp.2
    obtain ⟨V, f₀, hVsub, hVo, hpV, -, -, hVS, -, hP, hNg⟩ :=
      hfront.2 p hp.2 (Vg ∩ N) ((hVgo.inter hNo).mem_nhds ⟨hpVg, hFN hp.2⟩)
    have hVN : V ⊆ N := fun x hx => (hVsub hx).2
    have hVVg : V ⊆ Vg := fun x hx => (hVsub hx).1
    have hFg : ∀ x ∈ V, x ∈ frontier U ↔ fg x = 0 := by
      intro x hx
      constructor
      · intro h
        have h' : x ∈ Vg ∩ frontier U := ⟨hVVg hx, h⟩
        rw [hVgF] at h'
        exact h'.2
      · intro h
        have h' : x ∈ Vg ∩ fg ⁻¹' {0} := ⟨hVVg hx, h⟩
        rw [← hVgF] at h'
        exact h'.2
    have hF0 : ∀ x ∈ V, x ∈ frontier U ↔ f₀ x = 0 := by
      intro x hx
      constructor
      · intro h
        have h' : x ∈ V ∩ frontier U := ⟨hx, h⟩
        rw [hVS] at h'
        exact h'.2
      · intro h
        have h' : x ∈ V ∩ f₀ ⁻¹' {0} := ⟨hx, h⟩
        rw [← hVS] at h'
        exact h'.2
    have hσfg : ∀ x ∈ V, x ∈ C → σ x = |fg x| := fun x hx hxC =>
      hσg x ⟨⟨hVVg hx, (hCX hxC).1⟩, (hCX hxC).2⟩
    have hdfg' : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) fg x ≠ 0 := fun x hx => hdfg x (hVVg hx)
    have hfgn : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => -fg x) := hfg.neg
    have hdfgn : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun x => -fg x) x ≠ 0 := by
      intro x hx
      rw [show (fun x => -fg x) = -fg from rfl, mfderiv_neg]
      exact neg_ne_zero.mpr (hdfg' x hx)
    have hFgn : ∀ x ∈ V, x ∈ frontier U ↔ -fg x = 0 := fun x hx => by
      rw [neg_eq_zero]; exact hFg x hx
    have hσfgn : ∀ x ∈ V, x ∈ C → σ x = |-fg x| := fun x hx hxC => by
      rw [abs_neg]; exact hσfg x hx hxC
    have hPF : ∀ x ∈ V ∩ {x | 0 < f₀ x}, x ∉ frontier U := fun x hx h =>
      (ne_of_gt hx.2) ((hF0 x hx.1).1 h)
    have hNF : ∀ x ∈ V ∩ {x | f₀ x < 0}, x ∉ frontier U := fun x hx h =>
      (ne_of_lt hx.2) ((hF0 x hx.1).1 h)
    have hcov1 : ∀ x ∈ V, x ∉ frontier U →
        x ∈ V ∩ {x | 0 < f₀ x} ∨ x ∈ V ∩ {x | f₀ x < 0} := by
      intro x hx hxF
      have : f₀ x ≠ 0 := fun h => hxF ((hF0 x hx).2 h)
      rcases lt_or_gt_of_ne this with h | h
      · exact Or.inr ⟨hx, h⟩
      · exact Or.inl ⟨hx, h⟩
    have hcov2 : ∀ x ∈ V, x ∉ frontier U →
        x ∈ V ∩ {x | f₀ x < 0} ∨ x ∈ V ∩ {x | 0 < f₀ x} := fun x hx hxF =>
      (hcov1 x hx hxF).symm
    obtain ⟨z, hzV, hzC⟩ : (V ∩ C).Nonempty := mem_closure_iff_nhds.1 hp.1 V (hVo.mem_nhds hpV)
    have hzF := hCF z hzC
    have hfgz : fg z ≠ 0 := fun h => hzF ((hFg z hzV).2 h)
    rcases hcov1 z hzV hzF with hzA | hzA
    · rcases lt_or_gt_of_ne hfgz with hs | hs
      · exact hclaim p hp V _ _ (fun x => -fg x) z hVo hpV hVN hP hNg Set.inter_subset_left
          Set.inter_subset_left hPF hNF hcov1 hzA hzC hfgn hdfgn hFgn hσfgn
          (show (0 : ℝ) < -fg z by linarith)
      · exact hclaim p hp V _ _ fg z hVo hpV hVN hP hNg Set.inter_subset_left
          Set.inter_subset_left hPF hNF hcov1 hzA hzC hfg hdfg' hFg hσfg hs
    · rcases lt_or_gt_of_ne hfgz with hs | hs
      · exact hclaim p hp V _ _ (fun x => -fg x) z hVo hpV hVN hNg hP Set.inter_subset_left
          Set.inter_subset_left hNF hPF hcov2 hzA hzC hfgn hdfgn hFgn hσfgn
          (show (0 : ℝ) < -fg z by linarith)
      · exact hclaim p hp V _ _ fg z hVo hpV hVN hNg hP Set.inter_subset_left
          Set.inter_subset_left hNF hPF hcov2 hzA hzC hfg hdfg' hFg hσfg hs
  
  have hK : IsCompact K :=
    hFc.of_isClosed_subset (isClosed_closure.inter isClosed_frontier) Set.inter_subset_right
  choose! Vf hf hVfo hpVf hVfN hfs hdf hfF hfC hfσ using hloc
  
  have hbump : ∀ p ∈ K, ∃ ψ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ ∧ (∀ y, 0 ≤ ψ y) ∧
      ψ p = 1 ∧ tsupport ψ ⊆ Vf p := by
    intro p hp
    obtain ⟨b, -, hb⟩ := (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) p).mem_iff.1
      ((hVfo p hp).mem_nhds (hpVf p hp))
    exact ⟨b, b.contMDiff, fun y => b.nonneg, b.eventuallyEq_one.eq_of_nhds, hb⟩
  choose! ψ hψs hψ0 hψ1 hψt using hbump
  obtain ⟨t, htK, hKt⟩ := hK.elim_nhds_subcover (fun p => {y | 0 < ψ p y})
    (fun p hp => (isOpen_lt continuous_const (hψs p hp).continuous).mem_nhds
      (show (0 : ℝ) < ψ p p by rw [hψ1 p hp]; norm_num))
  
  obtain ⟨pt, hptdef⟩ : ∃ pt : Fin t.card → M, ∀ j, pt j = ((t.equivFin.symm j : t) : M) :=
    ⟨_, fun j => rfl⟩
  have hptK : ∀ j, pt j ∈ K := fun j => by rw [hptdef]; exact htK _ (t.equivFin.symm j).2
  have hcovpt : ∀ y ∈ K, ∃ j, 0 < ψ (pt j) y := by
    intro y hy
    have h1 := hKt hy
    rw [Set.mem_iUnion₂] at h1
    obtain ⟨q, hq, hyq⟩ := h1
    refine ⟨t.equivFin ⟨q, hq⟩, ?_⟩
    rw [hptdef, Equiv.symm_apply_apply]
    exact hyq
  
  obtain ⟨S, hSdef⟩ : ∃ S : M → ℝ, ∀ y, S y = ∑ j : Fin t.card, ψ (pt j) y := ⟨_, fun y => rfl⟩
  have hSs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ S := by
    have : S = fun y => ∑ j : Fin t.card, ψ (pt j) y := funext hSdef
    rw [this]
    exact contMDiff_finset_sum (fun j _ => hψs _ (hptK j))
  have hS0 : ∀ y, 0 ≤ S y := fun y => by
    rw [hSdef]; exact Finset.sum_nonneg (fun j _ => hψ0 _ (hptK j) y)
  have hSpos : ∀ y ∈ K, 0 < S y := by
    intro y hy
    obtain ⟨j, hj⟩ := hcovpt y hy
    rw [hSdef]
    exact Finset.sum_pos' (fun i _ => hψ0 _ (hptK i) y) ⟨j, Finset.mem_univ _, hj⟩
  obtain ⟨ymin, hyminK, hymin⟩ := hK.exists_isMinOn hKne hSs.continuous.continuousOn
  obtain ⟨c, hc0, hKc⟩ : ∃ c : ℝ, 0 < c ∧ ∀ y ∈ K, c < S y :=
    ⟨S ymin / 2, by linarith [hSpos ymin hyminK], fun y hy => by
      linarith [isMinOn_iff.1 hymin y hy, hSpos ymin hyminK]⟩
  
  obtain ⟨D, hDdef⟩ : ∃ D : M → ℝ, ∀ y, D y = S y + Real.smoothTransition (1 - S y / c) :=
    ⟨_, fun y => rfl⟩
  have hDs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ D := by
    have h1 : ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition (1 - s / c)) :=
      (Real.smoothTransition.contDiff (n := ⊤)).comp (contDiff_const.sub (contDiff_id.div_const c))
    have h2 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => Real.smoothTransition (1 - S y / c)) :=
      h1.comp_contMDiff hSs
    have : D = fun y => S y + Real.smoothTransition (1 - S y / c) := funext hDdef
    rw [this]
    exact hSs.add h2
  have hDpos : ∀ y, 0 < D y := by
    intro y
    rw [hDdef]
    by_cases hcy : c ≤ S y
    · have := Real.smoothTransition.nonneg (1 - S y / c)
      linarith
    · push_neg at hcy
      have h1 : 0 < 1 - S y / c := by
        rw [sub_pos, div_lt_one hc0]
        exact hcy
      have := Real.smoothTransition.pos_of_pos h1
      linarith [hS0 y]
  have hDB : ∀ y, c < S y → D y = S y := by
    intro y hy
    have := (one_lt_div hc0).2 hy
    rw [hDdef, Real.smoothTransition.zero_of_nonpos (by linarith), add_zero]
  have hDinv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => (D y)⁻¹) :=
    hDs.inv₀ (fun y => (hDpos y).ne')
  
  obtain ⟨w, hwdef⟩ : ∃ w : Fin t.card → M → ℝ, ∀ j y, w j y = ψ (pt j) y * (D y)⁻¹ :=
    ⟨_, fun j y => rfl⟩
  have hws : ∀ j, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w j) := by
    intro j
    have : w j = fun y => ψ (pt j) y * (D y)⁻¹ := funext (hwdef j)
    rw [this]
    exact (hψs _ (hptK j)).mul hDinv
  have hw0 : ∀ j y, 0 ≤ w j y := fun j y => by
    rw [hwdef]; exact mul_nonneg (hψ0 _ (hptK j) y) (inv_nonneg.2 (hDpos y).le)
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : M → ℝ, ∀ y, ρ y = ∑ j : Fin t.card, w j y * hf (pt j) y :=
    ⟨_, fun y => rfl⟩
  have hρs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ := by
    have : ρ = fun y => ∑ j : Fin t.card, w j y * hf (pt j) y := funext hρdef
    rw [this]
    exact contMDiff_finset_sum (fun j _ => (hws j).mul (hfs _ (hptK j)))
  
  have hsupp : ∀ j y, y ∉ Vf (pt j) → w j =ᶠ[𝓝 y] 0 := by
    intro j y hy
    have h1 : y ∉ tsupport (ψ (pt j)) := fun h => hy (hψt _ (hptK j) h)
    rw [notMem_tsupport_iff_eventuallyEq] at h1
    filter_upwards [h1] with x hx
    rw [hwdef, hx]
    simp
  have hsupp0 : ∀ j y, y ∉ Vf (pt j) → w j y = 0 := fun j y hy => (hsupp j y hy).eq_of_nhds
  have hψV : ∀ j y, 0 < ψ (pt j) y → y ∈ Vf (pt j) := fun j y h =>
    hψt _ (hptK j) (subset_tsupport _ h.ne')
  have hsum1 : ∀ y, c < S y → ∑ j : Fin t.card, w j y = 1 := by
    intro y hy
    simp only [hwdef]
    rw [← Finset.sum_mul, ← hSdef y, hDB y hy, mul_inv_cancel₀ (hc0.trans hy).ne']
  have hposj : ∀ y, c < S y → ∃ j, 0 < ψ (pt j) y := by
    intro y hy
    by_contra hcon
    push_neg at hcon
    have : S y ≤ 0 := by rw [hSdef]; exact Finset.sum_nonpos (fun j _ => hcon j)
    linarith
  
  have hval : ∀ y, c < S y → ∀ a : ℝ, (∀ j, y ∈ Vf (pt j) → hf (pt j) y = a) → ρ y = a := by
    intro y hy a ha
    have h1 : ∀ j ∈ (Finset.univ : Finset (Fin t.card)), w j y * hf (pt j) y = w j y * a := by
      intro j _
      by_cases hj : y ∈ Vf (pt j)
      · rw [ha j hj]
      · rw [hsupp0 j y hj, zero_mul, zero_mul]
    rw [hρdef, Finset.sum_congr rfl h1, ← Finset.sum_mul, hsum1 y hy, one_mul]
  have hneg : ∀ y, c < S y → (∀ j, y ∈ Vf (pt j) → hf (pt j) y < 0) → ρ y < 0 := by
    intro y hy ha
    obtain ⟨j₀, hj₀⟩ := hposj y hy
    have h1 : ∀ j ∈ (Finset.univ : Finset (Fin t.card)), 0 ≤ -(w j y * hf (pt j) y) := by
      intro j _
      by_cases hj : y ∈ Vf (pt j)
      · have h2 := ha j hj
        have h3 := hw0 j y
        nlinarith
      · rw [hsupp0 j y hj]
        simp
    have h2 : 0 < -(w j₀ y * hf (pt j₀) y) := by
      have hwpos : 0 < w j₀ y := by rw [hwdef]; exact mul_pos hj₀ (inv_pos.2 (hDpos y))
      have := ha j₀ (hψV j₀ y hj₀)
      nlinarith
    have h3 := Finset.sum_pos' h1 ⟨j₀, Finset.mem_univ _, h2⟩
    rw [Finset.sum_neg_distrib] at h3
    rw [hρdef]
    linarith
  have hdρ : ∀ y, c < S y → (∀ j, y ∈ Vf (pt j) → hf (pt j) y = 0) →
      ∀ j₀, (∀ j, y ∈ Vf (pt j) → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j)) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j₀)) y) →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ y = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j₀)) y := by
    intro y hy hz j₀ hd
    have hterm : ∀ j ∈ (Finset.univ : Finset (Fin t.card)),
        HasMFDerivAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun x => w j x * hf (pt j) x) y
          (w j y • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j₀)) y) := by
      intro j _
      by_cases hj : y ∈ Vf (pt j)
      · have h1 := ((hws j).mdifferentiableAt (x := y) (by simp)).hasMFDerivAt.mul
          ((hfs _ (hptK j)).mdifferentiableAt (x := y) (by simp)).hasMFDerivAt
        rw [hz j hj, zero_smul, add_zero, hd j hj] at h1
        exact h1
      · have h0 : (fun x => w j x * hf (pt j) x) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [hsupp j y hj] with x hx
          rw [hx]
          simp
        rw [hsupp0 j y hj, zero_smul]
        exact (hasMFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq h0
    have hsum := HasMFDerivAt.sum hterm
    have h2 : HasMFDerivAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ y
        (∑ j ∈ (Finset.univ : Finset (Fin t.card)),
          w j y • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j₀)) y) :=
      hsum.congr_of_eventuallyEq (Filter.Eventually.of_forall fun x => by
        rw [hρdef, Finset.sum_apply])
    rw [← Finset.sum_smul, hsum1 y hy, one_smul] at h2
    exact h2.mfderiv
  
  have hdeq : ∀ j k y, y ∈ Vf (pt j) → y ∈ Vf (pt k) → y ∈ frontier U →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j)) y = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt k)) y := by
    intro j k y hyj hyk hyF
    have hsj := hfs _ (hptK j)
    have hsk := hfs _ (hptK k)
    have hVjk : IsOpen (Vf (pt j) ∩ Vf (pt k)) := (hVfo _ (hptK j)).inter (hVfo _ (hptK k))
    have hAo : IsOpen (Vf (pt j) ∩ Vf (pt k) ∩ {z | 0 < hf (pt j) z}) :=
      hVjk.inter (isOpen_lt continuous_const hsj.continuous)
    have hAeq : ∀ z ∈ Vf (pt j) ∩ Vf (pt k) ∩ {z | 0 < hf (pt j) z},
        hf (pt j) z = hf (pt k) z := by
      intro z hz
      have hzC : z ∈ C := ((hfC _ (hptK j)) z hz.1.1).1 hz.2
      rw [← hfσ _ (hptK j) z hz.1.1 hzC, hfσ _ (hptK k) z hz.1.2 hzC]
    have hyA : y ∈ closure (Vf (pt j) ∩ Vf (pt k) ∩ {z | 0 < hf (pt j) z}) := by
      rw [mem_closure_iff_nhds]
      intro O hO
      have h0 : hf (pt j) y = 0 := ((hfF _ (hptK j)) y hyj).1 hyF
      obtain ⟨⟨z, hzO, hz⟩, -⟩ := frontier_sign_change (hf (pt j)) y hsj h0
        (hdf _ (hptK j) y hyj) (O ∩ (Vf (pt j) ∩ Vf (pt k)))
        (Filter.inter_mem hO (hVjk.mem_nhds ⟨hyj, hyk⟩))
      exact ⟨z, hzO.1, hzO.2, hz⟩
    have hzeroA : ∀ z ∈ Vf (pt j) ∩ Vf (pt k) ∩ {z | 0 < hf (pt j) z},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j) - hf (pt k)) z = 0 := by
      intro z hz
      have hev : (hf (pt j) - hf (pt k)) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
        filter_upwards [hAo.mem_nhds hz] with x hx
        rw [Pi.sub_apply, hAeq x hx, sub_self]
      rw [hev.mfderiv_eq, mfderiv_const]
    have hy0 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (hf (pt j) - hf (pt k)) y = 0 := by
      by_contra hne
      have hev := mfderiv_ne_zero_eventually Set.univ (hf (pt j) - hf (pt k))
        isOpen_univ (hsj.sub hsk).contMDiffOn y (Set.mem_univ y) hne
      obtain ⟨z, hz1, hz2⟩ := mem_closure_iff_nhds.1 hyA _ hev
      exact absurd (hzeroA z hz2) hz1
    rw [mfderiv_sub (hsj.mdifferentiableAt (by simp)) (hsk.mdifferentiableAt (by simp))] at hy0
    exact sub_eq_zero.1 hy0
  
  have hT1 : ∀ y, c < S y → y ∈ frontier U → ρ y = 0 ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ y ≠ 0 := by
    intro y hy hyF
    have hz : ∀ j, y ∈ Vf (pt j) → hf (pt j) y = 0 := fun j hj => ((hfF _ (hptK j)) y hj).1 hyF
    refine ⟨hval y hy 0 hz, ?_⟩
    obtain ⟨j₀, hj₀⟩ := hposj y hy
    have hyj₀ := hψV j₀ y hj₀
    rw [hdρ y hy hz j₀ (fun j hj => hdeq j j₀ y hj hyj₀ hyF)]
    exact hdf _ (hptK j₀) y hyj₀
  have hT2 : ∀ y, c < S y → y ∈ C → ρ y = σ y := fun y hy hyC =>
    hval y hy (σ y) (fun j hj => (hfσ _ (hptK j) y hj hyC).symm)
  have hT3 : ∀ y, c < S y → y ∉ frontier U → y ∉ C → ρ y < 0 := by
    intro y hy hyF hyC
    refine hneg y hy (fun j hj => ?_)
    have h1 : hf (pt j) y ≠ 0 := fun h => hyF (((hfF _ (hptK j)) y hj).2 h)
    have h2 : ¬ 0 < hf (pt j) y := fun h => hyC (((hfC _ (hptK j)) y hj).1 h)
    exact lt_of_le_of_ne (not_lt.1 h2) h1
  
  refine ⟨1, fun _ => {y | c < S y} ∩ interior {y | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ y ≠ 0},
    fun _ => ρ, ?_, fun _ => ⟨?_, ?_, hρs, ?_, ?_, ?_⟩, fun _ x hx hpos => ?_,
    fun _ x hx hxC => ?_,
    fun _ _ x _ => ⟨1, Or.inl rfl, Filter.Eventually.of_forall fun y => (one_mul _).symm⟩⟩
  · intro x hx
    refine Set.mem_iUnion.2 ⟨0, hKc x hx, ?_⟩
    exact mem_interior_iff_mem_nhds.2 (mfderiv_ne_zero_eventually Set.univ ρ isOpen_univ
      hρs.contMDiffOn x (Set.mem_univ x) (hT1 x (hKc x hx) hx.2).2)
  · exact (isOpen_lt continuous_const hSs.continuous).inter isOpen_interior
  · intro y hy
    obtain ⟨j₀, hj₀⟩ := hposj y hy.1
    exact hVfN _ (hptK j₀) (hψV j₀ y hj₀)
  · intro x hx
    exact interior_subset hx.2
  · ext y
    constructor
    · rintro ⟨hy, hyF⟩
      exact ⟨hy, (hT1 y hy.1 hyF).1⟩
    · rintro ⟨hy, hy0⟩
      refine ⟨hy, ?_⟩
      have hy0' : ρ y = 0 := hy0
      by_contra hyF
      by_cases hyC : y ∈ C
      · have h1 := hT2 y hy.1 hyC
        have h2 := (hσb y (hCX hyC)).1
        linarith
      · have := hT3 y hy.1 hyF hyC
        linarith
  · rintro y ⟨hy, hyF⟩
    obtain ⟨j₀, hj₀⟩ := hposj y hy.1
    have hyj₀ := hψV j₀ y hj₀
    rw [mem_closure_iff_nhds]
    intro O hO
    have h0 : hf (pt j₀) y = 0 := ((hfF _ (hptK j₀)) y hyj₀).1 hyF
    obtain ⟨⟨z, hzO, hz⟩, -⟩ := frontier_sign_change (hf (pt j₀)) y (hfs _ (hptK j₀)) h0
      (hdf _ (hptK j₀) y hyj₀) (O ∩ Vf (pt j₀))
      (Filter.inter_mem hO ((hVfo _ (hptK j₀)).mem_nhds hyj₀))
    exact ⟨z, hzO.1, ((hfC _ (hptK j₀)) z hzO.2).1 hz⟩
  · by_contra hxC
    by_cases hxF : x ∈ frontier U
    · have := (hT1 x hx.1 hxF).1
      linarith
    · have := hT3 x hx.1 hxF hxC
      linarith
  · show σ x = |ρ x|
    rw [hT2 x hx.1 hxC, abs_of_pos (hσb x (hCX hxC)).1]

theorem collar_signed_family [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M)
    (hUo : IsOpen U) (hFc : IsCompact (frontier U)) (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hNc : IsCompact (closure N)) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ σ ⁻¹' Set.Iio δ)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (x₀ : M) (hx₀ : x₀ ∈ U ∩ N)
    (hFCpc : IsPreconnected (closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U)) :
    ∃ (m : ℕ) (B : Fin m → Set M) (f : Fin m → M → ℝ),
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ ⋃ i, B i ∧
      (∀ i, IsOpen (B i) ∧ B i ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i) ∧
        (∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0) ∧
        B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0} ∧
        B i ∩ frontier U ⊆ closure (connectedComponentIn (U ∩ N) x₀)) ∧
      (∀ i, ∀ x ∈ B i, 0 < f i x → x ∈ connectedComponentIn (U ∩ N) x₀) ∧
      (∀ i, ∀ x ∈ B i, x ∈ connectedComponentIn (U ∩ N) x₀ → σ x = |f i x|) ∧
      (∀ i k, ∀ x ∈ B i ∩ B k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f i y = e * f k y) :=
by
  rcases collar_side_dichotomy g U hUo hfront N hNo hFN x₀ hFCpc with hTwo | hOne
  · exact collar_two_sided_family U hUo hFc N σ hNo hFN hgood x₀ hTwo
  · exact collar_one_sided_family g U hUo hFc hfront N ε σ hNo hFN hσb hgood x₀ hOne

theorem transversal_flow_box [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x)
    (hNg2 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → ℓ (Ng x ℓ) = 1)
    (hNg3 : ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
      (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
      ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
        (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x)
    (B : Set M) (hB : IsOpen B) (f : M → ℝ) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ x ∈ B, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) (q : M) (hq : q ∈ B) :
    ∃ (B' : Set M) (τ : ℝ) (Fl : ℝ → M → M), IsOpen B' ∧ q ∈ B' ∧ B' ⊆ B ∧ 0 < τ ∧
      (∀ y ∈ B', Fl 0 y = y ∧
        IsMIntegralCurveOn (fun t => Fl t y)
          (fun x => Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x)) (Set.Ioo (-τ) τ) ∧
        ∀ t ∈ Set.Ioo (-τ) τ, Fl t y ∈ B ∩ (chartAt E3 q).source ∧ f (Fl t y) = f y + t) ∧
      ContDiffOn ℝ ∞ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2)))
        (Set.Ioo (-τ) τ ×ˢ (chartAt E3 q '' B')) ∧
      (∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ chartAt E3 q '' B', ∀ (a : ℝ) (w : E3),
        fderiv ℝ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2))) (t, u) (a, w) = 0 →
        w = -a • fderiv ℝ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2))) (0, u) (1, 0)) :=
by
  
  have hV : ∀ x ∈ B, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
      (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x :=
    hNg3 B f hB hf.contMDiffOn hdf
  have hO : IsOpen ((chartAt E3 q) '' (B ∩ (chartAt E3 q).source)) :=
    (chartAt E3 q).isOpen_image_of_subset_source (hB.inter (chartAt E3 q).open_source)
      Set.inter_subset_right
  have hc : chartAt E3 q q ∈ (chartAt E3 q) '' (B ∩ (chartAt E3 q).source) :=
    ⟨q, ⟨hq, mem_chart_source E3 q⟩, rfl⟩
  have hY : ContDiffOn ℝ ∞
      (fun u : E3 => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm u)
        (Ng ((chartAt E3 q).symm u) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f ((chartAt E3 q).symm u))) : E3))
      (chartAt E3 q '' (B ∩ (chartAt E3 q).source)) := by
    have hloc : ∀ x ∈ B ∩ (chartAt E3 q).source, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞
        (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) y
