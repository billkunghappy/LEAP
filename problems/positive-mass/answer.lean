    have f1 : 2 * (2 * (2 * (2 * (16 * M ^ 4 * t ^ 4)))) = 256 * M ^ 4 * (t ^ 2) ^ 2 := by ring
    have f2 : 256 * M ^ 4 * (2 * M * G) ^ 2 = 1024 * M ^ 6 * G ^ 2 := by ring
    linarith
  · intro c
    have m2 : M * t ^ 2 ≤ M * (2 * M * G) := mul_le_mul_of_nonneg_left hGt2 hM0.le
    have m3 : 2 * M ^ 2 * G ≤ 1024 * M ^ 6 * G :=
      mul_le_mul_of_nonneg_right (by linarith) hGpos.le
    have f1 : M * (2 * M * G) = 2 * M ^ 2 * G := by ring
    linarith [huM c]

theorem pcgb_pole_metric_bounds (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (W : Set E2) (hW : IsOpen W)
    (hinv : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a b) W)
    (hΓ : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W)
    (hK : ContinuousOn (gaussCurv2 h) W) (x₀ : E2) (ρ : ℝ)
    (hsub : Metric.closedBall x₀ ρ ⊆ W) :
    ∃ κ C₀ : ℝ, 0 ≤ κ ∧ 0 ≤ C₀ ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
      (∀ a b : Fin 2, |(h x)⁻¹ a b - (h x₀)⁻¹ a b| ≤ κ * ‖x - x₀‖) ∧
      (∀ m c a : Fin 2, |christoffel2 h m c a x| ≤ C₀) ∧ |gaussCurv2 h x| ≤ C₀ :=
by
  have hKc : IsCompact (Metric.closedBall x₀ ρ) := isCompact_closedBall x₀ ρ
  have hKv : Convex ℝ (Metric.closedBall x₀ ρ) := convex_closedBall x₀ ρ
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by
    exact_mod_cast (le_top : (1 : ℕ∞) ≤ ⊤)
  
  have hGc : ContinuousOn
      (fun y => fun a b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y)
      (Metric.closedBall x₀ ρ) := by
    refine continuousOn_pi.2 fun a => continuousOn_pi.2 fun b => ?_
    exact ((hinv a b).continuousOn_fderiv_of_isOpen hW h1le).mono hsub
  obtain ⟨κ', hκ'⟩ := hKc.exists_bound_of_continuousOn hGc
  
  have hΓc : ContinuousOn
      (fun y => fun m c a : Fin 2 => christoffel2 h m c a y) (Metric.closedBall x₀ ρ) := by
    refine continuousOn_pi.2 fun m => continuousOn_pi.2 fun c => continuousOn_pi.2 fun a => ?_
    exact (hΓ m c a).continuousOn.mono hsub
  obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn hΓc
  obtain ⟨MK, hMK⟩ := hKc.exists_bound_of_continuousOn (hK.mono hsub)
  refine ⟨max κ' 0, max (max M MK) 0, le_max_right _ _, le_max_right _ _, ?_⟩
  intro x hx
  refine ⟨fun a b => ?_, fun m c a => ?_, ?_⟩
  · have hdiff : ∀ y ∈ Metric.closedBall x₀ ρ,
        DifferentiableAt ℝ (fun z => (h z)⁻¹ a b) y := fun y hy =>
      ((hinv a b).differentiableOn hne).differentiableAt (hW.mem_nhds (hsub hy))
    have hbd : ∀ y ∈ Metric.closedBall x₀ ρ,
        ‖fderiv ℝ (fun z => (h z)⁻¹ a b) y‖ ≤ max κ' 0 := by
      intro y hy
      have h1 := hκ' y hy
      have h2 := norm_le_pi_norm (fun b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y) b
      have h3 := norm_le_pi_norm (fun a b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y) a
      exact le_trans h2 (le_trans h3 (le_trans h1 (le_max_left _ _)))
    have hρ : 0 ≤ ρ := le_trans dist_nonneg (Metric.mem_closedBall.mp hx)
    have hx₀ : x₀ ∈ Metric.closedBall x₀ ρ := Metric.mem_closedBall_self hρ
    have := hKv.norm_image_sub_le_of_norm_fderiv_le hdiff hbd hx₀ hx
    rwa [Real.norm_eq_abs] at this
  · have h1 := hM x hx
    have h2 := norm_le_pi_norm (fun m c a : Fin 2 => christoffel2 h m c a x) m
    have h3 := norm_le_pi_norm (fun c a : Fin 2 => christoffel2 h m c a x) c
    have h4 := norm_le_pi_norm (fun a : Fin 2 => christoffel2 h m c a x) a
    rw [Real.norm_eq_abs] at h4
    exact le_trans h4 (le_trans h3 (le_trans h2 (le_trans h1
      (le_trans (le_max_left _ _) (le_max_left _ _)))))
  · have h1 := hMK x hx
    rw [Real.norm_eq_abs] at h1
    exact le_trans h1 (le_trans (le_max_right _ _) (le_max_left _ _))

theorem pcgb_log_r0_derivs (A₀ : Matrix (Fin 2) (Fin 2) ℝ) (hA : A₀.PosDef) (x₀ : E2) :
    (∀ y : E2, y ≠ x₀ → 0 < ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c) ∧
    ContDiffOn ℝ ∞ (fun y : E2 => Real.log (Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c))) {x₀}ᶜ ∧
    ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
      pd2 c (fun y : E2 => Real.log (Real.sqrt
        (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c))) x =
        (∑ b : Fin 2, A₀ c b * (x - x₀) b) /
          (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c) ∧
      pd2 c (pd2 a (fun y : E2 => Real.log (Real.sqrt
        (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c)))) x =
        A₀ c a / (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c) -
          2 * ((∑ b : Fin 2, A₀ c b * (x - x₀) b) /
            (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c)) *
          ((∑ b : Fin 2, A₀ a b * (x - x₀) b) /
            (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c)) :=
by
  have hsym : ∀ a c : Fin 2, A₀ a c = A₀ c a := fun a c => by
    have := hA.isHermitian.apply c a
    simpa using this
  
  have hpos : ∀ y : E2, y ≠ x₀ →
      0 < ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := by
    intro y hy
    have hne : (fun i : Fin 2 => (y - x₀) i) ≠ 0 := by
      intro h
      apply hy
      have h0 : y - x₀ = 0 := by
        ext i
        have := congrFun h i
        simpa using this
      exact sub_eq_zero.mp h0
    have h2 := hA.dotProduct_mulVec_pos hne
    have h3 : star (fun i : Fin 2 => (y - x₀) i) ⬝ᵥ A₀.mulVec (fun i : Fin 2 => (y - x₀) i) =
        ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial]
      ring
    linarith
  
  have hζ : ∀ (i : Fin 2) (y : E2), HasFDerivAt (fun y : E2 => (y - x₀) i)
      (PiLp.proj 2 (fun _ : Fin 2 => ℝ) i : E2 →L[ℝ] ℝ) y := by
    intro i y
    have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 y i).sub_const (x₀ i)
    convert h using 1
  have hζc : ∀ i : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) i) := by
    intro i
    have h1 : ContDiff ℝ ∞ (fun y : E2 => y - x₀) := contDiff_id.sub contDiff_const
    first
      | exact (PiLp.proj 2 (fun _ : Fin 2 => ℝ) i : E2 →L[ℝ] ℝ).contDiff.comp h1
      | exact (contDiff_piLp_apply (𝕜 := ℝ) (p := 2) (i := i)).comp h1
      | fun_prop
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ,
      Q = fun y => ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : Fin 2 → E2 → ℝ,
      N = fun a y => ∑ b : Fin 2, A₀ a b * (y - x₀) b := ⟨_, rfl⟩
  have hposQ : ∀ y : E2, y ≠ x₀ → 0 < Q y := by
    rw [hQ]; exact hpos
  have hQd : ∀ y : E2, HasFDerivAt Q
      (∑ a : Fin 2, ∑ c : Fin 2, ((A₀ a c * (y - x₀) a) •
        (PiLp.proj 2 (fun _ : Fin 2 => ℝ) c : E2 →L[ℝ] ℝ) +
        (y - x₀) c • (A₀ a c • (PiLp.proj 2 (fun _ : Fin 2 => ℝ) a : E2 →L[ℝ] ℝ)))) y := by
    intro y
    rw [hQ]
    have h := HasFDerivAt.sum (u := Finset.univ) (fun a _ => HasFDerivAt.sum
      (u := Finset.univ) (fun c _ => ((hζ a y).const_mul (A₀ a c)).mul (hζ c y)))
    convert h using 1
  have hNd : ∀ (a : Fin 2) (y : E2), HasFDerivAt (N a)
      (∑ b : Fin 2, A₀ a b • (PiLp.proj 2 (fun _ : Fin 2 => ℝ) b : E2 →L[ℝ] ℝ)) y := by
    intro a y
    rw [hN]
    show HasFDerivAt (fun y : E2 => ∑ b : Fin 2, A₀ a b * (y - x₀) b) _ y
    have h := HasFDerivAt.sum (u := Finset.univ) (fun b _ => (hζ b y).const_mul (A₀ a b))
    convert h using 1
  have hQc : ContDiff ℝ ∞ Q := by
    rw [hQ]
    exact ContDiff.sum (fun a _ => ContDiff.sum (fun c _ =>
      (contDiff_const.mul (hζc a)).mul (hζc c)))
  have h10 := hsym 1 0
  have hQpd : ∀ (y : E2) (k : Fin 2), fderiv ℝ Q y (e2 k) = 2 * N k y := by
    intro y k
    rw [(hQd y).fderiv, hN]
    fin_cases k <;>
      simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two, ContinuousLinearMap.sum_apply,
        h10] <;> ring
  have hNpd : ∀ (y : E2) (a k : Fin 2), fderiv ℝ (N a) y (e2 k) = A₀ a k := by
    intro y a k
    rw [(hNd a y).fderiv]
    fin_cases k <;>
      simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two, ContinuousLinearMap.sum_apply]
  have hU : IsOpen ({x₀}ᶜ : Set E2) := isOpen_compl_singleton
  have hev : ∀ y : E2, y ≠ x₀ → (fun z => Real.log (Real.sqrt (Q z))) =ᶠ[nhds y]
      (fun z => (1 / 2 : ℝ) * Real.log (Q z)) := by
    intro y hy
    filter_upwards [hU.mem_nhds hy] with z hz
    rw [Real.log_sqrt (hposQ z hz).le]
    ring
  have hsmooth : ContDiffOn ℝ ∞ (fun y => Real.log (Real.sqrt (Q y))) {x₀}ᶜ := by
    have hs : ContDiffOn ℝ ∞ (fun y => Real.log (Q y) / 2) {x₀}ᶜ :=
      (hQc.contDiffOn.log (fun y hy => (hposQ y hy).ne')).div_const 2
    refine hs.congr ?_
    intro y hy
    exact Real.log_sqrt (hposQ y hy).le
  have hd1 : ∀ y : E2, y ≠ x₀ → ∀ k : Fin 2,
      pd2 k (fun y => Real.log (Real.sqrt (Q y))) y = N k y / Q y := by
    intro y hy k
    have hQ0 := (hposQ y hy).ne'
    have h := ((((hQd y).differentiableAt.hasFDerivAt).log hQ0).const_mul
      (1 / 2 : ℝ)).congr_of_eventuallyEq (hev y hy)
    show fderiv ℝ (fun y => Real.log (Real.sqrt (Q y))) y (e2 k) = _
    rw [h.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hQpd y k]
    field_simp
  have hd2 : ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
      pd2 c (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x =
        A₀ c a / Q x - 2 * (N c x / Q x) * (N a x / Q x) := by
    intro x hx a c
    have hev2 : pd2 a (fun y => Real.log (Real.sqrt (Q y))) =ᶠ[nhds x]
        fun y => N a y / Q y := by
      filter_upwards [hU.mem_nhds hx] with z hz
      exact hd1 z hz a
    show fderiv ℝ (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x (e2 c) = _
    rw [hev2.fderiv_eq]
    have hQ0 := (hposQ x hx).ne'
    have hQx : HasFDerivAt Q (fderiv ℝ Q x) x := (hQd x).differentiableAt.hasFDerivAt
    have hNx : HasFDerivAt (N a) (fderiv ℝ (N a) x) x :=
      (hNd a x).differentiableAt.hasFDerivAt
    have hinv : HasFDerivAt (fun y => (Q y)⁻¹) ((-(Q x ^ 2)⁻¹) • fderiv ℝ Q x) x :=
      (hasDerivAt_inv hQ0).comp_hasFDerivAt x hQx
    have hprod : HasFDerivAt (fun y => N a y / Q y)
        (N a x • ((-(Q x ^ 2)⁻¹) • fderiv ℝ Q x) + (Q x)⁻¹ • fderiv ℝ (N a) x) x := by
      have := hNx.mul hinv
      simpa only [div_eq_mul_inv] using this
    rw [hprod.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hQpd x c, hNpd x a c, hsym a c]
    field_simp
    ring
  have key : (∀ y : E2, y ≠ x₀ → 0 < Q y) ∧
      ContDiffOn ℝ ∞ (fun y => Real.log (Real.sqrt (Q y))) {x₀}ᶜ ∧
      ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
        pd2 c (fun y => Real.log (Real.sqrt (Q y))) x = N c x / Q x ∧
        pd2 c (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x =
          A₀ c a / Q x - 2 * (N c x / Q x) * (N a x / Q x) :=
    ⟨hposQ, hsmooth, fun x hx a c => ⟨hd1 x hx c, hd2 x hx a c⟩⟩
  subst hQ hN
  exact key

theorem pcgb_pole_bounds {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ) (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2) :
    ∃ r₁ : ℝ, 0 < r₁ ∧ r₁ ≤ Gd.r ∧ ∀ ε : ℝ, 0 < ε → ∃ C : ℝ,
      ∀ x ∈ Metric.ball Gd.x₀ r₁, x ≠ Gd.x₀ →
        ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h Gd.j₀) (fun z => Gd.w (P.param Gd.j₀ z)) y + ε) +
            Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y)) x‖ ≤ C ∧
        |lap2 (P.h Gd.j₀) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h Gd.j₀) (fun z => Gd.w (P.param Gd.j₀ z)) y + ε)) x| ≤ C :=
by
  classical
  set h : E2 → Matrix (Fin 2) (Fin 2) ℝ := P.h Gd.j₀ with hhdef
  set w : E2 → ℝ := fun z => Gd.w (P.param Gd.j₀ z) with hwdef
  have hWo : IsOpen (P.W Gd.j₀) := P.W_open Gd.j₀
  have hhs : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) (P.W Gd.j₀) := P.h_smooth Gd.j₀
  have hpd : ∀ x ∈ P.W Gd.j₀, (h x).PosDef := P.h_posDef Gd.j₀
  have hsym : ∀ x ∈ P.W Gd.j₀, ∀ i j : Fin 2, h x i j = h x j i := by
    intro x hx i j
    have h1 := (hpd x hx).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  obtain ⟨hinv, -, hΓs, -, -, -⟩ := gs2_metric_calculus h (P.W Gd.j₀) hWo hhs hsym hpd
  have hKc : ContinuousOn (gaussCurv2 h) (P.W Gd.j₀) := gaussCurv2_continuousOn h _ hWo hhs hpd
  obtain ⟨κ, C₀M, hκ, hC₀M, hMB⟩ :=
    pcgb_pole_metric_bounds h (P.W Gd.j₀) hWo hinv hΓs hKc Gd.x₀ Gd.r Gd.ball_sub
  have hx₀W : Gd.x₀ ∈ P.W Gd.j₀ := Gd.ball_sub (Metric.mem_closedBall_self Gd.r_pos.le)
  have hC₀ : 0 ≤ max C₀M Gd.C := le_max_of_le_right Gd.C_nonneg
  obtain ⟨δ, K, hδ, hK, hAlg⟩ :=
    pcgb_pole_algebra (h Gd.x₀) (hpd Gd.x₀ hx₀W) κ (max C₀M Gd.C) hκ hC₀
  obtain ⟨hqpos, hℓs, hℓd⟩ := pcgb_log_r0_derivs (h Gd.x₀) (hpd Gd.x₀ hx₀W) Gd.x₀
  set ℓ : E2 → ℝ := fun y => Real.log (Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (y - Gd.x₀) a * (y - Gd.x₀) c)) with hℓdef
  have hu_eq : ∀ y : E2, y ≠ Gd.x₀ → ∀ c : Fin 2, pd2 c ℓ y =
      (∑ b : Fin 2, h Gd.x₀ c b * (y - Gd.x₀) b) /
        (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (y - Gd.x₀) a * (y - Gd.x₀) c) :=
    fun y hy c => (hℓd y hy c c).1
  
  have hsc1 : ∀ (ε G N u : ℝ), 0 < ε → 0 < G → |N + u * G| ≤ K * G → |u| ≤ K * G →
      |N / (G + ε) + u| ≤ K * (1 + ε) := by
    intro ε G N u hε hG h1 h2
    have hQ : 0 < G + ε := by linarith
    have heq : N / (G + ε) + u = (N + u * G + ε * u) / (G + ε) := by
      rw [div_add' _ _ _ hQ.ne']
      congr 1
      ring
    rw [heq, abs_div, abs_of_pos hQ, div_le_iff₀ hQ]
    have t : |N + u * G + ε * u| ≤ |N + u * G| + ε * |u| := by
      calc |N + u * G + ε * u| ≤ |N + u * G| + |ε * u| := abs_add_le _ _
        _ = |N + u * G| + ε * |u| := by rw [abs_mul, abs_of_pos hε]
    have hKG : 0 ≤ K * G := mul_nonneg hK hG.le
    nlinarith [mul_nonneg (mul_nonneg hK (by linarith : (0:ℝ) ≤ 1 + ε)) hε.le,
      mul_le_mul_of_nonneg_left h2 hε.le]
  have hsc2 : ∀ (ε G Kg HS : ℝ), 0 < ε → 0 < G → |Kg| ≤ max C₀M Gd.C → |HS| ≤ K * G ^ 2 →
      |Kg * G / (G + ε) + ε * HS / (G + ε) ^ 2| ≤ max C₀M Gd.C + ε * K := by
    intro ε G Kg HS hε hG h1 h2
    have hQ : 0 < G + ε := by linarith
    have hr : G / (G + ε) ≤ 1 := (div_le_one hQ).mpr (by linarith)
    have hr0 : 0 ≤ G / (G + ε) := div_nonneg hG.le hQ.le
    have t1 : |Kg * G / (G + ε)| ≤ max C₀M Gd.C := by
      rw [mul_div_assoc, abs_mul, abs_of_nonneg hr0]
      calc |Kg| * (G / (G + ε)) ≤ max C₀M Gd.C * 1 :=
            mul_le_mul h1 hr hr0 (le_trans (abs_nonneg _) h1)
        _ = max C₀M Gd.C := mul_one _
    have hQ2 : 0 < (G + ε) ^ 2 := by positivity
    have t2 : |ε * HS / (G + ε) ^ 2| ≤ ε * K := by
      rw [abs_div, abs_mul, abs_of_pos hε, abs_of_pos hQ2, div_le_iff₀ hQ2]
      have hG2 : G ^ 2 ≤ (G + ε) ^ 2 := by nlinarith
      calc ε * |HS| ≤ ε * (K * G ^ 2) := mul_le_mul_of_nonneg_left h2 hε.le
        _ = (ε * K) * G ^ 2 := by ring
        _ ≤ (ε * K) * (G + ε) ^ 2 := mul_le_mul_of_nonneg_left hG2 (mul_nonneg hε.le hK)
    calc |Kg * G / (G + ε) + ε * HS / (G + ε) ^ 2|
        ≤ |Kg * G / (G + ε)| + |ε * HS / (G + ε) ^ 2| := abs_add_le _ _
      _ ≤ max C₀M Gd.C + ε * K := add_le_add t1 t2
  
  have hnorm2 : ∀ D : E2 →L[ℝ] ℝ, ‖D‖ ≤ |D (e2 0)| + |D (e2 1)| := by
    intro D
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
    have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    have h0 : |v 0| ≤ ‖v‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le v 0
    have h1 : |v 1| ≤ ‖v‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le v 1
    have hDv : D v = v 0 * D (e2 0) + v 1 * D (e2 1) := by
      conv_lhs => rw [hv]
      simp [map_add, map_smul, smul_eq_mul]
    rw [Real.norm_eq_abs, hDv]
    calc |v 0 * D (e2 0) + v 1 * D (e2 1)| ≤ |v 0| * |D (e2 0)| + |v 1| * |D (e2 1)| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ ‖v‖ * |D (e2 0)| + ‖v‖ * |D (e2 1)| := by gcongr
      _ = (|D (e2 0)| + |D (e2 1)|) * ‖v‖ := by ring
  refine ⟨min Gd.r δ, lt_min Gd.r_pos hδ, min_le_left _ _, ?_⟩
  intro ε hε
  refine ⟨max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K), ?_⟩
  intro x hx hxne
  
  set O : Set E2 := Metric.ball Gd.x₀ Gd.r ∩ {Gd.x₀}ᶜ with hOdef
  have hOo : IsOpen O := Metric.isOpen_ball.inter isOpen_compl_singleton
  have hOW : O ⊆ P.W Gd.j₀ := fun y hy => Gd.ball_sub (Metric.ball_subset_closedBall hy.1)
  have hOgood : ∀ y ∈ O, y ∈ P.W Gd.j₀ ∩ P.param Gd.j₀ ⁻¹' (Gd.U \ {Gd.p₀}) ∧
      0 ≤ b (P.param Gd.j₀ y) ∧ P.param Gd.j₀ y ≠ Gd.p₀ := by
    intro y hy
    have hyW : y ∈ P.W Gd.j₀ := hOW hy
    have hyS : P.param Gd.j₀ y ∈ S := by
      have h1 : P.param Gd.j₀ y ∈ P.param Gd.j₀ '' P.W Gd.j₀ := Set.mem_image_of_mem _ hyW
      rw [P.image_eq Gd.j₀] at h1
      exact h1.2
    have hb : 0 ≤ b (P.param Gd.j₀ y) := by
      have h1 := Gd.ball_pos y (Metric.ball_subset_closedBall hy.1)
      have h2 := Gd.r_pos
      linarith
    have hne : P.param Gd.j₀ y ≠ Gd.p₀ := by
      intro heq
      have h1 := P.proj_param Gd.j₀ y hyW
      rw [heq, ← Gd.param_x₀, P.proj_param Gd.j₀ Gd.x₀ hx₀W] at h1
      exact hy.2 (Set.mem_singleton_iff.mpr h1.symm)
    exact ⟨⟨hyW, Gd.R_sub ⟨hyS, hb⟩, hne⟩, hb, hne⟩
  have hws : ContDiffOn ℝ ∞ w O := (Gd.smooth Gd.j₀).mono (fun y hy => (hOgood y hy).1)
  have hwharm : ∀ y ∈ O, lap2 h w y = 0 :=
    fun y hy => Gd.harm Gd.j₀ y (hOW hy) (hOgood y hy).2.1 (hOgood y hy).2.2
  have hxball : x ∈ Metric.ball Gd.x₀ Gd.r := Metric.ball_subset_ball (min_le_left _ _) hx
  have hxO : x ∈ O := ⟨hxball, hxne⟩
  have hxcl : x ∈ Metric.closedBall Gd.x₀ Gd.r := Metric.ball_subset_closedBall hxball
  
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hℓO : ContDiffOn ℝ ∞ ℓ O := hℓs.mono (fun y hy => hy.2)
  set v : E2 → ℝ := fun y => w y - ℓ y with hvdef
  have hvO : ContDiffOn ℝ ∞ v O := hws.sub hℓO
  have hdiff : ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f O → ∀ y ∈ O, DifferentiableAt ℝ f y :=
    fun f hf y hy => (hf.contDiffAt (hOo.mem_nhds hy)).differentiableAt hne
  have hpdO : ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f O → ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a f) O :=
    fun f hf a => (hf.fderiv_of_isOpen hOo le_rfl).clm_apply contDiffOn_const
  have hsplit1 : ∀ y ∈ O, ∀ a : Fin 2, pd2 a w y = pd2 a ℓ y + pd2 a v y := by
    intro y hy a
    have h1 : fderiv ℝ v y = fderiv ℝ w y - fderiv ℝ ℓ y :=
      fderiv_sub (hdiff w hws y hy) (hdiff ℓ hℓO y hy)
    show fderiv ℝ w y (e2 a) = fderiv ℝ ℓ y (e2 a) + fderiv ℝ v y (e2 a)
    rw [h1, ContinuousLinearMap.sub_apply]
    ring
  have hsplit2 : ∀ a c : Fin 2, pd2 c (pd2 a w) x = pd2 c (pd2 a ℓ) x + pd2 c (pd2 a v) x := by
    intro a c
    have hev : pd2 a w =ᶠ[𝓝 x] fun y => pd2 a ℓ y + pd2 a v y :=
      Filter.eventually_of_mem (hOo.mem_nhds hxO) (fun y hy => hsplit1 y hy a)
    have h1 : fderiv ℝ (pd2 a w) x = fderiv ℝ (pd2 a ℓ) x + fderiv ℝ (pd2 a v) x := by
      rw [hev.fderiv_eq]
      exact fderiv_add (hdiff _ (hpdO ℓ hℓO a) x hxO) (hdiff _ (hpdO v hvO a) x hxO)
    show fderiv ℝ (pd2 a w) x (e2 c) = fderiv ℝ (pd2 a ℓ) x (e2 c) + fderiv ℝ (pd2 a v) x (e2 c)
    rw [h1, ContinuousLinearMap.add_apply]
  have he2 : ∀ a : Fin 2, ‖e2 a‖ = 1 := fun a => by simp [EuclideanSpace.norm_single]
  have hv1b : ∀ a : Fin 2, |pd2 a v x| ≤ ‖fderiv ℝ v x‖ := by
    intro a
    have h1 := (fderiv ℝ v x).le_opNorm (e2 a)
    rw [he2, mul_one, Real.norm_eq_abs] at h1
    exact h1
  have hv2b : ∀ a c : Fin 2, |pd2 c (pd2 a v) x| ≤ ‖fderiv ℝ (fderiv ℝ v) x‖ := by
    intro a c
    have hD : DifferentiableAt ℝ (fderiv ℝ v) x :=
      ((hvO.fderiv_of_isOpen hOo le_rfl).contDiffAt (hOo.mem_nhds hxO)).differentiableAt hne
    have heq : pd2 c (pd2 a v) x = fderiv ℝ (fderiv ℝ v) x (e2 c) (e2 a) := by
      have hF := hD.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 a) x)
      show fderiv ℝ (fun y => fderiv ℝ v y (e2 a)) x (e2 c) = _
      rw [hF.fderiv]
      simp
    rw [heq]
    have h1 := (fderiv ℝ (fderiv ℝ v) x).le_opNorm₂ (e2 c) (e2 a)
    rw [he2, he2, mul_one, mul_one, Real.norm_eq_abs] at h1
    exact h1
  
  obtain ⟨-, hp1, hp2⟩ := Gd.pole x hxball hxne
  have hp1' : ‖fderiv ℝ v x‖ ≤ Gd.C := hp1
  have hp2' : ‖fderiv ℝ (fderiv ℝ v) x‖ ≤ Gd.C / Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (x - Gd.x₀) a * (x - Gd.x₀) c) := hp2
  
  have hs0 : 0 < ‖x - Gd.x₀‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hxne)
  have hsδ : ‖x - Gd.x₀‖ ≤ δ := by
    have h1 : dist x Gd.x₀ < min Gd.r δ := hx
    rw [dist_eq_norm] at h1
    exact le_of_lt (lt_of_lt_of_le h1 (min_le_right _ _))
  have hz : (x - Gd.x₀) 0 ^ 2 + (x - Gd.x₀) 1 ^ 2 = ‖x - Gd.x₀‖ ^ 2 := by
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hpb : ∀ a : Fin 2, |pd2 a w x - pd2 a ℓ x| ≤ max C₀M Gd.C := by
    intro a
    rw [hsplit1 x hxO a, add_sub_cancel_left]
    exact le_trans (hv1b a) (le_trans hp1' (le_max_right _ _))
  have hHb : ∀ c a : Fin 2,
      |(pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) +
          ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x -
        (h Gd.x₀ c a / (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) -
          2 * pd2 c ℓ x * pd2 a ℓ x)| ≤
      max C₀M Gd.C /
        Real.sqrt (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) := by
    intro c a
    have e1 : (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) +
          ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x -
        (h Gd.x₀ c a / (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) -
          2 * pd2 c ℓ x * pd2 a ℓ x) = pd2 c (pd2 a v) x := by
      rw [hsplit2 a c, (hℓd x hxne a c).2, hu_eq x hxne c, hu_eq x hxne a]
      ring
    rw [e1]
    refine le_trans (hv2b a c) (le_trans hp2' ?_)
    exact div_le_div_of_nonneg_right (le_max_right _ _) (Real.sqrt_nonneg _)
  obtain ⟨hGpos, hNb, hHSb, hub⟩ := hAlg (fun i => (x - Gd.x₀) i) ‖x - Gd.x₀‖ hs0 hsδ hz (h x)⁻¹
    (fun c => pd2 c ℓ x) (fun a => pd2 a w x)
    (fun c a => pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x)
    (fun m c a => christoffel2 h m c a x)
    (fun a b => (hMB x hxcl).1 a b) (fun c => hu_eq x hxne c) hpb hHb
    (fun m c a => le_trans ((hMB x hxcl).2.1 m c a) (le_max_left _ _))
  have hGpos' : 0 < sgbGradSq2 h w x := hGpos
  
  have hGO : ContDiffOn ℝ ∞ (sgbGradSq2 h w) O := by
    have h1 : ContDiffOn ℝ ∞
        (fun y => ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a w y * pd2 c w y) O :=
      ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
        (((hinv a c).mono hOW).mul (hpdO w hws a)).mul (hpdO w hws c)))
    exact h1
  have hGd : DifferentiableAt ℝ (sgbGradSq2 h w) x := hdiff _ hGO x hxO
  have hgrad : ∀ c : Fin 2, fderiv ℝ (sgbGradSq2 h w) x (e2 c) =
      2 * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
        (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x := by
    intro c
    exact bl2_grad_Q O hOo h (fun a b => (hhs a b).mono hOW) (fun y hy => hpd y (hOW hy)) w hws
      x hxO c
  have hGε : 0 < sgbGradSq2 h w x + ε := by linarith
  have hL : HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε))
      ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x)) x :=
    ((hGd.hasFDerivAt.add_const ε).log hGε.ne').const_mul (1 / 2 : ℝ)
  have hℓx : HasFDerivAt ℓ (fderiv ℝ ℓ x) x := (hdiff ℓ hℓO x hxO).hasFDerivAt
  have hF : HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε) +
      Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y))
      ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x) +
        fderiv ℝ ℓ x) x :=
    hL.add hℓx
  have hcb : ∀ c : Fin 2, |((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ •
      fderiv ℝ (sgbGradSq2 h w) x) + fderiv ℝ ℓ x) (e2 c)| ≤ K * (1 + ε) := by
    intro c
    have hcomp : ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x) +
        fderiv ℝ ℓ x) (e2 c) =
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
          (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x) /
          (sgbGradSq2 h w x + ε) + pd2 c ℓ x := by
      rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smul_apply, hgrad c, smul_eq_mul, smul_eq_mul]
      have h1 : pd2 c ℓ x = fderiv ℝ ℓ x (e2 c) := rfl
      rw [h1, div_eq_mul_inv]
      ring
    rw [hcomp]
    exact hsc1 ε (sgbGradSq2 h w x)
      (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
        (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x)
      (pd2 c ℓ x) hε hGpos' (hNb c) (hub c)
  have hfin1 : ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε) +
      Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y)) x‖ ≤
      max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K) := by
    rw [hF.fderiv]
    refine le_trans (hnorm2 _) ?_
    refine le_trans ?_ (le_max_left _ _)
    have h0 := hcb 0
    have h1 := hcb 1
    linarith
  
  have hlap := hkato O hOo h (fun a b => (hhs a b).mono hOW) (fun y hy => hpd y (hOW hy)) w hws
    hwharm ε hε x hxO
  have hfin2 : |lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x| ≤
      max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K) := by
    rw [hlap]
    exact le_trans (hsc2 ε _ _ _ hε hGpos' (le_trans (hMB x hxcl).2.2 (le_max_left _ _)) hHSb)
      (le_max_right _ _)
  exact ⟨hfin1, hfin2⟩

theorem pcgb_collar_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0) :
    ∃ sG : ℝ, 0 < sG ∧ ∀ s : ℝ, 0 < s → s < sG → ∀ j,
      MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  
  have hdens : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      ContinuousOn (fun x => sgbLevelCurv2 h f x) {x | x ∈ W ∧ fderiv ℝ f x ≠ 0} ∧
      ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h f x)) W ∧
      ContinuousOn (fun x => Real.sqrt (h x).det) W := by
    intro W hW h hh hpos f hf
    have hh1 : ∀ a c, ContDiffOn ℝ 1 (fun x => h x a c) W := fun a c => (hh a c).of_le h1inf
    have hdetEq : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two (h x)
    have hdet1 : ContDiffOn ℝ 1 (fun x => (h x).det) W := by
      rw [hdetEq]; exact ((hh1 0 0).mul (hh1 1 1)).sub ((hh1 0 1).mul (hh1 1 0))
    have hdetpos : ∀ x ∈ W, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
    have hsd1 : ContDiffOn ℝ 1 (fun x => Real.sqrt (h x).det) W :=
      hdet1.sqrt (fun x hx => (hdetpos x hx).ne')
    have hsdpos : ∀ x ∈ W, 0 < Real.sqrt (h x).det := fun x hx => Real.sqrt_pos.mpr (hdetpos x hx)
    have hinv1 : ∀ a c : Fin 2, ContDiffOn ℝ 1 (fun x => (h x)⁻¹ a c) W := by
      intro a c
      have heq : (fun x => (h x)⁻¹ a c) = fun x => ((h x).det)⁻¹ *
          (!![h x 1 1, -h x 0 1; -h x 1 0, h x 0 0] : Matrix (Fin 2) (Fin 2) ℝ) a c := by
        funext x
        rw [Matrix.inv_def, Matrix.adjugate_fin_two, Matrix.smul_apply, smul_eq_mul,
          Ring.inverse_eq_inv']
      rw [heq]
      refine (hdet1.inv (fun x hx => (hdetpos x hx).ne')).mul ?_
      fin_cases a <;> fin_cases c
      · simpa using (hh1 1 1)
      · simpa using (hh1 0 1).neg
      · simpa using (hh1 1 0).neg
      · simpa using (hh1 0 0)
    have hf2 : ContDiffOn ℝ 2 f W := hf.of_le h2inf
    have hdf : ContDiffOn ℝ 1 (fderiv ℝ f) W := hf2.fderiv_of_isOpen hW (by norm_num)
    have hpd1 : ∀ a : Fin 2, ContDiffOn ℝ 1 (fun x => pd2 a f x) W := fun a =>
      hdf.clm_apply contDiffOn_const
    have hG1 : ContDiffOn ℝ 1 (fun x => sgbGradSq2 h f x) W := by
      unfold sgbGradSq2
      exact ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
        ((hinv1 a c).mul (hpd1 a)).mul (hpd1 c)))
    refine ⟨?_, hG1.continuousOn.sqrt, hsd1.continuousOn⟩
    
    set V := {x | x ∈ W ∧ fderiv ℝ f x ≠ 0} with hVdef
    have hVeq : V = W ∩ (fderiv ℝ f) ⁻¹' {0}ᶜ := rfl
    have hVo : IsOpen V := by
      rw [hVeq]
      exact (hf.continuousOn_fderiv_of_isOpen hW h1inf).isOpen_inter_preimage hW
        isOpen_compl_singleton
    have hVW : V ⊆ W := fun x hx => hx.1
    have hGpos : ∀ x ∈ V, 0 < sgbGradSq2 h f x := by
      intro x hx
      set v : Fin 2 → ℝ := fun a => pd2 a f x with hv
      have hv0 : v ≠ 0 := by
        intro hv0
        apply hx.2
        have h0 : fderiv ℝ f x (e2 0) = 0 := congrFun hv0 0
        have h1 : fderiv ℝ f x (e2 1) = 0 := congrFun hv0 1
        ext1 z
        have hz : z = z 0 • e2 0 + z 1 • e2 1 := by
          ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
        rw [hz, map_add, map_smul, map_smul, h0, h1]
        simp
      have hp := (hpos x (hVW hx)).inv.dotProduct_mulVec_pos hv0
      have heq : star v ⬝ᵥ (h x)⁻¹.mulVec v = sgbGradSq2 h f x := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, sgbGradSq2, Fin.sum_univ_two, hv]
        ring
      rw [← heq]; exact hp
    
    set Y : Fin 2 → E2 → ℝ := fun i y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y) with hYdef
    have hY1 : ∀ i, ContDiffOn ℝ 1 (Y i) V := by
      intro i
      have hnum : ContDiffOn ℝ 1 (fun y => Real.sqrt (h y).det *
          (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y)) V :=
        (hsd1.mul (ContDiffOn.sum (fun a _ => (hinv1 i a).mul (hpd1 a)))).mono hVW
      have hden : ContDiffOn ℝ 1 (fun y => Real.sqrt (sgbGradSq2 h f y)) V :=
        (hG1.mono hVW).sqrt (fun y hy => (hGpos y hy).ne')
      exact hnum.div hden (fun y hy => (Real.sqrt_pos.mpr (hGpos y hy)).ne')
    have hcurv : (fun x => sgbLevelCurv2 h f x) =
        fun x => -((Real.sqrt (h x).det)⁻¹ * ∑ i : Fin 2, fderiv ℝ (Y i) x (e2 i)) := rfl
    rw [hcurv]
    refine ContinuousOn.neg (ContinuousOn.mul ?_ ?_)
    · exact (hsd1.continuousOn.mono hVW).inv₀ (fun x hx => (hsdpos x (hVW hx)).ne')
    · exact continuousOn_finset_sum _ (fun i _ =>
        ((hY1 i).continuousOn_fderiv_of_isOpen hVo le_rfl).clm_apply continuousOn_const)
  
  have hband : ∃ sb : ℝ, 0 < sb ∧ ∀ j, ∀ x ∈ Kc j, 0 ≤ b (P.param j x) →
      b (P.param j x) < sb → fderiv ℝ (fun y => b (P.param j y)) x ≠ 0 := by
    have hev : ∀ j, ∀ᶠ s in 𝓝[>] (0:ℝ), ∀ x ∈ Kc j, 0 ≤ b (P.param j x) →
        b (P.param j x) < s → fderiv ℝ (fun y => b (P.param j y)) x ≠ 0 := by
      intro j
      have hbc : ContinuousOn (fun y => b (P.param j y)) (Kc j) :=
        (hb j).continuousOn.mono (hK j).2
      have hdc : ContinuousOn (fderiv ℝ (fun y => b (P.param j y))) (Kc j) :=
        ((hb j).continuousOn_fderiv_of_isOpen (P.W_open j) h1inf).mono (hK j).2
      have hA : IsClosed (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) :=
        hbc.preimage_isClosed_of_isClosed (hK j).1.isClosed isClosed_Ici
      have hZ : IsClosed ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) :=
        (hdc.mono Set.inter_subset_left).preimage_isClosed_of_isClosed hA isClosed_singleton
      have hZc : IsCompact ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) :=
        (hK j).1.of_isClosed_subset hZ (fun x hx => hx.1.1)
      rcases Set.eq_empty_or_nonempty ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) with he | hne
      · refine Filter.Eventually.of_forall (fun s x hx h0 _ hd => ?_)
        have hmem : x ∈ ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
            (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) := ⟨⟨hx, h0⟩, hd⟩
        rw [he] at hmem
        exact hmem
      · obtain ⟨z, hz, hmin⟩ := hZc.exists_isMinOn hne (hbc.mono (fun x hx => hx.1.1))
        have hz0 : (0:ℝ) ≤ b (P.param j z) := hz.1.2
        have hzd : fderiv ℝ (fun y => b (P.param j y)) z = 0 := hz.2
        have hm : 0 < b (P.param j z) := by
          rcases hz0.lt_or_eq with h | h
          · exact h
          · exact absurd hzd (hreg j z ((hK j).2 hz.1.1) h.symm)
        filter_upwards [Ioo_mem_nhdsGT hm] with s hs x hx h0 hlt hd
        have := (isMinOn_iff.mp hmin) x ⟨⟨hx, h0⟩, hd⟩
        have hs2 : s < b (P.param j z) := hs.2
        simp only at this
        linarith
    have hall := Filter.eventually_all.mpr hev
    obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hall
    have hu' : (0:ℝ) < u := hu
    exact ⟨u / 2, half_pos hu', fun j => hsub ⟨half_pos hu', half_lt_self hu'⟩ j⟩
  obtain ⟨sb, hsb, hband⟩ := hband
  
  have hη : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  have hη0 : ∀ t : ℝ, (t < 0 ∨ 1 < t) → deriv Real.smoothTransition t = 0 := by
    intro t ht
    rcases ht with ht | ht
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds ht)
          (fun y hy => Real.smoothTransition.zero_of_nonpos (le_of_lt hy))
      rw [hev.deriv_eq]; simp
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (1:ℝ) :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds ht)
          (fun y hy => Real.smoothTransition.one_of_one_le (le_of_lt hy))
      rw [hev.deriv_eq]; simp
  
  refine ⟨sb, hsb, fun s hs hssb j => ?_⟩
  obtain ⟨cK, cG, cD⟩ := hdens (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j) _ (hb j)
  have hKW : Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s ⊆ P.W j :=
    fun x hx => (hK j).2 hx.1
  have hKV : Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s ⊆
      {x | x ∈ P.W j ∧ fderiv ℝ (fun y => b (P.param j y)) x ≠ 0} := fun x hx =>
    ⟨hKW hx, hband j x hx.1 hx.2.1 (lt_of_le_of_lt hx.2.2 hssb)⟩
  have hKc : IsCompact (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s) :=
    (hK j).1.of_isClosed_subset
      (((hb j).continuousOn.mono (hK j).2).preimage_isClosed_of_isClosed (hK j).1.isClosed
        isClosed_Icc) Set.inter_subset_left
  have hcont : ContinuousOn (fun x => ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s) := by
    refine ContinuousOn.mul (ContinuousOn.mul ((hρs j j).continuousOn.mono hKW) ?_) (cD.mono hKW)
    refine ContinuousOn.mul (ContinuousOn.mul (ContinuousOn.mul continuousOn_const ?_)
      (cG.mono hKW)) (cK.mono hKV)
    exact hη.comp_continuousOn (((hb j).continuousOn.div_const s).mono hKW)
  refine MeasureTheory.IntegrableOn.of_forall_diff_eq_zero (hcont.integrableOn_compact hKc)
    (P.W_open j).measurableSet ?_
  rintro x ⟨hxW, hxK⟩
  by_cases hxc : x ∈ Kc j
  · have hb' : b (P.param j x) < 0 ∨ s < b (P.param j x) := by
      by_contra hcon
      push_neg at hcon
      exact hxK ⟨hxc, hcon.1, hcon.2⟩
    have hd0 : deriv Real.smoothTransition (b (P.param j x) / s) = 0 := by
      apply hη0
      rcases hb' with h | h
      · left; exact div_neg_of_neg_of_pos h hs
      · right; exact (one_lt_div hs).mpr h
    simp [hd0]
  · simp [hρK j x hxW hxc]

theorem pcgb_bulk_curv_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (s : ℝ) (j : Fin P.n) :
    MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have hs : IsOpen (P.W j) := P.W_open j
  have hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => P.h j x a c) (P.W j) := P.h_smooth j
  have hinf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f (P.W j) → ∀ c : Fin 2,
      ContDiffOn ℝ ∞ (pd2 c f) (P.W j) := by
    intro f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) (P.W j) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdet : ∀ y ∈ P.W j, (P.h j y).det ≠ 0 := fun y hy => (P.h_posDef j y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (P.h j y).det) (P.W j) := by
    have heq : (fun y => (P.h j y).det) =
        fun y => P.h j y 0 0 * P.h j y 1 1 - P.h j y 0 1 * P.h j y 1 0 := by
      funext y
      exact Matrix.det_fin_two (P.h j y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (P.h j y).adjugate a c) (P.W j) := by
    intro a c
    fin_cases a <;> fin_cases c <;> simp [Matrix.adjugate_fin_two] <;>
      first | exact hh _ _ | exact (hh _ _).neg
  have hinv : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (P.h j y)⁻¹ a c) (P.W j) := by
    intro a c
    have heq : (fun y => (P.h j y)⁻¹ a c) =
        fun y => ((P.h j y).det)⁻¹ * (P.h j y).adjugate a c := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetS.inv hdet).mul (hadj a c)
  have hchr : ∀ k a c : Fin 2, ContDiffOn ℝ ∞ (christoffel2 (P.h j) k a c) (P.W j) := by
    intro k a c
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (P.h j x)⁻¹ k l *
      (pd2 a (fun z => P.h j z c l) x + pd2 c (fun z => P.h j z a l) x
        - pd2 l (fun z => P.h j z a c) x)) (P.W j)
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
      (((hinf _ (hh c l) a).add (hinf _ (hh a l) c)).sub (hinf _ (hh a c) l)))
  have hchrC : ∀ k a c : Fin 2, ContinuousOn (christoffel2 (P.h j) k a c) (P.W j) :=
    fun k a c => (hchr k a c).continuousOn
  have hdchr : ∀ d k a c : Fin 2, ContinuousOn (pd2 d (christoffel2 (P.h j) k a c)) (P.W j) :=
    fun d k a c => (hinf _ (hchr k a c) d).continuousOn
  have hric : ∀ a c : Fin 2, ContinuousOn (ricci2 (P.h j) a c) (P.W j) := by
    intro a c
    show ContinuousOn (fun x => ∑ i : Fin 2,
        (pd2 i (christoffel2 (P.h j) i a c) x - pd2 a (christoffel2 (P.h j) i i c) x)
      + ∑ i : Fin 2, ∑ p : Fin 2,
          (christoffel2 (P.h j) i i p x * christoffel2 (P.h j) p a c x
            - christoffel2 (P.h j) i a p x * christoffel2 (P.h j) p i c x)) (P.W j)
    exact (continuousOn_finset_sum _ fun i _ => (hdchr i i a c).sub (hdchr a i i c)).add
      (continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun p _ =>
        ((hchrC i i p).mul (hchrC p a c)).sub ((hchrC i a p).mul (hchrC p i c)))
  have hKc : ContinuousOn (gaussCurv2 (P.h j)) (P.W j) := by
    show ContinuousOn
      (fun x => (1 / 2 : ℝ) * ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * ricci2 (P.h j) a c x)
      (P.W j)
    exact continuousOn_const.mul (continuousOn_finset_sum _ fun a _ =>
      continuousOn_finset_sum _ fun c _ => (hinv a c).continuousOn.mul (hric a c))
  have hρc : ContinuousOn (fun x => ρ j (P.param j x)) (P.W j) := (hρs j j).continuousOn
  have hηc : ContinuousOn (fun x => Real.smoothTransition (b (P.param j x) / s)) (P.W j) :=
    Real.smoothTransition.continuous.comp_continuousOn ((hb j).continuousOn.div_const s)
  have hdA : ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) :=
    hdetS.continuousOn.sqrt
  have hA : ContinuousOn (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
      Real.sqrt (P.h j x).det) (P.W j) :=
    (hρc.mul (hηc.mul hKc)).mul hdA
  have hAK : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
      Real.sqrt (P.h j x).det) (Kc j) :=
    (hA.mono (hK j).2).integrableOn_compact (hK j).1
  refine hAK.of_forall_diff_eq_zero hs.measurableSet ?_
  intro x hx
  rw [hρK j x hx.1 hx.2]
  ring

theorem pcgb_bulk_defect_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (b w : X → ℝ)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (j : Fin P.n)
    (hA : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) (P.W j)) :
    MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have hWm : MeasurableSet (P.W j) := (P.W_open j).measurableSet
  have hent : ∀ u v : Fin 2, AEMeasurable (fun x => P.h j x u v)
      (MeasureTheory.volume.restrict (P.W j)) :=
    fun u v => ((P.h_smooth j u v).continuousOn.aestronglyMeasurable hWm).aemeasurable
  have hinv_eq : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (a c : Fin 2),
      A⁻¹ a c = (A.det)⁻¹ * A.adjugate a c := by
    intro A a c
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hdet : AEMeasurable (fun x => ((P.h j x).det)⁻¹)
      (MeasureTheory.volume.restrict (P.W j)) := by
    have hd : (fun x => (P.h j x).det) =
        fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    have h1 : AEMeasurable (fun x => (P.h j x).det) (MeasureTheory.volume.restrict (P.W j)) := by
      rw [hd]
      exact ((hent 0 0).mul (hent 1 1)).sub ((hent 0 1).mul (hent 1 0))
    exact h1.inv
  have hadj : ∀ a c : Fin 2, AEMeasurable (fun x => (P.h j x).adjugate a c)
      (MeasureTheory.volume.restrict (P.W j)) := by
    intro a c
    fin_cases a <;> fin_cases c <;> simp [Matrix.adjugate_fin_two] <;>
      first
        | exact hent _ _
        | exact (hent _ _).neg
  have hinvE : ∀ a c : Fin 2, AEMeasurable (fun x => (P.h j x)⁻¹ a c)
      (MeasureTheory.volume.restrict (P.W j)) := by
    intro a c
    simp_rw [hinv_eq]
    exact hdet.mul (hadj a c)
  have hp : ∀ a : Fin 2, Measurable (fun x => pd2 a (fun y => w (P.param j y)) x) :=
    fun a => measurable_fderiv_apply_const ℝ _ _
  have hG : AEMeasurable (fun x => sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x)
      (MeasureTheory.volume.restrict (P.W j)) := by
    simp only [sgbGradSq2, Fin.sum_univ_two]
    exact ((((hinvE 0 0).mul (hp 0).aemeasurable).mul (hp 0).aemeasurable).add
      (((hinvE 0 1).mul (hp 0).aemeasurable).mul (hp 1).aemeasurable)).add
      ((((hinvE 1 0).mul (hp 1).aemeasurable).mul (hp 0).aemeasurable).add
      (((hinvE 1 1).mul (hp 1).aemeasurable).mul (hp 1).aemeasurable))
  have hf : MeasureTheory.AEStronglyMeasurable
      (fun x => ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε))
      (MeasureTheory.volume.restrict (P.W j)) :=
    ((hG.add_const ε).const_div ε).aestronglyMeasurable
  have hbound : ∀ᵐ x ∂(MeasureTheory.volume.restrict (P.W j)),
      ‖ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε)‖ ≤ 1 := by
    refine MeasureTheory.ae_restrict_of_forall_mem hWm (fun x hx => ?_)
    have hG0 : 0 ≤ sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x := by
      have hpsd := (P.h_posDef j x hx).inv.posSemidef
      have hq := hpsd.dotProduct_mulVec_nonneg (fun a => pd2 a (fun y => w (P.param j y)) x)
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial] at hq
      simp only [sgbGradSq2, Fin.sum_univ_two]
      ring_nf at hq ⊢
      linarith
    have hpos : 0 < sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε := by linarith
    have hnn : 0 ≤ ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε) :=
      div_nonneg hε.le hpos.le
    rw [Real.norm_eq_abs, abs_of_nonneg hnn]
    exact (div_le_one hpos).mpr (by linarith)
  have key := MeasureTheory.Integrable.bdd_mul (c := 1) hA hf hbound
  refine MeasureTheory.Integrable.congr key (MeasureTheory.ae_of_all _ (fun x => ?_))
  simp only
  ring

theorem pcgb_bulk_kato_pointwise {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (hs : 0 < s) (j : Fin P.n)
    (x : E2) (hx : x ∈ P.W j) (hxp : P.param j x ≠ Gd.p₀) :
    ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det ≤
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det +
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det :=
by
  
  have quad : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef →
      (∀ ξ : Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) ∧
      (∀ H : Fin 2 → Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) := by
    intro A hA
    have hB : A⁻¹.PosDef := hA.inv
    have hsym : A⁻¹ 1 0 = A⁻¹ 0 1 := by
      have h := hB.isHermitian.apply 0 1
      simpa using h
    have hp : 0 < A⁻¹ 0 0 := hB.diag_pos
    have hdet : 0 < A⁻¹.det := hB.det_pos
    rw [Matrix.det_fin_two, hsym] at hdet
    have hδ : 0 < A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2 := by nlinarith
    have key1 : ∀ ξ : Fin 2 → ℝ,
        A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) =
          (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1) ^ 2 +
            (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * ξ 1 ^ 2 := by
      intro ξ
      simp only [Fin.sum_univ_two, hsym]
      ring
    have key2 : ∀ H : Fin 2 → Fin 2 → ℝ,
        A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) =
          (A⁻¹ 0 0 ^ 2 * H 0 0 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 0 1 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 1 0
              + A⁻¹ 0 1 ^ 2 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 0 1 + A⁻¹ 0 1 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 1 0 + A⁻¹ 0 1 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) ^ 2 * H 1 1 ^ 2 := by
      intro H
      simp only [Fin.sum_univ_two, hsym]
      ring
    refine ⟨fun ξ => ?_, fun H => ?_⟩
    · have h1 := key1 ξ
      have h2 : 0 ≤ A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) := by
        rw [h1]
        exact add_nonneg (sq_nonneg _) (mul_nonneg hδ.le (sq_nonneg _))
      exact nonneg_of_mul_nonneg_right h2 hp
    · have h1 := key2 H
      have h2 : 0 ≤ A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) := by
        rw [h1]
        exact add_nonneg (add_nonneg (add_nonneg (sq_nonneg _)
          (mul_nonneg hδ.le (sq_nonneg _))) (mul_nonneg hδ.le (sq_nonneg _)))
          (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      exact nonneg_of_mul_nonneg_right h2 (pow_pos hp 2)
  
  have alg : ∀ (r η dA K G HS : ℝ), 0 ≤ r → 0 ≤ η → 0 ≤ dA → 0 ≤ G → 0 ≤ HS →
      r * (η * K) * dA ≤ r * (η * K * (ε / (G + ε))) * dA +
        r * (η * (K * G / (G + ε) + ε * HS / (G + ε) ^ 2)) * dA := by
    intro r η dA K G HS hr hη hdA hG hHS
    have hQ : 0 < G + ε := by linarith
    have e1 : K * (ε / (G + ε)) + K * G / (G + ε) = K := by
      field_simp
      ring
    have e2 : 0 ≤ ε * HS / (G + ε) ^ 2 := by positivity
    have hc : 0 ≤ r * η * dA := by positivity
    have hdiff : r * (η * K * (ε / (G + ε))) * dA +
        r * (η * (K * G / (G + ε) + ε * HS / (G + ε) ^ 2)) * dA - r * (η * K) * dA =
        r * η * dA * (K * (ε / (G + ε)) + K * G / (G + ε) - K) +
          r * η * dA * (ε * HS / (G + ε) ^ 2) := by ring
    rw [e1, sub_self, mul_zero, zero_add] at hdiff
    nlinarith [mul_nonneg hc e2]
  rcases le_or_gt (b (P.param j x)) 0 with hβ | hβ
  · have h0 : Real.smoothTransition (b (P.param j x) / s) = 0 :=
      Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg hβ hs.le)
    rw [h0]
    simp
  · have hO1 : IsOpen (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) :=
      (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi
    have hOo : IsOpen ((P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ) :=
      ((P.param_cont j).mono Set.inter_subset_left).isOpen_inter_preimage hO1
        isOpen_compl_singleton
    have hxO : x ∈ (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ := ⟨⟨hx, hβ⟩, hxp⟩
    have hOW : (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ ⊆ P.W j := fun y hy => hy.1.1
    have hOd : (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ ⊆ P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀}) := by
      intro y hy
      have hyb : 0 < b (P.param j y) := hy.1.2
      have hyp : P.param j y ≠ Gd.p₀ := hy.2
      refine ⟨hy.1.1, ?_, hyp⟩
      have hS : P.param j y ∈ S := by
        have hmem : P.param j y ∈ P.param j '' P.W j := ⟨y, hy.1.1, rfl⟩
        rw [P.image_eq j] at hmem
        exact hmem.2
      exact Gd.R_sub ⟨hS, le_of_lt hyb⟩
    have hK := hkato _ hOo (P.h j) (fun a b' => (P.h_smooth j a b').mono hOW)
      (fun y hy => P.h_posDef j y (hOW hy)) (fun z => Gd.w (P.param j z))
      ((Gd.smooth j).mono hOd)
      (fun y hy => Gd.harm j y (hOW hy) (le_of_lt (show 0 < b (P.param j y) from hy.1.2))
        (show P.param j y ≠ Gd.p₀ from hy.2)) ε hε x hxO
    rw [hK]
    obtain ⟨hq1, hq2⟩ := quad (P.h j x) (P.h_posDef j x hx)
    have hG : 0 ≤ sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) x := by
      unfold sgbGradSq2
      exact hq1 (fun a => pd2 a (fun z => Gd.w (P.param j z)) x)
    exact alg _ _ _ _ _ _ (hρnn j _) (Real.smoothTransition.nonneg _) (Real.sqrt_nonneg _) hG
      (hq2 (fun a b' => pd2 a (pd2 b' (fun z => Gd.w (P.param j z))) x -
        ∑ k : Fin 2, christoffel2 (P.h j) k a b' x * pd2 k (fun z => Gd.w (P.param j z)) x))

theorem pcgb_bulk_kato_le {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (hs : 0 < s) (j : Fin P.n)
    (hI : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det) (P.W j)) :
    (∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) ≤
      (∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det) +
      ∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det :=
by
  have hA1 := pcgb_bulk_curv_integrable S P ρ Kc hρs hK hρK b hb s j
  have hD := pcgb_bulk_defect_integrable S P ρ b Gd.w ε hε s j hA1
  have hDB := MeasureTheory.Integrable.add hD hI
  have hZ : MeasureTheory.volume {x : E2 | x ∈ P.W j ∧ P.param j x = Gd.p₀} = 0 := by
    apply Set.Subsingleton.measure_zero
    intro x hx y hy
    rw [← P.proj_param j x hx.1, ← P.proj_param j y hy.1, hx.2, hy.2]
  have hae : ∀ᵐ x ∂MeasureTheory.volume, x ∈ P.W j →
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det ≤
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det +
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det := by
    rw [MeasureTheory.ae_iff]
    refine MeasureTheory.measure_mono_null ?_ hZ
    intro x hx
    simp only [Set.mem_setOf_eq, Classical.not_imp] at hx
    obtain ⟨hxW, hlt⟩ := hx
    refine ⟨hxW, ?_⟩
    by_contra hne
    exact hlt (pcgb_bulk_kato_pointwise S P ρ hρnn b hb Gd hkato ε hε s hs j x hxW hne)
  have hmono := MeasureTheory.setIntegral_mono_on_ae hA1 hDB (P.W_open j).measurableSet hae
  rw [← MeasureTheory.integral_add hD hI]
  exact hmono

theorem pcgb_main_inequality {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∃ s₁ : ℝ, 0 < s₁ ∧ ∀ ε : ℝ, 0 < ε → ∀ s : ℝ, 0 < s → s < s₁ →
      sgbCollarGB P ρ b s ≤
        2 * Real.pi + pcgbDefect P ρ b Gd.w ε s + pcgbCollarErr P ρ b Gd.w ε s :=
by
  have hkato := fun W hW h hh hpos w hw hharm ε hε x hx =>
    pcgb_kato_identity W hW h hh hpos w hw hharm ε hε x hx
  obtain ⟨r₁, hr₁, hr₁le, hpb⟩ := pcgb_pole_bounds S P b Gd hkato
  obtain ⟨sG, hsG, hcol⟩ := pcgb_collar_integrable S P ρ Kc hρs hK hρK b hb hreg
  refine ⟨min r₁ sG, lt_min hr₁ hsG, fun ε hε s hs hss => ?_⟩
  have hsr : s ≤ r₁ := le_of_lt (lt_of_lt_of_le hss (min_le_left _ _))
  have hsg : s < sG := lt_of_lt_of_le hss (min_le_right _ _)
  obtain ⟨hLs, hLc⟩ := pcgb_log_potential_props S P b Gd ε hε
  obtain ⟨C, hC⟩ := hpb ε hε
  have hball : Metric.closedBall Gd.x₀ r₁ ⊆ P.W Gd.j₀ :=
    (Metric.closedBall_subset_closedBall hr₁le).trans Gd.ball_sub
  have hbpos : ∀ x ∈ Metric.closedBall Gd.x₀ r₁, 2 * r₁ ≤ b (P.param Gd.j₀ x) := fun x hx =>
    le_trans (by linarith) (Gd.ball_pos x (Metric.closedBall_subset_closedBall hr₁le hx))
  obtain ⟨hI1, hI2, hsum⟩ := pcgb_pole_divergence S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1
    Gd.j₀ Gd.x₀ Gd.p₀ r₁ hr₁ Gd.param_x₀ hball hbpos Gd.U Gd.U_open Gd.R_sub
    (fun j y => (1 / 2 : ℝ) * Real.log
      (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε))
    hLs hLc C hC s hs hsr
  beta_reduce at hI1 hI2 hsum
  have hbulk := fun j => pcgb_bulk_kato_le S P ρ Kc hρnn hρs hK hρK b hb Gd hkato ε hε s hs j
    (hI1 j)
  have hE : ∀ j, (∫ x in P.W j, ρ j (P.param j x) *
      (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        (Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)) *
      Real.sqrt (P.h j x).det) =
      (∫ x in P.W j, ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) -
      ∫ x in P.W j, ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det := by
    intro j
    refine Eq.trans ?_ (MeasureTheory.integral_sub (hcol s hs hsg j) (hI2 j))
    congr 1
    funext x
    beta_reduce
    ring
  unfold sgbCollarGB pcgbDefect pcgbCollarErr eigWInt
  unfold eigWInt at hsum
  beta_reduce
  beta_reduce at hsum
  rw [Finset.sum_congr rfl (fun j _ => hE j), Finset.sum_sub_distrib]
  have h1 := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => hbulk j)
  rw [Finset.sum_add_distrib] at h1
  linarith

theorem e2_eps_weight_dct (W K B : Set E2) (hW : IsOpen W) (hK : IsCompact K) (hKW : K ⊆ W)
    (hB : IsOpen B) (A G : E2 → ℝ) (hA : ContinuousOn A W) (hAK : ∀ x ∈ W, x ∉ K → A x = 0)
    (hGm : MeasureTheory.AEStronglyMeasurable G (MeasureTheory.volume.restrict W))
    (hGnn : ∀ x ∈ W, 0 ≤ G x)
    (hnull : MeasureTheory.volume {x | x ∈ W ∧ x ∈ B ∧ A x ≠ 0 ∧ G x = 0} = 0) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ → ∀ F : E2 → ℝ,
      (∀ x ∈ W, |F x| ≤ B.indicator (fun y => |A y| * (ε / (G y + ε))) x) →
      ∫ x in W, F x ≤ θ :=
by
  intro θ hθ
  have hWm : MeasurableSet W := hW.measurableSet
  have hWae : ∀ᵐ x ∂(MeasureTheory.volume.restrict W), x ∈ W :=
    MeasureTheory.ae_restrict_mem hWm
  have hAint : MeasureTheory.Integrable A (MeasureTheory.volume.restrict W) := by
    have h1 : MeasureTheory.IntegrableOn A K MeasureTheory.volume :=
      (hA.mono hKW).integrableOn_compact hK
    exact h1.of_forall_diff_eq_zero hWm (fun x hx => hAK x hx.1 hx.2)
  have hbint : MeasureTheory.Integrable (fun x => |A x|) (MeasureTheory.volume.restrict W) :=
    hAint.abs
  let g : ℝ → E2 → ℝ := fun ε => B.indicator (fun y => |A y| * (ε / (G y + ε)))
  have hgm : ∀ ε : ℝ,
      MeasureTheory.AEStronglyMeasurable (g ε) (MeasureTheory.volume.restrict W) := by
    intro ε
    have h1 : MeasureTheory.AEStronglyMeasurable (fun y => |A y|)
        (MeasureTheory.volume.restrict W) := hbint.aestronglyMeasurable
    have h2 : MeasureTheory.AEStronglyMeasurable (fun y => ε / (G y + ε))
        (MeasureTheory.volume.restrict W) :=
      ((hGm.aemeasurable.add_const ε).const_div ε).aestronglyMeasurable
    exact (h1.mul h2).indicator hB.measurableSet
  have hgb : ∀ ε : ℝ, 0 < ε → ∀ x ∈ W, 0 ≤ g ε x ∧ g ε x ≤ |A x| := by
    intro ε hε x hx
    have hG := hGnn x hx
    have hq0 : 0 ≤ ε / (G x + ε) := div_nonneg hε.le (by linarith)
    have hq1 : ε / (G x + ε) ≤ 1 := div_le_one_of_le₀ (by linarith) (by linarith)
    by_cases hxB : x ∈ B
    · simp only [g, Set.indicator_of_mem hxB]
      exact ⟨mul_nonneg (abs_nonneg _) hq0, mul_le_of_le_one_right (abs_nonneg _) hq1⟩
    · simp only [g, Set.indicator_of_notMem hxB]
      exact ⟨le_refl 0, abs_nonneg _⟩
  have hgae : ∀ ε : ℝ, 0 < ε → ∀ᵐ x ∂(MeasureTheory.volume.restrict W), ‖g ε x‖ ≤ |A x| := by
    intro ε hε
    filter_upwards [hWae] with x hx
    obtain ⟨h0, h1⟩ := hgb ε hε x hx
    rw [Real.norm_eq_abs, abs_of_nonneg h0]
    exact h1
  have hgi : ∀ ε : ℝ, 0 < ε → MeasureTheory.Integrable (g ε) (MeasureTheory.volume.restrict W) :=
    fun ε hε => hbint.mono' (hgm ε) (hgae ε hε)
  have hlim : ∀ᵐ x ∂(MeasureTheory.volume.restrict W),
      Filter.Tendsto (fun ε => g ε x) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    have hN : ∀ᵐ x ∂MeasureTheory.volume,
        x ∉ {x | x ∈ W ∧ x ∈ B ∧ A x ≠ 0 ∧ G x = 0} :=
      MeasureTheory.measure_eq_zero_iff_ae_notMem.mp hnull
    filter_upwards [hWae, MeasureTheory.ae_restrict_of_ae hN] with x hx hxN
    by_cases hxB : x ∈ B
    · by_cases hAx : A x = 0
      · have hfun : (fun ε => g ε x) = fun _ => (0 : ℝ) := by
          funext ε
          simp [g, Set.indicator_of_mem hxB, hAx]
        rw [hfun]
        exact tendsto_const_nhds
      · have hGx : G x ≠ 0 := fun h => hxN ⟨hx, hxB, hAx, h⟩
        have h1 : Filter.Tendsto (fun ε : ℝ => ε / (G x + ε)) (nhds 0)
            (nhds (0 / (G x + 0))) :=
          Filter.tendsto_id.div (tendsto_const_nhds.add Filter.tendsto_id) (by simpa using hGx)
        rw [zero_div] at h1
        have h2 := (h1.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))).const_mul (|A x|)
        rw [mul_zero] at h2
        have hfun : (fun ε => g ε x) = fun ε => |A x| * (ε / (G x + ε)) := by
          funext ε
          simp only [g, Set.indicator_of_mem hxB]
        rw [hfun]
        exact h2
    · have hfun : (fun ε => g ε x) = fun _ => (0 : ℝ) := by
        funext ε
        simp only [g, Set.indicator_of_notMem hxB]
      rw [hfun]
      exact tendsto_const_nhds
  have hdct : Filter.Tendsto (fun ε => ∫ x in W, g ε x) (nhdsWithin 0 (Set.Ioi 0))
      (nhds (∫ x in W, (0 : ℝ))) :=
    MeasureTheory.tendsto_integral_filter_of_dominated_convergence (fun x => |A x|)
      (Filter.Eventually.of_forall hgm)
      (by filter_upwards [self_mem_nhdsWithin] with ε hε using hgae ε hε)
      hbint hlim
  rw [MeasureTheory.integral_zero] at hdct
  have hev : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), ∫ x in W, g ε x < θ :=
    Filter.Tendsto.eventually_lt_const hθ hdct
  obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hev
  refine ⟨u, hu, fun ε hε hεu F hF => ?_⟩
  have hlt : ∫ x in W, g ε x < θ := hsub ⟨hε, hεu⟩
  have hFb : ∀ᵐ x ∂(MeasureTheory.volume.restrict W), ‖F x‖ ≤ g ε x := by
    filter_upwards [hWae] with x hx
    rw [Real.norm_eq_abs]
    exact hF x hx
  have hn := MeasureTheory.norm_integral_le_of_norm_le (hgi ε hε) hFb
  rw [Real.norm_eq_abs] at hn
  have habs := le_abs_self (∫ x in W, F x)
  linarith

theorem flat_taylor_decay (V : Set E2) (hV : IsOpen V) (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V)
    (x₀ : E2) (hx₀ : x₀ ∈ V) (hflat : ∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k u x₀ = 0) :
    ∃ ρ : ℝ, 0 < ρ ∧ Metric.closedBall x₀ ρ ⊆ V ∧
      ∀ K : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
        |u x - u x₀| ≤ C * ‖x - x₀‖ ^ K ∧ ‖fderiv ℝ u x‖ ≤ C * ‖x - x₀‖ ^ K :=
by
  obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.mp hV x₀ hx₀
  have hρ0 : 0 < min (ε / 2) 1 := lt_min (half_pos hε) one_pos
  have hρ1 : min (ε / 2) 1 ≤ 1 := min_le_right _ _
  have hρε : min (ε / 2) 1 < ε := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hε)
  have hB : Metric.closedBall x₀ (min (ε / 2) 1) ⊆ V :=
    (Metric.closedBall_subset_ball hρε).trans hεV
  have hCD : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1), ContDiffAt ℝ ∞ u y :=
    fun y hy => hu.contDiffAt (hV.mem_nhds (hB hy))
  have hDiffG : ∀ m : ℕ, ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      DifferentiableAt ℝ (iteratedFDeriv ℝ m u) y := by
    intro m y hy
    refine (hCD y hy).differentiableAt_iteratedFDeriv ?_
    exact WithTop.coe_lt_coe.2 (ENat.coe_lt_top m)
  have hDu : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1), DifferentiableAt ℝ u y :=
    fun y hy => (hCD y hy).differentiableAt (by simp)
  have hsub : ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      Metric.closedBall x₀ ‖x - x₀‖ ⊆ Metric.closedBall x₀ (min (ε / 2) 1) := by
    intro x hx
    apply Metric.closedBall_subset_closedBall
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    exact hx
  have hxmem : ∀ x : E2, x ∈ Metric.closedBall x₀ ‖x - x₀‖ := by
    intro x
    rw [Metric.mem_closedBall, dist_eq_norm]
  have hx0mem : ∀ x : E2, x₀ ∈ Metric.closedBall x₀ ‖x - x₀‖ :=
    fun x => Metric.mem_closedBall_self (norm_nonneg _)
  have hynorm : ∀ x y : E2, y ∈ Metric.closedBall x₀ ‖x - x₀‖ → ‖y - x₀‖ ≤ ‖x - x₀‖ := by
    intro x y hy
    rwa [Metric.mem_closedBall, dist_eq_norm] at hy
  refine ⟨min (ε / 2) 1, hρ0, hB, fun K => ?_⟩
  obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall x₀ (min (ε / 2) 1)).exists_bound_of_continuousOn
    (fun y hy => (hDiffG (K + 1) y hy).continuousAt.continuousWithinAt)
  have hM0 : 0 ≤ max M₀ 0 := le_max_right _ _
  have hMb : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖iteratedFDeriv ℝ (K + 1) u y‖ ≤ max M₀ 0 :=
    fun y hy => (hM₀ y hy).trans (le_max_left _ _)
  have hind : ∀ j : ℕ, j ≤ K → ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖iteratedFDeriv ℝ (K - j + 1) u x‖ ≤ max M₀ 0 * ‖x - x₀‖ ^ j := by
    intro j
    induction j with
    | zero =>
      intro _ x hx
      simpa using hMb x hx
    | succ j ih =>
      intro hj x hx
      have hm1 : 1 ≤ K - (j + 1) + 1 := Nat.le_add_left 1 _
      have hmeq : K - (j + 1) + 1 + 1 = K - j + 1 := by omega
      have hzero := hflat (K - (j + 1) + 1) hm1
      have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le
        (f := iteratedFDeriv ℝ (K - (j + 1) + 1) u) (C := max M₀ 0 * ‖x - x₀‖ ^ j)
        (fun y hy => hDiffG _ y (hsub x hx hy))
        (fun y hy => by
          rw [norm_fderiv_iteratedFDeriv, hmeq]
          calc ‖iteratedFDeriv ℝ (K - j + 1) u y‖ ≤ max M₀ 0 * ‖y - x₀‖ ^ j :=
                ih (by omega) y (hsub x hx hy)
            _ ≤ max M₀ 0 * ‖x - x₀‖ ^ j :=
                mul_le_mul_of_nonneg_left
                  (pow_le_pow_left₀ (norm_nonneg _) (hynorm x y hy) j) hM0)
        (convex_closedBall x₀ ‖x - x₀‖) (hx0mem x) (hxmem x)
      rw [hzero, sub_zero] at hmvt
      calc ‖iteratedFDeriv ℝ (K - (j + 1) + 1) u x‖
          ≤ max M₀ 0 * ‖x - x₀‖ ^ j * ‖x - x₀‖ := hmvt
        _ = max M₀ 0 * ‖x - x₀‖ ^ (j + 1) := by ring
  have hgrad : ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖fderiv ℝ u x‖ ≤ max M₀ 0 * ‖x - x₀‖ ^ K := by
    intro x hx
    have h1 := hind K le_rfl x hx
    rw [Nat.sub_self, zero_add, norm_iteratedFDeriv_one] at h1
    exact h1
  refine ⟨max M₀ 0, hM0, fun x hx => ⟨?_, hgrad x hx⟩⟩
  have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (f := u)
    (C := max M₀ 0 * ‖x - x₀‖ ^ K)
    (fun y hy => hDu y (hsub x hx hy))
    (fun y hy => (hgrad y (hsub x hx hy)).trans
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hynorm x y hy) K) hM0))
    (convex_closedBall x₀ ‖x - x₀‖) (hx0mem x) (hxmem x)
  rw [Real.norm_eq_abs] at hmvt
  have hxr : ‖x - x₀‖ ≤ min (ε / 2) 1 := by
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    exact hx
  have hr1 : ‖x - x₀‖ ≤ 1 := hxr.trans hρ1
  calc |u x - u x₀| ≤ max M₀ 0 * ‖x - x₀‖ ^ K * ‖x - x₀‖ := hmvt
    _ ≤ max M₀ 0 * ‖x - x₀‖ ^ K * 1 :=
        mul_le_mul_of_nonneg_left hr1 (mul_nonneg hM0 (pow_nonneg (norm_nonneg _) _))
    _ = max M₀ 0 * ‖x - x₀‖ ^ K := mul_one _

theorem frequency_ode_vanish (T C : ℝ) (hC : 0 ≤ C) (H D X Y Q g q : ℝ → ℝ)
    (hH0 : ∀ t < T, 0 ≤ H t) (hX0 : ∀ t < T, 0 ≤ X t) (hY0 : ∀ t < T, 0 ≤ Y t)
    (hCS : ∀ t < T, D t ^ 2 ≤ H t * X t)
    (hHd : ∀ t < T, HasDerivAt H (2 * D t + g t) t)
    (hg : ∀ t < T, |g t| ≤ C * Real.exp t * H t)
    (hDd : ∀ t < T, HasDerivAt D (X t + Y t) t)
    (hQ : ∀ t < T, Q t = X t - Y t)
    (hQd : ∀ t < T, HasDerivAt Q (q t) t)
    (hq : ∀ t < T, |q t| ≤ C * Real.exp t * (X t + Y t))
    (hDlim : Tendsto D atBot (𝓝 0)) (hQlim : Tendsto Q atBot (𝓝 0))
    (hdecay : ∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, H t ≤ CK * Real.exp (K * t)) :
    ∀ t < T, H t = 0 :=
by
  
  have hD0 : ∀ t < T, 0 ≤ D t := by
    intro t ht
    have hmono : MonotoneOn D (Set.Iic t) := by
      apply monotoneOn_of_hasDerivWithinAt_nonneg (f' := fun r => X r + Y r) (convex_Iic t)
      · intro r hr
        exact (hDd r (lt_of_le_of_lt hr ht)).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        exact (hDd r (lt_trans hr ht)).hasDerivWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        beta_reduce
        linarith [hX0 r hrT, hY0 r hrT]
    have hev : ∀ᶠ s in atBot, D s ≤ D t := by
      filter_upwards [eventually_le_atBot t] with s hs
      exact hmono hs (Set.mem_Iic.mpr le_rfl) hs
    exact le_of_tendsto hDlim hev
  
  have hrel : ∀ t < T, ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → σ * Q t ≤ C * Real.exp t * D t := by
    intro t ht σ hσ
    have hanti : AntitoneOn (fun r => σ * Q r - C * Real.exp t * D r) (Set.Iic t) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos
        (f' := fun r => σ * q r - C * Real.exp t * (X r + Y r)) (convex_Iic t)
      · intro r hr
        have hrT := lt_of_le_of_lt hr ht
        exact (((hQd r hrT).const_mul σ).sub
          ((hDd r hrT).const_mul (C * Real.exp t))).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        exact (((hQd r hrT).const_mul σ).sub
          ((hDd r hrT).const_mul (C * Real.exp t))).hasDerivWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        have h1 : σ * q r ≤ |q r| := by
          rcases hσ with h | h
          · rw [h, one_mul]; exact le_abs_self _
          · rw [h, neg_one_mul]; exact neg_le_abs _
        have h2 := hq r hrT
        have h3 : Real.exp r ≤ Real.exp t := Real.exp_le_exp.mpr hr.le
        have h4 : 0 ≤ X r + Y r := by linarith [hX0 r hrT, hY0 r hrT]
        have h5 : C * Real.exp r * (X r + Y r) ≤ C * Real.exp t * (X r + Y r) := by
          apply mul_le_mul_of_nonneg_right _ h4
          exact mul_le_mul_of_nonneg_left h3 hC
        beta_reduce
        linarith
    have hlim : Tendsto (fun r => σ * Q r - C * Real.exp t * D r) atBot (𝓝 0) := by
      have := (hQlim.const_mul σ).sub (hDlim.const_mul (C * Real.exp t))
      rwa [mul_zero, mul_zero, sub_zero] at this
    have hev : ∀ᶠ s in atBot, σ * Q t - C * Real.exp t * D t ≤ σ * Q s - C * Real.exp t * D s := by
      filter_upwards [eventually_le_atBot t] with s hs
      exact hanti hs (Set.mem_Iic.mpr le_rfl) hs
    have := ge_of_tendsto hlim hev
    linarith
  have hXY : ∀ t < T, |X t - Y t| ≤ C * Real.exp t * D t := by
    intro t ht
    have h1 := hrel t ht 1 (Or.inl rfl)
    have h2 := hrel t ht (-1) (Or.inr rfl)
    rw [← hQ t ht, abs_le]
    constructor <;> linarith
  
  intro t₀ ht₀
  refine le_antisymm ?_ (hH0 t₀ ht₀)
  by_contra hneg
  push_neg at hneg
  obtain ⟨N₀, hN₀⟩ : ∃ N₀, N₀ = D t₀ / H t₀ * Real.exp (2 * C * Real.exp t₀) := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L, L = 2 * N₀ + C * Real.exp t₀ := ⟨_, rfl⟩
  have hN₀0 : 0 ≤ N₀ := by
    rw [hN₀]
    exact mul_nonneg (div_nonneg (hD0 t₀ ht₀) hneg.le) (Real.exp_pos _).le
  have hL0 : 0 ≤ L := by
    rw [hLdef]
    exact add_nonneg (by linarith) (mul_nonneg hC (Real.exp_pos _).le)
  
  have himp : ∀ a ≤ t₀, (∀ r ∈ Set.Icc a t₀, 0 < H r) →
      H t₀ * Real.exp (L * (a - t₀)) ≤ H a := by
    intro a hat hpos
    have hT : ∀ r ∈ Set.Icc a t₀, r < T := fun r hr => lt_of_le_of_lt hr.2 ht₀
    have hNd : ∀ r ∈ Set.Icc a t₀, HasDerivAt (fun s => D s / H s * Real.exp (2 * C * Real.exp s))
        (((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2 * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r))) r := by
      intro r hr
      have h1 := (hDd r (hT r hr)).div (hHd r (hT r hr)) (hpos r hr).ne'
      have h2 := ((Real.hasDerivAt_exp r).const_mul (2 * C)).exp
      exact h1.mul h2
    have hNd_nonneg : ∀ r ∈ Set.Icc a t₀, 0 ≤
        ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2 * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r)) := by
      intro r hr
      have hrT := hT r hr
      have hHr := hpos r hr
      have hHne := hHr.ne'
      have hDr := hD0 r hrT
      obtain ⟨hxy1, hxy2⟩ := abs_le.1 (hXY r hrT)
      obtain ⟨hg1, hg2⟩ := abs_le.1 (hg r hrT)
      have p1 : 0 ≤ (C * Real.exp r * D r - (X r - Y r)) * H r := mul_nonneg (by linarith) hHr.le
      have p2 : 0 ≤ D r * (C * Real.exp r * H r - g r) := mul_nonneg hDr (by linarith)
      have hCSr := hCS r hrT
      have hΦ : 0 ≤ (X r + Y r) * H r - D r * (2 * D r + g r)
          + 2 * (C * Real.exp r) * D r * H r := by nlinarith
      have heq : ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2
            * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r))
          = Real.exp (2 * C * Real.exp r) * ((X r + Y r) * H r - D r * (2 * D r + g r)
            + 2 * (C * Real.exp r) * D r * H r) / H r ^ 2 := by
        field_simp
      rw [heq]
      exact div_nonneg (mul_nonneg (Real.exp_pos _).le hΦ) (sq_nonneg _)
    have hNmono : MonotoneOn (fun s => D s / H s * Real.exp (2 * C * Real.exp s))
        (Set.Icc a t₀) := by
      apply monotoneOn_of_hasDerivWithinAt_nonneg
        (f' := fun r => ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2
          * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r)))
        (convex_Icc a t₀)
      · intro r hr
        exact (hNd r hr).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact (hNd r (Set.Ioo_subset_Icc_self hr)).hasDerivWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact hNd_nonneg r (Set.Ioo_subset_Icc_self hr)
    have hDle : ∀ r ∈ Set.Icc a t₀, D r ≤ N₀ * H r := by
      intro r hr
      have h1 : D r / H r * Real.exp (2 * C * Real.exp r)
          ≤ D t₀ / H t₀ * Real.exp (2 * C * Real.exp t₀) :=
        hNmono hr (Set.right_mem_Icc.2 hat) hr.2
      have hE1 : 1 ≤ Real.exp (2 * C * Real.exp r) :=
        Real.one_le_exp (mul_nonneg (mul_nonneg (by norm_num) hC) (Real.exp_pos r).le)
      have hN0 : 0 ≤ D r / H r := div_nonneg (hD0 r (hT r hr)) (hpos r hr).le
      have h2 : D r / H r ≤ N₀ := by
        calc D r / H r = D r / H r * 1 := (mul_one _).symm
          _ ≤ D r / H r * Real.exp (2 * C * Real.exp r) := mul_le_mul_of_nonneg_left hE1 hN0
          _ ≤ N₀ := h1.trans (le_of_eq hN₀.symm)
      rwa [div_le_iff₀ (hpos r hr)] at h2
    have h2Dg : ∀ r ∈ Set.Icc a t₀, 2 * D r + g r ≤ L * H r := by
      intro r hr
      have h1 := hDle r hr
      have h2 := (abs_le.1 (hg r (hT r hr))).2
      have h3 : C * Real.exp r * H r ≤ C * Real.exp t₀ * H r :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hr.2) hC)
          (hpos r hr).le
      rw [hLdef]
      nlinarith
    have hGd : ∀ r ∈ Set.Icc a t₀, HasDerivAt (fun s => H s * Real.exp (-L * s))
        ((2 * D r + g r) * Real.exp (-L * r) + H r * (Real.exp (-L * r) * (-L * 1))) r := by
      intro r hr
      exact (hHd r (hT r hr)).mul (((hasDerivAt_id' r).const_mul (-L)).exp)
    have hGanti : AntitoneOn (fun s => H s * Real.exp (-L * s)) (Set.Icc a t₀) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos
        (f' := fun r => (2 * D r + g r) * Real.exp (-L * r) + H r * (Real.exp (-L * r) * (-L * 1)))
        (convex_Icc a t₀)
      · intro r hr
        exact (hGd r hr).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact (hGd r (Set.Ioo_subset_Icc_self hr)).hasDerivWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        have hr' := Set.Ioo_subset_Icc_self hr
        have hle := h2Dg r hr'
        have he := Real.exp_pos (-L * r)
        have := mul_le_mul_of_nonneg_left hle he.le
        beta_reduce
        nlinarith
    have key : H t₀ * Real.exp (-L * t₀) ≤ H a * Real.exp (-L * a) :=
      hGanti (Set.left_mem_Icc.2 hat) (Set.right_mem_Icc.2 hat) hat
    have e1 : Real.exp (L * (a - t₀)) = Real.exp (-L * t₀) * Real.exp (L * a) := by
      rw [← Real.exp_add]; congr 1; ring
    have e2 : Real.exp (-L * a) * Real.exp (L * a) = 1 := by
      rw [← Real.exp_add, show -L * a + L * a = 0 by ring, Real.exp_zero]
    calc H t₀ * Real.exp (L * (a - t₀))
        = (H t₀ * Real.exp (-L * t₀)) * Real.exp (L * a) := by rw [e1]; ring
      _ ≤ (H a * Real.exp (-L * a)) * Real.exp (L * a) :=
          mul_le_mul_of_nonneg_right key (Real.exp_pos _).le
      _ = H a := by rw [mul_assoc, e2, mul_one]
  
  have hposAll : ∀ a ≤ t₀, ∀ r ∈ Set.Icc a t₀, 0 < H r := by
    intro a hat
    by_contra hcon
    push_neg at hcon
    obtain ⟨r₀, hr₀, hHr₀⟩ := hcon
    have hHc : ContinuousOn H (Set.Icc a t₀) := fun r hr =>
      (hHd r (lt_of_le_of_lt hr.2 ht₀)).continuousAt.continuousWithinAt
    have hZc : IsClosed (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) :=
      hHc.preimage_isClosed_of_isClosed isClosed_Icc isClosed_Iic
    have hZne : (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0).Nonempty := ⟨r₀, hr₀, hHr₀⟩
    have hZbdd : BddAbove (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) := ⟨t₀, fun r hr => hr.1.2⟩
    have hsZ := hZc.csSup_mem hZne hZbdd
    obtain ⟨s, hs⟩ : ∃ s, s = sSup (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) := ⟨_, rfl⟩
    rw [← hs] at hsZ
    have hs2 : s ≤ t₀ := hsZ.1.2
    have hHs : H s ≤ 0 := hsZ.2
    have hst : s < t₀ := lt_of_le_of_ne hs2 (fun h => by rw [h] at hHs; linarith)
    have hposR : ∀ r ∈ Set.Ioc s t₀, 0 < H r := by
      intro r hr
      by_contra hle
      push_neg at hle
      have hmem : r ∈ Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0 :=
        ⟨⟨by linarith [hr.1, hsZ.1.1], hr.2⟩, hle⟩
      have := le_csSup hZbdd hmem
      rw [← hs] at this
      linarith [hr.1]
    have hm : 0 < H t₀ * Real.exp (L * (s - t₀)) := mul_pos hneg (Real.exp_pos _)
    have hlow : ∀ r ∈ Set.Ioo s t₀, H t₀ * Real.exp (L * (s - t₀)) ≤ H r := by
      intro r hr
      have h1 := himp r hr.2.le (fun x hx => hposR x ⟨lt_of_lt_of_le hr.1 hx.1, hx.2⟩)
      have h2 : Real.exp (L * (s - t₀)) ≤ Real.exp (L * (r - t₀)) :=
        Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (by linarith [hr.1]) hL0)
      calc H t₀ * Real.exp (L * (s - t₀)) ≤ H t₀ * Real.exp (L * (r - t₀)) :=
            mul_le_mul_of_nonneg_left h2 hneg.le
        _ ≤ H r := h1
    have hcont : Tendsto H (𝓝[>] s) (𝓝 (H s)) :=
      (hHd s (lt_trans hst ht₀)).continuousAt.continuousWithinAt.tendsto
    have hev : ∀ᶠ r in 𝓝[>] s, H t₀ * Real.exp (L * (s - t₀)) ≤ H r := by
      filter_upwards [Ioo_mem_nhdsGT hst] with r hr using hlow r hr
    have := ge_of_tendsto hcont hev
    linarith
  have hlowAll : ∀ a ≤ t₀, H t₀ * Real.exp (L * (a - t₀)) ≤ H a :=
    fun a hat => himp a hat (hposAll a hat)
  
  obtain ⟨CK, hCK⟩ := hdecay (⌈L⌉₊ + 1)
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((⌈L⌉₊ + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hK] at hCK
  have hKL : 0 < K - L := by
    have h1 := Nat.le_ceil L
    have h2 : K = (⌈L⌉₊ : ℝ) + 1 := by rw [hK]; push_cast; ring
    linarith
  have hbound : ∀ r ≤ t₀, H t₀ ≤ CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) := by
    intro r hr
    have h1 := hlowAll r hr
    have h2 := hCK r (lt_of_le_of_lt hr ht₀)
    have e : Real.exp (K * r) =
        Real.exp (L * t₀) * Real.exp ((K - L) * r) * Real.exp (L * (r - t₀)) := by
      rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
    have hE := Real.exp_pos (L * (r - t₀))
    have h3 : H t₀ * Real.exp (L * (r - t₀)) ≤
        CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) * Real.exp (L * (r - t₀)) := by
      calc H t₀ * Real.exp (L * (r - t₀)) ≤ H r := h1
        _ ≤ CK * Real.exp (K * r) := h2
        _ = _ := by rw [e]; ring
    exact le_of_mul_le_mul_right h3 hE
  have hlim : Tendsto (fun r => CK * Real.exp (L * t₀) * Real.exp ((K - L) * r)) atBot (𝓝 0) := by
    have h1 : Tendsto (fun r : ℝ => (K - L) * r) atBot atBot :=
      tendsto_id.const_mul_atBot hKL
    have h2 := (Real.tendsto_exp_atBot.comp h1).const_mul (CK * Real.exp (L * t₀))
    rw [mul_zero] at h2
    exact h2
  have hev : ∀ᶠ r in atBot, H t₀ ≤ CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) := by
    filter_upwards [eventually_le_atBot t₀] with r hr using hbound r hr
  have := ge_of_tendsto hlim hev
  linarith

theorem cyl_coeff_field_facts (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef) :
    (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => cylA h x i j) V) ∧
    (∀ x ∈ V, ∀ i j : Fin 2, cylA h x i j = cylA h x j i) ∧
    (∀ x ∈ V, cylA h x 0 0 * cylA h x 1 1 - cylA h x 0 1 ^ 2 = 1) ∧
    (∀ x ∈ V, 0 < cylA h x 0 0) :=
by
  have hdpos : ∀ x ∈ V, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
  have hdetC : ContDiffOn ℝ ∞ (fun x => (h x).det) V := by
    have : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 :=
      funext fun x => Matrix.det_fin_two _
    rw [this]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hsC : ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) V :=
    hdetC.sqrt (fun x hx => (hdpos x hx).ne')
  have hdinvC : ContDiffOn ℝ ∞ (fun x => ((h x).det)⁻¹) V :=
    hdetC.inv (fun x hx => (hdpos x hx).ne')
  have hadjC : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x).adjugate a b) V := by
    intro a b
    have : (fun x => (h x).adjugate a b) =
        fun x => !![h x 1 1, -h x 0 1; -h x 1 0, h x 0 0] a b :=
      funext fun x => by rw [Matrix.adjugate_fin_two]
    rw [this]
    fin_cases a <;> fin_cases b <;> simp <;> first | exact hh _ _ | exact (hh _ _).neg
  have hinvC : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ a b) V := by
    intro a b
    have : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b :=
      funext fun x => by rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
    rw [this]
    exact hdinvC.mul (hadjC a b)
  have hsym : ∀ x ∈ V, ∀ i j : Fin 2, (h x)⁻¹ i j = (h x)⁻¹ j i := by
    intro x hx i j
    have hH : ((h x)⁻¹).IsHermitian := (hpos x hx).isHermitian.inv
    have := hH.apply i j
    simpa using this.symm
  have hsymA : ∀ x ∈ V, ∀ i j : Fin 2, cylA h x i j = cylA h x j i := by
    intro x hx i j
    simp only [cylA, hsym x hx i j]
  refine ⟨?_, hsymA, ?_, ?_⟩
  · intro i j
    exact hsC.mul (hinvC i j)
  · intro x hx
    have hd : 0 < (h x).det := hdpos x hx
    have hdet1 : (Real.sqrt (h x).det • (h x)⁻¹).det = 1 := by
      rw [Matrix.det_smul, Matrix.det_nonsing_inv, Ring.inverse_eq_inv, Fintype.card_fin,
        Real.sq_sqrt hd.le]
      exact mul_inv_cancel₀ hd.ne'
    rw [Matrix.det_fin_two] at hdet1
    simp only [Matrix.smul_apply, smul_eq_mul] at hdet1
    have h10 := hsymA x hx 1 0
    simp only [cylA] at h10 ⊢
    rw [h10] at hdet1
    rw [sq]
    exact hdet1
  · intro x hx
    exact mul_pos (Real.sqrt_pos.mpr (hdpos x hx)) (hpos x hx).inv.diag_pos

theorem cyl_polar_div_pullback (P : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2) (F₀ F₁ : E2 → ℝ)
    (p : ℝ × ℝ) (h0 : DifferentiableAt ℝ F₀ (cylPhi x₀ P p))
    (h1 : DifferentiableAt ℝ F₁ (cylPhi x₀ P p)) :
    fplDt (fun q => Real.exp q.1 * (Real.cos q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.sin q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) p +
      fplDs (fun q => Real.exp q.1 * (-Real.sin q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.cos q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) p =
    Real.exp (2 * p.1) * (P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (pd2 0 F₀ (cylPhi x₀ P p) + pd2 1 F₁ (cylPhi x₀ P p)) :=
by
  have hexp : HasFDerivAt (fun q : ℝ × ℝ => Real.exp q.1)
      (Real.exp p.1 • ContinuousLinearMap.fst ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_exp p.1).comp_hasFDerivAt p hasFDerivAt_fst
  have hcos : HasFDerivAt (fun q : ℝ × ℝ => Real.cos q.2)
      ((-Real.sin p.2) • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_cos p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hsin : HasFDerivAt (fun q : ℝ × ℝ => Real.sin q.2)
      (Real.cos p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_sin p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hΦeq : cylPhi x₀ P = fun q => x₀ +
      ((Real.exp q.1 * (P 0 0 * Real.cos q.2 + P 0 1 * Real.sin q.2)) • e2 0 +
        (Real.exp q.1 * (P 1 0 * Real.cos q.2 + P 1 1 * Real.sin q.2)) • e2 1) := by
    funext q
    ext i
    fin_cases i <;> simp [cylPhi, e2, EuclideanSpace.single_apply]
  obtain ⟨Φ', hΦ, hΦt, hΦs⟩ : ∃ Φ' : ℝ × ℝ →L[ℝ] E2, HasFDerivAt (cylPhi x₀ P) Φ' p ∧
      Φ' (1, 0) = (Real.exp p.1 * (P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2)) • e2 0 +
        (Real.exp p.1 * (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2)) • e2 1 ∧
      Φ' (0, 1) = (Real.exp p.1 * (-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2)) • e2 0 +
        (Real.exp p.1 * (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2)) • e2 1 := by
    have hc0 := hexp.fun_mul ((hcos.const_mul (P 0 0)).fun_add (hsin.const_mul (P 0 1)))
    have hc1 := hexp.fun_mul ((hcos.const_mul (P 1 0)).fun_add (hsin.const_mul (P 1 1)))
    have hsum := ((hc0.smul_const (e2 0)).add (hc1.smul_const (e2 1))).const_add x₀
    rw [hΦeq]
    refine ⟨_, hsum, ?_, ?_⟩
    · ext i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply] <;> ring
    · ext i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply] <;> ring
  have hf0 := h0.hasFDerivAt.comp p hΦ
  have hf1 := h1.hasFDerivAt.comp p hΦ
  have hG0 := (hf0.const_mul (P 1 1)).fun_sub (hf1.const_mul (P 0 1))
  have hG1 := (hf0.const_mul (-P 1 0)).fun_add (hf1.const_mul (P 0 0))
  have hW0 : HasFDerivAt (fun q => Real.exp q.1 * (Real.cos q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.sin q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) _ p :=
    hexp.fun_mul ((hcos.fun_mul hG0).fun_add (hsin.fun_mul hG1))
  have hW1 : HasFDerivAt (fun q => Real.exp q.1 * (-Real.sin q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.cos q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) _ p :=
    hexp.fun_mul ((hsin.neg.fun_mul hG0).fun_add (hcos.fun_mul hG1))
  have hX : Real.exp (2 * p.1) = Real.exp p.1 * Real.exp p.1 := by
    rw [two_mul, Real.exp_add]
  have hCS := Real.cos_sq_add_sin_sq p.2
  unfold fplDt fplDs
  rw [hW0.fderiv, hW1.fderiv]
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.coe_comp', Function.comp_apply, ContinuousLinearMap.coe_fst',
    ContinuousLinearMap.coe_snd', smul_eq_mul, hΦt, hΦs, map_add, map_smul, pd2, Pi.neg_apply]
  linear_combination (Real.exp p.1 ^ 2 * (P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (fderiv ℝ F₀ (cylPhi x₀ P p) (e2 0) + fderiv ℝ F₁ (cylPhi x₀ P p) (e2 1))) * hCS -
    ((P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (fderiv ℝ F₀ (cylPhi x₀ P p) (e2 0) + fderiv ℝ F₁ (cylPhi x₀ P p) (e2 1))) * hX

theorem cyl_polar_grad_chain (x₀ : E2) (P : Matrix (Fin 2) (Fin 2) ℝ) :
    ContDiff ℝ ∞ (cylPhi x₀ P) ∧
    (∀ t θ : ℝ, cylPhi x₀ P (t, θ + 2 * Real.pi) = cylPhi x₀ P (t, θ)) ∧
    (∀ p : ℝ × ℝ, ‖cylPhi x₀ P p - x₀‖ ≤
      (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1) ∧
    ∀ (v : E2 → ℝ) (p : ℝ × ℝ), DifferentiableAt ℝ v (cylPhi x₀ P p) →
      fplDt (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2) * pd2 0 v (cylPhi x₀ P p) +
          (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2) * pd2 1 v (cylPhi x₀ P p)) ∧
      fplDs (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2) * pd2 0 v (cylPhi x₀ P p) +
          (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2) * pd2 1 v (cylPhi x₀ P p)) ∧
      |fplDt (fun q => v (cylPhi x₀ P q)) p| ≤
        (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 * ‖fderiv ℝ v (cylPhi x₀ P p)‖ ∧
      |fplDs (fun q => v (cylPhi x₀ P q)) p| ≤
        (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 * ‖fderiv ℝ v (cylPhi x₀ P p)‖ :=
by
  
  have hsmooth : ContDiff ℝ ∞ (cylPhi x₀ P) := by
    have h1 : ContDiff ℝ ∞ (fun q : ℝ × ℝ =>
        (fun i : Fin 2 => P i 0 * Real.cos q.2 + P i 1 * Real.sin q.2)) := by
      refine contDiff_pi.2 (fun i => ?_)
      exact (contDiff_const.mul (Real.contDiff_cos.comp contDiff_snd)).add
        (contDiff_const.mul (Real.contDiff_sin.comp contDiff_snd))
    unfold cylPhi
    exact contDiff_const.add ((Real.contDiff_exp.comp contDiff_fst).smul
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm.contDiff.comp h1))
  have hdiff : ∀ p : ℝ × ℝ, DifferentiableAt ℝ (cylPhi x₀ P) p :=
    fun p => hsmooth.differentiable (by simp) p
  
  have hbasis : ∀ w : Fin 2 → ℝ,
      (EuclideanSpace.equiv (Fin 2) ℝ).symm w = w 0 • e2 0 + w 1 • e2 1 := by
    intro w
    refine PiLp.ext (fun i => ?_)
    rw [show ((EuclideanSpace.equiv (Fin 2) ℝ).symm w).ofLp i = w i from rfl]
    fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
  have hlin : ∀ (D : E2 →L[ℝ] ℝ) (w : Fin 2 → ℝ),
      D ((EuclideanSpace.equiv (Fin 2) ℝ).symm w) = w 0 * D (e2 0) + w 1 * D (e2 1) := by
    intro D w
    rw [hbasis w, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  have hnormL : ∀ w : Fin 2 → ℝ,
      ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm w‖ ≤ |w 0| + |w 1| := by
    intro w
    rw [hbasis w]
    calc ‖w 0 • e2 0 + w 1 • e2 1‖ ≤ ‖w 0 • e2 0‖ + ‖w 1 • e2 1‖ := norm_add_le _ _
      _ = |w 0| + |w 1| := by simp [norm_smul, e2, EuclideanSpace.norm_single]
  have hcoord : ∀ (D : E2 →L[ℝ] ℝ) (i : Fin 2), |D (e2 i)| ≤ ‖D‖ := by
    intro D i
    have h := D.le_opNorm (e2 i)
    rw [Real.norm_eq_abs] at h
    have he : ‖e2 i‖ = 1 := by simp [e2, EuclideanSpace.norm_single]
    rw [he, mul_one] at h
    exact h
  have htrig : ∀ a b c s : ℝ, |c| ≤ 1 → |s| ≤ 1 → |a * c + b * s| ≤ |a| + |b| := by
    intro a b c s hc hs
    calc |a * c + b * s| ≤ |a * c| + |b * s| := abs_add_le _ _
      _ = |a| * |c| + |b| * |s| := by rw [abs_mul, abs_mul]
      _ ≤ |a| * 1 + |b| * 1 := by gcongr
      _ = |a| + |b| := by ring
  have hbnd : ∀ E A B kA kB g0 g1 N : ℝ, 0 ≤ E → |A| ≤ kA → |B| ≤ kB → |g0| ≤ N → |g1| ≤ N →
      |E * (A * g0 + B * g1)| ≤ (kA + kB) * E * N := by
    intro E A B kA kB g0 g1 N hE hA hB hg0 hg1
    rw [abs_mul, abs_of_nonneg hE]
    have h : |A * g0 + B * g1| ≤ kA * N + kB * N :=
      calc |A * g0 + B * g1| ≤ |A * g0| + |B * g1| := abs_add_le _ _
        _ = |A| * |g0| + |B| * |g1| := by rw [abs_mul, abs_mul]
        _ ≤ kA * N + kB * N := add_le_add
            (mul_le_mul hA hg0 (abs_nonneg _) ((abs_nonneg _).trans hA))
            (mul_le_mul hB hg1 (abs_nonneg _) ((abs_nonneg _).trans hB))
    calc E * |A * g0 + B * g1| ≤ E * (kA * N + kB * N) := mul_le_mul_of_nonneg_left h hE
      _ = (kA + kB) * E * N := by ring
  
  have hdirT : ∀ p : ℝ × ℝ, fderiv ℝ (cylPhi x₀ P) p (1, 0) = Real.exp p.1 •
      (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
    rintro ⟨t, θ⟩
    have hΦ : HasFDerivAt (cylPhi x₀ P) (fderiv ℝ (cylPhi x₀ P) (t, θ)) (t, θ) :=
      (hdiff _).hasFDerivAt
    have hℓ : HasDerivAt (fun τ : ℝ => (τ, θ)) ((1 : ℝ), (0 : ℝ)) t :=
      (hasDerivAt_id' t).prodMk (hasDerivAt_const t θ)
    have h1 : HasDerivAt (cylPhi x₀ P ∘ fun τ : ℝ => (τ, θ))
        (fderiv ℝ (cylPhi x₀ P) (t, θ) (1, 0)) t := hΦ.comp_hasDerivAt t hℓ
    have h2 : HasDerivAt (fun τ : ℝ => x₀ + Real.exp τ • (EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos θ + P i 1 * Real.sin θ))
        (Real.exp t • (EuclideanSpace.equiv (Fin 2) ℝ).symm
          (fun i => P i 0 * Real.cos θ + P i 1 * Real.sin θ)) t :=
      ((Real.hasDerivAt_exp t).smul_const _).const_add x₀
    exact h1.unique h2
  have hdirS : ∀ p : ℝ × ℝ, fderiv ℝ (cylPhi x₀ P) p (0, 1) = Real.exp p.1 •
      (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => -P i 0 * Real.sin p.2 + P i 1 * Real.cos p.2) := by
    rintro ⟨t, θ⟩
    have hΦ : HasFDerivAt (cylPhi x₀ P) (fderiv ℝ (cylPhi x₀ P) (t, θ)) (t, θ) :=
      (hdiff _).hasFDerivAt
    have hℓ : HasDerivAt (fun τ : ℝ => (t, τ)) ((0 : ℝ), (1 : ℝ)) θ :=
      (hasDerivAt_const θ t).prodMk (hasDerivAt_id' θ)
    have h1 : HasDerivAt (cylPhi x₀ P ∘ fun τ : ℝ => (t, τ))
        (fderiv ℝ (cylPhi x₀ P) (t, θ) (0, 1)) θ := hΦ.comp_hasDerivAt θ hℓ
    have hg : HasDerivAt (fun τ : ℝ => (fun i : Fin 2 => P i 0 * Real.cos τ + P i 1 * Real.sin τ))
        (fun i : Fin 2 => -P i 0 * Real.sin θ + P i 1 * Real.cos θ) θ := by
      refine hasDerivAt_pi.2 (fun i => ?_)
      have := ((Real.hasDerivAt_cos θ).const_mul (P i 0)).add
        ((Real.hasDerivAt_sin θ).const_mul (P i 1))
      convert this using 1
      ring
    have hLg := (EuclideanSpace.equiv (Fin 2) ℝ).symm.hasFDerivAt.comp_hasDerivAt θ hg
    have h2 := (hLg.const_smul (Real.exp t)).const_add x₀
    rw [h1.unique h2, ContinuousLinearEquiv.coe_coe]
  
  have hchain : ∀ (v : E2 → ℝ) (p d : ℝ × ℝ), DifferentiableAt ℝ v (cylPhi x₀ P p) →
      fderiv ℝ (fun q => v (cylPhi x₀ P q)) p d =
        fderiv ℝ v (cylPhi x₀ P p) (fderiv ℝ (cylPhi x₀ P) p d) := by
    intro v p d hv
    rw [fderiv_comp' p hv (hdiff p)]
    rfl
  refine ⟨hsmooth, ?_, ?_, ?_⟩
  · intro t θ
    simp only [cylPhi, Real.cos_add_two_pi, Real.sin_add_two_pi]
  · intro p
    have hsub : cylPhi x₀ P p - x₀ = Real.exp p.1 • (EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
      simp only [cylPhi, add_sub_cancel_left]
    rw [hsub, norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have hL := hnormL (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)
    have h0 := htrig (P 0 0) (P 0 1) _ _ (Real.abs_cos_le_one p.2) (Real.abs_sin_le_one p.2)
    have h1 := htrig (P 1 0) (P 1 1) _ _ (Real.abs_cos_le_one p.2) (Real.abs_sin_le_one p.2)
    have hE := Real.exp_pos p.1
    have hk : ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)‖ ≤
        |P 0 0| + |P 0 1| + |P 1 0| + |P 1 1| := by
      refine hL.trans ?_
      show |P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2| +
        |P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2| ≤ _
      linarith
    calc Real.exp p.1 * ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm
          (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)‖
        ≤ Real.exp p.1 * (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) :=
          mul_le_mul_of_nonneg_left hk hE.le
      _ = (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 := by ring
  · intro v p hv
    have hT : fplDt (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2) * pd2 0 v (cylPhi x₀ P p) +
          (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2) * pd2 1 v (cylPhi x₀ P p)) := by
      unfold fplDt
      rw [hchain v p _ hv, hdirT p, map_smul, smul_eq_mul, hlin]
      rfl
    have hS : fplDs (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2) * pd2 0 v (cylPhi x₀ P p) +
          (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2) * pd2 1 v (cylPhi x₀ P p)) := by
      unfold fplDs
      rw [hchain v p _ hv, hdirS p, map_smul, smul_eq_mul, hlin]
      rfl
    have hE := (Real.exp_pos p.1).le
    have hg0 : |pd2 0 v (cylPhi x₀ P p)| ≤ ‖fderiv ℝ v (cylPhi x₀ P p)‖ := hcoord _ 0
    have hg1 : |pd2 1 v (cylPhi x₀ P p)| ≤ ‖fderiv ℝ v (cylPhi x₀ P p)‖ := hcoord _ 1
    have hc := Real.abs_cos_le_one p.2
    have hs := Real.abs_sin_le_one p.2
    refine ⟨hT, hS, ?_, ?_⟩
    · rw [hT]
      refine (hbnd _ _ _ _ _ _ _ _ hE (htrig (P 0 0) (P 0 1) _ _ hc hs)
        (htrig (P 1 0) (P 1 1) _ _ hc hs) hg0 hg1).trans (le_of_eq ?_)
      ring
    · rw [hS]
      have hA := htrig (-P 0 0) (P 0 1) _ _ hs hc
      have hB := htrig (-P 1 0) (P 1 1) _ _ hs hc
      rw [abs_neg] at hA hB
      refine (hbnd _ _ _ _ _ _ _ _ hE hA hB hg0 hg1).trans (le_of_eq ?_)
      ring

theorem cyl_rotated_coeff_bounds (M00 M01 M11 : ℝ × ℝ → ℝ) (p : ℝ × ℝ) (η : ℝ) (hη : 0 ≤ η)
    (hd0 : DifferentiableAt ℝ M00 p) (hd1 : DifferentiableAt ℝ M01 p)
    (hd2 : DifferentiableAt ℝ M11 p)
    (hb0 : |M00 p - 1| ≤ η) (hb1 : |M01 p| ≤ η) (hb2 : |M11 p - 1| ≤ η)
    (ht0 : |fplDt M00 p| ≤ η) (ht1 : |fplDt M01 p| ≤ η) (ht2 : |fplDt M11 p| ≤ η)
    (hs0 : |fplDs M00 p| ≤ η) (hs1 : |fplDs M01 p| ≤ η) (hs2 : |fplDs M11 p| ≤ η) :
    |cylRotA p.2 (M00 p) (M01 p) (M11 p) - 1| ≤ 2 * η ∧
    |cylRotB p.2 (M00 p) (M01 p) (M11 p)| ≤ 2 * η ∧
    |fplDt (fun q => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 2 * η ∧
    |fplDt (fun q => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 2 * η ∧
    |fplDs (fun q => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 6 * η ∧
    |fplDs (fun q => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 6 * η ∧
    cylRotA p.2 (M00 p) (M01 p) (M11 p) * cylRotC p.2 (M00 p) (M01 p) (M11 p) -
      cylRotB p.2 (M00 p) (M01 p) (M11 p) ^ 2 = M00 p * M11 p - M01 p ^ 2 :=
by
  have hCS : Real.cos p.2 ^ 2 + Real.sin p.2 ^ 2 = 1 := Real.cos_sq_add_sin_sq p.2
  
  have key : ∀ C S : ℝ, C ^ 2 + S ^ 2 = 1 → ∀ d0 d1 d2 : ℝ, |d0| ≤ η → |d1| ≤ η → |d2| ≤ η →
      |C ^ 2 * d0 + 2 * C * S * d1 + S ^ 2 * d2| ≤ 2 * η ∧
      |-(C * S * d0) + (C ^ 2 - S ^ 2) * d1 + C * S * d2| ≤ 2 * η ∧
      |-(2 * C * S * d0) + 2 * (C ^ 2 - S ^ 2) * d1 + 2 * C * S * d2| ≤ 4 * η ∧
      |-((C ^ 2 - S ^ 2) * d0) - 4 * C * S * d1 + (C ^ 2 - S ^ 2) * d2| ≤ 4 * η := by
    intro C S hCS d0 d1 d2 h0 h1 h2
    have term : ∀ u d : ℝ, |d| ≤ η → -(|u| * η) ≤ u * d ∧ u * d ≤ |u| * η := fun u d hd =>
      abs_le.mp (by rw [abs_mul]; exact mul_le_mul_of_nonneg_left hd (abs_nonneg u))
    have hT1 : 2 * |C * S| ≤ 1 := by
      rw [abs_mul]
      have a := sq_abs C
      have b := sq_abs S
      nlinarith [sq_nonneg (|C| - |S|)]
    have hT2 : |C ^ 2 - S ^ 2| ≤ 1 :=
      abs_le.mpr ⟨by nlinarith [sq_nonneg C, sq_nonneg S], by nlinarith [sq_nonneg C, sq_nonneg S]⟩
    have hT1' := mul_le_mul_of_nonneg_right hT1 hη
    have hT2' := mul_le_mul_of_nonneg_right hT2 hη
    have hsum : C ^ 2 * η + S ^ 2 * η = η := by rw [← add_mul, hCS, one_mul]
    have hC2 : |C ^ 2| = C ^ 2 := abs_of_nonneg (sq_nonneg C)
    have hS2 : |S ^ 2| = S ^ 2 := abs_of_nonneg (sq_nonneg S)
    obtain ⟨a0, a0'⟩ := term (C ^ 2) d0 h0
    obtain ⟨a2, a2'⟩ := term (S ^ 2) d2 h2
    rw [hC2] at a0 a0'
    rw [hS2] at a2 a2'
    obtain ⟨b0, b0'⟩ := term (C * S) d0 h0
    obtain ⟨b1, b1'⟩ := term (C * S) d1 h1
    obtain ⟨b2, b2'⟩ := term (C * S) d2 h2
    obtain ⟨c0, c0'⟩ := term (C ^ 2 - S ^ 2) d0 h0
    obtain ⟨c1, c1'⟩ := term (C ^ 2 - S ^ 2) d1 h1
    obtain ⟨c2, c2'⟩ := term (C ^ 2 - S ^ 2) d2 h2
    refine ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩,
      abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
  
  have hM0 := hd0.hasFDerivAt
  have hM1 := hd1.hasFDerivAt
  have hM2 := hd2.hasFDerivAt
  have hc : HasFDerivAt (fun q : ℝ × ℝ => Real.cos q.2)
      ((-Real.sin p.2) • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_cos p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hs : HasFDerivAt (fun q : ℝ × ℝ => Real.sin q.2)
      (Real.cos p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_sin p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hA : HasFDerivAt (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) _ p :=
    (((hc.pow 2).mul hM0).add (((hc.const_mul 2).mul hs).mul hM1)).add ((hs.pow 2).mul hM2)
  have hB : HasFDerivAt (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) _ p :=
    ((((hc.mul hs).mul hM0).neg).add (((hc.pow 2).sub (hs.pow 2)).mul hM1)).add
      ((hc.mul hs).mul hM2)
  have dtA : fplDt (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotA p.2 (fplDt M00 p) (fplDt M01 p) (fplDt M11 p) := by
    unfold fplDt; rw [hA.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotA]
    norm_num
    try ring
  have dtB : fplDt (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotB p.2 (fplDt M00 p) (fplDt M01 p) (fplDt M11 p) := by
    unfold fplDt; rw [hB.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotB]
    norm_num
    try ring
  have dsA : fplDs (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotA p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p) +
        (-(2 * Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
          2 * (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
          2 * Real.cos p.2 * Real.sin p.2 * (M11 p - 1)) := by
    unfold fplDs; rw [hA.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotA]
    norm_num
    ring
  have dsB : fplDs (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotB p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p) +
        (-((Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M00 p - 1)) -
          4 * Real.cos p.2 * Real.sin p.2 * M01 p +
          (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M11 p - 1)) := by
    unfold fplDs; rw [hB.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotB]
    norm_num
    ring
  have kb := key _ _ hCS _ _ _ hb0 hb1 hb2
  have kt := key _ _ hCS _ _ _ ht0 ht1 ht2
  have ks := key _ _ hCS _ _ _ hs0 hs1 hs2
  have e1 : cylRotA p.2 (M00 p) (M01 p) (M11 p) - 1 =
      Real.cos p.2 ^ 2 * (M00 p - 1) + 2 * Real.cos p.2 * Real.sin p.2 * M01 p +
        Real.sin p.2 ^ 2 * (M11 p - 1) := by
    unfold cylRotA; linear_combination hCS
  have e2 : cylRotB p.2 (M00 p) (M01 p) (M11 p) =
      -(Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
        (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
        Real.cos p.2 * Real.sin p.2 * (M11 p - 1) := by
    unfold cylRotB; ring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [e1]; exact kb.1
  · rw [e2]; exact kb.2.1
  · rw [dtA]; exact kt.1
  · rw [dtB]; exact kt.2.1
  · rw [dsA]
    calc _ ≤ |cylRotA p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p)| +
          |-(2 * Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
            2 * (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
            2 * Real.cos p.2 * Real.sin p.2 * (M11 p - 1)| := abs_add_le _ _
      _ ≤ 2 * η + 4 * η := add_le_add ks.1 kb.2.2.1
      _ = 6 * η := by ring
  · rw [dsB]
    calc _ ≤ |cylRotB p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p)| +
          |-((Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M00 p - 1)) -
            4 * Real.cos p.2 * Real.sin p.2 * M01 p +
            (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M11 p - 1)| := abs_add_le _ _
      _ ≤ 2 * η + 4 * η := add_le_add ks.2.1 kb.2.2.2
      _ = 6 * η := by ring
  · unfold cylRotA cylRotB cylRotC
    linear_combination ((Real.cos p.2 ^ 2 + Real.sin p.2 ^ 2) + 1) *
      (M00 p * M11 p - M01 p ^ 2) * hCS

theorem cyl_polar_cover (P : Matrix (Fin 2) (Fin 2) ℝ) (hP : P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1)
    (x₀ : E2) (T : ℝ) (f : E2 → ℝ) (hf0 : f x₀ = 0)
    (hf : ∀ p : ℝ × ℝ, p.1 < T → f (cylPhi x₀ P p) = 0) :
    ∀ᶠ x in 𝓝 x₀, f x = 0 :=
by
  obtain ⟨κ, hκ⟩ : ∃ k : ℝ, k = |P 0 0| + |P 0 1| + |P 1 0| + |P 1 1| := ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ := by rw [hκ]; positivity
  have hκ1 : 0 < κ + 1 := by linarith
  have hδ : 0 < Real.exp T / (κ + 1) := div_pos (Real.exp_pos T) hκ1
  have hcoord : ∀ (p : ℝ × ℝ) (i : Fin 2), cylPhi x₀ P p i =
      x₀ i + Real.exp p.1 * (P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
    intro p i
    simp [cylPhi]
  filter_upwards [Metric.ball_mem_nhds x₀ hδ] with x hx
  rw [Metric.mem_ball, dist_eq_norm, lt_div_iff₀ hκ1] at hx
  have hy : ∀ i : Fin 2, |x i - x₀ i| ≤ ‖x - x₀‖ := by
    intro i
    have := PiLp.norm_apply_le (x - x₀) i
    simpa [Real.norm_eq_abs] using this
  obtain ⟨y₀, hy₀⟩ : ∃ a : ℝ, a = x 0 - x₀ 0 := ⟨_, rfl⟩
  obtain ⟨y₁, hy₁⟩ : ∃ a : ℝ, a = x 1 - x₀ 1 := ⟨_, rfl⟩
  have hy0b : |y₀| ≤ ‖x - x₀‖ := by rw [hy₀]; exact hy 0
  have hy1b : |y₁| ≤ ‖x - x₀‖ := by rw [hy₁]; exact hy 1
  obtain ⟨z₀, hz₀⟩ : ∃ a : ℝ, a = P 1 1 * y₀ - P 0 1 * y₁ := ⟨_, rfl⟩
  obtain ⟨z₁, hz₁⟩ : ∃ a : ℝ, a = -P 1 0 * y₀ + P 0 0 * y₁ := ⟨_, rfl⟩
  have hI0 : P 0 0 * z₀ + P 0 1 * z₁ = y₀ := by
    rw [hz₀, hz₁]; linear_combination y₀ * hP
  have hI1 : P 1 0 * z₀ + P 1 1 * z₁ = y₁ := by
    rw [hz₀, hz₁]; linear_combination y₁ * hP
  by_cases hz : z₀ = 0 ∧ z₁ = 0
  · obtain ⟨h0, h1⟩ := hz
    have e0 : x 0 = x₀ 0 := by
      have : y₀ = 0 := by rw [← hI0, h0, h1]; ring
      linarith
    have e1 : x 1 = x₀ 1 := by
      have : y₁ = 0 := by rw [← hI1, h0, h1]; ring
      linarith
    have hxx : x = x₀ := by
      refine PiLp.ext ?_
      intro i
      fin_cases i
      · exact e0
      · exact e1
    rw [hxx]; exact hf0
  · let ζ : ℂ := ⟨z₀, z₁⟩
    have hζ0 : ζ ≠ 0 := by
      intro h
      apply hz
      exact ⟨congrArg Complex.re h, congrArg Complex.im h⟩
    have hr : 0 < ‖ζ‖ := norm_pos_iff.mpr hζ0
    have hcos : ‖ζ‖ * Real.cos ζ.arg = z₀ := Complex.norm_mul_cos_arg ζ
    have hsin : ‖ζ‖ * Real.sin ζ.arg = z₁ := Complex.norm_mul_sin_arg ζ
    have hrle : ‖ζ‖ ≤ |z₀| + |z₁| := Complex.norm_le_abs_re_add_abs_im ζ
    have hp1 : |P 1 1 * y₀| ≤ |P 1 1| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy0b (abs_nonneg _)
    have hp2 : |P 0 1 * y₁| ≤ |P 0 1| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy1b (abs_nonneg _)
    have hp3 : |P 1 0 * y₀| ≤ |P 1 0| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy0b (abs_nonneg _)
    have hp4 : |P 0 0 * y₁| ≤ |P 0 0| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy1b (abs_nonneg _)
    have hz0b : |z₀| ≤ |P 1 1| * ‖x - x₀‖ + |P 0 1| * ‖x - x₀‖ := by
      rw [hz₀]
      have a1 := abs_le.mp hp1
      have a2 := abs_le.mp hp2
      exact abs_le.mpr ⟨by linarith [a1.1, a2.2], by linarith [a1.2, a2.1]⟩
    have hz1b : |z₁| ≤ |P 1 0| * ‖x - x₀‖ + |P 0 0| * ‖x - x₀‖ := by
      rw [hz₁]
      have a1 := abs_le.mp hp3
      have a2 := abs_le.mp hp4
      exact abs_le.mpr ⟨by linarith [a1.2, a2.1], by linarith [a1.1, a2.2]⟩
    have hnn := norm_nonneg (x - x₀)
    have hlt : ‖ζ‖ < Real.exp T := by
      have : ‖ζ‖ ≤ ‖x - x₀‖ * κ := by rw [hκ]; linarith
      nlinarith
    have ht : Real.log ‖ζ‖ < T := (Real.log_lt_iff_lt_exp hr).2 hlt
    have hexp : Real.exp (Real.log ‖ζ‖) = ‖ζ‖ := Real.exp_log hr
    have c0 : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) 0 = x 0 := by
      rw [hcoord]
      simp only
      rw [hexp]
      linear_combination P 0 0 * hcos + P 0 1 * hsin + hI0 + hy₀
    have c1 : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) 1 = x 1 := by
      rw [hcoord]
      simp only
      rw [hexp]
      linear_combination P 1 0 * hcos + P 1 1 * hsin + hI1 + hy₁
    have hΦ : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) = x := by
      refine PiLp.ext ?_
      intro i
      fin_cases i
      · exact c0
      · exact c1
    rw [← hΦ]
    exact hf _ ht

theorem lap2_cylinder_reduction (V : Set E2) (hV : IsOpen V)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) (hharm : ∀ x ∈ V, lap2 h u x = 0)
    (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ) (hball : Metric.closedBall x₀ ρ ⊆ V)
    (hdec : ∀ K : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
      |u x - u x₀| ≤ C * ‖x - x₀‖ ^ K ∧ ‖fderiv ℝ u x‖ ≤ C * ‖x - x₀‖ ^ K) :
    ∃ (T C₁ : ℝ) (a b c w : ℝ × ℝ → ℝ), 0 ≤ C₁ ∧ fplCylData T C₁ a b c w ∧
      (∀ K : ℕ, ∃ CK : ℝ, ∀ p : ℝ × ℝ, p.1 < T →
        |w p| ≤ CK * Real.exp (K * p.1) ∧ |fplDt w p| ≤ CK * Real.exp (K * p.1) ∧
        |fplDs w p| ≤ CK * Real.exp (K * p.1)) ∧
      ((∀ p : ℝ × ℝ, p.1 < T → w p = 0) → ∀ᶠ x in 𝓝 x₀, u x = u x₀) :=
by
  have cyl_flux_algebra : ∀ (P : Matrix (Fin 2) (Fin 2) ℝ) (A00 A01 A11 g0 g1 θ E : ℝ),
      P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1 →
      cylRotA θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((P 0 0 * Real.cos θ + P 0 1 * Real.sin θ) * g0 +
            (P 1 0 * Real.cos θ + P 1 1 * Real.sin θ) * g1)) +
        cylRotB θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((-P 0 0 * Real.sin θ + P 0 1 * Real.cos θ) * g0 +
            (-P 1 0 * Real.sin θ + P 1 1 * Real.cos θ) * g1)) =
        E * (Real.cos θ * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          Real.sin θ * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) ∧
      cylRotB θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((P 0 0 * Real.cos θ + P 0 1 * Real.sin θ) * g0 +
            (P 1 0 * Real.cos θ + P 1 1 * Real.sin θ) * g1)) +
        cylRotC θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((-P 0 0 * Real.sin θ + P 0 1 * Real.cos θ) * g0 +
            (-P 1 0 * Real.sin θ + P 1 1 * Real.cos θ) * g1)) =
        E * (-Real.sin θ * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          Real.cos θ * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) ∧
      cylM00 P A00 A01 A11 * cylM11 P A00 A01 A11 - cylM01 P A00 A01 A11 ^ 2 =
        A00 * A11 - A01 ^ 2 := by
    intro P A00 A01 A11 g0 g1 θ E hd
    unfold cylRotA cylRotB cylRotC cylM00 cylM01 cylM11
    have hCS := Real.cos_sq_add_sin_sq θ
    generalize Real.cos θ = C at hCS ⊢
    generalize Real.sin θ = S at hCS ⊢
    refine ⟨?_, ?_, ?_⟩
    · linear_combination (E * (C * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          S * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) *
          (P 0 0 * P 1 1 - P 0 1 * P 1 0)) * hCS +
        (E * (C * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          S * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1)))) * hd
    · linear_combination (E * (-S * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          C * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) *
          (P 0 0 * P 1 1 - P 0 1 * P 1 0)) * hCS +
        (E * (-S * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          C * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1)))) * hd
    · linear_combination ((P 0 0 * P 1 1 - P 0 1 * P 1 0 + 1) * (A00 * A11 - A01 ^ 2)) * hd
  have cyl_cholesky_normalise : ∀ (p q r : ℝ), 0 < p → p * r - q ^ 2 = 1 →
      ∃ P : Matrix (Fin 2) (Fin 2) ℝ, P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1 ∧
        cylM00 P p q r = 1 ∧ cylM01 P p q r = 0 ∧ cylM11 P p q r = 1 := by
    intro p q r hp hpr
    have hs : 0 < Real.sqrt p := Real.sqrt_pos.mpr hp
    have hps : p = Real.sqrt p ^ 2 := (Real.sq_sqrt hp.le).symm
    have hinv : Real.sqrt p * (Real.sqrt p)⁻¹ = 1 := mul_inv_cancel₀ hs.ne'
    generalize Real.sqrt p = s at hs hps hinv
    refine ⟨!![s, 0; q * s⁻¹, s⁻¹], ?_, ?_, ?_, ?_⟩ <;>
      simp only [cylM00, cylM01, cylM11, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
