      ((hA a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hxU)
    have hexp : ∀ (Φ : E2 → ℝ) (Ψ : Fin 2 → E2 → ℝ), DifferentiableAt ℝ Φ x →
        (∀ b, DifferentiableAt ℝ (Ψ b) x) →
        pd2 k (fun x => Φ x - ∑ b : Fin 2, A x a b * Ψ b x) x =
          pd2 k Φ x - ∑ b : Fin 2, (pd2 k (fun y => A y a b) x * Ψ b x +
            A x a b * pd2 k (Ψ b) x) := by
      intro Φ Ψ hΦ hΨ'
      have hD : HasFDerivAt (fun x => Φ x - ∑ b : Fin 2, A x a b * Ψ b x)
          (fderiv ℝ Φ x - ∑ b : Fin 2, (A x a b • fderiv ℝ (Ψ b) x +
            Ψ b x • fderiv ℝ (fun y => A y a b) x)) x :=
        hΦ.hasFDerivAt.fun_sub
          (HasFDerivAt.fun_sum fun b _ => (hAd b).hasFDerivAt.fun_mul (hΨ' b).hasFDerivAt)
      show fderiv ℝ _ x (e2 k) = _
      rw [hD.fderiv]
      simp only [pd2, ContinuousLinearMap.sub_apply, ContinuousLinearMap.sum_apply,
        ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
        Fin.sum_univ_two]
      ring
    have hΦx : DifferentiableAt ℝ (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator
        (fun y => ∑ b : Fin 2, A y a b * G b y) y) x := (hΦs.differentiable (by simp)) x
    have hΨx : ∀ b : Fin 2, DifferentiableAt ℝ (fun x => ∫ y, η (x - y) *
        (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y) x :=
      fun b => ((hΨ b).1.differentiable (by simp)) x
    have hLipx : ∀ y : E2, ‖x - y‖ ≤ δ → ∀ b : Fin 2, |A y a b - A x a b| ≤ Λ' * ‖y - x‖ := by
      intro y hy b
      have hy3 : y ∈ Metric.ball x₀ (3 * ρ) := by
        rw [Metric.mem_ball] at hx ⊢
        have h1 : dist y x ≤ δ := by rw [dist_comm, dist_eq_norm]; exact hy
        linarith [dist_triangle y x x₀]
      exact hLip x hx3 y hy3 a b
    have hL := elr_mc_pointwise A G (Metric.closedBall x₀ (4 * ρ)) hKc hAc hGint η hη hηc hη0 δ x
      (fun m y h => hpd0 m _ h) Λ' a k hLipx (fun b => hΛ' x hx3 a b k)
    rw [hFdef]
    refine Eq.trans_le ?_ hL
    rw [hRdef, hexp _ (fun b x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y)
      hΦx hΨx]
    simp only [hΦd, hΨd]
  
  have hS : MeasurableSet (Metric.ball x₀ (2 * ρ)) := measurableSet_ball
  have hFsqI : ∀ k b : Fin 2, IntegrableOn (fun x => F k b x ^ 2) (Metric.ball x₀ (2 * ρ)) :=
    fun k b => (((hFc k b).pow 2).continuousOn.integrableOn_compact
      (isCompact_closedBall x₀ (2 * ρ))).mono_set Metric.ball_subset_closedBall
  have hptsq : ∀ x ∈ Metric.ball x₀ (2 * ρ), (∑ k : Fin 2, pd2 k R x ^ 2) ≤
      ∑ k : Fin 2, 2 * Λ' ^ 2 * (F k 0 x ^ 2 + F k 1 x ^ 2) := by
    intro x hx
    refine Finset.sum_le_sum fun k _ => ?_
    have h1 := hpt x hx k
    rw [Fin.sum_univ_two] at h1
    have u0 := hF0 k 0 x
    have u1 := hF0 k 1 x
    have h2 : pd2 k R x ^ 2 ≤ (Λ' * (F k 0 x + F k 1 x)) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) h1 2
    nlinarith [mul_nonneg (sq_nonneg Λ') (sq_nonneg (F k 0 x - F k 1 x))]
  have hgI : IntegrableOn (fun x => ∑ k : Fin 2, 2 * Λ' ^ 2 * (F k 0 x ^ 2 + F k 1 x ^ 2))
      (Metric.ball x₀ (2 * ρ)) :=
    integrable_finset_sum _ fun k _ => ((hFsqI k 0).add (hFsqI k 1)).const_mul _
  have hmono : (∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, pd2 k R x ^ 2) ≤
      ∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, 2 * Λ' ^ 2 * (F k 0 x ^ 2 + F k 1 x ^ 2) :=
    integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun x => Finset.sum_nonneg fun k _ => sq_nonneg _) hgI
      ((ae_restrict_iff' hS).2 (Filter.Eventually.of_forall hptsq))
  have hval : (∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, 2 * Λ' ^ 2 * (F k 0 x ^ 2 + F k 1 x ^ 2)) =
      ∑ k : Fin 2, 2 * Λ' ^ 2 * ((∫ x in Metric.ball x₀ (2 * ρ), F k 0 x ^ 2) +
        ∫ x in Metric.ball x₀ (2 * ρ), F k 1 x ^ 2) := by
    have hint : ∀ k ∈ (Finset.univ : Finset (Fin 2)), Integrable
        (fun x => 2 * Λ' ^ 2 * (F k 0 x ^ 2 + F k 1 x ^ 2))
        (volume.restrict (Metric.ball x₀ (2 * ρ))) :=
      fun k _ => ((hFsqI k 0).add (hFsqI k 1)).const_mul _
    rw [integral_finset_sum _ hint]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [integral_const_mul, integral_add (hFsqI k 0) (hFsqI k 1)]
  rw [hval] at hmono
  simp only [Fin.sum_univ_two] at hmono ⊢
  have hΛ2 : 0 ≤ 2 * Λ' ^ 2 := by positivity
  have e1 := mul_le_mul_of_nonneg_left (hFI 0 0) hΛ2
  have e2 := mul_le_mul_of_nonneg_left (hFI 0 1) hΛ2
  have e3 := mul_le_mul_of_nonneg_left (hFI 1 0) hΛ2
  have e4 := mul_le_mul_of_nonneg_left (hFI 1 1) hΛ2
  have e5 := mul_nonneg (mul_nonneg (sq_nonneg Λ') (add_nonneg (hI0 0) (hI0 1)))
    (sq_nonneg (Cη - 1))
  nlinarith [e1, e2, e3, e4, e5]

theorem elr_cacc_pd2_comm (W : Set E2) (hW : IsOpen W) (f : E2 → ℝ) (hf : ContDiffOn ℝ ∞ f W) (x : E2) (hx : x ∈ W) (i j : Fin 2) : pd2 i (pd2 j f) x = pd2 j (pd2 i f) x :=
by
  have hfx : ContDiffAt ℝ ∞ f x := hf.contDiffAt (hW.mem_nhds hx)
  have hfx2 : ContDiffAt ℝ 2 f x := by
    have h := contDiffAt_infty.1 hfx 2
    first
      | exact h
      | simpa using h
      | exact_mod_cast h
  have hD : DifferentiableAt ℝ (fderiv ℝ f) x :=
    (hfx2.fderiv_right (m := 1) (by first | exact le_of_eq one_add_one_eq_two | norm_num)).differentiableAt one_ne_zero
  have hbridge : ∀ a b : Fin 2,
      pd2 a (pd2 b f) x = fderiv ℝ (fderiv ℝ f) x (e2 a) (e2 b) := by
    intro a b
    have h := fderiv_clm_apply (c := fderiv ℝ f) (u := fun _ : E2 => e2 b) hD
      (differentiableAt_const _)
    show fderiv ℝ (fun y => fderiv ℝ f y (e2 b)) x (e2 a) = _
    rw [h]
    simp
  have hsymm : IsSymmSndFDerivAt ℝ f x :=
    hfx2.isSymmSndFDerivAt (by first | simp [minSmoothness_of_isRCLikeNormedField] | rw [minSmoothness_of_isRCLikeNormedField])
  rw [hbridge i j, hbridge j i]
  exact hsymm.eq _ _

theorem elr_cacc_weak_diff (W : Set E2) (hW : IsOpen W) (V : Fin 2 → E2 → ℝ) (hV : ∀ a, ContDiffOn ℝ ∞ (V a) W) (Ψ : E2 → ℝ) (hΨ : ContinuousOn Ψ W) (heq : ∀ x ∈ W, ∑ a : Fin 2, pd2 a (V a) x = -Ψ x) (ψ : E2 → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ) (hψW : tsupport ψ ⊆ W) (n : Fin 2) : Integrable (fun x => ∑ a : Fin 2, pd2 n (V a) x * pd2 a ψ x + Ψ x * pd2 n ψ x) ∧ ∫ x, (∑ a : Fin 2, pd2 n (V a) x * pd2 a ψ x + Ψ x * pd2 n ψ x) = 0 :=
by
  
  have hT : ∀ (f : E2 → ℝ), ContDiff ℝ ∞ f → HasCompactSupport f → ∀ k : Fin 2,
      ContDiff ℝ ∞ (pd2 k f) ∧ HasCompactSupport (pd2 k f) ∧ tsupport (pd2 k f) ⊆ tsupport f := by
    intro f hf hfc k
    have hsupp : Function.support (pd2 k f) ⊆ Function.support (fderiv ℝ f) := by
      intro x hx
      rw [Function.mem_support] at hx ⊢
      intro h0
      apply hx
      simp [pd2, h0]
    refine ⟨?_, (hfc.fderiv (𝕜 := ℝ)).mono hsupp,
      (closure_mono hsupp).trans (tsupport_fderiv_subset ℝ)⟩
    exact (contDiff_infty_iff_fderiv.1 hf).2.clm_apply contDiff_const
  
  have hCM : ∀ (f φ : E2 → ℝ), ContinuousOn f W → Continuous φ → HasCompactSupport φ →
      tsupport φ ⊆ W → Integrable (fun x => f x * φ x) := by
    intro f φ hf hφ hφc hφW
    have hcont : Continuous (fun x => f x * φ x) :=
      (hf.mul hφ.continuousOn).continuous_of_tsupport_subset hW
        ((tsupport_mul_subset_right).trans hφW)
    exact hcont.integrable_of_hasCompactSupport hφc.mul_left
  
  have hcomm : ∀ (x : E2) (i j : Fin 2), pd2 i (pd2 j ψ) x = pd2 j (pd2 i ψ) x := by
    have hfd : ContDiff ℝ ∞ (fderiv ℝ ψ) := (contDiff_infty_iff_fderiv.1 hψ).2
    have key : ∀ (x : E2) (i j : Fin 2),
        pd2 i (pd2 j ψ) x = fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j) := by
      intro x i j
      have hd : DifferentiableAt ℝ (fderiv ℝ ψ) x := (hfd.differentiable (by simp)) x
      have h := hd.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 j) x)
      show fderiv ℝ (fun y => fderiv ℝ ψ y (e2 j)) x (e2 i) = _
      rw [h.fderiv]
      simp
    intro x i j
    have hs := (hψ.contDiffAt (x := x)).isSymmSndFDerivAt (by
      simp only [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    rw [key, key]
    exact hs (e2 i) (e2 j)
  
  have ibp : ∀ (u : E2 → ℝ), ContDiffOn ℝ ∞ u W → ∀ (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ →
      HasCompactSupport ζ → tsupport ζ ⊆ W → ∀ k : Fin 2,
      ∫ x, u x * pd2 k ζ x = -(∫ x, pd2 k u x * ζ x) := by
    intro u hu ζ hζ hζc hζW k
    have hvan : ∀ x, x ∉ W → (ζ =ᶠ[𝓝 x] 0) := by
      intro x hx
      exact notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (hζW h))
    have hζ0 : ∀ x, x ∉ W → ζ x = 0 := by
      intro x hx
      exact image_eq_zero_of_notMem_tsupport (fun h => hx (hζW h))
    have hdζ0 : ∀ x, x ∉ W → pd2 k ζ x = 0 := by
      intro x hx
      have h1 : fderiv ℝ ζ x = fderiv ℝ (fun _ => (0:ℝ)) x :=
        Filter.EventuallyEq.fderiv_eq (hvan x hx)
      simp only [pd2, h1, fderiv_const_apply, ContinuousLinearMap.zero_apply]
    have hFder : ∀ x, HasFDerivAt (fun y => u y * ζ y)
        (fderiv ℝ (fun y => u y * ζ y) x) x ∧
        fderiv ℝ (fun y => u y * ζ y) x (e2 k) = pd2 k u x * ζ x + u x * pd2 k ζ x := by
      intro x
      by_cases hx : x ∈ W
      · have hu' : HasFDerivAt u (fderiv ℝ u x) x :=
          ((hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)).hasFDerivAt
        have hζ' : HasFDerivAt ζ (fderiv ℝ ζ x) x :=
          (hζ.differentiable (by simp) x).hasFDerivAt
        have hm : HasFDerivAt (fun y => u y * ζ y) (u x • fderiv ℝ ζ x + ζ x • fderiv ℝ u x) x :=
          hu'.mul hζ'
        refine ⟨hm.differentiableAt.hasFDerivAt, ?_⟩
        rw [hm.fderiv]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, pd2]
        ring
      · have hF0 : (fun y => u y * ζ y) =ᶠ[𝓝 x] (fun _ => (0:ℝ)) := by
          filter_upwards [hvan x hx] with y hy
          simp only [Pi.zero_apply] at hy
          simp [hy]
        have hd : HasFDerivAt (fun y => u y * ζ y) (0 : E2 →L[ℝ] ℝ) x :=
          (hasFDerivAt_const (0:ℝ) x).congr_of_eventuallyEq hF0
        refine ⟨hd.differentiableAt.hasFDerivAt, ?_⟩
        rw [hd.fderiv, hζ0 x hx, hdζ0 x hx]
        simp
    have hFd : Differentiable ℝ (fun y => u y * ζ y) :=
      fun x => (hFder x).1.differentiableAt
    have hprod : (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) =
        fun x => pd2 k u x * ζ x + u x * pd2 k ζ x := funext fun x => (hFder x).2
    have hdu : ContinuousOn (pd2 k u) W :=
      (hu.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
    obtain ⟨hdζ1, hdζ2, hdζs⟩ := hT ζ hζ hζc k
    have hg₁ : Integrable (fun x => pd2 k u x * ζ x) :=
      hCM _ _ hdu hζ.continuous hζc hζW
    have hg₂ : Integrable (fun x => u x * pd2 k ζ x) :=
      hCM _ _ hu.continuousOn hdζ1.continuous hdζ2 (hdζs.trans hζW)
    have hF : Integrable (fun x => u x * ζ x) :=
      hCM _ _ hu.continuousOn hζ.continuous hζc hζW
    have hF' : Integrable (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) := by
      rw [hprod]; exact hg₁.add hg₂
    have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun y => u y * ζ y) (g := fun _ => (1:ℝ)) (v := e2 k)
      (by simpa using hF') (by simp) (by simpa using hF) hFd (differentiable_const 1)
    have hzero : ∫ x, fderiv ℝ (fun y => u y * ζ y) x (e2 k) = 0 := by
      simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, mul_zero, integral_zero,
        mul_one] at h
      linarith
    rw [hprod, integral_add hg₁ hg₂] at hzero
    linarith
  obtain ⟨hTn1, hTn2, -⟩ := hT ψ hψ hψc n
  have hTW : ∀ k, tsupport (pd2 k ψ) ⊆ W := fun k => (hT ψ hψ hψc k).2.2.trans hψW
  have hcV : ∀ a k : Fin 2, ContinuousOn (pd2 k (V a)) W := fun a k =>
    ((((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 (hV a)).2).clm_apply
      contDiffOn_const).continuousOn
  have hJ1 : ∀ a : Fin 2, Integrable (fun x => pd2 n (V a) x * pd2 a ψ x) := fun a =>
    hCM _ _ (hcV a n) (hT ψ hψ hψc a).1.continuous (hT ψ hψ hψc a).2.1 (hTW a)
  have hJ2 : ∀ a : Fin 2, Integrable (fun x => pd2 a (V a) x * pd2 n ψ x) := fun a =>
    hCM _ _ (hcV a a) hTn1.continuous hTn2 (hTW n)
  have hJ3 : Integrable (fun x => Ψ x * pd2 n ψ x) :=
    hCM _ _ hΨ hTn1.continuous hTn2 (hTW n)
  have hsumI : Integrable (fun x => ∑ a : Fin 2, pd2 n (V a) x * pd2 a ψ x) :=
    integrable_finset_sum _ (fun a _ => hJ1 a)
  refine ⟨hsumI.add hJ3, ?_⟩
  
  have hI : ∀ a : Fin 2,
      ∫ x, pd2 n (V a) x * pd2 a ψ x = ∫ x, pd2 a (V a) x * pd2 n ψ x := by
    intro a
    obtain ⟨ha1, ha2, ha3⟩ := hT ψ hψ hψc a
    have h1 := ibp (V a) (hV a) (pd2 a ψ) ha1 ha2 (ha3.trans hψW) n
    have h2 := ibp (V a) (hV a) (pd2 n ψ) hTn1 hTn2 (hTW n) a
    have h3 : (fun x => V a x * pd2 n (pd2 a ψ) x) = (fun x => V a x * pd2 a (pd2 n ψ) x) := by
      funext x
      rw [hcomm x n a]
    rw [h3, h2] at h1
    linarith
  
  have hpt : ∀ x, ∑ a : Fin 2, pd2 a (V a) x * pd2 n ψ x = -(Ψ x * pd2 n ψ x) := by
    intro x
    by_cases hx : x ∈ W
    · rw [← Finset.sum_mul, heq x hx, neg_mul]
    · have h0 : pd2 n ψ x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hx (hTW n h))
      simp [h0]
  have hS : ∑ a : Fin 2, ∫ x, pd2 a (V a) x * pd2 n ψ x = -(∫ x, Ψ x * pd2 n ψ x) := by
    rw [← integral_finset_sum _ (fun a _ => hJ2 a), ← integral_neg]
    exact congrArg (fun F : E2 → ℝ => ∫ x, F x) (funext hpt)
  rw [integral_add hsumI hJ3, integral_finset_sum _ (fun a _ => hJ1 a),
    Finset.sum_congr rfl (fun a _ => hI a), hS]
  ring

theorem elr_cacc_expand (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) W) (u : E2 → ℝ) (hu : ContDiff ℝ ∞ u) (R : Fin 2 → E2 → ℝ) (hR : ∀ a, ContDiffOn ℝ ∞ (R a) W) (χ : E2 → ℝ) (hχ : ContDiff ℝ ∞ χ) (n : Fin 2) : (∀ a : Fin 2, ContDiffOn ℝ ∞ (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) W) ∧ ContDiff ℝ ∞ (fun y => χ y ^ 2 * pd2 n u y) ∧ (∀ x ∈ W, ∀ a : Fin 2, pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x = ∑ b : Fin 2, (pd2 n (fun y => A y a b) x * pd2 b u x + A x a b * pd2 n (pd2 b u) x) + pd2 n (R a) x) ∧ ∀ (x : E2) (k : Fin 2), pd2 k (fun y => χ y ^ 2 * pd2 n u y) x = χ x ^ 2 * pd2 k (pd2 n u) x + 2 * χ x * pd2 k χ x * pd2 n u x :=
by
  have hpdc : ∀ b : Fin 2, ContDiff ℝ ∞ (pd2 b u) := fun b =>
    (contDiff_infty_iff_fderiv.1 hu).2.clm_apply contDiff_const
  have hdU : ∀ (b : Fin 2) (x : E2), DifferentiableAt ℝ (pd2 b u) x :=
    fun b x => ((hpdc b).differentiable (by simp)) x
  have pd_add : ∀ (c : Fin 2) (x : E2) (f g : E2 → ℝ), DifferentiableAt ℝ f x →
      DifferentiableAt ℝ g x → pd2 c (fun y => f y + g y) x = pd2 c f x + pd2 c g x := by
    intro c x f g hf hg
    simp only [pd2]
    rw [fderiv_fun_add hf hg]
    rfl
  have pd_mul : ∀ (c : Fin 2) (x : E2) (f g : E2 → ℝ), DifferentiableAt ℝ f x →
      DifferentiableAt ℝ g x → pd2 c (fun y => f y * g y) x = pd2 c f x * g x + f x * pd2 c g x := by
    intro c x f g hf hg
    simp only [pd2]
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  refine ⟨?_, (hχ.pow 2).mul (hpdc n), ?_, ?_⟩
  · intro a
    have hfun : (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) =
        fun y => (A y a 0 * pd2 0 u y + A y a 1 * pd2 1 u y) + R a y := by
      funext y; rw [Fin.sum_univ_two]
    rw [hfun]
    exact (((hA a 0).mul (hpdc 0).contDiffOn).add ((hA a 1).mul (hpdc 1).contDiffOn)).add (hR a)
  · intro x hx a
    have hWx : W ∈ 𝓝 x := hW.mem_nhds hx
    have dA : ∀ b, DifferentiableAt ℝ (fun y => A y a b) x := fun b =>
      ((hA a b).contDiffAt hWx).differentiableAt (by simp)
    have dR : DifferentiableAt ℝ (R a) x := ((hR a).contDiffAt hWx).differentiableAt (by simp)
    have d3 : ∀ b, DifferentiableAt ℝ (fun y => A y a b * pd2 b u y) x := fun b =>
      (dA b).fun_mul (hdU b x)
    have dS : DifferentiableAt ℝ (fun y => A y a 0 * pd2 0 u y + A y a 1 * pd2 1 u y) x :=
      (d3 0).fun_add (d3 1)
    have hfun : (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) =
        fun y => (A y a 0 * pd2 0 u y + A y a 1 * pd2 1 u y) + R a y := by
      funext y; rw [Fin.sum_univ_two]
    have h1 := pd_add n x (fun y => A y a 0 * pd2 0 u y + A y a 1 * pd2 1 u y) (R a) dS dR
    have h2 := pd_add n x (fun y => A y a 0 * pd2 0 u y) (fun y => A y a 1 * pd2 1 u y) (d3 0) (d3 1)
    have h3 := pd_mul n x (fun y => A y a 0) (pd2 0 u) (dA 0) (hdU 0 x)
    have h4 := pd_mul n x (fun y => A y a 1) (pd2 1 u) (dA 1) (hdU 1 x)
    beta_reduce at h1 h2 h3 h4
    rw [hfun, h1, h2, h3, h4, Fin.sum_univ_two]
  · intro x k
    have dχ : DifferentiableAt ℝ χ x := (hχ.differentiable (by simp)) x
    have dχ2 : DifferentiableAt ℝ (fun y => χ y ^ 2) x := ((hχ.pow 2).differentiable (by simp)) x
    have hsq : (fun y => χ y ^ 2) = fun y => χ y * χ y := by funext y; ring
    have hsqd : pd2 k (fun y => χ y ^ 2) x = pd2 k χ x * χ x + χ x * pd2 k χ x := by
      rw [hsq]; exact pd_mul k x χ χ dχ dχ
    have h5 := pd_mul k x (fun y => χ y ^ 2) (pd2 n u) dχ2 (hdU n x)
    beta_reduce at h5
    rw [h5, hsqd]
    ring

theorem elr_cacc_pointwise (θ Λ Λ' M c Ψ : ℝ) (n : Fin 2) (A D : Fin 2 → Fin 2 → ℝ) (g X h q P : Fin 2 → ℝ) (hθ : 0 < θ) (hM : 0 ≤ M) (hc0 : 0 ≤ c) (hc1 : c ≤ 1) (hell : θ * ∑ a : Fin 2, X a ^ 2 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A a b * X a * X b) (hA : ∀ a b : Fin 2, |A a b| ≤ Λ) (hD : ∀ a b : Fin 2, |D a b| ≤ Λ') (hh : ∀ a : Fin 2, |h a| ≤ M) (hq : ∀ a : Fin 2, q a ^ 2 ≤ P a) : θ / 2 * (c ^ 2 * ∑ a : Fin 2, X a ^ 2) ≤ (∑ a : Fin 2, (∑ b : Fin 2, (D a b * g b + A a b * X b) + q a) * (c ^ 2 * X a + 2 * c * h a * g n) + Ψ * (c ^ 2 * X n + 2 * c * h n * g n)) + (4 / θ + 4 * M + 32 * Λ' ^ 2 / θ + 8 * M * Λ' + 128 * Λ ^ 2 * M ^ 2 / θ) * (∑ k : Fin 2, g k ^ 2 + Ψ ^ 2 + ∑ a : Fin 2, P a) :=
by
  obtain ⟨ι, hιdef⟩ : ∃ ι : ℝ, ι = 1 / θ := ⟨_, rfl⟩
  have hι : 0 < ι := by rw [hιdef]; positivity
  have hθι : θ * ι = 1 := by rw [hιdef]; field_simp
  have hΛ' : 0 ≤ Λ' := le_trans (abs_nonneg _) (hD 0 0)
  have hΛ : 0 ≤ Λ := le_trans (abs_nonneg _) (hA 0 0)
  have hc2 : c ^ 2 ≤ 1 := by nlinarith
  
  have young : ∀ a b : ℝ, a * b ≤ θ / 8 * a ^ 2 + 2 * ι * b ^ 2 := by
    intro a b
    have key : θ * (θ / 8 * a ^ 2 + 2 * ι * b ^ 2 - a * b) = (θ * a - 4 * b) ^ 2 / 8 := by
      linear_combination (2 * b ^ 2) * hθι
    have h1 : 0 ≤ (θ * a - 4 * b) ^ 2 / 8 := by positivity
    by_contra hcon
    push_neg at hcon
    have h2 : θ * (θ / 8 * a ^ 2 + 2 * ι * b ^ 2 - a * b) < 0 :=
      mul_neg_of_pos_of_neg hθ (by linarith)
    linarith
  have young' : ∀ a b B : ℝ, b ^ 2 ≤ B → a * b ≤ θ / 8 * a ^ 2 + 2 * ι * B := by
    intro a b B hb
    have h1 := young a b
    have h2 := mul_le_mul_of_nonneg_left hb hι.le
    linarith
  have cross : ∀ t x y B : ℝ, |t| ≤ B → -(2 * t * x * y) ≤ B * (x ^ 2 + y ^ 2) := by
    intro t x y B ht
    obtain ⟨h1, h2⟩ := abs_le.mp ht
    nlinarith [mul_nonneg (show 0 ≤ B + t by linarith) (sq_nonneg (x + y)),
      mul_nonneg (show 0 ≤ B - t by linarith) (sq_nonneg (x - y))]
  have sqcomb : ∀ u v x y B : ℝ, |u| ≤ B → |v| ≤ B →
      (u * x + v * y) ^ 2 ≤ 2 * B ^ 2 * (x ^ 2 + y ^ 2) := by
    intro u v x y B hu hv
    obtain ⟨hu1, hu2⟩ := abs_le.mp hu
    obtain ⟨hv1, hv2⟩ := abs_le.mp hv
    have hu' : u ^ 2 ≤ B ^ 2 := sq_le_sq' hu1 hu2
    have hv' : v ^ 2 ≤ B ^ 2 := sq_le_sq' hv1 hv2
    nlinarith [sq_nonneg (u * x - v * y), mul_le_mul_of_nonneg_right hu' (sq_nonneg x),
      mul_le_mul_of_nonneg_right hv' (sq_nonneg y)]
  
  have hn : n = 0 ∨ n = 1 := by fin_cases n <;> simp
  have hgn : g n ^ 2 ≤ g 0 ^ 2 + g 1 ^ 2 := by
    rcases hn with rfl | rfl <;> nlinarith [sq_nonneg (g 0), sq_nonneg (g 1)]
  have hXn : X n ^ 2 ≤ X 0 ^ 2 + X 1 ^ 2 := by
    rcases hn with rfl | rfl <;> nlinarith [sq_nonneg (X 0), sq_nonneg (X 1)]
  have hYn : (c * X n) ^ 2 ≤ (c * X 0) ^ 2 + (c * X 1) ^ 2 := by
    have := mul_le_mul_of_nonneg_left hXn (sq_nonneg c)
    nlinarith
  have hG0 : 0 ≤ g 0 ^ 2 + g 1 ^ 2 := by positivity
  have hP0 : ∀ a, 0 ≤ P a := fun a => le_trans (sq_nonneg _) (hq a)
  have hcq : ∀ a, (-(c * q a)) ^ 2 ≤ P a := by
    intro a
    have := mul_le_mul_of_nonneg_right hc2 (sq_nonneg (q a))
    nlinarith [hq a]
  have hch : ∀ a, |c * h a| ≤ M := by
    intro a
    rw [abs_mul, abs_of_nonneg hc0]
    calc c * |h a| ≤ 1 * M := mul_le_mul hc1 (hh a) (abs_nonneg _) zero_le_one
      _ = M := one_mul M
  have hchD : ∀ a b, |c * h a * D a b| ≤ M * Λ' := by
    intro a b
    rw [abs_mul, abs_mul, abs_of_nonneg hc0]
    calc c * |h a| * |D a b| ≤ 1 * M * Λ' :=
          mul_le_mul (mul_le_mul hc1 (hh a) (abs_nonneg _) zero_le_one) (hD a b)
            (abs_nonneg _) (by positivity)
      _ = M * Λ' := by ring
  
  have hZ : ∀ a, (-(c * (D a 0 * g 0 + D a 1 * g 1))) ^ 2 ≤ 2 * Λ' ^ 2 * (g 0 ^ 2 + g 1 ^ 2) := by
    intro a
    have h1 := sqcomb (D a 0) (D a 1) (g 0) (g 1) Λ' (hD a 0) (hD a 1)
    have h2 := mul_le_mul_of_nonneg_right hc2 (sq_nonneg (D a 0 * g 0 + D a 1 * g 1))
    nlinarith
  have T1a := young' (c * X 0) _ _ (hZ 0)
  have T1b := young' (c * X 1) _ _ (hZ 1)
  
  have T2a := young' (c * X 0) _ _ (hcq 0)
  have T2b := young' (c * X 1) _ _ (hcq 1)
  
  have hh2 : h 0 ^ 2 + h 1 ^ 2 ≤ 2 * M ^ 2 := by
    obtain ⟨a1, a2⟩ := abs_le.mp (hh 0)
    obtain ⟨b1, b2⟩ := abs_le.mp (hh 1)
    nlinarith [sq_le_sq' a1 a2, sq_le_sq' b1 b2]
  have hU : ∀ b, (-(2 * g n * (h 0 * A 0 b + h 1 * A 1 b))) ^ 2 ≤
      16 * Λ ^ 2 * M ^ 2 * (g 0 ^ 2 + g 1 ^ 2) := by
    intro b
    have h1 := sqcomb (A 0 b) (A 1 b) (h 0) (h 1) Λ (hA 0 b) (hA 1 b)
    have h2 : (h 0 * A 0 b + h 1 * A 1 b) ^ 2 ≤ 4 * Λ ^ 2 * M ^ 2 := by
      have h3 := mul_le_mul_of_nonneg_left hh2 (show 0 ≤ 2 * Λ ^ 2 by positivity)
      nlinarith
    have h4 := mul_le_mul hgn h2 (sq_nonneg _) hG0
    nlinarith
  have T3a := young' (c * X 0) _ _ (hU 0)
  have T3b := young' (c * X 1) _ _ (hU 1)
  
  have T4_00 := cross _ (g n) (g 0) _ (hchD 0 0)
  have T4_01 := cross _ (g n) (g 1) _ (hchD 0 1)
  have T4_10 := cross _ (g n) (g 0) _ (hchD 1 0)
  have T4_11 := cross _ (g n) (g 1) _ (hchD 1 1)
  
  have T5a := cross _ (g n) (q 0) _ (hch 0)
  have T5b := cross _ (g n) (q 1) _ (hch 1)
  
  have hcΨ : (-(c * Ψ)) ^ 2 ≤ Ψ ^ 2 := by
    have := mul_le_mul_of_nonneg_right hc2 (sq_nonneg Ψ)
    nlinarith
  have T6 := young' (c * X n) _ _ hcΨ
  have T7 := cross _ Ψ (g n) _ (hch n)
  
  have p1 := mul_le_mul_of_nonneg_left hYn (show 0 ≤ θ / 8 by positivity)
  have hMΛ' : 0 ≤ M * Λ' := mul_nonneg hM hΛ'
  have p2 := mul_le_mul_of_nonneg_left hgn hMΛ'
  have p3 := mul_le_mul_of_nonneg_left hgn hM
  have p4 := mul_le_mul_of_nonneg_left (hq 0) hM
  have p5 := mul_le_mul_of_nonneg_left (hq 1) hM
  have hE : θ * ((c * X 0) ^ 2 + (c * X 1) ^ 2) ≤
      c ^ 2 * ∑ a : Fin 2, ∑ b : Fin 2, A a b * X a * X b := by
    have := mul_le_mul_of_nonneg_left hell (sq_nonneg c)
    simp only [Fin.sum_univ_two] at this ⊢
    nlinarith
  simp only [Fin.sum_univ_two] at hE
  have hKG : 0 ≤ (4 * ι + M + 24 * ι * Λ' ^ 2 + 2 * M * Λ' + 64 * ι * Λ ^ 2 * M ^ 2) *
      (g 0 ^ 2 + g 1 ^ 2) := mul_nonneg (by positivity) hG0
  have hKΨ : 0 ≤ (2 * ι + 3 * M + 32 * ι * Λ' ^ 2 + 8 * M * Λ' + 128 * ι * Λ ^ 2 * M ^ 2) *
      Ψ ^ 2 := mul_nonneg (by positivity) (sq_nonneg _)
  have hKP : 0 ≤ (2 * ι + 3 * M + 32 * ι * Λ' ^ 2 + 8 * M * Λ' + 128 * ι * Λ ^ 2 * M ^ 2) *
      (P 0 + P 1) := mul_nonneg (by positivity) (add_nonneg (hP0 0) (hP0 1))
  rw [show (4 / θ + 4 * M + 32 * Λ' ^ 2 / θ + 8 * M * Λ' + 128 * Λ ^ 2 * M ^ 2 / θ) =
      4 * ι + 4 * M + 32 * Λ' ^ 2 * ι + 8 * M * Λ' + 128 * Λ ^ 2 * M ^ 2 * ι by
    rw [hιdef]; ring]
  simp only [Fin.sum_univ_two]
  linarith

theorem elr_caccioppoli (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball x₀ (3 * ρ))) (θ Λ Λ' : ℝ) (hθ : 0 < θ) (hell : ∀ x ∈ Metric.ball x₀ (3 * ρ), ∀ ξ : Fin 2 → ℝ, θ * ∑ a : Fin 2, ξ a ^ 2 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A x a b * ξ a * ξ b) (hΛ : ∀ x ∈ Metric.ball x₀ (3 * ρ), ∀ a b : Fin 2, |A x a b| ≤ Λ) (hΛ' : ∀ x ∈ Metric.ball x₀ (3 * ρ), ∀ a b c : Fin 2, |pd2 c (fun y => A y a b) x| ≤ Λ') : ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : E2 → ℝ) (R : Fin 2 → E2 → ℝ) (Ψ : E2 → ℝ), ContDiff ℝ ∞ u → (∀ a, ContDiffOn ℝ ∞ (R a) (Metric.ball x₀ (3 * ρ))) → ContinuousOn Ψ (Metric.ball x₀ (3 * ρ)) → (∀ x ∈ Metric.ball x₀ (3 * ρ), ∑ a : Fin 2, pd2 a (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x = -Ψ x) → ∀ n : Fin 2, (∫ x in Metric.ball x₀ ρ, ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2) ≤ C * ((∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, (pd2 k u x) ^ 2) + (∫ x in Metric.ball x₀ (2 * ρ), Ψ x ^ 2) + ∑ a : Fin 2, ∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, (pd2 k (R a) x) ^ 2) :=
by
  
  obtain ⟨χ, M, hχ, hχc, hχB, hχ01, hχ1, hM, hχd⟩ : ∃ (χ : E2 → ℝ) (M : ℝ), ContDiff ℝ ∞ χ ∧
      HasCompactSupport χ ∧ tsupport χ ⊆ Metric.ball x₀ (2 * ρ) ∧ (∀ x, 0 ≤ χ x ∧ χ x ≤ 1) ∧
      (∀ x ∈ Metric.ball x₀ ρ, χ x = 1) ∧ 0 ≤ M ∧ ∀ (x : E2) (k : Fin 2), |pd2 k χ x| ≤ M := by
    let β : ContDiffBump x₀ := ⟨ρ, 3 * ρ / 2, hρ, by linarith⟩
    have hβs : ContDiff ℝ ∞ (β : E2 → ℝ) := β.contDiff
    have hβc : HasCompactSupport (fderiv ℝ (β : E2 → ℝ)) := β.hasCompactSupport.fderiv (𝕜 := ℝ)
    obtain ⟨C₀, hC₀⟩ := (hβs.continuous_fderiv (by simp)).bounded_above_of_compact_support hβc
    refine ⟨β, max C₀ 0, hβs, β.hasCompactSupport, ?_, fun x => ⟨β.nonneg, β.le_one⟩,
      fun x hx => β.one_of_mem_closedBall (Metric.ball_subset_closedBall hx), le_max_right _ _,
      fun x k => ?_⟩
    · rw [β.tsupport_eq]
      exact Metric.closedBall_subset_ball (show β.rOut < 2 * ρ by show 3 * ρ / 2 < 2 * ρ; linarith)
    · calc |pd2 k β x| = ‖fderiv ℝ (β : E2 → ℝ) x (e2 k)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖fderiv ℝ (β : E2 → ℝ) x‖ * ‖e2 k‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ (β : E2 → ℝ) x‖ := by simp [e2, EuclideanSpace.norm_single]
        _ ≤ max C₀ 0 := (hC₀ x).trans (le_max_left _ _)
  have hx₀W : x₀ ∈ Metric.ball x₀ (3 * ρ) := Metric.mem_ball_self (by linarith)
  have hΛ'0 : 0 ≤ Λ' := le_trans (abs_nonneg _) (hΛ' x₀ hx₀W 0 0 0)
  obtain ⟨K, hKdef⟩ : ∃ K : ℝ,
      K = 4 / θ + 4 * M + 32 * Λ' ^ 2 / θ + 8 * M * Λ' + 128 * Λ ^ 2 * M ^ 2 / θ := ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hKdef]; positivity
  refine ⟨2 * K / θ, by positivity, ?_⟩
  intro u R Ψ hu hR hΨ heq n
  have hBW : Metric.ball x₀ (2 * ρ) ⊆ Metric.ball x₀ (3 * ρ) :=
    Metric.ball_subset_ball (by linarith)
  have hBρB : Metric.ball x₀ ρ ⊆ Metric.ball x₀ (2 * ρ) := Metric.ball_subset_ball (by linarith)
  
  obtain ⟨hV, hψ, hexpV, hexpψ⟩ :=
    elr_cacc_expand (Metric.ball x₀ (3 * ρ)) Metric.isOpen_ball A hA u hu R hR χ hχ n
  have hsuppψ : Function.support (fun y => χ y ^ 2 * pd2 n u y) ⊆ Function.support χ := by
    intro y hy
    rw [Function.mem_support] at hy ⊢
    intro h0
    apply hy
    simp [h0]
  have hψc : HasCompactSupport (fun y => χ y ^ 2 * pd2 n u y) := hχc.mono hsuppψ
  have hψW : tsupport (fun y => χ y ^ 2 * pd2 n u y) ⊆ Metric.ball x₀ (3 * ρ) :=
    (closure_mono hsuppψ).trans (hχB.trans hBW)
  
  obtain ⟨hDint, hD0⟩ := elr_cacc_weak_diff (Metric.ball x₀ (3 * ρ)) Metric.isOpen_ball
    (fun a y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) hV Ψ hΨ heq
    (fun y => χ y ^ 2 * pd2 n u y) hψ hψc hψW n
  have hDint' : Integrable (fun x => ∑ a : Fin 2,
      pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
        pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
      Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x) := hDint
  have hD0' : (∫ x, (∑ a : Fin 2,
      pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
        pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
      Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x)) = 0 := hD0
  
  have hχout : ∀ x, x ∉ Metric.ball x₀ (2 * ρ) → χ x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport (fun h => hx (hχB h))
  have hDB : (∫ x in Metric.ball x₀ (2 * ρ), (∑ a : Fin 2,
      pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
        pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
      Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x)) = 0 := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
    · exact hD0'
    · intro x hx
      have h0 := hχout x hx
      simp [hexpψ, h0]
  
  have hcomm : ∀ (x : E2) (b : Fin 2), pd2 n (pd2 b u) x = pd2 b (pd2 n u) x := fun x b =>
    elr_cacc_pd2_comm Set.univ isOpen_univ u hu.contDiffOn x (Set.mem_univ x) n b
  have hpw : ∀ x ∈ Metric.ball x₀ (2 * ρ),
      θ / 2 * (χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2) ≤
        (∑ a : Fin 2,
          pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
            pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
          Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x) +
        K * (∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
          ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2) := by
    intro x hxB
    have hxW := hBW hxB
    have hq : ∀ a : Fin 2, (pd2 n (R a) x) ^ 2 ≤ ∑ k : Fin 2, (pd2 k (R a) x) ^ 2 := fun a =>
      Finset.single_le_sum (f := fun k => (pd2 k (R a) x) ^ 2) (fun k _ => sq_nonneg _)
        (Finset.mem_univ n)
    have hpt := elr_cacc_pointwise θ Λ Λ' M (χ x) (Ψ x) n (fun a b => A x a b)
      (fun a b => pd2 n (fun y => A y a b) x) (fun k => pd2 k u x)
      (fun k => pd2 k (pd2 n u) x) (fun a => pd2 a χ x) (fun a => pd2 n (R a) x)
      (fun a => ∑ k : Fin 2, (pd2 k (R a) x) ^ 2)
      hθ hM (hχ01 x).1 (hχ01 x).2 (hell x hxW (fun k => pd2 k (pd2 n u) x)) (hΛ x hxW)
      (fun a b => hΛ' x hxW a b n) (fun a => hχd x a) hq
    rw [← hKdef] at hpt
    have hexpV' : ∀ a : Fin 2,
        pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x =
          ∑ b : Fin 2, (pd2 n (fun y => A y a b) x * pd2 b u x +
            A x a b * pd2 b (pd2 n u) x) + pd2 n (R a) x := by
      intro a
      rw [hexpV x hxW a]
      congr 1
      exact Finset.sum_congr rfl (fun b _ => by rw [hcomm x b])
    simp only [hexpV', hexpψ x]
    exact hpt
  
  have hKc : IsCompact (Metric.closedBall x₀ (2 * ρ)) := isCompact_closedBall _ _
  have hKW : Metric.closedBall x₀ (2 * ρ) ⊆ Metric.ball x₀ (3 * ρ) :=
    Metric.closedBall_subset_ball (by linarith)
  have hpdc : ∀ f : E2 → ℝ, ContDiff ℝ ∞ f → ∀ k : Fin 2, ContDiff ℝ ∞ (pd2 k f) :=
    fun f hf k => (contDiff_infty_iff_fderiv.1 hf).2.clm_apply contDiff_const
  have hpdo : ∀ a k : Fin 2, ContinuousOn (pd2 k (R a)) (Metric.ball x₀ (3 * ρ)) := fun a k =>
    ((((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 (hR a)).2).clm_apply
      contDiffOn_const).continuousOn
  have hI1 : IntegrableOn (fun x => ∑ k : Fin 2, (pd2 k u x) ^ 2) (Metric.ball x₀ (2 * ρ)) :=
    ((continuous_finset_sum _ fun k _ => (hpdc u hu k).continuous.pow 2).continuousOn
      |>.integrableOn_compact hKc).mono_set Metric.ball_subset_closedBall
  have hI2 : IntegrableOn (fun x => Ψ x ^ 2) (Metric.ball x₀ (2 * ρ)) :=
    (((hΨ.mono hKW).pow 2).integrableOn_compact hKc).mono_set Metric.ball_subset_closedBall
  have hI3 : ∀ a : Fin 2,
      IntegrableOn (fun x => ∑ k : Fin 2, (pd2 k (R a) x) ^ 2) (Metric.ball x₀ (2 * ρ)) :=
    fun a => ((continuousOn_finset_sum _ fun k _ => ((hpdo a k).mono hKW).pow 2)
      |>.integrableOn_compact hKc).mono_set Metric.ball_subset_closedBall
  have hI4 : IntegrableOn (fun x => χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2)
      (Metric.ball x₀ (2 * ρ)) :=
    (((hχ.continuous.pow 2).mul (continuous_finset_sum _ fun k _ =>
      (hpdc _ (hpdc u hu n) k).continuous.pow 2)).continuousOn
      |>.integrableOn_compact hKc).mono_set Metric.ball_subset_closedBall
  have hI3' : IntegrableOn (fun x => ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2)
      (Metric.ball x₀ (2 * ρ)) := integrable_finset_sum _ (fun a _ => hI3 a)
  have hI12 : IntegrableOn (fun x => ∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2)
      (Metric.ball x₀ (2 * ρ)) := hI1.add hI2
  have hS : IntegrableOn (fun x => ∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
      ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2) (Metric.ball x₀ (2 * ρ)) := hI12.add hI3'
  have hg : IntegrableOn (fun x => (∑ a : Fin 2,
          pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
            pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
          Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x) +
        K * (∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
          ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2)) (Metric.ball x₀ (2 * ρ)) :=
    hDint'.integrableOn.add (hS.const_mul K)
  have hmono := setIntegral_mono_on
    (f := fun x => θ / 2 * (χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2))
    (g := fun x => (∑ a : Fin 2,
          pd2 n (fun y => ∑ b : Fin 2, A y a b * pd2 b u y + R a y) x *
            pd2 a (fun y => χ y ^ 2 * pd2 n u y) x +
          Ψ x * pd2 n (fun y => χ y ^ 2 * pd2 n u y) x) +
        K * (∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
          ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2))
    (hI4.const_mul (θ / 2)) hg measurableSet_ball hpw
  rw [integral_const_mul, integral_add hDint'.integrableOn (hS.const_mul K),
    integral_const_mul, hDB] at hmono
  have hP2 : (∫ x in Metric.ball x₀ (2 * ρ), χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2) ≤
      2 * K / θ * ∫ x in Metric.ball x₀ (2 * ρ), (∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
        ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2) := by
    rw [div_mul_eq_mul_div, le_div_iff₀ hθ]
    linarith
  
  have hL : (∫ x in Metric.ball x₀ ρ, ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2) ≤
      ∫ x in Metric.ball x₀ (2 * ρ), χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2 := by
    have e : (∫ x in Metric.ball x₀ ρ, ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2) =
        ∫ x in Metric.ball x₀ ρ, χ x ^ 2 * ∑ k : Fin 2, (pd2 k (pd2 n u) x) ^ 2 := by
      refine setIntegral_congr_fun measurableSet_ball (fun x hx => ?_)
      simp only [hχ1 x hx, one_pow, one_mul]
    rw [e]
    refine setIntegral_mono_set hI4 (ae_of_all _ (fun x => ?_)) hBρB.eventuallyLE
    simp only [Pi.zero_apply]
    positivity
  
  have hR' : (∫ x in Metric.ball x₀ (2 * ρ), (∑ k : Fin 2, (pd2 k u x) ^ 2 + Ψ x ^ 2 +
        ∑ a : Fin 2, ∑ k : Fin 2, (pd2 k (R a) x) ^ 2)) =
      (∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, (pd2 k u x) ^ 2) +
        (∫ x in Metric.ball x₀ (2 * ρ), Ψ x ^ 2) +
        ∑ a : Fin 2, ∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, (pd2 k (R a) x) ^ 2 := by
    rw [integral_add hI12 hI3', integral_add hI1 hI2,
      integral_finset_sum _ (fun a _ => hI3 a)]
  rw [← hR']
  exact hL.trans hP2

theorem elr_moll_L1 (g : E2 → ℝ) (hg : Integrable g volume) (η : ℕ → E2 → ℝ) (hηc : ∀ j, Continuous (η j)) (hη0 : ∀ j y, 0 ≤ η j y) (hη1 : ∀ j, ∫ y, η j y = 1) (δ : ℕ → ℝ) (hδ : Tendsto δ atTop (𝓝 0)) (hηs : ∀ j (y : E2), δ j ≤ ‖y‖ → η j y = 0) : (∀ j, Integrable (fun x => (∫ t, η j t * g (x - t)) - g x) volume) ∧ Tendsto (fun j => ∫ x, |(∫ t, η j t * g (x - t)) - g x|) atTop (𝓝 0) :=
by
  
  have hconv : ∀ (k ζ : E2 → ℝ), (fun x => ∫ t, ζ t * k (x - t)) =
      convolution ζ k (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    intro k ζ
    funext x
    rw [convolution_def]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  
  have contract : ∀ (ζ : E2 → ℝ), Continuous ζ → (∀ y, 0 ≤ ζ y) → (∫ y, ζ y = 1) →
      ∀ r : ℝ, (∀ y : E2, r ≤ ‖y‖ → ζ y = 0) → ∀ h : E2 → ℝ, Integrable h volume →
      (∀ x : E2, Integrable (fun t => ζ t * h (x - t)) volume) ∧
      Integrable (fun x => ∫ t, ζ t * h (x - t)) volume ∧
      ∫ x, |∫ t, ζ t * h (x - t)| ≤ ∫ x, |h x| := by
    intro ζ hc h0 h1 r hs h hh
    have hcs : HasCompactSupport ζ := by
      refine HasCompactSupport.intro (isCompact_closedBall (0 : E2) r) ?_
      intro y hy
      apply hs
      rw [mem_closedBall_zero_iff] at hy
      exact le_of_lt (not_le.mp hy)
    have hζi : Integrable ζ volume := hc.integrable_of_hasCompactSupport hcs
    obtain ⟨C, hC⟩ := hc.bounded_above_of_compact_support hcs
    have hi : ∀ x : E2, Integrable (fun t => ζ t * h (x - t)) volume := by
      intro x
      exact (hh.comp_sub_left x).bdd_mul hc.aestronglyMeasurable (Eventually.of_forall hC)
    have hTi : ∀ k : E2 → ℝ, Integrable k volume →
        Integrable (fun x => ∫ t, ζ t * k (x - t)) volume := by
      intro k hk
      rw [hconv k ζ]
      exact hζi.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hk
    refine ⟨hi, hTi h hh, ?_⟩
    have hpt : ∀ x, |∫ t, ζ t * h (x - t)| ≤ ∫ t, ζ t * |h (x - t)| := by
      intro x
      rw [← Real.norm_eq_abs]
      refine (norm_integral_le_integral_norm _).trans (le_of_eq ?_)
      refine integral_congr_ae (Eventually.of_forall fun t => ?_)
      simp only [norm_mul, Real.norm_eq_abs, abs_of_nonneg (h0 t)]
    have e : (fun x => ∫ t, ζ t * |h (x - t)|) =
        convolution ζ (fun y => |h y|) (ContinuousLinearMap.lsmul ℝ ℝ) volume :=
      hconv (fun y => |h y|) ζ
    have hHi : Integrable (fun x => ∫ t, ζ t * |h (x - t)|) volume := hTi (fun y => |h y|) hh.abs
    have hH : ∫ x, (∫ t, ζ t * |h (x - t)|) = ∫ x, |h x| := by
      rw [e, integral_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hζi hh.abs]
      rw [ContinuousLinearMap.lsmul_apply, smul_eq_mul, h1, one_mul]
    calc ∫ x, |∫ t, ζ t * h (x - t)| ≤ ∫ x, (∫ t, ζ t * |h (x - t)|) :=
          integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _) hHi
            (Eventually.of_forall hpt)
      _ = ∫ x, |h x| := hH
  
  have cc : ∀ γ : E2 → ℝ, Continuous γ → HasCompactSupport γ →
      Tendsto (fun j => ∫ x, |(∫ t, η j t * γ (x - t)) - γ x|) atTop (𝓝 0) := by
    intro γ hγc hγs
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨T, hT⟩ := (Metric.isBounded_iff_subset_closedBall (0 : E2)).1 hγs.isCompact.isBounded
    have hSm : MeasurableSet (closedBall (0 : E2) (T + 1)) := isClosed_closedBall.measurableSet
    have hSf : volume (closedBall (0 : E2) (T + 1)) < ⊤ := measure_closedBall_lt_top
    have hV0 : 0 ≤ volume.real (closedBall (0 : E2) (T + 1)) := measureReal_nonneg
    obtain ⟨ε', hε'0, hVε⟩ : ∃ ε' : ℝ, 0 < ε' ∧ volume.real (closedBall (0 : E2) (T + 1)) * ε' < ε := by
      refine ⟨ε / (2 * (volume.real (closedBall (0 : E2) (T + 1)) + 1)), by positivity, ?_⟩
      rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
      nlinarith
    obtain ⟨ρ, hρ, hργ⟩ :=
      Metric.uniformContinuous_iff.1 (hγs.uniformContinuous_of_continuous hγc) ε' hε'0
    filter_upwards [hδ.eventually_lt_const (lt_min hρ one_pos)] with j hj
    have hjρ : δ j < ρ := lt_of_lt_of_le hj (min_le_left _ _)
    have hj1 : δ j < 1 := lt_of_lt_of_le hj (min_le_right _ _)
    have hγ0 : ∀ y, T < ‖y‖ → γ y = 0 := by
      intro y hy
      apply image_eq_zero_of_notMem_tsupport
      intro hmem
      have := hT hmem
      rw [mem_closedBall_zero_iff] at this
      linarith
    have hbd : ∀ x, |(∫ t, η j t * γ (x - t)) - γ x| ≤ ε' := by
      intro x
      have e := congrFun (hconv γ (η j)) x
      simp only at e
      rw [e, ← Real.dist_eq]
      refine dist_convolution_le (R := ρ) (le_of_lt hε'0) ?_ (hη0 j) (hη1 j)
        hγc.aestronglyMeasurable ?_
      · intro y hy
        rw [mem_ball_zero_iff]
        by_contra hc
        exact hy (hηs j y (le_trans hjρ.le (not_lt.mp hc)))
      · intro y hy
        exact (hργ (mem_ball.mp hy)).le
    have hvan : ∀ x, x ∉ closedBall (0 : E2) (T + 1) → |(∫ t, η j t * γ (x - t)) - γ x| = 0 := by
      intro x hx
      rw [mem_closedBall_zero_iff, not_le] at hx
      have h1 : γ x = 0 := hγ0 x (by linarith)
      have h2 : ∀ t, η j t * γ (x - t) = 0 := by
        intro t
        by_cases ht : δ j ≤ ‖t‖
        · rw [hηs j t ht, zero_mul]
        · push_neg at ht
          rw [hγ0 (x - t) ?_, mul_zero]
          have := norm_sub_norm_le x t
          linarith
      simp [h1, h2]
    have hle : ∀ x, |(∫ t, η j t * γ (x - t)) - γ x| ≤
        (closedBall (0 : E2) (T + 1)).indicator (fun _ => ε') x := by
      intro x
      by_cases hx : x ∈ closedBall (0 : E2) (T + 1)
      · rw [Set.indicator_of_mem hx]; exact hbd x
      · rw [Set.indicator_of_notMem hx, hvan x hx]
    have hint : Integrable ((closedBall (0 : E2) (T + 1)).indicator (fun _ : E2 => ε')) volume :=
      (integrable_indicator_iff hSm).2 (integrableOn_const hSf.ne)
    have hI : ∫ x, (closedBall (0 : E2) (T + 1)).indicator (fun _ : E2 => ε') x =
        volume.real (closedBall (0 : E2) (T + 1)) * ε' := by
      rw [integral_indicator hSm, setIntegral_const, smul_eq_mul]
    have hnn : 0 ≤ ∫ x, |(∫ t, η j t * γ (x - t)) - γ x| :=
      integral_nonneg (fun x => abs_nonneg _)
    have hmono := integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _) hint
      (Eventually.of_forall hle)
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn]
    linarith
  
  refine ⟨fun j => ((contract (η j) (hηc j) (hη0 j) (hη1 j) (δ j) (hηs j) g hg).2.1).sub hg, ?_⟩
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨γ, hγs, hγε, hγc, hγi⟩ :=
    hg.exists_hasCompactSupport_integral_sub_le (show (0 : ℝ) < ε / 4 by positivity)
  filter_upwards [(Metric.tendsto_nhds.1 (cc γ hγc hγs)) (ε / 4) (by positivity)] with j hj
  have hnn0 : 0 ≤ ∫ x, |(∫ t, η j t * γ (x - t)) - γ x| := integral_nonneg (fun x => abs_nonneg _)
  rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn0] at hj
  obtain ⟨ig, Tg, cg⟩ := contract (η j) (hηc j) (hη0 j) (hη1 j) (δ j) (hηs j) g hg
  obtain ⟨iγ, Tγ, cγ⟩ := contract (η j) (hηc j) (hη0 j) (hη1 j) (δ j) (hηs j) γ hγi
  obtain ⟨id, Td, cd⟩ := contract (η j) (hηc j) (hη0 j) (hη1 j) (δ j) (hηs j)
    (fun y => g y - γ y) (hg.sub hγi)
  have hlin : ∀ x, (∫ t, η j t * g (x - t)) - (∫ t, η j t * γ (x - t)) =
      ∫ t, η j t * (g (x - t) - γ (x - t)) := by
    intro x
    rw [← integral_sub (ig x) (iγ x)]
    congr 1
    funext t
    ring
  have hpt : ∀ x, |(∫ t, η j t * g (x - t)) - g x| ≤
      (|∫ t, η j t * (g (x - t) - γ (x - t))| + |(∫ t, η j t * γ (x - t)) - γ x|) +
        |γ x - g x| := by
    intro x
    rw [← hlin x]
    have e : (∫ t, η j t * g (x - t)) - g x =
        ((∫ t, η j t * g (x - t)) - (∫ t, η j t * γ (x - t))) +
          ((∫ t, η j t * γ (x - t)) - γ x) + (γ x - g x) := by ring
    rw [e]
    exact abs_add_three _ _ _
  have i1 : Integrable (fun x => |∫ t, η j t * (g (x - t) - γ (x - t))|) volume := Td.abs
  have i2 : Integrable (fun x => |(∫ t, η j t * γ (x - t)) - γ x|) volume := (Tγ.sub hγi).abs
  have i3 : Integrable (fun x => |γ x - g x|) volume := (hγi.sub hg).abs
  have i12 : Integrable (fun x => |∫ t, η j t * (g (x - t) - γ (x - t))| +
      |(∫ t, η j t * γ (x - t)) - γ x|) volume := i1.add i2
  have hmono : ∫ x, |(∫ t, η j t * g (x - t)) - g x| ≤
      ∫ x, ((|∫ t, η j t * (g (x - t) - γ (x - t))| + |(∫ t, η j t * γ (x - t)) - γ x|) +
        |γ x - g x|) :=
    integral_mono_of_nonneg (Eventually.of_forall fun x => abs_nonneg _) (i12.add i3)
      (Eventually.of_forall hpt)
  rw [integral_add i12 i3, integral_add i1 i2] at hmono
  have hgγ : ∫ x, |g x - γ x| ≤ ε / 4 := by simpa [Real.norm_eq_abs] using hγε
  have h3 : ∫ x, |γ x - g x| = ∫ x, |g x - γ x| := by
    congr 1
    funext x
    exact abs_sub_comm _ _
  have hnn : 0 ≤ ∫ x, |(∫ t, η j t * g (x - t)) - g x| := integral_nonneg (fun x => abs_nonneg _)
  rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn]
  have cd' : ∫ x, |∫ t, η j t * (g (x - t) - γ (x - t))| ≤ ∫ x, |g x - γ x| := cd
  linarith

theorem elr_moll_limit (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ) (φ : E2 → ℝ) (hφ : MemLp φ 2 (volume.restrict (Metric.closedBall x₀ (4 * ρ)))) (δ : ℕ → ℝ) (hδ0 : ∀ j, 0 < δ j) (hδ : Tendsto δ atTop (𝓝 0)) (η : ℕ → E2 → ℝ) (hη : ∀ j, ContDiff ℝ ∞ (η j)) (hηc : ∀ j, HasCompactSupport (η j)) (hη0 : ∀ j z, 0 ≤ η j z) (hηs : ∀ j z, δ j ≤ ‖z‖ → η j z = 0) (hη1 : ∀ j, (∫ z, η j z) = 1) (w : ℕ → E2 → ℝ) (hw : ∀ j, ContDiff ℝ ∞ (w j)) (hwφ : ∀ j, ∀ x ∈ Metric.ball x₀ ρ, w j x = ∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator φ y) (M : ℝ) (hM : ∀ j, (∫ x in Metric.ball x₀ ρ, ∑ k : Fin 2, (pd2 k (w j) x) ^ 2) ≤ M) : ∃ H : Fin 2 → E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ Metric.ball x₀ ρ → ∀ k, MemLp (H k) 2 (volume.restrict L)) ∧ ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball x₀ ρ → ∀ k : Fin 2, ∫ x, φ x * pd2 k ζ x = -(∫ x, H k x * ζ x) :=
by
  classical
  have hpdc : ∀ (u : E2 → ℝ), ContDiff ℝ ∞ u → ∀ k : Fin 2, Continuous (pd2 k u) := by
    intro u hu k
    exact (hu.continuous_fderiv (by simp)).clm_apply continuous_const
  
  have hbd : ∀ L : Set E2, IsCompact L → L ⊆ Metric.ball x₀ ρ →
      ∃ C : ℝ, ∀ n k, ∫ x in L, ((fun n k => pd2 k (w n)) n k x) ^ 2 ≤ C := by
    intro L hL hLB
    refine ⟨M, fun n k => ?_⟩
    have hS : Continuous (fun x => ∑ m : Fin 2, (pd2 m (w n) x) ^ 2) :=
      continuous_finset_sum _ (fun m _ => (hpdc _ (hw n) m).pow 2)
    have hg : Continuous (fun x => (pd2 k (w n) x) ^ 2) := (hpdc _ (hw n) k).pow 2
    have hSB : IntegrableOn (fun x => ∑ m : Fin 2, (pd2 m (w n) x) ^ 2) (Metric.ball x₀ ρ) :=
      (hS.continuousOn.integrableOn_compact (isCompact_closedBall x₀ ρ)).mono_set
        Metric.ball_subset_closedBall
    have h1 : ∫ x in L, (pd2 k (w n) x) ^ 2 ≤ ∫ x in L, ∑ m : Fin 2, (pd2 m (w n) x) ^ 2 :=
      setIntegral_mono (hg.continuousOn.integrableOn_compact hL)
        (hS.continuousOn.integrableOn_compact hL)
        (fun x => Finset.single_le_sum (f := fun m => (pd2 m (w n) x) ^ 2)
          (fun m _ => sq_nonneg _) (Finset.mem_univ k))
    have h2 : ∫ x in L, ∑ m : Fin 2, (pd2 m (w n) x) ^ 2 ≤
        ∫ x in Metric.ball x₀ ρ, ∑ m : Fin 2, (pd2 m (w n) x) ^ 2 :=
      setIntegral_mono_set hSB
        (ae_of_all _ (fun x => Finset.sum_nonneg (fun m _ => sq_nonneg _))) hLB.eventuallyLE
    exact h1.trans (h2.trans (hM n))
  obtain ⟨ψ, H, hψ, hHL2, hconv⟩ := l2loc_weak_subseq (Metric.ball x₀ ρ) Metric.isOpen_ball
    (fun n k => pd2 k (w n)) (fun n k => (hpdc _ (hw n) k).continuousOn) hbd
  refine ⟨H, hHL2, ?_⟩
  intro ζ hζ hζc hζB k
  
  have hDcont : Continuous (pd2 k ζ) := hpdc ζ hζ k
  have hsupp : Function.support (pd2 k ζ) ⊆ tsupport ζ := by
    intro x hx
    apply support_fderiv_subset ℝ
    rw [Function.mem_support]
    intro h0
    exact (Function.mem_support.mp hx) (by show fderiv ℝ ζ x (e2 k) = 0; rw [h0]; rfl)
  have hDc : HasCompactSupport (pd2 k ζ) := hζc.mono' hsupp
  have hDs : tsupport (pd2 k ζ) ⊆ Metric.ball x₀ ρ :=
    (closure_minimal hsupp (isClosed_tsupport ζ)).trans hζB
  
  have hBK : Metric.ball x₀ ρ ⊆ Metric.closedBall x₀ (4 * ρ) :=
    Metric.ball_subset_closedBall.trans (Metric.closedBall_subset_closedBall (by linarith))
  haveI : IsFiniteMeasure (volume.restrict (Metric.closedBall x₀ (4 * ρ))) :=
    isFiniteMeasure_restrict.2 (measure_closedBall_lt_top).ne
  have hφi : IntegrableOn φ (Metric.closedBall x₀ (4 * ρ)) := hφ.integrable one_le_two
  have hfi : Integrable ((Metric.closedBall x₀ (4 * ρ)).indicator φ) :=
    (integrable_indicator_iff measurableSet_closedBall).2 hφi
  obtain ⟨hint, hL1⟩ := elr_moll_L1 ((Metric.closedBall x₀ (4 * ρ)).indicator φ) hfi η
    (fun j => (hη j).continuous) hη0 hη1 δ hδ hηs
  have hwc : ∀ j, ∀ x ∈ Metric.ball x₀ ρ,
      w j x = ∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t) := by
    intro j x hx
    rw [hwφ j x hx]
    have := integral_sub_left_eq_self
      (fun t => η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) (μ := volume) x
    simp only [sub_sub_cancel] at this
    exact this
  obtain ⟨C, hC⟩ := hDcont.bounded_above_of_compact_support hDc
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC x₀)
  have I2 : ∀ j, Integrable (fun x => ((∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ
      (x - t)) - (Metric.closedBall x₀ (4 * ρ)).indicator φ x) * pd2 k ζ x) := by
    intro j
    exact (hint j).mul_bdd hDcont.aestronglyMeasurable (ae_of_all _ hC)
  have hkey : ∀ j, (∫ x, w j x * pd2 k ζ x) - ∫ x, φ x * pd2 k ζ x
      = ∫ x, ((∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
          (Metric.closedBall x₀ (4 * ρ)).indicator φ x) * pd2 k ζ x := by
    intro j
    have I1 : Integrable (fun x => w j x * pd2 k ζ x) :=
      ((hw j).continuous.mul hDcont).integrable_of_hasCompactSupport hDc.mul_left
    have hpt : (fun x => φ x * pd2 k ζ x) = fun x => w j x * pd2 k ζ x -
        ((∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
          (Metric.closedBall x₀ (4 * ρ)).indicator φ x) * pd2 k ζ x := by
      funext x
      by_cases hx : pd2 k ζ x = 0
      · simp [hx]
      · have hxB : x ∈ Metric.ball x₀ ρ := hDs (subset_tsupport _ (Function.mem_support.2 hx))
        rw [hwc j x hxB, Set.indicator_of_mem (hBK hxB)]
        ring
    rw [hpt, integral_sub I1 (I2 j)]
    ring
  have hP : Tendsto (fun j => ∫ x, w j x * pd2 k ζ x) atTop (𝓝 (∫ x, φ x * pd2 k ζ x)) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have hL1C := hL1.const_mul C
    rw [mul_zero] at hL1C
    refine squeeze_zero (fun j => norm_nonneg _) (fun j => ?_) hL1C
    rw [hkey j, Real.norm_eq_abs]
    calc |∫ x, ((∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
            (Metric.closedBall x₀ (4 * ρ)).indicator φ x) * pd2 k ζ x|
        ≤ ∫ x, |((∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
            (Metric.closedBall x₀ (4 * ρ)).indicator φ x) * pd2 k ζ x| :=
          abs_integral_le_integral_abs
      _ ≤ ∫ x, C * |(∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
            (Metric.closedBall x₀ (4 * ρ)).indicator φ x| := by
          refine integral_mono (I2 j).abs ((hint j).abs.const_mul C) (fun x => ?_)
          have hx := hC x
          rw [Real.norm_eq_abs] at hx
          simp only [abs_mul]
          rw [mul_comm C]
          exact mul_le_mul_of_nonneg_left hx (abs_nonneg _)
      _ = C * ∫ x, |(∫ t, η j t * (Metric.closedBall x₀ (4 * ρ)).indicator φ (x - t)) -
            (Metric.closedBall x₀ (4 * ρ)).indicator φ x| := integral_const_mul _ _
  
  have hibp : ∀ n, ∫ x, w n x * pd2 k ζ x = -(∫ x, pd2 k (w n) x * ζ x) :=
    fun n => ibp_open_test (Metric.ball x₀ ρ) Metric.isOpen_ball (w n) (hw n).contDiffOn
      ζ hζ hζc hζB k
  have h1 : Tendsto (fun m => ∫ x, w (ψ m) x * pd2 k ζ x) atTop (𝓝 (∫ x, φ x * pd2 k ζ x)) :=
    hP.comp hψ.tendsto_atTop
  have h2 : Tendsto (fun m => ∫ x, w (ψ m) x * pd2 k ζ x) atTop
      (𝓝 (-(∫ x, H k x * ζ x))) :=
    Tendsto.congr (fun m => (hibp (ψ m)).symm) (hconv k ζ hζ.continuous hζc hζB).neg
  exact tendsto_nhds_unique h1 h2

theorem elr_local_H2 (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (hApos : ∀ x ∈ U, (A x).PosDef) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (g : E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧ (∀ m, MemLp (G m) 2 (volume.restrict L)) ∧ MemLp g 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) (heq : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, ∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x = ∫ x, g x * ζ x) : ∀ x₀ ∈ U, ∃ r : ℝ, 0 < r ∧ Metric.ball x₀ r ⊆ U ∧ ∃ H : Fin 2 → Fin 2 → E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ Metric.ball x₀ r → ∀ n m, MemLp (H n m) 2 (volume.restrict L)) ∧ ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball x₀ r → ∀ n m : Fin 2, ∫ x, G n x * pd2 m ζ x = -(∫ x, H n m x * ζ x) :=
by
  intro x₀ hx₀
  
  obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x₀ hx₀
  obtain ⟨ρ, hρ, hρε⟩ : ∃ ρ : ℝ, 0 < ρ ∧ 5 * ρ = ε := ⟨ε / 5, by positivity, by ring⟩
  have hKU : Metric.closedBall x₀ (4 * ρ) ⊆ U :=
    (Metric.closedBall_subset_ball (by linarith)).trans hεU
  have hK3U : Metric.closedBall x₀ (3 * ρ) ⊆ U :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hKU
  have hB3K3 : Metric.ball x₀ (3 * ρ) ⊆ Metric.closedBall x₀ (3 * ρ) := Metric.ball_subset_closedBall
  have hB3U : Metric.ball x₀ (3 * ρ) ⊆ U := hB3K3.trans hK3U
  have hB1B3 : Metric.ball x₀ ρ ⊆ Metric.ball x₀ (3 * ρ) := Metric.ball_subset_ball (by linarith)
  have hB1U : Metric.ball x₀ ρ ⊆ U := hB1B3.trans hB3U
  have hKc : IsCompact (Metric.closedBall x₀ (4 * ρ)) := isCompact_closedBall _ _
  obtain ⟨-, hGK, -⟩ := hL2 _ hKc hKU
  
  obtain ⟨θ, Λ, Λ', hθ, -, hΛ'0, hell, hΛ, hΛ', hLip⟩ :=
    elr_ellip_consts U hU A hA hApos (Metric.closedBall x₀ (3 * ρ)) (isCompact_closedBall _ _)
      (convex_closedBall _ _) hK3U
  obtain ⟨C, hC0, hCacc⟩ := elr_caccioppoli x₀ ρ hρ A (fun a b => (hA a b).mono hB3U) θ Λ Λ' hθ
    (fun x hx => hell x (hB3K3 hx)) (fun x hx => hΛ x (hB3K3 hx)) (fun x hx => hΛ' x (hB3K3 hx))
  obtain ⟨Cη, -, hker⟩ := elr_moll_kernel
  
  have hδpos : ∀ j : ℕ, 0 < ρ * (1 / ((j : ℝ) + 1)) := fun j => by positivity
  have hδρ : ∀ j : ℕ, ρ * (1 / ((j : ℝ) + 1)) ≤ ρ := by
    intro j
    have h1 : 1 / ((j : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]
      linarith [(Nat.cast_nonneg j : (0 : ℝ) ≤ j)]
    exact mul_le_of_le_one_right hρ.le h1
  have hδlim : Tendsto (fun j : ℕ => ρ * (1 / ((j : ℝ) + 1))) atTop (𝓝 0) := by
    simpa using (tendsto_one_div_add_atTop_nhds_zero_nat).const_mul ρ
  choose η hηs hηc hη0 hηsupp hη1 hηd using
    fun j : ℕ => hker (ρ * (1 / ((j : ℝ) + 1))) (hδpos j)
  
  have hbound : ∀ (j : ℕ) (n : Fin 2),
      (∫ x in Metric.ball x₀ ρ, ∑ k : Fin 2, (pd2 k (pd2 n (fun x => ∫ y, η j (x - y) *
        (Metric.closedBall x₀ (4 * ρ)).indicator v y)) x) ^ 2) ≤
      C * ((∑ k : Fin 2, ∫ y in Metric.closedBall x₀ (4 * ρ), G k y ^ 2) +
        (∫ y in Metric.closedBall x₀ (4 * ρ), g y ^ 2) +
        ∑ a : Fin 2, 8 * Λ' ^ 2 * (Cη ^ 2 + 1) *
          ∑ b : Fin 2, ∫ y in Metric.closedBall x₀ (4 * ρ), G b y ^ 2) := by
    intro j n
    obtain ⟨hu, hΨ, hgr, hdiv, hI1, hI2⟩ :=
      elr_mollified_system U hU A hA v G g hL2 hgrad heq x₀ ρ hρ hKU _ (hδpos j) (hδρ j) (η j)
        (hηs j) (hηc j) (hη0 j) (hηsupp j) (hη1 j)
    have hRj := elr_moll_commutator U hU A hA G x₀ ρ hρ hKU hGK Λ' hΛ'0
      (fun x hx => hΛ' x (hB3K3 hx)) (fun x hx y hy => hLip x (hB3K3 hx) y (hB3K3 hy)) Cη _
      (hδpos j) (hδρ j) (η j) (hηs j) (hηc j) (hη0 j) (hηsupp j) (hη1 j) (hηd j)
    have heqn : ∀ x ∈ Metric.ball x₀ (3 * ρ), ∑ a : Fin 2, pd2 a (fun y =>
        ∑ b : Fin 2, A y a b * pd2 b (fun x => ∫ y, η j (x - y) *
          (Metric.closedBall x₀ (4 * ρ)).indicator v y) y +
        ((∫ z, η j (y - z) * (Metric.closedBall x₀ (4 * ρ)).indicator
            (fun y => ∑ b : Fin 2, A y a b * G b y) z) -
          ∑ b : Fin 2, A y a b * ∫ z, η j (y - z) *
            (Metric.closedBall x₀ (4 * ρ)).indicator (G b) z)) x =
        -(∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator g y) := by
      intro x hx
      rw [← hdiv x hx]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      have hev : (fun y =>
          ∑ b : Fin 2, A y a b * pd2 b (fun x => ∫ y, η j (x - y) *
            (Metric.closedBall x₀ (4 * ρ)).indicator v y) y +
          ((∫ z, η j (y - z) * (Metric.closedBall x₀ (4 * ρ)).indicator
              (fun y => ∑ b : Fin 2, A y a b * G b y) z) -
            ∑ b : Fin 2, A y a b * ∫ z, η j (y - z) *
              (Metric.closedBall x₀ (4 * ρ)).indicator (G b) z)) =ᶠ[𝓝 x]
          (fun y => ∫ z, η j (y - z) * (Metric.closedBall x₀ (4 * ρ)).indicator
              (fun y => ∑ b : Fin 2, A y a b * G b y) z) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hx] with y hy
        simp only [hgr y hy]
        ring
      exact congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 a)) hev.fderiv_eq
    have hcac := hCacc (fun x => ∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator v y)
      (fun a x => (∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator
          (fun y => ∑ b : Fin 2, A y a b * G b y) y) -
        ∑ b : Fin 2, A x a b * ∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y)
      (fun x => ∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator g y)
      hu (fun a => (hRj a).1) hΨ.continuous.continuousOn heqn n
    exact hcac.trans (mul_le_mul_of_nonneg_left
      (add_le_add (add_le_add hI1 hI2) (Finset.sum_le_sum fun a _ => (hRj a).2)) hC0)
  
  have hlim : ∀ n : Fin 2, ∃ Hn : Fin 2 → E2 → ℝ,
      (∀ L : Set E2, IsCompact L → L ⊆ Metric.ball x₀ ρ → ∀ k, MemLp (Hn k) 2 (volume.restrict L)) ∧
      ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball x₀ ρ →
        ∀ k : Fin 2, ∫ x, G n x * pd2 k ζ x = -(∫ x, Hn k x * ζ x) := by
    intro n
    refine elr_moll_limit x₀ ρ hρ (G n) (hGK n) _ hδpos hδlim η hηs hηc hη0 hηsupp hη1
      (fun j => pd2 n (fun x => ∫ y, η j (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator v y))
      ?_ ?_ _ (fun j => hbound j n)
    · intro j
      obtain ⟨hu, -⟩ :=
        elr_mollified_system U hU A hA v G g hL2 hgrad heq x₀ ρ hρ hKU _ (hδpos j) (hδρ j) (η j)
          (hηs j) (hηc j) (hη0 j) (hηsupp j) (hη1 j)
      have hfd := (contDiff_infty_iff_fderiv.1 hu).2
      exact hfd.clm_apply contDiff_const
    · intro j x hx
      obtain ⟨-, -, hgr, -⟩ :=
        elr_mollified_system U hU A hA v G g hL2 hgrad heq x₀ ρ hρ hKU _ (hδpos j) (hδρ j) (η j)
          (hηs j) (hηc j) (hη0 j) (hηsupp j) (hη1 j)
      exact hgr x (hB1B3 hx) n
  
  choose H hHL2 hHw using hlim
  exact ⟨ρ, hρ, hB1U, H, fun L hL hLB n m => hHL2 n L hL hLB m,
    fun ζ h1 h2 h3 n m => hHw n ζ h1 h2 h3 m⟩

theorem elr_weak_deriv_glue (U : Set E2) (hU : IsOpen U) (φ : E2 → ℝ) (hφ : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L)) (hloc : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ U ∧ ∃ H : Fin 2 → E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ Metric.ball x r → ∀ m, MemLp (H m) 2 (volume.restrict L)) ∧ ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball x r → ∀ m : Fin 2, ∫ y, φ y * pd2 m ζ y = -(∫ y, H m y * ζ y)) : ∃ H : Fin 2 → E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ U → ∀ m, MemLp (H m) 2 (volume.restrict L)) ∧ ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ y, φ y * pd2 m ζ y = -(∫ y, H m y * ζ y) :=
by
  classical
  choose! r hr hball Hx hHL2 hHw using hloc
  
  have hfin : ∀ K : Set E2, IsCompact K → IsFiniteMeasure (volume.restrict K) := by
    intro K hK
    exact ⟨by rw [Measure.restrict_apply_univ]; exact hK.measure_lt_top⟩
  
  have hint : ∀ K : Set E2, IsCompact K → ∀ f g : E2 → ℝ, MemLp f 2 (volume.restrict K) →
      Continuous g → tsupport g ⊆ K → Integrable (fun x => f x * g x) := by
    intro K hK f g hf hg hgK
    haveI := hfin K hK
    have hgc : HasCompactSupport g := hK.of_isClosed_subset (isClosed_tsupport g) hgK
    obtain ⟨C, hC⟩ := hg.bounded_above_of_compact_support hgc
    have h1 : IntegrableOn (fun x => f x * g x) K :=
      (hf.integrable one_le_two).mul_bdd hg.aestronglyMeasurable (Filter.Eventually.of_forall hC)
    refine (integrableOn_iff_integrable_of_support_subset ?_).mp h1
    intro x hx
    apply hgK
    apply subset_tsupport g
    intro h0
    apply hx
    simp [h0]
  
  have huniq : ∀ V : Set E2, IsOpen V → ∀ f₁ f₂ : E2 → ℝ,
      (∀ L : Set E2, IsCompact L → L ⊆ V → MemLp f₁ 2 (volume.restrict L)) →
      (∀ L : Set E2, IsCompact L → L ⊆ V → MemLp f₂ 2 (volume.restrict L)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ V →
        ∫ x, f₁ x * ζ x = ∫ x, f₂ x * ζ x) →
      ∀ᵐ x ∂(volume.restrict V), f₁ x = f₂ x := by
    intro V hV f₁ f₂ h₁ h₂ h
    have hli : LocallyIntegrableOn (fun x => f₁ x - f₂ x) V volume := by
      rw [locallyIntegrableOn_iff hV.isLocallyClosed]
      intro k hkV hk
      haveI := hfin k hk
      exact ((h₁ k hk hkV).sub (h₂ k hk hkV)).integrable one_le_two
    have hz := hV.ae_eq_zero_of_integral_contDiff_smul_eq_zero hli (fun g hg hgc hgV => by
      have i1 := hint _ hgc f₁ g (h₁ _ hgc hgV) hg.continuous subset_rfl
      have i2 := hint _ hgc f₂ g (h₂ _ hgc hgV) hg.continuous subset_rfl
      calc ∫ x, g x • (f₁ x - f₂ x) = ∫ x, (f₁ x * g x - f₂ x * g x) := by
            congr 1; funext x; rw [smul_eq_mul]; ring
        _ = 0 := by rw [integral_sub i1 i2, h g hg hgc hgV, sub_self])
    rw [ae_restrict_iff' hV.measurableSet]
    filter_upwards [hz] with x hx hxV
    exact sub_eq_zero.mp (hx hxV)
  
  have hov : ∀ m : Fin 2, ∀ x ∈ U, ∀ z ∈ U,
      ∀ᵐ y ∂(volume.restrict (ball x (r x) ∩ ball z (r z))), Hx x m y = Hx z m y := by
    intro m x hx z hz
    refine huniq _ (isOpen_ball.inter isOpen_ball) _ _
      (fun L hL hLs => hHL2 x hx L hL (hLs.trans Set.inter_subset_left) m)
      (fun L hL hLs => hHL2 z hz L hL (hLs.trans Set.inter_subset_right) m) ?_
    intro ζ hζ hζc hζs
    have e1 := hHw x hx ζ hζ hζc (hζs.trans Set.inter_subset_left) m
    have e2 := hHw z hz ζ hζ hζc (hζs.trans Set.inter_subset_right) m
    linarith
  
  obtain ⟨T, hTU, hTc, hTeq⟩ := TopologicalSpace.isOpen_biUnion_countable U
    (fun x => ball x (r x)) (fun x _ => isOpen_ball)
  haveI : Countable T := hTc.to_subtype
  obtain ⟨H, hHdef⟩ : ∃ H : Fin 2 → E2 → ℝ, ∀ m y, H m y =
      if h : ∃ x ∈ T, y ∈ ball x (r x) then Hx h.choose m y else 0 := ⟨_, fun _ _ => rfl⟩
  have hHae : ∀ m : Fin 2, ∀ i ∈ U, ∀ᵐ y ∂volume, y ∈ ball i (r i) → H m y = Hx i m y := by
    intro m i hi
    have hall : ∀ᵐ y ∂volume, ∀ x : T, y ∈ ball x.1 (r x.1) ∩ ball i (r i) →
        Hx x.1 m y = Hx i m y := by
      rw [ae_all_iff]
      intro x
      exact (ae_restrict_iff' (isOpen_ball.inter isOpen_ball).measurableSet).1
        (hov m x.1 (hTU x.2) i hi)
    filter_upwards [hall] with y hy hyi
    have hex : ∃ x ∈ T, y ∈ ball x (r x) := by
      have hmem : y ∈ ⋃ x ∈ U, ball x (r x) := Set.mem_biUnion hi hyi
      rw [← hTeq] at hmem
      obtain ⟨x, hxT, hyx⟩ := Set.mem_iUnion₂.1 hmem
      exact ⟨x, hxT, hyx⟩
    rw [hHdef, dif_pos hex]
    exact hy ⟨hex.choose, hex.choose_spec.1⟩ ⟨hex.choose_spec.2, hyi⟩
  
  have hL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → ∀ m, MemLp (H m) 2 (volume.restrict L) := by
    intro L hL hLU m
    have hunion : ∀ A B : Set E2, MeasurableSet A → MemLp (H m) 2 (volume.restrict A) →
        MemLp (H m) 2 (volume.restrict B) → MemLp (H m) 2 (volume.restrict (A ∪ B)) := by
      intro A B hA hMA hMB
      have h1 : MemLp (H m) 2 ((volume.restrict (A ∪ B)).restrict A) :=
        hMA.mono_measure (Measure.restrict_mono subset_rfl Measure.restrict_le_self)
      have h2 : MemLp (H m) 2 ((volume.restrict (A ∪ B)).restrict Aᶜ) := by
        rw [Measure.restrict_restrict hA.compl]
        refine hMB.mono_measure (Measure.restrict_mono ?_ le_rfl)
        intro y hy
        rcases hy.2 with h | h
        · exact absurd h hy.1
        · exact h
      have h3 := MemLp.piecewise hA h1 h2
      rwa [Set.piecewise_same] at h3
    obtain ⟨t, htL, hLt⟩ := hL.elim_nhds_subcover (fun x => closedBall x (r x / 2))
      (fun x hx => closedBall_mem_nhds x (half_pos (hr x (hLU hx))))
    have hpiece : ∀ x ∈ t, MemLp (H m) 2 (volume.restrict (L ∩ closedBall x (r x / 2))) := by
      intro x hx
      have hxU : x ∈ U := hLU (htL x hx)
      have hsub : L ∩ closedBall x (r x / 2) ⊆ ball x (r x) := by
        intro y hy
        have h1 : dist y x ≤ r x / 2 := hy.2
        have h2 := hr x hxU
        show dist y x < r x
        linarith
      have hM := hHL2 x hxU _ (hL.inter_right isClosed_closedBall) hsub m
      refine hM.ae_eq ?_
      have hae := ae_restrict_of_ae_restrict_of_subset hsub
        ((ae_restrict_iff' measurableSet_ball).2 (hHae m x hxU))
      filter_upwards [hae] with y hy
      exact hy.symm
    have hfinset : ∀ s : Finset E2, (∀ x ∈ s, x ∈ t) →
        MemLp (H m) 2 (volume.restrict (⋃ x ∈ s, L ∩ closedBall x (r x / 2))) := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · intro _
        simp [memLp_measure_zero]
      · intro a s ha ih hs
        rw [Finset.set_biUnion_insert]
        exact hunion _ _ (hL.inter_right isClosed_closedBall).isClosed.measurableSet
          (hpiece a (hs a (Finset.mem_insert_self a s)))
          (ih (fun x hx => hs x (Finset.mem_insert_of_mem hx)))
    refine (hfinset t (fun x hx => hx)).mono_measure (Measure.restrict_mono ?_ le_rfl)
    intro y hy
    obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 (hLt hy)
    exact Set.mem_iUnion₂.2 ⟨x, hx, hy, hyx⟩
  
  refine ⟨H, hL2, ?_⟩
  intro ζ hζ hζc hζU m
  have hK : IsCompact (tsupport ζ) := hζc
  obtain ⟨t, htK, hKt⟩ := hK.elim_nhds_subcover (fun x => ball x (r x))
    (fun x hx => ball_mem_nhds x (hr x (hζU hx)))
  have hcov : tsupport ζ ⊆ ⋃ i : t, ball i.1 (r i.1) := by
    intro y hy
    obtain ⟨x, hx, hyx⟩ := Set.mem_iUnion₂.1 (hKt hy)
    exact Set.mem_iUnion.2 ⟨⟨x, hx⟩, hyx⟩
  obtain ⟨ρ, hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E2) (isClosed_tsupport ζ)
    (fun i : t => ball i.1 (r i.1)) (fun i => isOpen_ball) hcov
  have hρs : ∀ i : t, ContDiff ℝ ∞ (ρ i) := fun i => contMDiff_iff_contDiff.mp (ρ i).contMDiff
  obtain ⟨ζs, hζs⟩ : ∃ ζs : t → E2 → ℝ, ∀ i y, ζs i y = ρ i y * ζ y := ⟨_, fun _ _ => rfl⟩
  have hζs' : ∀ i, ζs i = fun y => ρ i y * ζ y := fun i => funext (hζs i)
  have hζs_smooth : ∀ i, ContDiff ℝ ∞ (ζs i) := by
    intro i; rw [hζs' i]; exact (hρs i).mul hζ
  have hζs_supp : ∀ i, tsupport (ζs i) ⊆ tsupport ζ := by
    intro i; rw [hζs' i]; exact tsupport_mul_subset_right
  have hζs_ball : ∀ i : t, tsupport (ζs i) ⊆ ball i.1 (r i.1) := by
    intro i; rw [hζs' i]; exact tsupport_mul_subset_left.trans (hρ i)
  have hζs_cpt : ∀ i, HasCompactSupport (ζs i) := fun i =>
    hK.of_isClosed_subset (isClosed_tsupport _) (hζs_supp i)
  have hsum : ∀ y, ζ y = ∑ i, ζs i y := by
    intro y
    by_cases hy : y ∈ tsupport ζ
    · have h1 := ρ.sum_eq_one hy
      rw [finsum_eq_sum_of_fintype] at h1
      simp only [hζs]
      rw [← Finset.sum_mul, h1, one_mul]
    · simp [hζs, image_eq_zero_of_notMem_tsupport hy]
  have hζfun : ζ = fun y => ∑ i, ζs i y := funext hsum
  have hpd : ∀ y, pd2 m ζ y = ∑ i, pd2 m (ζs i) y := by
    intro y
    unfold pd2
    rw [hζfun, fderiv_fun_sum (fun i _ => ((hζs_smooth i).differentiable (by simp)) y),
      ContinuousLinearMap.sum_apply]
  have hφK := hφ _ hK hζU
  have hHK := hL2 _ hK hζU m
  have hdcont : ∀ i, Continuous (pd2 m (ζs i)) := fun i =>
    ((hζs_smooth i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hdsupp : ∀ i, tsupport (pd2 m (ζs i)) ⊆ tsupport ζ := by
    intro i
    refine (closure_minimal ?_ (isClosed_tsupport (ζs i))).trans (hζs_supp i)
    intro x hx
    apply support_fderiv_subset ℝ
    rw [Function.mem_support]
    intro h0
    exact (Function.mem_support.mp hx) (by show fderiv ℝ (ζs i) x (e2 m) = 0; rw [h0]; rfl)
  have i1 : ∀ i, Integrable (fun y => φ y * pd2 m (ζs i) y) := fun i =>
    hint _ hK φ _ hφK (hdcont i) (hdsupp i)
  have i2 : ∀ i, Integrable (fun y => H m y * ζs i y) := fun i =>
    hint _ hK (H m) _ hHK (hζs_smooth i).continuous (hζs_supp i)
  have hloc_i : ∀ i : t, ∫ y, φ y * pd2 m (ζs i) y = -(∫ y, H m y * ζs i y) := by
    intro i
    have hiU : i.1 ∈ U := hζU (htK i.1 i.2)
    rw [hHw i.1 hiU (ζs i) (hζs_smooth i) (hζs_cpt i) (hζs_ball i) m]
    congr 1
    refine integral_congr_ae ?_
    filter_upwards [hHae m i.1 hiU] with y hy
    by_cases hyb : y ∈ ball i.1 (r i.1)
    · rw [hy hyb]
    · have h0 : ζs i y = 0 := image_eq_zero_of_notMem_tsupport (fun h => hyb (hζs_ball i h))
      simp [h0]
  calc ∫ y, φ y * pd2 m ζ y = ∫ y, ∑ i, φ y * pd2 m (ζs i) y := by
        congr 1; funext y; rw [hpd y, Finset.mul_sum]
    _ = ∑ i, ∫ y, φ y * pd2 m (ζs i) y := integral_finset_sum _ (fun i _ => i1 i)
    _ = ∑ i, -(∫ y, H m y * ζs i y) := Finset.sum_congr rfl (fun i _ => hloc_i i)
    _ = -(∑ i, ∫ y, H m y * ζs i y) := Finset.sum_neg_distrib _
    _ = -(∫ y, ∑ i, H m y * ζs i y) := by rw [integral_finset_sum _ (fun i _ => i2 i)]
    _ = -(∫ y, H m y * ζ y) := by congr 2; funext y; rw [hsum y, Finset.mul_sum]

theorem elr_sob_bootstrap (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (hApos : ∀ x ∈ U, (A x).PosDef) (q : E2 → ℝ) (hq : ContDiffOn ℝ ∞ q U) (k : ℕ) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (F : Fin 2 → E2 → ℝ) (f : E2 → ℝ) (hv : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧ ∀ m, MemLp (G m) 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) (hF : ∀ a : Fin 2, elrSob (k + 1) U (F a)) (hf : elrSob k U f) (heq : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) = ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x)) : elrSob (k + 2) U v :=
by
  
  have hunf : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob (j + 1) U φ ↔
      ((∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L)) ∧
        ∃ Gφ : Fin 2 → E2 → ℝ, (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
          tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, Gφ m x * ζ x)) ∧
          ∀ m : Fin 2, elrSob j U (Gφ m)) := fun _ _ => Iff.rfl
  
  have hmono : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob (j + 1) U φ → elrSob j U φ := by
    intro j
    induction j with
    | zero =>
      intro φ h
      exact ((hunf 0 φ).1 h).1
    | succ j ih =>
      intro φ h
      obtain ⟨hL2, Gφ, hw, hG⟩ := (hunf (j + 1) φ).1 h
      exact (hunf j φ).2 ⟨hL2, Gφ, hw, fun m => ih (Gφ m) (hG m)⟩
  
  have hzero : ∀ n : ℕ, elrSob n U (fun _ => (0 : ℝ)) := by
    intro n
    induction n with
    | zero =>
      intro L _ _
      exact MeasureTheory.MemLp.zero
    | succ n ih =>
      refine (hunf n _).2 ⟨fun L _ _ => MeasureTheory.MemLp.zero, fun _ _ => (0 : ℝ), ?_, fun _ => ih⟩
      intro ζ _ _ _ m
      simp
  
  have hL2of : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob j U φ →
      ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L) := by
    intro j φ h
    cases j with
    | zero => exact h
    | succ j => exact ((hunf j φ).1 h).1
  
  have hpd : ∀ ψ : E2 → ℝ, ContDiffOn ℝ ∞ ψ U → ∀ m : Fin 2, ContDiffOn ℝ ∞ (pd2 m ψ) U := by
    intro ψ hψ m
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hψ).2
    exact h1.clm_apply contDiffOn_const
  
  have hlin : ∀ (j : ℕ) (φ₁ φ₂ : E2 → ℝ) (c₁ c₂ : ℝ), elrSob j U φ₁ → elrSob j U φ₂ →
      elrSob j U (fun x => c₁ * φ₁ x + c₂ * φ₂ x) := by
    intro j
    induction j with
    | zero =>
      intro φ₁ φ₂ c₁ c₂ h₁ h₂ L hL hLU
      exact ((h₁ L hL hLU).const_mul c₁).add ((h₂ L hL hLU).const_mul c₂)
    | succ j ih =>
      intro φ₁ φ₂ c₁ c₂ h₁ h₂
      obtain ⟨hL₁, G₁, hw₁, hG₁⟩ := (hunf j φ₁).1 h₁
      obtain ⟨hL₂, G₂, hw₂, hG₂⟩ := (hunf j φ₂).1 h₂
      refine (hunf j _).2 ⟨fun L hL hLU =>
        ((hL₁ L hL hLU).const_mul c₁).add ((hL₂ L hL hLU).const_mul c₂),
        fun m x => c₁ * G₁ m x + c₂ * G₂ m x, ?_, fun m => ih _ _ _ _ (hG₁ m) (hG₂ m)⟩
      intro ζ hζ hζc hζU m
      have hK : IsCompact (tsupport ζ) := hζc
      have hP := (l2_compact_pairing (tsupport ζ) hK).2.1
      have hζcont : Continuous ζ := hζ.continuous
      have hdc : Continuous (pd2 m ζ) :=
        (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
      have hds : tsupport (pd2 m ζ) ⊆ tsupport ζ := by
        refine closure_minimal ?_ (isClosed_tsupport ζ)
        intro x hx
        apply support_fderiv_subset ℝ
        rw [Function.mem_support]
        intro h0
        exact (Function.mem_support.mp hx) (by show fderiv ℝ ζ x (e2 m) = 0; rw [h0]; rfl)
      have i1 := hP φ₁ (pd2 m ζ) (hL₁ _ hK hζU) hdc hds
      have i2 := hP φ₂ (pd2 m ζ) (hL₂ _ hK hζU) hdc hds
      have j1 := hP (G₁ m) ζ (hL2of j _ (hG₁ m) _ hK hζU) hζcont subset_rfl
      have j2 := hP (G₂ m) ζ (hL2of j _ (hG₂ m) _ hK hζU) hζcont subset_rfl
      have e1 := hw₁ ζ hζ hζc hζU m
      have e2 := hw₂ ζ hζ hζc hζU m
      calc ∫ x, (c₁ * φ₁ x + c₂ * φ₂ x) * pd2 m ζ x
          = ∫ x, (c₁ * (φ₁ x * pd2 m ζ x) + c₂ * (φ₂ x * pd2 m ζ x)) := by
            congr 1; funext x; ring
        _ = c₁ * (∫ x, φ₁ x * pd2 m ζ x) + c₂ * (∫ x, φ₂ x * pd2 m ζ x) := by
            rw [integral_add (i1.const_mul c₁) (i2.const_mul c₂), integral_const_mul,
              integral_const_mul]
        _ = -(c₁ * (∫ x, G₁ m x * ζ x) + c₂ * (∫ x, G₂ m x * ζ x)) := by
            rw [e1, e2]; ring
        _ = -(∫ x, (c₁ * (G₁ m x * ζ x) + c₂ * (G₂ m x * ζ x))) := by
            rw [integral_add (j1.const_mul c₁) (j2.const_mul c₂), integral_const_mul,
              integral_const_mul]
        _ = -(∫ x, (c₁ * G₁ m x + c₂ * G₂ m x) * ζ x) := by
            congr 2; funext x; ring
  
  have hgain : ∀ (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (F : Fin 2 → E2 → ℝ) (f : E2 → ℝ),
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧
        ∀ m, MemLp (G m) 2 (volume.restrict L)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) →
      (∀ a : Fin 2, elrSob 1 U (F a)) → elrSob 0 U f →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) =
          ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x)) →
      ∃ H : Fin 2 → Fin 2 → E2 → ℝ,
        (∀ L : Set E2, IsCompact L → L ⊆ U → ∀ n m, MemLp (H n m) 2 (volume.restrict L)) ∧
        ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
          ∀ n m : Fin 2, ∫ x, G n x * pd2 m ζ x = -(∫ x, H n m x * ζ x) := by
    intro v G F f hv hgrad hF1 hf0 heq
    have hF1' := fun a => (hunf 0 (F a)).1 (hF1 a)
    choose hFL2 DF hDFw hDF0 using hF1'
    obtain ⟨hgL2, heq'⟩ := elr_rhs_reduce U hU A hA q hq v G F DF f
      (fun L hL hLU => ⟨(hv L hL hLU).1, (hv L hL hLU).2, fun a => hFL2 a L hL hLU,
        fun a m => hDF0 a m L hL hLU, hf0 L hL hLU⟩)
      (fun ζ h1 h2 h3 a m => hDFw a ζ h1 h2 h3 m) heq
    have hloc := elr_local_H2 U hU A hA hApos v G
      (fun x => q x * v x + f x - ∑ a : Fin 2, DF a a x)
      (fun L hL hLU => ⟨(hv L hL hLU).1, (hv L hL hLU).2, hgL2 L hL hLU⟩) hgrad heq'
    have hglob : ∀ n : Fin 2, ∃ Hn : Fin 2 → E2 → ℝ,
        (∀ L : Set E2, IsCompact L → L ⊆ U → ∀ m, MemLp (Hn m) 2 (volume.restrict L)) ∧
        ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
          ∀ m : Fin 2, ∫ y, G n y * pd2 m ζ y = -(∫ y, Hn m y * ζ y) := by
      intro n
      refine elr_weak_deriv_glue U hU (G n) (fun L hL hLU => (hv L hL hLU).2 n) ?_
      intro x hx
      obtain ⟨r, hr, hball, H, hHL2, hHw⟩ := hloc x hx
      exact ⟨r, hr, hball, H n, fun L hL hLB m => hHL2 L hL hLB n m,
        fun ζ h1 h2 h3 m => hHw ζ h1 h2 h3 n m⟩
    choose H hHL2 hHw using hglob
    exact ⟨H, fun L hL hLU n m => hHL2 n L hL hLU m, fun ζ h1 h2 h3 n m => hHw n ζ h1 h2 h3 m⟩
  
  have key : ∀ (k : ℕ) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (F : Fin 2 → E2 → ℝ) (f : E2 → ℝ),
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧
        ∀ m, MemLp (G m) 2 (volume.restrict L)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) →
      (∀ a : Fin 2, elrSob (k + 1) U (F a)) → elrSob k U f →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) =
          ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x)) →
      elrSob (k + 2) U v := by
    intro k
    induction k with
    | zero =>
      intro v G F f hv hgrad hF hf heq
      obtain ⟨H, hHL2, hHw⟩ := hgain v G F f hv hgrad hF hf heq
      refine (hunf 1 v).2 ⟨fun L hL hLU => (hv L hL hLU).1, G, hgrad, fun n => ?_⟩
      exact (hunf 0 (G n)).2 ⟨fun L hL hLU => (hv L hL hLU).2 n, H n,
        fun ζ h1 h2 h3 m => hHw ζ h1 h2 h3 n m, fun m L hL hLU => hHL2 L hL hLU n m⟩
    | succ k ih =>
      intro v G F f hv hgrad hF hf heq
      
      have hv2 : elrSob (k + 2) U v :=
        ih v G F f hv hgrad (fun a => hmono _ _ (hF a)) (hmono _ _ hf) heq
      
      have hGk : ∀ m, elrSob (k + 1) U (G m) :=
        elr_sob_grad_any (k + 1) U hU v hv2 G (fun L hL hLU m => (hv L hL hLU).2 m) hgrad
      
      have hGk' := fun m => (hunf k (G m)).1 (hGk m)
      choose hGL2 H hHw hHk using hGk'
      
      have hF' := fun a => (hunf (k + 1) (F a)).1 (hF a)
      choose hFL2 DF hDFw hDFk using hF'
      
      have hL2all : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧
          (∀ m, MemLp (G m) 2 (volume.restrict L)) ∧
          (∀ n m, MemLp (H n m) 2 (volume.restrict L)) ∧
          (∀ a, MemLp (F a) 2 (volume.restrict L)) ∧
          (∀ a m, MemLp (DF a m) 2 (volume.restrict L)) ∧ MemLp f 2 (volume.restrict L) :=
        fun L hL hLU => ⟨(hv L hL hLU).1, (hv L hL hLU).2,
          fun n m => hL2of k _ (hHk n m) L hL hLU, fun a => hFL2 a L hL hLU,
          fun a m => hL2of (k + 1) _ (hDFk a m) L hL hLU, hL2of (k + 1) f hf L hL hLU⟩
      have hdeq := fun m => elr_deriv_eq U hU A hA q hq v G H F DF f hL2all hgrad
        (fun ζ h1 h2 h3 n m => hHw n ζ h1 h2 h3 m) (fun ζ h1 h2 h3 a m => hDFw a ζ h1 h2 h3 m)
        heq m
      
      have hFt : ∀ m a : Fin 2, elrSob (k + 1) U (fun x => DF a m x -
          ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x - (if a = m then f x else 0)) := by
        intro m a
        have t2 : ∀ b : Fin 2, elrSob (k + 1) U (fun x => pd2 m (fun y => A y a b) x * G b x) :=
          fun b => elr_sob_mul_smooth (k + 1) U hU _ (hpd _ (hA a b) m) (G b) (hGk b)
        have tS : elrSob (k + 1) U
            (fun x => ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x) := by
          have h := hlin (k + 1) _ _ 1 1 (t2 0) (t2 1)
          convert h using 1
          funext x
          simp [Fin.sum_univ_two]
        have tI : elrSob (k + 1) U (fun x => if a = m then f x else 0) := by
          by_cases h : a = m
          · simpa [h] using hf
          · simpa [h] using hzero (k + 1)
        have h := hlin (k + 1) _ _ 1 (-1)
          (hlin (k + 1) _ _ 1 (-1) (hDFk a m) tS) tI
        convert h using 1
        funext x
        ring
      have hft : ∀ m : Fin 2, elrSob k U (fun x => pd2 m q x * v x) := fun m =>
        elr_sob_mul_smooth k U hU _ (hpd q hq m) v (hmono k v (hmono (k + 1) v hv2))
      
      have hGm : ∀ m : Fin 2, elrSob (k + 2) U (G m) := by
        intro m
        exact ih (G m) (H m)
          (fun a x => DF a m x - ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x -
            (if a = m then f x else 0))
          (fun x => pd2 m q x * v x)
          (fun L hL hLU => ⟨hGL2 m L hL hLU, fun b => hL2of k _ (hHk m b) L hL hLU⟩)
          (hHw m) (hFt m) (hft m) (hdeq m)
      
      exact (hunf (k + 2) v).2 ⟨fun L hL hLU => (hv L hL hLU).1, G, hgrad, hGm⟩
  exact key k v G F f hv hgrad hF hf heq

theorem elr_moll_transfer (U : Set E2) (K : Set E2) (hK : IsCompact K) (hKU : K ⊆ U) (f g : E2 → ℝ) (hf : IntegrableOn f K volume) (hg : IntegrableOn g K volume) (m : Fin 2) (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, f x * pd2 m ζ x = -(∫ x, g x * ζ x)) (η : E2 → ℝ) (hη : ContDiff ℝ ∞ η) (δ : ℝ) (hδ : 0 < δ) (hηs : ∀ y : E2, δ ≤ ‖y‖ → η y = 0) : ContDiff ℝ ∞ (fun z => ∫ t, η t * K.indicator f (z - t)) ∧ ∀ x : E2, Metric.closedBall x δ ⊆ K → pd2 m (fun z => ∫ t, η t * K.indicator f (z - t)) x = ∫ t, η t * K.indicator g (x - t) :=
by
  have hfo : Integrable (K.indicator f) volume :=
    (integrable_indicator_iff hK.measurableSet).2 hf
  have hloc : LocallyIntegrable (K.indicator f) volume := hfo.locallyIntegrable
  have hcη : HasCompactSupport η := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : E2) δ) (fun y hy => ?_)
    apply hηs
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hy
    exact hy.le
  have hconv : (fun z => ∫ t, η t * K.indicator f (z - t)) =
      MeasureTheory.convolution η (K.indicator f) (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext z
    rw [MeasureTheory.convolution_def]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  refine ⟨?_, ?_⟩
  · rw [hconv]
    exact hcη.contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) hη hloc
  · intro x hx
    have hD := hcη.hasFDerivAt_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ)
      (hη.of_le (by simp)) hloc x
    have hE := HasCompactSupport.convolutionExists_left
      (ContinuousLinearMap.precompL E2 (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ))
      (hcη.fderiv ℝ) (hη.continuous_fderiv (by simp)) hloc
    have hI := hE x
    unfold MeasureTheory.ConvolutionExistsAt at hI
    have hpd : pd2 m (fun z => ∫ t, η t * K.indicator f (z - t)) x =
        ∫ t, pd2 m η t * K.indicator f (x - t) := by
      unfold pd2
      rw [hconv, hD.fderiv, MeasureTheory.convolution_def,
        ContinuousLinearMap.integral_apply hI]
      simp only [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    obtain ⟨ζ, hζ⟩ : ∃ ζ : E2 → ℝ, ζ = fun y => η (x - y) := ⟨_, rfl⟩
    have hout : ∀ y, y ∉ K → δ < ‖x - y‖ := by
      intro y hy
      have h' : y ∉ Metric.closedBall x δ := fun h => hy (hx h)
      rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at h'
      exact h'
    have hvan : ∀ y, y ∉ Metric.closedBall x δ → ζ y = 0 := by
      intro y hy
      rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at hy
      rw [hζ]
      exact hηs _ hy.le
    have hζs : ContDiff ℝ ∞ ζ := by
      rw [hζ]
      exact hη.comp (contDiff_const.sub contDiff_id)
    have hζc : HasCompactSupport ζ := HasCompactSupport.intro (isCompact_closedBall x δ) hvan
    have hζt : tsupport ζ ⊆ Metric.closedBall x δ :=
      closure_minimal (Function.support_subset_iff'.2 hvan) Metric.isClosed_closedBall
    have hζd : ∀ y, pd2 m ζ y = -pd2 m η (x - y) := by
      intro y
      have h1 : HasFDerivAt η (fderiv ℝ η (x - y)) (x - y) :=
        ((hη.differentiable (by simp)) (x - y)).hasFDerivAt
      have h2 : HasFDerivAt (fun y' : E2 => x - y') (-ContinuousLinearMap.id ℝ E2) y := by
        simpa using (hasFDerivAt_id y).const_sub x
      have h3 := h1.comp y h2
      unfold pd2
      rw [show ζ = η ∘ (fun y' => x - y') from hζ, h3.fderiv]
      simp
    have hηt : tsupport η ⊆ Metric.closedBall 0 δ := by
      refine closure_minimal (Function.support_subset_iff'.2 fun y hy => ?_)
        Metric.isClosed_closedBall
      rw [Metric.mem_closedBall, dist_zero_right, not_le] at hy
      exact hηs _ hy.le
    have hηd : ∀ t, δ < ‖t‖ → pd2 m η t = 0 := by
      intro t ht
      have hnt : t ∉ tsupport (fderiv ℝ η) := by
        intro h
        have h' := hηt (tsupport_fderiv_subset ℝ h)
        rw [Metric.mem_closedBall, dist_zero_right] at h'
        linarith
      unfold pd2
      rw [image_eq_zero_of_notMem_tsupport hnt]
      rfl
    have hW := hweak ζ hζs hζc (hζt.trans (hx.trans hKU))
    rw [hpd]
    have e2' : ∫ t, pd2 m η t * K.indicator f (x - t) =
        ∫ y, pd2 m η (x - y) * K.indicator f y := by
      have h := MeasureTheory.integral_sub_left_eq_self
        (fun y => pd2 m η (x - y) * K.indicator f y) volume x
      simp only [sub_sub_cancel] at h
      exact h
    have e3 : (fun y => pd2 m η (x - y) * K.indicator f y) = fun y => -(f y * pd2 m ζ y) := by
      funext y
      by_cases hy : y ∈ K
      · rw [Set.indicator_of_mem hy, hζd]; ring
      · rw [Set.indicator_of_notMem hy, hζd, hηd _ (hout y hy)]; ring
    have e6 : (fun y => g y * ζ y) = fun y => η (x - y) * K.indicator g y := by
      funext y
      by_cases hy : y ∈ K
      · rw [Set.indicator_of_mem hy, hζ]; ring
      · simp only [Set.indicator_of_notMem hy, hζ, hηs _ (hout y hy).le, mul_zero]
    have e7 : ∫ y, η (x - y) * K.indicator g y = ∫ t, η t * K.indicator g (x - t) := by
      have h := MeasureTheory.integral_sub_left_eq_self
        (fun t => η t * K.indicator g (x - t)) volume x
      simp only [sub_sub_cancel] at h
      exact h
    rw [e2', e3, MeasureTheory.integral_neg, hW, neg_neg, e6, e7]

theorem elr_sup_local (x₀ : E2) (R : ℝ) (hR : 0 < R) : ∃ C : ℝ, 0 ≤ C ∧ ∀ ψ : E2 → ℝ, ContDiff ℝ ∞ ψ → ∀ x ∈ Metric.ball x₀ R, |ψ x| ≤ C * ((∫ y in Metric.ball x₀ (2 * R), |ψ y|) + (∫ y in Metric.ball x₀ (2 * R), |pd2 0 ψ y|) + (∫ y in Metric.ball x₀ (2 * R), |pd2 1 ψ y|) + (∫ y in Metric.ball x₀ (2 * R), |pd2 1 (pd2 0 ψ) y|)) :=
by
  
  have T_smooth : ∀ (f : E2 → ℝ), ContDiff ℝ ∞ f → ∀ k : Fin 2, ContDiff ℝ ∞ (pd2 k f) := by
    intro f hf k
    have h := (contDiff_infty_iff_fderiv.1 hf).2
    exact h.clm_apply contDiff_const
  
  have T_supp : ∀ (f : E2 → ℝ) (k : Fin 2), tsupport (pd2 k f) ⊆ tsupport f := by
    intro f k
    refine (closure_mono ?_).trans (tsupport_fderiv_subset ℝ)
    intro y hy
    simp only [Function.mem_support] at hy ⊢
    intro h0
    apply hy
    simp [pd2, h0]
  have T_hcs : ∀ (f : E2 → ℝ), HasCompactSupport f → ∀ k : Fin 2,
      HasCompactSupport (pd2 k f) := fun f hc k => hc.fderiv_apply (𝕜 := ℝ) (e2 k)
  
  have T_mul : ∀ (a b : E2 → ℝ), ContDiff ℝ ∞ a → ContDiff ℝ ∞ b → ∀ (k : Fin 2) (y : E2),
      pd2 k (fun z => a z * b z) y = pd2 k a y * b y + a y * pd2 k b y := by
    intro a b ha hb k y
    have hda : DifferentiableAt ℝ a y := (ha.differentiable (by simp)).differentiableAt
    have hdb : DifferentiableAt ℝ b y := (hb.differentiable (by simp)).differentiableAt
    show fderiv ℝ (a * b) y (e2 k) = fderiv ℝ a y (e2 k) * b y + a y * fderiv ℝ b y (e2 k)
    rw [fderiv_mul hda hdb]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have T_add : ∀ (p q : E2 → ℝ), ContDiff ℝ ∞ p → ContDiff ℝ ∞ q → ∀ (k : Fin 2) (y : E2),
      pd2 k (fun z => p z + q z) y = pd2 k p y + pd2 k q y := by
    intro p q hp hq k y
    have hdp : DifferentiableAt ℝ p y := (hp.differentiable (by simp)).differentiableAt
    have hdq : DifferentiableAt ℝ q y := (hq.differentiable (by simp)).differentiableAt
    show fderiv ℝ (p + q) y (e2 k) = fderiv ℝ p y (e2 k) + fderiv ℝ q y (e2 k)
    rw [fderiv_add hdp hdq]
    rfl
  
  have T_line : ∀ (f : E2 → ℝ), ContDiff ℝ ∞ f → HasCompactSupport f → ∀ (k : Fin 2) (x : E2),
      Integrable (fun s : ℝ => |pd2 k f (x + s • e2 k)|) ∧
        |f x| ≤ ∫ s : ℝ, |pd2 k f (x + s • e2 k)| := by
    intro f hf hc k x
    have hpc : Continuous (pd2 k f) := (T_smooth f hf k).continuous
    have hdf : Differentiable ℝ f := hf.differentiable (by simp)
    obtain ⟨T₀, hT₀⟩ := hc.isCompact.isBounded.subset_closedBall (0 : E2)
    obtain ⟨T, hTdef⟩ : ∃ T : ℝ, T = max T₀ 0 := ⟨_, rfl⟩
    have hT : tsupport f ⊆ closedBall (0 : E2) T :=
      hT₀.trans (closedBall_subset_closedBall (by rw [hTdef]; exact le_max_left _ _))
    have hT0 : 0 ≤ T := by rw [hTdef]; exact le_max_right _ _
    have hnorm : ∀ s : ℝ, |s| - ‖x‖ ≤ ‖x + s • e2 k‖ := by
      intro s
      have h1 : ‖s • e2 k‖ = |s| := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
      have h2 := norm_sub_le (x + s • e2 k) x
      rw [add_sub_cancel_left, h1] at h2
      linarith
    have hout : ∀ s : ℝ, T + ‖x‖ < |s| → x + s • e2 k ∉ tsupport f := by
      intro s hs hmem
      have h1 := hT hmem
      rw [mem_closedBall_zero_iff] at h1
      have h2 := hnorm s
      linarith
    have hzero : ∀ s : ℝ, T + ‖x‖ < |s| → f (x + s • e2 k) = 0 := fun s hs =>
      image_eq_zero_of_notMem_tsupport (hout s hs)
    have hzero' : ∀ s : ℝ, T + ‖x‖ < |s| → pd2 k f (x + s • e2 k) = 0 := fun s hs =>
      image_eq_zero_of_notMem_tsupport (fun h => hout s hs (T_supp f k h))
    have hgc : Continuous (fun s : ℝ => pd2 k f (x + s • e2 k)) :=
      hpc.comp (continuous_const.add (continuous_id.smul continuous_const))
    have hint : Integrable (fun s : ℝ => |pd2 k f (x + s • e2 k)|) := by
      refine hgc.abs.integrable_of_hasCompactSupport ?_
      refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) (T + ‖x‖)) ?_
      intro s hs
      rw [mem_closedBall_zero_iff, Real.norm_eq_abs, not_le] at hs
      rw [hzero' s hs, abs_zero]
    refine ⟨hint, ?_⟩
    have hderiv : ∀ s : ℝ, HasDerivAt (fun s : ℝ => f (x + s • e2 k))
        (pd2 k f (x + s • e2 k)) s := by
      intro s
      have hγ : HasDerivAt (fun s : ℝ => x + s • e2 k) (e2 k) s := by
        simpa using ((hasDerivAt_id s).smul_const (e2 k)).const_add x
      exact (hdf (x + s • e2 k)).hasFDerivAt.comp_hasDerivAt s hγ
    have hxn := norm_nonneg x
    have hA0 : -(T + ‖x‖ + 1) ≤ 0 := by linarith
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := -(T + ‖x‖ + 1)) (b := 0)
      (fun s _ => hderiv s) (hgc.intervalIntegrable _ _)
    have hfA : f (x + (-(T + ‖x‖ + 1)) • e2 k) = 0 := by
      apply hzero
      rw [abs_neg, abs_of_pos (by linarith)]
      linarith
    rw [hfA, zero_smul, add_zero, sub_zero] at hftc
    calc |f x| = |∫ s in (-(T + ‖x‖ + 1))..0, pd2 k f (x + s • e2 k)| := by rw [hftc]
      _ ≤ ∫ s in (-(T + ‖x‖ + 1))..0, |pd2 k f (x + s • e2 k)| :=
          intervalIntegral.abs_integral_le_integral_abs hA0
      _ = ∫ s in Set.Ioc (-(T + ‖x‖ + 1)) 0, |pd2 k f (x + s • e2 k)| :=
          intervalIntegral.integral_of_le hA0
      _ ≤ ∫ s, |pd2 k f (x + s • e2 k)| :=
          setIntegral_le_integral hint (Eventually.of_forall fun s => abs_nonneg _)
  
  have T_fub : ∀ (G : E2 → ℝ), Continuous G → HasCompactSupport G → ∀ x : E2,
      Integrable (fun s : ℝ => ∫ t : ℝ, G (x + s • e2 0 + t • e2 1)) ∧
        ∫ s : ℝ, ∫ t : ℝ, G (x + s • e2 0 + t • e2 1) = ∫ y, G y := by
    intro G hG hc x
    let Φ : E2 ≃ᵐ ℝ × ℝ :=
      (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow
    have hΦ : MeasurePreserving Φ volume volume :=
      (MeasureTheory.volume_preserving_finTwoArrow ℝ).comp
        (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2))
    have hΦs : MeasurePreserving Φ.symm volume volume := hΦ.symm Φ
    have hP : ∀ p : ℝ × ℝ, Φ.symm p = p.1 • e2 0 + p.2 • e2 1 := by
      intro p
      ext i
      fin_cases i <;> simp [Φ, e2, EuclideanSpace.single_apply] <;> rfl
    have hGi : Integrable G := hG.integrable_of_hasCompactSupport hc
    have hFi : Integrable (fun y => G (x + y)) := hGi.comp_add_left x
    have hFeq : ∫ y, G (x + y) = ∫ y, G y := integral_add_left_eq_self G x
    have hint : Integrable (fun p : ℝ × ℝ => G (x + Φ.symm p)) :=
      (hΦs.integrable_comp_emb Φ.symm.measurableEmbedding).2 hFi
    have h1 : ∫ p : ℝ × ℝ, G (x + Φ.symm p) = ∫ y, G (x + y) :=
      hΦs.integral_comp' (fun y => G (x + y))
    have h2 : ∫ p : ℝ × ℝ, G (x + Φ.symm p) = ∫ s, ∫ t, G (x + Φ.symm (s, t)) :=
      integral_prod _ hint
    have h3 := hint.integral_prod_left
    have hpt : ∀ s t : ℝ, G (x + Φ.symm (s, t)) = G (x + s • e2 0 + t • e2 1) := by
      intro s t
      rw [hP, add_assoc]
    rw [h1, hFeq] at h2
    simp only [hpt] at h2 h3
    exact ⟨h3, h2.symm⟩
  
  have hglob : ∀ φ : E2 → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∀ x : E2,
      |φ x| ≤ ∫ y, |pd2 1 (pd2 0 φ) y| := by
    intro φ hφ hφc x
    have hg₀ := T_smooth φ hφ 0
    have hg₀c := T_hcs φ hφc 0
    have hH := (T_smooth _ hg₀ 1).continuous
    have hHc := T_hcs _ hg₀c 1
    obtain ⟨hI₀, hb₀⟩ := T_line φ hφ hφc 0 x
    obtain ⟨hI₁, hfub⟩ := T_fub (fun y => |pd2 1 (pd2 0 φ) y|) hH.abs hHc.abs x
    have hpt : ∀ s : ℝ, |pd2 0 φ (x + s • e2 0)| ≤
        ∫ t, |pd2 1 (pd2 0 φ) (x + s • e2 0 + t • e2 1)| :=
      fun s => (T_line _ hg₀ hg₀c 1 (x + s • e2 0)).2
    calc |φ x| ≤ ∫ s : ℝ, |pd2 0 φ (x + s • e2 0)| := hb₀
      _ ≤ ∫ s : ℝ, ∫ t : ℝ, |pd2 1 (pd2 0 φ) (x + s • e2 0 + t • e2 1)| :=
          integral_mono hI₀ hI₁ hpt
      _ = ∫ y, |pd2 1 (pd2 0 φ) y| := hfub
  
  let b : ContDiffBump x₀ := ⟨R, 3 * R / 2, hR, by linarith⟩
  have hχ : ContDiff ℝ ∞ (⇑b : E2 → ℝ) := b.contDiff
  have hχc : HasCompactSupport (⇑b : E2 → ℝ) := b.hasCompactSupport
  have hχ1 : ∀ y ∈ ball x₀ R, b y = 1 := fun y hy =>
    b.one_of_mem_closedBall (ball_subset_closedBall hy)
  have hχs : tsupport (⇑b : E2 → ℝ) = closedBall x₀ (3 * R / 2) := b.tsupport_eq
  have hbd : ∀ F : E2 → ℝ, Continuous F → HasCompactSupport F → ∃ C, ∀ y, |F y| ≤ C := by
    intro F hF hFc
    obtain ⟨C, hC⟩ := hF.bounded_above_of_compact_support hFc
    exact ⟨C, fun y => by rw [← Real.norm_eq_abs]; exact hC y⟩
  obtain ⟨C₁, hC₁⟩ := hbd b hχ.continuous hχc
  obtain ⟨C₂, hC₂⟩ := hbd (pd2 0 b) (T_smooth b hχ 0).continuous (T_hcs b hχc 0)
  obtain ⟨C₃, hC₃⟩ := hbd (pd2 1 b) (T_smooth b hχ 1).continuous (T_hcs b hχc 1)
  obtain ⟨C₄, hC₄⟩ := hbd (pd2 1 (pd2 0 b)) (T_smooth _ (T_smooth b hχ 0) 1).continuous
    (T_hcs _ (T_hcs b hχc 0) 1)
  obtain ⟨M, hM⟩ : ∃ M : ℝ, M = max 0 (max (max C₁ C₂) (max C₃ C₄)) := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by rw [hM]; exact le_max_left _ _
  have hM1 : ∀ y, |b y| ≤ M := fun y => (hC₁ y).trans (by
    rw [hM]; exact le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) (le_max_right _ _))
  have hM2 : ∀ y, |pd2 0 b y| ≤ M := fun y => (hC₂ y).trans (by
    rw [hM]; exact le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) (le_max_right _ _))
  have hM3 : ∀ y, |pd2 1 b y| ≤ M := fun y => (hC₃ y).trans (by
    rw [hM]; exact le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) (le_max_right _ _))
  have hM4 : ∀ y, |pd2 1 (pd2 0 b) y| ≤ M := fun y => (hC₄ y).trans (by
    rw [hM]; exact le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (le_max_right _ _))
  refine ⟨M, hM0, ?_⟩
  
  intro ψ hψ x hx
  have hφ : ContDiff ℝ ∞ (fun z => b z * ψ z) := hχ.mul hψ
  have hφc : HasCompactSupport (fun z => b z * ψ z) := hχc.mul_right
  have hφx : b x * ψ x = ψ x := by rw [hχ1 x hx, one_mul]
  have hψ0 := T_smooth ψ hψ 0
  have hb0 := T_smooth b hχ 0
  
  have h0φ : pd2 0 (fun z => b z * ψ z) = fun z => pd2 0 b z * ψ z + b z * pd2 0 ψ z :=
    funext fun z => T_mul b ψ hχ hψ 0 z
  have hE : ∀ y, pd2 1 (pd2 0 (fun z => b z * ψ z)) y =
      pd2 1 (pd2 0 b) y * ψ y + pd2 0 b y * pd2 1 ψ y +
        (pd2 1 b y * pd2 0 ψ y + b y * pd2 1 (pd2 0 ψ) y) := by
    intro y
    rw [h0φ, T_add _ _ (hb0.mul hψ) (hχ.mul hψ0) 1 y, T_mul _ _ hb0 hψ 1 y,
      T_mul _ _ hχ hψ0 1 y]
  have hpw : ∀ y, |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| ≤
      M * (|ψ y| + |pd2 0 ψ y| + |pd2 1 ψ y| + |pd2 1 (pd2 0 ψ) y|) := by
    intro y
    rw [hE y]
    calc _ ≤ |pd2 1 (pd2 0 b) y * ψ y| + |pd2 0 b y * pd2 1 ψ y| +
          (|pd2 1 b y * pd2 0 ψ y| + |b y * pd2 1 (pd2 0 ψ) y|) :=
          (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) (abs_add_le _ _))
      _ = |pd2 1 (pd2 0 b) y| * |ψ y| + |pd2 0 b y| * |pd2 1 ψ y| +
          (|pd2 1 b y| * |pd2 0 ψ y| + |b y| * |pd2 1 (pd2 0 ψ) y|) := by
          simp only [abs_mul]
      _ ≤ M * |ψ y| + M * |pd2 1 ψ y| + (M * |pd2 0 ψ y| + M * |pd2 1 (pd2 0 ψ) y|) :=
          add_le_add (add_le_add (mul_le_mul_of_nonneg_right (hM4 y) (abs_nonneg _))
            (mul_le_mul_of_nonneg_right (hM2 y) (abs_nonneg _)))
            (add_le_add (mul_le_mul_of_nonneg_right (hM3 y) (abs_nonneg _))
            (mul_le_mul_of_nonneg_right (hM1 y) (abs_nonneg _)))
      _ = M * (|ψ y| + |pd2 0 ψ y| + |pd2 1 ψ y| + |pd2 1 (pd2 0 ψ) y|) := by ring
  have hsupp : tsupport (pd2 1 (pd2 0 (fun z => b z * ψ z))) ⊆ tsupport (⇑b : E2 → ℝ) :=
    (T_supp _ 1).trans ((T_supp _ 0).trans (tsupport_mul_subset_left))
  have hvan : ∀ y ∉ ball x₀ (2 * R), |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| = 0 := by
    intro y hy
    have hy' : y ∉ tsupport (pd2 1 (pd2 0 (fun z => b z * ψ z))) := by
      intro hm
      have h1 := hsupp hm
      rw [hχs, mem_closedBall] at h1
      rw [mem_ball, not_lt] at hy
      linarith
    rw [image_eq_zero_of_notMem_tsupport hy', abs_zero]
  have hrestr : ∫ y in ball x₀ (2 * R), |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| =
      ∫ y, |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| :=
    setIntegral_eq_integral_of_forall_compl_eq_zero hvan
  have hIB : ∀ F : E2 → ℝ, Continuous F → IntegrableOn F (ball x₀ (2 * R)) := fun F hF =>
    (hF.continuousOn.integrableOn_compact (isCompact_closedBall x₀ (2 * R))).mono_set
      ball_subset_closedBall
  have c0 := hψ.continuous
  have c1 := hψ0.continuous
  have c2 := (T_smooth ψ hψ 1).continuous
  have c3 := (T_smooth _ hψ0 1).continuous
  have cH := (T_smooth _ (T_smooth _ hφ 0) 1).continuous
  have hmono : ∫ y in ball x₀ (2 * R), |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| ≤
      ∫ y in ball x₀ (2 * R), M * (|ψ y| + |pd2 0 ψ y| + |pd2 1 ψ y| + |pd2 1 (pd2 0 ψ) y|) :=
    setIntegral_mono_on (hIB _ cH.abs)
      (hIB _ (continuous_const.mul (((c0.abs.add c1.abs).add c2.abs).add c3.abs)))
      measurableSet_ball (fun y _ => hpw y)
  have hlin : ∫ y in ball x₀ (2 * R), M * (|ψ y| + |pd2 0 ψ y| + |pd2 1 ψ y| + |pd2 1 (pd2 0 ψ) y|)
      = M * ((∫ y in Metric.ball x₀ (2 * R), |ψ y|) + (∫ y in Metric.ball x₀ (2 * R), |pd2 0 ψ y|)
        + (∫ y in Metric.ball x₀ (2 * R), |pd2 1 ψ y|)
        + (∫ y in Metric.ball x₀ (2 * R), |pd2 1 (pd2 0 ψ) y|)) := by
    rw [integral_const_mul, integral_add, integral_add, integral_add]
    · exact hIB _ c0.abs
    · exact hIB _ c1.abs
    · exact hIB _ (c0.abs.add c1.abs)
    · exact hIB _ c2.abs
    · exact hIB _ ((c0.abs.add c1.abs).add c2.abs)
    · exact hIB _ c3.abs
  calc |ψ x| = |b x * ψ x| := by rw [hφx]
    _ ≤ ∫ y, |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| := hglob _ hφ hφc x
    _ = ∫ y in ball x₀ (2 * R), |pd2 1 (pd2 0 (fun z => b z * ψ z)) y| := hrestr.symm
    _ ≤ _ := hmono
    _ = _ := hlin

theorem elr_unif_cauchy (B B₂ : Set E2) (hB₂ : IsOpen B₂) (C : ℝ) (hC : 0 ≤ C) (hsup : ∀ ψ : E2 → ℝ, ContDiff ℝ ∞ ψ → ∀ x ∈ B, |ψ x| ≤ C * ((∫ y in B₂, |ψ y|) + (∫ y in B₂, |pd2 0 ψ y|) + (∫ y in B₂, |pd2 1 ψ y|) + (∫ y in B₂, |pd2 1 (pd2 0 ψ) y|))) (F : ℕ → List (Fin 2) → E2 → ℝ) (hF : ∀ j w, ContDiff ℝ ∞ (F j w)) (hpd : ∀ j w (m : Fin 2), ∀ y ∈ B₂, pd2 m (F j w) y = F j (m :: w) y) (g : List (Fin 2) → E2 → ℝ) (hint : ∀ j w, Integrable (fun x => F j w x - g w x) volume) (hL1 : ∀ w, Tendsto (fun j => ∫ x, |F j w x - g w x|) atTop (𝓝 0)) : ∀ w, ∃ u : E2 → ℝ, TendstoUniformlyOn (fun j => F j w) u atTop B :=
by
  intro w
  
  have hd : ∀ (j k : ℕ) (v : List (Fin 2)) (m : Fin 2), ∀ y ∈ B₂,
      pd2 m (fun x => F j v x - F k v x) y = F j (m :: v) y - F k (m :: v) y := by
    intro j k v m y hy
    have h1 : DifferentiableAt ℝ (F j v) y :=
      ((hF j v).differentiable (by simp)).differentiableAt
    have h2 : DifferentiableAt ℝ (F k v) y :=
      ((hF k v).differentiable (by simp)).differentiableAt
    rw [← hpd j v m y hy, ← hpd k v m y hy]
    unfold pd2
    rw [show (fun x => F j v x - F k v x) = F j v - F k v from rfl, fderiv_sub h1 h2]
    rfl
  
  have hmix : ∀ (j k : ℕ), ∀ y ∈ B₂,
      pd2 1 (pd2 0 (fun x => F j w x - F k w x)) y
        = F j (1 :: 0 :: w) y - F k (1 :: 0 :: w) y := by
    intro j k y hy
    have hev : pd2 0 (fun x => F j w x - F k w x)
        =ᶠ[𝓝 y] (fun x => F j (0 :: w) x - F k (0 :: w) x) :=
      Filter.eventually_of_mem (hB₂.mem_nhds hy) (fun z hz => hd j k w 0 z hz)
    rw [← hd j k (0 :: w) 1 y hy]
    have hfd := hev.fderiv_eq (𝕜 := ℝ)
    unfold pd2 at hfd ⊢
    rw [hfd]
  
  have hsplit : ∀ (a b c : E2 → ℝ), Integrable (fun x => a x - c x) volume →
      Integrable (fun x => b x - c x) volume →
      (∫ y in B₂, |a y - b y|) ≤ (∫ x, |a x - c x|) + (∫ x, |b x - c x|) := by
    intro a b c ha hb
    have hab : Integrable (fun x => a x - b x) volume := by
      refine (ha.sub hb).congr (Filter.Eventually.of_forall fun x => ?_)
      simp only [Pi.sub_apply]
      ring
    calc (∫ y in B₂, |a y - b y|) ≤ ∫ x, |a x - b x| :=
          setIntegral_le_integral hab.abs (Filter.Eventually.of_forall fun x => abs_nonneg _)
      _ ≤ ∫ x, (|a x - c x| + |b x - c x|) := by
          refine integral_mono hab.abs (ha.abs.add hb.abs) (fun x => ?_)
          have h := abs_sub_le (a x) (c x) (b x)
          rw [abs_sub_comm (c x) (b x)] at h
          exact h
      _ = (∫ x, |a x - c x|) + (∫ x, |b x - c x|) := integral_add ha.abs hb.abs
  
  obtain ⟨S, hSdef⟩ : ∃ S : ℕ → ℝ, ∀ j, S j = (∫ x, |F j w x - g w x|)
      + (∫ x, |F j (0 :: w) x - g (0 :: w) x|) + (∫ x, |F j (1 :: w) x - g (1 :: w) x|)
      + (∫ x, |F j (1 :: 0 :: w) x - g (1 :: 0 :: w) x|) := ⟨_, fun j => rfl⟩
  have hS : Tendsto S atTop (𝓝 0) := by
    have h := (((hL1 w).add (hL1 (0 :: w))).add (hL1 (1 :: w))).add (hL1 (1 :: 0 :: w))
    simp only [add_zero] at h
    exact h.congr (fun j => (hSdef j).symm)
  
  have hbound : ∀ j k, ∀ x ∈ B, |F j w x - F k w x| ≤ C * (S j + S k) := by
    intro j k x hx
    have hψ : ContDiff ℝ ∞ (fun x => F j w x - F k w x) := (hF j w).sub (hF k w)
    have h0 := hsup _ hψ x hx
    have e2 : (∫ y in B₂, |pd2 0 (fun x => F j w x - F k w x) y|)
        = ∫ y in B₂, |F j (0 :: w) y - F k (0 :: w) y| :=
      setIntegral_congr_fun hB₂.measurableSet (fun y hy => by simp only [hd j k w 0 y hy])
    have e3 : (∫ y in B₂, |pd2 1 (fun x => F j w x - F k w x) y|)
        = ∫ y in B₂, |F j (1 :: w) y - F k (1 :: w) y| :=
      setIntegral_congr_fun hB₂.measurableSet (fun y hy => by simp only [hd j k w 1 y hy])
    have e4 : (∫ y in B₂, |pd2 1 (pd2 0 (fun x => F j w x - F k w x)) y|)
        = ∫ y in B₂, |F j (1 :: 0 :: w) y - F k (1 :: 0 :: w) y| :=
      setIntegral_congr_fun hB₂.measurableSet (fun y hy => by simp only [hmix j k y hy])
    rw [e2, e3, e4] at h0
    have i1 := hsplit (F j w) (F k w) (g w) (hint j w) (hint k w)
    have i2 := hsplit (F j (0 :: w)) (F k (0 :: w)) (g (0 :: w)) (hint j _) (hint k _)
    have i3 := hsplit (F j (1 :: w)) (F k (1 :: w)) (g (1 :: w)) (hint j _) (hint k _)
    have i4 := hsplit (F j (1 :: 0 :: w)) (F k (1 :: 0 :: w)) (g (1 :: 0 :: w))
      (hint j _) (hint k _)
    have hsum : (∫ y in B₂, |F j w y - F k w y|)
        + (∫ y in B₂, |F j (0 :: w) y - F k (0 :: w) y|)
        + (∫ y in B₂, |F j (1 :: w) y - F k (1 :: w) y|)
        + (∫ y in B₂, |F j (1 :: 0 :: w) y - F k (1 :: 0 :: w) y|) ≤ S j + S k := by
      rw [hSdef j, hSdef k]
      linarith
    exact h0.trans (mul_le_mul_of_nonneg_left hsum hC)
  
  have hUC : UniformCauchySeqOn (fun j => F j w) atTop B := by
    rw [Metric.uniformCauchySeqOn_iff]
    intro ε hε
    have hden : 0 < 2 * C + 1 := by linarith
    have hδ : 0 < ε / (2 * C + 1) := div_pos hε hden
    have hδeq : ε / (2 * C + 1) * (2 * C + 1) = ε := div_mul_cancel₀ _ hden.ne'
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 hS _ hδ
    refine ⟨N, fun m hm n hn x hx => ?_⟩
    have hm' := hN m hm
    have hn' := hN n hn
    rw [Real.dist_eq, sub_zero] at hm' hn'
    have hm'' := (abs_lt.1 hm').2
    have hn'' := (abs_lt.1 hn').2
    rw [Real.dist_eq]
    have hb := hbound m n x hx
    have hkey : C * (S m + S n) ≤ C * (2 * (ε / (2 * C + 1))) :=
      mul_le_mul_of_nonneg_left (by linarith) hC
    nlinarith
  
  refine ⟨fun x => limUnder atTop (fun j => F j w x), ?_⟩
  refine hUC.tendstoUniformlyOn_of_tendsto (fun x hx => ?_)
  exact (hUC.cauchySeq hx).tendsto_limUnder

theorem elr_unif_tree_smooth (B : Set E2) (hB : IsOpen B) (F : ℕ → List (Fin 2) → E2 → ℝ) (u : List (Fin 2) → E2 → ℝ) (hd : ∀ j w, ∀ x ∈ B, DifferentiableAt ℝ (F j w) x) (hpd : ∀ j w (m : Fin 2), ∀ x ∈ B, pd2 m (F j w) x = F j (m :: w) x) (hconv : ∀ w, TendstoUniformlyOn (fun j => F j w) (u w) atTop B) : ∀ w, ContDiffOn ℝ ∞ (u w) B :=
by
  
  have hrepr : ∀ L : E2 →L[ℝ] ℝ,
      L = ∑ m : Fin 2, L (e2 m) • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ) := by
    intro L
    refine ContinuousLinearMap.ext (fun v => ?_)
    have hv : v = ∑ m : Fin 2, v.ofLp m • e2 m := by
      ext i
      fin_cases i <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
    have hL : L v = ∑ m : Fin 2, v.ofLp m * L (e2 m) := by
      calc L v = L (∑ m : Fin 2, v.ofLp m • e2 m) := congrArg L hv
        _ = ∑ m : Fin 2, v.ofLp m * L (e2 m) := by
          rw [map_sum]
          simp only [map_smul, smul_eq_mul]
    rw [hL, ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    rw [ContinuousLinearMap.smul_apply, smul_eq_mul, mul_comm]
    rfl
  
  have hπ : ∀ m : Fin 2, ‖(EuclideanSpace.proj m : E2 →L[ℝ] ℝ)‖ ≤ 1 := by
    intro m
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => ?_)
    rw [one_mul]
    exact PiLp.norm_apply_le v m
  
  have hfd : ∀ j w, ∀ x ∈ B, HasFDerivAt (F j w)
      (∑ m : Fin 2, F j (m :: w) x • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) x := by
    intro j w x hx
    have h := (hd j w x hx).hasFDerivAt
    have heq : fderiv ℝ (F j w) x =
        ∑ m : Fin 2, F j (m :: w) x • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ) := by
      calc fderiv ℝ (F j w) x
          = ∑ m : Fin 2, fderiv ℝ (F j w) x (e2 m) • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ) :=
            hrepr _
        _ = _ := Finset.sum_congr rfl (fun m _ => by rw [← hpd j w m x hx]; rfl)
    exact h.congr_fderiv heq
  
  have hlim : ∀ w, ∀ x ∈ B, HasFDerivAt (u w)
      (∑ m : Fin 2, u (m :: w) x • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) x := by
    intro w x hx
    refine hasFDerivAt_of_tendstoUniformlyOn (f := fun j => F j w)
      (f' := fun j y => ∑ m : Fin 2, F j (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ))
      (g' := fun y => ∑ m : Fin 2, u (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ))
      hB ?_ (fun j y hy => hfd j w y hy) (fun y hy => (hconv w).tendsto_at hy) hx
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    filter_upwards [Metric.tendstoUniformlyOn_iff.1 (hconv (0 :: w)) (ε / 2) (by linarith),
      Metric.tendstoUniformlyOn_iff.1 (hconv (1 :: w)) (ε / 2) (by linarith)] with j h0 h1 y hy
    have a0 := h0 y hy
    have a1 := h1 y hy
    rw [Real.dist_eq] at a0 a1
    set π0 := (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ) with hπ0
    set π1 := (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ) with hπ1
    set c0 := u (0 :: w) y - F j (0 :: w) y with hc0
    set c1 := u (1 :: w) y - F j (1 :: w) y with hc1
    have e : (∑ m : Fin 2, u (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) -
        (∑ m : Fin 2, F j (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) =
        c0 • π0 + c1 • π1 := by
      simp only [Fin.sum_univ_two, hc0, hc1, sub_smul]
      abel
    show dist (∑ m : Fin 2, u (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ))
      (∑ m : Fin 2, F j (m :: w) y • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) < ε
    rw [dist_eq_norm, e]
    have n0 : ‖π0‖ ≤ 1 := hπ 0
    have n1 : ‖π1‖ ≤ 1 := hπ 1
    calc ‖c0 • π0 + c1 • π1‖ ≤ ‖c0 • π0‖ + ‖c1 • π1‖ := norm_add_le _ _
      _ = |c0| * ‖π0‖ + |c1| * ‖π1‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
      _ ≤ |c0| * 1 + |c1| * 1 := by
          gcongr
      _ < ε := by linarith
  
  have hQ : ∀ n : ℕ, ∀ w, ContDiffOn ℝ (n : WithTop ℕ∞) (u w) B := by
    intro n
    induction n with
    | zero =>
      intro w
      rw [Nat.cast_zero, contDiffOn_zero]
      exact fun x hx => (hlim w x hx).continuousAt.continuousWithinAt
    | succ n ih =>
      intro w
      rw [Nat.cast_succ, contDiffOn_succ_iff_fderiv_of_isOpen hB]
      refine ⟨fun x hx => (hlim w x hx).differentiableAt.differentiableWithinAt, ?_, ?_⟩
      · intro h
        exact absurd h (WithTop.natCast_ne_top n)
      · have hs : ContDiffOn ℝ n (fun x => ∑ m : Fin 2,
            u (m :: w) x • (EuclideanSpace.proj m : E2 →L[ℝ] ℝ)) B :=
          ContDiffOn.sum (fun m _ => (ih (m :: w)).smul contDiffOn_const)
        exact hs.congr (fun x hx => (hlim w x hx).fderiv)
  intro w
  exact contDiffOn_infty.2 (fun n => hQ n w)

theorem elr_sob_smooth (U : Set E2) (hU : IsOpen U) (v : E2 → ℝ) (hv : ∀ k : ℕ, elrSob (k + 2) U v) : ∀ x ∈ U, ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ U ∧ ∃ u : E2 → ℝ, ContDiffOn ℝ ∞ u (Metric.ball x r) ∧ ∀ᵐ y ∂(volume.restrict (Metric.ball x r)), v y = u y :=
by
  
  have hL2of : ∀ (k : ℕ) (ψ : E2 → ℝ), elrSob k U ψ →
      ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp ψ 2 (volume.restrict L) := by
    intro k ψ h
    cases k with
    | zero => exact h
    | succ k => exact h.1
  
  have hcongr : ∀ (k : ℕ) (φ φ' : E2 → ℝ), (∀ᵐ x ∂(volume.restrict U), φ x = φ' x) →
      elrSob k U φ → elrSob k U φ' := by
    intro k φ φ' hae hφ
    have hL : ∀ L : Set E2, L ⊆ U → MemLp φ 2 (volume.restrict L) →
        MemLp φ' 2 (volume.restrict L) :=
      fun L hLU h => h.ae_eq (ae_restrict_of_ae_restrict_of_subset hLU hae)
    cases k with
    | zero =>
      intro L hL1 hL2
      exact hL L hL2 (hφ L hL1 hL2)
    | succ k =>
      simp only [elrSob] at hφ ⊢
      obtain ⟨h0, G, hGw, hGk⟩ := hφ
      refine ⟨fun L hL1 hL2 => hL L hL2 (h0 L hL1 hL2), G, fun ζ h1 h2 h3 m => ?_, hGk⟩
      rw [← hGw ζ h1 h2 h3 m]
      refine integral_congr_ae ?_
      have hae' := (ae_restrict_iff' hU.measurableSet).1 hae
      filter_upwards [hae'] with x hx
      by_cases hxU : x ∈ U
      · rw [hx hxU]
      · have hxt : x ∉ tsupport (fderiv ℝ ζ) := fun h => hxU (h3 (tsupport_fderiv_subset ℝ h))
        have h0' : fderiv ℝ ζ x = 0 := image_eq_zero_of_notMem_tsupport hxt
        simp [pd2, h0']
  
  have huniq : ∀ (φ : E2 → ℝ) (G G' : Fin 2 → E2 → ℝ),
      (∀ (m : Fin 2) (L : Set E2), IsCompact L → L ⊆ U → MemLp (G m) 2 (volume.restrict L)) →
      (∀ (m : Fin 2) (L : Set E2), IsCompact L → L ⊆ U → MemLp (G' m) 2 (volume.restrict L)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, G m x * ζ x)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, G' m x * ζ x)) →
      ∀ m : Fin 2, ∀ᵐ x ∂(volume.restrict U), G m x = G' m x := by
    intro φ G G' hG hG' h1 h2 m
    have hloc : LocallyIntegrableOn (fun x => G m x - G' m x) U volume := by
      intro x hx
      obtain ⟨ρ, hρ, hρU⟩ := Metric.isOpen_iff.1 hU x hx
      have hcb : IsCompact (Metric.closedBall x (ρ / 2)) := isCompact_closedBall _ _
      have hsub : Metric.closedBall x (ρ / 2) ⊆ U := fun y hy => hρU (by
        rw [Metric.mem_closedBall] at hy
        rw [Metric.mem_ball]
        linarith)
      haveI : IsFiniteMeasure (volume.restrict (Metric.closedBall x (ρ / 2))) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hcb.measure_lt_top⟩
      refine ⟨Metric.closedBall x (ρ / 2),
        mem_nhdsWithin_of_mem_nhds (Metric.closedBall_mem_nhds x (by positivity)), ?_⟩
      exact ((hG m _ hcb hsub).integrable one_le_two).sub
        ((hG' m _ hcb hsub).integrable one_le_two)
    have hint : ∀ g : E2 → ℝ, ContDiff ℝ ∞ g → HasCompactSupport g → tsupport g ⊆ U →
        ∫ x, g x • (G m x - G' m x) = 0 := by
      intro g hg hgc hgU
      have e := (h1 g hg hgc hgU m).symm.trans (h2 g hg hgc hgU m)
      haveI : IsFiniteMeasure (volume.restrict (tsupport g)) :=
        ⟨by rw [Measure.restrict_apply_univ]; exact hgc.measure_lt_top⟩
      have hprod : ∀ f : E2 → ℝ, MemLp f 2 (volume.restrict (tsupport g)) →
          Integrable (fun x => f x * g x) := by
        intro f hf
        have hfi : IntegrableOn f (tsupport g) := hf.integrable one_le_two
        have hi : IntegrableOn (fun x => f x * g x) (tsupport g) :=
          IntegrableOn.mul_continuousOn hfi hg.continuous.continuousOn hgc
        exact (integrableOn_iff_integrable_of_support_subset
          ((Function.support_mul_subset_right f g).trans (subset_tsupport g))).1 hi
      have i1 := hprod (G m) (hG m _ hgc hgU)
      have i2 := hprod (G' m) (hG' m _ hgc hgU)
      have e2 : ∫ x, G m x * g x = ∫ x, G' m x * g x := neg_injective e
      have hfun : (fun x => g x • (G m x - G' m x)) = fun x => G m x * g x - G' m x * g x := by
        funext x
        simp only [smul_eq_mul]
        ring
      rw [hfun, integral_sub i1 i2, e2, sub_self]
    have h0 := hU.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc hint
    rw [ae_restrict_iff' hU.measurableSet]
    filter_upwards [h0] with x hx hxU
    exact sub_eq_zero.1 (hx hxU)
  
  have hPv : ∀ k : ℕ, elrSob k U v := by
    intro k
    match k with
    | 0 => exact hL2of 2 v (hv 0)
    | 1 =>
      have h2 := hv 0
      simp only [elrSob] at h2 ⊢
      obtain ⟨h0, G, hG, hGm⟩ := h2
      exact ⟨h0, G, hG, fun m => (hGm m).1⟩
    | k + 2 => exact hv k
  have hstep : ∀ φ : E2 → ℝ, (∀ k : ℕ, elrSob k U φ) → ∃ G : Fin 2 → E2 → ℝ,
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, G m x * ζ x)) ∧
      ∀ m : Fin 2, ∀ k : ℕ, elrSob k U (G m) := by
    intro φ hφ
    have h1 := hφ 1
    simp only [elrSob] at h1
    obtain ⟨_, G, hGw, hG0⟩ := h1
    refine ⟨G, hGw, fun m k => ?_⟩
    have hk := hφ (k + 1)
    simp only [elrSob] at hk
    obtain ⟨_, G', hG'w, hG'k⟩ := hk
    have hae := huniq φ G G' (fun m' => hG0 m')
      (fun m' => hL2of k (G' m') (hG'k m')) hGw hG'w m
    exact hcongr k (G' m) (G m) (hae.mono fun x hx => hx.symm) (hG'k m)
  
  choose! Gr hGw hGP using hstep
  obtain ⟨D, hD0, hDcons⟩ : ∃ D : List (Fin 2) → E2 → ℝ,
      D [] = v ∧ ∀ m w, D (m :: w) = Gr (D w) m :=
    ⟨fun w => List.rec (motive := fun _ => E2 → ℝ) v (fun m _ Dw => Gr Dw m) w,
      rfl, fun _ _ => rfl⟩
  have hDP : ∀ w, ∀ k : ℕ, elrSob k U (D w) := by
    intro w
    induction w with
    | nil => rw [hD0]; exact hPv
    | cons m w ih => rw [hDcons]; exact hGP (D w) ih m
  have hD : ∀ (w : List (Fin 2)) (m : Fin 2) (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ →
      HasCompactSupport ζ → tsupport ζ ⊆ U →
      ∫ x, D w x * pd2 m ζ x = -(∫ x, D (m :: w) x * ζ x) := by
    intro w m ζ h1 h2 h3
    rw [hDcons]
    exact hGw (D w) (hDP w) ζ h1 h2 h3 m
  
  intro x₀ hx₀
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x₀ hx₀
  obtain ⟨R, hR, hRε⟩ : ∃ R : ℝ, 0 < R ∧ 5 * R = ε := ⟨ε / 5, by positivity, by ring⟩
  obtain ⟨K, hKdef⟩ : ∃ K : Set E2, K = Metric.closedBall x₀ (4 * R) := ⟨_, rfl⟩
  have hKc : IsCompact K := by rw [hKdef]; exact isCompact_closedBall _ _
  have hKU : K ⊆ U := fun y hy => hball (by
    rw [hKdef, Metric.mem_closedBall] at hy
    rw [Metric.mem_ball]
    linarith)
  have hBK : Metric.ball x₀ R ⊆ K := fun y hy => by
    rw [Metric.mem_ball] at hy
    rw [hKdef, Metric.mem_closedBall]
    linarith
  have hBU : Metric.ball x₀ R ⊆ U := hBK.trans hKU
  
  have hDintOn : ∀ w, IntegrableOn (D w) K := by
    intro w
    haveI : IsFiniteMeasure (volume.restrict K) :=
      ⟨by rw [Measure.restrict_apply_univ]; exact hKc.measure_lt_top⟩
    exact (hL2of 0 (D w) (hDP w 0) K hKc hKU).integrable one_le_two
  have hDint : ∀ w, Integrable (K.indicator (D w)) := fun w =>
    (integrable_indicator_iff hKc.measurableSet).2 (hDintOn w)
  
  have hj2 : ∀ j : ℕ, (0 : ℝ) < (j : ℝ) + 2 := fun j => by positivity
  obtain ⟨φb, hφin, hφout⟩ : ∃ φb : ℕ → ContDiffBump (0 : E2),
      (∀ j, (φb j).rIn = R / (2 * ((j : ℝ) + 2))) ∧ (∀ j, (φb j).rOut = R / ((j : ℝ) + 2)) :=
    ⟨fun j => ⟨R / (2 * ((j : ℝ) + 2)), R / ((j : ℝ) + 2),
      div_pos hR (by have := hj2 j; positivity),
      div_lt_div_of_pos_left hR (hj2 j) (by have := hj2 j; linarith)⟩,
      fun j => rfl, fun j => rfl⟩
  have hδpos : ∀ j : ℕ, 0 < R / ((j : ℝ) + 2) := fun j => div_pos hR (hj2 j)
  have hδle : ∀ j : ℕ, R / ((j : ℝ) + 2) ≤ R / 2 := fun j =>
    div_le_div_of_nonneg_left hR.le two_pos (by linarith [(j.cast_nonneg : (0 : ℝ) ≤ j)])
  have hηs : ∀ (j : ℕ) (y : E2), R / ((j : ℝ) + 2) ≤ ‖y‖ → (φb j).normed volume y = 0 := by
    intro j y hy
    have hy' : y ∉ Function.support ((φb j).normed volume) := by
      rw [(φb j).support_normed_eq, Metric.mem_ball, dist_zero_right, hφout j]
      exact not_lt.2 hy
    exact Function.notMem_support.1 hy'
  have hηsmooth : ∀ j, ContDiff ℝ ∞ ((φb j).normed volume) := fun j => (φb j).contDiff_normed
  
  have htrans := fun j w m => elr_moll_transfer U K hKc hKU (D w) (D (m :: w)) (hDintOn w)
    (hDintOn (m :: w)) m (fun ζ h1 h2 h3 => hD w m ζ h1 h2 h3) ((φb j).normed volume)
    (hηsmooth j) (R / ((j : ℝ) + 2)) (hδpos j) (hηs j)
  obtain ⟨F, hFdef⟩ : ∃ F : ℕ → List (Fin 2) → E2 → ℝ, ∀ j w,
      F j w = fun z => ∫ t, (φb j).normed volume t * K.indicator (D w) (z - t) :=
    ⟨_, fun _ _ => rfl⟩
  have hF : ∀ j w, ContDiff ℝ ∞ (F j w) := fun j w => by
    rw [hFdef]; exact (htrans j w 0).1
  have hpd3 : ∀ j w (m : Fin 2), ∀ x ∈ Metric.ball x₀ (3 * R),
      pd2 m (F j w) x = F j (m :: w) x := by
    intro j w m x hx
    rw [hFdef, hFdef]
    refine (htrans j w m).2 x ?_
    intro y hy
    rw [Metric.mem_closedBall] at hy
    rw [Metric.mem_ball] at hx
    rw [hKdef, Metric.mem_closedBall]
    have := hδle j
    linarith [dist_triangle y x x₀]
  
  have hδt : Tendsto (fun j : ℕ => R / ((j : ℝ) + 2)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
  have hL1 := fun w => elr_moll_L1 (K.indicator (D w)) (hDint w)
    (fun j => (φb j).normed volume) (fun j => (hηsmooth j).continuous)
    (fun j y => (φb j).nonneg_normed y) (fun j => (φb j).integral_normed)
    (fun j => R / ((j : ℝ) + 2)) hδt hηs
  have hint : ∀ j w, Integrable (fun x => F j w x - K.indicator (D w) x) := by
    intro j w
    rw [hFdef]
    exact (hL1 w).1 j
  have hL1' : ∀ w, Tendsto (fun j => ∫ x, |F j w x - K.indicator (D w) x|) atTop (𝓝 0) := by
    intro w
    simp only [hFdef]
    exact (hL1 w).2
  
  obtain ⟨C, hC, hsup⟩ := elr_sup_local x₀ R hR
  have hpd2 : ∀ j w (m : Fin 2), ∀ y ∈ Metric.ball x₀ (2 * R),
      pd2 m (F j w) y = F j (m :: w) y :=
    fun j w m y hy => hpd3 j w m y (Metric.ball_subset_ball (by linarith) hy)
  have hu0 := elr_unif_cauchy (Metric.ball x₀ R) (Metric.ball x₀ (2 * R)) Metric.isOpen_ball
    C hC hsup F hF hpd2 (fun w => K.indicator (D w)) hint hL1'
  choose u hu using hu0
  
  have hsm := elr_unif_tree_smooth (Metric.ball x₀ R) Metric.isOpen_ball F u
    (fun j w x _ => ((hF j w).differentiable (by simp)).differentiableAt)
    (fun j w m x hx => hpd3 j w m x (Metric.ball_subset_ball (by linarith) hx)) hu []
  
  have hloc : LocallyIntegrable (K.indicator v) volume := by
    have := (hDint []).locallyIntegrable
    rwa [hD0] at this
  have hrout : Tendsto (fun j => (φb j).rOut) atTop (𝓝 0) := by
    simp only [hφout]
    exact hδt
  have hratio : ∀ᶠ j in atTop, (φb j).rOut ≤ 2 * (φb j).rIn :=
    Eventually.of_forall fun j => le_of_eq (by
      rw [hφin, hφout, mul_div_assoc', mul_div_mul_left _ _ two_ne_zero])
  have hae := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable
    (μ := volume) (φ := φb) (l := atTop) (K := 2) hrout hratio hloc
  refine ⟨R, hR, hBU, u [], hsm, ?_⟩
  rw [ae_restrict_iff' Metric.isOpen_ball.measurableSet]
  filter_upwards [hae] with x hx hxB
  have h1 : Tendsto (fun j => F j [] x) atTop (𝓝 (K.indicator v x)) := by
    refine hx.congr (fun j => ?_)
    rw [hFdef, convolution_def, hD0]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  have h2 : Tendsto (fun j => F j [] x) atTop (𝓝 (u [] x)) := (hu []).tendsto_at hxB
  have h3 := tendsto_nhds_unique h1 h2
  rwa [Set.indicator_of_mem (hBK hxB)] at h3

theorem eig_local_regularity (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) (c : E2 → ℝ) (hc : ContDiffOn ℝ ∞ c W) (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W → MemLp w 2 (volume.restrict L) ∧ ∀ k, MemLp (G k) 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W → ∀ k : Fin 2, ∫ x, w x * pd2 k ζ x = -(∫ x, G k x * ζ x)) (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h x).det * (h x)⁻¹ a b * G b x * pd2 a ζ x - c x * Real.sqrt (h x).det * w x * ζ x) = 0) : ∃ w' : E2 → ℝ, ContDiffOn ℝ ∞ w' W ∧ (∀ᵐ x ∂(volume.restrict W), w x = w' x) ∧ ∀ x ∈ W, lap2 h w' x + c x * w' x = 0 :=
by
  obtain ⟨hsqpos, hsqs, hinvs, hApos⟩ := elr_coeff_smooth W hW h hh hpos
  
  have hzero : ∀ (n : ℕ) (U : Set E2), elrSob n U (fun _ => (0 : ℝ)) := by
    intro n
    induction n with
    | zero =>
      intro U L _ _
      exact MeasureTheory.MemLp.zero
    | succ n ih =>
      intro U
      refine ⟨fun L _ _ => MeasureTheory.MemLp.zero, fun _ _ => (0 : ℝ), ?_, fun _ => ih U⟩
      intro ζ _ _ _ m
      simp
  
  have hSob : ∀ k : ℕ, elrSob (k + 2) W w := by
    intro k
    refine elr_sob_bootstrap W hW (fun x => Real.sqrt (h x).det • (h x)⁻¹) ?_ hApos
      (fun x => c x * Real.sqrt (h x).det) (hc.mul hsqs) k w G (fun _ _ => (0 : ℝ))
      (fun _ => (0 : ℝ)) hL2 hgrad (fun _ => hzero (k + 1) W) (hzero k W) ?_
    · intro a b
      simp only [Matrix.smul_apply, smul_eq_mul]
      exact hsqs.mul (hinvs a b)
    · intro ζ h1 h2 h3
      simp only [Matrix.smul_apply, smul_eq_mul, zero_mul, Finset.sum_const_zero, add_zero,
        MeasureTheory.integral_zero]
      exact hweak ζ h1 h2 h3
  
  obtain ⟨w', hw's, hae⟩ := elr_glue_local W hW w (elr_sob_smooth W hW w hSob)
  refine ⟨w', hw's, hae, fun x hx => ?_⟩
  have h2 := elr_weak_to_strong W hW h hh hpos c hc w w' G hL2 hgrad hweak hw's hae x hx
  rw [elr_div_identity W hW h hh hpos w' hw's x hx] at h2
  have hprod : Real.sqrt (h x).det * (lap2 h w' x + c x * w' x) = 0 := by
    linear_combination h2
  rcases mul_eq_zero.mp hprod with h0 | h0
  · exact absurd h0 (hsqpos x hx).ne'
  · exact h0

theorem eig_patch_limit_glue {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (u : ℕ → X → ℝ) (hu : ∀ n j, ContDiffOn ℝ ∞ (fun x => u n (P.param j x)) (P.W j)) (hnn : ∀ n, ∀ q ∈ S, 0 ≤ u n q) (K : Fin P.n → Set E2) (hK : ∀ j, IsCompact (K j) ∧ K j ⊆ P.W j) (c₀ : ℝ) (hc₀ : 0 < c₀) (hnd : ∀ n, c₀ ≤ ∑ j, ∫ x in K j, (u n (P.param j x)) ^ 2) (w : Fin P.n → E2 → ℝ) (hw : ∀ j, ContDiffOn ℝ ∞ (w j) (P.W j)) (hconv : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → Tendsto (fun n => ∫ x in L, (u n (P.param j x) - w j x) ^ 2) atTop (𝓝 0)) : ∃ φ : X → ℝ, (∀ j, ∀ x ∈ P.W j, φ (P.param j x) = w j x) ∧ (∀ q ∈ S, 0 ≤ φ q) ∧ ∃ q ∈ S, φ q ≠ 0 :=
by
  classical
  
  have core : ∀ (U : Set E2), IsOpen U → ∀ (c : E2 → ℝ), ContinuousOn c U →
      ∀ (T : Set E2 → ℕ → ℝ), (∀ L, IsCompact L → L ⊆ U → Tendsto (T L) atTop (𝓝 0)) →
      (∀ L, IsCompact L → L ⊆ U → ∀ n, ∫ x in L, c x ^ 2 ≤ T L n) → ∀ x ∈ U, c x = 0 := by
    intro U hU c hc T hT hle x hx
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 hU x hx
    have hLU : closedBall x (r / 2) ⊆ U :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hLc : IsCompact (closedBall x (r / 2)) := isCompact_closedBall x (r / 2)
    have hI0 : ∫ y in closedBall x (r / 2), c y ^ 2 = 0 := by
      apply le_antisymm
      · exact ge_of_tendsto' (hT _ hLc hLU) (hle _ hLc hLU)
      · exact setIntegral_nonneg measurableSet_closedBall (fun y _ => sq_nonneg (c y))
    have hint : IntegrableOn (fun y => c y ^ 2) (closedBall x (r / 2)) :=
      ((hc.mono hLU).pow 2).integrableOn_compact hLc
    have hae : (fun y => c y ^ 2) =ᵐ[volume.restrict (closedBall x (r / 2))] 0 :=
      (setIntegral_eq_zero_iff_of_nonneg_ae (ae_of_all _ (fun y => sq_nonneg (c y))) hint).1 hI0
    have hae' : (fun y => c y ^ 2) =ᵐ[volume.restrict (ball x (r / 2))] 0 :=
      ae_restrict_of_ae_restrict_of_subset ball_subset_closedBall hae
    have heq := Measure.eqOn_open_of_ae_eq hae' isOpen_ball
      ((hc.mono (ball_subset_closedBall.trans hLU)).pow 2) continuous_zero.continuousOn
    have hx0 := heq (mem_ball_self (by linarith : (0 : ℝ) < r / 2))
    simpa using hx0
  
  have s1 : ∀ (U : Set E2), IsOpen U → ∀ (f : ℕ → E2 → ℝ) (a b : E2 → ℝ),
      (∀ n, ContinuousOn (f n) U) → ContinuousOn a U → ContinuousOn b U →
      (∀ L : Set E2, IsCompact L → L ⊆ U →
        Tendsto (fun n => ∫ x in L, (f n x - a x) ^ 2) atTop (𝓝 0)) →
      (∀ L : Set E2, IsCompact L → L ⊆ U →
        Tendsto (fun n => ∫ x in L, (f n x - b x) ^ 2) atTop (𝓝 0)) →
      ∀ x ∈ U, a x = b x := by
    intro U hU f a b hf ha hb hfa hfb x hx
    have key := core U hU (fun y => a y - b y) (ha.sub hb)
      (fun L n => 2 * (∫ y in L, (f n y - a y) ^ 2) + 2 * (∫ y in L, (f n y - b y) ^ 2))
      ?_ ?_ x hx
    · exact sub_eq_zero.1 key
    · intro L hL hLU
      have h2 := ((hfa L hL hLU).const_mul 2).add ((hfb L hL hLU).const_mul 2)
      simpa using h2
    · intro L hL hLU n
      have i1 : IntegrableOn (fun y => 2 * (f n y - a y) ^ 2) L :=
        ((continuousOn_const.mul (((hf n).sub ha).pow 2)).mono hLU).integrableOn_compact hL
      have i2 : IntegrableOn (fun y => 2 * (f n y - b y) ^ 2) L :=
        ((continuousOn_const.mul (((hf n).sub hb).pow 2)).mono hLU).integrableOn_compact hL
      have i3 : IntegrableOn (fun y => (a y - b y) ^ 2) L :=
        (((ha.sub hb).pow 2).mono hLU).integrableOn_compact hL
      have i4 : IntegrableOn (fun y => 2 * (f n y - a y) ^ 2 + 2 * (f n y - b y) ^ 2) L :=
        (((continuousOn_const.mul (((hf n).sub ha).pow 2)).add
          (continuousOn_const.mul (((hf n).sub hb).pow 2))).mono hLU).integrableOn_compact hL
      show ∫ y in L, (a y - b y) ^ 2 ≤
        2 * (∫ y in L, (f n y - a y) ^ 2) + 2 * (∫ y in L, (f n y - b y) ^ 2)
      calc ∫ y in L, (a y - b y) ^ 2
          ≤ ∫ y in L, (2 * (f n y - a y) ^ 2 + 2 * (f n y - b y) ^ 2) :=
            setIntegral_mono_on i3 i4 hL.measurableSet
              (fun y _ => by nlinarith [sq_nonneg (2 * f n y - a y - b y)])
        _ = 2 * (∫ y in L, (f n y - a y) ^ 2) + 2 * (∫ y in L, (f n y - b y) ^ 2) := by
            rw [integral_add i1 i2, integral_const_mul, integral_const_mul]
  
  have s4 : ∀ (U : Set E2), IsOpen U → ∀ (f : ℕ → E2 → ℝ) (v : E2 → ℝ),
      (∀ n, ContinuousOn (f n) U) → (∀ n, ∀ x ∈ U, 0 ≤ f n x) → ContinuousOn v U →
      (∀ L : Set E2, IsCompact L → L ⊆ U →
        Tendsto (fun n => ∫ x in L, (f n x - v x) ^ 2) atTop (𝓝 0)) →
      ∀ x ∈ U, 0 ≤ v x := by
    intro U hU f v hf hfnn hv hcv x hx
    have hvc : ContinuousOn (fun y => max (-v y) 0) U :=
      (continuous_id.max continuous_const).comp_continuousOn (ContinuousOn.neg hv)
    have key := core U hU (fun y => max (-v y) 0) hvc
      (fun L n => ∫ y in L, (f n y - v y) ^ 2) (fun L hL hLU => hcv L hL hLU) ?_ x hx
    · have h' : max (-v x) 0 = 0 := key
      have := le_max_left (-v x) 0
      linarith
    · intro L hL hLU n
      show ∫ y in L, (max (-v y) 0) ^ 2 ≤ ∫ y in L, (f n y - v y) ^ 2
      apply setIntegral_mono_on (((hvc.pow 2).mono hLU).integrableOn_compact hL)
        (((((hf n).sub hv).pow 2).mono hLU).integrableOn_compact hL) hL.measurableSet
      intro y hy
      have h0 := hfnn n y (hLU hy)
      rcases le_total 0 (v y) with h1 | h1
      · rw [max_eq_right (by linarith)]
        nlinarith [sq_nonneg (f n y - v y)]
      · rw [max_eq_left (by linarith)]
        nlinarith [mul_nonneg h0 (by linarith : (0 : ℝ) ≤ f n y - 2 * v y)]
  
  have s2 : ∀ (U V : Set E2), IsOpen U → ∀ (τ : E2 → E2), ContDiffOn ℝ ∞ τ U →
      (∀ x ∈ U, τ x ∈ V) → Set.InjOn τ U → (∀ x ∈ U, (fderiv ℝ τ x).det ≠ 0) →
      ∀ (g : ℕ → E2 → ℝ) (b : E2 → ℝ), (∀ n, ContinuousOn (g n) V) → ContinuousOn b V →
      (∀ L : Set E2, IsCompact L → L ⊆ V →
        Tendsto (fun n => ∫ y in L, (g n y - b y) ^ 2) atTop (𝓝 0)) →
      ∀ L : Set E2, IsCompact L → L ⊆ U →
        Tendsto (fun n => ∫ x in L, (g n (τ x) - b (τ x)) ^ 2) atTop (𝓝 0) := by
    intro U V hU τ hτ hτV hinj hdet g b hg hb hgb L hL hLU
    rcases L.eq_empty_or_nonempty with hLe | hne
    · subst hLe
      simp
    have hτc : ContinuousOn τ U := hτ.continuousOn
    have hτd : DifferentiableOn ℝ τ U := hτ.differentiableOn (by simp)
    have hJc : ContinuousOn (fun x => |(fderiv ℝ τ x).det|) U :=
      (ContinuousLinearMap.continuous_det.comp_continuousOn
        (hτ.continuousOn_fderiv_of_isOpen hU (by simp))).abs
    obtain ⟨x₀, hx₀L, hmin⟩ := hL.exists_isMinOn hne (hJc.mono hLU)
    have hmpos : 0 < |(fderiv ℝ τ x₀).det| := abs_pos.2 (hdet x₀ (hLU hx₀L))
    have hmapsL : Set.MapsTo τ L V := fun x hx => hτV x (hLU hx)
    have hτL : IsCompact (τ '' L) := hL.image_of_continuousOn (hτc.mono hLU)
    have hτLV : τ '' L ⊆ V := by
      rintro _ ⟨x, hx, rfl⟩
      exact hτV x (hLU hx)
    have hT := hgb _ hτL hτLV
    have hcov : ∀ n, ∫ y in τ '' L, (g n y - b y) ^ 2 =
        ∫ x in L, |(fderiv ℝ τ x).det| * (g n (τ x) - b (τ x)) ^ 2 := by
      intro n
      have h := integral_image_eq_integral_abs_det_fderiv_smul volume hL.measurableSet
        (f' := fun x => fderiv ℝ τ x)
        (fun x hx => ((hτd x (hLU hx)).differentiableAt
          (hU.mem_nhds (hLU hx))).hasFDerivAt.hasFDerivWithinAt) (hinj.mono hLU)
        (fun y => (g n y - b y) ^ 2)
      simpa only [smul_eq_mul] using h
    have hFc : ∀ n, ContinuousOn (fun x => (g n (τ x) - b (τ x)) ^ 2) L := fun n =>
      (((hg n).comp (hτc.mono hLU) hmapsL).sub (hb.comp (hτc.mono hLU) hmapsL)).pow 2
    have hup : Tendsto (fun n => |(fderiv ℝ τ x₀).det|⁻¹ * ∫ y in τ '' L, (g n y - b y) ^ 2)
        atTop (𝓝 0) := by
      have h := hT.const_mul (|(fderiv ℝ τ x₀).det|⁻¹)
      rwa [mul_zero] at h
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hup
      (fun n => setIntegral_nonneg hL.measurableSet (fun x _ => sq_nonneg _)) (fun n => ?_)
    show ∫ x in L, (g n (τ x) - b (τ x)) ^ 2 ≤
      |(fderiv ℝ τ x₀).det|⁻¹ * ∫ y in τ '' L, (g n y - b y) ^ 2
    rw [hcov n, ← integral_const_mul]
    apply setIntegral_mono_on ((hFc n).integrableOn_compact hL)
      ((continuousOn_const.mul ((hJc.mono hLU).mul (hFc n))).integrableOn_compact hL)
      hL.measurableSet
    intro x hx
    have hJx : |(fderiv ℝ τ x₀).det| ≤ |(fderiv ℝ τ x).det| := hmin hx
    have hF0 : 0 ≤ (g n (τ x) - b (τ x)) ^ 2 := sq_nonneg _
    have h1 : 1 ≤ |(fderiv ℝ τ x₀).det|⁻¹ * |(fderiv ℝ τ x).det| := by
      rw [inv_mul_eq_div, le_div_iff₀ hmpos, one_mul]
      exact hJx
    rw [← mul_assoc]
    nlinarith
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  
  have hopen : ∀ j k, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j k =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hmap : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j k x hx
    have hmem : P.param j x ∈ P.param k '' P.W k := by
      rw [P.image_eq k]
      exact ⟨hx.2, (hP1 j x hx.1).2⟩
    obtain ⟨z, hz, hzx⟩ := hmem
    rw [← hzx, P.proj_param k z hz]
    exact ⟨hz, rfl⟩
  have hinj : ∀ j k, Set.InjOn (fun x => P.proj k (P.param j x))
      (P.W j ∩ P.param j ⁻¹' P.O k) := by
    intro j k x hx x' hx' hxx'
    have h1 : P.param j x = P.param j x' := by
      rw [← (hmap j k x hx).2, ← (hmap j k x' hx').2]
      simp only at hxx'
      rw [hxx']
    rw [← P.proj_param j x hx.1, ← P.proj_param j x' hx'.1, h1]
  have hdet : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      (fderiv ℝ (fun x' => P.proj k (P.param j x')) x).det ≠ 0 := by
    intro j k x hx
    have hy : P.proj k (P.param j x) ∈ P.W k ∩ P.param k ⁻¹' P.O j := by
      refine ⟨(hmap j k x hx).1, ?_⟩
      show P.param k (P.proj k (P.param j x)) ∈ P.O j
      rw [(hmap j k x hx).2]
      exact (hP1 j x hx.1).1
    have hcomp : (fun y => P.proj j (P.param k y)) ∘ (fun x' => P.proj k (P.param j x'))
        =ᶠ[𝓝 x] id := by
      filter_upwards [(hopen j k).mem_nhds hx] with x' hx'
      show P.proj j (P.param k (P.proj k (P.param j x'))) = x'
      rw [(hmap j k x' hx').2, P.proj_param j x' hx'.1]
    have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
      ((P.trans_smooth j k).differentiableOn (by simp) x hx).differentiableAt
        ((hopen j k).mem_nhds hx)
    have hσd : DifferentiableAt ℝ (fun y => P.proj j (P.param k y)) (P.proj k (P.param j x)) :=
      ((P.trans_smooth k j).differentiableOn (by simp) _ hy).differentiableAt
        ((hopen k j).mem_nhds hy)
    have hfd : fderiv ℝ ((fun y => P.proj j (P.param k y)) ∘ (fun x' => P.proj k (P.param j x'))) x
        = (fderiv ℝ (fun y => P.proj j (P.param k y)) (P.proj k (P.param j x))).comp
          (fderiv ℝ (fun x' => P.proj k (P.param j x')) x) := fderiv_comp x hσd hτd
    rw [hcomp.fderiv_eq, fderiv_id] at hfd
    have hd1 : (fderiv ℝ (fun y => P.proj j (P.param k y)) (P.proj k (P.param j x))).det *
        (fderiv ℝ (fun x' => P.proj k (P.param j x')) x).det = 1 := by
      have e1 : (fderiv ℝ (fun y => P.proj j (P.param k y)) (P.proj k (P.param j x))).det *
          (fderiv ℝ (fun x' => P.proj k (P.param j x')) x).det =
          ((fderiv ℝ (fun y => P.proj j (P.param k y)) (P.proj k (P.param j x))).comp
            (fderiv ℝ (fun x' => P.proj k (P.param j x')) x)).det := by
        show LinearMap.det _ * LinearMap.det _ = LinearMap.det _
        rw [ContinuousLinearMap.coe_comp, LinearMap.det_comp]
      rw [e1, ← hfd]
      show LinearMap.det ((ContinuousLinearMap.id ℝ E2 : E2 →L[ℝ] E2) : E2 →ₗ[ℝ] E2) = 1
      rw [ContinuousLinearMap.coe_id, LinearMap.det_id]
    intro h0
    rw [h0, mul_zero] at hd1
    exact zero_ne_one hd1
  
  have hcons : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      w j x = w k (P.proj k (P.param j x)) := by
    intro j k
    have hmapsto : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, P.proj k (P.param j x) ∈ P.W k :=
      fun x hx => (hmap j k x hx).1
    have htr := s2 _ (P.W k) (hopen j k) (fun x => P.proj k (P.param j x)) (P.trans_smooth j k)
      hmapsto (hinj j k) (hdet j k) (fun n y => u n (P.param k y)) (w k)
      (fun n => (hu n k).continuousOn) (hw k).continuousOn (hconv k)
    apply s1 _ (hopen j k) (fun n x => u n (P.param j x)) (w j)
      (fun x => w k (P.proj k (P.param j x)))
      (fun n => (hu n j).continuousOn.mono Set.inter_subset_left)
      ((hw j).continuousOn.mono Set.inter_subset_left)
      ((hw k).continuousOn.comp (P.trans_smooth j k).continuousOn hmapsto)
      (fun L hL hLU => hconv j L hL (hLU.trans Set.inter_subset_left))
    intro L hL hLU
    refine (htr L hL hLU).congr (fun n => ?_)
    refine setIntegral_congr_fun hL.measurableSet (fun x hx => ?_)
    simp only [(hmap j k x (hLU hx)).2]
  
  let φ : X → ℝ := fun q =>
    if h : ∃ j, q ∈ P.O j then w h.choose (P.proj h.choose q) else 0
  have hφ : ∀ k, ∀ x ∈ P.W k, φ (P.param k x) = w k x := by
    intro k x hx
    have h : ∃ j, P.param k x ∈ P.O j := ⟨k, (hP1 k x hx).1⟩
    have e : φ (P.param k x) = w h.choose (P.proj h.choose (P.param k x)) := dif_pos h
    rw [e, hcons k h.choose x ⟨hx, h.choose_spec⟩]
  
  have hwnn : ∀ j, ∀ x ∈ P.W j, 0 ≤ w j x := fun j =>
    s4 (P.W j) (P.W_open j) (fun n x => u n (P.param j x)) (w j)
      (fun n => (hu n j).continuousOn) (fun n x hx => hnn n _ (hP1 j x hx).2)
      (hw j).continuousOn (hconv j)
  refine ⟨φ, hφ, ?_, ?_⟩
  · intro q hq
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hq)
    have hqim : q ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hj, hq⟩
    obtain ⟨x, hx, rfl⟩ := hqim
    rw [hφ j x hx]
    exact hwnn j x hx
  
  · by_contra H
    push_neg at H
    have hw0 : ∀ j, ∀ x ∈ P.W j, w j x = 0 := fun j x hx => by
      rw [← hφ j x hx]
      exact H _ (hP1 j x hx).2
    have hj : ∀ j, Tendsto (fun n => ∫ x in K j, (u n (P.param j x)) ^ 2) atTop (𝓝 0) := by
      intro j
      refine (hconv j (K j) (hK j).1 (hK j).2).congr (fun n => ?_)
      refine setIntegral_congr_fun (hK j).1.measurableSet (fun x hx => ?_)
      simp only [hw0 j x ((hK j).2 hx), sub_zero]
    have hlim := tendsto_finset_sum Finset.univ (fun j _ => hj j)
    rw [Finset.sum_const_zero] at hlim
    have := ge_of_tendsto' hlim hnd
    linarith

theorem eig_patched_principal {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X) (hS : IsCompact S) (P : EigPatchedSurface X S) (V : X → ℝ) (hV : ∀ j, ContDiffOn ℝ ∞ (fun x => V (P.param j x)) (P.W j)) : ∃ lam φ : X → ℝ, (∀ p ∈ S, ∃ U ∈ 𝓝 p, ∀ q ∈ U, q ∈ S → lam q = lam p) ∧ (∀ p ∈ S, 0 ≤ φ p) ∧ (∀ p ∈ S, ∃ q ∈ connectedComponentIn S p, φ q ≠ 0) ∧ ∀ j, ContDiffOn ℝ ∞ (fun x => φ (P.param j x)) (P.W j) ∧ ∀ x ∈ P.W j, lap2 (P.h j) (fun x' => φ (P.param j x')) x + (V (P.param j x) + lam (P.param j x)) * φ (P.param j x) = 0 :=
by
  classical
  
  have hlapc : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (f g : E2 → ℝ) (U : Set E2), IsOpen U →
      Set.EqOn f g U → ∀ x ∈ U, lap2 h f x = lap2 h g x := by
    intro h f g U hU hfg x hx
    have h1 : ∀ k : Fin 2, pd2 k f =ᶠ[𝓝 x] pd2 k g := by
      intro k
      filter_upwards [hU.mem_nhds hx] with y hy
      show fderiv ℝ f y (e2 k) = fderiv ℝ g y (e2 k)
      rw [Filter.EventuallyEq.fderiv_eq (hfg.eventuallyEq_of_mem (hU.mem_nhds hy))]
    have h2 : ∀ i k : Fin 2, pd2 i (pd2 k f) x = pd2 i (pd2 k g) x := by
      intro i k
      show fderiv ℝ _ x (e2 i) = fderiv ℝ _ x (e2 i)
      rw [Filter.EventuallyEq.fderiv_eq (h1 k)]
    have h3 : ∀ k : Fin 2, pd2 k f x = pd2 k g x := fun k => (h1 k).eq_of_nhds
    simp only [lap2, h2, h3]
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem.2
  
  have hloc : ∀ q ∈ S, ∃ N : Set X, IsOpen N ∧ q ∈ N ∧ N ∩ S ⊆ connectedComponentIn S q := by
    intro q hq
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hq)
    have hqim : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hj, hq⟩
    obtain ⟨x, hxW, rfl⟩ := hqim
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x hxW
    refine ⟨P.O j ∩ P.proj j ⁻¹' Metric.ball x r,
      (P.proj_cont j).isOpen_inter_preimage (P.O_open j) Metric.isOpen_ball, ⟨hj, ?_⟩, ?_⟩
    · show P.proj j (P.param j x) ∈ Metric.ball x r
      rw [P.proj_param j x hxW]
      exact Metric.mem_ball_self hr
    · have hconn : IsPreconnected (P.param j '' Metric.ball x r) :=
        (convex_ball x r).isPreconnected.image _ ((P.param_cont j).mono hball)
      have hsub : P.param j '' Metric.ball x r ⊆ connectedComponentIn S (P.param j x) :=
        hconn.subset_connectedComponentIn ⟨x, Metric.mem_ball_self hr, rfl⟩
          (by rintro _ ⟨z, hz, rfl⟩; exact hP1 j z (hball hz))
      rintro y ⟨⟨hyO, hyB⟩, hyS⟩
      have hyim : y ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hyO, hyS⟩
      obtain ⟨z, hzW, rfl⟩ := hyim
      apply hsub
      refine ⟨z, ?_, rfl⟩
      have hz : P.proj j (P.param j z) ∈ Metric.ball x r := hyB
      rwa [P.proj_param j z hzW] at hz
  choose! N hNo hqN hNS using hloc
  have hcomp : ∀ p ∈ S, ∃ U : Set X, IsOpen U ∧ U ∩ S = connectedComponentIn S p ∧
      IsCompact (connectedComponentIn S p) := by
    intro p hp
    refine ⟨⋃ q ∈ connectedComponentIn S p, N q,
      isOpen_biUnion (fun q hq => hNo q (connectedComponentIn_subset _ _ hq)), ?_, ?_⟩
    · ext y
      constructor
      · rintro ⟨hy, hyS⟩
        obtain ⟨q, hq, hyq⟩ := Set.mem_iUnion₂.1 hy
        have hqS : q ∈ S := connectedComponentIn_subset _ _ hq
        rw [connectedComponentIn_eq hq]
        exact hNS q hqS ⟨hyq, hyS⟩
      · intro hy
        have hyS : y ∈ S := connectedComponentIn_subset _ _ hy
        exact ⟨Set.mem_iUnion₂.2 ⟨y, hy, hqN y hyS⟩, hyS⟩
    · have hcl : closure (connectedComponentIn S p) ⊆ connectedComponentIn S p :=
        isPreconnected_connectedComponentIn.closure.subset_connectedComponentIn
          (subset_closure (mem_connectedComponentIn hp))
          (closure_minimal (connectedComponentIn_subset _ _) hS.isClosed)
      exact hS.of_isClosed_subset (isClosed_of_closure_subset hcl)
        (connectedComponentIn_subset _ _)
  
  have hcore : ∀ p ∈ S, ∃ (U : Set X) (lam : ℝ) (φ : X → ℝ), IsOpen U ∧
      U ∩ S = connectedComponentIn S p ∧ (∀ q ∈ U ∩ S, 0 ≤ φ q) ∧ (∃ q ∈ U ∩ S, φ q ≠ 0) ∧
      ∀ j, ContDiffOn ℝ ∞ (fun x => φ (P.param j x)) (P.W j ∩ P.param j ⁻¹' U) ∧
        ∀ x ∈ P.W j ∩ P.param j ⁻¹' U, lap2 (P.h j) (fun x' => φ (P.param j x')) x +
          (V (P.param j x) + lam) * φ (P.param j x) = 0 := by
    intro p hp
    obtain ⟨U, hUo, hUS, hCc⟩ := hcomp p hp
    have hC : IsCompact (U ∩ S) := by rw [hUS]; exact hCc
    have hne : (U ∩ S).Nonempty := ⟨p, by rw [hUS]; exact mem_connectedComponentIn hp⟩
    obtain ⟨P', hP'1, hP'2⟩ : ∃ P' : EigPatchedSurface X (U ∩ S),
        (∀ j : Fin P'.n, ∃ k : Fin P.n, P'.W j = P.W k ∩ P.param k ⁻¹' U ∧
          P'.param j = P.param k ∧ P'.h j = P.h k) ∧
        ∀ k : Fin P.n, ∃ j : Fin P'.n, P'.W j = P.W k ∩ P.param k ⁻¹' U ∧
          P'.param j = P.param k ∧ P'.h j = P.h k := by
      refine ⟨{ n := P.n
                W := fun j => P.W j ∩ P.param j ⁻¹' U
                param := P.param
                proj := P.proj
                O := fun j => P.O j ∩ U
                h := P.h
                W_open := fun j => (P.param_cont j).isOpen_inter_preimage (P.W_open j) hUo
                O_open := fun j => (P.O_open j).inter hUo
                param_cont := fun j => (P.param_cont j).mono Set.inter_subset_left
                proj_cont := fun j => (P.proj_cont j).mono Set.inter_subset_left
                image_eq := ?_
                proj_param := fun j x hx => P.proj_param j x hx.1
                cover := ?_
                trans_smooth := fun j k =>
                  (P.trans_smooth j k).mono (fun x hx => ⟨hx.1.1, hx.2.1⟩)
                h_smooth := fun j a b => (P.h_smooth j a b).mono Set.inter_subset_left
                h_posDef := fun j x hx => P.h_posDef j x hx.1
                h_compat := fun j k x hx a b => P.h_compat j k x ⟨hx.1.1, hx.2.1⟩ a b },
        fun j => ⟨j, rfl, rfl, rfl⟩, fun k => ⟨k, rfl, rfl, rfl⟩⟩
      · intro j
        show P.param j '' (P.W j ∩ P.param j ⁻¹' U) = (P.O j ∩ U) ∩ (U ∩ S)
        rw [Set.image_inter_preimage, P.image_eq j]
        ext y
        simp only [Set.mem_inter_iff]
        tauto
      · intro y hy
        obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hy.2)
        exact Set.mem_iUnion.2 ⟨j, hj, hy.1⟩
    have hV' : ∀ j, ContDiffOn ℝ ∞ (fun x => V (P'.param j x)) (P'.W j) := by
      intro j
      obtain ⟨k, hW, hpar, -⟩ := hP'1 j
      rw [hW, hpar]
      exact (hV k).mono Set.inter_subset_left
    obtain ⟨lam, u, δ, K, c₀, hu, hnn, hδ, hbd, hK, hc₀, hnd, hEL⟩ :=
      eig_variational_sequence (U ∩ S) hC hne P' V hV'
    obtain ⟨ψ, w, G, hψ, hL2, hconv, hgrad, hweak⟩ :=
      eig_local_weak_limit P'.n P'.W P'.W_open P'.h P'.h_smooth P'.h_posDef
        (fun j x => V (P'.param j x) + lam) (fun j => (hV' j).add contDiffOn_const)
        (fun n j x => u n (P'.param j x)) hu hbd δ hδ hEL
    have hreg : ∀ j, ∃ w' : E2 → ℝ, ContDiffOn ℝ ∞ w' (P'.W j) ∧
        (∀ᵐ x ∂(volume.restrict (P'.W j)), w j x = w' x) ∧
        ∀ x ∈ P'.W j, lap2 (P'.h j) w' x + (V (P'.param j x) + lam) * w' x = 0 := fun j =>
      eig_local_regularity (P'.W j) (P'.W_open j) (P'.h j) (P'.h_smooth j) (P'.h_posDef j)
        (fun x => V (P'.param j x) + lam) ((hV' j).add contDiffOn_const) (w j) (G j)
        (hL2 j) (hgrad j) (hweak j)
    choose w' hw's hw'ae hw'eq using hreg
    have hconv' : ∀ j (L : Set E2), IsCompact L → L ⊆ P'.W j →
        Tendsto (fun m => ∫ x in L, (u (ψ m) (P'.param j x) - w' j x) ^ 2) atTop (𝓝 0) := by
      intro j L hL hLW
      have hae : ∀ᵐ x ∂volume, x ∈ L → w j x = w' j x := by
        have h1 := (ae_restrict_iff' (P'.W_open j).measurableSet).1 (hw'ae j)
        filter_upwards [h1] with x hx hxL
        exact hx (hLW hxL)
      refine (hconv j L hL hLW).congr (fun m => ?_)
      refine setIntegral_congr_ae hL.isClosed.measurableSet ?_
      filter_upwards [hae] with x hx hxL
      rw [hx hxL]
    obtain ⟨φ, hφw, hφnn, q, hqS, hq0⟩ := eig_patch_limit_glue (U ∩ S) P' (fun n => u (ψ n))
      (fun n => hu (ψ n)) (fun n => hnn (ψ n)) K hK c₀ hc₀ (fun n => hnd (ψ n)) w' hw's hconv'
    refine ⟨U, lam, φ, hUo, hUS, hφnn, ⟨q, hqS, hq0⟩, fun k => ?_⟩
    obtain ⟨j, hW, hpar, hh⟩ := hP'2 k
    rw [← hW, ← hpar, ← hh]
    have hEq : Set.EqOn (fun x' => φ (P'.param j x')) (w' j) (P'.W j) := fun x hx => hφw j x hx
    refine ⟨(hw's j).congr hEq, fun x hx => ?_⟩
    rw [hlapc (P'.h j) _ (w' j) (P'.W j) (P'.W_open j) hEq x hx, hφw j x hx]
    exact hw'eq j x hx
  
  choose! Uc lamC φC hUo hUS hφnn hφnz hφeq using hcore
  let D : X → X := fun q =>
    if h : ∃ p, p ∈ S ∧ connectedComponentIn S p = connectedComponentIn S q then h.choose else q
  have hkey : ∀ (C C' : Set X) (h : ∃ p, p ∈ S ∧ connectedComponentIn S p = C)
      (h' : ∃ p, p ∈ S ∧ connectedComponentIn S p = C'), C = C' → h.choose = h'.choose := by
    rintro C C' h h' rfl
    rfl
  have hDS : ∀ q ∈ S, D q ∈ S ∧ connectedComponentIn S (D q) = connectedComponentIn S q := by
    intro q hq
    have hex : ∃ p, p ∈ S ∧ connectedComponentIn S p = connectedComponentIn S q := ⟨q, hq, rfl⟩
    have hD : D q = hex.choose := dif_pos hex
    rw [hD]
    exact hex.choose_spec
  have hDeq : ∀ q ∈ S, ∀ q', q' ∈ S →
      connectedComponentIn S q' = connectedComponentIn S q → D q' = D q := by
    intro q hq q' hq' hc
    have hex : ∃ p, p ∈ S ∧ connectedComponentIn S p = connectedComponentIn S q := ⟨q, hq, rfl⟩
    have hex' : ∃ p, p ∈ S ∧ connectedComponentIn S p = connectedComponentIn S q' :=
      ⟨q', hq', rfl⟩
    have hD : D q = hex.choose := dif_pos hex
    have hD' : D q' = hex'.choose := dif_pos hex'
    rw [hD, hD']
    exact hkey _ _ hex' hex hc
  have hU : ∀ q ∈ S, q ∈ Uc (D q) ∧ ∀ q' ∈ Uc (D q) ∩ S, D q' = D q := by
    intro q hq
    obtain ⟨hDqS, hDcc⟩ := hDS q hq
    have hUeq : Uc (D q) ∩ S = connectedComponentIn S q := by rw [hUS (D q) hDqS, hDcc]
    have hqU : q ∈ Uc (D q) ∩ S := by rw [hUeq]; exact mem_connectedComponentIn hq
    refine ⟨hqU.1, fun q' hq' => ?_⟩
    have hq'c : q' ∈ connectedComponentIn S q := by rw [← hUeq]; exact hq'
    exact hDeq q hq q' hq'.2 (connectedComponentIn_eq hq'c).symm
  refine ⟨fun q => lamC (D q), fun q => φC (D q) q, ?_, ?_, ?_, ?_⟩
  · intro p hp
    refine ⟨Uc (D p), (hUo (D p) (hDS p hp).1).mem_nhds (hU p hp).1, fun q hq hqS => ?_⟩
    show lamC (D q) = lamC (D p)
    rw [(hU p hp).2 q ⟨hq, hqS⟩]
  · intro p hp
    show 0 ≤ φC (D p) p
    exact hφnn (D p) (hDS p hp).1 p ⟨(hU p hp).1, hp⟩
  · intro p hp
    obtain ⟨q, hq, hq0⟩ := hφnz (D p) (hDS p hp).1
    refine ⟨q, ?_, ?_⟩
    · have hqc : q ∈ connectedComponentIn S (D p) := by
        rw [← hUS (D p) (hDS p hp).1]; exact hq
      rwa [(hDS p hp).2] at hqc
    · show φC (D q) q ≠ 0
      rw [(hU p hp).2 q hq]
      exact hq0
  · intro j
    have hloc2 : ∀ x ∈ P.W j, IsOpen (P.W j ∩ P.param j ⁻¹' Uc (D (P.param j x))) ∧
        x ∈ P.W j ∩ P.param j ⁻¹' Uc (D (P.param j x)) ∧
        Set.EqOn (fun x' => φC (D (P.param j x')) (P.param j x'))
          (fun x' => φC (D (P.param j x)) (P.param j x'))
          (P.W j ∩ P.param j ⁻¹' Uc (D (P.param j x))) := by
      intro x hx
      have hq := hP1 j x hx
      refine ⟨(P.param_cont j).isOpen_inter_preimage (P.W_open j) (hUo _ (hDS _ hq).1),
        ⟨hx, (hU _ hq).1⟩, fun x' hx' => ?_⟩
      show φC (D (P.param j x')) (P.param j x') = φC (D (P.param j x)) (P.param j x')
      rw [(hU _ hq).2 _ ⟨hx'.2, hP1 j x' hx'.1⟩]
    refine ⟨contDiffOn_of_locally_contDiffOn (fun x hx => ?_), fun x hx => ?_⟩
    · obtain ⟨ho, hxN, hEq⟩ := hloc2 x hx
      refine ⟨_, ho, hxN, ?_⟩
      refine ((hφeq _ (hDS _ (hP1 j x hx)).1 j).1.mono Set.inter_subset_right).congr ?_
      intro y hy
      exact hEq hy.2
    · obtain ⟨ho, hxN, hEq⟩ := hloc2 x hx
      show lap2 (P.h j) (fun x' => φC (D (P.param j x')) (P.param j x')) x +
        (V (P.param j x) + lamC (D (P.param j x))) * φC (D (P.param j x)) (P.param j x) = 0
      rw [hlapc (P.h j) _ _ _ ho hEq x hxN]
      exact (hφeq _ (hDS _ (hP1 j x hx)).1 j).2 x hxN

theorem esm_lap2_coeff_form (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hsm : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpd : ∀ x ∈ W, (h x).PosDef) : ∃ (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ), (∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) ∧ (∀ k : Fin 2, ContinuousOn (fun x => B x k) W) ∧ (∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i) ∧ (∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) ∧ ∀ (w : E2 → ℝ) (x : E2), lap2 h w x = ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x + ∑ k : Fin 2, B x k * pd2 k w x :=
by
  have hc : ∀ a b : Fin 2, ContinuousOn (fun x => h x a b) W :=
    fun a b => (hsm a b).continuousOn
  have hdetc : ContinuousOn (fun x => (h x).det) W := by
    simp only [Matrix.det_fin_two]
    exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
  have hdet : ∀ x ∈ W, (h x).det ≠ 0 := fun x hx => ((hpd x hx).det_pos).ne'
  have hinvc : ContinuousOn (fun x => ((h x).det)⁻¹) W := hdetc.inv₀ hdet
  have hform : ∀ (x : E2) (i j : Fin 2), (h x)⁻¹ i j = ((h x).det)⁻¹ * (h x).adjugate i j := by
    intro x i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hA : ∀ i j : Fin 2, ContinuousOn (fun x => (h x)⁻¹ i j) W := by
    intro i j
    simp only [hform]
    refine hinvc.mul ?_
    fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_two]
    · exact hc 1 1
    · exact (hc 0 1).neg
    · exact (hc 1 0).neg
    · exact hc 0 0
  have hpd2 : ∀ a b l : Fin 2, ContinuousOn (fun x => pd2 l (fun z => h z a b) x) W := by
    intro a b l
    exact ((hsm a b).continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
  have hΓ : ∀ k i j : Fin 2, ContinuousOn (fun x => christoffel2 h k i j x) W := by
    intro k i j
    unfold christoffel2
    refine continuousOn_const.mul ?_
    refine continuousOn_finset_sum _ (fun l _ => ?_)
    exact (hA k l).mul (((hpd2 j l i).add (hpd2 i l j)).sub (hpd2 i j l))
  refine ⟨fun x => (h x)⁻¹,
    fun x k => -(∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * christoffel2 h k i j x),
    hA, ?_, ?_, ?_, ?_⟩
  · intro k
    refine ContinuousOn.neg ?_
    refine continuousOn_finset_sum _ (fun i _ => ?_)
    refine continuousOn_finset_sum _ (fun j _ => ?_)
    exact (hA i j).mul (hΓ k i j)
  · intro x hx i j
    have hH := (hpd x hx).isHermitian.inv
    have h1 := hH.apply i j
    simp only [star_trivial] at h1
    exact h1.symm
  · intro x hx ξ hξ
    have hP := (hpd x hx).inv
    have hv : (fun i => ξ i) ≠ 0 := by
      intro h0
      apply hξ
      ext i
      simpa using congrFun h0 i
    have h1 := hP.dotProduct_mulVec_pos hv
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial] at h1
    simp only [Fin.sum_univ_two]
    linarith
  · intro w x
    simp only [lap2, Fin.sum_univ_two]
    ring

theorem esm_hopf_constants (W : Set E2) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ) (w c : E2 → ℝ) (hA : ∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) (hB : ∀ k : Fin 2, ContinuousOn (fun x => B x k) W) (hApos : ∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) (hwc : ContinuousOn w W) (hc : ContinuousOn c W) (z : E2) (R : ℝ) (hR : 0 < R) (hball : Metric.closedBall z R ⊆ W) (hpos : ∀ x ∈ Metric.ball z R, 0 < w x) : ∃ m₀ Λ β Γ m : ℝ, 0 < m₀ ∧ 0 ≤ Λ ∧ 0 ≤ β ∧ 0 ≤ Γ ∧ 0 < m ∧ (∀ x : E2, R / 2 ≤ dist x z → dist x z ≤ R → m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j ∧ (∀ i : Fin 2, |A x i i| ≤ Λ) ∧ (∀ k : Fin 2, |B x k| ≤ β) ∧ |c x| ≤ Γ) ∧ ∀ x : E2, dist x z = R / 2 → m ≤ w x :=
by
  
  have P1 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
      (∀ x ∈ K, 0 < f x) → ∃ m : ℝ, 0 < m ∧ ∀ x ∈ K, m ≤ f x := by
    intro K f hK hf hfpos
    rcases Set.eq_empty_or_nonempty K with hK0 | hKne
    · refine ⟨1, one_pos, ?_⟩
      intro x hx
      rw [hK0] at hx
      exact absurd hx (Set.notMem_empty x)
    · obtain ⟨x₀, hx₀, hmin⟩ := hK.exists_isMinOn hKne hf
      exact ⟨f x₀, hfpos x₀ hx₀, fun x hx => hmin hx⟩
  have P2 : ∀ (K : Set E2) (f : E2 → ℝ), IsCompact K → ContinuousOn f K →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ K, |f x| ≤ C := by
    intro K f hK hf
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf
    refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
    have := hC x hx
    rw [Real.norm_eq_abs] at this
    exact le_trans this (le_max_left _ _)
  
  set K : Set E2 := {x | R / 2 ≤ dist x z ∧ dist x z ≤ R} with hKdef
  have hKcl : IsClosed K :=
    (isClosed_le continuous_const (continuous_id.dist continuous_const)).inter
      (isClosed_le (continuous_id.dist continuous_const) continuous_const)
  have hKsub : K ⊆ Metric.closedBall z R := fun x hx => Metric.mem_closedBall.mpr hx.2
  have hKc : IsCompact K := (isCompact_closedBall z R).of_isClosed_subset hKcl hKsub
  have hKW : K ⊆ W := hKsub.trans hball
  have hSc : IsCompact (Metric.sphere z (R / 2)) := isCompact_sphere z (R / 2)
  have hSball : Metric.sphere z (R / 2) ⊆ Metric.ball z R :=
    Metric.sphere_subset_ball (by linarith)
  have hSW : Metric.sphere z (R / 2) ⊆ W :=
    hSball.trans (Metric.ball_subset_closedBall.trans hball)
  
  have hcoord : ∀ i : Fin 2, Continuous (fun x : E2 => (x - z) i) := fun i =>
    (PiLp.continuous_apply 2 (fun _ : Fin 2 => ℝ) i).comp (continuous_id.sub continuous_const)
  have hq : ContinuousOn
      (fun x => ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j) W := by
    apply continuousOn_finset_sum
    intro i _
    apply continuousOn_finset_sum
    intro j _
    exact (((hcoord i).continuousOn).mul (hA i j)).mul (hcoord j).continuousOn
  have hqpos : ∀ x ∈ K, 0 < ∑ i : Fin 2, ∑ j : Fin 2, (x - z) i * A x i j * (x - z) j := by
    intro x hx
    have hd : 0 < dist x z := lt_of_lt_of_le (by linarith) hx.1
    have hne : x - z ≠ 0 := sub_ne_zero.mpr (dist_pos.mp hd)
    exact hApos x (hKW hx) (x - z) hne
  
  obtain ⟨m₀, hm₀, hm₀K⟩ := P1 K _ hKc (hq.mono hKW) hqpos
  obtain ⟨C₀, hC₀, hC₀K⟩ := P2 K (fun x => A x 0 0) hKc ((hA 0 0).mono hKW)
  obtain ⟨C₁, hC₁, hC₁K⟩ := P2 K (fun x => A x 1 1) hKc ((hA 1 1).mono hKW)
  obtain ⟨D₀, hD₀, hD₀K⟩ := P2 K (fun x => B x 0) hKc ((hB 0).mono hKW)
  obtain ⟨D₁, hD₁, hD₁K⟩ := P2 K (fun x => B x 1) hKc ((hB 1).mono hKW)
  obtain ⟨Γ, hΓ, hΓK⟩ := P2 K c hKc (hc.mono hKW)
  obtain ⟨m, hm, hmS⟩ := P1 (Metric.sphere z (R / 2)) w hSc (hwc.mono hSW)
    (fun x hx => hpos x (hSball hx))
  refine ⟨m₀, C₀ + C₁, D₀ + D₁, Γ, m, hm₀, add_nonneg hC₀ hC₁, add_nonneg hD₀ hD₁, hΓ, hm,
    ?_, ?_⟩
  · intro x h1 h2
    have hxK : x ∈ K := ⟨h1, h2⟩
    have a0 : |A x 0 0| ≤ C₀ := hC₀K x hxK
    have a1 : |A x 1 1| ≤ C₁ := hC₁K x hxK
    have b0 : |B x 0| ≤ D₀ := hD₀K x hxK
    have b1 : |B x 1| ≤ D₁ := hD₁K x hxK
    refine ⟨hm₀K x hxK, ?_, ?_, hΓK x hxK⟩
    · rw [Fin.forall_fin_two]
      exact ⟨by linarith, by linarith⟩
    · rw [Fin.forall_fin_two]
      exact ⟨by linarith, by linarith⟩
  · intro x hx
    exact hmS x (Metric.mem_sphere.mpr hx)

theorem esm_barrier_derivs (z : E2) (α R : ℝ) (v : E2 → ℝ) (hv : ∀ x, v x = Real.exp (-α * ‖x - z‖ ^ 2) - Real.exp (-α * R ^ 2)) : ContDiff ℝ ∞ v ∧ (∀ x d : E2, fderiv ℝ v x d = -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2)) ∧ (∀ (x : E2) (j : Fin 2), pd2 j v x = -2 * α * (x - z) j * Real.exp (-α * ‖x - z‖ ^ 2)) ∧ ∀ (x : E2) (i j : Fin 2), pd2 i (pd2 j v) x = (4 * α ^ 2 * (x - z) i * (x - z) j - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖x - z‖ ^ 2) :=
by
  have hv' : v = fun y => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2) := funext hv
  subst hv'
  have hinner : ∀ x d : E2, inner ℝ (x - z) d = ∑ k : Fin 2, (x - z) k * d k := by
    intro x d
    simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
    exact Finset.sum_congr rfl (fun k _ => mul_comm _ _)
  have hE : ∀ x : E2, ∃ E' : E2 →L[ℝ] ℝ,
      HasFDerivAt (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2)) E' x ∧
      ∀ d : E2, E' d = -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2) := by
    intro x
    have h1 : HasFDerivAt (fun y : E2 => y - z) (ContinuousLinearMap.id ℝ E2) x :=
      (hasFDerivAt_id x).sub_const z
    refine ⟨_, (h1.norm_sq.const_mul (-α)).exp, fun d => ?_⟩
    rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.id_apply, innerSL_apply_apply, hinner]
    simp only [smul_eq_mul, nsmul_eq_mul]
    push_cast
    ring
  have h2 : ∀ x d : E2, fderiv ℝ (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2)) x d
      = -2 * α * (∑ k : Fin 2, (x - z) k * d k) * Real.exp (-α * ‖x - z‖ ^ 2) := by
    intro x d
    obtain ⟨E', hE1, hE2⟩ := hE x
    rw [(hE1.sub_const (Real.exp (-α * R ^ 2))).fderiv, hE2]
  have hsingle : ∀ (x : E2) (j : Fin 2), ∑ k : Fin 2, (x - z) k * (e2 j) k = (x - z) j := by
    intro x j
    simp [e2, EuclideanSpace.single_apply]
  have h3 : ∀ (x : E2) (j : Fin 2),
      pd2 j (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2)) x
        = -2 * α * (x - z) j * Real.exp (-α * ‖x - z‖ ^ 2) := by
    intro x j
    show fderiv ℝ _ x (e2 j) = _
    rw [h2, hsingle]
  refine ⟨?_, h2, h3, ?_⟩
  · exact ((contDiff_const.mul ((contDiff_id.sub contDiff_const).norm_sq ℝ)).exp).sub
      contDiff_const
  · intro x i j
    have hfun : pd2 j (fun y : E2 => Real.exp (-α * ‖y - z‖ ^ 2) - Real.exp (-α * R ^ 2))
        = fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2)) := by
      funext y
      rw [h3]
      ring
    rw [hfun]
    show fderiv ℝ (fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2))) x (e2 i) = _
    have hc : HasFDerivAt (fun y : E2 => (y - z) j) (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j) x := by
      have h0 : HasFDerivAt (fun f : E2 => f.ofLp j) (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j) x :=
        PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 x j
      have h := h0.sub_const (z j)
      refine h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
      simp
    obtain ⟨E', hE1, hE2⟩ := hE x
    have hP : HasFDerivAt (fun y : E2 => -2 * α * ((y - z) j * Real.exp (-α * ‖y - z‖ ^ 2)))
        ((-2 * α) • ((x - z) j • E' + Real.exp (-α * ‖x - z‖ ^ 2) •
          PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 2 => ℝ) j)) x :=
      (hc.mul hE1).const_mul (-2 * α)
    rw [hP.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, smul_eq_mul,
      hE2, PiLp.proj_apply, hsingle]
    simp only [e2, EuclideanSpace.single_apply]
    by_cases hij : i = j
    · subst hij
      simp only [if_true]
      ring
    · simp only [hij, Ne.symm hij, if_false]
      ring

theorem esm_annulus_min_principle (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ) (u : E2 → ℝ) (Γ : ℝ) (z : E2) (R : ℝ) (hR : 0 < R) (hball : Metric.closedBall z R ⊆ W) (hu : ContDiffOn ℝ ∞ u W) (hAs : ∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i) (hApsd : ∀ x ∈ W, ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) (hΓ : 0 ≤ Γ) (hstrict : ∀ x : E2, R / 2 < dist x z → dist x z < R → ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j u) x + ∑ k : Fin 2, B x k * pd2 k u x - Γ * u x < 0) (hin : ∀ x : E2, dist x z = R / 2 → 0 ≤ u x) (hout : ∀ x : E2, dist x z = R → 0 ≤ u x) : ∀ x : E2, R / 2 ≤ dist x z → dist x z ≤ R → 0 ≤ u x :=
by
  
  have s2 : ∀ (g : ℝ → ℝ) (a : ℝ), IsLocalMin g a → ContinuousAt g a →
      0 ≤ deriv (deriv g) a := by
    intro g a hmin hc
    by_contra h
    push_neg at h
    have hd : deriv g a = 0 := hmin.deriv_eq_zero
    have hmax : IsLocalMax g a := isLocalMax_of_deriv_deriv_neg h hd hc
    have hconst : g =ᶠ[𝓝 a] fun _ => g a :=
      (hmin.and hmax).mono fun t ht => le_antisymm ht.2 ht.1
    have h0 : deriv g =ᶠ[𝓝 a] fun _ => (0 : ℝ) :=
      hconst.deriv.mono fun t ht => by rw [ht, deriv_const]
    have h00 : deriv (deriv g) a = 0 := by
      rw [h0.deriv_eq, deriv_const]
    linarith
  
  have s4 : ∀ (M H : Matrix (Fin 2) (Fin 2) ℝ), (∀ i j : Fin 2, M i j = M j i) →
      (∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * M i j * ξ j) →
      (∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * H i j * ξ j) →
      0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, M i j * H i j := by
    intro M H hMs hM hH
    have key : ∀ (N : Matrix (Fin 2) (Fin 2) ℝ) (a b : ℝ),
        ∑ i : Fin 2, ∑ j : Fin 2, (!₂[a, b] : E2) i * N i j * (!₂[a, b] : E2) j
          = a * N 0 0 * a + a * N 0 1 * b + (b * N 1 0 * a + b * N 1 1 * b) := by
      intro N a b
      simp [Fin.sum_univ_two]
    have kH : ∀ a b : ℝ, 0 ≤ a * H 0 0 * a + a * H 0 1 * b + (b * H 1 0 * a + b * H 1 1 * b) := by
      intro a b
      have := hH !₂[a, b]
      rwa [key] at this
    have kM : ∀ a b : ℝ, 0 ≤ a * M 0 0 * a + a * M 0 1 * b + (b * M 1 0 * a + b * M 1 1 * b) := by
      intro a b
      have := hM !₂[a, b]
      rwa [key] at this
    have hM10 : M 1 0 = M 0 1 := hMs 1 0
    simp only [Fin.sum_univ_two]
    have hp := kH 1 0
    have hs := kH 0 1
    have hd := kM 0 1
    have h4 := kH (-((H 0 1 + H 1 0) / 2)) (H 0 0)
    have h5 := kM (H 0 0) ((H 0 1 + H 1 0) / 2)
    rw [hM10] at h5 ⊢
    have hp' : 0 ≤ H 0 0 := by linarith
    have hs' : 0 ≤ H 1 1 := by linarith
    have hd' : 0 ≤ M 1 1 := by linarith
    rcases hp'.lt_or_eq with hpos | hzero
    · have e4 : H 0 0 * (H 0 0 * H 1 1 - ((H 0 1 + H 1 0) / 2) ^ 2) ≥ 0 := by
        nlinarith
      have hdisc : 0 ≤ H 0 0 * H 1 1 - ((H 0 1 + H 1 0) / 2) ^ 2 := by
        by_contra hc
        push_neg at hc
        have := mul_neg_of_pos_of_neg hpos hc
        linarith
      have e5 : H 0 0 * (M 0 0 * H 0 0 + M 0 1 * H 0 1 + (M 0 1 * H 1 0 + M 1 1 * H 1 1))
          = (H 0 0 * M 0 0 * H 0 0 + H 0 0 * M 0 1 * ((H 0 1 + H 1 0) / 2)
              + (((H 0 1 + H 1 0) / 2) * M 0 1 * H 0 0
                + ((H 0 1 + H 1 0) / 2) * M 1 1 * ((H 0 1 + H 1 0) / 2)))
            + M 1 1 * (H 0 0 * H 1 1 - ((H 0 1 + H 1 0) / 2) ^ 2) := by
        ring
      have hprod : 0 ≤ H 0 0 * (M 0 0 * H 0 0 + M 0 1 * H 0 1 + (M 0 1 * H 1 0 + M 1 1 * H 1 1)) := by
        rw [e5]
        have := mul_nonneg hd' hdisc
        linarith
      by_contra hc
      push_neg at hc
      have := mul_neg_of_pos_of_neg hpos hc
      linarith
    · have hp0 : H 0 0 = 0 := hzero.symm
      have h6 := kH (-(1 + H 1 1)) ((H 0 1 + H 1 0) / 2)
      rw [hp0] at h6
      have e6 : -(1 + H 1 1) * 0 * -(1 + H 1 1) + -(1 + H 1 1) * H 0 1 * ((H 0 1 + H 1 0) / 2)
          + ((H 0 1 + H 1 0) / 2 * H 1 0 * -(1 + H 1 1)
            + (H 0 1 + H 1 0) / 2 * H 1 1 * ((H 0 1 + H 1 0) / 2))
          = -(((H 0 1 + H 1 0) / 2) ^ 2 * (2 + H 1 1)) := by
        ring
      rw [e6] at h6
      have hq2 : ((H 0 1 + H 1 0) / 2) ^ 2 * (2 + H 1 1) ≤ 0 := by linarith
      have hq0 : ((H 0 1 + H 1 0) / 2) ^ 2 ≤ 0 := by
        by_contra hc
        push_neg at hc
        have := mul_pos hc (show (0 : ℝ) < 2 + H 1 1 by linarith)
        linarith
      have hq : H 0 1 + H 1 0 = 0 := by
        have : (H 0 1 + H 1 0) / 2 = 0 := by
          have := sq_nonneg ((H 0 1 + H 1 0) / 2)
          exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp (le_antisymm hq0 this)
        linarith
      have e7 : M 0 0 * H 0 0 + M 0 1 * H 0 1 + (M 0 1 * H 1 0 + M 1 1 * H 1 1)
          = M 0 0 * H 0 0 + M 0 1 * (H 0 1 + H 1 0) + M 1 1 * H 1 1 := by ring
      rw [e7, hq, hp0]
      have := mul_nonneg hd' hs'
      linarith
  
  have s3 : ∀ (x ξ : E2), x ∈ W → ContinuousAt (fun t : ℝ => u (x + t • ξ)) 0 ∧
      deriv (deriv (fun t : ℝ => u (x + t • ξ))) 0
        = ∑ i : Fin 2, ∑ j : Fin 2, ξ i * pd2 i (pd2 j u) x * ξ j := by
    intro x ξ hx
    have hp : ∀ t : ℝ, HasDerivAt (fun t : ℝ => x + t • ξ) ξ t := by
      intro t
      simpa using ((hasDerivAt_id t).smul_const ξ).const_add x
    have hpc : Continuous (fun t : ℝ => x + t • ξ) :=
      continuous_const.add (continuous_id.smul continuous_const)
    have hdiff : ∀ y ∈ W, DifferentiableAt ℝ u y := fun y hy =>
      (hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
    have hx0 : x + (0 : ℝ) • ξ = x := by simp
    have h0T : (0 : ℝ) ∈ (fun t : ℝ => x + t • ξ) ⁻¹' W := by
      show x + (0 : ℝ) • ξ ∈ W
      rw [hx0]; exact hx
    have hT : (fun t : ℝ => x + t • ξ) ⁻¹' W ∈ 𝓝 (0 : ℝ) :=
      (hW.preimage hpc).mem_nhds h0T
    have hlin : ∀ L : E2 →L[ℝ] ℝ, L ξ = ξ 0 * L (e2 0) + ξ 1 * L (e2 1) := by
      intro L
      have hξ : ξ = ξ 0 • e2 0 + ξ 1 • e2 1 := by
        ext i
        fin_cases i <;> simp [e2]
      conv_lhs => rw [hξ]
      rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    have hg1 : ∀ t ∈ (fun t : ℝ => x + t • ξ) ⁻¹' W,
        HasDerivAt (fun t : ℝ => u (x + t • ξ)) (fderiv ℝ u (x + t • ξ) ξ) t := by
      intro t ht
      exact (hdiff _ ht).hasFDerivAt.comp_hasDerivAt t (hp t)
    have hev : deriv (fun t : ℝ => u (x + t • ξ)) =ᶠ[𝓝 0]
        fun t => ξ 0 * pd2 0 u (x + t • ξ) + ξ 1 * pd2 1 u (x + t • ξ) := by
      filter_upwards [hT] with t ht
      rw [(hg1 t ht).deriv, hlin]
      rfl
    have hpd : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j u) x := by
      intro j
      have hc : ContDiffOn ℝ ∞ (fun y => fderiv ℝ u y (e2 j)) W :=
        (hu.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
      exact (hc.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hφ : HasFDerivAt (fun y => ξ 0 * pd2 0 u y + ξ 1 * pd2 1 u y)
        (ξ 0 • fderiv ℝ (pd2 0 u) x + ξ 1 • fderiv ℝ (pd2 1 u) x) (x + (0 : ℝ) • ξ) := by
      rw [hx0]
      exact ((hpd 0).hasFDerivAt.const_mul (ξ 0)).add ((hpd 1).hasFDerivAt.const_mul (ξ 1))
    have hcomp : HasDerivAt
        (fun t : ℝ => ξ 0 * pd2 0 u (x + t • ξ) + ξ 1 * pd2 1 u (x + t • ξ))
        ((ξ 0 • fderiv ℝ (pd2 0 u) x + ξ 1 • fderiv ℝ (pd2 1 u) x) ξ) 0 := by
      have := hφ.comp_hasDerivAt (0 : ℝ) (hp 0)
      exact this
    have hpd2 : ∀ i j : Fin 2, fderiv ℝ (pd2 j u) x (e2 i) = pd2 i (pd2 j u) x :=
      fun _ _ => rfl
    refine ⟨(hg1 0 h0T).continuousAt, ?_⟩
    rw [hev.deriv_eq, hcomp.deriv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hlin (fderiv ℝ (pd2 0 u) x), hlin (fderiv ℝ (pd2 1 u) x)]
    simp only [hpd2, Fin.sum_univ_two]
    ring
  
  intro x₀ hx₀1 hx₀2
  have hKc : IsCompact ({x : E2 | R / 2 ≤ dist x z} ∩ {x | dist x z ≤ R}) := by
    refine (isCompact_closedBall z R).of_isClosed_subset ?_ ?_
    · exact (isClosed_le continuous_const (continuous_id.dist continuous_const)).inter
        (isClosed_le (continuous_id.dist continuous_const) continuous_const)
    · intro x hx
      exact Metric.mem_closedBall.2 hx.2
  have hKW : {x : E2 | R / 2 ≤ dist x z} ∩ {x | dist x z ≤ R} ⊆ W :=
    fun x hx => hball (Metric.mem_closedBall.2 hx.2)
  have hx₀K : x₀ ∈ {x : E2 | R / 2 ≤ dist x z} ∩ {x | dist x z ≤ R} := ⟨hx₀1, hx₀2⟩
  obtain ⟨xs, hxsK, hxsmin⟩ := hKc.exists_isMinOn ⟨x₀, hx₀K⟩ (hu.continuousOn.mono hKW)
  have hmn := isMinOn_iff.mp hxsmin
  have hle : u xs ≤ u x₀ := hmn x₀ hx₀K
  by_contra hneg0
  push_neg at hneg0
  have hneg : u xs < 0 := lt_of_le_of_lt hle hneg0
  have h1 : R / 2 < dist xs z := lt_of_le_of_ne hxsK.1 (fun h => by
    have := hin xs h.symm
    linarith)
  have h2 : dist xs z < R := lt_of_le_of_ne hxsK.2 (fun h => by
    have := hout xs h
    linarith)
  have hxsW : xs ∈ W := hKW hxsK
  have hO : IsOpen ({x : E2 | R / 2 < dist x z} ∩ {x | dist x z < R}) :=
    (isOpen_lt continuous_const (continuous_id.dist continuous_const)).inter
      (isOpen_lt (continuous_id.dist continuous_const) continuous_const)
  have hmin : IsLocalMin u xs := by
    refine Filter.eventually_of_mem (hO.mem_nhds ⟨h1, h2⟩) ?_
    intro y hy
    obtain ⟨hy1, hy2⟩ := hy
    simp only [Set.mem_setOf_eq] at hy1 hy2
    exact hmn y ⟨le_of_lt hy1, le_of_lt hy2⟩
  have hfd : fderiv ℝ u xs = 0 := hmin.fderiv_eq_zero
  have hB : ∑ k : Fin 2, B xs k * pd2 k u xs = 0 := by
    simp [pd2, hfd]
  have hH : ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2,
      ξ i * (Matrix.of fun i j => pd2 i (pd2 j u) xs) i j * ξ j := by
    intro ξ
    obtain ⟨hc, hQ⟩ := s3 xs ξ hxsW
    have hloc : IsLocalMin (fun t : ℝ => u (xs + t • ξ)) 0 := by
      have hcont : Filter.Tendsto (fun t : ℝ => xs + t • ξ) (𝓝 0) (𝓝 xs) := by
        have := ((continuous_const.add (continuous_id.smul continuous_const) :
          Continuous (fun t : ℝ => xs + t • ξ))).tendsto 0
        simpa using this
      have h0 : ∀ᶠ y in 𝓝 xs, u xs ≤ u y := hmin
      have h1' := hcont.eventually h0
      have hz : u (xs + (0 : ℝ) • ξ) = u xs := by simp
      show ∀ᶠ t in 𝓝 (0 : ℝ), u (xs + (0 : ℝ) • ξ) ≤ u (xs + t • ξ)
      rw [hz]
      exact h1'
    have := s2 _ 0 hloc hc
    rw [hQ] at this
    simp only [Matrix.of_apply]
    exact this
  have hT := s4 (A xs) (Matrix.of fun i j => pd2 i (pd2 j u) xs) (hAs xs hxsW)
    (hApsd xs hxsW) hH
  simp only [Matrix.of_apply] at hT
  have hst := hstrict xs h1 h2
  rw [hB] at hst
  have : Γ * u xs ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hΓ hneg.le
  linarith

theorem esm_hopf_touching (W : Set E2) (hW : IsOpen W) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (B : E2 → Fin 2 → ℝ) (w c : E2 → ℝ) (hA : ∀ i j : Fin 2, ContinuousOn (fun x => A x i j) W) (hB : ∀ k : Fin 2, ContinuousOn (fun x => B x k) W) (hAs : ∀ x ∈ W, ∀ i j : Fin 2, A x i j = A x j i) (hApos : ∀ x ∈ W, ∀ ξ : E2, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j) (hw : ContDiffOn ℝ ∞ w W) (hc : ContinuousOn c W) (hnn : ∀ x ∈ W, 0 ≤ w x) (heq : ∀ x ∈ W, ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x + ∑ k : Fin 2, B x k * pd2 k w x + c x * w x = 0) (z x₁ : E2) (R : ℝ) (hR : 0 < R) (hball : Metric.closedBall z R ⊆ W) (hpos : ∀ x ∈ Metric.ball z R, 0 < w x) (hx₁ : dist x₁ z = R) (hw₁ : w x₁ = 0) : False :=
by
  
  have hx₁W : x₁ ∈ W := hball (by rw [Metric.mem_closedBall, hx₁])
  have hmin1 : IsLocalMin w x₁ := by
    filter_upwards [hW.mem_nhds hx₁W] with y hy
    rw [hw₁]
    exact hnn y hy
  have hdw1 : fderiv ℝ w x₁ = 0 := hmin1.fderiv_eq_zero
  
  obtain ⟨m₀, Λ, β, Γ, m, hm₀, hΛ, hβ, hΓ, hm, hK, hSin⟩ :=
    esm_hopf_constants W A B w c hA hB hApos hw.continuousOn hc z R hR hball hpos
  obtain ⟨α, hα⟩ : ∃ α : ℝ, α = 1 + (4 * Λ + 4 * β * R + Γ) / (4 * m₀) := ⟨_, rfl⟩
  have hα1 : 1 ≤ α := by
    have : 0 ≤ (4 * Λ + 4 * β * R + Γ) / (4 * m₀) := by positivity
    linarith
  have hα0 : 0 < α := by linarith
  
  have hbar : ∀ (a : Matrix (Fin 2) (Fin 2) ℝ) (b : Fin 2 → ℝ) (y : E2),
      m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j → (∀ i : Fin 2, |a i i| ≤ Λ) →
      (∀ k : Fin 2, |b k| ≤ β) → ‖y‖ ≤ R →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, b k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2))
        - Γ * (Real.exp (-α * ‖y‖ ^ 2) - Real.exp (-α * R ^ 2)) := by
    intro a b y hq ha hb hy
    have hE := Real.exp_pos (-α * ‖y‖ ^ 2)
    have hER := Real.exp_pos (-α * R ^ 2)
    have hy0 : |y 0| ≤ R := by
      have := PiLp.norm_apply_le y 0
      rw [Real.norm_eq_abs] at this
      linarith
    have hy1 : |y 1| ≤ R := by
      have := PiLp.norm_apply_le y 1
      rw [Real.norm_eq_abs] at this
      linarith
    have htr : a 0 0 + a 1 1 ≤ 2 * Λ := by
      have h0 := le_abs_self (a 0 0)
      have h1 := le_abs_self (a 1 1)
      linarith [ha 0, ha 1]
    have hb0 : b 0 * y 0 ≤ β * R := by
      calc b 0 * y 0 ≤ |b 0 * y 0| := le_abs_self _
        _ = |b 0| * |y 0| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hb 0) hy0 (abs_nonneg _) hβ
    have hb1 : b 1 * y 1 ≤ β * R := by
      calc b 1 * y 1 ≤ |b 1 * y 1| := le_abs_self _
        _ = |b 1| * |y 1| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hb 1) hy1 (abs_nonneg _) hβ
    have h4 : 4 * α * m₀ = 4 * m₀ + 4 * Λ + 4 * β * R + Γ := by
      rw [hα]
      field_simp
      ring
    set q := ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j with hqdef
    have hP : 0 < 4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1) - 2 * α * (b 0 * y 0 + b 1 * y 1) - Γ := by
      have e1 : 4 * α ^ 2 * m₀ ≤ 4 * α ^ 2 * q := by
        have : 0 ≤ 4 * α ^ 2 := by positivity
        exact mul_le_mul_of_nonneg_left hq this
      have e2 : 2 * α * (a 0 0 + a 1 1) ≤ 2 * α * (2 * Λ) :=
        mul_le_mul_of_nonneg_left htr (by positivity)
      have e3 : 2 * α * (b 0 * y 0 + b 1 * y 1) ≤ 2 * α * (2 * β * R) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have e4 : 4 * α ^ 2 * m₀ - 4 * α * Λ - 4 * α * β * R - Γ = 4 * α * m₀ + (α - 1) * Γ := by
        linear_combination α * h4
      have e5 : 0 < 4 * α * m₀ + (α - 1) * Γ := by
        have : 0 ≤ (α - 1) * Γ := mul_nonneg (by linarith) hΓ
        have : 0 < 4 * α * m₀ := by positivity
        linarith
      nlinarith
    have hkey : ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, b k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2))
        - Γ * (Real.exp (-α * ‖y‖ ^ 2) - Real.exp (-α * R ^ 2))
        = Real.exp (-α * ‖y‖ ^ 2) * (4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1)
          - 2 * α * (b 0 * y 0 + b 1 * y 1) - Γ) + Γ * Real.exp (-α * R ^ 2) := by
      rw [hqdef]
      simp only [Fin.sum_univ_two, if_pos (rfl : (0 : Fin 2) = 0), if_pos (rfl : (1 : Fin 2) = 1),
        if_neg (show ¬((0 : Fin 2) = 1) by decide), if_neg (show ¬((1 : Fin 2) = 0) by decide),
        if_true]
      ring
    rw [hkey]
    have := mul_pos hE hP
    have := mul_nonneg hΓ hER.le
    linarith
  obtain ⟨v, hv⟩ : ∃ v : E2 → ℝ, ∀ x, v x = Real.exp (-α * ‖x - z‖ ^ 2) - Real.exp (-α * R ^ 2) :=
    ⟨_, fun x => rfl⟩
  obtain ⟨hvs, hvD, hv1, hv2⟩ := esm_barrier_derivs z α R v hv
  have hV1 : ∀ x, dist x z = R → v x = 0 := by
    intro x hx
    rw [hv, ← dist_eq_norm, hx, sub_self]
  have hV2 : ∀ x, v x ≤ 1 := by
    intro x
    have h1 : Real.exp (-α * ‖x - z‖ ^ 2) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have := sq_nonneg ‖x - z‖
      nlinarith
    have h2 := Real.exp_pos (-α * R ^ 2)
    rw [hv]
    linarith
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : E2, y₀ = (1 / 2 : ℝ) • (z - x₁) := ⟨_, rfl⟩
  have hV3 : 0 < fderiv ℝ v x₁ y₀ := by
    rw [hvD x₁ y₀]
    have hs : ∑ k : Fin 2, (x₁ - z) k * y₀ k = -(1 / 2) * ‖x₁ - z‖ ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [hy₀, Fin.sum_univ_two, Real.norm_eq_abs, sq_abs]
      ring
    rw [hs, ← dist_eq_norm, hx₁]
    rw [show -2 * α * (-(1 / 2) * R ^ 2) = α * R ^ 2 by ring]
    positivity
  
  have hu : ContDiffOn ℝ ∞ (fun x => w x - m * v x) W :=
    hw.sub (contDiffOn_const.mul hvs.contDiffOn)
  
  have hlin : ∀ x ∈ W, fderiv ℝ (fun y => w y - m * v y) x = fderiv ℝ w x - m • fderiv ℝ v x ∧
      (∀ k : Fin 2, pd2 k (fun y => w y - m * v y) x = pd2 k w x - m * pd2 k v x) ∧
      ∀ i j : Fin 2, pd2 i (pd2 j (fun y => w y - m * v y)) x
        = pd2 i (pd2 j w) x - m * pd2 i (pd2 j v) x := by
    intro x hx
    have hdf : ∀ y ∈ W, DifferentiableAt ℝ w y := fun y hy =>
      (hw.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
    have hdg : ∀ y, DifferentiableAt ℝ v y := fun y => hvs.differentiable (by simp) y
    have h1 : ∀ y ∈ W, fderiv ℝ (fun y => w y - m * v y) y = fderiv ℝ w y - m • fderiv ℝ v y := by
      intro y hy
      exact ((hdf y hy).hasFDerivAt.sub ((hdg y).hasFDerivAt.const_mul m)).fderiv
    have h2 : ∀ y ∈ W, ∀ k : Fin 2,
        pd2 k (fun y => w y - m * v y) y = pd2 k w y - m * pd2 k v y := by
      intro y hy k
      show fderiv ℝ (fun y => w y - m * v y) y (e2 k)
        = fderiv ℝ w y (e2 k) - m * fderiv ℝ v y (e2 k)
      rw [h1 y hy]
      rfl
    have hdpf : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ w y (e2 j)) x := by
      intro j
      have hc : ContDiffOn ℝ ∞ (fun y => fderiv ℝ w y (e2 j)) W :=
        (hw.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
      exact (hc.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hdpg : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ v y (e2 j)) x := by
      intro j
      have hc : ContDiff ℝ ∞ (fun y => fderiv ℝ v y (e2 j)) :=
        (hvs.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
      exact hc.differentiable (by simp) x
    refine ⟨h1 x hx, h2 x hx, fun i j => ?_⟩
    have hev : pd2 j (fun y => w y - m * v y) =ᶠ[𝓝 x]
        fun y => fderiv ℝ w y (e2 j) - m * fderiv ℝ v y (e2 j) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => h2 y hy j)
    show fderiv ℝ (pd2 j (fun y => w y - m * v y)) x (e2 i)
      = fderiv ℝ (fun y => fderiv ℝ w y (e2 j)) x (e2 i)
        - m * fderiv ℝ (fun y => fderiv ℝ v y (e2 j)) x (e2 i)
    rw [hev.fderiv_eq]
    have hD := ((hdpf j).hasFDerivAt.sub ((hdpg j).hasFDerivAt.const_mul m)).fderiv
    exact congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) hD
  have hstrict : ∀ x : E2, R / 2 < dist x z → dist x z < R →
      ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j (fun x => w x - m * v x)) x
        + ∑ k : Fin 2, B x k * pd2 k (fun x => w x - m * v x) x
        - Γ * (fun x => w x - m * v x) x < 0 := by
    intro x h1 h2
    have hxW : x ∈ W := hball (by rw [Metric.mem_closedBall]; exact h2.le)
    obtain ⟨-, hp1, hp2⟩ := hlin x hxW
    obtain ⟨hq, ha, hb, hcx⟩ := hK x h1.le h2.le
    have hineq := hbar (A x) (B x) (x - z) hq ha hb
      (by rw [← dist_eq_norm]; exact h2.le)
    have he := heq x hxW
    have hcw : 0 ≤ (c x + Γ) * w x :=
      mul_nonneg (by linarith [neg_abs_le (c x)]) (hnn x hxW)
    have hTv := mul_pos hm hineq
    simp only [hp1, hp2, hv1, hv2, hv x] at hTv ⊢
    simp only [Fin.sum_univ_two] at hTv he ⊢
    linarith
  have hout : ∀ x : E2, dist x z = R → 0 ≤ (fun x => w x - m * v x) x := by
    intro x hx
    have hxW : x ∈ W := hball (by rw [Metric.mem_closedBall, hx])
    show 0 ≤ w x - m * v x
    rw [hV1 x hx, mul_zero, sub_zero]
    exact hnn x hxW
  have hin : ∀ x : E2, dist x z = R / 2 → 0 ≤ (fun x => w x - m * v x) x := by
    intro x hx
    have h1 := hSin x hx
    have h2 := hV2 x
    show 0 ≤ w x - m * v x
    nlinarith
  
  have hApsd : ∀ x ∈ W, ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j := by
    intro x hx ξ
    by_cases hξ : ξ = 0
    · subst hξ
      simp
    · exact (hApos x hx ξ hξ).le
  have hmp := esm_annulus_min_principle W hW A B (fun x => w x - m * v x) Γ z R hR hball hu hAs
    hApsd hΓ hstrict hin hout
  
  have hu1 : w x₁ - m * v x₁ = 0 := by
    rw [hw₁, hV1 x₁ hx₁]
    ring
  have hseg : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      (fun x => w x - m * v x) x₁ ≤ (fun x => w x - m * v x) (x₁ + t • y₀) := by
    intro t ht0 ht1
    have hd : dist (x₁ + t • y₀) z = (1 - t / 2) * R := by
      have e1 : x₁ + t • y₀ - z = (1 - t / 2) • (x₁ - z) := by
        rw [hy₀]
        module
      rw [dist_eq_norm, e1, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith),
        ← dist_eq_norm, hx₁]
    show w x₁ - m * v x₁ ≤ w (x₁ + t • y₀) - m * v (x₁ + t • y₀)
    rw [hu1]
    exact hmp _ (by rw [hd]; nlinarith) (by rw [hd]; nlinarith)
  have hdu : DifferentiableAt ℝ (fun x => w x - m * v x) x₁ :=
    (hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx₁W)
  have h11 : 0 ≤ fderiv ℝ (fun x => w x - m * v x) x₁ y₀ := by
    have hminOn : IsLocalMinOn (fun x => w x - m * v x) (segment ℝ x₁ (x₁ + y₀)) x₁ := by
      apply Filter.eventually_of_mem self_mem_nhdsWithin
      intro p hp
      rw [segment_eq_image'] at hp
      obtain ⟨θ, ⟨h0, h1⟩, rfl⟩ := hp
      have := hseg θ h0 h1
      simpa only [add_sub_cancel_left] using this
    exact hminOn.hasFDerivWithinAt_nonneg hdu.hasFDerivAt.hasFDerivWithinAt
      (mem_posTangentConeAt_of_segment_subset subset_rfl)
  
  obtain ⟨hf1, -, -⟩ := hlin x₁ hx₁W
  rw [hf1, hdw1] at h11
  simp only [ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.neg_apply, smul_eq_mul, zero_sub] at h11
  nlinarith [mul_pos hm hV3]

theorem eig_patched_strong_min {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X) (P : EigPatchedSurface X S) (φ c : X → ℝ) (hφ : ∀ j, ContDiffOn ℝ ∞ (fun x => φ (P.param j x)) (P.W j)) (hc : ∀ j, ContinuousOn (fun x => c (P.param j x)) (P.W j)) (hnn : ∀ q ∈ S, 0 ≤ φ q) (heq : ∀ j, ∀ x ∈ P.W j, lap2 (P.h j) (fun x' => φ (P.param j x')) x + c (P.param j x) * φ (P.param j x) = 0) (p : X) (hp : p ∈ S) (h0 : φ p = 0) : ∀ q ∈ connectedComponentIn S p, φ q = 0 :=
by
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem.2
  
  have hP2 : ∀ j, ∀ q ∈ P.O j, q ∈ S → P.proj j q ∈ P.W j ∧ P.param j (P.proj j q) = q := by
    intro j q hqO hqS
    have hmem : q ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hqO, hqS⟩
    obtain ⟨x, hx, rfl⟩ := hmem
    rw [P.proj_param j x hx]
    exact ⟨hx, rfl⟩
  
  have hloc : ∀ j, ∀ x₀ ∈ P.W j, φ (P.param j x₀) = 0 →
      ∀ᶠ y in 𝓝 x₀, φ (P.param j y) = 0 := by
    intro j x₀ hx₀ hw0
    obtain ⟨A, B, hA, hB, hAs, hApos, hid⟩ :=
      esm_lap2_coeff_form (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)
    have hnnW : ∀ x ∈ P.W j, 0 ≤ φ (P.param j x) := fun x hx => hnn _ (hP1 j x hx)
    have heq' : ∀ x ∈ P.W j, ∑ i : Fin 2, ∑ k : Fin 2,
        A x i k * pd2 i (pd2 k (fun x' => φ (P.param j x'))) x
        + ∑ k : Fin 2, B x k * pd2 k (fun x' => φ (P.param j x')) x
        + c (P.param j x) * φ (P.param j x) = 0 := by
      intro x hx
      have h1 := heq j x hx
      rw [hid] at h1
      exact h1
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 (P.W_open j) x₀ hx₀
    have hρ : 0 < ε / 3 := by positivity
    have hcb : Metric.closedBall x₀ (2 * (ε / 3)) ⊆ P.W j :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    refine Filter.eventually_of_mem (Metric.ball_mem_nhds x₀ hρ) ?_
    intro z hz
    by_contra hwz
    
    have hDc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3))) := isCompact_closedBall _ _
    have hZcl : IsClosed (Metric.closedBall x₀ (2 * (ε / 3)) ∩
        (fun x => φ (P.param j x)) ⁻¹' {0}) :=
      ((hφ j).continuousOn.mono hcb).preimage_isClosed_of_isClosed Metric.isClosed_closedBall
        isClosed_singleton
    have hZc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3)) ∩
        (fun x => φ (P.param j x)) ⁻¹' {0}) :=
      hDc.of_isClosed_subset hZcl Set.inter_subset_left
    have hx₀Z : x₀ ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩
        (fun x => φ (P.param j x)) ⁻¹' {0} :=
      ⟨Metric.mem_closedBall_self (by linarith), hw0⟩
    obtain ⟨x₁, hx₁Z, hmin⟩ := hZc.exists_isMinOn ⟨x₀, hx₀Z⟩
      (continuous_id.dist continuous_const).continuousOn
    have hmin' := isMinOn_iff.1 hmin
    have hRle : dist x₁ z ≤ dist x₀ z := hmin' x₀ hx₀Z
    have hz' : dist z x₀ < ε / 3 := hz
    have hR : 0 < dist x₁ z := by
      rcases (dist_nonneg (x := x₁) (y := z)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hx1z : x₁ = z := dist_eq_zero.1 h.symm
        apply hwz
        rw [← hx1z]
        exact hx₁Z.2
    have hsub : Metric.closedBall z (dist x₁ z) ⊆ Metric.closedBall x₀ (2 * (ε / 3)) := by
      intro x hx
      rw [Metric.mem_closedBall] at hx ⊢
      have h1 := dist_triangle x z x₀
      rw [dist_comm x₀ z] at hRle
      linarith
    have hpos : ∀ x ∈ Metric.ball z (dist x₁ z), 0 < φ (P.param j x) := by
      intro x hx
      have hxD : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) := hsub (Metric.ball_subset_closedBall hx)
      rcases (hnnW x (hcb hxD)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hxZ : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩
            (fun x => φ (P.param j x)) ⁻¹' {0} := ⟨hxD, h.symm⟩
        have h2 : dist x₁ z ≤ dist x z := hmin' x hxZ
        rw [Metric.mem_ball] at hx
        linarith
    exact esm_hopf_touching (P.W j) (P.W_open j) A B (fun x => φ (P.param j x))
      (fun x => c (P.param j x)) hA hB hAs hApos (hφ j) (hc j) hnnW heq' z x₁ (dist x₁ z) hR
      (hsub.trans hcb) hpos rfl hx₁Z.2
  
  intro q hq
  have hA'o : ∀ j, IsOpen ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j) :=
    fun j => isOpen_setOf_eventually_nhds.inter (P.W_open j)
  have hB'o : ∀ j, IsOpen (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ) :=
    fun j => (hφ j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_compl_singleton
  have hU₁o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
      ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) :=
    isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hA'o j)
  have hU₂o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
      (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) :=
    isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hB'o j)
  have hcov : S ⊆ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
      ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) ∪
      (⋃ j, (P.O j ∩ P.proj j ⁻¹' (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) := by
    intro r hrS
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hrS)
    obtain ⟨hxW, hxr⟩ := hP2 j r hj hrS
    by_cases hr0 : φ r = 0
    · left
      refine Set.mem_iUnion.2 ⟨j, hj, ?_, hxW⟩
      exact hloc j _ hxW (by rw [hxr]; exact hr0)
    · right
      refine Set.mem_iUnion.2 ⟨j, hj, hxW, ?_⟩
      show φ (P.param j (P.proj j r)) ∈ ({0}ᶜ : Set ℝ)
      rw [hxr]
      exact hr0
  have hU₁z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
      ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) → φ r = 0 := by
    intro r hrS hr1
    obtain ⟨j, hj, hA, -⟩ := Set.mem_iUnion.1 hr1
    have hA' : ∀ᶠ y in 𝓝 (P.proj j r), φ (P.param j y) = 0 := hA
    have h1 := hA'.self_of_nhds
    rwa [(hP2 j r hj hrS).2] at h1
  have hU₂z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
      (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ))) → φ r ≠ 0 := by
    intro r hrS hr2
    obtain ⟨j, hj, -, hB⟩ := Set.mem_iUnion.1 hr2
    have h1 : φ (P.param j (P.proj j r)) ≠ 0 := hB
    rwa [(hP2 j r hj hrS).2] at h1
  have hCS : connectedComponentIn S p ⊆ S := connectedComponentIn_subset S p
  have hdisj : connectedComponentIn S p ∩ ((⋃ j, (P.O j ∩ P.proj j ⁻¹'
      ({x | ∀ᶠ y in 𝓝 x, φ (P.param j y) = 0} ∩ P.W j))) ∩
      (⋃ j, (P.O j ∩ P.proj j ⁻¹' (P.W j ∩ (fun x => φ (P.param j x)) ⁻¹' {0}ᶜ)))) = ∅ := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
    rintro ⟨hxC, hx1, hx2⟩
    exact hU₂z x (hCS hxC) hx2 (hU₁z x (hCS hxC) hx1)
  rcases (isPreconnected_iff_subset_of_disjoint.1 (isPreconnected_connectedComponentIn (F := S)
      (x := p))) _ _ hU₁o hU₂o (hCS.trans hcov) hdisj with h | h
  · exact hU₁z q (hCS hq) (h hq)
  · exact absurd h0 (hU₂z p hp (h (mem_connectedComponentIn hp)))

theorem jacobi_eigen_data [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig : Set M) (hSc : IsCompact Sig) (hSm : IsMinimalSurfaceSet g Sig) :
    ∃ φ lam : M → ℝ, (∀ p ∈ Sig, ∃ U ∈ 𝓝 p, ∀ q ∈ U, q ∈ Sig → lam q = lam p) ∧
      ∀ p ∈ Sig, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ Sig = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ Sig, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧ g.jacobiDeriv f x = lam x / φ x :=
by
  
  have hgraph : ∀ p ∈ Sig, ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), eigGraphChart Sig p a u r δ :=
    fun p hp => eig_graph_chart_exists g Sig hSm p hp
  
  obtain ⟨P, hreal, hbridge⟩ := eig_patched_atlas g Sig hSc hgraph
  
  obtain ⟨Vp, hVs, hVid⟩ := eig_jacobi_potential g Sig hSm
  
  have hVpatch : ∀ j, ContDiffOn ℝ ∞ (fun x => Vp (P.param j x)) (P.W j) := by
    intro j
    obtain ⟨z, F, hSP, hpar, -⟩ := hreal j
    rw [hpar]
    exact hVs z (P.W j) F hSP
  
  obtain ⟨lam, φ, hlam, hnn, hnz, hφ⟩ := eig_patched_principal Sig hSc P Vp hVpatch
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ Sig := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem.2
  
  have hc : ∀ j, ContinuousOn (fun x => Vp (P.param j x) + lam (P.param j x)) (P.W j) := by
    intro j
    refine (hVpatch j).continuousOn.add ?_
    intro x hx
    obtain ⟨U, hU, hUl⟩ := hlam (P.param j x) (hP1 j x hx)
    have hca : ContinuousAt (P.param j) x :=
      (P.param_cont j).continuousAt ((P.W_open j).mem_nhds hx)
    have hev : (fun x' => lam (P.param j x')) =ᶠ[𝓝 x] (fun _ => lam (P.param j x)) := by
      filter_upwards [hca.preimage_mem_nhds hU, (P.W_open j).mem_nhds hx] with x' h1 h2
      exact hUl _ h1 (hP1 j x' h2)
    exact (continuousAt_const.congr hev.symm).continuousWithinAt
  
  have hφpos : ∀ p ∈ Sig, 0 < φ p := by
    intro p hp
    by_contra hneg
    have h0 : φ p = 0 := le_antisymm (not_lt.mp hneg) (hnn p hp)
    have hz := eig_patched_strong_min Sig P φ (fun q => Vp q + lam q) (fun j => (hφ j).1) hc hnn
      (fun j x hx => (hφ j).2 x hx) p hp h0
    obtain ⟨q, hq, hq0⟩ := hnz p hp
    exact hq0 (hz q hq)
  
  have hsm : eigSmoothAlong Sig φ := hbridge φ (fun j => (hφ j).1)
  
  refine ⟨φ, lam, hlam, fun p hp => ⟨hφpos p hp, ?_⟩⟩
  obtain ⟨a, u, r, δ, hG⟩ := hgraph p hp
  obtain ⟨V', f, hV'o, hpV', hf, hdf, hV'S, hnorm⟩ :=
    eig_prescribed_gradient g Sig φ hsm hφpos p hp a u r δ hG
  refine ⟨V', f, hV'o, hpV', hf, hdf, hV'S, fun x hx => ⟨hnorm x hx, ?_⟩⟩
  
  obtain ⟨j, hxj⟩ := Set.mem_iUnion.1 (P.cover hx.2)
  have hxim : x ∈ P.param j '' P.W j := by
    rw [P.image_eq j]
    exact ⟨hxj, hx.2⟩
  obtain ⟨x₀, hx₀W, hx₀⟩ := hxim
  obtain ⟨z, F, hSP, hpar, hh⟩ := hreal j
  have hparx : ∀ x', P.param j x' = (chartAt E3 z).symm (F x') := fun x' => congrFun hpar x'
  have hW'o : IsOpen (P.W j ∩ P.param j ⁻¹' V') :=
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) hV'o
  have hx₀W' : x₀ ∈ P.W j ∩ P.param j ⁻¹' V' := by
    refine ⟨hx₀W, ?_⟩
    rw [Set.mem_preimage, hx₀]
    exact hx.1
  have hSP' : eigSurfParam Sig z (P.W j ∩ P.param j ⁻¹' V') F := by
    obtain ⟨-, hFs, hpt⟩ := hSP
    exact ⟨hW'o, hFs.mono Set.inter_subset_left, fun x' hx' => hpt x' hx'.1⟩
  have hinO : ∀ x' ∈ P.W j ∩ P.param j ⁻¹' V', (chartAt E3 z).symm (F x') ∈ V' := by
    intro x' hx'
    rw [← hparx]
    exact hx'.2
  have hid := hVid V' f hV'o hf hdf hV'S z (P.W j ∩ P.param j ⁻¹' V') F x₀ hSP' hx₀W' hinO
  have hyx : (chartAt E3 z).symm (F x₀) = x := by
    rw [← hparx]
    exact hx₀
  rw [hyx] at hid
  have hψφ : ∀ q ∈ V' ∩ Sig, (Real.sqrt (g.gradInner f f q))⁻¹ = φ q := fun q hq =>
    inv_eq_of_mul_eq_one_right (hnorm q hq)
  have heqOn : Set.EqOn
      (fun x' => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹)
      (fun x' => φ (P.param j x')) (P.W j ∩ P.param j ⁻¹' V') := by
    intro x' hx'
    show (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹ = φ (P.param j x')
    rw [hparx]
    exact hψφ _ ⟨hinO x' hx', ((hSP'.2.2 x' hx').2.1)⟩
  have hpd : ∀ k : Fin 2,
      pd2 k (fun x' => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹)
        =ᶠ[𝓝 x₀] pd2 k (fun x' => φ (P.param j x')) := by
    intro k
    filter_upwards [hW'o.mem_nhds hx₀W'] with y hy
    show fderiv ℝ _ y (e2 k) = fderiv ℝ _ y (e2 k)
    rw [Filter.EventuallyEq.fderiv_eq (heqOn.eventuallyEq_of_mem (hW'o.mem_nhds hy))]
  have h1 : ∀ k : Fin 2,
      pd2 k (fun x' => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹) x₀
        = pd2 k (fun x' => φ (P.param j x')) x₀ := fun k => (hpd k).eq_of_nhds
  have h2 : ∀ i k : Fin 2,
      pd2 i (pd2 k (fun x' => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹)) x₀
        = pd2 i (pd2 k (fun x' => φ (P.param j x'))) x₀ := by
    intro i k
    show fderiv ℝ _ x₀ (e2 i) = fderiv ℝ _ x₀ (e2 i)
    rw [Filter.EventuallyEq.fderiv_eq (hpd k)]
  have hlap : lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun x' => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x'))))⁻¹) x₀ =
      lap2 (P.h j) (fun x' => φ (P.param j x')) x₀ := by
    rw [hh]
    simp only [lap2, h1, h2]
  rw [hlap, hψφ x hx] at hid
  have hs5 := (hφ j).2 x₀ hx₀W
  rw [hx₀] at hs5
  have hφx : 0 < φ x := hφpos x hx.2
  have hprod : (g.jacobiDeriv f x * φ x - lam x) * φ x = 0 := by
    linear_combination hid - hs5
  rcases mul_eq_zero.mp hprod with h | h
  · rw [eq_div_iff hφx.ne']
    linarith
  · exact absurd h hφx.ne'

theorem gradInner_eq_coord [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (f : M → ℝ) (h : E3 → ℝ)
    (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) (x : E3) (hx : x ∈ Φ.source)
    (hfh : ∀ᶠ z in 𝓝 x, f (Φ z) = h z) :
    g.gradInner f f (Φ x) = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff Φ x)⁻¹ i j * partialDeriv i h x * partialDeriv j h x :=
by
  
  have hu : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hcomp_e : ∀ v : Fin 3 → ℝ, ∀ a : Fin 3, (∑ i : Fin 3, v i • e i) a = v a := by
    intro v a
    simp [Pi.single_apply]
  have hcompo : ∀ (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z → ∀ l d : Fin 3,
      partialDeriv l (fun v => ψ v d) z = (fderiv ℝ ψ z (e l)) d := by
    intro ψ z hψ l d
    have hfun : (fun v => ψ v d) = (EuclideanSpace.proj d : E3 →L[ℝ] ℝ) ∘ ψ := by
      funext v; simp
    rw [partialDeriv, hfun, fderiv_comp z (EuclideanSpace.proj d).differentiableAt hψ,
      ContinuousLinearMap.fderiv]
    simp
  have pd_comp : ∀ (F : E3 → ℝ) (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z →
      DifferentiableAt ℝ F (ψ z) → ∀ l : Fin 3,
      partialDeriv l (fun w => F (ψ w)) z
        = ∑ d : Fin 3, partialDeriv d F (ψ z) * partialDeriv l (fun v => ψ v d) z := by
    intro F ψ z hψ hF l
    have h1 : partialDeriv l (fun w => F (ψ w)) z = fderiv ℝ F (ψ z) (fderiv ℝ ψ z (e l)) := by
      show fderiv ℝ (F ∘ ψ) z (e l) = _
      rw [fderiv_comp z hF hψ]
      rfl
    rw [h1, hu (fderiv ℝ ψ z (e l)), map_sum]
    simp only [map_smul, smul_eq_mul, hcompo ψ z hψ]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  
  have grad_alg : ∀ (A Gm Gt : Matrix (Fin 3) (Fin 3) ℝ) (P Pt : Fin 3 → ℝ), A.det ≠ 0 →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * Gm a b * A b j) →
      (∀ i, Pt i = ∑ a : Fin 3, P a * A a i) →
      ∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j * Pt i * Pt j =
          ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * P i * P j := by
    intro A Gm Gt P Pt hA hGt hPt
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGt' : Gt = Matrix.transpose A * Gm * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGtinv : Gt⁻¹ = A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hM : A * Gt⁻¹ * Matrix.transpose A = Gm⁻¹ := by
      rw [hGtinv]
      calc A * (A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹) * Matrix.transpose A
          = (A * A⁻¹) * Gm⁻¹ * (Matrix.transpose A⁻¹ * Matrix.transpose A) := by
            simp only [Matrix.mul_assoc]
        _ = Gm⁻¹ := by
            rw [hAB, ← Matrix.transpose_mul, hAB, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hM' : ∀ a b, ∑ i : Fin 3, ∑ j : Fin 3, A a i * Gt⁻¹ i j * A b j = Gm⁻¹ a b := by
      intro a b
      rw [← hM]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    simp only [hPt, ← hM']
    simp only [Fin.sum_univ_three]
    ring
  
  have h2 : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) ∧
      ContDiffOn ℝ ∞ (fun w => chartAt E3 (Φ x) (Φ w))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) := by
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
    refine ⟨hΦ.continuousOn.isOpen_inter_preimage Φ.open_source
      (chartAt E3 (Φ x)).open_source, ?_⟩
    have hc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (Φ x))
        (chartAt E3 (Φ x)).source := contMDiffOn_chart
    have hcomp := hc.comp (hΦ.mono Set.inter_subset_left) (fun w hw => hw.2)
    exact contMDiffOn_iff_contDiffOn.mp hcomp
  have hxU : x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source := ⟨hx, mem_chart_source E3 (Φ x)⟩
  have hψd : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      DifferentiableAt ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z := fun z hz =>
    (h2.2.contDiffAt (h2.1.mem_nhds hz)).differentiableAt (by simp)
  have hM1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))).comp
          (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z) := by
    intro z hz
    have hev : (Φ : E3 → M) =ᶠ[𝓝 z]
        ((chartAt E3 (Φ x)).symm ∘ (fun w => chartAt E3 (Φ x) (Φ w))) := by
      filter_upwards [h2.1.mem_nhds hz] with w hw
      exact ((chartAt E3 (Φ x)).left_inv hw.2).symm
    rw [hev.mfderiv_eq, mfderiv_comp z
      (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 (Φ x))
        ((chartAt E3 (Φ x)).map_source hz.2)) (hψd z hz).mdifferentiableAt, mfderiv_eq_fderiv]
  have hM1' : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ u : E3,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))
          (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
    intro z hz u
    rw [hM1 z hz]
    rfl
  
  have s1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ i j : Fin 3,
      g.coeff Φ z i j = ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z *
          g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b *
            partialDeriv j (fun w => chartAt E3 (Φ x) (Φ w) b) z := by
    intro z hz i j
    have hq : (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) = Φ z :=
      (chartAt E3 (Φ x)).left_inv hz.2
    have hgq : g.g ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))) = g.g (Φ z) :=
      congrArg g.g hq
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) :=
      ⟨_, rfl⟩
    have hΦD : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
        D (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
      intro u
      rw [hM1' z hz u, hD]
      rfl
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b
        = g.g (Φ z) (D (e a)) (D (e b)) := by
      intro a b
      rw [← hgq, hD]
      rfl
    have hJ : ∀ k : Fin 3, fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k)
        = ∑ d : Fin 3, partialDeriv k (fun w => chartAt E3 (Φ x) (Φ w) d) z • e d := by
      intro k
      rw [hu (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k))]
      simp only [hcompo _ z (hψd z hz)]
    simp only [hcD]
    show g.g (Φ z) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e i))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e j)) = _
    rw [hΦD, hΦD, hJ i, hJ j]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    simp only [Fin.sum_univ_three]
    ring
  
  have s3 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z).det
        ≠ 0 := by
    intro z hz hdet
    obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ hz.1
    have hinj : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u = 0 → u = 0 := by
      intro u hu0
      rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hu0
      exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hu0
    have hw : fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (∑ i : Fin 3, v i • e i) = 0 := by
      ext a
      rw [map_sum]
      simp only [map_smul]
      have := congrFun hJv a
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        hcompo _ z (hψd z hz)] at this
      simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        WithLp.ofLp_zero, Pi.zero_apply]
      rw [← this]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
      apply hinj
      rw [hM1' z hz, hw]
      exact ContinuousLinearMap.map_zero _
    apply hv0
    funext a
    rw [← hcomp_e v a, h0]
    rfl
  
  have huW : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x)).target := by
    have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 (Φ x)).symm)
        (chartAt E3 (Φ x)).target :=
      hf.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp this
  have hmapsW : chartAt E3 (Φ x) (Φ x) ∈ (chartAt E3 (Φ x)).target :=
    (chartAt E3 (Φ x)).map_source hxU.2
  have hud : DifferentiableAt ℝ (fun y => f ((chartAt E3 (Φ x)).symm y))
      (chartAt E3 (Φ x) (Φ x)) :=
    (huW.contDiffAt ((chartAt E3 (Φ x)).open_target.mem_nhds hmapsW)).differentiableAt (by simp)
  have hequ : h =ᶠ[𝓝 x]
      (fun w => f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)))) := by
    filter_upwards [hfh, h2.1.mem_nhds hxU] with z hz1 hz2
    show h z = f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)))
    rw [(chartAt E3 (Φ x)).left_inv hz2.2]
    exact hz1.symm
  have hPt : ∀ i : Fin 3, partialDeriv i h x = ∑ a : Fin 3,
      partialDeriv a (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x) (Φ x)) *
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) x) a i := by
    intro i
    have e1 : partialDeriv i h x = partialDeriv i
        (fun w => f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)))) x := by
      show fderiv ℝ h x (e i) = fderiv ℝ _ x (e i)
      rw [hequ.fderiv_eq]
    rw [e1, pd_comp (fun y => f ((chartAt E3 (Φ x)).symm y)) (fun w => chartAt E3 (Φ x) (Φ w))
      x (hψd x hxU) hud i]
    rfl
  have hL : g.gradInner f f (Φ x) = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)))⁻¹ i j *
        partialDeriv i (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x) (Φ x)) *
        partialDeriv j (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x) (Φ x)) := rfl
  rw [hL]
  exact (grad_alg (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) x)
    (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x))) (g.coeff Φ x)
    (fun a => partialDeriv a (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x) (Φ x)))
    (fun i => partialDeriv i h x) (s3 x hxU) (fun i j => s1 x hxU i j) hPt).symm

theorem coord_division (U : Set E3) (hU : IsOpen U) (f h : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (hh : ContDiffOn ℝ ∞ h U) (y₀ : E3) (hy₀ : y₀ ∈ U) (hf0 : f y₀ = 0) (hdf : fderiv ℝ f y₀ ≠ 0) (hz : ∀ y ∈ U, f y = 0 → h y = 0) : ∃ r : ℝ, 0 < r ∧ ∃ u : E3 → ℝ, Metric.ball y₀ r ⊆ U ∧ ContDiffOn ℝ ∞ u (Metric.ball y₀ r) ∧ ∀ y ∈ Metric.ball y₀ r, h y = f y * u y :=
by
  
  have s4 : ∀ (n : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (G : E3 → ℝ → F), ContDiff ℝ (n : WithTop ℕ∞) (Function.uncurry G) → ∀ a b : ℝ,
      ContDiff ℝ (n : WithTop ℕ∞) (fun z => ∫ t in a..b, G z t) := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ G hG a b
      rw [Nat.cast_zero, contDiff_zero] at hG ⊢
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hG a b
    | succ n ih =>
      intro F _ _ _ G hG a b
      rw [Nat.cast_succ] at hG ⊢
      rw [contDiff_succ_iff_hasFDerivAt]
      let D : E3 → ℝ → (E3 →L[ℝ] F) := fun z t =>
        (fderiv ℝ (Function.uncurry G) (z, t)).comp (ContinuousLinearMap.inl ℝ E3 ℝ)
      have hGd : Differentiable ℝ (Function.uncurry G) := hG.differentiable (by simp)
      have hDc : ContDiff ℝ n (Function.uncurry D) := by
        have h1 : ContDiff ℝ n (fderiv ℝ (Function.uncurry G)) := hG.fderiv_right le_rfl
        exact h1.clm_comp contDiff_const
      have hpt : ∀ z t, HasFDerivAt (fun z' => G z' t) (D z t) z := by
        intro z t
        have h := (hGd (z, t)).hasFDerivAt.comp z (hasFDerivAt_prodMk_left (𝕜 := ℝ) z t)
        exact h
      refine ⟨fun z => ∫ t in a..b, D z t, ih (E3 →L[ℝ] F) D hDc a b, fun z₀ => ?_⟩
      obtain ⟨C, hC⟩ := ((isCompact_closedBall z₀ 1).prod
        (isCompact_uIcc (a := a) (b := b))).exists_bound_of_continuousOn
        hDc.continuous.continuousOn
      have hGc : Continuous (Function.uncurry G) := hG.continuous
      have hGt : ∀ z, Continuous (G z) := fun z => hGc.comp (Continuous.prodMk_right z)
      have hDt : ∀ z, Continuous (D z) := fun z => hDc.continuous.comp (Continuous.prodMk_right z)
      haveI : SecondCountableTopologyEither ℝ (E3 →L[ℝ] F) :=
        secondCountableTopologyEither_of_left ℝ _
      haveI : SecondCountableTopologyEither ℝ F :=
        secondCountableTopologyEither_of_left ℝ _
      refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume)
        (bound := fun _ => C) (ball_mem_nhds z₀ one_pos)
        (Eventually.of_forall fun z => (hGt z).aestronglyMeasurable)
        ((hGt z₀).intervalIntegrable a b) (hDt z₀).aestronglyMeasurable ?_
        intervalIntegrable_const ?_
      · refine Eventually.of_forall fun t ht x hx => ?_
        exact hC (x, t) ⟨ball_subset_closedBall hx, Set.uIoc_subset_uIcc ht⟩
      · exact Eventually.of_forall fun t _ x _ => hpt x t
  
  have s2 : ∀ (φ : E3 →L[ℝ] ℝ) (w : E3), 1 + φ w ≠ 0 →
      ∃ A : E3 ≃L[ℝ] E3, (A : E3 →L[ℝ] E3) = ContinuousLinearMap.id ℝ E3 + φ.smulRight w := by
    intro φ w hw
    refine ⟨ContinuousLinearEquiv.equivOfInverse (ContinuousLinearMap.id ℝ E3 + φ.smulRight w)
      (ContinuousLinearMap.id ℝ E3 - (1 + φ w)⁻¹ • φ.smulRight w) ?_ ?_, rfl⟩
    · intro v
      simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.id_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, map_add, map_smul, map_sub, smul_eq_mul]
      match_scalars <;> field_simp <;> ring
    · intro v
      simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.id_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smulRight_apply, map_add, map_smul, map_sub, smul_eq_mul]
      match_scalars <;> field_simp <;> ring
  
  have s5 : ∀ (c : E3) (ρ : ℝ) (k χ : E3 → ℝ), ContDiffOn ℝ ∞ k (Metric.ball c ρ) →
      ContDiff ℝ ∞ χ → (∀ z : E3, χ z ≠ 0 → dist z c < ρ / 2) →
      ContDiff ℝ ∞ (fun z => χ z * k z) := by
    intro c ρ k χ hk hχ hsupp
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hzc : dist z c < ρ
    · exact (hχ.contDiffOn.mul hk).contDiffAt (Metric.isOpen_ball.mem_nhds hzc)
    · push_neg at hzc
      by_cases hρ : 0 < ρ
      · have hO : IsOpen {z' : E3 | ρ / 2 < dist z' c} :=
          isOpen_lt continuous_const (continuous_id.dist continuous_const)
        have hzO : z ∈ {z' : E3 | ρ / 2 < dist z' c} := by
          show ρ / 2 < dist z c
          linarith
        refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
        filter_upwards [hO.mem_nhds hzO] with z' hz'
        have : χ z' = 0 := by
          by_contra hne
          have := hsupp z' hne
          have h2 : ρ / 2 < dist z' c := hz'
          linarith
        simp [this]
      · have h0 : ∀ z', χ z' = 0 := by
          intro z'
          by_contra hne
          have := hsupp z' hne
          have := dist_nonneg (x := z') (y := c)
          push_neg at hρ
          linarith
        have : (fun z => χ z * k z) = fun _ => (0 : ℝ) := by
          funext z'; simp [h0 z']
        rw [this]
        exact contDiffAt_const
  
  have s3 : ∀ (K : E3 → ℝ), ContDiff ℝ ∞ K → ∀ (ℓ : E3 →L[ℝ] ℝ) (w : E3), ℓ w = 1 →
      (∀ z : E3, ℓ z = 0 → K z = 0) → ∀ z : E3,
      K z = ℓ z * ∫ t in (0:ℝ)..1, fderiv ℝ K (z - ((1 - t) * ℓ z) • w) w := by
    intro K hK ℓ w hw hK0 z
    set c := ℓ z with hc
    have hKd : Differentiable ℝ K := hK.differentiable (by simp)
    have hp : ∀ t : ℝ, HasDerivAt (fun t : ℝ => z - ((1 - t) * c) • w) (c • w) t := by
      intro t
      have h1 : HasDerivAt (fun t : ℝ => (1 - t) * c) (-c) t := by
        have := ((hasDerivAt_id t).const_sub 1).mul_const c
        simpa using this
      have h2 := (h1.smul_const w).const_sub z
      simpa using h2
    have hφ : ∀ t : ℝ, HasDerivAt (fun t : ℝ => K (z - ((1 - t) * c) • w))
        (c * fderiv ℝ K (z - ((1 - t) * c) • w) w) t := by
      intro t
      have := (hKd (z - ((1 - t) * c) • w)).hasFDerivAt.comp_hasDerivAt t (hp t)
      simpa [map_smul, smul_eq_mul] using this
    have hcont : Continuous (fun t : ℝ => c * fderiv ℝ K (z - ((1 - t) * c) • w) w) := by
      have h1 : Continuous (fun t : ℝ => z - ((1 - t) * c) • w) := by fun_prop
      exact continuous_const.mul
        (((hK.continuous_fderiv (by simp)).comp h1).clm_apply continuous_const)
    have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hφ t)
      (hcont.intervalIntegrable 0 1)
    rw [intervalIntegral.integral_const_mul] at hFTC
    have h0 : K (z - ((1 - 0) * c) • w) = 0 := by
      apply hK0
      simp [hc, hw]
    rw [hFTC, h0]
    simp
  
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : E3 →L[ℝ] ℝ, ℓ = fderiv ℝ f y₀ := ⟨_, rfl⟩
  obtain ⟨v, hv⟩ : ∃ v, ℓ v ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hdf (hℓ ▸ ContinuousLinearMap.ext hcon)
  obtain ⟨w, hw⟩ : ∃ w : E3, ℓ w = 1 :=
    ⟨(ℓ v)⁻¹ • v, by rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hv]⟩
  
  have hdfc : ContinuousOn (fun y => fderiv ℝ f y w) U :=
    (hf.continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
  obtain ⟨U', hU'def⟩ : ∃ U' : Set E3, U' = U ∩ (fun y => fderiv ℝ f y w) ⁻¹' {0}ᶜ := ⟨_, rfl⟩
  have hU' : IsOpen U' := hU'def ▸ hdfc.isOpen_inter_preimage hU isOpen_compl_singleton
  have hmemU' : ∀ y, y ∈ U' ↔ y ∈ U ∧ fderiv ℝ f y w ≠ 0 := by
    intro y; rw [hU'def]; rfl
  have hU'U : U' ⊆ U := fun y hy => ((hmemU' y).1 hy).1
  have hy₀' : y₀ ∈ U' := by
    rw [hmemU']
    refine ⟨hy₀, ?_⟩
    rw [← hℓ, hw]
    exact one_ne_zero
  
  obtain ⟨Θ, hΘdef⟩ : ∃ Θ : E3 → E3, Θ = fun y => y + (f y - ℓ y) • w := ⟨_, rfl⟩
  have hΘs : ContDiffOn ℝ ∞ Θ U := by
    rw [hΘdef]
    exact contDiffOn_id.add ((hf.sub ℓ.contDiff.contDiffOn).smul contDiffOn_const)
  have hΘℓ : ∀ y, ℓ (Θ y) = f y := by
    intro y
    rw [hΘdef]
    simp only [map_add, map_smul, smul_eq_mul, hw]
    ring
  have hinv : ∀ y ∈ U', ∃ A : E3 ≃L[ℝ] E3, HasFDerivAt Θ (A : E3 →L[ℝ] E3) y := by
    intro y hy
    rw [hmemU'] at hy
    have hfd : HasFDerivAt f (fderiv ℝ f y) y :=
      ((hf.contDiffAt (hU.mem_nhds hy.1)).differentiableAt (by simp)).hasFDerivAt
    obtain ⟨A, hA⟩ := s2 (fderiv ℝ f y - ℓ) w (by
      rw [ContinuousLinearMap.sub_apply, hw]
      intro h0
      apply hy.2
      linarith)
    refine ⟨A, ?_⟩
    rw [hA, hΘdef]
    exact (hasFDerivAt_id y).add ((hfd.sub ℓ.hasFDerivAt).smul_const w)
  
  obtain ⟨A₀, hA₀⟩ := hinv y₀ hy₀'
  have hΘa : ContDiffAt ℝ ∞ Θ y₀ := hΘs.contDiffAt (hU.mem_nhds hy₀)
  obtain ⟨P, hPc, hy₀P, hz₀P⟩ : ∃ P : OpenPartialHomeomorph E3 E3,
      (P : E3 → E3) = Θ ∧ y₀ ∈ P.source ∧ Θ y₀ ∈ P.target :=
    ⟨ContDiffAt.toOpenPartialHomeomorph Θ hΘa hA₀ (by simp),
      ContDiffAt.toOpenPartialHomeomorph_coe hΘa hA₀ (by simp),
      ContDiffAt.mem_toOpenPartialHomeomorph_source hΘa hA₀ (by simp),
      ContDiffAt.image_mem_toOpenPartialHomeomorph_target hΘa hA₀ (by simp)⟩
  obtain ⟨z₀, hz₀def⟩ : ∃ z₀ : E3, z₀ = Θ y₀ := ⟨_, rfl⟩
  have hO : IsOpen (P.target ∩ P.symm ⁻¹' (P.source ∩ U')) :=
    P.continuousOn_symm.isOpen_inter_preimage P.open_target (P.open_source.inter hU')
  have hz₀O : z₀ ∈ P.target ∩ P.symm ⁻¹' (P.source ∩ U') := by
    rw [hz₀def]
    refine ⟨hz₀P, ?_⟩
    show P.symm (Θ y₀) ∈ P.source ∩ U'
    have : P.symm (P y₀) = y₀ := P.left_inv hy₀P
    rw [hPc] at this
    rw [this]
    exact ⟨hy₀P, hy₀'⟩
  obtain ⟨ρ, hρ, hρO⟩ := Metric.isOpen_iff.1 hO z₀ hz₀O
  have hΨ1 : ∀ z ∈ ball z₀ ρ, P.symm z ∈ U' ∧ Θ (P.symm z) = z := by
    intro z hzb
    refine ⟨(hρO hzb).2.2, ?_⟩
    have := P.right_inv (hρO hzb).1
    rw [hPc] at this
    exact this
  have hΨs : ContDiffOn ℝ ∞ (P.symm : E3 → E3) (ball z₀ ρ) := by
    intro z hzb
    have hzt := (hρO hzb).1
    have hΨz : P.symm z ∈ P.source ∩ U' := (hρO hzb).2
    obtain ⟨A, hA⟩ := hinv (P.symm z) hΨz.2
    refine (P.contDiffAt_symm hzt (f₀' := A) ?_ ?_).contDiffWithinAt
    · rw [hPc]; exact hA
    · rw [hPc]; exact hΘs.contDiffAt (hU.mem_nhds (hU'U hΨz.2))
  have hO' : IsOpen ((P.source ∩ U') ∩ Θ ⁻¹' ball z₀ (ρ / 4)) :=
    (hΘs.continuousOn.mono (fun y hy => hU'U hy.2)).isOpen_inter_preimage
      (P.open_source.inter hU') isOpen_ball
  have hy₀O' : y₀ ∈ (P.source ∩ U') ∩ Θ ⁻¹' ball z₀ (ρ / 4) := by
    refine ⟨⟨hy₀P, hy₀'⟩, ?_⟩
    show Θ y₀ ∈ ball z₀ (ρ / 4)
    rw [← hz₀def]
    exact mem_ball_self (by linarith)
  obtain ⟨r, hr, hrO⟩ := Metric.isOpen_iff.1 hO' y₀ hy₀O'
  have hy1 : ∀ y ∈ ball y₀ r, y ∈ U ∧ Θ y ∈ ball z₀ (ρ / 4) ∧ P.symm (Θ y) = y := by
    intro y hy
    refine ⟨hU'U (hrO hy).1.2, (hrO hy).2, ?_⟩
    have := P.left_inv (hrO hy).1.1
    rw [hPc] at this
    exact this
  
  have hks : ContDiffOn ℝ ∞ (fun z => h (P.symm z)) (ball z₀ ρ) :=
    hh.comp hΨs (fun z hzb => hU'U (hΨ1 z hzb).1)
  have hk0 : ∀ z ∈ ball z₀ ρ, ℓ z = 0 → h (P.symm z) = 0 := by
    intro z hzb hlz
    have h1 := hΨ1 z hzb
    apply hz (P.symm z) (hU'U h1.1)
    rw [← hΘℓ, h1.2, hlz]
  
  obtain ⟨χ, hχin, hχout⟩ : ∃ χ : ContDiffBump z₀, χ.rIn = ρ / 4 ∧ χ.rOut = ρ / 2 :=
    ⟨⟨ρ / 4, ρ / 2, by positivity, by linarith⟩, rfl, rfl⟩
  have hsuppχ : ∀ z, χ z ≠ 0 → dist z z₀ < ρ / 2 := by
    intro z hzχ
    have : z ∈ Function.support χ := hzχ
    rw [χ.support_eq, hχout] at this
    exact this
  obtain ⟨K, hKdef⟩ : ∃ K : E3 → ℝ, K = fun z => χ z * h (P.symm z) := ⟨_, rfl⟩
  have hKs : ContDiff ℝ ∞ K := hKdef ▸ s5 z₀ ρ _ χ hks χ.contDiff hsuppχ
  have hK0 : ∀ z, ℓ z = 0 → K z = 0 := by
    intro z hlz
    rw [hKdef]
    by_cases hzb : z ∈ ball z₀ ρ
    · show χ z * h (P.symm z) = 0
      rw [hk0 z hzb hlz, mul_zero]
    · have : χ z = 0 := by
        by_contra hne
        apply hzb
        have := hsuppχ z hne
        show dist z z₀ < ρ
        linarith
      show χ z * h (P.symm z) = 0
      rw [this, zero_mul]
  have hKk : ∀ z ∈ ball z₀ (ρ / 4), K z = h (P.symm z) := by
    intro z hzb
    have : χ z = 1 := χ.one_of_mem_closedBall (by rw [hχin]; exact ball_subset_closedBall hzb)
    rw [hKdef]
    show χ z * h (P.symm z) = h (P.symm z)
    rw [this, one_mul]
  
  obtain ⟨V, hVdef⟩ : ∃ V : E3 → ℝ,
      V = fun z => ∫ t in (0:ℝ)..1, fderiv ℝ K (z - ((1 - t) * ℓ z) • w) w := ⟨_, rfl⟩
  have hKV : ∀ z, K z = ℓ z * V z := by
    intro z
    rw [hVdef]
    exact s3 K hKs ℓ w hw hK0 z
  have hVs : ContDiff ℝ ∞ V := by
    have h1 : ContDiff ℝ ∞ (fderiv ℝ K) := (contDiff_infty_iff_fderiv.1 hKs).2
    have h2 : ContDiff ℝ ∞ (fun p : E3 × ℝ => p.1 - ((1 - p.2) * ℓ p.1) • w) :=
      contDiff_fst.sub (((contDiff_const.sub contDiff_snd).mul
        (ℓ.contDiff.comp contDiff_fst)).smul contDiff_const)
    have hG : ContDiff ℝ ∞ (Function.uncurry
        (fun (z : E3) (t : ℝ) => fderiv ℝ K (z - ((1 - t) * ℓ z) • w) w)) :=
      (h1.comp h2).clm_apply contDiff_const
    rw [hVdef]
    exact contDiff_infty.2 (fun n => s4 n ℝ _ (contDiff_infty.1 hG n) 0 1)
  
  refine ⟨r, hr, fun y => V (Θ y), fun y hy => (hy1 y hy).1, ?_, ?_⟩
  · exact hVs.comp_contDiffOn (hΘs.mono (fun y hy => (hy1 y hy).1))
  · intro y hy
    obtain ⟨_, hΘy, hΨΘ⟩ := hy1 y hy
    calc h y = h (P.symm (Θ y)) := by rw [hΨΘ]
      _ = K (Θ y) := (hKk _ hΘy).symm
      _ = ℓ (Θ y) * V (Θ y) := hKV _
      _ = f y * V (Θ y) := by rw [hΘℓ]

theorem collar_index_factor [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig : Set M) (q : M) (hq : q ∈ Sig) (V : Set M) (f : M → ℝ) (hVo : IsOpen V)
    (hqV : q ∈ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) (hVS : V ∩ Sig = V ∩ f ⁻¹' {0})
    (β fi : M → ℝ) (Vi : Set M) (hVio : IsOpen Vi) (hβs : tsupport β ⊆ Vi)
    (hfi : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fi) (hViS : Vi ∩ Sig = Vi ∩ fi ⁻¹' {0})
    (hgrad : ∀ x ∈ V ∩ Vi ∩ Sig, g.gradInner fi fi x = g.gradInner f f x) :
    ∃ (O : Set E3) (u : E3 → ℝ), IsOpen O ∧ chartAt E3 q q ∈ O ∧
      O ⊆ (chartAt E3 q).target ∧ ContDiffOn ℝ ∞ u O ∧
      (∀ y ∈ O, β ((chartAt E3 q).symm y) * fi ((chartAt E3 q).symm y) ^ 2 =
        β ((chartAt E3 q).symm y) * (f ((chartAt E3 q).symm y) ^ 2 * u y ^ 2)) ∧
      (∀ y ∈ O, f ((chartAt E3 q).symm y) = 0 →
        β ((chartAt E3 q).symm y) * u y ^ 2 = β ((chartAt E3 q).symm y)) :=
by
  classical
  have hn0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hqsrc : q ∈ (chartAt E3 q).source := mem_chart_source E3 q
  have hy₀t : chartAt E3 q q ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hqsrc
  have hy₀q : (chartAt E3 q).symm (chartAt E3 q q) = q := (chartAt E3 q).left_inv hqsrc
  have hcd : ∀ w : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
      ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 q).symm y)) (chartAt E3 q).target :=
    fun w hw => contMDiffOn_iff_contDiffOn.mp (hw.comp_contMDiffOn contMDiffOn_chart_symm)
  by_cases hqβ : q ∈ tsupport β
  swap
  · 
    refine ⟨(chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (tsupport β)ᶜ, fun _ => 0,
      (chartAt E3 q).isOpen_inter_preimage_symm (isClosed_tsupport β).isOpen_compl,
      ⟨hy₀t, ?_⟩, Set.inter_subset_left, contDiffOn_const, ?_, ?_⟩
    · show (chartAt E3 q).symm (chartAt E3 q q) ∉ tsupport β
      rw [hy₀q]; exact hqβ
    · intro y hy
      have h0 : β ((chartAt E3 q).symm y) = 0 := image_eq_zero_of_notMem_tsupport hy.2
      rw [h0, zero_mul, zero_mul]
    · intro y hy _
      have h0 : β ((chartAt E3 q).symm y) = 0 := image_eq_zero_of_notMem_tsupport hy.2
      rw [h0, zero_mul]
  
  have hqVi : q ∈ Vi := hβs hqβ
  have hmemV : ∀ x ∈ V, x ∈ Sig ↔ f x = 0 := by
    intro x hx
    have h := Set.ext_iff.1 hVS x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff] at h
    exact ⟨fun hs => (h.1 ⟨hx, hs⟩).2, fun h0 => (h.2 ⟨hx, h0⟩).2⟩
  have hmemVi : ∀ x ∈ Vi, x ∈ Sig ↔ fi x = 0 := by
    intro x hx
    have h := Set.ext_iff.1 hViS x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff] at h
    exact ⟨fun hs => (h.1 ⟨hx, hs⟩).2, fun h0 => (h.2 ⟨hx, h0⟩).2⟩
  obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Set E3,
      Ω = (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (V ∩ Vi) := ⟨_, rfl⟩
  have hΩo : IsOpen Ω := by
    rw [hΩdef]; exact (chartAt E3 q).isOpen_inter_preimage_symm (hVo.inter hVio)
  have hΩt : Ω ⊆ (chartAt E3 q).target := by rw [hΩdef]; exact Set.inter_subset_left
  have hΩV : ∀ y ∈ Ω, (chartAt E3 q).symm y ∈ V ∧ (chartAt E3 q).symm y ∈ Vi := by
    intro y hy; rw [hΩdef] at hy; exact hy.2
  have hy₀Ω : chartAt E3 q q ∈ Ω := by
    rw [hΩdef]
    refine ⟨hy₀t, ?_⟩
    show (chartAt E3 q).symm (chartAt E3 q q) ∈ V ∩ Vi
    rw [hy₀q]; exact ⟨hqV, hqVi⟩
  have hf0 : (fun y => f ((chartAt E3 q).symm y)) (chartAt E3 q q) = 0 := by
    show f ((chartAt E3 q).symm (chartAt E3 q q)) = 0
    rw [hy₀q]; exact (hmemV q hqV).1 hq
  
  have hdfy : ∀ y ∈ (chartAt E3 q).target, (chartAt E3 q).symm y ∈ V →
      fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) y ≠ 0 := by
    intro y hy hyV
    have hx : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have h := ((ejp_chart_transfer g q f hf).2 _ hx (hdf _ hyV)).1
    rwa [(chartAt E3 q).right_inv hy] at h
  have hZ : ∀ y ∈ Ω, (fun z => f ((chartAt E3 q).symm z)) y = 0 →
      (fun z => fi ((chartAt E3 q).symm z)) y = 0 := by
    intro y hy h0
    obtain ⟨hyV, hyVi⟩ := hΩV y hy
    exact (hmemVi _ hyVi).1 ((hmemV _ hyV).2 h0)
  have hy₀V : (chartAt E3 q).symm (chartAt E3 q q) ∈ V := by rw [hy₀q]; exact hqV
  obtain ⟨r, hr, u, hball, hu, hfac⟩ := coord_division Ω hΩo
    (fun z => f ((chartAt E3 q).symm z)) (fun z => fi ((chartAt E3 q).symm z))
    ((hcd f hf).mono hΩt) ((hcd fi hfi).mono hΩt) (chartAt E3 q q) hy₀Ω hf0
    (hdfy _ hy₀t hy₀V) hZ
  refine ⟨Metric.ball (chartAt E3 q q) r, u, Metric.isOpen_ball, Metric.mem_ball_self hr,
    hball.trans hΩt, hu, ?_, ?_⟩
  · 
    intro y hy
    have h : fi ((chartAt E3 q).symm y) = f ((chartAt E3 q).symm y) * u y := hfac y hy
    rw [h]; ring
  · 
    intro y hy h0
    suffices hu1 : u y ^ 2 = 1 by rw [hu1, mul_one]
    have hyΩ := hball hy
    have hyt : y ∈ (chartAt E3 q).target := hΩt hyΩ
    obtain ⟨hyV, hyVi⟩ := hΩV y hyΩ
    have hxS : (chartAt E3 q).symm y ∈ V ∩ Vi ∩ Sig := ⟨⟨hyV, hyVi⟩, (hmemV _ hyV).2 h0⟩
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 q).symm.toPartialEquiv
        open_source := (chartAt E3 q).open_target
        open_target := (chartAt E3 q).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hgi : g.gradInner fi fi ((chartAt E3 q).symm y) = ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
          partialDeriv i (fun z => fi ((chartAt E3 q).symm z)) y *
          partialDeriv j (fun z => fi ((chartAt E3 q).symm z)) y :=
      gradInner_eq_coord g Φ fi (fun z => fi ((chartAt E3 q).symm z)) hfi y hyt
        (Filter.Eventually.of_forall (fun _ => rfl))
    have hg : g.gradInner f f ((chartAt E3 q).symm y) = ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
          partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
          partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y :=
      gradInner_eq_coord g Φ f (fun z => f ((chartAt E3 q).symm z)) hf y hyt
        (Filter.Eventually.of_forall (fun _ => rfl))
    
    have hdft : DifferentiableAt ℝ (fun z => f ((chartAt E3 q).symm z)) y :=
      ((hcd f hf).contDiffAt ((chartAt E3 q).open_target.mem_nhds hyt)).differentiableAt hn0
    have hdu : DifferentiableAt ℝ u y :=
      (hu.contDiffAt (Metric.isOpen_ball.mem_nhds hy)).differentiableAt hn0
    have hev : (fun z => fi ((chartAt E3 q).symm z)) =ᶠ[𝓝 y]
        fun z => f ((chartAt E3 q).symm z) * u z :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hy) hfac
    have hD : fderiv ℝ (fun z => fi ((chartAt E3 q).symm z)) y =
        u y • fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) y := by
      have hm : HasFDerivAt (fun z => f ((chartAt E3 q).symm z) * u z)
          (f ((chartAt E3 q).symm y) • fderiv ℝ u y +
            u y • fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) y) y :=
        hdft.hasFDerivAt.mul hdu.hasFDerivAt
      rw [hev.fderiv_eq, hm.fderiv]
      have h0' : f ((chartAt E3 q).symm y) = 0 := h0
      rw [h0', zero_smul, zero_add]
    have hpd : ∀ i : Fin 3, partialDeriv i (fun z => fi ((chartAt E3 q).symm z)) y =
        u y * partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y := by
      intro i
      simp only [partialDeriv, hD, ContinuousLinearMap.smul_apply, smul_eq_mul]
    
    have hp0 : (fun j : Fin 3 => partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y) ≠ 0 := by
      intro hp
      apply hdfy y hyt hyV
      have hb : ∀ j : Fin 3, fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) y (e j) = 0 :=
        fun j => congrFun hp j
      apply ContinuousLinearMap.ext
      intro v
      have hv : v = ∑ j : Fin 3, v j • e j := by
        have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
        simpa using this.symm
      rw [hv, map_sum]
      simp [map_smul, hb]
    have hA : ((g.coeff (chartAt E3 q).symm y)⁻¹).PosDef :=
      (coeff_chart_symm_posDef g q y hyt).inv
    have hS : 0 < ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
        partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
        partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y := by
      have h := hA.dotProduct_mulVec_pos hp0
      simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum] at h
      have e' : ∀ i j : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
          partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
          partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y =
          partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
          ((g.coeff (chartAt E3 q).symm y)⁻¹ i j *
            partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y) := fun i j => by ring
      simp only [e']
      exact h
    have hQ : g.gradInner fi fi ((chartAt E3 q).symm y) = u y ^ 2 *
        ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
          partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
          partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y := by
      rw [hgi, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hpd i, hpd j]
      ring
    have hEq := hgrad _ hxS
    rw [hQ, hg] at hEq
    have hmul : (u y ^ 2 - 1) * (∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
        partialDeriv i (fun z => f ((chartAt E3 q).symm z)) y *
        partialDeriv j (fun z => f ((chartAt E3 q).symm z)) y) = 0 := by
      rw [sub_mul, one_mul, hEq, sub_self]
    rcases mul_eq_zero.1 hmul with h1 | h1
    · linarith
    · exact absurd h1 hS.ne'

theorem collar_zero_minimal [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig) (q : M) (hq : q ∈ Sig) (V : Set M)
    (f : M → ℝ) (hVo : IsOpen V) (hqV : q ∈ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) (hVS : V ∩ Sig = V ∩ f ⁻¹' {0}) :
    ∃ O : Set E3, IsOpen O ∧ chartAt E3 q q ∈ O ∧ O ⊆ (chartAt E3 q).target ∧
      ∀ y ∈ O, f ((chartAt E3 q).symm y) = 0 →
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun z => f ((chartAt E3 q).symm z)) y
          = 0 :=
by
  classical
  
  have hcongr : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (h₁ h₂ : E3 → ℝ) (y : E3),
      h₁ =ᶠ[𝓝 y] h₂ → levelMeanCurvCoord G h₁ y = levelMeanCurvCoord G h₂ y := by
    intro G h₁ h₂ y hh
    have hp : ∀ k, partialDeriv k h₁ y = partialDeriv k h₂ y := by
      intro k
      unfold partialDeriv
      rw [hh.fderiv_eq]
    have hg : ∀ j, partialDeriv j h₁ =ᶠ[𝓝 y] partialDeriv j h₂ := by
      intro j
      exact (Filter.EventuallyEq.fderiv (𝕜 := ℝ) hh).mono fun z hz => by
        simp only [partialDeriv, hz]
    have hpp : ∀ i j, partialDeriv i (partialDeriv j h₁) y =
        partialDeriv i (partialDeriv j h₂) y := by
      intro i j
      show fderiv ℝ (partialDeriv j h₁) y (e i) = fderiv ℝ (partialDeriv j h₂) y (e i)
      rw [(hg j).fderiv_eq]
    have hH : ∀ i j, hessLoc G h₁ i j y = hessLoc G h₂ i j y := by
      intro i j
      simp only [hessLoc, hp, hpp]
    simp only [levelMeanCurvCoord, lapLoc, hH, hp]
  
  have hqsrc : q ∈ (chartAt E3 q).source := mem_chart_source E3 q
  have hy₀t : chartAt E3 q q ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hqsrc
  have hy₀q : (chartAt E3 q).symm (chartAt E3 q q) = q := (chartAt E3 q).left_inv hqsrc
  have hcd : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 q).symm y)) (chartAt E3 q).target :=
    fun u hu => contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hdiff : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ y ∈ (chartAt E3 q).target,
      DifferentiableAt ℝ (fun y => u ((chartAt E3 q).symm y)) y :=
    fun u hu y hy => ((hcd u hu).contDiffAt
      ((chartAt E3 q).open_target.mem_nhds hy)).differentiableAt (by simp)
  have hnd : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ y ∈ (chartAt E3 q).target,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm y) ≠ 0 →
      fderiv ℝ (fun z => u ((chartAt E3 q).symm z)) y ≠ 0 := by
    intro u hu y hy hmu h0
    apply hmu
    have hx : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hκx : chartAt E3 q ((chartAt E3 q).symm y) = y := (chartAt E3 q).right_inv hy
    have hev : u =ᶠ[𝓝 ((chartAt E3 q).symm y)]
        (fun z => u ((chartAt E3 q).symm z)) ∘ (chartAt E3 q) := by
      filter_upwards [(chartAt E3 q).open_source.mem_nhds hx] with x hx'
      simp only [Function.comp_apply, (chartAt E3 q).left_inv hx']
    rw [hev.mfderiv_eq]
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => u ((chartAt E3 q).symm z))
        (chartAt E3 q ((chartAt E3 q).symm y)) := by
      rw [hκx]
      exact mdifferentiableAt_iff_differentiableAt.2 (hdiff u hu y hy)
    have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞)).contMDiffAt
        ((chartAt E3 q).open_source.mem_nhds hx)).mdifferentiableAt (by simp)
    rw [mfderiv_comp _ hd1 hd2, hκx, mfderiv_eq_fderiv, h0, ContinuousLinearMap.zero_comp]
  
  obtain ⟨V', f', hV'V, hV'o, hqV', hf', hdf', hV'S, hmin, -, -⟩ :=
    hSm.2 q hq V (hVo.mem_nhds hqV)
  have hΩo : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' V') :=
    (chartAt E3 q).isOpen_inter_preimage_symm hV'o
  have hy₀Ω : chartAt E3 q q ∈ (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' V' := by
    refine ⟨hy₀t, ?_⟩
    show (chartAt E3 q).symm (chartAt E3 q q) ∈ V'
    rw [hy₀q]
    exact hqV'
  have hzero : ∀ x ∈ V', f x = 0 → f' x = 0 := by
    intro x hx h0
    have h1 : x ∈ V ∩ f ⁻¹' {0} := ⟨hV'V hx, h0⟩
    rw [← hVS] at h1
    have h2 : x ∈ V' ∩ Sig := ⟨hx, h1.2⟩
    rw [hV'S] at h2
    exact h2.2
  have hfq : f q = 0 := by
    have h1 : q ∈ V ∩ Sig := ⟨hqV, hq⟩
    rw [hVS] at h1
    exact h1.2
  have hf0 : (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q q) = 0 := by
    show f ((chartAt E3 q).symm (chartAt E3 q q)) = 0
    rw [hy₀q]
    exact hfq
  have hdf0 : fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q q) ≠ 0 :=
    hnd f hf _ hy₀t (by rw [hy₀q]; exact hdf q hqV)
  
  obtain ⟨r, hr, u, hball, hu, hdiv⟩ := coord_division
    ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' V') hΩo
    (fun z => f ((chartAt E3 q).symm z)) (fun z => f' ((chartAt E3 q).symm z))
    ((hcd f hf).mono Set.inter_subset_left) ((hcd f' hf').mono Set.inter_subset_left)
    (chartAt E3 q q) hy₀Ω hf0 hdf0 (fun y hy h0 => hzero _ hy.2 h0)
  have hsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 q).symm y i j = g.coeff (chartAt E3 q).symm y j i :=
    fun y i j => g.symm _ _ _
  let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    { toPartialEquiv := (chartAt E3 q).symm.toPartialEquiv
      open_source := (chartAt E3 q).open_target
      open_target := (chartAt E3 q).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  refine ⟨Metric.ball (chartAt E3 q q) r, Metric.isOpen_ball, Metric.mem_ball_self hr,
    fun y hy => (hball hy).1, fun z hzO h0 => ?_⟩
  have hzΩ := hball hzO
  have hzt : z ∈ (chartAt E3 q).target := hzΩ.1
  have hzV' : (chartAt E3 q).symm z ∈ V' := hzΩ.2
  have hgerm : (fun y => f' ((chartAt E3 q).symm y)) =ᶠ[𝓝 z]
      (fun y => f ((chartAt E3 q).symm y) * u y) :=
    Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hzO) hdiv
  have hd₁ : DifferentiableAt ℝ (fun y => f ((chartAt E3 q).symm y)) z := hdiff f hf z hzt
  have hd₂ : DifferentiableAt ℝ u z :=
    (hu.contDiffAt (Metric.isOpen_ball.mem_nhds hzO)).differentiableAt (by simp)
  have hfd : fderiv ℝ (fun y => f' ((chartAt E3 q).symm y)) z =
      u z • fderiv ℝ (fun y => f ((chartAt E3 q).symm y)) z := by
    have hm : HasFDerivAt (fun y => f ((chartAt E3 q).symm y) * u y)
        ((fun y => f ((chartAt E3 q).symm y)) z • fderiv ℝ u z +
          u z • fderiv ℝ (fun y => f ((chartAt E3 q).symm y)) z) z :=
      hd₁.hasFDerivAt.mul hd₂.hasFDerivAt
    rw [hgerm.fderiv_eq, hm.fderiv]
    simp only [h0, zero_smul, zero_add]
  have huz : u z ≠ 0 := by
    intro hu0
    apply hnd f' hf' z hzt (hdf' _ hzV')
    rw [hfd, hu0, zero_smul]
  have hf'z : f' ((chartAt E3 q).symm z) = 0 := hzero _ hzV' h0
  have hE1 := lmc_mul_zero (g.coeff (chartAt E3 q).symm) (Metric.ball (chartAt E3 q q) r)
    Metric.isOpen_ball hsymm (fun y => f ((chartAt E3 q).symm y)) u
    ((hcd f hf).mono (fun y hy => (hball hy).1)) hu z hzO
    (coeff_chart_symm_posDef g q z hzt) h0 (hnd f hf z hzt (hdf _ (hV'V hzV'))) huz
  have hgermH : levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
      (fun y => f' ((chartAt E3 q).symm y)) z =
      levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
        (fun y => f ((chartAt E3 q).symm y) * u y) z :=
    hcongr _ _ _ z hgerm
  have hlmc : g.levelMeanCurv f' ((chartAt E3 q).symm z) =
      levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
        (fun y => f' ((chartAt E3 q).symm y)) z :=
    levelMeanCurv_eq_coord g Φ f' (fun y => f' ((chartAt E3 q).symm y)) hf' z hzt
      (Filter.Eventually.of_forall (fun _ => rfl))
  have hH0 : levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
      (fun y => f ((chartAt E3 q).symm y) * u y) z = 0 := by
    rw [← hgermH, ← hlmc]
    exact hmin _ hzV' hf'z
  rw [hH0, zero_mul] at hE1
  exact (mul_eq_zero.mp hE1.symm).resolve_left huz

theorem collar_chart_data [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig) (q : M) (hq : q ∈ Sig) (V : Set M)
    (f : M → ℝ) (hVo : IsOpen V) (hqV : q ∈ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) (hVS : V ∩ Sig = V ∩ f ⁻¹' {0})
    {ι : Type*} (t : Finset ι) (β fi : ι → M → ℝ) (Vi : ι → Set M)
    (hVio : ∀ i ∈ t, IsOpen (Vi i)) (hβ : ∀ i ∈ t, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (β i))
    (hβs : ∀ i ∈ t, tsupport (β i) ⊆ Vi i)
    (hfi : ∀ i ∈ t, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fi i))
    (hdfi : ∀ i ∈ t, ∀ x ∈ Vi i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fi i) x ≠ 0)
    (hViS : ∀ i ∈ t, Vi i ∩ Sig = Vi i ∩ (fi i) ⁻¹' {0})
    (hgrad : ∀ i ∈ t, ∀ x ∈ V ∩ Vi i ∩ Sig, g.gradInner (fi i) (fi i) x = g.gradInner f f x)
    (D : M → ℝ) (hD : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ D) (hDpos : ∀ x, 0 < D x) (N₀ : Set M)
    (hN₀ : N₀ ∈ 𝓝 q) (hDS : ∀ x ∈ N₀, D x = ∑ i ∈ t, β i x) (w : M → ℝ)
    (hw : ∀ x, w x = (∑ i ∈ t, β i x * fi i x ^ 2) / D x) :
    ∃ (U : Set E3) (Q : E3 → ℝ), IsOpen U ∧ chartAt E3 q q ∈ U ∧ U ⊆ (chartAt E3 q).target ∧
      (∀ y ∈ U, (chartAt E3 q).symm y ∈ V) ∧ ContDiffOn ℝ ∞ Q U ∧
      (∀ y ∈ U, w ((chartAt E3 q).symm y) = f ((chartAt E3 q).symm y) ^ 2 * Q y) ∧
      (∀ y ∈ U, f ((chartAt E3 q).symm y) = 0 → Q y = 1) ∧
      (∀ y ∈ U, f ((chartAt E3 q).symm y) = 0 →
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun z => f ((chartAt E3 q).symm z)) y
          = 0) ∧
      fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q q) ≠ 0 :=
by
  classical
  
  have hidx : ∀ i, ∃ (O : Set E3) (u : E3 → ℝ), i ∈ t → (IsOpen O ∧ chartAt E3 q q ∈ O ∧
      O ⊆ (chartAt E3 q).target ∧ ContDiffOn ℝ ∞ u O ∧
      (∀ y ∈ O, β i ((chartAt E3 q).symm y) * fi i ((chartAt E3 q).symm y) ^ 2 =
        β i ((chartAt E3 q).symm y) * (f ((chartAt E3 q).symm y) ^ 2 * u y ^ 2)) ∧
      (∀ y ∈ O, f ((chartAt E3 q).symm y) = 0 →
        β i ((chartAt E3 q).symm y) * u y ^ 2 = β i ((chartAt E3 q).symm y))) := by
    intro i
    by_cases hi : i ∈ t
    · obtain ⟨O, u, h⟩ := collar_index_factor g Sig q hq V f hVo hqV hf hdf hVS (β i) (fi i)
        (Vi i) (hVio i hi) (hβs i hi) (hfi i hi) (hViS i hi) (hgrad i hi)
      exact ⟨O, u, fun _ => h⟩
    · exact ⟨Set.univ, 0, fun h => absurd h hi⟩
  choose Oi ui hOi using hidx
  
  obtain ⟨OH, hOHo, hOHq, -, hOH⟩ := collar_zero_minimal g Sig hSm q hq V f hVo hqV hf hdf hVS
  
  obtain ⟨N', hN'N₀, hN'o, hqN'⟩ := mem_nhds_iff.1 hN₀
  have hqsrc : q ∈ (chartAt E3 q).source := mem_chart_source E3 q
  have hy₀t : chartAt E3 q q ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hqsrc
  have hy₀q : (chartAt E3 q).symm (chartAt E3 q q) = q := (chartAt E3 q).left_inv hqsrc
  have hcd : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 q).symm y)) (chartAt E3 q).target :=
    fun u hu => contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hβc : ∀ i ∈ t, ContDiffOn ℝ ∞ (fun y => β i ((chartAt E3 q).symm y))
      (chartAt E3 q).target := fun i hi => hcd (β i) (hβ i hi)
  have hDc : ContDiffOn ℝ ∞ (fun y => D ((chartAt E3 q).symm y)) (chartAt E3 q).target :=
    hcd D hD
  
  obtain ⟨U, hUdef⟩ : ∃ U : Set E3, U = OH ∩ ((chartAt E3 q).target ∩
      (chartAt E3 q).symm ⁻¹' (V ∩ N')) ∩ ⋂ i ∈ t, Oi i := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hUdef]
    exact (hOHo.inter ((chartAt E3 q).isOpen_inter_preimage_symm (hVo.inter hN'o))).inter
      (isOpen_biInter_finset fun i hi => (hOi i hi).1)
  have hy₀U : chartAt E3 q q ∈ U := by
    rw [hUdef]
    refine ⟨⟨hOHq, hy₀t, ?_⟩, Set.mem_iInter₂.2 fun i hi => (hOi i hi).2.1⟩
    show (chartAt E3 q).symm (chartAt E3 q q) ∈ V ∩ N'
    rw [hy₀q]
    exact ⟨hqV, hqN'⟩
  have hUH : ∀ y ∈ U, y ∈ OH := by
    intro y hy; rw [hUdef] at hy; exact hy.1.1
  have hUt : U ⊆ (chartAt E3 q).target := by
    intro y hy; rw [hUdef] at hy; exact hy.1.2.1
  have hUV : ∀ y ∈ U, (chartAt E3 q).symm y ∈ V := by
    intro y hy; rw [hUdef] at hy; exact hy.1.2.2.1
  have hUN : ∀ y ∈ U, (chartAt E3 q).symm y ∈ N₀ := by
    intro y hy; rw [hUdef] at hy; exact hN'N₀ hy.1.2.2.2
  have hUi : ∀ i ∈ t, U ⊆ Oi i := by
    intro i hi y hy; rw [hUdef] at hy; exact Set.mem_iInter₂.1 hy.2 i hi
  
  obtain ⟨Q, hQdef⟩ : ∃ Q : E3 → ℝ, Q = fun y =>
      (∑ i ∈ t, β i ((chartAt E3 q).symm y) * ui i y ^ 2) / D ((chartAt E3 q).symm y) :=
    ⟨_, rfl⟩
  have hQs : ContDiffOn ℝ ∞ Q U := by
    rw [hQdef]
    apply ContDiffOn.div
    · apply ContDiffOn.sum
      intro i hi
      exact ((hβc i hi).mono hUt).mul (((hOi i hi).2.2.2.1.mono (hUi i hi)).pow 2)
    · exact hDc.mono hUt
    · intro y _
      exact (hDpos _).ne'
  refine ⟨U, Q, hUo, hy₀U, hUt, hUV, hQs, ?_, ?_, ?_, ?_⟩
  · 
    intro y hy
    rw [hw, hQdef]
    have hsum : ∑ i ∈ t, β i ((chartAt E3 q).symm y) * fi i ((chartAt E3 q).symm y) ^ 2 =
        f ((chartAt E3 q).symm y) ^ 2 *
          ∑ i ∈ t, β i ((chartAt E3 q).symm y) * ui i y ^ 2 := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      rw [(hOi i hi).2.2.2.2.1 y (hUi i hi hy)]
      ring
    rw [hsum, mul_div_assoc]
  · 
    intro y hy h0
    rw [hQdef]
    have hsum : ∑ i ∈ t, β i ((chartAt E3 q).symm y) * ui i y ^ 2 =
        D ((chartAt E3 q).symm y) := by
      rw [hDS _ (hUN y hy)]
      apply Finset.sum_congr rfl
      intro i hi
      exact (hOi i hi).2.2.2.2.2 y (hUi i hi hy) h0
    show (∑ i ∈ t, β i ((chartAt E3 q).symm y) * ui i y ^ 2) / D ((chartAt E3 q).symm y) = 1
    rw [hsum, div_self (hDpos _).ne']
  · 
    intro y hy h0
    exact hOH y (hUH y hy) h0
  · 
    intro h0
    apply hdf q hqV
    have hev : f =ᶠ[𝓝 q] (fun y => f ((chartAt E3 q).symm y)) ∘ (chartAt E3 q) := by
      filter_upwards [(chartAt E3 q).open_source.mem_nhds hqsrc] with x hx
      simp only [Function.comp_apply, (chartAt E3 q).left_inv hx]
    rw [hev.mfderiv_eq]
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y => f ((chartAt E3 q).symm y))
        (chartAt E3 q q) :=
      mdifferentiableAt_iff_differentiableAt.2
        (((hcd f hf).contDiffAt ((chartAt E3 q).open_target.mem_nhds hy₀t)).differentiableAt
          (by simp))
    have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) q :=
      ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞)).contMDiffAt
        ((chartAt E3 q).open_source.mem_nhds hqsrc)).mdifferentiableAt (by simp)
    rw [mfderiv_comp q hd1 hd2, mfderiv_eq_fderiv, h0, ContinuousLinearMap.zero_comp]

theorem jacobiCoord_invariance (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpd : ∀ y ∈ U, (G y).PosDef) (f a F : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (ha : ContDiffOn ℝ ∞ a U) (hF : ∀ y ∈ U, F y = f y + f y ^ 2 * a y) (y₁ : E3) (hy₁ : y₁ ∈ U) (hf0 : f y₁ = 0) (hdf : fderiv ℝ f y₁ ≠ 0) : levelMeanCurvCoord G F y₁ = levelMeanCurvCoord G f y₁ ∧ ∀ i : Fin 3, partialDeriv i (levelMeanCurvCoord G F) y₁ = partialDeriv i (levelMeanCurvCoord G f) y₁ :=
by
  have hn0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hdiffU : ∀ φ : E3 → ℝ, ContDiffOn ℝ ∞ φ U → ∀ z ∈ U, DifferentiableAt ℝ φ z :=
    fun φ hφ z hz => (hφ.contDiffAt (hU.mem_nhds hz)).differentiableAt hn0
  have hpdU : ∀ φ : E3 → ℝ, ContDiffOn ℝ ∞ φ U → ∀ i, ContDiffOn ℝ ∞ (partialDeriv i φ) U :=
    fun φ hφ i => (hφ.fderiv_of_isOpen hU (by exact_mod_cast le_top)).clm_apply contDiffOn_const
  
  have hfirst : ∀ z ∈ U, ∀ j, partialDeriv j F z =
      (1 + 2 * f z * a z) * partialDeriv j f z + f z ^ 2 * partialDeriv j a z := by
    intro z hz j
    have hfz := (hdiffU f hf z hz).hasFDerivAt
    have haz := (hdiffU a ha z hz).hasFDerivAt
    have hev : F =ᶠ[𝓝 z] fun w => f w + f w ^ 2 * a w :=
      Filter.eventually_of_mem (hU.mem_nhds hz) hF
    have hd := hfz.add ((hfz.pow 2).mul haz)
    unfold partialDeriv
    rw [show fderiv ℝ F z = _ from hev.fderiv_eq.trans hd.fderiv]
    simp
    ring
  have hsecond : ∀ y ∈ U, ∀ i j, partialDeriv i (partialDeriv j F) y =
      (1 + 2 * f y * a y) * partialDeriv i (partialDeriv j f) y
        + 2 * a y * partialDeriv i f y * partialDeriv j f y
        + 2 * f y * (partialDeriv i f y * partialDeriv j a y + partialDeriv i a y * partialDeriv j f y)
        + f y ^ 2 * partialDeriv i (partialDeriv j a) y := by
    intro y hy i j
    have hev : partialDeriv j F =ᶠ[𝓝 y] fun z =>
        (1 + 2 * f z * a z) * partialDeriv j f z + f z ^ 2 * partialDeriv j a z :=
      Filter.eventually_of_mem (hU.mem_nhds hy) (fun z hz => hfirst z hz j)
    have hfy := (hdiffU f hf y hy).hasFDerivAt
    have hay := (hdiffU a ha y hy).hasFDerivAt
    have hpf := (hdiffU _ (hpdU f hf j) y hy).hasFDerivAt
    have hpa := (hdiffU _ (hpdU a ha j) y hy).hasFDerivAt
    have hd := (((hasFDerivAt_const (1 : ℝ) y).add ((hfy.const_mul 2).fun_mul hay)).fun_mul hpf).add
      ((hfy.pow 2).fun_mul hpa)
    show fderiv ℝ (partialDeriv j F) y (e i) = _
    rw [show fderiv ℝ (partialDeriv j F) y = _ from hev.fderiv_eq.trans hd.fderiv]
    simp only [partialDeriv]
    simp
    ring
  
  have hfd : DifferentiableAt ℝ f y₁ := hdiffU f hf y₁ hy₁
  have had : DifferentiableAt ℝ a y₁ := hdiffU a ha y₁ hy₁
  have hpf : ∀ k, DifferentiableAt ℝ (partialDeriv k f) y₁ := fun k => hdiffU _ (hpdU f hf k) y₁ hy₁
  have hpa : ∀ k, DifferentiableAt ℝ (partialDeriv k a) y₁ := fun k => hdiffU _ (hpdU a ha k) y₁ hy₁
  have hppf : ∀ i j, DifferentiableAt ℝ (partialDeriv i (partialDeriv j f)) y₁ :=
    fun i j => hdiffU _ (hpdU _ (hpdU f hf j) i) y₁ hy₁
  have hppa : ∀ i j, DifferentiableAt ℝ (partialDeriv i (partialDeriv j a)) y₁ :=
    fun i j => hdiffU _ (hpdU _ (hpdU a ha j) i) y₁ hy₁
  have hGd : ∀ i j, DifferentiableAt ℝ (fun y => G y i j) y₁ := fun i j => hdiffU _ (hG i j) y₁ hy₁
  have hdet : ∀ M : E3 → Matrix (Fin 3) (Fin 3) ℝ, (∀ i j, DifferentiableAt ℝ (fun y => M y i j) y₁) →
      DifferentiableAt ℝ (fun y => (M y).det) y₁ := by
    intro M hM
    simp only [Matrix.det_fin_three]
    have h00 := hM 0 0; have h01 := hM 0 1; have h02 := hM 0 2
    have h10 := hM 1 0; have h11 := hM 1 1; have h12 := hM 1 2
    have h20 := hM 2 0; have h21 := hM 2 1; have h22 := hM 2 2
    fun_prop
  have hPd : ∀ i j, DifferentiableAt ℝ (fun y => (G y)⁻¹ i j) y₁ := by
    intro i j
    have e1 : (fun y => (G y)⁻¹ i j) = fun y => ((G y).det)⁻¹ * (G y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
    rw [e1]
    have hadj : DifferentiableAt ℝ (fun y => (G y).adjugate i j) y₁ := by
      simp only [Matrix.adjugate_apply]
      apply hdet (fun y => (G y).updateRow j (Pi.single i 1))
      intro k l
      simp only [Matrix.updateRow_apply]
      by_cases hkj : k = j
      · simp only [hkj, ↓reduceIte]; exact differentiableAt_const _
      · simp only [hkj, ↓reduceIte]; exact hGd k l
    exact ((hdet G hGd).inv (hGpd y₁ hy₁).det_pos.ne').mul hadj
  have hpGd : ∀ m r t, DifferentiableAt ℝ (partialDeriv m (fun z => G z r t)) y₁ :=
    fun m r t => hdiffU _ (hpdU _ (hG r t) m) y₁ hy₁
  have hΓd : ∀ k i j, DifferentiableAt ℝ (christoffel G k i j) y₁ := by
    intro k i j
    have e1 : christoffel G k i j = fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y) := rfl
    rw [e1]
    exact (differentiableAt_const _).mul (DifferentiableAt.fun_sum fun l _ =>
      (hPd k l).mul (((hpGd i j l).add (hpGd j i l)).sub (hpGd l i j)))
  
  have hsym : ∀ y ∈ U, ∀ i j, (G y)⁻¹ i j = (G y)⁻¹ j i := by
    intro y hy i j
    have h := (hGpd y hy).inv.1.apply i j
    simpa using h.symm
  have hpos : 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G y₁)⁻¹ i j * partialDeriv i f y₁ * partialDeriv j f y₁ := by
    have hp : (fun i : Fin 3 => partialDeriv i f y₁) ≠ 0 := by
      intro h0
      apply hdf
      have hz : ∀ i, fderiv ℝ f y₁ (e i) = 0 := fun i => congrFun h0 i
      ext1 w
      have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
        ext k; fin_cases k <;> simp
      rw [hw]
      simp [hz]
    have h := (Matrix.posDef_iff_dotProduct_mulVec.mp (hGpd y₁ hy₁).inv).2 hp
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, star_trivial] at h ⊢
    linarith
  
  have jet : ∀ (Ψ : E3 × ℝ → ℝ) (A B : E3 → ℝ), DifferentiableAt ℝ Ψ (y₁, 0) →
      (A =ᶠ[𝓝 y₁] fun y => Ψ (y, f y ^ 2)) → (B =ᶠ[𝓝 y₁] fun y => Ψ (y, 0)) →
      A y₁ = B y₁ ∧ ∀ i, partialDeriv i A y₁ = partialDeriv i B y₁ := by
    intro Ψ A B hΨ hA hB
    have h2 : HasFDerivAt (fun y => f y ^ 2) (0 : E3 →L[ℝ] ℝ) y₁ := by
      have := hfd.hasFDerivAt.pow 2
      simpa [hf0] using this
    have hγ1 := (hasFDerivAt_id (𝕜 := ℝ) y₁).prodMk h2
    have hγ0 := (hasFDerivAt_id (𝕜 := ℝ) y₁).prodMk (hasFDerivAt_const (0 : ℝ) y₁)
    have hpt : (id y₁, f y₁ ^ 2) = (y₁, (0 : ℝ)) := by simp [hf0]
    have hΨ1 : HasFDerivAt Ψ (fderiv ℝ Ψ (y₁, 0)) (id y₁, f y₁ ^ 2) := by
      rw [hpt]; exact hΨ.hasFDerivAt
    have c1 := hΨ1.comp y₁ hγ1
    have c0 := hΨ.hasFDerivAt.comp y₁ hγ0
    have eA := hA.fderiv_eq.trans c1.fderiv
    have eB := hB.fderiv_eq.trans c0.fderiv
    refine ⟨?_, fun i => ?_⟩
    · rw [hA.eq_of_nhds, hB.eq_of_nhds]; simp [hf0]
    · unfold partialDeriv; rw [eA, eB]
  
  obtain ⟨Ex, hEx⟩ : ∃ Ex : Matrix (Fin 3) (Fin 3) ℝ → (Fin 3 → ℝ) → (Fin 3 → Fin 3 → ℝ) → ℝ,
      Ex = fun P v h => (∑ i : Fin 3, ∑ j : Fin 3, P i j * h i j) /
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, P i j * v i * v j) -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, P i a * v a * (P j b * v b) * h i j) /
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, P i j * v i * v j) ^ 3 := ⟨_, rfl⟩
  have hlmc : ∀ φ y, levelMeanCurvCoord G φ y =
      Ex ((G y)⁻¹) (fun k => partialDeriv k φ y) (fun i j => hessLoc G φ i j y) := by
    intro φ y; rw [hEx]; rfl
  have key : ∀ P : Matrix (Fin 3) (Fin 3) ℝ, (∀ i j, P i j = P j i) → ∀ (v u : Fin 3 → ℝ)
      (h : Fin 3 → Fin 3 → ℝ) (c : ℝ), 0 < c →
      Ex P (fun k => c * v k) (fun i j => c * h i j + v i * u j + u i * v j) = Ex P v h := by
    intro P hP v u h c hc
    rw [hEx]
    dsimp only
    have R1 : ∑ i : Fin 3, ∑ j : Fin 3, P i j * (c * v i) * (c * v j) =
        c ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, P i j * v i * v j := by
      simp only [Fin.sum_univ_three]; ring
    have R3 : ∑ i : Fin 3, ∑ j : Fin 3, P i j * (c * h i j + v i * u j + u i * v j) =
        c * ∑ i : Fin 3, ∑ j : Fin 3, P i j * h i j
          + 2 * ∑ i : Fin 3, ∑ j : Fin 3, P i j * u i * v j := by
      simp only [Fin.sum_univ_three]; rw [hP 1 0, hP 2 0, hP 2 1]; ring
    have R4 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        P i a * (c * v a) * (P j b * (c * v b)) * (c * h i j + v i * u j + u i * v j) =
        c ^ 3 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          P i a * v a * (P j b * v b) * h i j)
        + 2 * c ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, P i j * v i * v j) *
          (∑ i : Fin 3, ∑ j : Fin 3, P i j * u i * v j) := by
      simp only [Fin.sum_univ_three]; ring
    rw [R1, R3, R4]
    generalize ∑ i : Fin 3, ∑ j : Fin 3, P i j * v i * v j = N
    generalize ∑ i : Fin 3, ∑ j : Fin 3, P i j * h i j = L
    generalize ∑ i : Fin 3, ∑ j : Fin 3, P i j * u i * v j = β
    generalize ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
      P i a * v a * (P j b * v b) * h i j = Q
    rw [Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc.le]
    by_cases hs : Real.sqrt N = 0
    · simp [hs]
    · have hNpos : 0 < N := Real.sqrt_pos.mp (lt_of_le_of_ne (Real.sqrt_nonneg _) (Ne.symm hs))
      have hN : N = Real.sqrt N ^ 2 := (Real.sq_sqrt hNpos.le).symm
      generalize Real.sqrt N = s at hs hN ⊢
      subst hN
      have hc0 : c ≠ 0 := hc.ne'
      field_simp
      ring
  
  obtain ⟨v, hv⟩ : ∃ v : E3 × ℝ → Fin 3 → ℝ, v = fun x k =>
      partialDeriv k f x.1 + x.2 * (partialDeriv k a x.1 / (1 + 2 * f x.1 * a x.1)) := ⟨_, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : E3 → Fin 3 → Fin 3 → ℝ, E = fun y i j =>
      (2 * a y * f y ^ 2 / (1 + 2 * f y * a y) ^ 3 - 4 * f y / (1 + 2 * f y * a y) ^ 2) *
        partialDeriv i a y * partialDeriv j a y
        + partialDeriv i (partialDeriv j a) y / (1 + 2 * f y * a y) := ⟨_, rfl⟩
  obtain ⟨hh, hhh⟩ : ∃ hh : E3 × ℝ → Fin 3 → Fin 3 → ℝ, hh = fun x i j =>
      partialDeriv i (partialDeriv j f) x.1 + x.2 * E x.1 i j
        - ∑ k : Fin 3, christoffel G k i j x.1 * v x k := ⟨_, rfl⟩
  obtain ⟨uu, huu⟩ : ∃ uu : E3 → Fin 3 → ℝ, uu = fun y k =>
      a y * v (y, f y ^ 2) k - 2 * a y * f y ^ 2 * partialDeriv k a y / (1 + 2 * f y * a y)
        + 2 * f y * partialDeriv k a y := ⟨_, rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E3 × ℝ → ℝ, Ψ = fun x => Ex ((G x.1)⁻¹) (v x) (hh x) := ⟨_, rfl⟩
  
  have s12 : ∀ y ∈ U, 0 < 1 + 2 * f y * a y → levelMeanCurvCoord G F y = Ψ (y, f y ^ 2) := by
    intro y hyU hc
    have hc0 : 1 + 2 * f y * a y ≠ 0 := hc.ne'
    have e1 : (fun k => partialDeriv k F y) = fun k => (1 + 2 * f y * a y) * v (y, f y ^ 2) k := by
      funext k
      rw [hfirst y hyU k]
      simp only [hv]
      field_simp
      try ring
    have e2 : (fun i j => hessLoc G F i j y) = fun i j => (1 + 2 * f y * a y) * hh (y, f y ^ 2) i j
        + v (y, f y ^ 2) i * uu y j + uu y i * v (y, f y ^ 2) j := by
      funext i j
      simp only [hessLoc, hsecond y hyU i j, hfirst y hyU, hhh, huu, hv, hE, Fin.sum_univ_three]
      field_simp
      ring
    rw [hlmc F y, e1, e2, key ((G y)⁻¹) (hsym y hyU) (v (y, f y ^ 2)) (uu y) (hh (y, f y ^ 2)) _ hc,
      hΨ]
  
  have s13 : ∀ y, Ψ (y, 0) = levelMeanCurvCoord G f y := by
    intro y
    have e1 : v (y, 0) = fun k => partialDeriv k f y := by
      funext k; simp [hv]
    have e2 : hh (y, 0) = fun i j => hessLoc G f i j y := by
      funext i j; simp only [hhh, e1, hessLoc, zero_mul, add_zero]
    rw [hlmc f y, hΨ]
    simp only [e1, e2]
  
  have hcd : DifferentiableAt ℝ (fun y => 1 + 2 * f y * a y) y₁ :=
    (differentiableAt_const _).add ((hfd.const_mul 2).mul had)
  have hc1 : 1 + 2 * f y₁ * a y₁ ≠ 0 := by rw [hf0]; norm_num
  have hlift : ∀ g : E3 → ℝ, DifferentiableAt ℝ g y₁ →
      DifferentiableAt ℝ (fun x : E3 × ℝ => g x.1) (y₁, 0) :=
    fun g hg => hg.comp (y₁, 0) differentiableAt_fst
  have dc : DifferentiableAt ℝ (fun x : E3 × ℝ => 1 + 2 * f x.1 * a x.1) (y₁, 0) := hlift _ hcd
  have dP : ∀ i j, DifferentiableAt ℝ (fun x : E3 × ℝ => (G x.1)⁻¹ i j) (y₁, 0) :=
    fun i j => hlift _ (hPd i j)
  have hcd3 : DifferentiableAt ℝ (fun y => (1 + 2 * f y * a y) ^ 3) y₁ := hcd.pow 3
  have hcd2 : DifferentiableAt ℝ (fun y => (1 + 2 * f y * a y) ^ 2) y₁ := hcd.pow 2
  have dv : ∀ k, DifferentiableAt ℝ (fun x => v x k) (y₁, 0) := by
    intro k
    simp only [hv, div_eq_mul_inv]
    exact (hlift _ (hpf k)).add (differentiableAt_snd.mul ((hlift _ (hpa k)).mul (dc.inv hc1)))
  have dE : ∀ i j, DifferentiableAt ℝ (fun y => E y i j) y₁ := by
    intro i j
    simp only [hE, div_eq_mul_inv]
    exact (((((had.const_mul 2).mul (hfd.pow 2)).mul (hcd3.inv (pow_ne_zero 3 hc1))).sub
      ((hfd.const_mul 4).mul (hcd2.inv (pow_ne_zero 2 hc1)))).mul (hpa i)).mul (hpa j) |>.add
      ((hppa i j).mul (hcd.inv hc1))
  have dhh : ∀ i j, DifferentiableAt ℝ (fun x => hh x i j) (y₁, 0) := by
    intro i j
    simp only [hhh]
    exact ((hlift _ (hppf i j)).add (differentiableAt_snd.mul (hlift _ (dE i j)))).sub
      (DifferentiableAt.fun_sum fun k _ => (hlift _ (hΓd k i j)).mul (dv k))
  have hv0 : v (y₁, 0) = fun k => partialDeriv k f y₁ := by funext k; simp [hv]
  have hN : 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G (y₁, (0 : ℝ)).1)⁻¹ i j * v (y₁, 0) i * v (y₁, 0) j := by
    rw [hv0]; exact hpos
  have dN : DifferentiableAt ℝ (fun x : E3 × ℝ =>
      ∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * v x i * v x j) (y₁, 0) :=
    DifferentiableAt.fun_sum fun i _ => DifferentiableAt.fun_sum fun j _ =>
      ((dP i j).mul (dv i)).mul (dv j)
  have dS : DifferentiableAt ℝ (fun x : E3 × ℝ =>
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * v x i * v x j)) (y₁, 0) :=
    dN.sqrt hN.ne'
  have dS3 : DifferentiableAt ℝ (fun x : E3 × ℝ =>
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * v x i * v x j) ^ 3) (y₁, 0) :=
    dS.pow 3
  have hS0 : (fun x : E3 × ℝ =>
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * v x i * v x j)) (y₁, 0) ≠ 0 :=
    Real.sqrt_ne_zero'.mpr hN
  have hS3 : (fun x : E3 × ℝ =>
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * v x i * v x j) ^ 3) (y₁, 0) ≠ 0 :=
    pow_ne_zero 3 hS0
  have dL : DifferentiableAt ℝ (fun x : E3 × ℝ =>
      ∑ i : Fin 3, ∑ j : Fin 3, (G x.1)⁻¹ i j * hh x i j) (y₁, 0) :=
    DifferentiableAt.fun_sum fun i _ => DifferentiableAt.fun_sum fun j _ => (dP i j).mul (dhh i j)
  have dQ : DifferentiableAt ℝ (fun x : E3 × ℝ =>
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G x.1)⁻¹ i a * v x a * ((G x.1)⁻¹ j b * v x b) * hh x i j) (y₁, 0) :=
    DifferentiableAt.fun_sum fun i _ => DifferentiableAt.fun_sum fun j _ =>
      DifferentiableAt.fun_sum fun a _ => DifferentiableAt.fun_sum fun b _ =>
        (((dP i a).mul (dv a)).mul ((dP j b).mul (dv b))).mul (dhh i j)
  have dΨ : DifferentiableAt ℝ Ψ (y₁, 0) := by
    simp only [hΨ, hEx, div_eq_mul_inv]
    exact (dL.mul (dS.inv hS0)).sub (dQ.mul (dS3.inv hS3))
  
  have hc1pos : 0 < (fun y => 1 + 2 * f y * a y) y₁ := by
    show 0 < 1 + 2 * f y₁ * a y₁
    rw [hf0]; norm_num
  have hVn : ∀ᶠ y in 𝓝 y₁, y ∈ U ∧ 0 < 1 + 2 * f y * a y :=
    Filter.Eventually.and (hU.mem_nhds hy₁)
      (hcd.continuousAt.eventually (lt_mem_nhds hc1pos))
  have hA : levelMeanCurvCoord G F =ᶠ[𝓝 y₁] fun y => Ψ (y, f y ^ 2) := by
    filter_upwards [hVn] with y hy using s12 y hy.1 hy.2
  have hB : levelMeanCurvCoord G f =ᶠ[𝓝 y₁] fun y => Ψ (y, 0) :=
    Filter.Eventually.of_forall (fun y => (s13 y).symm)
  exact jet Ψ _ _ dΨ hA hB

theorem lmcCoord_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpd : ∀ y ∈ U, (G y).PosDef) (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (hdf : ∀ y ∈ U, fderiv ℝ f y ≠ 0) : ContDiffOn ℝ ∞ (levelMeanCurvCoord G f) U :=
by
  
  have hpdv : ∀ h : E3 → ℝ, ContDiffOn ℝ ∞ h U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i h) U := by
    intro h hh i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hh).2
    exact hD.clm_apply contDiffOn_const
  
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpd y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  
  have hSpos : ∀ y ∈ U, 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y := by
    intro y hy
    have hx0 : (fun k : Fin 3 => partialDeriv k f y) ≠ 0 := by
      intro h0
      apply hdf y hy
      have hlin : (fderiv ℝ f y : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
          have := congrFun h0 i
          simpa [partialDeriv] using this)
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := LinearMap.congr_fun hlin v
      simpa using this
    have hpos := (hGpd y hy).inv.dotProduct_mulVec_pos hx0
    refine lt_of_lt_of_eq hpos ?_
    simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hp : ∀ k : Fin 3, ContDiffOn ℝ ∞ (partialDeriv k f) U := hpdv f hf
  have hpp : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i (partialDeriv j f)) U :=
    fun i j => hpdv _ (hp j) i
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  have hH : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G f i j) U := by
    intro i j
    unfold hessLoc
    exact (hpp i j).sub (ContDiffOn.sum fun k _ => (hΓ k i j).mul (hp k))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G f) U := by
    unfold lapLoc
    exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hGi i j).mul (hH i j)
  have hS : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ((hGi i j).mul (hp i)).mul (hp j)
  have hN : ContDiffOn ℝ ∞ (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y)) U :=
    hS.sqrt (fun y hy => (hSpos y hy).ne')
  have hNne : ∀ y ∈ U, Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y) ≠ 0 :=
    fun y hy => Real.sqrt_ne_zero'.2 (hSpos y hy)
  have hN3 := hN.pow 3
  have hQ : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ i a * partialDeriv a f y * ((G y)⁻¹ j b * partialDeriv b f y) *
        hessLoc G f i j y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ContDiffOn.sum fun a _ =>
      ContDiffOn.sum fun b _ =>
        (((hGi i a).mul (hp a)).mul ((hGi j b).mul (hp b))).mul (hH i j)
  have hfin := (hLap.div hN hNne).sub (hQ.div hN3 (fun y hy => pow_ne_zero 3 (hNne y hy)))
  exact hfin.congr (fun y _ => rfl)

theorem lmcCoord_sign (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpd : ∀ y ∈ U, (G y).PosDef) (F : E3 → ℝ) (hF : ContDiffOn ℝ ∞ F U) (y₀ : E3) (hy₀ : y₀ ∈ U) (hF0 : F y₀ = 0) (hdF : fderiv ℝ F y₀ ≠ 0) (hH0 : ∀ y ∈ U, F y = 0 → levelMeanCurvCoord G F y = 0) (hjac : ∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j * partialDeriv i (levelMeanCurvCoord G F) y₀ * partialDeriv j F y₀ < 0) : ∃ r : ℝ, 0 < r ∧ Metric.ball y₀ r ⊆ U ∧ ∀ y ∈ Metric.ball y₀ r, (0 < F y → levelMeanCurvCoord G F y < 0) ∧ (F y < 0 → 0 < levelMeanCurvCoord G F y) :=
by
  have hn1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hn0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  have hdFc : ContinuousOn (fderiv ℝ F) U := hF.continuousOn_fderiv_of_isOpen hU hn1
  obtain ⟨U', hU'def⟩ : ∃ U' : Set E3, U' = U ∩ (fderiv ℝ F) ⁻¹' {0}ᶜ := ⟨_, rfl⟩
  have hU' : IsOpen U' := by
    rw [hU'def]; exact hdFc.isOpen_inter_preimage hU isOpen_compl_singleton
  have hU'U : U' ⊆ U := by rw [hU'def]; exact Set.inter_subset_left
  have hU'reg : ∀ y ∈ U', fderiv ℝ F y ≠ 0 := by
    intro y hy
    rw [hU'def] at hy
    exact hy.2
  have hy₀' : y₀ ∈ U' := by rw [hU'def]; exact ⟨hy₀, hdF⟩
  have hHs : ContDiffOn ℝ ∞ (levelMeanCurvCoord G F) U' :=
    lmcCoord_contDiffOn G U' hU' (fun i j => (hG i j).mono hU'U)
      (fun y hy => hGpd y (hU'U hy)) F (hF.mono hU'U) hU'reg
  
  obtain ⟨v, hFv, hHv⟩ : ∃ v : E3, 0 < fderiv ℝ F y₀ v ∧
      fderiv ℝ (levelMeanCurvCoord G F) y₀ v < 0 := by
    obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin 3) (Fin 3) ℝ, P = (G y₀)⁻¹ := ⟨_, rfl⟩
    have hPpd : P.PosDef := by rw [hP]; exact (hGpd y₀ hy₀).inv
    obtain ⟨ξ, hξ⟩ : ∃ ξ : Fin 3 → ℝ, ξ = fun j => fderiv ℝ F y₀ (e j) := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ : ∃ c : Fin 3 → ℝ, c = fun i => ∑ j : Fin 3, P i j * ξ j := ⟨_, rfl⟩
    have heval : ∀ L : E3 →L[ℝ] ℝ, L (∑ i : Fin 3, c i • e i) = ∑ i : Fin 3, c i * L (e i) := by
      intro L
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, smul_eq_mul]
    have hξne : ξ ≠ 0 := by
      intro h0
      apply hdF
      have h0' : ∀ j : Fin 3, fderiv ℝ F y₀ (EuclideanSpace.single j (1 : ℝ)) = 0 := by
        intro j
        have h := congrFun h0 j
        rw [hξ] at h
        exact h
      ext x
      have hx := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr x
      rw [← hx, map_sum]
      simp [EuclideanSpace.basisFun_apply, h0']
    refine ⟨∑ i : Fin 3, c i • e i, ?_, ?_⟩
    · rw [heval]
      have hpos := hPpd.dotProduct_mulVec_pos hξne
      have hq : star ξ ⬝ᵥ P.mulVec ξ = ∑ i : Fin 3, c i * fderiv ℝ F y₀ (e i) := by
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, hc, hξ]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
      linarith
    · rw [heval]
      have h2 : ∑ i : Fin 3, c i * fderiv ℝ (levelMeanCurvCoord G F) y₀ (e i) =
          ∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
            partialDeriv i (levelMeanCurvCoord G F) y₀ * partialDeriv j F y₀ := by
        rw [hc]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hP, hξ]
        simp only [partialDeriv]
        ring
      rw [h2]
      exact hjac
  
  have hdHc : ContinuousOn (fderiv ℝ (levelMeanCurvCoord G F)) U' :=
    hHs.continuousOn_fderiv_of_isOpen hU' hn1
  have hHvc : ContinuousAt (fun y => fderiv ℝ (levelMeanCurvCoord G F) y v) y₀ :=
    (hdHc.clm_apply continuousOn_const).continuousAt (hU'.mem_nhds hy₀')
  have hevU' : ∀ᶠ y in 𝓝 y₀, y ∈ U' := hU'.mem_nhds hy₀'
  have hevH : ∀ᶠ y in 𝓝 y₀, fderiv ℝ (levelMeanCurvCoord G F) y v < (fun _ => (0 : ℝ)) y :=
    hHvc.eventually_lt continuousAt_const hHv
  obtain ⟨ρ, hρ, hρB⟩ := Metric.eventually_nhds_iff_ball.1 (hevU'.and hevH)
  
  have hcross : ∀ (Φ : E3 → ℝ) (w : E3), ContDiffOn ℝ ∞ Φ U' → Φ y₀ = 0 →
      0 < fderiv ℝ Φ y₀ w → ∃ r : ℝ, 0 < r ∧ ∀ y ∈ Metric.ball y₀ r, 0 < Φ y →
        ∃ τ : ℝ, 0 < τ ∧ Φ (y - τ • w) = 0 ∧ y - τ • w ∈ Metric.ball y₀ ρ := by
    intro Φ w hΦ hΦ0 hΦw
    obtain ⟨a, ha⟩ : ∃ a : ℝ, a = fderiv ℝ Φ y₀ w := ⟨_, rfl⟩
    have ha0 : 0 < a := by rw [ha]; exact hΦw
    have hdΦc : ContinuousOn (fderiv ℝ Φ) U' := hΦ.continuousOn_fderiv_of_isOpen hU' hn1
    have hc1 : ContinuousAt (fun y => fderiv ℝ Φ y w) y₀ :=
      (hdΦc.clm_apply continuousOn_const).continuousAt (hU'.mem_nhds hy₀')
    have hc2 : ContinuousAt (fun y => ‖fderiv ℝ Φ y‖) y₀ :=
      (hdΦc.continuousAt (hU'.mem_nhds hy₀')).norm
    obtain ⟨L, hL⟩ : ∃ L : ℝ, L = ‖fderiv ℝ Φ y₀‖ + 1 := ⟨_, rfl⟩
    have hL0 : 0 < L := by rw [hL]; positivity
    have e2 : ∀ᶠ y in 𝓝 y₀, (fun _ => a / 2) y < fderiv ℝ Φ y w :=
      continuousAt_const.eventually_lt hc1 (by simp only; linarith)
    have e3 : ∀ᶠ y in 𝓝 y₀, ‖fderiv ℝ Φ y‖ < (fun _ => L) y :=
      hc2.eventually_lt continuousAt_const (by simp only; linarith)
    obtain ⟨ρ₁, hρ₁, hB1⟩ := Metric.eventually_nhds_iff_ball.1 (hevU'.and (e2.and e3))
    obtain ⟨ρ₂, hρ₂⟩ : ∃ ρ₂ : ℝ, ρ₂ = min ρ ρ₁ := ⟨_, rfl⟩
    have hρ₂pos : 0 < ρ₂ := by rw [hρ₂]; exact lt_min hρ hρ₁
    have hB2 : ∀ x ∈ Metric.ball y₀ ρ₂,
        x ∈ U' ∧ a / 2 < fderiv ℝ Φ x w ∧ ‖fderiv ℝ Φ x‖ < L := by
      intro x hx
      have h := hB1 x (Metric.ball_subset_ball (by rw [hρ₂]; exact min_le_right _ _) hx)
      exact ⟨h.1, h.2.1, h.2.2⟩
    have hB2ρ : Metric.ball y₀ ρ₂ ⊆ Metric.ball y₀ ρ :=
      Metric.ball_subset_ball (by rw [hρ₂]; exact min_le_left _ _)
    have hdiff : ∀ x ∈ Metric.ball y₀ ρ₂, DifferentiableAt ℝ Φ x := fun x hx =>
      (hΦ.contDiffAt (hU'.mem_nhds (hB2 x hx).1)).differentiableAt hn0
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 1 + L * ‖w‖ / (a / 2) := ⟨_, rfl⟩
    have hK1 : 1 ≤ K := by
      rw [hK]
      have : 0 ≤ L * ‖w‖ / (a / 2) := by positivity
      linarith
    have hK0 : 0 < K := by linarith
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = ρ₂ / (2 * K) := ⟨_, rfl⟩
    have hr0 : 0 < r := by rw [hr]; positivity
    obtain ⟨T, hT⟩ : ∃ T : ℝ, T = L * r / (a / 2) := ⟨_, rfl⟩
    have hT0 : 0 < T := by rw [hT]; positivity
    have hrK : r * K = ρ₂ / 2 := by
      rw [hr]; field_simp
    have hrT : r + T * ‖w‖ = ρ₂ / 2 := by
      rw [← hrK, hT, hK]; ring
    have hTc : T * (a / 2) = L * r := by
      rw [hT]; field_simp
    have hrρ₂ : r < ρ₂ := by
      have : r ≤ r * K := le_mul_of_one_le_right hr0.le hK1
      linarith
    refine ⟨r, hr0, fun y hy hΦy => ?_⟩
    have hyB : y ∈ Metric.ball y₀ ρ₂ := Metric.ball_subset_ball hrρ₂.le hy
    have hy0B : y₀ ∈ Metric.ball y₀ ρ₂ := Metric.mem_ball_self hρ₂pos
    have hlip := (convex_ball y₀ ρ₂).norm_image_sub_le_of_norm_fderiv_le hdiff
      (fun x hx => (hB2 x hx).2.2.le) hy0B hyB
    have hdist : ‖y - y₀‖ < r := by
      rw [← dist_eq_norm]; exact hy
    have hΦlt : Φ y < L * r := by
      rw [hΦ0, sub_zero, Real.norm_eq_abs] at hlip
      calc Φ y ≤ |Φ y| := le_abs_self _
        _ ≤ L * ‖y - y₀‖ := hlip
        _ < L * r := mul_lt_mul_of_pos_left hdist hL0
    have hseg : ∀ σ ∈ Set.Icc (0 : ℝ) T, y - σ • w ∈ Metric.ball y₀ ρ₂ := by
      intro σ hσ
      rw [Metric.mem_ball, dist_eq_norm]
      have h1 : y - σ • w - y₀ = (y - y₀) - σ • w := by abel
      rw [h1]
      have h2 : σ * ‖w‖ ≤ T * ‖w‖ := mul_le_mul_of_nonneg_right hσ.2 (norm_nonneg w)
      calc ‖(y - y₀) - σ • w‖ ≤ ‖y - y₀‖ + ‖σ • w‖ := norm_sub_le _ _
        _ = ‖y - y₀‖ + σ * ‖w‖ := by rw [norm_smul, Real.norm_of_nonneg hσ.1]
        _ < r + T * ‖w‖ := by linarith
        _ = ρ₂ / 2 := hrT
        _ < ρ₂ := half_lt_self hρ₂pos
    have hfd : ∀ x ∈ Metric.ball y₀ ρ₂,
        HasFDerivWithinAt Φ (fderiv ℝ Φ x) (Metric.ball y₀ ρ₂) x :=
      fun x hx => (hdiff x hx).hasFDerivAt.hasFDerivWithinAt
    have hTB : y - T • w ∈ Metric.ball y₀ ρ₂ := hseg T ⟨hT0.le, le_refl T⟩
    obtain ⟨ζ, hζ, hmvt⟩ := domain_mvt hfd (convex_ball y₀ ρ₂) hyB hTB
    have hζB : ζ ∈ Metric.ball y₀ ρ₂ := (convex_ball y₀ ρ₂).segment_subset hyB hTB hζ
    have hζw := (hB2 ζ hζB).2.1
    have hmvt' : Φ (y - T • w) - Φ y = -(T * fderiv ℝ Φ ζ w) := by
      rw [hmvt, sub_sub_cancel_left, map_neg, map_smul, smul_eq_mul]
    have hΦT : Φ (y - T • w) < 0 := by
      have h3 : T * (a / 2) < T * fderiv ℝ Φ ζ w := mul_lt_mul_of_pos_left hζw hT0
      linarith
    have hcont : ContinuousOn (fun σ : ℝ => Φ (y - σ • w)) (Set.Icc 0 T) := by
      have h4 : ContinuousOn (Φ ∘ fun σ : ℝ => y - σ • w) (Set.Icc 0 T) :=
        hΦ.continuousOn.comp
          (continuous_const.sub (continuous_id.smul continuous_const)).continuousOn
          (fun σ hσ => (hB2 _ (hseg σ hσ)).1)
      exact h4
    have h0mem : (0 : ℝ) ∈ Set.Icc ((fun σ : ℝ => Φ (y - σ • w)) T)
        ((fun σ : ℝ => Φ (y - σ • w)) 0) := by
      simp only [zero_smul, sub_zero]
      exact ⟨hΦT.le, hΦy.le⟩
    obtain ⟨τ, hτ, hτ0⟩ := intermediate_value_Icc' hT0.le hcont h0mem
    have hτ0' : Φ (y - τ • w) = 0 := hτ0
    have hτpos : 0 < τ := by
      rcases hτ.1.lt_or_eq with h | h
      · exact h
      · exfalso
        rw [← h, zero_smul, sub_zero] at hτ0'
        linarith
    exact ⟨τ, hτpos, hτ0', hB2ρ (hseg τ hτ)⟩
  
  obtain ⟨r₁, hr₁, hc₁⟩ := hcross F v (hF.mono hU'U) hF0 hFv
  have hFnv : 0 < fderiv ℝ (fun y => -F y) y₀ (-v) := by
    rw [show (fun y => -F y) = -F from rfl, fderiv_neg, ContinuousLinearMap.neg_apply,
      map_neg, neg_neg]
    exact hFv
  obtain ⟨r₂, hr₂, hc₂⟩ := hcross (fun y => -F y) (-v) (hF.neg.mono hU'U)
    (by simp [hF0]) hFnv
  have hHd : ∀ x ∈ Metric.ball y₀ ρ, HasFDerivWithinAt (levelMeanCurvCoord G F)
      (fderiv ℝ (levelMeanCurvCoord G F) x) (Metric.ball y₀ ρ) x := fun x hx =>
    ((hHs.contDiffAt (hU'.mem_nhds (hρB x hx).1)).differentiableAt hn0).hasFDerivAt.hasFDerivWithinAt
  refine ⟨min (min r₁ r₂) ρ, lt_min (lt_min hr₁ hr₂) hρ, ?_, ?_⟩
  · intro y hy
    exact hU'U (hρB y (Metric.ball_subset_ball (min_le_right _ _) hy)).1
  · intro y hy
    have hy1 : y ∈ Metric.ball y₀ r₁ :=
      Metric.ball_subset_ball ((min_le_left _ _).trans (min_le_left _ _)) hy
    have hy2 : y ∈ Metric.ball y₀ r₂ :=
      Metric.ball_subset_ball ((min_le_left _ _).trans (min_le_right _ _)) hy
    have hyρ : y ∈ Metric.ball y₀ ρ := Metric.ball_subset_ball (min_le_right _ _) hy
    constructor
    · intro hFy
      obtain ⟨τ, hτ, hz0, hzB⟩ := hc₁ y hy1 hFy
      have hHz : levelMeanCurvCoord G F (y - τ • v) = 0 := hH0 _ (hU'U (hρB _ hzB).1) hz0
      obtain ⟨ζ, hζ, hmvt⟩ := domain_mvt hHd (convex_ball y₀ ρ) hzB hyρ
      have hζB : ζ ∈ Metric.ball y₀ ρ := (convex_ball y₀ ρ).segment_subset hzB hyρ hζ
      have hneg : fderiv ℝ (levelMeanCurvCoord G F) ζ v < 0 := (hρB ζ hζB).2
      rw [hHz, sub_zero, sub_sub_cancel, map_smul, smul_eq_mul] at hmvt
      rw [hmvt]
      exact mul_neg_of_pos_of_neg hτ hneg
    · intro hFy
      have hFy' : 0 < (fun y => -F y) y := neg_pos.mpr hFy
      obtain ⟨τ, hτ, hz0, hzB⟩ := hc₂ y hy2 hFy'
      have hz0' : -F (y - τ • -v) = 0 := hz0
      have hHz : levelMeanCurvCoord G F (y - τ • -v) = 0 :=
        hH0 _ (hU'U (hρB _ hzB).1) (neg_eq_zero.mp hz0')
      obtain ⟨ζ, hζ, hmvt⟩ := domain_mvt hHd (convex_ball y₀ ρ) hzB hyρ
      have hζB : ζ ∈ Metric.ball y₀ ρ := (convex_ball y₀ ρ).segment_subset hzB hyρ hζ
      have hneg : fderiv ℝ (levelMeanCurvCoord G F) ζ v < 0 := (hρB ζ hζB).2
      rw [hHz, sub_zero, sub_sub_cancel, map_smul, map_neg, smul_eq_mul] at hmvt
      rw [hmvt]
      exact mul_pos hτ (neg_pos.mpr hneg)

theorem ginv_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpd : ∀ y ∈ U, (G y).PosDef) : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U :=
by
  have hdet : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have h1 : ContDiffOn ℝ ∞ (fun y => ∑ σ : Equiv.Perm (Fin 3),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ k, H y (σ k) k) U :=
      ContDiffOn.sum fun σ _ => contDiffOn_const.mul (contDiffOn_prod fun k _ => hH (σ k) k)
    refine h1.congr ?_
    intro y _
    exact Matrix.det_apply' (H y)
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) U := by
    intro i j
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow j (Pi.single i 1)).det) U := by
      apply hdet (fun y => (G y).updateRow j (Pi.single i 1))
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine h2.congr ?_
    intro y _
    exact Matrix.adjugate_apply (G y) i j
  have hne : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpd y hy).det_pos.ne'
  intro i j
  have h3 : ContDiffOn ℝ ∞ (fun y => ((G y).det)⁻¹ * (G y).adjugate i j) U :=
    ((hdet G hG).inv hne).mul (hadj i j)
  refine h3.congr ?_
  intro y _
  rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]

theorem lmcCoord_sq (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F W : E3 → ℝ) (y : E3) (hF : ContDiffAt ℝ 2 F y) (hW : W =ᶠ[𝓝 y] fun z => F z ^ 2) (hF0 : F y ≠ 0) : levelMeanCurvCoord G W y = (if 0 < F y then 1 else -1) * levelMeanCurvCoord G F y :=
by
  have hFy : DifferentiableAt ℝ F y := hF.differentiableAt (by norm_num)
  have hev : ∀ᶠ z in 𝓝 y, ContDiffAt ℝ 2 F z := hF.eventually (by decide)
  have hWW := hW.eventuallyEq_nhds
  have key : ∀ᶠ z in 𝓝 y, ∀ j : Fin 3,
      partialDeriv j W z = 2 * F z * partialDeriv j F z := by
    filter_upwards [hev, hWW] with z hz hWz
    intro j
    have hdz : DifferentiableAt ℝ F z := hz.differentiableAt (by norm_num)
    have h : HasFDerivAt (fun x => F x * F x) (F z • fderiv ℝ F z + F z • fderiv ℝ F z) z :=
      hdz.hasFDerivAt.mul hdz.hasFDerivAt
    have hfun : (fun x => F x ^ 2) = fun x => F x * F x := by
      funext x; ring
    unfold partialDeriv
    rw [hWz.fderiv_eq, hfun, h.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have h1 : ∀ j : Fin 3, partialDeriv j W y = 2 * F y * partialDeriv j F y :=
    key.self_of_nhds
  have hg : DifferentiableAt ℝ (fderiv ℝ F) y :=
    (hF.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have h2 : ∀ i j : Fin 3, partialDeriv i (partialDeriv j W) y =
      2 * (partialDeriv i F y * partialDeriv j F y + F y * partialDeriv i (partialDeriv j F) y) := by
    intro i j
    have hgj : DifferentiableAt ℝ (partialDeriv j F) y := by
      unfold partialDeriv
      exact hg.clm_apply (differentiableAt_const _)
    have hEq : partialDeriv j W =ᶠ[𝓝 y] fun z => 2 * F z * partialDeriv j F z :=
      key.mono fun z hz => hz j
    have hd : HasFDerivAt (fun z => 2 * F z * partialDeriv j F z)
        ((2 * F y) • fderiv ℝ (partialDeriv j F) y + partialDeriv j F y • (2 : ℝ) • fderiv ℝ F y) y :=
      (hFy.hasFDerivAt.const_mul 2).mul hgj.hasFDerivAt
    show fderiv ℝ (partialDeriv j W) y (e i) = _
    rw [hEq.fderiv_eq, hd.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    unfold partialDeriv
    ring
  have hH : ∀ i j : Fin 3, hessLoc G W i j y =
      2 * partialDeriv i F y * partialDeriv j F y + 2 * F y * hessLoc G F i j y := by
    intro i j
    simp only [hessLoc, h2 i j, h1]
    simp only [Fin.sum_univ_three]
    ring
  have e1 : (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i W y * partialDeriv j W y) =
      4 * F y ^ 2 *
        (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i F y * partialDeriv j F y) := by
    simp only [h1]
    simp only [Fin.sum_univ_three]
    ring
  have e2 : lapLoc G W y =
      2 * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i F y * partialDeriv j F y) +
        2 * F y * lapLoc G F y := by
    simp only [lapLoc, hH]
    simp only [Fin.sum_univ_three]
    ring
  have e3 : (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ i a * partialDeriv a W y * ((G y)⁻¹ j b * partialDeriv b W y) * hessLoc G W i j y) =
      8 * F y ^ 2 *
        (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i F y * partialDeriv j F y) ^ 2 +
      8 * F y ^ 3 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ i a * partialDeriv a F y * ((G y)⁻¹ j b * partialDeriv b F y) *
          hessLoc G F i j y) := by
    simp only [h1, hH]
    simp only [Fin.sum_univ_three]
    ring
  have scalar : ∀ c s L Q : ℝ, c ≠ 0 →
      (2 * s + 2 * c * L) / Real.sqrt (4 * c ^ 2 * s) -
        (8 * c ^ 2 * s ^ 2 + 8 * c ^ 3 * Q) / Real.sqrt (4 * c ^ 2 * s) ^ 3 =
      (if 0 < c then 1 else -1) * (L / Real.sqrt s - Q / Real.sqrt s ^ 3) := by
    intro c s L Q hc0
    have hsq : Real.sqrt (4 * c ^ 2 * s) = 2 * |c| * Real.sqrt s := by
      rw [Real.sqrt_mul (by positivity), show (4 : ℝ) * c ^ 2 = (2 * c) ^ 2 by ring,
        Real.sqrt_sq_eq_abs, abs_mul, abs_two]
    rw [hsq]
    rcases le_or_gt s 0 with hs | hs
    · rw [Real.sqrt_eq_zero'.2 hs]
      simp
    · obtain ⟨r, hr, rfl⟩ : ∃ r, 0 < r ∧ s = r ^ 2 :=
        ⟨Real.sqrt s, Real.sqrt_pos.2 hs, (Real.sq_sqrt hs.le).symm⟩
      rw [Real.sqrt_sq hr.le]
      have hr0 : r ≠ 0 := hr.ne'
      rcases lt_or_gt_of_ne hc0 with hc | hc
      · rw [if_neg (not_lt.2 hc.le), abs_of_neg hc]
        field_simp
        ring
      · rw [if_pos hc, abs_of_pos hc]
        field_simp
        ring
  rw [levelMeanCurvCoord, levelMeanCurvCoord, e2, e3, e1]
  exact scalar _ _ _ _ hF0

theorem collar_coord_model (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGpd : ∀ y ∈ U, (G y).PosDef)
    (f Q W : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (hQ : ContDiffOn ℝ ∞ Q U) (y₀ : E3)
    (hy₀ : y₀ ∈ U) (hf0 : f y₀ = 0) (hdf : fderiv ℝ f y₀ ≠ 0)
    (hW : ∀ y ∈ U, W y = f y ^ 2 * Q y) (hQ1 : ∀ y ∈ U, f y = 0 → Q y = 1)
    (hH0 : ∀ y ∈ U, f y = 0 → levelMeanCurvCoord G f y = 0)
    (hjac : ∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
      partialDeriv i (levelMeanCurvCoord G f) y₀ * partialDeriv j f y₀ < 0) :
    ∃ r : ℝ, 0 < r ∧ ∃ C : ℝ, Metric.closedBall y₀ r ⊆ U ∧
      ∀ y ∈ Metric.closedBall y₀ r, f y ≠ 0 →
        fderiv ℝ W y ≠ 0 ∧ levelMeanCurvCoord G W y < 0 ∧ |levelMeanCurvCoord G W y| ≤ C ∧
        ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i W y * partialDeriv j W y ≤ C :=
by
  have hn1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hn2 : (2 : WithTop ℕ∞) ≤ ∞ := by norm_cast
  have hn0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  obtain ⟨r₁, hr₁, c, hB1U, hc, hQc⟩ := coord_division U hU f (fun y => Q y - 1) hf
    (hQ.sub contDiffOn_const) y₀ hy₀ hf0 hdf
    (fun y hy hfy => by simp only [hQ1 y hy hfy, sub_self])
  
  have hfB1 : ContDiffOn ℝ ∞ f (Metric.ball y₀ r₁) := hf.mono hB1U
  have hca : ContinuousAt (fun y => 1 + f y * c y) y₀ :=
    (continuousOn_const.add (hfB1.continuousOn.mul hc.continuousOn)).continuousAt
      (Metric.ball_mem_nhds y₀ hr₁)
  have hdfc : ContinuousOn (fderiv ℝ f) U := hf.continuousOn_fderiv_of_isOpen hU hn1
  have hev1 : ∀ᶠ y in 𝓝 y₀, y ∈ Metric.ball y₀ r₁ := Metric.ball_mem_nhds y₀ hr₁
  have hev2 : ∀ᶠ y in 𝓝 y₀, 0 < 1 + f y * c y :=
    Filter.Tendsto.eventually hca (lt_mem_nhds (show (0 : ℝ) < 1 + f y₀ * c y₀ by simp [hf0]))
  have hev3 : ∀ᶠ y in 𝓝 y₀, fderiv ℝ f y ≠ 0 :=
    (hdfc.continuousAt (hU.mem_nhds hy₀)).eventually_ne hdf
  obtain ⟨r₂, hr₂, hB2⟩ := Metric.eventually_nhds_iff_ball.1 (hev1.and (hev2.and hev3))
  have hB2U : Metric.ball y₀ r₂ ⊆ U := fun y hy => hB1U (hB2 y hy).1
  have hpos2 : ∀ y ∈ Metric.ball y₀ r₂, 0 < 1 + f y * c y := fun y hy => (hB2 y hy).2.1
  have hdf2 : ∀ y ∈ Metric.ball y₀ r₂, fderiv ℝ f y ≠ 0 := fun y hy => (hB2 y hy).2.2
  have hQ2 : ∀ y ∈ Metric.ball y₀ r₂, Q y = 1 + f y * c y := by
    intro y hy
    have h : Q y - 1 = f y * c y := hQc y (hB2 y hy).1
    linarith
  have hf2 : ContDiffOn ℝ ∞ f (Metric.ball y₀ r₂) := hf.mono hB2U
  have hc2 : ContDiffOn ℝ ∞ c (Metric.ball y₀ r₂) := hc.mono (fun y hy => (hB2 y hy).1)
  
  obtain ⟨s, hsdef⟩ : ∃ s : E3 → ℝ, s = fun y => Real.sqrt (1 + f y * c y) := ⟨_, rfl⟩
  obtain ⟨a, hadef⟩ : ∃ a : E3 → ℝ, a = fun y => c y / (1 + s y) := ⟨_, rfl⟩
  obtain ⟨F, hFdef⟩ : ∃ F : E3 → ℝ, F = fun y => f y + f y ^ 2 * a y := ⟨_, rfl⟩
  have hs2 : ContDiffOn ℝ ∞ s (Metric.ball y₀ r₂) := by
    rw [hsdef]
    exact (contDiffOn_const.add (hf2.mul hc2)).sqrt (fun y hy => (hpos2 y hy).ne')
  have hspos : ∀ y ∈ Metric.ball y₀ r₂, 0 < s y := by
    intro y hy
    simp only [hsdef]
    exact Real.sqrt_pos.2 (hpos2 y hy)
  have hssq : ∀ y ∈ Metric.ball y₀ r₂, s y ^ 2 = 1 + f y * c y := by
    intro y hy
    simp only [hsdef]
    exact Real.sq_sqrt (hpos2 y hy).le
  have h1s : ∀ y ∈ Metric.ball y₀ r₂, 1 + s y ≠ 0 := by
    intro y hy
    have := hspos y hy
    exact (by linarith : (0 : ℝ) < 1 + s y).ne'
  have ha2 : ContDiffOn ℝ ∞ a (Metric.ball y₀ r₂) := by
    rw [hadef]
    exact hc2.div (contDiffOn_const.add hs2) h1s
  have hFs : ContDiffOn ℝ ∞ F (Metric.ball y₀ r₂) := by
    rw [hFdef]
    exact hf2.add ((hf2.pow 2).mul ha2)
  have hFfs : ∀ y ∈ Metric.ball y₀ r₂, F y = f y * s y := by
    intro y hy
    have h2 : f y ^ 2 * a y = f y * (s y - 1) := by
      simp only [hadef]
      rw [mul_div_assoc', div_eq_iff (h1s y hy)]
      linear_combination (-(f y)) * hssq y hy
    simp only [hFdef]
    rw [h2]
    ring
  have hWF : ∀ y ∈ Metric.ball y₀ r₂, W y = F y ^ 2 := by
    intro y hy
    rw [hW y (hB2U hy), hFfs y hy, hQ2 y hy, mul_pow, hssq y hy]
  have hFzero : ∀ y ∈ Metric.ball y₀ r₂, F y = 0 ↔ f y = 0 := by
    intro y hy
    rw [hFfs y hy, mul_eq_zero]
    constructor
    · rintro (h | h)
      · exact h
      · exact absurd h (hspos y hy).ne'
    · intro h
      exact Or.inl h
  
  have hy₀2 : y₀ ∈ Metric.ball y₀ r₂ := Metric.mem_ball_self hr₂
  have hfd : HasFDerivAt f (fderiv ℝ f y₀) y₀ :=
    ((hf2.contDiffAt (Metric.isOpen_ball.mem_nhds hy₀2)).differentiableAt hn0).hasFDerivAt
  have had : HasFDerivAt a (fderiv ℝ a y₀) y₀ :=
    ((ha2.contDiffAt (Metric.isOpen_ball.mem_nhds hy₀2)).differentiableAt hn0).hasFDerivAt
  have hFd : HasFDerivAt F (fderiv ℝ f y₀) y₀ := by
    have h := hfd.add ((hfd.pow 2).mul had)
    rw [hFdef]
    convert h using 1
    simp [hf0]
  have hFdy : fderiv ℝ F y₀ = fderiv ℝ f y₀ := hFd.fderiv
  have hpF : ∀ j : Fin 3, partialDeriv j F y₀ = partialDeriv j f y₀ := by
    intro j
    simp only [partialDeriv, hFdy]
  have hF0 : F y₀ = 0 := (hFzero y₀ hy₀2).2 hf0
  have hdF0 : fderiv ℝ F y₀ ≠ 0 := by
    rw [hFdy]
    exact hdf
  
  have hdFc : ContinuousOn (fderiv ℝ F) (Metric.ball y₀ r₂) :=
    hFs.continuousOn_fderiv_of_isOpen Metric.isOpen_ball hn1
  have hev4 : ∀ᶠ y in 𝓝 y₀, y ∈ Metric.ball y₀ r₂ := Metric.ball_mem_nhds y₀ hr₂
  have hev5 : ∀ᶠ y in 𝓝 y₀, fderiv ℝ F y ≠ 0 :=
    (hdFc.continuousAt (Metric.ball_mem_nhds y₀ hr₂)).eventually_ne hdF0
  obtain ⟨r₃, hr₃, hB3⟩ := Metric.eventually_nhds_iff_ball.1 (hev4.and hev5)
  have hB32 : Metric.ball y₀ r₃ ⊆ Metric.ball y₀ r₂ := fun y hy => (hB3 y hy).1
  have hB3U : Metric.ball y₀ r₃ ⊆ U := hB32.trans hB2U
  have hy₀3 : y₀ ∈ Metric.ball y₀ r₃ := Metric.mem_ball_self hr₃
  have hG3 : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball y₀ r₃) :=
    fun i j => (hG i j).mono hB3U
  have hGpd3 : ∀ y ∈ Metric.ball y₀ r₃, (G y).PosDef := fun y hy => hGpd y (hB3U hy)
  
  have hinv : ∀ y₁ ∈ Metric.ball y₀ r₃, f y₁ = 0 →
      levelMeanCurvCoord G F y₁ = levelMeanCurvCoord G f y₁ ∧
      ∀ i : Fin 3, partialDeriv i (levelMeanCurvCoord G F) y₁ =
        partialDeriv i (levelMeanCurvCoord G f) y₁ :=
    fun y₁ hy₁ hfy₁ => jacobiCoord_invariance G (Metric.ball y₀ r₃) Metric.isOpen_ball hG3 hGpd3
      f a F (hf.mono hB3U) (ha2.mono hB32) (fun y _ => by simp only [hFdef]) y₁ hy₁ hfy₁
      (hdf2 y₁ (hB32 hy₁))
  
  have hjacF : ∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
      partialDeriv i (levelMeanCurvCoord G F) y₀ * partialDeriv j F y₀ < 0 := by
    have e : ∀ i j : Fin 3, (G y₀)⁻¹ i j * partialDeriv i (levelMeanCurvCoord G F) y₀ *
        partialDeriv j F y₀ = (G y₀)⁻¹ i j * partialDeriv i (levelMeanCurvCoord G f) y₀ *
        partialDeriv j f y₀ := by
      intro i j
      rw [(hinv y₀ hy₀3 hf0).2 i, hpF j]
    simp only [e]
    exact hjac
  
  obtain ⟨r₄, hr₄, hB43, hsign⟩ := lmcCoord_sign G (Metric.ball y₀ r₃) Metric.isOpen_ball hG3
    hGpd3 F (hFs.mono hB32) y₀ hy₀3 hF0 hdF0
    (fun y hy hFy => by
      have hfy : f y = 0 := (hFzero y (hB32 hy)).1 hFy
      rw [(hinv y hy hfy).1]
      exact hH0 y (hB3U hy) hfy)
    hjacF
  
  have hHc : ContDiffOn ℝ ∞ (levelMeanCurvCoord G F) (Metric.ball y₀ r₃) :=
    lmcCoord_contDiffOn G (Metric.ball y₀ r₃) Metric.isOpen_ball hG3 hGpd3 F (hFs.mono hB32)
      (fun y hy => (hB3 y hy).2)
  have hr : 0 < r₄ / 2 := half_pos hr₄
  have hcb4 : Metric.closedBall y₀ (r₄ / 2) ⊆ Metric.ball y₀ r₄ :=
    Metric.closedBall_subset_ball (half_lt_self hr₄)
  have hcb3 : Metric.closedBall y₀ (r₄ / 2) ⊆ Metric.ball y₀ r₃ := hcb4.trans hB43
  obtain ⟨CH, hCH⟩ := (isCompact_closedBall y₀ (r₄ / 2)).exists_bound_of_continuousOn
    (hHc.continuousOn.mono hcb3)
  have hWs : ContDiffOn ℝ ∞ W U := ((hf.pow 2).mul hQ).congr hW
  have hdWc : ContinuousOn (fderiv ℝ W) U := hWs.continuousOn_fderiv_of_isOpen hU hn1
  have hpW : ∀ i : Fin 3, ContinuousOn (partialDeriv i W) U := fun i =>
    hdWc.clm_apply continuousOn_const
  have hP := ginv_contDiffOn G U hG hGpd
  have hΓ : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i W y * partialDeriv j W y) U := by
    apply continuousOn_finset_sum
    intro i _
    apply continuousOn_finset_sum
    intro j _
    exact (((hP i j).continuousOn).mul (hpW i)).mul (hpW j)
  obtain ⟨CG, hCG⟩ := (isCompact_closedBall y₀ (r₄ / 2)).exists_bound_of_continuousOn
    (hΓ.mono (hcb3.trans hB3U))
  
  refine ⟨r₄ / 2, hr, max CH CG, hcb3.trans hB3U, fun y hy hfy => ?_⟩
  have hy4 : y ∈ Metric.ball y₀ r₄ := hcb4 hy
  have hy3 : y ∈ Metric.ball y₀ r₃ := hB43 hy4
  have hy2 : y ∈ Metric.ball y₀ r₂ := hB32 hy3
  have hFy : F y ≠ 0 := fun h => hfy ((hFzero y hy2).1 h)
  have hWev : W =ᶠ[𝓝 y] fun z => F z ^ 2 :=
    Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hy2) (fun z hz => hWF z hz)
  have hF2 : ContDiffAt ℝ 2 F y := (hFs.contDiffAt (Metric.isOpen_ball.mem_nhds hy2)).of_le hn2
  have hsq := lmcCoord_sq G F W y hF2 hWev hFy
  obtain ⟨hpos, hneg⟩ := hsign y hy4
  have hHW : levelMeanCurvCoord G W y < 0 := by
    rw [hsq]
    rcases lt_or_gt_of_ne hFy with h | h
    · rw [if_neg (not_lt.2 h.le)]
      have := hneg h
      linarith
    · rw [if_pos h]
      have := hpos h
      linarith
  have habs : |levelMeanCurvCoord G W y| = |levelMeanCurvCoord G F y| := by
    rw [hsq, abs_mul]
    split_ifs <;> simp
  refine ⟨?_, hHW, ?_, ?_⟩
  · intro h0
    have h00 : levelMeanCurvCoord G W y = 0 := by
      simp [levelMeanCurvCoord, partialDeriv, h0]
    linarith
  · rw [habs]
    have h := hCH y hy
    rw [Real.norm_eq_abs] at h
    exact h.trans (le_max_left _ _)
  · have h := hCG y hy
    rw [Real.norm_eq_abs] at h
    exact (le_abs_self _).trans (h.trans (le_max_right _ _))

theorem unstable_collar_function [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig O' : Set M) (hSc : IsCompact Sig) (hSm : IsMinimalSurfaceSet g Sig) (hO' : IsOpen O')
    (hSO' : Sig ⊆ O') (φ lam : M → ℝ)
    (hlam : ∀ p ∈ Sig, ∃ U ∈ 𝓝 p, ∀ q ∈ U, q ∈ Sig → lam q = lam p)
    (hdata : ∀ p ∈ Sig, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ Sig = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ Sig, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧ g.jacobiDeriv f x = lam x / φ x)
    (p₀ : M) (hp₀ : p₀ ∈ Sig) (hneg : lam p₀ < 0) :
    ∃ (O : Set M) (w : M → ℝ) (t₀ : ℝ), IsOpen O ∧ O ⊆ O' ∧ p₀ ∈ O ∧ 0 < t₀ ∧
      IsCompact {x | x ∈ O ∧ w x ≤ t₀} ∧ ContinuousOn w O ∧
      (∀ x ∈ O, x ∈ Sig → w x = 0) ∧ (∀ x ∈ O, x ∉ Sig → 0 < w x) ∧
      ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig) ∧
      (∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) ∧
      (∀ x ∈ O \ Sig, g.levelMeanCurv w x < 0) ∧
      ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C :=
by
  classical
  
  have hcd : ∀ (p : M) (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    fun p u hu => contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  
  
  
  set A : Set M := {x | ∃ p ∈ Sig, lam p ≠ lam p₀ ∧ ∃ U ∈ 𝓝 p,
      (∀ q ∈ U, q ∈ Sig → lam q = lam p) ∧ x ∈ interior U} with hAdef
  set B : Set M := {x | ∃ p ∈ Sig, lam p = lam p₀ ∧ ∃ U ∈ 𝓝 p,
      (∀ q ∈ U, q ∈ Sig → lam q = lam p) ∧ x ∈ interior U} with hBdef
  have hAo : IsOpen A := by
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨p, hp, hlp, U, hU, hUl, hxU⟩
    exact ⟨interior U, fun y hy => ⟨p, hp, hlp, U, hU, hUl, hy⟩, isOpen_interior, hxU⟩
  have hBo : IsOpen B := by
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨p, hp, hlp, U, hU, hUl, hxU⟩
    exact ⟨interior U, fun y hy => ⟨p, hp, hlp, U, hU, hUl, hy⟩, isOpen_interior, hxU⟩
  set S0 : Set M := Sig \ A with hS0def
  have hS0c : IsCompact S0 := hSc.diff hAo
  have hS0Sig : S0 ⊆ Sig := Set.diff_subset
  have hS0lam : ∀ x ∈ S0, lam x = lam p₀ := by
    intro x hx
    by_contra hne
    obtain ⟨U, hU, hUl⟩ := hlam x hx.1
    exact hx.2 ⟨x, hx.1, hne, U, hU, hUl, mem_interior_iff_mem_nhds.2 hU⟩
  have hS0B : S0 ⊆ B := by
    intro x hx
    obtain ⟨U, hU, hUl⟩ := hlam x hx.1
    exact ⟨x, hx.1, hS0lam x hx, U, hU, hUl, mem_interior_iff_mem_nhds.2 hU⟩
  have hp₀S0 : p₀ ∈ S0 := by
    refine ⟨hp₀, ?_⟩
    rintro ⟨p, hp, hlp, U, hU, hUl, hxU⟩
    exact hlp (hUl p₀ (interior_subset hxU) hp₀).symm
  set U₀ : Set M := O' ∩ B with hU₀def
  have hU₀o : IsOpen U₀ := hO'.inter hBo
  have hS0U₀ : S0 ⊆ U₀ := fun x hx => ⟨hSO' hx.1, hS0B hx⟩
  have hU₀Sig : ∀ x ∈ U₀, x ∈ Sig → x ∈ S0 := by
    rintro x ⟨-, p, hp, hlp, U, hU, hUl, hxU⟩ hxS
    have hlx : lam x = lam p₀ := (hUl x (interior_subset hxU) hxS).trans hlp
    refine ⟨hxS, ?_⟩
    rintro ⟨p', hp', hlp', U', hU', hUl', hxU'⟩
    exact hlp' ((hUl' x (interior_subset hxU') hxS).symm.trans hlx)
  
  
  
  have hdat' : ∀ p : M, ∃ (V : Set M) (f : M → ℝ), p ∈ Sig → (IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ Sig = V ∩ f ⁻¹' {0} ∧
      ∀ x ∈ V ∩ Sig, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
        g.jacobiDeriv f x = lam x / φ x) := by
    intro p
    by_cases hp : p ∈ Sig
    · obtain ⟨-, V, f, h⟩ := hdata p hp
      exact ⟨V, f, fun _ => h⟩
    · exact ⟨Set.univ, 0, fun h => absurd h hp⟩
  choose Vf ff hVf using hdat'
  have hVo : ∀ p ∈ Sig, IsOpen (Vf p) := fun p hp => (hVf p hp).1
  have hpV : ∀ p ∈ Sig, p ∈ Vf p := fun p hp => (hVf p hp).2.1
  have hfs : ∀ p ∈ Sig, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ff p) := fun p hp => (hVf p hp).2.2.1
  have hdf : ∀ p ∈ Sig, ∀ x ∈ Vf p, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (ff p) x ≠ 0 :=
    fun p hp => (hVf p hp).2.2.2.1
  have hVS : ∀ p ∈ Sig, Vf p ∩ Sig = Vf p ∩ ff p ⁻¹' {0} := fun p hp => (hVf p hp).2.2.2.2.1
  have hgr : ∀ p ∈ Sig, ∀ x ∈ Vf p ∩ Sig, Real.sqrt (g.gradInner (ff p) (ff p) x) * φ x = 1 :=
    fun p hp x hx => ((hVf p hp).2.2.2.2.2 x hx).1
  have hjd : ∀ p ∈ Sig, ∀ x ∈ Vf p ∩ Sig, g.jacobiDeriv (ff p) x = lam x / φ x :=
    fun p hp x hx => ((hVf p hp).2.2.2.2.2 x hx).2
  have hZiff : ∀ p ∈ Sig, ∀ x ∈ Vf p, (x ∈ Sig ↔ ff p x = 0) := by
    intro p hp x hx
    have h := Set.ext_iff.1 (hVS p hp) x
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff] at h
    constructor
    · intro hxS; exact (h.1 ⟨hx, hxS⟩).2
    · intro hf; exact (h.2 ⟨hx, hf⟩).2
  
  have hb : ∀ p ∈ S0, ∃ ψ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ ∧
      (∀ x, 0 ≤ ψ x) ∧ tsupport ψ ⊆ Vf p ∩ U₀ ∧ ∀ᶠ x in 𝓝 p, ψ x = 1 := by
    intro p hp
    obtain ⟨b, -, hbs⟩ := (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) p).mem_iff.1
      (((hVo p (hS0Sig hp)).inter hU₀o).mem_nhds ⟨hpV p (hS0Sig hp), hS0U₀ hp⟩)
    exact ⟨b, b.contMDiff, fun x => b.nonneg, hbs, b.eventuallyEq_one⟩
  choose! ψ hψs hψnn hψsupp hψ1 using hb
  obtain ⟨t, htS0, hcov⟩ := hS0c.elim_nhds_subcover (fun p => {x | 0 < ψ p x})
    (fun p hp => Filter.mem_of_superset (hψ1 p hp) (fun x hx => by
      simp only [Set.mem_setOf_eq] at hx ⊢
      rw [hx]; norm_num))
  have htSig : ∀ i ∈ t, i ∈ Sig := fun i hi => hS0Sig (htS0 i hi)
  
  set Ssum : M → ℝ := fun x => ∑ i ∈ t, ψ i x with hSdef
  have hSs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ Ssum :=
    contMDiff_finset_sum (fun i hi => hψs i (htS0 i hi))
  have hSpos : ∀ x ∈ S0, 0 < Ssum x := by
    intro x hx
    have h := hcov hx
    simp only [Set.mem_iUnion, Set.mem_setOf_eq] at h
    obtain ⟨i, hi, hxi⟩ := h
    exact Finset.sum_pos' (fun j hj => hψnn j (htS0 j hj) x) ⟨i, hi, hxi⟩
  obtain ⟨xm, hxm, hmin⟩ := hS0c.exists_isMinOn ⟨p₀, hp₀S0⟩ hSs.continuous.continuousOn
  obtain ⟨s₀, hs₀def⟩ : ∃ s₀ : ℝ, s₀ = Ssum xm / 2 := ⟨_, rfl⟩
  have hs₀ : 0 < s₀ := by have := hSpos xm hxm; rw [hs₀def]; linarith
  have hSge : ∀ x ∈ S0, 2 * s₀ ≤ Ssum x := by
    intro x hx
    have := isMinOn_iff.1 hmin x hx
    rw [hs₀def]; linarith
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ → ℝ,
      R = fun s => s₀ / 2 + (s - s₀ / 2) * Real.smoothTransition (2 * s / s₀ - 1) := ⟨_, rfl⟩
  have hRs : ContDiff ℝ ∞ R := by
    have h1 : ContDiff ℝ ∞ (fun s : ℝ => 2 * s / s₀ - 1) := by fun_prop
    have h2 : ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition (2 * s / s₀ - 1)) :=
      Real.smoothTransition.contDiff.comp h1
    have h3 : ContDiff ℝ ∞ (fun s : ℝ => s - s₀ / 2) := by fun_prop
    rw [hRdef]
    exact contDiff_const.add (h3.mul h2)
  have hRpos : ∀ s, s₀ / 2 ≤ R s := by
    intro s
    rw [hRdef]
    by_cases hs : s ≤ s₀ / 2
    · have h0 : Real.smoothTransition (2 * s / s₀ - 1) = 0 :=
        Real.smoothTransition.zero_of_nonpos (by
          rw [sub_nonpos, div_le_one hs₀]; linarith)
      simp only [h0, mul_zero, add_zero, le_refl]
    · push_neg at hs
      have := Real.smoothTransition.nonneg (2 * s / s₀ - 1)
      have h2 : 0 ≤ (s - s₀ / 2) * Real.smoothTransition (2 * s / s₀ - 1) :=
        mul_nonneg (by linarith) this
      show s₀ / 2 ≤ s₀ / 2 + (s - s₀ / 2) * Real.smoothTransition (2 * s / s₀ - 1)
      linarith
  have hReq : ∀ s, s₀ ≤ s → R s = s := by
    intro s hs
    rw [hRdef]
    have h1 : Real.smoothTransition (2 * s / s₀ - 1) = 1 :=
      Real.smoothTransition.one_of_one_le (by
        rw [le_sub_iff_add_le, le_div_iff₀ hs₀]; linarith)
    show s₀ / 2 + (s - s₀ / 2) * Real.smoothTransition (2 * s / s₀ - 1) = s
    rw [h1]; ring
  obtain ⟨D, hDdef⟩ : ∃ D : M → ℝ, D = fun x => R (Ssum x) := ⟨_, rfl⟩
  have hDs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ D := by
    rw [hDdef]; exact hRs.comp_contMDiff hSs
  have hDpos : ∀ x, 0 < D x := by
    intro x; rw [hDdef]
    exact lt_of_lt_of_le (by linarith) (hRpos (Ssum x))
  obtain ⟨N₀, hN₀def⟩ : ∃ N₀ : Set M, N₀ = {x | s₀ < Ssum x} := ⟨_, rfl⟩
  have hN₀o : IsOpen N₀ := by rw [hN₀def]; exact isOpen_lt continuous_const hSs.continuous
  have hS0N₀ : S0 ⊆ N₀ := by
    intro x hx; rw [hN₀def]
    have := hSge x hx
    show s₀ < Ssum x
    linarith
  have hDS : ∀ x ∈ N₀, D x = ∑ i ∈ t, ψ i x := by
    intro x hx
    rw [hN₀def] at hx
    have hx' : s₀ < Ssum x := hx
    rw [hDdef]
    exact hReq _ hx'.le
  obtain ⟨w, hwdef⟩ : ∃ w : M → ℝ, w = fun x => (∑ i ∈ t, ψ i x * ff i x ^ 2) / D x :=
    ⟨_, rfl⟩
  have hw : ∀ x, w x = (∑ i ∈ t, ψ i x * ff i x ^ 2) / D x := by
    intro x; rw [hwdef]
  have hws : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w := by
    have h1 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => ∑ i ∈ t, ψ i x * ff i x ^ 2) :=
      contMDiff_finset_sum (fun i hi => (hψs i (htS0 i hi)).mul ((hfs i (htSig i hi)).pow 2))
    rw [hwdef]
    exact h1.div₀ hDs (fun x => (hDpos x).ne')
  have hsuppV : ∀ i ∈ t, ∀ x, ψ i x ≠ 0 → x ∈ Vf i ∩ U₀ := fun i hi x hx =>
    hψsupp i (htS0 i hi) (subset_tsupport _ (Function.mem_support.2 hx))
  have hw0 : ∀ x ∈ Sig, w x = 0 := by
    intro x hx
    rw [hw, Finset.sum_eq_zero, zero_div]
    intro i hi
    by_cases h0 : ψ i x = 0
    · rw [h0, zero_mul]
    · rw [(hZiff i (htSig i hi) x (hsuppV i hi x h0).1).1 hx]; ring
  have hwpos : ∀ x ∈ N₀, x ∉ Sig → 0 < w x := by
    intro x hxN hxS
    rw [hN₀def] at hxN
    have hxN' : s₀ < Ssum x := hxN
    have hS : 0 < Ssum x := lt_trans hs₀ hxN'
    obtain ⟨i, hi, hψi⟩ : ∃ i ∈ t, 0 < ψ i x := by
      by_contra h
      push_neg at h
      have : Ssum x ≤ 0 := Finset.sum_nonpos h
      linarith
    have hfi : ff i x ≠ 0 := fun h0 =>
      hxS ((hZiff i (htSig i hi) x (hsuppV i hi x hψi.ne').1).2 h0)
    have hsq : 0 < ff i x ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hfi))
    rw [hw]
    apply div_pos _ (hDpos x)
    exact Finset.sum_pos' (fun j hj => mul_nonneg (hψnn j (htS0 j hj) x) (sq_nonneg _))
      ⟨i, hi, mul_pos hψi hsq⟩
  
  have hgagree : ∀ q ∈ Sig, ∀ i ∈ Sig, ∀ x ∈ Vf q ∩ Vf i ∩ Sig,
      g.gradInner (ff i) (ff i) x = g.gradInner (ff q) (ff q) x := by
    intro q hq i hi x hx
    have hφ : 0 < φ x := (hdata x hx.2).1
    have h1 := hgr i hi x ⟨hx.1.2, hx.2⟩
    have h2 := hgr q hq x ⟨hx.1.1, hx.2⟩
    have hsq : Real.sqrt (g.gradInner (ff i) (ff i) x) =
        Real.sqrt (g.gradInner (ff q) (ff q) x) :=
      mul_right_cancel₀ hφ.ne' (h1.trans h2.symm)
    have hpos : 0 < Real.sqrt (g.gradInner (ff q) (ff q) x) := by
      by_contra hle
      push_neg at hle
      have h0 : Real.sqrt (g.gradInner (ff q) (ff q) x) = 0 :=
        le_antisymm hle (Real.sqrt_nonneg _)
      rw [h0, zero_mul] at h2
      exact zero_ne_one h2
    have ha : 0 < g.gradInner (ff q) (ff q) x := Real.sqrt_pos.1 hpos
    have hb : 0 < g.gradInner (ff i) (ff i) x := Real.sqrt_pos.1 (by rw [hsq]; exact hpos)
    calc g.gradInner (ff i) (ff i) x = Real.sqrt (g.gradInner (ff i) (ff i) x) ^ 2 :=
          (Real.sq_sqrt hb.le).symm
      _ = Real.sqrt (g.gradInner (ff q) (ff q) x) ^ 2 := by rw [hsq]
      _ = g.gradInner (ff q) (ff q) x := Real.sq_sqrt ha.le
  
  
  
  obtain ⟨U₁, hU₁def⟩ : ∃ U₁ : Set M, U₁ = U₀ ∩ N₀ := ⟨_, rfl⟩
  have hU₁o : IsOpen U₁ := by rw [hU₁def]; exact hU₀o.inter hN₀o
  have hloc : ∀ q : M, ∃ (N K : Set M) (C : ℝ), q ∈ S0 → (IsOpen N ∧ q ∈ N ∧ IsCompact K ∧
      N ⊆ K ∧ K ⊆ U₁ ∧ ∀ x ∈ K, x ∉ Sig →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 ∧ g.levelMeanCurv w x < 0 ∧
        |g.levelMeanCurv w x| ≤ C ∧ g.gradInner w w x ≤ C) := by
    intro q
    by_cases hqS0 : q ∈ S0
    swap
    · exact ⟨∅, ∅, 0, fun h => absurd h hqS0⟩
    have hqS : q ∈ Sig := hS0Sig hqS0
    have hqU₁ : q ∈ U₁ := by rw [hU₁def]; exact ⟨hS0U₀ hqS0, hS0N₀ hqS0⟩
    have hVS' : (Vf q ∩ U₁) ∩ Sig = (Vf q ∩ U₁) ∩ ff q ⁻¹' {0} := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · rintro ⟨⟨hxV, hxU⟩, hxS⟩; exact ⟨⟨hxV, hxU⟩, (hZiff q hqS x hxV).1 hxS⟩
      · rintro ⟨⟨hxV, hxU⟩, h0⟩; exact ⟨⟨hxV, hxU⟩, (hZiff q hqS x hxV).2 h0⟩
    obtain ⟨U, Q, hUo, hqU, hUt, hUV, hQs, hwQ, hQ1, hH0, hdf0⟩ :=
      collar_chart_data g Sig hSm q hqS (Vf q ∩ U₁) (ff q) ((hVo q hqS).inter hU₁o)
        ⟨hpV q hqS, hqU₁⟩ (hfs q hqS) (fun x hx => hdf q hqS x hx.1) hVS' t ψ ff Vf
        (fun i hi => hVo i (htSig i hi)) (fun i hi => hψs i (htS0 i hi))
        (fun i hi => (hψsupp i (htS0 i hi)).trans Set.inter_subset_left)
        (fun i hi => hfs i (htSig i hi)) (fun i hi => hdf i (htSig i hi))
        (fun i hi => hVS i (htSig i hi))
        (fun i hi x hx => hgagree q hqS i (htSig i hi) x ⟨⟨hx.1.1.1, hx.1.2⟩, hx.2⟩)
        D hDs hDpos N₀ (hN₀o.mem_nhds (hS0N₀ hqS0)) hDS w hw
    have hqq : (chartAt E3 q).symm (chartAt E3 q q) = q :=
      (chartAt E3 q).left_inv (mem_chart_source E3 q)
    have hjac : ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 q).symm (chartAt E3 q q))⁻¹ i j *
        partialDeriv i (levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
          (fun z => ff q ((chartAt E3 q).symm z))) (chartAt E3 q q) *
        partialDeriv j (fun z => ff q ((chartAt E3 q).symm z)) (chartAt E3 q q) < 0 := by
      have h := hjd q hqS q ⟨hpV q hqS, hqS⟩
      have hφ : 0 < φ q := (hdata q hqS).1
      have hl : lam q < 0 := by rw [hS0lam q hqS0]; exact hneg
      have hneg' : lam q / φ q < 0 := div_neg_of_neg_of_pos hl hφ
      rw [← h] at hneg'
      exact hneg'
    have hf0 : (fun z => ff q ((chartAt E3 q).symm z)) (chartAt E3 q q) = 0 := by
      show ff q ((chartAt E3 q).symm (chartAt E3 q q)) = 0
      rw [hqq]; exact (hZiff q hqS q (hpV q hqS)).1 hqS
    obtain ⟨r, hr, C, hball, hprop⟩ := collar_coord_model (g.coeff (chartAt E3 q).symm) U hUo
      (fun i j => (g.smooth q i j).mono hUt)
      (fun y hy => coeff_chart_symm_posDef g q y (hUt hy))
      (fun z => ff q ((chartAt E3 q).symm z)) Q (fun z => w ((chartAt E3 q).symm z))
      ((hcd q (ff q) (hfs q hqS)).mono hUt) hQs (chartAt E3 q q) hqU hf0
      hdf0 hwQ hQ1 hH0 hjac
    have hcbU : Metric.closedBall (chartAt E3 q q) r ⊆ (chartAt E3 q).target := hball.trans hUt
    refine ⟨(chartAt E3 q).symm '' Metric.ball (chartAt E3 q q) r,
      (chartAt E3 q).symm '' Metric.closedBall (chartAt E3 q q) r, C,
      fun _ => ⟨?_, ?_, ?_, ?_, ?_, ?_⟩⟩
    · refine (chartAt E3 q).symm.isOpen_image_of_subset_source Metric.isOpen_ball ?_
      rw [OpenPartialHomeomorph.symm_source]
      exact Metric.ball_subset_closedBall.trans hcbU
    · exact ⟨chartAt E3 q q, Metric.mem_ball_self hr, hqq⟩
    · exact (isCompact_closedBall _ _).image_of_continuousOn
        ((chartAt E3 q).continuousOn_symm.mono hcbU)
    · exact Set.image_mono Metric.ball_subset_closedBall
    · rintro _ ⟨y, hy, rfl⟩
      exact (hUV y (hball hy)).2
    · rintro _ ⟨y, hy, rfl⟩ hxS
      have hyU : y ∈ U := hball hy
      have hyt : y ∈ (chartAt E3 q).target := hUt hyU
      have hxV : (chartAt E3 q).symm y ∈ Vf q := (hUV y hyU).1
      have hfy : (fun z => ff q ((chartAt E3 q).symm z)) y ≠ 0 := fun h0 =>
        hxS ((hZiff q hqS _ hxV).2 h0)
      obtain ⟨hdW, hHneg, hHC, hgC⟩ := hprop y hy hfy
      let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
        { toPartialEquiv := (chartAt E3 q).symm.toPartialEquiv
          open_source := (chartAt E3 q).open_target
          open_target := (chartAt E3 q).open_source
          contMDiffOn_toFun := contMDiffOn_chart_symm
          contMDiffOn_invFun := contMDiffOn_chart }
      have hlmc : g.levelMeanCurv w ((chartAt E3 q).symm y) =
          levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
            (fun z => w ((chartAt E3 q).symm z)) y :=
        levelMeanCurv_eq_coord g Φ w (fun z => w ((chartAt E3 q).symm z)) hws y hyt
          (Filter.Eventually.of_forall (fun _ => rfl))
      have hgi : g.gradInner w w ((chartAt E3 q).symm y) = ∑ i : Fin 3, ∑ j : Fin 3,
          (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
            partialDeriv i (fun z => w ((chartAt E3 q).symm z)) y *
            partialDeriv j (fun z => w ((chartAt E3 q).symm z)) y :=
        gradInner_eq_coord g Φ w (fun z => w ((chartAt E3 q).symm z)) hws y hyt
          (Filter.Eventually.of_forall (fun _ => rfl))
      refine ⟨?_, by rw [hlmc]; exact hHneg, by rw [hlmc]; exact hHC, by rw [hgi]; exact hgC⟩
      intro hm
      apply hdW
      have hmdw : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w ((chartAt E3 q).symm y) :=
        hws.mdifferentiableAt (by simp)
      have hmds : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
        ((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (n := ∞)).contMDiffAt
          ((chartAt E3 q).open_target.mem_nhds hyt)).mdifferentiableAt (by simp)
      have hcomp := mfderiv_comp y hmdw hmds
      rw [← mfderiv_eq_fderiv]
      show mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (w ∘ (chartAt E3 q).symm) y = 0
      rw [hcomp, hm, ContinuousLinearMap.zero_comp]
  
  
  
  choose Nf Kf Cf hNK using hloc
  obtain ⟨t', ht'S0, hcov'⟩ := hS0c.elim_nhds_subcover Nf
    (fun q hq => (hNK q hq).1.mem_nhds (hNK q hq).2.1)
  obtain ⟨O, hOdef⟩ : ∃ O : Set M, O = ⋃ q ∈ t', Nf q := ⟨_, rfl⟩
  obtain ⟨K, hKdef⟩ : ∃ K : Set M, K = ⋃ q ∈ t', Kf q := ⟨_, rfl⟩
  have hOo : IsOpen O := by
    rw [hOdef]; exact isOpen_biUnion (fun q hq => (hNK q (ht'S0 q hq)).1)
  have hOK : O ⊆ K := by
    intro x hx
    rw [hOdef] at hx; rw [hKdef]
    obtain ⟨q, hq, hxq⟩ := Set.mem_iUnion₂.1 hx
    exact Set.mem_iUnion₂.2 ⟨q, hq, (hNK q (ht'S0 q hq)).2.2.2.1 hxq⟩
  have hKU₁ : K ⊆ U₁ := by
    intro x hx
    rw [hKdef] at hx
    obtain ⟨q, hq, hxq⟩ := Set.mem_iUnion₂.1 hx
    exact (hNK q (ht'S0 q hq)).2.2.2.2.1 hxq
  have hKc : IsCompact K := by
    rw [hKdef]; exact t'.isCompact_biUnion (fun q hq => (hNK q (ht'S0 q hq)).2.2.1)
  have hS0O : S0 ⊆ O := by rw [hOdef]; exact hcov'
  have hU₁sub : ∀ x ∈ U₁, x ∈ U₀ ∧ x ∈ N₀ := by
    intro x hx; rw [hU₁def] at hx; exact hx
  have hKO : ∀ x ∈ K, x ∉ O → 0 < w x := by
    intro x hxK hxO
    have hxU₁ := hU₁sub x (hKU₁ hxK)
    have hxS : x ∉ Sig := fun hxS => hxO (hS0O (hU₀Sig x hxU₁.1 hxS))
    exact hwpos x hxU₁.2 hxS
  obtain ⟨t₀, ht₀, ht₀K⟩ : ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ x ∈ K, x ∉ O → t₀ < w x := by
    by_cases hne : (K \ O).Nonempty
    · obtain ⟨xm', hxm', hmin'⟩ :=
        (hKc.diff hOo).exists_isMinOn hne hws.continuous.continuousOn
      have hpos := hKO xm' hxm'.1 hxm'.2
      refine ⟨w xm' / 2, by linarith, fun x hxK hxO => ?_⟩
      have := isMinOn_iff.1 hmin' x ⟨hxK, hxO⟩
      linarith
    · exact ⟨1, one_pos, fun x hxK hxO => absurd ⟨x, hxK, hxO⟩ hne⟩
  have hsub : {x | x ∈ O ∧ w x ≤ t₀} = K ∩ {x | w x ≤ t₀} := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_inter_iff]
    constructor
    · rintro ⟨hxO, hwx⟩; exact ⟨hOK hxO, hwx⟩
    · rintro ⟨hxK, hwx⟩
      refine ⟨?_, hwx⟩
      by_contra hxO
      have := ht₀K x hxK hxO
      linarith
  have hOpt : ∀ x ∈ O, x ∉ Sig → ∃ q ∈ t', x ∈ Kf q ∧ (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 ∧
      g.levelMeanCurv w x < 0 ∧ |g.levelMeanCurv w x| ≤ Cf q ∧ g.gradInner w w x ≤ Cf q) := by
    intro x hxO hxS
    rw [hOdef] at hxO
    obtain ⟨q, hq, hxq⟩ := Set.mem_iUnion₂.1 hxO
    have hxK : x ∈ Kf q := (hNK q (ht'S0 q hq)).2.2.2.1 hxq
    exact ⟨q, hq, hxK, (hNK q (ht'S0 q hq)).2.2.2.2.2 x hxK hxS⟩
  refine ⟨O, w, t₀, hOo, ?_, hS0O hp₀S0, ht₀, ?_, hws.continuous.continuousOn, ?_, ?_,
    hws.contMDiffOn, ?_, ?_, ∑ q ∈ t', |Cf q|, ?_⟩
  · intro x hx
    have h := hU₁sub x (hKU₁ (hOK hx))
    rw [hU₀def] at h
    exact h.1.1
  · rw [hsub]; exact hKc.inter_right (isClosed_le hws.continuous continuous_const)
  · intro x _ hxS; exact hw0 x hxS
  · intro x hxO hxS; exact hwpos x (hU₁sub x (hKU₁ (hOK hxO))).2 hxS
  · rintro x ⟨hxO, hxS⟩
    obtain ⟨q, -, -, h⟩ := hOpt x hxO hxS
    exact h.1
  · rintro x ⟨hxO, hxS⟩
    obtain ⟨q, -, -, h⟩ := hOpt x hxO hxS
    exact h.2.1
  · rintro x ⟨hxO, hxS⟩ -
    obtain ⟨q, hq, -, -, -, hHC, hgC⟩ := hOpt x hxO hxS
    have hle : Cf q ≤ ∑ q ∈ t', |Cf q| :=
      (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (Cf i)) hq)
    exact ⟨hgC.trans hle, hHC.trans hle⟩

theorem collar_cutoff_props [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (Sig O : Set M) (w : M → ℝ)
    (t₀ a b : ℝ) (hSig : IsClosed Sig) (hO : IsOpen O) (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀})
    (hwc : ContinuousOn w O) (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig)) (ha : 0 < a) (hab : a < b) (hb : b ≤ t₀) :
    ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))) ∧
      (∀ x, 0 ≤ O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x ∧
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x ≤ 1) ∧
      (∀ x ∈ O, w x ≤ a →
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x = 1 ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ)
          (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))) x = 0) ∧
      (∀ x, O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x ≠ 0 →
        x ∈ O ∧ w x < b) ∧
      (∀ x, x ∉ {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ)
          (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))) x = 0) ∧
      (∀ c : ℝ, c ≤ t₀ → IsClosed {x | x ∈ O ∧ w x ≤ c} ∧ IsCompact {x | x ∈ O ∧ w x ≤ c}) ∧
      IsCompact {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} :=
by
  
  have fermat : ∀ (f : M → ℝ) (x : M), ((∀ y, f y ≤ f x) ∨ (∀ y, f x ≤ f y)) →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x = 0 := by
    intro f x hext
    by_cases hdf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x
    · rw [hdf.mfderiv, ModelWithCorners.range_eq_univ, fderivWithin_univ]
      have hF : ∀ y, writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) x f y =
          f ((extChartAt 𝓘(ℝ, E3) x).symm y) := by
        intro y
        simp [writtenInExtChartAt, extChartAt_model_space_eq_id]
      have hF0 : writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) x f (extChartAt 𝓘(ℝ, E3) x x) = f x := by
        rw [hF, extChartAt_to_inv]
      rcases hext with h | h
      · apply IsLocalMax.fderiv_eq_zero
        exact Filter.Eventually.of_forall (fun y => by rw [hF0, hF]; exact h _)
      · apply IsLocalMin.fderiv_eq_zero
        exact Filter.Eventually.of_forall (fun y => by rw [hF0, hF]; exact h _)
    · exact mfderiv_zero_of_not_mdifferentiableAt hdf
  have hd : 0 < b - a := by linarith
  
  have hH1 : ∀ s : ℝ, 0 ≤ 1 - Real.smoothTransition ((s - a) / (b - a)) ∧
      1 - Real.smoothTransition ((s - a) / (b - a)) ≤ 1 := by
    intro s
    have h1 := Real.smoothTransition.nonneg ((s - a) / (b - a))
    have h2 := Real.smoothTransition.le_one ((s - a) / (b - a))
    constructor <;> linarith
  have hH2 : ∀ s : ℝ, s ≤ a → 1 - Real.smoothTransition ((s - a) / (b - a)) = 1 := by
    intro s hs
    rw [Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg (by linarith) hd.le)]
    ring
  have hH3 : ∀ s : ℝ, b ≤ s → 1 - Real.smoothTransition ((s - a) / (b - a)) = 0 := by
    intro s hs
    rw [Real.smoothTransition.one_of_one_le ((le_div_iff₀ hd).2 (by linarith))]
    ring
  have hH5 : ContDiff ℝ ∞ (fun s : ℝ => 1 - Real.smoothTransition ((s - a) / (b - a))) :=
    contDiff_const.sub ((Real.smoothTransition.contDiff (n := ⊤)).comp
      ((contDiff_id.sub contDiff_const).div_const _))
  
  have hC6 : ∀ c : ℝ, c ≤ t₀ → IsClosed {x | x ∈ O ∧ w x ≤ c} ∧
      IsCompact {x | x ∈ O ∧ w x ≤ c} := by
    intro c hc
    have heq : {x | x ∈ O ∧ w x ≤ c} = {x | x ∈ O ∧ w x ≤ t₀} ∩ w ⁻¹' Set.Iic c := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iic]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨⟨h1, h2.trans hc⟩, h2⟩
      · rintro ⟨⟨h1, _⟩, h2⟩
        exact ⟨h1, h2⟩
    have hcl : IsClosed {x | x ∈ O ∧ w x ≤ c} := by
      rw [heq]
      exact ContinuousOn.preimage_isClosed_of_isClosed (hwc.mono (fun x hx => hx.1))
        hcpt.isClosed isClosed_Iic
    exact ⟨hcl, hcpt.of_isClosed_subset hcl (fun x hx => ⟨hx.1, hx.2.trans hc⟩)⟩
  have hC7 : IsCompact {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} := by
    have heq : {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} =
        {x | x ∈ O ∧ w x ≤ t₀} ∩ w ⁻¹' Set.Icc a b := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Icc]
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨⟨h1, h3.trans hb⟩, h2, h3⟩
      · rintro ⟨⟨h1, _⟩, h2, h3⟩
        exact ⟨h1, h2, h3⟩
    have hcl : IsClosed {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} := by
      rw [heq]
      exact ContinuousOn.preimage_isClosed_of_isClosed (hwc.mono (fun x hx => hx.1))
        hcpt.isClosed isClosed_Icc
    exact hcpt.of_isClosed_subset hcl (fun x hx => ⟨hx.1, hx.2.2.trans hb⟩)
  have hKb : IsClosed {x | x ∈ O ∧ w x ≤ b} := (hC6 b hb).1
  
  set φ : M → ℝ := O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))
    with hφ
  have hφin : ∀ x ∈ O, φ x = 1 - Real.smoothTransition ((w x - a) / (b - a)) := by
    intro x hx
    rw [hφ, Set.indicator_of_mem hx]
  have hφout : ∀ x, x ∉ O → φ x = 0 := by
    intro x hx
    rw [hφ, Set.indicator_of_notMem hx]
  have hC2 : ∀ x, 0 ≤ φ x ∧ φ x ≤ 1 := by
    intro x
    by_cases hx : x ∈ O
    · rw [hφin x hx]; exact hH1 _
    · rw [hφout x hx]; exact ⟨le_refl _, zero_le_one⟩
  have hV1 : ∀ x ∈ O, w x ≤ a → φ x = 1 := by
    intro x hx hwa
    rw [hφin x hx]; exact hH2 _ hwa
  have hV0 : ∀ x, x ∉ {x | x ∈ O ∧ w x ≤ b} → φ x = 0 := by
    intro x hx
    by_cases hxO : x ∈ O
    · have hbw : b ≤ w x := by
        by_contra hlt
        exact hx ⟨hxO, le_of_lt (lt_of_not_ge hlt)⟩
      rw [hφin x hxO]; exact hH3 _ hbw
    · exact hφout x hxO
  have hC4 : ∀ x, φ x ≠ 0 → x ∈ O ∧ w x < b := by
    intro x hx
    by_contra hcon
    apply hx
    apply hV0
    rintro ⟨h1, h2⟩
    apply hcon
    refine ⟨h1, lt_of_le_of_ne h2 ?_⟩
    intro hwb
    apply hx
    rw [hφin x h1]
    exact hH3 _ hwb.ge
  
  have hC1 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ := by
    intro x
    by_cases hxO : x ∈ O
    · by_cases hxS : x ∈ Sig
      · have hwx : w x < a := by rw [hw0 x hxO hxS]; exact ha
        have hN : O ∩ w ⁻¹' Set.Iio a ∈ 𝓝 x :=
          (hwc.isOpen_inter_preimage hO isOpen_Iio).mem_nhds ⟨hxO, hwx⟩
        have heq : φ =ᶠ[𝓝 x] fun _ => (1 : ℝ) :=
          Filter.eventuallyEq_of_mem hN (fun y hy => hV1 y hy.1 (le_of_lt hy.2))
        exact contMDiffAt_const.congr_of_eventuallyEq heq
      · have hD : IsOpen (O \ Sig) := hO.sdiff hSig
        have hwx : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w x :=
          hws.contMDiffAt (hD.mem_nhds ⟨hxO, hxS⟩)
        have hc := hH5.comp_contMDiffAt hwx
        refine hc.congr_of_eventuallyEq ?_
        exact Filter.eventuallyEq_of_mem (hO.mem_nhds hxO) (fun y hy => hφin y hy)
    · have hN : {x | x ∈ O ∧ w x ≤ b}ᶜ ∈ 𝓝 x :=
        hKb.isOpen_compl.mem_nhds (fun h => hxO h.1)
      have heq : φ =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
        Filter.eventuallyEq_of_mem hN (fun y hy => hV0 y hy)
      exact contMDiffAt_const.congr_of_eventuallyEq heq
  
  have hC3 : ∀ x ∈ O, w x ≤ a → φ x = 1 ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) φ x = 0 := by
    intro x hx hwa
    have h1 := hV1 x hx hwa
    refine ⟨h1, fermat φ x (Or.inl (fun y => ?_))⟩
    rw [h1]; exact (hC2 y).2
  have hC5 : ∀ x, x ∉ {y | y ∈ O ∧ a ≤ w y ∧ w y ≤ b} →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) φ x = 0 := by
    intro x hx
    by_cases hxO : x ∈ O
    · by_cases hwa : w x ≤ a
      · exact (hC3 x hxO hwa).2
      · have hbw : b < w x := by
          by_contra hle
          exact hx ⟨hxO, le_of_lt (lt_of_not_ge hwa), le_of_not_gt hle⟩
        have h0 : φ x = 0 := by rw [hφin x hxO]; exact hH3 _ hbw.le
        refine fermat φ x (Or.inr (fun y => ?_))
        rw [h0]; exact (hC2 y).1
    · have h0 : φ x = 0 := hφout x hxO
      refine fermat φ x (Or.inr (fun y => ?_))
      rw [h0]; exact (hC2 y).1
  exact ⟨hC1, hC2, hC3, hC4, hC5, hC6, hC7⟩

theorem hull_calPiece_div_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E U K : Set M) (hE : IsOpen E) (hK : IsClosed K) (hKi : interior K = ∅) (hEK : Disjoint E K) (hU : IsOpen U) (p : M) (ψ : M → ℝ) (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hψc : IsCompact (tsupport ψ)) (hψs : tsupport ψ ⊆ U ∩ (chartAt E3 p).source) (c : ℝ) (hc : 0 < c) (hψb : ∀ x, |ψ x| ≤ c) (V : M → E3) (hVs : ∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3)) ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ)) (hVd : ∀ (p : M) (ψ : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ → IsCompact (tsupport ψ) → tsupport ψ ⊆ (chartAt E3 p).source → ∃ C : ℝ, ∀ y, y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) → |sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y| ≤ C) (hV1 : ∀ x, g.g x (V x) (V x) ≤ 1) : ENNReal.ofReal (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y) ≤ ENNReal.ofReal c * hullRiemPer g E U K :=
by
  classical
  
  have kill : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (D : Set E3),
      interior D = ∅ → (∀ y ∈ D, 0 < (G y).det) → ∃ X' : E3 → E3,
        (∀ y, y ∉ D → X' y = X y) ∧ (∀ y ∈ D, sepDensDiv G X' y = 0) ∧
        (∀ y ∈ D, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1) := by
    intro G X D hD hdet
    obtain ⟨s, hs⟩ : ∃ s : E3 → ℝ,
        s = fun y => (1 + ∑ a : Fin 3, ∑ b : Fin 3, |G y a b|)⁻¹ := ⟨_, rfl⟩
    have hσ : ∀ y, 0 ≤ ∑ a : Fin 3, ∑ b : Fin 3, |G y a b| := fun y =>
      Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _
    have hspos : ∀ y, 0 < s y := fun y => by
      rw [hs]; exact inv_pos.mpr (by linarith [hσ y])
    have hs1 : ∀ y, s y * (1 + ∑ a : Fin 3, ∑ b : Fin 3, |G y a b|) = 1 := fun y => by
      rw [hs]; exact inv_mul_cancel₀ (by linarith [hσ y])
    obtain ⟨L, hL⟩ : ∃ L : Fin 3 → E3 → Prop, L = fun i y =>
        Tendsto (fun z => Real.sqrt (G z).det * X z i) (𝓝[Dᶜ] y) (𝓝 0) := ⟨_, rfl⟩
    obtain ⟨X', hX'X, hX'D⟩ : ∃ X' : E3 → E3, (∀ y, y ∉ D → X' y = X y) ∧
        (∀ y ∈ D, ∀ i, X' y i = if L i y then s y else 0) :=
      ⟨fun y => if y ∈ D then WithLp.toLp 2 (fun i => if L i y then s y else 0) else X y,
        fun y hy => if_neg hy, fun y hy i => by simp only [if_pos hy]⟩
    have hne : ∀ y, (𝓝[Dᶜ] y).NeBot := by
      intro y
      rw [← mem_closure_iff_nhdsWithin_neBot, closure_compl, hD, Set.compl_empty]
      exact Set.mem_univ y
    have hnd : ∀ y ∈ D, ∀ i : Fin 3,
        ¬ DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * X' z i) y := by
      intro y hy i hdiff
      have h1 : Tendsto (fun z => Real.sqrt (G z).det * X' z i) (𝓝[Dᶜ] y)
          (𝓝 (Real.sqrt (G y).det * X' y i)) :=
        hdiff.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
      have h2 : Tendsto (fun z => Real.sqrt (G z).det * X z i) (𝓝[Dᶜ] y)
          (𝓝 (Real.sqrt (G y).det * X' y i)) := by
        refine h1.congr' ?_
        filter_upwards [self_mem_nhdsWithin] with z hz
        rw [hX'X z hz]
      haveI := hne y
      have hsq : 0 < Real.sqrt (G y).det := Real.sqrt_pos.mpr (hdet y hy)
      by_cases hLi : L i y
      · have hL' : Tendsto (fun z => Real.sqrt (G z).det * X z i) (𝓝[Dᶜ] y) (𝓝 0) := by
          rw [hL] at hLi; exact hLi
        have h3 := tendsto_nhds_unique h2 hL'
        rw [hX'D y hy i, if_pos hLi] at h3
        have := mul_pos hsq (hspos y)
        linarith
      · rw [hX'D y hy i, if_neg hLi, mul_zero] at h2
        apply hLi
        rw [hL]; exact h2
    refine ⟨X', hX'X, fun y hy => ?_, fun y hy => ?_⟩
    · unfold sepDensDiv partialDeriv
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [fderiv_zero_of_not_differentiableAt (hnd y hy i)]
      exact ContinuousLinearMap.zero_apply _
    · have ha : ∀ i, |X' y i| ≤ s y := by
        intro i
        rw [hX'D y hy i]
        split_ifs
        · rw [abs_of_pos (hspos y)]
        · rw [abs_zero]; exact (hspos y).le
      have hsy := hspos y
      have hs1y := hs1 y
      have hσy := hσ y
      calc ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j
          ≤ ∑ i : Fin 3, ∑ j : Fin 3, |G y i j| * (s y * s y) := by
            refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
            calc G y i j * X' y i * X' y j ≤ |G y i j * X' y i * X' y j| := le_abs_self _
              _ = |G y i j| * (|X' y i| * |X' y j|) := by rw [abs_mul, abs_mul]; ring
              _ ≤ |G y i j| * (s y * s y) := by
                apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
                exact mul_le_mul (ha i) (ha j) (abs_nonneg _) hsy.le
        _ = (∑ a : Fin 3, ∑ b : Fin 3, |G y a b|) * (s y * s y) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Finset.sum_mul]
        _ ≤ 1 := by nlinarith
  
  have admiss : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U Kc D : Set E3), MeasurableSet F →
      Disjoint F D → IsCompact D → D ⊆ Kc → D ⊆ U → ∀ (X X' : E3 → E3),
      (∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X y) → HasCompactSupport X → tsupport X ⊆ U →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      (∃ C : ℝ, ∀ y, y ∉ D → |sepDensDiv G X y| ≤ C) → (∀ y, y ∉ D → X' y = X y) →
      (∀ y ∈ D, sepDensDiv G X' y = 0) →
      (∀ y ∈ D, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1) →
      ENNReal.ofReal (∫ y in F, sepDensDiv G X y) ≤ hullPerG G F U Kc := by
    intro G F U Kc D hF hFD hD hDKc hDU X X' hXs hXc hXU hXn hXd hX'X hX'd hX'n
    have hDcl : IsClosed D := hD.isClosed
    have hg0 : ∀ y, y ∉ D → X' =ᶠ[𝓝 y] X := fun y hy => by
      filter_upwards [hDcl.isOpen_compl.mem_nhds hy] with z hz using hX'X z hz
    have hdivEq : ∀ y, y ∉ D → sepDensDiv G X' y = sepDensDiv G X y := by
      intro y hy
      unfold sepDensDiv partialDeriv
      refine Finset.sum_congr rfl fun i _ => ?_
      have hev : (fun z => Real.sqrt (G z).det * X' z i) =ᶠ[𝓝 y]
          (fun z => Real.sqrt (G z).det * X z i) := by
        filter_upwards [hg0 y hy] with z hz
        rw [hz]
      rw [hev.fderiv_eq]
    have hQc : IsCompact (tsupport X ∪ D) := hXc.isCompact.union hD
    have hQcl : IsClosed (tsupport X ∪ D) := (isClosed_tsupport X).union hDcl
    have hX'0 : ∀ y, y ∉ tsupport X ∪ D → X' y = 0 := by
      intro y hy
      rw [Set.mem_union, not_or] at hy
      rw [hX'X y hy.2]
      exact image_eq_zero_of_notMem_tsupport hy.1
    have hX's : ∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X' y := fun y hy =>
      (hXs y hy).congr_of_eventuallyEq (hg0 y (fun h => hy (hDKc h)))
    have hX'c : HasCompactSupport X' := HasCompactSupport.intro hQc hX'0
    have hX'U : tsupport X' ⊆ U := by
      have h1 : tsupport X' ⊆ tsupport X ∪ D :=
        closure_minimal (fun y hy => by_contra fun h => hy (hX'0 y h)) hQcl
      exact h1.trans (Set.union_subset hXU hDU)
    have hX'n' : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1 := by
      intro y
      by_cases hy : y ∈ D
      · exact hX'n y hy
      · rw [hX'X y hy]; exact hXn y
    obtain ⟨C, hC⟩ := hXd
    have hX'd' : ∀ y, |sepDensDiv G X' y| ≤ max C 0 := by
      intro y
      by_cases hy : y ∈ D
      · rw [hX'd y hy, abs_zero]; exact le_max_right _ _
      · rw [hdivEq y hy]; exact (hC y hy).trans (le_max_left _ _)
    have hint : ∫ y in F, sepDensDiv G X' y = ∫ y in F, sepDensDiv G X y :=
      MeasureTheory.setIntegral_congr_fun hF
        (fun y hy => hdivEq y (Set.disjoint_left.mp hFD hy))
    unfold hullPerG
    exact le_iSup₂_of_le X' ⟨hX's, hX'c, hX'U, hX'n', ⟨max C 0, hX'd'⟩⟩
      (le_of_eq (by rw [hint]))
  
  have hψs' : tsupport ψ ⊆ (chartAt E3 p).source := hψs.trans Set.inter_subset_right
  have hKc : IsCompact ((chartAt E3 p) '' tsupport ψ) :=
    hψc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hψs')
  have hKcl : IsClosed ((chartAt E3 p) '' tsupport ψ) := hKc.isClosed
  have hKt : (chartAt E3 p) '' tsupport ψ ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source (hψs' hx)
  have hval : ∀ y ∈ (chartAt E3 p).target, calPiece p ψ V y =
      (ψ ((chartAt E3 p).symm y) • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
        ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3) := by
    intro y hy
    unfold calPiece
    rw [Set.indicator_of_mem hy]
  have hval0 : ∀ y ∉ (chartAt E3 p).target, calPiece p ψ V y = 0 := by
    intro y hy
    unfold calPiece
    rw [Set.indicator_of_notMem hy]
  have hZ : ∀ y ∉ (chartAt E3 p) '' tsupport ψ, calPiece p ψ V y = 0 := by
    intro y hy
    by_cases hyt : y ∈ (chartAt E3 p).target
    · have hx : (chartAt E3 p).symm y ∉ tsupport ψ := fun hx =>
        hy ⟨_, hx, (chartAt E3 p).right_inv hyt⟩
      rw [hval y hyt, image_eq_zero_of_notMem_tsupport hx, zero_smul]
    · exact hval0 y hyt
  
  have hCK : ∀ y, y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) →
      ContDiffAt ℝ ∞ (calPiece p ψ V) y := by
    intro y hy
    have h1 : ContDiffOn ℝ ∞ (fun y => ψ ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
      contMDiffOn_iff_contDiffOn.mp (hψ.comp_contMDiffOn contMDiffOn_chart_symm)
    have hT'o : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ) :=
      (chartAt E3 p).isOpen_inter_preimage_symm hK.isOpen_compl
    have hT'P : ContDiffOn ℝ ∞ (calPiece p ψ V)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ) :=
      ((h1.mono Set.inter_subset_left).smul (hVs p)).congr (fun y hy => hval y hy.1)
    by_cases hyt : y ∈ (chartAt E3 p).target
    · have hyK : (chartAt E3 p).symm y ∉ K := fun h =>
        hy ⟨_, ⟨h, (chartAt E3 p).map_target hyt⟩, (chartAt E3 p).right_inv hyt⟩
      exact hT'P.contDiffAt (hT'o.mem_nhds ⟨hyt, hyK⟩)
    · have hy' : y ∉ (chartAt E3 p) '' tsupport ψ := fun h => hyt (hKt h)
      have hev : calPiece p ψ V =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        filter_upwards [hKcl.isOpen_compl.mem_nhds hy'] with z hz using hZ z hz
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hHC : HasCompactSupport (calPiece p ψ V) := HasCompactSupport.intro hKc hZ
  have hT : tsupport (calPiece p ψ V) ⊆ (chartAt E3 p) '' tsupport ψ :=
    closure_minimal (fun y hy => by_contra fun h => hy (hZ y h)) hKcl
  
  set X : E3 → E3 := fun z => c⁻¹ • calPiece p ψ V z with hXdef
  have hXs : ∀ y, y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) → ContDiffAt ℝ ∞ X y :=
    fun y hy => (hCK y hy).const_smul c⁻¹
  have hXK : HasCompactSupport X := hHC.mono (fun y hy h => hy (by simp [hXdef, h]))
  have hXT : tsupport X ⊆ (chartAt E3 p) '' (U ∩ (chartAt E3 p).source) :=
    (tsupport_smul_subset_right (fun _ => c⁻¹) (calPiece p ψ V)).trans
      (hT.trans (Set.image_mono hψs))
  have hexp : ∀ (L : E3 →L[ℝ] E3) (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (a : E3),
      ∑ i : Fin 3, ∑ j : Fin 3, B (L (e i)) (L (e j)) * a i * a j = B (L a) (L a) := by
    intro L B a
    have ha : a = a 0 • e 0 + a 1 • e 1 + a 2 • e 2 := by
      ext i; fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    conv_rhs => rw [ha]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Fin.sum_univ_three]
    ring
  have hXN : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      g.coeff (chartAt E3 p).symm y i j * X y i * X y j ≤ 1 := by
    intro y
    by_cases hy : y ∈ (chartAt E3 p).target
    · have hxs : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
      have hchain : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) w) = w := by
        intro w
        have h := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) p).symm_comp_deriv hxs
        rw [(chartAt E3 p).right_inv hy] at h
        exact DFunLike.congr_fun h w
      have hXy : X y = (c⁻¹ * ψ ((chartAt E3 p).symm y)) • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3)
          (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) := by
        simp only [hXdef, hval y hy, smul_smul]
      have hsum : ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 p).symm y i j * X y i * X y j =
          g.g ((chartAt E3 p).symm y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (X y))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (X y)) :=
        hexp _ _ _
      rw [hsum, hXy]
      simp only [map_smul, hchain, ContinuousLinearMap.smul_apply, smul_eq_mul]
      have h1 : |c⁻¹ * ψ ((chartAt E3 p).symm y)| ≤ 1 := by
        rw [abs_mul, abs_of_pos (inv_pos.mpr hc), inv_mul_le_iff₀ hc, mul_one]
        exact hψb _
      have h2 : (c⁻¹ * ψ ((chartAt E3 p).symm y)) ^ 2 ≤ 1 := by
        rw [← sq_abs]; nlinarith [abs_nonneg (c⁻¹ * ψ ((chartAt E3 p).symm y))]
      have h3 := hV1 ((chartAt E3 p).symm y)
      have h4 : 0 ≤ (c⁻¹ * ψ ((chartAt E3 p).symm y)) ^ 2 := sq_nonneg _
      nlinarith [mul_le_mul_of_nonneg_left h3 h4]
    · have hX0 : X y = 0 := by simp [hXdef, hval0 y hy]
      simp [hX0]
  have hXZ : ∀ y, y ∉ (chartAt E3 p) '' tsupport ψ → X y = 0 := by
    intro y hy
    simp [hXdef, hZ y hy]
  
  have hcal : calPiece p ψ V = fun z => c • X z := by
    funext z
    simp only [hXdef, smul_smul, mul_inv_cancel₀ hc.ne', one_smul]
  have hdiv : ∀ y, sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
      c * sepDensDiv (g.coeff (chartAt E3 p).symm) X y := by
    intro y
    rw [hcal]
    unfold sepDensDiv partialDeriv
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hf : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * (c • X z) i) =
        c • (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) := by
      funext z; simp only [Pi.smul_apply, PiLp.smul_apply, smul_eq_mul]; ring
    rw [hf, fderiv_const_smul_of_field]
    simp
  have hint : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
      c * ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) X y := by
    rw [← MeasureTheory.integral_const_mul]
    exact MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hdiv)
  
  have hD₀c : IsCompact ((chartAt E3 p) '' (K ∩ tsupport ψ)) :=
    (hψc.inter_left hK).image_of_continuousOn
      ((chartAt E3 p).continuousOn.mono (Set.inter_subset_right.trans hψs'))
  have hD₀T : (chartAt E3 p) '' (K ∩ tsupport ψ) ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source (hψs' hx.2)
  have hD₀i : interior ((chartAt E3 p) '' (K ∩ tsupport ψ)) = ∅ := by
    have hO : IsOpen ((chartAt E3 p).symm '' interior ((chartAt E3 p) '' (K ∩ tsupport ψ))) :=
      (chartAt E3 p).isOpen_image_symm_of_subset_target isOpen_interior
        (interior_subset.trans hD₀T)
    have hsub : (chartAt E3 p).symm '' interior ((chartAt E3 p) '' (K ∩ tsupport ψ)) ⊆ K := by
      rintro _ ⟨y, hy, rfl⟩
      obtain ⟨x, hx, rfl⟩ := interior_subset hy
      rw [(chartAt E3 p).left_inv (hψs' hx.2)]
      exact hx.1
    have h2 := interior_maximal hsub hO
    rw [hKi] at h2
    exact Set.image_eq_empty.mp (Set.subset_empty_iff.mp h2)
  have hD₀Kc : (chartAt E3 p) '' (K ∩ tsupport ψ) ⊆
      chartAt E3 p '' (K ∩ (chartAt E3 p).source) :=
    Set.image_mono (Set.inter_subset_inter_right _ hψs')
  have hD₀U : (chartAt E3 p) '' (K ∩ tsupport ψ) ⊆
      (chartAt E3 p) '' (U ∩ (chartAt E3 p).source) :=
    (Set.image_mono Set.inter_subset_right).trans (Set.image_mono hψs)
  have hposdef : ∀ y ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  have hdet : ∀ y ∈ (chartAt E3 p) '' (K ∩ tsupport ψ),
      0 < (g.coeff (chartAt E3 p).symm y).det :=
    fun y hy => (hposdef y (hD₀T hy)).det_pos
  have hSo : IsOpen (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source (hE.inter (chartAt E3 p).open_source)
      Set.inter_subset_right
  have hSD : Disjoint (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
      ((chartAt E3 p) '' (K ∩ tsupport ψ)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨x, hx, rfl⟩ ⟨x', hx', hxx'⟩
    have hx'x : x' = x := (chartAt E3 p).injOn (hψs' hx'.2) hx.2 hxx'
    rw [hx'x] at hx'
    exact Set.disjoint_left.mp hEK hx.1 hx'.1
  
  obtain ⟨C, hC⟩ := hVd p ψ hψ hψc hψs'
  have hXd : ∀ y, y ∉ (chartAt E3 p) '' (K ∩ tsupport ψ) →
      |sepDensDiv (g.coeff (chartAt E3 p).symm) X y| ≤ max (c⁻¹ * C) 0 := by
    intro y hy
    by_cases hyK : y ∈ chartAt E3 p '' (K ∩ (chartAt E3 p).source)
    · obtain ⟨x', hx', rfl⟩ := hyK
      have hyψ : chartAt E3 p x' ∉ (chartAt E3 p) '' tsupport ψ := by
        rintro ⟨x, hx, hxx'⟩
        have hxx : x = x' := (chartAt E3 p).injOn (hψs' hx) hx'.2 hxx'
        rw [hxx] at hx
        exact hy ⟨x', ⟨hx'.1, hx⟩, rfl⟩
      have h0 : sepDensDiv (g.coeff (chartAt E3 p).symm) X (chartAt E3 p x') = 0 := by
        unfold sepDensDiv partialDeriv
        refine Finset.sum_eq_zero fun i _ => ?_
        have hev : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i)
            =ᶠ[𝓝 (chartAt E3 p x')] fun _ => (0 : ℝ) := by
          filter_upwards [hKcl.isOpen_compl.mem_nhds hyψ] with z hz
          rw [hXZ z hz]
          simp
        rw [hev.fderiv_eq]
        simp
      rw [h0, abs_zero]
      exact le_max_right _ _
    · have h1 := hC y hyK
      rw [hdiv y, abs_mul, abs_of_pos hc] at h1
      have h2 := mul_le_mul_of_nonneg_left h1 (inv_nonneg.mpr hc.le)
      rw [← mul_assoc, inv_mul_cancel₀ hc.ne', one_mul] at h2
      exact h2.trans (le_max_left _ _)
  
  obtain ⟨X', hX'X, hX'd, hX'n⟩ := kill (g.coeff (chartAt E3 p).symm) X
    ((chartAt E3 p) '' (K ∩ tsupport ψ)) hD₀i hdet
  have hS4 : ENNReal.ofReal (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) X y) ≤
      hullPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (U ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (K ∩ (chartAt E3 p).source)) :=
    admiss _ _ _ _ _ hSo.measurableSet hSD hD₀c hD₀Kc hD₀U X X' hXs hXK hXT hXN ⟨_, hXd⟩
      hX'X hX'd hX'n
  
  have hS5 : hullPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (U ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (K ∩ (chartAt E3 p).source)) ≤ hullRiemPer g E U K := by
    unfold hullRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le
      (fun _ => U ∩ (chartAt E3 p).source) (le_iSup_of_le
      ⟨fun _ => ⟨hU.inter (chartAt E3 p).open_source, subset_rfl⟩,
        fun k l hkl => absurd (Subsingleton.elim k l) hkl⟩ ?_)))
    rw [Fin.sum_univ_one]
  
  rw [hint, ENNReal.ofReal_mul hc.le]
  exact mul_le_mul_left' (hS4.trans hS5) _

theorem hull_calPiece_div_integral_chart_eq [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (K : Set M) (p q : M) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ) (hφc : IsCompact (tsupport φ)) (hφs : tsupport φ ⊆ (chartAt E3 p).source ∩ (chartAt E3 q).source) (V : M → E3) (hVs : ∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3)) ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ)) (E : Set M) (hE : IsOpen E) (hEK : Disjoint E K) : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y = ∫ y in chartAt E3 q '' (E ∩ (chartAt E3 q).source), sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V) y :=
by
  classical
  have hKp : tsupport φ ⊆ (chartAt E3 p).source := fun x hx => (hφs hx).1
  have hKq : tsupport φ ⊆ (chartAt E3 q).source := fun x hx => (hφs hx).2
  
  have hW : ∀ x ∈ E, x ∈ (chartAt E3 q).source → ∀ i : Fin 3,
      DifferentiableAt ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det *
        calPiece q φ V z i) (chartAt E3 q x) := by
    intro x hxE hxq i
    have hOq : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' E) :=
      (chartAt E3 q).isOpen_inter_preimage_symm hE
    have hy0 : chartAt E3 q x ∈ (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' E := by
      refine ⟨(chartAt E3 q).map_source hxq, ?_⟩
      show (chartAt E3 q).symm (chartAt E3 q x) ∈ E
      rw [(chartAt E3 q).left_inv hxq]
      exact hxE
    have hOqK : (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' E ⊆
        (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' Kᶜ :=
      fun z hz => ⟨hz.1, Set.disjoint_left.mp hEK hz.2⟩
    set w : E3 → E3 := fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 q).symm y) (V ((chartAt E3 q).symm y)) : E3) with hwdef
    have hwO : ContDiffOn ℝ ∞ w ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' E) :=
      (hVs q).mono hOqK
    have hwi : ContDiffOn ℝ ∞ (fun y => w y i)
        ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' E) :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hwO
    have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y a b)
        (chartAt E3 q).target := fun a b => g.smooth q a b
    have hdetpos : ∀ y ∈ (chartAt E3 q).target, 0 < (g.coeff (chartAt E3 q).symm y).det :=
      fun y hy => (coeff_chart_symm_posDef g q y hy).det_pos
    have hdetT : ContDiffOn ℝ ∞ (fun y => (g.coeff (chartAt E3 q).symm y).det)
        (chartAt E3 q).target := by
      have e : (fun y => (g.coeff (chartAt E3 q).symm y).det) = fun y =>
          g.coeff (chartAt E3 q).symm y 0 0 * g.coeff (chartAt E3 q).symm y 1 1 *
            g.coeff (chartAt E3 q).symm y 2 2
          - g.coeff (chartAt E3 q).symm y 0 0 * g.coeff (chartAt E3 q).symm y 1 2 *
            g.coeff (chartAt E3 q).symm y 2 1
          - g.coeff (chartAt E3 q).symm y 0 1 * g.coeff (chartAt E3 q).symm y 1 0 *
            g.coeff (chartAt E3 q).symm y 2 2
          + g.coeff (chartAt E3 q).symm y 0 1 * g.coeff (chartAt E3 q).symm y 1 2 *
            g.coeff (chartAt E3 q).symm y 2 0
          + g.coeff (chartAt E3 q).symm y 0 2 * g.coeff (chartAt E3 q).symm y 1 0 *
            g.coeff (chartAt E3 q).symm y 2 1
          - g.coeff (chartAt E3 q).symm y 0 2 * g.coeff (chartAt E3 q).symm y 1 1 *
            g.coeff (chartAt E3 q).symm y 2 0 := by
        funext y; exact Matrix.det_fin_three _
      rw [e]
      have h := hGs
      exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    have hsqT : ContDiffOn ℝ ∞ (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det)
        (chartAt E3 q).target :=
      hdetT.sqrt (fun y hy => (hdetpos y hy).ne')
    have hφT : ContDiffOn ℝ ∞ (fun y => φ ((chartAt E3 q).symm y)) (chartAt E3 q).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (φ ∘ (chartAt E3 q).symm)
          (chartAt E3 q).target :=
        hφ.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have H := (hsqT.mono Set.inter_subset_left).mul ((hφT.mono Set.inter_subset_left).mul hwi)
    refine ((H.contDiffAt (hOq.mem_nhds hy0)).differentiableAt (by simp)).congr_of_eventuallyEq ?_
    filter_upwards [hOq.mem_nhds hy0] with z hz
    congr 1
    simp only [calPiece]
    rw [Set.indicator_of_mem hz.1, WithLp.ofLp_smul]
    rfl
  
  have zeroOff : ∀ r : M, tsupport φ ⊆ (chartAt E3 r).source →
      ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3), y ∉ chartAt E3 r '' tsupport φ →
        sepDensDiv G (calPiece r φ V) y = 0 := by
    intro r hKr G y hy
    have hKrc : IsCompact (chartAt E3 r '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 r).continuousOn.mono hKr)
    have hz : ∀ z, z ∉ chartAt E3 r '' tsupport φ → calPiece r φ V z = 0 := by
      intro z hz
      unfold calPiece
      by_cases hzt : z ∈ (chartAt E3 r).target
      · rw [Set.indicator_of_mem hzt]
        have h0 : φ ((chartAt E3 r).symm z) = 0 := by
          by_contra h0
          exact hz ⟨_, subset_tsupport _ h0, (chartAt E3 r).right_inv hzt⟩
        simp [h0]
      · exact Set.indicator_of_notMem hzt _
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev : (fun z => Real.sqrt (G z).det * calPiece r φ V z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hKrc.isClosed.isOpen_compl.mem_nhds hy] with z hz'
      rw [hz z hz']
      simp
    unfold partialDeriv
    rw [hev.fderiv_eq]
    simp
  
  have restrict : ∀ r : M, tsupport φ ⊆ (chartAt E3 r).source →
      ∫ y in chartAt E3 r '' (E ∩ (chartAt E3 r).source),
          sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) y =
        ∫ y in chartAt E3 r '' (E ∩ tsupport φ),
          sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) y := by
    intro r hKr
    have hKrc : IsCompact (chartAt E3 r '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 r).continuousOn.mono hKr)
    have hfun : sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) =
        (chartAt E3 r '' tsupport φ).indicator
          (sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V)) := by
      funext y
      by_cases hy : y ∈ chartAt E3 r '' tsupport φ
      · rw [Set.indicator_of_mem hy]
      · rw [Set.indicator_of_notMem hy, zeroOff r hKr _ y hy]
    have hset : chartAt E3 r '' (E ∩ (chartAt E3 r).source) ∩ chartAt E3 r '' tsupport φ =
        chartAt E3 r '' (E ∩ tsupport φ) := by
      rw [← Set.InjOn.image_inter (chartAt E3 r).injOn Set.inter_subset_right hKr]
      congr 1
      ext x
      constructor
      · rintro ⟨⟨hxE, -⟩, hxK⟩
        exact ⟨hxE, hxK⟩
      · rintro ⟨hxE, hxK⟩
        exact ⟨⟨hxE, hKr hxK⟩, hxK⟩
    conv_lhs => rw [hfun]
    rw [MeasureTheory.setIntegral_indicator hKrc.measurableSet, hset]
  
  have hAp_meas : MeasurableSet (chartAt E3 p '' (E ∩ tsupport φ)) := by
    have hKpc : IsCompact (chartAt E3 p '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hKp)
    have hSopen : IsOpen (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) :=
      (chartAt E3 p).isOpen_image_of_subset_source (hE.inter (chartAt E3 p).open_source)
        Set.inter_subset_right
    have h := hSopen.measurableSet.inter hKpc.measurableSet
    rwa [← Set.InjOn.image_inter (chartAt E3 p).injOn Set.inter_subset_right hKp,
      show E ∩ (chartAt E3 p).source ∩ tsupport φ = E ∩ tsupport φ from by
        ext x
        constructor
        · rintro ⟨⟨hxE, -⟩, hxK⟩
          exact ⟨hxE, hxK⟩
        · rintro ⟨hxE, hxK⟩
          exact ⟨⟨hxE, hKp hxK⟩, hxK⟩] at h
  
  set τ : E3 → E3 := fun z => chartAt E3 q ((chartAt E3 p).symm z) with hτdef
  set O : Set E3 := (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source
    with hOdef
  have hOopen : IsOpen O :=
    (chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 q).open_source
  have hApO : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ), y ∈ O := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨(chartAt E3 p).map_source (hKp hx.2), ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 q).source
    rw [(chartAt E3 p).left_inv (hKp hx.2)]
    exact hKq hx.2
  have himg : τ '' (chartAt E3 p '' (E ∩ tsupport φ)) = chartAt E3 q '' (E ∩ tsupport φ) := by
    rw [Set.image_image]
    refine Set.image_congr ?_
    intro x hx
    simp only [τ, (chartAt E3 p).left_inv (hKp hx.2)]
  have hinj : Set.InjOn τ (chartAt E3 p '' (E ∩ tsupport φ)) := by
    rintro _ ⟨x₁, hx₁, rfl⟩ _ ⟨x₂, hx₂, rfl⟩ h
    simp only [τ, (chartAt E3 p).left_inv (hKp hx₁.2),
      (chartAt E3 p).left_inv (hKp hx₂.2)] at h
    rw [(chartAt E3 q).injOn (hKq hx₁.2) (hKq hx₂.2) h]
  have hderiv : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ),
      HasFDerivWithinAt τ (fderiv ℝ τ y) (chartAt E3 p '' (E ∩ tsupport φ)) y := by
    intro y hy
    exact (sep_chart_transition g p q y (hApO y hy).1 (hApO y hy).2).1.hasFDerivAt.hasFDerivWithinAt
  have hcov := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hAp_meas
    hderiv hinj (sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V))
  
  have hτsmooth : ContDiffOn ℝ ∞ τ O := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm) O :=
      (contMDiffOn_chart (x := q)).comp (contMDiffOn_chart_symm.mono Set.inter_subset_left)
        (fun z hz => hz.2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  have detne : ∀ y ∈ O, (fderiv ℝ τ y).det ≠ 0 := by
    intro y hy
    have hτt : τ y ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hy.2
    have hback : (chartAt E3 q).symm (τ y) = (chartAt E3 p).symm y := (chartAt E3 q).left_inv hy.2
    have hσsrc : (chartAt E3 q).symm (τ y) ∈ (chartAt E3 p).source := by
      rw [hback]
      exact (chartAt E3 p).map_target hy.1
    have hσ := (sep_chart_transition g q p (τ y) hτt hσsrc).1
    have hτd : DifferentiableAt ℝ τ y := (sep_chart_transition g p q y hy.1 hy.2).1
    have hev : (fun w => chartAt E3 p ((chartAt E3 q).symm w)) ∘ τ =ᶠ[𝓝 y] id := by
      filter_upwards [hOopen.mem_nhds hy] with z hz
      simp only [Function.comp_apply, id, τ, (chartAt E3 q).left_inv hz.2,
        (chartAt E3 p).right_inv hz.1]
    have hcomp : (fderiv ℝ (fun w => chartAt E3 p ((chartAt E3 q).symm w)) (τ y)).comp
        (fderiv ℝ τ y) = ContinuousLinearMap.id ℝ E3 := by
      rw [← fderiv_comp y hσ hτd, hev.fderiv_eq, fderiv_id]
    have hdet := congrArg (fun L : E3 →L[ℝ] E3 => LinearMap.det (L : E3 →ₗ[ℝ] E3)) hcomp
    simp only [ContinuousLinearMap.coe_comp, LinearMap.det_comp, ContinuousLinearMap.coe_id,
      LinearMap.det_id] at hdet
    exact right_ne_zero_of_mul_eq_one hdet
  
  have vecLaw : ∀ y ∈ O, fderiv ℝ τ y (calPiece p φ V y) = calPiece q φ V (τ y) := by
    intro y hy
    have hxp : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy.1
    have hxq : (chartAt E3 p).symm y ∈ (chartAt E3 q).source := hy.2
    have hτt : τ y ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hy.2
    have hback : (chartAt E3 q).symm (τ y) = (chartAt E3 p).symm y := (chartAt E3 q).left_inv hy.2
    have hcpx : chartAt E3 p ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hy.1
    unfold calPiece
    rw [Set.indicator_of_mem hy.1, Set.indicator_of_mem hτt]
    show _ = (fun z => (φ z • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) z (V z) : E3))
      ((chartAt E3 q).symm (τ y))
    rw [hback]
    simp only [map_smul]
    congr 1
    have hcp : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hxp
    have hτm : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ
        (chartAt E3 p ((chartAt E3 p).symm y)) := by
      rw [hcpx]
      exact (mdifferentiableAt_atlas (chart_mem_atlas E3 q) hxq).comp y
        (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy.1)
    have hev : (chartAt E3 q : M → E3) =ᶠ[𝓝 ((chartAt E3 p).symm y)] τ ∘ chartAt E3 p := by
      filter_upwards [(chartAt E3 p).open_source.mem_nhds hxp] with w hw
      simp only [Function.comp_apply, τ, (chartAt E3 p).left_inv hw]
    have h1 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 p).symm y) =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (τ ∘ chartAt E3 p) ((chartAt E3 p).symm y) :=
      hev.mfderiv_eq
    have h2 := mfderiv_comp ((chartAt E3 p).symm y) hτm hcp
    have h3 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ (chartAt E3 p ((chartAt E3 p).symm y)) =
        fderiv ℝ τ y := by
      rw [hcpx, mfderiv_eq_fderiv]
    rw [h1, h2]
    show (fderiv ℝ τ y) _ = (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ (chartAt E3 p ((chartAt E3 p).symm y)))
      ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y))
        (V ((chartAt E3 p).symm y)))
    rw [h3]
    rfl
  
  have pw : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y =
        |(fderiv ℝ τ y).det| • sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V) (τ y) := by
    intro y hy
    rw [smul_eq_mul]
    obtain ⟨x, hx, rfl⟩ := hy
    have hy' : chartAt E3 p x ∈ chartAt E3 p '' (E ∩ tsupport φ) := ⟨x, hx, rfl⟩
    have hτx : τ (chartAt E3 p x) = chartAt E3 q x := by
      simp only [τ, (chartAt E3 p).left_inv (hKp hx.2)]
    exact sepDensDiv_transition_pointwise O hOopen τ hτsmooth (g.coeff (chartAt E3 p).symm)
      (g.coeff (chartAt E3 q).symm) (calPiece p φ V) (calPiece q φ V)
      (fun z hz i j => (sep_chart_transition g p q z hz.1 hz.2).2.1 i j)
      (fun z hz => (coeff_chart_symm_posDef g q (τ z)
        ((chartAt E3 q).map_source hz.2)).det_pos.le)
      vecLaw _ (hApO _ hy') (detne _ (hApO _ hy'))
      (fun i => by rw [hτx]; exact hW x hx.1 (hKq hx.2) i)
  
  rw [restrict p hKp, restrict q hKq, ← himg, hcov]
  exact MeasureTheory.setIntegral_congr_fun hAp_meas pw

theorem hull_calPiece_div_integral_sum [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E K : Set M) (hE : IsOpen E) (hEK : Disjoint E K) (p : M) {m : ℕ} (ψ : Fin m → M → ℝ) (hψ : ∀ k, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ k)) (hψc : ∀ k, IsCompact (tsupport (ψ k))) (hψs : ∀ k, tsupport (ψ k) ⊆ (chartAt E3 p).source) (V : M → E3) (hVs : ∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3)) ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ)) (hVd : ∀ k, ∃ C : ℝ, ∀ y, y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) → |sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p (ψ k) V) y| ≤ C) : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p (fun x => ∑ k, ψ k x) V) y = ∑ k, ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p (ψ k) V) y :=
by
  classical
  
  have hposdef : ∀ y ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  set T : Set E3 := (chartAt E3 p).target with hTdef
  set S : Set E3 := chartAt E3 p '' (E ∩ (chartAt E3 p).source) with hSdef
  set w : E3 → E3 := fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
      ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3) with hwdef
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 p).symm with hGdef
  have hTo : IsOpen T := (chartAt E3 p).open_target
  
  have hSo : IsOpen S := (chartAt E3 p).isOpen_image_of_subset_source
    (hE.inter (chartAt E3 p).open_source) Set.inter_subset_right
  have hSm : MeasurableSet S := hSo.measurableSet
  have hST : S ⊆ T := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source hx.2
  have hSK : ∀ y ∈ S, (chartAt E3 p).symm y ∉ K := by
    rintro _ ⟨x, hx, rfl⟩
    rw [(chartAt E3 p).left_inv hx.2]
    exact Set.disjoint_left.1 hEK hx.1
  have hSKc : ∀ y ∈ S, y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) := by
    intro y hy hyK
    obtain ⟨x', hx', rfl⟩ := hyK
    apply hSK _ hy
    rw [(chartAt E3 p).left_inv hx'.2]
    exact hx'.1
  have hwS : ContDiffOn ℝ ∞ w S :=
    (hVs p).mono (fun y hy => ⟨hST hy, hSK y hy⟩)
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T := fun i j => g.smooth p i j
  have hdetpos : ∀ y ∈ T, 0 < (G y).det := fun y hy =>
    (hposdef y hy).det_pos
  have hdetT : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
    have e : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1
        - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
        + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y; exact Matrix.det_fin_three _
    rw [e]
    have h := hGs
    exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
      (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
      (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
  have hsqT : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T :=
    hdetT.sqrt (fun y hy => (hdetpos y hy).ne')
  have hwi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun y => w y i) S := by
    intro i
    exact (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hwS
  have hψT : ∀ k, ContDiffOn ℝ ∞ (fun y => ψ k ((chartAt E3 p).symm y)) T := by
    intro k
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ k ∘ (chartAt E3 p).symm)
        (chartAt E3 p).target :=
      (hψ k).comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp h1
  
  have hcp : ∀ (φ : M → ℝ) (z : E3) (i : Fin 3),
      calPiece p φ V z i = T.indicator (fun y => φ ((chartAt E3 p).symm y) * w y i) z := by
    intro φ z i
    by_cases hz : z ∈ T
    · rw [Set.indicator_of_mem hz]
      simp only [calPiece]
      rw [Set.indicator_of_mem hz]
      rw [WithLp.ofLp_smul]
      rfl
    · rw [Set.indicator_of_notMem hz]
      simp only [calPiece]
      rw [Set.indicator_of_notMem hz]
      simp
  
  have hKc : ∀ k, IsCompact ((chartAt E3 p) '' tsupport (ψ k)) := fun k =>
    (hψc k).image_of_continuousOn ((chartAt E3 p).continuousOn.mono (hψs k))
  have hvan : ∀ k (y : E3) (i : Fin 3), y ∉ (chartAt E3 p) '' tsupport (ψ k) →
      T.indicator (fun y => ψ k ((chartAt E3 p).symm y) * w y i) y = 0 := by
    intro k y i hy
    by_cases hyT : y ∈ T
    · rw [Set.indicator_of_mem hyT]
      have h0 : ψ k ((chartAt E3 p).symm y) = 0 := by
        apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hy ⟨_, hmem, (chartAt E3 p).right_inv hyT⟩
      rw [h0, zero_mul]
    · exact Set.indicator_of_notMem hyT _
  
  obtain ⟨F, hFdef⟩ : ∃ F : Fin m → Fin 3 → E3 → ℝ, ∀ k i z, F k i z =
      Real.sqrt (G z).det * T.indicator (fun y => ψ k ((chartAt E3 p).symm y) * w y i) z :=
    ⟨_, fun _ _ _ => rfl⟩
  have hF : ∀ k (i : Fin 3) (z : E3), z ∈ S → DifferentiableAt ℝ (F k i) z := by
    intro k i z hz
    have hH : ContDiffOn ℝ ∞
        (fun y => Real.sqrt (G y).det * (ψ k ((chartAt E3 p).symm y) * w y i)) S :=
      (hsqT.mono hST).mul (((hψT k).mono hST).mul (hwi i))
    refine ((hH.contDiffAt (hSo.mem_nhds hz)).differentiableAt (by simp)).congr_of_eventuallyEq ?_
    filter_upwards [hSo.mem_nhds hz] with y hy
    rw [hFdef, Set.indicator_of_mem (hST hy)]
  have hk_pt : ∀ k (i : Fin 3),
      (fun z => Real.sqrt (G z).det * calPiece p (ψ k) V z i) = F k i := by
    intro k i; funext z; rw [hFdef, hcp]
  have hsum_pt : ∀ i : Fin 3,
      (fun z => Real.sqrt (G z).det * calPiece p (fun x => ∑ k, ψ k x) V z i)
        = fun z => ∑ k, F k i z := by
    intro i; funext z
    simp only [hFdef]
    rw [hcp, ← Finset.mul_sum]
    congr 1
    by_cases hz : z ∈ T
    · simp only [Set.indicator_of_mem hz, Finset.sum_mul]
    · simp only [Set.indicator_of_notMem hz, Finset.sum_const_zero]
  have hdiv_k : ∀ k, sepDensDiv G (calPiece p (ψ k) V) =
      fun y => ∑ i : Fin 3, partialDeriv i (F k i) y := by
    intro k; funext y
    unfold sepDensDiv
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hk_pt k i]
  have hdiv : ∀ y ∈ S, sepDensDiv G (calPiece p (fun x => ∑ k, ψ k x) V) y =
      ∑ k, sepDensDiv G (calPiece p (ψ k) V) y := by
    intro y hy
    simp only [hdiv_k]
    unfold sepDensDiv
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hsum_pt i]
    unfold partialDeriv
    have hfs : (fun z => ∑ k, F k i z) = ∑ k, F k i := by
      funext z; rw [Finset.sum_apply]
    rw [hfs, fderiv_sum (fun k _ => hF k i y hy)]
    rw [ContinuousLinearMap.sum_apply]
  
  have hint : ∀ k, Integrable (sepDensDiv G (calPiece p (ψ k) V)) (volume.restrict S) := by
    intro k
    obtain ⟨C, hC⟩ := hVd k
    have hmeas : Measurable (sepDensDiv G (calPiece p (ψ k) V)) := by
      rw [hdiv_k k]
      refine Finset.measurable_sum _ (fun i _ => ?_)
      exact measurable_fderiv_apply_const ℝ (F k i) (e i)
    have hzero : ∀ y, y ∉ (chartAt E3 p) '' tsupport (ψ k) →
        sepDensDiv G (calPiece p (ψ k) V) y = 0 := by
      intro y hy
      rw [hdiv_k k]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have hev : F k i =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [(hKc k).isClosed.isOpen_compl.mem_nhds hy] with z hz
        rw [hFdef, hvan k z i hz, mul_zero]
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    have hQm : MeasurableSet ((chartAt E3 p) '' tsupport (ψ k)) := (hKc k).isClosed.measurableSet
    have h1 : IntegrableOn (sepDensDiv G (calPiece p (ψ k) V))
        (S ∩ (chartAt E3 p) '' tsupport (ψ k)) volume := by
      refine Measure.integrableOn_of_bounded (M := C) ?_ hmeas.aestronglyMeasurable ?_
      · exact (lt_of_le_of_lt (measure_mono Set.inter_subset_right)
          (hKc k).measure_lt_top).ne
      · refine ae_restrict_of_forall_mem (hSm.inter hQm) (fun y hy => ?_)
        rw [Real.norm_eq_abs]
        exact hC y (hSKc y hy.1)
    exact h1.of_forall_diff_eq_zero hSm (fun y hy => hzero y (fun hyQ => hy.2 ⟨hy.1, hyQ⟩))
  rw [setIntegral_congr_fun hSm hdiv]
  exact integral_finset_sum _ (fun k _ => hint k)

theorem hull_jump_lower_bound [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (E Ω K : Set M) (hE : IsOpen E) (hK : IsClosed K)
    (hKi : interior K = ∅) (hEK : Disjoint E K) (hΩ : IsOpen Ω) {n : ℕ} (q : Fin n → M)
    (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (V : M → E3)
    (hVs : ∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
      ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Kᶜ))
    (hVd : ∀ (p : M) (ψ : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ → IsCompact (tsupport ψ) →
      tsupport ψ ⊆ (chartAt E3 p).source → ∃ C : ℝ, ∀ y,
        y ∉ chartAt E3 p '' (K ∩ (chartAt E3 p).source) →
        |sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y| ≤ C)
    (hV1 : ∀ x, g.g x (V x) (V x) ≤ 1) :
    ENNReal.ofReal (calDivSum g q φ E V) ≤ hullRiemPer g E Ω K :=
by
  classical
  obtain ⟨I, hI⟩ : ∃ I : M → (M → ℝ) → ℝ, I = fun p ψ =>
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y := ⟨_, rfl⟩
  suffices H : ∀ (n : ℕ) (Ω : Set M), IsOpen Ω → ∀ (q : Fin n → M) (φ : Fin n → M → ℝ),
      calPartition q φ Ω → ENNReal.ofReal (calDivSum g q φ E V) ≤ hullRiemPer g E Ω K from
    H n Ω hΩ q φ hφ
  intro n
  induction n with
  | zero =>
    intro Ω _ q φ _
    simp [calDivSum]
  | succ n ih =>
    intro Ω hΩ q φ hφ
    obtain ⟨hsm, hnn, hsum, hsupp⟩ := hφ
    by_cases hPtop : hullRiemPer g E Ω K = ⊤
    · rw [hPtop]; exact le_top
    
    have hmono : ∀ U : Set M, U ⊆ Ω → hullRiemPer g E U K ≤ hullRiemPer g E Ω K := by
      intro U hU
      have h := hullRiemPer_disjoint_sum_le g E Ω K (fun _ : Fin 1 => U) (fun _ => hU)
        (fun i j hij => absurd (Subsingleton.elim i j) hij)
      simpa using h
    have hfin : ∀ U : Set M, U ⊆ Ω → hullRiemPer g E U K ≠ ⊤ := fun U hU =>
      ne_top_of_le_ne_top hPtop (hmono U hU)
    have hconv : ∀ (U : Set M), U ⊆ Ω → ∀ (x c : ℝ), 0 ≤ c →
        ENNReal.ofReal x ≤ ENNReal.ofReal c * hullRiemPer g E U K →
        x ≤ c * (hullRiemPer g E U K).toReal := by
      intro U hU x c hc h
      have h2 := (ENNReal.ofReal_le_iff_le_toReal
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hfin U hU))).1 h
      rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hc] at h2
    have hpv0 : 0 ≤ (hullRiemPer g E Ω K).toReal := ENNReal.toReal_nonneg
    
    have hφ1 : ∀ j x, φ j x ≤ 1 := fun j x =>
      le_trans (Finset.single_le_sum (fun k _ => hnn k x) (Finset.mem_univ j)) (hsum x)
    have hφ0src : ∀ x, φ 0 x ≠ 0 → x ∈ Ω ∩ (chartAt E3 (q 0)).source := fun x hx =>
      (hsupp 0).2 (subset_tsupport _ hx)
    have hprod : ∀ (w : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
        (∀ x, 0 ≤ w x ∧ w x ≤ 1) → ∀ j,
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => w x * φ j x) ∧
        IsCompact (tsupport (fun x => w x * φ j x)) ∧
        tsupport (fun x => w x * φ j x) ⊆ tsupport w ∩ (Ω ∩ (chartAt E3 (q j)).source) ∧
        (∀ x, |w x * φ j x| ≤ 1) ∧ (∀ x, 0 ≤ w x * φ j x) := by
      intro w hw hw01 j
      refine ⟨hw.mul (hsm j),
        (hsupp j).1.of_isClosed_subset (isClosed_tsupport _) (tsupport_mul_subset_right),
        fun x hx => ⟨tsupport_mul_subset_left hx, (hsupp j).2 (tsupport_mul_subset_right hx)⟩,
        fun x => ?_, fun x => mul_nonneg (hw01 x).1 (hnn j x)⟩
      rw [abs_of_nonneg (mul_nonneg (hw01 x).1 (hnn j x))]
      exact mul_le_one₀ (hw01 x).2 (hnn j x) (hφ1 j x)
    have hΛeq : calDivSum g q φ E V = ∑ j, I (q j) (φ j) := by subst hI; rfl
    
    have hstar : ∀ N : ℕ, 0 < N → ∀ u : ℝ, 0 < u →
        calDivSum g q φ E V ≤ (hullRiemPer g E Ω K).toReal +
          8 * N * u * (hullRiemPer g E Ω K).toReal
          + (n + 1) * (hullRiemPer g E Ω K).toReal / N := by
      intro N hN u hu
      have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
      
      have hBsub : ∀ i : Fin N, Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
          φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u} ⊆ Ω := fun i => Set.inter_subset_left
      have hBdisj : Pairwise (fun i j : Fin N =>
          Disjoint (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u})
          (Ω ∩ {x | u * (8 * ((j : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((j : ℕ) : ℝ) + 4) + 2 * u})) := by
        intro i j hij
        rw [Set.disjoint_left]
        rintro x ⟨-, h1, h2⟩ ⟨-, h3, h4⟩
        have hne : (i : ℕ) ≠ (j : ℕ) := fun h => hij (Fin.ext h)
        rcases Nat.lt_or_gt_of_ne hne with h | h
        · have h' : ((i : ℕ) : ℝ) + 1 ≤ ((j : ℕ) : ℝ) := by exact_mod_cast h
          nlinarith [mul_le_mul_of_nonneg_left h' hu.le]
        · have h' : ((j : ℕ) : ℝ) + 1 ≤ ((i : ℕ) : ℝ) := by exact_mod_cast h
          nlinarith [mul_le_mul_of_nonneg_left h' hu.le]
      have hBsum := hullRiemPer_disjoint_sum_le g E Ω K _ hBsub hBdisj
      have hBreal : ∑ i : Fin N, (hullRiemPer g E (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u
          < φ 0 x ∧ φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u}) K).toReal ≤
          (hullRiemPer g E Ω K).toReal := by
        rw [← ENNReal.toReal_sum (fun i _ => hfin _ (hBsub i))]
        exact ENNReal.toReal_mono hPtop hBsum
      obtain ⟨i, -, hi⟩ : ∃ i ∈ (Finset.univ : Finset (Fin N)),
          (hullRiemPer g E (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u}) K).toReal
            ≤ (hullRiemPer g E Ω K).toReal / N := by
        refine Finset.exists_le_of_sum_le ⟨⟨0, hN⟩, Finset.mem_univ _⟩ ?_
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          mul_div_cancel₀ _ hNpos.ne']
        exact hBreal
      set t : ℝ := u * (8 * ((i : ℕ) : ℝ) + 4) with ht
      set B : Set M := Ω ∩ {x | t - 2 * u < φ 0 x ∧ φ 0 x < t + 2 * u} with hB
      have hi' : (hullRiemPer g E B K).toReal ≤ (hullRiemPer g E Ω K).toReal / N := hi
      have hBsub' : B ⊆ Ω := Set.inter_subset_left
      have hBopen : IsOpen B := hΩ.inter
        ((isOpen_lt continuous_const (hsm 0).continuous).inter
          (isOpen_lt (hsm 0).continuous continuous_const))
      have ht0 : 0 < t := by positivity
      have htle : t ≤ 8 * N * u := by
        have hiN : ((i : ℕ) : ℝ) + 1 ≤ (N : ℝ) := by exact_mod_cast i.isLt
        nlinarith [mul_le_mul_of_nonneg_left hiN hu.le]
      
      obtain ⟨a, b, γ, ha, hb, hγ, h01, hsa, hsb, hsγ⟩ := calCut_functions (φ 0) (hsm 0) t u hu
      have h01a : ∀ x, 0 ≤ a x ∧ a x ≤ 1 := fun x => ⟨(h01 x).1, (h01 x).2.1⟩
      have h01b : ∀ x, 0 ≤ b x ∧ b x ≤ 1 := fun x => ⟨(h01 x).2.2.1, (h01 x).2.2.2.1⟩
      have h01γ : ∀ x, 0 ≤ γ x ∧ γ x ≤ 1 := fun x => ⟨(h01 x).2.2.2.2.1, (h01 x).2.2.2.2.2.1⟩
      have hsum3 : ∀ x, a x + γ x + b x = 1 := fun x => (h01 x).2.2.2.2.2.2
      have hPa := hprod a ha h01a
      have hPb := hprod b hb h01b
      have hPγ := hprod γ hγ h01γ
      have hta' : tsupport a ⊆ tsupport (φ 0) := fun x hx =>
        subset_tsupport _ (ht0.trans (hsa hx)).ne'
      have hta : tsupport a ⊆ Ω ∩ (chartAt E3 (q 0)).source := fun x hx =>
        hφ0src x (ht0.trans (hsa hx)).ne'
      set Ωa : Set M := Ω ∩ {x | t < φ 0 x} with hΩadef
      set Ωb : Set M := Ω ∩ {x | φ 0 x < t} with hΩbdef
      have hΩa : IsOpen Ωa := hΩ.inter (isOpen_lt continuous_const (hsm 0).continuous)
      have hΩb : IsOpen Ωb := hΩ.inter (isOpen_lt (hsm 0).continuous continuous_const)
      have hΩasub : Ωa ⊆ Ω := Set.inter_subset_left
      have hΩbsub : Ωb ⊆ Ω := Set.inter_subset_left
      have hdab : Disjoint Ωa Ωb := Set.disjoint_left.2 fun x h1 h2 =>
        lt_asymm (show t < φ 0 x from h1.2) (show φ 0 x < t from h2.2)
      
      have hsplit : ∀ j, I (q j) (φ j) = I (q j) (fun x => a x * φ j x) +
          I (q j) (fun x => γ x * φ j x) + I (q j) (fun x => b x * φ j x) := by
        intro j
        have hw : ∀ k : Fin 3, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (![a, γ, b] k) ∧
            ∀ x, 0 ≤ ![a, γ, b] k x ∧ ![a, γ, b] k x ≤ 1 := by
          intro k
          fin_cases k
          · exact ⟨ha, h01a⟩
          · exact ⟨hγ, h01γ⟩
          · exact ⟨hb, h01b⟩
        have h : I (q j) (fun x => ∑ k : Fin 3, ![a, γ, b] k x * φ j x) =
            ∑ k : Fin 3, I (q j) (fun x => ![a, γ, b] k x * φ j x) := by
          subst hI
          exact hull_calPiece_div_integral_sum g E K hE hEK (q j)
            (fun k x => ![a, γ, b] k x * φ j x)
            (fun k => (hprod _ (hw k).1 (hw k).2 j).1)
            (fun k => (hprod _ (hw k).1 (hw k).2 j).2.1)
            (fun k x hx => ((hprod _ (hw k).1 (hw k).2 j).2.2.1 hx).2.2) V hVs
            (fun k => hVd (q j) _ (hprod _ (hw k).1 (hw k).2 j).1
              (hprod _ (hw k).1 (hw k).2 j).2.1
              (fun x hx => ((hprod _ (hw k).1 (hw k).2 j).2.2.1 hx).2.2))
        have hfun : (fun x => ∑ k : Fin 3, ![a, γ, b] k x * φ j x) = φ j := by
          funext x
          simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
            Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons]
          linear_combination (φ j x) * hsum3 x
        rw [hfun, Fin.sum_univ_three] at h
        simpa only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          Matrix.cons_val_two, Matrix.tail_cons] using h
      
      have hAj : ∀ j, I (q j) (fun x => a x * φ j x) = I (q 0) (fun x => a x * φ j x) := by
        intro j
        subst hI
        exact hull_calPiece_div_integral_chart_eq g K (q j) (q 0) _ (hPa j).1 (hPa j).2.1
          (fun x hx => ⟨((hPa j).2.2.1 hx).2.2, (hta ((hPa j).2.2.1 hx).1).2⟩) V hVs E hE hEK
      have hAsum : I (q 0) (fun x => ∑ j, a x * φ j x) =
          ∑ j, I (q 0) (fun x => a x * φ j x) := by
        subst hI
        exact hull_calPiece_div_integral_sum g E K hE hEK (q 0) (fun j x => a x * φ j x)
          (fun j => (hPa j).1) (fun j => (hPa j).2.1)
          (fun j x hx => (hta ((hPa j).2.2.1 hx).1).2) V hVs
          (fun j => hVd (q 0) _ (hPa j).1 (hPa j).2.1
            (fun x hx => (hta ((hPa j).2.2.1 hx).1).2))
      have hψa_eq : (fun x => ∑ j, a x * φ j x) = fun x => a x * ∑ j, φ j x := by
        funext x; rw [Finset.mul_sum]
      have hψa_sm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => ∑ j, a x * φ j x) := by
        rw [hψa_eq]; exact ha.mul (contMDiff_finset_sum fun j _ => hsm j)
      have hψa_ts : tsupport (fun x => ∑ j, a x * φ j x) ⊆ tsupport a := by
        rw [hψa_eq]; exact tsupport_mul_subset_left
      have hψa_b : ∀ x, |∑ j, a x * φ j x| ≤ 1 := by
        intro x
        have e := congrFun hψa_eq x
        simp only at e
        have hs0 : 0 ≤ ∑ j, φ j x := Finset.sum_nonneg fun j _ => hnn j x
        rw [e, abs_of_nonneg (mul_nonneg (h01a x).1 hs0)]
        exact mul_le_one₀ (h01a x).2 hs0 (hsum x)
      have hA := hull_calPiece_div_le g E Ωa K hE hK hKi hEK hΩa (q 0)
        (fun x => ∑ j, a x * φ j x) hψa_sm
        ((hsupp 0).1.of_isClosed_subset (isClosed_tsupport _) (hψa_ts.trans hta'))
        (fun x hx => ⟨⟨(hta (hψa_ts hx)).1, hsa (hψa_ts hx)⟩, (hta (hψa_ts hx)).2⟩) 1 one_pos
        hψa_b V hVs hVd hV1
      have hAR : I (q 0) (fun x => ∑ j, a x * φ j x) ≤ 1 * (hullRiemPer g E Ωa K).toReal :=
        hconv Ωa hΩasub _ 1 zero_le_one (by subst hI; exact hA)
      
      have hΓj : ∀ j, I (q j) (fun x => γ x * φ j x) ≤ (hullRiemPer g E B K).toReal := by
        intro j
        have h := hull_calPiece_div_le g E B K hE hK hKi hEK hBopen (q j)
          (fun x => γ x * φ j x) (hPγ j).1 (hPγ j).2.1
          (fun x hx => ⟨⟨((hPγ j).2.2.1 hx).2.1, hsγ ((hPγ j).2.2.1 hx).1⟩,
            ((hPγ j).2.2.1 hx).2.2⟩) 1 one_pos (hPγ j).2.2.2.1 V hVs hVd hV1
        have h2 : I (q j) (fun x => γ x * φ j x) ≤ 1 * (hullRiemPer g E B K).toReal :=
          hconv B hBsub' _ 1 zero_le_one (by subst hI; exact h)
        linarith
      have hγsum : ∑ j, I (q j) (fun x => γ x * φ j x) ≤
          (n + 1) * (hullRiemPer g E B K).toReal := by
        calc _ ≤ ∑ _j : Fin (n + 1), (hullRiemPer g E B K).toReal :=
              Finset.sum_le_sum fun j _ => hΓj j
          _ = _ := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
              push_cast; ring
      
      have hbφ0 : ∀ x, |b x * φ 0 x| ≤ t := by
        intro x
        rw [abs_of_nonneg (mul_nonneg (h01b x).1 (hnn 0 x))]
        by_cases hbx : b x = 0
        · rw [hbx, zero_mul]; exact ht0.le
        · have h1 : φ 0 x < t := hsb (subset_tsupport _ hbx)
          have h2 : b x * φ 0 x ≤ φ 0 x := mul_le_of_le_one_left (hnn 0 x) (h01b x).2
          linarith
      have hHead := hull_calPiece_div_le g E Ωb K hE hK hKi hEK hΩb (q 0)
        (fun x => b x * φ 0 x) (hPb 0).1 (hPb 0).2.1
        (fun x hx => ⟨⟨((hPb 0).2.2.1 hx).2.1, hsb ((hPb 0).2.2.1 hx).1⟩,
          ((hPb 0).2.2.1 hx).2.2⟩) t ht0 hbφ0 V hVs hVd hV1
      have hHeadR : I (q 0) (fun x => b x * φ 0 x) ≤ t * (hullRiemPer g E Ωb K).toReal :=
        hconv Ωb hΩbsub _ t ht0.le (by subst hI; exact hHead)
      have hpart' : calPartition (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) Ωb := by
        refine ⟨fun j => (hPb j.succ).1, fun j x => (hPb j.succ).2.2.2.2 x, fun x => ?_,
          fun j => ⟨(hPb j.succ).2.1, fun y hy => ⟨⟨((hPb j.succ).2.2.1 hy).2.1,
            hsb ((hPb j.succ).2.2.1 hy).1⟩, ((hPb j.succ).2.2.1 hy).2.2⟩⟩⟩
        have e : ∑ j : Fin n, b x * φ j.succ x = b x * ∑ j : Fin n, φ j.succ x := by
          rw [Finset.mul_sum]
        have hs := hsum x
        rw [Fin.sum_univ_succ] at hs
        have hnn' : 0 ≤ ∑ j : Fin n, φ j.succ x := Finset.sum_nonneg fun j _ => hnn _ x
        have h2 : b x * ∑ j : Fin n, φ j.succ x ≤ ∑ j : Fin n, φ j.succ x :=
          mul_le_of_le_one_left hnn' (h01b x).2
        rw [e]
        linarith [hnn 0 x]
      have hTail := ih Ωb hΩb _ _ hpart'
      have hTailR : calDivSum g (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) E V ≤
          (hullRiemPer g E Ωb K).toReal :=
        (ENNReal.ofReal_le_iff_le_toReal (hfin Ωb hΩbsub)).1 hTail
      have hbsplit : ∑ j, I (q j) (fun x => b x * φ j x) = I (q 0) (fun x => b x * φ 0 x) +
          calDivSum g (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) E V := by
        rw [Fin.sum_univ_succ]
        congr 1
        subst hI
        rfl
      have hasum : ∑ j, I (q j) (fun x => a x * φ j x) =
          I (q 0) (fun x => ∑ j, a x * φ j x) := by
        rw [hAsum]; exact Finset.sum_congr rfl fun j _ => hAj j
      
      have hab := hullRiemPer_disjoint_sum_le g E Ω K ![Ωa, Ωb]
        (by
          intro k
          fin_cases k
          · exact hΩasub
          · exact hΩbsub)
        (by
          intro k l hkl
          fin_cases k <;> fin_cases l
          · exact absurd rfl hkl
          · exact hdab
          · exact hdab.symm
          · exact absurd rfl hkl)
      rw [Fin.sum_univ_two] at hab
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hab
      have habR := ENNReal.toReal_mono hPtop hab
      rw [ENNReal.toReal_add (hfin _ hΩasub) (hfin _ hΩbsub)] at habR
      have hpa0 : 0 ≤ (hullRiemPer g E Ωa K).toReal := ENNReal.toReal_nonneg
      have hpb0 : 0 ≤ (hullRiemPer g E Ωb K).toReal := ENNReal.toReal_nonneg
      have hpB0 : 0 ≤ (hullRiemPer g E B K).toReal := ENNReal.toReal_nonneg
      have hT1 : t * (hullRiemPer g E Ωb K).toReal ≤
          8 * N * u * (hullRiemPer g E Ω K).toReal :=
        mul_le_mul htle (by linarith) hpb0 (by positivity)
      have hT2 : (n + 1) * (hullRiemPer g E B K).toReal ≤
          (n + 1) * (hullRiemPer g E Ω K).toReal / N := by
        rw [mul_div_assoc]
        exact mul_le_mul_of_nonneg_left hi' (by positivity)
      rw [hΛeq, Finset.sum_congr rfl fun j _ => hsplit j, Finset.sum_add_distrib,
        Finset.sum_add_distrib, hasum, hbsplit]
      linarith
    
    have hΛ : calDivSum g q φ E V ≤ (hullRiemPer g E Ω K).toReal := by
      refine le_of_forall_pos_le_add fun ε hε => ?_
      obtain ⟨N, hN⟩ := exists_nat_gt (2 * (n + 1) * (hullRiemPer g E Ω K).toReal / ε)
      have hNpos' : (0 : ℝ) < N := lt_of_le_of_lt (by positivity) hN
      have hNpos : 0 < N := by exact_mod_cast hNpos'
      have h1 := hstar N hNpos (ε / (16 * N * ((hullRiemPer g E Ω K).toReal + 1)))
        (by positivity)
      have e1 : 8 * (N : ℝ) * (ε / (16 * N * ((hullRiemPer g E Ω K).toReal + 1))) *
          (hullRiemPer g E Ω K).toReal =
          ε / 2 * ((hullRiemPer g E Ω K).toReal / ((hullRiemPer g E Ω K).toReal + 1)) := by
        field_simp
        ring
      have e2 : (hullRiemPer g E Ω K).toReal / ((hullRiemPer g E Ω K).toReal + 1) ≤ 1 := by
        rw [div_le_one (by positivity)]; linarith
      have e4 : ε / 2 * ((hullRiemPer g E Ω K).toReal / ((hullRiemPer g E Ω K).toReal + 1))
          ≤ ε / 2 :=
        mul_le_of_le_one_right (by positivity) e2
      have e3 : (n + 1) * (hullRiemPer g E Ω K).toReal / N ≤ ε / 2 := by
        rw [div_le_iff₀ hNpos']
        rw [div_lt_iff₀ hε] at hN
        linarith
      rw [e1] at h1
      linarith
    exact (ENNReal.ofReal_le_ofReal hΛ).trans (ENNReal.ofReal_toReal hPtop).le

theorem chart_unit_normal_calculus [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (D : Set M) (w : M → ℝ) (hD : IsOpen D) (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w D) (hdw : ∀ x ∈ D, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) (p : M) : ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 p).symm y)) ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' D) ∧ ∀ x ∈ D ∩ (chartAt E3 p).source, 0 < ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ a b * partialDeriv a (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) * partialDeriv b (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) ∧ g.levelMeanCurv w x = levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) ∧ (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) x ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal (g.coeff (chartAt E3 x).symm) (fun y => w ((chartAt E3 x).symm y)) (chartAt E3 x x) i)) : E3) = (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) i) ∧ g.g x ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal (g.coeff (chartAt E3 x).symm) (fun y => w ((chartAt E3 x).symm y)) (chartAt E3 x x) i)) ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal (g.coeff (chartAt E3 x).symm) (fun y => w ((chartAt E3 x).symm y)) (chartAt E3 x x) i)) = 1 :=
by
  classical
  
  have riesz : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ),
      (∀ v : E3, v ≠ 0 → 0 < B v v) → ∀ (ℓ : E3 →L[ℝ] ℝ), ∃ v : E3, ∀ u : E3, B v u = ℓ u := by
    intro B hpos ℓ
    let Dl := InnerProductSpace.toDual ℝ E3
    let T : E3 →ₗ[ℝ] E3 :=
      { toFun := fun v => Dl.symm (B v)
        map_add' := fun v u => by simp
        map_smul' := fun c v => by simp }
    have hinj : Function.Injective T := by
      intro v u hvu
      have h1 : B v = B u := by
        have := congrArg Dl hvu
        simpa [T] using this
      by_contra hne
      have h2 := hpos (v - u) (sub_ne_zero.mpr hne)
      have h3 : B (v - u) = 0 := by rw [map_sub, h1, sub_self]
      rw [h3] at h2
      simp at h2
    have hsurj := LinearMap.injective_iff_surjective.mp hinj
    obtain ⟨v, hv⟩ := hsurj (Dl.symm ℓ)
    refine ⟨v, fun u => ?_⟩
    have h1 : B v = ℓ := by
      have := congrArg Dl hv
      simpa [T] using this
    rw [h1]
  
  have grad_rep : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ (N : E3),
      MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w ((chartAt E3 q).symm y) →
      (∀ v : E3, g.g ((chartAt E3 q).symm y) N v =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w ((chartAt E3 q).symm y) v : ℝ)) →
      ∀ u : E3, u = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) N →
      (∀ i : Fin 3, u i =
        ∑ k : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i k *
          partialDeriv k (fun z => w ((chartAt E3 q).symm z)) y) ∧
      g.g ((chartAt E3 q).symm y) N N =
        ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ a b *
          partialDeriv a (fun z => w ((chartAt E3 q).symm z)) y *
          partialDeriv b (fun z => w ((chartAt E3 q).symm z)) y := by
    intro q y hy N hρd hN u hu
    have hx : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hx
    have hinv : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y v) = v := by
      have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
      have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
        apply Filter.EventuallyEq.mfderiv_eq
        filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
        exact hz
      rw [mfderiv_id] at hid
      intro v
      have h1 := congrArg (fun L => L v) (hcomp.symm.trans hid)
      simpa using h1
    obtain ⟨K, hK⟩ : ∃ K : E3 →L[ℝ] E3,
        K = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) := ⟨_, rfl⟩
    obtain ⟨L, hL⟩ : ∃ L : E3 →L[ℝ] E3,
        L = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y := ⟨_, rfl⟩
    have hKL : ∀ v, K (L v) = v := by intro v; rw [hK, hL]; exact hinv v
    have hKinj : Function.Injective K := by
      have hsurj : Function.Surjective (K : E3 →ₗ[ℝ] E3) := fun v => ⟨L v, hKL v⟩
      exact LinearMap.injective_iff_surjective.mpr hsurj
    have hLK : ∀ v, L (K v) = v := fun v => hKinj (hKL (K v))
    have hchain : ∀ b : Fin 3, partialDeriv b (fun z => w ((chartAt E3 q).symm z)) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w ((chartAt E3 q).symm y) (L (e b)) := by
      intro b
      have h1 := mfderiv_comp y hρd hf
      rw [mfderiv_eq_fderiv] at h1
      unfold partialDeriv
      rw [show (fun z => w ((chartAt E3 q).symm z)) = w ∘ (chartAt E3 q).symm from rfl, h1, hL]
      rfl
    have hw' : L u = N := by rw [hu, ← hK]; exact hLK _
    have hexp : u = ∑ a : Fin 3, u a • e a := by
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, e, EuclideanSpace.single_apply]
    have h1 : ∀ b : Fin 3, g.g ((chartAt E3 q).symm y) (L u) (L (e b)) =
        ∑ a : Fin 3, u a * g.coeff (chartAt E3 q).symm y a b := by
      intro b
      conv_lhs => rw [hexp]
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul, RiemannianMetric3.coeff, coeffMatrix, hL]
      rfl
    have hsys : ∀ b : Fin 3, ∑ a : Fin 3, u a * g.coeff (chartAt E3 q).symm y a b =
        partialDeriv b (fun z => w ((chartAt E3 q).symm z)) y := by
      intro b
      rw [← h1 b, hw', hN, hchain b]
    have hmv : (g.coeff (chartAt E3 q).symm y).mulVec (fun a => u a) =
        fun b => partialDeriv b (fun z => w ((chartAt E3 q).symm z)) y := by
      funext b
      rw [← hsys b]
      simp only [Matrix.mulVec, dotProduct]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      have hs : g.coeff (chartAt E3 q).symm y b a = g.coeff (chartAt E3 q).symm y a b := by
        simp only [RiemannianMetric3.coeff, coeffMatrix]
        exact g.symm _ _ _
      rw [hs]
      ring
    have hdet : IsUnit (g.coeff (chartAt E3 q).symm y).det :=
      isUnit_iff_ne_zero.mpr (coeff_chart_symm_posDef g q y hy).det_pos.ne'
    have hsol : (fun a => u a) = ((g.coeff (chartAt E3 q).symm y)⁻¹).mulVec
        (fun b => partialDeriv b (fun z => w ((chartAt E3 q).symm z)) y) := by
      have h2 := congrArg (fun v => ((g.coeff (chartAt E3 q).symm y)⁻¹).mulVec v) hmv
      simp only [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hdet, Matrix.one_mulVec] at h2
      exact h2
    have hcomp : ∀ i : Fin 3, u i = ∑ k : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i k *
        partialDeriv k (fun z => w ((chartAt E3 q).symm z)) y := by
      intro i
      have h2 := congrFun hsol i
      simpa [Matrix.mulVec, dotProduct] using h2
    refine ⟨hcomp, ?_⟩
    have h3 : ∀ c : E3 →L[ℝ] ℝ, c (L u) = ∑ b : Fin 3, u b * c (L (e b)) := by
      intro c
      conv_lhs => rw [hexp]
      simp only [map_sum, map_smul, smul_eq_mul]
    rw [← hw', h3 (g.g _ (L u))]
    simp only [h1, hsys]
    simp only [hcomp, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    ring
  
  have hcl1 : ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 p).symm y))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' D) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w ∘ (chartAt E3 p).symm)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' D) :=
      hws.comp (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun y hy => hy.2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  refine ⟨hcl1, fun x hx => ?_⟩
  obtain ⟨hxD, hxp⟩ := hx
  have hwx : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x :=
    (hws.contMDiffAt (hD.mem_nhds hxD)).mdifferentiableAt (by simp)
  obtain ⟨N, hN⟩ := riesz (g.g x) (g.posDef x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x : E3 →L[ℝ] ℝ)
  have hrep : ∀ q : M, x ∈ (chartAt E3 q).source →
      ∀ u : E3, u = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) x N →
      (∀ i : Fin 3, u i =
        ∑ k : Fin 3, (g.coeff (chartAt E3 q).symm (chartAt E3 q x))⁻¹ i k *
          partialDeriv k (fun z => w ((chartAt E3 q).symm z)) (chartAt E3 q x)) ∧
      g.g x N N = ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 q).symm (chartAt E3 q x))⁻¹ a b *
          partialDeriv a (fun z => w ((chartAt E3 q).symm z)) (chartAt E3 q x) *
          partialDeriv b (fun z => w ((chartAt E3 q).symm z)) (chartAt E3 q x) := by
    intro q hq u hu
    have hy : (chartAt E3 q).symm (chartAt E3 q x) = x := (chartAt E3 q).left_inv hq
    have h := grad_rep q (chartAt E3 q x) ((chartAt E3 q).map_source hq) N
    rw [hy] at h
    exact h hwx (fun v => hN v) u hu
  have hN0 : N ≠ 0 := by
    intro h0
    apply hdw x hxD
    refine ContinuousLinearMap.ext (fun v => ?_)
    have h1 := hN v
    rw [h0, map_zero, ContinuousLinearMap.zero_apply] at h1
    rw [ContinuousLinearMap.zero_apply]
    exact h1.symm
  have hn : 0 < g.g x N N := g.posDef x N hN0
  obtain ⟨X, hX⟩ : ∃ X : E3, X = (Real.sqrt (g.g x N N))⁻¹ • N := ⟨_, rfl⟩
  have hnu : ∀ q : M, x ∈ (chartAt E3 q).source →
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal (g.coeff (chartAt E3 q).symm)
        (fun y => w ((chartAt E3 q).symm y)) (chartAt E3 q x) i) =
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) x X : E3) := by
    intro q hq
    obtain ⟨u, hu⟩ : ∃ u : E3, u = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) x N := ⟨_, rfl⟩
    obtain ⟨h1, h2⟩ := hrep q hq u hu
    have hwu : (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) x X : E3) =
        (Real.sqrt (g.g x N N))⁻¹ • u := by
      rw [hX, map_smul, hu]
    rw [hwu]
    refine PiLp.ext (fun i => ?_)
    rw [PiLp.smul_apply, smul_eq_mul, h1 i, h2]
    rfl
  have hid : ∀ v : E3, (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x) x v : E3) = v := by
    intro v
    rw [mfderiv_chartAt_eq_tangentCoordChange (mem_chart_source E3 x)]
    exact tangentCoordChange_self (I := 𝓘(ℝ, E3)) (mem_extChartAt_source x)
  have hνx : (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
      (g.coeff (chartAt E3 x).symm) (fun y => w ((chartAt E3 x).symm y)) (chartAt E3 x x) i) = X := by
    rw [hnu x (mem_chart_source E3 x), hid]
  
  have hlmc : g.levelMeanCurv w x = levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
      (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) := by
    obtain ⟨b, hb⟩ := (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) x).mem_iff.1
      (hD.mem_nhds hxD)
    have hbD : tsupport (b : M → ℝ) ⊆ D := hb.2
    obtain ⟨wt, hwt⟩ : ∃ wt : M → ℝ, wt = fun y => b y * w y := ⟨_, rfl⟩
    have hwts : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ wt := by
      rw [hwt]
      apply contMDiff_of_tsupport
      intro y hy
      have hyD : y ∈ D := hbD (tsupport_mul_subset_left hy)
      exact (b.contMDiff.contMDiffAt).mul (hws.contMDiffAt (hD.mem_nhds hyD))
    have hwtx : wt =ᶠ[𝓝 x] w := by
      filter_upwards [b.eventuallyEq_one] with y hy
      rw [hwt]
      simp [hy]
    have key : ∀ q : M, x ∈ (chartAt E3 q).source →
        g.levelMeanCurv wt x = levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
          (fun y => w ((chartAt E3 q).symm y)) (chartAt E3 q x) := by
      intro q hq
      let Φq : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
        PartialDiffeomorph.mk (chartAt E3 q).symm.toPartialEquiv (chartAt E3 q).open_target
          (chartAt E3 q).open_source contMDiffOn_chart_symm contMDiffOn_chart
      have hy : (chartAt E3 q).symm (chartAt E3 q x) = x := (chartAt E3 q).left_inv hq
      have hT : Tendsto (chartAt E3 q).symm (𝓝 (chartAt E3 q x)) (𝓝 x) := by
        have := ((chartAt E3 q).continuousAt_symm ((chartAt E3 q).map_source hq)).tendsto
        rwa [hy] at this
      have hfh : ∀ᶠ z in 𝓝 (chartAt E3 q x), wt (Φq z) = w ((chartAt E3 q).symm z) :=
        hT.eventually hwtx
      have h := levelMeanCurv_eq_coord g Φq wt (fun y => w ((chartAt E3 q).symm y)) hwts
        (chartAt E3 q x) ((chartAt E3 q).map_source hq) hfh
      conv_lhs => rw [← hy]
      exact h
    rw [← key p hxp, key x (mem_chart_source E3 x)]
    rfl
  refine ⟨?_, hlmc, ?_, ?_⟩
  · rw [← (hrep p hxp _ rfl).2]
    exact hn
  · rw [hνx, hnu p hxp]
  · rw [hνx, hX]
    simp only [map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [← mul_assoc, ← mul_inv, Real.mul_self_sqrt hn.le, inv_mul_cancel₀ hn.ne']

theorem collar_rep_div_euclid (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3) (f ψ ζ : E3 → ℝ) (X : E3 → E3) (a b : ℝ) (hab : a < b) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i) (hpd : ∀ z ∈ T, (G z).PosDef) (hf : ContDiffOn ℝ ∞ f T) (hQ : ∀ z ∈ T, 0 < ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * partialDeriv i f z * partialDeriv j f z) (hψ : ContDiffOn ℝ ∞ ψ T) (hζ : ∀ z ∈ T, ζ z = 1 - Real.smoothTransition ((f z - a) / (b - a))) (hX : ∀ z ∈ T, X z = (-(ψ z * ζ z)) • (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal G f z i)) (y : E3) (hy : y ∈ T) : sepDensDiv G X y = Real.sqrt (G y).det * (ψ y * Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i ζ y * partialDeriv j ζ y) - ψ y * ζ y * levelMeanCurvCoord G f y - ζ y * fderiv ℝ ψ y ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal G f y i))) :=
by
  have hTy : T ∈ 𝓝 y := hT.mem_nhds hy
  obtain ⟨N, hN⟩ : ∃ N : E3 → E3, N = fun z =>
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal G f z i) := ⟨_, rfl⟩
  have hNi : ∀ z i, N z i = calUnitNormal G f z i := by
    intro z i; rw [hN]; rfl
  have hNy : N y = (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal G f y i) := by
    rw [hN]
  have hdet : ∀ z ∈ T, 0 < (G z).det := fun z hz => (hpd z hz).det_pos
  have hsd : DifferentiableAt ℝ (fun z => Real.sqrt (G z).det) y :=
    ((ccs_sqrtdet_smooth G T hG hdet).contDiffAt hTy).differentiableAt (by simp)
  obtain ⟨hSo, hNs, -⟩ := ccs_normal_props G f T hT hG hpd hf N (fun z _ i => hNi z i)
  have hNd : DifferentiableAt ℝ N y :=
    (hNs.contDiffAt (hSo.mem_nhds ⟨hy, hQ y hy⟩)).differentiableAt (by simp)
  have hNid : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => N z i) y := fun i =>
    (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).differentiableAt.comp y hNd
  have hW₁ : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * N z i) y :=
    fun i => hsd.mul (hNid i)
  have hW₂ : ∀ i : Fin 3,
      DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * (fun _ => (0 : E3)) z i) y := by
    intro i; simp
  have hψd : DifferentiableAt ℝ ψ y := (hψ.contDiffAt hTy).differentiableAt (by simp)
  have hfd : DifferentiableAt ℝ f y := (hf.contDiffAt hTy).differentiableAt (by simp)
  
  have hexp : ∀ (h : E3 → ℝ) (v : E3), fderiv ℝ h y v = ∑ i : Fin 3, v i * partialDeriv i h y := by
    intro h v
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext j; fin_cases j <;> simp [e, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_three, partialDeriv]
  
  have hst : HasDerivAt Real.smoothTransition
      (deriv Real.smoothTransition ((f y - a) / (b - a))) ((f y - a) / (b - a)) :=
    ((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num) _).hasDerivAt
  have hs0 : 0 ≤ deriv Real.smoothTransition ((f y - a) / (b - a)) :=
    Real.smoothTransition.monotone.deriv_nonneg
  have hu : HasFDerivAt (fun z => (f z - a) / (b - a)) ((b - a)⁻¹ • fderiv ℝ f y) y := by
    have h := (hfd.hasFDerivAt.sub_const a).const_mul (b - a)⁻¹
    convert h using 1
    funext z; rw [div_eq_inv_mul]
  have hζF : HasFDerivAt ζ (-(deriv Real.smoothTransition ((f y - a) / (b - a)) •
      (b - a)⁻¹ • fderiv ℝ f y)) y := by
    have h := (hst.comp_hasFDerivAt y hu).const_sub 1
    refine h.congr_of_eventuallyEq ?_
    filter_upwards [hTy] with z hz
    rw [hζ z hz]; rfl
  have hζd : DifferentiableAt ℝ ζ y := hζF.differentiableAt
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = deriv Real.smoothTransition ((f y - a) / (b - a)) * (b - a)⁻¹ :=
    ⟨_, rfl⟩
  have hc : 0 ≤ c := by
    rw [hcdef]; exact mul_nonneg hs0 (inv_nonneg.2 (by linarith))
  have hζL : ∀ v : E3, fderiv ℝ ζ y v = -(c * fderiv ℝ f y v) := by
    intro v
    rw [hζF.fderiv, hcdef]
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hpz : ∀ i : Fin 3, partialDeriv i ζ y = -(c * partialDeriv i f y) := by
    intro i; unfold partialDeriv; exact hζL _
  
  have key : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (ξ : Fin 3 → ℝ),
      0 < ∑ i : Fin 3, ∑ j : Fin 3, A i j * ξ i * ξ j →
      ∑ i : Fin 3, ((Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b))⁻¹ *
        ∑ k : Fin 3, A i k * ξ k) * ξ i =
      Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b) := by
    intro A ξ hpos
    have hs := Real.sqrt_pos.2 hpos
    have hsq := Real.mul_self_sqrt hpos.le
    have h1 : ∑ i : Fin 3, ((Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b))⁻¹ *
        ∑ k : Fin 3, A i k * ξ k) * ξ i =
        (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b))⁻¹ *
          (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b) := by
      simp only [Fin.sum_univ_three]; ring
    rw [h1]
    calc (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b))⁻¹ *
          (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b)
        = (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b))⁻¹ *
          (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b) *
            Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b)) := by rw [hsq]
      _ = Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b) := by
          rw [← mul_assoc, inv_mul_cancel₀ hs.ne', one_mul]
  have hfN : fderiv ℝ f y (N y) = Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y) := by
    rw [hexp f (N y)]
    simp only [hNi, calUnitNormal]
    exact key ((G y)⁻¹) (fun k => partialDeriv k f y) (hQ y hy)
  have hslope : fderiv ℝ ζ y (N y) = -Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i ζ y * partialDeriv j ζ y) := by
    have hQζ : ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i ζ y * partialDeriv j ζ y =
        c ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y := by
      simp only [hpz, Fin.sum_univ_three]; ring
    rw [hζL, hfN, hQζ, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]
  
  have hh₁ : DifferentiableAt ℝ (fun z => -(ψ z * ζ z)) y := (hψd.mul hζd).neg
  have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3,
      X z i = (fun z => -(ψ z * ζ z)) z * N z i + (fun _ => (0 : ℝ)) z * (fun _ => (0 : E3)) z i := by
    filter_upwards [hTy] with z hz i
    rw [hX z hz, hNi]
    simp
  have h1 := ccs_div_local G X N (fun _ => (0 : E3)) (fun z => -(ψ z * ζ z)) (fun _ => (0 : ℝ)) y
    hloc hh₁ (differentiableAt_const _) hW₁ hW₂
  have h2 := ccs_divx G f T hT hG hsymm hpd hf N (fun z _ i => hNi z i) y hy (hQ y hy)
  have h3 : fderiv ℝ (fun z => -(ψ z * ζ z)) y (N y) =
      -(ψ y * fderiv ℝ ζ y (N y) + ζ y * fderiv ℝ ψ y (N y)) := by
    have hd : HasFDerivAt (fun z => -(ψ z * ζ z))
        (-(ψ y • fderiv ℝ ζ y + ζ y • fderiv ℝ ψ y)) y :=
      (hψd.hasFDerivAt.mul hζd.hasFDerivAt).neg
    rw [hd.fderiv]
    simp [smul_eq_mul]
  beta_reduce at h1
  simp only [zero_mul, map_zero, mul_zero, add_zero] at h1
  rw [← hNy, h1, h2, h3, hslope]
  ring

theorem normal_deriv_cs_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f h : E3 → ℝ) (y : E3) (hpd : (G y).PosDef) (hQ : 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y) : |fderiv ℝ h y ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal G f y i))| ≤ Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a h y * partialDeriv b h y) :=
by
  
  have hlin : ∀ u : Fin 3 → ℝ, fderiv ℝ h y ((EuclideanSpace.equiv (Fin 3) ℝ).symm u) =
      ∑ i : Fin 3, u i * partialDeriv i h y := by
    intro u
    have hw : (EuclideanSpace.equiv (Fin 3) ℝ).symm u = ∑ i : Fin 3, u i • e i := by
      ext j
      fin_cases j <;> simp [e, Fin.sum_univ_three, EuclideanSpace.single_apply]
    rw [hw, map_sum]
    simp only [map_smul, smul_eq_mul, partialDeriv]
  rw [hlin]
  
  have hB : ((G y)⁻¹).PosDef := hpd.inv
  have hsym : ∀ i j : Fin 3, (G y)⁻¹ i j = (G y)⁻¹ j i := by
    intro i j
    have := hB.isHermitian.apply j i
    simpa using this
  have hpsd : ∀ u : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * u i * u j := by
    intro u
    have := hB.posSemidef.dotProduct_mulVec_nonneg u
    simp [dotProduct, Matrix.mulVec, Fin.sum_univ_three] at this ⊢
    linarith
  
  obtain ⟨Q, hQd⟩ : ∃ Q : ℝ, Q = ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y := ⟨_, rfl⟩
  obtain ⟨P, hPd⟩ : ∃ P : ℝ, P = ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv a h y * partialDeriv b h y := ⟨_, rfl⟩
  obtain ⟨S, hSd⟩ : ∃ S : ℝ, S = ∑ i : Fin 3,
      (∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y) * partialDeriv i h y := ⟨_, rfl⟩
  rw [← hQd] at hQ
  rw [← hPd]
  have hL : ∑ i : Fin 3, calUnitNormal G f y i * partialDeriv i h y = (Real.sqrt Q)⁻¹ * S := by
    rw [hQd, hSd]
    simp only [calUnitNormal, Fin.sum_univ_three]
    ring
  rw [hL]
  
  have hexp : ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
      (Q * partialDeriv i h y - S * partialDeriv i f y) *
      (Q * partialDeriv j h y - S * partialDeriv j f y) = Q * (Q * P - S ^ 2) := by
    have h10 := hsym 1 0
    have h20 := hsym 2 0
    have h21 := hsym 2 1
    rw [hQd, hPd, hSd]
    simp only [Fin.sum_univ_three]
    rw [h10, h20, h21]
    ring
  have hnn := hpsd (fun i => Q * partialDeriv i h y - S * partialDeriv i f y)
  rw [hexp] at hnn
  have hCS : S ^ 2 ≤ Q * P := by
    have := (mul_nonneg_iff_of_pos_left hQ).mp hnn
    linarith
  
  apply Real.abs_le_sqrt
  have hsq : Real.sqrt Q ^ 2 = Q := Real.sq_sqrt hQ.le
  rw [mul_pow, inv_pow, hsq, ← div_eq_inv_mul, div_le_iff₀ hQ]
  linarith

theorem jump_piece_div [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E D : Set M) (w ζ ψ : M → ℝ) (V : M → E3) (a b C₀ : ℝ) (p : M)
    (hE : IsOpen E) (hD : IsOpen D) (hSig : IsClosed Sig) (hESig : Disjoint E Sig) (hab : a < b)
    (hws : ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 p).symm y))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' D))
    (hQ : ∀ x ∈ D ∩ (chartAt E3 p).source, 0 < ∑ a : Fin 3, ∑ b : Fin 3,
      (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ a b *
        partialDeriv a (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) *
        partialDeriv b (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x))
    (hH : ∀ x ∈ D ∩ (chartAt E3 p).source, g.levelMeanCurv w x =
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y))
        (chartAt E3 p x))
    (hζ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ζ) (hζ01 : ∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1)
    (hζD : ∀ x ∈ D, ζ x = 1 - Real.smoothTransition ((w x - a) / (b - a)))
    (hζH : ∀ x ∈ D, ζ x ≠ 0 → |g.levelMeanCurv w x| ≤ C₀)
    (hVrep : ∀ x ∈ E ∩ D ∩ (chartAt E3 p).source,
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) x (V x) : E3) =
        (-(ζ x)) • (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) i))
    (hVloc : ∀ x, x ∉ Sig → x ∉ E ∩ D → ∀ᶠ x' in 𝓝 x, V x' = 0)
    (hEζ : ∀ x ∈ E, x ∉ D → ∀ᶠ x' in 𝓝 x, ζ x' = 0)
    (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hψc : IsCompact (tsupport ψ))
    (hψs : tsupport ψ ⊆ (chartAt E3 p).source) :
    (∃ C : ℝ, ∀ y, y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) →
      |sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y| ≤ C) ∧
    (∀ y, y ∉ chartAt E3 p '' tsupport ψ →
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y = 0) ∧
    ∀ y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
        ψ ((chartAt E3 p).symm y) * Real.sqrt (g.gradInner ζ ζ ((chartAt E3 p).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 p).symm y).det -
          ψ ((chartAt E3 p).symm y) *
            (ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 p).symm y).det +
          Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
            fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
                (V ((chartAt E3 p).symm y)) : E3) :=
by
  classical
  
  have hKc : IsCompact (chartAt E3 p '' tsupport ψ) :=
    hψc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hψs)
  have hKt : chartAt E3 p '' tsupport ψ ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 p).map_source (hψs hx)
  have hTo : IsOpen (chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source ((hE.inter hD).inter (chartAt E3 p).open_source)
      Set.inter_subset_right
  have hTt : chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source) ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 p).map_source hx.2
  have hTtD : chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source) ⊆
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' D := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨(chartAt E3 p).map_source hx.2, ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p x) ∈ D
    rw [(chartAt E3 p).left_inv hx.2]; exact hx.1.2
  
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 p).symm z i j)
      (chartAt E3 p).target := g.smooth p
  have hpd : ∀ z ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm z).PosDef :=
    fun z hz => coeff_chart_symm_posDef g p z hz
  have hdetc : ContinuousOn (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det)
      (chartAt E3 p).target :=
    (ccs_sqrtdet_smooth _ _ hGs (fun z hz => (hpd z hz).det_pos)).continuousOn
  have hψp : ContDiffOn ℝ ∞ (fun z => ψ ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hψ.comp_contMDiffOn contMDiffOn_chart_symm)
  have hζp : ContDiffOn ℝ ∞ (fun z => ζ ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hζ.comp_contMDiffOn contMDiffOn_chart_symm)
  have hginv := ginv_contDiffOn _ _ hGs hpd
  have hdζ : ContinuousOn (fun z => fderiv ℝ (fun z => ζ ((chartAt E3 p).symm z)) z)
      (chartAt E3 p).target :=
    hζp.continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)
  have hdψ : ContinuousOn (fun z => fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) z)
      (chartAt E3 p).target :=
    hψp.continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)
  have hQζ : ContinuousOn (fun z => ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 p).symm z)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) z *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) z) (chartAt E3 p).target := by
    simp only [partialDeriv]
    refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
    exact (((hginv i j).continuousOn).mul (hdζ.clm_apply continuousOn_const)).mul
      (hdζ.clm_apply continuousOn_const)
  have hQψ : ContinuousOn (fun z => ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 p).symm z)⁻¹ i j *
        partialDeriv i (fun z => ψ ((chartAt E3 p).symm z)) z *
        partialDeriv j (fun z => ψ ((chartAt E3 p).symm z)) z) (chartAt E3 p).target := by
    simp only [partialDeriv]
    refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
    exact (((hginv i j).continuousOn).mul (hdψ.clm_apply continuousOn_const)).mul
      (hdψ.clm_apply continuousOn_const)
  
  let Φp : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    PartialDiffeomorph.mk (chartAt E3 p).symm.toPartialEquiv (chartAt E3 p).open_target
      (chartAt E3 p).open_source contMDiffOn_chart_symm contMDiffOn_chart
  have hgζ : ∀ y ∈ (chartAt E3 p).target, g.gradInner ζ ζ ((chartAt E3 p).symm y) =
      ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) y :=
    fun y hy => gradInner_eq_coord g Φp ζ (fun z => ζ ((chartAt E3 p).symm z)) hζ y hy
      (Filter.Eventually.of_forall fun _ => rfl)
  
  have F2 : ∀ (X : E3 → E3) (y : E3), (∀ᶠ z in 𝓝 y, X z = 0) →
      sepDensDiv (g.coeff (chartAt E3 p).symm) X y = 0 := by
    intro X y hX
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) =ᶠ[𝓝 y]
        fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    unfold partialDeriv
    rw [hev.fderiv_eq]
    simp
  
  have F3 : ∀ z, z ∉ chartAt E3 p '' tsupport ψ → calPiece p ψ V z = 0 := by
    intro z hz
    unfold calPiece
    by_cases hzt : z ∈ (chartAt E3 p).target
    · rw [Set.indicator_of_mem hzt]
      have h0 : ψ ((chartAt E3 p).symm z) = 0 := by
        by_contra h
        exact hz ⟨_, subset_tsupport _ h, (chartAt E3 p).right_inv hzt⟩
      simp only [h0, zero_smul]
    · rw [Set.indicator_of_notMem hzt]
  
  have F4 : ∀ y ∈ (chartAt E3 p).target,
      (∀ᶠ x' in 𝓝 ((chartAt E3 p).symm y), V x' = 0) →
      ∀ᶠ z in 𝓝 y, calPiece p ψ V z = 0 := by
    intro y hy hV
    have h2 : ∀ᶠ z in 𝓝 y, V ((chartAt E3 p).symm z) = 0 :=
      ((chartAt E3 p).continuousAt_symm hy).eventually hV
    filter_upwards [h2] with z hz
    unfold calPiece
    by_cases hzt : z ∈ (chartAt E3 p).target
    · rw [Set.indicator_of_mem hzt]; simp [hz]
    · rw [Set.indicator_of_notMem hzt]
  
  have s4 : ∀ y, y ∉ chartAt E3 p '' tsupport ψ →
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y = 0 := by
    intro y hy
    apply F2
    filter_upwards [hKc.isClosed.isOpen_compl.mem_nhds hy] with z hz
    exact F3 z hz
  
  have hQT : ∀ z ∈ chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source),
      0 < ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm z)⁻¹ i j *
        partialDeriv i (fun y => w ((chartAt E3 p).symm y)) z *
        partialDeriv j (fun y => w ((chartAt E3 p).symm y)) z := by
    rintro _ ⟨x', ⟨⟨_, hx'D⟩, hx's⟩, rfl⟩
    exact hQ x' ⟨hx'D, hx's⟩
  have hζT : ∀ z ∈ chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source),
      ζ ((chartAt E3 p).symm z) =
        1 - Real.smoothTransition ((w ((chartAt E3 p).symm z) - a) / (b - a)) := by
    rintro _ ⟨x', ⟨⟨_, hx'D⟩, hx's⟩, rfl⟩
    rw [(chartAt E3 p).left_inv hx's]
    exact hζD x' hx'D
  have hXT : ∀ z ∈ chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source),
      calPiece p ψ V z = (-(ψ ((chartAt E3 p).symm z) * ζ ((chartAt E3 p).symm z))) •
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) z i) := by
    rintro _ ⟨x', ⟨⟨hx'E, hx'D⟩, hx's⟩, rfl⟩
    unfold calPiece
    rw [Set.indicator_of_mem ((chartAt E3 p).map_source hx's)]
    beta_reduce
    rw [(chartAt E3 p).left_inv hx's, hVrep x' ⟨⟨hx'E, hx'D⟩, hx's⟩, smul_smul, mul_neg]
  
  have s5 : ∀ y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
        ψ ((chartAt E3 p).symm y) * Real.sqrt (g.gradInner ζ ζ ((chartAt E3 p).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 p).symm y).det -
          ψ ((chartAt E3 p).symm y) *
            (ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 p).symm y).det +
          Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
            fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
                (V ((chartAt E3 p).symm y)) : E3) := by
    rintro _ ⟨x, ⟨hxE, hxs⟩, rfl⟩
    have hx : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    have hyt : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hxs
    have hxS : x ∉ Sig := fun hs => Set.disjoint_left.1 hESig hxE hs
    by_cases hxD : x ∈ D
    · have hyT : chartAt E3 p x ∈ chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source) :=
        ⟨x, ⟨⟨hxE, hxD⟩, hxs⟩, rfl⟩
      have hs2 := collar_rep_div_euclid (g.coeff (chartAt E3 p).symm)
        (chartAt E3 p '' (E ∩ D ∩ (chartAt E3 p).source))
        (fun y => w ((chartAt E3 p).symm y)) (fun y => ψ ((chartAt E3 p).symm y))
        (fun y => ζ ((chartAt E3 p).symm y)) (calPiece p ψ V) a b hab hTo
        (fun i j => (hGs i j).mono hTt) (fun z i j => g.symm _ _ _)
        (fun z hz => hpd z (hTt hz)) (hws.mono hTtD) hQT (hψp.mono hTt) hζT hXT
        (chartAt E3 p x) hyT
      beta_reduce at hs2
      have e1 := hgζ _ hyt
      have e2 : g.levelMeanCurv w ((chartAt E3 p).symm (chartAt E3 p x)) =
          levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y))
            (chartAt E3 p x) := by
        rw [hx]; exact hH x ⟨hxD, hxs⟩
      have e3 : fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) (chartAt E3 p x)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm (chartAt E3 p x))
            (V ((chartAt E3 p).symm (chartAt E3 p x))) : E3) =
          -(ζ ((chartAt E3 p).symm (chartAt E3 p x))) *
            fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) (chartAt E3 p x)
              ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
                (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y))
                (chartAt E3 p x) i)) := by
        rw [hx, hVrep x ⟨⟨hxE, hxD⟩, hxs⟩, map_smul, smul_eq_mul]
      rw [hs2, e1, e2, e3]
      ring
    · have hVev : ∀ᶠ x' in 𝓝 ((chartAt E3 p).symm (chartAt E3 p x)), V x' = 0 := by
        rw [hx]; exact hVloc x hxS (fun h => hxD h.2)
      have hζev : ∀ᶠ x' in 𝓝 ((chartAt E3 p).symm (chartAt E3 p x)), ζ x' = 0 := by
        rw [hx]; exact hEζ x hxE hxD
      rw [F2 _ _ (F4 _ hyt hVev)]
      have hζp0 : ∀ᶠ z in 𝓝 (chartAt E3 p x), ζ ((chartAt E3 p).symm z) = 0 :=
        ((chartAt E3 p).continuousAt_symm hyt).eventually hζev
      have hpd0 : ∀ i : Fin 3,
          partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) (chartAt E3 p x) = 0 := by
        intro i
        have hev : (fun z => ζ ((chartAt E3 p).symm z)) =ᶠ[𝓝 (chartAt E3 p x)]
            fun _ => (0 : ℝ) := hζp0
        unfold partialDeriv
        rw [hev.fderiv_eq]
        simp
      rw [hgζ _ hyt]
      simp only [hpd0, mul_zero, Finset.sum_const_zero, Real.sqrt_zero]
      rw [hζev.self_of_nhds, hVev.self_of_nhds]
      simp
  
  obtain ⟨B1, hB1⟩ := hKc.exists_bound_of_continuousOn (hdetc.mono hKt)
  obtain ⟨B2, hB2⟩ := hKc.exists_bound_of_continuousOn (hψp.continuousOn.mono hKt)
  obtain ⟨B3, hB3⟩ := hKc.exists_bound_of_continuousOn (hQζ.mono hKt)
  obtain ⟨B4, hB4⟩ := hKc.exists_bound_of_continuousOn (hQψ.mono hKt)
  refine ⟨⟨max (B1 * (B2 * Real.sqrt B3 + B2 * |C₀| + Real.sqrt B4)) 0, ?_⟩, s4, s5⟩
  intro y hyS
  by_cases hyK : y ∈ chartAt E3 p '' tsupport ψ
  swap
  · rw [s4 y hyK, abs_zero]; exact le_max_right _ _
  refine le_trans ?_ (le_max_left _ _)
  have hyt := hKt hyK
  have h1 : |Real.sqrt (g.coeff (chartAt E3 p).symm y).det| ≤ B1 := by
    have := hB1 y hyK; rwa [Real.norm_eq_abs] at this
  have h2 : |ψ ((chartAt E3 p).symm y)| ≤ B2 := by
    have := hB2 y hyK; rwa [Real.norm_eq_abs] at this
  have h3 : |∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) y| ≤ B3 := by
    have := hB3 y hyK; rwa [Real.norm_eq_abs] at this
  have h4 : |∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ψ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ψ ((chartAt E3 p).symm z)) y| ≤ B4 := by
    have := hB4 y hyK; rwa [Real.norm_eq_abs] at this
  have hB1n : 0 ≤ B1 := le_trans (abs_nonneg _) h1
  have hB2n : 0 ≤ B2 := le_trans (abs_nonneg _) h2
  have hCn : 0 ≤ B1 * (B2 * Real.sqrt B3 + B2 * |C₀| + Real.sqrt B4) :=
    mul_nonneg hB1n (add_nonneg (add_nonneg (mul_nonneg hB2n (Real.sqrt_nonneg _))
      (mul_nonneg hB2n (abs_nonneg _))) (Real.sqrt_nonneg _))
  have hxs : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hyt
  have hκx : chartAt E3 p ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hyt
  have hxS : (chartAt E3 p).symm y ∉ Sig := fun hs => hyS ⟨_, ⟨hs, hxs⟩, hκx⟩
  by_cases hxED : (chartAt E3 p).symm y ∈ E ∩ D
  swap
  · have hVev : ∀ᶠ x' in 𝓝 ((chartAt E3 p).symm y), V x' = 0 := hVloc _ hxS hxED
    rw [F2 _ _ (F4 y hyt hVev), abs_zero]
    exact hCn
  have hyE : y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source) := ⟨_, ⟨hxED.1, hxs⟩, hκx⟩
  rw [s5 y hyE]
  have hQx := hQ _ ⟨hxED.2, hxs⟩
  rw [hκx] at hQx
  have hrep := hVrep _ ⟨hxED, hxs⟩
  rw [hrep, hκx, map_smul, smul_eq_mul, hgζ y hyt]
  have hSg0 : 0 ≤ Real.sqrt (g.coeff (chartAt E3 p).symm y).det := Real.sqrt_nonneg _
  have hSg : Real.sqrt (g.coeff (chartAt E3 p).symm y).det ≤ B1 := le_trans (le_abs_self _) h1
  have hR30 : 0 ≤ Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) y) := Real.sqrt_nonneg _
  have hR3 : Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) y) ≤ Real.sqrt B3 :=
    Real.sqrt_le_sqrt (le_trans (le_abs_self _) h3)
  have hz1 : |ζ ((chartAt E3 p).symm y)| ≤ 1 :=
    abs_le.2 ⟨by linarith [(hζ01 ((chartAt E3 p).symm y)).1], (hζ01 ((chartAt E3 p).symm y)).2⟩
  have hZ : |ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)| ≤ |C₀| := by
    by_cases hz : ζ ((chartAt E3 p).symm y) = 0
    · rw [hz, zero_mul, abs_zero]; exact abs_nonneg _
    · have hH' := hζH _ hxED.2 hz
      rw [abs_mul]
      calc |ζ ((chartAt E3 p).symm y)| * |g.levelMeanCurv w ((chartAt E3 p).symm y)|
          ≤ 1 * C₀ := mul_le_mul hz1 hH' (abs_nonneg _) zero_le_one
        _ ≤ |C₀| := by rw [one_mul]; exact le_abs_self _
  have hP : |fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
      ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
        (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) y i))| ≤
      Real.sqrt B4 :=
    le_trans (normal_deriv_cs_bound _ _ _ y (hpd y hyt) hQx)
      (Real.sqrt_le_sqrt (le_trans (le_abs_self _) h4))
  have t1 := abs_le.1 (show |ψ ((chartAt E3 p).symm y) *
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => ζ ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => ζ ((chartAt E3 p).symm z)) y) *
      Real.sqrt (g.coeff (chartAt E3 p).symm y).det| ≤ B2 * Real.sqrt B3 * B1 by
    rw [abs_mul, abs_mul, abs_of_nonneg hR30, abs_of_nonneg hSg0]
    exact mul_le_mul (mul_le_mul h2 hR3 hR30 hB2n) hSg hSg0
      (mul_nonneg hB2n (Real.sqrt_nonneg _)))
  have t2 := abs_le.1 (show |ψ ((chartAt E3 p).symm y) *
      (ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)) *
      Real.sqrt (g.coeff (chartAt E3 p).symm y).det| ≤ B2 * |C₀| * B1 by
    rw [abs_mul, abs_mul _ (ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)),
      abs_of_nonneg hSg0]
    exact mul_le_mul (mul_le_mul h2 hZ (abs_nonneg _) hB2n) hSg hSg0
      (mul_nonneg hB2n (abs_nonneg _)))
  have t3 := abs_le.1 (show |Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
      (-ζ ((chartAt E3 p).symm y) * fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
        ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) y i)))| ≤
      B1 * Real.sqrt B4 by
    rw [abs_mul, abs_mul, abs_neg, abs_of_nonneg hSg0]
    have h5 : |ζ ((chartAt E3 p).symm y)| * |fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
        ((EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) y i))| ≤
        Real.sqrt B4 := by
      calc _ ≤ 1 * Real.sqrt B4 := mul_le_mul hz1 hP (abs_nonneg _) zero_le_one
        _ = Real.sqrt B4 := one_mul _
    exact mul_le_mul hSg h5 (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hB1n)
  have hrhs : B1 * (B2 * Real.sqrt B3 + B2 * |C₀| + Real.sqrt B4) =
      B2 * Real.sqrt B3 * B1 + B2 * |C₀| * B1 + B1 * Real.sqrt B4 := by ring
  rw [hrhs, abs_le]
  constructor <;> linarith [t1.1, t1.2, t2.1, t2.2, t3.1, t3.2]

theorem jump_partition_div_cancel [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω O'' E : Set M) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (hO'' : IsOpen O'') (h1 : ∀ x ∈ O'', ∑ j, φ j x = 1) (hE : IsOpen E) (V : M → E3) (hV1 : ∀ x, g.g x (V x) (V x) ≤ 1) (hVO : ∀ x, V x ≠ 0 → x ∈ O'') (c : ℕ → M → ℝ) (hc1 : ∀ m x, |c m x| ≤ 1) (hcs : ∀ m, calSmoothField (fun x => c m x • V x)) (hlim : ∀ x ∈ E, Tendsto (fun m => c m x) atTop (𝓝 1)) : ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det * fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y) (V ((chartAt E3 (q j)).symm y)) : E3) = 0 :=
by
  classical
  
  have hdom : ∀ j : Fin n, ∃ B : ℝ, 0 ≤ B ∧ ∀ y ∈ (chartAt E3 (q j)).target,
      |Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (V ((chartAt E3 (q j)).symm y)) : E3)| ≤
        (chartAt E3 (q j) '' tsupport (φ j)).indicator (fun _ => B) y := by
    intro j
    have hφs : tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
      (hφ.2.2.2 j).2.trans Set.inter_subset_right
    have hKc : IsCompact (chartAt E3 (q j) '' tsupport (φ j)) :=
      (hφ.2.2.2 j).1.image_of_continuousOn ((chartAt E3 (q j)).continuousOn.mono hφs)
    have hKt : chartAt E3 (q j) '' tsupport (φ j) ⊆ (chartAt E3 (q j)).target := by
      rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 (q j)).map_source (hφs hx)
    have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 (q j)).symm z a b)
        (chartAt E3 (q j)).target := g.smooth (q j)
    have hpd : ∀ z ∈ (chartAt E3 (q j)).target, (g.coeff (chartAt E3 (q j)).symm z).PosDef :=
      fun z hz => coeff_chart_symm_posDef g (q j) z hz
    have hdetc : ContinuousOn (fun z => Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det)
        (chartAt E3 (q j)).target :=
      (ccs_sqrtdet_smooth _ _ hGs (fun z hz => (hpd z hz).det_pos)).continuousOn
    have hφp : ContDiffOn ℝ ∞ (fun z => φ j ((chartAt E3 (q j)).symm z)) (chartAt E3 (q j)).target :=
      contMDiffOn_iff_contDiffOn.mp ((hφ.1 j).comp_contMDiffOn contMDiffOn_chart_symm)
    have hdφ : ContinuousOn (fun z => fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) z)
        (chartAt E3 (q j)).target :=
      hφp.continuousOn_fderiv_of_isOpen (chartAt E3 (q j)).open_target (by simp)
    have hginv := ginv_contDiffOn _ _ hGs hpd
    have hQ : ContinuousOn (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 (q j)).symm z)⁻¹ a b *
          partialDeriv a (fun z => φ j ((chartAt E3 (q j)).symm z)) z *
          partialDeriv b (fun z => φ j ((chartAt E3 (q j)).symm z)) z)
        (chartAt E3 (q j)).target := by
      simp only [partialDeriv]
      refine continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ => ?_
      exact (((hginv a b).continuousOn).mul (hdφ.clm_apply continuousOn_const)).mul
        (hdφ.clm_apply continuousOn_const)
    obtain ⟨B₁, hB₁⟩ := hKc.exists_bound_of_continuousOn (hdetc.mono hKt)
    obtain ⟨B₂, hB₂⟩ := hKc.exists_bound_of_continuousOn (hQ.mono hKt)
    refine ⟨max B₁ 0 * Real.sqrt (max B₂ 0),
      mul_nonneg (le_max_right _ _) (Real.sqrt_nonneg _), ?_⟩
    intro y hy
    by_cases hyK : y ∈ chartAt E3 (q j) '' tsupport (φ j)
    · rw [Set.indicator_of_mem hyK]
      set r : E3 := (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j))
        ((chartAt E3 (q j)).symm y) (V ((chartAt E3 (q j)).symm y)) : E3) with hr
      have hrs : ∑ i : Fin 3, r i • e i = r := by
        have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr r
        simpa [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] using this
      have hexp : fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y r =
          ∑ i : Fin 3, r i * partialDeriv i (fun z => φ j ((chartAt E3 (q j)).symm z)) y := by
        conv_lhs => rw [← hrs]
        rw [map_sum]
        simp only [map_smul, smul_eq_mul, partialDeriv]
      have hs : ∑ a : Fin 3, ∑ b : Fin 3, g.coeff (chartAt E3 (q j)).symm y a b * r a * r b =
          g.g ((chartAt E3 (q j)).symm y) (V ((chartAt E3 (q j)).symm y))
            (V ((chartAt E3 (q j)).symm y)) :=
        ccs_rep_norm g V (q j) y hy r rfl
      have hs1 := hV1 ((chartAt E3 (q j)).symm y)
      have hs0 : 0 ≤ g.g ((chartAt E3 (q j)).symm y) (V ((chartAt E3 (q j)).symm y))
          (V ((chartAt E3 (q j)).symm y)) := by
        by_cases hV0 : V ((chartAt E3 (q j)).symm y) = 0
        · rw [hV0]; simp
        · exact (g.posDef _ _ hV0).le
      have hCS := smth_quad_cauchySchwarz (g.coeff (chartAt E3 (q j)).symm y) (hpd y hy)
        (fun i => r i) (fun i => partialDeriv i (fun z => φ j ((chartAt E3 (q j)).symm z)) y)
      simp only [] at hCS
      rw [hs] at hCS
      have hQy := hB₂ y hyK
      rw [Real.norm_eq_abs] at hQy
      have hsq : (fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y r) ^ 2 ≤ max B₂ 0 := by
        rw [hexp]
        refine hCS.trans ?_
        have hA := mul_le_mul_of_nonneg_left (le_abs_self (∑ a : Fin 3, ∑ b : Fin 3,
          (g.coeff (chartAt E3 (q j)).symm y)⁻¹ a b *
            partialDeriv a (fun z => φ j ((chartAt E3 (q j)).symm z)) y *
            partialDeriv b (fun z => φ j ((chartAt E3 (q j)).symm z)) y)) hs0
        have hB := mul_le_of_le_one_left (abs_nonneg (∑ a : Fin 3, ∑ b : Fin 3,
          (g.coeff (chartAt E3 (q j)).symm y)⁻¹ a b *
            partialDeriv a (fun z => φ j ((chartAt E3 (q j)).symm z)) y *
            partialDeriv b (fun z => φ j ((chartAt E3 (q j)).symm z)) y)) hs1
        linarith [le_max_left B₂ 0]
      have hd : |fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y r| ≤
          Real.sqrt (max B₂ 0) := Real.abs_le_sqrt hsq
      have hdet := hB₁ y hyK
      rw [Real.norm_eq_abs] at hdet
      rw [abs_mul]
      exact mul_le_mul (hdet.trans (le_max_left _ _)) hd (abs_nonneg _) (le_max_right _ _)
    · rw [Set.indicator_of_notMem hyK]
      have hev : (fun z => φ j ((chartAt E3 (q j)).symm z)) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        have hO : IsOpen ((chartAt E3 (q j)).target ∩ (chartAt E3 (q j) '' tsupport (φ j))ᶜ) :=
          (chartAt E3 (q j)).open_target.inter hKc.isClosed.isOpen_compl
        filter_upwards [hO.mem_nhds ⟨hy, hyK⟩] with z hz
        show φ j ((chartAt E3 (q j)).symm z) = 0
        by_contra h
        exact hz.2 ⟨(chartAt E3 (q j)).symm z, subset_tsupport _ h,
          (chartAt E3 (q j)).right_inv hz.1⟩
      rw [Filter.EventuallyEq.fderiv_eq hev]
      simp
  
  have hSo : ∀ (j : Fin n) (A : Set M), IsOpen A →
      IsOpen (chartAt E3 (q j) '' (A ∩ (chartAt E3 (q j)).source)) := fun j A hA =>
    (chartAt E3 (q j)).isOpen_image_of_subset_source (hA.inter (chartAt E3 (q j)).open_source)
      Set.inter_subset_right
  have hmeasEO : sepChartMeas (E ∩ O'') := fun p =>
    ((chartAt E3 p).isOpen_image_of_subset_source
      ((hE.inter hO'').inter (chartAt E3 p).open_source) Set.inter_subset_right).measurableSet
  
  have hlin : ∀ (m : ℕ) (j : Fin n) (y : E3),
      Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (c m ((chartAt E3 (q j)).symm y) • V ((chartAt E3 (q j)).symm y)) : E3) =
      c m ((chartAt E3 (q j)).symm y) *
        (Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
          fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
              (V ((chartAt E3 (q j)).symm y)) : E3)) := by
    intro m j y
    rw [ContinuousLinearMap.map_smul, ContinuousLinearMap.map_smul, smul_eq_mul]
    ring
  
  have hm0 : ∀ m : ℕ, ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
      Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (c m ((chartAt E3 (q j)).symm y) • V ((chartAt E3 (q j)).symm y)) : E3) = 0 := by
    intro m
    have h := cal_partition_div_cancel g Ω q φ hφ O'' hO'' h1 (fun x => c m x • V x) (hcs m)
      (E ∩ O'') hmeasEO Set.inter_subset_right
    refine Eq.trans (Finset.sum_congr rfl (fun j _ => ?_)) h
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hSo j E hE).measurableSet
      (Set.image_mono (Set.inter_subset_inter_left _ Set.inter_subset_left)) ?_
    rintro y ⟨⟨x, hx, rfl⟩, hy2⟩
    have hxO : x ∉ O'' := fun hxO => hy2 ⟨x, ⟨⟨hx.1, hxO⟩, hx.2⟩, rfl⟩
    have hV0 : V x = 0 := by
      by_contra h0; exact hxO (hVO x h0)
    simp [(chartAt E3 (q j)).left_inv hx.2, hV0]
  
  have hT : ∀ j : Fin n, Tendsto (fun m : ℕ =>
      ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
          fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
              (c m ((chartAt E3 (q j)).symm y) • V ((chartAt E3 (q j)).symm y)) : E3))
      atTop (𝓝 (∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
          fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
              (V ((chartAt E3 (q j)).symm y)) : E3))) := by
    intro j
    obtain ⟨B, hB0, hB⟩ := hdom j
    have hSm := (hSo j E hE).measurableSet
    have hST : chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) ⊆ (chartAt E3 (q j)).target := by
      rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 (q j)).map_source hx.2
    have hφs : tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
      (hφ.2.2.2 j).2.trans Set.inter_subset_right
    have hKc : IsCompact (chartAt E3 (q j) '' tsupport (φ j)) :=
      (hφ.2.2.2 j).1.image_of_continuousOn ((chartAt E3 (q j)).continuousOn.mono hφs)
    refine tendsto_integral_of_dominated_convergence
      ((chartAt E3 (q j) '' tsupport (φ j)).indicator (fun _ => B)) ?_ ?_ ?_ ?_
    · intro m
      have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 (q j)).symm z a b)
          (chartAt E3 (q j)).target := g.smooth (q j)
      have hdetc : ContinuousOn (fun z => Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det)
          (chartAt E3 (q j)).target :=
        (ccs_sqrtdet_smooth _ _ hGs
          (fun z hz => (coeff_chart_symm_posDef g (q j) z hz).det_pos)).continuousOn
      have hφp : ContDiffOn ℝ ∞ (fun z => φ j ((chartAt E3 (q j)).symm z))
          (chartAt E3 (q j)).target :=
        contMDiffOn_iff_contDiffOn.mp ((hφ.1 j).comp_contMDiffOn contMDiffOn_chart_symm)
      have hdφ : ContinuousOn (fun z => fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) z)
          (chartAt E3 (q j)).target :=
        hφp.continuousOn_fderiv_of_isOpen (chartAt E3 (q j)).open_target (by simp)
      have hrep : ContinuousOn (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j))
          ((chartAt E3 (q j)).symm y)
          (c m ((chartAt E3 (q j)).symm y) • V ((chartAt E3 (q j)).symm y)) : E3))
          (chartAt E3 (q j)).target := (hcs m (q j)).continuousOn
      exact ((hdetc.mul (hdφ.clm_apply hrep)).mono hST).aestronglyMeasurable hSm
    · exact ((integrable_indicator_iff hKc.measurableSet).2
        (integrableOn_const hKc.measure_lt_top.ne)).integrableOn
    · intro m
      refine (ae_restrict_of_forall_mem hSm) fun y hy => ?_
      rw [Real.norm_eq_abs, hlin m j y, abs_mul]
      have hBy := hB y (hST hy)
      have hc := hc1 m ((chartAt E3 (q j)).symm y)
      calc _ ≤ 1 * |Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
              fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
                (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
                  (V ((chartAt E3 (q j)).symm y)) : E3)| :=
            mul_le_mul_of_nonneg_right hc (abs_nonneg _)
        _ = _ := one_mul _
        _ ≤ _ := hBy
    · refine (ae_restrict_of_forall_mem hSm) fun y hy => ?_
      obtain ⟨x, hx, rfl⟩ := hy
      have hxE : (chartAt E3 (q j)).symm (chartAt E3 (q j) x) ∈ E := by
        rw [(chartAt E3 (q j)).left_inv hx.2]; exact hx.1
      have hcl := (hlim _ hxE).mul_const (Real.sqrt (g.coeff (chartAt E3 (q j)).symm
          (chartAt E3 (q j) x)).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) (chartAt E3 (q j) x)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j))
            ((chartAt E3 (q j)).symm (chartAt E3 (q j) x))
            (V ((chartAt E3 (q j)).symm (chartAt E3 (q j) x))) : E3))
      rw [one_mul] at hcl
      exact hcl.congr (fun m => (hlin m j (chartAt E3 (q j) x)).symm)
  have hsum := tendsto_finset_sum (Finset.univ : Finset (Fin n)) (fun j _ => hT j)
  exact tendsto_nhds_unique hsum (tendsto_const_nhds.congr (fun m => (hm0 m).symm))

theorem collar_jump_field [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E O : Set M) (w : M → ℝ) (t₀ a b : ℝ) (hE : IsOpen E) (hfr : frontier E = Sig)
    (hO : IsOpen O) (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (ha : 0 < a) (hab : a < b) (hb : b ≤ t₀) :
    ∃ V : M → E3,
      (∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
        ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3))
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Sigᶜ)) ∧
      (∀ (p : M) (ψ : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ → IsCompact (tsupport ψ) →
        tsupport ψ ⊆ (chartAt E3 p).source → ∃ C : ℝ, ∀ y,
          y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) →
          |sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y| ≤ C) ∧
      (∀ x, g.g x (V x) (V x) ≤ 1) ∧
      (∀ x, V x ≠ 0 → x ∈ E ∧ x ∈ O ∧ w x < b) ∧
      ∀ (Ω' O'' : Set M) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ), calPartition q φ Ω' →
        IsOpen O'' → {x | x ∈ O ∧ w x ≤ b} ⊆ O'' → (∀ x ∈ O'', ∑ j, φ j x = 1) →
        calDivSum g q φ E V =
          calVolSum g q φ E (fun x => Real.sqrt (g.gradInner
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))))
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))) x)) -
          calVolSum g q φ E (fun x =>
            O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
              g.levelMeanCurv w x) :=
by
  classical
  
  have hSigc : IsClosed Sig := hfr ▸ isClosed_frontier
  have hESig : Disjoint E Sig := by
    rw [← hfr, hE.frontier_eq]; exact Set.disjoint_sdiff_right
  have hclE : closure E ⊆ E ∪ Sig := by
    rw [← hfr, closure_eq_self_union_frontier]
  have hDo : IsOpen (O \ Sig) := hO.sdiff hSigc
  obtain ⟨C₀, hC₀⟩ := hbd
  obtain ⟨ζ, hζdef⟩ : ∃ ζ : M → ℝ,
      ζ = O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) := ⟨_, rfl⟩
  obtain ⟨hζs, hζ01, -, hζ0, -, hcl, -⟩ :=
    collar_cutoff_props Sig O w t₀ a b hSigc hO hcpt hwc hw0 hws ha hab hb
  rw [← hζdef] at hζs hζ01 hζ0
  rw [← hζdef]
  have hKb : IsClosed {x | x ∈ O ∧ w x ≤ b} := (hcl b hb).1
  have hζO : ∀ x ∈ O, ζ x = 1 - Real.smoothTransition ((w x - a) / (b - a)) := by
    intro x hx; rw [hζdef, Set.indicator_of_mem hx]
  have hKbζ : ∀ x, x ∉ {x | x ∈ O ∧ w x ≤ b} → ζ x = 0 := by
    intro x hx
    by_contra h
    exact hx ⟨(hζ0 x h).1, (hζ0 x h).2.le⟩
  have hζH : ∀ x ∈ O \ Sig, ζ x ≠ 0 → |g.levelMeanCurv w x| ≤ C₀ := by
    intro x hx h
    exact (hC₀ x hx (by linarith [(hζ0 x h).2])).2
  obtain ⟨U, hUdef⟩ : ∃ U : M → E3, U = fun x => (EuclideanSpace.equiv (Fin 3) ℝ).symm
      (fun i => calUnitNormal (g.coeff (chartAt E3 x).symm)
        (fun y => w ((chartAt E3 x).symm y)) (chartAt E3 x x) i) := ⟨_, rfl⟩
  obtain ⟨V, hVdef⟩ : ∃ V : M → E3, V = E.indicator (fun x => (-(ζ x)) • U x) := ⟨_, rfl⟩
  have hs2 := fun p => chart_unit_normal_calculus g (O \ Sig) w hDo hws hdw p
  have hVE : ∀ x ∈ E, V x = (-(ζ x)) • U x := by
    intro x hx; rw [hVdef, Set.indicator_of_mem hx]
  have hVsupp : ∀ x, V x ≠ 0 → x ∈ E ∧ x ∈ O ∧ w x < b := by
    intro x hx
    by_cases hxE : x ∈ E
    · have hζx : ζ x ≠ 0 := by
        intro h0; apply hx; rw [hVE x hxE, h0, neg_zero, zero_smul]
      exact ⟨hxE, hζ0 x hζx⟩
    · exact absurd (by rw [hVdef, Set.indicator_of_notMem hxE]) hx
  have hKbV : ∀ x, x ∉ {x | x ∈ O ∧ w x ≤ b} → V x = 0 := by
    intro x hx
    by_contra h
    exact hx ⟨(hVsupp x h).2.1, (hVsupp x h).2.2.le⟩
  have hV0 : ∀ x, x ∉ E ∩ (O \ Sig) → V x = 0 := by
    intro x hx
    by_contra h
    obtain ⟨h1, h2, -⟩ := hVsupp x h
    exact hx ⟨h1, h2, fun hs => Set.disjoint_left.1 hESig h1 hs⟩
  have hVloc : ∀ x, x ∉ Sig → x ∉ E ∩ (O \ Sig) → ∀ᶠ x' in 𝓝 x, V x' = 0 := by
    intro x hxS hxED
    by_cases hxc : x ∈ closure E
    · have hxE : x ∈ E := by
        rcases hclE hxc with h | h
        · exact h
        · exact absurd h hxS
      have hxO : x ∉ O := fun hxO => hxED ⟨hxE, hxO, hxS⟩
      filter_upwards [hKb.isOpen_compl.mem_nhds (fun h => hxO h.1)] with x' hx'
      exact hKbV x' hx'
    · filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hxc] with x' hx'
      by_contra h
      exact hx' (subset_closure (hVsupp x' h).1)
  have hEζ : ∀ x ∈ E, x ∉ O \ Sig → ∀ᶠ x' in 𝓝 x, ζ x' = 0 := by
    intro x hxE hxD
    have hxS : x ∉ Sig := fun hs => Set.disjoint_left.1 hESig hxE hs
    have hxO : x ∉ O := fun hxO => hxD ⟨hxO, hxS⟩
    filter_upwards [hKb.isOpen_compl.mem_nhds (fun h => hxO h.1)] with x' hx'
    exact hKbζ x' hx'
  have hVrep : ∀ p : M, ∀ x ∈ E ∩ (O \ Sig) ∩ (chartAt E3 p).source,
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) x (V x) : E3) =
        (-(ζ x)) • (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p x) i) := by
    intro p x hx
    rw [hVE x hx.1.1, ContinuousLinearMap.map_smul, hUdef]
    rw [((hs2 p).2 x ⟨hx.1.2, hx.2⟩).2.2.1]
  
  have hV1 : ∀ x, g.g x (V x) (V x) ≤ 1 := by
    intro x
    by_cases hx : x ∈ E ∩ (O \ Sig)
    · have hu := ((hs2 x).2 x ⟨hx.2, mem_chart_source E3 x⟩).2.2.2
      rw [hVE x hx.1, hUdef]
      simp only [map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [hu]
      nlinarith [hζ01 x]
    · rw [hV0 x hx]
      simp
  
  have hVs : ∀ p : M, ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
        ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3))
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Sigᶜ) := by
    intro p y hy
    refine ContDiffAt.contDiffWithinAt ?_
    obtain ⟨hyt, hyS⟩ := hy
    by_cases hx : (chartAt E3 p).symm y ∈ E ∩ (O \ Sig)
    · have hW : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (E ∩ (O \ Sig))) :=
        (chartAt E3 p).isOpen_inter_preimage_symm (hE.inter hDo)
      have hT' : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (O \ Sig)) :=
        (chartAt E3 p).isOpen_inter_preimage_symm hDo
      obtain ⟨hNo, hNs, -⟩ := ccs_normal_props (g.coeff (chartAt E3 p).symm)
        (fun y => w ((chartAt E3 p).symm y)) _ hT'
        (fun i j => (g.smooth p i j).mono Set.inter_subset_left)
        (fun z hz => coeff_chart_symm_posDef g p z hz.1) (hs2 p).1
        (fun z => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun i => calUnitNormal
          (g.coeff (chartAt E3 p).symm) (fun y => w ((chartAt E3 p).symm y)) z i))
        (fun z _ i => rfl)
      have hζp : ContDiffOn ℝ ∞ (fun z => ζ ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
        contMDiffOn_iff_contDiffOn.mp (hζs.comp_contMDiffOn contMDiffOn_chart_symm)
      have hev : (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
          ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3)) =ᶠ[𝓝 y]
          fun z => (-(ζ ((chartAt E3 p).symm z))) • (EuclideanSpace.equiv (Fin 3) ℝ).symm
            (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
              (fun y => w ((chartAt E3 p).symm y)) z i) := by
        filter_upwards [hW.mem_nhds ⟨hyt, hx⟩] with z hz
        have := hVrep p ((chartAt E3 p).symm z) ⟨hz.2, (chartAt E3 p).map_target hz.1⟩
        rw [(chartAt E3 p).right_inv hz.1] at this
        exact this
      refine ContDiffAt.congr_of_eventuallyEq ?_ hev
      have hA1 : ContDiffAt ℝ ∞ (fun z => -ζ ((chartAt E3 p).symm z)) y :=
        (hζp.contDiffAt ((chartAt E3 p).open_target.mem_nhds hyt)).neg
      have hA2 : ContDiffAt ℝ ∞ (fun z => (EuclideanSpace.equiv (Fin 3) ℝ).symm
          (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
            (fun y => w ((chartAt E3 p).symm y)) z i)) y := by
        apply hNs.contDiffAt
        apply hNo.mem_nhds
        refine ⟨⟨hyt, hx.2⟩, ?_⟩
        have := ((hs2 p).2 _ ⟨hx.2, (chartAt E3 p).map_target hyt⟩).1
        rwa [(chartAt E3 p).right_inv hyt] at this
      exact hA1.smul hA2
    · have hev := hVloc _ hyS hx
      have hcont : ContinuousAt (chartAt E3 p).symm y := (chartAt E3 p).continuousAt_symm hyt
      have h2 : ∀ᶠ z in 𝓝 y, V ((chartAt E3 p).symm z) = 0 := hcont.eventually hev
      refine (contDiffAt_const (c := (0 : E3))).congr_of_eventuallyEq ?_
      filter_upwards [h2] with z hz
      simp [hz]
  
  have hpiece := fun (p : M) (ψ : M → ℝ) (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ)
      (hψc : IsCompact (tsupport ψ)) (hψs : tsupport ψ ⊆ (chartAt E3 p).source) =>
    jump_piece_div g Sig E (O \ Sig) w ζ ψ V a b C₀ p hE hDo hSigc hESig hab (hs2 p).1
      (fun x hx => ((hs2 p).2 x hx).1) (fun x hx => ((hs2 p).2 x hx).2.1) hζs hζ01
      (fun x hx => hζO x hx.1) hζH (hVrep p) hVloc hEζ hψ hψc hψs
  refine ⟨V, hVs, fun p ψ hψ hψc hψs => (hpiece p ψ hψ hψc hψs).1, hV1, hVsupp, ?_⟩
  
  intro Ω' O'' n q φ hφ hO'' hKO'' h1
  
  have hint : ∀ (S K : Set E3) (f : E3 → ℝ) (B : ℝ), MeasurableSet S → IsCompact K →
      AEStronglyMeasurable f (volume.restrict S) →
      (∀ y ∈ S, |f y| ≤ K.indicator (fun _ => B) y) → IntegrableOn f S := by
    intro S K f B hS hK hm hb
    have hgi : IntegrableOn (K.indicator (fun _ : E3 => B)) S :=
      ((integrable_indicator_iff hK.measurableSet).2
        (integrableOn_const hK.measure_lt_top.ne)).integrableOn
    exact Integrable.mono' hgi hm ((ae_restrict_of_forall_mem hS) fun y hy => by
      rw [Real.norm_eq_abs]; exact hb y hy)
  have hsplit : ∀ (S : Set E3) (Df Af Bf Rf : E3 → ℝ), MeasurableSet S → IntegrableOn Df S →
      IntegrableOn Af S → IntegrableOn Bf S → (∀ y ∈ S, Df y = Af y - Bf y + Rf y) →
      ∫ y in S, Df y = (∫ y in S, Af y) - (∫ y in S, Bf y) + ∫ y in S, Rf y := by
    intro S Df Af Bf Rf hS hD hA hB h
    have hAB : IntegrableOn (fun y => Af y - Bf y) S := hA.sub hB
    have h3 : IntegrableOn (fun y => Df y - Af y + Bf y) S := (hD.sub hA).add hB
    have hR : IntegrableOn Rf S := by
      refine IntegrableOn.congr_fun h3 (fun y hy => ?_) hS
      rw [h y hy]
      ring
    rw [setIntegral_congr_fun hS h, integral_add hAB hR, integral_sub hA hB]
  
  have hchart : ∀ (p : M) (ψ : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ →
      IsCompact (tsupport ψ) → tsupport ψ ⊆ (chartAt E3 p).source → (∀ x, 0 ≤ ψ x ∧ ψ x ≤ 1) →
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
      (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        ψ ((chartAt E3 p).symm y) * Real.sqrt (g.gradInner ζ ζ ((chartAt E3 p).symm y)) *
          Real.sqrt (g.coeff (chartAt E3 p).symm y).det) -
      (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        ψ ((chartAt E3 p).symm y) *
          (ζ ((chartAt E3 p).symm y) * g.levelMeanCurv w ((chartAt E3 p).symm y)) *
          Real.sqrt (g.coeff (chartAt E3 p).symm y).det) +
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
          fderiv ℝ (fun z => ψ ((chartAt E3 p).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
              (V ((chartAt E3 p).symm y)) : E3) := by
    intro p ψ hψ hψc hψs hψ01
    obtain ⟨⟨CD, hCD⟩, hvan, hform⟩ := hpiece p ψ hψ hψc hψs
    have hSo : IsOpen (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) :=
      (chartAt E3 p).isOpen_image_of_subset_source (hE.inter (chartAt E3 p).open_source)
        Set.inter_subset_right
    have hSm := hSo.measurableSet
    have hST : chartAt E3 p '' (E ∩ (chartAt E3 p).source) ⊆ (chartAt E3 p).target := by
      rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 p).map_source hx.2
    have hSS : chartAt E3 p '' (E ∩ (chartAt E3 p).source) ⊆
        (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Sigᶜ := by
      rintro _ ⟨x, hx, rfl⟩
      refine ⟨(chartAt E3 p).map_source hx.2, ?_⟩
      show (chartAt E3 p).symm (chartAt E3 p x) ∉ Sig
      rw [(chartAt E3 p).left_inv hx.2]
      exact fun hs => Set.disjoint_left.1 hESig hx.1 hs
    have hSsig : ∀ y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) := by
      rintro _ ⟨x, hx, rfl⟩ ⟨x', hx', hxx'⟩
      have hx'x : x' = x := (chartAt E3 p).injOn hx'.2 hx.2 hxx'
      rw [hx'x] at hx'
      exact Set.disjoint_left.1 hESig hx.1 hx'.1
    have hKc : IsCompact (chartAt E3 p '' tsupport ψ) :=
      hψc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hψs)
    have hKt : chartAt E3 p '' tsupport ψ ⊆ (chartAt E3 p).target := by
      rintro _ ⟨x, hx, rfl⟩; exact (chartAt E3 p).map_source (hψs hx)
    have hψK : ∀ y ∈ (chartAt E3 p).target, y ∉ chartAt E3 p '' tsupport ψ →
