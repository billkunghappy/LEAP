        rw [hu (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k))]
        simp only [hcompo _ z (hψd z hz)]
      simp only [hcD]
      show g.g (Φ z) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e j)) = _
      rw [hΦD, hΦD, hJ i, hJ j]
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul]
      simp only [Fin.sum_univ_three]
      ring
    
    have s3 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z).det
          ≠ 0 := by
      intro z hz hdet
      obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
      have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ hz.1
      have hinj : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u = 0 → u = 0 := by
        intro u hu0
        rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hu0
        exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hu0
      have hw : fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (∑ i : Fin 3, v i • e i) = 0 := by
        ext a
        rw [map_sum]
        simp only [map_smul]
        have := congrFun hJv a
        simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
          hcompo _ z (hψd z hz)] at this
        simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
          WithLp.ofLp_zero, Pi.zero_apply]
        rw [← this]
        apply Finset.sum_congr rfl
        intro i _
        ring
      have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
        apply hinj
        rw [hM1' z hz, hw]
        exact ContinuousLinearMap.map_zero _
      apply hv0
      funext a
      rw [← hcomp_e v a, h0]
      rfl
    
    have hVo : IsOpen ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target) :=
      (chartAt E3 (Φ x)).continuousOn_symm.isOpen_inter_preimage (chartAt E3 (Φ x)).open_target
        Φ.open_target
    have hσ : ContDiffOn ℝ ∞ (fun v => Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v))
        ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target) := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ.toPartialEquiv.symm Φ.target :=
        Φ.contMDiffOn_invFun
      have h3 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (Φ x)).symm
          (chartAt E3 (Φ x)).target := contMDiffOn_chart_symm
      have hcomp := h1.comp (h3.mono Set.inter_subset_left) (fun v hv => hv.2)
      exact contMDiffOn_iff_contDiffOn.mp hcomp
    have hyV : chartAt E3 (Φ x) (Φ x) ∈
        (chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target := by
      refine ⟨(chartAt E3 (Φ x)).map_source (mem_chart_source E3 (Φ x)), ?_⟩
      show (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)) ∈ Φ.target
      rw [(chartAt E3 (Φ x)).left_inv (mem_chart_source E3 (Φ x))]
      exact Φ.toPartialEquiv.map_source hx
    have hσy : Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x))) = x := by
      rw [(chartAt E3 (Φ x)).left_inv (mem_chart_source E3 (Φ x))]
      exact Φ.toPartialEquiv.left_inv hx
    have hσd : DifferentiableAt ℝ (fun v => Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v))
        (chartAt E3 (Φ x) (Φ x)) :=
      (hσ.contDiffAt (hVo.mem_nhds hyV)).differentiableAt (by simp)
    
    have chain : ∀ (u0 : M → ℝ) (j : Fin 3), partialDeriv j (fun y => u0 (Φ y)) x =
        ∑ a : Fin 3, partialDeriv a (fun v => u0 ((chartAt E3 (Φ x)).symm v))
            (chartAt E3 (Φ x) (Φ x)) *
          partialDeriv j (fun w' => chartAt E3 (Φ x) (Φ w') a) x := by
      intro u0 j
      by_cases hd : DifferentiableAt ℝ (fun v => u0 ((chartAt E3 (Φ x)).symm v))
          (chartAt E3 (Φ x) (Φ x))
      · have hev : (fun y => u0 (Φ y)) =ᶠ[𝓝 x]
            (fun y => (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ y))) := by
          filter_upwards [h2.1.mem_nhds hxU] with y hy
          show u0 (Φ y) = u0 ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ y)))
          rw [(chartAt E3 (Φ x)).left_inv hy.2]
        have e1 : partialDeriv j (fun y => u0 (Φ y)) x = partialDeriv j
            (fun y => (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ y))) x := by
          unfold partialDeriv
          rw [hev.fderiv_eq]
        rw [e1]
        exact pd_comp _ (fun w' => chartAt E3 (Φ x) (Φ w')) x (hψd x hxU) hd j
      · have hnd : ¬ DifferentiableAt ℝ (fun y => u0 (Φ y)) x := by
          intro hdx
          apply hd
          have hdx' : DifferentiableAt ℝ (fun y => u0 (Φ y))
              (Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)))) := by
            rw [hσy]; exact hdx
          have hc := hdx'.comp (chartAt E3 (Φ x) (Φ x)) hσd
          refine hc.congr_of_eventuallyEq ?_
          filter_upwards [hVo.mem_nhds hyV] with v hv
          have hr := Φ.toPartialEquiv.right_inv hv.2
          show u0 ((chartAt E3 (Φ x)).symm v) =
            u0 (Φ (Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v)))
          exact congrArg u0 hr.symm
        have e1 : fderiv ℝ (fun y => u0 (Φ y)) x = 0 := fderiv_zero_of_not_differentiableAt hnd
        have e2 : fderiv ℝ (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) = 0 :=
          fderiv_zero_of_not_differentiableAt hd
        simp only [partialDeriv, e1, e2, ContinuousLinearMap.zero_apply, zero_mul,
          Finset.sum_const_zero]
    have halg := bil_alg
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w' => chartAt E3 (Φ x) (Φ w') a) x)
      (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x))) (g.coeff Φ x)
      (fun a => partialDeriv a (fun v => u ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)))
      (fun b => partialDeriv b (fun v => w ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)))
      (fun i => partialDeriv i (fun y => u (Φ y)) x)
      (fun j => partialDeriv j (fun y => w (Φ y)) x)
      (s3 x hxU) (fun i j => s1 x hxU i j) (fun i => chain u i) (fun j => chain w j)
    have hL : g.gradInner u w (Φ x) = ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)))⁻¹ a b *
          partialDeriv a (fun v => u ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) *
          partialDeriv b (fun v => w ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) := rfl
    rw [hL]
    exact halg.symm
  have hpair := pair Φ (g.levelMeanCurv f) f y₀ hy₀src
  have hLΦ : (fun y => g.levelMeanCurv f (Φ y)) =ᶠ[𝓝 y₀]
      levelMeanCurvCoord G (fun y' => f (Φ y')) :=
    Filter.eventually_of_mem (Φ.open_source.mem_nhds hy₀src) (fun y hy =>
      levelMeanCurv_eq_coord g Φ f (fun y' => f (Φ y')) hf y hy
        (Filter.Eventually.of_forall (fun _ => rfl)))
  have hstar : ∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
      partialDeriv i (levelMeanCurvCoord G (fun y' => f (Φ y'))) y₀ *
      partialDeriv j (fun y' => f (Φ y')) y₀ = 0 := by
    have h := hjac
    rw [hja, hpair] at h
    refine Eq.trans ?_ h
    simp only [partialDeriv, hLΦ.fderiv_eq]
    rfl
  
  have hbd : DifferentiableAt ℝ b y₀ :=
    (hb.contDiffAt (Metric.isOpen_ball.mem_nhds hy₀U)).differentiableAt (by simp)
  have hfhat : HasFDerivAt (fun y' => f (Φ y'))
      (ε • (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ)) y₀ := by
    have h1 := (hf1d y₀).add ((hf1d y₀).mul ((hf1d y₀).mul hbd.hasFDerivAt))
    have hev : (fun y' => f (Φ y')) =ᶠ[𝓝 y₀]
        (fun y => ε * y 0 + ε * y 0 * (ε * y 0 * b y)) :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hy₀U)
        (fun y hy => by
          show f (Φ y) = ε * y 0 + ε * y 0 * (ε * y 0 * b y)
          rw [hform y hy]; ring)
    refine (h1.congr_of_eventuallyEq hev).congr_fderiv ?_
    simp [hy₀0]
  have hpfhat : ∀ j : Fin 3, partialDeriv j (fun y' => f (Φ y')) y₀ = ε * (e j) 0 := by
    intro j
    show fderiv ℝ (fun y' => f (Φ y')) y₀ (e j) = ε * (e j) 0
    rw [hfhat.fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rfl
  have hpHf : ∀ i : Fin 3, partialDeriv i (levelMeanCurvCoord G (fun y' => f (Φ y'))) y₀ =
      ε * partialDeriv i H y₀ := by
    intro i
    rw [(hjet y₀ hy₀U hy₀0).2 i]
    have hfun : levelMeanCurvCoord G (fun y : E3 => ε * y 0) = fun y => ε * H y := funext hH1
    rw [hfun]
    show fderiv ℝ (fun y => ε * H y) y₀ (e i) = ε * fderiv ℝ H y₀ (e i)
    rw [fderiv_const_mul hHd, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hd0 : partialDeriv 0 H y₀ = 0 := by
    have h1 := htan 1 (by decide)
    have h2 := htan 2 (by decide)
    have hs := hstar
    simp only [hpHf, hpfhat, Fin.sum_univ_three, h1, h2, he00, he10, he20] at hs
    have hpos : 0 < (G y₀)⁻¹ 0 0 := (hGpd y₀ hy₀src).inv.diag_pos
    have h3 : ε ^ 2 * ((G y₀)⁻¹ 0 0 * partialDeriv 0 H y₀) = 0 := by linear_combination hs
    rw [hε2, one_mul] at h3
    exact (mul_eq_zero.mp h3).resolve_left hpos.ne'
  
  refine ⟨hH0 y₀ hy₀U hy₀0, ?_⟩
  have hγ : HasDerivAt (fun s : ℝ => hpLift s x₀) (e 0) 0 := by
    have h := (((hasDerivAt_id (0 : ℝ)).smul_const (e 0)).add_const ((x₀ 0) • e 1)).add_const
      ((x₀ 1) • e 2)
    simp only [id, one_smul] at h
    exact h
  have hfin := hHd.hasFDerivAt.comp_hasDerivAt_of_eq (0 : ℝ) hγ rfl
  have hd0' : fderiv ℝ H y₀ (e 0) = 0 := hd0
  rw [hd0'] at hfin
  exact hfin

theorem ls_ift_scale (B : BanachScale)
    (hιE : ∀ k, Function.Injective (B.ιE k)) (hιE0 : ∀ v, B.ιE 0 v = v)
    (Hop : ∀ k, B.E k → B.F k) (r : ℝ) (hr : 0 < r)
    (hHs : ∀ k, ContDiffOn ℝ ∞ (Hop k) {v | ‖B.ιE k v‖ < r})
    (hHc : ∀ k (v : B.E k), B.ιF k (Hop k v) = Hop 0 (B.ιE k v))
    (e₁ : ∀ k, B.E k) (he₁ : ∀ k, B.ιE k (e₁ k) = e₁ 0)
    (c : ∀ k, B.F k) (hc : ∀ k, B.ιF k (c k) = c 0)
    (ℓ : B.E 0 →L[ℝ] ℝ) (hℓ : ℓ (e₁ 0) = 1)
    (hH0 : Hop 0 0 = 0) (hD0 : fderiv ℝ (Hop 0) 0 (e₁ 0) = 0)
    (hiso : ∀ k (v : B.E k), ‖B.ιE k v‖ < r → ∀ f : B.F k,
      ∃! p : B.E k × ℝ, ℓ (B.ιE k p.1) = 0 ∧ fderiv ℝ (Hop k) v p.1 - p.2 • c k = f)
    (hreg : ∀ k (v : B.E 0), ‖v‖ < r → ∀ a : ℝ, Hop 0 v = a • c 0 → ∃ w : B.E k, B.ιE k w = v)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ (t₁ : ℝ) (V : ℝ → B.E 0) (h : ℝ → ℝ), 0 < t₁ ∧ V 0 = 0 ∧ h 0 = 0 ∧
      ContDiffOn ℝ ∞ h (Set.Ioo (-t₁) t₁) ∧
      (∀ t ∈ Set.Ioo (-t₁) t₁, ‖t • e₁ 0 + V t‖ < r ∧
        Hop 0 (t • e₁ 0 + V t) = h t • c 0 ∧ ‖deriv V t‖ < ε) ∧
      (∀ k, ∃ Vk : ℝ → B.E k, ContDiffOn ℝ ∞ Vk (Set.Ioo (-t₁) t₁) ∧
        ∀ t ∈ Set.Ioo (-t₁) t₁, B.ιE k (Vk t) = V t) :=
by
  
  have hUo : ∀ k, IsOpen {v : B.E k | ‖B.ιE k v‖ < r} := fun k =>
    isOpen_lt (continuous_norm.comp (B.ιE k).continuous) continuous_const
  have hCA : ∀ k (v : B.E k), ‖B.ιE k v‖ < r → ContDiffAt ℝ ∞ (Hop k) v :=
    fun k v hv => (hHs k).contDiffAt ((hUo k).mem_nhds hv)
  have hDA : ∀ k (v : B.E k), ‖B.ιE k v‖ < r → HasFDerivAt (Hop k) (fderiv ℝ (Hop k) v) v :=
    fun k v hv => ((hCA k v hv).differentiableAt (by simp)).hasFDerivAt
  have h0mem : ∀ k, ‖B.ιE k (0 : B.E k)‖ < r := fun k => by simpa using hr
  
  have hιF : ∀ k, Function.Injective (B.ιF k) := by
    intro k
    rw [injective_iff_map_eq_zero]
    intro f hf
    have H1 : HasFDerivAt (fun v => B.ιF k (Hop k v)) ((B.ιF k).comp (fderiv ℝ (Hop k) 0)) 0 :=
      (B.ιF k).hasFDerivAt.comp 0 (hDA k 0 (h0mem k))
    have h0' : HasFDerivAt (Hop 0) (fderiv ℝ (Hop 0) 0) (B.ιE k 0) := by
      rw [map_zero]; exact hDA 0 0 (h0mem 0)
    have H2 : HasFDerivAt (fun v => Hop 0 (B.ιE k v)) ((fderiv ℝ (Hop 0) 0).comp (B.ιE k)) 0 :=
      h0'.comp 0 (B.ιE k).hasFDerivAt
    have hfun : (fun v => B.ιF k (Hop k v)) = (fun v => Hop 0 (B.ιE k v)) := funext (hHc k)
    rw [hfun] at H1
    have hcomp := H1.unique H2
    have hpt : ∀ w, B.ιF k (fderiv ℝ (Hop k) 0 w) = fderiv ℝ (Hop 0) 0 (B.ιE k w) := fun w => by
      have := congrArg (fun L => L w) hcomp
      simpa using this
    obtain ⟨⟨w, a⟩, ⟨hw1, hw2⟩, -⟩ := hiso k 0 (h0mem k) f
    simp only at hw1 hw2
    have hl0 : (fderiv ℝ (Hop 0) 0) (B.ιE k w) - a • c 0 = 0 := by
      rw [← hpt, ← hc k, ← map_smul, ← map_sub, hw2, hf]
    have huniq := (hiso 0 0 (h0mem 0) 0).unique (y₁ := (B.ιE k w, a)) (y₂ := (0, 0))
      ⟨by simpa [hιE0] using hw1, hl0⟩ ⟨by simp, by simp⟩
    simp only [Prod.mk.injEq] at huniq
    have hw0 : w = 0 := hιE k (by rw [huniq.1, map_zero])
    rw [← hw2, hw0, huniq.2]; simp
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ∀ k, ℝ × (B.E k × ℝ) → B.F k × ℝ, ∀ k p, Φ k p =
      (Hop k (p.1 • e₁ k + p.2.1) - p.2.2 • c k, ℓ (B.ιE k p.2.1)) := ⟨_, fun _ _ => rfl⟩
  have hΦz : ∀ k (t : ℝ) (p : B.E k × ℝ), Φ k (t, p) = 0 ↔
      Hop k (t • e₁ k + p.1) = p.2 • c k ∧ ℓ (B.ιE k p.1) = 0 := by
    intro k t p
    rw [hΦ, Prod.mk_eq_zero, sub_eq_zero]
  
  have IFTk : ∀ k (q : ℝ × (B.E k × ℝ)), ‖B.ιE k (q.1 • e₁ k + q.2.1)‖ < r → Φ k q = 0 →
      ∃ ψ : ℝ → B.E k × ℝ, ψ q.1 = q.2 ∧ ContDiffAt ℝ ∞ ψ q.1 ∧
        (∀ᶠ t in 𝓝 q.1, Φ k (t, ψ t) = 0) ∧
        ∀ γ : ℝ → B.E k × ℝ, ContinuousAt γ q.1 → γ q.1 = q.2 →
          (∀ᶠ t in 𝓝 q.1, Φ k (t, γ t) = 0) → γ =ᶠ[𝓝 q.1] ψ := by
    intro k q hq hq0
    let A : ℝ × (B.E k × ℝ) →L[ℝ] B.E k :=
      (ContinuousLinearMap.fst ℝ ℝ (B.E k × ℝ)).smulRight (e₁ k) +
        (ContinuousLinearMap.fst ℝ (B.E k) ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (B.E k × ℝ))
    let S : ℝ × (B.E k × ℝ) →L[ℝ] B.F k :=
      ((ContinuousLinearMap.snd ℝ (B.E k) ℝ).comp
        (ContinuousLinearMap.snd ℝ ℝ (B.E k × ℝ))).smulRight (c k)
    let L : ℝ × (B.E k × ℝ) →L[ℝ] ℝ :=
      (ℓ.comp (B.ιE k)).comp
        ((ContinuousLinearMap.fst ℝ (B.E k) ℝ).comp (ContinuousLinearMap.snd ℝ ℝ (B.E k × ℝ)))
    have hA : ∀ p, A p = p.1 • e₁ k + p.2.1 := fun p => by simp [A]
    have hS : ∀ p, S p = p.2.2 • c k := fun p => by simp [S]
    have hL : ∀ p, L p = ℓ (B.ιE k p.2.1) := fun p => by simp [L]
    have hΦfun : Φ k = fun p => (Hop k (A p) - S p, L p) := by
      funext p; rw [hΦ, hA, hS, hL]
    set D := fderiv ℝ (Hop k) (q.1 • e₁ k + q.2.1) with hDdef
    have hHop : HasFDerivAt (Hop k) D (A q) := by rw [hA]; exact hDA k _ hq
    have hHopC : ContDiffAt ℝ ∞ (Hop k) (A q) := by rw [hA]; exact hCA k _ hq
    have hfd : HasFDerivAt (Φ k) (((D.comp A) - S).prod L) q := by
      rw [hΦfun]
      exact ((hHop.comp q A.hasFDerivAt).sub S.hasFDerivAt).prodMk L.hasFDerivAt
    have hcd : ContDiffAt ℝ ∞ (Φ k) q := by
      rw [hΦfun]
      exact ((hHopC.comp q A.contDiff.contDiffAt).sub S.contDiff.contDiffAt).prodMk
        L.contDiff.contDiffAt
    have hTapp : ∀ p : B.E k × ℝ,
        ((((D.comp A) - S).prod L).comp (ContinuousLinearMap.inr ℝ ℝ (B.E k × ℝ))) p =
          (D p.1 - p.2 • c k, ℓ (B.ιE k p.1)) := by
      intro p
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply,
        ContinuousLinearMap.prod_apply, ContinuousLinearMap.sub_apply, hA, hS, hL,
        zero_smul, zero_add]
    have hbij : Function.Bijective
        ((((D.comp A) - S).prod L).comp (ContinuousLinearMap.inr ℝ ℝ (B.E k × ℝ))) := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro p hp
        rw [hTapp] at hp
        have h1 : D p.1 - p.2 • c k = 0 := congrArg Prod.fst hp
        have h2 : ℓ (B.ιE k p.1) = 0 := congrArg Prod.snd hp
        exact (hiso k _ hq 0).unique ⟨h2, h1⟩ ⟨by simp, by simp⟩
      · rintro ⟨f, s⟩
        obtain ⟨⟨w₀, a₀⟩, ⟨h1, h2⟩, -⟩ := hiso k _ hq (f - s • D (e₁ k))
        simp only at h1 h2
        refine ⟨(w₀ + s • e₁ k, a₀), ?_⟩
        rw [hTapp]
        refine Prod.ext ?_ ?_
        · simp only
          rw [map_add, map_smul, add_sub_right_comm, h2, sub_add_cancel]
        · simp only
          rw [map_add, map_smul, map_add, map_smul, h1, he₁, hℓ]
          simp
    have hI : IsContDiffImplicitAt ∞ (Φ k) (((D.comp A) - S).prod L) q :=
      IsContDiffImplicitAt.mk hfd hcd hbij (by simp)
    refine ⟨hI.implicitFunction, ?_, hI.contDiffAt_implicitFunction, ?_, ?_⟩
    · exact hI.eventually_implicitFunction_apply_eq.self_of_nhds rfl
    · filter_upwards [hI.apply_implicitFunction] with t ht
      rw [ht, hq0]
    · intro γ hγ hγ0 hγe
      have hσc : ContinuousAt (fun t => (t, γ t)) q.1 := continuousAt_id.prodMk hγ
      have hσ : Tendsto (fun t => (t, γ t)) (𝓝 q.1) (𝓝 q) := by
        have := hσc.tendsto
        rwa [show ((q.1, γ q.1) : ℝ × (B.E k × ℝ)) = q by rw [hγ0]] at this
      filter_upwards [hσ.eventually hI.eventually_implicitFunction_apply_eq, hγe] with t h1 h2
      exact (h1 (by rw [h2, hq0])).symm
  
  obtain ⟨ψ₀, hψ₀0, hψ₀s, hψ₀e, -⟩ := IFTk 0 ((0 : ℝ), ((0 : B.E 0), (0 : ℝ)))
    (by simpa using hr) (by rw [hΦ]; simp [hH0])
  simp only at hψ₀0 hψ₀s hψ₀e
  have hV0 : (ψ₀ 0).1 = 0 := by rw [hψ₀0]
  have hh0 : (ψ₀ 0).2 = 0 := by rw [hψ₀0]
  
  have hV'0 : deriv (fun t => (ψ₀ t).1) 0 = 0 := by
    have hψ₀d : DifferentiableAt ℝ ψ₀ 0 := hψ₀s.differentiableAt (by simp)
    have hVd : HasDerivAt (fun t => (ψ₀ t).1) (deriv (fun t => (ψ₀ t).1) 0) 0 :=
      hψ₀d.fst.hasDerivAt
    have hhd : HasDerivAt (fun t => (ψ₀ t).2) (deriv (fun t => (ψ₀ t).2) 0) 0 :=
      hψ₀d.snd.hasDerivAt
    have hD00 : HasFDerivAt (Hop 0) (fderiv ℝ (Hop 0) 0) ((0 : ℝ) • e₁ 0 + (ψ₀ 0).1) := by
      rw [hV0, zero_smul, add_zero]; exact hDA 0 0 (h0mem 0)
    have hu : HasDerivAt (fun t : ℝ => t • e₁ 0 + (ψ₀ t).1)
        ((1 : ℝ) • e₁ 0 + deriv (fun t => (ψ₀ t).1) 0) 0 :=
      ((hasDerivAt_id (0 : ℝ)).smul_const (e₁ 0)).add hVd
    have hg : HasDerivAt (fun t => Hop 0 (t • e₁ 0 + (ψ₀ t).1) - (ψ₀ t).2 • c 0)
        (fderiv ℝ (Hop 0) 0 ((1 : ℝ) • e₁ 0 + deriv (fun t => (ψ₀ t).1) 0) -
          deriv (fun t => (ψ₀ t).2) 0 • c 0) 0 :=
      (hD00.comp_hasDerivAt 0 hu).sub (hhd.smul_const (c 0))
    have hgz : (fun t => Hop 0 (t • e₁ 0 + (ψ₀ t).1) - (ψ₀ t).2 • c 0) =ᶠ[𝓝 0]
        fun _ => (0 : B.F 0) := by
      filter_upwards [hψ₀e] with t ht
      rw [hΦz] at ht
      rw [ht.1, sub_self]
    have h1 := hg.unique ((hasDerivAt_const (0 : ℝ) (0 : B.F 0)).congr_of_eventuallyEq hgz)
    rw [one_smul, map_add, hD0, zero_add] at h1
    have hlz : (⇑ℓ ∘ fun t => (ψ₀ t).1) =ᶠ[𝓝 0] fun _ => (0 : ℝ) := by
      filter_upwards [hψ₀e] with t ht
      rw [hΦz, hιE0] at ht
      exact ht.2
    have h2 := (ℓ.hasFDerivAt.comp_hasDerivAt 0 hVd).unique
      ((hasDerivAt_const (0 : ℝ) (0 : ℝ)).congr_of_eventuallyEq hlz)
    have huniq := (hiso 0 0 (h0mem 0) 0).unique
      (y₁ := (deriv (fun t => (ψ₀ t).1) 0, deriv (fun t => (ψ₀ t).2) 0)) (y₂ := (0, 0))
      ⟨by simpa [hιE0] using h2, h1⟩ ⟨by simp, by simp⟩
    exact congrArg Prod.fst huniq
  
  have E1 : ∀ᶠ t in 𝓝 (0 : ℝ), ContinuousAt ψ₀ t := by
    have h1 : ContDiffAt ℝ 1 ψ₀ 0 := hψ₀s.of_le (by exact_mod_cast le_top)
    filter_upwards [h1.eventually (by simp)] with t ht
    exact ht.continuousAt
  have E2 : ∀ᶠ t in 𝓝 (0 : ℝ), ‖t • e₁ 0 + (ψ₀ t).1‖ < r := by
    have hc0 : ContinuousAt (fun t : ℝ => ‖t • e₁ 0 + (ψ₀ t).1‖) 0 :=
      ((continuousAt_id.smul continuousAt_const).add hψ₀s.continuousAt.fst).norm
    exact hc0.eventually_lt continuousAt_const (by simpa [hV0] using hr)
  have E3 : ∀ᶠ t in 𝓝 (0 : ℝ), ‖deriv (fun s => (ψ₀ s).1) t‖ < ε := by
    obtain ⟨u, hu, hu1⟩ := hψ₀s.fst.contDiffOn (m := 1) (by exact_mod_cast le_top) (by simp)
    obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.mp hu
    have hcont : ContinuousAt (deriv (fun s => (ψ₀ s).1)) 0 :=
      ((hu1.mono hball).continuousOn_deriv_of_isOpen isOpen_ball le_rfl).continuousAt
        (ball_mem_nhds 0 hδ)
    exact hcont.norm.eventually_lt continuousAt_const (by rw [hV'0, norm_zero]; exact hε)
  obtain ⟨δ, hδ, hall⟩ := Metric.eventually_nhds_iff.mp (hψ₀e.and (E1.and (E2.and E3)))
  have hgood : ∀ t ∈ Set.Ioo (-δ) δ, Φ 0 (t, ψ₀ t) = 0 ∧ ContinuousAt ψ₀ t ∧
      ‖t • e₁ 0 + (ψ₀ t).1‖ < r ∧ ‖deriv (fun s => (ψ₀ s).1) t‖ < ε := by
    intro t ht
    apply hall
    rw [Real.dist_eq, sub_zero, abs_lt]
    exact ⟨ht.1, ht.2⟩
  have hEvI : ∀ t ∈ Set.Ioo (-δ) δ, ∀ᶠ s in 𝓝 t, Φ 0 (s, ψ₀ s) = 0 := fun t ht =>
    Filter.eventually_of_mem (Ioo_mem_nhds ht.1 ht.2) (fun s hs => (hgood s hs).1)
  
  have hloc0 : ∀ t ∈ Set.Ioo (-δ) δ, ∃ ψ' : ℝ → B.E 0 × ℝ, ContDiffAt ℝ ∞ ψ' t ∧
      ψ₀ =ᶠ[𝓝 t] ψ' ∧ ∀ γ : ℝ → B.E 0 × ℝ, ContinuousAt γ t → γ t = ψ₀ t →
        (∀ᶠ s in 𝓝 t, Φ 0 (s, γ s) = 0) → γ =ᶠ[𝓝 t] ψ' := by
    intro t ht
    obtain ⟨ψ', -, h2, -, h4⟩ := IFTk 0 (t, ψ₀ t)
      (by simpa [hιE0] using (hgood t ht).2.2.1) (hgood t ht).1
    exact ⟨ψ', h2, h4 ψ₀ (hgood t ht).2.1 rfl (hEvI t ht), h4⟩
  have hψ₀C : ∀ t ∈ Set.Ioo (-δ) δ, ContDiffAt ℝ ∞ ψ₀ t := by
    intro t ht
    obtain ⟨ψ', h2, heq, -⟩ := hloc0 t ht
    exact h2.congr_of_eventuallyEq heq
  refine ⟨δ, fun t => (ψ₀ t).1, fun t => (ψ₀ t).2, hδ, hV0, hh0,
    fun t ht => (hψ₀C t ht).snd.contDiffWithinAt, ?_, ?_⟩
  · intro t ht
    obtain ⟨hz, -, hn, hd⟩ := hgood t ht
    rw [hΦz] at hz
    exact ⟨hn, hz.1, hd⟩
  · intro k
    haveI : Nonempty (B.E k) := ⟨0⟩
    
    have hlift : ∀ t ∈ Set.Ioo (-δ) δ, ∃ φ : ℝ → B.E k, ContDiffAt ℝ ∞ φ t ∧
        ∀ᶠ s in 𝓝 t, B.ιE k (φ s) = (ψ₀ s).1 := by
      intro t ht
      obtain ⟨hz, -, hnorm, -⟩ := hgood t ht
      rw [hΦz] at hz
      obtain ⟨w', hw'⟩ := hreg k _ hnorm _ hz.1
      have hιw : B.ιE k (w' - t • e₁ k) = (ψ₀ t).1 := by
        rw [map_sub, map_smul, he₁, hw', add_sub_cancel_left]
      have hsum : t • e₁ k + (w' - t • e₁ k) = w' := add_sub_cancel _ _
      have hqn : ‖B.ιE k ((t, (w' - t • e₁ k, (ψ₀ t).2)).1 • e₁ k +
          (t, (w' - t • e₁ k, (ψ₀ t).2)).2.1)‖ < r := by
        simp only
        rw [hsum, hw']
        exact hnorm
      have hqz : Φ k (t, (w' - t • e₁ k, (ψ₀ t).2)) = 0 := by
        rw [hΦz]
        refine ⟨?_, ?_⟩
        · simp only
          rw [hsum]
          apply hιF k
          rw [hHc, hw', map_smul, hc, hz.1]
        · simp only
          rw [hιw]
          have := hz.2
          rwa [hιE0] at this
      obtain ⟨ψk, hψk0, hψks, hψke, -⟩ := IFTk k _ hqn hqz
      simp only at hψk0 hψks hψke
      obtain ⟨ψ', -, heq, huniq⟩ := hloc0 t ht
      have hγc : ContinuousAt (fun s => (B.ιE k (ψk s).1, (ψk s).2)) t :=
        ((B.ιE k).continuous.continuousAt.comp hψks.continuousAt.fst).prodMk
          hψks.continuousAt.snd
      have hγt : (fun s => (B.ιE k (ψk s).1, (ψk s).2)) t = ψ₀ t := by
        simp only
        rw [hψk0]
        simp only
        rw [hιw]
      have hγe : ∀ᶠ s in 𝓝 t, Φ 0 (s, (fun s => (B.ιE k (ψk s).1, (ψk s).2)) s) = 0 := by
        filter_upwards [hψke] with s hs
        rw [hΦz] at hs ⊢
        simp only
        refine ⟨?_, ?_⟩
        · rw [← he₁ k, ← (B.ιE k).map_smul, ← map_add, ← hHc k, hs.1, map_smul, hc]
        · rw [hιE0]; exact hs.2
      have hfin := (huniq _ hγc hγt hγe).trans heq.symm
      refine ⟨fun s => (ψk s).1, hψks.fst, ?_⟩
      filter_upwards [hfin] with s hs
      exact congrArg Prod.fst hs
    refine ⟨fun t => Function.invFun (B.ιE k) ((ψ₀ t).1), ?_, ?_⟩
    · intro t ht
      obtain ⟨φ, hφs, hφe⟩ := hlift t ht
      have hev : (fun t => Function.invFun (B.ιE k) ((ψ₀ t).1)) =ᶠ[𝓝 t] φ := by
        filter_upwards [hφe] with s hs
        rw [← hs]
        exact Function.leftInverse_invFun (hιE k) (φ s)
      exact (hφs.congr_of_eventuallyEq hev).contDiffWithinAt
    · intro t ht
      obtain ⟨φ, -, hφe⟩ := hlift t ht
      exact Function.invFun_eq ⟨φ t, hφe.self_of_nhds⟩

theorem pcr_lmc_patch_compat {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (s₁ : ℝ)
    (G : Fin P.n → E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hGs : ∀ j (a b : Fin 3), ContDiffOn ℝ ∞ (fun y => G j y a b)
      {y : E3 | |y 0| < s₁ ∧ hpProj y ∈ P.W j})
    (hGsymm : ∀ j (y : E3) (a b : Fin 3), G j y a b = G j y b a)
    (hGpd : ∀ j, ∀ y : E3, |y 0| < s₁ → hpProj y ∈ P.W j → (G j y).PosDef)
    (hGc : ∀ j k, ∀ s ∈ Set.Ioo (-s₁) s₁, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      G j (hpLift s x) = pullbackMetric (G k)
        (fun y => hpLift (y 0) (P.proj k (P.param j (hpProj y)))) (hpLift s x))
    (u : X → ℝ) (hu : ∀ j, ContDiffOn ℝ 2 (fun x => u (P.param j x)) (P.W j))
    (hus : ∀ q ∈ S, |u q| < s₁) (j k : Fin P.n) (x : E2)
    (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) :
    pcrH (G j) (fun x' => u (P.param j x')) x =
      pcrH (G k) (fun x' => u (P.param k x')) (P.proj k (P.param j x)) :=
by
  
  have hdec : ∀ v : E3, v = ∑ d : Fin 3, v d • e d := by
    intro v
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v]
    simp [EuclideanSpace.basisFun_apply]
  have hcompo : ∀ (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z → ∀ l d : Fin 3,
      partialDeriv l (fun v => ψ v d) z = (fderiv ℝ ψ z (e l)) d := by
    intro ψ z hψ l d
    have hfun : (fun v => ψ v d) = (EuclideanSpace.proj d : E3 →L[ℝ] ℝ) ∘ ψ := by
      funext v; simp
    rw [partialDeriv, hfun, fderiv_comp z (EuclideanSpace.proj d).differentiableAt hψ,
      ContinuousLinearMap.fderiv]
    simp
  have dmul : ∀ (f g : E3 → ℝ) (z : E3), DifferentiableAt ℝ f z → DifferentiableAt ℝ g z →
      DifferentiableAt ℝ (fun w => f w * g w) z := fun f g z hf hg => hf.mul hg
  have pd_mul : ∀ (f g : E3 → ℝ) (z : E3) (l : Fin 3), DifferentiableAt ℝ f z →
      DifferentiableAt ℝ g z →
      partialDeriv l (fun w => f w * g w) z = partialDeriv l f z * g z + f z * partialDeriv l g z := by
    intro f g z l hf hg
    simp only [partialDeriv, fderiv_fun_mul hf hg, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pd_sum : ∀ (f : Fin 3 → E3 → ℝ) (z : E3) (l : Fin 3), (∀ a, DifferentiableAt ℝ (f a) z) →
      partialDeriv l (fun w => ∑ a : Fin 3, f a w) z = ∑ a : Fin 3, partialDeriv l (f a) z := by
    intro f z l hf
    simp only [partialDeriv, fderiv_fun_sum (fun a _ => hf a), ContinuousLinearMap.sum_apply]
  have pd_comp : ∀ (F : E3 → ℝ) (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z →
      DifferentiableAt ℝ F (ψ z) → ∀ l : Fin 3,
      partialDeriv l (fun w => F (ψ w)) z
        = ∑ d : Fin 3, partialDeriv d F (ψ z) * partialDeriv l (fun v => ψ v d) z := by
    intro F ψ z hψ hF l
    have h1 : partialDeriv l (fun w => F (ψ w)) z = fderiv ℝ F (ψ z) (fderiv ℝ ψ z (e l)) := by
      show fderiv ℝ (F ∘ ψ) z (e l) = _
      rw [fderiv_comp z hF hψ]
      rfl
    rw [h1, hdec (fderiv ℝ ψ z (e l)), map_sum]
    simp only [map_smul, smul_eq_mul, hcompo ψ z hψ]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  have hpdU : ∀ (U : Set E3), IsOpen U → ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro U hU f hf i
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) U := hf.fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  
  have pullback_partialDeriv : ∀ (ψ : E3 → E3) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U V : Set E3),
      IsOpen U → IsOpen V → ContDiffOn ℝ ∞ ψ U → (∀ z ∈ U, ψ z ∈ V) →
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) V) → ∀ z ∈ U, ∀ l i j : Fin 3,
      partialDeriv l (fun w => ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w) z =
        ∑ a : Fin 3, ∑ b : Fin 3,
          (partialDeriv l (partialDeriv i (fun v => ψ v a)) z * G (ψ z) a b *
              partialDeriv j (fun v => ψ v b) z +
            partialDeriv i (fun v => ψ v a) z *
              (∑ d : Fin 3, partialDeriv d (fun y => G y a b) (ψ z) *
                partialDeriv l (fun v => ψ v d) z) * partialDeriv j (fun v => ψ v b) z +
            partialDeriv i (fun v => ψ v a) z * G (ψ z) a b *
              partialDeriv l (partialDeriv j (fun v => ψ v b)) z) := by
    intro ψ G U V hU hV hψ hmaps hG z hz l i j
    have hψd : DifferentiableAt ℝ ψ z :=
      (hψ.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)
    have hJd : ∀ a k : Fin 3, DifferentiableAt ℝ (partialDeriv k (fun v => ψ v a)) z := by
      intro a k
      exact ((hpdU U hU _ (contDiffOn_euclidean.mp hψ a) k).contDiffAt
        (hU.mem_nhds hz)).differentiableAt (by simp)
    have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) (ψ z) := fun a b =>
      ((hG a b).contDiffAt (hV.mem_nhds (hmaps z hz))).differentiableAt (by simp)
    have hGψd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun w => G (ψ w) a b) z :=
      fun a b => (hGd a b).comp z hψd
    have htd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun w => partialDeriv i (fun v => ψ v a) w *
        G (ψ w) a b * partialDeriv j (fun v => ψ v b) w) z :=
      fun a b => dmul _ _ _ (dmul _ _ _ (hJd a i) (hGψd a b)) (hJd b j)
    rw [pd_sum _ _ _ (fun a => DifferentiableAt.fun_sum (fun b _ => htd a b))]
    apply Finset.sum_congr rfl
    intro a _
    rw [pd_sum _ _ _ (fun b => htd a b)]
    apply Finset.sum_congr rfl
    intro b _
    rw [pd_mul _ _ _ _ (dmul _ _ _ (hJd a i) (hGψd a b)) (hJd b j),
      pd_mul _ _ _ _ (hJd a i) (hGψd a b), pd_comp (fun y => G y a b) ψ z hψd (hGd a b) l]
    ring
  
  have christoffel_pullback_algebra : ∀ (A G Gt : Matrix (Fin 3) (Fin 3) ℝ)
      (dG H dGt : Fin 3 → Fin 3 → Fin 3 → ℝ),
      A.det ≠ 0 → G.det ≠ 0 → (∀ a b, G a b = G b a) → (∀ c i j, H c i j = H c j i) →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * G a b * A b j) →
      (∀ l i j, dGt l i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (H a l i * G a b * A b j + A a i * (∑ d : Fin 3, dG d a b * A d l) * A b j
          + A a i * G a b * H b l j)) →
      ∀ c i j : Fin 3, ∑ k : Fin 3, A c k * ((1 / 2 : ℝ) * ∑ l : Fin 3, Gt⁻¹ k l *
          (dGt i j l + dGt j i l - dGt l i j)) =
        ∑ a : Fin 3, ∑ b : Fin 3, ((1 / 2 : ℝ) * ∑ l : Fin 3, G⁻¹ c l *
          (dG a b l + dG b a l - dG l a b)) * A a i * A b j + H c i j := by
    intro A G Gt dG H dGt hA hG hGs hH hGt hdGt c i j
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGu : IsUnit G.det := isUnit_iff_ne_zero.mpr hG
    have hGt' : Gt = Matrix.transpose A * G * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGiG : G⁻¹ * G = 1 := Matrix.nonsing_inv_mul G hGu
    have hGtinv : Gt⁻¹ = A⁻¹ * G⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hα : A * Gt⁻¹ = G⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGtinv, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hAB, Matrix.one_mul]
    have hα' : ∀ l, ∑ k : Fin 3, A c k * Gt⁻¹ k l = ∑ b : Fin 3, G⁻¹ c b * A⁻¹ l b := by
      intro l
      have h1 := congrFun (congrFun hα c) l
      simp only [Matrix.mul_apply, Matrix.transpose_apply] at h1
      exact h1
    have hβ : ∀ l, dGt i j l + dGt j i l - dGt l i j = ∑ γ : Fin 3, A γ l *
        (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β γ + dG β α γ - dG γ α β)
          + 2 * ∑ a : Fin 3, G a γ * H a i j) := by
      intro l
      rw [hdGt, hdGt, hdGt]
      simp only [Fin.sum_univ_three, hH _ j i, hH _ l i, hH _ l j]
      simp only [hGs 1 0, hGs 2 0, hGs 2 1]
      ring
    have eAB : ∀ γ b : Fin 3, A γ 0 * A⁻¹ 0 b + A γ 1 * A⁻¹ 1 b + A γ 2 * A⁻¹ 2 b
        = if γ = b then 1 else 0 := by
      intro γ b
      rw [← Matrix.one_apply, ← hAB, Matrix.mul_apply, Fin.sum_univ_three]
    have hcontr : ∀ (u W : Fin 3 → ℝ), ∑ l : Fin 3, (∑ b : Fin 3, u b * A⁻¹ l b) *
        (∑ γ : Fin 3, A γ l * W γ) = ∑ b : Fin 3, u b * W b := by
      intro u W
      simp only [Fin.sum_univ_three]
      linear_combination
        (u 0 * W 0) * (eAB 0 0).trans (if_pos rfl)
        + (u 1 * W 0) * (eAB 0 1).trans (if_neg (by decide))
        + (u 2 * W 0) * (eAB 0 2).trans (if_neg (by decide))
        + (u 0 * W 1) * (eAB 1 0).trans (if_neg (by decide))
        + (u 1 * W 1) * (eAB 1 1).trans (if_pos rfl)
        + (u 2 * W 1) * (eAB 1 2).trans (if_neg (by decide))
        + (u 0 * W 2) * (eAB 2 0).trans (if_neg (by decide))
        + (u 1 * W 2) * (eAB 2 1).trans (if_neg (by decide))
        + (u 2 * W 2) * (eAB 2 2).trans (if_pos rfl)
    have hGG : ∑ a : Fin 3, (∑ b : Fin 3, G⁻¹ c b * G a b) * H a i j = H c i j := by
      have h2 : ∀ a, ∑ b : Fin 3, G⁻¹ c b * G a b = (1 : Matrix (Fin 3) (Fin 3) ℝ) c a := by
        intro a
        rw [← hGiG, Matrix.mul_apply]
        exact Finset.sum_congr rfl (fun b _ => by rw [hGs a b])
      simp only [h2, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
        Finset.mem_univ, if_true]
    calc ∑ k : Fin 3, A c k * ((1 / 2 : ℝ) * ∑ l : Fin 3, Gt⁻¹ k l *
            (dGt i j l + dGt j i l - dGt l i j))
        = (1 / 2 : ℝ) * ∑ l : Fin 3, (∑ k : Fin 3, A c k * Gt⁻¹ k l) *
            (dGt i j l + dGt j i l - dGt l i j) := by
          simp only [Fin.sum_univ_three]
          ring
      _ = (1 / 2 : ℝ) * ∑ l : Fin 3, (∑ b : Fin 3, G⁻¹ c b * A⁻¹ l b) * (∑ γ : Fin 3, A γ l *
            (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β γ + dG β α γ - dG γ α β)
              + 2 * ∑ a : Fin 3, G a γ * H a i j)) := by
          simp only [hα', hβ]
      _ = (1 / 2 : ℝ) * ∑ b : Fin 3, G⁻¹ c b *
            (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β b + dG β α b - dG b α β)
              + 2 * ∑ a : Fin 3, G a b * H a i j) := by
          rw [hcontr (fun b => G⁻¹ c b) (fun γ => ∑ α : Fin 3, ∑ β : Fin 3,
            A α i * A β j * (dG α β γ + dG β α γ - dG γ α β) + 2 * ∑ a : Fin 3, G a γ * H a i j)]
      _ = _ := by
          rw [← hGG]
          simp only [Fin.sum_univ_three]
          ring
  
  have hbr_alg : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ)
      (Γt Γ H : Fin 3 → Fin 3 → Fin 3 → ℝ) (P : Fin 3 → ℝ) (Q : Fin 3 → Fin 3 → ℝ),
      (∀ c i j, ∑ k : Fin 3, A c k * Γt k i j =
        ∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * A a i * A b j + H c i j) →
      ∀ i j, ((∑ d : Fin 3, (∑ e : Fin 3, Q e d * A e i) * A d j
          + ∑ d : Fin 3, P d * H d i j)
            - ∑ k : Fin 3, Γt k i j * (∑ d : Fin 3, P d * A d k)) =
        ∑ a : Fin 3, ∑ b : Fin 3, A a i * A b j * (Q a b - ∑ k : Fin 3, Γ k a b * P k) := by
    intro A Γt Γ H P Q hT1 i j
    have h0 := hT1 0 i j
    have h1 := hT1 1 i j
    have h2 := hT1 2 i j
    simp only [Fin.sum_univ_three] at h0 h1 h2 ⊢
    linear_combination (-(P 0)) * h0 + (-(P 1)) * h1 + (-(P 2)) * h2
  
  have lmc_alg : ∀ (A Gm Gt : Matrix (Fin 3) (Fin 3) ℝ) (P Pt : Fin 3 → ℝ)
      (H Ht : Fin 3 → Fin 3 → ℝ), A.det ≠ 0 →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * Gm a b * A b j) →
      (∀ i, Pt i = ∑ a : Fin 3, P a * A a i) →
      (∀ i j, Ht i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * A b j * H a b) →
      (∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j * Pt i * Pt j =
          ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * P i * P j) ∧
      (∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j * Ht i j =
          ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * H i j) ∧
      (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          Gt⁻¹ i a * Pt a * (Gt⁻¹ j b * Pt b) * Ht i j =
        ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          Gm⁻¹ i a * P a * (Gm⁻¹ j b * P b) * H i j) := by
    intro A Gm Gt P Pt H Ht hA hGt hPt hHt
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGt' : Gt = Matrix.transpose A * Gm * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGtinv : Gt⁻¹ = A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hM : A * Gt⁻¹ * Matrix.transpose A = Gm⁻¹ := by
      rw [hGtinv]
      calc A * (A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹) * Matrix.transpose A
          = (A * A⁻¹) * Gm⁻¹ * (Matrix.transpose A⁻¹ * Matrix.transpose A) := by
            simp only [Matrix.mul_assoc]
        _ = Gm⁻¹ := by
            rw [hAB, ← Matrix.transpose_mul, hAB, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hM' : ∀ a b, ∑ i : Fin 3, ∑ j : Fin 3, A a i * Gt⁻¹ i j * A b j = Gm⁻¹ a b := by
      intro a b
      rw [← hM]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    refine ⟨?_, ?_, ?_⟩
    · simp only [hPt, ← hM']
      simp only [Fin.sum_univ_three]
      ring
    · simp only [hHt, ← hM']
      simp only [Fin.sum_univ_three]
      ring
    · obtain ⟨νt, hνt⟩ : ∃ νt : Fin 3 → ℝ, ∀ i, νt i = ∑ a : Fin 3, Gt⁻¹ i a * Pt a :=
        ⟨_, fun _ => rfl⟩
      obtain ⟨ν, hν⟩ : ∃ ν : Fin 3 → ℝ, ∀ d, ν d = ∑ a : Fin 3, Gm⁻¹ d a * P a :=
        ⟨_, fun _ => rfl⟩
      have K : ∀ d, ∑ i : Fin 3, A d i * νt i = ν d := by
        intro d
        simp only [hν, hνt, hPt, ← hM']
        simp only [Fin.sum_univ_three]
        ring
      calc ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
            Gt⁻¹ i a * Pt a * (Gt⁻¹ j b * Pt b) * Ht i j
          = ∑ i : Fin 3, ∑ j : Fin 3, νt i * νt j * Ht i j := by
            simp only [hνt, Fin.sum_univ_three]
            ring
        _ = ∑ i : Fin 3, ∑ j : Fin 3, νt i * νt j *
              (∑ a : Fin 3, ∑ b : Fin 3, A a i * A b j * H a b) := by
            simp only [hHt]
        _ = ∑ a : Fin 3, ∑ b : Fin 3,
              (∑ i : Fin 3, A a i * νt i) * (∑ j : Fin 3, A b j * νt j) * H a b := by
            simp only [Fin.sum_univ_three]
            ring
        _ = ∑ a : Fin 3, ∑ b : Fin 3, ν a * ν b * H a b := by
            simp only [K]
        _ = ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
              Gm⁻¹ i a * P a * (Gm⁻¹ j b * P b) * H i j := by
            simp only [hν, Fin.sum_univ_three]
            ring
  
  have partialDeriv_comm : ∀ (f : E3 → ℝ) (U : Set E3), IsOpen U → ContDiffOn ℝ ∞ f U →
      ∀ z ∈ U, ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j f) z = partialDeriv j (partialDeriv i f) z := by
    intro f U hU hf z hz i j
    have hfz : ContDiffAt ℝ ∞ f z := hf.contDiffAt (hU.mem_nhds hz)
    have hsymm : IsSymmSndFDerivAt ℝ f z :=
      hfz.isSymmSndFDerivAt (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
    have hd : DifferentiableAt ℝ (fderiv ℝ f) z :=
      (hfz.fderiv_right (m := 1) (by
        rw [one_add_one_eq_two]; exact WithTop.coe_le_coe.mpr le_top)).differentiableAt one_ne_zero
    have key2 : ∀ a b : Fin 3,
        partialDeriv a (partialDeriv b f) z = fderiv ℝ (fderiv ℝ f) z (e a) (e b) := by
      intro a b
      show fderiv ℝ (fun y => fderiv ℝ f y (e b)) z (e a) = _
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    rw [key2, key2, hsymm]
  
  have lmc_congr : ∀ (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      G =ᶠ[𝓝 y] G' → u =ᶠ[𝓝 y] v → levelMeanCurvCoord G u y = levelMeanCurvCoord G' v y := by
    intro G G' u v y hG huv
    have hy0 : G y = G' y := hG.eq_of_nhds
    have hent : ∀ a b i, partialDeriv i (fun z => G z a b) y
        = partialDeriv i (fun z => G' z a b) y := by
      intro a b i
      have : (fun z => G z a b) =ᶠ[𝓝 y] (fun z => G' z a b) :=
        hG.mono (fun z hz => by simp [hz])
      simp only [partialDeriv, this.fderiv_eq]
    have hchr : ∀ k i j, christoffel G k i j y = christoffel G' k i j y := by
      intro k i j
      simp only [christoffel, hy0, hent]
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (partialDeriv l u) y =
        partialDeriv i (partialDeriv l v) y := by
      intro i l
      have hev : (partialDeriv l u) =ᶠ[𝓝 y] (partialDeriv l v) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (partialDeriv l u) y (e i) = fderiv ℝ (partialDeriv l v) y (e i)
      rw [hev.fderiv_eq]
    have hH : ∀ i j, hessLoc G u i j y = hessLoc G' v i j y := by
      intro i j
      simp only [hessLoc, hchr, h1, h2]
    simp only [levelMeanCurvCoord, lapLoc, hy0, hH, h1]
  
  
  have key : ∀ (x : E3) (ψ : E3 → E3) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
      (U V : Set E3),
      IsOpen U → IsOpen V → ContDiffOn ℝ ∞ ψ U → (∀ z ∈ U, ψ z ∈ V) →
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) V) →
      (∀ y a b, G y a b = G y b a) → ContDiffOn ℝ 2 u V → x ∈ U →
      (G (ψ x)).det ≠ 0 →
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x).det ≠ 0 →
      levelMeanCurvCoord (fun w => Matrix.of fun i j : Fin 3 => ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w)
          (fun w => u (ψ w)) x
        = levelMeanCurvCoord G u (ψ x) := by
    intro x ψ G u U V hUo hVo hψ hmaps hG hGsym huV hxU hdetG hdetJ
    have hψc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun v => ψ v a) U := fun a =>
      contDiffOn_euclidean.mp hψ a
    set Gt : E3 → Matrix (Fin 3) (Fin 3) ℝ := fun w => Matrix.of fun i j : Fin 3 =>
      ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w
      with hGt
    have hH : ∀ c i j : Fin 3, partialDeriv i (partialDeriv j (fun v => ψ v c)) x
        = partialDeriv j (partialDeriv i (fun v => ψ v c)) x :=
      fun c i j => partialDeriv_comm _ U hUo (hψc c) x hxU i j
    have hT1 : ∀ c i j : Fin 3,
        ∑ k : Fin 3, partialDeriv k (fun v => ψ v c) x * christoffel Gt k i j x
          = ∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b (ψ x) * partialDeriv i (fun v => ψ v a) x *
            partialDeriv j (fun v => ψ v b) x + partialDeriv i (partialDeriv j (fun v => ψ v c)) x := by
      intro c i j
      have h8 := pullback_partialDeriv ψ G U V hUo hVo hψ hmaps hG x hxU
      have h9 := christoffel_pullback_algebra
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x) (G (ψ x)) (Gt x)
        (fun d a b => partialDeriv d (fun y => G y a b) (ψ x))
        (fun c i j => partialDeriv i (partialDeriv j (fun v => ψ v c)) x)
        (fun l i j => partialDeriv l (fun w => Gt w i j) x)
        hdetJ hdetG (fun a b => hGsym _ a b)
        (fun c i j => hH c i j) (fun i j => rfl) (fun l i j => h8 l i j) c i j
      exact h9
    have hψd : ∀ z ∈ U, DifferentiableAt ℝ ψ z := fun z hz =>
      (hψ.contDiffAt (hUo.mem_nhds hz)).differentiableAt (by simp)
    have hud : ∀ z ∈ U, DifferentiableAt ℝ u (ψ z) := fun z hz =>
      (huV.contDiffAt (hVo.mem_nhds (hmaps z hz))).differentiableAt (by norm_num)
    have h7a : ∀ k : Fin 3, partialDeriv k (fun w => u (ψ w)) x
        = ∑ d : Fin 3, partialDeriv d u (ψ x) * partialDeriv k (fun v => ψ v d) x :=
      fun k => pd_comp u ψ x (hψd x hxU) (hud x hxU) k
    have hJd : ∀ a k : Fin 3, DifferentiableAt ℝ (partialDeriv k (fun v => ψ v a)) x := by
      intro a k
      exact ((hpdU U hUo _ (hψc a) k).contDiffAt (hUo.mem_nhds hxU)).differentiableAt (by simp)
    have hPd : ∀ d : Fin 3, DifferentiableAt ℝ (partialDeriv d u) (ψ x) := by
      intro d
      have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ u y) V :=
        huV.fderiv_of_isOpen hVo (by norm_num)
      have h2 : ContDiffOn ℝ 1 (partialDeriv d u) V := h1.clm_apply contDiffOn_const
      exact (h2.contDiffAt (hVo.mem_nhds (hmaps x hxU))).differentiableAt (by norm_num)
    have hPψd : ∀ d : Fin 3, DifferentiableAt ℝ (fun y => partialDeriv d u (ψ y)) x := fun d =>
      (hPd d).comp x (hψd x hxU)
    have h7b : ∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun w => u (ψ w))) x
        = ∑ d : Fin 3, (∑ e : Fin 3, partialDeriv e (partialDeriv d u) (ψ x) *
            partialDeriv i (fun v => ψ v e) x) * partialDeriv j (fun v => ψ v d) x
          + ∑ d : Fin 3, partialDeriv d u (ψ x) * partialDeriv i (partialDeriv j (fun v => ψ v d)) x := by
      intro i j
      have hev : (partialDeriv j (fun w => u (ψ w))) =ᶠ[𝓝 x]
          (fun y => ∑ d : Fin 3, partialDeriv d u (ψ y) * partialDeriv j (fun v => ψ v d) y) := by
        filter_upwards [hUo.mem_nhds hxU] with y hy
        exact pd_comp u ψ y (hψd y hy) (hud y hy) j
      have e1 : partialDeriv i (partialDeriv j (fun w => u (ψ w))) x
          = partialDeriv i (fun y => ∑ d : Fin 3, partialDeriv d u (ψ y) *
              partialDeriv j (fun v => ψ v d) y) x :=
        congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hev.fderiv_eq
      rw [e1, pd_sum _ _ _ (fun d => dmul _ _ _ (hPψd d) (hJd d j)), ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro d _
      rw [pd_mul _ _ _ _ (hPψd d) (hJd d j),
        pd_comp (partialDeriv d u) ψ x (hψd x hxU) (hPd d) i]
    have hHt : ∀ i j : Fin 3, hessLoc Gt (fun w => u (ψ w)) i j x =
        ∑ a : Fin 3, ∑ b : Fin 3, partialDeriv i (fun w => ψ w a) x *
          partialDeriv j (fun w => ψ w b) x * hessLoc G u a b (ψ x) := by
      intro i j
      have hb := hbr_alg (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x)
        (fun k i j => christoffel Gt k i j x) (fun c a b => christoffel G c a b (ψ x))
        (fun c i j => partialDeriv i (partialDeriv j (fun v => ψ v c)) x)
        (fun d => partialDeriv d u (ψ x))
        (fun e d => partialDeriv e (partialDeriv d u) (ψ x)) hT1 i j
      show partialDeriv i (partialDeriv j (fun w => u (ψ w))) x
          - ∑ k : Fin 3, christoffel Gt k i j x * partialDeriv k (fun w => u (ψ w)) x = _
      rw [h7b i j]
      simp only [h7a]
      exact hb
    have hall := lmc_alg (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x)
      (G (ψ x)) (Gt x) (fun a => partialDeriv a u (ψ x))
      (fun i => partialDeriv i (fun w => u (ψ w)) x)
      (fun a b => hessLoc G u a b (ψ x)) (fun i j => hessLoc Gt (fun w => u (ψ w)) i j x)
      hdetJ (fun i j => rfl) h7a hHt
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3, (Gt x)⁻¹ i j * partialDeriv i (fun w => u (ψ w)) x *
          partialDeriv j (fun w => u (ψ w)) x =
        ∑ i : Fin 3, ∑ j : Fin 3, (G (ψ x))⁻¹ i j * partialDeriv i u (ψ x) *
          partialDeriv j u (ψ x) := hall.1
    have e2 : ∑ i : Fin 3, ∑ j : Fin 3, (Gt x)⁻¹ i j * hessLoc Gt (fun w => u (ψ w)) i j x =
        ∑ i : Fin 3, ∑ j : Fin 3, (G (ψ x))⁻¹ i j * hessLoc G u i j (ψ x) := hall.2.1
    have e3 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (Gt x)⁻¹ i a * partialDeriv a (fun w => u (ψ w)) x *
            ((Gt x)⁻¹ j b * partialDeriv b (fun w => u (ψ w)) x) *
            hessLoc Gt (fun w => u (ψ w)) i j x =
        ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (G (ψ x))⁻¹ i a * partialDeriv a u (ψ x) * ((G (ψ x))⁻¹ j b * partialDeriv b u (ψ x)) *
            hessLoc G u i j (ψ x) := hall.2.2
    unfold levelMeanCurvCoord lapLoc
    rw [e1, e2, e3]
  
  have hlift_proj : ∀ y : E3, hpLift (y 0) (hpProj y) = y := by
