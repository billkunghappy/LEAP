theorem stable_of_cut_minimizing [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Sig E Ω L : Set M) (hSc : IsCompact Sig)
    (hSm : IsMinimalSurfaceSet g Sig) (hE : IsOpen E) (hfr : frontier E = Sig)
    (hΩ : IsOpen Ω) (hL : IsCompact L) (hSL : Sig ⊆ interior L) (hLΩ : L ⊆ Ω)
    (hfin : hullRiemPer g E Ω Sig < ⊤)
    (hmin : ∀ E' : Set M, sepChartMeas E' → E' ⊆ E → E \ E' ⊆ L →
      hullRiemPer g E Ω Sig ≤ hullRiemPer g E' Ω Sig) :
    IsStableMinimalSet g Sig :=
by
  obtain ⟨φ, lam, hlam, hdata⟩ := jacobi_eigen_data g Sig hSc hSm
  by_cases hneg : ∃ p₀ ∈ Sig, lam p₀ < 0
  · exfalso
    obtain ⟨p₀, hp₀, hlt⟩ := hneg
    obtain ⟨O, w, t₀, hO, hOL, hp₀O, ht₀, hcpt, hwc, hw0, hwpos, hws, hdw, hH, hbd⟩ :=
      unstable_collar_function g Sig (interior L) hSc hSm isOpen_interior hSL φ lam hlam hdata
        p₀ hp₀ hlt
    have hOΩ : O ⊆ Ω := hOL.trans (interior_subset.trans hLΩ)
    obtain ⟨t, ht, htt₀, hlt'⟩ := collar_removal_decreases_hull g Sig E Ω O w t₀ hE hfr hΩ hO
      hOΩ hfin ht₀ hcpt hwc hw0 hwpos hws hdw hH hbd ⟨p₀, hp₀O, hp₀⟩
    have hSeq : {x | x ∈ O ∧ w x ≤ t} = {x | x ∈ O ∧ w x ≤ t₀} ∩ w ⁻¹' Set.Iic t := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_Iic]
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨⟨h1, h2.trans htt₀⟩, h2⟩
      · rintro ⟨⟨h1, _⟩, h2⟩
        exact ⟨h1, h2⟩
    have hSclosed : IsClosed {x | x ∈ O ∧ w x ≤ t} := by
      rw [hSeq]
      exact ContinuousOn.preimage_isClosed_of_isClosed (hwc.mono (fun x hx => hx.1))
        hcpt.isClosed isClosed_Iic
    have hE' : IsOpen (E \ {x | x ∈ O ∧ w x ≤ t}) := hE.sdiff hSclosed
    have hmeas : sepChartMeas (E \ {x | x ∈ O ∧ w x ≤ t}) := by
      intro q
      exact ((chartAt E3 q).isOpen_image_of_subset_source (hE'.inter (chartAt E3 q).open_source)
        Set.inter_subset_right).measurableSet
    have hsub : E \ (E \ {x | x ∈ O ∧ w x ≤ t}) ⊆ L := by
      intro x hx
      have hxS : x ∈ {x | x ∈ O ∧ w x ≤ t} := by
        by_contra h
        exact hx.2 ⟨hx.1, h⟩
      exact interior_subset (hOL hxS.1)
    exact absurd (hmin _ hmeas Set.diff_subset hsub) (not_le.mpr hlt')
  · push_neg at hneg
    refine ⟨φ, fun p hp => ?_⟩
    obtain ⟨hφp, V, f, hVo, hpV, hf, hdf, hVS, hx⟩ := hdata p hp
    refine ⟨hφp, V, f, hVo, hpV, hf, hdf, hVS, fun x hx' => ⟨(hx x hx').1, ?_⟩⟩
    rw [(hx x hx').2]
    exact div_nonneg (hneg x hx'.2) (hdata x hx'.2).1.le

theorem chart_metric_constants [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (q : M) (C : Set E3) (hC : IsCompact C) (hCt : C ⊆ (chartAt E3 q).target) : ∃ η Γ m : ℝ, 0 < η ∧ 0 < Γ ∧ 0 < m ∧ Metric.cthickening η C ⊆ (chartAt E3 q).target ∧ (∀ y ∈ Metric.cthickening η C, ∀ b : Fin 3, g.coeff (chartAt E3 q).symm y b b ≤ Γ) ∧ (∀ y ∈ Metric.cthickening η C, m ≤ Real.sqrt (g.coeff (chartAt E3 q).symm y).det) :=
by
  obtain ⟨η, hη, hKt⟩ :=
    hC.exists_cthickening_subset_open (chartAt E3 q).open_target hCt
  have hK : IsCompact (Metric.cthickening η C) := hC.cthickening
  have hent : ∀ i j : Fin 3, ContinuousOn (fun y => g.coeff (chartAt E3 q).symm y i j)
      (Metric.cthickening η C) := fun i j => ((g.smooth q i j).continuousOn).mono hKt
  have hG : ContinuousOn (fun y => g.coeff (chartAt E3 q).symm y) (Metric.cthickening η C) :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hent i j
  have hdet : ContinuousOn (fun y => (g.coeff (chartAt E3 q).symm y).det)
      (Metric.cthickening η C) :=
    (continuous_id.matrix_det (n := Fin 3) (R := ℝ)).comp_continuousOn hG
  have hsq : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det)
      (Metric.cthickening η C) := hdet.sqrt
  have hB : ∀ b : Fin 3, ∃ B : ℝ, ∀ y ∈ Metric.cthickening η C,
      ‖g.coeff (chartAt E3 q).symm y b b‖ ≤ B := fun b => hK.exists_bound_of_continuousOn (hent b b)
  choose B hB using hB
  have hdiag : ∀ y ∈ Metric.cthickening η C, ∀ b : Fin 3,
      g.coeff (chartAt E3 q).symm y b b ≤ 1 + ∑ c : Fin 3, |B c| := by
    intro y hy b
    have h1 : g.coeff (chartAt E3 q).symm y b b ≤ ‖g.coeff (chartAt E3 q).symm y b b‖ := by
      rw [Real.norm_eq_abs]; exact le_abs_self _
    have h2 : B b ≤ |B b| := le_abs_self _
    have h3 : |B b| ≤ ∑ c : Fin 3, |B c| :=
      Finset.single_le_sum (f := fun c => |B c|) (fun c _ => abs_nonneg _) (Finset.mem_univ b)
    linarith [hB b y hy]
  have hΓ : (0 : ℝ) < 1 + ∑ c : Fin 3, |B c| := by
    have : 0 ≤ ∑ c : Fin 3, |B c| := Finset.sum_nonneg (fun c _ => abs_nonneg _)
    linarith
  rcases Set.eq_empty_or_nonempty (Metric.cthickening η C) with hE | hne
  · refine ⟨η, 1 + ∑ c : Fin 3, |B c|, 1, hη, hΓ, one_pos, hKt, hdiag, ?_⟩
    intro y hy
    rw [hE] at hy
    exact absurd hy (Set.notMem_empty y)
  · obtain ⟨y₀, hy₀, hmin⟩ := hK.exists_isMinOn hne hsq
    have hpd : (g.coeff (chartAt E3 q).symm y₀).PosDef := by
      classical
      have hy : y₀ ∈ (chartAt E3 q).target := hKt hy₀
      have hq : (chartAt E3 q).symm y₀ ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
      have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀ :=
        mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y₀) :=
        mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
      have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y₀ =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y₀)).comp
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀) := mfderiv_comp y₀ hg hf
      have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y₀ =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y₀ := by
        apply Filter.EventuallyEq.mfderiv_eq
        filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
        exact hz
      rw [mfderiv_id] at hid
      have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y₀)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀ w) = w := by
        intro w
        have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
        simpa using h1
      have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀ w = 0 → w = 0 := by
        intro w hw
        rw [← hinv w, hw, map_zero]
      apply Matrix.PosDef.of_dotProduct_mulVec_pos
      · apply Matrix.IsHermitian.ext
        intro i j
        simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
        exact g.symm _ _ _
      · intro x hx
        have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
          intro h0
          apply hx
          funext j
          have h1 := congrArg (fun u : E3 => u j) h0
          fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
        have hDv := fun h => hvx (hDinj _ h)
        have hpos := g.posDef ((chartAt E3 q).symm y₀) _ hDv
        have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y₀).mulVec x =
            g.g ((chartAt E3 q).symm y₀)
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀ (∑ i, x i • e i : E3))
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y₀ (∑ i, x i • e i : E3)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
            ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
            RiemannianMetric3.coeff, coeffMatrix]
          ring
        rw [key]
        exact hpos
    have hm : 0 < Real.sqrt (g.coeff (chartAt E3 q).symm y₀).det :=
      Real.sqrt_pos.2 hpd.det_pos
    refine ⟨η, 1 + ∑ c : Fin 3, |B c|, _, hη, hΓ, hm, hKt, hdiag, ?_⟩
    intro y hy
    exact hmin hy

theorem chart_graph_patch [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Sig : Set M) (hS : IsMinimalSurfaceSet g Sig) (q : M) (y : E3) (hy : y ∈ (chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source)) (O : Set E3) (hO : IsOpen O) (hyO : y ∈ O) (hOt : O ⊆ (chartAt E3 q).target) : ∃ (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧ Continuous v ∧ v (smthHoriz a y) = y a ∧ (∀ x ∈ smthDisc a y r, ∀ w ∈ smthDisc a y r, |v x - v w| ≤ 4 * ‖x - w‖) ∧ (∀ x ∈ smthDisc a y r, |v x - y a| < δ) ∧ {z : E3 | smthHoriz a z ∈ smthDisc a y r ∧ |z a - y a| < δ} ⊆ O ∧ ∀ z : E3, smthHoriz a z ∈ smthDisc a y r → |z a - y a| < δ → (z ∈ (chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source) ↔ z a = v (smthHoriz a z)) :=
by
  classical
  obtain ⟨p, ⟨hpS, hps⟩, hpy⟩ := hy
  obtain ⟨V, f, -, hVo, hpV, hf, hdf, hVS, -⟩ := hS.2 p hpS Set.univ Filter.univ_mem
  
  have hFt : ContDiffOn ℝ ∞ (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q).target :=
    contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn (contMDiffOn_chart_symm (x := q)))
  have hFd0 : fderiv ℝ (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q p) ≠ 0 := by
    intro h0
    apply hdf p hpV
    have hyt : chartAt E3 q p ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hps
    have hFd : DifferentiableAt ℝ (fun z => f ((chartAt E3 q).symm z)) (chartAt E3 q p) :=
      ((hFt.contDiffAt ((chartAt E3 q).open_target.mem_nhds hyt)).differentiableAt (by simp))
    have hFm : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => f ((chartAt E3 q).symm z))
        (chartAt E3 q p) := hFd.mdifferentiableAt
    have hκ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) p :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hps
    have hev : f =ᶠ[𝓝 p] (fun z => f ((chartAt E3 q).symm z)) ∘ (chartAt E3 q) := by
      filter_upwards [(chartAt E3 q).open_source.mem_nhds hps] with x hx
      simp only [Function.comp_apply]
      rw [(chartAt E3 q).left_inv hx]
    rw [hev.mfderiv_eq, mfderiv_comp p hFm hκ, mfderiv_eq_fderiv, h0]
    rfl
  obtain ⟨W, hWdef⟩ : ∃ W : Set E3,
      W = O ∩ ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' V) := ⟨_, rfl⟩
  obtain ⟨F, hFdef⟩ : ∃ F : E3 → ℝ, F = fun z => f ((chartAt E3 q).symm z) := ⟨_, rfl⟩
  have hW : IsOpen W := by
    rw [hWdef]; exact hO.inter ((chartAt E3 q).isOpen_inter_preimage_symm hVo)
  have hyW : y ∈ W := by
    rw [hWdef]
    refine ⟨hyO, ?_, ?_⟩
    · rw [← hpy]; exact (chartAt E3 q).map_source hps
    · show (chartAt E3 q).symm y ∈ V
      rw [← hpy, (chartAt E3 q).left_inv hps]; exact hpV
  have hF : ContDiffOn ℝ ∞ F W := by
    rw [hFdef]; exact hFt.mono (by rw [hWdef]; exact fun z hz => hz.2.1)
  have hF0 : F y = 0 := by
    rw [hFdef, ← hpy]
    show f ((chartAt E3 q).symm (chartAt E3 q p)) = 0
    rw [(chartAt E3 q).left_inv hps]
    have : p ∈ V ∩ f ⁻¹' {0} := by rw [← hVS]; exact ⟨hpV, hpS⟩
    exact this.2
  have hd : fderiv ℝ F y ≠ 0 := by rw [hFdef, ← hpy]; exact hFd0
  have hWO : W ⊆ O := by rw [hWdef]; exact Set.inter_subset_left
  have hWiff : ∀ z ∈ W, (z ∈ (chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source) ↔ F z = 0) := by
    intro z hz
    rw [hWdef] at hz
    obtain ⟨-, hzt, hzV⟩ := hz
    rw [hFdef]
    constructor
    · rintro ⟨x, ⟨hxS, hxs⟩, rfl⟩
      have hxV : x ∈ V := by
        have h1 : (chartAt E3 q).symm (chartAt E3 q x) ∈ V := hzV
        rwa [(chartAt E3 q).left_inv hxs] at h1
      have : x ∈ V ∩ f ⁻¹' {0} := by rw [← hVS]; exact ⟨hxV, hxS⟩
      show f ((chartAt E3 q).symm (chartAt E3 q x)) = 0
      rw [(chartAt E3 q).left_inv hxs]; exact this.2
    · intro h0
      have : (chartAt E3 q).symm z ∈ V ∩ Sig := by rw [hVS]; exact ⟨hzV, h0⟩
      exact ⟨_, ⟨this.2, (chartAt E3 q).map_target hzt⟩, (chartAt E3 q).right_inv hzt⟩
  suffices key : ∃ (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧ Continuous v ∧
      v (smthHoriz a y) = y a ∧
      (∀ x ∈ smthDisc a y r, ∀ w ∈ smthDisc a y r, |v x - v w| ≤ 4 * ‖x - w‖) ∧
      (∀ x ∈ smthDisc a y r, |v x - y a| < δ) ∧
      {z : E3 | smthHoriz a z ∈ smthDisc a y r ∧ |z a - y a| < δ} ⊆ W ∧
      ∀ z : E3, smthHoriz a z ∈ smthDisc a y r → |z a - y a| < δ →
        (F z = 0 ↔ z a = v (smthHoriz a z)) by
    obtain ⟨a, v, r, δ, hr, hδ, hv, hv0, hlip, hvb, hcyl, hiff⟩ := key
    refine ⟨a, v, r, δ, hr, hδ, hv, hv0, hlip, hvb, hcyl.trans hWO, ?_⟩
    intro z hz1 hz2
    rw [hWiff z (hcyl ⟨hz1, hz2⟩)]
    exact hiff z hz1 hz2
  clear hWiff hWO hFdef hWdef hFt hFd0
  
  have liftH : ∀ (a : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro a x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) a t x k
  have liftS : ∀ (a : Fin 3) (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2),
      (smthLift a x t) (a.succAbove k) = x k := fun a x t k => congrFun (liftH a x t) k
  have liftA : ∀ (a : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro a x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) a t x
  have liftSelf : ∀ (a : Fin 3) (z : E3), smthLift a (smthHoriz a z) (z a) = z := by
    intro a z
    ext i
    exact congrFun (Fin.insertNth_self_removeNth (α := fun _ => ℝ) a (fun j => z j)) i
  have liftC : ∀ (a : Fin 3) (x : Fin 2 → ℝ), Continuous (fun t => smthLift a x t) := by
    intro a x
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a continuous_id continuous_const)
  have liftC2 : ∀ (a : Fin 3) (t : ℝ), Continuous (fun x => smthLift a x t) := by
    intro a t
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a continuous_const continuous_id)
  
  have hexp : ∀ (L : E3 →L[ℝ] ℝ) (u : E3), L u = ∑ b : Fin 3, u b * L (e b) := by
    intro L u
    have hu : u = ∑ b : Fin 3, u b • e b := by
      ext i
      fin_cases i <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    conv_lhs => rw [hu]
    simp [map_sum, map_smul, smul_eq_mul]
  
  have hb0 : ∃ b, partialDeriv b F y ≠ 0 := by
    by_contra h
    push_neg at h
    apply hd
    ext u
    rw [hexp]
    simp only [partialDeriv] at h
    simp [h]
  obtain ⟨b₀, hb₀⟩ := hb0
  obtain ⟨a, -, ha⟩ := Finset.exists_max_image Finset.univ
    (fun b => |partialDeriv b F y|) Finset.univ_nonempty
  have ha' : ∀ b, |partialDeriv b F y| ≤ |partialDeriv a F y| :=
    fun b => ha b (Finset.mem_univ _)
  obtain ⟨m, hm⟩ : ∃ m, m = |partialDeriv a F y| := ⟨_, rfl⟩
  have hmpos : 0 < m := by
    rw [hm]; exact lt_of_lt_of_le (abs_pos.mpr hb₀) (ha' b₀)
  obtain ⟨s, hs1, hsm⟩ : ∃ s : ℝ, (s = 1 ∨ s = -1) ∧ s * partialDeriv a F y = m := by
    by_cases h : 0 < partialDeriv a F y
    · exact ⟨1, Or.inl rfl, by rw [hm, abs_of_pos h, one_mul]⟩
    · push_neg at h
      exact ⟨-1, Or.inr rfl, by rw [hm, abs_of_nonpos h]; ring⟩
  have hsabs : |s| = 1 := by rcases hs1 with h | h <;> simp [h]
  have hs0 : s ≠ 0 := by rcases hs1 with h | h <;> simp [h]
  obtain ⟨G, hG⟩ : ∃ G : E3 → ℝ, G = fun w => s * F w := ⟨_, rfl⟩
  have hdiffW : ∀ z ∈ W, DifferentiableAt ℝ F z := fun z hz =>
    (hF.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hz)
  have hpG : ∀ z ∈ W, ∀ b, partialDeriv b G z = s * partialDeriv b F z := by
    intro z hz b
    simp only [partialDeriv, hG]
    rw [fderiv_const_mul (hdiffW z hz)]
    simp
  
  have hcontd : ContinuousOn (fderiv ℝ F) W := hF.continuousOn_fderiv_of_isOpen hW (by simp)
  have hpc : ∀ b, ContinuousAt (fun z => partialDeriv b F z) y := by
    intro b
    exact (hcontd.clm_apply continuousOn_const).continuousAt (hW.mem_nhds hyW)
  have hev : ∀ᶠ z in 𝓝 y, z ∈ W ∧ ∀ b, |partialDeriv b F z - partialDeriv b F y| < m / 4 := by
    refine Filter.Eventually.and (hW.mem_nhds hyW) ?_
    rw [Filter.eventually_all]
    intro b
    exact (Metric.tendsto_nhds.mp (hpc b) (m / 4) (by positivity)).mono
      fun z hz => by rwa [Real.dist_eq] at hz
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.mp hev
  have hBW : ∀ z ∈ ball y ε, z ∈ W := fun z hz => (hball hz).1
  have hpos : ∀ z ∈ ball y ε, 3 * m / 4 < partialDeriv a G z := by
    intro z hz
    have h1 := (hball hz).2 a
    rw [hpG z (hBW z hz)]
    have h2 : |s * (partialDeriv a F z - partialDeriv a F y)| < m / 4 := by
      rw [abs_mul, hsabs, one_mul]; exact h1
    have e1 : s * partialDeriv a F z = m + s * (partialDeriv a F z - partialDeriv a F y) := by
      rw [← hsm]; ring
    rw [e1]
    linarith [(abs_lt.mp h2).1]
  have hApos : ∀ z ∈ ball y ε, 0 < partialDeriv a G z := fun z hz => by
    linarith [hpos z hz]
  have hside : ∀ z ∈ ball y ε, ∀ k : Fin 2,
      |partialDeriv (a.succAbove k) G z| ≤ 2 * partialDeriv a G z := by
    intro z hz k
    have h1 := (hball hz).2 (a.succAbove k)
    have h2 := ha' (a.succAbove k)
    have h3 := hpos z hz
    rw [hpG z (hBW z hz) (a.succAbove k), abs_mul, hsabs, one_mul]
    have h4 := abs_add_le (partialDeriv (a.succAbove k) F y)
      (partialDeriv (a.succAbove k) F z - partialDeriv (a.succAbove k) F y)
    rw [add_sub_cancel] at h4
    rw [← hm] at h2
    linarith
  
  have hdiffG : ∀ z ∈ ball y ε, DifferentiableAt ℝ G z := fun z hz => by
    rw [hG]; exact (hdiffW z (hBW z hz)).const_mul s
  have hGcB : ∀ z ∈ ball y ε, ContinuousAt G z := fun z hz => (hdiffG z hz).continuousAt
  have hmvt : ∀ P ∈ ball y ε, ∀ Q ∈ ball y ε, ∃ ξ ∈ ball y ε,
      G Q - G P = partialDeriv a G ξ * (Q a - P a) +
        ∑ k : Fin 2, partialDeriv (a.succAbove k) G ξ * (Q (a.succAbove k) - P (a.succAbove k)) := by
    intro P hP Q hQ
    have hseg : ∀ t ∈ Set.Icc (0:ℝ) 1, P + t • (Q - P) ∈ ball y ε :=
      fun t ht => (convex_ball y ε).add_smul_sub_mem hP hQ ht
    have hγc : Continuous fun t : ℝ => P + t • (Q - P) := by fun_prop
    have hcont : ContinuousOn (fun t : ℝ => G (P + t • (Q - P))) (Set.Icc 0 1) := by
      intro t ht
      exact (ContinuousAt.comp (f := fun t : ℝ => P + t • (Q - P)) (hGcB _ (hseg t ht))
        hγc.continuousAt).continuousWithinAt
    have hderiv : ∀ t ∈ Set.Ioo (0:ℝ) 1, HasDerivAt (fun t : ℝ => G (P + t • (Q - P)))
        (fderiv ℝ G (P + t • (Q - P)) (Q - P)) t := by
      intro t ht
      have hγ : HasDerivAt (fun t : ℝ => P + t • (Q - P)) (Q - P) t := by
        simpa using ((hasDerivAt_id t).smul_const (Q - P)).const_add P
      exact (hdiffG _ (hseg t (Set.Ioo_subset_Icc_self ht))).hasFDerivAt.comp_hasDerivAt t hγ
    obtain ⟨c, hc, hceq⟩ := exists_hasDerivAt_eq_slope _ _ zero_lt_one hcont hderiv
    refine ⟨P + c • (Q - P), hseg c (Set.Ioo_subset_Icc_self hc), ?_⟩
    simp only [one_smul, zero_smul, add_zero, sub_zero, div_one, add_sub_cancel] at hceq
    rw [← hceq, hexp, Fin.sum_univ_succAbove _ a]
    simp only [partialDeriv, PiLp.sub_apply, Fin.sum_univ_two]
    ring
  
  have hdist : ∀ z : E3, dist z y ^ 2 = (z a - y a) ^ 2 +
      ∑ k : Fin 2, (z (a.succAbove k) - y (a.succAbove k)) ^ 2 := by
    intro z
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg fun i _ => sq_nonneg _),
      Fin.sum_univ_succAbove _ a]
    simp [Real.dist_eq, sq_abs]
  have hgeo : ∀ z : E3, ∑ k : Fin 2, (z (a.succAbove k) - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 →
      |z a - y a| ≤ ε / 2 → z ∈ ball y ε := by
    intro z h1 h2
    rw [Metric.mem_ball]
    have h3 := hdist z
    have h4 : (z a - y a) ^ 2 ≤ (ε / 2) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
    have h5 : dist z y ^ 2 < ε ^ 2 := by nlinarith
    nlinarith [dist_nonneg (x := z) (y := y)]
  have hgeoL : ∀ (x : Fin 2 → ℝ) (t : ℝ),
      ∑ k : Fin 2, (x k - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 → |t - y a| ≤ ε / 2 →
      smthLift a x t ∈ ball y ε := by
    intro x t hx ht
    refine hgeo _ ?_ ?_
    · simp only [liftS]; exact hx
    · rw [liftA]; exact ht
  
  have hmono : ∀ x : Fin 2 → ℝ, ∑ k : Fin 2, (x k - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 →
      ∀ t t', |t - y a| ≤ ε / 2 → |t' - y a| ≤ ε / 2 → t < t' →
      G (smthLift a x t) < G (smthLift a x t') := by
    intro x hx t t' ht ht' htt'
    obtain ⟨ξ, hξ, heq⟩ := hmvt _ (hgeoL x t hx ht) _ (hgeoL x t' hx ht')
    simp only [liftA, liftS, sub_self, mul_zero, Finset.sum_const_zero, add_zero] at heq
    have := mul_pos (hApos ξ hξ) (sub_pos.mpr htt')
    linarith
  have huniq : ∀ x : Fin 2 → ℝ, ∑ k : Fin 2, (x k - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 →
      ∀ t t', |t - y a| ≤ ε / 2 → |t' - y a| ≤ ε / 2 →
      G (smthLift a x t) = 0 → G (smthLift a x t') = 0 → t = t' := by
    intro x hx t t' ht ht' h0 h0'
    rcases lt_trichotomy t t' with h | h | h
    · have := hmono x hx t t' ht ht' h; linarith
    · exact h
    · have := hmono x hx t' t ht' ht h; linarith
  
  have hc0 : ∑ k : Fin 2, (smthHoriz a y k - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 := by
    simp only [smthHoriz, sub_self]
    simpa using pow_pos (by positivity : (0:ℝ) < ε / 4) 2
  have hGy : G (smthLift a (smthHoriz a y) (y a)) = 0 := by
    rw [liftSelf, hG]; simp [hF0]
  have hhalf : |ε / 2| ≤ ε / 2 := by rw [abs_of_pos (by positivity)]
  have hplus : 0 < G (smthLift a (smthHoriz a y) (y a + ε / 2)) := by
    have := hmono _ hc0 (y a) (y a + ε / 2) (by simp; positivity) (by simpa using hhalf)
      (by linarith)
    rwa [hGy] at this
  have hminus : G (smthLift a (smthHoriz a y) (y a - ε / 2)) < 0 := by
    have := hmono _ hc0 (y a - ε / 2) (y a) (by simpa [abs_sub_comm] using hhalf)
      (by simp; positivity) (by linarith)
    rwa [hGy] at this
  have hcp : ContinuousAt (fun x => G (smthLift a x (y a + ε / 2))) (smthHoriz a y) :=
    ContinuousAt.comp (f := fun x => smthLift a x (y a + ε / 2))
      (hGcB _ (hgeoL _ _ hc0 (by simpa using hhalf))) (liftC2 a _).continuousAt
  have hcm : ContinuousAt (fun x => G (smthLift a x (y a - ε / 2))) (smthHoriz a y) :=
    ContinuousAt.comp (f := fun x => smthLift a x (y a - ε / 2))
      (hGcB _ (hgeoL _ _ hc0 (by simpa [abs_sub_comm] using hhalf))) (liftC2 a _).continuousAt
  obtain ⟨r₀, hr₀, hr₀b⟩ := Metric.eventually_nhds_iff.mp
    ((Filter.Tendsto.eventually hcp (lt_mem_nhds hplus)).and
      (Filter.Tendsto.eventually hcm (gt_mem_nhds hminus)))
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = min r₀ (ε / 4) := ⟨_, rfl⟩
  have hr : 0 < r := by rw [hrdef]; exact lt_min hr₀ (by positivity)
  have hrr₀ : r ≤ r₀ := by rw [hrdef]; exact min_le_left _ _
  have hre : r ≤ ε / 4 := by rw [hrdef]; exact min_le_right _ _
  have hdiscP : ∀ x ∈ smthDisc a y r, dist x (smthHoriz a y) < r₀ ∧
      ∑ k : Fin 2, (x k - y (a.succAbove k)) ^ 2 < (ε / 4) ^ 2 := by
    intro x hx
    have hx' : ∑ k : Fin 2, (x k - y (a.succAbove k)) ^ 2 < r ^ 2 := hx
    constructor
    · rw [dist_pi_lt_iff hr₀]
      intro k
      rw [Real.dist_eq]
      have hk : (x k - y (a.succAbove k)) ^ 2 < r ^ 2 :=
        lt_of_le_of_lt (Finset.single_le_sum (f := fun k => (x k - y (a.succAbove k)) ^ 2)
          (fun i _ => sq_nonneg _) (Finset.mem_univ k)) hx'
      have := abs_lt_of_sq_lt_sq hk hr.le
      simp only [smthHoriz]
      linarith
    · have := pow_le_pow_left₀ hr.le hre 2
      linarith
  
  have hex : ∀ x ∈ smthDisc a y r, ∃ t, |t - y a| < ε / 2 ∧ G (smthLift a x t) = 0 := by
    intro x hx
    obtain ⟨hxd, hxs⟩ := hdiscP x hx
    obtain ⟨h1, h2⟩ := hr₀b hxd
    have hcontI : ContinuousOn (fun t => G (smthLift a x t))
        (Set.Icc (y a - ε / 2) (y a + ε / 2)) := by
      intro t ht
      have ht' : |t - y a| ≤ ε / 2 := abs_le.mpr ⟨by linarith [ht.1], by linarith [ht.2]⟩
      exact (ContinuousAt.comp (f := fun t => smthLift a x t) (hGcB _ (hgeoL x t hxs ht'))
        (liftC a x).continuousAt).continuousWithinAt
    obtain ⟨t, ht, ht0⟩ := intermediate_value_Ioo (by linarith : y a - ε / 2 ≤ y a + ε / 2)
      hcontI ⟨h2, h1⟩
    exact ⟨t, abs_lt.mpr ⟨by linarith [ht.1], by linarith [ht.2]⟩, ht0⟩
  choose v₀ hv₀ hv₀0 using hex
  obtain ⟨v₁, hv₁⟩ : ∃ v₁ : (Fin 2 → ℝ) → ℝ, ∀ x (h : x ∈ smthDisc a y r), v₁ x = v₀ x h :=
    ⟨fun x => if h : x ∈ smthDisc a y r then v₀ x h else y a, fun x h => dif_pos h⟩
  
  have hlip : ∀ x ∈ smthDisc a y r, ∀ w ∈ smthDisc a y r, |v₁ x - v₁ w| ≤ 4 * ‖x - w‖ := by
    intro x hx w hw
    rw [hv₁ x hx, hv₁ w hw]
    obtain ⟨ξ, hξ, heq⟩ := hmvt _ (hgeoL x _ (hdiscP x hx).2 (hv₀ x hx).le)
      _ (hgeoL w _ (hdiscP w hw).2 (hv₀ w hw).le)
    simp only [liftA, liftS, hv₀0, sub_self, Fin.sum_univ_two] at heq
    have hA := hApos ξ hξ
    have hs0' := hside ξ hξ 0
    have hs1' := hside ξ hξ 1
    have hd0 : |w 0 - x 0| ≤ ‖x - w‖ := by
      have := norm_le_pi_norm (x - w) 0
      rwa [Real.norm_eq_abs, Pi.sub_apply, abs_sub_comm] at this
    have hd1 : |w 1 - x 1| ≤ ‖x - w‖ := by
      have := norm_le_pi_norm (x - w) 1
      rwa [Real.norm_eq_abs, Pi.sub_apply, abs_sub_comm] at this
    have e1 : partialDeriv a G ξ * |v₀ x hx - v₀ w hw| =
        |partialDeriv (a.succAbove 0) G ξ * (w 0 - x 0) +
          partialDeriv (a.succAbove 1) G ξ * (w 1 - x 1)| := by
      rw [← abs_of_pos hA, ← abs_mul]
      congr 1
      linear_combination heq
    have key : partialDeriv a G ξ * |v₀ x hx - v₀ w hw| ≤ partialDeriv a G ξ * (4 * ‖x - w‖) := by
      rw [e1]
      calc _ ≤ |partialDeriv (a.succAbove 0) G ξ * (w 0 - x 0)| +
            |partialDeriv (a.succAbove 1) G ξ * (w 1 - x 1)| := abs_add_le _ _
        _ = |partialDeriv (a.succAbove 0) G ξ| * |w 0 - x 0| +
            |partialDeriv (a.succAbove 1) G ξ| * |w 1 - x 1| := by rw [abs_mul, abs_mul]
        _ ≤ (2 * partialDeriv a G ξ) * ‖x - w‖ + (2 * partialDeriv a G ξ) * ‖x - w‖ :=
            add_le_add (mul_le_mul hs0' hd0 (abs_nonneg _) (by linarith))
              (mul_le_mul hs1' hd1 (abs_nonneg _) (by linarith))
        _ = partialDeriv a G ξ * (4 * ‖x - w‖) := by ring
    exact le_of_mul_le_mul_left key hA
  
  have hLon : LipschitzOnWith 4 v₁ (smthDisc a y r) := by
    refine LipschitzOnWith.of_dist_le_mul fun x hx w hw => ?_
    rw [Real.dist_eq, dist_eq_norm]
    have := hlip x hx w hw
    push_cast
    exact this
  obtain ⟨v, hvL, hvEq⟩ := hLon.extend_real
  have hcD : smthHoriz a y ∈ smthDisc a y r := by
    show ∑ k : Fin 2, (smthHoriz a y k - y (a.succAbove k)) ^ 2 < r ^ 2
    simp only [smthHoriz, sub_self]
    simpa using pow_pos hr 2
  refine ⟨a, v, r, ε / 2, hr, by positivity, hvL.continuous, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← hvEq hcD, hv₁ _ hcD]
    exact huniq _ (hdiscP _ hcD).2 _ _ (hv₀ _ hcD).le (by simp; positivity) (hv₀0 _ hcD) hGy
  · intro x hx w hw
    rw [← hvEq hx, ← hvEq hw]
    exact hlip x hx w hw
  · intro x hx
    rw [← hvEq hx, hv₁ x hx]
    exact hv₀ x hx
  · rintro z ⟨hz1, hz2⟩
    exact hBW z (hgeo z (hdiscP _ hz1).2 hz2.le)
  · intro z hz1 hz2
    have hzs := (hdiscP _ hz1).2
    have hzeq : smthLift a (smthHoriz a z) (z a) = z := liftSelf a z
    constructor
    · intro h0
      rw [← hvEq hz1, hv₁ _ hz1]
      refine huniq _ hzs _ _ hz2.le (hv₀ _ hz1).le ?_ (hv₀0 _ hz1)
      rw [hzeq, hG]
      simp [h0]
    · intro hza
      rw [← hvEq hz1, hv₁ _ hz1] at hza
      have h1 := hv₀0 _ hz1
      rw [← hza, hzeq, hG] at h1
      simpa [hs0] using h1

theorem cyl_sides_preconnected (a : Fin 3) (c : E3) (r δ : ℝ) (v : (Fin 2 → ℝ) → ℝ) (hv : Continuous v) (hvin : ∀ x ∈ smthDisc a c r, |v x - c a| < δ) : IsPreconnected {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ ∧ v (smthHoriz a z) < z a} ∧ IsPreconnected {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ ∧ z a < v (smthHoriz a z)} :=
by
  have L1 : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) a t x k
  have L2 : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) a t x
  have L3 : ∀ z : E3, smthLift a (smthHoriz a z) (z a) = z := by
    intro z
    ext i
    exact congrFun (Fin.insertNth_self_removeNth (α := fun _ => ℝ) a (fun j => z j)) i
  have L4 : ∀ F : (Fin 2 → ℝ) × ℝ → ℝ, Continuous F →
      Continuous (fun p : (Fin 2 → ℝ) × ℝ => smthLift a p.1 (F p)) := by
    intro F hF
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a hF continuous_fst)
  have hconv : Convex ℝ (smthDisc a c r) := by
    rw [convex_iff_forall_pos]
    intro x hx y hy s t hs ht hst
    simp only [smthDisc, Set.mem_setOf_eq, Fin.sum_univ_two, Pi.add_apply, Pi.smul_apply,
      smul_eq_mul] at hx hy ⊢
    have ht' : t = 1 - s := by linarith
    have key : ∀ u w : ℝ, (s * u + t * w) ^ 2 ≤ s * u ^ 2 + t * w ^ 2 := by
      intro u w
      have hid : s * u ^ 2 + t * w ^ 2 - (s * u + t * w) ^ 2 = s * t * (u - w) ^ 2 := by
        rw [ht']; ring
      nlinarith [mul_nonneg (mul_nonneg hs.le ht.le) (sq_nonneg (u - w))]
    have e0 : s * x 0 + t * y 0 - c (a.succAbove 0) =
        s * (x 0 - c (a.succAbove 0)) + t * (y 0 - c (a.succAbove 0)) := by
      rw [ht']; ring
    have e1 : s * x 1 + t * y 1 - c (a.succAbove 1) =
        s * (x 1 - c (a.succAbove 1)) + t * (y 1 - c (a.succAbove 1)) := by
      rw [ht']; ring
    rw [e0, e1]
    have k0 := key (x 0 - c (a.succAbove 0)) (y 0 - c (a.succAbove 0))
    have k1 := key (x 1 - c (a.succAbove 1)) (y 1 - c (a.succAbove 1))
    have m1 := mul_lt_mul_of_pos_left hx hs
    have m2 := mul_lt_mul_of_pos_left hy ht
    have hr : s * r ^ 2 + t * r ^ 2 = r ^ 2 := by rw [← add_mul, hst, one_mul]
    nlinarith
  have hP : IsPreconnected (smthDisc a c r ×ˢ Set.Ioo (0 : ℝ) 1) :=
    hconv.isPreconnected.prod isPreconnected_Ioo
  constructor
  · have hcont : Continuous (fun p : (Fin 2 → ℝ) × ℝ =>
        smthLift a p.1 (v p.1 + p.2 * (c a + δ - v p.1))) :=
      L4 _ ((hv.comp continuous_fst).add
        (continuous_snd.mul (continuous_const.sub (hv.comp continuous_fst))))
    have heq : (fun p : (Fin 2 → ℝ) × ℝ =>
        smthLift a p.1 (v p.1 + p.2 * (c a + δ - v p.1))) ''
          (smthDisc a c r ×ˢ Set.Ioo (0 : ℝ) 1) =
        {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ ∧
          v (smthHoriz a z) < z a} := by
      ext z
      constructor
      · rintro ⟨⟨x, τ⟩, ⟨hx, hτ0, hτ1⟩, rfl⟩
        have hb := abs_lt.mp (hvin x hx)
        have hg : 0 < c a + δ - v x := by linarith
        have h1 : 0 < τ * (c a + δ - v x) := mul_pos hτ0 hg
        have h2 : τ * (c a + δ - v x) < c a + δ - v x := by nlinarith
        simp only [Set.mem_setOf_eq]
        rw [L1, L2]
        exact ⟨hx, abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith⟩
      · rintro ⟨hx, hz, hlt⟩
        have hb := abs_lt.mp hz
        have hg : 0 < c a + δ - v (smthHoriz a z) := by linarith
        refine ⟨(smthHoriz a z, (z a - v (smthHoriz a z)) / (c a + δ - v (smthHoriz a z))),
          ⟨hx, ?_, ?_⟩, ?_⟩
        · exact div_pos (by linarith) hg
        · rw [div_lt_one hg]; linarith
        · simp only
          rw [div_mul_cancel₀ _ hg.ne']
          rw [show v (smthHoriz a z) + (z a - v (smthHoriz a z)) = z a by ring]
          exact L3 z
    rw [← heq]
    exact hP.image _ hcont.continuousOn
  · have hcont : Continuous (fun p : (Fin 2 → ℝ) × ℝ =>
        smthLift a p.1 (v p.1 - p.2 * (v p.1 - (c a - δ)))) :=
      L4 _ ((hv.comp continuous_fst).sub
        (continuous_snd.mul ((hv.comp continuous_fst).sub continuous_const)))
    have heq : (fun p : (Fin 2 → ℝ) × ℝ =>
        smthLift a p.1 (v p.1 - p.2 * (v p.1 - (c a - δ)))) ''
          (smthDisc a c r ×ˢ Set.Ioo (0 : ℝ) 1) =
        {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ ∧
          z a < v (smthHoriz a z)} := by
      ext z
      constructor
      · rintro ⟨⟨x, τ⟩, ⟨hx, hτ0, hτ1⟩, rfl⟩
        have hb := abs_lt.mp (hvin x hx)
        have hg : 0 < v x - (c a - δ) := by linarith
        have h1 : 0 < τ * (v x - (c a - δ)) := mul_pos hτ0 hg
        have h2 : τ * (v x - (c a - δ)) < v x - (c a - δ) := by nlinarith
        simp only [Set.mem_setOf_eq]
        rw [L1, L2]
        exact ⟨hx, abs_lt.mpr ⟨by linarith, by linarith⟩, by linarith⟩
      · rintro ⟨hx, hz, hlt⟩
        have hb := abs_lt.mp hz
        have hg : 0 < v (smthHoriz a z) - (c a - δ) := by linarith
        refine ⟨(smthHoriz a z, (v (smthHoriz a z) - z a) / (v (smthHoriz a z) - (c a - δ))),
          ⟨hx, ?_, ?_⟩, ?_⟩
        · exact div_pos (by linarith) hg
        · rw [div_lt_one hg]; linarith
        · simp only
          rw [div_mul_cancel₀ _ hg.ne']
          rw [show v (smthHoriz a z) - (v (smthHoriz a z) - z a) = z a by ring]
          exact L3 z
    rw [← heq]
    exact hP.image _ hcont.continuousOn

theorem graph_side_integral (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (hv : Continuous v) (h : E3 → ℝ) (hh : ContDiff ℝ 1 h) (hhc : HasCompactSupport h) : (∫ z in {z : E3 | v (smthHoriz a z) < z a}, partialDeriv a h z) = -∫ x, h (smthLift a x (v x)) ∧ (∫ z in {z : E3 | z a < v (smthHoriz a z)}, partialDeriv a h z) = ∫ x, h (smthLift a x (v x)) :=
by
  
  have hg_cont : Continuous (partialDeriv a h) := by
    have : partialDeriv a h = fun z => fderiv ℝ h z (e a) := rfl
    rw [this]
    exact (hh.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hg_supp : HasCompactSupport (partialDeriv a h) := by
    have : partialDeriv a h = (fun L : E3 →L[ℝ] ℝ => L (e a)) ∘ fderiv ℝ h := rfl
    rw [this]
    exact (hhc.fderiv ℝ).comp_left (by simp)
  have hgi : Integrable (partialDeriv a h) := hg_cont.integrable_of_hasCompactSupport hg_supp
  
  have hline : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthLift a x t = smthLift a x 0 + t • e a := by
    intro x t
    ext i
    rcases eq_or_ne i a with rfl | hia
    · simp [smthLift]
    · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq hia
      simp [smthLift, EuclideanSpace.single_apply, Fin.succAbove_ne]
  have hiso : ∀ x, Isometry (fun t : ℝ => smthLift a x t) := by
    intro x
    refine Isometry.of_dist_eq fun t s => ?_
    rw [dist_eq_norm, hline x t, hline x s, add_sub_add_left_eq_sub, ← sub_smul, norm_smul,
      EuclideanSpace.norm_single, norm_one, mul_one, Real.dist_eq, Real.norm_eq_abs]
  have hderiv : ∀ x t, HasDerivAt (fun s : ℝ => smthLift a x s) (e a) t := by
    intro x t
    have : (fun s : ℝ => smthLift a x s) = fun s => smthLift a x 0 + s • e a := funext (hline x)
    rw [this]
    simpa using ((hasDerivAt_id t).smul_const (e a)).const_add (smthLift a x 0)
  
  have hftc : ∀ x c, (∫ t in Set.Ioi c, partialDeriv a h (smthLift a x t)) = -h (smthLift a x c) ∧
      (∫ t in Set.Iio c, partialDeriv a h (smthLift a x t)) = h (smthLift a x c) := by
    intro x c
    have hfd : ∀ t, HasDerivAt (fun t => h (smthLift a x t)) (partialDeriv a h (smthLift a x t)) t := by
      intro t
      have h1 : HasFDerivAt h (fderiv ℝ h (smthLift a x t)) (smthLift a x t) :=
        (hh.differentiable one_ne_zero _).hasFDerivAt
      exact h1.comp_hasDerivAt t (hderiv x t)
    have hcemb := (hiso x).isClosedEmbedding
    have hf'c : Continuous (fun t => partialDeriv a h (smthLift a x t)) :=
      hg_cont.comp (hiso x).continuous
    have hf'i : Integrable (fun t => partialDeriv a h (smthLift a x t)) :=
      hf'c.integrable_of_hasCompactSupport (hg_supp.comp_isClosedEmbedding hcemb)
    have hfs : HasCompactSupport (fun t => h (smthLift a x t)) := hhc.comp_isClosedEmbedding hcemb
    have hfcont : Continuous (fun t => h (smthLift a x t)) :=
      continuous_iff_continuousAt.2 fun t => (hfd t).continuousAt
    have hlim := hfs.is_zero_at_infty
    rw [cocompact_eq_atBot_atTop] at hlim
    have htop : Tendsto (fun t => h (smthLift a x t)) atTop (𝓝 0) := hlim.mono_left le_sup_right
    have hbot : Tendsto (fun t => h (smthLift a x t)) atBot (𝓝 0) := hlim.mono_left le_sup_left
    constructor
    · rw [integral_Ioi_of_hasDerivAt_of_tendsto hfcont.continuousWithinAt (fun t _ => hfd t)
        hf'i.integrableOn htop, zero_sub]
    · rw [← integral_Iic_eq_integral_Iio, integral_Iic_of_hasDerivAt_of_tendsto
        hfcont.continuousWithinAt (fun t _ => hfd t) hf'i.integrableOn hbot, sub_zero]
  
  have liftH : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) a t x k
  have liftA : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) a t x
  have hHc : Continuous (smthHoriz a) := by
    unfold smthHoriz
    fun_prop
  
  obtain ⟨T, hTapp, hTmp⟩ : ∃ T : ℝ × (Fin 2 → ℝ) ≃ᵐ E3, (∀ p, T p = smthLift a p.2 p.1) ∧
      MeasurePreserving T (volume : Measure (ℝ × (Fin 2 → ℝ))) volume := by
    refine ⟨(MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) a).symm.trans
      (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)), fun p => rfl, ?_⟩
    have h1 := MeasurePreserving.symm _
      (measurePreserving_piFinSuccAbove (fun _ : Fin 3 => (volume : Measure ℝ)) a)
    have h2 : MeasurePreserving (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)) volume volume :=
      MeasurePreserving.symm _ (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3))
    exact h2.comp h1
  
  have key : ∀ (P : Set (ℝ × (Fin 2 → ℝ))) (S : Set E3), MeasurableSet P → MeasurableSet S →
      (∀ p, T p ∈ S ↔ p ∈ P) →
      ∫ z in S, partialDeriv a h z =
        ∫ x, ∫ t, P.indicator (fun p => partialDeriv a h (T p)) (t, x) := by
    intro P S hP hS hPS
    rw [← integral_indicator hS, ← hTmp.integral_comp' (S.indicator (partialDeriv a h))]
    have hfun : (fun p => S.indicator (partialDeriv a h) (T p)) =
        P.indicator (fun p => partialDeriv a h (T p)) := by
      classical
      funext p
      by_cases hp : p ∈ P
      · rw [Set.indicator_of_mem hp, Set.indicator_of_mem ((hPS p).2 hp)]
      · have hp' : T p ∉ S := fun h' => hp ((hPS p).1 h')
        rw [Set.indicator_apply, Set.indicator_apply, if_neg hp, if_neg hp']
    rw [hfun]
    have hint : Integrable (P.indicator (fun p => partialDeriv a h (T p)))
        ((volume : Measure ℝ).prod (volume : Measure (Fin 2 → ℝ))) :=
      ((hTmp.integrable_comp_emb T.measurableEmbedding).mpr hgi).indicator hP
    exact integral_prod_symm _ hint
  have hSup : MeasurableSet {z : E3 | v (smthHoriz a z) < z a} :=
    (isOpen_lt (hv.comp hHc) (by fun_prop)).measurableSet
  have hSlo : MeasurableSet {z : E3 | z a < v (smthHoriz a z)} :=
    (isOpen_lt (by fun_prop) (hv.comp hHc)).measurableSet
  have hPup : MeasurableSet {p : ℝ × (Fin 2 → ℝ) | v p.2 < p.1} :=
    measurableSet_lt (hv.measurable.comp measurable_snd) measurable_fst
  have hPlo : MeasurableSet {p : ℝ × (Fin 2 → ℝ) | p.1 < v p.2} :=
    measurableSet_lt measurable_fst (hv.measurable.comp measurable_snd)
  have hupper := key _ _ hPup hSup (fun p => by
    rw [hTapp]; simp only [Set.mem_setOf_eq, liftH, liftA])
  have hlower := key _ _ hPlo hSlo (fun p => by
    rw [hTapp]; simp only [Set.mem_setOf_eq, liftH, liftA])
  have hinup : ∀ x, (∫ t, {p : ℝ × (Fin 2 → ℝ) | v p.2 < p.1}.indicator
      (fun p => partialDeriv a h (T p)) (t, x)) = -h (smthLift a x (v x)) := by
    intro x
    have : (fun t => {p : ℝ × (Fin 2 → ℝ) | v p.2 < p.1}.indicator
        (fun p => partialDeriv a h (T p)) (t, x)) =
        (Set.Ioi (v x)).indicator (fun t => partialDeriv a h (smthLift a x t)) := by
      funext t
      simp only [Set.indicator_apply, Set.mem_setOf_eq, Set.mem_Ioi, hTapp]
    rw [this, integral_indicator measurableSet_Ioi]
    exact (hftc x (v x)).1
  have hinlo : ∀ x, (∫ t, {p : ℝ × (Fin 2 → ℝ) | p.1 < v p.2}.indicator
      (fun p => partialDeriv a h (T p)) (t, x)) = h (smthLift a x (v x)) := by
    intro x
    have : (fun t => {p : ℝ × (Fin 2 → ℝ) | p.1 < v p.2}.indicator
        (fun p => partialDeriv a h (T p)) (t, x)) =
        (Set.Iio (v x)).indicator (fun t => partialDeriv a h (smthLift a x t)) := by
      funext t
      simp only [Set.indicator_apply, Set.mem_setOf_eq, Set.mem_Iio, hTapp]
    rw [this, integral_indicator measurableSet_Iio]
    exact (hftc x (v x)).2
  refine ⟨?_, ?_⟩
  · rw [hupper]
    simp only [hinup, integral_neg]
  · rw [hlower]
    simp only [hinlo]

theorem graph_hausdorff_le (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hlip : ∀ x ∈ S, ∀ w ∈ S, |v x - v w| ≤ 4 * ‖x - w‖) : MeasureTheory.Measure.hausdorffMeasure 2 ((fun x => smthLift a x (v x)) '' S) ≤ 18 * MeasureTheory.volume S :=
by
  have hcoord : ∀ (x : Fin 2 → ℝ) (t : ℝ) (i : Fin 3),
      (smthLift a x t) i = Fin.insertNth (α := fun _ : Fin 3 => ℝ) a t x i :=
    fun x t i => rfl
  have hsq : ∀ x w : Fin 2 → ℝ, dist (smthLift a x (v x)) (smthLift a w (v w)) ^ 2
      = (v x - v w) ^ 2 + ∑ k : Fin 2, (x k - w k) ^ 2 := by
    intro x w
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => sq_nonneg _)),
      Fin.sum_univ_succAbove _ a]
    simp only [Real.dist_eq, sq_abs, hcoord, Fin.insertNth_apply_same,
      Fin.insertNth_apply_succAbove]
  have hL : LipschitzOnWith (NNReal.sqrt 18) (fun x => smthLift a x (v x)) S := by
    apply LipschitzOnWith.of_dist_le_mul
    intro x hx w hw
    have hn : 0 ≤ dist x w := dist_nonneg
    have hk : ∀ k : Fin 2, |x k - w k| ≤ dist x w := by
      intro k
      rw [dist_eq_norm]
      have := norm_le_pi_norm (x - w) k
      simpa [Real.norm_eq_abs] using this
    have hv : |v x - v w| ≤ 4 * dist x w := by
      rw [dist_eq_norm]; exact hlip x hx w hw
    have hs := hsq x w
    rw [Fin.sum_univ_two] at hs
    have e18 : ((NNReal.sqrt 18 : NNReal) : ℝ) = Real.sqrt 18 := by
      rw [Real.coe_sqrt]; norm_num
    rw [e18]
    have hq : (Real.sqrt 18) ^ 2 = 18 := Real.sq_sqrt (by norm_num)
    have hd : 0 ≤ dist (smthLift a x (v x)) (smthLift a w (v w)) := dist_nonneg
    have a0 : (x 0 - w 0) ^ 2 ≤ dist x w ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hk 0) 2
    have a1 : (x 1 - w 1) ^ 2 ≤ dist x w ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) (hk 1) 2
    have av : (v x - v w) ^ 2 ≤ (4 * dist x w) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hv 2
    have e16 : (4 * dist x w) ^ 2 = 16 * dist x w ^ 2 := by ring
    show dist (smthLift a x (v x)) (smthLift a w (v w)) ≤ Real.sqrt 18 * dist x w
    rw [← pow_le_pow_iff_left₀ hd (by positivity) two_ne_zero, mul_pow, hq, hs]
    linarith
  have h := hL.hausdorffMeasure_image_le (d := 2) (by norm_num)
  have h5 : ((NNReal.sqrt 18 : NNReal) : ENNReal) ^ (2 : ℝ) = 18 := by
    rw [ENNReal.rpow_two, ← ENNReal.coe_pow, NNReal.sq_sqrt]; rfl
  have h6 : (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
      MeasureTheory.Measure (Fin 2 → ℝ)) = MeasureTheory.volume := by
    simpa using (MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2))
  rw [h5, h6] at h
  exact h

theorem disjoint_graph_selection {ι : Type} [Fintype ι] (K : Set E3) (hK : IsCompact K) (a : ι → Fin 3) (v : ι → (Fin 2 → ℝ) → ℝ) (D : ι → Set (Fin 2 → ℝ)) (hD : ∀ i, MeasurableSet (D i)) (hDf : ∀ i, MeasureTheory.volume (D i) ≠ ⊤) (hv : ∀ i, Continuous (v i)) (hH : ∀ i, ∀ S ⊆ D i, MeasureTheory.Measure.hausdorffMeasure 2 ((fun x => smthLift (a i) x (v i x)) '' S) ≤ 18 * MeasureTheory.volume S) (hcov : K ⊆ ⋃ i, (fun x => smthLift (a i) x (v i x)) '' D i) (ε : ENNReal) (hε : ε ≠ 0) : ∃ Q : ι → Set (Fin 2 → ℝ), (∀ i, IsCompact (Q i) ∧ Q i ⊆ D i ∧ (fun x => smthLift (a i) x (v i x)) '' Q i ⊆ K) ∧ Pairwise (fun i j => Disjoint ((fun x => smthLift (a i) x (v i x)) '' Q i) ((fun x => smthLift (a j) x (v j x)) '' Q j)) ∧ MeasureTheory.Measure.hausdorffMeasure 2 K ≤ 18 * ∑ i, MeasureTheory.volume (Q i) + ε :=
by
  classical
  
  have liftH : ∀ (b : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), smthHoriz b (smthLift b x t) = x := by
    intro b x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) b t x k
  have liftA : ∀ (b : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), (smthLift b x t) b = t := by
    intro b x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) b t x
  have liftSelf : ∀ (b : Fin 3) (z : E3), smthLift b (smthHoriz b z) (z b) = z := by
    intro b z
    ext i
    exact congrFun (Fin.insertNth_self_removeNth (α := fun _ => ℝ) b (fun j => z j)) i
  have horizC : ∀ b : Fin 3, Continuous (smthHoriz b) := by
    intro b
    unfold smthHoriz
    fun_prop
  have hΓc : ∀ i, Continuous (fun x => smthLift (a i) x (v i x)) := by
    intro i
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth (a i) (hv i) continuous_id)
  
  have hTm : ∀ i, MeasurableSet ((fun x => smthLift (a i) x (v i x)) '' D i) := by
    intro i
    have heq : (fun x => smthLift (a i) x (v i x)) '' D i =
        smthHoriz (a i) ⁻¹' D i ∩ {z : E3 | z (a i) = v i (smthHoriz (a i) z)} := by
      ext z
      constructor
      · rintro ⟨x, hx, rfl⟩
        refine ⟨?_, ?_⟩
        · show smthHoriz (a i) (smthLift (a i) x (v i x)) ∈ D i
          rw [liftH]
          exact hx
        · show (smthLift (a i) x (v i x)) (a i) =
            v i (smthHoriz (a i) (smthLift (a i) x (v i x)))
          rw [liftH, liftA]
      · rintro ⟨hz1, hz2⟩
        refine ⟨smthHoriz (a i) z, hz1, ?_⟩
        show smthLift (a i) (smthHoriz (a i) z) (v i (smthHoriz (a i) z)) = z
        have hz2' : z (a i) = v i (smthHoriz (a i) z) := hz2
        rw [← hz2']
        exact liftSelf _ _
    rw [heq]
    refine ((hD i).preimage (horizC (a i)).measurable).inter ?_
    have hcz : Continuous (fun z : E3 => z (a i)) :=
      (EuclideanSpace.proj (a i) : E3 →L[ℝ] ℝ).continuous
    exact (isClosed_eq hcz ((hv i).comp (horizC (a i)))).measurableSet
  
  have hKm : MeasurableSet K := hK.isClosed.measurableSet
  let σ := Fintype.equivFin ι
  let B : ι → Set E3 := fun i =>
    (K ∩ (fun x => smthLift (a i) x (v i x)) '' D i) \
      ⋃ j, ⋃ (_ : σ j < σ i), (fun x => smthLift (a j) x (v j x)) '' D j
  have hBm : ∀ i, MeasurableSet (B i) := fun i =>
    (hKm.inter (hTm i)).diff (MeasurableSet.iUnion fun j => MeasurableSet.iUnion fun _ => hTm j)
  have hBsub : ∀ i, B i ⊆ K ∩ (fun x => smthLift (a i) x (v i x)) '' D i :=
    fun i => Set.diff_subset
  have hBcov : K ⊆ ⋃ i, B i := by
    intro z hz
    obtain ⟨i₀, hi₀⟩ := Set.mem_iUnion.1 (hcov hz)
    have hs : (Finset.univ.filter
        (fun i => z ∈ (fun x => smthLift (a i) x (v i x)) '' D i)).Nonempty :=
      ⟨i₀, Finset.mem_filter.2 ⟨Finset.mem_univ _, hi₀⟩⟩
    obtain ⟨i, hi, hmin⟩ := Finset.exists_min_image _ σ hs
    refine Set.mem_iUnion.2 ⟨i, ⟨hz, (Finset.mem_filter.1 hi).2⟩, ?_⟩
    intro hzu
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hzu
    obtain ⟨hlt, hzj⟩ := Set.mem_iUnion.1 hj
    have hle := hmin j (Finset.mem_filter.2 ⟨Finset.mem_univ _, hzj⟩)
    exact absurd hlt (not_lt.2 hle)
  have hBdisj : Pairwise (fun i j => Disjoint (B i) (B j)) := by
    intro i j hij
    rw [Set.disjoint_left]
    intro z hzi hzj
    rcases lt_or_gt_of_ne (σ.injective.ne hij) with h | h
    · exact hzj.2 (Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨h, hzi.1.2⟩⟩)
    · exact hzi.2 (Set.mem_iUnion.2 ⟨j, Set.mem_iUnion.2 ⟨h, hzj.1.2⟩⟩)
  
  let P : ι → Set (Fin 2 → ℝ) := fun i => D i ∩ (fun x => smthLift (a i) x (v i x)) ⁻¹' B i
  have hPm : ∀ i, MeasurableSet (P i) := fun i =>
    (hD i).inter ((hBm i).preimage (hΓc i).measurable)
  have hPf : ∀ i, MeasureTheory.volume (P i) ≠ ⊤ := fun i =>
    ne_top_of_le_ne_top (hDf i) (MeasureTheory.measure_mono Set.inter_subset_left)
  have hPB : ∀ i, (fun x => smthLift (a i) x (v i x)) '' P i ⊆ B i := by
    rintro i _ ⟨x, hx, rfl⟩
    exact hx.2
  have hKP : K ⊆ ⋃ i, (fun x => smthLift (a i) x (v i x)) '' P i := by
    intro z hz
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hBcov hz)
    obtain ⟨x, hx, hxz⟩ := (hBsub i hi).2
    refine Set.mem_iUnion.2 ⟨i, x, ⟨hx, ?_⟩, hxz⟩
    show (fun x => smthLift (a i) x (v i x)) x ∈ B i
    rw [hxz]
    exact hi
  have hHK : MeasureTheory.Measure.hausdorffMeasure 2 K ≤
      18 * ∑ i, MeasureTheory.volume (P i) := by
    calc MeasureTheory.Measure.hausdorffMeasure 2 K
        ≤ MeasureTheory.Measure.hausdorffMeasure 2
            (⋃ i, (fun x => smthLift (a i) x (v i x)) '' P i) := MeasureTheory.measure_mono hKP
      _ ≤ ∑ i, MeasureTheory.Measure.hausdorffMeasure 2
            ((fun x => smthLift (a i) x (v i x)) '' P i) :=
          MeasureTheory.measure_iUnion_fintype_le _ _
      _ ≤ ∑ i, 18 * MeasureTheory.volume (P i) :=
          Finset.sum_le_sum fun i _ => hH i (P i) Set.inter_subset_left
      _ = 18 * ∑ i, MeasureTheory.volume (P i) := (Finset.mul_sum _ _ _).symm
  
  have hc : (18 * (Fintype.card ι : ENNReal)) ≠ ⊤ :=
    ENNReal.mul_ne_top (by norm_num) (ENNReal.natCast_ne_top _)
  have hδ : ε / (18 * (Fintype.card ι : ENNReal)) ≠ 0 := by
    rw [Ne, ENNReal.div_eq_zero_iff]
    push_neg
    exact ⟨hε, hc⟩
  have hex : ∀ i, ∃ Q ⊆ P i, IsCompact Q ∧ MeasureTheory.volume (P i) <
      MeasureTheory.volume Q + ε / (18 * (Fintype.card ι : ENNReal)) :=
    fun i => (hPm i).exists_isCompact_lt_add (hPf i) hδ
  choose Q hQP hQc hQlt using hex
  have hsum : 18 * ∑ i, MeasureTheory.volume (P i) ≤
      18 * ∑ i, MeasureTheory.volume (Q i) + ε := by
    calc 18 * ∑ i, MeasureTheory.volume (P i)
        ≤ 18 * ∑ i, (MeasureTheory.volume (Q i) + ε / (18 * (Fintype.card ι : ENNReal))) := by
          gcongr with i
          exact (hQlt i).le
      _ = 18 * ∑ i, MeasureTheory.volume (Q i) +
            (18 * (Fintype.card ι : ENNReal)) * (ε / (18 * (Fintype.card ι : ENNReal))) := by
          rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_add,
            mul_assoc]
      _ ≤ 18 * ∑ i, MeasureTheory.volume (Q i) + ε := by
          gcongr
          exact ENNReal.mul_div_le
  refine ⟨Q, fun i => ⟨hQc i, (hQP i).trans Set.inter_subset_left, ?_⟩, ?_, hHK.trans hsum⟩
  · exact (Set.image_mono (hQP i)).trans ((hPB i).trans ((hBsub i).trans Set.inter_subset_left))
  · intro i j hij
    exact Disjoint.mono ((Set.image_mono (hQP i)).trans (hPB i))
      ((Set.image_mono (hQP j)).trans (hPB j)) (hBdisj hij)

theorem disjoint_bumps {ι : Type} [Fintype ι] (P O : ι → Set E3) (hP : ∀ i, IsCompact (P i)) (hO : ∀ i, IsOpen (O i)) (hPO : ∀ i, P i ⊆ O i) (hdisj : Pairwise fun i j => Disjoint (P i) (P j)) : ∃ χ : ι → E3 → ℝ, (∀ i, ContDiff ℝ ∞ (χ i) ∧ (∀ z, 0 ≤ χ i z ∧ χ i z ≤ 1) ∧ (∀ z ∈ P i, χ i z = 1) ∧ HasCompactSupport (χ i) ∧ tsupport (χ i) ⊆ O i) ∧ Pairwise fun i j => Disjoint (tsupport (χ i)) (tsupport (χ j)) :=
by
  classical
  have hε : ∀ i, ∃ ε : ℝ, 0 < ε ∧ Metric.cthickening ε (P i) ⊆ O i :=
    fun i => (hP i).exists_cthickening_subset_open (hO i) (hPO i)
  choose ε hε0 hεO using hε
  have hδ' : ∀ i, ∃ δ : ℝ, 0 < δ ∧ Disjoint (Metric.cthickening δ (P i))
      (Metric.cthickening δ (⋃ j, ⋃ (_ : j ≠ i), P j)) := by
    intro i
    have hQc : IsClosed (⋃ j, ⋃ (_ : j ≠ i), P j) :=
      isClosed_iUnion_of_finite fun j => isClosed_iUnion_of_finite fun _ => (hP j).isClosed
    have hPQ : Disjoint (P i) (⋃ j, ⋃ (_ : j ≠ i), P j) := by
      rw [Set.disjoint_iUnion_right]
      intro j
      rw [Set.disjoint_iUnion_right]
      intro hji
      exact hdisj (Ne.symm hji)
    exact hPQ.exists_cthickenings (hP i) hQc
  choose δ' hδ'0 hδ'd using hδ'
  set δ : ι → ℝ := fun i => min (ε i) (δ' i) with hδdef
  have hδ0 : ∀ i, 0 < δ i := fun i => lt_min (hε0 i) (hδ'0 i)
  have hKO : ∀ i, Metric.cthickening (δ i) (P i) ⊆ O i := fun i =>
    (Metric.cthickening_mono (min_le_left _ _) _).trans (hεO i)
  have hkey : ∀ a b, a ≠ b → δ a ≤ δ b →
      Disjoint (Metric.cthickening (δ a) (P a)) (Metric.cthickening (δ b) (P b)) := by
    intro a b hab hle
    have h1 : Metric.cthickening (δ a) (P a) ⊆
        Metric.cthickening (δ' b) (⋃ j, ⋃ (_ : j ≠ b), P j) := by
      refine (Metric.cthickening_mono hle _).trans ?_
      refine (Metric.cthickening_subset_of_subset _ ?_).trans
        (Metric.cthickening_mono (min_le_right _ _) _)
      exact Set.subset_iUnion₂_of_subset a hab le_rfl
    have h2 : Metric.cthickening (δ b) (P b) ⊆ Metric.cthickening (δ' b) (P b) :=
      Metric.cthickening_mono (min_le_right _ _) _
    exact Disjoint.mono h1 h2 (hδ'd b).symm
  have hKd : Pairwise fun i j =>
      Disjoint (Metric.cthickening (δ i) (P i)) (Metric.cthickening (δ j) (P j)) := by
    intro i j hij
    rcases le_total (δ i) (δ j) with h | h
    · exact hkey i j hij h
    · exact (hkey j i (Ne.symm hij) h).symm
  have hbump : ∀ i, ∃ f : E3 → ℝ, ContDiff ℝ ∞ f ∧ (∀ z, 0 ≤ f z ∧ f z ≤ 1) ∧
      (∀ z ∈ P i, f z = 1) ∧ HasCompactSupport f ∧
      tsupport f ⊆ Metric.cthickening (δ i) (P i) := by
    intro i
    obtain ⟨f, hf, hfr, hfs, hf1⟩ := exists_contMDiff_support_eq_eq_one_iff 𝓘(ℝ, E3)
      (n := (⊤ : ℕ∞)) (Metric.isOpen_thickening (δ := δ i) (E := P i)) (hP i).isClosed
      (Metric.self_subset_thickening (hδ0 i) _)
    have hts : tsupport f ⊆ Metric.cthickening (δ i) (P i) := by
      rw [tsupport, hfs]
      exact Metric.closure_thickening_subset_cthickening _ _
    refine ⟨f, ?_, ?_, ?_, ?_, hts⟩
    · exact contMDiff_iff_contDiff.mp hf
    · intro z
      have := hfr (Set.mem_range_self z)
      exact ⟨this.1, this.2⟩
    · intro z hz
      exact (hf1 z).mp hz
    · exact ((hP i).cthickening).of_isClosed_subset (isClosed_tsupport f) hts
  choose χ hχ using hbump
  refine ⟨χ, fun i => ⟨(hχ i).1, (hχ i).2.1, (hχ i).2.2.1, (hχ i).2.2.2.1,
    (hχ i).2.2.2.2.trans (hKO i)⟩, ?_⟩
  intro i j hij
  exact Disjoint.mono (hχ i).2.2.2.2 (hχ j).2.2.2.2 (hKd hij)

theorem patch_field_flux (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T) (hdet : ∀ y ∈ T, 0 < (G y).det) (N : Set E3) (hNT : N ⊆ T) (Γ m : ℝ) (hΓ : 0 < Γ) (hm : 0 < m) (hGa : ∀ y ∈ N, ∀ b : Fin 3, G y b b ≤ Γ) (hGm : ∀ y ∈ N, m ≤ Real.sqrt (G y).det) (U F Kc : Set E3) (hU : IsOpen U) (hF : IsOpen F) (hFK : Disjoint F Kc) {ι : Type} [Fintype ι] (a : ι → Fin 3) (c : ι → E3) (r δ : ι → ℝ) (v : ι → (Fin 2 → ℝ) → ℝ) (Q : ι → Set (Fin 2 → ℝ)) (χ : ι → E3 → ℝ) (hv : ∀ i, Continuous (v i)) (hvin : ∀ i, ∀ x ∈ smthDisc (a i) (c i) (r i), |v i x - c i (a i)| < δ i) (hcyl : ∀ i, {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i} ⊆ U ∩ N) (hgraph : ∀ i, ∀ z : E3, smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) → |z (a i) - c i (a i)| < δ i → (z ∈ Kc ↔ z (a i) = v i (smthHoriz (a i) z))) (hup : ∀ i, {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ v i (smthHoriz (a i) z) < z (a i)} ⊆ F ∨ Disjoint {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ v i (smthHoriz (a i) z) < z (a i)} F) (hlo : ∀ i, {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ z (a i) < v i (smthHoriz (a i) z)} ⊆ F ∨ Disjoint {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ z (a i) < v i (smthHoriz (a i) z)} F) (hone : ∀ i, {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ v i (smthHoriz (a i) z) < z (a i)} ⊆ F ∨ {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i ∧ z (a i) < v i (smthHoriz (a i) z)} ⊆ F) (hQ : ∀ i, IsCompact (Q i) ∧ Q i ⊆ smthDisc (a i) (c i) (r i)) (hχ : ∀ i, ContDiff ℝ ∞ (χ i) ∧ (∀ z, 0 ≤ χ i z ∧ χ i z ≤ 1) ∧ (∀ x ∈ Q i, χ i (smthLift (a i) x (v i x)) = 1) ∧ HasCompactSupport (χ i) ∧ tsupport (χ i) ⊆ {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i}) (hχd : Pairwise fun i j => Disjoint (tsupport (χ i)) (tsupport (χ j))) (hftc : ∀ (b : Fin 3) (w : (Fin 2 → ℝ) → ℝ) (h : E3 → ℝ), Continuous w → ContDiff ℝ 1 h → HasCompactSupport h → (∫ z in {z : E3 | w (smthHoriz b z) < z b}, partialDeriv b h z) = -∫ x, h (smthLift b x (w x)) ∧ (∫ z in {z : E3 | z b < w (smthHoriz b z)}, partialDeriv b h z) = ∫ x, h (smthLift b x (w x))) : ENNReal.ofReal (m / Real.sqrt Γ) * ∑ i, MeasureTheory.volume (Q i) ≤ hullPerG G F U Kc :=
by
  classical
  
  have s2 : ∀ (s χ' : E3 → ℝ), ContDiffOn ℝ ∞ s T → ContDiff ℝ ∞ χ' →
      tsupport χ' ⊆ T → ContDiff ℝ ∞ (fun z => χ' z * s z) := by
    intro s χ' hs hχ' hχT
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ tsupport χ'
    · exact hχ'.contDiffAt.mul (hs.contDiffAt (hT.mem_nhds (hχT hy)))
    · have h0 : χ' =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
      refine (contDiffAt_const (c := (0:ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [h0] with z hz
      simp [hz]
  have s3 : ∀ (φ ψ : E3 → ℝ) (y : E3) (b : Fin 3), DifferentiableAt ℝ ψ y →
      (∀ᶠ t in 𝓝[>] (0:ℝ), φ (y + t • e b) = ψ (y + t • e b)) →
      |partialDeriv b φ y| ≤ |partialDeriv b ψ y| := by
    intro φ ψ y b hψ hray
    by_cases hφ : DifferentiableAt ℝ φ y
    · apply le_of_eq
      congr 1
      have hℓ : HasDerivAt (fun t : ℝ => y + t • e b) (e b) 0 := by
        simpa using ((hasDerivAt_id (0:ℝ)).smul_const (e b)).const_add y
      have hy0 : y = y + (0:ℝ) • e b := by simp
      have h1 : HasDerivAt (fun t : ℝ => φ (y + t • e b)) (fderiv ℝ φ y (e b)) 0 :=
        hφ.hasFDerivAt.comp_hasDerivAt_of_eq 0 hℓ hy0
      have h2 : HasDerivAt (fun t : ℝ => ψ (y + t • e b)) (fderiv ℝ ψ y (e b)) 0 :=
        hψ.hasFDerivAt.comp_hasDerivAt_of_eq 0 hℓ hy0
      have hT1 : Tendsto (fun t : ℝ => φ (y + t • e b)) (𝓝[>] 0) (𝓝 (φ y)) := by
        have := h1.continuousAt.tendsto.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0:ℝ)))
        simpa using this
      have hT2 : Tendsto (fun t : ℝ => ψ (y + t • e b)) (𝓝[>] 0) (𝓝 (ψ y)) := by
        have := h2.continuousAt.tendsto.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0:ℝ)))
        simpa using this
      have hT1' : Tendsto (fun t : ℝ => φ (y + t • e b)) (𝓝[>] 0) (𝓝 (ψ y)) :=
        hT2.congr' (hray.mono fun t ht => ht.symm)
      have hval : φ y = ψ y := tendsto_nhds_unique hT1 hT1'
      have h2' : HasDerivWithinAt (fun t : ℝ => φ (y + t • e b)) (fderiv ℝ ψ y (e b))
          (Set.Ioi 0) 0 :=
        h2.hasDerivWithinAt.congr_of_eventuallyEq hray (by simpa using hval)
      exact (uniqueDiffWithinAt_Ioi 0).eq_deriv _ h1.hasDerivWithinAt h2'
    · simp only [partialDeriv, fderiv_zero_of_not_differentiableAt hφ]
      simp
  have pd_loc : ∀ (S f : E3 → ℝ) (O : Set E3) (cst : ℝ) (b : Fin 3) (y : E3), IsOpen O → y ∈ O →
      (∀ z ∈ O, S z = cst) → DifferentiableAt ℝ f y →
      partialDeriv b (fun z => S z * f z) y = cst * partialDeriv b f y := by
    intro S f O cst b y hO hy hS hf
    have hev : (fun z => S z * f z) =ᶠ[𝓝 y] fun z => cst * f z :=
      Filter.eventually_of_mem (hO.mem_nhds hy) (fun z hz => by simp only [hS z hz])
    unfold partialDeriv
    rw [hev.fderiv_eq, fderiv_const_mul hf, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have pd_const : ∀ (f : E3 → ℝ) (cst : ℝ) (b : Fin 3) (y : E3), DifferentiableAt ℝ f y →
      partialDeriv b (fun z => cst * f z) y = cst * partialDeriv b f y := by
    intro f cst b y hf
    unfold partialDeriv
    rw [fderiv_const_mul hf, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have pd_zero : ∀ (g : E3 → ℝ) (b : Fin 3) (y : E3), g =ᶠ[𝓝 y] 0 → partialDeriv b g y = 0 := by
    intro g b y hg
    unfold partialDeriv
    rw [hg.fderiv_eq]
    simp
  have cd_loc : ∀ (S f : E3 → ℝ) (O : Set E3) (cst : ℝ) (y : E3), IsOpen O → y ∈ O →
      (∀ z ∈ O, S z = cst) → ContDiff ℝ ∞ f → ContDiffAt ℝ ∞ (fun z => S z * f z) y := by
    intro S f O cst y hO hy hS hf
    refine ((contDiffAt_const (c := cst)).mul hf.contDiffAt).congr_of_eventuallyEq ?_
    exact Filter.eventually_of_mem (hO.mem_nhds hy) (fun z hz => by simp only [hS z hz])
  have ev_zero : ∀ (S f : E3 → ℝ) (y : E3), y ∉ tsupport f →
      (fun z => S z * f z) =ᶠ[𝓝 y] 0 := by
    intro S f y hy
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hy] with z hz
    simp [hz]
  have split : ∀ (φ : ι → E3 → ℝ), (Pairwise fun i j => Disjoint (tsupport (φ i)) (tsupport (φ j))) →
      ∀ y, ∑ j : Fin 3, partialDeriv j (fun z => ∑ i, if a i = j then φ i z else 0) y =
        ∑ i, partialDeriv (a i) (φ i) y := by
    intro φ hφ y
    by_cases hex : ∃ i₀, y ∈ tsupport (φ i₀)
    · obtain ⟨i₀, hi₀⟩ := hex
      have hoth : ∀ i, i ≠ i₀ → φ i =ᶠ[𝓝 y] 0 := fun i hi =>
        notMem_tsupport_iff_eventuallyEq.mp (fun hy => Set.disjoint_left.mp (hφ hi) hy hi₀)
      have hall : ∀ᶠ z in 𝓝 y, ∀ i, i ≠ i₀ → φ i z = 0 := by
        rw [Filter.eventually_all]
        intro i
        by_cases hi : i = i₀
        · exact Filter.Eventually.of_forall (fun z h => absurd hi h)
        · filter_upwards [hoth i hi] with z hz
          intro _
          exact hz
      have hj : ∀ j, partialDeriv j (fun z => ∑ i, if a i = j then φ i z else 0) y =
          if a i₀ = j then partialDeriv j (φ i₀) y else 0 := by
        intro j
        have hev : (fun z => ∑ i, if a i = j then φ i z else 0) =ᶠ[𝓝 y]
            (fun z => if a i₀ = j then φ i₀ z else 0) := by
          filter_upwards [hall] with z hz
          rw [Finset.sum_eq_single i₀]
          · intro i _ hi
            simp [hz i hi]
          · intro h
            exact absurd (Finset.mem_univ _) h
        unfold partialDeriv
        rw [hev.fderiv_eq]
        by_cases hij : a i₀ = j
        · subst hij
          simp
        · simp [hij]
      rw [Finset.sum_congr rfl (fun j _ => hj j), Finset.sum_ite_eq]
      rw [if_pos (Finset.mem_univ _), Finset.sum_eq_single i₀]
      · intro i _ hi
        exact pd_zero _ _ _ (hoth i hi)
      · intro h
        exact absurd (Finset.mem_univ _) h
    · push_neg at hex
      have hall : ∀ᶠ z in 𝓝 y, ∀ i, φ i z = 0 := by
        rw [Filter.eventually_all]
        intro i
        exact notMem_tsupport_iff_eventuallyEq.mp (hex i)
      rw [Finset.sum_eq_zero, Finset.sum_eq_zero]
      · intro i _
        exact pd_zero _ _ _ (notMem_tsupport_iff_eventuallyEq.mp (hex i))
      · intro j _
        refine pd_zero _ _ _ ?_
        filter_upwards [hall] with z hz
        simp [hz]
  
  have horizC : ∀ b : Fin 3, Continuous (smthHoriz b) := by
    intro b
    unfold smthHoriz
    fun_prop
  have liftH : ∀ (b : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), smthHoriz b (smthLift b x t) = x := by
    intro b x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) b t x k
  have liftA : ∀ (b : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), (smthLift b x t) b = t := by
    intro b x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) b t x
  have gamC : ∀ (b : Fin 3) (w : (Fin 2 → ℝ) → ℝ), Continuous w →
      Continuous (fun x => smthLift b x (w x)) := by
    intro b w hw
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth b hw continuous_id)
  have rayA : ∀ (b : Fin 3) (y : E3) (t : ℝ), (y + t • e b) b = y b + t := by
    intro b y t
    simp
  have rayH : ∀ (b : Fin 3) (y : E3) (t : ℝ), smthHoriz b (y + t • e b) = smthHoriz b y := by
    intro b y t
    funext k
    simp [smthHoriz, EuclideanSpace.single_apply, Fin.succAbove_ne]
  
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ, lam = 1 / Real.sqrt Γ := ⟨_, rfl⟩
  have hsq : 0 < Real.sqrt Γ := Real.sqrt_pos.2 hΓ
  have hlam0 : 0 < lam := by rw [hlam]; positivity
  have hlamΓ : lam ^ 2 * Γ = 1 := by
    rw [hlam, div_pow, Real.sq_sqrt hΓ.le]
    field_simp
  have hlamm : lam * m = m / Real.sqrt Γ := by rw [hlam]; ring
  have hsupp : ∀ i z, z ∈ tsupport (χ i) → z ∈ U ∧ z ∈ N ∧
      (z ∈ Kc ↔ z (a i) = v i (smthHoriz (a i) z)) := by
    intro i z hz
    have hc := (hχ i).2.2.2.2 hz
    exact ⟨(hcyl i hc).1, (hcyl i hc).2, hgraph i z hc.1 hc.2⟩
  
  obtain ⟨α, β, hαb, hβb, hα0, hβ0, hβα⟩ : ∃ α β : ι → ℝ, (∀ i, |α i| ≤ lam) ∧
      (∀ i, |β i| ≤ lam) ∧
      (∀ i, α i ≠ 0 → ∀ z, smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) →
        |z (a i) - c i (a i)| < δ i → v i (smthHoriz (a i) z) < z (a i) → z ∈ F) ∧
      (∀ i, β i ≠ 0 → ∀ z, smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) →
        |z (a i) - c i (a i)| < δ i → z (a i) < v i (smthHoriz (a i) z) → z ∈ F) ∧
      (∀ i, lam ≤ β i - α i) := by
    refine ⟨fun i => if {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧
        |z (a i) - c i (a i)| < δ i ∧ v i (smthHoriz (a i) z) < z (a i)} ⊆ F then -lam else 0,
      fun i => if {z : E3 | smthHoriz (a i) z ∈ smthDisc (a i) (c i) (r i) ∧
        |z (a i) - c i (a i)| < δ i ∧ z (a i) < v i (smthHoriz (a i) z)} ⊆ F then lam else 0,
      ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      dsimp only
      split_ifs
      · rw [abs_neg, abs_of_pos hlam0]
      · simp [hlam0.le]
    · intro i
      dsimp only
      split_ifs
      · rw [abs_of_pos hlam0]
      · simp [hlam0.le]
    · intro i hne z h1 h2 h3
      dsimp only at hne
      split_ifs at hne with hs
      · exact hs ⟨h1, h2, h3⟩
      · exact absurd rfl hne
    · intro i hne z h1 h2 h3
      dsimp only at hne
      split_ifs at hne with hs
      · exact hs ⟨h1, h2, h3⟩
      · exact absurd rfl hne
    · intro i
      dsimp only
      split_ifs with h1 h2 h2
      · linarith
      · linarith
      · linarith
      · exfalso
        rcases hone i with h | h
        · exact h2 h
        · exact h1 h
  obtain ⟨S, hSup, hSlo, hSb⟩ : ∃ S : ι → E3 → ℝ,
      (∀ i z, v i (smthHoriz (a i) z) < z (a i) → S i z = α i) ∧
      (∀ i z, z (a i) < v i (smthHoriz (a i) z) → S i z = β i) ∧ (∀ i z, |S i z| ≤ lam) := by
    refine ⟨fun i z => if v i (smthHoriz (a i) z) < z (a i) then α i
      else if z (a i) < v i (smthHoriz (a i) z) then β i else 0, ?_, ?_, ?_⟩
    · intro i z h
      simp only [if_pos h]
    · intro i z h
      simp only [if_neg (not_lt.2 h.le), if_pos h]
    · intro i z
      dsimp only
      split_ifs
      · exact hαb i
      · exact hβb i
      · simp [hlam0.le]
  have hUpO : ∀ i, IsOpen {z : E3 | v i (smthHoriz (a i) z) < z (a i)} := fun i =>
    isOpen_lt ((hv i).comp (horizC (a i))) (by fun_prop)
  have hLoO : ∀ i, IsOpen {z : E3 | z (a i) < v i (smthHoriz (a i) z)} := fun i =>
    isOpen_lt (by fun_prop) ((hv i).comp (horizC (a i)))
  
  have hsd : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) T := by
    have h := hG
    have hP : ContDiffOn ℝ ∞ (fun z => G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
        - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
        + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0) T :=
      (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    have hdetS : ContDiffOn ℝ ∞ (fun z => (G z).det) T :=
      hP.congr (fun z _ => Matrix.det_fin_three (G z))
    exact hdetS.sqrt (fun z hz => (hdet z hz).ne')
  obtain ⟨h, hhdef⟩ : ∃ h : ι → E3 → ℝ, h = fun i z => χ i z * Real.sqrt (G z).det := ⟨_, rfl⟩
  have hh : ∀ i, ContDiff ℝ ∞ (h i) := by
    intro i
    rw [hhdef]
    exact s2 _ _ hsd (hχ i).1 (fun z hz => hNT ((hsupp i z hz).2.1))
  have hhc : ∀ i, HasCompactSupport (h i) := by
    intro i
    rw [hhdef]
    exact (hχ i).2.2.2.1.mul_right
  have hhs : ∀ i, tsupport (h i) ⊆ tsupport (χ i) := by
    intro i
    rw [hhdef]
    exact tsupport_mul_subset_left
  have hh0 : ∀ i z, 0 ≤ h i z := by
    intro i z
    rw [hhdef]
    exact mul_nonneg ((hχ i).2.1 z).1 (Real.sqrt_nonneg _)
  have hhd : ∀ i, Differentiable ℝ (h i) := fun i => (hh i).differentiable (by simp)
  have hpc : ∀ i, Continuous (fun y => partialDeriv (a i) (h i) y) := fun i =>
    ((hh i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hpcs : ∀ i, HasCompactSupport (fun y => partialDeriv (a i) (h i) y) := fun i =>
    (hhc i).fderiv_apply (𝕜 := ℝ) (e (a i))
  have hpi : ∀ i, Integrable (fun y => partialDeriv (a i) (h i) y) := fun i =>
    (hpc i).integrable_of_hasCompactSupport (hpcs i)
  have hp0 : ∀ i y, y ∉ tsupport (h i) → partialDeriv (a i) (h i) y = 0 := fun i y hy =>
    pd_zero _ _ _ (notMem_tsupport_iff_eventuallyEq.mp hy)
  
  have hD : ∀ i y, |partialDeriv (a i) (fun z => S i z * h i z) y| ≤
      lam * |partialDeriv (a i) (h i) y| := by
    intro i y
    rcases lt_trichotomy (v i (smthHoriz (a i) y)) (y (a i)) with hlt | heq | hgt
    · rw [pd_loc (S i) (h i) _ (α i) (a i) y (hUpO i) hlt (fun z hz => hSup i z hz)
        ((hhd i) y), abs_mul]
      exact mul_le_mul_of_nonneg_right (hαb i) (abs_nonneg _)
    · have hray : ∀ᶠ t in 𝓝[>] (0:ℝ), (fun z => S i z * h i z) (y + t • e (a i)) =
          (fun z => α i * h i z) (y + t • e (a i)) := by
        refine eventually_nhdsWithin_of_forall ?_
        intro t ht
        have ht' : (0:ℝ) < t := ht
        have hup' : v i (smthHoriz (a i) (y + t • e (a i))) < (y + t • e (a i)) (a i) := by
          rw [rayH, rayA]
          linarith
        simp only [hSup i _ hup']
      refine (s3 _ _ y (a i) (((hhd i) y).const_mul (α i)) hray).trans ?_
      rw [pd_const (h i) (α i) (a i) y ((hhd i) y), abs_mul]
      exact mul_le_mul_of_nonneg_right (hαb i) (abs_nonneg _)
    · rw [pd_loc (S i) (h i) _ (β i) (a i) y (hLoO i) hgt (fun z hz => hSlo i z hz)
        ((hhd i) y), abs_mul]
      exact mul_le_mul_of_nonneg_right (hβb i) (abs_nonneg _)
  
  obtain ⟨X, hXdef⟩ : ∃ X : E3 → E3, X = fun z => ∑ i, (S i z * χ i z) • e (a i) := ⟨_, rfl⟩
  
  have hA1 : ∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X y := by
    intro y hy
    rw [hXdef]
    refine ContDiffAt.sum (fun i _ => ?_)
    have hci : ContDiffAt ℝ ∞ (fun z => S i z * χ i z) y := by
      by_cases hyt : y ∈ tsupport (χ i)
      · have hne : y (a i) ≠ v i (smthHoriz (a i) y) := fun h' => hy ((hsupp i y hyt).2.2.mpr h')
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · exact cd_loc (S i) (χ i) _ (β i) y (hLoO i) hlt (fun z hz => hSlo i z hz) (hχ i).1
        · exact cd_loc (S i) (χ i) _ (α i) y (hUpO i) hgt (fun z hz => hSup i z hz) (hχ i).1
      · exact (contDiffAt_const (c := (0:ℝ))).congr_of_eventuallyEq (ev_zero (S i) (χ i) y hyt)
    exact hci.smul (contDiffAt_const (c := e (a i)))
  
  have hsuppX : Function.support X ⊆ ⋃ i, tsupport (χ i) := by
    intro z hz
    by_contra hcon
    simp only [Set.mem_iUnion, not_exists] at hcon
    apply hz
    rw [hXdef]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    rw [image_eq_zero_of_notMem_tsupport (hcon i), mul_zero, zero_smul]
  have hWc : IsCompact (⋃ i, tsupport (χ i)) := isCompact_iUnion (fun i => (hχ i).2.2.2.1)
  have hXW : tsupport X ⊆ ⋃ i, tsupport (χ i) := closure_minimal hsuppX hWc.isClosed
  have hA2a : HasCompactSupport X := hWc.of_isClosed_subset (isClosed_tsupport X) hXW
  have hA2b : tsupport X ⊆ U :=
    hXW.trans (Set.iUnion_subset fun i z hz => (hsupp i z hz).1)
  
  have hA3 : ∀ y, ∑ j : Fin 3, ∑ k : Fin 3, G y j k * X y j * X y k ≤ 1 := by
    intro y
    by_cases hex : ∃ i₀, S i₀ y * χ i₀ y ≠ 0
    · obtain ⟨i₀, hi₀⟩ := hex
      have hχ0 : χ i₀ y ≠ 0 := right_ne_zero_of_mul hi₀
      have hyt : y ∈ tsupport (χ i₀) := subset_tsupport _ hχ0
      have hoth : ∀ i, i ≠ i₀ → S i y * χ i y = 0 := by
        intro i hi
        have : χ i y = 0 :=
          image_eq_zero_of_notMem_tsupport (fun h' => Set.disjoint_left.mp (hχd hi) h' hyt)
        rw [this, mul_zero]
      have hcb : |S i₀ y * χ i₀ y| ≤ lam := by
        rw [abs_mul, abs_of_nonneg ((hχ i₀).2.1 y).1]
        have h1 := hSb i₀ y
        have h2 := ((hχ i₀).2.1 y).2
        nlinarith [abs_nonneg (S i₀ y)]
      have hGb := hGa y (hsupp i₀ y hyt).2.1 (a i₀)
      have hXy : X y = (S i₀ y * χ i₀ y) • e (a i₀) := by
        rw [hXdef]
        exact Finset.sum_eq_single i₀ (fun i _ hi => by rw [hoth i hi, zero_smul])
          (fun h' => absurd (Finset.mem_univ _) h')
      generalize S i₀ y * χ i₀ y = cc at hXy hcb
      have hXj : ∀ j, X y j = if j = a i₀ then cc else 0 := by
        intro j
        rw [hXy]
        simp [EuclideanSpace.single_apply]
      simp only [hXj, mul_ite, ite_mul, mul_zero, zero_mul, Finset.sum_ite_eq', Finset.mem_univ,
        if_true]
      have hc2 : cc * cc ≤ lam * lam := by
        rw [← abs_mul_abs_self cc]
        exact mul_self_le_mul_self (abs_nonneg _) hcb
      rcases le_or_gt (G y (a i₀) (a i₀)) 0 with hG0 | hG0
      · nlinarith [mul_self_nonneg cc]
      · nlinarith [mul_le_mul_of_nonneg_left hc2 hG0.le]
    · push_neg at hex
      have hXy : X y = 0 := by
        rw [hXdef]
        exact Finset.sum_eq_zero (fun i _ => by rw [hex i, zero_smul])
      simp [hXy]
  
  have hφd : Pairwise fun i j => Disjoint (tsupport (fun z => S i z * h i z))
      (tsupport (fun z => S j z * h j z)) := fun i j hij =>
    (hχd hij).mono (tsupport_mul_subset_right.trans (hhs i))
      (tsupport_mul_subset_right.trans (hhs j))
  have hXcomp : ∀ j : Fin 3, (fun z => Real.sqrt (G z).det * X z j) =
      fun z => ∑ i, if a i = j then S i z * h i z else 0 := by
    intro j
    funext z
    rw [hXdef, hhdef]
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply,
      EuclideanSpace.single_apply, smul_eq_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    by_cases hij : a i = j
    · subst hij
      simp only [if_true]
      ring
    · rw [if_neg (Ne.symm hij), if_neg hij]
      ring
  have hdiv : ∀ y, sepDensDiv G X y = ∑ i, partialDeriv (a i) (fun z => S i z * h i z) y := by
    intro y
    unfold sepDensDiv
    rw [Finset.sum_congr rfl (fun j _ => by rw [hXcomp j])]
    exact split (fun i z => S i z * h i z) hφd y
  
  have hB : ∀ i, ∃ B, ∀ y, |partialDeriv (a i) (h i) y| ≤ B := by
    intro i
    obtain ⟨B, hB⟩ := (hpc i).bounded_above_of_compact_support (hpcs i)
    exact ⟨B, fun y => by simpa [Real.norm_eq_abs] using hB y⟩
  choose B hBb using hB
  have hA4 : ∃ C : ℝ, ∀ y, |sepDensDiv G X y| ≤ C := by
    refine ⟨∑ i, lam * B i, fun y => ?_⟩
    rw [hdiv y]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    exact (hD i y).trans (mul_le_mul_of_nonneg_left (hBb i y) hlam0.le)
  
  have hDi : ∀ i, Integrable (fun y => partialDeriv (a i) (fun z => S i z * h i z) y) := by
    intro i
    refine ((hpi i).abs.const_mul lam).mono' ?_ (ae_of_all _ fun y => ?_)
    · exact (measurable_fderiv_apply_const ℝ (fun z => S i z * h i z) (e (a i))).aestronglyMeasurable
    · rw [Real.norm_eq_abs]
      exact hD i y
  have hflux : ∀ i, lam * m * (volume (Q i)).toReal ≤
      ∫ y in F, partialDeriv (a i) (fun z => S i z * h i z) y := by
    intro i
    obtain ⟨hf1, hf2⟩ := hftc (a i) (v i) (h i) (hv i) ((hh i).of_le (by simp)) (hhc i)
    have hPm : MeasurableSet {z : E3 | v i (smthHoriz (a i) z) < z (a i)} := (hUpO i).measurableSet
    have hLm : MeasurableSet {z : E3 | z (a i) < v i (smthHoriz (a i) z)} := (hLoO i).measurableSet
    have hDF : ∀ z ∈ F, partialDeriv (a i) (fun z => S i z * h i z) z =
        {z : E3 | v i (smthHoriz (a i) z) < z (a i)}.indicator
          (fun z => α i * partialDeriv (a i) (h i) z) z +
        {z : E3 | z (a i) < v i (smthHoriz (a i) z)}.indicator
          (fun z => β i * partialDeriv (a i) (h i) z) z := by
      intro z hzF
      by_cases hzP : v i (smthHoriz (a i) z) < z (a i)
      · have hzL : ¬ z (a i) < v i (smthHoriz (a i) z) := fun h' => lt_asymm hzP h'
        rw [Set.indicator_of_mem (show z ∈ {z : E3 | v i (smthHoriz (a i) z) < z (a i)} from hzP),
          Set.indicator_of_notMem (show z ∉ {z : E3 | z (a i) < v i (smthHoriz (a i) z)} from hzL),
          add_zero]
        exact pd_loc (S i) (h i) _ (α i) (a i) z (hUpO i) hzP (fun w hw => hSup i w hw) ((hhd i) z)
      · by_cases hzL : z (a i) < v i (smthHoriz (a i) z)
        · rw [Set.indicator_of_notMem (show z ∉ {z : E3 | v i (smthHoriz (a i) z) < z (a i)} from hzP),
            Set.indicator_of_mem (show z ∈ {z : E3 | z (a i) < v i (smthHoriz (a i) z)} from hzL),
            zero_add]
          exact pd_loc (S i) (h i) _ (β i) (a i) z (hLoO i) hzL (fun w hw => hSlo i w hw)
            ((hhd i) z)
        · rw [Set.indicator_of_notMem (show z ∉ {z : E3 | v i (smthHoriz (a i) z) < z (a i)} from hzP),
            Set.indicator_of_notMem (show z ∉ {z : E3 | z (a i) < v i (smthHoriz (a i) z)} from hzL),
            add_zero]
          have heq : z (a i) = v i (smthHoriz (a i) z) := by
            push_neg at hzP hzL
            linarith
          have hzt : z ∉ tsupport (h i) := fun hzt =>
            Set.disjoint_left.mp hFK hzF ((hsupp i z (hhs i hzt)).2.2.mpr heq)
          exact pd_zero _ _ _ (ev_zero (S i) (h i) z hzt)
    have hoffF : ∀ z, z ∉ F →
        {z : E3 | v i (smthHoriz (a i) z) < z (a i)}.indicator
          (fun z => α i * partialDeriv (a i) (h i) z) z +
        {z : E3 | z (a i) < v i (smthHoriz (a i) z)}.indicator
          (fun z => β i * partialDeriv (a i) (h i) z) z = 0 := by
      intro z hzF
      have h1 : {z : E3 | v i (smthHoriz (a i) z) < z (a i)}.indicator
          (fun z => α i * partialDeriv (a i) (h i) z) z = 0 := by
        by_cases hα : α i = 0
        · simp [hα]
        · by_cases hzP : v i (smthHoriz (a i) z) < z (a i)
          · have hzt : z ∉ tsupport (h i) := by
              intro hzt
              have hc := (hχ i).2.2.2.2 (hhs i hzt)
              exact hzF (hα0 i hα z hc.1 hc.2 hzP)
            rw [Set.indicator_of_mem (show z ∈ {z : E3 | v i (smthHoriz (a i) z) < z (a i)} from hzP),
              hp0 i z hzt, mul_zero]
          · exact Set.indicator_of_notMem (show z ∉ {z : E3 | v i (smthHoriz (a i) z) < z (a i)} from hzP) _
      have h2 : {z : E3 | z (a i) < v i (smthHoriz (a i) z)}.indicator
          (fun z => β i * partialDeriv (a i) (h i) z) z = 0 := by
        by_cases hβ : β i = 0
        · simp [hβ]
        · by_cases hzL : z (a i) < v i (smthHoriz (a i) z)
          · have hzt : z ∉ tsupport (h i) := by
              intro hzt
              have hc := (hχ i).2.2.2.2 (hhs i hzt)
              exact hzF (hβ0 i hβ z hc.1 hc.2 hzL)
            rw [Set.indicator_of_mem (show z ∈ {z : E3 | z (a i) < v i (smthHoriz (a i) z)} from hzL),
              hp0 i z hzt, mul_zero]
          · exact Set.indicator_of_notMem (show z ∉ {z : E3 | z (a i) < v i (smthHoriz (a i) z)} from hzL) _
      rw [h1, h2, add_zero]
    have hint : ∫ y in F, partialDeriv (a i) (fun z => S i z * h i z) y =
        α i * (∫ z in {z : E3 | v i (smthHoriz (a i) z) < z (a i)}, partialDeriv (a i) (h i) z) +
        β i * (∫ z in {z : E3 | z (a i) < v i (smthHoriz (a i) z)}, partialDeriv (a i) (h i) z) := by
      rw [setIntegral_congr_fun hF.measurableSet hDF,
        setIntegral_eq_integral_of_forall_compl_eq_zero hoffF,
        integral_add (((hpi i).const_mul (α i)).indicator hPm)
          (((hpi i).const_mul (β i)).indicator hLm),
        integral_indicator hPm, integral_indicator hLm, integral_const_mul, integral_const_mul]
    have hIm : m * (volume (Q i)).toReal ≤ ∫ x, h i (smthLift (a i) x (v i x)) := by
      have hgc : Continuous (fun x => h i (smthLift (a i) x (v i x))) :=
        (hh i).continuous.comp (gamC (a i) (v i) (hv i))
      have hgcs : HasCompactSupport (fun x => h i (smthLift (a i) x (v i x))) := by
        refine HasCompactSupport.intro (IsCompact.image (hhc i) (horizC (a i))) ?_
        intro x hx
        by_contra hne
        exact hx ⟨_, subset_tsupport _ hne, liftH (a i) x (v i x)⟩
      have hgi : Integrable (fun x => h i (smthLift (a i) x (v i x))) :=
        hgc.integrable_of_hasCompactSupport hgcs
      have hQm := (hQ i).1.measurableSet
      calc m * (volume (Q i)).toReal = ∫ x in Q i, m := by
            rw [setIntegral_const, smul_eq_mul, Measure.real, mul_comm]
        _ ≤ ∫ x in Q i, h i (smthLift (a i) x (v i x)) := by
          refine setIntegral_mono_on ?_ hgi.integrableOn hQm ?_
          · exact continuousOn_const.integrableOn_compact (hQ i).1
          · intro x hx
            have hγ : smthLift (a i) x (v i x) ∈ N := by
              have hmem : smthLift (a i) x (v i x) ∈ {z : E3 | smthHoriz (a i) z ∈
                  smthDisc (a i) (c i) (r i) ∧ |z (a i) - c i (a i)| < δ i} := by
                refine ⟨?_, ?_⟩
                · rw [liftH]
                  exact (hQ i).2 hx
                · rw [liftA]
                  exact hvin i x ((hQ i).2 hx)
              exact (hcyl i hmem).2
            simp only [hhdef]
            rw [(hχ i).2.2.1 x hx, one_mul]
            exact hGm _ hγ
        _ ≤ ∫ x, h i (smthLift (a i) x (v i x)) :=
          setIntegral_le_integral hgi (ae_of_all _ fun x => hh0 i _)
    have hI0 : 0 ≤ ∫ x, h i (smthLift (a i) x (v i x)) := integral_nonneg (fun x => hh0 i _)
    rw [hint, hf1, hf2]
    nlinarith [mul_nonneg (sub_nonneg.2 (hβα i)) hI0, mul_le_mul_of_nonneg_left hIm hlam0.le]
  
  have htot : ∫ y in F, sepDensDiv G X y =
      ∑ i, ∫ y in F, partialDeriv (a i) (fun z => S i z * h i z) y := by
    simp_rw [hdiv]
    exact integral_finset_sum _ (fun i _ => (hDi i).integrableOn)
  have hmain : m / Real.sqrt Γ * ∑ i, (volume (Q i)).toReal ≤ ∫ y in F, sepDensDiv G X y := by
    rw [htot, ← hlamm, Finset.mul_sum]
    exact Finset.sum_le_sum fun i _ => hflux i
  have hENN : ENNReal.ofReal (m / Real.sqrt Γ) * ∑ i, volume (Q i) =
      ENNReal.ofReal (m / Real.sqrt Γ * ∑ i, (volume (Q i)).toReal) := by
    rw [ENNReal.ofReal_mul (div_nonneg hm.le (Real.sqrt_nonneg _)),
      ENNReal.ofReal_sum_of_nonneg (fun i _ => ENNReal.toReal_nonneg)]
    congr 1
    exact Finset.sum_congr rfl (fun i _ => (ENNReal.ofReal_toReal ((hQ i).1.measure_lt_top.ne)).symm)
  rw [hENN]
  refine (ENNReal.ofReal_le_ofReal hmain).trans ?_
  unfold hullPerG
  exact le_iSup₂_of_le X ⟨hA1, hA2a, hA2b, hA3, hA4⟩ le_rfl

theorem coordArea_le_cutPerimeter [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) :
    ∃ c : M → Set E3 → ℝ, (∀ q C, 0 ≤ c q C) ∧
      ∀ (Sig E Ω : Set M), IsCompact Sig → IsMinimalSurfaceSet g Sig → IsOpen E →
        frontier E = Sig → IsOpen Ω → Sig ⊆ Ω →
        ∀ (q : M) (C : Set E3), IsCompact C → C ⊆ (chartAt E3 q).target →
          MeasureTheory.Measure.hausdorffMeasure 2
              ((chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source) ∩ C) ≤
            ENNReal.ofReal (c q C) * hullRiemPer g E Ω Sig :=
by
  classical
  
  have liftH : ∀ (a : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro a x t
    funext k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) a t x k
  have liftA : ∀ (a : Fin 3) (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro a x t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) a t x
  have liftSelf : ∀ (a : Fin 3) (z : E3), smthLift a (smthHoriz a z) (z a) = z := by
    intro a z
    ext i
    exact congrFun (Fin.insertNth_self_removeNth (α := fun _ => ℝ) a (fun j => z j)) i
  have horizC : ∀ a : Fin 3, Continuous (smthHoriz a) := by
    intro a
    unfold smthHoriz
    fun_prop
  have gamC : ∀ (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ), Continuous v →
      Continuous (fun x => smthLift a x (v x)) := by
    intro a v hv
    unfold smthLift
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a hv continuous_id)
  have discOpen : ∀ (a : Fin 3) (c : E3) (r : ℝ), IsOpen (smthDisc a c r) := by
    intro a c r
    unfold smthDisc
    exact isOpen_lt (by fun_prop) continuous_const
  have cylOpen : ∀ (a : Fin 3) (c : E3) (r δ : ℝ),
      IsOpen {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ} := by
    intro a c r δ
    have h2 : Continuous (fun z : E3 => |z a - c a|) := by fun_prop
    exact ((discOpen a c r).preimage (horizC a)).inter (isOpen_lt h2 continuous_const)
  have selfCyl : ∀ (a : Fin 3) (c : E3) (r δ : ℝ), 0 < r → 0 < δ →
      c ∈ {z : E3 | smthHoriz a z ∈ smthDisc a c r ∧ |z a - c a| < δ} := by
    intro a c r δ hr hδ
    refine ⟨?_, by simpa using hδ⟩
    show ∑ k : Fin 2, (c (a.succAbove k) - c (a.succAbove k)) ^ 2 < r ^ 2
    simp only [sub_self]
    simpa using pow_pos hr 2
  have discBall : ∀ (a : Fin 3) (c : E3) (r : ℝ), 0 < r →
      smthDisc a c r ⊆ Metric.closedBall (smthHoriz a c) r := by
    intro a c r hr x hx
    simp only [smthDisc, Set.mem_setOf_eq, Fin.sum_univ_two] at hx
    rw [Metric.mem_closedBall, dist_pi_le_iff hr.le]
    intro k
    rw [Real.dist_eq]
    simp only [smthHoriz]
    fin_cases k
    · simp only [Fin.zero_eta, Fin.isValue]
      exact abs_le.mpr ⟨by nlinarith [sq_nonneg (x 1 - c (a.succAbove 1))],
        by nlinarith [sq_nonneg (x 1 - c (a.succAbove 1))]⟩
    · simp only [Fin.mk_one, Fin.isValue]
      exact abs_le.mpr ⟨by nlinarith [sq_nonneg (x 0 - c (a.succAbove 0))],
        by nlinarith [sq_nonneg (x 0 - c (a.succAbove 0))]⟩
  
  choose η Γ m hη hΓ hm hNt hGa hGm using
    fun (q : M) (C : Set E3) (hC : IsCompact C) (hCt : C ⊆ (chartAt E3 q).target) =>
      chart_metric_constants g q C hC hCt
  refine ⟨fun q C => if h : IsCompact C ∧ C ⊆ (chartAt E3 q).target then
    18 * Real.sqrt (Γ q C h.1 h.2) / m q C h.1 h.2 else 0, ?_, ?_⟩
  · intro q C
    by_cases h : IsCompact C ∧ C ⊆ (chartAt E3 q).target
    · simp only [dif_pos h]
      have h1 := hΓ q C h.1 h.2
      have h2 := hm q C h.1 h.2
      positivity
    · simp only [dif_neg h]
      exact le_refl 0
  intro Sig E Ω hSc hSm hEo hfr hΩo hSΩ q C hC hCt
  have hcd : IsCompact C ∧ C ⊆ (chartAt E3 q).target := ⟨hC, hCt⟩
  simp only [dif_pos hcd]
  suffices key : ∀ η' Γ' m' : ℝ, 0 < η' → 0 < Γ' → 0 < m' →
      Metric.cthickening η' C ⊆ (chartAt E3 q).target →
      (∀ y ∈ Metric.cthickening η' C, ∀ b : Fin 3, g.coeff (chartAt E3 q).symm y b b ≤ Γ') →
      (∀ y ∈ Metric.cthickening η' C, m' ≤ Real.sqrt (g.coeff (chartAt E3 q).symm y).det) →
      MeasureTheory.Measure.hausdorffMeasure 2
          ((chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source) ∩ C) ≤
        ENNReal.ofReal (18 * Real.sqrt Γ' / m') * hullRiemPer g E Ω Sig by
    exact key _ _ _ (hη q C hcd.1 hcd.2) (hΓ q C hcd.1 hcd.2) (hm q C hcd.1 hcd.2)
      (hNt q C hcd.1 hcd.2) (hGa q C hcd.1 hcd.2) (hGm q C hcd.1 hcd.2)
  intro η' Γ' m' hη' hΓ' hm' hNt' hGa' hGm'
  
  have hP : hullPerG (g.coeff (chartAt E3 q).symm)
      ((chartAt E3 q) '' (E ∩ (chartAt E3 q).source))
      ((chartAt E3 q) '' (Ω ∩ (chartAt E3 q).source))
      ((chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source)) ≤ hullRiemPer g E Ω Sig := by
    have hW : (∀ k : Fin 1, IsOpen ((fun _ : Fin 1 => Ω ∩ (chartAt E3 q).source) k) ∧
        (fun _ : Fin 1 => Ω ∩ (chartAt E3 q).source) k ⊆
          Ω ∩ (chartAt E3 ((fun _ : Fin 1 => q) k)).source) ∧
        Pairwise (fun k l : Fin 1 => Disjoint ((fun _ : Fin 1 => Ω ∩ (chartAt E3 q).source) k)
          ((fun _ : Fin 1 => Ω ∩ (chartAt E3 q).source) l)) :=
      ⟨fun _ => ⟨hΩo.inter (chartAt E3 q).open_source, le_rfl⟩,
        fun k l hkl => absurd (Subsingleton.elim k l) hkl⟩
    unfold hullRiemPer
    refine le_trans ?_ (le_iSup_of_le 1 (le_iSup_of_le (fun _ : Fin 1 => q)
      (le_iSup_of_le (fun _ : Fin 1 => Ω ∩ (chartAt E3 q).source) (le_iSup_of_le hW le_rfl))))
    exact (Fin.sum_univ_one (fun _ : Fin 1 => hullPerG (g.coeff (chartAt E3 q).symm)
      ((chartAt E3 q) '' (E ∩ (chartAt E3 q).source))
      ((chartAt E3 q) '' (Ω ∩ (chartAt E3 q).source))
      ((chartAt E3 q) '' (Sig ∩ (chartAt E3 q).source)))).symm.le
  set κ := chartAt E3 q with hκ
  set Kc : Set E3 := κ '' (Sig ∩ κ.source) with hKcdef
  set F : Set E3 := κ '' (E ∩ κ.source) with hFdef
  set U : Set E3 := κ '' (Ω ∩ κ.source) with hUdef
  set F' : Set E3 := κ '' ((closure E)ᶜ ∩ κ.source) with hF'def
  
  have hFo : IsOpen F :=
    κ.isOpen_image_of_subset_source (hEo.inter κ.open_source) Set.inter_subset_right
  have hUo : IsOpen U :=
    κ.isOpen_image_of_subset_source (hΩo.inter κ.open_source) Set.inter_subset_right
  have hF'o : IsOpen F' :=
    κ.isOpen_image_of_subset_source (isClosed_closure.isOpen_compl.inter κ.open_source)
      Set.inter_subset_right
  have hEfr : ∀ x, x ∈ E → x ∉ Sig := by
    intro x hx hxS
    rw [← hfr, hEo.frontier_eq] at hxS
    exact hxS.2 hx
  have hFK : Disjoint F Kc := by
    rw [Set.disjoint_left]
    rintro _ ⟨x, ⟨hxE, hxs⟩, rfl⟩ ⟨x', ⟨hx'S, hx's⟩, hxx'⟩
    have : x' = x := κ.injOn hx's hxs hxx'
    subst this
    exact hEfr x' hxE hx'S
  have hFF' : Disjoint F F' := by
    rw [Set.disjoint_left]
    rintro _ ⟨x, ⟨hxE, hxs⟩, rfl⟩ ⟨x', ⟨hx'c, hx's⟩, hxx'⟩
    have : x' = x := κ.injOn hx's hxs hxx'
    subst this
    exact hx'c (subset_closure hxE)
  have htgt : ∀ z ∈ κ.target, z ∉ Kc → z ∈ F ∪ F' := by
    intro z hz hzK
    have hs : κ.symm z ∈ κ.source := κ.map_target hz
    have hz' : κ (κ.symm z) = z := κ.right_inv hz
    by_cases hE : κ.symm z ∈ E
    · exact Or.inl ⟨_, ⟨hE, hs⟩, hz'⟩
    · right
      refine ⟨_, ⟨?_, hs⟩, hz'⟩
      intro hcl
      have hfz : κ.symm z ∈ frontier E := ⟨hcl, by rwa [hEo.interior_eq]⟩
      rw [hfr] at hfz
      exact hzK ⟨_, ⟨hfz, hs⟩, hz'⟩
  have hKcU : Kc ⊆ U := Set.image_mono (Set.inter_subset_inter_left _ hSΩ)
  have hKeq : Kc ∩ C = C ∩ κ.symm ⁻¹' Sig := by
    ext z
    constructor
    · rintro ⟨⟨x, ⟨hxS, hxs⟩, rfl⟩, hzC⟩
      refine ⟨hzC, ?_⟩
      show κ.symm (κ x) ∈ Sig
      rw [κ.left_inv hxs]
      exact hxS
    · rintro ⟨hzC, hzS⟩
      exact ⟨⟨κ.symm z, ⟨hzS, κ.map_target (hCt hzC)⟩, κ.right_inv (hCt hzC)⟩, hzC⟩
  have hKcpt : IsCompact (Kc ∩ C) := by
    rw [hKeq]
    exact hC.of_isClosed_subset ((κ.continuousOn_symm.mono hCt).preimage_isClosed_of_isClosed
      hC.isClosed hSc.isClosed) Set.inter_subset_left
  
  choose A V R D hR hD hV hV0 hLip hVin hCyl hIff using fun y : ↥(Kc ∩ C) =>
    chart_graph_patch g Sig hSm q y y.2.1 (U ∩ Metric.ball (y : E3) η' ∩ κ.target)
      ((hUo.inter Metric.isOpen_ball).inter κ.open_target)
      ⟨⟨hKcU y.2.1, Metric.mem_ball_self hη'⟩, hCt y.2.2⟩ Set.inter_subset_right
  have hCyl' : ∀ y : ↥(Kc ∩ C), {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
      |z (A y) - (y : E3) (A y)| < D y} ⊆ U ∩ Metric.cthickening η' C := by
    intro y z hz
    obtain ⟨⟨hzU, hzb⟩, -⟩ := hCyl y hz
    exact ⟨hzU, Metric.thickening_subset_cthickening _ _
      (Metric.ball_subset_thickening y.2.2 _ hzb)⟩
  have hside : ∀ (y : ↥(Kc ∩ C)) (S : Set E3), IsPreconnected S →
      S ⊆ {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
        |z (A y) - (y : E3) (A y)| < D y} →
      (∀ z ∈ S, z ∉ Kc) → S ⊆ F ∨ Disjoint S F := by
    intro y S hS hSC hSK
    rcases hS.subset_or_subset hFo hF'o hFF'
      (fun z hz => htgt z (hCyl y (hSC hz)).2 (hSK z hz)) with h | h
    · exact Or.inl h
    · exact Or.inr (Disjoint.mono_left h hFF'.symm)
  have hup : ∀ y : ↥(Kc ∩ C),
      {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧ |z (A y) - (y : E3) (A y)| < D y ∧
        V y (smthHoriz (A y) z) < z (A y)} ⊆ F ∨
      Disjoint {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
        |z (A y) - (y : E3) (A y)| < D y ∧ V y (smthHoriz (A y) z) < z (A y)} F := by
    intro y
    refine hside y _ (cyl_sides_preconnected (A y) y (R y) (D y) (V y) (hV y) (hVin y)).1
      (fun z hz => ⟨hz.1, hz.2.1⟩) (fun z hz hzK => ?_)
    have h1 := (hIff y z hz.1 hz.2.1).1 hzK
    linarith [hz.2.2]
  have hlo : ∀ y : ↥(Kc ∩ C),
      {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧ |z (A y) - (y : E3) (A y)| < D y ∧
        z (A y) < V y (smthHoriz (A y) z)} ⊆ F ∨
      Disjoint {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
        |z (A y) - (y : E3) (A y)| < D y ∧ z (A y) < V y (smthHoriz (A y) z)} F := by
    intro y
    refine hside y _ (cyl_sides_preconnected (A y) y (R y) (D y) (V y) (hV y) (hVin y)).2
      (fun z hz => ⟨hz.1, hz.2.1⟩) (fun z hz hzK => ?_)
    have h1 := (hIff y z hz.1 hz.2.1).1 hzK
    linarith [hz.2.2]
  have hone : ∀ y : ↥(Kc ∩ C),
      {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧ |z (A y) - (y : E3) (A y)| < D y ∧
        V y (smthHoriz (A y) z) < z (A y)} ⊆ F ∨
      {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧ |z (A y) - (y : E3) (A y)| < D y ∧
        z (A y) < V y (smthHoriz (A y) z)} ⊆ F := by
    intro y
    obtain ⟨x0, ⟨hx0S, hx0s⟩, hx0⟩ := y.2.1
    have hO : IsOpen (κ.source ∩ κ ⁻¹' {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
        |z (A y) - (y : E3) (A y)| < D y}) :=
      κ.continuousOn.isOpen_inter_preimage κ.open_source (cylOpen _ _ _ _)
    have hx0O : x0 ∈ κ.source ∩ κ ⁻¹' {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
        |z (A y) - (y : E3) (A y)| < D y} := by
      refine ⟨hx0s, ?_⟩
      rw [Set.mem_preimage, hx0]
      exact selfCyl _ _ _ _ (hR y) (hD y)
    have hx0cl : x0 ∈ closure E := by
      rw [← hfr] at hx0S
      exact frontier_subset_closure hx0S
    obtain ⟨x, hxO, hxE⟩ := mem_closure_iff.1 hx0cl _ hO hx0O
    have hwF : κ x ∈ F := ⟨x, ⟨hxE, hxO.1⟩, rfl⟩
    have hwC := hxO.2
    have hwK : κ x ∉ Kc := fun h => Set.disjoint_left.1 hFK hwF h
    have hne : (κ x) (A y) ≠ V y (smthHoriz (A y) (κ x)) :=
      fun h => hwK ((hIff y _ hwC.1 hwC.2).2 h)
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · right
      rcases hlo y with h | h
      · exact h
      · exact absurd hwF (Set.disjoint_left.1 h ⟨hwC.1, hwC.2, hlt⟩)
    · left
      rcases hup y with h | h
      · exact h
      · exact absurd hwF (Set.disjoint_left.1 h ⟨hwC.1, hwC.2, hgt⟩)
  
  obtain ⟨t, ht⟩ := hKcpt.elim_finite_subcover
    (fun y : ↥(Kc ∩ C) => {z : E3 | smthHoriz (A y) z ∈ smthDisc (A y) y (R y) ∧
      |z (A y) - (y : E3) (A y)| < D y})
    (fun y => cylOpen _ _ _ _)
    (fun z hz => Set.mem_iUnion.2 ⟨⟨z, hz⟩, selfCyl _ _ _ _ (hR _) (hD _)⟩)
  have hcov : Kc ∩ C ⊆ ⋃ i : ↥t,
      (fun x => smthLift (A i.1) x (V i.1 x)) '' smthDisc (A i.1) (i.1 : E3) (R i.1) := by
    intro z hz
    have hz' := ht hz
    rw [Set.mem_iUnion₂] at hz'
    obtain ⟨y, hyt, hzy⟩ := hz'
    refine Set.mem_iUnion.2 ⟨⟨y, hyt⟩, smthHoriz (A y) z, hzy.1, ?_⟩
    have h1 : z (A y) = V y (smthHoriz (A y) z) := (hIff y z hzy.1 hzy.2).1 hz.1
    show smthLift (A y) (smthHoriz (A y) z) (V y (smthHoriz (A y) z)) = z
    rw [← h1]
    exact liftSelf _ _
  have hDmeas : ∀ i : ↥t, MeasurableSet (smthDisc (A i.1) (i.1 : E3) (R i.1)) :=
    fun i => (discOpen _ _ _).measurableSet
  have hDfin : ∀ i : ↥t, MeasureTheory.volume (smthDisc (A i.1) (i.1 : E3) (R i.1)) ≠ ⊤ :=
    fun i => ne_top_of_le_ne_top
      (MeasureTheory.measure_closedBall_lt_top (x := smthHoriz (A i.1) (i.1 : E3))
        (r := R i.1)).ne
      (MeasureTheory.measure_mono (discBall _ _ _ (hR i.1)))
  have hH : ∀ i : ↥t, ∀ S ⊆ smthDisc (A i.1) (i.1 : E3) (R i.1),
      MeasureTheory.Measure.hausdorffMeasure 2 ((fun x => smthLift (A i.1) x (V i.1 x)) '' S) ≤
        18 * MeasureTheory.volume S :=
    fun i S hS => graph_hausdorff_le (A i.1) (V i.1) S
      (fun x hx w hw => hLip i.1 x (hS hx) w (hS hw))
  have hcoef : ENNReal.ofReal (18 * Real.sqrt Γ' / m') * ENNReal.ofReal (m' / Real.sqrt Γ') = 18 := by
    have hs : 0 < Real.sqrt Γ' := Real.sqrt_pos.2 hΓ'
    rw [← ENNReal.ofReal_mul (by positivity)]
    have h18 : 18 * Real.sqrt Γ' / m' * (m' / Real.sqrt Γ') = 18 := by
      field_simp
    rw [h18]
    norm_num
  
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  obtain ⟨Q, hQ, hQd, hHK⟩ := disjoint_graph_selection (Kc ∩ C) hKcpt (fun i : ↥t => A i.1)
    (fun i => V i.1) (fun i => smthDisc (A i.1) (i.1 : E3) (R i.1)) hDmeas hDfin
    (fun i => hV i.1) hH hcov (ε : ENNReal) (ENNReal.coe_ne_zero.2 hε.ne')
  have hPO : ∀ i : ↥t, (fun x => smthLift (A i.1) x (V i.1 x)) '' Q i ⊆
      {z : E3 | smthHoriz (A i.1) z ∈ smthDisc (A i.1) (i.1 : E3) (R i.1) ∧
        |z (A i.1) - (i.1 : E3) (A i.1)| < D i.1} := by
    rintro i _ ⟨x, hx, rfl⟩
    have hxD := (hQ i).2.1 hx
    refine ⟨?_, ?_⟩
    · show smthHoriz (A i.1) (smthLift (A i.1) x (V i.1 x)) ∈ _
      rw [liftH]
      exact hxD
    · show |(smthLift (A i.1) x (V i.1 x)) (A i.1) - _| < _
      rw [liftA]
      exact hVin i.1 x hxD
  obtain ⟨χ, hχ, hχd⟩ := disjoint_bumps (fun i : ↥t => (fun x => smthLift (A i.1) x (V i.1 x)) '' Q i)
    (fun i => {z : E3 | smthHoriz (A i.1) z ∈ smthDisc (A i.1) (i.1 : E3) (R i.1) ∧
        |z (A i.1) - (i.1 : E3) (A i.1)| < D i.1})
    (fun i => (hQ i).1.image (gamC _ _ (hV i.1))) (fun i => cylOpen _ _ _ _) hPO hQd
  have hflux := patch_field_flux (g.coeff κ.symm) κ.target κ.open_target
    (fun i j => g.smooth q i j) (fun y hy => (coeff_chart_symm_posDef g q y hy).det_pos)
    (Metric.cthickening η' C) hNt' Γ' m' hΓ' hm' hGa' hGm' U F Kc hUo hFo hFK
    (fun i : ↥t => A i.1) (fun i => (i.1 : E3)) (fun i => R i.1) (fun i => D i.1)
    (fun i => V i.1) Q χ (fun i => hV i.1) (fun i => hVin i.1) (fun i => hCyl' i.1)
    (fun i => hIff i.1) (fun i => hup i.1) (fun i => hlo i.1) (fun i => hone i.1)
    (fun i => ⟨(hQ i).1, (hQ i).2.1⟩)
    (fun i => ⟨(hχ i).1, (hχ i).2.1, fun x hx => (hχ i).2.2.1 _ ⟨x, hx, rfl⟩,
      (hχ i).2.2.2.1, (hχ i).2.2.2.2⟩) hχd
    (fun b w h hw hh hhc => graph_side_integral b w hw h hh hhc)
  calc MeasureTheory.Measure.hausdorffMeasure 2 (Kc ∩ C)
      ≤ 18 * ∑ i, MeasureTheory.volume (Q i) + (ε : ENNReal) := hHK
    _ = ENNReal.ofReal (18 * Real.sqrt Γ' / m') *
          (ENNReal.ofReal (m' / Real.sqrt Γ') * ∑ i, MeasureTheory.volume (Q i)) + (ε : ENNReal) := by
        rw [← mul_assoc, hcoef]
    _ ≤ ENNReal.ofReal (18 * Real.sqrt Γ' / m') * hullRiemPer g E Ω Sig + (ε : ENNReal) := by
        gcongr
        exact hflux.trans hP

theorem finite_hull_stable_area [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds) (r₀ : ℝ)
    (hr₀ : 2 ≤ r₀)
    (havoid : ∀ S : Set M, IsCompact S → IsMinimalSurfaceSet g S →
      ∀ (l : Fin hAF.numEnds) (y : E3), r₀ < ‖y‖ → (hAF.ends l).Φ y ∉ S)
    (R : ℝ) (hR : r₀ + 1 < R)
    (hbar : ∀ (l : Fin hAF.numEnds) (y : E3), R ≤ ‖y‖ →
      0 < levelMeanCurvCoord (g.coeff (hAF.ends l).Φ) (fun z => ‖z‖) y)
    (S : ℕ → Set M) (hS : ∀ n, IsCompact (S n) ∧ IsMinimalSurfaceSet g (S n)) :
    ∃ A : M → Set E3 → ℝ, ∀ m : ℕ, ∃ Sig : Set M, IsCompact Sig ∧ IsMinimalSurfaceSet g Sig ∧
      IsStableMinimalSet g Sig ∧
      frontier (connectedComponentIn ((⋃ n ∈ Finset.range m, S n) ∪ Sig)ᶜ
        ((hAF.ends k).Φ ((r₀ + 1) • e 0))) ⊆ Sig ∧
      CoordAreaBound Sig A :=
by
  haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
  
  obtain ⟨ρ, a, c, ha, hρ, hρend, hρcore, hcpt⟩ := radial_exhaustion_exists g hAF
  have hρc : Continuous ρ := hρ.continuous
  obtain ⟨r₁, hr₁a, hr₁c, hr₁R, hr₁r₀⟩ : ∃ r₁ : ℝ, a < r₁ ∧ c < r₁ ∧ R < r₁ ∧ r₀ < r₁ :=
    ⟨max (max a c) (max R r₀) + 1,
      by linarith [le_max_left a c, le_max_left (max a c) (max R r₀)],
      by linarith [le_max_right a c, le_max_left (max a c) (max R r₀)],
      by linarith [le_max_left R r₀, le_max_right (max a c) (max R r₀)],
      by linarith [le_max_right R r₀, le_max_right (max a c) (max R r₀)]⟩
  
  have hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p := by
    intro p hp
    have hex : ∃ (l : Fin hAF.numEnds) (y : E3), a < ‖y‖ ∧ (hAF.ends l).Φ y = p := by
      by_contra hno
      push_neg at hno
      have := hρcore p hno
      linarith
    obtain ⟨l, y, hy, rfl⟩ := hex
    have hρy := hρend l y hy
    have hyR : R ≤ ‖y‖ := by rw [hρy] at hp; linarith
    have hsrc : y ∈ (hAF.ends l).Φ.source := by
      rw [(hAF.ends l).source_eq]
      show (1 : ℝ) < ‖y‖
      linarith
    have hfh : ∀ᶠ z in 𝓝 y, ρ ((hAF.ends l).Φ z) = ‖z‖ := by
      filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds hy] with z hz
      exact hρend l z hz
    rw [levelMeanCurv_eq_coord g (hAF.ends l).Φ ρ (fun z => ‖z‖) hρ y hsrc hfh]
    exact hbar l y hyR
  
  have hA₀o : IsOpen {p : M | r₁ < ρ p} := isOpen_lt continuous_const hρc
  have hΩo : IsOpen {p : M | ρ p < r₁ + 2} := isOpen_lt hρc continuous_const
  have hBo : IsOpen ({p : M | r₁ < ρ p} \ {p : M | r₁ < ρ p}) := by
    rw [Set.diff_self]; exact isOpen_empty
  
  have hP₀ : sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2} < ⊤ :=
    sepRiemPer_far_lt_top g ρ r₁ (r₁ + 2) {p : M | r₁ < ρ p} hρ hcpt hmc (fun p hp => hp)
      hA₀o hBo
  
  obtain ⟨cA, hcA0, hcA⟩ := coordArea_le_cutPerimeter g
  refine ⟨fun q C => cA q C *
    (sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2}).toReal, ?_⟩
  intro m
  
  have hKc : IsCompact (⋃ n ∈ Finset.range m, S n) :=
    (Finset.range m).isCompact_biUnion (fun n _ => (hS n).1)
  have hKcl : IsClosed (⋃ n ∈ Finset.range m, S n) := hKc.isClosed
  have hKρ : ∀ p ∈ (⋃ n ∈ Finset.range m, S n), ρ p < r₁ := by
    intro p hp
    obtain ⟨n, -, hpn⟩ := Set.mem_iUnion₂.1 hp
    by_cases hex : ∃ (l : Fin hAF.numEnds) (y : E3), a < ‖y‖ ∧ (hAF.ends l).Φ y = p
    · obtain ⟨l, y, hy, rfl⟩ := hex
      have hyr₀ : ‖y‖ ≤ r₀ := by
        by_contra hlt
        exact havoid (S n) (hS n).1 (hS n).2 l y (lt_of_not_ge hlt) hpn
      rw [hρend l y hy]
      linarith
    · push_neg at hex
      have := hρcore p hex
      linarith
  have hKKin : (⋃ n ∈ Finset.range m, S n) ⊆ {p : M | ρ p ≤ r₁} :=
    fun p hp => (hKρ p hp).le
  
  have hdisj : Disjoint (closure {p : M | r₁ < ρ p}) (⋃ n ∈ Finset.range m, S n) := by
    rw [Set.disjoint_left]
    intro p hp hpK
    have h1 : r₁ ≤ ρ p := closure_lt_subset_le continuous_const hρc hp
    have h2 := hKρ p hpK
    linarith
  have hfin₀ : hullRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2}
      (⋃ n ∈ Finset.range m, S n) ≤ sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2} :=
    hullRiemPer_le_sepRiemPer g _ _ _ hKcl hdisj
  
  have hA₀meas : sepChartMeas {p : M | r₁ < ρ p} := by
    intro q
    exact ((chartAt E3 q).isOpen_image_of_subset_source
      (hA₀o.inter (chartAt E3 q).open_source) Set.inter_subset_right).measurableSet
  have hKvΩ : {p : M | ρ p ≤ r₁ + 1} ⊆ {p : M | ρ p < r₁ + 2} := by
    intro p hp
    have h : ρ p ≤ r₁ + 1 := hp
    show ρ p < r₁ + 2
    linarith
  obtain ⟨F, hFm, hFA, hFmin⟩ := hullRiemPer_minimizer_exists g (⋃ n ∈ Finset.range m, S n)
    {p : M | ρ p < r₁ + 2} {p : M | r₁ < ρ p} {p : M | ρ p ≤ r₁ + 1} (hcpt (r₁ + 1)) hΩo hKvΩ
    hA₀meas (lt_of_le_of_lt hfin₀ hP₀)
  
  have hFfin : hullRiemPer g F {p : M | ρ p < r₁ + 2} (⋃ n ∈ Finset.range m, S n) ≤
      sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2} := by
    refine le_trans (hFmin _ hA₀meas ?_) hfin₀
    rw [symmDiff_self]
    exact bot_le
  have hFlt := lt_of_le_of_lt hFfin hP₀
  
  have hbarF := hullMinimizer_eq_far_ae g ρ r₁ (r₁ + 1) (r₁ + 2) {p : M | r₁ < ρ p} F
    (⋃ n ∈ Finset.range m, S n) hρ hcpt hmc (fun p hp => hp) hA₀o hBo hKcl hKρ
    (by linarith) (by linarith) hFm hFA hFlt hFmin
  have hcoll : sepChartNull (symmDiff F {p : M | r₁ < ρ p} \ {p : M | ρ p ≤ r₁}) := by
    intro q
    refine MeasureTheory.measure_mono_null (Set.image_subset _ ?_) (hbarF q)
    rintro x ⟨⟨hx1, hx2⟩, hx3⟩
    exact ⟨⟨hx1, show r₁ < ρ x from lt_of_not_ge hx2⟩, hx3⟩
  
  have hKinc : IsClosed {p : M | ρ p ≤ r₁} := isClosed_le hρc continuous_const
  have hKinKv : {p : M | ρ p ≤ r₁} ⊆ interior {p : M | ρ p ≤ r₁ + 1} := by
    intro p hp
    have h : ρ p ≤ r₁ := hp
    refine interior_maximal (t := {p : M | ρ p < r₁ + 1}) (fun q hq => ?_)
      (isOpen_lt hρc continuous_const) (show ρ p < r₁ + 1 by linarith)
    have hq' : ρ q < r₁ + 1 := hq
    show ρ q ≤ r₁ + 1
    linarith
  have hA₀fr : frontier {p : M | r₁ < ρ p} ⊆ {p : M | ρ p ≤ r₁} := by
    intro p hp
    have h := frontier_lt_subset_eq continuous_const hρc hp
    have h' : r₁ = ρ p := h
    show ρ p ≤ r₁
    linarith
  
  obtain ⟨hEo, hEK, hA₀E, -, hfrKin⟩ := hull_normalization (⋃ n ∈ Finset.range m, S n)
    {p : M | ρ p ≤ r₁} {p : M | r₁ < ρ p} F
    {x | x ∉ (⋃ n ∈ Finset.range m, S n) ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}
    hKcl hKinc hKKin hA₀o hA₀fr hcoll rfl
  set E : Set M := {x | x ∉ (⋃ n ∈ Finset.range m, S n) ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}
    with hEdef
  have hSigc : IsCompact (frontier E) := (hcpt r₁).of_isClosed_subset isClosed_frontier hfrKin
  
  have hfree := hull_free_regular g (⋃ n ∈ Finset.range m, S n) {p : M | ρ p < r₁ + 2}
    {p : M | ρ p ≤ r₁ + 1} {p : M | ρ p ≤ r₁} {p : M | r₁ < ρ p} F E hKcl hΩo (hcpt (r₁ + 1))
    hKvΩ hKinc hKinKv hKKin hA₀o hA₀fr hFm hFA hFlt hFmin hcoll rfl
  have hcont := hull_contact_regular g S hS m (⋃ n ∈ Finset.range m, S n)
    {p : M | ρ p < r₁ + 2} {p : M | ρ p ≤ r₁ + 1} {p : M | ρ p ≤ r₁} {p : M | r₁ < ρ p} F E rfl
    hΩo (hcpt (r₁ + 1)) hKvΩ hKinc hKinKv hKKin hA₀o hA₀fr hFm hFA hFlt hFmin hcoll rfl
  have hSm : IsMinimalSurfaceSet g (frontier E) := by
    refine sepIsMinimalSurfaceSet_of_chart_graphs g _ isClosed_frontier (fun p hp => ?_)
    by_cases hpK : p ∈ ⋃ n ∈ Finset.range m, S n
    · exact (hcont p hp hpK).2
    · exact hfree.2 p hp hpK
  
  obtain ⟨hEper, hEmin⟩ := hull_perimeter_transfer g S hS m (⋃ n ∈ Finset.range m, S n)
    {p : M | ρ p < r₁ + 2} {p : M | ρ p ≤ r₁ + 1} {p : M | ρ p ≤ r₁} {p : M | r₁ < ρ p} F E rfl
    hΩo (hcpt (r₁ + 1)) hKvΩ hKinc hKinKv hKKin hA₀o hA₀fr hFm hFA hFlt hFmin hcoll rfl hSm
    hfree.1 (fun p hp hpK => (hcont p hp hpK).1)
  have hEfin : hullRiemPer g E {p : M | ρ p < r₁ + 2} (frontier E) ≤
      sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2} := hEper.trans hFfin
  
  have hnorm_e : ∀ t : ℝ, 0 < t → ‖t • e 0‖ = t := by
    intro t ht
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_pos ht]
  have hTconn : IsPreconnected ((hAF.ends k).Φ '' {y : E3 | r₀ < ‖y‖}) := by
    have hsub : {y : E3 | r₀ < ‖y‖} ⊆ (hAF.ends k).Φ.source := by
      intro y hy
      rw [(hAF.ends k).source_eq]
      show (1 : ℝ) < ‖y‖
      have : r₀ < ‖y‖ := hy
      linarith
    have hcont' : ContinuousOn ((hAF.ends k).Φ : E3 → M) (hAF.ends k).Φ.source :=
      (hAF.ends k).Φ.contMDiffOn_toFun.continuousOn
    have hA : IsConnected {y : E3 | r₀ < ‖y‖} := by
      have hrank : 1 < Module.rank ℝ E3 := by
        rw [← Module.finrank_eq_rank, finrank_euclideanSpace]
        simp
      have hS2 := isConnected_sphere hrank (0 : E3) (zero_le_one' ℝ)
      have hP := (isConnected_Ioi (a := r₀)).prod hS2
      have himg : (fun q : ℝ × E3 => q.1 • q.2) '' (Set.Ioi r₀ ×ˢ sphere (0 : E3) 1) =
          {y : E3 | r₀ < ‖y‖} := by
        ext y
        constructor
        · rintro ⟨⟨t, θ⟩, ⟨ht, hθ⟩, rfl⟩
          have ht' : r₀ < t := ht
          have hθ' : ‖θ‖ = 1 := mem_sphere_zero_iff_norm.1 hθ
          show r₀ < ‖t • θ‖
          rw [norm_smul, hθ', Real.norm_eq_abs, abs_of_pos (by linarith), mul_one]
          exact ht'
        · intro hy
          have hy' : r₀ < ‖y‖ := hy
          have hpos : 0 < ‖y‖ := by linarith
          refine ⟨(‖y‖, ‖y‖⁻¹ • y), ⟨hy', ?_⟩, ?_⟩
          · rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm,
              inv_mul_cancel₀ hpos.ne']
          · show ‖y‖ • (‖y‖⁻¹ • y) = y
            rw [smul_smul, mul_inv_cancel₀ hpos.ne', one_smul]
      rw [← himg]
      exact hP.image _ (continuous_fst.smul continuous_snd).continuousOn
    exact (hA.image _ (hcont'.mono hsub)).isPreconnected
  have hTE : (hAF.ends k).Φ '' {y : E3 | r₀ < ‖y‖} ⊆ E := by
    refine hTconn.subset_left_of_subset_union hEo isClosed_closure.isOpen_compl
      (Disjoint.mono_left subset_closure disjoint_compl_right) ?_ ?_
    · rintro _ ⟨y, hy, rfl⟩
      by_cases hxE : (hAF.ends k).Φ y ∈ E
      · exact Or.inl hxE
      · right
        intro hxc
        have hxf : (hAF.ends k).Φ y ∈ frontier E := by
          rw [hEo.frontier_eq]
          exact ⟨hxc, hxE⟩
        exact havoid (frontier E) hSigc hSm k y hy hxf
    · have hpos : 0 < r₁ + 1 := by linarith
      have hn := hnorm_e (r₁ + 1) hpos
      have hy₁ : r₀ < ‖(r₁ + 1) • e 0‖ := by rw [hn]; linarith
      have hy₁a : a < ‖(r₁ + 1) • e 0‖ := by rw [hn]; linarith
      refine ⟨(hAF.ends k).Φ ((r₁ + 1) • e 0), ⟨_, hy₁, rfl⟩, hA₀E ⟨?_, ?_⟩⟩
      · show r₁ < ρ ((hAF.ends k).Φ ((r₁ + 1) • e 0))
        rw [hρend k _ hy₁a, hn]
        linarith
      · intro hle
        have hle' : ρ ((hAF.ends k).Φ ((r₁ + 1) • e 0)) ≤ r₁ := hle
        rw [hρend k _ hy₁a, hn] at hle'
        linarith
  have hx₀E : (hAF.ends k).Φ ((r₀ + 1) • e 0) ∈ E := by
    refine hTE ⟨(r₀ + 1) • e 0, ?_, rfl⟩
    show r₀ < ‖(r₀ + 1) • e 0‖
    rw [hnorm_e (r₀ + 1) (by linarith)]
    linarith
  
  have hStab : IsStableMinimalSet g (frontier E) :=
    stable_of_cut_minimizing g (frontier E) E {p : M | ρ p < r₁ + 2} {p : M | ρ p ≤ r₁ + 1}
      hSigc hSm hEo rfl hΩo (hcpt (r₁ + 1)) (hfrKin.trans hKinKv) hKvΩ
      (lt_of_le_of_lt hEfin hP₀) hEmin
  refine ⟨frontier E, hSigc, hSm, hStab, ?_, ?_⟩
  
  · set x₀ := (hAF.ends k).Φ ((r₀ + 1) • e 0) with hx₀def
    set U : Set M := ((⋃ n ∈ Finset.range m, S n) ∪ frontier E)ᶜ with hUdef
    have hUo : IsOpen U := (hKcl.union isClosed_frontier).isOpen_compl
    have hx₀U : x₀ ∈ U := by
      rintro (hK | hf)
      · exact Set.disjoint_left.1 hEK hx₀E hK
      · rw [hEo.frontier_eq] at hf
        exact hf.2 hx₀E
    have hCE : connectedComponentIn U x₀ ⊆ E := by
      refine (isPreconnected_connectedComponentIn).subset_left_of_subset_union hEo
        isClosed_closure.isOpen_compl (Disjoint.mono_left subset_closure disjoint_compl_right)
        ?_ ⟨x₀, mem_connectedComponentIn hx₀U, hx₀E⟩
      intro z hz
      have hzU : z ∈ U := connectedComponentIn_subset _ _ hz
      by_cases hzE : z ∈ E
      · exact Or.inl hzE
      · right
        intro hzc
        have hzf : z ∈ frontier E := by
          rw [hEo.frontier_eq]
          exact ⟨hzc, hzE⟩
        exact hzU (Or.inr hzf)
    have hCo : IsOpen (connectedComponentIn U x₀) := hUo.connectedComponentIn
    intro y hy
    rw [hCo.frontier_eq] at hy
    obtain ⟨hyc, hyC⟩ := hy
    by_cases hyU : y ∈ U
    · exfalso
      have hnb : connectedComponentIn U y ∈ 𝓝 y :=
        hUo.connectedComponentIn.mem_nhds (mem_connectedComponentIn hyU)
      obtain ⟨z, hz1, hz2⟩ := mem_closure_iff_nhds.1 hyc _ hnb
      have e1 : connectedComponentIn U x₀ = connectedComponentIn U z :=
        connectedComponentIn_eq hz2
      have e2 : connectedComponentIn U y = connectedComponentIn U z :=
        connectedComponentIn_eq hz1
      apply hyC
      rw [e1, ← e2]
      exact mem_connectedComponentIn hyU
    · have hy' : y ∈ (⋃ n ∈ Finset.range m, S n) ∪ frontier E := not_not.1 hyU
      rcases hy' with hyK | hyf
      · have hyE : y ∉ E := fun h => Set.disjoint_left.1 hEK h hyK
        rw [hEo.frontier_eq]
        exact ⟨closure_mono hCE hyc, hyE⟩
      · exact hyf
  
  · intro q C hC hCt
    have hSΩ : frontier E ⊆ {p : M | ρ p < r₁ + 2} := by
      intro p hp
      have h : ρ p ≤ r₁ := hfrKin hp
      show ρ p < r₁ + 2
      linarith
    calc MeasureTheory.Measure.hausdorffMeasure 2
          ((chartAt E3 q) '' (frontier E ∩ (chartAt E3 q).source) ∩ C)
        ≤ ENNReal.ofReal (cA q C) * hullRiemPer g E {p : M | ρ p < r₁ + 2} (frontier E) :=
          hcA (frontier E) E {p : M | ρ p < r₁ + 2} hSigc hSm hEo rfl hΩo hSΩ q C hC hCt
      _ ≤ ENNReal.ofReal (cA q C) *
            sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2} := by
          gcongr
      _ = ENNReal.ofReal (cA q C) * ENNReal.ofReal
            (sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2}).toReal := by
          rw [ENNReal.ofReal_toReal hP₀.ne]
      _ = ENNReal.ofReal (cA q C *
            (sepRiemPer g {p : M | r₁ < ρ p} {p : M | ρ p < r₁ + 2}).toReal) :=
          (ENNReal.ofReal_mul (hcA0 q C)).symm

theorem secondFundSq_congr_tensor (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F₁ F₂ : E3 → ℝ)
    (y₁ y₂ : E3) (J : Matrix (Fin 3) (Fin 3) ℝ) (hJ : J.det ≠ 0) (hG₁ : (G₁ y₁).det ≠ 0)
    (hG : ∀ i j : Fin 3, G₂ y₂ i j = ∑ a : Fin 3, ∑ b : Fin 3, J a i * G₁ y₁ a b * J b j)
    (hξ : ∀ i : Fin 3, partialDeriv i F₂ y₂ = ∑ a : Fin 3, J a i * partialDeriv a F₁ y₁)
    (hH : ∀ i j : Fin 3, hessLoc G₂ F₂ i j y₂ =
      ∑ a : Fin 3, ∑ b : Fin 3, J a i * J b j * hessLoc G₁ F₁ a b y₁) :
    secondFundSq G₂ F₂ y₂ = secondFundSq G₁ F₁ y₁ :=
by
  have hJK : J * J⁻¹ = 1 := Matrix.mul_nonsing_inv J (isUnit_iff_ne_zero.mpr hJ)
  
  have tf : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (y : E3)
      (N H : Matrix (Fin 3) (Fin 3) ℝ) (ξ : Fin 3 → ℝ), (G y)⁻¹ = N →
      (∀ a : Fin 3, partialDeriv a f y = ξ a) → (∀ j k : Fin 3, hessLoc G f j k y = H j k) →
      secondFundSq G f y = Matrix.trace (Matrix.of (fun i j : Fin 3 => N i j -
          (∑ a : Fin 3, N i a * ξ a) * (∑ b : Fin 3, N j b * ξ b) /
            (∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b)) * H *
        Matrix.of (fun i j : Fin 3 => N i j -
          (∑ a : Fin 3, N i a * ξ a) * (∑ b : Fin 3, N j b * ξ b) /
            (∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b)) * H) /
        (∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b) := by
    intro G f y N H ξ hN hξ' hH'
    have gen : ∀ P Q : Matrix (Fin 3) (Fin 3) ℝ,
        ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3, P i j * Q j k * P k l * Q l i =
          Matrix.trace (P * Q * P * Q) := by
      intro P Q
      simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Fin.sum_univ_three]
      ring
    unfold secondFundSq
    simp only [hN, hξ', hH']
    rw [← gen]
    simp only [Matrix.of_apply]
  
  have cp : ∀ (N K L : Matrix (Fin 3) (Fin 3) ℝ) (ξ : Fin 3 → ℝ), L * K = 1 →
      (∑ a : Fin 3, ∑ b : Fin 3, (K * N * K.transpose) a b * (L.transpose.mulVec ξ) a *
          (L.transpose.mulVec ξ) b = ∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b) ∧
      Matrix.of (fun i j : Fin 3 => (K * N * K.transpose) i j -
          (∑ a : Fin 3, (K * N * K.transpose) i a * (L.transpose.mulVec ξ) a) *
          (∑ b : Fin 3, (K * N * K.transpose) j b * (L.transpose.mulVec ξ) b) /
          (∑ a : Fin 3, ∑ b : Fin 3, (K * N * K.transpose) a b * (L.transpose.mulVec ξ) a *
            (L.transpose.mulVec ξ) b)) =
        K * Matrix.of (fun i j : Fin 3 => N i j -
          (∑ a : Fin 3, N i a * ξ a) * (∑ b : Fin 3, N j b * ξ b) /
            (∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b)) * K.transpose := by
    intro N K L ξ hLK
    have hKL : K.transpose * L.transpose = 1 := by
      rw [← Matrix.transpose_mul, hLK, Matrix.transpose_one]
    have hw : (K * N * K.transpose).mulVec (L.transpose.mulVec ξ) = K.mulVec (N.mulVec ξ) := by
      rw [Matrix.mulVec_mulVec, Matrix.mul_assoc (K * N), hKL, Matrix.mul_one,
        ← Matrix.mulVec_mulVec]
    have hquad : ∀ (M : Matrix (Fin 3) (Fin 3) ℝ) (v : Fin 3 → ℝ),
        ∑ a : Fin 3, ∑ b : Fin 3, M a b * v a * v b = dotProduct v (M.mulVec v) := by
      intro M v
      simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      ring
    have hS : ∑ a : Fin 3, ∑ b : Fin 3, (K * N * K.transpose) a b * (L.transpose.mulVec ξ) a *
          (L.transpose.mulVec ξ) b = ∑ a : Fin 3, ∑ b : Fin 3, N a b * ξ a * ξ b := by
      rw [hquad, hquad, hw, Matrix.mulVec_transpose, ← Matrix.dotProduct_mulVec,
        Matrix.mulVec_mulVec, hLK, Matrix.one_mulVec]
    have hrow : ∀ i : Fin 3, ∑ a : Fin 3, (K * N * K.transpose) i a * (L.transpose.mulVec ξ) a =
        (K.mulVec (N.mulVec ξ)) i := by
      intro i
      rw [← hw]
      rfl
    refine ⟨hS, ?_⟩
    rw [hS]
    simp only [hrow]
    ext i j
    simp only [Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.mulVec,
      dotProduct, Fin.sum_univ_three]
    ring
  
  have tc : ∀ (P Q K L : Matrix (Fin 3) (Fin 3) ℝ), L * K = 1 →
      Matrix.trace (K * P * K.transpose * (L.transpose * Q * L) * (K * P * K.transpose) *
        (L.transpose * Q * L)) = Matrix.trace (P * Q * P * Q) := by
    intro P Q K L hLK
    have hKL : K.transpose * L.transpose = 1 := by
      rw [← Matrix.transpose_mul, hLK, Matrix.transpose_one]
    have h1 : ∀ X : Matrix (Fin 3) (Fin 3) ℝ, K.transpose * (L.transpose * X) = X :=
      fun X => by rw [← Matrix.mul_assoc, hKL, Matrix.one_mul]
    have h2 : ∀ X : Matrix (Fin 3) (Fin 3) ℝ, L * (K * X) = X :=
      fun X => by rw [← Matrix.mul_assoc, hLK, Matrix.one_mul]
    simp only [Matrix.mul_assoc, h1, h2]
    rw [Matrix.trace_mul_comm K]
    simp only [Matrix.mul_assoc, hLK, Matrix.mul_one]
  
  have hB : G₂ y₂ = J.transpose * G₁ y₁ * J := by
    ext i j
    rw [hG i j]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_three]
    ring
  have hBinv : (G₂ y₂)⁻¹ = J⁻¹ * (G₁ y₁)⁻¹ * (J⁻¹).transpose := by
    rw [hB, Matrix.mul_inv_rev, Matrix.mul_inv_rev, ← Matrix.transpose_nonsing_inv,
      Matrix.mul_assoc]
  have hξ' : ∀ a : Fin 3, partialDeriv a F₂ y₂ =
      (J.transpose.mulVec (fun c => partialDeriv c F₁ y₁)) a := by
    intro a
    rw [hξ a]
    simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  have hH' : ∀ j k : Fin 3, hessLoc G₂ F₂ j k y₂ =
      (J.transpose * (Matrix.of fun a b => hessLoc G₁ F₁ a b y₁) * J) j k := by
    intro j k
    rw [hH j k]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_three]
    ring
  rw [tf G₂ F₂ y₂ (J⁻¹ * (G₁ y₁)⁻¹ * (J⁻¹).transpose)
      (J.transpose * (Matrix.of fun a b => hessLoc G₁ F₁ a b y₁) * J)
      (J.transpose.mulVec (fun c => partialDeriv c F₁ y₁)) hBinv hξ' hH',
    tf G₁ F₁ y₁ (G₁ y₁)⁻¹ (Matrix.of fun a b => hessLoc G₁ F₁ a b y₁)
      (fun c => partialDeriv c F₁ y₁) rfl (fun a => rfl) (fun j k => rfl)]
  obtain ⟨hS, hP⟩ := cp (G₁ y₁)⁻¹ J⁻¹ J (fun c => partialDeriv c F₁ y₁) hJK
  rw [hP, hS, tc _ _ J⁻¹ J hJK]

theorem secondFundSq_nonneg_of_posDef (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E3 → ℝ) (y : E3)
    (hPD : (G y).PosDef) (hH : ∀ i j : Fin 3, hessLoc G F i j y = hessLoc G F j i y) :
    0 ≤ secondFundSq G F y :=
by
  
  have s2 : ∀ A : Matrix (Fin 3) (Fin 3) ℝ, A.PosSemidef → ∀ ξ : Fin 3 → ℝ,
      (Matrix.of fun i j : Fin 3 => A i j - (∑ a : Fin 3, A i a * ξ a) *
        (∑ b : Fin 3, A j b * ξ b) / (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b)).PosSemidef := by
    intro A hA ξ
    have hsym : ∀ i j : Fin 3, A i j = A j i := by
      intro i j
      have h := hA.isHermitian.apply i j
      simpa using h.symm
    obtain ⟨w, hw⟩ : ∃ w : Fin 3 → ℝ, ∀ i, ∑ a : Fin 3, A i a * ξ a = w i := ⟨_, fun i => rfl⟩
    obtain ⟨S, hS⟩ : ∃ S : ℝ, ∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b = S := ⟨_, rfl⟩
    simp only [hw, hS]
    by_cases hS0 : S = 0
    · have : (Matrix.of fun i j : Fin 3 => A i j - w i * w j / S) = A := by
        ext i j
        simp [hS0]
      rw [this]
      exact hA
    · have hC : ∀ j, ∑ k : Fin 3, ξ k * A k j = w j := by
        intro j
        rw [← hw j, Fin.sum_univ_three, Fin.sum_univ_three, hsym 0 j, hsym 1 j, hsym 2 j]
        ring
      have hQ : ∑ k : Fin 3, ∑ l : Fin 3, ξ k * A k l * ξ l = S := by
        rw [← hS]
        simp only [Fin.sum_univ_three]
        ring
      set Q : Matrix (Fin 3) (Fin 3) ℝ :=
        Matrix.of fun k i : Fin 3 => (if k = i then S else 0) - ξ k * w i with hQdef
      have hexp : ∀ i j : Fin 3, (Q.conjTranspose * A * Q) i j =
          S ^ 2 * A i j - S * w i * (∑ k : Fin 3, ξ k * A k j)
            - S * w j * (∑ l : Fin 3, A i l * ξ l)
            + w i * w j * (∑ k : Fin 3, ∑ l : Fin 3, ξ k * A k l * ξ l) := by
        intro i j
        simp only [hQdef, Matrix.mul_apply, Matrix.conjTranspose_apply, star_trivial,
          Matrix.of_apply, Fin.sum_univ_three]
        fin_cases i <;> fin_cases j <;> simp <;> ring
      have heq : (Matrix.of fun i j : Fin 3 => A i j - w i * w j / S) =
          (S ^ 2)⁻¹ • (Q.conjTranspose * A * Q) := by
        ext i j
        rw [Matrix.smul_apply, hexp i j, hC j, hw i, hQ, Matrix.of_apply, smul_eq_mul]
        field_simp
        ring
      rw [heq]
      exact (hA.conjTranspose_mul_mul_same Q).smul (by positivity)
  
  have s3 : ∀ P H : Matrix (Fin 3) (Fin 3) ℝ, P.PosSemidef → (∀ i j : Fin 3, H i j = H j i) →
      0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3, P i j * H j k * P k l * H l i := by
    intro P H hP hHs
    have htr : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3, P i j * H j k * P k l * H l i
        = (P * H * P * H).trace := by
      simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Fin.sum_univ_three]
      ring
    rw [htr]
    have hHc : H.conjTranspose = H := by
      ext i j
      simp [Matrix.conjTranspose_apply, hHs j i]
    obtain ⟨B, rfl⟩ := Matrix.posSemidef_iff_eq_conjTranspose_mul_self.mp hP
    have hL : (B * H * B.conjTranspose).conjTranspose = B * H * B.conjTranspose := by
      rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
        hHc]
      simp only [Matrix.mul_assoc]
    have hcyc : (B.conjTranspose * B * H * (B.conjTranspose * B) * H).trace =
        ((B * H * B.conjTranspose).conjTranspose * (B * H * B.conjTranspose)).trace := by
      rw [hL]
      rw [show B.conjTranspose * B * H * (B.conjTranspose * B) * H =
          B.conjTranspose * (B * H * B.conjTranspose * B * H) by
        simp only [Matrix.mul_assoc]]
      rw [Matrix.trace_mul_comm]
      simp only [Matrix.mul_assoc]
    rw [hcyc]
    exact (Matrix.posSemidef_conjTranspose_mul_self _).trace_nonneg
  
  have hApsd : ((G y)⁻¹).PosSemidef := (Matrix.PosDef.inv hPD).posSemidef
  have hS : 0 ≤ ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a F y * partialDeriv b F y := by
    have h := hApsd.dotProduct_mulVec_nonneg (fun a => partialDeriv a F y)
    calc (0 : ℝ) ≤ _ := h
      _ = _ := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
        ring
  
  unfold secondFundSq
  exact div_nonneg (s3 _ (Matrix.of fun j k => hessLoc G F j k y)
    (s2 _ hApsd (fun a => partialDeriv a F y)) hH) hS

theorem surfA2_chart_invariant [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (S : Set M) (hS : IsMinimalSurfaceSet g S) (z p : M) (hp : p ∈ S) (hpz : p ∈ (chartAt E3 z).source) : ∃ t : ℝ, 0 ≤ t ∧ IsSurfA2At g S (chartAt E3 z) p t ∧ IsSurfA2At g S (chartAt E3 p) p t :=
by
  classical
  
  have hu : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hξne : ∀ (F : E3 → ℝ) (y : E3), fderiv ℝ F y ≠ 0 →
      (fun k : Fin 3 => partialDeriv k F y) ≠ 0 := by
    intro F y hdF h
    apply hdF
    refine ContinuousLinearMap.ext fun v => ?_
    rw [ContinuousLinearMap.zero_apply, hu v, map_sum]
    refine Finset.sum_eq_zero fun d _ => ?_
    rw [map_smul, smul_eq_mul]
    have hd : partialDeriv d F y = 0 := congrFun h d
    rw [show fderiv ℝ F y (e d) = partialDeriv d F y from rfl, hd, mul_zero]
  have hpd : ∀ (i : Fin 3) (h : E3 → ℝ),
      partialDeriv i (fun z => -h z) = fun z => -partialDeriv i h z := by
    intro i h
    funext w
    simp only [partialDeriv]
    rw [show (fun z => -h z) = -h from rfl, fderiv_neg]
    rfl
  
  have hschwarz : ∀ (F : E3 → ℝ) (U : Set E3), IsOpen U → ContDiffOn ℝ ∞ F U →
      ∀ y ∈ U, ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j F) y = partialDeriv j (partialDeriv i F) y := by
    intro F U hU hF y hy i j
    have hFa : ContDiffAt ℝ ∞ F y := hF.contDiffAt (hU.mem_nhds hy)
    have h2le : (2 : WithTop ℕ∞) ≤ ∞ := by
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.2 le_top
        | simp
    have hF2 : ContDiffAt ℝ 2 F y := hFa.of_le h2le
    have hsy : IsSymmSndFDerivAt ℝ F y :=
      hF2.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    have hd : DifferentiableAt ℝ (fderiv ℝ F) y :=
      (hF2.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    have key : ∀ a b : Fin 3,
        partialDeriv a (partialDeriv b F) y = fderiv ℝ (fderiv ℝ F) y (e a) (e b) := by
      intro a b
      show fderiv ℝ (fun x => fderiv ℝ F x (e b)) y (e a) = _
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    rw [key, key]
    exact hsy _ _
  
  have hpκ : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hy₂ : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have hsm : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
    intro f hf
    exact contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn contMDiffOn_chart_symm)
  have hdF : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p ≠ 0 →
      fderiv ℝ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0 := by
    intro f hf h
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p := hf.mdifferentiableAt (by simp)
    have heq : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p =
        fderiv ℝ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
      rw [hmd.mfderiv]
      simp [writtenInExtChartAt]
      rfl
    rw [← heq]
    exact h
  have hGsymm : ∀ (w : E3) (a b : Fin 3),
      g.coeff (chartAt E3 p).symm w a b = g.coeff (chartAt E3 p).symm w b a :=
    fun w a b => g.symm _ _ _
  have hchr : ∀ (k i j : Fin 3) (w : E3),
      christoffel (g.coeff (chartAt E3 p).symm) k i j w =
        christoffel (g.coeff (chartAt E3 p).symm) k j i w := by
    intro k i j w
    have hf : (fun z => g.coeff (chartAt E3 p).symm z j i) =
        (fun z => g.coeff (chartAt E3 p).symm z i j) := funext fun z => hGsymm z j i
    simp only [christoffel, hf, Fin.sum_univ_three]
    ring
  have hHsym : ∀ F : E3 → ℝ, ContDiffOn ℝ ∞ F (chartAt E3 p).target → ∀ i j : Fin 3,
      hessLoc (g.coeff (chartAt E3 p).symm) F i j (chartAt E3 p p) =
        hessLoc (g.coeff (chartAt E3 p).symm) F j i (chartAt E3 p p) := by
    intro F hF i j
    simp only [hessLoc]
    rw [hschwarz F _ (chartAt E3 p).open_target hF _ hy₂ i j]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hchr k i j]
  
  obtain ⟨V₀, f₀, -, hV₀o, hpV₀, hf₀, hdf₀, hV₀S, -, -, -⟩ :=
    hS.2 p hp (chartAt E3 p).source (chart_source_mem_nhds E3 p)
  have hPD : (g.coeff (chartAt E3 p).symm (chartAt E3 p p)).PosDef :=
    coeff_chart_symm_posDef g p (chartAt E3 p p) hy₂
  
  have hg5 : ∀ (V : Set M) (f : M → ℝ), IsOpen V → p ∈ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) → V ∩ S = V ∩ f ⁻¹' {0} →
      secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y))
          (chartAt E3 p p) =
        secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => f₀ ((chartAt E3 p).symm y))
          (chartAt E3 p p) := by
    intro V f hV hpV hf hdf hVS
    have hfp : f p = 0 := by
      have h : p ∈ V ∩ S := ⟨hpV, hp⟩
      rw [hVS] at h
      exact h.2
    have hf₀p : f₀ p = 0 := by
      have h : p ∈ V₀ ∩ S := ⟨hpV₀, hp⟩
      rw [hV₀S] at h
      exact h.2
    set U : Set E3 := (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (V ∩ V₀) with hUdef
    have hUo : IsOpen U := (chartAt E3 p).isOpen_inter_preimage_symm (hV.inter hV₀o)
    have hy₂U : chartAt E3 p p ∈ U := by
      refine ⟨hy₂, ?_⟩
      show (chartAt E3 p).symm (chartAt E3 p p) ∈ V ∩ V₀
      rw [(chartAt E3 p).left_inv hpκ]
      exact ⟨hpV, hpV₀⟩
    set F : E3 → ℝ := fun y => f ((chartAt E3 p).symm y) with hFdef
    set F₀ : E3 → ℝ := fun y => f₀ ((chartAt E3 p).symm y) with hF₀def
    have hFs' : ContDiffOn ℝ ∞ F (chartAt E3 p).target := hsm f hf
    have hF₀s' : ContDiffOn ℝ ∞ F₀ (chartAt E3 p).target := hsm f₀ hf₀
    have hFs : ContDiffOn ℝ ∞ F U := hFs'.mono Set.inter_subset_left
    have hF₀s : ContDiffOn ℝ ∞ F₀ U := hF₀s'.mono Set.inter_subset_left
    have hFy : F (chartAt E3 p p) = 0 := by
      show f ((chartAt E3 p).symm (chartAt E3 p p)) = 0
      rw [(chartAt E3 p).left_inv hpκ]
      exact hfp
    have hF₀y : F₀ (chartAt E3 p p) = 0 := by
      show f₀ ((chartAt E3 p).symm (chartAt E3 p p)) = 0
      rw [(chartAt E3 p).left_inv hpκ]
      exact hf₀p
    have hdFF : fderiv ℝ F (chartAt E3 p p) ≠ 0 := hdF f hf (hdf p hpV)
    have hdF₀ : fderiv ℝ F₀ (chartAt E3 p p) ≠ 0 := hdF f₀ hf₀ (hdf₀ p hpV₀)
    have hzero : ∀ w ∈ U, F₀ w = 0 → F w = 0 := by
      intro w hw h0
      have hw' : (chartAt E3 p).symm w ∈ V ∩ V₀ := hw.2
      have hwS : (chartAt E3 p).symm w ∈ S := by
        have h : (chartAt E3 p).symm w ∈ V₀ ∩ f₀ ⁻¹' {0} := ⟨hw'.2, h0⟩
        rw [← hV₀S] at h
        exact h.2
      have h : (chartAt E3 p).symm w ∈ V ∩ S := ⟨hw'.1, hwS⟩
      rw [hVS] at h
      exact h.2
    have hmaxP : ∀ w ∈ U, F₀ w = 0 → F w ≤ F (chartAt E3 p p) := by
      intro w hw h0
      rw [hzero w hw h0, hFy]
    have hmaxN : ∀ w ∈ U, F₀ w = 0 →
        (fun y => -F y) w ≤ (fun y => -F y) (chartAt E3 p p) := by
      intro w hw h0
      show -F w ≤ -F (chartAt E3 p p)
      rw [hzero w hw h0, hFy]
    obtain ⟨μ, hμ⟩ := lagrange_point_multiplier F₀ F U hUo _ hy₂U hF₀s hFs hF₀y hdF₀ hmaxP
    have hμ0 : μ ≠ 0 := by
      rintro rfl
      apply hξne F _ hdFF
      funext k
      rw [hμ k, zero_mul]
      rfl
    have QP := constrained_second_order F₀ F U hUo _ hy₂U hF₀s hFs hF₀y hdF₀ hmaxP μ hμ
    have hμN : ∀ k : Fin 3, partialDeriv k (fun y => -F y) (chartAt E3 p p) =
        -μ * partialDeriv k F₀ (chartAt E3 p p) := by
      intro k
      rw [hpd]
      show -partialDeriv k F (chartAt E3 p p) = _
      rw [hμ k]
      ring
    have QN := constrained_second_order F₀ (fun y => -F y) U hUo _ hy₂U hF₀s hFs.neg hF₀y hdF₀
      hmaxN (-μ) hμN
    simp only [hpd] at QN
    have hBAD : ∀ i j : Fin 3,
        hessLoc (g.coeff (chartAt E3 p).symm) F i j (chartAt E3 p p) -
          μ * hessLoc (g.coeff (chartAt E3 p).symm) F₀ i j (chartAt E3 p p) =
        partialDeriv i (partialDeriv j F) (chartAt E3 p p) -
          μ * partialDeriv i (partialDeriv j F₀) (chartAt E3 p p) := by
      intro i j
      simp only [hessLoc, hμ, Fin.sum_univ_three]
      ring
    have hD : ∀ v : Fin 3 → ℝ, ∑ k : Fin 3, partialDeriv k F₀ (chartAt E3 p p) * v k = 0 →
        ∑ i : Fin 3, ∑ j : Fin 3, v i * v j *
          (hessLoc (g.coeff (chartAt E3 p).symm) F i j (chartAt E3 p p) -
            μ * hessLoc (g.coeff (chartAt E3 p).symm) F₀ i j (chartAt E3 p p)) = 0 := by
      intro v hv
      simp only [hBAD]
      have h1 := QP v hv
      have h2 := QN v hv
      have h3 : ∑ i : Fin 3, ∑ j : Fin 3, v i * v j *
          (-partialDeriv i (partialDeriv j F) (chartAt E3 p p) -
            -μ * partialDeriv i (partialDeriv j F₀) (chartAt E3 p p)) =
          -(∑ i : Fin 3, ∑ j : Fin 3, v i * v j *
            (partialDeriv i (partialDeriv j F) (chartAt E3 p p) -
              μ * partialDeriv i (partialDeriv j F₀) (chartAt E3 p p))) := by
        simp only [Fin.sum_univ_three]
        ring
      rw [h3] at h2
      linarith
    have hDsymm : ∀ i j : Fin 3,
        hessLoc (g.coeff (chartAt E3 p).symm) F i j (chartAt E3 p p) -
            μ * hessLoc (g.coeff (chartAt E3 p).symm) F₀ i j (chartAt E3 p p) =
          hessLoc (g.coeff (chartAt E3 p).symm) F j i (chartAt E3 p p) -
            μ * hessLoc (g.coeff (chartAt E3 p).symm) F₀ j i (chartAt E3 p p) := by
      intro i j
      rw [hHsym F hFs' i j, hHsym F₀ hF₀s' i j]
    exact secondFundSq_congr_scale (g.coeff (chartAt E3 p).symm) F₀ F (chartAt E3 p p) μ hPD
      (hξne F₀ _ hdF₀) hμ0 hμ hDsymm hD
  
  have ht0 : 0 ≤ secondFundSq (g.coeff (chartAt E3 p).symm)
      (fun y => f₀ ((chartAt E3 p).symm y)) (chartAt E3 p p) :=
    secondFundSq_nonneg_of_posDef _ _ _ hPD (hHsym _ (hsm f₀ hf₀))
  
  have hx₁ : chartAt E3 z p ∈ (chartAt E3 z).target := (chartAt E3 z).map_source hpz
  have hlinv : (chartAt E3 z).symm (chartAt E3 z p) = p := (chartAt E3 z).left_inv hpz
  let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    { toPartialEquiv := (chartAt E3 z).symm.toPartialEquiv
      open_source := (chartAt E3 z).open_target
      open_target := (chartAt E3 z).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  have hΦx : Φ (chartAt E3 z p) = p := hlinv
  have hx₁Φ : chartAt E3 z p ∈ Φ.source := hx₁
  have h7 := sep_chart_transition g z p (chartAt E3 z p) hx₁ (by rw [hlinv]; exact hpκ)
  rw [hlinv] at h7
  obtain ⟨h7d, h7G, h7ξ⟩ := h7
  have hentry : ∀ a i : Fin 3,
      fderiv ℝ (fun w => chartAt E3 p ((chartAt E3 z).symm w)) (chartAt E3 z p) (e i) a =
        partialDeriv i (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) (chartAt E3 z p) := by
    intro a i
    have h := ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).hasFDerivAt.comp (chartAt E3 z p)
      h7d.hasFDerivAt).fderiv
    show _ = fderiv ℝ (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) (chartAt E3 z p) (e i)
    rw [show (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) =
      (EuclideanSpace.proj a : E3 →L[ℝ] ℝ) ∘ (fun w => chartAt E3 p ((chartAt E3 z).symm w))
      from rfl, h]
    rfl
  have hchart : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      secondFundSq (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y))
          (chartAt E3 z p) =
        secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y))
          (chartAt E3 p p) := by
    intro f hf
    have h6 := hessLoc_chart_invariant g Φ f Set.univ isOpen_univ hf.contMDiffOn
      (chartAt E3 z p) hx₁Φ (Set.mem_univ _)
    rw [hΦx] at h6
    have h6' : (Matrix.of fun a i : Fin 3 =>
          partialDeriv i (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) (chartAt E3 z p)).det
          ≠ 0 ∧
        ∀ i j : Fin 3, hessLoc (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y))
            i j (chartAt E3 z p) =
          ∑ a : Fin 3, ∑ b : Fin 3,
            partialDeriv i (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) (chartAt E3 z p) *
              partialDeriv j (fun w => chartAt E3 p ((chartAt E3 z).symm w) b) (chartAt E3 z p) *
              hessLoc (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y)) a b
                (chartAt E3 p p) := h6
    refine secondFundSq_congr_tensor (g.coeff (chartAt E3 p).symm) (g.coeff (chartAt E3 z).symm)
      (fun y => f ((chartAt E3 p).symm y)) (fun y => f ((chartAt E3 z).symm y))
      (chartAt E3 p p) (chartAt E3 z p)
      (Matrix.of fun a i : Fin 3 =>
        partialDeriv i (fun w => chartAt E3 p ((chartAt E3 z).symm w) a) (chartAt E3 z p))
      h6'.1 hPD.det_pos.ne' ?_ ?_ ?_
    · intro i j
      rw [h7G i j]
      simp only [hentry, Matrix.of_apply]
    · intro i
      rw [h7ξ f hf i]
      simp only [hentry, Matrix.of_apply]
    · intro i j
      rw [h6'.2 i j]
      simp only [Matrix.of_apply]
  refine ⟨secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => f₀ ((chartAt E3 p).symm y))
    (chartAt E3 p p), ht0, ?_, ?_⟩
  · intro V f hV hpV _ hf hdf hVS
    rw [hchart f hf]
    exact hg5 V f hV hpV hf hdf hVS
  · intro V f hV hpV _ hf hdf hVS
    exact hg5 V f hV hpV hf hdf hVS

theorem surfA2_attains_max [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Sig : Set M) (hc : IsCompact Sig) (hm : IsMinimalSurfaceSet g Sig) (hne : Sig.Nonempty) : ∃ q ∈ Sig, ∃ lam : ℝ, 0 ≤ lam ∧ IsSurfA2At g Sig (chartAt E3 q) q (lam ^ 2) ∧ ∀ p ∈ Sig, ∀ t : ℝ, IsSurfA2At g Sig (chartAt E3 p) p t → t ≤ lam ^ 2 :=
by
  classical
  
  have hs2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E3 → ℝ) (U : Set E3), IsOpen U →
      ∀ y₀ ∈ U, (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → ContDiffOn ℝ ∞ F U →
      (G y₀).det ≠ 0 →
      (∑ a : Fin 3, ∑ b : Fin 3, (G y₀)⁻¹ a b * partialDeriv a F y₀ * partialDeriv b F y₀) ≠ 0 →
      ContinuousAt (secondFundSq G F) y₀ := by
    intro G F U hU y₀ hy₀ hG hF hdet hden
    have hUn : U ∈ 𝓝 y₀ := hU.mem_nhds hy₀
    have hpd : ∀ φ : E3 → ℝ, ContDiffOn ℝ ∞ φ U → ∀ i : Fin 3,
        ContinuousAt (partialDeriv i φ) y₀ := by
      intro φ hφ i
      have h1 : ContinuousAt (fderiv ℝ φ) y₀ :=
        (hφ.continuousOn_fderiv_of_isOpen hU (by simp)).continuousAt hUn
      exact h1.clm_apply continuousAt_const
    have hGc : ContinuousAt G y₀ := continuousAt_pi.2 fun i => continuousAt_pi.2 fun j =>
      ((hG i j).continuousOn).continuousAt hUn
    have hinv : ContinuousAt (fun y => (G y)⁻¹) y₀ := by
      have h : ContinuousAt Ring.inverse (G y₀).det := by
        rw [Ring.inverse_eq_inv']
        exact continuousAt_inv₀ hdet
      exact (continuousAt_matrix_inv (G y₀) h).comp hGc
    have hinvij : ∀ i j : Fin 3, ContinuousAt (fun y => (G y)⁻¹ i j) y₀ :=
      fun i j => continuousAt_pi.1 (continuousAt_pi.1 hinv i) j
    have hpdG : ∀ i j l : Fin 3, ContinuousAt (partialDeriv i (fun z => G z j l)) y₀ :=
      fun i j l => hpd _ (hG j l) i
    have hpdF : ∀ k : Fin 3, ContinuousAt (partialDeriv k F) y₀ := fun k => hpd F hF k
    have hF' : ∀ j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv j F) U := by
      intro j
      have h := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hF).2
      exact h.clm_apply contDiffOn_const
    have hpdFF : ∀ i j : Fin 3, ContinuousAt (partialDeriv i (partialDeriv j F)) y₀ :=
      fun i j => hpd _ (hF' j) i
    have hchr : ∀ k i j : Fin 3, ContinuousAt (christoffel G k i j) y₀ := by
      intro k i j
      unfold christoffel
      fun_prop
    have hhess : ∀ i j : Fin 3, ContinuousAt (hessLoc G F i j) y₀ := by
      intro i j
      unfold hessLoc
      fun_prop
    unfold secondFundSq
    fun_prop (disch := assumption)
  
  have huniq : ∀ (κ : OpenPartialHomeomorph M E3) (p : M) (t₁ t₂ : ℝ), p ∈ Sig →
      p ∈ κ.source → IsSurfA2At g Sig κ p t₁ → IsSurfA2At g Sig κ p t₂ → t₁ = t₂ := by
    intro κ p t₁ t₂ hp hpκ h₁ h₂
    obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, -, -, -⟩ :=
      hm.2 p hp κ.source (κ.open_source.mem_nhds hpκ)
    rw [← h₁ V f hVo hpV hVO hf hdf hVS, ← h₂ V f hVo hpV hVO hf hdf hVS]
  
  have hex : ∀ p : M, ∃ t : ℝ, p ∈ Sig → 0 ≤ t ∧ IsSurfA2At g Sig (chartAt E3 p) p t := by
    intro p
    by_cases hp : p ∈ Sig
    · obtain ⟨t, ht0, -, ht⟩ := surfA2_chart_invariant g Sig hm p p hp (mem_chart_source E3 p)
      exact ⟨t, fun _ => ⟨ht0, ht⟩⟩
    · exact ⟨0, fun h => absurd h hp⟩
  choose A hA using hex
  have hcont : ContinuousOn A Sig := by
    intro p₀ hp₀
    obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, -, -, -⟩ :=
      hm.2 p₀ hp₀ (chartAt E3 p₀).source (chart_source_mem_nhds E3 p₀)
    have hrep : ∀ p ∈ V, p ∈ Sig → A p = secondFundSq (g.coeff (chartAt E3 p₀).symm)
        (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀ p) := by
      intro p hpV' hp
      obtain ⟨t, -, h1, h2⟩ := surfA2_chart_invariant g Sig hm p₀ p hp (hVO hpV')
      rw [h1 V f hVo hpV' hVO hf hdf hVS]
      exact huniq (chartAt E3 p) p (A p) t hp (mem_chart_source E3 p) (hA p hp).2 h2
    
    have hFs : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 p₀).symm)
          (chartAt E3 p₀).target :=
        hf.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have hPD := coeff_chart_symm_posDef g p₀ (chartAt E3 p₀ p₀) (mem_chart_target E3 p₀)
    have hdet : (g.coeff (chartAt E3 p₀).symm (chartAt E3 p₀ p₀)).det ≠ 0 := hPD.det_pos.ne'
    have hfd : fderiv ℝ (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀ p₀) ≠ 0 := by
      have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p₀ := hf.mdifferentiableAt (by simp)
      have h := hdf p₀ hpV
      rw [hmd.mfderiv] at h
      simpa [writtenInExtChartAt, Function.comp_def] using h
    have hv : (fun a : Fin 3 => partialDeriv a (fun y => f ((chartAt E3 p₀).symm y))
        (chartAt E3 p₀ p₀)) ≠ 0 := by
      intro hv0
      apply hfd
      have hz : ∀ a : Fin 3,
          fderiv ℝ (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀ p₀) (e a) = 0 :=
        fun a => congrFun hv0 a
      ext w
      rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr w]
      simp only [map_sum, map_smul, EuclideanSpace.basisFun_apply]
      simp [hz]
    have hden : (∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 p₀).symm (chartAt E3 p₀ p₀))⁻¹ a b *
          partialDeriv a (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀ p₀) *
          partialDeriv b (fun y => f ((chartAt E3 p₀).symm y)) (chartAt E3 p₀ p₀)) ≠ 0 := by
      have hpos := hPD.inv.dotProduct_mulVec_pos hv
      apply ne_of_gt
      convert hpos using 1
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
    have hhc : ContinuousAt (secondFundSq (g.coeff (chartAt E3 p₀).symm)
        (fun y => f ((chartAt E3 p₀).symm y))) (chartAt E3 p₀ p₀) :=
      hs2 _ _ (chartAt E3 p₀).target (chartAt E3 p₀).open_target _ (mem_chart_target E3 p₀)
        (fun i j => g.smooth p₀ i j) hFs hdet hden
    have hc2 : ContinuousWithinAt ((secondFundSq (g.coeff (chartAt E3 p₀).symm)
        (fun y => f ((chartAt E3 p₀).symm y))) ∘ (chartAt E3 p₀)) Sig p₀ :=
      (hhc.comp ((chartAt E3 p₀).continuousAt (mem_chart_source E3 p₀))).continuousWithinAt
    refine hc2.congr_of_eventuallyEq ?_ (hrep p₀ hpV hp₀)
    filter_upwards [mem_nhdsWithin_of_mem_nhds (hVo.mem_nhds hpV), self_mem_nhdsWithin]
      with p hp1 hp2
    exact hrep p hp1 hp2
  obtain ⟨q, hq, hmax⟩ := hc.exists_isMaxOn hne hcont
  refine ⟨q, hq, Real.sqrt (A q), Real.sqrt_nonneg _, ?_, ?_⟩
  · rw [Real.sq_sqrt (hA q hq).1]
    exact (hA q hq).2
  · intro p hp t ht
    rw [Real.sq_sqrt (hA q hq).1,
      huniq (chartAt E3 p) p t (A p) hp (mem_chart_source E3 p) ht (hA p hp).2]
    exact isMaxOn_iff.mp hmax p hp

theorem chart_metric_lower_bound [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ m : ℝ, 0 < m ∧ ∀ y ∈ Metric.closedBall (chartAt E3 z z) (4 * r), ∀ v : E3, m * ‖v‖ ^ 2 ≤ ∑ k : Fin 3, ∑ l : Fin 3, v k * g.coeff (chartAt E3 z).symm y k l * v l :=
by
  classical
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 z).symm with hGdef
  set B := Metric.closedBall (chartAt E3 z z) (4 * r) with hBdef
  set Q : E3 × E3 → ℝ := fun p => ∑ k : Fin 3, ∑ l : Fin 3, p.2 k * G p.1 k l * p.2 l with hQdef
  by_cases hB : B.Nonempty
  swap
  · exact ⟨1, one_pos, fun y hy v => absurd ⟨y, hy⟩ hB⟩
  have hGc : ∀ k l : Fin 3, ContinuousOn (fun y => G y k l) (chartAt E3 z).target :=
    fun k l => (g.smooth z k l).continuousOn
  have hQc : ContinuousOn Q (B ×ˢ Metric.sphere (0 : E3) 1) := by
    have hmaps : Set.MapsTo Prod.fst (B ×ˢ Metric.sphere (0 : E3) 1) (chartAt E3 z).target :=
      fun p hp => hball hp.1
    have hcoord : ∀ k : Fin 3, Continuous (fun p : E3 × E3 => p.2 k) := fun k =>
      (PiLp.continuous_apply 2 _ k).comp continuous_snd
    refine continuousOn_finset_sum _ (fun k _ => continuousOn_finset_sum _ (fun l _ => ?_))
    exact (((hcoord k).continuousOn).mul ((hGc k l).comp continuous_fst.continuousOn hmaps)).mul
      (hcoord l).continuousOn
  have he0 : (e 0) ∈ Metric.sphere (0 : E3) 1 := by
    rw [mem_sphere_zero_iff_norm, EuclideanSpace.norm_single, norm_one]
  obtain ⟨p₀, hp₀, hmin⟩ := ((isCompact_closedBall _ _).prod
    (isCompact_sphere (0 : E3) 1)).exists_isMinOn (hB.prod ⟨e 0, he0⟩) hQc
  have hbridge : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (v : E3),
      dotProduct (star (WithLp.ofLp v)) (Matrix.mulVec A (WithLp.ofLp v)) =
        ∑ k : Fin 3, ∑ l : Fin 3, v k * A k l * v l := by
    intro A v
    simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum, mul_assoc]
  have hposdef : ∀ y ∈ (chartAt E3 z).target, (G y).PosDef := by
    intro y hy
    have hq : (chartAt E3 z).symm y ∈ (chartAt E3 z).source := (chartAt E3 z).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 z) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z) ((chartAt E3 z).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 z) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 z) ∘ (chartAt E3 z).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z) ((chartAt E3 z).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 z) ∘ (chartAt E3 z).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 z).eventually_right_inverse hy] with w hw
      exact hw
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z) ((chartAt E3 z).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [hGdef, RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 z).symm y) _ hDv
      have key : dotProduct (star x) ((G y).mulVec x) =
          g.g ((chartAt E3 z).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm y (∑ i, x i • e i : E3)) := by
        simp only [hGdef, map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  have hm : 0 < Q p₀ := by
    have hpd := hposdef p₀.1 (hball hp₀.1)
    have hu : p₀.2 ≠ 0 := by
      intro h
      have h' := hp₀.2
      rw [h, mem_sphere_zero_iff_norm, norm_zero] at h'
      exact zero_ne_one h'
    have hu' : WithLp.ofLp p₀.2 ≠ 0 := by
      rwa [Ne, WithLp.ofLp_eq_zero]
    have h3 := hpd.dotProduct_mulVec_pos hu'
    rw [hbridge] at h3
    exact h3
  have hhom : ∀ (y v : E3) (t : ℝ), Q (y, t • v) = t ^ 2 * Q (y, v) := by
    intro y v t
    simp only [hQdef, PiLp.smul_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => by ring))
  refine ⟨Q p₀, hm, fun y hy v => ?_⟩
  show Q p₀ * ‖v‖ ^ 2 ≤ Q (y, v)
  by_cases hv : v = 0
  · subst hv
    simp [hQdef]
  · have ht : 0 < ‖v‖ := norm_pos_iff.mpr hv
    have hu : ‖v‖⁻¹ • v ∈ Metric.sphere (0 : E3) 1 := by
      rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ ht.ne']
    have h1 := isMinOn_iff.mp hmin (y, ‖v‖⁻¹ • v) ⟨hy, hu⟩
    rw [hhom] at h1
    have h2 := mul_le_mul_of_nonneg_right h1 (sq_nonneg ‖v‖)
    calc Q p₀ * ‖v‖ ^ 2 ≤ ‖v‖⁻¹ ^ 2 * Q (y, v) * ‖v‖ ^ 2 := h2
      _ = Q (y, v) := by field_simp

theorem ode_global_flow_exists {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F] (V : F → F) (K : NNReal) (hVL : LipschitzWith K V) (B : ℝ) (hB : ∀ x, ‖V x‖ ≤ B) : ∃ Ψ : ℝ → F → F, (∀ x, Ψ 0 x = x) ∧ ∀ (t : ℝ) (x : F), HasDerivAt (fun s => Ψ s x) (V (Ψ t x)) t :=
by
  
  have hS1 : ∀ (x : F) (T : ℝ), 0 < T → ∃ α : ℝ → F, α 0 = x ∧
      ∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (V (α t)) (Set.Icc (-T) T) t := by
    intro x T hT
    let t₀ : Set.Icc (-T) T := ⟨0, by constructor <;> linarith⟩
    have hBL : B ≤ ((Real.toNNReal B : NNReal) : ℝ) := Real.le_coe_toNNReal B
    have hTn : ((Real.toNNReal T : NNReal) : ℝ) = T := Real.coe_toNNReal T hT.le
    have hPL : IsPicardLindelof (fun _ => V) t₀ x (Real.toNNReal B * Real.toNNReal T) 0
        (Real.toNNReal B) K := by
      apply IsPicardLindelof.of_time_independent
      · intro y _
        exact (hB y).trans hBL
      · exact hVL.lipschitzOnWith
      · have ht0 : ((t₀ : ℝ)) = 0 := rfl
        rw [ht0, NNReal.coe_mul, hTn, NNReal.coe_zero, sub_zero, sub_zero, zero_sub, neg_neg,
          max_self]
    obtain ⟨α, h0, hd⟩ := hPL.exists_eq_forall_mem_Icc_hasDerivWithinAt₀
    exact ⟨α, h0, hd⟩
  
  have hS2 : ∀ (T₁ T₂ : ℝ), 0 < T₁ → 0 < T₂ → ∀ (α β : ℝ → F),
      (∀ t ∈ Set.Icc (-T₁) T₁, HasDerivWithinAt α (V (α t)) (Set.Icc (-T₁) T₁) t) →
      (∀ t ∈ Set.Icc (-T₂) T₂, HasDerivWithinAt β (V (β t)) (Set.Icc (-T₂) T₂) t) →
      α 0 = β 0 → ∀ t : ℝ, |t| < T₁ → |t| < T₂ → α t = β t := by
    intro T₁ T₂ hT₁ hT₂ α β hα hβ h0 t ht₁ ht₂
    have hS : 0 < min T₁ T₂ := lt_min hT₁ hT₂
    have gen : ∀ (γ : ℝ → F) (T' : ℝ), min T₁ T₂ ≤ T' →
        (∀ t ∈ Set.Icc (-T') T', HasDerivWithinAt γ (V (γ t)) (Set.Icc (-T') T') t) →
        ContinuousOn γ (Set.Icc (-(min T₁ T₂)) (min T₁ T₂)) ∧
          ∀ t ∈ Set.Ioo (-(min T₁ T₂)) (min T₁ T₂), HasDerivAt γ (V (γ t)) t := by
      intro γ T' hST' hγ
      refine ⟨fun t ht => ?_, fun t ht => ?_⟩
      · have htT : t ∈ Set.Icc (-T') T' := ⟨by linarith [ht.1], by linarith [ht.2]⟩
        exact (hγ t htT).continuousWithinAt.mono (Set.Icc_subset_Icc (neg_le_neg hST') hST')
      · have h1 : -T' < t := by linarith [ht.1]
        have h2 : t < T' := by linarith [ht.2]
        exact (hγ t ⟨h1.le, h2.le⟩).hasDerivAt (Icc_mem_nhds h1 h2)
    obtain ⟨hαc, hαd⟩ := gen α T₁ (min_le_left _ _) hα
    obtain ⟨hβc, hβd⟩ := gen β T₂ (min_le_right _ _) hβ
    have hEq := ODE_solution_unique_of_mem_Icc (v := fun _ => V) (s := fun _ => Set.univ) (K := K)
      (fun _ _ => hVL.lipschitzOnWith)
      (show (0 : ℝ) ∈ Set.Ioo (-(min T₁ T₂)) (min T₁ T₂) from ⟨by linarith, hS⟩)
      hαc hαd (fun _ _ => Set.mem_univ _) hβc hβd (fun _ _ => Set.mem_univ _) h0
    have htS : |t| < min T₁ T₂ := lt_min ht₁ ht₂
    obtain ⟨h1, h2⟩ := abs_lt.mp htS
    exact hEq ⟨h1.le, h2.le⟩
  
  have hA : ∀ (x : F) (T : ℝ), ∃ α : ℝ → F, 0 < T → (α 0 = x ∧
      ∀ t ∈ Set.Icc (-T) T, HasDerivWithinAt α (V (α t)) (Set.Icc (-T) T) t) := by
    intro x T
    by_cases hT : 0 < T
    · obtain ⟨α, h0, hd⟩ := hS1 x T hT
      exact ⟨α, fun _ => ⟨h0, hd⟩⟩
    · exact ⟨fun _ => x, fun h => absurd h hT⟩
  choose α hα using hA
  have hpos : ∀ s : ℝ, 0 < |s| + 1 := fun s => by positivity
  refine ⟨fun t x => α x (|t| + 1) t, fun x => (hα x (|0| + 1) (hpos 0)).1, ?_⟩
  intro t x
  obtain ⟨-, hd⟩ := hα x (|t| + 1) (hpos t)
  have h := abs_lt.mp (show |t| < |t| + 1 by linarith)
  have hαt : HasDerivAt (α x (|t| + 1)) (V (α x (|t| + 1) t)) t :=
    (hd t ⟨h.1.le, h.2.le⟩).hasDerivAt (Icc_mem_nhds h.1 h.2)
  apply hαt.congr_of_eventuallyEq
  filter_upwards [Ioo_mem_nhds h.1 h.2] with s hs
  have h0eq : α x (|s| + 1) 0 = α x (|t| + 1) 0 :=
    (hα x _ (hpos s)).1.trans (hα x _ (hpos t)).1.symm
  exact hS2 (|s| + 1) (|t| + 1) (hpos s) (hpos t) _ _ (hα x _ (hpos s)).2 hd h0eq s
    (by linarith) (abs_lt.mpr ⟨hs.1, hs.2⟩)

theorem ode_flow_continuous_init {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] (V : F → F) (K : NNReal) (hVL : LipschitzWith K V) (B : ℝ) (hB : ∀ x, ‖V x‖ ≤ B) (Ψ : ℝ → F → F) (hΨ0 : ∀ x, Ψ 0 x = x) (hΨ : ∀ (t : ℝ) (x : F), HasDerivAt (fun s => Ψ s x) (V (Ψ t x)) t) : Continuous (fun p : ℝ × F => Ψ p.1 p.2) :=
by
  
  have gron : ∀ (W : F → F), LipschitzWith K W → ∀ Φ : ℝ → F → F, (∀ x, Φ 0 x = x) →
      (∀ (t : ℝ) (x : F), HasDerivAt (fun s => Φ s x) (W (Φ t x)) t) →
      ∀ t : ℝ, 0 ≤ t → ∀ x y : F, dist (Φ t x) (Φ t y) ≤ dist x y * Real.exp (K * t) := by
    intro W hW Φ hΦ0 hΦ t ht x y
    have hcx : Continuous (fun s => Φ s x) :=
      continuous_iff_continuousAt.2 fun s => (hΦ s x).continuousAt
    have hcy : Continuous (fun s => Φ s y) :=
      continuous_iff_continuousAt.2 fun s => (hΦ s y).continuousAt
    have h := dist_le_of_trajectories_ODE (v := fun _ => W) (K := K) (fun _ => hW)
      (f := fun s => Φ s x) (g := fun s => Φ s y) (a := 0) (b := t) (δ := dist x y)
      hcx.continuousOn (fun s _ => (hΦ s x).hasDerivWithinAt)
      hcy.continuousOn (fun s _ => (hΦ s y).hasDerivWithinAt)
      (by simp only [hΦ0]; exact le_rfl) t ⟨ht, le_rfl⟩
    simpa only [sub_zero] using h
  
  have two : ∀ t : ℝ, ∀ x y : F, dist (Ψ t x) (Ψ t y) ≤ dist x y * Real.exp (K * |t|) := by
    intro t x y
    rcases le_or_gt 0 t with ht | ht
    · rw [abs_of_nonneg ht]
      exact gron V hVL Ψ hΨ0 hΨ t ht x y
    · have hd : ∀ (s₀ : ℝ) (z : F),
          HasDerivAt (fun s => Ψ (-s) z) ((fun w => -V w) (Ψ (-s₀) z)) s₀ := by
        intro s₀ z
        have h1 := (hΨ (-s₀) z).scomp s₀ (hasDerivAt_neg s₀)
        simp only [neg_one_smul] at h1
        exact h1
      have h := gron (fun w => -V w) hVL.neg (fun s z => Ψ (-s) z)
        (fun z => by simp only [neg_zero, hΨ0]) hd (-t) (by linarith) x y
      simp only [neg_neg] at h
      rw [abs_of_neg ht]
      exact h
  have hspace : ∀ t : ℝ, Continuous (fun y => Ψ t y) := by
    intro t
    refine (LipschitzWith.of_dist_le' (K := Real.exp (K * |t|)) ?_).continuous
    intro x y
    rw [mul_comm]
    exact two t x y
  have htime : ∀ x : F, LipschitzWith B.toNNReal (fun s => Ψ s x) := by
    intro x
    refine lipschitzWith_of_nnnorm_deriv_le (𝕜 := ℝ) (fun s => (hΨ s x).differentiableAt) ?_
    intro s
    rw [(hΨ s x).deriv, ← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal']
    exact le_max_of_le_left (hB _)
  exact continuous_prod_of_continuous_lipschitzWith (fun p : ℝ × F => Ψ p.1 p.2) B.toNNReal
    hspace htime

theorem augmented_field_exists {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (X : E → E) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) (K : NNReal) (hDX : ∀ y, ‖fderiv ℝ X y‖ ≤ K) (R : ℝ) (hR : 0 < R) : ∃ Z : E × (E →L[ℝ] E) → E × (E →L[ℝ] E), ContDiff ℝ ∞ Z ∧ HasCompactSupport Z ∧ (∀ (x : E) (A : E →L[ℝ] E), ‖A‖ ≤ R → Z (x, A) = (X x, (fderiv ℝ X x).comp A)) ∧ ∀ p, ‖(Z p).2‖ ≤ K * ‖p.2‖ :=
by
  let f : ContDiffBump (0 : E →L[ℝ] E) := ⟨R, R + 1, hR, by linarith⟩
  have hfs : ContDiff ℝ ∞ (fun A : E →L[ℝ] E => f A) := f.contDiff (n := ⊤)
  have hDXs : ContDiff ℝ ∞ (fderiv ℝ X) := hX.fderiv_right (m := ∞) (by simp)
  refine ⟨fun p => f p.2 • (X p.1, (fderiv ℝ X p.1).comp p.2), ?_, ?_, ?_, ?_⟩
  · exact (hfs.comp contDiff_snd).smul
      ((hX.comp contDiff_fst).prodMk ((hDXs.comp contDiff_fst).clm_comp contDiff_snd))
  · refine HasCompactSupport.intro (hXc.isCompact.prod f.hasCompactSupport.isCompact) ?_
    intro p hp
    rw [Set.mem_prod, not_and_or] at hp
    rcases hp with h | h
    · have h1 : X p.1 = 0 := image_eq_zero_of_notMem_tsupport h
      have h2 : fderiv ℝ X p.1 = 0 := fderiv_of_notMem_tsupport ℝ h
      simp only [h1, h2, ContinuousLinearMap.zero_comp, Prod.mk_zero_zero, smul_zero]
    · have h1 : f p.2 = 0 := image_eq_zero_of_notMem_tsupport h
      simp only [h1, zero_smul]
  · intro x A hA
    have h1 : f A = 1 := f.one_of_mem_closedBall (by
      rw [mem_closedBall_zero_iff]; exact hA)
    simp only [h1, one_smul]
  · intro p
    show ‖f p.2 • (fderiv ℝ X p.1).comp p.2‖ ≤ K * ‖p.2‖
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg f.nonneg]
    have h1 : ‖(fderiv ℝ X p.1).comp p.2‖ ≤ K * ‖p.2‖ :=
      ((fderiv ℝ X p.1).opNorm_comp_le p.2).trans
        (mul_le_mul_of_nonneg_right (hDX p.1) (norm_nonneg _))
    have h2 : f p.2 ≤ 1 := f.le_one
    have h3 : 0 ≤ ‖(fderiv ℝ X p.1).comp p.2‖ := norm_nonneg _
    nlinarith [f.nonneg (x := p.2)]

theorem augmented_flow_ident {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (X : E → E) (K : NNReal) (hXL : LipschitzWith K X) (T : ℝ) (Z : E × (E →L[ℝ] E) → E × (E →L[ℝ] E)) (hZ : ∀ (x : E) (A : E →L[ℝ] E), ‖A‖ ≤ Real.exp (K * T) → Z (x, A) = (X x, (fderiv ℝ X x).comp A)) (hZb : ∀ p, ‖(Z p).2‖ ≤ K * ‖p.2‖) (Fl : ℝ → E → E) (hFl0 : ∀ x, Fl 0 x = x) (hFl : ∀ (t : ℝ) (x : E), HasDerivAt (fun s => Fl s x) (X (Fl t x)) t) (G : ℝ → E × (E →L[ℝ] E) → E × (E →L[ℝ] E)) (hG0 : ∀ p, G 0 p = p) (hG : ∀ (t : ℝ) (p : E × (E →L[ℝ] E)), HasDerivAt (fun s => G s p) (Z (G t p)) t) : ∀ (x : E), ∀ t ∈ Set.Icc (-T) T, (G t (x, ContinuousLinearMap.id ℝ E)).1 = Fl t x ∧ ‖(G t (x, ContinuousLinearMap.id ℝ E)).2‖ ≤ Real.exp (K * |t|) ∧ HasDerivAt (fun s => (G s (x, ContinuousLinearMap.id ℝ E)).2) ((fderiv ℝ X (Fl t x)).comp (G t (x, ContinuousLinearMap.id ℝ E)).2) t :=
by
  intro x
  have hKnn : (0 : ℝ) ≤ (K : ℝ) := K.coe_nonneg
  
  have hd1 : ∀ s : ℝ, HasDerivAt (fun s => (G s (x, ContinuousLinearMap.id ℝ E)).1)
      (Z (G s (x, ContinuousLinearMap.id ℝ E))).1 s := fun s => by
    have h := (hasFDerivAt_fst (𝕜 := ℝ) (p := G s (x, ContinuousLinearMap.id ℝ E))).comp_hasDerivAt
      s (hG s (x, ContinuousLinearMap.id ℝ E))
    exact h
  have hd2 : ∀ s : ℝ, HasDerivAt (fun s => (G s (x, ContinuousLinearMap.id ℝ E)).2)
      (Z (G s (x, ContinuousLinearMap.id ℝ E))).2 s := fun s => by
    have h := (hasFDerivAt_snd (𝕜 := ℝ) (p := G s (x, ContinuousLinearMap.id ℝ E))).comp_hasDerivAt
      s (hG s (x, ContinuousLinearMap.id ℝ E))
    exact h
  have hA0 : ‖(G 0 (x, ContinuousLinearMap.id ℝ E)).2‖ ≤ 1 := by
    rw [hG0]; exact ContinuousLinearMap.norm_id_le
  
  have fwd : ∀ (f f' : ℝ → (E →L[ℝ] E)), (∀ s, HasDerivAt f (f' s) s) →
      (∀ s, ‖f' s‖ ≤ (K : ℝ) * ‖f s‖) → ‖f 0‖ ≤ 1 →
      ∀ t : ℝ, 0 ≤ t → ‖f t‖ ≤ Real.exp ((K : ℝ) * t) := by
    intro f f' hf hb h0 t ht
    have h := norm_le_gronwallBound_of_norm_deriv_right_le (a := 0) (b := t) (f := f)
      (f' := f') (δ := 1) (K := (K : ℝ)) (ε := 0)
      (fun s _ => (hf s).continuousAt.continuousWithinAt) (fun s _ => (hf s).hasDerivWithinAt) h0
      (fun s _ => by rw [add_zero]; exact hb s) t ⟨ht, le_refl t⟩
    rw [gronwallBound_ε0, sub_zero, one_mul] at h
    exact h
  
  have hbound : ∀ t : ℝ, ‖(G t (x, ContinuousLinearMap.id ℝ E)).2‖ ≤ Real.exp ((K : ℝ) * |t|) := by
    intro t
    rcases le_or_gt 0 t with ht | ht
    · rw [abs_of_nonneg ht]
      exact fwd _ _ hd2 (fun s => hZb _) hA0 t ht
    · rw [abs_of_neg ht]
      have h := fwd (fun s => (G (-s) (x, ContinuousLinearMap.id ℝ E)).2)
        (fun s => -(Z (G (-s) (x, ContinuousLinearMap.id ℝ E))).2)
        (fun s => by
          have h1 := (hd2 (-s)).scomp s (hasDerivAt_neg' s)
          simpa [Function.comp_def] using h1)
        (fun s => by rw [norm_neg]; exact hZb _)
        (by simpa using hA0) (-t) (by linarith)
      simpa using h
  intro t ht
  
  have hZs : ∀ s ∈ Set.Icc (-T) T, Z (G s (x, ContinuousLinearMap.id ℝ E)) =
      (X (G s (x, ContinuousLinearMap.id ℝ E)).1,
        (fderiv ℝ X (G s (x, ContinuousLinearMap.id ℝ E)).1).comp
          (G s (x, ContinuousLinearMap.id ℝ E)).2) := by
    intro s hs
    have h1 : ‖(G s (x, ContinuousLinearMap.id ℝ E)).2‖ ≤ Real.exp ((K : ℝ) * T) :=
      (hbound s).trans (Real.exp_le_exp.mpr
        (mul_le_mul_of_nonneg_left (abs_le.mpr ⟨hs.1, hs.2⟩) hKnn))
    exact hZ _ _ h1
  
  have hfirst : (G t (x, ContinuousLinearMap.id ℝ E)).1 = Fl t x := by
    have hT0 : (0 : ℝ) ≤ T := by linarith [ht.1, ht.2]
    rcases eq_or_lt_of_le hT0 with hT0 | hT0
    · have htz : t = 0 := by
        have h1 := ht.1
        have h2 := ht.2
        rw [← hT0] at h1 h2
        linarith
      subst htz
      rw [hG0, hFl0]
    · have h := ODE_solution_unique_of_mem_Icc (v := fun _ => X) (s := fun _ => Set.univ)
        (K := K) (a := -T) (b := T) (t₀ := 0)
        (f := fun s => (G s (x, ContinuousLinearMap.id ℝ E)).1) (g := fun s => Fl s x)
        (fun _ _ => hXL.lipschitzOnWith) ⟨by linarith, hT0⟩
        (fun s _ => (hd1 s).continuousAt.continuousWithinAt)
        (fun s hs => (hd1 s).congr_deriv (by rw [hZs s (Set.Ioo_subset_Icc_self hs)]))
        (fun _ _ => Set.mem_univ _)
        (fun s _ => (hFl s x).continuousAt.continuousWithinAt)
        (fun s _ => hFl s x)
        (fun _ _ => Set.mem_univ _)
        (by simp only [hG0, hFl0])
      exact h ht
  refine ⟨hfirst, hbound t, ?_⟩
  have h := hd2 t
  rw [hZs t ht] at h
  rw [← hfirst]
  exact h

theorem flow_variational_estimate {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (X : E → E) (hX : Differentiable ℝ X) (K : NNReal) (hXL : LipschitzWith K X) (hDX : ∀ y, ‖fderiv ℝ X y‖ ≤ K) (hDXu : UniformContinuous (fderiv ℝ X)) (Fl : ℝ → E → E) (hFl0 : ∀ x, Fl 0 x = x) (hFl : ∀ (t : ℝ) (x : E), HasDerivAt (fun s => Fl s x) (X (Fl t x)) t) (T : ℝ) (Y : ℝ → E → (E →L[ℝ] E)) (hY0 : ∀ x, Y 0 x = ContinuousLinearMap.id ℝ E) (hY : ∀ (x : E), ∀ t ∈ Set.Icc (-T) T, HasDerivAt (fun s => Y s x) ((fderiv ℝ X (Fl t x)).comp (Y t x)) t) : ∀ ε > 0, ∃ δ > 0, ∀ (x h : E), ‖h‖ < δ → ∀ t ∈ Set.Icc (-T) T, ‖Fl t (x + h) - Fl t x - Y t x h‖ ≤ ε * ‖h‖ :=
by
  
  have fwd : ∀ (f f' : ℝ → E) (k ε δ : ℝ), 0 ≤ k → 0 ≤ ε →
      (∀ t ∈ Set.Icc (0 : ℝ) T, HasDerivAt f (f' t) t) →
      (∀ t ∈ Set.Icc (0 : ℝ) T, ‖f' t‖ ≤ k * ‖f t‖ + ε) → ‖f 0‖ ≤ δ →
      ∀ t ∈ Set.Icc (0 : ℝ) T, ‖f t‖ ≤ (δ + ε * t) * Real.exp (k * t) := by
    intro f f' k ε δ hk hε hf hb h0 t ht
    have hg := norm_le_gronwallBound_of_norm_deriv_right_le (f := f) (f' := f') (δ := δ)
      (K := k) (ε := ε) (a := 0) (b := T)
      (fun s hs => (hf s hs).continuousAt.continuousWithinAt)
      (fun s hs => (hf s (Set.Ico_subset_Icc_self hs)).hasDerivWithinAt) h0
      (fun s hs => hb s (Set.Ico_subset_Icc_self hs)) t ht
    rw [sub_zero] at hg
    refine hg.trans ?_
    rcases eq_or_lt_of_le hk with hk0 | hkpos
    · subst hk0
      simp [gronwallBound_K0]
    · rw [gronwallBound_of_K_ne_0 hkpos.ne']
      have ht0 : 0 ≤ t := ht.1
      have e1 := Real.add_one_le_exp (-(k * t))
      have e2 : Real.exp (-(k * t)) * Real.exp (k * t) = 1 := by
        rw [← Real.exp_add]; simp
      have epos := Real.exp_pos (k * t)
      have e3 : Real.exp (k * t) - 1 ≤ k * t * Real.exp (k * t) := by nlinarith
      have hεk : 0 ≤ ε / k := div_nonneg hε hk
      have e4 : ε / k * (Real.exp (k * t) - 1) ≤ ε / k * (k * t * Real.exp (k * t)) :=
        mul_le_mul_of_nonneg_left e3 hεk
      have e5 : ε / k * (k * t * Real.exp (k * t)) = ε * t * Real.exp (k * t) := by
        field_simp
      nlinarith
  
  have gron : ∀ (f f' : ℝ → E) (k ε δ : ℝ), 0 ≤ k → 0 ≤ ε →
      (∀ t ∈ Set.Icc (-T) T, HasDerivAt f (f' t) t) →
      (∀ t ∈ Set.Icc (-T) T, ‖f' t‖ ≤ k * ‖f t‖ + ε) → ‖f 0‖ ≤ δ →
      ∀ t ∈ Set.Icc (-T) T, ‖f t‖ ≤ (δ + ε * |t|) * Real.exp (k * |t|) := by
    intro f f' k ε δ hk hε hf hb h0 t ht
    have hsub : ∀ s ∈ Set.Icc (0 : ℝ) T, s ∈ Set.Icc (-T) T :=
      fun s hs => ⟨by linarith [hs.1, hs.2], hs.2⟩
    have hsub' : ∀ s ∈ Set.Icc (0 : ℝ) T, -s ∈ Set.Icc (-T) T :=
      fun s hs => ⟨by linarith [hs.2], by linarith [hs.1, hs.2]⟩
    rcases le_total 0 t with h | h
    · have := fwd f f' k ε δ hk hε (fun s hs => hf s (hsub s hs)) (fun s hs => hb s (hsub s hs))
        h0 t ⟨h, ht.2⟩
      rwa [abs_of_nonneg h]
    · have := fwd (fun s => f (-s)) (fun s => -f' (-s)) k ε δ hk hε ?_ ?_ (by simpa using h0)
        (-t) ⟨by linarith, by linarith [ht.1]⟩
      · simp only [neg_neg] at this
        rwa [abs_of_nonpos h]
      · intro s hs
        have := (hf (-s) (hsub' s hs)).scomp s (hasDerivAt_neg s)
        simpa [Function.comp_def] using this
      · intro s hs
        simpa using hb (-s) (hsub' s hs)
  
  have taylor : ∀ η > 0, ∃ r > 0, ∀ a y : E, ‖y - a‖ < r →
      ‖X y - X a - fderiv ℝ X a (y - a)‖ ≤ η * ‖y - a‖ := by
    intro η hη
    obtain ⟨r, hr, hu⟩ := Metric.uniformContinuous_iff.mp hDXu η hη
    refine ⟨r, hr, fun a y hy => ?_⟩
    exact Convex.norm_image_sub_le_of_norm_fderiv_le' (𝕜 := ℝ) (f := X) (s := Metric.ball a r)
      (φ := fderiv ℝ X a) (C := η) (fun z _ => hX z)
      (fun z hz => by
        have := hu (Metric.mem_ball.mp hz)
        rw [dist_eq_norm] at this
        exact this.le)
      (convex_ball a r) (Metric.mem_ball_self hr)
      (by rw [Metric.mem_ball, dist_eq_norm]; exact hy)
  
  intro ε hε
  rcases lt_or_ge T 0 with hT | hT
  · refine ⟨1, one_pos, fun x h _ t ht => ?_⟩
    exfalso
    linarith [ht.1, ht.2]
  have hk : 0 ≤ (K : ℝ) := K.coe_nonneg
  set M := Real.exp ((K : ℝ) * T) with hMdef
  have hM : 0 < M := Real.exp_pos _
  have hM1 : 1 ≤ M := Real.one_le_exp (mul_nonneg hk hT)
  set C := T * M * M + 1 with hCdef
  have hC : 0 < C := by positivity
  have hCne : C ≠ 0 := hC.ne'
  obtain ⟨r, hr, hTB⟩ := taylor (ε / C) (div_pos hε hC)
  refine ⟨r / M, div_pos hr hM, fun x h hh t ht => ?_⟩
  have hhM : ‖h‖ * M < r := (lt_div_iff₀ hM).mp hh
  have hexp : ∀ s ∈ Set.Icc (-T) T, Real.exp ((K : ℝ) * |s|) ≤ M := fun s hs =>
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left (abs_le.mpr ⟨hs.1, hs.2⟩) hk)
  have hsep : ∀ s ∈ Set.Icc (-T) T, ‖Fl s (x + h) - Fl s x‖ ≤ ‖h‖ * M := by
    intro s hs
    have := gron (fun s => Fl s (x + h) - Fl s x) (fun s => X (Fl s (x + h)) - X (Fl s x))
      (K : ℝ) 0 ‖h‖ hk le_rfl (fun s _ => (hFl s (x + h)).sub (hFl s x))
      (fun s _ => by simp only [add_zero]; exact hXL.norm_sub_le _ _) (by simp [hFl0]) s hs
    simp only [zero_mul, add_zero] at this
    exact this.trans (mul_le_mul_of_nonneg_left (hexp s hs) (norm_nonneg _))
  have hρ := gron (fun s => Fl s (x + h) - Fl s x - Y s x h)
    (fun s => X (Fl s (x + h)) - X (Fl s x) - fderiv ℝ X (Fl s x) (Y s x h)) (K : ℝ)
    (ε / C * (‖h‖ * M)) 0 hk (by positivity) ?_ ?_ ?_ t ht
  · have ha : |t| ≤ T := abs_le.mpr ⟨ht.1, ht.2⟩
    have he := hexp t ht
    have haa : 0 ≤ ε / C * (‖h‖ * M) := by positivity
    have h1 : ε / C * (‖h‖ * M) * |t| ≤ ε / C * (‖h‖ * M) * T :=
      mul_le_mul_of_nonneg_left ha haa
    have h2 : (ε / C * (‖h‖ * M) * |t|) * Real.exp ((K : ℝ) * |t|) ≤
        (ε / C * (‖h‖ * M) * T) * M :=
      mul_le_mul h1 he (Real.exp_pos _).le (mul_nonneg haa hT)
    have h3 : (ε / C * (‖h‖ * M) * T) * M = ε / C * ‖h‖ * (T * M * M) := by ring
    have h4 : ε / C * ‖h‖ * (T * M * M) ≤ ε / C * ‖h‖ * C :=
      mul_le_mul_of_nonneg_left (by rw [hCdef]; linarith) (by positivity)
    have h5 : ε / C * ‖h‖ * C = ε * ‖h‖ := by field_simp
    simp only [zero_add] at hρ
    linarith
  · intro s hs
    have h1 := (hY x s hs).clm_apply (hasDerivAt_const s h)
    simp only [ContinuousLinearMap.comp_apply, map_zero, add_zero] at h1
    exact ((hFl s (x + h)).sub (hFl s x)).sub h1
  · intro s hs
    have hd := hsep s hs
    have key : X (Fl s (x + h)) - X (Fl s x) - fderiv ℝ X (Fl s x) (Y s x h) =
        (X (Fl s (x + h)) - X (Fl s x) - fderiv ℝ X (Fl s x) (Fl s (x + h) - Fl s x)) +
          fderiv ℝ X (Fl s x) (Fl s (x + h) - Fl s x - Y s x h) := by
      rw [map_sub (fderiv ℝ X (Fl s x)) (Fl s (x + h) - Fl s x)]
      abel
    simp only []
    rw [key]
    have t1 := hTB (Fl s x) (Fl s (x + h)) (lt_of_le_of_lt hd hhM)
    have t2 := ContinuousLinearMap.le_of_opNorm_le _ (hDX (Fl s x))
      (Fl s (x + h) - Fl s x - Y s x h)
    have t3 : ε / C * ‖Fl s (x + h) - Fl s x‖ ≤ ε / C * (‖h‖ * M) :=
      mul_le_mul_of_nonneg_left hd (by positivity)
    refine (norm_add_le _ _).trans ?_
    linarith
  · simp [hFl0, hY0]

theorem hasFDerivAt_uncurry_of_uniform {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] (Φ : ℝ → E → F) (Y : ℝ → E → (E →L[ℝ] F)) (t₀ : ℝ) (x₀ : E) (v : F) (ht : HasDerivAt (fun t => Φ t x₀) v t₀) (hYc : ContinuousAt (fun t => Y t x₀) t₀) (hunif : ∀ ε > 0, ∃ δ > 0, ∀ t : ℝ, |t - t₀| < δ → ∀ h : E, ‖h‖ < δ → ‖Φ t (x₀ + h) - Φ t x₀ - Y t x₀ h‖ ≤ ε * ‖h‖) : HasFDerivAt (fun p : ℝ × E => Φ p.1 p.2) ((ContinuousLinearMap.fst ℝ ℝ E).smulRight v + (Y t₀ x₀).comp (ContinuousLinearMap.snd ℝ ℝ E)) (t₀, x₀) :=
by
  rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
  intro c hc
  have hε : 0 < c / 3 := by linarith
  obtain ⟨δ₁, hδ₁, h1⟩ := hunif (c / 3) hε
  obtain ⟨δ₂, hδ₂, h2⟩ := Metric.continuousAt_iff.mp hYc (c / 3) hε
  have h3 := hasDerivAt_iff_isLittleO_nhds_zero.mp ht
  rw [Asymptotics.isLittleO_iff] at h3
  obtain ⟨δ₃, hδ₃, h3'⟩ := Metric.eventually_nhds_iff.mp (h3 hε)
  rw [Metric.eventually_nhds_iff]
  refine ⟨min δ₁ (min δ₂ δ₃), lt_min hδ₁ (lt_min hδ₂ hδ₃), ?_⟩
  rintro ⟨s, h⟩ hp
  rw [dist_zero_right] at hp
  have hs : ‖s‖ ≤ ‖(s, h)‖ := norm_fst_le (s, h)
  have hh : ‖h‖ ≤ ‖(s, h)‖ := norm_snd_le (s, h)
  have hpδ1 : ‖(s, h)‖ < δ₁ := lt_of_lt_of_le hp (min_le_left _ _)
  have hpδ2 : ‖(s, h)‖ < δ₂ :=
    lt_of_lt_of_le hp (le_trans (min_le_right _ _) (min_le_left _ _))
  have hpδ3 : ‖(s, h)‖ < δ₃ :=
    lt_of_lt_of_le hp (le_trans (min_le_right _ _) (min_le_right _ _))
  have habs : |t₀ + s - t₀| = ‖s‖ := by rw [add_sub_cancel_left, Real.norm_eq_abs]
  have e1 : ‖Φ (t₀ + s) (x₀ + h) - Φ (t₀ + s) x₀ - Y (t₀ + s) x₀ h‖ ≤ c / 3 * ‖h‖ :=
    h1 (t₀ + s) (by rw [habs]; linarith) h (by linarith)
  have e2 : ‖Y (t₀ + s) x₀ - Y t₀ x₀‖ < c / 3 := by
    have := h2 (x := t₀ + s) (by rw [Real.dist_eq, habs]; linarith)
    rwa [dist_eq_norm] at this
  have e3 : ‖Φ (t₀ + s) x₀ - Φ t₀ x₀ - s • v‖ ≤ c / 3 * ‖s‖ := by
    have := h3' (y := s) (by rw [dist_zero_right]; linarith)
    exact this
  have e2' : ‖(Y (t₀ + s) x₀ - Y t₀ x₀) h‖ ≤ c / 3 * ‖h‖ :=
    le_trans (ContinuousLinearMap.le_opNorm _ _)
      (mul_le_mul_of_nonneg_right e2.le (norm_nonneg _))
  have m1 : c / 3 * ‖h‖ ≤ c / 3 * ‖(s, h)‖ := mul_le_mul_of_nonneg_left hh hε.le
  have m2 : c / 3 * ‖s‖ ≤ c / 3 * ‖(s, h)‖ := mul_le_mul_of_nonneg_left hs hε.le
  calc _ = ‖(Φ (t₀ + s) (x₀ + h) - Φ (t₀ + s) x₀ - Y (t₀ + s) x₀ h) +
          (Y (t₀ + s) x₀ - Y t₀ x₀) h + (Φ (t₀ + s) x₀ - Φ t₀ x₀ - s • v)‖ := by
        congr 1
        simp only [Prod.mk_add_mk, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.coe_fst',
          ContinuousLinearMap.comp_apply, ContinuousLinearMap.coe_snd',
          ContinuousLinearMap.sub_apply]
        abel
    _ ≤ ‖Φ (t₀ + s) (x₀ + h) - Φ (t₀ + s) x₀ - Y (t₀ + s) x₀ h‖ +
          ‖(Y (t₀ + s) x₀ - Y t₀ x₀) h‖ + ‖Φ (t₀ + s) x₀ - Φ t₀ x₀ - s • v‖ := norm_add₃_le
    _ ≤ c * ‖(s, h)‖ := by linarith

theorem ode_flow_contDiff {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] (X : E → E) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) : ∃ Fl : ℝ → E → E, ContDiff ℝ ∞ (fun p : ℝ × E => Fl p.1 p.2) ∧ (∀ x, Fl 0 x = x) ∧ ∀ (t : ℝ) (x : E), HasDerivAt (fun s => Fl s x) (X (Fl t x)) t :=
by
  
  have hbounds : ∀ (F : Type u_2) [NormedAddCommGroup F] [NormedSpace ℝ F] (V : F → F),
      ContDiff ℝ ∞ V → HasCompactSupport V →
      ∃ (K : NNReal) (B : ℝ), LipschitzWith K V ∧ (∀ y, ‖fderiv ℝ V y‖ ≤ K) ∧
        (∀ x, ‖V x‖ ≤ B) ∧ UniformContinuous (fderiv ℝ V) ∧ Differentiable ℝ V := by
    intro F _ _ V hV hVc
    obtain ⟨K, hK⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hVc hV (by simp)
    obtain ⟨B, hB⟩ := hV.continuous.bounded_above_of_compact_support hVc
    refine ⟨K, B, hK, fun y => norm_fderiv_le_of_lipschitz ℝ hK, hB, ?_,
      hV.differentiable (by simp)⟩
    exact (hVc.fderiv (𝕜 := ℝ)).uniformContinuous_of_continuous
      (hV.continuous_fderiv (by simp))
  
  have key : ∀ n : ℕ, ∀ (F : Type u_2) [NormedAddCommGroup F] [NormedSpace ℝ F]
      [FiniteDimensional ℝ F] (V : F → F), ContDiff ℝ ∞ V → HasCompactSupport V →
      ∀ Ψ : ℝ → F → F, (∀ x, Ψ 0 x = x) →
      (∀ (t : ℝ) (x : F), HasDerivAt (fun s => Ψ s x) (V (Ψ t x)) t) →
      ContDiff ℝ n (fun p : ℝ × F => Ψ p.1 p.2) := by
    intro n
    induction n with
    | zero =>
      intro F _ _ _ V hV hVc Ψ hΨ0 hΨ
      obtain ⟨K, B, hKL, -, hB, -, -⟩ := hbounds F V hV hVc
      exact contDiff_zero.2 (ode_flow_continuous_init V K hKL B hB Ψ hΨ0 hΨ)
    | succ n ih =>
      intro F _ _ _ V hV hVc Ψ hΨ0 hΨ
      
      have hderiv : ∀ T : ℝ, 0 < T → ∃ G : ℝ → F × (F →L[ℝ] F) → F × (F →L[ℝ] F),
          ContDiff ℝ n (fun q : ℝ × (F × (F →L[ℝ] F)) => G q.1 q.2) ∧
          ∀ t₀ ∈ Set.Ioo (-T) T, ∀ x₀ : F,
            HasFDerivAt (fun p : ℝ × F => Ψ p.1 p.2)
              ((ContinuousLinearMap.fst ℝ ℝ F).smulRight (V (Ψ t₀ x₀)) +
                (G t₀ (x₀, ContinuousLinearMap.id ℝ F)).2.comp (ContinuousLinearMap.snd ℝ ℝ F))
              (t₀, x₀) := by
        intro T hT
        obtain ⟨K, B, hKL, hDK, hB, hU, hD⟩ := hbounds F V hV hVc
        obtain ⟨Z, hZs, hZc, hZf, hZb⟩ :=
          augmented_field_exists V hV hVc K hDK (Real.exp (K * T)) (Real.exp_pos _)
        obtain ⟨KZ, BZ, hZL, -, hZB, -, -⟩ := hbounds (F × (F →L[ℝ] F)) Z hZs hZc
        haveI : CompleteSpace (F × (F →L[ℝ] F)) := FiniteDimensional.complete ℝ _
        obtain ⟨G, hG0, hG⟩ := ode_global_flow_exists Z KZ hZL BZ hZB
        have hGs := ih (F × (F →L[ℝ] F)) Z hZs hZc G hG0 hG
        have hid := augmented_flow_ident V K hKL T Z hZf hZb Ψ hΨ0 hΨ G hG0 hG
        have hest := flow_variational_estimate V hD K hKL hDK hU Ψ hΨ0 hΨ T
          (fun t x => (G t (x, ContinuousLinearMap.id ℝ F)).2)
          (fun x => by simp only [hG0])
          (fun x t ht => (hid x t ht).2.2)
        refine ⟨G, hGs, ?_⟩
        intro t₀ ht₀ x₀
        have ht₀I : t₀ ∈ Set.Icc (-T) T := Set.Ioo_subset_Icc_self ht₀
        refine hasFDerivAt_uncurry_of_uniform Ψ
          (fun t x => (G t (x, ContinuousLinearMap.id ℝ F)).2) t₀ x₀ (V (Ψ t₀ x₀)) (hΨ t₀ x₀)
          ((hid x₀ t₀ ht₀I).2.2.continuousAt) ?_
        intro ε hε
        obtain ⟨δ, hδ, hδ'⟩ := hest ε hε
        have hpos : 0 < T - |t₀| := by
          rw [sub_pos, abs_lt]
          exact ⟨ht₀.1, ht₀.2⟩
        refine ⟨min δ (T - |t₀|), lt_min hδ hpos, ?_⟩
        intro t ht h hh
        have h2 : |t - t₀| < T - |t₀| := lt_of_lt_of_le ht (min_le_right _ _)
        have hh' : ‖h‖ < δ := lt_of_lt_of_le hh (min_le_left _ _)
        have htI : t ∈ Set.Icc (-T) T := by
          have h3 := abs_sub_abs_le_abs_sub t t₀
          have h4 : |t| ≤ T := by linarith
          exact ⟨(abs_le.mp h4).1, (abs_le.mp h4).2⟩
        exact hδ' x₀ h hh' t htI
      have hn : ((n + 1 : ℕ) : WithTop ℕ∞) = (n : WithTop ℕ∞) + 1 := by push_cast; rfl
      have hmem : ∀ t : ℝ, t ∈ Set.Ioo (-(|t| + 1)) (|t| + 1) := by
        intro t
        constructor
        · linarith [neg_abs_le t]
        · linarith [le_abs_self t]
      rw [hn, contDiff_succ_iff_fderiv]
      refine ⟨?_, by simp, ?_⟩
      · intro p
        obtain ⟨G, -, hG⟩ := hderiv (|p.1| + 1) (by positivity)
        exact (hG p.1 (hmem p.1) p.2).differentiableAt
      · rw [contDiff_iff_contDiffAt]
        intro p
        obtain ⟨G, hGs, hG⟩ := hderiv (|p.1| + 1) (by positivity)
        have hΦ := ih F V hV hVc Ψ hΨ0 hΨ
        have ha : ContDiff ℝ n (fun q : ℝ × F => V (Ψ q.1 q.2)) :=
          (hV.of_le (by exact_mod_cast le_top)).comp hΦ
        have hb : ContDiff ℝ n
            (fun q : ℝ × F => (G q.1 (q.2, ContinuousLinearMap.id ℝ F)).2) :=
          contDiff_snd.comp (hGs.comp
            (contDiff_fst.prodMk (contDiff_snd.prodMk contDiff_const)))
        have hL : ContDiff ℝ n (fun q : ℝ × F =>
            (ContinuousLinearMap.fst ℝ ℝ F).smulRight (V (Ψ q.1 q.2)) +
              (G q.1 (q.2, ContinuousLinearMap.id ℝ F)).2.comp
                (ContinuousLinearMap.snd ℝ ℝ F)) :=
          (contDiff_const.smulRight ha).add (hb.clm_comp contDiff_const)
        apply hL.contDiffAt.congr_of_eventuallyEq
        have hU : Set.Ioo (-(|p.1| + 1)) (|p.1| + 1) ×ˢ (Set.univ : Set F) ∈ nhds p :=
          (isOpen_Ioo.prod isOpen_univ).mem_nhds ⟨hmem p.1, Set.mem_univ _⟩
        filter_upwards [hU] with q hq
        exact (hG q.1 hq.1 q.2).fderiv
  
  obtain ⟨K, B, hKL, -, hB, -, -⟩ := hbounds E X hX hXc
  haveI : CompleteSpace E := FiniteDimensional.complete ℝ E
  obtain ⟨Fl, hFl0, hFl⟩ := ode_global_flow_exists X K hKL B hB
  exact ⟨Fl, contDiff_infty.2 (fun n => key n E X hX hXc Fl hFl0 hFl), hFl0, hFl⟩

theorem spray_defining_fn_agree (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W₁ W₂ : Set E3) (hW₁ : IsOpen W₁) (hW₂ : IsOpen W₂) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) W₁) (hGs : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpd : ∀ y ∈ W₁, (G y).PosDef) (Φ₁ Φ₂ : E3 → ℝ) (hΦ₁ : ContDiffOn ℝ ∞ Φ₁ W₁) (hΦ₂ : ContDiffOn ℝ ∞ Φ₂ W₂) (hdΦ₁ : ∀ y ∈ W₁, fderiv ℝ Φ₁ y ≠ 0) (hdΦ₂ : ∀ y ∈ W₂, fderiv ℝ Φ₂ y ≠ 0) (hzero : ∀ y ∈ W₁ ∩ W₂, (Φ₁ y = 0 ↔ Φ₂ y = 0)) (y₀ v : E3) (hy₀ : y₀ ∈ W₁ ∩ W₂) (hΦ₀ : Φ₁ y₀ = 0) (hv : fderiv ℝ Φ₁ y₀ v = 0) : fderiv ℝ Φ₂ y₀ v = 0 ∧ sprayA G Φ₂ y₀ v = sprayA G Φ₁ y₀ v :=
by
  classical
  have hy₁ : y₀ ∈ W₁ := hy₀.1
  have hy₂ : y₀ ∈ W₂ := hy₀.2
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have h112 : (1 : WithTop ℕ∞) + 1 ≤ 2 := by norm_num
  
  obtain ⟨w, hw⟩ : ∃ w, fderiv ℝ Φ₁ y₀ w ≠ 0 := by
    by_contra h
    push_neg at h
    exact hdΦ₁ y₀ hy₁ (ContinuousLinearMap.ext fun x => by simpa using h x)
  obtain ⟨u, hu⟩ : ∃ u : E3, fderiv ℝ Φ₁ y₀ u = 1 :=
    ⟨(fderiv ℝ Φ₁ y₀ w)⁻¹ • w, by rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hw]⟩
  
  have hΦ₁at : ContDiffAt ℝ ∞ Φ₁ y₀ := hΦ₁.contDiffAt (hW₁.mem_nhds hy₁)
  let F : E3 → E3 := fun y => y + (Φ₁ y - fderiv ℝ Φ₁ y₀ (y - y₀)) • u
  have hFc : ContDiffAt ℝ ∞ F y₀ := by
    have hl : ContDiffAt ℝ ∞ (fun y : E3 => fderiv ℝ Φ₁ y₀ (y - y₀)) y₀ :=
      (fderiv ℝ Φ₁ y₀).contDiff.contDiffAt.comp y₀ (contDiffAt_id.sub contDiffAt_const)
    exact contDiffAt_id.add ((hΦ₁at.sub hl).smul contDiffAt_const)
  have hF' : HasFDerivAt F ((ContinuousLinearEquiv.refl ℝ E3 : E3 ≃L[ℝ] E3) : E3 →L[ℝ] E3) y₀ := by
    have h1 : HasFDerivAt Φ₁ (fderiv ℝ Φ₁ y₀) y₀ :=
      (hΦ₁at.differentiableAt (by simp)).hasFDerivAt
    have h2 : HasFDerivAt (fun y : E3 => fderiv ℝ Φ₁ y₀ (y - y₀)) (fderiv ℝ Φ₁ y₀) y₀ := by
      have := (fderiv ℝ Φ₁ y₀).hasFDerivAt.comp y₀ ((hasFDerivAt_id y₀).sub_const y₀)
      exact this.congr_fderiv (ContinuousLinearMap.ext fun _ => by simp)
    have h3 := (hasFDerivAt_id y₀).add ((h1.sub h2).smul_const u)
    refine h3.congr_fderiv ?_
    refine ContinuousLinearMap.ext fun x => ?_
    simp
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hFy₀ : F y₀ = y₀ := by simp [F, hΦ₀]
  have hΦF : ∀ y, fderiv ℝ Φ₁ y₀ (F y - y₀) = Φ₁ y := by
    intro y
    simp only [F, map_sub, map_add, map_smul, hu, smul_eq_mul, mul_one]
    ring
  
  obtain ⟨ψ, hψc, hψd, hψ0, hψr⟩ : ∃ ψ : E3 → E3, ContDiffAt ℝ ∞ ψ y₀ ∧
      (∀ x, fderiv ℝ ψ y₀ x = x) ∧ ψ y₀ = y₀ ∧ ∀ᶠ z in 𝓝 y₀, F (ψ z) = z := by
    have hstrict := hFc.hasStrictFDerivAt' hF' hn
    refine ⟨hFc.localInverse hF' hn, ?_, ?_, ?_, ?_⟩
    · have := hFc.to_localInverse hF' hn
      rwa [hFy₀] at this
    · have := hstrict.to_localInverse
      rw [hFy₀] at this
      intro x
      rw [show hFc.localInverse hF' hn = HasStrictFDerivAt.localInverse F _ y₀ hstrict from rfl,
        this.hasFDerivAt.fderiv]
      simp
    · have := hFc.localInverse_apply_image hF' hn
      rwa [hFy₀] at this
    · have := hstrict.eventually_right_inverse
      rw [hFy₀] at this
      exact this
  have hψ2 : ContDiffAt ℝ 2 ψ y₀ := hψc.of_le h2inf
  have hψev : ∀ᶠ z in 𝓝 y₀, DifferentiableAt ℝ ψ z :=
    (hψ2.eventually (by simp)).mono fun z hz => hz.differentiableAt (by norm_num)
  have hdψ : DifferentiableAt ℝ (fderiv ℝ ψ) y₀ :=
    (hψ2.fderiv_right (m := 1) h112).differentiableAt one_ne_zero
  
  have key : ∀ (Φ : E3 → ℝ) (W : Set E3), IsOpen W → ContDiffOn ℝ ∞ Φ W → y₀ ∈ W → ∀ x : E3,
      (∀ᶠ t in 𝓝 (0:ℝ), Φ (ψ (y₀ + t • x)) = 0) →
      fderiv ℝ Φ y₀ x = 0 ∧
        fderiv ℝ (fderiv ℝ Φ) y₀ x x + fderiv ℝ Φ y₀ (fderiv ℝ (fderiv ℝ ψ) y₀ x x) = 0 := by
    intro Φ W hW hΦ hyW x hz
    have hc : ∀ t : ℝ, HasDerivAt (fun s : ℝ => y₀ + s • x) x t := by
      intro t
      simpa using ((hasDerivAt_id t).smul_const x).const_add y₀
    have hcont : Tendsto (fun s : ℝ => y₀ + s • x) (𝓝 0) (𝓝 y₀) := by
      have := (hc 0).continuousAt.tendsto
      simpa using this
    have hγcont : Tendsto (fun s : ℝ => ψ (y₀ + s • x)) (𝓝 0) (𝓝 y₀) := by
      have := hψc.continuousAt.tendsto.comp hcont
      rwa [hψ0] at this
    have hγ : ∀ᶠ t in 𝓝 (0:ℝ),
        HasDerivAt (fun s => ψ (y₀ + s • x)) (fderiv ℝ ψ (y₀ + t • x) x) t := by
      filter_upwards [hcont.eventually hψev] with t ht
      exact ht.hasFDerivAt.comp_hasDerivAt t (hc t)
    have hη : HasDerivAt (fun s : ℝ => fderiv ℝ ψ (y₀ + s • x) x)
        (fderiv ℝ (fderiv ℝ ψ) y₀ x x) 0 := by
      have h1 := hdψ.hasFDerivAt.comp_hasDerivAt_of_eq 0 (hc 0) (by simp)
      have h2 := h1.clm_apply (hasDerivAt_const (0:ℝ) x)
      refine h2.congr_deriv ?_
      simp
    have hΦd : ∀ᶠ t in 𝓝 (0:ℝ), DifferentiableAt ℝ Φ (ψ (y₀ + t • x)) := by
      filter_upwards [hγcont.eventually (hW.eventually_mem hyW)] with t ht
      exact (hΦ.contDiffAt (hW.mem_nhds ht)).differentiableAt (by simp)
    have hD0 : ∀ᶠ t in 𝓝 (0:ℝ),
        fderiv ℝ Φ (ψ (y₀ + t • x)) (fderiv ℝ ψ (y₀ + t • x) x) = 0 := by
      filter_upwards [hγ, hΦd, hz.eventually_nhds] with t h1 h2 h3
      have hA : HasDerivAt (fun s => Φ (ψ (y₀ + s • x)))
          (fderiv ℝ Φ (ψ (y₀ + t • x)) (fderiv ℝ ψ (y₀ + t • x) x)) t :=
        h2.hasFDerivAt.comp_hasDerivAt t h1
      have hB : HasDerivAt (fun s => Φ (ψ (y₀ + s • x))) 0 t :=
        (hasDerivAt_const t (0:ℝ)).congr_of_eventuallyEq h3
      exact hA.unique hB
    refine ⟨?_, ?_⟩
    · have := hD0.self_of_nhds
      simpa [hψ0, hψd] using this
    · have hdΦ' : DifferentiableAt ℝ (fderiv ℝ Φ) y₀ :=
        (((hΦ.of_le h2inf).fderiv_of_isOpen hW (m := 1) h112).contDiffAt
          (hW.mem_nhds hyW)).differentiableAt one_ne_zero
      have h1 : HasDerivAt (fun t : ℝ => fderiv ℝ Φ (ψ (y₀ + t • x)))
          (fderiv ℝ (fderiv ℝ Φ) y₀ x) 0 := by
        have := hdΦ'.hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ.self_of_nhds (by simp [hψ0])
        refine this.congr_deriv ?_
        simp [hψd]
      have hE := h1.clm_apply hη
      have hF0 : HasDerivAt
          (fun t : ℝ => fderiv ℝ Φ (ψ (y₀ + t • x)) (fderiv ℝ ψ (y₀ + t • x) x)) 0 0 :=
        (hasDerivAt_const (0:ℝ) (0:ℝ)).congr_of_eventuallyEq hD0
      have := hE.unique hF0
      simpa [hψ0, hψd] using this
  
  have hcurve : ∀ x : E3, fderiv ℝ Φ₁ y₀ x = 0 →
      (∀ᶠ t in 𝓝 (0:ℝ), Φ₁ (ψ (y₀ + t • x)) = 0) ∧
        (∀ᶠ t in 𝓝 (0:ℝ), Φ₂ (ψ (y₀ + t • x)) = 0) := by
    intro x hx
    have hcont : Tendsto (fun s : ℝ => y₀ + s • x) (𝓝 0) (𝓝 y₀) := by
      have : Continuous (fun s : ℝ => y₀ + s • x) := by fun_prop
      simpa using this.tendsto 0
    have hγcont : Tendsto (fun s : ℝ => ψ (y₀ + s • x)) (𝓝 0) (𝓝 y₀) := by
      have := hψc.continuousAt.tendsto.comp hcont
      rwa [hψ0] at this
    have h1 : ∀ᶠ t in 𝓝 (0:ℝ), Φ₁ (ψ (y₀ + t • x)) = 0 := by
      filter_upwards [hcont.eventually hψr] with t ht
      have := hΦF (ψ (y₀ + t • x))
      rw [ht] at this
      rw [← this]
      simp [hx]
    have hW12 : ∀ᶠ t in 𝓝 (0:ℝ), ψ (y₀ + t • x) ∈ W₁ ∩ W₂ :=
      hγcont.eventually ((hW₁.inter hW₂).eventually_mem hy₀)
    refine ⟨h1, ?_⟩
    filter_upwards [h1, hW12] with t ht hw
    exact (hzero _ hw).1 ht
  
  have hker : ∀ x, fderiv ℝ Φ₁ y₀ x = 0 → fderiv ℝ Φ₂ y₀ x = 0 := fun x hx =>
    (key Φ₂ W₂ hW₂ hΦ₂ hy₂ x (hcurve x hx).2).1
  obtain ⟨c, hprop⟩ : ∃ c : ℝ, ∀ x, fderiv ℝ Φ₂ y₀ x = c * fderiv ℝ Φ₁ y₀ x := by
    refine ⟨fderiv ℝ Φ₂ y₀ u, fun x => ?_⟩
    have h := hker (x - (fderiv ℝ Φ₁ y₀ x) • u)
      (by rw [map_sub, map_smul, hu, smul_eq_mul, mul_one, sub_self])
    rw [map_sub, map_smul, smul_eq_mul, sub_eq_zero] at h
    rw [h, mul_comm]
  have hc0 : c ≠ 0 := by
    intro hc
    apply hdΦ₂ y₀ hy₂
    refine ContinuousLinearMap.ext fun x => ?_
    simp [hprop x, hc]
  
  have k1 := (key Φ₁ W₁ hW₁ hΦ₁ hy₁ v (hcurve v hv).1).2
  have k2 := (key Φ₂ W₂ hW₂ hΦ₂ hy₂ v (hcurve v hv).2).2
  rw [hprop (fderiv ℝ (fderiv ℝ ψ) y₀ v v)] at k2
  have hB : fderiv ℝ (fderiv ℝ Φ₂) y₀ v v = c * fderiv ℝ (fderiv ℝ Φ₁) y₀ v v := by
    linear_combination k2 - c * k1
  
  have hquad : ∀ (Φ : E3 → ℝ), DifferentiableAt ℝ (fderiv ℝ Φ) y₀ →
      ∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (partialDeriv j Φ) y₀ * v i * v j =
        fderiv ℝ (fderiv ℝ Φ) y₀ v v := by
    intro Φ hd
    have h41 : ∀ i j, partialDeriv i (partialDeriv j Φ) y₀ =
        fderiv ℝ (fderiv ℝ Φ) y₀ (e i) (e j) := by
      intro i j
      have h : HasFDerivAt (fun z => fderiv ℝ Φ z (e j))
          ((fderiv ℝ Φ y₀).comp (0 : E3 →L[ℝ] E3) + (fderiv ℝ (fderiv ℝ Φ) y₀).flip (e j)) y₀ :=
        hd.hasFDerivAt.clm_apply (hasFDerivAt_const (e j) y₀)
      show fderiv ℝ (fun z => fderiv ℝ Φ z (e j)) y₀ (e i) = _
      rw [h.fderiv]
      simp
    have hv_exp : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    simp only [h41, Fin.sum_univ_three]
    conv_rhs => rw [hv_exp]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    ring
  have hdd : ∀ (Φ : E3 → ℝ) (W : Set E3), IsOpen W → ContDiffOn ℝ ∞ Φ W → y₀ ∈ W →
      DifferentiableAt ℝ (fderiv ℝ Φ) y₀ := fun Φ W hW hΦ hyW =>
    (((hΦ.of_le h2inf).fderiv_of_isOpen hW (m := 1) h112).contDiffAt
      (hW.mem_nhds hyW)).differentiableAt one_ne_zero
  have hd : ∀ k, partialDeriv k Φ₂ y₀ = c * partialDeriv k Φ₁ y₀ := fun k => hprop (e k)
  have hsplit : ∀ Φ : E3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ i j y₀ * v i * v j =
      ∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (partialDeriv j Φ) y₀ * v i * v j -
        ∑ i : Fin 3, ∑ j : Fin 3,
          (∑ k : Fin 3, christoffel G k i j y₀ * partialDeriv k Φ y₀) * v i * v j := by
    intro Φ
    simp only [hessLoc, sub_mul, Finset.sum_sub_distrib]
  have hH : ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ₂ i j y₀ * v i * v j =
      c * ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ₁ i j y₀ * v i * v j := by
    rw [hsplit, hsplit, hquad Φ₁ (hdd Φ₁ W₁ hW₁ hΦ₁ hy₁), hquad Φ₂ (hdd Φ₂ W₂ hW₂ hΦ₂ hy₂), hB,
      mul_sub]
    congr 1
    simp only [hd, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    simp only [Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  have hN : ∑ a : Fin 3, ∑ b : Fin 3, (G y₀)⁻¹ a b * partialDeriv a Φ₂ y₀ * partialDeriv b Φ₂ y₀ =
      c ^ 2 * ∑ a : Fin 3, ∑ b : Fin 3,
        (G y₀)⁻¹ a b * partialDeriv a Φ₁ y₀ * partialDeriv b Φ₁ y₀ := by
    simp only [hd, Finset.mul_sum]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    ring
  have hfun : (fun k => ∑ l : Fin 3, (G y₀)⁻¹ k l * partialDeriv l Φ₂ y₀) =
      c • (fun k => ∑ l : Fin 3, (G y₀)⁻¹ k l * partialDeriv l Φ₁ y₀) := by
    funext k
    simp only [hd, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  have hX : (EuclideanSpace.equiv (Fin 3) ℝ).symm
        (fun k => ∑ l : Fin 3, (G y₀)⁻¹ k l * partialDeriv l Φ₂ y₀) =
      c • (EuclideanSpace.equiv (Fin 3) ℝ).symm
        (fun k => ∑ l : Fin 3, (G y₀)⁻¹ k l * partialDeriv l Φ₁ y₀) := by
    rw [hfun, map_smul]
  have hs : ∀ H N : ℝ, c * H / (c ^ 2 * N) * c = H / N := by
    intro H N
    rw [div_mul_eq_mul_div, show c * H * c = c ^ 2 * H by ring,
      mul_div_mul_left _ _ (pow_ne_zero 2 hc0)]
  refine ⟨hker v hv, ?_⟩
  unfold sprayA
  rw [hH, hN, hX, smul_smul, hs]

theorem minimal_set_chart_cover [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig) : IsCompact {y : E3 | y ∈ Metric.closedBall (chartAt E3 z z) (3 * r) ∧ (chartAt E3 z).symm y ∈ Sig} ∧ ∃ (N : ℕ) (W : Fin N → Set E3) (Φ : Fin N → E3 → ℝ), (∀ i, IsOpen (W i) ∧ W i ⊆ Metric.ball (chartAt E3 z z) (4 * r) ∧ ContDiffOn ℝ ∞ (Φ i) (W i) ∧ (∀ y ∈ W i, fderiv ℝ (Φ i) y ≠ 0) ∧ ∀ y ∈ W i, (Φ i y = 0 ↔ (chartAt E3 z).symm y ∈ Sig)) ∧ ∀ y ∈ Metric.closedBall (chartAt E3 z z) (3 * r), (chartAt E3 z).symm y ∈ Sig → ∃ i, y ∈ W i :=
by
  have hB3t : Metric.closedBall (chartAt E3 z z) (3 * r) ⊆ (chartAt E3 z).target :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball
  have hK : IsCompact {y : E3 | y ∈ Metric.closedBall (chartAt E3 z z) (3 * r) ∧
      (chartAt E3 z).symm y ∈ Sig} := by
    have hcl : IsClosed (Metric.closedBall (chartAt E3 z z) (3 * r) ∩ (chartAt E3 z).symm ⁻¹' Sig) :=
      ((chartAt E3 z).continuousOn_symm.mono hB3t).preimage_isClosed_of_isClosed
        Metric.isClosed_closedBall hSm.1
    exact (isCompact_closedBall (chartAt E3 z z) (3 * r)).of_isClosed_subset hcl
      Set.inter_subset_left
  have hloc : ∀ y ∈ Metric.closedBall (chartAt E3 z z) (3 * r), (chartAt E3 z).symm y ∈ Sig →
      ∃ (W : Set E3) (Φ : E3 → ℝ), IsOpen W ∧ y ∈ W ∧ W ⊆ Metric.ball (chartAt E3 z z) (4 * r) ∧
        ContDiffOn ℝ ∞ Φ W ∧ (∀ y' ∈ W, fderiv ℝ Φ y' ≠ 0) ∧
        ∀ y' ∈ W, (Φ y' = 0 ↔ (chartAt E3 z).symm y' ∈ Sig) := by
    intro y hy hyS
    have hyB : y ∈ Metric.ball (chartAt E3 z z) (4 * r) :=
      Metric.closedBall_subset_ball (by linarith) hy
    have hyt : y ∈ (chartAt E3 z).target := hB3t hy
    have hOo : IsOpen ((chartAt E3 z).source ∩ (chartAt E3 z) ⁻¹' Metric.ball (chartAt E3 z z) (4 * r)) :=
      (chartAt E3 z).isOpen_inter_preimage Metric.isOpen_ball
    have hpO : (chartAt E3 z).symm y ∈
        (chartAt E3 z).source ∩ (chartAt E3 z) ⁻¹' Metric.ball (chartAt E3 z z) (4 * r) := by
      refine ⟨(chartAt E3 z).map_target hyt, ?_⟩
      show (chartAt E3 z) ((chartAt E3 z).symm y) ∈ Metric.ball (chartAt E3 z z) (4 * r)
      rw [(chartAt E3 z).right_inv hyt]
      exact hyB
    obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, -⟩ := hSm.2 _ hyS _ (hOo.mem_nhds hpO)
    have hsm : ContDiffOn ℝ ∞ (fun y' => f ((chartAt E3 z).symm y')) (chartAt E3 z).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 z).symm) (chartAt E3 z).target :=
        hf.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have hfd : ∀ y' ∈ (chartAt E3 z).target,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f ((chartAt E3 z).symm y') ≠ 0 →
        fderiv ℝ (fun y'' => f ((chartAt E3 z).symm y'')) y' ≠ 0 := by
      intro y' hy' hd h0
      apply hd
      have hxs : (chartAt E3 z).symm y' ∈ (chartAt E3 z).source := (chartAt E3 z).map_target hy'
      have hκx : chartAt E3 z ((chartAt E3 z).symm y') = y' := (chartAt E3 z).right_inv hy'
      have hev : f =ᶠ[𝓝 ((chartAt E3 z).symm y')]
          (fun y'' => f ((chartAt E3 z).symm y'')) ∘ (chartAt E3 z) := by
        filter_upwards [(chartAt E3 z).open_source.mem_nhds hxs] with w hw
        simp only [Function.comp, (chartAt E3 z).left_inv hw]
      have hc : ContDiffAt ℝ ∞ (fun y'' => f ((chartAt E3 z).symm y'')) y' :=
        hsm.contDiffAt ((chartAt E3 z).open_target.mem_nhds hy')
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y'' => f ((chartAt E3 z).symm y''))
          (chartAt E3 z ((chartAt E3 z).symm y')) := by
        rw [hκx]
        exact (hc.differentiableAt (by simp)).mdifferentiableAt
      have hκ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z) ((chartAt E3 z).symm y') :=
        mdifferentiableAt_atlas (chart_mem_atlas E3 z) hxs
      have hz : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y'' => f ((chartAt E3 z).symm y''))
          (chartAt E3 z ((chartAt E3 z).symm y')) = 0 := by
        rw [mfderiv_eq_fderiv, hκx]
        exact h0
      rw [hev.mfderiv_eq, mfderiv_comp _ hg hκ, hz]
      exact ContinuousLinearMap.zero_comp _
    refine ⟨(chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V, fun y' => f ((chartAt E3 z).symm y'),
      (chartAt E3 z).isOpen_inter_preimage_symm hVo, ⟨hyt, hpV⟩, ?_,
      hsm.mono Set.inter_subset_left, ?_, ?_⟩
    · rintro y' ⟨hy't, hy'V⟩
      have h : (chartAt E3 z) ((chartAt E3 z).symm y') ∈ Metric.ball (chartAt E3 z z) (4 * r) :=
        (hVO hy'V).2
      rwa [(chartAt E3 z).right_inv hy't] at h
    · rintro y' ⟨hy't, hy'V⟩
      exact hfd y' hy't (hdf _ hy'V)
    · rintro y' ⟨_, hy'V⟩
      constructor
      · intro h0
        have h1 : (chartAt E3 z).symm y' ∈ V ∩ f ⁻¹' {0} := ⟨hy'V, h0⟩
        rw [← hVS] at h1
        exact h1.2
      · intro hS
        have h1 : (chartAt E3 z).symm y' ∈ V ∩ Sig := ⟨hy'V, hS⟩
        rw [hVS] at h1
        exact h1.2
  refine ⟨hK, ?_⟩
  choose! Wp Φp hWp using hloc
  obtain ⟨t, htK, htcov⟩ := hK.elim_nhds_subcover Wp
    (fun y hy => (hWp y hy.1 hy.2).1.mem_nhds (hWp y hy.1 hy.2).2.1)
  refine ⟨t.card, fun i => Wp (t.equivFin.symm i : E3), fun i => Φp (t.equivFin.symm i : E3),
    ?_, ?_⟩
  · intro i
    obtain ⟨hi1, hi2⟩ := htK _ (t.equivFin.symm i).2
    obtain ⟨h1, -, h3, h4, h5, h6⟩ := hWp _ hi1 hi2
    exact ⟨h1, h3, h4, h5, h6⟩
  · intro y hy hyS
    have hyc := htcov ⟨hy, hyS⟩
    obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.1 hyc
    refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hyx

theorem surface_spray_field (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (c : E3) (r : ℝ) (hr : 0 < r) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball c (4 * r))) (hGpd : ∀ y ∈ Metric.ball c (4 * r), (G y).PosDef) {N : ℕ} (W : Fin N → Set E3) (Φ : Fin N → E3 → ℝ) (hW : ∀ i, IsOpen (W i) ∧ W i ⊆ Metric.ball c (4 * r)) (hΦ : ∀ i, ContDiffOn ℝ ∞ (Φ i) (W i)) (hdΦ : ∀ i, ∀ y ∈ W i, fderiv ℝ (Φ i) y ≠ 0) (s : Set E3) (hs : IsCompact s) (hsW : s ⊆ ⋃ i, W i) : ∃ (ψ : Fin N → E3 → ℝ) (X : E3 × E3 → E3 × E3), (∀ i y, 0 ≤ ψ i y) ∧ (∀ y ∈ s, ∑ i, ψ i y = 1) ∧ (∀ i y, ψ i y ≠ 0 → y ∈ W i) ∧ ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ ∀ y ∈ Metric.closedBall c (3 * r), ∀ v : E3, ‖v‖ ≤ r → X (y, v) = (v, sprayQ G Φ ψ y v) :=
by
  have hBo : IsOpen (Metric.ball c (4 * r)) := Metric.isOpen_ball
  
  have hdet : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) (Metric.ball c (4 * r))) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) (Metric.ball c (4 * r)) := by
    intro H hH
    have h1 : ContDiffOn ℝ ∞ (fun y => ∑ σ : Equiv.Perm (Fin 3),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ k, H y (σ k) k) (Metric.ball c (4 * r)) :=
      ContDiffOn.sum fun σ _ => contDiffOn_const.mul (contDiffOn_prod fun k _ => hH (σ k) k)
    refine h1.congr ?_
    intro y _
    exact Matrix.det_apply' (H y)
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j)
      (Metric.ball c (4 * r)) := by
    intro i j
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow j (Pi.single i 1)).det)
        (Metric.ball c (4 * r)) := by
      apply hdet (fun y => (G y).updateRow j (Pi.single i 1))
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine h2.congr ?_
    intro y _
    exact Matrix.adjugate_apply (G y) i j
  have hne : ∀ y ∈ Metric.ball c (4 * r), (G y).det ≠ 0 :=
    fun y hy => (hGpd y hy).det_pos.ne'
  have hGinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) (Metric.ball c (4 * r)) := by
    intro i j
    have h3 : ContDiffOn ℝ ∞ (fun y => ((G y).det)⁻¹ * (G y).adjugate i j)
        (Metric.ball c (4 * r)) :=
      ((hdet G hG).inv hne).mul (hadj i j)
    refine h3.congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
  
  have hpd : ∀ (U : Set E3), IsOpen U → ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ a : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv a f) U := by
    intro U hU f hf a
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y (e a)) U
    exact (hf.fderiv_of_isOpen hU (by simp)).clm_apply contDiffOn_const
  
  have hΓ : ∀ k a b : Fin 3, ContDiffOn ℝ ∞ (christoffel G k a b) (Metric.ball c (4 * r)) := by
    intro k a b
    have hP : ∀ x y z : Fin 3, ContDiffOn ℝ ∞ (partialDeriv x (fun w => G w y z))
        (Metric.ball c (4 * r)) :=
      fun x y z => hpd _ hBo _ (hG y z) x
    have h4 : ContDiffOn ℝ ∞ (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv a (fun z => G z b l) y + partialDeriv b (fun z => G z a l) y
          - partialDeriv l (fun z => G z a b) y)) (Metric.ball c (4 * r)) :=
      contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hGinv k l).mul
        (((hP a b l).add (hP b a l)).sub (hP l a b)))
    exact h4
  
  have hHess : ∀ i : Fin N, ∀ a b : Fin 3, ContDiffOn ℝ ∞ (hessLoc G (Φ i) a b) (W i) := by
    intro i a b
    have hΓW : ∀ k a b : Fin 3, ContDiffOn ℝ ∞ (christoffel G k a b) (W i) :=
      fun k a b => (hΓ k a b).mono (hW i).2
    have h1 : ∀ x : Fin 3, ContDiffOn ℝ ∞ (partialDeriv x (Φ i)) (W i) :=
      fun x => hpd _ (hW i).1 _ (hΦ i) x
    have h2 : ContDiffOn ℝ ∞ (partialDeriv a (partialDeriv b (Φ i))) (W i) :=
      hpd _ (hW i).1 _ (h1 b) a
    unfold hessLoc
    exact h2.sub (ContDiffOn.sum fun k _ => (hΓW k a b).mul (h1 k))
  
  have hcoord : ∀ a : Fin 3, ContDiff ℝ ∞ (fun p : E3 × E3 => p.2 a) :=
    fun a => ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff).comp contDiff_snd
  have hfst : ∀ (U : Set E3) (f : E3 → ℝ), ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (fun p : E3 × E3 => f p.1) (U ×ˢ (Set.univ : Set E3)) :=
    fun U f hf => hf.comp contDiff_fst.contDiffOn (fun p hp => hp.1)
  have hvec : ∀ (S : Set (E3 × E3)) (F : Fin 3 → E3 × E3 → ℝ),
      (∀ k, ContDiffOn ℝ ∞ (F k) S) →
      ContDiffOn ℝ ∞ (fun p => (EuclideanSpace.equiv (Fin 3) ℝ).symm (fun k => F k p)) S := by
    intro S F hF
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp_contDiffOn (contDiffOn_pi.2 hF)
  
  have hGam : ContDiffOn ℝ ∞ (fun p : E3 × E3 => sprayGam G p.1 p.2)
      (Metric.ball c (4 * r) ×ˢ Set.univ) := by
    unfold sprayGam
    refine hvec _ (fun k p => ∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b p.1 * p.2 a * p.2 b) ?_
    intro k
    exact ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
      ((hfst _ _ (hΓ k a b)).mul (hcoord a).contDiffOn).mul (hcoord b).contDiffOn
  
  have hNpos : ∀ i : Fin N, ∀ y ∈ W i, 0 < ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv a (Φ i) y * partialDeriv b (Φ i) y := by
    intro i y hy
    have hd0 : (fun a : Fin 3 => partialDeriv a (Φ i) y) ≠ 0 := by
      intro h0
      apply hdΦ i y hy
      apply ContinuousLinearMap.ext
      intro u
      have h0' : ∀ a : Fin 3, fderiv ℝ (Φ i) y (e a) = 0 := fun a => congrFun h0 a
      have hu' : u = u 0 • e 0 + u 1 • e 1 + u 2 • e 2 := by
        ext j; fin_cases j <;> simp [EuclideanSpace.single_apply]
      rw [hu']
      simp only [map_add, map_smul, h0', smul_zero, add_zero, ContinuousLinearMap.zero_apply]
    have hpos := (hGpd y ((hW i).2 hy)).inv.dotProduct_mulVec_pos hd0
    simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum] at hpos
    refine lt_of_lt_of_eq hpos ?_
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    ring
  
  have hA : ∀ i : Fin N, ContDiffOn ℝ ∞ (fun p : E3 × E3 => sprayA G (Φ i) p.1 p.2)
      (W i ×ˢ Set.univ) := by
    intro i
    have hWo := (hW i).1
    have h1 : ∀ x : Fin 3, ContDiffOn ℝ ∞ (partialDeriv x (Φ i)) (W i) :=
      fun x => hpd _ hWo _ (hΦ i) x
    have hGiW : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ a b) (W i) :=
      fun a b => (hGinv a b).mono (hW i).2
    have hH : ContDiffOn ℝ ∞ (fun p : E3 × E3 =>
        ∑ a : Fin 3, ∑ b : Fin 3, hessLoc G (Φ i) a b p.1 * p.2 a * p.2 b) (W i ×ˢ Set.univ) :=
      ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
        ((hfst _ _ (hHess i a b)).mul (hcoord a).contDiffOn).mul (hcoord b).contDiffOn
    have hNs : ContDiffOn ℝ ∞ (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ a b * partialDeriv a (Φ i) y * partialDeriv b (Φ i) y) (W i) :=
      ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ => ((hGiW a b).mul (h1 a)).mul (h1 b)
    have hq : ContDiffOn ℝ ∞ (fun p : E3 × E3 =>
        (∑ a : Fin 3, ∑ b : Fin 3, hessLoc G (Φ i) a b p.1 * p.2 a * p.2 b) /
          (∑ a : Fin 3, ∑ b : Fin 3,
            (G p.1)⁻¹ a b * partialDeriv a (Φ i) p.1 * partialDeriv b (Φ i) p.1))
        (W i ×ˢ Set.univ) :=
      hH.div (hfst _ _ hNs) (fun p hp => (hNpos i p.1 hp.1).ne')
    have hv : ContDiffOn ℝ ∞ (fun p : E3 × E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm
        (fun k => ∑ l : Fin 3, (G p.1)⁻¹ k l * partialDeriv l (Φ i) p.1)) (W i ×ˢ Set.univ) :=
      hvec _ (fun k p => ∑ l : Fin 3, (G p.1)⁻¹ k l * partialDeriv l (Φ i) p.1) (fun k =>
        hfst _ _ (ContDiffOn.sum fun l _ => (hGiW k l).mul (h1 l)))
    exact hq.smul hv
  
  have hext : ∀ (h : E3 → ℝ), ContDiff ℝ ∞ h → ∀ (U : Set E3), IsOpen U → tsupport h ⊆ U →
      ∀ (P : E3 × E3 → E3), ContDiffOn ℝ ∞ P (U ×ˢ Set.univ) →
      ContDiff ℝ ∞ (fun p : E3 × E3 => h p.1 • P p) := by
    intro h hh U hU hsupp P hP
    rw [contDiff_iff_contDiffAt]
    intro p
    by_cases hp : p.1 ∈ U
    · exact ((hh.comp contDiff_fst).contDiffAt).smul
        (hP.contDiffAt ((hU.prod isOpen_univ).mem_nhds ⟨hp, Set.mem_univ _⟩))
    · have h0 : h =ᶠ[𝓝 p.1] 0 := notMem_tsupport_iff_eventuallyEq.1 (fun h' => hp (hsupp h'))
      have h1 : ∀ᶠ q in 𝓝 p, h q.1 = (0 : E3 → ℝ) q.1 := (continuous_fst.tendsto p).eventually h0
      have h2 : (fun q : E3 × E3 => h q.1 • P q) =ᶠ[𝓝 p] fun _ => (0 : E3) := by
        filter_upwards [h1] with q hq
        rw [hq, Pi.zero_apply, zero_smul]
      exact contDiffAt_const.congr_of_eventuallyEq h2
  
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate (I := 𝓘(ℝ, E3)) hs.isClosed W
    (fun i => (hW i).1) hsW
  have hψs : ∀ i, ContDiff ℝ ∞ (fun y => f i y) := fun i => contMDiff_iff_contDiff.1 (f i).contMDiff
  have hψ0 : ∀ i y, 0 ≤ f i y := fun i y => f.nonneg i y
  have hψ1 : ∀ y ∈ s, ∑ i, f i y = 1 := by
    intro y hy
    have := f.sum_eq_one hy
    rwa [finsum_eq_sum_of_fintype] at this
  have hψW : ∀ i, tsupport (fun y => f i y) ⊆ W i := fun i => hf i
  
  let χ : ContDiffBump c := ⟨3 * r, 7 * r / 2, by positivity, by linarith⟩
  let β : ContDiffBump (0 : E3) := ⟨r, 2 * r, hr, by linarith⟩
  have hχs : ContDiff ℝ ∞ χ := χ.contDiff
  have hβs : ContDiff ℝ ∞ β := β.contDiff
  have hχB : tsupport χ ⊆ Metric.ball c (4 * r) := by
    rw [χ.tsupport_eq]
    exact Metric.closedBall_subset_ball (by show 7 * r / 2 < 4 * r; linarith)
  have hT0 : ContDiff ℝ ∞ (fun p : E3 × E3 => χ p.1 • sprayGam G p.1 p.2) :=
    hext χ hχs _ hBo hχB (fun p => sprayGam G p.1 p.2) hGam
  have hTi : ∀ i, ContDiff ℝ ∞ (fun p : E3 × E3 => f i p.1 • sprayA G (Φ i) p.1 p.2) :=
    fun i => hext (fun y => f i y) (hψs i) (W i) (hW i).1 (hψW i) _ (hA i)
  refine ⟨fun i y => f i y, fun p => (χ p.1 * β p.2) • (p.2, sprayQ G Φ (fun i y => f i y) p.1 p.2),
    hψ0, hψ1, ?_, ?_, ?_, ?_⟩
  · intro i y hy
    exact hψW i (subset_tsupport _ (Function.mem_support.2 hy))
  · have hXeq : (fun p : E3 × E3 => (χ p.1 * β p.2) • (p.2, sprayQ G Φ (fun i y => f i y) p.1 p.2)) =
        fun p => ((χ p.1 * β p.2) • p.2, -(β p.2 • (χ p.1 • sprayGam G p.1 p.2)) -
          ∑ i, (χ p.1 * β p.2) • (f i p.1 • sprayA G (Φ i) p.1 p.2)) := by
      funext p
      simp only [Prod.smul_mk, sprayQ]
      congr 1
      rw [smul_sub, smul_neg, Finset.smul_sum, smul_smul (β p.2), mul_comm (β p.2)]
    rw [hXeq]
    have hcb : ContDiff ℝ ∞ (fun p : E3 × E3 => χ p.1 * β p.2) :=
      (hχs.comp contDiff_fst).mul (hβs.comp contDiff_snd)
    refine (hcb.smul contDiff_snd).prodMk ?_
    refine (((hβs.comp contDiff_snd).smul hT0).neg).sub ?_
    exact ContDiff.sum fun i _ => hcb.smul (hTi i)
  · refine HasCompactSupport.intro ((isCompact_closedBall c (7 * r / 2)).prod
      (isCompact_closedBall (0 : E3) (2 * r))) ?_
    intro p hp
    have hz : χ p.1 * β p.2 = 0 := by
      rw [Set.mem_prod, not_and_or] at hp
      rcases hp with h1 | h1
      · have h3 : χ p.1 = 0 := by
          rw [← Function.notMem_support, χ.support_eq]
          exact fun h' => h1 (Metric.ball_subset_closedBall h')
        rw [h3, zero_mul]
      · have h3 : β p.2 = 0 := by
          rw [← Function.notMem_support, β.support_eq]
          exact fun h' => h1 (Metric.ball_subset_closedBall h')
        rw [h3, mul_zero]
    show (χ p.1 * β p.2) • (p.2, sprayQ G Φ (fun i y => f i y) p.1 p.2) = 0
    rw [hz, zero_smul]
  · intro y hy v hv
    have h1 : χ y = 1 := χ.one_of_mem_closedBall hy
    have h2 : β v = 1 := β.one_of_mem_closedBall (mem_closedBall_zero_iff.2 hv)
    show (χ y * β v) • (v, sprayQ G Φ (fun i y => f i y) y v) = (v, sprayQ G Φ (fun i y => f i y) y v)
    rw [h1, h2, one_mul, one_smul]

theorem local_spray_invariant (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W : Set E3) (hW : IsOpen W) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) W) (hGs : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpd : ∀ y ∈ W, (G y).PosDef) (Φ : E3 → ℝ) (hΦ : ContDiffOn ℝ ∞ Φ W) (hdΦ : ∀ y ∈ W, fderiv ℝ Φ y ≠ 0) (y₀ v₀ : E3) (hy₀ : y₀ ∈ W) (hΦ₀ : Φ y₀ = 0) (hv₀ : fderiv ℝ Φ y₀ v₀ = 0) : ∃ (ε : ℝ) (ζ : ℝ → E3 × E3), 0 < ε ∧ ζ 0 = (y₀, v₀) ∧ ∀ t ∈ Set.Ioo (-ε) ε, HasDerivAt ζ ((ζ t).2, -sprayGam G (ζ t).1 (ζ t).2 - sprayA G Φ (ζ t).1 (ζ t).2) t ∧ (ζ t).1 ∈ W ∧ Φ (ζ t).1 = 0 ∧ fderiv ℝ Φ (ζ t).1 (ζ t).2 = 0 ∧ ∑ k : Fin 3, ∑ l : Fin 3, (ζ t).2 k * G (ζ t).1 k l * (ζ t).2 l = ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l :=
by
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have h112 : (1 : WithTop ℕ∞) + 1 ≤ 2 := by norm_num
  
  have hsymm_apply : ∀ (f : Fin 3 → ℝ) (k : Fin 3),
      (EuclideanSpace.equiv (Fin 3) ℝ).symm f k = f k := fun f k => by simp
  have hsmul_apply : ∀ (c : ℝ) (v : E3) (k : Fin 3), (c • v) k = c * v k := fun c v k => by simp
  have hsub_apply : ∀ (v w : E3) (k : Fin 3), (v - w) k = v k - w k := fun v w k => by simp
  have hneg_apply : ∀ (v : E3) (k : Fin 3), (-v) k = -v k := fun v k => by simp
  
  have hlin : ∀ (L : E3 →L[ℝ] ℝ) (u : E3), L u = ∑ m : Fin 3, L (e m) * u m := by
    intro L u
    have hu : u = u 0 • e 0 + u 1 • e 1 + u 2 • e 2 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    conv_lhs => rw [hu]
    simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_three]
    ring
  
  obtain ⟨N, hN⟩ : ∃ N : E3 → ℝ, N = fun y =>
      ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y := ⟨_, rfl⟩
  have hNe : ∀ y, N y =
      ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y :=
    fun y => by rw [hN]
  obtain ⟨H, hH⟩ : ∃ H : E3 → E3 → ℝ, H = fun y v =>
      ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ i j y * v i * v j := ⟨_, rfl⟩
  have hHe : ∀ y v, H y v = ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ i j y * v i * v j :=
    fun y v => by rw [hH]
  have hsA : ∀ (y v : E3) (k : Fin 3),
      sprayA G Φ y v k = H y v / N y * ∑ l : Fin 3, (G y)⁻¹ k l * partialDeriv l Φ y := by
    intro y v k
    simp only [sprayA, hsmul_apply, hsymm_apply, hNe, hHe]
  have hsG : ∀ (y v : E3) (k : Fin 3),
      sprayGam G y v k = ∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b y * v a * v b := by
    intro y v k
    simp only [sprayGam, hsymm_apply]
  
  
  have hNpos : ∀ y ∈ W, 0 < N y := by
    intro y hy
    rw [hNe]
    have hξ : (fun a : Fin 3 => partialDeriv a Φ y) ≠ 0 := by
      intro h
      apply hdΦ y hy
      refine ContinuousLinearMap.ext fun u => ?_
      rw [hlin (fderiv ℝ Φ y) u]
      have h' : ∀ m : Fin 3, fderiv ℝ Φ y (e m) = 0 := fun m => congrFun h m
      simp [h']
    have h := (hGpd y hy).inv.dotProduct_mulVec_pos hξ
    simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum] at h
    refine lt_of_lt_of_eq h (Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_)
    ring
  
  
  have hGinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) W := by
    have hdetK : ∀ K : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => K y a b) W) →
        ContDiffOn ℝ ∞ (fun y => (K y).det) W := by
      intro K hK
      have h1 : ContDiffOn ℝ ∞ (fun y => ∑ σ : Equiv.Perm (Fin 3),
          ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ k, K y (σ k) k) W :=
        ContDiffOn.sum fun σ _ => contDiffOn_const.mul (contDiffOn_prod fun k _ => hK (σ k) k)
      refine h1.congr ?_
      intro y _
      exact Matrix.det_apply' (K y)
    have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) W := by
      intro i j
      have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow j (Pi.single i 1)).det) W := by
        apply hdetK (fun y => (G y).updateRow j (Pi.single i 1))
        intro a b
        by_cases hab : a = j
        · subst hab
          simp only [Matrix.updateRow_self]
          exact contDiffOn_const
        · simp only [Matrix.updateRow_ne hab]
          exact hG a b
      refine h2.congr ?_
      intro y _
      exact Matrix.adjugate_apply (G y) i j
    have hne : ∀ y ∈ W, (G y).det ≠ 0 := fun y hy => (hGpd y hy).det_pos.ne'
    intro i j
    have h3 : ContDiffOn ℝ ∞ (fun y => ((G y).det)⁻¹ * (G y).adjugate i j) W :=
      ((hdetK G hG).inv hne).mul (hadj i j)
    refine h3.congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
  
  
  have hPd : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f W → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv i f y) W := by
    intro f hf i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) W := ((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hf).2
    exact h1.clm_apply contDiffOn_const
  have hpΦ : ∀ l : Fin 3, ContDiffOn ℝ ∞ (fun y => partialDeriv l Φ y) W := hPd Φ hΦ
  have hchr : ∀ k a b : Fin 3, ContDiffOn ℝ ∞ (fun y => christoffel G k a b y) W := by
    intro k a b
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hGinv k l).mul
      (((hPd _ (hG b l) a).add (hPd _ (hG a l) b)).sub (hPd _ (hG a b) l)))
  have hhess : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => hessLoc G Φ i j y) W := by
    intro i j
    unfold hessLoc
    exact (hPd _ (hpΦ j) i).sub (ContDiffOn.sum fun k _ => (hchr k i j).mul (hpΦ k))
  
  
  have hy₀W : W ∈ 𝓝 y₀ := hW.mem_nhds hy₀
  have hca : ∀ c : E3 → ℝ, ContDiffOn ℝ ∞ c W →
      ContDiffAt ℝ ∞ (fun p : E3 × E3 => c p.1) (y₀, v₀) :=
    fun c hc => (hc.contDiffAt hy₀W).comp (y₀, v₀) contDiffAt_fst
  have hco : ∀ a : Fin 3, ContDiffAt ℝ ∞ (fun p : E3 × E3 => p.2 a) (y₀, v₀) := fun a =>
    ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp contDiff_snd).contDiffAt
  have hGam : ContDiffAt ℝ ∞ (fun p : E3 × E3 => sprayGam G p.1 p.2) (y₀, v₀) := by
    have h : ContDiffAt ℝ ∞ (fun p : E3 × E3 => fun k : Fin 3 =>
        ∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b p.1 * p.2 a * p.2 b) (y₀, v₀) :=
      contDiffAt_pi.2 fun k => ContDiffAt.sum fun a _ => ContDiffAt.sum fun b _ =>
        ((hca _ (hchr k a b)).mul (hco a)).mul (hco b)
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.contDiffAt.comp (y₀, v₀) h
  have hAc : ContDiffAt ℝ ∞ (fun p : E3 × E3 => sprayA G Φ p.1 p.2) (y₀, v₀) := by
    have hNc : ContDiffAt ℝ ∞ (fun p : E3 × E3 =>
        ∑ a : Fin 3, ∑ b : Fin 3, (G p.1)⁻¹ a b * partialDeriv a Φ p.1 * partialDeriv b Φ p.1)
        (y₀, v₀) :=
      ContDiffAt.sum fun a _ => ContDiffAt.sum fun b _ =>
        ((hca _ (hGinv a b)).mul (hca _ (hpΦ a))).mul (hca _ (hpΦ b))
    have hHc : ContDiffAt ℝ ∞ (fun p : E3 × E3 =>
        ∑ i : Fin 3, ∑ j : Fin 3, hessLoc G Φ i j p.1 * p.2 i * p.2 j) (y₀, v₀) :=
      ContDiffAt.sum fun i _ => ContDiffAt.sum fun j _ =>
        ((hca _ (hhess i j)).mul (hco i)).mul (hco j)
    have hnc : ContDiffAt ℝ ∞ (fun p : E3 × E3 => (EuclideanSpace.equiv (Fin 3) ℝ).symm
        (fun k => ∑ l : Fin 3, (G p.1)⁻¹ k l * partialDeriv l Φ p.1)) (y₀, v₀) := by
      have h : ContDiffAt ℝ ∞ (fun p : E3 × E3 => fun k : Fin 3 =>
          ∑ l : Fin 3, (G p.1)⁻¹ k l * partialDeriv l Φ p.1) (y₀, v₀) :=
        contDiffAt_pi.2 fun k => ContDiffAt.sum fun l _ => (hca _ (hGinv k l)).mul (hca _ (hpΦ l))
      exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.contDiffAt.comp (y₀, v₀) h
    have hN0 : (∑ a : Fin 3, ∑ b : Fin 3, (G (y₀, v₀).1)⁻¹ a b * partialDeriv a Φ (y₀, v₀).1 *
        partialDeriv b Φ (y₀, v₀).1) ≠ 0 := by
      have := (hNpos y₀ hy₀).ne'
      rw [hNe] at this
      exact this
    exact (hHc.div hNc hN0).smul hnc
  have hV : ContDiffAt ℝ 1
      (fun p : E3 × E3 => (p.2, -sprayGam G p.1 p.2 - sprayA G Φ p.1 p.2)) (y₀, v₀) :=
    (contDiffAt_snd.prodMk (hGam.neg.sub hAc)).of_le h1inf
  
  
  have hdd : ∀ y ∈ W, DifferentiableAt ℝ (fderiv ℝ Φ) y := fun y hy =>
    (((hΦ.of_le h2inf).fderiv_of_isOpen hW (m := 1) h112).contDiffAt
      (hW.mem_nhds hy)).differentiableAt one_ne_zero
  have hquad : ∀ y u : E3, DifferentiableAt ℝ (fderiv ℝ Φ) y →
      ∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (partialDeriv j Φ) y * u i * u j =
        fderiv ℝ (fderiv ℝ Φ) y u u := by
    intro y u hd
    have h41 : ∀ i j, partialDeriv i (partialDeriv j Φ) y =
        fderiv ℝ (fderiv ℝ Φ) y (e i) (e j) := by
      intro i j
      have h : HasFDerivAt (fun z => fderiv ℝ Φ z (e j))
          ((fderiv ℝ Φ y).comp (0 : E3 →L[ℝ] E3) + (fderiv ℝ (fderiv ℝ Φ) y).flip (e j)) y :=
        hd.hasFDerivAt.clm_apply (hasFDerivAt_const (e j) y)
      show fderiv ℝ (fun z => fderiv ℝ Φ z (e j)) y (e i) = _
      rw [h.fderiv]
      simp
    have hv_exp : u = u 0 • e 0 + u 1 • e 1 + u 2 • e 2 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    simp only [h41, Fin.sum_univ_three]
    conv_rhs => rw [hv_exp]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    ring
  have hwd : ∀ (γ η : ℝ → E3) (t : ℝ) (a : E3), HasDerivAt γ (η t) t → HasDerivAt η a t →
      γ t ∈ W → HasDerivAt (fun s => fderiv ℝ Φ (γ s) (η s))
        (∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (partialDeriv j Φ) (γ t) * η t i * η t j +
          ∑ k : Fin 3, partialDeriv k Φ (γ t) * a k) t := by
    intro γ η t a hγ hη hγW
    have hd : DifferentiableAt ℝ (fderiv ℝ Φ) (γ t) := hdd (γ t) hγW
    have hE := (hd.hasFDerivAt.comp_hasDerivAt t hγ).clm_apply hη
    refine hE.congr_deriv ?_
    show fderiv ℝ (fderiv ℝ Φ) (γ t) (η t) (η t) + fderiv ℝ Φ (γ t) a = _
    rw [hquad (γ t) (η t) hd]
    rw [hlin (fderiv ℝ Φ (γ t)) a]
    rfl
  
  
  have hlin2 : ∀ (p X Y : Fin 3 → ℝ) (s : ℝ),
      ∑ k : Fin 3, p k * (-X k - s * Y k) = -(∑ k : Fin 3, p k * X k) - s * ∑ k : Fin 3, p k * Y k := by
    intro p X Y s
    simp only [Fin.sum_univ_three]
    ring
  have htan : ∀ y v : E3, N y ≠ 0 →
      ∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (partialDeriv j Φ) y * v i * v j +
        ∑ k : Fin 3, partialDeriv k Φ y * (-sprayGam G y v - sprayA G Φ y v) k = 0 := by
    intro y v hNy
    have hk : ∀ k : Fin 3, (-sprayGam G y v - sprayA G Φ y v) k =
        -(∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b y * v a * v b) -
          H y v / N y * ∑ l : Fin 3, (G y)⁻¹ k l * partialDeriv l Φ y := by
      intro k
      rw [hsub_apply, hneg_apply, hsG, hsA]
    simp only [hk]
    have ha : ∑ k : Fin 3, partialDeriv k Φ y *
        (∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b y * v a * v b) =
        ∑ a : Fin 3, ∑ b : Fin 3,
          (∑ k : Fin 3, christoffel G k a b y * partialDeriv k Φ y) * v a * v b := by
      simp only [Fin.sum_univ_three]
      ring
    have hb : ∑ k : Fin 3, partialDeriv k Φ y * ∑ l : Fin 3, (G y)⁻¹ k l * partialDeriv l Φ y =
        N y := by
      rw [hNe]
      simp only [Fin.sum_univ_three]
      ring
    have hc : H y v = ∑ a : Fin 3, ∑ b : Fin 3, partialDeriv a (partialDeriv b Φ) y * v a * v b -
        ∑ a : Fin 3, ∑ b : Fin 3,
          (∑ k : Fin 3, christoffel G k a b y * partialDeriv k Φ y) * v a * v b := by
      rw [hHe]
      simp only [hessLoc, sub_mul, Finset.sum_sub_distrib]
    rw [hlin2, ha, hb, div_mul_cancel₀ _ hNy, hc]
    ring
  
  
  have hσd : ∀ (γ η : ℝ → E3) (t : ℝ) (a : E3), HasDerivAt γ (η t) t → HasDerivAt η a t →
      γ t ∈ W → HasDerivAt (fun s => ∑ k : Fin 3, ∑ l : Fin 3, η s k * G (γ s) k l * η s l)
        (∑ k : Fin 3, ∑ l : Fin 3, (a k * G (γ t) k l * η t l +
          η t k * fderiv ℝ (fun z => G z k l) (γ t) (η t) * η t l +
          η t k * G (γ t) k l * a l)) t := by
    intro γ η t a hγ hη hγW
    have hcoη : ∀ k : Fin 3, HasDerivAt (fun s => η s k) (a k) t := fun k =>
      (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt.comp_hasDerivAt t hη
    have hGd : ∀ k l : Fin 3, HasDerivAt (fun s => G (γ s) k l)
        (fderiv ℝ (fun z => G z k l) (γ t) (η t)) t := fun k l =>
      (((hG k l).contDiffAt (hW.mem_nhds hγW)).differentiableAt (by simp)).hasFDerivAt.comp_hasDerivAt
        t hγ
    refine HasDerivAt.fun_sum fun k _ => HasDerivAt.fun_sum fun l _ => ?_
    have h := ((hcoη k).mul (hGd k l)).mul (hcoη l)
    exact h.congr_deriv (by simp only [Pi.mul_apply]; ring)
  
  
  have hpairA : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), (∀ k l, A k l = A l k) → IsUnit A.det →
      ∀ (s : ℝ) (d u : Fin 3 → ℝ),
      ∑ k : Fin 3, ∑ l : Fin 3, (s * ∑ m : Fin 3, A⁻¹ k m * d m) * A k l * u l =
        s * ∑ l : Fin 3, d l * u l := by
    intro A hs hdet s d u
    have hinvA : ∀ l m : Fin 3, ∑ k : Fin 3, A⁻¹ k m * A k l =
        (1 : Matrix (Fin 3) (Fin 3) ℝ) l m := by
      intro l m
      rw [← Matrix.mul_nonsing_inv A hdet, Matrix.mul_apply]
      exact Finset.sum_congr rfl (fun k _ => by rw [hs l k]; ring)
    have e00 := hinvA 0 0
    have e01 := hinvA 0 1
    have e02 := hinvA 0 2
    have e10 := hinvA 1 0
    have e11 := hinvA 1 1
    have e12 := hinvA 1 2
    have e20 := hinvA 2 0
    have e21 := hinvA 2 1
    have e22 := hinvA 2 2
    simp only [Fin.sum_univ_three, Matrix.one_apply_eq, Matrix.one_apply_ne, ne_eq, Fin.reduceEq,
      not_false_eq_true] at e00 e01 e02 e10 e11 e12 e20 e21 e22 ⊢
    linear_combination (s * d 0 * u 0) * e00 + (s * d 1 * u 0) * e01 + (s * d 2 * u 0) * e02 +
      (s * d 0 * u 1) * e10 + (s * d 1 * u 1) * e11 + (s * d 2 * u 1) * e12 +
      (s * d 0 * u 2) * e20 + (s * d 1 * u 2) * e21 + (s * d 2 * u 2) * e22
  have hmetQ : ∀ y v : E3, IsUnit (G y).det →
      ∑ k : Fin 3, ∑ l : Fin 3, sprayA G Φ y v k * G y k l * v l =
        H y v / N y * fderiv ℝ Φ y v := by
    intro y v hdet
    simp only [hsA]
    rw [hlin (fderiv ℝ Φ y) v]
    exact hpairA (G y) (fun k l => hGs y k l) hdet _ (fun l => partialDeriv l Φ y) (fun l => v l)
  have hmetP : ∀ y v : E3, IsUnit (G y).det →
      2 * ∑ k : Fin 3, ∑ l : Fin 3, sprayGam G y v k * G y k l * v l =
        ∑ k : Fin 3, ∑ l : Fin 3, v k * fderiv ℝ (fun z => G z k l) y v * v l := by
    intro y v hdet
    have hδ : ∀ l m : Fin 3, ∑ k : Fin 3, G y k l * (G y)⁻¹ k m = if l = m then 1 else 0 := by
      intro l m
      have h := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) hdet) l) m
      rw [Matrix.mul_apply, Matrix.one_apply] at h
      rw [← h]
      exact Finset.sum_congr rfl fun k _ => by rw [hGs y k l]
    have hlowX : ∀ (l : Fin 3) (X : Fin 3 → ℝ),
        ∑ k : Fin 3, G y k l * ((1 / 2 : ℝ) * ∑ m : Fin 3, (G y)⁻¹ k m * X m) = (1 / 2) * X l := by
      intro l X
      calc ∑ k : Fin 3, G y k l * ((1 / 2 : ℝ) * ∑ m : Fin 3, (G y)⁻¹ k m * X m)
          = ∑ m : Fin 3, (1 / 2 * X m) * ∑ k : Fin 3, G y k l * (G y)⁻¹ k m := by
            simp only [Finset.mul_sum]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun k _ => by ring
        _ = (1 / 2) * X l := by
            simp only [hδ, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hlow : ∀ a b l : Fin 3, ∑ k : Fin 3, G y k l * christoffel G k a b y =
        (1 / 2) * (partialDeriv a (fun z => G z b l) y + partialDeriv b (fun z => G z a l) y
          - partialDeriv l (fun z => G z a b) y) := by
      intro a b l
      exact hlowX l (fun m => partialDeriv a (fun z => G z b m) y +
        partialDeriv b (fun z => G z a m) y - partialDeriv m (fun z => G z a b) y)
    have e2 : ∀ k l : Fin 3, fderiv ℝ (fun z => G z k l) y v =
        ∑ m : Fin 3, partialDeriv m (fun z => G z k l) y * v m := fun k l => hlin _ v
    simp only [hsG, e2]
    have r1 : ∑ k : Fin 3, ∑ l : Fin 3,
        (∑ a : Fin 3, ∑ b : Fin 3, christoffel G k a b y * v a * v b) * G y k l * v l =
        ∑ a : Fin 3, ∑ b : Fin 3, ∑ l : Fin 3,
          v a * v b * v l * ∑ k : Fin 3, G y k l * christoffel G k a b y := by
      simp only [Fin.sum_univ_three]
      ring
    rw [r1]
    simp only [hlow]
    simp only [Fin.sum_univ_three]
    ring
  
  
  have hD0 : ∀ y v : E3, y ∈ W → fderiv ℝ Φ y v = 0 →
      ∑ k : Fin 3, ∑ l : Fin 3, ((-sprayGam G y v - sprayA G Φ y v) k * G y k l * v l +
        v k * fderiv ℝ (fun z => G z k l) y v * v l +
        v k * G y k l * (-sprayGam G y v - sprayA G Φ y v) l) = 0 := by
    intro y v hy hw
    have hdet : IsUnit (G y).det := isUnit_iff_ne_zero.2 (hGpd y hy).det_pos.ne'
    have hP := hmetP y v hdet
    have hQ := hmetQ y v hdet
    rw [hw, mul_zero] at hQ
    have hsym : ∑ k : Fin 3, ∑ l : Fin 3, v k * G y k l * (-sprayGam G y v - sprayA G Φ y v) l =
        ∑ k : Fin 3, ∑ l : Fin 3, (-sprayGam G y v - sprayA G Φ y v) k * G y k l * v l := by
      conv_lhs => rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => by
        rw [hGs y l k]; ring
    have hsplit : ∑ k : Fin 3, ∑ l : Fin 3, (-sprayGam G y v - sprayA G Φ y v) k * G y k l * v l =
        -(∑ k : Fin 3, ∑ l : Fin 3, sprayGam G y v k * G y k l * v l) -
          ∑ k : Fin 3, ∑ l : Fin 3, sprayA G Φ y v k * G y k l * v l := by
      simp only [hsub_apply, hneg_apply, sub_mul, neg_mul, Finset.sum_sub_distrib,
        Finset.sum_neg_distrib]
    simp only [Finset.sum_add_distrib]
    rw [hsym, hsplit]
    linarith
  
  
  obtain ⟨α, hα0, ε₁, hε₁, hα⟩ :=
    hV.exists_forall_mem_closedBall_exists_eq_forall_mem_Ioo_hasDerivAt₀ 0
  have h0mem : (0 : ℝ) ∈ Set.Ioo (0 - ε₁) (0 + ε₁) := by
    constructor <;> linarith
  have hαc : ContinuousAt α 0 := (hα 0 h0mem).continuousAt
  have hS : {t : ℝ | (α t).1 ∈ W} ∈ 𝓝 (0 : ℝ) := by
    have h1 : (α 0).1 ∈ W := by rw [hα0]; exact hy₀
    exact (continuous_fst.continuousAt.comp hαc).preimage_mem_nhds (hW.mem_nhds h1)
  obtain ⟨ε₂, hε₂, hball⟩ := Metric.mem_nhds_iff.1 hS
  have hε : 0 < min ε₁ ε₂ := lt_min hε₁ hε₂
  have hI1 : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), t ∈ Set.Ioo (0 - ε₁) (0 + ε₁) := by
    intro t ht
    have h1 := min_le_left ε₁ ε₂
    constructor <;> linarith [ht.1, ht.2]
  have hWI : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), (α t).1 ∈ W := by
    intro t ht
    have h1 := min_le_right ε₁ ε₂
    apply hball
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]
    constructor <;> linarith [ht.1, ht.2]
  have hαI : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), HasDerivAt α
      ((α t).2, -sprayGam G (α t).1 (α t).2 - sprayA G Φ (α t).1 (α t).2) t :=
    fun t ht => hα t (hI1 t ht)
  have h0I : (0 : ℝ) ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂) := ⟨neg_lt_zero.2 hε, hε⟩
  have hconst : ∀ f : ℝ → ℝ, (∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), HasDerivAt f 0 t) →
      ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), f t = f 0 := by
    intro f hf t ht
    exact isOpen_Ioo.is_const_of_deriv_eq_zero isPreconnected_Ioo
      (fun s hs => (hf s hs).differentiableAt.differentiableWithinAt)
      (fun s hs => (hf s hs).deriv) ht h0I
  have hγ : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂),
      HasDerivAt (fun s => (α s).1) (α t).2 t := fun t ht =>
    (hasFDerivAt_fst : HasFDerivAt (Prod.fst : E3 × E3 → E3)
      (ContinuousLinearMap.fst ℝ E3 E3) (α t)).comp_hasDerivAt t (hαI t ht)
  have hη : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂),
      HasDerivAt (fun s => (α s).2) (-sprayGam G (α t).1 (α t).2 - sprayA G Φ (α t).1 (α t).2) t :=
    fun t ht => (hasFDerivAt_snd : HasFDerivAt (Prod.snd : E3 × E3 → E3)
      (ContinuousLinearMap.snd ℝ E3 E3) (α t)).comp_hasDerivAt t (hαI t ht)
  
  
  have hwz : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), fderiv ℝ Φ (α t).1 (α t).2 = 0 := by
    have hw0 : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂),
        HasDerivAt (fun s => fderiv ℝ Φ (α s).1 (α s).2) 0 t := by
      intro t ht
      have h := hwd (fun s => (α s).1) (fun s => (α s).2) t _ (hγ t ht) (hη t ht) (hWI t ht)
      exact h.congr_deriv (htan (α t).1 (α t).2 (hNpos _ (hWI t ht)).ne')
    intro t ht
    have h := hconst _ hw0 t ht
    simp only [hα0] at h
    rw [h]
    exact hv₀
  
  have hΦz : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), Φ (α t).1 = 0 := by
    have hd0 : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), HasDerivAt (fun s => Φ (α s).1) 0 t := by
      intro t ht
      have hd : DifferentiableAt ℝ Φ (α t).1 :=
        (hΦ.contDiffAt (hW.mem_nhds (hWI t ht))).differentiableAt (by simp)
      exact (hd.hasFDerivAt.comp_hasDerivAt t (hγ t ht)).congr_deriv (hwz t ht)
    intro t ht
    have h := hconst _ hd0 t ht
    simp only [hα0] at h
    rw [h]
    exact hΦ₀
  
  have hσz : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂),
      ∑ k : Fin 3, ∑ l : Fin 3, (α t).2 k * G (α t).1 k l * (α t).2 l =
        ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l := by
    have hd0 : ∀ t ∈ Set.Ioo (-min ε₁ ε₂) (min ε₁ ε₂), HasDerivAt
        (fun s => ∑ k : Fin 3, ∑ l : Fin 3, (α s).2 k * G (α s).1 k l * (α s).2 l) 0 t := by
      intro t ht
      have h := hσd (fun s => (α s).1) (fun s => (α s).2) t _ (hγ t ht) (hη t ht) (hWI t ht)
      exact h.congr_deriv (hD0 (α t).1 (α t).2 (hWI t ht) (hwz t ht))
    intro t ht
    have h := hconst _ hd0 t ht
    simp only [hα0] at h
    exact h
  
  refine ⟨min ε₁ ε₂, α, hε, hα0, fun t ht => ⟨hαI t ht, hWI t ht, hΦz t ht, hwz t ht, hσz t ht⟩⟩

theorem spray_flow_invariance (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (O : Set E3) (hO : IsOpen O) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) O) (hGs : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpd : ∀ y ∈ O, (G y).PosDef) (m : ℝ) (hm : 0 < m) (hmG : ∀ y ∈ O, ∀ v : E3, m * ‖v‖ ^ 2 ≤ ∑ k : Fin 3, ∑ l : Fin 3, v k * G y k l * v l) {N : ℕ} (W : Fin N → Set E3) (Φ : Fin N → E3 → ℝ) (hW : ∀ i, IsOpen (W i) ∧ W i ⊆ O) (hΦ : ∀ i, ContDiffOn ℝ ∞ (Φ i) (W i)) (hdΦ : ∀ i, ∀ y ∈ W i, fderiv ℝ (Φ i) y ≠ 0) (S Z : Set E3) (hSW : ∀ i, ∀ y ∈ W i, (Φ i y = 0 ↔ y ∈ S)) (hZO : Z ⊆ O) (hSZ : IsClosed (S ∩ Z)) (hcov : ∀ y ∈ S ∩ Z, ∃ i, y ∈ W i) (Rv : ℝ) (X : E3 × E3 → E3 × E3) (hX : ContDiff ℝ 1 X) (hXc : HasCompactSupport X) (hXS : ∀ y ∈ S ∩ Z, ∀ v : E3, ‖v‖ ≤ Rv → (∀ i, y ∈ W i → fderiv ℝ (Φ i) y v = 0) → ∀ j, y ∈ W j → X (y, v) = (v, -sprayGam G y v - sprayA G (Φ j) y v)) (Fl : ℝ → E3 × E3 → E3 × E3) (hFl0 : ∀ p, Fl 0 p = p) (hFl : ∀ (t : ℝ) (p : E3 × E3), HasDerivAt (fun s => Fl s p) (X (Fl t p)) t) (y₀ v₀ : E3) (hy₀ : y₀ ∈ S ∩ Z) (hv₀ : ∀ i, y₀ ∈ W i → fderiv ℝ (Φ i) y₀ v₀ = 0) (μ T : ℝ) (hμ : 0 ≤ μ) (hT : 0 ≤ T) (hμv : ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l ≤ m * μ ^ 2) (hμR : μ ≤ Rv) (hball : Metric.closedBall y₀ (T * μ) ⊆ Z) : ∀ t ∈ Set.Icc 0 T, (Fl t (y₀, v₀)).1 ∈ S ∩ Z ∧ ‖(Fl t (y₀, v₀)).1 - y₀‖ ≤ t * μ ∧ ‖(Fl t (y₀, v₀)).2‖ ≤ μ ∧ (∀ i, (Fl t (y₀, v₀)).1 ∈ W i → fderiv ℝ (Φ i) (Fl t (y₀, v₀)).1 (Fl t (y₀, v₀)).2 = 0) ∧ ∑ k : Fin 3, ∑ l : Fin 3, (Fl t (y₀, v₀)).2 k * G (Fl t (y₀, v₀)).1 k l * (Fl t (y₀, v₀)).2 l = ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l :=
by
  
  have hfst : ∀ (f : ℝ → E3 × E3) (f' : E3 × E3) (t : ℝ), HasDerivAt f f' t →
      HasDerivAt (fun s => (f s).1) f'.1 t := by
    intro f f' t h
    exact (hasFDerivAt_fst : HasFDerivAt (Prod.fst : E3 × E3 → E3)
      (ContinuousLinearMap.fst ℝ E3 E3) (f t)).comp_hasDerivAt t h
  obtain ⟨K, hK⟩ := ContDiff.lipschitzWith_of_hasCompactSupport hXc hX (by simp)
  have hc : Continuous (fun s => Fl s (y₀, v₀)) :=
    continuous_iff_continuousAt.2 fun t => (hFl t (y₀, v₀)).continuousAt
  have hγc : Continuous (fun s => (Fl s (y₀, v₀)).1) := continuous_fst.comp hc
  have hηc : Continuous (fun s => (Fl s (y₀, v₀)).2) := continuous_snd.comp hc
  
  have hspd : ∀ y ∈ O, ∀ v : E3,
      ∑ k : Fin 3, ∑ l : Fin 3, v k * G y k l * v l
        = ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l → ‖v‖ ≤ μ := by
    intro y hy v hv
    have h1 := hmG y hy v
    rw [hv] at h1
    have h2 : m * ‖v‖ ^ 2 ≤ m * μ ^ 2 := h1.trans hμv
    have h3 : ‖v‖ ^ 2 ≤ μ ^ 2 := le_of_mul_le_mul_left h2 hm
    nlinarith [norm_nonneg v]
  
  obtain ⟨A, hA⟩ : ∃ A : Set ℝ, A = {t : ℝ | (Fl t (y₀, v₀)).1 ∈ S ∩ Z ∧
      ‖(Fl t (y₀, v₀)).1 - y₀‖ ≤ t * μ ∧ ‖(Fl t (y₀, v₀)).2‖ ≤ μ ∧
      (∀ i, (Fl t (y₀, v₀)).1 ∈ W i →
        fderiv ℝ (Φ i) (Fl t (y₀, v₀)).1 (Fl t (y₀, v₀)).2 = 0) ∧
      ∑ k : Fin 3, ∑ l : Fin 3, (Fl t (y₀, v₀)).2 k * G (Fl t (y₀, v₀)).1 k l *
        (Fl t (y₀, v₀)).2 l = ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l} := ⟨_, rfl⟩
  
  have h0 : (0 : ℝ) ∈ A := by
    rw [hA, Set.mem_setOf_eq, hFl0]
    refine ⟨hy₀, by simp, hspd y₀ (hZO hy₀.2) v₀ rfl, hv₀, rfl⟩
  
  have hAclosed : IsClosed A := by
    apply isClosed_of_closure_subset
    intro t ht
    obtain ⟨x, hxA, hxt⟩ := mem_closure_iff_seq_limit.1 ht
    rw [hA] at hxA
    simp only [Set.mem_setOf_eq] at hxA
    rw [hA, Set.mem_setOf_eq]
    have hγx : Tendsto (fun n => (Fl (x n) (y₀, v₀)).1) atTop (𝓝 (Fl t (y₀, v₀)).1) :=
      (hγc.tendsto t).comp hxt
    have hηx : Tendsto (fun n => (Fl (x n) (y₀, v₀)).2) atTop (𝓝 (Fl t (y₀, v₀)).2) :=
      (hηc.tendsto t).comp hxt
    have h1 : (Fl t (y₀, v₀)).1 ∈ S ∩ Z :=
      hSZ.mem_of_tendsto hγx (Eventually.of_forall fun n => (hxA n).1)
    refine ⟨h1, ?_, ?_, ?_, ?_⟩
    · exact le_of_tendsto_of_tendsto' ((hγx.sub_const y₀).norm) (hxt.mul_const μ)
        (fun n => (hxA n).2.1)
    · exact le_of_tendsto' hηx.norm (fun n => (hxA n).2.2.1)
    · intro i hi
      have hf : ContinuousAt (fderiv ℝ (Φ i)) (Fl t (y₀, v₀)).1 :=
        ((hΦ i).continuousOn_fderiv_of_isOpen (hW i).1 (by simp)).continuousAt
          ((hW i).1.mem_nhds hi)
      have hcont : ContinuousAt
          (fun s => fderiv ℝ (Φ i) (Fl s (y₀, v₀)).1 (Fl s (y₀, v₀)).2) t :=
        (ContinuousAt.comp (f := fun s => (Fl s (y₀, v₀)).1) (x := t) hf
          hγc.continuousAt).clm_apply hηc.continuousAt
      have hlim : Tendsto (fun n => fderiv ℝ (Φ i) (Fl (x n) (y₀, v₀)).1 (Fl (x n) (y₀, v₀)).2)
          atTop (𝓝 (fderiv ℝ (Φ i) (Fl t (y₀, v₀)).1 (Fl t (y₀, v₀)).2)) :=
        hcont.tendsto.comp hxt
      have hev : ∀ᶠ n in atTop, (Fl (x n) (y₀, v₀)).1 ∈ W i := hγx ((hW i).1.mem_nhds hi)
      have hlim0 : Tendsto (fun n => fderiv ℝ (Φ i) (Fl (x n) (y₀, v₀)).1 (Fl (x n) (y₀, v₀)).2)
          atTop (𝓝 0) :=
        tendsto_const_nhds.congr' (hev.mono fun n hn => ((hxA n).2.2.2.1 i hn).symm)
      exact tendsto_nhds_unique hlim hlim0
    · have hGt : ∀ k l : Fin 3, ContinuousAt (fun y => G y k l) (Fl t (y₀, v₀)).1 :=
        fun k l => (hG k l).continuousOn.continuousAt (hO.mem_nhds (hZO h1.2))
      have hco : ∀ k : Fin 3, Continuous (fun s => (Fl s (y₀, v₀)).2 k) :=
        fun k => (EuclideanSpace.proj k).continuous.comp hηc
      have hGt' : ∀ k l : Fin 3, ContinuousAt (fun s => G (Fl s (y₀, v₀)).1 k l) t :=
        fun k l => ContinuousAt.comp (f := fun s => (Fl s (y₀, v₀)).1) (x := t) (hGt k l)
          hγc.continuousAt
      have hcont : ContinuousAt (fun s => ∑ k : Fin 3, ∑ l : Fin 3,
          (Fl s (y₀, v₀)).2 k * G (Fl s (y₀, v₀)).1 k l * (Fl s (y₀, v₀)).2 l) t := by
        unfold ContinuousAt
        refine tendsto_finset_sum _ (fun k _ => tendsto_finset_sum _ (fun l _ => ?_))
        exact (((hco k).continuousAt.mul (hGt' k l)).mul (hco l).continuousAt :)
      have hlim : Tendsto (fun n => ∑ k : Fin 3, ∑ l : Fin 3,
          (Fl (x n) (y₀, v₀)).2 k * G (Fl (x n) (y₀, v₀)).1 k l * (Fl (x n) (y₀, v₀)).2 l)
          atTop (𝓝 (∑ k : Fin 3, ∑ l : Fin 3,
            (Fl t (y₀, v₀)).2 k * G (Fl t (y₀, v₀)).1 k l * (Fl t (y₀, v₀)).2 l)) :=
        hcont.tendsto.comp hxt
      have hlim' : Tendsto (fun n => ∑ k : Fin 3, ∑ l : Fin 3,
          (Fl (x n) (y₀, v₀)).2 k * G (Fl (x n) (y₀, v₀)).1 k l * (Fl (x n) (y₀, v₀)).2 l)
          atTop (𝓝 (∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l)) :=
        tendsto_const_nhds.congr (fun n => ((hxA n).2.2.2.2).symm)
      exact tendsto_nhds_unique hlim hlim'
  
  have hopen : ∀ τ ∈ A ∩ Set.Ico 0 T, A ∈ 𝓝[>] τ := by
    rintro τ ⟨hτ, hτ0, hτT⟩
    rw [hA, Set.mem_setOf_eq] at hτ
    obtain ⟨hP1, hP2, hP3, hP4, hP5⟩ := hτ
    obtain ⟨j, hj⟩ := hcov _ hP1
    have hΦj : Φ j (Fl τ (y₀, v₀)).1 = 0 := (hSW j _ hj).2 hP1.1
    obtain ⟨ε, ζ, hε, hζ0, hζ⟩ := local_spray_invariant G (W j) (hW j).1
      (fun a b => (hG a b).mono (hW j).2) hGs (fun y hy => hGpd y ((hW j).2 hy)) (Φ j) (hΦ j)
      (hdΦ j) (Fl τ (y₀, v₀)).1 (Fl τ (y₀, v₀)).2 hj hΦj (hP4 j hj)
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min (ε / 2) (T - τ) := ⟨_, rfl⟩
    have hδpos : 0 < δ := by rw [hδ]; exact lt_min (half_pos hε) (sub_pos.2 hτT)
    have hδε : δ ≤ ε / 2 := by rw [hδ]; exact min_le_left _ _
    have hδT : δ ≤ T - τ := by rw [hδ]; exact min_le_right _ _
    have hIcc : ∀ u ∈ Set.Icc (0 : ℝ) δ, u ∈ Set.Ioo (-ε) ε := by
      intro u hu
      constructor
      · linarith [hu.1]
      · linarith [hu.2]
    have hζ1d : ∀ u ∈ Set.Ioo (-ε) ε, HasDerivAt (fun s => (ζ s).1) (ζ u).2 u :=
      fun u hu => hfst _ _ u (hζ u hu).1
    have hspeed : ∀ u ∈ Set.Ioo (-ε) ε, ∑ k : Fin 3, ∑ l : Fin 3,
        (ζ u).2 k * G (ζ u).1 k l * (ζ u).2 l
          = ∑ k : Fin 3, ∑ l : Fin 3, v₀ k * G y₀ k l * v₀ l :=
      fun u hu => (hζ u hu).2.2.2.2.trans hP5
    have hζ2 : ∀ u ∈ Set.Ioo (-ε) ε, ‖(ζ u).2‖ ≤ μ :=
      fun u hu => hspd _ ((hW j).2 (hζ u hu).2.1) _ (hspeed u hu)
    
    have hmv : ∀ u ∈ Set.Icc (0 : ℝ) δ, ‖(ζ u).1 - (ζ 0).1‖ ≤ μ * (u - 0) :=
      norm_image_sub_le_of_norm_deriv_le_segment' (f := fun s => (ζ s).1)
        (f' := fun s => (ζ s).2) (C := μ)
        (fun u hu => (hζ1d u (hIcc u hu)).hasDerivWithinAt)
        (fun u hu => hζ2 u (hIcc u (Set.Ico_subset_Icc_self hu)))
    have hζ01 : (ζ 0).1 = (Fl τ (y₀, v₀)).1 := by rw [hζ0]
    have hposY : ∀ u ∈ Set.Icc (0 : ℝ) δ, ‖(ζ u).1 - y₀‖ ≤ (τ + u) * μ := by
      intro u hu
      have h1 := hmv u hu
      rw [hζ01, sub_zero] at h1
      calc ‖(ζ u).1 - y₀‖ ≤ ‖(ζ u).1 - (Fl τ (y₀, v₀)).1‖ + ‖(Fl τ (y₀, v₀)).1 - y₀‖ :=
            norm_sub_le_norm_sub_add_norm_sub _ _ _
        _ ≤ μ * u + τ * μ := add_le_add h1 hP2
        _ = (τ + u) * μ := by ring
    have hZmem : ∀ u ∈ Set.Icc (0 : ℝ) δ, (ζ u).1 ∈ S ∩ Z := by
      intro u hu
      have hu' := hIcc u hu
      refine ⟨(hSW j _ (hζ u hu').2.1).1 (hζ u hu').2.2.1, hball ?_⟩
      rw [Metric.mem_closedBall, dist_eq_norm]
      have h4 : (τ + u) * μ ≤ T * μ := mul_le_mul_of_nonneg_right (by linarith [hu.2]) hμ
      exact (hposY u hu).trans h4
    
    have htan : ∀ u ∈ Set.Icc (0 : ℝ) δ, ∀ i, (ζ u).1 ∈ W i →
        fderiv ℝ (Φ i) (ζ u).1 (ζ u).2 = 0 := by
      intro u hu i hi
      have hu' := hIcc u hu
      have hd := hζ1d u hu'
      have hΦd : HasFDerivAt (Φ i) (fderiv ℝ (Φ i) (ζ u).1) (ζ u).1 :=
        (((hΦ i).contDiffAt ((hW i).1.mem_nhds hi)).differentiableAt (by simp)).hasFDerivAt
      have h1 : HasDerivAt (fun s => Φ i (ζ s).1) (fderiv ℝ (Φ i) (ζ u).1 (ζ u).2) u :=
        hΦd.comp_hasDerivAt u hd
      have hev : (fun s => Φ i (ζ s).1) =ᶠ[𝓝 u] fun _ => (0 : ℝ) := by
        filter_upwards [Ioo_mem_nhds hu'.1 hu'.2,
          hd.continuousAt.preimage_mem_nhds ((hW i).1.mem_nhds hi)] with s hs1 hs2
        exact (hSW i _ hs2).2 ((hSW j _ (hζ s hs1).2.1).1 (hζ s hs1).2.2.1)
      have h2 : HasDerivAt (fun s => Φ i (ζ s).1) 0 u :=
        (hasDerivAt_const u (0 : ℝ)).congr_of_eventuallyEq hev
      exact h1.unique h2
    
    have hζX : ∀ u ∈ Set.Icc (0 : ℝ) δ, HasDerivAt ζ (X (ζ u)) u := by
      intro u hu
      have hu' := hIcc u hu
      have hX' := hXS (ζ u).1 (hZmem u hu) (ζ u).2 ((hζ2 u hu').trans hμR) (htan u hu) j
        (hζ u hu').2.1
      rw [Prod.mk.eta] at hX'
      rw [hX']
      exact (hζ u hu').1
    
    have hfd : ∀ u, HasDerivAt (fun s => Fl (τ + s) (y₀, v₀)) (X (Fl (τ + u) (y₀, v₀))) u :=
      fun u => HasDerivAt.comp_const_add τ u (hFl (τ + u) (y₀, v₀))
    have hEq := ODE_solution_unique (v := fun _ => X) (K := K) (fun _ => hK)
      (f := fun s => Fl (τ + s) (y₀, v₀)) (g := ζ) (a := 0) (b := δ)
      (fun u _ => (hfd u).continuousAt.continuousWithinAt)
      (fun u _ => (hfd u).hasDerivWithinAt)
      (fun u hu => (hζX u hu).continuousAt.continuousWithinAt)
      (fun u hu => (hζX u (Set.Ico_subset_Icc_self hu)).hasDerivWithinAt)
      (by simp [hζ0])
    have hflow : ∀ u ∈ Set.Icc (0 : ℝ) δ, Fl (τ + u) (y₀, v₀) = ζ u := fun u hu => hEq hu
    have hPu : ∀ u ∈ Set.Icc (0 : ℝ) δ, τ + u ∈ A := by
      intro u hu
      have hu' := hIcc u hu
      rw [hA, Set.mem_setOf_eq, hflow u hu]
      exact ⟨hZmem u hu, hposY u hu, hζ2 u hu', htan u hu, hspeed u hu'⟩
    have hsub : Set.Icc τ (τ + δ) ⊆ A := by
      intro t ht
      have h := hPu (t - τ) ⟨by linarith [ht.1], by linarith [ht.2]⟩
      have e : τ + (t - τ) = t := by ring
      rw [e] at h
      exact h
    exact Filter.mem_of_superset (Icc_mem_nhdsGT (by linarith)) hsub
  have hsubA := IsClosed.Icc_subset_of_forall_mem_nhdsWithin (hAclosed.inter isClosed_Icc) h0 hopen
  intro t ht
  have h := hsubA ht
  rw [hA, Set.mem_setOf_eq] at h
  exact h

theorem spray_flow_homogeneity {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (X : E × E → E × E) (K : NNReal) (hXL : LipschitzWith K X) (Fl : ℝ → E × E → E × E) (hFl0 : ∀ p, Fl 0 p = p) (hFl : ∀ (t : ℝ) (p : E × E), HasDerivAt (fun s => Fl s p) (X (Fl t p)) t) (Q : E → E → E) (hQ : ∀ (y v : E) (a : ℝ), Q y (a • v) = (a ^ 2) • Q y v) (R : Set (E × E)) (hR : ∀ p ∈ R, X p = (p.2, Q p.1 p.2)) (y₀ v₀ : E) (lam : ℝ) (hlam : 0 < lam) (hreg : ∀ t ∈ Set.Icc (0 : ℝ) lam, Fl t (y₀, v₀) ∈ R ∧ ((Fl t (y₀, v₀)).1, lam • (Fl t (y₀, v₀)).2) ∈ R) : Fl 1 (y₀, lam • v₀) = ((Fl lam (y₀, v₀)).1, lam • (Fl lam (y₀, v₀)).2) :=
by
  have hc : ∀ s ∈ Set.Icc (0:ℝ) 1,
      HasDerivAt (fun s : ℝ => ((Fl (lam * s) (y₀, v₀)).1, lam • (Fl (lam * s) (y₀, v₀)).2))
        (X ((Fl (lam * s) (y₀, v₀)).1, lam • (Fl (lam * s) (y₀, v₀)).2)) s := by
    intro s hs
    have hts : lam * s ∈ Set.Icc (0:ℝ) lam :=
      ⟨mul_nonneg hlam.le hs.1, by nlinarith [hs.2]⟩
    obtain ⟨hA, hB⟩ := hreg (lam * s) hts
    have ha : HasDerivAt (fun s : ℝ => lam * s) lam s := by
      simpa using (hasDerivAt_id s).const_mul lam
    have hG : HasDerivAt (fun s' : ℝ => Fl (lam * s') (y₀, v₀))
        (lam • X (Fl (lam * s) (y₀, v₀))) s :=
      (hFl (lam * s) (y₀, v₀)).scomp s ha
    rw [hR _ hA] at hG
    let L : (E × E) →L[ℝ] (E × E) :=
      (ContinuousLinearMap.id ℝ E).prodMap (lam • ContinuousLinearMap.id ℝ E)
    have hL := L.hasFDerivAt.comp_hasDerivAt s hG
    have hfun : (L ∘ fun s' : ℝ => Fl (lam * s') (y₀, v₀)) =
        fun s' : ℝ => ((Fl (lam * s') (y₀, v₀)).1, lam • (Fl (lam * s') (y₀, v₀)).2) := by
      funext s'
      rfl
    rw [hfun] at hL
    convert hL using 1
    rw [hR _ hB]
    simp [L, hQ, smul_smul, sq]
  have hd : ∀ s, HasDerivAt (fun s => Fl s (y₀, lam • v₀)) (X (Fl s (y₀, lam • v₀))) s :=
    fun s => hFl s _
  have heq := ODE_solution_unique (v := fun _ => X) (K := K) (fun _ => hXL)
    (HasDerivAt.continuousOn (fun s _ => hd s))
    (fun t _ => (hd t).hasDerivWithinAt)
    (HasDerivAt.continuousOn (fun s hs => hc s hs))
    (fun t ht => (hc t (Set.Ico_subset_Icc_self ht)).hasDerivWithinAt)
    (by simp [hFl0])
  have h1 := heq (⟨zero_le_one, le_rfl⟩ : (1:ℝ) ∈ Set.Icc (0:ℝ) 1)
  simpa using h1

theorem ray_derivatives_of_eqOn (F : E2 → E3) (hF : ContDiff ℝ 2 F) (x : E2) (T : ℝ) (hT : 1 < T) (γ η : ℝ → E3) (a : E3) (hFγ : ∀ t ∈ Set.Ioo (0 : ℝ) T, F (t • x) = γ t) (hγ : ∀ t ∈ Set.Ioo (0 : ℝ) T, HasDerivAt γ (η t) t) (hη : HasDerivAt η a 1) : fderiv ℝ F x x = η 1 ∧ fderiv ℝ (fderiv ℝ F) x x x = a :=
by
  have hF1 : Differentiable ℝ F := hF.differentiable (by norm_num)
  have hF2 : Differentiable ℝ (fderiv ℝ F) :=
    (hF.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
  have hσ : ∀ t : ℝ, HasDerivAt (fun y : ℝ => y • x) x t := by
    intro t
    simpa using (hasDerivAt_id t).smul_const x
  have h1 : (1 : ℝ) ∈ Set.Ioo (0 : ℝ) T := ⟨zero_lt_one, hT⟩
  have s3 : ∀ t ∈ Set.Ioo (0 : ℝ) T, fderiv ℝ F (t • x) x = η t := by
    intro t ht
    have ha : HasDerivAt (fun y : ℝ => F (y • x)) (fderiv ℝ F (t • x) x) t :=
      (hF1 (t • x)).hasFDerivAt.comp_hasDerivAt t (hσ t)
    have hb : γ =ᶠ[nhds t] (fun y : ℝ => F (y • x)) :=
      Filter.eventually_of_mem (Ioo_mem_nhds ht.1 ht.2) (fun s hs => (hFγ s hs).symm)
    exact (ha.congr_of_eventuallyEq hb).unique (hγ t ht)
  refine ⟨?_, ?_⟩
  · have := s3 1 h1
    rwa [one_smul] at this
  · have hd : HasFDerivAt (fderiv ℝ F) (fderiv ℝ (fderiv ℝ F) x) ((fun y : ℝ => y • x) 1) := by
      simpa using (hF2 x).hasFDerivAt
    have hb := hd.comp_hasDerivAt (1 : ℝ) (hσ 1)
    have hc : HasDerivAt (fun t : ℝ => fderiv ℝ F (t • x) x) (fderiv ℝ (fderiv ℝ F) x x x) 1 := by
      have := hb.clm_apply (hasDerivAt_const (1 : ℝ) x)
      simpa [Function.comp_def] using this
    have he : η =ᶠ[nhds (1 : ℝ)] (fun t : ℝ => fderiv ℝ F (t • x) x) :=
      Filter.eventually_of_mem (Ioo_mem_nhds h1.1 h1.2) (fun t ht => (s3 t ht).symm)
    exact (hc.congr_of_eventuallyEq he).unique hη

theorem tangent_isometry_exists (A : Matrix (Fin 3) (Fin 3) ℝ) (hA : A.PosDef) (ℓ : E3 →L[ℝ] ℝ) (hℓ : ℓ ≠ 0) : ∃ L : E2 →L[ℝ] E3, (∀ x : E2, ℓ (L x) = 0) ∧ ∀ x : E2, ∑ k : Fin 3, ∑ l : Fin 3, (L x) k * A k l * (L x) l = ‖x‖ ^ 2 :=
by
  classical
  
  obtain ⟨B, hB⟩ : ∃ B : E3 → E3 → ℝ,
      ∀ u w : E3, B u w = ∑ k : Fin 3, ∑ l : Fin 3, u k * A k l * w l := ⟨_, fun _ _ => rfl⟩
  have hsymmA : ∀ i j : Fin 3, A i j = A j i := by
    intro i j
    have h := hA.isHermitian.apply i j
    simp only [star_trivial] at h
    linarith [h]
  have hBsymm : ∀ u w : E3, B u w = B w u := by
    intro u w
    simp only [hB, Fin.sum_univ_three]
    rw [hsymmA 1 0, hsymmA 2 0, hsymmA 2 1]
    ring
  have hBsmulL : ∀ (s : ℝ) (u w : E3), B (s • u) w = s * B u w := by
    intro s u w
    simp only [hB, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hBsmulR : ∀ (s : ℝ) (u w : E3), B u (s • w) = s * B u w := by
    intro s u w
    simp only [hB, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hBaddL : ∀ u v w : E3, B (u + v) w = B u w + B v w := by
    intro u v w
    simp only [hB, PiLp.add_apply, Fin.sum_univ_three]
    ring
  have hBaddR : ∀ u v w : E3, B u (v + w) = B u v + B u w := by
    intro u v w
    simp only [hB, PiLp.add_apply, Fin.sum_univ_three]
    ring
  have hBsubR : ∀ u v w : E3, B u (v - w) = B u v - B u w := by
    intro u v w
    simp only [hB, PiLp.sub_apply, Fin.sum_univ_three]
    ring
  have hBpos : ∀ u : E3, u ≠ 0 → 0 < B u u := by
    intro u hu
    have hx : (WithLp.ofLp u : Fin 3 → ℝ) ≠ 0 := by
      intro h
      exact hu (by ext i; simpa using congrFun h i)
    have h := hA.dotProduct_mulVec_pos hx
    convert h using 1
    simp only [hB, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
    ring
  
  have he : ∀ i j : Fin 3, (e i) j = if j = i then (1 : ℝ) else 0 := by
    intro i j
    simp [e, EuclideanSpace.single_apply]
  have hgen : ∀ i j m : Fin 3, j ≠ i → m ≠ i → m ≠ j → ℓ (e i) ≠ 0 →
      ∃ w₁ w₂ : E3, ℓ w₁ = 0 ∧ ℓ w₂ = 0 ∧ w₁ ≠ 0 ∧ ∀ s : ℝ, w₂ - s • w₁ ≠ 0 := by
    intro i j m hji hmi hmj hi
    refine ⟨ℓ (e i) • e j - ℓ (e j) • e i, ℓ (e i) • e m - ℓ (e m) • e i, ?_, ?_, ?_, ?_⟩
    · simp only [map_sub, map_smul, smul_eq_mul]; ring
    · simp only [map_sub, map_smul, smul_eq_mul]; ring
    · intro h
      have h' := congrArg (fun v : E3 => v j) h
      simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, he, if_pos rfl, if_neg hji,
        PiLp.zero_apply, ↓reduceIte, mul_one, mul_zero, sub_zero] at h'
      exact hi h'
    · intro s h
      have h' := congrArg (fun v : E3 => v m) h
      simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, he, if_pos rfl, if_neg hmi,
        if_neg hmj, PiLp.zero_apply, ↓reduceIte, mul_one, mul_zero, sub_zero] at h'
      exact hi h'
  have hex : ∃ k : Fin 3, ℓ (e k) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hℓ
    refine ContinuousLinearMap.ext fun v => ?_
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext i
      fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    rw [hv]
    simp only [map_add, map_smul, smul_eq_mul, hcon, mul_zero, add_zero,
      ContinuousLinearMap.zero_apply, smul_zero]
  obtain ⟨k, hk⟩ := hex
  obtain ⟨w₁, w₂, h₁, h₂, hw₁, hw₂⟩ :
      ∃ w₁ w₂ : E3, ℓ w₁ = 0 ∧ ℓ w₂ = 0 ∧ w₁ ≠ 0 ∧ ∀ s : ℝ, w₂ - s • w₁ ≠ 0 := by
    fin_cases k
    · exact hgen 0 1 2 (by decide) (by decide) (by decide) hk
    · exact hgen 1 0 2 (by decide) (by decide) (by decide) hk
    · exact hgen 2 0 1 (by decide) (by decide) (by decide) hk
  
  have hq₁ : 0 < B w₁ w₁ := hBpos w₁ hw₁
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = B w₁ w₂ / B w₁ w₁ := ⟨_, rfl⟩
  have hq₂ : 0 < B (w₂ - c • w₁) (w₂ - c • w₁) := hBpos _ (hw₂ c)
  have horth : B w₁ (w₂ - c • w₁) = 0 := by
    rw [hBsubR, hBsmulR, hc, div_mul_cancel₀ _ hq₁.ne', sub_self]
  have horth' : B (w₂ - c • w₁) w₁ = 0 := by rw [hBsymm, horth]
  have hnorm1 : ∀ (u : E3), 0 < B u u →
      B ((Real.sqrt (B u u))⁻¹ • u) ((Real.sqrt (B u u))⁻¹ • u) = 1 := by
    intro u hu
    rw [hBsmulL, hBsmulR, ← mul_assoc, ← mul_inv, Real.mul_self_sqrt hu.le,
      inv_mul_cancel₀ hu.ne']
  obtain ⟨u₁, u₂, hℓ₁, hℓ₂, hQ₁, hQ₂, hB₁₂, hB₂₁⟩ : ∃ u₁ u₂ : E3, ℓ u₁ = 0 ∧ ℓ u₂ = 0 ∧
      B u₁ u₁ = 1 ∧ B u₂ u₂ = 1 ∧ B u₁ u₂ = 0 ∧ B u₂ u₁ = 0 := by
    refine ⟨(Real.sqrt (B w₁ w₁))⁻¹ • w₁,
      (Real.sqrt (B (w₂ - c • w₁) (w₂ - c • w₁)))⁻¹ • (w₂ - c • w₁),
      ?_, ?_, hnorm1 _ hq₁, hnorm1 _ hq₂, ?_, ?_⟩
    · rw [map_smul, h₁, smul_zero]
    · rw [map_smul, map_sub, map_smul, h₁, h₂, smul_zero, sub_zero, smul_zero]
    · rw [hBsmulL, hBsmulR, horth, mul_zero, mul_zero]
    · rw [hBsmulL, hBsmulR, horth', mul_zero, mul_zero]
  
  let L : E2 →L[ℝ] E3 := (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 2)).smulRight u₁ +
    (EuclideanSpace.proj (𝕜 := ℝ) (1 : Fin 2)).smulRight u₂
  have hL : ∀ x : E2, L x = x 0 • u₁ + x 1 • u₂ := by
    intro x
    rfl
  refine ⟨L, ?_, ?_⟩
  · intro x
    rw [hL, map_add, map_smul, map_smul, hℓ₁, hℓ₂, smul_zero, smul_zero, add_zero]
  · intro x
    rw [← hB, hL]
    simp only [hBaddL, hBaddR, hBsmulL, hBsmulR, hQ₁, hQ₂, hB₁₂, hB₂₁]
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two,
      Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs]
    ring

theorem surface_radial_geodesic_map [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ ρ₂ : ℝ, 0 < ρ₂ ∧ ∀ Sig : Set M, IsCompact Sig → IsMinimalSurfaceSet g Sig → ∀ q ∈ Sig, q ∈ (chartAt E3 z).source → chartAt E3 z q ∈ Metric.ball (chartAt E3 z z) r → ∃ F : E2 → E3, F 0 = chartAt E3 z q ∧ ContDiffOn ℝ ∞ F (Metric.ball 0 ρ₂) ∧ ∀ x ∈ Metric.ball (0 : E2) ρ₂, F x ∈ Metric.ball (chartAt E3 z z) (2 * r) ∧ (chartAt E3 z).symm (F x) ∈ Sig ∧ ∑ k : Fin 3, ∑ l : Fin 3, (fderiv ℝ F x x) k * g.coeff (chartAt E3 z).symm (F x) k l * (fderiv ℝ F x x) l = ‖x‖ ^ 2 ∧ ∀ w : E2, ∑ k : Fin 3, ∑ l : Fin 3, ((fderiv ℝ (fderiv ℝ F) x x x) k + ∑ a : Fin 3, ∑ b : Fin 3, christoffel (g.coeff (chartAt E3 z).symm) k a b (F x) * (fderiv ℝ F x x) a * (fderiv ℝ F x x) b) * g.coeff (chartAt E3 z).symm (F x) k l * (fderiv ℝ F x w) l = 0 :=
by
  classical
  obtain ⟨m, hm, hmG⟩ := chart_metric_lower_bound g z r hball
  have hsm : 0 < Real.sqrt m := Real.sqrt_pos.mpr hm
  have hsq : Real.sqrt m ^ 2 = m := Real.sq_sqrt hm.le
  refine ⟨r * Real.sqrt m / 2, by positivity, ?_⟩
  intro Sig _hSc hSm q hq hqs hqb
  obtain ⟨hscpt, N, W, Φ, hWΦ, hcov0⟩ := minimal_set_chart_cover g z r hr hball Sig hSm
  have hy0t : chartAt E3 z q ∈ (chartAt E3 z).target := (chartAt E3 z).map_source hqs
  have hy0S : (chartAt E3 z).symm (chartAt E3 z q) ∈ Sig := by
    rw [(chartAt E3 z).left_inv hqs]; exact hq
  set G := g.coeff (chartAt E3 z).symm with hGdef
  set c := chartAt E3 z z with hcdef
  set y₀ := chartAt E3 z q with hy₀def
  
  have hBt : Metric.ball c (4 * r) ⊆ (chartAt E3 z).target :=
    Metric.ball_subset_closedBall.trans hball
  have hGsm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball c (4 * r)) :=
    fun i j => (g.smooth z i j).mono hBt
  have hGs : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i := fun y i j => g.symm _ _ _
  have hGpd : ∀ y ∈ Metric.ball c (4 * r), (G y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y (hBt hy)
  have hmO : ∀ y ∈ Metric.ball c (4 * r), ∀ v : E3,
      m * ‖v‖ ^ 2 ≤ ∑ k : Fin 3, ∑ l : Fin 3, v k * G y k l * v l :=
    fun y hy v => hmG y (Metric.ball_subset_closedBall hy) v
  have hZO : Metric.closedBall c (3 * r) ⊆ Metric.ball c (4 * r) :=
    Metric.closedBall_subset_ball (by linarith)
  have hqb' : dist y₀ c < r := hqb
  have hy0Z : y₀ ∈ Metric.closedBall c (3 * r) := by
    rw [Metric.mem_closedBall]; linarith
  
  have hSZ : IsClosed ({y : E3 | (chartAt E3 z).symm y ∈ Sig} ∩ Metric.closedBall c (3 * r)) := by
    have he : {y : E3 | (chartAt E3 z).symm y ∈ Sig} ∩ Metric.closedBall c (3 * r) =
        {y : E3 | y ∈ Metric.closedBall c (3 * r) ∧ (chartAt E3 z).symm y ∈ Sig} := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq]
      exact and_comm
