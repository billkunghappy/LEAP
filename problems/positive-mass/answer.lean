          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0}) →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ A →
        h p = w p * Real.sqrt (g.gradInner u u p)) →
      MeasureTheory.IntegrableOn
          (fun t => sbgbSliceInt g u q φ (sternDomain (hAF.ends k) β Y L) t w) A ∧
        calVolSum g q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) h =
