          (fun y => g (y / k) y) hk.ne'
        beta_reduce at e2
        have e3 : ∫ x in s₁..s₂, g (k * x / k) (k * x) = ∫ x in s₁..s₂, g x (k * x) := by
          refine intervalIntegral.integral_congr (fun x _ => ?_)
          rw [mul_div_cancel_left₀ x hk.ne']
        rw [e3, smul_eq_mul] at e2
        rw [e1, e2, ← mul_assoc, mul_inv_cancel₀ hk.ne', one_mul]
      have hleft : ∫ y in (-(k * s₂))..(-(k * s₁)), g (a y) y =
          k * ∫ x in s₁..s₂, g x (-(k * x)) := by
        have e1 : ∫ y in (-(k * s₂))..(-(k * s₁)), g (a y) y =
            ∫ y in (-(k * s₂))..(-(k * s₁)), g (-y / k) y := by
          refine intervalIntegral.integral_congr (fun y hy => ?_)
          rw [Set.uIcc_of_le (by linarith)] at hy
          have hy0 : y ≤ 0 := by linarith [hy.2]
          rw [hay, abs_of_nonpos hy0, max_eq_right (by rw [le_div_iff₀ hk]; linarith [hy.2])]
        have e2 := intervalIntegral.integral_comp_mul_left (a := s₁) (b := s₂)
          (fun y => g (-y / k) y) (neg_ne_zero.mpr hk.ne')
        beta_reduce at e2
        have e3 : ∫ x in s₁..s₂, g (-(-k * x) / k) (-k * x) =
            ∫ x in s₁..s₂, g x (-(k * x)) := by
          refine intervalIntegral.integral_congr (fun x _ => ?_)
          rw [neg_mul, neg_neg, mul_div_cancel_left₀ x hk.ne']
        rw [e3, neg_mul, neg_mul, intervalIntegral.integral_symm (-(k * s₂)) (-(k * s₁)),
          smul_eq_mul] at e2
        rw [e1, e2, inv_neg, neg_mul_neg, ← mul_assoc, mul_inv_cancel₀ hk.ne', one_mul]
      have hLow : ∫ y in Set.Ioo (-(k * s₂)) (k * s₂), g (a y) y =
          k * (∫ x in Set.Ioo s₁ s₂, g x (-(k * x))) +
            (∫ y in Set.Ioo (-(k * s₁)) (k * s₁), g s₁ y) +
            k * ∫ x in Set.Ioo s₁ s₂, g x (k * x) := by
        rw [hIoo _ _ _ (by linarith : -(k * s₂) ≤ k * s₂),
          hIoo _ _ _ (by linarith : -(k * s₁) ≤ k * s₁), hIoo _ _ _ hs.le, hIoo _ _ _ hs.le,
          ← intervalIntegral.integral_add_adjacent_intervals (hII (-(k * s₂)) (-(k * s₁)))
            (hII (-(k * s₁)) (k * s₂)),
          ← intervalIntegral.integral_add_adjacent_intervals (hII (-(k * s₁)) (k * s₁))
            (hII (k * s₁) (k * s₂)), hmid, hright, hleft]
        ring
      rw [hslice, integral_sub (hint1 _ (hgy s₂) _ _) (hint1 _ hga _ _), hLow,
        integral_add ((hint1 _ hgp _ _).const_mul k) ((hint1 _ hgm _ _).const_mul k),
        integral_const_mul, integral_const_mul]
      ring
    
    rw [hswap3 _ _ _ (hintP _ hu'c)]
    have hc2 : Continuous (fun q : ℝ × ℝ => u s₂ q.1 q.2) :=
      huc.comp (by fun_prop : Continuous fun q : ℝ × ℝ => ((s₂, q.1), q.2))
    have hc1 : Continuous (fun q : ℝ × ℝ => u s₁ q.1 q.2) :=
      huc.comp (by fun_prop : Continuous fun q : ℝ × ℝ => ((s₁, q.1), q.2))
    have hcx : Continuous (fun q : ℝ × ℝ =>
        k * u q.1 (k * q.1) q.2 + k * u q.1 (-(k * q.1)) q.2) := by
      have h1 : Continuous (fun q : ℝ × ℝ => ((q.1, k * q.1), q.2)) := by fun_prop
      have h2 : Continuous (fun q : ℝ × ℝ => ((q.1, -(k * q.1)), q.2)) := by fun_prop
      exact (continuous_const.mul (huc.comp h1)).add (continuous_const.mul (huc.comp h2))
    obtain ⟨e2, i2⟩ := hswap2 _ _ _ (hintR _ (-(k * s₂)) (k * s₂) (-h) h hc2)
    obtain ⟨e1, i1⟩ := hswap2 _ _ _ (hintR _ (-(k * s₁)) (k * s₁) (-h) h hc1)
    obtain ⟨ex, ix⟩ := hswap2 _ _ _ (hintR _ s₁ s₂ (-h) h hcx)
    have i21 : IntegrableOn (fun z =>
        (∫ x in Set.Ioo (-(k * s₂)) (k * s₂), u s₂ (x, z).1 (x, z).2) -
        ∫ x in Set.Ioo (-(k * s₁)) (k * s₁), u s₁ (x, z).1 (x, z).2) (Set.Ioo (-h) h) :=
      i2.sub i1
    rw [e2, e1, ex, ← integral_sub i2 i1, ← integral_sub i21 ix]
    congr 1
    funext z
    exact starX (fun x y => u x y z) (fun x y => u' x y z)
      (huc.comp (continuous_id.prodMk continuous_const : Continuous fun q : ℝ × ℝ => (q, z)))
      (hu'c.comp (continuous_id.prodMk continuous_const : Continuous fun q : ℝ × ℝ => (q, z)))
      (fun x y => hdu x y z)
  have hL : ∫ z in {z : E3 | s₁ < z 0 ∧ z 0 < s₂ ∧ |z 1| < k * z 0 ∧ |z 2| < h},
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z =
      ∫ p in {q : ℝ × ℝ | s₁ < q.1 ∧ q.1 < s₂ ∧ |q.2| < k * q.1} ×ˢ Set.Ioo (-h) h,
        (partialDeriv 0 (fun v => X v 0) (cylPt p.1.1 p.1.2 p.2) +
          partialDeriv 1 (fun v => X v 1) (cylPt p.1.1 p.1.2 p.2) +
          partialDeriv 2 (fun v => X v 2) (cylPt p.1.1 p.1.2 p.2)) := by
    simp_rw [hs1]
    rw [cylPt_setIntegral_eq _ (fun w => partialDeriv 0 (fun v => X v 0) w +
      partialDeriv 1 (fun v => X v 1) w + partialDeriv 2 (fun v => X v 2) w), hpre]
  rw [hL, integral_add (hintP _ ((hu' 0).add (hu' 1))) (hintP _ (hu' 2)),
    integral_add (hintP _ (hu' 0)) (hintP _ (hu' 1))]
  have h0 := prism_dx_flux (fun x y z => X (cylPt x y z) 0)
    (fun x y z => partialDeriv 0 (fun w => X w 0) (cylPt x y z)) (hu 0) (hu' 0)
    (hs4 0).1
  have h1 := prism_dy_flux (fun x y z => X (cylPt x y z) 1)
    (fun x y z => partialDeriv 1 (fun w => X w 1) (cylPt x y z)) (hu 1) (hu' 1)
    (hs4 1).2.1
  have h2 := prism_dz_flux (fun x y z => X (cylPt x y z) 2)
    (fun x y z => partialDeriv 2 (fun w => X w 2) (cylPt x y z)) (hu' 2)
    (hs4 2).2.2.1
  beta_reduce at h0 h1 h2
  have hcp : ∀ (i : Fin 3) (g : ℝ → ℝ), Continuous g →
      Continuous (fun q : ℝ × ℝ => X (cylPt q.1 (g q.1) q.2) i) := fun i g hg =>
    (hXc i).comp (hcc _ _ _ continuous_fst (hg.comp continuous_fst) continuous_snd)
  have hFx : Continuous (fun q : ℝ × ℝ =>
      k * X (cylPt q.1 (k * q.1) q.2) 0 + k * X (cylPt q.1 (-(k * q.1)) q.2) 0) :=
    (continuous_const.mul (hcp 0 _ (continuous_const.mul continuous_id))).add
      (continuous_const.mul (hcp 0 _ (continuous_const.mul continuous_id).neg))
  have hFy : Continuous (fun q : ℝ × ℝ =>
      X (cylPt q.1 (k * q.1) q.2) 1 - X (cylPt q.1 (-(k * q.1)) q.2) 1) :=
    (hcp 1 _ (continuous_const.mul continuous_id)).sub
      (hcp 1 _ (continuous_const.mul continuous_id).neg)
  have hsplit : ∫ p in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h, (k * X (cylPt p.1 (k * p.1) p.2) 0 -
      X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 +
        X (cylPt p.1 (-(k * p.1)) p.2) 1)) =
      (∫ q in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h,
        (k * X (cylPt q.1 (k * q.1) q.2) 0 + k * X (cylPt q.1 (-(k * q.1)) q.2) 0)) -
      ∫ q in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h,
        (X (cylPt q.1 (k * q.1) q.2) 1 - X (cylPt q.1 (-(k * q.1)) q.2) 1) := by
    have e : (fun p : ℝ × ℝ => k * X (cylPt p.1 (k * p.1) p.2) 0 -
        X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 +
          X (cylPt p.1 (-(k * p.1)) p.2) 1)) =
        fun q : ℝ × ℝ => (k * X (cylPt q.1 (k * q.1) q.2) 0 +
          k * X (cylPt q.1 (-(k * q.1)) q.2) 0) -
          (X (cylPt q.1 (k * q.1) q.2) 1 - X (cylPt q.1 (-(k * q.1)) q.2) 1) := by
      funext q; ring
    rw [e]
    exact integral_sub (hintR _ _ _ _ _ hFx) (hintR _ _ _ _ _ hFy)
  rw [h0, h1, h2, hsplit]
  ring

theorem wedge_box_in_open (k a b H : ℝ) (O : Set E3) (hk : 0 < k) (ha : 0 < a) (hO : IsOpen O) (hsub : ∀ z : E3, 0 < z 0 → |z 1| ≤ k * z 0 → z ∈ O) : ∃ k' : ℝ, k < k' ∧ ∀ z : E3, a ≤ z 0 → z 0 ≤ b → |z 1| ≤ k' * z 0 → |z 2| ≤ H → z ∈ O :=
by
  set K : Set E3 := {z : E3 | a ≤ z 0 ∧ z 0 ≤ b ∧ |z 1| ≤ k * z 0 ∧ |z 2| ≤ H} with hKdef
  have hcont : ∀ i : Fin 3, Continuous (fun z : E3 => z i) :=
    fun i => (EuclideanSpace.proj i).continuous
  have hKc : IsClosed K :=
    (isClosed_le continuous_const (hcont 0)).inter ((isClosed_le (hcont 0) continuous_const).inter
      ((isClosed_le (hcont 1).abs (continuous_const.mul (hcont 0))).inter
        (isClosed_le (hcont 2).abs continuous_const)))
  have hnormsq : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hKb : Bornology.IsBounded K := by
    rw [Metric.isBounded_iff_subset_closedBall (0 : E3)]
    refine ⟨|b| + k * |b| + |H|, fun z hz => ?_⟩
    obtain ⟨h1, h2, h3, h4⟩ := hz
    rw [mem_closedBall_zero_iff]
    have e0 : |z 0| ≤ |b| := by
      rw [abs_of_pos (by linarith)]; exact h2.trans (le_abs_self b)
    have e1 : |z 1| ≤ k * |b| :=
      h3.trans (mul_le_mul_of_nonneg_left (h2.trans (le_abs_self b)) hk.le)
    have e2 : |z 2| ≤ |H| := h4.trans (le_abs_self H)
    have hn := hnormsq z
    have s0 : z 0 ^ 2 = |z 0| ^ 2 := (sq_abs _).symm
    have s1 : z 1 ^ 2 = |z 1| ^ 2 := (sq_abs _).symm
    have s2 : z 2 ^ 2 = |z 2| ^ 2 := (sq_abs _).symm
    have p0 := abs_nonneg (z 0)
    have p1 := abs_nonneg (z 1)
    have p2 := abs_nonneg (z 2)
    have hN := norm_nonneg z
    have hR0 : 0 ≤ |b| + k * |b| + |H| := by
      have := abs_nonneg b; have := abs_nonneg H; positivity
    have hsum : |z 0| + |z 1| + |z 2| ≤ |b| + k * |b| + |H| := by linarith
    have hsq : ‖z‖ ^ 2 ≤ (|b| + k * |b| + |H|) ^ 2 := by
      rw [hn, s0, s1, s2]
      nlinarith [mul_nonneg p0 p1, mul_nonneg p1 p2, mul_nonneg p0 p2,
        mul_self_le_mul_self (by positivity) hsum]
    nlinarith
  have hKcpt : IsCompact K := Metric.isCompact_of_isClosed_isBounded hKc hKb
  have hKO : K ⊆ O := by
    intro z hz
    exact hsub z (by linarith [hz.1]) hz.2.2.1
  obtain ⟨δ, hδ, hδO⟩ := hKcpt.exists_thickening_subset_open hO hKO
  have hb1 : 0 < 2 * (|b| + 1) := by positivity
  set d : ℝ := δ / (2 * (|b| + 1)) with hd
  have hdpos : 0 < d := div_pos hδ hb1
  have hdδ : d * (2 * (|b| + 1)) = δ := by rw [hd]; field_simp
  refine ⟨k + d, by linarith, fun z h0 h0b h1 h2 => ?_⟩
  have hz0 : 0 < z 0 := by linarith
  set c : ℝ := max (-(k * z 0)) (min (z 1) (k * z 0)) with hc
  set t : ℝ := z 1 - c with ht
  have hkz : 0 ≤ k * z 0 := by positivity
  have hcabs : |c| ≤ k * z 0 := by
    rw [abs_le]; constructor
    · exact le_max_left _ _
    · exact max_le (by linarith) (min_le_right _ _)
  have htabs : |t| ≤ d * z 0 := by
    rw [abs_le] at h1 ⊢
    obtain ⟨h1a, h1b⟩ := h1
    rw [ht, hc]
    rcases le_total (z 1) (k * z 0) with h | h
    · rw [min_eq_left h]
      rcases le_total (-(k * z 0)) (z 1) with h' | h'
      · rw [max_eq_right h']; constructor <;> nlinarith
      · rw [max_eq_left h']; constructor <;> nlinarith
    · rw [min_eq_right h, max_eq_right (by linarith)]; constructor <;> nlinarith
  set w : E3 := z - EuclideanSpace.single 1 t with hwdef
  have w0 : w 0 = z 0 := by
    simp [hwdef, EuclideanSpace.single_apply]
  have w1 : w 1 = c := by
    simp [hwdef, EuclideanSpace.single_apply, ht]
  have w2 : w 2 = z 2 := by
    simp [hwdef, EuclideanSpace.single_apply]
  have hw : w ∈ K := by
    show a ≤ _ ∧ _ ≤ b ∧ |_| ≤ k * _ ∧ |_| ≤ H
    rw [w0, w1, w2]
    exact ⟨h0, h0b, hcabs, h2⟩
  have hdist : dist z w < δ := by
    rw [hwdef, dist_eq_norm, sub_sub_cancel, EuclideanSpace.norm_single, Real.norm_eq_abs]
    have hzb : z 0 < 2 * (|b| + 1) := by
      have := le_abs_self b; linarith
    calc |t| ≤ d * z 0 := htabs
      _ < d * (2 * (|b| + 1)) := mul_lt_mul_of_pos_left hzb hdpos
      _ = δ := hdδ
  exact hδO (Metric.mem_thickening_iff.2 ⟨_, hw, hdist⟩)

theorem wedge_face_lower_field (k s₁ s₂ h : ℝ) (U : Set E3) (hk : 0 < k) (hs₁ : 0 < s₁) (hs : s₁ < s₂) (hh : 0 < h) (hU : IsOpen U) (hface : ∀ x t : ℝ, s₁ ≤ x → x ≤ s₂ → |t| ≤ h → cylPt x (k * x) t ∈ U ∧ cylPt x (-(k * x)) t ∈ U) : ∃ Y : E3 → E3, ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧ tsupport Y ⊆ U ∧ tsupport Y ⊆ {z : E3 | 0 < z 0} ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * Y y i * Y y j ≤ 1) ∧ 4 * Real.sqrt (1 + k ^ 2) * h * (s₂ - s₁) ≤ ∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), (k * Y (cylPt p.1 (k * p.1) p.2) 0 - Y (cylPt p.1 (k * p.1) p.2) 1 + (k * Y (cylPt p.1 (-(k * p.1)) p.2) 0 + Y (cylPt p.1 (-(k * p.1)) p.2) 1)) :=
by
  have hcont : ∀ i : Fin 3, Continuous (fun z : E3 => z i) :=
    fun i => (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Real.sqrt (1 + k ^ 2) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hcdef]; exact Real.sqrt_pos.mpr (by positivity)
  have hcsq : c ^ 2 = 1 + k ^ 2 := by rw [hcdef]; exact Real.sq_sqrt (by positivity)
  have hcoord : ∀ x a b : ℝ, (cylPt x a b) 0 = x ∧ (cylPt x a b) 1 = a ∧ (cylPt x a b) 2 = b := by
    intro x a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hzero : ∀ (f : E3 → ℝ) (z : E3), z ∉ tsupport f → f z = 0 := by
    intro f z hz
    by_contra hne
    exact hz (subset_tsupport _ hne)
  have hzero2 : ∀ (f : ℝ × ℝ → ℝ) (z : ℝ × ℝ), z ∉ tsupport f → f z = 0 := by
    intro f z hz
    by_contra hne
    exact hz (subset_tsupport _ hne)
  
  have cutoff : ∀ (K V : Set E3), IsCompact K → IsOpen V → K ⊆ V → ∃ η : E3 → ℝ,
      ContDiff ℝ ∞ η ∧ HasCompactSupport η ∧ tsupport η ⊆ V ∧ (∀ z, 0 ≤ η z ∧ η z ≤ 1) ∧
      ∀ z ∈ K, η z = 1 := by
    intro K V hK hV hKV
    obtain ⟨δ, hδ, hδV⟩ := hK.exists_thickening_subset_open hV hKV
    have hT : IsCompact (cthickening (δ / 2) K) := hK.cthickening
    have hTV : cthickening (δ / 2) K ⊆ V :=
      (Metric.cthickening_subset_thickening' hδ (by linarith) K).trans hδV
    have hKT : K ⊆ interior (cthickening (δ / 2) K) :=
      (Metric.self_subset_thickening (by linarith) K).trans
        (interior_maximal (Metric.thickening_subset_cthickening _ _) Metric.isOpen_thickening)
    obtain ⟨f, hf1, hf0, hf01⟩ :=
      exists_contMDiffMap_one_nhds_of_subset_interior 𝓘(ℝ, E3) (n := ⊤) hK.isClosed hKT
    refine ⟨f, ?_, ?_, ?_, ?_, ?_⟩
    · exact contMDiff_iff_contDiff.mp f.contMDiff
    · exact HasCompactSupport.intro hT hf0
    · have hsub : tsupport f ⊆ cthickening (δ / 2) K := by
        refine closure_minimal ?_ Metric.isClosed_cthickening
        intro x hx
        by_contra hn
        exact hx (hf0 x hn)
      exact hsub.trans hTV
    · intro z
      exact hf01 z
    · intro z hz
      exact hf1.self_of_nhdsSet z hz
  
  have hcP : ∀ a : ℝ → ℝ, Continuous a →
      Continuous (fun p : ℝ × ℝ => cylPt p.1 (a p.1) p.2) := by
    intro a ha
    simp only [cylPt]
    fun_prop
  have hcs : ∀ (a : ℝ → ℝ) (η : E3 → ℝ), HasCompactSupport η →
      HasCompactSupport (fun p : ℝ × ℝ => η (cylPt p.1 (a p.1) p.2)) := by
    intro a η hη
    obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.mp hη.isCompact.isBounded
    refine HasCompactSupport.intro
      (isCompact_Icc.prod isCompact_Icc : IsCompact (Set.Icc (-C) C ×ˢ Set.Icc (-C) C)) ?_
    intro p hp
    by_contra hne
    have hz := hC _ (subset_tsupport _ hne)
    obtain ⟨a1, _, a3⟩ := hcoord p.1 (a p.1) p.2
    have n0 := PiLp.norm_apply_le (cylPt p.1 (a p.1) p.2) 0
    have n2 := PiLp.norm_apply_le (cylPt p.1 (a p.1) p.2) 2
    rw [a1, Real.norm_eq_abs] at n0
    rw [a3, Real.norm_eq_abs] at n2
    exact hp ⟨abs_le.mp (by linarith), abs_le.mp (by linarith)⟩
  obtain ⟨Rc, hRcdef⟩ : ∃ Rc : Set (ℝ × ℝ), Rc = Set.Icc s₁ s₂ ×ˢ Set.Icc (-h) h := ⟨_, rfl⟩
  have hRcc : IsCompact Rc := by rw [hRcdef]; exact isCompact_Icc.prod isCompact_Icc
  have hcPp := hcP (fun x => k * x) (by fun_prop)
  have hcPm := hcP (fun x => -(k * x)) (by fun_prop)
  obtain ⟨Up, hUpdef⟩ : ∃ Up : Set E3, Up = U ∩ {z | 0 < z 0} ∩ {z | 0 < z 1} := ⟨_, rfl⟩
  obtain ⟨Um, hUmdef⟩ : ∃ Um : Set E3, Um = U ∩ {z | 0 < z 0} ∩ {z | z 1 < 0} := ⟨_, rfl⟩
  have hUpo : IsOpen Up := by
    rw [hUpdef]
    exact (hU.inter (isOpen_lt continuous_const (hcont 0))).inter
      (isOpen_lt continuous_const (hcont 1))
  have hUmo : IsOpen Um := by
    rw [hUmdef]
    exact (hU.inter (isOpen_lt continuous_const (hcont 0))).inter
      (isOpen_lt (hcont 1) continuous_const)
  have hKp : (fun p : ℝ × ℝ => cylPt p.1 (k * p.1) p.2) '' Rc ⊆ Up := by
    rintro _ ⟨p, hp, rfl⟩
    rw [hRcdef] at hp
    obtain ⟨⟨hx1, hx2⟩, ⟨ht1, ht2⟩⟩ := hp
    obtain ⟨a1, a2, _⟩ := hcoord p.1 (k * p.1) p.2
    rw [hUpdef]
    refine ⟨⟨(hface p.1 p.2 hx1 hx2 (abs_le.mpr ⟨ht1, ht2⟩)).1, ?_⟩, ?_⟩
    · show 0 < (cylPt p.1 (k * p.1) p.2) 0
      rw [a1]; linarith
    · show 0 < (cylPt p.1 (k * p.1) p.2) 1
      rw [a2]; exact mul_pos hk (by linarith)
  have hKm : (fun p : ℝ × ℝ => cylPt p.1 (-(k * p.1)) p.2) '' Rc ⊆ Um := by
    rintro _ ⟨p, hp, rfl⟩
    rw [hRcdef] at hp
    obtain ⟨⟨hx1, hx2⟩, ⟨ht1, ht2⟩⟩ := hp
    obtain ⟨a1, a2, _⟩ := hcoord p.1 (-(k * p.1)) p.2
    rw [hUmdef]
    refine ⟨⟨(hface p.1 p.2 hx1 hx2 (abs_le.mpr ⟨ht1, ht2⟩)).2, ?_⟩, ?_⟩
    · show 0 < (cylPt p.1 (-(k * p.1)) p.2) 0
      rw [a1]; linarith
    · show (cylPt p.1 (-(k * p.1)) p.2) 1 < 0
      rw [a2]
      have := mul_pos hk (show 0 < p.1 by linarith)
      linarith
  obtain ⟨ηp, hηps, hηpc, hηpV, hηp01, hηp1⟩ :=
    cutoff _ Up (hRcc.image hcPp) hUpo hKp
  obtain ⟨ηm, hηms, hηmc, hηmV, hηm01, hηm1⟩ :=
    cutoff _ Um (hRcc.image hcPm) hUmo hKm
  have F1p : ∀ z, ηp z ≠ 0 → z ∈ U ∧ 0 < z 0 ∧ 0 < z 1 := by
    intro z hz
    have hzU := hηpV (subset_tsupport _ hz)
    rw [hUpdef] at hzU
    exact ⟨hzU.1.1, hzU.1.2, hzU.2⟩
  have F1m : ∀ z, ηm z ≠ 0 → z ∈ U ∧ 0 < z 0 ∧ z 1 < 0 := by
    intro z hz
    have hzU := hηmV (subset_tsupport _ hz)
    rw [hUmdef] at hzU
    exact ⟨hzU.1.1, hzU.1.2, hzU.2⟩
  have F2 : ∀ z, ηp z = 0 ∨ ηm z = 0 := by
    intro z
    by_contra hcon
    push_neg at hcon
    have h1 := (F1p z hcon.1).2.2
    have h2 := (F1m z hcon.2).2.2
    linarith
  have F3a : ∀ x t : ℝ, ηm (cylPt x (k * x) t) = 0 := by
    intro x t
    by_contra hne
    obtain ⟨_, h0, h1⟩ := F1m _ hne
    obtain ⟨a1, a2, _⟩ := hcoord x (k * x) t
    rw [a1] at h0
    rw [a2] at h1
    have := mul_pos hk h0
    linarith
  have F3b : ∀ x t : ℝ, ηp (cylPt x (-(k * x)) t) = 0 := by
    intro x t
    by_contra hne
    obtain ⟨_, h0, h1⟩ := F1p _ hne
    obtain ⟨a1, a2, _⟩ := hcoord x (-(k * x)) t
    rw [a1] at h0
    rw [a2] at h1
    have := mul_pos hk h0
    linarith
  
  obtain ⟨Y, hY⟩ : ∃ Y : E3 → E3, Y = fun z =>
      ((ηp z + ηm z) * (k / c)) • e 0 + ((ηm z - ηp z) / c) • e 1 := ⟨_, rfl⟩
  have hY0 : ∀ z, Y z 0 = (ηp z + ηm z) * (k / c) := by
    intro z; rw [hY]; simp [EuclideanSpace.single_apply]
  have hY1 : ∀ z, Y z 1 = (ηm z - ηp z) / c := by
    intro z; rw [hY]; simp [EuclideanSpace.single_apply]
  have hY2 : ∀ z, Y z 2 = 0 := by
    intro z; rw [hY]; simp [EuclideanSpace.single_apply]
  have hYz : ∀ z, ηp z = 0 → ηm z = 0 → Y z = 0 := by
    intro z h1 h2
    rw [hY]
    simp [h1, h2]
  have hKc : IsCompact (tsupport ηp ∪ tsupport ηm) := hηpc.isCompact.union hηmc.isCompact
  have hsuppY : Function.support Y ⊆ tsupport ηp ∪ tsupport ηm := by
    intro z hz
    by_contra hn
    rw [Set.mem_union, not_or] at hn
    exact hz (hYz z (hzero _ _ hn.1) (hzero _ _ hn.2))
  have htsY : tsupport Y ⊆ tsupport ηp ∪ tsupport ηm :=
    closure_minimal hsuppY ((isClosed_tsupport _).union (isClosed_tsupport _))
  have htsU : tsupport ηp ∪ tsupport ηm ⊆ U ∩ {z : E3 | 0 < z 0} := by
    rintro z (hz | hz)
    · have := hηpV hz
      rw [hUpdef] at this
      exact this.1
    · have := hηmV hz
      rw [hUmdef] at this
      exact this.1
  refine ⟨Y, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hY]
    fun_prop
  · refine HasCompactSupport.intro hKc ?_
    intro z hz
    by_contra hne
    exact hz (hsuppY hne)
  · exact fun z hz => (htsU (htsY hz)).1
  · exact fun z hz => (htsU (htsY hz)).2
  · intro y
    have hsum : ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * Y y i * Y y j =
        Y y 0 ^ 2 + Y y 1 ^ 2 + Y y 2 ^ 2 := by
      simp [Fin.sum_univ_three, Matrix.one_apply]
      ring
    rw [hsum, hY0, hY1, hY2]
    obtain ⟨a0, a1⟩ := hηp01 y
    obtain ⟨b0, b1⟩ := hηm01 y
    rcases F2 y with h0 | h0
    · rw [h0]
      have e1 : ((0 + ηm y) * (k / c)) ^ 2 + ((ηm y - 0) / c) ^ 2 + (0:ℝ) ^ 2 =
          ηm y ^ 2 * ((1 + k ^ 2) / c ^ 2) := by ring
      rw [e1, ← hcsq, div_self (by positivity), mul_one]
      nlinarith
    · rw [h0]
      have e1 : ((ηp y + 0) * (k / c)) ^ 2 + ((0 - ηp y) / c) ^ 2 + (0:ℝ) ^ 2 =
          ηp y ^ 2 * ((1 + k ^ 2) / c ^ 2) := by ring
      rw [e1, ← hcsq, div_self (by positivity), mul_one]
      nlinarith
  · 
    obtain ⟨G, hGdef⟩ : ∃ G : ℝ × ℝ → ℝ, G = fun p =>
        c * ηp (cylPt p.1 (k * p.1) p.2) + c * ηm (cylPt p.1 (-(k * p.1)) p.2) := ⟨_, rfl⟩
    have heq : ∀ p : ℝ × ℝ,
        k * Y (cylPt p.1 (k * p.1) p.2) 0 - Y (cylPt p.1 (k * p.1) p.2) 1 +
          (k * Y (cylPt p.1 (-(k * p.1)) p.2) 0 + Y (cylPt p.1 (-(k * p.1)) p.2) 1) = G p := by
      intro p
      rw [hGdef, hY0, hY1, hY0, hY1, F3a, F3b]
      have e1 : ∀ a b : ℝ, k * ((a + 0) * (k / c)) - (0 - a) / c +
          (k * ((0 + b) * (k / c)) + (b - 0) / c) = (a + b) * ((1 + k ^ 2) / c) := by
        intro a b; ring
      rw [e1, ← hcsq]
      field_simp
    have hGcont : Continuous G := by
      rw [hGdef]
      exact (continuous_const.mul (hηps.continuous.comp hcPp)).add
        (continuous_const.mul (hηms.continuous.comp hcPm))
    have hA := hcs (fun x => k * x) ηp hηpc
    have hB := hcs (fun x => -(k * x)) ηm hηmc
    have hGcs : HasCompactSupport G := by
      refine HasCompactSupport.intro (hA.isCompact.union hB.isCompact) ?_
      intro p hp
      rw [Set.mem_union, not_or] at hp
      have h1 := hzero2 _ _ hp.1
      have h2 := hzero2 _ _ hp.2
      simp only at h1 h2
      rw [hGdef]
      simp only
      rw [h1, h2]
      ring
    have hG0 : ∀ p, 0 ≤ G p := by
      intro p
      rw [hGdef]
      have := (hηp01 (cylPt p.1 (k * p.1) p.2)).1
      have := (hηm01 (cylPt p.1 (-(k * p.1)) p.2)).1
      positivity
    have hGR : ∀ p ∈ Rc, 2 * c ≤ G p := by
      intro p hp
      rw [hGdef]
      simp only
      rw [hηp1 (cylPt p.1 (k * p.1) p.2) ⟨p, hp, rfl⟩,
        hηm1 (cylPt p.1 (-(k * p.1)) p.2) ⟨p, hp, rfl⟩]
      linarith
    have hGint : Integrable G := hGcont.integrable_of_hasCompactSupport hGcs
    have hD : MeasurableSet (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ)) :=
      measurableSet_Ioi.prod MeasurableSet.univ
    have hR : MeasurableSet Rc := by rw [hRcdef]; exact measurableSet_Icc.prod measurableSet_Icc
    have hRD : Rc ⊆ Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ) := by
      intro p hp
      rw [hRcdef] at hp
      exact ⟨lt_of_lt_of_le hs₁ hp.1.1, trivial⟩
    have h1 : ∫ p in Rc, G p ≤ ∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), G p :=
      setIntegral_mono_set hGint.integrableOn (ae_restrict_of_forall_mem hD (fun p _ => hG0 p))
        hRD.eventuallyLE
    have hRfin : volume Rc ≠ ⊤ := hRcc.measure_lt_top.ne
    have h2 : volume.real Rc • (2 * c) ≤ ∫ p in Rc, G p :=
      setIntegral_ge_of_const_le hR hRfin hGR hGint.integrableOn
    have h3 : volume.real Rc = (s₂ - s₁) * (h - -h) := by
      rw [hRcdef, Measure.volume_eq_prod ℝ ℝ, measureReal_prod_prod, Real.volume_real_Icc,
        Real.volume_real_Icc, max_eq_left (by linarith), max_eq_left (by linarith)]
    have h4 : 4 * c * h * (s₂ - s₁) = volume.real Rc • (2 * c) := by
      rw [h3, smul_eq_mul]; ring
    have h5 : ∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), G p =
        ∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ),
          (k * Y (cylPt p.1 (k * p.1) p.2) 0 - Y (cylPt p.1 (k * p.1) p.2) 1 +
          (k * Y (cylPt p.1 (-(k * p.1)) p.2) 0 + Y (cylPt p.1 (-(k * p.1)) p.2) 1)) := by
      congr 1
      funext p
      exact (heq p).symm
    rw [← hcdef, ← h5, h4]
    exact h2.trans h1

theorem wedge_face_upper_bound (k s₁ s₂ h a₁ a₂ H : ℝ) (X : E3 → E3) (hk : 0 < k) (ha₁ : 0 < a₁) (h1 : a₁ ≤ s₁) (hs : s₁ < s₂) (h2 : s₂ ≤ a₂) (hh : 0 < h) (hH : h ≤ H) (hX : Continuous X) (hsupp : ∀ z : E3, X z ≠ 0 → a₁ < z 0 ∧ z 0 < a₂ ∧ |z 2| < H) (hbd : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * X y i * X y j ≤ 1) : (∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), (k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1))) + (-(∫ p in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h, (k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1))) + (∫ p in Set.Ioo (-(k * s₂)) (k * s₂) ×ˢ Set.Ioo (-h) h, X (cylPt s₂ p.1 p.2) 0) - (∫ p in Set.Ioo (-(k * s₁)) (k * s₁) ×ˢ Set.Ioo (-h) h, X (cylPt s₁ p.1 p.2) 0) + (∫ p in {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1}, (X (cylPt p.1 p.2 h) 2 - X (cylPt p.1 p.2 (-h)) 2))) ≤ 2 * Real.sqrt (1 + k ^ 2) * ((a₂ - a₁) * (2 * H) - (s₂ - s₁) * (2 * h)) + 4 * k * h * (s₁ + s₂) + 4 * k * s₂ * (s₂ - s₁) :=
by
  
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hcoord : ∀ i : Fin 3, Continuous (fun z : E3 => z i) :=
    fun i => (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  
  have hsq : ∀ y, X y 0 ^ 2 + X y 1 ^ 2 + X y 2 ^ 2 ≤ 1 := by
    intro y
    have h := hbd y
    have e : ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * X y i * X y j =
        X y 0 ^ 2 + X y 1 ^ 2 + X y 2 ^ 2 := by
      simp only [Fin.sum_univ_three, Matrix.one_apply_eq,
        Matrix.one_apply_ne (show (0:Fin 3) ≠ 1 by decide),
        Matrix.one_apply_ne (show (0:Fin 3) ≠ 2 by decide),
        Matrix.one_apply_ne (show (1:Fin 3) ≠ 0 by decide),
        Matrix.one_apply_ne (show (1:Fin 3) ≠ 2 by decide),
        Matrix.one_apply_ne (show (2:Fin 3) ≠ 0 by decide),
        Matrix.one_apply_ne (show (2:Fin 3) ≠ 1 by decide)]
      ring
    rw [e] at h
    exact h
  have hab0 : ∀ y, |X y 0| ≤ 1 := fun y => by
    have h := hsq y
    exact (sq_le_one_iff_abs_le_one _).mp (by nlinarith [sq_nonneg (X y 1), sq_nonneg (X y 2)])
  have hab2 : ∀ y, |X y 2| ≤ 1 := fun y => by
    have h := hsq y
    exact (sq_le_one_iff_abs_le_one _).mp (by nlinarith [sq_nonneg (X y 1), sq_nonneg (X y 0)])
  have hk2 : (0:ℝ) ≤ 1 + k ^ 2 := by positivity
  have hm : ∀ y, |k * X y 0 - X y 1| ≤ Real.sqrt (1 + k ^ 2) := fun y => by
    apply Real.abs_le_sqrt
    have h := hsq y
    have h' : 0 ≤ 1 - X y 0 ^ 2 - X y 1 ^ 2 := by nlinarith [sq_nonneg (X y 2)]
    nlinarith [sq_nonneg (X y 0 + k * X y 1), mul_nonneg hk2 h']
  have hp : ∀ y, |k * X y 0 + X y 1| ≤ Real.sqrt (1 + k ^ 2) := fun y => by
    apply Real.abs_le_sqrt
    have h := hsq y
    have h' : 0 ≤ 1 - X y 0 ^ 2 - X y 1 ^ 2 := by nlinarith [sq_nonneg (X y 2)]
    nlinarith [sq_nonneg (X y 0 - k * X y 1), mul_nonneg hk2 h']
  
  have hrect : ∀ a b c d : ℝ, volume (Set.Ioo a b ×ˢ Set.Ioo c d : Set (ℝ × ℝ)) =
      ENNReal.ofReal (b - a) * ENNReal.ofReal (d - c) := by
    intro a b c d
    rw [Measure.volume_eq_prod, Measure.prod_prod, Real.volume_Ioo, Real.volume_Ioo]
  have hrect_lt : ∀ a b c d : ℝ, volume (Set.Ioo a b ×ˢ Set.Ioo c d : Set (ℝ × ℝ)) < ⊤ := by
    intro a b c d
    rw [hrect]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
  have hrectReal : ∀ a b c d : ℝ, a ≤ b → c ≤ d →
      volume.real (Set.Ioo a b ×ˢ Set.Ioo c d : Set (ℝ × ℝ)) = (b - a) * (d - c) := by
    intro a b c d hab hcd
    rw [measureReal_def, hrect, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by linarith),
      ENNReal.toReal_ofReal (by linarith)]
  
  have hrectInt : ∀ (G : ℝ × ℝ → ℝ) (A B : ℝ), 0 ≤ A → 0 ≤ B → (∀ p, |G p| ≤ 1) →
      |∫ p in Set.Ioo (-A) A ×ˢ Set.Ioo (-B) B, G p| ≤ (2 * A) * (2 * B) := by
    intro G A B hA hB hG
    have h : ‖∫ p in Set.Ioo (-A) A ×ˢ Set.Ioo (-B) B, G p‖ ≤
        1 * volume.real (Set.Ioo (-A) A ×ˢ Set.Ioo (-B) B : Set (ℝ × ℝ)) :=
      norm_setIntegral_le_of_norm_le_const (hrect_lt (-A) A (-B) B)
        (fun p _ => by rw [Real.norm_eq_abs]; exact hG p)
    rw [Real.norm_eq_abs, hrectReal _ _ _ _ (by linarith) (by linarith)] at h
    calc _ ≤ _ := h
      _ = (2 * A) * (2 * B) := by ring
  
  have htrap : ∀ (G : ℝ × ℝ → ℝ), (∀ p, |G p| ≤ 2) →
      ∫ p in {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1}, G p ≤ 4 * k * s₂ * (s₂ - s₁) := by
    intro G hG
    have hs₁ : 0 < s₁ := lt_of_lt_of_le ha₁ h1
    have hsub : {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1} ⊆
        Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-(k * s₂)) (k * s₂) := by
      rintro p ⟨hp1, hp2, hp3⟩
      have hk' : k * p.1 < k * s₂ := mul_lt_mul_of_pos_left hp2 hk
      have := abs_lt.mp (lt_trans hp3 hk')
      exact ⟨⟨hp1, hp2⟩, this.1, this.2⟩
    have hTlt := lt_of_le_of_lt (measure_mono hsub) (hrect_lt s₁ s₂ (-(k * s₂)) (k * s₂))
    have h : ‖∫ p in {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1}, G p‖ ≤
        2 * volume.real {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1} :=
      norm_setIntegral_le_of_norm_le_const hTlt
        (fun p _ => by rw [Real.norm_eq_abs]; exact hG p)
    rw [Real.norm_eq_abs] at h
    have hmono := measureReal_mono hsub (hrect_lt s₁ s₂ (-(k * s₂)) (k * s₂)).ne
    have hks : 0 < k * s₂ := mul_pos hk (by linarith)
    rw [hrectReal _ _ _ _ hs.le (by linarith)] at hmono
    have := le_abs_self (∫ p in {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1}, G p)
    have e : 2 * ((s₂ - s₁) * (k * s₂ - -(k * s₂))) = 4 * k * s₂ * (s₂ - s₁) := by ring
    linarith
  
  have hface : ∀ (F : ℝ × ℝ → ℝ) (C : ℝ), Continuous F → (∀ p, |F p| ≤ C) →
      (∀ p : ℝ × ℝ, F p ≠ 0 → a₁ < p.1 ∧ p.1 < a₂ ∧ |p.2| < H) →
      (∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), F p) -
        (∫ p in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h, F p) ≤
        C * ((a₂ - a₁) * (2 * H) - (s₂ - s₁) * (2 * h)) := by
    intro F C hF hFb hFs
    have hoff : ∀ p, p ∉ Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H → F p = 0 := by
      intro p hp
      by_contra hne
      obtain ⟨q1, q2, q3⟩ := hFs p hne
      exact hp ⟨⟨q1, q2⟩, (abs_lt.mp q3).1, (abs_lt.mp q3).2⟩
    have hcs : HasCompactSupport F := by
      refine HasCompactSupport.intro (isCompact_Icc.prod isCompact_Icc :
        IsCompact (Set.Icc a₁ a₂ ×ˢ Set.Icc (-H) H)) ?_
      intro p hp
      apply hoff
      rintro ⟨⟨q1, q2⟩, q3, q4⟩
      exact hp ⟨⟨q1.le, q2.le⟩, q3.le, q4.le⟩
    have hint : Integrable F := hF.integrable_of_hasCompactSupport hcs
    have hQR : Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h ⊆ Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H := by
      rintro p ⟨⟨q1, q2⟩, q3, q4⟩
      exact ⟨⟨by linarith, by linarith⟩, by linarith, by linarith⟩
    have hRD : Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H ⊆ Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ) := by
      rintro p ⟨⟨q1, q2⟩, q3, q4⟩
      exact ⟨show (0:ℝ) < p.1 by linarith, Set.mem_univ _⟩
    have hDmeas : MeasurableSet (Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ)) :=
      measurableSet_Ioi.prod MeasurableSet.univ
    have hQmeas : MeasurableSet (Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h) :=
      measurableSet_Ioo.prod measurableSet_Ioo
    have e1 : (∫ p in Set.Ioi (0:ℝ) ×ˢ (Set.univ : Set ℝ), F p) =
        ∫ p in Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H, F p :=
      setIntegral_eq_of_subset_of_forall_diff_eq_zero hDmeas hRD (fun p hp => hoff p hp.2)
    have e2 := integral_diff hQmeas hint.integrableOn hQR
    have hdlt : volume ((Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H) \ (Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h)) < ⊤ :=
      lt_of_le_of_lt (measure_mono Set.diff_subset) (hrect_lt _ _ _ _)
    have hb : ‖∫ p in (Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H) \ (Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h), F p‖ ≤
        C * volume.real ((Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H) \ (Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h)) :=
      norm_setIntegral_le_of_norm_le_const hdlt
        (fun p _ => by rw [Real.norm_eq_abs]; exact hFb p)
    rw [Real.norm_eq_abs] at hb
    have hvol := measureReal_diff (μ := (volume : Measure (ℝ × ℝ))) hQR
      hQmeas (hrect_lt a₁ a₂ (-H) H).ne
    rw [hrectReal a₁ a₂ (-H) H (by linarith) (by linarith),
      hrectReal s₁ s₂ (-h) h (by linarith) (by linarith)] at hvol
    rw [hvol] at hb
    have := le_abs_self
      (∫ p in (Set.Ioo a₁ a₂ ×ˢ Set.Ioo (-H) H) \ (Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h), F p)
    rw [e1, ← e2]
    calc _ ≤ _ := this
      _ ≤ _ := hb
      _ = C * ((a₂ - a₁) * (2 * H) - (s₂ - s₁) * (2 * h)) := by ring
  
  have hPcont : ∀ σ : ℝ, Continuous (fun p : ℝ × ℝ => cylPt p.1 (σ * (k * p.1)) p.2) := by
    intro σ
    unfold cylPt
    fun_prop
  have hFcont : Continuous (fun p : ℝ × ℝ =>
      k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 +
        (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1)) := by
    have c1 : Continuous (fun p : ℝ × ℝ => X (cylPt p.1 (k * p.1) p.2)) := by
      have := hX.comp (hPcont 1)
      simpa [Function.comp_def] using this
    have c2 : Continuous (fun p : ℝ × ℝ => X (cylPt p.1 (-(k * p.1)) p.2)) := by
      have := hX.comp (hPcont (-1))
      simpa [Function.comp_def] using this
    have d10 := (hcoord 0).comp c1
    have d11 := (hcoord 1).comp c1
    have d20 := (hcoord 0).comp c2
    have d21 := (hcoord 1).comp c2
    exact ((continuous_const.mul d10).sub d11).add ((continuous_const.mul d20).add d21)
  have hFbd : ∀ p : ℝ × ℝ, |k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 +
        (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1)| ≤
        2 * Real.sqrt (1 + k ^ 2) := by
    intro p
    have := abs_add_le (k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1)
      (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1)
    linarith [hm (cylPt p.1 (k * p.1) p.2), hp (cylPt p.1 (-(k * p.1)) p.2)]
  have hFsupp : ∀ p : ℝ × ℝ, k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 +
        (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1) ≠ 0 →
        a₁ < p.1 ∧ p.1 < a₂ ∧ |p.2| < H := by
    intro p hne
    by_cases hA : X (cylPt p.1 (k * p.1) p.2) = 0
    · by_cases hB : X (cylPt p.1 (-(k * p.1)) p.2) = 0
      · exfalso; apply hne; rw [hA, hB]; simp
      · obtain ⟨q1, q2, q3⟩ := hsupp _ hB
        obtain ⟨r0, _, r2⟩ := hcyl p.1 (-(k * p.1)) p.2
        rw [r0] at q1 q2; rw [r2] at q3
        exact ⟨q1, q2, q3⟩
    · obtain ⟨q1, q2, q3⟩ := hsupp _ hA
      obtain ⟨r0, _, r2⟩ := hcyl p.1 (k * p.1) p.2
      rw [r0] at q1 q2; rw [r2] at q3
      exact ⟨q1, q2, q3⟩
  
  have S7 := hface _ (2 * Real.sqrt (1 + k ^ 2)) hFcont hFbd hFsupp
  
  have hs₁ : 0 < s₁ := lt_of_lt_of_le ha₁ h1
  have S8a := hrectInt (fun p => X (cylPt s₂ p.1 p.2) 0) (k * s₂) h
    (mul_pos hk (by linarith)).le hh.le (fun p => hab0 _)
  have S8b := hrectInt (fun p => X (cylPt s₁ p.1 p.2) 0) (k * s₁) h
    (mul_pos hk hs₁).le hh.le (fun p => hab0 _)
  have S8a' := le_abs_self (∫ p in Set.Ioo (-(k * s₂)) (k * s₂) ×ˢ Set.Ioo (-h) h,
    X (cylPt s₂ p.1 p.2) 0)
  have S8b' := neg_abs_le (∫ p in Set.Ioo (-(k * s₁)) (k * s₁) ×ˢ Set.Ioo (-h) h,
    X (cylPt s₁ p.1 p.2) 0)
  
  have S9 := htrap (fun p => X (cylPt p.1 p.2 h) 2 - X (cylPt p.1 p.2 (-h)) 2) (fun p => by
    have := abs_sub (X (cylPt p.1 p.2 h) 2) (X (cylPt p.1 p.2 (-h)) 2)
    linarith [hab2 (cylPt p.1 p.2 h), hab2 (cylPt p.1 p.2 (-h))])
  
  have hid : (2 * (k * s₂)) * (2 * h) + (2 * (k * s₁)) * (2 * h) = 4 * k * h * (s₁ + s₂) := by ring
  simp only at S8a S8b S9
  linarith

theorem sepDensDiv_one_local (X : E3 → E3) (V : Set E3) (hX : ContDiff ℝ ∞ X) (hc : HasCompactSupport X) (hV : tsupport X ⊆ V) : Integrable (sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X) ∧ ∀ A B : Set E3, MeasurableSet A → MeasurableSet B → volume ((A ∩ V) \ B) = 0 → volume ((B ∩ V) \ A) = 0 → ∫ z in A, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z = ∫ z in B, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z :=
by
  set f := sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X with hf
  have hfeq : ∀ y, f y = ∑ i : Fin 3, partialDeriv i (fun z => X z i) y := by
    intro y
    simp only [hf, sepDensDiv, Matrix.det_one, Real.sqrt_one, one_mul]
  have hgi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff.comp hX
  have hcont : Continuous f := by
    have hfun : f = fun y => ∑ i : Fin 3, fderiv ℝ (fun z => X z i) y (e i) := funext hfeq
    rw [hfun]
    refine continuous_finset_sum _ (fun i _ => ?_)
    exact ((hgi i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hvan : ∀ y, y ∉ tsupport X → f y = 0 := by
    intro y hy
    rw [hfeq]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have h1 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    have h2 : (fun z => X z i) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) :=
      h1.mono (fun z hz => by simp [hz])
    unfold partialDeriv
    rw [h2.fderiv_eq]
    simp
  have hint : Integrable f :=
    hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.intro' hc.isCompact (isClosed_tsupport X) hvan)
  refine ⟨hint, fun A B hA hB hAB hBA => ?_⟩
  have hloc : ∀ S : Set E3, MeasurableSet S →
      ∫ z in S, f z = ∫ z in S ∩ tsupport X, f z := by
    intro S hS
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hS Set.inter_subset_left ?_
    intro x hx
    exact hvan x (fun hxT => hx.2 ⟨hx.1, hxT⟩)
  have hae : (A ∩ tsupport X : Set E3) =ᵐ[volume] (B ∩ tsupport X : Set E3) := by
    rw [ae_eq_set]
    constructor
    · refine measure_mono_null ?_ hAB
      rintro x ⟨⟨hxA, hxT⟩, hxn⟩
      exact ⟨⟨hxA, hV hxT⟩, fun hxB => hxn ⟨hxB, hxT⟩⟩
    · refine measure_mono_null ?_ hBA
      rintro x ⟨⟨hxB, hxT⟩, hxn⟩
      exact ⟨⟨hxB, hV hxT⟩, fun hxA => hxn ⟨hxA, hxT⟩⟩
  rw [hloc A hA, hloc B hB]
  exact setIntegral_congr_set hae

theorem sepWedge_not_min (E : Set E3) (q₁ q₂ p₁ p₂ : E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) E Set.univ) (hq₁ : ‖q₁‖ = 1) (hq₂ : ‖q₂‖ = 1) (hind : LinearIndependent ℝ ![q₁, q₂]) (hW : ∀ z : E3, @inner ℝ E3 _ q₁ z ≤ 0 → @inner ℝ E3 _ q₂ z ≤ 0 → (@inner ℝ E3 _ q₁ z = 0 ∧ @inner ℝ E3 _ q₂ z = 0) ∨ (@inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0)) (hS : volume ({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩ {z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧ @inner ℝ E3 _ q₂ z < 0} ∩ E) = 0) (hN : volume (({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩ {z : E3 | 0 < @inner ℝ E3 _ q₁ z ∨ 0 < @inner ℝ E3 _ q₂ z}) \ E) = 0) : False :=
by
  classical
  have hcyl : ∀ a b c : ℝ, (cylPt a b c) 0 = a ∧ (cylPt a b c) 1 = b ∧ (cylPt a b c) 2 = c := by
    intro a b c
    simp [cylPt, EuclideanSpace.single_apply]
  have hcont : ∀ i : Fin 3, Continuous (fun z : E3 => z i) := fun i =>
    (EuclideanSpace.proj (𝕜 := ℝ) i).continuous
  
  obtain ⟨β, σ, τ, hσ, hτ, hq₁β, hq₂β⟩ := wedge_orthoframe q₁ q₂ hq₁ hq₂ hind
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E3 ≃ₗᵢ[ℝ] E3, Ψ = β.repr.symm := ⟨_, rfl⟩
  have hβc : ∀ (i : Fin 3) (w : E3), @inner ℝ E3 _ (β i) (Ψ w) = w i := by
    intro i w
    rw [hΨ, ← OrthonormalBasis.repr_apply_apply, LinearIsometryEquiv.apply_symm_apply]
  have hc₁ : ∀ w : E3, @inner ℝ E3 _ q₁ (Ψ w) = -σ * w 0 + τ * w 1 := by
    intro w
    rw [hq₁β, inner_add_left, real_inner_smul_left, real_inner_smul_left, hβc, hβc]
  have hc₂ : ∀ w : E3, @inner ℝ E3 _ q₂ (Ψ w) = -σ * w 0 - τ * w 1 := by
    intro w
    rw [hq₂β, inner_add_left, real_inner_smul_left, real_inner_smul_left, hβc, hβc]
    ring
  
  obtain ⟨k, hkdef⟩ : ∃ k : ℝ, k = σ / τ := ⟨_, rfl⟩
  have hk : 0 < k := by rw [hkdef]; exact div_pos hσ hτ
  have hkτ : ∀ x : ℝ, τ * (k * x) = σ * x := by
    intro x
    rw [hkdef]
    field_simp
  have hmin₁ : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (Ψ ⁻¹' E) Set.univ := by
    have hsymm1 : ∀ (y : E3) (i j : Fin 3), (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j =
        (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j i := by
      intro y i j
      show (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) j i
      by_cases hij : i = j
      · rw [hij]
      · rw [Matrix.one_apply_ne hij, Matrix.one_apply_ne (Ne.symm hij)]
    have hA := (sepAffinePullback (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) E Set.univ isOpen_univ
      hmin.1 (fun i j => contDiffOn_const) hsymm1
      (fun _ _ => Matrix.PosDef.one) 0 Ψ.toContinuousLinearEquiv 1 one_pos).2.2.2.2 hmin
    have hfd : ∀ z : E3, fderiv ℝ (fun w => (0 : E3) + Ψ.toContinuousLinearEquiv w) z =
        (Ψ.toContinuousLinearEquiv : E3 →L[ℝ] E3) := by
      intro z
      rw [fderiv_const_add]
      exact ContinuousLinearEquiv.fderiv _
    have hsum : ∀ v w : E3, ∑ i : Fin 3, ∑ j : Fin 3,
        v i * (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * w j = @inner ℝ E3 _ v w := by
      intro v w
      simp [Matrix.one_apply, PiLp.inner_apply, mul_comm, Fin.sum_univ_three]
    have hmet : (fun z => (1:ℝ) • pullbackMetric (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        (fun w => (0 : E3) + Ψ.toContinuousLinearEquiv w) z) =
        fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
      funext z
      ext a b
      rw [one_smul]
      simp only [pullbackMetric, hfd]
      rw [hsum]
      simp [EuclideanSpace.inner_single_left, EuclideanSpace.single_apply, Matrix.one_apply, eq_comm]
    have hpre : (fun w => (0 : E3) + Ψ.toContinuousLinearEquiv w) ⁻¹' E = Ψ ⁻¹' E := by
      ext w; simp
    rw [hmet, hpre, Set.preimage_univ] at hA
    exact hA
  obtain ⟨W, hWdef⟩ : ∃ W : Set E3,
      W = {z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} := ⟨_, rfl⟩
  have hWopen : IsOpen W := by
    rw [hWdef]
    exact IsOpen.inter (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ p₁ z) (by fun_prop) continuous_const)
      (isOpen_lt (f := fun z : E3 => @inner ℝ E3 _ p₂ z) (by fun_prop) continuous_const)
  obtain ⟨O, hOdef⟩ : ∃ O : Set E3, O = Ψ ⁻¹' W := ⟨_, rfl⟩
  have hO : IsOpen O := by rw [hOdef]; exact hWopen.preimage Ψ.continuous
  
  have hsub : ∀ z : E3, 0 < z 0 → |z 1| ≤ k * z 0 → z ∈ O := by
    intro w hw0 hw1
    have h1 : τ * |w 1| ≤ σ * w 0 := by
      rw [← hkτ]; exact mul_le_mul_of_nonneg_left hw1 hτ.le
    have h2 : τ * w 1 ≤ τ * |w 1| := mul_le_mul_of_nonneg_left (le_abs_self _) hτ.le
    have h3 : τ * (-w 1) ≤ τ * |w 1| := mul_le_mul_of_nonneg_left (neg_le_abs _) hτ.le
    have hσw : 0 < σ * w 0 := mul_pos hσ hw0
    rw [hOdef, Set.mem_preimage]
    rcases hW (Ψ w) (by rw [hc₁]; linarith) (by rw [hc₂]; linarith) with h | h
    · rw [hc₁, hc₂] at h
      linarith [h.1, h.2]
    · rw [hWdef]; exact h
  
  have hmp : MeasurePreserving Ψ := Ψ.measurePreserving
  have hS₁ : volume (O ∩ {z : E3 | |z 1| < k * z 0} ∩ Ψ ⁻¹' E) = 0 := by
    apply measure_mono_null _ (hmp.quasiMeasurePreserving.preimage_null hS)
    rintro w ⟨⟨hwO, hw⟩, hwE⟩
    rw [hOdef, Set.mem_preimage, hWdef] at hwO
    refine ⟨⟨hwO, ?_⟩, hwE⟩
    have hw' : |w 1| < k * w 0 := hw
    have h1 : τ * |w 1| < σ * w 0 := by
      rw [← hkτ]; exact mul_lt_mul_of_pos_left hw' hτ
    have h2 : τ * w 1 ≤ τ * |w 1| := mul_le_mul_of_nonneg_left (le_abs_self _) hτ.le
    have h3 : τ * (-w 1) ≤ τ * |w 1| := mul_le_mul_of_nonneg_left (neg_le_abs _) hτ.le
    show @inner ℝ E3 _ q₁ (Ψ w) < 0 ∧ @inner ℝ E3 _ q₂ (Ψ w) < 0
    rw [hc₁, hc₂]
    constructor <;> linarith
  have hN₁ : volume ((O ∩ {z : E3 | k * z 0 < |z 1|}) \ Ψ ⁻¹' E) = 0 := by
    apply measure_mono_null _ (hmp.quasiMeasurePreserving.preimage_null hN)
    rintro w ⟨⟨hwO, hw⟩, hwE⟩
    rw [hOdef, Set.mem_preimage, hWdef] at hwO
    refine ⟨⟨hwO, ?_⟩, hwE⟩
    have hw' : k * w 0 < |w 1| := hw
    have h1 : σ * w 0 < τ * |w 1| := by
      rw [← hkτ]; exact mul_lt_mul_of_pos_left hw' hτ
    show 0 < @inner ℝ E3 _ q₁ (Ψ w) ∨ 0 < @inner ℝ E3 _ q₂ (Ψ w)
    rw [hc₁, hc₂]
    rcases le_or_gt 0 (w 1) with h | h
    · left; rw [abs_of_nonneg h] at h1; linarith
    · right; rw [abs_of_neg h] at h1; linarith
  
  have hgainE : ∃ s₁ s₂ h θ : ℝ, 0 < θ ∧ θ < s₁ ∧ s₁ < s₂ ∧ 0 < h ∧
      2 * Real.sqrt (1 + k ^ 2) * ((s₂ + θ - (s₁ - θ)) * (2 * (h + θ)) - (s₂ - s₁) * (2 * h)) +
        4 * k * h * (s₁ + s₂) + 4 * k * s₂ * (s₂ - s₁) <
        4 * Real.sqrt (1 + k ^ 2) * h * (s₂ - s₁) := by
    obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Real.sqrt (1 + k ^ 2) := ⟨_, rfl⟩
    rw [← hcdef]
    have hc2 : c ^ 2 = 1 + k ^ 2 := by rw [hcdef]; exact Real.sq_sqrt (by positivity)
    have hc0 : 0 ≤ c := by rw [hcdef]; exact Real.sqrt_nonneg _
    have hck : k < c := by
      by_contra hcon
      push_neg at hcon
      nlinarith [mul_le_mul hcon hcon hc0 hk.le]
    have hckp : 0 < c + k := by linarith
    have hckm : 0 < c - k := by linarith
    have hckp' : c + k ≠ 0 := hckp.ne'
    have hckm' : c - k ≠ 0 := hckm.ne'
    obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = (c - k) / (2 * (c + k)) := ⟨_, rfl⟩
    obtain ⟨H0, hHdef⟩ : ∃ H0 : ℝ, H0 = 4 * k / (c - k) := ⟨_, rfl⟩
    have hs' : s * (2 * (c + k)) = c - k := by
      rw [hsdef]; field_simp
    have hH' : H0 * (c - k) = 4 * k := by
      rw [hHdef]; field_simp
    have hs0 : 0 < s := by rw [hsdef]; exact div_pos hckm (by linarith)
    have hs1 : s < 1 := by
      by_contra hcon
      push_neg at hcon
      have := mul_le_mul_of_nonneg_right hcon hckp.le
      linarith
    have hH0 : 0 < H0 := by rw [hHdef]; exact div_pos (by linarith) hckm
    have hden : 0 < 2 * c * (3 + 2 * H0) := by
      have : 0 < c := by linarith
      positivity
    obtain ⟨θ, hθdef⟩ : ∃ θ : ℝ, θ = min (s / 2) (k / (2 * c * (3 + 2 * H0))) := ⟨_, rfl⟩
    have hθ0 : 0 < θ := by rw [hθdef]; exact lt_min (by linarith) (div_pos hk hden)
    have hθ1 : θ ≤ s / 2 := by rw [hθdef]; exact min_le_left _ _
    have hθ2 : θ * (2 * c * (3 + 2 * H0)) ≤ k := by
      have : θ ≤ k / (2 * c * (3 + 2 * H0)) := by rw [hθdef]; exact min_le_right _ _
      rwa [le_div_iff₀ hden] at this
    refine ⟨s, 1, H0, θ, hθ0, by linarith, hs1, hH0, ?_⟩
    have hcθ : 0 ≤ c * θ := mul_nonneg hc0 hθ0.le
    have hp := mul_nonneg hcθ (by linarith : (0:ℝ) ≤ 3 - (1 - s + 2 * θ))
    have hks := mul_pos hk hs0
    have e1 : H0 * (s * (2 * (c + k))) = H0 * (c - k) := by rw [hs']
    linarith [hp, hθ2, e1, hH', hks]
  obtain ⟨s₁, s₂, h, θ, hθ, hθs, hs, hh, hgain⟩ := hgainE
  have hs₁ : 0 < s₁ := by linarith
  obtain ⟨k', hk', hbox⟩ :=
    wedge_box_in_open k (s₁ - θ) (s₂ + θ) (h + θ) O hk (by linarith) hO hsub
  have hk'0 : 0 < k' := by linarith
  
  have hnorm : ∀ z : E3, ‖z‖ ≤ |z 0| + |z 1| + |z 2| := by
    intro z
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
    simp only [Real.norm_eq_abs]
    have h0 := abs_nonneg (z 0)
    have h1 := abs_nonneg (z 1)
    have h2 := abs_nonneg (z 2)
    calc Real.sqrt (|z 0| ^ 2 + |z 1| ^ 2 + |z 2| ^ 2)
        ≤ Real.sqrt ((|z 0| + |z 1| + |z 2|) ^ 2) := Real.sqrt_le_sqrt (by nlinarith)
      _ = |z 0| + |z 1| + |z 2| := Real.sqrt_sq (by positivity)
  have hcpt : ∀ (A B C : ℝ) (S : Set E3), IsClosed S →
      (∀ z ∈ S, |z 0| ≤ A ∧ |z 1| ≤ B ∧ |z 2| ≤ C) → IsCompact S := by
    intro A B C S hS hb
    refine Metric.isCompact_of_isClosed_isBounded hS ?_
    rw [isBounded_iff_forall_norm_le]
    exact ⟨A + B + C, fun z hz => by
      obtain ⟨h0, h1, h2⟩ := hb z hz
      linarith [hnorm z]⟩
  
  obtain ⟨V, hVdef⟩ : ∃ V : Set E3, V = {z : E3 | s₁ - θ < z 0 ∧ z 0 < s₂ + θ ∧
      |z 1| < k' * z 0 ∧ |z 2| < h + θ} := ⟨_, rfl⟩
  have hVopen : IsOpen V := by
    rw [hVdef]
    exact (isOpen_lt continuous_const (hcont 0)).inter ((isOpen_lt (hcont 0) continuous_const).inter
      ((isOpen_lt (hcont 1).abs (continuous_const.mul (hcont 0))).inter
        (isOpen_lt (hcont 2).abs continuous_const)))
  obtain ⟨Bc, hBcdef⟩ : ∃ Bc : Set E3, Bc = {z : E3 | s₁ - θ ≤ z 0 ∧ z 0 ≤ s₂ + θ ∧
      |z 1| ≤ k' * z 0 ∧ |z 2| ≤ h + θ} := ⟨_, rfl⟩
  have hBcclosed : IsClosed Bc := by
    rw [hBcdef]
    exact (isClosed_le continuous_const (hcont 0)).inter ((isClosed_le (hcont 0) continuous_const).inter
      ((isClosed_le (hcont 1).abs (continuous_const.mul (hcont 0))).inter
        (isClosed_le (hcont 2).abs continuous_const)))
  have hVBc : V ⊆ Bc := by
    rw [hVdef, hBcdef]
    rintro z ⟨h1, h2, h3, h4⟩
    exact ⟨h1.le, h2.le, h3.le, h4.le⟩
  have hclV : closure V ⊆ Bc := closure_minimal hVBc hBcclosed
  have hBcbd : ∀ z ∈ Bc, |z 0| ≤ s₂ + θ ∧ |z 1| ≤ k' * (s₂ + θ) ∧ |z 2| ≤ h + θ := by
    rw [hBcdef]
    rintro z ⟨h1, h2, h3, h4⟩
    have hz0 : 0 < z 0 := by linarith
    exact ⟨by rw [abs_of_pos hz0]; exact h2, h3.trans (mul_le_mul_of_nonneg_left h2 hk'0.le), h4⟩
  have hVcpt : IsCompact (closure V) :=
    hcpt _ _ _ _ isClosed_closure (fun z hz => hBcbd z (hclV hz))
  have hVO : V ⊆ O := by
    intro z hz
    have hz' := hVBc hz
    rw [hBcdef] at hz'
    exact hbox z hz'.1 hz'.2.1 hz'.2.2.1 hz'.2.2.2
  have hVpos : ∀ z ∈ V, 0 < z 0 := by
    intro z hz
    rw [hVdef] at hz
    linarith [hz.1]
  
  obtain ⟨P, hPdef⟩ : ∃ P : Set E3,
      P = {z : E3 | s₁ < z 0 ∧ z 0 < s₂ ∧ |z 1| < k * z 0 ∧ |z 2| < h} := ⟨_, rfl⟩
  have hPmeas : MeasurableSet P := by
    rw [hPdef]
    exact ((isOpen_lt continuous_const (hcont 0)).inter ((isOpen_lt (hcont 0) continuous_const).inter
      ((isOpen_lt (hcont 1).abs (continuous_const.mul (hcont 0))).inter
        (isOpen_lt (hcont 2).abs continuous_const)))).measurableSet
  obtain ⟨Kc, hKcdef⟩ : ∃ Kc : Set E3,
      Kc = {z : E3 | s₁ ≤ z 0 ∧ z 0 ≤ s₂ ∧ |z 1| ≤ k * z 0 ∧ |z 2| ≤ h} := ⟨_, rfl⟩
  have hKcclosed : IsClosed Kc := by
    rw [hKcdef]
    exact (isClosed_le continuous_const (hcont 0)).inter ((isClosed_le (hcont 0) continuous_const).inter
      ((isClosed_le (hcont 1).abs (continuous_const.mul (hcont 0))).inter
        (isClosed_le (hcont 2).abs continuous_const)))
  have hKccpt : IsCompact Kc := by
    refine hcpt s₂ (k * s₂) h Kc hKcclosed ?_
    rw [hKcdef]
    rintro z ⟨h1, h2, h3, h4⟩
    have hz0 : 0 < z 0 := by linarith
    exact ⟨by rw [abs_of_pos hz0]; exact h2, h3.trans (mul_le_mul_of_nonneg_left h2 hk.le), h4⟩
  have hPKc : P ⊆ Kc := by
    rw [hPdef, hKcdef]
    rintro z ⟨h1, h2, h3, h4⟩
    exact ⟨h1.le, h2.le, h3.le, h4.le⟩
  have hKcV : Kc ⊆ V := by
    rw [hKcdef, hVdef]
    rintro z ⟨h1, h2, h3, h4⟩
    have hz0 : 0 < z 0 := by linarith
    exact ⟨by linarith, by linarith, lt_of_le_of_lt h3 (mul_lt_mul_of_pos_right hk' hz0),
      by linarith⟩
  
  have hE₁meas : MeasurableSet (Ψ ⁻¹' E) := hmin₁.1
  have hE'meas : MeasurableSet (Ψ ⁻¹' E ∪ P) := hE₁meas.union hPmeas
  have hsd : symmDiff (Ψ ⁻¹' E) (Ψ ⁻¹' E ∪ P) ⊆ Kc := by
    intro z hz
    rw [Set.mem_symmDiff] at hz
    rcases hz with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact absurd (Or.inl h1) h2
    · rcases h1 with h1 | h1
      · exact absurd h1 h2
      · exact hPKc h1
  have hle := hmin₁.2.2 (Ψ ⁻¹' E ∪ P) V Kc hE'meas hVopen hVcpt (Set.subset_univ _) hKccpt
    hKcV hsd
  
  obtain ⟨E₀, hE₀def⟩ : ∃ E₀ : Set E3, E₀ = {z : E3 | k * z 0 < |z 1|} := ⟨_, rfl⟩
  have hE₀meas : MeasurableSet E₀ := by
    rw [hE₀def]
    exact (isOpen_lt (continuous_const.mul (hcont 0)) (hcont 1).abs).measurableSet
  have hplane : ∀ c : ℝ, volume {z : E3 | z 1 = c * z 0} = 0 := by
    intro c
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : E3 →ₗ[ℝ] ℝ,
        ℓ = (EuclideanSpace.proj (𝕜 := ℝ) (1 : Fin 3)).toLinearMap -
          c • (EuclideanSpace.proj (𝕜 := ℝ) (0 : Fin 3)).toLinearMap := ⟨_, rfl⟩
    have hℓz : ∀ z : E3, ℓ z = z 1 - c * z 0 := by
      intro z; rw [hℓ]; simp
    have hker : LinearMap.ker ℓ ≠ ⊤ := by
      intro htop
      have h1 : e 1 ∈ LinearMap.ker ℓ := by rw [htop]; exact Submodule.mem_top
      rw [LinearMap.mem_ker, hℓz] at h1
      simp [EuclideanSpace.single_apply] at h1
    refine measure_mono_null ?_ (Measure.addHaar_submodule volume _ hker)
    intro z hz
    show z ∈ LinearMap.ker ℓ
    rw [LinearMap.mem_ker, hℓz]
    have hz' : z 1 = c * z 0 := hz
    rw [hz']; ring
  have N1 : volume ((Ψ ⁻¹' E ∩ V) \ E₀) = 0 := by
    refine measure_mono_null ?_
      (measure_union_null (measure_union_null hS₁ (hplane k)) (hplane (-k)))
    rintro z ⟨⟨hzE, hzV⟩, hz0⟩
    rw [hE₀def, Set.mem_setOf_eq, not_lt] at hz0
    rcases hz0.lt_or_eq with hlt | heq
    · exact Or.inl (Or.inl ⟨⟨hVO hzV, hlt⟩, hzE⟩)
    · have hnn : 0 ≤ k * z 0 := heq ▸ abs_nonneg (z 1)
      rcases (abs_eq hnn).mp heq with h' | h'
      · exact Or.inl (Or.inr h')
      · right
        show z 1 = -k * z 0
        rw [h']; ring
  have N2 : volume ((E₀ ∩ V) \ Ψ ⁻¹' E) = 0 := by
    refine measure_mono_null ?_ hN₁
    rintro z ⟨⟨hz, hzV⟩, hzE⟩
    rw [hE₀def] at hz
    exact ⟨⟨hVO hzV, hz⟩, hzE⟩
  
  have hface : ∀ x t : ℝ, s₁ ≤ x → x ≤ s₂ → |t| ≤ h →
      cylPt x (k * x) t ∈ V ∧ cylPt x (-(k * x)) t ∈ V := by
    intro x t hx1 hx2 ht
    have hx0 : 0 < x := by linarith
    have hkx : 0 < k * x := mul_pos hk hx0
    have hlt : k * x < k' * x := mul_lt_mul_of_pos_right hk' hx0
    obtain ⟨a1, a2, a3⟩ := hcyl x (k * x) t
    obtain ⟨b1, b2, b3⟩ := hcyl x (-(k * x)) t
    rw [hVdef]
    simp only [Set.mem_setOf_eq, a1, a2, a3, b1, b2, b3, abs_neg, abs_of_pos hkx]
    exact ⟨⟨by linarith, by linarith, hlt, by linarith⟩, ⟨by linarith, by linarith, hlt, by linarith⟩⟩
  obtain ⟨Y, hYs, hYc, hYV, hYpos, hYbd, hYL⟩ :=
    wedge_face_lower_field k s₁ s₂ h V hk hs₁ hs hh hVopen hface
  have hlow1 : ENNReal.ofReal (∫ z in Ψ ⁻¹' E,
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y z) ≤
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (Ψ ⁻¹' E) V := by
    unfold sepPerG
    exact le_iSup₂_of_le Y ⟨hYs, hYc, hYV, hYbd⟩ le_rfl
  have hYeq : ∫ z in Ψ ⁻¹' E, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y z =
      ∫ z in E₀, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y z :=
    (sepDensDiv_one_local Y V hYs hYc hYV).2 _ _ hE₁meas hE₀meas N1 N2
  have hYflux := wedge_model_flux k Y hk hYs hYc hYpos
  rw [← hE₀def] at hYflux
  have hLle : 4 * Real.sqrt (1 + k ^ 2) * h * (s₂ - s₁) ≤
      ∫ z in Ψ ⁻¹' E, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y z := by
    rw [hYeq, hYflux]; exact hYL
  
  have hdisj : Disjoint E₀ P := by
    rw [Set.disjoint_left, hE₀def, hPdef]
    rintro z hz ⟨_, _, h3, _⟩
    exact absurd hz (not_lt.mpr h3.le)
  have hup : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (Ψ ⁻¹' E ∪ P) V ≤
      ENNReal.ofReal (2 * Real.sqrt (1 + k ^ 2) * ((s₂ + θ - (s₁ - θ)) * (2 * (h + θ)) -
        (s₂ - s₁) * (2 * h)) + 4 * k * h * (s₁ + s₂) + 4 * k * s₂ * (s₂ - s₁)) := by
    unfold sepPerG
    refine iSup₂_le ?_
    rintro X ⟨hXs, hXc, hXV, hXbd⟩
    apply ENNReal.ofReal_le_ofReal
    obtain ⟨hXint, hXcongr⟩ := sepDensDiv_one_local X V hXs hXc hXV
    have n1 : volume (((Ψ ⁻¹' E ∪ P) ∩ V) \ (E₀ ∪ P)) = 0 := by
      refine measure_mono_null ?_ N1
      rintro z ⟨⟨hz1 | hz1, hzV⟩, hz2⟩
      · exact ⟨⟨hz1, hzV⟩, fun h' => hz2 (Or.inl h')⟩
      · exact absurd (Or.inr hz1) hz2
    have n2 : volume (((E₀ ∪ P) ∩ V) \ (Ψ ⁻¹' E ∪ P)) = 0 := by
      refine measure_mono_null ?_ N2
      rintro z ⟨⟨hz1 | hz1, hzV⟩, hz2⟩
      · exact ⟨⟨hz1, hzV⟩, fun h' => hz2 (Or.inl h')⟩
      · exact absurd (Or.inr hz1) hz2
    have h1 := hXcongr _ _ hE'meas (hE₀meas.union hPmeas) n1 n2
    have h2 : ∫ z in E₀ ∪ P, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z =
        (∫ z in E₀, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z) +
          ∫ z in P, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z :=
      setIntegral_union hdisj hPmeas hXint.integrableOn hXint.integrableOn
    have hXpos : tsupport X ⊆ {z : E3 | 0 < z 0} := fun z hz => hVpos z (hXV hz)
    have h3 := wedge_model_flux k X hk hXs hXc hXpos
    rw [← hE₀def] at h3
    have h4 := trapezoid_prism_flux k s₁ s₂ h X hk hs₁ hs hh hXs
    rw [← hPdef] at h4
    have hsupp : ∀ z : E3, X z ≠ 0 → s₁ - θ < z 0 ∧ z 0 < s₂ + θ ∧ |z 2| < h + θ := by
      intro z hz
      have hzV : z ∈ V := hXV (subset_tsupport X hz)
      rw [hVdef] at hzV
      exact ⟨hzV.1, hzV.2.1, hzV.2.2.2⟩
    have h5 := wedge_face_upper_bound k s₁ s₂ h (s₁ - θ) (s₂ + θ) (h + θ) X hk (by linarith)
      (by linarith) hs (by linarith) hh (by linarith) hXs.continuous hsupp hXbd
    rw [h1, h2, h3, h4]
    exact h5
  
  have hLpos : 0 < 4 * Real.sqrt (1 + k ^ 2) * h * (s₂ - s₁) := by
    have hc0 : 0 < Real.sqrt (1 + k ^ 2) := Real.sqrt_pos.mpr (by positivity)
    have hd : 0 < s₂ - s₁ := by linarith
    exact mul_pos (mul_pos (mul_pos (by norm_num : (0:ℝ) < 4) hc0) hh) hd
  have hchain := (ENNReal.ofReal_le_ofReal hLle).trans (hlow1.trans (hle.trans hup))
  have hlt := (ENNReal.ofReal_lt_ofReal_iff hLpos).mpr hgain
  exact absurd hchain (not_le.mpr hlt)

theorem sepEuclMinCone_halfspace (K : Set E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (hcone : ∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ K} K) = 0) (h1 : ∀ N ∈ 𝓝 (0:E3), volume (N \ K) ≠ 0) (h0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ K) ≠ 0) : ∃ ν : E3, ‖ν‖ = 1 ∧ volume (symmDiff K {z : E3 | @inner ℝ E3 _ ν z < 0}) = 0 :=
by
  classical
  
  have hsq : ∀ (A : ℕ → Set E3) (L H : Set E3),
      Tendsto (fun k => volume (symmDiff (A k) L ∩ Metric.ball (0:E3) 1)) atTop (𝓝 0) →
      volume (symmDiff L H) = 0 →
      Tendsto (fun k => volume (symmDiff (A k) H ∩ Metric.ball (0:E3) 1)) atTop (𝓝 0) := by
    intro A L H hA hLH
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hA
      (fun k => zero_le _) (fun k => ?_)
    calc volume (symmDiff (A k) H ∩ Metric.ball (0:E3) 1)
        ≤ volume ((symmDiff (A k) L ∩ Metric.ball (0:E3) 1) ∪ symmDiff L H) := by
          apply measure_mono
          rintro x ⟨hx, hxB⟩
          rcases symmDiff_triangle _ L _ hx with h | h
          · exact Or.inl ⟨h, hxB⟩
          · exact Or.inr h
      _ ≤ volume (symmDiff (A k) L ∩ Metric.ball (0:E3) 1) + volume (symmDiff L H) :=
          measure_union_le _ _
      _ = volume (symmDiff (A k) L ∩ Metric.ball (0:E3) 1) := by rw [hLH, add_zero]
  
  have hcompl : ∀ L : Set E3, sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) L Set.univ →
      sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Lᶜ Set.univ := by
    intro L hL
    refine ⟨hL.1.compl, fun V hV hc hcl => ?_, fun F' V Kc hF' hV hc hcl hKc hKcV hsd => ?_⟩
    · rw [sepPerG_one_compl L V hL.1]
      exact hL.2.1 V hV hc hcl
    · have hsd' : symmDiff L F'ᶜ ⊆ Kc := by
        have hEq : symmDiff L F'ᶜ = symmDiff Lᶜ F' := by
          ext y
          simp only [Set.mem_symmDiff, Set.mem_compl_iff]
          tauto
        rw [hEq]
        exact hsd
      rw [sepPerG_one_compl L V hL.1, ← sepPerG_one_compl F' V hF']
      exact hL.2.2 F'ᶜ V Kc hF'.compl hV hc hcl hKc hKcV hsd'
  
  have hcyl : ∀ (L : Set E3) (u : E3), ‖u‖ = 1 →
      sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) L Set.univ →
      (∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ L} L) = 0) →
      (∀ s : ℝ, volume (symmDiff {z : E3 | z + s • u ∈ L} L) = 0) →
      (∀ N ∈ 𝓝 (0:E3), volume (N \ L) ≠ 0) → (∀ N ∈ 𝓝 (0:E3), volume (N ∩ L) ≠ 0) →
      ∃ ν : E3, ‖ν‖ = 1 ∧ volume (symmDiff L {z : E3 | @inner ℝ E3 _ ν z < 0}) = 0 := by
    intro L u hu hL hconeL htrL h1L h0L
    obtain ⟨hdil, htr⟩ := sepMeasBdry_invariant L u hconeL htrL
    have hu0 : u ≠ 0 := by
      intro h
      rw [h, norm_zero] at hu
      exact zero_ne_one hu
    
    have hreg : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) →
        z - @inner ℝ E3 _ u z • u ≠ 0 → ∃ (a : Fin 3) (w : E3 → ℝ) (ρ δ : ℝ), 0 < ρ ∧ 0 < δ ∧
          Continuous w ∧ ∀ y ∈ sepCyl a z ρ δ,
            ((∀ N ∈ 𝓝 y, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) ↔
              y a = w (sepPlaneProj a y)) := by
      intro z hz hz'
      obtain ⟨r, Lz, hr, hr0, hconv, hminz, h1z, h0z, hconez, htrzz, htrzu⟩ :=
        sepEuclCone_tangentCone L u z hL hconeL htrL (fun N hN => (hz N hN).2)
          (fun N hN => (hz N hN).1)
      have hind : LinearIndependent ℝ ![z, u] := by
        rw [LinearIndependent.pair_iff]
        intro c₁ c₂ hc
        by_cases hc1 : c₁ = 0
        · subst hc1
          rw [zero_smul, zero_add] at hc
          exact ⟨rfl, (smul_eq_zero.mp hc).resolve_right hu0⟩
        · exfalso
          apply hz'
          have hzu : z = (-(c₁⁻¹ * c₂)) • u := by
            have h' : c₁ • z = -(c₂ • u) := eq_neg_of_add_eq_zero_left hc
            calc z = c₁⁻¹ • (c₁ • z) := by rw [smul_smul, inv_mul_cancel₀ hc1, one_smul]
              _ = (-(c₁⁻¹ * c₂)) • u := by rw [h', smul_neg, smul_smul, neg_smul]
          have huu : @inner ℝ E3 _ u u = 1 := by
            rw [real_inner_self_eq_norm_sq, hu]
            norm_num
          rw [hzu, real_inner_smul_right, huu, mul_one, sub_self]
      obtain ⟨hdilz, htrz⟩ := sepMeasBdry_invariant Lz z hconez htrzz
      obtain ⟨-, htru⟩ := sepMeasBdry_invariant Lz u hconez htrzu
      obtain ⟨ν, hν, hLν⟩ := sepTwoDir_cone_halfspace Lz z u hind hdilz htrz htru
        (sepMinBdry_null Lz hminz) h1z h0z
      have hflat := hsq (fun k => {w : E3 | z + r k • w ∈ L}) Lz
        {w : E3 | @inner ℝ E3 _ ν w < 0} (hconv 1 one_pos) hLν
      obtain ⟨a, w, ρ, δ, hρ, hδ, hw, -, hside⟩ := sepFlat_to_graph L z ν r hL
        (fun N hN => (hz N hN).2) (fun N hN => (hz N hN).1) hν hr hr0 hflat
      exact ⟨a, w, ρ, δ, hρ, hδ, hw.continuous,
        sepGraph_measBdry L a z w ρ δ hw.continuous hside⟩
    
    obtain ⟨Φ, hΦ, hrays⟩ := sepCylCone_finite_rays L u hu hdil htr hreg
    rcases sepCylCone_wedge_config L u Φ hu hdil htr hΦ hrays h1L h0L with
      h | ⟨E, q₁, q₂, p₁, p₂, hE, hq₁, hq₂, hind, hW, hS, hN⟩
    · exact h
    · exfalso
      have hEmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) E Set.univ := by
        rcases hE with rfl | rfl
        · exact hL
        · exact hcompl L hL
      exact sepWedge_not_min E q₁ q₂ p₁ p₂ hEmin hq₁ hq₂ hind hW hS hN
  
  have hv0 : ∀ s : ℝ, volume (symmDiff {z : E3 | z + s • (0:E3) ∈ K} K) = 0 := by
    intro s
    have hset : {z : E3 | z + s • (0:E3) ∈ K} = K := by
      ext z
      simp
    rw [hset, symmDiff_self]
    exact measure_empty
  have hdilK := (sepMeasBdry_invariant K 0 hcone hv0).1
  have hloc : ∀ x : E3, x ≠ 0 → (∀ N ∈ 𝓝 x, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) →
      ∃ (m : E3) (N : Set E3), ‖m‖ = 1 ∧ N ∈ 𝓝 x ∧
        volume ((N ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 ∧
        volume (N ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 := by
    intro x hx hxb
    obtain ⟨r, L, hr, hr0, hconv, hLmin, h1L, h0L, hconeL, htrx, -⟩ :=
      sepEuclCone_tangentCone K 0 x hmin hcone hv0 (fun N hN => (hxb N hN).2)
        (fun N hN => (hxb N hN).1)
    have hxn : 0 < ‖x‖ := norm_pos_iff.mpr hx
    have he : ‖‖x‖⁻¹ • x‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hxn.ne']
    have htre : ∀ s : ℝ, volume (symmDiff {z : E3 | z + s • (‖x‖⁻¹ • x) ∈ L} L) = 0 := by
      intro s
      simp only [smul_smul]
      exact htrx (s * ‖x‖⁻¹)
    obtain ⟨ν, hν, hLν⟩ := hcyl L (‖x‖⁻¹ • x) he hLmin hconeL htre h1L h0L
    have hflat := hsq (fun k => {w : E3 | x + r k • w ∈ K}) L
      {w : E3 | @inner ℝ E3 _ ν w < 0} (hconv 1 one_pos) hLν
    obtain ⟨a, u, ρ, δ, hρ, hδ, hu, hu0, hside⟩ := sepFlat_to_graph K x ν r hmin
      (fun N hN => (hxb N hN).2) (fun N hN => (hxb N hN).1) hν hr hr0 hflat
    exact sepCone_local_plane K x hmin hdilK a u ρ δ hρ hδ hu hu0 hside
  
  exact sepGlobal_planes K h1 h0 hloc

theorem sepTangentHalfSpace (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3)
    (hU : IsOpen U) (h0U : (0 : E3) ∈ U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (hI : G 0 = 1) (hmin : sepIsPerMin G F U)
    (h1 : ∀ N ∈ 𝓝 (0 : E3), volume (N \ F) ≠ 0) (h0 : ∀ N ∈ 𝓝 (0 : E3), volume (N ∩ F) ≠ 0) :
    ∀ ε : ℝ, 0 < ε → ∀ r₁ : ℝ, 0 < r₁ → ∃ (r : ℝ) (ν : E3), 0 < r ∧ r < r₁ ∧ ‖ν‖ = 1 ∧
      volume (symmDiff {z : E3 | r • z ∈ F} {z : E3 | @inner ℝ E3 _ ν z < 0} ∩
        Metric.ball 0 1) ≤ ENNReal.ofReal ε :=
by
  classical
  intro ε hε r₁ hr₁
  
  obtain ⟨ρ, hρ, hρU⟩ := Metric.mem_nhds_iff.1 (hU.mem_nhds h0U)
  have hm0 : 0 < min r₁ ρ := lt_min hr₁ hρ
  have hmr₁ : min r₁ ρ ≤ r₁ := min_le_left _ _
  obtain ⟨r, hr⟩ : ∃ r : ℕ → ℝ, ∀ k, r k = min r₁ ρ / ((k : ℝ) + 2) := ⟨_, fun k => rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : ℕ → ℝ, ∀ k, R k = (ρ / min r₁ ρ) * ((k : ℝ) + 2) := ⟨_, fun k => rfl⟩
  have hk2 : ∀ k : ℕ, (0 : ℝ) < (k : ℝ) + 2 := fun k => by positivity
  have hrpos : ∀ k, 0 < r k := fun k => by rw [hr]; exact div_pos hm0 (hk2 k)
  have hrlt : ∀ k, r k < r₁ := by
    intro k
    rw [hr]
    have h1k : (1 : ℝ) < (k : ℝ) + 2 := by
      have := Nat.cast_nonneg (α := ℝ) k
      linarith
    exact lt_of_lt_of_le (div_lt_self hm0 h1k) hmr₁
  have h2 : Tendsto (fun k : ℕ => (k : ℝ) + 2) atTop atTop :=
    tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop
  have hrt : Tendsto r atTop (𝓝 0) := by
    have e : r = fun k : ℕ => min r₁ ρ / ((k : ℝ) + 2) := funext hr
    rw [e]
    exact Tendsto.div_atTop tendsto_const_nhds h2
  have hRt : Tendsto R atTop atTop := by
    have e : R = fun k : ℕ => (ρ / min r₁ ρ) * ((k : ℝ) + 2) := funext hR
    rw [e]
    exact Tendsto.const_mul_atTop (div_pos hρ hm0) h2
  have hrR : ∀ k, r k * R k = ρ := by
    intro k
    rw [hr, hR]
    field_simp [hm0.ne', (hk2 k).ne']
  have hballR : ∀ k, ∀ z ∈ Metric.ball (0 : E3) (R k), r k • z ∈ U := by
    intro k z hz
    apply hρU
    rw [mem_ball_zero_iff] at hz ⊢
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (hrpos k)]
    have : r k * ‖z‖ < r k * R k := mul_lt_mul_of_pos_left hz (hrpos k)
    rw [hrR k] at this
    exact this
  
  have hrestr : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (S W W' : Set E3),
      sepIsPerMin G' S W → W' ⊆ W → sepIsPerMin G' S W' := by
    intro G' S W W' h hW
    exact ⟨h.1, fun V hV hc hcl => h.2.1 V hV hc (hcl.trans hW),
      fun F' V K hF' hV hc hcl hK hKV hsd => h.2.2 F' V K hF' hV hc (hcl.trans hW) hK hKV hsd⟩
  have hmink : ∀ k, sepIsPerMin (fun z => G (r k • z)) {z : E3 | r k • z ∈ F}
      (Metric.ball 0 (R k)) := fun k =>
    hrestr _ _ _ _ (sepRescale G F U hU hG hsymm hpd hmin (r k) (hrpos k)).1
      (fun z hz => hballR k z hz)
  have hGk : ∀ k (i j : Fin 3), ContDiffOn ℝ ∞ (fun y => G (r k • y) i j)
      (Metric.ball 0 (R k)) := by
    intro k i j
    exact (hG i j).comp (contDiff_const_smul (r k)).contDiffOn (fun z hz => hballR k z hz)
  have hcont : ∀ i j : Fin 3, ContinuousAt (fun y => G y i j) 0 := fun i j =>
    (hG i j).continuousOn.continuousAt (hU.mem_nhds h0U)
  have hconv : ∀ ρ' : ℝ, 0 < ρ' → ∀ ε' : ℝ, 0 < ε' → ∀ᶠ k in atTop,
      ∀ y ∈ Metric.ball (0:E3) ρ', ∀ i j : Fin 3,
        |G (r k • y) i j - (if i = j then (1:ℝ) else 0)| ≤ ε' := by
    intro ρ' hρ' ε' hε'
    have hev : ∀ᶠ y in 𝓝 (0:E3), ∀ i j : Fin 3,
        |G y i j - (if i = j then (1:ℝ) else 0)| < ε' := by
      rw [Filter.eventually_all]
      intro i
      rw [Filter.eventually_all]
      intro j
      have h := Metric.tendsto_nhds.1 (hcont i j) ε' hε'
      filter_upwards [h] with y hy
      simp only [Real.dist_eq, hI, Matrix.one_apply] at hy
      exact hy
    obtain ⟨δ, hδ, hδP⟩ := Metric.eventually_nhds_iff.1 hev
    have hrt' : Tendsto (fun k => r k * ρ') atTop (𝓝 0) := by
      have := hrt.mul_const ρ'
      rwa [zero_mul] at this
    filter_upwards [(tendsto_order.1 hrt').2 δ hδ] with k hk
    intro y hy i j
    have hyd : dist (r k • y) 0 < δ := by
      rw [dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_pos (hrpos k)]
      rw [mem_ball_zero_iff] at hy
      calc r k * ‖y‖ ≤ r k * ρ' := mul_le_mul_of_nonneg_left hy.le (hrpos k).le
        _ < δ := hk
    exact (hδP hyd i j).le
  have hpre0 : ∀ c : ℝ, c ≠ 0 → ∀ S : Set E3, volume S = 0 →
      volume ((fun x : E3 => c • x) ⁻¹' S) = 0 := by
    intro c hc S hS
    rw [Measure.addHaar_preimage_smul volume hc, hS, mul_zero]
  have hnhds : ∀ k, ∀ N ∈ 𝓝 (0:E3), (fun x : E3 => (r k)⁻¹ • x) ⁻¹' N ∈ 𝓝 (0:E3) := by
    intro k N hN
    apply (continuous_const_smul (r k)⁻¹).continuousAt.preimage_mem_nhds
    show N ∈ 𝓝 ((r k)⁻¹ • (0:E3))
    rw [smul_zero]
    exact hN
  have h1k : ∀ k, ∀ N ∈ 𝓝 (0:E3), volume (N \ {z : E3 | r k • z ∈ F}) ≠ 0 := by
    intro k N hN hzero
    apply h1 _ (hnhds k N hN)
    have h := hpre0 (r k)⁻¹ (inv_ne_zero (hrpos k).ne') _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro x ⟨hxN, hxF⟩
    refine ⟨hxN, ?_⟩
    show ¬ (r k • (r k)⁻¹ • x ∈ F)
    rw [smul_inv_smul₀ (hrpos k).ne']
    exact hxF
  have h0k : ∀ k, ∀ N ∈ 𝓝 (0:E3), volume (N ∩ {z : E3 | r k • z ∈ F}) ≠ 0 := by
    intro k N hN hzero
    apply h0 _ (hnhds k N hN)
    have h := hpre0 (r k)⁻¹ (inv_ne_zero (hrpos k).ne') _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro x ⟨hxN, hxF⟩
    refine ⟨hxN, ?_⟩
    show r k • (r k)⁻¹ • x ∈ F
    rw [smul_inv_smul₀ (hrpos k).ne']
    exact hxF
  
  obtain ⟨ψ, K, hψ, hC1, hKmin, hK1, hK0, hC4⟩ := sepPerMin_blowup_compact
    (fun k z => G (r k • z)) (fun k => {z : E3 | r k • z ∈ F}) R hRt hGk
    (fun k y i j => hsymm _ i j) (fun k y hy => hpd _ (hballR k y hy)) hconv hmink h1k h0k
  obtain ⟨Λ, r₀, hr₀, hfin, hmono⟩ :=
    sepPerMin_monotonicity G F U hU h0U hG hsymm hpd hI hmin
  obtain ⟨Θ₀, hΘ₀, hlim⟩ := sepDensityRatio_limit
    (fun t => sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 t))
    Λ r₀ hr₀ hfin hmono
  have hrψ : Tendsto (fun k => r (ψ k)) atTop (𝓝 0) := hrt.comp hψ.tendsto_atTop
  have hseq : ∀ ρ' : ℝ, 0 < ρ' → Tendsto (fun k => sepPerG
      (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {z : E3 | r (ψ k) • z ∈ F} (Metric.ball 0 ρ'))
      atTop (𝓝 (ENNReal.ofReal (Θ₀ * ρ' ^ 2))) := by
    intro ρ' hρ'
    have h := hlim (fun k => r (ψ k)) (fun k => hrpos _) hrψ ρ' hρ'
    refine Tendsto.congr (fun k => ?_) h
    exact ((sepRescale G F U hU hG hsymm hpd hmin (r (ψ k)) (hrpos _)).2 ρ' hρ').symm
  have hae : ∀ᵐ ρ' ∂(volume : Measure ℝ), 0 < ρ' →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ') =
        ENNReal.ofReal (Θ₀ * ρ' ^ 2) := by
    filter_upwards [hC4] with ρ' hρ' hpos
    exact tendsto_nhds_unique (hρ' hpos) (hseq ρ' hpos)
  have hall := sepPerG_ball_eq_of_ae K Θ₀ hΘ₀ hae
  
  have hcone := sepEuclMin_cone_of_const_density K hKmin Θ₀ hall
  obtain ⟨ν, hν, hKH⟩ := sepEuclMinCone_halfspace K hKmin hcone hK1 hK0
  have hev := (tendsto_order.1 (hC1 1 one_pos)).2 (ENNReal.ofReal ε) (ENNReal.ofReal_pos.2 hε)
  obtain ⟨k, hk⟩ := hev.exists
  have hk' : volume (symmDiff {z : E3 | r (ψ k) • z ∈ F} K ∩ Metric.ball 0 1) <
      ENNReal.ofReal ε := hk
  refine ⟨r (ψ k), ν, hrpos _, hrlt _, hν, ?_⟩
  calc volume (symmDiff {z : E3 | r (ψ k) • z ∈ F} {z : E3 | @inner ℝ E3 _ ν z < 0} ∩
          Metric.ball 0 1)
      ≤ volume ((symmDiff {z : E3 | r (ψ k) • z ∈ F} K ∩ Metric.ball 0 1) ∪
          symmDiff K {z : E3 | @inner ℝ E3 _ ν z < 0}) := by
        apply measure_mono
        rintro x ⟨hx, hxB⟩
        rcases symmDiff_triangle _ K _ hx with h | h
        · exact Or.inl ⟨h, hxB⟩
        · exact Or.inr h
    _ ≤ volume (symmDiff {z : E3 | r (ψ k) • z ∈ F} K ∩ Metric.ball 0 1) +
          volume (symmDiff K {z : E3 | @inner ℝ E3 _ ν z < 0}) := measure_union_le _ _
    _ ≤ ENNReal.ofReal ε := by
        rw [hKH, add_zero]
        exact hk'.le

theorem sepPerMin_C1_graph (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U F : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i)
    (hpd : ∀ y ∈ U, (G y).PosDef) (hmin : sepIsPerMin G F U) (y₀ : E3) (hy₀ : y₀ ∈ U)
    (h1 : ∀ N ∈ 𝓝 y₀, volume (N \ F) ≠ 0) (h0 : ∀ N ∈ 𝓝 y₀, volume (N ∩ F) ≠ 0) :
    ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧ ContDiff ℝ 1 u ∧
      u (sepPlaneProj a y₀) = y₀ a ∧ sepCyl a y₀ r δ ⊆ U ∧
      ((volume ((sepCyl a y₀ r δ ∩ {z | z a < u (sepPlaneProj a z)}) \ F) = 0 ∧
          volume (sepCyl a y₀ r δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ F) = 0) ∨
        (volume ((sepCyl a y₀ r δ ∩ {z | u (sepPlaneProj a z) < z a}) \ F) = 0 ∧
          volume (sepCyl a y₀ r δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ F) = 0)) :=
by
  classical
  
  obtain ⟨L, hL⟩ := sepPosDef_normalizer (G y₀) (hpd y₀ hy₀)
  obtain ⟨-, hG₁, hsymm₁, hpd₁, hmin₁'⟩ :=
    sepAffinePullback G F U hU hmin.1 hG hsymm hpd y₀ L 1 one_pos
  have hmin₁ := hmin₁' hmin
  have hφc : Continuous (fun w : E3 => y₀ + L w) := continuous_const.add L.continuous
  have hU₁ : IsOpen ((fun w : E3 => y₀ + L w) ⁻¹' U) := hU.preimage hφc
  have h0U₁ : (0 : E3) ∈ (fun w : E3 => y₀ + L w) ⁻¹' U := by
    show y₀ + L 0 ∈ U
    rw [map_zero, add_zero]
    exact hy₀
  have hfd : ∀ z : E3, fderiv ℝ (fun w : E3 => y₀ + L w) z = (L : E3 →L[ℝ] E3) := by
    intro z
    rw [fderiv_const_add]
    exact L.fderiv
  have hI : (fun z => (1 : ℝ) • pullbackMetric G (fun w => y₀ + L w) z) 0 = 1 := by
    ext i j
    simp only [one_smul]
    unfold pullbackMetric
    rw [hfd 0]
    simp only [ContinuousLinearEquiv.coe_coe, map_zero, add_zero]
    rw [hL i j, Matrix.one_apply]
  
  have hφψ : ∀ y : E3, y₀ + L (L.symm (y - y₀)) = y := by
    intro y
    rw [ContinuousLinearEquiv.apply_symm_apply, add_sub_cancel]
  have hψφ : ∀ z : E3, L.symm (y₀ + L z - y₀) = z := by
    intro z
    rw [add_sub_cancel_left, ContinuousLinearEquiv.symm_apply_apply]
  have hψc : Continuous (fun y : E3 => L.symm (y - y₀)) :=
    L.symm.continuous.comp (continuous_id.sub continuous_const)
  have hψ0 : L.symm (y₀ - y₀) = 0 := by rw [sub_self, map_zero]
  have hψnhds : ∀ N ∈ 𝓝 (0 : E3), (fun y : E3 => L.symm (y - y₀)) ⁻¹' N ∈ 𝓝 y₀ := by
    intro N hN
    apply hψc.continuousAt.preimage_mem_nhds
    show N ∈ 𝓝 (L.symm (y₀ - y₀))
    rw [hψ0]
    exact hN
  have hvol : ∀ S : Set E3, volume S = 0 →
      volume ((fun y : E3 => L.symm (y - y₀)) ⁻¹' S) = 0 := by
    intro S hS
    have e1 : (fun y : E3 => L.symm (y - y₀)) ⁻¹' S =
        (fun y : E3 => y + (-y₀)) ⁻¹' ((L.symm : E3 → E3) ⁻¹' S) := by
      ext y
      simp only [Set.mem_preimage, sub_eq_add_neg]
    rw [e1, measure_preimage_add_right, Measure.addHaar_preimage_continuousLinearEquiv, hS,
      mul_zero]
  
  have h1₁ : ∀ N ∈ 𝓝 (0 : E3), volume (N \ (fun w : E3 => y₀ + L w) ⁻¹' F) ≠ 0 := by
    intro N hN hzero
    apply h1 _ (hψnhds N hN)
    have h := hvol _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro y ⟨hyN, hyF⟩
    refine ⟨hyN, ?_⟩
    show ¬ (y₀ + L (L.symm (y - y₀)) ∈ F)
    rw [hφψ]
    exact hyF
  have h0₁ : ∀ N ∈ 𝓝 (0 : E3), volume (N ∩ (fun w : E3 => y₀ + L w) ⁻¹' F) ≠ 0 := by
    intro N hN hzero
    apply h0 _ (hψnhds N hN)
    have h := hvol _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro y ⟨hyN, hyF⟩
    refine ⟨hyN, ?_⟩
    show y₀ + L (L.symm (y - y₀)) ∈ F
    rw [hφψ]
    exact hyF
  
  obtain ⟨ε, r₀, hε, hr₀, hreg⟩ := sepPerMin_flat_regular
    (fun z => (1 : ℝ) • pullbackMetric G (fun w => y₀ + L w) z)
    ((fun w : E3 => y₀ + L w) ⁻¹' F) ((fun w : E3 => y₀ + L w) ⁻¹' U)
    hU₁ h0U₁ hG₁ hsymm₁ hpd₁ hI hmin₁
  obtain ⟨r, ν, hr, hrr₀, hν, hflat⟩ := sepTangentHalfSpace
    (fun z => (1 : ℝ) • pullbackMetric G (fun w => y₀ + L w) z)
    ((fun w : E3 => y₀ + L w) ⁻¹' F) ((fun w : E3 => y₀ + L w) ⁻¹' U)
    hU₁ h0U₁ hG₁ hsymm₁ hpd₁ hI hmin₁ h1₁ h0₁ ε hε r₀ hr₀
  obtain ⟨f, N, hf, hN, hfN, hneg, hpos⟩ := hreg r ν hr hrr₀ hν hflat
  
  obtain ⟨g, hg⟩ : ∃ g : E3 → ℝ, g = fun y => f (L.symm (y - y₀)) := ⟨_, rfl⟩
  have hgapp : ∀ y, g y = f (L.symm (y - y₀)) := fun y => by rw [hg]
  have hgC : ContDiff ℝ 1 g := by
    rw [hg]
    exact hf.comp (L.symm.contDiff.comp (contDiff_id.sub contDiff_const))
  have hgc : Continuous g := hgC.continuous
  have hgy₀ : g y₀ = f 0 := by rw [hgapp, hψ0]
  have hN' := hψnhds N hN
  have hneg' : volume (((fun y : E3 => L.symm (y - y₀)) ⁻¹' N ∩ {z | g z < 0}) \ F) = 0 := by
    have h := hvol _ hneg
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro y ⟨⟨hyN, hyg⟩, hyF⟩
    refine ⟨⟨hyN, ?_⟩, ?_⟩
    · show f (L.symm (y - y₀)) < 0
      rw [← hgapp]
      exact hyg
    · show ¬ (y₀ + L (L.symm (y - y₀)) ∈ F)
      rw [hφψ]
      exact hyF
  have hpos' : volume ((fun y : E3 => L.symm (y - y₀)) ⁻¹' N ∩ {z | 0 < g z} ∩ F) = 0 := by
    have h := hvol _ hpos
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro y ⟨⟨hyN, hyg⟩, hyF⟩
    refine ⟨⟨hyN, ?_⟩, ?_⟩
    · show 0 < f (L.symm (y - y₀))
      rw [← hgapp]
      exact hyg
    · show y₀ + L (L.symm (y - y₀)) ∈ F
      rw [hφψ]
      exact hyF
  have hdg : fderiv ℝ g y₀ ≠ 0 := by
    intro hzero
    apply hfN 0 (mem_of_mem_nhds hN)
    have hfg : f = g ∘ (fun z : E3 => y₀ + L z) := by
      funext z
      simp only [Function.comp, hgapp, hψφ]
    have hgd : DifferentiableAt ℝ g ((fun z : E3 => y₀ + L z) 0) :=
      hgC.differentiable one_ne_zero _
    have hφd : DifferentiableAt ℝ (fun z : E3 => y₀ + L z) 0 :=
      (differentiableAt_const _).add L.differentiableAt
    rw [hfg, fderiv_comp 0 hgd hφd]
    have e0 : y₀ + L 0 = y₀ := by
      rw [map_zero, add_zero]
    rw [e0, hzero, ContinuousLinearMap.zero_comp]
  have hg0 : g y₀ = 0 := by
    rcases lt_trichotomy (g y₀) 0 with hlt | heq | hgt
    · exfalso
      have hmem : (fun y : E3 => L.symm (y - y₀)) ⁻¹' N ∩ {z | g z < 0} ∈ 𝓝 y₀ :=
        Filter.inter_mem hN' ((isOpen_lt hgc continuous_const).mem_nhds hlt)
      exact h1 _ hmem hneg'
    · exact heq
    · exfalso
      have hmem : (fun y : E3 => L.symm (y - y₀)) ⁻¹' N ∩ {z | 0 < g z} ∈ 𝓝 y₀ :=
        Filter.inter_mem hN' ((isOpen_lt continuous_const hgc).mem_nhds hgt)
      exact h0 _ hmem hpos'
  
  exact sepLevelset_to_coordGraph U F hU y₀ hy₀ g _ hgC hg0 hdg hN' hneg' hpos'

theorem hull_chart_side_transfer [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (K F E : Set M) (p : M) (hE : E = {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}) (hEo : IsOpen E) (a : Fin 3) (c : E3) (u : E3 → ℝ) (r δ : ℝ) (hu : Continuous u) (hcyl : sepCyl a c r δ ⊆ chartAt E3 p '' (Kᶜ ∩ (chartAt E3 p).source)) (hside : (volume ((sepCyl a c r δ ∩ {z | z a < u (sepPlaneProj a z)}) \ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0 ∧ volume (sepCyl a c r δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0) ∨ (volume ((sepCyl a c r δ ∩ {z | u (sepPlaneProj a z) < z a}) \ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0 ∧ volume (sepCyl a c r δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0)) : ∀ z ∈ sepCyl a c r δ, ((chartAt E3 p).symm z ∈ frontier E ↔ z a = u (sepPlaneProj a z)) :=
by
  set κ := chartAt E3 p with hκ
  set Fκ := κ '' (F ∩ κ.source) with hFκdef
  set C := sepCyl a c r δ with hCdef
  have hmemE : ∀ x, x ∈ E ↔ (x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)) := fun x => by
    rw [hE]; rfl
  
  
  have sepChartNull_of_image_null : ∀ (p : M) (N : Set M),
      N ⊆ (chartAt E3 p).source → volume (chartAt E3 p '' N) = 0 → sepChartNull N := by
    intro p N hN h0 q
    have hs0 : volume (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) = 0 :=
      measure_mono_null (Set.image_mono Set.inter_subset_left) h0
    have himg : (chartAt E3 q ∘ (chartAt E3 p).symm) ''
        (chartAt E3 p '' (N ∩ (chartAt E3 q).source))
        = chartAt E3 q '' (N ∩ (chartAt E3 q).source) := by
      rw [Set.image_image]
      refine Set.EqOn.image_eq ?_
      intro x hx
      simp only [Function.comp_apply]
      rw [(chartAt E3 p).left_inv (hN hx.1)]
    have hsm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
      (contMDiffOn_chart (x := q)).comp
        ((contMDiffOn_chart_symm (x := p)).mono Set.inter_subset_left) Set.inter_subset_right
    have hcd : ContDiffOn ℝ ∞ (chartAt E3 q ∘ (chartAt E3 p).symm)
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
      contMDiffOn_iff_contDiffOn.mp hsm
    have hsub : chartAt E3 p '' (N ∩ (chartAt E3 q).source) ⊆
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) := by
      rintro _ ⟨x, hx, rfl⟩
      refine ⟨(chartAt E3 p).map_source (hN hx.1), ?_⟩
      show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 q).source
      rw [(chartAt E3 p).left_inv (hN hx.1)]
      exact hx.2
    have hdiff : DifferentiableOn ℝ (chartAt E3 q ∘ (chartAt E3 p).symm)
        (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) :=
      (hcd.differentiableOn (by simp)).mono hsub
    rw [← himg]
    exact MeasureTheory.addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume
      hdiff hs0
  
  have hCK : ∀ z ∈ C, z ∈ κ.target ∧ κ.symm z ∉ K := by
    intro z hz
    obtain ⟨x', ⟨hx'K, hx's⟩, rfl⟩ := hcyl hz
    exact ⟨κ.map_source hx's, by rw [κ.left_inv hx's]; exact hx'K⟩
  have hvolpos : ∀ (s : Set E3) (z : E3), s ∈ 𝓝 z → volume s ≠ 0 := by
    intro s z hs h0
    have h1 : 0 < volume (interior s) :=
      isOpen_interior.measure_pos volume ⟨z, mem_interior_iff_mem_nhds.2 hs⟩
    have h2 : volume (interior s) = 0 := measure_mono_null interior_subset h0
    rw [h2] at h1
    exact lt_irrefl _ h1
  
  have T1 : ∀ Q : Set E3, IsOpen Q → Q ⊆ C → volume (Q \ Fκ) = 0 →
      ∀ z ∈ Q, κ.symm z ∈ E := by
    intro Q hQ hQC hQ0 z hz
    have hzt := (hCK z (hQC hz)).1
    have hNo : IsOpen (κ.source ∩ κ ⁻¹' Q) := κ.isOpen_inter_preimage hQ
    have hzN : κ.symm z ∈ κ.source ∩ κ ⁻¹' Q := by
      refine ⟨κ.map_target hzt, ?_⟩
      show κ (κ.symm z) ∈ Q
      rw [κ.right_inv hzt]
      exact hz
    refine (hmemE _).2 ⟨(hCK z (hQC hz)).2, _, hNo.mem_nhds hzN, ?_⟩
    refine sepChartNull_of_image_null p _ (fun x hx => hx.1.1) ?_
    refine measure_mono_null ?_ hQ0
    rintro _ ⟨x, ⟨⟨hxs, hxQ⟩, hxF⟩, rfl⟩
    refine ⟨hxQ, ?_⟩
    rintro ⟨x', ⟨hx'F, hx's⟩, heq⟩
    exact hxF ((κ.injOn hx's hxs heq) ▸ hx'F)
  
  have T0 : ∀ Q : Set E3, IsOpen Q → Q ⊆ C → volume (Q ∩ Fκ) = 0 →
      ∀ z ∈ Q, κ.symm z ∉ closure E := by
    intro Q hQ hQC hQ0 z hz hcl
    have hzt := (hCK z (hQC hz)).1
    have hNo : IsOpen (κ.source ∩ κ ⁻¹' Q) := κ.isOpen_inter_preimage hQ
    have hzN : κ.symm z ∈ κ.source ∩ κ ⁻¹' Q := by
      refine ⟨κ.map_target hzt, ?_⟩
      show κ (κ.symm z) ∈ Q
      rw [κ.right_inv hzt]
      exact hz
    have hNF : sepChartNull ((κ.source ∩ κ ⁻¹' Q) ∩ F) := by
      refine sepChartNull_of_image_null p _ (fun x hx => hx.1.1) ?_
      refine measure_mono_null ?_ hQ0
      rintro _ ⟨x, ⟨⟨hxs, hxQ⟩, hxF⟩, rfl⟩
      exact ⟨hxQ, x, ⟨hxF, hxs⟩, rfl⟩
    obtain ⟨y, hyN, hyE⟩ := _root_.mem_closure_iff.1 hcl _ hNo hzN
    obtain ⟨-, Ny, hNy, hNyn⟩ := (hmemE y).1 hyE
    have hsub : (κ.source ∩ κ ⁻¹' Q) ∩ Ny ⊆ (Ny \ F) ∪ ((κ.source ∩ κ ⁻¹' Q) ∩ F) := by
      intro w hw
      by_cases hwF : w ∈ F
      · exact Or.inr ⟨hw.1, hwF⟩
      · exact Or.inl ⟨hw.2, hwF⟩
    have hy' : (κ.source ∩ κ ⁻¹' Q) ∩ Ny ∈ 𝓝 y := Filter.inter_mem (hNo.mem_nhds hyN) hNy
    have h5 : chartAt E3 y '' (((κ.source ∩ κ ⁻¹' Q) ∩ Ny) ∩ (chartAt E3 y).source) ∈
        𝓝 (chartAt E3 y y) :=
      (chartAt E3 y).image_mem_nhds (mem_chart_source E3 y)
        (Filter.inter_mem hy' ((chartAt E3 y).open_source.mem_nhds (mem_chart_source E3 y)))
    apply hvolpos _ _ h5
    refine measure_mono_null ?_ (measure_union_null (hNyn y) (hNF y))
    rw [← Set.image_union, ← Set.union_inter_distrib_right]
    exact Set.image_mono (Set.inter_subset_inter_left _ hsub)
  
  have T2 : ∀ z ∈ C, κ.symm z ∈ E → ∃ Nz ∈ 𝓝 z, volume (Nz \ Fκ) = 0 := by
    intro z hzC hE'
    have hz := (hCK z hzC).1
    obtain ⟨-, N, hN, hNn⟩ := (hmemE _).1 hE'
    have hxs : κ.symm z ∈ κ.source := κ.map_target hz
    refine ⟨κ '' (N ∩ κ.source), ?_, ?_⟩
    · have h := κ.image_mem_nhds hxs (Filter.inter_mem hN (κ.open_source.mem_nhds hxs))
      rwa [κ.right_inv hz] at h
    · have h := hNn p
      refine measure_mono_null ?_ h
      rintro _ ⟨⟨x', ⟨hx'N, hx's⟩, rfl⟩, hnot⟩
      exact ⟨x', ⟨⟨hx'N, fun hF => hnot ⟨x', ⟨hF, hx's⟩, rfl⟩⟩, hx's⟩, rfl⟩
  
  have hmeasQ : ∀ (N Q : Set E3) (z : E3), N ∈ 𝓝 z → IsOpen Q →
      (∀ N' ∈ 𝓝 z, (N' ∩ Q).Nonempty) → volume (N \ Fκ) = 0 →
      volume (Q ∩ Fκ) = 0 → False := by
    intro N Q z hN hQ hnear hN0 hQ0
    obtain ⟨w, hw⟩ := hnear _ (interior_mem_nhds.2 hN)
    have hpos := (isOpen_interior.inter hQ).measure_pos volume ⟨w, hw⟩
    have hsub : interior N ∩ Q ⊆ (N \ Fκ) ∪ (Q ∩ Fκ) := by
      rintro v ⟨hvN, hvQ⟩
      by_cases hvF : v ∈ Fκ
      · exact Or.inr ⟨hvQ, hvF⟩
      · exact Or.inl ⟨interior_subset hvN, hvF⟩
    have hz0 : volume (interior N ∩ Q) = 0 :=
      measure_mono_null hsub (measure_union_null hN0 hQ0)
    rw [hz0] at hpos
    exact lt_irrefl _ hpos
  
  have hcoord : Continuous (fun w : E3 => w a) := by fun_prop
  have hproj_cont : Continuous (sepPlaneProj a) := by
    unfold sepPlaneProj
    exact continuous_id.sub (hcoord.smul continuous_const)
  have huc : Continuous (fun w => u (sepPlaneProj a w)) := hu.comp hproj_cont
  have hCo : IsOpen C :=
    (isOpen_lt (continuous_norm.comp (hproj_cont.comp (continuous_id.sub continuous_const)))
      continuous_const).inter
      (isOpen_lt (continuous_abs.comp (hcoord.sub continuous_const)) continuous_const)
  have hcoordadd : ∀ (w : E3) (t : ℝ), (w + t • e a) a = w a + t := by
    intro w t
    simp [e]
  have hprojadd : ∀ (w : E3) (t : ℝ), sepPlaneProj a (w + t • e a) = sepPlaneProj a w := by
    intro w t
    unfold sepPlaneProj
    rw [hcoordadd, add_smul]
    abel
  obtain ⟨Qp, hQp⟩ : ∃ Q : Set E3, Q = C ∩ {w | u (sepPlaneProj a w) < w a} := ⟨_, rfl⟩
  obtain ⟨Qm, hQm⟩ : ∃ Q : Set E3, Q = C ∩ {w | w a < u (sepPlaneProj a w)} := ⟨_, rfl⟩
  have hQpo : IsOpen Qp := by rw [hQp]; exact hCo.inter (isOpen_lt huc hcoord)
  have hQmo : IsOpen Qm := by rw [hQm]; exact hCo.inter (isOpen_lt hcoord huc)
  have hQpC : Qp ⊆ C := by rw [hQp]; exact Set.inter_subset_left
  have hQmC : Qm ⊆ C := by rw [hQm]; exact Set.inter_subset_left
  
  have hnearp : ∀ z ∈ C, z a = u (sepPlaneProj a z) → ∀ N ∈ 𝓝 z, (N ∩ Qp).Nonempty := by
    intro z hz hzg N hN
    have hc : Continuous (fun t : ℝ => z + t • e a) := by fun_prop
    have hT : Tendsto (fun t : ℝ => z + t • e a) (𝓝[>] 0) (𝓝 z) := by
      have h := hc.tendsto 0
      simp only [zero_smul, add_zero] at h
      exact h.mono_left nhdsWithin_le_nhds
    have hev : ∀ᶠ t in 𝓝[>] (0 : ℝ), z + t • e a ∈ N ∩ C ∧ t ∈ Set.Ioi (0 : ℝ) :=
      (hT.eventually_mem (Filter.inter_mem hN (hCo.mem_nhds hz))).and eventually_mem_nhdsWithin
    obtain ⟨t, ⟨htN, htC⟩, ht0⟩ := hev.exists
    have ht0' : 0 < t := ht0
    refine ⟨z + t • e a, htN, ?_⟩
    rw [hQp]
    refine ⟨htC, ?_⟩
    show u (sepPlaneProj a (z + t • e a)) < (z + t • e a) a
    rw [hprojadd, hcoordadd, ← hzg]
    linarith
  have hnearm : ∀ z ∈ C, z a = u (sepPlaneProj a z) → ∀ N ∈ 𝓝 z, (N ∩ Qm).Nonempty := by
    intro z hz hzg N hN
    have hc : Continuous (fun t : ℝ => z + t • e a) := by fun_prop
    have hT : Tendsto (fun t : ℝ => z + t • e a) (𝓝[<] 0) (𝓝 z) := by
      have h := hc.tendsto 0
      simp only [zero_smul, add_zero] at h
      exact h.mono_left nhdsWithin_le_nhds
    have hev : ∀ᶠ t in 𝓝[<] (0 : ℝ), z + t • e a ∈ N ∩ C ∧ t ∈ Set.Iio (0 : ℝ) :=
      (hT.eventually_mem (Filter.inter_mem hN (hCo.mem_nhds hz))).and eventually_mem_nhdsWithin
    obtain ⟨t, ⟨htN, htC⟩, ht0⟩ := hev.exists
    have ht0' : t < 0 := ht0
    refine ⟨z + t • e a, htN, ?_⟩
    rw [hQm]
    refine ⟨htC, ?_⟩
    show (z + t • e a) a < u (sepPlaneProj a (z + t • e a))
    rw [hprojadd, hcoordadd, ← hzg]
    linarith
  
  obtain ⟨Q₁, Q₂, hQQ, hQ₁, hQ₂⟩ : ∃ Q₁ Q₂ : Set E3,
      ((Q₁ = Qm ∧ Q₂ = Qp) ∨ (Q₁ = Qp ∧ Q₂ = Qm)) ∧
      volume (Q₁ \ Fκ) = 0 ∧ volume (Q₂ ∩ Fκ) = 0 := by
    rcases hside with ⟨hs1, hs2⟩ | ⟨hs1, hs2⟩
    · exact ⟨Qm, Qp, Or.inl ⟨rfl, rfl⟩, by rw [hQm]; exact hs1, by rw [hQp]; exact hs2⟩
    · exact ⟨Qp, Qm, Or.inr ⟨rfl, rfl⟩, by rw [hQp]; exact hs1, by rw [hQm]; exact hs2⟩
  have hQ₁o : IsOpen Q₁ := by
    rcases hQQ with ⟨h1', _⟩ | ⟨h1', _⟩ <;> rw [h1'] <;> assumption
  have hQ₂o : IsOpen Q₂ := by
    rcases hQQ with ⟨_, h2'⟩ | ⟨_, h2'⟩ <;> rw [h2'] <;> assumption
  have hQ₁C : Q₁ ⊆ C := by
    rcases hQQ with ⟨h1', _⟩ | ⟨h1', _⟩ <;> rw [h1'] <;> assumption
  have hQ₂C : Q₂ ⊆ C := by
    rcases hQQ with ⟨_, h2'⟩ | ⟨_, h2'⟩ <;> rw [h2'] <;> assumption
  have hnear₁ : ∀ z ∈ C, z a = u (sepPlaneProj a z) → ∀ N ∈ 𝓝 z, (N ∩ Q₁).Nonempty := by
    rcases hQQ with ⟨h1', _⟩ | ⟨h1', _⟩ <;> rw [h1'] <;> assumption
  have hnear₂ : ∀ z ∈ C, z a = u (sepPlaneProj a z) → ∀ N ∈ 𝓝 z, (N ∩ Q₂).Nonempty := by
    rcases hQQ with ⟨_, h2'⟩ | ⟨_, h2'⟩ <;> rw [h2'] <;> assumption
  
  intro z hz
  have hzt := (hCK z hz).1
  rw [hEo.frontier_eq]
  constructor
  · rintro ⟨hzcl, hzE⟩
    by_contra hne
    have hmem : z ∈ Q₁ ∨ z ∈ Q₂ := by
      rcases lt_or_gt_of_ne hne with h | h
      · have hzm : z ∈ Qm := by rw [hQm]; exact ⟨hz, h⟩
        rcases hQQ with ⟨h1', h2'⟩ | ⟨h1', h2'⟩
        · left; rw [h1']; exact hzm
        · right; rw [h2']; exact hzm
      · have hzp : z ∈ Qp := by rw [hQp]; exact ⟨hz, h⟩
        rcases hQQ with ⟨h1', h2'⟩ | ⟨h1', h2'⟩
        · right; rw [h2']; exact hzp
        · left; rw [h1']; exact hzp
    rcases hmem with h | h
    · exact hzE (T1 Q₁ hQ₁o hQ₁C hQ₁ z h)
    · exact T0 Q₂ hQ₂o hQ₂C hQ₂ z h hzcl
  · intro hzg
    refine ⟨?_, ?_⟩
    · rw [_root_.mem_closure_iff]
      intro W hW hxW
      have hxs : κ.symm z ∈ κ.source := κ.map_target hzt
      have h := κ.image_mem_nhds hxs
        (Filter.inter_mem (hW.mem_nhds hxW) (κ.open_source.mem_nhds hxs))
      rw [κ.right_inv hzt] at h
      obtain ⟨w, ⟨w', ⟨hw'W, hw's⟩, rfl⟩, hwQ⟩ := hnear₁ z hz hzg _ h
      refine ⟨w', hw'W, ?_⟩
      have h' := T1 Q₁ hQ₁o hQ₁C hQ₁ _ hwQ
      rwa [κ.left_inv hw's] at h'
    · intro hE'
      obtain ⟨Nz, hNz, hNz0⟩ := T2 z hz hE'
      exact hmeasQ Nz Q₂ z hNz hQ₂o (hnear₂ z hz hzg) hNz0 hQ₂

theorem hull_free_regular [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (K Ω Kv Kin A₀ F E : Set M) (hK : IsClosed K) (hΩ : IsOpen Ω) (hKv : IsCompact Kv)
    (hKvΩ : Kv ⊆ Ω) (hKin : IsClosed Kin) (hKinKv : Kin ⊆ interior Kv) (hKKin : K ⊆ Kin)
    (hA₀ : IsOpen A₀) (hA₀fr : frontier A₀ ⊆ Kin) (hF : sepChartMeas F)
    (hFA : symmDiff F A₀ ⊆ Kv) (hfin : hullRiemPer g F Ω K < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ Kv →
      hullRiemPer g F Ω K ≤ hullRiemPer g F' Ω K)
    (hcoll : sepChartNull (symmDiff F A₀ \ Kin))
    (hE : E = {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}) :
    (∀ p : M, p ∉ K → (∀ N ∈ 𝓝 p, ¬ sepChartNull (N \ F)) →
      (∀ N ∈ 𝓝 p, ¬ sepChartNull (N ∩ F)) → p ∈ frontier E) ∧
    ∀ p ∈ frontier E, p ∉ K → ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧
      ContDiff ℝ ∞ u ∧ u (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a ∧
      sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ,
        ((chartAt E3 p).symm z ∈ frontier E ↔ z a = u (sepPlaneProj a z))) ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ, z a = u (sepPlaneProj a z) →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun w => w a - u (sepPlaneProj a w)) z = 0) :=
by
  obtain ⟨hEo, -, -, -, hfrKin⟩ :=
    hull_normalization K Kin A₀ F E hK hKin hKKin hA₀ hA₀fr hcoll hE
  
  have N1 : ∀ S S' : Set M, S ⊆ S' → sepChartNull S' → sepChartNull S := by
    intro S S' h h' q
    exact measure_mono_null (Set.image_mono (Set.inter_subset_inter_left _ h)) (h' q)
  have N2 : ∀ S S' : Set M, sepChartNull S → sepChartNull S' → sepChartNull (S ∪ S') := by
    intro S S' h h' q
    rw [Set.union_inter_distrib_right, Set.image_union]
    exact measure_union_null (h q) (h' q)
  have N0 : ∀ (x : M) (N : Set M), N ∈ 𝓝 x → ¬ sepChartNull N := by
    intro x N hN h
    have h1 : N ∩ (chartAt E3 x).source ∈ 𝓝 x :=
      Filter.inter_mem hN ((chartAt E3 x).open_source.mem_nhds (mem_chart_source E3 x))
    have h2 : chartAt E3 x '' (N ∩ (chartAt E3 x).source) ∈ 𝓝 (chartAt E3 x x) :=
      (chartAt E3 x).image_mem_nhds (mem_chart_source E3 x) h1
    have h3 := MeasureTheory.Measure.measure_pos_of_mem_nhds (μ := (volume : Measure E3)) h2
    rw [h x] at h3
    exact lt_irrefl _ h3
  have N3 : ∀ (y : M) (N : Set M), N ∈ 𝓝 y → sepChartNull (N \ F) → sepChartNull (N ∩ F) →
      False := by
    intro y N hN h1 h2
    apply N0 y N hN
    rw [← Set.diff_union_inter N F]
    exact N2 _ _ h1 h2
  
  have key : ∀ p : M, p ∈ interior Kv → p ∉ K → (∀ N ∈ 𝓝 p, ¬ sepChartNull (N \ F)) →
      (∀ N ∈ 𝓝 p, ¬ sepChartNull (N ∩ F)) →
      ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧
        ContDiff ℝ ∞ u ∧ u (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a ∧
        sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target ∧
        (∀ z ∈ sepCyl a (chartAt E3 p p) r δ,
          ((chartAt E3 p).symm z ∈ frontier E ↔ z a = u (sepPlaneProj a z))) ∧
        (∀ z ∈ sepCyl a (chartAt E3 p p) r δ, z a = u (sepPlaneProj a z) →
          levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
            (fun w => w a - u (sepPlaneProj a w)) z = 0) := by
    intro p hpKv hpK hN1 hN0
    have hO : IsOpen (interior Kv ∩ Kᶜ) := isOpen_interior.inter hK.isOpen_compl
    have hOKv : interior Kv ∩ Kᶜ ⊆ Kv := fun x hx => interior_subset hx.1
    have hOK : Disjoint (interior Kv ∩ Kᶜ) K :=
      Set.disjoint_left.2 (fun x hx hxK => hx.2 hxK)
    have hpsrc : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
    have hUo : IsOpen (chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source)) :=
      (chartAt E3 p).isOpen_image_of_subset_source (hO.inter (chartAt E3 p).open_source)
        Set.inter_subset_right
    have hy₀ : chartAt E3 p p ∈ chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source) :=
      ⟨p, ⟨⟨hpKv, hpK⟩, hpsrc⟩, rfl⟩
    have hUt : chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source) ⊆
        (chartAt E3 p).target := by
      rintro _ ⟨x, hx, rfl⟩
      exact (chartAt E3 p).map_source hx.2
    have hUK : chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source) ⊆
        chartAt E3 p '' (Kᶜ ∩ (chartAt E3 p).source) :=
      Set.image_mono (fun x hx => ⟨hx.1.2, hx.2⟩)
    have hloc := hullMinimizer_chart_local g K Ω Kv (interior Kv ∩ Kᶜ) A₀ F hK hΩ hKvΩ hO hOKv
      hOK hF hFA hfin hmin p
    have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 p).symm y i j)
        (chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source)) :=
      fun i j => (g.smooth p i j).mono hUt
    have hsymm : ∀ (y : E3) (i j : Fin 3),
        g.coeff (chartAt E3 p).symm y i j = g.coeff (chartAt E3 p).symm y j i :=
      fun y i j => g.symm _ _ _
    have hpd : ∀ y ∈ chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source),
        (g.coeff (chartAt E3 p).symm y).PosDef :=
      fun y hy => coeff_chart_symm_posDef g p y (hUt hy)
    have hNp : ∀ N ∈ 𝓝 (chartAt E3 p p),
        (chartAt E3 p).source ∩ chartAt E3 p ⁻¹' interior N ∈ 𝓝 p := by
      intro N hN
      exact ((chartAt E3 p).isOpen_inter_preimage isOpen_interior).mem_nhds
        ⟨hpsrc, mem_interior_iff_mem_nhds.2 hN⟩
    have h1 : ∀ N ∈ 𝓝 (chartAt E3 p p),
        volume (N \ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) ≠ 0 := by
      intro N hN hzero
      apply hN1 _ (hNp N hN)
      apply sepChartNull_of_image_null p
      · intro x hx
        exact hx.1.1
      · refine measure_mono_null ?_ hzero
        rintro _ ⟨x, ⟨⟨hxs, hxN⟩, hxF⟩, rfl⟩
        refine ⟨interior_subset hxN, ?_⟩
        rintro ⟨w, ⟨hwF, hws⟩, hwx⟩
        have hwx' : w = x := (chartAt E3 p).injOn hws hxs hwx
        rw [hwx'] at hwF
        exact hxF hwF
    have h0 : ∀ N ∈ 𝓝 (chartAt E3 p p),
        volume (N ∩ chartAt E3 p '' (F ∩ (chartAt E3 p).source)) ≠ 0 := by
      intro N hN hzero
      apply hN0 _ (hNp N hN)
      apply sepChartNull_of_image_null p
      · intro x hx
        exact hx.1.1
      · refine measure_mono_null ?_ hzero
        rintro _ ⟨x, ⟨⟨hxs, hxN⟩, hxF⟩, rfl⟩
        exact ⟨interior_subset hxN, x, ⟨hxF, hxs⟩, rfl⟩
    obtain ⟨a, u, r, δ, hr, hδ, hu1, hu0, hcyl, hside⟩ :=
      sepPerMin_C1_graph (g.coeff (chartAt E3 p).symm)
        (chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (F ∩ (chartAt E3 p).source)) hUo hG hsymm hpd hloc
        (chartAt E3 p p) hy₀ h1 h0
    obtain ⟨u', r', hr', hr'r, hu', hagree, hMSE⟩ :=
      sepPerMin_C1_graph_smooth (g.coeff (chartAt E3 p).symm)
        (chartAt E3 p '' ((interior Kv ∩ Kᶜ) ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (F ∩ (chartAt E3 p).source)) hUo hG hsymm hpd hloc a
        (chartAt E3 p p) u r δ hr hδ hu1 hu0 hcyl hside
    have hC' : sepCyl a (chartAt E3 p p) r' δ ⊆ sepCyl a (chartAt E3 p p) r δ :=
      fun z hz => ⟨lt_of_lt_of_le hz.1 hr'r, hz.2⟩
    have hagree' : ∀ z ∈ sepCyl a (chartAt E3 p p) r' δ,
        u' (sepPlaneProj a z) = u (sepPlaneProj a z) :=
      fun z hz => hagree z hz.1
    have sub1 : sepCyl a (chartAt E3 p p) r' δ ∩ {z | z a < u' (sepPlaneProj a z)} ⊆
        sepCyl a (chartAt E3 p p) r δ ∩ {z | z a < u (sepPlaneProj a z)} := by
      rintro z ⟨hz, hz'⟩
      refine ⟨hC' hz, ?_⟩
      show z a < u (sepPlaneProj a z)
      rw [← hagree' z hz]
      exact hz'
    have sub2 : sepCyl a (chartAt E3 p p) r' δ ∩ {z | u' (sepPlaneProj a z) < z a} ⊆
        sepCyl a (chartAt E3 p p) r δ ∩ {z | u (sepPlaneProj a z) < z a} := by
      rintro z ⟨hz, hz'⟩
      refine ⟨hC' hz, ?_⟩
      show u (sepPlaneProj a z) < z a
      rw [← hagree' z hz]
      exact hz'
    have hside' :
        (volume ((sepCyl a (chartAt E3 p p) r' δ ∩ {z | z a < u' (sepPlaneProj a z)}) \
            chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0 ∧
          volume (sepCyl a (chartAt E3 p p) r' δ ∩ {z | u' (sepPlaneProj a z) < z a} ∩
            chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0) ∨
        (volume ((sepCyl a (chartAt E3 p p) r' δ ∩ {z | u' (sepPlaneProj a z) < z a}) \
            chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0 ∧
          volume (sepCyl a (chartAt E3 p p) r' δ ∩ {z | z a < u' (sepPlaneProj a z)} ∩
            chartAt E3 p '' (F ∩ (chartAt E3 p).source)) = 0) := by
      rcases hside with ⟨hA, hB⟩ | ⟨hA, hB⟩
      · left
        exact ⟨measure_mono_null (Set.diff_subset_diff_left sub1) hA,
          measure_mono_null (Set.inter_subset_inter_left _ sub2) hB⟩
      · right
        exact ⟨measure_mono_null (Set.diff_subset_diff_left sub2) hA,
          measure_mono_null (Set.inter_subset_inter_left _ sub1) hB⟩
    have hcylK : sepCyl a (chartAt E3 p p) r' δ ⊆ chartAt E3 p '' (Kᶜ ∩ (chartAt E3 p).source) :=
      (hC'.trans hcyl).trans hUK
    have hiff := hull_chart_side_transfer K F E p hE hEo a (chartAt E3 p p) u' r' δ
      hu'.continuous hcylK hside'
    have hbase : u' (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a := by
      rw [hagree (chartAt E3 p p) (by simp [sepPlaneProj, hr'])]
      exact hu0
    exact ⟨a, u', r', δ, hr', hδ, hu', hbase, (hC'.trans hcyl).trans hUt, hiff, hMSE⟩
  
  have conj2 : ∀ p ∈ frontier E, p ∉ K → ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧
      ContDiff ℝ ∞ u ∧ u (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a ∧
      sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ,
        ((chartAt E3 p).symm z ∈ frontier E ↔ z a = u (sepPlaneProj a z))) ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ, z a = u (sepPlaneProj a z) →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun w => w a - u (sepPlaneProj a w)) z = 0) := by
    intro p hp hpK
    have hpKin : p ∈ Kin := hfrKin hp
    have hpcl : p ∈ closure E := frontier_subset_closure hp
    have hfr := hp
    rw [hEo.frontier_eq] at hfr
    have hpE : p ∉ E := hfr.2
    refine key p (hKinKv hpKin) hpK ?_ ?_
    · intro N hN hnull
      apply hpE
      rw [hE]
      exact ⟨hpK, N, hN, hnull⟩
    · intro N hN hnull
      obtain ⟨y, hyN, hyE⟩ :=
        mem_closure_iff.1 hpcl (interior N) isOpen_interior (mem_interior_iff_mem_nhds.2 hN)
      rw [hE] at hyE
      obtain ⟨-, Ny, hNy, hNynull⟩ := hyE
      apply N3 y (N ∩ Ny) (Filter.inter_mem (mem_interior_iff_mem_nhds.1 hyN) hNy)
      · exact N1 ((N ∩ Ny) \ F) (Ny \ F) (fun x hx => ⟨hx.1.2, hx.2⟩) hNynull
      · exact N1 ((N ∩ Ny) ∩ F) (N ∩ F) (fun x hx => ⟨hx.1.1, hx.2⟩) hnull
  
  refine ⟨?_, conj2⟩
  intro p hpK hN1 hN0
  have hpKin : p ∈ Kin := by
    by_contra hpKin
    by_cases hpA : p ∈ A₀
    · apply hN1 (A₀ ∩ Kinᶜ) ((hA₀.inter hKin.isOpen_compl).mem_nhds ⟨hpA, hpKin⟩)
      refine N1 _ _ ?_ hcoll
      rintro x ⟨⟨hxA, hxKin⟩, hxF⟩
      exact ⟨Set.mem_symmDiff.2 (Or.inr ⟨hxA, hxF⟩), hxKin⟩
    · have hpcl : p ∉ closure A₀ := by
        rw [closure_eq_self_union_frontier]
        rintro (h | h)
        · exact hpA h
        · exact hpKin (hA₀fr h)
      apply hN0 ((closure A₀)ᶜ ∩ Kinᶜ)
        ((isClosed_closure.isOpen_compl.inter hKin.isOpen_compl).mem_nhds ⟨hpcl, hpKin⟩)
      refine N1 _ _ ?_ hcoll
      rintro x ⟨⟨hxA, hxKin⟩, hxF⟩
      exact ⟨Set.mem_symmDiff.2 (Or.inl ⟨hxF, fun h => hxA (subset_closure h)⟩), hxKin⟩
  obtain ⟨a, u, r, δ, hr, hδ, -, hu0, -, hiff, -⟩ := key p (hKinKv hpKin) hpK hN1 hN0
  have hz : chartAt E3 p p ∈ sepCyl a (chartAt E3 p p) r δ := by
    simp [sepCyl, sepPlaneProj, hr, hδ]
  have hfin' := (hiff _ hz).2 hu0.symm
  rwa [(chartAt E3 p).left_inv (mem_chart_source E3 p)] at hfin'

theorem contact_sheets [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (S : ℕ → Set M) (hS : ∀ n, IsCompact (S n) ∧ IsMinimalSurfaceSet g (S n)) (m : ℕ)
    (K : Set M) (hKdef : K = ⋃ n ∈ Finset.range m, S n) (p : M) (hp : p ∈ K)
    (W : Set E3) (hW : W ∈ 𝓝 (chartAt E3 p p)) :
    ∃ (ε : ℝ) (k : ℕ) (f : Fin k → E3 → ℝ), 0 < ε ∧ 0 < k ∧
      Metric.ball (chartAt E3 p p) ε ⊆ W ∩ (chartAt E3 p).target ∧
      (∀ i, ContDiffOn ℝ ∞ (f i) (Metric.ball (chartAt E3 p p) ε)) ∧
      (∀ i, f i (chartAt E3 p p) = 0) ∧
      (∀ i, ∀ z ∈ Metric.ball (chartAt E3 p p) ε, fderiv ℝ (f i) z ≠ 0) ∧
      (∀ i, ∀ z ∈ Metric.ball (chartAt E3 p p) ε, f i z = 0 →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (f i) z = 0) ∧
      ∀ z ∈ Metric.ball (chartAt E3 p p) ε, ((chartAt E3 p).symm z ∈ K ↔ ∃ i, f i z = 0) :=
by
  classical
  
  have s1a : ∀ fn : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fn →
      ContDiffOn ℝ ∞ (fun y => fn ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
    intro fn hfn
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fn ∘ (chartAt E3 p).symm) (chartAt E3 p).target :=
      hfn.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp h1
  
  have s1b : ∀ fn : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fn → ∀ z ∈ (chartAt E3 p).target,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) fn ((chartAt E3 p).symm z) ≠ 0 →
      fderiv ℝ (fun y => fn ((chartAt E3 p).symm y)) z ≠ 0 := by
    intro fn hfn z hz hmf h0
    apply hmf
    have hxs : (chartAt E3 p).symm z ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hz
    have hκx : chartAt E3 p ((chartAt E3 p).symm z) = z := (chartAt E3 p).right_inv hz
    have hev : fn =ᶠ[𝓝 ((chartAt E3 p).symm z)]
        (fun y => fn ((chartAt E3 p).symm y)) ∘ (chartAt E3 p) := by
      filter_upwards [(chartAt E3 p).open_source.mem_nhds hxs] with x' hx'
      simp only [Function.comp_apply, (chartAt E3 p).left_inv hx']
    rw [hev.mfderiv_eq]
    have hκd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z) :=
      ((contMDiffOn_chart : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 p)
          (chartAt E3 p).source).mdifferentiableOn (by simp)).mdifferentiableAt
        ((chartAt E3 p).open_source.mem_nhds hxs)
    have hFd : DifferentiableAt ℝ (fun y => fn ((chartAt E3 p).symm y)) z :=
      ((s1a fn hfn).contDiffAt ((chartAt E3 p).open_target.mem_nhds hz)).differentiableAt
        (by simp)
    have hFd' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y => fn ((chartAt E3 p).symm y))
        (chartAt E3 p ((chartAt E3 p).symm z)) := by
      rw [hκx]; exact hFd.mdifferentiableAt
    rw [mfderiv_comp ((chartAt E3 p).symm z) hFd' hκd, hκx, mfderiv_eq_fderiv, h0]
    rfl
  
  have s2 : ∀ fn : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fn → ∀ z ∈ (chartAt E3 p).target,
      g.levelMeanCurv fn ((chartAt E3 p).symm z) =
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun y => fn ((chartAt E3 p).symm y)) z := by
    intro fn hfn z hz
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    exact levelMeanCurv_eq_coord g Φ fn (fun y => fn ((chartAt E3 p).symm y)) hfn z hz
      (Filter.Eventually.of_forall fun _ => rfl)
  
  have hSc : ∀ n, IsClosed (S n) := fun n => (hS n).2.1
  have hO₀o : IsOpen ((chartAt E3 p).source ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ) :=
    (chartAt E3 p).open_source.inter
      (isOpen_biInter_finset fun n _ => (hSc n).isOpen_compl)
  have hpO₀ : p ∈ (chartAt E3 p).source ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ :=
    ⟨mem_chart_source E3 p, Set.mem_iInter₂.2 fun n hn => (Finset.mem_filter.1 hn).2⟩
  
  have hdef : ∀ n, ∃ (V : Set M) (fn : M → ℝ), p ∈ S n →
      (V ⊆ (chartAt E3 p).source ∩
          ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ ∧
        IsOpen V ∧ p ∈ V ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fn ∧
        (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) fn x ≠ 0) ∧
        V ∩ S n = V ∩ fn ⁻¹' {0} ∧ (∀ x ∈ V, fn x = 0 → g.levelMeanCurv fn x = 0)) := by
    intro n
    by_cases hpn : p ∈ S n
    · obtain ⟨V, fn, hVO, hVo, hpV, hfn, hdf, hVS, hH, -, -⟩ :=
        (hS n).2.2 p hpn _ (hO₀o.mem_nhds hpO₀)
      exact ⟨V, fn, fun _ => ⟨hVO, hVo, hpV, hfn, hdf, hVS, hH⟩⟩
    · exact ⟨Set.univ, fun _ => 0, fun h => absurd h hpn⟩
  choose V fn hVf using hdef
  
  have hk : 0 < ((Finset.range m).filter (fun n => p ∈ S n)).card := by
    rw [hKdef] at hp
    obtain ⟨n₀, hn₀, hpn₀⟩ := Set.mem_iUnion₂.1 hp
    exact Finset.card_pos.2 ⟨n₀, Finset.mem_filter.2 ⟨hn₀, hpn₀⟩⟩
  have hVto : IsOpen (((chartAt E3 p).source ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ) ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∈ S n), V n) :=
    hO₀o.inter (isOpen_biInter_finset fun n hn => (hVf n (Finset.mem_filter.1 hn).2).2.1)
  have hpVt : p ∈ ((chartAt E3 p).source ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ) ∩
      ⋂ n ∈ (Finset.range m).filter (fun n => p ∈ S n), V n :=
    ⟨hpO₀, Set.mem_iInter₂.2 fun n hn => (hVf n (Finset.mem_filter.1 hn).2).2.2.1⟩
  have hUo := (chartAt E3 p).isOpen_inter_preimage_symm hVto
  have hy₀U : chartAt E3 p p ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹'
      (((chartAt E3 p).source ∩
        ⋂ n ∈ (Finset.range m).filter (fun n => p ∉ S n), (S n)ᶜ) ∩
        ⋂ n ∈ (Finset.range m).filter (fun n => p ∈ S n), V n) := by
    refine ⟨(chartAt E3 p).map_source (mem_chart_source E3 p), ?_⟩
    rw [Set.mem_preimage, (chartAt E3 p).left_inv (mem_chart_source E3 p)]
    exact hpVt
  obtain ⟨ε, hε, hεsub⟩ := Metric.mem_nhds_iff.1 (Filter.inter_mem (hUo.mem_nhds hy₀U) hW)
  have hzV : ∀ z ∈ Metric.ball (chartAt E3 p p) ε, ∀ n ∈ (Finset.range m).filter
      (fun n => p ∈ S n), (chartAt E3 p).symm z ∈ V n :=
    fun z hz n hn => Set.mem_iInter₂.1 (hεsub hz).1.2.2 n hn
  have hzT : ∀ z ∈ Metric.ball (chartAt E3 p p) ε, z ∈ (chartAt E3 p).target :=
    fun z hz => (hεsub hz).1.1
  
  have hιI : ∀ i : Fin ((Finset.range m).filter (fun n => p ∈ S n)).card,
      (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) ∈
        (Finset.range m).filter (fun n => p ∈ S n) :=
    fun i => (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i).2
  have hιp : ∀ i : Fin ((Finset.range m).filter (fun n => p ∈ S n)).card,
      p ∈ S (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) :=
    fun i => (Finset.mem_filter.1 (hιI i)).2
  
  refine ⟨ε, ((Finset.range m).filter (fun n => p ∈ S n)).card,
    fun i z => fn (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ)
      ((chartAt E3 p).symm z), hε, hk, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    exact ⟨(hεsub hz).2, (hεsub hz).1.1⟩
  · intro i
    exact (s1a _ (hVf _ (hιp i)).2.2.2.1).mono hzT
  · intro i
    show fn _ ((chartAt E3 p).symm (chartAt E3 p p)) = 0
    rw [(chartAt E3 p).left_inv (mem_chart_source E3 p)]
    have hmem : p ∈ V (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) ∩
        S (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) :=
      ⟨(hVf _ (hιp i)).2.2.1, hιp i⟩
    rw [(hVf _ (hιp i)).2.2.2.2.2.1] at hmem
    exact hmem.2
  · intro i z hz
    exact s1b _ (hVf _ (hιp i)).2.2.2.1 z (hzT z hz)
      ((hVf _ (hιp i)).2.2.2.2.1 _ (hzV z hz _ (hιI i)))
  · intro i z hz h0
    rw [← s2 _ (hVf _ (hιp i)).2.2.2.1 z (hzT z hz)]
    exact (hVf _ (hιp i)).2.2.2.2.2.2 _ (hzV z hz _ (hιI i)) h0
  · intro z hz
    rw [hKdef]
    constructor
    · intro hx
      obtain ⟨n', hn', hxn'⟩ := Set.mem_iUnion₂.1 hx
      by_cases hpn' : p ∈ S n'
      · have hn'I : n' ∈ (Finset.range m).filter (fun n => p ∈ S n) :=
          Finset.mem_filter.2 ⟨hn', hpn'⟩
        have hmem : (chartAt E3 p).symm z ∈ V n' ∩ S n' := ⟨hzV z hz n' hn'I, hxn'⟩
        rw [(hVf n' hpn').2.2.2.2.2.1] at hmem
        refine ⟨((Finset.range m).filter (fun n => p ∈ S n)).equivFin ⟨n', hn'I⟩, ?_⟩
        have hι : ((((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm
            (((Finset.range m).filter (fun n => p ∈ S n)).equivFin ⟨n', hn'I⟩)) : ℕ) = n' := by
          simp
        show fn _ ((chartAt E3 p).symm z) = 0
        rw [hι]
        exact hmem.2
      · exfalso
        have h1 := Set.mem_iInter₂.1 (hεsub hz).1.2.1.2 n' (Finset.mem_filter.2 ⟨hn', hpn'⟩)
        exact h1 hxn'
    · rintro ⟨i, hi⟩
      have hmem : (chartAt E3 p).symm z ∈
          V (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) ∩
          fn (((Finset.range m).filter (fun n => p ∈ S n)).equivFin.symm i : ℕ) ⁻¹' {0} :=
        ⟨hzV z hz _ (hιI i), hi⟩
      rw [← (hVf _ (hιp i)).2.2.2.2.2.1] at hmem
      exact Set.mem_iUnion₂.2 ⟨_, (Finset.mem_filter.1 (hιI i)).1, hmem.2⟩

theorem hcr_densDiv_eq_lmc (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (φ : E3 → ℝ) (hφ : ContDiffOn ℝ ∞ φ U) (hdφ : ∀ z ∈ U, fderiv ℝ φ z ≠ 0) (z : E3)
    (hz : z ∈ U) :
    sepDensDiv G (hcrNormalField G φ) z = Real.sqrt (G z).det * levelMeanCurvCoord G φ z :=
by
  have hξ : (fun k : Fin 3 => partialDeriv k φ z) ≠ 0 := by
    intro h0
    apply hdφ z hz
    have hlin : (fderiv ℝ φ z : E3 →ₗ[ℝ] ℝ) = 0 :=
      (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
        simpa [partialDeriv] using congrFun h0 i)
    refine ContinuousLinearMap.ext (fun v => ?_)
    have := LinearMap.congr_fun hlin v
    simpa using this
  have hpos := (hpd z hz).inv.dotProduct_mulVec_pos hξ
  have hN : 0 < ∑ a : Fin 3, ∑ b : Fin 3,
      (G z)⁻¹ a b * partialDeriv a φ z * partialDeriv b φ z := by
    have heq : dotProduct (star (fun k : Fin 3 => partialDeriv k φ z))
        (Matrix.mulVec (G z)⁻¹ (fun k : Fin 3 => partialDeriv k φ z)) =
        ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a φ z * partialDeriv b φ z := by
      simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
      ring
    rw [← heq]
    exact hpos
  exact ccs_divx G φ U hU hG hsymm hpd hφ (hcrNormalField G φ) (fun _ _ _ => rfl) z hz hN

theorem lmc_mul_zero (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (w h : E3 → ℝ)
    (hw : ContDiffOn ℝ ∞ w U) (hh : ContDiffOn ℝ ∞ h U) (z : E3) (hz : z ∈ U)
    (hpdz : (G z).PosDef) (hw0 : w z = 0) (hdw : fderiv ℝ w z ≠ 0) (hh0 : h z ≠ 0) :
    levelMeanCurvCoord G (fun y => w y * h y) z * |h z| = h z * levelMeanCurvCoord G w z :=
by
  
  have hA : ∀ i j : Fin 3, (G z)⁻¹ i j = (G z)⁻¹ j i := by
    intro i j
    have hGt : Matrix.transpose (G z) = G z := Matrix.ext fun a b => by
      rw [Matrix.transpose_apply]; exact hsymm z b a
    have h1 := Matrix.transpose_nonsing_inv (G z)
    rw [hGt] at h1
    have h2 := congrFun (congrFun h1 j) i
    rw [Matrix.transpose_apply] at h2
    exact h2
  
  have hdw' : ∀ y ∈ U, DifferentiableAt ℝ w y := fun y hy =>
    (hw.contDiffAt (hU.mem_nhds hy)).differentiableAt (by simp)
  have hdh' : ∀ y ∈ U, DifferentiableAt ℝ h y := fun y hy =>
    (hh.contDiffAt (hU.mem_nhds hy)).differentiableAt (by simp)
  
  have hp1 : ∀ y ∈ U, ∀ a : Fin 3, partialDeriv a (fun y => w y * h y) y =
      partialDeriv a w y * h y + w y * partialDeriv a h y := by
    intro y hy a
    have H : HasFDerivAt (fun y => w y * h y) (w y • fderiv ℝ h y + h y • fderiv ℝ w y) y :=
      (hdw' y hy).hasFDerivAt.mul (hdh' y hy).hasFDerivAt
    unfold partialDeriv
    rw [H.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hwd1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ w y) U :=
    hw.fderiv_of_isOpen hU (by decide)
  have hhd1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ h y) U :=
    hh.fderiv_of_isOpen hU (by decide)
  have hdpw : ∀ j : Fin 3, DifferentiableAt ℝ (partialDeriv j w) z := by
    intro j
    have := ((hwd1.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp))
    exact this.clm_apply (differentiableAt_const _)
  have hdph : ∀ j : Fin 3, DifferentiableAt ℝ (partialDeriv j h) z := by
    intro j
    have := ((hhd1.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp))
    exact this.clm_apply (differentiableAt_const _)
  
  have hp2 : ∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun y => w y * h y)) z =
      partialDeriv i (partialDeriv j w) z * h z + partialDeriv j w z * partialDeriv i h z +
      partialDeriv i w z * partialDeriv j h z + w z * partialDeriv i (partialDeriv j h) z := by
    intro i j
    have hev : partialDeriv j (fun y => w y * h y) =ᶠ[𝓝 z]
        fun y => partialDeriv j w y * h y + w y * partialDeriv j h y :=
      Filter.eventually_of_mem (hU.mem_nhds hz) (fun y hy => hp1 y hy j)
    have hfe := Filter.EventuallyEq.fderiv_eq (𝕜 := ℝ) hev
    have H1 : HasFDerivAt (fun y => partialDeriv j w y * h y)
        (partialDeriv j w z • fderiv ℝ h z + h z • fderiv ℝ (partialDeriv j w) z) z :=
      (hdpw j).hasFDerivAt.mul (hdh' z hz).hasFDerivAt
    have H2 : HasFDerivAt (fun y => w y * partialDeriv j h y)
        (w z • fderiv ℝ (partialDeriv j h) z + partialDeriv j h z • fderiv ℝ w z) z :=
      (hdw' z hz).hasFDerivAt.mul (hdph j).hasFDerivAt
    have H : HasFDerivAt (fun y => partialDeriv j w y * h y + w y * partialDeriv j h y)
        ((partialDeriv j w z • fderiv ℝ h z + h z • fderiv ℝ (partialDeriv j w) z) +
          (w z • fderiv ℝ (partialDeriv j h) z + partialDeriv j h z • fderiv ℝ w z)) z :=
      H1.add H2
    show fderiv ℝ (partialDeriv j (fun y => w y * h y)) z (e i) = _
    rw [hfe, H.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    unfold partialDeriv
    ring
  
  have e1 : ∀ k : Fin 3, partialDeriv k (fun y => w y * h y) z = h z * partialDeriv k w z := by
    intro k
    rw [hp1 z hz k, hw0]; ring
  have e2 : ∀ i j : Fin 3, hessLoc G (fun y => w y * h y) i j z =
      h z * hessLoc G w i j z + partialDeriv i w z * partialDeriv j h z +
        partialDeriv j w z * partialDeriv i h z := by
    intro i j
    simp only [hessLoc, hp2 i j, e1, hw0, Fin.sum_univ_three]
    ring
  
  have fin : ∀ S L Q P c : ℝ,
      ((c * L + 2 * P) / Real.sqrt (c ^ 2 * S) -
        (c ^ 3 * Q + 2 * c ^ 2 * S * P) / Real.sqrt (c ^ 2 * S) ^ 3) * |c| =
      c * (L / Real.sqrt S - Q / Real.sqrt S ^ 3) := by
    intro S L Q P c
    rcases le_or_gt S 0 with hS | hS
    · have h1 : Real.sqrt (c ^ 2 * S) = 0 :=
        Real.sqrt_eq_zero'.2 (mul_nonpos_of_nonneg_of_nonpos (sq_nonneg c) hS)
      have h2 : Real.sqrt S = 0 := Real.sqrt_eq_zero'.2 hS
      simp [h1, h2]
    · rcases eq_or_ne c 0 with hc | hc
      · subst hc; simp
      · have hs : 0 < Real.sqrt S := Real.sqrt_pos.2 hS
        have hsq : Real.sqrt S ^ 2 = S := Real.sq_sqrt hS.le
        have h1 : Real.sqrt (c ^ 2 * S) = |c| * Real.sqrt S := by
          rw [Real.sqrt_mul' _ hS.le, Real.sqrt_sq_eq_abs]
        rw [h1]
        generalize Real.sqrt S = s at hs hsq ⊢
        subst hsq
        rcases lt_or_gt_of_ne hc with hc' | hc'
        · rw [abs_of_neg hc']
          field_simp
          ring
        · rw [abs_of_pos hc']
          field_simp
          ring
  have key : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), (∀ i j : Fin 3, A i j = A j i) →
      ∀ (ν η : Fin 3 → ℝ) (Hw : Fin 3 → Fin 3 → ℝ) (c : ℝ),
      ((∑ i : Fin 3, ∑ j : Fin 3, A i j * (c * Hw i j + ν i * η j + ν j * η i)) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * (c * ν i) * (c * ν j)) -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * (c * ν a) * (A j b * (c * ν b)) * (c * Hw i j + ν i * η j + ν j * η i)) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * (c * ν i) * (c * ν j)) ^ 3) * |c| =
      c * ((∑ i : Fin 3, ∑ j : Fin 3, A i j * Hw i j) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j) -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * ν a * (A j b * ν b) * Hw i j) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j) ^ 3) := by
    intro A hA ν η Hw c
    have B1 : ∑ i : Fin 3, ∑ j : Fin 3, A i j * (c * ν i) * (c * ν j) =
        c ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j := by
      simp only [Fin.sum_univ_three]; ring
    have B2 : ∑ i : Fin 3, ∑ j : Fin 3, A i j * (c * Hw i j + ν i * η j + ν j * η i) =
        c * (∑ i : Fin 3, ∑ j : Fin 3, A i j * Hw i j) +
          2 * ∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * η j := by
      simp only [Fin.sum_univ_three]
      rw [hA 1 0, hA 2 0, hA 2 1]
      ring
    have B3 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * (c * ν a) * (A j b * (c * ν b)) * (c * Hw i j + ν i * η j + ν j * η i) =
        c ^ 3 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * ν a * (A j b * ν b) * Hw i j) +
        2 * c ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j) *
          ∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * η j := by
      simp only [Fin.sum_univ_three]
      rw [hA 1 0, hA 2 0, hA 2 1]
      ring
    rw [B1, B2, B3]
    exact fin _ _ _ _ c
  
  simp only [levelMeanCurvCoord, lapLoc, e1, e2]
  exact key _ hA (fun k => partialDeriv k w z) (fun k => partialDeriv k h z)
    (fun i j => hessLoc G w i j z) (h z)

theorem lmc_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (φ : E3 → ℝ) (hφ : ContDiffOn ℝ ∞ φ U) (hdφ : ∀ z ∈ U, fderiv ℝ φ z ≠ 0) :
    ContDiffOn ℝ ∞ (levelMeanCurvCoord G φ) U :=
by
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  
  have hSpos : ∀ y ∈ U, 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i φ y * partialDeriv j φ y := by
    intro y hy
    have hx0 : (fun k : Fin 3 => partialDeriv k φ y) ≠ 0 := by
      intro h0
      apply hdφ y hy
      have hlin : (fderiv ℝ φ y : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
          have := congrFun h0 i
          simpa [partialDeriv] using this)
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := LinearMap.congr_fun hlin v
      simpa using this
    have hpos := (hpd y hy).inv.dotProduct_mulVec_pos hx0
    refine lt_of_lt_of_eq hpos ?_
    simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hp : ∀ k : Fin 3, ContDiffOn ℝ ∞ (partialDeriv k φ) U := hpdv φ hφ
  have hpp : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i (partialDeriv j φ)) U :=
    fun i j => hpdv _ (hp j) i
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  have hH : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G φ i j) U := by
    intro i j
    unfold hessLoc
    exact (hpp i j).sub (ContDiffOn.sum fun k _ => (hΓ k i j).mul (hp k))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G φ) U := by
    unfold lapLoc
    exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hGi i j).mul (hH i j)
  have hS : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i φ y * partialDeriv j φ y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ((hGi i j).mul (hp i)).mul (hp j)
  have hN : ContDiffOn ℝ ∞ (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i φ y * partialDeriv j φ y)) U :=
    hS.sqrt (fun y hy => (hSpos y hy).ne')
  have hNne : ∀ y ∈ U, Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i φ y * partialDeriv j φ y) ≠ 0 :=
    fun y hy => Real.sqrt_ne_zero'.2 (hSpos y hy)
  have hN3 := hN.pow 3
  have hQ : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ i a * partialDeriv a φ y * ((G y)⁻¹ j b * partialDeriv b φ y) *
        hessLoc G φ i j y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ContDiffOn.sum fun a _ =>
      ContDiffOn.sum fun b _ =>
        (((hGi i a).mul (hp a)).mul ((hGi j b).mul (hp b))).mul (hH i j)
  have hfin := (hLap.div hN hNne).sub (hQ.div hN3 (fun y hy => pow_ne_zero 3 (hNne y hy)))
  exact hfin.congr (fun y _ => rfl)

theorem lmc_deriv_thirdJet (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (y₀ : E3) (hy₀ : y₀ ∈ U) (φ₁ φ₂ : E3 → ℝ) (hφ₁ : ContDiffOn ℝ ∞ φ₁ U)
    (hφ₂ : ContDiffOn ℝ ∞ φ₂ U) (hdφ₁ : fderiv ℝ φ₁ y₀ ≠ 0)
    (h1 : ∀ j : Fin 3, partialDeriv j φ₁ y₀ = partialDeriv j φ₂ y₀)
    (h2 : ∀ i j : Fin 3, partialDeriv i (partialDeriv j φ₁) y₀ =
      partialDeriv i (partialDeriv j φ₂) y₀) (a : Fin 3) :
    partialDeriv a (levelMeanCurvCoord G φ₁) y₀ - partialDeriv a (levelMeanCurvCoord G φ₂) y₀ =
      ∑ i : Fin 3, ∑ j : Fin 3,
        ((G y₀)⁻¹ i j / Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3,
            (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀) -
          (∑ k : Fin 3, (G y₀)⁻¹ i k * partialDeriv k φ₁ y₀) *
            (∑ l : Fin 3, (G y₀)⁻¹ j l * partialDeriv l φ₁ y₀) /
            Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3,
              (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀) ^ 3) *
        (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
          partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀) :=
by
  
  have rCongr : ∀ {F₁ F₂ : E3 → ℝ} {d d' : ℝ}, lmcJAgree a y₀ F₁ F₂ d → d = d' →
      lmcJAgree a y₀ F₁ F₂ d' := by
    intro F₁ F₂ d d' h hd; subst hd; exact h
  have rCommon : ∀ {c : E3 → ℝ}, DifferentiableAt ℝ c y₀ → lmcJAgree a y₀ c c 0 :=
    fun hc => ⟨hc, hc, rfl, sub_self _⟩
  have rMul : ∀ {F₁ F₂ K₁ K₂ : E3 → ℝ} {d d' : ℝ}, lmcJAgree a y₀ F₁ F₂ d →
      lmcJAgree a y₀ K₁ K₂ d' →
      lmcJAgree a y₀ (fun y => F₁ y * K₁ y) (fun y => F₂ y * K₂ y) (d * K₁ y₀ + F₁ y₀ * d') := by
    rintro F₁ F₂ K₁ K₂ d d' ⟨hF₁, hF₂, hFv, hFd⟩ ⟨hK₁, hK₂, hKv, hKd⟩
    refine ⟨hF₁.mul hK₁, hF₂.mul hK₂, by simp only [hFv, hKv], ?_⟩
    unfold partialDeriv at hFd hKd ⊢
    rw [fderiv_fun_mul hF₁ hK₁, fderiv_fun_mul hF₂ hK₂]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [← hFd, ← hKd, hFv, hKv]
    ring
  have rSub : ∀ {F₁ F₂ K₁ K₂ : E3 → ℝ} {d d' : ℝ}, lmcJAgree a y₀ F₁ F₂ d →
      lmcJAgree a y₀ K₁ K₂ d' →
      lmcJAgree a y₀ (fun y => F₁ y - K₁ y) (fun y => F₂ y - K₂ y) (d - d') := by
    rintro F₁ F₂ K₁ K₂ d d' ⟨hF₁, hF₂, hFv, hFd⟩ ⟨hK₁, hK₂, hKv, hKd⟩
    refine ⟨hF₁.sub hK₁, hF₂.sub hK₂, by simp only [hFv, hKv], ?_⟩
    unfold partialDeriv at hFd hKd ⊢
    rw [fderiv_fun_sub hF₁ hK₁, fderiv_fun_sub hF₂ hK₂]
    simp only [ContinuousLinearMap.sub_apply]
    rw [← hFd, ← hKd]
    ring
  have rSum : ∀ {F₁ F₂ : Fin 3 → E3 → ℝ} {d : Fin 3 → ℝ},
      (∀ i, lmcJAgree a y₀ (F₁ i) (F₂ i) (d i)) →
      lmcJAgree a y₀ (fun y => ∑ i : Fin 3, F₁ i y) (fun y => ∑ i : Fin 3, F₂ i y)
        (∑ i : Fin 3, d i) := by
    intro F₁ F₂ d h
    refine ⟨DifferentiableAt.fun_sum (fun i _ => (h i).1),
      DifferentiableAt.fun_sum (fun i _ => (h i).2.1), ?_, ?_⟩
    · exact Finset.sum_congr rfl (fun i _ => (h i).2.2.1)
    · unfold partialDeriv
      rw [fderiv_fun_sum (fun i _ => (h i).1), fderiv_fun_sum (fun i _ => (h i).2.1)]
      simp only [ContinuousLinearMap.sum_apply]
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl (fun i _ => (h i).2.2.2)
  have rComp : ∀ {F₁ F₂ : E3 → ℝ} {d : ℝ} (g : ℝ → ℝ) (g' : ℝ), HasDerivAt g g' (F₁ y₀) →
      lmcJAgree a y₀ F₁ F₂ d →
      lmcJAgree a y₀ (fun y => g (F₁ y)) (fun y => g (F₂ y)) (g' * d) := by
    rintro F₁ F₂ d g g' hg ⟨hF₁, hF₂, hFv, hFd⟩
    have hg2 : HasDerivAt g g' (F₂ y₀) := by rw [← hFv]; exact hg
    have k1 := hg.comp_hasFDerivAt y₀ hF₁.hasFDerivAt
    have k2 := hg2.comp_hasFDerivAt y₀ hF₂.hasFDerivAt
    refine ⟨k1.differentiableAt, k2.differentiableAt, by simp only [hFv], ?_⟩
    unfold partialDeriv at hFd ⊢
    rw [show (fun y => g (F₁ y)) = g ∘ F₁ from rfl, show (fun y => g (F₂ y)) = g ∘ F₂ from rfl,
      k1.fderiv, k2.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [← hFd]
    ring
  have rDiv : ∀ {A₁ A₂ B₁ B₂ : E3 → ℝ} {dA dB : ℝ}, lmcJAgree a y₀ A₁ A₂ dA →
      lmcJAgree a y₀ B₁ B₂ dB → B₁ y₀ ≠ 0 →
      lmcJAgree a y₀ (fun y => A₁ y / B₁ y) (fun y => A₂ y / B₂ y)
        (dA * (B₁ y₀)⁻¹ + A₁ y₀ * (-(B₁ y₀ ^ 2)⁻¹ * dB)) := by
    intro A₁ A₂ B₁ B₂ dA dB hA hB hB0
    have hI := rComp (fun t => t⁻¹) _ (hasDerivAt_inv hB0) hB
    have hM := rMul hA hI
    simp only [div_eq_mul_inv]
    exact hM
  
  have hK : ∀ (f : E3 → ℝ) (k : Fin 3), ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (partialDeriv k f) U := by
    intro f k hf
    exact (hf.fderiv_of_isOpen hU (m := ∞) (by simp)).clm_apply contDiffOn_const
  have hD : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → DifferentiableAt ℝ f y₀ := fun f hf =>
    (hf.contDiffAt (hU.mem_nhds hy₀)).differentiableAt (by simp)
  have hGent : ∀ k l, DifferentiableAt ℝ (fun y => G y k l) y₀ := fun k l => hD _ (hG k l)
  have hdet : (G y₀).det ≠ 0 := (hpd y₀ hy₀).det_pos.ne'
  have hdetD : DifferentiableAt ℝ (fun y => (G y).det) y₀ := by
    simp only [Matrix.det_fin_three]
    have h00 := hGent 0 0; have h01 := hGent 0 1; have h02 := hGent 0 2
    have h10 := hGent 1 0; have h11 := hGent 1 1; have h12 := hGent 1 2
    have h20 := hGent 2 0; have h21 := hGent 2 1; have h22 := hGent 2 2
    fun_prop
  have hGi : ∀ k l, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) y₀ := by
    intro k l
    have hfun : (fun y => (G y)⁻¹ k l) = fun y => ((G y).det)⁻¹ * (G y).adjugate k l := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [hfun]
    refine (hdetD.inv hdet).mul ?_
    have h00 := hGent 0 0; have h01 := hGent 0 1; have h02 := hGent 0 2
    have h10 := hGent 1 0; have h11 := hGent 1 1; have h12 := hGent 1 2
    have h20 := hGent 2 0; have h21 := hGent 2 1; have h22 := hGent 2 2
    simp only [Matrix.adjugate_fin_three]
    fin_cases k <;> fin_cases l <;> simp <;> fun_prop
  have hpdG : ∀ i j l : Fin 3, DifferentiableAt ℝ (partialDeriv i (fun z => G z j l)) y₀ :=
    fun i j l => hD _ (hK _ _ (hG j l))
  have hΓ : ∀ k i j : Fin 3, DifferentiableAt ℝ (christoffel G k i j) y₀ := by
    intro k i j
    show DifferentiableAt ℝ (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
        - partialDeriv l (fun z => G z i j) y)) y₀
    exact DifferentiableAt.const_mul (DifferentiableAt.fun_sum fun l _ =>
      (hGi k l).mul (((hpdG i j l).add (hpdG j i l)).sub (hpdG l i j))) _
  
  have hSpos : 0 < ∑ k : Fin 3, ∑ l : Fin 3,
      (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀ := by
    have hξ : (fun k : Fin 3 => partialDeriv k φ₁ y₀) ≠ 0 := by
      intro h
      apply hdφ₁
      have hlin : (fderiv ℝ φ₁ y₀ : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
          simpa [partialDeriv] using congrFun h i)
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := LinearMap.congr_fun hlin v
      simpa using this
    have hpos := (hpd y₀ hy₀).inv.dotProduct_mulVec_pos hξ
    have heq : ∑ k : Fin 3, ∑ l : Fin 3,
        (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀ =
        dotProduct (star (fun k : Fin 3 => partialDeriv k φ₁ y₀))
          (Matrix.mulVec (G y₀)⁻¹ (fun k : Fin 3 => partialDeriv k φ₁ y₀)) := by
      simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
      ring
    rw [heq]; exact hpos
  have hN0 : Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3,
      (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀) ≠ 0 :=
    (Real.sqrt_pos.2 hSpos).ne'
  
  have aP : ∀ k, lmcJAgree a y₀ (partialDeriv k φ₁) (partialDeriv k φ₂) 0 := fun k =>
    ⟨hD _ (hK _ _ hφ₁), hD _ (hK _ _ hφ₂), h1 k, by rw [h2 a k, sub_self]⟩
  have aM : ∀ i j, lmcJAgree a y₀ (partialDeriv i (partialDeriv j φ₁))
      (partialDeriv i (partialDeriv j φ₂))
      (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
          partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀) := fun i j =>
    ⟨hD _ (hK _ _ (hK _ _ hφ₁)), hD _ (hK _ _ (hK _ _ hφ₂)), h2 i j, rfl⟩
  have aHess : ∀ i j, lmcJAgree a y₀ (fun y => partialDeriv i (partialDeriv j φ₁) y -
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₁ y)
      (fun y => partialDeriv i (partialDeriv j φ₂) y -
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₂ y)
      (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
          partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀) := fun i j =>
    rCongr (rSub (aM i j) (rSum fun k => rMul (rCommon (hΓ k i j)) (aP k))) (by simp)
  have aS : lmcJAgree a y₀
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i φ₁ y * partialDeriv j φ₁ y)
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i φ₂ y * partialDeriv j φ₂ y)
      0 :=
    rCongr (rSum fun i => rSum fun j => rMul (rMul (rCommon (hGi i j)) (aP i)) (aP j))
      (by simp)
  have aSqrt : lmcJAgree a y₀
      (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i φ₁ y * partialDeriv j φ₁ y))
      (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i φ₂ y * partialDeriv j φ₂ y))
      0 :=
    rCongr (rComp Real.sqrt _ (Real.hasDerivAt_sqrt hSpos.ne') aS) (mul_zero _)
  have aPow : lmcJAgree a y₀
      (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i φ₁ y * partialDeriv j φ₁ y) ^ 3)
      (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i φ₂ y * partialDeriv j φ₂ y) ^ 3)
      0 :=
    rCongr (rComp (fun t => t ^ 3) _ (hasDerivAt_pow 3 _) aSqrt) (mul_zero _)
  have aL : lmcJAgree a y₀
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
        (partialDeriv i (partialDeriv j φ₁) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₁ y))
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
        (partialDeriv i (partialDeriv j φ₂) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₂ y))
      (∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
        (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
          partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀)) :=
    rCongr (rSum fun i => rSum fun j => rMul (rCommon (hGi i j)) (aHess i j)) (by simp)
  have aQ : lmcJAgree a y₀
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y)⁻¹ i c * partialDeriv c φ₁ y * ((G y)⁻¹ j d * partialDeriv d φ₁ y) *
          (partialDeriv i (partialDeriv j φ₁) y -
            ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₁ y))
      (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y)⁻¹ i c * partialDeriv c φ₂ y * ((G y)⁻¹ j d * partialDeriv d φ₂ y) *
          (partialDeriv i (partialDeriv j φ₂) y -
            ∑ k : Fin 3, christoffel G k i j y * partialDeriv k φ₂ y))
      (∑ i : Fin 3, ∑ j : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y₀)⁻¹ i c * partialDeriv c φ₁ y₀ * ((G y₀)⁻¹ j d * partialDeriv d φ₁ y₀) *
          (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
            partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀)) :=
    rCongr (rSum fun i => rSum fun j => rSum fun c => rSum fun d =>
      rMul (rMul (rMul (rCommon (hGi i c)) (aP c)) (rMul (rCommon (hGi j d)) (aP d)))
        (aHess i j)) (by simp only [zero_mul, mul_zero, add_zero, zero_add])
  have aH : lmcJAgree a y₀ (levelMeanCurvCoord G φ₁) (levelMeanCurvCoord G φ₂)
      ((∑ i : Fin 3, ∑ j : Fin 3, (G y₀)⁻¹ i j *
        (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
          partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀)) *
        (Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3,
          (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀))⁻¹ -
       (∑ i : Fin 3, ∑ j : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y₀)⁻¹ i c * partialDeriv c φ₁ y₀ * ((G y₀)⁻¹ j d * partialDeriv d φ₁ y₀) *
          (partialDeriv a (partialDeriv i (partialDeriv j φ₁)) y₀ -
            partialDeriv a (partialDeriv i (partialDeriv j φ₂)) y₀)) *
        (Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3,
          (G y₀)⁻¹ k l * partialDeriv k φ₁ y₀ * partialDeriv l φ₁ y₀) ^ 3)⁻¹) :=
    rCongr (rSub (rDiv aL aSqrt hN0) (rDiv aQ aPow (pow_ne_zero 3 hN0)))
      (by simp only [mul_zero, add_zero])
  rw [aH.2.2.2]
  simp only [Fin.sum_univ_three]
  ring

theorem bump_jets (U : Set E3) (hU : IsOpen U) (y₀ : E3) (hy₀ : y₀ ∈ U) (ψ : E3 → ℝ)
    (hψ : ContDiffOn ℝ ∞ ψ U) (hψ0 : ψ y₀ = 0) (t : ℝ) :
    ContDiffOn ℝ ∞ (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2)) U ∧
      fderiv ℝ (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2)) y₀ = fderiv ℝ ψ y₀ ∧
      (∀ j : Fin 3, partialDeriv j (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2)) y₀ =
        partialDeriv j ψ y₀) ∧
      (∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2))) y₀ =
        partialDeriv i (partialDeriv j ψ) y₀) ∧
      (∀ a i j : Fin 3, partialDeriv a (partialDeriv i (partialDeriv j
          (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2)))) y₀ =
        partialDeriv a (partialDeriv i (partialDeriv j ψ)) y₀ +
          2 * t * ((if i = j then partialDeriv a ψ y₀ else 0) +
            (if a = j then partialDeriv i ψ y₀ else 0) +
            (if a = i then partialDeriv j ψ y₀ else 0))) :=
by
  
  have hpdC : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ j : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv j f) U := by
    intro f hf j
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) U :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact h1.clm_apply contDiffOn_const
  have hdiff : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ z ∈ U, DifferentiableAt ℝ f z := by
    intro f hf z hz
    exact (hf.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)
  have hprod : ∀ (f g : E3 → ℝ) (z : E3), DifferentiableAt ℝ f z → DifferentiableAt ℝ g z →
      ∀ i : Fin 3, partialDeriv i (fun y => f y * g y) z =
        partialDeriv i f z * g z + f z * partialDeriv i g z := by
    intro f g z hf hg i
    unfold partialDeriv
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hadd : ∀ (f g : E3 → ℝ) (z : E3), DifferentiableAt ℝ f z → DifferentiableAt ℝ g z →
      ∀ i : Fin 3, partialDeriv i (fun y => f y + g y) z =
        partialDeriv i f z + partialDeriv i g z := by
    intro f g z hf hg i
    unfold partialDeriv
    rw [fderiv_fun_add hf hg]
    rfl
  have hloc : ∀ (f g : E3 → ℝ) (z : E3), z ∈ U → (∀ y ∈ U, f y = g y) → ∀ i : Fin 3,
      partialDeriv i f z = partialDeriv i g z := by
    intro f g z hz hfg i
    have hev : f =ᶠ[𝓝 z] g := Filter.eventually_of_mem (hU.mem_nhds hz) hfg
    unfold partialDeriv
    rw [hev.fderiv_eq]
  have hconst : ∀ (c : ℝ) (z : E3) (i : Fin 3), partialDeriv i (fun _ => c) z = 0 := by
    intro c z i
    unfold partialDeriv
    simp
  
  obtain ⟨h, hh⟩ : ∃ h : E3 → ℝ, h = fun y => 1 + t * ‖y - y₀‖ ^ 2 := ⟨_, rfl⟩
  have hφ : (fun z => ψ z * (1 + t * ‖z - y₀‖ ^ 2)) = fun z => ψ z * h z := by
    rw [hh]
  rw [hφ]
  have hhC : ContDiff ℝ ∞ h := by
    rw [hh]
    exact contDiff_const.add (contDiff_const.mul
      ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)))
  have hhD : ∀ z, DifferentiableAt ℝ h z := fun z => (hhC.differentiable (by simp)) z
  have hh0 : h y₀ = 1 := by rw [hh]; simp
  have hhpd : ∀ (z : E3) (j : Fin 3), partialDeriv j h z = 2 * t * (z j - y₀ j) := by
    intro z j
    have hd : HasFDerivAt (fun y : E3 => y - y₀) (ContinuousLinearMap.id ℝ E3) z :=
      (hasFDerivAt_id z).sub_const y₀
    have h2 := ((hd.norm_sq).const_mul t).const_add 1
    rw [hh]
    unfold partialDeriv
    rw [h2.fderiv]
    simp [EuclideanSpace.inner_single_right]
    ring
  
  have hcH : ∀ (j : Fin 3) (z : E3), HasFDerivAt (fun y : E3 => 2 * t * (y j - y₀ j))
      ((2 * t) • (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) j : E3 →L[ℝ] ℝ)) z := by
    intro j z
    have := (((PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) j).hasFDerivAt (x := z)).sub_const
      (y₀ j)).const_mul (2 * t)
    convert this using 1
  have hcD : ∀ (j : Fin 3) (z : E3), DifferentiableAt ℝ (fun y : E3 => 2 * t * (y j - y₀ j)) z :=
    fun j z => (hcH j z).differentiableAt
  have hcpd : ∀ (z : E3) (i j : Fin 3),
      partialDeriv i (fun y : E3 => 2 * t * (y j - y₀ j)) z = if i = j then 2 * t else 0 := by
    intro z i j
    unfold partialDeriv
    rw [(hcH j z).fderiv]
    by_cases hij : i = j
    · subst hij; simp
    · simp [EuclideanSpace.single_apply, hij, Ne.symm hij]
  
  have hψD : ∀ z ∈ U, DifferentiableAt ℝ ψ z := hdiff ψ hψ
  have hψ1C : ∀ j, ContDiffOn ℝ ∞ (partialDeriv j ψ) U := hpdC ψ hψ
  have hψ1D : ∀ j, ∀ z ∈ U, DifferentiableAt ℝ (partialDeriv j ψ) z :=
    fun j => hdiff _ (hψ1C j)
  have hψ2D : ∀ i j, ∀ z ∈ U, DifferentiableAt ℝ (partialDeriv i (partialDeriv j ψ)) z :=
    fun i j => hdiff _ (hpdC _ (hψ1C j) i)
  
  have hA : ∀ j, ∀ y ∈ U, partialDeriv j (fun y => ψ y * h y) y =
      partialDeriv j ψ y * h y + ψ y * (2 * t * (y j - y₀ j)) := by
    intro j y hy
    rw [hprod ψ h y (hψD y hy) (hhD y) j, hhpd y j]
  
  have hB : ∀ i j, ∀ z ∈ U, partialDeriv i (partialDeriv j (fun y => ψ y * h y)) z =
      partialDeriv i (partialDeriv j ψ) z * h z + partialDeriv j ψ z * (2 * t * (z i - y₀ i)) +
        (partialDeriv i ψ z * (2 * t * (z j - y₀ j)) + ψ z * (if i = j then 2 * t else 0)) := by
    intro i j z hz
    rw [hloc _ (fun y => partialDeriv j ψ y * h y + ψ y * (2 * t * (y j - y₀ j))) z hz (hA j) i]
    rw [hadd (fun y => partialDeriv j ψ y * h y) (fun y => ψ y * (2 * t * (y j - y₀ j))) z
      ((hψ1D j z hz).mul (hhD z)) ((hψD z hz).mul (hcD j z)) i]
    rw [hprod (partialDeriv j ψ) h z (hψ1D j z hz) (hhD z) i,
      hprod ψ (fun y : E3 => 2 * t * (y j - y₀ j)) z (hψD z hz) (hcD j z) i, hhpd, hcpd]
  refine ⟨hψ.mul hhC.contDiffOn, ?_, ?_, ?_, ?_⟩
  · rw [fderiv_fun_mul (hψD y₀ hy₀) (hhD y₀), hψ0, hh0, zero_smul, one_smul, zero_add]
  · intro j
    unfold partialDeriv
    rw [fderiv_fun_mul (hψD y₀ hy₀) (hhD y₀), hψ0, hh0, zero_smul, one_smul, zero_add]
  · intro i j
    rw [hB i j y₀ hy₀, hh0, hψ0]
    simp
  · intro a i j
    rw [hloc _ (fun z => partialDeriv i (partialDeriv j ψ) z * h z +
        partialDeriv j ψ z * (2 * t * (z i - y₀ i)) +
        (partialDeriv i ψ z * (2 * t * (z j - y₀ j)) + ψ z * (if i = j then 2 * t else 0)))
        y₀ hy₀ (hB i j) a]
    have d1 : DifferentiableAt ℝ (fun z => partialDeriv i (partialDeriv j ψ) z * h z) y₀ :=
      (hψ2D i j y₀ hy₀).mul (hhD y₀)
    have d2 : DifferentiableAt ℝ (fun z => partialDeriv j ψ z * (2 * t * (z i - y₀ i))) y₀ :=
      (hψ1D j y₀ hy₀).mul (hcD i y₀)
    have d3 : DifferentiableAt ℝ (fun z => partialDeriv i ψ z * (2 * t * (z j - y₀ j))) y₀ :=
      (hψ1D i y₀ hy₀).mul (hcD j y₀)
    have d4 : DifferentiableAt ℝ (fun z => ψ z * (if i = j then 2 * t else 0)) y₀ :=
      (hψD y₀ hy₀).mul (differentiableAt_const _)
    rw [hadd (fun z => partialDeriv i (partialDeriv j ψ) z * h z +
        partialDeriv j ψ z * (2 * t * (z i - y₀ i)))
      (fun z => partialDeriv i ψ z * (2 * t * (z j - y₀ j)) + ψ z * (if i = j then 2 * t else 0))
      y₀ (d1.add d2) (d3.add d4) a]
    rw [hadd _ _ y₀ d1 d2 a, hadd _ _ y₀ d3 d4 a]
    rw [hprod (partialDeriv i (partialDeriv j ψ)) h y₀ (hψ2D i j y₀ hy₀) (hhD y₀) a,
      hprod (partialDeriv j ψ) (fun z : E3 => 2 * t * (z i - y₀ i)) y₀ (hψ1D j y₀ hy₀)
        (hcD i y₀) a,
      hprod (partialDeriv i ψ) (fun z : E3 => 2 * t * (z j - y₀ j)) y₀ (hψ1D i y₀ hy₀)
        (hcD j y₀) a,
      hprod ψ (fun _ : E3 => if i = j then 2 * t else 0) y₀ (hψD y₀ hy₀)
        (differentiableAt_const _) a,
      hh0, hhpd, hcpd, hcpd, hconst, hψ0]
    simp only [sub_self, mul_zero, add_zero, zero_mul, mul_one]
    split_ifs <;> ring

theorem bump_trace_coeff (M : Matrix (Fin 3) (Fin 3) ℝ) (hM : M.PosDef)
    (hMs : ∀ i j : Fin 3, M i j = M j i) (ξ : Fin 3 → ℝ) (hξ : ξ ≠ 0) :
    ∃ c : ℝ, 0 < c ∧ ∀ a : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3,
      (M⁻¹ i j / Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, M⁻¹ k l * ξ k * ξ l) -
        (∑ k : Fin 3, M⁻¹ i k * ξ k) * (∑ l : Fin 3, M⁻¹ j l * ξ l) /
          Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, M⁻¹ k l * ξ k * ξ l) ^ 3) *
      ((if i = j then ξ a else 0) + (if a = j then ξ i else 0) + (if a = i then ξ j else 0)) =
        c * ξ a :=
by
  
  have hsym : ∀ i j : Fin 3, M⁻¹ i j = M⁻¹ j i := by
    have hT : M.transpose = M := Matrix.ext (fun i j => (hMs j i))
    have h := Matrix.transpose_nonsing_inv M
    rw [hT] at h
    intro i j
    have := congrFun (congrFun h j) i
    simpa [Matrix.transpose_apply] using this
  have hpos : ∀ x : Fin 3 → ℝ, x ≠ 0 → 0 < ∑ k : Fin 3, ∑ l : Fin 3, M⁻¹ k l * x k * x l := by
    intro x hx
    have h := hM.inv.dotProduct_mulVec_pos hx
    simp only [dotProduct, Matrix.mulVec, star_trivial, Fin.sum_univ_three] at h ⊢
    convert h using 1
    ring
  generalize M⁻¹ = A at hsym hpos ⊢
  
  have hs : 0 < ∑ k : Fin 3, ∑ l : Fin 3, A k l * ξ k * ξ l := hpos ξ hξ
  have hr2 := Real.sq_sqrt hs.le
  have hr := Real.sqrt_pos.mpr hs
  generalize Real.sqrt (∑ k : Fin 3, ∑ l : Fin 3, A k l * ξ k * ξ l) = r at hr2 hr ⊢
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = ∑ k : Fin 3, ∑ l : Fin 3, A k l * ξ k * ξ l := ⟨_, rfl⟩
  rw [← hsdef] at hs hr2
  obtain ⟨u, hu⟩ : ∃ u : Fin 3 → ℝ, ∀ i, u i = ∑ k : Fin 3, A i k * ξ k := ⟨_, fun _ => rfl⟩
  simp only [← hu]
  have hF2 : ∑ j : Fin 3, u j * ξ j = s := by
    rw [hsdef]; simp only [hu, Fin.sum_univ_three]; ring
  have hF3 : ∀ a, ∑ i : Fin 3, A i a * ξ i = u a := by
    intro a; rw [hu a]; exact Finset.sum_congr rfl (fun i _ => by rw [hsym])
  have hr0 : r ≠ 0 := hr.ne'
  
  have generic : ∀ (B : Fin 3 → Fin 3 → ℝ), (∀ a, ∑ j : Fin 3, B a j * ξ j = 0) →
      (∀ a, ∑ i : Fin 3, B i a * ξ i = 0) → ∀ a, ∑ i : Fin 3, ∑ j : Fin 3, B i j *
        ((if i = j then ξ a else 0) + (if a = j then ξ i else 0) + (if a = i then ξ j else 0)) =
        (∑ i : Fin 3, B i i) * ξ a := by
    intro B h1 h2 a
    have e1 := h1 a
    have e2 := h2 a
    fin_cases a <;> simp [Fin.sum_univ_three] at e1 e2 ⊢ <;> linear_combination e1 + e2
  have h1 : ∀ a, ∑ j : Fin 3, (A a j / r - u a * u j / r ^ 3) * ξ j = 0 := by
    intro a
    have : ∑ j : Fin 3, (A a j / r - u a * u j / r ^ 3) * ξ j =
        (∑ j : Fin 3, A a j * ξ j) / r - u a * (∑ j : Fin 3, u j * ξ j) / r ^ 3 := by
      simp only [Fin.sum_univ_three]; ring
    rw [this, ← hu a, hF2, ← hr2]
    field_simp
    ring
  have h2 : ∀ a, ∑ i : Fin 3, (A i a / r - u i * u a / r ^ 3) * ξ i = 0 := by
    intro a
    have : ∑ i : Fin 3, (A i a / r - u i * u a / r ^ 3) * ξ i =
        (∑ i : Fin 3, A i a * ξ i) / r - u a * (∑ j : Fin 3, u j * ξ j) / r ^ 3 := by
      simp only [Fin.sum_univ_three]; ring
    rw [this, hF3 a, hF2, ← hr2]
    field_simp
    ring
  
  obtain ⟨w, hw⟩ : ∃ w : Fin 3 → Fin 3 → ℝ, ∀ k i, w k i = s * (if i = k then 1 else 0) - u k * ξ i :=
    ⟨_, fun _ _ => rfl⟩
  have hQ : ∀ k, ∑ i : Fin 3, ∑ j : Fin 3, A i j * w k i * w k j = s * (s * A k k - u k * u k) := by
    intro k
    have ec := hsdef
    simp only [Fin.sum_univ_three] at ec
    fin_cases k
    · have ea := (hu 0).symm
      have eb := hF3 0
      simp only [Fin.sum_univ_three] at ea eb
      simp [hw, Fin.sum_univ_three]
      linear_combination (-s * u 0) * ea + (-s * u 0) * eb - (u 0) ^ 2 * ec
    · have ea := (hu 1).symm
      have eb := hF3 1
      simp only [Fin.sum_univ_three] at ea eb
      simp [hw, Fin.sum_univ_three]
      linear_combination (-s * u 1) * ea + (-s * u 1) * eb - (u 1) ^ 2 * ec
    · have ea := (hu 2).symm
      have eb := hF3 2
      simp only [Fin.sum_univ_three] at ea eb
      simp [hw, Fin.sum_univ_three]
      linear_combination (-s * u 2) * ea + (-s * u 2) * eb - (u 2) ^ 2 * ec
  have hnn : ∀ k, 0 ≤ s * A k k - u k * u k := by
    intro k
    have h0 : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, A i j * w k i * w k j := by
      by_cases hwk : w k = 0
      · simp [hwk]
      · exact (hpos _ hwk).le
    rw [hQ k] at h0
    exact (mul_nonneg_iff_of_pos_left hs).mp h0
  obtain ⟨m, hm⟩ : ∃ m, ξ m ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hξ (funext hcon)
  have hstrict : ∀ k, k ≠ m → 0 < s * A k k - u k * u k := by
    intro k hkm
    have hwk : w k ≠ 0 := by
      intro hw0
      have hcm := congrFun hw0 m
      rw [hw, if_neg (Ne.symm hkm)] at hcm
      have huk : u k = 0 := by
        simp only [mul_zero, zero_sub, Pi.zero_apply, neg_eq_zero, mul_eq_zero] at hcm
        tauto
      have hck := congrFun hw0 k
      rw [hw, if_pos rfl, huk] at hck
      simp at hck
      exact hs.ne' hck
    have h0 := hpos _ hwk
    rw [hQ k] at h0
    exact (mul_pos_iff_of_pos_left hs).mp h0
  have hgap : 0 < (∑ i : Fin 3, A i i) * s - ∑ i : Fin 3, u i * u i := by
    have e0 := hnn 0
    have e1 := hnn 1
    have e2 := hnn 2
    simp only [Fin.sum_univ_three]
    by_cases hm0 : m = 0
    · have := hstrict 1 (by rw [hm0]; decide)
      linarith
    · have := hstrict 0 (fun h => hm0 h.symm)
      linarith
  
  refine ⟨∑ i : Fin 3, (A i i / r - u i * u i / r ^ 3), ?_, ?_⟩
  · have hc : ∑ i : Fin 3, (A i i / r - u i * u i / r ^ 3) =
        ((∑ i : Fin 3, A i i) * s - ∑ i : Fin 3, u i * u i) / r ^ 3 := by
      rw [← hr2]
      simp only [Fin.sum_univ_three]
      field_simp
      ring
    rw [hc]
    exact div_pos hgap (pow_pos hr 3)
  · intro a
    exact generic (fun i j => A i j / r - u i * u j / r ^ 3) h1 h2 a

theorem sign_transfer_axis (U : Set E3) (hU : IsOpen U) (y₀ : E3) (hy₀ : y₀ ∈ U)
    (φ K : E3 → ℝ) (a : Fin 3) (hφ : ContDiffOn ℝ 1 φ U) (hK : ContDiffOn ℝ 1 K U)
    (hφ0 : φ y₀ = 0) (hzero : ∀ z ∈ U, φ z = 0 → K z = 0)
    (hpos : 0 < partialDeriv a φ y₀ * partialDeriv a K y₀) :
    ∃ ε : ℝ, 0 < ε ∧ Metric.ball y₀ ε ⊆ U ∧ ∀ z ∈ Metric.ball y₀ ε, φ z ≤ 0 → K z ≤ 0 :=
by
  
  have dirpos : ∀ (f : E3 → ℝ), ContDiffOn ℝ 1 f U → ∀ v : E3, 0 < fderiv ℝ f y₀ v →
      ∃ r : ℝ, 0 < r ∧ Metric.ball y₀ r ⊆ U ∧ ∀ y ∈ Metric.ball y₀ r,
        DifferentiableAt ℝ f y ∧ 0 < fderiv ℝ f y v := by
    intro f hf v hv
    have hcont : ContinuousOn (fderiv ℝ f) U := hf.continuousOn_fderiv_of_isOpen hU le_rfl
    have hdir : ContinuousOn (fun y => fderiv ℝ f y v) U := hcont.clm_apply continuousOn_const
    have hev : ∀ᶠ y in 𝓝 y₀, 0 < fderiv ℝ f y v :=
      continuousAt_const.eventually_lt (hdir.continuousAt (hU.mem_nhds hy₀)) hv
    obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff_ball.mp (hev.and (hU.mem_nhds hy₀))
    refine ⟨r, hr, fun y hy => (hball y hy).2, fun y hy => ⟨?_, (hball y hy).1⟩⟩
    exact (hf.differentiableOn one_ne_zero).differentiableAt (hU.mem_nhds (hball y hy).2)
  
  have linelt : ∀ (f : E3 → ℝ) (v : E3) (r : ℝ),
      (∀ y ∈ Metric.ball y₀ r, DifferentiableAt ℝ f y ∧ 0 < fderiv ℝ f y v) →
      ∀ z ∈ Metric.ball y₀ r, ∀ t : ℝ, 0 < t → z + t • v ∈ Metric.ball y₀ r →
        f z < f (z + t • v) := by
    intro f v r hf z hz t ht hzt
    have hseg : ∀ s ∈ Set.Icc (0:ℝ) t, z + s • v ∈ Metric.ball y₀ r := by
      intro s hs
      have h1 : 0 ≤ s / t := div_nonneg hs.1 ht.le
      have h2 : s / t ≤ 1 := (div_le_one ht).mpr hs.2
      have := (convex_ball y₀ r).add_smul_mem hz hzt ⟨h1, h2⟩
      rwa [smul_smul, div_mul_cancel₀ s ht.ne'] at this
    have hderiv : ∀ s ∈ Set.Icc (0:ℝ) t,
        HasDerivAt (fun s => f (z + s • v)) (fderiv ℝ f (z + s • v) v) s := by
      intro s hs
      have hl : HasDerivAt (fun s : ℝ => z + s • v) v s := by
        simpa using ((hasDerivAt_id s).smul_const v).const_add z
      exact (hf _ (hseg s hs)).1.hasFDerivAt.comp_hasDerivAt s hl
    have hcont : ContinuousOn (fun s => f (z + s • v)) (Set.Icc 0 t) :=
      fun s hs => (hderiv s hs).continuousAt.continuousWithinAt
    obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (fun s => f (z + s • v))
      (fun s => fderiv ℝ f (z + s • v) v) ht hcont
      (fun s hs => hderiv s (Set.Ioo_subset_Icc_self hs))
    have hpos' : 0 < fderiv ℝ f (z + ξ • v) v := (hf _ (hseg ξ (Set.Ioo_subset_Icc_self hξ))).2
    rw [hξeq] at hpos'
    simp only [zero_smul, add_zero, sub_zero] at hpos'
    have := (div_pos_iff_of_pos_right ht).mp hpos'
    linarith
  
  have segzero : ∀ (z v : E3) (δ : ℝ), 0 ≤ δ → (∀ s ∈ Set.Icc (0:ℝ) δ, z + s • v ∈ U) →
      φ z ≤ 0 → 0 < φ (z + δ • v) → ∃ s ∈ Set.Icc (0:ℝ) δ, φ (z + s • v) = 0 := by
    intro z v δ hδ hseg h0 h1
    have hline : Continuous (fun s : ℝ => z + s • v) :=
      continuous_const.add (continuous_id.smul continuous_const)
    have hg : ContinuousOn (fun s => φ (z + s • v)) (Set.Icc 0 δ) :=
      hφ.continuousOn.comp hline.continuousOn hseg
    have hmem : (0:ℝ) ∈ Set.Icc (φ (z + (0:ℝ) • v)) (φ (z + δ • v)) := by
      rw [zero_smul, add_zero]
      exact ⟨h0, h1.le⟩
    obtain ⟨s, hs, hs0⟩ := intermediate_value_Icc hδ hg hmem
    exact ⟨s, hs, hs0⟩
  
  have hc : partialDeriv a φ y₀ ≠ 0 := by
    intro h
    rw [h, zero_mul] at hpos
    exact lt_irrefl _ hpos
  have hφv : 0 < fderiv ℝ φ y₀ (partialDeriv a φ y₀ • e a) := by
    rw [ContinuousLinearMap.map_smul, smul_eq_mul]
    exact mul_self_pos.mpr hc
  have hKv : 0 < fderiv ℝ K y₀ (partialDeriv a φ y₀ • e a) := by
    rw [ContinuousLinearMap.map_smul, smul_eq_mul]
    exact hpos
  generalize partialDeriv a φ y₀ • e a = v at hφv hKv
  have hvn : 0 < ‖v‖ := by
    rw [norm_pos_iff]
    rintro rfl
    simp at hφv
  
  obtain ⟨r₁, hr₁, hr₁U, H₁⟩ := dirpos φ hφ v hφv
  obtain ⟨r₂, hr₂, -, H₂⟩ := dirpos K hK v hKv
  obtain ⟨R, hRdef⟩ : ∃ R, R = min r₁ r₂ := ⟨_, rfl⟩
  have hR0 : 0 < R := hRdef ▸ lt_min hr₁ hr₂
  have hRr₁ : R ≤ r₁ := hRdef ▸ min_le_left _ _
  have hRr₂ : R ≤ r₂ := hRdef ▸ min_le_right _ _
  have HR1 : ∀ y ∈ Metric.ball y₀ R, DifferentiableAt ℝ φ y ∧ 0 < fderiv ℝ φ y v :=
    fun y hy => H₁ y (Metric.ball_subset_ball hRr₁ hy)
  have HR2 : ∀ y ∈ Metric.ball y₀ R, DifferentiableAt ℝ K y ∧ 0 < fderiv ℝ K y v :=
    fun y hy => H₂ y (Metric.ball_subset_ball hRr₂ hy)
  have hRU : Metric.ball y₀ R ⊆ U := (Metric.ball_subset_ball hRr₁).trans hr₁U
  
  obtain ⟨δ, hδdef⟩ : ∃ δ, δ = R / (2 * ‖v‖) := ⟨_, rfl⟩
  have hδ0 : 0 < δ := hδdef ▸ div_pos hR0 (by positivity)
  have hδv : δ * ‖v‖ = R / 2 := by
    rw [hδdef]
    field_simp
  have hy₁ : y₀ + δ • v ∈ Metric.ball y₀ R := by
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul,
      Real.norm_of_nonneg hδ0.le, hδv]
    linarith
  have hφy₁ : 0 < φ (y₀ + δ • v) := by
    have := linelt φ v R HR1 y₀ (Metric.mem_ball_self hR0) δ hδ0 hy₁
    rwa [hφ0] at this
  have hcy₁ : ContinuousAt φ (y₀ + δ • v) :=
    hφ.continuousOn.continuousAt (hU.mem_nhds (hRU hy₁))
  obtain ⟨η, hη, hηball⟩ :=
    Metric.eventually_nhds_iff_ball.mp (continuousAt_const.eventually_lt hcy₁ hφy₁)
  
  refine ⟨min η (R / 2), lt_min hη (by linarith), ?_, ?_⟩
  · exact (Metric.ball_subset_ball ((min_le_right _ _).trans (by linarith))).trans hRU
  · intro z hz hφz
    have hzd : ‖z - y₀‖ < min η (R / 2) := by rwa [Metric.mem_ball, dist_eq_norm] at hz
    have hzη : ‖z - y₀‖ < η := lt_of_lt_of_le hzd (min_le_left _ _)
    have hzR2 : ‖z - y₀‖ < R / 2 := lt_of_lt_of_le hzd (min_le_right _ _)
    have hseg : ∀ s ∈ Set.Icc (0:ℝ) δ, z + s • v ∈ Metric.ball y₀ R := by
      intro s hs
      rw [Metric.mem_ball, dist_eq_norm]
      have e1 : z + s • v - y₀ = (z - y₀) + s • v := by abel
      rw [e1]
      have h2 : ‖s • v‖ ≤ δ * ‖v‖ := by
        rw [norm_smul, Real.norm_of_nonneg hs.1]
        exact mul_le_mul_of_nonneg_right hs.2 (norm_nonneg _)
      calc ‖(z - y₀) + s • v‖ ≤ ‖z - y₀‖ + ‖s • v‖ := norm_add_le _ _
        _ < R := by linarith
    have hend : 0 < φ (z + δ • v) := by
      have hmem : z + δ • v ∈ Metric.ball (y₀ + δ • v) η := by
        rw [Metric.mem_ball, dist_eq_norm]
        have e2 : z + δ • v - (y₀ + δ • v) = z - y₀ := by abel
        rw [e2]
        exact hzη
      exact hηball _ hmem
    obtain ⟨s, hs, hs0⟩ := segzero z v δ hδ0.le (fun s hs => hRU (hseg s hs)) hφz hend
    have hKs : K (z + s • v) = 0 := hzero _ (hRU (hseg s hs)) hs0
    rcases eq_or_lt_of_le hs.1 with h | h
    · rw [← h, zero_smul, add_zero] at hKs
      exact hKs.le
    · have hzR : z ∈ Metric.ball y₀ R := by
        rw [Metric.mem_ball, dist_eq_norm]
        linarith
      have := linelt K v R HR2 z hzR s h (hseg s hs)
      linarith

theorem wall_subcalibration (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i)
    (hpd : ∀ y ∈ U, (G y).PosDef) (y₀ : E3) (hy₀ : y₀ ∈ U) (w : E3 → ℝ)
    (hw : ContDiffOn ℝ ∞ w U) (hw0 : w y₀ = 0) (hdw : fderiv ℝ w y₀ ≠ 0)
    (hMSE : ∀ z ∈ U, w z = 0 → levelMeanCurvCoord G w z = 0) :
    ∃ (ε : ℝ) (φ : Bool → E3 → ℝ), 0 < ε ∧ Metric.ball y₀ ε ⊆ U ∧
      ∀ b : Bool, ContDiffOn ℝ ∞ (φ b) (Metric.ball y₀ ε) ∧
        (∀ z ∈ Metric.ball y₀ ε, fderiv ℝ (φ b) z ≠ 0) ∧
        (∀ z ∈ Metric.ball y₀ ε,
          (0 < φ b z ↔ 0 < (if b then (1 : ℝ) else -1) * w z) ∧ (φ b z = 0 ↔ w z = 0)) ∧
        (∀ z ∈ Metric.ball y₀ ε, φ b z ≤ 0 → sepDensDiv G (hcrNormalField G (φ b)) z ≤ 0) :=
by
  
  have hdiff_w : ∀ z ∈ U, DifferentiableAt ℝ w z := fun z hz =>
    (hw.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)
  obtain ⟨a, ha⟩ : ∃ a : Fin 3, partialDeriv a w y₀ ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hdw
    have hlin : (fderiv ℝ w y₀ : E3 →ₗ[ℝ] ℝ) = 0 :=
      (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
        simpa [partialDeriv] using hcon i)
    refine ContinuousLinearMap.ext (fun v => ?_)
    have := LinearMap.congr_fun hlin v
    simpa using this
  have hn2 : ContDiff ℝ ∞ (fun y : E3 => ‖y - y₀‖ ^ 2) :=
    (contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)
  
  have key : ∀ τ : ℝ, τ ≠ 0 → ∃ (ε : ℝ) (φ : E3 → ℝ), 0 < ε ∧ Metric.ball y₀ ε ⊆ U ∧
      ContDiffOn ℝ ∞ φ (Metric.ball y₀ ε) ∧
      (∀ z ∈ Metric.ball y₀ ε, fderiv ℝ φ z ≠ 0) ∧
      (∀ z ∈ Metric.ball y₀ ε, (0 < φ z ↔ 0 < τ * w z) ∧ (φ z = 0 ↔ w z = 0)) ∧
      (∀ z ∈ Metric.ball y₀ ε, φ z ≤ 0 → sepDensDiv G (hcrNormalField G φ) z ≤ 0) := by
    intro τ hτ
    obtain ⟨ψ, hψdef⟩ : ∃ ψ : E3 → ℝ, ψ = fun z => τ * w z := ⟨_, rfl⟩
    have hψs : ContDiffOn ℝ ∞ ψ U := by rw [hψdef]; exact contDiffOn_const.mul hw
    have hψ0 : ψ y₀ = 0 := by rw [hψdef]; simp [hw0]
    have hψd : fderiv ℝ ψ y₀ = τ • fderiv ℝ w y₀ := by
      rw [hψdef]; exact fderiv_const_mul (hdiff_w y₀ hy₀) τ
    have hψpd : ∀ k : Fin 3, partialDeriv k ψ y₀ = τ * partialDeriv k w y₀ := by
      intro k
      unfold partialDeriv
      rw [hψd, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hψdne : fderiv ℝ ψ y₀ ≠ 0 := by rw [hψd]; exact smul_ne_zero hτ hdw
    have hξa : partialDeriv a ψ y₀ ≠ 0 := by rw [hψpd]; exact mul_ne_zero hτ ha
    have hξ : (fun k : Fin 3 => partialDeriv k ψ y₀) ≠ 0 := by
      intro h; exact hξa (congrFun h a)
    obtain ⟨c, hc0, hc⟩ := bump_trace_coeff (G y₀) (hpd y₀ hy₀) (hsymm y₀) _ hξ
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = partialDeriv a ψ y₀ := ⟨_, rfl⟩
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = partialDeriv a (levelMeanCurvCoord G ψ) y₀ := ⟨_, rfl⟩
    have hx0 : x ≠ 0 := by rw [hx]; exact hξa
    have hx2 : 0 < x ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hx0))
    have hden : 0 < 2 * c * x ^ 2 := mul_pos (mul_pos two_pos hc0) hx2
    obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = (|x * A| + 1) / (2 * c * x ^ 2) := ⟨_, rfl⟩
    have hlam : 0 < lam := by
      rw [hlamdef]; exact div_pos (by positivity) hden
    have hlamc : 2 * lam * c * x ^ 2 = |x * A| + 1 := by
      calc 2 * lam * c * x ^ 2 = lam * (2 * c * x ^ 2) := by ring
        _ = |x * A| + 1 := by rw [hlamdef]; exact div_mul_cancel₀ _ hden.ne'
    
    obtain ⟨φ, hφdef⟩ : ∃ φ : E3 → ℝ, φ = fun z => ψ z * (1 + lam * ‖z - y₀‖ ^ 2) :=
      ⟨_, rfl⟩
    obtain ⟨hφs, hφd, hj1, hj2, hj3⟩ := bump_jets U hU y₀ hy₀ ψ hψs hψ0 lam
    rw [← hφdef] at hφs hφd hj1 hj2 hj3
    have hφdne : fderiv ℝ φ y₀ ≠ 0 := by rw [hφd]; exact hψdne
    
    have h4 := lmc_deriv_thirdJet G U hU hG hsymm hpd y₀ hy₀ ψ φ hψs hφs hψdne
      (fun j => (hj1 j).symm) (fun i j => (hj2 i j).symm) a
    have hgen : ∀ f : Fin 3 → Fin 3 → ℝ,
        (∑ i : Fin 3, ∑ j : Fin 3, f i j *
          (partialDeriv a (partialDeriv i (partialDeriv j ψ)) y₀ -
            partialDeriv a (partialDeriv i (partialDeriv j φ)) y₀)) =
        -(2 * lam) * ∑ i : Fin 3, ∑ j : Fin 3, f i j *
          ((if i = j then partialDeriv a ψ y₀ else 0) +
            (if a = j then partialDeriv i ψ y₀ else 0) +
            (if a = i then partialDeriv j ψ y₀ else 0)) := by
      intro f
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hj3 a i j]
      ring
    have h5 : partialDeriv a (levelMeanCurvCoord G ψ) y₀ -
        partialDeriv a (levelMeanCurvCoord G φ) y₀ =
        -(2 * lam) * (c * partialDeriv a ψ y₀) := by
      rw [← hc a]
      exact h4.trans (hgen _)
    have hKφ : partialDeriv a (levelMeanCurvCoord G φ) y₀ =
        partialDeriv a (levelMeanCurvCoord G ψ) y₀ + 2 * lam * c * partialDeriv a ψ y₀ := by
      linear_combination -h5
    have hpos : 0 < partialDeriv a φ y₀ * partialDeriv a (levelMeanCurvCoord G φ) y₀ := by
      rw [hj1 a, hKφ, ← hx, ← hA]
      have e1 : x * (A + 2 * lam * c * x) = x * A + 2 * lam * c * x ^ 2 := by ring
      rw [e1, hlamc]
      linarith [neg_abs_le (x * A)]
    
    have hφdc : ContinuousOn (fun z => fderiv ℝ φ z) U :=
      hφs.continuousOn_fderiv_of_isOpen hU (by simp)
    have hwdc : ContinuousOn (fun z => fderiv ℝ w z) U :=
      hw.continuousOn_fderiv_of_isOpen hU (by simp)
    have hVo : IsOpen ((U ∩ (fun z => fderiv ℝ w z) ⁻¹' {0}ᶜ) ∩
        (U ∩ (fun z => fderiv ℝ φ z) ⁻¹' {0}ᶜ)) :=
      (hwdc.isOpen_inter_preimage hU isClosed_singleton.isOpen_compl).inter
        (hφdc.isOpen_inter_preimage hU isClosed_singleton.isOpen_compl)
    have hy₀V : y₀ ∈ (U ∩ (fun z => fderiv ℝ w z) ⁻¹' {0}ᶜ) ∩
        (U ∩ (fun z => fderiv ℝ φ z) ⁻¹' {0}ᶜ) :=
      ⟨⟨hy₀, hdw⟩, ⟨hy₀, hφdne⟩⟩
    obtain ⟨ρ₀, hρ₀, hρ₀V⟩ := Metric.isOpen_iff.mp hVo y₀ hy₀V
    have hU'U : Metric.ball y₀ ρ₀ ⊆ U := fun z hz => (hρ₀V hz).1.1
    have hU'w : ∀ z ∈ Metric.ball y₀ ρ₀, fderiv ℝ w z ≠ 0 := fun z hz => (hρ₀V hz).1.2
    have hU'φ : ∀ z ∈ Metric.ball y₀ ρ₀, fderiv ℝ φ z ≠ 0 := fun z hz => (hρ₀V hz).2.2
    have hφs' : ContDiffOn ℝ ∞ φ (Metric.ball y₀ ρ₀) := hφs.mono hU'U
    have hGb : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball y₀ ρ₀) :=
      fun i j => (hG i j).mono hU'U
    have hpdb : ∀ y ∈ Metric.ball y₀ ρ₀, (G y).PosDef := fun y hy => hpd y (hU'U hy)
    have hK : ContDiffOn ℝ ∞ (levelMeanCurvCoord G φ) (Metric.ball y₀ ρ₀) :=
      lmc_contDiffOn G (Metric.ball y₀ ρ₀) Metric.isOpen_ball hGb hsymm hpdb φ hφs' hU'φ
    
    have hm : ∀ z : E3, 0 < 1 + lam * ‖z - y₀‖ ^ 2 := fun z =>
      add_pos_of_pos_of_nonneg one_pos (mul_nonneg hlam.le (sq_nonneg _))
    have hφeq : ∀ z, φ z = τ * w z * (1 + lam * ‖z - y₀‖ ^ 2) := by
      intro z; rw [hφdef, hψdef]
    obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun y => τ * (1 + lam * ‖y - y₀‖ ^ 2) := ⟨_, rfl⟩
    have hφwh : φ = fun y => w y * h y := by
      funext y; rw [hφeq, hhdef]; ring
    have hhs : ContDiffOn ℝ ∞ h U := by
      rw [hhdef]
      exact (contDiff_const.mul (contDiff_const.add (contDiff_const.mul hn2))).contDiffOn
    have hwz_of : ∀ z, φ z = 0 → w z = 0 := by
      intro z hφz
      rw [hφeq] at hφz
      rcases mul_eq_zero.1 hφz with h1 | h1
      · exact (mul_eq_zero.1 h1).resolve_left hτ
      · exact absurd h1 (hm z).ne'
    have hzero : ∀ z ∈ Metric.ball y₀ ρ₀, φ z = 0 → levelMeanCurvCoord G φ z = 0 := by
      intro z hz hφz
      have hwz : w z = 0 := hwz_of z hφz
      have hhz : h z ≠ 0 := by rw [hhdef]; exact mul_ne_zero hτ (hm z).ne'
      have h2 := lmc_mul_zero G U hU hsymm w h hw hhs z (hU'U hz) (hpd z (hU'U hz)) hwz
        (hU'w z hz) hhz
      rw [← hφwh, hMSE z (hU'U hz) hwz, mul_zero] at h2
      exact (mul_eq_zero.1 h2).resolve_right (abs_ne_zero.2 hhz)
    
    have hφ0 : φ y₀ = 0 := by rw [hφeq, hw0]; ring
    obtain ⟨ε, hε, hεU', hsign⟩ := sign_transfer_axis (Metric.ball y₀ ρ₀) Metric.isOpen_ball y₀
      (Metric.mem_ball_self hρ₀) φ (levelMeanCurvCoord G φ) a (hφs'.of_le (by simp))
      (hK.of_le (by simp)) hφ0 hzero hpos
    refine ⟨ε, φ, hε, hεU'.trans hU'U, hφs'.mono hεU', fun z hz => hU'φ z (hεU' hz),
      fun z _ => ?_, fun z hz hφz => ?_⟩
    · constructor
      · rw [hφeq]; exact mul_pos_iff_of_pos_right (hm z)
      · constructor
        · exact hwz_of z
        · intro h0; rw [hφeq, h0]; ring
    · rw [hcr_densDiv_eq_lmc G (Metric.ball y₀ ρ₀) Metric.isOpen_ball hGb hsymm hpdb φ hφs'
        hU'φ z (hεU' hz)]
      exact mul_nonpos_of_nonneg_of_nonpos (Real.sqrt_nonneg _) (hsign z hz hφz)
  
  have key' : ∀ b : Bool, ∃ (ε : ℝ) (φ : E3 → ℝ), 0 < ε ∧ Metric.ball y₀ ε ⊆ U ∧
      ContDiffOn ℝ ∞ φ (Metric.ball y₀ ε) ∧
      (∀ z ∈ Metric.ball y₀ ε, fderiv ℝ φ z ≠ 0) ∧
      (∀ z ∈ Metric.ball y₀ ε,
        (0 < φ z ↔ 0 < (if b then (1 : ℝ) else -1) * w z) ∧ (φ z = 0 ↔ w z = 0)) ∧
      (∀ z ∈ Metric.ball y₀ ε, φ z ≤ 0 → sepDensDiv G (hcrNormalField G φ) z ≤ 0) :=
    fun b => key _ (by cases b <;> norm_num)
  choose ε φ hφ using key'
  refine ⟨min (ε true) (ε false), φ, lt_min (hφ true).1 (hφ false).1,
    (Metric.ball_subset_ball (min_le_left _ _)).trans (hφ true).2.1, fun b => ?_⟩
  have hsub : Metric.ball y₀ (min (ε true) (ε false)) ⊆ Metric.ball y₀ (ε b) := by
    cases b
    · exact Metric.ball_subset_ball (min_le_right _ _)
    · exact Metric.ball_subset_ball (min_le_left _ _)
  obtain ⟨-, -, h1, h2, h3, h4⟩ := hφ b
  exact ⟨h1.mono hsub, fun z hz => h2 z (hsub hz), fun z hz => h3 z (hsub hz),
    fun z hz => h4 z (hsub hz)⟩

theorem sfr_normal_unit (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W₀ : Set E3)
    (hpd : ∀ y ∈ W₀, (G y).PosDef) (φ : E3 → ℝ) (hdφ : ∀ z ∈ W₀, fderiv ℝ φ z ≠ 0) :
    ∀ y ∈ W₀,
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a φ y * partialDeriv b φ y ∧
      ∑ a : Fin 3, ∑ b : Fin 3,
        G y a b * hcrNormalField G φ y a * hcrNormalField G φ y b = 1 :=
by
  intro y hy
  have hA : (G y).PosDef := hpd y hy
  have quad : ∀ (B : Matrix (Fin 3) (Fin 3) ℝ) (x : Fin 3 → ℝ),
      ∑ a : Fin 3, ∑ b : Fin 3, B a b * x a * x b = dotProduct x (B.mulVec x) := by
    intro B x
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => by ring))
  set ξ : Fin 3 → ℝ := fun a => partialDeriv a φ y with hξdef
  have hξne : ξ ≠ 0 := by
    intro h0
    apply hdφ y hy
    have hL : ∀ a : Fin 3, fderiv ℝ φ y (e a) = 0 := fun a => congrFun h0 a
    apply ContinuousLinearMap.coe_injective
    refine (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => ?_)
    simp only [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply,
      ContinuousLinearMap.coe_coe, ContinuousLinearMap.zero_apply]
    exact hL i
  set s : ℝ := ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a φ y * partialDeriv b φ y
    with hsdef
  have hs_eq : s = dotProduct ξ ((G y)⁻¹.mulVec ξ) := quad (G y)⁻¹ ξ
  have hs : 0 < s := by
    rw [hs_eq]
    have h := hA.inv.dotProduct_mulVec_pos hξne
    simpa using h
  refine ⟨hs, ?_⟩
  set w : Fin 3 → ℝ := (G y)⁻¹.mulVec ξ with hwdef
  have hN : ∀ a : Fin 3, hcrNormalField G φ y a = (Real.sqrt s)⁻¹ * w a := by
    intro a
    rfl
  have hdet : IsUnit (G y).det := isUnit_iff_ne_zero.mpr (ne_of_gt hA.det_pos)
  have hAw : (G y).mulVec w = ξ := by
    rw [hwdef, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hdet, Matrix.one_mulVec]
  have hQw : dotProduct w ((G y).mulVec w) = s := by
    rw [hAw, dotProduct_comm, hs_eq]
  have hsum : ∑ a : Fin 3, ∑ b : Fin 3,
      G y a b * hcrNormalField G φ y a * hcrNormalField G φ y b =
      ((Real.sqrt s)⁻¹) ^ 2 * dotProduct w ((G y).mulVec w) := by
    rw [← quad, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    rw [hN a, hN b]
    ring
  rw [hsum, hQw, inv_pow, Real.sq_sqrt hs.le, inv_mul_cancel₀ hs.ne']

theorem sfr_wall_field_regular (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W₀ : Set E3)
    (hW₀ : IsOpen W₀) (hpd : ∀ y ∈ W₀, (G y).PosDef) (φ : E3 → ℝ) (hφ : ContDiffOn ℝ ∞ φ W₀)
    (hN : ContDiffOn ℝ ∞ (hcrNormalField G φ) W₀)
    (hN1 : ∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3,
      G y a b * hcrNormalField G φ y a * hcrNormalField G φ y b ≤ 1)
    (χ : E3 → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχ0 : ∀ y, 0 ≤ χ y) (hχ1 : ∀ y, χ y ≤ 1)
    (T : Set E3) (hχT : ∀ y, y ∉ T → χ y = 0)
    (S : Set E3) (hSW : S ⊆ W₀)
    (Y : E3 → E3) (hYs : ∀ z ∈ S, 0 < φ z → ContDiffAt ℝ ∞ Y z)
    (hYT : ∀ y, y ∉ T → Y y = 0)
    (hYn : ∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3, G y a b * Y y a * Y y b ≤ χ y ^ 2)
    (τ : ℝ) (hτ : 0 < τ) :
    (∀ z ∈ S, ContDiffAt ℝ ∞ (sfrWall G φ χ τ Y) z) ∧
    (∀ y, y ∉ T → sfrWall G φ χ τ Y y = 0) ∧
    (∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3,
      G y a b * sfrWall G φ χ τ Y y a * sfrWall G φ χ τ Y y b ≤ χ y ^ 2) :=
by
  have hθ01 : ∀ y, 0 ≤ sfrTheta φ τ y ∧ sfrTheta φ τ y ≤ 1 := fun y =>
    ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hcoord : ∀ (y : E3) (a : Fin 3), sfrWall G φ χ τ Y y a =
      sfrTheta φ τ y * Y y a - ((1 - sfrTheta φ τ y) * χ y) * hcrNormalField G φ y a := by
    intro y a
    simp only [sfrWall, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
  refine ⟨?_, ?_, ?_⟩
  · intro z hz
    have hzW : W₀ ∈ 𝓝 z := hW₀.mem_nhds (hSW hz)
    have hφz : ContDiffAt ℝ ∞ φ z := hφ.contDiffAt hzW
    have hNz : ContDiffAt ℝ ∞ (hcrNormalField G φ) z := hN.contDiffAt hzW
    have hχz : ContDiffAt ℝ ∞ χ z := hχ.contDiffAt
    have hθz : ContDiffAt ℝ ∞ (fun y => sfrTheta φ τ y) z := by
      have h1 : ContDiffAt ℝ ∞ (fun y => 2 * (φ y / τ) - 1) z :=
        (contDiffAt_const.mul (hφz.div_const τ)).sub contDiffAt_const
      exact Real.smoothTransition.contDiff.comp_contDiffAt z h1
    rcases lt_or_ge 0 (φ z) with hpos | hneg
    · have hYz : ContDiffAt ℝ ∞ Y z := hYs z hz hpos
      exact (hθz.smul hYz).sub (((contDiffAt_const.sub hθz).mul hχz).smul hNz)
    · have hev : ∀ᶠ y in 𝓝 z, φ y < τ / 2 :=
        hφz.continuousAt.eventually_lt continuousAt_const (by linarith)
      have heq : sfrWall G φ χ τ Y =ᶠ[𝓝 z] fun y => -(χ y • hcrNormalField G φ y) := by
        filter_upwards [hev] with y hy
        have h0 : sfrTheta φ τ y = 0 := by
          unfold sfrTheta
          apply Real.smoothTransition.zero_of_nonpos
          have : φ y / τ < 1 / 2 := by rw [div_lt_iff₀ hτ]; linarith
          linarith
        simp only [sfrWall, h0, zero_smul, sub_zero, one_mul, zero_sub]
      exact (hχz.smul hNz).neg.congr_of_eventuallyEq heq
  · intro y hy
    simp [sfrWall, hYT y hy, hχT y hy]
  · intro y hy
    simp only [hcoord]
    obtain ⟨ht0, ht1⟩ := hθ01 y
    have hu := hYn y hy
    have hn := hN1 y hy
    have hd : 0 ≤ ∑ a : Fin 3, ∑ b : Fin 3, G y a b *
        (Y y a + χ y * hcrNormalField G φ y a) * (Y y b + χ y * hcrNormalField G φ y b) := by
      have h := (hpd y hy).posSemidef.dotProduct_mulVec_nonneg
        (fun a => Y y a + χ y * hcrNormalField G φ y a)
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three] at h ⊢
      linarith
    have h1 := mul_nonneg ht0 (sub_nonneg.2 hu)
    have h2 := mul_nonneg (mul_nonneg (sub_nonneg.2 ht1) (sq_nonneg (χ y))) (sub_nonneg.2 hn)
    have h3 := mul_nonneg (mul_nonneg ht0 (sub_nonneg.2 ht1)) hd
    simp only [Fin.sum_univ_three] at h1 h2 h3 ⊢
    linarith

theorem sfr_wall_field_div (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W₀ : Set E3) (hW₀ : IsOpen W₀)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) W₀)
    (hpd : ∀ y ∈ W₀, (G y).PosDef) (φ : E3 → ℝ) (hφ : ContDiffOn ℝ ∞ φ W₀)
    (hN : ContDiffOn ℝ ∞ (hcrNormalField G φ) W₀)
    (hNcs : ∀ y ∈ W₀, ∀ w : E3, ∑ a : Fin 3, ∑ b : Fin 3, G y a b * w a * w b ≤ 1 →
      |fderiv ℝ φ y w| ≤ fderiv ℝ φ y (hcrNormalField G φ y))
    (χ : E3 → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχ0 : ∀ y, 0 ≤ χ y) (hχ1 : ∀ y, χ y ≤ 1)
    (T : Set E3) (hT : IsCompact T) (hTW : T ⊆ W₀) (hχT : ∀ y, y ∉ T → χ y = 0)
    (S : Set E3) (hSW : S ⊆ W₀)
    (Y : E3 → E3) (hYs : ∀ z ∈ S, 0 < φ z → ContDiffAt ℝ ∞ Y z)
    (hYn : ∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3, G y a b * Y y a * Y y b ≤ χ y ^ 2)
    (hYd : ∃ C : ℝ, ∀ z ∈ S, 0 < φ z → |sepDensDiv G Y z| ≤ C) :
    (∃ C : ℝ, ∀ z, |sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z| ≤ C) ∧
    (∀ z, z ∉ T → sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z = 0) ∧
    ∀ τ : ℝ, 0 < τ →
      (∃ C : ℝ, ∀ z ∈ S, |sepDensDiv G (sfrWall G φ χ τ Y) z| ≤ C) ∧
      (∀ z ∈ S, 0 < φ z →
        sfrTheta φ τ z * sepDensDiv G Y z -
            (1 - sfrTheta φ τ z) * sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z ≤
          sepDensDiv G (sfrWall G φ χ τ Y) z) ∧
      (∀ z ∈ S, φ z ≤ 0 → (∀ᶠ y in 𝓝 z, χ y = 1) →
        sepDensDiv G (sfrWall G φ χ τ Y) z = -sepDensDiv G (hcrNormalField G φ) z) :=
by
  classical
  
  have hρ : ∀ y ∈ W₀, ContDiffAt ℝ ∞ (fun y => Real.sqrt (G y).det) y := by
    intro y hy
    have hGa : ∀ i j : Fin 3, ContDiffAt ℝ ∞ (fun y => G y i j) y :=
      fun i j => (hG i j).contDiffAt (hW₀.mem_nhds hy)
    have hdet : ContDiffAt ℝ ∞ (fun y => (G y).det) y := by
      have e1 : (fun y => (G y).det) = fun y =>
          G y 0 0 * G y 1 1 * G y 2 2 - G y 0 0 * G y 1 2 * G y 2 1
            - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
            + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three _
      rw [e1]
      have h00 := hGa 0 0
      have h01 := hGa 0 1
      have h02 := hGa 0 2
      have h10 := hGa 1 0
      have h11 := hGa 1 1
      have h12 := hGa 1 2
      have h20 := hGa 2 0
      have h21 := hGa 2 1
      have h22 := hGa 2 2
      exact ((((((h00.mul h11).mul h22).sub ((h00.mul h12).mul h21)).sub
        ((h01.mul h10).mul h22)).add ((h01.mul h12).mul h20)).add
        ((h02.mul h10).mul h21)).sub ((h02.mul h11).mul h20)
    exact hdet.sqrt (hpd y hy).det_pos.ne'
  have hproj : ∀ (V : E3 → E3) (y : E3) (i : Fin 3), ContDiffAt ℝ ∞ V y →
      ContDiffAt ℝ ∞ (fun z => V z i) y := by
    intro V y i h
    exact (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.contDiffAt.comp y h
  
  have hb : ∀ i : Fin 3,
      ContDiff ℝ ∞ (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) := by
    intro i
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ W₀
    · have hNi : ContDiffAt ℝ ∞ (fun z => hcrNormalField G φ z i) y :=
        hproj _ y i (hN.contDiffAt (hW₀.mem_nhds hy))
      have e1 : (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) =
          fun y => Real.sqrt (G y).det * (χ y * hcrNormalField G φ y i) := by
        funext y; simp only [PiLp.smul_apply, smul_eq_mul]
      rw [e1]
      exact (hρ y hy).mul (hχ.contDiffAt.mul hNi)
    · have hyT : y ∉ T := fun h => hy (hTW h)
      have hev : (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) =ᶠ[𝓝 y]
          fun _ => (0 : ℝ) := by
        filter_upwards [hT.isClosed.isOpen_compl.mem_nhds hyT] with x hx
        simp [hχT x hx]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hpdb : ∀ (f : E3 → ℝ) (C : ℝ) (y : E3) (i : Fin 3), ‖fderiv ℝ f y‖ ≤ C →
      |partialDeriv i f y| ≤ C := by
    intro f C y i h
    have h1 : ‖fderiv ℝ f y (e i)‖ ≤ ‖fderiv ℝ f y‖ * ‖e i‖ := ContinuousLinearMap.le_opNorm _ _
    have h2 : ‖e i‖ = 1 := by simp [e, EuclideanSpace.norm_single]
    rw [h2, mul_one, Real.norm_eq_abs] at h1
    exact h1.trans h
  have hbB : ∀ i : Fin 3, ∃ C : ℝ, ∀ y,
      ‖fderiv ℝ (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) y‖ ≤ C := by
    intro i
    have hcs : HasCompactSupport
        (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) :=
      HasCompactSupport.intro hT (fun y hy => by simp [hχT y hy])
    exact (hcs.fderiv ℝ).exists_bound_of_continuous ((hb i).continuous_fderiv (by simp))
  obtain ⟨C0, hC0⟩ := hbB 0
  obtain ⟨C1, hC1⟩ := hbB 1
  obtain ⟨C2, hC2⟩ := hbB 2
  have hdivB : ∀ z, |sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z| ≤ C0 + C1 + C2 := by
    intro z
    simp only [sepDensDiv]
    rw [Fin.sum_univ_three]
    have a0 := hpdb _ _ z 0 (hC0 z)
    have a1 := hpdb _ _ z 1 (hC1 z)
    have a2 := hpdb _ _ z 2 (hC2 z)
    exact (abs_add_three _ _ _).trans (by linarith)
  have hzero : ∀ z, z ∉ T → sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z = 0 := by
    intro z hz
    simp only [sepDensDiv, partialDeriv]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev : (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) =ᶠ[𝓝 z]
        fun _ => (0 : ℝ) := by
      filter_upwards [hT.isClosed.isOpen_compl.mem_nhds hz] with x hx
      simp [hχT x hx]
    rw [hev.fderiv_eq]
    simp
  have hBN : ∀ z, (∀ᶠ y in 𝓝 z, χ y = 1) →
      sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z = sepDensDiv G (hcrNormalField G φ) z := by
    intro z hz
    simp only [sepDensDiv, partialDeriv]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hev : (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) =ᶠ[𝓝 z]
        (fun y => Real.sqrt (G y).det * hcrNormalField G φ y i) := by
      filter_upwards [hz] with y hy
      simp [hy]
    rw [hev.fderiv_eq]
  
  have hQs : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (t : ℝ) (u : E3),
      ∑ a : Fin 3, ∑ b : Fin 3, A a b * (t • u) a * (t • u) b =
        t ^ 2 * ∑ a : Fin 3, ∑ b : Fin 3, A a b * u a * u b := by
    intro A t u
    simp only [PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hN0 : ∀ y ∈ W₀, 0 ≤ fderiv ℝ φ y (hcrNormalField G φ y) := by
    intro y hy
    have h := hNcs y hy 0 (by simp)
    simpa using h
  have hcs : ∀ y ∈ W₀, ∀ (u : E3) (c : ℝ), 0 ≤ c →
      ∑ a : Fin 3, ∑ b : Fin 3, G y a b * u a * u b ≤ c ^ 2 →
      |fderiv ℝ φ y u| ≤ c * fderiv ℝ φ y (hcrNormalField G φ y) := by
    intro y hy u c hc hu
    rcases hc.lt_or_eq with hc | hc
    · have hw := hNcs y hy (c⁻¹ • u) (by
        rw [hQs]
        calc c⁻¹ ^ 2 * _ ≤ c⁻¹ ^ 2 * c ^ 2 := mul_le_mul_of_nonneg_left hu (by positivity)
          _ = 1 := by field_simp)
      rw [map_smul, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.2 hc)] at hw
      have h2 := mul_le_mul_of_nonneg_left hw hc.le
      rwa [← mul_assoc, mul_inv_cancel₀ hc.ne', one_mul] at h2
    · rw [← hc] at hu ⊢
      rw [zero_mul]
      by_contra hpos
      push_neg at hpos
      have hu' : ∑ a : Fin 3, ∑ b : Fin 3, G y a b * u a * u b ≤ 0 := by simpa using hu
      have ht : 0 < (|fderiv ℝ φ y (hcrNormalField G φ y)| + 1) / |fderiv ℝ φ y u| := by
        positivity
      have hw := hNcs y hy
        (((|fderiv ℝ φ y (hcrNormalField G φ y)| + 1) / |fderiv ℝ φ y u|) • u) (by
          rw [hQs]
          nlinarith [sq_nonneg ((|fderiv ℝ φ y (hcrNormalField G φ y)| + 1) /
            |fderiv ℝ φ y u|)])
      rw [map_smul, smul_eq_mul, abs_mul, abs_of_pos ht, div_mul_cancel₀ _ hpos.ne'] at hw
      linarith [le_abs_self (fderiv ℝ φ y (hcrNormalField G φ y))]
  
  have hρc : ContinuousOn (fun y => Real.sqrt (G y).det) W₀ :=
    fun y hy => (hρ y hy).continuousAt.continuousWithinAt
  have hFc : ContinuousOn
      (fun y => Real.sqrt (G y).det * fderiv ℝ φ y (hcrNormalField G φ y)) W₀ :=
    hρc.mul ((hφ.continuousOn_fderiv_of_isOpen hW₀ (by simp)).clm_apply hN.continuousOn)
  obtain ⟨M, hM⟩ := hT.exists_bound_of_continuousOn (hFc.mono hTW)
  
  have hs'0 : ∀ x, 0 ≤ deriv Real.smoothTransition x :=
    fun x => Real.smoothTransition.monotone.deriv_nonneg
  obtain ⟨H, hH0, hH⟩ : ∃ H : ℝ, 0 ≤ H ∧ ∀ x, deriv Real.smoothTransition x ≤ H := by
    have hc : Continuous (deriv Real.smoothTransition) :=
      (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
    obtain ⟨H₀, hH₀⟩ :=
      (isCompact_Icc (a := (-1 : ℝ)) (b := 2)).exists_bound_of_continuousOn hc.continuousOn
    refine ⟨max H₀ 0, le_max_right _ _, fun x => ?_⟩
    by_cases hx : x ∈ Set.Icc (-1 : ℝ) 2
    · have h1 := hH₀ x hx
      rw [Real.norm_eq_abs] at h1
      exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
    · have h0 : deriv Real.smoothTransition x = 0 := by
        rw [Set.mem_Icc, not_and_or] at hx
        rcases hx with h | h
        · push_neg at h
          have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
            filter_upwards [Iio_mem_nhds (show x < 0 by linarith)] with t ht
            exact Real.smoothTransition.zero_of_nonpos (le_of_lt ht)
          rw [hev.deriv_eq]
          simp
        · push_neg at h
          have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (1 : ℝ) := by
            filter_upwards [Ioi_mem_nhds (show (1 : ℝ) < x by linarith)] with t ht
            exact Real.smoothTransition.one_of_one_le (le_of_lt ht)
          rw [hev.deriv_eq]
          simp
      rw [h0]
      exact le_max_right _ _
  refine ⟨⟨C0 + C1 + C2, hdivB⟩, hzero, fun τ hτ => ?_⟩
  
  have hbeyond : ∀ z ∈ W₀, φ z ≤ 0 →
      sepDensDiv G (sfrWall G φ χ τ Y) z =
        -sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z := by
    intro z hz hφz
    have hφc : ContinuousAt φ z := hφ.continuousOn.continuousAt (hW₀.mem_nhds hz)
    have hlt : ∀ᶠ y in 𝓝 z, φ y < τ / 2 :=
      hφc.eventually_lt continuousAt_const (by linarith)
    simp only [sepDensDiv, partialDeriv]
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hev : (fun y => Real.sqrt (G y).det * sfrWall G φ χ τ Y y i) =ᶠ[𝓝 z]
        -(fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) := by
      filter_upwards [hlt] with y hy
      have h0 : sfrTheta φ τ y = 0 := by
        unfold sfrTheta
        apply Real.smoothTransition.zero_of_nonpos
        have h1 : φ y / τ < 1 / 2 := by rw [div_lt_iff₀ hτ]; linarith
        linarith
      simp [sfrWall, h0]
    rw [hev.fderiv_eq, fderiv_neg, ContinuousLinearMap.neg_apply]
  
  have hformula : ∀ z ∈ W₀, ContDiffAt ℝ ∞ Y z →
      sepDensDiv G (sfrWall G φ χ τ Y) z =
        sfrTheta φ τ z * sepDensDiv G Y z
          - (1 - sfrTheta φ τ z) * sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z
          + Real.sqrt (G z).det *
              (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
              (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z)) := by
    intro z hz hYz
    have hφd : DifferentiableAt ℝ φ z :=
      (hφ.contDiffAt (hW₀.mem_nhds hz)).differentiableAt (by simp)
    have hψ : HasFDerivAt (fun y => 2 * (φ y * τ⁻¹) - 1) ((2 : ℝ) • (τ⁻¹ • fderiv ℝ φ z)) z :=
      ((hφd.hasFDerivAt.mul_const τ⁻¹).const_mul 2).sub_const 1
    have hθeq : sfrTheta φ τ = Real.smoothTransition ∘ (fun y => 2 * (φ y * τ⁻¹) - 1) := by
      funext y
      simp [sfrTheta, div_eq_mul_inv]
    have hθ : HasFDerivAt (sfrTheta φ τ)
        (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) • ((2 : ℝ) • (τ⁻¹ • fderiv ℝ φ z))) z := by
      rw [hθeq]
      exact (((Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num))
        _).hasDerivAt.comp_hasFDerivAt z hψ
    have hd : ∀ v : E3, fderiv ℝ (sfrTheta φ τ) z v =
        deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * (τ⁻¹ * fderiv ℝ φ z v)) := by
      intro v
      rw [hθ.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hdecomp : ∀ i : Fin 3, (fun y => Real.sqrt (G y).det * sfrWall G φ χ τ Y y i) =
        fun y => sfrTheta φ τ y * (Real.sqrt (G y).det * Y y i) +
          (sfrTheta φ τ y - 1) * (Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) := by
      intro i
      funext y
      simp only [sfrWall, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    have hpart : ∀ i : Fin 3,
        partialDeriv i (fun y => Real.sqrt (G y).det * sfrWall G φ χ τ Y y i) z =
          sfrTheta φ τ z * partialDeriv i (fun y => Real.sqrt (G y).det * Y y i) z
            + (Real.sqrt (G z).det * Y z i) * fderiv ℝ (sfrTheta φ τ) z (e i)
            + ((sfrTheta φ τ z - 1) *
                partialDeriv i (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) z
              + (Real.sqrt (G z).det * (χ z • hcrNormalField G φ z) i) *
                  fderiv ℝ (sfrTheta φ τ) z (e i)) := by
      intro i
      have hYi : HasFDerivAt (fun y => Real.sqrt (G y).det * Y y i)
          (fderiv ℝ (fun y => Real.sqrt (G y).det * Y y i) z) z :=
        ((hρ z hz).differentiableAt (by simp)).mul
          ((hproj Y z i hYz).differentiableAt (by simp)) |>.hasFDerivAt
      have hbi : HasFDerivAt (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i)
          (fderiv ℝ (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) z) z :=
        ((hb i).differentiable (by simp) z).hasFDerivAt
      have hθ' : HasFDerivAt (sfrTheta φ τ) (fderiv ℝ (sfrTheta φ τ) z) z :=
        hθ.differentiableAt.hasFDerivAt
      have hall := (hθ'.mul hYi).add ((hθ'.sub_const 1).mul hbi)
      have key : HasFDerivAt (fun y => Real.sqrt (G y).det * sfrWall G φ χ τ Y y i)
          (sfrTheta φ τ z • fderiv ℝ (fun y => Real.sqrt (G y).det * Y y i) z
            + (Real.sqrt (G z).det * Y z i) • fderiv ℝ (sfrTheta φ τ) z
            + ((sfrTheta φ τ z - 1) •
                fderiv ℝ (fun y => Real.sqrt (G y).det * (χ y • hcrNormalField G φ y) i) z
              + (Real.sqrt (G z).det * (χ z • hcrNormalField G φ z) i) •
                  fderiv ℝ (sfrTheta φ τ) z)) z := by
        rw [hdecomp i]
        exact hall
      unfold partialDeriv
      rw [key.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hsum : ∀ v : E3, ∑ i : Fin 3, v i * fderiv ℝ (sfrTheta φ τ) z (e i) =
        fderiv ℝ (sfrTheta φ τ) z v := by
      intro v
      have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
        ext j
        fin_cases j <;> simp [e, EuclideanSpace.single_apply]
      conv_rhs => rw [hv]
      simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_three]
    have h1 := hsum (Y z)
    have h2 := hsum (χ z • hcrNormalField G φ z)
    rw [Fin.sum_univ_three] at h1 h2
    have hA := hd (Y z)
    have hB := hd (χ z • hcrNormalField G φ z)
    have hφs : fderiv ℝ φ z (χ z • hcrNormalField G φ z) =
        χ z * fderiv ℝ φ z (hcrNormalField G φ z) := by
      rw [map_smul, smul_eq_mul]
    simp only [sepDensDiv]
    rw [Fin.sum_univ_three, Fin.sum_univ_three, Fin.sum_univ_three, hpart 0, hpart 1, hpart 2]
    linear_combination (Real.sqrt (G z).det) * h1 + (Real.sqrt (G z).det) * h2
      + (Real.sqrt (G z).det) * hA + (Real.sqrt (G z).det) * hB
      + Real.sqrt (G z).det * deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹) * hφs
  
  have hextra : ∀ z ∈ W₀,
      0 ≤ Real.sqrt (G z).det *
              (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
              (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z)) ∧
      Real.sqrt (G z).det *
              (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
              (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z)) ≤
        H * (2 * τ⁻¹) * (2 * |M|) := by
    intro z hz
    have hτi : 0 < 2 * τ⁻¹ := by have := inv_pos.2 hτ; linarith
    have k1 := hs'0 (2 * (φ z * τ⁻¹) - 1)
    have k2 := hH (2 * (φ z * τ⁻¹) - 1)
    have hρ0 : 0 ≤ Real.sqrt (G z).det := Real.sqrt_nonneg _
    have hYc := hcs z hz (Y z) (χ z) (hχ0 z) (hYn z hz)
    have hab := abs_le.1 (show |fderiv ℝ φ z (Y z)| ≤ χ z * fderiv ℝ φ z (hcrNormalField G φ z)
      from hYc)
    have hβ0 : 0 ≤ fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z) := by
      linarith [hab.1]
    have hβ1 : fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z) ≤
        2 * (χ z * fderiv ℝ φ z (hcrNormalField G φ z)) := by
      linarith [hab.2]
    have hP0 : 0 ≤ Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z) :=
      mul_nonneg hρ0 (hN0 z hz)
    have hχP : χ z * (Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z)) ≤ |M| := by
      by_cases hzT : z ∈ T
      · have h1 := hM z hzT
        rw [Real.norm_eq_abs] at h1
        have h2 : Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z) ≤ |M| :=
          (le_abs_self _).trans (h1.trans (le_abs_self _))
        calc χ z * (Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z))
            ≤ Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z) :=
              mul_le_of_le_one_left hP0 (hχ1 z)
          _ ≤ |M| := h2
      · rw [hχT z hzT, zero_mul]
        exact abs_nonneg _
    have hc0 : 0 ≤ deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹) :=
      mul_nonneg k1 hτi.le
    refine ⟨mul_nonneg (mul_nonneg hρ0 hc0) hβ0, ?_⟩
    calc Real.sqrt (G z).det *
              (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
              (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z))
        = (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
            (Real.sqrt (G z).det *
              (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z))) := by ring
      _ ≤ (deriv Real.smoothTransition (2 * (φ z * τ⁻¹) - 1) * (2 * τ⁻¹)) *
            (2 * (χ z * (Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z)))) := by
          apply mul_le_mul_of_nonneg_left _ hc0
          have := mul_le_mul_of_nonneg_left hβ1 hρ0
          calc Real.sqrt (G z).det *
                (fderiv ℝ φ z (Y z) + χ z * fderiv ℝ φ z (hcrNormalField G φ z))
              ≤ Real.sqrt (G z).det * (2 * (χ z * fderiv ℝ φ z (hcrNormalField G φ z))) := this
            _ = 2 * (χ z * (Real.sqrt (G z).det * fderiv ℝ φ z (hcrNormalField G φ z))) := by
              ring
      _ ≤ H * (2 * τ⁻¹) * (2 * |M|) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_right k2 hτi.le) (by linarith)
          · have := mul_nonneg (hχ0 z) hP0
            linarith
          · exact mul_nonneg hH0 hτi.le
  obtain ⟨CY, hCY⟩ := hYd
  refine ⟨⟨|CY| + (C0 + C1 + C2) + H * (2 * τ⁻¹) * (2 * |M|), fun z hzS => ?_⟩,
    fun z hzS hφz => ?_, fun z hzS hφz hχz => ?_⟩
  · have hz := hSW hzS
    have hτi : 0 < 2 * τ⁻¹ := by have := inv_pos.2 hτ; linarith
    have hK0 : 0 ≤ H * (2 * τ⁻¹) * (2 * |M|) :=
      mul_nonneg (mul_nonneg hH0 hτi.le) (by have := abs_nonneg M; linarith)
    have hCY0 := abs_nonneg CY
    by_cases hφz : φ z ≤ 0
    · rw [hbeyond z hz hφz, abs_neg]
      have := hdivB z
      linarith
    · push_neg at hφz
      rw [hformula z hz (hYs z hzS hφz)]
      obtain ⟨e0, e1⟩ := hextra z hz
      have hθ0 : 0 ≤ sfrTheta φ τ z := Real.smoothTransition.nonneg _
      have hθ1 : sfrTheta φ τ z ≤ 1 := Real.smoothTransition.le_one _
      have hY1 : |sfrTheta φ τ z * sepDensDiv G Y z| ≤ |CY| := by
        rw [abs_mul, abs_of_nonneg hθ0]
        calc sfrTheta φ τ z * |sepDensDiv G Y z| ≤ |sepDensDiv G Y z| :=
              mul_le_of_le_one_left (abs_nonneg _) hθ1
          _ ≤ CY := hCY z hzS hφz
          _ ≤ |CY| := le_abs_self _
      have hB1 : |(1 - sfrTheta φ τ z) *
          sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z| ≤ C0 + C1 + C2 := by
        rw [abs_mul, abs_of_nonneg (by linarith)]
        calc (1 - sfrTheta φ τ z) * |sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z|
            ≤ |sepDensDiv G (fun y => χ y • hcrNormalField G φ y) z| :=
              mul_le_of_le_one_left (abs_nonneg _) (by linarith)
          _ ≤ C0 + C1 + C2 := hdivB z
      obtain ⟨y1, y2⟩ := abs_le.1 hY1
      obtain ⟨b1, b2⟩ := abs_le.1 hB1
      rw [abs_le]
      constructor <;> linarith
  · have hz := hSW hzS
    rw [hformula z hz (hYs z hzS hφz)]
    have := (hextra z hz).1
    linarith
  · have hz := hSW hzS
    rw [hbeyond z hz hφz, hBN z hχz]

theorem sfr_wall_limit (A B T : Set E3) (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hAB : A ⊆ B) (hT : IsCompact T) (φ : E3 → ℝ)
    (hφm : AEStronglyMeasurable φ (volume.restrict A)) (hφA : ∀ z ∈ A, 0 < φ z)
    (f g : E3 → ℝ) (F : ℝ → E3 → ℝ)
    (hfm : AEStronglyMeasurable f (volume.restrict A))
    (hgm : AEStronglyMeasurable g (volume.restrict A))
    (hFm : ∀ τ : ℝ, 0 < τ → AEStronglyMeasurable (F τ) (volume.restrict B))
    (C : ℝ) (hfC : ∀ z ∈ A, |f z| ≤ C) (hgC : ∀ z ∈ A, |g z| ≤ C)
    (hFC : ∀ τ : ℝ, 0 < τ → ∃ C' : ℝ, ∀ z ∈ B, |F τ z| ≤ C')
    (hfT : ∀ z ∈ A, z ∉ T → f z = 0) (hgT : ∀ z ∈ A, z ∉ T → g z = 0)
    (hFT : ∀ τ : ℝ, 0 < τ → ∀ z ∈ B, z ∉ T → F τ z = 0)
    (hpos : ∀ τ : ℝ, 0 < τ → ∀ z ∈ A,
      sfrTheta φ τ z * f z - (1 - sfrTheta φ τ z) * g z ≤ F τ z)
    (hneg : ∀ τ : ℝ, 0 < τ → ∀ z ∈ B, z ∉ A → 0 ≤ F τ z)
    (η : ℝ) (hη : 0 < η) :
    ∃ τ : ℝ, 0 < τ ∧ ∫ z in A, f z ≤ (∫ z in B, F τ z) + η :=
by
  
  have hTm : MeasurableSet T := hT.measurableSet
  have hTfin : volume T < ⊤ := hT.measure_lt_top
  have hind : ∀ (S : Set E3) (D : ℝ),
      Integrable (T.indicator (fun _ => D)) (volume.restrict S) := by
    intro S D
    refine (integrable_indicator_iff hTm).2 ?_
    exact integrableOn_const (ne_of_lt (lt_of_le_of_lt (Measure.restrict_apply_le S T) hTfin))
  
  have hINT : ∀ (S : Set E3) (u : E3 → ℝ) (D : ℝ), MeasurableSet S →
      AEStronglyMeasurable u (volume.restrict S) → (∀ z ∈ S, |u z| ≤ D) →
      (∀ z ∈ S, z ∉ T → u z = 0) → Integrable u (volume.restrict S) := by
    intro S u D hS hu hD h0
    refine Integrable.mono' (hind S |D|) hu ?_
    refine ae_restrict_of_forall_mem hS ?_
    intro z hz
    rw [Real.norm_eq_abs]
    by_cases hzT : z ∈ T
    · rw [Set.indicator_of_mem hzT]
      exact (hD z hz).trans (le_abs_self D)
    · rw [Set.indicator_of_notMem hzT, h0 z hz hzT, abs_zero]
  have hFi : ∀ τ : ℝ, 0 < τ → IntegrableOn (F τ) B := by
    intro τ hτ
    obtain ⟨C', hC'⟩ := hFC τ hτ
    exact hINT B (F τ) C' hB (hFm τ hτ) hC' (hFT τ hτ)
  
  have hθ0 : ∀ τ z, 0 ≤ sfrTheta φ τ z := fun τ z => by
    unfold sfrTheta; exact Real.smoothTransition.nonneg _
  have hθ1 : ∀ τ z, sfrTheta φ τ z ≤ 1 := fun τ z => by
    unfold sfrTheta; exact Real.smoothTransition.le_one _
  have hθm : ∀ τ : ℝ, AEStronglyMeasurable (fun z => sfrTheta φ τ z) (volume.restrict A) := by
    intro τ
    have h : AEStronglyMeasurable (fun z => 2 * (φ z / τ) - 1) (volume.restrict A) :=
      (by fun_prop : Continuous fun t : ℝ => 2 * (t / τ) - 1).comp_aestronglyMeasurable hφm
    unfold sfrTheta
    exact Real.smoothTransition.continuous.comp_aestronglyMeasurable h
  obtain ⟨τs, hτs⟩ : ∃ τs : ℕ → ℝ, τs = fun m : ℕ => 1 / ((m : ℝ) + 1) := ⟨_, rfl⟩
  have hτpos : ∀ m, 0 < τs m := fun m => by rw [hτs]; positivity
  obtain ⟨H, hH⟩ : ∃ H : ℕ → E3 → ℝ, H = fun m z =>
      sfrTheta φ (τs m) z * f z - (1 - sfrTheta φ (τs m) z) * g z := ⟨_, rfl⟩
  have hHm : ∀ m, AEStronglyMeasurable (H m) (volume.restrict A) := by
    intro m
    rw [hH]
    exact ((hθm (τs m)).mul hfm).sub ((aestronglyMeasurable_const.sub (hθm (τs m))).mul hgm)
  have hHC : ∀ m, ∀ z ∈ A, |H m z| ≤ C := by
    intro m z hz
    simp only [hH]
    have t0 := hθ0 (τs m) z
    have t1 := hθ1 (τs m) z
    have hf := abs_le.mp (hfC z hz)
    have hg := abs_le.mp (hgC z hz)
    rw [abs_le]
    constructor
    · nlinarith [mul_nonneg t0 (by linarith : (0:ℝ) ≤ C + f z),
        mul_nonneg (sub_nonneg.2 t1) (by linarith : (0:ℝ) ≤ C - g z)]
    · nlinarith [mul_nonneg t0 (by linarith : (0:ℝ) ≤ C - f z),
        mul_nonneg (sub_nonneg.2 t1) (by linarith : (0:ℝ) ≤ C + g z)]
  have hH0 : ∀ m, ∀ z ∈ A, z ∉ T → H m z = 0 := by
    intro m z hz hzT
    simp only [hH, hfT z hz hzT, hgT z hz hzT, mul_zero, sub_zero]
  have hHi : ∀ m, IntegrableOn (H m) A := fun m =>
    hINT A (H m) C hA (hHm m) (hHC m) (hH0 m)
  
  have hlim : ∀ z ∈ A, Tendsto (fun m => H m z) atTop (𝓝 (f z)) := by
    intro z hz
    have hp := hφA z hz
    obtain ⟨N, hN⟩ := exists_nat_ge (1 / φ z)
    refine tendsto_atTop_of_eventually_const (i₀ := N) ?_
    intro m hm
    have hm' : (N : ℝ) ≤ m := Nat.cast_le.2 hm
    have h1 : 1 ≤ φ z * ((m : ℝ) + 1) := by
      rw [div_le_iff₀ hp] at hN
      nlinarith [mul_le_mul_of_nonneg_right hm' hp.le]
    have h2 : 1 ≤ 2 * (φ z / τs m) - 1 := by
      rw [hτs]
      simp only
      rw [div_div_eq_mul_div, div_one]
      linarith
    have h3 : sfrTheta φ (τs m) z = 1 := by
      unfold sfrTheta
      exact Real.smoothTransition.one_of_one_le h2
    simp only [hH, h3]
    ring
  
  have hDCT : Tendsto (fun m => ∫ z in A, H m z) atTop (𝓝 (∫ z in A, f z)) := by
    refine tendsto_integral_of_dominated_convergence (T.indicator (fun _ => |C|)) hHm
      (hind A |C|) ?_ ?_
    · intro m
      refine ae_restrict_of_forall_mem hA ?_
      intro z hz
      rw [Real.norm_eq_abs]
      by_cases hzT : z ∈ T
      · rw [Set.indicator_of_mem hzT]
        exact (hHC m z hz).trans (le_abs_self C)
      · rw [Set.indicator_of_notMem hzT, hH0 m z hz hzT, abs_zero]
    · exact ae_restrict_of_forall_mem hA hlim
  
  obtain ⟨m, hm⟩ := (hDCT.eventually (lt_mem_nhds
    (show (∫ z in A, f z) - η < ∫ z in A, f z by linarith))).exists
  
  have hFiB := hFi (τs m) (hτpos m)
  have hc1 : ∫ z in A, H m z ≤ ∫ z in A, F (τs m) z := by
    refine setIntegral_mono_on (hHi m) (hFiB.mono_set hAB) hA ?_
    intro z hz
    simp only [hH]
    exact hpos (τs m) (hτpos m) z hz
  have hc2 : 0 ≤ ∫ z in B \ A, F (τs m) z :=
    setIntegral_nonneg (hB.diff hA) (fun z hz => hneg (τs m) (hτpos m) z hz.1 hz.2)
  have hc3 := integral_inter_add_diff hA hFiB
  rw [Set.inter_eq_right.2 hAB] at hc3
  exact ⟨τs m, hτpos m, by linarith⟩

theorem sector_field_removal (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (W₀ : Set E3) (hW₀ : IsOpen W₀)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) W₀)
    (hpd : ∀ y ∈ W₀, (G y).PosDef) (k : ℕ) (φ : Fin k → E3 → ℝ)
    (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) W₀) (hdφ : ∀ i, ∀ z ∈ W₀, fderiv ℝ (φ i) z ≠ 0)
    (V K' E : Set E3) (hV : IsOpen V) (hVW : V ⊆ W₀) (hK' : IsCompact K') (hK'V : K' ⊆ V)
    (hE : MeasurableSet E)
    (hEK : ∀ z ∈ E, z ∈ W₀ → (∃ i, φ i z ≤ 0) → z ∈ K')
    (hcal : ∀ i, ∀ z ∈ K', φ i z ≤ 0 → sepDensDiv G (hcrNormalField G (φ i)) z ≤ 0)
    (X : E3 → E3) (hXs : ∀ z ∈ W₀, (∀ i, 0 < φ i z) → ContDiffAt ℝ ∞ X z)
    (hXc : HasCompactSupport X) (hXV : tsupport X ⊆ V)
    (hXn : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1)
    (hXd : ∃ C : ℝ, ∀ z ∈ W₀, (∀ i, 0 < φ i z) → |sepDensDiv G X z| ≤ C) :
    ENNReal.ofReal (∫ y in E ∩ {z | z ∈ W₀ ∧ ∀ i, 0 < φ i z}, sepDensDiv G X y) ≤
      sepPerG G E V :=
by
  classical
  
  obtain ⟨T, χ, hTc, hTW, hTV, hχs, hχ0, hχ1, hχT, hXT, hχX, hχK⟩ :
      ∃ (T : Set E3) (χ : E3 → ℝ), IsCompact T ∧ T ⊆ W₀ ∧ T ⊆ V ∧ ContDiff ℝ ∞ χ ∧
        (∀ y, 0 ≤ χ y) ∧ (∀ y, χ y ≤ 1) ∧ (∀ y, y ∉ T → χ y = 0) ∧
        (∀ y, y ∉ T → X y = 0) ∧ (∀ y ∈ tsupport X, χ y = 1) ∧
        (∀ z ∈ K', ∀ᶠ y in 𝓝 z, χ y = 1) := by
    have hT₀c : IsCompact (tsupport X ∪ K') := hXc.isCompact.union hK'
    have hT₀V : tsupport X ∪ K' ⊆ V := Set.union_subset hXV hK'V
    obtain ⟨O, hO, hT₀O, hOV, hOc⟩ := exists_open_between_and_isCompact_closure hT₀c hV hT₀V
    have hT₀O' : tsupport X ∪ K' ⊆ interior O := by rw [hO.interior_eq]; exact hT₀O
    obtain ⟨f, hf1, hf0, hf01⟩ := exists_contMDiffMap_one_nhds_of_subset_interior 𝓘(ℝ, E3)
      (n := ⊤) hT₀c.isClosed hT₀O'
    refine ⟨closure O, ⇑f, hOc, hOV.trans hVW, hOV, contMDiff_iff_contDiff.mp f.contMDiff,
      fun y => (hf01 y).1, fun y => (hf01 y).2,
      fun y hy => hf0 y (fun h => hy (subset_closure h)),
      fun y hy => image_eq_zero_of_notMem_tsupport
        (fun h => hy (subset_closure (hT₀O (Or.inl h)))),
      fun y hy => hf1.self_of_nhdsSet y (Or.inl hy),
      fun z hz => hf1.filter_mono (nhds_le_nhdsSet (Set.mem_union_right (tsupport X) hz))⟩
  
  have hNall : ∀ i : Fin k,
      ContDiffOn ℝ ∞ (hcrNormalField G (φ i)) W₀ ∧
      (∀ y ∈ W₀, ∀ w : E3, ∑ a : Fin 3, ∑ b : Fin 3, G y a b * w a * w b ≤ 1 →
          |fderiv ℝ (φ i) y w| ≤ fderiv ℝ (φ i) y (hcrNormalField G (φ i) y)) ∧
      (∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3,
          G y a b * hcrNormalField G (φ i) y a * hcrNormalField G (φ i) y b ≤ 1) := by
    intro i
    have hu := sfr_normal_unit G W₀ hpd (φ i) (hdφ i)
    obtain ⟨_, hc2, hc3⟩ := ccs_normal_props G (φ i) W₀ hW₀ hG hpd (hφ i)
      (hcrNormalField G (φ i)) (fun z _ a => rfl)
    exact ⟨hc2.mono (fun y hy => ⟨hy, (hu y hy).1⟩),
      fun y hy w hw => hc3 y hy (hu y hy).1 w hw, fun y hy => (hu y hy).2.le⟩
  
  have F0 : ∀ W : E3 → E3, (∀ y, y ∉ T → W y = 0) → ∀ z, z ∉ T → sepDensDiv G W z = 0 := by
    intro W hW z hz
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have hev : (fun y => Real.sqrt (G y).det * W y i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
      filter_upwards [hTc.isClosed.isOpen_compl.mem_nhds hz] with y hy
      rw [hW y hy]
      simp
    rw [hev.fderiv_eq]
    simp
  
  have F2 : ∀ W : E3 → E3, Measurable (sepDensDiv G W) := by
    intro W
    show Measurable (fun y => ∑ i : Fin 3,
      fderiv ℝ (fun z => Real.sqrt (G z).det * W z i) y (e i))
    exact Finset.measurable_sum _ fun i _ => measurable_fderiv_apply_const ℝ _ _
  
  obtain ⟨R, hR⟩ : ∃ R : ℕ → Set E3, ∀ j z,
      z ∈ R j ↔ (z ∈ W₀ ∧ ∀ i : Fin k, j ≤ (i : ℕ) → 0 < φ i z) :=
    ⟨fun j => {z | z ∈ W₀ ∧ ∀ i : Fin k, j ≤ (i : ℕ) → 0 < φ i z}, fun _ _ => Iff.rfl⟩
  have hRW : ∀ j, R j ⊆ W₀ := fun j z hz => ((hR j z).1 hz).1
  have hRo : ∀ j, IsOpen (R j) := by
    intro j
    rw [isOpen_iff_mem_nhds]
    intro z hz
    obtain ⟨hzW, hzφ⟩ := (hR j z).1 hz
    have h1 : ∀ i : Fin k, ∀ᶠ y in 𝓝 z, j ≤ (i : ℕ) → 0 < φ i y := by
      intro i
      by_cases hji : j ≤ (i : ℕ)
      · have hc : ContinuousAt (φ i) z := (hφ i).continuousOn.continuousAt (hW₀.mem_nhds hzW)
        filter_upwards [hc.tendsto.eventually (lt_mem_nhds (hzφ i hji))] with y hy
        exact fun _ => hy
      · exact Filter.Eventually.of_forall fun y h => absurd h hji
    filter_upwards [hW₀.mem_nhds hzW, Filter.eventually_all.2 h1] with y hy1 hy2
    exact (hR j y).2 ⟨hy1, hy2⟩
  have hRm : ∀ j, MeasurableSet (R j) := fun j => (hRo j).measurableSet
  have hR0 : E ∩ {z | z ∈ W₀ ∧ ∀ i, 0 < φ i z} = E ∩ R 0 := by
    ext z
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, hR]
    constructor
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, h2, fun i _ => h3 i⟩
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, h2, fun i => h3 i (Nat.zero_le _)⟩
  have hRk : ∀ z, z ∈ R k ↔ z ∈ W₀ := by
    intro z
    rw [hR]
    exact ⟨fun h => h.1, fun h => ⟨h, fun i hi => absurd i.isLt (not_lt.2 hi)⟩⟩
  have hRsucc : ∀ j (hj : j < k), ∀ z, z ∈ R j ↔ (z ∈ R (j + 1) ∧ 0 < φ ⟨j, hj⟩ z) := by
    intro j hj z
    rw [hR, hR]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨⟨h1, fun i hi => h2 i (by omega)⟩, h2 ⟨j, hj⟩ le_rfl⟩
    · rintro ⟨⟨h1, h2⟩, h3⟩
      refine ⟨h1, fun i hi => ?_⟩
      rcases Nat.eq_or_lt_of_le hi with h | h
      · have hi' : i = ⟨j, hj⟩ := Fin.ext h.symm
        rw [hi']
        exact h3
      · exact h2 i h
  
  apply ENNReal.le_of_forall_pos_le_add
  intro ε hε _
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = (ε : ℝ) / ((k : ℝ) + 1) := ⟨_, rfl⟩
  have hη : 0 < η := by
    rw [hηdef]
    exact div_pos (by exact_mod_cast hε) (by positivity)
  
  have key : ∀ j : ℕ, j ≤ k → ∃ Z : E3 → E3,
      (∀ z ∈ R j, ContDiffAt ℝ ∞ Z z) ∧ (∀ y, y ∉ T → Z y = 0) ∧
      (∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3, G y a b * Z y a * Z y b ≤ χ y ^ 2) ∧
      (∃ C : ℝ, ∀ z ∈ R j, |sepDensDiv G Z z| ≤ C) ∧
      ∫ y in E ∩ {z | z ∈ W₀ ∧ ∀ i, 0 < φ i z}, sepDensDiv G X y ≤
        (∫ y in E ∩ R j, sepDensDiv G Z y) + (j : ℝ) * η := by
    intro j
    induction j with
    | zero =>
      intro _
      refine ⟨X, fun z hz => ?_, hXT, fun y hy => ?_, ?_, ?_⟩
      · obtain ⟨h1, h2⟩ := (hR 0 z).1 hz
        exact hXs z h1 fun i => h2 i (Nat.zero_le _)
      · by_cases hyX : y ∈ tsupport X
        · rw [hχX y hyX, one_pow]
          exact hXn y
        · have h0 := image_eq_zero_of_notMem_tsupport hyX
          calc ∑ a : Fin 3, ∑ b : Fin 3, G y a b * X y a * X y b = (0 : ℝ) := by simp [h0]
            _ ≤ χ y ^ 2 := sq_nonneg _
      · obtain ⟨C, hC⟩ := hXd
        refine ⟨C, fun z hz => ?_⟩
        obtain ⟨h1, h2⟩ := (hR 0 z).1 hz
        exact hC z h1 fun i => h2 i (Nat.zero_le _)
      · rw [hR0]
        simp
    | succ j ih =>
      intro hj1
      have hj : j < k := by omega
      obtain ⟨Z, hZ1, hZ2, hZ3, ⟨CZ, hZ4⟩, hZ5⟩ := ih (by omega)
      obtain ⟨hN, hNcs, hN1⟩ := hNall ⟨j, hj⟩
      have hSW : R (j + 1) ⊆ W₀ := hRW (j + 1)
      have hYs : ∀ z ∈ R (j + 1), 0 < φ ⟨j, hj⟩ z → ContDiffAt ℝ ∞ Z z :=
        fun z hz hp => hZ1 z ((hRsucc j hj z).2 ⟨hz, hp⟩)
      have hYd : ∃ C : ℝ, ∀ z ∈ R (j + 1), 0 < φ ⟨j, hj⟩ z → |sepDensDiv G Z z| ≤ C :=
        ⟨CZ, fun z hz hp => hZ4 z ((hRsucc j hj z).2 ⟨hz, hp⟩)⟩
      obtain ⟨⟨Cg, hCg⟩, hg0, hτ⟩ := sfr_wall_field_div G W₀ hW₀ hG hpd (φ ⟨j, hj⟩) (hφ _)
        hN hNcs χ hχs hχ0 hχ1 T hTc hTW hχT (R (j + 1)) hSW Z hYs hZ3 hYd
      have hreg : ∀ τ : ℝ, 0 < τ →
          (∀ z ∈ R (j + 1), ContDiffAt ℝ ∞ (sfrWall G (φ ⟨j, hj⟩) χ τ Z) z) ∧
          (∀ y, y ∉ T → sfrWall G (φ ⟨j, hj⟩) χ τ Z y = 0) ∧
          (∀ y ∈ W₀, ∑ a : Fin 3, ∑ b : Fin 3,
            G y a b * sfrWall G (φ ⟨j, hj⟩) χ τ Z y a * sfrWall G (φ ⟨j, hj⟩) χ τ Z y b
              ≤ χ y ^ 2) :=
        fun τ hτ0 => sfr_wall_field_regular G W₀ hW₀ hpd (φ ⟨j, hj⟩) (hφ _) hN hN1 χ hχs
          hχ0 hχ1 T hχT (R (j + 1)) hSW Z hYs hZ2 hZ3 τ hτ0
      have hA : MeasurableSet (E ∩ R j) := hE.inter (hRm j)
      have hB : MeasurableSet (E ∩ R (j + 1)) := hE.inter (hRm (j + 1))
      have hAB : E ∩ R j ⊆ E ∩ R (j + 1) := fun z hz => ⟨hz.1, ((hRsucc j hj z).1 hz.2).1⟩
      have hφm : AEStronglyMeasurable (φ ⟨j, hj⟩) (volume.restrict (E ∩ R j)) :=
        ((hφ ⟨j, hj⟩).continuousOn.aestronglyMeasurable hW₀.measurableSet).mono_measure
          (Measure.restrict_mono (fun z hz => hRW j hz.2) le_rfl)
      obtain ⟨τ, hτ0, hint⟩ := sfr_wall_limit (E ∩ R j) (E ∩ R (j + 1)) T hA hB hAB hTc
        (φ ⟨j, hj⟩) hφm
        (fun z hz => ((hRsucc j hj z).1 hz.2).2)
        (sepDensDiv G Z) (sepDensDiv G (fun y => χ y • hcrNormalField G (φ ⟨j, hj⟩) y))
        (fun τ => sepDensDiv G (sfrWall G (φ ⟨j, hj⟩) χ τ Z))
        (F2 _).aestronglyMeasurable (F2 _).aestronglyMeasurable
        (fun τ _ => (F2 _).aestronglyMeasurable)
        (max CZ Cg)
        (fun z hz => (hZ4 z hz.2).trans (le_max_left _ _))
        (fun z _ => (hCg z).trans (le_max_right _ _))
        (fun τ hτ0 => by
          obtain ⟨C', hC'⟩ := (hτ τ hτ0).1
          exact ⟨C', fun z hz => hC' z hz.2⟩)
        (fun z _ hzT => F0 Z hZ2 z hzT)
        (fun z _ hzT => hg0 z hzT)
        (fun τ hτ0 z _ hzT => F0 _ (hreg τ hτ0).2.1 z hzT)
        (fun τ hτ0 z hz =>
          (hτ τ hτ0).2.1 z ((hRsucc j hj z).1 hz.2).1 ((hRsucc j hj z).1 hz.2).2)
        (fun τ hτ0 z hzB hzA => by
          have hzS := hzB.2
          have hnot : ¬ 0 < φ ⟨j, hj⟩ z :=
            fun hp => hzA ⟨hzB.1, (hRsucc j hj z).2 ⟨hzS, hp⟩⟩
          have hle : φ ⟨j, hj⟩ z ≤ 0 := not_lt.1 hnot
          have hzK : z ∈ K' := hEK z hzB.1 (hSW hzS) ⟨⟨j, hj⟩, hle⟩
          show 0 ≤ sepDensDiv G (sfrWall G (φ ⟨j, hj⟩) χ τ Z) z
          rw [(hτ τ hτ0).2.2 z hzS hle (hχK z hzK)]
          linarith [hcal ⟨j, hj⟩ z hzK hle])
        η hη
      refine ⟨sfrWall G (φ ⟨j, hj⟩) χ τ Z, (hreg τ hτ0).1, (hreg τ hτ0).2.1,
        (hreg τ hτ0).2.2, (hτ τ hτ0).1, ?_⟩
      push_cast
      linarith
  
  obtain ⟨Z, hZ1, hZ2, hZ3, _, hZ5⟩ := key k le_rfl
  have hZs : ContDiff ℝ ∞ Z := by
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ W₀
    · exact hZ1 z ((hRk z).2 hz)
    · have hzT : z ∉ T := fun h => hz (hTW h)
      have hev : Z =ᶠ[𝓝 z] fun _ => (0 : E3) := by
        filter_upwards [hTc.isClosed.isOpen_compl.mem_nhds hzT] with y hy
        exact hZ2 y hy
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hZsupp : Function.support Z ⊆ T := fun y hy => by
    by_contra h
    exact hy (hZ2 y h)
  have hZc : HasCompactSupport Z := HasCompactSupport.intro hTc hZ2
  have hZt : tsupport Z ⊆ V := (closure_minimal hZsupp hTc.isClosed).trans hTV
  have hZn : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1 := by
    intro y
    by_cases hy : y ∈ W₀
    · have h1 := hZ3 y hy
      have h2 : χ y ^ 2 ≤ 1 := by nlinarith [hχ0 y, hχ1 y]
      linarith
    · have h0 : Z y = 0 := hZ2 y (fun h => hy (hTW h))
      simp [h0]
  have hper : ENNReal.ofReal (∫ y in E, sepDensDiv G Z y) ≤ sepPerG G E V := by
    unfold sepPerG
    exact le_iSup_of_le Z (le_iSup_of_le ⟨hZs, hZc, hZt, hZn⟩ le_rfl)
  have heq : ∫ y in E ∩ R k, sepDensDiv G Z y = ∫ y in E, sepDensDiv G Z y := by
    symm
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hE Set.inter_subset_left ?_
    intro z hz
    have hzW : z ∉ W₀ := fun h => hz.2 ⟨hz.1, (hRk z).2 h⟩
    exact F0 Z hZ2 z (fun h => hzW (hTW h))
  rw [heq] at hZ5
  have hkη : (k : ℝ) * η ≤ ε := by
    rw [hηdef, mul_div_assoc', div_le_iff₀ (by positivity)]
    nlinarith [ε.coe_nonneg]
  calc ENNReal.ofReal (∫ y in E ∩ {z | z ∈ W₀ ∧ ∀ i, 0 < φ i z}, sepDensDiv G X y)
      ≤ ENNReal.ofReal ((∫ y in E, sepDensDiv G Z y) + (k : ℝ) * η) :=
        ENNReal.ofReal_le_ofReal hZ5
    _ ≤ ENNReal.ofReal (∫ y in E, sepDensDiv G Z y) + ENNReal.ofReal ((k : ℝ) * η) :=
        ENNReal.ofReal_add_le
    _ ≤ sepPerG G E V + (ε : ENNReal) := by
        refine add_le_add hper ?_
        rw [← ENNReal.ofReal_coe_nnreal]
        exact ENNReal.ofReal_le_ofReal hkη

theorem sector_glue_le_hullPerG (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (B : Set E3) (hB : IsOpen B)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) B)
    (hpd : ∀ y ∈ B, (G y).PosDef) (k : ℕ) (φ : Fin k → E3 → ℝ)
    (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) B) (hdφ : ∀ i, ∀ z ∈ B, fderiv ℝ (φ i) z ≠ 0)
    (Kc : Set E3) (hKc : ∀ z ∈ B, (∃ i, φ i z = 0) → z ∈ Kc)
    (E W : Set E3) (hE : MeasurableSet E) (hW : IsOpen W) (hWB : W ⊆ B) :
    hspSectorPer G B φ E W ≤ hullPerG G E W Kc :=
by
  classical
  
  have hDo : ∀ s : Fin k → Bool, IsOpen (hspSector B φ s) := by
    intro s
    have e : hspSector B φ s =
        B ∩ ⋂ i, (B ∩ (fun z => (if s i then (1 : ℝ) else -1) * φ i z) ⁻¹' Set.Ioi 0) := by
      ext z
      simp only [hspSector, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter,
        Set.mem_preimage, Set.mem_Ioi]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => ⟨h1, h2 i⟩⟩
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => (h2 i).2⟩
    rw [e]
