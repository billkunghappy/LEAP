    have h3 := (h2.hasFDerivAt_iff.mp h1).unique (hasFDerivAt_const (0:ℝ) w)
    have h4 := congrArg (fun L => L x) h3
    simpa using h4
  
  
  
  have hfeq : (fun w : E3 => w a - u (sepPlaneProj a w)) = fun w => w a - v w := by
    rw [hvdef]
  have hpd1 : ∀ (j : Fin 3) (z : E3),
      partialDeriv j (fun w : E3 => w a - v w) z = (e j) a - fderiv ℝ v z (e j) := by
    intro j z
    have h1 : HasFDerivAt (fun w : E3 => w a - v w)
        ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ) - fderiv ℝ v z) z :=
      (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).hasFDerivAt.sub (hvd z).hasFDerivAt
    simp only [partialDeriv]
    rw [h1.fderiv]
    simp
  have hpd1f : ∀ j : Fin 3,
      partialDeriv j (fun w : E3 => w a - v w) = fun z => (e j) a - fderiv ℝ v z (e j) :=
    fun j => funext fun z => hpd1 j z
  have hpd2 : ∀ (i j : Fin 3) (z : E3),
      partialDeriv i (partialDeriv j (fun w : E3 => w a - v w)) z =
        -(fderiv ℝ (fderiv ℝ v) z (e i) (e j)) := by
    intro i j z
    rw [hpd1f j]
    have h1 : HasFDerivAt (fun y => fderiv ℝ v y (e j))
        ((fderiv ℝ v z).comp (0 : E3 →L[ℝ] E3) + (fderiv ℝ (fderiv ℝ v) z).flip (e j)) z :=
      (hDv z).hasFDerivAt.clm_apply (hasFDerivAt_const (e j) z)
    have h2 := h1.const_sub ((e j) a)
    simp only [partialDeriv]
    rw [h2.fderiv]
    simp
  
  
  
  have hzero : ∀ w ∈ Ω, sepPlaneProj a w ≠ 0 → fderiv ℝ (fderiv ℝ v) w = 0 := by
    intro w hw hP0
    obtain ⟨p, hp⟩ : ∃ p : E3, p = sepPlaneProj a w := ⟨_, rfl⟩
    have hpa : p a = 0 := by rw [hp]; exact hPa w
    have hpd : ‖p - p₀‖ < ρ := by rw [hp]; exact hw
    have hy : p + u p • e a = w + (u p - w a) • e a := by
      have hw' := hdecomp w
      rw [← hp] at hw'
      calc p + u p • e a = (p + w a • e a) + (u p - w a) • e a := by
            rw [add_assoc, ← add_smul]; congr 2; ring
        _ = w + (u p - w a) • e a := by rw [← hw']
    have hD1 : fderiv ℝ v (p + u p • e a) = fderiv ℝ v w := by rw [hy, hDvT]
    have hD2 : fderiv ℝ (fderiv ℝ v) (p + u p • e a) = fderiv ℝ (fderiv ℝ v) w := by
      rw [hy, hD2vT]
    have hm := hmse p hpa hpd
    rw [hfeq] at hm
    have hij := key a (fun w : E3 => w a - v w) (p + u p • e a)
      (fun j => fderiv ℝ v w (e j)) (fun j => p j)
      (fun i j => fderiv ℝ (fderiv ℝ v) w (e i) (e j))
      (fun i j => hsymm w (e i) (e j))
      (fun j => by simp only [hdirD w]; rfl)
      (hdirv w) hpa
      (by
        by_contra hcon
        push_neg at hcon
        apply hP0
        rw [← hp]
        ext i
        simp [hcon i])
      (by
        intro i
        have h0 : fderiv ℝ (fderiv ℝ v) w (e i) p = 0 := by
          rw [hp, sepPlaneProj, map_sub, map_smul, heul2 w hw, hdirD' w, smul_zero, sub_zero]
        rw [← hexp p, map_sum] at h0
        rw [← h0]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_smul, smul_eq_mul, mul_comm])
      (fun j => by rw [hpd1, hD1])
      (fun i j => by rw [hpd2, hD2])
      hm
    ext x z
    rw [← hexp x, ← hexp z]
    simp [map_sum, hij]
  have hzero' : ∀ w ∈ Ω, fderiv ℝ (fderiv ℝ v) w = 0 := by
    intro w hw
    by_cases hP0 : sepPlaneProj a w = 0
    · obtain ⟨b, hb⟩ : ∃ b : Fin 3, b ≠ a := ⟨a + 1, by fin_cases a <;> decide⟩
      have hba : (e b) a = 0 := by simp [EuclideanSpace.single_apply, Ne.symm hb]
      have hbP : sepPlaneProj a (e b) = e b := hPplane _ hba
      have hw' : ‖sepPlaneProj a w - p₀‖ < ρ := hw
      obtain ⟨r, hr⟩ : ∃ r : ℝ, r = ρ - ‖sepPlaneProj a w - p₀‖ := ⟨_, rfl⟩
      have hr0 : 0 < r := by rw [hr]; linarith
      have hPs : ∀ s : ℝ, sepPlaneProj a (w + s • e b) = sepPlaneProj a w + s • e b := by
        intro s
        rw [← hPc_apply, map_add, map_smul, hPc_apply, hPc_apply, hbP]
      have hsub : Set.Ioo (0:ℝ) r ⊆ {s : ℝ | fderiv ℝ (fderiv ℝ v) (w + s • e b) = 0} := by
        intro s hs
        apply hzero
        · show ‖sepPlaneProj a (w + s • e b) - p₀‖ < ρ
          rw [hPs]
          calc ‖sepPlaneProj a w + s • e b - p₀‖ = ‖(sepPlaneProj a w - p₀) + s • e b‖ := by
                congr 1; abel
            _ ≤ ‖sepPlaneProj a w - p₀‖ + ‖s • e b‖ := norm_add_le _ _
            _ = ‖sepPlaneProj a w - p₀‖ + s := by
                rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
                  abs_of_pos hs.1]
            _ < ρ := by linarith [hs.2]
        · rw [hPs, hP0, zero_add]
          intro h0
          have h1 := congrArg (fun z : E3 => z b) h0
          simp at h1
          exact hs.1.ne' h1
      have hcont : Continuous (fun s : ℝ => fderiv ℝ (fderiv ℝ v) (w + s • e b)) :=
        hD2c.comp (continuous_const.add (continuous_id.smul continuous_const))
      have hclosed : IsClosed {s : ℝ | fderiv ℝ (fderiv ℝ v) (w + s • e b) = 0} :=
        isClosed_eq hcont continuous_const
      have hcl := hclosed.closure_subset_iff.mpr hsub
      rw [closure_Ioo hr0.ne] at hcl
      have h0 := hcl ⟨le_refl 0, hr0.le⟩
      simpa using h0
    · exact hzero w hw hP0
  
  
  
  have hconst : ∀ w ∈ Ω, fderiv ℝ v w = fderiv ℝ v p₀ := by
    intro w hw
    exact hΩo.is_const_of_fderiv_eq_zero hΩc.isPreconnected hDv.differentiableOn
      (fun z hz => hzero' z hz) hw hp₀Ω
  refine ⟨(InnerProductSpace.toDual ℝ E3).symm (fderiv ℝ v p₀), ?_, ?_⟩
  · have h1 := @InnerProductSpace.toDual_symm_apply ℝ E3 _ _ _ _ (e a) (fderiv ℝ v p₀)
    rw [real_inner_comm, EuclideanSpace.inner_single_left] at h1
    simp at h1
    rw [h1, hdirv]
  · intro p hpa hpd
    have hpΩ : p ∈ Ω := by
      show ‖sepPlaneProj a p - p₀‖ < ρ
      rw [hPplane p hpa]; exact hpd
    rw [InnerProductSpace.toDual_symm_apply, ← hconst p hpΩ, heul p hpΩ, hvdef]
    show u p = u (sepPlaneProj a p)
    rw [hPplane p hpa]

theorem sepCone_local_plane (K : Set E3) (x : E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (hdil : ∀ t : ℝ, 0 < t → ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) → ∀ N ∈ 𝓝 (t • z), volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) (a : Fin 3) (u : E3 → ℝ) (ρ δ : ℝ) (hρ : 0 < ρ) (hδ : 0 < δ) (hu : ContDiff ℝ 1 u) (hu0 : u (sepPlaneProj a x) = x a) (hside : (volume ((sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ K) = 0) ∨ (volume ((sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ K) = 0)) : ∃ (m : E3) (N : Set E3), ‖m‖ = 1 ∧ N ∈ 𝓝 x ∧ volume ((N ∩ {z | @inner ℝ E3 _ m z < 0}) \ K) = 0 ∧ volume (N ∩ {z | 0 < @inner ℝ E3 _ m z} ∩ K) = 0 :=
by
  classical
  
  have hP_sub : ∀ y y' : E3, sepPlaneProj a (y - y') = sepPlaneProj a y - sepPlaneProj a y' := by
    intro y y'
    simp only [sepPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hP_a : ∀ y : E3, (sepPlaneProj a y) a = 0 := by
    intro y
    simp [sepPlaneProj, e]
  have hP_lift : ∀ p : E3, p a = 0 → ∀ s : ℝ,
      (p + s • e a) a = s ∧ sepPlaneProj a (p + s • e a) = p := by
    intro p hp s
    have h1 : (p + s • e a) a = s := by simp [e, hp]
    refine ⟨h1, ?_⟩
    simp only [sepPlaneProj, h1]
    exact add_sub_cancel_right p (s • e a)
  have hinner_e : ∀ z : E3, @inner ℝ E3 _ (e a) z = z a := by
    intro z
    simp [e, EuclideanSpace.inner_single_left]
  have hinner_P : ∀ g z : E3, g a = 0 →
      @inner ℝ E3 _ g (sepPlaneProj a z) = @inner ℝ E3 _ g z := by
    intro g z hg
    simp [sepPlaneProj, inner_sub_right, real_inner_smul_right,
      EuclideanSpace.inner_single_right, hg]
  have hP0 : sepPlaneProj a (x - x) = 0 := by
    simp [sepPlaneProj]
  
  have hsymmI : ∀ (y : E3) (i j : Fin 3),
      (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j =
        (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j i := by
    intro y i j
    simp only [Matrix.one_apply]
    by_cases h : i = j
    · simp [h]
    · simp [h, Ne.symm h]
  obtain ⟨u', r', hr', hr'ρ, hu', hagree, hmse⟩ :=
    sepPerMin_C1_graph_smooth (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Set.univ K isOpen_univ
      (fun i j => contDiffOn_const) hsymmI (fun _ _ => Matrix.PosDef.one) hmin a x u ρ δ hρ hδ
      hu hu0 (Set.subset_univ _) hside
  
  have hB := sepGraph_measBdry K a x u ρ δ hu.continuous hside
  have hgraph' : ∀ z ∈ sepCyl a x r' δ,
      ((∀ N ∈ 𝓝 z, volume (N ∩ K) ≠ 0 ∧ volume (N \ K) ≠ 0) ↔
        z a = u' (sepPlaneProj a z)) := by
    intro z hz
    have hzC : z ∈ sepCyl a x ρ δ := ⟨lt_of_lt_of_le hz.1 hr'ρ, hz.2⟩
    rw [hB z hzC, hagree z hz.1]
  have hw0 : u' (sepPlaneProj a x) = x a := by
    rw [hagree x (by rw [hP0, norm_zero]; exact hr'), hu0]
  
  obtain ⟨ρ₂, η, hρ₂, hρ₂r', hη, hH⟩ :=
    sepConeGraph_homog K hdil a x u' r' δ hr' hδ (hu'.continuous) hw0 hgraph'
  
  have hmse' : ∀ p : E3, p a = 0 → ‖p - sepPlaneProj a x‖ < ρ₂ →
      levelMeanCurvCoord (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        (fun w => w a - u' (sepPlaneProj a w)) (p + u' p • e a) = 0 := by
    intro p hp hpd
    obtain ⟨hza, hzP⟩ := hP_lift p hp (u' p)
    apply hmse
    · refine ⟨?_, ?_⟩
      · rw [hP_sub, hzP]
        exact lt_trans hpd hρ₂r'
      · rw [hza]
        exact (hH p hp hpd).1
    · rw [hza, hzP]
  
  obtain ⟨g, hga, hlin⟩ :=
    sepConeGraph_linear u' a (sepPlaneProj a x) ρ₂ η hu' hρ₂ hη (hP_a x)
      (fun p hp hpd => (hH p hp hpd).2) hmse'
  
  obtain ⟨m', hm'⟩ : ∃ m' : E3, m' = e a - g := ⟨_, rfl⟩
  have hkey : ∀ z ∈ sepCyl a x ρ₂ δ, z a - u (sepPlaneProj a z) = @inner ℝ E3 _ m' z := by
    intro z hz
    have hzd : ‖sepPlaneProj a z - sepPlaneProj a x‖ < ρ₂ := by
      rw [← hP_sub]; exact hz.1
    have h1 : u (sepPlaneProj a z) = u' (sepPlaneProj a z) :=
      (hagree z (lt_trans hz.1 hρ₂r')).symm
    rw [h1, hlin _ (hP_a z) hzd, hinner_P g z hga, hm', inner_sub_left, hinner_e]
  have hm'a : m' a = 1 := by
    rw [hm']
    simp [e, hga]
  have hm'0 : m' ≠ 0 := by
    intro h
    rw [h] at hm'a
    simp at hm'a
  have hnpos : 0 < ‖m'‖ := norm_pos_iff.mpr hm'0
  have hcpos : 0 < ‖m'‖⁻¹ := inv_pos.mpr hnpos
  have hnorm1 : ‖‖m'‖⁻¹ • m'‖ = 1 := by
    rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hnpos.ne']
  have hcont : Continuous (fun z : E3 => sepPlaneProj a (z - x)) := by
    unfold sepPlaneProj
    fun_prop
  have hcont2 : Continuous (fun z : E3 => z a) := by
    fun_prop
  have hNo : IsOpen (sepCyl a x ρ₂ δ) := by
    have h1 : IsOpen {z : E3 | ‖sepPlaneProj a (z - x)‖ < ρ₂} :=
      isOpen_lt (continuous_norm.comp hcont) continuous_const
    have h2 : IsOpen {z : E3 | |z a - x a| < δ} :=
      isOpen_lt ((hcont2.sub continuous_const).abs) continuous_const
    exact h1.inter h2
  have hxN : x ∈ sepCyl a x ρ₂ δ := by
    refine ⟨?_, ?_⟩
    · show ‖sepPlaneProj a (x - x)‖ < ρ₂
      rw [hP0, norm_zero]; exact hρ₂
    · show |x a - x a| < δ
      rw [sub_self, abs_zero]; exact hδ
  have hNnhds : sepCyl a x ρ₂ δ ∈ 𝓝 x := hNo.mem_nhds hxN
  have hNC : ∀ z ∈ sepCyl a x ρ₂ δ, z ∈ sepCyl a x ρ δ := fun z hz =>
    ⟨lt_of_lt_of_le (lt_trans hz.1 hρ₂r') hr'ρ, hz.2⟩
  have hsgn_neg : ∀ X : ℝ, ‖m'‖⁻¹ * X < 0 → X < 0 := by
    intro X hX
    exact lt_of_mul_lt_mul_left (by rwa [mul_zero]) hcpos.le
  have hsgn_pos : ∀ X : ℝ, 0 < ‖m'‖⁻¹ * X → 0 < X := by
    intro X hX
    exact lt_of_mul_lt_mul_left (by rwa [mul_zero] : ‖m'‖⁻¹ * 0 < ‖m'‖⁻¹ * X) hcpos.le
  rcases hside with ⟨hs1, hs2⟩ | ⟨hs1, hs2⟩
  · refine ⟨‖m'‖⁻¹ • m', sepCyl a x ρ₂ δ, hnorm1, hNnhds, ?_, ?_⟩
    · refine MeasureTheory.measure_mono_null ?_ hs1
      rintro z ⟨⟨hzN, hzm⟩, hzK⟩
      refine ⟨⟨hNC z hzN, ?_⟩, hzK⟩
      have hzm' : ‖m'‖⁻¹ * @inner ℝ E3 _ m' z < 0 := by
        have := hzm
        simp only [Set.mem_setOf_eq, real_inner_smul_left] at this
        exact this
      have h := hsgn_neg _ hzm'
      rw [← hkey z hzN] at h
      show z a < u (sepPlaneProj a z)
      linarith
    · refine MeasureTheory.measure_mono_null ?_ hs2
      rintro z ⟨⟨hzN, hzm⟩, hzK⟩
      refine ⟨⟨hNC z hzN, ?_⟩, hzK⟩
      have hzm' : 0 < ‖m'‖⁻¹ * @inner ℝ E3 _ m' z := by
        have := hzm
        simp only [Set.mem_setOf_eq, real_inner_smul_left] at this
        exact this
      have h := hsgn_pos _ hzm'
      rw [← hkey z hzN] at h
      show u (sepPlaneProj a z) < z a
      linarith
  · refine ⟨-(‖m'‖⁻¹ • m'), sepCyl a x ρ₂ δ, by rw [norm_neg]; exact hnorm1, hNnhds, ?_, ?_⟩
    · refine MeasureTheory.measure_mono_null ?_ hs1
      rintro z ⟨⟨hzN, hzm⟩, hzK⟩
      refine ⟨⟨hNC z hzN, ?_⟩, hzK⟩
      have hzm' : 0 < ‖m'‖⁻¹ * @inner ℝ E3 _ m' z := by
        have := hzm
        simp only [Set.mem_setOf_eq, inner_neg_left, real_inner_smul_left] at this
        linarith
      have h := hsgn_pos _ hzm'
      rw [← hkey z hzN] at h
      show u (sepPlaneProj a z) < z a
      linarith
    · refine MeasureTheory.measure_mono_null ?_ hs2
      rintro z ⟨⟨hzN, hzm⟩, hzK⟩
      refine ⟨⟨hNC z hzN, ?_⟩, hzK⟩
      have hzm' : ‖m'‖⁻¹ * @inner ℝ E3 _ m' z < 0 := by
        have := hzm
        simp only [Set.mem_setOf_eq, inner_neg_left, real_inner_smul_left] at this
        linarith
      have h := hsgn_neg _ hzm'
      rw [← hkey z hzN] at h
      show z a < u (sepPlaneProj a z)
      linarith

theorem sepLevelset_to_coordGraph (U F : Set E3) (hU : IsOpen U) (y₀ : E3) (hy₀ : y₀ ∈ U)
    (f : E3 → ℝ) (N : Set E3) (hf : ContDiff ℝ 1 f) (hf0 : f y₀ = 0)
    (hdf : fderiv ℝ f y₀ ≠ 0) (hN : N ∈ 𝓝 y₀)
    (hneg : volume ((N ∩ {z | f z < 0}) \ F) = 0) (hpos : volume (N ∩ {z | 0 < f z} ∩ F) = 0) :
    ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧ ContDiff ℝ 1 u ∧
      u (sepPlaneProj a y₀) = y₀ a ∧ sepCyl a y₀ r δ ⊆ U ∧
      ((volume ((sepCyl a y₀ r δ ∩ {z | z a < u (sepPlaneProj a z)}) \ F) = 0 ∧
          volume (sepCyl a y₀ r δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ F) = 0) ∨
        (volume ((sepCyl a y₀ r δ ∩ {z | u (sepPlaneProj a z) < z a}) \ F) = 0 ∧
          volume (sepCyl a y₀ r δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ F) = 0)) :=
by
  classical
  
  have hea : ∀ a : Fin 3, (e a) a = 1 := fun a => by simp [e]
  have hPa : ∀ (a : Fin 3) (z : E3), (sepPlaneProj a z) a = 0 := fun a z => by
    simp [sepPlaneProj, e]
  have hPsub : ∀ (a : Fin 3) (x y : E3),
      sepPlaneProj a (x - y) = sepPlaneProj a x - sepPlaneProj a y := fun a x y => by
    simp only [sepPlaneProj, PiLp.sub_apply, sub_smul]; abel
  have hPadd : ∀ (a : Fin 3) (x : E3) (t : ℝ), sepPlaneProj a (x + t • e a) = sepPlaneProj a x :=
    fun a x t => by
      simp only [sepPlaneProj, PiLp.add_apply, PiLp.smul_apply, add_smul, smul_eq_mul]
      simp [e]
  have hdec : ∀ (a : Fin 3) (z : E3), z = sepPlaneProj a z + (z a) • e a := fun a z => by
    simp [sepPlaneProj]
  have hcadd : ∀ (a : Fin 3) (x : E3) (t : ℝ), (x + t • e a) a = x a + t := fun a x t => by
    simp [e]
  have hen : ∀ a : Fin 3, ‖e a‖ = 1 := fun a => by simp [e, EuclideanSpace.norm_single]
  
  obtain ⟨a, ha⟩ : ∃ a : Fin 3, fderiv ℝ f y₀ (e a) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hdf
    ext v
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext j; fin_cases j <;> simp [e]
    rw [hv]
    simp [hcon]
  
  have key : ∀ f₁ : E3 → ℝ, ContDiff ℝ 1 f₁ → f₁ y₀ = 0 → 0 < fderiv ℝ f₁ y₀ (e a) →
      ∃ (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧ ContDiff ℝ 1 u ∧
        u (sepPlaneProj a y₀) = y₀ a ∧ sepCyl a y₀ r δ ⊆ U ∩ N ∧
        ∀ z ∈ sepCyl a y₀ r δ, (f₁ z < 0 ↔ z a < u (sepPlaneProj a z)) ∧
          (0 < f₁ z ↔ u (sepPlaneProj a z) < z a) := by
    intro f₁ hf₁ hf₁0 hc
    
    let Lp : E3 →L[ℝ] E3 :=
      ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj a).smulRight (e a)
    have hLp : ∀ z, Lp z = sepPlaneProj a z := fun z => rfl
    let D : E3 →L[ℝ] ℝ := fderiv ℝ f₁ y₀
    let T₀ : E3 →L[ℝ] E3 := Lp + D.smulRight (e a)
    have hT₀ : ∀ v, T₀ v = sepPlaneProj a v + D v • e a := fun v => rfl
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : E3 → E3, Φ = fun z => sepPlaneProj a z + f₁ z • e a := ⟨_, rfl⟩
    have hΦeq : Φ = fun z => Lp z + f₁ z • e a := by
      rw [hΦdef]; funext z; rw [hLp]
    have hΦC : ContDiff ℝ 1 Φ := by
      rw [hΦeq]; exact Lp.contDiff.add (hf₁.smul contDiff_const)
    have hΦd : HasFDerivAt Φ T₀ y₀ := by
      rw [hΦeq]
      exact Lp.hasFDerivAt.add ((hf₁.differentiable one_ne_zero y₀).hasFDerivAt.smul_const (e a))
    have hinj : Function.Injective (T₀ : E3 →ₗ[ℝ] E3) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro v hv
      have hv' : sepPlaneProj a v + D v • e a = 0 := hv
      have h1 : D v = 0 := by
        have := congrArg (fun w : E3 => w a) hv'
        simpa [hPa, hea] using this
      rw [h1, zero_smul, add_zero] at hv'
      have h2 : v = (v a) • e a := by
        conv_lhs => rw [hdec a v]
        rw [hv', zero_add]
      have h3 : v a * D (e a) = 0 := by
        rw [← smul_eq_mul, ← map_smul, ← h2]; exact h1
      have h4 : v a = 0 := by
        rcases mul_eq_zero.mp h3 with h | h
        · exact h
        · exact absurd h (ne_of_gt hc)
      rw [h2, h4, zero_smul]
    let T : E3 ≃L[ℝ] E3 :=
      (LinearEquiv.ofInjectiveEndo (T₀ : E3 →ₗ[ℝ] E3) hinj).toContinuousLinearEquiv
    have hTT : (T : E3 →L[ℝ] E3) = T₀ := by ext v; rfl
    have hΦd' : HasFDerivAt Φ (T : E3 →L[ℝ] E3) y₀ := by rw [hTT]; exact hΦd
    have hn : (1 : WithTop ℕ∞) ≠ 0 := by simp
    have hΨC := hΦC.contDiffAt.to_localInverse hΦd' hn
    have hstrict := hΦC.contDiffAt.hasStrictFDerivAt' hΦd' hn
    obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : E3 → E3, Ψ = hΦC.contDiffAt.localInverse hΦd' hn := ⟨_, rfl⟩
    have hΨinv : ∀ᶠ w in 𝓝 (Φ y₀), Φ (Ψ w) = w := by
      rw [hΨdef]; exact hstrict.eventually_right_inverse
    have hΨy₀ : Ψ (Φ y₀) = y₀ := by
      rw [hΨdef]; exact hstrict.localInverse_apply_image
    rw [← hΨdef] at hΨC
    have hΦy₀ : Φ y₀ = sepPlaneProj a y₀ := by simp [hΦdef, hf₁0]
    rw [hΦy₀] at hΨC hΨinv hΨy₀
    obtain ⟨η, hη, hηinv⟩ := Metric.eventually_nhds_iff.mp hΨinv
    obtain ⟨v, hvdef⟩ : ∃ v : E3 → ℝ, v = fun w => Ψ w a := ⟨_, rfl⟩
    have hvC : ContDiffAt ℝ 1 v (sepPlaneProj a y₀) := by
      rw [hvdef]
      exact (EuclideanSpace.proj a).contDiff.contDiffAt.comp _ hΨC
    have hv0 : v (sepPlaneProj a y₀) = y₀ a := by simp [hvdef, hΨy₀]
    have hvzero : ∀ z : E3, ‖sepPlaneProj a z - sepPlaneProj a y₀‖ < η →
        f₁ (sepPlaneProj a z + v (sepPlaneProj a z) • e a) = 0 := by
      intro z hz
      have hx : Φ (Ψ (sepPlaneProj a z)) = sepPlaneProj a z := hηinv (by rwa [dist_eq_norm])
      obtain ⟨x, hxdef⟩ : ∃ x, x = Ψ (sepPlaneProj a z) := ⟨_, rfl⟩
      rw [← hxdef] at hx
      have hfx : f₁ x = 0 := by
        have := congrArg (fun w : E3 => w a) hx
        simpa [hΦdef, hPa, hea] using this
      have hPx : sepPlaneProj a x = sepPlaneProj a z := by
        have h := hx
        simp only [hΦdef, hfx, zero_smul, add_zero] at h
        exact h
      have : sepPlaneProj a z + v (sepPlaneProj a z) • e a = x := by
        rw [hvdef]
        simp only
        rw [← hxdef, ← hPx]
        exact (hdec a x).symm
      rw [this]; exact hfx
    
    obtain ⟨ε, hε, hεC⟩ := Metric.eventually_nhds_iff.mp (hvC.eventually (by simp))
    let χ : ContDiffBump (sepPlaneProj a y₀) := ⟨ε / 4, ε / 2, by positivity, by linarith⟩
    obtain ⟨u, hudef⟩ : ∃ u : E3 → ℝ, u = fun w => χ w * v w := ⟨_, rfl⟩
    have huC : ContDiff ℝ 1 u := by
      rw [contDiff_iff_contDiffAt]
      intro w
      by_cases hw : dist w (sepPlaneProj a y₀) < ε
      · rw [hudef]
        exact (χ.contDiff.contDiffAt).mul (hεC hw)
      · have hev : u =ᶠ[𝓝 w] fun _ => (0 : ℝ) := by
          have hopen : IsOpen {w' : E3 | ε / 2 < dist w' (sepPlaneProj a y₀)} :=
            isOpen_lt continuous_const (continuous_id.dist continuous_const)
          have hwm : ε / 2 < dist w (sepPlaneProj a y₀) := by push_neg at hw; linarith
          filter_upwards [hopen.mem_nhds hwm] with w' hw'
          rw [hudef]
          simp only
          rw [χ.zero_of_le_dist (le_of_lt hw'), zero_mul]
        exact contDiffAt_const.congr_of_eventuallyEq hev
    have hueq : ∀ w : E3, ‖w - sepPlaneProj a y₀‖ < ε / 4 → u w = v w := by
      intro w hw
      rw [hudef]
      simp only
      rw [χ.one_of_mem_closedBall (by rw [mem_closedBall, dist_eq_norm]; exact le_of_lt hw),
        one_mul]
    have hu0 : u (sepPlaneProj a y₀) = y₀ a := by
      rw [hueq _ (by simp; positivity)]; exact hv0
    
    have hhc : Continuous (fun z => fderiv ℝ f₁ z (e a)) :=
      (hf₁.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hW : U ∩ N ∩ {z | 0 < fderiv ℝ f₁ z (e a)} ∈ 𝓝 y₀ :=
      Filter.inter_mem (Filter.inter_mem (hU.mem_nhds hy₀) hN)
        ((isOpen_lt continuous_const hhc).mem_nhds hc)
    obtain ⟨ρ, hρ, hρsub⟩ := Metric.mem_nhds_iff.mp hW
    obtain ⟨r₀, hr₀, hr₀c⟩ :=
      Metric.continuousAt_iff.mp huC.continuous.continuousAt (ρ / 2) (by positivity)
    obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = min r₀ (min η (min (ε / 4) (ρ / 2))) := ⟨_, rfl⟩
    have hr : 0 < r := by
      rw [hrdef]; exact lt_min hr₀ (lt_min hη (lt_min (by positivity) (by positivity)))
    have hrr₀ : r ≤ r₀ := by rw [hrdef]; exact min_le_left _ _
    have hrη : r ≤ η := by
      rw [hrdef]; exact le_trans (min_le_right _ _) (min_le_left _ _)
    have hrε : r ≤ ε / 4 := by
      rw [hrdef]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hrρ : r ≤ ρ / 2 := by
      rw [hrdef]
      exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    
    have hcyl : ∀ z ∈ sepCyl a y₀ r (ρ / 2),
        ‖z - y₀‖ < ρ ∧ ‖sepPlaneProj a z - sepPlaneProj a y₀‖ < r := by
      intro z hz
      obtain ⟨h1, h2⟩ := hz
      refine ⟨?_, by rw [← hPsub]; exact h1⟩
      have hz' : z - y₀ = sepPlaneProj a (z - y₀) + (z a - y₀ a) • e a := by
        have := hdec a (z - y₀); rwa [PiLp.sub_apply] at this
      calc ‖z - y₀‖ = ‖sepPlaneProj a (z - y₀) + (z a - y₀ a) • e a‖ := by rw [← hz']
        _ ≤ ‖sepPlaneProj a (z - y₀)‖ + ‖(z a - y₀ a) • e a‖ := norm_add_le _ _
        _ = ‖sepPlaneProj a (z - y₀)‖ + |z a - y₀ a| := by
          rw [norm_smul, hen, mul_one, Real.norm_eq_abs]
        _ < ρ := by linarith
    have hCball : ∀ z ∈ sepCyl a y₀ r (ρ / 2),
        z ∈ U ∩ N ∩ {z | 0 < fderiv ℝ f₁ z (e a)} := fun z hz =>
      hρsub (mem_ball_iff_norm.mpr (hcyl z hz).1)
    
    have hmono : ∀ z ∈ sepCyl a y₀ r (ρ / 2), ∀ z' ∈ sepCyl a y₀ r (ρ / 2),
        sepPlaneProj a z = sepPlaneProj a z' → z a < z' a → f₁ z < f₁ z' := by
      intro z hz z' hz' hPP hlt
      obtain ⟨γ, hγdef⟩ : ∃ γ : ℝ → E3, γ = fun τ => z + (τ - z a) • e a := ⟨_, rfl⟩
      have hγz : γ (z a) = z := by rw [hγdef]; simp
      have hγz' : γ (z' a) = z' := by
        rw [hγdef]
        simp only
        rw [sub_smul]
        calc z + (z' a • e a - z a • e a) = (z - z a • e a) + z' a • e a := by abel
          _ = sepPlaneProj a z + z' a • e a := rfl
          _ = sepPlaneProj a z' + z' a • e a := by rw [hPP]
          _ = z' := (hdec a z').symm
      have hγd : ∀ τ, HasDerivAt (fun τ => f₁ (γ τ)) (fderiv ℝ f₁ (γ τ) (e a)) τ := by
        intro τ
        have h1 : HasDerivAt γ (e a) τ := by
          rw [hγdef]
          simpa using (((hasDerivAt_id τ).sub_const (z a)).smul_const (e a)).const_add z
        exact (hf₁.differentiable one_ne_zero (γ τ)).hasFDerivAt.comp_hasDerivAt τ h1
      have hγC : ∀ τ, z a < τ → τ < z' a → γ τ ∈ sepCyl a y₀ r (ρ / 2) := by
        intro τ h1 h2
        obtain ⟨hz1, hz2⟩ := hz
        obtain ⟨hz1', hz2'⟩ := hz'
        have hγa : (γ τ) a = τ := by rw [hγdef]; simp only; rw [hcadd]; ring
        have hγP : sepPlaneProj a (γ τ) = sepPlaneProj a z := by rw [hγdef]; simp only; rw [hPadd]
        refine ⟨?_, ?_⟩
        · rw [hPsub, hγP, ← hPsub]; exact hz1
        · rw [hγa]
          rw [abs_lt] at hz2 hz2' ⊢
          constructor <;> linarith [hz2.1, hz2'.2]
      obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (fun τ => f₁ (γ τ))
        (fun τ => fderiv ℝ f₁ (γ τ) (e a)) hlt
        (fun τ _ => (hγd τ).continuousAt.continuousWithinAt) (fun τ _ => hγd τ)
      have hp : 0 < fderiv ℝ f₁ (γ ξ) (e a) := (hCball _ (hγC ξ hξ.1 hξ.2)).2
      simp only at hξeq
      rw [hξeq, hγz, hγz'] at hp
      have := (div_pos_iff_of_pos_right (sub_pos.mpr hlt)).mp hp
      linarith
    
    have hsign : ∀ z ∈ sepCyl a y₀ r (ρ / 2), (f₁ z < 0 ↔ z a < u (sepPlaneProj a z)) ∧
        (0 < f₁ z ↔ u (sepPlaneProj a z) < z a) := by
      intro z hz
      obtain ⟨hzρ, hzr⟩ := hcyl z hz
      obtain ⟨t, htdef⟩ : ∃ t, t = u (sepPlaneProj a z) := ⟨_, rfl⟩
      obtain ⟨g, hgdef⟩ : ∃ g : E3, g = z + (t - z a) • e a := ⟨_, rfl⟩
      have hga : g a = t := by rw [hgdef, hcadd]; ring
      have hgP : sepPlaneProj a g = sepPlaneProj a z := by rw [hgdef, hPadd]
      have hg' : g = sepPlaneProj a z + t • e a := by
        rw [hgdef]; simp only [sepPlaneProj, sub_smul]; abel
      have htv : t = v (sepPlaneProj a z) := by
        rw [htdef]; exact hueq _ (lt_of_lt_of_le hzr hrε)
      have hfg : f₁ g = 0 := by
        rw [hg', htv]; exact hvzero z (lt_of_lt_of_le hzr hrη)
      have htd : |t - y₀ a| < ρ / 2 := by
        have h := hr₀c (x := sepPlaneProj a z) (by rw [dist_eq_norm]; linarith)
        rw [Real.dist_eq, hu0] at h
        rw [htdef]; exact h
      have hgC : g ∈ sepCyl a y₀ r (ρ / 2) := by
        refine ⟨?_, ?_⟩
        · rw [hPsub, hgP, ← hPsub]; exact hz.1
        · rw [hga]; exact htd
      have hzg : z a = t → z = g := by
        intro h
        rw [hg', ← h]; exact hdec a z
      rw [← htdef]
      rcases lt_trichotomy (z a) t with h | h | h
      · have := hmono z hz g hgC hgP.symm (by rw [hga]; exact h)
        rw [hfg] at this
        exact ⟨⟨fun _ => h, fun _ => this⟩, ⟨fun h' => absurd this (not_lt.mpr h'.le),
          fun h' => absurd h (not_lt.mpr h'.le)⟩⟩
      · have h0 : f₁ z = 0 := by rw [hzg h]; exact hfg
        rw [h0]
        exact ⟨⟨fun h' => absurd h' (lt_irrefl _), fun h' => absurd h (ne_of_lt h')⟩,
          ⟨fun h' => absurd h' (lt_irrefl _), fun h' => absurd h.symm (ne_of_lt h')⟩⟩
      · have := hmono g hgC z hz hgP (by rw [hga]; exact h)
        rw [hfg] at this
        exact ⟨⟨fun h' => absurd this (not_lt.mpr h'.le), fun h' => absurd h (not_lt.mpr h'.le)⟩,
          ⟨fun _ => h, fun _ => this⟩⟩
    exact ⟨u, r, ρ / 2, hr, by positivity, huC, hu0,
      fun z hz => (hCball z hz).1, hsign⟩
  
  have sides : ∀ (C A B : Set E3), C ⊆ N → (∀ z ∈ C, z ∈ A → f z < 0) →
      (∀ z ∈ C, z ∈ B → 0 < f z) →
      volume ((C ∩ A) \ F) = 0 ∧ volume (C ∩ B ∩ F) = 0 := by
    intro C A B hCN hA hB
    constructor
    · refine measure_mono_null ?_ hneg
      rintro z ⟨⟨hzC, hzA⟩, hzF⟩
      exact ⟨⟨hCN hzC, hA z hzC hzA⟩, hzF⟩
    · refine measure_mono_null ?_ hpos
      rintro z ⟨⟨hzC, hzB⟩, hzF⟩
      exact ⟨⟨hCN hzC, hB z hzC hzB⟩, hzF⟩
  
  rcases lt_or_gt_of_ne ha with hlt | hgt
  · have hd : fderiv ℝ (fun z => -f z) y₀ (e a) = -(fderiv ℝ f y₀ (e a)) := by
      have hfn : (fun z => -f z) = -f := rfl
      rw [hfn, fderiv_neg]; rfl
    obtain ⟨u, r, δ, hr, hδ, huC, hu0, hCsub, hs⟩ :=
      key (fun z => -f z) hf.neg (by simp [hf0]) (by rw [hd]; linarith)
    refine ⟨a, u, r, δ, hr, hδ, huC, hu0, fun z hz => (hCsub hz).1, Or.inr ?_⟩
    refine sides _ _ _ (fun z hz => (hCsub hz).2) ?_ ?_
    · intro z hz hzA
      have h := (hs z hz).2.2 hzA
      simp only at h
      linarith
    · intro z hz hzB
      have h := (hs z hz).1.2 hzB
      simp only at h
      linarith
  · obtain ⟨u, r, δ, hr, hδ, huC, hu0, hCsub, hs⟩ := key f hf hf0 hgt
    refine ⟨a, u, r, δ, hr, hδ, huC, hu0, fun z hz => (hCsub hz).1, Or.inl ?_⟩
    refine sides _ _ _ (fun z hz => (hCsub hz).2) ?_ ?_
    · intro z hz hzA
      exact (hs z hz).1.2 hzA
    · intro z hz hzB
      exact (hs z hz).2.2 hzB

theorem sepFlat_to_graph (K : Set E3) (x ν : E3) (r : ℕ → ℝ) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (hx1 : ∀ N ∈ 𝓝 x, volume (N \ K) ≠ 0) (hx0 : ∀ N ∈ 𝓝 x, volume (N ∩ K) ≠ 0) (hν : ‖ν‖ = 1) (hr : ∀ k, 0 < r k) (hr0 : Tendsto r atTop (𝓝 0)) (hflat : Tendsto (fun k => volume (symmDiff {w : E3 | x + r k • w ∈ K} {w : E3 | @inner ℝ E3 _ ν w < 0} ∩ Metric.ball 0 1)) atTop (𝓝 0)) : ∃ (a : Fin 3) (u : E3 → ℝ) (ρ δ : ℝ), 0 < ρ ∧ 0 < δ ∧ ContDiff ℝ 1 u ∧ u (sepPlaneProj a x) = x a ∧ ((volume ((sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a} ∩ K) = 0) ∨ (volume ((sepCyl a x ρ δ ∩ {z | u (sepPlaneProj a z) < z a}) \ K) = 0 ∧ volume (sepCyl a x ρ δ ∩ {z | z a < u (sepPlaneProj a z)} ∩ K) = 0)) :=
by
  classical
  obtain ⟨-, hG', hsymm', hpd', hmin'⟩ :=
    sepAffinePullback (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ isOpen_univ hmin.1
      (fun i j => contDiffOn_const) (fun y i j => by simp [Matrix.one_apply, eq_comm])
      (fun y _ => Matrix.PosDef.one) x (ContinuousLinearEquiv.refl ℝ E3) 1 one_pos
  have hmin'' := hmin' hmin
  have hfd : ∀ z : E3, fderiv ℝ (fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) z =
      ((ContinuousLinearEquiv.refl ℝ E3 : E3 ≃L[ℝ] E3) : E3 →L[ℝ] E3) := by
    intro z
    rw [fderiv_const_add]
    exact (ContinuousLinearEquiv.refl ℝ E3).fderiv
  have hI : (fun z => (1 : ℝ) • pullbackMetric (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
      (fun w => x + (ContinuousLinearEquiv.refl ℝ E3) w) z) 0 = 1 := by
    ext i j
    simp only [one_smul]
    unfold pullbackMetric
    rw [hfd 0]
    simp [Matrix.one_apply, EuclideanSpace.single_apply]
    exact if_congr eq_comm rfl rfl
  have hU' : IsOpen ((fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) ⁻¹'
      (Set.univ : Set E3)) := by
    rw [Set.preimage_univ]; exact isOpen_univ
  have h0U' : (0 : E3) ∈ (fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) ⁻¹'
      (Set.univ : Set E3) := Set.mem_univ _
  obtain ⟨ε, r₀, hε, hr₀, hreg⟩ :=
    sepPerMin_flat_regular _ _ _ hU' h0U' hG' hsymm' hpd' hI hmin''
  have hev1 := (tendsto_order.1 hflat).2 (ENNReal.ofReal ε) (ENNReal.ofReal_pos.2 hε)
  have hev2 := (tendsto_order.1 hr0).2 r₀ hr₀
  obtain ⟨k, hk1, hk2⟩ := (hev1.and hev2).exists
  have hk1' : volume (symmDiff {z : E3 | r k • z ∈
      (fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) ⁻¹' K}
      {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1) ≤ ENNReal.ofReal ε := le_of_lt hk1
  obtain ⟨f, N, hf, hN, hfN, hneg, hpos⟩ := hreg (r k) ν (hr k) hk2 hν hk1'
  
  have hT : Continuous (fun y : E3 => y + -x) := continuous_id.add continuous_const
  have hTx : x + -x = 0 := add_neg_cancel x
  have hxy : ∀ y : E3, x + (y + -x) = y := fun y => by abel
  have hN' : (fun y : E3 => y + -x) ⁻¹' N ∈ 𝓝 x := by
    apply hT.continuousAt.preimage_mem_nhds
    show N ∈ 𝓝 (x + -x)
    rw [hTx]; exact hN
  have hgC : ContDiff ℝ 1 (fun y : E3 => f (y + -x)) := hf.comp (contDiff_id.add contDiff_const)
  have hneg' : volume (((fun y : E3 => y + -x) ⁻¹' N ∩ {y | (fun y : E3 => f (y + -x)) y < 0}) \ K)
      = 0 := by
    have h : volume ((fun y : E3 => y + -x) ⁻¹' ((N ∩ {z | f z < 0}) \
        ((fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) ⁻¹' K))) = 0 := by
      rw [measure_preimage_add_right]; exact hneg
    refine measure_mono_null ?_ h
    rintro y ⟨⟨hyN, hyg⟩, hyK⟩
    refine ⟨⟨hyN, hyg⟩, ?_⟩
    show ¬ (x + (y + -x) ∈ K)
    rw [hxy]; exact hyK
  have hpos' : volume ((fun y : E3 => y + -x) ⁻¹' N ∩ {y | 0 < (fun y : E3 => f (y + -x)) y} ∩ K)
      = 0 := by
    have h : volume ((fun y : E3 => y + -x) ⁻¹' (N ∩ {z | 0 < f z} ∩
        ((fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) ⁻¹' K))) = 0 := by
      rw [measure_preimage_add_right]; exact hpos
    refine measure_mono_null ?_ h
    rintro y ⟨⟨hyN, hyg⟩, hyK⟩
    refine ⟨⟨hyN, hyg⟩, ?_⟩
    show x + (y + -x) ∈ K
    rw [hxy]; exact hyK
  have hdg : fderiv ℝ (fun y : E3 => f (y + -x)) x ≠ 0 := by
    rw [fderiv_comp_add_right, hTx]
    exact hfN 0 (mem_of_mem_nhds hN)
  have hgc : Continuous (fun y : E3 => f (y + -x)) := hgC.continuous
  have hg0 : (fun y : E3 => f (y + -x)) x = 0 := by
    rcases lt_trichotomy ((fun y : E3 => f (y + -x)) x) 0 with hlt | heq | hgt
    · exfalso
      have hmem : (fun y : E3 => y + -x) ⁻¹' N ∩ {y | (fun y : E3 => f (y + -x)) y < 0} ∈ 𝓝 x :=
        Filter.inter_mem hN' ((isOpen_lt hgc continuous_const).mem_nhds hlt)
      exact hx1 _ hmem hneg'
    · exact heq
    · exfalso
      have hmem : (fun y : E3 => y + -x) ⁻¹' N ∩ {y | 0 < (fun y : E3 => f (y + -x)) y} ∈ 𝓝 x :=
        Filter.inter_mem hN' ((isOpen_lt continuous_const hgc).mem_nhds hgt)
      exact hx0 _ hmem hpos'
  obtain ⟨a, u, ρ, δ, hρ, hδ, hu, hu0, -, hside⟩ :=
    sepLevelset_to_coordGraph Set.univ K isOpen_univ x (Set.mem_univ x)
      (fun y : E3 => f (y + -x)) _ hgC hg0 hdg hN' hneg' hpos'
  exact ⟨a, u, ρ, δ, hρ, hδ, hu, hu0, hside⟩

theorem sepEuclCone_tangentCone (K : Set E3) (v x : E3) (hmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ) (hcone : ∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ K} K) = 0) (hv : ∀ s : ℝ, volume (symmDiff {z : E3 | z + s • v ∈ K} K) = 0) (hx1 : ∀ N ∈ 𝓝 x, volume (N \ K) ≠ 0) (hx0 : ∀ N ∈ 𝓝 x, volume (N ∩ K) ≠ 0) : ∃ (r : ℕ → ℝ) (L : Set E3), (∀ k, 0 < r k) ∧ Tendsto r atTop (𝓝 0) ∧ (∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff {w : E3 | x + r k • w ∈ K} L ∩ Metric.ball 0 ρ)) atTop (𝓝 0)) ∧ sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) L Set.univ ∧ (∀ N ∈ 𝓝 (0:E3), volume (N \ L) ≠ 0) ∧ (∀ N ∈ 𝓝 (0:E3), volume (N ∩ L) ≠ 0) ∧ (∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ L} L) = 0) ∧ (∀ s : ℝ, volume (symmDiff {z : E3 | z + s • x ∈ L} L) = 0) ∧ (∀ s : ℝ, volume (symmDiff {z : E3 | z + s • v ∈ L} L) = 0) :=
by
  classical
  
  have hG1 : ∀ (S : Set E3) (i j : Fin 3), ContDiffOn ℝ ∞
      (fun y : E3 => (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j) S :=
    fun S i j => contDiffOn_const
  have hsymm1 : ∀ (y : E3) (i j : Fin 3), (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j =
      (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j i := by
    intro y i j
    by_cases h : i = j
    · subst h; rfl
    · exact (Matrix.one_apply_ne h).trans (Matrix.one_apply_ne (Ne.symm h)).symm
  have hpd1 : ∀ y ∈ (Set.univ : Set E3),
      ((fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y).PosDef :=
    fun y _ => Matrix.PosDef.one
  
  have hmetric : (fun z : E3 => (1 : ℝ) • pullbackMetric (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ))
      (fun w => x + (ContinuousLinearEquiv.refl ℝ E3) w) z) =
      fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
    funext z
    have hfd : fderiv ℝ (fun w : E3 => x + (ContinuousLinearEquiv.refl ℝ E3) w) z =
        ContinuousLinearMap.id ℝ E3 :=
      ((hasFDerivAt_id z).const_add x).fderiv
    ext a b
    simp only [one_smul, pullbackMetric, hfd, ContinuousLinearMap.id_apply]
    fin_cases a <;> fin_cases b <;>
      simp [Fin.sum_univ_three, Matrix.one_apply, EuclideanSpace.single_apply]
  have hminF : sepIsPerMin (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {w : E3 | x + w ∈ K}
      Set.univ := by
    have h := (sepAffinePullback (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ
      isOpen_univ hmin.1 (hG1 Set.univ) hsymm1 hpd1 x (ContinuousLinearEquiv.refl ℝ E3) 1
      one_pos).2.2.2.2 hmin
    rw [hmetric, Set.preimage_univ] at h
    exact h
  have hN0 : ∀ N ∈ 𝓝 (0:E3), {y : E3 | y - x ∈ N} ∈ 𝓝 x := by
    intro N hN
    apply (continuous_sub_right x).continuousAt.preimage_mem_nhds
    show N ∈ 𝓝 (x - x)
    rw [sub_self]
    exact hN
  have h1F : ∀ N ∈ 𝓝 (0:E3), volume (N \ {w : E3 | x + w ∈ K}) ≠ 0 := by
    intro N hN
    have e : N \ {w : E3 | x + w ∈ K} =
        (fun h : E3 => x + h) ⁻¹' ({y : E3 | y - x ∈ N} \ K) := by
      ext w
      simp only [Set.mem_diff, Set.mem_preimage, Set.mem_setOf_eq, add_sub_cancel_left]
    rw [e, measure_preimage_add]
    exact hx1 _ (hN0 N hN)
  have h0F : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ {w : E3 | x + w ∈ K}) ≠ 0 := by
    intro N hN
    have e : N ∩ {w : E3 | x + w ∈ K} =
        (fun h : E3 => x + h) ⁻¹' ({y : E3 | y - x ∈ N} ∩ K) := by
      ext w
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, add_sub_cancel_left]
    rw [e, measure_preimage_add]
    exact hx0 _ (hN0 N hN)
  
  obtain ⟨r₀, hr₀⟩ : ∃ r₀ : ℕ → ℝ, ∀ k, r₀ k = 1 / ((k : ℝ) + 2) := ⟨_, fun k => rfl⟩
  obtain ⟨R, hR⟩ : ∃ R : ℕ → ℝ, ∀ k, R k = (k : ℝ) + 2 := ⟨_, fun k => rfl⟩
  have hk2 : ∀ k : ℕ, (0 : ℝ) < (k : ℝ) + 2 := fun k => by positivity
  have hr₀pos : ∀ k, 0 < r₀ k := fun k => by rw [hr₀]; exact div_pos one_pos (hk2 k)
  have h2 : Tendsto (fun k : ℕ => (k : ℝ) + 2) atTop atTop :=
    tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop
  have hr₀t : Tendsto r₀ atTop (𝓝 0) := by
    have e : r₀ = fun k : ℕ => 1 / ((k : ℝ) + 2) := funext hr₀
    rw [e]
    exact Tendsto.div_atTop tendsto_const_nhds h2
  have hRt : Tendsto R atTop atTop := by
    have e : R = fun k : ℕ => (k : ℝ) + 2 := funext hR
    rw [e]
    exact h2
  have hmink : ∀ k, sepIsPerMin (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ))
      {z : E3 | r₀ k • z ∈ {w : E3 | x + w ∈ K}} (Metric.ball 0 (R k)) := by
    intro k
    have h := (sepRescale (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {w : E3 | x + w ∈ K}
      Set.univ isOpen_univ (hG1 Set.univ) hsymm1 hpd1 hminF (r₀ k) (hr₀pos k)).1
    exact ⟨h.1, fun V hV hc _ => h.2.1 V hV hc (fun z _ => Set.mem_univ _),
      fun F' V K' hF' hV hc _ hK hKV hsd =>
        h.2.2 F' V K' hF' hV hc (fun z _ => Set.mem_univ _) hK hKV hsd⟩
  have hnhds : ∀ k, ∀ N ∈ 𝓝 (0:E3), (fun z : E3 => (r₀ k)⁻¹ • z) ⁻¹' N ∈ 𝓝 (0:E3) := by
    intro k N hN
    apply (continuous_const_smul (r₀ k)⁻¹).continuousAt.preimage_mem_nhds
    show N ∈ 𝓝 ((r₀ k)⁻¹ • (0:E3))
    rw [smul_zero]
    exact hN
  have hpre0 : ∀ c : ℝ, c ≠ 0 → ∀ S : Set E3, volume S = 0 →
      volume ((fun z : E3 => c • z) ⁻¹' S) = 0 := by
    intro c hc S hS
    rw [Measure.addHaar_preimage_smul volume hc, hS, mul_zero]
  have h1k : ∀ k, ∀ N ∈ 𝓝 (0:E3),
      volume (N \ {z : E3 | r₀ k • z ∈ {w : E3 | x + w ∈ K}}) ≠ 0 := by
    intro k N hN hzero
    apply h1F _ (hnhds k N hN)
    have h := hpre0 (r₀ k)⁻¹ (inv_ne_zero (hr₀pos k).ne') _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro z ⟨hzN, hzF⟩
    refine ⟨hzN, ?_⟩
    show ¬ (r₀ k • (r₀ k)⁻¹ • z ∈ {w : E3 | x + w ∈ K})
    rw [smul_inv_smul₀ (hr₀pos k).ne']
    exact hzF
  have h0k : ∀ k, ∀ N ∈ 𝓝 (0:E3),
      volume (N ∩ {z : E3 | r₀ k • z ∈ {w : E3 | x + w ∈ K}}) ≠ 0 := by
    intro k N hN hzero
    apply h0F _ (hnhds k N hN)
    have h := hpre0 (r₀ k)⁻¹ (inv_ne_zero (hr₀pos k).ne') _ hzero
    refine le_antisymm (le_trans (measure_mono ?_) h.le) (zero_le _)
    rintro z ⟨hzN, hzF⟩
    refine ⟨hzN, ?_⟩
    show r₀ k • (r₀ k)⁻¹ • z ∈ {w : E3 | x + w ∈ K}
    rw [smul_inv_smul₀ (hr₀pos k).ne']
    exact hzF
  have hconv0 : ∀ ρ : ℝ, 0 < ρ → ∀ ε : ℝ, 0 < ε → ∀ᶠ k in atTop,
      ∀ y ∈ Metric.ball (0:E3) ρ, ∀ i j : Fin 3,
        |(fun (_ : ℕ) (_ : E3) => (1 : Matrix (Fin 3) (Fin 3) ℝ)) k y i j -
          (if i = j then (1:ℝ) else 0)| ≤ ε := by
    intro ρ _ ε hε
    exact Filter.Eventually.of_forall fun k y _ i j => by
      simp only [Matrix.one_apply, sub_self, abs_zero]
      exact hε.le
  obtain ⟨ψ, L, hψ, hC1, hLmin, hL1, hL0, hC4⟩ := sepPerMin_blowup_compact
    (fun (_ : ℕ) (_ : E3) => (1 : Matrix (Fin 3) (Fin 3) ℝ))
    (fun k => {z : E3 | r₀ k • z ∈ {w : E3 | x + w ∈ K}}) R hRt
    (fun k i j => contDiffOn_const) (fun k y i j => hsymm1 y i j)
    (fun k y _ => Matrix.PosDef.one) hconv0 hmink h1k h0k
  obtain ⟨Λ, r₁, hr₁, hfin, hmono⟩ := sepPerMin_monotonicity
    (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {w : E3 | x + w ∈ K} Set.univ isOpen_univ
    (Set.mem_univ 0) (hG1 Set.univ) hsymm1 hpd1 rfl hminF
  obtain ⟨Θ₀, hΘ₀, hlim⟩ := sepDensityRatio_limit
    (fun t => sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {w : E3 | x + w ∈ K}
      (Metric.ball 0 t)) Λ r₁ hr₁ hfin hmono
  have hrψ : Tendsto (fun k => r₀ (ψ k)) atTop (𝓝 0) := hr₀t.comp hψ.tendsto_atTop
  have hseq : ∀ ρ' : ℝ, 0 < ρ' → Tendsto (fun k => sepPerG
      (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {z : E3 | r₀ (ψ k) • z ∈ {w : E3 | x + w ∈ K}}
      (Metric.ball 0 ρ')) atTop (𝓝 (ENNReal.ofReal (Θ₀ * ρ' ^ 2))) := by
    intro ρ' hρ'
    have h := hlim (fun k => r₀ (ψ k)) (fun k => hr₀pos _) hrψ ρ' hρ'
    refine Tendsto.congr (fun k => ?_) h
    exact ((sepRescale (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {w : E3 | x + w ∈ K}
      Set.univ isOpen_univ (hG1 Set.univ) hsymm1 hpd1 hminF (r₀ (ψ k)) (hr₀pos _)).2
      ρ' hρ').symm
  have hae : ∀ᵐ ρ' ∂(volume : Measure ℝ), 0 < ρ' →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) L (Metric.ball 0 ρ') =
        ENNReal.ofReal (Θ₀ * ρ' ^ 2) := by
    filter_upwards [hC4] with ρ' hρ' hpos
    exact tendsto_nhds_unique (hρ' hpos) (hseq ρ' hpos)
  have hall := sepPerG_ball_eq_of_ae L Θ₀ hΘ₀ hae
  have hconeL := sepEuclMin_cone_of_const_density L hLmin Θ₀ hall
  
  have hnull : ∀ (c : ℝ) (y₀ : E3) (S : Set E3), c ≠ 0 → volume S = 0 →
      volume ((fun z : E3 => y₀ + c • z) ⁻¹' S) = 0 := by
    intro c y₀ S hc hS
    have e1 : (fun z : E3 => y₀ + c • z) ⁻¹' S =
        (fun z : E3 => c • z) ⁻¹' ((fun h : E3 => y₀ + h) ⁻¹' S) := rfl
    rw [e1, Measure.addHaar_preimage_smul volume hc, measure_preimage_add, hS, mul_zero]
  have hvshift : ∀ (ρr s : ℝ), 0 < ρr →
      volume (symmDiff {z : E3 | z + s • v ∈ {w : E3 | x + ρr • w ∈ K}}
        {w : E3 | x + ρr • w ∈ K}) = 0 := by
    intro ρr s hρr
    have e : symmDiff {z : E3 | z + s • v ∈ {w : E3 | x + ρr • w ∈ K}}
        {w : E3 | x + ρr • w ∈ K} =
        (fun z : E3 => x + ρr • z) ⁻¹' symmDiff {y : E3 | y + (ρr * s) • v ∈ K} K := by
      ext z
      have hid : x + ρr • (z + s • v) = x + ρr • z + (ρr * s) • v := by
        rw [smul_add, smul_smul, add_assoc]
      simp only [Set.mem_symmDiff, Set.mem_setOf_eq, Set.mem_preimage, hid]
    rw [e]
    exact hnull ρr x _ hρr.ne' (hv _)
  have hxshift : ∀ (ρr s : ℝ), 0 < ρr → 0 < 1 + ρr * s →
      volume (symmDiff {z : E3 | z + s • x ∈ {w : E3 | x + ρr • w ∈ K}}
        {z : E3 | (1 + ρr * s)⁻¹ • z ∈ {w : E3 | x + ρr • w ∈ K}}) = 0 := by
    intro ρr s hρr hlam
    have hμ : ρr * (1 + ρr * s)⁻¹ ≠ 0 := mul_ne_zero hρr.ne' (inv_ne_zero hlam.ne')
    have hlm : (1 + ρr * s) * (ρr * (1 + ρr * s)⁻¹) = ρr := by
      field_simp
    have e : symmDiff {z : E3 | z + s • x ∈ {w : E3 | x + ρr • w ∈ K}}
        {z : E3 | (1 + ρr * s)⁻¹ • z ∈ {w : E3 | x + ρr • w ∈ K}} =
        (fun z : E3 => x + (ρr * (1 + ρr * s)⁻¹) • z) ⁻¹'
          symmDiff {y : E3 | (1 + ρr * s) • y ∈ K} K := by
      ext z
      have hid1 : x + ρr • (z + s • x) =
          (1 + ρr * s) • (x + (ρr * (1 + ρr * s)⁻¹) • z) := by
        rw [smul_add (1 + ρr * s), smul_smul, hlm, add_smul, one_smul, smul_add, smul_smul]
        abel
      have hid2 : x + ρr • ((1 + ρr * s)⁻¹ • z) = x + (ρr * (1 + ρr * s)⁻¹) • z := by
        rw [smul_smul]
      simp only [Set.mem_symmDiff, Set.mem_setOf_eq, Set.mem_preimage, hid1, hid2]
    rw [e]
    exact hnull _ x _ hμ (hcone _ hlam)
  have hshift : ∀ (A B : ℕ → Set E3) (L' M' : Set E3) (w : E3),
      (∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (A k) L' ∩ Metric.ball 0 ρ))
        atTop (𝓝 0)) →
      (∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (B k) M' ∩ Metric.ball 0 ρ))
        atTop (𝓝 0)) →
      (∀ᶠ k in atTop, volume (symmDiff {z : E3 | z + w ∈ A k} (B k)) = 0) →
      volume (symmDiff {z : E3 | z + w ∈ L'} M') = 0 := by
    intro A B L' M' w hA hB hAB
    have hball : ∀ ρ : ℝ, 0 < ρ →
        volume (symmDiff {z : E3 | z + w ∈ L'} M' ∩ Metric.ball 0 ρ) = 0 := by
      intro ρ hρ
      have hρ' : 0 < ρ + ‖w‖ := by positivity
      have hle : ∀ᶠ k in atTop, volume (symmDiff {z : E3 | z + w ∈ L'} M' ∩ Metric.ball 0 ρ) ≤
          volume (symmDiff (A k) L' ∩ Metric.ball 0 (ρ + ‖w‖)) +
            volume (symmDiff (B k) M' ∩ Metric.ball 0 ρ) := by
        filter_upwards [hAB] with k hk
        calc volume (symmDiff {z : E3 | z + w ∈ L'} M' ∩ Metric.ball 0 ρ)
            ≤ volume ((fun z : E3 => z + w) ⁻¹' (symmDiff (A k) L' ∩ Metric.ball 0 (ρ + ‖w‖)) ∪
                symmDiff {z : E3 | z + w ∈ A k} (B k) ∪
                (symmDiff (B k) M' ∩ Metric.ball 0 ρ)) := by
              apply measure_mono
              rintro z ⟨hz, hzb⟩
              rw [mem_ball_zero_iff] at hzb
              have hzb' : ‖z + w‖ < ρ + ‖w‖ := by
                have := norm_add_le z w
                linarith
              simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff,
                Set.mem_setOf_eq, mem_ball_zero_iff] at hz ⊢
              tauto
          _ ≤ volume ((fun z : E3 => z + w) ⁻¹' (symmDiff (A k) L' ∩ Metric.ball 0 (ρ + ‖w‖))) +
                volume (symmDiff {z : E3 | z + w ∈ A k} (B k)) +
                volume (symmDiff (B k) M' ∩ Metric.ball 0 ρ) :=
              (measure_union_le _ _).trans (add_le_add (measure_union_le _ _) le_rfl)
          _ = volume (symmDiff (A k) L' ∩ Metric.ball 0 (ρ + ‖w‖)) +
                volume (symmDiff (B k) M' ∩ Metric.ball 0 ρ) := by
              rw [measure_preimage_add_right, hk, add_zero]
      have htend : Tendsto (fun k => volume (symmDiff (A k) L' ∩ Metric.ball 0 (ρ + ‖w‖)) +
          volume (symmDiff (B k) M' ∩ Metric.ball 0 ρ)) atTop (𝓝 0) := by
        have h := (hA _ hρ').add (hB _ hρ)
        rwa [add_zero] at h
      exact le_antisymm (ge_of_tendsto htend hle) (zero_le _)
    have hcover : symmDiff {z : E3 | z + w ∈ L'} M' ⊆
        ⋃ n : ℕ, (symmDiff {z : E3 | z + w ∈ L'} M' ∩ Metric.ball 0 ((n : ℝ) + 1)) := by
      intro z hz
      obtain ⟨n, hn⟩ := exists_nat_gt ‖z‖
      refine Set.mem_iUnion.2 ⟨n, hz, ?_⟩
      rw [mem_ball_zero_iff]
      linarith
    exact measure_mono_null hcover (measure_iUnion_null fun n => hball _ (by positivity))
  have hdil : ∀ (A : ℕ → Set E3) (L' : Set E3) (c : ℕ → ℝ),
      (∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (A k) L' ∩ Metric.ball 0 ρ))
        atTop (𝓝 0)) →
      Tendsto c atTop (𝓝 1) →
      (∀ t : ℝ, 0 < t → volume (symmDiff {z : E3 | t • z ∈ L'} L') = 0) →
      ∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff {z : E3 | c k • z ∈ A k} L' ∩
        Metric.ball 0 ρ)) atTop (𝓝 0) := by
    intro A L' c hA hc hcL ρ hρ
    have hev : ∀ᶠ k in atTop, c k ∈ Set.Ioo (1/2 : ℝ) 2 :=
      hc (Ioo_mem_nhds (by norm_num) (by norm_num))
    have hbound : ∀ᶠ k in atTop,
        volume (symmDiff {z : E3 | c k • z ∈ A k} L' ∩ Metric.ball 0 ρ) ≤
          ENNReal.ofReal 8 * volume (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ)) := by
      filter_upwards [hev] with k hk
      obtain ⟨hk1, hk2⟩ := hk
      have ht : 0 < c k := by linarith
      have h3 : (1 / 8 : ℝ) ≤ c k ^ 3 := by
        calc (1 / 8 : ℝ) = (1 / 2) ^ 3 := by norm_num
          _ ≤ c k ^ 3 := by gcongr
      have hfac : ENNReal.ofReal |(c k ^ Module.finrank ℝ E3)⁻¹| ≤ ENNReal.ofReal 8 := by
        apply ENNReal.ofReal_le_ofReal
        rw [finrank_euclideanSpace_fin, abs_of_pos (by positivity)]
        have h4 : 1 / c k ^ 3 ≤ 1 / (1 / 8 : ℝ) := one_div_le_one_div_of_le (by norm_num) h3
        rw [one_div] at h4
        have h5 : (1 / (1 / 8 : ℝ)) = 8 := by norm_num
        linarith
      calc volume (symmDiff {z : E3 | c k • z ∈ A k} L' ∩ Metric.ball 0 ρ)
          ≤ volume ((fun z : E3 => c k • z) ⁻¹' (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ)) ∪
              symmDiff {z : E3 | c k • z ∈ L'} L') := by
            apply measure_mono
            rintro z ⟨hz, hzb⟩
            rw [mem_ball_zero_iff] at hzb
            have hzb' : ‖c k • z‖ < 2 * ρ := by
              rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht]
              nlinarith [norm_nonneg z]
            simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff,
              Set.mem_setOf_eq, mem_ball_zero_iff] at hz ⊢
            tauto
        _ ≤ volume ((fun z : E3 => c k • z) ⁻¹' (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ))) +
              volume (symmDiff {z : E3 | c k • z ∈ L'} L') := measure_union_le _ _
        _ = ENNReal.ofReal |(c k ^ Module.finrank ℝ E3)⁻¹| *
              volume (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ)) := by
            rw [hcL _ ht, add_zero, Measure.addHaar_preimage_smul volume ht.ne']
        _ ≤ ENNReal.ofReal 8 * volume (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ)) :=
            mul_le_mul_right' hfac _
    have hup : Tendsto (fun k => ENNReal.ofReal 8 *
        volume (symmDiff (A k) L' ∩ Metric.ball 0 (2 * ρ))) atTop (𝓝 0) := by
      have h := ENNReal.Tendsto.const_mul (hA (2 * ρ) (by linarith))
        (Or.inr (ENNReal.ofReal_ne_top (r := 8)))
      rwa [mul_zero] at h
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hup
      (Filter.Eventually.of_forall fun k => zero_le _) hbound
  
  refine ⟨fun k => r₀ (ψ k), L, fun k => hr₀pos _, hrψ, hC1, hLmin, hL1, hL0, hconeL, ?_, ?_⟩
  · intro s
    have hlam : Tendsto (fun k => 1 + r₀ (ψ k) * s) atTop (𝓝 1) := by
      have h := (tendsto_const_nhds : Tendsto (fun _ : ℕ => (1:ℝ)) atTop (𝓝 1)).add
        (hrψ.mul_const s)
      rw [zero_mul, add_zero] at h
      exact h
    have hc : Tendsto (fun k => (1 + r₀ (ψ k) * s)⁻¹) atTop (𝓝 1) := by
      have h := hlam.inv₀ one_ne_zero
      rw [inv_one] at h
      exact h
    have hpos : ∀ᶠ k in atTop, 0 < 1 + r₀ (ψ k) * s := hlam.eventually (lt_mem_nhds one_pos)
    have hB := hdil (fun k => {w : E3 | x + r₀ (ψ k) • w ∈ K}) L
      (fun k => (1 + r₀ (ψ k) * s)⁻¹) hC1 hc hconeL
    exact hshift (fun k => {w : E3 | x + r₀ (ψ k) • w ∈ K})
      (fun k => {z : E3 | (1 + r₀ (ψ k) * s)⁻¹ • z ∈ {w : E3 | x + r₀ (ψ k) • w ∈ K}})
      L L (s • x) hC1 hB (hpos.mono fun k hk => hxshift (r₀ (ψ k)) s (hr₀pos _) hk)
  · intro s
    exact hshift (fun k => {w : E3 | x + r₀ (ψ k) • w ∈ K})
      (fun k => {w : E3 | x + r₀ (ψ k) • w ∈ K}) L L (s • v) hC1 hC1
      (Filter.Eventually.of_forall fun k => hvshift (r₀ (ψ k)) s (hr₀pos _))

theorem sepTwoDir_cone_halfspace (L : Set E3) (a b : E3) (hab : LinearIndependent ℝ ![a, b]) (hdil : ∀ t : ℝ, 0 < t → ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (t • z), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (hta : ∀ s : ℝ, ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (z + s • a), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (htb : ∀ s : ℝ, ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (z + s • b), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (hnull : volume {z : E3 | ∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0} = 0) (h1 : ∀ N ∈ 𝓝 (0:E3), volume (N \ L) ≠ 0) (h0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ L) ≠ 0) : ∃ ν : E3, ‖ν‖ = 1 ∧ volume (symmDiff L {z : E3 | @inner ℝ E3 _ ν z < 0}) = 0 :=
by
  classical
  
  obtain ⟨n, hn, hdec⟩ : ∃ n : E3, ‖n‖ = 1 ∧
      ∀ z : E3, ∃ α β : ℝ, z = α • a + β • b + (@inner ℝ E3 _ n z) • n := by
    have hKr : Module.finrank ℝ (Submodule.span ℝ {a, b} : Submodule ℝ E3) = 2 := by
      have h := finrank_span_eq_card hab
      rw [Matrix.range_cons_cons_empty] at h
      simpa using h
    have hE : Module.finrank ℝ E3 = 3 := finrank_euclideanSpace_fin
    have hKo : Module.finrank ℝ (Submodule.span ℝ {a, b} : Submodule ℝ E3)ᗮ = 1 := by
      have h := Submodule.finrank_add_finrank_orthogonal (Submodule.span ℝ {a, b} : Submodule ℝ E3)
      omega
    have hne : (Submodule.span ℝ {a, b} : Submodule ℝ E3)ᗮ ≠ ⊥ := by
      intro h
      rw [h, finrank_bot] at hKo
      exact zero_ne_one hKo
    obtain ⟨m, hmK, hm0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    have hn1 : ‖(‖m‖⁻¹ : ℝ) • m‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hm0)]
    have hnK : (‖m‖⁻¹ : ℝ) • m ∈ (Submodule.span ℝ {a, b} : Submodule ℝ E3)ᗮ :=
      Submodule.smul_mem _ _ hmK
    have hn0 : (‖m‖⁻¹ : ℝ) • m ≠ 0 := by
      intro h
      rw [h, norm_zero] at hn1
      exact zero_ne_one hn1
    have hspan : (Submodule.span ℝ {a, b} : Submodule ℝ E3)ᗮ = ℝ ∙ ((‖m‖⁻¹ : ℝ) • m) := by
      symm
      apply Submodule.eq_of_le_of_finrank_eq
      · rw [Submodule.span_singleton_le_iff_mem]
        exact hnK
      · rw [finrank_span_singleton hn0, hKo]
    refine ⟨(‖m‖⁻¹ : ℝ) • m, hn1, fun z => ?_⟩
    obtain ⟨y, hy, w, hw, hz⟩ :=
      Submodule.exists_add_mem_mem_orthogonal (K := (Submodule.span ℝ {a, b} : Submodule ℝ E3)) z
    rw [hspan] at hw
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hw
    have hny : @inner ℝ E3 _ ((‖m‖⁻¹ : ℝ) • m) y = 0 :=
      Submodule.inner_left_of_mem_orthogonal hy hnK
    have hc : @inner ℝ E3 _ ((‖m‖⁻¹ : ℝ) • m) z = c := by
      rw [hz, inner_add_right, hny, real_inner_smul_right, real_inner_self_eq_norm_sq, hn1]
      ring
    obtain ⟨α, β, hαβ⟩ := Submodule.mem_span_pair.1 hy
    refine ⟨α, β, ?_⟩
    rw [hc, hαβ]
    exact hz
  
  have hB0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0 :=
    fun N hN => ⟨h0 N hN, h1 N hN⟩
  have hBn : ∀ c : ℝ, c ≠ 0 →
      (∀ N ∈ 𝓝 (c • n), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → False := by
    intro c hc hcn
    have hsub : {w : E3 | 0 < c * @inner ℝ E3 _ n w} ⊆
        {z : E3 | ∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0} := by
      intro w hw
      have hw' : 0 < c * @inner ℝ E3 _ n w := hw
      obtain ⟨α, β, hαβ⟩ := hdec w
      generalize hc' : @inner ℝ E3 _ n w = c' at hw' hαβ
      subst hαβ
      have ht : 0 < c' / c := by
        have e : c' / c = (c * c') / (c * c) := by field_simp
        rw [e]
        exact div_pos hw' (mul_self_pos.2 hc)
      have h1' := hdil (c' / c) ht (c • n) hcn
      rw [smul_smul, div_mul_cancel₀ c' hc] at h1'
      have h3' := htb β _ (hta α _ h1')
      have heq : c' • n + α • a + β • b = α • a + β • b + c' • n := by abel
      rw [heq] at h3'
      exact h3'
    have hSo : IsOpen {w : E3 | 0 < c * @inner ℝ E3 _ n w} :=
      isOpen_lt continuous_const (continuous_const.mul (continuous_const.inner continuous_id))
    have hmem : c • n ∈ {w : E3 | 0 < c * @inner ℝ E3 _ n w} := by
      show 0 < c * @inner ℝ E3 _ n (c • n)
      rw [real_inner_smul_right, real_inner_self_eq_norm_sq, hn]
      have := mul_self_pos.2 hc
      nlinarith
    have hpos := hSo.measure_pos volume ⟨c • n, hmem⟩
    exact hpos.ne' (measure_mono_null hsub hnull)
  have hB : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) ↔
      @inner ℝ E3 _ n z = 0 := by
    intro z
    obtain ⟨α, β, hαβ⟩ := hdec z
    constructor
    · intro hz
      by_contra hc
      generalize hc' : @inner ℝ E3 _ n z = c at hαβ hc
      subst hαβ
      have h2 := htb (-β) _ (hta (-α) _ hz)
      have heq : α • a + β • b + c • n + (-α) • a + (-β) • b = c • n := by
        simp only [neg_smul]
        abel
      rw [heq] at h2
      exact hBn c hc h2
    · intro hz
      rw [hz, zero_smul, add_zero] at hαβ
      have h2 := htb β _ (hta α _ hB0)
      rw [zero_add, ← hαβ] at h2
      exact h2
  
  have hU1o : IsOpen {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0} := by
    rw [isOpen_iff_mem_nhds]
    rintro z ⟨N, hN, hN0⟩
    obtain ⟨V, hVN, hVo, hzV⟩ := _root_.mem_nhds_iff.1 hN
    exact Filter.mem_of_superset (hVo.mem_nhds hzV)
      (fun w hw => ⟨N, Filter.mem_of_superset (hVo.mem_nhds hw) hVN, hN0⟩)
  have hU2o : IsOpen {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ L) = 0} := by
    rw [isOpen_iff_mem_nhds]
    rintro z ⟨N, hN, hN0⟩
    obtain ⟨V, hVN, hVo, hzV⟩ := _root_.mem_nhds_iff.1 hN
    exact Filter.mem_of_superset (hVo.mem_nhds hzV)
      (fun w hw => ⟨N, Filter.mem_of_superset (hVo.mem_nhds hw) hVN, hN0⟩)
  have hdisj : Disjoint {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0}
      {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ L) = 0} := by
    rw [Set.disjoint_left]
    rintro z ⟨N₁, hN₁, h₁⟩ ⟨N₂, hN₂, h₂⟩
    have hN : N₁ ∩ N₂ ∈ 𝓝 z := Filter.inter_mem hN₁ hN₂
    have hpos : 0 < volume (N₁ ∩ N₂) :=
      Measure.measure_pos_of_nonempty_interior volume ⟨z, mem_interior_iff_mem_nhds.2 hN⟩
    have hzero : volume (N₁ ∩ N₂) = 0 := by
      refine measure_mono_null ?_ (measure_union_null h₁ h₂)
      intro x hx
      by_cases hxL : x ∈ L
      · exact Or.inl ⟨hx.1, hxL⟩
      · exact Or.inr ⟨hx.2, hxL⟩
    exact hpos.ne' hzero
  have hconst : ∀ H : Set E3, IsPreconnected H →
      (∀ z ∈ H, ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0 ∨ volume (N \ L) = 0) →
      volume (H ∩ L) = 0 ∨ volume (H \ L) = 0 := by
    intro H hH hloc
    have hcov : H ⊆ {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0} ∪
        {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ L) = 0} := by
      intro z hz
      obtain ⟨N, hN, h | h⟩ := hloc z hz
      · exact Or.inl ⟨N, hN, h⟩
      · exact Or.inr ⟨N, hN, h⟩
    rcases IsPreconnected.subset_or_subset hU1o hU2o hdisj hcov hH with hsub | hsub
    · left
      apply measure_null_of_locally_null
      intro x hx
      obtain ⟨N, hN, hN0⟩ := hsub hx.1
      have hsN : (H ∩ L) ∩ N ⊆ N ∩ L := fun y hy => ⟨hy.2, hy.1.2⟩
      exact ⟨(H ∩ L) ∩ N, inter_mem_nhdsWithin _ hN, measure_mono_null hsN hN0⟩
    · right
      apply measure_null_of_locally_null
      intro x hx
      obtain ⟨N, hN, hN0⟩ := hsub hx.1
      have hsN : (H \ L) ∩ N ⊆ N \ L := fun y hy => ⟨hy.2, hy.1.2⟩
      exact ⟨(H \ L) ∩ N, inter_mem_nhdsWithin _ hN, measure_mono_null hsN hN0⟩
  
  have hP : volume {z : E3 | @inner ℝ E3 _ n z = 0} = 0 :=
    measure_mono_null (fun z hz => (hB z).2 hz) hnull
  have hlin : IsLinearMap ℝ (fun z : E3 => @inner ℝ E3 _ n z) :=
    ⟨fun x y => inner_add_right n x y, fun c x => real_inner_smul_right n x c⟩
  have hHp : IsPreconnected {z : E3 | 0 < @inner ℝ E3 _ n z} :=
    (convex_halfSpace_gt hlin 0).isPreconnected
  have hHm : IsPreconnected {z : E3 | @inner ℝ E3 _ n z < 0} :=
    (convex_halfSpace_lt hlin 0).isPreconnected
  have hlocH : ∀ z : E3, @inner ℝ E3 _ n z ≠ 0 →
      ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0 ∨ volume (N \ L) = 0 := by
    intro z hz
    by_contra hne
    push_neg at hne
    exact hz ((hB z).1 hne)
  have hp := hconst _ hHp (fun z hz => hlocH z (ne_of_gt hz))
  have hm := hconst _ hHm (fun z hz => hlocH z (ne_of_lt hz))
  have hU1 := h1 Set.univ Filter.univ_mem
  have hU0 := h0 Set.univ Filter.univ_mem
  
  rcases hp with hp | hp <;> rcases hm with hm | hm
  · exfalso
    apply hU0
    refine measure_mono_null ?_ (measure_union_null (measure_union_null hp hm) hP)
    intro z hz
    rcases lt_trichotomy 0 (@inner ℝ E3 _ n z) with h | h | h
    · exact Or.inl (Or.inl ⟨h, hz.2⟩)
    · exact Or.inr h.symm
    · exact Or.inl (Or.inr ⟨h, hz.2⟩)
  · refine ⟨n, hn, ?_⟩
    refine measure_mono_null ?_ (measure_union_null (measure_union_null hp hm) hP)
    intro z hz
    rcases Set.mem_symmDiff.1 hz with ⟨hzL, hzH⟩ | ⟨hzH, hzL⟩
    · rcases lt_trichotomy 0 (@inner ℝ E3 _ n z) with h | h | h
      · exact Or.inl (Or.inl ⟨h, hzL⟩)
      · exact Or.inr h.symm
      · exact absurd h hzH
    · exact Or.inl (Or.inr ⟨hzH, hzL⟩)
  · refine ⟨-n, by rw [norm_neg, hn], ?_⟩
    have hset : {z : E3 | @inner ℝ E3 _ (-n) z < 0} = {z : E3 | 0 < @inner ℝ E3 _ n z} := by
      ext z
      simp only [Set.mem_setOf_eq, inner_neg_left, neg_lt_zero]
    rw [hset]
    refine measure_mono_null ?_ (measure_union_null (measure_union_null hp hm) hP)
    intro z hz
    rcases Set.mem_symmDiff.1 hz with ⟨hzL, hzH⟩ | ⟨hzH, hzL⟩
    · rcases lt_trichotomy 0 (@inner ℝ E3 _ n z) with h | h | h
      · exact absurd h hzH
      · exact Or.inr h.symm
      · exact Or.inl (Or.inr ⟨h, hzL⟩)
    · exact Or.inl (Or.inl ⟨hzH, hzL⟩)
  · exfalso
    apply hU1
    refine measure_mono_null ?_ (measure_union_null (measure_union_null hp hm) hP)
    intro z hz
    rcases lt_trichotomy 0 (@inner ℝ E3 _ n z) with h | h | h
    · exact Or.inl (Or.inl ⟨h, hz.2⟩)
    · exact Or.inr h.symm
    · exact Or.inl (Or.inr ⟨h, hz.2⟩)

theorem sepCylCone_finite_rays (L : Set E3) (e : E3) (he : ‖e‖ = 1) (hdil : ∀ t : ℝ, 0 < t → ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (t • z), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (htr : ∀ s : ℝ, ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (z + s • e), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (hreg : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → z - @inner ℝ E3 _ e z • e ≠ 0 → ∃ (a : Fin 3) (u : E3 → ℝ) (ρ δ : ℝ), 0 < ρ ∧ 0 < δ ∧ Continuous u ∧ ∀ w ∈ sepCyl a z ρ δ, ((∀ N ∈ 𝓝 w, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) ↔ w a = u (sepPlaneProj a w))) : ∃ Φ : Finset E3, (∀ φ ∈ Φ, ‖φ‖ = 1 ∧ @inner ℝ E3 _ e φ = 0) ∧ ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → z - @inner ℝ E3 _ e z • e ≠ 0 → ‖z - @inner ℝ E3 _ e z • e‖⁻¹ • (z - @inner ℝ E3 _ e z • e) ∈ Φ :=
by
  classical
  
  obtain ⟨B, hBdef⟩ : ∃ B : Set E3, ∀ z, z ∈ B ↔
      ∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0 := ⟨_, fun z => Iff.rfl⟩
  have hdil' : ∀ t : ℝ, 0 < t → ∀ z ∈ B, t • z ∈ B := fun t ht z hz =>
    (hBdef _).2 (hdil t ht z ((hBdef z).1 hz))
  have htr' : ∀ s : ℝ, ∀ z ∈ B, z + s • e ∈ B := fun s z hz =>
    (hBdef _).2 (htr s z ((hBdef z).1 hz))
  have hee : @inner ℝ E3 _ e e = 1 := by
    rw [real_inner_self_eq_norm_sq, he]; norm_num
  
  have hBc : IsClosed B := by
    rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
    intro z hz
    rw [Set.mem_compl_iff, hBdef] at hz
    simp only [not_forall] at hz
    obtain ⟨N, hN, hN'⟩ := hz
    obtain ⟨O, hON, hO, hzO⟩ := _root_.mem_nhds_iff.1 hN
    filter_upwards [hO.mem_nhds hzO] with y hy
    rw [Set.mem_compl_iff, hBdef]
    intro h
    exact hN' (h N (Filter.mem_of_superset (hO.mem_nhds hy) hON))
  
  set Γ : Set E3 := Metric.sphere (0 : E3) 1 ∩ ({φ | @inner ℝ E3 _ e φ = 0} ∩ B) with hΓ
  have hΓc : IsCompact Γ := by
    refine (isCompact_sphere (0 : E3) 1).inter_right ?_
    refine IsClosed.inter ?_ hBc
    exact isClosed_eq (continuous_const.inner continuous_id) continuous_const
  have hmemΓ : ∀ φ, φ ∈ Γ ↔ ‖φ‖ = 1 ∧ @inner ℝ E3 _ e φ = 0 ∧ φ ∈ B := by
    intro φ
    simp only [hΓ, Set.mem_inter_iff, mem_sphere_zero_iff_norm, Set.mem_setOf_eq]
  
  have hiso : ∀ φ₀ ∈ Γ, ∃ U ∈ 𝓝 φ₀, ∀ φ ∈ U, φ ∈ B → ‖φ‖ = 1 →
      @inner ℝ E3 _ e φ = 0 → φ = φ₀ := by
    intro φ₀ hφ₀
    obtain ⟨hφ₀1, hφ₀e, hφ₀B⟩ := (hmemΓ φ₀).1 hφ₀
    have hne : φ₀ - @inner ℝ E3 _ e φ₀ • e ≠ 0 := by
      rw [hφ₀e, zero_smul, sub_zero]
      intro h
      rw [h, norm_zero] at hφ₀1
      exact zero_ne_one hφ₀1
    obtain ⟨a, u, ρ, δ, hρ, hδ, -, hgraph⟩ := hreg φ₀ ((hBdef φ₀).1 hφ₀B) hne
    have hgr : ∀ w ∈ sepCyl a φ₀ ρ δ, (w ∈ B ↔ w a = u (sepPlaneProj a w)) :=
      fun w hw => (hBdef w).trans (hgraph w hw)
    have hH : ∀ s t : ℝ, 0 < s → s • φ₀ + t • e ∈ B := fun s t hs =>
      htr' t _ (hdil' s hs φ₀ hφ₀B)
    obtain ⟨ε, hε⟩ : ∃ ε : E3, ε = EuclideanSpace.single a (1:ℝ) := ⟨_, rfl⟩
    have hcoord : ∀ (w : E3) (r : ℝ), (w + r • ε) a = w a + r := by
      intro w r; simp [hε]
    have hPdef : ∀ w : E3, sepPlaneProj a w = w - (w a) • ε := by
      intro w; rw [hε]; rfl
    have hP : ∀ (w : E3) (r : ℝ), sepPlaneProj a (w + r • ε) = sepPlaneProj a w := by
      intro w r
      rw [hPdef, hPdef, hcoord, add_smul]
      abel
    have hdecomp : ∀ w : E3, w = sepPlaneProj a w + (w a) • ε := by
      intro w; rw [hPdef, sub_add_cancel]
    have hVU : ∀ (w : E3) (r : ℝ), w ∈ sepCyl a φ₀ ρ δ → w ∈ B →
        w + r • ε ∈ sepCyl a φ₀ ρ δ → w + r • ε ∈ B → r = 0 := by
      intro w r hwC hwB hwC' hwB'
      have h1 := (hgr w hwC).1 hwB
      have h2 := (hgr _ hwC').1 hwB'
      rw [hP, hcoord, ← h1] at h2
      linarith
    have hCopen : IsOpen (sepCyl a φ₀ ρ δ) := by
      have hca : Continuous (fun z : E3 => z a) := by fun_prop
      have hcP : Continuous (fun z : E3 => sepPlaneProj a (z - φ₀)) := by
        simp only [hPdef]
        fun_prop
      exact (isOpen_lt (continuous_norm.comp hcP) continuous_const).inter
        (isOpen_lt (continuous_abs.comp (hca.sub continuous_const)) continuous_const)
    have hvertC : ∀ r : ℝ, |r| < δ → φ₀ + r • ε ∈ sepCyl a φ₀ ρ δ := by
      intro r hr
      refine ⟨?_, ?_⟩
      · rw [add_sub_cancel_left]
        have : sepPlaneProj a (r • ε) = 0 := by
          have h := hP 0 r
          rw [zero_add] at h
          rw [h, hPdef]; simp
        rw [this, norm_zero]; exact hρ
      · rw [hcoord, add_sub_cancel_left]; exact hr
    have hφ₀C : φ₀ ∈ sepCyl a φ₀ ρ δ := by
      have h := hvertC 0 (by rw [abs_zero]; exact hδ)
      rwa [zero_smul, add_zero] at h
    
    have hinj : ∀ α β : ℝ, sepPlaneProj a (α • φ₀ + β • e) = 0 → α = 0 ∧ β = 0 := by
      intro α β hv
      obtain ⟨v, hvdef⟩ : ∃ v : E3, v = α • φ₀ + β • e := ⟨_, rfl⟩
      rw [← hvdef] at hv
      have hv' : v = (v a) • ε := by
        have := hdecomp v; rw [hv, zero_add] at this; exact this
      obtain ⟨s, hs0, hs1, hs2⟩ : ∃ s : ℝ, 0 < s ∧ 0 < 1 + s * α ∧ |s * v a| < δ := by
        refine ⟨min (1 / (2 * (|α| + 1))) (δ / (2 * (|v a| + 1))), ?_, ?_, ?_⟩
        · exact lt_min (by positivity) (by positivity)
        · have hm := min_le_left (1 / (2 * (|α| + 1))) (δ / (2 * (|v a| + 1)))
          have hpos : 0 < min (1 / (2 * (|α| + 1))) (δ / (2 * (|v a| + 1))) :=
            lt_min (by positivity) (by positivity)
          rw [le_div_iff₀ (by positivity)] at hm
          have h3 := mul_le_mul_of_nonneg_left (neg_abs_le α) hpos.le
          nlinarith [abs_nonneg α]
        · have hm := min_le_right (1 / (2 * (|α| + 1))) (δ / (2 * (|v a| + 1)))
          have hpos : 0 < min (1 / (2 * (|α| + 1))) (δ / (2 * (|v a| + 1))) :=
            lt_min (by positivity) (by positivity)
          rw [le_div_iff₀ (by positivity)] at hm
          rw [abs_mul, abs_of_pos hpos]
          nlinarith [abs_nonneg (v a)]
      have hw : φ₀ + (s * v a) • ε = (1 + s * α) • φ₀ + (s * β) • e := by
        calc φ₀ + (s * v a) • ε = φ₀ + s • ((v a) • ε) := by rw [smul_smul]
          _ = φ₀ + s • v := by rw [← hv']
          _ = (1 + s * α) • φ₀ + (s * β) • e := by rw [hvdef]; module
      have hsv : s * v a = 0 := by
        refine hVU φ₀ (s * v a) hφ₀C hφ₀B (hvertC _ hs2) ?_
        rw [hw]; exact hH _ _ hs1
      have hva : v a = 0 := by
        rcases mul_eq_zero.1 hsv with h | h
        · exact absurd h hs0.ne'
        · exact h
      have hv0 : v = 0 := by rw [hv', hva, zero_smul]
      have h1 : @inner ℝ E3 _ φ₀ v = α := by
        rw [hvdef, inner_add_right, real_inner_smul_right, real_inner_smul_right,
          real_inner_self_eq_norm_sq, hφ₀1, real_inner_comm e φ₀, hφ₀e]
        ring
      have h2 : @inner ℝ E3 _ e v = β := by
        rw [hvdef, inner_add_right, real_inner_smul_right, real_inner_smul_right, hφ₀e, hee]
        ring
      rw [hv0, inner_zero_right] at h1 h2
      exact ⟨h1.symm, h2.symm⟩
    
    obtain ⟨T, hT⟩ : ∃ T : (Fin 3 → ℝ) →ₗ[ℝ] E3,
        ∀ c, T c = c 0 • φ₀ + c 1 • e + c 2 • ε :=
      ⟨{ toFun := fun c => c 0 • φ₀ + c 1 • e + c 2 • ε
         map_add' := by
           intro x y
           simp only [Pi.add_apply, add_smul]
           abel
         map_smul' := by
           intro r x
           simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, smul_add, mul_smul] },
        fun c => rfl⟩
    have hTinj : Function.Injective T := by
      rw [injective_iff_map_eq_zero]
      intro c hc
      rw [hT] at hc
      have hPc : sepPlaneProj a (c 0 • φ₀ + c 1 • e) = 0 := by
        have h := congrArg (sepPlaneProj a) hc
        rw [hP] at h
        rw [h, hPdef]; simp
      obtain ⟨h0, h1⟩ := hinj _ _ hPc
      rw [h0, h1, zero_smul, zero_smul, zero_add, zero_add] at hc
      have h2 : c 2 = 0 := by
        have h := congrArg (fun w : E3 => w a) hc
        simpa [hε] using h
      funext i
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
    have hTsurj : Function.Surjective T := by
      rw [← LinearMap.injective_iff_surjective_of_finrank_eq_finrank]
      · exact hTinj
      · simp
    obtain ⟨cc, hcc, hcT⟩ : ∃ cc : E3 → (Fin 3 → ℝ), Continuous cc ∧ ∀ v, T (cc v) = v := by
      let Te := LinearEquiv.ofBijective T ⟨hTinj, hTsurj⟩
      refine ⟨Te.symm, LinearMap.continuous_of_finiteDimensional (Te.symm : E3 →ₗ[ℝ] (Fin 3 → ℝ)),
        fun v => ?_⟩
      exact Te.apply_symm_apply v
    have hcφ₀ : cc φ₀ = ![1, 0, 0] := by
      apply hTinj
      rw [hcT, hT]
      simp
    
    have hg : Continuous (fun φ : E3 => φ - (cc φ 2) • ε) :=
      continuous_id.sub (((continuous_apply 2).comp hcc).smul continuous_const)
    refine ⟨{φ | 0 < cc φ 0} ∩ sepCyl a φ₀ ρ δ ∩ (fun φ : E3 => φ - (cc φ 2) • ε) ⁻¹'
      sepCyl a φ₀ ρ δ, ?_, ?_⟩
    · refine Filter.inter_mem (Filter.inter_mem ?_ (hCopen.mem_nhds hφ₀C)) ?_
      · refine (isOpen_lt continuous_const ((continuous_apply 0).comp hcc)).mem_nhds ?_
        show 0 < cc φ₀ 0
        rw [hcφ₀]; simp
      · refine hg.continuousAt.preimage_mem_nhds ?_
        have : φ₀ - (cc φ₀ 2) • ε = φ₀ := by rw [hcφ₀]; simp
        rw [this]
        exact hCopen.mem_nhds hφ₀C
    · rintro φ ⟨⟨hpos, hφC⟩, hyC⟩ hφB hφ1 hφe
      have hpos' : 0 < cc φ 0 := hpos
      have hyC' : φ - (cc φ 2) • ε ∈ sepCyl a φ₀ ρ δ := hyC
      have hφT : φ = cc φ 0 • φ₀ + cc φ 1 • e + cc φ 2 • ε := by
        have h := hcT φ
        rw [hT] at h
        exact h.symm
      have hy : φ - (cc φ 2) • ε = cc φ 0 • φ₀ + cc φ 1 • e := by
        calc φ - (cc φ 2) • ε = (cc φ 0 • φ₀ + cc φ 1 • e + cc φ 2 • ε) - cc φ 2 • ε := by
              rw [← hφT]
          _ = cc φ 0 • φ₀ + cc φ 1 • e := add_sub_cancel_right _ _
      have hyB : φ - (cc φ 2) • ε ∈ B := by rw [hy]; exact hH _ _ hpos'
      have hk2 : cc φ 2 = 0 := by
        refine hVU _ (cc φ 2) hyC' hyB ?_ ?_
        · rw [sub_add_cancel]; exact hφC
        · rw [sub_add_cancel]; exact hφB
      have hφ' : φ = cc φ 0 • φ₀ + cc φ 1 • e := by
        rw [← hy, hk2, zero_smul, sub_zero]
      have hk1 : cc φ 1 = 0 := by
        have h := hφe
        rw [hφ', inner_add_right, real_inner_smul_right, real_inner_smul_right, hφ₀e, hee] at h
        linarith
      rw [hk1, zero_smul, add_zero] at hφ'
      have hk0 : cc φ 0 = 1 := by
        have h := hφ1
        rw [hφ', norm_smul, hφ₀1, mul_one, Real.norm_eq_abs, abs_of_pos hpos'] at h
        exact h
      rw [hφ', hk0, one_smul]
  choose! U hUn hUiso using hiso
  obtain ⟨t, htΓ, hcov⟩ := hΓc.elim_nhds_subcover U hUn
  refine ⟨t, fun φ hφ => ?_, ?_⟩
  · obtain ⟨h1, h2, -⟩ := (hmemΓ φ).1 (htΓ φ hφ)
    exact ⟨h1, h2⟩
  · intro z hz hz'
    have hzB : z ∈ B := (hBdef z).2 hz
    have hz'B : z - @inner ℝ E3 _ e z • e ∈ B := by
      have h := htr' (-(@inner ℝ E3 _ e z)) z hzB
      rwa [neg_smul, ← sub_eq_add_neg] at h
    have hnpos : 0 < ‖z - @inner ℝ E3 _ e z • e‖ := norm_pos_iff.2 hz'
    have hφB := hdil' _ (inv_pos.2 hnpos) _ hz'B
    have hφ1 : ‖‖z - @inner ℝ E3 _ e z • e‖⁻¹ • (z - @inner ℝ E3 _ e z • e)‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hnpos.ne']
    have hφe : @inner ℝ E3 _ e (‖z - @inner ℝ E3 _ e z • e‖⁻¹ • (z - @inner ℝ E3 _ e z • e)) = 0 := by
      rw [real_inner_smul_right, inner_sub_right, real_inner_smul_right, hee]
      ring
    have hφΓ := (hmemΓ _).2 ⟨hφ1, hφe, hφB⟩
    obtain ⟨x, hx, hxU⟩ := Set.mem_iUnion₂.1 (hcov hφΓ)
    rw [hUiso x (htΓ x hx) _ hxU hφB hφ1 hφe]
    exact hx

theorem sepCylCone_wedge_config (L : Set E3) (e : E3) (Φ : Finset E3) (he : ‖e‖ = 1) (hdil : ∀ t : ℝ, 0 < t → ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (t • z), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (htr : ∀ s : ℝ, ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → ∀ N ∈ 𝓝 (z + s • e), volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) (hΦ : ∀ φ ∈ Φ, ‖φ‖ = 1 ∧ @inner ℝ E3 _ e φ = 0) (hrays : ∀ z : E3, (∀ N ∈ 𝓝 z, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) → z - @inner ℝ E3 _ e z • e ≠ 0 → ‖z - @inner ℝ E3 _ e z • e‖⁻¹ • (z - @inner ℝ E3 _ e z • e) ∈ Φ) (h1 : ∀ N ∈ 𝓝 (0:E3), volume (N \ L) ≠ 0) (h0 : ∀ N ∈ 𝓝 (0:E3), volume (N ∩ L) ≠ 0) : (∃ ν : E3, ‖ν‖ = 1 ∧ volume (symmDiff L {z : E3 | @inner ℝ E3 _ ν z < 0}) = 0) ∨ ∃ (E : Set E3) (q₁ q₂ p₁ p₂ : E3), (E = L ∨ E = Lᶜ) ∧ ‖q₁‖ = 1 ∧ ‖q₂‖ = 1 ∧ LinearIndependent ℝ ![q₁, q₂] ∧ (∀ z : E3, @inner ℝ E3 _ q₁ z ≤ 0 → @inner ℝ E3 _ q₂ z ≤ 0 → (@inner ℝ E3 _ q₁ z = 0 ∧ @inner ℝ E3 _ q₂ z = 0) ∨ (@inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0)) ∧ volume ({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩ {z : E3 | @inner ℝ E3 _ q₁ z < 0 ∧ @inner ℝ E3 _ q₂ z < 0} ∩ E) = 0 ∧ volume (({z : E3 | @inner ℝ E3 _ p₁ z < 0 ∧ @inner ℝ E3 _ p₂ z < 0} ∩ {z : E3 | 0 < @inner ℝ E3 _ q₁ z ∨ 0 < @inner ℝ E3 _ q₂ z}) \ E) = 0 :=
by
  classical
  
  have s1 : ∀ (K O : Set E3), IsPreconnected O →
      (∀ z ∈ O, ∃ N ∈ 𝓝 z, volume (N ∩ K) = 0 ∨ volume (N \ K) = 0) →
      volume (O ∩ K) = 0 ∨ volume (O \ K) = 0 := by
    intro K O hconn hloc
    have hopen0 : IsOpen {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ K) = 0} := by
      rw [isOpen_iff_mem_nhds]
      rintro z ⟨N, hN, hN0⟩
      obtain ⟨V, hVN, hVo, hzV⟩ := _root_.mem_nhds_iff.1 hN
      refine Filter.mem_of_superset (hVo.mem_nhds hzV) ?_
      intro w hw
      exact ⟨V, hVo.mem_nhds hw, measure_mono_null (Set.inter_subset_inter_left _ hVN) hN0⟩
    have hopen1 : IsOpen {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ K) = 0} := by
      rw [isOpen_iff_mem_nhds]
      rintro z ⟨N, hN, hN0⟩
      obtain ⟨V, hVN, hVo, hzV⟩ := _root_.mem_nhds_iff.1 hN
      refine Filter.mem_of_superset (hVo.mem_nhds hzV) ?_
      intro w hw
      exact ⟨V, hVo.mem_nhds hw, measure_mono_null (Set.diff_subset_diff_left hVN) hN0⟩
    have hcover : O ⊆ {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ K) = 0} ∪
        {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ K) = 0} := by
      intro z hz
      obtain ⟨N, hN, h | h⟩ := hloc z hz
      · exact Or.inl ⟨N, hN, h⟩
      · exact Or.inr ⟨N, hN, h⟩
    have hdisj : Disjoint {z : E3 | ∃ N ∈ 𝓝 z, volume (N ∩ K) = 0}
        {z : E3 | ∃ N ∈ 𝓝 z, volume (N \ K) = 0} := by
      rw [Set.disjoint_left]
      rintro z ⟨N₀, hN₀, h0⟩ ⟨N₁, hN₁, h1⟩
      have hpos : 0 < volume (N₀ ∩ N₁) :=
        Measure.measure_pos_of_mem_nhds _ (Filter.inter_mem hN₀ hN₁)
      have hnull : volume (N₀ ∩ N₁) = 0 := by
        refine measure_mono_null ?_ (measure_union_null h0 h1)
        rintro x ⟨hx0, hx1⟩
        by_cases hxK : x ∈ K
        · exact Or.inl ⟨hx0, hxK⟩
        · exact Or.inr ⟨hx1, hxK⟩
      exact hpos.ne' hnull
    rcases hconn.subset_or_subset hopen0 hopen1 hdisj hcover with h | h
    · left
      apply measure_null_of_locally_null
      intro x hx
      obtain ⟨N, hN, hN0⟩ := h hx.1
      exact ⟨(O ∩ K) ∩ N, inter_mem_nhdsWithin _ hN,
        measure_mono_null (fun y (hy : y ∈ (O ∩ K) ∩ N) => (⟨hy.2, hy.1.2⟩ : y ∈ N ∩ K)) hN0⟩
    · right
      apply measure_null_of_locally_null
      intro x hx
      obtain ⟨N, hN, hN0⟩ := h hx.1
      exact ⟨(O \ K) ∩ N, inter_mem_nhdsWithin _ hN,
        measure_mono_null (fun y (hy : y ∈ (O \ K) ∩ N) => (⟨hy.2, hy.1.2⟩ : y ∈ N \ K)) hN0⟩
  
  have s2 : ∀ x y : E3,
      IsPreconnected {z : E3 | @inner ℝ E3 _ x z < 0 ∧ @inner ℝ E3 _ y z < 0} := by
    intro x y
    apply Convex.isPreconnected
    intro z₁ hz₁ z₂ hz₂ s t hs ht hst
    simp only [Set.mem_setOf_eq, inner_add_right, real_inner_smul_right] at hz₁ hz₂ ⊢
    rcases hs.eq_or_lt with hs0 | hs0
    · subst hs0
      have ht1 : t = 1 := by linarith
      subst ht1
      constructor <;> linarith [hz₂.1, hz₂.2]
    · have a1 := mul_neg_of_pos_of_neg hs0 hz₁.1
      have a2 := mul_neg_of_pos_of_neg hs0 hz₁.2
      have b1 := mul_nonpos_of_nonneg_of_nonpos ht hz₂.1.le
      have b2 := mul_nonpos_of_nonneg_of_nonpos ht hz₂.2.le
      constructor <;> linarith
  
  have s3 : ∀ x y : E3, @inner ℝ E3 _ e x = 0 → @inner ℝ E3 _ e y = 0 →
      (∀ φ ∈ Φ, (∀ N ∈ 𝓝 φ, volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0) →
        ¬ (@inner ℝ E3 _ x φ < 0 ∧ @inner ℝ E3 _ y φ < 0)) →
      ∀ z ∈ {z : E3 | @inner ℝ E3 _ x z < 0 ∧ @inner ℝ E3 _ y z < 0},
        ∃ N ∈ 𝓝 z, volume (N ∩ L) = 0 ∨ volume (N \ L) = 0 := by
    intro x y hex hey havoid z hz
    by_contra hcon
    push_neg at hcon
    have hxe : @inner ℝ E3 _ x e = 0 := by rw [real_inner_comm]; exact hex
    have hye : @inner ℝ E3 _ y e = 0 := by rw [real_inner_comm]; exact hey
    have hxw : @inner ℝ E3 _ x (z - @inner ℝ E3 _ e z • e) = @inner ℝ E3 _ x z := by
      rw [inner_sub_right, real_inner_smul_right, hxe, mul_zero, sub_zero]
    have hyw : @inner ℝ E3 _ y (z - @inner ℝ E3 _ e z • e) = @inner ℝ E3 _ y z := by
      rw [inner_sub_right, real_inner_smul_right, hye, mul_zero, sub_zero]
    have hw0 : z - @inner ℝ E3 _ e z • e ≠ 0 := by
      intro h
      have := hz.1
      rw [← hxw, h, inner_zero_right] at this
      exact lt_irrefl _ this
    have hBw : ∀ N ∈ 𝓝 (z - @inner ℝ E3 _ e z • e),
        volume (N ∩ L) ≠ 0 ∧ volume (N \ L) ≠ 0 := by
      have h := htr (-(@inner ℝ E3 _ e z)) z hcon
      rwa [neg_smul, ← sub_eq_add_neg] at h
    have hφ := hrays z hcon hw0
    have hpos : 0 < ‖z - @inner ℝ E3 _ e z • e‖⁻¹ := inv_pos.2 (norm_pos_iff.2 hw0)
    have hBφ := hdil _ hpos _ hBw
    apply havoid _ hφ hBφ
    rw [real_inner_smul_right, real_inner_smul_right, hxw, hyw]
    exact ⟨mul_neg_of_pos_of_neg hpos hz.1, mul_neg_of_pos_of_neg hpos hz.2⟩
  
  have hee : @inner ℝ E3 _ e e = 1 := by rw [real_inner_self_eq_norm_sq, he]; norm_num
  have s4 : ∀ a b v : E3, @inner ℝ E3 _ e a = 0 → @inner ℝ E3 _ e b = 0 →
      LinearIndependent ℝ ![a, b] → @inner ℝ E3 _ e v = 0 → ∃ s t : ℝ, v = s • a + t • b := by
    intro a b v hea heb hab hev
    have hnot : e ∉ Submodule.span ℝ (Set.range ![a, b]) := by
      intro h
      rw [Submodule.mem_span_range_iff_exists_fun] at h
      obtain ⟨c, hc⟩ := h
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at hc
      have h2 := congrArg (fun w => @inner ℝ E3 _ e w) hc
      simp only [inner_add_right, real_inner_smul_right, hea, heb, hee] at h2
      norm_num at h2
    have hind3 : LinearIndependent ℝ ![e, a, b] := by
      have : LinearIndependent ℝ (Fin.cons e ![a, b] : Fin 3 → E3) :=
        linearIndependent_fin_cons.2 ⟨hab, hnot⟩
      exact this
    have htop := hind3.span_eq_top_of_card_eq_finrank (by simp)
    have hv : v ∈ Submodule.span ℝ (Set.range ![e, a, b]) := by rw [htop]; trivial
    rw [Submodule.mem_span_range_iff_exists_fun] at hv
    obtain ⟨c, hc⟩ := hv
    simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons] at hc
    have h2 := congrArg (fun w => @inner ℝ E3 _ e w) hc
    simp only [inner_add_right, real_inner_smul_right, hea, heb, hee, hev] at h2
    have hc0 : c 0 = 0 := by linarith
    refine ⟨c 1, c 2, ?_⟩
    rw [← hc, hc0, zero_smul, zero_add]
  
  have sβ : ∀ a b : E3, ‖a‖ = 1 → ‖b‖ = 1 → ∀ s t : ℝ,
      @inner ℝ E3 _ (@inner ℝ E3 _ a b • a - b) (s • a + t • b) =
        -t * (1 - @inner ℝ E3 _ a b ^ 2) ∧
      @inner ℝ E3 _ (@inner ℝ E3 _ a b • b - a) (s • a + t • b) =
        -s * (1 - @inner ℝ E3 _ a b ^ 2) := by
    intro a b ha hb s t
    have haa : @inner ℝ E3 _ a a = 1 := by rw [real_inner_self_eq_norm_sq, ha]; norm_num
    have hbb : @inner ℝ E3 _ b b = 1 := by rw [real_inner_self_eq_norm_sq, hb]; norm_num
    have hba : @inner ℝ E3 _ b a = @inner ℝ E3 _ a b := real_inner_comm _ _
    constructor
    · simp only [inner_sub_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        haa, hbb, hba]
      ring
    · simp only [inner_sub_left, inner_add_right, real_inner_smul_left, real_inner_smul_right,
        haa, hbb, hba]
      ring
  have sα : ∀ a b : E3, ‖a‖ = 1 → ‖b‖ = 1 → LinearIndependent ℝ ![a, b] →
      0 < 1 - @inner ℝ E3 _ a b ^ 2 := by
    intro a b ha hb hab
    have haa : @inner ℝ E3 _ a a = 1 := by rw [real_inner_self_eq_norm_sq, ha]; norm_num
    have hbb : @inner ℝ E3 _ b b = 1 := by rw [real_inner_self_eq_norm_sq, hb]; norm_num
    have hba : @inner ℝ E3 _ b a = @inner ℝ E3 _ a b := real_inner_comm _ _
    have hne : b - @inner ℝ E3 _ a b • a ≠ 0 := by
      intro h
      have := (LinearIndependent.pair_iff.1 hab (-(@inner ℝ E3 _ a b)) 1
        (by rw [neg_smul, one_smul, ← h]; abel)).2
      exact one_ne_zero this
    have hpos : 0 < ‖b - @inner ℝ E3 _ a b • a‖ ^ 2 := pow_pos (norm_pos_iff.2 hne) 2
    rw [← real_inner_self_eq_norm_sq] at hpos
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right,
      haa, hbb, hba] at hpos
