  obtain ⟨L, hL⟩ := (isCompact_closedBall (0 : E3) 1).exists_bound_of_continuousOn hcont
  have hterm : ∀ x ∈ Metric.ball (0 : E3) 1, ∀ l i j : Fin 3,
