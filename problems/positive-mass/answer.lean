          g.g z (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)).symm (chartAt E3 (p k) x)
            (Y k (chartAt E3 (p k) x)) : E3)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)).symm (chartAt E3 (p k) x)
            (Y k (chartAt E3 (p k) x)) : E3) ≤ 1 := by
