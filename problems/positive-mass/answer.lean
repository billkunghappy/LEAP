  have hm3 : (1 / 4 : ℝ) ^ (3 / 2 : ℝ) * (32000 * A₀ * M) ≤ 32000 * A₀ * M := by
    nlinarith
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · have h := (hint 0 h0 0 h0 i i).2.1
    have e : M / (1 / 4 : ℝ) = 4 * M := by ring
    rw [e] at h
    nlinarith
  · have h := (hint 0 h0 0 h0 i j).1
    have e : M / (1 / 4 : ℝ) ^ 2 = 16 * M := by ring
    rw [e] at h
