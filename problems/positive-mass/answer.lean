          have := mul_neg_of_neg_of_pos hc h
          linarith
        have hterm : ∀ m ∈ J, φ m x * |f (c m) x| = κ m * φ m x * f (c m) x := by
          intro m hm
          rw [habsκ m hm, abs_of_nonneg (hm' m hm), hrew]
        rw [Finset.sum_congr rfl hterm, abs_of_nonneg]
        exact Finset.sum_nonneg (fun m hm => by
          rw [hrew]; exact mul_nonneg (hφnn m x) (hm' m hm))
    have hβs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => ∑ m ∈ J, κ m * φ m y * f (c m) y) :=
      contMDiff_finset_sum (fun m _ => (contMDiff_const.mul (hφs m)).mul (hFs m))
    
    have hdβ' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun y => ∑ m ∈ J, κ m * φ m y * f (c m) y) p ≠ 0 := by
      have hpy : (chartAt E3 p).symm (chartAt E3 p p) = p :=
        (chartAt E3 p).left_inv (mem_chart_source E3 p)
      have hy₀U : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
      have hUo' : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
      have hcd : ∀ w : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
          ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
        fun w hw => contMDiffOn_iff_contDiffOn.mp (hw.comp_contMDiffOn contMDiffOn_chart_symm)
      have hdiffw : ∀ w : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
          DifferentiableAt ℝ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) := fun w hw =>
        ((hcd w hw).contDiffAt (hUo'.mem_nhds hy₀U)).differentiableAt (by simp)
      have hbr : ∀ w : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w p =
            fderiv ℝ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
        intro w hw
        have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w p := hw.mdifferentiableAt (by simp)
        rw [hmd.mfderiv]
        simp only [writtenInExtChartAt, extChartAt_coe, extChartAt_coe_symm, chartAt_self_eq,
          modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Set.range_id,
          fderivWithin_univ, OpenPartialHomeomorph.refl_apply, Function.comp_def, id]
      have htend : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
        have h := ((chartAt E3 p).continuousAt_symm hy₀U).tendsto
        rwa [hpy] at h
      have hf0 : ∀ m ∈ J, f (c m) p = 0 := fun m hm => (hZiff m p ((hmemJ m).1 hm)).1 hpF
      have hκf : ∀ m, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => κ m * f (c m) x) :=
        fun m => contMDiff_const.mul (hFs m)
      have hκne : ∀ m ∈ J, κ m ≠ 0 := by
        intro m hm
        rcases (hκ m hm).1 with h | h <;> rw [h] <;> norm_num
      have hF0 : ∀ m ∈ J,
          (fun y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
        intro m hm
        show κ m * f (c m) ((chartAt E3 p).symm (chartAt E3 p p)) = 0
        rw [hpy, hf0 m hm, mul_zero]
      have hF0j : (fun y => f (c j₀) ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
        show f (c j₀) ((chartAt E3 p).symm (chartAt E3 p p)) = 0
        rw [hpy, hf0 j₀ hj₀J]
      have hnej : fderiv ℝ (fun y => f (c j₀) ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0 := by
        rw [← hbr _ (hFs j₀)]; exact hFdf j₀ p ((hmemJ j₀).1 hj₀J)
      have hne : ∀ m ∈ J,
          fderiv ℝ (fun y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0 := by
        intro m hm
        rw [fderiv_const_mul (hdiffw _ (hFs m)), ← hbr _ (hFs m)]
        exact smul_ne_zero (hκne m hm) (hFdf m p ((hmemJ m).1 hm))
      have hprop : ∀ m ∈ J, ∃ cm : ℝ, 0 < cm ∧
          fderiv ℝ (fun y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) =
            cm • fderiv ℝ (fun y => f (c j₀) ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
        intro m hm
        refine fderiv_pos_proportional (fun y => f (c j₀) ((chartAt E3 p).symm y))
          (fun y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p)
          (hdiffw _ (hFs j₀)) (hdiffw _ (hκf m)) hF0j (hF0 m hm) hnej (hne m hm) ?_
        filter_upwards [htend.eventually (hκ m hm).2] with y hy
        have hr : f (c j₀) ((chartAt E3 p).symm y) * (κ m * f (c m) ((chartAt E3 p).symm y)) =
            κ m * (f (c m) ((chartAt E3 p).symm y) * f (c j₀) ((chartAt E3 p).symm y)) := by ring
        rw [hr]; exact hy
      choose! cc hccpos hcc using hprop
      have hL3 := second_order_product_sum J (fun m y => φ m ((chartAt E3 p).symm y))
        (fun m y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p).target hUo'
        (chartAt E3 p p) hy₀U (fun m _ => hcd _ (hφs m)) (fun m _ => hcd _ (hκf m)) hF0
      beta_reduce at hL3
      have hL3a := hL3.1
      have hfd : fderiv ℝ (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
            f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) =
          (∑ m ∈ J, φ m p * cc m) •
            fderiv ℝ (fun y => f (c j₀) ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
        have hfun : (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
              f (c m) ((chartAt E3 p).symm y)) =
            fun z => ∑ m ∈ J, φ m ((chartAt E3 p).symm z) *
              (κ m * f (c m) ((chartAt E3 p).symm z)) := by
          funext z; exact Finset.sum_congr rfl (fun m _ => by ring)
        rw [hfun, hL3a, Finset.sum_smul]
        refine Finset.sum_congr rfl (fun m hm => ?_)
        rw [hcc m hm, hpy, smul_smul]
      rw [hbr _ hβs]
      show fderiv ℝ (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
            f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0
      rw [hfd]
      refine smul_ne_zero (ne_of_gt ?_) hnej
      refine Finset.sum_pos' (fun m hm => mul_nonneg (hφnn m p) (hccpos m hm).le)
        ⟨j₀, hj₀J, ?_⟩
      rw [hj₀, one_mul]; exact hccpos j₀ hj₀J
    have hev2 := hs1 _ hβs p hdβ'
    refine ⟨_, hβs, ?_⟩
    filter_upwards [hid', hev1, hev2] with x hx1 hx2 hx3
    refine ⟨?_, hx3⟩
    rw [← hx1]
    show ∑ i, φ i x * |f (c i) x| = ∑ m ∈ J, φ m x * |f (c m) x|
    exact (Finset.sum_subset (Finset.subset_univ J)
      (fun i _ hi => by rw [hx2 i hi, zero_mul])).symm
  
  set W₂ : Set M := {x | ∃ β : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β ∧
      ∀ᶠ y in 𝓝 x, τ y = |β y| ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β y ≠ 0} with hW₂def
  have hW₂o : IsOpen W₂ := by
    rw [isOpen_iff_mem_nhds]
    rintro x ⟨β, hβ, hev⟩
    filter_upwards [hev.eventually_nhds] with z hz
    exact ⟨β, hβ, hz⟩
  have hreg : ∀ x ∈ W₂, 0 < τ x → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0 := by
    rintro x ⟨β, hβ, hev⟩ hpos
    have hx := hev.self_of_nhds
    have hβne : β x ≠ 0 := by
      intro h; rw [hx.1, h, abs_zero] at hpos; exact lt_irrefl 0 hpos
    rcases lt_or_gt_of_ne hβne with h | h
    · have hev' : τ =ᶠ[𝓝 x] fun y => -β y := by
        filter_upwards [hev, hβ.continuous.continuousAt.eventually_lt continuousAt_const h]
          with y hy1 hy2
        rw [hy1.1, abs_of_neg hy2]
      rw [hev'.mfderiv_eq, show (fun y => -β y) = -β from rfl, mfderiv_neg]
      exact neg_ne_zero.mpr hx.2
    · have hev' : τ =ᶠ[𝓝 x] β := by
        filter_upwards [hev, continuousAt_const.eventually_lt hβ.continuous.continuousAt h]
          with y hy1 hy2
        rw [hy1.1, abs_of_pos hy2]
      rw [hev'.mfderiv_eq]
      exact hx.2
  
  have hUF : ∀ x ∈ U, x ∉ frontier U := fun x hx h => by
    rw [hUo.frontier_eq] at h; exact h.2 hx
  have hWo : IsOpen (N₁ ∩ W₂) := hN₁o.inter hW₂o
  have hFW : frontier U ⊆ N₁ ∩ W₂ := fun x hx => ⟨hKN₁ hx, hgood x hx⟩
  obtain ⟨K, hKc, hFK, hKW⟩ := exists_compact_between hFc hWo hFW
  have hKcl : IsClosed K := hKc.isClosed
  have hbdc : IsCompact (frontier K) :=
    hKc.of_isClosed_subset isClosed_frontier (frontier_subset_closure.trans hKcl.closure_subset)
  have hbdpos : ∀ x ∈ frontier K, 0 < τ x := by
    intro x hx
    have hxK : x ∈ K := hKcl.frontier_subset hx
    have hxF : x ∉ frontier U := fun h => hx.2 (hFK h)
    exact hτpos x (hKW hxK).1 hxF
  obtain ⟨ε, hε, hεK⟩ : ∃ ε : ℝ, 0 < ε ∧ ∀ x ∈ frontier K, ε < τ x := by
    rcases (frontier K).eq_empty_or_nonempty with h | h
    · exact ⟨1, one_pos, fun x hx => by simp [h] at hx⟩
    · obtain ⟨x₀, hx₀, hmin⟩ := hbdc.exists_isMinOn h hτc.continuousOn
      refine ⟨τ x₀ / 2, half_pos (hbdpos x₀ hx₀), fun x hx => ?_⟩
      have h1 := isMinOn_iff.1 hmin x hx
      have h2 := hbdpos x₀ hx₀
      linarith
  have hdia : ∀ x ∈ K, τ x < ε → x ∈ interior K := by
    intro x hxK hτx
    by_contra h
    have hxb : x ∈ frontier K := ⟨subset_closure hxK, h⟩
    linarith [hεK x hxb]
  set N : Set M := interior K ∩ τ ⁻¹' Set.Iio ε with hNdef
  have hNo : IsOpen N := isOpen_interior.inter (hτc.isOpen_preimage _ isOpen_Iio)
  have hNK : N ⊆ K := fun x hx => interior_subset hx.1
  have hFN : frontier U ⊆ N := fun x hx => ⟨hFK hx, by
    show τ x < ε
    rw [hτF x hx]; exact hε⟩
  have hNc : IsCompact (closure N) :=
    hKc.of_isClosed_subset isClosed_closure (closure_minimal hNK hKcl)
  have hτb : ∀ x ∈ U ∩ N, 0 < τ x ∧ τ x < ε := fun x hx =>
    ⟨hτpos x (hKW (hNK hx.2)).1 (hUF x hx.1), hx.2.2⟩
  have hcl : closure U = U ∪ frontier U := closure_eq_self_union_frontier U
  have hτp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ τ ⁻¹' Set.Icc c d) := by
    intro c' d hc hd
    have heq : U ∩ N ∩ τ ⁻¹' Set.Icc c' d = K ∩ closure U ∩ τ ⁻¹' Set.Icc c' d := by
      ext x
      constructor
      · rintro ⟨⟨hxU, hxN⟩, hxI⟩
        exact ⟨⟨hNK hxN, subset_closure hxU⟩, hxI⟩
      · rintro ⟨⟨hxK, hxc⟩, hxI⟩
        have hτx : τ x < ε := lt_of_le_of_lt hxI.2 hd
        have hxU : x ∈ U := by
          rw [hcl] at hxc
          rcases hxc with h | h
          · exact h
          · exfalso
            have h3 : c' ≤ τ x := hxI.1
            rw [hτF x h] at h3
            linarith
        exact ⟨⟨hxU, hdia x hxK hτx, hτx⟩, hxI⟩
    rw [heq]
    exact hKc.of_isClosed_subset
      ((hKcl.inter isClosed_closure).inter (IsClosed.preimage hτc isClosed_Icc))
      (fun x hx => hx.1.1)
  have hτi : ∀ δ : ℝ, 0 < δ → δ < ε →
      IsClosed (frontier U ∪ (U ∩ N ∩ τ ⁻¹' Set.Iic δ)) := by
    intro δ hδ hδε
    have heq : frontier U ∪ (U ∩ N ∩ τ ⁻¹' Set.Iic δ) = K ∩ closure U ∩ τ ⁻¹' Set.Iic δ := by
      ext x
      constructor
      · rintro (hxF | ⟨⟨hxU, hxN⟩, hxI⟩)
        · refine ⟨⟨interior_subset (hFK hxF), frontier_subset_closure hxF⟩, ?_⟩
          show τ x ≤ δ
          rw [hτF x hxF]; exact hδ.le
        · exact ⟨⟨hNK hxN, subset_closure hxU⟩, hxI⟩
      · rintro ⟨⟨hxK, hxc⟩, hxI⟩
        rw [hcl] at hxc
        rcases hxc with h | h
        · have hτx : τ x < ε := lt_of_le_of_lt hxI hδε
          exact Or.inr ⟨⟨h, hdia x hxK hτx, hτx⟩, hxI⟩
        · exact Or.inl h
    rw [heq]
    exact (hKcl.inter isClosed_closure).inter (IsClosed.preimage hτc isClosed_Iic)
  have hτ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ τ ⁻¹' Set.Iio δ := by
    intro δ hδ
    refine ⟨interior K ∩ τ ⁻¹' Set.Iio (min δ ε),
      isOpen_interior.inter (hτc.isOpen_preimage _ isOpen_Iio), fun x hx => ⟨hFK hx, ?_⟩, ?_⟩
    · show τ x < min δ ε
      rw [hτF x hx]; exact lt_min hδ hε
    · rintro x ⟨hxU, hxK, hxτ⟩
      have h1 : τ x < min δ ε := hxτ
      exact ⟨⟨hxK, lt_of_lt_of_le h1 (min_le_right _ _)⟩, lt_of_lt_of_le h1 (min_le_left _ _)⟩
  
  exact ⟨N, ε, τ, hNo, hFN, hNc, hε, hτsm.mono (fun x hx => hUF x hx.1),
    fun x hx => hreg x (hKW (hNK hx.2)).2 (hτb x hx).1, hτb, hτp, hτi, hτ0⟩

theorem mfderiv_ne_zero_eventually [IsManifold 𝓘(ℝ, E3) ∞ M] (V : Set M) (w : M → ℝ)
    (hVo : IsOpen V) (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w V) (y : M) (hyV : y ∈ V)
    (hdy : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y ≠ 0) :
    ∀ᶠ x in 𝓝 y, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 :=
by
  
  have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y := by
    by_contra h
    exact hdy (mfderiv_zero_of_not_mdifferentiableAt h)
  have hw' : writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) y w =
      w ∘ (extChartAt 𝓘(ℝ, E3) y).symm := by
    funext z
    simp [writtenInExtChartAt, extChartAt_model_space_eq_id]
  have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y =
      fderiv ℝ (w ∘ (extChartAt 𝓘(ℝ, E3) y).symm) (extChartAt 𝓘(ℝ, E3) y y) := by
    rw [hmd.mfderiv, hw', ModelWithCorners.range_eq_univ, fderivWithin_univ]
  have hfy : fderiv ℝ (w ∘ (extChartAt 𝓘(ℝ, E3) y).symm) (extChartAt 𝓘(ℝ, E3) y y) ≠ 0 :=
    fun h => hdy (hmf.trans h)
  
  have hWo : IsOpen ((extChartAt 𝓘(ℝ, E3) y).target ∩
      (extChartAt 𝓘(ℝ, E3) y).symm ⁻¹' V) :=
    (continuousOn_extChartAt_symm y).isOpen_inter_preimage (isOpen_extChartAt_target y) hVo
  have heyW : extChartAt 𝓘(ℝ, E3) y y ∈ ((extChartAt 𝓘(ℝ, E3) y).target ∩
      (extChartAt 𝓘(ℝ, E3) y).symm ⁻¹' V) := by
    refine ⟨mem_extChartAt_target y, ?_⟩
    rw [Set.mem_preimage, extChartAt_to_inv]
    exact hyV
  have hfM : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w ∘ (extChartAt 𝓘(ℝ, E3) y).symm)
      ((extChartAt 𝓘(ℝ, E3) y).target ∩ (extChartAt 𝓘(ℝ, E3) y).symm ⁻¹' V) :=
    hw.comp ((contMDiffOn_extChartAt_symm y).mono Set.inter_subset_left) (fun z hz => hz.2)
  have hfC : ContDiffOn ℝ ∞ (w ∘ (extChartAt 𝓘(ℝ, E3) y).symm)
      ((extChartAt 𝓘(ℝ, E3) y).target ∩ (extChartAt 𝓘(ℝ, E3) y).symm ⁻¹' V) :=
    contMDiffOn_iff_contDiffOn.mp hfM
  have hcont := hfC.continuousOn_fderiv_of_isOpen hWo (by simp)
  have hca := hcont.continuousAt (hWo.mem_nhds heyW)
  have hev := hca.eventually_ne hfy
  have hE : ∀ᶠ x in 𝓝 y,
      fderiv ℝ (w ∘ (extChartAt 𝓘(ℝ, E3) y).symm) (extChartAt 𝓘(ℝ, E3) y x) ≠ 0 :=
    (continuousAt_extChartAt y).tendsto.eventually hev
  
  filter_upwards [hE, extChartAt_source_mem_nhds (I := 𝓘(ℝ, E3)) y, hVo.mem_nhds hyV]
    with x hxE hxS hxV
  intro h0
  apply hxE
  have hwx : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x :=
    (hw.contMDiffAt (hVo.mem_nhds hxV)).mdifferentiableAt (by simp)
  have hz : extChartAt 𝓘(ℝ, E3) y x ∈ (extChartAt 𝓘(ℝ, E3) y).target :=
    (extChartAt 𝓘(ℝ, E3) y).map_source hxS
  have hxz : (extChartAt 𝓘(ℝ, E3) y).symm (extChartAt 𝓘(ℝ, E3) y x) = x :=
    (extChartAt 𝓘(ℝ, E3) y).left_inv hxS
  have hsy : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (extChartAt 𝓘(ℝ, E3) y).symm
      (extChartAt 𝓘(ℝ, E3) y x) := by
    have := mdifferentiableWithinAt_extChartAt_symm (I := 𝓘(ℝ, E3)) hz
    rw [ModelWithCorners.range_eq_univ] at this
    exact mdifferentiableWithinAt_univ.mp this
  have hwz : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w
      ((extChartAt 𝓘(ℝ, E3) y).symm (extChartAt 𝓘(ℝ, E3) y x)) := by
    rw [hxz]; exact hwx
  have h0' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w
      ((extChartAt 𝓘(ℝ, E3) y).symm (extChartAt 𝓘(ℝ, E3) y x)) = 0 := by
    rw [hxz]; exact h0
  have hcomp := mfderiv_comp (extChartAt 𝓘(ℝ, E3) y x) hwz hsy
  rw [h0', ContinuousLinearMap.zero_comp, mfderiv_eq_fderiv] at hcomp
  exact hcomp

theorem regular_level_positive_side_box [IsManifold 𝓘(ℝ, E3) ∞ M] (V : Set M) (w : M → ℝ)
    (hVo : IsOpen V) (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w V) (y : M) (hyV : y ∈ V)
    (hy0 : w y = 0) (hdy : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y ≠ 0) (O : Set M) (hO : O ∈ 𝓝 y) :
    ∃ N : Set M, IsOpen N ∧ y ∈ N ∧ N ⊆ O ∧ IsPreconnected (N ∩ {x | 0 < w x}) :=
by
  
  have euclid : ∀ (W : Set E3) (f : E3 → ℝ) (x₀ : E3), IsOpen W → x₀ ∈ W →
      ContDiffOn ℝ ∞ f W → f x₀ = 0 → fderiv ℝ f x₀ ≠ 0 →
      ∃ B : Set E3, IsOpen B ∧ x₀ ∈ B ∧ B ⊆ W ∧ IsPreconnected (B ∩ {z | 0 < f z}) := by
    intro W f x₀ hW hx₀ hf hf0 hdf
    have hfa : ContDiffAt ℝ ∞ f x₀ := hf.contDiffAt (hW.mem_nhds hx₀)
    obtain ⟨L, hLdef⟩ : ∃ L : E3 →L[ℝ] ℝ, L = fderiv ℝ f x₀ := ⟨_, rfl⟩
    have hL : HasStrictFDerivAt f L x₀ := by
      rw [hLdef]; exact hfa.hasStrictFDerivAt (by simp)
    have hL0 : L ≠ 0 := by rw [hLdef]; exact hdf
    obtain ⟨v, hv⟩ : ∃ v, L v ≠ 0 := by
      by_contra h
      push_neg at h
      exact hL0 (ContinuousLinearMap.ext h)
    obtain ⟨ν, hν⟩ : ∃ ν : E3, ν = (L v)⁻¹ • v := ⟨_, rfl⟩
    have hLν : L ν = 1 := by rw [hν, map_smul, smul_eq_mul, inv_mul_cancel₀ hv]
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E3 → E3, Ψ = fun z => (z - x₀) - L (z - x₀) • ν + f z • ν :=
      ⟨_, rfl⟩
    have hkey : ∀ z, L (Ψ z) = f z := by
      intro z
      rw [hΨ]
      simp only [map_add, map_sub, map_smul, smul_eq_mul, hLν]
      ring
    have hΨ0 : Ψ x₀ = 0 := by rw [hΨ]; simp [hf0]
    have hA : HasStrictFDerivAt (fun z : E3 => z - x₀) (ContinuousLinearMap.id ℝ E3) x₀ :=
      (hasStrictFDerivAt_id x₀).sub_const x₀
    have hB : HasStrictFDerivAt (fun z : E3 => L (z - x₀) • ν) (L.smulRight ν) x₀ := by
      have h1 : HasStrictFDerivAt (fun z : E3 => L (z - x₀)) L x₀ := by
        have := L.hasStrictFDerivAt.comp x₀ hA
        simpa using this
      exact h1.smul_const ν
    have hC : HasStrictFDerivAt (fun z : E3 => f z • ν) (L.smulRight ν) x₀ := hL.smul_const ν
    have hΨd : HasStrictFDerivAt Ψ
        ((ContinuousLinearEquiv.refl ℝ E3 : E3 ≃L[ℝ] E3) : E3 →L[ℝ] E3) x₀ := by
      have h2 := (hA.sub hB).add hC
      rw [hΨ]
      refine h2.congr_fderiv ?_
      ext u
      simp
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : OpenPartialHomeomorph E3 E3,
        Φ = hΨd.toOpenPartialHomeomorph Ψ := ⟨_, rfl⟩
    have hΦc : ∀ z, Φ z = Ψ z := fun z => by
      rw [hΦdef, HasStrictFDerivAt.toOpenPartialHomeomorph_coe]
    have hx₀s : x₀ ∈ Φ.source := by rw [hΦdef]; exact hΨd.mem_toOpenPartialHomeomorph_source
    have h0t : (0 : E3) ∈ Φ.target := by
      have := hΨd.image_mem_toOpenPartialHomeomorph_target
      rw [← hΦdef, hΨ0] at this
      exact this
    have hS : IsOpen (Φ.target ∩ Φ.symm ⁻¹' W) := Φ.isOpen_inter_preimage_symm hW
    have h0S : (0 : E3) ∈ Φ.target ∩ Φ.symm ⁻¹' W := by
      refine ⟨h0t, ?_⟩
      show Φ.symm 0 ∈ W
      have h3 : Φ.symm (Φ x₀) = x₀ := Φ.left_inv hx₀s
      rw [hΦc, hΨ0] at h3
      rw [h3]
      exact hx₀
    obtain ⟨r, hr, hrS⟩ := Metric.isOpen_iff.mp hS 0 h0S
    refine ⟨Φ.source ∩ Φ ⁻¹' Metric.ball 0 r, Φ.isOpen_inter_preimage Metric.isOpen_ball,
      ⟨hx₀s, ?_⟩, ?_, ?_⟩
    · show Φ x₀ ∈ Metric.ball (0 : E3) r
      rw [hΦc, hΨ0]
      exact Metric.mem_ball_self hr
    · rintro z ⟨hzs, hzb⟩
      have h4 : Φ.symm (Φ z) ∈ W := (hrS hzb).2
      rw [Φ.left_inv hzs] at h4
      exact h4
    · have hH : IsPreconnected (Metric.ball (0 : E3) r ∩ {u | 0 < L u}) := by
        refine (Convex.inter (convex_ball 0 r) ?_).isPreconnected
        exact (convex_Ioi (0 : ℝ)).linear_preimage (L : E3 →ₗ[ℝ] ℝ)
      have heq : (Φ.source ∩ Φ ⁻¹' Metric.ball 0 r) ∩ {z | 0 < f z} =
          Φ.symm '' (Metric.ball (0 : E3) r ∩ {u | 0 < L u}) := by
        ext z
        constructor
        · rintro ⟨⟨hzs, hzb⟩, hz⟩
          refine ⟨Φ z, ⟨hzb, ?_⟩, Φ.left_inv hzs⟩
          show 0 < L (Φ z)
          rw [hΦc, hkey]
          exact hz
        · rintro ⟨u, ⟨hub, hu⟩, rfl⟩
          have hut : u ∈ Φ.target := (hrS hub).1
          refine ⟨⟨Φ.map_target hut, ?_⟩, ?_⟩
          · show Φ (Φ.symm u) ∈ Metric.ball (0 : E3) r
            rw [Φ.right_inv hut]
            exact hub
          · show 0 < f (Φ.symm u)
            rw [← hkey, ← hΦc, Φ.right_inv hut]
            exact hu
      rw [heq]
      exact hH.image _ (Φ.continuousOn_symm.mono (fun u hu => (hrS hu.1).1))
  
  obtain ⟨φ, hφ⟩ : ∃ φ : PartialEquiv M E3, φ = extChartAt 𝓘(ℝ, E3) y := ⟨_, rfl⟩
  have hyO : y ∈ interior O := mem_interior_iff_mem_nhds.mpr hO
  have hinv : φ.symm (φ y) = y := by rw [hφ]; exact extChartAt_to_inv y
  have hyt : φ y ∈ φ.target := by rw [hφ]; exact mem_extChartAt_target y
  have hys : y ∈ φ.source := by rw [hφ]; exact mem_extChartAt_source y
  have hsymmc : ContinuousOn φ.symm φ.target := by rw [hφ]; exact continuousOn_extChartAt_symm y
  have hWo : IsOpen (φ.target ∩ φ.symm ⁻¹' (V ∩ interior O)) :=
    hsymmc.isOpen_inter_preimage (by rw [hφ]; exact isOpen_extChartAt_target y)
      (hVo.inter isOpen_interior)
  have hx₀W : φ y ∈ φ.target ∩ φ.symm ⁻¹' (V ∩ interior O) := by
    refine ⟨hyt, ?_⟩
    show φ.symm (φ y) ∈ V ∩ interior O
    rw [hinv]
    exact ⟨hyV, hyO⟩
  have hfs : ContDiffOn ℝ ∞ (w ∘ φ.symm) (φ.target ∩ φ.symm ⁻¹' V) := by
    have h5 := (contMDiffOn_iff.mp hw).2 y (w y)
    rw [hφ]
    simpa [extChartAt_model_space_eq_id] using h5
  have hf : ContDiffOn ℝ ∞ (w ∘ φ.symm) (φ.target ∩ φ.symm ⁻¹' (V ∩ interior O)) :=
    hfs.mono (fun z hz => ⟨hz.1, hz.2.1⟩)
  have hf0 : (w ∘ φ.symm) (φ y) = 0 := by
    show w (φ.symm (φ y)) = 0
    rw [hinv]
    exact hy0
  have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y := by
    by_contra h
    exact hdy (mfderiv_zero_of_not_mdifferentiableAt h)
  have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y = fderiv ℝ (w ∘ φ.symm) (φ y) := by
    have hw' : writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) y w = w ∘ (extChartAt 𝓘(ℝ, E3) y).symm := by
      funext z
      simp [writtenInExtChartAt]
    rw [hmd.mfderiv, hw', ModelWithCorners.range_eq_univ, fderivWithin_univ, hφ]
  have hdf : fderiv ℝ (w ∘ φ.symm) (φ y) ≠ 0 := by
    rw [← hmf]
    exact hdy
  obtain ⟨B, hBo, hyB, hBW, hBc⟩ := euclid _ (w ∘ φ.symm) (φ y) hWo hx₀W hf hf0 hdf
  refine ⟨φ.source ∩ φ ⁻¹' B, by rw [hφ]; exact isOpen_extChartAt_preimage' y hBo,
    ⟨hys, hyB⟩, ?_, ?_⟩
  · rintro x ⟨hxs, hxB⟩
    have h6 : φ.symm (φ x) ∈ V ∩ interior O := (hBW hxB).2
    rw [φ.left_inv hxs] at h6
    exact interior_subset h6.2
  · have heq : (φ.source ∩ φ ⁻¹' B) ∩ {x | 0 < w x} =
        φ.symm '' (B ∩ {z | 0 < (w ∘ φ.symm) z}) := by
      ext x
      constructor
      · rintro ⟨⟨hxs, hxB⟩, hx⟩
        refine ⟨φ x, ⟨hxB, ?_⟩, φ.left_inv hxs⟩
        show 0 < w (φ.symm (φ x))
        rw [φ.left_inv hxs]
        exact hx
      · rintro ⟨z, ⟨hzB, hz⟩, rfl⟩
        have hzt : z ∈ φ.target := (hBW hzB).1
        refine ⟨⟨φ.map_target hzt, ?_⟩, hz⟩
        show φ (φ.symm z) ∈ B
        rw [φ.right_inv hzt]
        exact hzB
    rw [heq]
    exact hBc.image _ (hsymmc.mono (fun z hz => (hBW hz.1).1))

theorem trapped_frontier_structure [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω V F : Set M) (w : M → ℝ) (hΩo : IsOpen Ω) (hF : IsMinimalSurfaceSet g F) (hΩF : Disjoint Ω F) (hVo : IsOpen V) (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w V) (hSc : IsCompact (V ∩ w ⁻¹' {0})) (hSF : Disjoint (V ∩ w ⁻¹' {0}) F) (hdw : ∀ x ∈ V, w x = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) (hΩV : ∀ x ∈ Ω ∩ V, 0 < w x) (hfr : frontier Ω ⊆ (V ∩ w ⁻¹' {0}) ∪ F) : frontier Ω = (V ∩ w ⁻¹' {0} ∩ closure Ω) ∪ (frontier Ω ∩ F) ∧ IsCompact (V ∩ w ⁻¹' {0} ∩ closure Ω) ∧ (∃ U₀ : Set M, IsOpen U₀ ∧ V ∩ w ⁻¹' {0} ∩ closure Ω ⊆ U₀ ∧ U₀ ∩ (V ∩ w ⁻¹' {0}) ⊆ closure Ω) ∧ IsMinimalSurfaceSet g (frontier Ω ∩ F) ∧ (∀ y ∈ frontier Ω, ∃ (N : Set M) (f : M → ℝ), IsOpen N ∧ y ∈ N ∧ ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f N ∧ (∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧ N ∩ frontier Ω ⊆ f ⁻¹' {0} ∧ (N ∩ Ω = N ∩ {x | 0 < f x} ∨ N ∩ Ω = N ∩ {x | f x ≠ 0})) :=
by
  
  have hfermat : ∀ (f : M → ℝ) (x : M), mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 →
      ¬ IsLocalMax f x ∧ ¬ IsLocalMin f x := by
    intro f x hdf
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x := by
      by_contra h
      exact hdf (mfderiv_zero_of_not_mdifferentiableAt h)
    have hw' : writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) x f =
        f ∘ (extChartAt 𝓘(ℝ, E3) x).symm := by
      funext z
      simp [writtenInExtChartAt, extChartAt_model_space_eq_id]
    have h0 : (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) = x :=
      extChartAt_to_inv x
    have ht : Tendsto (extChartAt 𝓘(ℝ, E3) x).symm (𝓝 (extChartAt 𝓘(ℝ, E3) x x)) (𝓝 x) := by
      have hca : ContinuousAt (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) :=
        continuousAt_extChartAt_symm (I := 𝓘(ℝ, E3)) x
      have := hca.tendsto
      rwa [h0] at this
    have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x =
        fderiv ℝ (f ∘ (extChartAt 𝓘(ℝ, E3) x).symm) (extChartAt 𝓘(ℝ, E3) x x) := by
      rw [hmd.mfderiv, hw', ModelWithCorners.range_eq_univ, fderivWithin_univ]
    constructor
    · intro hloc
      have hlm : IsLocalMax (f ∘ (extChartAt 𝓘(ℝ, E3) x).symm) (extChartAt 𝓘(ℝ, E3) x x) := by
        have hev := ht.eventually hloc
        filter_upwards [hev] with z hz
        simp only [Function.comp, h0]
        exact hz
      exact hdf (hmf.trans hlm.fderiv_eq_zero)
    · intro hloc
      have hlm : IsLocalMin (f ∘ (extChartAt 𝓘(ℝ, E3) x).symm) (extChartAt 𝓘(ℝ, E3) x x) := by
        have hev := ht.eventually hloc
        filter_upwards [hev] with z hz
        simp only [Function.comp, h0]
        exact hz
      exact hdf (hmf.trans hlm.fderiv_eq_zero)
  
  have hsign : ∀ (f : M → ℝ) (x : M), f x = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 →
      ∀ O ∈ 𝓝 x, (∃ z ∈ O, 0 < f z) ∧ (∃ z ∈ O, f z < 0) := by
    intro f x hx hdf O hO
    obtain ⟨hmax, hmin⟩ := hfermat f x hdf
    constructor
    · by_contra hc
      push_neg at hc
      exact hmax (Filter.eventually_of_mem hO (fun z hz => by rw [hx]; exact hc z hz))
    · by_contra hc
      push_neg at hc
      exact hmin (Filter.eventually_of_mem hO (fun z hz => by rw [hx]; exact hc z hz))
  have hclsides : ∀ (f : M → ℝ) (N : Set M) (x : M), IsOpen N → x ∈ N → f x = 0 →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 →
      x ∈ closure (N ∩ {z | 0 < f z}) ∧ x ∈ closure (N ∩ {z | f z < 0}) := by
    intro f N x hNo hxN hx0 hdf
    constructor
    · rw [mem_closure_iff_nhds]
      intro t ht
      obtain ⟨⟨u, hu, hupos⟩, -⟩ :=
        hsign f x hx0 hdf (t ∩ N) (Filter.inter_mem ht (hNo.mem_nhds hxN))
      exact ⟨u, hu.1, hu.2, hupos⟩
    · rw [mem_closure_iff_nhds]
      intro t ht
      obtain ⟨-, ⟨u, hu, huneg⟩⟩ :=
        hsign f x hx0 hdf (t ∩ N) (Filter.inter_mem ht (hNo.mem_nhds hxN))
      exact ⟨u, hu.1, hu.2, huneg⟩
  
  have hP₀c : IsClosed (V ∩ w ⁻¹' {0}) := hSc.isClosed
  have hFc : IsClosed F := hF.1
  have hPΩ : ∀ x, x ∈ V ∩ w ⁻¹' {0} → x ∉ Ω := by
    intro x hx hxΩ
    have h1 := hΩV x ⟨hxΩ, hx.1⟩
    have h2 : w x = 0 := hx.2
    linarith
  have hfrΩ : ∀ x, x ∈ closure Ω → x ∉ Ω → x ∈ frontier Ω := by
    intro x h1 h2
    rw [hΩo.frontier_eq]
    exact ⟨h1, h2⟩
  have hC1 : frontier Ω = (V ∩ w ⁻¹' {0} ∩ closure Ω) ∪ (frontier Ω ∩ F) := by
    ext z
    constructor
    · intro hz
      rcases hfr hz with h | h
      · exact Or.inl ⟨h, frontier_subset_closure hz⟩
      · exact Or.inr ⟨hz, h⟩
    · rintro (h | h)
      · exact hfrΩ z h.2 (hPΩ z h.1)
      · exact h.1
  have hC2 : IsCompact (V ∩ w ⁻¹' {0} ∩ closure Ω) := hSc.inter_right isClosed_closure
  
  have hbox : ∀ y ∈ V ∩ w ⁻¹' {0} ∩ closure Ω, ∃ N : Set M, IsOpen N ∧ y ∈ N ∧ N ⊆ V ∧
      N ⊆ Fᶜ ∧ (∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) ∧
      N ∩ Ω = N ∩ {x | 0 < w x} ∧ N ∩ (V ∩ w ⁻¹' {0}) ⊆ closure Ω := by
    rintro y ⟨⟨hyV, hy0⟩, hyc⟩
    have hy0' : w y = 0 := hy0
    have hyF : y ∉ F := fun h => Set.disjoint_left.1 hSF ⟨hyV, hy0⟩ h
    have hR := mfderiv_ne_zero_eventually V w hVo hw y hyV (hdw y hyV hy0')
    have hO : V ∩ Fᶜ ∩ {x | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0} ∈ 𝓝 y :=
      Filter.inter_mem (Filter.inter_mem (hVo.mem_nhds hyV) (hFc.isOpen_compl.mem_nhds hyF)) hR
    obtain ⟨N, hNo, hyN, hNO, hNc⟩ :=
      regular_level_positive_side_box V w hVo hw y hyV hy0' (hdw y hyV hy0') _ hO
    have hNV : N ⊆ V := fun x hx => (hNO hx).1.1
    have hNF : N ⊆ Fᶜ := fun x hx => (hNO hx).1.2
    have hNR : ∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 := fun x hx => (hNO hx).2
    have hsub : N ∩ {x | 0 < w x} ⊆ Ω := by
      refine hNc.subset_of_closure_inter_subset hΩo ?_ ?_
      · obtain ⟨x, hxN, hxΩ⟩ := mem_closure_iff_nhds.1 hyc N (hNo.mem_nhds hyN)
        exact ⟨x, ⟨hxN, hΩV x ⟨hxΩ, hNV hxN⟩⟩, hxΩ⟩
      · rintro z ⟨hzc, hzN, hzpos⟩
        by_contra hzΩ
        rcases hfr (hfrΩ z hzc hzΩ) with h | h
        · have h2 : w z = 0 := h.2
          have h3 : (0 : ℝ) < w z := hzpos
          linarith
        · exact hNF hzN h
    refine ⟨N, hNo, hyN, hNV, hNF, hNR, ?_, ?_⟩
    · ext x
      constructor
      · rintro ⟨hxN, hxΩ⟩
        exact ⟨hxN, hΩV x ⟨hxΩ, hNV hxN⟩⟩
      · rintro ⟨hxN, hxp⟩
        exact ⟨hxN, hsub ⟨hxN, hxp⟩⟩
    · rintro z ⟨hzN, hzV, hz0⟩
      have hz0' : w z = 0 := hz0
      rw [mem_closure_iff_nhds]
      intro t ht
      obtain ⟨⟨u, hu, hupos⟩, -⟩ :=
        hsign w z hz0' (hNR z hzN) (t ∩ N) (Filter.inter_mem ht (hNo.mem_nhds hzN))
      exact ⟨u, hu.1, hsub ⟨hu.2, hupos⟩⟩
  choose! Nf hNf using hbox
  
  have hC3 : ∃ U₀ : Set M, IsOpen U₀ ∧ V ∩ w ⁻¹' {0} ∩ closure Ω ⊆ U₀ ∧
      U₀ ∩ (V ∩ w ⁻¹' {0}) ⊆ closure Ω := by
    refine ⟨⋃ y ∈ V ∩ w ⁻¹' {0} ∩ closure Ω, Nf y,
      isOpen_biUnion (fun y hy => (hNf y hy).1), ?_, ?_⟩
    · intro y hy
      exact Set.mem_iUnion₂.2 ⟨y, hy, (hNf y hy).2.1⟩
    · rintro z ⟨hz, hzP⟩
      obtain ⟨y, hy, hzy⟩ := Set.mem_iUnion₂.1 hz
      exact (hNf y hy).2.2.2.2.2.2 ⟨hzy, hzP⟩
  
  have hKF : ∀ p ∈ frontier Ω ∩ F, ∀ O ∈ 𝓝 p, ∃ (Vc : Set M) (f : M → ℝ), Vc ⊆ O ∧ IsOpen Vc ∧
      p ∈ Vc ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x ∈ Vc, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      Vc ∩ (frontier Ω ∩ F) = Vc ∩ f ⁻¹' {0} ∧
      (∀ x ∈ Vc, f x = 0 → g.levelMeanCurv f x = 0) ∧
      IsPreconnected (Vc ∩ {x | 0 < f x}) ∧ IsPreconnected (Vc ∩ {x | f x < 0}) ∧
      Vc ∩ frontier Ω ⊆ f ⁻¹' {0} ∧
      (Vc ∩ Ω = Vc ∩ {x | 0 < f x} ∨ Vc ∩ Ω = Vc ∩ {x | f x < 0} ∨
        Vc ∩ Ω = Vc ∩ {x | f x ≠ 0}) := by
    rintro p ⟨hpfr, hpF⟩ O hO
    have hpP : p ∉ V ∩ w ⁻¹' {0} := fun h => Set.disjoint_left.1 hSF h hpF
    obtain ⟨Vc, f, hVO, hVo', hpV, hf, hdf, hVS, hH, hPc, hNc⟩ :=
      hF.2 p hpF (O ∩ (V ∩ w ⁻¹' {0})ᶜ) (Filter.inter_mem hO (hP₀c.isOpen_compl.mem_nhds hpP))
    have hfrN : ∀ z ∈ Vc, z ∈ frontier Ω → z ∈ F := by
      intro z hzV hz
      rcases hfr hz with h | h
      · exact absurd h (hVO hzV).2
      · exact h
    have hzF : ∀ z ∈ Vc, z ∈ F ↔ f z = 0 := by
      intro z hz
      constructor
      · intro h
        have h' : z ∈ Vc ∩ F := ⟨hz, h⟩
        rw [hVS] at h'
        exact h'.2
      · intro h
        have h' : z ∈ Vc ∩ f ⁻¹' {0} := ⟨hz, h⟩
        rw [← hVS] at h'
        exact h'.2
    have hne : ∀ x ∈ Vc, x ∈ Ω → f x ≠ 0 := fun x hx hxΩ h0 =>
      Set.disjoint_left.1 hΩF hxΩ ((hzF x hx).2 h0)
    have hdich : ∀ S : Set M, S ⊆ Vc → (∀ x ∈ S, f x ≠ 0) → IsPreconnected S →
        S ⊆ Ω ∨ Disjoint S Ω := by
      intro S hSV hS0 hSc'
      by_cases hne' : (S ∩ Ω).Nonempty
      · left
        refine hSc'.subset_of_closure_inter_subset hΩo hne' ?_
        rintro z ⟨hzc, hzS⟩
        by_contra hzΩ
        exact hS0 z hzS ((hzF z (hSV hzS)).1 (hfrN z (hSV hzS) (hfrΩ z hzc hzΩ)))
      · right
        rw [Set.disjoint_iff_inter_eq_empty]
        exact Set.not_nonempty_iff_eq_empty.1 hne'
    have hDp := hdich (Vc ∩ {x | 0 < f x}) Set.inter_subset_left
      (fun x hx => ne_of_gt hx.2) hPc
    have hDn := hdich (Vc ∩ {x | f x < 0}) Set.inter_subset_left
      (fun x hx => ne_of_lt hx.2) hNc
    obtain ⟨x₀, hx₀V, hx₀Ω⟩ :=
      mem_closure_iff_nhds.1 (frontier_subset_closure hpfr) Vc (hVo'.mem_nhds hpV)
    have hnotboth : ¬ (Disjoint (Vc ∩ {x | 0 < f x}) Ω ∧ Disjoint (Vc ∩ {x | f x < 0}) Ω) := by
      rintro ⟨hp', hn'⟩
      rcases lt_or_gt_of_ne (hne x₀ hx₀V hx₀Ω) with h | h
      · exact Set.disjoint_left.1 hn' ⟨hx₀V, h⟩ hx₀Ω
      · exact Set.disjoint_left.1 hp' ⟨hx₀V, h⟩ hx₀Ω
    have htri : Vc ∩ Ω = Vc ∩ {x | 0 < f x} ∨ Vc ∩ Ω = Vc ∩ {x | f x < 0} ∨
        Vc ∩ Ω = Vc ∩ {x | f x ≠ 0} := by
      rcases hDp with hp' | hp' <;> rcases hDn with hn' | hn'
      · right; right
        ext x
        constructor
        · rintro ⟨hxV, hxΩ⟩
          exact ⟨hxV, hne x hxV hxΩ⟩
        · rintro ⟨hxV, hx0⟩
          refine ⟨hxV, ?_⟩
          rcases lt_or_gt_of_ne hx0 with h | h
          · exact hn' ⟨hxV, h⟩
          · exact hp' ⟨hxV, h⟩
      · left
        ext x
        constructor
        · rintro ⟨hxV, hxΩ⟩
          refine ⟨hxV, ?_⟩
          rcases lt_or_gt_of_ne (hne x hxV hxΩ) with h | h
          · exact absurd hxΩ (Set.disjoint_left.1 hn' ⟨hxV, h⟩)
          · exact h
        · rintro ⟨hxV, h⟩
          exact ⟨hxV, hp' ⟨hxV, h⟩⟩
      · right; left
        ext x
        constructor
        · rintro ⟨hxV, hxΩ⟩
          refine ⟨hxV, ?_⟩
          rcases lt_or_gt_of_ne (hne x hxV hxΩ) with h | h
          · exact h
          · exact absurd hxΩ (Set.disjoint_left.1 hp' ⟨hxV, h⟩)
        · rintro ⟨hxV, h⟩
          exact ⟨hxV, hn' ⟨hxV, h⟩⟩
      · exact absurd ⟨hp', hn'⟩ hnotboth
    have hFfr : ∀ x ∈ Vc, x ∈ F → x ∈ frontier Ω := by
      intro x hxV hxF
      have hx0 := (hzF x hxV).1 hxF
      obtain ⟨hcp, hcn⟩ := hclsides f Vc x hVo' hxV hx0 (hdf x hxV)
      have hxc : x ∈ closure Ω := by
        rcases hDp with hp' | hp'
        · exact closure_mono hp' hcp
        · rcases hDn with hn' | hn'
          · exact closure_mono hn' hcn
          · exact absurd ⟨hp', hn'⟩ hnotboth
      exact hfrΩ x hxc (fun hxΩ => Set.disjoint_left.1 hΩF hxΩ hxF)
    refine ⟨Vc, f, fun x hx => (hVO hx).1, hVo', hpV, hf, hdf, ?_, hH, hPc, hNc, ?_, htri⟩
    · ext x
      constructor
      · rintro ⟨hxV, -, hxF⟩
        exact ⟨hxV, (hzF x hxV).1 hxF⟩
      · rintro ⟨hxV, hx0⟩
        have hxF := (hzF x hxV).2 hx0
        exact ⟨hxV, hFfr x hxV hxF, hxF⟩
    · rintro x ⟨hxV, hxfr⟩
      exact (hzF x hxV).1 (hfrN x hxV hxfr)
  
  have hC4 : IsMinimalSurfaceSet g (frontier Ω ∩ F) := by
    refine ⟨isClosed_frontier.inter hFc, fun p hp O hO => ?_⟩
    obtain ⟨Vc, f, h1, h2, h3, h4, h5, h6, h7, h8, h9, -, -⟩ := hKF p hp O hO
    exact ⟨Vc, f, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩
  
  have hC5 : ∀ y ∈ frontier Ω, ∃ (N : Set M) (f : M → ℝ), IsOpen N ∧ y ∈ N ∧
      ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f N ∧ (∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      N ∩ frontier Ω ⊆ f ⁻¹' {0} ∧
      (N ∩ Ω = N ∩ {x | 0 < f x} ∨ N ∩ Ω = N ∩ {x | f x ≠ 0}) := by
    intro y hy
    rcases (Set.ext_iff.1 hC1 y).1 hy with hyP | hyKF
    · obtain ⟨hNo, hyN, hNV, hNF, hNR, hNΩ, -⟩ := hNf y hyP
      refine ⟨Nf y, w, hNo, hyN, hw.mono hNV, hNR, ?_, Or.inl hNΩ⟩
      rintro z ⟨hzN, hzfr⟩
      rcases hfr hzfr with h | h
      · exact h.2
      · exact absurd h (hNF hzN)
    · obtain ⟨Vc, f, -, hVo', hpV, hf, hdf, -, -, -, -, hfr0, htri⟩ :=
        hKF y hyKF Set.univ Filter.univ_mem
      rcases htri with h | h | h
      · exact ⟨Vc, f, hVo', hpV, hf.contMDiffOn, hdf, hfr0, Or.inl h⟩
      · refine ⟨Vc, fun x => -f x, hVo', hpV, hf.neg.contMDiffOn, ?_, ?_, Or.inl ?_⟩
        · intro x hx
          rw [show (fun x => -f x) = -f from rfl, mfderiv_neg]
          exact neg_ne_zero.mpr (hdf x hx)
        · intro x hx
          have h0 : f x = 0 := hfr0 hx
          show -f x = 0
          rw [h0, neg_zero]
        · rw [h]
          ext x
          simp
      · exact ⟨Vc, f, hVo', hpV, hf.contMDiffOn, hdf, hfr0, Or.inr h⟩
  exact ⟨hC1, hC2, hC3, hC4, hC5⟩

theorem regular_level_tube [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (V Q P : Set M) (w : M → ℝ) (hVo : IsOpen V) (hQo : IsOpen Q) (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w V) (hPc : IsCompact P) (hPV : P ⊆ V) (hPQ : P ⊆ Q) (hP0 : ∀ x ∈ P, w x = 0) (hdw : ∀ x ∈ P, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) (hH : ∀ x ∈ P, g.levelMeanCurv w x < 0) (U₀ : Set M) (hU₀ : IsOpen U₀) (hPU₀ : P ⊆ U₀) (hU₀P : ∀ x ∈ U₀ ∩ V, w x = 0 → x ∈ P) : ∃ (T : Set M) (μ : ℝ), IsOpen T ∧ P ⊆ T ∧ IsCompact (closure T) ∧ closure T ⊆ V ∩ Q ∧ 0 < μ ∧ (∀ x ∈ closure T, x ∉ T → μ ≤ |w x|) ∧ (∀ x ∈ closure T, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 ∧ g.levelMeanCurv w x < 0) :=
by
  classical
  
  have hcoordCongr : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F₁ F₂ : E3 → ℝ) (y₀ : E3),
      F₁ =ᶠ[𝓝 y₀] F₂ → levelMeanCurvCoord G F₁ y₀ = levelMeanCurvCoord G F₂ y₀ := by
    intro G F₁ F₂ y₀ hF
    have hb : ∀ k, partialDeriv k F₁ y₀ = partialDeriv k F₂ y₀ := by
      intro k
      show fderiv ℝ F₁ y₀ (e k) = fderiv ℝ F₂ y₀ (e k)
      rw [hF.fderiv_eq]
    have hc : ∀ k, partialDeriv k F₁ =ᶠ[𝓝 y₀] partialDeriv k F₂ := by
      intro k
      filter_upwards [hF.eventuallyEq_nhds] with z hz
      show fderiv ℝ F₁ z (e k) = fderiv ℝ F₂ z (e k)
      rw [hz.fderiv_eq]
    have hd : ∀ i k, partialDeriv i (partialDeriv k F₁) y₀ =
        partialDeriv i (partialDeriv k F₂) y₀ := by
      intro i k
      show fderiv ℝ (partialDeriv k F₁) y₀ (e i) = fderiv ℝ (partialDeriv k F₂) y₀ (e i)
      rw [(hc k).fderiv_eq]
    simp only [levelMeanCurvCoord, lapLoc, hessLoc, hb, hd]
  
  have hsm : ∀ x₀ : M, IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' V) ∧
      ContDiffOn ℝ ∞ (fun z => w ((chartAt E3 x₀).symm z))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' V) := by
    intro x₀
    refine ⟨(chartAt E3 x₀).isOpen_inter_preimage_symm hVo, ?_⟩
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w ∘ (chartAt E3 x₀).symm)
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' V) :=
      hw.comp ((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (x := x₀)).mono Set.inter_subset_left)
        (fun z hz => hz.2)
    exact contMDiffOn_iff_contDiffOn.1 h1
  
  have hlmcChart : ∀ x₀ y : M, y ∈ V → y ∈ (chartAt E3 x₀).source →
      g.levelMeanCurv w y = levelMeanCurvCoord (g.coeff (chartAt E3 x₀).symm)
        (fun z => w ((chartAt E3 x₀).symm z)) (chartAt E3 x₀ y) := by
    intro x₀ y hyV hys
    obtain ⟨χ, -, hχ⟩ := (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) y).mem_iff.1
      (hVo.mem_nhds hyV)
    set f : M → ℝ := fun x => χ x * w x with hfdef
    have hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
      apply contMDiff_of_tsupport
      intro x hx
      have hxV : x ∈ V := hχ (tsupport_mul_subset_left hx)
      exact (χ.contMDiff.contMDiffAt).mul (hw.contMDiffAt (hVo.mem_nhds hxV))
    have hfw : f =ᶠ[𝓝 y] w := by
      filter_upwards [χ.eventuallyEq_one] with x hx
      simp only [hfdef]
      rw [hx]
      simp
    have hcg : g.levelMeanCurv w y = g.levelMeanCurv f y := by
      show levelMeanCurvCoord (g.coeff (chartAt E3 y).symm) (fun z => w ((chartAt E3 y).symm z))
          (chartAt E3 y y) =
        levelMeanCurvCoord (g.coeff (chartAt E3 y).symm) (fun z => f ((chartAt E3 y).symm z))
          (chartAt E3 y y)
      apply hcoordCongr
      have hy0 : chartAt E3 y y ∈ (chartAt E3 y).target :=
        (chartAt E3 y).map_source (mem_chart_source E3 y)
      have h1 : Tendsto (chartAt E3 y).symm (𝓝 (chartAt E3 y y))
          (𝓝 ((chartAt E3 y).symm (chartAt E3 y y))) := (chartAt E3 y).continuousAt_symm hy0
      rw [(chartAt E3 y).left_inv (mem_chart_source E3 y)] at h1
      exact hfw.symm.comp_tendsto h1
    set κ := chartAt E3 x₀ with hκ
    have hys' : κ y ∈ κ.target := κ.map_source hys
    have ht : Tendsto κ.symm (𝓝 (κ y)) (𝓝 y) := by
      have h1 : Tendsto κ.symm (𝓝 (κ y)) (𝓝 (κ.symm (κ y))) := κ.continuousAt_symm hys'
      rw [κ.left_inv hys] at h1
      exact h1
    have hfh : ∀ᶠ z in 𝓝 (κ y), f (κ.symm z) = w (κ.symm z) := hfw.comp_tendsto ht
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      PartialDiffeomorph.mk κ.symm.toPartialEquiv κ.open_target κ.open_source
        contMDiffOn_chart_symm contMDiffOn_chart
    have hl := levelMeanCurv_eq_coord g Φ f (fun z => w (κ.symm z)) hf (κ y) hys' hfh
    have e1 : Φ (κ y) = y := κ.left_inv hys
    have e2 : g.coeff Φ = g.coeff κ.symm := rfl
    rw [e1, e2] at hl
    rw [hcg, hl]
  
  have hmfChart : ∀ x₀ y : M, y ∈ V → y ∈ (chartAt E3 x₀).source →
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y = 0 ↔
        fderiv ℝ (fun z => w ((chartAt E3 x₀).symm z)) (chartAt E3 x₀ y) = 0) := by
    intro x₀ y hyV hys
    obtain ⟨hWo, hh⟩ := hsm x₀
    set κ := chartAt E3 x₀ with hκ
    have hy : κ y ∈ κ.target := κ.map_source hys
    have hwd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y :=
      (hw.contMDiffAt (hVo.mem_nhds hyV)).mdifferentiableAt (by simp)
    constructor
    · intro H
      have hfd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w (κ.symm (κ y)) := by
        rw [κ.left_inv hys]; exact hwd
      have hsd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ.symm (κ y) :=
        mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
      have hc := mfderiv_comp (κ y) hfd hsd
      have H' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w (κ.symm (κ y)) = 0 := by
        rw [κ.left_inv hys]; exact H
      rw [H', ContinuousLinearMap.zero_comp, mfderiv_eq_fderiv] at hc
      exact hc
    · intro H
      have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ y :=
        mdifferentiableAt_atlas (chart_mem_atlas E3 x₀) hys
      have hyW : κ y ∈ κ.target ∩ κ.symm ⁻¹' V :=
        ⟨hy, show κ.symm (κ y) ∈ V by rw [κ.left_inv hys]; exact hyV⟩
      have hhd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => w (κ.symm z)) (κ y) := by
        have h1 : DifferentiableAt ℝ (fun z => w (κ.symm z)) (κ y) :=
          (hh.contDiffAt (hWo.mem_nhds hyW)).differentiableAt (by simp)
        exact h1.mdifferentiableAt
      have hc := mfderiv_comp y hhd hmd
      have h2 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => w (κ.symm z)) (κ y) = 0 := by
        rw [mfderiv_eq_fderiv]; exact H
      have hev : w =ᶠ[𝓝 y] ((fun z => w (κ.symm z)) ∘ κ) := by
        filter_upwards [κ.open_source.mem_nhds hys] with x hx
        simp only [Function.comp_apply, κ.left_inv hx]
      rw [hev.mfderiv_eq, hc, h2, ContinuousLinearMap.zero_comp]
  
  have hLcont : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (h : E3 → ℝ) (W : Set E3), IsOpen W →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) W) → ContDiffOn ℝ ∞ h W →
      ∀ z₀ ∈ W, (G z₀).det ≠ 0 →
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G z₀)⁻¹ i j * partialDeriv i h z₀ * partialDeriv j h z₀) ≠ 0 →
      ContinuousAt (levelMeanCurvCoord G h) z₀ := by
    intro G h W hW hG hh z₀ hz₀ hdet hN
    have hWn : W ∈ 𝓝 z₀ := hW.mem_nhds hz₀
    have hsum : ∀ F : Fin 3 → E3 → ℝ, (∀ l, ContinuousAt (F l) z₀) →
        ContinuousAt (fun y => ∑ l, F l y) z₀ := by
      intro F hF
      simp only [Fin.sum_univ_three]
      exact ((hF 0).add (hF 1)).add (hF 2)
    have hpd : ∀ (F : E3 → ℝ), ContDiffOn ℝ 1 F W → ∀ k, ContinuousAt (partialDeriv k F) z₀ := by
      intro F hF k
      have h1 : ContinuousOn (fun z => fderiv ℝ F z (e k)) W :=
        (hF.continuousOn_fderiv_of_isOpen hW le_rfl).clm_apply continuousOn_const
      exact h1.continuousAt hWn
    have hh1 : ContDiffOn ℝ 1 h W := hh.of_le (by simp)
    have hd1 : ∀ k, ContinuousAt (partialDeriv k h) z₀ := hpd h hh1
    have hd2 : ∀ i k, ContinuousAt (partialDeriv i (partialDeriv k h)) z₀ := by
      intro i k
      apply hpd
      have h2 : ContDiffOn ℝ 1 (fun y => fderiv ℝ h y) W := by
        refine hh.fderiv_of_isOpen hW ?_
        first
        | (norm_num; exact_mod_cast (le_top : ((2 : ℕ∞) ≤ ⊤)))
        | exact_mod_cast (le_top : ((2 : ℕ∞) ≤ ⊤))
        | exact WithTop.coe_le_coe.2 le_top
        | (norm_num; exact WithTop.coe_le_coe.2 le_top)
        | (norm_num; decide)
        | decide
      exact h2.clm_apply contDiffOn_const
    have hdG : ∀ k a b, ContinuousAt (partialDeriv k (fun z => G z a b)) z₀ :=
      fun k a b => hpd _ ((hG a b).of_le (by simp)) k
    have hGc : ContinuousAt G z₀ :=
      continuousAt_pi.2 fun i => continuousAt_pi.2 fun j => (hG i j).continuousOn.continuousAt hWn
    have hRI : ContinuousAt Ring.inverse (G z₀).det := by
      rw [Ring.inverse_eq_inv']; exact continuousAt_inv₀ hdet
    have hinv : ContinuousAt (fun z => (G z)⁻¹) z₀ :=
      (continuousAt_matrix_inv (G z₀) hRI).comp hGc
    have hGi : ∀ i j, ContinuousAt (fun z => (G z)⁻¹ i j) z₀ :=
      fun i j => continuousAt_pi.1 (continuousAt_pi.1 hinv i) j
    have hchr : ∀ k i j, ContinuousAt (christoffel G k i j) z₀ := by
      intro k i j
      have : ContinuousAt (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
          (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
            - partialDeriv l (fun z => G z i j) y)) z₀ :=
        continuousAt_const.mul (hsum _ fun l => (hGi k l).mul
          (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
      exact this
    have hhess : ∀ i j, ContinuousAt (hessLoc G h i j) z₀ := by
      intro i j
      have : ContinuousAt (fun y => partialDeriv i (partialDeriv j h) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k h y) z₀ :=
        (hd2 i j).sub (hsum _ fun k => (hchr k i j).mul (hd1 k))
      exact this
    have hlap : ContinuousAt (fun y => lapLoc G h y) z₀ := by
      have : ContinuousAt (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * hessLoc G h i j y)
          z₀ :=
        hsum _ fun i => hsum _ fun j => (hGi i j).mul (hhess i j)
      exact this
    have hQ : ContinuousAt (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i h y * partialDeriv j h y) z₀ :=
      hsum _ fun i => hsum _ fun j => ((hGi i j).mul (hd1 i)).mul (hd1 j)
    have hB : ContinuousAt (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ i a * partialDeriv a h y * ((G y)⁻¹ j b * partialDeriv b h y) *
          hessLoc G h i j y) z₀ :=
      hsum _ fun i => hsum _ fun j => hsum _ fun a => hsum _ fun b =>
        (((hGi i a).mul (hd1 a)).mul ((hGi j b).mul (hd1 b))).mul (hhess i j)
    have hn := hQ.sqrt
    have key := (hlap.div hn hN).sub (hB.div (hn.pow 3) (pow_ne_zero 3 hN))
    exact key
  
  have hlmcEv : ∀ x₀ ∈ P, ∀ᶠ y in 𝓝 x₀, g.levelMeanCurv w y < 0 := by
    intro x₀ hx₀
    have hx₀V := hPV hx₀
    obtain ⟨hWo, hh⟩ := hsm x₀
    have hxs : x₀ ∈ (chartAt E3 x₀).source := mem_chart_source E3 x₀
    have hL0 : levelMeanCurvCoord (g.coeff (chartAt E3 x₀).symm)
        (fun z => w ((chartAt E3 x₀).symm z)) (chartAt E3 x₀ x₀) < 0 := by
      have h := hH x₀ hx₀
      rw [hlmcChart x₀ x₀ hx₀V hxs] at h
      exact h
    set κ := chartAt E3 x₀ with hκ
    have hz₀ : κ x₀ ∈ κ.target ∩ κ.symm ⁻¹' V :=
      ⟨κ.map_source hxs, show κ.symm (κ x₀) ∈ V by rw [κ.left_inv hxs]; exact hx₀V⟩
    have hN : Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (g.coeff κ.symm (κ x₀))⁻¹ i j *
        partialDeriv i (fun z => w (κ.symm z)) (κ x₀) *
          partialDeriv j (fun z => w (κ.symm z)) (κ x₀)) ≠ 0 := by
      intro H0
      have h0 : levelMeanCurvCoord (g.coeff κ.symm) (fun z => w (κ.symm z)) (κ x₀) = 0 := by
        unfold levelMeanCurvCoord
        rw [H0]
        simp
      linarith
    have hdet : (g.coeff κ.symm (κ x₀)).det ≠ 0 :=
      (coeff_chart_symm_posDef g x₀ (κ x₀) (κ.map_source hxs)).det_pos.ne'
    have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff κ.symm z i j)
        (κ.target ∩ κ.symm ⁻¹' V) :=
      fun i j => (g.smooth x₀ i j).mono Set.inter_subset_left
    have hcont := hLcont (g.coeff κ.symm) (fun z => w (κ.symm z)) _ hWo hG hh (κ x₀) hz₀ hdet hN
    have h1 : ∀ᶠ z in 𝓝 (κ x₀),
        levelMeanCurvCoord (g.coeff κ.symm) (fun z => w (κ.symm z)) z < 0 :=
      hcont.eventually (Iio_mem_nhds hL0)
    have h2 : ∀ᶠ y in 𝓝 x₀,
        levelMeanCurvCoord (g.coeff κ.symm) (fun z => w (κ.symm z)) (κ y) < 0 :=
      (κ.continuousAt hxs).eventually h1
    filter_upwards [h2, hVo.mem_nhds hx₀V, κ.open_source.mem_nhds hxs] with y hy hyV hys
    rw [hlmcChart x₀ y hyV hys]
    exact hy
  have hmfEv : ∀ x₀ ∈ P, ∀ᶠ y in 𝓝 x₀, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w y ≠ 0 := by
    intro x₀ hx₀
    have hx₀V := hPV hx₀
    obtain ⟨hWo, hh⟩ := hsm x₀
    have hxs : x₀ ∈ (chartAt E3 x₀).source := mem_chart_source E3 x₀
    have hA : fderiv ℝ (fun z => w ((chartAt E3 x₀).symm z)) (chartAt E3 x₀ x₀) ≠ 0 :=
      fun H => hdw x₀ hx₀ ((hmfChart x₀ x₀ hx₀V hxs).2 H)
    set κ := chartAt E3 x₀ with hκ
    have hz₀ : κ x₀ ∈ κ.target ∩ κ.symm ⁻¹' V :=
      ⟨κ.map_source hxs, show κ.symm (κ x₀) ∈ V by rw [κ.left_inv hxs]; exact hx₀V⟩
    have hB : ContinuousAt (fderiv ℝ (fun z => w (κ.symm z))) (κ x₀) :=
      (hh.continuousOn_fderiv_of_isOpen hWo (by simp)).continuousAt (hWo.mem_nhds hz₀)
    have h1 : ∀ᶠ z in 𝓝 (κ x₀), fderiv ℝ (fun z => w (κ.symm z)) z ≠ 0 :=
      hB.eventually_ne hA
    have h2 : ∀ᶠ y in 𝓝 x₀, fderiv ℝ (fun z => w (κ.symm z)) (κ y) ≠ 0 :=
      (κ.continuousAt hxs).eventually h1
    filter_upwards [h2, hVo.mem_nhds hx₀V, κ.open_source.mem_nhds hxs] with y hy hyV hys
    exact fun H => hy ((hmfChart x₀ y hyV hys).1 H)
  
  set S : Set M := {x | x ∈ V ∧ x ∈ Q ∧ x ∈ U₀ ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 ∧
    g.levelMeanCurv w x < 0} with hSdef
  set O : Set M := interior S with hOdef
  have hOo : IsOpen O := isOpen_interior
  have hPO : P ⊆ O := by
    intro x₀ hx₀
    rw [hOdef, mem_interior_iff_mem_nhds]
    filter_upwards [hVo.mem_nhds (hPV hx₀), hQo.mem_nhds (hPQ hx₀), hU₀.mem_nhds (hPU₀ hx₀),
      hmfEv x₀ hx₀, hlmcEv x₀ hx₀] with y h1 h2 h3 h4 h5
    exact ⟨h1, h2, h3, h4, h5⟩
  have hOS : ∀ x ∈ O, x ∈ V ∧ x ∈ Q ∧ x ∈ U₀ ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0 ∧
      g.levelMeanCurv w x < 0 := fun x hx => by
    have h : x ∈ S := interior_subset hx
    exact h
  have hwO : ContinuousOn w O := hw.continuousOn.mono fun x hx => (hOS x hx).1
  have hz : ∀ x ∈ O, w x = 0 → x ∈ P :=
    fun x hx h0 => hU₀P x ⟨(hOS x hx).2.2.1, (hOS x hx).1⟩ h0
  haveI : LocallyCompactSpace M := ChartedSpace.locallyCompactSpace E3 M
  obtain ⟨N, hNo, hPN, hNO, hNc⟩ := exists_open_between_and_isCompact_closure hPc hOo hPO
  have hNO' : N ⊆ O := subset_closure.trans hNO
  have hFrc : IsCompact (closure N \ N) := hNc.diff hNo
  have hFrO : closure N \ N ⊆ O := fun x hx => hNO hx.1
  have hFrpos : ∀ x ∈ closure N \ N, 0 < |w x| := by
    intro x hx
    apply abs_pos.2
    intro h0
    exact hx.2 (hPN (hz x (hFrO hx) h0))
  obtain ⟨μ, hμ, hμle⟩ : ∃ μ : ℝ, 0 < μ ∧ ∀ x ∈ closure N \ N, μ ≤ |w x| := by
    rcases (closure N \ N).eq_empty_or_nonempty with he | hne
    · refine ⟨1, one_pos, ?_⟩
      intro x hx
      simp [he] at hx
    · obtain ⟨x₁, hx₁, hmin⟩ :=
        hFrc.exists_isMinOn hne (continuous_abs.comp_continuousOn (hwO.mono hFrO))
      refine ⟨|w x₁|, hFrpos x₁ hx₁, fun x hx => ?_⟩
      exact isMinOn_iff.1 hmin x hx
  set T : Set M := N ∩ (fun x => |w x|) ⁻¹' Set.Iio μ with hTdef
  have hTo : IsOpen T :=
    (continuous_abs.comp_continuousOn (hwO.mono hNO')).isOpen_inter_preimage hNo isOpen_Iio
  have hPT : P ⊆ T := by
    intro x hx
    refine ⟨hPN hx, ?_⟩
    show |w x| < μ
    rw [hP0 x hx, abs_zero]
    exact hμ
  have hTN : closure T ⊆ closure N := closure_mono Set.inter_subset_left
  have hTO : closure T ⊆ O := hTN.trans hNO
  refine ⟨T, μ, hTo, hPT, hNc.of_isClosed_subset isClosed_closure hTN,
    fun x hx => ⟨(hOS x (hTO hx)).1, (hOS x (hTO hx)).2.1⟩, hμ, ?_,
    fun x hx => ⟨(hOS x (hTO hx)).2.2.2.1, (hOS x (hTO hx)).2.2.2.2⟩⟩
  intro x hxT hxnT
  by_cases hxN : x ∈ N
  · by_contra hlt
    push_neg at hlt
    exact hxnT ⟨hxN, hlt⟩
  · exact hμle x ⟨hTN hxT, hxN⟩

theorem locally_regular_zero_set_chartNull [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (S : Set M) (hS : ∀ y ∈ S, ∃ (N : Set M) (f : M → ℝ), IsOpen N ∧ y ∈ N ∧ ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f N ∧ (∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧ N ∩ S ⊆ f ⁻¹' {0}) : sepChartNull S :=
by
  
  have s1 : ∀ (φ : E3 →L[ℝ] ℝ) (w : E3), φ w = 1 →
      (ContinuousLinearMap.id ℝ E3 - φ.smulRight w).det = 0 := by
    intro φ w hw
    have hw0 : w ≠ 0 := by
      rintro rfl
      simp at hw
    have hker : w ∈ LinearMap.ker
        ((ContinuousLinearMap.id ℝ E3 - φ.smulRight w : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) := by
      simp [hw]
    show LinearMap.det _ = 0
    rw [LinearMap.det_eq_zero_iff_ker_ne_bot]
    exact (Submodule.ne_bot_iff _).2 ⟨w, hker, hw0⟩
  
  have s2 : ∀ (s O : Set E3) (h : E3 → ℝ) (φ : E3 →L[ℝ] ℝ) (w z : E3), z ∈ s → O ∈ 𝓝 z →
      HasFDerivAt h φ z → (∀ u ∈ s ∩ O, h u = 0) →
      HasFDerivWithinAt (fun u : E3 => u) (ContinuousLinearMap.id ℝ E3 - φ.smulRight w) s z := by
    intro s O h φ w z hz hO hh h0
    have hψ : HasFDerivAt (fun u => u - h u • w)
        (ContinuousLinearMap.id ℝ E3 - φ.smulRight w) z :=
      (hasFDerivAt_id z).sub (hh.smul_const w)
    have h1 : HasFDerivWithinAt (fun u : E3 => u)
        (ContinuousLinearMap.id ℝ E3 - φ.smulRight w) (s ∩ O) z := by
      refine hψ.hasFDerivWithinAt.congr ?_ ?_
      · intro u hu
        simp [h0 u hu]
      · simp [h0 z ⟨hz, mem_of_mem_nhds hO⟩]
    exact (hasFDerivWithinAt_inter hO).1 h1
  intro p
  set φp := chartAt E3 p with hφp
  
  have s3 : ∀ (f : M → ℝ) (N : Set M) (x : M), IsOpen N → x ∈ N →
      ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f N →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 → x ∈ φp.source →
      DifferentiableAt ℝ (fun u => f (φp.symm u)) (φp x) ∧
        fderiv ℝ (fun u => f (φp.symm u)) (φp x) ≠ 0 := by
    intro f N x hNo hxN hf hdf hxs
    have hzt : φp x ∈ φp.target := φp.map_source hxs
    have hσz : φp.symm (φp x) = x := φp.left_inv hxs
    have hσ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x) :=
      ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
        (φp.open_target.mem_nhds hzt)).mdifferentiableAt (by simp)
    have hφx : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp x :=
      ((contMDiffOn_chart (n := ∞)).contMDiffAt
        (φp.open_source.mem_nhds hxs)).mdifferentiableAt (by simp)
    have hfx' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x :=
      (hf.contMDiffAt (hNo.mem_nhds hxN)).mdifferentiableAt (by simp)
    have hfx : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f (φp.symm (φp x)) := by
      rw [hσz]; exact hfx'
    have hcomp : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f ∘ φp.symm) (φp x) := hfx.comp _ hσ
    refine ⟨mdifferentiableAt_iff_differentiableAt.1 hcomp, ?_⟩
    intro h0
    have hσ' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x) := hσ
    have hev : (φp.symm ∘ φp) =ᶠ[𝓝 x] id := by
      filter_upwards [φp.open_source.mem_nhds hxs] with u hu
      exact φp.left_inv hu
    have hid : (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x)).comp
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp x) = ContinuousLinearMap.id ℝ E3 := by
      rw [← mfderiv_comp x hσ' hφx, hev.mfderiv_eq, mfderiv_id]
      rfl
    have hfd : fderiv ℝ (fun u => f (φp.symm u)) (φp x) =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f (φp.symm (φp x))).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x)) := by
      rw [← mfderiv_eq_fderiv]
      exact mfderiv_comp (φp x) hfx hσ
    have hfd' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f (φp.symm (φp x)) =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x := by
      rw [hσz]
    apply hdf
    ext v
    have h1 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp x v) = v := by
      have := congrArg (fun L : E3 →L[ℝ] E3 => L v) hid
      simpa using this
    have h2 := congrArg (fun L : E3 →L[ℝ] ℝ => L (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp x v))
      (hfd.symm.trans h0)
    simp only [ContinuousLinearMap.zero_apply, hfd'] at h2
    have h3 : (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x) ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp.symm (φp x))
        ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φp x) v)) = 0 := h2
    rw [h1] at h3
    simpa using h3
  show volume (φp '' (S ∩ φp.source)) = 0
  have key : ∀ z : E3, ∃ L : E3 →L[ℝ] E3, z ∈ φp '' (S ∩ φp.source) →
      HasFDerivWithinAt (fun u : E3 => u) L (φp '' (S ∩ φp.source)) z ∧ L.det = 0 := by
    intro z
    by_cases hz : z ∈ φp '' (S ∩ φp.source)
    · obtain ⟨x, ⟨hxS, hxs⟩, rfl⟩ := hz
      obtain ⟨N, f, hNo, hxN, hf, hdf, hNS⟩ := hS x hxS
      obtain ⟨hdiff, hne⟩ := s3 f N x hNo hxN hf (hdf x hxN) hxs
      set φ := fderiv ℝ (fun u => f (φp.symm u)) (φp x) with hφdef
      obtain ⟨v, hv⟩ : ∃ v, φ v ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact hne (ContinuousLinearMap.ext hcon)
      have hw : φ ((φ v)⁻¹ • v) = 1 := by
        rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hv]
      refine ⟨ContinuousLinearMap.id ℝ E3 - φ.smulRight ((φ v)⁻¹ • v),
        fun _ => ⟨?_, s1 φ _ hw⟩⟩
      refine s2 _ (φp.target ∩ φp.symm ⁻¹' N) (fun u => f (φp.symm u)) φ _ (φp x)
        ⟨x, ⟨hxS, hxs⟩, rfl⟩ ?_ hdiff.hasFDerivAt ?_
      · refine (φp.isOpen_inter_preimage_symm hNo).mem_nhds ⟨φp.map_source hxs, ?_⟩
        show φp.symm (φp x) ∈ N
        rw [φp.left_inv hxs]
        exact hxN
      · rintro u ⟨⟨x', ⟨hx'S, hx's⟩, rfl⟩, -, hu2⟩
        have hx'N : x' ∈ N := by
          have h3 : φp.symm (φp x') ∈ N := hu2
          rwa [φp.left_inv hx's] at h3
        have h4 : f x' = 0 := hNS ⟨hx'N, hx'S⟩
        show f (φp.symm (φp x')) = 0
        rw [φp.left_inv hx's]
        exact h4
    · exact ⟨0, fun h => absurd h hz⟩
  choose L hL using key
  have hnull := MeasureTheory.addHaar_image_eq_zero_of_det_fderivWithin_eq_zero (μ := volume)
    (fun z hz => (hL z hz).1) (fun z hz => (hL z hz).2)
  simpa using hnull

theorem hullRiemPer_inter_open_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F U K R : Set M) (hF : sepChartMeas F) (hR : IsOpen R) (hK : IsClosed K) (hRK : frontier R ⊆ K) (hKnull : sepChartNull K) (hside : ∀ y ∈ frontier R, ∃ (N : Set M) (f : M → ℝ), IsOpen N ∧ y ∈ N ∧ ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f N ∧ (∀ x ∈ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧ N ∩ frontier R ⊆ f ⁻¹' {0} ∧ (N ∩ R = N ∩ {x | 0 < f x} ∨ N ∩ R = N ∩ {x | f x ≠ 0})) : hullRiemPer g (F ∩ R) U K ≤ hullRiemPer g F U K :=
by
  
  have junk : ∀ (φ h : E3 → ℝ) (V : Set E3) (y : E3), IsOpen V → y ∈ V →
      DifferentiableAt ℝ φ y → φ y = 0 → fderiv ℝ φ y ≠ 0 →
      (∀ z ∈ V, φ z < 0 → h z = 0) → fderiv ℝ h y = 0 := by
    intro φ h V y hV hyV hφd hφ0 hdφ hh
    by_cases hhd : DifferentiableAt ℝ h y
    swap
    · exact fderiv_zero_of_not_differentiableAt hhd
    set Λ := fderiv ℝ φ y with hΛ
    set L := fderiv ℝ h y with hL
    have hray : ∀ v : E3, Λ v < 0 → h y = 0 ∧ L v = 0 := by
      intro v hv
      have hγ : HasDerivAt (fun t : ℝ => y + t • v) v 0 := by
        simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add y
      have hψ : HasDerivAt (fun t : ℝ => φ (y + t • v)) (Λ v) 0 := by
        have h1 := hφd.hasFDerivAt
        have h2 : HasFDerivAt φ Λ ((fun t : ℝ => y + t • v) 0) := by simpa using h1
        exact h2.comp_hasDerivAt (0 : ℝ) hγ
      have hk : HasDerivAt (fun t : ℝ => h (y + t • v)) (L v) 0 := by
        have h1 := hhd.hasFDerivAt
        have h2 : HasFDerivAt h L ((fun t : ℝ => y + t • v) 0) := by simpa using h1
        exact h2.comp_hasDerivAt (0 : ℝ) hγ
      have hslψ := hψ.tendsto_slope_zero_right
      have hneg : ∀ᶠ t in 𝓝[>] (0 : ℝ), t⁻¹ • (φ (y + (0 + t) • v) - φ (y + (0 : ℝ) • v)) < 0 :=
        hslψ.eventually (gt_mem_nhds hv)
      have hpos : ∀ᶠ t in 𝓝[>] (0 : ℝ), 0 < t := self_mem_nhdsWithin
      have hinV : ∀ᶠ t in 𝓝[>] (0 : ℝ), y + t • v ∈ V := by
        have hc : Tendsto (fun t : ℝ => y + t • v) (𝓝 0) (𝓝 y) := by
          have := hγ.continuousAt.tendsto
          simpa using this
        exact nhdsWithin_le_nhds (hc (hV.mem_nhds hyV))
      have hk0 : ∀ᶠ t in 𝓝[>] (0 : ℝ), h (y + t • v) = 0 := by
        filter_upwards [hneg, hpos, hinV] with t h1 h2 h3
        apply hh _ h3
        simp only [zero_add, zero_smul, add_zero, hφ0, sub_zero, smul_eq_mul] at h1
        by_contra hc
        push_neg at hc
        have : 0 ≤ t⁻¹ * φ (y + t • v) := mul_nonneg (inv_nonneg.2 h2.le) hc
        linarith
      have hy0 : h y = 0 := by
        have h1 : Tendsto (fun t : ℝ => h (y + t • v)) (𝓝[>] 0) (𝓝 (h (y + (0:ℝ) • v))) :=
          hk.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
        have h2 : Tendsto (fun t : ℝ => h (y + t • v)) (𝓝[>] 0) (𝓝 0) :=
          tendsto_const_nhds.congr' (hk0.mono fun t ht => ht.symm)
        have := tendsto_nhds_unique h1 h2
        simpa using this
      refine ⟨hy0, ?_⟩
      have h1 := hk.tendsto_slope_zero_right
      have h2 : Tendsto (fun t : ℝ => t⁻¹ • (h (y + (0 + t) • v) - h (y + (0 : ℝ) • v)))
          (𝓝[>] 0) (𝓝 0) := by
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [hk0] with t ht
        simp [ht, hy0]
      exact tendsto_nhds_unique h1 h2
    have hu : ∃ u : E3, Λ u ≠ 0 := by
      by_contra hc
      push_neg at hc
      exact hdφ (ContinuousLinearMap.ext hc)
    obtain ⟨u, hu⟩ := hu
    set v₀ : E3 := (-(Λ u)⁻¹) • u with hv₀
    have hΛv₀ : Λ v₀ = -1 := by
      rw [hv₀, map_smul, smul_eq_mul, neg_mul, inv_mul_cancel₀ hu]
    have hLv₀ : L v₀ = 0 := (hray v₀ (by rw [hΛv₀]; norm_num)).2
    ext w
    have hw : Λ (w + (Λ w + 1) • v₀) = -1 := by
      rw [map_add, map_smul, smul_eq_mul, hΛv₀]; ring
    have h1 := (hray (w + (Λ w + 1) • v₀) (by rw [hw]; norm_num)).2
    rw [map_add, map_smul, smul_eq_mul, hLv₀, mul_zero, add_zero] at h1
    simpa using h1
  
  have key : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (D U Kc Rc : Set E3), IsOpen Rc →
      volume Kc = 0 → (∀ y ∈ U, y ∈ closure Rc → y ∉ Rc → y ∈ Kc) →
      (∀ y ∈ U, y ∈ closure Rc → y ∉ Rc → ∃ (V : Set E3) (φ : E3 → ℝ), IsOpen V ∧ y ∈ V ∧
        (V ⊆ closure Rc ∨ (ContinuousOn φ V ∧ DifferentiableAt ℝ φ y ∧ φ y = 0 ∧
          fderiv ℝ φ y ≠ 0 ∧ ∀ z ∈ V, φ z < 0 → z ∉ Rc))) →
      hullPerG G (D ∩ Rc) U Kc ≤ hullPerG G D U Kc := by
    intro G D U Kc Rc hRc hKc hfr hsd
    unfold hullPerG
    refine iSup₂_le fun X hX => ?_
    obtain ⟨hXs, hXc, hXU, hXn, C, hC⟩ := hX
    set X' : E3 → E3 := (closure Rc).indicator X with hX'def
    have hF4 : ∀ (Y Z : E3 → E3) (y : E3), Y =ᶠ[𝓝 y] Z →
        sepDensDiv G Y y = sepDensDiv G Z y := by
      intro Y Z y hYZ
      unfold sepDensDiv partialDeriv
      refine Finset.sum_congr rfl fun i _ => ?_
      have : (fun z => Real.sqrt (G z).det * Y z i) =ᶠ[𝓝 y]
          (fun z => Real.sqrt (G z).det * Z z i) := by
        filter_upwards [hYZ] with z hz
        rw [hz]
      rw [this.fderiv_eq]
    have hzero : ∀ y, sepDensDiv G (0 : E3 → E3) y = 0 := by
      intro y
      simp [sepDensDiv, partialDeriv]
    have hF1 : ∀ y, y ∉ tsupport X → X' =ᶠ[𝓝 y] 0 := by
      intro y hy
      filter_upwards [(isClosed_tsupport X).isOpen_compl.mem_nhds hy] with z hz
      have h0 : X z = 0 := image_eq_zero_of_notMem_tsupport hz
      simp [X', h0]
    have hF2 : ∀ y, y ∈ Rc → X' =ᶠ[𝓝 y] X := by
      intro y hy
      filter_upwards [hRc.mem_nhds hy] with z hz
      exact Set.indicator_of_mem (subset_closure hz) X
    have hF3 : ∀ y, y ∉ closure Rc → X' =ᶠ[𝓝 y] 0 := by
      intro y hy
      filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hy] with z hz
      exact Set.indicator_of_notMem hz X
    have hF6 : ∀ y, y ∈ tsupport X → y ∈ closure Rc → y ∉ Rc →
        sepDensDiv G X' y = sepDensDiv G X y ∨ sepDensDiv G X' y = 0 := by
      intro y hyT hyc hyR
      obtain ⟨V, φ, hV, hyV, hcase⟩ := hsd y (hXU hyT) hyc hyR
      rcases hcase with hVc | ⟨hφc, hφd, hφ0, hdφ, hneg⟩
      · left
        apply hF4
        filter_upwards [hV.mem_nhds hyV] with z hz
        exact Set.indicator_of_mem (hVc hz) X
      · right
        have hO : IsOpen (V ∩ φ ⁻¹' Set.Iio 0) := hφc.isOpen_inter_preimage hV isOpen_Iio
        have hdisj : Disjoint (V ∩ φ ⁻¹' Set.Iio 0) Rc :=
          Set.disjoint_left.2 fun z hz hzR => hneg z hz.1 hz.2 hzR
        have hdisj' : Disjoint (V ∩ φ ⁻¹' Set.Iio 0) (closure Rc) := hdisj.closure_right hO
        unfold sepDensDiv partialDeriv
        refine Finset.sum_eq_zero fun i _ => ?_
        have hj := junk φ (fun z => Real.sqrt (G z).det * X' z i) V y hV hyV hφd hφ0 hdφ ?_
        · rw [hj]; rfl
        · intro z hz hφz
          have h0 : X' z = 0 := Set.indicator_of_notMem (Set.disjoint_left.1 hdisj' ⟨hz, hφz⟩) X
          simp [h0]
    have A1 : ∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X' y := by
      intro y hyK
      by_cases hyT : y ∈ tsupport X
      · by_cases hyR : y ∈ Rc
        · exact (hXs y hyK).congr_of_eventuallyEq (hF2 y hyR)
        · by_cases hyc : y ∈ closure Rc
          · exact absurd (hfr y (hXU hyT) hyc hyR) hyK
          · exact (contDiffAt_const (c := (0 : E3))).congr_of_eventuallyEq (hF3 y hyc)
      · exact (contDiffAt_const (c := (0 : E3))).congr_of_eventuallyEq (hF1 y hyT)
    have hsupp : Function.support X' ⊆ Function.support X := by
      rw [hX'def, Set.support_indicator]; exact Set.inter_subset_right
    have A2 : HasCompactSupport X' := hXc.mono hsupp
    have A3 : tsupport X' ⊆ U := (closure_mono hsupp).trans hXU
    have A4 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1 := by
      intro y
      by_cases hy : y ∈ closure Rc
      · have h1 : X' y = X y := Set.indicator_of_mem hy X
        rw [h1]; exact hXn y
      · have h1 : X' y = 0 := Set.indicator_of_notMem hy X
        rw [h1]; simp
    have hC0 : 0 ≤ C := (abs_nonneg _).trans (hC 0)
    have A5 : ∀ y, |sepDensDiv G X' y| ≤ C := by
      intro y
      by_cases hyT : y ∈ tsupport X
      · by_cases hyR : y ∈ Rc
        · rw [hF4 _ _ y (hF2 y hyR)]; exact hC y
        · by_cases hyc : y ∈ closure Rc
          · rcases hF6 y hyT hyc hyR with h | h
            · rw [h]; exact hC y
            · rw [h, abs_zero]; exact hC0
          · rw [hF4 _ _ y (hF3 y hyc), hzero y, abs_zero]; exact hC0
      · rw [hF4 _ _ y (hF1 y hyT), hzero y, abs_zero]; exact hC0
    have hpt : ∀ y, y ∉ Kc → sepDensDiv G X' y = Rc.indicator (sepDensDiv G X) y := by
      intro y hyK
      by_cases hyR : y ∈ Rc
      · rw [Set.indicator_of_mem hyR, hF4 _ _ y (hF2 y hyR)]
      · rw [Set.indicator_of_notMem hyR]
        by_cases hyT : y ∈ tsupport X
        · by_cases hyc : y ∈ closure Rc
          · exact absurd (hfr y (hXU hyT) hyc hyR) hyK
          · rw [hF4 _ _ y (hF3 y hyc), hzero]
        · rw [hF4 _ _ y (hF1 y hyT), hzero]
    have hae : ∀ᵐ y ∂(volume : Measure E3), y ∉ Kc := measure_eq_zero_iff_ae_notMem.1 hKc
    have hint : ∫ y in D, sepDensDiv G X' y = ∫ y in D ∩ Rc, sepDensDiv G X y := by
      rw [← setIntegral_indicator hRc.measurableSet]
      refine integral_congr_ae ?_
      exact ae_restrict_of_ae (hae.mono fun y hy => hpt y hy)
    refine le_iSup₂_of_le X' ⟨A1, A2, A3, A4, C, A5⟩ ?_
    rw [hint]
  
  unfold hullRiemPer
  refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun hW => ?_
  refine Finset.sum_le_sum fun k _ => ?_
  set κ := chartAt E3 (p k) with hκ
  have hWs : W k ⊆ κ.source := fun x hx => ((hW.1 k).2 hx).2
  have hWt : κ '' W k ⊆ κ.target := by
    rintro _ ⟨x, hx, rfl⟩
    exact κ.map_source (hWs hx)
  have hopen : ∀ O : Set M, IsOpen O → IsOpen (κ '' (O ∩ κ.source)) := fun O hO =>
    κ.isOpen_image_of_subset_source (hO.inter κ.open_source) Set.inter_subset_right
  have himg : κ '' ((F ∩ R) ∩ κ.source) = κ '' (F ∩ κ.source) ∩ κ '' (R ∩ κ.source) := by
    rw [← κ.injOn.image_inter Set.inter_subset_right Set.inter_subset_right]
    congr 1
    ext x
    simp only [Set.mem_inter_iff]
    tauto
  have hpull : ∀ y ∈ κ.target, y ∈ closure (κ '' (R ∩ κ.source)) →
      y ∉ κ '' (R ∩ κ.source) → κ.symm y ∈ frontier R := by
    intro y hyt hyc hyR
    have hx : κ.symm y ∈ closure (κ.symm '' (κ '' (R ∩ κ.source))) :=
      mem_closure_image (κ.continuousAt_symm hyt) hyc
    have hsub : κ.symm '' (κ '' (R ∩ κ.source)) ⊆ R := by
      rintro _ ⟨_, ⟨a, ⟨haR, has⟩, rfl⟩, rfl⟩
      rw [κ.left_inv has]
      exact haR
    rw [hR.frontier_eq]
    exact ⟨closure_mono hsub hx, fun hxR => hyR ⟨κ.symm y, ⟨hxR, κ.map_target hyt⟩,
      κ.right_inv hyt⟩⟩
  rw [himg]
  refine key _ _ _ _ _ (hopen R hR) (hKnull (p k)) ?_ ?_
  · intro y hy hyc hyR
    exact ⟨κ.symm y, ⟨hRK (hpull y (hWt hy) hyc hyR), κ.map_target (hWt hy)⟩,
      κ.right_inv (hWt hy)⟩
  · intro y hy hyc hyR
    have hyt := hWt hy
    have hxfr := hpull y hyt hyc hyR
    obtain ⟨x, hxs, rfl⟩ : ∃ x ∈ κ.source, κ x = y :=
      ⟨κ.symm y, κ.map_target hyt, κ.right_inv hyt⟩
    rw [κ.left_inv hxs] at hxfr
    obtain ⟨N, f, hNo, hxN, hf, hdf, hNfr, hcase⟩ := hside x hxfr
    have hVo := hopen N hNo
    have hyV : κ x ∈ κ '' (N ∩ κ.source) := ⟨x, ⟨hxN, hxs⟩, rfl⟩
    refine ⟨κ '' (N ∩ κ.source), fun z => f (κ.symm z), hVo, hyV, ?_⟩
    rcases hcase with h1 | h2
    · 
      right
      have hVt : κ '' (N ∩ κ.source) ⊆ κ.target := by
        rintro _ ⟨w, hw, rfl⟩
        exact κ.map_source hw.2
      have hmaps : Set.MapsTo κ.symm (κ '' (N ∩ κ.source)) N := by
        rintro _ ⟨w, ⟨hwN, hws⟩, rfl⟩
        rw [κ.left_inv hws]
        exact hwN
      have hφs : ContDiffOn ℝ ∞ (fun z => f (κ.symm z)) (κ '' (N ∩ κ.source)) := by
        have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ κ.symm) (κ '' (N ∩ κ.source)) :=
          hf.comp (contMDiffOn_chart_symm.mono hVt) hmaps
        exact contMDiffOn_iff_contDiffOn.mp h1
      have hφd : DifferentiableAt ℝ (fun z => f (κ.symm z)) (κ x) :=
        (hφs.contDiffAt (hVo.mem_nhds hyV)).differentiableAt (by simp)
      refine ⟨hφs.continuousOn, hφd, ?_, ?_, ?_⟩
      · show f (κ.symm (κ x)) = 0
        rw [κ.left_inv hxs]
        exact hNfr ⟨hxN, hxfr⟩
      · intro h0
        have hκd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ x :=
          mdifferentiableAt_atlas (chart_mem_atlas E3 (p k)) hxs
        have hev : f =ᶠ[𝓝 x] (fun z => f (κ.symm z)) ∘ κ := by
          filter_upwards [κ.open_source.mem_nhds hxs] with v hv
          simp only [Function.comp_apply, κ.left_inv hv]
        have hm : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x =
            mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ((fun z => f (κ.symm z)) ∘ κ) x := hev.mfderiv_eq
        rw [mfderiv_comp x hφd.mdifferentiableAt hκd, mfderiv_eq_fderiv, h0] at hm
        apply hdf x hxN
        rw [hm]
        rfl
      · rintro _ ⟨w, ⟨hwN, hws⟩, rfl⟩ hneg ⟨b, ⟨hbR, hbs⟩, hb⟩
        have hbw : b = w := κ.injOn hbs hws hb
        rw [hbw] at hbR
        have hw : w ∈ N ∩ {x | 0 < f x} := h1 ▸ ⟨hwN, hbR⟩
        have hneg' : f w < 0 := by
          have h := hneg
          simp only [κ.left_inv hws] at h
          exact h
        exact absurd hw.2 (not_lt.2 hneg'.le)
    · 
      left
      rintro _ ⟨w, ⟨hwN, hws⟩, rfl⟩
      have hwcl : w ∈ closure R := by
        by_contra hwc
        have hO : (closure R)ᶜ ∩ N ∈ 𝓝 w :=
          Filter.inter_mem (isClosed_closure.isOpen_compl.mem_nhds hwc) (hNo.mem_nhds hwN)
        have hev : f =ᶠ[𝓝 w] fun _ => (0 : ℝ) := by
          filter_upwards [hO] with v hv
          by_contra hfv
          have hvR : v ∈ N ∩ R := h2 ▸ (⟨hv.2, hfv⟩ : v ∈ N ∩ {x | f x ≠ 0})
          exact hv.1 (subset_closure hvR.2)
        have hm : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f w = 0 := by
          rw [hev.mfderiv_eq]
          exact mfderiv_const
        exact hdf w hwN hm
      have hw2 : w ∈ closure (κ.source ∩ R) := κ.open_source.inter_closure ⟨hws, hwcl⟩
      have hw3 := mem_closure_image (κ.continuousAt hws) hw2
      rw [Set.inter_comm] at hw3
      exact hw3

theorem hullRiemPer_union_cut_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F U K L : Set M) (hK : IsClosed K) (hL : IsClosed L) (hKL : Disjoint K L) (hFL : Disjoint (closure F) L) : hullRiemPer g F U (K ∪ L) ≤ hullRiemPer g F U K :=
by
  
  have s1 : ∀ (A B : Set E3), IsClosed A → IsClosed B → Disjoint A B →
      ∃ χ : E3 → ℝ, ContDiff ℝ ∞ χ ∧ (∀ y, 0 ≤ χ y ∧ χ y ≤ 1) ∧
        (∀ y ∈ A, ∀ᶠ z in 𝓝 y, χ z = 1) ∧ (∀ y ∈ B, ∀ᶠ z in 𝓝 y, χ z = 0) := by
    intro A B hA hB hAB
    obtain ⟨f, hf0, hf1, hf01⟩ :=
      exists_contMDiffMap_zero_one_nhds_of_isClosed 𝓘(ℝ, E3) (n := ⊤) hB hA hAB.symm
    refine ⟨f, ?_, fun y => ⟨(hf01 y).1, (hf01 y).2⟩, ?_, ?_⟩
    · exact contMDiff_iff_contDiff.mp f.contMDiff
    · exact eventually_nhdsSet_iff_forall.mp hf1
    · exact eventually_nhdsSet_iff_forall.mp hf0
  
  have s3 : ∀ (q : M) (T : Set E3), IsCompact T → T ⊆ (chartAt E3 q).target →
      Disjoint (closure ((chartAt E3 q) '' (F ∩ (chartAt E3 q).source) ∩ T) ∪
          closure ((chartAt E3 q) '' (K ∩ (chartAt E3 q).source) ∩ T))
        (closure ((chartAt E3 q) '' (L ∩ (chartAt E3 q).source) ∩ T)) := by
    intro q T hT hTt
    have hS : IsCompact ((chartAt E3 q).symm '' T) :=
      hT.image_of_continuousOn ((chartAt E3 q).continuousOn_symm.mono hTt)
    have hSs : (chartAt E3 q).symm '' T ⊆ (chartAt E3 q).source := by
      rintro _ ⟨y, hy, rfl⟩
      exact (chartAt E3 q).map_target (hTt hy)
    have hA : IsCompact ((chartAt E3 q) '' ((closure F ∪ K) ∩ (chartAt E3 q).symm '' T)) :=
      (hS.inter_left (isClosed_closure.union hK)).image_of_continuousOn
        ((chartAt E3 q).continuousOn.mono (Set.inter_subset_right.trans hSs))
    have hB : IsCompact ((chartAt E3 q) '' (L ∩ (chartAt E3 q).symm '' T)) :=
      (hS.inter_left hL).image_of_continuousOn
        ((chartAt E3 q).continuousOn.mono (Set.inter_subset_right.trans hSs))
    have hA' : closure ((chartAt E3 q) '' (F ∩ (chartAt E3 q).source) ∩ T) ∪
        closure ((chartAt E3 q) '' (K ∩ (chartAt E3 q).source) ∩ T) ⊆
        (chartAt E3 q) '' ((closure F ∪ K) ∩ (chartAt E3 q).symm '' T) := by
      refine Set.union_subset (closure_minimal ?_ hA.isClosed) (closure_minimal ?_ hA.isClosed)
      · rintro _ ⟨⟨x, ⟨hxF, hxs⟩, rfl⟩, hyT⟩
        exact ⟨x, ⟨Or.inl (subset_closure hxF), (chartAt E3 q) x, hyT,
          (chartAt E3 q).left_inv hxs⟩, rfl⟩
      · rintro _ ⟨⟨x, ⟨hxK, hxs⟩, rfl⟩, hyT⟩
        exact ⟨x, ⟨Or.inr hxK, (chartAt E3 q) x, hyT, (chartAt E3 q).left_inv hxs⟩, rfl⟩
    have hB' : closure ((chartAt E3 q) '' (L ∩ (chartAt E3 q).source) ∩ T) ⊆
        (chartAt E3 q) '' (L ∩ (chartAt E3 q).symm '' T) := by
      refine closure_minimal ?_ hB.isClosed
      rintro _ ⟨⟨x, ⟨hxL, hxs⟩, rfl⟩, hyT⟩
      exact ⟨x, ⟨hxL, (chartAt E3 q) x, hyT, (chartAt E3 q).left_inv hxs⟩, rfl⟩
    refine Disjoint.mono hA' hB' ?_
    rw [Set.disjoint_left]
    rintro _ ⟨x₁, ⟨hx₁, hx₁S⟩, rfl⟩ ⟨x₂, ⟨hx₂L, hx₂S⟩, hx⟩
    have hx12 : x₂ = x₁ := (chartAt E3 q).injOn (hSs hx₂S) (hSs hx₁S) hx
    subst hx12
    rcases hx₁ with h | h
    · exact Set.disjoint_left.mp hFL h hx₂L
    · exact Set.disjoint_left.mp hKL h hx₂L
  
  have key : ∀ (q : M) (W : Set M), W ⊆ (chartAt E3 q).source →
      hullPerG (g.coeff (chartAt E3 q).symm) (chartAt E3 q '' (F ∩ (chartAt E3 q).source))
