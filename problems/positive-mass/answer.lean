      (fun i j => ∑ k : Fin 3, (fderiv ℝ Y x (e c)) k * partialDeriv k (fun w => G w i j) (Y x))
      (6 * (C * ‖Y x‖ ^ (-q))) (K * ‖Y x‖ ^ (-q)) (2 * (36 * (C * ‖Y x‖ ^ (-q - 1))))
      (3 * (2 * (K * ‖Y x‖ ^ (-q - 1)))) hB2 hBφ hG0 hη (hMb c) (hdg c) a b).2
    refine le_trans hv ?_
    have h1 : (5184 * C + 216 * K) * ‖Y x‖ ^ (-q - 1)
        ≤ (5184 * C + 216 * K) * (κ ^ 2 * ‖x‖ ^ (-q - 1)) :=
      mul_le_mul_of_nonneg_left hsq1 (by linarith)
    have h2 : 0 ≤ κ ^ 2 * ‖x‖ ^ (-q - 1) := mul_nonneg (sq_nonneg κ) hv0
    nlinarith

theorem det3_near_id_bound (A : Matrix (Fin 3) (Fin 3) ℝ) (ε : ℝ) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 100)
    (hA : ∀ i j : Fin 3, |A i j - (if i = j then (1 : ℝ) else 0)| ≤ ε) :
    |A.det - 1| ≤ 4 * ε :=
by
  have e00 := hA 0 0
  have e11 := hA 1 1
  have e22 := hA 2 2
  have e01 := hA 0 1
  have e02 := hA 0 2
  have e10 := hA 1 0
  have e12 := hA 1 2
  have e20 := hA 2 0
  have e21 := hA 2 1
  rw [if_pos rfl] at e00 e11 e22
  rw [if_neg (by decide), sub_zero] at e01 e02 e10 e12 e20 e21
  have hid : A.det - 1 = ((A 0 0 - 1) + (A 1 1 - 1) + (A 2 2 - 1))
      + ((A 0 0 - 1) * (A 1 1 - 1) + (A 1 1 - 1) * (A 2 2 - 1) + (A 2 2 - 1) * (A 0 0 - 1))
      + (A 0 0 - 1) * (A 1 1 - 1) * (A 2 2 - 1)
      - A 0 0 * (A 1 2 * A 2 1) - A 2 2 * (A 0 1 * A 1 0) - A 1 1 * (A 0 2 * A 2 0)
      + A 0 1 * A 1 2 * A 2 0 + A 0 2 * A 1 0 * A 2 1 := by
    rw [Matrix.det_fin_three]; ring
  have m2 : ∀ u v : ℝ, |u| ≤ ε → |v| ≤ ε → |u * v| ≤ ε * ε := fun u v hu hv => by
    rw [abs_mul]; exact mul_le_mul hu hv (abs_nonneg _) hε0
  have m3 : ∀ u v w : ℝ, |u| ≤ ε → |v| ≤ ε → |w| ≤ ε → |u * v * w| ≤ ε * ε * ε :=
    fun u v w hu hv hw => by
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul hu hv (abs_nonneg _) hε0) hw (abs_nonneg _)
        (mul_nonneg hε0 hε0)
  have hd : ∀ t : ℝ, |t - 1| ≤ ε → |t| ≤ 1 + ε := fun t ht => by
    have := abs_le.mp ht
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have mx : ∀ t u v : ℝ, |t - 1| ≤ ε → |u| ≤ ε → |v| ≤ ε → |t * (u * v)| ≤ ε * ε + ε * ε * ε :=
    fun t u v ht hu hv => by
      rw [abs_mul]
      have h1 := mul_le_mul (hd t ht) (m2 u v hu hv) (abs_nonneg _) (by linarith)
      linarith
  have q1 := abs_le.mp (m2 _ _ e00 e11)
  have q2 := abs_le.mp (m2 _ _ e11 e22)
  have q3 := abs_le.mp (m2 _ _ e22 e00)
  have c1 := abs_le.mp (m3 _ _ _ e00 e11 e22)
  have c2 := abs_le.mp (m3 _ _ _ e01 e12 e20)
  have c3 := abs_le.mp (m3 _ _ _ e02 e10 e21)
  have x1 := abs_le.mp (mx _ _ _ e00 e12 e21)
  have x2 := abs_le.mp (mx _ _ _ e22 e01 e10)
  have x3 := abs_le.mp (mx _ _ _ e11 e02 e20)
  have l1 := abs_le.mp e00
  have l2 := abs_le.mp e11
  have l3 := abs_le.mp e22
  have s2 : ε * ε ≤ ε / 100 := by nlinarith
  have s3 : ε * ε * ε ≤ ε / 10000 := by
    have h0 : 0 ≤ ε * ε := mul_nonneg hε0 hε0
    have : ε * ε * ε ≤ ε * ε * (1 / 100) := mul_le_mul_of_nonneg_left hε h0
    linarith
  rw [hid, abs_le]
  constructor
  · linarith [q1.1, q2.1, q3.1, c1.1, c2.1, c3.1, x1.2, x2.2, x3.2, l1.1, l2.1, l3.1]
  · linarith [q1.2, q2.2, q3.2, c1.2, c2.2, c3.2, x1.1, x2.1, x3.1, l1.2, l2.2, l3.2]

theorem gradVec_eq_formula (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (x : E3)
    (hG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x)
    (hdet : (G x).det ≠ 0) (hP : 0 < (G x)⁻¹ 0 0) (k : Fin 3) :
    gradVec G x k = Real.sqrt (G x).det * ∑ l : Fin 3, (G x)⁻¹ k l *
      ((-∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ 0 a * partialDeriv l (fun y => G y a b) x * (G x)⁻¹ b 0)
        / (2 * Real.sqrt ((G x)⁻¹ 0 0))) :=
by
  
  have hinv : ∀ m k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
      partialDeriv m (fun y => (G y)⁻¹ k l) x =
        -∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := by
    intro m
    have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
        DifferentiableAt ℝ (fun y => (H y).det) x := by
      intro H hH
      have hfun : (fun y => (H y).det) = fun y =>
          H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
        funext y; exact Matrix.det_fin_three (H y)
      rw [hfun]
      have h00 := hH 0 0
      have h01 := hH 0 1
      have h02 := hH 0 2
      have h10 := hH 1 0
      have h11 := hH 1 1
      have h12 := hH 1 2
      have h20 := hH 2 0
      have h21 := hH 2 1
      have h22 := hH 2 2
      fun_prop
    have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
    have hPd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
      intro k l
      have hfun : (fun y => (G y)⁻¹ k l) =
          fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
        funext y
        rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
          smul_eq_mul]
      rw [hfun]
      refine (hD.inv hdet).mul (hdetD _ ?_)
      intro a b
      by_cases hal : a = l
      · subst hal
        simp only [Matrix.updateRow_self]
        exact differentiableAt_const _
      · simp only [Matrix.updateRow_ne hal]
        exact hG a b
    have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
        + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (∑ b : Fin 3, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
            + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b y => G y a b * (G y)⁻¹ b l)
          (fun b _ => (hG a b).hasFDerivAt.mul (hPd b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) x := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
        filter_upwards [hev] with y hy
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    refine ⟨hPd k l, ?_⟩
    let X : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun y => (G y)⁻¹ b l) x
    let D : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun y => G y a b) x
    have hM : G x * X = -(D * (G x)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, D, Matrix.of_apply]
      exact hE a l'
    have hX : X = -((G x)⁻¹ * (D * (G x)⁻¹)) := by
      calc X = ((G x)⁻¹ * G x) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
        _ = (G x)⁻¹ * (G x * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [X, D, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  have key : ∀ l : Fin 3, partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x =
      (-∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ 0 a * partialDeriv l (fun y => G y a b) x * (G x)⁻¹ b 0)
        / (2 * Real.sqrt ((G x)⁻¹ 0 0)) := by
    intro l
    obtain ⟨hf, hfl⟩ := hinv l 0 0
    have h2 := fderiv_sqrt (f := fun y => (G y)⁻¹ 0 0) hf hP.ne'
    rw [← hfl]
    unfold partialDeriv
    rw [h2, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  unfold gradVec
  congr 1
  exact Finset.sum_congr rfl (fun l _ => by rw [key l])

theorem gradVec_formula_bound (P : Matrix (Fin 3) (Fin 3) ℝ) (d : Fin 3 → Fin 3 → Fin 3 → ℝ)
    (D ε δ : ℝ) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 100) (hδ : 0 ≤ δ)
    (hPb : ∀ k l : Fin 3, |P k l| ≤ 5)
    (hPe : ∀ k l : Fin 3, |P k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * ε)
    (hD : |D - 1| ≤ 4 * ε) (hd : ∀ m a b : Fin 3, |d m a b| ≤ δ) (k : Fin 3) :
    |Real.sqrt D * ∑ l : Fin 3, P k l *
        ((-∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) / (2 * Real.sqrt (P 0 0)))
      + (1 / 2 : ℝ) * d k 0 0| ≤ 20000 * ε * δ :=
by
  have hεδ : 0 ≤ ε * δ := mul_nonneg hε0 hδ
  
  have tri : ∀ x y z X Y Z : ℝ, |x| ≤ X → |y| ≤ Y → |z| ≤ Z → |x * y * z| ≤ X * Y * Z := by
    intro x y z X Y Z hx hy hz
    have hX : 0 ≤ X := le_trans (abs_nonneg _) hx
    have hY : 0 ≤ Y := le_trans (abs_nonneg _) hy
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul hx hy (abs_nonneg _) hX) hz (abs_nonneg _) (mul_nonneg hX hY)
  
  have e00 : |P 0 0 - 1| ≤ 13 * ε := by
    have h := hPe 0 0; rwa [if_pos rfl] at h
  have o01 : |P 0 1| ≤ 13 * ε := by
    have h := hPe 0 1; rwa [if_neg (by decide), sub_zero] at h
  have o02 : |P 0 2| ≤ 13 * ε := by
    have h := hPe 0 2; rwa [if_neg (by decide), sub_zero] at h
  have o10 : |P 1 0| ≤ 13 * ε := by
    have h := hPe 1 0; rwa [if_neg (by decide), sub_zero] at h
  have o20 : |P 2 0| ≤ 13 * ε := by
    have h := hPe 2 0; rwa [if_neg (by decide), sub_zero] at h
  
  have quad : ∀ M : Fin 3 → Fin 3 → ℝ, (∀ a b : Fin 3, |M a b| ≤ δ) →
      |(∑ a : Fin 3, ∑ b : Fin 3, P 0 a * M a b * P b 0) - M 0 0| ≤ 702 * ε * δ ∧
      |∑ a : Fin 3, ∑ b : Fin 3, P 0 a * M a b * P b 0| ≤ 225 * δ := by
    intro M hM
    have t00 : |P 0 0 * M 0 0 * P 0 0 - M 0 0| ≤ 78 * ε * δ := by
      have h1 := tri _ _ _ _ _ _ e00 (hM 0 0) (hPb 0 0)
      have h2 : |M 0 0 * (P 0 0 - 1)| ≤ δ * (13 * ε) := by
        rw [abs_mul]; exact mul_le_mul (hM 0 0) e00 (abs_nonneg _) hδ
      have eq : P 0 0 * M 0 0 * P 0 0 - M 0 0
          = (P 0 0 - 1) * M 0 0 * P 0 0 + M 0 0 * (P 0 0 - 1) := by ring
      rw [eq]
      calc |(P 0 0 - 1) * M 0 0 * P 0 0 + M 0 0 * (P 0 0 - 1)|
          ≤ |(P 0 0 - 1) * M 0 0 * P 0 0| + |M 0 0 * (P 0 0 - 1)| := abs_add_le _ _
        _ ≤ 13 * ε * δ * 5 + δ * (13 * ε) := add_le_add h1 h2
        _ = 78 * ε * δ := by ring
    obtain ⟨a00, b00⟩ := abs_le.mp t00
    obtain ⟨a01, b01⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 1) o10)
    obtain ⟨a02, b02⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 2) o20)
    obtain ⟨a10, b10⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 0) (hPb 0 0))
    obtain ⟨a11, b11⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 1) (hPb 1 0))
    obtain ⟨a12, b12⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 2) (hPb 2 0))
    obtain ⟨a20, b20⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 0) (hPb 0 0))
    obtain ⟨a21, b21⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 1) (hPb 1 0))
    obtain ⟨a22, b22⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 2) (hPb 2 0))
    obtain ⟨c00, d00⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 0) (hPb 0 0))
    obtain ⟨c01, d01⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 1) (hPb 1 0))
    obtain ⟨c02, d02⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 2) (hPb 2 0))
    obtain ⟨c10, d10⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 0) (hPb 0 0))
    obtain ⟨c11, d11⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 1) (hPb 1 0))
    obtain ⟨c12, d12⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 2) (hPb 2 0))
    obtain ⟨c20, d20⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 0) (hPb 0 0))
    obtain ⟨c21, d21⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 1) (hPb 1 0))
    obtain ⟨c22, d22⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 2) (hPb 2 0))
    simp only [Fin.sum_univ_three]
    refine ⟨abs_le.mpr ⟨?_, ?_⟩, abs_le.mpr ⟨?_, ?_⟩⟩
    · linarith
    · linarith
    · linarith
    · linarith
  
  have row : ∀ S : Fin 3 → ℝ, (∀ l, |S l - d l 0 0| ≤ 702 * ε * δ) → (∀ l, |S l| ≤ 225 * δ) →
      |∑ l : Fin 3, P k l * S l - d k 0 0| ≤ 9477 * ε * δ := by
    intro S h1 h2
    have hI : ∑ l : Fin 3, (if k = l then (1 : ℝ) else 0) * S l = S k := by
      simp
    have eq : ∑ l : Fin 3, P k l * S l - d k 0 0
        = ∑ l : Fin 3, (P k l - (if k = l then (1 : ℝ) else 0)) * S l + (S k - d k 0 0) := by
      simp only [sub_mul, Finset.sum_sub_distrib, hI]; ring
    rw [eq]
    have hr : ∀ l : Fin 3, |(P k l - (if k = l then (1 : ℝ) else 0)) * S l| ≤ 13 * ε * (225 * δ) := by
      intro l
      rw [abs_mul]
      exact mul_le_mul (hPe k l) (h2 l) (abs_nonneg _) (by linarith)
    refine le_trans (abs_add_le _ _) ?_
    have hs1 := Finset.abs_sum_le_sum_abs
      (fun l : Fin 3 => (P k l - (if k = l then (1 : ℝ) else 0)) * S l) Finset.univ
    have hs2 : ∑ l : Fin 3, |(P k l - (if k = l then (1 : ℝ) else 0)) * S l|
        ≤ ∑ _l : Fin 3, 13 * ε * (225 * δ) := Finset.sum_le_sum (fun l _ => hr l)
    have hs3 : ∑ _l : Fin 3, 13 * ε * (225 * δ) = 3 * (13 * ε * (225 * δ)) := by
      simp only [Fin.sum_univ_three]; ring
    have hk := h1 k
    linarith
  
  have fin : ∀ T : ℝ, |T - d k 0 0| ≤ 9477 * ε * δ →
      |Real.sqrt D * (-T / (2 * Real.sqrt (P 0 0))) + (1 / 2 : ℝ) * d k 0 0| ≤ 20000 * ε * δ := by
    intro T hT
    have hu := hd k 0 0
    obtain ⟨hD1, hD2⟩ := abs_le.mp hD
    obtain ⟨hq1, hq2⟩ := abs_le.mp e00
    have hD0 : 0 ≤ D := by linarith
    have hq0 : 0 ≤ P 0 0 := by linarith
    have hs0 := Real.sqrt_nonneg D
    have hp0 := Real.sqrt_nonneg (P 0 0)
    have hs2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hD0
    have hp2 : Real.sqrt (P 0 0) ^ 2 = P 0 0 := Real.sq_sqrt hq0
    have hs1 : |Real.sqrt D - 1| ≤ 4 * ε := by
      have e : (Real.sqrt D - 1) * (Real.sqrt D + 1) = D - 1 := by linear_combination hs2
      have e2 : |Real.sqrt D - 1| * (Real.sqrt D + 1) = |D - 1| := by
        rw [← e, abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sqrt D + 1)]
      have e3 : |Real.sqrt D - 1| ≤ |Real.sqrt D - 1| * (Real.sqrt D + 1) :=
        le_mul_of_one_le_right (abs_nonneg _) (by linarith)
      linarith
    have hp1 : |Real.sqrt (P 0 0) - 1| ≤ 13 * ε := by
      have e : (Real.sqrt (P 0 0) - 1) * (Real.sqrt (P 0 0) + 1) = P 0 0 - 1 := by
        linear_combination hp2
      have e2 : |Real.sqrt (P 0 0) - 1| * (Real.sqrt (P 0 0) + 1) = |P 0 0 - 1| := by
        rw [← e, abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sqrt (P 0 0) + 1)]
      have e3 : |Real.sqrt (P 0 0) - 1| ≤ |Real.sqrt (P 0 0) - 1| * (Real.sqrt (P 0 0) + 1) :=
        le_mul_of_one_le_right (abs_nonneg _) (by linarith)
      linarith
    obtain ⟨hs1a, hs1b⟩ := abs_le.mp hs1
    obtain ⟨hp1a, hp1b⟩ := abs_le.mp hp1
    have hp_pos : 0 < Real.sqrt (P 0 0) := by linarith
    have hpne : Real.sqrt (P 0 0) ≠ 0 := ne_of_gt hp_pos
    have hps : |Real.sqrt (P 0 0) - Real.sqrt D| ≤ 17 * ε :=
      abs_le.mpr ⟨by linarith, by linarith⟩
    have key : Real.sqrt D * (-T / (2 * Real.sqrt (P 0 0))) + (1 / 2 : ℝ) * d k 0 0
        = ((Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0 - Real.sqrt D * (T - d k 0 0))
          / (2 * Real.sqrt (P 0 0)) := by
      field_simp
      ring
    have h2p : 0 < 2 * Real.sqrt (P 0 0) := by linarith
    rw [key, abs_div, abs_of_pos h2p, div_le_iff₀ h2p]
    have a1 : |(Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0| ≤ 17 * ε * δ := by
      rw [abs_mul]; exact mul_le_mul hps hu (abs_nonneg _) (by linarith)
    have a2 : |Real.sqrt D * (T - d k 0 0)| ≤ 2 * (9477 * ε * δ) := by
      rw [abs_mul, abs_of_nonneg hs0]
      exact mul_le_mul (by linarith) hT (abs_nonneg _) (by norm_num)
    have hN := abs_sub ((Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0) (Real.sqrt D * (T - d k 0 0))
    have hN2 : 0 ≤ 20000 * ε * δ * (2 * Real.sqrt (P 0 0) - 1) := by
      have : 0 ≤ 2 * Real.sqrt (P 0 0) - 1 := by linarith
      have h3 : 0 ≤ 20000 * ε * δ := by linarith
      exact mul_nonneg h3 this
    linarith
  
  have hq : ∀ l : Fin 3,
      |(∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) - d l 0 0| ≤ 702 * ε * δ ∧
      |∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0| ≤ 225 * δ :=
    fun l => quad (d l) (hd l)
  have hT : |∑ l : Fin 3, P k l * (∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0)
      - d k 0 0| ≤ 9477 * ε * δ :=
    row (fun l => ∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0)
      (fun l => (hq l).1) (fun l => (hq l).2)
  have hsum : ∑ l : Fin 3, P k l *
        ((-∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) / (2 * Real.sqrt (P 0 0)))
      = -(∑ l : Fin 3, P k l * (∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0))
          / (2 * Real.sqrt (P 0 0)) := by
    simp only [Fin.sum_univ_three]
    ring
  rw [hsum]
  exact fin _ hT

theorem gauge_trace_linear_bound (P : Matrix (Fin 3) (Fin 3) ℝ) (d : Fin 3 → Fin 3 → Fin 3 → ℝ)
    (ε δ : ℝ) (hε0 : 0 ≤ ε) (hδ : 0 ≤ δ)
    (hPb : ∀ k l : Fin 3, |P k l| ≤ 5)
    (hPe : ∀ k l : Fin 3, |P k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * ε)
    (hd : ∀ m a b : Fin 3, |d m a b| ≤ δ) :
    |∑ i : Fin 3, ∑ j : Fin 3, P i j *
        ((1 / 2 : ℝ) * ∑ l : Fin 3, P 0 l * (d i j l + d j i l - d l i j))
      - (∑ i : Fin 3, d i i 0 - (1 / 2 : ℝ) * ∑ i : Fin 3, d 0 i i)| ≤ 4000 * ε * δ :=
by
  have hT : ∀ i j l : Fin 3, |d i j l + d j i l - d l i j| ≤ 3 * δ := by
    intro i j l
    have h1 := abs_le.mp (hd i j l)
    have h2 := abs_le.mp (hd j i l)
    have h3 := abs_le.mp (hd l i j)
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]
  have hI1 : ∀ i j : Fin 3, |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by
    intro i j
    split_ifs <;> simp
  have hc : ∀ i j l : Fin 3, |P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
      (if (0 : Fin 3) = l then (1 : ℝ) else 0)| ≤ 78 * ε := by
    intro i j l
    have e : P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
        (if (0 : Fin 3) = l then (1 : ℝ) else 0) =
        (P i j - (if i = j then (1 : ℝ) else 0)) * P 0 l +
          (if i = j then (1 : ℝ) else 0) * (P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0)) := by
      ring
    rw [e]
    calc _ ≤ |(P i j - (if i = j then (1 : ℝ) else 0)) * P 0 l| +
          |(if i = j then (1 : ℝ) else 0) * (P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0))| :=
          abs_add_le _ _
      _ = |P i j - (if i = j then (1 : ℝ) else 0)| * |P 0 l| +
          |(if i = j then (1 : ℝ) else 0)| * |P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0)| := by
          rw [abs_mul, abs_mul]
      _ ≤ (13 * ε) * 5 + 1 * (13 * ε) :=
          add_le_add (mul_le_mul (hPe i j) (hPb 0 l) (abs_nonneg _) (by linarith))
            (mul_le_mul (hI1 i j) (hPe 0 l) (abs_nonneg _) zero_le_one)
      _ = 78 * ε := by ring
  have hF : ∀ i j l : Fin 3, |(1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
      (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| ≤
      117 * ε * δ := by
    intro i j l
    rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    calc _ ≤ (1 / 2 : ℝ) * (78 * ε) * (3 * δ) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (hc i j l) (by norm_num)) (hT i j l)
            (abs_nonneg _) (by positivity)
      _ = 117 * ε * δ := by ring
  have key : ∑ i : Fin 3, ∑ j : Fin 3, P i j *
        ((1 / 2 : ℝ) * ∑ l : Fin 3, P 0 l * (d i j l + d j i l - d l i j))
      - (∑ i : Fin 3, d i i 0 - (1 / 2 : ℝ) * ∑ i : Fin 3, d 0 i i) =
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3,
        (1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j) := by
    simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, if_true, if_false]
    ring
  rw [key]
  calc _ ≤ ∑ i : Fin 3, |∑ j : Fin 3, ∑ l : Fin 3,
        (1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3,
        |(1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| := by
        gcongr with i _
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        gcongr with j _
        exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3, 117 * ε * δ := by
        gcongr with i _ j _ l _
        exact hF i j l
    _ = 3159 * ε * δ := by
        simp only [Fin.sum_univ_three]
        ring
    _ ≤ 4000 * ε * δ := by nlinarith [mul_nonneg hε0 hδ]

theorem gradVec_continuousOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R R' : ℝ) (hRR' : R ≤ R')
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hpos : ∀ x : E3, R' < ‖x‖ → (G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0) :
    (∀ a b k : Fin 3,
      ContinuousOn (fun x => partialDeriv k (fun z => G z a b) x) {x : E3 | R < ‖x‖}) ∧
    (∀ k : Fin 3, ContinuousOn (fun x => gradVec G x k) {x : E3 | R' < ‖x‖}) :=
by
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by
    exact_mod_cast le_top
  
  have hpd : ∀ (f : E3 → ℝ) (s : Set E3), IsOpen s → ContDiffOn ℝ ∞ f s →
      ∀ k : Fin 3, ContinuousOn (fun x => partialDeriv k f x) s := by
    intro f s hs hf k
    have hc : ContinuousOn (fderiv ℝ f) s := hf.continuousOn_fderiv_of_isOpen hs h1inf
    exact hc.clm_apply continuousOn_const
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hV : IsOpen {x : E3 | R' < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hVU : {x : E3 | R' < ‖x‖} ⊆ {x : E3 | R < ‖x‖} := fun x hx =>
    lt_of_le_of_lt hRR' hx
  refine ⟨fun a b k => hpd _ _ hU (hsmooth a b) k, ?_⟩
  have hGV : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R' < ‖x‖} :=
    fun a b => (hsmooth a b).mono hVU
  have h00 := hGV 0 0
  have h01 := hGV 0 1
  have h02 := hGV 0 2
  have h10 := hGV 1 0
  have h11 := hGV 1 1
  have h12 := hGV 1 2
  have h20 := hGV 2 0
  have h21 := hGV 2 1
  have h22 := hGV 2 2
  have hdetS : ContDiffOn ℝ ∞ (fun x => (G x).det) {x : E3 | R' < ‖x‖} := by
    simp only [Matrix.det_fin_three]
    fun_prop
  have hdetinv : ContDiffOn ℝ ∞ (fun x => ((G x).det)⁻¹) {x : E3 | R' < ‖x‖} :=
    hdetS.inv (fun x hx => (hpos x hx).1)
  have hadj : ∀ k l : Fin 3,
      ContDiffOn ℝ ∞ (fun x => (G x).adjugate k l) {x : E3 | R' < ‖x‖} := by
    intro k l
    fin_cases k <;> fin_cases l <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
  have hPS : ∀ k l : Fin 3,
      ContDiffOn ℝ ∞ (fun x => (G x)⁻¹ k l) {x : E3 | R' < ‖x‖} := by
    intro k l
    refine ((hdetinv).mul (hadj k l)).congr ?_
    intro x _
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hhS : ContDiffOn ℝ ∞ (fun z => Real.sqrt ((G z)⁻¹ 0 0)) {x : E3 | R' < ‖x‖} :=
    (hPS 0 0).sqrt (fun x hx => (hpos x hx).2.ne')
  have c1 : ContinuousOn (fun x => Real.sqrt (G x).det) {x : E3 | R' < ‖x‖} :=
    hdetS.continuousOn.sqrt
  have c3 : ∀ l : Fin 3, ContinuousOn
      (fun x => partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x) {x : E3 | R' < ‖x‖} :=
    fun l => hpd _ _ hV hhS l
  intro k
  show ContinuousOn (fun x => Real.sqrt (G x).det *
    ∑ l : Fin 3, (G x)⁻¹ k l * partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x) _
  exact c1.mul (continuousOn_finset_sum Finset.univ
    (fun l _ => ((hPS k l).continuousOn).mul (c3 l)))

theorem cyl_cap_side_identity (a b : E3 → ℝ) (R L : ℝ) (hR : 0 ≤ R) (hRL : R < L)
    (ha : ContDiffOn ℝ ∞ a {x : E3 | R < ‖x‖}) (hb : ContDiffOn ℝ ∞ b {x : E3 | R < ‖x‖}) :
    capFlux (fun x => ![partialDeriv 1 a x + partialDeriv 2 b x, 0, 0]) L =
      sideFlux (fun x => ![0, partialDeriv 0 a x, partialDeriv 0 b x]) L :=
by
  
  have t_norm : ∀ t y z : ℝ, ‖cylPt t y z‖ = Real.sqrt (t ^ 2 + y ^ 2 + z ^ 2) := by
    intro t y z
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
    simp [cylPt, EuclideanSpace.single_apply, Real.norm_eq_abs, sq_abs]
  
  have t_swap : ∀ (f : ℝ → ℝ → ℝ), Continuous (Function.uncurry f) → ∀ a₀ b₀ c₀ d₀ : ℝ,
      ∫ x in a₀..b₀, ∫ y in c₀..d₀, f x y = ∫ y in c₀..d₀, ∫ x in a₀..b₀, f x y := by
    intro f hf a₀ b₀ c₀ d₀
    have hint : Integrable (Function.uncurry f)
        ((volume.restrict (Set.uIoc a₀ b₀)).prod (volume.restrict (Set.uIoc c₀ d₀))) := by
      rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
      exact (hf.continuousOn.integrableOn_compact (isCompact_uIcc.prod isCompact_uIcc)).mono_set
        (Set.prod_mono Set.uIoc_subset_uIcc Set.uIoc_subset_uIcc)
    have h1 : ∀ x, ∫ y in c₀..d₀, f x y =
        (if c₀ ≤ d₀ then (1:ℝ) else -1) • ∫ y in Set.uIoc c₀ d₀, f x y :=
      fun x => intervalIntegral.intervalIntegral_eq_integral_uIoc _ _ _ _
    simp only [h1]
    rw [intervalIntegral.integral_smul, MeasureTheory.intervalIntegral_integral_swap hint]
    conv_rhs => rw [intervalIntegral.intervalIntegral_eq_integral_uIoc]
  
  have t_shell : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f {x : E3 | R < ‖x‖} →
      ContinuousOn f {x : E3 | R < ‖x‖} ∧
      (∀ x : E3, R < ‖x‖ → HasFDerivAt f (fderiv ℝ f x) x) ∧
      (∀ i : Fin 3, ContinuousOn (fun x => partialDeriv i f x) {x : E3 | R < ‖x‖}) := by
    intro f hf
    have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
    refine ⟨hf.continuousOn, fun x hx => ?_, fun i => ?_⟩
    · exact ((hf.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)).hasFDerivAt
    · exact (hf.continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
  
  have t_cont : ∀ {α : Type} [TopologicalSpace α] (f : E3 → ℝ),
      ContinuousOn f {x : E3 | R < ‖x‖} → ∀ (T Y Z : α → ℝ),
      Continuous T → Continuous Y → Continuous Z →
      (∀ p : α, R < ‖cylPt (T p) (Y p) (Z p)‖) →
      Continuous (fun p => f (cylPt (T p) (Y p) (Z p))) := by
    intro α _ f hf T Y Z hT hY hZ hmem
    have hc : Continuous (fun p => cylPt (T p) (Y p) (Z p)) := by
      unfold cylPt
      fun_prop
    exact hf.comp_continuous hc hmem
  
  have t_chain : ∀ (f : E3 → ℝ) (T Y Z : ℝ → ℝ) (T' Y' Z' u : ℝ),
      HasDerivAt T T' u → HasDerivAt Y Y' u → HasDerivAt Z Z' u →
      HasFDerivAt f (fderiv ℝ f (cylPt (T u) (Y u) (Z u))) (cylPt (T u) (Y u) (Z u)) →
      HasDerivAt (fun v => f (cylPt (T v) (Y v) (Z v)))
        (T' * partialDeriv 0 f (cylPt (T u) (Y u) (Z u))
          + Y' * partialDeriv 1 f (cylPt (T u) (Y u) (Z u))
          + Z' * partialDeriv 2 f (cylPt (T u) (Y u) (Z u))) u := by
    intro f T Y Z T' Y' Z' u hT hY hZ hf
    have hγ : HasDerivAt (fun v => cylPt (T v) (Y v) (Z v))
        (T' • e 0 + Y' • e 1 + Z' • e 2) u := by
      unfold cylPt
      exact ((hT.smul_const (e 0)).add (hY.smul_const (e 1))).add (hZ.smul_const (e 2))
    have h := hf.comp_hasDerivAt u hγ
    convert h using 1
    simp only [partialDeriv, map_add, map_smul, smul_eq_mul]
  
  have t_cap : ∀ c M : ℝ, R < |c| →
      ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ =
        ∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt c (M * Real.cos s) (M * Real.sin s)) * Real.cos s
            + b (cylPt c (M * Real.cos s) (M * Real.sin s)) * Real.sin s) * M := by
    intro c M hc
    obtain ⟨haC, haD, haP⟩ := t_shell a ha
    obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
    have hc2 : R ^ 2 < c ^ 2 := by
      rw [← sq_abs c]; exact pow_lt_pow_left₀ hc hR (by norm_num)
    have hmem : ∀ y z : ℝ, R < ‖cylPt c y z‖ := by
      intro y z
      rw [t_norm]
      exact (Real.lt_sqrt hR).mpr (by nlinarith [sq_nonneg y, sq_nonneg z])
    have cq : ∀ f : E3 → ℝ, ContinuousOn f {x : E3 | R < ‖x‖} →
        Continuous (fun q : ℝ × ℝ => f (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))) :=
      fun f hf => t_cont f hf (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
        (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
        (fun q => hmem _ _)
    have cA := cq a haC
    have cB := cq b hbC
    have cA1 := cq _ (haP 1)
    have cA2 := cq _ (haP 2)
    have cB1 := cq _ (hbP 1)
    have cB2 := cq _ (hbP 2)
    have cC : Continuous (fun q : ℝ × ℝ => Real.cos q.2) := by fun_prop
    have cS : Continuous (fun q : ℝ × ℝ => Real.sin q.2) := by fun_prop
    have cR : Continuous (fun q : ℝ × ℝ => q.1) := continuous_fst
    obtain ⟨Φ, hΦ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        ρ * (a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          + b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s) := ⟨_, rfl⟩
    obtain ⟨Ψ, hΨ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          - a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s := ⟨_, rfl⟩
    obtain ⟨DΦ, hDΦ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        (a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          + b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s)
        + ρ * (Real.cos s * (Real.cos s * partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + Real.sin s * partialDeriv 2 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
          + Real.sin s * (Real.cos s * partialDeriv 1 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + Real.sin s * partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))) :=
      ⟨_, rfl⟩
    obtain ⟨DΨ, hDΨ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        (-(ρ * Real.sin s) * partialDeriv 1 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + ρ * Real.cos s * partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
            * Real.cos s
          - b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s
          - ((-(ρ * Real.sin s) * partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + ρ * Real.cos s * partialDeriv 2 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
            * Real.sin s
          + a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s) := ⟨_, rfl⟩
    have cDΦ : Continuous (fun q : ℝ × ℝ => DΦ q.1 q.2) := by
      subst hDΦ
      exact ((cA.mul cC).add (cB.mul cS)).add (cR.mul ((cC.mul ((cC.mul cA1).add
        (cS.mul cA2))).add (cS.mul ((cC.mul cB1).add (cS.mul cB2)))))
    have cDΨ : Continuous (fun q : ℝ × ℝ => DΨ q.1 q.2) := by
      subst hDΨ
      exact (((((cR.mul cS).neg.mul cB1).add ((cR.mul cC).mul cB2)).mul cC).sub
        (cB.mul cS)).sub
        (((((cR.mul cS).neg.mul cA1).add ((cR.mul cC).mul cA2)).mul cS).add (cA.mul cC))
    have hΦd : ∀ ρ s, HasDerivAt (fun r => Φ r s) (DΦ ρ s) ρ := by
      intro ρ s
      have hTa := t_chain a (fun _ => c) (fun r => r * Real.cos s) (fun r => r * Real.sin s)
        0 (Real.cos s) (Real.sin s) ρ (hasDerivAt_const _ _) (hasDerivAt_mul_const _)
        (hasDerivAt_mul_const _) (haD _ (hmem _ _))
      have hTb := t_chain b (fun _ => c) (fun r => r * Real.cos s) (fun r => r * Real.sin s)
        0 (Real.cos s) (Real.sin s) ρ (hasDerivAt_const _ _) (hasDerivAt_mul_const _)
        (hasDerivAt_mul_const _) (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := (hasDerivAt_id ρ).mul
        ((hTa.mul_const (Real.cos s)).add (hTb.mul_const (Real.sin s)))
      subst hΦ hDΦ
      refine h.congr_deriv ?_
      simp only [id, Pi.add_apply]
      ring
    have hΨd : ∀ ρ s, HasDerivAt (fun u => Ψ ρ u) (DΨ ρ s) s := by
      intro ρ s
      have hY : HasDerivAt (fun u => ρ * Real.cos u) (ρ * -Real.sin s) s :=
        (Real.hasDerivAt_cos s).const_mul ρ
      have hZ : HasDerivAt (fun u => ρ * Real.sin u) (ρ * Real.cos s) s :=
        (Real.hasDerivAt_sin s).const_mul ρ
      have hTa := t_chain a (fun _ => c) (fun u => ρ * Real.cos u) (fun u => ρ * Real.sin u)
        0 _ _ s (hasDerivAt_const _ _) hY hZ (haD _ (hmem _ _))
      have hTb := t_chain b (fun _ => c) (fun u => ρ * Real.cos u) (fun u => ρ * Real.sin u)
        0 _ _ s (hasDerivAt_const _ _) hY hZ (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := (hTb.mul (Real.hasDerivAt_cos s)).sub (hTa.mul (Real.hasDerivAt_sin s))
      subst hΨ hDΨ
      refine h.congr_deriv ?_
      ring
    
    have key : ∀ ρ s,
        (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ
          = DΦ ρ s + DΨ ρ s := by
      intro ρ s
      subst hDΦ hDΨ
      linear_combination (-(ρ * (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))))) *
        Real.sin_sq_add_cos_sq s
    have hΨper : ∀ ρ, Ψ ρ (2 * Real.pi) - Ψ ρ 0 = 0 := by
      intro ρ
      subst hΨ
      simp [Real.cos_two_pi, Real.sin_two_pi]
    have sl1 : ∀ ρ, Continuous (fun s => DΦ ρ s) := fun ρ =>
      cDΦ.comp (continuous_const.prodMk continuous_id)
    have sl2 : ∀ ρ, Continuous (fun s => DΨ ρ s) := fun ρ =>
      cDΨ.comp (continuous_const.prodMk continuous_id)
    have sl3 : ∀ s, Continuous (fun ρ => DΦ ρ s) := fun s =>
      cDΦ.comp (continuous_id.prodMk continuous_const)
    calc ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ
        = ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi), (DΦ ρ s + DΨ ρ s) := by
          congr 1; funext ρ; congr 1; funext s; exact key ρ s
      _ = ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi), DΦ ρ s := by
          congr 1; funext ρ
          rw [intervalIntegral.integral_add ((sl1 ρ).intervalIntegrable _ _)
            ((sl2 ρ).intervalIntegrable _ _),
            intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hΨd ρ s)
              ((sl2 ρ).intervalIntegrable _ _), hΨper ρ, add_zero]
      _ = ∫ s in (0 : ℝ)..(2 * Real.pi), ∫ ρ in (0 : ℝ)..M, DΦ ρ s := t_swap DΦ cDΦ _ _ _ _
      _ = _ := by
          congr 1; funext s
          rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun ρ _ => hΦd ρ s)
              ((sl3 s).intervalIntegrable _ _)]
          subst hΦ
          ring
  
  have t_side : ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 0 a (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + partialDeriv 0 b (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L =
        ∫ s in (0 : ℝ)..(2 * Real.pi),
          ((a (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.cos s
              + b (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L
            - (a (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.cos s
              + b (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) := by
    obtain ⟨haC, haD, haP⟩ := t_shell a ha
    obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
    have hL2 : R ^ 2 < L ^ 2 := pow_lt_pow_left₀ hRL hR (by norm_num)
    have hmem : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
      intro t s
      rw [t_norm]
      refine (Real.lt_sqrt hR).mpr ?_
      have h1 : (L * Real.cos s) ^ 2 + (L * Real.sin s) ^ 2 = L ^ 2 := by
        have := Real.sin_sq_add_cos_sq s
        linear_combination L ^ 2 * this
      nlinarith [sq_nonneg t]
    have cq : ∀ f : E3 → ℝ, ContinuousOn f {x : E3 | R < ‖x‖} →
        Continuous (fun q : ℝ × ℝ => f (cylPt q.1 (L * Real.cos q.2) (L * Real.sin q.2))) :=
      fun f hf => t_cont f hf (fun q : ℝ × ℝ => q.1) (fun q : ℝ × ℝ => L * Real.cos q.2)
        (fun q : ℝ × ℝ => L * Real.sin q.2) continuous_fst (by fun_prop) (by fun_prop)
        (fun q => hmem _ _)
    have cA0 := cq _ (haP 0)
    have cB0 := cq _ (hbP 0)
    have cC : Continuous (fun q : ℝ × ℝ => Real.cos q.2) := by fun_prop
    have cS : Continuous (fun q : ℝ × ℝ => Real.sin q.2) := by fun_prop
    obtain ⟨D, hD⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun t s =>
        (partialDeriv 0 a (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + partialDeriv 0 b (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L :=
      ⟨_, rfl⟩
    have cD : Continuous (fun q : ℝ × ℝ => D q.1 q.2) := by
      subst hD
      exact ((cA0.mul cC).add (cB0.mul cS)).mul continuous_const
    have hΘ : ∀ t s, HasDerivAt
        (fun u => (a (cylPt u (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt u (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) (D t s) t := by
      intro t s
      have hTa := t_chain a (fun u => u) (fun _ => L * Real.cos s) (fun _ => L * Real.sin s)
        1 0 0 t (hasDerivAt_id' t) (hasDerivAt_const _ _) (hasDerivAt_const _ _)
        (haD _ (hmem _ _))
      have hTb := t_chain b (fun u => u) (fun _ => L * Real.cos s) (fun _ => L * Real.sin s)
        1 0 0 t (hasDerivAt_id' t) (hasDerivAt_const _ _) (hasDerivAt_const _ _)
        (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := ((hTa.mul_const (Real.cos s)).add (hTb.mul_const (Real.sin s))).mul_const L
      subst hD
      refine h.congr_deriv ?_
      ring
    have sl : ∀ s, Continuous (fun t => D t s) := fun s =>
      cD.comp (continuous_id.prodMk continuous_const)
    calc _ = ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), D t s := by
          subst hD; rfl
      _ = ∫ s in (0 : ℝ)..(2 * Real.pi), ∫ t in (-L)..L, D t s := t_swap D cD _ _ _ _
      _ = _ := by
          congr 1; funext s
          rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hΘ t s)
              ((sl s).intervalIntegrable _ _)]
  
  obtain ⟨haC, haD, haP⟩ := t_shell a ha
  obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
  have hL0 : 0 < L := lt_of_le_of_lt hR hRL
  have hcL : R < |L| := by rw [abs_of_pos hL0]; exact hRL
  have hcmL : R < |-L| := by rw [abs_neg, abs_of_pos hL0]; exact hRL
  have hmemc : ∀ c : ℝ, R < |c| → ∀ y z : ℝ, R < ‖cylPt c y z‖ := by
    intro c hc y z
    have hc2 : R ^ 2 < c ^ 2 := by
      rw [← sq_abs c]; exact pow_lt_pow_left₀ hc hR (by norm_num)
    rw [t_norm]
    exact (Real.lt_sqrt hR).mpr (by nlinarith [sq_nonneg y, sq_nonneg z])
  have cX : ∀ c : ℝ, R < |c| → Continuous (fun q : ℝ × ℝ =>
      (partialDeriv 1 a (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))
        + partialDeriv 2 b (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))) * q.1) := by
    intro c hc
    have h1 := t_cont _ (haP 1) (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
      (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    have h2 := t_cont _ (hbP 2) (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
      (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    exact (h1.add h2).mul continuous_fst
  have cG : ∀ c : ℝ, R < |c| → Continuous (fun s : ℝ =>
      (a (cylPt c (L * Real.cos s) (L * Real.sin s)) * Real.cos s
        + b (cylPt c (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) := by
    intro c hc
    have h1 := t_cont a haC (fun _ => c) (fun s : ℝ => L * Real.cos s)
      (fun s : ℝ => L * Real.sin s) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    have h2 := t_cont b hbC (fun _ => c) (fun s : ℝ => L * Real.cos s)
      (fun s : ℝ => L * Real.sin s) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    exact ((h1.mul Real.continuous_cos).add (h2.mul Real.continuous_sin)).mul continuous_const
  have cF : ∀ c : ℝ, R < |c| → Continuous (fun ρ : ℝ => ∫ s in (0 : ℝ)..(2 * Real.pi),
      (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
        + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ) := fun c hc =>
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' (cX c hc) _ _
  have sX : ∀ c : ℝ, R < |c| → ∀ ρ : ℝ, Continuous (fun s : ℝ =>
      (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
        + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ) := by
    intro c hc ρ
    have h := (cX c hc).comp (continuous_const.prodMk continuous_id :
      Continuous fun s : ℝ => ((ρ, s) : ℝ × ℝ))
    exact h
  unfold capFlux sideFlux
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.tail_cons]
  rw [t_side]
  calc _ = (∫ ρ in (0 : ℝ)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt L (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt L (ρ * Real.cos s) (ρ * Real.sin s))) * ρ)
        - ∫ ρ in (0 : ℝ)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s))) * ρ := by
        rw [← intervalIntegral.integral_sub ((cF L hcL).intervalIntegrable _ _)
          ((cF (-L) hcmL).intervalIntegrable _ _)]
        refine intervalIntegral.integral_congr (fun ρ _ => ?_)
        try simp only
        rw [← intervalIntegral.integral_sub ((sX L hcL ρ).intervalIntegrable _ _)
          ((sX (-L) hcmL ρ).intervalIntegrable _ _)]
        refine intervalIntegral.integral_congr (fun s _ => ?_)
        try simp only
        ring
    _ = (∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L)
        - ∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L := by
        rw [t_cap L L hcL, t_cap (-L) L hcmL]
    _ = _ := (intervalIntegral.integral_sub ((cG L hcL).intervalIntegrable _ _)
          ((cG (-L) hcmL).intervalIntegrable _ _)).symm

theorem cyl_grad_term_asymptotics (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 1 / 2 < q) (hR : 1 ≤ R) (hC : 0 < C)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a)
    (hdec : Dec1 G q R C)
    (hgauge : ∀ x : E3, R < ‖x‖ →
      ∑ i : Fin 3, ∑ j : Fin 3, (G x)⁻¹ i j * christoffel G 0 i j x = 0) :
    Tendsto (fun L : ℝ => cylFlux (gradVec G) L - P1 G L) atTop (𝓝 0) :=
by
  have hq0 : 0 < q := by linarith
  have hFin : ∀ k : Fin 3, k = 0 ∨ k = 1 ∨ k = 2 := by decide
  
  have hlim : Tendsto (fun r : ℝ => C * r ^ (-q)) atTop (𝓝 (C * 0)) :=
    (tendsto_rpow_neg_atTop hq0).const_mul C
  rw [mul_zero] at hlim
  obtain ⟨R₃, hR₃⟩ := Filter.eventually_atTop.mp
    (hlim.eventually (Iic_mem_nhds (by norm_num : (0 : ℝ) < 1 / 100)))
  obtain ⟨R₁, hR₁⟩ : ∃ R₁ : ℝ, R₁ = max R R₃ := ⟨_, rfl⟩
  have hRR₁ : R ≤ R₁ := hR₁ ▸ le_max_left _ _
  have hR₃R₁ : R₃ ≤ R₁ := hR₁ ▸ le_max_right _ _
  have hR₁pos : 0 < R₁ := by linarith
  
  obtain ⟨W1, hW1⟩ : ∃ W : E3 → Fin 3 → ℝ, W = fun x => ![(1 / 2 : ℝ) * admVec G x 0,
      (1 / 2 : ℝ) * (partialDeriv 0 (fun z => G z 1 0) x - partialDeriv 1 (fun z => G z 0 0) x),
      (1 / 2 : ℝ) * (partialDeriv 0 (fun z => G z 2 0) x - partialDeriv 2 (fun z => G z 0 0) x)] :=
    ⟨_, rfl⟩
  obtain ⟨W2, hW2⟩ : ∃ W : E3 → Fin 3 → ℝ, W = fun x => ![(1 / 2 : ℝ) *
        (partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x),
      -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 1 0) x,
      -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 2 0) x] := ⟨_, rfl⟩
  have hW10 : ∀ x, W1 x 0 = (1 / 2 : ℝ) * admVec G x 0 := by intro x; subst hW1; rfl
  have hW11 : ∀ x, W1 x 1 = (1 / 2 : ℝ) *
      (partialDeriv 0 (fun z => G z 1 0) x - partialDeriv 1 (fun z => G z 0 0) x) := by
    intro x; subst hW1; rfl
  have hW12 : ∀ x, W1 x 2 = (1 / 2 : ℝ) *
      (partialDeriv 0 (fun z => G z 2 0) x - partialDeriv 2 (fun z => G z 0 0) x) := by
    intro x; subst hW1; rfl
  have hW20 : ∀ x, W2 x 0 = (1 / 2 : ℝ) *
      (partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x) := by
    intro x; subst hW2; rfl
  have hW21 : ∀ x, W2 x 1 = -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 1 0) x := by
    intro x; subst hW2; rfl
  have hW22 : ∀ x, W2 x 2 = -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 2 0) x := by
    intro x; subst hW2; rfl
  have hU : IsOpen {y : E3 | R < ‖y‖} := isOpen_lt continuous_const continuous_norm
  
  have hpt : ∀ x : E3, R₁ < ‖x‖ →
      ((G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0) ∧
      ∀ k : Fin 3, |gradVec G x k - W1 x k - W2 x k| ≤
        24000 * ((C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1))) := by
    intro x hx
    have hxR : R < ‖x‖ := lt_of_le_of_lt hRR₁ hx
    have hx3 : R₃ ≤ ‖x‖ := by linarith
    have hn0 : 0 ≤ ‖x‖ := norm_nonneg x
    have hε0 : 0 ≤ C * ‖x‖ ^ (-q) := mul_nonneg hC.le (Real.rpow_nonneg hn0 _)
    have hδ0 : 0 ≤ C * ‖x‖ ^ (-q - 1) := mul_nonneg hC.le (Real.rpow_nonneg hn0 _)
    have hε1 : C * ‖x‖ ^ (-q) ≤ 1 / 100 := hR₃ ‖x‖ hx3
    have hA : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) :=
      fun i j => (hdec x hxR i j).1
    have hd : ∀ m a b : Fin 3, |partialDeriv m (fun y => G y a b) x| ≤ C * ‖x‖ ^ (-q - 1) :=
      fun m a b => (hdec x hxR a b).2 m
    have hdet1 := det3_near_id_bound (G x) (C * ‖x‖ ^ (-q)) hε0 hε1 hA
    have hdet : (1 / 2 : ℝ) ≤ (G x).det := by
      have := (abs_le.mp hdet1).1; linarith
    have hdetne : (G x).det ≠ 0 := (by linarith : (0 : ℝ) < (G x).det).ne'
    have hB : ∀ i j : Fin 3, |G x i j| ≤ 1 + C * ‖x‖ ^ (-q) := by
      intro i j
      have h1 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
      have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
      linarith [hA i j]
    have hinv := inv3_entry_bounds (G x) (1 + C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q)) hdet hB hA
    have hsq : (1 + C * ‖x‖ ^ (-q)) ^ 2 ≤ 1.0201 := by nlinarith
    have hPb : ∀ k l : Fin 3, |(G x)⁻¹ k l| ≤ 5 := by
      intro k l; have := (hinv k l).1; linarith
    have hPe : ∀ k l : Fin 3,
        |(G x)⁻¹ k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * (C * ‖x‖ ^ (-q)) := by
      intro k l
      have h1 := (hinv k l).2
      have h2 : 12 * (1 + C * ‖x‖ ^ (-q)) ^ 2 * (C * ‖x‖ ^ (-q)) ≤ 13 * (C * ‖x‖ ^ (-q)) := by
        nlinarith
      linarith
    have hP00 : 0 < (G x)⁻¹ 0 0 := by
      have h := hPe 0 0
      rw [if_pos rfl] at h
      have := (abs_le.mp h).1
      linarith
    have hdiff : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x := fun a b =>
      ((hsmooth a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hxR)
    have hg : ∀ k : Fin 3, |gradVec G x k + (1 / 2 : ℝ) * partialDeriv k (fun y => G y 0 0) x|
        ≤ 20000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := by
      intro k
      rw [gradVec_eq_formula G x hdiff hdetne hP00 k]
      exact gradVec_formula_bound (G x)⁻¹ (fun m a b => partialDeriv m (fun y => G y a b) x)
        (G x).det (C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q - 1)) hε0 hε1 hδ0 hPb hPe hdet1 hd k
    have hT : |∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
        - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x|
          ≤ 4000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := by
      have h4 : |(∑ i : Fin 3, ∑ j : Fin 3, (G x)⁻¹ i j * christoffel G 0 i j x)
          - (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x)|
            ≤ 4000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) :=
        gauge_trace_linear_bound (G x)⁻¹ (fun m a b => partialDeriv m (fun y => G y a b) x)
          (C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q - 1)) hε0 hδ0 hPb hPe hd
      rw [hgauge x hxR, zero_sub, abs_neg] at h4
      exact h4
    refine ⟨⟨hdetne, hP00⟩, ?_⟩
    intro k
    rcases hFin k with rfl | rfl | rfl
    · have e0 : gradVec G x 0 - W1 x 0 - W2 x 0 =
          (gradVec G x 0 + (1 / 2 : ℝ) * partialDeriv 0 (fun y => G y 0 0) x)
          - (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x) := by
        rw [hW10, hW20]
        simp only [admVec, Fin.sum_univ_three]
        ring
      rw [e0]
      have := abs_sub (gradVec G x 0 + (1 / 2 : ℝ) * partialDeriv 0 (fun y => G y 0 0) x)
        (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x)
      have := hg 0
      nlinarith
    · have e1 : gradVec G x 1 - W1 x 1 - W2 x 1 =
          gradVec G x 1 + (1 / 2 : ℝ) * partialDeriv 1 (fun y => G y 0 0) x := by
        rw [hW11, hW21]; ring
      rw [e1]
      have := hg 1
      have : 0 ≤ (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := mul_nonneg hε0 hδ0
      nlinarith
    · have e2 : gradVec G x 2 - W1 x 2 - W2 x 2 =
          gradVec G x 2 + (1 / 2 : ℝ) * partialDeriv 2 (fun y => G y 0 0) x := by
        rw [hW12, hW22]; ring
      rw [e2]
      have := hg 2
      have : 0 ≤ (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := mul_nonneg hε0 hδ0
      nlinarith
  
  have hpos : ∀ x : E3, R₁ < ‖x‖ → (G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0 :=
    fun x hx => (hpt x hx).1
  obtain ⟨hpd, hgc⟩ := gradVec_continuousOn G R R₁ hRR₁ hsmooth hpos
  have hpd' : ∀ a b k : Fin 3,
      ContinuousOn (fun x => partialDeriv k (fun z => G z a b) x) {x : E3 | R₁ < ‖x‖} :=
    fun a b k => (hpd a b k).mono (fun x hx => lt_of_le_of_lt hRR₁ hx)
  have hW1cont : ∀ k : Fin 3, ContinuousOn (fun x => W1 x k) {x : E3 | R₁ < ‖x‖} := by
    intro k
    rcases hFin k with rfl | rfl | rfl
    · simp only [hW10, admVec, Fin.sum_univ_three]
      exact continuousOn_const.mul ((((hpd' 0 0 0).sub (hpd' 0 0 0)).add
        ((hpd' 1 0 1).sub (hpd' 1 1 0))).add ((hpd' 2 0 2).sub (hpd' 2 2 0)))
    · simp only [hW11]
      exact continuousOn_const.mul ((hpd' 1 0 0).sub (hpd' 0 0 1))
    · simp only [hW12]
      exact continuousOn_const.mul ((hpd' 2 0 0).sub (hpd' 0 0 2))
  have hW2cont : ∀ k : Fin 3, ContinuousOn (fun x => W2 x k) {x : E3 | R₁ < ‖x‖} := by
    intro k
    rcases hFin k with rfl | rfl | rfl
    · simp only [hW20]
      exact continuousOn_const.mul ((hpd' 1 0 1).add (hpd' 2 0 2))
    · simp only [hW21]
      exact continuousOn_const.mul (hpd' 1 0 0)
    · simp only [hW22]
      exact continuousOn_const.mul (hpd' 2 0 0)
  have hD1cont : ∀ k : Fin 3,
      ContinuousOn (fun x => (gradVec G x - W1 x) k) {x : E3 | R₁ < ‖x‖} :=
    fun k => (hgc k).sub (hW1cont k)
  
  have hbound : ∀ᶠ L in atTop, ‖cylFlux (gradVec G) L - P1 G L‖ ≤
      288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1)) := by
    filter_upwards [eventually_gt_atTop R₁] with L hL
    have hL0 : 0 < L := by linarith
    have hR0 : 0 ≤ R := by linarith
    have hRL : R < L := by linarith
    have hcap1 : capFlux W1 L = (1 / 2 : ℝ) * capFlux (admVec G) L := by
      unfold capFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext ρ
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW10]
      ring
    have hside1 : sideFlux W1 L = (1 / 2 : ℝ) *
        ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
              - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
            + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
              - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L := by
      unfold sideFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext t
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW11, hW12]
      ring
    have hW1flux : cylFlux W1 L = P1 G L := by
      unfold cylFlux P1
      rw [hcap1, hside1]
    have hcs := cyl_cap_side_identity (fun z => G z 1 0) (fun z => G z 2 0) R L hR0 hRL
      (hsmooth 1 0) (hsmooth 2 0)
    have hcap2 : capFlux W2 L = (1 / 2 : ℝ) * capFlux (fun x =>
        ![partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x, 0, 0]) L := by
      unfold capFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext ρ
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW20, Matrix.cons_val_zero]
      ring
    have hside2 : sideFlux W2 L = -(1 / 2 : ℝ) * sideFlux (fun x =>
        ![0, partialDeriv 0 (fun z => G z 1 0) x, partialDeriv 0 (fun z => G z 2 0) x]) L := by
      unfold sideFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext t
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW21, hW22, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
        Matrix.tail_cons, Matrix.cons_val_zero]
      ring
    have hW2flux : cylFlux W2 L = 0 := by
      unfold cylFlux
      rw [hcap2, hside2, hcs]
      ring
    have hsub1 : cylFlux (fun x => gradVec G x - W1 x - W2 x) L =
        cylFlux (fun x => gradVec G x - W1 x) L - cylFlux W2 L :=
      cylFlux_sub_of_continuousOn (fun x => gradVec G x - W1 x) W2 R₁ L hR₁pos.le hL
        hD1cont hW2cont
    have hsub2 : cylFlux (fun x => gradVec G x - W1 x) L = cylFlux (gradVec G) L - cylFlux W1 L :=
      cylFlux_sub_of_continuousOn (gradVec G) W1 R₁ L hR₁pos.le hL hgc hW1cont
    have heq : cylFlux (fun x => gradVec G x - W1 x - W2 x) L = cylFlux (gradVec G) L - P1 G L := by
      rw [hsub1, hsub2, hW1flux, hW2flux]; ring
    have hM : ∀ x : E3, L ≤ ‖x‖ → ∀ k : Fin 3,
        |(fun x => gradVec G x - W1 x - W2 x) x k| ≤
          24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1))) := by
      intro x hx k
      have hx1 : R₁ < ‖x‖ := by linarith
      have h := (hpt x hx1).2 k
      have a1 : ‖x‖ ^ (-q) ≤ L ^ (-q) := Real.rpow_le_rpow_of_nonpos hL0 hx (by linarith)
      have a2 : ‖x‖ ^ (-q - 1) ≤ L ^ (-q - 1) := Real.rpow_le_rpow_of_nonpos hL0 hx (by linarith)
      have b1 : 0 ≤ C * ‖x‖ ^ (-q) := mul_nonneg hC.le (Real.rpow_nonneg (norm_nonneg _) _)
      have b2 : 0 ≤ C * ‖x‖ ^ (-q - 1) := mul_nonneg hC.le (Real.rpow_nonneg (norm_nonneg _) _)
      have c1 : C * ‖x‖ ^ (-q) ≤ C * L ^ (-q) := mul_le_mul_of_nonneg_left a1 hC.le
      have c2 : C * ‖x‖ ^ (-q - 1) ≤ C * L ^ (-q - 1) := mul_le_mul_of_nonneg_left a2 hC.le
      have c3 : (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) ≤ (C * L ^ (-q)) * (C * L ^ (-q - 1)) :=
        mul_le_mul c1 c2 b2 (le_trans b1 c1)
      show |gradVec G x k - W1 x k - W2 x k| ≤ _
      linarith
    have hMnn : 0 ≤ 24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1))) := by positivity
    have h9 := cylFlux_abs_le (fun x => gradVec G x - W1 x - W2 x) L _ hL0.le hMnn hM
    have hpow : L ^ 2 * (L ^ (-q) * L ^ (-q - 1)) = L ^ (-(2 * q - 1)) := by
      rw [← Real.rpow_add hL0, ← Real.rpow_two, ← Real.rpow_add hL0]
      congr 1; ring
    rw [Real.norm_eq_abs, ← heq]
    calc |cylFlux (fun x => gradVec G x - W1 x - W2 x) L|
        ≤ 12 * Real.pi * L ^ 2 * (24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1)))) := h9
      _ = 288000 * Real.pi * C ^ 2 * (L ^ 2 * (L ^ (-q) * L ^ (-q - 1))) := by ring
      _ = 288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1)) := by rw [hpow]
  have hlim2 : Tendsto (fun L : ℝ => 288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1))) atTop (𝓝 0) := by
    have := (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < 2 * q - 1)).const_mul
      (288000 * Real.pi * C ^ 2)
    rwa [mul_zero] at this
  exact squeeze_zero_norm' hbound hlim2

theorem curv_pointwise_expansion (γ γi : Matrix (Fin 2) (Fin 2) ℝ)
    (d : Fin 2 → Fin 2 → Fin 2 → ℝ) (L s ε η : ℝ) (hL : 0 < L) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 20)
    (hη : 0 ≤ η)
    (hγ : ∀ a b : Fin 2, |γ a b - (if a = b then (1 : ℝ) else 0)| ≤ ε)
    (hγi : ∀ a b : Fin 2, |γi a b - (if a = b then (1 : ℝ) else 0)| ≤ 2 * ε)
    (hγi2 : ∀ a b : Fin 2,
      |γi a b - (if a = b then (1 : ℝ) else 0) + (γ a b - (if a = b then (1 : ℝ) else 0))|
        ≤ 7 * ε ^ 2)
    (hd : ∀ c a b : Fin 2, L * |d c a b| ≤ η) :
    |curvKappa γ γi d L s - 1 - curvLinAlg γ d L s| ≤ 200 * (ε ^ 2 + ε * η) :=
by
  have sqrt_aux : ∀ x : ℝ, 0 ≤ x → 16 / 25 ≤ x ^ 2 → 4 / 5 ≤ x := by
    intro x hx h; nlinarith
  have prod_aux : ∀ a b : ℝ, 4 / 5 ≤ a → 4 / 5 ≤ b → 16 / 25 ≤ a * b := by
    intro a b ha hb; nlinarith
  have hε2 : ε ^ 2 ≤ ε / 20 := by nlinarith
  have hcs : Real.cos s ^ 2 + Real.sin s ^ 2 = 1 := Real.cos_sq_add_sin_sq s
  have hC1 : |Real.cos s| ≤ 1 := Real.abs_cos_le_one s
  have hS1 : |Real.sin s| ≤ 1 := Real.abs_sin_le_one s
  have hnS1 : |-Real.sin s| ≤ 1 := by rw [abs_neg]; exact hS1
  have c00 : (if (0 : Fin 2) = 0 then (1 : ℝ) else 0) = 1 := if_pos rfl
  have c11 : (if (1 : Fin 2) = 1 then (1 : ℝ) else 0) = 1 := if_pos rfl
  have c01 : (if (0 : Fin 2) = 1 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
  have c10 : (if (1 : Fin 2) = 0 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
  
  have k00 : |γ 0 0 - 1| ≤ ε := by have h := hγ 0 0; rwa [c00] at h
  have k11 : |γ 1 1 - 1| ≤ ε := by have h := hγ 1 1; rwa [c11] at h
  have k01 : |γ 0 1| ≤ ε := by have h := hγ 0 1; rwa [c01, sub_zero] at h
  have k10 : |γ 1 0| ≤ ε := by have h := hγ 1 0; rwa [c10, sub_zero] at h
  have i00 : |γi 0 0 - 1| ≤ 2 * ε := by have h := hγi 0 0; rwa [c00] at h
  have i11 : |γi 1 1 - 1| ≤ 2 * ε := by have h := hγi 1 1; rwa [c11] at h
  have i01 : |γi 0 1| ≤ 2 * ε := by have h := hγi 0 1; rwa [c01, sub_zero] at h
  have i10 : |γi 1 0| ≤ 2 * ε := by have h := hγi 1 0; rwa [c10, sub_zero] at h
  have p00 : |γi 0 0 - 1 + (γ 0 0 - 1)| ≤ 7 * ε ^ 2 := by have h := hγi2 0 0; rwa [c00] at h
  have p11 : |γi 1 1 - 1 + (γ 1 1 - 1)| ≤ 7 * ε ^ 2 := by have h := hγi2 1 1; rwa [c11] at h
  have p01 : |γi 0 1 + γ 0 1| ≤ 7 * ε ^ 2 := by
    have h := hγi2 0 1; rwa [c01, sub_zero, sub_zero] at h
  have p10 : |γi 1 0 + γ 1 0| ≤ 7 * ε ^ 2 := by
    have h := hγi2 1 0; rwa [c10, sub_zero, sub_zero] at h
  have hd' : ∀ c a b : Fin 2, |L * d c a b| ≤ η := by
    intro c a b; rw [abs_mul, abs_of_pos hL]; exact hd c a b
  
  have abs4 : ∀ a b c f : ℝ, |a + b + c + f| ≤ |a| + |b| + |c| + |f| := by
    intro a b c f
    have h1 := abs_add_le (a + b + c) f
    have h2 := abs_add_le (a + b) c
    have h3 := abs_add_le a b
    linarith
  have abs8 : ∀ a b c f g h i j : ℝ, |a + b + c + f + g + h + i + j|
      ≤ |a| + |b| + |c| + |f| + |g| + |h| + |i| + |j| := by
    intro a b c f g h i j
    have h1 := abs_add_le (a + b + c + f + g + h + i) j
    have h2 := abs_add_le (a + b + c + f + g + h) i
    have h3 := abs_add_le (a + b + c + f + g) h
    have h4 := abs_add_le (a + b + c + f) g
    have h5 := abs4 a b c f
    linarith
  have t1 : ∀ x m μ : ℝ, |x| ≤ 1 → |m| ≤ μ → |x * m| ≤ μ := by
    intro x m μ hx hm
    rw [abs_mul]
    calc |x| * |m| ≤ 1 * μ := mul_le_mul hx hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have t2 : ∀ x y m μ : ℝ, |x| ≤ 1 → |y| ≤ 1 → |m| ≤ μ → |x * y * m| ≤ μ := by
    intro x y m μ hx hy hm
    rw [abs_mul (x * y), abs_mul]
    have hxy : |x| * |y| ≤ 1 := mul_le_one₀ hx (abs_nonneg _) hy
    calc |x| * |y| * |m| ≤ 1 * μ := mul_le_mul hxy hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have t3 : ∀ x y z m μ : ℝ, |x| ≤ 1 → |y| ≤ 1 → |z| ≤ 1 → |m| ≤ μ → |x * y * z * m| ≤ μ := by
    intro x y z m μ hx hy hz hm
    rw [abs_mul (x * y * z), abs_mul (x * y), abs_mul]
    have hxy : |x| * |y| ≤ 1 := mul_le_one₀ hx (abs_nonneg _) hy
    have hxyz : |x| * |y| * |z| ≤ 1 := mul_le_one₀ hxy (abs_nonneg _) hz
    calc |x| * |y| * |z| * |m| ≤ 1 * μ := mul_le_mul hxyz hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have quad : ∀ m00 m01 m10 m11 x0 x1 μ : ℝ, |m00| ≤ μ → |m01| ≤ μ → |m10| ≤ μ → |m11| ≤ μ →
      |m00 * x0 * x0 + m01 * x0 * x1 + m10 * x1 * x0 + m11 * x1 * x1|
        ≤ μ * (|x0| + |x1|) ^ 2 := by
    intro m00 m01 m10 m11 x0 x1 μ h00 h01 h10 h11
    have tt : ∀ m x y : ℝ, |m| ≤ μ → |m * x * y| ≤ μ * (|x| * |y|) := by
      intro m x y hm
      rw [abs_mul, abs_mul, mul_assoc]
      exact mul_le_mul_of_nonneg_right hm (mul_nonneg (abs_nonneg _) (abs_nonneg _))
    have a1 := tt m00 x0 x0 h00
    have a2 := tt m01 x0 x1 h01
    have a3 := tt m10 x1 x0 h10
    have a4 := tt m11 x1 x1 h11
    have e : μ * (|x0| + |x1|) ^ 2 = μ * (|x0| * |x0|) + μ * (|x0| * |x1|)
        + μ * (|x1| * |x0|) + μ * (|x1| * |x1|) := by ring
    rw [e]
    exact (abs4 _ _ _ _).trans (by linarith)
  have hSS : (|Real.cos s| + |Real.sin s|) ^ 2 ≤ 2 := by
    have h1 := sq_nonneg (|Real.cos s| - |Real.sin s|)
    have h2 := sq_abs (Real.cos s)
    have h3 := sq_abs (Real.sin s)
    linarith
  
  obtain ⟨kn, hkn⟩ : ∃ x : ℝ, x = (γ 0 0 - 1) * Real.cos s * Real.cos s
      + γ 0 1 * Real.cos s * Real.sin s + γ 1 0 * Real.sin s * Real.cos s
      + (γ 1 1 - 1) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  obtain ⟨be, hbe⟩ : ∃ x : ℝ, x = (γ 0 0 - 1) * (-Real.sin s) * (-Real.sin s)
      + γ 0 1 * (-Real.sin s) * Real.cos s + γ 1 0 * Real.cos s * (-Real.sin s)
      + (γ 1 1 - 1) * Real.cos s * Real.cos s := ⟨_, rfl⟩
  obtain ⟨al, hal⟩ : ∃ x : ℝ, x = (γi 0 0 - 1) * Real.cos s * Real.cos s
      + γi 0 1 * Real.cos s * Real.sin s + γi 1 0 * Real.sin s * Real.cos s
      + (γi 1 1 - 1) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  obtain ⟨rho, hrho⟩ : ∃ x : ℝ, x = (γi 0 0 - 1 + (γ 0 0 - 1)) * Real.cos s * Real.cos s
      + (γi 0 1 + γ 0 1) * Real.cos s * Real.sin s + (γi 1 0 + γ 1 0) * Real.sin s * Real.cos s
      + (γi 1 1 - 1 + (γ 1 1 - 1)) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  have hknb : |kn| ≤ 2 * ε := by
    rw [hkn]
    refine (quad _ _ _ _ _ _ _ k00 k01 k10 k11).trans ?_
    calc ε * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ ε * 2 := mul_le_mul_of_nonneg_left hSS hε0
      _ = 2 * ε := by ring
  have hbeb : |be| ≤ 2 * ε := by
    rw [hbe]
    refine (quad _ _ _ _ _ _ _ k00 k01 k10 k11).trans ?_
    rw [abs_neg, add_comm (|Real.sin s|)]
    calc ε * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ ε * 2 := mul_le_mul_of_nonneg_left hSS hε0
      _ = 2 * ε := by ring
  have hrhob : |rho| ≤ 14 * ε ^ 2 := by
    rw [hrho]
    refine (quad _ _ _ _ _ _ _ p00 p01 p10 p11).trans ?_
    calc 7 * ε ^ 2 * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ 7 * ε ^ 2 * 2 :=
          mul_le_mul_of_nonneg_left hSS (by positivity)
      _ = 14 * ε ^ 2 := by ring
  have halr : al = rho - kn := by rw [hal, hrho, hkn]; ring
  
  obtain ⟨T1, hT1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * Real.cos s * (L * d 0 0 0)
      + (-Real.sin s) * (-Real.sin s) * Real.sin s * (L * d 0 0 1)
      + (-Real.sin s) * Real.cos s * Real.cos s * (L * d 0 1 0)
      + (-Real.sin s) * Real.cos s * Real.sin s * (L * d 0 1 1)
      + Real.cos s * (-Real.sin s) * Real.cos s * (L * d 1 0 0)
      + Real.cos s * (-Real.sin s) * Real.sin s * (L * d 1 0 1)
      + Real.cos s * Real.cos s * Real.cos s * (L * d 1 1 0)
      + Real.cos s * Real.cos s * Real.sin s * (L * d 1 1 1) := ⟨_, rfl⟩
  obtain ⟨T2, hT2⟩ : ∃ x : ℝ, x =
      Real.cos s * (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0)
      + Real.cos s * (-Real.sin s) * Real.cos s * (L * d 0 0 1)
      + Real.cos s * Real.cos s * (-Real.sin s) * (L * d 0 1 0)
      + Real.cos s * Real.cos s * Real.cos s * (L * d 0 1 1)
      + Real.sin s * (-Real.sin s) * (-Real.sin s) * (L * d 1 0 0)
      + Real.sin s * (-Real.sin s) * Real.cos s * (L * d 1 0 1)
      + Real.sin s * Real.cos s * (-Real.sin s) * (L * d 1 1 0)
      + Real.sin s * Real.cos s * Real.cos s * (L * d 1 1 1) := ⟨_, rfl⟩
  obtain ⟨A0, hA0⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0) + (-Real.sin s) * Real.cos s * (L * d 0 1 0)
      + Real.cos s * (-Real.sin s) * (L * d 1 0 0) + Real.cos s * Real.cos s * (L * d 1 1 0) :=
    ⟨_, rfl⟩
  obtain ⟨B0, hB0⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0) + (-Real.sin s) * Real.cos s * (L * d 0 0 1)
      + Real.cos s * (-Real.sin s) * (L * d 0 1 0) + Real.cos s * Real.cos s * (L * d 0 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨A1, hA1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 1) + (-Real.sin s) * Real.cos s * (L * d 0 1 1)
      + Real.cos s * (-Real.sin s) * (L * d 1 0 1) + Real.cos s * Real.cos s * (L * d 1 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨B1, hB1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 1 0 0) + (-Real.sin s) * Real.cos s * (L * d 1 0 1)
      + Real.cos s * (-Real.sin s) * (L * d 1 1 0) + Real.cos s * Real.cos s * (L * d 1 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨m0, hm0⟩ : ∃ x : ℝ, x = Real.cos s * (γi 0 0 - 1) + Real.sin s * γi 1 0 := ⟨_, rfl⟩
  obtain ⟨m1, hm1⟩ : ∃ x : ℝ, x = Real.cos s * γi 0 1 + Real.sin s * (γi 1 1 - 1) := ⟨_, rfl⟩
  obtain ⟨Dd, hDd⟩ : ∃ x : ℝ, x = -T1 + T2 / 2 := ⟨_, rfl⟩
  obtain ⟨Ee, hEe⟩ : ∃ x : ℝ, x = -(m0 * (A0 - 1 / 2 * B0) + m1 * (A1 - 1 / 2 * B1)) :=
    ⟨_, rfl⟩
  have hT1b : |T1| ≤ 8 * η := by
    rw [hT1]
    refine (abs8 _ _ _ _ _ _ _ _).trans ?_
    linarith [t3 _ _ _ _ _ hnS1 hnS1 hC1 (hd' 0 0 0), t3 _ _ _ _ _ hnS1 hnS1 hS1 (hd' 0 0 1),
      t3 _ _ _ _ _ hnS1 hC1 hC1 (hd' 0 1 0), t3 _ _ _ _ _ hnS1 hC1 hS1 (hd' 0 1 1),
      t3 _ _ _ _ _ hC1 hnS1 hC1 (hd' 1 0 0), t3 _ _ _ _ _ hC1 hnS1 hS1 (hd' 1 0 1),
      t3 _ _ _ _ _ hC1 hC1 hC1 (hd' 1 1 0), t3 _ _ _ _ _ hC1 hC1 hS1 (hd' 1 1 1)]
  have hT2b : |T2| ≤ 8 * η := by
    rw [hT2]
    refine (abs8 _ _ _ _ _ _ _ _).trans ?_
    linarith [t3 _ _ _ _ _ hC1 hnS1 hnS1 (hd' 0 0 0), t3 _ _ _ _ _ hC1 hnS1 hC1 (hd' 0 0 1),
      t3 _ _ _ _ _ hC1 hC1 hnS1 (hd' 0 1 0), t3 _ _ _ _ _ hC1 hC1 hC1 (hd' 0 1 1),
      t3 _ _ _ _ _ hS1 hnS1 hnS1 (hd' 1 0 0), t3 _ _ _ _ _ hS1 hnS1 hC1 (hd' 1 0 1),
      t3 _ _ _ _ _ hS1 hC1 hnS1 (hd' 1 1 0), t3 _ _ _ _ _ hS1 hC1 hC1 (hd' 1 1 1)]
  have hDb : |Dd| ≤ 12 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hT1b
    obtain ⟨l2, u2⟩ := abs_le.mp hT2b
    rw [hDd, abs_le]; constructor <;> linarith
  have hA0b : |A0| ≤ 4 * η := by
    rw [hA0]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 0 1 0),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 0 0), t2 _ _ _ _ hC1 hC1 (hd' 1 1 0)]
  have hB0b : |B0| ≤ 4 * η := by
    rw [hB0]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 0 0 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 0 1 0), t2 _ _ _ _ hC1 hC1 (hd' 0 1 1)]
  have hA1b : |A1| ≤ 4 * η := by
    rw [hA1]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 1), t2 _ _ _ _ hnS1 hC1 (hd' 0 1 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 0 1), t2 _ _ _ _ hC1 hC1 (hd' 1 1 1)]
  have hB1b : |B1| ≤ 4 * η := by
    rw [hB1]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 1 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 1 0 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 1 0), t2 _ _ _ _ hC1 hC1 (hd' 1 1 1)]
  have hm0b : |m0| ≤ 4 * ε := by
    rw [hm0]
    refine (abs_add_le _ _).trans ?_
    linarith [t1 _ _ _ hC1 i00, t1 _ _ _ hS1 i10]
  have hm1b : |m1| ≤ 4 * ε := by
    rw [hm1]
    refine (abs_add_le _ _).trans ?_
    linarith [t1 _ _ _ hC1 i01, t1 _ _ _ hS1 i11]
  have hY0b : |A0 - 1 / 2 * B0| ≤ 6 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hA0b
    obtain ⟨l2, u2⟩ := abs_le.mp hB0b
    rw [abs_le]; constructor <;> linarith
  have hY1b : |A1 - 1 / 2 * B1| ≤ 6 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hA1b
    obtain ⟨l2, u2⟩ := abs_le.mp hB1b
    rw [abs_le]; constructor <;> linarith
  have hEb : |Ee| ≤ 48 * ε * η := by
    have q0 : |m0 * (A0 - 1 / 2 * B0)| ≤ 4 * ε * (6 * η) := by
      rw [abs_mul]; exact mul_le_mul hm0b hY0b (abs_nonneg _) (by linarith)
    have q1 : |m1 * (A1 - 1 / 2 * B1)| ≤ 4 * ε * (6 * η) := by
      rw [abs_mul]; exact mul_le_mul hm1b hY1b (abs_nonneg _) (by linarith)
    rw [hEe, abs_neg]
    refine (abs_add_le _ _).trans ?_
    linarith
  
  have red : ∀ N A B : ℝ, N = L * (1 + Dd + Ee) → A = 1 + al → B = L ^ 2 * (1 + be) →
      N / (Real.sqrt A * Real.sqrt B)
        = (1 + Dd + Ee) / (Real.sqrt (1 + al) * Real.sqrt (1 + be)) := by
    intro N A B hN hA hB
    rw [hN, hA, hB, Real.sqrt_mul (sq_nonneg L), Real.sqrt_sq hL.le,
      show Real.sqrt (1 + al) * (L * Real.sqrt (1 + be))
        = L * (Real.sqrt (1 + al) * Real.sqrt (1 + be)) by ring]
    exact mul_div_mul_left _ _ hL.ne'
  have hK : curvKappa γ γi d L s
      = (1 + Dd + Ee) / (Real.sqrt (1 + al) * Real.sqrt (1 + be)) := by
    simp only [curvKappa]
    apply red
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hDd, hEe, hT1, hT2, hm0, hm1, hA0, hB0, hA1, hB1]
      ring
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hal]
      linear_combination hcs
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hbe]
      linear_combination L ^ 2 * hcs
  have hLin : curvLinAlg γ d L s = 1 / 2 * (kn - be) + Dd := by
    simp only [curvLinAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, c00, c01, c10, c11]
    rw [hkn, hbe, hDd, hT1, hT2]
    ring
  
  have hε2η : ε ^ 2 * η ≤ ε / 20 * η := mul_le_mul_of_nonneg_right hε2 hη
  have hεη : 0 ≤ ε * η := mul_nonneg hε0 hη
  obtain ⟨lkn, ukn⟩ := abs_le.mp hknb
  obtain ⟨lbe, ube⟩ := abs_le.mp hbeb
  obtain ⟨lrho, urho⟩ := abs_le.mp hrhob
  obtain ⟨lD, uD⟩ := abs_le.mp hDb
  obtain ⟨lE, uE⟩ := abs_le.mp hEb
  have h1a : 0 ≤ 1 + al := by linarith
  have h1b : 0 ≤ 1 + be := by linarith
  obtain ⟨σ, hσ⟩ : ∃ x : ℝ, x = Real.sqrt (1 + al) * Real.sqrt (1 + be) := ⟨_, rfl⟩
  have hσ0 : 0 ≤ σ := by rw [hσ]; positivity
  have hσsq : σ ^ 2 = (1 + al) * (1 + be) := by
    rw [hσ, mul_pow, Real.sq_sqrt h1a, Real.sq_sqrt h1b]
  have hσsq' : 16 / 25 ≤ σ ^ 2 := by
    rw [hσsq]
    exact prod_aux _ _ (by linarith) (by linarith)
  have hσl : 4 / 5 ≤ σ := sqrt_aux σ hσ0 hσsq'
  have hσpos : 0 < σ := by linarith
  have hσne : σ ≠ 0 := hσpos.ne'
  have hprod : (1 + (al + be) / 2 - σ) * (1 + (al + be) / 2 + σ) = (al - be) ^ 2 / 4 := by
    have e : (1 + (al + be) / 2 - σ) * (1 + (al + be) / 2 + σ)
        = (1 + (al + be) / 2) ^ 2 - σ ^ 2 := by ring
    rw [e, hσsq]; ring
  have hws0 : 0 ≤ 1 + (al + be) / 2 - σ := by
    by_contra h
    push_neg at h
    have h2 := mul_neg_of_neg_of_pos h (show 0 < 1 + (al + be) / 2 + σ by linarith)
    rw [hprod] at h2
    have h3 := sq_nonneg (al - be)
    linarith
  have hws1 : 1 + (al + be) / 2 - σ ≤ 5 / 32 * (al - be) ^ 2 := by
    have := mul_le_mul_of_nonneg_left (show 8 / 5 ≤ 1 + (al + be) / 2 + σ by linarith) hws0
    linarith
  have hab2 : (al - be) ^ 2 ≤ 25 * ε ^ 2 := by
    have h := sq_le_sq' (show -(5 * ε) ≤ al - be by linarith) (show al - be ≤ 5 * ε by linarith)
    calc (al - be) ^ 2 ≤ (5 * ε) ^ 2 := h
      _ = 25 * ε ^ 2 := by ring
  rw [hK, ← hσ, hLin]
  obtain ⟨Z, hZ⟩ : ∃ x : ℝ, x = (1 + Dd + Ee) / σ - 1 - (1 / 2 * (kn - be) + Dd) := ⟨_, rfl⟩
  rw [← hZ]
  have hZσ : Z * σ = Ee - rho / 2 - (al + be) / 2 * (1 / 2 * (kn - be) + Dd)
      + (1 + (al + be) / 2 - σ) * (1 + 1 / 2 * (kn - be) + Dd) := by
    rw [hZ, sub_mul, sub_mul, div_mul_cancel₀ _ hσne]
    linear_combination (-1 / 2 : ℝ) * halr
  have hq1 : |(al + be) / 2 * (1 / 2 * (kn - be) + Dd)| ≤ (5 / 2 * ε) * (2 * ε + 12 * η) := by
    rw [abs_mul]
    refine mul_le_mul ?_ ?_ (abs_nonneg _) (by linarith)
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith
  have hq2 : |(1 + (al + be) / 2 - σ) * (1 + 1 / 2 * (kn - be) + Dd)|
      ≤ (4 * ε ^ 2) * (11 / 10 + 12 * η) := by
    rw [abs_mul]
    refine mul_le_mul ?_ ?_ (abs_nonneg _) (by positivity)
    · rw [abs_of_nonneg hws0]; linarith
    · rw [abs_le]; constructor <;> linarith
  obtain ⟨lq1, uq1⟩ := abs_le.mp hq1
  obtain ⟨lq2, uq2⟩ := abs_le.mp hq2
  have hZs : |Z| * σ ≤ 160 * (ε ^ 2 + ε * η) := by
    have e : |Z| * σ = |Z * σ| := by rw [abs_mul, abs_of_pos hσpos]
    rw [e, hZσ, abs_le]
    constructor <;> linarith
  have hZ45 : |Z| * (4 / 5) ≤ |Z| * σ := mul_le_mul_of_nonneg_left hσl (abs_nonneg Z)
  linarith

theorem curv_exact_part_integral_zero (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L t : ℝ)
    (hL : 0 < L) (hRL : R < L)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖}) :
    IntervalIntegrable (fun s => curvWAlg (cylGam G t L s) (cylDG G t L s) L s) volume
      0 (2 * Real.pi) ∧
    ∫ s in (0 : ℝ)..(2 * Real.pi), curvWAlg (cylGam G t L s) (cylDG G t L s) L s = 0 :=
by
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  
  have hmem : ∀ s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
    intro s
    have hsq : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ 2 = t ^ 2 + L ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [cylPt, Fin.sum_univ_three, EuclideanSpace.single_apply]
      linear_combination L ^ 2 * Real.sin_sq_add_cos_sq s
    have h0 := norm_nonneg (cylPt t (L * Real.cos s) (L * Real.sin s))
    by_contra h
    push_neg at h
    have hlt : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ < L := lt_of_le_of_lt h hRL
    nlinarith [sq_nonneg t]
  
  have hφd : ∀ s : ℝ, HasDerivAt (fun s => cylPt t (L * Real.cos s) (L * Real.sin s))
      ((L * -Real.sin s) • e 1 + (L * Real.cos s) • e 2) s := by
    intro s
    have h1 := ((Real.hasDerivAt_cos s).const_mul L).smul_const (e 1)
    have h2 := ((Real.hasDerivAt_sin s).const_mul L).smul_const (e 2)
    have h0 := hasDerivAt_const s (t • e 0)
    have h := (h0.add h1).add h2
    rw [zero_add] at h
    exact h
  
  have hgam : ∀ (s : ℝ) (a b : Fin 2), HasDerivAt (fun s => cylGam G t L s a b)
      (L * (-(Real.sin s) * cylDG G t L s 0 a b + Real.cos s * cylDG G t L s 1 a b)) s := by
    intro s a b
    have hdiff : DifferentiableAt ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) :=
      ((hsmooth a.succ b.succ).differentiableOn (by simp)).differentiableAt
        (hU.mem_nhds (hmem s))
    have hc0 := hdiff.hasFDerivAt.comp_hasDerivAt s (hφd s)
    have hc : HasDerivAt (fun s => cylGam G t L s a b)
        (fderiv ℝ (fun z => G z a.succ b.succ) (cylPt t (L * Real.cos s) (L * Real.sin s))
          ((L * -Real.sin s) • e 1 + (L * Real.cos s) • e 2)) s := hc0
    refine hc.congr_deriv ?_
    have e0 : cylDG G t L s 0 a b = fderiv ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) (e 1) := rfl
    have e1 : cylDG G t L s 1 a b = fderiv ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) (e 2) := rfl
    rw [e0, e1, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    ring
  
  have hφc : Continuous (fun s : ℝ => cylPt t (L * Real.cos s) (L * Real.sin s)) := by
    unfold cylPt
    fun_prop
  have hGc : ∀ a b : Fin 3,
      Continuous (fun s => G (cylPt t (L * Real.cos s) (L * Real.sin s)) a b) :=
    fun a b => (hsmooth a b).continuousOn.comp_continuous hφc hmem
  have hdGc : ∀ i a b : Fin 3, Continuous (fun s =>
      partialDeriv i (fun z => G z a b) (cylPt t (L * Real.cos s) (L * Real.sin s))) := by
    intro i a b
    have h1 : ContinuousOn (fun x => fderiv ℝ (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      (hsmooth a b).continuousOn_fderiv_of_isOpen hU (by simp)
    have h2 : ContinuousOn (fun x => partialDeriv i (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      h1.clm_apply continuousOn_const
    exact h2.comp_continuous hφc hmem
  have hΓc : Continuous (fun s => cylGam G t L s) :=
    continuous_pi fun a => continuous_pi fun b => hGc a.succ b.succ
  have hDc : Continuous (fun s => cylDG G t L s) :=
    continuous_pi fun c => continuous_pi fun a => continuous_pi fun b => hdGc c.succ a.succ b.succ
  have hWc : Continuous (fun s => curvWAlg (cylGam G t L s) (cylDG G t L s) L s) := by
    simp only [curvWAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    fun_prop
  
  have hder : ∀ s : ℝ, HasDerivAt (fun s => -(1 / 2 : ℝ) *
      ((-Real.sin s) * (cylGam G t L s 0 0 - 1) * Real.cos s
        + (-Real.sin s) * cylGam G t L s 0 1 * Real.sin s
        + Real.cos s * cylGam G t L s 1 0 * Real.cos s
        + Real.cos s * (cylGam G t L s 1 1 - 1) * Real.sin s))
      (curvWAlg (cylGam G t L s) (cylDG G t L s) L s) s := by
    intro s
    have hs := Real.hasDerivAt_sin s
    have hc := Real.hasDerivAt_cos s
    have h00 := (hgam s 0 0).sub_const 1
    have h01 := hgam s 0 1
    have h10 := hgam s 1 0
    have h11 := (hgam s 1 1).sub_const 1
    have h := (((((hs.neg.mul h00).mul hc).add ((hs.neg.mul h01).mul hs)).add
      ((hc.mul h10).mul hc)).add ((hc.mul h11).mul hs)).const_mul (-(1 / 2 : ℝ))
    refine h.congr_deriv ?_
    simp only [curvWAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    simp only [Fin.isValue, if_pos rfl, Fin.zero_eq_one_iff, Fin.one_eq_zero_iff,
      OfNat.ofNat_ne_one, one_ne_zero, zero_ne_one, if_false, if_true, sub_zero,
      Pi.mul_apply, Pi.neg_apply]
    ring
  
  have hWi := hWc.intervalIntegrable (μ := volume) 0 (2 * Real.pi)
  refine ⟨hWi, ?_⟩
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hder s) hWi]
  simp only [cylGam, Real.cos_two_pi, Real.sin_two_pi, Real.cos_zero, Real.sin_zero, sub_self]

theorem cyl_curv_term_asymptotics (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 1 / 2 < q) (hR : 1 ≤ R) (hC : 0 < C)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a)
    (hdec : Dec1 G q R C) :
    Tendsto (fun L : ℝ => curvTerm G L - P2 G L) atTop (𝓝 0) :=
by
  
  have inv2 : ∀ (γ : Matrix (Fin 2) (Fin 2) ℝ) (ε : ℝ), 0 ≤ ε → ε ≤ 1 / 20 →
      (∀ a b : Fin 2, |γ a b - (if a = b then (1 : ℝ) else 0)| ≤ ε) →
      ∀ a b : Fin 2, |γ⁻¹ a b - (if a = b then (1 : ℝ) else 0)| ≤ 2 * ε ∧
        |γ⁻¹ a b - (if a = b then (1 : ℝ) else 0) + (γ a b - (if a = b then (1 : ℝ) else 0))|
          ≤ 7 * ε ^ 2 := by
    intro γ ε hε0 hε hγ
    have c00 : (if (0 : Fin 2) = 0 then (1 : ℝ) else 0) = 1 := if_pos rfl
    have c11 : (if (1 : Fin 2) = 1 then (1 : ℝ) else 0) = 1 := if_pos rfl
    have c01 : (if (0 : Fin 2) = 1 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
    have c10 : (if (1 : Fin 2) = 0 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
    obtain ⟨x, e00⟩ : ∃ x, γ 0 0 = 1 + x := ⟨γ 0 0 - 1, by ring⟩
    obtain ⟨w, e11⟩ : ∃ w, γ 1 1 = 1 + w := ⟨γ 1 1 - 1, by ring⟩
    have hx : |x| ≤ ε := by
      have h := hγ 0 0
      rw [c00, e00, add_sub_cancel_left] at h
      exact h
    have hw : |w| ≤ ε := by
      have h := hγ 1 1
      rw [c11, e11, add_sub_cancel_left] at h
      exact h
    have hy : |γ 0 1| ≤ ε := by
      have h := hγ 0 1
      rwa [c01, sub_zero] at h
    have hz : |γ 1 0| ≤ ε := by
      have h := hγ 1 0
      rwa [c10, sub_zero] at h
    have lo : ∀ {a b : ℝ}, |a| ≤ b → -b ≤ a := fun h => (abs_le.mp h).1
    have up : ∀ {a b : ℝ}, |a| ≤ b → a ≤ b := fun h => (abs_le.mp h).2
    have pm : ∀ a b : ℝ, |a| ≤ ε → |b| ≤ ε → |a * b| ≤ ε ^ 2 := by
      intro a b ha hb
      rw [abs_mul, sq]
      exact mul_le_mul ha hb (abs_nonneg _) hε0
    have pm3 : ∀ a b c : ℝ, |a| ≤ ε → |b| ≤ ε → |c| ≤ ε → |a * b * c| ≤ ε ^ 2 / 20 := by
      intro a b c ha hb hc
      have h2 := pm a b ha hb
      rw [abs_mul]
      calc |a * b| * |c| ≤ ε ^ 2 * ε := mul_le_mul h2 hc (abs_nonneg _) (sq_nonneg _)
        _ ≤ ε ^ 2 * (1 / 20) := mul_le_mul_of_nonneg_left hε (sq_nonneg _)
        _ = ε ^ 2 / 20 := by ring
    have hε2 : ε ^ 2 ≤ ε / 20 := by nlinarith
    have hε2' : 0 ≤ ε ^ 2 := sq_nonneg ε
    have hdet : γ.det = (1 + x) * (1 + w) - γ 0 1 * γ 1 0 := by
      rw [Matrix.det_fin_two, e00, e11]
    have hinv : γ⁻¹ = (γ.det)⁻¹ • !![γ 1 1, -γ 0 1; -γ 1 0, γ 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have hΔl : 7 / 8 ≤ γ.det := by
      rw [hdet]
      linarith [lo hx, lo hw, lo (pm x w hx hw), up (pm (γ 0 1) (γ 1 0) hy hz)]
    have hD : 0 < γ.det := by linarith
    have hD' : γ.det ≠ 0 := hD.ne'
    have key : ∀ N M : ℝ, |N| ≤ M → |N / γ.det| ≤ 8 / 7 * M := by
      intro N M h
      rw [abs_div, abs_of_pos hD, div_le_iff₀ hD]
      nlinarith [abs_nonneg N]
    have hi00 : γ⁻¹ 0 0 = (1 + w) / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul, e11]
    have hi01 : γ⁻¹ 0 1 = -γ 0 1 / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have hi10 : γ⁻¹ 1 0 = -γ 1 0 / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have hi11 : γ⁻¹ 1 1 = (1 + x) / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul, e00]
    simp only [Fin.forall_fin_two]
    refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · 
      rw [if_pos trivial, hi00]
      have e : (1 + w) / γ.det - 1 = (1 + w - γ.det) / γ.det := by
        rw [sub_div, div_self hD']
      rw [e]
      refine (key _ (ε + 2 * ε ^ 2) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo hx, up hx, lo (pm x w hx hw), up (pm x w hx hw),
          lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz)]
    · 
      rw [if_pos trivial, hi00, e00]
      have e : (1 + w) / γ.det - 1 + (1 + x - 1) = (1 + w - γ.det + x * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, sub_mul, div_mul_cancel₀ _ hD']
        ring
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x x hx hx), up (pm x x hx hx), lo (pm3 x x w hx hx hw),
          up (pm3 x x w hx hx hw), lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz),
          lo (pm3 x (γ 0 1) (γ 1 0) hx hy hz), up (pm3 x (γ 0 1) (γ 1 0) hx hy hz)]
    · 
      rw [c01, hi01, sub_zero]
      refine (key _ ε (by rwa [abs_neg])).trans (by linarith)
    · 
      rw [c01, hi01, sub_zero, sub_zero]
      have e : -γ 0 1 / γ.det + γ 0 1 = (-γ 0 1 + γ 0 1 * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, div_mul_cancel₀ _ hD']
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x (γ 0 1) hx hy), up (pm x (γ 0 1) hx hy),
          lo (pm w (γ 0 1) hw hy), up (pm w (γ 0 1) hw hy),
          lo (pm3 x w (γ 0 1) hx hw hy), up (pm3 x w (γ 0 1) hx hw hy),
          lo (pm3 (γ 0 1) (γ 0 1) (γ 1 0) hy hy hz), up (pm3 (γ 0 1) (γ 0 1) (γ 1 0) hy hy hz)]
    · 
      rw [c10, hi10, sub_zero]
      refine (key _ ε (by rwa [abs_neg])).trans (by linarith)
    · 
      rw [c10, hi10, sub_zero, sub_zero]
      have e : -γ 1 0 / γ.det + γ 1 0 = (-γ 1 0 + γ 1 0 * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, div_mul_cancel₀ _ hD']
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x (γ 1 0) hx hz), up (pm x (γ 1 0) hx hz),
          lo (pm w (γ 1 0) hw hz), up (pm w (γ 1 0) hw hz),
          lo (pm3 x w (γ 1 0) hx hw hz), up (pm3 x w (γ 1 0) hx hw hz),
          lo (pm3 (γ 0 1) (γ 1 0) (γ 1 0) hy hz hz), up (pm3 (γ 0 1) (γ 1 0) (γ 1 0) hy hz hz)]
    · 
      rw [if_pos trivial, hi11]
      have e : (1 + x) / γ.det - 1 = (1 + x - γ.det) / γ.det := by
        rw [sub_div, div_self hD']
      rw [e]
      refine (key _ (ε + 2 * ε ^ 2) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
