          ≤ ∑ _L : Fin 1 → Fin 3, Cm * ‖x‖ ^ (-p - 1) :=
            Finset.sum_le_sum fun L _ => hterm L
        _ ≤ 9 * Cm * ‖x‖ ^ (-p - ((1 : ℕ) : ℝ)) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
              nsmul_eq_mul]
            have hnn : 0 ≤ Cm * ‖x‖ ^ (-p - 1) := mul_nonneg hCm0 (hrp _)
            push_cast
            nlinarith
    · refine (iteratedFDeriv_norm_le_partials _ hUo' u hu' 2 x hx).trans ?_
      have hterm : ∀ L : Fin 2 → Fin 3,
          |(List.ofFn L).foldr partialDeriv u x| ≤ Cm * ‖x‖ ^ (-p - 2) := by
        intro L
        simp only [List.ofFn_succ, List.ofFn_zero, List.foldr_cons, List.foldr_nil]
        exact ((hder x hx).2 (L 0) (L (Fin.succ 0))).trans
          (mul_le_mul_of_nonneg_right hCm2 (hrp _))
      calc ∑ L : Fin 2 → Fin 3, |(List.ofFn L).foldr partialDeriv u x|
          ≤ ∑ _L : Fin 2 → Fin 3, Cm * ‖x‖ ^ (-p - 2) :=
            Finset.sum_le_sum fun L _ => hterm L
        _ ≤ 9 * Cm * ‖x‖ ^ (-p - ((2 : ℕ) : ℝ)) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
              nsmul_eq_mul]
            have hnn : 0 ≤ Cm * ‖x‖ ^ (-p - 2) := mul_nonneg hCm0 (hrp _)
            push_cast
            nlinarith
  refine Asymptotics.IsBigO.of_bound (9 * Cm) (hevc.mono fun x hx => ?_)
  rw [norm_norm, Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  exact key x hx

theorem conformal_linear_solve [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k : Fin hAF.numEnds)
    (S : Set M) (hS : IsCompact S) (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) :
    ∃ ε₀ C q' : ℝ, 0 < ε₀ ∧ 0 ≤ C ∧ 1 / 2 < q' ∧
      ∀ h : RiemannianMetric3 M, (∀ p : M, p ∉ S → h.g p = g.g p) →
        (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) →
        ∀ V f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
          (∀ p : M, p ∉ S → V p = 0 ∧ f p = 0) → (∀ p : M, |V p| ≤ ε₀) →
          ∃ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧
            (∀ p : M, -8 * h.lapM v p + V p * v p = f p) ∧
            (∀ (j : Fin hAF.numEnds) (l : ℕ), l ≤ 2 →
              (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => v ((hAF.ends j).Φ y)) x‖)
                =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q' - (l : ℝ))) ∧
            (∀ B : ℝ, (∀ p : M, |f p| ≤ B) →
              ∫ y in K, (|v (φ y)| + ‖fderiv ℝ (fun z => v (φ z)) y‖) ≤ C * B) ∧
            ((∀ p : M, f p = -V p) → ∀ p : M, 0 < 1 + v p) :=
by
  obtain ⟨ε₀, C, hε₀, hC, hsol⟩ := cls_energy_solve g hComplete hAF k S hS φ K hK hKφ
  refine ⟨ε₀, C, min hAF.q (3 / 4), hε₀, hC, lt_min hAF.q_gt (by norm_num), ?_⟩
  intro h hh hequiv V f hV hf hVf hVb
  obtain ⟨v, hv, heq, hlim, hB, hP⟩ := hsol h hh hequiv V f hV hf hVf hVb
  refine ⟨v, hv, heq, ?_, hB, hP⟩
  intro j l hl
  obtain ⟨R, hR1, hlap⟩ := cls_far_harmonic g h hAF S hS hh V f v hv hVf heq j
  have hsrc : (hAF.ends j).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends j).source_eq
  have hsmooth : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends j).Φ x a b) {x : E3 | 1 < ‖x‖} := by
    intro a b
    rw [← hsrc]
    exact coeff_contDiffOn_source g (hAF.ends j).Φ a b
  have hu0 : ContDiffOn ℝ ∞ (fun y => v ((hAF.ends j).Φ y)) (hAF.ends j).Φ.source :=
    contMDiffOn_iff_contDiffOn.mp (hv.comp_contMDiffOn (hAF.ends j).Φ.contMDiffOn_toFun)
  have hu : ContDiffOn ℝ ∞ (fun y => v ((hAF.ends j).Φ y)) {x : E3 | R < ‖x‖} := by
    refine hu0.mono ?_
    intro x hx
    rw [hsrc]
    show 1 < ‖x‖
    exact lt_of_le_of_lt hR1 hx
  exact cls_far_decay (g.coeff (hAF.ends j).Φ) hAF.q hAF.q_gt hsmooth
    (fun x a b => g.symm _ _ _) (hAF.decay j) (fun y => v ((hAF.ends j).Φ y)) R hR1 hu hlap
    (hlim j) l hl

theorem harmonic_end_weight [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k : Fin hAF.numEnds) :
    ∃ (ψ : M → ℝ) (q₁ R₁ C₁ : ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ ∧
      (∀ p : M, g.lapM ψ p = 0) ∧ 1 / 2 < q₁ ∧
      (∀ (j' : Fin hAF.numEnds) (x : E3), R₁ < ‖x‖ →
        |ψ ((hAF.ends j').Φ x) - (if j' = k then (1 : ℝ) else 0)| ≤ C₁ * ‖x‖ ^ (-q₁) ∧
        ‖fderiv ℝ (fun y => ψ ((hAF.ends j').Φ y)) x‖ ≤ C₁ * ‖x‖ ^ (-q₁ - 1)) :=
by
  classical
  
  obtain ⟨ρ₀, hρ₀2, hcl⟩ := endChart_far_isClosed g hAF k
  obtain ⟨u₀, hu₀, hoff, hon⟩ := end_cutoff_extension (hAF.ends k) (fun _ => (1 : ℝ)) 1 ρ₀
    le_rfl (by linarith) contDiffOn_const (hcl ρ₀ le_rfl)
  have hconst : ∀ (c : ℝ) (p : M), g.lapM (fun _ => c) p = 0 := by
    intro c p
    have hpc : ∀ (c' : ℝ) (i : Fin 3), partialDeriv i (fun _ : E3 => c') = fun _ => 0 := by
      intro c' i
      funext y
      simp [partialDeriv]
    simp [RiemannianMetric3.lapM, lapLoc, hessLoc, hpc]
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  obtain ⟨A, hAdef⟩ : ∃ A : Set E3, A = Metric.closedBall (0 : E3) (ρ₀ + 1) ∩ {y | ρ₀ ≤ ‖y‖} :=
    ⟨_, rfl⟩
  have hA : IsCompact A := by
    rw [hAdef]
    exact (isCompact_closedBall (0 : E3) (ρ₀ + 1)).inter_right
      (isClosed_le continuous_const continuous_norm)
  have hAsrc : A ⊆ (hAF.ends k).Φ.source := by
    intro y hy
    rw [hAdef] at hy
    have h2 : ρ₀ ≤ ‖y‖ := hy.2
    rw [hsrc]
    show 1 < ‖y‖
    linarith
  have hS : IsCompact ((hAF.ends k).Φ '' A) :=
    hA.image_of_continuousOn ((hAF.ends k).Φ.contMDiffOn_toFun.continuousOn.mono hAsrc)
  have hlap0 : ∀ p : M, p ∉ (hAF.ends k).Φ '' A → g.lapM u₀ p = 0 := by
    intro p hp
    by_cases hpin : p ∈ (hAF.ends k).Φ '' {y : E3 | ρ₀ ≤ ‖y‖}
    · obtain ⟨y, hy, hyp⟩ := hpin
      have hy2 : ρ₀ ≤ ‖y‖ := hy
      have hy' : ρ₀ + 1 < ‖y‖ := by
        by_contra hlt
        push_neg at hlt
        apply hp
        refine ⟨y, ?_, hyp⟩
        rw [hAdef]
        refine ⟨?_, hy⟩
        rw [Metric.mem_closedBall, dist_zero_right]
        exact hlt
      have hO : IsOpen ((hAF.ends k).Φ '' {y : E3 | ρ₀ + 1 < ‖y‖}) := by
        apply (hAF.ends k).Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
          (isOpen_lt continuous_const continuous_norm)
        intro z hz
        have hz' : ρ₀ + 1 < ‖z‖ := hz
        show z ∈ (hAF.ends k).Φ.source
        rw [hsrc]
        show 1 < ‖z‖
        linarith
      have hEq : ∀ q ∈ (hAF.ends k).Φ '' {y : E3 | ρ₀ + 1 < ‖y‖},
          u₀ q = (fun _ => (1 : ℝ)) q := by
        rintro q ⟨z, hz, rfl⟩
        exact hon z (le_of_lt (show ρ₀ + 1 < ‖z‖ from hz))
      rw [((lapM_gradInner_linear_local g u₀ (fun _ => (1 : ℝ)) u₀ p).2 _ hO
        ⟨y, hy', hyp⟩ hEq).1]
      exact hconst 1 p
    · have hO : IsOpen ((hAF.ends k).Φ '' {y : E3 | ρ₀ ≤ ‖y‖})ᶜ := (hcl ρ₀ le_rfl).isOpen_compl
      have hEq : ∀ q ∈ ((hAF.ends k).Φ '' {y : E3 | ρ₀ ≤ ‖y‖})ᶜ,
          u₀ q = (fun _ => (0 : ℝ)) q := by
        intro q hq
        apply hoff
        intro hq'
        apply hq
        exact Set.image_mono (fun z hz => le_of_lt (show ρ₀ < ‖z‖ from hz)) hq'
      rw [((lapM_gradInner_linear_local g u₀ (fun _ => (0 : ℝ)) u₀ p).2 _ hO hpin hEq).1]
      exact hconst 0 p
  have hend : ∀ (j' : Fin hAF.numEnds) (y : E3), ρ₀ + 1 < ‖y‖ →
      u₀ ((hAF.ends j').Φ y) = if j' = k then (1 : ℝ) else 0 := by
    intro j' y hy
    by_cases hj : j' = k
    · subst hj
      rw [if_pos rfl]
      exact hon y hy.le
    · rw [if_neg hj]
      by_contra hne
      have hmem : (hAF.ends j').Φ y ∈ (hAF.ends k).Φ '' {y : E3 | ρ₀ < ‖y‖} := by
        by_contra hnm
        exact hne (hoff _ hnm)
      obtain ⟨y'', hy'', hyeq⟩ := hmem
      have hy''2 : ρ₀ < ‖y''‖ := hy''
      have h1 : y ∈ (hAF.ends j').Φ.source := by
        rw [(hAF.ends j').source_eq]
        show 1 < ‖y‖
        linarith
      have h2 : y'' ∈ (hAF.ends k).Φ.source := by
        rw [(hAF.ends k).source_eq]
        show 1 < ‖y''‖
        linarith
      have t1 := (hAF.ends j').Φ.toPartialEquiv.map_source h1
      have t2 := (hAF.ends k).Φ.toPartialEquiv.map_source h2
      have t2' : (hAF.ends j').Φ y ∈ (hAF.ends k).Φ.target := by
        rw [← hyeq]
        exact t2
      exact Set.disjoint_left.mp (hAF.disjoint hj) t1 t2'
  
  obtain ⟨ε₀, C₀, q', hε₀, hC₀, hq', hsolve⟩ := conformal_linear_solve g hComplete hAF k _ hS
    (hAF.ends k).Φ ∅ isCompact_empty (Set.empty_subset _)
  have hF : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => 8 * g.lapM u₀ p) := by
    have := (contMDiff_const (c := (8 : ℝ))).mul (lapM_contMDiff g u₀ hu₀)
    exact this
  have hcomp : ∀ (p : M) (ξ : E3),
      (1 / 2 : ℝ) * g.g p ξ ξ ≤ g.g p ξ ξ ∧ g.g p ξ ξ ≤ 2 * g.g p ξ ξ := by
    intro p ξ
    have h0 : 0 ≤ g.g p ξ ξ := by
      by_cases hξ : ξ = 0
      · subst hξ
        simp
      · exact (g.posDef p ξ hξ).le
    constructor <;> linarith
  obtain ⟨v, hv, hveq, hvdec, -, -⟩ := hsolve g (fun p _ => rfl) hcomp (fun _ => 0)
    (fun p => 8 * g.lapM u₀ p) contMDiff_const hF
    (fun p hp => ⟨rfl, by simp only; rw [hlap0 p hp, mul_zero]⟩)
    (fun p => by simp only [abs_zero]; exact hε₀.le)
  
  have hharm : ∀ p : M, g.lapM (fun q => u₀ q + v q) p = 0 := by
    intro p
    have h1 := ((lapM_gradInner_linear_local g u₀ v u₀ p).1 hu₀ hv 1 1).1
    simp only [one_mul] at h1
    rw [h1]
    have h2 := hveq p
    simp only [zero_mul, add_zero] at h2
    linarith
  
  have hbd : ∀ (j : Fin hAF.numEnds) (l : ℕ), l ≤ 2 → ∃ c r : ℝ, ∀ x : E3, r < ‖x‖ →
      ‖iteratedFDeriv ℝ l (fun y => v ((hAF.ends j).Φ y)) x‖ ≤ c * ‖x‖ ^ (-q' - (l : ℝ)) := by
    intro j l hl
    obtain ⟨c, hc⟩ := (hvdec j l hl).bound
    obtain ⟨r, -, hr⟩ := (Metric.hasBasis_cobounded_compl_closedBall (0 : E3)).eventually_iff.mp hc
    refine ⟨c, r, fun x hx => ?_⟩
    have hx' : x ∈ (Metric.closedBall (0 : E3) r)ᶜ := by
      rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_zero_right, not_le]
      exact hx
    have := hr hx'
    rwa [norm_norm, Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg x) _)] at this
  choose c r hcr using hbd
  have h0 : (0 : ℕ) ≤ 2 := by norm_num
  have h1 : (1 : ℕ) ≤ 2 := by norm_num
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = ∑ j, (|c j 0 h0| + |c j 1 h1|) := ⟨_, rfl⟩
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = ∑ j, (|r j 0 h0| + |r j 1 h1|) := ⟨_, rfl⟩
  have hCj : ∀ j, |c j 0 h0| + |c j 1 h1| ≤ C := by
    intro j
    rw [hCdef]
    exact Finset.single_le_sum (f := fun j => |c j 0 h0| + |c j 1 h1|)
      (fun j _ => by positivity) (Finset.mem_univ j)
  have hRj : ∀ j, |r j 0 h0| + |r j 1 h1| ≤ R := by
    intro j
    rw [hRdef]
    exact Finset.single_le_sum (f := fun j => |r j 0 h0| + |r j 1 h1|)
      (fun j _ => by positivity) (Finset.mem_univ j)
  
  refine ⟨fun q => u₀ q + v q, q', max R (ρ₀ + 1), C, hu₀.add hv, hharm, hq', ?_⟩
  intro j' x hx
  have hxR : R < ‖x‖ := lt_of_le_of_lt (le_max_left _ _) hx
  have hxa : ρ₀ + 1 < ‖x‖ := lt_of_le_of_lt (le_max_right _ _) hx
  have hxpos : 0 < ‖x‖ := by linarith
  have hr0 : r j' 0 h0 < ‖x‖ := by
    have := hRj j'
    have := le_abs_self (r j' 0 h0)
    have := abs_nonneg (r j' 1 h1)
    linarith
  have hr1 : r j' 1 h1 < ‖x‖ := by
    have := hRj j'
    have := le_abs_self (r j' 1 h1)
    have := abs_nonneg (r j' 0 h0)
    linarith
  have hc0 : c j' 0 h0 ≤ C := by
    have := hCj j'
    have := le_abs_self (c j' 0 h0)
    have := abs_nonneg (c j' 1 h1)
    linarith
  have hc1 : c j' 1 h1 ≤ C := by
    have := hCj j'
    have := le_abs_self (c j' 1 h1)
    have := abs_nonneg (c j' 0 h0)
    linarith
  have hb0 := hcr j' 0 h0 x hr0
  have hb1 := hcr j' 1 h1 x hr1
  rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at hb0
  rw [norm_iteratedFDeriv_one] at hb1
  simp only [Nat.cast_zero, sub_zero, Nat.cast_one] at hb0 hb1
  have hW : ∀ y ∈ {y : E3 | ρ₀ + 1 < ‖y‖},
      u₀ ((hAF.ends j').Φ y) + v ((hAF.ends j').Φ y) =
        (if j' = k then (1 : ℝ) else 0) + v ((hAF.ends j').Φ y) := by
    intro y hy
    rw [hend j' y hy]
  constructor
  · show |u₀ ((hAF.ends j').Φ x) + v ((hAF.ends j').Φ x) - _| ≤ _
    rw [hend j' x hxa, add_sub_cancel_left]
    exact hb0.trans (mul_le_mul_of_nonneg_right hc0 (Real.rpow_nonneg hxpos.le _))
  · have hev : (fun y => u₀ ((hAF.ends j').Φ y) + v ((hAF.ends j').Φ y)) =ᶠ[𝓝 x]
        (fun y => (if j' = k then (1 : ℝ) else 0) + v ((hAF.ends j').Φ y)) :=
      Filter.eventuallyEq_of_mem ((isOpen_lt continuous_const continuous_norm).mem_nhds hxa) hW
    show ‖fderiv ℝ (fun y => u₀ ((hAF.ends j').Φ y) + v ((hAF.ends j').Φ y)) x‖ ≤ _
    rw [hev.fderiv_eq, fderiv_const_add]
    exact hb1.trans (mul_le_mul_of_nonneg_right hc1 (Real.rpow_nonneg hxpos.le _))

theorem harmonic_end_weight_pos [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds) (ψ : M → ℝ)
    (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hharm : ∀ p : M, g.lapM ψ p = 0)
    (q₁ R₁ C₁ : ℝ) (hq₁ : 0 < q₁)
    (hdec : ∀ (j' : Fin hAF.numEnds) (x : E3), R₁ < ‖x‖ →
      |ψ ((hAF.ends j').Φ x) - (if j' = k then (1 : ℝ) else 0)| ≤ C₁ * ‖x‖ ^ (-q₁)) :
    ∀ p : M, 0 < ψ p :=
by
  classical
  
  have hfar_rad : ∀ ε : ℝ, 0 < ε → ∃ R' : ℝ, R₁ ≤ R' ∧ 0 < R' ∧
      ∀ s : ℝ, R' < s → C₁ * s ^ (-q₁) < ε := by
    intro ε hε
    have ht : Tendsto (fun s : ℝ => C₁ * s ^ (-q₁)) atTop (𝓝 0) := by
      have := (tendsto_rpow_neg_atTop hq₁).const_mul C₁
      simpa using this
    obtain ⟨a, ha⟩ := Filter.eventually_atTop.1 (ht.eventually (gt_mem_nhds hε))
    refine ⟨max (max a R₁) 1, (le_max_right a R₁).trans (le_max_left _ _),
      lt_of_lt_of_le one_pos (le_max_right _ _), ?_⟩
    intro s hs
    exact ha s ((le_max_left a R₁).trans ((le_max_left _ _).trans hs.le))
  
  have hcov : ∀ R : ℝ, ∃ K : Set M, IsCompact K ∧ ∀ p : M, p ∉ K →
      ∃ (j : Fin hAF.numEnds) (x : E3), R < ‖x‖ ∧ (hAF.ends j).Φ x = p := by
    intro R
    obtain ⟨A, hAdef⟩ : ∃ A : Set E3, A = {x : E3 | 2 ≤ ‖x‖} ∩ closedBall 0 R := ⟨_, rfl⟩
    have hAc : IsCompact A := by
      rw [hAdef]
      exact (isCompact_closedBall 0 R).inter_left (isClosed_le continuous_const continuous_norm)
    have hAsub : ∀ j : Fin hAF.numEnds, A ⊆ (hAF.ends j).Φ.source := by
      intro j x hx
      rw [hAdef] at hx
      rw [(hAF.ends j).source_eq]
      have h2 : (2 : ℝ) ≤ ‖x‖ := hx.1
      show (1 : ℝ) < ‖x‖
      linarith
    refine ⟨(⋃ j, (hAF.ends j).Φ '' {x : E3 | 2 < ‖x‖})ᶜ ∪ ⋃ j, (hAF.ends j).Φ '' A,
      hAF.isCompact_core.union (isCompact_iUnion fun j => hAc.image_of_continuousOn
        ((hAF.ends j).Φ.contMDiffOn_toFun.continuousOn.mono (hAsub j))), ?_⟩
    intro p hp
    have hp1 : p ∈ ⋃ j, (hAF.ends j).Φ '' {x : E3 | 2 < ‖x‖} := by
      by_contra h
      exact hp (Or.inl h)
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hp1
    obtain ⟨x, hx2, hxp⟩ := hj
    have hx2' : (2 : ℝ) < ‖x‖ := hx2
    refine ⟨j, x, ?_, hxp⟩
    by_contra hle
    push_neg at hle
    apply hp
    refine Or.inr (Set.mem_iUnion.2 ⟨j, x, ?_, hxp⟩)
    rw [hAdef]
    exact ⟨le_of_lt hx2', mem_closedBall_zero_iff.2 hle⟩
  
  have hZ : ∀ p₀ : M, (∀ p, ψ p₀ ≤ ψ p) → ∀ p, ψ p = ψ p₀ := by
    intro p₀ hmin
    have hclosed : IsClosed {p : M | ψ p = ψ p₀} := isClosed_eq hψ.continuous continuous_const
    have hopen : IsOpen {p : M | ψ p = ψ p₀} := by
      rw [isOpen_iff_mem_nhds]
      intro p hp
      have hp' : ψ p = ψ p₀ := hp
      have hloc : IsLocalMin ψ p :=
        Filter.Eventually.of_forall fun q => by rw [hp']; exact hmin q
      have hev := harmonic_local_const_interior g ψ hψ p (Filter.Eventually.of_forall hharm)
        (Or.inr hloc)
      filter_upwards [hev] with q hq
      show ψ q = ψ p₀
      rw [hq, hp']
    have huniv : {p : M | ψ p = ψ p₀} = Set.univ :=
      IsClopen.eq_univ ⟨hclosed, hopen⟩ ⟨p₀, rfl⟩
    intro p
    have hpm : p ∈ {p : M | ψ p = ψ p₀} := by rw [huniv]; trivial
    exact hpm
  
  have hE : ∀ t : ℝ, t < 1 → ∃ p : M, t < ψ p := by
    intro t ht
    obtain ⟨R', hR'1, hR'0, hR'⟩ := hfar_rad (1 - t) (by linarith)
    have hn : ‖(R' + 1) • e 0‖ = R' + 1 := by
      rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_pos (by linarith)]
    have h1 := hdec k ((R' + 1) • e 0) (by rw [hn]; linarith)
    rw [if_pos rfl] at h1
    have h2 := hR' ‖(R' + 1) • e 0‖ (by rw [hn]; linarith)
    refine ⟨(hAF.ends k).Φ ((R' + 1) • e 0), ?_⟩
    have h3 := (abs_le.1 h1).1
    linarith
  
  have hA : ∀ p, 0 ≤ ψ p := by
    by_contra hneg
    push_neg at hneg
    obtain ⟨p₁, hp₁⟩ := hneg
    obtain ⟨R', hR'1, hR'0, hR'⟩ := hfar_rad (-ψ p₁) (by linarith)
    obtain ⟨K, hK, hKcov⟩ := hcov R'
    have hfar : ∀ p, p ∉ K → ψ p₁ < ψ p := by
      intro p hp
      obtain ⟨j, x, hx, rfl⟩ := hKcov p hp
      have h1 := hdec j x (lt_of_le_of_lt hR'1 hx)
      have h2 := hR' ‖x‖ hx
      have h3 := (abs_le.1 h1).1
      have h4 : (0 : ℝ) ≤ (if j = k then (1 : ℝ) else 0) := by split_ifs <;> norm_num
      linarith
    have hp₁K : p₁ ∈ K := by
      by_contra h
      exact lt_irrefl _ (hfar p₁ h)
    obtain ⟨ps, hpsK, hps⟩ := hK.exists_isMinOn ⟨p₁, hp₁K⟩ hψ.continuous.continuousOn
    have hps' : ∀ p ∈ K, ψ ps ≤ ψ p := fun p hp => isMinOn_iff.1 hps p hp
    have hglob : ∀ p, ψ ps ≤ ψ p := by
      intro p
      by_cases hp : p ∈ K
      · exact hps' p hp
      · exact (hps' p₁ hp₁K).trans (hfar p hp).le
    have hconst := hZ ps hglob
    obtain ⟨p₂, hp₂⟩ := hE (ψ p₁) (by linarith)
    have h5 := hps' p₁ hp₁K
    rw [hconst p₂] at hp₂
    linarith
  
  intro p
  by_contra hle
  push_neg at hle
  have h0 : ψ p = 0 := le_antisymm hle (hA p)
  have hconst := hZ p (fun q => by rw [h0]; exact hA q)
  obtain ⟨q, hq⟩ := hE 0 (by norm_num)
  rw [hconst q, h0] at hq
  exact lt_irrefl _ hq

theorem static_deformation_site [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR0 : ∀ p : M, g.scalarCurvature p = 0) (k : Fin hAF.numEnds) (p₀ : M) (j l : Fin 3)
    (hne : ricci (g.coeff (chartAt E3 p₀).symm) j l (chartAt E3 p₀ p₀) ≠ 0) :
    ∃ (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y₁ : E3) (ψ : M → ℝ)
      (q₁ R₁ C₁ : ℝ) (i₁ j₁ : Fin 3),
      y₁ ∈ φ.source ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ ∧ (∀ p : M, g.lapM ψ p = 0) ∧
      1 / 2 < q₁ ∧
      (∀ (j' : Fin hAF.numEnds) (x : E3), R₁ < ‖x‖ →
        |ψ ((hAF.ends j').Φ x) - (if j' = k then (1 : ℝ) else 0)| ≤ C₁ * ‖x‖ ^ (-q₁) ∧
        ‖fderiv ℝ (fun y => ψ ((hAF.ends j').Φ y)) x‖ ≤ C₁ * ‖x‖ ^ (-q₁ - 1)) ∧
      staticSymLoc (g.coeff φ) (fun y => ψ (φ y)) i₁ j₁ y₁ ≠ 0 :=
by
  rcases Nat.lt_or_ge hAF.numEnds 2 with h1 | h2
  · 
    have hpc : ∀ (c : ℝ) (i : Fin 3), partialDeriv i (fun _ : E3 => c) = fun _ => 0 := by
      intro c i
      funext y
      simp [partialDeriv]
    let φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p₀).symm.toPartialEquiv
        open_source := (chartAt E3 p₀).open_target
        open_target := (chartAt E3 p₀).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hsym := ricci_symm_local (g.coeff (chartAt E3 p₀).symm) (chartAt E3 p₀).target
      (chartAt E3 p₀ p₀) (chartAt E3 p₀).open_target (mem_chart_target E3 p₀) (g.smooth p₀)
      (fun z a b => g.symm _ _ _) (fun z hz => (coeff_chart_symm_posDef g p₀ z hz).det_pos.ne') j l
    have hst : ∀ a b : Fin 3, staticLoc (g.coeff (chartAt E3 p₀).symm) (fun _ => (1 : ℝ)) a b
        (chartAt E3 p₀ p₀) = ricci (g.coeff (chartAt E3 p₀).symm) a b (chartAt E3 p₀ p₀) := by
      intro a b
      simp [staticLoc, lapLoc, hessLoc, hpc]
    refine ⟨φ, chartAt E3 p₀ p₀, fun _ => (1 : ℝ), 1, 1, 0, j, l, mem_chart_target E3 p₀,
      contMDiff_const, ?_, by norm_num, ?_, ?_⟩
    · intro p
      simp [RiemannianMetric3.lapM, lapLoc, hessLoc, hpc]
    · intro j' x _
      have hj : j' = k := Fin.ext (by have := j'.isLt; have := k.isLt; omega)
      subst hj
      simp
    · show staticSymLoc (g.coeff (chartAt E3 p₀).symm) (fun _ => (1 : ℝ)) j l
        (chartAt E3 p₀ p₀) ≠ 0
      rw [staticSymLoc, hst, hst, ← hsym]
      intro h
      apply hne
      linarith
  · 
    obtain ⟨k'', hk''⟩ : ∃ k'' : Fin hAF.numEnds, k'' ≠ k := by
      by_cases hk0 : k.val = 0
      · refine ⟨⟨1, by omega⟩, fun h => ?_⟩
        have h' : (1 : ℕ) = k.val := congrArg Fin.val h
        omega
      · refine ⟨⟨0, by omega⟩, fun h => ?_⟩
        have h' : (0 : ℕ) = k.val := congrArg Fin.val h
        omega
    obtain ⟨ψ, q₁, R₁, C₁, hψ, hharm, hq₁, hdec⟩ := harmonic_end_weight g hComplete hAF k
    have hpos := harmonic_end_weight_pos g hAF k ψ hψ hharm q₁ R₁ C₁ (by linarith)
      (fun j' x hx => (hdec j' x hx).1)
    have hsrc : (hAF.ends k'').Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k'').source_eq
    have hGsm : ∀ i j : Fin 3,
        ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends k'').Φ x i j) {x : E3 | 1 < ‖x‖} := by
      intro i j
      rw [← hsrc]
      exact coeff_contDiffOn_source g (hAF.ends k'').Φ i j
    obtain ⟨R', C', hR'1, hC', hdecG⟩ := christoffel_ricci_decay (g.coeff (hAF.ends k'').Φ)
      hAF.q (by linarith [hAF.q_gt]) hGsm (hAF.decay k'')
    have hf : ContDiffOn ℝ ∞ (fun z => ψ ((hAF.ends k'').Φ z)) (hAF.ends k'').Φ.source :=
      contMDiffOn_iff_contDiffOn.mp (hψ.comp_contMDiffOn (hAF.ends k'').Φ.contMDiffOn_toFun)
    obtain ⟨Rm, hRm⟩ : ∃ Rm : ℝ, Rm = max (max R' R₁) 1 := ⟨_, rfl⟩
    have hRm1 : 1 ≤ Rm := by rw [hRm]; exact le_max_right _ _
    have hRmR' : R' ≤ Rm := by rw [hRm]; exact (le_max_left _ _).trans (le_max_left _ _)
    have hRmR₁ : R₁ ≤ Rm := by rw [hRm]; exact (le_max_right _ _).trans (le_max_left _ _)
    have hUx : ∀ x : E3, Rm < ‖x‖ → x ∈ (hAF.ends k'').Φ.source := by
      intro x hx
      rw [hsrc]
      show 1 < ‖x‖
      linarith
    
    have hex : ∃ x₁ : E3, Rm < ‖x₁‖ ∧ ∃ i₁ j₁ : Fin 3,
        staticSymLoc (g.coeff (hAF.ends k'').Φ) (fun y => ψ ((hAF.ends k'').Φ y)) i₁ j₁ x₁ ≠ 0 := by
      by_contra hall
      push_neg at hall
      have heq : ∀ x : E3, Rm < ‖x‖ → ∀ i j : Fin 3,
          partialDeriv i (partialDeriv j (fun y => ψ ((hAF.ends k'').Φ y))) x =
            ∑ k : Fin 3, christoffel (g.coeff (hAF.ends k'').Φ) k i j x *
                partialDeriv k (fun y => ψ ((hAF.ends k'').Φ y)) x +
              ((ricci (g.coeff (hAF.ends k'').Φ) i j x +
                  ricci (g.coeff (hAF.ends k'').Φ) j i x) / 2) * ψ ((hAF.ends k'').Φ x) := by
        intro x hx i j
        have hRx : scalarCurvatureLocal (g.coeff (hAF.ends k'').Φ) x = 0 := by
          rw [← scalarCurvature_eq_scalarCurvatureLocal_coeff g (hAF.ends k'').Φ x (hUx x hx)]
          exact hR0 _
        rw [static_hessian_identity (g.coeff (hAF.ends k'').Φ) (fun y => ψ ((hAF.ends k'').Φ y))
          (hAF.ends k'').Φ.source x (hAF.ends k'').Φ.open_source (hUx x hx) hf
          (fun z a b => g.symm _ _ _) (coeff_posDef g (hAF.ends k'').Φ x (hUx x hx)).det_pos.ne'
          hRx (hall x hx) i j]
        ring
      have hR'x : ∀ x : E3, Rm < ‖x‖ → R' < ‖x‖ := fun x hx => lt_of_le_of_lt hRmR' hx
      have hR₁x : ∀ x : E3, Rm < ‖x‖ → R₁ < ‖x‖ := fun x hx => lt_of_le_of_lt hRmR₁ hx
      have hmono : ∀ (c : ℝ) (x : E3) (s : ℝ), c ≤ max C' C₁ → c * ‖x‖ ^ s ≤ max C' C₁ * ‖x‖ ^ s :=
        fun c x s hc => mul_le_mul_of_nonneg_right hc (Real.rpow_nonneg (norm_nonneg _) _)
      obtain ⟨ρ, hρ⟩ := decaying_hessian_rigidity (fun y => ψ ((hAF.ends k'').Φ y))
        (christoffel (g.coeff (hAF.ends k'').Φ))
        (fun i j x => (ricci (g.coeff (hAF.ends k'').Φ) i j x +
          ricci (g.coeff (hAF.ends k'').Φ) j i x) / 2)
        hAF.q (q₁ + 1) Rm (max C' C₁) (by linarith [hAF.q_gt]) (by linarith) hRm1
        (hf.mono fun x hx => hUx x hx)
        (by
          intro x hx k' i j
          exact ((hdecG x (hR'x x hx)).2.1 k' i j).trans (hmono C' x _ (le_max_left _ _)))
        (by
          intro x hx i j
          have ha := ((hdecG x (hR'x x hx)).2.2 i j).trans (hmono C' x _ (le_max_left _ _))
          have hb := ((hdecG x (hR'x x hx)).2.2 j i).trans (hmono C' x _ (le_max_left _ _))
          rw [abs_le] at ha hb ⊢
          constructor <;> linarith [ha.1, ha.2, hb.1, hb.2])
        (by
          intro x hx
          have h0 := (hdec k'' x (hR₁x x hx)).1
          rw [if_neg hk'', sub_zero] at h0
          have he : (1 - (q₁ + 1)) = -q₁ := by ring
          rw [he]
          exact h0.trans (hmono C₁ x _ (le_max_right _ _)))
        (by
          intro x hx
          have h0 := (hdec k'' x (hR₁x x hx)).2
          have he : (-(q₁ + 1)) = -q₁ - 1 := by ring
          rw [he]
          exact h0.trans (hmono C₁ x _ (le_max_right _ _)))
        heq
      have hn : ‖(max ρ Rm + 1) • e 0‖ = max ρ Rm + 1 := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
          abs_of_pos (by linarith [le_max_right ρ Rm])]
      have hz := hρ ((max ρ Rm + 1) • e 0) (by rw [hn]; linarith [le_max_left ρ Rm])
      have hp := hpos ((hAF.ends k'').Φ ((max ρ Rm + 1) • e 0))
      simp only at hz
      linarith
    obtain ⟨x₁, hx₁, i₁, j₁, hS⟩ := hex
    exact ⟨(hAF.ends k'').Φ, x₁, ψ, q₁, R₁, C₁, i₁, j₁, hUx x₁ hx₁, hψ, hharm, hq₁, hdec, hS⟩

theorem deform_metric_in_chart [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (K : Set E3) (hK : IsCompact K)
    (hKφ : K ⊆ φ.source) (H : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i)
    (hHK : ∀ y, y ∉ K → H y = 0) :
    ∃ t₀ : ℝ, 0 < t₀ ∧ ∀ t : ℝ, |t| < t₀ → ∃ h : RiemannianMetric3 M,
      (∀ p : M, p ∉ φ '' K → h.g p = g.g p) ∧
      (∀ y ∈ φ.source, h.coeff φ y = g.coeff φ y + t • H y) ∧
      (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) :=
by
  classical
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hproj : ∀ (a : Fin 3) (v : E3), EuclideanSpace.proj a v = v a := fun _ _ => rfl
  
  have inv1 : ∀ y ∈ φ.source, ∀ v : E3,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y v) = v := by
    intro y hy v
    have h1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm (φ y) :=
      φ.symm.mdifferentiableAt hn (φ.toPartialEquiv.map_source hy)
    have h2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y := φ.mdifferentiableAt hn hy
    have heq : (φ.symm ∘ φ) =ᶠ[𝓝 y] id := by
      filter_upwards [φ.open_source.mem_nhds hy] with z hz
      exact φ.toPartialEquiv.left_inv hz
    have h3 := mfderiv_comp y h1 h2
    rw [heq.mfderiv_eq, mfderiv_id] at h3
    have h4 := congrArg (fun L => L v) h3
    simpa using h4.symm
  have inv2 : ∀ p ∈ φ.target, ∀ w : E3,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ (φ.symm p) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p w) = w := by
    intro p hp w
    have h1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ (φ.symm p) :=
      φ.mdifferentiableAt hn (φ.toPartialEquiv.map_target hp)
    have h2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p := φ.symm.mdifferentiableAt hn hp
    have heq : (φ ∘ φ.symm) =ᶠ[𝓝 p] id := by
      filter_upwards [φ.open_target.mem_nhds hp] with z hz
      exact φ.toPartialEquiv.right_inv hz
    have h3 := mfderiv_comp p h1 h2
    rw [heq.mfderiv_eq, mfderiv_id] at h3
    have h4 := congrArg (fun L => L w) h3
    simpa using h4.symm
  
  have bil : ∀ (β : E3 →L[ℝ] E3 →L[ℝ] ℝ) (u w : E3),
      β u w = ∑ i : Fin 3, ∑ j : Fin 3, u i * β (e i) (e j) * w j := by
    intro β u w
    have hu : u = u 0 • e 0 + u 1 • e 1 + u 2 • e 2 := by
      ext k; fin_cases k <;> simp [EuclideanSpace.single_apply]
    have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
      ext k; fin_cases k <;> simp [EuclideanSpace.single_apply]
    conv_lhs => rw [hu, hw]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Fin.sum_univ_three]
    ring
  
  have lowb : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContinuousOn (fun y => G y i j) K) →
      (∀ y ∈ K, ∀ a : E3, a ≠ 0 → 0 < ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j) →
      ∃ c : ℝ, 0 < c ∧ ∀ y ∈ K, ∀ a : E3,
        c * ‖a‖ ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j := by
    intro G hGc hpos
    rcases K.eq_empty_or_nonempty with hKe | hKne
    · exact ⟨1, one_pos, by simp [hKe]⟩
    set Q : E3 × E3 → ℝ := fun z => ∑ i : Fin 3, ∑ j : Fin 3, z.2 i * G z.1 i j * z.2 j with hQ
    have hS : IsCompact (K ×ˢ sphere (0 : E3) 1) := hK.prod (isCompact_sphere 0 1)
    have hSne : (K ×ˢ sphere (0 : E3) 1).Nonempty :=
      hKne.prod (NormedSpace.sphere_nonempty.2 zero_le_one)
    have hQc : ContinuousOn Q (K ×ˢ sphere (0 : E3) 1) := by
      have hco : ∀ i : Fin 3, Continuous (fun z : E3 × E3 => z.2 i) := fun i =>
        (EuclideanSpace.proj i).continuous.comp continuous_snd
      refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
      refine ((hco i).continuousOn.mul ?_).mul (hco j).continuousOn
      exact (hGc i j).comp continuousOn_fst (fun z hz => hz.1)
    obtain ⟨z, hz, hmin⟩ := hS.exists_isMinOn hSne hQc
    have hz2 : z.2 ≠ 0 := by
      intro h; have := hz.2; rw [h] at this; simp at this
    refine ⟨Q z, hpos z.1 hz.1 z.2 hz2, fun y hy a => ?_⟩
    rcases eq_or_ne a 0 with rfl | ha
    · simp
    have hna : 0 < ‖a‖ := norm_pos_iff.2 ha
    have hmem : (y, ‖a‖⁻¹ • a) ∈ K ×ˢ sphere (0 : E3) 1 := by
      refine ⟨hy, ?_⟩
      simp [norm_smul, hna.ne']
    have h1 : Q z ≤ Q (y, ‖a‖⁻¹ • a) := hmin hmem
    have h2 : Q (y, ‖a‖⁻¹ • a) =
        ‖a‖⁻¹ ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j := by
      simp only [hQ, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
      ring
    rw [h2] at h1
    have h3 : ‖a‖ ^ 2 * (‖a‖⁻¹ ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j) =
        ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j := by
      field_simp
    calc Q z * ‖a‖ ^ 2
        ≤ (‖a‖⁻¹ ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, a i * G y i j * a j) * ‖a‖ ^ 2 :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = _ := by rw [mul_comm]; exact h3
  
  have hGsm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => g.coeff φ x i j) φ.source := by
    intro i j
    have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
      intro w
      ext k
      simp [e, Pi.single_apply]
    have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
        B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
      intro B D w1 w2
      calc B (D w1) (D w2)
          = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
            rw [← hw w1, ← hw w2]
        _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
            simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
              ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
            conv_lhs => rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
            ring
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ φ φ.source := φ.contMDiffOn_toFun
    apply contDiffOn_of_locally_contDiffOn
    intro x0 hx0
    have hu : IsOpen (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) :=
      hΦ.continuousOn.isOpen_inter_preimage φ.open_source (chartAt E3 (φ x0)).open_source
    have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (φ x0) (φ y))
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) := by
      have h1 := (contMDiffOn_iff_target.mp hΦ).2 (φ x0)
      rw [extChartAt_source] at h1
      have h2 := contMDiffOn_iff_contDiffOn.mp h1
      simpa [extChartAt_coe, Function.comp_def] using h2
    have hmaps : Set.MapsTo (fun y => chartAt E3 (φ x0) (φ y))
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) (chartAt E3 (φ x0)).target :=
      fun y hy => (chartAt E3 (φ x0)).map_source hy.2
    have hD : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)))
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hu).mp hF).2
    have hcoord : ∀ k a : Fin 3, ContDiffOn ℝ ∞
        (fun x => (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e k)) a)
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) := by
      intro k a
      have h2 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e k))
          (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) := hD.clm_apply contDiffOn_const
      exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
    have hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞
        (fun x => g.coeff (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) a b)
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) :=
      fun a b => (g.smooth (φ x0) a b).comp hF hmaps
    have hR : ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e j)) b *
        g.coeff (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) a b)
        (φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source) := by
      apply ContDiffOn.sum
      intro a _
      apply ContDiffOn.sum
      intro b _
      exact ((hcoord i a).mul (hcoord j b)).mul (hG a b)
    have key : ∀ x ∈ φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source,
        g.coeff φ x i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x (e j)) b *
        g.coeff (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) a b := by
      intro x hx
      have hcont : ContinuousAt φ x :=
        hΦ.continuousOn.continuousAt (φ.open_source.mem_nhds hx.1)
      have hFdiff : DifferentiableAt ℝ (fun y => chartAt E3 (φ x0) (φ y)) x :=
        (hF.contDiffAt (hu.mem_nhds hx)).differentiableAt (by simp)
      have hFx : chartAt E3 (φ x0) (φ x) ∈ (chartAt E3 (φ x0)).target := hmaps hx
      have hev : (φ : E3 → M) =ᶠ[𝓝 x]
          ((chartAt E3 (φ x0)).symm ∘ fun y => chartAt E3 (φ x0) (φ y)) := by
        have hmem : (φ : E3 → M) ⁻¹' (chartAt E3 (φ x0)).source ∈ 𝓝 x :=
          hcont.preimage_mem_nhds ((chartAt E3 (φ x0)).open_source.mem_nhds hx.2)
        filter_upwards [hmem] with y hy
        simp only [Function.comp_apply]
        exact ((chartAt E3 (φ x0)).left_inv hy).symm
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (φ x0)).symm
          (chartAt E3 (φ x0) (φ x)) :=
        ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
          ((chartAt E3 (φ x0)).open_target.mem_nhds hFx)).mdifferentiableAt (by simp)
      have hfac : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ x v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x))
            (fderiv ℝ (fun y => chartAt E3 (φ x0) (φ y)) x v) := by
        intro v
        rw [hev.mfderiv_eq, mfderiv_comp x hg hFdiff.mdifferentiableAt, mfderiv_eq_fderiv]
        rfl
      have hpt : (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) = φ x :=
        (chartAt E3 (φ x0)).left_inv hx.2
      have h1 : g.coeff φ x i j = g.g (φ x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ x (e i))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ x (e j)) := rfl
      have h2 : ∀ a b : Fin 3,
          g.coeff (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) a b =
          g.g (φ x)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)) (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x))
              (e b)) := by
        intro a b
        show g.g ((chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x))) _ _ = _
        rw [show g.g ((chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x))) = g.g (φ x) from
          congrArg g.g hpt]
      rw [h1, hfac, hfac]
      simp only [h2]
      exact hexp (g.g (φ x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (φ x0)).symm (chartAt E3 (φ x0) (φ x)))
        _ _
    refine ⟨φ.source ∩ φ ⁻¹' (chartAt E3 (φ x0)).source, hu,
      ⟨hx0, mem_chart_source E3 (φ x0)⟩, ?_⟩
    rw [Set.inter_eq_right.mpr Set.inter_subset_left]
    exact hR.congr key
  have hGc : ∀ i j : Fin 3, ContinuousOn (fun y => g.coeff φ y i j) K := fun i j =>
    (hGsm i j).continuousOn.mono hKφ
  
  have hquad : ∀ y (u : E3), ∑ i : Fin 3, ∑ j : Fin 3, u i * g.coeff φ y i j * u j =
      g.g (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u) := by
    intro y u
    have h1 := bil ((g.g (φ y)).bilinearComp (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y)
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y)) u u
    simp only [ContinuousLinearMap.bilinearComp_apply] at h1
    exact h1.symm
  have hGpos : ∀ y ∈ K, ∀ a : E3, a ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, a i * g.coeff φ y i j * a j := by
    intro y hy a ha
    rw [hquad]
    apply g.posDef
    intro h0
    apply ha
    have := inv1 y (hKφ hy) a
    rw [h0, map_zero] at this
    exact this.symm
  obtain ⟨c, hc, hcK⟩ := lowb (g.coeff φ) hGc hGpos
  have hHb : ∀ a b : Fin 3, ∃ C : ℝ, ∀ y ∈ K, ‖H y a b‖ ≤ C := fun a b =>
    hK.exists_bound_of_continuousOn (hH a b).continuous.continuousOn
  choose C hC using hHb
  obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = ∑ a : Fin 3, ∑ b : Fin 3, max (C a b) 0 := ⟨_, rfl⟩
  have hη0 : 0 ≤ η := by
    rw [hηdef]
    exact Finset.sum_nonneg fun a _ => Finset.sum_nonneg fun b _ => le_max_right _ _
  have hHη : ∀ y ∈ K, ∑ a : Fin 3, ∑ b : Fin 3, |H y a b| ≤ η := by
    intro y hy
    rw [hηdef]
    refine Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun b _ => ?_
    have := hC a b y hy
    rw [Real.norm_eq_abs] at this
    exact this.trans (le_max_left _ _)
  refine ⟨c / (2 * η + 1), div_pos hc (by linarith), fun t ht => ?_⟩
  have hT : 2 * |t| * η ≤ c := by
    have h1 : |t| * (2 * η + 1) < c := (lt_div_iff₀ (by linarith)).1 ht
    nlinarith [abs_nonneg t]
  
  obtain ⟨Dm, hDm⟩ : ∃ Dm : M → E3 →L[ℝ] E3,
      ∀ p, Dm p = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p :=
    ⟨fun p => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p, fun _ => rfl⟩
  obtain ⟨P, hPdef⟩ : ∃ P : M → E3 →L[ℝ] E3 →L[ℝ] ℝ, P = fun p =>
      if p ∈ φ.target then
        ∑ a : Fin 3, ∑ b : Fin 3, (t * H (φ.symm p) a b) •
          ((EuclideanSpace.proj a).comp (Dm p)).smulRight
            ((EuclideanSpace.proj b).comp (Dm p))
      else 0 := ⟨_, rfl⟩
  have hPev : ∀ p ∈ φ.target, ∀ ξ ζ : E3, P p ξ ζ = ∑ a : Fin 3, ∑ b : Fin 3,
      t * H (φ.symm p) a b * EuclideanSpace.proj a (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p ξ) *
        EuclideanSpace.proj b (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p ζ) := by
    intro p hp ξ ζ
    rw [hPdef]
    simp only [if_pos hp, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.comp_apply, smul_eq_mul, hDm]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    exact (mul_assoc _ _ _).symm
  have hP0 : ∀ p, (p ∉ φ.target ∨ φ.symm p ∉ K) → P p = 0 := by
    intro p hp
    by_cases hpt : p ∈ φ.target
    · have hnK : φ.symm p ∉ K := hp.resolve_left (not_not.2 hpt)
      ext ξ ζ
      rw [hPev p hpt, hHK _ hnK]
      simp
    · rw [hPdef]
      simp only [if_neg hpt]
  have hPoff : ∀ p, p ∉ φ '' K → P p = 0 := by
    intro p hp
    apply hP0
    by_cases hpt : p ∈ φ.target
    · right
      intro hK'
      exact hp ⟨φ.symm p, hK', φ.toPartialEquiv.right_inv hpt⟩
    · left; exact hpt
  
  have hPsymm : ∀ p (v w : E3), P p v w = P p w v := by
    intro p v w
    by_cases hpt : p ∈ φ.target
    · rw [hPev p hpt, hPev p hpt, Finset.sum_comm]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      rw [hHs (φ.symm p) a b]
      ring
    · rw [hP0 p (Or.inl hpt)]
      rfl
  
  have hgnn : ∀ p (ξ : E3), 0 ≤ g.g p ξ ξ := by
    intro p ξ
    rcases eq_or_ne ξ 0 with rfl | hξ
    · simp
    · exact (g.posDef p ξ hξ).le
  have hPb : ∀ p (ξ : E3), |P p ξ ξ| ≤ (1 / 2) * g.g p ξ ξ := by
    intro p ξ
    by_cases hcase : p ∈ φ.target ∧ φ.symm p ∈ K
    · obtain ⟨hpt, hyK⟩ := hcase
      have hev := hPev p hpt ξ ξ
      have hinv := inv2 p hpt ξ
      obtain ⟨y, hyd⟩ : ∃ y, φ.symm p = y := ⟨_, rfl⟩
      obtain ⟨u, hud⟩ : ∃ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm p ξ = u := ⟨_, rfl⟩
      rw [hud, hyd] at hev
      rw [hud, hyd] at hinv
      rw [hyd] at hyK
      have hφy : φ y = p := by rw [← hyd]; exact φ.toPartialEquiv.right_inv hpt
      have hgu : g.g p ξ ξ = ∑ i : Fin 3, ∑ j : Fin 3, u i * g.coeff φ y i j * u j := by
        have h1 := bil ((g.g (φ y)).bilinearComp (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y)) u u
        simp only [ContinuousLinearMap.bilinearComp_apply] at h1
        calc g.g p ξ ξ = g.g (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u)
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u) := by rw [hinv, hφy]
          _ = _ := h1
      have hL : c * ‖u‖ ^ 2 ≤ g.g p ξ ξ := by rw [hgu]; exact hcK y hyK u
      have hPu : P p ξ ξ = t * ∑ a : Fin 3, ∑ b : Fin 3, H y a b * u a * u b := by
        rw [hev, Finset.mul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [hproj, hproj]
        ring
      have habs : |∑ a : Fin 3, ∑ b : Fin 3, H y a b * u a * u b| ≤ η * ‖u‖ ^ 2 := by
        calc |∑ a : Fin 3, ∑ b : Fin 3, H y a b * u a * u b|
            ≤ ∑ a : Fin 3, ∑ b : Fin 3, |H y a b * u a * u b| :=
              (Finset.abs_sum_le_sum_abs _ _).trans
                (Finset.sum_le_sum fun a _ => Finset.abs_sum_le_sum_abs _ _)
          _ ≤ ∑ a : Fin 3, ∑ b : Fin 3, |H y a b| * ‖u‖ ^ 2 := by
              refine Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun b _ => ?_
              rw [abs_mul, abs_mul]
              have ha := PiLp.norm_apply_le u a
              have hb := PiLp.norm_apply_le u b
              rw [Real.norm_eq_abs] at ha hb
              calc |H y a b| * |u a| * |u b| ≤ |H y a b| * ‖u‖ * ‖u‖ := by gcongr
                _ = |H y a b| * ‖u‖ ^ 2 := by ring
          _ = (∑ a : Fin 3, ∑ b : Fin 3, |H y a b|) * ‖u‖ ^ 2 := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl fun a _ => ?_
              rw [Finset.sum_mul]
          _ ≤ η * ‖u‖ ^ 2 := mul_le_mul_of_nonneg_right (hHη y hyK) (by positivity)
      rw [hPu, abs_mul]
      have h1 : |t| * |∑ a : Fin 3, ∑ b : Fin 3, H y a b * u a * u b| ≤ |t| * (η * ‖u‖ ^ 2) :=
        mul_le_mul_of_nonneg_left habs (abs_nonneg t)
      have h2 : |t| * (η * ‖u‖ ^ 2) ≤ c / 2 * ‖u‖ ^ 2 := by
        nlinarith [mul_nonneg (sub_nonneg.2 hT) (sq_nonneg ‖u‖)]
      linarith
    · have h0 : P p = 0 := hP0 p (by tauto)
      rw [h0, ContinuousLinearMap.zero_apply, ContinuousLinearMap.zero_apply, abs_zero]
      linarith [hgnn p ξ]
  
  have hφKt : φ '' K ⊆ φ.target := by
    rintro _ ⟨y, hy, rfl⟩
    exact φ.toPartialEquiv.map_source (hKφ hy)
  have hφKc : IsClosed (φ '' K) :=
    (hK.image_of_continuousOn (φ.contMDiffOn_toFun.continuousOn.mono hKφ)).isClosed
  have hsm : ∀ x₀ : M, ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun y => coeffMatrix (fun p => g.g p + P p) (chartAt E3 x₀).symm y i j)
      (chartAt E3 x₀).target := by
    intro x₀ i j
    have hsplit : (fun y => coeffMatrix (fun p => g.g p + P p) (chartAt E3 x₀).symm y i j) =
        fun y => coeffMatrix g.g (chartAt E3 x₀).symm y i j +
          P ((chartAt E3 x₀).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y (e i))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y (e j)) := by
      funext y
      simp only [coeffMatrix, ContinuousLinearMap.add_apply]
    rw [hsplit]
    refine (g.smooth x₀ i j).add ?_
    have hW₁ : IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
      (chartAt E3 x₀).continuousOn_symm.isOpen_inter_preimage (chartAt E3 x₀).open_target
        φ.open_target
    have hW₂ : IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' (φ '' K)ᶜ) :=
      (chartAt E3 x₀).continuousOn_symm.isOpen_inter_preimage (chartAt E3 x₀).open_target
        hφKc.isOpen_compl
    apply contDiffOn_of_locally_contDiffOn
    intro y hy
    by_cases hyt : (chartAt E3 x₀).symm y ∈ φ.target
    · refine ⟨_, hW₁, ⟨hy, hyt⟩, ?_⟩
      have hτ : ContDiffOn ℝ ∞ (fun z => φ.symm ((chartAt E3 x₀).symm z))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) := by
        have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun z => φ.symm ((chartAt E3 x₀).symm z))
            ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
          φ.symm.contMDiffOn_toFun.comp
            ((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (n := ∞) (x := x₀)).mono
              Set.inter_subset_left) (fun z hz => hz.2)
        exact contMDiffOn_iff_contDiffOn.1 h1
      have hder : ∀ z ∈ (chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target, ∀ v : E3,
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm ((chartAt E3 x₀).symm z)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm z v) =
          fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z v := by
        intro z hz v
        have h1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ.symm ((chartAt E3 x₀).symm z) :=
          φ.symm.mdifferentiableAt hn hz.2
        have h2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm z :=
          (((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (n := ∞) (x := x₀)) z hz.1).contMDiffAt
            ((chartAt E3 x₀).open_target.mem_nhds hz.1)).mdifferentiableAt hn
        have h3 := mfderiv_comp z h1 h2
        rw [mfderiv_eq_fderiv] at h3
        rw [show (fun z => φ.symm ((chartAt E3 x₀).symm z)) = φ.symm ∘ (chartAt E3 x₀).symm
          from rfl, h3]
        rfl
      have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hW₁).1 hτ).2
      have hcomp : ∀ (k a : Fin 3), ContDiffOn ℝ ∞ (fun z => EuclideanSpace.proj a
          (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e k)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) := by
        intro k a
        have h2 : ContDiffOn ℝ ∞
            (fun z => fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e k))
            ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
          hfd.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
      have hHτ : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => H (φ.symm ((chartAt E3 x₀).symm z)) a b)
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) := fun a b =>
        (hH a b).comp_contDiffOn hτ
      have hF : ContDiffOn ℝ ∞ (fun z => t * ∑ a : Fin 3, ∑ b : Fin 3,
          EuclideanSpace.proj a (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e i)) *
            H (φ.symm ((chartAt E3 x₀).symm z)) a b *
            EuclideanSpace.proj b (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e j)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
        contDiffOn_const.mul (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          ((hcomp i a).mul (hHτ a b)).mul (hcomp j b))
      refine (hF.mono Set.inter_subset_right).congr fun z hz => ?_
      rw [hPev _ hz.2.2, hder z hz.2 (e i), hder z hz.2 (e j), Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      ring
    · refine ⟨_, hW₂, ⟨hy, fun hmem => hyt (hφKt hmem)⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr fun z hz => ?_
      rw [hPoff _ hz.2.2]
      rfl
  
  have hsym : ∀ x (v w : E3), (fun p => g.g p + P p) x v w = (fun p => g.g p + P p) x w v := by
    intro x v w
    simp only [ContinuousLinearMap.add_apply]
    rw [g.symm x v w, hPsymm x v w]
  have hpd : ∀ x (v : E3), v ≠ 0 → 0 < (fun p => g.g p + P p) x v v := by
    intro x v hv
    simp only [ContinuousLinearMap.add_apply]
    have h1 := (abs_le.1 (hPb x v)).1
    have h2 := g.posDef x v hv
    linarith
  refine ⟨⟨fun p => g.g p + P p, hsym, hpd, hsm⟩, ?_, ?_, ?_⟩
  · intro p hp
    show g.g p + P p = g.g p
    rw [hPoff p hp, add_zero]
  · intro y hy
    ext i j
    have hpt : φ y ∈ φ.target := φ.toPartialEquiv.map_source hy
    have hsy : φ.symm (φ y) = y := φ.toPartialEquiv.left_inv hy
    have hc : P (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (e j)) = t * H y i j := by
      rw [hPev _ hpt, inv1 y hy, inv1 y hy, hsy]
      fin_cases i <;> fin_cases j <;>
        simp [Fin.sum_univ_three, hproj, EuclideanSpace.single_apply]
    rw [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, ← hc]
    show (g.g (φ y) + P (φ y)) _ _ = _
    rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.add_apply]
    rfl
  · intro p ξ
    show (1 / 2 : ℝ) * g.g p ξ ξ ≤ (g.g p + P p) ξ ξ ∧ (g.g p + P p) ξ ξ ≤ 2 * g.g p ξ ξ
    rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.add_apply]
    have h1 := abs_le.1 (hPb p ξ)
    have h2 := hgnn p ξ
    constructor <;> linarith [h1.1, h1.2]

theorem local_geometry_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hdet : ∀ y ∈ U, (G y).det ≠ 0) (hf : ContDiffOn ℝ ∞ f U) :
    (∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (ricci G i j) U) ∧
    ContDiffOn ℝ ∞ (scalarCurvatureLocal G) U ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticSymLoc G f i j) U) :=
by
  classical
  
  have hpd : ∀ h : E3 → ℝ, ContDiffOn ℝ ∞ h U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c h) U := by
    intro h hh c
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hh).2
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y (e c)) U
    exact hD.clm_apply contDiffOn_const
  
  have hdetgen : ∀ F : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) U) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) U := by
    intro F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := U) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) U := by
    intro i j
    simp only [Matrix.adjugate_apply]
    refine hdetgen (fun z => (G z).updateRow j (Pi.single i 1)) ?_
    intro a b
    by_cases hab : a = j
    · subst hab
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hab]
      exact hG a b
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) U := by
    intro i j
    have heq : (fun z => (G z)⁻¹ i j) =
        fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen _ hG).inv hdet).mul (hadj i j)
  have hpar : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) U :=
    fun a b c => hpd _ (hG a b) c
  
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => christoffel G k i j y) U
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinv k l).mul (((hpar j l i).add (hpar i l j)).sub (hpar i j l))))
  
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) U := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ricci G j k y) U
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun p _ =>
        ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k)))))
    exact (hpd _ (hΓ i j k) i).sub (hpd _ (hΓ i i k) j)
  
  have hScal : ContDiffOn ℝ ∞ (scalarCurvatureLocal G) U := by
    show ContDiffOn ℝ ∞ (fun y => scalarCurvatureLocal G y) U
    unfold scalarCurvatureLocal
    exact ContDiffOn.sum (fun j _ => ContDiffOn.sum (fun k _ => (hinv j k).mul (hRic j k)))
  
  have hdf : ∀ j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv j f) U := fun j => hpd f hf j
  have hHess : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => hessLoc G f i j y) U
    unfold hessLoc
    exact (hpd _ (hdf j) i).sub (ContDiffOn.sum (fun k _ => (hΓ k i j).mul (hdf k)))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G f) U := by
    show ContDiffOn ℝ ∞ (fun y => lapLoc G f y) U
    unfold lapLoc
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ => (hinv i j).mul (hHess i j)))
  have hSt : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticLoc G f i j y) U
    unfold staticLoc
    exact ((hf.mul (hRic i j)).sub (hHess i j)).add (hLap.mul (hG i j))
  have hSym : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticSymLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticSymLoc G f i j y) U
    unfold staticSymLoc
    exact ((hSt i j).add (hSt j i)).div_const 2
  exact ⟨hΓ, hRic, hScal, hSym⟩

theorem scalarCurvature_of_local_deformation [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g h : RiemannianMetric3 M) (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) (H : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (t : ℝ) (hh : ∀ p : M, p ∉ φ '' K → h.g p = g.g p)
    (hcoeff : ∀ y ∈ φ.source, h.coeff φ y = g.coeff φ y + t • H y) :
    ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h.scalarCurvature ∧
    (∀ p : M, p ∉ φ '' K → h.scalarCurvature p = g.scalarCurvature p) ∧
    (∀ y ∈ φ.source, h.scalarCurvature (φ y) =
      scalarCurvatureLocal (fun z => g.coeff φ z + t • H z) y) :=
by
  
  have hloc : ∀ (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3), G =ᶠ[𝓝 y] G' →
      scalarCurvatureLocal G y = scalarCurvatureLocal G' y := by
    intro G G' y hGG
    have hpd : ∀ (z : E3) (f f' : E3 → ℝ), f =ᶠ[𝓝 z] f' →
        ∀ m, partialDeriv m f z = partialDeriv m f' z := by
      intro z f f' hf m
      unfold partialDeriv
      rw [hf.fderiv_eq]
    have hchr : ∀ z, G =ᶠ[𝓝 z] G' → ∀ k i j, christoffel G k i j z = christoffel G' k i j z := by
      intro z hz k i j
      have h0 : G z = G' z := hz.eq_of_nhds
      have hent : ∀ a b m, partialDeriv m (fun w => G w a b) z =
          partialDeriv m (fun w => G' w a b) z :=
        fun a b m => hpd z _ _ (hz.mono fun w hw => by simp only [hw]) m
      unfold christoffel
      simp only [h0, hent]
    have hchrev : ∀ k i j, christoffel G k i j =ᶠ[𝓝 y] christoffel G' k i j := fun k i j =>
      hGG.eventuallyEq_nhds.mono fun z hz => hchr z hz k i j
    have hP : ∀ a b c m, partialDeriv m (christoffel G a b c) y =
        partialDeriv m (christoffel G' a b c) y :=
      fun a b c m => hpd y _ _ (hchrev a b c) m
    have hV : ∀ a b c, christoffel G a b c y = christoffel G' a b c y :=
      fun a b c => (hchrev a b c).eq_of_nhds
    have hric : ∀ j k, ricci G j k y = ricci G' j k y := by
      intro j k
      unfold ricci
      simp only [hP, hV]
    have hGy : G y = G' y := hGG.eq_of_nhds
    unfold scalarCurvatureLocal
    simp only [hGy, hric]
  
  have hsmooth : ∀ g' : RiemannianMetric3 M,
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ g'.scalarCurvature := by
    intro g' x₀
    let c := chartAt E3 x₀
    let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      PartialDiffeomorph.mk c.symm.toPartialEquiv c.open_target c.open_source
        contMDiffOn_chart_symm contMDiffOn_chart
    have hform : ∀ y ∈ c.target,
        g'.scalarCurvature (c.symm y) = scalarCurvatureLocal (g'.coeff c.symm) y :=
      fun y hy => scalarCurvature_eq_scalarCurvatureLocal_coeff g' Φc y hy
    have hloc_sm : ContDiffOn ℝ ∞ (scalarCurvatureLocal (g'.coeff c.symm)) c.target :=
      (local_geometry_contDiffOn (g'.coeff c.symm) (fun _ => (0 : ℝ)) c.target c.open_target
        (fun i j => g'.smooth x₀ i j)
        (fun y hy => (coeff_chart_symm_posDef g' x₀ y hy).det_pos.ne') contDiffOn_const).2.2.1
    have hF : ContDiffOn ℝ ∞ (fun y => g'.scalarCurvature (c.symm y)) c.target :=
      hloc_sm.congr fun y hy => hform y hy
    have hFM : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => g'.scalarCurvature (c.symm y)) c.target :=
      contMDiffOn_iff_contDiffOn.mpr hF
    have hcomp : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
        ((fun y => g'.scalarCurvature (c.symm y)) ∘ c) c.source :=
      hFM.comp contMDiffOn_chart (fun x hx => c.map_source hx)
    have hR : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ g'.scalarCurvature c.source :=
      hcomp.congr fun x hx => by simp only [Function.comp, c.left_inv hx]
    exact hR.contMDiffAt (chart_source_mem_nhds E3 x₀)
  refine ⟨hsmooth h, ?_, ?_⟩
  · intro p hp
    have hcl : IsClosed (φ '' K) :=
      (hK.image_of_continuousOn (φ.contMDiffOn_toFun.continuousOn.mono hKφ)).isClosed
    let c := chartAt E3 p
    have hO : (φ '' K)ᶜ ∈ 𝓝 (c.symm (c p)) := by
      rw [c.left_inv (mem_chart_source E3 p)]
      exact hcl.isOpen_compl.mem_nhds hp
    have hN : c.symm ⁻¹' (φ '' K)ᶜ ∈ 𝓝 (c p) :=
      (c.continuousAt_symm (mem_chart_target E3 p)).preimage_mem_nhds hO
    have hev : h.coeff c.symm =ᶠ[𝓝 (c p)] g.coeff c.symm := by
      filter_upwards [hN] with z hz
      have hz' := hh (c.symm z) hz
      unfold RiemannianMetric3.coeff coeffMatrix
      rw [hz']
    show scalarCurvatureLocal (h.coeff c.symm) (c p) = scalarCurvatureLocal (g.coeff c.symm) (c p)
    exact hloc _ _ _ hev
  · intro y hy
    rw [scalarCurvature_eq_scalarCurvatureLocal_coeff h φ y hy]
    apply hloc
    filter_upwards [φ.open_source.mem_nhds hy] with z hz
    exact hcoeff z hz

theorem sqrt_det_perturbation (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (K : Set E3) (hK : IsCompact K)
    (hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) K)
    (hHc : ∀ i j : Fin 3, ContinuousOn (fun y => H y i j) K)
    (hGpos : ∀ y ∈ K, 0 < (G y).det) :
    ∃ t₁ C : ℝ, 0 < t₁ ∧ t₁ ≤ 1 ∧ 0 ≤ C ∧ ∀ t : ℝ, |t| ≤ t₁ →
      ContinuousOn (fun y => Real.sqrt (G y + t • H y).det) K ∧
      (∀ i j : Fin 3, ContinuousOn (fun y => (G y + t • H y)⁻¹ i j) K) ∧
      ∀ y ∈ K, 0 < (G y + t • H y).det ∧ Real.sqrt (G y + t • H y).det ≤ C ∧
        |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C * |t| ∧
        ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
            (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C * |t| :=
by
  classical
  
  have trip : ∀ x1 x2 x3 y1 y2 y3 L δ : ℝ, 0 ≤ L → |x1| ≤ L → |x2| ≤ L → |x3| ≤ L →
      |y1| ≤ L → |y2| ≤ L → |y3| ≤ L → |x1 - y1| ≤ δ → |x2 - y2| ≤ δ → |x3 - y3| ≤ δ →
      |x1 * x2 * x3 - y1 * y2 * y3| ≤ 3 * L ^ 2 * δ ∧ |x1 * x2 * x3| ≤ L ^ 3 := by
    intro x1 x2 x3 y1 y2 y3 L δ hL hx1 hx2 hx3 hy1 hy2 hy3 h1 h2 h3
    have hδ : 0 ≤ δ := (abs_nonneg _).trans h1
    have e : x1 * x2 * x3 - y1 * y2 * y3 =
        (x1 - y1) * x2 * x3 + y1 * (x2 - y2) * x3 + y1 * y2 * (x3 - y3) := by ring
    constructor
    · rw [e]
      refine (abs_add_three _ _ _).trans ?_
      simp only [abs_mul]
      have a1 : |x1 - y1| * |x2| * |x3| ≤ δ * L * L :=
        mul_le_mul (mul_le_mul h1 hx2 (abs_nonneg _) hδ) hx3 (abs_nonneg _) (mul_nonneg hδ hL)
      have a2 : |y1| * |x2 - y2| * |x3| ≤ L * δ * L :=
        mul_le_mul (mul_le_mul hy1 h2 (abs_nonneg _) hL) hx3 (abs_nonneg _) (mul_nonneg hL hδ)
      have a3 : |y1| * |y2| * |x3 - y3| ≤ L * L * δ :=
        mul_le_mul (mul_le_mul hy1 hy2 (abs_nonneg _) hL) h3 (abs_nonneg _) (mul_nonneg hL hL)
      nlinarith
    · simp only [abs_mul]
      calc |x1| * |x2| * |x3| ≤ L * L * L :=
            mul_le_mul (mul_le_mul hx1 hx2 (abs_nonneg _) hL) hx3 (abs_nonneg _) (mul_nonneg hL hL)
        _ = L ^ 3 := by ring
  
  have det3 : ∀ (X Y : Matrix (Fin 3) (Fin 3) ℝ) (L δ : ℝ), 0 ≤ L → (∀ i j, |X i j| ≤ L) →
      (∀ i j, |Y i j| ≤ L) → (∀ i j, |X i j - Y i j| ≤ δ) →
      |X.det - Y.det| ≤ 18 * L ^ 2 * δ ∧ |X.det| ≤ 6 * L ^ 3 := by
    intro X Y L δ hL hX hY hXY
    rw [Matrix.det_fin_three, Matrix.det_fin_three]
    obtain ⟨a1, b1⟩ := trip (X 0 0) (X 1 1) (X 2 2) (Y 0 0) (Y 1 1) (Y 2 2) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a2, b2⟩ := trip (X 0 0) (X 1 2) (X 2 1) (Y 0 0) (Y 1 2) (Y 2 1) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a3, b3⟩ := trip (X 0 1) (X 1 0) (X 2 2) (Y 0 1) (Y 1 0) (Y 2 2) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a4, b4⟩ := trip (X 0 1) (X 1 2) (X 2 0) (Y 0 1) (Y 1 2) (Y 2 0) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a5, b5⟩ := trip (X 0 2) (X 1 0) (X 2 1) (Y 0 2) (Y 1 0) (Y 2 1) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a6, b6⟩ := trip (X 0 2) (X 1 1) (X 2 0) (Y 0 2) (Y 1 1) (Y 2 0) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    rw [abs_le] at a1 a2 a3 a4 a5 a6 b1 b2 b3 b4 b5 b6
    constructor
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith
  
  have adj3 : ∀ (X Y : Matrix (Fin 3) (Fin 3) ℝ) (L δ : ℝ), 1 ≤ L → 0 ≤ δ →
      (∀ i j, |X i j| ≤ L) → (∀ i j, |Y i j| ≤ L) → (∀ i j, |X i j - Y i j| ≤ δ) →
      ∀ i j, |X.adjugate i j - Y.adjugate i j| ≤ 18 * L ^ 2 * δ ∧
        |X.adjugate i j| ≤ 6 * L ^ 3 := by
    intro X Y L δ hL hδ hX hY hXY i j
    rw [Matrix.adjugate_apply, Matrix.adjugate_apply]
    have hs : ∀ k : Fin 3, |(Pi.single i (1 : ℝ) : Fin 3 → ℝ) k| ≤ L := by
      intro k
      by_cases hk : k = i
      · subst hk; rw [Pi.single_eq_same, abs_one]; exact hL
      · rw [Pi.single_eq_of_ne hk, abs_zero]; linarith
    apply det3 _ _ L δ (by linarith)
    · intro a b; rw [Matrix.updateRow_apply]; split_ifs
      · exact hs b
      · exact hX a b
    · intro a b; rw [Matrix.updateRow_apply]; split_ifs
      · exact hs b
      · exact hY a b
    · intro a b; rw [Matrix.updateRow_apply, Matrix.updateRow_apply]; split_ifs
      · rw [sub_self, abs_zero]; exact hδ
      · exact hXY a b
  
  have sq1 : ∀ a b s : ℝ, 0 < s → s ^ 2 ≤ a → s ^ 2 ≤ b →
      |Real.sqrt a - Real.sqrt b| ≤ |a - b| / s := by
    intro a b s hs ha hb
    have hsa : s ≤ Real.sqrt a := by
      have := Real.sqrt_le_sqrt ha; rwa [Real.sqrt_sq hs.le] at this
    have hsb : s ≤ Real.sqrt b := by
      have := Real.sqrt_le_sqrt hb; rwa [Real.sqrt_sq hs.le] at this
    have ha0 : 0 ≤ a := le_trans (sq_nonneg s) ha
    have hb0 : 0 ≤ b := le_trans (sq_nonneg s) hb
    have h1 := Real.mul_self_sqrt ha0
    have h2 := Real.mul_self_sqrt hb0
    have e : a - b = (Real.sqrt a - Real.sqrt b) * (Real.sqrt a + Real.sqrt b) := by
      linear_combination (-1 : ℝ) * h1 + h2
    have hpos : 0 < Real.sqrt a + Real.sqrt b := by linarith [Real.sqrt_nonneg b]
    have hge : s ≤ Real.sqrt a + Real.sqrt b := by linarith [Real.sqrt_nonneg b]
    rw [le_div_iff₀ hs, e, abs_mul, abs_of_pos hpos]
    exact mul_le_mul_of_nonneg_left hge (abs_nonneg _)
  have sq2 : ∀ a b s P Q : ℝ, 0 < s → s ^ 2 ≤ a → s ^ 2 ≤ b →
      |P / Real.sqrt a - Q / Real.sqrt b| ≤ |P - Q| / s + |Q| * |a - b| / s ^ 3 := by
    intro a b s P Q hs ha hb
    have hsa : s ≤ Real.sqrt a := by
      have := Real.sqrt_le_sqrt ha; rwa [Real.sqrt_sq hs.le] at this
    have hsb : s ≤ Real.sqrt b := by
      have := Real.sqrt_le_sqrt hb; rwa [Real.sqrt_sq hs.le] at this
    have hra : 0 < Real.sqrt a := lt_of_lt_of_le hs hsa
    have hrb : 0 < Real.sqrt b := lt_of_lt_of_le hs hsb
    have hra' := hra.ne'
    have hrb' := hrb.ne'
    have e : P / Real.sqrt a - Q / Real.sqrt b = (P - Q) / Real.sqrt a +
        Q * (Real.sqrt b - Real.sqrt a) / (Real.sqrt a * Real.sqrt b) := by
      field_simp
      ring
    rw [e]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_div, abs_of_pos hra]
      exact div_le_div_of_nonneg_left (abs_nonneg _) hs hsa
    · rw [abs_div, abs_mul, abs_of_pos (mul_pos hra hrb), abs_sub_comm]
      have h1 := sq1 a b s hs ha hb
      have h2 : s ^ 2 ≤ Real.sqrt a * Real.sqrt b := by
        rw [sq]; exact mul_le_mul hsa hsb hs.le hra.le
      calc |Q| * |Real.sqrt a - Real.sqrt b| / (Real.sqrt a * Real.sqrt b)
          ≤ |Q| * |Real.sqrt a - Real.sqrt b| / s ^ 2 :=
            div_le_div_of_nonneg_left (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by positivity) h2
        _ ≤ |Q| * (|a - b| / s) / s ^ 2 :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left h1 (abs_nonneg _)) (by positivity)
        _ = |Q| * |a - b| / s ^ 3 := by
            rw [mul_div_assoc', div_div]; ring
  
  have invq : ∀ X : Matrix (Fin 3) (Fin 3) ℝ, 0 < X.det → ∀ i j : Fin 3,
      X⁻¹ i j * Real.sqrt X.det = X.adjugate i j / Real.sqrt X.det := by
    intro X hX i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    have hr : 0 < Real.sqrt X.det := Real.sqrt_pos.2 hX
    have hrr : Real.sqrt X.det * Real.sqrt X.det = X.det := Real.mul_self_sqrt hX.le
    obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = Real.sqrt X.det := ⟨_, rfl⟩
    rw [← hrdef] at hr hrr ⊢
    rw [← hrr]
    calc (r * r)⁻¹ * X.adjugate i j * r = X.adjugate i j * (r * r⁻¹) * r⁻¹ := by ring
      _ = X.adjugate i j / r := by rw [mul_inv_cancel₀ hr.ne', mul_one, div_eq_mul_inv]
  
  choose BG hBG using fun i j => hK.exists_bound_of_continuousOn (hGc i j)
  choose BH hBH using fun i j => hK.exists_bound_of_continuousOn (hHc i j)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = ∑ i : Fin 3, ∑ j : Fin 3, (|BG i j| + |BH i j|) := ⟨_, rfl⟩
  have hMij : ∀ i j : Fin 3, |BG i j| + |BH i j| ≤ M := by
    intro i j
    have h1 : |BG i j| + |BH i j| ≤ ∑ j' : Fin 3, (|BG i j'| + |BH i j'|) :=
      Finset.single_le_sum (f := fun j' => |BG i j'| + |BH i j'|)
        (fun _ _ => add_nonneg (abs_nonneg _) (abs_nonneg _)) (Finset.mem_univ j)
    have h2 : ∑ j' : Fin 3, (|BG i j'| + |BH i j'|) ≤ M := by
      rw [hMdef]
      exact Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, (|BG i' j'| + |BH i' j'|))
        (fun _ _ => Finset.sum_nonneg fun _ _ => add_nonneg (abs_nonneg _) (abs_nonneg _))
        (Finset.mem_univ i)
    linarith
  have hM : 0 ≤ M := le_trans (add_nonneg (abs_nonneg _) (abs_nonneg _)) (hMij 0 0)
  have hGb : ∀ y ∈ K, ∀ i j : Fin 3, |G y i j| ≤ M := by
    intro y hy i j
    have h := hBG i j y hy
    rw [Real.norm_eq_abs] at h
    linarith [le_abs_self (BG i j), hMij i j, abs_nonneg (BH i j)]
  have hHb : ∀ y ∈ K, ∀ i j : Fin 3, |H y i j| ≤ M := by
    intro y hy i j
    have h := hBH i j y hy
    rw [Real.norm_eq_abs] at h
    linarith [le_abs_self (BH i j), hMij i j, abs_nonneg (BG i j)]
  have hGcK : ContinuousOn G K := continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hGc i j
  have hdetc : ContinuousOn (fun y => (G y).det) K :=
    (continuous_id.matrix_det).comp_continuousOn hGcK
  obtain ⟨m, hm, hmK⟩ : ∃ m : ℝ, 0 < m ∧ ∀ y ∈ K, m ≤ (G y).det := by
    rcases K.eq_empty_or_nonempty with he | hne
    · exact ⟨1, one_pos, fun y hy => by simp [he] at hy⟩
    · obtain ⟨y0, hy0, hmin⟩ := hK.exists_isMinOn hne hdetc
      exact ⟨(G y0).det, hGpos y0 hy0, fun y hy => (isMinOn_iff.1 hmin) y hy⟩
  
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = 2 * M + 1 := ⟨_, rfl⟩
  have hL1 : 1 ≤ L := by rw [hLdef]; linarith
  have hL0 : 0 ≤ L := by linarith
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 18 * L ^ 2 * M := ⟨_, rfl⟩
  have hD : 0 ≤ D := by rw [hDdef]; positivity
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Real.sqrt (m / 2) := ⟨_, rfl⟩
  have hs : 0 < s := by rw [hsdef]; exact Real.sqrt_pos.2 (half_pos hm)
  have hs2 : s ^ 2 = m / 2 := by rw [hsdef]; exact Real.sq_sqrt (half_pos hm).le
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = 1 + 6 * L ^ 3 + 2 * (D / s) + 6 * L ^ 3 * (D / s ^ 3) :=
    ⟨_, rfl⟩
  have hDs : 0 ≤ D / s := div_nonneg hD hs.le
  have hDs3 : 0 ≤ 6 * L ^ 3 * (D / s ^ 3) := by positivity
  have hL3 : 0 ≤ 6 * L ^ 3 := by positivity
  have hC : 0 ≤ C := by rw [hCdef]; linarith
  have hD2 : 0 < 2 * (D + 1) := by linarith
  refine ⟨min 1 (m / (2 * (D + 1))), C, lt_min one_pos (div_pos hm hD2), min_le_left _ _, hC, ?_⟩
  intro t ht
  have ht1 : |t| ≤ 1 := ht.trans (min_le_left _ _)
  have ht2 : |t| ≤ m / (2 * (D + 1)) := ht.trans (min_le_right _ _)
  have htD : D * |t| ≤ m / 2 := by
    have h := (le_div_iff₀ hD2).1 ht2
    nlinarith [abs_nonneg t]
  have hat : 0 ≤ |t| := abs_nonneg t
  have hδ : 0 ≤ M * |t| := mul_nonneg hM hat
  have hAe : ∀ y i j, (G y + t • H y) i j = G y i j + t * H y i j := by
    intro y i j; simp [Matrix.add_apply, Matrix.smul_apply]
  have key : ∀ y ∈ K, 0 < (G y + t • H y).det ∧ Real.sqrt (G y + t • H y).det ≤ C ∧
      |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C * |t| ∧
      ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
          (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C * |t| := by
    intro y hy
    have hGL : ∀ i j, |G y i j| ≤ L := fun i j => by linarith [hGb y hy i j]
    have hAL : ∀ i j, |(G y + t • H y) i j| ≤ L := by
      intro i j
      rw [hAe]
      have h1 : |t * H y i j| ≤ 1 * M := by
        rw [abs_mul]; exact mul_le_mul ht1 (hHb y hy i j) (abs_nonneg _) zero_le_one
      have h2 := abs_add_le (G y i j) (t * H y i j)
      linarith [hGb y hy i j]
    have hAd : ∀ i j, |(G y + t • H y) i j - G y i j| ≤ M * |t| := by
      intro i j
      rw [hAe, add_sub_cancel_left, abs_mul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hHb y hy i j) hat
    obtain ⟨hdd, hdA⟩ := det3 _ _ L (M * |t|) hL0 hAL hGL hAd
    have hdd' : |(G y + t • H y).det - (G y).det| ≤ D * |t| := by
      rw [hDdef]; linarith
    have hb : m ≤ (G y).det := hmK y hy
    have hpos : m / 2 ≤ (G y + t • H y).det := by
      have := (abs_le.1 hdd').1
      linarith
    have hApos : 0 < (G y + t • H y).det := by linarith
    have hsa : s ^ 2 ≤ (G y + t • H y).det := by rw [hs2]; exact hpos
    have hsb : s ^ 2 ≤ (G y).det := by rw [hs2]; linarith
    refine ⟨hApos, ?_, ?_, ?_⟩
    · have h1 : (G y + t • H y).det ≤ (1 + 6 * L ^ 3) ^ 2 := by
        have := le_abs_self (G y + t • H y).det
        nlinarith
      have h2 := Real.sqrt_le_sqrt h1
      rw [Real.sqrt_sq (by linarith)] at h2
      rw [hCdef]; linarith
    · have h1 := sq1 _ _ s hs hsa hsb
      have h2 : |(G y + t • H y).det - (G y).det| / s ≤ D * |t| / s :=
        div_le_div_of_nonneg_right hdd' hs.le
      have h3 : D * |t| / s = (D / s) * |t| := by ring
      have h4 : D / s ≤ C := by rw [hCdef]; linarith
      have h5 : (D / s) * |t| ≤ C * |t| := mul_le_mul_of_nonneg_right h4 hat
      linarith
    · intro i j
      rw [invq _ hApos i j, invq _ (hGpos y hy) i j]
      have h1 := sq2 _ _ s ((G y + t • H y).adjugate i j) ((G y).adjugate i j) hs hsa hsb
      obtain ⟨hPQ, -⟩ := adj3 _ _ L (M * |t|) hL1 hδ hAL hGL hAd i j
      obtain ⟨-, hQ⟩ := adj3 (G y) (G y) L 0 hL1 le_rfl hGL hGL
        (fun a b => by rw [sub_self, abs_zero]) i j
      have hPQ' : |(G y + t • H y).adjugate i j - (G y).adjugate i j| ≤ D * |t| := by
        rw [hDdef]; linarith
      have h2 : |(G y + t • H y).adjugate i j - (G y).adjugate i j| / s ≤ D * |t| / s :=
        div_le_div_of_nonneg_right hPQ' hs.le
      have h3 : |(G y).adjugate i j| * |(G y + t • H y).det - (G y).det| / s ^ 3 ≤
          6 * L ^ 3 * (D * |t|) / s ^ 3 :=
        div_le_div_of_nonneg_right (mul_le_mul hQ hdd' (abs_nonneg _) hL3) (by positivity)
      have h4 : D * |t| / s + 6 * L ^ 3 * (D * |t|) / s ^ 3 =
          (D / s + 6 * L ^ 3 * (D / s ^ 3)) * |t| := by ring
      have h5 : D / s + 6 * L ^ 3 * (D / s ^ 3) ≤ C := by rw [hCdef]; linarith
      have h6 := mul_le_mul_of_nonneg_right h5 hat
      linarith
  
  have hAc : ∀ i j, ContinuousOn (fun y => (G y + t • H y) i j) K := by
    intro i j
    have : ContinuousOn (fun y => G y i j + t * H y i j) K :=
      (hGc i j).add (continuousOn_const.mul (hHc i j))
    exact this.congr (fun y _ => hAe y i j)
  have hAcK : ContinuousOn (fun y => G y + t • H y) K :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hAc i j
  have hdetAc : ContinuousOn (fun y => (G y + t • H y).det) K :=
    (continuous_id.matrix_det).comp_continuousOn hAcK
  have hadjc : ContinuousOn (fun y => (G y + t • H y).adjugate) K :=
    (continuous_id.matrix_adjugate).comp_continuousOn hAcK
  refine ⟨hdetAc.sqrt, ?_, key⟩
  intro i j
  have h1 : ContinuousOn (fun y => (G y + t • H y).adjugate i j) K :=
    continuousOn_pi.1 (continuousOn_pi.1 hadjc i) j
  have h2 := hdetAc.inv₀ (fun y hy => (key y hy).1.ne')
  exact (h2.mul h1).congr (fun y _ => by
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv'])

theorem param_taylor_compact (Φ : ℝ × E3 → ℝ) (W : Set (ℝ × E3)) (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ 2 Φ W) (K : Set E3) (hK : IsCompact K)
    (hKW : ∀ y ∈ K, ((0 : ℝ), y) ∈ W) :
    ∃ t₁ C : ℝ, 0 < t₁ ∧ 0 ≤ C ∧
      ContinuousOn (fun y => deriv (fun s => Φ (s, y)) 0) K ∧
      ∀ t : ℝ, |t| ≤ t₁ → ∀ y ∈ K, (t, y) ∈ W ∧
        |Φ (t, y) - Φ (0, y) - t * deriv (fun s => Φ (s, y)) 0| ≤ C * t ^ 2 :=
by
  classical
  
  have taylor2 : ∀ (f D D2 : ℝ → ℝ) (r M : ℝ),
      (∀ s ∈ Set.Icc (-r) r, HasDerivAt f (D s) s) →
      (∀ s ∈ Set.Icc (-r) r, HasDerivAt D (D2 s) s) →
      (∀ s ∈ Set.Icc (-r) r, |D2 s| ≤ M) →
      ∀ t : ℝ, |t| ≤ r → |f t - f 0 - t * D 0| ≤ M * t ^ 2 := by
    intro f D D2 r M hf hD hD2 t ht
    have hr : 0 ≤ r := (abs_nonneg t).trans ht
    have h0I : (0:ℝ) ∈ Set.Icc (-r) r := ⟨by linarith, hr⟩
    have htI : t ∈ Set.Icc (-r) r := abs_le.1 ht
    have hM : 0 ≤ M := (abs_nonneg _).trans (hD2 0 h0I)
    have h1 : ∀ s ∈ Set.Icc (-r) r, |D s - D 0| ≤ M * |s| := by
      intro s hs
      have := (convex_Icc (-r) r).norm_image_sub_le_of_norm_hasDerivWithin_le
        (f := D) (f' := D2) (C := M) (fun x hx => (hD x hx).hasDerivWithinAt)
        (fun x hx => by rw [Real.norm_eq_abs]; exact hD2 x hx) h0I hs
      rw [Real.norm_eq_abs, Real.norm_eq_abs, sub_zero] at this
      exact this
    have hJ : Set.uIcc 0 t ⊆ Set.Icc (-r) r := Set.uIcc_subset_Icc h0I htI
    have hg : ∀ s ∈ Set.uIcc 0 t, HasDerivWithinAt (fun s => f s - f 0 - s * D 0)
        (D s - D 0) (Set.uIcc 0 t) s := by
      intro s hs
      have h2 := ((hf s (hJ hs)).sub (hasDerivAt_const s (f 0))).sub
        ((hasDerivAt_id' s).mul_const (D 0))
      have h3 := h2.hasDerivWithinAt (s := Set.uIcc 0 t)
      convert h3 using 1
      ring
    have hgb : ∀ s ∈ Set.uIcc 0 t, ‖D s - D 0‖ ≤ M * |t| := by
      intro s hs
      rw [Real.norm_eq_abs]
      have h2 : |s| ≤ |t| := by
        have h3 := Set.abs_sub_left_of_mem_uIcc hs
        rw [sub_zero, sub_zero] at h3
        exact h3
      exact (h1 s (hJ hs)).trans (mul_le_mul_of_nonneg_left h2 hM)
    have hfin := (convex_uIcc (0:ℝ) t).norm_image_sub_le_of_norm_hasDerivWithin_le hg hgb
      Set.left_mem_uIcc Set.right_mem_uIcc
    simp only [Real.norm_eq_abs, sub_self, zero_mul, sub_zero] at hfin
    calc |f t - f 0 - t * D 0| ≤ M * |t| * |t| := hfin
      _ = M * t ^ 2 := by rw [mul_assoc, ← sq, sq_abs]
  
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (Ψ : ℝ × E3 → F)
      (s : ℝ) (y : E3), DifferentiableAt ℝ Ψ (s, y) →
      HasDerivAt (fun r : ℝ => Ψ (r, y)) (fderiv ℝ Ψ (s, y) ((1 : ℝ), (0 : E3))) s := by
    intro F _ _ Ψ s y h
    have hγ : HasDerivAt (fun r : ℝ => ((r, y) : ℝ × E3)) ((1 : ℝ), (0 : E3)) s :=
      (hasDerivAt_id' s).prodMk (hasDerivAt_const s y)
    exact h.hasFDerivAt.comp_hasDerivAt s hγ
  
  obtain ⟨u, v, hu, hv, h0u, hKv, huvW⟩ :=
    generalized_tube_lemma (isCompact_singleton (x := (0:ℝ))) hK hW (by
      rintro ⟨a, y⟩ ⟨ha, hy⟩
      obtain rfl : a = 0 := ha
      exact hKW y hy)
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hu 0 (h0u (Set.mem_singleton 0))
  have hslab : ∀ t : ℝ, |t| ≤ δ / 2 → ∀ y ∈ K, (t, y) ∈ W := by
    intro t ht y hy
    apply huvW
    refine ⟨hball ?_, hKv hy⟩
    rw [Metric.mem_ball, Real.dist_eq, sub_zero]
    linarith
  
  have hΦ1 : ContDiffOn ℝ 1 (fun p => fderiv ℝ Φ p) W := hΦ.fderiv_of_isOpen hW (by norm_num)
  have hΦ2c : ContinuousOn (fun p => fderiv ℝ (fun q => fderiv ℝ Φ q) p) W :=
    hΦ1.continuousOn_fderiv_of_isOpen hW le_rfl
  have hΦ1c : ContinuousOn (fun p => fderiv ℝ Φ p) W :=
    hΦ.continuousOn_fderiv_of_isOpen hW (by norm_num)
  have hΦd : ∀ p ∈ W, DifferentiableAt ℝ Φ p := fun p hp =>
    (hΦ.differentiableOn (by norm_num)).differentiableAt (hW.mem_nhds hp)
  have hΦ1d : ∀ p ∈ W, DifferentiableAt ℝ (fun q => fderiv ℝ Φ q) p := fun p hp =>
    (hΦ1.differentiableOn (by norm_num)).differentiableAt (hW.mem_nhds hp)
  
  have ht₁ : 0 < δ / 2 := half_pos hδ
  have hLW : Set.Icc (-(δ / 2)) (δ / 2) ×ˢ K ⊆ W := by
    rintro ⟨t, y⟩ ⟨ht, hy⟩
    exact hslab t (abs_le.2 ht) y hy
  have hc2 := (hΦ1.continuousOn_fderiv_of_isOpen hW le_rfl).mono hLW
  obtain ⟨M, hM'⟩ := isBounded_iff_forall_norm_le.1
    ((isCompact_Icc.prod hK).image_of_continuousOn hc2).isBounded
  have hM : ∀ p ∈ Set.Icc (-(δ / 2)) (δ / 2) ×ˢ K,
      ‖fderiv ℝ (fun q => fderiv ℝ Φ q) p‖ ≤ M := fun p hp => hM' _ ⟨p, hp, rfl⟩
  have he₁n : ‖((1 : ℝ), (0 : E3))‖ = 1 := by simp [Prod.norm_def]
  
  have hderiv0 : ∀ y ∈ K,
      deriv (fun s => Φ (s, y)) 0 = fderiv ℝ Φ (0, y) ((1 : ℝ), (0 : E3)) :=
    fun y hy => (slice Φ 0 y (hΦd _ (hKW y hy))).deriv
  refine ⟨δ / 2, max M 0, ht₁, le_max_right _ _, ?_, ?_⟩
  · have hc : ContinuousOn (fun y : E3 => fderiv ℝ Φ ((0:ℝ), y)) K :=
      hΦ1c.comp (continuous_const.prodMk continuous_id).continuousOn (fun y hy => hKW y hy)
    exact (hc.clm_apply continuousOn_const).congr hderiv0
  
  · intro t ht y hy
    refine ⟨hslab t ht y hy, ?_⟩
    rw [hderiv0 y hy]
    refine taylor2 (fun s => Φ (s, y)) (fun s => fderiv ℝ Φ (s, y) ((1 : ℝ), (0 : E3)))
      (fun s => fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3)) ((1 : ℝ), (0 : E3)))
      (δ / 2) (max M 0) ?_ ?_ ?_ t ht
    · intro s hs
      exact slice Φ s y (hΦd _ (hLW ⟨hs, hy⟩))
    · intro s hs
      have h1 := slice (fun q => fderiv ℝ Φ q) s y (hΦ1d _ (hLW ⟨hs, hy⟩))
      have h2 := h1.clm_apply (hasDerivAt_const s ((1 : ℝ), (0 : E3)))
      convert h2 using 1
      rw [map_zero, add_zero]
    · intro s hs
      have h1 := hM (s, y) ⟨hs, hy⟩
      calc |fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3)) ((1 : ℝ), (0 : E3))|
          = ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3))
              ((1 : ℝ), (0 : E3))‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y)‖ * ‖((1 : ℝ), (0 : E3))‖ *
              ‖((1 : ℝ), (0 : E3))‖ := ContinuousLinearMap.le_opNorm₂ _ _ _
        _ = ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y)‖ := by rw [he₁n]; ring
        _ ≤ M := h1
        _ ≤ max M 0 := le_max_left _ _

theorem perturbed_curvature_contDiffOn (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) :
    IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} ∧
    (∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2)
      {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0}) ∧
    ContDiffOn ℝ ∞ (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2)
      {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} :=
by
  classical
  
  have hdetgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) S := by
    intro S F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := S) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  
  have hinvgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      (∀ z ∈ S, (F z).det ≠ 0) →
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (F z)⁻¹ i j) S := by
    intro S F hF hdet i j
    have hadj : ContDiffOn ℝ ∞ (fun z => (F z).adjugate i j) S := by
      simp only [Matrix.adjugate_apply]
      refine hdetgen S (fun z => (F z).updateRow j (Pi.single i 1)) ?_
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hF a b
    have heq : (fun z => (F z)⁻¹ i j) =
        fun z => ((F z).det)⁻¹ * (F z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen S F hF).inv hdet).mul hadj
  
  have hD : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ v : ℝ × E3, ContDiffOn ℝ ∞ (fun p => fderiv ℝ F p v) O := by
    intro O hO F hF v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).2.clm_apply contDiffOn_const
  have hdiff : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ p ∈ O, DifferentiableAt ℝ F p := by
    intro O hO F hF p hp
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).1.differentiableAt (hO.mem_nhds hp)
  
  have hslice : ∀ (F : ℝ × E3 → ℝ) (p : ℝ × E3), DifferentiableAt ℝ F p → ∀ c : Fin 3,
      partialDeriv c (fun z => F (p.1, z)) p.2 = fderiv ℝ F p ((0 : ℝ), e c) := by
    intro F p hF c
    obtain ⟨s, y⟩ := p
    have hι := hasFDerivAt_prodMk_right (𝕜 := ℝ) s y
    have hF' : HasFDerivAt F (fderiv ℝ F (s, y)) (s, y) := hF.hasFDerivAt
    have hcomp := hF'.comp y hι
    unfold partialDeriv
    have hfun : (fun z => F ((s, y).1, z)) = F ∘ (fun z => (s, z)) := rfl
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply]
  
  have hVo : IsOpen {p : ℝ × E3 | p.2 ∈ U} := hU.preimage continuous_snd
  have hM : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2) a b)
      {p : ℝ × E3 | p.2 ∈ U} := by
    intro a b
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => G p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (hG a b).comp contDiff_snd.contDiffOn (fun p hp => hp)
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => p.1 * H p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (contDiff_fst.mul ((hH a b).comp contDiff_snd)).contDiffOn
    refine (h1.add h2).congr (fun p _ => ?_)
    simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  have hdetV : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2).det)
      {p : ℝ × E3 | p.2 ∈ U} :=
    hdetgen _ (fun p => G p.2 + p.1 • H p.2) hM
  have hWo : IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    have h := hdetV.continuousOn.isOpen_inter_preimage hVo (isOpen_compl_singleton (x := (0 : ℝ)))
    exact h
  set W := {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} with hWdef
  have hWmem : ∀ p ∈ W, p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0 := by
    intro p hp
    rw [hWdef] at hp
    exact hp
  have hWV : ∀ p ∈ W, p ∈ {p : ℝ × E3 | p.2 ∈ U} := fun p hp => (hWmem p hp).1
  have hinvW : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2)⁻¹ a b) W :=
    hinvgen W (fun p => G p.2 + p.1 • H p.2) (fun a b => (hM a b).mono hWV)
      (fun p hp => (hWmem p hp).2)
  have hparM : ∀ a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv c (fun z => (G z + p.1 • H z) a b) p.2) W := by
    intro a b c
    refine ((hD _ hVo _ (hM a b) ((0 : ℝ), e c)).mono hWV).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => (G q.2 + q.1 • H q.2) a b) p
      (hdiff _ hVo _ (hM a b) p (hWV p hp)) c
  
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2) W := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinvW k l).mul (((hparM j l i).add (hparM i l j)).sub (hparM i j l))))
  have hparΓ : ∀ d a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv d (christoffel (fun z => G z + p.1 • H z) a b c) p.2) W := by
    intro d a b c
    refine (hD _ hWo _ (hΓ a b c) ((0 : ℝ), e d)).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => christoffel (fun z => G z + q.1 • H z) a b c q.2) p
      (hdiff _ hWo _ (hΓ a b c) p hp) d
  
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => ricci (fun z => G z + p.1 • H z) j k p.2) W := by
    intro j k
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun q _ =>
        ((hΓ i i q).mul (hΓ q j k)).sub ((hΓ i j q).mul (hΓ q i k)))))
    exact (hparΓ i i j k).sub (hparΓ j i i k)
  
  have hScal : ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2) W := by
    unfold scalarCurvatureLocal
    exact ContDiffOn.sum (fun j _ => ContDiffOn.sum (fun k _ => (hinvW j k).mul (hRic j k)))
  exact ⟨hWo, hΓ, hScal⟩

theorem scalar_first_variation_hasDerivAt (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i) :
    ∀ y ∈ U, HasDerivAt (fun s : ℝ => scalarCurvatureLocal (fun z => G z + s • H z) y)
      (fvScalarVar G H y) 0 :=
by
  classical
  intro y hy
  
  
  
  have L1 : ∀ (A B : Matrix (Fin 3) (Fin 3) ℝ), A.det ≠ 0 → ∀ k l : Fin 3,
      HasDerivAt (fun s : ℝ => (A + s • B)⁻¹ k l)
        (-(∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ k a * B a b * A⁻¹ b l)) 0 := by
    intro A B hA
    have hdetd : Differentiable ℝ (fun s : ℝ => (A + s • B).det) := by
      simp only [Matrix.det_fin_three, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      fun_prop
    have hadjd : ∀ k l : Fin 3, Differentiable ℝ (fun s : ℝ => (A + s • B).adjugate k l) := by
      intro k l s
      fin_cases k <;> fin_cases l <;>
        simp [Matrix.adjugate_fin_three, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] <;>
        fun_prop
    have hA0 : (A + (0 : ℝ) • B).det ≠ 0 := by simpa using hA
    have hQd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun s : ℝ => (A + s • B)⁻¹ k l) 0 := by
      intro k l
      have heq : (fun s : ℝ => (A + s • B)⁻¹ k l) =
          fun s => ((A + s • B).det)⁻¹ * (A + s • B).adjugate k l := by
        funext s
        rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      rw [heq]
      exact ((hdetd 0).inv hA0).mul (hadjd k l 0)
    obtain ⟨D, hQ⟩ : ∃ D : Fin 3 → Fin 3 → ℝ,
        ∀ m l, HasDerivAt (fun s : ℝ => (A + s • B)⁻¹ m l) (D m l) 0 :=
      ⟨fun m l => deriv (fun s : ℝ => (A + s • B)⁻¹ m l) 0, fun m l => (hQd m l).hasDerivAt⟩
    have hev : ∀ᶠ s in 𝓝 (0 : ℝ), (A + s • B).det ≠ 0 :=
      (hdetd 0).continuousAt.eventually_ne hA0
    have hkey : ∀ k l : Fin 3, ∑ m : Fin 3, (B k m * A⁻¹ m l + A k m * D m l) = 0 := by
      intro k l
      have h1 : HasDerivAt (fun s : ℝ => ∑ m : Fin 3, (A k m + s * B k m) * (A + s • B)⁻¹ m l)
          (∑ m : Fin 3, (B k m * (A + (0 : ℝ) • B)⁻¹ m l + (A k m + 0 * B k m) * D m l)) 0 := by
        apply HasDerivAt.fun_sum
        intro m _
        exact ((hasDerivAt_mul_const (B k m)).const_add (A k m)).fun_mul (hQ m l)
      have h2 : HasDerivAt (fun s : ℝ => ∑ m : Fin 3, (A k m + s * B k m) * (A + s • B)⁻¹ m l)
          0 0 := by
        apply (hasDerivAt_const (0 : ℝ) ((1 : Matrix (Fin 3) (Fin 3) ℝ) k l)).congr_of_eventuallyEq
        filter_upwards [hev] with s hs
        have h4 := Matrix.mul_nonsing_inv (A + s • B) hs.isUnit
        have h3 := congrFun (congrFun h4 k) l
        rw [Matrix.mul_apply] at h3
        simpa [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] using h3
      have h5 := h1.unique h2
      simpa using h5
    have hmat : B * A⁻¹ + A * Matrix.of D = 0 := by
      ext k l
      simpa [Matrix.add_apply, Matrix.mul_apply, Finset.sum_add_distrib] using hkey k l
    have hDm : Matrix.of D = -(A⁻¹ * B * A⁻¹) := by
      have h1 : A * Matrix.of D = -(B * A⁻¹) := by
        rw [eq_neg_iff_add_eq_zero, add_comm]; exact hmat
      calc Matrix.of D = A⁻¹ * (A * Matrix.of D) :=
            (Matrix.nonsing_inv_mul_cancel_left A (Matrix.of D) hA.isUnit).symm
        _ = -(A⁻¹ * B * A⁻¹) := by rw [h1, Matrix.mul_neg, Matrix.mul_assoc]
    intro k l
    refine (hQ k l).congr_deriv ?_
    have h2 := congrFun (congrFun hDm k) l
    simp only [Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at h2
    rw [h2]
    simp only [Fin.sum_univ_three]
    ring
  
  
  
  have L2 : ∀ y' : E3, (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y') →
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => H z a b) y') → (G y').det ≠ 0 →
      ∀ k i j : Fin 3, HasDerivAt (fun s : ℝ => christoffel (fun z => G z + s • H z) k i j y')
        (fvChristoffelVar G H k i j y') 0 := by
    intro y' hGd hHd hdet k i j
    have hpd : ∀ (s : ℝ) (c a b : Fin 3), partialDeriv c (fun z => (G z + s • H z) a b) y' =
        partialDeriv c (fun z => G z a b) y' + s * partialDeriv c (fun z => H z a b) y' := by
      intro s c a b
      have hf : (fun z => (G z + s • H z) a b) = fun z => G z a b + s * H z a b := by
        funext z; simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      unfold partialDeriv
      have hsum : HasFDerivAt (fun z => G z a b + s * H z a b)
          (fderiv ℝ (fun z => G z a b) y' + s • fderiv ℝ (fun z => H z a b) y') y' :=
        (hGd a b).hasFDerivAt.add ((hHd a b).hasFDerivAt.const_mul s)
      rw [hf, hsum.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hform : (fun s : ℝ => christoffel (fun z => G z + s • H z) k i j y') =
        fun s => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y' + s • H y')⁻¹ k l *
          ((partialDeriv i (fun z => G z j l) y' + partialDeriv j (fun z => G z i l) y'
              - partialDeriv l (fun z => G z i j) y') +
           s * (partialDeriv i (fun z => H z j l) y' + partialDeriv j (fun z => H z i l) y'
              - partialDeriv l (fun z => H z i j) y')) := by
      funext s
      unfold christoffel
      simp only [hpd]
      congr 1
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring
    rw [hform]
    have hlin : ∀ (a b : ℝ), HasDerivAt (fun s : ℝ => a + s * b) b 0 :=
      fun a b => (hasDerivAt_mul_const b).const_add a
    refine ((HasDerivAt.fun_sum (u := Finset.univ) (fun l _ =>
        (L1 (G y') (H y') hdet k l).fun_mul (hlin _ _))).const_mul (1 / 2 : ℝ)).congr_deriv ?_
    simp only [zero_smul, add_zero, zero_mul]
    unfold fvChristoffelVar christoffel
    simp only [Fin.sum_univ_three]
    ring
  
  
  
  have hdetgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) S := by
    intro S F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := S) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hinvgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      (∀ z ∈ S, (F z).det ≠ 0) →
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (F z)⁻¹ i j) S := by
    intro S F hF hdet i j
    have hadj : ContDiffOn ℝ ∞ (fun z => (F z).adjugate i j) S := by
      simp only [Matrix.adjugate_apply]
      refine hdetgen S (fun z => (F z).updateRow j (Pi.single i 1)) ?_
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hF a b
    have heq : (fun z => (F z)⁻¹ i j) =
        fun z => ((F z).det)⁻¹ * (F z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen S F hF).inv hdet).mul hadj
  have hDv : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ v : ℝ × E3, ContDiffOn ℝ ∞ (fun p => fderiv ℝ F p v) O := by
    intro O hO F hF v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).2.clm_apply contDiffOn_const
  have hdiff : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ p ∈ O, DifferentiableAt ℝ F p := by
    intro O hO F hF p hp
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).1.differentiableAt (hO.mem_nhds hp)
  have hslice : ∀ (F : ℝ × E3 → ℝ) (p : ℝ × E3), DifferentiableAt ℝ F p → ∀ c : Fin 3,
      partialDeriv c (fun z => F (p.1, z)) p.2 = fderiv ℝ F p ((0 : ℝ), e c) := by
    intro F p hF c
    obtain ⟨s, y⟩ := p
    have hι := hasFDerivAt_prodMk_right (𝕜 := ℝ) s y
    have hF' : HasFDerivAt F (fderiv ℝ F (s, y)) (s, y) := hF.hasFDerivAt
    have hcomp := hF'.comp y hι
    unfold partialDeriv
    have hfun : (fun z => F ((s, y).1, z)) = F ∘ (fun z => (s, z)) := rfl
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply]
  have hVo : IsOpen {p : ℝ × E3 | p.2 ∈ U} := hU.preimage continuous_snd
  have hM : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2) a b)
      {p : ℝ × E3 | p.2 ∈ U} := by
    intro a b
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => G p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (hG a b).comp contDiff_snd.contDiffOn (fun p hp => hp)
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => p.1 * H p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (contDiff_fst.mul ((hH a b).comp contDiff_snd)).contDiffOn
    refine (h1.add h2).congr (fun p _ => ?_)
    simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  have hdetV : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2).det)
      {p : ℝ × E3 | p.2 ∈ U} :=
    hdetgen _ (fun p => G p.2 + p.1 • H p.2) hM
  have hWo : IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    have h := hdetV.continuousOn.isOpen_inter_preimage hVo (isOpen_compl_singleton (x := (0 : ℝ)))
    exact h
  set W := {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} with hWdef
  have hWmem : ∀ p ∈ W, p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0 := by
    intro p hp
    rw [hWdef] at hp
    exact hp
  have hWV : ∀ p ∈ W, p ∈ {p : ℝ × E3 | p.2 ∈ U} := fun p hp => (hWmem p hp).1
  have hinvW : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2)⁻¹ a b) W :=
    hinvgen W (fun p => G p.2 + p.1 • H p.2) (fun a b => (hM a b).mono hWV)
      (fun p hp => (hWmem p hp).2)
  have hparM : ∀ a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv c (fun z => (G z + p.1 • H z) a b) p.2) W := by
    intro a b c
    refine ((hDv _ hVo _ (hM a b) ((0 : ℝ), e c)).mono hWV).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => (G q.2 + q.1 • H q.2) a b) p
      (hdiff _ hVo _ (hM a b) p (hWV p hp)) c
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2) W := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinvW k l).mul (((hparM j l i).add (hparM i l j)).sub (hparM i j l))))
  
  
  
  have hdetU : ∀ y' ∈ U, (G y').det ≠ 0 := fun y' hy' => (hGpos y' hy').ne'
  have hGdU : ∀ y' ∈ U, ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y' :=
    fun y' hy' a b => ((hG a b).contDiffAt (hU.mem_nhds hy')).differentiableAt (by simp)
  have hHd : ∀ (y' : E3) (a b : Fin 3), DifferentiableAt ℝ (fun z => H z a b) y' :=
    fun y' a b => ((hH a b).differentiable (by simp)) y'
  have h0W : ∀ y' ∈ U, ((0 : ℝ), y') ∈ W := by
    intro y' hy'
    rw [hWdef]
    show y' ∈ U ∧ (G y' + (0 : ℝ) • H y').det ≠ 0
    exact ⟨hy', by simpa using hdetU y' hy'⟩
  
  
  
  have L3 : ∀ m k i j : Fin 3, HasDerivAt
      (fun s : ℝ => partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y)
      (partialDeriv m (fvChristoffelVar G H k i j) y) 0 := by
    intro m k i j
    set F : ℝ × E3 → ℝ := fun p => christoffel (fun z => G z + p.1 • H z) k i j p.2 with hFdef
    have hFs : ContDiffOn ℝ ∞ F W := hΓ k i j
    have hFat : ∀ p ∈ W, ContDiffAt ℝ ∞ F p := fun p hp => hFs.contDiffAt (hWo.mem_nhds hp)
    have hFd : ∀ p ∈ W, DifferentiableAt ℝ F p :=
      fun p hp => (hFat p hp).differentiableAt (by simp)
    have p0 : ((0 : ℝ), y) ∈ W := h0W y hy
    have hDF : ContDiffAt ℝ ∞ (fderiv ℝ F) ((0 : ℝ), y) :=
      (hFat _ p0).fderiv_right (m := ∞) le_rfl
    obtain ⟨D2, hD2h⟩ : ∃ D2, HasFDerivAt (fderiv ℝ F) D2 ((0 : ℝ), y) :=
      ⟨_, (hDF.differentiableAt (by simp)).hasFDerivAt⟩
    
    have hslice' : ∀ (s : ℝ) (y' : E3), (s, y') ∈ W →
        partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y' =
          fderiv ℝ F (s, y') ((0 : ℝ), e m) :=
      fun s y' hp => hslice F (s, y') (hFd _ hp) m
    
    have hc : HasDerivAt (fun s : ℝ => (s, y)) ((1 : ℝ), (0 : E3)) 0 :=
      (hasDerivAt_id' (0 : ℝ)).prodMk (hasDerivAt_const (0 : ℝ) y)
    have hL1 : HasDerivAt (fun s : ℝ => fderiv ℝ F (s, y)) (D2 ((1 : ℝ), (0 : E3))) 0 :=
      hD2h.comp_hasDerivAt (0 : ℝ) hc
    have hL2 : HasDerivAt (fun s : ℝ => fderiv ℝ F (s, y) ((0 : ℝ), e m))
        (D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m)) 0 :=
      (hL1.clm_apply (hasDerivAt_const (0 : ℝ) ((0 : ℝ), e m))).congr_deriv (by simp)
    have hopen : {s : ℝ | (s, y) ∈ W} ∈ 𝓝 (0 : ℝ) := by
      have hcont : Continuous (fun s : ℝ => (s, y)) := continuous_id.prodMk continuous_const
      exact hcont.continuousAt.preimage_mem_nhds (hWo.mem_nhds p0)
    have hLHS : HasDerivAt
        (fun s : ℝ => partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y)
        (D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m)) 0 := by
      refine hL2.congr_of_eventuallyEq ?_
      filter_upwards [hopen] with s hs
      exact hslice' s y hs
    
    have hfvEq : ∀ y' ∈ U,
        fvChristoffelVar G H k i j y' = fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3)) := by
      intro y' hy'
      have hcy : HasDerivAt (fun s : ℝ => (s, y')) ((1 : ℝ), (0 : E3)) 0 :=
        (hasDerivAt_id' (0 : ℝ)).prodMk (hasDerivAt_const (0 : ℝ) y')
      have hFh : HasFDerivAt F (fderiv ℝ F ((0 : ℝ), y')) ((0 : ℝ), y') :=
        (hFd _ (h0W y' hy')).hasFDerivAt
      have h1 : HasDerivAt (fun s : ℝ => F (s, y'))
          (fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3))) 0 :=
        HasFDerivAt.comp_hasDerivAt (l := F) (f := fun s : ℝ => (s, y')) (0 : ℝ) hFh hcy
      have h2 : HasDerivAt (fun s : ℝ => F (s, y')) (fvChristoffelVar G H k i j y') 0 :=
        L2 y' (hGdU y' hy') (hHd y') (hdetU y' hy') k i j
      exact h2.unique h1
    have hRHS : partialDeriv m (fvChristoffelVar G H k i j) y =
        D2 ((0 : ℝ), e m) ((1 : ℝ), (0 : E3)) := by
      have hc1 : HasFDerivAt (fun y' : E3 => fderiv ℝ F ((0 : ℝ), y'))
          (D2.comp (ContinuousLinearMap.inr ℝ ℝ E3)) y :=
        hD2h.comp y (hasFDerivAt_prodMk_right (0 : ℝ) y)
      have hc2 := hc1.clm_apply (hasFDerivAt_const ((1 : ℝ), (0 : E3)) y)
      have hev : fvChristoffelVar G H k i j =ᶠ[𝓝 y]
          (fun y' => fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3))) := by
        filter_upwards [hU.mem_nhds hy] with y' hy'
        exact hfvEq y' hy'
      unfold partialDeriv
      rw [hev.fderiv_eq, hc2.fderiv]
      simp
    
    have hsymm : IsSymmSndFDerivAt ℝ F ((0 : ℝ), y) :=
      (hFat _ p0).isSymmSndFDerivAt (by
        rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have hsw : D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m) = D2 ((0 : ℝ), e m) ((1 : ℝ), (0 : E3)) := by
      rw [← hD2h.fderiv]
      exact hsymm _ _
    rw [hRHS, ← hsw]
    exact hLHS
  
  
  
  have hdet : (G y).det ≠ 0 := hdetU y hy
  have L2y := L2 y (hGdU y hy) (hHd y) hdet
  have h0 : (fun z => G z + (0 : ℝ) • H z) = G := by funext z; simp
  have L5 : ∀ j k : Fin 3, HasDerivAt (fun s : ℝ => ricci (fun z => G z + s • H z) j k y)
      (fvRicciVar G H j k y) 0 := by
    intro j k
    unfold ricci
    have hd := (HasDerivAt.fun_sum (u := Finset.univ)
        (fun i _ => (L3 i i j k).sub (L3 j i i k))).add
      (HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => HasDerivAt.fun_sum (u := Finset.univ)
        (fun p _ => ((L2y i i p).fun_mul (L2y p j k)).sub ((L2y i j p).fun_mul (L2y p i k)))))
    refine hd.congr_deriv ?_
    rw [h0]
    unfold fvRicciVar
    simp only [Fin.sum_univ_three]
    ring
  unfold scalarCurvatureLocal
  have hd := HasDerivAt.fun_sum (u := Finset.univ) (fun j _ => HasDerivAt.fun_sum
    (u := Finset.univ) (fun k _ => (L1 (G y) (H y) hdet j k).fun_mul (L5 j k)))
  refine hd.congr_deriv ?_
  rw [h0]
  simp only [zero_smul, add_zero]
  unfold fvScalarVar
  simp only [Fin.sum_univ_three]
  ring

theorem first_variation_divergence_pointwise (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i)
    (hf : ContDiffOn ℝ ∞ f U) :
    ∀ y ∈ U, f y * fvScalarVar G H y * Real.sqrt (G y).det =
      -((∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det)
      + ∑ i : Fin 3, partialDeriv i (fvField G H f i) y :=
by
  intro y hy
  have hyU : U ∈ 𝓝 y := hU.mem_nhds hy
  have hdet : 0 < (G y).det := hGpos y hy
  have hdet0 : (G y).det ≠ 0 := hdet.ne'
  have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y :=
    fun a b => ((hG a b).contDiffAt hyU).differentiableAt (by simp)
  
  have hdetD : ∀ K : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => K z a b) y) →
      DifferentiableAt ℝ (fun z => (K z).det) y := by
    intro K hK
    have hfun : (fun z => (K z).det) = fun z =>
        K z 0 0 * K z 1 1 * K z 2 2 - K z 0 0 * K z 1 2 * K z 2 1
        - K z 0 1 * K z 1 0 * K z 2 2 + K z 0 1 * K z 1 2 * K z 2 0
        + K z 0 2 * K z 1 0 * K z 2 1 - K z 0 2 * K z 1 1 * K z 2 0 := by
      funext z; exact Matrix.det_fin_three (K z)
    rw [hfun]
    have h00 := hK 0 0
    have h01 := hK 0 1
    have h02 := hK 0 2
    have h10 := hK 1 0
    have h11 := hK 1 1
    have h12 := hK 1 2
    have h20 := hK 2 0
    have h21 := hK 2 1
    have h22 := hK 2 2
    fun_prop
  have hD : DifferentiableAt ℝ (fun z => (G z).det) y := hdetD G hGd
  have hPd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ k l) y := by
    intro k l
    have hfun : (fun z => (G z)⁻¹ k l) =
        fun z => ((G z).det)⁻¹ * ((G z).updateRow l (Pi.single k 1)).det := by
      funext z
      rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
        smul_eq_mul]
    rw [hfun]
    refine (hD.inv hdet0).mul (hdetD _ ?_)
    intro a b
    by_cases hal : a = l
    · subst hal
      simp only [Matrix.updateRow_self]
      exact differentiableAt_const _
    · simp only [Matrix.updateRow_ne hal]
      exact hGd a b
  
  have hev : ∀ᶠ z in 𝓝 y, (G z).det ≠ 0 := hD.continuousAt.eventually_ne hdet0
  have hinv : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ k a * partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l := by
    intro m
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G y a b * partialDeriv m (fun z => (G z)⁻¹ b l) y
        + ∑ b : Fin 3, partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun z => ∑ b : Fin 3, G z a b * (G z)⁻¹ b l)
