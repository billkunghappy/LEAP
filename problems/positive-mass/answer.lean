  have hν2500 : C_G * (2500 * Λ * ν) * K ≤ 1 / 4 * K := mul_le_mul_of_nonneg_right hνabs hK
  have hCΘ := mul_le_mul_of_nonneg_left harith hCG
  have hexp : C_G * ((2709 * ε + 2500 * Λ * ν) * K + (2702 + 2502 * Λ) * M / (ν ^ 4 * δ ^ 6))
