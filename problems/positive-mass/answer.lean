        refine ⟨fun y _ => contDiff_const.contDiffAt, HasCompactSupport.zero, ?_, ?_,
          ⟨0, fun y => by rw [h0 y, abs_zero]⟩⟩
        · rw [tsupport_zero]
          exact Set.empty_subset _
        · intro y
          simp
      have h0int : ∫ y in S, sepDensDiv G (0 : E3 → E3) y = 0 := by
        simp [h0]
      by_cases hc' : ((∀ y, y ∉ Kk → ContDiffAt ℝ ∞ Z y) ∧ HasCompactSupport Z ∧
            tsupport Z ⊆ U' ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1) ∧
            ∃ C : ℝ, ∀ y, |sepDensDiv G Z y| ≤ C) ∧
          0 ≤ ∫ y in S, sepDensDiv G Z y
      · exact ⟨Z, hc'.1, hc'.2, iSup_le fun _ => le_rfl⟩
      · refine ⟨0, h0adm, by rw [h0int], iSup_le fun hadm => ?_⟩
        have hneg : ∫ y in S, sepDensDiv G Z y ≤ 0 := by
          by_contra h
          exact hc' ⟨hadm, le_of_lt (not_le.1 h)⟩
        rw [ENNReal.ofReal_of_nonpos hneg]
        exact zero_le _
    have key : ∀ (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M),
        ((∀ k, IsOpen (W k) ∧ W k ⊆ U ∩ (chartAt E3 (pp k)).source) ∧
          Pairwise (fun k l => Disjoint (W k) (W l))) →
        ENNReal.ofReal Gain +
          ∑ k, hullPerG (g.coeff (chartAt E3 (pp k)).symm)
            (chartAt E3 (pp k) '' (F' ∩ (chartAt E3 (pp k)).source))
            (chartAt E3 (pp k) '' W k) (chartAt E3 (pp k) '' (K ∩ (chartAt E3 (pp k)).source)) ≤
          hullRiemPer g F U K := by
      intro m pp W hW
      unfold hullPerG
      refine sumsup m _ _ _ fun X => ?_
      beta_reduce
      choose Y hYadm hYnn hYle using fun k => trunc (g.coeff (chartAt E3 (pp k)).symm)
        (chartAt E3 (pp k) '' (F' ∩ (chartAt E3 (pp k)).source))
        (chartAt E3 (pp k) '' W k) (chartAt E3 (pp k) '' (K ∩ (chartAt E3 (pp k)).source)) (X k)
      have h8 := s18 m pp W hW.1 hW.2 Y hYadm
      calc _ ≤ ENNReal.ofReal Gain +
            ∑ k, ENNReal.ofReal (∫ y in chartAt E3 (pp k) '' (F' ∩ (chartAt E3 (pp k)).source),
              sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
            gcongr with k
            exact hYle k
        _ = ENNReal.ofReal (Gain +
            ∑ k, ∫ y in chartAt E3 (pp k) '' (F' ∩ (chartAt E3 (pp k)).source),
              sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
            rw [ENNReal.ofReal_add hGnn (Finset.sum_nonneg fun k _ => hYnn k),
              ENNReal.ofReal_sum_of_nonneg fun k _ => hYnn k]
        _ ≤ ENNReal.ofReal P := ENNReal.ofReal_le_ofReal (by linarith)
        _ = hullRiemPer g F U K := hPeq.symm
    have hle : hullRiemPer g F' U K ≤ hullRiemPer g F U K - ENNReal.ofReal Gain := by
      refine iSup_le fun m => iSup_le fun pp => iSup_le fun W => iSup_le fun hW => ?_
      exact ENNReal.le_sub_of_add_le_left ENNReal.ofReal_ne_top (key m pp W hW)
    have hGc : ENNReal.ofReal Gain ≤ hullRiemPer g F U K := by
      have h := key 0 (fun k => k.elim0) (fun k => k.elim0)
        ⟨fun k => k.elim0, fun k => k.elim0⟩
      simpa using h
    have h1 : hullRiemPer g F U K + ENNReal.ofReal Gain ≤ hullRiemPer g F U K + 0 := by
      calc _ ≤ (hullRiemPer g F U K - ENNReal.ofReal Gain) + ENNReal.ofReal Gain := by
            gcongr
            exact hmin.trans hle
        _ = hullRiemPer g F U K := tsub_add_cancel_of_le hGc
        _ = hullRiemPer g F U K + 0 := (add_zero _).symm
    have h2 := (ENNReal.add_le_add_iff_left hfin.ne).1 h1
    have h3 := ENNReal.ofReal_eq_zero.1 (le_antisymm h2 (zero_le _))
    linarith
  
  
  
  exact calVolSum_pos_null g Ωs q0 φ0 hφ0 D hDm (fun x hx => hφ01 x (hDO0 hx))
    (fun x => g.levelMeanCurv ρ x) hposD hint0 (by rw [hGain]; exact hG)

theorem cmss_in_graph_locally_eq [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (K S : Set M) (hKc : IsCompact K) (hKm : IsMinimalSurfaceSet g K) (p : M) (hpK : p ∈ K) (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ) (hr : 0 < r) (hδ : 0 < δ) (hu : ContDiff ℝ ∞ u) (hcyl : sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target) (hS : ∀ z ∈ sepCyl a (chartAt E3 p p) r δ, ((chartAt E3 p).symm z ∈ S ↔ z a = u (sepPlaneProj a z))) (hKS : ∃ V ∈ 𝓝 p, V ∩ K ⊆ S) : ∃ W ∈ 𝓝 p, W ∩ S ⊆ K :=
by
  classical
  obtain ⟨V, hV, hVK⟩ := hKS
  have hpsrc : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hctgt : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have hleft : (chartAt E3 p).symm (chartAt E3 p p) = p := (chartAt E3 p).left_inv hpsrc
  
  set Pclm : E3 →L[ℝ] E3 :=
    ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).smulRight (e a) with hPclm
  have hPeq' : ∀ y, Pclm y = y - (y a) • e a := by
    intro y; simp [hPclm]
  have hPeq : ∀ y, Pclm y = sepPlaneProj a y := fun y => hPeq' y
  have hPa : ∀ y, (Pclm y) a = 0 := by intro y; simp [hPeq']
  have hPe : Pclm (e a) = 0 := by simp [hPeq']
  have hPP : ∀ y, Pclm (Pclm y) = Pclm y := by
    intro y; rw [hPeq' y, map_sub, map_smul, hPe, smul_zero, sub_zero]; exact hPeq' y
  have hrec : ∀ y, Pclm y + (y a) • e a = y := by intro y; rw [hPeq']; abel
  have hPcont : Continuous (sepPlaneProj a) := by
    have h : (sepPlaneProj a) = (Pclm : E3 → E3) := funext fun y => (hPeq y).symm
    rw [h]; exact Pclm.continuous
  have hcylnhds : ∀ ρ δ' : ℝ, 0 < ρ → 0 < δ' →
      sepCyl a (chartAt E3 p p) ρ δ' ∈ 𝓝 (chartAt E3 p p) := by
    intro ρ δ' hρ hδ'
    have h1 : Continuous fun z : E3 => ‖sepPlaneProj a (z - chartAt E3 p p)‖ :=
      (hPcont.comp (continuous_id.sub continuous_const)).norm
    have h2 : Continuous fun z : E3 => |z a - chartAt E3 p p a| :=
      ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).continuous.sub continuous_const).abs
    have hopen : IsOpen (sepCyl a (chartAt E3 p p) ρ δ') :=
      (isOpen_lt h1 continuous_const).inter (isOpen_lt h2 continuous_const)
    refine hopen.mem_nhds ⟨?_, ?_⟩
    · simp [sepPlaneProj, hρ]
    · simp [hδ']
  
  
  have key : ∀ (F : E3 → ℝ) (c : E3) (ε : ℝ), 0 < ε →
      HasStrictFDerivAt F (fderiv ℝ F c) c → fderiv ℝ F c ≠ 0 → F c = 0 →
      (∀ z ∈ Metric.ball c ε, F z = 0 → z a = u (sepPlaneProj a z)) →
      ∃ ε₁ > 0, Metric.ball (Pclm c) ε₁ ⊆
        (fun z => Pclm z + F z • e a) '' Metric.ball c ε := by
    intro F c ε hε hstrict hF'ne hF0 hzer
    set F' := fderiv ℝ F c with hF'def
    have hBn : Metric.ball c ε ∈ 𝓝 c := Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hε)
    have hGc : c a = u (sepPlaneProj a c) := hzer c (Metric.mem_ball_self hε) hF0
    
    have hD : F' (e a) ≠ 0 := by
      intro hD0
      obtain ⟨w, hw⟩ : ∃ w, F' w ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        exact hF'ne (ContinuousLinearMap.ext hcon)
      set G' : E3 →L[ℝ] ℝ := (EuclideanSpace.proj a : E3 →L[ℝ] ℝ) -
        (fderiv ℝ u (Pclm c)).comp Pclm with hG'def
      have hGe : G' (e a) = 1 := by simp [hG'def, hPe]
      have hu' : HasStrictFDerivAt u (fderiv ℝ u (Pclm c)) (Pclm c) :=
        hu.contDiffAt.hasStrictFDerivAt (by simp)
      have hG : HasStrictFDerivAt (fun z : E3 => z a - u (sepPlaneProj a z)) G' c := by
        have h := ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).hasStrictFDerivAt (x := c)).sub
          (hu'.comp c Pclm.hasStrictFDerivAt)
        convert h using 1
      have hsurj : LinearMap.range ((F'.prod G' : E3 →L[ℝ] ℝ × ℝ) : E3 →ₗ[ℝ] ℝ × ℝ) = ⊤ := by
        rw [LinearMap.range_eq_top]
        rintro ⟨α, β⟩
        refine ⟨(α / F' w) • w + (β - (α / F' w) * G' w) • e a, ?_⟩
        simp only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.prod_apply, map_add, map_smul,
          hD0, hGe]
        refine Prod.ext ?_ ?_
        · simp only [Prod.fst_add, Prod.smul_fst, smul_eq_mul]
          rw [mul_zero, add_zero, div_mul_cancel₀ _ hw]
        · simp only [Prod.snd_add, Prod.smul_snd, smul_eq_mul]
          ring
      have hmap := (hstrict.prodMk hG).map_nhds_eq_of_surj hsurj
      have himg : (fun z : E3 => (F z, z a - u (sepPlaneProj a z))) '' Metric.ball c ε ∈
          𝓝 (F c, c a - u (sepPlaneProj a c)) := by
        rw [← hmap]; exact Filter.image_mem_map hBn
      obtain ⟨ρ, hρ, hball'⟩ := Metric.mem_nhds_iff.1 himg
      have hmem : ((0 : ℝ), ρ / 2) ∈ Metric.ball (F c, c a - u (sepPlaneProj a c)) ρ := by
        rw [hF0, hGc, sub_self, Metric.mem_ball, Prod.dist_eq]
        simp only [dist_self, Real.dist_eq, sub_zero]
        rw [abs_of_pos (by linarith : (0 : ℝ) < ρ / 2)]
        exact max_lt hρ (by linarith)
      obtain ⟨z, hz, hHz⟩ := hball' hmem
      simp only [Prod.mk.injEq] at hHz
      have h1 := hzer z hz hHz.1
      have h2 := hHz.2
      rw [h1, sub_self] at h2
      linarith
    
    have hΨ : HasStrictFDerivAt (fun z => Pclm z + F z • e a) (Pclm + F'.smulRight (e a)) c :=
      Pclm.hasStrictFDerivAt.add (hstrict.smul_const (e a))
    have hsurj2 :
        LinearMap.range (((Pclm + F'.smulRight (e a)) : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = ⊤ := by
      rw [LinearMap.range_eq_top]
      intro y
      refine ⟨Pclm y + ((y a - F' (Pclm y)) / F' (e a)) • e a, ?_⟩
      have hval : F' (Pclm y) + (y a - F' (Pclm y)) / F' (e a) * F' (e a) = y a := by
        field_simp; ring
      simp only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smulRight_apply, map_add, map_smul, hPP, hPe]
      rw [zero_add, smul_smul, add_assoc, ← add_smul, hval, hrec]
    have hmap2 := hΨ.map_nhds_eq_of_surj hsurj2
    have himg2 : (fun z => Pclm z + F z • e a) '' Metric.ball c ε ∈
        𝓝 (Pclm c + F c • e a) := by
      rw [← hmap2]; exact Filter.image_mem_map hBn
    rw [hF0, zero_smul, add_zero] at himg2
    obtain ⟨ε₁, hε₁, hball₁⟩ := Metric.mem_nhds_iff.1 himg2
    exact ⟨ε₁, hε₁, hball₁⟩
  
  set B₀ : Set E3 := sepCyl a (chartAt E3 p p) r δ ∩
    ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' interior V) with hB₀
  have hB₀n : B₀ ∈ 𝓝 (chartAt E3 p p) := by
    refine Filter.inter_mem (hcylnhds r δ hr hδ)
      (Filter.inter_mem ((chartAt E3 p).open_target.mem_nhds hctgt) ?_)
    have hI : interior V ∈ 𝓝 ((chartAt E3 p).symm (chartAt E3 p p)) := by
      rw [hleft]; exact isOpen_interior.mem_nhds (mem_interior_iff_mem_nhds.2 hV)
    exact ((chartAt E3 p).continuousAt_symm hctgt).preimage_mem_nhds hI
  have hKdef : K = ⋃ n ∈ Finset.range 1, (fun _ : ℕ => K) n := by simp
  obtain ⟨ε, k, f, hε, hk, hball, hfC, hf0, hfd, -, hwall⟩ :=
    contact_sheets g (fun _ => K) (fun _ => ⟨hKc, hKm⟩) 1 K hKdef p hpK B₀ hB₀n
  
  have hzer : ∀ z ∈ Metric.ball (chartAt E3 p p) ε, f ⟨0, hk⟩ z = 0 →
      z a = u (sepPlaneProj a z) := by
    intro z hz hFz
    have hzB₀ : z ∈ B₀ := (hball hz).1
    have hK' : (chartAt E3 p).symm z ∈ K := (hwall z hz).2 ⟨⟨0, hk⟩, hFz⟩
    have hVz : (chartAt E3 p).symm z ∈ V := interior_subset hzB₀.2.2
    exact (hS z hzB₀.1).1 (hVK ⟨hVz, hK'⟩)
  have hBn : Metric.ball (chartAt E3 p p) ε ∈ 𝓝 (chartAt E3 p p) :=
    Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hε)
  have hFc : ContDiffAt ℝ ∞ (f ⟨0, hk⟩) (chartAt E3 p p) := (hfC ⟨0, hk⟩).contDiffAt hBn
  have hstrict : HasStrictFDerivAt (f ⟨0, hk⟩) (fderiv ℝ (f ⟨0, hk⟩) (chartAt E3 p p))
      (chartAt E3 p p) := hFc.hasStrictFDerivAt (by simp)
  obtain ⟨ε₁, hε₁, hball₁⟩ := key (f ⟨0, hk⟩) (chartAt E3 p p) ε hε hstrict
    (hfd ⟨0, hk⟩ _ (Metric.mem_ball_self hε)) (hf0 ⟨0, hk⟩) hzer
  refine ⟨(chartAt E3 p).source ∩ (chartAt E3 p) ⁻¹' sepCyl a (chartAt E3 p p) (min r ε₁) δ,
    ?_, ?_⟩
  · exact Filter.inter_mem ((chartAt E3 p).open_source.mem_nhds hpsrc)
      (((chartAt E3 p).continuousAt hpsrc).preimage_mem_nhds
        (hcylnhds _ _ (lt_min hr hε₁) hδ))
  · rintro x ⟨⟨hxs, hxc⟩, hxS⟩
    have hxc' : ‖sepPlaneProj a (chartAt E3 p x - chartAt E3 p p)‖ < min r ε₁ ∧
        |chartAt E3 p x a - chartAt E3 p p a| < δ := hxc
    have hzcyl : chartAt E3 p x ∈ sepCyl a (chartAt E3 p p) r δ :=
      ⟨lt_of_lt_of_le hxc'.1 (min_le_left _ _), hxc'.2⟩
    have hzx : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    have hzg : (chartAt E3 p x) a = u (sepPlaneProj a (chartAt E3 p x)) :=
      (hS _ hzcyl).1 (by rw [hzx]; exact hxS)
    have hPz : Pclm (chartAt E3 p x) ∈ Metric.ball (Pclm (chartAt E3 p p)) ε₁ := by
      rw [Metric.mem_ball, dist_eq_norm, ← map_sub, hPeq]
      exact lt_of_lt_of_le hxc'.1 (min_le_right _ _)
    obtain ⟨w, hwB, hwz⟩ := hball₁ hPz
    have hwz2 : Pclm w + f ⟨0, hk⟩ w • e a = Pclm (chartAt E3 p x) := hwz
    have hFw : f ⟨0, hk⟩ w = 0 := by
      have h := congrArg (fun v : E3 => v a) hwz2
      simpa [hPa] using h
    have hPw : Pclm w = Pclm (chartAt E3 p x) := by
      rw [hFw, zero_smul, add_zero] at hwz2; exact hwz2
    have hwg := hzer w hwB hFw
    have h1 : w a = (chartAt E3 p x) a := by
      rw [hwg, hzg, ← hPeq w, ← hPeq (chartAt E3 p x), hPw]
    have hwz' : w = chartAt E3 p x := by
      calc w = Pclm w + (w a) • e a := (hrec w).symm
        _ = Pclm (chartAt E3 p x) + ((chartAt E3 p x) a) • e a := by rw [hPw, h1]
        _ = chartAt E3 p x := hrec _
    rw [hwz'] at hwB hFw
    have hK' := (hwall _ hwB).2 ⟨⟨0, hk⟩, hFw⟩
    rw [hzx] at hK'
    exact hK'

theorem minimal_surface_beyond_trapped_barrier [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Ω V F : Set M) (w σ : M → ℝ) (r₁ : ℝ) (hΩo : IsOpen Ω)
    (hΩc : IsConnected Ω) (hF : IsMinimalSurfaceSet g F) (hΩF : Disjoint Ω F) (hVo : IsOpen V)
    (hw : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w V) (hSc : IsCompact (V ∩ w ⁻¹' {0}))
    (hSF : Disjoint (V ∩ w ⁻¹' {0}) F)
    (hdw : ∀ x ∈ V, w x = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ V, w x = 0 → g.levelMeanCurv w x < 0) (hΩV : ∀ x ∈ Ω ∩ V, 0 < w x)
    (hfr : frontier Ω ⊆ (V ∩ w ⁻¹' {0}) ∪ F) (hmeet : (closure Ω ∩ (V ∩ w ⁻¹' {0})).Nonempty)
    (hσ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ) (hσc : ∀ s : ℝ, IsCompact {p : M | σ p ≤ s})
    (hσH : ∀ p : M, r₁ ≤ σ p → 0 < g.levelMeanCurv σ p)
    (hfrσ : frontier Ω ⊆ {p : M | σ p < r₁}) (hfar : (Ω ∩ {p : M | r₁ < σ p}).Nonempty) :
    ∃ S : Set M, IsCompact S ∧ IsMinimalSurfaceSet g S ∧ S ⊆ Ω ∧ S.Nonempty :=
by
  
  
  
  have himg : ∀ (X : Set M) (p : M), chartAt E3 p '' (X ∩ (chartAt E3 p).source) =
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' X := by
    intro X p
    rw [Set.inter_comm]
    exact (chartAt E3 p).image_source_inter_eq' X
  have hOpenMeas : ∀ A : Set M, IsOpen A → sepChartMeas A := by
    intro A hA p
    exact ((chartAt E3 p).isOpen_image_of_subset_source (hA.inter (chartAt E3 p).open_source)
      Set.inter_subset_right).measurableSet
  have hMeasInter : ∀ A B : Set M, sepChartMeas A → IsOpen B → sepChartMeas (A ∩ B) := by
    intro A B hA hB p
    have h1 := hA p
    have h2 := hOpenMeas B hB p
    rw [himg] at h1 h2 ⊢
    have heq : (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (A ∩ B) =
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' A) ∩
          ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' B) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage]
      tauto
    rw [heq]
    exact h1.inter h2
  have hMeasDiff : ∀ A B : Set M, sepChartMeas A → IsOpen B → sepChartMeas (A \ B) := by
    intro A B hA hB p
    have h1 := hA p
    have h2 := hOpenMeas B hB p
    rw [himg] at h1 h2 ⊢
    have heq : (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (A \ B) =
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' A) \
          ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' B) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff]
      tauto
    rw [heq]
    exact h1.diff h2
  have hNullMono : ∀ A B : Set M, sepChartNull B → A ⊆ B → sepChartNull A := by
    intro A B hB hAB p
    exact measure_mono_null (Set.image_subset _ (Set.inter_subset_inter_left _ hAB)) (hB p)
  have hN0 : ∀ N : Set M, IsOpen N → N.Nonempty → ¬ sepChartNull N := by
    rintro N hN ⟨x, hx⟩ hnull
    have h1 : IsOpen (chartAt E3 x '' (N ∩ (chartAt E3 x).source)) :=
      (chartAt E3 x).isOpen_image_of_subset_source (hN.inter (chartAt E3 x).open_source)
        Set.inter_subset_right
    have h2 : (chartAt E3 x '' (N ∩ (chartAt E3 x).source)).Nonempty :=
      ⟨chartAt E3 x x, x, ⟨hx, mem_chart_source E3 x⟩, rfl⟩
    have h3 := h1.measure_pos volume h2
    rw [hnull x] at h3
    exact lt_irrefl _ h3
  have hmonoG : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (A U K₁ K₂ : Set E3), K₁ ⊆ K₂ →
      hullPerG G A U K₁ ≤ hullPerG G A U K₂ := by
    intro G A U K₁ K₂ h
    unfold hullPerG
    refine iSup_mono fun X => iSup_le fun hX => ?_
    refine le_iSup_of_le (⟨fun y hy => hX.1 y (fun h' => hy (h h')), hX.2⟩ :
