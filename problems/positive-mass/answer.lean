    refine ⟨hint, ?_⟩
    have hFi : Integrable F := hF.continuous.integrable_of_hasCompactSupport hcs
    have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : E2 => (1 : ℝ)) (g := F) (v := e2 i)
      (by simp) (by simpa using hint) (by simpa using hFi) (differentiable_const _)
