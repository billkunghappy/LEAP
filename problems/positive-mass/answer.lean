      Real.rpow_add hL0, Real.rpow_one]
  rw [habs]
  calc 400 * (C * L ^ (-q)) ^ 2 * (2 * Real.pi) * (2 * L)
      = 1600 * Real.pi * C ^ 2 * (L * (L ^ (-q)) ^ 2) := by ring
    _ = _ := by rw [hpow]

theorem cyl_adm_flux_split (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L : ℝ) (hRL : R < L)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a) :
    P1 G L - P2 G L + 4 * Real.pi * L = (1 / 2 : ℝ) * cylFlux (admVec G) L :=
by
  
  have hP : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
    intro t s
    have hnorm : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ 2 = t ^ 2 + L ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq]
      simp [cylPt, Fin.sum_univ_three, EuclideanSpace.single_apply]
      nlinarith [Real.cos_sq_add_sin_sq s]
    have h0 := norm_nonneg (cylPt t (L * Real.cos s) (L * Real.sin s))
    by_contra hcon
    push_neg at hcon
    nlinarith [sq_nonneg t]
  
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hφ : Continuous (fun p : ℝ × ℝ => cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)) := by
    unfold cylPt
    fun_prop
  have hcont : ∀ k a b : Fin 3, Continuous (fun p : ℝ × ℝ =>
      partialDeriv k (fun z => G z a b) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))) := by
    intro k a b
    have h1 : ContinuousOn (fderiv ℝ (fun z => G z a b)) {x : E3 | R < ‖x‖} :=
      (hsmooth a b).continuousOn_fderiv_of_isOpen hU (by simp)
    have h2 : ContinuousOn (fun y => fderiv ℝ (fun z => G z a b) y (e k)) {x : E3 | R < ‖x‖} :=
      h1.clm_apply continuousOn_const
    exact h2.comp_continuous hφ (fun p => hP p.1 p.2)
  
  have iter : ∀ (F H : ℝ → ℝ → ℝ), Continuous (Function.uncurry F) →
      Continuous (Function.uncurry H) → ∀ a b c d : ℝ,
      (∫ t in a..b, ∫ s in c..d, F t s) - (∫ t in a..b, ∫ s in c..d, H t s)
        = ∫ t in a..b, ∫ s in c..d, (F t s - H t s) := by
    intro F H hF hH a b c d
    have hFt : ∀ t, Continuous (F t) := fun t => hF.uncurry_left t
    have hHt : ∀ t, Continuous (H t) := fun t => hH.uncurry_left t
    have hcF : Continuous (fun t => ∫ s in c..d, F t s) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hF c d
    have hcH : Continuous (fun t => ∫ s in c..d, H t s) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hH c d
    rw [← intervalIntegral.integral_sub (hcF.intervalIntegrable a b) (hcH.intervalIntegrable a b)]
    congr 1
    funext t
    rw [intervalIntegral.integral_sub ((hFt t).intervalIntegrable _ _)
      ((hHt t).intervalIntegrable _ _)]
  
  have h10 : (fun z => G z 1 0) = (fun z => G z 0 1) := funext fun z => hsymm z _ _
  have h20 : (fun z => G z 2 0) = (fun z => G z 0 2) := funext fun z => hsymm z _ _
  have h21 : (fun z => G z 2 1) = (fun z => G z 1 2) := funext fun z => hsymm z _ _
  have ident : ∀ (P : E3) (s : ℝ),
      (admVec G P 1 * Real.cos s + admVec G P 2 * Real.sin s) * L =
        (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) P - partialDeriv 1 (fun z => G z 0 0) P)
          + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) P
            - partialDeriv 2 (fun z => G z 0 0) P)) * L
        - (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) P - partialDeriv 2 (fun z => G z 1 2) P)
          + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) P
            - partialDeriv 1 (fun z => G z 2 1) P)) * L := by
    intro P s
    simp only [admVec, Fin.sum_univ_three, h10, h20, h21]
    ring
  
  have hcA : Continuous (Function.uncurry (fun t s : ℝ =>
      (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L)) := by
    show Continuous (fun p : ℝ × ℝ =>
      (Real.cos p.2 * (partialDeriv 0 (fun z => G z 1 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))
        + Real.sin p.2 * (partialDeriv 0 (fun z => G z 2 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))) * L)
    exact ((((Real.continuous_cos.comp continuous_snd).mul ((hcont 0 1 0).sub (hcont 1 0 0))).add
      ((Real.continuous_sin.comp continuous_snd).mul ((hcont 0 2 0).sub (hcont 2 0 0)))).mul
      continuous_const)
  have hcB : Continuous (Function.uncurry (fun t s : ℝ =>
      (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L)) := by
    show Continuous (fun p : ℝ × ℝ =>
      (Real.cos p.2 * (partialDeriv 1 (fun z => G z 2 2) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))
        + Real.sin p.2 * (partialDeriv 2 (fun z => G z 1 1) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))) * L)
    exact ((((Real.continuous_cos.comp continuous_snd).mul ((hcont 1 2 2).sub (hcont 2 1 2))).add
      ((Real.continuous_sin.comp continuous_snd).mul ((hcont 2 1 1).sub (hcont 1 2 1)))).mul
      continuous_const)
  have key := iter _ _ hcA hcB (-L) L 0 (2 * Real.pi)
  beta_reduce at key
  have hside : sideFlux (admVec G) L =
      ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
        ((Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L
        - (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L) := by
    unfold sideFlux
    congr 1
    funext t
    congr 1
    funext s
    exact ident _ s
  unfold P1 P2 cylFlux
  rw [hside]
  linarith

theorem coordChange_inverse_bounds (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hXY : CoordChange X Y q R₀ R₁ C) :
    ∃ R₃ K : ℝ, R₁ ≤ R₃ ∧ 0 ≤ K ∧ ∀ x : E3, R₃ < ‖x‖ →
      ‖x‖ / 2 ≤ ‖Y x‖ ∧ (1 / 2 : ℝ) ≤ (jacMat Y x).det ∧
      (∀ i a : Fin 3,
        |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ K * ‖x‖ ^ (-q)) ∧
      (∀ c i a : Fin 3,
        |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤ K * ‖x‖ ^ (-q - 1)) :=
by
  have hXY' := hXY
  unfold CoordChange at hXY'
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY'
  have hreg := coordChange_regularity (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
    (fun i j => contDiffOn_const) X Y q R₀ R₁ C hXY
  
  have sum3 : ∀ (f : Fin 3 → ℝ) (b : ℝ), (∀ i, |f i| ≤ b) → |∑ i, f i| ≤ 3 * b := by
    intro f b hf
    rw [Fin.sum_univ_three]
    have h0 := abs_le.mp (hf 0)
    have h1 := abs_le.mp (hf 1)
    have h2 := abs_le.mp (hf 2)
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have mulb : ∀ (u v A B : ℝ), |u| ≤ A → |v| ≤ B → |u * v| ≤ A * B := by
    intro u v A B hu hv
    rw [abs_mul]
    exact mul_le_mul hu hv (abs_nonneg _) (le_trans (abs_nonneg _) hu)
  
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = 1 + C := ⟨_, rfl⟩
  have hκ1 : 1 ≤ κ := by rw [hκ]; linarith
  have hκ0 : 0 < κ := by linarith
  have hCκ : 0 ≤ C * κ := mul_nonneg hC.le hκ0.le
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = 600 * C * κ + 1 := ⟨_, rfl⟩
  have hT0 : 0 < T := by rw [hT]; nlinarith
  have h600 : 600 * C * κ ≤ T := by rw [hT]; linarith
  refine ⟨max R₁ (T ^ (1 / q)), 72 * C * κ ^ 2, le_max_left _ _, by positivity, ?_⟩
  intro x hx
  have hxR1 : R₁ < ‖x‖ := lt_of_le_of_lt (le_max_left _ _) hx
  have hxT : T ^ (1 / q) < ‖x‖ := lt_of_le_of_lt (le_max_right _ _) hx
  have hTq0 : 0 < T ^ (1 / q) := Real.rpow_pos_of_pos hT0 _
  have hx0 : 0 < ‖x‖ := lt_trans hTq0 hxT
  have hu_le : ‖x‖ ^ (-q) ≤ T⁻¹ := by
    have h1 : ‖x‖ ^ (-q) ≤ (T ^ (1 / q)) ^ (-q) :=
      Real.rpow_le_rpow_of_nonpos hTq0 hxT.le (by linarith)
    have h2 : (T ^ (1 / q)) ^ (-q) = T⁻¹ := by
      rw [← Real.rpow_mul hT0.le]
      have : 1 / q * -q = -1 := by field_simp
      rw [this, Real.rpow_neg_one]
    rw [h2] at h1
    exact h1
  have hu0 : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hx0.le _
  have hv0 : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hx0.le _
  have huT : ‖x‖ ^ (-q) * T ≤ 1 := by
    calc ‖x‖ ^ (-q) * T ≤ T⁻¹ * T := mul_le_mul_of_nonneg_right hu_le hT0.le
      _ = 1 := inv_mul_cancel₀ hT0.ne'
  obtain ⟨hs0, hxs, hsq, hsq1⟩ := coordChange_norm_compare X Y q R₀ R₁ C hq0 hq1 hXY x hxR1
  rw [← hκ] at hxs hsq hsq1
  have hs0' : 0 < ‖Y x‖ := by linarith
  have hw0 : 0 ≤ ‖Y x‖ ^ (-q) := Real.rpow_nonneg hs0'.le _
  have hw10 : 0 ≤ ‖Y x‖ ^ (-q - 1) := Real.rpow_nonneg hs0'.le _
  
  have hε600 : C * ‖Y x‖ ^ (-q) ≤ 1 / 600 := by
    have h1 : C * ‖Y x‖ ^ (-q) ≤ C * (κ * ‖x‖ ^ (-q)) := mul_le_mul_of_nonneg_left hsq hC.le
    have h3 : 600 * C * κ * ‖x‖ ^ (-q) ≤ T * ‖x‖ ^ (-q) := mul_le_mul_of_nonneg_right h600 hu0
    linarith
  have hε0 : 0 ≤ C * ‖Y x‖ ^ (-q) := mul_nonneg hC.le hw0
  have hε : C * ‖Y x‖ ^ (-q) ≤ 1 / 6 := by linarith
  
  have hpart1 : ‖x‖ / 2 ≤ ‖Y x‖ := by
    have hXYx := (hinv x hxR1).2
    have hXb := (hbd (Y x) hs0).1
    have hpow : ‖Y x‖ ^ (1 - q) = ‖Y x‖ * ‖Y x‖ ^ (-q) := by
      rw [sub_eq_add_neg, Real.rpow_add hs0', Real.rpow_one]
    rw [hpow] at hXb
    have htri : ‖X (Y x)‖ ≤ ‖Y x‖ + ‖X (Y x) - Y x‖ := by
      simpa using norm_add_le (Y x) (X (Y x) - Y x)
    rw [hXYx] at htri hXb
    have hm : ‖Y x‖ * (C * ‖Y x‖ ^ (-q)) ≤ ‖Y x‖ * (1 / 600) :=
      mul_le_mul_of_nonneg_left hε600 hs0'.le
    nlinarith
  
  obtain ⟨hYd, hXd, hBd, hAd, -⟩ := hreg.2 x hxR1
  obtain ⟨hI, hII⟩ := inverse_jacobian_identities X Y {z : E3 | R₁ < ‖z‖}
    (isOpen_lt continuous_const continuous_norm) (fun z hz => (hinv z hz).2)
    (fun z hz => (hreg.2 z hz).1) (fun z hz => (hreg.2 z hz).2.1) x hxR1 hAd hBd
  obtain ⟨-, hA1, hA2⟩ := hbd (Y x) hs0
  
  have hBb : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 * 1 ∧
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)|
        ≤ 6 * (C * ‖Y x‖ ^ (-q)) * 1 := by
    intro i a
    refine lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => (fderiv ℝ Y x (e a)) k) (fun d => if d = a then (1 : ℝ) else 0)
      (C * ‖Y x‖ ^ (-q)) 1 hε ?_ ?_ ?_ i
    · intro d k
      exact hA1 k d
    · intro d
      show |(if d = a then (1 : ℝ) else 0)| ≤ 1
      split_ifs <;> simp
    · intro d
      have h := hI d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) * (fderiv ℝ Y x (e a)) k
          = (fderiv ℝ Y x (e a)) d := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ, h]
      ring
  have hB2 : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 :=
    fun i a => (hBb i a).1.trans (le_of_eq (mul_one _))
  have hBφ : ∀ i a : Fin 3,
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ 6 * (C * ‖Y x‖ ^ (-q)) :=
    fun i a => (hBb i a).2.trans (le_of_eq (mul_one _))
  
  have hMb : ∀ c i a : Fin 3, |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤
      2 * (36 * (C * ‖Y x‖ ^ (-q - 1))) := by
    intro c i a
    refine (lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x)
      (fun d => -∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k)
      (C * ‖Y x‖ ^ (-q)) (36 * (C * ‖Y x‖ ^ (-q - 1))) hε ?_ ?_ ?_ i).1
    · intro d k
      exact hA1 k d
    · intro d
      show |-∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k| ≤ 36 * (C * ‖Y x‖ ^ (-q - 1))
      rw [abs_neg]
      have h36 : (36 : ℝ) * (C * ‖Y x‖ ^ (-q - 1))
          = 3 * (3 * (2 * (C * ‖Y x‖ ^ (-q - 1))) * 2) := by ring
      rw [h36]
      apply sum3
      intro k
      apply mulb _ _ _ _ _ (hB2 k a)
      apply sum3
      intro l
      exact mulb _ _ _ _ (hB2 l c) (hA2 l k d)
    · intro d
      have h := hII c d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) *
            partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x
          = partialDeriv c (fun z => (fderiv ℝ Y z (e a)) d) x := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ]
      rw [Finset.sum_add_distrib] at h
      linarith
  
  have hdet : |(jacMat Y x).det - 1| ≤ 4 * (6 * (C * ‖Y x‖ ^ (-q))) :=
    det3_near_id_bound (jacMat Y x) (6 * (C * ‖Y x‖ ^ (-q))) (by linarith) (by linarith)
      (fun i j => by simp only [jacMat, Matrix.of_apply]; exact hBφ i j)
  refine ⟨hpart1, ?_, ?_, ?_⟩
  · have := (abs_le.mp hdet).1
    linarith
  · intro i a
    refine le_trans (hBφ i a) ?_
    have h1 := mul_le_mul_of_nonneg_left hsq (by linarith : (0 : ℝ) ≤ 6 * C)
    have h2 : 6 * C * κ ≤ 72 * C * κ ^ 2 := by nlinarith
    have h3 := mul_le_mul_of_nonneg_right h2 hu0
    nlinarith
  · intro c i a
    refine le_trans (hMb c i a) ?_
    have h1 := mul_le_mul_of_nonneg_left hsq1 (by linarith : (0 : ℝ) ≤ 72 * C)
    nlinarith

theorem adm_pullback_piola_decomp (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 0 < q) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) {y : E3 | 1 < ‖y‖})
    (hb : ∀ y : E3, R < ‖y‖ → ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖y‖ ^ (-q) ∧
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ C * ‖y‖ ^ (-q - 1))
    (Y : E3 → E3) (R₃ K : ℝ) (hK : 0 ≤ K)
    (hY : ContDiffOn ℝ ∞ Y {x : E3 | R₃ < ‖x‖})
    (hYb : ∀ x : E3, R₃ < ‖x‖ → ‖x‖ / 2 ≤ ‖Y x‖ ∧
      (∀ i a : Fin 3,
        |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ K * ‖x‖ ^ (-q)) ∧
      (∀ c i a : Fin 3,
        |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤ K * ‖x‖ ^ (-q - 1))) :
    ∃ R₄ K₄ : ℝ, R₃ ≤ R₄ ∧ 0 ≤ K₄ ∧ ∀ x : E3, R₄ < ‖x‖ → ∀ b : Fin 3,
      |admVec (pullbackMetric G Y) x b - piolaVec Y (admVec G) x b - jacCurlVec Y x b|
        ≤ K₄ * ‖x‖ ^ (-2 * q - 1) :=
by
  
  
  
  have t_sum3 : ∀ (f g : Fin 3 → ℝ) (A B : ℝ), (∀ i, |f i| ≤ A) → (∀ i, |g i| ≤ B) →
      |∑ i, f i * g i| ≤ 3 * (A * B) := by
    intro f g A B hf hg
    have hA : 0 ≤ A := (abs_nonneg _).trans (hf 0)
    have hfg : ∀ i, |f i * g i| ≤ A * B := fun i => by
      rw [abs_mul]; exact mul_le_mul (hf i) (hg i) (abs_nonneg _) hA
    calc |∑ i, f i * g i| ≤ ∑ i, |f i * g i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin 3, A * B := Finset.sum_le_sum (fun i _ => hfg i)
      _ = 3 * (A * B) := by simp
  have t_sum3' : ∀ (f : Fin 3 → ℝ) (B : ℝ), (∀ i, |f i| ≤ B) → |∑ i, f i| ≤ 3 * B := by
    intro f B hf
    calc |∑ i, f i| ≤ ∑ i, |f i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin 3, B := Finset.sum_le_sum (fun i _ => hf i)
      _ = 3 * B := by simp
  have t_lin1 : ∀ (d : Fin 3 → ℝ) (H J : Fin 3 → Fin 3 → ℝ) (b : Fin 3),
      ∑ i : Fin 3, ∑ j : Fin 3, d i * H i j * J j b - d b =
        ∑ i : Fin 3, d i * (∑ j : Fin 3, (H i j - if i = j then (1:ℝ) else 0) * J j b
          + (J i b - if i = b then (1:ℝ) else 0)) := by
    intro d H J b
    fin_cases b <;> simp [Fin.sum_univ_three] <;> ring
  have t_lin2 : ∀ (d : Fin 3 → ℝ) (H J : Fin 3 → Fin 3 → ℝ) (a : Fin 3),
      ∑ i : Fin 3, ∑ j : Fin 3, J i a * H i j * d j - d a =
        ∑ j : Fin 3, (∑ i : Fin 3, J i a * (H i j - if i = j then (1:ℝ) else 0)
          + (J j a - if j = a then (1:ℝ) else 0)) * d j := by
    intro d H J a
    fin_cases a <;> simp [Fin.sum_univ_three] <;> ring
