        have a1 := abs_le.1 (hm 1)
        have aF := abs_le.1 hFi
        rw [abs_le]
        constructor
        · linarith only [a0.1, a0.2, a1.1, a1.2, aF.1, aF.2]
        · linarith only [a0.1, a0.2, a1.1, a1.2, aF.1, aF.2]
      rw [Real.norm_eq_abs, hG ζ i, abs_div, abs_of_pos hκ, div_le_iff₀ hκ]
      refine le_trans hnum ?_
      rw [hκ_def, hδ, mul_div_assoc', le_div_iff₀ (mul_pos hd₀p hdα)]
      have := mul_le_mul_of_nonneg_right hB (mul_nonneg hN hρα.le)
      linarith only [this]
    have hAcont : Continuous (fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ) := by fun_prop
    have hAmaps : Set.MapsTo (fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ) (Metric.ball 0 T)
        (Metric.ball y R) := fun ζ hζ => hAS ζ hζ
    have hbC : ContinuousOn (fun ζ => a (x₀ + ρ • ζ)) (Metric.ball 0 T) :=
      haC.comp hAcont.continuousOn hAmaps
    have hFC' : ContinuousOn (fun ζ => F (x₀ + ρ • ζ)) (Metric.ball 0 T) :=
