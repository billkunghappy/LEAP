    rw [Metric.mem_thickening_iff]
    exact ⟨y, hy, by rw [dist_eq_norm]; linarith⟩
  
  obtain ⟨g, hgC, hgS, hgUp, hgEq⟩ := hpWH_kernel ρ s hρ0 (by linarith)
