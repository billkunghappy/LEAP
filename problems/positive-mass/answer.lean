      (∀ (y : E3) (i j : Fin 3),
      partialDeriv i (partialDeriv j (fun y => @inner ℝ E3 _ ν (y - x) -
           τ * ρ * (@inner ℝ E3 _ b (ρ⁻¹ • (y - x)) +
             ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - x)) i * (ρ⁻¹ • (y - x)) j + c))) y
        = -(τ * (M j i + M i j)) * ρ⁻¹) := by
    intro ν b x M ρ τ c hρ
    have hzi : ∀ (y : E3) (i : Fin 3), HasFDerivAt (fun y : E3 => (ρ⁻¹ • (y - x)) i)
        ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).comp (ρ⁻¹ • ContinuousLinearMap.id ℝ E3)) y :=
      fun y i => (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt.comp y
        (((hasFDerivAt_id y).sub_const x).const_smul ρ⁻¹)
    have h1 : ∀ (y : E3) (k : Fin 3),
      partialDeriv k (fun y => @inner ℝ E3 _ ν (y - x) -
           τ * ρ * (@inner ℝ E3 _ b (ρ⁻¹ • (y - x)) +
             ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - x)) i * (ρ⁻¹ • (y - x)) j + c)) y
        = ν k - τ * b k - τ * ∑ j, (M k j + M j k) * (ρ⁻¹ • (y - x)) j := by
      intro y k
      have hinν : HasFDerivAt (fun y : E3 => @inner ℝ E3 _ ν (y - x))
          ((innerSL ℝ ν).comp (ContinuousLinearMap.id ℝ E3)) y :=
        (innerSL ℝ ν).hasFDerivAt.comp y ((hasFDerivAt_id y).sub_const x)
      have hinb : HasFDerivAt (fun y : E3 => @inner ℝ E3 _ b (ρ⁻¹ • (y - x)))
          ((innerSL ℝ b).comp (ρ⁻¹ • ContinuousLinearMap.id ℝ E3)) y :=
        (innerSL ℝ b).hasFDerivAt.comp y (((hasFDerivAt_id y).sub_const x).const_smul ρ⁻¹)
      have hq := HasFDerivAt.fun_sum (u := Finset.univ) (fun i _ =>
        HasFDerivAt.fun_sum (u := Finset.univ)
          (fun j _ => ((hzi y i).const_mul (M i j)).fun_mul (hzi y j)))
      have hf := hinν.fun_sub (((hinb.fun_add hq).add_const c).const_mul (τ * ρ))
      unfold partialDeriv
      rw [hf.fderiv]
      simp [Fin.sum_univ_three, EuclideanSpace.single_apply, EuclideanSpace.inner_single_right]
      fin_cases k <;> simp <;> field_simp <;> ring
    refine ⟨h1, ?_⟩
    intro y i j
    have hfun : partialDeriv j (fun y => @inner ℝ E3 _ ν (y - x) -
           τ * ρ * (@inner ℝ E3 _ b (ρ⁻¹ • (y - x)) +
             ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - x)) i * (ρ⁻¹ • (y - x)) j + c)) =
        fun y => ν j - τ * b j - τ * ∑ l, (M j l + M l j) * (ρ⁻¹ • (y - x)) l :=
      funext fun y => h1 y j
    rw [hfun]
    have hg := ((HasFDerivAt.fun_sum (u := Finset.univ) fun l _ =>
      (hzi y l).const_mul (M j l + M l j)).const_mul τ).const_sub (ν j - τ * b j)
    unfold partialDeriv
    rw [hg.fderiv]
