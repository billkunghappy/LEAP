          simp [Set.indicator, hbnd]
        rw [hind]
        have hd := hdnn (β (c.symm y) / s)
        have h1 := mul_nonneg (mul_nonneg (mul_nonneg hP hd) hr0)
          (sub_nonneg.2 (le_abs_self
            (g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y))))
        have h2 : deriv Real.smoothTransition (β (c.symm y) / s) *
            (1 - Real.sqrt (g.gradInner u u (c.symm y)) / sternPhiM g u ε (c.symm y)) ≤
            Mη * (ε / (2 * g.gradInner u u (c.symm y))) :=
          mul_le_mul (hdle _) hr1 hr0 hMη0
        have h3 := mul_nonneg (mul_nonneg hP (abs_nonneg
            (g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y))))
          (sub_nonneg.2 h2)
        have e1 : ε / s * (Mη * (φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det *
            |g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y)| *
            (2 * g.gradInner u u (c.symm y))⁻¹)) * 1 =
            φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det * s⁻¹ *
              |g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y)| *
              (Mη * (ε / (2 * g.gradInner u u (c.symm y)))) := by
          ring
        rw [e1]
        nlinarith [h1, h3]
      · have hind : Set.indicator {z | 0 < β (c.symm z) ∧ β (c.symm z) < s}
            (fun _ => (1 : ℝ)) y = 0 := by
          simp [Set.indicator, hbnd]
        have hz : deriv Real.smoothTransition (β (c.symm y) / s) = 0 := by
          by_cases hb0 : β (c.symm y) ≤ 0
          · exact hd0 _ (div_nonpos_iff.mpr (Or.inr ⟨hb0, hs.le⟩))
          · have hbs : s ≤ β (c.symm y) := by
              by_contra hcon
              exact hbnd ⟨lt_of_not_ge hb0, lt_of_not_ge hcon⟩
            exact hd1 _ ((le_div_iff₀ hs).2 (by linarith))
        rw [hind, hz]
        simp
  choose Λ s₀ hs₀ hΛ0 hbd using hchart
  have hLsum : 0 ≤ ∑ j, Λ j := Finset.sum_nonneg (fun j _ => hΛ0 j)
  refine ⟨θ / (∑ j, Λ j + 1), by positivity, fun ε hε hεlt => ?_⟩
  obtain ⟨s₂, hs₂pos, hs₂le⟩ : ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ j, s₂ ≤ s₀ j := by
    refine ⟨(insert 1 (Finset.univ.image s₀)).min' (Finset.insert_nonempty _ _), ?_, fun j => ?_⟩
    · have hm := Finset.min'_mem (insert 1 (Finset.univ.image s₀)) (Finset.insert_nonempty _ _)
      rw [Finset.mem_insert, Finset.mem_image] at hm
      rcases hm with h | ⟨j, -, hj⟩
      · rw [h]; exact one_pos
      · rw [← hj]; exact hs₀ j
    · exact Finset.min'_le _ _
        (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ j)))
  refine ⟨s₂, hs₂pos, fun s hs hss => ?_⟩
  have hsum := Finset.sum_le_sum (s := Finset.univ)
    (fun j _ => hbd j ε s hε hs (lt_of_lt_of_le hss (hs₂le j)))
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_neg_distrib,
    ← Finset.mul_sum] at hsum
  have hεΛ : ε * (∑ j, Λ j + 1) < θ := (lt_div_iff₀ (by positivity)).1 hεlt
  simp only [sternBulk, sternCollar, sternBandJ, calVolSum]
  nlinarith [hsum, hεΛ, hε]

theorem sbgb_area_const_spec : 0 < sbgbAreaConst ∧ ∀ S : Set E2,
    ENNReal.ofReal sbgbAreaConst * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) S =
      MeasureTheory.volume S :=
by
  have hpi : (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
      MeasureTheory.Measure (Fin 2 → ℝ)) = MeasureTheory.volume := by
    have h := MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2)
    simpa using h
  have hmp := EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)
  have htrans : ∀ S : Set E2, (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
      MeasureTheory.Measure (Fin 2 → ℝ)) ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) =
        MeasureTheory.volume S := by
    intro S
    have himg : ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) =
        (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm '' S := rfl
    rw [hpi, himg, ← hmp.map_eq, MeasurableEquiv.map_apply,
      Set.preimage_image_eq _ (MeasurableEquiv.injective _)]
  have hlow : ∀ S : Set E2, MeasureTheory.volume S ≤
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := by
    intro S
    have h := (PiLp.lipschitzWith_ofLp 2 (fun _ : Fin 2 => ℝ)).hausdorffMeasure_image_le
      (d := 2) (by norm_num) S
    calc MeasureTheory.volume S
        = (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
            MeasureTheory.Measure (Fin 2 → ℝ)) ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) :=
          (htrans S).symm
      _ ≤ ((1 : NNReal) : ENNReal) ^ (2 : ℝ) *
            (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := h
      _ = (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := by
          simp
  obtain ⟨K, hK⟩ : ∃ K : NNReal, AntilipschitzWith K (WithLp.ofLp : E2 → (Fin 2 → ℝ)) :=
    ⟨_, PiLp.antilipschitzWith_ofLp 2 (fun _ : Fin 2 => ℝ)⟩
  have hup : ∀ S : Set E2,
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S ≤
        (K : ENNReal) ^ (2 : ℝ) * MeasureTheory.volume S := by
    intro S
    have h := hK.le_hausdorffMeasure_image (d := 2) (by norm_num) S
    rw [htrans] at h
    exact h
  have hKfin : (K : ENNReal) ^ (2 : ℝ) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.coe_ne_top
  haveI : MeasureTheory.IsFiniteMeasureOnCompacts
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) :=
    ⟨fun Kc hKc => lt_of_le_of_lt (hup Kc)
      (ENNReal.mul_lt_top hKfin.lt_top hKc.measure_lt_top)⟩
  obtain ⟨l, hl⟩ : ∃ l : NNReal,
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) =
        l • MeasureTheory.volume :=
    ⟨_, MeasureTheory.Measure.isAddLeftInvariant_eq_smul _ _⟩
  have hμS : ∀ S : Set E2,
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S =
        (l : ENNReal) * MeasureTheory.volume S := by
    intro S
    rw [hl, MeasureTheory.Measure.coe_nnreal_smul_apply]
  have hB : (MeasureTheory.volume : MeasureTheory.Measure E2) (Metric.ball 0 1) =
      ENNReal.ofReal Real.pi := by
    rw [EuclideanSpace.volume_ball_fin_two]
    simp
  have hl0 : l ≠ 0 := by
    intro h0
    have h1 := hlow (Metric.ball 0 1)
    rw [hμS, h0, hB, ENNReal.coe_zero, zero_mul] at h1
    exact absurd (ENNReal.ofReal_pos.mpr Real.pi_pos) (not_lt.mpr h1)
  have hlpos : (0 : ℝ) < l :=
    lt_of_le_of_ne l.2 (Ne.symm (NNReal.coe_ne_zero.mpr hl0))
  have hconst : sbgbAreaConst = ((l : ℝ))⁻¹ := by
    unfold sbgbAreaConst
    rw [hμS, hB, ENNReal.toReal_mul, ENNReal.coe_toReal,
      ENNReal.toReal_ofReal Real.pi_pos.le, div_mul_cancel_right₀ Real.pi_ne_zero]
  refine ⟨by rw [hconst]; exact inv_pos.mpr hlpos, fun S => ?_⟩
  rw [hconst, hμS, ← mul_assoc, ENNReal.ofReal_inv_of_pos hlpos, ENNReal.ofReal_coe_nnreal,
    ENNReal.inv_mul_cancel (ENNReal.coe_ne_zero.mpr hl0) ENNReal.coe_ne_top, one_mul]

theorem linear_graph_hausdorff (hspec : 0 < sbgbAreaConst ∧ ∀ S : Set E2,
      ENNReal.ofReal sbgbAreaConst * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) S =
        MeasureTheory.volume S)
    (a : Fin 3) (p : Fin 2 → ℝ) (S : Set (Fin 2 → ℝ)) (hS : MeasurableSet S) :
    MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
        ((fun x : Fin 2 → ℝ => smthLift a x (∑ k : Fin 2, p k * x k)) '' S) =
      ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, p k ^ 2) / sbgbAreaConst) *
        MeasureTheory.volume S :=
by
  obtain ⟨hc, hsp⟩ := hspec
  have hQ : ∑ k : Fin 2, p k ^ 2 = p 0 ^ 2 + p 1 ^ 2 := Fin.sum_univ_two _
  set s : ℝ := Real.sqrt (1 + ∑ k : Fin 2, p k ^ 2) with hs_def
  have hs0 : 0 < s := Real.sqrt_pos.2 (by positivity)
  have hs2 : s ^ 2 = 1 + (p 0 ^ 2 + p 1 ^ 2) := by
    rw [hs_def, Real.sq_sqrt (by positivity), hQ]
  have h1s : (1 + s) ≠ 0 := by positivity
  obtain ⟨κ, hB⟩ : ∃ κ : ℝ, κ * (1 + s) = 1 := ⟨(1 + s)⁻¹, inv_mul_cancel₀ h1s⟩
  obtain ⟨μ, hA⟩ : ∃ μ : ℝ, μ * (s * (1 + s)) = 1 :=
    ⟨(s * (1 + s))⁻¹, inv_mul_cancel₀ (by positivity)⟩
  
  set ρ : (Fin 2 → ℝ) →ₗ[ℝ] (Fin 2 → ℝ) :=
    Matrix.toLin' !![1 + κ * p 0 ^ 2, κ * p 0 * p 1; κ * p 0 * p 1, 1 + κ * p 1 ^ 2]
    with hρ_def
  have hρ : ∀ x : Fin 2 → ℝ, ∀ i : Fin 2,
      ρ x i = x i + κ * (p 0 * x 0 + p 1 * x 1) * p i := by
    intro x i
    fin_cases i <;> simp [hρ_def, Matrix.mulVec, dotProduct, Fin.sum_univ_two] <;> ring
  have hdet : LinearMap.det ρ = s := by
    rw [hρ_def, LinearMap.det_toLin', Matrix.det_fin_two_of]
    linear_combination (-κ) * hs2 + (s - 1) * hB
  
  let ρ' : (Fin 2 → ℝ) → (Fin 2 → ℝ) := fun w i => w i - μ * (p 0 * w 0 + p 1 * w 1) * p i
  have hρ'ρ : ∀ x, ρ' (ρ x) = x := by
    intro x
    funext i
    simp only [ρ', hρ]
    linear_combination (p 0 * x 0 + p 1 * x 1) * p i * (-κ * hA + μ * hB + μ * κ * hs2)
  
  let Ψ : E2 → E3 := fun z =>
    smthLift a (ρ' (WithLp.ofLp z)) (∑ k : Fin 2, p k * ρ' (WithLp.ofLp z) k)
  have hfac : ∀ x, Ψ (WithLp.toLp 2 (ρ x)) = smthLift a x (∑ k : Fin 2, p k * x k) := by
    intro x
    simp only [Ψ, hρ'ρ]
  have hcoord : ∀ (y : Fin 2 → ℝ) (t : ℝ) (i : Fin 3),
      (smthLift a y t) i = (Fin.insertNth a t y : Fin 3 → ℝ) i := fun _ _ _ => rfl
  have hnorm : ∀ (y y' : Fin 2 → ℝ) (t t' : ℝ), dist (smthLift a y t) (smthLift a y' t') =
      Real.sqrt ((t - t') ^ 2 + (y 0 - y' 0) ^ 2 + (y 1 - y' 1) ^ 2) := by
    intro y y' t t'
    rw [EuclideanSpace.dist_eq, Fin.sum_univ_succAbove _ a, Fin.sum_univ_two]
    simp only [hcoord, Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove, Real.dist_eq,
      sq_abs]
    congr 1
    ring
  have hΨ : Isometry Ψ := by
    refine Isometry.of_dist_eq (fun z z' => ?_)
    rw [EuclideanSpace.dist_eq z z']
    simp only [Ψ]
    rw [hnorm]
    congr 1
    simp only [Fin.sum_univ_two, Real.dist_eq, sq_abs, ρ']
    linear_combination (p 0 * (z 0 - z' 0) + p 1 * (z 1 - z' 1)) ^ 2 *
      (-(1 - μ * s ^ 2 + μ * s) * hA + (2 * μ - μ ^ 2 * (p 0 ^ 2 + p 1 ^ 2) - μ ^ 2 * s ^ 2) * hs2)
  
  have himg : (fun x : Fin 2 → ℝ => smthLift a x (∑ k : Fin 2, p k * x k)) '' S =
      Ψ '' ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)) '' (ρ '' S)) := by
    rw [Set.image_image, Set.image_image]
    refine Set.image_congr (fun x _ => ?_)
    exact (hfac x).symm
  have hvolT : MeasureTheory.volume ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)) '' (ρ '' S)) =
      MeasureTheory.volume (ρ '' S) := by
    rw [MeasurableEquiv.image_eq_preimage_symm]
    exact (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).measure_preimage_equiv _
  have hvolρ : MeasureTheory.volume (ρ '' S) = ENNReal.ofReal s * MeasureTheory.volume S := by
    rw [MeasureTheory.Measure.addHaar_image_linearMap, hdet, abs_of_pos hs0]
  have hne : ENNReal.ofReal sbgbAreaConst ≠ 0 := (ENNReal.ofReal_pos.2 hc).ne'
  have htop : ENNReal.ofReal sbgbAreaConst ≠ ⊤ := ENNReal.ofReal_ne_top
  have hμT : ∀ T : Set E2, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) T =
      (ENNReal.ofReal sbgbAreaConst)⁻¹ * MeasureTheory.volume T := by
    intro T
    rw [← hsp T, ← mul_assoc, ENNReal.inv_mul_cancel hne htop, one_mul]
  rw [himg, hΨ.hausdorffMeasure_image (Or.inl (by norm_num)), hμT, hvolT, hvolρ,
    ENNReal.ofReal_div_of_pos hc, div_eq_mul_inv]
  ring

theorem graph_area_formula (hlin : ∀ (a : Fin 3) (p : Fin 2 → ℝ) (S : Set (Fin 2 → ℝ)), MeasurableSet S →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
          ((fun x : Fin 2 → ℝ => smthLift a x (∑ k : Fin 2, p k * x k)) '' S) =
        ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, p k ^ 2) / sbgbAreaConst) *
          MeasureTheory.volume S)
    (a : Fin 3) (W : Set (Fin 2 → ℝ)) (hW : IsOpen W) (v : (Fin 2 → ℝ) → ℝ)
    (hv : ContDiffOn ℝ 1 v W) (S : Set (Fin 2 → ℝ)) (hS : MeasurableSet S) (hSW : S ⊆ W)
    (gf : E3 → ℝ) (hg : Measurable gf) :
    (MeasureTheory.IntegrableOn gf ((fun x => smthLift a x (v x)) '' S)
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ↔
      MeasureTheory.IntegrableOn (fun x => Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) /
        sbgbAreaConst * gf (smthLift a x (v x))) S) ∧
    ∫ z in (fun x => smthLift a x (v x)) '' S, gf z
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
      ∫ x in S, Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst *
        gf (smthLift a x (v x)) :=
by
  have hc : 0 ≤ sbgbAreaConst := div_nonneg Real.pi_pos.le ENNReal.toReal_nonneg
  have hcoord : ∀ (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2), (smthLift a x t) (a.succAbove k) = x k := by
    intro x t k
    show Fin.insertNth (α := fun _ => ℝ) a t x (a.succAbove k) = x k
    exact Fin.insertNth_apply_succAbove (α := fun _ => ℝ) a t x k
  have hcoorda : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    show Fin.insertNth (α := fun _ => ℝ) a t x a = t
    exact Fin.insertNth_apply_same (α := fun _ => ℝ) a t x
  have hLc : Continuous (fun p : (Fin 2 → ℝ) × ℝ => smthLift a p.1 p.2) :=
    (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
      (Continuous.finInsertNth a continuous_snd continuous_fst)
  
  
  
  have hsq : ∀ (p q : Fin 2 → ℝ) (η : ℝ), 0 ≤ η → (∀ k : Fin 2, |q k - p k| ≤ η) →
      Real.sqrt (1 + ∑ k : Fin 2, q k ^ 2) ≤ (1 + 2 * η) * Real.sqrt (1 + ∑ k : Fin 2, p k ^ 2) := by
    intro p q η hη hpq
    rw [Fin.sum_univ_two, Fin.sum_univ_two]
    have key : ∀ k : Fin 2, q k ^ 2 ≤ p k ^ 2 + η * (1 + p k ^ 2) + η ^ 2 := by
      intro k
      have hk := hpq k
      have a0 : (q k - p k) ^ 2 ≤ η ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hk 2
      have b0 : 2 * p k * (q k - p k) ≤ 2 * |p k| * η := by
        calc 2 * p k * (q k - p k) ≤ |2 * p k * (q k - p k)| := le_abs_self _
          _ = 2 * |p k| * |q k - p k| := by rw [abs_mul, abs_mul, abs_two]
          _ ≤ 2 * |p k| * η := by gcongr
      have c0 : 2 * |p k| * η ≤ η * (1 + p k ^ 2) := by
        nlinarith [mul_nonneg hη (sq_nonneg (|p k| - 1)), sq_abs (p k)]
      nlinarith
    have hsq' : 1 + (q 0 ^ 2 + q 1 ^ 2) ≤ (1 + 2 * η) ^ 2 * (1 + (p 0 ^ 2 + p 1 ^ 2)) := by
      have k0 := key 0
      have k1 := key 1
      nlinarith [mul_nonneg hη (add_nonneg (sq_nonneg (p 0)) (sq_nonneg (p 1))),
        mul_nonneg (mul_nonneg hη hη) (add_nonneg (sq_nonneg (p 0)) (sq_nonneg (p 1))),
        mul_nonneg hη hη]
    calc Real.sqrt (1 + (q 0 ^ 2 + q 1 ^ 2))
        ≤ Real.sqrt ((1 + 2 * η) ^ 2 * (1 + (p 0 ^ 2 + p 1 ^ 2))) := Real.sqrt_le_sqrt hsq'
      _ = (1 + 2 * η) * Real.sqrt (1 + (p 0 ^ 2 + p 1 ^ 2)) := by
        rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by linarith)]
  
  
  
  have hpiece : ∀ (K : Set (Fin 2 → ℝ)), Convex ℝ K →
      (∀ ξ ∈ K, DifferentiableAt ℝ v ξ) → ∀ (x₀ : Fin 2 → ℝ) (η : ℝ), 0 ≤ η →
      (∀ ξ ∈ K, ‖fderiv ℝ v ξ - fderiv ℝ v x₀‖ ≤ η) → ∀ T : Set (Fin 2 → ℝ), T ⊆ K →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) ((fun x => smthLift a x (v x)) '' T) ≤
          ENNReal.ofReal ((1 + η) ^ 2) * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
            ((fun x : Fin 2 → ℝ => smthLift a x (∑ k : Fin 2, smthGrad v x₀ k * x k)) '' T) ∧
        MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)
            ((fun x : Fin 2 → ℝ => smthLift a x (∑ k : Fin 2, smthGrad v x₀ k * x k)) '' T) ≤
          ENNReal.ofReal ((1 + η) ^ 2) *
            MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) ((fun x => smthLift a x (v x)) '' T) := by
    intro K hK hd x₀ η hη hosc T hTK
    have hsub : ∀ (x y : Fin 2 → ℝ) (s t : ℝ),
        smthLift a x s - smthLift a y t = smthLift a (x - y) (s - t) := by
      intro x y s t
      simp only [smthLift]
      rw [Fin.insertNth_sub, map_sub]
    have hhor : ∀ (h : Fin 2 → ℝ) (s : ℝ), ‖h‖ ≤ ‖smthLift a h s‖ := by
      intro h s
      refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).mpr (fun k => ?_)
      have := PiLp.norm_apply_le (smthLift a h s) (a.succAbove k)
      rw [← hcoord h s k]
      exact this
    have hvert : ∀ s : ℝ, ‖smthLift a 0 s‖ = |s| := by
      intro s
      rw [EuclideanSpace.norm_eq, Fin.sum_univ_succAbove _ a]
      have h1 : ∀ k : Fin 2, (smthLift a 0 s) (a.succAbove k) = 0 := fun k => by
        rw [hcoord]; rfl
      simp only [h1, hcoorda, norm_zero, Real.norm_eq_abs]
      simp [Real.sqrt_sq_eq_abs]
    set φ := fderiv ℝ v x₀ with hφ
    have hphi : ∀ h : Fin 2 → ℝ, ∑ k : Fin 2, smthGrad v x₀ k * h k = φ h := by
      intro h
      conv_rhs => rw [← Finset.univ_sum_single h]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have : (Pi.single k (h k) : Fin 2 → ℝ) = h k • (Pi.single k (1 : ℝ) : Fin 2 → ℝ) := by
        rw [← Pi.single_smul, smul_eq_mul, mul_one]
      rw [this, map_smul, smul_eq_mul, mul_comm]
      rfl
    set Γ : (Fin 2 → ℝ) → E3 := fun x => smthLift a x (v x) with hΓ
    set L : (Fin 2 → ℝ) → E3 := fun x => smthLift a x (∑ k : Fin 2, smthGrad v x₀ k * x k) with hL
    have hLsub : ∀ x y, L x - L y = smthLift a (x - y) (φ (x - y)) := by
      intro x y
      simp only [hL, hsub, hphi, map_sub]
    have hΓsub : ∀ x y, Γ x - Γ y = smthLift a (x - y) (v x - v y) := fun x y => hsub _ _ _ _
    have hdiff : ∀ x y, (Γ x - Γ y) - (L x - L y) = smthLift a 0 (v x - v y - φ (x - y)) := by
      intro x y
      rw [hΓsub, hLsub, hsub, sub_self]
    have hmvt : ∀ x ∈ K, ∀ y ∈ K, |v x - v y - φ (x - y)| ≤ η * ‖x - y‖ := by
      intro x hx y hy
      have := hK.norm_image_sub_le_of_norm_fderiv_le' (𝕜 := ℝ) (f := v) (φ := φ) hd hosc hy hx
      rwa [Real.norm_eq_abs] at this
    have hb1 : ∀ x ∈ K, ∀ y ∈ K, ‖Γ x - Γ y‖ ≤ (1 + η) * ‖L x - L y‖ := by
      intro x hx y hy
      have h1 := norm_le_norm_add_norm_sub' (Γ x - Γ y) (L x - L y)
      rw [hdiff, hvert] at h1
      have h2 := hmvt x hx y hy
      have h3 : ‖x - y‖ ≤ ‖L x - L y‖ := by rw [hLsub]; exact hhor _ _
      nlinarith
    have hb2 : ∀ x ∈ K, ∀ y ∈ K, ‖L x - L y‖ ≤ (1 + η) * ‖Γ x - Γ y‖ := by
      intro x hx y hy
      have h1 := norm_le_norm_add_norm_sub' (L x - L y) (Γ x - Γ y)
      rw [norm_sub_rev (L x - L y), hdiff, hvert] at h1
      have h2 := hmvt x hx y hy
      have h3 : ‖x - y‖ ≤ ‖Γ x - Γ y‖ := by rw [hΓsub]; exact hhor _ _
      nlinarith
    have transfer : ∀ (P Q : (Fin 2 → ℝ) → E3),
        (∀ x, (fun k => (Q x) (a.succAbove k)) = x) →
        (∀ x ∈ T, ∀ y ∈ T, ‖P x - P y‖ ≤ (1 + η) * ‖Q x - Q y‖) →
        MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (P '' T) ≤
          ENNReal.ofReal ((1 + η) ^ 2) * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Q '' T) := by
      intro P Q hQ hPQ
      let F : E3 → E3 := fun z => P (fun k => z (a.succAbove k))
      have hFQ : ∀ x, F (Q x) = P x := fun x => by simp only [F, hQ x]
      have hlip : LipschitzOnWith (1 + η).toNNReal F (Q '' T) := by
        apply LipschitzOnWith.of_dist_le_mul
        rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
        rw [hFQ, hFQ, dist_eq_norm, dist_eq_norm, Real.coe_toNNReal _ (by linarith)]
        exact hPQ x hx y hy
      have himg : F '' (Q '' T) = P '' T := by
        rw [Set.image_image]
        exact Set.image_congr (fun x _ => hFQ x)
      have := hlip.hausdorffMeasure_image_le (d := 2) (by norm_num)
      rw [himg] at this
      refine this.trans (le_of_eq ?_)
      congr 1
      rw [show (((1 + η).toNNReal : NNReal) : ENNReal) = ENNReal.ofReal (1 + η) from rfl,
        ENNReal.ofReal_rpow_of_nonneg (by linarith) (by norm_num), Real.rpow_two]
    have hQΓ : ∀ x, (fun k => (Γ x) (a.succAbove k)) = x := fun x => funext (fun k => hcoord _ _ k)
    have hQL : ∀ x, (fun k => (L x) (a.succAbove k)) = x := fun x => funext (fun k => hcoord _ _ k)
    exact ⟨transfer Γ L hQL (fun x hx y hy => hb1 x (hTK hx) y (hTK hy)),
      transfer L Γ hQΓ (fun x hx y hy => hb2 x (hTK hx) y (hTK hy))⟩
  
  
  
  have hcover : ∀ η : ℝ, 0 < η → ∃ (B : ℕ → Set (Fin 2 → ℝ)) (x : ℕ → Fin 2 → ℝ),
      (∀ n, IsOpen (B n) ∧ Convex ℝ (B n) ∧ B n ⊆ W ∧
        ∀ ξ ∈ B n, ‖fderiv ℝ v ξ - fderiv ℝ v (x n)‖ ≤ η) ∧ W ⊆ ⋃ n, B n := by
    intro η hη
    have hcont : ContinuousOn (fderiv ℝ v) W := hv.continuousOn_fderiv_of_isOpen hW le_rfl
    have hloc : ∀ y ∈ W, ∃ r > 0, Metric.ball y r ⊆ W ∧
        ∀ ξ ∈ Metric.ball y r, ‖fderiv ℝ v ξ - fderiv ℝ v y‖ ≤ η := by
      intro y hy
      obtain ⟨δ, hδ, hδ'⟩ := Metric.continuousAt_iff.mp (hcont.continuousAt (hW.mem_nhds hy)) η hη
      obtain ⟨ε, hε, hε'⟩ := Metric.isOpen_iff.mp hW y hy
      refine ⟨min δ ε, lt_min hδ hε, (Metric.ball_subset_ball (min_le_right _ _)).trans hε',
        fun ξ hξ => ?_⟩
      have := hδ' (lt_of_lt_of_le (Metric.mem_ball.mp hξ) (min_le_left _ _))
      rw [dist_eq_norm] at this
      exact this.le
    choose! r hr hrW hrosc using hloc
    obtain ⟨I, hIc, hIU⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun y : W => Metric.ball (y : Fin 2 → ℝ) (r y)) (fun _ => Metric.isOpen_ball)
    have hmem : ∀ y ∈ W, y ∈ ⋃ i ∈ I, Metric.ball ((i : W) : Fin 2 → ℝ) (r i) := by
      intro y hy
      rw [hIU]
      exact Set.mem_iUnion.mpr ⟨⟨y, hy⟩, Metric.mem_ball_self (hr y hy)⟩
    rcases I.eq_empty_or_nonempty with hI | hI
    · refine ⟨fun _ => ∅, fun _ => 0, fun n => ⟨isOpen_empty, convex_empty, Set.empty_subset _,
        fun ξ h => absurd h (Set.notMem_empty ξ)⟩, ?_⟩
      intro y hy
      have := hmem y hy
      rw [hI] at this
      simp at this
    · obtain ⟨g, hg'⟩ := hIc.exists_eq_range hI
      refine ⟨fun n => Metric.ball ((g n : W) : Fin 2 → ℝ) (r (g n)), fun n => g n,
        fun n => ⟨Metric.isOpen_ball, convex_ball _ _, hrW _ (g n).2, hrosc _ (g n).2⟩, ?_⟩
      intro y hy
      obtain ⟨i, hi, hyi⟩ := Set.mem_iUnion₂.mp (hmem y hy)
      rw [hg'] at hi
      obtain ⟨n, rfl⟩ := hi
      exact Set.mem_iUnion.mpr ⟨n, hyi⟩
  
  
  
  have hmeas : ∀ T : Set (Fin 2 → ℝ), MeasurableSet T → T ⊆ W →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) ((fun x => smthLift a x (v x)) '' T) =
        ∫⁻ x in T, ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst) := by
    intro T hT hTW
    set Γ : (Fin 2 → ℝ) → E3 := fun x => smthLift a x (v x) with hΓdef
    set f : (Fin 2 → ℝ) → ENNReal :=
      fun x => ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst)
      with hfdef
    have hinj : Function.Injective Γ := by
      intro x y hxy
      funext k
      rw [← hcoord x (v x) k, ← hcoord y (v y) k]
      exact congrArg (fun z : E3 => z (a.succAbove k)) hxy
    have hΓc : ContinuousOn Γ W :=
      hLc.comp_continuousOn (continuousOn_id.prodMk hv.continuousOn)
    have hdW : ∀ ξ ∈ W, DifferentiableAt ℝ v ξ := fun ξ hξ =>
      (hv.contDiffAt (hW.mem_nhds hξ)).differentiableAt one_ne_zero
    have hslope : ∀ (ξ y : Fin 2 → ℝ) (η : ℝ), ‖fderiv ℝ v ξ - fderiv ℝ v y‖ ≤ η →
        ∀ k, |smthGrad v ξ k - smthGrad v y k| ≤ η := by
      intro ξ y η h k
      have e1 : smthGrad v ξ k - smthGrad v y k =
          (fderiv ℝ v ξ - fderiv ℝ v y) (Pi.single k 1) := by
        simp only [smthGrad, ContinuousLinearMap.sub_apply]
      rw [e1, ← Real.norm_eq_abs]
      refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
      rw [Pi.norm_single, norm_one, mul_one]
      exact h
    have main : ∀ η : ℝ, 0 < η →
        MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' T) ≤
            (ENNReal.ofReal ((1 + η) ^ 2) * ENNReal.ofReal (1 + 2 * η)) * ∫⁻ x in T, f x ∧
          ∫⁻ x in T, f x ≤ (ENNReal.ofReal ((1 + η) ^ 2) * ENNReal.ofReal (1 + 2 * η)) *
            MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' T) := by
      intro η hη
      obtain ⟨B, x, hB, hcov⟩ := hcover η hη
      set Tn : ℕ → Set (Fin 2 → ℝ) := fun n => T ∩ disjointed B n with hTndef
      have hTnm : ∀ n, MeasurableSet (Tn n) := fun n =>
        hT.inter (MeasurableSet.disjointed (fun m => (hB m).1.measurableSet) n)
      have hTnd : Pairwise (Function.onFun Disjoint Tn) := fun i j hij =>
        (disjoint_disjointed B hij).mono Set.inter_subset_right Set.inter_subset_right
      have hTnB : ∀ n, Tn n ⊆ B n := fun n => Set.inter_subset_right.trans (disjointed_subset B n)
      have hTU : ⋃ n, Tn n = T := by
        simp only [hTndef]
        rw [← Set.inter_iUnion, iUnion_disjointed]
        exact Set.inter_eq_left.mpr (hTW.trans hcov)
      have hΓU : Γ '' T = ⋃ n, Γ '' Tn n := by rw [← hTU, Set.image_iUnion]
      have hΓd : Pairwise (Function.onFun Disjoint (fun n => Γ '' Tn n)) := fun i j hij =>
        (Set.disjoint_image_iff hinj).mpr (hTnd hij)
      have hΓm : ∀ n, MeasurableSet (Γ '' Tn n) := fun n =>
        (hTnm n).image_of_continuousOn_injOn (hΓc.mono ((hTnB n).trans (hB n).2.2.1)) hinj.injOn
      have hμ : MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' T) =
          ∑' n, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n) := by
        rw [hΓU]; exact measure_iUnion hΓd hΓm
      have hI : ∫⁻ x in T, f x = ∑' n, ∫⁻ x in Tn n, f x := by
        conv_lhs => rw [← hTU]
        exact lintegral_iUnion hTnm hTnd f
      have h12 : (0 : ℝ) ≤ 1 + 2 * η := by linarith
      set lam := ENNReal.ofReal ((1 + η) ^ 2) * ENNReal.ofReal (1 + 2 * η) with hlam
      have hpc := fun n => hpiece (B n) (hB n).2.1 (fun ξ hξ => hdW ξ ((hB n).2.2.1 hξ)) (x n) η
        hη.le (hB n).2.2.2 (Tn n) (hTnB n)
      have hln := fun n => hlin a (smthGrad v (x n)) (Tn n) (hTnm n)
      have hpt1 : ∀ n, ∀ ξ ∈ Tn n,
          ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) / sbgbAreaConst) ≤
            ENNReal.ofReal (1 + 2 * η) * f ξ := by
        intro n ξ hξ
        have hs := hslope ξ (x n) η ((hB n).2.2.2 ξ (hTnB n hξ))
        have h := hsq (smthGrad v ξ) (smthGrad v (x n)) η hη.le (fun k => by
          rw [abs_sub_comm]; exact hs k)
        rw [hfdef, ← ENNReal.ofReal_mul h12, ← mul_div_assoc]
        exact ENNReal.ofReal_le_ofReal (div_le_div_of_nonneg_right h hc)
      have hpt2 : ∀ n, ∀ ξ ∈ Tn n, f ξ ≤ ENNReal.ofReal (1 + 2 * η) *
          ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) / sbgbAreaConst) := by
        intro n ξ hξ
        have hs := hslope ξ (x n) η ((hB n).2.2.2 ξ (hTnB n hξ))
        have h := hsq (smthGrad v (x n)) (smthGrad v ξ) η hη.le hs
        rw [hfdef, ← ENNReal.ofReal_mul h12, ← mul_div_assoc]
        exact ENNReal.ofReal_le_ofReal (div_le_div_of_nonneg_right h hc)
      have hup : ∀ n, MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n) ≤
          lam * ∫⁻ x in Tn n, f x := by
        intro n
        calc MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n)
            ≤ ENNReal.ofReal ((1 + η) ^ 2) *
                (ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) /
                  sbgbAreaConst) * volume (Tn n)) := by
              rw [← hln n]; exact (hpc n).1
          _ = ENNReal.ofReal ((1 + η) ^ 2) * ∫⁻ ξ in Tn n,
                ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) /
                  sbgbAreaConst) := by
              rw [setLIntegral_const]
          _ ≤ ENNReal.ofReal ((1 + η) ^ 2) * ∫⁻ ξ in Tn n, ENNReal.ofReal (1 + 2 * η) * f ξ :=
              mul_le_mul_left' (setLIntegral_mono' (hTnm n) (hpt1 n)) _
          _ = lam * ∫⁻ x in Tn n, f x := by
              rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hlam, mul_assoc]
      have hlow : ∀ n, ∫⁻ x in Tn n, f x ≤
          lam * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n) := by
        intro n
        calc ∫⁻ x in Tn n, f x
            ≤ ∫⁻ ξ in Tn n, ENNReal.ofReal (1 + 2 * η) *
                ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) /
                  sbgbAreaConst) :=
              setLIntegral_mono' (hTnm n) (hpt2 n)
          _ = ENNReal.ofReal (1 + 2 * η) *
                (ENNReal.ofReal (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v (x n) k ^ 2) /
                  sbgbAreaConst) * volume (Tn n)) := by
              rw [setLIntegral_const, mul_assoc]
          _ ≤ ENNReal.ofReal (1 + 2 * η) * (ENNReal.ofReal ((1 + η) ^ 2) *
                MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n)) := by
              rw [← hln n]
              exact mul_le_mul_left' (hpc n).2 _
          _ = lam * MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' Tn n) := by
              rw [hlam, ← mul_assoc, mul_comm (ENNReal.ofReal (1 + 2 * η))]
      refine ⟨?_, ?_⟩
      · rw [hμ, hI, ← ENNReal.tsum_mul_left]
        exact ENNReal.tsum_le_tsum hup
      · rw [hμ, hI, ← ENNReal.tsum_mul_left]
        exact ENNReal.tsum_le_tsum hlow
    have hlim : Tendsto (fun η : ℝ => ENNReal.ofReal ((1 + η) ^ 2) * ENNReal.ofReal (1 + 2 * η))
        (𝓝[>] 0) (𝓝 1) := by
      have h1 : Tendsto (fun η : ℝ => (1 + η) ^ 2 * (1 + 2 * η)) (𝓝 0)
          (𝓝 ((1 + 0) ^ 2 * (1 + 2 * 0))) := by
        apply Continuous.tendsto; fun_prop
      have h2 := (ENNReal.tendsto_ofReal h1).mono_left (nhdsWithin_le_nhds (s := Set.Ioi 0))
      norm_num at h2
      refine h2.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with η hη
      rw [ENNReal.ofReal_mul (by positivity)]
    apply le_antisymm
    · have ht := ENNReal.Tendsto.mul_const hlim (b := ∫⁻ x in T, f x) (Or.inl one_ne_zero)
      rw [one_mul] at ht
      refine ge_of_tendsto ht ?_
      filter_upwards [self_mem_nhdsWithin] with η hη
      exact (main η hη).1
    · have ht := ENNReal.Tendsto.mul_const hlim
        (b := MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (Γ '' T)) (Or.inl one_ne_zero)
      rw [one_mul] at ht
      refine ge_of_tendsto ht ?_
      filter_upwards [self_mem_nhdsWithin] with η hη
      exact (main η hη).2
  
  
  
  classical
  have hJnn : ∀ x, 0 ≤ Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst :=
    fun x => div_nonneg (Real.sqrt_nonneg _) hc
  have hJm : Measurable
      (fun x => Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst) := by
    apply Measurable.div_const
    apply Measurable.sqrt
    apply Measurable.const_add
    apply Finset.measurable_sum
    intro k _
    exact (measurable_fderiv_apply_const ℝ v (Pi.single k 1)).pow_const 2
  let ρ : (Fin 2 → ℝ) → NNReal := fun x =>
    (Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst).toNNReal
  have hρm : Measurable ρ := hJm.real_toNNReal
  have hρc : ∀ x, ((ρ x : NNReal) : ℝ) =
      Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst :=
    fun x => Real.coe_toNNReal _ (hJnn x)
  let vt : (Fin 2 → ℝ) → ℝ := W.piecewise v 0
  have hvt : Measurable vt := hv.continuousOn.measurable_piecewise continuousOn_const hW.measurableSet
  let Γ : (Fin 2 → ℝ) → E3 := fun x => smthLift a x (v x)
  let Γt : (Fin 2 → ℝ) → E3 := fun x => smthLift a x (vt x)
  have hΓt : Measurable Γt := hLc.measurable.comp (measurable_id.prodMk hvt)
  have hΓeq : ∀ x ∈ W, Γt x = Γ x := fun x hx => by
    simp only [Γt, Γ, vt, Set.piecewise_eq_of_mem _ _ _ hx]
  let ν := (volume.restrict S).withDensity (fun x => (ρ x : ENNReal))
  have hmeq : (Measure.hausdorffMeasure (2 : ℝ)).restrict (Γ '' S) = Measure.map Γt ν := by
    ext B hB
    rw [Measure.map_apply hΓt hB, withDensity_apply _ (hΓt hB),
      Measure.restrict_restrict (hΓt hB), Measure.restrict_apply hB]
    have hset : Γ '' (Γt ⁻¹' B ∩ S) = B ∩ Γ '' S := by
      ext z; constructor
      · rintro ⟨x, ⟨hxB, hxS⟩, rfl⟩
        refine ⟨?_, x, hxS, rfl⟩
        have : Γt x ∈ B := hxB
        rwa [hΓeq x (hSW hxS)] at this
      · rintro ⟨hzB, x, hxS, rfl⟩
        refine ⟨x, ⟨?_, hxS⟩, rfl⟩
        show Γt x ∈ B
        rw [hΓeq x (hSW hxS)]; exact hzB
    rw [← hset, hmeas _ ((hΓt hB).inter hS) (Set.inter_subset_right.trans hSW)]
    rfl
  have hpt : ∀ x ∈ S, (ρ x • gf (Γt x)) =
      Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst *
        gf (smthLift a x (v x)) := by
    intro x hx
    rw [NNReal.smul_def, smul_eq_mul, hρc, hΓeq x (hSW hx)]
  refine ⟨?_, ?_⟩
  · show Integrable gf ((Measure.hausdorffMeasure (2 : ℝ)).restrict (Γ '' S)) ↔
      Integrable _ (volume.restrict S)
    rw [hmeq, integrable_map_measure hg.aestronglyMeasurable hΓt.aemeasurable]
    rw [show (gf ∘ Γt) = fun x => gf (Γt x) from rfl,
      integrable_withDensity_iff_integrable_smul hρm]
    exact integrable_congr (ae_restrict_of_forall_mem hS hpt)
  · show ∫ z, gf z ∂((Measure.hausdorffMeasure (2 : ℝ)).restrict (Γ '' S)) = _
    rw [hmeq, integral_map hΓt.aemeasurable hg.aestronglyMeasurable,
      integral_withDensity_eq_integral_smul hρm]
    exact setIntegral_congr_fun hS hpt

theorem straighten_clm_det : ∀ (a : Fin 3) (ℓ : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ),
    (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 3)) +
      (ℓ - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)).smulRight
        (EuclideanSpace.single a (1:ℝ))).det = ℓ (EuclideanSpace.single a (1:ℝ)) :=
by
  intro a ℓ
  set b := (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis with hb
  set c := ℓ - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) with hc
  rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix b]
  rw [ContinuousLinearMap.coe_add, ContinuousLinearMap.coe_id, ContinuousLinearMap.coe_smulRight,
    map_add, LinearMap.toMatrix_id, LinearMap.toMatrix_smulRight, Matrix.vecMulVec_eq Unit,
    Matrix.det_one_add_replicateCol_mul_replicateRow]
  have hu : ⇑(b.repr (EuclideanSpace.single a 1)) = Pi.single a 1 := by
    funext i
    simp [hb, EuclideanSpace.single_apply, Pi.single_apply]
  rw [hu, dotProduct_single]
  have hba : b a = EuclideanSpace.single a 1 := by simp [hb]
  simp only [Function.comp_apply, hba, hc, mul_one]
  simp [EuclideanSpace.single_apply]

theorem e3_dual_norm_eq : ∀ (ℓ : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ),
    ‖ℓ‖ = Real.sqrt (∑ i : Fin 3, (ℓ (EuclideanSpace.single i (1:ℝ))) ^ 2) :=
by
  intro ℓ
  obtain ⟨v, rfl⟩ := (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 3))).surjective ℓ
  rw [LinearIsometryEquiv.norm_map, EuclideanSpace.norm_eq]
  congr 1
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [InnerProductSpace.toDual_apply, EuclideanSpace.inner_single_right, Real.norm_eq_abs, sq_abs]
  simp

theorem straighten_local_inverse : ∀ (hdet : ∀ (a : Fin 3) (ℓ : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ),
      (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 3)) +
        (ℓ - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)).smulRight
          (EuclideanSpace.single a (1:ℝ))).det = ℓ (EuclideanSpace.single a (1:ℝ)))
    (U : Set (EuclideanSpace ℝ (Fin 3))) (hU : IsOpen U) (f : EuclideanSpace ℝ (Fin 3) → ℝ)
    (hf : ContDiffOn ℝ ∞ f U) (y₀ : EuclideanSpace ℝ (Fin 3)) (hy₀ : y₀ ∈ U) (a : Fin 3)
    (ha : fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ)) ≠ 0),
    ∃ (r m : ℝ) (Ξ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)), 0 < r ∧ 0 < m ∧
      Metric.closedBall y₀ r ⊆ U ∧
      (∀ y ∈ Metric.closedBall y₀ r, m ≤ |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))|) ∧
      IsOpen ((fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
        Metric.ball y₀ r) ∧
      Bornology.IsBounded ((fun y : EuclideanSpace ℝ (Fin 3) =>
        y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' Metric.ball y₀ r) ∧
      (∀ y ∈ Metric.ball y₀ r, Ξ (y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) = y) ∧
      ContDiffOn ℝ 1 Ξ ((fun y : EuclideanSpace ℝ (Fin 3) =>
        y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' Metric.ball y₀ r) :=
by
  intro hdet U hU f hf y₀ hy₀ a ha
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3),
      Θ = fun y => y + (f y - y a) • EuclideanSpace.single a (1:ℝ) := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : EuclideanSpace ℝ (Fin 3) →
      (EuclideanSpace ℝ (Fin 3) →L[ℝ] EuclideanSpace ℝ (Fin 3)), ∀ y,
      A y = ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 3)) +
        (fderiv ℝ f y - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)).smulRight
          (EuclideanSpace.single a (1:ℝ)) := ⟨_, fun _ => rfl⟩
  
  have hΘs : ContDiffOn ℝ ∞ Θ U := by
    have h1 : ContDiffOn ℝ ∞ (fun y : EuclideanSpace ℝ (Fin 3) => y a) U :=
      ((EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).contDiff).contDiffOn
    rw [hΘ]
    exact contDiffOn_id.add ((hf.sub h1).smul contDiffOn_const)
  
  have hder : ∀ y ∈ U, HasFDerivAt Θ (A y) y := by
    intro y hy
    have hfd : HasFDerivAt f (fderiv ℝ f y) y :=
      ((hf.contDiffAt (hU.mem_nhds hy)).differentiableAt (by simp)).hasFDerivAt
    have h2 := (hasFDerivAt_id y).add ((hfd.sub
      (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).hasFDerivAt).smul_const
        (EuclideanSpace.single a (1:ℝ)))
    rw [hΘ, hA y]
    exact h2
  have hcont : ContinuousOn (fun y => fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))) U :=
    (hf.continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)).clm_apply continuousOn_const
  obtain ⟨O, hO⟩ : ∃ O : Set (EuclideanSpace ℝ (Fin 3)),
      O = U ∩ (fun y => fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))) ⁻¹' {0}ᶜ := ⟨_, rfl⟩
  have hOo : IsOpen O := by
    rw [hO]; exact hcont.isOpen_inter_preimage hU isOpen_compl_singleton
  have hOU : O ⊆ U := by rw [hO]; exact Set.inter_subset_left
  have hOd : ∀ y ∈ O, fderiv ℝ f y (EuclideanSpace.single a (1:ℝ)) ≠ 0 := by
    intro y hy; rw [hO] at hy; exact hy.2
  have hy₀O : y₀ ∈ O := by rw [hO]; exact ⟨hy₀, ha⟩
  have hdetO : ∀ y ∈ O, (A y).det ≠ 0 := by
    intro y hy
    rw [hA y, hdet a (fderiv ℝ f y)]
    exact hOd y hy
  have hT : ∀ (y : EuclideanSpace ℝ (Fin 3)) (hy : y ∈ O), HasFDerivAt Θ
      ((A y).toContinuousLinearEquivOfDetNeZero (hdetO y hy) :
        EuclideanSpace ℝ (Fin 3) →L[ℝ] EuclideanSpace ℝ (Fin 3)) y := by
    intro y hy
    rw [ContinuousLinearMap.coe_toContinuousLinearEquivOfDetNeZero]
    exact hder y (hOU hy)
  have hC1 : ∀ y ∈ U, ContDiffAt ℝ 1 Θ y := fun y hy =>
    (hΘs.contDiffAt (hU.mem_nhds hy)).of_le (by exact_mod_cast le_top)
  
  obtain ⟨Φ, hΦ, hy₀Φ⟩ : ∃ Φ : OpenPartialHomeomorph (EuclideanSpace ℝ (Fin 3))
      (EuclideanSpace ℝ (Fin 3)), (Φ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3)) = Θ ∧
      y₀ ∈ Φ.source :=
    ⟨ContDiffAt.toOpenPartialHomeomorph Θ (hC1 y₀ hy₀) (hT y₀ hy₀O) one_ne_zero,
      ContDiffAt.toOpenPartialHomeomorph_coe _ _ _,
      ContDiffAt.mem_toOpenPartialHomeomorph_source _ _ _⟩
  have hSo : IsOpen (Φ.source ∩ O) := Φ.open_source.inter hOo
  have hy₀S : y₀ ∈ Φ.source ∩ O := ⟨hy₀Φ, hy₀O⟩
  obtain ⟨δ₂, hδ₂, hball⟩ := Metric.isOpen_iff.mp hSo y₀ hy₀S
  have hc : 0 < |fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ))| := abs_pos.mpr ha
  obtain ⟨δ₁, hδ₁, hcl⟩ :=
    Metric.continuousAt_iff.mp (hcont.continuousAt (hU.mem_nhds hy₀)) _ (half_pos hc)
  have hδ : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = min δ₁ δ₂ / 2 := ⟨_, rfl⟩
  have hr : 0 < r := by rw [hrdef]; exact half_pos hδ
  have hrlt : r < min δ₁ δ₂ := by rw [hrdef]; exact half_lt_self hδ
  have hcb : Metric.closedBall y₀ r ⊆ Metric.ball y₀ (min δ₁ δ₂) :=
    Metric.closedBall_subset_ball hrlt
  have hcbS : Metric.closedBall y₀ r ⊆ Φ.source ∩ O := fun y hy =>
    hball (Metric.ball_subset_ball (min_le_right _ _) (hcb hy))
  have hbS : Metric.ball y₀ r ⊆ Φ.source ∩ O := Metric.ball_subset_closedBall.trans hcbS
  have hcbU : Metric.closedBall y₀ r ⊆ U := fun y hy => hOU (hcbS hy).2
  have hG2 : ∀ y ∈ Metric.closedBall y₀ r, |fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ))| / 2 ≤
      |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))| := by
    intro y hy
    have h1 : dist y y₀ < δ₁ := lt_of_lt_of_le (Metric.mem_ball.mp (hcb hy)) (min_le_left _ _)
    have h2 : |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ)) -
        fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ))| <
        |fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ))| / 2 := by
      have := hcl h1
      rwa [Real.dist_eq] at this
    have h3 := abs_sub_abs_le_abs_sub (fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ)))
      (fderiv ℝ f y (EuclideanSpace.single a (1:ℝ)))
    have h4 := abs_sub_comm (fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ)))
      (fderiv ℝ f y (EuclideanSpace.single a (1:ℝ)))
    linarith
  have hG3 : IsOpen (Θ '' Metric.ball y₀ r) := by
    rw [← hΦ]
    exact Φ.isOpen_image_of_subset_source Metric.isOpen_ball (fun y hy => (hbS hy).1)
  have hG4 : Bornology.IsBounded (Θ '' Metric.ball y₀ r) :=
    ((isCompact_closedBall y₀ r).image_of_continuousOn
      (hΘs.continuousOn.mono hcbU)).isBounded.subset
      (Set.image_mono Metric.ball_subset_closedBall)
  have hG5 : ∀ y ∈ Metric.ball y₀ r, Φ.symm (Θ y) = y := by
    intro y hy
    rw [← hΦ]
    exact Φ.left_inv (hbS hy).1
  have hG6 : ContDiffOn ℝ 1 Φ.symm (Θ '' Metric.ball y₀ r) := by
    rintro z ⟨y, hy, rfl⟩
    have hyS := hbS hy
    have hz : Θ y ∈ Φ.target := by
      rw [← hΦ]; exact Φ.map_source hyS.1
    have hsy : Φ.symm (Θ y) = y := hG5 y hy
    have h1 : HasFDerivAt (Φ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3))
        ((A y).toContinuousLinearEquivOfDetNeZero (hdetO y hyS.2) :
          EuclideanSpace ℝ (Fin 3) →L[ℝ] EuclideanSpace ℝ (Fin 3)) (Φ.symm (Θ y)) := by
      rw [hsy, hΦ]; exact hT y hyS.2
    have h2 : ContDiffAt ℝ 1 (Φ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3))
        (Φ.symm (Θ y)) := by
      rw [hsy, hΦ]; exact hC1 y (hOU hyS.2)
    exact (Φ.contDiffAt_symm hz h1 h2).contDiffWithinAt
  subst hΘ
  exact ⟨r, |fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ))| / 2, Φ.symm, hr, half_pos hc, hcbU,
    hG2, hG3, hG4, hG5, hG6⟩

theorem slice_fubini_E3 : ∀ (a : Fin 3) (S : Set (EuclideanSpace ℝ (Fin 3))) (hS : MeasurableSet S)
    (G : EuclideanSpace ℝ (Fin 3) → ℝ) (hG : MeasureTheory.IntegrableOn G S),
    MeasureTheory.Integrable (fun t : ℝ => ∫ x in {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈ S},
        G ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) ∧
    ∫ z in S, G z = ∫ t : ℝ, ∫ x in {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈ S},
        G ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) :=
by
  intro a S hS G hG
  let e : (ℝ × (Fin 2 → ℝ)) ≃ᵐ EuclideanSpace ℝ (Fin 3) :=
    (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) a).symm.trans
      (MeasurableEquiv.toLp 2 (Fin 3 → ℝ))
  have he : ∀ (t : ℝ) (x : Fin 2 → ℝ),
      e (t, x) = (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) := fun t x => rfl
  have hmp : MeasureTheory.MeasurePreserving (⇑e) MeasureTheory.volume MeasureTheory.volume :=
    (PiLp.volume_preserving_toLp (Fin 3)).comp
      ((MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) a).symm)
  have hF : MeasureTheory.Integrable (S.indicator G) := hG.integrable_indicator hS
  have hFe : MeasureTheory.Integrable (fun p : ℝ × (Fin 2 → ℝ) => S.indicator G (e p))
      ((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod
        (MeasureTheory.volume : MeasureTheory.Measure (Fin 2 → ℝ))) :=
    hmp.integrable_comp_of_integrable hF
  have hslice : ∀ t : ℝ, ∫ x : Fin 2 → ℝ, S.indicator G (e (t, x)) = ∫ x in {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈ S},
        G ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) := by
    intro t
    have hm : Measurable (fun x : Fin 2 → ℝ => e (t, x)) :=
      e.measurable.comp measurable_prodMk_left
    have hSt : MeasurableSet {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈ S} := hS.preimage hm
    rw [← MeasureTheory.integral_indicator hSt]
    congr 1
  refine ⟨?_, ?_⟩
  · refine hFe.integral_prod_left.congr (Filter.Eventually.of_forall fun t => ?_)
    exact hslice t
  · calc ∫ z in S, G z = ∫ z, S.indicator G z := (MeasureTheory.integral_indicator hS).symm
      _ = ∫ p, S.indicator G (e p) ∂((MeasureTheory.volume : MeasureTheory.Measure ℝ).prod
            (MeasureTheory.volume : MeasureTheory.Measure (Fin 2 → ℝ))) :=
          (hmp.integral_comp' (S.indicator G)).symm
      _ = ∫ t : ℝ, ∫ x : Fin 2 → ℝ, S.indicator G (e (t, x)) :=
          MeasureTheory.integral_prod _ hFe
      _ = _ := MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hslice)

theorem level_graph_area_element : ∀ (hnorm : ∀ (ℓ : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ),
      ‖ℓ‖ = Real.sqrt (∑ i : Fin 3, (ℓ (EuclideanSpace.single i (1:ℝ))) ^ 2))
    (a : Fin 3) (f : EuclideanSpace ℝ (Fin 3) → ℝ) (H : (Fin 2 → ℝ) → ℝ) (W : Set (Fin 2 → ℝ))
    (hW : IsOpen W) (x : Fin 2 → ℝ) (hx : x ∈ W) (hH : DifferentiableAt ℝ H x)
    (hfd : DifferentiableAt ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x)))
    (t : ℝ) (hlev : ∀ x' ∈ W, f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x') x')) = t)
    (ha : fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))
      (EuclideanSpace.single a (1:ℝ)) ≠ 0),
    (∀ k : Fin 2, fderiv ℝ H x (Pi.single k 1) =
      -(fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))
        (EuclideanSpace.single (a.succAbove k) (1:ℝ))) /
        fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))
          (EuclideanSpace.single a (1:ℝ))) ∧
    Real.sqrt (1 + ∑ k : Fin 2, fderiv ℝ H x (Pi.single k 1) ^ 2) =
      ‖fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))‖ /
        |fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))
          (EuclideanSpace.single a (1:ℝ))| :=
by
  intro hnorm a f H W hW x hx hH hfd t hlev ha
  set ℓ := fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x)) with hℓ
  set φ : (Fin 2 → ℝ) → EuclideanSpace ℝ (Fin 3) :=
    fun x' => (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x') x') with hφ
  have hdec : φ = fun x' => H x' • EuclideanSpace.single a (1:ℝ) +
      (x' 0 • EuclideanSpace.single (a.succAbove 0) (1:ℝ) +
        x' 1 • EuclideanSpace.single (a.succAbove 1) (1:ℝ)) := by
    funext x'
    ext i
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨m, rfl⟩
    · simp [φ, EuclideanSpace.single_apply]
    · fin_cases m <;>
        simp [φ, EuclideanSpace.single_apply, Fin.succAbove_right_injective.eq_iff]
  set Λ : (Fin 2 → ℝ) →L[ℝ] EuclideanSpace ℝ (Fin 3) :=
    (fderiv ℝ H x).smulRight (EuclideanSpace.single a (1:ℝ)) +
      ((ContinuousLinearMap.proj 0 : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight
        (EuclideanSpace.single (a.succAbove 0) (1:ℝ)) +
       (ContinuousLinearMap.proj 1 : (Fin 2 → ℝ) →L[ℝ] ℝ).smulRight
        (EuclideanSpace.single (a.succAbove 1) (1:ℝ))) with hΛ
  have hφd : HasFDerivAt φ Λ x := by
    rw [hdec]
    refine (hH.hasFDerivAt.smul_const _).add ?_
    exact (((ContinuousLinearMap.proj 0 : (Fin 2 → ℝ) →L[ℝ] ℝ).hasFDerivAt).smul_const _).add
      (((ContinuousLinearMap.proj 1 : (Fin 2 → ℝ) →L[ℝ] ℝ).hasFDerivAt).smul_const _)
  have hcomp : HasFDerivAt (f ∘ φ) (ℓ.comp Λ) x := hfd.hasFDerivAt.comp x hφd
  have hconst : HasFDerivAt (f ∘ φ) (0 : (Fin 2 → ℝ) →L[ℝ] ℝ) x := by
    have hev : Filter.EventuallyEq (nhds x) (f ∘ φ) (fun _ => t) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun x' hx' => hlev x' hx')
    exact (hasFDerivAt_const t x).congr_of_eventuallyEq hev
  have hzero : ℓ.comp Λ = 0 := hcomp.unique hconst
  have hΛk : ∀ k : Fin 2, Λ (Pi.single k 1) = fderiv ℝ H x (Pi.single k 1) •
      EuclideanSpace.single a (1:ℝ) + EuclideanSpace.single (a.succAbove k) (1:ℝ) := by
    intro k
    fin_cases k <;> simp [Λ]
  have hkey : ∀ k : Fin 2, fderiv ℝ H x (Pi.single k 1) * ℓ (EuclideanSpace.single a (1:ℝ)) +
      ℓ (EuclideanSpace.single (a.succAbove k) (1:ℝ)) = 0 := by
    intro k
    have h := congrArg (fun L => L (Pi.single k (1:ℝ))) hzero
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply, hΛk, map_add,
      map_smul, smul_eq_mul] at h
    exact h
  have hA : ∀ k : Fin 2, fderiv ℝ H x (Pi.single k 1) =
      -(ℓ (EuclideanSpace.single (a.succAbove k) (1:ℝ))) / ℓ (EuclideanSpace.single a (1:ℝ)) := by
    intro k
    rw [eq_div_iff ha]
    linarith [hkey k]
  refine ⟨hA, ?_⟩
  simp only [hA]
  rw [hnorm ℓ, Fin.sum_univ_succAbove _ a]
  have hpos : 0 < ℓ (EuclideanSpace.single a (1:ℝ)) ^ 2 := by positivity
  rw [← Real.sqrt_sq_eq_abs, ← Real.sqrt_div' _ hpos.le]
  congr 1
  rw [add_div, div_self hpos.ne', Finset.sum_div]
  congr 1
  refine Finset.sum_congr rfl (fun k _ => ?_)
  rw [div_pow, neg_sq]

theorem straighten_slice_structure : ∀ (a : Fin 3) (f : EuclideanSpace ℝ (Fin 3) → ℝ)
    (V : Set (EuclideanSpace ℝ (Fin 3)))
    (Ξ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3))
    (hΞ : ∀ y ∈ V, Ξ (y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) = y) (t : ℝ),
    (∀ x ∈ {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
        (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V},
      Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) =
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a
          ((Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a) x) ∧
      Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) ∈ V ∧
      f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) = t) ∧
    (∀ E ⊆ V, MeasurableSet ((fun y : EuclideanSpace ℝ (Fin 3) =>
        y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E) →
      MeasurableSet {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
        (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} ∧
      (fun x : Fin 2 → ℝ => (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a
          ((Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a) x)) ''
        {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} =
        E ∩ f ⁻¹' {t}) :=
by
  intro a f V Ξ hΞ t
  have hext : ∀ u v : EuclideanSpace ℝ (Fin 3), u a = v a →
      (∀ j : Fin 2, u (a.succAbove j) = v (a.succAbove j)) → u = v := by
    intro u v h1 h2
    ext b
    rcases Fin.eq_self_or_eq_succAbove a b with rfl | ⟨j, rfl⟩
    · exact h1
    · exact h2 j
  have hTa : ∀ y : EuclideanSpace ℝ (Fin 3),
      (y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) a = f y := by
    intro y; simp
  have hTs : ∀ (y : EuclideanSpace ℝ (Fin 3)) (j : Fin 2),
      (y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) (a.succAbove j) = y (a.succAbove j) := by
    intro y j
    simp [EuclideanSpace.single_apply, Fin.succAbove_ne]
  have hPa : ∀ (s : ℝ) (x : Fin 2 → ℝ),
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a s x) a = s := by
    intro s x; simp
  have hPs : ∀ (s : ℝ) (x : Fin 2 → ℝ) (j : Fin 2),
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a s x) (a.succAbove j) = x j := by
    intro s x j; simp
  have hinv : ∀ (y : EuclideanSpace ℝ (Fin 3)) (x : Fin 2 → ℝ),
      y + (f y - y a) • EuclideanSpace.single a (1:ℝ) =
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) →
      f y = t ∧ (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (y a) x) = y := by
    intro y x h
    refine ⟨?_, ?_⟩
    · have := congrArg (fun w : EuclideanSpace ℝ (Fin 3) => w a) h
      simp only [hTa, hPa] at this
      exact this
    · refine hext _ _ (hPa _ _) (fun j => ?_)
      have := congrArg (fun w : EuclideanSpace ℝ (Fin 3) => w (a.succAbove j)) h
      simp only [hTs, hPs] at this
      rw [hPs, this]
  have hmem : ∀ (F : Set (EuclideanSpace ℝ (Fin 3))), F ⊆ V → ∀ x : Fin 2 → ℝ,
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
        (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' F →
      Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) ∈ F ∧
      f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) = t ∧
      (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a
          ((Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a) x) =
        Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) := by
    intro F hF x hx
    obtain ⟨y, hyF, hy⟩ := hx
    have hy' : y + (f y - y a) • EuclideanSpace.single a (1:ℝ) =
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) := hy
    have hXi : Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) = y := by
      rw [← hy']; exact hΞ y (hF hyF)
    obtain ⟨h1, h2⟩ := hinv y x hy'
    rw [hXi]
    exact ⟨hyF, h1, h2⟩
  refine ⟨fun x hx => ?_, fun E hEV hTE => ⟨?_, ?_⟩⟩
  · obtain ⟨h1, h2, h3⟩ := hmem V le_rfl x hx
    exact ⟨h3.symm, h1, h2⟩
  · have hPc : Continuous (fun x : Fin 2 → ℝ =>
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) :=
      (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp
        (Continuous.finInsertNth a continuous_const continuous_id)
    exact hTE.preimage hPc.measurable
  · ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨h1, h2, h3⟩ := hmem E hEV x hx
      simp only
      rw [h3]
      exact ⟨h1, h2⟩
    · rintro ⟨hzE, hzt⟩
      have hzt' : f z = t := hzt
      have hT : z + (f z - z a) • EuclideanSpace.single a (1:ℝ) =
          (EuclideanSpace.equiv (Fin 3) ℝ).symm
            (Fin.insertNth a t (fun j : Fin 2 => z (a.succAbove j))) := by
        refine hext _ _ ?_ (fun j => ?_)
        · rw [hTa, hPa, hzt']
        · rw [hTs, hPs]
      have hx : (fun j : Fin 2 => z (a.succAbove j)) ∈ {x : Fin 2 → ℝ |
          (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
            (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
              E} := ⟨z, hzE, hT⟩
      refine ⟨_, hx, ?_⟩
      obtain ⟨-, -, h3⟩ := hmem E hEV _ hx
      simp only
      rw [h3, ← hT]
      exact hΞ z (hEV hzE)

theorem straighten_slice_regular : ∀ (a : Fin 3) (f : EuclideanSpace ℝ (Fin 3) → ℝ)
    (V : Set (EuclideanSpace ℝ (Fin 3)))
    (Ξ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3))
    (hVo : IsOpen ((fun y : EuclideanSpace ℝ (Fin 3) =>
      y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V))
    (hVb : Bornology.IsBounded ((fun y : EuclideanSpace ℝ (Fin 3) =>
      y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V))
    (hΞs : ContDiffOn ℝ 1 Ξ ((fun y : EuclideanSpace ℝ (Fin 3) =>
      y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V)) (t : ℝ),
    IsOpen {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
      (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V} ∧
    Bornology.IsBounded {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
      (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V} ∧
    ContinuousOn (fun x : Fin 2 → ℝ => Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
      {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
        (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V} ∧
    ContDiffOn ℝ 1 (fun x : Fin 2 → ℝ =>
        (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a)
      {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
        (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V} :=
by
  intro a f V Ξ hVo hVb hΞs t
  set T := (fun y : EuclideanSpace ℝ (Fin 3) =>
    y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' V with hTdef
  set ι : (Fin 2 → ℝ) → EuclideanSpace ℝ (Fin 3) :=
    fun x => (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) with hιdef
  have hJ : ContDiff ℝ 1 (fun x : Fin 2 → ℝ => (Fin.insertNth a t x : Fin 3 → ℝ)) := by
    rw [contDiff_pi]
    intro j
    rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨k, rfl⟩
    · subst h
      simp only [Fin.insertNth_apply_same]
      exact contDiff_const
    · simp only [Fin.insertNth_apply_succAbove]
      exact contDiff_apply ℝ ℝ k
  have hι : ContDiff ℝ 1 ι := (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp hJ
  have hιc : Continuous ι := hι.continuous
  have hkey : ∀ x : Fin 2 → ℝ, ∀ k : Fin 2, (ι x) (a.succAbove k) = x k := by
    intro x k
    change (Fin.insertNth a t x : Fin 3 → ℝ) (a.succAbove k) = x k
    simp
  refine ⟨hVo.preimage hιc, ?_, ?_, ?_⟩
  · obtain ⟨C, hC⟩ := isBounded_iff_forall_norm_le.mp hVb
    refine isBounded_iff_forall_norm_le.mpr ⟨max C 0, fun x hx => ?_⟩
    refine (pi_norm_le_iff_of_nonneg (le_max_right C 0)).mpr (fun k => ?_)
    have h1 : ‖ι x‖ ≤ C := hC _ hx
    have h2 : ‖(ι x) (a.succAbove k)‖ ≤ ‖ι x‖ := PiLp.norm_apply_le _ _
    rw [hkey] at h2
    exact (h2.trans h1).trans (le_max_left _ _)
  · exact hΞs.continuousOn.comp hιc.continuousOn (fun x hx => hx)
  · have h1 : ContDiffOn ℝ 1 (Ξ ∘ ι) {x | ι x ∈ T} := hΞs.comp hι.contDiffOn (fun x hx => hx)
    have h2 : ContDiff ℝ 1 (fun y : EuclideanSpace ℝ (Fin 3) => y a) :=
      (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).contDiff
    exact h2.comp_contDiffOn h1

theorem straighten_change_of_variables : ∀ (hdet : ∀ (a : Fin 3)
      (ℓ : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ),
      (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 3)) +
        (ℓ - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)).smulRight
          (EuclideanSpace.single a (1:ℝ))).det = ℓ (EuclideanSpace.single a (1:ℝ)))
    (a : Fin 3) (U : Set (EuclideanSpace ℝ (Fin 3))) (hU : IsOpen U)
    (f : EuclideanSpace ℝ (Fin 3) → ℝ) (hf : ContDiffOn ℝ ∞ f U)
    (V : Set (EuclideanSpace ℝ (Fin 3))) (hVU : V ⊆ U) (hVb : Bornology.IsBounded V) (m : ℝ)
    (hm : 0 < m) (hmV : ∀ y ∈ V, m ≤ |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))|)
    (Ξ : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3))
    (hΞ : ∀ y ∈ V, Ξ (y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) = y)
    (E : Set (EuclideanSpace ℝ (Fin 3))) (ψ : EuclideanSpace ℝ (Fin 3) → ℝ) (B : ℝ)
    (hE : MeasurableSet E) (hEV : E ⊆ V) (hψ : Measurable ψ) (hB : ∀ y ∈ E, |ψ y| ≤ B),
    MeasurableSet ((fun y : EuclideanSpace ℝ (Fin 3) =>
      y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E) ∧
    MeasureTheory.IntegrableOn (fun z => ψ (Ξ z) / |fderiv ℝ f (Ξ z) (EuclideanSpace.single a (1:ℝ))|)
      ((fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E) ∧
    ∫ y in E, ψ y = ∫ z in (fun y : EuclideanSpace ℝ (Fin 3) =>
        y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E,
      ψ (Ξ z) / |fderiv ℝ f (Ξ z) (EuclideanSpace.single a (1:ℝ))| :=
by
  intro hdet a U hU f hf V hVU hVb m hm hmV Ξ hΞ E ψ B hE hEV hψ hB
  set T : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3) :=
    fun y => y + (f y - y a) • EuclideanSpace.single a (1:ℝ) with hTdef
  set T' : EuclideanSpace ℝ (Fin 3) → (EuclideanSpace ℝ (Fin 3) →L[ℝ] EuclideanSpace ℝ (Fin 3)) :=
    fun y => ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 3)) +
      (fderiv ℝ f y - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)).smulRight
        (EuclideanSpace.single a (1:ℝ)) with hT'def
  have s1 : ∀ y ∈ E, DifferentiableAt ℝ f y := fun y hy =>
    (hf.contDiffAt (hU.mem_nhds (hVU (hEV hy)))).differentiableAt (by simp)
  have s2 : ∀ y ∈ E, HasFDerivWithinAt T (T' y) E y := by
    intro y hy
    have h1 : HasFDerivAt (fun x => f x - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) x)
        (fderiv ℝ f y - (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ)) y :=
      (s1 y hy).hasFDerivAt.sub (EuclideanSpace.proj a : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ).hasFDerivAt
    have h2 := h1.smul_const (EuclideanSpace.single a (1:ℝ))
    have h3 := (hasFDerivAt_id y).add h2
    have h4 : HasFDerivAt T (T' y) y := by
      convert h3 using 1
    exact h4.hasFDerivWithinAt
  have s3 : Set.InjOn T E := by
    intro y₁ h₁ y₂ h₂ heq
    rw [← hΞ y₁ (hEV h₁), ← hΞ y₂ (hEV h₂)]
    exact congrArg Ξ heq
  have s4 : MeasurableSet (T '' E) :=
    MeasureTheory.measurable_image_of_fderivWithin hE s2 s3
  have s6 : ∀ y ∈ E, |(T' y).det| • (fun z => ψ (Ξ z) /
      |fderiv ℝ f (Ξ z) (EuclideanSpace.single a (1:ℝ))|) (T y) = ψ y := by
    intro y hy
    have hdy : (T' y).det = fderiv ℝ f y (EuclideanSpace.single a (1:ℝ)) := hdet a (fderiv ℝ f y)
    have hX : Ξ (T y) = y := hΞ y (hEV hy)
    simp only [smul_eq_mul]
    rw [hdy, hX]
    have hc : |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))| ≠ 0 :=
      (lt_of_lt_of_le hm (hmV y (hEV hy))).ne'
    exact mul_div_cancel₀ (ψ y) hc
  have s7 : MeasureTheory.IntegrableOn ψ E := by
    have hfin : MeasureTheory.volume E < ⊤ := (hVb.subset hEV).measure_lt_top
    have hbound : ∀ᵐ y ∂(MeasureTheory.volume.restrict E), ‖ψ y‖ ≤ B :=
      MeasureTheory.ae_restrict_of_forall_mem hE (fun y hy => by
        rw [Real.norm_eq_abs]; exact hB y hy)
    exact MeasureTheory.Measure.integrableOn_of_bounded hfin.ne hψ.aestronglyMeasurable hbound
  have s8 := MeasureTheory.integrableOn_image_iff_integrableOn_abs_det_fderiv_smul
    (μ := MeasureTheory.volume) hE s2 s3
    (fun z => ψ (Ξ z) / |fderiv ℝ f (Ξ z) (EuclideanSpace.single a (1:ℝ))|)
  have s9 := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul
    (μ := MeasureTheory.volume) hE s2 s3
    (fun z => ψ (Ξ z) / |fderiv ℝ f (Ξ z) (EuclideanSpace.single a (1:ℝ))|)
  refine ⟨s4, s8.mpr (s7.congr_fun (fun y hy => (s6 y hy).symm) hE), ?_⟩
  rw [s9]
  exact (MeasureTheory.setIntegral_congr_fun hE (fun y hy => s6 y hy)).symm

theorem euclid_coarea_local (hc : 0 < sbgbAreaConst)
    (hgraph : ∀ (a : Fin 3) (W : Set (Fin 2 → ℝ)), IsOpen W → ∀ (v : (Fin 2 → ℝ) → ℝ),
      ContDiffOn ℝ 1 v W → ∀ (S : Set (Fin 2 → ℝ)), MeasurableSet S → S ⊆ W →
      ∀ (gf : E3 → ℝ), Measurable gf →
      (MeasureTheory.IntegrableOn gf ((fun x => smthLift a x (v x)) '' S)
          (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ↔
        MeasureTheory.IntegrableOn (fun x => Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) /
          sbgbAreaConst * gf (smthLift a x (v x))) S) ∧
      ∫ z in (fun x => smthLift a x (v x)) '' S, gf z
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        ∫ x in S, Real.sqrt (1 + ∑ k : Fin 2, smthGrad v x k ^ 2) / sbgbAreaConst *
          gf (smthLift a x (v x)))
    (U : Set E3) (hU : IsOpen U) (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (y₀ : E3) (hy₀ : y₀ ∈ U)
    (hd : fderiv ℝ f y₀ ≠ 0) :
    ∃ V : Set E3, IsOpen V ∧ y₀ ∈ V ∧ V ⊆ U ∧
      ∀ (E : Set E3) (ψ : E3 → ℝ) (B : ℝ), MeasurableSet E → E ⊆ V → Measurable ψ →
        (∀ y ∈ E, |ψ y| ≤ B) →
        (∀ t : ℝ, MeasureTheory.IntegrableOn (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
          (E ∩ f ⁻¹' {t}) (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
        MeasureTheory.Integrable (fun t : ℝ => ∫ y in E ∩ f ⁻¹' {t},
          ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
        ∫ y in E, ψ y = ∫ t : ℝ, ∫ y in E ∩ f ⁻¹' {t},
          ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) :=
by
  classical
  
  have hslot : ∃ a : Fin 3, fderiv ℝ f y₀ (EuclideanSpace.single a (1:ℝ)) ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    apply hd
    have h0 : ‖fderiv ℝ f y₀‖ = 0 := by
      rw [e3_dual_norm_eq]
      simp [hcon]
    exact norm_eq_zero.mp h0
  obtain ⟨a, ha⟩ := hslot
  
  obtain ⟨r, m, Ξ, hr, hm, hcb, hmcb, hWo, hWb, hΞ, hΞs⟩ :=
    straighten_local_inverse straighten_clm_det U hU f hf y₀ hy₀ a ha
  have hVU : Metric.ball y₀ r ⊆ U := Metric.ball_subset_closedBall.trans hcb
  refine ⟨Metric.ball y₀ r, Metric.isOpen_ball, Metric.mem_ball_self hr, hVU, ?_⟩
  intro E ψ B hE hEV hψ hB
  have hmV : ∀ y ∈ Metric.ball y₀ r, m ≤ |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))| :=
    fun y hy => hmcb y (Metric.ball_subset_closedBall hy)
  have hdiff : ∀ y ∈ Metric.ball y₀ r, DifferentiableAt ℝ f y := fun y hy =>
    (hf.contDiffAt (hU.mem_nhds (hVU hy))).differentiableAt (by simp)
  have hnormpos : ∀ y ∈ Metric.ball y₀ r, m ≤ ‖fderiv ℝ f y‖ := by
    intro y hy
    have h1 := ContinuousLinearMap.le_opNorm (fderiv ℝ f y) (EuclideanSpace.single a (1:ℝ))
    rw [EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs] at h1
    exact (hmV y hy).trans h1
  have hgfm : Measurable (fun y : E3 => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)) :=
    hψ.mul (measurable_const.div (measurable_fderiv ℝ f).norm)
  
  obtain ⟨hTE, hGint, hCV⟩ := straighten_change_of_variables straighten_clm_det a U hU f hf
    (Metric.ball y₀ r) hVU Metric.isBounded_ball m hm hmV Ξ hΞ E ψ B hE hEV hψ hB
  obtain ⟨hFint, hFeq⟩ := slice_fubini_E3 a _ hTE _ hGint
  
  have hslice : ∀ t : ℝ,
      MeasureTheory.IntegrableOn (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
        (E ∩ f ⁻¹' {t}) (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ∧
      ∫ y in E ∩ f ⁻¹' {t}, ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        ∫ x in {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E},
          ψ (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) /
            |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
              (EuclideanSpace.single a (1:ℝ))| := by
    intro t
    obtain ⟨hP1, hP23⟩ := straighten_slice_structure a f (Metric.ball y₀ r) Ξ hΞ t
    obtain ⟨hEt, himg⟩ := hP23 E hEV hTE
    obtain ⟨hWto, hWtb, hWtc, hH⟩ :=
      straighten_slice_regular a f (Metric.ball y₀ r) Ξ hWo hWb hΞs t
    have hEW : {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} ⊆
        {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
            Metric.ball y₀ r} :=
      fun x hx => Set.image_mono hEV hx
    obtain ⟨H, hHeq⟩ : ∃ H : (Fin 2 → ℝ) → ℝ, H = fun x : Fin 2 → ℝ =>
        (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a := ⟨_, rfl⟩
    have hHdef : ∀ x, H x = (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) a :=
      fun x => by rw [hHeq]
    have hH' : ContDiffOn ℝ 1 H {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
            Metric.ball y₀ r} := by
      rw [hHeq]; exact hH
    have hyform : ∀ x ∈ {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
            Metric.ball y₀ r},
        Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) = smthLift a x (H x) ∧
        Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) ∈ Metric.ball y₀ r ∧
        f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) = t := by
      intro x hx
      obtain ⟨g1, g2, g3⟩ := hP1 x hx
      refine ⟨?_, g2, g3⟩
      rw [hHdef]
      exact g1
    have hlev : ∀ x' ∈ {x : Fin 2 → ℝ |
        (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
            Metric.ball y₀ r},
        f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x') x')) = t := by
      intro x' hx'
      obtain ⟨g1, -, g3⟩ := hyform x' hx'
      show f (smthLift a x' (H x')) = t
      rw [← g1]
      exact g3
    
    have hpt : ∀ x ∈ {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E},
        Real.sqrt (1 + ∑ k : Fin 2, smthGrad H x k ^ 2) / sbgbAreaConst *
            (ψ (smthLift a x (H x)) * (sbgbAreaConst / ‖fderiv ℝ f (smthLift a x (H x))‖)) =
          ψ (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) /
            |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
              (EuclideanSpace.single a (1:ℝ))| := by
      intro x hx
      have hxW := hEW hx
      obtain ⟨hy, hyV, -⟩ := hyform x hxW
      have hy2 : Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) =
          (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x) := hy
      have hHd : DifferentiableAt ℝ H x :=
        (hH'.contDiffAt (hWto.mem_nhds hxW)).differentiableAt (by norm_num)
      have hfd : DifferentiableAt ℝ f
          ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x)) := by
        rw [← hy2]; exact hdiff _ hyV
      have hax : fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
          (EuclideanSpace.single a (1:ℝ)) ≠ 0 := by
        intro h0
        have h1 := hmV _ hyV
        rw [h0, abs_zero] at h1
        linarith
      have ha' : fderiv ℝ f ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a (H x) x))
          (EuclideanSpace.single a (1:ℝ)) ≠ 0 := by
        rw [← hy2]; exact hax
      have hs5 := (level_graph_area_element e3_dual_norm_eq a f H _ hWto x hxW hHd hfd t hlev ha').2
      rw [← hy2] at hs5
      have hJ : Real.sqrt (1 + ∑ k : Fin 2, smthGrad H x k ^ 2) =
          ‖fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))‖ /
            |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
              (EuclideanSpace.single a (1:ℝ))| := hs5
      rw [← hy, hJ]
      have hn0 : ‖fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))‖ ≠ 0 :=
        (lt_of_lt_of_le hm (hnormpos _ hyV)).ne'
      have hd0 : |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
          (EuclideanSpace.single a (1:ℝ))| ≠ 0 := abs_ne_zero.mpr hax
      have hc0 : sbgbAreaConst ≠ 0 := hc.ne'
      field_simp
    
    have hb : MeasureTheory.IntegrableOn
        (fun x : Fin 2 → ℝ => ψ (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) /
          |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
            (EuclideanSpace.single a (1:ℝ))|)
        {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} := by
      have hfin : (MeasureTheory.volume.restrict {x : Fin 2 → ℝ |
          (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
            (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E})
            Set.univ ≠ ⊤ := by
        rw [MeasureTheory.Measure.restrict_apply_univ]
        exact ((hWtb.subset hEW).measure_lt_top).ne
      have hc1 : AEMeasurable (fun x : Fin 2 → ℝ =>
          Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
          (MeasureTheory.volume.restrict {x : Fin 2 → ℝ |
            (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
              (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) ''
                Metric.ball y₀ r}) :=
        hWtc.aemeasurable hWto.measurableSet
      have hc2 := hc1.mono_measure (MeasureTheory.Measure.restrict_mono hEW le_rfl)
      have hm3 : Measurable (fun z : E3 => ψ z / |fderiv ℝ f z (EuclideanSpace.single a (1:ℝ))|) :=
        hψ.div (continuous_abs.measurable.comp (measurable_fderiv_apply_const ℝ f _))
      have hmeas := (hm3.comp_aemeasurable hc2).aestronglyMeasurable
      have hbound : ∀ᵐ x ∂((MeasureTheory.volume.restrict {x : Fin 2 → ℝ |
          (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
            (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E}).restrict
              Set.univ),
          ‖((fun z : E3 => ψ z / |fderiv ℝ f z (EuclideanSpace.single a (1:ℝ))|) ∘
            (fun x : Fin 2 → ℝ => Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))) x‖
            ≤ B / m := by
        rw [MeasureTheory.Measure.restrict_univ]
        refine MeasureTheory.ae_restrict_of_forall_mem hEt (fun x hx => ?_)
        obtain ⟨y, hyE, hyx⟩ := hx
        have hyV := hEV hyE
        have hXi : Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)) = y := by
          rw [← hyx]; exact hΞ y hyV
        show ‖ψ (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x))) /
            |fderiv ℝ f (Ξ ((EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x)))
              (EuclideanSpace.single a (1:ℝ))|‖ ≤ B / m
        rw [hXi, Real.norm_eq_abs, abs_div, abs_abs]
        have hmy := hmV y hyV
        have hBy := hB y hyE
        have hB0 : 0 ≤ B := (abs_nonneg _).trans hBy
        calc |ψ y| / |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))|
            ≤ B / |fderiv ℝ f y (EuclideanSpace.single a (1:ℝ))| :=
              div_le_div_of_nonneg_right hBy (abs_nonneg _)
          _ ≤ B / m := div_le_div_of_nonneg_left hB0 hm hmy
      have := MeasureTheory.Measure.integrableOn_of_bounded hfin hmeas hbound
      rw [MeasureTheory.IntegrableOn, MeasureTheory.Measure.restrict_univ] at this
      exact this
    
    have hg := hgraph a _ hWto H hH' _ hEt hEW (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)) hgfm
    have himgH : (fun x => smthLift a x (H x)) ''
        {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} =
        E ∩ f ⁻¹' {t} := by
      rw [hHeq]; exact himg
    have hint : MeasureTheory.IntegrableOn (fun x => Real.sqrt (1 + ∑ k : Fin 2, smthGrad H x k ^ 2) /
        sbgbAreaConst * (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)) (smthLift a x (H x)))
        {x : Fin 2 → ℝ | (EuclideanSpace.equiv (Fin 3) ℝ).symm (Fin.insertNth a t x) ∈
          (fun y : EuclideanSpace ℝ (Fin 3) => y + (f y - y a) • EuclideanSpace.single a (1:ℝ)) '' E} :=
      hb.congr_fun (fun x hx => (hpt x hx).symm) hEt
    have hC1 := hg.1.mpr hint
    rw [himgH] at hC1
    have hC2 := hg.2
    rw [himgH] at hC2
    refine ⟨hC1, ?_⟩
    rw [hC2]
    exact MeasureTheory.setIntegral_congr_fun hEt (fun x hx => hpt x hx)
  
  refine ⟨fun t => (hslice t).1, ?_, ?_⟩
  · refine hFint.congr (Filter.Eventually.of_forall fun t => ?_)
    exact (hslice t).2.symm
  · refine hCV.trans (hFeq.trans ?_)
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
    exact (hslice t).2.symm

theorem euclid_coarea_compact (hloc : ∀ (U : Set E3), IsOpen U → ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ y₀ ∈ U,
      fderiv ℝ f y₀ ≠ 0 → ∃ V : Set E3, IsOpen V ∧ y₀ ∈ V ∧ V ⊆ U ∧
      ∀ (E : Set E3) (ψ : E3 → ℝ) (B : ℝ), MeasurableSet E → E ⊆ V → Measurable ψ →
        (∀ y ∈ E, |ψ y| ≤ B) →
        (∀ t : ℝ, MeasureTheory.IntegrableOn (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
          (E ∩ f ⁻¹' {t}) (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
        MeasureTheory.Integrable (fun t : ℝ => ∫ y in E ∩ f ⁻¹' {t},
          ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
        ∫ y in E, ψ y = ∫ t : ℝ, ∫ y in E ∩ f ⁻¹' {t},
          ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)))
    (U : Set E3) (hU : IsOpen U) (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (Kc : Set E3)
    (hKc : IsCompact Kc) (hKU : Kc ⊆ U) (hdK : ∀ y ∈ Kc, fderiv ℝ f y ≠ 0) (ψ : E3 → ℝ)
    (hψ : ContinuousOn ψ Kc) :
    (∀ t : ℝ, MeasureTheory.IntegrableOn (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
      (Kc ∩ f ⁻¹' {t}) (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
    MeasureTheory.Integrable (fun t : ℝ => ∫ y in Kc ∩ f ⁻¹' {t},
      ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
    ∫ y in Kc, ψ y = ∫ t : ℝ, ∫ y in Kc ∩ f ⁻¹' {t},
      ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) :=
by
  classical
  
  have hKcl : IsClosed Kc := hKc.isClosed
  have hKm : MeasurableSet Kc := hKcl.measurableSet
  have hfc : ContinuousOn f Kc := hf.continuousOn.mono hKU
  have hSt : ∀ t : ℝ, MeasurableSet (Kc ∩ f ⁻¹' {t}) := fun t =>
    (hfc.preimage_isClosed_of_isClosed hKcl isClosed_singleton).measurableSet
  have hBt : ∀ B : Set E3, B ⊆ Kc → MeasurableSet B → ∀ t : ℝ,
      MeasurableSet (B ∩ f ⁻¹' {t}) := by
    intro B hB hBm t
    have h : B ∩ f ⁻¹' {t} = B ∩ (Kc ∩ f ⁻¹' {t}) := by
      ext x
      constructor
      · rintro ⟨h1, h2⟩
        exact ⟨h1, hB h1, h2⟩
      · rintro ⟨h1, _, h2⟩
        exact ⟨h1, h2⟩
    rw [h]
    exact hBm.inter (hSt t)
  obtain ⟨B₀, hB₀⟩ := hKc.exists_bound_of_continuousOn hψ
  let ψt : E3 → ℝ := Kc.piecewise ψ (fun _ => 0)
  have hψt_eq : ∀ y ∈ Kc, ψt y = ψ y := fun y hy => Set.piecewise_eq_of_mem _ _ _ hy
  have hψt_meas : Measurable ψt := hψ.measurable_piecewise continuousOn_const hKm
  have hψt_bd : ∀ y ∈ Kc, |ψt y| ≤ B₀ := by
    intro y hy
    rw [hψt_eq y hy, ← Real.norm_eq_abs]
    exact hB₀ y hy
  have hψt_int : MeasureTheory.IntegrableOn ψt Kc :=
    (hψ.integrableOn_compact hKc).congr_fun (fun y hy => (hψt_eq y hy).symm) hKm
  let F : E3 → ℝ := fun y => ψt y * (sbgbAreaConst / ‖fderiv ℝ f y‖)
  let G : Set E3 → Prop := fun E =>
    (∀ t : ℝ, MeasureTheory.IntegrableOn F (E ∩ f ⁻¹' {t})
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
    MeasureTheory.Integrable (fun t : ℝ => ∫ y in E ∩ f ⁻¹' {t}, F y
      ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
    ∫ y in E, ψt y = ∫ t : ℝ, ∫ y in E ∩ f ⁻¹' {t}, F y
      ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))
  
  have hG0 : G ∅ := by
    refine ⟨fun t => ?_, ?_, ?_⟩
    · rw [Set.empty_inter]
      exact MeasureTheory.integrableOn_empty
    · simp only [Set.empty_inter, MeasureTheory.Measure.restrict_empty,
        MeasureTheory.integral_zero_measure]
      exact MeasureTheory.integrable_zero _ _ _
    · simp only [Set.empty_inter, MeasureTheory.Measure.restrict_empty,
        MeasureTheory.integral_zero_measure, MeasureTheory.integral_zero]
  
  have hglue : ∀ A B : Set E3, A ⊆ Kc → B ⊆ Kc → MeasurableSet B → Disjoint A B →
      G A → G B → G (A ∪ B) := by
    intro A B hA hB hBm hAB hGA hGB
    obtain ⟨hA1, hA2, hA3⟩ := hGA
    obtain ⟨hB1, hB2, hB3⟩ := hGB
    have hsplit : ∀ t : ℝ, (A ∪ B) ∩ f ⁻¹' {t} = (A ∩ f ⁻¹' {t}) ∪ (B ∩ f ⁻¹' {t}) :=
      fun t => Set.union_inter_distrib_right _ _ _
    have hdisj : ∀ t : ℝ, Disjoint (A ∩ f ⁻¹' {t}) (B ∩ f ⁻¹' {t}) :=
      fun t => hAB.mono Set.inter_subset_left Set.inter_subset_left
    have hfun : (fun t : ℝ => ∫ y in (A ∪ B) ∩ f ⁻¹' {t}, F y
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) =
        fun t => (∫ y in A ∩ f ⁻¹' {t}, F y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) +
          ∫ y in B ∩ f ⁻¹' {t}, F y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
      funext t
      rw [hsplit t, MeasureTheory.setIntegral_union (hdisj t) (hBt B hB hBm t) (hA1 t) (hB1 t)]
    refine ⟨fun t => ?_, ?_, ?_⟩
    · rw [hsplit t]
      exact (hA1 t).union (hB1 t)
    · rw [hfun]
      exact hA2.add hB2
    · rw [hfun, MeasureTheory.integral_add hA2 hB2, ← hA3, ← hB3]
      exact MeasureTheory.setIntegral_union hAB hBm (hψt_int.mono_set hA) (hψt_int.mono_set hB)
  
  choose V hVo hxV hVU hVP using
    fun x (hx : x ∈ Kc) => hloc U hU f hf x (hKU hx) (hdK x hx)
  obtain ⟨T, hT⟩ := hKc.elim_nhds_subcover' V (fun x hx => (hVo x hx).mem_nhds (hxV x hx))
  
  have hind : ∀ s : Finset Kc, G (Kc ∩ ⋃ x ∈ s, V x.1 x.2) := by
    intro s
    refine Finset.induction_on s ?_ ?_
    · have h : Kc ∩ ⋃ x ∈ (∅ : Finset Kc), V x.1 x.2 = ∅ := by simp
      rw [h]
      exact hG0
    · intro a s _ ih
      have hW : IsOpen (⋃ x ∈ s, V x.1 x.2) := isOpen_biUnion fun x _ => hVo x.1 x.2
      have hset : Kc ∩ ⋃ x ∈ insert a s, V x.1 x.2 =
          (Kc ∩ ⋃ x ∈ s, V x.1 x.2) ∪ ((Kc ∩ V a.1 a.2) \ ⋃ x ∈ s, V x.1 x.2) := by
        rw [Finset.set_biUnion_insert]
        ext y
        simp only [Set.mem_inter_iff, Set.mem_union, Set.mem_diff]
        tauto
      rw [hset]
      have hBsub : (Kc ∩ V a.1 a.2) \ ⋃ x ∈ s, V x.1 x.2 ⊆ Kc := fun y hy => hy.1.1
      have hBm : MeasurableSet ((Kc ∩ V a.1 a.2) \ ⋃ x ∈ s, V x.1 x.2) :=
        (hKm.inter (hVo a.1 a.2).measurableSet).diff hW.measurableSet
      refine hglue _ _ Set.inter_subset_left hBsub hBm ?_ ih ?_
      · exact Set.disjoint_left.2 fun y hyA hyB => hyB.2 hyA.2
      · exact hVP a.1 a.2 _ ψt B₀ hBm (fun y hy => hy.1.2) hψt_meas
          (fun y hy => hψt_bd y (hBsub hy))
  have hGK : G Kc := by
    have h := hind T
    rwa [Set.inter_eq_left.2 hT] at h
  obtain ⟨h1, h2, h3⟩ := hGK
  
  have hEq : ∀ t : ℝ, Set.EqOn F (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
      (Kc ∩ f ⁻¹' {t}) := by
    intro t y hy
    show ψt y * (sbgbAreaConst / ‖fderiv ℝ f y‖) = ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)
    rw [hψt_eq y hy.1]
  have hfun : (fun t : ℝ => ∫ y in Kc ∩ f ⁻¹' {t}, F y
      ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) =
      fun t : ℝ => ∫ y in Kc ∩ f ⁻¹' {t}, ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖)
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
    funext t
    exact MeasureTheory.setIntegral_congr_fun (hSt t) (hEq t)
  refine ⟨fun t => (h1 t).congr_fun (hEq t) (hSt t), ?_, ?_⟩
  · rw [← hfun]
    exact h2
  · rw [← hfun, ← h3]
    exact MeasureTheory.setIntegral_congr_fun hKm (fun y hy => (hψt_eq y hy).symm)

theorem chart_coarea_term [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (hcomp : ∀ (U : Set E3), IsOpen U → ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ (Kc : Set E3),
      IsCompact Kc → Kc ⊆ U → (∀ y ∈ Kc, fderiv ℝ f y ≠ 0) → ∀ (ψ : E3 → ℝ),
      ContinuousOn ψ Kc →
      (∀ t : ℝ, MeasureTheory.IntegrableOn (fun y => ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖))
        (Kc ∩ f ⁻¹' {t}) (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
      MeasureTheory.Integrable (fun t : ℝ => ∫ y in Kc ∩ f ⁻¹' {t},
        ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))) ∧
      ∫ y in Kc, ψ y = ∫ t : ℝ, ∫ y in Kc ∩ f ⁻¹' {t},
        ψ y * (sbgbAreaConst / ‖fderiv ℝ f y‖) ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)))
    (g : RiemannianMetric3 M) (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (q : M)
    (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ)
    (hφs : IsCompact (tsupport φ) ∧ tsupport φ ⊆ (chartAt E3 q).source)
    (Ω : Set M) (hΩ : IsCompact Ω) (A : Set ℝ) (hA : IsCompact A)
    (hreg : ∀ p ∈ Ω, u p ∈ A → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0)
    (w : M → ℝ) (hw : ContinuousOn (fun y => w ((chartAt E3 q).symm y))
      {y | y ∈ (chartAt E3 q).target ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm y) ≠ 0})
    (h : M → ℝ) (hh : ∀ p ∈ Ω, u p ∈ A → h p = w p * Real.sqrt (g.gradInner u u p)) :
    MeasureTheory.IntegrableOn (fun t => ∫ y in chartAt E3 q '' (Ω ∩ u ⁻¹' {t} ∩ (chartAt E3 q).source),
