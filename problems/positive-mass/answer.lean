    rintro S y ⟨p, ⟨hpS, hps⟩, rfl⟩
    exact ⟨p, hpS, hps, rfl, (chartAt E3 q).left_inv hps, (chartAt E3 q).map_source hps⟩
  have hmeasImg : ∀ C : Set M, IsClosed C →
      MeasurableSet (chartAt E3 q '' (C ∩ (chartAt E3 q).source)) := by
    intro C hC
    have heq : chartAt E3 q '' (C ∩ (chartAt E3 q).source) =
        (chartAt E3 q).target \ ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' Cᶜ) := by
      rw [(chartAt E3 q).image_eq_target_inter_inv_preimage Set.inter_subset_right]
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff, Set.mem_compl_iff, not_and,
        not_not]
      constructor
      · rintro ⟨hy, hC', _⟩
        exact ⟨hy, fun _ => hC'⟩
      · rintro ⟨hy, h'⟩
        exact ⟨hy, h' hy, (chartAt E3 q).map_target hy⟩
