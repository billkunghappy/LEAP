      exact hstep w a b F ε M hε hεε₀ hM hw hwb hcoef heq t s K ht hts hs hP)
  have hHval : 4000 * (A₀ * M) * (((1 : ℝ) - 1 / 2) ^ 3)⁻¹ = 32000 * A₀ * M := by
    rw [show ((1 : ℝ) - 1 / 2) ^ 3 = 1 / 8 by norm_num]
    ring
  rw [hHval] at hiter
  
  have hH0 : 0 ≤ 32000 * A₀ * M := by positivity
  have hw2 : ContDiffOn ℝ 2 w (Metric.ball 0 (1 / 2)) :=
