  have hmin2 : min δ s ≤ s := min_le_right _ _
  have hmin0 : 0 < min δ s := lt_min hδ (by linarith)
  have hρ0 : 0 < ρ := by rw [hρ]; linarith
  have hρδ : ρ < δ := by rw [hρ]; linarith
  have hρs : ρ < s := by rw [hρ]; linarith
  have hdiam : ∀ x, x ∉ O → ∀ y ∈ K, ρ < ‖x - y‖ := by
    intro x hxO y hy
