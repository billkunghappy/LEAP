  rintro x ⟨⟨z, hz, rfl⟩, hxK⟩
  exact (hiffE z hz).2 ((hCK₂ z hz).1 hxK)

theorem graph_minimal_chart [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (q p : M) (a : Fin 3) (U : E3 → ℝ) (hU : ContDiff ℝ ∞ U) (W : Set E3) (hW : IsOpen W)
    (hWt : W ⊆ (chartAt E3 q).target) (hp : p ∈ (chartAt E3 q).source)
    (hpW : chartAt E3 q p ∈ W)
    (hpg : (chartAt E3 q p) a = U (coordPlaneProj a (chartAt E3 q p)))
    (hMSE : ∀ z ∈ W, z a = U (coordPlaneProj a z) →
      levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun w => w a - U (coordPlaneProj a w)) z
        = 0)
    (O : Set M) (hO : O ∈ 𝓝 p) :
    ∃ (V : Set M) (f : M → ℝ), V ⊆ O ∧ IsOpen V ∧ p ∈ V ∧
      (∀ x ∈ V, x ∈ (chartAt E3 q).source ∧ chartAt E3 q x ∈ W) ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      (∀ x ∈ V, f x = 0 ↔ (chartAt E3 q x) a = U (coordPlaneProj a (chartAt E3 q x))) ∧
      (∀ x ∈ V, f x = 0 → g.levelMeanCurv f x = 0) ∧
      IsPreconnected (V ∩ {x | 0 < f x}) ∧ IsPreconnected (V ∩ {x | f x < 0}) :=
by
  classical
  set κ := chartAt E3 q with hκ
  
  have hpadd : ∀ x y : E3, coordPlaneProj a (x + y) = coordPlaneProj a x + coordPlaneProj a y := by
    intro x y
    simp only [coordPlaneProj, PiLp.add_apply, add_smul]
    abel
  have hpsmul : ∀ (r : ℝ) (x : E3), coordPlaneProj a (r • x) = r • coordPlaneProj a x := by
    intro r x
    simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, smul_sub, mul_smul]
  have hplin : IsLinearMap ℝ (coordPlaneProj a) := ⟨hpadd, hpsmul⟩
  let Lp : E3 →L[ℝ] E3 := LinearMap.toContinuousLinearMap (IsLinearMap.mk' _ hplin)
  have hLp : ∀ z, Lp z = coordPlaneProj a z := fun z => rfl
  have hpcd : ContDiff ℝ ∞ (coordPlaneProj a) := Lp.contDiff
  have hPc : Continuous (coordPlaneProj a) := hpcd.continuous
  have hUc : Continuous U := hU.continuous
  have hea : (e a) a = 1 := by simp [e]
  have hPa : ∀ w : E3, (coordPlaneProj a w) a = 0 := by
    intro w
    simp only [coordPlaneProj, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, hea, mul_one,
      sub_self]
  have hPe : coordPlaneProj a (e a) = 0 := by
    simp only [coordPlaneProj, hea, one_smul, sub_self]
  have hrec : ∀ z : E3, coordPlaneProj a z + (z a) • e a = z := by
    intro z
    simp only [coordPlaneProj, sub_add_cancel]
  have hPP : ∀ (w : E3) (c : ℝ),
      coordPlaneProj a (coordPlaneProj a w + c • e a) = coordPlaneProj a w := by
    intro w c
    rw [hpadd, hpsmul, hPe, smul_zero, add_zero]
    simp only [coordPlaneProj, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, hea, mul_one,
      sub_self, zero_smul, sub_zero]
  have hPcoord : ∀ (w : E3) (c : ℝ), (coordPlaneProj a w + c • e a) a = c := by
    intro w c
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hPa, hea, mul_one, zero_add]
  have hPsub : ∀ z z₀ : E3, coordPlaneProj a z - coordPlaneProj a z₀ + (z a - z₀ a) • e a
      = z - z₀ := by
    intro z z₀
    conv_rhs => rw [← hrec z, ← hrec z₀]
    rw [sub_smul]
    abel
  have hea1 : ‖e a‖ = 1 := by
    simp [e, EuclideanSpace.norm_single]
  have hcoord : Continuous (fun w : E3 => w a) := by fun_prop
  
  set h : E3 → ℝ := fun w => w a - U (coordPlaneProj a w) with hhdef
  have hh : ContDiff ℝ ∞ h := by
    have h1 : ContDiff ℝ ∞ (fun w : E3 => w a) :=
      (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff
    exact h1.sub (hU.comp hpcd)
  have hda : ∀ z, fderiv ℝ h z (e a) = 1 := by
    intro z
    have hd1 : HasFDerivAt (fun w : E3 => w a) (EuclideanSpace.proj a : E3 →L[ℝ] ℝ) z :=
      (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).hasFDerivAt
    have hUd : DifferentiableAt ℝ U (Lp z) := (hU.contDiffAt).differentiableAt (by simp)
    have hd2 : HasFDerivAt (fun w => U (Lp w)) ((fderiv ℝ U (Lp z)).comp Lp) z :=
      hUd.hasFDerivAt.comp z Lp.hasFDerivAt
    have h3 : fderiv ℝ h z = (EuclideanSpace.proj a : E3 →L[ℝ] ℝ) - (fderiv ℝ U (Lp z)).comp Lp :=
      (hd1.sub hd2).fderiv
    rw [h3]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.coe_comp', Function.comp_apply,
      hLp, hPe, map_zero, sub_zero]
    simp [e]
  have hdne : ∀ z, fderiv ℝ h z ≠ 0 := by
    intro z H
    have := hda z
    rw [H] at this
    simp at this
  
  obtain ⟨χ, -, hχ⟩ := (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) p).mem_iff.1
    (κ.open_source.mem_nhds hp)
  set f : M → ℝ := fun x => χ x * h (κ x) with hfdef
  have hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
    apply contMDiff_of_tsupport
    intro x hx
    have hx' : x ∈ κ.source := hχ (tsupport_mul_subset_left hx)
    have h1 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ κ x :=
      contMDiffOn_chart.contMDiffAt (κ.open_source.mem_nhds hx')
    have h2 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => h (κ y)) x :=
      (hh.contMDiff.contMDiffAt).comp x h1
    exact (χ.contMDiff.contMDiffAt).mul h2
  set V₁ : Set M := interior {x | χ x = 1} with hV₁def
  have hV₁o : IsOpen V₁ := isOpen_interior
  have hpV₁ : p ∈ V₁ := mem_interior_iff_mem_nhds.2 χ.eventuallyEq_one
  have hfV₁ : ∀ x ∈ V₁, f x = h (κ x) := by
    intro x hx
    have h1' : x ∈ {x : M | χ x = 1} := interior_subset hx
    have h1 : χ x = 1 := h1'
    simp only [hfdef, h1, one_mul]
  
  set E : Set E3 := W ∩ (κ.target ∩ κ.symm ⁻¹' (V₁ ∩ interior O)) with hEdef
  have hEo : IsOpen E :=
    hW.inter (κ.continuousOn_symm.isOpen_inter_preimage κ.open_target
      (hV₁o.inter isOpen_interior))
  set z₀ : E3 := κ p with hz₀def
  have hz₀E : z₀ ∈ E := by
    refine ⟨hpW, κ.map_source hp, ?_⟩
    show κ.symm (κ p) ∈ V₁ ∩ interior O
    rw [κ.left_inv hp]
    exact ⟨hpV₁, mem_interior_iff_mem_nhds.2 hO⟩
  have hstar : ∀ z ∈ E, z ∈ W ∧ z ∈ κ.target ∧ κ.symm z ∈ interior O ∧
      f (κ.symm z) = h z := by
    intro z hz
    obtain ⟨hzW, hzt, hzV, hzO⟩ := hz
    refine ⟨hzW, hzt, hzO, ?_⟩
    rw [hfV₁ _ hzV, κ.right_inv hzt]
  
  obtain ⟨ε, hε, hballE⟩ := Metric.isOpen_iff.1 hEo z₀ hz₀E
  obtain ⟨r', hr', hcont⟩ := Metric.continuousAt_iff.1
    (hUc.continuousAt (x := coordPlaneProj a z₀)) (ε / 2) (by positivity)
  set δ : ℝ := ε / 2 with hδdef
  have hδ : 0 < δ := by positivity
  set r : ℝ := min r' δ with hrdef
  have hr : 0 < r := lt_min hr' hδ
  have hUb : ∀ y : E3, ‖y - coordPlaneProj a z₀‖ < r → |U y - z₀ a| < δ := by
    intro y hy
    have h1 : dist y (coordPlaneProj a z₀) < r' := by
      rw [dist_eq_norm]; exact lt_of_lt_of_le hy (min_le_left _ _)
    have h2 := hcont h1
    rw [Real.dist_eq] at h2
    rw [hpg]
    exact h2
  set C : Set E3 := {z : E3 | ‖coordPlaneProj a z - coordPlaneProj a z₀‖ < r ∧
    |z a - z₀ a| < δ} with hCdef
  have hCo : IsOpen C :=
    (isOpen_lt (hPc.sub continuous_const).norm continuous_const).inter
      (isOpen_lt (hcoord.sub continuous_const).abs continuous_const)
  have hCE : C ⊆ E := by
    intro z hz
    apply hballE
    rw [Metric.mem_ball, dist_eq_norm, ← hPsub z z₀]
    calc ‖coordPlaneProj a z - coordPlaneProj a z₀ + (z a - z₀ a) • e a‖
        ≤ ‖coordPlaneProj a z - coordPlaneProj a z₀‖ + ‖(z a - z₀ a) • e a‖ := norm_add_le _ _
      _ = ‖coordPlaneProj a z - coordPlaneProj a z₀‖ + |z a - z₀ a| := by
          rw [norm_smul, hea1, mul_one, Real.norm_eq_abs]
      _ < r + δ := add_lt_add hz.1 hz.2
      _ ≤ δ + δ := by linarith [min_le_right r' δ]
      _ = ε := by rw [hδdef]; ring
  
  set V : Set M := κ.source ∩ κ ⁻¹' C with hVdef
  have hVo : IsOpen V := κ.isOpen_inter_preimage hCo
  have hz₀C : z₀ ∈ C := by
    refine ⟨?_, ?_⟩
    · rw [sub_self, norm_zero]; exact hr
    · rw [sub_self, abs_zero]; exact hδ
  have hpV : p ∈ V := ⟨hp, hz₀C⟩
  have hVprop : ∀ x ∈ V, x ∈ κ.source ∧ κ x ∈ C ∧ κ x ∈ W ∧ x ∈ interior O ∧
      f x = h (κ x) := by
    intro x hx
    obtain ⟨hxs, hxC⟩ := hx
    obtain ⟨h1, -, h3, h4⟩ := hstar _ (hCE hxC)
    rw [κ.left_inv hxs] at h3 h4
    exact ⟨hxs, hxC, h1, h3, h4⟩
  have hVO : V ⊆ O := fun x hx => interior_subset (hVprop x hx).2.2.2.1
  have hgerm : ∀ x ∈ V, ∀ᶠ z in 𝓝 (κ x), f (κ.symm z) = h z := by
    intro x hx
    exact Filter.eventually_of_mem (hEo.mem_nhds (hCE (hVprop x hx).2.1))
      (fun z hz => (hstar z hz).2.2.2)
  have hzero : ∀ x ∈ V, f x = 0 ↔ (κ x) a = U (coordPlaneProj a (κ x)) := by
    intro x hx
    rw [(hVprop x hx).2.2.2.2, hhdef, sub_eq_zero]
  
  have hmf : ∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 := by
    intro x hx H
    have hxs : x ∈ κ.source := (hVprop x hx).1
    have hy : κ x ∈ κ.target := κ.map_source hxs
    have hfd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f (κ.symm (κ x)) :=
      hf.mdifferentiableAt (by simp)
    have hsd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ.symm (κ x) :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hc := mfderiv_comp (κ x) hfd hsd
    have H' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f (κ.symm (κ x)) = 0 := by
      rw [κ.left_inv hxs]; exact H
    rw [H', ContinuousLinearMap.zero_comp] at hc
    have hev : (f ∘ κ.symm) =ᶠ[𝓝 (κ x)] h := hgerm x hx
    rw [hev.mfderiv_eq, mfderiv_eq_fderiv] at hc
    exact hdne _ hc
  
  have hmc : ∀ x ∈ V, f x = 0 → g.levelMeanCurv f x = 0 := by
    intro x hx hfx
    have hxs : x ∈ κ.source := (hVprop x hx).1
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      PartialDiffeomorph.mk κ.symm.toPartialEquiv κ.open_target κ.open_source
        contMDiffOn_chart_symm contMDiffOn_chart
    have hl := levelMeanCurv_eq_coord g Φ f h hf (κ x) (κ.map_source hxs) (hgerm x hx)
    have e1 : Φ (κ x) = x := κ.left_inv hxs
    have e2 : g.coeff Φ = g.coeff κ.symm := rfl
    rw [e1, e2] at hl
    rw [hl]
    exact hMSE _ (hVprop x hx).2.2.1 ((hzero x hx).1 hfx)
  
  set D : Set E3 := {x : E3 | ‖coordPlaneProj a x - coordPlaneProj a z₀‖ < r} with hDdef
  have hDc : IsPreconnected (D ×ˢ Set.Ioo (0 : ℝ) 1) := by
    have hD : D = coordPlaneProj a ⁻¹' Metric.ball (coordPlaneProj a z₀) r := by
      ext x
      simp only [hDdef, Set.mem_setOf_eq, Set.mem_preimage, Metric.mem_ball, dist_eq_norm]
    have hDconv : Convex ℝ D := by
      rw [hD]; exact (convex_ball _ _).is_linear_preimage hplin
    exact hDconv.isPreconnected.prod isPreconnected_Ioo
  set Cp : Set E3 := {z : E3 | (‖coordPlaneProj a z - coordPlaneProj a z₀‖ < r ∧
    |z a - z₀ a| < δ) ∧ U (coordPlaneProj a z) < z a} with hCpdef
  set Cm : Set E3 := {z : E3 | (‖coordPlaneProj a z - coordPlaneProj a z₀‖ < r ∧
    |z a - z₀ a| < δ) ∧ z a < U (coordPlaneProj a z)} with hCmdef
  have hCpc : IsPreconnected Cp := by
    let Ψ : E3 × ℝ → E3 := fun xs => coordPlaneProj a xs.1 +
      (U (coordPlaneProj a xs.1) + xs.2 * (z₀ a + δ - U (coordPlaneProj a xs.1))) • e a
    have hΨc : Continuous Ψ := by
      have h1 : Continuous (fun xs : E3 × ℝ => coordPlaneProj a xs.1) := hPc.comp continuous_fst
      have h2 : Continuous (fun xs : E3 × ℝ => U (coordPlaneProj a xs.1)) := hUc.comp h1
      exact h1.add ((h2.add (continuous_snd.mul (continuous_const.sub h2))).smul
        continuous_const)
    have himg : Ψ '' (D ×ˢ Set.Ioo (0 : ℝ) 1) = Cp := by
      ext z
      constructor
      · rintro ⟨⟨x, s⟩, ⟨hx, hs0, hs1⟩, rfl⟩
        have hx' : ‖coordPlaneProj a x - coordPlaneProj a z₀‖ < r := hx
        have hb := abs_lt.1 (hUb (coordPlaneProj a x) hx')
        have hd : 0 < z₀ a + δ - U (coordPlaneProj a x) := by linarith
        have hsd : 0 < s * (z₀ a + δ - U (coordPlaneProj a x)) := mul_pos hs0 hd
        have hsd' : s * (z₀ a + δ - U (coordPlaneProj a x)) <
            z₀ a + δ - U (coordPlaneProj a x) := by nlinarith
        show (‖coordPlaneProj a (Ψ (x, s)) - coordPlaneProj a z₀‖ < r ∧
          |(Ψ (x, s)) a - z₀ a| < δ) ∧ U (coordPlaneProj a (Ψ (x, s))) < (Ψ (x, s)) a
        simp only [Ψ, hPP, hPcoord]
        refine ⟨⟨hx', ?_⟩, by linarith⟩
        rw [abs_lt]
        constructor <;> linarith
      · rintro ⟨⟨hz1, hz2⟩, hz3⟩
        have hb := abs_lt.1 (hUb (coordPlaneProj a z) hz1)
        have hz2' := abs_lt.1 hz2
        have hd : 0 < z₀ a + δ - U (coordPlaneProj a z) := by linarith
        refine ⟨(z, (z a - U (coordPlaneProj a z)) / (z₀ a + δ - U (coordPlaneProj a z))),
          ⟨hz1, div_pos (by linarith) hd, (div_lt_one hd).2 (by linarith)⟩, ?_⟩
        show coordPlaneProj a z + (U (coordPlaneProj a z) +
          (z a - U (coordPlaneProj a z)) / (z₀ a + δ - U (coordPlaneProj a z)) *
            (z₀ a + δ - U (coordPlaneProj a z))) • e a = z
        rw [div_mul_cancel₀ _ hd.ne', add_sub_cancel, hrec]
    rw [← himg]
    exact hDc.image _ hΨc.continuousOn
  have hCmc : IsPreconnected Cm := by
    let Ψ : E3 × ℝ → E3 := fun xs => coordPlaneProj a xs.1 +
      (U (coordPlaneProj a xs.1) - xs.2 * (U (coordPlaneProj a xs.1) - (z₀ a - δ))) • e a
    have hΨc : Continuous Ψ := by
      have h1 : Continuous (fun xs : E3 × ℝ => coordPlaneProj a xs.1) := hPc.comp continuous_fst
      have h2 : Continuous (fun xs : E3 × ℝ => U (coordPlaneProj a xs.1)) := hUc.comp h1
      exact h1.add ((h2.sub (continuous_snd.mul (h2.sub continuous_const))).smul
        continuous_const)
    have himg : Ψ '' (D ×ˢ Set.Ioo (0 : ℝ) 1) = Cm := by
      ext z
      constructor
      · rintro ⟨⟨x, s⟩, ⟨hx, hs0, hs1⟩, rfl⟩
        have hx' : ‖coordPlaneProj a x - coordPlaneProj a z₀‖ < r := hx
        have hb := abs_lt.1 (hUb (coordPlaneProj a x) hx')
        have hd : 0 < U (coordPlaneProj a x) - (z₀ a - δ) := by linarith
        have hsd : 0 < s * (U (coordPlaneProj a x) - (z₀ a - δ)) := mul_pos hs0 hd
        have hsd' : s * (U (coordPlaneProj a x) - (z₀ a - δ)) <
            U (coordPlaneProj a x) - (z₀ a - δ) := by nlinarith
        show (‖coordPlaneProj a (Ψ (x, s)) - coordPlaneProj a z₀‖ < r ∧
          |(Ψ (x, s)) a - z₀ a| < δ) ∧ (Ψ (x, s)) a < U (coordPlaneProj a (Ψ (x, s)))
        simp only [Ψ, hPP, hPcoord]
        refine ⟨⟨hx', ?_⟩, by linarith⟩
        rw [abs_lt]
        constructor <;> linarith
      · rintro ⟨⟨hz1, hz2⟩, hz3⟩
        have hb := abs_lt.1 (hUb (coordPlaneProj a z) hz1)
        have hz2' := abs_lt.1 hz2
        have hd : 0 < U (coordPlaneProj a z) - (z₀ a - δ) := by linarith
        refine ⟨(z, (U (coordPlaneProj a z) - z a) / (U (coordPlaneProj a z) - (z₀ a - δ))),
          ⟨hz1, div_pos (by linarith) hd, (div_lt_one hd).2 (by linarith)⟩, ?_⟩
        show coordPlaneProj a z + (U (coordPlaneProj a z) -
          (U (coordPlaneProj a z) - z a) / (U (coordPlaneProj a z) - (z₀ a - δ)) *
            (U (coordPlaneProj a z) - (z₀ a - δ))) • e a = z
        rw [div_mul_cancel₀ _ hd.ne', sub_sub_cancel, hrec]
    rw [← himg]
    exact hDc.image _ hΨc.continuousOn
  have hCpC : Cp ⊆ C := fun z hz => hz.1
  have hCmC : Cm ⊆ C := fun z hz => hz.1
  have hCt : C ⊆ κ.target := fun z hz => (hstar z (hCE hz)).2.1
  have hsideP : V ∩ {x | 0 < f x} = κ.symm '' Cp := by
    ext x
    constructor
    · rintro ⟨hxV, hfx⟩
      obtain ⟨hxs, hxC, -, -, hfe⟩ := hVprop x hxV
      have hfx' : 0 < h (κ x) := hfe ▸ hfx
      have hfx'' : 0 < (κ x) a - U (coordPlaneProj a (κ x)) := hfx'
      exact ⟨κ x, ⟨hxC, by linarith⟩, κ.left_inv hxs⟩
    · rintro ⟨z, hz, rfl⟩
      have hzt : z ∈ κ.target := hCt (hCpC hz)
      have hxV : κ.symm z ∈ V := by
        refine ⟨κ.map_target hzt, ?_⟩
        rw [Set.mem_preimage, κ.right_inv hzt]
        exact hCpC hz
      refine ⟨hxV, ?_⟩
      show 0 < f (κ.symm z)
      rw [(hstar z (hCE (hCpC hz))).2.2.2]
      show 0 < z a - U (coordPlaneProj a z)
      linarith [hz.2]
  have hsideM : V ∩ {x | f x < 0} = κ.symm '' Cm := by
    ext x
    constructor
    · rintro ⟨hxV, hfx⟩
      obtain ⟨hxs, hxC, -, -, hfe⟩ := hVprop x hxV
      have hfx' : h (κ x) < 0 := hfe ▸ hfx
      have hfx'' : (κ x) a - U (coordPlaneProj a (κ x)) < 0 := hfx'
      exact ⟨κ x, ⟨hxC, by linarith⟩, κ.left_inv hxs⟩
    · rintro ⟨z, hz, rfl⟩
      have hzt : z ∈ κ.target := hCt (hCmC hz)
      have hxV : κ.symm z ∈ V := by
        refine ⟨κ.map_target hzt, ?_⟩
        rw [Set.mem_preimage, κ.right_inv hzt]
        exact hCmC hz
      refine ⟨hxV, ?_⟩
      show f (κ.symm z) < 0
      rw [(hstar z (hCE (hCmC hz))).2.2.2]
      show z a - U (coordPlaneProj a z) < 0
      linarith [hz.2]
  refine ⟨V, f, hVO, hVo, hpV, fun x hx => ⟨(hVprop x hx).1, (hVprop x hx).2.2.1⟩, hf, hmf,
    hzero, hmc, ?_, ?_⟩
  · rw [hsideP]
    exact hCpc.image _ (κ.continuousOn_symm.mono (hCpC.trans hCt))
  · rw [hsideM]
    exact hCmc.image _ (κ.continuousOn_symm.mono (hCmC.trans hCt))

theorem sepIsMinimalSurfaceSet_of_chart_graphs [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (S : Set M) (hS : IsClosed S)
    (hgraph : ∀ p ∈ S, ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧
      ContDiff ℝ ∞ u ∧ u (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a ∧
      sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ,
        ((chartAt E3 p).symm z ∈ S ↔ z a = u (sepPlaneProj a z))) ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ, z a = u (sepPlaneProj a z) →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun w => w a - u (sepPlaneProj a w)) z = 0)) :
    IsMinimalSurfaceSet g S :=
by
  refine ⟨hS, fun p hp O hO => ?_⟩
  obtain ⟨a, u, r, δ, hr, hδ, hu, hu0, hcyl, hiff, hmse⟩ := hgraph p hp
  have hcoord : Continuous (fun w : E3 => w a) := by fun_prop
  have hproj_cont : Continuous (sepPlaneProj a) := by
    unfold sepPlaneProj
    exact continuous_id.sub (hcoord.smul continuous_const)
  have hWo : IsOpen (sepCyl a (chartAt E3 p p) r δ) :=
    (isOpen_lt (continuous_norm.comp (hproj_cont.comp (continuous_id.sub continuous_const)))
      continuous_const).inter
      (isOpen_lt (continuous_abs.comp (hcoord.sub continuous_const)) continuous_const)
  have hps : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hpW : chartAt E3 p p ∈ sepCyl a (chartAt E3 p p) r δ := by
    refine ⟨?_, ?_⟩
    · simp [sepPlaneProj, hr]
    · simp [hδ]
  obtain ⟨V, f, hVO, hVo, hpV, hVW, hf, hdf, hfz, hH, hP, hN⟩ :=
    graph_minimal_chart g p p a u hu (sepCyl a (chartAt E3 p p) r δ) hWo hcyl hps hpW
      hu0.symm hmse O hO
  refine ⟨V, f, hVO, hVo, hpV, hf, hdf, ?_, hH, hP, hN⟩
  ext x
  constructor
  · rintro ⟨hxV, hxS⟩
    refine ⟨hxV, ?_⟩
    obtain ⟨hxs, hxW⟩ := hVW x hxV
    show f x = 0
    rw [hfz x hxV]
    have hS' : (chartAt E3 p).symm (chartAt E3 p x) ∈ S := by
      rw [(chartAt E3 p).left_inv hxs]; exact hxS
    exact (hiff _ hxW).1 hS'
  · rintro ⟨hxV, hx0⟩
    refine ⟨hxV, ?_⟩
    obtain ⟨hxs, hxW⟩ := hVW x hxV
    have h : (chartAt E3 p x) a = u (sepPlaneProj a (chartAt E3 p x)) := (hfz x hxV).1 hx0
    have h2 := (hiff _ hxW).2 h
    rwa [(chartAt E3 p).left_inv hxs] at h2

theorem minimalSurfaceSet_sepChartNull [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (S : Set M) (hS : IsMinimalSurfaceSet g S) : sepChartNull S :=
by
  
  have s1 : ∀ (Z : Set E3) (a : Fin 3), MeasurableSet Z →
      (∀ x : E3, Set.Subsingleton {t : ℝ | x + t • e a ∈ Z}) → volume Z = 0 := by
    intro Z a hZ hline
    let T₁ : E3 ≃ᵐ (Fin 3 → ℝ) := (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm
    have h₁ : MeasurePreserving T₁ volume volume :=
      EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3)
    let T₂ : (Fin 3 → ℝ) ≃ᵐ ℝ × (Fin 2 → ℝ) :=
      MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) a
    have h₂ : MeasurePreserving T₂ volume (volume.prod volume) := by
      have := MeasureTheory.measurePreserving_piFinSuccAbove
        (fun _ : Fin 3 => (volume : Measure ℝ)) a
      simpa only [volume_pi] using this
    let Ψ := T₁.trans T₂
    have hΨ : MeasurePreserving Ψ volume (volume.prod volume) := h₂.comp h₁
    have hW : MeasurableSet (Ψ.symm ⁻¹' Z) := Ψ.symm.measurable hZ
    have hZW : Z = Ψ ⁻¹' (Ψ.symm ⁻¹' Z) := by
      ext z; simp
    rw [hZW, hΨ.measure_preimage_equiv, Measure.prod_apply_symm hW]
    have key : ∀ x' : Fin 2 → ℝ, (fun t => (t, x')) ⁻¹' (Ψ.symm ⁻¹' Z) =
        {t | (WithLp.toLp 2 (Fin.insertNth a 0 x') : E3) + t • e a ∈ Z} := by
      intro x'
      ext t
      simp only [Set.mem_preimage, Set.mem_setOf_eq]
      have hsymm : Ψ.symm (t, x') = (WithLp.toLp 2 (Fin.insertNth a t x') : E3) := by
        show T₁.symm (T₂.symm (t, x')) = _
        simp only [T₁, T₂, MeasurableEquiv.symm_symm, MeasurableEquiv.piFinSuccAbove_symm_apply]
        rfl
      have hsplit : (WithLp.toLp 2 (Fin.insertNth a t x') : E3) =
          (WithLp.toLp 2 (Fin.insertNth a 0 x') : E3) + t • e a := by
        ext i
        rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨j, rfl⟩
        · simp [EuclideanSpace.single_apply]
        · simp [EuclideanSpace.single_apply, Fin.succAbove_ne]
      rw [hsymm, hsplit]
    simp_rw [key]
    have h0 : ∀ x' : Fin 2 → ℝ,
        volume {t | (WithLp.toLp 2 (Fin.insertNth a 0 x') : E3) + t • e a ∈ Z} = 0 :=
      fun x' => (hline _).measure_zero _
    simp [h0]
  
  have s4 : ∀ (U : Set E3) (h : E3 → ℝ), IsOpen U → ContDiffOn ℝ 1 h U → ∀ y₀ ∈ U,
      fderiv ℝ h y₀ ≠ 0 →
      ∃ (a : Fin 3) (r : ℝ), 0 < r ∧ Metric.ball y₀ r ⊆ U ∧
        MeasurableSet (Metric.ball y₀ r ∩ h ⁻¹' {0}) ∧
        ∀ x : E3, Set.Subsingleton {t : ℝ | x + t • e a ∈ Metric.ball y₀ r ∩ h ⁻¹' {0}} := by
    intro U h hU hh y₀ hy₀ hd
    have ha : ∃ a, fderiv ℝ h y₀ (e a) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hd
      have hL : ((fderiv ℝ h y₀ : E3 →L[ℝ] ℝ) : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by simpa using hcon i)
      exact ContinuousLinearMap.coe_injective (by simpa using hL)
    obtain ⟨a, ha⟩ := ha
    have hcont : ContinuousOn (fun y => fderiv ℝ h y (e a)) U :=
      (hh.continuousOn_fderiv_of_isOpen hU le_rfl).clm_apply continuousOn_const
    have hev : ∀ᶠ y in 𝓝 y₀, fderiv ℝ h y (e a) ≠ 0 :=
      (hcont.continuousAt (hU.mem_nhds hy₀)).eventually_ne ha
    obtain ⟨r, hr, hrsub⟩ := Metric.mem_nhds_iff.1 (inter_mem hev (hU.mem_nhds hy₀))
    refine ⟨a, r, hr, fun y hy => (hrsub hy).2, ?_, ?_⟩
    · have hcB : ContinuousOn h (ball y₀ r) := hh.continuousOn.mono (fun y hy => (hrsub hy).2)
      have ho := hcB.isOpen_inter_preimage isOpen_ball
        (isOpen_compl_singleton : IsOpen ({(0:ℝ)}ᶜ))
      have hset : ball y₀ r ∩ h ⁻¹' {0} = ball y₀ r \ (ball y₀ r ∩ h ⁻¹' ({(0:ℝ)}ᶜ)) := by
        ext y
        simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_preimage, Set.mem_compl_iff]
        tauto
      rw [hset]
      exact measurableSet_ball.diff ho.measurableSet
    · intro x t₁ ht₁ t₂ ht₂
      by_contra hne
      have main : ∀ s₁ s₂ : ℝ, s₁ < s₂ → x + s₁ • e a ∈ ball y₀ r ∩ h ⁻¹' {0} →
          x + s₂ • e a ∈ ball y₀ r ∩ h ⁻¹' {0} → False := by
        intro s₁ s₂ hs h1 h2
        have hne' : s₂ - s₁ ≠ 0 := (sub_pos.2 hs).ne'
        have hseg : ∀ t ∈ Set.Icc s₁ s₂, x + t • e a ∈ ball y₀ r := by
          intro t ht
          have hθ0 : 0 ≤ (t - s₁) / (s₂ - s₁) := div_nonneg (by linarith [ht.1]) (by linarith)
          have hθ1 : (t - s₁) / (s₂ - s₁) ≤ 1 := by
            rw [div_le_one (by linarith)]; linarith [ht.2]
          have hmem := (convex_ball y₀ r).add_smul_sub_mem h1.1 h2.1 ⟨hθ0, hθ1⟩
          convert hmem using 1
          rw [show x + s₂ • e a - (x + s₁ • e a) = (s₂ - s₁) • e a by rw [sub_smul]; abel]
          rw [smul_smul, add_assoc, ← add_smul]
          congr 2
          field_simp
          ring
        have hder : ∀ t ∈ Set.Icc s₁ s₂,
            HasDerivAt (fun t => h (x + t • e a)) (fderiv ℝ h (x + t • e a) (e a)) t := by
          intro t ht
          have hyU : x + t • e a ∈ U := (hrsub (hseg t ht)).2
          have hdiff : DifferentiableAt ℝ h (x + t • e a) :=
            (hh.contDiffAt (hU.mem_nhds hyU)).differentiableAt one_ne_zero
          have hl : HasDerivAt (fun t : ℝ => x + t • e a) (e a) t := by
            simpa using ((hasDerivAt_id t).smul_const (e a)).const_add x
          exact hdiff.hasFDerivAt.comp_hasDerivAt t hl
        obtain ⟨c, hc, hc0⟩ := exists_hasDerivAt_eq_zero hs
          (fun t ht => (hder t ht).continuousAt.continuousWithinAt)
          (by
            show h (x + s₁ • e a) = h (x + s₂ • e a)
            rw [Set.mem_singleton_iff.1 h1.2, Set.mem_singleton_iff.1 h2.2])
          (fun t ht => hder t (Set.Ioo_subset_Icc_self ht))
        exact (hrsub (hseg c (Set.Ioo_subset_Icc_self hc))).1 hc0
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · exact main _ _ hlt ht₁ ht₂
      · exact main _ _ hlt ht₂ ht₁
  
  have s3 : ∀ (p x : M) (f : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      x ∈ (chartAt E3 p).source → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 →
      ContDiffOn ℝ 1 (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p).target ∧
        fderiv ℝ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p x) ≠ 0 := by
    intro p x f hf hx hdf
    have hC : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
      have h1 := hf.comp_contMDiffOn (contMDiffOn_chart_symm (x := p) (n := ∞) (I := 𝓘(ℝ, E3)))
      exact contMDiffOn_iff_contDiffOn.mp h1
    refine ⟨hC.of_le (by exact_mod_cast le_top), ?_⟩
    intro h0
    apply hdf
    have hφx : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hx
    have hdh : DifferentiableAt ℝ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p x) :=
      (hC.contDiffAt ((chartAt E3 p).open_target.mem_nhds hφx)).differentiableAt (by simp)
    have heq : (fun y => f ((chartAt E3 p).symm y)) ∘ (chartAt E3 p) =ᶠ[𝓝 x] f := by
      filter_upwards [(chartAt E3 p).open_source.mem_nhds hx] with z hz
      simp [(chartAt E3 p).left_inv hz]
    rw [← heq.mfderiv_eq]
    have hφd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) x :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hx
    rw [mfderiv_comp x (mdifferentiableAt_iff_differentiableAt.2 hdh) hφd, mfderiv_eq_fderiv, h0]
    exact ContinuousLinearMap.zero_comp _
  
  intro p
  apply measure_null_of_locally_null
  rintro y ⟨x, ⟨hxS, hxs⟩, rfl⟩
  obtain ⟨V, f, -, hVo, hxV, hf, hdf, hVS, -⟩ :=
    hS.2 x hxS (chartAt E3 p).source ((chartAt E3 p).open_source.mem_nhds hxs)
  obtain ⟨hC, hne⟩ := s3 p x f hf hxs (hdf x hxV)
  have hUo : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' V) :=
    (chartAt E3 p).isOpen_inter_preimage_symm hVo
  have hxU : chartAt E3 p x ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' V :=
    ⟨(chartAt E3 p).map_source hxs, by
      show (chartAt E3 p).symm (chartAt E3 p x) ∈ V
      rw [(chartAt E3 p).left_inv hxs]; exact hxV⟩
  obtain ⟨a, r, hr, hBU, hBm, hline⟩ := s4 _ (fun y => f ((chartAt E3 p).symm y)) hUo
    (hC.mono Set.inter_subset_left) (chartAt E3 p x) hxU hne
  have hZ := s1 _ a hBm hline
  refine ⟨chartAt E3 p '' (S ∩ (chartAt E3 p).source) ∩ ball (chartAt E3 p x) r,
    inter_mem_nhdsWithin _ (ball_mem_nhds _ hr), ?_⟩
  refine measure_mono_null ?_ hZ
  rintro z ⟨⟨w, ⟨hwS, hws⟩, rfl⟩, hzB⟩
  refine ⟨hzB, ?_⟩
  have hwV : w ∈ V := by
    have h1 : (chartAt E3 p).symm (chartAt E3 p w) ∈ V := (hBU hzB).2
    rwa [(chartAt E3 p).left_inv hws] at h1
  have hw0 : w ∈ V ∩ f ⁻¹' {0} := hVS ▸ ⟨hwV, hwS⟩
  show f ((chartAt E3 p).symm (chartAt E3 p w)) ∈ ({0} : Set ℝ)
  rw [(chartAt E3 p).left_inv hws]
  exact hw0.2

theorem minimalSurfaceSet_local_eq_of_subset [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (S Sig : Set M) (hS : IsMinimalSurfaceSet g S)
    (hSig : IsMinimalSurfaceSet g Sig) (p : M) (hp : p ∈ S) (V : Set M) (hV : V ∈ 𝓝 p)
    (hVS : V ∩ S ⊆ Sig) : ∃ V' ∈ 𝓝 p, V' ∩ Sig ⊆ S :=
by
  
  have hext : ∀ (u : M → ℝ) (x : M),
      (IsLocalMin u x → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x = 0) ∧
      (IsLocalMax u x → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x = 0) := by
    intro u x
    by_cases hd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x
    · have hw : writtenInExtChartAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) x u =
          u ∘ (extChartAt 𝓘(ℝ, E3) x).symm := by
        funext y
        simp [writtenInExtChartAt]
      have hc : ContinuousAt (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) :=
        continuousAt_extChartAt_symm x
      have hinv : (extChartAt 𝓘(ℝ, E3) x).symm (extChartAt 𝓘(ℝ, E3) x x) = x :=
        extChartAt_to_inv x
      rw [hd.mfderiv, hw, ModelWithCorners.range_eq_univ, fderivWithin_univ]
      constructor
      · intro hmin
        rw [← hinv] at hmin
        exact (hmin.comp_continuous hc).fderiv_eq_zero
      · intro hmax
        rw [← hinv] at hmax
        exact (hmax.comp_continuous hc).fderiv_eq_zero
    · exact ⟨fun _ => mfderiv_zero_of_not_mdifferentiableAt hd,
        fun _ => mfderiv_zero_of_not_mdifferentiableAt hd⟩
  have fermat : ∀ (u : M → ℝ) (x : M), mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0 →
      ∀ N ∈ 𝓝 x, (∃ y ∈ N, u y < u x) ∧ (∃ y ∈ N, u x < u y) := by
    intro u x hu N hN
    constructor
    · by_contra hcon
      push_neg at hcon
      exact hu ((hext u x).1 (Filter.mem_of_superset hN fun y hy => hcon y hy))
    · by_contra hcon
      push_neg at hcon
      exact hu ((hext u x).2 (Filter.mem_of_superset hN fun y hy => hcon y hy))
  
  have hpV : p ∈ V := mem_of_mem_nhds hV
  have hpSig : p ∈ Sig := hVS ⟨hpV, hp⟩
  obtain ⟨V₁, f, hV₁V, hV₁o, hpV₁, hf, hdf, hV₁S, -, -, -⟩ := hS.2 p hp V hV
  obtain ⟨V₂, h, hV₂V₁, hV₂o, hpV₂, hh, hdh, hV₂Sig, -, hP, hQ⟩ :=
    hSig.2 p hpSig V₁ (hV₁o.mem_nhds hpV₁)
  have memS : ∀ x ∈ V₁, x ∈ S ↔ f x = 0 := by
    intro x hx
    constructor
    · intro h'
      have h'' : x ∈ V₁ ∩ S := ⟨hx, h'⟩
      rw [hV₁S] at h''
      exact h''.2
    · intro h'
      have h'' : x ∈ V₁ ∩ f ⁻¹' {0} := ⟨hx, h'⟩
      rw [← hV₁S] at h''
      exact h''.2
  have memSig : ∀ x ∈ V₂, x ∈ Sig ↔ h x = 0 := by
    intro x hx
    constructor
    · intro h'
      have h'' : x ∈ V₂ ∩ Sig := ⟨hx, h'⟩
      rw [hV₂Sig] at h''
      exact h''.2
    · intro h'
      have h'' : x ∈ V₂ ∩ h ⁻¹' {0} := ⟨hx, h'⟩
      rw [← hV₂Sig] at h''
      exact h''.2
  have fp0 : f p = 0 := (memS p hpV₁).1 hp
  have hside : ∀ x ∈ V₂, h x ≠ 0 → f x ≠ 0 := by
    intro x hx hx0 hfx
    have hxV₁ : x ∈ V₁ := hV₂V₁ hx
    have hxS : x ∈ S := (memS x hxV₁).2 hfx
    have hxSig : x ∈ Sig := hVS ⟨hV₁V hxV₁, hxS⟩
    exact hx0 ((memSig x hx).1 hxSig)
  have hhloc : ∀ x ∈ V₂, ∀ N ∈ 𝓝 x, (∃ y ∈ N, h y < h x) ∧ (∃ y ∈ N, h x < h y) :=
    fun x hx N hN => fermat h x (hdh x hx) N hN
  
  have main : ∀ f' : M → ℝ, Continuous f' → (∀ x ∈ V₂, h x ≠ 0 → f' x ≠ 0) →
      (∃ y ∈ V₂, f' y < 0) → ∀ x ∈ V₂, h x = 0 → ¬ (0 < f' x) := by
    intro f' hf' hside' ⟨y, hyV₂, hy⟩ x hxV₂ hx0 hfx
    have hAo : IsOpen {z : M | 0 < f' z} := isOpen_lt continuous_const hf'
    have hBo : IsOpen {z : M | f' z < 0} := isOpen_lt hf' continuous_const
    have hAB : Disjoint {z : M | 0 < f' z} {z : M | f' z < 0} := by
      rw [Set.disjoint_left]
      intro z hz1 hz2
      have h1 : 0 < f' z := hz1
      have h2 : f' z < 0 := hz2
      linarith
    have hcov : ∀ T : Set M, T ⊆ V₂ → (∀ z ∈ T, h z ≠ 0) →
        T ⊆ {z : M | 0 < f' z} ∪ {z : M | f' z < 0} := by
      intro T hT hT0 z hz
      rcases lt_or_gt_of_ne (hside' z (hT hz) (hT0 z hz)) with h1 | h1
      · exact Or.inr h1
      · exact Or.inl h1
    have hPs := hP.subset_or_subset hAo hBo hAB
      (hcov _ Set.inter_subset_left (fun z hz => ne_of_gt hz.2))
    have hQs := hQ.subset_or_subset hAo hBo hAB
      (hcov _ Set.inter_subset_left (fun z hz => ne_of_lt hz.2))
    have hUx : V₂ ∩ {z : M | 0 < f' z} ∈ 𝓝 x := (hV₂o.inter hAo).mem_nhds ⟨hxV₂, hfx⟩
    obtain ⟨⟨z, hzU, hz⟩, ⟨z', hz'U, hz'⟩⟩ := hhloc x hxV₂ _ hUx
    rw [hx0] at hz hz'
    have hPA : V₂ ∩ {z : M | 0 < h z} ⊆ {z : M | 0 < f' z} := by
      rcases hPs with h1 | h1
      · exact h1
      · exfalso
        have h2 : f' z' < 0 := h1 ⟨hz'U.1, hz'⟩
        have h3 : 0 < f' z' := hz'U.2
        linarith
    have hQA : V₂ ∩ {z : M | h z < 0} ⊆ {z : M | 0 < f' z} := by
      rcases hQs with h1 | h1
      · exact h1
      · exfalso
        have h2 : f' z < 0 := h1 ⟨hzU.1, hz⟩
        have h3 : 0 < f' z := hzU.2
        linarith
    have hUy : V₂ ∩ {z : M | f' z < 0} ∈ 𝓝 y := (hV₂o.inter hBo).mem_nhds ⟨hyV₂, hy⟩
    obtain ⟨⟨w, hwU, hw⟩, ⟨w', hw'U, hw'⟩⟩ := hhloc y hyV₂ _ hUy
    by_cases hhy : h y ≤ 0
    · have h2 : 0 < f' w := hQA ⟨hwU.1, lt_of_lt_of_le hw hhy⟩
      have h3 : f' w < 0 := hwU.2
      linarith
    · push_neg at hhy
      have h2 : 0 < f' w' := hPA ⟨hw'U.1, lt_trans hhy hw'⟩
      have h3 : f' w' < 0 := hw'U.2
      linarith
  have hfc : Continuous f := hf.continuous
  obtain ⟨⟨y₁, hy₁V₂, hy₁⟩, ⟨y₂, hy₂V₂, hy₂⟩⟩ :=
    fermat f p (hdf p hpV₁) V₂ (hV₂o.mem_nhds hpV₂)
  rw [fp0] at hy₁ hy₂
  have hzero : ∀ x ∈ V₂, h x = 0 → f x = 0 := by
    intro x hxV₂ hx0
    have n1 := main f hfc hside ⟨y₁, hy₁V₂, hy₁⟩ x hxV₂ hx0
    have n2 := main (fun z => -f z) hfc.neg
      (fun z hz hz0 => neg_ne_zero.mpr (hside z hz hz0))
      ⟨y₂, hy₂V₂, by simp only; linarith⟩ x hxV₂ hx0
    simp only [neg_pos] at n2
    push_neg at n1 n2
    linarith
  refine ⟨V₂, hV₂o.mem_nhds hpV₂, ?_⟩
  rintro x ⟨hxV₂, hxSig⟩
  exact (memS x (hV₂V₁ hxV₂)).2 (hzero x hxV₂ ((memSig x hxV₂).1 hxSig))

theorem hullRiemPer_cut_transfer [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (F U A B C K₂ : Set M) (hA : IsClosed A) (hB : IsClosed B)
    (hC : IsClosed C) (hAB : Disjoint A B) (hBC : Disjoint B C) (hFC : F ⊆ C) (hAK : A ⊆ K₂) :
    hullRiemPer g F U (A ∪ B) ≤ hullRiemPer g F U K₂ :=
by
  
  
  have hposdef : ∀ (p : M) (y : E3), y ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro p y hy
    classical
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have s1 : ∀ (P Q : Set E3), IsClosed P → IsClosed Q → Disjoint P Q →
      ∃ χ : E3 → ℝ, ContDiff ℝ ∞ χ ∧ (∀ y, 0 ≤ χ y ∧ χ y ≤ 1) ∧
        (∀ y ∈ P, ∀ᶠ z in 𝓝 y, χ z = 1) ∧ (∀ y ∈ Q, ∀ᶠ z in 𝓝 y, χ z = 0) := by
    intro P Q hP hQ hPQ
    obtain ⟨f, hf0, hf1, hf01⟩ :=
      exists_contMDiffMap_zero_one_nhds_of_isClosed 𝓘(ℝ, E3) (n := ⊤) hQ hP hPQ.symm
    refine ⟨f, ?_, fun y => ⟨(hf01 y).1, (hf01 y).2⟩, ?_, ?_⟩
    · exact contMDiff_iff_contDiff.mp f.contMDiff
    · exact eventually_nhdsSet_iff_forall.mp hf1
    · exact eventually_nhdsSet_iff_forall.mp hf0
  
  have germ : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Y Z : E3 → E3) (y : E3),
      (∀ᶠ z in 𝓝 y, Y z = Z z) → sepDensDiv G Y y = sepDensDiv G Z y := by
    intro G Y Z y hy
    unfold sepDensDiv
    refine Finset.sum_congr rfl fun i _ => ?_
    unfold partialDeriv
    have hev : (fun z => Real.sqrt (G z).det * Y z i) =ᶠ[𝓝 y]
        (fun z => Real.sqrt (G z).det * Z z i) := by
      filter_upwards [hy] with z hz
      rw [hz]
    rw [hev.fderiv_eq]
  have divZero : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3),
      sepDensDiv G (fun _ => (0 : E3)) y = 0 := by
    intro G y
    unfold sepDensDiv partialDeriv
    simp
  
  have prodRule : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (χ : E3 → ℝ) (y : E3),
      (∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * X z i) y) →
      DifferentiableAt ℝ χ y →
      sepDensDiv G (fun z => χ z • X z) y = χ y * sepDensDiv G X y +
        ∑ i : Fin 3, partialDeriv i χ y * (Real.sqrt (G y).det * X y i) := by
    intro G X χ y hh hχ
    unfold sepDensDiv
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hfun : (fun z => Real.sqrt (G z).det * (χ z • X z) i) =
        fun z => χ z * (Real.sqrt (G z).det * X z i) := by
      funext z
      show Real.sqrt (G z).det * (χ z * X z i) = _
      ring
    unfold partialDeriv
    rw [hfun, fderiv_fun_mul hχ (hh i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hsm : ∀ (q : M) (X : E3 → E3) (y : E3), y ∈ (chartAt E3 q).target →
      ContDiffAt ℝ ∞ X y → ∀ i : Fin 3,
        ContDiffAt ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det * X z i) y := by
    intro q X y hy hX i
    have hG : ∀ a b : Fin 3, ContDiffAt ℝ ∞ (fun z => g.coeff (chartAt E3 q).symm z a b) y :=
      fun a b => (g.smooth q a b).contDiffAt ((chartAt E3 q).open_target.mem_nhds hy)
    have hdet : ContDiffAt ℝ ∞ (fun z => (g.coeff (chartAt E3 q).symm z).det) y := by
      simp only [Matrix.det_fin_three]
      have h00 := hG 0 0
      have h01 := hG 0 1
      have h02 := hG 0 2
      have h10 := hG 1 0
      have h11 := hG 1 1
      have h12 := hG 1 2
      have h20 := hG 2 0
      have h21 := hG 2 1
      have h22 := hG 2 2
      fun_prop
    have hpos : 0 < (g.coeff (chartAt E3 q).symm y).det := (hposdef q y hy).det_pos
    have hsq : ContDiffAt ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det) y :=
      hdet.sqrt hpos.ne'
    have hXi : ContDiffAt ℝ ∞ (fun z => X z i) y :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.contDiffAt.comp y hX
    exact hsq.mul hXi
  
  unfold hullRiemPer
  refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun h =>
    Finset.sum_le_sum fun k _ => ?_
  unfold hullPerG
  refine iSup₂_le fun X hX => ?_
  obtain ⟨hXs, hXc, hXU, hXn, Cb, hCb⟩ := hX
  have hTt : tsupport X ⊆ (chartAt E3 (p k)).target := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hXU hy
    exact (chartAt E3 (p k)).map_source ((h.1 k).2 hx).2
  have hS : IsCompact ((chartAt E3 (p k)).symm '' tsupport X) :=
    hXc.image_of_continuousOn ((chartAt E3 (p k)).continuousOn_symm.mono hTt)
  have hSs : (chartAt E3 (p k)).symm '' tsupport X ⊆ (chartAt E3 (p k)).source := by
    rintro _ ⟨y, hy, rfl⟩
    exact (chartAt E3 (p k)).map_target (hTt hy)
  have hPc : IsCompact ((chartAt E3 (p k)) '' (B ∩ (chartAt E3 (p k)).symm '' tsupport X)) :=
    (hS.inter_left hB).image_of_continuousOn
      ((chartAt E3 (p k)).continuousOn.mono (Set.inter_subset_right.trans hSs))
  have hQc : IsCompact
      ((chartAt E3 (p k)) '' ((A ∪ C) ∩ (chartAt E3 (p k)).symm '' tsupport X)) :=
    (hS.inter_left (hA.union hC)).image_of_continuousOn
      ((chartAt E3 (p k)).continuousOn.mono (Set.inter_subset_right.trans hSs))
  have hQP : Disjoint
      ((chartAt E3 (p k)) '' ((A ∪ C) ∩ (chartAt E3 (p k)).symm '' tsupport X))
      ((chartAt E3 (p k)) '' (B ∩ (chartAt E3 (p k)).symm '' tsupport X)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨x₁, ⟨hx₁AC, hx₁S⟩, rfl⟩ ⟨x₂, ⟨hx₂B, hx₂S⟩, hx⟩
    have hx12 : x₂ = x₁ := (chartAt E3 (p k)).injOn (hSs hx₂S) (hSs hx₁S) hx
    rw [hx12] at hx₂B
    rcases hx₁AC with hxA | hxC
    · exact Set.disjoint_left.mp hAB hxA hx₂B
    · exact Set.disjoint_left.mp hBC hx₂B hxC
  have hmem : ∀ (S : Set M) (y : E3), y ∈ tsupport X →
      y ∈ (chartAt E3 (p k)) '' (S ∩ (chartAt E3 (p k)).source) →
      y ∈ (chartAt E3 (p k)) '' (S ∩ (chartAt E3 (p k)).symm '' tsupport X) := by
    rintro S _ hyT ⟨x, ⟨hxS, hxs⟩, rfl⟩
    exact ⟨x, ⟨hxS, (chartAt E3 (p k)) x, hyT, (chartAt E3 (p k)).left_inv hxs⟩, rfl⟩
  obtain ⟨χ, hχ, hχb, hχQ, hχP⟩ := s1 _ _ hQc.isClosed hPc.isClosed hQP
  
  have hclass : ∀ y ∈ tsupport X, (∀ᶠ z in 𝓝 y, χ z = 0) ∨ (∀ᶠ z in 𝓝 y, χ z = 1) ∨
      y ∉ (chartAt E3 (p k)) '' ((A ∪ B) ∩ (chartAt E3 (p k)).source) := by
    intro y hyT
    by_cases hyB : y ∈ (chartAt E3 (p k)) '' (B ∩ (chartAt E3 (p k)).source)
    · exact Or.inl (hχP y (hmem B y hyT hyB))
    by_cases hyAC : y ∈ (chartAt E3 (p k)) '' ((A ∪ C) ∩ (chartAt E3 (p k)).source)
    · exact Or.inr (Or.inl (hχQ y (hmem _ y hyT hyAC)))
    refine Or.inr (Or.inr ?_)
    rintro ⟨x, ⟨hxA | hxB, hxs⟩, rfl⟩
    · exact hyAC ⟨x, ⟨Or.inl hxA, hxs⟩, rfl⟩
    · exact hyB ⟨x, ⟨hxB, hxs⟩, rfl⟩
  
  obtain ⟨X', hX'⟩ : ∃ X' : E3 → E3, ∀ y, X' y = χ y • X y :=
    ⟨fun y => χ y • X y, fun _ => rfl⟩
  have hX'f : X' = fun z => χ z • X z := funext hX'
  have hz0 : ∀ y, (∀ᶠ z in 𝓝 y, χ z = 0) → X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
    intro y hy
    filter_upwards [hy] with z hz
    rw [hX' z, hz, zero_smul]
  have hz1 : ∀ y, (∀ᶠ z in 𝓝 y, χ z = 1) → ∀ᶠ z in 𝓝 y, X' z = X z := by
    intro y hy
    filter_upwards [hy] with z hz
    rw [hX' z, hz, one_smul]
  have hzT : ∀ y, y ∉ tsupport X → X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
    intro y hy
    have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    filter_upwards [h0] with z hz
    rw [hX' z, hz, Pi.zero_apply, smul_zero]
  
  have hc : ∀ y, y ∉ (chartAt E3 (p k)) '' (K₂ ∩ (chartAt E3 (p k)).source) →
      ContDiffAt ℝ ∞ X' y := by
    intro y hy
    by_cases hyT : y ∈ tsupport X
    · by_cases hyB : y ∈ (chartAt E3 (p k)) '' (B ∩ (chartAt E3 (p k)).source)
      · exact contDiffAt_const.congr_of_eventuallyEq (hz0 y (hχP y (hmem B y hyT hyB)))
      · have hK1 : y ∉ (chartAt E3 (p k)) '' ((A ∪ B) ∩ (chartAt E3 (p k)).source) := by
          rintro ⟨x, ⟨hxA | hxB, hxs⟩, rfl⟩
          · exact hy ⟨x, ⟨hAK hxA, hxs⟩, rfl⟩
          · exact hyB ⟨x, ⟨hxB, hxs⟩, rfl⟩
        rw [hX'f]
        exact hχ.contDiffAt.smul (hXs y hK1)
    · exact contDiffAt_const.congr_of_eventuallyEq (hzT y hyT)
  
  have hsupp : Function.support X' ⊆ Function.support X := by
    intro y hy h0
    apply hy
    rw [hX' y, h0, smul_zero]
  have hb : HasCompactSupport X' := hXc.mono hsupp
  have hcU : tsupport X' ⊆ (chartAt E3 (p k)) '' W k := (closure_mono hsupp).trans hXU
  
  have hd : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      g.coeff (chartAt E3 (p k)).symm y i j * X' y i * X' y j ≤ 1 := by
    intro y
    have hs := hXn y
    have hcomp : ∀ i, X' y i = χ y * X y i := by
      intro i
      rw [hX' y]
      rfl
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3,
        g.coeff (chartAt E3 (p k)).symm y i j * X' y i * X' y j =
        (χ y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (p k)).symm y i j * X y i * X y j := by
      simp only [hcomp, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [e1]
    obtain ⟨h0, h1⟩ := hχb y
    have h2 := mul_le_mul_of_nonneg_left hs (sq_nonneg (χ y))
    nlinarith
  
  have hC0 : 0 ≤ Cb := (abs_nonneg _).trans (hCb 0)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : E3 → ℝ, ∀ y, ψ y = ∑ i : Fin 3, partialDeriv i χ y *
      (Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det * X y i) :=
    ⟨_, fun _ => rfl⟩
  have hZo : IsOpen {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 0} := isOpen_setOf_eventually_nhds
  have hIo : IsOpen {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 1} := isOpen_setOf_eventually_nhds
  have hRc : IsCompact (tsupport X \
      ({y : E3 | ∀ᶠ z in 𝓝 y, χ z = 0} ∪ {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 1})) :=
    hXc.diff (hZo.union hIo)
  have hRsm : ∀ y ∈ tsupport X \
      ({y : E3 | ∀ᶠ z in 𝓝 y, χ z = 0} ∪ {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 1}),
      ContDiffAt ℝ ∞ X y ∧ y ∈ (chartAt E3 (p k)).target := by
    rintro y ⟨hyT, hyZI⟩
    refine ⟨?_, hTt hyT⟩
    rcases hclass y hyT with h0 | h1 | hK1
    · exact absurd (Or.inl h0) hyZI
    · exact absurd (Or.inr h1) hyZI
    · exact hXs y hK1
  have hψc : ContinuousOn ψ (tsupport X \
      ({y : E3 | ∀ᶠ z in 𝓝 y, χ z = 0} ∪ {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 1})) := by
    intro y hy
    obtain ⟨hXy, hyt⟩ := hRsm y hy
    apply ContinuousAt.continuousWithinAt
    rw [show ψ = fun y => ∑ i : Fin 3, partialDeriv i χ y *
      (Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det * X y i) from funext hψ]
    simp only [Fin.sum_univ_three]
    have hpd : ∀ i : Fin 3, ContinuousAt (fun y => partialDeriv i χ y) y := fun i =>
      ((hχ.continuous_fderiv (by simp)).clm_apply continuous_const).continuousAt
    have hhc : ∀ i : Fin 3, ContinuousAt
        (fun y => Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det * X y i) y :=
      fun i => (hsm (p k) X y hyt hXy i).continuousAt
    exact (((hpd 0).mul (hhc 0)).add ((hpd 1).mul (hhc 1))).add ((hpd 2).mul (hhc 2))
  obtain ⟨Mb, hMb⟩ := hRc.exists_bound_of_continuousOn hψc
  have hf : ∃ C' : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X' y| ≤ C' := by
    refine ⟨Cb + |Mb|, fun y => ?_⟩
    by_cases hyT : y ∈ tsupport X
    · by_cases hyZ : ∀ᶠ z in 𝓝 y, χ z = 0
      · rw [germ _ X' _ y (hz0 y hyZ), divZero, abs_zero]
        linarith [abs_nonneg Mb]
      by_cases hyI : ∀ᶠ z in 𝓝 y, χ z = 1
      · rw [germ _ X' X y (hz1 y hyI)]
        linarith [hCb y, abs_nonneg Mb]
      have hyR : y ∈ tsupport X \
          ({y : E3 | ∀ᶠ z in 𝓝 y, χ z = 0} ∪ {y : E3 | ∀ᶠ z in 𝓝 y, χ z = 1}) := by
        refine ⟨hyT, ?_⟩
        rintro (h0 | h1)
        · exact hyZ h0
        · exact hyI h1
      obtain ⟨hXy, hyt⟩ := hRsm y hyR
      have hdiff : ∀ i : Fin 3, DifferentiableAt ℝ
          (fun z => Real.sqrt (g.coeff (chartAt E3 (p k)).symm z).det * X z i) y :=
        fun i => (hsm (p k) X y hyt hXy i).differentiableAt (by simp)
      rw [hX'f, prodRule _ X χ y hdiff (hχ.contDiffAt.differentiableAt (by simp)), ← hψ y]
      have h1 := hMb y hyR
      rw [Real.norm_eq_abs] at h1
      have h2 := hCb y
      obtain ⟨hχ0, hχ1⟩ := hχb y
      have h3 := mul_le_mul_of_nonneg_right hχ1
        (abs_nonneg (sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y))
      calc |χ y * sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y + ψ y|
          ≤ |χ y * sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y| + |ψ y| :=
            abs_add_le _ _
        _ = χ y * |sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y| + |ψ y| := by
            rw [abs_mul, abs_of_nonneg hχ0]
        _ ≤ Cb + |Mb| := by linarith [le_abs_self Mb]
    · rw [germ _ X' _ y (hzT y hyT), divZero, abs_zero]
      linarith [abs_nonneg Mb]
  
  have hFO : (chartAt E3 (p k)) '' (F ∩ (chartAt E3 (p k)).source) ⊆
      {y | ∀ᶠ z in 𝓝 y, X' z = X z} := by
    intro y hy
    show ∀ᶠ z in 𝓝 y, X' z = X z
    by_cases hyT : y ∈ tsupport X
    · have hyQ : y ∈ (chartAt E3 (p k)) '' ((A ∪ C) ∩ (chartAt E3 (p k)).symm '' tsupport X) := by
        obtain ⟨x, ⟨hxF, hxs⟩, rfl⟩ := hy
        exact hmem _ _ hyT ⟨x, ⟨Or.inr (hFC hxF), hxs⟩, rfl⟩
      exact hz1 y (hχQ y hyQ)
    · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyT
      filter_upwards [h0] with z hz
      rw [hX' z, hz, Pi.zero_apply, smul_zero]
  have hOo : IsOpen {y | ∀ᶠ z in 𝓝 y, X' z = X z} := isOpen_setOf_eventually_nhds
  have hint : ∫ y in (chartAt E3 (p k)) '' (F ∩ (chartAt E3 (p k)).source),
      sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X' y =
      ∫ y in (chartAt E3 (p k)) '' (F ∩ (chartAt E3 (p k)).source),
      sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y := by
    apply integral_congr_ae
    have h1 : ∀ᵐ y ∂(volume.restrict {y | ∀ᶠ z in 𝓝 y, X' z = X z}),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X' y =
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y :=
      ae_restrict_of_forall_mem hOo.measurableSet (fun y hy => germ _ X' X y hy)
    exact ae_restrict_of_ae_restrict_of_subset hFO h1
  rw [← hint]
  exact le_iSup₂_of_le (f := fun (Y : E3 → E3)
      (_ : (∀ y, y ∉ (chartAt E3 (p k)) '' (K₂ ∩ (chartAt E3 (p k)).source) →
          ContDiffAt ℝ ∞ Y y) ∧ HasCompactSupport Y ∧
        tsupport Y ⊆ (chartAt E3 (p k)) '' W k ∧
        (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 (p k)).symm y i j * Y y i * Y y j ≤ 1) ∧
        ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 (p k)).symm) Y y| ≤ C) =>
      ENNReal.ofReal (∫ y in (chartAt E3 (p k)) '' (F ∩ (chartAt E3 (p k)).source),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) Y y)) X' ⟨hc, hb, hcU, hd, hf⟩ le_rfl

theorem onesided_cutoff_family (D U Jc Γc T : Set E3) (hU : IsOpen U) (hT : IsCompact T) (hTU : T ⊆ U) (hJΓ : Disjoint Jc Γc) (hJcl : closure Jc ∩ U ⊆ Jc) (hΓcl : closure Γc ∩ U ⊆ Γc) (hside : ∀ y ∈ Γc ∩ U, ∃ (V : Set E3) (φ : E3 → ℝ), IsOpen V ∧ y ∈ V ∧ ContDiffOn ℝ ∞ φ V ∧ (∀ z ∈ V, fderiv ℝ φ z ≠ 0) ∧ V ∩ D = V ∩ {z | 0 < φ z}) : ∃ (r : ℕ) (χ : Fin r → E3 → ℝ) (V : Fin r → Set E3) (φ : Fin r → E3 → ℝ), (∀ i, ContDiff ℝ ∞ (χ i)) ∧ (∀ i z, 0 ≤ χ i z) ∧ (∀ z, ∑ i, χ i z ≤ 1) ∧ (∀ y ∈ Γc ∩ T, ∀ᶠ z in 𝓝 y, z ∈ T → ∑ i, χ i z = 1) ∧ (∀ i, IsCompact (tsupport (χ i))) ∧ (∀ i, tsupport (χ i) ⊆ V i ∩ U) ∧ (∀ i, Disjoint (tsupport (χ i)) (Jc ∩ T)) ∧ (∀ i, IsOpen (V i)) ∧ (∀ i, ContDiffOn ℝ ∞ (φ i) (V i)) ∧ (∀ i, ∀ z ∈ V i, fderiv ℝ (φ i) z ≠ 0) ∧ (∀ i, V i ∩ D = V i ∩ {z | 0 < φ i z}) :=
by
  classical
  
  have relC : ∀ S : Set E3, closure S ∩ U ⊆ S → IsCompact (S ∩ T) := by
    intro S hS
    have hcl : IsClosed (S ∩ T) := by
      rw [← closure_subset_iff_isClosed]
      intro z hz
      have h1 := closure_inter_subset_inter_closure S T hz
      have hzT : z ∈ T := by
        have h2 := h1.2
        rwa [hT.isClosed.closure_eq] at h2
      exact ⟨hS ⟨h1.1, hTU hzT⟩, hzT⟩
    exact hT.of_isClosed_subset hcl Set.inter_subset_right
  have hK : IsCompact (Γc ∩ T) := relC Γc hΓcl
  have hLcl : IsClosed (Jc ∩ T) := (relC Jc hJcl).isClosed
  have hLo : IsOpen (Jc ∩ T)ᶜ := isOpen_compl_iff.mpr hLcl
  
  obtain ⟨B, hBo, hTB, hBU, hBc⟩ := exists_open_between_and_isCompact_closure hT hU hTU
  
  have hside' : ∀ y : E3, ∃ (V : Set E3) (φ : E3 → ℝ), y ∈ Γc ∩ U → (IsOpen V ∧ y ∈ V ∧
      ContDiffOn ℝ ∞ φ V ∧ (∀ z ∈ V, fderiv ℝ φ z ≠ 0) ∧ V ∩ D = V ∩ {z | 0 < φ z}) := by
    intro y
    by_cases h : y ∈ Γc ∩ U
    · obtain ⟨V, φ, hV⟩ := hside y h
      exact ⟨V, φ, fun _ => hV⟩
    · exact ⟨∅, 0, fun h' => absurd h' h⟩
  choose Vf φf hVf using hside'
  
  have hOo : ∀ y ∈ Γc ∩ T, IsOpen (Vf y ∩ B ∩ (Jc ∩ T)ᶜ) := fun y hy =>
    ((hVf y ⟨hy.1, hTU hy.2⟩).1.inter hBo).inter hLo
  have hyO : ∀ y ∈ Γc ∩ T, y ∈ Vf y ∩ B ∩ (Jc ∩ T)ᶜ := fun y hy =>
    ⟨⟨(hVf y ⟨hy.1, hTU hy.2⟩).2.1, hTB hy.2⟩, fun h => Set.disjoint_left.1 hJΓ h.1 hy.1⟩
  
  obtain ⟨t, ht, hcov⟩ := hK.elim_nhds_subcover (fun y => Vf y ∩ B ∩ (Jc ∩ T)ᶜ)
    (fun y hy => (hOo y hy).mem_nhds (hyO y hy))
  let c : Fin t.card → E3 := fun i => ((t.equivFin.symm i : t) : E3)
  have hcK : ∀ i, c i ∈ Γc ∩ T := fun i => ht _ (Finset.coe_mem _)
  have hWo : ∀ i, IsOpen (Vf (c i) ∩ B ∩ (Jc ∩ T)ᶜ) := fun i => hOo _ (hcK i)
  have hKW : Γc ∩ T ⊆ ⋃ i, Vf (c i) ∩ B ∩ (Jc ∩ T)ᶜ := by
    intro y hy
    have h1 := hcov hy
    rw [Set.mem_iUnion₂] at h1
    obtain ⟨x, hx, hyx⟩ := h1
    refine Set.mem_iUnion.2 ⟨t.equivFin ⟨x, hx⟩, ?_⟩
    have hc : c (t.equivFin ⟨x, hx⟩) = x := by
      simp only [c, Equiv.symm_apply_apply]
    rw [hc]
    exact hyx
  obtain ⟨L, hLc, hKL, hLW⟩ := exists_compact_between hK (isOpen_iUnion hWo) hKW
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E3) hLc.isClosed
    (fun i => Vf (c i) ∩ B ∩ (Jc ∩ T)ᶜ) hWo hLW
  have hmem : ∀ i, ∀ z ∈ tsupport (f i), z ∈ Vf (c i) ∧ z ∈ B ∧ z ∉ Jc ∩ T := by
    intro i z hz
    have h : z ∈ Vf (c i) ∩ B ∩ (Jc ∩ T)ᶜ := hf i hz
    exact ⟨h.1.1, h.1.2, h.2⟩
  have hcU : ∀ i, c i ∈ Γc ∩ U := fun i => ⟨(hcK i).1, hTU (hcK i).2⟩
  
  refine ⟨t.card, fun i => ⇑(f i), fun i => Vf (c i), fun i => φf (c i), ?_, ?_, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact contMDiff_iff_contDiff.mp (f i).contMDiff
  · intro i z
    exact f.nonneg i z
  · intro z
    have h := f.sum_le_one z
    rwa [finsum_eq_sum_of_fintype] at h
  · intro y hy
    filter_upwards [isOpen_interior.mem_nhds (hKL hy)] with z hz _
    have h := f.sum_eq_one (interior_subset hz)
    rwa [finsum_eq_sum_of_fintype] at h
  · intro i
    exact hBc.of_isClosed_subset (isClosed_tsupport _)
      (fun z hz => subset_closure (hmem i z hz).2.1)
  · intro i z hz
    exact ⟨(hmem i z hz).1, hBU (subset_closure (hmem i z hz).2.1)⟩
  · intro i
    exact Set.subset_compl_iff_disjoint_right.mp (fun z hz => (hmem i z hz).2.2)
  · intro i
    exact (hVf (c i) (hcU i)).1
  · intro i
    exact (hVf (c i) (hcU i)).2.2.1
  · intro i
    exact (hVf (c i) (hcU i)).2.2.2.1
  · intro i
    exact (hVf (c i) (hcU i)).2.2.2.2

theorem collar_field_regular (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (D U Jc Γc : Set E3) (X Y : E3 → E3) (r : ℕ) (χ : Fin r → E3 → ℝ) (V : Fin r → Set E3) (φ : Fin r → E3 → ℝ) (τ : ℝ) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpd : ∀ y ∈ U, (G y).PosDef) (hDΓ : Disjoint D Γc) (hX1 : ∀ y, y ∉ Jc ∪ Γc → ContDiffAt ℝ ∞ X y) (hX2 : HasCompactSupport X) (hX3 : tsupport X ⊆ U) (hχ : ∀ i, ContDiff ℝ ∞ (χ i)) (hχΓ : ∀ y ∈ Γc ∩ tsupport X, ∀ᶠ z in 𝓝 y, z ∈ tsupport X → ∑ i, χ i z = 1) (hχc : ∀ i, IsCompact (tsupport (χ i))) (hχV : ∀ i, tsupport (χ i) ⊆ V i ∩ U) (hχJ : ∀ i, Disjoint (tsupport (χ i)) (Jc ∩ tsupport X)) (hV : ∀ i, IsOpen (V i)) (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) (V i)) (hdφ : ∀ i, ∀ z ∈ V i, fderiv ℝ (φ i) z ≠ 0) (hVD : ∀ i, V i ∩ D = V i ∩ {z | 0 < φ i z}) (hτ : 0 < τ) (hY : Y = fun y => X y + ∑ i : Fin r, (χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) • (-(hcrNormalField G (φ i) y) - X y)) : (∀ y, y ∉ Jc → ContDiffAt ℝ ∞ Y y) ∧ (∀ i, ∀ y ∈ tsupport (χ i), ContDiffAt ℝ ∞ Y y) ∧ HasCompactSupport Y ∧ tsupport Y ⊆ U :=
by
  
  have hN : ∀ i, ∀ z ∈ V i ∩ U, ContDiffAt ℝ ∞ (hcrNormalField G (φ i)) z := by
    intro i z hz
    have hT : IsOpen (V i ∩ U) := (hV i).inter hU
    have hGT : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) (V i ∩ U) :=
      fun a b => (hG a b).mono Set.inter_subset_right
    have hdet : ∀ w ∈ V i ∩ U, (G w).det ≠ 0 := fun w hw => (hpd w hw.2).det_pos.ne'
    have hinv : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun w => (G w)⁻¹ a b) (V i ∩ U) := by
      intro a b
      have hd : ContDiffOn ℝ ∞ (fun w => (G w).det) (V i ∩ U) := by
        simp only [Matrix.det_fin_three]
        have := hGT
        fun_prop
      have hadj : ContDiffOn ℝ ∞ (fun w => (G w).adjugate a b) (V i ∩ U) := by
        have := hGT
        simp only [Matrix.adjugate_fin_three]
        fin_cases a <;> fin_cases b <;> simp <;> fun_prop
      have heq : (fun w => (G w)⁻¹ a b) = fun w => ((G w).det)⁻¹ * (G w).adjugate a b := by
        funext w
        rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      rw [heq]
      exact (hd.inv hdet).mul hadj
    have hpf : ∀ k : Fin 3, ContDiffOn ℝ ∞ (fun w => partialDeriv k (φ i) w) (V i ∩ U) := by
      intro k
      have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hT).mp
        ((hφ i).mono Set.inter_subset_left)).2
      exact h1.clm_apply contDiffOn_const
    have hNq : ContDiffOn ℝ ∞ (fun w => ∑ a : Fin 3, ∑ b : Fin 3,
        (G w)⁻¹ a b * partialDeriv a (φ i) w * partialDeriv b (φ i) w) (V i ∩ U) :=
      ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun b _ => ((hinv a b).mul (hpf a)).mul (hpf b)))
    have hQ : ∀ w ∈ V i ∩ U, 0 < ∑ a : Fin 3, ∑ b : Fin 3,
        (G w)⁻¹ a b * partialDeriv a (φ i) w * partialDeriv b (φ i) w := by
      intro w hw
      have hξ0 : (fun a : Fin 3 => partialDeriv a (φ i) w) ≠ 0 := by
        intro h0
        apply hdφ i w hw.1
        have hcomp : ∀ a : Fin 3, fderiv ℝ (φ i) w (e a) = 0 := fun a => congrFun h0 a
        have hL : ((fderiv ℝ (φ i) w : E3 →L[ℝ] ℝ) : E3 →ₗ[ℝ] ℝ) =
            ((0 : E3 →L[ℝ] ℝ) : E3 →ₗ[ℝ] ℝ) := by
          apply (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext
          intro a
          simpa using hcomp a
        exact ContinuousLinearMap.coe_injective hL
      have hpos := (hpd w hw.2).inv.dotProduct_mulVec_pos hξ0
      simp only [dotProduct, Matrix.mulVec, star_trivial, Fin.sum_univ_three] at hpos
      simp only [Fin.sum_univ_three]
      linarith [hpos]
    have hS : ContDiffOn ℝ ∞ (hcrNormalField G (φ i)) (V i ∩ U) := by
      rw [contDiffOn_piLp]
      intro k
      have h1 : ContDiffOn ℝ ∞ (fun w => calUnitNormal G (φ i) w k) (V i ∩ U) := by
        unfold calUnitNormal
        refine ContDiffOn.mul ?_ ?_
        · exact (hNq.sqrt (fun w hw => (hQ w hw).ne')).inv
            (fun w hw => (Real.sqrt_pos.mpr (hQ w hw)).ne')
        · exact ContDiffOn.sum (fun m _ => (hinv k m).mul (hpf m))
      exact h1.congr (fun w _ => rfl)
    exact hS.contDiffAt (hT.mem_nhds hz)
  
  have hb : ∀ i, ContDiff ℝ ∞
        (fun y => χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) ∧
      ContDiff ℝ ∞ (fun y => (χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) •
        (-(hcrNormalField G (φ i) y))) := by
    intro i
    have hst : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
    have key : ∀ z, ContDiffAt ℝ ∞
          (fun y => χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) z ∧
        ContDiffAt ℝ ∞ (fun y => (χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) •
          (-(hcrNormalField G (φ i) y))) z := by
      intro z
      by_cases hz : z ∈ tsupport (χ i)
      · have hzVU := hχV i hz
        have hφz : ContDiffAt ℝ ∞ (φ i) z := (hφ i).contDiffAt ((hV i).mem_nhds hzVU.1)
        have hin : ContDiffAt ℝ ∞ (fun y => 2 * (φ i y / τ) - 1) z :=
          (contDiffAt_const.mul (hφz.div_const τ)).sub contDiffAt_const
        have hcomp : ContDiffAt ℝ ∞ (fun y => Real.smoothTransition (2 * (φ i y / τ) - 1)) z :=
          hst.contDiffAt.comp z hin
        have h1 : ContDiffAt ℝ ∞
            (fun y => χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) z :=
          (hχ i).contDiffAt.mul (contDiffAt_const.sub hcomp)
        exact ⟨h1, h1.smul (hN i z hzVU).neg⟩
      · have hev : χ i =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hz
        constructor
        · refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
          filter_upwards [hev] with y hy
          simp [hy]
        · refine (contDiffAt_const (c := (0 : E3))).congr_of_eventuallyEq ?_
          filter_upwards [hev] with y hy
          simp [hy]
    exact ⟨contDiff_iff_contDiffAt.2 fun z => (key z).1,
      contDiff_iff_contDiffAt.2 fun z => (key z).2⟩
  have hWs : ContDiff ℝ ∞ (fun z => ∑ i : Fin r,
      (χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1))) •
        (-(hcrNormalField G (φ i) z))) :=
    ContDiff.sum (fun i _ => (hb i).2)
  have hYeq : ∀ z, Y z = X z + ∑ i : Fin r,
      ((χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1))) •
          (-(hcrNormalField G (φ i) z)) -
        (χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1))) • X z) := by
    intro z
    simp only [hY, smul_sub]
  
  have P3 : ∀ y, y ∉ Jc ∪ Γc → ContDiffAt ℝ ∞ Y y := by
    intro y hy
    have hXy := hX1 y hy
    have hfun : Y = fun z => X z + ∑ i : Fin r,
        ((χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1))) •
            (-(hcrNormalField G (φ i) z)) -
          (χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1))) • X z) := funext hYeq
    rw [hfun]
    exact hXy.add (ContDiffAt.sum fun i _ =>
      ((hb i).2.contDiffAt.sub ((hb i).1.contDiffAt.smul hXy)))
  
  have P1 : ∀ y, y ∉ tsupport X → ContDiffAt ℝ ∞ Y y := by
    intro y hy
    have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 hy
    refine hWs.contDiffAt.congr_of_eventuallyEq ?_
    filter_upwards [hev] with z hz
    rw [hYeq z]
    simp [hz]
  
  have P2 : ∀ y ∈ Γc ∩ tsupport X, ContDiffAt ℝ ∞ Y y := by
    intro y hy
    have hyD : y ∉ D := fun h => Set.disjoint_left.1 hDΓ h hy.1
    have hA : ∀ i, ∀ᶠ z in 𝓝 y,
        χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1)) = χ i z := by
      intro i
      by_cases hyV : y ∈ V i
      · have hφy : φ i y ≤ 0 := by
          by_contra h
          push_neg at h
          have hmem : y ∈ V i ∩ D := by rw [hVD i]; exact ⟨hyV, h⟩
          exact hyD hmem.2
        have hc : ContinuousAt (φ i) y :=
          (hφ i).continuousOn.continuousAt ((hV i).mem_nhds hyV)
        have hev : ∀ᶠ z in 𝓝 y, φ i z < τ / 2 :=
          hc.eventually_lt continuousAt_const (by linarith)
        filter_upwards [hev] with z hz
        have h1 : 2 * (φ i z / τ) - 1 ≤ 0 := by
          have : φ i z / τ < 1 / 2 := by rw [div_lt_iff₀ hτ]; linarith
          linarith
        rw [Real.smoothTransition.zero_of_nonpos h1]
        ring
      · have hyK : y ∉ tsupport (χ i) := fun h => hyV (hχV i h).1
        filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hyK] with z hz
        simp [hz]
    have hAll : ∀ᶠ z in 𝓝 y, ∀ i,
        χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1)) = χ i z :=
      Filter.eventually_all.2 hA
    refine hWs.contDiffAt.congr_of_eventuallyEq ?_
    filter_upwards [hAll, hχΓ y hy] with z hz1 hz2
    rw [hYeq z, Finset.sum_sub_distrib, ← Finset.sum_smul]
    by_cases hzT : z ∈ tsupport X
    · have hs : ∑ i : Fin r,
          χ i z * (1 - Real.smoothTransition (2 * (φ i z / τ) - 1)) = 1 := by
        rw [Finset.sum_congr rfl (fun i _ => hz1 i)]
        exact hz2 hzT
      rw [hs, one_smul]
      abel
    · rw [image_eq_zero_of_notMem_tsupport hzT]
      simp
  have Y1 : ∀ y, y ∉ Jc → ContDiffAt ℝ ∞ Y y := by
    intro y hyJ
    by_cases hyΓ : y ∈ Γc
    · by_cases hyT : y ∈ tsupport X
      · exact P2 y ⟨hyΓ, hyT⟩
      · exact P1 y hyT
    · exact P3 y (fun h => h.elim hyJ hyΓ)
  have Y2 : ∀ i, ∀ y ∈ tsupport (χ i), ContDiffAt ℝ ∞ Y y := by
    intro i y hy
    by_cases hyJ : y ∈ Jc
    · have hyT : y ∉ tsupport X := fun h => Set.disjoint_left.1 (hχJ i) hy ⟨hyJ, h⟩
      exact P1 y hyT
    · exact Y1 y hyJ
  
  have hK : IsCompact (tsupport X ∪ ⋃ i, tsupport (χ i)) :=
    hX2.isCompact.union (isCompact_iUnion hχc)
  have hvan : ∀ y, y ∉ tsupport X ∪ ⋃ i, tsupport (χ i) → Y y = 0 := by
    intro y hy
    simp only [Set.mem_union, Set.mem_iUnion, not_or, not_exists] at hy
    have hX0 : X y = 0 := image_eq_zero_of_notMem_tsupport hy.1
    have hχ0 : ∀ i, χ i y = 0 := fun i => image_eq_zero_of_notMem_tsupport (hy.2 i)
    rw [hYeq y]
    simp [hX0, hχ0]
  have hsub : tsupport Y ⊆ tsupport X ∪ ⋃ i, tsupport (χ i) :=
    closure_minimal (fun y hy => by_contra fun h => hy (hvan y h)) hK.isClosed
  exact ⟨Y1, Y2, hK.of_isClosed_subset (isClosed_tsupport Y) hsub,
    hsub.trans (Set.union_subset hX3
      (Set.iUnion_subset fun i => (hχV i).trans Set.inter_subset_right))⟩

theorem collar_div_pointwise (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (D U : Set E3) (X : E3 → E3) (Y : ℝ → E3 → E3) (C : ℝ) (r : ℕ) (χ : Fin r → E3 → ℝ) (V : Fin r → Set E3) (φ : Fin r → E3 → ℝ) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpd : ∀ y ∈ U, (G y).PosDef) (hXD : ∀ z ∈ D, ContDiffAt ℝ ∞ X z) (hX4 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) (hX5 : ∀ y, |sepDensDiv G X y| ≤ C) (hχ : ∀ i, ContDiff ℝ ∞ (χ i)) (hχ0 : ∀ i z, 0 ≤ χ i z) (hχ1 : ∀ z, ∑ i, χ i z ≤ 1) (hχc : ∀ i, IsCompact (tsupport (χ i))) (hχV : ∀ i, tsupport (χ i) ⊆ V i ∩ U) (hV : ∀ i, IsOpen (V i)) (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) (V i)) (hdφ : ∀ i, ∀ z ∈ V i, fderiv ℝ (φ i) z ≠ 0) (hVD : ∀ i, V i ∩ D = V i ∩ {z | 0 < φ i z}) (hY : ∀ τ y, Y τ y = X y + ∑ i : Fin r, (χ i y * (1 - Real.smoothTransition (2 * (φ i y / τ) - 1))) • (-(hcrNormalField G (φ i) y) - X y)) : ∃ B : Fin r → ℝ, (∀ i, 0 ≤ B i) ∧ ∀ τ : ℝ, 0 < τ → ∀ z ∈ D, sepDensDiv G X z - ∑ i : Fin r, B i * (tsupport (χ i) ∩ {y | y ∈ V i ∧ 0 < φ i y ∧ φ i y < τ}).indicator (fun _ => (1 : ℝ)) z ≤ sepDensDiv G (Y τ) z :=
by
  
  have hsqrt : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) U :=
    ccs_sqrtdet_smooth G U hG (fun z hz => (hpd z hz).det_pos)
