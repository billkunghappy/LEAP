theorem rescale_partialDeriv (v : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hv : ContDiffOn ℝ ∞ v U)
    (x : E3) (t : ℝ) (z : E3) (hz : x + t • z ∈ U) :
    (∀ i : Fin 3, partialDeriv i (fun y => v (x + t • y)) z = t * partialDeriv i v (x + t • z)) ∧
    (∀ i j : Fin 3, partialDeriv i (fun y => partialDeriv j (fun y' => v (x + t • y')) y) z
        = t ^ 2 * partialDeriv i (fun y => partialDeriv j v y) (x + t • z)) :=
by
  have hφ : ∀ y : E3, HasFDerivAt (fun y : E3 => x + t • y)
      (t • ContinuousLinearMap.id ℝ E3) y := by
    intro y
    have h := ((t • ContinuousLinearMap.id ℝ E3).hasFDerivAt (x := y)).const_add x
    simpa using h
  have hφc : Continuous (fun y : E3 => x + t • y) :=
    continuous_const.add (continuous_id.const_smul t)
  have hV : (fun y : E3 => x + t • y) ⁻¹' U ∈ 𝓝 z :=
    (hU.preimage hφc).mem_nhds hz
  have hdiff : ∀ p ∈ U, DifferentiableAt ℝ v p :=
    fun p hp => (hv.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hp)
  have hpdU : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun y => partialDeriv j v y) U :=
    fun j => (hv.fderiv_of_isOpen hU (by simp)).clm_apply contDiffOn_const
  have hDdiff : ∀ j : Fin 3, ∀ p ∈ U, DifferentiableAt ℝ (fun y => partialDeriv j v y) p :=
    fun j p hp => ((hpdU j).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hp)
  have s4 : ∀ y : E3, x + t • y ∈ U → ∀ j : Fin 3,
      partialDeriv j (fun y' => v (x + t • y')) y = t * partialDeriv j v (x + t • y) := by
    intro y hy j
    have h := ((hdiff _ hy).hasFDerivAt).comp y (hφ y)
    show fderiv ℝ (fun y' => v (x + t • y')) y (e j) = t * fderiv ℝ v (x + t • y) (e j)
    rw [show (fun y' => v (x + t • y')) = v ∘ (fun y : E3 => x + t • y) from rfl, h.fderiv]
    simp [smul_eq_mul]
  refine ⟨fun i => s4 z hz i, fun i j => ?_⟩
  have hev : (fun y => partialDeriv j (fun y' => v (x + t • y')) y) =ᶠ[𝓝 z]
      (fun y => t * partialDeriv j v (x + t • y)) :=
    Filter.eventually_of_mem hV (fun y hy => s4 y hy j)
  have h7 := (((hDdiff j _ hz).hasFDerivAt).comp z (hφ z)).const_mul t
  show fderiv ℝ (fun y => partialDeriv j (fun y' => v (x + t • y')) y) z (e i) =
    t ^ 2 * fderiv ℝ (fun y => partialDeriv j v y) (x + t • z) (e i)
  rw [hev.fderiv_eq]
  rw [show (fun y => t * partialDeriv j v (x + t • y)) =
    (fun y => t * ((fun y => partialDeriv j v y) ∘ (fun y : E3 => x + t • y)) y) from rfl,
    h7.fderiv]
  simp [smul_eq_mul]
  ring

theorem lapLoc_coeff_bounds (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2)) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ y : E3, R < ‖y‖ →
      (∀ i j : Fin 3,
        |(G y)⁻¹ i j - (if i = j then (1 : ℝ) else 0)| ≤ K * ‖y‖ ^ (-q) ∧
        DifferentiableAt ℝ (fun z => (G z)⁻¹ i j) y ∧
        ‖fderiv ℝ (fun z => (G z)⁻¹ i j) y‖ ≤ K * ‖y‖ ^ (-q - 1)) ∧
      (∀ k : Fin 3,
        |∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G k i j y| ≤ K * ‖y‖ ^ (-q - 1) ∧
        DifferentiableAt ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y ∧
        ‖fderiv ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y‖
          ≤ K * ‖y‖ ^ (-q - 2)) :=
by
  classical
  
  
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hU1 : ∀ y ∈ {x : E3 | R < ‖x‖}, y ∈ {x : E3 | 1 < ‖x‖} := by
    intro y hy
    show (1 : ℝ) < ‖y‖
    exact lt_of_le_of_lt hR hy
  have hGU : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) {x : E3 | R < ‖x‖} :=
    fun a b => (hsmooth a b).mono hU1
  have hdetU : ∀ y ∈ {x : E3 | R < ‖x‖}, (G y).det ≠ 0 := by
    intro y hy
    have := (hb y hy).1
    exact ne_of_gt (by linarith)
  have hdGU : ∀ c a b : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) {x : E3 | R < ‖x‖} := by
    intro c a b
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => G z a b) y) {x : E3 | R < ‖x‖} :=
      (hGU a b).fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  have hdetC : ContDiffOn ℝ ∞ (fun y => (G y).det) {x : E3 | R < ‖x‖} := by
    have h : (fun y => (G y).det) = fun y =>
        G y 0 0 * G y 1 1 * G y 2 2 - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [h]
    have h00 := hGU 0 0
    have h01 := hGU 0 1
    have h02 := hGU 0 2
    have h10 := hGU 1 0
    have h11 := hGU 1 1
    have h12 := hGU 1 2
    have h20 := hGU 2 0
    have h21 := hGU 2 1
    have h22 := hGU 2 2
    fun_prop
  have hadj : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate k l) {x : E3 | R < ‖x‖} := by
    have h00 := hGU 0 0
    have h01 := hGU 0 1
    have h02 := hGU 0 2
    have h10 := hGU 1 0
    have h11 := hGU 1 1
    have h12 := hGU 1 2
    have h20 := hGU 2 0
    have h21 := hGU 2 1
    have h22 := hGU 2 2
    intro k l
    simp only [Matrix.adjugate_fin_three]
    fin_cases k <;> fin_cases l <;> simp <;> fun_prop
  have hPU : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) {x : E3 | R < ‖x‖} := by
    intro k l
    have h : (fun y => (G y)⁻¹ k l) = fun y => ((G y).det)⁻¹ * (G y).adjugate k l := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [h]
    exact (hdetC.inv hdetU).mul (hadj k l)
  have hΓU : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) {x : E3 | R < ‖x‖} := by
    intro k i j
    have h : christoffel G k i j = fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y) := by
      funext y; rfl
    rw [h]
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hPU k l).mul (((hdGU i j l).add (hdGU j i l)).sub (hdGU l i j)))
  
  
  have hnorm : ∀ L : E3 →L[ℝ] ℝ, ‖L‖ ≤ ∑ m : Fin 3, |L (e m)| := by
    intro L
    refine L.opNorm_le_bound (Finset.sum_nonneg fun m _ => abs_nonneg _) ?_
    intro w
    have hw : w = ∑ m : Fin 3, w m • e m := by
      have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr w
      simpa [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using this.symm
    have hLw : L w = ∑ m : Fin 3, w m * L (e m) := by
      conv_lhs => rw [hw]
      simp only [map_sum, map_smul, smul_eq_mul]
    rw [hLw, Real.norm_eq_abs, Finset.sum_mul]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [abs_mul, mul_comm]
    have hwm : |w m| ≤ ‖w‖ := by
      have := PiLp.norm_apply_le w m
      simpa [Real.norm_eq_abs] using this
    exact mul_le_mul_of_nonneg_left hwm (abs_nonneg _)
  have hsum9 : ∀ (f : Fin 3 → Fin 3 → ℝ) (M : ℝ), (∀ i j, |f i j| ≤ M) →
      |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ 9 * M := by
    intro f M hf
    calc |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ ∑ i : Fin 3, |∑ j : Fin 3, f i j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, |f i j| :=
          Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, M :=
          Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hf i j
      _ = 9 * M := by simp only [Fin.sum_univ_three]; ring
  
  have cvb : ∀ (P : Fin 3 → ℝ) (d1 : Fin 3 → Fin 3 → Fin 3 → ℝ) (b α : ℝ) (i j : Fin 3),
      (∀ l : Fin 3, |P l| ≤ b) → (∀ c a b' : Fin 3, |d1 c a b'| ≤ α) →
      |(1 / 2 : ℝ) * ∑ l : Fin 3, P l * (d1 i j l + d1 j i l - d1 l i j)| ≤ 9 / 2 * b * α := by
    intro P d1 b α i j hPb hd1
    have hb0 : 0 ≤ b := (abs_nonneg _).trans (hPb 0)
