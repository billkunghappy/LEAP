  have hΨ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (sternPsi Φ Y) {y : E3 | R₁ < ‖y‖} := by
    have hmaps : Set.MapsTo Y {y : E3 | R₁ < ‖y‖} Φ.Φ.source := by
      intro x hx
      rw [Φ.source_eq]
      have h1 := (hinv x hx).1
      show (1 : ℝ) < ‖Y x‖
      linarith
    exact Φ.Φ.contMDiffOn_toFun.comp hYs.contMDiffOn hmaps
  
  obtain ⟨Lι, hLι⟩ : ∃ L : E2 →L[ℝ] E3,
      L = (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1) +
        (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 2) := ⟨_, rfl⟩
  have hιfun : (fun y : E2 => cylPt t (y 0) (y 1)) = fun y => t • e 0 + Lι y := by
    funext y
    rw [hLι]
    simp only [cylPt, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply]
    rw [add_assoc]
    rfl
  have hιd : ∀ x : E2, HasFDerivAt (fun y : E2 => cylPt t (y 0) (y 1)) Lι x := by
    intro x
    rw [hιfun]
    exact Lι.hasFDerivAt.const_add (t • e 0)
  have hιs : ContDiff ℝ ∞ (fun y : E2 => cylPt t (y 0) (y 1)) := by
    rw [hιfun]
    exact contDiff_const.add Lι.contDiff
  have hLe : ∀ a : Fin 2, Lι (e2 a) = e a.succ := by
    intro a
    rw [hLι]
    fin_cases a <;> simp [e2, e]
  
  have hσ : ContMDiffOn 𝓘(ℝ, E2) 𝓘(ℝ, E3) ∞
      (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1)))
      {x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} :=
    hΨ.comp hιs.contMDiff.contMDiffOn (fun x hx => hx)
  
  have hreg : ∀ y ∈ {y : E3 | R₁ < ‖y‖},
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y y) ≠ 0 := by
    intro y hy h0
    have hΨy : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) y :=
      (hΨ.contMDiffAt (hD.mem_nhds hy)).mdifferentiableAt hne
    have huy : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y y) :=
      hu.contMDiffAt.mdifferentiableAt hne
    have hcomp := mfderiv_comp y huy hΨy
    have hev : (u ∘ sternPsi Φ Y) =ᶠ[𝓝 y] (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) := by
      filter_upwards [hD.mem_nhds hy] with z hz
      exact hu1 z hz
    rw [hev.mfderiv_eq, mfderiv_eq_fderiv, ContinuousLinearMap.fderiv, h0,
      ContinuousLinearMap.zero_comp] at hcomp
    have h3 : (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) (e 0) = 1 := by
      simp [e, EuclideanSpace.single_apply]
    rw [hcomp] at h3
    have h4 : (0 : ℝ) = 1 := h3
    exact zero_ne_one h4
  refine ⟨hσ, fun x hx => hreg _ hx, fun q' => ⟨?_, fun x hx hsrc => ?_⟩⟩
  · 
    exact contMDiffOn_iff_contDiffOn.mp
      ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).comp
        (hσ.mono Set.inter_subset_left) (fun x hx => hx.2))
  · 
    have hN : IsOpen ({y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source) :=
      hΨ.continuousOn.isOpen_inter_preimage hD (chartAt E3 q').open_source
    have hy₀ : cylPt t (x 0) (x 1) ∈
        {y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source := ⟨hx, hsrc⟩
    have hT : ContDiffOn ℝ ∞ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z))
        ({y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source) :=
      contMDiffOn_iff_contDiffOn.mp
        ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).comp
          (hΨ.mono Set.inter_subset_left) (fun z hz => hz.2))
    have hTd : DifferentiableAt ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z))
        (cylPt t (x 0) (x 1)) :=
      (hT.contDiffAt (hN.mem_nhds hy₀)).differentiableAt hne
    have hFd : HasFDerivAt (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1))))
        ((fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1))).comp Lι)
        x := by
      have hc := hTd.hasFDerivAt.comp x (hιd x)
      exact hc
    have hFe : ∀ a : Fin 2,
        fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 a) =
          fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1))
            (e a.succ) := by
      intro a
      rw [hFd.fderiv, ContinuousLinearMap.comp_apply, hLe a]
    
    have hev : sternPsi Φ Y =ᶠ[𝓝 (cylPt t (x 0) (x 1))]
        ((chartAt E3 q').symm ∘ fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) := by
      filter_upwards [hN.mem_nhds hy₀] with z hz
      exact ((chartAt E3 q').left_inv hz.2).symm
    have hcs : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
        (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) :=
      ((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).contMDiffAt
        ((chartAt E3 q').open_target.mem_nhds
          ((chartAt E3 q').map_source hsrc))).mdifferentiableAt hne
    have hfac : ∀ v : E3,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
            (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))
            (fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1)) v) := by
      intro v
      rw [hev.mfderiv_eq, mfderiv_comp (cylPt t (x 0) (x 1)) hcs hTd.mdifferentiableAt,
        mfderiv_eq_fderiv]
      rfl
    have hpt : (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) =
        sternPsi Φ Y (cylPt t (x 0) (x 1)) := (chartAt E3 q').left_inv hsrc
    have h2 : ∀ k l : Fin 3,
        g.coeff (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) k l =
          g.g (sternPsi Φ Y (cylPt t (x 0) (x 1)))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
              (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) (e k))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
              (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) (e l)) := by
      intro k l
      show g.g ((chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) _ _ = _
      rw [show g.g ((chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) =
        g.g (sternPsi Φ Y (cylPt t (x 0) (x 1))) from congrArg g.g hpt]
    
    have hmet : sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x =
        pullMetric2 (g.coeff (chartAt E3 q').symm)
          (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x := by
      funext a b
      have e1 : sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x a b =
          g.coeff (sternPsi Φ Y) (cylPt t (x 0) (x 1)) a.succ b.succ := by
        show pullbackMetric (g.coeff Φ.Φ) Y (cylPt t (x 0) (x 1)) a.succ b.succ = _
        rw [hch _ hx]
      rw [e1]
      show g.g (sternPsi Φ Y (cylPt t (x 0) (x 1)))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) (e a.succ))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) (e b.succ)) =
        ∑ k : Fin 3, ∑ l : Fin 3,
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 a)) k *
          g.coeff (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) k l *
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 b)) l
      rw [hfac (e a.succ), hfac (e b.succ)]
      refine (hexp (g.g (sternPsi Φ Y (cylPt t (x 0) (x 1))))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
          (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) _ _).trans ?_
      rw [hFe a, hFe b]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      rw [h2 k l]
      exact mul_right_comm _ _ _
    have hP : (pullMetric2 (g.coeff (chartAt E3 q').symm)
        (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x).PosDef := by
      rw [← hmet]
      exact hpd x hx
    exact ⟨hs6 _ _ x hP, hmet⟩

theorem gaussCurv2_congr_nhds (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2)
    (hev : h₁ =ᶠ[𝓝 x] h₂) : gaussCurv2 h₁ x = gaussCurv2 h₂ x :=
by
  have hchr : ∀ y : E2, h₁ =ᶠ[𝓝 y] h₂ → ∀ k i j : Fin 2,
      christoffel2 h₁ k i j y = christoffel2 h₂ k i j y := by
    intro y hy k i j
    have hpt : h₁ y = h₂ y := hy.eq_of_nhds
    have hpd : ∀ a b c : Fin 2, pd2 c (fun z => h₁ z a b) y = pd2 c (fun z => h₂ z a b) y := by
      intro a b c
      have he : (fun z => h₁ z a b) =ᶠ[𝓝 y] (fun z => h₂ z a b) :=
        hy.mono (fun z hz => by simp only [hz])
      unfold pd2
      rw [Filter.EventuallyEq.fderiv_eq he]
    simp only [christoffel2, hpt, hpd]
  have hev2 : ∀ k i j : Fin 2, christoffel2 h₁ k i j =ᶠ[𝓝 x] christoffel2 h₂ k i j := by
    intro k i j
    exact hev.eventually_nhds.mono (fun y hy => hchr y hy k i j)
  have hpdc : ∀ c k i j : Fin 2,
      pd2 c (christoffel2 h₁ k i j) x = pd2 c (christoffel2 h₂ k i j) x := by
    intro c k i j
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq (hev2 k i j)]
  have hric : ∀ j k : Fin 2, ricci2 h₁ j k x = ricci2 h₂ j k x := by
    intro j k
    simp only [ricci2, hpdc, hchr x hev]
  have hpt : h₁ x = h₂ x := hev.eq_of_nhds
  simp only [gaussCurv2, hpt, hric]

theorem chart_level_gauss [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (q : M) (S : Set E2) (hS : IsOpen S) (P : E2 → M)
    (hP : ∀ x ∈ S, P x ∈ (chartAt E3 q).source)
    (hsm : ContDiffOn ℝ ∞ (fun x => chartAt E3 q (P x)) S)
    (hinj : ∀ x ∈ S, Function.Injective (fderiv ℝ (fun y => chartAt E3 q (P y)) x)) (c : ℝ)
    (hlev : ∀ x ∈ S, u (P x) = c)
    (hreg : ∀ x ∈ S, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (P x) ≠ 0) :
    ∀ x ∈ S, gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 q).symm) (fun y => chartAt E3 q (P y))) x =
      levelGaussLoc (g.coeff (chartAt E3 q).symm) (fun y => u ((chartAt E3 q).symm y))
        (chartAt E3 q (P x)) :=
by
  have hFV : ∀ x ∈ S, (fun y => chartAt E3 q (P y)) x ∈ (chartAt E3 q).target :=
    fun x hx => (chartAt E3 q).map_source (hP x hx)
  have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y i j)
      (chartAt E3 q).target := fun i j => g.smooth q i j
  have hsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 q).symm y i j = g.coeff (chartAt E3 q).symm y j i := by
    intro y i j
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    exact g.symm _ _ _
  have hpd : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g q y hy
  have hf := (chart_pullback_gradInner g u hu q).1
  have hlev' : ∀ x ∈ S, (fun y => u ((chartAt E3 q).symm y))
      ((fun y => chartAt E3 q (P y)) x) = c := by
    intro x hx
    show u ((chartAt E3 q).symm (chartAt E3 q (P x))) = c
    rw [(chartAt E3 q).left_inv (hP x hx)]
    exact hlev x hx
  have hreg' : ∀ x ∈ S, 0 < gradSqLoc (g.coeff (chartAt E3 q).symm)
      (fun y => u ((chartAt E3 q).symm y)) ((fun y => chartAt E3 q (P y)) x) := by
    intro x hx
    have hd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm (chartAt E3 q (P x))) ≠ 0 := by
      rw [(chartAt E3 q).left_inv (hP x hx)]
      exact hreg x hx
    have h := chart_Nsq_pos g u hu q _ (hFV x hx) hd
    unfold gradSqLoc gradInnerLoc
    exact h
  intro x hx
  exact level_gauss_equation (g.coeff (chartAt E3 q).symm) (chartAt E3 q).target
    (chartAt E3 q).open_target hG hsymm hpd (fun y => u ((chartAt E3 q).symm y)) hf
    (fun y => chartAt E3 q (P y)) S hS hsm hFV hinj c hlev' hreg' x hx

theorem patch_gauss_eq_sternGauss [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (t : ℝ) (W : Set E2) (hW : IsOpen W)
    (param : E2 → M) (hpc : ContinuousOn param W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hlev : ∀ x ∈ W, u (param x) = t)
    (hreg : ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (param x) ≠ 0)
    (hG4 : ∀ q' : M, ContDiffOn ℝ ∞ (fun x => chartAt E3 q' (param x))
      (W ∩ param ⁻¹' (chartAt E3 q').source) ∧
      ∀ x ∈ W ∩ param ⁻¹' (chartAt E3 q').source,
        Function.Injective (fderiv ℝ (fun y => chartAt E3 q' (param y)) x) ∧
        h x = pullMetric2 (g.coeff (chartAt E3 q').symm) (fun y => chartAt E3 q' (param y)) x) :
    ∀ x ∈ W, gaussCurv2 h x = sternGaussM g u (param x) :=
by
  intro x hx
  have hS : IsOpen (W ∩ param ⁻¹' (chartAt E3 (param x)).source) :=
    hpc.isOpen_inter_preimage hW (chartAt E3 (param x)).open_source
  have hxS : x ∈ W ∩ param ⁻¹' (chartAt E3 (param x)).source :=
    ⟨hx, mem_chart_source E3 (param x)⟩
  have hev : h =ᶠ[𝓝 x] pullMetric2 (g.coeff (chartAt E3 (param x)).symm)
      (fun y => chartAt E3 (param x) (param y)) :=
    Filter.eventually_of_mem (hS.mem_nhds hxS) (fun y hy => ((hG4 (param x)).2 y hy).2)
  rw [gaussCurv2_congr_nhds _ _ x hev]
  exact chart_level_gauss g u hu (param x) _ hS param (fun y hy => hy.2) (hG4 (param x)).1
    (fun y hy => ((hG4 (param x)).2 y hy).1) t (fun y hy => hlev y hy.1)
    (fun y hy => hreg y hy.1) x hxS

theorem ssp_side_data [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (X Y : E3 → E3) (q R₀ R₁ C : ℝ)
    (hXY : CoordChange X Y q R₀ R₁ C)
    (hΨ : ∀ x : E3, R₁ < ‖x‖ → u (sternPsi Φ Y x) = x 0 ∧ 0 < β (sternPsi Φ Y x))
    (hmet : ∀ x : E3, R₁ < ‖x‖ → g.coeff (sternPsi Φ Y) x = pullbackMetric (g.coeff Φ.Φ) Y x)
    (L t : ℝ) (hL : R₁ + 1 ≤ L) (ht : |t| < L) :
    ∃ (σ₀ : ℝ) (b ψs : M → ℝ) (Z V Os : Set M) (prs : M → E2) (Kcs : Set E2),
      sspSideData g Φ β u Y R₁ L t σ₀ b ψs Z V Os prs Kcs :=
by
  classical
  have hR0 : (2 : ℝ) ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hL0 : 0 < L := by linarith
  have hRL : R₁ ^ 2 < L ^ 2 - 2 := by nlinarith
  obtain ⟨P, hPs, hPΨ⟩ := sternPsi_partialDiffeomorph Φ X Y q R₀ R₁ C hXY
  have hnE3 : ∀ y : E3, ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hmemD : ∀ y : E3, L ^ 2 - 2 ≤ y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 → y ∈ P.source := by
    intro y hy
    rw [hPs]
    show R₁ < ‖y‖
    have h := hnE3 y
    by_contra hc
    push_neg at hc
    have := mul_self_le_mul_self (norm_nonneg y) hc
    nlinarith
  have hD : ∀ y ∈ P.source, R₁ < ‖y‖ := by
    intro y hy
    rw [hPs] at hy
    exact hy
  have hΨP : ∀ y ∈ P.source, P y = sternPsi Φ Y y ∧ u (P y) = y 0 ∧ 0 < β (P y) := by
    intro y hy
    rw [hPΨ y hy]
    exact ⟨rfl, hΨ y (hD y hy)⟩
  have hc0 : ∀ a b c : ℝ, (cylPt a b c) 0 = a := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hc1 : ∀ a b c : ℝ, (cylPt a b c) 1 = b := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hc2 : ∀ a b c : ℝ, (cylPt a b c) 2 = c := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hcself : ∀ y : E3, y 0 = t → cylPt t (y 1) (y 2) = y := by
    intro y hy
    ext i
    fin_cases i <;> simp [cylPt, EuclideanSpace.single_apply, hy]
  obtain ⟨π, hπdef⟩ : ∃ π : E3 → E2, π = fun z => z 1 • e2 0 + z 2 • e2 1 := ⟨_, rfl⟩
  have hπ0 : ∀ z : E3, (π z) 0 = z 1 := by
    intro z; rw [hπdef]; simp [e2, EuclideanSpace.single_apply]
  have hπ1 : ∀ z : E3, (π z) 1 = z 2 := by
    intro z; rw [hπdef]; simp [e2, EuclideanSpace.single_apply]
  have hπs : ContDiff ℝ ∞ π := by
    rw [hπdef]
    have h1 : ContDiff ℝ ∞ (fun y : E3 => y 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    have h2 : ContDiff ℝ ∞ (fun y : E3 => y 2) :=
      (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    exact (h1.smul contDiff_const).add (h2.smul contDiff_const)
  have hπι : ∀ x : E2, π (cylPt t (x 0) (x 1)) = x := by
    intro x
    ext i
    fin_cases i
    · show (π (cylPt t (x 0) (x 1))) 0 = x 0
      rw [hπ0, hc1]
    · show (π (cylPt t (x 0) (x 1))) 1 = x 1
      rw [hπ1, hc2]
  have hιπ : ∀ y : E3, y 0 = t → cylPt t ((π y) 0) ((π y) 1) = y := by
    intro y hy
    rw [hπ0, hπ1]
    exact hcself y hy
  have hcr : Continuous fun y : E3 => y 1 ^ 2 + y 2 ^ 2 := by fun_prop
  have hca : Continuous fun y : E3 => |y 0 - t| := by fun_prop
  have hcr2 : Continuous fun x : E2 => x 0 ^ 2 + x 1 ^ 2 := by fun_prop
  have hcpt : ∀ a c : ℝ, c ≤ L ^ 2 + 1 →
      IsCompact {y : E3 | |y 0 - t| ≤ 1 ∧ a ≤ y 1 ^ 2 + y 2 ^ 2 ∧ y 1 ^ 2 + y 2 ^ 2 ≤ c} := by
    intro a c hc
    apply Metric.isCompact_of_isClosed_isBounded
    · exact (isClosed_le hca continuous_const).inter
        ((isClosed_le continuous_const hcr).inter (isClosed_le hcr continuous_const))
    · refine (Metric.isBounded_closedBall (x := (0 : E3)) (r := |t| + |L| + 2)).subset ?_
      intro y hy
      obtain ⟨h1, h2, h3⟩ := hy
      rw [Metric.mem_closedBall, dist_zero_right]
      have hy0 : |y 0| ≤ |t| + 1 := by
        have := abs_sub_abs_le_abs_sub (y 0) t
        linarith
      have hsq : y 0 ^ 2 ≤ (|t| + 1) ^ 2 := by
        rw [← sq_abs (y 0)]
        exact pow_le_pow_left₀ (abs_nonneg _) hy0 2
      have hL2 : L ^ 2 = |L| ^ 2 := (sq_abs L).symm
      have := hnE3 y
