    fun h hh i => ((hh.continuousOn_fderiv_of_isOpen hU1 (by simp)).clm_apply
      continuousOn_const).mono hsubU
  have hcoord : ∀ a : Fin 3, ContinuousOn (fun y : E3 => y a / ‖y‖) {y : E3 | Rs < ‖y‖} := by
    intro a
