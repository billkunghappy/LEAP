theorem collar_lapse_function [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (φ lam : M → ℝ)
    (hdata : ∀ p ∈ frontier U, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ frontier U, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
          g.jacobiDeriv f x = lam x / φ x)
    (nB : ℕ) (B : Fin nB → Set M) (f : Fin nB → M → ℝ)
    (hBo : ∀ i, IsOpen (B i)) (hfs : ∀ i, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i))
    (hdf : ∀ i, ∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0)
    (hBF : ∀ i, B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0})
    (hBsgn : ∀ i k, ∀ x ∈ B i ∩ B k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f i y = e * f k y)
    (K : Set M) (hK : IsCompact K) (hKF : K ⊆ frontier U) (hKB : K ⊆ ⋃ i, B i) :
    ∃ (Λf : M → ℝ) (Λ μ : ℝ), 0 < μ ∧ (∀ y ∈ K, μ ≤ Λf y ∧ Λf y ≤ Λ) ∧
      (∀ i, ∀ y ∈ B i ∩ frontier U, Λf y = φ y * Real.sqrt (g.gradInner (f i) (f i) y)) ∧
      (∀ i (W : Set E2) (Fh : E2 → E3) (p : M), IsOpen W → ContDiffOn ℝ ∞ Fh W →
        (∀ x ∈ W, Fh x ∈ (chartAt E3 p).target ∧
          (chartAt E3 p).symm (Fh x) ∈ frontier U ∩ B i) →
        ContDiffOn ℝ ∞ (fun x => Λf ((chartAt E3 p).symm (Fh x))) W) :=
by
  classical
  
  have hs1 : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      (∀ p : M, ContDiffOn ℝ ∞ (fun y => g.gradInner u u ((chartAt E3 p).symm y))
        (chartAt E3 p).target) ∧ Continuous (g.gradInner u u) := by
    intro u hu
    have hsm : ∀ p : M, ContDiffOn ℝ ∞ (fun y => g.gradInner u u ((chartAt E3 p).symm y))
        (chartAt E3 p).target := by
      intro p
      have hT : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
      have hGe : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 p).symm y a b)
          (chartAt E3 p).target := fun a b => g.smooth p a b
      have hdetGen : ∀ A : E3 → Matrix (Fin 3) (Fin 3) ℝ,
          (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => A y a b) (chartAt E3 p).target) →
          ContDiffOn ℝ ∞ (fun y => (A y).det) (chartAt E3 p).target := by
        intro A hA
        simp only [Matrix.det_fin_three]
        have t1 := ((hA 0 0).mul (hA 1 1)).mul (hA 2 2)
        have t2 := ((hA 0 0).mul (hA 1 2)).mul (hA 2 1)
        have t3 := ((hA 0 1).mul (hA 1 0)).mul (hA 2 2)
        have t4 := ((hA 0 1).mul (hA 1 2)).mul (hA 2 0)
        have t5 := ((hA 0 2).mul (hA 1 0)).mul (hA 2 1)
        have t6 := ((hA 0 2).mul (hA 1 1)).mul (hA 2 0)
        exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
      have hdet := hdetGen _ hGe
      have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞
          (fun y => (g.coeff (chartAt E3 p).symm y).adjugate i j) (chartAt E3 p).target := by
        intro i j
        simp only [Matrix.adjugate_apply]
        apply hdetGen
        intro a b
        by_cases hab : a = j
        · simp only [Matrix.updateRow_apply, hab, if_true]
          exact contDiffOn_const
        · simp only [Matrix.updateRow_apply, hab, if_false]
          exact hGe a b
      have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞
          (fun y => (g.coeff (chartAt E3 p).symm y)⁻¹ i j) (chartAt E3 p).target := by
        intro i j
        refine ((hdet.inv fun y hy => (coeff_chart_symm_posDef g p y hy).det_pos.ne').mul
          (hadj i j)).congr fun y _ => ?_
        simp only [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      have hup := (chart_pullback_gradInner g u hu p).1
      have hfd := ((contDiffOn_infty_iff_fderiv_of_isOpen hT).1 hup).2
      have hpd : ∀ i : Fin 3, ContDiffOn ℝ ∞
          (fun y => partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y)
          (chartAt E3 p).target := fun i => hfd.clm_apply contDiffOn_const
      have hR : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
          (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
            partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y *
            partialDeriv j (fun z => u ((chartAt E3 p).symm z)) y) (chartAt E3 p).target :=
        ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ((hinv i j).mul (hpd i)).mul (hpd j)
      exact hR.congr fun y hy => (chart_pullback_gradInner g u hu p).2.1 y hy
    refine ⟨hsm, continuous_iff_continuousAt.2 fun x₀ => ?_⟩
    have hH : ContinuousAt (fun y => g.gradInner u u ((chartAt E3 x₀).symm y))
        (chartAt E3 x₀ x₀) :=
      (hsm x₀).continuousOn.continuousAt
        ((chartAt E3 x₀).open_target.mem_nhds (mem_chart_target E3 x₀))
    have hk : ContinuousAt (chartAt E3 x₀) x₀ := (chartAt E3 x₀).continuousAt (mem_chart_source E3 x₀)
    have hcomp := hH.comp hk
    refine hcomp.congr ?_
    filter_upwards [(chartAt E3 x₀).open_source.mem_nhds (mem_chart_source E3 x₀)] with y hy
    simp only [Function.comp, (chartAt E3 x₀).left_inv hy]
  
  have hs3 : ∀ (u w : M → ℝ) (x : M) (e : ℝ), (e = 1 ∨ e = -1) →
      (∀ᶠ y in 𝓝 x, u y = e * w y) → g.gradInner u u x = g.gradInner w w x := by
    intro u w x e he h
    have hx : x ∈ (chartAt E3 x).source := mem_chart_source E3 x
    have ht : Tendsto (chartAt E3 x).symm (𝓝 (chartAt E3 x x)) (𝓝 x) := by
      have h1 := (chartAt E3 x).continuousAt_symm (mem_chart_target E3 x)
      rw [ContinuousAt, (chartAt E3 x).left_inv hx] at h1
      exact h1
    have h' : (fun z => u ((chartAt E3 x).symm z)) =ᶠ[𝓝 (chartAt E3 x x)]
        (fun z => e * w ((chartAt E3 x).symm z)) := ht.eventually h
    have hpd : ∀ i, partialDeriv i (fun z => u ((chartAt E3 x).symm z)) (chartAt E3 x x) =
        e * partialDeriv i (fun z => w ((chartAt E3 x).symm z)) (chartAt E3 x x) := by
      intro i
      unfold partialDeriv
      rw [Filter.EventuallyEq.fderiv_eq h']
      rcases he with rfl | rfl
      · simp only [one_mul]
      · simp only [neg_one_mul]
        rw [show (fun z => -w ((chartAt E3 x).symm z)) =
          -(fun z => w ((chartAt E3 x).symm z)) from rfl, fderiv_neg]
        rfl
    have he2 : e * e = 1 := by rcases he with rfl | rfl <;> norm_num
    simp only [RiemannianMetric3.gradInner, hpd]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    linear_combination
      ((g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ i j *
        partialDeriv i (fun z => w ((chartAt E3 x).symm z)) (chartAt E3 x x) *
        partialDeriv j (fun z => w ((chartAt E3 x).symm z)) (chartAt E3 x x)) * he2
  
  obtain ⟨Λf, hΛdef⟩ : ∃ Λf : M → ℝ, ∀ y, Λf y =
      if h : ∃ i, y ∈ B i ∩ frontier U then
        φ y * Real.sqrt (g.gradInner (f h.choose) (f h.choose) y) else 0 :=
    ⟨_, fun y => rfl⟩
  
  have hform : ∀ i, ∀ y ∈ B i ∩ frontier U,
      Λf y = φ y * Real.sqrt (g.gradInner (f i) (f i) y) := by
    intro i y hy
    have hex : ∃ i, y ∈ B i ∩ frontier U := ⟨i, hy⟩
    have hj := hex.choose_spec
    rw [hΛdef y, dif_pos hex]
    obtain ⟨e, he, hev⟩ := hBsgn hex.choose i y ⟨hj.1, hy.1⟩
    rw [hs3 (f hex.choose) (f i) y e he hev]
  
  have hloc : ∀ y₀ ∈ frontier U, ∃ (V₀ : Set M) (f₀ : M → ℝ), IsOpen V₀ ∧ y₀ ∈ V₀ ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f₀ ∧
      ∀ y ∈ V₀ ∩ frontier U, 0 < g.gradInner f₀ f₀ y ∧
        φ y = 1 / Real.sqrt (g.gradInner f₀ f₀ y) := by
    intro y₀ hy₀
    obtain ⟨-, V₀, f₀, hV₀o, hy₀V₀, hf₀s, -, -, hnorm⟩ := hdata y₀ hy₀
    refine ⟨V₀, f₀, hV₀o, hy₀V₀, hf₀s, fun y hy => ?_⟩
    have h1 := (hnorm y hy).1
    have hs : Real.sqrt (g.gradInner f₀ f₀ y) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at h1
      exact zero_ne_one h1
    refine ⟨?_, ?_⟩
    · rcases lt_or_ge 0 (g.gradInner f₀ f₀ y) with h | h
      · exact h
      · exact absurd (Real.sqrt_eq_zero'.2 h) hs
    · rw [eq_div_iff hs, mul_comm]
      exact h1
  
  have hs2 : ∀ (u : M → ℝ) (x : M), mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0 →
      0 < g.gradInner u u x := by
    intro u x hx
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x := by
      by_contra h
      exact hx (mfderiv_zero_of_not_mdifferentiableAt h)
    have hfd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x =
        fderiv ℝ (fun y => u ((chartAt E3 x).symm y)) (chartAt E3 x x) := by
      rw [hmd.mfderiv]
      have hr : Set.range (𝓘(ℝ, E3) : E3 → E3) = Set.univ := by simp
      rw [hr, fderivWithin_univ]
      rfl
    set ξ : Fin 3 → ℝ := fun i =>
      partialDeriv i (fun y => u ((chartAt E3 x).symm y)) (chartAt E3 x x) with hξdef
    have hξ : ξ ≠ 0 := by
      intro h0
      apply hx
      rw [hfd]
      apply ContinuousLinearMap.coe_injective
      refine (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext fun i => ?_
      have hi := congr_fun h0 i
      simp only [hξdef, partialDeriv, Pi.zero_apply] at hi
      simpa [EuclideanSpace.basisFun_apply] using hi
    have hA := coeff_chart_symm_posDef g x (chartAt E3 x x) (mem_chart_target E3 x)
    have hpos := hA.inv.dotProduct_mulVec_pos hξ
    have heq : g.gradInner u u x = dotProduct (star ξ)
        (Matrix.mulVec (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ ξ) := by
      simp only [RiemannianMetric3.gradInner, dotProduct, Matrix.mulVec, Pi.star_apply,
        star_trivial, Finset.mul_sum, hξdef]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [heq]
    exact hpos
  
  have hposB : ∀ i, ∀ y ∈ B i, 0 < g.gradInner (f i) (f i) y :=
    fun i y hy => hs2 (f i) y (hdf i y hy)
  
  have hclause3 : ∀ i (W : Set E2) (Fh : E2 → E3) (p : M), IsOpen W → ContDiffOn ℝ ∞ Fh W →
      (∀ x ∈ W, Fh x ∈ (chartAt E3 p).target ∧
        (chartAt E3 p).symm (Fh x) ∈ frontier U ∩ B i) →
      ContDiffOn ℝ ∞ (fun x => Λf ((chartAt E3 p).symm (Fh x))) W := by
    intro i W Fh p hW hFh hland
    apply contDiffOn_of_locally_contDiffOn
    intro x₀ hx₀
    obtain ⟨-, hx₀F, -⟩ := hland x₀ hx₀
    obtain ⟨V₀, f₀, hV₀o, hy₀V₀, hf₀s, hV₀⟩ := hloc _ hx₀F
    have hcont : ContinuousOn (fun x => (chartAt E3 p).symm (Fh x)) W :=
      (chartAt E3 p).continuousOn_symm.comp hFh.continuousOn (fun x hx => (hland x hx).1)
    have hW₀o : IsOpen (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀) :=
      hcont.isOpen_inter_preimage hW hV₀o
    refine ⟨W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀, hW₀o, ⟨hx₀, hy₀V₀⟩, ?_⟩
    have hsub : W ∩ (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀) ⊆ W :=
      fun x hx => hx.1
    have hmaps : Set.MapsTo Fh (W ∩ (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀))
        (chartAt E3 p).target := fun x hx => (hland x hx.1).1
    have hH0 := ((hs1 f₀ hf₀s).1 p).comp (hFh.mono hsub) hmaps
    have hHi := ((hs1 (f i) (hfs i)).1 p).comp (hFh.mono hsub) hmaps
    have hpt : ∀ x ∈ W ∩ (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀),
        (chartAt E3 p).symm (Fh x) ∈ V₀ ∩ frontier U ∧ (chartAt E3 p).symm (Fh x) ∈ B i :=
      fun x hx => ⟨⟨hx.2.2, (hland x hx.1).2.1⟩, (hland x hx.1).2.2⟩
    have hne0 : ∀ x ∈ W ∩ (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀),
        ((fun y => g.gradInner f₀ f₀ ((chartAt E3 p).symm y)) ∘ Fh) x ≠ 0 :=
      fun x hx => (hV₀ _ (hpt x hx).1).1.ne'
    have hnei : ∀ x ∈ W ∩ (W ∩ (fun x => (chartAt E3 p).symm (Fh x)) ⁻¹' V₀),
        ((fun y => g.gradInner (f i) (f i) ((chartAt E3 p).symm y)) ∘ Fh) x ≠ 0 :=
      fun x hx => (hposB i _ (hpt x hx).2).ne'
    have hS0 := hH0.sqrt hne0
    have hSi := hHi.sqrt hnei
    have hq := (contDiffOn_const (c := (1 : ℝ))).div hS0
      (fun x hx => (Real.sqrt_pos.2 (hV₀ _ (hpt x hx).1).1).ne')
    refine (hq.mul hSi).congr ?_
    intro x hx
    obtain ⟨h1, h2⟩ := hpt x hx
    simp only [Function.comp, Pi.div_apply]
    rw [hform i _ ⟨h2, h1.2⟩, (hV₀ _ h1).2]
  
  have hcontK : ContinuousOn Λf K := by
    intro y₀ hy₀K
    have hy₀F := hKF hy₀K
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hKB hy₀K)
    obtain ⟨V₀, f₀, hV₀o, hy₀V₀, hf₀s, hV₀⟩ := hloc y₀ hy₀F
    have hc0 := (hs1 f₀ hf₀s).2
    have hci := (hs1 (f i) (hfs i)).2
    have hpos0 : 0 < Real.sqrt (g.gradInner f₀ f₀ y₀) :=
      Real.sqrt_pos.2 (hV₀ y₀ ⟨hy₀V₀, hy₀F⟩).1
    have hψ : ContinuousAt (fun y => 1 / Real.sqrt (g.gradInner f₀ f₀ y) *
        Real.sqrt (g.gradInner (f i) (f i) y)) y₀ :=
      (continuousAt_const.div hc0.continuousAt.sqrt hpos0.ne').mul hci.continuousAt.sqrt
    have heq : ∀ y ∈ K ∩ (B i ∩ V₀), Λf y = 1 / Real.sqrt (g.gradInner f₀ f₀ y) *
        Real.sqrt (g.gradInner (f i) (f i) y) := by
      intro y hy
      have hyF := hKF hy.1
      rw [hform i y ⟨hy.2.1, hyF⟩, (hV₀ y ⟨hy.2.2, hyF⟩).2]
    refine hψ.continuousWithinAt.congr_of_eventuallyEq ?_ (heq y₀ ⟨hy₀K, hi, hy₀V₀⟩)
    filter_upwards [inter_mem_nhdsWithin K (((hBo i).inter hV₀o).mem_nhds ⟨hi, hy₀V₀⟩)]
      with y hy
    exact heq y hy
  
  have hposK : ∀ y ∈ K, 0 < Λf y := by
    intro y hy
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hKB hy)
    rw [hform i y ⟨hi, hKF hy⟩]
    exact mul_pos (hdata y (hKF hy)).1 (Real.sqrt_pos.2 (hposB i y hi))
  
  rcases K.eq_empty_or_nonempty with hKe | hKne
  · refine ⟨Λf, 0, 1, one_pos, ?_, hform, hclause3⟩
    intro y hy
    rw [hKe] at hy
    simp at hy
  · obtain ⟨a, haK, ha⟩ := hK.exists_isMinOn hKne hcontK
    obtain ⟨b, hbK, hb⟩ := hK.exists_isMaxOn hKne hcontK
    refine ⟨Λf, Λf b, Λf a, hposK a haK, fun y hy => ⟨isMinOn_iff.1 ha y hy,
      isMaxOn_iff.1 hb y hy⟩, hform, hclause3⟩

theorem collar_curves_agree [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x)
    (hNg1 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), Ng x (-ℓ) = -Ng x ℓ)
    (hNg3 : ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
      (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
      ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
        (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x)
    (B₁ B₂ : Set M) (f₁ f₂ : M → ℝ) (hB₁ : IsOpen B₁) (hB₂ : IsOpen B₂)
    (hf₁ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f₁) (hf₂ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f₂)
    (hd₁ : ∀ x ∈ B₁, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x ≠ 0)
    (hd₂ : ∀ x ∈ B₂, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ x ≠ 0)
    (hsgn : ∀ x ∈ B₁ ∩ B₂, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f₁ y = e * f₂ y)
    (T : ℝ) (γ₁ γ₂ : ℝ → M) (e₁ e₂ : ℝ) (he₁ : e₁ = 1 ∨ e₁ = -1) (he₂ : e₂ = 1 ∨ e₂ = -1)
    (hγ₁ : IsMIntegralCurveOn γ₁ (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x))
      (Set.Ioo (-T) T))
    (hγ₂ : IsMIntegralCurveOn γ₂ (fun x => e₂ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ x))
      (Set.Ioo (-T) T))
    (hγ₁B : ∀ t ∈ Set.Ioo (-T) T, γ₁ t ∈ B₁) (hγ₂B : ∀ t ∈ Set.Ioo (-T) T, γ₂ t ∈ B₂)
    (hγ₁f : ∀ t ∈ Set.Ioo (-T) T, f₁ (γ₁ t) = e₁ * t)
    (hγ₂f : ∀ t ∈ Set.Ioo (-T) T, |f₂ (γ₂ t)| = |t|)
    (t₁ : ℝ) (ht₁ : t₁ ∈ Set.Ioo (-T) T) (ht₁0 : t₁ ≠ 0) (hmeet : γ₁ t₁ = γ₂ t₁) :
    Set.EqOn γ₁ γ₂ (Set.Ioo (-T) T) :=
by
  classical
  
  have hchg : ∀ (γ : ℝ → M) (v w : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (s : Set ℝ),
      IsMIntegralCurveOn γ v s → (∀ t ∈ s, v (γ t) = w (γ t)) → IsMIntegralCurveOn γ w s := by
    intro γ v w s h hvw t ht
    rw [← hvw t ht]
    exact h t ht
  
  have hV₁s : ∀ x ∈ B₁, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
      (fun y => (⟨y, e₁ • Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x := by
    intro x hx
    rcases he₁ with rfl | rfl
    · have h := hNg3 B₁ f₁ hB₁ hf₁.contMDiffOn hd₁ x hx
      simp only [one_smul]
      exact h.of_le (by exact_mod_cast le_top)
    · have hd' : ∀ y ∈ B₁, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (-f₁) y ≠ 0 := by
        intro y hy
        rw [mfderiv_neg]
        exact neg_ne_zero.mpr (hd₁ y hy)
      have hneg : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (-f₁) := hf₁.neg
      have h := hNg3 B₁ (-f₁) hB₁ hneg.contMDiffOn hd' x hx
      have heq : (fun y => (⟨y, (-1 : ℝ) • Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ y)⟩ :
          TangentBundle 𝓘(ℝ, E3) M)) =
          (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (-f₁) y)⟩ :
            TangentBundle 𝓘(ℝ, E3) M)) := by
        funext y
        rw [mfderiv_neg, hNg1, neg_one_smul]
      rw [heq]
      exact h.of_le (by exact_mod_cast le_top)
  
  have hloc : ∀ t ∈ Set.Ioo (-T) T, γ₁ t = γ₂ t → ∃ δ : ℝ, 0 < δ ∧
      Set.Ioo (t - δ) (t + δ) ⊆ Set.Ioo (-T) T ∧
      ((∀ s ∈ Set.Ioo (t - δ) (t + δ), γ₁ s = γ₂ s) ∨
       (∀ s ∈ Set.Ioo (t - δ) (t + δ), γ₁ s = γ₂ (2 * t - s) ∧ |f₁ (γ₁ s)| = |f₂ (γ₁ s)|)) := by
    intro t ht hmt
    have hx₁ : γ₁ t ∈ B₁ := hγ₁B t ht
    have hx₂ : γ₁ t ∈ B₂ := by rw [hmt]; exact hγ₂B t ht
    obtain ⟨e, he, hev⟩ := hsgn (γ₁ t) ⟨hx₁, hx₂⟩
    obtain ⟨W₀, hW₀f, hW₀o, hxW₀⟩ := eventually_nhds_iff.1 hev
    have hWo : IsOpen (W₀ ∩ B₁) := hW₀o.inter hB₁
    have hxW : γ₁ t ∈ W₀ ∩ B₁ := ⟨hxW₀, hx₁⟩
    have hWf : ∀ y ∈ W₀ ∩ B₁, |f₁ y| = |f₂ y| := by
      intro y hy
      rw [hW₀f y hy.1, abs_mul]
      rcases he with rfl | rfl <;> simp
    have hfield : ∀ y ∈ W₀ ∩ B₁, e₁ • Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ y) =
        (e₁ * e * e₂) • (e₂ • Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ y)) := by
      intro y hy
      have hev' : f₁ =ᶠ[𝓝 y] (fun z => e * f₂ z) :=
        Filter.eventually_of_mem (hW₀o.mem_nhds hy.1) (fun z hz => hW₀f z hz)
      have hd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ y =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => e * f₂ z) y := hev'.mfderiv_eq
      rw [smul_smul]
      have he₂2 : e₁ * e * e₂ * e₂ = e₁ * e := by
        rcases he₂ with rfl | rfl <;> ring
      rw [he₂2]
      rcases he with rfl | rfl
      · have h1 : (fun z => (1 : ℝ) * f₂ z) = f₂ := by funext z; simp
        rw [h1] at hd
        rw [hd, mul_one]
      · have h1 : (fun z => (-1 : ℝ) * f₂ z) = -f₂ := by funext z; simp
        rw [h1, mfderiv_neg] at hd
        rw [hd, hNg1, smul_neg, ← neg_smul, mul_neg_one]
    have hc : e₁ * e * e₂ = 1 ∨ e₁ * e * e₂ = -1 := by
      rcases he₁ with rfl | rfl <;> rcases he with rfl | rfl <;> rcases he₂ with rfl | rfl <;>
        norm_num
    have hc₁ : ContinuousAt γ₁ t := hγ₁.continuousOn.continuousAt (Ioo_mem_nhds ht.1 ht.2)
    have hc₂ : ContinuousAt γ₂ t := hγ₂.continuousOn.continuousAt (Ioo_mem_nhds ht.1 ht.2)
    have hS : Set.Ioo (-T) T ∩ γ₁ ⁻¹' (W₀ ∩ B₁) ∩ γ₂ ⁻¹' (W₀ ∩ B₁) ∈ 𝓝 t := by
      refine Filter.inter_mem (Filter.inter_mem (Ioo_mem_nhds ht.1 ht.2)
        (hc₁ (hWo.mem_nhds hxW))) (hc₂ ?_)
      rw [← hmt]
      exact hWo.mem_nhds hxW
    obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 hS
    rw [Real.ball_eq_Ioo] at hball
    have hIJ : Set.Ioo (t - δ) (t + δ) ⊆ Set.Ioo (-T) T := fun s hs => (hball hs).1.1
    have hI1 : ∀ s ∈ Set.Ioo (t - δ) (t + δ), γ₁ s ∈ W₀ ∩ B₁ := fun s hs => (hball hs).1.2
    have hI2 : ∀ s ∈ Set.Ioo (t - δ) (t + δ), γ₂ s ∈ W₀ ∩ B₁ := fun s hs => (hball hs).2
    have htI : t ∈ Set.Ioo (t - δ) (t + δ) := ⟨by linarith, by linarith⟩
    have hγ₁I := hγ₁.mono hIJ
    have hIn : Set.Ioo (t - δ) (t + δ) ∈ 𝓝 t := Ioo_mem_nhds htI.1 htI.2
    have hγ₁A : IsMIntegralCurveAt γ₁
        (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x)) t := hγ₁I.isMIntegralCurveAt hIn
    have hsm : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
        (fun y => (⟨y, e₁ • Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ y)⟩ :
          TangentBundle 𝓘(ℝ, E3) M)) (γ₁ t) := hV₁s _ hx₁
    have hfin : ∀ g : ℝ → M, γ₁ =ᶠ[𝓝 t] g → ∃ δ' : ℝ, 0 < δ' ∧
        Set.Ioo (t - δ') (t + δ') ⊆ Set.Ioo (-T) T ∧
        ∀ s ∈ Set.Ioo (t - δ') (t + δ'), γ₁ s = g s ∧ |f₁ (γ₁ s)| = |f₂ (γ₁ s)| := by
      intro g hg
      obtain ⟨ε, hε, hεp⟩ := Metric.eventually_nhds_iff.1 hg
      have hm1 := min_le_left δ ε
      have hm2 := min_le_right δ ε
      refine ⟨min δ ε, lt_min hδ hε, ?_, ?_⟩
      · intro s hs
        apply hIJ
        exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
      · intro s hs
        have h1 : s ∈ Set.Ioo (t - δ) (t + δ) := ⟨by linarith [hs.1], by linarith [hs.2]⟩
        have h2 : dist s t < ε := by
          rw [Real.dist_eq, abs_lt]
          exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
        exact ⟨hεp h2, hWf _ (hI1 s h1)⟩
    rcases hc with hc | hc
    · have hγ₂I : IsMIntegralCurveOn γ₂ (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x))
          (Set.Ioo (t - δ) (t + δ)) := by
        refine hchg γ₂ (fun x => e₂ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ x))
          (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x)) _ (hγ₂.mono hIJ) ?_
        intro s hs
        show e₂ • Ng (γ₂ s) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ (γ₂ s)) =
          e₁ • Ng (γ₂ s) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ (γ₂ s))
        rw [hfield _ (hI2 s hs), hc, one_smul]
      have hg := isMIntegralCurveAt_eventuallyEq_of_contMDiffAt_boundaryless
        (v := fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x))
        hsm hγ₁A (hγ₂I.isMIntegralCurveAt hIn) hmt
      obtain ⟨δ', hδ', hIJ', hag⟩ := hfin γ₂ hg
      exact ⟨δ', hδ', hIJ', Or.inl (fun s hs => (hag s hs).1)⟩
    · have hrefl : ∀ s ∈ Set.Ioo (t - δ) (t + δ), 2 * t - s ∈ Set.Ioo (t - δ) (t + δ) := by
        intro s hs
        exact ⟨by linarith [hs.2], by linarith [hs.1]⟩
      have hcomp := (hγ₂.comp_mul (-1)).comp_add (-(2 * t))
      have hfun : ((γ₂ ∘ fun x => x * (-1 : ℝ)) ∘ fun x => x + -(2 * t)) =
          fun s => γ₂ (2 * t - s) := by
        funext s
        simp only [Function.comp]
        congr 1
        ring
      rw [hfun] at hcomp
      have hγ₃ : IsMIntegralCurveOn (fun s => γ₂ (2 * t - s))
          (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x)) (Set.Ioo (t - δ) (t + δ)) := by
        refine hchg (fun s => γ₂ (2 * t - s))
          ((-1 : ℝ) • fun x => e₂ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ x))
          (fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x)) _ (hcomp.mono ?_) ?_
        · intro s hs
          show (s + -(2 * t)) * -1 ∈ Set.Ioo (-T) T
          have h2 : (s + -(2 * t)) * -1 = 2 * t - s := by ring
          rw [h2]
          exact hIJ (hrefl s hs)
        · intro s hs
          show (-1 : ℝ) • (e₂ • Ng (γ₂ (2 * t - s)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ (γ₂ (2 * t - s)))) =
            e₁ • Ng (γ₂ (2 * t - s)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ (γ₂ (2 * t - s)))
          rw [hfield _ (hI2 _ (hrefl s hs)), hc]
      have hmt' : γ₁ t = (fun s => γ₂ (2 * t - s)) t := by
        show γ₁ t = γ₂ (2 * t - t)
        rw [show 2 * t - t = t by ring]
        exact hmt
      have hg := isMIntegralCurveAt_eventuallyEq_of_contMDiffAt_boundaryless
        (v := fun x => e₁ • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x))
        hsm hγ₁A (hγ₃.isMIntegralCurveAt hIn) hmt'
      obtain ⟨δ', hδ', hIJ', hag⟩ := hfin _ hg
      exact ⟨δ', hδ', hIJ', Or.inr (fun s hs => hag s hs)⟩
  
  have hIE : ∀ t δ : ℝ, Set.Ioo (t - δ) (t + δ) ⊆ Set.Ioo (-T) T →
      (∀ s ∈ Set.Ioo (t - δ) (t + δ), γ₁ s = γ₂ s) → 0 < δ →
      t ∈ interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} := by
    intro t δ hIJ hag hδ
    have hsub : Set.Ioo (t - δ) (t + δ) ⊆ {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} :=
      fun s hs => ⟨hIJ hs, hag s hs⟩
    have htI : t ∈ Set.Ioo (t - δ) (t + δ) := ⟨by linarith, by linarith⟩
    exact interior_maximal hsub isOpen_Ioo htI
  have hAE : interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} ⊆
      {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} := interior_subset
  have hinj : ∀ s ∈ Set.Ioo (-T) T, ∀ s' ∈ Set.Ioo (-T) T, γ₁ s = γ₁ s' → s = s' := by
    intro s hs s' hs' h
    have h1 := hγ₁f s hs
    have h2 := hγ₁f s' hs'
    rw [h] at h1
    rcases he₁ with rfl | rfl <;> linarith
  have hstart : t₁ ∈ interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} := by
    obtain ⟨δ, hδ, hIJ, hag | hrefl⟩ := hloc t₁ ht₁ hmeet
    · exact hIE t₁ δ hIJ hag hδ
    · exfalso
      have hs : t₁ + δ / 2 ∈ Set.Ioo (t₁ - δ) (t₁ + δ) := ⟨by linarith, by linarith⟩
      obtain ⟨h1, h2⟩ := hrefl _ hs
      have hsJ := hIJ hs
      have hrJ : 2 * t₁ - (t₁ + δ / 2) ∈ Set.Ioo (-T) T := hIJ ⟨by linarith, by linarith⟩
      rw [hγ₁f _ hsJ, h1, hγ₂f _ hrJ] at h2
      have h3 : |t₁ + δ / 2| = |t₁ - δ / 2| := by
        have h4 : 2 * t₁ - (t₁ + δ / 2) = t₁ - δ / 2 := by ring
        rw [h4] at h2
        rw [← h2, abs_mul]
        rcases he₁ with rfl | rfl <;> simp
      rcases abs_eq_abs.1 h3 with h | h
      · linarith
      · exact ht₁0 (by linarith)
  have hclosed : closure (interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t}) ∩ Set.Ioo (-T) T ⊆
      interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} := by
    rintro t ⟨htc, htJ⟩
    have hmt : γ₁ t = γ₂ t := by
      have hsub : insert t (interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t}) ⊆
          Set.Ioo (-T) T := by
        rintro s (rfl | hs)
        · exact htJ
        · exact (hAE hs).1
      have h := Set.EqOn.of_subset_closure (fun s hs => (hAE hs).2)
        (hγ₁.continuousOn.mono hsub) (hγ₂.continuousOn.mono hsub) (Set.subset_insert _ _)
        (Set.insert_subset htc subset_closure)
      exact h (Set.mem_insert _ _)
    obtain ⟨δ, hδ, hIJ, hag | hrefl⟩ := hloc t htJ hmt
    · exact hIE t δ hIJ hag hδ
    · obtain ⟨s', hs'A, hd⟩ := Metric.mem_closure_iff.1 htc δ hδ
      by_cases hst : s' = t
      · rw [← hst]
        exact hs'A
      · exfalso
        rw [Real.dist_eq] at hd
        obtain ⟨hd1, hd2⟩ := abs_lt.1 hd
        have hs'I : s' ∈ Set.Ioo (t - δ) (t + δ) := ⟨by linarith, by linarith⟩
        have hrI : 2 * t - s' ∈ Set.Ioo (t - δ) (t + δ) := ⟨by linarith, by linarith⟩
        have h1 := (hrefl _ hrI).1
        rw [show 2 * t - (2 * t - s') = s' by ring, ← (hAE hs'A).2] at h1
        have h2 := hinj _ (hIJ hrI) _ (hIJ hs'I) h1
        exact hst (by linarith)
  have hJA : Set.Ioo (-T) T ⊆ interior {t | t ∈ Set.Ioo (-T) T ∧ γ₁ t = γ₂ t} :=
    isPreconnected_Ioo.subset_of_closure_inter_subset isOpen_interior ⟨t₁, ht₁, hstart⟩ hclosed
  intro t ht
  exact (hAE (hJA ht)).2

theorem regular_zero_set_local_param (Ω : Set E3) (hΩ : IsOpen Ω) (h : E3 → ℝ)
    (hh : ContDiffOn ℝ ∞ h Ω) (u₀ : E3) (hu₀ : u₀ ∈ Ω) (h0 : h u₀ = 0)
    (hd : fderiv ℝ h u₀ ≠ 0) :
    ∃ (W : Set E2) (Fh : E2 → E3) (x₀ : E2), IsOpen W ∧ x₀ ∈ W ∧ ContDiffOn ℝ ∞ Fh W ∧
      Fh x₀ = u₀ ∧ Set.InjOn Fh W ∧
      ∀ x ∈ W, Fh x ∈ Ω ∧ h (Fh x) = 0 ∧ Function.Injective (fderiv ℝ Fh x) :=
by
  classical
  set L : E3 →L[ℝ] ℝ := fderiv ℝ h u₀ with hLdef
  
  obtain ⟨w, hw⟩ : ∃ w, L w ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hd (ContinuousLinearMap.ext hcon)
  obtain ⟨v, hv⟩ : ∃ v : E3, L v = 1 :=
    ⟨(L w)⁻¹ • w, by rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hw]⟩
  
  set A : E3 →L[ℝ] E3 := ContinuousLinearMap.id ℝ E3 - L.smulRight v with hAdef
  have hA : ∀ z, A z = z - L z • v := fun z => by
    simp [hAdef]
  
  set P : E3 → E3 := fun u => h u • v + (A u - A u₀) with hPdef
  have hLP : ∀ u, L (P u) = h u := by
    intro u
    simp only [hPdef, hA, map_add, map_sub, map_smul, smul_eq_mul, hv]
    ring
  have hP0 : P u₀ = 0 := by
    simp only [hPdef, h0, zero_smul, sub_self, add_zero]
  have hPs : ContDiffOn ℝ ∞ P Ω :=
    (hh.smul contDiffOn_const).add ((A.contDiff.sub contDiff_const).contDiffOn)
  have hhd : ∀ u ∈ Ω, HasFDerivAt h (fderiv ℝ h u) u := fun u hu =>
    ((hh.contDiffAt (hΩ.mem_nhds hu)).differentiableAt (by simp)).hasFDerivAt
  have hPd : ∀ u ∈ Ω, HasFDerivAt P ((fderiv ℝ h u).smulRight v + A) u := by
    intro u hu
    exact ((hhd u hu).smul_const v).add (A.hasFDerivAt.sub_const (A u₀))
  have hDinj : ∀ u, fderiv ℝ h u v ≠ 0 →
      Function.Injective ((fderiv ℝ h u).smulRight v + A) := by
    intro u hu
    rw [injective_iff_map_eq_zero]
    intro z hz
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply, hA] at hz
    have h1 : fderiv ℝ h u z = 0 := by
      have h2 := congrArg L hz
      rw [map_add, map_smul, map_sub, map_smul, hv, map_zero, smul_eq_mul, smul_eq_mul] at h2
      linarith
    rw [h1, zero_smul, zero_add, sub_eq_zero] at hz
    have h2 : L z * fderiv ℝ h u v = 0 := by
      have h3 := congrArg (fderiv ℝ h u) hz
      rw [map_smul, smul_eq_mul, h1] at h3
      exact h3.symm
    have h3 : L z = 0 := (mul_eq_zero.mp h2).resolve_right hu
    rw [hz, h3, zero_smul]
  
  set U : Set E3 := Ω ∩ (fun u => fderiv ℝ h u v) ⁻¹' {0}ᶜ with hUdef
  have hcont : ContinuousOn (fun u => fderiv ℝ h u v) Ω :=
    (hh.continuousOn_fderiv_of_isOpen hΩ (by simp)).clm_apply continuousOn_const
  have hUo : IsOpen U := hcont.isOpen_inter_preimage hΩ isOpen_compl_singleton
  have hu₀U : u₀ ∈ U := by
    refine ⟨hu₀, ?_⟩
    show L v ∈ ({0}ᶜ : Set ℝ)
    rw [hv]
    exact one_ne_zero
  have hequiv : ∀ u ∈ U, ∃ E' : E3 ≃L[ℝ] E3,
      (E' : E3 →L[ℝ] E3) = (fderiv ℝ h u).smulRight v + A := by
    intro u hu
    have hi := hDinj u hu.2
    have hs : Function.Surjective ((fderiv ℝ h u).smulRight v + A) :=
      (LinearMap.injective_iff_surjective
        (f := (((fderiv ℝ h u).smulRight v + A : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3))).mp hi
    refine ⟨ContinuousLinearEquiv.ofBijective ((fderiv ℝ h u).smulRight v + A)
      (LinearMap.ker_eq_bot.mpr hi) (LinearMap.range_eq_top.mpr hs), ?_⟩
    exact ContinuousLinearEquiv.coe_ofBijective _ _ _
  have hcd : ∀ u ∈ Ω, ContDiffAt ℝ ∞ P u := fun u hu => hPs.contDiffAt (hΩ.mem_nhds hu)
  obtain ⟨E₀, hE₀⟩ := hequiv u₀ hu₀U
  have hPd₀ : HasFDerivAt P (E₀ : E3 →L[ℝ] E3) u₀ := by
    rw [hE₀]; exact hPd u₀ hu₀
  
  let Φ := ContDiffAt.toOpenPartialHomeomorph P (hcd u₀ hu₀) hPd₀ (by simp)
  have hΦc : (Φ : E3 → E3) = P := ContDiffAt.toOpenPartialHomeomorph_coe _ _ _
  have hsrc : u₀ ∈ Φ.source := ContDiffAt.mem_toOpenPartialHomeomorph_source _ _ _
  have htgt : P u₀ ∈ Φ.target := ContDiffAt.image_mem_toOpenPartialHomeomorph_target _ _ _
  set T : Set E3 := Φ.target ∩ Φ.symm ⁻¹' U with hTdef
  have hTo : IsOpen T := Φ.continuousOn_symm.isOpen_inter_preimage Φ.open_target hUo
  have hQP : Φ.symm (P u₀) = u₀ := by
    have := Φ.left_inv hsrc
    rw [hΦc] at this
    exact this
  have hPT : P u₀ ∈ T := ⟨htgt, by show Φ.symm (P u₀) ∈ U; rw [hQP]; exact hu₀U⟩
  have hQ : ∀ y ∈ T, Φ.symm y ∈ U ∧ P (Φ.symm y) = y ∧ ContDiffAt ℝ ∞ Φ.symm y ∧
      Function.Injective (fderiv ℝ Φ.symm y) := by
    intro y hy
    have hu : Φ.symm y ∈ U := hy.2
    obtain ⟨E', hE'⟩ := hequiv _ hu
    have hfd : HasFDerivAt Φ (E' : E3 →L[ℝ] E3) (Φ.symm y) := by
      rw [hΦc, hE']; exact hPd _ hu.1
    have hcd' : ContDiffAt ℝ ∞ Φ (Φ.symm y) := by
      rw [hΦc]; exact hcd _ hu.1
    have hPQ : P (Φ.symm y) = y := by
      have := Φ.right_inv hy.1
      rw [hΦc] at this
      exact this
    refine ⟨hu, hPQ, Φ.contDiffAt_symm hy.1 hfd hcd', ?_⟩
    rw [(Φ.hasFDerivAt_symm hy.1 hfd).fderiv]
    exact E'.symm.injective
  
  obtain ⟨J, hJi, hJL⟩ : ∃ J : E2 →L[ℝ] E3, Function.Injective J ∧ ∀ x, L (J x) = 0 := by
    have hsurj : LinearMap.range (L : E3 →ₗ[ℝ] ℝ) = ⊤ := by
      rw [LinearMap.range_eq_top]
      intro t
      refine ⟨t • v, ?_⟩
      show L (t • v) = t
      rw [map_smul, hv, smul_eq_mul, mul_one]
    have hrk := LinearMap.finrank_range_add_finrank_ker (L : E3 →ₗ[ℝ] ℝ)
    rw [hsurj, finrank_top, Module.finrank_self, finrank_euclideanSpace_fin] at hrk
    have hK : Module.finrank ℝ E2 = Module.finrank ℝ (LinearMap.ker (L : E3 →ₗ[ℝ] ℝ)) := by
      rw [finrank_euclideanSpace_fin]; omega
    let eK : E2 ≃ₗ[ℝ] LinearMap.ker (L : E3 →ₗ[ℝ] ℝ) := LinearEquiv.ofFinrankEq E2 _ hK
    refine ⟨LinearMap.toContinuousLinearMap
      ((LinearMap.ker (L : E3 →ₗ[ℝ] ℝ)).subtype ∘ₗ eK.toLinearMap), ?_, ?_⟩
    · intro x y hxy
      exact eK.injective (Subtype.val_injective hxy)
    · intro x
      exact LinearMap.mem_ker.mp (eK x).2
  
  refine ⟨J ⁻¹' T, fun x => Φ.symm (J x), 0, hTo.preimage J.continuous, ?_, ?_, ?_, ?_, ?_⟩
  · show J 0 ∈ T
    rw [map_zero, ← hP0]
    exact hPT
  · intro x hx
    exact ((hQ _ hx).2.2.1.comp x J.contDiff.contDiffAt).contDiffWithinAt
  · show Φ.symm (J 0) = u₀
    rw [map_zero, ← hP0]
    exact hQP
  · intro x hx x' hx' hxx'
    apply hJi
    calc J x = P (Φ.symm (J x)) := ((hQ _ hx).2.1).symm
      _ = P (Φ.symm (J x')) := congrArg P hxx'
      _ = J x' := (hQ _ hx').2.1
  · intro x hx
    refine ⟨(hQ _ hx).1.1, ?_, ?_⟩
    · rw [← hLP, (hQ _ hx).2.1]
      exact hJL x
    · have hQd : DifferentiableAt ℝ Φ.symm (J x) :=
        (hQ _ hx).2.2.1.differentiableAt (by simp)
      have hcomp : fderiv ℝ (fun x => Φ.symm (J x)) x = (fderiv ℝ Φ.symm (J x)).comp J := by
        have := fderiv_comp x hQd J.differentiableAt
        rw [ContinuousLinearMap.fderiv] at this
        exact this
      rw [hcomp]
      exact (hQ _ hx).2.2.2.comp hJi

theorem flow_graph_injective_immersion (τ : ℝ) (hτ : 0 < τ) (V : Set E3) (hV : IsOpen V)
    (Fhat : ℝ × E3 → E3) (hFs : ContDiffOn ℝ ∞ Fhat (Set.Ioo (-τ) τ ×ˢ V))
    (hker0 : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ V, ∀ w : E3, fderiv ℝ Fhat (t, u) (0, w) = 0 → w = 0)
    (hinj : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ V, ∀ u' ∈ V, Fhat (t, u) = Fhat (t, u') → u = u')
    (fh : E3 → ℝ) (T : Set E3) (hT : IsOpen T) (hfh : ContDiffOn ℝ ∞ fh T) (hVT : V ⊆ T)
    (haff : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ V, fh (Fhat (t, u)) = fh u + t)
    (hderiv : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ V, ∀ (a : ℝ) (w : E3),
      fderiv ℝ fh (Fhat (t, u)) (fderiv ℝ Fhat (t, u) (a, w)) = a + fderiv ℝ fh u w)
    (W : Set E2) (hW : IsOpen W) (Fh : E2 → E3) (hFh : ContDiffOn ℝ ∞ Fh W)
    (hFhV : ∀ x ∈ W, Fh x ∈ V) (hFh0 : ∀ x ∈ W, fh (Fh x) = 0)
    (hFhd : ∀ x ∈ W, Function.Injective (fderiv ℝ Fh x)) (hFhi : Set.InjOn Fh W)
    (μ : E2 → ℝ) (hμ : ContDiffOn ℝ ∞ μ W) (hμ0 : ∀ x ∈ W, μ x ≠ 0) :
    IsOpen {y : E3 | hpProj y ∈ W ∧ |y 0 * μ (hpProj y)| < τ} ∧
    ContDiffOn ℝ ∞ (fun y : E3 => Fhat (y 0 * μ (hpProj y), Fh (hpProj y)))
      {y : E3 | hpProj y ∈ W ∧ |y 0 * μ (hpProj y)| < τ} ∧
    Set.InjOn (fun y : E3 => Fhat (y 0 * μ (hpProj y), Fh (hpProj y)))
      {y : E3 | hpProj y ∈ W ∧ |y 0 * μ (hpProj y)| < τ} ∧
    (∀ y ∈ {y : E3 | hpProj y ∈ W ∧ |y 0 * μ (hpProj y)| < τ},
      Function.Injective (fderiv ℝ (fun y : E3 => Fhat (y 0 * μ (hpProj y), Fh (hpProj y))) y)) ∧
    (∀ x ∈ W, partialDeriv 0 (fun y : E3 => fh (Fhat (y 0 * μ (hpProj y), Fh (hpProj y))))
      (hpLift 0 x) = μ x) :=
by
  
  have hadd : ∀ a b : E3, hpProj (a + b) = hpProj a + hpProj b := by
    intro a b; ext i; fin_cases i <;> simp [hpProj]
  have hsmul : ∀ (c : ℝ) (a : E3), hpProj (c • a) = c • hpProj a := by
    intro c a; ext i; fin_cases i <;> simp [hpProj]
  obtain ⟨P, hP⟩ : ∃ P : E3 →L[ℝ] E2, hpProj = ⇑P :=
    ⟨LinearMap.toContinuousLinearMap
      { toFun := hpProj, map_add' := hadd, map_smul' := hsmul }, rfl⟩
  have hc0 : ∀ z : E3, (P z) 0 = z 1 := by
    intro z; rw [← hP]; simp [hpProj]
  have hc1 : ∀ z : E3, (P z) 1 = z 2 := by
    intro z; rw [← hP]; simp [hpProj]
  have hsep : ∀ y y' : E3, y 0 = y' 0 → P y = P y' → y = y' := by
    intro y y' h0 h
    have h1 : y 1 = y' 1 := by rw [← hc0 y, ← hc0 y', h]
    have h2 : y 2 = y' 2 := by rw [← hc1 y, ← hc1 y', h]
    ext j; fin_cases j
    exacts [h0, h1, h2]
  have hl0 : ∀ (t : ℝ) (x : E2), (hpLift t x) 0 = t := by
    intro t x; simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hlP : ∀ (t : ℝ) (x : E2), P (hpLift t x) = x := by
    intro t x; rw [← hP]; ext i; fin_cases i <;>
      simp [hpProj, hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hPe0 : P (e 0) = 0 := by
    rw [← hP]; ext i; fin_cases i <;> simp [hpProj, e, EuclideanSpace.single_apply]
  have he00 : (e 0 : E3) 0 = 1 := by simp [e]
  rw [hP]
  set Ω := {y : E3 | P y ∈ W ∧ |y 0 * μ (P y)| < τ} with hΩdef
  
  have hWp : IsOpen (P ⁻¹' W) := hW.preimage P.continuous
  have hk : ContDiffOn ℝ ∞ (fun y : E3 => y 0 * μ (P y)) (P ⁻¹' W) := by
    have h1 : ContDiffOn ℝ ∞ (fun y : E3 => y 0) (P ⁻¹' W) :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).contDiff.contDiffOn
    have h2 : ContDiffOn ℝ ∞ (fun y : E3 => μ (P y)) (P ⁻¹' W) :=
      hμ.comp P.contDiff.contDiffOn (fun y hy => hy)
    exact h1.mul h2
  have hΩo : IsOpen Ω :=
    (continuous_abs.comp_continuousOn hk.continuousOn).isOpen_inter_preimage hWp isOpen_Iio
  
  have hψs : ContDiffOn ℝ ∞ (fun y : E3 => (y 0 * μ (P y), Fh (P y))) Ω :=
    (hk.mono (fun y hy => hy.1)).prodMk
      ((hFh.comp P.contDiff.contDiffOn (fun y hy => hy)).mono (fun y hy => hy.1))
  have hmaps : Set.MapsTo (fun y : E3 => (y 0 * μ (P y), Fh (P y))) Ω
      (Set.Ioo (-τ) τ ×ˢ V) :=
    fun y hy => ⟨abs_lt.mp hy.2, hFhV _ hy.1⟩
  have hφs : ContDiffOn ℝ ∞ (fun y : E3 => Fhat (y 0 * μ (P y), Fh (P y))) Ω :=
    hFs.comp hψs hmaps
  
  have hval : ∀ y ∈ Ω, fh (Fhat (y 0 * μ (P y), Fh (P y))) = y 0 * μ (P y) := by
    intro y hy
    rw [haff _ (abs_lt.mp hy.2) _ (hFhV _ hy.1), hFh0 _ hy.1, zero_add]
  
  have hC3 : Set.InjOn (fun y : E3 => Fhat (y 0 * μ (P y), Fh (P y))) Ω := by
    intro y hy y' hy' h
    have h' : Fhat (y 0 * μ (P y), Fh (P y)) = Fhat (y' 0 * μ (P y'), Fh (P y')) := h
    have ht : y 0 * μ (P y) = y' 0 * μ (P y') := by
      calc y 0 * μ (P y) = fh (Fhat (y 0 * μ (P y), Fh (P y))) := (hval y hy).symm
        _ = fh (Fhat (y' 0 * μ (P y'), Fh (P y'))) := by rw [h']
        _ = y' 0 * μ (P y') := hval y' hy'
    rw [ht] at h'
    have hu := hinj _ (abs_lt.mp hy'.2) _ (hFhV _ hy.1) _ (hFhV _ hy'.1) h'
    have hx : P y = P y' := hFhi hy.1 hy'.1 hu
    rw [hx] at ht
    have h0 : y 0 = y' 0 := mul_right_cancel₀ (hμ0 _ hy'.1) ht
    exact hsep y y' h0 hx
  
  have hkd : ∀ y : E3, P y ∈ W → ∃ ℓ : E3 →L[ℝ] ℝ,
      HasFDerivAt (fun y : E3 => y 0 * μ (P y)) ℓ y ∧
      ∀ v : E3, ℓ v = v 0 * μ (P y) + y 0 * fderiv ℝ μ (P y) (P v) := by
    intro y hyW
    have hμd : DifferentiableAt ℝ μ (P y) :=
      (hμ.contDiffAt (hW.mem_nhds hyW)).differentiableAt (by simp)
    have h0 : HasFDerivAt (fun y : E3 => y 0) (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) y :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt
    have h1 : HasFDerivAt (fun y : E3 => μ (P y)) ((fderiv ℝ μ (P y)).comp P) y :=
      hμd.hasFDerivAt.comp y P.hasFDerivAt
    refine ⟨_, h0.mul h1, fun v => ?_⟩
    have hpv : (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) v = v 0 := rfl
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, smul_eq_mul, hpv]
    ring
  
  have htan : ∀ x ∈ W, ∀ z : E2, fderiv ℝ fh (Fh x) (fderiv ℝ Fh x z) = 0 := by
    intro x hx z
    have hFd : DifferentiableAt ℝ Fh x :=
      (hFh.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)
    have hfd : DifferentiableAt ℝ fh (Fh x) :=
      (hfh.contDiffAt (hT.mem_nhds (hVT (hFhV x hx)))).differentiableAt (by simp)
    have hev : (fh ∘ Fh) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun x' hx' => hFh0 x' hx')
    have h1 := hev.fderiv_eq (𝕜 := ℝ)
    rw [fderiv_comp x hfd hFd, fderiv_const_apply] at h1
    have h2 := congrArg (fun L : E2 →L[ℝ] ℝ => L z) h1
    simpa using h2
  
  have hC4 : ∀ y ∈ Ω,
      Function.Injective (fderiv ℝ (fun y : E3 => Fhat (y 0 * μ (P y), Fh (P y))) y) := by
    intro y hy
    have hyW : P y ∈ W := hy.1
    have ht : y 0 * μ (P y) ∈ Set.Ioo (-τ) τ := abs_lt.mp hy.2
    have hu : Fh (P y) ∈ V := hFhV _ hyW
    have hFd : DifferentiableAt ℝ Fh (P y) :=
      (hFh.contDiffAt (hW.mem_nhds hyW)).differentiableAt (by simp)
    obtain ⟨ℓ, hℓ, hℓv⟩ := hkd y hyW
    have hL : HasFDerivAt (fun y : E3 => Fh (P y)) ((fderiv ℝ Fh (P y)).comp P) y :=
      hFd.hasFDerivAt.comp y P.hasFDerivAt
    have hψ := hℓ.prodMk hL
    have hFhatd : DifferentiableAt ℝ Fhat (y 0 * μ (P y), Fh (P y)) :=
      (hFs.contDiffAt ((isOpen_Ioo.prod hV).mem_nhds ⟨ht, hu⟩)).differentiableAt (by simp)
    have hφd : HasFDerivAt (fun y : E3 => Fhat (y 0 * μ (P y), Fh (P y)))
        ((fderiv ℝ Fhat (y 0 * μ (P y), Fh (P y))).comp
          (ℓ.prod ((fderiv ℝ Fh (P y)).comp P))) y :=
      hFhatd.hasFDerivAt.comp y hψ
    rw [hφd.fderiv, injective_iff_map_eq_zero]
    intro v hv
    have hv' : fderiv ℝ Fhat (y 0 * μ (P y), Fh (P y))
        (ℓ v, fderiv ℝ Fh (P y) (P v)) = 0 := hv
    have hd := hderiv _ ht _ hu (ℓ v) (fderiv ℝ Fh (P y) (P v))
    rw [hv', map_zero, htan _ hyW, add_zero] at hd
    rw [← hd] at hv'
    have hw := hker0 _ ht _ hu _ hv'
    have hPv : P v = 0 := hFhd _ hyW (by rw [hw, map_zero])
    have hℓ0 : ℓ v = v 0 * μ (P y) := by
      rw [hℓv, hPv, map_zero, mul_zero, add_zero]
    have hv0 : v 0 = 0 := by
      have h3 : v 0 * μ (P y) = 0 := by rw [← hℓ0, ← hd]
      rcases mul_eq_zero.mp h3 with h | h
      · exact h
      · exact absurd h (hμ0 _ hyW)
    exact hsep v 0 (by rw [hv0]; rfl) (by rw [hPv, map_zero])
  
  have hC5 : ∀ x ∈ W, partialDeriv 0 (fun y : E3 => fh (Fhat (y 0 * μ (P y), Fh (P y))))
      (hpLift 0 x) = μ x := by
    intro x hx
    have hy1 : hpLift 0 x ∈ Ω :=
      ⟨by rw [hlP]; exact hx, by rw [hl0, zero_mul, abs_zero]; exact hτ⟩
    have hev : (fun y : E3 => fh (Fhat (y 0 * μ (P y), Fh (P y))))
        =ᶠ[𝓝 (hpLift 0 x)] (fun y : E3 => y 0 * μ (P y)) :=
      Filter.eventually_of_mem (hΩo.mem_nhds hy1) hval
    unfold partialDeriv
    rw [hev.fderiv_eq]
    obtain ⟨ℓ, hℓ, hℓv⟩ := hkd (hpLift 0 x) (by rw [hlP]; exact hx)
    rw [hℓ.fderiv, hℓv, hl0, hlP, hPe0, he00, map_zero]
    ring
  exact ⟨hΩo, hφs, hC3, hC4, hC5⟩

theorem partialDiffeomorph_of_injOn [IsManifold 𝓘(ℝ, E3) ∞ M] (z : M) (Ω : Set E3)
    (hΩ : IsOpen Ω) (φ : E3 → E3) (hφ : ContDiffOn ℝ ∞ φ Ω) (hinj : Set.InjOn φ Ω)
    (hφt : ∀ y ∈ Ω, φ y ∈ (chartAt E3 z).target)
    (hder : ∀ y ∈ Ω, Function.Injective (fderiv ℝ φ y)) :
    ∃ Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      Φ.source = Ω ∧ ∀ y ∈ Ω, Φ y = (chartAt E3 z).symm (φ y) :=
by
  classical
  
  have hstrict : ∀ y ∈ Ω, ∃ L : E3 ≃L[ℝ] E3, HasStrictFDerivAt φ (L : E3 →L[ℝ] E3) y := by
    intro y hy
    let Lin := LinearEquiv.ofInjectiveEndo
      ((fderiv ℝ φ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) (hder y hy)
    refine ⟨Lin.toContinuousLinearEquiv, ?_⟩
    have hφy : ContDiffAt ℝ ∞ φ y := hφ.contDiffAt (hΩ.mem_nhds hy)
    have h1 := hφy.hasStrictFDerivAt (by simp)
    have heq : ((Lin.toContinuousLinearEquiv : E3 ≃L[ℝ] E3) : E3 →L[ℝ] E3) = fderiv ℝ φ y :=
      ContinuousLinearMap.ext fun v => by simp [Lin]
    rw [heq]
    exact h1
  
  have hV : IsOpen (φ '' Ω) := by
    rw [isOpen_iff_mem_nhds]
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨L, hs⟩ := hstrict y hy
    rw [← hs.map_nhds_eq_of_equiv]
    exact Filter.image_mem_map (hΩ.mem_nhds hy)
  
  have hψpos : ∀ b ∈ φ '' Ω, Function.invFunOn φ Ω b ∈ Ω ∧
      φ (Function.invFunOn φ Ω b) = b := fun b hb => Function.invFunOn_pos hb
  have hψleft : ∀ y ∈ Ω, Function.invFunOn φ Ω (φ y) = y :=
    fun y hy => hinj.leftInvOn_invFunOn hy
  
  have hψsmooth : ∀ y ∈ Ω, ContDiffAt ℝ ∞ (Function.invFunOn φ Ω) (φ y) := by
    intro y hy
    obtain ⟨L, hs⟩ := hstrict y hy
    have hφy : ContDiffAt ℝ ∞ φ y := hφ.contDiffAt (hΩ.mem_nhds hy)
    have hyP : y ∈ (hs.toOpenPartialHomeomorph φ).source :=
      hs.mem_toOpenPartialHomeomorph_source
    have hPc : ((hs.toOpenPartialHomeomorph φ) : E3 → E3) = φ :=
      hs.toOpenPartialHomeomorph_coe
    have hbP : φ y ∈ (hs.toOpenPartialHomeomorph φ).target :=
      hs.image_mem_toOpenPartialHomeomorph_target
    have hPy : (hs.toOpenPartialHomeomorph φ).symm (φ y) = y := by
      have := (hs.toOpenPartialHomeomorph φ).left_inv hyP
      rwa [hPc] at this
    have hsymm : ContDiffAt ℝ ∞ (hs.toOpenPartialHomeomorph φ).symm (φ y) := by
      apply (hs.toOpenPartialHomeomorph φ).contDiffAt_symm hbP (f₀' := L)
      · rw [hPy, hPc]; exact hs.hasFDerivAt
      · rw [hPy, hPc]; exact hφy
    have hev : Function.invFunOn φ Ω =ᶠ[𝓝 (φ y)] (hs.toOpenPartialHomeomorph φ).symm := by
      have hN1 : (hs.toOpenPartialHomeomorph φ).target ∈ 𝓝 (φ y) :=
        (hs.toOpenPartialHomeomorph φ).open_target.mem_nhds hbP
      have hN2 : (hs.toOpenPartialHomeomorph φ).symm ⁻¹' Ω ∈ 𝓝 (φ y) := by
        apply ((hs.toOpenPartialHomeomorph φ).continuousAt_symm hbP).preimage_mem_nhds
        rw [hPy]; exact hΩ.mem_nhds hy
      filter_upwards [hN1, hN2] with b hb1 hb2
      have hφb : φ ((hs.toOpenPartialHomeomorph φ).symm b) = b := by
        have := (hs.toOpenPartialHomeomorph φ).right_inv hb1
        rwa [hPc] at this
      have h := hψpos b ⟨_, hb2, hφb⟩
      apply hinj h.1 hb2
      rw [h.2, hφb]
    exact hsymm.congr_of_eventuallyEq hev
  have hψon : ContDiffOn ℝ ∞ (Function.invFunOn φ Ω) (φ '' Ω) := by
    rintro _ ⟨y, hy, rfl⟩
    exact (hψsmooth y hy).contDiffWithinAt
  
  let e₀ : PartialEquiv E3 M :=
    { toFun := fun y => (chartAt E3 z).symm (φ y)
      invFun := fun w => Function.invFunOn φ Ω (chartAt E3 z w)
      source := Ω
      target := (chartAt E3 z).source ∩ (chartAt E3 z) ⁻¹' (φ '' Ω)
      map_source' := fun y hy => ⟨(chartAt E3 z).map_target (hφt y hy), by
        show (chartAt E3 z) ((chartAt E3 z).symm (φ y)) ∈ φ '' Ω
        rw [(chartAt E3 z).right_inv (hφt y hy)]
        exact ⟨y, hy, rfl⟩⟩
      map_target' := fun w hw => (hψpos _ hw.2).1
      left_inv' := fun y hy => by
        show Function.invFunOn φ Ω ((chartAt E3 z) ((chartAt E3 z).symm (φ y))) = y
        rw [(chartAt E3 z).right_inv (hφt y hy)]
        exact hψleft y hy
      right_inv' := fun w hw => by
        show (chartAt E3 z).symm (φ (Function.invFunOn φ Ω ((chartAt E3 z) w))) = w
        rw [(hψpos _ hw.2).2]
        exact (chartAt E3 z).left_inv hw.1 }
  have hto : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => (chartAt E3 z).symm (φ y)) Ω :=
    (contMDiffOn_chart_symm (x := z)).comp hφ.contMDiffOn (fun y hy => hφt y hy)
  have hinv : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞
      (fun w => Function.invFunOn φ Ω (chartAt E3 z w))
      ((chartAt E3 z).source ∩ (chartAt E3 z) ⁻¹' (φ '' Ω)) :=
    hψon.contMDiffOn.comp ((contMDiffOn_chart (x := z)).mono Set.inter_subset_left)
      (fun w hw => hw.2)
  refine ⟨{ toPartialEquiv := e₀
            open_source := hΩ
            open_target := (chartAt E3 z).isOpen_inter_preimage hV
            contMDiffOn_toFun := hto
            contMDiffOn_invFun := hinv }, rfl, fun y _ => rfl⟩

theorem defining_function_lapse_ratio [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig : Set M) (q : M) (hq : q ∈ Sig) (V₁ V₂ : Set M) (f₁ f₂ : M → ℝ)
    (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hq₁ : q ∈ V₁) (hq₂ : q ∈ V₂)
    (hf₁ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f₁) (hf₂ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f₂)
    (hd₁ : ∀ x ∈ V₁, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₁ x ≠ 0)
    (hd₂ : ∀ x ∈ V₂, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f₂ x ≠ 0)
    (hS₁ : V₁ ∩ Sig = V₁ ∩ f₁ ⁻¹' {0}) (hS₂ : V₂ ∩ Sig = V₂ ∩ f₂ ⁻¹' {0})
    (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3) (hy : y ∈ Φ.source) (hΦy : Φ y = q) :
    ∃ u : ℝ, u ≠ 0 ∧ g.gradInner f₂ f₂ q = u ^ 2 * g.gradInner f₁ f₁ q ∧
      partialDeriv 0 (fun y' => f₂ (Φ y')) y = u * partialDeriv 0 (fun y' => f₁ (Φ y')) y :=
by
  have coord_div : ∀ (U : Set E3) (hU : IsOpen U) (f h : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U)
      (hh : ContDiffOn ℝ ∞ h U) (y₀ : E3) (hy₀ : y₀ ∈ U) (hf0 : f y₀ = 0)
      (hdf : fderiv ℝ f y₀ ≠ 0) (hz : ∀ y ∈ U, f y = 0 → h y = 0),
      ∃ r : ℝ, 0 < r ∧ ∃ u : E3 → ℝ, Metric.ball y₀ r ⊆ U ∧
        ContDiffOn ℝ ∞ u (Metric.ball y₀ r) ∧ ∀ y ∈ Metric.ball y₀ r, h y = f y * u y := by
    intro U hU f h hf hh y₀ hy₀ hf0 hdf hz
    
    have s4 : ∀ (n : ℕ) (F : Type) [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
        (G : E3 → ℝ → F), ContDiff ℝ (n : WithTop ℕ∞) (Function.uncurry G) → ∀ a b : ℝ,
        ContDiff ℝ (n : WithTop ℕ∞) (fun z => ∫ t in a..b, G z t) := by
      intro n
      induction n with
      | zero =>
        intro F _ _ _ G hG a b
        rw [Nat.cast_zero, contDiff_zero] at hG ⊢
        exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hG a b
      | succ n ih =>
        intro F _ _ _ G hG a b
        rw [Nat.cast_succ] at hG ⊢
        rw [contDiff_succ_iff_hasFDerivAt]
        let D : E3 → ℝ → (E3 →L[ℝ] F) := fun z t =>
          (fderiv ℝ (Function.uncurry G) (z, t)).comp (ContinuousLinearMap.inl ℝ E3 ℝ)
        have hGd : Differentiable ℝ (Function.uncurry G) := hG.differentiable (by simp)
        have hDc : ContDiff ℝ n (Function.uncurry D) := by
          have h1 : ContDiff ℝ n (fderiv ℝ (Function.uncurry G)) := hG.fderiv_right le_rfl
          exact h1.clm_comp contDiff_const
        have hpt : ∀ z t, HasFDerivAt (fun z' => G z' t) (D z t) z := by
          intro z t
          have h := (hGd (z, t)).hasFDerivAt.comp z (hasFDerivAt_prodMk_left (𝕜 := ℝ) z t)
          exact h
        refine ⟨fun z => ∫ t in a..b, D z t, ih (E3 →L[ℝ] F) D hDc a b, fun z₀ => ?_⟩
        obtain ⟨C, hC⟩ := ((isCompact_closedBall z₀ 1).prod
          (isCompact_uIcc (a := a) (b := b))).exists_bound_of_continuousOn
          hDc.continuous.continuousOn
        have hGc : Continuous (Function.uncurry G) := hG.continuous
        have hGt : ∀ z, Continuous (G z) := fun z => hGc.comp (Continuous.prodMk_right z)
        have hDt : ∀ z, Continuous (D z) := fun z => hDc.continuous.comp (Continuous.prodMk_right z)
        haveI : SecondCountableTopologyEither ℝ (E3 →L[ℝ] F) :=
          secondCountableTopologyEither_of_left ℝ _
        haveI : SecondCountableTopologyEither ℝ F :=
          secondCountableTopologyEither_of_left ℝ _
        refine intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume)
          (bound := fun _ => C) (ball_mem_nhds z₀ one_pos)
          (Eventually.of_forall fun z => (hGt z).aestronglyMeasurable)
          ((hGt z₀).intervalIntegrable a b) (hDt z₀).aestronglyMeasurable ?_
          intervalIntegrable_const ?_
        · refine Eventually.of_forall fun t ht x hx => ?_
          exact hC (x, t) ⟨ball_subset_closedBall hx, Set.uIoc_subset_uIcc ht⟩
        · exact Eventually.of_forall fun t _ x _ => hpt x t
    
    have s2 : ∀ (φ : E3 →L[ℝ] ℝ) (w : E3), 1 + φ w ≠ 0 →
        ∃ A : E3 ≃L[ℝ] E3, (A : E3 →L[ℝ] E3) = ContinuousLinearMap.id ℝ E3 + φ.smulRight w := by
      intro φ w hw
      refine ⟨ContinuousLinearEquiv.equivOfInverse (ContinuousLinearMap.id ℝ E3 + φ.smulRight w)
        (ContinuousLinearMap.id ℝ E3 - (1 + φ w)⁻¹ • φ.smulRight w) ?_ ?_, rfl⟩
      · intro v
        simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.id_apply, ContinuousLinearMap.smul_apply,
          ContinuousLinearMap.smulRight_apply, map_add, map_smul, map_sub, smul_eq_mul]
        match_scalars <;> field_simp <;> ring
      · intro v
        simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.id_apply, ContinuousLinearMap.smul_apply,
          ContinuousLinearMap.smulRight_apply, map_add, map_smul, map_sub, smul_eq_mul]
        match_scalars <;> field_simp <;> ring
    
    have s5 : ∀ (c : E3) (ρ : ℝ) (k χ : E3 → ℝ), ContDiffOn ℝ ∞ k (Metric.ball c ρ) →
        ContDiff ℝ ∞ χ → (∀ z : E3, χ z ≠ 0 → dist z c < ρ / 2) →
        ContDiff ℝ ∞ (fun z => χ z * k z) := by
      intro c ρ k χ hk hχ hsupp
      rw [contDiff_iff_contDiffAt]
      intro z
      by_cases hzc : dist z c < ρ
      · exact (hχ.contDiffOn.mul hk).contDiffAt (Metric.isOpen_ball.mem_nhds hzc)
      · push_neg at hzc
        by_cases hρ : 0 < ρ
        · have hO : IsOpen {z' : E3 | ρ / 2 < dist z' c} :=
            isOpen_lt continuous_const (continuous_id.dist continuous_const)
          have hzO : z ∈ {z' : E3 | ρ / 2 < dist z' c} := by
            show ρ / 2 < dist z c
            linarith
          refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
          filter_upwards [hO.mem_nhds hzO] with z' hz'
          have : χ z' = 0 := by
            by_contra hne
            have := hsupp z' hne
            have h2 : ρ / 2 < dist z' c := hz'
            linarith
          simp [this]
        · have h0 : ∀ z', χ z' = 0 := by
            intro z'
            by_contra hne
            have := hsupp z' hne
            have := dist_nonneg (x := z') (y := c)
            push_neg at hρ
            linarith
          have : (fun z => χ z * k z) = fun _ => (0 : ℝ) := by
            funext z'; simp [h0 z']
          rw [this]
          exact contDiffAt_const
    
    have s3 : ∀ (K : E3 → ℝ), ContDiff ℝ ∞ K → ∀ (ℓ : E3 →L[ℝ] ℝ) (w : E3), ℓ w = 1 →
        (∀ z : E3, ℓ z = 0 → K z = 0) → ∀ z : E3,
        K z = ℓ z * ∫ t in (0:ℝ)..1, fderiv ℝ K (z - ((1 - t) * ℓ z) • w) w := by
      intro K hK ℓ w hw hK0 z
      set c := ℓ z with hc
      have hKd : Differentiable ℝ K := hK.differentiable (by simp)
      have hp : ∀ t : ℝ, HasDerivAt (fun t : ℝ => z - ((1 - t) * c) • w) (c • w) t := by
        intro t
        have h1 : HasDerivAt (fun t : ℝ => (1 - t) * c) (-c) t := by
          have := ((hasDerivAt_id t).const_sub 1).mul_const c
          simpa using this
        have h2 := (h1.smul_const w).const_sub z
        simpa using h2
      have hφ : ∀ t : ℝ, HasDerivAt (fun t : ℝ => K (z - ((1 - t) * c) • w))
