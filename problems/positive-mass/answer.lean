  set ψ : E2 → ℝ := fun x => c * ∫ y in K, g (x - y) with hψ
  obtain ⟨hψC, hψD⟩ := hpWH_conv_calculus K g ψ c hKc hgC hgS hc0.le (fun x => rfl)
  have h1 : ∀ x : E2, ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) ≤
