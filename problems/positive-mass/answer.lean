      ‖z - @inner ℝ E3 _ ν z • ν‖ < ρ₀ / 8 ∧ |@inner ℝ E3 _ ν z| < ρ₀ / 4 := by
    intro z hz
    have hzn : ‖z‖ < ρ₀ / 8 / 2 := mem_ball_zero_iff.1 hz
    refine ⟨lt_of_le_of_lt (hPle z) (by linarith), ?_⟩
    have := abs_real_inner_le_norm ν z
    rw [hν, one_mul] at this
    linarith
  refine ⟨f, Metric.ball 0 (ρ₀ / 8 / 2), hf, Metric.ball_mem_nhds _ (by positivity), hfd', ?_, ?_⟩
  · apply hnullB
    rintro z ⟨hz, hfz⟩
    obtain ⟨hzW, hin⟩ := hNfacts z hz
    have hfz' : f z < 0 := hfz
    rw [hfeq z hz] at hfz'
    exact (hUside z hzW hin).1 (by linarith)
  · apply hnullA
    rintro z ⟨hz, hfz⟩
    obtain ⟨hzW, hin⟩ := hNfacts z hz
    have hfz' : 0 < f z := hfz
    rw [hfeq z hz] at hfz'
    exact (hUside z hzW hin).2 (by linarith)

theorem sepPerMin_flat_regular (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3)
    (hU : IsOpen U) (h0U : (0 : E3) ∈ U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (hI : G 0 = 1) (hmin : sepIsPerMin G F U) :
    ∃ ε r₀ : ℝ, 0 < ε ∧ 0 < r₀ ∧ ∀ (r : ℝ) (ν : E3), 0 < r → r < r₀ → ‖ν‖ = 1 →
      volume (symmDiff {z : E3 | r • z ∈ F} {z : E3 | @inner ℝ E3 _ ν z < 0} ∩
        Metric.ball 0 1) ≤ ENNReal.ofReal ε →
      ∃ (f : E3 → ℝ) (N : Set E3), ContDiff ℝ 1 f ∧ N ∈ 𝓝 (0 : E3) ∧
        (∀ z ∈ N, fderiv ℝ f z ≠ 0) ∧ volume ((N ∩ {z | f z < 0}) \ F) = 0 ∧
        volume (N ∩ {z | 0 < f z} ∩ F) = 0 :=
by
  classical
  obtain ⟨η₁, c₀, hη₁, hc₀, hc₀1, hdens⟩ := sepPerMin_density_lower
  obtain ⟨η₀, ε₀, θ, C₀, hη₀, hε₀, hθ, hθ2, hC₀, himp⟩ := sepPerMin_improve_flatness
  
  obtain ⟨τ, hτdef⟩ : ∃ τ : ℝ,
      τ = min (ε₀ / 8) (min (θ / 128) (min (1 / (128 * (C₀ + 1))) (1 / 16))) := ⟨_, rfl⟩
  have hC1 : 0 < 128 * (C₀ + 1) := by linarith
  have hτ : 0 < τ := by
    rw [hτdef]
    exact lt_min (by linarith) (lt_min (by linarith) (lt_min (div_pos one_pos hC1) (by norm_num)))
  have hτε : τ ≤ ε₀ / 8 := by rw [hτdef]; exact min_le_left _ _
  have hτθ : τ ≤ θ / 128 := by rw [hτdef]; exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hτC : τ ≤ 1 / (128 * (C₀ + 1)) := by
    rw [hτdef]
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hτ16 : τ ≤ 1 / 16 := by
    rw [hτdef]
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
  have hCτ : 16 * C₀ * τ ≤ 1 / 8 := by
    have h1 : τ * (128 * (C₀ + 1)) ≤ 1 := (le_div_iff₀ hC1).1 hτC
    nlinarith
  obtain ⟨τ₀, hτ₀def⟩ : ∃ t : ℝ, t = 8 * τ := ⟨_, rfl⟩
  have hτ₀ : 0 < τ₀ := by rw [hτ₀def]; linarith
  have hτ₀θ : τ₀ ≤ θ / 16 := by rw [hτ₀def]; linarith
  have hτ₀ε : τ₀ ≤ ε₀ := by rw [hτ₀def]; linarith
  
  obtain ⟨R0', hR0', hballU⟩ := Metric.isOpen_iff.1 hU 0 h0U
  obtain ⟨R₀, hR₀def⟩ : ∃ t : ℝ, t = R0' / 2 := ⟨_, rfl⟩
  have hR₀ : 0 < R₀ := by rw [hR₀def]; linarith
  have hcbU : Metric.closedBall (0 : E3) R₀ ⊆ U :=
    (Metric.closedBall_subset_ball (by rw [hR₀def]; linarith)).trans hballU
  
  have hbd : ∀ i j : Fin 3, ∃ C : ℝ, ∀ y ∈ Metric.closedBall (0 : E3) R₀,
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ C := by
    intro i j
    have hc : ContinuousOn (fun y => fderiv ℝ (fun z => G z i j) y) U :=
      (hG i j).continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)
    exact (isCompact_closedBall (0 : E3) R₀).exists_bound_of_continuousOn (hc.mono hcbU)
  choose Cb hCb using hbd
  obtain ⟨M', hM'⟩ := Finite.exists_le (fun p : Fin 3 × Fin 3 => Cb p.1 p.2)
  obtain ⟨M, hMdef⟩ : ∃ t : ℝ, t = max M' 0 := ⟨_, rfl⟩
  have hM0 : 0 ≤ M := by rw [hMdef]; exact le_max_right _ _
  have hM : ∀ y ∈ Metric.closedBall (0 : E3) R₀, ∀ i j : Fin 3,
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ M := by
    intro y hy i j
    rw [hMdef]
    exact (hCb i j y hy).trans ((hM' (i, j)).trans (le_max_left _ _))
  
  have hη : 0 < min η₁ η₀ := lt_min hη₁ hη₀
  have hev : ∀ᶠ y in 𝓝 (0 : E3), ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ min η₁ η₀ := by
    refine Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => ?_
    have hc : ContinuousAt (fun y => G y i j) 0 :=
      (hG i j).continuousOn.continuousAt (hU.mem_nhds h0U)
    have h00 : G 0 i j = if i = j then (1 : ℝ) else 0 := by rw [hI, Matrix.one_apply]
    filter_upwards [hc.eventually (Metric.closedBall_mem_nhds (G 0 i j) hη)] with y hy
    have hy' := Metric.mem_closedBall.1 hy
    rw [Real.dist_eq, h00] at hy'
    exact hy'
  obtain ⟨δc, hδc, hδcb⟩ := Metric.eventually_nhds_iff.1 hev
  obtain ⟨R₁, hR₁def⟩ : ∃ t : ℝ, t = min R₀ δc := ⟨_, rfl⟩
  have hR₁ : 0 < R₁ := by rw [hR₁def]; exact lt_min hR₀ hδc
  have hR₁R₀ : R₁ ≤ R₀ := by rw [hR₁def]; exact min_le_left _ _
  have hR₁δ : R₁ ≤ δc := by rw [hR₁def]; exact min_le_right _ _
  have hU'U : Metric.ball (0 : E3) R₁ ⊆ U :=
    Metric.ball_subset_closedBall.trans ((Metric.closedBall_subset_closedBall hR₁R₀).trans hcbU)
  have hclose : ∀ y ∈ Metric.ball (0 : E3) R₁, ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ min η₁ η₀ :=
    fun y hy => hδcb (lt_of_lt_of_le (Metric.mem_ball.1 hy) hR₁δ)
  have hMU' : ∀ y ∈ Metric.ball (0 : E3) R₁, ∀ i j : Fin 3,
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ M :=
    fun y hy => hM y ((Metric.closedBall_subset_closedBall hR₁R₀) (Metric.ball_subset_closedBall hy))
  have hGU' : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball (0 : E3) R₁) :=
    fun i j => (hG i j).mono hU'U
  have hpdU' : ∀ y ∈ Metric.ball (0 : E3) R₁, (G y).PosDef := fun y hy => hpd y (hU'U hy)
  have hminU' : sepIsPerMin G F (Metric.ball 0 R₁) :=
    ⟨hmin.1, fun V hV hVc hVU => hmin.2.1 V hV hVc (hVU.trans hU'U),
      fun F'' V K h1 h2 h3 h4 h5 h6 h7 => hmin.2.2 F'' V K h1 h2 h3 (h4.trans hU'U) h5 h6 h7⟩
  
  have hsc : ∀ c : ℝ, 0 < c → ∀ S : Set E3,
      volume ((fun z : E3 => c • z) ⁻¹' S) = ENNReal.ofReal ((c ^ 3)⁻¹) * volume S := by
    intro c hc S
    rw [MeasureTheory.Measure.addHaar_preimage_smul volume hc.ne']
    simp [abs_of_pos hc]
  have hnull : ∀ c : ℝ, 0 < c → ∀ S : Set E3,
      volume ((fun z : E3 => c • z) ⁻¹' S) = 0 ↔ volume S = 0 := by
    intro c hc S
    rw [hsc c hc S, mul_eq_zero, ENNReal.ofReal_eq_zero]
    have : 0 < (c ^ 3)⁻¹ := by positivity
    constructor
    · rintro (h | h)
      · linarith
      · exact h
    · intro h
      exact Or.inr h
  
  have hB : ∀ c : ℝ, 0 < c → ∀ (S : Set E3) (x : E3),
      (∀ N ∈ 𝓝 (c • x), volume (N ∩ S) ≠ 0 ∧ volume (N \ S) ≠ 0) →
      ∀ N ∈ 𝓝 x, volume (N ∩ {z : E3 | c • z ∈ S}) ≠ 0 ∧
        volume (N \ {z : E3 | c • z ∈ S}) ≠ 0 := by
    intro c hc S x hx N hN
    have hN' : (fun y : E3 => c⁻¹ • y) ⁻¹' N ∈ 𝓝 (c • x) := by
      apply (continuous_const_smul c⁻¹).continuousAt.preimage_mem_nhds
      show N ∈ 𝓝 (c⁻¹ • c • x)
      rw [inv_smul_smul₀ hc.ne']
      exact hN
    obtain ⟨h1, h2⟩ := hx _ hN'
    have e1 : N ∩ {z : E3 | c • z ∈ S} =
        (fun z : E3 => c • z) ⁻¹' ((fun y : E3 => c⁻¹ • y) ⁻¹' N ∩ S) := by
      ext z
      simp [inv_smul_smul₀ hc.ne']
    have e2 : N \ {z : E3 | c • z ∈ S} =
        (fun z : E3 => c • z) ⁻¹' ((fun y : E3 => c⁻¹ • y) ⁻¹' N \ S) := by
      ext z
      simp [inv_smul_smul₀ hc.ne']
    rw [e1, e2]
    exact ⟨fun h => h1 ((hnull c hc _).1 h), fun h => h2 ((hnull c hc _).1 h)⟩
  refine ⟨c₀ * τ ^ 3 / 2, min (R₁ / 2) (η₀ * τ₀ / (M + 1)), by positivity,
    lt_min (by linarith) (div_pos (mul_pos hη₀ hτ₀) (by linarith)), ?_⟩
  intro r ν hr hrr₀ hν hL1
  have hrR : r < R₁ / 2 := lt_of_lt_of_le hrr₀ (min_le_left _ _)
  have hrM : r * (M + 1) < η₀ * τ₀ :=
    (lt_div_iff₀ (by linarith)).1 (lt_of_lt_of_le hrr₀ (min_le_right _ _))
  have hMr : M * r ≤ η₀ * τ₀ := by nlinarith
  
  by_cases h0 : ∀ N ∈ 𝓝 (0 : E3), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0
  swap
  · push_neg at h0
    obtain ⟨N, hN, hN0⟩ := h0
    have he0 : ‖(e 0 : E3)‖ = 1 := by simp [EuclideanSpace.norm_single]
    have hball : ∀ z ∈ Metric.ball (0 : E3) 1, |@inner ℝ E3 _ (e 0) z| < 1 := by
      intro z hz
      have h1 := abs_real_inner_le_norm (e 0) z
      rw [he0, one_mul] at h1
      have : ‖z‖ < 1 := by simpa using hz
      linarith
    have hfd : ∀ (b : ℝ) (z : E3), fderiv ℝ (fun w : E3 => @inner ℝ E3 _ (e 0) w + b) z ≠ 0 := by
      intro b z h
      have h2 : HasFDerivAt (fun w : E3 => @inner ℝ E3 _ (e 0) w + b) (innerSL ℝ (e 0)) z := by
        simpa using ((innerSL ℝ (e 0)).hasFDerivAt (x := z)).add_const b
      rw [h2.fderiv] at h
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e 0)) h
      simp at h3
    have hfc : ∀ b : ℝ, ContDiff ℝ 1 (fun w : E3 => @inner ℝ E3 _ (e 0) w + b) := by
      intro b
      have h : (fun w : E3 => @inner ℝ E3 _ (e 0) w + b) = fun w => innerSL ℝ (e 0) w + b := by
        funext w
        simp
      rw [h]
      exact (innerSL ℝ (e 0)).contDiff.add contDiff_const
    have hNb : N ∩ Metric.ball (0 : E3) 1 ∈ 𝓝 (0 : E3) :=
      Filter.inter_mem hN (Metric.ball_mem_nhds 0 one_pos)
    by_cases hF0 : volume (N ∩ F) = 0
    · refine ⟨fun w => @inner ℝ E3 _ (e 0) w + 2, N ∩ Metric.ball 0 1, hfc 2, hNb,
        fun z _ => hfd 2 z, ?_, ?_⟩
      · refine measure_mono_null ?_ measure_empty
        rintro z ⟨⟨⟨_, hz⟩, hz2⟩, _⟩
        have h1 := hball z hz
        have hz2' : @inner ℝ E3 _ (e 0) z + 2 < 0 := hz2
        have := (abs_lt.1 h1).1
        exact absurd hz2' (by linarith)
      · exact measure_mono_null
          (Set.inter_subset_inter_left F (Set.inter_subset_left.trans Set.inter_subset_left)) hF0
    · have hF1 := hN0 hF0
      refine ⟨fun w => @inner ℝ E3 _ (e 0) w + (-2), N ∩ Metric.ball 0 1, hfc (-2), hNb,
        fun z _ => hfd (-2) z, ?_, ?_⟩
      · exact measure_mono_null
          (Set.diff_subset_diff_left (Set.inter_subset_left.trans Set.inter_subset_left)) hF1
      · refine measure_mono_null ?_ measure_empty
        rintro z ⟨⟨⟨_, hz⟩, hz2⟩, _⟩
        have h1 := hball z hz
        have hz2' : 0 < @inner ℝ E3 _ (e 0) z + (-2) := hz2
        have := (abs_lt.1 h1).2
        exact absurd hz2' (by linarith)
  
  set F' : Set E3 := {z : E3 | r • z ∈ F} with hF'
  have hFF' : {z : E3 | r⁻¹ • z ∈ F'} = F := by
    ext z
    simp [hF', smul_inv_smul₀ hr.ne']
  
  have hdensF' : ∀ x ∈ Metric.ball (0 : E3) 1,
      (∀ N ∈ 𝓝 x, volume (N ∩ F') ≠ 0 ∧ volume (N \ F') ≠ 0) →
      ∀ s : ℝ, 0 < s → s ≤ 1 / 2 → ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (F' ∩ Metric.ball x s) ∧
        ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball x s \ F') := by
    intro x hx hxb s hs hs2
    have hxb' : ∀ N ∈ 𝓝 (r • x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0 := by
      have h := hB r⁻¹ (inv_pos.2 hr) F' (r • x) (by rwa [inv_smul_smul₀ hr.ne'])
      rwa [hFF'] at h
    have hxn : ‖x‖ < 1 := by simpa using hx
    have hsub : Metric.closedBall (r • x) (r * s) ⊆ Metric.ball 0 R₁ := by
      intro y hy
      rw [Metric.mem_closedBall] at hy
      rw [mem_ball_zero_iff]
      have h1 : ‖r • x‖ < r := by
        rw [norm_smul, Real.norm_of_nonneg hr.le]
        nlinarith
      have h2 := dist_triangle y (r • x) 0
      simp only [dist_zero_right] at h2
      have h3 : r * s ≤ r / 2 := by nlinarith
      linarith
    obtain ⟨hd1, hd2⟩ := hdens G F (Metric.ball 0 R₁) (r • x) (r * s) Metric.isOpen_ball hGU' hsymm
      hpdU' (fun y hy i j => (hclose y hy i j).trans (min_le_left _ _)) hminU' (mul_pos hr hs)
      hsub hxb'
    have hball_pre : (fun z : E3 => r • z) ⁻¹' Metric.ball (r • x) (r * s) = Metric.ball x s := by
      ext z
      simp only [Set.mem_preimage, Metric.mem_ball, dist_smul₀, Real.norm_of_nonneg hr.le]
      constructor
      · intro h
        nlinarith
      · intro h
        nlinarith
    have e1 : F' ∩ Metric.ball x s = (fun z : E3 => r • z) ⁻¹' (F ∩ Metric.ball (r • x) (r * s)) := by
      rw [Set.preimage_inter, hball_pre]
      rfl
    have e2 : Metric.ball x s \ F' = (fun z : E3 => r • z) ⁻¹' (Metric.ball (r • x) (r * s) \ F) := by
      rw [Set.preimage_diff, hball_pre]
      rfl
    have hval : ∀ A : Set E3, ENNReal.ofReal (c₀ * (r * s) ^ 3) ≤ volume A →
        ENNReal.ofReal (c₀ * s ^ 3) ≤ volume ((fun z : E3 => r • z) ⁻¹' A) := by
      intro A hA
      rw [hsc r hr A]
      have hr3 : r ^ 3 ≠ 0 := by positivity
      calc ENNReal.ofReal (c₀ * s ^ 3)
          = ENNReal.ofReal ((r ^ 3)⁻¹) * ENNReal.ofReal (c₀ * (r * s) ^ 3) := by
            rw [← ENNReal.ofReal_mul (by positivity)]
            congr 1
            first
              | (field_simp; ring)
              | field_simp
        _ ≤ _ := mul_le_mul_left' hA _
    rw [e1, e2]
    exact ⟨hval _ hd1, hval _ hd2⟩
  have hL1' : volume (symmDiff F' {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1) <
      ENNReal.ofReal (c₀ * τ ^ 3) := by
    refine lt_of_le_of_lt hL1 ?_
    rw [ENNReal.ofReal_lt_ofReal_iff (by positivity)]
    have : 0 < c₀ * τ ^ 3 := by positivity
    linarith
  obtain ⟨hs3a, hs3b, hs3c⟩ := sepFlat_L1_to_slab F' ν c₀ τ hν hc₀ hc₀1 hτ hτ16 hdensF' hL1'
  
  have hslab0 : ∀ z : E3, ‖z‖ < r / 2 →
      (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      |@inner ℝ E3 _ ν z| ≤ τ * r := by
    intro z hz hzb
    have h1 : ∀ N ∈ 𝓝 (r⁻¹ • z), volume (N ∩ F') ≠ 0 ∧ volume (N \ F') ≠ 0 :=
      hB r hr F (r⁻¹ • z) (by rwa [smul_inv_smul₀ hr.ne'])
    have h2 : r⁻¹ • z ∈ Metric.ball (0 : E3) (1 / 2) := by
      rw [mem_ball_zero_iff, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le),
        inv_mul_lt_iff₀ hr]
      linarith
    have h3 := hs3a _ h2 h1
    rw [real_inner_smul_right, abs_mul, abs_of_pos (inv_pos.2 hr), inv_mul_le_iff₀ hr] at h3
    linarith
  
  have hiter : ∀ x : E3, ‖x‖ < r / 4 / 2 →
      (∀ N ∈ 𝓝 x, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      ∀ k : ℕ, ∃ n : E3, ‖n‖ = 1 ∧ ‖n - ν‖ ≤ 2 * C₀ * τ₀ * (1 - (1 / 2) ^ k) ∧
        (∀ z ∈ Metric.ball x (r / 4 * θ ^ k),
          (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
          |@inner ℝ E3 _ n (z - x)| ≤ (τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k)) ∧
        volume ((Metric.ball x (r / 4 * θ ^ k) ∩
          {z | @inner ℝ E3 _ n (z - x) < -((τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k))}) \ F) = 0 ∧
        volume (Metric.ball x (r / 4 * θ ^ k) ∩
          {z | (τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k) < @inner ℝ E3 _ n (z - x)} ∩ F) = 0 := by
    intro x hx hxb k
    have hx' : ‖x‖ < r / 8 := by linarith
    have hxi := hslab0 x (by linarith) hxb
    induction k with
    | zero =>
      refine ⟨ν, hν, by simp, ?_, ?_, ?_⟩
      · intro z hz hzb
        simp only [pow_zero, mul_one] at hz ⊢
        have hz1 : ‖z - x‖ < r / 4 := by rwa [Metric.mem_ball, dist_eq_norm] at hz
        have hzn : ‖z‖ < r / 2 := by have := norm_sub_norm_le z x; linarith
        have h1 := hslab0 z hzn hzb
        rw [inner_sub_right, hτ₀def]
        calc |@inner ℝ E3 _ ν z - @inner ℝ E3 _ ν x|
            ≤ |@inner ℝ E3 _ ν z| + |@inner ℝ E3 _ ν x| := abs_sub _ _
          _ ≤ τ * r + τ * r := add_le_add h1 hxi
          _ = 8 * τ * (r / 4) := by ring
      · simp only [pow_zero, mul_one]
        have hsub : (Metric.ball x (r / 4) ∩
            {z | @inner ℝ E3 _ ν (z - x) < -(τ₀ * (r / 4))}) \ F ⊆
            (fun z : E3 => r⁻¹ • z) ⁻¹'
              ((Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ}) \ F') := by
          rintro z ⟨⟨hz1, hz2⟩, hz3⟩
          have hz1' : ‖z - x‖ < r / 4 := by rwa [Metric.mem_ball, dist_eq_norm] at hz1
          have hz2' : @inner ℝ E3 _ ν (z - x) < -(τ₀ * (r / 4)) := hz2
          have hzn : ‖z‖ < r / 2 := by have := norm_sub_norm_le z x; linarith
          rw [inner_sub_right, hτ₀def] at hz2'
          have hxi' := (abs_le.1 hxi).2
          rw [Set.mem_preimage, Set.mem_diff, Set.mem_inter_iff]
          refine ⟨⟨?_, ?_⟩, ?_⟩
          · rw [mem_ball_zero_iff, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le),
              inv_mul_lt_iff₀ hr]
            linarith
          · show @inner ℝ E3 _ ν (r⁻¹ • z) < -τ
            rw [real_inner_smul_right, inv_mul_lt_iff₀ hr]
            linarith
          · show r • (r⁻¹ • z) ∉ F
            rwa [smul_inv_smul₀ hr.ne']
        exact measure_mono_null hsub ((hnull r⁻¹ (inv_pos.2 hr) _).2 hs3b)
      · simp only [pow_zero, mul_one]
        have hsub : Metric.ball x (r / 4) ∩
            {z | τ₀ * (r / 4) < @inner ℝ E3 _ ν (z - x)} ∩ F ⊆
            (fun z : E3 => r⁻¹ • z) ⁻¹'
              (Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z} ∩ F') := by
          rintro z ⟨⟨hz1, hz2⟩, hz3⟩
          have hz1' : ‖z - x‖ < r / 4 := by rwa [Metric.mem_ball, dist_eq_norm] at hz1
          have hz2' : τ₀ * (r / 4) < @inner ℝ E3 _ ν (z - x) := hz2
          have hzn : ‖z‖ < r / 2 := by have := norm_sub_norm_le z x; linarith
          rw [inner_sub_right, hτ₀def] at hz2'
          have hxi' := (abs_le.1 hxi).1
          rw [Set.mem_preimage, Set.mem_inter_iff, Set.mem_inter_iff]
          refine ⟨⟨?_, ?_⟩, ?_⟩
          · rw [mem_ball_zero_iff, norm_smul, Real.norm_of_nonneg (inv_nonneg.2 hr.le),
              inv_mul_lt_iff₀ hr]
            linarith
          · show τ < @inner ℝ E3 _ ν (r⁻¹ • z)
            rw [real_inner_smul_right, lt_inv_mul_iff₀ hr]
            linarith
          · show r • (r⁻¹ • z) ∈ F
            rwa [smul_inv_smul₀ hr.ne']
        exact measure_mono_null hsub ((hnull r⁻¹ (inv_pos.2 hr) _).2 hs3c)
    | succ k ih =>
      obtain ⟨n, hn1, hnν, hsl, hbe, hab⟩ := ih
      have hθk : θ ^ k ≤ (1 / 2) ^ k := pow_le_pow_left₀ hθ.le hθ2 k
      have hθk1 : θ ^ k ≤ 1 := pow_le_one₀ hθ.le (by linarith)
      have hhk0 : 0 < (1 / 2 : ℝ) ^ k := by positivity
      have hhk1 : (1 / 2 : ℝ) ^ k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
      have hρ : 0 < r / 4 * θ ^ k := by positivity
      have hρle : r / 4 * θ ^ k ≤ r / 4 := mul_le_of_le_one_right (by positivity) hθk1
      have hρle2 : r / 4 * θ ^ k ≤ r * (1 / 2) ^ k := by
        have := mul_le_mul_of_nonneg_left hθk (by positivity : (0 : ℝ) ≤ r / 4)
        nlinarith
      have hcb : Metric.closedBall x (r / 4 * θ ^ k) ⊆ Metric.ball 0 R₁ := by
        intro y hy
        rw [Metric.mem_closedBall, dist_eq_norm] at hy
        rw [mem_ball_zero_iff]
        have := norm_sub_norm_le y x
        linarith
      have hbounds : ∀ y ∈ Metric.ball x (r / 4 * θ ^ k), ∀ i j : Fin 3,
          |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ η₀ ∧
          ‖fderiv ℝ (fun z => G z i j) y‖ * (r / 4 * θ ^ k) ≤ η₀ * (τ₀ * (1 / 2) ^ k) := by
        intro y hy i j
        have hyU : y ∈ Metric.ball (0 : E3) R₁ := hcb (Metric.ball_subset_closedBall hy)
        refine ⟨(hclose y hyU i j).trans (min_le_right _ _), ?_⟩
        have hMy := hMU' y hyU i j
        calc ‖fderiv ℝ (fun z => G z i j) y‖ * (r / 4 * θ ^ k) ≤ M * (r / 4 * θ ^ k) :=
              mul_le_mul_of_nonneg_right hMy hρ.le
          _ ≤ M * (r * (1 / 2) ^ k) := mul_le_mul_of_nonneg_left hρle2 hM0
          _ = (M * r) * (1 / 2) ^ k := by ring
          _ ≤ (η₀ * τ₀) * (1 / 2) ^ k := mul_le_mul_of_nonneg_right hMr hhk0.le
          _ = η₀ * (τ₀ * (1 / 2) ^ k) := by ring
      have hτk : τ₀ * (1 / 2) ^ k ≤ ε₀ :=
        calc τ₀ * (1 / 2) ^ k ≤ τ₀ * 1 := mul_le_mul_of_nonneg_left hhk1 hτ₀.le
          _ ≤ ε₀ := by linarith
      obtain ⟨ν', hν'1, hν'n, hs', hb', ha'⟩ := himp G F (Metric.ball 0 R₁) x n (r / 4 * θ ^ k)
        (τ₀ * (1 / 2) ^ k) Metric.isOpen_ball hGU' hsymm hpdU' hminU' hρ hcb hbounds
        (mul_pos hτ₀ hhk0) hτk hn1 hxb hsl hbe hab
      have e1 : θ * (r / 4 * θ ^ k) = r / 4 * θ ^ (k + 1) := by ring
      have e2 : τ₀ * (1 / 2) ^ k / 2 = τ₀ * (1 / 2) ^ (k + 1) := by ring
      rw [e1, e2] at hs' hb' ha'
      refine ⟨ν', hν'1, ?_, hs', hb', ha'⟩
      calc ‖ν' - ν‖ ≤ ‖ν' - n‖ + ‖n - ν‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
        _ ≤ C₀ * (τ₀ * (1 / 2) ^ k) + 2 * C₀ * τ₀ * (1 - (1 / 2) ^ k) := add_le_add hν'n hnν
        _ = 2 * C₀ * τ₀ * (1 - (1 / 2) ^ (k + 1)) := by ring
  have hdec : ∀ x : E3, ‖x‖ < r / 4 / 2 →
      (∀ N ∈ 𝓝 x, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      ∀ k : ℕ, ∃ n : E3, ‖n‖ = 1 ∧ ‖n - ν‖ ≤ 1 / 8 ∧
        (∀ z ∈ Metric.ball x (r / 4 * θ ^ k),
          (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
          |@inner ℝ E3 _ n (z - x)| ≤ (τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k)) ∧
        volume ((Metric.ball x (r / 4 * θ ^ k) ∩
          {z | @inner ℝ E3 _ n (z - x) < -((τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k))}) \ F) = 0 ∧
        volume (Metric.ball x (r / 4 * θ ^ k) ∩
          {z | (τ₀ * (1 / 2) ^ k) * (r / 4 * θ ^ k) < @inner ℝ E3 _ n (z - x)} ∩ F) = 0 := by
    intro x hx hxb k
    obtain ⟨n, hn1, hnν, h1, h2, h3⟩ := hiter x hx hxb k
    refine ⟨n, hn1, ?_, h1, h2, h3⟩
    have hk0 : 0 ≤ (1 / 2 : ℝ) ^ k := by positivity
    have hCt : 0 ≤ C₀ * τ₀ := mul_nonneg hC₀ hτ₀.le
    have h4 : 2 * C₀ * τ₀ * (1 - (1 / 2) ^ k) ≤ 2 * C₀ * τ₀ := by nlinarith
    have h5 : 2 * C₀ * τ₀ ≤ 1 / 8 := by rw [hτ₀def]; linarith
    linarith
  exact sepSlabDecay_C1_levelset F ν θ τ₀ (r / 4) hν hθ hθ2 hτ₀ hτ₀θ (by positivity) h0 hdec

theorem sepRescale (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef) (hmin : sepIsPerMin G F U) (r : ℝ) (hr : 0 < r) : sepIsPerMin (fun z => G (r • z)) {z : E3 | r • z ∈ F} {z : E3 | r • z ∈ U} ∧ ∀ ρ : ℝ, 0 < ρ → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) {z : E3 | r • z ∈ F} (Metric.ball 0 ρ) = ENNReal.ofReal (r⁻¹ ^ 2) * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball 0 (r * ρ)) :=
by
  obtain ⟨L, hL⟩ : ∃ L : E3 ≃L[ℝ] E3, ∀ w : E3, L w = r • w :=
    ⟨(LinearEquiv.smulOfNeZero ℝ E3 r hr.ne').toContinuousLinearEquiv, fun w => rfl⟩
  have hc : (0 : ℝ) < r⁻¹ ^ 2 := pow_pos (inv_pos.2 hr) 2
  have hfd : ∀ z : E3, fderiv ℝ (fun w : E3 => (0 : E3) + L w) z = (L : E3 →L[ℝ] E3) := by
    intro z
    rw [fderiv_const_add]
    exact L.fderiv
  have hs1 : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (z : E3),
      (r⁻¹ ^ 2) • pullbackMetric H (fun w => (0 : E3) + L w) z = H (r • z) := by
    intro H z
    ext a b
    simp only [Matrix.smul_apply, pullbackMetric, hfd]
    simp [ContinuousLinearEquiv.coe_coe, hL, EuclideanSpace.single_apply,
      Finset.sum_ite_eq', Finset.sum_ite_eq, mul_ite, ite_mul]
    field_simp
  have hpre : ∀ S : Set E3, (fun w : E3 => (0 : E3) + L w) ⁻¹' S = {z : E3 | r • z ∈ S} := by
    intro S
    ext z
    simp only [Set.mem_preimage, Set.mem_setOf_eq, zero_add, hL]
  have hfun : (fun z => (r⁻¹ ^ 2) • pullbackMetric G (fun w => (0 : E3) + L w) z) =
      fun z => G (r • z) := funext (hs1 G)
  have hfun1 : (fun z => (r⁻¹ ^ 2) • pullbackMetric (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
      (fun w => (0 : E3) + L w) z) = fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ) :=
    funext (hs1 (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)))
  have hball : ∀ ρ : ℝ, {z : E3 | r • z ∈ Metric.ball (0 : E3) (r * ρ)} = Metric.ball 0 ρ := by
    intro ρ
    ext z
    simp only [Set.mem_setOf_eq, mem_ball_zero_iff, norm_smul, Real.norm_eq_abs, abs_of_pos hr]
    constructor
    · intro h
      exact lt_of_mul_lt_mul_left h hr.le
    · intro h
      exact mul_lt_mul_of_pos_left h hr
  have hA := sepAffinePullback G F U hU hmin.1 hG hsymm hpd 0 L (r⁻¹ ^ 2) hc
  have hmin' := hA.2.2.2.2 hmin
  rw [hfun, hpre F, hpre U] at hmin'
  refine ⟨hmin', fun ρ _ => ?_⟩
  have hsym1 : ∀ (y : E3) (i j : Fin 3), (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j =
      (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y j i := by
    intro y i j
    show (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) j i
    by_cases h : i = j
    · subst h
      rfl
    · rw [Matrix.one_apply_ne h, Matrix.one_apply_ne (Ne.symm h)]
  have h2 := (sepAffinePullback (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F Set.univ isOpen_univ
    hmin.1 (fun i j => contDiffOn_const) hsym1 (fun y _ => Matrix.PosDef.one) 0 L (r⁻¹ ^ 2)
    hc).1 (Metric.ball 0 (r * ρ)) (Set.subset_univ _)
  rw [hfun1, hpre F, hpre, hball ρ] at h2
  exact h2

theorem sepPerG_near_id_compare (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3) (η : ℝ) (hV : IsOpen V) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) (hη0 : 0 ≤ η) (hη : η ≤ 1 / 12) (hclose : ∀ y ∈ V, ∀ i j : Fin 3, |G y i j - (if i = j then (1:ℝ) else 0)| ≤ η) (S : Set E3) : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * sepPerG G S V ∧ sepPerG G S V ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V :=
by
  classical
  
  have h1m : 0 < 1 - 4 * η := by linarith
  have h1p : 0 < 1 + 4 * η := by linarith
  have hηη : η * η ≤ η / 12 := by nlinarith
  have hηηη : η * η * η ≤ η / 144 := by nlinarith [mul_nonneg hη0 hη0]
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = (1 - 4 * η) / (1 + 4 * η) := ⟨_, rfl⟩
  have hc0 : 0 ≤ c := by rw [hc]; exact div_nonneg h1m.le h1p.le
  have hcle1 : c ≤ 1 := by rw [hc, div_le_one h1p]; linarith
  have hcm : c * (1 + 4 * η) = 1 - 4 * η := by rw [hc]; exact div_mul_cancel₀ _ (ne_of_gt h1p)
  have hl0 : 0 ≤ (1 + 4 * η) / (1 - 4 * η) := div_nonneg h1p.le h1m.le
  have hlc : (1 + 4 * η) / (1 - 4 * η) * c = 1 := by
    rw [hc, div_mul_div_comm, mul_comm (1 + 4 * η)]
    exact div_self (mul_ne_zero (ne_of_gt h1m) (ne_of_gt h1p))
  have hc2 : c ^ 2 * (1 + 4 * η) ≤ 1 - 4 * η := by
    have e : c ^ 2 * (1 + 4 * η) = c * (1 - 4 * η) := by rw [← hcm]; ring
    rw [e]
    nlinarith
  
  have htrip : ∀ a b c A B C : ℝ, |a| ≤ A → |b| ≤ B → |c| ≤ C → |a * b * c| ≤ A * B * C := by
    intro a b c A B C ha hb hc
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)) hc
      (abs_nonneg _) (mul_nonneg ((abs_nonneg _).trans ha) ((abs_nonneg _).trans hb))
  
  have hdetB : ∀ M : Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, |M i j - (if i = j then (1 : ℝ) else 0)| ≤ η) →
      1 - 4 * η ≤ M.det ∧ M.det ≤ 1 + 4 * η := by
    intro M hM
    have d0 : |M 0 0 - 1| ≤ η := by simpa using hM 0 0
    have d1 : |M 1 1 - 1| ≤ η := by simpa using hM 1 1
    have d2 : |M 2 2 - 1| ≤ η := by simpa using hM 2 2
    have o01 : |M 0 1| ≤ η := by simpa using hM 0 1
    have o02 : |M 0 2| ≤ η := by simpa using hM 0 2
    have o10 : |M 1 0| ≤ η := by simpa using hM 1 0
    have o12 : |M 1 2| ≤ η := by simpa using hM 1 2
    have o20 : |M 2 0| ≤ η := by simpa using hM 2 0
    have o21 : |M 2 1| ≤ η := by simpa using hM 2 1
    obtain ⟨d0l, d0u⟩ := abs_le.mp d0
    obtain ⟨d1l, d1u⟩ := abs_le.mp d1
    obtain ⟨d2l, d2u⟩ := abs_le.mp d2
    have a0 : |M 0 0| ≤ 1 + η := abs_le.mpr ⟨by linarith, by linarith⟩
    have a1 : |M 1 1| ≤ 1 + η := abs_le.mpr ⟨by linarith, by linarith⟩
    have a2 : |M 2 2| ≤ 1 + η := abs_le.mpr ⟨by linarith, by linarith⟩
    have p1 : (1 - η) * (1 - η) ≤ M 0 0 * M 1 1 :=
      mul_le_mul (by linarith) (by linarith) (by linarith) (by linarith)
    have p2 : (1 - η) * (1 - η) * (1 - η) ≤ M 0 0 * M 1 1 * M 2 2 :=
      mul_le_mul p1 (by linarith) (by linarith) ((mul_self_nonneg (1 - η)).trans p1)
    have pu := abs_le.mp (htrip _ _ _ _ _ _ a0 a1 a2)
    have t1 := abs_le.mp (htrip _ _ _ _ _ _ a0 o12 o21)
    have t2 := abs_le.mp (htrip _ _ _ _ _ _ o01 o10 a2)
    have t3 := abs_le.mp (htrip _ _ _ _ _ _ o01 o12 o20)
    have t4 := abs_le.mp (htrip _ _ _ _ _ _ o02 o10 o21)
    have t5 := abs_le.mp (htrip _ _ _ _ _ _ o02 a1 o20)
    rw [Matrix.det_fin_three]
    constructor
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
  
  have hpair : ∀ a x y : ℝ, |a| ≤ η → |a * x * y| ≤ η * ((x ^ 2 + y ^ 2) / 2) := by
    intro a x y ha
    rw [abs_mul, abs_mul, mul_assoc]
    have h1 : |x| * |y| ≤ (x ^ 2 + y ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x| - |y|), sq_abs x, sq_abs y]
    exact mul_le_mul ha h1 (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hη0
  have hquad : ∀ M : Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, |M i j - (if i = j then (1 : ℝ) else 0)| ≤ η) → ∀ v : Fin 3 → ℝ,
      (1 - 3 * η) * ∑ i : Fin 3, v i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, M i j * v i * v j ∧
      ∑ i : Fin 3, ∑ j : Fin 3, M i j * v i * v j ≤ (1 + 3 * η) * ∑ i : Fin 3, v i ^ 2 := by
    intro M hM v
    have d0 : |M 0 0 - 1| ≤ η := by simpa using hM 0 0
    have d1 : |M 1 1 - 1| ≤ η := by simpa using hM 1 1
    have d2 : |M 2 2 - 1| ≤ η := by simpa using hM 2 2
    have o01 : |M 0 1| ≤ η := by simpa using hM 0 1
    have o02 : |M 0 2| ≤ η := by simpa using hM 0 2
    have o10 : |M 1 0| ≤ η := by simpa using hM 1 0
    have o12 : |M 1 2| ≤ η := by simpa using hM 1 2
    have o20 : |M 2 0| ≤ η := by simpa using hM 2 0
    have o21 : |M 2 1| ≤ η := by simpa using hM 2 1
    have q00 := abs_le.mp (hpair _ (v 0) (v 0) d0)
    have q11 := abs_le.mp (hpair _ (v 1) (v 1) d1)
    have q22 := abs_le.mp (hpair _ (v 2) (v 2) d2)
    have q01 := abs_le.mp (hpair _ (v 0) (v 1) o01)
    have q02 := abs_le.mp (hpair _ (v 0) (v 2) o02)
    have q10 := abs_le.mp (hpair _ (v 1) (v 0) o10)
    have q12 := abs_le.mp (hpair _ (v 1) (v 2) o12)
    have q20 := abs_le.mp (hpair _ (v 2) (v 0) o20)
    have q21 := abs_le.mp (hpair _ (v 2) (v 1) o21)
    simp only [Fin.sum_univ_three]
    constructor
    · linarith [q00.1, q11.1, q22.1, q01.1, q02.1, q10.1, q12.1, q20.1, q21.1]
    · linarith [q00.2, q11.2, q22.2, q01.2, q02.2, q10.2, q12.2, q20.2, q21.2]
  
  have hsmul : ∀ (h : E3 → ℝ), ContDiffOn ℝ ∞ h V → ∀ X : E3 → E3, ContDiff ℝ ∞ X →
      tsupport X ⊆ V → ContDiff ℝ ∞ (fun z => h z • X z) := by
    intro h hh X hX hXU
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ V
    · exact (hh.contDiffAt (hV.mem_nhds hz)).smul hX.contDiffAt
    · have hz' : z ∉ tsupport X := fun h' => hz (hXU h')
      have hev : X =ᶠ[𝓝 z] 0 := (notMem_tsupport_iff_eventuallyEq).mp hz'
      have hev' : (fun w => h w • X w) =ᶠ[𝓝 z] (fun _ => (0 : E3)) := by
        filter_upwards [hev] with w hw
        rw [hw, Pi.zero_apply, smul_zero]
      exact contDiffAt_const.congr_of_eventuallyEq hev'
  
  have hdetC : ContDiffOn ℝ ∞ (fun y => (G y).det) V := by
    have hfun : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1 - G y 0 1 * G y 1 0 * G y 2 2
        + G y 0 1 * G y 1 2 * G y 2 0 + G y 0 2 * G y 1 0 * G y 2 1
        - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [hfun]
    have e1 := ((hG 0 0).mul (hG 1 1)).mul (hG 2 2)
    have e2 := ((hG 0 0).mul (hG 1 2)).mul (hG 2 1)
    have e3 := ((hG 0 1).mul (hG 1 0)).mul (hG 2 2)
    have e4 := ((hG 0 1).mul (hG 1 2)).mul (hG 2 0)
    have e5 := ((hG 0 2).mul (hG 1 0)).mul (hG 2 1)
    have e6 := ((hG 0 2).mul (hG 1 1)).mul (hG 2 0)
    exact ((((e1.sub e2).sub e3).add e4).add e5).sub e6
  have hpos : ∀ y ∈ V, 0 < (G y).det := fun y hy => by
    linarith [(hdetB _ (hclose y hy)).1]
  have hsqrtC : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) V :=
    hdetC.sqrt (fun y hy => (hpos y hy).ne')
  have hinvC : ContDiffOn ℝ ∞ (fun y => (Real.sqrt (G y).det)⁻¹) V :=
    hsqrtC.inv (fun y hy => (Real.sqrt_pos.2 (hpos y hy)).ne')
  
  have hsq1 : ∀ y v : E3, ∑ i : Fin 3, ∑ j : Fin 3,
      (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j * v i * v j = ∑ i : Fin 3, v i ^ 2 := by
    intro y v
    simp [Fin.sum_univ_three, Matrix.one_apply]
    ring
  
  have hK : ∀ G1 G2 : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ X : E3 → E3, (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ V ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G1 y i j * X y i * X y j ≤ 1) →
        ∃ Y : E3 → E3, (ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧ tsupport Y ⊆ V ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G2 y i j * Y y i * Y y j ≤ 1) ∧
          ∀ y, sepDensDiv G2 Y y = c * sepDensDiv G1 X y) →
      sepPerG G1 S V ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * sepPerG G2 S V := by
    intro G1 G2 hT
    unfold sepPerG
    refine iSup₂_le fun X hX => ?_
    obtain ⟨Y, hY, hd⟩ := hT X hX
    have hint : ∫ y in S, sepDensDiv G1 X y =
        (1 + 4 * η) / (1 - 4 * η) * ∫ y in S, sepDensDiv G2 Y y := by
      simp_rw [hd]
      rw [integral_const_mul, ← mul_assoc, hlc, one_mul]
    rw [hint, ENNReal.ofReal_mul hl0]
    refine mul_le_mul_left' ?_ _
    exact le_iSup_of_le Y (le_iSup_of_le hY le_rfl)
  
  have hD : ∀ (G1 G2 : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X1 X2 : E3 → E3),
      (∀ z (i : Fin 3), Real.sqrt (G2 z).det * X2 z i = c * (Real.sqrt (G1 z).det * X1 z i)) →
      ∀ y, sepDensDiv G2 X2 y = c * sepDensDiv G1 X1 y := by
    intro G1 G2 X1 X2 h y
    unfold sepDensDiv
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hf : (fun z => Real.sqrt (G2 z).det * X2 z i) =
        c • (fun z => Real.sqrt (G1 z).det * X1 z i) := by
      funext z
      rw [Pi.smul_apply, smul_eq_mul, h z i]
    unfold partialDeriv
    rw [hf, fderiv_const_smul_of_field]
    simp only [Pi.smul_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have dir1 : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤
      ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * sepPerG G S V := by
    refine hK (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) G fun X hX => ?_
    obtain ⟨hXs, hXc, hXV, hXb⟩ := hX
    have hX0 : ∀ z, z ∉ V → X z = 0 := fun z hz =>
      image_eq_zero_of_notMem_tsupport (fun h' => hz (hXV h'))
    obtain ⟨a, ha⟩ : ∃ a : E3 → ℝ, a = fun z => c * (Real.sqrt (G z).det)⁻¹ := ⟨_, rfl⟩
    have haz : ∀ z, a z = c * (Real.sqrt (G z).det)⁻¹ := fun z => by rw [ha]
    have haC : ContDiffOn ℝ ∞ a V := by
      rw [ha]
      exact contDiffOn_const.mul hinvC
    refine ⟨fun z => a z • X z, ⟨?_, ?_, ?_, ?_⟩, hD _ _ _ _ ?_⟩
    · exact hsmul a haC X hXs hXV
    · refine hXc.mono ?_
      intro z hz h0
      apply hz
      show a z • X z = 0
      rw [h0, smul_zero]
    · exact (tsupport_smul_subset_right _ _).trans hXV
    · intro y
      show ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a y • X y) i * (a y • X y) j ≤ 1
      have hYi : ∀ i : Fin 3, (a y • X y) i = a y * X y i := fun i => by simp
      simp only [hYi]
      have hexp : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a y * X y i) * (a y * X y j) =
          a y ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
        simp only [Fin.sum_univ_three]
        ring
      rw [hexp]
      by_cases hy : y ∈ V
      · have hX1 : ∑ i : Fin 3, X y i ^ 2 ≤ 1 := by
          have h := hXb y
          rwa [hsq1 y (X y)] at h
        have hQ := hquad (G y) (hclose y hy) (fun i => X y i)
        have hQ' : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1 + 4 * η := by
          have hm := mul_le_mul_of_nonneg_left hX1 (by linarith : (0:ℝ) ≤ 1 + 3 * η)
          linarith [hQ.2]
        have hdy := hdetB (G y) (hclose y hy)
        have hdpos : 0 < (G y).det := hpos y hy
        have key : a y ^ 2 * (1 + 4 * η) ≤ 1 := by
          rw [haz y, mul_pow, inv_pow, Real.sq_sqrt hdpos.le]
          have hcd : c ^ 2 * (1 + 4 * η) ≤ (G y).det := by linarith [hdy.1]
          calc c ^ 2 * ((G y).det)⁻¹ * (1 + 4 * η)
              = (c ^ 2 * (1 + 4 * η)) * ((G y).det)⁻¹ := by ring
            _ ≤ (G y).det * ((G y).det)⁻¹ :=
                mul_le_mul_of_nonneg_right hcd (inv_nonneg.2 hdpos.le)
            _ = 1 := mul_inv_cancel₀ hdpos.ne'
        have hm2 := mul_le_mul_of_nonneg_left hQ' (sq_nonneg (a y))
        linarith
      · simp [hX0 y hy]
    · intro z i
      show Real.sqrt (G z).det * (a z • X z) i =
        c * (Real.sqrt ((1 : Matrix (Fin 3) (Fin 3) ℝ)).det * X z i)
      by_cases hz : z ∈ V
      · have hr : Real.sqrt (G z).det ≠ 0 := (Real.sqrt_pos.2 (hpos z hz)).ne'
        simp only [PiLp.smul_apply, smul_eq_mul, Matrix.det_one, Real.sqrt_one, haz z]
        rw [show Real.sqrt (G z).det * (c * (Real.sqrt (G z).det)⁻¹ * X z i) =
          c * (Real.sqrt (G z).det * (Real.sqrt (G z).det)⁻¹) * X z i by ring,
          mul_inv_cancel₀ hr]
        ring
      · simp [hX0 z hz]
  
  have dir2 : sepPerG G S V ≤
      ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) *
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V := by
    refine hK G (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) fun Y hY => ?_
    obtain ⟨hYs, hYc, hYV, hYb⟩ := hY
    have hY0 : ∀ z, z ∉ V → Y z = 0 := fun z hz =>
      image_eq_zero_of_notMem_tsupport (fun h' => hz (hYV h'))
    obtain ⟨b, hb⟩ : ∃ b : E3 → ℝ, b = fun z => c * Real.sqrt (G z).det := ⟨_, rfl⟩
    have hbz : ∀ z, b z = c * Real.sqrt (G z).det := fun z => by rw [hb]
    have hbC : ContDiffOn ℝ ∞ b V := by
      rw [hb]
      exact contDiffOn_const.mul hsqrtC
    refine ⟨fun z => b z • Y z, ⟨?_, ?_, ?_, ?_⟩, hD _ _ _ _ ?_⟩
    · exact hsmul b hbC Y hYs hYV
    · refine hYc.mono ?_
      intro z hz h0
      apply hz
      show b z • Y z = 0
      rw [h0, smul_zero]
    · exact (tsupport_smul_subset_right _ _).trans hYV
    · intro y
      show ∑ i : Fin 3, ∑ j : Fin 3, (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j *
        (b y • Y y) i * (b y • Y y) j ≤ 1
      rw [hsq1 y (b y • Y y)]
      have hYi : ∀ i : Fin 3, (b y • Y y) i = b y * Y y i := fun i => by simp
      simp only [hYi]
      have hexp : ∑ i : Fin 3, (b y * Y y i) ^ 2 = b y ^ 2 * ∑ i : Fin 3, Y y i ^ 2 := by
        simp only [Fin.sum_univ_three]
        ring
      rw [hexp]
      by_cases hy : y ∈ V
      · have hQ := hquad (G y) (hclose y hy) (fun i => Y y i)
        have hs0 : 0 ≤ ∑ i : Fin 3, Y y i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
        have hdy := hdetB (G y) (hclose y hy)
        have hdpos : 0 < (G y).det := hpos y hy
        have hb2 : b y ^ 2 ≤ 1 - 4 * η := by
          rw [hbz y, mul_pow, Real.sq_sqrt hdpos.le]
          have hm := mul_le_mul_of_nonneg_left hdy.2 (sq_nonneg c)
          linarith
        have hm1 := mul_le_mul_of_nonneg_right hb2 hs0
        have hm2 := mul_nonneg hη0 hs0
        have hYb' := hYb y
        linarith [hQ.1]
      · simp [hY0 y hy]
    · intro z i
      show Real.sqrt ((1 : Matrix (Fin 3) (Fin 3) ℝ)).det * (b z • Y z) i =
        c * (Real.sqrt (G z).det * Y z i)
      simp only [PiLp.smul_apply, smul_eq_mul, Matrix.det_one, Real.sqrt_one, hbz z]
      ring
  exact ⟨dir1, dir2⟩

theorem sepPerG_glue_levelset : ∃ C₀ : ℝ, 0 ≤ C₀ ∧ ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E F V : Set E3) (u : E3 → ℝ) (s σ M : ℝ), IsOpen V → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) → (∀ y ∈ V, ∀ i j : Fin 3, |G y i j - (if i = j then (1:ℝ) else 0)| ≤ 1 / 12) → MeasurableSet E → MeasurableSet F → ContDiff ℝ ∞ u → (∀ y, ‖fderiv ℝ u y‖ ≤ M) → 0 ≤ σ → (∀ h₀ : ℝ, 0 < h₀ → ∃ h : ℝ, 0 < h ∧ h < h₀ ∧ volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}) ≤ ENNReal.ofReal (σ * h)) → sepPerG G ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})) V ≤ sepPerG G E V + sepPerG G F (V ∩ {y | s < u y}) + ENNReal.ofReal (C₀ * M * σ) :=
by
  classical
  
  have hρC : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hρD : Differentiable ℝ Real.smoothTransition := hρC.differentiable (by simp)
  have hρ0 : ∀ t : ℝ, t ≤ 0 → Real.smoothTransition t = 0 :=
    fun t ht => Real.smoothTransition.zero_of_nonpos ht
  have hρ1 : ∀ t : ℝ, 1 ≤ t → Real.smoothTransition t = 1 :=
    fun t ht => Real.smoothTransition.one_of_one_le ht
  have hρd0 : ∀ t : ℝ, t < 0 → deriv Real.smoothTransition t = 0 := by
    intro t ht
    have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (0:ℝ) := by
      filter_upwards [Iio_mem_nhds ht] with x hx
      exact hρ0 x (le_of_lt hx)
    rw [hev.deriv_eq, deriv_const]
  have hρd1 : ∀ t : ℝ, 1 < t → deriv Real.smoothTransition t = 0 := by
    intro t ht
    have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (1:ℝ) := by
      filter_upwards [Ioi_mem_nhds ht] with x hx
      exact hρ1 x (le_of_lt hx)
    rw [hev.deriv_eq, deriv_const]
  obtain ⟨K₁, hK₁⟩ := isCompact_Icc.exists_bound_of_continuousOn
    ((hρC.continuous_deriv (by simp)).continuousOn (s := Set.Icc (0:ℝ) 1))
  obtain ⟨K, hK0, hKb⟩ : ∃ K : ℝ, 0 ≤ K ∧ ∀ t : ℝ, |deriv Real.smoothTransition t| ≤ K := by
    refine ⟨max K₁ 0, le_max_right _ _, fun t => ?_⟩
    by_cases h0 : t < 0
    · rw [hρd0 t h0, abs_zero]; exact le_max_right _ _
    by_cases h1 : 1 < t
    · rw [hρd1 t h1, abs_zero]; exact le_max_right _ _
    push_neg at h0 h1
    have := hK₁ t ⟨h0, h1⟩
    rw [Real.norm_eq_abs] at this
    exact this.trans (le_max_left _ _)
  refine ⟨8 / 3 * K, by positivity, ?_⟩
  intro G E F V u s σ M hV hG hclose hE hF hu hM hσ hslab
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hucont : Continuous u := hu.continuous
  have hum : Measurable u := hucont.measurable
  have huD : Differentiable ℝ u := hu.differentiable (by simp)
  
  have htrip : ∀ a b c A B C : ℝ, |a| ≤ A → |b| ≤ B → |c| ≤ C → |a * b * c| ≤ A * B * C := by
    intro a b c A B C ha hb hc
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)) hc
      (abs_nonneg _) (mul_nonneg ((abs_nonneg _).trans ha) ((abs_nonneg _).trans hb))
  have hdetB : ∀ y ∈ V, 2 / 3 ≤ (G y).det ∧ (G y).det ≤ 4 / 3 := by
    intro y hy
    have hC := hclose y hy
    have d0 : |G y 0 0 - 1| ≤ 1 / 12 := by simpa using hC 0 0
    have d1 : |G y 1 1 - 1| ≤ 1 / 12 := by simpa using hC 1 1
    have d2 : |G y 2 2 - 1| ≤ 1 / 12 := by simpa using hC 2 2
    have o01 : |G y 0 1| ≤ 1 / 12 := by simpa using hC 0 1
    have o02 : |G y 0 2| ≤ 1 / 12 := by simpa using hC 0 2
    have o10 : |G y 1 0| ≤ 1 / 12 := by simpa using hC 1 0
    have o12 : |G y 1 2| ≤ 1 / 12 := by simpa using hC 1 2
    have o20 : |G y 2 0| ≤ 1 / 12 := by simpa using hC 2 0
    have o21 : |G y 2 1| ≤ 1 / 12 := by simpa using hC 2 1
    obtain ⟨d0l, d0u⟩ := abs_le.mp d0
    obtain ⟨d1l, d1u⟩ := abs_le.mp d1
    obtain ⟨d2l, d2u⟩ := abs_le.mp d2
    have a0 : |G y 0 0| ≤ 1 + 1 / 12 := abs_le.mpr ⟨by linarith, by linarith⟩
    have a1 : |G y 1 1| ≤ 1 + 1 / 12 := abs_le.mpr ⟨by linarith, by linarith⟩
    have a2 : |G y 2 2| ≤ 1 + 1 / 12 := abs_le.mpr ⟨by linarith, by linarith⟩
    have p1 : (1 - 1 / 12) * (1 - 1 / 12) ≤ G y 0 0 * G y 1 1 :=
      mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    have p2 : (1 - 1 / 12) * (1 - 1 / 12) * (1 - 1 / 12) ≤ G y 0 0 * G y 1 1 * G y 2 2 :=
      mul_le_mul p1 (by linarith) (by norm_num)
        ((by norm_num : (0:ℝ) ≤ (1 - 1 / 12) * (1 - 1 / 12)).trans p1)
    have pu := abs_le.mp (htrip _ _ _ _ _ _ a0 a1 a2)
    have t1 := abs_le.mp (htrip _ _ _ _ _ _ a0 o12 o21)
    have t2 := abs_le.mp (htrip _ _ _ _ _ _ o01 o10 a2)
    have t3 := abs_le.mp (htrip _ _ _ _ _ _ o01 o12 o20)
    have t4 := abs_le.mp (htrip _ _ _ _ _ _ o02 o10 o21)
    have t5 := abs_le.mp (htrip _ _ _ _ _ _ o02 a1 o20)
    rw [Matrix.det_fin_three]
    constructor
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
  have hpair : ∀ a x y : ℝ, |a| ≤ 1 / 12 → |a * x * y| ≤ 1 / 12 * ((x ^ 2 + y ^ 2) / 2) := by
    intro a x y ha
    rw [abs_mul, abs_mul, mul_assoc]
    have h1 : |x| * |y| ≤ (x ^ 2 + y ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x| - |y|), sq_abs x, sq_abs y]
    exact mul_le_mul ha h1 (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by norm_num)
  have hquad : ∀ y ∈ V, ∀ v : E3,
      3 / 4 * ∑ i : Fin 3, v i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, G y i j * v i * v j := by
    intro y hy v
    have hC := hclose y hy
    have d0 : |G y 0 0 - 1| ≤ 1 / 12 := by simpa using hC 0 0
    have d1 : |G y 1 1 - 1| ≤ 1 / 12 := by simpa using hC 1 1
    have d2 : |G y 2 2 - 1| ≤ 1 / 12 := by simpa using hC 2 2
    have o01 : |G y 0 1| ≤ 1 / 12 := by simpa using hC 0 1
    have o02 : |G y 0 2| ≤ 1 / 12 := by simpa using hC 0 2
    have o10 : |G y 1 0| ≤ 1 / 12 := by simpa using hC 1 0
    have o12 : |G y 1 2| ≤ 1 / 12 := by simpa using hC 1 2
    have o20 : |G y 2 0| ≤ 1 / 12 := by simpa using hC 2 0
    have o21 : |G y 2 1| ≤ 1 / 12 := by simpa using hC 2 1
    have q00 := abs_le.mp (hpair _ (v 0) (v 0) d0)
    have q11 := abs_le.mp (hpair _ (v 1) (v 1) d1)
    have q22 := abs_le.mp (hpair _ (v 2) (v 2) d2)
    have q01 := abs_le.mp (hpair _ (v 0) (v 1) o01)
    have q02 := abs_le.mp (hpair _ (v 0) (v 2) o02)
    have q10 := abs_le.mp (hpair _ (v 1) (v 0) o10)
    have q12 := abs_le.mp (hpair _ (v 1) (v 2) o12)
    have q20 := abs_le.mp (hpair _ (v 2) (v 0) o20)
    have q21 := abs_le.mp (hpair _ (v 2) (v 1) o21)
    simp only [Fin.sum_univ_three]
    linarith [q00.1, q11.1, q22.1, q01.1, q02.1, q10.1, q12.1, q20.1, q21.1]
  
  have hdetC : ContDiffOn ℝ ∞ (fun y => (G y).det) V := by
    have hfun : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1 - G y 0 1 * G y 1 0 * G y 2 2
        + G y 0 1 * G y 1 2 * G y 2 0 + G y 0 2 * G y 1 0 * G y 2 1
        - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [hfun]
    have e1 := ((hG 0 0).mul (hG 1 1)).mul (hG 2 2)
    have e2 := ((hG 0 0).mul (hG 1 2)).mul (hG 2 1)
    have e3 := ((hG 0 1).mul (hG 1 0)).mul (hG 2 2)
    have e4 := ((hG 0 1).mul (hG 1 2)).mul (hG 2 0)
    have e5 := ((hG 0 2).mul (hG 1 0)).mul (hG 2 1)
    have e6 := ((hG 0 2).mul (hG 1 1)).mul (hG 2 0)
    exact ((((e1.sub e2).sub e3).add e4).add e5).sub e6
  have hpos : ∀ y ∈ V, 0 < (G y).det := fun y hy => by linarith [(hdetB y hy).1]
  have hsqrtC : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) V :=
    hdetC.sqrt (fun y hy => (hpos y hy).ne')
  have hS3 : ∀ Y : E3 → E3, ContDiff ℝ ∞ Y → HasCompactSupport Y → tsupport Y ⊆ V →
      (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Y z i)) ∧
      Continuous (sepDensDiv G Y) ∧ HasCompactSupport (sepDensDiv G Y) := by
    intro Y hY hYc hYV
    have hw : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Y z i) := by
      intro i
      rw [contDiff_iff_contDiffAt]
      intro z
      by_cases hz : z ∈ V
      · exact (hsqrtC.contDiffAt (hV.mem_nhds hz)).mul
          ((contDiff_euclidean.1 hY i).contDiffAt)
      · have hz' : z ∉ tsupport Y := fun h' => hz (hYV h')
        have hev : Y =ᶠ[𝓝 z] 0 := (notMem_tsupport_iff_eventuallyEq).mp hz'
        have hev' : (fun w => Real.sqrt (G w).det * Y w i) =ᶠ[𝓝 z] (fun _ => (0 : ℝ)) := by
          filter_upwards [hev] with w hw
          rw [hw]; simp
        exact contDiffAt_const.congr_of_eventuallyEq hev'
    refine ⟨hw, ?_, ?_⟩
    · unfold sepDensDiv partialDeriv
      exact continuous_finset_sum _
        (fun i _ => ((hw i).continuous_fderiv (by simp)).clm_apply continuous_const)
    · refine HasCompactSupport.intro hYc (fun y hy => ?_)
      have hev : Y =ᶠ[𝓝 y] 0 := (notMem_tsupport_iff_eventuallyEq).mp hy
      unfold sepDensDiv partialDeriv
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have hev' : (fun w => Real.sqrt (G w).det * Y w i) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) := by
        filter_upwards [hev] with w hw
        rw [hw]; simp
      rw [hev'.fderiv_eq]; simp
  
  refine iSup₂_le fun X hX => ?_
  obtain ⟨hXs, hXc, hXV, hXQ⟩ := hX
  obtain ⟨hw, hdivC, hdivc⟩ := hS3 X hXs hXc hXV
  obtain ⟨A₀, hA₀⟩ := hdivC.bounded_above_of_compact_support hdivc
  obtain ⟨A, hA0, hA⟩ : ∃ A : ℝ, 0 ≤ A ∧ ∀ y, |sepDensDiv G X y| ≤ A :=
    ⟨max A₀ 0, le_max_right _ _, fun y => by
      have := hA₀ y
      rw [Real.norm_eq_abs] at this
      exact this.trans (le_max_left _ _)⟩
  have hX0 : ∀ z, z ∉ V → X z = 0 := fun z hz =>
    image_eq_zero_of_notMem_tsupport (fun h' => hz (hXV h'))
  
  have hwv : ∀ y, ‖Real.sqrt (G y).det • X y‖ ≤ 4 / 3 := by
    intro y
    by_cases hy : y ∈ V
    · have hn2 : ‖X y‖ ^ 2 = ∑ i : Fin 3, X y i ^ 2 := by
        rw [EuclideanSpace.norm_sq_eq]
        simp [Real.norm_eq_abs, sq_abs]
      have hq := hquad y hy (X y)
      have hQ := hXQ y
      have hs0 : 0 ≤ ∑ i : Fin 3, X y i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
      have hs : ∑ i : Fin 3, X y i ^ 2 ≤ 4 / 3 := by linarith
      have hd := hdetB y hy
      rw [norm_smul, Real.norm_of_nonneg (Real.sqrt_nonneg _)]
      have h1 : (Real.sqrt (G y).det * ‖X y‖) ^ 2 ≤ (4 / 3) ^ 2 := by
        rw [mul_pow, Real.sq_sqrt (hpos y hy).le, hn2]
        have := mul_le_mul hd.2 hs hs0 (by norm_num : (0:ℝ) ≤ 4 / 3)
        nlinarith
      have h2 : 0 ≤ Real.sqrt (G y).det * ‖X y‖ :=
        mul_nonneg (Real.sqrt_nonneg _) (norm_nonneg _)
      nlinarith
    · rw [hX0 y hy, smul_zero, norm_zero]; norm_num
  
  have hprod : ∀ (φ : E3 → ℝ) (D : E3 → (E3 →L[ℝ] ℝ)), (∀ y, HasFDerivAt φ (D y) y) →
      ∀ y, sepDensDiv G (fun z => φ z • X z) y =
        φ y * sepDensDiv G X y + D y (Real.sqrt (G y).det • X y) := by
    intro φ D hφ y
    have hi : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * (φ z • X z) i) y =
        φ y * partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y +
          Real.sqrt (G y).det * X y i * D y (e i) := by
      intro i
      have hf : (fun z => Real.sqrt (G z).det * (φ z • X z) i) =
          fun z => φ z * (Real.sqrt (G z).det * X z i) := by
        funext z
        simp only [PiLp.smul_apply, smul_eq_mul]
        ring
      have hd : HasFDerivAt (fun z => φ z * (Real.sqrt (G z).det * X z i))
          (φ y • fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y +
            (Real.sqrt (G y).det * X y i) • D y) y :=
        (hφ y).mul ((hw i).differentiable (by simp) y).hasFDerivAt
      unfold partialDeriv
      rw [hf, hd.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hdec : Real.sqrt (G y).det • X y = (Real.sqrt (G y).det * X y 0) • e 0 +
        (Real.sqrt (G y).det * X y 1) • e 1 + (Real.sqrt (G y).det * X y 2) • e 2 := by
      ext j
      fin_cases j <;> simp
    simp only [sepDensDiv, hi, Fin.sum_univ_three]
    rw [hdec]
    simp only [map_add, map_smul, smul_eq_mul]
    ring
  
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  have hε' : (0:ℝ) < ε := hε
  obtain ⟨h, hh0, hhh₀, hvol⟩ := hslab (ε / (A * σ + 1)) (div_pos hε' (by positivity))
  have hAσh : A * σ * h ≤ ε := by
    have := (lt_div_iff₀ (by positivity : (0:ℝ) < A * σ + 1)).1 hhh₀
    nlinarith
  
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : E3 → ℝ, ℓ = fun y => 2 / h * (u y - s) - 1 / 2 := ⟨_, rfl⟩
  have hℓD : ∀ y, HasFDerivAt ℓ ((2 / h) • fderiv ℝ u y) y := by
    intro y
    rw [hℓ]
    exact (((huD y).hasFDerivAt.sub_const s).const_mul (2 / h)).sub_const (1 / 2)
  have hℓC : ContDiff ℝ ∞ ℓ := by
    rw [hℓ]
    exact (contDiff_const.mul (hu.sub contDiff_const)).sub contDiff_const
  have hℓkey : ∀ y, ℓ y * h = 2 * (u y - s) - h / 2 := by
    intro y
    rw [hℓ]
    field_simp
  have hℓlo : ∀ y, u y ≤ s → ℓ y < 0 := by
    intro y hy
    have := hℓkey y
    nlinarith
  have hℓhi : ∀ y, s + h ≤ u y → 1 < ℓ y := by
    intro y hy
    have := hℓkey y
    nlinarith
  obtain ⟨ψ, hψ⟩ : ∃ ψ : E3 → ℝ, ψ = fun y => Real.smoothTransition (ℓ y) := ⟨_, rfl⟩
  have hψC : ContDiff ℝ ∞ ψ := by
    rw [hψ]
    exact hρC.comp hℓC
  have hψ01 : ∀ y, 0 ≤ ψ y ∧ ψ y ≤ 1 := fun y => by
    rw [hψ]
    exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  obtain ⟨c, hc⟩ : ∃ c : E3 → ℝ, c = fun y => deriv Real.smoothTransition (ℓ y) * (2 / h) :=
    ⟨_, rfl⟩
  have hψD : ∀ y, HasFDerivAt ψ (c y • fderiv ℝ u y) y := by
    intro y
    have h1 := (hρD (ℓ y)).hasDerivAt.comp_hasFDerivAt y (hℓD y)
    rw [smul_smul] at h1
    rw [hψ, hc]
    exact h1
  have hcb : ∀ y, |c y| ≤ K * (2 / h) := by
    intro y
    rw [hc]
    simp only
    rw [abs_mul, abs_of_pos (by positivity : (0:ℝ) < 2 / h)]
    exact mul_le_mul_of_nonneg_right (hKb _) (by positivity)
  have hdu : ∀ y, |fderiv ℝ u y (Real.sqrt (G y).det • X y)| ≤ M * (4 / 3) := by
    intro y
    rw [← Real.norm_eq_abs]
    exact ((fderiv ℝ u y).le_opNorm _).trans
      (mul_le_mul (hM y) (hwv y) (norm_nonneg _) hM0)
  
  obtain ⟨f₁, hf₁def⟩ : ∃ f : E3 → ℝ, f = sepDensDiv G (fun z => (1 - ψ z) • X z) := ⟨_, rfl⟩
  obtain ⟨f₂, hf₂def⟩ : ∃ f : E3 → ℝ, f = sepDensDiv G (fun z => ψ z • X z) := ⟨_, rfl⟩
  have hf2 : ∀ y, f₂ y = ψ y * sepDensDiv G X y +
      c y * fderiv ℝ u y (Real.sqrt (G y).det • X y) := by
    intro y
    rw [hf₂def, hprod ψ _ hψD y]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hf1 : ∀ y, f₁ y = (1 - ψ y) * sepDensDiv G X y -
      c y * fderiv ℝ u y (Real.sqrt (G y).det • X y) := by
    intro y
    have := hprod (fun z => 1 - ψ z) _ (fun y => (hψD y).const_sub 1) y
    rw [hf₁def, this]
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hI : ∀ y, sepDensDiv G X y = f₁ y + f₂ y := by
    intro y
    rw [hf1, hf2]
    ring
  have hZ2 : ∀ y, u y ≤ s → f₂ y = 0 := by
    intro y hy
    have hl := hℓlo y hy
    have e1 : ψ y = 0 := by rw [hψ]; exact hρ0 _ hl.le
    have e2 : c y = 0 := by rw [hc]; simp only; rw [hρd0 _ hl, zero_mul]
    rw [hf2, e1, e2]
    ring
  have hZ1 : ∀ y, s + h ≤ u y → f₁ y = 0 := by
    intro y hy
    have hl := hℓhi y hy
    have e1 : ψ y = 1 := by rw [hψ]; exact hρ1 _ hl.le
    have e2 : c y = 0 := by rw [hc]; simp only; rw [hρd1 _ hl, zero_mul]
    rw [hf1, e1, e2]
    ring
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℝ, Λ = A + K * (2 / h) * (M * (4 / 3)) := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ := by rw [hΛ]; positivity
  have hB1 : ∀ y, |f₁ y| ≤ Λ := by
    intro y
    rw [hf1]
    have hp := hψ01 y
    have e1 : |(1 - ψ y) * sepDensDiv G X y| ≤ 1 * A := by
      rw [abs_mul]
      exact mul_le_mul (abs_le.mpr ⟨by linarith, by linarith⟩) (hA y) (abs_nonneg _)
        (by norm_num)
    have e2 : |c y * fderiv ℝ u y (Real.sqrt (G y).det • X y)| ≤
        K * (2 / h) * (M * (4 / 3)) := by
      rw [abs_mul]
      exact mul_le_mul (hcb y) (hdu y) (abs_nonneg _) (by positivity)
    have e1' := abs_le.mp e1
    have e2' := abs_le.mp e2
    rw [hΛ]
    exact abs_le.mpr ⟨by linarith [e1'.1, e2'.2], by linarith [e1'.2, e2'.1]⟩
  
  have hquadsmul : ∀ (a : ℝ) (y : E3), 0 ≤ a → a ≤ 1 →
      ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a • X y) i * (a • X y) j ≤ 1 := by
    intro a y ha0 ha1
    have hYi : ∀ i : Fin 3, (a • X y) i = a * X y i := fun i => by simp
    simp only [hYi]
    have hexp : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a * X y i) * (a * X y j) =
        a ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
      simp only [Fin.sum_univ_three]
      ring
    rw [hexp]
    have hQ := hXQ y
    have ha2 : a ^ 2 ≤ 1 := by nlinarith
    have hm := mul_nonpos_iff.2 (Or.inl ⟨sq_nonneg a, (by linarith :
      ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j - 1 ≤ 0)⟩)
    nlinarith
  have hY1s : ContDiff ℝ ∞ (fun z => (1 - ψ z) • X z) := (contDiff_const.sub hψC).smul hXs
  have hY2s : ContDiff ℝ ∞ (fun z => ψ z • X z) := hψC.smul hXs
  have hY1c : HasCompactSupport (fun z => (1 - ψ z) • X z) := by
    refine hXc.mono ?_
    intro z hz h0
    apply hz
    show (1 - ψ z) • X z = 0
    rw [h0, smul_zero]
  have hY2c : HasCompactSupport (fun z => ψ z • X z) := by
    refine hXc.mono ?_
    intro z hz h0
    apply hz
    show ψ z • X z = 0
    rw [h0, smul_zero]
  have hY1V : tsupport (fun z => (1 - ψ z) • X z) ⊆ V :=
    (tsupport_smul_subset_right _ _).trans hXV
  have hψsupp : tsupport ψ ⊆ {y | s < u y} := by
    have hsub : Function.support ψ ⊆ {y | s + h / 4 ≤ u y} := by
      intro y hy
      have hl : 0 < ℓ y := by
        by_contra hcon
        push_neg at hcon
        apply hy
        rw [hψ]
        exact hρ0 _ hcon
      have := hℓkey y
      show s + h / 4 ≤ u y
      nlinarith
    refine (closure_minimal hsub (isClosed_le continuous_const hucont)).trans ?_
    intro y hy
    show s < u y
    have : s + h / 4 ≤ u y := hy
    linarith
  have hY2V : tsupport (fun z => ψ z • X z) ⊆ V ∩ {y | s < u y} :=
    Set.subset_inter ((tsupport_smul_subset_right _ _).trans hXV)
      ((tsupport_smul_subset_left _ _).trans hψsupp)
  have hA1 : ENNReal.ofReal (∫ y in E, f₁ y) ≤ sepPerG G E V := by
    rw [hf₁def]
    exact le_iSup₂_of_le (fun z => (1 - ψ z) • X z)
      ⟨hY1s, hY1c, hY1V, fun y => hquadsmul _ y (by linarith [(hψ01 y).2])
        (by linarith [(hψ01 y).1])⟩ le_rfl
  have hA2 : ENNReal.ofReal (∫ y in F, f₂ y) ≤ sepPerG G F (V ∩ {y | s < u y}) := by
    rw [hf₂def]
    exact le_iSup₂_of_le (fun z => ψ z • X z)
      ⟨hY2s, hY2c, hY2V, fun y => hquadsmul _ y (hψ01 y).1 (hψ01 y).2⟩ le_rfl
  have hf₁I : Integrable f₁ := by
    obtain ⟨_, h1, h2⟩ := hS3 _ hY1s hY1c hY1V
    rw [hf₁def]
    exact h1.integrable_of_hasCompactSupport h2
  have hf₂I : Integrable f₂ := by
    obtain ⟨_, h1, h2⟩ := hS3 _ hY2s hY2c (hY2V.trans Set.inter_subset_left)
    rw [hf₂def]
    exact h1.integrable_of_hasCompactSupport h2
  
  have hDg : MeasurableSet ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})) :=
    (hE.inter (measurableSet_le hum measurable_const)).union
      (hF.inter (measurableSet_lt measurable_const hum))
  have hS : MeasurableSet (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}) :=
    (hE.symmDiff hF).inter ((measurableSet_lt measurable_const hum).inter
      (measurableSet_lt hum measurable_const))
  have hSfin : volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}) < ⊤ :=
    lt_of_le_of_lt hvol ENNReal.ofReal_lt_top
  have hSreal : (volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h})).toReal ≤ σ * h :=
    ENNReal.toReal_le_of_le_ofReal (mul_nonneg hσ hh0.le) hvol
  have hSint : Integrable ((symmDiff E F ∩ {y | s < u y ∧ u y < s + h}).indicator
      (fun _ => Λ)) :=
    (integrable_indicator_iff hS).2 (integrableOn_const hSfin.ne)
  have hstep2 : ∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), f₂ y = ∫ y in F, f₂ y := by
    rw [← integral_indicator hDg, ← integral_indicator hF]
    congr 1
    funext y
    simp only [Set.indicator_apply]
    by_cases hy : u y ≤ s
    · rw [hZ2 y hy]
      simp
    · have hsy : s < u y := lt_of_not_ge hy
      have hmem : y ∈ (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}) ↔ y ∈ F := by
        constructor
        · rintro (⟨_, h'⟩ | ⟨h', _⟩)
          · exact absurd h' hy
          · exact h'
        · intro h'
          exact Or.inr ⟨h', hsy⟩
      by_cases hyF : y ∈ F
      · rw [if_pos (hmem.2 hyF), if_pos hyF]
      · rw [if_neg (fun h' => hyF (hmem.1 h')), if_neg hyF]
  have hstep3 : ∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), f₁ y ≤
      (∫ y in E, f₁ y) + Λ * (volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h})).toReal := by
    rw [← integral_indicator hDg, ← integral_indicator hE]
    have hpt : ∀ y, ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})).indicator f₁ y ≤
        E.indicator f₁ y + (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}).indicator
          (fun _ => Λ) y := by
      intro y
      have hS0 : 0 ≤ (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}).indicator (fun _ => Λ) y :=
        Set.indicator_nonneg (fun _ _ => hΛ0) y
      have hb := abs_le.mp (hB1 y)
      by_cases hy1 : u y ≤ s
      · have hmem : y ∈ (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}) ↔ y ∈ E := by
          constructor
          · rintro (⟨h', _⟩ | ⟨_, h'⟩)
            · exact h'
            · exact absurd hy1 (not_le.2 h')
          · intro h'
            exact Or.inl ⟨h', hy1⟩
        have heq : ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})).indicator f₁ y =
            E.indicator f₁ y := by
          simp only [Set.indicator_apply]
          by_cases hyE : y ∈ E
          · rw [if_pos (hmem.2 hyE), if_pos hyE]
          · rw [if_neg (fun h' => hyE (hmem.1 h')), if_neg hyE]
        linarith
      by_cases hy2 : s + h ≤ u y
      · have e1 : ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})).indicator f₁ y = 0 := by
          simp only [Set.indicator_apply, hZ1 y hy2, ite_self]
        have e2 : E.indicator f₁ y = 0 := by
          simp only [Set.indicator_apply, hZ1 y hy2, ite_self]
        linarith
      have hsy : s < u y := lt_of_not_ge hy1
      have hyh : u y < s + h := lt_of_not_ge hy2
      have hmem : y ∈ (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}) ↔ y ∈ F := by
        constructor
        · rintro (⟨_, h'⟩ | ⟨h', _⟩)
          · exact absurd h' hy1
          · exact h'
        · intro h'
          exact Or.inr ⟨h', hsy⟩
      by_cases hyE : y ∈ E <;> by_cases hyF : y ∈ F
      · rw [Set.indicator_of_mem (hmem.2 hyF), Set.indicator_of_mem hyE]
        linarith
      · have hyS : y ∈ symmDiff E F ∩ {y | s < u y ∧ u y < s + h} :=
          ⟨Set.mem_symmDiff.2 (Or.inl ⟨hyE, hyF⟩), hsy, hyh⟩
        rw [Set.indicator_of_notMem (fun h' => hyF (hmem.1 h')), Set.indicator_of_mem hyE,
          Set.indicator_of_mem hyS]
        linarith
      · have hyS : y ∈ symmDiff E F ∩ {y | s < u y ∧ u y < s + h} :=
          ⟨Set.mem_symmDiff.2 (Or.inr ⟨hyF, hyE⟩), hsy, hyh⟩
        rw [Set.indicator_of_mem (hmem.2 hyF), Set.indicator_of_notMem hyE,
          Set.indicator_of_mem hyS]
        linarith
      · rw [Set.indicator_of_notMem (fun h' => hyF (hmem.1 h')), Set.indicator_of_notMem hyE]
        linarith
    calc ∫ y, ((E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})).indicator f₁ y
        ≤ ∫ y, (E.indicator f₁ y + (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}).indicator
            (fun _ => Λ) y) :=
          integral_mono (hf₁I.indicator hDg) ((hf₁I.indicator hE).add hSint) hpt
      _ = (∫ y, E.indicator f₁ y) + ∫ y, (symmDiff E F ∩ {y | s < u y ∧ u y < s + h}).indicator
            (fun _ => Λ) y := integral_add (hf₁I.indicator hE) hSint
      _ = (∫ y, E.indicator f₁ y) +
            Λ * (volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h})).toReal := by
          rw [integral_indicator_const Λ hS, smul_eq_mul, measureReal_def, mul_comm]
  have hsplit : ∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), sepDensDiv G X y ≤
      (∫ y in E, f₁ y) + (∫ y in F, f₂ y) + 8 / 3 * K * M * σ + A * σ * h := by
    have e1 : ∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), sepDensDiv G X y =
        (∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), f₁ y) +
          ∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), f₂ y := by
      simp_rw [hI]
      exact integral_add hf₁I.integrableOn hf₂I.integrableOn
    have e2 : Λ * (σ * h) = A * σ * h + 8 / 3 * K * M * σ := by
      rw [hΛ]
      field_simp
      ring
    have e3 : Λ * (volume (symmDiff E F ∩ {y | s < u y ∧ u y < s + h})).toReal ≤ Λ * (σ * h) :=
      mul_le_mul_of_nonneg_left hSreal hΛ0
    rw [e1, hstep2]
    linarith [hstep3]
  
  calc ENNReal.ofReal (∫ y in (E ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}), sepDensDiv G X y)
      ≤ ENNReal.ofReal ((∫ y in E, f₁ y) + (∫ y in F, f₂ y) + 8 / 3 * K * M * σ +
          A * σ * h) := ENNReal.ofReal_le_ofReal hsplit
    _ ≤ ENNReal.ofReal (∫ y in E, f₁ y) + ENNReal.ofReal (∫ y in F, f₂ y) +
          ENNReal.ofReal (8 / 3 * K * M * σ) + ENNReal.ofReal (A * σ * h) :=
        ENNReal.ofReal_add_le.trans (add_le_add (ENNReal.ofReal_add_le.trans
          (add_le_add ENNReal.ofReal_add_le le_rfl)) le_rfl)
    _ ≤ sepPerG G E V + sepPerG G F (V ∩ {y | s < u y}) +
          ENNReal.ofReal (8 / 3 * K * M * σ) + ε := by
        refine add_le_add (add_le_add (add_le_add hA1 hA2) le_rfl) ?_
        rw [← ENNReal.ofReal_coe_nnreal]
        exact ENNReal.ofReal_le_ofReal hAσh

theorem sepMonotone_good_slice (m : ℝ → ℝ) (a b c : ℝ) (hab : a < b) (hm : MonotoneOn m (Set.Icc a b)) (hc : m b - m a < c * (b - a)) : ∃ s : ℝ, a ≤ s ∧ s < b ∧ ∀ h₀ : ℝ, 0 < h₀ → ∃ h : ℝ, 0 < h ∧ h < h₀ ∧ s + h ≤ b ∧ m (s + h) - m s ≤ c * h :=
by
  by_contra hne
  have hneg : ∀ s, a ≤ s → s < b → ∃ h₀ : ℝ, 0 < h₀ ∧ ∀ h : ℝ, 0 < h → h < h₀ → s + h ≤ b →
      c * h < m (s + h) - m s := by
    intro s h1 h2
    by_contra hx
    apply hne
    refine ⟨s, h1, h2, fun h₀ hh₀ => ?_⟩
    by_contra hy
    apply hx
    refine ⟨h₀, hh₀, fun h hh hhh hsb => ?_⟩
    by_contra hz
    exact hy ⟨h, hh, hhh, hsb, not_lt.mp hz⟩
  have hab' : m a ≤ m b := hm ⟨le_refl a, hab.le⟩ ⟨hab.le, le_refl b⟩ hab.le
  have hc0 : 0 < c := by
    by_contra hc'
    push_neg at hc'
    have : c * (b - a) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hc' (by linarith)
    linarith
  set K : ℝ := m a - c * a with hK
  set A : Set ℝ := {t : ℝ | a ≤ t ∧ t ≤ b ∧ ∀ x, a ≤ x → x ≤ t → K + c * x ≤ m x} with hA
  have haA : a ∈ A := by
    refine ⟨le_refl a, hab.le, fun x hx1 hx2 => ?_⟩
    have : x = a := le_antisymm hx2 hx1
    rw [this, hK]
    linarith
  have hne' : A.Nonempty := ⟨a, haA⟩
  have hbdd : BddAbove A := ⟨b, fun t ht => ht.2.1⟩
  set T : ℝ := sSup A with hT
  have haT : a ≤ T := le_csSup hbdd haA
  have hTb : T ≤ b := csSup_le hne' (fun t ht => ht.2.1)
  have s3 : ∀ x, a ≤ x → x < T → K + c * x ≤ m x := by
    intro x hx1 hx2
    obtain ⟨t, ht, hxt⟩ := exists_lt_of_lt_csSup hne' hx2
    exact ht.2.2 x hx1 hxt.le
  have s4 : K + c * T ≤ m T := by
    rcases lt_or_eq_of_le haT with hlt | heq
    · by_contra hcon
      push_neg at hcon
      set d : ℝ := K + c * T - m T with hd
      have hd0 : 0 < d := by linarith
      have hq : 0 < d / (2 * c) := by positivity
      set x : ℝ := max a (T - d / (2 * c)) with hx
      have hx1 : a ≤ x := le_max_left _ _
      have hx2 : x < T := max_lt hlt (by linarith)
      have hx3 : T - d / (2 * c) ≤ x := le_max_right _ _
      have hcx : c * (T - d / (2 * c)) ≤ c * x := mul_le_mul_of_nonneg_left hx3 hc0.le
      have heq2 : c * (T - d / (2 * c)) = c * T - d / 2 := by
        field_simp
      have hPx := s3 x hx1 hx2
      have hmx : m x ≤ m T := hm ⟨hx1, by linarith⟩ ⟨haT, hTb⟩ hx2.le
      linarith
    · rw [← heq, hK]
      linarith
  have s5 : T ∈ A := by
    refine ⟨haT, hTb, fun x hx1 hx2 => ?_⟩
    rcases lt_or_eq_of_le hx2 with hlt | heq
    · exact s3 x hx1 hlt
    · rw [heq]; exact s4
  have s6 : T = b := by
    by_contra hTne
    have hTlt : T < b := lt_of_le_of_ne hTb hTne
    obtain ⟨h₀, hh₀, hloc⟩ := hneg T haT hTlt
    have hmin0 : 0 < min h₀ (b - T) := lt_min hh₀ (by linarith)
    set h : ℝ := min h₀ (b - T) / 2 with hh
    have hh0 : 0 < h := by positivity
    have hm1 : min h₀ (b - T) ≤ h₀ := min_le_left _ _
    have hm2 : min h₀ (b - T) ≤ b - T := min_le_right _ _
    have hhh₀ : h < h₀ := by linarith
    have hhb : T + h ≤ b := by linarith
    have hTh : T + h ∈ A := by
      refine ⟨by linarith, hhb, fun x hx1 hx2 => ?_⟩
      rcases le_or_gt x T with hxT | hxT
      · exact s5.2.2 x hx1 hxT
      · have h1 := hloc (x - T) (by linarith) (by linarith) (by linarith)
        have h2 : T + (x - T) = x := by ring
        rw [h2] at h1
        nlinarith
    have := le_csSup hbdd hTh
    linarith
  have hbA : b ∈ A := by rw [← s6]; exact s5
  have hfin := hbA.2.2 b hab.le (le_refl b)
  rw [hK] at hfin
  nlinarith

theorem sepSmooth_shell_cutoff (W V : Set E3) (hV : IsOpen V) (hWc : IsCompact (closure W)) (hWV : closure W ⊆ V) : ∃ (u : E3 → ℝ) (L : Set E3) (M : ℝ), ContDiff ℝ ∞ u ∧ IsCompact L ∧ L ⊆ V ∧ (∀ y ∈ closure W, u y = 0) ∧ (∀ y, y ∉ L → u y = 1) ∧ 0 ≤ M ∧ ∀ y, ‖fderiv ℝ u y‖ ≤ M :=
by
  obtain ⟨δ, hδ, hδV⟩ := hWc.exists_cthickening_subset_open hV hWV
  have hTo : IsOpen (Metric.thickening δ (closure W)) := Metric.isOpen_thickening
  have hWT : closure W ⊆ Metric.thickening δ (closure W) :=
    Metric.self_subset_thickening hδ (closure W)
  have hTL : Metric.thickening δ (closure W) ⊆ Metric.cthickening δ (closure W) :=
    Metric.thickening_subset_cthickening δ (closure W)
  have hLc : IsCompact (Metric.cthickening δ (closure W)) := hWc.cthickening
  have hLcl : IsClosed (Metric.cthickening δ (closure W)) := Metric.isClosed_cthickening
  have hdisj : Disjoint (closure W) (Metric.thickening δ (closure W))ᶜ :=
    Set.disjoint_compl_right_iff_subset.mpr hWT
  obtain ⟨u, hu, -, h0, h1⟩ := exists_contMDiff_zero_iff_one_iff_of_isClosed
    (𝓘(ℝ, E3)) (n := (⊤ : ℕ∞)) isClosed_closure hTo.isClosed_compl hdisj
  have hu' : ContDiff ℝ ∞ u := contMDiff_iff_contDiff.mp hu
  have hu1 : ∀ y, y ∉ Metric.cthickening δ (closure W) → u y = 1 := by
    intro y hy
    exact (h1 y).mp (fun hyT => hy (hTL hyT))
  have hvs : HasCompactSupport (fun y => u y - 1) :=
    HasCompactSupport.intro' hLc hLcl (fun y hy => by rw [hu1 y hy]; ring)
  have hvs' : HasCompactSupport (fderiv ℝ (fun y => u y - 1)) := hvs.fderiv ℝ
  have hvc : Continuous (fderiv ℝ (fun y => u y - 1)) :=
    (hu'.sub contDiff_const).continuous_fderiv (by simp)
  obtain ⟨C, hC⟩ := hvc.bounded_above_of_compact_support hvs'
  refine ⟨u, Metric.cthickening δ (closure W), max C 0, hu', hLc, hδV,
    fun y hy => (h0 y).mp hy, hu1, le_max_right _ _, fun y => ?_⟩
  have := hC y
  rw [fderiv_sub_const] at this
  exact this.trans (le_max_left _ _)

theorem sepQuasiMin_glue_compare (W V : Set E3) (hW : IsOpen W) (hV : IsOpen V) (hWc : IsCompact (closure W)) (hWV : closure W ⊆ V) (hVc : IsCompact (closure V)) : ∃ C : ℝ, 0 ≤ C ∧ ∀ (η : ℝ) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U F K K' : Set E3), 0 ≤ η → η ≤ 1 / 12 → IsOpen U → closure V ⊆ U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → (∀ y ∈ U, ∀ i j : Fin 3, |G y i j - (if i = j then (1:ℝ) else 0)| ≤ η) → sepIsPerMin G F U → MeasurableSet K → MeasurableSet K' → symmDiff K K' ⊆ closure W → ∀ ε : ℝ, 0 < ε → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F W ≤ ENNReal.ofReal (((1 + 4 * η) / (1 - 4 * η)) ^ 2) * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V + ENNReal.ofReal (C * ((volume (symmDiff F K ∩ V)).toReal + ε)) :=
by
  classical
  
  obtain ⟨u, L, M, hu, hLc, hLV, hu0, hu1, hM0, hMb⟩ := sepSmooth_shell_cutoff W V hV hWc hWV
  obtain ⟨C₀, hC₀, hglue⟩ := sepPerG_glue_levelset
  refine ⟨4 * C₀ * M, by positivity, ?_⟩
  intro η G U F K K' hη0 hη12 hU hVU hG hclose hmin hK hK' hKK' ε hε
  have hVU' : V ⊆ U := subset_closure.trans hVU
  have hucont : Continuous u := hu.continuous
  have hmono : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (S A B : Set E3), A ⊆ B →
      sepPerG G' S A ≤ sepPerG G' S B := by
    intro G' S A B hAB
    unfold sepPerG
    exact iSup₂_le fun X hX =>
      le_iSup₂_of_le X ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2⟩ le_rfl
  have hFm : MeasurableSet F := hmin.1
  
  have hAm : MeasurableSet (symmDiff F K ∩ V) := (hFm.symmDiff hK).inter hV.measurableSet
  have hAfin : volume (symmDiff F K ∩ V) < ⊤ :=
    lt_of_le_of_lt (measure_mono (Set.inter_subset_right.trans subset_closure)) hVc.measure_lt_top
  have hd0 : 0 ≤ (volume (symmDiff F K ∩ V)).toReal := ENNReal.toReal_nonneg
  have hlev : ∀ t : ℝ, MeasurableSet {y : E3 | u y ≤ t} :=
    fun t => measurableSet_le hucont.measurable measurable_const
  have hfinA : ∀ t : ℝ, volume (symmDiff F K ∩ V ∩ {y | u y ≤ t}) ≠ ⊤ := fun t =>
    ne_top_of_le_ne_top hAfin.ne (measure_mono Set.inter_subset_left)
  have hmmono : Monotone (fun t : ℝ => (volume (symmDiff F K ∩ V ∩ {y | u y ≤ t})).toReal) := by
    intro a b hab
    exact ENNReal.toReal_mono (hfinA b)
      (measure_mono (Set.inter_subset_inter_right _ (fun y (hy : u y ≤ a) => (le_trans hy hab : u y ≤ b))))
  have hmle : ∀ t : ℝ, (volume (symmDiff F K ∩ V ∩ {y | u y ≤ t})).toReal ≤
      (volume (symmDiff F K ∩ V)).toReal := fun t =>
    ENNReal.toReal_mono hAfin.ne (measure_mono Set.inter_subset_left)
  have hm0 : ∀ t : ℝ, 0 ≤ (volume (symmDiff F K ∩ V ∩ {y | u y ≤ t})).toReal :=
    fun t => ENNReal.toReal_nonneg
  have hσ0 : 0 ≤ 2 * ((volume (symmDiff F K ∩ V)).toReal + ε) := by linarith
  obtain ⟨s, hs1, hs2, hgood⟩ := sepMonotone_good_slice
    (fun t : ℝ => (volume (symmDiff F K ∩ V ∩ {y | u y ≤ t})).toReal) (1 / 4) (3 / 4)
    (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)) (by norm_num) (hmmono.monotoneOn _) (by
      have h1 := hmle (3 / 4)
      have h2 := hm0 (1 / 4)
      simp only
      linarith)
  
  have hslice : ∀ h₀ : ℝ, 0 < h₀ → ∃ h : ℝ, 0 < h ∧ h < h₀ ∧
      volume (symmDiff K' F ∩ {y | s < u y ∧ u y < s + h}) ≤
        ENNReal.ofReal (2 * ((volume (symmDiff F K ∩ V)).toReal + ε) * h) := by
    intro h₀ hh₀
    obtain ⟨h, hh0, hhh₀, hsh, hmh⟩ := hgood h₀ hh₀
    simp only at hmh
    refine ⟨h, hh0, hhh₀, ?_⟩
    have hsub : symmDiff K' F ∩ {y | s < u y ∧ u y < s + h} ⊆
        (symmDiff F K ∩ V ∩ {y | u y ≤ s + h}) \ (symmDiff F K ∩ V ∩ {y | u y ≤ s}) := by
      rintro y ⟨hyd, hys1, hys2⟩
      have hyW : y ∉ closure W := fun hyW => by
        have := hu0 y hyW
        linarith
      have hyKK : y ∉ symmDiff K K' := fun h' => hyW (hKK' h')
      have hyL : y ∈ L := by
        by_contra hyL
        have := hu1 y hyL
        linarith
      have hyFK : y ∈ symmDiff F K := by
        rw [Set.mem_symmDiff] at hyd hyKK ⊢
        tauto
      refine ⟨⟨⟨hyFK, hLV hyL⟩, ?_⟩, fun h' => ?_⟩
      · show u y ≤ s + h
        exact hys2.le
      · have : u y ≤ s := h'.2
        linarith
    have hdiff : volume ((symmDiff F K ∩ V ∩ {y | u y ≤ s + h}) \
        (symmDiff F K ∩ V ∩ {y | u y ≤ s})) =
        volume (symmDiff F K ∩ V ∩ {y | u y ≤ s + h}) -
          volume (symmDiff F K ∩ V ∩ {y | u y ≤ s}) :=
      measure_diff (Set.inter_subset_inter_right _ (fun y (hy : u y ≤ s) => (by linarith : u y ≤ s + h)))
        (hAm.inter (hlev s)).nullMeasurableSet (hfinA s)
    have hle : volume (symmDiff F K ∩ V ∩ {y | u y ≤ s}) ≤
        volume (symmDiff F K ∩ V ∩ {y | u y ≤ s + h}) :=
      measure_mono (Set.inter_subset_inter_right _ (fun y (hy : u y ≤ s) => (by linarith : u y ≤ s + h)))
    refine (measure_mono hsub).trans ?_
    rw [hdiff, ENNReal.le_ofReal_iff_toReal_le (ENNReal.sub_ne_top (hfinA _)) (by positivity),
      ENNReal.toReal_sub_of_le hle (hfinA _)]
    exact hmh
  
  have hF'm : MeasurableSet ((K' ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})) :=
    (hK'.inter (hlev s)).union (hFm.inter (measurableSet_lt measurable_const hucont.measurable))
  have hKcL : {y : E3 | u y ≤ 3 / 4} ⊆ L := by
    intro y hy
    by_contra h'
    have h1 := hu1 y h'
    have h2 : u y ≤ 3 / 4 := hy
    linarith
  have hKcc : IsCompact {y : E3 | u y ≤ 3 / 4} :=
    hLc.of_isClosed_subset (isClosed_le hucont continuous_const) hKcL
  have hsdF : symmDiff F ((K' ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y})) ⊆ {y : E3 | u y ≤ 3 / 4} := by
    intro y hy
    show u y ≤ 3 / 4
    by_contra hy'
    push_neg at hy'
    have hsy : s < u y := by linarith
    have hiff : y ∈ (K' ∩ {y | u y ≤ s}) ∪ (F ∩ {y | s < u y}) ↔ y ∈ F := by
      constructor
      · rintro (⟨_, h'⟩ | ⟨h', _⟩)
        · exact absurd (show u y ≤ s from h') (not_le.2 hsy)
        · exact h'
      · intro h'
        exact Or.inr ⟨h', hsy⟩
    rw [Set.mem_symmDiff] at hy
    tauto
  have hminF := hmin.2.2 _ V _ hF'm hV hVc hVU hKcc (hKcL.trans hLV) hsdF
  have hfinF : sepPerG G F V < ⊤ := hmin.2.1 V hV hVc hVU
  
  have hgl := hglue G K' F V u s (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)) M hV
    (fun i j => (hG i j).mono hVU') (fun y hy i j => (hclose y (hVU' hy) i j).trans hη12)
    hK' hFm hu hMb hσ0 hslice
  
  have hOo : IsOpen (V ∩ {y | u y < s}) := hV.inter (isOpen_lt hucont continuous_const)
  have hsum := sepPerG_sum_le G F hFm 2 ![V ∩ {y | u y < s}, V ∩ {y | s < u y}] (by
    intro k l hkl
    fin_cases k <;> fin_cases l
    · exact absurd rfl hkl
    · show Disjoint (V ∩ {y | u y < s}) (V ∩ {y | s < u y})
      exact Set.disjoint_left.2 fun y hy1 hy2 =>
        lt_asymm (show u y < s from hy1.2) (show s < u y from hy2.2)
    · show Disjoint (V ∩ {y | s < u y}) (V ∩ {y | u y < s})
      exact Set.disjoint_left.2 fun y hy1 hy2 =>
        lt_asymm (show s < u y from hy1.2) (show u y < s from hy2.2)
    · exact absurd rfl hkl)
  have hUnion : (⋃ k, ![V ∩ {y | u y < s}, V ∩ {y | s < u y}] k) ⊆ V := by
    refine Set.iUnion_subset fun k => ?_
    fin_cases k
    · exact Set.inter_subset_left
    · exact Set.inter_subset_left
  rw [Fin.sum_univ_two] at hsum
  have hsum' : sepPerG G F (V ∩ {y | u y < s}) + sepPerG G F (V ∩ {y | s < u y}) ≤
      sepPerG G F V := hsum.trans (hmono _ _ _ _ hUnion)
  have hfinO : sepPerG G F (V ∩ {y | s < u y}) ≠ ⊤ :=
    ne_top_of_le_ne_top hfinF.ne (hmono _ _ _ _ Set.inter_subset_left)
  have hO : sepPerG G F (V ∩ {y | u y < s}) ≤ sepPerG G K' V +
      ENNReal.ofReal (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε))) := by
    rw [← ENNReal.add_le_add_iff_right hfinO]
    calc sepPerG G F (V ∩ {y | u y < s}) + sepPerG G F (V ∩ {y | s < u y})
        ≤ sepPerG G F V := hsum'
      _ ≤ _ := hminF
      _ ≤ _ := hgl
      _ = _ := by rw [add_right_comm]
  
  have hWO : W ⊆ V ∩ {y | u y < s} := by
    intro y hy
    have hy' : y ∈ closure W := subset_closure hy
    refine ⟨hWV hy', ?_⟩
    show u y < s
    rw [hu0 y hy']
    linarith
  have hOV : V ∩ {y | u y < s} ⊆ V := Set.inter_subset_left
  have hcmpO := (sepPerG_near_id_compare G (V ∩ {y | u y < s}) η hOo
    (fun i j => (hG i j).mono (hOV.trans hVU')) hη0 hη12
    (fun y hy => hclose y (hVU' (hOV hy))) F).1
  have hcmpV := (sepPerG_near_id_compare G V η hV (fun i j => (hG i j).mono hVU') hη0 hη12
    (fun y hy => hclose y (hVU' hy)) K').2
  have hden : 0 < 1 - 4 * η := by linarith
  have hlam0 : 0 ≤ (1 + 4 * η) / (1 - 4 * η) := div_nonneg (by linarith) hden.le
  have hlam2 : (1 + 4 * η) / (1 - 4 * η) ≤ 2 := by
    rw [div_le_iff₀ hden]
    linarith
  have hX0 : 0 ≤ C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)) := by positivity
  have hfinal : (1 + 4 * η) / (1 - 4 * η) * (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)))
      ≤ 4 * C₀ * M * ((volume (symmDiff F K ∩ V)).toReal + ε) := by
    calc (1 + 4 * η) / (1 - 4 * η) * (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)))
        ≤ 2 * (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε))) :=
          mul_le_mul_of_nonneg_right hlam2 hX0
      _ = 4 * C₀ * M * ((volume (symmDiff F K ∩ V)).toReal + ε) := by ring
  calc sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F W
      ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (V ∩ {y | u y < s}) :=
        hmono _ _ _ _ hWO
    _ ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * sepPerG G F (V ∩ {y | u y < s}) := hcmpO
    _ ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) * (sepPerG G K' V +
          ENNReal.ofReal (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)))) :=
        mul_le_mul_left' hO _
    _ ≤ ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) *
          (ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η)) *
            sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V +
          ENNReal.ofReal (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)))) :=
        mul_le_mul_left' (add_le_add hcmpV le_rfl) _
    _ = ENNReal.ofReal (((1 + 4 * η) / (1 - 4 * η)) ^ 2) *
          sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V +
        ENNReal.ofReal ((1 + 4 * η) / (1 - 4 * η) *
          (C₀ * M * (2 * ((volume (symmDiff F K ∩ V)).toReal + ε)))) := by
        rw [mul_add, ← mul_assoc, ← ENNReal.ofReal_mul hlam0, ← ENNReal.ofReal_mul hlam0, sq]
    _ ≤ ENNReal.ofReal (((1 + 4 * η) / (1 - 4 * η)) ^ 2) *
          sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V +
        ENNReal.ofReal (4 * C₀ * M * ((volume (symmDiff F K ∩ V)).toReal + ε)) :=
        add_le_add le_rfl (ENNReal.ofReal_le_ofReal hfinal)

theorem sepPerG_one_lsc (S : ℕ → Set E3) (T V : Set E3) (hS : ∀ k, MeasurableSet (S k)) (hT : MeasurableSet T) (hconv : ∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (S k) T ∩ Metric.ball 0 ρ)) atTop (𝓝 0)) : ∀ a : ENNReal, a < sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) T V → ∀ᶠ k in atTop, a < sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (S k) V :=
by
  intro a ha
  unfold sepPerG at ha
  obtain ⟨X, hX⟩ := lt_iSup_iff.1 ha
  obtain ⟨hAdm, ha'⟩ := lt_iSup_iff.1 hX
  obtain ⟨hXs, hXc, hXV, hXn⟩ := hAdm
  set f : E3 → ℝ := sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X with hfdef
  have hcomp : ∀ i : Fin 3, ContDiff ℝ ∞
      (fun z => Real.sqrt (Matrix.det (1 : Matrix (Fin 3) (Fin 3) ℝ)) * X z i) := by
    intro i
    exact contDiff_const.mul ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hXs)
  have hfeq : f = fun y => ∑ i : Fin 3,
      fderiv ℝ (fun z => Real.sqrt (Matrix.det (1 : Matrix (Fin 3) (Fin 3) ℝ)) * X z i) y (e i) :=
    rfl
  have hfc : Continuous f := by
    rw [hfeq]
    refine continuous_finset_sum _ (fun i _ => ?_)
    exact ((hcomp i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hf0 : ∀ y, y ∉ tsupport X → f y = 0 := by
    intro y hy
    have hO : (tsupport X)ᶜ ∈ 𝓝 y := (isClosed_tsupport X).isOpen_compl.mem_nhds hy
    rw [hfeq]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have hev : (fun z => Real.sqrt (Matrix.det (1 : Matrix (Fin 3) (Fin 3) ℝ)) * X z i)
        =ᶠ[𝓝 y] fun _ => (0:ℝ) := by
      filter_upwards [hO] with z hz
      rw [image_eq_zero_of_notMem_tsupport hz]
      simp
    rw [hev.fderiv_eq]
    simp
  have hfcs : HasCompactSupport f := HasCompactSupport.intro hXc hf0
  have hfi : Integrable f := hfc.integrable_of_hasCompactSupport hfcs
  obtain ⟨M, hM⟩ := hfc.bounded_above_of_compact_support hfcs
  obtain ⟨r, hr⟩ := hXc.isBounded.subset_ball (0 : E3)
  have hρpos : (0:ℝ) < max r 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hρ : ∀ y, y ∉ Metric.ball (0:E3) (max r 1) → f y = 0 := by
    intro y hy
    apply hf0
    intro hyt
    exact hy (Metric.ball_subset_ball (le_max_left _ _) (hr hyt))
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  have hbound : ∀ k, |(∫ y in S k, f y) - ∫ y in T, f y| ≤
      M * (volume (symmDiff (S k) T ∩ Metric.ball (0:E3) (max r 1))).toReal := by
    intro k
    set D := symmDiff (S k) T ∩ Metric.ball (0:E3) (max r 1) with hD
    have hDm : MeasurableSet D := ((hS k).symmDiff hT).inter measurableSet_ball
    have hDfin : volume D ≠ ⊤ :=
      (lt_of_le_of_lt (measure_mono Set.inter_subset_right) measure_ball_lt_top).ne
    rw [← integral_indicator (hS k), ← integral_indicator hT,
      ← integral_sub (hfi.indicator (hS k)) (hfi.indicator hT)]
    have hDnn : ∀ x, 0 ≤ D.indicator (fun _ => M) x := fun x => Set.indicator_nonneg (fun _ _ => hM0) x
    have hpt : ∀ x, ‖(S k).indicator f x - T.indicator f x‖ ≤ D.indicator (fun _ => M) x := by
      intro x
      have hfx := hM x
      have hxD : ((x ∈ S k ∧ x ∉ T) ∨ (x ∈ T ∧ x ∉ S k)) ∧ x ∈ Metric.ball (0:E3) (max r 1) →
          x ∈ D := by
        intro h
        rw [hD, Set.mem_inter_iff, Set.mem_symmDiff]
        exact h
      by_cases h3 : x ∈ Metric.ball (0:E3) (max r 1)
      · by_cases h1 : x ∈ S k <;> by_cases h2 : x ∈ T
        · rw [Set.indicator_of_mem h1, Set.indicator_of_mem h2, sub_self, norm_zero]
          exact hDnn x
        · rw [Set.indicator_of_mem h1, Set.indicator_of_notMem h2, sub_zero,
            Set.indicator_of_mem (hxD ⟨Or.inl ⟨h1, h2⟩, h3⟩)]
          exact hfx
        · rw [Set.indicator_of_notMem h1, Set.indicator_of_mem h2, zero_sub, norm_neg,
            Set.indicator_of_mem (hxD ⟨Or.inr ⟨h2, h1⟩, h3⟩)]
          exact hfx
        · rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2, sub_self, norm_zero]
          exact hDnn x
      · have hfx0 := hρ x h3
        have e1 : (S k).indicator f x = 0 := by
          by_cases h1 : x ∈ S k
          · rw [Set.indicator_of_mem h1, hfx0]
          · rw [Set.indicator_of_notMem h1]
        have e2 : T.indicator f x = 0 := by
          by_cases h2 : x ∈ T
          · rw [Set.indicator_of_mem h2, hfx0]
          · rw [Set.indicator_of_notMem h2]
        rw [e1, e2, sub_self, norm_zero]
        exact hDnn x
    have hint : Integrable (D.indicator (fun _ => M)) :=
      (integrable_indicator_iff hDm).2 (integrableOn_const hDfin)
    have h := norm_integral_le_of_norm_le hint (Filter.Eventually.of_forall hpt)
    rw [integral_indicator_const M hDm, Measure.real_def, smul_eq_mul, Real.norm_eq_abs] at h
    rw [mul_comm]
    exact h
  have hu : Tendsto (fun k => (volume (symmDiff (S k) T ∩ Metric.ball (0:E3) (max r 1))).toReal)
      atTop (𝓝 0) := by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hconv (max r 1) hρpos)
    rwa [ENNReal.toReal_zero] at this
  have hMu : Tendsto (fun k =>
      M * (volume (symmDiff (S k) T ∩ Metric.ball (0:E3) (max r 1))).toReal) atTop (𝓝 0) := by
    have := hu.const_mul M
    rwa [mul_zero] at this
  have hlim : Tendsto (fun k => ∫ y in S k, f y) atTop (𝓝 (∫ y in T, f y)) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun k => norm_nonneg _) (fun k => ?_) hMu
    rw [Real.norm_eq_abs]
    exact hbound k
  have hlim' := ENNReal.tendsto_ofReal hlim
  filter_upwards [(tendsto_order.1 hlim').1 a ha'] with k hk
  unfold sepPerG
  exact lt_of_lt_of_le hk (le_iSup₂_of_le X ⟨hXs, hXc, hXV, hXn⟩ le_rfl)

theorem sepSets_locally_compact_subseq (S : ℕ → Set E3) (hS : ∀ k, MeasurableSet (S k)) (hbd : ∀ ρ : ℝ, 0 < ρ → ∃ C : ℝ, ∀ᶠ k in atTop, sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (S k) (Metric.ball 0 ρ) ≤ ENNReal.ofReal C) : ∃ (ψ : ℕ → ℕ) (K : Set E3), StrictMono ψ ∧ MeasurableSet K ∧ ∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (S (ψ k)) K ∩ Metric.ball 0 ρ)) atTop (𝓝 0) :=
by
  classical
  
  have H : ∀ (m : ℕ) (Φ : ℕ → ℕ), StrictMono Φ → ∃ φ : ℕ → ℕ, StrictMono φ ∧
      ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n k : ℕ, N ≤ n → N ≤ k →
        volume (symmDiff (S (Φ (φ n))) (S (Φ (φ k))) ∩ Metric.ball 0 ((m : ℝ) + 1)) <
          ENNReal.ofReal ε := by
    intro m Φ hΦ
    obtain ⟨r, hr_def⟩ : ∃ r : ℝ, r = 2 * ((m : ℝ) + 1) := ⟨_, rfl⟩
    have hr : 0 < r := by rw [hr_def]; positivity
    obtain ⟨C, hC⟩ := hbd (3 * r) (by positivity)
    obtain ⟨k₀, hk₀⟩ := Filter.eventually_atTop.1 hC
    have hmod : ∀ (n : ℕ) (h : E3), ‖h‖ ≤ r →
        volume (symmDiff (S (Φ (n + k₀))) ((fun x => x + h) ⁻¹' S (Φ (n + k₀))) ∩ ball 0 r) ≤
          ENNReal.ofReal ((2 * max C 0) * ‖h‖) := by
      intro n h hh
      have h1 := sepPerG_one_translate_le (S (Φ (n + k₀))) 0 h r (hS _) hr hh
      have h2 : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (S (Φ (n + k₀)))
          (Metric.ball 0 (3 * r)) ≤ ENNReal.ofReal (max C 0) :=
        (hk₀ _ (le_trans (Nat.le_add_left k₀ n) (hΦ.id_le _))).trans
          (ENNReal.ofReal_le_ofReal (le_max_left _ _))
      calc _ ≤ _ := h1
        _ ≤ ENNReal.ofReal (2 * ‖h‖) * ENNReal.ofReal (max C 0) := mul_le_mul_left' h2 _
        _ = ENNReal.ofReal ((2 * max C 0) * ‖h‖) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
    obtain ⟨φ, hφ, hcau⟩ := sepSets_cauchy_subseq 0 r (2 * max C 0) hr
      (fun n => S (Φ (n + k₀))) (fun n => hS _) hmod
    have hr2 : r / 2 = (m : ℝ) + 1 := by rw [hr_def]; ring
    refine ⟨fun n => φ n + k₀, fun a b hab => Nat.add_lt_add_right (hφ hab) k₀, ?_⟩
    intro ε hε
    obtain ⟨N, hN⟩ := hcau ε hε
    refine ⟨N, fun n k hn hk => ?_⟩
    have h := hN n k hn hk
    rw [hr2] at h
    exact h
  
  choose φ hφmono hφcau using H
  obtain ⟨seq, hseqS⟩ : ∃ seq : ℕ → {Φ : ℕ → ℕ // StrictMono Φ}, ∀ m,
      seq (m + 1) = ⟨(seq m).1 ∘ φ m (seq m).1 (seq m).2,
        (seq m).2.comp (hφmono m (seq m).1 (seq m).2)⟩ :=
    ⟨fun m => Nat.rec (motive := fun _ => {Φ : ℕ → ℕ // StrictMono Φ}) ⟨id, strictMono_id⟩
      (fun m P => ⟨P.1 ∘ φ m P.1 P.2, P.2.comp (hφmono m P.1 P.2)⟩) m, fun m => rfl⟩
  have hstep : ∀ m i, (seq (m + 1)).1 i = (seq m).1 (φ m (seq m).1 (seq m).2 i) := by
    intro m i
    rw [hseqS m]
    rfl
  have hcauM : ∀ (m : ℕ) (ε : ℝ), 0 < ε → ∃ N : ℕ, ∀ n k : ℕ, N ≤ n → N ≤ k →
      volume (symmDiff (S ((seq (m + 1)).1 n)) (S ((seq (m + 1)).1 k)) ∩
        Metric.ball 0 ((m : ℝ) + 1)) < ENNReal.ofReal ε := by
    intro m ε hε
    obtain ⟨N, hN⟩ := hφcau m (seq m).1 (seq m).2 ε hε
    refine ⟨N, fun n k hn hk => ?_⟩
    rw [hstep m n, hstep m k]
    exact hN n k hn hk
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : ℕ → ℕ, ∀ n, ψ n = (seq (n + 1)).1 n :=
    ⟨fun n => (seq (n + 1)).1 n, fun n => rfl⟩
  have hψ : StrictMono ψ := by
    refine strictMono_nat_of_lt_succ fun n => ?_
    rw [hψdef n, hψdef (n + 1), hstep (n + 1)]
    exact (seq (n + 1)).2 (lt_of_lt_of_le (Nat.lt_succ_self n) ((hφmono _ _ _).id_le _))
  have htail : ∀ m n, m ≤ n → ∀ i, ∃ j, i ≤ j ∧ (seq (n + 1)).1 i = (seq (m + 1)).1 j := by
    intro m n hmn
    induction n, hmn using Nat.le_induction with
    | base => intro i; exact ⟨i, le_rfl, rfl⟩
    | succ n hmn ih =>
      intro i
      obtain ⟨j, hij, hj⟩ := ih (φ (n + 1) (seq (n + 1)).1 (seq (n + 1)).2 i)
      refine ⟨j, le_trans ((hφmono _ _ _).id_le i) hij, ?_⟩
      rw [hstep (n + 1) i, hj]
  have hcau : ∀ (m : ℕ) (ε : ℝ), 0 < ε → ∃ N : ℕ, ∀ n k : ℕ, N ≤ n → N ≤ k →
      volume (symmDiff (S (ψ n)) (S (ψ k)) ∩ Metric.ball 0 ((m : ℝ) + 1)) <
        ENNReal.ofReal ε := by
    intro m ε hε
    obtain ⟨N₀, hN₀⟩ := hcauM m ε hε
    refine ⟨max N₀ m, fun n k hn hk => ?_⟩
    obtain ⟨j, hnj, hj⟩ := htail m n (le_trans (le_max_right _ _) hn) n
    obtain ⟨j', hkj, hj'⟩ := htail m k (le_trans (le_max_right _ _) hk) k
    rw [hψdef n, hψdef k, hj, hj']
    exact hN₀ j j' (le_trans (le_trans (le_max_left _ _) hn) hnj)
      (le_trans (le_trans (le_max_left _ _) hk) hkj)
  
  have hlim : ∀ m : ℕ, ∃ L : Set E3, MeasurableSet L ∧
      Tendsto (fun n => volume (symmDiff (S (ψ n)) L ∩ Metric.ball 0 ((m : ℝ) + 1)))
        atTop (𝓝 0) :=
    fun m => sepSets_limit_of_cauchy (Metric.ball 0 ((m : ℝ) + 1)) (fun n => S (ψ n))
      (fun n => hS _) (hcau m)
  choose L hLm hLconv using hlim
  
  have hover : ∀ m M : ℕ, m ≤ M →
      volume (symmDiff (L m) (L M) ∩ Metric.ball 0 ((m : ℝ) + 1)) = 0 := by
    intro m M hmM
    have hmM' : (m : ℝ) ≤ M := by exact_mod_cast hmM
    have hball : Metric.ball (0 : E3) ((m : ℝ) + 1) ⊆ Metric.ball 0 ((M : ℝ) + 1) :=
      Metric.ball_subset_ball (by linarith)
    have hT := (hLconv m).add (hLconv M)
    rw [add_zero] at hT
    refine le_antisymm (ge_of_tendsto' hT fun n => ?_) (zero_le _)
    refine (measure_mono ?_).trans (measure_union_le _ _)
    rintro x ⟨hx, hxB⟩
    have hxB' := hball hxB
    simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_symmDiff] at hx ⊢
    by_cases hxT : x ∈ S (ψ n) <;> tauto
  obtain ⟨K, hKdef⟩ : ∃ K : Set E3,
      K = ⋃ m : ℕ, (L m ∩ (Metric.ball 0 ((m : ℝ) + 1) \ Metric.ball 0 (m : ℝ))) := ⟨_, rfl⟩
  have hKm : MeasurableSet K := by
    rw [hKdef]
    exact MeasurableSet.iUnion fun m => (hLm m).inter (measurableSet_ball.diff measurableSet_ball)
  have hKiff : ∀ x : E3, x ∈ K ↔ x ∈ L ⌊‖x‖⌋₊ := by
    intro x
    have h0 : 0 ≤ ‖x‖ := norm_nonneg x
    rw [hKdef, Set.mem_iUnion]
    constructor
    · rintro ⟨m, hxL, hx1, hx2⟩
      rw [mem_ball_zero_iff] at hx1 hx2
      have hfl : ⌊‖x‖⌋₊ = m := (Nat.floor_eq_iff h0).2 ⟨le_of_not_gt hx2, hx1⟩
      rw [hfl]
      exact hxL
    · intro hx
      refine ⟨⌊‖x‖⌋₊, hx, ?_, ?_⟩
      · rw [mem_ball_zero_iff]; exact Nat.lt_floor_add_one _
      · rw [mem_ball_zero_iff]; exact not_lt.2 (Nat.floor_le h0)
  have hKL : ∀ M : ℕ, volume (symmDiff K (L M) ∩ Metric.ball 0 ((M : ℝ) + 1)) = 0 := by
    intro M
    refine measure_mono_null (t := ⋃ m : ℕ,
      (symmDiff (L m) (L M) ∩ Metric.ball 0 ((m : ℝ) + 1)) ∩ {_x : E3 | m ≤ M}) ?_ ?_
    · rintro x ⟨hx, hxB⟩
      have h0 : 0 ≤ ‖x‖ := norm_nonneg x
      rw [mem_ball_zero_iff] at hxB
      have hle : ⌊‖x‖⌋₊ ≤ M := by
        have : ⌊‖x‖⌋₊ < M + 1 := (Nat.floor_lt h0).2 (by push_cast; exact hxB)
        omega
      refine Set.mem_iUnion.2 ⟨⌊‖x‖⌋₊, ⟨?_, ?_⟩, hle⟩
      · rw [Set.mem_symmDiff, ← hKiff x]
        rw [Set.mem_symmDiff] at hx
        exact hx
      · rw [mem_ball_zero_iff]; exact Nat.lt_floor_add_one _
    · refine measure_iUnion_null fun m => ?_
      by_cases hm : m ≤ M
      · exact measure_mono_null Set.inter_subset_left (hover m M hm)
      · have hempty : {_x : E3 | m ≤ M} = ∅ := by
          ext x; simp [hm]
        rw [hempty, Set.inter_empty, measure_empty]
  
  refine ⟨ψ, K, hψ, hKm, fun ρ hρ => ?_⟩
  obtain ⟨M, hMdef⟩ : ∃ M : ℕ, M = ⌈ρ⌉₊ := ⟨_, rfl⟩
  have hρM : ρ < (M : ℝ) + 1 := by
    have := Nat.le_ceil ρ
    rw [← hMdef] at this
    linarith
  have hball : Metric.ball (0 : E3) ρ ⊆ Metric.ball 0 ((M : ℝ) + 1) :=
    Metric.ball_subset_ball hρM.le
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds (hLconv M)
    (fun n => zero_le _) (fun n => ?_)
  show volume (symmDiff (S (ψ n)) K ∩ Metric.ball 0 ρ) ≤
    volume (symmDiff (S (ψ n)) (L M) ∩ Metric.ball 0 ((M : ℝ) + 1))
  calc volume (symmDiff (S (ψ n)) K ∩ Metric.ball 0 ρ)
      ≤ volume ((symmDiff (S (ψ n)) (L M) ∩ Metric.ball 0 ((M : ℝ) + 1)) ∪
          (symmDiff K (L M) ∩ Metric.ball 0 ((M : ℝ) + 1))) := by
        apply measure_mono
        rintro x ⟨hx, hxB⟩
        have hxB' := hball hxB
        simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_symmDiff] at hx ⊢
        by_cases hxL : x ∈ L M <;> tauto
    _ ≤ volume (symmDiff (S (ψ n)) (L M) ∩ Metric.ball 0 ((M : ℝ) + 1)) +
          volume (symmDiff K (L M) ∩ Metric.ball 0 ((M : ℝ) + 1)) := measure_union_le _ _
    _ = volume (symmDiff (S (ψ n)) (L M) ∩ Metric.ball 0 ((M : ℝ) + 1)) := by
        rw [hKL M, add_zero]

theorem sepMonotone_ae_rightCont (f : ℝ → ENNReal) (hf : Monotone f) (hfin : ∀ x, f x ≠ ⊤) : ∀ᵐ x ∂(volume : Measure ℝ), ∀ b : ENNReal, f x < b → ∃ y : ℝ, x < y ∧ f y < b :=
by
  have hS : {x | ¬ContinuousAt f x}.Countable := hf.countable_not_continuousAt
  filter_upwards [hS.ae_notMem volume] with x hx
  intro b hb
  have hc : ContinuousAt f x := by
    simpa using hx
  have h1 : ∀ᶠ y in 𝓝 x, f y < b := hc.tendsto.eventually (eventually_lt_nhds hb)
  have h2 : ∀ᶠ y in 𝓝[>] x, f y < b := h1.filter_mono nhdsWithin_le_nhds
  have h3 : ∀ᶠ y in 𝓝[>] x, x < y := self_mem_nhdsWithin
  obtain ⟨y, hxy, hyb⟩ := (h3.and h2).exists
  exact ⟨y, hxy, hyb⟩

theorem sepPerMin_blowup_compact (G : ℕ → E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : ℕ → Set E3) (R : ℕ → ℝ) (hR : Tendsto R atTop atTop) (hG : ∀ k (i j : Fin 3), ContDiffOn ℝ ∞ (fun y => G k y i j) (Metric.ball 0 (R k))) (hsymm : ∀ k (y : E3) (i j : Fin 3), G k y i j = G k y j i) (hpd : ∀ k, ∀ y ∈ Metric.ball (0:E3) (R k), (G k y).PosDef) (hconv : ∀ ρ : ℝ, 0 < ρ → ∀ ε : ℝ, 0 < ε → ∀ᶠ k in atTop, ∀ y ∈ Metric.ball (0:E3) ρ, ∀ i j : Fin 3, |G k y i j - (if i = j then (1:ℝ) else 0)| ≤ ε) (hmin : ∀ k, sepIsPerMin (G k) (F k) (Metric.ball 0 (R k))) (h1 : ∀ k, ∀ N ∈ 𝓝 (0:E3), volume (N \ F k) ≠ 0) (h0 : ∀ k, ∀ N ∈ 𝓝 (0:E3), volume (N ∩ F k) ≠ 0) : ∃ (ψ : ℕ → ℕ) (K : Set E3), StrictMono ψ ∧ (∀ ρ : ℝ, 0 < ρ → Tendsto (fun k => volume (symmDiff (F (ψ k)) K ∩ Metric.ball 0 ρ)) atTop (𝓝 0)) ∧ sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ ∧ (∀ N ∈ 𝓝 (0:E3), volume (N \ K) ≠ 0) ∧ (∀ N ∈ 𝓝 (0:E3), volume (N ∩ K) ≠ 0) ∧ ∀ᵐ ρ ∂(volume : Measure ℝ), 0 < ρ → Tendsto (fun k => sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F (ψ k)) (Metric.ball 0 ρ)) atTop (𝓝 (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ))) :=
by
  classical
  
  have hrestr : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (S W W' : Set E3),
      sepIsPerMin G' S W → W' ⊆ W → sepIsPerMin G' S W' := by
    intro G' S W W' h hW
    exact ⟨h.1, fun V hV hc hcl => h.2.1 V hV hc (hcl.trans hW),
      fun F' V K hF' hV hc hcl hK hKV hsd => h.2.2 F' V K hF' hV hc (hcl.trans hW) hK hKV hsd⟩
  
  have hmono : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (S A B : Set E3), A ⊆ B →
      sepPerG G' S A ≤ sepPerG G' S B := by
    intro G' S A B hAB
    unfold sepPerG
    exact iSup₂_le fun X hX =>
      le_iSup₂_of_le X ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2⟩ le_rfl
  
  have hempty : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (A : Set E3), sepPerG G' ∅ A = 0 := by
    intro G' A
    unfold sepPerG
    refine le_antisymm (iSup₂_le fun X _ => ?_) (zero_le _)
    simp
  
  have hEv : ∀ ρ₀ : ℝ, 0 < ρ₀ → ∀ η : ℝ, 0 < η → ∀ᶠ k in atTop, ρ₀ < R k ∧
      ∀ y ∈ Metric.ball (0:E3) ρ₀, ∀ i j : Fin 3,
        |G k y i j - (if i = j then (1:ℝ) else 0)| ≤ η :=
    fun ρ₀ hρ₀ η hη => (hR.eventually_gt_atTop ρ₀).and (hconv ρ₀ hρ₀ η hη)
  have hclb : ∀ ρ : ℝ, 0 < ρ → closure (Metric.ball (0:E3) ρ) = Metric.closedBall 0 ρ :=
    fun ρ hρ => closure_ball 0 hρ.ne'
  
  have hbd : ∀ ρ : ℝ, 0 < ρ → ∃ C : ℝ, ∀ᶠ k in atTop,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F k) (Metric.ball 0 ρ) ≤
        ENNReal.ofReal C := by
    intro ρ hρ
    have h2ρ : (0:ℝ) < 2 * ρ := by linarith
    obtain ⟨C, hC0, hC⟩ := sepQuasiMin_glue_compare (Metric.ball 0 ρ) (Metric.ball 0 (2 * ρ))
      Metric.isOpen_ball Metric.isOpen_ball (by rw [hclb ρ hρ]; exact isCompact_closedBall _ _)
      (by rw [hclb ρ hρ]; exact Metric.closedBall_subset_ball (by linarith))
      (by rw [hclb _ h2ρ]; exact isCompact_closedBall _ _)
    refine ⟨C * ((volume (Metric.ball (0:E3) (2 * ρ))).toReal + 1), ?_⟩
    filter_upwards [hEv (3 * ρ) (by linarith) (1 / 12) (by norm_num)] with k hk
    have h := hC (1 / 12) (G k) (Metric.ball 0 (3 * ρ)) (F k) ∅ ∅ (by norm_num) le_rfl
      Metric.isOpen_ball (by rw [hclb _ h2ρ]; exact Metric.closedBall_subset_ball (by linarith))
      (fun i j => (hG k i j).mono (Metric.ball_subset_ball hk.1.le)) hk.2
      (hrestr _ _ _ _ (hmin k) (Metric.ball_subset_ball hk.1.le))
      MeasurableSet.empty MeasurableSet.empty
      (by rw [symmDiff_self]; exact Set.empty_subset _) 1 one_pos
    rw [hempty, mul_zero, zero_add] at h
    refine h.trans (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hC0))
    have : (volume (symmDiff (F k) ∅ ∩ Metric.ball (0:E3) (2 * ρ))).toReal ≤
        (volume (Metric.ball (0:E3) (2 * ρ))).toReal :=
      ENNReal.toReal_mono measure_ball_lt_top.ne (measure_mono Set.inter_subset_right)
    linarith
  
  obtain ⟨ψ, K, hψ, hKm, hconvK⟩ := sepSets_locally_compact_subseq F (fun k => (hmin k).1) hbd
  have hψt := hψ.tendsto_atTop
  have hFψm : ∀ n, MeasurableSet (F (ψ n)) := fun n => (hmin (ψ n)).1
  have hlsc : ∀ (V : Set E3) (a : ENNReal),
      a < sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K V →
      ∀ᶠ n in atTop, a < sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F (ψ n)) V :=
    fun V => sepPerG_one_lsc (fun n => F (ψ n)) K V hFψm hKm hconvK
  
  have hUP : ∀ (W V K' : Set E3) (b : ENNReal), IsOpen W → IsOpen V → IsCompact (closure W) →
      closure W ⊆ V → IsCompact (closure V) → MeasurableSet K' → symmDiff K K' ⊆ closure W →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V < b →
      ∀ᶠ n in atTop, sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F (ψ n)) W < b := by
    intro W V K' b hW hV hWc hWV hVc hK' hKK' hb
    obtain ⟨C, hC0, hC⟩ := sepQuasiMin_glue_compare W V hW hV hWc hWV hVc
    have hpfin : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V ≠ ⊤ := ne_top_of_lt hb
    obtain ⟨β, hβ0, hpβ, hβb⟩ := ENNReal.lt_iff_exists_real_btwn.1 hb
    obtain ⟨p, hpdef⟩ : ∃ p : ℝ,
        p = (sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V).toReal := ⟨_, rfl⟩
    have hp0 : 0 ≤ p := by rw [hpdef]; exact ENNReal.toReal_nonneg
    have hpβ' : p < β := by rw [hpdef]; exact (ENNReal.lt_ofReal_iff_toReal_lt hpfin).1 hpβ
    have hpeq : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K' V = ENNReal.ofReal p := by
      rw [hpdef, ENNReal.ofReal_toReal hpfin]
    obtain ⟨gap, hgap⟩ : ∃ g : ℝ, g = β - p := ⟨_, rfl⟩
    have hgap0 : 0 < gap := by rw [hgap]; linarith
    obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min (1 / 12) (gap / (72 * (p + 1))) := ⟨_, rfl⟩
    have hη0 : 0 < η := by rw [hη]; exact lt_min (by norm_num) (div_pos hgap0 (by linarith))
    have hη12 : η ≤ 1 / 12 := by rw [hη]; exact min_le_left _ _
    have hηg : η * (72 * (p + 1)) ≤ gap := by
      have h := min_le_right (1 / 12 : ℝ) (gap / (72 * (p + 1)))
      rw [← hη] at h
      exact (le_div_iff₀ (by linarith)).1 h
    obtain ⟨ε, hε⟩ : ∃ ε : ℝ, ε = gap / (8 * (C + 1)) := ⟨_, rfl⟩
    have hC8 : (8 * (C + 1)) ≠ 0 := ne_of_gt (by linarith)
    have hε0 : 0 < ε := by rw [hε]; exact div_pos hgap0 (by linarith)
    have hεeq : ε * (8 * (C + 1)) = gap := by rw [hε]; field_simp
    have hCε : C * ε * 8 ≤ gap := by nlinarith
    obtain ⟨lam, hlam⟩ : ∃ l : ℝ, l = (1 + 4 * η) / (1 - 4 * η) := ⟨_, rfl⟩
    have hden : 0 < 1 - 4 * η := by linarith
    have hηη : 0 ≤ η * (1 / 12 - η) := mul_nonneg hη0.le (by linarith)
    have hlam1 : lam ≤ 1 + 12 * η := by
      rw [hlam, div_le_iff₀ hden]; nlinarith
    have hlam0 : 0 ≤ lam := by rw [hlam]; exact div_nonneg (by linarith) hden.le
    have hlam2 : lam ^ 2 ≤ 1 + 36 * η := by
      have := pow_le_pow_left₀ hlam0 hlam1 2
      nlinarith
    obtain ⟨r, hr⟩ := hVc.isBounded.subset_ball (0:E3)
    have hρ₀ : (0:ℝ) < max r 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
    have hVsub : closure V ⊆ Metric.ball (0:E3) (max r 1) :=
      hr.trans (Metric.ball_subset_ball (le_max_left _ _))
    have hev1 := hψt.eventually (hEv (max r 1) hρ₀ η hη0)
    have hev2 := (tendsto_order.1 (hconvK (max r 1) hρ₀)).2 (ENNReal.ofReal ε)
      (ENNReal.ofReal_pos.2 hε0)
    filter_upwards [hev1, hev2] with n hn1 hn2
    have hd : (volume (symmDiff (F (ψ n)) K ∩ V)).toReal ≤ ε :=
      ENNReal.toReal_le_of_le_ofReal hε0.le
        ((measure_mono (Set.inter_subset_inter_right _ (subset_closure.trans hVsub))).trans hn2.le)
    have hd0 : 0 ≤ (volume (symmDiff (F (ψ n)) K ∩ V)).toReal := ENNReal.toReal_nonneg
    have h := hC η (G (ψ n)) (Metric.ball 0 (max r 1)) (F (ψ n)) K K' hη0.le hη12
      Metric.isOpen_ball hVsub (fun i j => (hG (ψ n) i j).mono (Metric.ball_subset_ball hn1.1.le))
      hn1.2 (hrestr _ _ _ _ (hmin (ψ n)) (Metric.ball_subset_ball hn1.1.le)) hKm hK' hKK' ε hε0
    rw [hpeq, ← hlam, ← ENNReal.ofReal_mul (sq_nonneg lam),
      ← ENNReal.ofReal_add (mul_nonneg (sq_nonneg lam) hp0)
        (mul_nonneg hC0 (add_nonneg hd0 hε0.le))] at h
    refine lt_of_le_of_lt h (lt_of_lt_of_le ?_ hβb.le)
    rw [ENNReal.ofReal_lt_ofReal_iff (by linarith)]
    have h1 : lam ^ 2 * p ≤ (1 + 36 * η) * p := mul_le_mul_of_nonneg_right hlam2 hp0
    have h2 : C * ((volume (symmDiff (F (ψ n)) K ∩ V)).toReal + ε) ≤ C * (2 * ε) :=
      mul_le_mul_of_nonneg_left (by linarith) hC0
    nlinarith
  
  have hKfin : ∀ ρ : ℝ, 0 < ρ →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K (Metric.ball 0 ρ) < ⊤ := by
    intro ρ hρ
    obtain ⟨C, hC⟩ := hbd ρ hρ
    by_contra hcon
    rw [not_lt, top_le_iff] at hcon
    have e1 := hlsc (Metric.ball 0 ρ) (ENNReal.ofReal C) (by rw [hcon]; exact ENNReal.ofReal_lt_top)
    obtain ⟨n, hn1, hn2⟩ := (e1.and (hψt.eventually hC)).exists
    exact absurd (lt_of_lt_of_le hn1 hn2) (lt_irrefl _)
  have hKmin : sepIsPerMin (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K Set.univ := by
    refine ⟨hKm, fun V hV hVc _ => ?_, fun F' V Kc hF' hV hVc _ hKc hKcV hsd => ?_⟩
    · obtain ⟨r, hr⟩ := hVc.isBounded.subset_ball (0:E3)
      have hρ₀ : (0:ℝ) < max r 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
      exact lt_of_le_of_lt (hmono _ _ _ _ (subset_closure.trans
        (hr.trans (Metric.ball_subset_ball (le_max_left _ _))))) (hKfin _ hρ₀)
    · refine iSup₂_le fun X hX => ?_
      obtain ⟨W', hW'o, hQW', hW'V, hW'c⟩ := exists_open_between_and_isCompact_closure
        (hX.2.1.isCompact.union hKc) hV (Set.union_subset hX.2.2.1 hKcV)
      have hXW : ENNReal.ofReal (∫ y in K, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y)
          ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) K W' :=
        le_iSup₂_of_le X ⟨hX.1, hX.2.1, Set.subset_union_left.trans hQW', hX.2.2.2⟩ le_rfl
      refine hXW.trans ?_
      by_contra hcon
      rw [not_le] at hcon
      obtain ⟨b, hb1, hb2⟩ := exists_between hcon
      have e1 := hlsc W' b hb2
      have e2 := hUP W' V F' b hW'o hV hW'c hW'V hVc hF'
        (hsd.trans (Set.subset_union_right.trans (hQW'.trans subset_closure))) hb1
      obtain ⟨n, hn1, hn2⟩ := (e1.and e2).exists
      exact absurd (hn1.trans hn2) (lt_irrefl _)
  
  obtain ⟨η₁, c₀, hη₁, hc₀, hc₀1, hdens⟩ := sepPerMin_density_lower
  have hdK : ∀ s : ℝ, 0 < s → s ≤ 1 →
      ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (K ∩ Metric.ball 0 s) ∧
      ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball 0 s \ K) := by
    intro s hs hs1
    have hevk : ∀ᶠ k in atTop, ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (F k ∩ Metric.ball 0 s) ∧
        ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball 0 s \ F k) := by
      filter_upwards [hEv 2 two_pos η₁ hη₁] with k hk
      exact hdens (G k) (F k) (Metric.ball 0 2) 0 s Metric.isOpen_ball
        (fun i j => (hG k i j).mono (Metric.ball_subset_ball hk.1.le)) (hsymm k)
        (fun y hy => hpd k y (Metric.ball_subset_ball hk.1.le hy)) hk.2
        (hrestr _ _ _ _ (hmin k) (Metric.ball_subset_ball hk.1.le)) hs
        (Metric.closedBall_subset_ball (by linarith)) (fun N hN => ⟨h0 k N hN, h1 k N hN⟩)
    have hevn := hψt.eventually hevk
    have hT1 : Tendsto (fun n => volume (K ∩ Metric.ball (0:E3) s) +
        volume (symmDiff (F (ψ n)) K ∩ Metric.ball 0 s)) atTop
        (𝓝 (volume (K ∩ Metric.ball (0:E3) s))) := by
      have h := Tendsto.add (tendsto_const_nhds :
        Tendsto (fun _ : ℕ => volume (K ∩ Metric.ball (0:E3) s)) atTop _) (hconvK s hs)
      rwa [add_zero] at h
    have hT2 : Tendsto (fun n => volume (Metric.ball (0:E3) s \ K) +
        volume (symmDiff (F (ψ n)) K ∩ Metric.ball 0 s)) atTop
        (𝓝 (volume (Metric.ball (0:E3) s \ K))) := by
      have h := Tendsto.add (tendsto_const_nhds :
        Tendsto (fun _ : ℕ => volume (Metric.ball (0:E3) s \ K)) atTop _) (hconvK s hs)
      rwa [add_zero] at h
    constructor
    · refine ge_of_tendsto hT1 ?_
      filter_upwards [hevn] with n hn
      refine hn.1.trans ((measure_mono ?_).trans (measure_union_le _ _))
      intro y hy
      by_cases hyK : y ∈ K
      · exact Or.inl ⟨hyK, hy.2⟩
      · exact Or.inr ⟨Set.mem_symmDiff.2 (Or.inl ⟨hy.1, hyK⟩), hy.2⟩
    · refine ge_of_tendsto hT2 ?_
      filter_upwards [hevn] with n hn
      refine hn.2.trans ((measure_mono ?_).trans (measure_union_le _ _))
      intro y hy
      by_cases hyK : y ∈ K
      · exact Or.inr ⟨Set.mem_symmDiff.2 (Or.inr ⟨hyK, hy.2⟩), hy.1⟩
      · exact Or.inl ⟨hy.1, hyK⟩
  have hK1 : ∀ N ∈ 𝓝 (0:E3), volume (N \ K) ≠ 0 := by
    intro N hN
    obtain ⟨ε, hε, hεN⟩ := Metric.mem_nhds_iff.1 hN
    have hs : 0 < min ε 1 := lt_min hε one_pos
    have h := (hdK (min ε 1) hs (min_le_right _ _)).2
    have hpos : 0 < ENNReal.ofReal (c₀ * (min ε 1) ^ 3) :=
      ENNReal.ofReal_pos.2 (mul_pos hc₀ (pow_pos hs 3))
    have hsub : Metric.ball (0:E3) (min ε 1) \ K ⊆ N \ K :=
