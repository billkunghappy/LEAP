    isFiniteMeasure_restrict.2 hKc.measure_lt_top.ne
  have hGint : ∀ b : Fin 2, IntegrableOn (G b) (Metric.closedBall x₀ (4 * ρ)) :=
    fun b => (hGL2 b).integrable one_le_two
  have hAc : ∀ a' b : Fin 2, ContinuousOn (fun y => A y a' b) (Metric.closedBall x₀ (4 * ρ)) :=
    fun a' b => (hA a' b).continuousOn.mono hKU
  have hg : ∀ b : Fin 2, Integrable ((Metric.closedBall x₀ (4 * ρ)).indicator (G b)) :=
    fun b => (integrable_indicator_iff hKm).2 (hGint b)
  have hh : Integrable ((Metric.closedBall x₀ (4 * ρ)).indicator
      (fun y => ∑ b : Fin 2, A y a b * G b y)) :=
    (integrable_indicator_iff hKm).2
      (integrable_finset_sum _ fun b _ => IntegrableOn.continuousOn_mul (hAc a b) (hGint b) hKc)
  have hg2 : ∀ b : Fin 2, MemLp ((Metric.closedBall x₀ (4 * ρ)).indicator (G b)) 2 volume :=
    fun b => (memLp_indicator_iff_restrict hKm).2 (hGL2 b)
  have hsq : ∀ b : Fin 2, (∫ y, (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y ^ 2) =
      ∫ y in Metric.closedBall x₀ (4 * ρ), G b y ^ 2 := by
    intro b
    have e : (fun y => (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y ^ 2) =
