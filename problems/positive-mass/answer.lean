      (∀ y ∈ Metric.ball x r, y ∈ S → F y = 0) → ∀ (b : Fin 3) (w : E3 → ℝ),
      DifferentiableAt ℝ w x → x b = w x → ∀ r' : ℝ, 0 < r' →
      (∀ y, ‖coordPlaneProj b (y - x)‖ < r' → coordPlaneProj b y + w y • e b ∈ S) →
      ∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u) := by
    intro x r hr F hFd hSF b w hwd hx r' hr' hgr u
    let L : E3 →L[ℝ] E3 :=
      ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj b : E3 →L[ℝ] ℝ).smulRight (e b)
    have hL : ∀ y, L y = coordPlaneProj b y := by
      intro y
      simp [L, coordPlaneProj]
    let γ : E3 → E3 := fun y => coordPlaneProj b y + w y • e b
    have hγx : γ x = x := by
      simp only [γ]
      rw [← hx]
      exact (hdecomp b x).symm
    have hγd : HasFDerivAt γ (L + (fderiv ℝ w x).smulRight (e b)) x := by
      have h1 : HasFDerivAt (fun y => L y) L x := L.hasFDerivAt
      have h2 : HasFDerivAt (fun y => w y • e b) ((fderiv ℝ w x).smulRight (e b)) x :=
        hwd.hasFDerivAt.smul_const (e b)
      have h3 : HasFDerivAt (fun y => L y + w y • e b)
          (L + (fderiv ℝ w x).smulRight (e b)) x := h1.add h2
      have hfun : (fun y => L y + w y • e b) = γ := by
        funext y; simp only [γ, hL]
      rw [hfun] at h3
      exact h3
    have hFd' : HasFDerivAt F (fderiv ℝ F x) (γ x) := by
      rw [hγx]; exact hFd.hasFDerivAt
    have hcomp := hFd'.comp x hγd
    have hev : (F ∘ γ) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      have hγc : ContinuousAt γ x := hγd.continuousAt
      have hball : ∀ᶠ y in 𝓝 x, γ y ∈ Metric.ball x r := by
        have := hγc.preimage_mem_nhds (Metric.ball_mem_nhds (γ x) hr)
        rw [hγx] at this
        exact this
      have hcyl : ∀ᶠ y in 𝓝 x, ‖coordPlaneProj b (y - x)‖ < r' := by
        apply (hCylOpen b x r').mem_nhds
        show ‖coordPlaneProj b (x - x)‖ < r'
        simp [coordPlaneProj, hr']
      filter_upwards [hball, hcyl] with y hy1 hy2
      exact hSF (γ y) hy1 (hgr y hy2)
    have hzero : HasFDerivAt (F ∘ γ) (0 : E3 →L[ℝ] ℝ) x :=
      (hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq hev
    have huniq := hcomp.unique hzero
    have hu := congrArg (fun T : E3 →L[ℝ] ℝ => T u) huniq
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.zero_apply, hL, map_add,
      map_smul, smul_eq_mul] at hu
    have hsplit : fderiv ℝ F x u =
        fderiv ℝ F x (coordPlaneProj b u) + u b * fderiv ℝ F x (e b) := by
      conv_lhs => rw [hdecomp b u]
      rw [map_add, map_smul, smul_eq_mul]
    rw [hsplit]
    linear_combination hu
  have gti_ne : ∀ (F : E3 → ℝ) (x : E3) (b : Fin 3) (w : E3 → ℝ),
      (∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u)) →
      fderiv ℝ F x ≠ 0 → fderiv ℝ F x (e b) ≠ 0 := by
    intro F x b w h hne h0
    apply hne
    ext u
    rw [h u, h0, zero_mul]
    simp
  
  have hr1pos : 0 < r1 := by linarith
  have hzR : z ∈ S ∩ Metric.ball c R0 :=
    ⟨hz, by rw [Metric.mem_ball, dist_eq_norm]; linarith⟩
  have hzc4 : ‖z - c‖ < R0 / 4 := by linarith
  obtain ⟨r, hr, F, hFc, hFd, hFS⟩ := hS2 z hzR
  have hDF : fderiv ℝ F z ≠ 0 := hFd z (Metric.mem_ball_self hr)
  obtain ⟨b, -, hbslope⟩ := best_axis (fderiv ℝ F z) hDF
  have hsqrt2 : Real.sqrt 2 ≤ 7 / 4 := by
    rw [Real.sqrt_le_left (by norm_num)]
    norm_num
  
  obtain ⟨wz, hwzp, hwzc, hwzz, hwzs, hwz⟩ :=
    sheet_through_point c R0 K S hR0 hK hS1 hS2 hS3 z hz hzc4 r1 (Real.sqrt 2) hr1pos hKr1
      h4r1 (Real.sqrt_nonneg 2) hsqrt2 b r hr F hFc hFS hDF hbslope
  
  have hpar : ∀ y, ‖coordPlaneProj a (y - z0)‖ < r1 → ‖coordPlaneProj b (y - z)‖ < r1 →
      y a = w0 y → y b = wz y →
      ∃ μ : ℝ, ∀ u, u a - fderiv ℝ w0 y u = μ * (u b - fderiv ℝ wz y u) := by
    intro y hy0 hyz hya hyb
    have hyeq : coordPlaneProj a y + w0 y • e a = y := by
      rw [← hya]; exact (hdecomp a y).symm
    have hyS : y ∈ S ∩ Metric.ball c R0 := by
      have := hw0g y hy0
      rw [hyeq] at this
      exact this
    obtain ⟨r', hr', F', hF'c, hF'd, hF'S⟩ := hS2 y hyS
    have hF'diff : DifferentiableAt ℝ F' y :=
      (hF'c.contDiffAt (Metric.ball_mem_nhds y hr')).differentiableAt (by simp)
    have hw0d : DifferentiableAt ℝ w0 y :=
      (hw0c.contDiffAt ((hCylOpen a z0 r1).mem_nhds hy0)).differentiableAt (by simp)
    have hwzd : DifferentiableAt ℝ wz y :=
      (hwzc.contDiffAt ((hCylOpen b z r1).mem_nhds hyz)).differentiableAt (by simp)
    have hgr0 : ∀ y', ‖coordPlaneProj a (y' - y)‖ < r1 - ‖coordPlaneProj a (y - z0)‖ →
        coordPlaneProj a y' + w0 y' • e a ∈ S := by
      intro y' hy'
      have e1 : coordPlaneProj a (y' - z0) =
          coordPlaneProj a (y' - y) + coordPlaneProj a (y - z0) := by
        rw [hP5, hP5, hP5]; abel
      have h3 : ‖coordPlaneProj a (y' - z0)‖ < r1 := by
        rw [e1]
        linarith [norm_add_le (coordPlaneProj a (y' - y)) (coordPlaneProj a (y - z0))]
      exact (hw0g y' h3).1
    have hgrz : ∀ y', ‖coordPlaneProj b (y' - y)‖ < r1 - ‖coordPlaneProj b (y - z)‖ →
        coordPlaneProj b y' + wz y' • e b ∈ S := by
      intro y' hy'
      have e1 : coordPlaneProj b (y' - z) =
          coordPlaneProj b (y' - y) + coordPlaneProj b (y - z) := by
        rw [hP5, hP5, hP5]; abel
      have h3 : ‖coordPlaneProj b (y' - z)‖ < r1 := by
        rw [e1]
        linarith [norm_add_le (coordPlaneProj b (y' - y)) (coordPlaneProj b (y - z))]
      exact (hwz y' h3).1
    have hSF' : ∀ y' ∈ Metric.ball y r', y' ∈ S → F' y' = 0 :=
      fun y' hy' hy'S => (hF'S y' hy').1 hy'S
    have h1 := gti y r' hr' F' hF'diff hSF' a w0 hw0d hya
      (r1 - ‖coordPlaneProj a (y - z0)‖) (by linarith) hgr0
    have h2 := gti y r' hr' F' hF'diff hSF' b wz hwzd hyb
      (r1 - ‖coordPlaneProj b (y - z)‖) (by linarith) hgrz
    have hne : fderiv ℝ F' y (e a) ≠ 0 :=
      gti_ne F' y a w0 h1 (hF'd y (Metric.mem_ball_self hr'))
    refine ⟨fderiv ℝ F' y (e b) / fderiv ℝ F' y (e a), fun u => ?_⟩
    rw [div_mul_eq_mul_div, eq_div_iff hne]
    linear_combination h2 u - h1 u
  
  have hzz : ‖z - z0‖ < 2 * ρ := by
    have h1 := norm_sub_le_norm_sub_add_norm_sub z c z0
    rw [norm_sub_rev c z0] at h1
    linarith
  have htilt := tilted_graphs_parallel a b z0 z ρ K r1 hρ hK hKρ hr1 hzz w0 wz hw0 hwzp hw0c
    hwzc hw0z hwzz hw0H (fun y hy => (hwz y hy).2.2.2.1) hw0s hwzs hpar
  
  have hFdz : DifferentiableAt ℝ F z :=
    (hFc.contDiffAt (Metric.ball_mem_nhds z hr)).differentiableAt (by simp)
  have hzcyl : z ∈ {y : E3 | ‖coordPlaneProj b (y - z)‖ < r1} := by
    show ‖coordPlaneProj b (z - z)‖ < r1
    simp [coordPlaneProj, hr1pos]
  have hwzdz : DifferentiableAt ℝ wz z :=
    (hwzc.contDiffAt ((hCylOpen b z r1).mem_nhds hzcyl)).differentiableAt (by simp)
  have hT := gti z r hr F hFdz (fun y hy hyS => (hFS y hy).1 hyS) b wz hwzdz hwzz.symm r1
    hr1pos (fun y hy => (hwz y hy).1)
  have hslope_a : ∀ u, |fderiv ℝ F z (coordPlaneProj a u)| ≤
      7 / 4 * |fderiv ℝ F z (e a)| * ‖u‖ := by
    intro u
    rw [hT (coordPlaneProj a u), hT (e a), abs_mul, abs_mul]
    calc |fderiv ℝ F z (e b)| *
          |(coordPlaneProj a u) b - fderiv ℝ wz z (coordPlaneProj a u)|
        ≤ |fderiv ℝ F z (e b)| * (7 / 4 * |(e a) b - fderiv ℝ wz z (e a)| * ‖u‖) :=
          mul_le_mul_of_nonneg_left (htilt u) (abs_nonneg _)
      _ = 7 / 4 * (|fderiv ℝ F z (e b)| * |(e a) b - fderiv ℝ wz z (e a)|) * ‖u‖ := by ring
  
  obtain ⟨w, hwp, hwc, hwz', -, hw⟩ :=
    sheet_through_point c R0 K S hR0 hK hS1 hS2 hS3 z hz hzc4 r1 (7 / 4) hr1pos hKr1 h4r1
      (by norm_num) le_rfl a r hr F hFc hFS hDF hslope_a
  refine ⟨w, hwp, hwc, hwz', fun y hy => ?_⟩
  obtain ⟨hS', -, hsl, hH, hdr⟩ := hw y hy
  refine ⟨hS', ?_, hH, ?_⟩
  · have h1 : K * ‖coordPlaneProj a (y - z)‖ ≤ K * r1 := mul_le_mul_of_nonneg_left hy.le hK
    linarith
  · have h2 : (7 / 4 + 1 / 8 : ℝ) = 15 / 8 := by norm_num
    rw [h2] at hdr
    exact hdr

theorem finite_ordered_sheets (c : E3) (R0 ρ : ℝ) (S : Set E3)
    (hS1 : ∀ z ∈ Metric.ball c R0, z ∈ closure S → z ∈ S)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (a : Fin 3) (hρ : 0 < ρ) (h9 : 9 * ρ < R0) (Z : Set E3) (W : E3 → E3 → ℝ)
    (hW1 : ∀ z ∈ Z, ∀ y, W z (coordPlaneProj a y) = W z y)
    (hW2 : ∀ z ∈ Z, ContDiffOn ℝ ∞ (W z) {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ})
    (hW3 : ∀ z ∈ Z, ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ →
      coordPlaneProj a y + W z y • e a ∈ S ∩ Metric.ball c R0 ∧
      |W z y - c a| ≤ 9 * ρ ∧ ‖fderiv ℝ (W z) y‖ ≤ 2) :
    ∃ (l : ℕ) (v : Fin l → E3 → ℝ), (∀ i, ∃ z ∈ Z, v i = W z) ∧
      (∀ i i' : Fin l, i < i' → ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ → v i y < v i' y) ∧
      (∀ z ∈ Z, ∃ i, ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ → W z y = v i y) :=
by
  classical
  
  have hGa : ∀ (u : E3) (t : ℝ), (coordPlaneProj a u + t • e a) a = t := by
    intro u t
    simp [coordPlaneProj, e]
  have hPG : ∀ (u : E3) (t : ℝ),
      coordPlaneProj a (coordPlaneProj a u + t • e a) = coordPlaneProj a u := by
    intro u t
    ext i
    simp [coordPlaneProj, e, EuclideanSpace.single_apply]
  have hdec : ∀ u : E3, coordPlaneProj a u + u a • e a = u := by
    intro u
    simp [coordPlaneProj]
  have hea_norm : ‖e a‖ = 1 := by
    simp [e, EuclideanSpace.norm_single]
  have hcoord : ∀ u : E3, |u a| ≤ ‖u‖ := by
    intro u
    have := PiLp.norm_apply_le u a
    simpa [Real.norm_eq_abs] using this
  set Pl : E3 →L[ℝ] E3 :=
    ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj a).smulRight (e a) with hPldef
  have hPl : ∀ u, Pl u = coordPlaneProj a u := by
    intro u
    simp [hPldef, coordPlaneProj]
  have hPfun : (fun u => coordPlaneProj a u) = fun u => Pl u := funext fun u => (hPl u).symm
  have hPcont : Continuous (fun u => coordPlaneProj a u) := by
    rw [hPfun]; exact Pl.continuous
  
  obtain ⟨C, hC⟩ : ∃ C : Set E3, C = {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} := ⟨_, rfl⟩
  have hmemC : ∀ y, y ∈ C ↔ ‖coordPlaneProj a (y - c)‖ < 3 * ρ := by
    intro y; rw [hC]; rfl
  have hCo : IsOpen C := by
    rw [hC]
    exact isOpen_lt (continuous_norm.comp (hPcont.comp (continuous_id.sub continuous_const)))
      continuous_const
  have hCc : Convex ℝ C := by
    rw [convex_iff_forall_pos]
    intro x hx y hy s t hs ht hst
    rw [hmemC] at hx hy ⊢
    have h1 : s • x + t • y - c = s • (x - c) + t • (y - c) := by
      rw [smul_sub, smul_sub, ← sub_eq_zero]
      have : c = s • c + t • c := by rw [← add_smul, hst, one_smul]
      rw [this]
      abel_nf
      rw [← this]
      abel
    rw [h1, ← hPl, map_add, map_smul, map_smul, hPl, hPl]
    calc ‖s • coordPlaneProj a (x - c) + t • coordPlaneProj a (y - c)‖
        ≤ ‖s • coordPlaneProj a (x - c)‖ + ‖t • coordPlaneProj a (y - c)‖ := norm_add_le _ _
      _ = s * ‖coordPlaneProj a (x - c)‖ + t * ‖coordPlaneProj a (y - c)‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hs,
            abs_of_pos ht]
      _ < s * (3 * ρ) + t * (3 * ρ) := by
          have := mul_lt_mul_of_pos_left hx hs
          have := mul_lt_mul_of_pos_left hy ht
          linarith
      _ = 3 * ρ := by rw [← add_mul, hst, one_mul]
  have hcC : c ∈ C := by
    rw [hmemC, sub_self]
    have : coordPlaneProj a 0 = 0 := by simp [coordPlaneProj]
    rw [this, norm_zero]
    linarith
  have hWd : ∀ z ∈ Z, ∀ y ∈ C, DifferentiableAt ℝ (W z) y := by
    intro z hz y hy
    rw [hC] at hy
    have hO : IsOpen {y : E3 | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} := by rw [← hC]; exact hCo
    exact ((hW2 z hz).differentiableOn (by simp)).differentiableAt (hO.mem_nhds hy)
  have hWc : ∀ z ∈ Z, ContinuousOn (W z) C := by
    intro z hz; rw [hC]; exact (hW2 z hz).continuousOn
  have hGcont : ∀ z ∈ Z, ∀ y ∈ C,
      ContinuousAt (fun u => coordPlaneProj a u + W z u • e a) y := by
    intro z hz y hy
    exact hPcont.continuousAt.add ((hWd z hz y hy).continuousAt.smul continuousAt_const)
  
  have VU : ∀ q ∈ Metric.ball c R0, ∃ δ > 0, ∀ z ∈ Z, ∀ y ∈ C, ∀ z' ∈ Z, ∀ y' ∈ C,
      coordPlaneProj a y + W z y • e a ∈ Metric.ball q δ →
      coordPlaneProj a y' + W z' y' • e a ∈ Metric.ball q δ →
      coordPlaneProj a y = coordPlaneProj a y' → W z y = W z' y' := by
    intro q hq
    by_cases hqS : q ∈ S
    swap
    · 
      have hqcl : q ∉ closure S := fun h => hqS (hS1 q hq h)
      obtain ⟨δ, hδ, hδS⟩ : ∃ δ > 0, ∀ x ∈ S, δ ≤ dist q x := by
        rw [Metric.mem_closure_iff] at hqcl
        push_neg at hqcl
        exact hqcl
      refine ⟨δ, hδ, ?_⟩
      intro z hz y hy z' hz' y' hy' hx hx' hPP
      exfalso
      have h1 := hδS _ (hW3 z hz y ((hmemC y).mp hy)).1.1
      rw [mem_ball, dist_comm] at hx
      linarith
    obtain ⟨r, hr, F, hFc, hFd, hFS⟩ := hS2 q ⟨hqS, hq⟩
    have hFdiff : ∀ x ∈ Metric.ball q r, DifferentiableAt ℝ F x := fun x hx =>
      (hFc.differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hx)
    have hDc : ContinuousAt (fderiv ℝ F) q :=
      (hFc.continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).continuousAt
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))
    by_cases hDa : fderiv ℝ F q (e a) = 0
    · 
      
      have s1 : ∀ z ∈ Z, ∀ y ∈ C, coordPlaneProj a y + W z y • e a ∈ Metric.ball q r →
          ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a)‖ ≤
            3 * |fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a)| := by
        intro z hz y hy hx
        have hG : HasFDerivAt (fun u => coordPlaneProj a u + W z u • e a)
            (Pl + (fderiv ℝ (W z) y).smulRight (e a)) y := by
          have h1 : HasFDerivAt (fun u => coordPlaneProj a u) Pl y := by
            rw [hPfun]; exact Pl.hasFDerivAt
          have h2 : HasFDerivAt (fun u => W z u • e a) ((fderiv ℝ (W z) y).smulRight (e a)) y :=
            (hWd z hz y hy).hasFDerivAt.smul_const (e a)
          exact h1.add h2
        have hFG : HasFDerivAt (F ∘ fun u => coordPlaneProj a u + W z u • e a)
            ((fderiv ℝ F (coordPlaneProj a y + W z y • e a)).comp
              (Pl + (fderiv ℝ (W z) y).smulRight (e a))) y :=
          (hFdiff _ hx).hasFDerivAt.comp y hG
        have hev : (F ∘ fun u => coordPlaneProj a u + W z u • e a) =ᶠ[𝓝 y]
            fun _ => (0 : ℝ) := by
          have h1 : ∀ᶠ u in 𝓝 y, coordPlaneProj a u + W z u • e a ∈ Metric.ball q r :=
            hG.continuousAt.preimage_mem_nhds (Metric.isOpen_ball.mem_nhds hx)
          filter_upwards [h1, hCo.mem_nhds hy] with u hu1 hu2
          exact (hFS _ hu1).mp ((hW3 z hz u ((hmemC u).mp hu2)).1.1)
        have h0 : HasFDerivAt (F ∘ fun u => coordPlaneProj a u + W z u • e a)
            (0 : E3 →L[ℝ] ℝ) y :=
          (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
        have hzero := hFG.unique h0
        have hv : ∀ v : E3, fderiv ℝ F (coordPlaneProj a y + W z y • e a) v =
            fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a) *
              (v a - fderiv ℝ (W z) y v) := by
          intro v
          have h := congrArg (fun T : E3 →L[ℝ] ℝ => T v) hzero
          simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
            ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.zero_apply, map_add,
            map_smul, smul_eq_mul, hPl] at h
          have hd : fderiv ℝ F (coordPlaneProj a y + W z y • e a) v =
              fderiv ℝ F (coordPlaneProj a y + W z y • e a) (coordPlaneProj a v) +
                v a * fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a) := by
            conv_lhs => rw [← hdec v]
            rw [map_add, map_smul, smul_eq_mul]
          rw [hd]
          linear_combination h
        apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
        intro v
        rw [hv v, Real.norm_eq_abs, abs_mul]
        have hL2 : ‖fderiv ℝ (W z) y‖ ≤ 2 := (hW3 z hz y ((hmemC y).mp hy)).2.2
        have hLv : |fderiv ℝ (W z) y v| ≤ 2 * ‖v‖ := by
          have := (fderiv ℝ (W z) y).le_opNorm v
          rw [Real.norm_eq_abs] at this
          nlinarith [norm_nonneg v]
        have h1 : |v a - fderiv ℝ (W z) y v| ≤ 3 * ‖v‖ := by
          have ha := abs_le.mp (hcoord v)
          have hb := abs_le.mp hLv
          exact abs_le.mpr ⟨by linarith, by linarith⟩
        calc |fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a)| *
              |v a - fderiv ℝ (W z) y v|
            ≤ |fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a)| * (3 * ‖v‖) :=
              mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
          _ = 3 * |fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a)| * ‖v‖ := by ring
      have hD0 : fderiv ℝ F q ≠ 0 := hFd q (Metric.mem_ball_self hr)
      have hDpos : 0 < ‖fderiv ℝ F q‖ := norm_pos_iff.mpr hD0
      obtain ⟨δ0, hδ0, hδ0'⟩ :=
        Metric.continuousAt_iff.mp hDc (‖fderiv ℝ F q‖ / 4) (by positivity)
      refine ⟨min δ0 r, lt_min hδ0 hr, ?_⟩
      intro z hz y hy z' hz' y' hy' hx hx' hPP
      exfalso
      have hxr : coordPlaneProj a y + W z y • e a ∈ Metric.ball q r :=
        Metric.ball_subset_ball (min_le_right _ _) hx
      have hxδ : dist (coordPlaneProj a y + W z y • e a) q < δ0 :=
        lt_of_lt_of_le (Metric.mem_ball.mp hx) (min_le_left _ _)
      have hclose : ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q‖ <
          ‖fderiv ℝ F q‖ / 4 := by
        rw [← dist_eq_norm]; exact hδ0' hxδ
      have hbound := s1 z hz y hy hxr
      have h1 : |fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a)| <
          ‖fderiv ℝ F q‖ / 4 := by
        have heq : fderiv ℝ F (coordPlaneProj a y + W z y • e a) (e a) =
            (fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q) (e a) := by
          rw [ContinuousLinearMap.sub_apply, hDa, sub_zero]
        rw [heq]
        calc |(fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q) (e a)|
            = ‖(fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q) (e a)‖ :=
              (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q‖ * ‖e a‖ :=
              ContinuousLinearMap.le_opNorm _ _
          _ = ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q‖ := by
              rw [hea_norm, mul_one]
          _ < _ := hclose
      have h2 : ‖fderiv ℝ F q‖ ≤ ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a)‖ +
          ‖fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q‖ := by
        have := norm_sub_le (fderiv ℝ F (coordPlaneProj a y + W z y • e a))
          (fderiv ℝ F (coordPlaneProj a y + W z y • e a) - fderiv ℝ F q)
        rwa [sub_sub_cancel] at this
      linarith
    · 
      have hcont_ea : ContinuousAt (fun y => fderiv ℝ F y (e a)) q :=
        hDc.clm_apply continuousAt_const
      obtain ⟨δ0, hδ0, hne⟩ := Metric.eventually_nhds_iff.mp (hcont_ea.eventually_ne hDa)
      refine ⟨min δ0 r, lt_min hδ0 hr, ?_⟩
      have hB : Metric.ball q (min δ0 r) ⊆ Metric.ball q r :=
        Metric.ball_subset_ball (min_le_right _ _)
      have key : ∀ x ∈ S, ∀ x' ∈ S, x ∈ Metric.ball q (min δ0 r) →
          x' ∈ Metric.ball q (min δ0 r) → coordPlaneProj a x = coordPlaneProj a x' →
          ¬ (x a < x' a) := by
        intro x hxS x' hx'S hx hx' hPP hlt
        have hF0 : F x = 0 := (hFS x (hB hx)).mp hxS
        have hF0' : F x' = 0 := (hFS x' (hB hx')).mp hx'S
        have hx'eq : x' = x + (x' a - x a) • e a := by
          have h1 := hdec x
          have h2 := hdec x'
          rw [← hPP] at h2
          calc x' = coordPlaneProj a x + x' a • e a := h2.symm
            _ = (coordPlaneProj a x + x a • e a) + (x' a - x a) • e a := by
                rw [sub_smul]; abel
            _ = x + (x' a - x a) • e a := by rw [h1]
        have hsne : x' a - x a ≠ 0 := by linarith
        have hseg : ∀ τ ∈ Set.Icc (x a) (x' a),
            x + (τ - x a) • e a ∈ Metric.ball q (min δ0 r) := by
          intro τ hτ
          have hθ : (τ - x a) / (x' a - x a) ∈ Set.Icc (0 : ℝ) 1 :=
            ⟨div_nonneg (by linarith [hτ.1]) (by linarith),
              (div_le_one (by linarith)).mpr (by linarith [hτ.2])⟩
          have hm := (convex_ball q (min δ0 r)).add_smul_sub_mem hx hx' hθ
          have hdiff : x' - x = (x' a - x a) • e a := by
            rw [sub_eq_iff_eq_add, add_comm]; exact hx'eq
          have hrw : ((τ - x a) / (x' a - x a)) • (x' - x) = (τ - x a) • e a := by
            rw [hdiff, smul_smul, div_mul_cancel₀ _ hsne]
          rw [hrw] at hm
          exact hm
        have hderiv : ∀ τ ∈ Set.Icc (x a) (x' a),
            HasDerivAt (fun τ : ℝ => F (x + (τ - x a) • e a))
              (fderiv ℝ F (x + (τ - x a) • e a) (e a)) τ := by
          intro τ hτ
          have hpt := hseg τ hτ
          have hFd' : HasFDerivAt F (fderiv ℝ F (x + (τ - x a) • e a))
              (x + (τ - x a) • e a) := (hFdiff _ (hB hpt)).hasFDerivAt
          have hline : HasDerivAt (fun τ : ℝ => x + (τ - x a) • e a) (e a) τ := by
            have := (((hasDerivAt_id τ).sub_const (x a)).smul_const (e a)).const_add x
            simpa using this
          exact hFd'.comp_hasDerivAt τ hline
        obtain ⟨τ, hτ, hτ0⟩ := exists_hasDerivAt_eq_zero
          (f' := fun τ => fderiv ℝ F (x + (τ - x a) • e a) (e a)) hlt
          (fun τ hτ => (hderiv τ hτ).continuousAt.continuousWithinAt)
          (by
            show F (x + (x a - x a) • e a) = F (x + (x' a - x a) • e a)
            rw [← hx'eq, sub_self, zero_smul, add_zero, hF0, hF0'])
          (fun τ hτ => hderiv τ (Set.Ioo_subset_Icc_self hτ))
        exact hne (lt_of_lt_of_le (Metric.mem_ball.mp (hseg τ (Set.Ioo_subset_Icc_self hτ)))
          (min_le_left _ _)) hτ0
      intro z hz y hy z' hz' y' hy' hx hx' hPP
      have hxS := (hW3 z hz y ((hmemC y).mp hy)).1.1
      have hx'S := (hW3 z' hz' y' ((hmemC y').mp hy')).1.1
      have hPx : coordPlaneProj a (coordPlaneProj a y + W z y • e a) =
          coordPlaneProj a (coordPlaneProj a y' + W z' y' • e a) := by
        rw [hPG, hPG, hPP]
      rcases lt_trichotomy ((coordPlaneProj a y + W z y • e a) a)
          ((coordPlaneProj a y' + W z' y' • e a) a) with h | h | h
      · exact absurd h (key _ hxS _ hx'S hx hx' hPx)
      · rw [hGa, hGa] at h; exact h
      · exact absurd h (key _ hx'S _ hxS hx' hx hPx.symm)
  
  have LC : ∀ z ∈ Z, ∀ z' ∈ Z, ∀ y₀ ∈ C, W z y₀ = W z' y₀ →
      ∀ᶠ y in 𝓝 y₀, W z y = W z' y := by
    intro z hz z' hz' y₀ hy₀ heq
    obtain ⟨δ, hδ, hU⟩ := VU _ (hW3 z hz y₀ ((hmemC y₀).mp hy₀)).1.2
    have hc1 : ∀ᶠ y in 𝓝 y₀, coordPlaneProj a y + W z y • e a ∈
        Metric.ball (coordPlaneProj a y₀ + W z y₀ • e a) δ :=
      (hGcont z hz y₀ hy₀).preimage_mem_nhds
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ))
    have hc2 : ∀ᶠ y in 𝓝 y₀, coordPlaneProj a y + W z' y • e a ∈
        Metric.ball (coordPlaneProj a y₀ + W z y₀ • e a) δ := by
      refine (hGcont z' hz' y₀ hy₀).preimage_mem_nhds (Metric.isOpen_ball.mem_nhds ?_)
      show coordPlaneProj a y₀ + W z' y₀ • e a ∈
        Metric.ball (coordPlaneProj a y₀ + W z y₀ • e a) δ
      rw [heq]; exact Metric.mem_ball_self hδ
    filter_upwards [hc1, hc2, hCo.mem_nhds hy₀] with y h1 h2 h3
    exact hU z hz y h3 z' hz' y h3 h1 h2 rfl
  
  have hCpre : IsPreconnected C := hCc.isPreconnected
  have ID : ∀ z ∈ Z, ∀ z' ∈ Z, ∀ y₀ ∈ C, W z y₀ = W z' y₀ → ∀ y ∈ C, W z y = W z' y := by
    intro z hz z' hz' y₀ hy₀ heq
    have hsub : C ⊆ {y | ∀ᶠ y' in 𝓝 y, W z y' = W z' y'} := by
      refine hCpre.subset_of_closure_inter_subset isOpen_setOf_eventually_nhds
        ⟨y₀, hy₀, LC z hz z' hz' y₀ hy₀ heq⟩ ?_
      rintro y ⟨hycl, hyC⟩
      by_contra hnot
      have hne : W z y ≠ W z' y := fun h => hnot (LC z hz z' hz' y hyC h)
      have hev : ∀ᶠ y' in 𝓝 y, W z y' ≠ W z' y' :=
        ((((hWc z hz).continuousAt (hCo.mem_nhds hyC)).sub
          ((hWc z' hz').continuousAt (hCo.mem_nhds hyC))).eventually_ne
            (sub_ne_zero.mpr hne)).mono fun y' h => sub_ne_zero.mp h
      obtain ⟨y', hy'u, hy'ne⟩ := ((mem_closure_iff_frequently.mp hycl).and_eventually hev).exists
      exact hy'ne (show ∀ᶠ y'' in 𝓝 y', W z y'' = W z' y'' from hy'u).self_of_nhds
    intro y hy
    exact (show ∀ᶠ y'' in 𝓝 y, W z y'' = W z' y'' from hsub hy).self_of_nhds
  have ORD : ∀ z ∈ Z, ∀ z' ∈ Z, W z c < W z' c → ∀ y ∈ C, W z y < W z' y := by
    intro z hz z' hz' hlt y hy
    by_contra hle
    push_neg at hle
    obtain ⟨y₂, hy₂, heq⟩ :=
      hCpre.intermediate_value₂ hcC hy (hWc z hz) (hWc z' hz') hlt.le hle
    have := ID z hz z' hz' y₂ hy₂ heq c hcC
    linarith
  
  have FIN : ((fun z => W z c) '' Z).Finite := by
    by_contra hinf
    have hTsub : (fun z => W z c) '' Z ⊆ Set.Icc (c a - 9 * ρ) (c a + 9 * ρ) := by
      rintro _ ⟨z, hz, rfl⟩
      have := abs_le.mp (hW3 z hz c ((hmemC c).mp hcC)).2.1
      exact ⟨by linarith [this.1], by linarith [this.2]⟩
    obtain ⟨t, ht, hacc⟩ :=
      Set.Infinite.exists_accPt_of_subset_isCompact hinf isCompact_Icc hTsub
    have hqt : coordPlaneProj a c + t • e a ∈ Metric.ball c R0 := by
      rw [Metric.mem_ball, dist_eq_norm]
      have hrw : coordPlaneProj a c + t • e a - c = (t - c a) • e a := by
        have h1 := hdec c
        calc coordPlaneProj a c + t • e a - c
            = coordPlaneProj a c + t • e a - (coordPlaneProj a c + c a • e a) := by rw [h1]
          _ = (t - c a) • e a := by rw [sub_smul]; abel
      rw [hrw, norm_smul, hea_norm, mul_one, Real.norm_eq_abs]
      have : |t - c a| ≤ 9 * ρ := abs_le.mpr ⟨by linarith [ht.1], by linarith [ht.2]⟩
      linarith
    obtain ⟨δ, hδ, hU⟩ := VU _ hqt
    have hb : ∀ s : ℝ, |s - t| < δ →
        coordPlaneProj a c + s • e a ∈ Metric.ball (coordPlaneProj a c + t • e a) δ := by
      intro s hs
      rw [Metric.mem_ball, dist_eq_norm]
      have hrw : coordPlaneProj a c + s • e a - (coordPlaneProj a c + t • e a) =
          (s - t) • e a := by rw [sub_smul]; abel
      rw [hrw, norm_smul, hea_norm, mul_one, Real.norm_eq_abs]
      exact hs
    have huniq : ∀ z₁ ∈ Z, ∀ z₂ ∈ Z, |W z₁ c - t| < δ → |W z₂ c - t| < δ →
        W z₁ c = W z₂ c := by
      intro z₁ hz₁ z₂ hz₂ h1 h2
      exact hU z₁ hz₁ c hcC z₂ hz₂ c hcC (hb _ h1) (hb _ h2) rfl
    rw [accPt_iff_nhds] at hacc
    obtain ⟨t₁, ⟨ht₁b, z₁, hz₁, hzt₁⟩, ht₁ne⟩ := hacc (Metric.ball t δ) (Metric.ball_mem_nhds t hδ)
    simp only at hzt₁
    subst hzt₁
    have hη : 0 < |W z₁ c - t| := abs_pos.mpr (sub_ne_zero.mpr ht₁ne)
    obtain ⟨t₂, ⟨ht₂b, z₂, hz₂, hzt₂⟩, ht₂ne⟩ :=
      hacc (Metric.ball t |W z₁ c - t|) (Metric.ball_mem_nhds t hη)
    simp only at hzt₂
    subst hzt₂
    rw [Metric.mem_ball, Real.dist_eq] at ht₁b ht₂b
    have := huniq z₁ hz₁ z₂ hz₂ ht₁b (lt_trans ht₂b ht₁b)
    rw [this] at ht₂b
    exact lt_irrefl _ ht₂b
  
  have hmem : ∀ i : Fin FIN.toFinset.card, ∃ z ∈ Z, W z c = FIN.toFinset.orderEmbOfFin rfl i := by
    intro i
    have := FIN.toFinset.orderEmbOfFin_mem rfl i
    rw [Set.Finite.mem_toFinset] at this
    obtain ⟨z, hz, h⟩ := this
    exact ⟨z, hz, h⟩
  choose zf hzf hzfc using hmem
  refine ⟨FIN.toFinset.card, fun i => W (zf i), fun i => ⟨zf i, hzf i, rfl⟩, ?_, ?_⟩
  · intro i i' hii' y hy
    apply ORD (zf i) (hzf i) (zf i') (hzf i') _ y ((hmemC y).mpr hy)
    rw [hzfc, hzfc]
    exact (FIN.toFinset.orderEmbOfFin rfl).strictMono hii'
  · intro z hz
    have hzs : W z c ∈ Set.range (FIN.toFinset.orderEmbOfFin rfl) := by
      rw [Finset.range_orderEmbOfFin, Finset.mem_coe, Set.Finite.mem_toFinset]
      exact ⟨z, hz, rfl⟩
    obtain ⟨i, hi⟩ := hzs
    refine ⟨i, fun y hy => ID z hz (zf i) (hzf i) c hcC ?_ y ((hmemC y).mpr hy)⟩
    rw [hzfc, hi]

theorem euclidean_sheet_structure (c : E3) (R0 K : ℝ) (hR0 : 0 < R0) (hK : 0 ≤ K) :
    ∃ ρ : ℝ, 0 < ρ ∧ 20 * ρ ≤ R0 ∧ ∀ S : Set E3,
      (∀ z ∈ Metric.ball c R0, z ∈ closure S → z ∈ S) →
      (∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
        ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
        ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0)) →
      (∀ z ∈ S ∩ Metric.ball c R0, ∀ (b : Fin 3) (w : E3 → ℝ) (r : ℝ), 0 < r →
        ContDiffAt ℝ 2 w (coordPlaneProj b z) → (∀ y, w (coordPlaneProj b y) = w y) →
        z b = w (coordPlaneProj b z) →
        (∀ y, ‖coordPlaneProj b (y - z)‖ < r →
          coordPlaneProj b y + w (coordPlaneProj b y) • e b ∈ S) →
        ‖fderiv ℝ w (coordPlaneProj b z)‖ ≤ 2 →
        ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b z)‖ ≤ K) →
      ∃ (a : Fin 3) (l : ℕ) (v : Fin l → E3 → ℝ),
        (∀ i y, v i (coordPlaneProj a y) = v i y) ∧
        (∀ i, ContDiffOn ℝ ∞ (v i) {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ}) ∧
        (∀ i y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ →
          ‖fderiv ℝ (v i) y‖ ≤ 2 ∧ ‖iteratedFDeriv ℝ 2 (v i) y‖ ≤ K ∧
          |v i y - c a| ≤ 9 * ρ ∧ coordPlaneProj a y + v i y • e a ∈ S) ∧
        (∀ i y, ‖coordPlaneProj a (y - c)‖ < 2 * ρ → |v i y - c a| < 8 * ρ) ∧
        (∀ i i' : Fin l, i < i' → ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ → v i y < v i' y) ∧
        (∀ z ∈ S, z ∈ Metric.ball c ρ → ∃ i, z a = v i z) :=
by
  
  have hP5 : ∀ (a : Fin 3) (y z : E3),
      coordPlaneProj a (y - z) = coordPlaneProj a y - coordPlaneProj a z := by
    intro a y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hea : ∀ a : Fin 3, (e a) a = 1 := by
    intro a; simp [e]
  have hpa : ∀ (a : Fin 3) (q : E3), (coordPlaneProj a q) a = 0 := by
    intro a q
    simp [coordPlaneProj, e]
  have hP3 : ∀ (a : Fin 3) (q : E3),
      coordPlaneProj a (coordPlaneProj a q) = coordPlaneProj a q := by
    intro a q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP2 : ∀ (a : Fin 3) (q : E3) (t : ℝ),
      coordPlaneProj a (q + t • e a) = coordPlaneProj a q := by
    intro a q t
    simp only [coordPlaneProj, PiLp.add_apply, PiLp.smul_apply, hea, smul_eq_mul, mul_one,
      add_smul]
    abel
  have hP4 : ∀ (a : Fin 3) (q : E3) (t : ℝ), (coordPlaneProj a q + t • e a) a = t := by
    intro a q t
    simp only [PiLp.add_apply, PiLp.smul_apply, hpa, hea, smul_eq_mul, mul_one, zero_add]
  have hP1 : ∀ (a : Fin 3) (q c : E3) (t : ℝ),
      coordPlaneProj a (coordPlaneProj a q + t • e a - c) = coordPlaneProj a (q - c) := by
    intro a q c t
    rw [hP5, hP2, hP3, hP5]
  have hP6 : ∀ (a : Fin 3) (w : E3), ‖w‖ ≤ ‖coordPlaneProj a w‖ + |w a| := by
    intro a w
    have hw : w = coordPlaneProj a w + (w a) • e a := by
      simp [coordPlaneProj]
    calc ‖w‖ = ‖coordPlaneProj a w + (w a) • e a‖ := by rw [← hw]
      _ ≤ ‖coordPlaneProj a w‖ + ‖(w a) • e a‖ := norm_add_le _ _
      _ = ‖coordPlaneProj a w‖ + |w a| := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  have hP7 : ∀ (a : Fin 3) (w : E3), ‖coordPlaneProj a w‖ ≤ ‖w‖ := by
    intro a w
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    by_cases h : i = a
    · subst h
      rw [hpa]; simpa using sq_nonneg (w i)
    · simp [coordPlaneProj, e, EuclideanSpace.single_apply, h]
  have hpa_le : ∀ (a : Fin 3) (w : E3), |w a| ≤ ‖w‖ := by
    intro a w
    rw [EuclideanSpace.norm_eq, ← Real.sqrt_sq_eq_abs]
    apply Real.sqrt_le_sqrt
    have h := Finset.single_le_sum (f := fun i => ‖w i‖ ^ 2) (fun i _ => sq_nonneg _)
      (Finset.mem_univ a)
    simpa [Real.norm_eq_abs, sq_abs] using h
  have hPc : ∀ (b j : Fin 3) (u : E3), (coordPlaneProj b u) j = if j = b then 0 else u j := by
    intro b j u
    by_cases h : j = b
    · subst h; simp [hpa]
    · simp [coordPlaneProj, e, EuclideanSpace.single_apply, h]
  
  have key : ∀ (x y d1 d2 M n : ℝ), |d1| ≤ M → |d2| ≤ M → x ^ 2 + y ^ 2 ≤ n ^ 2 → 0 ≤ n →
      |x * d1 + y * d2| ≤ Real.sqrt 2 * M * n := by
    intro x y d1 d2 M n h1 h2 hxy hn
    have hM : 0 ≤ M := le_trans (abs_nonneg _) h1
    have hs : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    have hs0 : 0 ≤ Real.sqrt 2 := Real.sqrt_nonneg 2
    have hX : |x| + |y| ≤ Real.sqrt 2 * n := by
      have hsq : (|x| + |y|) ^ 2 ≤ (Real.sqrt 2 * n) ^ 2 := by
        rw [mul_pow, hs]
        nlinarith [sq_abs x, sq_abs y, sq_nonneg (|x| - |y|)]
      have hA : 0 ≤ |x| + |y| := by positivity
      have hB : 0 ≤ Real.sqrt 2 * n := by positivity
      nlinarith
    calc |x * d1 + y * d2| ≤ |x * d1| + |y * d2| := abs_add_le _ _
      _ = |x| * |d1| + |y| * |d2| := by rw [abs_mul, abs_mul]
      _ ≤ |x| * M + |y| * M := by gcongr
      _ = (|x| + |y|) * M := by ring
      _ ≤ (Real.sqrt 2 * n) * M := by gcongr
      _ = Real.sqrt 2 * M * n := by ring
  have hexp : ∀ u : E3, u = u 0 • e 0 + u 1 • e 1 + u 2 • e 2 := by
    intro u; ext i; fin_cases i <;> simp [e, EuclideanSpace.single_apply]
  have hnorm : ∀ u : E3, ‖u‖ ^ 2 = u 0 ^ 2 + u 1 ^ 2 + u 2 ^ 2 := by
    intro u
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have best_axis : ∀ D : E3 →L[ℝ] ℝ, D ≠ 0 → ∃ b : Fin 3, D (e b) ≠ 0 ∧
      ∀ u, |D (coordPlaneProj b u)| ≤ Real.sqrt 2 * |D (e b)| * ‖u‖ := by
    intro D hD
    have hDu : ∀ u : E3, D u = u 0 * D (e 0) + u 1 * D (e 1) + u 2 * D (e 2) := by
      intro u
      conv_lhs => rw [hexp u]
      simp only [map_add, map_smul, smul_eq_mul]
    obtain ⟨b, -, hb⟩ := Finset.exists_max_image Finset.univ (fun j => |D (e j)|)
      Finset.univ_nonempty
    have hb' : ∀ j, |D (e j)| ≤ |D (e b)| := fun j => hb j (Finset.mem_univ j)
    have hbne : D (e b) ≠ 0 := by
      intro h0
      have h0' : ∀ j, D (e j) = 0 := by
        intro j
        have := hb' j
        rw [h0, abs_zero] at this
        exact abs_eq_zero.mp (le_antisymm this (abs_nonneg _))
      refine hD (ContinuousLinearMap.ext fun u => ?_)
      rw [hDu u, h0' 0, h0' 1, h0' 2]
      simp
    refine ⟨b, hbne, fun u => ?_⟩
    have hn := hnorm u
    have hb3 : b = 0 ∨ b = 1 ∨ b = 2 := by fin_cases b <;> simp
    rcases hb3 with rfl | rfl | rfl
    · have h : D (coordPlaneProj 0 u) = u 1 * D (e 1) + u 2 * D (e 2) := by
        rw [hDu]; simp [hPc]
      rw [h]
      exact key _ _ _ _ _ _ (hb' 1) (hb' 2) (by nlinarith [sq_nonneg (u 0)]) (norm_nonneg u)
    · have h : D (coordPlaneProj 1 u) = u 0 * D (e 0) + u 2 * D (e 2) := by
        rw [hDu]; simp [hPc]
      rw [h]
      exact key _ _ _ _ _ _ (hb' 0) (hb' 2) (by nlinarith [sq_nonneg (u 1)]) (norm_nonneg u)
    · have h : D (coordPlaneProj 2 u) = u 0 * D (e 0) + u 1 * D (e 1) := by
        rw [hDu]; simp [hPc]
      rw [h]
      exact key _ _ _ _ _ _ (hb' 0) (hb' 1) (by nlinarith [sq_nonneg (u 2)]) (norm_nonneg u)
  
  obtain ⟨K1, hK1def⟩ : ∃ K1 : ℝ, K1 = K + 1 / R0 := ⟨_, rfl⟩
  have hinvR0 : 0 < 1 / R0 := by positivity
  have hK1 : 0 < K1 := by rw [hK1def]; linarith
  have hKK1 : K ≤ K1 := by rw [hK1def]; linarith
  have hR0K1 : 1 ≤ R0 * K1 := by
    rw [hK1def, mul_add, mul_one_div_cancel hR0.ne']
    nlinarith
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = 1 / (10000000 * K1) := ⟨_, rfl⟩
  obtain ⟨r1, hr1def⟩ : ∃ r1 : ℝ, r1 = 1 / (8 * K1) := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; positivity
  have hr1 : 0 < r1 := by rw [hr1def]; positivity
  have hρK1 : ρ * K1 = 1 / 10000000 := by rw [hρdef]; field_simp
  have hr1K1 : r1 * K1 = 1 / 8 := by rw [hr1def]; field_simp
  have c20 : 20 * ρ ≤ R0 := le_of_mul_le_mul_right (by nlinarith) hK1
  have c4ρ : 4 * ρ ≤ R0 := le_of_mul_le_mul_right (by nlinarith) hK1
  have c12 : 12 * ρ < R0 := lt_of_mul_lt_mul_right (by nlinarith) hK1.le
  have c9 : 9 * ρ < R0 := by linarith
  have cKρ : 1000000 * (K * ρ) ≤ 1 := by
    have : K * ρ ≤ K1 * ρ := mul_le_mul_of_nonneg_right hKK1 hρ.le
    nlinarith
  have c200 : 200 * ρ ≤ r1 := le_of_mul_le_mul_right (by nlinarith) hK1
  have c4r : 4 * ρ < r1 := by linarith
  have cKr1 : K * r1 ≤ 1 / 8 := by
    have : K * r1 ≤ K1 * r1 := mul_le_mul_of_nonneg_right hKK1 hr1.le
    nlinarith
  have c4r1 : 4 * r1 ≤ R0 := le_of_mul_le_mul_right (by nlinarith) hK1
  have hsqrt2 : Real.sqrt 2 ≤ 7 / 4 := by
    rw [Real.sqrt_le_left (by norm_num)]
    norm_num
  refine ⟨ρ, hρ, c20, ?_⟩
  intro S hS1 hS2 hS3
  by_cases hZ : ∃ z0, z0 ∈ S ∧ z0 ∈ Metric.ball c ρ
  swap
  · refine ⟨0, 0, fun i => Fin.elim0 i, fun i => Fin.elim0 i, fun i => Fin.elim0 i,
      fun i => Fin.elim0 i, fun i => Fin.elim0 i, fun i => Fin.elim0 i, ?_⟩
    intro z hz hzb
    exact absurd ⟨z, hz, hzb⟩ hZ
  obtain ⟨z0, hz0S, hz0b⟩ := hZ
  have hz0c : ‖z0 - c‖ < ρ := by rw [Metric.mem_ball, dist_eq_norm] at hz0b; exact hz0b
  have hz0R : z0 ∈ S ∩ Metric.ball c R0 :=
    ⟨hz0S, by rw [Metric.mem_ball, dist_eq_norm]; linarith⟩
  obtain ⟨r, hr, F0, hF0c, hF0d, hF0S⟩ := hS2 z0 hz0R
  have hF0z : fderiv ℝ F0 z0 ≠ 0 := hF0d z0 (Metric.mem_ball_self hr)
  obtain ⟨a, -, haslope⟩ := best_axis (fderiv ℝ F0 z0) hF0z
  obtain ⟨w0, hw0p, hw0c, hw0z, hw0s, hw0⟩ :=
    sheet_through_point c R0 K S hR0 hK hS1 hS2 hS3 z0 hz0S (by linarith) r1 (Real.sqrt 2)
      hr1 cKr1 c4r1 (Real.sqrt_nonneg 2) hsqrt2 a r hr F0 hF0c hF0S hF0z haslope
  have hW : ∀ z : E3, ∃ w : E3 → ℝ, (z ∈ S ∧ ‖z - c‖ < ρ) →
      ((∀ y, w (coordPlaneProj a y) = w y) ∧
        ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj a (y - z)‖ < r1} ∧ w z = z a ∧
        ∀ y, ‖coordPlaneProj a (y - z)‖ < r1 →
          coordPlaneProj a y + w y • e a ∈ S ∧ ‖fderiv ℝ w y‖ ≤ 2 ∧
          ‖iteratedFDeriv ℝ 2 w y‖ ≤ K ∧
          |w y - z a| ≤ 15 / 8 * ‖coordPlaneProj a (y - z)‖) := by
    intro z
    by_cases hz : z ∈ S ∧ ‖z - c‖ < ρ
    · obtain ⟨w, hw⟩ := aligned_sheet_exists c R0 K S hR0 hK hS1 hS2 hS3 ρ r1 hρ c4ρ cKρ c200
        cKr1 c4r1 a z0 hz0c w0 hw0p hw0c hw0z
        (fun y hy => ⟨(hw0 y hy).1, (hw0 y hy).2.1⟩) (fun y hy => (hw0 y hy).2.2.2.1) hw0s
        z hz.1 hz.2
      exact ⟨w, fun _ => hw⟩
    · exact ⟨0, fun h => absurd h hz⟩
  choose W hW using hW
  
  have hcyl : ∀ z y : E3,
      ‖coordPlaneProj a (y - z)‖ ≤ ‖coordPlaneProj a (y - c)‖ + ‖z - c‖ := by
    intro z y
    have e1 : coordPlaneProj a (y - z) =
        coordPlaneProj a (y - c) + coordPlaneProj a (c - z) := by
      rw [hP5, hP5, hP5]; abel
    have h2 := hP7 a (c - z)
    have h3 : ‖c - z‖ = ‖z - c‖ := norm_sub_rev c z
    rw [e1]
    linarith [norm_add_le (coordPlaneProj a (y - c)) (coordPlaneProj a (c - z))]
  have hza : ∀ z : E3, |z a - c a| ≤ ‖z - c‖ := by
    intro z
    have := hpa_le a (z - c)
    rwa [PiLp.sub_apply] at this
  have hpt : ∀ z, (z ∈ S ∧ ‖z - c‖ < ρ) → ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ →
      ‖coordPlaneProj a (y - z)‖ < r1 ∧
      coordPlaneProj a y + W z y • e a ∈ S ∧
      coordPlaneProj a y + W z y • e a ∈ Metric.ball c R0 ∧
      ‖fderiv ℝ (W z) y‖ ≤ 2 ∧ ‖iteratedFDeriv ℝ 2 (W z) y‖ ≤ K ∧
      |W z y - c a| ≤ 9 * ρ ∧
      |W z y - c a| ≤ 15 / 8 * (‖coordPlaneProj a (y - c)‖ + ‖z - c‖) + ‖z - c‖ := by
    intro z hz y hy
    have h4 := hcyl z y
    have hyr : ‖coordPlaneProj a (y - z)‖ < r1 := by linarith [hz.2]
    obtain ⟨hgS, hsl, hH, hdr⟩ := (hW z hz).2.2.2 y hyr
    have htri := abs_sub_le (W z y) (z a) (c a)
    have hzaz := hza z
    have hfine : |W z y - c a| ≤
        15 / 8 * (‖coordPlaneProj a (y - c)‖ + ‖z - c‖) + ‖z - c‖ := by
      nlinarith
    have h9' : |W z y - c a| ≤ 9 * ρ := by linarith [hz.2]
    have hball : coordPlaneProj a y + W z y • e a ∈ Metric.ball c R0 := by
      have h1 := hP6 a (coordPlaneProj a y + W z y • e a - c)
      rw [hP1] at h1
      have h2 : (coordPlaneProj a y + W z y • e a - c) a = W z y - c a := by
        rw [PiLp.sub_apply, hP4]
      rw [h2] at h1
      rw [Metric.mem_ball, dist_eq_norm]
      linarith
    exact ⟨hyr, hgS, hball, hsl, hH, h9', hfine⟩
  obtain ⟨l, v, hv1, hv2, hv3⟩ := finite_ordered_sheets c R0 ρ S hS1 hS2 a hρ c9
    {z | z ∈ S ∧ ‖z - c‖ < ρ} W
    (fun z hz => (hW z hz).1)
    (fun z hz => (hW z hz).2.1.mono (fun y hy => (hpt z hz y hy).1))
    (fun z hz y hy => ⟨⟨(hpt z hz y hy).2.1, (hpt z hz y hy).2.2.1⟩,
      (hpt z hz y hy).2.2.2.2.2.1, (hpt z hz y hy).2.2.2.1⟩)
  have hvZ : ∀ i, ∃ z, (z ∈ S ∧ ‖z - c‖ < ρ) ∧ v i = W z := by
    intro i
    obtain ⟨z, hz, h⟩ := hv1 i
    exact ⟨z, hz, h⟩
  choose zf hzf hvW using hvZ
  refine ⟨a, l, v, ?_, ?_, ?_, ?_, hv2, ?_⟩
  · intro i y
    rw [hvW i]
    exact (hW _ (hzf i)).1 y
  · intro i
    rw [hvW i]
    exact (hW _ (hzf i)).2.1.mono (fun y hy => (hpt _ (hzf i) y hy).1)
  · intro i y hy
    rw [hvW i]
    obtain ⟨-, hgS, -, hsl, hH, h9', -⟩ := hpt _ (hzf i) y hy
    exact ⟨hsl, hH, h9', hgS⟩
  · intro i y hy
    rw [hvW i]
    have hy3 : ‖coordPlaneProj a (y - c)‖ < 3 * ρ := by linarith
    obtain ⟨-, -, -, -, -, -, hfine⟩ := hpt _ (hzf i) y hy3
    have hzc := (hzf i).2
    have hn0 : 0 ≤ ‖zf i - c‖ := norm_nonneg _
    nlinarith
  · intro z hz hzb
    have hzc : ‖z - c‖ < ρ := by rwa [Metric.mem_ball, dist_eq_norm] at hzb
    obtain ⟨i, hi⟩ := hv3 z ⟨hz, hzc⟩
    have hzcyl : ‖coordPlaneProj a (z - c)‖ < 3 * ρ := by linarith [hP7 a (z - c)]
    refine ⟨i, ?_⟩
    rw [← hi z hzcyl]
    exact ((hW z ⟨hz, hzc⟩).2.2.1).symm

theorem sheet_count_area (c : E3) (a : Fin 3) (ρ : ℝ) (hρ : 0 < ρ) (l : ℕ)
    (v : Fin l → E3 → ℝ) (T : Set E3)
    (hcont : ∀ i, ContinuousOn (v i) {y | ‖coordPlaneProj a (y - c)‖ < 2 * ρ})
    (hord : ∀ i i' : Fin l, i < i' → ∀ y, ‖coordPlaneProj a (y - c)‖ < 2 * ρ →
      v i (coordPlaneProj a y) < v i' (coordPlaneProj a y))
    (hT : ∀ i y, ‖coordPlaneProj a (y - c)‖ < 2 * ρ →
      coordPlaneProj a y + v i (coordPlaneProj a y) • e a ∈ T) :
    (l : ENNReal) * ENNReal.ofReal (4 * ρ ^ 2) ≤ MeasureTheory.Measure.hausdorffMeasure 2 T :=
by
  classical
  
  have he_a : (e a) a = 1 := by simp [e]
  have he_b : ∀ j : Fin 2, (e a) (a.succAbove j) = 0 := by
    intro j
    simp [e, EuclideanSpace.single_apply, Fin.succAbove_ne a j]
  
  have hΨlip : LipschitzWith 1 (fun w : E3 => fun j : Fin 2 => w (a.succAbove j)) := by
    refine LipschitzWith.mk_one (fun w w' => ?_)
    refine (dist_pi_le_iff dist_nonneg).2 (fun j => ?_)
    rw [Real.dist_eq, dist_eq_norm]
    have h := PiLp.norm_apply_le (w - w') (a.succAbove j)
    simpa [Real.norm_eq_abs] using h
  have hbox : ∀ (z : Fin 2 → ℝ) (S : Set E3),
      Metric.closedBall z ρ ⊆ (fun w : E3 => fun j : Fin 2 => w (a.succAbove j)) '' S →
      ENNReal.ofReal (4 * ρ ^ 2) ≤ MeasureTheory.Measure.hausdorffMeasure 2 S := by
    intro z S hS
    have h1 : MeasureTheory.Measure.hausdorffMeasure 2
        ((fun w : E3 => fun j : Fin 2 => w (a.succAbove j)) '' S) ≤
        MeasureTheory.Measure.hausdorffMeasure 2 S := by
      have := hΨlip.hausdorffMeasure_image_le (d := 2) (by norm_num) S
      simpa using this
    have h2 : (MeasureTheory.Measure.hausdorffMeasure 2 : MeasureTheory.Measure (Fin 2 → ℝ)) =
        MeasureTheory.volume := by
      have := MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2)
      simpa using this
    have h3 : MeasureTheory.volume (Metric.closedBall z ρ) = ENNReal.ofReal (4 * ρ ^ 2) := by
      rw [Real.volume_pi_closedBall z hρ.le]
      congr 1
      simp only [Fintype.card_fin]
      ring
    calc ENNReal.ofReal (4 * ρ ^ 2) = MeasureTheory.volume (Metric.closedBall z ρ) := h3.symm
      _ = MeasureTheory.Measure.hausdorffMeasure 2 (Metric.closedBall z ρ) := by rw [h2]
      _ ≤ MeasureTheory.Measure.hausdorffMeasure 2
          ((fun w : E3 => fun j : Fin 2 => w (a.succAbove j)) '' S) := MeasureTheory.measure_mono hS
      _ ≤ MeasureTheory.Measure.hausdorffMeasure 2 S := h1
  
  let σ : (Fin 2 → ℝ) → E3 := fun t => WithLp.toLp 2 (Fin.insertNth (α := fun _ => ℝ) a (0 : ℝ) t)
  have hσc : Continuous σ :=
    (PiLp.continuous_toLp 2 _).comp (Continuous.finInsertNth a continuous_const continuous_id)
  have hσa : ∀ t, (σ t) a = 0 := by intro t; simp [σ]
  have hσb : ∀ t j, (σ t) (a.succAbove j) = t j := by intro t j; simp [σ]
  have hσP : ∀ t, coordPlaneProj a (σ t) = σ t := by
    intro t; simp only [coordPlaneProj, hσa, zero_smul, sub_zero]
  set z : Fin 2 → ℝ := fun j => c (a.succAbove j) with hz
  set Q : Set (Fin 2 → ℝ) := Metric.closedBall z ρ with hQ
  have hσC : ∀ t ∈ Q, ‖coordPlaneProj a (σ t - c)‖ < 2 * ρ := by
    intro t ht
    have hjb : ∀ j : Fin 2, |t j - c (a.succAbove j)| ≤ ρ := by
      intro j
      have h1 := dist_le_pi_dist t z j
      rw [Real.dist_eq] at h1
      have h2 : dist t z ≤ ρ := ht
      exact le_trans h1 h2
    have hca : (coordPlaneProj a (σ t - c)) a = 0 := by
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.smul_apply, he_a, smul_eq_mul, mul_one,
        sub_self]
    have hcb : ∀ j : Fin 2, (coordPlaneProj a (σ t - c)) (a.succAbove j) =
        t j - c (a.succAbove j) := by
      intro j
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.smul_apply, he_b, smul_eq_mul, mul_zero,
        sub_zero, hσb]
    rw [EuclideanSpace.norm_eq, Real.sqrt_lt' (by positivity), Fin.sum_univ_succAbove _ a,
      Fin.sum_univ_two, hca, hcb, hcb]
    simp only [Real.norm_eq_abs, sq_abs, abs_zero]
    have h0 := abs_le.mp (hjb 0)
    have h1 := abs_le.mp (hjb 1)
    nlinarith [h0.1, h0.2, h1.1, h1.2]
  
  let F : Fin l → (Fin 2 → ℝ) → E3 := fun i t => σ t + v i (σ t) • e a
  let G : Fin l → Set E3 := fun i => F i '' Q
  have hFb : ∀ i t (j : Fin 2), (F i t) (a.succAbove j) = t j := by
    intro i t j
    simp only [F, PiLp.add_apply, PiLp.smul_apply, he_b, smul_eq_mul, mul_zero, add_zero, hσb]
  have hFa : ∀ i t, (F i t) a = v i (σ t) := by
    intro i t
    simp only [F, PiLp.add_apply, PiLp.smul_apply, he_a, smul_eq_mul, mul_one, hσa, zero_add]
  have hGc : ∀ i, IsCompact (G i) := by
    intro i
    have hvc : ContinuousOn (fun t => v i (σ t)) Q :=
      (hcont i).comp hσc.continuousOn (fun t ht => hσC t ht)
    have hFc : ContinuousOn (F i) Q := hσc.continuousOn.add (hvc.smul continuousOn_const)
    exact (isCompact_closedBall z ρ).image_of_continuousOn hFc
  have hGT : (⋃ i, G i) ⊆ T := by
    refine Set.iUnion_subset (fun i => ?_)
    rintro x ⟨t, ht, rfl⟩
    have h := hT i (σ t) (hσC t ht)
    rw [hσP] at h
    exact h
  have hGd : Pairwise (Function.onFun Disjoint G) := by
    intro i i' hii'
    rw [Function.onFun, Set.disjoint_left]
    rintro x ⟨t, ht, rfl⟩ ⟨t', ht', hx⟩
    have htt : t' = t := by
      funext j
      have := congrArg (fun w : E3 => w (a.succAbove j)) hx
      simpa only [hFb] using this
    subst htt
    have hva : v i' (σ t') = v i (σ t') := by
      have := congrArg (fun w : E3 => w a) hx
      simpa only [hFa] using this
    rcases lt_or_gt_of_ne hii' with h | h
    · have := hord i i' h (σ t') (hσC t' ht')
      rw [hσP] at this
      linarith
    · have := hord i' i h (σ t') (hσC t' ht')
      rw [hσP] at this
      linarith
  have hGa : ∀ i, ENNReal.ofReal (4 * ρ ^ 2) ≤ MeasureTheory.Measure.hausdorffMeasure 2 (G i) := by
    intro i
    apply hbox z
    intro t ht
    exact ⟨F i t, ⟨t, ht, rfl⟩, funext (fun j => hFb i t j)⟩
  calc (l : ENNReal) * ENNReal.ofReal (4 * ρ ^ 2) = ∑ _i : Fin l, ENNReal.ofReal (4 * ρ ^ 2) := by
        simp [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    _ ≤ ∑ i : Fin l, MeasureTheory.Measure.hausdorffMeasure 2 (G i) :=
        Finset.sum_le_sum (fun i _ => hGa i)
    _ = MeasureTheory.Measure.hausdorffMeasure 2 (⋃ i, G i) := by
        rw [MeasureTheory.measure_iUnion hGd (fun i => (hGc i).measurableSet), tsum_fintype]
    _ ≤ MeasureTheory.Measure.hausdorffMeasure 2 T := MeasureTheory.measure_mono hGT

theorem mse_disc_geometry (a : Fin 3) (c : E3) :
    (∀ r : ℝ, IsOpen (smthDisc a c r) ∧ Convex ℝ (smthDisc a c r)) ∧
    (∀ r r' : ℝ, 0 ≤ r → r ≤ r' → smthDisc a c r ⊆ smthDisc a c r') ∧
    (∀ r : ℝ, 0 ≤ r → ∀ x ∈ smthDisc a c r, ∀ y ∈ smthDisc a c r, ‖x - y‖ ≤ 2 * r) ∧
    (∀ r R : ℝ, 0 ≤ r → 0 < R → ∀ x ∈ smthDisc a c r,
      Metric.ball x R ⊆ smthDisc a c (r + 2 * R)) ∧
    (∀ (r : ℝ) (y : E3), 0 < r → ‖coordPlaneProj a (y - c)‖ < r → smthHoriz a y ∈ smthDisc a c r) :=
by
  have hmem : ∀ (r : ℝ) (x : Fin 2 → ℝ), x ∈ smthDisc a c r ↔
      (x 0 - c (a.succAbove 0)) ^ 2 + (x 1 - c (a.succAbove 1)) ^ 2 < r ^ 2 := by
    intro r x
    simp only [smthDisc, Set.mem_setOf_eq, Fin.sum_univ_two]
  have hcoord : ∀ (r : ℝ) (x : Fin 2 → ℝ), 0 ≤ r → x ∈ smthDisc a c r → ∀ k : Fin 2,
      |x k - c (a.succAbove k)| < r := by
    intro r x hr hx k
    rw [hmem] at hx
    apply abs_lt_of_sq_lt_sq _ hr
    fin_cases k
    · show (x 0 - c (a.succAbove 0)) ^ 2 < r ^ 2
      nlinarith [sq_nonneg (x 1 - c (a.succAbove 1))]
    · show (x 1 - c (a.succAbove 1)) ^ 2 < r ^ 2
      nlinarith [sq_nonneg (x 0 - c (a.succAbove 0))]
  have hsqle : ∀ α β p s : ℝ, α + β = 1 →
      (α * p + β * s) ^ 2 = α * p ^ 2 + β * s ^ 2 - α * β * (p - s) ^ 2 := by
    intro α β p s h
    linear_combination (α * p ^ 2 + β * s ^ 2) * h
  refine ⟨fun r => ⟨?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · have hset : smthDisc a c r =
        {x : Fin 2 → ℝ | ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 < r ^ 2} := rfl
    rw [hset]
    exact isOpen_lt (by fun_prop) continuous_const
  · rw [convex_iff_forall_pos]
    intro x hx y hy α β hα hβ hαβ
    rw [hmem] at hx hy ⊢
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    have e0 : α * x 0 + β * y 0 - c (a.succAbove 0) =
        α * (x 0 - c (a.succAbove 0)) + β * (y 0 - c (a.succAbove 0)) := by
      linear_combination c (a.succAbove 0) * hαβ
    have e1 : α * x 1 + β * y 1 - c (a.succAbove 1) =
        α * (x 1 - c (a.succAbove 1)) + β * (y 1 - c (a.succAbove 1)) := by
      linear_combination c (a.succAbove 1) * hαβ
    rw [e0, e1, hsqle α β _ _ hαβ, hsqle α β _ _ hαβ]
    have hab : 0 ≤ α * β := mul_nonneg hα.le hβ.le
    have h1 := mul_nonneg hab (sq_nonneg ((x 0 - c (a.succAbove 0)) - (y 0 - c (a.succAbove 0))))
    have h2 := mul_nonneg hab (sq_nonneg ((x 1 - c (a.succAbove 1)) - (y 1 - c (a.succAbove 1))))
    have h3 := mul_lt_mul_of_pos_left hx hα
    have h4 := mul_lt_mul_of_pos_left hy hβ
    have h5 : α * r ^ 2 + β * r ^ 2 = r ^ 2 := by rw [← add_mul, hαβ, one_mul]
    nlinarith
  · intro r r' hr hrr' x hx
    rw [hmem] at hx ⊢
    have := pow_le_pow_left₀ hr hrr' 2
    linarith
  · intro r hr x hx y hy
    rw [pi_norm_le_iff_of_nonneg (by linarith)]
    intro k
    rw [Pi.sub_apply, Real.norm_eq_abs]
    have h1 := hcoord r x hr hx k
    have h2 := hcoord r y hr hy k
    rw [abs_lt] at h1 h2
    rw [abs_le]
    constructor <;> linarith
  · intro r R hr hR x hx z hz
    rw [Metric.mem_ball, dist_pi_lt_iff hR] at hz
    have hw : ∀ k, |z k - x k| < R := fun k => by
      have := hz k
      rwa [Real.dist_eq] at this
    have hu := hcoord r x hr hx
    have hprod : ∀ k : Fin 2, (x k - c (a.succAbove k)) * (z k - x k) ≤ r * R := by
      intro k
      calc (x k - c (a.succAbove k)) * (z k - x k)
          ≤ |(x k - c (a.succAbove k)) * (z k - x k)| := le_abs_self _
        _ = |x k - c (a.succAbove k)| * |z k - x k| := abs_mul _ _
        _ ≤ r * R := mul_le_mul (hu k).le (hw k).le (abs_nonneg _) hr
    have hsq : ∀ k : Fin 2, (z k - x k) ^ 2 ≤ R ^ 2 := by
      intro k
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hw k).le 2
    rw [hmem] at hx
    rw [hmem]
    have q0 : (z 0 - c (a.succAbove 0)) ^ 2 = (x 0 - c (a.succAbove 0)) ^ 2 +
        2 * ((x 0 - c (a.succAbove 0)) * (z 0 - x 0)) + (z 0 - x 0) ^ 2 := by ring
    have q1 : (z 1 - c (a.succAbove 1)) ^ 2 = (x 1 - c (a.succAbove 1)) ^ 2 +
        2 * ((x 1 - c (a.succAbove 1)) * (z 1 - x 1)) + (z 1 - x 1) ^ 2 := by ring
    have hp0 := hprod 0
    have hp1 := hprod 1
    have hs0 := hsq 0
    have hs1 := hsq 1
    have hRR : 0 ≤ R ^ 2 := sq_nonneg R
    have hexp : (r + 2 * R) ^ 2 = r ^ 2 + 4 * (r * R) + 4 * R ^ 2 := by ring
    rw [q0, q1, hexp]
    linarith
  · intro r y hr hy
    rw [hmem]
    have hsq : ‖coordPlaneProj a (y - c)‖ ^ 2 =
        (y (a.succAbove 0) - c (a.succAbove 0)) ^ 2 +
          (y (a.succAbove 1) - c (a.succAbove 1)) ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_succAbove _ a, Fin.sum_univ_two]
      simp [coordPlaneProj, e, EuclideanSpace.single_apply, Fin.succAbove_ne]
    have h := pow_lt_pow_left₀ hy (norm_nonneg _) two_ne_zero
    rw [hsq] at h
    exact h

theorem mse_planar_data (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (c : E3) (ρ K : ℝ) (hρ : 0 < ρ)
    (a : Fin 3) (v : E3 → ℝ) (hinv : ∀ y, v (coordPlaneProj a y) = v y)
    (hv : ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ})
    (hb : ∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ →
      |v (coordPlaneProj a y) - c a| ≤ 9 * ρ ∧ ‖fderiv ℝ v y‖ ≤ 2 ∧
      ‖iteratedFDeriv ℝ 2 v y‖ ≤ K ∧
      levelMeanCurvCoord G (fun z => z a - v (coordPlaneProj a z))
        (coordPlaneProj a y + v (coordPlaneProj a y) • e a) = 0) :
    (∀ z : E3, v z = v (smthLift a (smthHoriz a z) 0)) ∧
    ContDiffOn ℝ ∞ (fun x => v (smthLift a x 0)) (smthDisc a c (3 * ρ)) ∧
    ∀ x ∈ smthDisc a c (3 * ρ),
      |v (smthLift a x 0) - c a| ≤ 9 * ρ ∧
      (∀ m : Fin 2, |smthGrad (fun x' => v (smthLift a x' 0)) x m| ≤ 2) ∧
      (∀ l m : Fin 2,
        |smthGrad (fun y => smthGrad (fun x' => v (smthLift a x' 0)) y l) x m| ≤ K) ∧
      levelMeanCurvCoord G (fun w => w a - v (smthLift a (smthHoriz a w) 0))
        (smthLift a x (v (smthLift a x 0))) = 0 :=
by
  
  have hcoord : ∀ (x : Fin 2 → ℝ) (t : ℝ) (j : Fin 3),
      (smthLift a x t) j = (Fin.insertNth a t x : Fin 3 → ℝ) j := fun _ _ _ => rfl
  have hLa : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t; rw [hcoord]; simp
  have hLs : ∀ (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2), (smthLift a x t) (a.succAbove k) = x k := by
    intro x t k; rw [hcoord]; simp
  have hPa : ∀ y : E3, (coordPlaneProj a y) a = 0 := by
    intro y; simp [coordPlaneProj, e]
  have hPs : ∀ (y : E3) (k : Fin 2), (coordPlaneProj a y) (a.succAbove k) = y (a.succAbove k) := by
    intro y k; simp [coordPlaneProj, e, EuclideanSpace.single_apply, Fin.succAbove_ne]
  have hext : ∀ y y' : E3, y a = y' a → (∀ k, y (a.succAbove k) = y' (a.succAbove k)) → y = y' := by
    intro y y' h0 h1
    ext j
    by_cases hj : j = a
    · rw [hj]; exact h0
    · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hj
      exact h1 k
  have hP3 : ∀ z : E3, smthLift a (smthHoriz a z) 0 = coordPlaneProj a z := by
    intro z
    refine hext _ _ ?_ (fun k => ?_)
    · rw [hLa, hPa]
    · rw [hLs, hPs]; rfl
  have hP5 : ∀ x : Fin 2 → ℝ, coordPlaneProj a (smthLift a x 0) = smthLift a x 0 := by
    intro x
    refine hext _ _ ?_ (fun k => ?_)
    · rw [hPa, hLa]
    · rw [hPs]
  have hP4 : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthLift a x 0 + t • e a = smthLift a x t := by
    intro x t
    refine hext _ _ ?_ (fun k => ?_)
    · simp [hLa, e]
    · simp [hLs, e, EuclideanSpace.single_apply, Fin.succAbove_ne]
  have hsingle : ∀ m : Fin 2, smthLift a (Pi.single m 1) 0 = e (a.succAbove m) := by
    intro m
    refine hext _ _ ?_ (fun k => ?_)
    · rw [hLa]
      simp [e, EuclideanSpace.single_apply, (Fin.succAbove_ne a m).symm]
    · rw [hLs]
      simp [e, EuclideanSpace.single_apply, Pi.single_apply]
  have hN : ∀ m : Fin 2, ‖smthLift a (Pi.single m 1) 0‖ = 1 := by
    intro m; rw [hsingle]; simp [e, EuclideanSpace.norm_single]
  have hP6 : ∀ x : Fin 2 → ℝ, ‖coordPlaneProj a (smthLift a x 0 - c)‖ ^ 2 =
      ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_succAbove _ a]
    simp [hPa, hPs, hLs, Real.norm_eq_abs, sq_abs]
  
  let Lin : (Fin 2 → ℝ) →ₗ[ℝ] E3 :=
    { toFun := fun x => smthLift a x 0
      map_add' := fun x y => hext _ _ (by simp [hLa]) (fun k => by simp [hLs])
      map_smul' := fun r x => hext _ _ (by simp [hLa]) (fun k => by simp [hLs]) }
  obtain ⟨L, hL⟩ : ∃ L : (Fin 2 → ℝ) →L[ℝ] E3, ∀ x, L x = smthLift a x 0 :=
    ⟨LinearMap.toContinuousLinearMap Lin, fun x => rfl⟩
  
  have hcontP : Continuous (coordPlaneProj a) := by
    unfold coordPlaneProj
    fun_prop
  have hCylOpen : IsOpen {y : E3 | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} :=
    isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  have hDopen : IsOpen (smthDisc a c (3 * ρ)) :=
    isOpen_lt (continuous_finset_sum _ fun k _ =>
      ((continuous_apply k).sub continuous_const).pow 2) continuous_const
  have hmaps : ∀ x ∈ smthDisc a c (3 * ρ),
      L x ∈ {y : E3 | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} := by
    intro x hx
    have hx' : ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 < (3 * ρ) ^ 2 := hx
    show ‖coordPlaneProj a (L x - c)‖ < 3 * ρ
    rw [hL]
    have h6 := hP6 x
    have hn := norm_nonneg (coordPlaneProj a (smthLift a x 0 - c))
    nlinarith
  
  have hvdiff : ∀ y ∈ smthDisc a c (3 * ρ), ContDiffAt ℝ ∞ v (L y) := fun y hy =>
    hv.contDiffAt (hCylOpen.mem_nhds (hmaps y hy))
  have hgrad1 : ∀ y ∈ smthDisc a c (3 * ρ), ∀ k : Fin 2,
      smthGrad (fun x' => v (L x')) y k = fderiv ℝ v (L y) (L (Pi.single k 1)) := by
    intro y hy k
    have hd : DifferentiableAt ℝ v (L y) :=
      (hvdiff y hy).differentiableAt (by simp)
    have hc : fderiv ℝ (fun x' => v (L x')) y = (fderiv ℝ v (L y)).comp L := by
      have h := fderiv_comp y hd L.differentiableAt
      rw [L.fderiv] at h
      exact h
    show fderiv ℝ (fun x' => v (L x')) y (Pi.single k 1) = _
    rw [hc, ContinuousLinearMap.comp_apply]
  have hgrad2 : ∀ x ∈ smthDisc a c (3 * ρ), ∀ l m : Fin 2,
      smthGrad (fun y => smthGrad (fun x' => v (L x')) y l) x m =
        fderiv ℝ (fderiv ℝ v) (L x) (L (Pi.single m 1)) (L (Pi.single l 1)) := by
    intro x hx l m
    have hev : (fun y => smthGrad (fun x' => v (L x')) y l) =ᶠ[𝓝 x]
        (fun y => fderiv ℝ v (L y) (L (Pi.single l 1))) :=
      Filter.eventually_of_mem (hDopen.mem_nhds hx) (fun y hy => hgrad1 y hy l)
    have hΦ : DifferentiableAt ℝ (fderiv ℝ v) (L x) :=
      ((hvdiff x hx).fderiv_right (m := 1)
        (WithTop.coe_le_coe.2 le_top)).differentiableAt (by simp)
    have h1 : HasFDerivAt (fun y => fderiv ℝ v (L y)) ((fderiv ℝ (fderiv ℝ v) (L x)).comp L) x :=
      hΦ.hasFDerivAt.comp x L.hasFDerivAt
    have h2 := h1.clm_apply (hasFDerivAt_const (L (Pi.single l 1)) x)
    show fderiv ℝ (fun y => smthGrad (fun x' => v (L x')) y l) x (Pi.single m 1) = _
    rw [hev.fderiv_eq, h2.fderiv]
    simp
  have hnorm2 : ∀ z, ‖fderiv ℝ (fderiv ℝ v) z‖ = ‖iteratedFDeriv ℝ 2 v z‖ := by
    intro z
    rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
  
  have hfun : (fun x' => v (smthLift a x' 0)) = fun x' => v (L x') := by
    funext x'; rw [hL]
  refine ⟨fun z => by rw [hP3]; exact (hinv z).symm, ?_, ?_⟩
  · rw [hfun]
    exact hv.comp L.contDiff.contDiffOn (fun x hx => hmaps x hx)
  · intro x hx
    have hy := hmaps x hx
    obtain ⟨h1, h2, h3, h4⟩ := hb (L x) hy
    have hLx : L x = smthLift a x 0 := hL x
    have hPy : coordPlaneProj a (L x) = L x := by rw [hLx, hP5]
    rw [hfun]
    refine ⟨?_, fun m => ?_, fun l m => ?_, ?_⟩
    · rw [hPy, hLx] at h1
      exact h1
    · rw [hgrad1 x hx m, ← Real.norm_eq_abs]
      calc ‖fderiv ℝ v (L x) (L (Pi.single m 1))‖
          ≤ ‖fderiv ℝ v (L x)‖ * ‖L (Pi.single m 1)‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ v (L x)‖ := by rw [hL (Pi.single m 1), hN, mul_one]
        _ ≤ 2 := h2
    · rw [hgrad2 x hx l m, ← Real.norm_eq_abs]
      calc ‖fderiv ℝ (fderiv ℝ v) (L x) (L (Pi.single m 1)) (L (Pi.single l 1))‖
          ≤ ‖fderiv ℝ (fderiv ℝ v) (L x)‖ * ‖L (Pi.single m 1)‖ * ‖L (Pi.single l 1)‖ :=
            ContinuousLinearMap.le_opNorm₂ _ _ _
        _ = ‖iteratedFDeriv ℝ 2 v (L x)‖ := by
            rw [hL (Pi.single m 1), hL (Pi.single l 1), hN, hN, mul_one, mul_one, hnorm2]
        _ ≤ K := h3
    · have hf : (fun z => z a - v (coordPlaneProj a z)) =
          (fun w => w a - v (smthLift a (smthHoriz a w) 0)) := by
        funext w; rw [hP3]
      have hpt : coordPlaneProj a (L x) + v (coordPlaneProj a (L x)) • e a =
          smthLift a x (v (smthLift a x 0)) := by
        rw [hPy, hLx, hP4]
      rw [hf, hpt] at h4
      exact h4

theorem mse_strong_EL (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Ω : Set E3) (hΩ : IsOpen Ω)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Ω)
    (hsymm : ∀ y i j, G y i j = G y j i) (hpos : ∀ y ∈ Ω, (G y).PosDef)
    (a : Fin 3) (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (u : (Fin 2 → ℝ) → ℝ)
    (hu : ContDiffOn ℝ ∞ u D) (hlift : ∀ x ∈ D, smthLift a x (u x) ∈ Ω)
    (hmc : ∀ x ∈ D, levelMeanCurvCoord G (fun w => w a - u (smthHoriz a w))
      (smthLift a x (u x)) = 0) :
    ∀ x ∈ D, smthELop (smthLag G a) u x = 0 :=
by
  intro x₀ hx₀
  
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hD x₀ hx₀
  let χ : ContDiffBump x₀ := ⟨r / 4, r / 2, by positivity, by linarith⟩
  have hχsupp : Function.support χ = Metric.ball x₀ (r / 2) := χ.support_eq
  have hχone : ∀ z ∈ Metric.closedBall x₀ (r / 4), χ z = 1 :=
    fun z hz => χ.one_of_mem_closedBall hz
  set v : (Fin 2 → ℝ) → ℝ := fun x => χ x * u x with hv_def
  have hv : ContDiff ℝ ∞ v := by
    rw [contDiff_iff_contDiffAt]
    intro y
    rcases le_or_gt (dist y x₀) (r / 2) with hy | hy
    · have hyD : y ∈ D := hball (by rw [Metric.mem_ball]; linarith)
      exact (χ.contDiffAt (n := ⊤)).mul (hu.contDiffAt (hD.mem_nhds hyD))
    · have hW : IsOpen {z : Fin 2 → ℝ | r / 2 < dist z x₀} :=
        isOpen_lt continuous_const (continuous_id.dist continuous_const)
      have hev : v =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [hW.mem_nhds hy] with z hz
        have hz' : z ∉ Function.support χ := by
          rw [hχsupp, Metric.mem_ball, not_lt]
          exact le_of_lt hz
        simp only [hv_def, Function.notMem_support.mp hz', zero_mul]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hvu : v =ᶠ[𝓝 x₀] u := by
    filter_upwards [Metric.ball_mem_nhds x₀ (by positivity : (0 : ℝ) < r / 4)] with z hz
    have h1 : χ z = 1 := hχone z (Metric.ball_subset_closedBall hz)
    simp only [hv_def, h1, one_mul]
  have h0 : v x₀ = u x₀ := hvu.eq_of_nhds
  
  have hg : (fun y => smthGrad v y) =ᶠ[𝓝 x₀] (fun y => smthGrad u y) :=
    (hvu.fderiv (𝕜 := ℝ)).mono (fun y hy => by funext k; simp only [smthGrad, hy])
  have hEL : smthELop (smthLag G a) v x₀ = smthELop (smthLag G a) u x₀ := by
    have h1 : smthGrad v x₀ = smthGrad u x₀ := hg.eq_of_nhds
    unfold smthELop
    rw [h0, h1]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    have hk : (fun y => fderiv ℝ (smthLag G a) (y, v y, smthGrad v y) (0, 0, Pi.single k 1))
        =ᶠ[𝓝 x₀]
        (fun y => fderiv ℝ (smthLag G a) (y, u y, smthGrad u y) (0, 0, Pi.single k 1)) := by
      filter_upwards [hvu, hg] with y hy1 hy2
      rw [hy1, hy2]
    rw [hk.fderiv_eq]
  
  have hx : smthLift a x₀ (v x₀) ∈ Ω := by rw [h0]; exact hlift x₀ hx₀
  have hs1 := smth_ELop_eq_meanCurv G Ω hΩ hG hsymm hpos a v hv x₀ hx
  rw [h0] at hs1
  
  have hH : smthHoriz a (smthLift a x₀ (u x₀)) = x₀ := by
    funext k
    simp [smthHoriz, smthLift]
  have hHc : Continuous (smthHoriz a) := by
    unfold smthHoriz
    fun_prop
  have hgerm : (fun w : E3 => w a - v (smthHoriz a w)) =ᶠ[𝓝 (smthLift a x₀ (u x₀))]
      (fun w => w a - u (smthHoriz a w)) := by
    have hT : Tendsto (smthHoriz a) (𝓝 (smthLift a x₀ (u x₀))) (𝓝 x₀) := by
      have := hHc.tendsto (smthLift a x₀ (u x₀))
      rwa [hH] at this
    filter_upwards [hT.eventually hvu] with w hw
    rw [hw]
  
  have hcong : ∀ (f₁ f₂ : E3 → ℝ) (z : E3),
      f₁ =ᶠ[𝓝 z] f₂ → levelMeanCurvCoord G f₁ z = levelMeanCurvCoord G f₂ z := by
    intro f₁ f₂ z h
    have h1 : ∀ i, partialDeriv i f₁ z = partialDeriv i f₂ z := by
      intro i; unfold partialDeriv; rw [h.fderiv_eq]
    have h2 : ∀ i j, partialDeriv i (partialDeriv j f₁) z =
        partialDeriv i (partialDeriv j f₂) z := by
      intro i j
      have h' : partialDeriv j f₁ =ᶠ[𝓝 z] partialDeriv j f₂ :=
        (h.fderiv (𝕜 := ℝ)).mono (fun y hy => by simp only [partialDeriv, hy])
      unfold partialDeriv
      rw [show (fun y => fderiv ℝ f₁ y (e j)) = partialDeriv j f₁ from rfl,
        show (fun y => fderiv ℝ f₂ y (e j)) = partialDeriv j f₂ from rfl, h'.fderiv_eq]
    simp only [levelMeanCurvCoord, lapLoc, hessLoc, h1, h2]
  
  rw [← hEL, hs1, hcong _ _ _ hgerm, hmc x₀ hx₀, mul_zero]

theorem mse_lag_smooth (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Ω : Set E3) (c : E3) (ρ : ℝ)
    (hΩ : IsOpen Ω) (hρ : 0 < ρ) (hball : Metric.closedBall c (10 * ρ) ⊆ Ω)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Ω)
    (hsymm : ∀ y i j, G y i j = G y j i) (hpos : ∀ y ∈ Ω, (G y).PosDef) (a : Fin 3) :
    IsOpen (mseLagDom a Ω) ∧ ContDiffOn ℝ ∞ (smthLag G a) (mseLagDom a Ω) ∧
    IsCompact (mseParamSet a c ρ) ∧ Convex ℝ (mseParamSet a c ρ) ∧
    mseParamSet a c ρ ⊆ mseLagDom a Ω :=
by
  
  have hlift_a : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthLift a x t a = t := by
    intro x t
    show (Fin.insertNth a t x : Fin 3 → ℝ) a = t
    exact Fin.insertNth_apply_same _ _ _
  have hlift_s : ∀ (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2), smthLift a x t (a.succAbove k) = x k := by
    intro x t k
    show (Fin.insertNth a t x : Fin 3 → ℝ) (a.succAbove k) = x k
    exact Fin.insertNth_apply_succAbove _ _ _ _
  
  have hℓ : ContDiff ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => smthLift a w.1 w.2.1) := by
    have hg : ContDiff ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) =>
        (Fin.insertNth a w.2.1 w.1 : Fin 3 → ℝ)) := by
      rw [contDiff_pi]
      intro i
      rcases Fin.eq_self_or_eq_succAbove a i with h | ⟨j, h⟩
      · subst h
        simp only [Fin.insertNth_apply_same]
        exact contDiff_snd.fst
      · subst h
        simp only [Fin.insertNth_apply_succAbove]
        exact (contDiff_apply ℝ ℝ j).comp contDiff_fst
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp hg
  
  have hq : ∀ i : Fin 3, ContDiff ℝ ∞
      (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => smthCovec a w.2.2 i) := by
    intro i
    rcases Fin.eq_self_or_eq_succAbove a i with h | ⟨j, h⟩
    · subst h
      simp only [smthCovec, Fin.insertNth_apply_same]
      exact contDiff_const
    · subst h
      simp only [smthCovec, Fin.insertNth_apply_succAbove, Pi.neg_apply]
      exact ((contDiff_apply ℝ ℝ j).comp contDiff_snd.snd).neg
  have hqa : ∀ p : Fin 2 → ℝ, smthCovec a p a = 1 := by
    intro p
    simp only [smthCovec, Fin.insertNth_apply_same]
  
  have hD : IsOpen (mseLagDom a Ω) := hΩ.preimage hℓ.continuous
  
  have hF : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => G (smthLift a w.1 w.2.1) i j) (mseLagDom a Ω) := by
    intro i j
    exact (hG i j).comp hℓ.contDiffOn (fun w hw => hw)
  have hdetH : ∀ H : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun w => H w i j) (mseLagDom a Ω)) →
      ContDiffOn ℝ ∞ (fun w => (H w).det) (mseLagDom a Ω) := by
    intro H hH
    have e : (fun w => (H w).det) = fun w => H w 0 0 * H w 1 1 * H w 2 2
        - H w 0 0 * H w 1 2 * H w 2 1 - H w 0 1 * H w 1 0 * H w 2 2
        + H w 0 1 * H w 1 2 * H w 2 0 + H w 0 2 * H w 1 0 * H w 2 1
        - H w 0 2 * H w 1 1 * H w 2 0 := by
      funext w
      exact Matrix.det_fin_three _
    rw [e]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => (G (smthLift a w.1 w.2.1)).adjugate i j)
      (mseLagDom a Ω) := by
    intro i j
    simp only [Matrix.adjugate_apply]
    apply hdetH (fun w => (G (smthLift a w.1 w.2.1)).updateRow j (Pi.single i 1))
    intro r k
    by_cases hr : r = j
    · subst hr
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hr]
      exact hF r k
  have hdetF : ContDiffOn ℝ ∞
      (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => (G (smthLift a w.1 w.2.1)).det)
      (mseLagDom a Ω) := hdetH _ hF
  have hdetpos : ∀ w ∈ mseLagDom a Ω, 0 < (G (smthLift a w.1 w.2.1)).det :=
    fun w hw => (hpos _ hw).det_pos
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => (G (smthLift a w.1 w.2.1))⁻¹ i j)
      (mseLagDom a Ω) := by
    intro i j
    have e : (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => (G (smthLift a w.1 w.2.1))⁻¹ i j) =
        fun w => ((G (smthLift a w.1 w.2.1)).det)⁻¹ * (G (smthLift a w.1 w.2.1)).adjugate i j := by
      funext w
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [e]
    exact (hdetF.inv (fun w hw => (hdetpos w hw).ne')).mul (hadj i j)
  have hQ : ContDiffOn ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => ∑ i : Fin 3, ∑ j : Fin 3,
      (G (smthLift a w.1 w.2.1))⁻¹ i j * smthCovec a w.2.2 i * smthCovec a w.2.2 j)
      (mseLagDom a Ω) :=
    ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ =>
      ((hinv i j).mul (hq i).contDiffOn).mul (hq j).contDiffOn))
  have hQpos : ∀ w ∈ mseLagDom a Ω, 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G (smthLift a w.1 w.2.1))⁻¹ i j * smthCovec a w.2.2 i * smthCovec a w.2.2 j := by
    intro w hw
    have hPD : (G (smthLift a w.1 w.2.1))⁻¹.PosDef := (hpos _ hw).inv
    have hv : smthCovec a w.2.2 ≠ 0 := by
      intro h
      have h1 := hqa w.2.2
      rw [h] at h1
      simp at h1
    have h1 := hPD.dotProduct_mulVec_pos hv
    refine lt_of_lt_of_eq h1 ?_
    simp only [dotProduct, Matrix.mulVec, star_trivial, Pi.star_apply, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    ring
  have hLag : ContDiffOn ℝ ∞ (smthLag G a) (mseLagDom a Ω) := by
    have e : smthLag G a = fun w => Real.sqrt (G (smthLift a w.1 w.2.1)).det *
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (smthLift a w.1 w.2.1))⁻¹ i j *
          smthCovec a w.2.2 i * smthCovec a w.2.2 j) := rfl
    rw [e]
    exact (hdetF.sqrt (fun w hw => (hdetpos w hw).ne')).mul
      (hQ.sqrt (fun w hw => (hQpos w hw).ne'))
  
  have hclosed : IsClosed (mseParamSet a c ρ) := by
    have h1 : IsClosed {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) |
        ∑ k : Fin 2, (w.1 k - c (a.succAbove k)) ^ 2 ≤ (3 * ρ) ^ 2} :=
      isClosed_le (by fun_prop) continuous_const
    have h2 : IsClosed {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | |w.2.1 - c a| ≤ 9 * ρ} :=
      isClosed_le (by fun_prop) continuous_const
    have h3 : IsClosed {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | ‖w.2.2‖ ≤ 2} :=
      isClosed_le (by fun_prop) continuous_const
    exact h1.inter (h2.inter h3)
  have hbox : mseParamSet a c ρ ⊆ Metric.closedBall (fun k : Fin 2 => c (a.succAbove k)) (3 * ρ) ×ˢ
      (Metric.closedBall (c a) (9 * ρ) ×ˢ Metric.closedBall (0 : Fin 2 → ℝ) 2) := by
    intro w hw
    obtain ⟨h1, h2, h3⟩ := hw
    refine Set.mem_prod.2 ⟨?_, Set.mem_prod.2 ⟨?_, ?_⟩⟩
    · rw [Metric.mem_closedBall, dist_pi_le_iff (by positivity)]
      intro k
      rw [Real.dist_eq]
      have hk : (w.1 k - c (a.succAbove k)) ^ 2 ≤ (3 * ρ) ^ 2 := by
        refine le_trans ?_ h1
        exact Finset.single_le_sum (f := fun k => (w.1 k - c (a.succAbove k)) ^ 2)
          (fun i _ => sq_nonneg _) (Finset.mem_univ k)
      exact abs_le.mpr (abs_le_of_sq_le_sq' hk (by positivity))
    · rw [Metric.mem_closedBall, Real.dist_eq]
      exact h2
    · rw [mem_closedBall_zero_iff]
      exact h3
  have hcompact : IsCompact (mseParamSet a c ρ) :=
    ((isCompact_closedBall _ _).prod ((isCompact_closedBall _ _).prod
      (isCompact_closedBall _ _))).of_isClosed_subset hclosed hbox
  
  have hconv : Convex ℝ (mseParamSet a c ρ) := by
    intro w₁ hw₁ w₂ hw₂ α β hα hβ hαβ
    obtain ⟨h11, h12, h13⟩ := hw₁
    obtain ⟨h21, h22, h23⟩ := hw₂
    have hb : β = 1 - α := by linarith
    subst hb
    refine And.intro ?_ (And.intro ?_ ?_)
    · show ∑ k : Fin 2, ((α • w₁.1 + (1 - α) • w₂.1) k - c (a.succAbove k)) ^ 2 ≤ (3 * ρ) ^ 2
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      rw [Fin.sum_univ_two] at h11 h21 ⊢
      nlinarith [mul_le_mul_of_nonneg_left h11 hα, mul_le_mul_of_nonneg_left h21 hβ,
        mul_nonneg (mul_nonneg hα hβ) (sq_nonneg (w₁.1 0 - w₂.1 0)),
        mul_nonneg (mul_nonneg hα hβ) (sq_nonneg (w₁.1 1 - w₂.1 1))]
    · show |α * w₁.2.1 + (1 - α) * w₂.2.1 - c a| ≤ 9 * ρ
      obtain ⟨a1, b1⟩ := abs_le.mp h12
      obtain ⟨a2, b2⟩ := abs_le.mp h22
      rw [abs_le]
      constructor <;> nlinarith [mul_le_mul_of_nonneg_left a1 hα, mul_le_mul_of_nonneg_left b1 hα,
        mul_le_mul_of_nonneg_left a2 hβ, mul_le_mul_of_nonneg_left b2 hβ]
    · show ‖α • w₁.2.2 + (1 - α) • w₂.2.2‖ ≤ 2
      calc ‖α • w₁.2.2 + (1 - α) • w₂.2.2‖ ≤ ‖α • w₁.2.2‖ + ‖(1 - α) • w₂.2.2‖ := norm_add_le _ _
        _ = α * ‖w₁.2.2‖ + (1 - α) * ‖w₂.2.2‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg hα, Real.norm_of_nonneg hβ]
        _ ≤ 2 := by
          nlinarith [mul_le_mul_of_nonneg_left h13 hα, mul_le_mul_of_nonneg_left h23 hβ]
  
  have hsub5 : mseParamSet a c ρ ⊆ mseLagDom a Ω := by
    intro w hw
    obtain ⟨h1, h2, h3⟩ := hw
    show smthLift a w.1 w.2.1 ∈ Ω
    apply hball
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq, Fin.sum_univ_succAbove _ a]
    simp only [Real.dist_eq, sq_abs, hlift_a, hlift_s]
    have ht : (w.2.1 - c a) ^ 2 ≤ (9 * ρ) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) h2 2
    refine Real.sqrt_le_iff.mpr ⟨by positivity, ?_⟩
    nlinarith [sq_nonneg ρ]
  exact ⟨hD, hLag, hcompact, hconv, hsub5⟩

theorem mse_lag_elliptic (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Ω : Set E3) (c : E3) (ρ : ℝ)
    (hΩ : IsOpen Ω) (hρ : 0 < ρ) (hball : Metric.closedBall c (10 * ρ) ⊆ Ω)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Ω)
    (hsymm : ∀ y i j, G y i j = G y j i) (hpos : ∀ y ∈ Ω, (G y).PosDef) (a : Fin 3) :
    ∃ lam : ℝ, 0 < lam ∧ ∀ w ∈ mseParamSet a c ρ, ∀ ξ : Fin 2 → ℝ,
      lam * ∑ i : Fin 2, ξ i ^ 2 ≤
        ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j w * ξ i * ξ j :=
by
  obtain ⟨hOo, hΛ, hKc, -, hKO⟩ := mse_lag_smooth G Ω c ρ hΩ hρ hball hG hsymm hpos a
  
  
  
  have hs3 : ∀ c₀ A B C : ℝ, 0 < c₀ → 0 < C → (∀ s : ℝ, 0 < A - 2 * B * s + C * s ^ 2) →
      0 < deriv (fun t : ℝ =>
        deriv (fun s : ℝ => c₀ * Real.sqrt (A - 2 * B * s + C * s ^ 2)) t) 0 := by
    intro c₀ A B C hc₀ hC hφ
    have hφd : ∀ s : ℝ, HasDerivAt (fun s => A - 2 * B * s + C * s ^ 2)
        (-2 * B + 2 * C * s) s := by
      intro s
      have h1 := ((hasDerivAt_id s).const_mul (2 * B)).const_sub A
      have h2 := (hasDerivAt_pow 2 s).const_mul C
      convert h1.add h2 using 1
      simp; ring
    have hsq : ∀ s : ℝ, HasDerivAt (fun s => c₀ * Real.sqrt (A - 2 * B * s + C * s ^ 2))
        (c₀ * ((-2 * B + 2 * C * s) / (2 * Real.sqrt (A - 2 * B * s + C * s ^ 2)))) s := by
      intro s
      exact ((hφd s).sqrt (hφ s).ne').const_mul c₀
    have hfun : deriv (fun s => c₀ * Real.sqrt (A - 2 * B * s + C * s ^ 2)) =
        fun t => c₀ * ((-2 * B + 2 * C * t) / (2 * Real.sqrt (A - 2 * B * t + C * t ^ 2))) := by
      funext t
      exact (hsq t).deriv
    rw [hfun]
    have hN : HasDerivAt (fun t : ℝ => -2 * B + 2 * C * t) (2 * C) 0 := by
      have := ((hasDerivAt_id (0:ℝ)).const_mul (2 * C)).const_add (-2 * B)
      simpa using this
    have hD : HasDerivAt (fun t : ℝ => 2 * Real.sqrt (A - 2 * B * t + C * t ^ 2))
        (2 * ((-2 * B + 2 * C * 0) / (2 * Real.sqrt (A - 2 * B * 0 + C * 0 ^ 2)))) 0 :=
      ((hφd 0).sqrt (hφ 0).ne').const_mul 2
    set r := Real.sqrt (A - 2 * B * 0 + C * 0 ^ 2) with hr
    have hA0 : A - 2 * B * 0 + C * 0 ^ 2 = A := by ring
    have hrpos : 0 < r := Real.sqrt_pos.2 (hφ 0)
    have hr2 : r ^ 2 = A := by
      rw [hr, Real.sq_sqrt (hφ 0).le, hA0]
    have hDne : 2 * r ≠ 0 := by positivity
    have hdiv := (hN.div hD hDne).const_mul c₀
    show 0 < deriv (fun t => c₀ * ((-2 * B + 2 * C * t) /
      (2 * Real.sqrt (A - 2 * B * t + C * t ^ 2)))) 0
    rw [show deriv (fun t => c₀ * ((-2 * B + 2 * C * t) /
      (2 * Real.sqrt (A - 2 * B * t + C * t ^ 2)))) 0 = _ from hdiv.deriv, ← hr]
    have hdisc : 0 < A * C - B ^ 2 := by
      have h := hφ (B / C)
      have e : A - 2 * B * (B / C) + C * (B / C) ^ 2 = (A * C - B ^ 2) / C := by
        field_simp
        ring
      rw [e] at h
      exact (div_pos_iff_of_pos_right hC).mp h
    have key : (2 * C * (2 * r) - (-2 * B + 2 * C * 0) * (2 * ((-2 * B + 2 * C * 0) / (2 * r)))) /
        (2 * r) ^ 2 = (A * C - B ^ 2) / (r * r ^ 2) := by
      rw [← hr2]
      field_simp
      ring
    rw [key]
    exact mul_pos hc₀ (div_pos hdisc (by positivity))
  
  
  
  have hs4 : ∀ (w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)), (G (smthLift a w.1 w.2.1)).PosDef →
      ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 →
      ∃ c₀ A B C : ℝ, 0 < c₀ ∧ 0 < C ∧ (∀ s : ℝ, 0 < A - 2 * B * s + C * s ^ 2) ∧
        ∀ s : ℝ, smthLag G a (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)) =
          c₀ * Real.sqrt (A - 2 * B * s + C * s ^ 2) := by
    intro w hw ξ hξ
    set y := smthLift a w.1 w.2.1 with hy
    set M := (G y)⁻¹ with hM
    set q := smthCovec a w.2.2 with hq
    set ι : Fin 3 → ℝ := Fin.insertNth a (0 : ℝ) ξ with hι
    have hMpos : M.PosDef := hw.inv
    have hform : ∀ x : Fin 3 → ℝ, x ≠ 0 →
        0 < ∑ i : Fin 3, ∑ j : Fin 3, M i j * x i * x j := by
      intro x hx
      have h := hMpos.dotProduct_mulVec_pos hx
      have e : dotProduct (star x) (M.mulVec x) =
          ∑ i : Fin 3, ∑ j : Fin 3, M i j * x i * x j := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
        ring
      rw [← e]
      exact h
    have hι0 : ι ≠ 0 := by
      obtain ⟨k, hk⟩ := Function.ne_iff.mp hξ
      intro h
      have h' := congrFun h (a.succAbove k)
      simp [hι, Fin.insertNth_apply_succAbove] at h'
      exact hk h'
    have hcov : ∀ s : ℝ, smthCovec a (w.2.2 + s • ξ) = fun i => q i - s * ι i := by
      intro s
      funext i
      rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
      · simp [hq, hι, smthCovec]
      · simp [hq, hι, smthCovec]
        ring
    set A := ∑ i : Fin 3, ∑ j : Fin 3, M i j * q i * q j with hA
    set B := (1 / 2 : ℝ) * ∑ i : Fin 3, ∑ j : Fin 3, M i j * (q i * ι j + ι i * q j) with hB
    set C := ∑ i : Fin 3, ∑ j : Fin 3, M i j * ι i * ι j with hC
    have hexp : ∀ s : ℝ,
        ∑ i : Fin 3, ∑ j : Fin 3, M i j * (q i - s * ι i) * (q j - s * ι j) =
        A - 2 * B * s + C * s ^ 2 := by
      intro s
      simp only [hA, hB, hC, Fin.sum_univ_three]
      ring
    refine ⟨Real.sqrt (G y).det, A, B, C, Real.sqrt_pos.2 hw.det_pos, hform ι hι0, ?_, ?_⟩
    · intro s
      rw [← hexp s]
      apply hform
      intro h
      have h' := congrFun h a
      simp [hq, hι, smthCovec] at h'
    · intro s
      have h1 : (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)).1 = w.1 := by simp
      have h2 : (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)).2.1 = w.2.1 := by simp
      have h3 : (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)).2.2 = w.2.2 + s • ξ := by simp
      unfold smthLag
      rw [h1, h2, h3, hcov s, ← hexp s]
  
  
  
  have hs2 : ∀ (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
      (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))), IsOpen O → ContDiffOn ℝ ∞ Λ O →
      (∀ i j : Fin 2, ContinuousOn (mseLpp Λ i j) O) ∧
      ∀ w ∈ O, ∀ ξ : Fin 2 → ℝ,
        ∑ i : Fin 2, ∑ j : Fin 2, mseLpp Λ i j w * ξ i * ξ j =
          deriv (fun t : ℝ =>
            deriv (fun s : ℝ => Λ (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))) t) 0 := by
    intro Λ O hO hΛ
    have h3 : (2 : WithTop ℕ∞) + 1 ≤ ∞ := WithTop.coe_le_coe.2 le_top
    have hΛ1 : ContDiffOn ℝ 2 (fun y => fderiv ℝ Λ y) O := hΛ.fderiv_of_isOpen hO h3
    have hdΛ : ∀ v ∈ O, DifferentiableAt ℝ Λ v := fun v hv =>
      (hΛ.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hv)
    have hdΛ1 : ∀ v ∈ O, DifferentiableAt ℝ (fderiv ℝ Λ) v := fun v hv =>
      (hΛ1.differentiableOn (by norm_num)).differentiableAt (hO.mem_nhds hv)
    have hLpp : ∀ i j : Fin 2, ∀ w ∈ O, mseLpp Λ i j w =
        fderiv ℝ (fderiv ℝ Λ) w ((0 : Fin 2 → ℝ), (0 : ℝ), Pi.single j 1)
          ((0 : Fin 2 → ℝ), (0 : ℝ), Pi.single i 1) := by
      intro i j w hw
      have h := (ContinuousLinearMap.apply ℝ ℝ ((0 : Fin 2 → ℝ), (0 : ℝ),
        (Pi.single i 1 : Fin 2 → ℝ))).hasFDerivAt.comp w (hdΛ1 w hw).hasFDerivAt
      have e : fderiv ℝ (mseLp Λ i) w = (ContinuousLinearMap.apply ℝ ℝ ((0 : Fin 2 → ℝ), (0 : ℝ),
        (Pi.single i 1 : Fin 2 → ℝ))).comp (fderiv ℝ (fderiv ℝ Λ) w) := h.fderiv
      unfold mseLpp
      rw [e]
      rfl
    have hcont : ∀ i j : Fin 2, ContinuousOn (mseLpp Λ i j) O := by
      intro i j
      have hc1 : ContDiffOn ℝ 2 (mseLp Λ i) O := hΛ1.clm_apply contDiffOn_const
      have hc2 := hc1.continuousOn_fderiv_of_isOpen hO (by norm_num)
      exact hc2.clm_apply continuousOn_const
    refine ⟨hcont, ?_⟩
    intro w hw ξ
    have hΞE : ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) =
        ξ 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
        ξ 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ)) := by
      ext k
      · simp
      · simp
      · fin_cases k <;> simp
    have hsum : ∑ i : Fin 2, ∑ j : Fin 2, mseLpp Λ i j w * ξ i * ξ j =
        fderiv ℝ (fderiv ℝ Λ) w ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) := by
      simp only [Fin.sum_univ_two]
      rw [hLpp 0 0 w hw, hLpp 0 1 w hw, hLpp 1 0 w hw, hLpp 1 1 w hw, hΞE]
      simp only [map_add, map_smul, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hline : ∀ t : ℝ, HasDerivAt (fun s : ℝ => w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))
        ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) t := by
      intro t
      simpa using ((hasDerivAt_id t).smul_const ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)).const_add w
    have hI : {t : ℝ | w + t • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) ∈ O} ∈ 𝓝 (0 : ℝ) := by
      have hc : Continuous (fun t : ℝ => w + t • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)) := by fun_prop
      exact hc.continuousAt.preimage_mem_nhds (by simpa using hO.mem_nhds hw)
    have hev : deriv (fun s : ℝ => Λ (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))) =ᶠ[𝓝 0]
        fun t => fderiv ℝ Λ (w + t • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))
          ((0 : Fin 2 → ℝ), (0 : ℝ), ξ) := by
      filter_upwards [hI] with t ht
      exact ((hdΛ _ ht).hasFDerivAt.comp_hasDerivAt t (hline t)).deriv
    rw [hev.deriv_eq, hsum]
    have h2 := (hdΛ1 (w + (0 : ℝ) • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))
      (by simpa using hw)).hasFDerivAt.comp_hasDerivAt (0 : ℝ) (hline 0)
    simp only [zero_smul, add_zero] at h2
    have h4 := (ContinuousLinearMap.apply ℝ ℝ
      ((0 : Fin 2 → ℝ), (0 : ℝ), ξ)).hasFDerivAt.comp_hasDerivAt (0 : ℝ) h2
    exact h4.deriv.symm
  
  
  
  obtain ⟨hcont, hline⟩ := hs2 (smthLag G a) (mseLagDom a Ω) hOo hΛ
  set K := mseParamSet a c ρ with hKdef
  have hell : ∀ w ∈ K, ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j w * ξ i * ξ j := by
    intro w hw ξ hξ
    have hwO : w ∈ mseLagDom a Ω := hKO hw
    have hPD : (G (smthLift a w.1 w.2.1)).PosDef := hpos _ hwO
    obtain ⟨c₀, A, B, C, hc₀, hC, hφ, hfor⟩ := hs4 w hPD ξ hξ
    rw [hline w hwO ξ]
    have hf : (fun s : ℝ => smthLag G a (w + s • ((0 : Fin 2 → ℝ), (0 : ℝ), ξ))) =
        fun s : ℝ => c₀ * Real.sqrt (A - 2 * B * s + C * s ^ 2) := funext hfor
    rw [hf]
    exact hs3 c₀ A B C hc₀ hC hφ
  
  
  
  rcases Set.eq_empty_or_nonempty K with hKe | hKne
  · refine ⟨1, one_pos, ?_⟩
    intro x hx
    rw [hKe] at hx
    exact absurd hx (Set.notMem_empty x)
  set S : Set (Fin 2 → ℝ) := Metric.sphere (0 : Fin 2 → ℝ) 1 with hSdef
  have hS : IsCompact S := isCompact_sphere 0 1
  have hP : IsCompact (K ×ˢ S) := hKc.prod hS
  obtain ⟨x₁, hx₁⟩ := hKne
  obtain ⟨η₁, hη₁⟩ : S.Nonempty := NormedSpace.sphere_nonempty.mpr zero_le_one
  have hPne : (K ×ˢ S).Nonempty := ⟨(x₁, η₁), Set.mk_mem_prod hx₁ hη₁⟩
  have hcontP : ContinuousOn
      (fun p : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) =>
        ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j p.1 * p.2 i * p.2 j) (K ×ˢ S) := by
    have hA : ∀ i j : Fin 2, ContinuousOn
        (fun p : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) =>
          mseLpp (smthLag G a) i j p.1) (K ×ˢ S) := fun i j =>
      ((hcont i j).mono hKO).comp continuousOn_fst (fun p hp => (Set.mem_prod.mp hp).1)
    have hC : ∀ i : Fin 2, ContinuousOn
        (fun p : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) => p.2 i) (K ×ˢ S) :=
      fun i => ((continuous_apply i).comp continuous_snd).continuousOn
    refine continuousOn_finset_sum _ (fun i _ => ?_)
    refine continuousOn_finset_sum _ (fun j _ => ?_)
    exact ((hA i j).mul (hC i)).mul (hC j)
  obtain ⟨p₀, hp₀, hmin⟩ := hP.exists_isMinOn hPne hcontP
  set m : ℝ := ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j p₀.1 * p₀.2 i * p₀.2 j
    with hmdef
  have hmin' : ∀ x ∈ K, ∀ η ∈ S,
      m ≤ ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j x * η i * η j := by
    intro x hx η hη
    exact (isMinOn_iff.mp hmin) (x, η) (Set.mk_mem_prod hx hη)
  have hm : 0 < m := by
    obtain ⟨hx₀, hη₀⟩ := Set.mem_prod.mp hp₀
    have hn : ‖p₀.2‖ = 1 := mem_sphere_zero_iff_norm.mp hη₀
    have hne : p₀.2 ≠ 0 := by
      intro h
      rw [h, norm_zero] at hn
      exact zero_ne_one hn
    exact hell p₀.1 hx₀ p₀.2 hne
  refine ⟨m / 2, half_pos hm, ?_⟩
  intro x hx ξ
  by_cases hξ : ξ = 0
  · subst hξ
    simp
  have hr : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
  set r : ℝ := ‖ξ‖ with hrdef
  set η : Fin 2 → ℝ := r⁻¹ • ξ with hηdef
  have hηn : ‖η‖ = 1 := by
    rw [hηdef, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hr, inv_mul_cancel₀ hr.ne']
  have hηS : η ∈ S := mem_sphere_zero_iff_norm.mpr hηn
  have hcoord : ∀ i : Fin 2, ξ i = r * η i := by
    intro i
    rw [hηdef, Pi.smul_apply, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hr.ne', one_mul]
  have hhom : ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j x * ξ i * ξ j =
      r ^ 2 * ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j x * η i * η j := by
    simp only [Fin.sum_univ_two, hcoord 0, hcoord 1]
    ring
  have hbd : ∀ i : Fin 2, ξ i ^ 2 ≤ r ^ 2 := by
    intro i
    have h1 : |ξ i| ≤ r := by
      have := norm_le_pi_norm ξ i
      rwa [Real.norm_eq_abs] at this
    have h2 : 0 ≤ |ξ i| := abs_nonneg _
    rw [← sq_abs]
    exact pow_le_pow_left₀ h2 h1 2
  have hsum : ∑ i : Fin 2, ξ i ^ 2 ≤ 2 * r ^ 2 := by
    rw [Fin.sum_univ_two]
    linarith [hbd 0, hbd 1]
  have hmq := hmin' x hx η hηS
  rw [hhom]
  have hr2 : 0 ≤ r ^ 2 := sq_nonneg r
  calc m / 2 * ∑ i : Fin 2, ξ i ^ 2 ≤ m / 2 * (2 * r ^ 2) :=
        mul_le_mul_of_nonneg_left hsum (by linarith)
    _ = r ^ 2 * m := by ring
    _ ≤ r ^ 2 * ∑ i : Fin 2, ∑ j : Fin 2, mseLpp (smthLag G a) i j x * η i * η j :=
        mul_le_mul_of_nonneg_left hmq hr2

theorem mse_QC_base (β₀ β₁ β₂ d : ℝ) : ∃ B : NNReal, ∀ (S : Set (Fin 2 → ℝ))
    (u : (Fin 2 → ℝ) → ℝ), IsOpen S → Convex ℝ S → (∀ x ∈ S, ∀ y ∈ S, ‖x - y‖ ≤ d) →
    ContDiffOn ℝ ∞ u S →
    (∀ x ∈ S, |u x| ≤ β₀ ∧ (∀ m : Fin 2, |smthGrad u x m| ≤ β₁) ∧
      ∀ l m : Fin 2, |smthGrad (fun y => smthGrad u y l) x m| ≤ β₂) →
    mseQC 1 B u S :=
by
  
  have hclm : ∀ (L : (Fin 2 → ℝ) →L[ℝ] ℝ) (γ : ℝ), 0 ≤ γ →
      (∀ m : Fin 2, |L (Pi.single m 1)| ≤ γ) → ‖L‖ ≤ 2 * γ := by
    intro L γ hγ hL
    refine ContinuousLinearMap.opNorm_le_bound L (by linarith) (fun h => ?_)
    have hdec : h = h 0 • (Pi.single 0 1 : Fin 2 → ℝ) + h 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
      funext i; fin_cases i <;> simp
    have hLh : L h = h 0 * L (Pi.single 0 1) + h 1 * L (Pi.single 1 1) := by
      conv_lhs => rw [hdec]
      rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    have h0 : |h 0| ≤ ‖h‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm h 0
    have h1 : |h 1| ≤ ‖h‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm h 1
    rw [Real.norm_eq_abs, hLh]
    calc |h 0 * L (Pi.single 0 1) + h 1 * L (Pi.single 1 1)|
        ≤ |h 0 * L (Pi.single 0 1)| + |h 1 * L (Pi.single 1 1)| := abs_add_le _ _
      _ = |h 0| * |L (Pi.single 0 1)| + |h 1| * |L (Pi.single 1 1)| := by
          rw [abs_mul, abs_mul]
      _ ≤ ‖h‖ * γ + ‖h‖ * γ :=
          add_le_add (mul_le_mul h0 (hL 0) (abs_nonneg _) (norm_nonneg _))
            (mul_le_mul h1 (hL 1) (abs_nonneg _) (norm_nonneg _))
      _ = 2 * γ * ‖h‖ := by ring
  
  have hhold : ∀ (γ : ℝ) (S : Set (Fin 2 → ℝ)) (f : (Fin 2 → ℝ) → ℝ), Convex ℝ S →
      (∀ x ∈ S, ∀ y ∈ S, ‖x - y‖ ≤ d) → (∀ x ∈ S, DifferentiableAt ℝ f x) →
      (∀ x ∈ S, ∀ m : Fin 2, |smthGrad f x m| ≤ γ) →
      HolderOnWith (Real.toNNReal (2 * |γ|) * Real.toNNReal |d| ^ ((1 : ℝ) / 2))
        (1 / 2 : NNReal) f S := by
    intro γ S f hS hd hf hg
    have hder : ∀ x ∈ S, ‖fderiv ℝ f x‖₊ ≤ Real.toNNReal (2 * |γ|) := by
      intro x hx
      have := hclm (fderiv ℝ f x) |γ| (abs_nonneg _)
        (fun m => (hg x hx m).trans (le_abs_self γ))
      rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ (by positivity)]
      exact this
    have hlip := Convex.lipschitzOnWith_of_nnnorm_fderiv_le hf hder hS
    have hhol1 := hlip.holderOnWith
    have hdiam : ∀ x ∈ S, ∀ y ∈ S, edist x y ≤ ((Real.toNNReal |d| : NNReal) : ENNReal) := by
      intro x hx y hy
      rw [edist_dist, dist_eq_norm, ← ENNReal.ofReal_coe_nnreal,
        Real.coe_toNNReal _ (abs_nonneg _)]
      exact ENNReal.ofReal_le_ofReal ((hd x hx y hy).trans (le_abs_self d))
    have h2 := HolderOnWith.of_le hdiam hhol1 (by norm_num : (1 / 2 : NNReal) ≤ 1)
    have hexp : ((1 : NNReal) : ℝ) - ((1 / 2 : NNReal) : ℝ) = (1 : ℝ) / 2 := by
      push_cast; norm_num
    rw [hexp] at h2
    exact h2
  
  obtain ⟨B, hB0, hB1, hBH1, hBH2⟩ : ∃ B : NNReal, Real.toNNReal |β₀| ≤ B ∧
      Real.toNNReal |β₁| ≤ B ∧
      Real.toNNReal (2 * |β₁|) * Real.toNNReal |d| ^ ((1 : ℝ) / 2) ≤ B ∧
      Real.toNNReal (2 * |β₂|) * Real.toNNReal |d| ^ ((1 : ℝ) / 2) ≤ B :=
    ⟨Real.toNNReal |β₀| + Real.toNNReal |β₁| +
        (Real.toNNReal (2 * |β₁|) * Real.toNNReal |d| ^ ((1 : ℝ) / 2) +
          Real.toNNReal (2 * |β₂|) * Real.toNNReal |d| ^ ((1 : ℝ) / 2)),
      le_self_add.trans le_self_add, le_add_self.trans le_self_add,
      le_self_add.trans le_add_self, le_add_self.trans le_add_self⟩
  refine ⟨B, ?_⟩
  intro S u hSo hSc hd hu hb
  
  have hR1 : ∀ x ∈ S, DifferentiableAt ℝ u x := fun x hx =>
    (hu.differentiableOn (by simp)).differentiableAt (hSo.mem_nhds hx)
  have hfd : ContDiffOn ℝ ∞ (fderiv ℝ u) S :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hSo).mp hu).2
  have hR2 : ∀ m : Fin 2, ∀ x ∈ S, DifferentiableAt ℝ (fun y => smthGrad u y m) x := by
    intro m x hx
    have h' : ContDiffOn ℝ ∞ (fun y => fderiv ℝ u y (Pi.single m 1)) S :=
      hfd.clm_apply contDiffOn_const
    exact (h'.differentiableOn (by simp)).differentiableAt (hSo.mem_nhds hx)
  have cB0 : |β₀| ≤ (B : ℝ) := by
    have := NNReal.coe_le_coe.mpr hB0
    rwa [Real.coe_toNNReal _ (abs_nonneg _)] at this
  have cB1 : |β₁| ≤ (B : ℝ) := by
    have := NNReal.coe_le_coe.mpr hB1
    rwa [Real.coe_toNNReal _ (abs_nonneg _)] at this
  show ((∀ x ∈ S, |u x| ≤ (B : ℝ)) ∧ HolderOnWith B (1 / 2 : NNReal) u S) ∧
      ∀ m : Fin 2, ((∀ x ∈ S, |smthGrad u x m| ≤ (B : ℝ)) ∧
        HolderOnWith B (1 / 2 : NNReal) (fun x => smthGrad u x m) S)
  refine ⟨⟨?_, ?_⟩, fun m => ⟨?_, ?_⟩⟩
  · intro x hx
    linarith [(hb x hx).1, le_abs_self β₀]
  · exact (hhold β₁ S u hSc hd hR1 (fun x hx m => (hb x hx).2.1 m)).mono_const hBH1
  · intro x hx
    linarith [(hb x hx).2.1 m, le_abs_self β₁]
  · exact (hhold β₂ S (fun y => smthGrad u y m) hSc hd (hR2 m)
      (fun x hx l => (hb x hx).2.2 m l)).mono_const hBH2

theorem mse_deriv_divform (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O)
    (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (u : (Fin 2 → ℝ) → ℝ) (hu : ContDiffOn ℝ ∞ u D)
    (hUO : ∀ x ∈ D, (x, u x, smthGrad u x) ∈ O)
    (hEL : ∀ x ∈ D, smthELop Λ u x = 0) (m : Fin 2) :
    mseDivSol (fun x i j => mseLpp Λ i j (x, u x, smthGrad u x))
      (fun x i => (if i = m then mseLz Λ (x, u x, smthGrad u x) else 0)
        - mseLpx Λ i m (x, u x, smthGrad u x)
        - mseLpz Λ i (x, u x, smthGrad u x) * smthGrad u x m)
      (fun x => smthGrad u x m) D :=
by
  have hDx : ∀ {F : (Fin 2 → ℝ) → ℝ}, ContDiffOn ℝ ∞ F D → ∀ y ∈ D, DifferentiableAt ℝ F y :=
    fun hF y hy => (hF.contDiffAt (hD.mem_nhds hy)).differentiableAt (by simp)
  have hgradC : ∀ {F : (Fin 2 → ℝ) → ℝ}, ContDiffOn ℝ ∞ F D → ∀ k : Fin 2,
      ContDiffOn ℝ ∞ (fun y => smthGrad F y k) D :=
    fun hF k => ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hF).2.clm_apply contDiffOn_const
  
  have hsymm : ∀ (F : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ F D → ∀ y ∈ D, ∀ i j : Fin 2,
      smthGrad (fun z => smthGrad F z j) y i = smthGrad (fun z => smthGrad F z i) y j := by
    intro F hF y hy i j
    have hFy : ContDiffAt ℝ ∞ F y := hF.contDiffAt (hD.mem_nhds hy)
    have hsym : IsSymmSndFDerivAt ℝ F y := hFy.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have hd2 : DifferentiableAt ℝ (fderiv ℝ F) y :=
      ((((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hF).2).contDiffAt
        (hD.mem_nhds hy)).differentiableAt (by simp)
    have key : ∀ k : Fin 2, fderiv ℝ (fun z => smthGrad F z k) y =
        (fderiv ℝ (fderiv ℝ F) y).flip (Pi.single k 1) := by
      intro k
      have h1 := fderiv_clm_apply hd2
        (differentiableAt_const (Pi.single k (1 : ℝ) : Fin 2 → ℝ))
      rw [fderiv_const_apply, ContinuousLinearMap.comp_zero, zero_add] at h1
      exact h1
    show fderiv ℝ (fun z => smthGrad F z j) y (Pi.single i 1) =
      fderiv ℝ (fun z => smthGrad F z i) y (Pi.single j 1)
    rw [key j, key i, ContinuousLinearMap.flip_apply, ContinuousLinearMap.flip_apply]
    exact hsym _ _
  
  have hU : ContDiffOn ℝ ∞ (fun y => (y, u y, smthGrad u y)) D :=
    contDiffOn_id.prodMk (hu.prodMk (contDiffOn_pi.2 fun k => hgradC hu k))
  have hmaps : Set.MapsTo (fun y => (y, u y, smthGrad u y)) D O := fun y hy => hUO y hy
  have hchain : ∀ Φ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ Φ O → ∀ y ∈ D,
      smthGrad (fun z => Φ (z, u z, smthGrad u z)) y m =
        fderiv ℝ Φ (y, u y, smthGrad u y) (Pi.single m 1, 0, 0)
        + fderiv ℝ Φ (y, u y, smthGrad u y) (0, 1, 0) * smthGrad u y m
        + ∑ k : Fin 2, fderiv ℝ Φ (y, u y, smthGrad u y) (0, 0, Pi.single k 1)
            * smthGrad (fun z => smthGrad u z k) y m := by
    intro Φ hΦ y hy
    have hΦd : DifferentiableAt ℝ Φ (y, u y, smthGrad u y) :=
      (hΦ.contDiffAt (hO.mem_nhds (hUO y hy))).differentiableAt (by simp)
    have hud : DifferentiableAt ℝ u y := hDx hu y hy
    have hgd : DifferentiableAt ℝ (smthGrad u) y :=
      differentiableAt_pi.2 fun k => hDx (hgradC hu k) y hy
    have h1 : HasFDerivAt (fun z => (z, u z, smthGrad u z))
        ((ContinuousLinearMap.id ℝ (Fin 2 → ℝ)).prod
          ((fderiv ℝ u y).prod (fderiv ℝ (smthGrad u) y))) y :=
      (hasFDerivAt_id y).prodMk (hud.hasFDerivAt.prodMk hgd.hasFDerivAt)
    have hUder : fderiv ℝ (fun z => (z, u z, smthGrad u z)) y (Pi.single m 1) =
        ((Pi.single m 1 : Fin 2 → ℝ), smthGrad u y m,
          fun k => smthGrad (fun z => smthGrad u z k) y m) := by
      rw [h1.fderiv]
      simp only [ContinuousLinearMap.prod_apply, ContinuousLinearMap.id_apply]
      refine Prod.ext rfl (Prod.ext rfl ?_)
      funext k
      show fderiv ℝ (smthGrad u) y (Pi.single m 1) k =
        fderiv ℝ (fun z => smthGrad u z k) y (Pi.single m 1)
      rw [fderiv_pi (fun k => hDx (hgradC hu k) y hy)]
      rfl
    have hcomp : fderiv ℝ (fun z => Φ (z, u z, smthGrad u z)) y =
        (fderiv ℝ Φ (y, u y, smthGrad u y)).comp
          (fderiv ℝ (fun z => (z, u z, smthGrad u z)) y) :=
      fderiv_comp y hΦd h1.differentiableAt
    have hv : (((Pi.single m 1 : Fin 2 → ℝ), smthGrad u y m,
          fun k => smthGrad (fun z => smthGrad u z k) y m) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        ((Pi.single m 1 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ))
        + smthGrad u y m • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ))
        + ∑ k : Fin 2, smthGrad (fun z => smthGrad u z k) y m •
            ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single k 1 : Fin 2 → ℝ)) := by
      simp only [Fin.sum_univ_two]
      refine Prod.ext ?_ (Prod.ext ?_ ?_)
      · simp
      · simp
      · funext l
        fin_cases l <;> simp
    show fderiv ℝ (fun z => Φ (z, u z, smthGrad u z)) y (Pi.single m 1) = _
    rw [hcomp, ContinuousLinearMap.comp_apply, hUder, hv, map_add, map_add, map_sum,
      map_smul, smul_eq_mul]
    simp only [map_smul, smul_eq_mul, Fin.sum_univ_two]
    ring
  
  have hLp : ∀ i : Fin 2, ContDiffOn ℝ ∞ (mseLp Λ i) O := fun i =>
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hΛ).2.clm_apply contDiffOn_const
  have hLz : ContDiffOn ℝ ∞ (mseLz Λ) O :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hΛ).2.clm_apply contDiffOn_const
  have hf : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun y => mseLp Λ i (y, u y, smthGrad u y)) D :=
    fun i => (hLp i).comp hU hmaps
  have hg : ContDiffOn ℝ ∞ (fun y => mseLz Λ (y, u y, smthGrad u y)) D := hLz.comp hU hmaps
  
  have hflux : ∀ y ∈ D, ∀ i : Fin 2,
      (∑ j : Fin 2, mseLpp Λ i j (y, u y, smthGrad u y) * smthGrad (fun x => smthGrad u x m) y j
        - ((if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)
          - mseLpx Λ i m (y, u y, smthGrad u y)
          - mseLpz Λ i (y, u y, smthGrad u y) * smthGrad u y m))
      = smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m
        - (if i = m then mseLz Λ (y, u y, smthGrad u y) else 0) := by
    intro y hy i
    have h := hchain (mseLp Λ i) (hLp i) y hy
    have hs : ∀ k : Fin 2, smthGrad (fun z => smthGrad u z k) y m =
        smthGrad (fun z => smthGrad u z m) y k := fun k => hsymm u hu y hy m k
    have hsum : ∑ k : Fin 2, fderiv ℝ (mseLp Λ i) (y, u y, smthGrad u y) (0, 0, Pi.single k 1)
          * smthGrad (fun z => smthGrad u z k) y m =
        ∑ j : Fin 2, mseLpp Λ i j (y, u y, smthGrad u y) *
          smthGrad (fun x => smthGrad u x m) y j :=
      Finset.sum_congr rfl (fun k _ => by
        show mseLpp Λ i k (y, u y, smthGrad u y) * smthGrad (fun z => smthGrad u z k) y m = _
        rw [hs k])
    rw [h, hsum]
    show _ = mseLpx Λ i m (y, u y, smthGrad u y)
        + mseLpz Λ i (y, u y, smthGrad u y) * smthGrad u y m
        + ∑ j : Fin 2, mseLpp Λ i j (y, u y, smthGrad u y) *
          smthGrad (fun x => smthGrad u x m) y j - _
    ring
  
  unfold mseDivSol
  intro x hx
  have hloc : ∀ i : Fin 2,
      smthGrad (fun y => ∑ j : Fin 2, mseLpp Λ i j (y, u y, smthGrad u y) *
          smthGrad (fun x => smthGrad u x m) y j
        - ((if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)
          - mseLpx Λ i m (y, u y, smthGrad u y)
          - mseLpz Λ i (y, u y, smthGrad u y) * smthGrad u y m)) x i
      = smthGrad (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m) x i
        - (if i = m then smthGrad (fun y => mseLz Λ (y, u y, smthGrad u y)) x i else 0) := by
    intro i
    have hev : (fun y => ∑ j : Fin 2, mseLpp Λ i j (y, u y, smthGrad u y) *
          smthGrad (fun x => smthGrad u x m) y j
        - ((if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)
          - mseLpx Λ i m (y, u y, smthGrad u y)
          - mseLpz Λ i (y, u y, smthGrad u y) * smthGrad u y m)) =ᶠ[𝓝 x]
        (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m
          - (if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)) :=
      Filter.eventually_of_mem (hD.mem_nhds hx) (fun y hy => hflux y hy i)
    show fderiv ℝ _ x (Pi.single i 1) = _
    rw [hev.fderiv_eq]
    by_cases him : i = m
    · have hW : (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m
          - (if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)) =
          (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m
            - mseLz Λ (y, u y, smthGrad u y)) := by
        funext y
        rw [if_pos him]
      rw [hW, fderiv_fun_sub (hDx (hgradC (hf i) m) x hx) (hDx hg x hx), if_pos him,
        ContinuousLinearMap.sub_apply]
      rfl
    · have hW : (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m
          - (if i = m then mseLz Λ (y, u y, smthGrad u y) else 0)) =
          (fun y => smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y m) := by
        funext y
        rw [if_neg him, sub_zero]
      rw [hW, if_neg him, sub_zero]
      rfl
  
  rw [Finset.sum_congr rfl (fun i _ => hloc i), Finset.sum_sub_distrib,
    Finset.sum_ite_eq' Finset.univ m, if_pos (Finset.mem_univ m),
    Finset.sum_congr rfl (fun i _ => hsymm _ (hf i) x hx i m)]
  
  have hh : ∀ y ∈ D, (smthGrad (fun z => mseLp Λ 0 (z, u z, smthGrad u z)) y 0
      + smthGrad (fun z => mseLp Λ 1 (z, u z, smthGrad u z)) y 1)
      - mseLz Λ (y, u y, smthGrad u y) = 0 := by
    intro y hy
    have h0 := hEL y hy
    have e : smthELop Λ u y = mseLz Λ (y, u y, smthGrad u y) -
        ∑ i : Fin 2, smthGrad (fun z => mseLp Λ i (z, u z, smthGrad u z)) y i := rfl
    rw [Fin.sum_univ_two] at e
    linarith
  have hev2 : (fun y => (smthGrad (fun z => mseLp Λ 0 (z, u z, smthGrad u z)) y 0
      + smthGrad (fun z => mseLp Λ 1 (z, u z, smthGrad u z)) y 1)
      - mseLz Λ (y, u y, smthGrad u y)) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
    Filter.eventually_of_mem (hD.mem_nhds hx) hh
  have hd0 := hev2.fderiv_eq (𝕜 := ℝ)
  have hda : DifferentiableAt ℝ (fun y => smthGrad (fun z => mseLp Λ 0 (z, u z, smthGrad u z)) y 0
      + smthGrad (fun z => mseLp Λ 1 (z, u z, smthGrad u z)) y 1) x :=
    (hDx (hgradC (hf 0) 0) x hx).add (hDx (hgradC (hf 1) 1) x hx)
  rw [fderiv_const_apply, fderiv_fun_sub hda (hDx hg x hx),
    fderiv_fun_add (hDx (hgradC (hf 0) 0) x hx) (hDx (hgradC (hf 1) 1) x hx)] at hd0
  have h2 := congrArg (fun L => L (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) hd0
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.zero_apply] at h2
  rw [Fin.sum_univ_two]
  exact h2

theorem mse_QC_mono : (∀ (s t : ℕ) (B : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)),
      s ≤ t → mseQC t B f S → mseQC s B f S) ∧
    (∀ (s : ℕ) (B B' : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)),
      B ≤ B' → mseQC s B f S → mseQC s B' f S) ∧
    (∀ (s : ℕ) (B : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S T : Set (Fin 2 → ℝ)),
      T ⊆ S → mseQC s B f S → mseQC s B f T) :=
by
  have base_mono : ∀ (B B' : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S T : Set (Fin 2 → ℝ)),
      B ≤ B' → T ⊆ S →
      ((∀ x ∈ S, |f x| ≤ (B : ℝ)) ∧ HolderOnWith B (1 / 2 : NNReal) f S) →
      ((∀ x ∈ T, |f x| ≤ (B' : ℝ)) ∧ HolderOnWith B' (1 / 2 : NNReal) f T) := by
    intro B B' f S T hB hTS h
    exact ⟨fun x hx => (h.1 x (hTS hx)).trans (NNReal.coe_le_coe.2 hB),
      (h.2.mono hTS).mono_const hB⟩
  have gen : ∀ (s : ℕ) (B B' : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S T : Set (Fin 2 → ℝ)),
      B ≤ B' → T ⊆ S → mseQC s B f S → mseQC s B' f T := by
    intro s
    induction s with
    | zero =>
      intro B B' f S T hB hTS h
      exact base_mono B B' f S T hB hTS h
    | succ s ih =>
      intro B B' f S T hB hTS h
      exact ⟨base_mono B B' f S T hB hTS h.1, fun m => ih B B' _ S T hB hTS (h.2 m)⟩
  have drop : ∀ (t : ℕ) (B : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)),
      mseQC (t + 1) B f S → mseQC t B f S := by
    intro t
    induction t with
    | zero =>
      intro B f S h
      exact h.1
    | succ t ih =>
      intro B f S h
      exact ⟨h.1, fun m => ih B _ S (h.2 m)⟩
  refine ⟨?_, ?_, ?_⟩
  · intro s t B f S hst h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hst
    clear hst
    induction d with
    | zero => exact h
    | succ d ih => exact ih (drop (s + d) B f S h)
  · intro s B B' f S hB h
    exact gen s B B' f S S hB subset_rfl h
  · intro s B f S T hTS h
    exact gen s B B f S T le_rfl hTS h

theorem mse_QC_congr (s : ℕ) (B : NNReal) (D S : Set (Fin 2 → ℝ)) (f g : (Fin 2 → ℝ) → ℝ)
    (hD : IsOpen D) (hSD : S ⊆ D) (hfg : ∀ x ∈ D, f x = g x) (hf : mseQC s B f S) :
    mseQC s B g S :=
by
  have lvl0 : ∀ f g : (Fin 2 → ℝ) → ℝ, (∀ x ∈ D, f x = g x) →
      ((∀ x ∈ S, |f x| ≤ (B : ℝ)) ∧ HolderOnWith B (1 / 2 : NNReal) f S) →
      ((∀ x ∈ S, |g x| ≤ (B : ℝ)) ∧ HolderOnWith B (1 / 2 : NNReal) g S) := by
    intro f g hfg h
    refine ⟨fun x hx => ?_, fun x hx y hy => ?_⟩
    · rw [← hfg x (hSD hx)]
      exact h.1 x hx
    · rw [← hfg x (hSD hx), ← hfg y (hSD hy)]
      exact h.2 x hx y hy
  induction s generalizing f g with
  | zero => exact lvl0 f g hfg hf
  | succ s ih =>
    refine ⟨lvl0 f g hfg hf.1, fun m => ?_⟩
    refine ih (fun x => smthGrad f x m) (fun x => smthGrad g x m) ?_ (hf.2 m)
    intro x hx
    have hev : f =ᶠ[𝓝 x] g := Filter.eventuallyEq_of_mem (hD.mem_nhds hx) hfg
    simp only [smthGrad]
    rw [hev.fderiv_eq]

theorem mse_QC_add_sub (s : ℕ) (B₁ B₂ : NNReal) (D S : Set (Fin 2 → ℝ)) (f g : (Fin 2 → ℝ) → ℝ)
    (hD : IsOpen D) (hSD : S ⊆ D) (hfD : ContDiffOn ℝ ∞ f D) (hgD : ContDiffOn ℝ ∞ g D)
    (hf : mseQC s B₁ f S) (hg : mseQC s B₂ g S) :
    mseQC s (B₁ + B₂) (fun x => f x + g x) S ∧ mseQC s (B₁ + B₂) (fun x => f x - g x) S :=
by
  have lvl0 : ∀ (f g h : (Fin 2 → ℝ) → ℝ),
      ((∀ x ∈ S, |f x| ≤ (B₁ : ℝ)) ∧ HolderOnWith B₁ (1 / 2 : NNReal) f S) →
      ((∀ x ∈ S, |g x| ≤ (B₂ : ℝ)) ∧ HolderOnWith B₂ (1 / 2 : NNReal) g S) →
      ((∀ x ∈ S, h x = f x + g x) ∨ (∀ x ∈ S, h x = f x - g x)) →
      ((∀ x ∈ S, |h x| ≤ ((B₁ + B₂ : NNReal) : ℝ)) ∧
        HolderOnWith (B₁ + B₂) (1 / 2 : NNReal) h S) := by
    intro f g h hf hg hh
    obtain ⟨hf0, hfH⟩ := hf
    obtain ⟨hg0, hgH⟩ := hg
    rcases hh with hE | hE
    · refine ⟨fun x hx => ?_, fun x hx y hy => ?_⟩
      · rw [hE x hx, NNReal.coe_add]
        exact (abs_add_le _ _).trans (add_le_add (hf0 x hx) (hg0 x hx))
      · rw [hE x hx, hE y hy, ENNReal.coe_add, add_mul]
        exact (edist_add_add_le _ _ _ _).trans
          (add_le_add (hfH.edist_le hx hy) (hgH.edist_le hx hy))
    · refine ⟨fun x hx => ?_, fun x hx y hy => ?_⟩
      · rw [hE x hx, NNReal.coe_add]
        exact (abs_sub _ _).trans (add_le_add (hf0 x hx) (hg0 x hx))
      · rw [hE x hx, hE y hy, ENNReal.coe_add, add_mul, sub_eq_add_neg, sub_eq_add_neg]
        refine (edist_add_add_le _ _ _ _).trans ?_
        rw [edist_neg_neg]
        exact add_le_add (hfH.edist_le hx hy) (hgH.edist_le hx hy)
  have key : ∀ n : ℕ, ∀ f g h : (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ f D → ContDiffOn ℝ ∞ g D →
      mseQC n B₁ f S → mseQC n B₂ g S →
      ((∀ x ∈ D, h x = f x + g x) ∨ (∀ x ∈ D, h x = f x - g x)) →
      mseQC n (B₁ + B₂) h S := by
    intro n
    induction n with
    | zero =>
      intro f g h _ _ hf hg hh
      exact lvl0 f g h hf hg
        (hh.imp (fun H x hx => H x (hSD hx)) (fun H x hx => H x (hSD hx)))
    | succ n ih =>
      intro f g h hfc hgc hf hg hh
      refine ⟨lvl0 f g h hf.1 hg.1
        (hh.imp (fun H x hx => H x (hSD hx)) (fun H x hx => H x (hSD hx))), fun m => ?_⟩
      have hf' := (contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hfc
      have hg' := (contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hgc
      refine ih (fun x => smthGrad f x m) (fun x => smthGrad g x m) (fun x => smthGrad h x m)
        (hf'.2.clm_apply contDiffOn_const) (hg'.2.clm_apply contDiffOn_const)
        (hf.2 m) (hg.2 m) ?_
      rcases hh with hE | hE
      · left
        intro x hx
        have hev : h =ᶠ[𝓝 x] (fun y => f y + g y) :=
          Filter.eventually_of_mem (hD.mem_nhds hx) hE
        have hfx := hf'.1.differentiableAt (hD.mem_nhds hx)
        have hgx := hg'.1.differentiableAt (hD.mem_nhds hx)
        simp only [smthGrad]
        rw [hev.fderiv_eq, fderiv_fun_add hfx hgx]
        rfl
      · right
        intro x hx
        have hev : h =ᶠ[𝓝 x] (fun y => f y - g y) :=
          Filter.eventually_of_mem (hD.mem_nhds hx) hE
        have hfx := hf'.1.differentiableAt (hD.mem_nhds hx)
        have hgx := hg'.1.differentiableAt (hD.mem_nhds hx)
        simp only [smthGrad]
        rw [hev.fderiv_eq, fderiv_fun_sub hfx hgx]
        rfl
  exact ⟨key s f g _ hfD hgD hf hg (Or.inl (fun x _ => rfl)),
    key s f g _ hfD hgD hf hg (Or.inr (fun x _ => rfl))⟩

theorem mse_QC_mul (s : ℕ) (B₁ B₂ : NNReal) (D S : Set (Fin 2 → ℝ)) (f g : (Fin 2 → ℝ) → ℝ)
    (hD : IsOpen D) (hSD : S ⊆ D) (hfD : ContDiffOn ℝ ∞ f D) (hgD : ContDiffOn ℝ ∞ g D)
    (hf : mseQC s B₁ f S) (hg : mseQC s B₂ g S) :
    mseQC s (2 ^ (s + 1) * B₁ * B₂) (fun x => f x * g x) S :=
by
  
  have hol : ∀ (C : NNReal) (F : (Fin 2 → ℝ) → ℝ),
      (∀ x ∈ S, ∀ y ∈ S, dist (F x) (F y) ≤ (C : ℝ) * dist x y ^ ((1 / 2 : NNReal) : ℝ)) →
      HolderOnWith C (1 / 2 : NNReal) F S := by
    intro C F h x hx y hy
    rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg (NNReal.coe_nonneg _),
      ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg _)]
    exact ENNReal.ofReal_le_ofReal (h x hx y hy)
  
  have q0mul : ∀ (F G : (Fin 2 → ℝ) → ℝ), mseQC 0 B₁ F S → mseQC 0 B₂ G S →
      mseQC 0 (2 * B₁ * B₂) (fun x => F x * G x) S := by
    intro F G hF hG
    obtain ⟨hF0, hF1⟩ := hF
    obtain ⟨hG0, hG1⟩ := hG
    have hB1 : (0 : ℝ) ≤ B₁ := B₁.2
    have hB2 : (0 : ℝ) ≤ B₂ := B₂.2
    refine ⟨fun x hx => ?_, hol _ _ fun x hx y hy => ?_⟩
    · have h1 := hF0 x hx
      have h2 := hG0 x hx
      rw [abs_mul, NNReal.coe_mul, NNReal.coe_mul, NNReal.coe_ofNat]
      have := mul_le_mul h1 h2 (abs_nonneg _) hB1
      nlinarith [mul_nonneg hB1 hB2]
    · have h1 := hF1.dist_le hx hy
      have h2 := hG1.dist_le hx hy
      have ha := hF0 x hx
      have hb := hG0 y hy
      set t := dist x y ^ ((1 / 2 : NNReal) : ℝ) with ht
      have ht0 : 0 ≤ t := Real.rpow_nonneg dist_nonneg _
      rw [Real.dist_eq] at h1 h2 ⊢
      rw [NNReal.coe_mul, NNReal.coe_mul, NNReal.coe_ofNat]
      have e : F x * G x - F y * G y = F x * (G x - G y) + G y * (F x - F y) := by ring
      rw [e]
      calc |F x * (G x - G y) + G y * (F x - F y)|
          ≤ |F x * (G x - G y)| + |G y * (F x - F y)| := abs_add_le _ _
        _ = |F x| * |G x - G y| + |G y| * |F x - F y| := by rw [abs_mul, abs_mul]
        _ ≤ (B₁ : ℝ) * (B₂ * t) + B₂ * (B₁ * t) :=
            add_le_add (mul_le_mul ha h2 (abs_nonneg _) hB1) (mul_le_mul hb h1 (abs_nonneg _) hB2)
        _ = 2 * B₁ * B₂ * t := by ring
  
  have q0add : ∀ (C₁ C₂ : NNReal) (F G : (Fin 2 → ℝ) → ℝ), mseQC 0 C₁ F S → mseQC 0 C₂ G S →
      mseQC 0 (C₁ + C₂) (fun x => F x + G x) S := by
    intro C₁ C₂ F G hF hG
    obtain ⟨hF0, hF1⟩ := hF
    obtain ⟨hG0, hG1⟩ := hG
    refine ⟨fun x hx => ?_, hol _ _ fun x hx y hy => ?_⟩
    · rw [NNReal.coe_add]
      exact (abs_add_le _ _).trans (add_le_add (hF0 x hx) (hG0 x hx))
    · have h1 := hF1.dist_le hx hy
      have h2 := hG1.dist_le hx hy
      set t := dist x y ^ ((1 / 2 : NNReal) : ℝ) with ht
      rw [Real.dist_eq] at h1 h2 ⊢
      rw [NNReal.coe_add]
      have e : F x + G x - (F y + G y) = (F x - F y) + (G x - G y) := by ring
      rw [e, add_mul]
      exact (abs_add_le _ _).trans (add_le_add h1 h2)
  
  have hsm : ∀ (F : (Fin 2 → ℝ) → ℝ) (m : Fin 2), ContDiffOn ℝ ∞ F D →
      ContDiffOn ℝ ∞ (fun x => smthGrad F x m) D := fun F m hF =>
    ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hF).2.clm_apply contDiffOn_const
  have hdiff : ∀ (F : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ F D → ∀ x ∈ D, DifferentiableAt ℝ F x :=
    fun F hF x hx =>
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hF).1.differentiableAt (hD.mem_nhds hx)
  have hlb : ∀ (F G : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ F D → ContDiffOn ℝ ∞ G D →
      ∀ (m : Fin 2), ∀ x ∈ D,
      smthGrad (fun y => F y * G y) x m = smthGrad F x m * G x + F x * smthGrad G x m := by
    intro F G hF hG m x hx
    show (fderiv ℝ (F * G) x) (Pi.single m 1) =
      (fderiv ℝ F x) (Pi.single m 1) * G x + F x * (fderiv ℝ G x) (Pi.single m 1)
    rw [fderiv_mul (hdiff F hF x hx) (hdiff G hG x hx)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have q0mono : ∀ (C C' : NNReal) (F : (Fin 2 → ℝ) → ℝ), C ≤ C' →
      mseQC 0 C F S → mseQC 0 C' F S := by
    intro C C' F hC hF
    obtain ⟨hF0, hF1⟩ := hF
    have hC' : (C : ℝ) ≤ C' := hC
    refine ⟨fun x hx => (hF0 x hx).trans hC', hol _ _ fun x hx y hy => ?_⟩
    exact (hF1.dist_le hx hy).trans
      (mul_le_mul_of_nonneg_right hC' (Real.rpow_nonneg dist_nonneg _))
  have qmono : ∀ (n : ℕ) (C C' : NNReal) (F : (Fin 2 → ℝ) → ℝ), C ≤ C' →
      mseQC n C F S → mseQC n C' F S := by
    intro n
    induction n with
    | zero => exact q0mono
    | succ n ih =>
      intro C C' F hC hF
      exact ⟨q0mono C C' F hC hF.1, fun m => ih C C' _ hC (hF.2 m)⟩
  have qdrop : ∀ (n : ℕ) (C : NNReal) (F : (Fin 2 → ℝ) → ℝ),
      mseQC (n + 1) C F S → mseQC n C F S := by
    intro n
    induction n with
    | zero =>
      intro C F hF
      exact hF.1
    | succ n ih =>
      intro C F hF
      exact ⟨hF.1, fun m => ih C _ (hF.2 m)⟩
  have q0congr : ∀ (C : NNReal) (F G : (Fin 2 → ℝ) → ℝ), (∀ x ∈ D, F x = G x) →
      mseQC 0 C F S → mseQC 0 C G S := by
    intro C F G hFG hF
    obtain ⟨hF0, hF1⟩ := hF
    refine ⟨fun x hx => ?_, hol _ _ fun x hx y hy => ?_⟩
    · rw [← hFG x (hSD hx)]
      exact hF0 x hx
    · rw [← hFG x (hSD hx), ← hFG y (hSD hy)]
      exact hF1.dist_le hx hy
  have qcongr : ∀ (n : ℕ) (C : NNReal) (F G : (Fin 2 → ℝ) → ℝ), (∀ x ∈ D, F x = G x) →
      mseQC n C F S → mseQC n C G S := by
    intro n
    induction n with
    | zero => exact q0congr
    | succ n ih =>
      intro C F G hFG hF
      refine ⟨q0congr C F G hFG hF.1, fun m => ih C _ _ (fun x hx => ?_) (hF.2 m)⟩
      show fderiv ℝ F x (Pi.single m 1) = fderiv ℝ G x (Pi.single m 1)
      rw [Filter.EventuallyEq.fderiv_eq (Filter.eventuallyEq_of_mem (hD.mem_nhds hx) hFG)]
  
  have qadd : ∀ (n : ℕ) (C₁ C₂ : NNReal) (F G : (Fin 2 → ℝ) → ℝ),
      ContDiffOn ℝ ∞ F D → ContDiffOn ℝ ∞ G D →
      mseQC n C₁ F S → mseQC n C₂ G S → mseQC n (C₁ + C₂) (fun x => F x + G x) S := by
    intro n
    induction n with
    | zero =>
      intro C₁ C₂ F G _ _ hF hG
      exact q0add C₁ C₂ F G hF hG
    | succ n ih =>
      intro C₁ C₂ F G hFD hGD hF hG
      refine ⟨q0add C₁ C₂ F G hF.1 hG.1, fun m => ?_⟩
      have h := ih C₁ C₂ _ _ (hsm F m hFD) (hsm G m hGD) (hF.2 m) (hG.2 m)
      refine qcongr n _ _ _ (fun x hx => ?_) h
      show fderiv ℝ F x (Pi.single m 1) + fderiv ℝ G x (Pi.single m 1) =
        fderiv ℝ (F + G) x (Pi.single m 1)
      rw [fderiv_add (hdiff F hFD x hx) (hdiff G hGD x hx)]
      rfl
  
  induction s generalizing f g with
  | zero =>
    exact qmono 0 _ _ _ (le_of_eq (by norm_num)) (q0mul f g hf hg)
  | succ n ih =>
    have h2 : (2 : NNReal) ≤ 2 ^ (n + 1 + 1) := le_self_pow₀ (by norm_num) (by omega)
    have hle : 2 * B₁ * B₂ ≤ 2 ^ (n + 1 + 1) * B₁ * B₂ :=
      mul_le_mul_right' (mul_le_mul_right' h2 _) _
    refine ⟨q0mono _ _ _ hle (q0mul f g hf.1 hg.1), fun m => ?_⟩
    have hfs := qdrop n B₁ f hf
    have hgs := qdrop n B₂ g hg
    have h1 := ih _ g (hsm f m hfD) hgD (hf.2 m) hgs
    have h2 := ih f _ hfD (hsm g m hgD) hfs (hg.2 m)
    have h3 := qadd n _ _ _ _ ((hsm f m hfD).mul hgD) (hfD.mul (hsm g m hgD)) h1 h2
    have h4 := qcongr n _ _ (fun x => smthGrad (fun y => f y * g y) x m)
      (fun x hx => (hlb f g hfD hgD m x hx).symm) h3
    refine qmono n _ _ _ (le_of_eq ?_) h4
    ring

theorem mse_comp_chain (Φ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΦ : ContDiffOn ℝ ∞ Φ O)
    (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (u : (Fin 2 → ℝ) → ℝ) (hu : ContDiffOn ℝ ∞ u D)
    (hUO : ∀ x ∈ D, (x, u x, smthGrad u x) ∈ O) (m : Fin 2) (x : Fin 2 → ℝ) (hx : x ∈ D) :
    smthGrad (fun y => Φ (y, u y, smthGrad u y)) x m =
      fderiv ℝ Φ (x, u x, smthGrad u x) (Pi.single m 1, 0, 0) +
      fderiv ℝ Φ (x, u x, smthGrad u x) (0, 1, 0) * smthGrad u x m +
      ∑ k : Fin 2, fderiv ℝ Φ (x, u x, smthGrad u x) (0, 0, Pi.single k 1) *
        smthGrad (fun y => smthGrad u y k) x m :=
by
  have hΦd : DifferentiableAt ℝ Φ (x, u x, smthGrad u x) :=
    (hΦ.differentiableOn (by simp)).differentiableAt (hO.mem_nhds (hUO x hx))
  have hud : DifferentiableAt ℝ u x :=
    (hu.differentiableOn (by simp)).differentiableAt (hD.mem_nhds hx)
  have hgd : ∀ k : Fin 2, DifferentiableAt ℝ (fun y => smthGrad u y k) x := by
    intro k
    have hC : ContDiffOn ℝ ∞ (fun y => fderiv ℝ u y (Pi.single k 1)) D :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hu).2.clm_apply contDiffOn_const
    exact (hC.differentiableOn (by simp)).differentiableAt (hD.mem_nhds hx)
  have hU' : HasFDerivAt (fun y => (y, u y, smthGrad u y))
      ((ContinuousLinearMap.id ℝ (Fin 2 → ℝ)).prod ((fderiv ℝ u x).prod
        (ContinuousLinearMap.pi fun k => fderiv ℝ (fun y => smthGrad u y k) x))) x :=
    (hasFDerivAt_id x).prodMk
      (hud.hasFDerivAt.prodMk (hasFDerivAt_pi.2 fun k => (hgd k).hasFDerivAt))
  have hchain : fderiv ℝ (fun y => Φ (y, u y, smthGrad u y)) x =
      (fderiv ℝ Φ (x, u x, smthGrad u x)).comp
        ((ContinuousLinearMap.id ℝ (Fin 2 → ℝ)).prod ((fderiv ℝ u x).prod
          (ContinuousLinearMap.pi fun k => fderiv ℝ (fun y => smthGrad u y k) x))) :=
    (hΦd.hasFDerivAt.comp x hU').fderiv
  have hvec : ((Pi.single m 1 : Fin 2 → ℝ), fderiv ℝ u x (Pi.single m 1),
      fun k => fderiv ℝ (fun y => smthGrad u y k) x (Pi.single m 1)) =
      ((Pi.single m 1 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) +
        smthGrad u x m • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) +
        (smthGrad (fun y => smthGrad u y 0) x m •
            ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
          smthGrad (fun y => smthGrad u y 1) x m •
            ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · simp
    · simp [smthGrad]
    · funext j
      fin_cases j <;> simp [smthGrad]
  show fderiv ℝ (fun y => Φ (y, u y, smthGrad u y)) x (Pi.single m 1) = _
  rw [hchain]
  simp only [Function.comp_def, ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
    ContinuousLinearMap.id_apply]
  have hpi : (ContinuousLinearMap.pi fun k => fderiv ℝ (fun y => smthGrad u y k) x)
      (Pi.single m 1) = fun k => fderiv ℝ (fun y => smthGrad u y k) x (Pi.single m 1) := rfl
  rw [hpi, hvec, map_add, map_add, map_add, map_smul, map_smul, map_smul, smul_eq_mul,
    smul_eq_mul, smul_eq_mul, Fin.sum_univ_two]
  ring

theorem mse_comp_level0 (Φ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O 𝒦 : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΦ : ContDiffOn ℝ ∞ Φ O)
    (h𝒦 : IsCompact 𝒦) (h𝒦c : Convex ℝ 𝒦) (h𝒦O : 𝒦 ⊆ O) (B : NNReal) :
    ∃ C : NNReal, ∀ (S : Set (Fin 2 → ℝ)) (u : (Fin 2 → ℝ) → ℝ),
      (∀ x ∈ S, (x, u x, smthGrad u x) ∈ 𝒦) →
      mseQC 1 B u S → mseQC 0 C (fun x => Φ (x, u x, smthGrad u x)) S :=
by
  
  have hexp : (((1 / 2 : NNReal)) : ℝ) = 1 / 2 := by norm_num
  have holder_of_dist : ∀ (C : NNReal) (f : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)),
      (∀ x ∈ S, ∀ y ∈ S, |f x - f y| ≤ (C : ℝ) * Real.sqrt (dist x y)) →
      HolderOnWith C (1 / 2 : NNReal) f S := by
    intro C f S h x hx y hy
    rw [edist_dist, edist_dist, hexp, Real.dist_eq]
    calc ENNReal.ofReal |f x - f y| ≤ ENNReal.ofReal ((C : ℝ) * Real.sqrt (dist x y)) :=
          ENNReal.ofReal_le_ofReal (h x hx y hy)
      _ = (C : ENNReal) * ENNReal.ofReal (dist x y) ^ (1 / 2 : ℝ) := by
          rw [ENNReal.ofReal_mul C.coe_nonneg, ENNReal.ofReal_coe_nnreal, Real.sqrt_eq_rpow,
            ENNReal.ofReal_rpow_of_nonneg dist_nonneg (by norm_num)]
  
  have hdiff : DifferentiableOn ℝ Φ O := hΦ.differentiableOn (by simp)
  obtain ⟨M₀, hM₀⟩ := h𝒦.exists_bound_of_continuousOn (hΦ.continuousOn.mono h𝒦O)
  obtain ⟨L₀, hL₀⟩ := h𝒦.exists_bound_of_continuousOn
    ((hΦ.continuousOn_fderiv_of_isOpen hO (by simp)).mono h𝒦O)
  have hM0 : 0 ≤ max M₀ 0 := le_max_right _ _
  have hL0 : 0 ≤ max L₀ 0 := le_max_right _ _
  have hMb : ∀ w ∈ 𝒦, |Φ w| ≤ max M₀ 0 := fun w hw => by
    rw [← Real.norm_eq_abs]; exact (hM₀ w hw).trans (le_max_left _ _)
  have hLip : ∀ w ∈ 𝒦, ∀ w' ∈ 𝒦, |Φ w - Φ w'| ≤ max L₀ 0 * ‖w - w'‖ := by
    intro w hw w' hw'
    rw [← Real.norm_eq_abs]
    exact Convex.norm_image_sub_le_of_norm_fderiv_le
      (fun z hz => hdiff.differentiableAt (hO.mem_nhds (h𝒦O hz)))
      (fun z hz => (hL₀ z hz).trans (le_max_left _ _)) h𝒦c hw' hw
  
  obtain ⟨δ₁, hδ₁⟩ := h𝒦.isBounded.exists_norm_le
  have hδ : ∀ w ∈ 𝒦, ‖w‖ ≤ max δ₁ 0 := fun w hw => (hδ₁ w hw).trans (le_max_left _ _)
  have hK0 : 0 ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) :=
    le_trans (Real.sqrt_nonneg _) (le_max_left _ _)
  have hMC : 0 ≤ max (max M₀ 0) (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ)) :=
    le_max_of_le_left hM0
  refine ⟨Real.toNNReal (max (max M₀ 0) (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ))),
    fun S u hK hQ => ?_⟩
  have hC : ((Real.toNNReal (max (max M₀ 0)
      (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ))) : NNReal) : ℝ) =
      max (max M₀ 0) (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ)) :=
    Real.coe_toNNReal _ hMC
  have hu : HolderOnWith B (1 / 2 : NNReal) u S := hQ.1.2
  have hg : ∀ k : Fin 2, HolderOnWith B (1 / 2 : NNReal) (fun x => smthGrad u x k) S :=
    fun k => (hQ.2 k).2
  
  have hlift : ∀ x ∈ S, ∀ y ∈ S,
      ‖(x, u x, smthGrad u x) - (y, u y, smthGrad u y)‖ ≤
        max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y) := by
    intro x hx y hy
    have ht0 : 0 ≤ Real.sqrt (dist x y) := Real.sqrt_nonneg _
    have hBK : (B : ℝ) ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) := le_max_right _ _
    have h2 : |u x - u y| ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y) := by
      have := hu.dist_le hx hy
      rw [hexp, ← Real.sqrt_eq_rpow, Real.dist_eq] at this
      exact this.trans (mul_le_mul_of_nonneg_right hBK ht0)
    have h3 : ∀ k : Fin 2, |smthGrad u x k - smthGrad u y k| ≤
        max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y) := by
      intro k
      have := (hg k).dist_le hx hy
      rw [hexp, ← Real.sqrt_eq_rpow, Real.dist_eq] at this
      exact this.trans (mul_le_mul_of_nonneg_right hBK ht0)
    have h1 : ‖x - y‖ ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y) := by
      have hx' : ‖x‖ ≤ max δ₁ 0 := (norm_fst_le _).trans (hδ _ (hK x hx))
      have hy' : ‖y‖ ≤ max δ₁ 0 := (norm_fst_le _).trans (hδ _ (hK y hy))
      have hd : dist x y ≤ 2 * max δ₁ 0 := by
        rw [dist_eq_norm]; linarith [norm_sub_le x y]
      have htK : Real.sqrt (dist x y) ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) :=
        (Real.sqrt_le_sqrt hd).trans (le_max_left _ _)
      calc ‖x - y‖ = Real.sqrt (dist x y) * Real.sqrt (dist x y) := by
            rw [Real.mul_self_sqrt dist_nonneg, dist_eq_norm]
        _ ≤ max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y) :=
            mul_le_mul_of_nonneg_right htK ht0
    rw [Prod.mk_sub_mk, Prod.mk_sub_mk, Prod.norm_mk, Prod.norm_mk]
    refine max_le h1 (max_le ?_ ?_)
    · rw [Real.norm_eq_abs]; exact h2
    · refine (pi_norm_le_iff_of_nonneg (mul_nonneg hK0 ht0)).2 (fun k => ?_)
      rw [Pi.sub_apply, Real.norm_eq_abs]; exact h3 k
  
  refine And.intro (fun x hx => ?_) (holder_of_dist _ _ S (fun x hx y hy => ?_))
  · rw [hC]; exact (hMb _ (hK x hx)).trans (le_max_left _ _)
  · rw [hC]
    calc |Φ (x, u x, smthGrad u x) - Φ (y, u y, smthGrad u y)|
        ≤ max L₀ 0 * ‖(x, u x, smthGrad u x) - (y, u y, smthGrad u y)‖ :=
          hLip _ (hK x hx) _ (hK y hy)
      _ ≤ max L₀ 0 * (max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ) * Real.sqrt (dist x y)) :=
          mul_le_mul_of_nonneg_left (hlift x hx y hy) hL0
      _ = (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ)) * Real.sqrt (dist x y) := by ring
      _ ≤ max (max M₀ 0) (max L₀ 0 * max (Real.sqrt (2 * max δ₁ 0)) (B : ℝ)) *
            Real.sqrt (dist x y) :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.sqrt_nonneg _)

theorem mse_QC_comp (Φ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O 𝒦 : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΦ : ContDiffOn ℝ ∞ Φ O)
    (h𝒦 : IsCompact 𝒦) (h𝒦c : Convex ℝ 𝒦) (h𝒦O : 𝒦 ⊆ O) (s : ℕ) (B : NNReal) :
    ∃ C : NNReal, ∀ (D S : Set (Fin 2 → ℝ)) (u : (Fin 2 → ℝ) → ℝ),
      IsOpen D → S ⊆ D → ContDiffOn ℝ ∞ u D → (∀ x ∈ D, (x, u x, smthGrad u x) ∈ 𝒦) →
      mseQC (s + 1) B u S → mseQC s C (fun x => Φ (x, u x, smthGrad u x)) S :=
by
  have hD1 : ∀ (f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ f O →
      ∀ v : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ), ContDiffOn ℝ ∞ (fun w => fderiv ℝ f w v) O := by
    intro f hf v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2.clm_apply contDiffOn_const
  revert Φ
  induction s with
  | zero =>
    intro Φ hΦ
    obtain ⟨C₀, hC₀⟩ := mse_comp_level0 Φ O 𝒦 hO hΦ h𝒦 h𝒦c h𝒦O B
    exact ⟨C₀, fun D S u _ hSD _ hK hQ => hC₀ S u (fun x hx => hK x (hSD hx)) hQ⟩
  | succ s ih =>
    intro Φ hΦ
    obtain ⟨C₀, hC₀⟩ := mse_comp_level0 Φ O 𝒦 hO hΦ h𝒦 h𝒦c h𝒦O B
    choose Cx hCx using fun m : Fin 2 =>
      ih (fun w => fderiv ℝ Φ w (Pi.single m 1, 0, 0)) (hD1 Φ hΦ _)
    obtain ⟨Cz, hCz⟩ := ih (fun w => fderiv ℝ Φ w (0, 1, 0)) (hD1 Φ hΦ _)
    choose Cp hCp using fun k : Fin 2 =>
      ih (fun w => fderiv ℝ Φ w (0, 0, Pi.single k 1)) (hD1 Φ hΦ _)
    refine ⟨C₀ + ((Cx 0 + Cx 1) +
      (2 ^ (s + 1) * Cz * B + (2 ^ (s + 1) * Cp 0 * B + 2 ^ (s + 1) * Cp 1 * B))), ?_⟩
    intro D S u hD hSD hu hK hQ
    have hQ1 : mseQC 1 B u S := mse_QC_mono.1 1 (s + 2) B u S (by omega) hQ
    have hQs : mseQC (s + 1) B u S := mse_QC_mono.1 (s + 1) (s + 2) B u S (by omega) hQ
    have hUO : ∀ x ∈ D, (x, u x, smthGrad u x) ∈ O := fun x hx => h𝒦O (hK x hx)
    have hdu : ∀ m : Fin 2, ContDiffOn ℝ ∞ (fun x => smthGrad u x m) D := fun m =>
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hu).2.clm_apply contDiffOn_const
    have hddu : ∀ k m : Fin 2,
        ContDiffOn ℝ ∞ (fun x => smthGrad (fun y => smthGrad u y k) x m) D := fun k m =>
      ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 (hdu k)).2.clm_apply contDiffOn_const
    have hU : ContDiffOn ℝ ∞ (fun x => (x, u x, smthGrad u x)) D :=
      contDiffOn_id.prodMk (hu.prodMk (contDiffOn_pi.2 fun m => hdu m))
    have hmaps : Set.MapsTo (fun x => (x, u x, smthGrad u x)) D O := fun x hx => hUO x hx
    have hcomp : ∀ f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ f O →
        ContDiffOn ℝ ∞ (fun x => f (x, u x, smthGrad u x)) D :=
      fun f hf => hf.comp hU hmaps
    refine ⟨?_, ?_⟩
    · exact mse_QC_mono.2.1 0 C₀ _ _ S le_self_add
        (hC₀ S u (fun x hx => hK x (hSD hx)) hQ1)
    intro m
    
    have sA : ContDiffOn ℝ ∞
        (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (Pi.single m 1, 0, 0)) D :=
      hcomp _ (hD1 Φ hΦ _)
    have sZ : ContDiffOn ℝ ∞ (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (0, 1, 0)) D :=
      hcomp _ (hD1 Φ hΦ _)
    have sP : ∀ k : Fin 2, ContDiffOn ℝ ∞
        (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (0, 0, Pi.single k 1)) D :=
      fun k => hcomp _ (hD1 Φ hΦ _)
    
    have hA : mseQC s (Cx m)
        (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (Pi.single m 1, 0, 0)) S :=
      hCx m D S u hD hSD hu hK hQs
    have hZ : mseQC s Cz (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (0, 1, 0)) S :=
      hCz D S u hD hSD hu hK hQs
    have hP : ∀ k : Fin 2, mseQC s (Cp k)
        (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (0, 0, Pi.single k 1)) S :=
      fun k => hCp k D S u hD hSD hu hK hQs
    have hg : mseQC s B (fun x => smthGrad u x m) S :=
      mse_QC_mono.1 s (s + 1) B _ S (Nat.le_succ s) (hQ.2 m)
    have hh : ∀ k : Fin 2, mseQC s B (fun x => smthGrad (fun y => smthGrad u y k) x m) S :=
      fun k => (hQ.2 k).2 m
    have hZg := mse_QC_mul s Cz B D S _ _ hD hSD sZ (hdu m) hZ hg
    have hPh : ∀ k : Fin 2, mseQC s (2 ^ (s + 1) * Cp k * B)
        (fun x => fderiv ℝ Φ (x, u x, smthGrad u x) (0, 0, Pi.single k 1) *
          smthGrad (fun y => smthGrad u y k) x m) S :=
      fun k => mse_QC_mul s (Cp k) B D S _ _ hD hSD (sP k) (hddu k m) (hP k) (hh k)
    have hS1 := (mse_QC_add_sub s _ _ D S _ _ hD hSD sA (sZ.mul (hdu m)) hA hZg).1
    have hS2 := (mse_QC_add_sub s _ _ D S _ _ hD hSD ((sP 0).mul (hddu 0 m))
      ((sP 1).mul (hddu 1 m)) (hPh 0) (hPh 1)).1
    have hS3 := (mse_QC_add_sub s _ _ D S _ _ hD hSD (sA.add (sZ.mul (hdu m)))
      (((sP 0).mul (hddu 0 m)).add ((sP 1).mul (hddu 1 m))) hS1 hS2).1
    have hS4 := mse_QC_congr s _ D S _
      (fun x => smthGrad (fun y => Φ (y, u y, smthGrad u y)) x m) hD hSD
      (fun x hx => by
        show _ = smthGrad (fun y => Φ (y, u y, smthGrad u y)) x m
        rw [mse_comp_chain Φ O hO hΦ D hD u hu hUO m x hx, Fin.sum_univ_two]) hS3
    refine mse_QC_mono.2.1 s _ _ _ S ?_ hS4
    have hCm : Cx m ≤ Cx 0 + Cx 1 := by
      fin_cases m
      · exact le_self_add
      · exact le_add_self
    calc Cx m + 2 ^ (s + 1) * Cz * B + (2 ^ (s + 1) * Cp 0 * B + 2 ^ (s + 1) * Cp 1 * B)
        = Cx m + (2 ^ (s + 1) * Cz * B + (2 ^ (s + 1) * Cp 0 * B + 2 ^ (s + 1) * Cp 1 * B)) := by
          ring
      _ ≤ (Cx 0 + Cx 1) +
          (2 ^ (s + 1) * Cz * B + (2 ^ (s + 1) * Cp 0 * B + 2 ^ (s + 1) * Cp 1 * B)) := by
          gcongr
      _ ≤ _ := le_add_self

theorem mse_divsol_weak (S : Set (Fin 2 → ℝ)) (hS : IsOpen S)
    (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ)
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S) (hF : ∀ i, ContDiffOn ℝ ∞ (fun x => F x i) S)
    (hw : ContDiffOn ℝ ∞ w S) (hsol : mseDivSol a F w S) : smthLinSol a F w S :=
by
  
  have s1 : ∀ (g h : (Fin 2 → ℝ) → ℝ), ContinuousOn g S → Continuous h → HasCompactSupport h →
      tsupport h ⊆ S → Integrable (fun x => g x * h x) := by
    intro g h hg hh hhc hhS
    have hcont : Continuous (fun x => g x * h x) := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ S
      · exact (hg.continuousAt (hS.mem_nhds hx)).mul hh.continuousAt
      · have hxt : x ∉ tsupport h := fun h' => hx (hhS h')
        have hev : h =ᶠ[𝓝 x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxt
        have hev2 : (fun y => g y * h y) =ᶠ[𝓝 x] fun _ => (0:ℝ) := by
          filter_upwards [hev] with y hy
          simp [hy]
        exact continuousAt_const.congr hev2.symm
    exact hcont.integrable_of_hasCompactSupport hhc.mul_left
  
  have tsup_grad : ∀ h : (Fin 2 → ℝ) → ℝ, tsupport h ⊆ S → ∀ k : Fin 2,
      tsupport (fun x => smthGrad h x k) ⊆ S := by
    intro h hhS k x hx
    by_contra hxS
    have hxt : x ∉ tsupport (fderiv ℝ h) := fun h' => hxS (hhS (tsupport_fderiv_subset ℝ h'))
    have hev : fderiv ℝ h =ᶠ[𝓝 x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxt
    have hev2 : (fun y => smthGrad h y k) =ᶠ[𝓝 x] 0 := by
      filter_upwards [hev] with y hy
      simp [smthGrad, hy]
    exact (notMem_tsupport_iff_eventuallyEq).2 hev2 hx
  
  have s2 : ∀ (p h : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ 1 p S → ContDiff ℝ 1 h →
      HasCompactSupport h → tsupport h ⊆ S → ∀ k : Fin 2,
      ∫ x, p x * smthGrad h x k = -∫ x, smthGrad p x k * h x := by
    intro p h hp hh hhc hhS k
    have hoff : ∀ x, x ∉ S → h =ᶠ[𝓝 x] 0 ∧ fderiv ℝ h =ᶠ[𝓝 x] 0 := by
      intro x hx
      have hxt : x ∉ tsupport h := fun h' => hx (hhS h')
      refine ⟨(notMem_tsupport_iff_eventuallyEq).1 hxt, (notMem_tsupport_iff_eventuallyEq).1 ?_⟩
      exact fun h' => hxt (tsupport_fderiv_subset ℝ h')
    have hFoff : ∀ x, x ∉ S → (fun y => p y * h y) =ᶠ[𝓝 x] fun _ => (0:ℝ) := by
      intro x hx
      filter_upwards [(hoff x hx).1] with y hy
      simp [hy]
    have hpd : ∀ x ∈ S, DifferentiableAt ℝ p x := fun x hx =>
      (hp.differentiableOn (by simp)).differentiableAt (hS.mem_nhds hx)
    have hhd : Differentiable ℝ h := hh.differentiable (by simp)
    have hFd : Differentiable ℝ (fun y => p y * h y) := by
      intro x
      by_cases hx : x ∈ S
      · exact (hpd x hx).mul (hhd x)
      · exact (differentiableAt_const (0:ℝ)).congr_of_eventuallyEq (hFoff x hx)
    have hFder : ∀ x, fderiv ℝ (fun y => p y * h y) x (Pi.single k 1) * 1 =
        smthGrad p x k * h x + p x * smthGrad h x k := by
      intro x
      by_cases hx : x ∈ S
      · rw [show (fun y => p y * h y) = p * h from rfl, fderiv_mul (hpd x hx) (hhd x)]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
          smthGrad]
        ring
      · have h1 : fderiv ℝ (fun y => p y * h y) x = 0 := by
          rw [(hFoff x hx).fderiv_eq]; simp
        have h2 : h x = 0 := (hoff x hx).1.self_of_nhds
        have h3 : fderiv ℝ h x = 0 := (hoff x hx).2.self_of_nhds
        simp [h1, h2, h3, smthGrad]
    have hcp : ContinuousOn (fun x => smthGrad p x k) S :=
      (hp.continuousOn_fderiv_of_isOpen hS le_rfl).clm_apply continuousOn_const
    have hU := s1 (fun x => smthGrad p x k) h hcp hh.continuous hhc hhS
    have hV := s1 p (fun x => smthGrad h x k) hp.continuousOn
      ((hh.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hhc.fderiv_apply ℝ _)
      (tsup_grad h hhS k)
    have hFi := s1 p h hp.continuousOn hh.continuous hhc hhS
    have hfun : (fun x => fderiv ℝ (fun y => p y * h y) x (Pi.single k 1) * 1) =
        fun x => smthGrad p x k * h x + p x * smthGrad h x k := funext hFder
    have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
      (f := fun y => p y * h y) (g := fun _ => (1:ℝ)) (v := Pi.single k 1) (μ := volume)
      (by rw [hfun]; exact hU.add hV) (by simp) (by simpa using hFi) hFd (differentiable_const 1)
    rw [hfun, integral_add hU hV] at key
    simp at key
    linarith
  
  intro φ hφ hφc hφS
  have hgrad : ∀ j : Fin 2, ContDiffOn ℝ ∞ (fun y => smthGrad w y j) S := fun j =>
    ((contDiffOn_infty_iff_fderiv_of_isOpen hS).1 hw).2.clm_apply contDiffOn_const
  have hV : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun y => ∑ j : Fin 2, a y i j * smthGrad w y j - F y i) S :=
    fun i => (ContDiffOn.sum fun j _ => (ha i j).mul (hgrad j)).sub (hF i)
  have hφ1 : ContDiff ℝ 1 φ := hφ.of_le (by simp)
  have hd : ContDiff ℝ ∞ (fderiv ℝ φ) := (contDiff_infty_iff_fderiv.mp hφ).2
  have hψc : ∀ i : Fin 2, Continuous (fun x => smthGrad φ x i) := fun i =>
    (hd.clm_apply contDiff_const).continuous
  have hψs : ∀ i : Fin 2, HasCompactSupport (fun x => smthGrad φ x i) := fun i =>
    hφc.fderiv_apply ℝ _
  have hψt : ∀ i : Fin 2, tsupport (fun x => smthGrad φ x i) ⊆ S := fun i => tsup_grad φ hφS i
  have hP : ∀ i : Fin 2, Integrable (fun x =>
      (∑ j : Fin 2, a x i j * smthGrad w x j - F x i) * smthGrad φ x i) := fun i =>
    s1 _ _ (hV i).continuousOn (hψc i) (hψs i) (hψt i)
  have hR : ∀ i : Fin 2, Integrable (fun x => F x i * smthGrad φ x i) := fun i =>
    s1 _ _ (hF i).continuousOn (hψc i) (hψs i) (hψt i)
  have IBP : ∀ i : Fin 2, ∫ x, (∑ j : Fin 2, a x i j * smthGrad w x j - F x i) * smthGrad φ x i =
      -∫ x, smthGrad (fun y => ∑ j : Fin 2, a y i j * smthGrad w y j - F y i) x i * φ x :=
    fun i => s2 _ φ ((hV i).of_le (by simp)) hφ1 hφc hφS i
  have hdiv : ∀ x, smthGrad (fun y => ∑ j : Fin 2, a y 0 j * smthGrad w y j - F y 0) x 0 * φ x +
      smthGrad (fun y => ∑ j : Fin 2, a y 1 j * smthGrad w y j - F y 1) x 1 * φ x = 0 := by
    intro x
    by_cases hx : x ∈ S
    · have h0 := hsol x hx
      rw [Fin.sum_univ_two] at h0
      rw [← add_mul, h0, zero_mul]
    · have h0 : φ x = 0 := image_eq_zero_of_notMem_tsupport (fun h' => hx (hφS h'))
      simp [h0]
  have hdivI : ∫ x, smthGrad (fun y => ∑ j : Fin 2, a y 1 j * smthGrad w y j - F y 1) x 1 * φ x =
      -∫ x, smthGrad (fun y => ∑ j : Fin 2, a y 0 j * smthGrad w y j - F y 0) x 0 * φ x := by
    have hfe : (fun x => smthGrad (fun y => ∑ j : Fin 2, a y 1 j * smthGrad w y j - F y 1) x 1 *
        φ x) = fun x =>
        -(smthGrad (fun y => ∑ j : Fin 2, a y 0 j * smthGrad w y j - F y 0) x 0 * φ x) := by
      funext x
      linarith [hdiv x]
    rw [hfe, integral_neg]
  have hL : (fun x => ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i) =
      fun x => (F x 0 * smthGrad φ x 0 + F x 1 * smthGrad φ x 1) +
        ((∑ j : Fin 2, a x 0 j * smthGrad w x j - F x 0) * smthGrad φ x 0 +
          (∑ j : Fin 2, a x 1 j * smthGrad w x j - F x 1) * smthGrad φ x 1) := by
    funext x
    simp only [Fin.sum_univ_two]
    ring
  have hRt : (fun x => ∑ i : Fin 2, F x i * smthGrad φ x i) =
      fun x => F x 0 * smthGrad φ x 0 + F x 1 * smthGrad φ x 1 := by
    funext x
    rw [Fin.sum_univ_two]
  have hRR : Integrable (fun x => F x 0 * smthGrad φ x 0 + F x 1 * smthGrad φ x 1) :=
    (hR 0).add (hR 1)
  have hPP : Integrable (fun x => (∑ j : Fin 2, a x 0 j * smthGrad w x j - F x 0) * smthGrad φ x 0 +
      (∑ j : Fin 2, a x 1 j * smthGrad w x j - F x 1) * smthGrad φ x 1) := (hP 0).add (hP 1)
  rw [hL, hRt, integral_add hRR hPP, integral_add (hP 0) (hP 1), IBP 0, IBP 1, hdivI]
  ring

theorem mse_grad_holder_local (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (w : (Fin 2 → ℝ) → ℝ)
    (hw : ContDiffOn ℝ ∞ w D) (y : Fin 2 → ℝ) (r : ℝ) (hr : 0 < r)
    (hsub : Metric.closedBall y r ⊆ D) :
    ∃ C₀ : NNReal, HolderOnWith C₀ (1 / 2 : NNReal) (smthGrad w) (Metric.ball y r) :=
by
  have hdw : ContDiffOn ℝ ∞ (fderiv ℝ w) D := ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hw).2
  have hG : ContDiffOn ℝ ∞ (smthGrad w) D := by
    have heq : smthGrad w = fun x k => fderiv ℝ w x (Pi.single k 1) := rfl
    rw [heq]
    exact contDiffOn_pi.2 fun k => hdw.clm_apply contDiffOn_const
  have h1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hcont : ContinuousOn (fderiv ℝ (smthGrad w)) (Metric.closedBall y r) :=
    (hG.continuousOn_fderiv_of_isOpen hD h1).mono hsub
  obtain ⟨L₀, hL₀⟩ := (isCompact_closedBall y r).exists_bound_of_continuousOn hcont
  have hdiff : DifferentiableOn ℝ (smthGrad w) D := hG.differentiableOn (by simp)
  have hLip : LipschitzOnWith L₀.toNNReal (smthGrad w) (Metric.ball y r) := by
    refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ) ?_ ?_ (convex_ball y r)
    · intro x hx
      exact hdiff.differentiableAt
        (hD.mem_nhds (hsub (Metric.ball_subset_closedBall hx)))
    · intro x hx
      have hb := hL₀ x (Metric.ball_subset_closedBall hx)
      rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal']
      exact hb.trans (le_max_left _ _)
  exact HolderOnWith.exists_holderOnWith_of_le ⟨_, hLip.holderOnWith⟩ (by norm_num)
    Metric.isBounded_ball

theorem mse_QC1_of_local (B M : NNReal) (R : ℝ) (hR : 0 < R) :
    ∃ B' : NNReal, ∀ (D T : Set (Fin 2 → ℝ)) (w : (Fin 2 → ℝ) → ℝ),
      IsOpen D → (∀ y ∈ T, Metric.ball y (R / 4) ⊆ D) → ContDiffOn ℝ ∞ w D →
      (∀ x ∈ T, |w x| ≤ (B : ℝ)) →
      (∀ y ∈ T, ∀ x ∈ Metric.ball y (R / 4), ‖smthGrad w x‖ ≤ (M : ℝ)) →
      (∀ y ∈ T, HolderOnWith M (1 / 2 : NNReal) (smthGrad w) (Metric.ball y (R / 4))) →
      mseQC 1 B' w T :=
by
  have hR4 : 0 < R / 4 := by positivity
  have hB0 : (0 : ℝ) ≤ B := B.coe_nonneg
  have hM0 : (0 : ℝ) ≤ M := M.coe_nonneg
  obtain ⟨c₁, hc₁⟩ : ∃ c : ℝ, c = Real.sqrt (R / 4) := ⟨_, rfl⟩
  obtain ⟨c₂, hc₂⟩ : ∃ c : ℝ, c = Real.sqrt (4 / R) := ⟨_, rfl⟩
  have hc₁0 : 0 ≤ c₁ := by rw [hc₁]; exact Real.sqrt_nonneg _
  have hc₂0 : 0 ≤ c₂ := by rw [hc₂]; exact Real.sqrt_nonneg _
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = (B : ℝ) + M + 2 * M * c₁ + 2 * M * c₂ + 2 * B * c₂ := ⟨_, rfl⟩
  have h1 : 0 ≤ (M : ℝ) * c₁ := mul_nonneg hM0 hc₁0
  have h2 : 0 ≤ (M : ℝ) * c₂ := mul_nonneg hM0 hc₂0
  have h3 : 0 ≤ (B : ℝ) * c₂ := mul_nonneg hB0 hc₂0
  have hK0 : 0 ≤ K := by rw [hK]; linarith
  have hKB : (B : ℝ) ≤ K := by rw [hK]; linarith
  have hKM : (M : ℝ) ≤ K := by rw [hK]; linarith
  have hK3 : 2 * (M : ℝ) * c₁ ≤ K := by rw [hK]; linarith
  have hK4 : 2 * (M : ℝ) * c₂ ≤ K := by rw [hK]; linarith
  have hK5 : 2 * (B : ℝ) * c₂ ≤ K := by rw [hK]; linarith
  have hhalf : ((1 / 2 : NNReal) : ℝ) = 1 / 2 := by norm_num
  
  have conv : ∀ (f : (Fin 2 → ℝ) → ℝ) (U : Set (Fin 2 → ℝ)),
      (∀ x ∈ U, ∀ x' ∈ U, |f x - f x'| ≤ K * Real.sqrt (dist x x')) →
      HolderOnWith K.toNNReal (1 / 2 : NNReal) f U := by
    intro f U h x hx x' hx'
    have hd : 0 ≤ dist x x' := dist_nonneg
    rw [edist_dist, edist_dist, Real.dist_eq, hhalf,
      ENNReal.ofReal_rpow_of_nonneg hd (by norm_num), ← ENNReal.ofReal_coe_nnreal,
      ← ENNReal.ofReal_mul (NNReal.coe_nonneg _), Real.coe_toNNReal _ hK0, ← Real.sqrt_eq_rpow]
    exact ENNReal.ofReal_le_ofReal (h x hx x' hx')
  
  have far : ∀ d : ℝ, R / 4 ≤ d → 1 ≤ c₂ * Real.sqrt d := by
    intro d hd
    rw [hc₂, ← Real.sqrt_mul (by positivity) d, Real.one_le_sqrt, div_mul_eq_mul_div,
      le_div_iff₀ hR]
    linarith
  
  have near : ∀ d : ℝ, 0 ≤ d → d ≤ R / 4 → d ≤ c₁ * Real.sqrt d := by
    intro d hd0 hd
    have hs : Real.sqrt d ≤ c₁ := by rw [hc₁]; exact Real.sqrt_le_sqrt hd
    calc d = Real.sqrt d * Real.sqrt d := (Real.mul_self_sqrt hd0).symm
      _ ≤ c₁ * Real.sqrt d := mul_le_mul_of_nonneg_right hs (Real.sqrt_nonneg _)
  refine ⟨K.toNNReal, ?_⟩
  intro D T w hD hsub hw hBd hMd hH
  have hKc : ((K.toNNReal : NNReal) : ℝ) = K := Real.coe_toNNReal _ hK0
  
  have lip : ∀ y ∈ T, ∀ x ∈ Metric.ball y (R / 4), ∀ x' ∈ Metric.ball y (R / 4),
      |w x - w x'| ≤ 2 * M * dist x x' := by
    intro y hy x hx x' hx'
    have hdiff : ∀ z ∈ Metric.ball y (R / 4), DifferentiableAt ℝ w z := by
      intro z hz
      exact (hw.differentiableOn (by simp)).differentiableAt (hD.mem_nhds (hsub y hy hz))
    have hop : ∀ z ∈ Metric.ball y (R / 4), ‖fderiv ℝ w z‖ ≤ 2 * M := by
      intro z hz
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun h => ?_)
      have hdec : h = h 0 • (Pi.single 0 1 : Fin 2 → ℝ) + h 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
        ext i; fin_cases i <;> simp
      have hL : fderiv ℝ w z h = h 0 * smthGrad w z 0 + h 1 * smthGrad w z 1 := by
        rw [show fderiv ℝ w z h = fderiv ℝ w z
            (h 0 • (Pi.single 0 1 : Fin 2 → ℝ) + h 1 • (Pi.single 1 1 : Fin 2 → ℝ)) from
            congrArg _ hdec, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
        rfl
      have hg : ∀ k, |smthGrad w z k| ≤ M := fun k => by
        have := norm_le_pi_norm (smthGrad w z) k
        rw [Real.norm_eq_abs] at this
        exact this.trans (hMd y hy z hz)
      have hh : ∀ k, |h k| ≤ ‖h‖ := fun k => by
        have := norm_le_pi_norm h k
        rwa [Real.norm_eq_abs] at this
      rw [Real.norm_eq_abs, hL]
      calc |h 0 * smthGrad w z 0 + h 1 * smthGrad w z 1|
          ≤ |h 0 * smthGrad w z 0| + |h 1 * smthGrad w z 1| := abs_add_le _ _
        _ = |h 0| * |smthGrad w z 0| + |h 1| * |smthGrad w z 1| := by rw [abs_mul, abs_mul]
        _ ≤ ‖h‖ * M + ‖h‖ * M :=
            add_le_add (mul_le_mul (hh 0) (hg 0) (abs_nonneg _) (norm_nonneg _))
              (mul_le_mul (hh 1) (hg 1) (abs_nonneg _) (norm_nonneg _))
        _ = 2 * M * ‖h‖ := by ring
    have hmvt := (convex_ball y (R / 4)).norm_image_sub_le_of_norm_fderiv_le hdiff hop hx' hx
    rw [Real.norm_eq_abs, ← dist_eq_norm] at hmvt
    exact hmvt
  have hball : ∀ x ∈ T, x ∈ Metric.ball x (R / 4) := fun x _ => Metric.mem_ball_self hR4
  have hgm : ∀ x ∈ T, ∀ m, |smthGrad w x m| ≤ M := fun x hx m => by
    have := norm_le_pi_norm (smthGrad w x) m
    rw [Real.norm_eq_abs] at this
    exact this.trans (hMd x hx x (hball x hx))
  refine ⟨⟨fun x hx => ?_, conv w T ?_⟩, fun m => ⟨fun x hx => ?_, conv _ T ?_⟩⟩
  · rw [hKc]; exact (hBd x hx).trans hKB
  · intro x hx x' hx'
    have hd0 : 0 ≤ dist x x' := dist_nonneg
    have hs0 : 0 ≤ Real.sqrt (dist x x') := Real.sqrt_nonneg _
    rcases lt_or_ge (dist x x') (R / 4) with hlt | hge
    · have hx'b : x' ∈ Metric.ball x (R / 4) := by
        rw [Metric.mem_ball, dist_comm]; exact hlt
      have e1 := lip x hx x (hball x hx) x' hx'b
      have e2 := near _ hd0 hlt.le
      calc |w x - w x'| ≤ 2 * M * dist x x' := e1
        _ ≤ 2 * M * (c₁ * Real.sqrt (dist x x')) :=
            mul_le_mul_of_nonneg_left e2 (by positivity)
        _ = (2 * M * c₁) * Real.sqrt (dist x x') := by ring
        _ ≤ K * Real.sqrt (dist x x') := mul_le_mul_of_nonneg_right hK3 hs0
    · have e1 := far _ hge
      have e2 : |w x - w x'| ≤ 2 * B := by
        have a1 := abs_le.mp (hBd x hx)
        have a2 := abs_le.mp (hBd x' hx')
        rw [abs_le]; constructor <;> linarith
      calc |w x - w x'| ≤ 2 * B := e2
        _ ≤ 2 * B * (c₂ * Real.sqrt (dist x x')) := le_mul_of_one_le_right (by positivity) e1
        _ = (2 * B * c₂) * Real.sqrt (dist x x') := by ring
        _ ≤ K * Real.sqrt (dist x x') := mul_le_mul_of_nonneg_right hK5 hs0
  · rw [hKc]; exact (hgm x hx m).trans hKM
  · intro x hx x' hx'
    have hd0 : 0 ≤ dist x x' := dist_nonneg
    have hs0 : 0 ≤ Real.sqrt (dist x x') := Real.sqrt_nonneg _
    rcases lt_or_ge (dist x x') (R / 4) with hlt | hge
    · have hx'b : x' ∈ Metric.ball x (R / 4) := by
        rw [Metric.mem_ball, dist_comm]; exact hlt
      have e1 := (hH x hx).dist_le (hball x hx) hx'b
      rw [hhalf, ← Real.sqrt_eq_rpow] at e1
      have e3 : |smthGrad w x m - smthGrad w x' m| ≤ dist (smthGrad w x) (smthGrad w x') := by
        rw [← Real.dist_eq]; exact dist_le_pi_dist _ _ m
      calc |smthGrad w x m - smthGrad w x' m| ≤ M * Real.sqrt (dist x x') := e3.trans e1
        _ ≤ K * Real.sqrt (dist x x') := mul_le_mul_of_nonneg_right hKM hs0
    · have e1 := far _ hge
      have e2 : |smthGrad w x m - smthGrad w x' m| ≤ 2 * M := by
        have a1 := abs_le.mp (hgm x hx m)
        have a2 := abs_le.mp (hgm x' hx' m)
        rw [abs_le]; constructor <;> linarith
      calc |smthGrad w x m - smthGrad w x' m| ≤ 2 * M := e2
        _ ≤ 2 * M * (c₂ * Real.sqrt (dist x x')) := le_mul_of_one_le_right (by positivity) e1
        _ = (2 * M * c₂) * Real.sqrt (dist x x') := by ring
        _ ≤ K * Real.sqrt (dist x x') := mul_le_mul_of_nonneg_right hK4 hs0

theorem mse_lin_base (lam : ℝ) (hlam : 0 < lam) (B : NNReal) (R : ℝ) (hR : 0 < R) :
    ∃ B' : NNReal, ∀ (D S T : Set (Fin 2 → ℝ)) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ)
      (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ),
      IsOpen D → IsOpen S → S ⊆ D → (∀ x ∈ T, Metric.ball x R ⊆ S) →
      (∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) D) → (∀ i, ContDiffOn ℝ ∞ (fun x => F x i) D) →
      ContDiffOn ℝ ∞ w D →
      (∀ x ∈ S, ∀ ξ : Fin 2 → ℝ, lam * ∑ i : Fin 2, ξ i ^ 2 ≤
        ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j) →
      (∀ i j, mseQC 0 B (fun x => a x i j) S) → (∀ i, mseQC 0 B (fun x => F x i) S) →
      (∀ x ∈ S, |w x| ≤ B) → mseDivSol a F w S → mseQC 1 B' w T :=
by
  obtain ⟨M, hM⟩ := smth_lin_schauder_est (1 / 2 : NNReal) lam B (R / 2) (by norm_num)
    (by norm_num) hlam (half_pos hR)
  obtain ⟨B', hB'⟩ := mse_QC1_of_local B M R hR
  refine ⟨B', ?_⟩
  intro D S T a F w hD hS hSD hT ha hF hw hell hQa hQF hwB hsol
  have hTS : T ⊆ S := fun x hx => hT x hx (Metric.mem_ball_self hR)
  
  have hHa : HolderOnWith B (1 / 2 : NNReal) a S := by
    intro x hx x' hx'
    exact edist_pi_le_iff.2 fun i => edist_pi_le_iff.2 fun j => (hQa i j).2 x hx x' hx'
  have hHF : HolderOnWith B (1 / 2 : NNReal) F S := by
    intro x hx x' hx'
    exact edist_pi_le_iff.2 fun i => (hQF i).2 x hx x' hx'
  
  have hloc : ∀ y ∈ T, HolderOnWith M (1 / 2 : NNReal) (smthGrad w) (Metric.ball y (R / 4)) ∧
      ∀ x ∈ Metric.ball y (R / 4), ‖smthGrad w x‖ ≤ (M : ℝ) := by
    intro y hy
    have hsub1 : Metric.ball y (R / 2) ⊆ S :=
      (Metric.ball_subset_ball (by linarith)).trans (hT y hy)
    have hsubD : Metric.ball y (R / 2) ⊆ D := hsub1.trans hSD
    have hsub2 : Metric.closedBall y (R / 2) ⊆ D :=
      ((Metric.closedBall_subset_ball (by linarith)).trans (hT y hy)).trans hSD
    have hdata : smthSchauderData lam B (1 / 2 : NNReal) a F w (Metric.ball y (R / 2)) :=
      ⟨fun x hx ξ => hell x (hsub1 hx) ξ,
        fun x hx i j => (hQa i j).1 x (hsub1 hx),
        hHa.mono hsub1,
        fun x hx i => (hQF i).1 x (hsub1 hx),
        hHF.mono hsub1,
        fun x hx => hwB x (hsub1 hx),
        (hw.of_le (by exact_mod_cast le_top)).mono hsubD,
        mse_grad_holder_local D hD w hw y (R / 2) (half_pos hR) hsub2,
        mse_divsol_weak _ Metric.isOpen_ball a F w (fun i j => (ha i j).mono hsubD)
          (fun i => (hF i).mono hsubD) (hw.mono hsubD) (fun x hx => hsol x (hsub1 hx))⟩
    have h := hM y a F w hdata
    have hr : R / 2 / 2 = R / 4 := by ring
    rw [hr] at h
    exact h
  exact hB' D T w hD
    (fun y hy => ((Metric.ball_subset_ball (by linarith)).trans (hT y hy)).trans hSD) hw
    (fun x hx => hwB x (hTS hx)) (fun y hy => (hloc y hy).2) (fun y hy => (hloc y hy).1)

theorem mse_divsol_deriv (S : Set (Fin 2 → ℝ)) (hS : IsOpen S)
    (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ)
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S) (hF : ∀ i, ContDiffOn ℝ ∞ (fun x => F x i) S)
    (hw : ContDiffOn ℝ ∞ w S) (hsol : mseDivSol a F w S) (m : Fin 2) :
    mseDivSol a (fun x i => smthGrad (fun y => F y i) x m -
        ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j)
      (fun x => smthGrad w x m) S :=
by
  have hSx : ∀ {f : (Fin 2 → ℝ) → ℝ}, ContDiffOn ℝ ∞ f S → ∀ y ∈ S, DifferentiableAt ℝ f y :=
    fun hf y hy => (hf.contDiffAt (hS.mem_nhds hy)).differentiableAt (by simp)
  have hgradC : ∀ {f : (Fin 2 → ℝ) → ℝ}, ContDiffOn ℝ ∞ f S → ∀ k : Fin 2,
      ContDiffOn ℝ ∞ (fun y => smthGrad f y k) S :=
    fun hf k => ((contDiffOn_infty_iff_fderiv_of_isOpen hS).1 hf).2.clm_apply contDiffOn_const
  
  have hsymm : ∀ (f : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ f S → ∀ y ∈ S, ∀ i j : Fin 2,
      smthGrad (fun z => smthGrad f z j) y i = smthGrad (fun z => smthGrad f z i) y j := by
    intro f hf y hy i j
    have hFy : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hS.mem_nhds hy)
    have hsym : IsSymmSndFDerivAt ℝ f y := hFy.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have hd2 : DifferentiableAt ℝ (fderiv ℝ f) y :=
      ((((contDiffOn_infty_iff_fderiv_of_isOpen hS).1 hf).2).contDiffAt
        (hS.mem_nhds hy)).differentiableAt (by simp)
    have key : ∀ k : Fin 2, fderiv ℝ (fun z => smthGrad f z k) y =
        (fderiv ℝ (fderiv ℝ f) y).flip (Pi.single k 1) := by
      intro k
      have h1 := fderiv_clm_apply hd2
        (differentiableAt_const (Pi.single k (1 : ℝ) : Fin 2 → ℝ))
      rw [fderiv_const_apply, ContinuousLinearMap.comp_zero, zero_add] at h1
      exact h1
    show fderiv ℝ (fun z => smthGrad f z j) y (Pi.single i 1) =
      fderiv ℝ (fun z => smthGrad f z i) y (Pi.single j 1)
    rw [key j, key i, ContinuousLinearMap.flip_apply, ContinuousLinearMap.flip_apply]
    exact hsym _ _
  
  have hexp : ∀ y ∈ S, ∀ i : Fin 2,
      smthGrad (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) y m =
        ∑ j : Fin 2, (smthGrad (fun z => a z i j) y m * smthGrad w y j +
          a y i j * smthGrad (fun z => smthGrad w z j) y m) - smthGrad (fun z => F z i) y m := by
    intro y hy i
    have hprod : ∀ j : Fin 2, DifferentiableAt ℝ (fun z => a z i j * smthGrad w z j) y :=
      fun j => (hSx (ha i j) y hy).mul (hSx (hgradC hw j) y hy)
    have hfun : (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) =
        (fun z => (a z i 0 * smthGrad w z 0 + a z i 1 * smthGrad w z 1) - F z i) := by
      funext z
      rw [Fin.sum_univ_two]
    have hsumd : DifferentiableAt ℝ
        (fun z => a z i 0 * smthGrad w z 0 + a z i 1 * smthGrad w z 1) y :=
      (hprod 0).add (hprod 1)
    show fderiv ℝ _ y (Pi.single m 1) = _
    rw [hfun, fderiv_fun_sub hsumd (hSx (hF i) y hy),
      fderiv_fun_add (hprod 0) (hprod 1),
      fderiv_fun_mul (hSx (ha i 0) y hy) (hSx (hgradC hw 0) y hy),
      fderiv_fun_mul (hSx (ha i 1) y hy) (hSx (hgradC hw 1) y hy)]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    unfold smthGrad
    ring
  
  have hflux : ∀ y ∈ S, ∀ i : Fin 2,
      (∑ j : Fin 2, a y i j * smthGrad (fun x => smthGrad w x m) y j
        - (smthGrad (fun y => F y i) y m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) y m * smthGrad w y j))
      = smthGrad (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) y m := by
    intro y hy i
    rw [hexp y hy i]
    simp only [Fin.sum_univ_two]
    rw [hsymm w hw y hy m 0, hsymm w hw y hy m 1]
    ring
  
  have hV : ∀ i : Fin 2,
      ContDiffOn ℝ ∞ (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) S :=
    fun i => (ContDiffOn.sum (fun j _ => (ha i j).mul (hgradC hw j))).sub (hF i)
  
  unfold mseDivSol
  intro x hx
  have hloc : ∀ i : Fin 2,
      smthGrad (fun y => ∑ j : Fin 2, a y i j * smthGrad (fun x => smthGrad w x m) y j
        - (smthGrad (fun y => F y i) y m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) y m * smthGrad w y j)) x i
      = smthGrad (fun y => smthGrad
          (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) y m) x i := by
    intro i
    have hev : (fun y => ∑ j : Fin 2, a y i j * smthGrad (fun x => smthGrad w x m) y j
        - (smthGrad (fun y => F y i) y m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) y m * smthGrad w y j)) =ᶠ[𝓝 x]
        (fun y => smthGrad
          (fun z => ∑ j : Fin 2, a z i j * smthGrad w z j - F z i) y m) :=
      Filter.eventually_of_mem (hS.mem_nhds hx) (fun y hy => hflux y hy i)
    show fderiv ℝ _ x (Pi.single i 1) = fderiv ℝ _ x (Pi.single i 1)
    rw [hev.fderiv_eq]
  
  rw [Finset.sum_congr rfl (fun i _ => hloc i),
    Finset.sum_congr rfl (fun i _ => hsymm _ (hV i) x hx i m)]
  
  have hev2 : (fun y => smthGrad (fun z => ∑ j : Fin 2, a z 0 j * smthGrad w z j - F z 0) y 0
      + smthGrad (fun z => ∑ j : Fin 2, a z 1 j * smthGrad w z j - F z 1) y 1)
      =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
    Filter.eventually_of_mem (hS.mem_nhds hx) (fun y hy => by
      have h := hsol y hy
      rw [Fin.sum_univ_two] at h
      exact h)
  have hd0 := hev2.fderiv_eq (𝕜 := ℝ)
  rw [fderiv_const_apply, fderiv_fun_add (hSx (hgradC (hV 0) 0) x hx)
    (hSx (hgradC (hV 1) 1) x hx)] at hd0
  have h2 := congrArg (fun L => L (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) hd0
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.zero_apply] at h2
  rw [Fin.sum_univ_two]
  exact h2

theorem mse_lin_bootstrap (s : ℕ) (lam : ℝ) (hlam : 0 < lam) (B : NNReal) (R : ℝ) (hR : 0 < R) :
    ∃ B' : NNReal, ∀ (D S T : Set (Fin 2 → ℝ)) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ)
      (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ),
      IsOpen D → IsOpen S → S ⊆ D → (∀ x ∈ T, Metric.ball x R ⊆ S) →
      (∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) D) → (∀ i, ContDiffOn ℝ ∞ (fun x => F x i) D) →
      ContDiffOn ℝ ∞ w D →
      (∀ x ∈ S, ∀ ξ : Fin 2 → ℝ, lam * ∑ i : Fin 2, ξ i ^ 2 ≤
        ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j) →
      (∀ i j, mseQC s B (fun x => a x i j) S) → (∀ i, mseQC s B (fun x => F x i) S) →
      (∀ x ∈ S, |w x| ≤ B) → mseDivSol a F w S → mseQC (s + 1) B' w T :=
by
  induction s generalizing B R hR with
  | zero =>
    obtain ⟨B', hB'⟩ := mse_lin_base lam hlam B R hR
    exact ⟨B', fun D S T a F w hD hS hSD hT ha hF hw hell hQa hQF hwB hsol =>
      hB' D S T a F w hD hS hSD hT ha hF hw hell hQa hQF hwB hsol⟩
  | succ s ih =>
    have hR2 : 0 < R / 2 := half_pos hR
    obtain ⟨Bw, hBw⟩ := ih B (R / 2) hR2
    obtain ⟨B3, hB3⟩ := ih (max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))))
      (R / 2) hR2
    refine ⟨max Bw B3, ?_⟩
    intro D S T a F w hD hS hSD hT ha hF hw hell hQa hQF hwB hsol
    
    have hpd : ∀ f : (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ f D → ∀ m : Fin 2,
        ContDiffOn ℝ ∞ (fun x => smthGrad f x m) D := by
      intro f hf m
      exact ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hf).2.clm_apply contDiffOn_const
    
    have hT'o : IsOpen (⋃ x ∈ T, Metric.ball x (R / 2)) :=
      isOpen_biUnion (fun x _ => Metric.isOpen_ball)
    have hT'S : ∀ z ∈ (⋃ x ∈ T, Metric.ball x (R / 2)), Metric.ball z (R / 2) ⊆ S := by
      intro z hz q hq
      rw [Set.mem_iUnion₂] at hz
      obtain ⟨x, hxT, hzx⟩ := hz
      apply hT x hxT
      rw [Metric.mem_ball] at hq hzx ⊢
      calc dist q x ≤ dist q z + dist z x := dist_triangle _ _ _
        _ < R / 2 + R / 2 := add_lt_add hq hzx
        _ = R := by ring
    have hT'sub : (⋃ x ∈ T, Metric.ball x (R / 2)) ⊆ S :=
      fun z hz => hT'S z hz (Metric.mem_ball_self hR2)
    have hT'D : (⋃ x ∈ T, Metric.ball x (R / 2)) ⊆ D := hT'sub.trans hSD
    have hTT' : ∀ x ∈ T, Metric.ball x (R / 2) ⊆ (⋃ x ∈ T, Metric.ball x (R / 2)) :=
      fun x hx z hz => Set.mem_biUnion hx hz
    have hTsub : T ⊆ (⋃ x ∈ T, Metric.ball x (R / 2)) :=
      fun x hx => hTT' x hx (Metric.mem_ball_self hR2)
    
    have hW : mseQC (s + 1) Bw w (⋃ x ∈ T, Metric.ball x (R / 2)) :=
      hBw D S _ a F w hD hS hSD hT'S ha hF hw hell
        (fun i j => mse_QC_mono.1 s (s + 1) B _ S (Nat.le_succ s) (hQa i j))
        (fun i => mse_QC_mono.1 s (s + 1) B _ S (Nat.le_succ s) (hQF i)) hwB hsol
    have hBBm : B ≤ max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))) :=
      le_max_left _ _
    have hBwBm : Bw ≤ max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))) :=
      (le_max_left _ _).trans (le_max_right _ _)
    have hBFBm : B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw) ≤
        max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))) :=
      (le_max_right _ _).trans (le_max_right _ _)
    
    have hstep : ∀ m : Fin 2, mseQC (s + 1) B3 (fun x => smthGrad w x m) T := by
      intro m
      have hsolm := mse_divsol_deriv S hS a F w (fun i j => (ha i j).mono hSD)
        (fun i => (hF i).mono hSD) (hw.mono hSD) hsol m
      have hsumsm : ∀ i, ContDiffOn ℝ ∞ (fun x => ∑ j : Fin 2,
          smthGrad (fun y => a y i j) x m * smthGrad w x j) D := by
        intro i
        exact ContDiffOn.sum (fun j _ => (hpd _ (ha i j) m).mul (hpd _ hw j))
      have hFm : ∀ i, ContDiffOn ℝ ∞ (fun x => smthGrad (fun y => F y i) x m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) D :=
        fun i => (hpd _ (hF i) m).sub (hsumsm i)
      have hQFm : ∀ i, mseQC s
          (max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))))
          (fun x => smthGrad (fun y => F y i) x m -
            ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j)
          (⋃ x ∈ T, Metric.ball x (R / 2)) := by
        intro i
        have hp : ∀ j, mseQC s (2 ^ (s + 1) * B * Bw)
            (fun x => smthGrad (fun y => a y i j) x m * smthGrad w x j)
            (⋃ x ∈ T, Metric.ball x (R / 2)) := by
          intro j
          have h1 : mseQC s B (fun x => smthGrad (fun y => a y i j) x m)
              (⋃ x ∈ T, Metric.ball x (R / 2)) :=
            mse_QC_mono.2.2 s B _ S _ hT'sub ((hQa i j).2 m)
          have h2 : mseQC s Bw (fun x => smthGrad w x j) (⋃ x ∈ T, Metric.ball x (R / 2)) :=
            hW.2 j
          exact mse_QC_mul s B Bw D _ _ _ hD hT'D (hpd _ (ha i j) m) (hpd _ hw j) h1 h2
        have hsum : mseQC s (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw)
            (fun x => ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j)
            (⋃ x ∈ T, Metric.ball x (R / 2)) := by
          have h := (mse_QC_add_sub s _ _ D _ _ _ hD hT'D
            ((hpd _ (ha i 0) m).mul (hpd _ hw 0)) ((hpd _ (ha i 1) m).mul (hpd _ hw 1))
            (hp 0) (hp 1)).1
          have heq : (fun x => ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) =
              (fun x => smthGrad (fun y => a y i 0) x m * smthGrad w x 0 +
                smthGrad (fun y => a y i 1) x m * smthGrad w x 1) := by
            funext x
            rw [Fin.sum_univ_two]
          rw [heq]
          exact h
        have hdiff := (mse_QC_add_sub s _ _ D _ _ _ hD hT'D (hpd _ (hF i) m) (hsumsm i)
          (mse_QC_mono.2.2 s B _ S _ hT'sub ((hQF i).2 m)) hsum).2
        exact mse_QC_mono.2.1 s _ _ _ _ hBFBm hdiff
      have hQam : ∀ i j, mseQC s
          (max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))))
          (fun x => a x i j) (⋃ x ∈ T, Metric.ball x (R / 2)) := by
        intro i j
        exact mse_QC_mono.2.1 s B _ _ _ hBBm (mse_QC_mono.2.2 s B _ S _ hT'sub
          (mse_QC_mono.1 s (s + 1) B _ S (Nat.le_succ s) (hQa i j)))
      have hbd : ∀ x ∈ (⋃ x ∈ T, Metric.ball x (R / 2)), |smthGrad w x m| ≤
          ((max B (max Bw (B + (2 ^ (s + 1) * B * Bw + 2 ^ (s + 1) * B * Bw))) : NNReal) : ℝ) := by
        intro x hx
        have h0 : mseQC 0 Bw (fun x => smthGrad w x m) (⋃ x ∈ T, Metric.ball x (R / 2)) :=
          mse_QC_mono.1 0 s Bw _ _ (Nat.zero_le s) (hW.2 m)
        exact (h0.1 x hx).trans (NNReal.coe_le_coe.2 hBwBm)
      exact hB3 D (⋃ x ∈ T, Metric.ball x (R / 2)) T a
        (fun x i => smthGrad (fun y => F y i) x m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j)
        (fun x => smthGrad w x m) hD hT'o hT'D hTT' ha hFm (hpd _ hw m)
        (fun x hx ξ => hell x (hT'sub hx) ξ) hQam hQFm hbd
        (fun x hx => hsolm x (hT'sub hx))
    
    refine ⟨?_, fun m => mse_QC_mono.2.1 (s + 1) B3 (max Bw B3) _ T (le_max_right _ _) (hstep m)⟩
    exact (mse_QC_mono.2.1 (s + 1) Bw (max Bw B3) w T (le_max_left _ _)
      (mse_QC_mono.2.2 (s + 1) Bw w _ T hTsub hW)).1

theorem mse_quasilinear_step (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O 𝒦 : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O)
    (h𝒦 : IsCompact 𝒦) (h𝒦c : Convex ℝ 𝒦) (h𝒦O : 𝒦 ⊆ O) (lam : ℝ) (hlam : 0 < lam)
    (hell : ∀ w ∈ 𝒦, ∀ ξ : Fin 2 → ℝ,
      lam * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, mseLpp Λ i j w * ξ i * ξ j)
    (k : ℕ) (B : NNReal) (R : ℝ) (hR : 0 < R) :
    ∃ B' : NNReal, ∀ (D S T : Set (Fin 2 → ℝ)) (u : (Fin 2 → ℝ) → ℝ),
      IsOpen D → IsOpen S → S ⊆ D → (∀ x ∈ T, Metric.ball x R ⊆ S) →
      ContDiffOn ℝ ∞ u D → (∀ x ∈ D, (x, u x, smthGrad u x) ∈ 𝒦) →
      (∀ x ∈ D, smthELop Λ u x = 0) →
      mseQC (k + 1) B u S → mseQC (k + 2) B' u T :=
by
  
  have hD1 : ∀ (f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ f O →
      ∀ v : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ), ContDiffOn ℝ ∞ (fun w => fderiv ℝ f w v) O := by
    intro f hf v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hf).2.clm_apply contDiffOn_const
  have hLp : ∀ i : Fin 2, ContDiffOn ℝ ∞ (mseLp Λ i) O := fun i => hD1 Λ hΛ _
  have hLz : ContDiffOn ℝ ∞ (mseLz Λ) O := hD1 Λ hΛ _
  have hLpp : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (mseLpp Λ i j) O := fun i j => hD1 _ (hLp i) _
  have hLpx : ∀ i m : Fin 2, ContDiffOn ℝ ∞ (mseLpx Λ i m) O := fun i m => hD1 _ (hLp i) _
  have hLpz : ∀ i : Fin 2, ContDiffOn ℝ ∞ (mseLpz Λ i) O := fun i => hD1 _ (hLp i) _
  have hproj : ∀ m : Fin 2,
      ContDiffOn ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => w.2.2 m) O := by
    intro m
    exact ((contDiff_apply ℝ ℝ m).comp (contDiff_snd.comp contDiff_snd)).contDiffOn
  
  set ΦF : Fin 2 → Fin 2 → (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ := fun m i w =>
    (if i = m then mseLz Λ w else 0) - mseLpx Λ i m w - mseLpz Λ i w * w.2.2 m with hΦF_def
  have hΦF : ∀ m i : Fin 2, ContDiffOn ℝ ∞ (ΦF m i) O := by
    intro m i
    have hif : ContDiffOn ℝ ∞
        (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => if i = m then mseLz Λ w else 0) O := by
      by_cases h : i = m
      · simp only [h, if_true]
        exact hLz
      · simp only [h, if_false]
        exact contDiffOn_const
    exact (hif.sub (hLpx i m)).sub ((hLpz i).mul (hproj m))
  
  choose Ca hCa using fun i j : Fin 2 => mse_QC_comp (mseLpp Λ i j) O 𝒦 hO (hLpp i j) h𝒦 h𝒦c h𝒦O k B
  choose CF hCF using fun m i : Fin 2 => mse_QC_comp (ΦF m i) O 𝒦 hO (hΦF m i) h𝒦 h𝒦c h𝒦O k B
  set B₀ : NNReal := B + ∑ i : Fin 2, ∑ j : Fin 2, Ca i j + ∑ m : Fin 2, ∑ i : Fin 2, CF m i
    with hB₀_def
  have hBB₀ : B ≤ B₀ := le_add_right (le_add_right le_rfl)
  have hCaB₀ : ∀ i j, Ca i j ≤ B₀ := by
    intro i j
    have h1 : Ca i j ≤ ∑ j' : Fin 2, Ca i j' :=
      Finset.single_le_sum (f := fun j' => Ca i j') (fun _ _ => zero_le _) (Finset.mem_univ j)
    have h2 : ∑ j' : Fin 2, Ca i j' ≤ ∑ i' : Fin 2, ∑ j' : Fin 2, Ca i' j' :=
      Finset.single_le_sum (f := fun i' => ∑ j' : Fin 2, Ca i' j') (fun _ _ => zero_le _)
        (Finset.mem_univ i)
    exact le_add_right (le_add_left (h1.trans h2))
  have hCFB₀ : ∀ m i, CF m i ≤ B₀ := by
    intro m i
    have h1 : CF m i ≤ ∑ i' : Fin 2, CF m i' :=
      Finset.single_le_sum (f := fun i' => CF m i') (fun _ _ => zero_le _) (Finset.mem_univ i)
    have h2 : ∑ i' : Fin 2, CF m i' ≤ ∑ m' : Fin 2, ∑ i' : Fin 2, CF m' i' :=
      Finset.single_le_sum (f := fun m' => ∑ i' : Fin 2, CF m' i') (fun _ _ => zero_le _)
        (Finset.mem_univ m)
    exact le_add_left (h1.trans h2)
  
  obtain ⟨B₃, hB₃⟩ := mse_lin_bootstrap k lam hlam B₀ R hR
  refine ⟨max B B₃, ?_⟩
  intro D S T u hD hS hSD hT hu hK hEL hQ
  have hTS : T ⊆ S := fun x hx => hT x hx (Metric.mem_ball_self hR)
  have hUO : ∀ x ∈ D, (x, u x, smthGrad u x) ∈ O := fun x hx => h𝒦O (hK x hx)
  have hdu : ∀ m : Fin 2, ContDiffOn ℝ ∞ (fun x => smthGrad u x m) D := by
    intro m
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hu).2.clm_apply contDiffOn_const
  have hU : ContDiffOn ℝ ∞ (fun x => (x, u x, smthGrad u x)) D :=
    contDiffOn_id.prodMk (hu.prodMk (contDiffOn_pi.2 fun m => hdu m))
  have hmaps : Set.MapsTo (fun x => (x, u x, smthGrad u x)) D O := fun x hx => hUO x hx
  refine ⟨⟨fun x hx => (hQ.1.1 x (hTS hx)).trans (NNReal.coe_le_coe.2 (le_max_left B B₃)),
    (hQ.1.2.mono hTS).mono_const (le_max_left B B₃)⟩, ?_⟩
  intro m
  have ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => mseLpp Λ i j (x, u x, smthGrad u x)) D :=
    fun i j => (hLpp i j).comp hU hmaps
  have hF : ∀ i, ContDiffOn ℝ ∞ (fun x => ΦF m i (x, u x, smthGrad u x)) D :=
    fun i => (hΦF m i).comp hU hmaps
  have hell' : ∀ x ∈ S, ∀ ξ : Fin 2 → ℝ, lam * ∑ i : Fin 2, ξ i ^ 2 ≤
      ∑ i : Fin 2, ∑ j : Fin 2, mseLpp Λ i j (x, u x, smthGrad u x) * ξ i * ξ j :=
    fun x hx ξ => hell _ (hK x (hSD hx)) ξ
  have hQa : ∀ i j, mseQC k B₀ (fun x => mseLpp Λ i j (x, u x, smthGrad u x)) S :=
    fun i j => mse_QC_mono.2.1 k _ B₀ _ S (hCaB₀ i j) (hCa i j D S u hD hSD hu hK hQ)
  have hQF : ∀ i, mseQC k B₀ (fun x => ΦF m i (x, u x, smthGrad u x)) S :=
    fun i => mse_QC_mono.2.1 k _ B₀ _ S (hCFB₀ m i) (hCF m i D S u hD hSD hu hK hQ)
  have hwb : ∀ x ∈ S, |smthGrad u x m| ≤ (B₀ : ℝ) := by
    intro x hx
    have h0 : mseQC 0 B (fun x => smthGrad u x m) S :=
      mse_QC_mono.1 0 k B _ S (Nat.zero_le k) (hQ.2 m)
    exact (h0.1 x hx).trans (NNReal.coe_le_coe.2 hBB₀)
  have hsol : mseDivSol (fun x i j => mseLpp Λ i j (x, u x, smthGrad u x))
      (fun x i => ΦF m i (x, u x, smthGrad u x)) (fun x => smthGrad u x m) S := by
    intro x hx
    exact mse_deriv_divform Λ O hO hΛ D hD u hu hUO hEL m x (hSD hx)
  have hw := hB₃ D S T (fun x i j => mseLpp Λ i j (x, u x, smthGrad u x))
    (fun x i => ΦF m i (x, u x, smthGrad u x)) (fun x => smthGrad u x m)
    hD hS hSD hT ha hF (hdu m) hell' hQa hQF hwb hsol
  exact mse_QC_mono.2.1 (k + 1) B₃ (max B B₃) _ T (le_max_right B B₃) hw

theorem mse_iteratedFDeriv_bound (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (u : (Fin 2 → ℝ) → ℝ)
    (hu : ContDiffOn ℝ ∞ u S) (n m : ℕ) (hnm : n ≤ m) (β : NNReal) (hQ : mseQC m β u S)
    (a : Fin 3) (y : E3) (hy : smthHoriz a y ∈ S) :
    ‖iteratedFDeriv ℝ n (fun z => u (smthHoriz a z)) y‖ ≤ 2 ^ n * (β : ℝ) :=
by
  
  have hA : ∀ (k : ℕ) (B : NNReal) (f : (Fin 2 → ℝ) → ℝ), mseQC k B f S →
      ∀ x ∈ S, |f x| ≤ (B : ℝ) := by
    intro k B f h x hx
    cases k with
    | zero => exact h.1 x hx
    | succ k => exact h.1.1 x hx
  have hle : ∀ k : ℕ, ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := fun k => WithTop.coe_le_coe.2 le_top
  
  have s1 : ∀ (n : ℕ) (m : ℕ), n ≤ m → ∀ (u : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ u S →
      mseQC m β u S → ∀ x ∈ S, ∀ j : Fin n → Fin 2,
        |iteratedFDeriv ℝ n u x (fun k => (Pi.single (j k) (1 : ℝ) : Fin 2 → ℝ))| ≤ (β : ℝ) := by
    intro n
    induction n with
    | zero =>
      intro m _ u _ hQ x hx j
      rw [iteratedFDeriv_zero_apply]
      exact hA m β u hQ x hx
    | succ n ih =>
      intro m hm u hu hQ x hx j
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      have hder : ∀ i : Fin 2, mseQC m' β (fun x => smthGrad u x i) S := hQ.2
      have hfd : ContDiffOn ℝ ∞ (fderiv ℝ u) S :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hS).1 hu).2
      have hu' : ContDiffOn ℝ ∞
          (fun y => fderiv ℝ u y (Pi.single (j (Fin.last n)) (1 : ℝ))) S :=
        hfd.clm_apply contDiffOn_const
      rw [iteratedFDeriv_succ_apply_right]
      rw [← iteratedFDerivWithin_of_isOpen n hS hx]
      rw [← iteratedFDerivWithin_clm_apply_const_apply hS.uniqueDiffOn hfd (hle n) hx]
      rw [iteratedFDerivWithin_of_isOpen n hS hx]
      exact ih m' (by omega) _ hu' (hder (j (Fin.last n))) x hx (fun k => j k.castSucc)
  
  have s2 : ∀ (n : ℕ) (f : ContinuousMultilinearMap ℝ (fun _ : Fin n => (Fin 2 → ℝ)) ℝ)
      (B : ℝ), 0 ≤ B →
      (∀ j : Fin n → Fin 2, |f (fun k => (Pi.single (j k) (1 : ℝ) : Fin 2 → ℝ))| ≤ B) →
      ‖f‖ ≤ 2 ^ n * B := by
    intro n f B hB h
    refine ContinuousMultilinearMap.opNorm_le_bound
      (mul_nonneg (pow_nonneg (by norm_num) n) hB) (fun v => ?_)
    have hv : v = fun k => ∑ i : Fin 2, v k i • (Pi.single i (1 : ℝ) : Fin 2 → ℝ) := by
      funext k
      ext t
      simp [Finset.sum_apply, Pi.single_apply]
    have hfv : f v = ∑ r : Fin n → Fin 2,
        (∏ k, v k (r k)) * f (fun k => (Pi.single (r k) (1 : ℝ) : Fin 2 → ℝ)) := by
      conv_lhs => rw [hv]
      rw [ContinuousMultilinearMap.map_sum]
      simp only [ContinuousMultilinearMap.map_smul_univ, smul_eq_mul]
    rw [hfv]
    calc ‖∑ r : Fin n → Fin 2,
          (∏ k, v k (r k)) * f (fun k => (Pi.single (r k) (1 : ℝ) : Fin 2 → ℝ))‖
        ≤ ∑ r : Fin n → Fin 2,
          ‖(∏ k, v k (r k)) * f (fun k => (Pi.single (r k) (1 : ℝ) : Fin 2 → ℝ))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _r : Fin n → Fin 2, (∏ k, ‖v k‖) * B := by
          apply Finset.sum_le_sum
          intro r _
          rw [norm_mul, norm_prod]
          apply mul_le_mul _ (by rw [Real.norm_eq_abs]; exact h r) (norm_nonneg _)
            (Finset.prod_nonneg fun _ _ => norm_nonneg _)
          exact Finset.prod_le_prod (fun _ _ => norm_nonneg _)
            (fun k _ => norm_le_pi_norm (v k) (r k))
      _ = 2 ^ n * B * ∏ k, ‖v k‖ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
            Fintype.card_fin, nsmul_eq_mul]
          push_cast
          ring
  
  let L : E3 →L[ℝ] (Fin 2 → ℝ) :=
    ContinuousLinearMap.pi (fun k : Fin 2 => EuclideanSpace.proj (a.succAbove k))
  have hLz : ∀ z, L z = smthHoriz a z := by
    intro z
    funext k
    simp [L, smthHoriz]
  have hL1 : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun z => ?_)
    rw [one_mul]
    refine (pi_norm_le_iff_of_nonneg (norm_nonneg z)).2 (fun k => ?_)
    simp only [L, ContinuousLinearMap.pi_apply]
    exact PiLp.norm_apply_le z (a.succAbove k)
  have hLeq : (fun z => u (smthHoriz a z)) = u ∘ L := by
    funext z
    simp only [Function.comp_apply, hLz]
  have hyS : L y ∈ S := by rw [hLz]; exact hy
  have hU : IsOpen (L ⁻¹' S) := hS.preimage L.continuous
  have key : iteratedFDeriv ℝ n (fun z => u (smthHoriz a z)) y =
      (iteratedFDeriv ℝ n u (smthHoriz a y)).compContinuousLinearMap (fun _ => L) := by
    rw [hLeq, ← iteratedFDerivWithin_of_isOpen n hU hyS,
      L.iteratedFDerivWithin_comp_right hu hS.uniqueDiffOn hU.uniqueDiffOn hyS (hle n),
      iteratedFDerivWithin_of_isOpen n hS hyS, hLz]
  rw [key]
  calc ‖(iteratedFDeriv ℝ n u (smthHoriz a y)).compContinuousLinearMap (fun _ => L)‖
      ≤ ‖iteratedFDeriv ℝ n u (smthHoriz a y)‖ * ∏ _k : Fin n, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv ℝ n u (smthHoriz a y)‖ * 1 := by
        gcongr
        exact Finset.prod_le_one (fun _ _ => norm_nonneg _) (fun _ _ => hL1)
    _ ≤ 2 ^ n * (β : ℝ) := by
        rw [mul_one]
        exact s2 n _ β β.coe_nonneg (s1 n m hnm u hu hQ _ hy)

theorem mse_graph_higher_bounds (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Ω : Set E3) (c : E3)
    (ρ K : ℝ) (hΩ : IsOpen Ω) (hρ : 0 < ρ) (hball : Metric.closedBall c (10 * ρ) ⊆ Ω)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Ω)
    (hsymm : ∀ y i j, G y i j = G y j i) (hpos : ∀ y ∈ Ω, (G y).PosDef) :
    ∃ B : ℕ → ℝ, ∀ (a : Fin 3) (v : E3 → ℝ),
      (∀ y, v (coordPlaneProj a y) = v y) →
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} →
      (∀ y, ‖coordPlaneProj a (y - c)‖ < 3 * ρ →
        |v (coordPlaneProj a y) - c a| ≤ 9 * ρ ∧ ‖fderiv ℝ v y‖ ≤ 2 ∧
        ‖iteratedFDeriv ℝ 2 v y‖ ≤ K ∧
        levelMeanCurvCoord G (fun z => z a - v (coordPlaneProj a z))
          (coordPlaneProj a y + v (coordPlaneProj a y) • e a) = 0) →
      ∀ (n : ℕ) (y : E3), ‖coordPlaneProj a (y - c)‖ ≤ 5 / 2 * ρ →
        ‖iteratedFDeriv ℝ n v y‖ ≤ B n :=
by
  
  have hs3 : ∀ a : Fin 3, IsOpen (mseLagDom a Ω) ∧ ContDiffOn ℝ ∞ (smthLag G a) (mseLagDom a Ω) ∧
      IsCompact (mseParamSet a c ρ) ∧ Convex ℝ (mseParamSet a c ρ) ∧
      mseParamSet a c ρ ⊆ mseLagDom a Ω :=
    fun a => mse_lag_smooth G Ω c ρ hΩ hρ hball hG hsymm hpos a
  have hs4 := fun a : Fin 3 => mse_lag_elliptic G Ω c ρ hΩ hρ hball hG hsymm hpos a
  choose lam hlam hell using hs4
  have hs5 := fun a : Fin 3 => mse_QC_base (|c a| + 9 * ρ) 2 |K| (6 * ρ)
  choose b hb using hs5
  have hR : ∀ k : ℕ, 0 < ρ / 2 ^ (k + 3) := fun k => by positivity
  have hs6 := fun (a : Fin 3) (k : ℕ) (B : NNReal) =>
    mse_quasilinear_step (smthLag G a) (mseLagDom a Ω) (mseParamSet a c ρ) (hs3 a).1
      (hs3 a).2.1 (hs3 a).2.2.1 (hs3 a).2.2.2.1 (hs3 a).2.2.2.2 (lam a) (hlam a) (hell a) k B
      (ρ / 2 ^ (k + 3)) (hR k)
  choose f hf using hs6
  let β : Fin 3 → ℕ → NNReal := fun a n =>
    Nat.rec (motive := fun _ => NNReal) (b a) (fun k Bk => f a k Bk) n
  have hβs : ∀ a k, β a (k + 1) = f a k (β a k) := fun a k => rfl
  
  let r : ℕ → ℝ := fun k => 5 / 2 * ρ + ρ / 2 ^ (k + 1)
  have hr0 : r 0 = 3 * ρ := by simp only [r]; ring
  have hrpos : ∀ k, 0 < r k := fun k => by simp only [r]; positivity
  have hrle : ∀ k, r k ≤ 3 * ρ := by
    intro k
    simp only [r]
    have h1 : (1 : ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
    have h2 : (2 : ℝ) ^ (k + 1) = 2 ^ k * 2 := pow_succ _ _
    have h3 : (2 : ℝ) ≤ 2 ^ (k + 1) := by rw [h2]; linarith
    have : ρ / 2 ^ (k + 1) ≤ ρ / 2 := div_le_div_of_nonneg_left hρ.le (by norm_num) h3
    linarith
  have hrid : ∀ k, r (k + 1) + 2 * (ρ / 2 ^ (k + 3)) = r k := by
    intro k
    simp only [r]
    have e3 : (2 : ℝ) ^ (k + 3) = 2 ^ (k + 1) * 4 := by
      rw [show k + 3 = (k + 1) + 2 by omega, pow_add]; norm_num
    have e2 : (2 : ℝ) ^ (k + 1 + 1) = 2 ^ (k + 1) * 2 := pow_succ _ _
    rw [e3, e2]
    have hp : (0 : ℝ) < 2 ^ (k + 1) := by positivity
    field_simp
    ring
  refine ⟨fun n => ∑ a' : Fin 3, 2 ^ n * (β a' n : ℝ), ?_⟩
  intro a v hinv hv hbd n y hy
  obtain ⟨hrep, hsm, hdat⟩ := mse_planar_data G c ρ K hρ a v hinv hv hbd
  obtain ⟨hgeo1, hgeo2, hgeo3, hgeo4, hgeo5⟩ := mse_disc_geometry a c
  set D := smthDisc a c (3 * ρ) with hD_def
  set u : (Fin 2 → ℝ) → ℝ := fun x => v (smthLift a x 0) with hu_def
  have hDo : IsOpen D := (hgeo1 _).1
  
  have hK : ∀ x ∈ D, (x, u x, smthGrad u x) ∈ mseParamSet a c ρ := by
    intro x hx
    obtain ⟨h1, h2, -, -⟩ := hdat x hx
    have hx' : ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 < (3 * ρ) ^ 2 := hx
    show ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 ≤ (3 * ρ) ^ 2 ∧ |u x - c a| ≤ 9 * ρ ∧
      ‖smthGrad u x‖ ≤ 2
    refine ⟨le_of_lt hx', h1, ?_⟩
    refine (pi_norm_le_iff_of_nonneg (by norm_num)).2 (fun m => ?_)
    rw [Real.norm_eq_abs]
    exact h2 m
  have hlift : ∀ x ∈ D, smthLift a x (u x) ∈ Ω := fun x hx => (hs3 a).2.2.2.2 (hK x hx)
  have hEL : ∀ x ∈ D, smthELop (smthLag G a) u x = 0 :=
    mse_strong_EL G Ω hΩ hG hsymm hpos a D hDo u hsm hlift (fun x hx => (hdat x hx).2.2.2)
  
  have hbase : mseQC 1 (b a) u D := by
    refine hb a D u hDo (hgeo1 _).2 ?_ hsm ?_
    · intro x hx y hy
      have := hgeo3 (3 * ρ) (by linarith) x hx y hy
      linarith
    · intro x hx
      obtain ⟨h1, h2, h3, -⟩ := hdat x hx
      refine ⟨?_, h2, fun l m => (h3 l m).trans (le_abs_self K)⟩
      have := abs_sub_abs_le_abs_sub (u x) (c a)
      linarith
  
  have hind : ∀ k : ℕ, mseQC (k + 1) (β a k) u (smthDisc a c (r k)) := by
    intro k
    induction k with
    | zero =>
      rw [hr0]
      exact hbase
    | succ k ih =>
      rw [hβs]
      refine hf a k (β a k) D (smthDisc a c (r k)) (smthDisc a c (r (k + 1))) u hDo
        (hgeo1 _).1 (hgeo2 _ _ (hrpos k).le (hrle k)) ?_ hsm hK hEL ih
      intro x hx
      have := hgeo4 (r (k + 1)) (ρ / 2 ^ (k + 3)) (hrpos _).le (hR k) x hx
      rwa [hrid k] at this
  
  have hyn : smthHoriz a y ∈ smthDisc a c (r n) := by
    apply hgeo5 (r n) y (hrpos n)
    have : 0 < ρ / 2 ^ (n + 1) := by positivity
    simp only [r]
    linarith
  have hfin := mse_iteratedFDeriv_bound (smthDisc a c (r n)) (hgeo1 _).1 u
    (hsm.mono (hgeo2 _ _ (hrpos n).le (hrle n))) n (n + 1) (Nat.le_succ n) (β a n) (hind n)
    a y hyn
  have hv_eq : v = fun z => u (smthHoriz a z) := funext hrep
  rw [hv_eq]
  refine hfin.trans ?_
  show 2 ^ n * (β a n : ℝ) ≤ ∑ a' : Fin 3, 2 ^ n * (β a' n : ℝ)
  exact Finset.single_le_sum (f := fun a' : Fin 3 => 2 ^ n * (β a' n : ℝ))
    (fun i _ => by positivity) (Finset.mem_univ a)

theorem planar_cutoff_extension (c : E3) (ρ : ℝ) (hρ : 0 < ρ) (B : ℕ → ℝ) :
    ∃ B' : ℕ → ℝ, ∀ (a : Fin 3) (v : E3 → ℝ),
      (∀ y, v (coordPlaneProj a y) = v y) →
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} →
      (∀ (n : ℕ) (y : E3), ‖coordPlaneProj a (y - c)‖ ≤ 5 / 2 * ρ →
        ‖iteratedFDeriv ℝ n v y‖ ≤ B n) →
      ∃ u : E3 → ℝ, ContDiff ℝ ∞ u ∧ (∀ y, u (coordPlaneProj a y) = u y) ∧
        (∀ y, ‖coordPlaneProj a (y - c)‖ < 2 * ρ → u y = v y) ∧
        ∀ (n : ℕ) (y : E3), ‖iteratedFDeriv ℝ n u y‖ ≤ B' n :=
by
  
  have hP5 : ∀ (a : Fin 3) (y z : E3),
      coordPlaneProj a (y - z) = coordPlaneProj a y - coordPlaneProj a z := by
    intro a y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ (a : Fin 3) (q : E3), (coordPlaneProj a q) a = 0 := by
    intro a q
    simp [coordPlaneProj, e]
  have hP3 : ∀ (a : Fin 3) (q : E3),
      coordPlaneProj a (coordPlaneProj a q) = coordPlaneProj a q := by
    intro a q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP7 : ∀ (a : Fin 3) (w : E3), ‖coordPlaneProj a w‖ ≤ ‖w‖ := by
    intro a w
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    by_cases h : i = a
    · subst h
      rw [hpa]; simpa using sq_nonneg (w i)
    · simp [coordPlaneProj, e, EuclideanSpace.single_apply, h]
  have hcontP : ∀ a : Fin 3, Continuous (coordPlaneProj a) := by
    intro a
    unfold coordPlaneProj
    fun_prop
  have hCylOpen : ∀ (a : Fin 3) (c : E3) (r : ℝ),
      IsOpen {y : E3 | ‖coordPlaneProj a (y - c)‖ < r} := by
    intro a c r
    exact isOpen_lt ((hcontP a).comp (continuous_id.sub continuous_const)).norm continuous_const
  have hExtOpen : ∀ (a : Fin 3) (c : E3) (r : ℝ),
      IsOpen {y : E3 | r < ‖coordPlaneProj a (y - c)‖} := by
    intro a c r
    exact isOpen_lt continuous_const ((hcontP a).comp (continuous_id.sub continuous_const)).norm
  
  obtain ⟨Φ, hΦin, hΦout⟩ : ∃ Φ : ContDiffBump (0 : E3), Φ.rIn = 2 * ρ ∧ Φ.rOut = 9 / 4 * ρ :=
    ⟨⟨2 * ρ, 9 / 4 * ρ, by positivity, by linarith⟩, rfl, rfl⟩
  have hΦs : ContDiff ℝ ∞ Φ := Φ.contDiff
  have hbd : ∀ n : ℕ, ∃ C : ℝ, ∀ w, ‖iteratedFDeriv ℝ n Φ w‖ ≤ C := fun n =>
    (hΦs.continuous_iteratedFDeriv (WithTop.coe_le_coe.2 le_top)).bounded_above_of_compact_support
      (Φ.hasCompactSupport.iteratedFDeriv n)
  choose C hC using hbd
  obtain ⟨M, hMdef⟩ : ∃ M : ℕ → ℝ, M = fun n => max (C n) 0 := ⟨_, rfl⟩
  have hM0 : ∀ n, 0 ≤ M n := fun n => by rw [hMdef]; exact le_max_right _ _
  have hMb : ∀ n w, ‖iteratedFDeriv ℝ n Φ w‖ ≤ M n := fun n w => by
    rw [hMdef]; exact (hC n w).trans (le_max_left _ _)
  
  refine ⟨fun n => ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * M i * |B (n - i)|, ?_⟩
  intro a v hvP hvS hvB
  obtain ⟨Pa, hPa⟩ : ∃ Pa : E3 →L[ℝ] E3, ∀ w, Pa w = coordPlaneProj a w :=
    ⟨ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj a).smulRight (e a),
      fun w => by simp [coordPlaneProj]⟩
  have hPan : ‖Pa‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun w => by rw [hPa, one_mul]; exact hP7 a w)
  obtain ⟨χ, hχdef⟩ : ∃ χ : E3 → ℝ, χ = fun y => (⇑Φ ∘ ⇑Pa) (y - c) := ⟨_, rfl⟩
  have hgS : ContDiff ℝ ∞ (⇑Φ ∘ ⇑Pa) := hΦs.comp Pa.contDiff
  have hχS : ContDiff ℝ ∞ χ := by
    rw [hχdef]; exact hgS.comp (contDiff_id.sub contDiff_const)
  have hχval : ∀ y, χ y = Φ (coordPlaneProj a (y - c)) := fun y => by
    rw [hχdef]; simp only [Function.comp_apply, hPa]
  have hχP : ∀ y, χ (coordPlaneProj a y) = χ y := by
    intro y; rw [hχval, hχval, hP5, hP3, ← hP5]
  have hχ1 : ∀ y, ‖coordPlaneProj a (y - c)‖ ≤ 2 * ρ → χ y = 1 := by
    intro y hy
    rw [hχval]
    apply Φ.one_of_mem_closedBall
    rw [mem_closedBall_zero_iff, hΦin]
    exact hy
  have hχ0 : ∀ y, 9 / 4 * ρ ≤ ‖coordPlaneProj a (y - c)‖ → χ y = 0 := by
    intro y hy
    rw [hχval]
    apply Φ.zero_of_le_dist
    rw [dist_zero_right, hΦout]
    exact hy
  have hχM : ∀ (n : ℕ) (y : E3), ‖iteratedFDeriv ℝ n χ y‖ ≤ M n := by
    intro n y
    have h1 : iteratedFDeriv ℝ n χ y = iteratedFDeriv ℝ n (⇑Φ ∘ ⇑Pa) (y - c) := by
      rw [hχdef]; exact iteratedFDeriv_comp_sub n c y
    rw [h1, ContinuousLinearMap.iteratedFDeriv_comp_right Pa hΦs (y - c)
      (WithTop.coe_le_coe.2 le_top)]
    refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
    have hprod : ∏ _i : Fin n, ‖Pa‖ ≤ 1 :=
      Finset.prod_le_one (fun _ _ => norm_nonneg _) (fun _ _ => hPan)
    calc _ ≤ M n * 1 :=
          mul_le_mul (hMb n _) hprod (Finset.prod_nonneg fun _ _ => norm_nonneg _) (hM0 n)
      _ = M n := mul_one _
  
  have hU := hCylOpen a c (3 * ρ)
  have hW := hExtOpen a c (9 / 4 * ρ)
  have hW0 : ∀ y, 9 / 4 * ρ < ‖coordPlaneProj a (y - c)‖ →
      (fun z => χ z * v z) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
    intro y hy
    filter_upwards [hW.mem_nhds hy] with z hz
    rw [hχ0 z (le_of_lt hz), zero_mul]
  refine ⟨fun y => χ y * v y, ?_, ?_, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : ‖coordPlaneProj a (y - c)‖ < 3 * ρ
    · exact hχS.contDiffAt.mul (hvS.contDiffAt (hU.mem_nhds hy))
    · exact contDiffAt_const.congr_of_eventuallyEq (hW0 y (by push_neg at hy; linarith))
  · intro y
    simp only [hχP, hvP]
  · intro y hy
    simp only [hχ1 y (le_of_lt hy), one_mul]
  · intro n y
    rcases le_or_gt ‖coordPlaneProj a (y - c)‖ (5 / 2 * ρ) with h | h
    · have hyU : y ∈ {y : E3 | ‖coordPlaneProj a (y - c)‖ < 3 * ρ} := by
        show ‖coordPlaneProj a (y - c)‖ < 3 * ρ
        linarith
      have hL := norm_iteratedFDerivWithin_mul_le hχS.contDiffOn hvS hU.uniqueDiffOn hyU
        (n := n) (WithTop.coe_le_coe.2 le_top)
      rw [iteratedFDerivWithin_of_isOpen n hU hyU] at hL
      refine hL.trans (Finset.sum_le_sum fun i _ => ?_)
      rw [iteratedFDerivWithin_of_isOpen i hU hyU, iteratedFDerivWithin_of_isOpen (n - i) hU hyU]
      have h1 := hχM i y
      have h2 := (hvB (n - i) y h).trans (le_abs_self _)
      have h3 : (0 : ℝ) ≤ (n.choose i : ℝ) := Nat.cast_nonneg _
      exact mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _)
        (mul_nonneg h3 (hM0 i))
    · have hev := (hW0 y (by linarith)).iteratedFDeriv ℝ n
      rw [hev.eq_of_nhds, iteratedFDeriv_zero_fun, Pi.zero_apply, norm_zero]
      exact Finset.sum_nonneg fun i _ =>
        mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hM0 i)) (abs_nonneg _)

theorem curvature_area_sheets [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Z : Set M) (hZ : IsCompact Z) (Λ : ℝ)
    (A : M → Set E3 → ℝ) :
    ∃ (J : ℕ) (pts : Fin J → M) (ρ : Fin J → ℝ) (L : ℕ) (Λn : ℕ → ℝ),
      (∀ j, 0 < ρ j) ∧
      (∀ j, Metric.closedBall (chartAt E3 (pts j) (pts j)) (10 * ρ j) ⊆
        (chartAt E3 (pts j)).target) ∧
      Z ⊆ (⋃ j, (chartAt E3 (pts j)).source ∩
        chartAt E3 (pts j) ⁻¹' Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j)) ∧
      ∀ Sig : Set M, IsCompact Sig → IsMinimalSurfaceSet g Sig → Sig ⊆ Z →
        HasCurvatureBound g Sig Λ → CoordAreaBound Sig A →
        ∀ j, MinimalSheetsNear g (pts j) (ρ j) L Λn Sig :=
by
  
  have hP5 : ∀ (a : Fin 3) (y z : E3),
      coordPlaneProj a (y - z) = coordPlaneProj a y - coordPlaneProj a z := by
    intro a y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hea : ∀ a : Fin 3, (e a) a = 1 := by
    intro a; simp [e]
  have hpa : ∀ (a : Fin 3) (q : E3), (coordPlaneProj a q) a = 0 := by
    intro a q
    simp [coordPlaneProj, e]
  have hP3 : ∀ (a : Fin 3) (q : E3),
      coordPlaneProj a (coordPlaneProj a q) = coordPlaneProj a q := by
    intro a q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP2 : ∀ (a : Fin 3) (q : E3) (t : ℝ),
      coordPlaneProj a (q + t • e a) = coordPlaneProj a q := by
    intro a q t
    simp only [coordPlaneProj, PiLp.add_apply, PiLp.smul_apply, hea, smul_eq_mul, mul_one,
      add_smul]
    abel
  have hP4 : ∀ (a : Fin 3) (q : E3) (t : ℝ), (coordPlaneProj a q + t • e a) a = t := by
    intro a q t
    simp only [PiLp.add_apply, PiLp.smul_apply, hpa, hea, smul_eq_mul, mul_one, zero_add]
  have hP1 : ∀ (a : Fin 3) (q c : E3) (t : ℝ),
      coordPlaneProj a (coordPlaneProj a q + t • e a - c) = coordPlaneProj a (q - c) := by
    intro a q c t
    rw [hP5, hP2, hP3, hP5]
  have hP6 : ∀ (a : Fin 3) (w : E3), ‖w‖ ≤ ‖coordPlaneProj a w‖ + |w a| := by
    intro a w
    have hw : w = coordPlaneProj a w + (w a) • e a := by
      simp [coordPlaneProj]
    calc ‖w‖ = ‖coordPlaneProj a w + (w a) • e a‖ := by rw [← hw]
      _ ≤ ‖coordPlaneProj a w‖ + ‖(w a) • e a‖ := norm_add_le _ _
      _ = ‖coordPlaneProj a w‖ + |w a| := by
        rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  have hP7 : ∀ (a : Fin 3) (w : E3), ‖coordPlaneProj a w‖ ≤ ‖w‖ := by
    intro a w
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    by_cases h : i = a
    · subst h
      rw [hpa]; simpa using sq_nonneg (w i)
    · simp [coordPlaneProj, e, EuclideanSpace.single_apply, h]
  have hcontP : ∀ a : Fin 3, Continuous (coordPlaneProj a) := by
    intro a
    unfold coordPlaneProj
    fun_prop
  have hCylOpen : ∀ (a : Fin 3) (c : E3) (r : ℝ),
      IsOpen {y : E3 | ‖coordPlaneProj a (y - c)‖ < r} := by
    intro a c r
    exact isOpen_lt ((hcontP a).comp (continuous_id.sub continuous_const)).norm continuous_const
  
  have hcong : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f₁ f₂ : E3 → ℝ) (z : E3),
      f₁ =ᶠ[𝓝 z] f₂ → levelMeanCurvCoord G f₁ z = levelMeanCurvCoord G f₂ z := by
    intro G f₁ f₂ z h
    have h1 : ∀ i, partialDeriv i f₁ z = partialDeriv i f₂ z := by
      intro i; unfold partialDeriv; rw [h.fderiv_eq]
    have h2 : ∀ i j, partialDeriv i (partialDeriv j f₁) z =
        partialDeriv i (partialDeriv j f₂) z := by
      intro i j
      have h' : partialDeriv j f₁ =ᶠ[𝓝 z] partialDeriv j f₂ :=
        (h.fderiv (𝕜 := ℝ)).mono (fun y hy => by simp only [partialDeriv, hy])
      unfold partialDeriv
      rw [show (fun y => fderiv ℝ f₁ y (e j)) = partialDeriv j f₁ from rfl,
        show (fun y => fderiv ℝ f₂ y (e j)) = partialDeriv j f₂ from rfl, h'.fderiv_eq]
    simp only [levelMeanCurvCoord, lapLoc, hessLoc, h1, h2]
  
  have hmono : ∀ (p : M) (ρ : ℝ) (L L' : ℕ) (Λ₁ Λ₂ : ℕ → ℝ) (Sig : Set M), L ≤ L' →
      (∀ n, Λ₁ n ≤ Λ₂ n) →
      MinimalSheetsNear g p ρ L Λ₁ Sig → MinimalSheetsNear g p ρ L' Λ₂ Sig := by
    intro p ρ L L' Λ₁ Λ₂ Sig hL hΛ h
    obtain ⟨a, l, u, hl, hs, hb, ho, hg, hc⟩ := h
    exact ⟨a, l, u, hl.trans hL, hs, fun i n y => (hb i n y).trans (hΛ n), ho, hg, hc⟩
  
  have hloc : ∀ p : M, ∃ (ρ : ℝ) (L : ℕ) (Λn : ℕ → ℝ), 0 < ρ ∧
      Metric.closedBall (chartAt E3 p p) (10 * ρ) ⊆ (chartAt E3 p).target ∧
      ∀ Sig : Set M, IsMinimalSurfaceSet g Sig → HasCurvatureBound g Sig Λ →
        CoordAreaBound Sig A → MinimalSheetsNear g p ρ L Λn Sig := by
    intro p
    
    obtain ⟨ε, hε, hεt⟩ := Metric.isOpen_iff.mp (chartAt E3 p).open_target (chartAt E3 p p)
      (mem_chart_target E3 p)
    have hR0 : 0 < ε / 2 := by linarith
    have hR0t : Metric.closedBall (chartAt E3 p p) (ε / 2) ⊆ (chartAt E3 p).target :=
      (Metric.closedBall_subset_ball (by linarith)).trans hεt
    
    obtain ⟨K, hK0, hK⟩ := graph_level_transfer g p (ε / 2) Λ hR0 hR0t
    obtain ⟨ρ, hρ, hρR, hS4⟩ := euclidean_sheet_structure (chartAt E3 p p) (ε / 2) K hR0 hK0
    have h10 : Metric.closedBall (chartAt E3 p p) (10 * ρ) ⊆ (chartAt E3 p).target :=
      (Metric.closedBall_subset_closedBall (by linarith)).trans hR0t
    obtain ⟨B, hB⟩ := mse_graph_higher_bounds (g.coeff (chartAt E3 p).symm)
      (chartAt E3 p).target (chartAt E3 p p) ρ K (chartAt E3 p).open_target hρ h10
      (fun i j => g.smooth p i j) (fun y i j => g.symm _ _ _)
      (fun y hy => coeff_chart_symm_posDef g p y hy)
    obtain ⟨B', hB'⟩ := planar_cutoff_extension (chartAt E3 p p) ρ hρ B
    refine ⟨ρ, ⌈max (A p (Metric.closedBall (chartAt E3 p p) (10 * ρ))) 0 / (4 * ρ ^ 2)⌉₊,
      B', hρ, h10, ?_⟩
    
    intro Sig hmin hcurv harea
    obtain ⟨hreg1, hreg2⟩ := chart_image_regular g p Sig hmin
    have hballR0 : Metric.ball (chartAt E3 p p) (ε / 2) ⊆ (chartAt E3 p).target :=
      Metric.ball_subset_closedBall.trans hR0t
    obtain ⟨a, l, v, hV1, hV2, hV3, hV4, hV5, hV6⟩ :=
      hS4 ((chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source))
        (fun z hz hzc => hreg1 z (hballR0 hz) hzc)
        (fun z hz => by
          obtain ⟨r, hr, F, -, hF1, hF2, hF3⟩ := hreg2 z hz.1
          exact ⟨r, hr, F, hF1, hF2, hF3⟩)
        (fun z hz b w r hr hw hpl hzb hgr hsl => by
          obtain ⟨⟨x, ⟨hxS, hxs⟩, rfl⟩, hzB⟩ := hz
          exact (hK Sig hmin hcurv x hxS hxs b w r hr hw hpl hzb hgr).1
            (Metric.ball_subset_closedBall hzB) hsl)
    
    have hMSEv : ∀ i (y : E3), ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 3 * ρ →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun z => z a - v i (coordPlaneProj a z)) (coordPlaneProj a y + v i y • e a) = 0 := by
      intro i y hy
      obtain ⟨x', ⟨hx'S, hx's⟩, hx'eq⟩ := (hV3 i y hy).2.2.2
      have hproj : coordPlaneProj a (chartAt E3 p x') = coordPlaneProj a y := by
        rw [hx'eq, hP2, hP3]
      have hpy : ‖coordPlaneProj a (coordPlaneProj a y - chartAt E3 p p)‖ < 3 * ρ := by
        rw [hP5, hP3, ← hP5]; exact hy
      have hcd : ContDiffAt ℝ 2 (v i) (coordPlaneProj a (chartAt E3 p x')) := by
        rw [hproj]
        exact ((hV2 i).contDiffAt ((hCylOpen a _ _).mem_nhds hpy)).of_le
          (WithTop.coe_le_coe.2 le_top)
      have hgr : ∀ y', ‖coordPlaneProj a (y' - chartAt E3 p x')‖ <
          3 * ρ - ‖coordPlaneProj a (y - chartAt E3 p p)‖ →
          coordPlaneProj a y' + v i (coordPlaneProj a y') • e a ∈
            (chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source) := by
        intro y' hy'
        have e1 : coordPlaneProj a (y' - chartAt E3 p p) =
            coordPlaneProj a (y' - chartAt E3 p x') +
              coordPlaneProj a (y - chartAt E3 p p) := by
          simp only [hP5, hproj]; abel
        have h3 : ‖coordPlaneProj a (y' - chartAt E3 p p)‖ < 3 * ρ := by
          rw [e1]
          linarith [norm_add_le (coordPlaneProj a (y' - chartAt E3 p x'))
            (coordPlaneProj a (y - chartAt E3 p p))]
        rw [hV1]; exact (hV3 i y' h3).2.2.2
      have hzb : (chartAt E3 p x') a = v i (coordPlaneProj a (chartAt E3 p x')) := by
        rw [hproj, hV1, hx'eq, hP4]
      have h := (hK Sig hmin hcurv x' hx'S hx's a (v i)
        (3 * ρ - ‖coordPlaneProj a (y - chartAt E3 p p)‖) (by linarith) hcd (hV1 i) hzb hgr).2
      rw [hx'eq] at h
      exact h
    
    have hhb : ∀ i (n : ℕ) (y : E3), ‖coordPlaneProj a (y - chartAt E3 p p)‖ ≤ 5 / 2 * ρ →
        ‖iteratedFDeriv ℝ n (v i) y‖ ≤ B n := fun i =>
      hB a (v i) (hV1 i) (hV2 i) (fun y hy => by
        obtain ⟨h1, h2, h3, -⟩ := hV3 i y hy
        refine ⟨by rw [hV1]; exact h3, h1, h2, ?_⟩
        rw [hV1]; exact hMSEv i y hy)
    have hu : ∀ i, ∃ u : E3 → ℝ, ContDiff ℝ ∞ u ∧ (∀ y, u (coordPlaneProj a y) = u y) ∧
        (∀ y, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ → u y = v i y) ∧
        ∀ (n : ℕ) (y : E3), ‖iteratedFDeriv ℝ n u y‖ ≤ B' n :=
      fun i => hB' a (v i) (hV1 i) (hV2 i) (hhb i)
    choose u hu1 hu2 hu3 hu4 using hu
    
    have hcount := sheet_count_area (chartAt E3 p p) a ρ hρ l v
      ((chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source) ∩
        Metric.closedBall (chartAt E3 p p) (10 * ρ))
      (fun i => (hV2 i).continuousOn.mono (fun y hy => by
        have hy' : ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ := hy
        show ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 3 * ρ
        linarith))
      (fun i i' hii' y hy => by
        rw [hV1, hV1]; exact hV5 i i' hii' y (by linarith))
      (fun i y hy => by
        rw [hV1]
        refine ⟨(hV3 i y (by linarith)).2.2.2, ?_⟩
        rw [Metric.mem_closedBall, dist_eq_norm]
        have h1 := hP6 a (coordPlaneProj a y + v i y • e a - chartAt E3 p p)
        rw [hP1] at h1
        have h2 : (coordPlaneProj a y + v i y • e a - chartAt E3 p p) a =
            v i y - (chartAt E3 p p) a := by
          rw [PiLp.sub_apply, hP4]
        rw [h2] at h1
        have h3 := hV4 i y hy
        linarith)
    have harea' := harea p (Metric.closedBall (chartAt E3 p p) (10 * ρ))
      (isCompact_closedBall _ _) h10
    have hlL : l ≤ ⌈max (A p (Metric.closedBall (chartAt E3 p p) (10 * ρ))) 0 /
        (4 * ρ ^ 2)⌉₊ := by
      have h4 : 0 < 4 * ρ ^ 2 := by positivity
      have h3 : ENNReal.ofReal ((l : ℝ) * (4 * ρ ^ 2)) ≤
          ENNReal.ofReal (max (A p (Metric.closedBall (chartAt E3 p p) (10 * ρ))) 0) := by
        rw [ENNReal.ofReal_mul (Nat.cast_nonneg l), ENNReal.ofReal_natCast]
        exact (hcount.trans harea').trans (ENNReal.ofReal_le_ofReal (le_max_left _ _))
      rw [ENNReal.ofReal_le_ofReal_iff (le_max_right _ _)] at h3
      have h5 : (l : ℝ) ≤ max (A p (Metric.closedBall (chartAt E3 p p) (10 * ρ))) 0 /
          (4 * ρ ^ 2) := by
        rw [le_div_iff₀ h4]; exact h3
      exact_mod_cast h5.trans (Nat.le_ceil _)
    
    have huv : ∀ i (y : E3), ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
        u i (coordPlaneProj a y) = v i y := by
      intro i y hy; rw [hu2, hu3 i y hy]
    refine ⟨a, l, u, hlL, hu1, hu4, ?_, ?_, ?_⟩
    · intro i i' hii' y hy
      rw [huv i y hy, huv i' y hy]
      exact hV5 i i' hii' y (by linarith)
    · intro i y hy
      rw [huv i y hy]
      refine ⟨hV4 i y hy, ?_, ?_⟩
      · obtain ⟨x'', ⟨hx''S, hx''s⟩, hx''eq⟩ := (hV3 i y (by linarith)).2.2.2
        rw [← hx''eq, (chartAt E3 p).left_inv hx''s]
        exact hx''S
      · have hpt : ‖coordPlaneProj a (coordPlaneProj a y + v i y • e a - chartAt E3 p p)‖ <
            2 * ρ := by
          rw [hP1]; exact hy
        have hev : (fun z => z a - u i (coordPlaneProj a z)) =ᶠ[𝓝 (coordPlaneProj a y + v i y • e a)]
            (fun z => z a - v i (coordPlaneProj a z)) := by
          filter_upwards [(hCylOpen a (chartAt E3 p p) (2 * ρ)).mem_nhds hpt] with z hz
          rw [hu2, hu3 i z hz, hV1]
        rw [hcong _ _ _ _ hev]
        exact hMSEv i y (by linarith)
    · intro x hx hxs hxb
      have hz : ‖coordPlaneProj a (chartAt E3 p x - chartAt E3 p p)‖ < 2 * ρ := by
        have h1 := hP7 a (chartAt E3 p x - chartAt E3 p p)
        rw [Metric.mem_ball, dist_eq_norm] at hxb
        linarith
      obtain ⟨i, hi⟩ := hV6 (chartAt E3 p x) ⟨x, ⟨hx, hxs⟩, rfl⟩ hxb
      exact ⟨i, by rw [hi, hu2, hu3 i _ hz]⟩
  
  choose ρf Lf Λf hρf hballf hsheetf using hloc
  obtain ⟨t, ht⟩ := hZ.elim_finite_subcover
    (fun x : M => (chartAt E3 x).source ∩ chartAt E3 x ⁻¹' Metric.ball (chartAt E3 x x) (ρf x))
    (fun x => (chartAt E3 x).isOpen_inter_preimage Metric.isOpen_ball)
    (fun z _ => Set.mem_iUnion.2 ⟨z, mem_chart_source E3 z, Metric.mem_ball_self (hρf z)⟩)
  refine ⟨t.card, fun j => (t.equivFin.symm j).1, fun j => ρf (t.equivFin.symm j).1,
    ∑ j, Lf (t.equivFin.symm j).1, fun n => ∑ j, |Λf (t.equivFin.symm j).1 n|,
    fun j => hρf _, fun j => hballf _, ?_, ?_⟩
  · intro z hz
    have hz' := ht hz
    simp only [Set.mem_iUnion] at hz'
    obtain ⟨i, hi, hzi⟩ := hz'
    refine Set.mem_iUnion.2 ⟨t.equivFin ⟨i, hi⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hzi
  · intro Sig _ hmin _ hcurv harea j
    refine hmono _ _ _ _ _ _ _ ?_ ?_ (hsheetf _ Sig hmin hcurv harea)
    · exact Finset.single_le_sum (f := fun j => Lf (t.equivFin.symm j).1)
        (fun j _ => Nat.zero_le _) (Finset.mem_univ j)
    · intro n
      exact (le_abs_self _).trans (Finset.single_le_sum
        (f := fun j => |Λf (t.equivFin.symm j).1 n|) (fun j _ => abs_nonneg _)
        (Finset.mem_univ j))

theorem smooth_arzela_ascoli_family {ι : Type*} [Fintype ι] (f : ℕ → ι → E3 → ℝ) (B : ℕ → ℝ)
    (hf : ∀ m i, ContDiff ℝ ∞ (f m i))
    (hb : ∀ m i (n : ℕ) (y : E3), ‖iteratedFDeriv ℝ n (f m i) y‖ ≤ B n) :
    ∃ (φ : ℕ → ℕ) (F : ι → E3 → ℝ), StrictMono φ ∧ (∀ i, ContDiff ℝ ∞ (F i)) ∧
      (∀ i (y : E3), Filter.Tendsto (fun k => f (φ k) i y) Filter.atTop (𝓝 (F i y))) ∧
      ∀ i (n : ℕ) (y : E3), Filter.Tendsto (fun k => iteratedFDeriv ℝ n (f (φ k) i) y)
        Filter.atTop (𝓝 (iteratedFDeriv ℝ n (F i) y)) :=
by
  classical
  
  have s1 : ∀ (g : E3 → ℝ), ContDiff ℝ ∞ g → ∀ (n : ℕ) (C : ℝ),
      (∀ y : E3, ‖iteratedFDeriv ℝ (n + 1) g y‖ ≤ C) →
      ∀ y z : E3, ‖iteratedFDeriv ℝ n g z - iteratedFDeriv ℝ n g y‖ ≤ C * ‖z - y‖ := by
    intro g hg n C hC y z
    have hd : Differentiable ℝ (iteratedFDeriv ℝ n g) :=
      hg.differentiable_iteratedFDeriv (by exact_mod_cast ENat.coe_lt_top n)
    refine Convex.norm_image_sub_le_of_norm_fderiv_le (fun x _ => hd x) (fun x _ => ?_)
      convex_univ (Set.mem_univ y) (Set.mem_univ z)
    rw [norm_fderiv_iteratedFDeriv]
    exact hC x
  
  have s2 : ∀ (g : E3 → ℝ), ContDiff ℝ ∞ g → ∀ (n : ℕ) (C : ℝ),
      (∀ y : E3, ‖iteratedFDeriv ℝ (n + 2) g y‖ ≤ C) → ∀ (y h : E3),
      ‖iteratedFDeriv ℝ n g (y + h) - iteratedFDeriv ℝ n g y -
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) g y)) h‖ ≤ C * ‖h‖ ^ 2 := by
    intro g hg n C hC y h
    have hC0 : 0 ≤ C := le_trans (norm_nonneg _) (hC 0)
    have hL1 := s1 g hg (n + 1) C hC
    have hd : Differentiable ℝ (iteratedFDeriv ℝ n g) :=
      hg.differentiable_iteratedFDeriv (by exact_mod_cast ENat.coe_lt_top n)
    have hfd : ∀ z, fderiv ℝ (iteratedFDeriv ℝ n g) z =
        continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) g z) := fun z => by
      rw [fderiv_iteratedFDeriv]; rfl
    set A := continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) g y) with hA
    have hψ : ∀ z, HasFDerivAt (fun z => iteratedFDeriv ℝ n g z - A z)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) g z) - A) z := by
      intro z
      have h1 := (hd z).hasFDerivAt
      rw [hfd z] at h1
      exact h1.sub A.hasFDerivAt
    have hbound : ∀ z ∈ Metric.closedBall y ‖h‖,
        ‖continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) g z) - A‖ ≤ C * ‖h‖ := by
      intro z hz
      rw [hA, ← LinearIsometryEquiv.map_sub, LinearIsometryEquiv.norm_map]
      calc _ ≤ C * ‖z - y‖ := hL1 y z
        _ ≤ C * ‖h‖ := mul_le_mul_of_nonneg_left (by rwa [← dist_eq_norm]) hC0
    have hyh : y + h ∈ Metric.closedBall y ‖h‖ := by
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
    have key := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le
      (fun z _ => (hψ z).hasFDerivWithinAt) hbound (convex_closedBall y ‖h‖)
      (Metric.mem_closedBall_self (norm_nonneg h)) hyh
    have e : (iteratedFDeriv ℝ n g (y + h) - A (y + h)) - (iteratedFDeriv ℝ n g y - A y) =
        iteratedFDeriv ℝ n g (y + h) - iteratedFDeriv ℝ n g y - A h := by
      rw [map_add]; abel
    simp only at key
    rw [e, add_sub_cancel_left] at key
    calc _ ≤ C * ‖h‖ * ‖h‖ := key
      _ = C * ‖h‖ ^ 2 := by ring
  
  have s4 : ∀ (n : ℕ) (g : ℕ → E3 → ContinuousMultilinearMap ℝ (fun _ : Fin n => E3) ℝ) (C : ℝ),
      (∀ k (y z : E3), ‖g k z - g k y‖ ≤ C * ‖z - y‖) → ∀ (Q : Set E3), Dense Q →
      (∀ q ∈ Q, ∃ L, Filter.Tendsto (fun k => g k q) Filter.atTop (𝓝 L)) →
      ∀ y : E3, ∃ L, Filter.Tendsto (fun k => g k y) Filter.atTop (𝓝 L) := by
    intro n g C hL Q hQ hconv y
    apply cauchySeq_tendsto_of_complete
    rw [Metric.cauchySeq_iff]
    intro ε hε
    have hDpos : 0 < max C 0 + 1 := by have := le_max_right C 0; linarith
    have hL' : ∀ k (y z : E3), dist (g k z) (g k y) ≤ (max C 0 + 1) * dist z y := by
      intro k y z
      rw [dist_eq_norm, dist_eq_norm]
      calc _ ≤ C * ‖z - y‖ := hL k y z
        _ ≤ (max C 0 + 1) * ‖z - y‖ :=
          mul_le_mul_of_nonneg_right (by linarith [le_max_left C 0]) (norm_nonneg _)
    obtain ⟨q, hqQ, hq⟩ := hQ.exists_dist_lt y (show 0 < ε / (3 * (max C 0 + 1)) by positivity)
    obtain ⟨L, hLq⟩ := hconv q hqQ
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.1 hLq.cauchySeq (ε / 3) (by positivity)
    refine ⟨N, fun m hm n hn => ?_⟩
    have h1 := hL' m q y
    have h2 := hL' n q y
    have h3 := hN m hm n hn
    have hDq : (max C 0 + 1) * dist y q < ε / 3 := by
      calc (max C 0 + 1) * dist y q < (max C 0 + 1) * (ε / (3 * (max C 0 + 1))) :=
            mul_lt_mul_of_pos_left hq hDpos
        _ = ε / 3 := by field_simp
    calc dist (g m y) (g n y) ≤ dist (g m y) (g m q) + dist (g m q) (g n q) +
          dist (g n q) (g n y) := dist_triangle4 _ _ _ _
      _ < ε := by rw [dist_comm (g n q)]; linarith
  
  have s5 : ∀ (n : ℕ) (G : E3 → ContinuousMultilinearMap ℝ (fun _ : Fin n => E3) ℝ)
      (A : E3 →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin n => E3) ℝ) (y : E3) (C : ℝ),
      (∀ h : E3, ‖G (y + h) - G y - A h‖ ≤ C * ‖h‖ ^ 2) → HasFDerivAt G A y := by
    intro n G A y C hC
    rw [hasFDerivAt_iff_isLittleO_nhds_zero]
    have h1 : (fun h => G (y + h) - G y - A h) =O[𝓝 0] (fun h : E3 => ‖h‖ ^ 2) :=
      Asymptotics.IsBigO.of_bound C (Filter.Eventually.of_forall fun h => by
        rw [Real.norm_of_nonneg (by positivity)]; exact hC h)
    exact h1.trans_isLittleO (Asymptotics.isLittleO_norm_pow_id (by norm_num))
  
  have s6 : ∀ (G : (n : ℕ) → E3 → ContinuousMultilinearMap ℝ (fun _ : Fin n => E3) ℝ),
      (∀ (n : ℕ) (y : E3), HasFDerivAt (G n)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ (G (n + 1) y)) y) →
      ContDiff ℝ ∞ (fun y => G 0 y 0) ∧
        ∀ n : ℕ, iteratedFDeriv ℝ n (fun y => G 0 y 0) = G n := by
    intro G hG
    have claim : ∀ n : ℕ, iteratedFDeriv ℝ n (fun y => G 0 y 0) = G n := by
      intro n
      induction n with
      | zero =>
        funext y; ext m
        rw [iteratedFDeriv_zero_apply]
        congr 1; exact Subsingleton.elim _ _
      | succ n ih =>
        rw [iteratedFDeriv_succ_eq_comp_left, ih]
        funext y
        simp only [Function.comp_apply]
        rw [(hG n y).fderiv]
        exact LinearIsometryEquiv.symm_apply_apply _ _
    refine ⟨?_, claim⟩
    apply contDiff_of_differentiable_iteratedFDeriv
    intro m _
    rw [claim m]
    exact fun y => (hG m y).differentiableAt
  
  obtain ⟨Q, hQc, hQd⟩ := TopologicalSpace.exists_countable_dense E3
  haveI : Countable Q := hQc.to_subtype
  
  have hcpt : ∀ a : ℕ × ι × Q, IsCompact (Metric.closedBall
      (0 : ContinuousMultilinearMap ℝ (fun _ : Fin a.1 => E3) ℝ) (B a.1)) := by
    intro a
    haveI : FiniteDimensional ℝ (ContinuousMultilinearMap ℝ (fun _ : Fin a.1 => E3) ℝ) :=
      FiniteDimensional.of_injective (ContinuousMultilinearMap.toMultilinearMapLinear (R' := ℝ)
        (A := ℝ) (M₁ := fun _ : Fin a.1 => E3) (M₂ := ℝ))
        ContinuousMultilinearMap.toMultilinearMap_injective
    haveI : ProperSpace (ContinuousMultilinearMap ℝ (fun _ : Fin a.1 => E3) ℝ) :=
      FiniteDimensional.proper_real _
    exact isCompact_closedBall _ _
  have hK := isCompact_univ_pi hcpt
  obtain ⟨p, -, φ, hφ, hlim⟩ := hK.tendsto_subseq
    (x := fun m (a : ℕ × ι × Q) => iteratedFDeriv ℝ a.1 (f m a.2.1) (a.2.2 : E3))
    (fun m => Set.mem_univ_pi.2 fun a => mem_closedBall_zero_iff.2 (hb m a.2.1 a.1 a.2.2))
  have hQconv : ∀ a : ℕ × ι × Q, Tendsto
      (fun k => iteratedFDeriv ℝ a.1 (f (φ k) a.2.1) (a.2.2 : E3)) atTop (𝓝 (p a)) :=
    fun a => tendsto_pi_nhds.1 hlim a
  have hconv : ∀ (i : ι) (n : ℕ) (y : E3),
      ∃ L : ContinuousMultilinearMap ℝ (fun _ : Fin n => E3) ℝ,
      Tendsto (fun k => iteratedFDeriv ℝ n (f (φ k) i) y) atTop (𝓝 L) := by
    intro i n
    exact s4 n (fun k => iteratedFDeriv ℝ n (f (φ k) i)) (B (n + 1))
      (fun k y z => s1 (f (φ k) i) (hf _ _) n (B (n + 1)) (fun y => hb (φ k) i (n + 1) y) y z)
      Q hQd (fun q hq => ⟨_, hQconv (n, i, ⟨q, hq⟩)⟩)
  choose G hG using hconv
  have hder : ∀ i n y, HasFDerivAt (G i n)
      (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ (G i (n + 1) y)) y := by
    intro i n y
    apply s5 n (G i n) _ y (B (n + 2))
    intro h
    have hc : Continuous (fun v : ContinuousMultilinearMap ℝ (fun _ : Fin (n + 1) => E3) ℝ =>
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ v) h) :=
      (continuous_eval_const h).comp
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ).continuous
    have hu : Tendsto (fun k => iteratedFDeriv ℝ n (f (φ k) i) (y + h) -
        iteratedFDeriv ℝ n (f (φ k) i) y -
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (n + 1) => E3) ℝ
          (iteratedFDeriv ℝ (n + 1) (f (φ k) i) y)) h) atTop
        (𝓝 (G i n (y + h) - G i n y - (continuousMultilinearCurryLeftEquiv ℝ
          (fun _ : Fin (n + 1) => E3) ℝ (G i (n + 1) y)) h)) :=
      ((hG i n (y + h)).sub (hG i n y)).sub ((hc.tendsto _).comp (hG i (n + 1) y))
    exact le_of_tendsto' hu.norm
      (fun k => s2 (f (φ k) i) (hf _ _) n (B (n + 2)) (hb (φ k) i (n + 2)) y h)
  have hsm := fun i => s6 (G i) (hder i)
  refine ⟨φ, fun i y => G i 0 y 0, hφ, fun i => (hsm i).1, ?_, ?_⟩
  · intro i y
    have hc : Continuous (fun v : ContinuousMultilinearMap ℝ (fun _ : Fin 0 => E3) ℝ => v 0) :=
      continuous_eval_const _
    have h1 := (hc.tendsto _).comp (hG i 0 y)
    refine h1.congr (fun k => ?_)
    simp only [Function.comp_apply, iteratedFDeriv_zero_apply]
  · intro i n y
    rw [(hsm i).2 n]
    exact hG i n y

theorem mse_graph_limit [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p : M) (a : Fin 3)
    (ρ : ℝ) (hρ : 0 < ρ)
    (hball : Metric.closedBall (chartAt E3 p p) (10 * ρ) ⊆ (chartAt E3 p).target)
    (v : ℕ → E3 → ℝ) (V : E3 → ℝ) (hv : ∀ k, ContDiff ℝ ∞ (v k)) (hV : ContDiff ℝ ∞ V)
    (hconv : ∀ n : ℕ, n ≤ 2 → ∀ y : E3, Filter.Tendsto (fun k => iteratedFDeriv ℝ n (v k) y)
      Filter.atTop (𝓝 (iteratedFDeriv ℝ n V y)))
    (hsheet : ∀ k (y : E3), ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      |v k (coordPlaneProj a y) - (chartAt E3 p p) a| < 8 * ρ ∧
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun z => z a - v k (coordPlaneProj a z))
        (coordPlaneProj a y + v k (coordPlaneProj a y) • e a) = 0) :
    ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun z => z a - V (coordPlaneProj a z))
        (coordPlaneProj a y + V (coordPlaneProj a y) • e a) = 0 :=
by
  intro y hy
  
  
  have hPDlem : ∀ y' : E3, y' ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y').PosDef := by
    classical
    intro y' hy'
    have hq : (chartAt E3 p).symm y' ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy'
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y' :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy'
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y') :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y' =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y')).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y') := mfderiv_comp y' hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y' =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y' := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy'] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y')
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y' w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y' w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro ξ hξ
      have hvx : (∑ i, ξ i • e i : E3) ≠ 0 := by
        intro h0
        apply hξ
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y') _ hDv
      have key : star ξ ⬝ᵥ (g.coeff (chartAt E3 p).symm y').mulVec ξ =
          g.g ((chartAt E3 p).symm y')
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y' (∑ i, ξ i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y' (∑ i, ξ i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  let Pl : E3 →ₗ[ℝ] E3 :=
    { toFun := coordPlaneProj a
      map_add' := fun x y => by
        simp only [coordPlaneProj, PiLp.add_apply, add_smul]; abel
      map_smul' := fun r x => by
        simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, RingHom.id_apply, smul_sub,
          mul_smul] }
  let Pc : E3 →L[ℝ] E3 := LinearMap.toContinuousLinearMap Pl
  have hPc : ∀ w, Pc w = coordPlaneProj a w := fun w => rfl
  let πl : E3 →ₗ[ℝ] ℝ :=
    { toFun := fun z => z a
      map_add' := fun x y => by simp
      map_smul' := fun r x => by simp }
  let πc : E3 →L[ℝ] ℝ := LinearMap.toContinuousLinearMap πl
  have hπc : ∀ w, πc w = w a := fun w => rfl
  
  have hea : (e a) a = 1 := by simp [e]
  have hPP : ∀ (w : E3) (t : ℝ),
      coordPlaneProj a (coordPlaneProj a w + t • e a) = coordPlaneProj a w := by
    intro w t
    have h1 : (coordPlaneProj a w + t • e a) a = t := by simp [coordPlaneProj, e]
    show (coordPlaneProj a w + t • e a) - ((coordPlaneProj a w + t • e a) a) • e a = _
    rw [h1, add_sub_cancel_right]
  have hPe : coordPlaneProj a (e a) = 0 := by
    show e a - ((e a) a) • e a = 0
    rw [hea, one_smul, sub_self]
  
  have hdiff : ∀ u : E3 → ℝ, ContDiff ℝ ∞ u →
      Differentiable ℝ u ∧ Differentiable ℝ (fderiv ℝ u) := by
    intro u hu
    have hu2 : ContDiff ℝ 2 u := hu.of_le (by norm_cast)
    exact ⟨hu2.differentiable (by norm_num),
      (hu2.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)⟩
  
  have hpd1 : ∀ u : E3 → ℝ, Differentiable ℝ u → ∀ (w : E3) (i : Fin 3),
      partialDeriv i (fun z => z a - u (coordPlaneProj a z)) w =
        (e i) a - fderiv ℝ u (coordPlaneProj a w) (coordPlaneProj a (e i)) := by
    intro u hu w i
    have h : HasFDerivAt (fun z : E3 => z a - u (coordPlaneProj a z))
        (πc - (fderiv ℝ u (coordPlaneProj a w)).comp Pc) w :=
      πc.hasFDerivAt.sub ((hu (Pc w)).hasFDerivAt.comp w Pc.hasFDerivAt)
    unfold partialDeriv
    rw [h.fderiv]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.comp_apply, hPc, hπc]
  have hpd2 : ∀ u : E3 → ℝ, Differentiable ℝ u → Differentiable ℝ (fderiv ℝ u) →
      ∀ (z : E3) (i j : Fin 3),
      partialDeriv i (partialDeriv j (fun w => w a - u (coordPlaneProj a w))) z =
        -(fderiv ℝ (fderiv ℝ u) (coordPlaneProj a z) (coordPlaneProj a (e i))
          (coordPlaneProj a (e j))) := by
    intro u hu hdu z i j
    have hfun : partialDeriv j (fun w => w a - u (coordPlaneProj a w)) =
        fun w => (e j) a - fderiv ℝ u (Pc w) (coordPlaneProj a (e j)) :=
      funext fun w => hpd1 u hu w j
    rw [hfun]
    have hc : HasFDerivAt (fun w => fderiv ℝ u (Pc w))
        ((fderiv ℝ (fderiv ℝ u) (Pc z)).comp Pc) z :=
      (hdu (Pc z)).hasFDerivAt.comp z Pc.hasFDerivAt
    have hd := hc.clm_apply (hasFDerivAt_const (coordPlaneProj a (e j)) z)
    have h := hd.const_sub ((e j) a)
    unfold partialDeriv
    rw [h.fderiv]
    simp [hPc]
  
  set x := coordPlaneProj a y with hx
  have hPP' : ∀ t : ℝ, coordPlaneProj a (x + t • e a) = x := fun t => hPP y t
  
  have hD0 : Tendsto (fun k => v k x) atTop (𝓝 (V x)) := by
    have h := ((continuous_eval_const (fun _ : Fin 0 => (0 : E3))).tendsto _).comp
      (hconv 0 (by norm_num) x)
    simpa only [Function.comp_def, iteratedFDeriv_zero_apply] using h
  have hD1 : ∀ h : E3, Tendsto (fun k => fderiv ℝ (v k) x h) atTop (𝓝 (fderiv ℝ V x h)) := by
    intro h
    have h' := ((continuous_eval_const (fun _ : Fin 1 => h)).tendsto _).comp
      (hconv 1 (by norm_num) x)
    simpa only [Function.comp_def, iteratedFDeriv_one_apply] using h'
  have hD2 : ∀ h₁ h₂ : E3, Tendsto (fun k => fderiv ℝ (fderiv ℝ (v k)) x h₁ h₂) atTop
      (𝓝 (fderiv ℝ (fderiv ℝ V) x h₁ h₂)) := by
    intro h₁ h₂
    have h' := ((continuous_eval_const ![h₁, h₂]).tendsto _).comp (hconv 2 (by norm_num) x)
    simpa only [Function.comp_def, iteratedFDeriv_two_apply, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons] using h'
  
  have hslab : |V x - (chartAt E3 p p) a| ≤ 8 * ρ :=
    le_of_tendsto' ((hD0.sub_const _).abs) (fun k => (hsheet k y hy).1.le)
  have hz : Tendsto (fun k => x + v k x • e a) atTop (𝓝 (x + V x • e a)) :=
    tendsto_const_nhds.add (hD0.smul_const (e a))
  have hz0T : x + V x • e a ∈ (chartAt E3 p).target := by
    apply hball
    rw [Metric.mem_closedBall, dist_eq_norm]
    have heq : x + V x • e a - chartAt E3 p p =
        coordPlaneProj a (y - chartAt E3 p p) + (V x - (chartAt E3 p p) a) • e a := by
      rw [hx]
      simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
      abel
    rw [heq]
    have hne : ‖e a‖ = 1 := by simp [e]
    calc ‖coordPlaneProj a (y - chartAt E3 p p) + (V x - (chartAt E3 p p) a) • e a‖
        ≤ ‖coordPlaneProj a (y - chartAt E3 p p)‖ + ‖(V x - (chartAt E3 p p) a) • e a‖ :=
          norm_add_le _ _
      _ = ‖coordPlaneProj a (y - chartAt E3 p p)‖ + |V x - (chartAt E3 p p) a| := by
          rw [norm_smul, hne, mul_one, Real.norm_eq_abs]
      _ ≤ 10 * ρ := by linarith
  
  set G := g.coeff (chartAt E3 p).symm with hGdef
  have hTo : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hsm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (chartAt E3 p).target :=
    fun i j => g.smooth p i j
  have hnhds : (chartAt E3 p).target ∈ 𝓝 (x + V x • e a) := hTo.mem_nhds hz0T
  have hGt : ∀ i j : Fin 3, Tendsto (fun k => G (x + v k x • e a) i j) atTop
      (𝓝 (G (x + V x • e a) i j)) :=
    fun i j => ((hsm i j).continuousOn.continuousAt hnhds).tendsto.comp hz
  have hdGt : ∀ i j l : Fin 3, Tendsto (fun k => partialDeriv l (fun w => G w i j) (x + v k x • e a))
      atTop (𝓝 (partialDeriv l (fun w => G w i j) (x + V x • e a))) := by
    intro i j l
    have hc := (((hsm i j).continuousOn_fderiv_of_isOpen hTo
      (by exact_mod_cast le_top)).continuousAt hnhds).tendsto.comp hz
    exact ((continuous_eval_const (e l)).tendsto _).comp hc
  have hPD : (G (x + V x • e a)).PosDef := hPDlem _ hz0T
  have hdet : (G (x + V x • e a)).det ≠ 0 := hPD.det_pos.ne'
  have hGm : Tendsto (fun k => G (x + v k x • e a)) atTop (𝓝 (G (x + V x • e a))) :=
    tendsto_pi_nhds.2 fun i => tendsto_pi_nhds.2 fun j => hGt i j
  have hinvc : ContinuousAt Inv.inv (G (x + V x • e a)) := by
    apply continuousAt_matrix_inv
    rw [Ring.inverse_eq_inv']
    exact continuousAt_inv₀ hdet
  have hGinvm := hinvc.tendsto.comp hGm
  have hGinv : ∀ i j : Fin 3, Tendsto (fun k => (G (x + v k x • e a))⁻¹ i j) atTop
      (𝓝 ((G (x + V x • e a))⁻¹ i j)) :=
    fun i j => tendsto_pi_nhds.1 (tendsto_pi_nhds.1 hGinvm i) j
  
  have hvd : ∀ k, Differentiable ℝ (v k) ∧ Differentiable ℝ (fderiv ℝ (v k)) :=
    fun k => hdiff (v k) (hv k)
  have hVd := hdiff V hV
  have h1 : ∀ i : Fin 3, Tendsto
      (fun k => partialDeriv i (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a))
      atTop (𝓝 (partialDeriv i (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a))) := by
    intro i
    rw [hpd1 V hVd.1, hPP']
    refine (tendsto_const_nhds.sub (hD1 (coordPlaneProj a (e i)))).congr (fun k => ?_)
    rw [hpd1 (v k) (hvd k).1, hPP']
  have h2 : ∀ i j : Fin 3, Tendsto
      (fun k => partialDeriv i (partialDeriv j (fun z => z a - v k (coordPlaneProj a z)))
        (x + v k x • e a))
      atTop (𝓝 (partialDeriv i (partialDeriv j (fun z => z a - V (coordPlaneProj a z)))
        (x + V x • e a))) := by
    intro i j
    rw [hpd2 V hVd.1 hVd.2, hPP']
    refine (hD2 _ _).neg.congr (fun k => ?_)
    rw [hpd2 (v k) (hvd k).1 (hvd k).2, hPP']
  
  have hchr : ∀ m i j : Fin 3, Tendsto (fun k => christoffel G m i j (x + v k x • e a)) atTop
      (𝓝 (christoffel G m i j (x + V x • e a))) := by
    intro m i j
    unfold christoffel
    exact tendsto_const_nhds.mul (tendsto_finset_sum _ fun l _ =>
      (hGinv m l).mul (((hdGt j l i).add (hdGt i l j)).sub (hdGt i j l)))
  have hhess : ∀ i j : Fin 3, Tendsto
      (fun k => hessLoc G (fun z => z a - v k (coordPlaneProj a z)) i j (x + v k x • e a))
      atTop (𝓝 (hessLoc G (fun z => z a - V (coordPlaneProj a z)) i j (x + V x • e a))) := by
    intro i j
    unfold hessLoc
    exact (h2 i j).sub (tendsto_finset_sum _ fun m _ => (hchr m i j).mul (h1 m))
  have hlap : Tendsto
      (fun k => lapLoc G (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a))
      atTop (𝓝 (lapLoc G (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a))) := by
    unfold lapLoc
    exact tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ =>
      (hGinv i j).mul (hhess i j)
  have hN : Tendsto (fun k => ∑ i : Fin 3, ∑ j : Fin 3, (G (x + v k x • e a))⁻¹ i j *
        partialDeriv i (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a) *
        partialDeriv j (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a))
      atTop (𝓝 (∑ i : Fin 3, ∑ j : Fin 3, (G (x + V x • e a))⁻¹ i j *
        partialDeriv i (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a) *
        partialDeriv j (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a))) :=
    tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ =>
      ((hGinv i j).mul (h1 i)).mul (h1 j)
  have hnum : Tendsto (fun k => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a' : Fin 3, ∑ b : Fin 3,
        (G (x + v k x • e a))⁻¹ i a' *
          partialDeriv a' (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a) *
        ((G (x + v k x • e a))⁻¹ j b *
          partialDeriv b (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a)) *
        hessLoc G (fun z => z a - v k (coordPlaneProj a z)) i j (x + v k x • e a))
      atTop (𝓝 (∑ i : Fin 3, ∑ j : Fin 3, ∑ a' : Fin 3, ∑ b : Fin 3,
        (G (x + V x • e a))⁻¹ i a' *
          partialDeriv a' (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a) *
        ((G (x + V x • e a))⁻¹ j b *
          partialDeriv b (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a)) *
        hessLoc G (fun z => z a - V (coordPlaneProj a z)) i j (x + V x • e a))) :=
    tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ =>
      tendsto_finset_sum _ fun a' _ => tendsto_finset_sum _ fun b _ =>
        (((hGinv i a').mul (h1 a')).mul ((hGinv j b).mul (h1 b))).mul (hhess i j)
  
  have hξ : (fun i => partialDeriv i (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a))
      ≠ 0 := by
    intro h
    have h' := congrFun h a
    simp only [Pi.zero_apply, hpd1 V hVd.1, hPP', hPe, map_zero, hea, sub_zero,
      one_ne_zero] at h'
  have hN0 : 0 < ∑ i : Fin 3, ∑ j : Fin 3, (G (x + V x • e a))⁻¹ i j *
        partialDeriv i (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a) *
        partialDeriv j (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a) := by
    have h := hPD.inv.dotProduct_mulVec_pos hξ
    simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum] at h
    refine lt_of_lt_of_eq h (Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_)
    ring
  have hsq : Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G (x + V x • e a))⁻¹ i j *
        partialDeriv i (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a) *
        partialDeriv j (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a)) ≠ 0 :=
    (Real.sqrt_pos.2 hN0).ne'
  
  have key : Tendsto
      (fun k => levelMeanCurvCoord G (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a))
      atTop (𝓝 (levelMeanCurvCoord G (fun z => z a - V (coordPlaneProj a z)) (x + V x • e a))) :=
    (hlap.div hN.sqrt hsq).sub (hnum.div (hN.sqrt.pow 3) (pow_ne_zero 3 hsq))
  have hzero : ∀ k, levelMeanCurvCoord G (fun z => z a - v k (coordPlaneProj a z))
      (x + v k x • e a) = 0 := fun k => (hsheet k y hy).2
  have hconst : Tendsto
      (fun k => levelMeanCurvCoord G (fun z => z a - v k (coordPlaneProj a z)) (x + v k x • e a))
      atTop (𝓝 0) := by
    simp only [hzero]
    exact tendsto_const_nhds
  exact tendsto_nhds_unique key hconst

theorem limsup_sheets_local {X : Type*} [TopologicalSpace X] (κ : OpenPartialHomeomorph X E3)
    (c : E3) (a : Fin 3) (ρ : ℝ) (hρ : 0 < ρ) (hball : Metric.ball c ρ ⊆ κ.target) (l : ℕ)
    (Sq : ℕ → Set X) (u : ℕ → Fin l → E3 → ℝ) (U : Fin l → E3 → ℝ) (C : ℝ)
    (hd : ∀ N i, ContDiff ℝ ∞ (u N i))
    (hLip : ∀ N i (y : E3), ‖iteratedFDeriv ℝ 1 (u N i) y‖ ≤ C)
    (hconv : ∀ i (y : E3), Filter.Tendsto (fun N => u N i y) Filter.atTop (𝓝 (U i y)))
    (hon : ∀ N i (y : E3), ‖coordPlaneProj a (y - c)‖ < 2 * ρ →
      κ.symm (coordPlaneProj a y + u N i (coordPlaneProj a y) • e a) ∈ Sq N)
    (hcover : ∀ N, ∀ x ∈ Sq N, x ∈ κ.source → κ x ∈ Metric.ball c ρ →
      ∃ i, (κ x) a = u N i (coordPlaneProj a (κ x))) :
    ∀ x ∈ κ.source, κ x ∈ Metric.ball c ρ →
      ((∀ O ∈ 𝓝 x, ∃ᶠ N in Filter.atTop, ¬ Disjoint O (Sq N)) ↔
        ∃ i, (κ x) a = U i (coordPlaneProj a (κ x))) :=
by
  intro x hx hz
  have hPcont : Continuous (coordPlaneProj a) := by
    unfold coordPlaneProj
    fun_prop
  have hP_eq : ∀ y : E3, coordPlaneProj a y + (y a) • e a = y := by
    intro y
    simp only [coordPlaneProj, sub_add_cancel]
  constructor
  · intro hfreq
    by_contra hne
    push_neg at hne
    have hq : ContinuousAt (fun x' => coordPlaneProj a (κ x')) x :=
      hPcont.continuousAt.comp (κ.continuousAt hx)
    have hκa : ContinuousAt (fun x' => (κ x') a) x :=
      ((PiLp.continuous_apply 2 (fun _ : Fin 3 => ℝ) a).continuousAt).comp (κ.continuousAt hx)
    have hLipi : ∀ N i (p q : E3), |u N i p - u N i q| ≤ C * ‖p - q‖ := by
      intro N i p q
      have hdiff : Differentiable ℝ (u N i) := (hd N i).differentiable (by simp)
      have hb : ∀ y ∈ (Set.univ : Set E3), ‖fderiv ℝ (u N i) y‖ ≤ C := by
        intro y _
        rw [← norm_iteratedFDeriv_one]
        exact hLip N i y
      have h := convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun y _ => hdiff y) hb
        (Set.mem_univ q) (Set.mem_univ p)
      rwa [Real.norm_eq_abs] at h
    have hev : ∀ i, ∀ᶠ r in Filter.atTop ×ˢ 𝓝 x,
        (κ r.2) a ≠ u r.1 i (coordPlaneProj a (κ r.2)) := by
      intro i
      have hT : Filter.Tendsto (fun r : ℕ × X => u r.1 i (coordPlaneProj a (κ r.2)))
          (Filter.atTop ×ˢ 𝓝 x) (𝓝 (U i (coordPlaneProj a (κ x)))) := by
        have hg : Filter.Tendsto (fun r : ℕ × X =>
            C * ‖coordPlaneProj a (κ r.2) - coordPlaneProj a (κ x)‖ +
              |u r.1 i (coordPlaneProj a (κ x)) - U i (coordPlaneProj a (κ x))|)
            (Filter.atTop ×ˢ 𝓝 x) (𝓝 0) := by
          have h1 : Filter.Tendsto (fun r : ℕ × X => coordPlaneProj a (κ r.2))
              (Filter.atTop ×ˢ 𝓝 x) (𝓝 (coordPlaneProj a (κ x))) :=
            hq.tendsto.comp Filter.tendsto_snd
          have h2 : Filter.Tendsto (fun r : ℕ × X => u r.1 i (coordPlaneProj a (κ x)))
              (Filter.atTop ×ˢ 𝓝 x) (𝓝 (U i (coordPlaneProj a (κ x)))) :=
            (hconv i _).comp Filter.tendsto_fst
          have h1' := ((h1.sub_const (coordPlaneProj a (κ x))).norm).const_mul C
          have h2' := (h2.sub_const (U i (coordPlaneProj a (κ x)))).abs
          have h3 := h1'.add h2'
          simpa using h3
        rw [tendsto_iff_norm_sub_tendsto_zero]
        refine squeeze_zero (fun r => norm_nonneg _) (fun r => ?_) hg
        rw [Real.norm_eq_abs]
        calc |u r.1 i (coordPlaneProj a (κ r.2)) - U i (coordPlaneProj a (κ x))|
            ≤ |u r.1 i (coordPlaneProj a (κ r.2)) - u r.1 i (coordPlaneProj a (κ x))| +
              |u r.1 i (coordPlaneProj a (κ x)) - U i (coordPlaneProj a (κ x))| :=
              abs_sub_le _ _ _
          _ ≤ C * ‖coordPlaneProj a (κ r.2) - coordPlaneProj a (κ x)‖ +
              |u r.1 i (coordPlaneProj a (κ x)) - U i (coordPlaneProj a (κ x))| := by
              have := hLipi r.1 i (coordPlaneProj a (κ r.2)) (coordPlaneProj a (κ x))
              linarith
      have hK : Filter.Tendsto (fun r : ℕ × X => (κ r.2) a) (Filter.atTop ×ˢ 𝓝 x)
          (𝓝 ((κ x) a)) := hκa.tendsto.comp Filter.tendsto_snd
      have hD := hK.sub hT
      have hne' : (κ x) a - U i (coordPlaneProj a (κ x)) ≠ 0 := sub_ne_zero.mpr (hne i)
      filter_upwards [hD.eventually_ne hne'] with r hr
      exact sub_ne_zero.mp hr
    have H1 := Filter.eventually_all.mpr hev
    have hs : ∀ᶠ x' in 𝓝 x, x' ∈ κ.source ∧ κ x' ∈ Metric.ball c ρ :=
      Filter.Eventually.and (κ.open_source.mem_nhds hx)
        (κ.continuousAt hx (Metric.isOpen_ball.mem_nhds hz))
    have H2 : ∀ᶠ r in (Filter.atTop : Filter ℕ) ×ˢ 𝓝 x,
        r.2 ∈ κ.source ∧ κ r.2 ∈ Metric.ball c ρ :=
      hs.prod_inr (Filter.atTop : Filter ℕ)
    obtain ⟨pa, hpa, pb, hpb, hgood⟩ := Filter.eventually_prod_iff.mp (H1.and H2)
    obtain ⟨N, hN, hpaN⟩ := ((hfreq {x' | pb x'} hpb).and_eventually hpa).exists
    obtain ⟨x', hx'O, hx'S⟩ := Set.not_disjoint_iff.mp hN
    obtain ⟨hall, hsrc, hb⟩ := hgood hpaN hx'O
    obtain ⟨i, hi⟩ := hcover N x' hx'S hsrc hb
    exact hall i hi
  · rintro ⟨i, hi⟩
    intro O hO
    have hv : ‖κ x - c‖ < ρ := by rwa [Metric.mem_ball, dist_eq_norm] at hz
    have hP : ‖coordPlaneProj a (κ x - c)‖ < 2 * ρ := by
      have h1 : ‖(κ x - c) a‖ ≤ ‖κ x - c‖ := PiLp.norm_apply_le _ _
      have h2 : ‖e a‖ = 1 := by simp [e, EuclideanSpace.norm_single]
      calc ‖coordPlaneProj a (κ x - c)‖ = ‖(κ x - c) - ((κ x - c) a) • e a‖ := rfl
        _ ≤ ‖κ x - c‖ + ‖((κ x - c) a) • e a‖ := norm_sub_le _ _
        _ = ‖κ x - c‖ + ‖(κ x - c) a‖ := by rw [norm_smul, h2, mul_one]
        _ < 2 * ρ := by linarith
    have hγ : Filter.Tendsto
        (fun N => coordPlaneProj a (κ x) + u N i (coordPlaneProj a (κ x)) • e a)
        Filter.atTop (𝓝 (κ x)) := by
      have h := ((hconv i (coordPlaneProj a (κ x))).smul_const (e a)).const_add
        (coordPlaneProj a (κ x))
      rwa [← hi, hP_eq] at h
    have hsymm : Filter.Tendsto κ.symm (𝓝 (κ x)) (𝓝 x) := by
      have h := κ.continuousAt_symm (κ.map_source hx)
      rwa [ContinuousAt, κ.left_inv hx] at h
    have hev : ∀ᶠ N in Filter.atTop,
        κ.symm (coordPlaneProj a (κ x) + u N i (coordPlaneProj a (κ x)) • e a) ∈ O :=
      (hsymm.comp hγ) hO
    refine Filter.Eventually.frequently ?_
    filter_upwards [hev] with N hN
    exact Set.not_disjoint_iff.mpr ⟨_, hN, hon N i (κ x) hP⟩

theorem sheets_subseq_limit_var [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Z : Set M) (J : ℕ) (pts : Fin J → M) (ρ : Fin J → ℝ) (L : ℕ)
    (Λ : ℕ → ℝ) (hZ : IsCompact Z) (hρ : ∀ j, 0 < ρ j)
    (hball : ∀ j, Metric.closedBall (chartAt E3 (pts j) (pts j)) (10 * ρ j) ⊆
      (chartAt E3 (pts j)).target)
    (hcov : Z ⊆ (⋃ j, (chartAt E3 (pts j)).source ∩
      chartAt E3 (pts j) ⁻¹' Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j)))
    (Sig : ℕ → Set M)
    (hSig : ∀ m, Sig m ⊆ Z ∧ ∀ j, MinimalSheetsNear g (pts j) (ρ j) L Λ (Sig m)) :
    ∃ (ψ : ℕ → ℕ) (Sinf : Set M), StrictMono ψ ∧ IsCompact Sinf ∧ IsMinimalSurfaceSet g Sinf ∧
      ∀ q : M, q ∉ Sinf → ∃ O ∈ 𝓝 q, ∀ᶠ N in Filter.atTop, Disjoint O (Sig (ψ N)) :=
by
  classical
  
  have hpadd : ∀ (a : Fin 3) (x y : E3),
      coordPlaneProj a (x + y) = coordPlaneProj a x + coordPlaneProj a y := by
    intro a x y
    simp only [coordPlaneProj, PiLp.add_apply, add_smul]
    abel
  have hpsmul : ∀ (a : Fin 3) (r : ℝ) (x : E3),
      coordPlaneProj a (r • x) = r • coordPlaneProj a x := by
    intro a r x
    simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, smul_sub, mul_smul]
  have hplin : ∀ a : Fin 3, IsLinearMap ℝ (coordPlaneProj a) :=
    fun a => ⟨hpadd a, hpsmul a⟩
  have hpsub : ∀ (a : Fin 3) (x y : E3),
      coordPlaneProj a (x - y) = coordPlaneProj a x - coordPlaneProj a y :=
    fun a x y => (IsLinearMap.mk' _ (hplin a)).map_sub x y
  have hpcd : ∀ a : Fin 3, ContDiff ℝ ∞ (coordPlaneProj a) := by
    intro a
    exact (LinearMap.toContinuousLinearMap (IsLinearMap.mk' _ (hplin a))).contDiff
  have hpcont : ∀ a : Fin 3, Continuous (coordPlaneProj a) := fun a => (hpcd a).continuous
  have hpre : ∀ (a : Fin 3) (z : E3), coordPlaneProj a z + (z a) • e a = z := by
    intro a z
    simp only [coordPlaneProj, sub_add_cancel]
  have hple : ∀ (a : Fin 3) (v : E3), ‖coordPlaneProj a v‖ ≤ ‖v‖ := by
    intro a v
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    simp only [Fin.sum_univ_three, coordPlaneProj, PiLp.sub_apply, PiLp.smul_apply, e,
      EuclideanSpace.single_apply, smul_eq_mul, Real.norm_eq_abs, sq_abs]
    fin_cases a <;> simp <;> nlinarith [sq_nonneg (v 0), sq_nonneg (v 1), sq_nonneg (v 2)]
  have hcoord : ∀ a : Fin 3, Continuous (fun z : E3 => z a) := fun a => by fun_prop
  
  have hF3 : ∀ (r : ℝ) (a : Fin 3) (c z : E3), z ∈ Metric.ball c r →
      ‖coordPlaneProj a (z - c)‖ < 2 * r := by
    intro r a c z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz
    linarith [hple a (z - c), norm_nonneg (z - c)]
  have hdisc_open : ∀ (r : ℝ) (a : Fin 3) (c : E3),
      IsOpen {y : E3 | ‖coordPlaneProj a (y - c)‖ < 2 * r} := by
    intro r a c
    exact isOpen_lt ((hpcont a).comp (continuous_id.sub continuous_const)).norm continuous_const
  have hdisc_conv : ∀ (r : ℝ) (a : Fin 3) (c : E3),
      Convex ℝ {y : E3 | ‖coordPlaneProj a (y - c)‖ < 2 * r} := by
    intro r a c
    have hset : {y : E3 | ‖coordPlaneProj a (y - c)‖ < 2 * r} =
        coordPlaneProj a ⁻¹' Metric.ball (coordPlaneProj a c) (2 * r) := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Metric.mem_ball, dist_eq_norm, hpsub]
    rw [hset]
    exact (convex_ball _ _).is_linear_preimage (hplin a)
  
  have hS2 : ∀ m j, MinimalSheetsNear g (pts j) (ρ j) L Λ (Sig m) := fun m j => (hSig m).2 j
  unfold MinimalSheetsNear at hS2
  choose a l u hlL hsm hbd hord hsh hcv using hS2
  
  obtain ⟨ut, hut⟩ : ∃ ut : ℕ → Fin J → ℕ → E3 → ℝ, ∀ m j i,
      ut m j i = if h : i < l m j then u m j ⟨i, h⟩ else fun _ => 0 :=
    ⟨fun m j i => if h : i < l m j then u m j ⟨i, h⟩ else fun _ => 0, fun _ _ _ => rfl⟩
  have hut_sm : ∀ m j i, ContDiff ℝ ∞ (ut m j i) := by
    intro m j i
    rw [hut]
    split_ifs with h
    · exact hsm m j _
    · exact contDiff_const
  have hut_bd : ∀ m j i (n : ℕ) (y : E3),
      ‖iteratedFDeriv ℝ n (ut m j i) y‖ ≤ max (Λ n) 0 := by
    intro m j i n y
    rw [hut]
    split_ifs with h
    · exact le_trans (hbd m j _ n y) (le_max_left _ _)
    · rw [iteratedFDeriv_zero_fun]
      simp
  
  obtain ⟨ψ₁, hψ₁, ah, lh, hlhL, ha, hl⟩ : ∃ ψ₁ : ℕ → ℕ, StrictMono ψ₁ ∧
      ∃ (ah : Fin J → Fin 3) (lh : Fin J → ℕ), (∀ j, lh j ≤ L) ∧
        (∀ N j, a (ψ₁ N) j = ah j) ∧ (∀ N j, l (ψ₁ N) j = lh j) := by
    let Fm : ℕ → (Fin J → Fin 3 × Fin (L + 1)) :=
      fun m j => (a m j, ⟨l m j, Nat.lt_succ_of_le (hlL m j)⟩)
    obtain ⟨y, hy⟩ := Finite.exists_infinite_fiber Fm
    have hfreq : ∃ᶠ m in atTop, Fm m = y := by
      rw [Nat.frequently_atTop_iff_infinite]
      exact Set.infinite_coe_iff.mp hy
    obtain ⟨φ, hφ, hφy⟩ := Filter.extraction_of_frequently_atTop hfreq
    refine ⟨φ, hφ, fun j => (y j).1, fun j => (y j).2.val,
      fun j => Nat.lt_succ_iff.mp (y j).2.isLt, ?_, ?_⟩
    · intro N j
      have h := congrFun (hφy N) j
      show a (φ N) j = (y j).1
      rw [← h]
    · intro N j
      have h := congrFun (hφy N) j
      show l (φ N) j = (y j).2.val
      rw [← h]
  
  obtain ⟨ψ₂, F, hψ₂, hFsm, hconv0, hconvD⟩ :=
    smooth_arzela_ascoli_family (ι := Fin J × Fin L)
      (fun N ji => ut (ψ₁ N) ji.1 ji.2.val) (fun n => max (Λ n) 0)
      (fun N ji => hut_sm _ _ _) (fun N ji n y => hut_bd _ _ _ n y)
  have hidx : ∀ j (i : Fin (lh j)), i.val < L := fun j i => lt_of_lt_of_le i.isLt (hlhL j)
  obtain ⟨Uf, hUf⟩ : ∃ Uf : (j : Fin J) → Fin (lh j) → E3 → ℝ,
      ∀ j (i : Fin (lh j)), Uf j i = F (j, ⟨i.val, hidx j i⟩) :=
    ⟨fun j i => F (j, ⟨i.val, hidx j i⟩), fun _ _ => rfl⟩
  have hUsm : ∀ j i, ContDiff ℝ ∞ (Uf j i) := fun j i => by rw [hUf]; exact hFsm _
  have hUc0 : ∀ j (i : Fin (lh j)) (y : E3),
      Tendsto (fun N => ut (ψ₁ (ψ₂ N)) j i.val y) atTop (𝓝 (Uf j i y)) := by
    intro j i y
    rw [hUf]
    exact hconv0 (j, ⟨i.val, hidx j i⟩) y
  have hUcD : ∀ j (i : Fin (lh j)) (n : ℕ) (y : E3),
      Tendsto (fun N => iteratedFDeriv ℝ n (ut (ψ₁ (ψ₂ N)) j i.val) y) atTop
        (𝓝 (iteratedFDeriv ℝ n (Uf j i) y)) := by
    intro j i n y
    rw [hUf]
    exact hconvD (j, ⟨i.val, hidx j i⟩) n y
  
  have hlt : ∀ N j (i : Fin (lh j)), i.val < l (ψ₁ N) j := fun N j i => by
    rw [hl]; exact i.isLt
  have hut_eq : ∀ N j (i : Fin (lh j)),
      ut (ψ₁ N) j i.val = u (ψ₁ N) j ⟨i.val, hlt N j i⟩ := by
    intro N j i
    rw [hut, dif_pos (hlt N j i)]
  have hwo : ∀ N j (i i' : Fin (lh j)), i < i' → ∀ y : E3,
      ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      ut (ψ₁ N) j i.val (coordPlaneProj (ah j) y) <
        ut (ψ₁ N) j i'.val (coordPlaneProj (ah j) y) := by
    intro N j i i' hii y hy
    rw [hut_eq, hut_eq]
    have h := hord (ψ₁ N) j ⟨i.val, hlt N j i⟩ ⟨i'.val, hlt N j i'⟩ (Fin.mk_lt_mk.mpr hii) y
    rw [ha] at h
    exact h hy
  have hws : ∀ N j (i : Fin (lh j)) (y : E3),
      ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      |ut (ψ₁ N) j i.val (coordPlaneProj (ah j) y) - (chartAt E3 (pts j) (pts j)) (ah j)|
          < 8 * ρ j ∧
      (chartAt E3 (pts j)).symm (coordPlaneProj (ah j) y +
        ut (ψ₁ N) j i.val (coordPlaneProj (ah j) y) • e (ah j)) ∈ Sig (ψ₁ N) ∧
      levelMeanCurvCoord (g.coeff (chartAt E3 (pts j)).symm)
        (fun z => z (ah j) - ut (ψ₁ N) j i.val (coordPlaneProj (ah j) z))
        (coordPlaneProj (ah j) y + ut (ψ₁ N) j i.val (coordPlaneProj (ah j) y) • e (ah j))
          = 0 := by
    intro N j i y hy
    rw [hut_eq]
    have h := hsh (ψ₁ N) j ⟨i.val, hlt N j i⟩ y
    rw [ha] at h
    exact h hy
  have hwc : ∀ N j, ∀ x ∈ Sig (ψ₁ N), x ∈ (chartAt E3 (pts j)).source →
      chartAt E3 (pts j) x ∈ Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j) →
      ∃ i : Fin (lh j), (chartAt E3 (pts j) x) (ah j) =
        ut (ψ₁ N) j i.val (coordPlaneProj (ah j) (chartAt E3 (pts j) x)) := by
    intro N j x hx hs hb
    obtain ⟨i, hi⟩ := hcv (ψ₁ N) j x hx hs hb
    rw [ha] at hi
    have hi' : i.val < lh j := by rw [← hl N j]; exact i.isLt
    refine ⟨⟨i.val, hi'⟩, ?_⟩
    show _ = ut (ψ₁ N) j i.val _
    rw [hut, dif_pos i.isLt]
    exact hi
  
  have hUslab : ∀ j (i : Fin (lh j)) (y : E3),
      ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      |Uf j i (coordPlaneProj (ah j) y) - (chartAt E3 (pts j) (pts j)) (ah j)| ≤ 8 * ρ j := by
    intro j i y hy
    have ht := ((hUc0 j i (coordPlaneProj (ah j) y)).sub_const
      ((chartAt E3 (pts j) (pts j)) (ah j))).abs
    exact le_of_tendsto' ht (fun N => (hws (ψ₂ N) j i y hy).1.le)
  have hUord : ∀ j (i i' : Fin (lh j)), i < i' → ∀ y : E3,
      ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      Uf j i (coordPlaneProj (ah j) y) ≤ Uf j i' (coordPlaneProj (ah j) y) := by
    intro j i i' hii y hy
    exact le_of_tendsto_of_tendsto' (hUc0 j i _) (hUc0 j i' _)
      (fun N => (hwo (ψ₂ N) j i i' hii y hy).le)
  
  have hUmse : ∀ j (i : Fin (lh j)) (y : E3),
      ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      levelMeanCurvCoord (g.coeff (chartAt E3 (pts j)).symm)
        (fun z => z (ah j) - Uf j i (coordPlaneProj (ah j) z))
        (coordPlaneProj (ah j) y + Uf j i (coordPlaneProj (ah j) y) • e (ah j)) = 0 := by
    intro j i
    exact mse_graph_limit g (pts j) (ah j) (ρ j) (hρ j) (hball j)
      (fun k => ut (ψ₁ (ψ₂ k)) j i.val) (Uf j i) (fun k => hut_sm _ _ _) (hUsm j i)
      (fun n _ y => hUcD j i n y)
      (fun k y hy => ⟨(hws (ψ₂ k) j i y hy).1, (hws (ψ₂ k) j i y hy).2.2⟩)
  
  have hcoinc : ∀ j (i i' : Fin (lh j)), i < i' → ∀ y₀ : E3,
      ‖coordPlaneProj (ah j) (y₀ - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      Uf j i (coordPlaneProj (ah j) y₀) = Uf j i' (coordPlaneProj (ah j) y₀) →
      ∀ y : E3, ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      Uf j i (coordPlaneProj (ah j) y) = Uf j i' (coordPlaneProj (ah j) y) := by
    intro j i i' hii y₀ hy₀ heq y hy
    have hloc := minimal_graph_difference_elliptic g (pts j) (ah j) (ρ j) (hρ j) (hball j)
      (Uf j i) (Uf j i') (hUsm j i) (hUsm j i') (hUslab j i) (hUslab j i')
      (hUmse j i) (hUmse j i') (hUord j i i' hii)
    have hw2 : ContDiff ℝ 2 (fun y' => Uf j i' (coordPlaneProj (ah j) y') -
        Uf j i (coordPlaneProj (ah j) y')) :=
      (((hUsm j i').comp (hpcd (ah j))).sub ((hUsm j i).comp (hpcd (ah j)))).of_le
        (by norm_cast)
    have h := hopf_strong_min_principle
      {y : E3 | ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j}
      (hdisc_open (ρ j) _ _) (hdisc_conv (ρ j) _ _).isPreconnected _ hw2
      (fun y hy => sub_nonneg.mpr (hUord j i i' hii y hy)) hloc y₀ hy₀
      (by simp only [heq, sub_self]) y hy
    have h' : Uf j i' (coordPlaneProj (ah j) y) - Uf j i (coordPlaneProj (ah j) y) = 0 := h
    linarith
  have hsame : ∀ j (i i' : Fin (lh j)) (y₀ : E3),
      ‖coordPlaneProj (ah j) (y₀ - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      Uf j i (coordPlaneProj (ah j) y₀) = Uf j i' (coordPlaneProj (ah j) y₀) →
      ∀ y : E3, ‖coordPlaneProj (ah j) (y - chartAt E3 (pts j) (pts j))‖ < 2 * ρ j →
      Uf j i (coordPlaneProj (ah j) y) = Uf j i' (coordPlaneProj (ah j) y) := by
    intro j i i' y₀ hy₀ heq y hy
    rcases lt_trichotomy i i' with hii | hii | hii
    · exact hcoinc j i i' hii y₀ hy₀ heq y hy
    · rw [hii]
    · exact (hcoinc j i' i hii y₀ hy₀ heq.symm y hy).symm
  
  obtain ⟨Sinf, hSinf⟩ : ∃ Sinf : Set M, Sinf =
      {q : M | ∀ O ∈ 𝓝 q, ∃ᶠ N in atTop, ¬ Disjoint O (Sig (ψ₁ (ψ₂ N)))} := ⟨_, rfl⟩
  have hmemS : ∀ q, q ∈ Sinf ↔ ∀ O ∈ 𝓝 q, ∃ᶠ N in atTop, ¬ Disjoint O (Sig (ψ₁ (ψ₂ N))) := by
    intro q
    rw [hSinf]
    rfl
  have hKur : ∀ q : M, q ∉ Sinf →
      ∃ O ∈ 𝓝 q, ∀ᶠ N in atTop, Disjoint O (Sig (ψ₁ (ψ₂ N))) := by
    intro q hq
    have h : ¬ ∀ O ∈ 𝓝 q, ∃ᶠ N in atTop, ¬ Disjoint O (Sig (ψ₁ (ψ₂ N))) :=
      fun h => hq ((hmemS q).mpr h)
    simp only [not_forall, Filter.not_frequently, not_not] at h
    obtain ⟨O, hO, h⟩ := h
    exact ⟨O, hO, h⟩
  have hclosed : IsClosed Sinf := by
    rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
    intro q hq
    obtain ⟨O, hO, h⟩ := hKur q hq
    obtain ⟨O', hO'O, hO'o, hqO'⟩ := mem_nhds_iff.mp hO
    refine Filter.mem_of_superset (hO'o.mem_nhds hqO') ?_
    intro q' hq'
    rw [Set.mem_compl_iff, hmemS]
    intro hq'S
    have hf := hq'S O' (hO'o.mem_nhds hq')
    exact (Filter.not_frequently.mpr
      (h.mono fun N hN => not_not.mpr (hN.mono_left hO'O))) hf
  have hSZ : Sinf ⊆ Z := by
    intro q hq
    by_contra hqZ
    rw [hmemS] at hq
    have hf := hq Zᶜ (hZ.isClosed.isOpen_compl.mem_nhds hqZ)
    exact (Filter.not_frequently.mpr (Filter.Eventually.of_forall fun N =>
      not_not.mpr (Disjoint.mono_right (hSig _).1 disjoint_compl_left))) hf
  have hcpt : IsCompact Sinf := hZ.of_isClosed_subset hclosed hSZ
  
  have hmin : IsMinimalSurfaceSet g Sinf := by
    refine ⟨hclosed, ?_⟩
    intro p hp O hO
    obtain ⟨j, hpj, hzj⟩ : ∃ j, p ∈ (chartAt E3 (pts j)).source ∧
        chartAt E3 (pts j) p ∈ Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j) := by
      have h := hcov (hSZ hp)
      rw [Set.mem_iUnion] at h
      obtain ⟨j, h1, h2⟩ := h
      exact ⟨j, h1, h2⟩
    have hballj : Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j) ⊆
        (chartAt E3 (pts j)).target :=
      Metric.ball_subset_closedBall.trans
        ((Metric.closedBall_subset_closedBall (by linarith [hρ j])).trans (hball j))
    have hlim := limsup_sheets_local (chartAt E3 (pts j)) (chartAt E3 (pts j) (pts j)) (ah j)
      (ρ j) (hρ j) hballj (lh j) (fun N => Sig (ψ₁ (ψ₂ N)))
      (fun N i => ut (ψ₁ (ψ₂ N)) j i.val) (Uf j)
      (max (Λ 1) 0) (fun N i => hut_sm _ _ _) (fun N i y => hut_bd _ _ _ 1 y)
      (fun i y => hUc0 j i y) (fun N i y hy => (hws (ψ₂ N) j i y hy).2.1)
      (fun N x hx hs hb => hwc (ψ₂ N) j x hx hs hb)
    have hlim' : ∀ x ∈ (chartAt E3 (pts j)).source,
        chartAt E3 (pts j) x ∈ Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j) →
        (x ∈ Sinf ↔ ∃ i : Fin (lh j), (chartAt E3 (pts j) x) (ah j) =
          Uf j i (coordPlaneProj (ah j) (chartAt E3 (pts j) x))) := by
      intro x hx hb
      rw [hmemS]
      exact hlim x hx hb
    obtain ⟨i₀, hi₀⟩ := (hlim' p hpj hzj).mp hp
    let W : Set E3 := Metric.ball (chartAt E3 (pts j) (pts j)) (ρ j) ∩
      ⋂ i : Fin (lh j), {z : E3 | Uf j i (coordPlaneProj (ah j) (chartAt E3 (pts j) p)) =
        (chartAt E3 (pts j) p) (ah j) ∨ z (ah j) ≠ Uf j i (coordPlaneProj (ah j) z)}
    have hWo : IsOpen W := by
      refine Metric.isOpen_ball.inter (isOpen_iInter_of_finite fun i => ?_)
      by_cases h : Uf j i (coordPlaneProj (ah j) (chartAt E3 (pts j) p)) =
          (chartAt E3 (pts j) p) (ah j)
      · simp only [h, true_or, Set.setOf_true, isOpen_univ]
      · simp only [h, false_or]
        exact isOpen_ne_fun (hcoord (ah j)) ((hUsm j i).continuous.comp (hpcont (ah j)))
    have hz₀W : chartAt E3 (pts j) p ∈ W := by
      refine ⟨hzj, Set.mem_iInter.mpr fun i => ?_⟩
      by_cases h : Uf j i (coordPlaneProj (ah j) (chartAt E3 (pts j) p)) =
          (chartAt E3 (pts j) p) (ah j)
      · exact Or.inl h
      · exact Or.inr (fun h' => h h'.symm)
    have hWt : W ⊆ (chartAt E3 (pts j)).target := fun z hz => hballj hz.1
    have hMSE : ∀ z ∈ W, z (ah j) = Uf j i₀ (coordPlaneProj (ah j) z) →
        levelMeanCurvCoord (g.coeff (chartAt E3 (pts j)).symm)
          (fun w => w (ah j) - Uf j i₀ (coordPlaneProj (ah j) w)) z = 0 := by
      intro z hz hza
      have h := hUmse j i₀ z (hF3 (ρ j) _ _ _ hz.1)
      rw [← hza, hpre] at h
      exact h
    obtain ⟨V, f, hVO, hVo, hpV, hVW, hf, hdf, hzero, hH, hP, hN⟩ :=
      graph_minimal_chart g (pts j) p (ah j) (Uf j i₀) (hUsm j i₀) W hWo hWt hpj hz₀W hi₀
        hMSE O hO
    refine ⟨V, f, hVO, hVo, hpV, hf, hdf, ?_, hH, hP, hN⟩
    ext x
    constructor
    · rintro ⟨hxV, hxS⟩
      refine ⟨hxV, ?_⟩
      obtain ⟨hxs, hxW⟩ := hVW x hxV
      obtain ⟨i, hi⟩ := (hlim' x hxs hxW.1).mp hxS
      show f x = 0
      rw [hzero x hxV]
      have hiI : Uf j i (coordPlaneProj (ah j) (chartAt E3 (pts j) p)) =
          (chartAt E3 (pts j) p) (ah j) := by
        rcases Set.mem_iInter.mp hxW.2 i with h | h
        · exact h
        · exact absurd hi h
      have hc := hsame j i i₀ (chartAt E3 (pts j) p) (hF3 (ρ j) _ _ _ hzj) (hiI.trans hi₀)
        (chartAt E3 (pts j) x) (hF3 (ρ j) _ _ _ hxW.1)
      rw [hi, hc]
    · rintro ⟨hxV, hx0⟩
      refine ⟨hxV, ?_⟩
      obtain ⟨hxs, hxW⟩ := hVW x hxV
      exact (hlim' x hxs hxW.1).mpr ⟨i₀, (hzero x hxV).mp hx0⟩
  
  exact ⟨fun N => ψ₁ (ψ₂ N), Sinf, hψ₁.comp hψ₂, hcpt, hmin, hKur⟩

theorem finite_hulls_converge [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds) (r₀ : ℝ)
    (hr₀ : 2 ≤ r₀)
    (havoid : ∀ S : Set M, IsCompact S → IsMinimalSurfaceSet g S →
      ∀ (l : Fin hAF.numEnds) (y : E3), r₀ < ‖y‖ → (hAF.ends l).Φ y ∉ S)
    (S : ℕ → Set M) (hS : ∀ n, IsCompact (S n) ∧ IsMinimalSurfaceSet g (S n)) :
    ∃ (Sig : ℕ → Set M) (Sinf : Set M) (ψ : ℕ → ℕ), StrictMono ψ ∧
      (∀ N, IsCompact (Sig N) ∧ IsMinimalSurfaceSet g (Sig N)) ∧
      (∀ N, frontier (connectedComponentIn ((⋃ n ∈ Finset.range (ψ N), S n) ∪ Sig N)ᶜ
        ((hAF.ends k).Φ ((r₀ + 1) • e 0))) ⊆ Sig N) ∧
      IsCompact Sinf ∧ IsMinimalSurfaceSet g Sinf ∧
      (∀ q : M, q ∉ Sinf → ∃ O ∈ 𝓝 q, ∀ᶠ N in Filter.atTop, Disjoint O (Sig N)) :=
by
  
  obtain ⟨R, hR2, hbar⟩ := far_spheres_mean_convex g hAF
  
  have hopen : ∀ l : Fin hAF.numEnds, IsOpen ((hAF.ends l).Φ '' {y : E3 | r₀ < ‖y‖}) := by
    intro l
    have hsub : {y : E3 | r₀ < ‖y‖} ⊆ (hAF.ends l).Φ.source := by
      intro y hy
      rw [(hAF.ends l).source_eq]
      show (1 : ℝ) < ‖y‖
      have : r₀ < ‖y‖ := hy
      linarith
    exact (hAF.ends l).Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
      (isOpen_lt continuous_const continuous_norm) hsub
  have hZ : IsCompact (⋃ l, (hAF.ends l).Φ '' {y : E3 | r₀ < ‖y‖})ᶜ := by
    have hclosed : IsClosed (⋃ l, (hAF.ends l).Φ '' {y : E3 | r₀ < ‖y‖})ᶜ := by
      rw [isClosed_compl_iff]
      exact isOpen_iUnion hopen
    have hK : IsCompact ((⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 < ‖y‖})ᶜ ∪
        ⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r₀}) := by
      refine hAF.isCompact_core.union (isCompact_iUnion fun l => ?_)
      have hc : IsCompact {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r₀} := by
        refine (isCompact_closedBall (0 : E3) r₀).of_isClosed_subset ?_ ?_
        · exact (isClosed_le continuous_const continuous_norm).inter
            (isClosed_le continuous_norm continuous_const)
        · intro y hy
          rw [mem_closedBall_zero_iff]
          exact hy.2
      have hsub : {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r₀} ⊆ (hAF.ends l).Φ.source := by
        intro y hy
        rw [(hAF.ends l).source_eq]
        show (1 : ℝ) < ‖y‖
        linarith [hy.1]
      have hcont : ContinuousOn ((hAF.ends l).Φ : E3 → M) (hAF.ends l).Φ.source :=
        (hAF.ends l).Φ.contMDiffOn_toFun.continuousOn
      exact hc.image_of_continuousOn (hcont.mono hsub)
    refine hK.of_isClosed_subset hclosed ?_
    intro x hx
    by_cases h2 : x ∈ ⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 < ‖y‖}
    · right
      obtain ⟨l, y, hy, rfl⟩ := Set.mem_iUnion.1 h2
      have hy' : (2 : ℝ) < ‖y‖ := hy
      refine Set.mem_iUnion.2 ⟨l, y, ⟨le_of_lt hy', ?_⟩, rfl⟩
      by_contra hc
      push_neg at hc
      exact hx (Set.mem_iUnion.2 ⟨l, y, hc, rfl⟩)
    · left
      exact h2
  
  obtain ⟨A, hall⟩ := finite_hull_stable_area g hAF k r₀ hr₀ havoid (max R (r₀ + 2))
    (by linarith [le_max_right R (r₀ + 2)])
    (fun l y hy => hbar l y (le_trans (le_max_left _ _) hy)) S hS
  choose Sig hSig using hall
  have hSZ : ∀ m, Sig m ⊆ (⋃ l, (hAF.ends l).Φ '' {y : E3 | r₀ < ‖y‖})ᶜ := by
    intro m x hx hxU
    obtain ⟨l, y, hy, rfl⟩ := Set.mem_iUnion.1 hxU
    exact havoid (Sig m) (hSig m).1 (hSig m).2.1 l y hy hx
  
  obtain ⟨Λ, hΛ⟩ := stable_curvature_bound g _ hZ
  
  obtain ⟨J, pts, ρ, L, Λn, hρ, hball, hcov, hsheets⟩ := curvature_area_sheets g _ hZ Λ A
  
  obtain ⟨ψ, Sinf, hψ, hSc, hSm, hlim⟩ :=
    sheets_subseq_limit_var g _ J pts ρ L Λn hZ hρ hball hcov Sig
      (fun m => ⟨hSZ m, hsheets (Sig m) (hSig m).1 (hSig m).2.1 (hSZ m)
        (hΛ (Sig m) (hSig m).1 (hSig m).2.1 (hSig m).2.2.1 (hSZ m)) (hSig m).2.2.2.2⟩)
  exact ⟨fun N => Sig (ψ N), Sinf, ψ, hψ, fun N => ⟨(hSig (ψ N)).1, (hSig (ψ N)).2.1⟩,
    fun N => (hSig (ψ N)).2.2.2.1, hSc, hSm, hlim⟩

theorem trapped_outer_boundary_minimal [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k : Fin hAF.numEnds) (r₀ : ℝ) (hr₀ : 2 ≤ r₀)
    (havoid : ∀ S : Set M, IsCompact S → IsMinimalSurfaceSet g S →
      ∀ (l : Fin hAF.numEnds) (y : E3), r₀ < ‖y‖ → (hAF.ends l).Φ y ∉ S) :
    IsMinimalSurfaceSet g
      (frontier (connectedComponentIn (trappedSet g)ᶜ ((hAF.ends k).Φ ((r₀ + 1) • e 0)))) :=
by
  haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
  
  obtain ⟨S, hS, hT⟩ := trappedSet_eq_closure_iUnion g hAF
  
  obtain ⟨Sig, Sinf, ψ, hψ, hSig, hfrN, hSc, hSm, hlim⟩ :=
    finite_hulls_converge g hAF k r₀ hr₀ havoid S hS
  
  have hcov := frontier_subset_of_hull_limit g ((hAF.ends k).Φ ((r₀ + 1) • e 0))
    S hS hT Sig Sinf ψ hψ hSig hfrN hlim
  
  have hUo : IsOpen (connectedComponentIn (trappedSet g)ᶜ ((hAF.ends k).Φ ((r₀ + 1) • e 0))) :=
    isClosed_closure.isOpen_compl.connectedComponentIn
  have hdisj : Disjoint Sinf
      (connectedComponentIn (trappedSet g)ᶜ ((hAF.ends k).Φ ((r₀ + 1) • e 0))) := by
    rw [Set.disjoint_left]
    intro x hx hxU
    have hxT : x ∈ trappedSet g := subset_closure (Set.mem_sUnion.2 ⟨Sinf, ⟨hSc, hSm⟩, hx⟩)
    exact connectedComponentIn_subset _ _ hxU hxT
  
  exact frontier_minimal_of_minimal_cover g _ Sinf hUo hSm hdisj hcov

theorem coordSphere_levelMeanCurvCoord_pos (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 0 < q) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hdet : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det) (hdec : Dec1 G q R C) :
    ∃ Rb : ℝ, R ≤ Rb ∧ ∀ y : E3, Rb < ‖y‖ → 0 < levelMeanCurvCoord G (fun z => ‖z‖) y :=
by
  
  have coordSphere_norm_partials : ∀ (y : E3), y ≠ 0 →
      (∀ i : Fin 3, partialDeriv i (fun z : E3 => ‖z‖) y = y i / ‖y‖) ∧
      (∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun z : E3 => ‖z‖)) y =
        ((if i = j then (1 : ℝ) else 0) - y i * y j / ‖y‖ ^ 2) / ‖y‖) := by
    intro y hy
    have hfd : ∀ z : E3, z ≠ 0 →
        HasFDerivAt (fun x : E3 => ‖x‖) ((‖z‖⁻¹) • innerSL ℝ z) z := by
      intro z hz
      have hzn : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
      have hz2 : ‖z‖ ^ 2 ≠ 0 := pow_ne_zero 2 hzn
      have h := (hasStrictFDerivAt_norm_sq z).hasFDerivAt.sqrt hz2
      have heq : (fun x : E3 => Real.sqrt (‖x‖ ^ 2)) = fun x => ‖x‖ :=
        funext fun x => Real.sqrt_sq (norm_nonneg x)
      rw [heq] at h
      convert h using 1
      refine ContinuousLinearMap.ext fun v => ?_
      simp [Real.sqrt_sq (norm_nonneg z)]
      field_simp
    have hp1 : ∀ z : E3, z ≠ 0 → ∀ i : Fin 3,
        partialDeriv i (fun x : E3 => ‖x‖) z = z i / ‖z‖ := by
      intro z hz i
      unfold partialDeriv
      rw [(hfd z hz).fderiv]
      simp [EuclideanSpace.inner_single_right]
      ring
    refine ⟨hp1 y hy, fun i j => ?_⟩
    have hyn : ‖y‖ ≠ 0 := norm_ne_zero_iff.mpr hy
    have hev : partialDeriv j (fun x : E3 => ‖x‖) =ᶠ[𝓝 y] fun z => z j * ‖z‖⁻¹ := by
      filter_upwards [isOpen_ne.mem_nhds hy] with z hz
      rw [hp1 z hz j, div_eq_mul_inv]
    have hproj : HasFDerivAt (fun z : E3 => z j) (EuclideanSpace.proj j : E3 →L[ℝ] ℝ) y :=
      (EuclideanSpace.proj j : E3 →L[ℝ] ℝ).hasFDerivAt
    have hinvn : HasFDerivAt (fun z : E3 => ‖z‖⁻¹)
        ((-(‖y‖ ^ 2)⁻¹) • ((‖y‖⁻¹) • innerSL ℝ y)) y :=
      (hasDerivAt_inv hyn).comp_hasFDerivAt y (hfd y hy)
    have hprod := hproj.fun_mul hinvn
    show fderiv ℝ (partialDeriv j fun x => ‖x‖) y (e i) = _
    rw [hev.fderiv_eq, hprod.fderiv]
    simp [EuclideanSpace.inner_single_right, EuclideanSpace.single_apply]
    split_ifs with h1 h2 h2
    · field_simp; ring
    · exact absurd h1.symm h2
    · exact absurd h2.symm h1
    · field_simp; ring
  
  have coordSphere_alg_pos : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (Hm : Fin 3 → Fin 3 → ℝ)
      (ν : Fin 3 → ℝ) (r β ε : ℝ), 0 < r → 0 ≤ β → β ≤ 1 / 200 → 0 ≤ ε →
      ε * r ≤ 1 / 200 → ∑ i : Fin 3, ν i ^ 2 = 1 →
      (∀ i j : Fin 3, |A i j - (if i = j then (1 : ℝ) else 0)| ≤ β) →
      (∀ i j : Fin 3, |Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j) / r| ≤ ε) →
      0 < (∑ i : Fin 3, ∑ j : Fin 3, A i j * Hm i j) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j) -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * ν a * (A j b * ν b) * Hm i j) /
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j) ^ 3 := by
    intro A Hm ν r β ε hr hβ0 hβ hε0 hεr hν hA hH
    
    have h3 : ∀ (X : Fin 3 → ℝ) (M : ℝ), (∀ i, |X i| ≤ M) → |∑ i, X i| ≤ 3 * M := by
      intro X M hX
      calc |∑ i, X i| ≤ ∑ i, |X i| := Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _i : Fin 3, M := Finset.sum_le_sum (fun i _ => hX i)
        _ = 3 * M := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            Nat.cast_ofNat]
    have h9 : ∀ (X : Fin 3 → Fin 3 → ℝ) (M : ℝ), (∀ i j, |X i j| ≤ M) →
        |∑ i, ∑ j, X i j| ≤ 9 * M := by
      intro X M hX
      calc |∑ i, ∑ j, X i j| ≤ ∑ _i : Fin 3, 3 * M :=
            (Finset.abs_sum_le_sum_abs _ _).trans
              (Finset.sum_le_sum (fun i _ => h3 _ _ (hX i)))
        _ = 9 * M := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            Nat.cast_ofNat]
          ring
    
    have hd1 : ∀ i j : Fin 3, |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by
      intro i j; split_ifs <;> simp
    have hνsq : ∀ i, ν i ^ 2 ≤ 1 := by
      intro i; rw [← hν]
      exact Finset.single_le_sum (f := fun k => ν k ^ 2) (fun k _ => sq_nonneg _)
        (Finset.mem_univ i)
    have hνb : ∀ i, |ν i| ≤ 1 := fun i => (sq_le_one_iff_abs_le_one (ν i)).mp (hνsq i)
    have hAb : ∀ i j, |A i j| ≤ 1 + β := by
      intro i j
      calc |A i j| = |(A i j - (if i = j then (1 : ℝ) else 0)) + (if i = j then (1 : ℝ) else 0)| := by
            ring_nf
        _ ≤ |A i j - (if i = j then (1 : ℝ) else 0)| + |(if i = j then (1 : ℝ) else 0)| :=
            abs_add_le _ _
        _ ≤ β + 1 := add_le_add (hA i j) (hd1 i j)
        _ = 1 + β := by ring
    have hcb : ∀ i j : Fin 3, |(if i = j then (1 : ℝ) else 0) - ν i * ν j| ≤ 1 := by
      intro i j
      by_cases h : i = j
      · subst h
        rw [if_pos rfl, abs_le]
        have := hνsq i
        constructor <;> nlinarith [sq_nonneg (ν i)]
      · rw [if_neg h, zero_sub, abs_neg, abs_mul]
        calc |ν i| * |ν j| ≤ 1 * 1 := mul_le_mul (hνb i) (hνb j) (abs_nonneg _) zero_le_one
          _ = 1 := one_mul 1
    have hE : ∀ i j, |r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j)| ≤ ε * r := by
      intro i j
      have e : r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j) =
          r * (Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j) / r) := by
        rw [mul_sub, mul_div_cancel₀ _ hr.ne']
      rw [e, abs_mul, abs_of_pos hr]
      calc r * _ ≤ r * ε := mul_le_mul_of_nonneg_left (hH i j) hr.le
        _ = ε * r := mul_comm _ _
    
    have hn2eq : ∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j =
        1 + ∑ i : Fin 3, ∑ j : Fin 3, (A i j - (if i = j then (1 : ℝ) else 0)) * ν i * ν j := by
      have hν' := hν
      simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, if_true, if_false] at hν' ⊢
      linear_combination hν'
    have hs : |∑ i : Fin 3, ∑ j : Fin 3, (A i j - (if i = j then (1 : ℝ) else 0)) * ν i * ν j|
        ≤ 9 * β := by
      refine h9 _ _ (fun i j => ?_)
      rw [abs_mul, abs_mul]
      calc _ ≤ β * 1 * 1 :=
            mul_le_mul (mul_le_mul (hA i j) (hνb i) (abs_nonneg _) hβ0) (hνb j) (abs_nonneg _)
              (by positivity)
        _ = β := by ring
    
    have hrS : r * ∑ i : Fin 3, ∑ j : Fin 3, A i j * Hm i j =
        2 + ∑ i : Fin 3, ∑ j : Fin 3, (A i j - (if i = j then (1 : ℝ) else 0)) *
              ((if i = j then (1 : ℝ) else 0) - ν i * ν j)
          + ∑ i : Fin 3, ∑ j : Fin 3, A i j *
              (r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j)) := by
      have hν' := hν
      simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, if_true, if_false] at hν' ⊢
      linear_combination (-1 : ℝ) * hν'
    have ht1 : |∑ i : Fin 3, ∑ j : Fin 3, (A i j - (if i = j then (1 : ℝ) else 0)) *
        ((if i = j then (1 : ℝ) else 0) - ν i * ν j)| ≤ 9 * β := by
      refine h9 _ _ (fun i j => ?_)
      rw [abs_mul]
      calc _ ≤ β * 1 := mul_le_mul (hA i j) (hcb i j) (abs_nonneg _) hβ0
        _ = β := by ring
    have ht2 : |∑ i : Fin 3, ∑ j : Fin 3, A i j *
        (r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j))| ≤
        9 * ((1 + β) * (ε * r)) := by
      refine h9 _ _ (fun i j => ?_)
      rw [abs_mul]
      exact mul_le_mul (hAb i j) (hE i j) (abs_nonneg _) (by positivity)
    
    have hrQ : r * ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * ν a * (A j b * ν b) * Hm i j =
        ∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * ν a) * (∑ b : Fin 3, A j b * ν b) *
            ((if i = j then (1 : ℝ) else 0) - ν i * ν j)
          + ∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * ν a) * (∑ b : Fin 3, A j b * ν b) *
            (r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j)) := by
      simp only [Fin.sum_univ_three]
      ring
    have hQc : ∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * ν a) * (∑ b : Fin 3, A j b * ν b) *
            ((if i = j then (1 : ℝ) else 0) - ν i * ν j) =
        ∑ i : Fin 3, (∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) ^ 2
          - (∑ i : Fin 3, (∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) * ν i) ^ 2
          + (1 - ∑ i : Fin 3, ν i ^ 2) * (∑ i : Fin 3, ν i ^ 2 + 2 *
              ∑ i : Fin 3, (∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) * ν i) := by
      simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, if_true, if_false]
      ring
    rw [hν] at hQc
    have hwb : ∀ i : Fin 3,
        |∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a| ≤ 3 * β := by
      intro i
      refine h3 _ _ (fun a => ?_)
      rw [abs_mul]
      calc _ ≤ β * 1 := mul_le_mul (hA i a) (hνb a) (abs_nonneg _) hβ0
        _ = β := by ring
    have hw2 : ∑ i : Fin 3, (∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) ^ 2
        ≤ 27 * β ^ 2 := by
      have hsq : ∀ i : Fin 3, (∑ a : Fin 3, (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) ^ 2
          ≤ 9 * β ^ 2 := by
        intro i
        have h := hwb i
        have h' : (3 * β) ^ 2 = 9 * β ^ 2 := by ring
        rw [← h']
        exact sq_le_sq' (abs_le.mp h).1 (abs_le.mp h).2
      calc _ ≤ ∑ _i : Fin 3, 9 * β ^ 2 := Finset.sum_le_sum (fun i _ => hsq i)
        _ = 27 * β ^ 2 := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            Nat.cast_ofNat]
          ring
    have hQc' : ∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * ν a) * (∑ b : Fin 3, A j b * ν b) *
            ((if i = j then (1 : ℝ) else 0) - ν i * ν j) ≤ 27 * β ^ 2 := by
      rw [hQc]
      nlinarith [sq_nonneg (∑ i : Fin 3, (∑ a : Fin 3,
        (A i a - (if i = a then (1 : ℝ) else 0)) * ν a) * ν i)]
    have hvb : ∀ i : Fin 3, |∑ a : Fin 3, A i a * ν a| ≤ 3 * (1 + β) := by
      intro i
      refine h3 _ _ (fun a => ?_)
      rw [abs_mul]
      calc _ ≤ (1 + β) * 1 := mul_le_mul (hAb i a) (hνb a) (abs_nonneg _) (by positivity)
        _ = 1 + β := by ring
    have hQE : |∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * ν a) * (∑ b : Fin 3, A j b * ν b) *
            (r * Hm i j - ((if i = j then (1 : ℝ) else 0) - ν i * ν j))|
        ≤ 9 * (3 * (1 + β) * (3 * (1 + β)) * (ε * r)) := by
      refine h9 _ _ (fun i j => ?_)
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul (hvb i) (hvb j) (abs_nonneg _) (by positivity)) (hE i j)
        (abs_nonneg _) (by positivity)
    
    set n2 := ∑ i : Fin 3, ∑ j : Fin 3, A i j * ν i * ν j with hn2def
    set S := ∑ i : Fin 3, ∑ j : Fin 3, A i j * Hm i j with hSdef
    set Q := ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          A i a * ν a * (A j b * ν b) * Hm i j with hQdef
    have hx0 : 0 ≤ ε * r := by positivity
    have hn2lo : 191 / 200 ≤ n2 := by
      rw [hn2eq]; have := (abs_le.mp hs).1; linarith
    have hn2pos : 0 < n2 := by linarith
    have hbx : β * (ε * r) ≤ 1 / 40000 := by
      have := mul_le_mul hβ hεr hx0 (by norm_num : (0 : ℝ) ≤ 1 / 200); linarith
    have hbb : β * β ≤ 1 / 40000 := by
      have := mul_le_mul hβ hβ hβ0 (by norm_num : (0 : ℝ) ≤ 1 / 200); linarith
    have hbbx : β * β * (ε * r) ≤ 1 / 8000000 := by
      have := mul_le_mul hbb hεr hx0 (by norm_num : (0 : ℝ) ≤ 1 / 40000); linarith
    have hrSlo : 19 / 10 ≤ r * S := by
      rw [hrS]
      have a1 := (abs_le.mp ht1).1
      have a2 := (abs_le.mp ht2).1
      have e2 : 9 * ((1 + β) * (ε * r)) = 9 * (ε * r) + 9 * (β * (ε * r)) := by ring
      linarith
    have hrQhi : r * Q ≤ 1 / 2 := by
      rw [hrQ]
      have a2 := (abs_le.mp hQE).2
      have e2 : 9 * (3 * (1 + β) * (3 * (1 + β)) * (ε * r)) =
          81 * (ε * r) + 162 * (β * (ε * r)) + 81 * (β * β * (ε * r)) := by ring
      have e3 : 27 * β ^ 2 = 27 * (β * β) := by ring
      linarith
    have hprod : (191 / 200) * (19 / 10) ≤ n2 * (r * S) :=
      mul_le_mul hn2lo hrSlo (by norm_num) hn2pos.le
    have hnum : 0 < n2 * S - Q := by
      have e : r * (n2 * S - Q) = n2 * (r * S) - r * Q := by ring
      have h1 : 0 < r * (n2 * S - Q) := by rw [e]; linarith
      exact pos_of_mul_pos_right h1 hr.le
    
    have hN : 0 < Real.sqrt n2 := Real.sqrt_pos.mpr hn2pos
    have hN2 : Real.sqrt n2 ^ 2 = n2 := Real.sq_sqrt hn2pos.le
    have key : S / Real.sqrt n2 - Q / Real.sqrt n2 ^ 3 =
        (Real.sqrt n2 ^ 2 * S - Q) / Real.sqrt n2 ^ 3 := by
      field_simp
    rw [key, hN2]
    exact div_pos hnum (pow_pos hN 3)
  
  have hrad : ∃ Rb : ℝ, R ≤ Rb ∧ ∀ r : ℝ, Rb < r → C * r ^ (-q) ≤ 1 / 100000 := by
    refine ⟨max R ((C * 100000) ^ (1 / q)), le_max_left _ _, fun r hr => ?_⟩
    have hr1 : R < r := lt_of_le_of_lt (le_max_left _ _) hr
    have hr0 : 0 < r := by linarith
    have hC' : 0 ≤ C * 100000 := by positivity
    have ht0 : 0 ≤ (C * 100000) ^ (1 / q) := Real.rpow_nonneg hC' _
    have htr : (C * 100000) ^ (1 / q) < r := lt_of_le_of_lt (le_max_right _ _) hr
    have htq : ((C * 100000) ^ (1 / q)) ^ q = C * 100000 := by
      rw [one_div, Real.rpow_inv_rpow hC' hq.ne']
    have h1 : C * 100000 < r ^ q := by
      rw [← htq]; exact Real.rpow_lt_rpow ht0 htr hq
    have hrq : 0 < r ^ q := Real.rpow_pos_of_pos hr0 q
    rw [Real.rpow_neg hr0.le, ← div_eq_mul_inv, div_le_iff₀ hrq]
    linarith
  obtain ⟨Rb, hRRb, hRb⟩ := hrad
  refine ⟨Rb, hRRb, fun y hy => ?_⟩
  
  have hRr : R < ‖y‖ := lt_of_le_of_lt hRRb hy
  have hr0 : 0 < ‖y‖ := by linarith
  have hy0 : y ≠ 0 := norm_pos_iff.mp hr0
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, C * ‖y‖ ^ (-q) = δ := ⟨_, rfl⟩
  have hδ0 : 0 ≤ δ := by rw [← hδdef]; exact mul_nonneg hC (Real.rpow_nonneg hr0.le _)
  have hδ1 : δ ≤ 1 / 100000 := by rw [← hδdef]; exact hRb _ hy
  have hG1 : ∀ i j : Fin 3, |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ δ := by
    intro i j; rw [← hδdef]; exact (hdec y hRr i j).1
  have hG2 : ∀ i j k : Fin 3, |partialDeriv k (fun z => G z i j) y| ≤ δ / ‖y‖ := by
    intro i j k
    have h := (hdec y hRr i j).2 k
    rw [Real.rpow_sub_one hr0.ne' (-q), ← mul_div_assoc, hδdef] at h
    exact h
  have hGB : ∀ i j : Fin 3, |G y i j| ≤ 1 + δ := by
    intro i j
    have h1 := hG1 i j
    have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    calc |G y i j| = |(G y i j - (if i = j then (1 : ℝ) else 0)) + (if i = j then (1 : ℝ) else 0)| := by
          ring_nf
      _ ≤ |G y i j - (if i = j then (1 : ℝ) else 0)| + |(if i = j then (1 : ℝ) else 0)| :=
          abs_add_le _ _
      _ ≤ δ + 1 := add_le_add h1 h2
      _ = 1 + δ := by ring
  have hinv := inv3_entry_bounds (G y) (1 + δ) δ (hdet y hRr) hGB hG1
  have hchr : ∀ k i j : Fin 3, |christoffel G k i j y| ≤ 18 * (1 + δ) ^ 2 * δ / ‖y‖ := by
    intro k i j
    have h := (christoffel_value_bounds (G y)⁻¹ (fun _ _ _ => 0)
      (fun c a b' => partialDeriv c (fun z => G z a b') y) (fun _ _ _ _ => 0)
      (4 * (1 + δ) ^ 2) (12 * (1 + δ) ^ 2 * δ) 0 (δ / ‖y‖) 0
      (fun k l => (hinv k l).1) (fun k l => (hinv k l).2) (by intros; simp)
      (fun c a b' => hG2 a b' c) (by intros; simp) 0 k i j).1
    unfold christoffel
    calc _ ≤ 9 / 2 * (4 * (1 + δ) ^ 2) * (δ / ‖y‖) := h
      _ = 18 * (1 + δ) ^ 2 * δ / ‖y‖ := by ring
  obtain ⟨hn1, hn2⟩ := coordSphere_norm_partials y hy0
  have hsq : ∑ i : Fin 3, (y i) ^ 2 = ‖y‖ ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq]
    simp [Real.norm_eq_abs, sq_abs]
  have hν : ∑ i : Fin 3, (y i / ‖y‖) ^ 2 = 1 := by
    simp only [div_pow]
    rw [← Finset.sum_div, hsq]
    exact div_self (by positivity)
  have hνb : ∀ k : Fin 3, |y k / ‖y‖| ≤ 1 := by
    intro k
    have h : (y k / ‖y‖) ^ 2 ≤ 1 := by
      rw [← hν]
      exact Finset.single_le_sum (f := fun i => (y i / ‖y‖) ^ 2) (fun i _ => sq_nonneg _)
        (Finset.mem_univ k)
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg (y k / ‖y‖ + 1), sq_nonneg (y k / ‖y‖ - 1)]
  have hH : ∀ i j : Fin 3, |hessLoc G (fun z => ‖z‖) i j y -
      ((if i = j then (1 : ℝ) else 0) - y i / ‖y‖ * (y j / ‖y‖)) / ‖y‖| ≤
      54 * (1 + δ) ^ 2 * δ / ‖y‖ := by
    intro i j
    have e1 : hessLoc G (fun z => ‖z‖) i j y -
        ((if i = j then (1 : ℝ) else 0) - y i / ‖y‖ * (y j / ‖y‖)) / ‖y‖ =
        -(∑ k : Fin 3, christoffel G k i j y * (y k / ‖y‖)) := by
      unfold hessLoc
      rw [hn2 i j]
      simp only [hn1]
      ring
    rw [e1, abs_neg, Fin.sum_univ_three]
    have hk : ∀ k : Fin 3, |christoffel G k i j y * (y k / ‖y‖)| ≤
        18 * (1 + δ) ^ 2 * δ / ‖y‖ := by
      intro k
      rw [abs_mul]
      calc _ ≤ 18 * (1 + δ) ^ 2 * δ / ‖y‖ * 1 :=
            mul_le_mul (hchr k i j) (hνb k) (abs_nonneg _) (by positivity)
        _ = _ := mul_one _
    calc _ ≤ _ := abs_add_three _ _ _
      _ ≤ _ := add_le_add_three (hk 0) (hk 1) (hk 2)
      _ = _ := by ring
  have hbA : 12 * (1 + δ) ^ 2 * δ ≤ 1 / 200 := by nlinarith
  have hεr : 54 * (1 + δ) ^ 2 * δ / ‖y‖ * ‖y‖ ≤ 1 / 200 := by
    rw [div_mul_cancel₀ _ hr0.ne']; nlinarith
  unfold levelMeanCurvCoord lapLoc
  simp only [hn1]
  exact coordSphere_alg_pos (G y)⁻¹ (fun i j => hessLoc G (fun z => ‖z‖) i j y)
    (fun a => y a / ‖y‖) ‖y‖ (12 * (1 + δ) ^ 2 * δ) (54 * (1 + δ) ^ 2 * δ / ‖y‖) hr0
    (by positivity) hbA (by positivity) hεr hν (fun i j => (hinv i j).2) hH

theorem sepRiemPer_le_of_tendsto [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (U F : Set M) (Fs : ℕ → Set M) (m : ENNReal) (hF : sepChartMeas F)
    (hFs : ∀ n, sepChartMeas (Fs n))
    (hconv : ∀ (p : M) (C : Set E3), IsCompact C → C ⊆ (chartAt E3 p).target →
      Tendsto (fun n => volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ (chartAt E3 p).source) ∩ C))
        atTop (𝓝 0))
    (hlim : Tendsto (fun n => sepRiemPer g (Fs n) U) atTop (𝓝 m)) :
    sepRiemPer g F U ≤ m :=
by
  classical
  
  have s1 : ∀ (p : M) (X : E3 → E3), ContDiff ℝ ∞ X → tsupport X ⊆ (chartAt E3 p).target →
      Continuous (sepDensDiv (g.coeff (chartAt E3 p).symm) X) ∧
        ∀ y : E3, y ∉ tsupport X → sepDensDiv (g.coeff (chartAt E3 p).symm) X y = 0 := by
    intro p X hX hXt
    have hTo : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
    have hent : ∀ i j : Fin 3, ContDiffOn ℝ ∞
        (fun z => g.coeff (chartAt E3 p).symm z i j) (chartAt E3 p).target :=
      fun i j => g.smooth p i j
    have hdet : ContDiffOn ℝ ∞ (fun z => (g.coeff (chartAt E3 p).symm z).det)
        (chartAt E3 p).target := by
      have hfun : (fun z => (g.coeff (chartAt E3 p).symm z).det) = fun z =>
          g.coeff (chartAt E3 p).symm z 0 0 * g.coeff (chartAt E3 p).symm z 1 1 *
              g.coeff (chartAt E3 p).symm z 2 2
            - g.coeff (chartAt E3 p).symm z 0 0 * g.coeff (chartAt E3 p).symm z 1 2 *
              g.coeff (chartAt E3 p).symm z 2 1
            - g.coeff (chartAt E3 p).symm z 0 1 * g.coeff (chartAt E3 p).symm z 1 0 *
              g.coeff (chartAt E3 p).symm z 2 2
            + g.coeff (chartAt E3 p).symm z 0 1 * g.coeff (chartAt E3 p).symm z 1 2 *
              g.coeff (chartAt E3 p).symm z 2 0
            + g.coeff (chartAt E3 p).symm z 0 2 * g.coeff (chartAt E3 p).symm z 1 0 *
              g.coeff (chartAt E3 p).symm z 2 1
            - g.coeff (chartAt E3 p).symm z 0 2 * g.coeff (chartAt E3 p).symm z 1 1 *
              g.coeff (chartAt E3 p).symm z 2 0 := by
        funext z
        exact Matrix.det_fin_three _
      rw [hfun]
      exact (((((((hent 0 0).mul (hent 1 1)).mul (hent 2 2)).sub
        (((hent 0 0).mul (hent 1 2)).mul (hent 2 1))).sub
        (((hent 0 1).mul (hent 1 0)).mul (hent 2 2))).add
        (((hent 0 1).mul (hent 1 2)).mul (hent 2 0))).add
        (((hent 0 2).mul (hent 1 0)).mul (hent 2 1))).sub
        (((hent 0 2).mul (hent 1 1)).mul (hent 2 0))
    have hsqrt : ContDiffOn ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det)
        (chartAt E3 p).target :=
      hdet.sqrt (fun z hz => ne_of_gt (coeff_chart_symm_posDef g p z hz).det_pos)
    have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i =>
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hX
    have hφ : ∀ i : Fin 3, ContDiff ℝ ∞
        (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) := by
      intro i
      rw [contDiff_iff_contDiffAt]
      intro z
      by_cases hz : z ∈ (chartAt E3 p).target
      · exact (hsqrt.mul (hXi i).contDiffOn).contDiffAt (hTo.mem_nhds hz)
      · have hz' : z ∉ tsupport X := fun h => hz (hXt h)
        have hev : X =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hz'
        refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
        filter_upwards [hev] with w hw
        simp [hw]
    refine ⟨?_, ?_⟩
    · show Continuous (fun y => ∑ i : Fin 3,
        fderiv ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) y (e i))
      refine continuous_finset_sum _ (fun i _ => ?_)
      exact ((hφ i).continuous_fderiv (by simp)).clm_apply continuous_const
    · intro y hy
      have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 hy
      show ∑ i : Fin 3,
        fderiv ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) y (e i) = 0
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have h2 : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) =ᶠ[𝓝 y]
          (fun _ => (0 : ℝ)) := by
        filter_upwards [hev] with w hw
        simp [hw]
      rw [h2.fderiv_eq]
      simp
  
  have s2 : ∀ (f : E3 → ℝ) (C S : Set E3) (Ss : ℕ → Set E3) (B : ℝ), IsCompact C →
      Continuous f → (∀ y : E3, y ∉ C → f y = 0) → (∀ y : E3, |f y| ≤ B) → MeasurableSet S →
      (∀ n, MeasurableSet (Ss n)) →
      Tendsto (fun n => volume (symmDiff (Ss n) S ∩ C)) atTop (𝓝 0) →
      Tendsto (fun n => ∫ y in Ss n, f y) atTop (𝓝 (∫ y in S, f y)) := by
    intro f C S Ss B hC hf hfC hB hS hSs hc
    have hCm : MeasurableSet C := hC.isClosed.measurableSet
    have hCfin : volume C < ⊤ := hC.measure_lt_top
    have hfi : Integrable f := hf.integrable_of_hasCompactSupport (HasCompactSupport.intro hC hfC)
    have hB0 : 0 ≤ B := le_trans (abs_nonneg _) (hB 0)
    have key : ∀ A : Set E3, ‖∫ y in A, f y‖ ≤ B * (volume (A ∩ C)).toReal := by
      intro A
      have h1 : ∫ y in A, f y = ∫ y in A ∩ C, f y := by
        have e := integral_inter_add_diff (s := A) (f := f) (μ := volume) hCm hfi.integrableOn
        have z : ∫ y in A \ C, f y = 0 :=
          setIntegral_eq_zero_of_forall_eq_zero (fun y hy => hfC y hy.2)
        rw [z, add_zero] at e
        exact e.symm
      rw [h1]
      have h2 := norm_setIntegral_le_of_norm_le_const
        (lt_of_le_of_lt (measure_mono Set.inter_subset_right) hCfin)
        (fun y _ => by rw [Real.norm_eq_abs]; exact hB y) (f := f) (s := A ∩ C) (μ := volume)
      simpa [Measure.real] using h2
    have hbound : ∀ n, ‖(∫ y in Ss n, f y) - ∫ y in S, f y‖ ≤
        2 * B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by
      intro n
      have e1 := integral_inter_add_diff hS (hfi.integrableOn (s := Ss n))
      have e2 := integral_inter_add_diff (hSs n) (hfi.integrableOn (s := S))
      have e3 : Ss n ∩ S = S ∩ Ss n := Set.inter_comm _ _
      have hd : (∫ y in Ss n, f y) - ∫ y in S, f y =
          (∫ y in Ss n \ S, f y) - ∫ y in S \ Ss n, f y := by
        rw [← e1, ← e2, e3]; ring
      rw [hd]
      have hfin : volume (symmDiff (Ss n) S ∩ C) ≠ ⊤ :=
        ne_top_of_le_ne_top hCfin.ne (measure_mono Set.inter_subset_right)
      have m1 : (volume ((Ss n \ S) ∩ C)).toReal ≤ (volume (symmDiff (Ss n) S ∩ C)).toReal :=
        ENNReal.toReal_mono hfin (measure_mono (Set.inter_subset_inter_left _
          (by rw [Set.symmDiff_def]; exact Set.subset_union_left)))
      have m2 : (volume ((S \ Ss n) ∩ C)).toReal ≤ (volume (symmDiff (Ss n) S ∩ C)).toReal :=
        ENNReal.toReal_mono hfin (measure_mono (Set.inter_subset_inter_left _
          (by rw [Set.symmDiff_def]; exact Set.subset_union_right)))
      calc ‖(∫ y in Ss n \ S, f y) - ∫ y in S \ Ss n, f y‖
          ≤ ‖∫ y in Ss n \ S, f y‖ + ‖∫ y in S \ Ss n, f y‖ := norm_sub_le _ _
        _ ≤ B * (volume ((Ss n \ S) ∩ C)).toReal + B * (volume ((S \ Ss n) ∩ C)).toReal :=
            add_le_add (key _) (key _)
        _ ≤ B * (volume (symmDiff (Ss n) S ∩ C)).toReal +
              B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by gcongr
        _ = 2 * B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by ring
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) hbound ?_
    have h0 : Tendsto (fun n => (volume (symmDiff (Ss n) S ∩ C)).toReal) atTop (𝓝 0) := by
      have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hc
      simpa using this
    simpa using h0.const_mul (2 * B)
  
  have s3 : ∀ (α : Type) (N : ℕ) (P : Fin N → α → Prop) (a : Fin N → α → ENNReal) (m : ENNReal),
      (∀ k, ∃ x, P k x) → (∀ X : Fin N → α, (∀ k, P k (X k)) → ∑ k, a k (X k) ≤ m) →
      ∑ k, ⨆ (x : α) (_ : P k x), a k x ≤ m := by
    intro α N P a m hne h
    choose X₀ hX₀ using hne
    have heq : ∀ k, (⨆ (x : α) (_ : P k x), a k x) =
        ⨆ X : {X : Fin N → α // ∀ k, P k (X k)}, a k (X.1 k) := by
      intro k
      apply le_antisymm
      · refine iSup₂_le fun x hx => ?_
        refine le_iSup_of_le ⟨Function.update X₀ k x, fun j => ?_⟩ ?_
        · by_cases hj : j = k
          · subst hj; simp [hx]
          · simp [Function.update_of_ne hj, hX₀ j]
        · simp
      · exact iSup_le fun X => le_iSup₂_of_le (X.1 k) (X.2 k) le_rfl
    rw [Finset.sum_congr rfl (fun k _ => heq k)]
    rw [ENNReal.finsetSum_iSup]
    · exact iSup_le fun X => h X.1 X.2
    · intro X Y
      refine ⟨⟨fun k => if a k (X.1 k) ≤ a k (Y.1 k) then Y.1 k else X.1 k,
        fun k => by dsimp only; split_ifs; exacts [Y.2 k, X.2 k]⟩, fun k => ?_⟩
      dsimp only
      split_ifs with hk
      · exact ⟨hk, le_rfl⟩
      · exact ⟨le_rfl, (not_le.1 hk).le⟩
  
  unfold sepRiemPer
  refine iSup_le fun N => iSup_le fun p => iSup_le fun W => iSup_le fun hW => ?_
  have hVt : ∀ k, chartAt E3 (p k) '' W k ⊆ (chartAt E3 (p k)).target := by
    intro k
    rintro _ ⟨w, hw, rfl⟩
    exact (chartAt E3 (p k)).map_source ((hW.1 k).2 hw).2
  
  unfold sepPerG
  refine s3 (E3 → E3) N (fun k X => ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
      tsupport X ⊆ chartAt E3 (p k) '' W k ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 (p k)).symm y i j * X y i * X y j ≤ 1)
    (fun k X => ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source),
      sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y)) m ?_ ?_
  · intro k
    refine ⟨0, contDiff_const, HasCompactSupport.zero, ?_, fun y => by simp⟩
    rw [tsupport_zero]
    exact Set.empty_subset _
  intro Xs hXs
  
  have hterm : ∀ k, Tendsto (fun n => ENNReal.ofReal
      (∫ y in chartAt E3 (p k) '' (Fs n ∩ (chartAt E3 (p k)).source),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Xs k) y)) atTop
      (𝓝 (ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Xs k) y))) := by
    intro k
    obtain ⟨hXd, hXc, hXV, -⟩ := hXs k
    have hCt : tsupport (Xs k) ⊆ (chartAt E3 (p k)).target := hXV.trans (hVt k)
    obtain ⟨hc, hz⟩ := s1 (p k) (Xs k) hXd hCt
    obtain ⟨B, hB⟩ := IsCompact.exists_bound_of_continuousOn hXc hc.continuousOn
    have hB' : ∀ y, |sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Xs k) y| ≤ max B 0 := by
      intro y
      by_cases hy : y ∈ tsupport (Xs k)
      · have := hB y hy
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _)
      · rw [hz y hy, abs_zero]
        exact le_max_right _ _
    refine ENNReal.tendsto_ofReal (s2 _ (tsupport (Xs k)) _ _ (max B 0) hXc hc hz hB'
      (hF (p k)) (fun n => hFs n (p k)) ?_)
    have hsub : ∀ n, symmDiff (chartAt E3 (p k) '' (Fs n ∩ (chartAt E3 (p k)).source))
        (chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source)) ∩ tsupport (Xs k) ⊆
        chartAt E3 (p k) '' (symmDiff (Fs n) F ∩ (chartAt E3 (p k)).source) ∩ tsupport (Xs k) := by
      intro n
      refine Set.inter_subset_inter_left _ ?_
      exact Set.subset_image_symmDiff.trans
        (Set.image_mono (Set.inter_symmDiff_distrib_right _ _ _).symm.subset)
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
      (hconv (p k) _ hXc hCt) (fun n => zero_le _) (fun n => measure_mono (hsub n))
  
  have hsum := tendsto_finset_sum Finset.univ (fun k _ => hterm k)
  
  refine le_of_tendsto_of_tendsto' hsum hlim (fun n => ?_)
  refine le_trans (Finset.sum_le_sum fun k _ => ?_)
    (?_ : ∑ k, sepPerG (g.coeff (chartAt E3 (p k)).symm)
      (chartAt E3 (p k) '' (Fs n ∩ (chartAt E3 (p k)).source)) (chartAt E3 (p k) '' W k) ≤
        sepRiemPer g (Fs n) U)
  · unfold sepPerG
    exact le_iSup₂_of_le (Xs k) (hXs k) le_rfl
  · unfold sepRiemPer
    exact le_iSup_of_le N (le_iSup_of_le p (le_iSup_of_le W (le_iSup_of_le hW le_rfl)))

theorem sepRiemPer_minimizer_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (K Ω A₀ : Set M) (hK : IsCompact K) (hΩ : IsOpen Ω) (hKΩ : K ⊆ Ω)
    (hA₀ : sepChartMeas A₀) (hfin : sepRiemPer g A₀ Ω < ⊤) :
    ∃ F : Set M, sepChartMeas F ∧ symmDiff F A₀ ⊆ K ∧
      ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ K →
        sepRiemPer g F Ω ≤ sepRiemPer g F' Ω :=
by
  classical
  
  set m : ENNReal := ⨅ (F' : Set M) (_ : sepChartMeas F' ∧ symmDiff F' A₀ ⊆ K),
    sepRiemPer g F' Ω with hm_def
  have hA₀C : sepChartMeas A₀ ∧ symmDiff A₀ A₀ ⊆ K :=
    ⟨hA₀, by rw [symmDiff_self]; exact Set.empty_subset _⟩
  have hmA : m ≤ sepRiemPer g A₀ Ω := iInf₂_le A₀ hA₀C
  have hmtop : m ≠ ⊤ := ne_top_of_le_ne_top hfin.ne hmA
  have hseq : ∀ n : ℕ, ∃ F : Set M, (sepChartMeas F ∧ symmDiff F A₀ ⊆ K) ∧
      sepRiemPer g F Ω < m + ((n + 1 : ℕ) : ENNReal)⁻¹ := by
    intro n
    have hpos : ((n + 1 : ℕ) : ENNReal)⁻¹ ≠ 0 :=
      ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _)
    have hlt : m < m + ((n + 1 : ℕ) : ENNReal)⁻¹ := ENNReal.lt_add_right hmtop hpos
    obtain ⟨F, hF⟩ := iInf_lt_iff.1 hlt
    obtain ⟨hFC, hFlt⟩ := iInf_lt_iff.1 hF
    exact ⟨F, hFC, hFlt⟩
  choose Fs hFsC hFslt using hseq
  have hFsm : ∀ n, sepChartMeas (Fs n) := fun n => (hFsC n).1
  have hFsK : ∀ n, symmDiff (Fs n) A₀ ⊆ K := fun n => (hFsC n).2
  have hmle : ∀ n, m ≤ sepRiemPer g (Fs n) Ω := fun n => iInf₂_le (Fs n) (hFsC n)
  have hinv : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ENNReal)⁻¹) atTop (𝓝 0) :=
    ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)
  have hlim : Tendsto (fun n => sepRiemPer g (Fs n) Ω) atTop (𝓝 m) := by
    have hup : Tendsto (fun n : ℕ => m + ((n + 1 : ℕ) : ENNReal)⁻¹) atTop (𝓝 (m + 0)) :=
      tendsto_const_nhds.add hinv
    rw [add_zero] at hup
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hup hmle
      (fun n => (hFslt n).le)
  obtain ⟨Lr, hLr0, hFsΛ⟩ : ∃ Lr : ℝ, 0 ≤ Lr ∧
      ∀ n, sepRiemPer g (Fs n) Ω ≤ ENNReal.ofReal Lr := by
    refine ⟨(m + 1).toReal, ENNReal.toReal_nonneg, fun n => ?_⟩
    rw [ENNReal.ofReal_toReal (ENNReal.add_ne_top.2 ⟨hmtop, ENNReal.one_ne_top⟩)]
    refine (hFslt n).le.trans (add_le_add le_rfl ?_)
    rw [ENNReal.inv_le_one]
    exact_mod_cast Nat.le_add_left 1 n
  
  have hballex : ∀ x ∈ K, ∃ ε : ℝ, 0 < ε ∧
      ball (chartAt E3 x x) ε ⊆ chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) := by
    intro x hx
    have hO : IsOpen (chartAt E3 x '' (Ω ∩ (chartAt E3 x).source)) :=
      (chartAt E3 x).isOpen_image_of_subset_source (hΩ.inter (chartAt E3 x).open_source)
        Set.inter_subset_right
    have hmem : chartAt E3 x x ∈ chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) :=
      ⟨x, ⟨hKΩ hx, mem_chart_source E3 x⟩, rfl⟩
    exact Metric.isOpen_iff.1 hO _ hmem
  choose! ε hεpos hεsub using hballex
  have hcb : ∀ x ∈ K, closedBall (chartAt E3 x x) (3 * (ε x / 4)) ⊆
      chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) := fun x hx =>
    (closedBall_subset_ball (by linarith [hεpos x hx])).trans (hεsub x hx)
  have himt : ∀ x : M, chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) ⊆ (chartAt E3 x).target := by
    intro x
    rintro _ ⟨y, hy, rfl⟩
    exact (chartAt E3 x).map_source hy.2
  have hnhds : ∀ x ∈ K,
      (chartAt E3 x).symm '' ball (chartAt E3 x x) (ε x / 4 / 2 / 2) ∈ 𝓝 x := by
    intro x hx
    have hpos := hεpos x hx
    have hsub : ball (chartAt E3 x x) (ε x / 4 / 2 / 2) ⊆ (chartAt E3 x).target := by
      intro z hz
      apply himt x
      apply hcb x hx
      exact (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))) hz
    have hopen : IsOpen ((chartAt E3 x).symm '' ball (chartAt E3 x x) (ε x / 4 / 2 / 2)) :=
      (chartAt E3 x).symm.isOpen_image_of_subset_source isOpen_ball
        (by rw [OpenPartialHomeomorph.symm_source]; exact hsub)
    refine hopen.mem_nhds ⟨chartAt E3 x x, mem_ball_self (by linarith), ?_⟩
    exact (chartAt E3 x).left_inv (mem_chart_source E3 x)
  obtain ⟨t, htK, hcov⟩ := hK.elim_nhds_subcover _ hnhds
  obtain ⟨xs, hxs_mem, hxs_surj⟩ : ∃ xs : Fin t.card → M, (∀ j, xs j ∈ t) ∧
      ∀ x ∈ t, ∃ j, xs j = x :=
    ⟨fun j => (t.equivFin.symm j : M), fun j => (t.equivFin.symm j).2,
      fun x hx => ⟨t.equivFin ⟨x, hx⟩, by simp⟩⟩
  have hxsK : ∀ j, xs j ∈ K := fun j => htK _ (hxs_mem j)
  obtain ⟨cs, rs, hrs, hcbs, hcovs⟩ : ∃ (cs : Fin t.card → E3) (rs : Fin t.card → ℝ),
      (∀ j, 0 < rs j) ∧
      (∀ j, closedBall (cs j) (3 * rs j) ⊆ chartAt E3 (xs j) '' (Ω ∩ (chartAt E3 (xs j)).source)) ∧
      K ⊆ ⋃ j, (chartAt E3 (xs j)).symm '' ball (cs j) (rs j / 2 / 2) := by
    refine ⟨fun j => chartAt E3 (xs j) (xs j), fun j => ε (xs j) / 4, fun j => ?_,
      fun j => hcb _ (hxsK j), ?_⟩
    · have := hεpos _ (hxsK j)
      show 0 < ε (xs j) / 4
      linarith
    · intro z hz
      obtain ⟨x, hxt, hzx⟩ := Set.mem_iUnion₂.1 (hcov hz)
      obtain ⟨j, rfl⟩ := hxs_surj x hxt
      exact Set.mem_iUnion.2 ⟨j, hzx⟩
  
  have hW : ∀ (j : Fin t.card) (n : ℕ), sepPerG (g.coeff (chartAt E3 (xs j)).symm)
      (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source)) (ball (cs j) (3 * rs j)) ≤
        sepRiemPer g (Fs n) Ω := by
    intro j n
    have hbt : ball (cs j) (3 * rs j) ⊆ (chartAt E3 (xs j)).target :=
      ball_subset_closedBall.trans ((hcbs j).trans (himt _))
    have hWo : IsOpen ((chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) :=
      (chartAt E3 (xs j)).symm.isOpen_image_of_subset_source isOpen_ball
        (by rw [OpenPartialHomeomorph.symm_source]; exact hbt)
    have hWsub : (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j) ⊆
        Ω ∩ (chartAt E3 (xs j)).source := by
      rintro _ ⟨w, hw, rfl⟩
      obtain ⟨x', hx', rfl⟩ := hcbs j (ball_subset_closedBall hw)
      rw [(chartAt E3 (xs j)).left_inv hx'.2]
      exact hx'
    have himg : chartAt E3 (xs j) '' ((chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) =
        ball (cs j) (3 * rs j) :=
      (chartAt E3 (xs j)).toPartialEquiv.image_symm_image_of_subset_target hbt
    have key : (∑ k : Fin 1, sepPerG (g.coeff (chartAt E3 ((fun _ : Fin 1 => xs j) k)).symm)
        (chartAt E3 ((fun _ : Fin 1 => xs j) k) '' (Fs n ∩
          (chartAt E3 ((fun _ : Fin 1 => xs j) k)).source))
        (chartAt E3 ((fun _ : Fin 1 => xs j) k) ''
          ((fun _ : Fin 1 => (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) k))) ≤
        sepRiemPer g (Fs n) Ω := by
      unfold sepRiemPer
      exact le_iSup_of_le 1 (le_iSup_of_le (fun _ : Fin 1 => xs j)
        (le_iSup_of_le (fun _ : Fin 1 => (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j))
          (le_iSup_of_le ⟨fun _ => ⟨hWo, hWsub⟩,
            fun k l hkl => (hkl (Subsingleton.elim k l)).elim⟩ le_rfl)))
    rw [Fin.sum_univ_one] at key
    dsimp only at key
    rw [himg] at key
    exact key
  have hL4 : ∀ j : Fin t.card, ∃ a : ℝ, 0 ≤ a ∧ ∀ S : Set E3,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (ball (cs j) (3 * rs j)) ≤
        ENNReal.ofReal a * sepPerG (g.coeff (chartAt E3 (xs j)).symm) S (ball (cs j) (3 * rs j)) := by
    intro j
    have h3 : 0 < 3 * rs j := by linarith [hrs j]
    exact sepPerG_one_le_mul (g.coeff (chartAt E3 (xs j)).symm) (chartAt E3 (xs j)).target
      (cs j) (3 * rs j) (chartAt E3 (xs j)).open_target (fun i k => g.smooth (xs j) i k)
      (fun z hz => coeff_chart_symm_posDef g (xs j) z hz) h3 ((hcbs j).trans (himt _))
  choose a ha0 ha using hL4
  
  have hmod : ∀ (j : Fin t.card) (n : ℕ) (h : E3), ‖h‖ ≤ rs j →
      volume (symmDiff (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))
        ((fun x => x + h) ⁻¹' (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))) ∩
          ball (cs j) (rs j)) ≤ ENNReal.ofReal ((2 * a j * Lr) * ‖h‖) := by
    intro j n h hh
    have h5 := sepPerG_one_translate_le (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))
      (cs j) h (rs j) (hFsm n (xs j)) (hrs j) hh
    have h4 : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source)) (ball (cs j) (3 * rs j)) ≤
          ENNReal.ofReal (a j) * ENNReal.ofReal Lr := by
      refine (ha j _).trans ?_
      gcongr
      exact (hW j n).trans (hFsΛ n)
    calc _ ≤ _ := h5
      _ ≤ ENNReal.ofReal (2 * ‖h‖) * (ENNReal.ofReal (a j) * ENNReal.ofReal Lr) := by
          gcongr
      _ = ENNReal.ofReal ((2 * a j * Lr) * ‖h‖) := by
          rw [← ENNReal.ofReal_mul (ha0 j),
            ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * ‖h‖)]
          congr 1
          ring
  
  have hdiag : ∀ k : ℕ, ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ j : Fin t.card, j.val < k →
      ∃ L : Set E3, MeasurableSet L ∧ Tendsto (fun n => volume (symmDiff
        (chartAt E3 (xs j) '' (Fs (φ n) ∩ (chartAt E3 (xs j)).source)) L ∩
          ball (cs j) (rs j / 2))) atTop (𝓝 0) := by
    intro k
    induction k with
    | zero => exact ⟨id, strictMono_id, fun j hj => absurd hj (Nat.not_lt_zero _)⟩
    | succ k ih =>
      obtain ⟨φ, hφ, hφL⟩ := ih
      by_cases hk : k < t.card
      · obtain ⟨ψ, hψ, hcau⟩ := sepSets_cauchy_subseq (cs ⟨k, hk⟩) (rs ⟨k, hk⟩)
          (2 * a ⟨k, hk⟩ * Lr) (hrs _)
          (fun n => chartAt E3 (xs ⟨k, hk⟩) '' (Fs (φ n) ∩ (chartAt E3 (xs ⟨k, hk⟩)).source))
          (fun n => hFsm (φ n) (xs ⟨k, hk⟩)) (fun n h hh => hmod ⟨k, hk⟩ (φ n) h hh)
        obtain ⟨L₀, hL₀m, hL₀⟩ := sepSets_limit_of_cauchy (ball (cs ⟨k, hk⟩) (rs ⟨k, hk⟩ / 2))
          (fun n => chartAt E3 (xs ⟨k, hk⟩) '' (Fs (φ (ψ n)) ∩ (chartAt E3 (xs ⟨k, hk⟩)).source))
          (fun n => hFsm (φ (ψ n)) (xs ⟨k, hk⟩)) hcau
        refine ⟨φ ∘ ψ, hφ.comp hψ, fun j hj => ?_⟩
        rcases Nat.lt_succ_iff_lt_or_eq.1 hj with hj' | hj'
        · obtain ⟨L, hLm, hL⟩ := hφL j hj'
          exact ⟨L, hLm, hL.comp hψ.tendsto_atTop⟩
        · have hjk : j = ⟨k, hk⟩ := Fin.ext hj'
          subst hjk
          exact ⟨L₀, hL₀m, hL₀⟩
      · refine ⟨φ, hφ, fun j hj => hφL j ?_⟩
        have := j.isLt
        omega
  obtain ⟨φ, hφ, hφL⟩ := hdiag t.card
  choose L hLm hL using fun j : Fin t.card => hφL j j.isLt
  
  obtain ⟨F, hFm, hFK, hconv⟩ := sepGlue_chart_limits K A₀ hK hA₀ t.card xs cs
    (fun j => rs j / 2) L (fun n => Fs (φ n))
    (fun j => by show 0 < rs j / 2; linarith [hrs j])
    (fun j => by
      show closedBall (cs j) (rs j / 2) ⊆ (chartAt E3 (xs j)).target
      exact (closedBall_subset_closedBall (by linarith [hrs j])).trans ((hcbs j).trans (himt _)))
    hcovs hLm (fun n => hFsm (φ n)) (fun n => hFsK (φ n)) hL
  
  have hle : sepRiemPer g F Ω ≤ m :=
    sepRiemPer_le_of_tendsto g Ω F (fun n => Fs (φ n)) m hFm (fun n => hFsm (φ n)) hconv
      (hlim.comp hφ.tendsto_atTop)
  
  exact ⟨F, hFm, hFK, fun F' hF'm hF'K => hle.trans (iInf₂_le F' ⟨hF'm, hF'K⟩)⟩

theorem sepMinimizer_eq_far_ae [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (ρ : M → ℝ) (r₁ r₂ s : ℝ) (A F : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ)
    (hcpt : ∀ t : ℝ, IsCompact {p : M | ρ p ≤ t})
    (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) (hr₁₂ : r₁ < r₂) (hr₂s : r₂ < s)
    (hF : sepChartMeas F) (hFA : symmDiff F A ⊆ {p : M | ρ p ≤ r₂})
    (hfin : sepRiemPer g F {p : M | ρ p < s} < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A ⊆ {p : M | ρ p ≤ r₂} →
      sepRiemPer g F {p : M | ρ p < s} ≤ sepRiemPer g F' {p : M | ρ p < s}) :
    sepChartNull (symmDiff F A ∩ {p : M | r₁ < ρ p}) :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have himg : ∀ (x : M) (S : Set M), chartAt E3 x '' (S ∩ (chartAt E3 x).source) =
      (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S := by
    intro x S
    rw [Set.inter_comm]
    exact (chartAt E3 x).image_source_inter_eq' S
  have hopenimg : ∀ (x : M) (S : Set M), IsOpen S →
      MeasurableSet ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S) := by
    intro x S hS
    exact ((chartAt E3 x).isOpen_inter_preimage_symm hS).measurableSet
  have hUo : IsOpen {p : M | r₁ < ρ p} := isOpen_lt continuous_const hρc
  have hΩo : IsOpen {p : M | ρ p < s} := isOpen_lt hρc continuous_const
  have hTFm : sepChartMeas ((F \ {p : M | r₁ < ρ p}) ∪ A) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' ((F \ {p : M | r₁ < ρ p}) ∪ A) =
        (((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F) \
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p})) ∪
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    rw [e]
    exact (hFp.diff (hopenimg x _ hUo)).union (hopenimg x _ hAo)
  have hTFA : symmDiff ((F \ {p : M | r₁ < ρ p}) ∪ A) A ⊆ {p : M | ρ p ≤ r₂} := by
    intro x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hx1, hx2⟩ | ⟨hx1, hx2⟩
    · rcases hx1 with ⟨hxF, -⟩ | hxA
      · exact hFA (Set.mem_symmDiff.2 (Or.inl ⟨hxF, hx2⟩))
      · exact absurd hxA hx2
    · exact absurd (Or.inr hx1) hx2
  have hDm : sepChartMeas (symmDiff F A ∩ {p : M | r₁ < ρ p}) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' (symmDiff F A ∩ {p : M | r₁ < ρ p}) =
        symmDiff ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F)
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) ∩
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p}) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff]
      tauto
    rw [e]
    exact (hFp.symmDiff (hopenimg x _ hAo)).inter (hopenimg x _ hUo)
  have hDK : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} :=
    fun x hx => ⟨le_of_lt hx.2, hFA hx.1⟩
  have hK0c : IsCompact {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} := by
    refine (hcpt r₂).of_isClosed_subset ?_ (fun x hx => hx.2)
    exact (isClosed_le continuous_const hρc).inter (isClosed_le hρc continuous_const)
  have hK0Ω : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ {p : M | ρ p < s} := fun x hx =>
    lt_of_le_of_lt hx.2 hr₂s
  
  have hP0 : calPartition (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) {p : M | ρ p < s} :=
    ⟨fun j => j.elim0, fun j => j.elim0, fun x => by simp, fun j => j.elim0⟩
  obtain ⟨n0, q0, φ0, O0, hφ0, hO0o, hKO0, hφ01, -⟩ :=
    calPartition_extend g {p : M | ρ p < s} hΩo (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) hP0 ∅ isOpen_empty (fun x hx => hx.elim)
      {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} hK0c hK0Ω
  have hDO0 : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ O0 := fun x hx => hKO0 (Or.inl (hDK hx))
  have hKO0' : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ O0 := fun x hx => hKO0 (Or.inl hx)
  
  refine calVolSum_levelMeanCurv_null g ρ r₁ {p : M | ρ p < s} hρ hmc q0 φ0 hφ0 _ hDm
    (fun x hx => hx.2) (fun x hx => hφ01 x (hDO0 hx)) ?_
  by_contra hGpos
  push_neg at hGpos
  have hGnn : 0 ≤ calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
      (fun x => g.levelMeanCurv ρ x) := le_of_lt hGpos
  
  have s8 : ∀ (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M),
      (∀ k, IsOpen (W k) ∧ W k ⊆ {p : M | ρ p < s} ∩ (chartAt E3 (pp k)).source) →
      Pairwise (fun k l => Disjoint (W k) (W l)) →
      ∀ Y : Fin m → E3 → E3, (∀ k, ContDiff ℝ ∞ (Y k) ∧ HasCompactSupport (Y k) ∧
        tsupport (Y k) ⊆ chartAt E3 (pp k) '' W k ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (pp k)).symm y i j * Y k y i * Y k y j ≤ 1) →
      (∑ k, ∫ y in chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩
            (chartAt E3 (pp k)).source),
          sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) +
        calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) ≤
        (sepRiemPer g F {p : M | ρ p < s}).toReal := by
    intro m pp W hW hWd Y hY
    obtain ⟨V, K, hV, hV1, hKc, hKΩ, -, hid⟩ :=
      sepRiemPer_witness_field g {p : M | ρ p < s} hΩo m pp W hW hWd Y hY
    obtain ⟨n, q, φ, O', hφ, hO'o, hKO', hφ1, hvol⟩ :=
      calPartition_extend g {p : M | ρ p < s} hΩo q0 φ0 hφ0 O0 hO0o hφ01 K hKc hKΩ
    have hsum := hid n q φ hφ (fun x hx => hφ1 x (hKO' (Or.inl hx))) _ hTFm
    have hgain := hvol (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) hDO0
    rw [hsum, ← hgain]
    refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨V', hV', hV'1, hcal⟩ := calibration_step g ρ r₁ r₂ s A F hρ hcpt hmc hAsub hAo hBo
      hr₁₂ hr₂s hF hFA q φ hφ O' hO'o (fun x hx => hKO' (Or.inr (hKO0' hx))) hφ1 V hV hV1 ε hε
    have h3 := sepRiemPer_ge_calDivSum g F {p : M | ρ p < s} hF hΩo q φ hφ V' hV' hV'1
    have h4 : calDivSum g q φ F V' ≤ (sepRiemPer g F {p : M | ρ p < s}).toReal :=
      (ENNReal.ofReal_le_iff_le_toReal hfin.ne).1 h3
    linarith
  
  have sumsup : ∀ (m : ℕ) (f : Fin m → (E3 → E3) → ENNReal) (a c : ENNReal),
      (∀ X : Fin m → E3 → E3, a + ∑ k, f k (X k) ≤ c) → a + ∑ k, ⨆ Z, f k Z ≤ c := by
    intro m
    induction m with
    | zero =>
      intro f a c h
      simpa using h (fun k => k.elim0)
    | succ m ih =>
      intro f a c h
      rw [Fin.sum_univ_succ, ← add_assoc, ENNReal.add_iSup, ENNReal.iSup_add]
      refine iSup_le fun Z => ?_
      refine ih (fun k => f k.succ) (a + f 0 Z) c fun X => ?_
      have := h (Fin.cons Z X)
      rw [Fin.sum_univ_succ] at this
      simpa [add_assoc] using this
  have trunc : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (S U' : Set E3) (Z : E3 → E3),
      ∃ Z' : E3 → E3, (ContDiff ℝ ∞ Z' ∧ HasCompactSupport Z' ∧ tsupport Z' ⊆ U' ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z' y i * Z' y j ≤ 1) ∧
        0 ≤ ∫ y in S, sepDensDiv G Z' y ∧
        (⨆ (_ : ContDiff ℝ ∞ Z ∧ HasCompactSupport Z ∧ tsupport Z ⊆ U' ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1),
          ENNReal.ofReal (∫ y in S, sepDensDiv G Z y)) ≤
          ENNReal.ofReal (∫ y in S, sepDensDiv G Z' y) := by
    intro G S U' Z
    have h0adm : ContDiff ℝ ∞ (0 : E3 → E3) ∧ HasCompactSupport (0 : E3 → E3) ∧
        tsupport (0 : E3 → E3) ⊆ U' ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (0 : E3 → E3) y i * (0 : E3 → E3) y j ≤ 1 := by
      refine ⟨contDiff_const, HasCompactSupport.zero, ?_, ?_⟩
      · rw [tsupport_zero]
        exact Set.empty_subset _
      · intro y
        simp
    have h0int : ∫ y in S, sepDensDiv G (0 : E3 → E3) y = 0 := by
      have h0 : ∀ y, sepDensDiv G (0 : E3 → E3) y = 0 := by
        intro y
        simp [sepDensDiv, partialDeriv]
      simp [h0]
    by_cases hc : (ContDiff ℝ ∞ Z ∧ HasCompactSupport Z ∧ tsupport Z ⊆ U' ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1) ∧
        0 ≤ ∫ y in S, sepDensDiv G Z y
    · exact ⟨Z, hc.1, hc.2, iSup_le fun _ => le_rfl⟩
    · refine ⟨0, h0adm, by rw [h0int], iSup_le fun hadm => ?_⟩
      have hneg : ∫ y in S, sepDensDiv G Z y ≤ 0 := by
        by_contra h
        exact hc ⟨hadm, le_of_lt (not_le.1 h)⟩
      rw [ENNReal.ofReal_of_nonpos hneg]
      exact zero_le _
  have key : ∀ (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M),
      ((∀ k, IsOpen (W k) ∧ W k ⊆ {p : M | ρ p < s} ∩ (chartAt E3 (pp k)).source) ∧
        Pairwise (fun k l => Disjoint (W k) (W l))) →
      ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
          (fun x => g.levelMeanCurv ρ x)) +
        ∑ k, sepPerG (g.coeff (chartAt E3 (pp k)).symm)
          (chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source))
          (chartAt E3 (pp k) '' W k) ≤ sepRiemPer g F {p : M | ρ p < s} := by
    intro m pp W hW
    unfold sepPerG
    refine sumsup m _ _ _ fun X => ?_
    beta_reduce
    choose Y hYadm hYnn hYle using fun k => trunc (g.coeff (chartAt E3 (pp k)).symm)
      (chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source))
      (chartAt E3 (pp k) '' W k) (X k)
    have h8 := s8 m pp W hW.1 hW.2 Y hYadm
    calc _ ≤ ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
            (fun x => g.levelMeanCurv ρ x)) +
          ∑ k, ENNReal.ofReal (∫ y in chartAt E3 (pp k) ''
            (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source),
            sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
          gcongr with k
          exact hYle k
      _ = ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
            (fun x => g.levelMeanCurv ρ x) +
          ∑ k, ∫ y in chartAt E3 (pp k) ''
            (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source),
            sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
          rw [ENNReal.ofReal_add hGnn (Finset.sum_nonneg fun k _ => hYnn k),
            ENNReal.ofReal_sum_of_nonneg fun k _ => hYnn k]
      _ ≤ ENNReal.ofReal (sepRiemPer g F {p : M | ρ p < s}).toReal :=
          ENNReal.ofReal_le_ofReal (by linarith)
      _ = sepRiemPer g F {p : M | ρ p < s} := ENNReal.ofReal_toReal hfin.ne
  
  have hle : sepRiemPer g ((F \ {p : M | r₁ < ρ p}) ∪ A) {p : M | ρ p < s} ≤
      sepRiemPer g F {p : M | ρ p < s} -
        ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
          (fun x => g.levelMeanCurv ρ x)) := by
    refine iSup_le fun m => iSup_le fun pp => iSup_le fun W => iSup_le fun hW => ?_
    exact ENNReal.le_sub_of_add_le_left ENNReal.ofReal_ne_top (key m pp W hW)
  have hGc : ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
      (fun x => g.levelMeanCurv ρ x)) ≤ sepRiemPer g F {p : M | ρ p < s} := by
    have h := key 0 (fun k => k.elim0) (fun k => k.elim0)
      ⟨fun k => k.elim0, fun k => k.elim0⟩
    simpa using h
  have hmin' := hmin _ hTFm hTFA
  have h1 : sepRiemPer g F {p : M | ρ p < s} +
      ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
        (fun x => g.levelMeanCurv ρ x)) ≤ sepRiemPer g F {p : M | ρ p < s} + 0 := by
    calc _ ≤ (sepRiemPer g F {p : M | ρ p < s} -
          ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
            (fun x => g.levelMeanCurv ρ x))) +
          ENNReal.ofReal (calVolSum g q0 φ0 (symmDiff F A ∩ {p : M | r₁ < ρ p})
            (fun x => g.levelMeanCurv ρ x)) := by gcongr; exact hmin'.trans hle
      _ = sepRiemPer g F {p : M | ρ p < s} := tsub_add_cancel_of_le hGc
      _ = sepRiemPer g F {p : M | ρ p < s} + 0 := (add_zero _).symm
  have h2 := (ENNReal.add_le_add_iff_left hfin.ne).1 h1
  have h3 := ENNReal.ofReal_eq_zero.1 (le_antisymm h2 (zero_le _))
  linarith

theorem sepRiemPer_add_chart_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F₁ F₂ Ω : Set M) (p : M) (K' V₁ V₂ : Set E3) (hF₁ : sepChartMeas F₁) (hF₂ : sepChartMeas F₂) (hK' : IsCompact K') (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hK'V₂ : K' ⊆ V₂) (hV₂c : IsCompact (closure V₂)) (hV₂V₁ : closure V₂ ⊆ V₁) (hV₁Ω : V₁ ⊆ chartAt E3 p '' (Ω ∩ (chartAt E3 p).source)) (hsd : symmDiff F₁ F₂ ⊆ (chartAt E3 p).symm '' K') : sepRiemPer g F₂ Ω + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) V₂ ≤ sepRiemPer g F₁ Ω + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source)) V₁ + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) (V₁ \ K') :=
by
  classical
  haveI : Nonempty M := ⟨p⟩
  
  have mono : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E A B : Set E3), A ⊆ B →
      sepPerG G' E A ≤ sepPerG G' E B := by
    intro G' E A B hAB
    unfold sepPerG
    exact iSup₂_mono' fun X hX => ⟨X, ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2⟩, le_rfl⟩
  have densZero : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (y : E3),
      y ∉ tsupport X → sepDensDiv G' X y = 0 := by
    intro G' X y hy
    have hX : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have h : (fun z => Real.sqrt (G' z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    rw [h.fderiv_eq]
    simp
  have congrP : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E₁ E₂ A : Set E3), MeasurableSet E₁ →
      MeasurableSet E₂ → E₁ ∩ A = E₂ ∩ A → sepPerG G' E₁ A = sepPerG G' E₂ A := by
    intro G' E₁ E₂ A h1 h2 h
    unfold sepPerG
    refine iSup_congr fun X => iSup_congr fun hX => ?_
    congr 1
    rw [← integral_indicator h1, ← integral_indicator h2]
    congr 1
    funext y
    by_cases hyA : y ∈ A
    · have hiff := Set.ext_iff.mp h y
      simp only [Set.mem_inter_iff, hyA, and_true] at hiff
      by_cases hy1 : y ∈ E₁
      · simp [Set.indicator_apply, hy1, hiff.mp hy1]
      · simp [Set.indicator_apply, hy1, (not_congr hiff).mp hy1]
    · have hz := densZero G' X y (fun hy => hyA (hX.2.2.1 hy))
      simp [Set.indicator_apply, hz]
  
  have chartOpen : ∀ (q : M) (S : Set M), IsOpen S → S ⊆ (chartAt E3 q).source →
      IsOpen (chartAt E3 q '' S) := fun q S hS hSs =>
    (chartAt E3 q).isOpen_image_of_subset_source hS hSs
  have chartTgt : ∀ (q : M) (S : Set M), S ⊆ (chartAt E3 q).source →
      chartAt E3 q '' S ⊆ (chartAt E3 q).target := by
    rintro q S hSs _ ⟨x, hx, rfl⟩
    exact (chartAt E3 q).map_source (hSs hx)
  have chartLoc : ∀ (q : M) (E E' S : Set M), S ⊆ (chartAt E3 q).source →
      (∀ x ∈ S, x ∈ E → x ∈ E') →
      chartAt E3 q '' (E ∩ (chartAt E3 q).source) ∩ chartAt E3 q '' S ⊆
        chartAt E3 q '' (E' ∩ (chartAt E3 q).source) ∩ chartAt E3 q '' S := by
    rintro q E E' S hSs hEE' _ ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, ⟨x', hx'S, hx'eq⟩⟩
    have hxx : x' = x := (chartAt E3 q).injOn (hSs hx'S) hxs hx'eq
    subst hxx
    exact ⟨⟨x', ⟨hEE' x' hx'S hxE, hxs⟩, rfl⟩, ⟨x', hx'S, rfl⟩⟩
  have hGsm : ∀ (q : M) (i j : Fin 3),
      ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y i j) (chartAt E3 q).target :=
    fun q i j => g.smooth q i j
  have posDefC : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target →
      (g.coeff (chartAt E3 q).symm y).PosDef := by
    intro q y hy
    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have hkey : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [hkey]
      exact hpos
  have hGdet : ∀ (q : M), ∀ y ∈ (chartAt E3 q).target,
      0 < (g.coeff (chartAt E3 q).symm y).det :=
    fun q y hy => (posDefC q y hy).det_pos
  
  have hV₁t : V₁ ⊆ (chartAt E3 p).target := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hV₁Ω hz
    exact (chartAt E3 p).map_source hx.2
  have hV₁src : (chartAt E3 p).symm '' V₁ ⊆ Ω ∩ (chartAt E3 p).source := by
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hV₁Ω hz
    rw [(chartAt E3 p).left_inv hx.2]
    exact hx
  have hV₂1 : V₂ ⊆ V₁ := subset_closure.trans hV₂V₁
  have hcl1 : closure V₂ ⊆ (chartAt E3 p).target := hV₂V₁.trans hV₁t
  have hV₁'o : IsOpen ((chartAt E3 p).symm '' V₁) :=
    (chartAt E3 p).isOpen_image_symm_of_subset_target hV₁ hV₁t
  have hV₂'o : IsOpen ((chartAt E3 p).symm '' V₂) :=
    (chartAt E3 p).isOpen_image_symm_of_subset_target hV₂ (hV₂1.trans hV₁t)
  have hC₂c : IsClosed ((chartAt E3 p).symm '' closure V₂) :=
    (hV₂c.image_of_continuousOn ((chartAt E3 p).continuousOn_symm.mono hcl1)).isClosed
  have hC₂V₁' : (chartAt E3 p).symm '' closure V₂ ⊆ (chartAt E3 p).symm '' V₁ :=
    Set.image_mono hV₂V₁
  have hV₂'C₂ : (chartAt E3 p).symm '' V₂ ⊆ (chartAt E3 p).symm '' closure V₂ :=
    Set.image_mono subset_closure
  have hV₂'src : (chartAt E3 p).symm '' V₂ ⊆ Ω ∩ (chartAt E3 p).source :=
    (Set.image_mono hV₂1).trans hV₁src
  have hR5 : ∀ x, x ∉ (chartAt E3 p).symm '' closure V₂ → (x ∈ F₁ ↔ x ∈ F₂) := by
    intro x hx
    by_contra h
    apply hx
    apply Set.image_mono (hK'V₂.trans subset_closure)
    apply hsd
    rw [Set.mem_symmDiff]
    tauto
  have himV₁ : chartAt E3 p '' ((chartAt E3 p).symm '' V₁) = V₁ :=
    (chartAt E3 p).toPartialEquiv.image_symm_image_of_subset_target hV₁t
  have himV₂ : chartAt E3 p '' ((chartAt E3 p).symm '' V₂) = V₂ :=
    (chartAt E3 p).toPartialEquiv.image_symm_image_of_subset_target (hV₂1.trans hV₁t)
  
  have key : ∀ (n : ℕ) (pf : Fin n → M) (W : Fin n → Set M),
      ((∀ k, IsOpen (W k) ∧ W k ⊆ Ω ∩ (chartAt E3 (pf k)).source) ∧
        Pairwise (fun k l => Disjoint (W k) (W l))) →
      ∑ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source)) (chartAt E3 (pf k) '' W k) +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) V₂ ≤
      sepRiemPer g F₁ Ω +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          V₁ := by
    intro n pf W hW
    have hWo : ∀ k, IsOpen (W k) := fun k => (hW.1 k).1
    have hWs : ∀ k, W k ⊆ (chartAt E3 (pf k)).source :=
      fun k => (hW.1 k).2.trans Set.inter_subset_right
    have hWΩ : ∀ k, W k ⊆ Ω := fun k => (hW.1 k).2.trans Set.inter_subset_left
    have hAo : ∀ k, IsOpen (W k ∩ (chartAt E3 p).symm '' V₁) := fun k => (hWo k).inter hV₁'o
    have hBo : ∀ k, IsOpen (W k \ (chartAt E3 p).symm '' closure V₂) :=
      fun k => (hWo k).sdiff hC₂c
    have hAs : ∀ k, W k ∩ (chartAt E3 p).symm '' V₁ ⊆ (chartAt E3 (pf k)).source :=
      fun k => Set.inter_subset_left.trans (hWs k)
    have hBs : ∀ k, W k \ (chartAt E3 p).symm '' closure V₂ ⊆ (chartAt E3 (pf k)).source :=
      fun k => Set.diff_subset.trans (hWs k)
    have hAp : ∀ k, W k ∩ (chartAt E3 p).symm '' V₁ ⊆ (chartAt E3 p).source :=
      fun k => Set.inter_subset_right.trans (hV₁src.trans Set.inter_subset_right)
    
    have h7 : ∀ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source)) (chartAt E3 (pf k) '' W k) ≤
        sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k ∩ (chartAt E3 p).symm '' V₁)) +
        sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂)) := by
      intro k
      refine (mono _ _ _ _ ?_).trans (sepPerG_union_le _ _ _ _ _ (chartAt E3 (pf k)).open_target
        (hGsm (pf k)) (hGdet (pf k)) (hF₂ (pf k)) (chartOpen _ _ (hAo k) (hAs k))
        (chartOpen _ _ (hBo k) (hBs k)) (chartTgt _ _ (hAs k)) (chartTgt _ _ (hBs k)))
      rintro _ ⟨x, hx, rfl⟩
      by_cases hxC : x ∈ (chartAt E3 p).symm '' closure V₂
      · exact Or.inl ⟨x, ⟨hx, hC₂V₁' hxC⟩, rfl⟩
      · exact Or.inr ⟨x, ⟨hx, hxC⟩, rfl⟩
    
    have h8 : ∀ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂)) =
        sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂)) := by
      intro k
      refine congrP _ _ _ _ (hF₂ (pf k)) (hF₁ (pf k)) (Set.Subset.antisymm ?_ ?_)
      · exact chartLoc _ _ _ _ (hBs k) fun x hx hxF => (hR5 x hx.2).2 hxF
      · exact chartLoc _ _ _ _ (hBs k) fun x hx hxF => (hR5 x hx.2).1 hxF
    
    have h9 : ∀ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k ∩ (chartAt E3 p).symm '' V₁)) ≤
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          (chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) :=
      fun k => sepPerG_chart_le g p (pf k) F₂ _ hF₂ (hAo k) (hAp k) (hAs k)
    
    have h9b : ∑ k, sepPerG (g.coeff (chartAt E3 p).symm)
          (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          (chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) ≤
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          V₁ := by
      refine (sepPerG_sum_le _ _ (hF₂ p) n
        (fun k => chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) ?_).trans
        (mono _ _ _ _ ?_)
      · intro k l hkl
        rw [Set.disjoint_left]
        rintro _ ⟨x, hx, rfl⟩ ⟨x', hx', hxx'⟩
        have hxx : x' = x := (chartAt E3 p).injOn (hAp l hx') (hAp k hx) hxx'
        subst hxx
        exact Set.disjoint_left.1 (hW.2 hkl) hx.1 hx'.1
      · refine Set.iUnion_subset fun k => ?_
        exact (Set.image_mono Set.inter_subset_right).trans himV₁.le
    
    have h10 : ∑ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂)) +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
          V₂ ≤ sepRiemPer g F₁ Ω := by
      obtain ⟨W', hW'c, hW'l⟩ : ∃ W' : Fin (n + 1) → Set M,
          (∀ k, W' (Fin.castSucc k) = W k \ (chartAt E3 p).symm '' closure V₂) ∧
          W' (Fin.last n) = (chartAt E3 p).symm '' V₂ :=
        ⟨Fin.snoc (α := fun _ => Set M) (fun k => W k \ (chartAt E3 p).symm '' closure V₂)
          ((chartAt E3 p).symm '' V₂), fun k => by simp, by simp⟩
      obtain ⟨pf', hpc, hpl⟩ : ∃ pf' : Fin (n + 1) → M,
          (∀ k, pf' (Fin.castSucc k) = pf k) ∧ pf' (Fin.last n) = p :=
        ⟨Fin.snoc (α := fun _ => M) pf p, fun k => by simp, by simp⟩
      have dl : ∀ k, Disjoint (W k \ (chartAt E3 p).symm '' closure V₂)
          ((chartAt E3 p).symm '' V₂) := by
        intro k
        rw [Set.disjoint_left]
        intro x hx hx'
        exact hx.2 (hV₂'C₂ hx')
      have hadm : (∀ i, IsOpen (W' i) ∧ W' i ⊆ Ω ∩ (chartAt E3 (pf' i)).source) ∧
          Pairwise (fun i j => Disjoint (W' i) (W' j)) := by
        refine ⟨fun i => ?_, fun i j hij => ?_⟩
        · rcases Fin.eq_castSucc_or_eq_last i with ⟨k, rfl⟩ | rfl
          · rw [hW'c, hpc]
            exact ⟨hBo k, fun x hx => ⟨hWΩ k hx.1, hWs k hx.1⟩⟩
          · rw [hW'l, hpl]
            exact ⟨hV₂'o, hV₂'src⟩
        · rcases Fin.eq_castSucc_or_eq_last i with ⟨k, rfl⟩ | rfl
          · rcases Fin.eq_castSucc_or_eq_last j with ⟨l, rfl⟩ | rfl
            · rw [hW'c, hW'c]
              have hkl : k ≠ l := fun h => hij (by rw [h])
              exact (hW.2 hkl).mono Set.diff_subset Set.diff_subset
            · rw [hW'c, hW'l]
              exact dl k
          · rcases Fin.eq_castSucc_or_eq_last j with ⟨l, rfl⟩ | rfl
            · rw [hW'c, hW'l]
              exact (dl l).symm
            · exact absurd rfl hij
      have hsum : ∑ i, sepPerG (g.coeff (chartAt E3 (pf' i)).symm)
          (chartAt E3 (pf' i) '' (F₁ ∩ (chartAt E3 (pf' i)).source))
          (chartAt E3 (pf' i) '' W' i) =
          ∑ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
            (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
            (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂)) +
          sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
            V₂ := by
        rw [Fin.sum_univ_castSucc]
        simp only [hW'c, hW'l, hpc, hpl, himV₂]
      rw [← hsum]
      unfold sepRiemPer
      exact le_iSup_of_le (n + 1) (le_iSup_of_le pf' (le_iSup_of_le W'
        (le_iSup_of_le hadm le_rfl)))
    
    have step1 : ∑ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source)) (chartAt E3 (pf k) '' W k) ≤
        ∑ k, (sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k ∩ (chartAt E3 p).symm '' V₁)) +
        sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))) :=
      Finset.sum_le_sum fun k _ => (h7 k).trans_eq (by rw [h8 k])
    rw [Finset.sum_add_distrib] at step1
    refine (add_le_add step1 le_rfl).trans ?_
    rw [add_assoc, add_comm (sepRiemPer g F₁ Ω)]
    exact add_le_add ((Finset.sum_le_sum fun k _ => h9 k).trans h9b) h10
  
  have c0 : sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
      V₂ ≤ sepRiemPer g F₁ Ω +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          V₁ := by
    have h := key 0 Fin.elim0 Fin.elim0 ⟨fun k => k.elim0, fun k => k.elim0⟩
    simpa using h
  refine le_trans ?_ le_self_add
  generalize sepRiemPer g F₁ Ω = S₁ at key c0 ⊢
  unfold sepRiemPer
  rw [ENNReal.iSup_add]
  refine iSup_le fun n => ?_
  rw [ENNReal.iSup_add]
  refine iSup_le fun pf => ?_
  rw [ENNReal.iSup_add]
  refine iSup_le fun W => ?_
  by_cases h : (∀ k, IsOpen (W k) ∧ W k ⊆ Ω ∩ (chartAt E3 (pf k)).source) ∧
      Pairwise (fun k l => Disjoint (W k) (W l))
  · rw [iSup_pos h]
    exact key n pf W h
  · rw [iSup_neg h, bot_eq_zero, zero_add]
    exact c0

theorem sepMinimizer_chart_local [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (K Ω O A₀ F : Set M) (hK : IsCompact K) (hΩ : IsOpen Ω)
    (hKΩ : K ⊆ Ω) (hO : IsOpen O) (hOK : O ⊆ K) (hF : sepChartMeas F)
    (hFA : symmDiff F A₀ ⊆ K) (hfin : sepRiemPer g F Ω < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ K →
      sepRiemPer g F Ω ≤ sepRiemPer g F' Ω) (p : M) :
    sepIsPerMin (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F ∩ (chartAt E3 p).source))
      (chartAt E3 p '' (O ∩ (chartAt E3 p).source)) :=
by
  classical
  set κ := chartAt E3 p with hκ
  set G := g.coeff κ.symm with hGdef
  set Φ := κ '' (F ∩ κ.source) with hΦdef
  set U := κ '' (O ∩ κ.source) with hUdef
  have hOΩ : O ⊆ Ω := hOK.trans hKΩ
  
  have hUt : U ⊆ κ.target := by
    rintro _ ⟨x, hx, rfl⟩
    exact κ.map_source hx.2
  
  have hB2 : ∀ Z : Set E3, Z ⊆ U → κ.symm '' Z ⊆ O ∩ κ.source := by
    rintro Z hZ _ ⟨z, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hZ hz
    rw [κ.left_inv hx.2]
    exact hx
  
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) κ.target :=
    fun i j => g.smooth p i j
  have hdet : ∀ y ∈ κ.target, 0 < (G y).det :=
    fun y hy => (coeff_chart_symm_posDef g p y hy).det_pos
  
  have hloc_le : ∀ V : Set E3, IsOpen V → V ⊆ U → sepPerG G Φ V ≤ sepRiemPer g F Ω := by
    intro V hV hVU
    have hVt : V ⊆ κ.target := hVU.trans hUt
    have hWo : IsOpen (κ.symm '' V) := κ.isOpen_image_symm_of_subset_target hV hVt
    have hWsub : κ.symm '' V ⊆ Ω ∩ κ.source := fun x hx =>
      ⟨hOΩ (hB2 V hVU hx).1, (hB2 V hVU hx).2⟩
    have himg : κ '' (κ.symm '' V) = V := κ.toPartialEquiv.image_symm_image_of_subset_target hVt
    rw [← himg]
    unfold sepRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le (fun _ => κ.symm '' V)
      (le_iSup_of_le ⟨fun _ => ⟨hWo, hWsub⟩, fun k l hkl => (hkl (Subsingleton.elim k l)).elim⟩
        ?_)))
    rw [Fin.sum_univ_one]
  unfold sepIsPerMin
  refine ⟨hF p, fun V hV _ hVU => lt_of_le_of_lt (hloc_le V hV (subset_closure.trans hVU)) hfin,
    ?_⟩
  
  intro F' V K' hF' hV _ hVU hK'c hK'V hsd
  have hVU' : V ⊆ U := subset_closure.trans hVU
  have hVt : V ⊆ κ.target := hVU'.trans hUt
  have hK't : K' ⊆ κ.target := hK'V.trans hVt
  set L := κ.symm '' K' with hLdef
  set F'' := (F \ L) ∪ κ.symm '' (F' ∩ K') with hF''def
  have hLO : L ⊆ O := fun x hx => (hB2 K' (hK'V.trans hVU') hx).1
  
  have hP1 : symmDiff F F'' ⊆ L := by
    intro x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hxF, hxF''⟩ | ⟨hxF'', hxF⟩
    · by_contra hxL
      exact hxF'' (Or.inl ⟨hxF, hxL⟩)
    · rcases hxF'' with ⟨hxF', _⟩ | ⟨z, hz, rfl⟩
      · exact absurd hxF' hxF
      · exact ⟨z, hz.2, rfl⟩
  
  have hP2 : symmDiff F'' A₀ ⊆ K := by
    intro x hx
    by_cases hxF : x ∈ F
    · by_cases hxF'' : x ∈ F''
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨_, hA⟩ | ⟨_, hn⟩
        · exact Set.mem_symmDiff.2 (Or.inl ⟨hxF, hA⟩)
        · exact absurd hxF'' hn
      · exact hOK (hLO (hP1 (Set.mem_symmDiff.2 (Or.inl ⟨hxF, hxF''⟩))))
    · by_cases hxF'' : x ∈ F''
      · exact hOK (hLO (hP1 (Set.mem_symmDiff.2 (Or.inr ⟨hxF'', hxF⟩))))
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨h, _⟩ | ⟨hA, _⟩
        · exact absurd h hxF''
        · exact Set.mem_symmDiff.2 (Or.inr ⟨hA, hxF⟩)
  
  have hF'sub : F' \ Φ ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inr hz))
  have hΦsub : Φ \ F' ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inl hz))
  have hP3 : κ '' (F'' ∩ κ.source) = F' := by
    ext z
    constructor
    · rintro ⟨x, ⟨hxF'', hxs⟩, rfl⟩
      rcases hxF'' with ⟨hxF, hxL⟩ | ⟨w, hw, rfl⟩
      · by_contra hz
        have hK : κ x ∈ K' := hΦsub ⟨⟨x, ⟨hxF, hxs⟩, rfl⟩, hz⟩
        exact hxL ⟨κ x, hK, κ.left_inv hxs⟩
      · rw [κ.right_inv (hK't hw.2)]
        exact hw.1
    · intro hz
      by_cases hzK : z ∈ K'
      · exact ⟨κ.symm z, ⟨Or.inr ⟨z, ⟨hz, hzK⟩, rfl⟩, κ.map_target (hK't hzK)⟩,
          κ.right_inv (hK't hzK)⟩
      · have hzΦ : z ∈ Φ := by
          by_contra h
          exact hzK (hF'sub ⟨hz, h⟩)
        obtain ⟨x, ⟨hxF, hxs⟩, rfl⟩ := hzΦ
        refine ⟨x, ⟨Or.inl ⟨hxF, ?_⟩, hxs⟩, rfl⟩
        rintro ⟨w, hw, hwx⟩
        apply hzK
        rw [← hwx, κ.right_inv (hK't hw)]
        exact hw
  
  have hP4 : sepChartMeas F'' := by
    intro q
    set κq := chartAt E3 q with hκq
    have hI : ∀ S : Set M, κq '' (S ∩ κq.source) = κq.target ∩ κq.symm ⁻¹' S := by
      intro S
      rw [Set.inter_comm S]
      exact κq.image_source_inter_eq' S
    have hLc : IsCompact L := hK'c.image_of_continuousOn (κ.continuousOn_symm.mono hK't)
    have hIL : MeasurableSet (κq.target ∩ κq.symm ⁻¹' L) := by
      have ho : IsOpen (κq.target ∩ κq.symm ⁻¹' Lᶜ) :=
        κq.continuousOn_symm.isOpen_inter_preimage κq.open_target hLc.isClosed.isOpen_compl
      have heq : κq.target ∩ κq.symm ⁻¹' L = κq.target \ (κq.target ∩ κq.symm ⁻¹' Lᶜ) := by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff, Set.mem_compl_iff]
        tauto
      rw [heq]
      exact κq.open_target.measurableSet.diff ho.measurableSet
    have hIF : MeasurableSet (κq.target ∩ κq.symm ⁻¹' F) := by
      rw [← hI]
      exact hF q
    have hBt : F' ∩ K' ⊆ κ.target := fun z hz => hK't hz.2
    have hBm : MeasurableSet (F' ∩ K') := hF'.inter hK'c.isClosed.measurableSet
    have hsymmB : κ.symm '' (F' ∩ K') = κ.source ∩ κ ⁻¹' (F' ∩ K') :=
      κ.symm_image_eq_source_inter_preimage hBt
    have hDo : IsOpen (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κq.continuousOn_symm.isOpen_inter_preimage κq.open_target κ.open_source
    have hτc : ContinuousOn (fun z => κ (κq.symm z)) (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κ.continuousOn.comp (κq.continuousOn_symm.mono Set.inter_subset_left) (fun z hz => hz.2)
    have hIB : MeasurableSet ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩
        (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K')) := by
      have hpw : Measurable ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
          (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) :=
        hτc.measurable_piecewise continuousOn_const hDo.measurableSet
      have heq : (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K') =
          (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
            (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) ⁻¹' (F' ∩ K') := by
        ext z
        constructor
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD]
          exact hzB
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD] at hzB
          exact hzB
      rw [heq]
      exact hDo.measurableSet.inter (hpw hBm)
    have hmain : κq.target ∩ κq.symm ⁻¹' F'' =
        ((κq.target ∩ κq.symm ⁻¹' F) \ (κq.target ∩ κq.symm ⁻¹' L)) ∪
          ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K')) := by
      rw [hF''def, hsymmB]
      ext z
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    show MeasurableSet (κq '' (F'' ∩ κq.source))
    rw [hI, hmain]
    exact (hIF.diff hIL).union hIB
  have hP5 : sepRiemPer g F Ω ≤ sepRiemPer g F'' Ω := hmin F'' hP4 hP2
  have hfinV : sepPerG G Φ V < ⊤ := lt_of_le_of_lt (hloc_le V hV hVU') hfin
  have hne : sepRiemPer g F Ω ≠ ⊤ := hfin.ne
  
  refine sepPerG_le_of_local_compare G κ.target Φ F' V K' κ.open_target hGs hdet (hF p) hF' hV
    hVt hK'c hK'V hsd hfinV ?_
  intro V₁ V₂ hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ hV₁V
  have hV₁Ω : V₁ ⊆ κ '' (Ω ∩ κ.source) :=
    hV₁V.trans (hVU'.trans (Set.image_mono (Set.inter_subset_inter_left _ hOΩ)))
  have h3 : sepRiemPer g F'' Ω + sepPerG G Φ V₂ ≤
      sepRiemPer g F Ω + sepPerG G (κ '' (F'' ∩ κ.source)) V₁ + sepPerG G Φ (V₁ \ K') :=
    sepRiemPer_add_chart_le g F F'' Ω p K' V₁ V₂ hF hP4 hK'c hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ hV₁Ω hP1
  rw [hP3] at h3
  have h4 : sepRiemPer g F Ω + sepPerG G Φ V₂ ≤
      sepRiemPer g F Ω + (sepPerG G F' V₁ + sepPerG G Φ (V₁ \ K')) := by
    calc sepRiemPer g F Ω + sepPerG G Φ V₂ ≤ sepRiemPer g F'' Ω + sepPerG G Φ V₂ :=
          add_le_add hP5 le_rfl
      _ ≤ _ := h3
      _ = _ := add_assoc _ _ _
  exact (ENNReal.add_le_add_iff_left hne).1 h4

theorem separating_minimal_surface_of_mean_convex_exhaustion [T2Space M]
    [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (r₁ : ℝ) (A : Set M)
    (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hcpt : ∀ s : ℝ, IsCompact {p : M | ρ p ≤ s})
    (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) :
    ∃ E E' : Set M, IsOpen E ∧ IsOpen E' ∧ Disjoint E E' ∧ A ⊆ E ∧
      {p : M | r₁ < ρ p} \ A ⊆ E' ∧ IsCompact (E ∪ E')ᶜ ∧ IsMinimalSurfaceSet g (E ∪ E')ᶜ :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have hAm : sepChartMeas A := fun p =>
    ((chartAt E3 p).isOpen_image_of_subset_source (hAo.inter (chartAt E3 p).open_source)
      Set.inter_subset_right).measurableSet
  have hfinA := sepRiemPer_far_lt_top g ρ r₁ (r₁ + 2) A hρ hcpt hmc hAsub hAo hBo
  
  have hK : IsCompact {x : M | ρ x ≤ r₁ + 1} := hcpt _
  have hΩ : IsOpen {x : M | ρ x < r₁ + 2} := isOpen_lt hρc continuous_const
  have hKΩ : {x : M | ρ x ≤ r₁ + 1} ⊆ {x : M | ρ x < r₁ + 2} := by
    intro x hx
    have hx' : ρ x ≤ r₁ + 1 := hx
    show ρ x < r₁ + 2
    linarith
  obtain ⟨F, hFm, hFA, hFmin⟩ :=
    sepRiemPer_minimizer_exists g _ _ A hK hΩ hKΩ hAm hfinA
  have hAA : symmDiff A A ⊆ {x : M | ρ x ≤ r₁ + 1} := by
    rw [symmDiff_self]; exact Set.empty_subset _
  have hfinF : sepRiemPer g F {x : M | ρ x < r₁ + 2} < ⊤ :=
    lt_of_le_of_lt (hFmin A hAm hAA) hfinA
  have hnull : sepChartNull (symmDiff F A ∩ {x : M | r₁ < ρ x}) :=
    sepMinimizer_eq_far_ae g ρ r₁ (r₁ + 1) (r₁ + 2) A F hρ hcpt hmc hAsub hAo hBo
      (by linarith) (by linarith) hFm hFA hfinF hFmin
  have hO : IsOpen {x : M | ρ x < r₁ + 1} := isOpen_lt hρc continuous_const
  have hOK : {x : M | ρ x < r₁ + 1} ⊆ {x : M | ρ x ≤ r₁ + 1} := fun x hx =>
    le_of_lt (show ρ x < r₁ + 1 from hx)
  have hloc : ∀ q : M, sepIsPerMin (g.coeff (chartAt E3 q).symm)
      (chartAt E3 q '' (F ∩ (chartAt E3 q).source))
      (chartAt E3 q '' ({x : M | ρ x < r₁ + 1} ∩ (chartAt E3 q).source)) := fun q =>
    sepMinimizer_chart_local g _ _ _ A F hK hΩ hKΩ hO hOK hFm hFA hfinF hFmin q
  
  have N1 : ∀ T T' : Set M, T ⊆ T' → sepChartNull T' → sepChartNull T := by
    intro T T' h h' q
    exact measure_mono_null (Set.image_mono (Set.inter_subset_inter_left _ h)) (h' q)
  have N2 : ∀ T T' : Set M, sepChartNull T → sepChartNull T' → sepChartNull (T ∪ T') := by
    intro T T' h h' q
    show volume (chartAt E3 q '' ((T ∪ T') ∩ (chartAt E3 q).source)) = 0
    rw [Set.union_inter_distrib_right, Set.image_union]
    exact measure_union_null (h q) (h' q)
  have hvolpos : ∀ (s : Set E3) (z : E3), s ∈ 𝓝 z → volume s ≠ 0 := by
    intro s z hs h0
    have h1 : 0 < volume (interior s) :=
      isOpen_interior.measure_pos volume ⟨z, mem_interior_iff_mem_nhds.2 hs⟩
    have h2 : volume (interior s) = 0 := measure_mono_null interior_subset h0
    rw [h2] at h1
    exact lt_irrefl _ h1
  obtain ⟨E, hEdef⟩ : ∃ E : Set M, E = {x | ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} := ⟨_, rfl⟩
  obtain ⟨E', hE'def⟩ : ∃ E' : Set M, E' = {x | ∃ N ∈ 𝓝 x, sepChartNull (N ∩ F)} := ⟨_, rfl⟩
