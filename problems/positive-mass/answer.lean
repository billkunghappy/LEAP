  have hout : ∀ q, q ∉ A.κ j '' Metric.ball (A.c j) (A.r j / 2) → q ∉ A.κ j '' tsupport ζ :=
    fun q hq h => hq (Set.image_mono hsupp h)
  have hBφ : ∀ n, B (U n) ⟨φ, hφV⟩ = ∫ x in ndsHalf (A.c j) (A.r j),
      g.gradInner φ (U n : M → ℝ) (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det := by
    intro n
    rw [hB]
    show ndsInt g A (fun q => g.gradInner (U n : M → ℝ) φ q) = _
    have e1 : (fun q => g.gradInner (U n : M → ℝ) φ q) =
        fun q => g.gradInner φ (U n : M → ℝ) q :=
      funext fun q => (gradInner_symm_nonneg g _ _ q).2
    rw [e1]
    exact ((nds_int_localize g A _ (fun k => (hcc k _ _ hφs (hsm (U n)).1).2.2.1) j).2
