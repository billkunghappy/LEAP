            add_le_add b1 b2
        _ ≤ (2 * B' + B' * (1 + 12 * K₂)) * ‖x‖ ^ (-1 - 2 * q') := by nlinarith

theorem heat_rep_scalar (φ : E3 → ℝ) (hφ : ContDiff ℝ ∞ φ) (hφc : HasCompactSupport φ) (x : E3) :
