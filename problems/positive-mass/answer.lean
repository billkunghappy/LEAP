    have h0int : ∫ y in S, sepDensDiv G (0 : E3 → E3) y = 0 := by
      simp [h0]
    by_cases hc : ((∀ y, y ∉ Kk → ContDiffAt ℝ ∞ Z y) ∧ HasCompactSupport Z ∧
          tsupport Z ⊆ U' ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Z y i * Z y j ≤ 1) ∧
          ∃ C : ℝ, ∀ y, |sepDensDiv G Z y| ≤ C) ∧
        0 ≤ ∫ y in S, sepDensDiv G Z y
    · exact ⟨Z, hc.1, hc.2, iSup_le fun _ => le_rfl⟩
    · refine ⟨0, h0adm, by rw [h0int], iSup_le fun hadm => ?_⟩
      have hneg : ∫ y in S, sepDensDiv G Z y ≤ 0 := by
        by_contra h
        exact hc ⟨hadm, le_of_lt (not_le.1 h)⟩
      rw [ENNReal.ofReal_of_nonpos hneg]
      exact zero_le _
  have key : ∀ (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M),
      ((∀ k, IsOpen (W k) ∧ W k ⊆ {p : M | ρ p < s} ∩ (chartAt E3 (pp k)).source) ∧
        Pairwise (fun k l => Disjoint (W k) (W l))) →
      ENNReal.ofReal Gain +
        ∑ k, hullPerG (g.coeff (chartAt E3 (pp k)).symm)
          (chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source))
          (chartAt E3 (pp k) '' W k) (chartAt E3 (pp k) '' (Kc ∩ (chartAt E3 (pp k)).source)) ≤
        hullRiemPer g F {p : M | ρ p < s} Kc := by
    intro m pp W hW
    unfold hullPerG
    refine sumsup m _ _ _ fun X => ?_
    beta_reduce
    choose Y hYadm hYnn hYle using fun k => trunc (g.coeff (chartAt E3 (pp k)).symm)
      (chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source))
      (chartAt E3 (pp k) '' W k) (chartAt E3 (pp k) '' (Kc ∩ (chartAt E3 (pp k)).source)) (X k)
    have h8 := s10 m pp W hW.1 hW.2 Y hYadm
    calc _ ≤ ENNReal.ofReal Gain +
          ∑ k, ENNReal.ofReal (∫ y in chartAt E3 (pp k) ''
            (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source),
            sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
          gcongr with k
          exact hYle k
      _ = ENNReal.ofReal (Gain +
          ∑ k, ∫ y in chartAt E3 (pp k) ''
            (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source),
            sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) := by
          rw [ENNReal.ofReal_add hGnn (Finset.sum_nonneg fun k _ => hYnn k),
            ENNReal.ofReal_sum_of_nonneg fun k _ => hYnn k]
      _ ≤ ENNReal.ofReal P := ENNReal.ofReal_le_ofReal (by linarith)
      _ = hullRiemPer g F {p : M | ρ p < s} Kc := hPeq.symm
  
  have hle : hullRiemPer g ((F \ {p : M | r₁ < ρ p}) ∪ A) {p : M | ρ p < s} Kc ≤
      hullRiemPer g F {p : M | ρ p < s} Kc - ENNReal.ofReal Gain := by
    refine iSup_le fun m => iSup_le fun pp => iSup_le fun W => iSup_le fun hW => ?_
    exact ENNReal.le_sub_of_add_le_left ENNReal.ofReal_ne_top (key m pp W hW)
  have hGc : ENNReal.ofReal Gain ≤ hullRiemPer g F {p : M | ρ p < s} Kc := by
    have h := key 0 (fun k => k.elim0) (fun k => k.elim0)
      ⟨fun k => k.elim0, fun k => k.elim0⟩
    simpa using h
  have hmin' := hmin _ hTFm hTFA
  have h1 : hullRiemPer g F {p : M | ρ p < s} Kc + ENNReal.ofReal Gain ≤
      hullRiemPer g F {p : M | ρ p < s} Kc + 0 := by
    calc _ ≤ (hullRiemPer g F {p : M | ρ p < s} Kc - ENNReal.ofReal Gain) +
          ENNReal.ofReal Gain := by gcongr; exact hmin'.trans hle
      _ = hullRiemPer g F {p : M | ρ p < s} Kc := tsub_add_cancel_of_le hGc
      _ = hullRiemPer g F {p : M | ρ p < s} Kc + 0 := (add_zero _).symm
  have h2 := (ENNReal.add_le_add_iff_left hfin.ne).1 h1
  have h3 := ENNReal.ofReal_eq_zero.1 (le_antisymm h2 (zero_le _))
  linarith

theorem hull_normalization [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (K Kin A₀ F E : Set M)
    (hK : IsClosed K) (hKin : IsClosed Kin) (hKKin : K ⊆ Kin) (hA₀ : IsOpen A₀)
    (hA₀fr : frontier A₀ ⊆ Kin) (hcoll : sepChartNull (symmDiff F A₀ \ Kin))
    (hE : E = {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}) :
    IsOpen E ∧ Disjoint E K ∧ A₀ \ Kin ⊆ E ∧ E \ Kin ⊆ A₀ ∧ frontier E ⊆ Kin :=
by
  
  have s1 : ∀ S T₁ T₂ : Set M, S ⊆ T₁ ∪ T₂ → sepChartNull T₁ → sepChartNull T₂ →
      sepChartNull S := by
    intro S T₁ T₂ hS h₁ h₂ p
    have hsub : (chartAt E3 p) '' (S ∩ (chartAt E3 p).source) ⊆
        (chartAt E3 p) '' (T₁ ∩ (chartAt E3 p).source) ∪
          (chartAt E3 p) '' (T₂ ∩ (chartAt E3 p).source) := by
      rw [← Set.image_union]
      apply Set.image_mono
      rintro y ⟨hyS, hyU⟩
      rcases hS hyS with h | h
      · exact Or.inl ⟨h, hyU⟩
      · exact Or.inr ⟨h, hyU⟩
    exact MeasureTheory.measure_mono_null hsub
      (MeasureTheory.measure_union_null (h₁ p) (h₂ p))
  
  have s2 : ∀ (N : Set M) (x : M), N ∈ 𝓝 x → ¬ sepChartNull N := by
    intro N x hN h
    have hx : x ∈ (chartAt E3 x).source := mem_chart_source E3 x
    have hN' : N ∩ (chartAt E3 x).source ∈ 𝓝 x :=
      Filter.inter_mem hN ((chartAt E3 x).open_source.mem_nhds hx)
    have himg := (chartAt E3 x).image_mem_nhds hx hN'
    have hpos := MeasureTheory.Measure.measure_pos_of_mem_nhds
      (MeasureTheory.volume : MeasureTheory.Measure E3) himg
    have h0 := h x
    rw [h0] at hpos
    exact lt_irrefl _ hpos
  subst hE
  
  have aux : ∀ y, y ∉ A₀ → y ∉ Kin → y ∉ closure A₀ := by
    intro y hyA hyK hyc
    rw [closure_eq_interior_union_frontier, hA₀.interior_eq] at hyc
    rcases hyc with h | h
    · exact hyA h
    · exact hyK (hA₀fr h)
  have hO : IsOpen ((closure A₀)ᶜ ∩ Kinᶜ) :=
    isClosed_closure.isOpen_compl.inter hKin.isOpen_compl
  
  have C1 : IsOpen {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} := by
    rw [isOpen_iff_mem_nhds]
    rintro x ⟨hxK, N, hN, hnull⟩
    have hW : IsOpen (interior N ∩ Kᶜ) := isOpen_interior.inter hK.isOpen_compl
    have hxW : x ∈ interior N ∩ Kᶜ := ⟨mem_interior_iff_mem_nhds.2 hN, hxK⟩
    refine Filter.mem_of_superset (hW.mem_nhds hxW) ?_
    rintro y ⟨hyN, hyK⟩
    exact ⟨hyK, N, mem_interior_iff_mem_nhds.1 hyN, hnull⟩
  
  have C2 : Disjoint {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} K :=
    Set.disjoint_left.2 fun x hx hxK => hx.1 hxK
  
  have C3 : A₀ \ Kin ⊆ {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} := by
    rintro x ⟨hxA, hxKin⟩
    refine ⟨fun h => hxKin (hKKin h), A₀ \ Kin, (hA₀.sdiff hKin).mem_nhds ⟨hxA, hxKin⟩, ?_⟩
    refine s1 _ (symmDiff F A₀ \ Kin) (symmDiff F A₀ \ Kin) ?_ hcoll hcoll
    rintro y ⟨⟨hyA, hyK⟩, hyF⟩
    exact Or.inl ⟨Set.mem_symmDiff.2 (Or.inr ⟨hyA, hyF⟩), hyK⟩
  
  have C4 : {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} \ Kin ⊆ A₀ := by
    rintro x ⟨⟨hxK, N, hN, hN0⟩, hxKin⟩
    by_contra hxA
    have hxO : x ∈ (closure A₀)ᶜ ∩ Kinᶜ := ⟨aux x hxA hxKin, hxKin⟩
    have hN' : N ∩ ((closure A₀)ᶜ ∩ Kinᶜ) ∈ 𝓝 x := Filter.inter_mem hN (hO.mem_nhds hxO)
    apply s2 _ x hN'
    refine s1 _ (N \ F) (symmDiff F A₀ \ Kin) ?_ hN0 hcoll
    rintro y ⟨hyN, hyc, hyK⟩
    have hyA : y ∉ A₀ := fun h => hyc (subset_closure h)
    by_cases hyF : y ∈ F
    · exact Or.inr ⟨Set.mem_symmDiff.2 (Or.inl ⟨hyF, hyA⟩), hyK⟩
    · exact Or.inl ⟨hyN, hyF⟩
  
  have C5 : frontier {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)} ⊆ Kin := by
    intro x hx
    by_contra hxKin
    rw [C1.frontier_eq] at hx
    obtain ⟨hxc, hxE⟩ := hx
    by_cases hxA : x ∈ A₀
    · exact hxE (C3 ⟨hxA, hxKin⟩)
    · have hxO : x ∈ (closure A₀)ᶜ ∩ Kinᶜ := ⟨aux x hxA hxKin, hxKin⟩
      obtain ⟨y, ⟨hyc, hyK⟩, hyE⟩ := mem_closure_iff.1 hxc _ hO hxO
      have hyA : y ∈ A₀ := C4 ⟨hyE, hyK⟩
      exact hyc (subset_closure hyA)
  exact ⟨C1, C2, C3, C4, C5⟩

theorem sepPerG_sum_le (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E : Set E3) (hE : MeasurableSet E)
    (n : ℕ) (A : Fin n → Set E3) (hdisj : Pairwise (fun k l => Disjoint (A k) (A l))) :
    ∑ k, sepPerG G E (A k) ≤ sepPerG G E (⋃ k, A k) :=
by
  classical
  
  have s2 : ∀ (ι : Fin n → Type) (_hne : ∀ k, Nonempty (ι k)) (f : (k : Fin n) → ι k → ENNReal)
      (T : ENNReal), (∀ σ : (k : Fin n) → ι k, ∑ k, f k (σ k) ≤ T) → ∑ k, ⨆ i, f k i ≤ T := by
    intro ι hne f T h
    let σ₀ : (k : Fin n) → ι k := fun k => Classical.choice (hne k)
    have ha : ∀ k, ⨆ i, f k i ≤ ⨆ σ : ((k : Fin n) → ι k), f k (σ k) := by
      intro k
      refine iSup_le fun i => le_iSup_of_le (Function.update σ₀ k i) ?_
      simp
    have hb : ∑ k, ⨆ σ : ((k : Fin n) → ι k), f k (σ k) =
        ⨆ σ : ((k : Fin n) → ι k), ∑ k, f k (σ k) := by
      refine ENNReal.finsetSum_iSup (fun σ τ => ?_)
      refine ⟨fun a => if f a (σ a) ≤ f a (τ a) then τ a else σ a, fun a => ?_⟩
      by_cases hle : f a (σ a) ≤ f a (τ a)
      · simp only [if_pos hle]; exact ⟨hle, le_rfl⟩
      · simp only [if_neg hle]; exact ⟨le_rfl, le_of_not_ge hle⟩
    calc ∑ k, ⨆ i, f k i ≤ ∑ k, ⨆ σ : ((k : Fin n) → ι k), f k (σ k) :=
          Finset.sum_le_sum fun k _ => ha k
      _ = _ := hb
      _ ≤ T := iSup_le h
  
  have densCongr : ∀ (X X' : E3 → E3) (y : E3), X =ᶠ[𝓝 y] X' →
      sepDensDiv G X y = sepDensDiv G X' y := by
    intro X X' y h
    unfold sepDensDiv partialDeriv
    refine Finset.sum_congr rfl fun i _ => ?_
    have h' : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y]
        (fun z => Real.sqrt (G z).det * X' z i) := by
      filter_upwards [h] with z hz
      rw [hz]
    rw [h'.fderiv_eq]
  have densZero : ∀ (X : E3 → E3) (y : E3), y ∉ tsupport X → sepDensDiv G X y = 0 := by
    intro X y hy
    have hX : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have h : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    rw [h.fderiv_eq]
    simp
  have densZero0 : ∀ y, sepDensDiv G (0 : E3 → E3) y = 0 := fun y => densZero 0 y (by simp)
  
  have s3 : ∀ (Y : Fin n → E3 → E3),
      Pairwise (fun k l => Disjoint (tsupport (Y k)) (tsupport (Y l))) →
      ∀ y, sepDensDiv G (fun z => ∑ k, Y k z) y = ∑ k, sepDensDiv G (Y k) y := by
    intro Y hd y
    by_cases h : ∃ k, y ∈ tsupport (Y k)
    · obtain ⟨k₀, hk₀⟩ := h
      have hnot : ∀ l, l ≠ k₀ → y ∉ tsupport (Y l) := fun l hl hy =>
        Set.disjoint_left.mp (hd hl) hy hk₀
      have hev : ∀ᶠ z in 𝓝 y, ∀ l, l ≠ k₀ → Y l z = 0 := by
        rw [Filter.eventually_all]
        intro l
        by_cases hl : l = k₀
        · exact Filter.Eventually.of_forall fun z h => absurd hl h
        · have := notMem_tsupport_iff_eventuallyEq.mp (hnot l hl)
          filter_upwards [this] with z hz _
          simpa using hz
      have hZ : (fun z => ∑ k, Y k z) =ᶠ[𝓝 y] Y k₀ := by
        filter_upwards [hev] with z hz
        exact Finset.sum_eq_single k₀ (fun l _ hl => hz l hl)
          (fun h => absurd (Finset.mem_univ _) h)
      rw [densCongr _ _ y hZ]
      exact (Finset.sum_eq_single k₀ (fun l _ hl => densZero _ y (hnot l hl))
        (fun h => absurd (Finset.mem_univ _) h)).symm
    · push_neg at h
      have hev : ∀ᶠ z in 𝓝 y, ∀ l, Y l z = 0 := by
        rw [Filter.eventually_all]
        intro l
        filter_upwards [notMem_tsupport_iff_eventuallyEq.mp (h l)] with z hz
        simpa using hz
      have hZ : (fun z => ∑ k, Y k z) =ᶠ[𝓝 y] 0 := by
        filter_upwards [hev] with z hz
        simp [hz]
      rw [densZero _ y (notMem_tsupport_iff_eventuallyEq.mpr hZ)]
      exact (Finset.sum_eq_zero fun l _ => densZero _ y (h l)).symm
  
  have s4 : ∀ (Y : Fin n → E3 → E3), (∀ k, ContDiff ℝ ∞ (Y k) ∧ HasCompactSupport (Y k) ∧
      tsupport (Y k) ⊆ A k ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y k y i * Y k y j ≤ 1) →
      ContDiff ℝ ∞ (fun z => ∑ k, Y k z) ∧ HasCompactSupport (fun z => ∑ k, Y k z) ∧
      tsupport (fun z => ∑ k, Y k z) ⊆ ⋃ k, A k ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (∑ k, Y k y) i * (∑ k, Y k y) j ≤ 1 := by
    intro Y hY
    have hvan : ∀ x, x ∉ ⋃ k, tsupport (Y k) → (∑ k, Y k x) = 0 := by
      intro x hx
      exact Finset.sum_eq_zero fun k _ =>
        image_eq_zero_of_notMem_tsupport fun hk => hx (Set.mem_iUnion.2 ⟨k, hk⟩)
    have hKc : IsClosed (⋃ k, tsupport (Y k)) :=
      isClosed_iUnion_of_finite fun k => isClosed_tsupport _
    have hKk : IsCompact (⋃ k, tsupport (Y k)) := isCompact_iUnion fun k => (hY k).2.1.isCompact
    refine ⟨ContDiff.sum fun k _ => (hY k).1, HasCompactSupport.intro' hKk hKc hvan, ?_, ?_⟩
    · refine (closure_minimal ?_ hKc).trans (Set.iUnion_mono fun k => (hY k).2.2.1)
      intro x hx
      by_contra hxK
      exact hx (hvan x hxK)
    · intro y
      by_cases h : ∃ k, Y k y ≠ 0
      · obtain ⟨k₀, hk₀⟩ := h
        have hyA : y ∈ A k₀ := (hY k₀).2.2.1 (subset_tsupport _ hk₀)
        have hsum : (∑ k, Y k y) = Y k₀ y := by
          refine Finset.sum_eq_single k₀ (fun l _ hl => ?_) (fun h => absurd (Finset.mem_univ _) h)
          by_contra hne
          have hyl : y ∈ A l := (hY l).2.2.1 (subset_tsupport _ hne)
          exact Set.disjoint_left.mp (hdisj hl) hyl hyA
        rw [hsum]
        exact (hY k₀).2.2.2 y
      · push_neg at h
        have hsum : (∑ k, Y k y) = 0 := Finset.sum_eq_zero fun k _ => h k
        rw [hsum]
        simp
  
  have adm0 : ∀ U : Set E3, ContDiff ℝ ∞ (0 : E3 → E3) ∧ HasCompactSupport (0 : E3 → E3) ∧
      tsupport (0 : E3 → E3) ⊆ U ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (0 : E3 → E3) y i * (0 : E3 → E3) y j ≤ 1 := by
    intro U
    refine ⟨contDiff_const, HasCompactSupport.zero, by simp, fun y => by simp⟩
  
  have hrw : ∀ k, sepPerG G E (A k) = ⨆ (Y : {X : E3 → E3 // ContDiff ℝ ∞ X ∧
      HasCompactSupport X ∧ tsupport X ⊆ A k ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1}),
      ENNReal.ofReal (∫ y in E, sepDensDiv G Y.1 y) := by
    intro k
    unfold sepPerG
    exact iSup_subtype'
  rw [Finset.sum_congr rfl fun k _ => hrw k]
  refine s2 (fun k => {X : E3 → E3 // ContDiff ℝ ∞ X ∧
      HasCompactSupport X ∧ tsupport X ⊆ A k ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1})
    (fun k => ⟨⟨0, adm0 _⟩⟩) (fun k Y => ENNReal.ofReal (∫ y in E, sepDensDiv G Y.1 y)) _ ?_
  intro σ
  show ∑ k, ENNReal.ofReal (∫ y in E, sepDensDiv G (σ k).1 y) ≤ _
  
  let a : Fin n → ℝ := fun k => ∫ y in E, sepDensDiv G (σ k).1 y
  let Y : Fin n → E3 → E3 := fun k => if 0 < a k then (σ k).1 else 0
  have hYpos : ∀ k, 0 < a k → Y k = (σ k).1 := fun k hk => if_pos hk
  have hYneg : ∀ k, ¬ 0 < a k → Y k = 0 := fun k hk => if_neg hk
  have F1 : ∀ k, ContDiff ℝ ∞ (Y k) ∧ HasCompactSupport (Y k) ∧ tsupport (Y k) ⊆ A k ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y k y i * Y k y j ≤ 1 := by
    intro k
    by_cases hk : 0 < a k
    · rw [hYpos k hk]; exact (σ k).2
    · rw [hYneg k hk]; exact adm0 _
  have F3 : ∀ k, ∫ y in E, sepDensDiv G (Y k) y = if 0 < a k then a k else 0 := by
    intro k
    by_cases hk : 0 < a k
    · rw [if_pos hk, hYpos k hk]
    · rw [if_neg hk, hYneg k hk]
      simp [densZero0]
  have F3n : ∀ k, 0 ≤ ∫ y in E, sepDensDiv G (Y k) y := by
    intro k
    rw [F3 k]
    split_ifs with hk
    · exact hk.le
    · exact le_rfl
  have F4 : ∀ k, ENNReal.ofReal (∫ y in E, sepDensDiv G (σ k).1 y) ≤
      ENNReal.ofReal (∫ y in E, sepDensDiv G (Y k) y) := by
    intro k
    by_cases hk : 0 < a k
    · rw [F3 k, if_pos hk]
    · have : ENNReal.ofReal (∫ y in E, sepDensDiv G (σ k).1 y) = 0 :=
        ENNReal.ofReal_of_nonpos (not_lt.mp hk)
      rw [this]
      exact zero_le _
  have F5 : ∀ k, Integrable (fun y => sepDensDiv G (Y k) y) (volume.restrict E) := by
    intro k
    by_cases hk : 0 < a k
    · rw [hYpos k hk]
      exact Integrable.of_integral_ne_zero (ne_of_gt hk)
    · rw [hYneg k hk]
      have : (fun y => sepDensDiv G (0 : E3 → E3) y) = fun _ => (0 : ℝ) := funext densZero0
      rw [this]
      exact integrable_zero _ _ _
  have hd : Pairwise (fun k l => Disjoint (tsupport (Y k)) (tsupport (Y l))) :=
    fun k l hkl => (hdisj hkl).mono (F1 k).2.2.1 (F1 l).2.2.1
  have hZ := s4 Y F1
  have hint : ∫ y in E, sepDensDiv G (fun z => ∑ k, Y k z) y =
      ∑ k, ∫ y in E, sepDensDiv G (Y k) y := by
    calc ∫ y in E, sepDensDiv G (fun z => ∑ k, Y k z) y
        = ∫ y in E, ∑ k, sepDensDiv G (Y k) y := by
          congr 1
          funext y
          exact s3 Y hd y
      _ = _ := integral_finset_sum _ fun k _ => F5 k
  calc ∑ k, ENNReal.ofReal (∫ y in E, sepDensDiv G (σ k).1 y)
      ≤ ∑ k, ENNReal.ofReal (∫ y in E, sepDensDiv G (Y k) y) :=
        Finset.sum_le_sum fun k _ => F4 k
    _ = ENNReal.ofReal (∑ k, ∫ y in E, sepDensDiv G (Y k) y) :=
        (ENNReal.ofReal_sum_of_nonneg fun k _ => F3n k).symm
    _ = ENNReal.ofReal (∫ y in E, sepDensDiv G (fun z => ∑ k, Y k z) y) := by rw [hint]
    _ ≤ sepPerG G E (⋃ k, A k) := by
        unfold sepPerG
        exact le_iSup₂_of_le (fun z => ∑ k, Y k z) hZ le_rfl

theorem sepPerG_union_le (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U E A B : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hdet : ∀ y ∈ U, 0 < (G y).det)
    (hE : MeasurableSet E) (hA : IsOpen A) (hB : IsOpen B) (hAU : A ⊆ U) (hBU : B ⊆ U) :
    sepPerG G E (A ∪ B) ≤ sepPerG G E A + sepPerG G E B :=
by
  classical
  
  have s1 : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ U →
      (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i)) ∧
      Continuous (sepDensDiv G X) ∧ HasCompactSupport (sepDensDiv G X) := by
    intro X hX hXc hXU
    have hdetC : ContDiffOn ℝ ∞ (fun z => (G z).det) U := by
      have heq : (fun z => (G z).det) = fun z =>
          G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
            - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
            + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 := by
        funext z; exact Matrix.det_fin_three _
      rw [heq]
      have h := hG
      exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    have hsq : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) U :=
      hdetC.sqrt (fun x hx => (hdet x hx).ne')
    have hcoord : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i =>
      (contDiff_piLp _).1 hX i
    have hzero : ∀ y, y ∉ tsupport X → ∀ i : Fin 3,
        (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      intro y hy i
      have hX0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
      filter_upwards [hX0] with z hz
      simp [hz]
    have hsm : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) := by
      intro i
      rw [contDiff_iff_contDiffAt]
      intro y
      by_cases hy : y ∈ U
      · exact (hsq.contDiffAt (hU.mem_nhds hy)).mul (hcoord i).contDiffAt
      · have hy' : y ∉ tsupport X := fun h => hy (hXU h)
        exact contDiffAt_const.congr_of_eventuallyEq (hzero y hy' i)
    refine ⟨hsm, ?_, ?_⟩
    · show Continuous fun y => ∑ i : Fin 3,
        fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y (e i)
      refine continuous_finset_sum _ fun i _ => ?_
      exact ((hsm i).continuous_fderiv (by simp)).clm_apply continuous_const
    · refine HasCompactSupport.mono' hXc ?_
      intro y hy
      by_contra hy'
      apply hy
      show ∑ i : Fin 3, fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y (e i) = 0
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [(hzero y hy' i).fderiv_eq]
      simp
  
  have s2 : ∀ T : Set E3, IsCompact T → T ⊆ A ∪ B →
      ∃ ψ₁ ψ₂ : E3 → ℝ, ContDiff ℝ ∞ ψ₁ ∧ ContDiff ℝ ∞ ψ₂ ∧ (∀ x, 0 ≤ ψ₁ x) ∧
        (∀ x, 0 ≤ ψ₂ x) ∧ (∀ x, ψ₁ x + ψ₂ x ≤ 1) ∧ (∀ x ∈ T, ψ₁ x + ψ₂ x = 1) ∧
        tsupport ψ₁ ⊆ A ∧ tsupport ψ₂ ⊆ B := by
    intro T hT hTAB
    let V : Bool → Set E3 := fun b => cond b A B
    have hVo : ∀ b, IsOpen (V b) := by
      intro b; cases b
      · exact hB
      · exact hA
    have hcov : T ⊆ ⋃ b, V b := by
      intro x hx
      rcases hTAB hx with h | h
      · exact Set.mem_iUnion.2 ⟨true, h⟩
      · exact Set.mem_iUnion.2 ⟨false, h⟩
    obtain ⟨f, hf⟩ :=
      SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E3) hT.isClosed V hVo hcov
    refine ⟨f true, f false, contMDiff_iff_contDiff.mp (f true).contMDiff,
      contMDiff_iff_contDiff.mp (f false).contMDiff, f.nonneg true, f.nonneg false, ?_, ?_,
      hf true, hf false⟩
    · intro x
      have h := f.sum_le_one x
      rw [finsum_eq_sum_of_fintype, Fintype.sum_bool] at h
      exact h
    · intro x hx
      have h := f.sum_eq_one hx
      rw [finsum_eq_sum_of_fintype, Fintype.sum_bool] at h
      exact h
  
  have s3 : ∀ (X : E3 → E3) (ψ : E3 → ℝ) (W : Set E3), ContDiff ℝ ∞ X → HasCompactSupport X →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      ContDiff ℝ ∞ ψ → (∀ x, 0 ≤ ψ x) → (∀ x, ψ x ≤ 1) → tsupport ψ ⊆ W →
      ContDiff ℝ ∞ (fun y => ψ y • X y) ∧ HasCompactSupport (fun y => ψ y • X y) ∧
        tsupport (fun y => ψ y • X y) ⊆ W ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (ψ y • X y) i * (ψ y • X y) j ≤ 1 := by
    intro X ψ W hX hXc hXq hψ hψ0 hψ1 hψW
    have hs1 : ContDiff ℝ ∞ (fun y => ψ y • X y) := hψ.smul hX
    have hs2 : HasCompactSupport (fun y => ψ y • X y) := by
      have := hXc.smul_left (f := ψ)
      exact this
    have hs3 : tsupport (fun y => ψ y • X y) ⊆ W := (tsupport_smul_subset_left ψ X).trans hψW
    refine ⟨hs1, hs2, hs3, ?_⟩
    intro y
    have heq : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (ψ y • X y) i * (ψ y • X y) j =
        ψ y ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
      simp only [PiLp.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [heq]
    have h1 := hXq y
    have h2 := hψ0 y
    have h3 := hψ1 y
    have h4 : ψ y ^ 2 ≤ 1 := by nlinarith
    nlinarith [mul_nonneg (sq_nonneg (ψ y)) (sub_nonneg.2 h1)]
  
  have s4 : ∀ Y₁ Y₂ : E3 → E3,
      (∀ i : Fin 3, Differentiable ℝ (fun z => Real.sqrt (G z).det * Y₁ z i)) →
      (∀ i : Fin 3, Differentiable ℝ (fun z => Real.sqrt (G z).det * Y₂ z i)) → ∀ y,
      sepDensDiv G (fun z => Y₁ z + Y₂ z) y = sepDensDiv G Y₁ y + sepDensDiv G Y₂ y := by
    intro Y₁ Y₂ h₁ h₂ y
    unfold sepDensDiv partialDeriv
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hfun : (fun z => Real.sqrt (G z).det * (Y₁ z + Y₂ z) i) =
        (fun z => Real.sqrt (G z).det * Y₁ z i) + (fun z => Real.sqrt (G z).det * Y₂ z i) := by
      funext z; simp [PiLp.add_apply, mul_add]
    rw [hfun, fderiv_add ((h₁ i) y) ((h₂ i) y), ContinuousLinearMap.add_apply]
  
  unfold sepPerG
  refine iSup₂_le fun X hX => ?_
  obtain ⟨hXs, hXc, hXT, hXq⟩ := hX
  obtain ⟨ψ₁, ψ₂, hψ₁s, hψ₂s, hψ₁0, hψ₂0, hsum1, hsumT, hψ₁A, hψ₂B⟩ :=
    s2 (tsupport X) hXc hXT
  have hψ₁1 : ∀ x, ψ₁ x ≤ 1 := fun x => by linarith [hsum1 x, hψ₂0 x]
  have hψ₂1 : ∀ x, ψ₂ x ≤ 1 := fun x => by linarith [hsum1 x, hψ₁0 x]
  have adm₁ := s3 X ψ₁ A hXs hXc hXq hψ₁s hψ₁0 hψ₁1 hψ₁A
  have adm₂ := s3 X ψ₂ B hXs hXc hXq hψ₂s hψ₂0 hψ₂1 hψ₂B
  have hdecomp : X = fun z => ψ₁ z • X z + ψ₂ z • X z := by
    funext z
    by_cases hz : z ∈ tsupport X
    · rw [← add_smul, hsumT z hz, one_smul]
    · have h0 : X z = 0 := image_eq_zero_of_notMem_tsupport hz
      simp [h0]
  obtain ⟨c₁, cont₁, cs₁⟩ := s1 _ adm₁.1 adm₁.2.1 (adm₁.2.2.1.trans hAU)
  obtain ⟨c₂, cont₂, cs₂⟩ := s1 _ adm₂.1 adm₂.2.1 (adm₂.2.2.1.trans hBU)
  have hadd := s4 (fun y => ψ₁ y • X y) (fun y => ψ₂ y • X y)
    (fun i => (c₁ i).differentiable (by simp)) (fun i => (c₂ i).differentiable (by simp))
  have i₁ : Integrable (sepDensDiv G (fun y => ψ₁ y • X y)) (volume.restrict E) :=
    (cont₁.integrable_of_hasCompactSupport cs₁).integrableOn
  have i₂ : Integrable (sepDensDiv G (fun y => ψ₂ y • X y)) (volume.restrict E) :=
    (cont₂.integrable_of_hasCompactSupport cs₂).integrableOn
  have hint : ∫ y in E, sepDensDiv G X y =
      (∫ y in E, sepDensDiv G (fun y => ψ₁ y • X y) y) +
        ∫ y in E, sepDensDiv G (fun y => ψ₂ y • X y) y := by
    have h1 : ∫ y in E, sepDensDiv G X y = ∫ y in E,
        (sepDensDiv G (fun y => ψ₁ y • X y) y + sepDensDiv G (fun y => ψ₂ y • X y) y) := by
      congr 1
      funext y
      rw [← hadd y, ← hdecomp]
    rw [h1, integral_add i₁ i₂]
  rw [hint]
  refine le_trans ENNReal.ofReal_add_le (add_le_add ?_ ?_)
  · exact le_iSup₂_of_le (fun y => ψ₁ y • X y) adm₁ le_rfl
  · exact le_iSup₂_of_le (fun y => ψ₂ y • X y) adm₂ le_rfl

theorem sepPerG_le_of_local_compare (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U Φ₁ Φ₂ V K' : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hdet : ∀ y ∈ U, 0 < (G y).det) (hΦ₁ : MeasurableSet Φ₁) (hΦ₂ : MeasurableSet Φ₂) (hV : IsOpen V) (hVU : V ⊆ U) (hK' : IsCompact K') (hK'V : K' ⊆ V) (hsd : symmDiff Φ₁ Φ₂ ⊆ K') (hfin : sepPerG G Φ₁ V < ⊤) (hcmp : ∀ V₁ V₂ : Set E3, IsOpen V₁ → IsOpen V₂ → K' ⊆ V₂ → IsCompact (closure V₂) → closure V₂ ⊆ V₁ → V₁ ⊆ V → sepPerG G Φ₁ V₂ ≤ sepPerG G Φ₂ V₁ + sepPerG G Φ₁ (V₁ \ K')) : sepPerG G Φ₁ V ≤ sepPerG G Φ₂ V :=
by
  classical
  have hK'c : IsClosed K' := hK'.isClosed
  
  have mono : ∀ (E A B : Set E3), A ⊆ B → sepPerG G E A ≤ sepPerG G E B := by
    intro E A B hAB
    unfold sepPerG
    exact iSup₂_mono' fun X hX => ⟨X, ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2⟩, le_rfl⟩
  
  have densZero : ∀ (X : E3 → E3) (y : E3), y ∉ tsupport X → sepDensDiv G X y = 0 := by
    intro X y hy
    have hX : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have h : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    rw [h.fderiv_eq]
    simp
  
  have congrP : ∀ (E₁ E₂ A : Set E3), MeasurableSet E₁ → MeasurableSet E₂ → E₁ ∩ A = E₂ ∩ A →
      sepPerG G E₁ A = sepPerG G E₂ A := by
    intro E₁ E₂ A h1 h2 h
    unfold sepPerG
    refine iSup_congr fun X => iSup_congr fun hX => ?_
    congr 1
    rw [← integral_indicator h1, ← integral_indicator h2]
    congr 1
    funext y
    by_cases hyA : y ∈ A
    · have hiff := Set.ext_iff.mp h y
      simp only [Set.mem_inter_iff, hyA, and_true] at hiff
      by_cases hy1 : y ∈ E₁
      · simp [Set.indicator_apply, hy1, hiff.mp hy1]
      · simp [Set.indicator_apply, hy1, (not_congr hiff).mp hy1]
    · have hz := densZero X y (fun hy => hyA (hX.2.2.1 hy))
      simp [Set.indicator_apply, hz]
  
  have two : ∀ (E : Set E3), MeasurableSet E → ∀ A B : Set E3, Disjoint A B →
      sepPerG G E A + sepPerG G E B ≤ sepPerG G E (A ∪ B) := by
    intro E hE A B hAB
    have h := sepPerG_sum_le G E hE 2 ![A, B] (by
      intro k l hkl
      fin_cases k <;> fin_cases l <;> simp_all [hAB, hAB.symm])
    have hU2 : (⋃ k, ![A, B] k) = A ∪ B := by
      ext x
      simp [Fin.exists_fin_two]
    rw [Fin.sum_univ_two, hU2] at h
    simpa using h
  
  have collar : ∀ ε : ENNReal, 0 < ε → ∃ C : Set E3, IsOpen C ∧ K' ⊆ C ∧ C ⊆ V ∧
      sepPerG G Φ₁ (C \ K') < ε := by
    intro ε hε
    by_contra hH
    push_neg at hH
    set δ : ENNReal := min ε 1 / 2 with hδ
    have hm0 : min ε 1 ≠ 0 := (lt_min hε one_pos).ne'
    have hmt : min ε 1 ≠ ⊤ := ne_top_of_le_ne_top ENNReal.one_ne_top (min_le_right _ _)
    have hδ0 : δ ≠ 0 := (ENNReal.half_pos hm0).ne'
    have hδε : δ < ε := lt_of_lt_of_le (ENNReal.half_lt_self hm0 hmt) (min_le_left _ _)
    have claim : ∀ n : ℕ, ∃ C : Set E3, IsOpen C ∧ K' ⊆ C ∧ C ⊆ V ∧
        (n : ENNReal) * δ + sepPerG G Φ₁ (C \ K') ≤ sepPerG G Φ₁ (V \ K') := by
      intro n
      induction n with
      | zero => exact ⟨V, hV, hK'V, subset_rfl, by simp⟩
      | succ n ih =>
        obtain ⟨C, hCo, hK'C, hCV, hC⟩ := ih
        have h1 : δ < sepPerG G Φ₁ (C \ K') := lt_of_lt_of_le hδε (hH C hCo hK'C hCV)
        unfold sepPerG at h1
        obtain ⟨X, h1⟩ := lt_iSup_iff.mp h1
        obtain ⟨hX, h1⟩ := lt_iSup_iff.mp h1
        have hT : IsCompact (tsupport X) := hX.2.1
        have hCK : IsOpen (C \ K') := hCo.sdiff hK'c
        obtain ⟨O, hOo, hTO, hOC, -⟩ :=
          exists_open_between_and_isCompact_closure hT hCK hX.2.2.1
        refine ⟨C \ closure O, hCo.sdiff isClosed_closure, ?_, Set.diff_subset.trans hCV, ?_⟩
        · intro x hx
          exact ⟨hK'C hx, fun hxO => (hOC hxO).2 hx⟩
        · have hδO : δ ≤ sepPerG G Φ₁ O := by
            unfold sepPerG
            refine le_trans h1.le ?_
            apply le_iSup₂_of_le X ⟨hX.1, hX.2.1, hTO, hX.2.2.2⟩
            exact le_rfl
          have hdisj : Disjoint O ((C \ closure O) \ K') := by
            rw [Set.disjoint_left]
            intro x hxO hx
            exact hx.1.2 (subset_closure hxO)
          have hsub : O ∪ ((C \ closure O) \ K') ⊆ C \ K' := by
            intro x hx
            rcases hx with hx | hx
            · exact hOC (subset_closure hx)
            · exact ⟨hx.1.1, hx.2⟩
          have h2 := (two Φ₁ hΦ₁ _ _ hdisj).trans (mono Φ₁ _ _ hsub)
          calc ((n + 1 : ℕ) : ENNReal) * δ + sepPerG G Φ₁ ((C \ closure O) \ K')
              = (n : ENNReal) * δ + (δ + sepPerG G Φ₁ ((C \ closure O) \ K')) := by
                push_cast; ring
            _ ≤ (n : ENNReal) * δ + sepPerG G Φ₁ (C \ K') := by
                gcongr
                exact (add_le_add hδO le_rfl).trans h2
            _ ≤ _ := hC
    obtain ⟨n, hn⟩ := ENNReal.exists_nat_mul_gt hδ0 hfin.ne
    obtain ⟨C, -, -, -, hC⟩ := claim n
    have hle : (n : ENNReal) * δ ≤ sepPerG G Φ₁ V :=
      le_trans le_self_add (hC.trans (mono Φ₁ _ _ Set.diff_subset))
    exact absurd hn (not_lt.mpr hle)
  
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  have hε' : (0 : ENNReal) < (ε : ENNReal) / 2 :=
    ENNReal.half_pos (ENNReal.coe_pos.mpr hε).ne'
  obtain ⟨C, hCo, hK'C, hCV, hx⟩ := collar _ hε'
  obtain ⟨B, hBo, hK'B, hBC, -⟩ := exists_open_between_and_isCompact_closure hK' hCo hK'C
  obtain ⟨A, hAo, hK'A, hAB, hAc⟩ := exists_open_between_and_isCompact_closure hK' hBo hK'B
  have hBV : B ⊆ V := (subset_closure.trans hBC).trans hCV
  have hAV : A ⊆ V := (subset_closure.trans hAB).trans hBV
  have hd : sepPerG G Φ₁ V ≤ sepPerG G Φ₁ A + sepPerG G Φ₁ (V \ K') := by
    refine (mono Φ₁ V (A ∪ (V \ K')) ?_).trans
      (sepPerG_union_le G U Φ₁ A (V \ K') hU hG hdet hΦ₁ hAo (hV.sdiff hK'c)
        (hAV.trans hVU) (Set.diff_subset.trans hVU))
    intro y hy
    by_cases h : y ∈ K'
    · exact Or.inl (hK'A h)
    · exact Or.inr ⟨hy, h⟩
  have he : sepPerG G Φ₁ (V \ K') ≤
      sepPerG G Φ₁ (C \ K') + sepPerG G Φ₁ (V \ closure B) := by
    refine (mono Φ₁ _ ((C \ K') ∪ (V \ closure B)) ?_).trans
      (sepPerG_union_le G U Φ₁ _ _ hU hG hdet hΦ₁ (hCo.sdiff hK'c) (hV.sdiff isClosed_closure)
        (Set.diff_subset.trans (hCV.trans hVU)) (Set.diff_subset.trans hVU))
    rintro y ⟨hyV, hyK⟩
    by_cases h : y ∈ closure B
    · exact Or.inl ⟨hBC h, hyK⟩
    · exact Or.inr ⟨hyV, h⟩
  have hf : sepPerG G Φ₁ A ≤ sepPerG G Φ₂ B + sepPerG G Φ₁ (C \ K') :=
    (hcmp B A hBo hAo hK'A hAc hAB hBV).trans
      (add_le_add le_rfl (mono Φ₁ _ _ (Set.diff_subset_diff_left (subset_closure.trans hBC))))
  have hg : sepPerG G Φ₁ (V \ closure B) = sepPerG G Φ₂ (V \ closure B) := by
    refine congrP Φ₁ Φ₂ _ hΦ₁ hΦ₂ ?_
    ext y
    simp only [Set.mem_inter_iff]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨?_, h2⟩
      by_contra h
      exact h2.2 (subset_closure (hK'B (hsd (Set.mem_symmDiff.2 (Or.inl ⟨h1, h⟩)))))
    · rintro ⟨h1, h2⟩
      refine ⟨?_, h2⟩
      by_contra h
      exact h2.2 (subset_closure (hK'B (hsd (Set.mem_symmDiff.2 (Or.inr ⟨h1, h⟩)))))
  have hh : sepPerG G Φ₂ B + sepPerG G Φ₂ (V \ closure B) ≤ sepPerG G Φ₂ V := by
    refine (two Φ₂ hΦ₂ _ _ ?_).trans (mono Φ₂ _ _ (Set.union_subset hBV Set.diff_subset))
    rw [Set.disjoint_left]
    intro y hyB hy
    exact hy.2 (subset_closure hyB)
  have he' : sepPerG G Φ₁ (V \ K') ≤
      sepPerG G Φ₁ (C \ K') + sepPerG G Φ₂ (V \ closure B) := by
    rw [← hg]; exact he
  have hxle : sepPerG G Φ₁ (C \ K') ≤ (ε : ENNReal) / 2 := hx.le
  calc sepPerG G Φ₁ V ≤ sepPerG G Φ₁ A + sepPerG G Φ₁ (V \ K') := hd
    _ ≤ (sepPerG G Φ₂ B + sepPerG G Φ₁ (C \ K')) +
        (sepPerG G Φ₁ (C \ K') + sepPerG G Φ₂ (V \ closure B)) := add_le_add hf he'
    _ = (sepPerG G Φ₂ B + sepPerG G Φ₂ (V \ closure B)) +
        (sepPerG G Φ₁ (C \ K') + sepPerG G Φ₁ (C \ K')) := by ring
    _ ≤ sepPerG G Φ₂ V + ((ε : ENNReal) / 2 + (ε : ENNReal) / 2) :=
        add_le_add hh (add_le_add hxle hxle)
    _ = sepPerG G Φ₂ V + ε := by rw [ENNReal.add_halves]

theorem sepPerG_le_hullPerG (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T E A Kc : Set E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T) (hpd : ∀ y ∈ T, (G y).PosDef) (hAT : A ⊆ T) : sepPerG G E A ≤ hullPerG G E A Kc :=
by
  
  have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
    have : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1
        - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
        + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y; exact Matrix.det_fin_three (G y)
    rw [this]
    have h := hG
    exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
      (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
      (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
  have hsd : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T :=
    hdet.sqrt (fun y hy => (hpd y hy).det_pos.ne')
  
  have hQ : ∀ X : E3 → E3, (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ A ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      ((∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X y) ∧ HasCompactSupport X ∧
      tsupport X ⊆ A ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) ∧
      ∃ C : ℝ, ∀ y, |sepDensDiv G X y| ≤ C) := by
    rintro X ⟨hX, hXc, hXA, hXn⟩
    refine ⟨fun y _ => hX.contDiffAt, hXc, hXA, hXn, ?_⟩
    have hKc : IsClosed (tsupport X) := isClosed_tsupport X
    have hKT : tsupport X ⊆ T := hXA.trans hAT
    have hX0 : ∀ y, y ∉ tsupport X → ∀ i : Fin 3, X y i = 0 := by
      intro y hy i
      rw [image_eq_zero_of_notMem_tsupport hy]
      simp
    have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := contDiff_euclidean.mp hX
    have hFT : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) T :=
      fun i => hsd.mul (hXi i).contDiffOn
    have hloc : ∀ i : Fin 3, ∀ y, y ∉ tsupport X →
        (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0:ℝ) :=
      fun i y hy => Filter.eventually_of_mem (hKc.isOpen_compl.mem_nhds hy)
        (fun z hz => by simp only [hX0 z hz i, mul_zero])
    have hFg : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) := by
      intro i
      refine contDiff_iff_contDiffAt.2 fun y => ?_
      by_cases hy : y ∈ T
      · exact (hFT i).contDiffAt (hT.mem_nhds hy)
      · exact contDiffAt_const.congr_of_eventuallyEq (hloc i y (fun h => hy (hKT h)))
    have hcont : Continuous (sepDensDiv G X) := by
      show Continuous (fun y => ∑ i : Fin 3,
        partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y)
      exact continuous_finset_sum _ fun i _ =>
        ((hFg i).continuous_fderiv (by simp)).clm_apply continuous_const
    have hsupp : tsupport (sepDensDiv G X) ⊆ tsupport X := by
      refine closure_minimal (fun y hy => ?_) hKc
      by_contra hyK
      apply hy
      show ∑ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y = 0
      refine Finset.sum_eq_zero fun i _ => ?_
      unfold partialDeriv
      rw [(hloc i y hyK).fderiv_eq]
      simp
    have hcs : HasCompactSupport (sepDensDiv G X) :=
      IsCompact.of_isClosed_subset hXc.isCompact (isClosed_tsupport _) hsupp
    obtain ⟨C, hC⟩ := hcs.exists_bound_of_continuous hcont
    exact ⟨C, fun y => by simpa [Real.norm_eq_abs] using hC y⟩
  unfold sepPerG hullPerG
  exact iSup₂_le fun X hP => le_iSup₂_of_le X (hQ X hP) le_rfl

theorem piola_adjugate_div_zero (Y : E3 → E3) (U : Set E3) (hU : IsOpen U)
    (hY : ContDiffOn ℝ ∞ Y U) (x : E3) (hx : x ∈ U) :
    (∀ a i : Fin 3, DifferentiableAt ℝ (fun z => (jacMat Y z).adjugate a i) x) ∧
    ∀ i : Fin 3, ∑ a : Fin 3, partialDeriv a (fun z => (jacMat Y z).adjugate a i) x = 0 :=
by
  classical
  
  have hadj : ∀ (J : Matrix (Fin 3) (Fin 3) ℝ) (a i : Fin 3),
      J.adjugate a i = J (i+1) (a+1) * J (i+2) (a+2) - J (i+1) (a+2) * J (i+2) (a+1) := by
    intro J a i
    fin_cases a <;> fin_cases i <;> simp [Matrix.adjugate_fin_three] <;> ring
  
  have hxN : U ∈ 𝓝 x := hU.mem_nhds hx
  have hYc : ContDiffAt ℝ ∞ Y x := hY.contDiffAt hxN
  have hD1 : ContDiffAt ℝ 1 (fderiv ℝ Y) x := hYc.fderiv_right (m := 1)
    (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
  have hDd : DifferentiableAt ℝ (fderiv ℝ Y) x := hD1.differentiableAt one_ne_zero
  have hsymm : IsSymmSndFDerivAt ℝ Y x :=
    hYc.isSymmSndFDerivAt (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
  obtain ⟨L, hB, hLsym⟩ : ∃ L : Fin 3 → Fin 3 → E3 →L[ℝ] ℝ,
      (∀ k a, HasFDerivAt (fun z => jacMat Y z k a) (L k a) x) ∧
      ∀ k a b, L k a (e b) = L k b (e a) := by
    refine ⟨fun k a => ((EuclideanSpace.proj k).comp
      (ContinuousLinearMap.apply ℝ E3 (e a))).comp (fderiv ℝ (fderiv ℝ Y) x), ?_, ?_⟩
    · intro k a
      have h := ((EuclideanSpace.proj k).comp
        (ContinuousLinearMap.apply ℝ E3 (e a))).hasFDerivAt.comp x hDd.hasFDerivAt
      convert h using 1
    · intro k a b
      simp only [ContinuousLinearMap.coe_comp', Function.comp_apply,
        ContinuousLinearMap.apply_apply]
      rw [hsymm (e b) (e a)]
  
  have hA : ∀ a i : Fin 3, HasFDerivAt (fun z => (jacMat Y z).adjugate a i)
      ((jacMat Y x (i+1) (a+1) • L (i+2) (a+2) + jacMat Y x (i+2) (a+2) • L (i+1) (a+1)) -
        (jacMat Y x (i+1) (a+2) • L (i+2) (a+1) + jacMat Y x (i+2) (a+1) • L (i+1) (a+2))) x := by
    intro a i
    have hfun : (fun z => (jacMat Y z).adjugate a i) = fun z =>
        jacMat Y z (i+1) (a+1) * jacMat Y z (i+2) (a+2) -
          jacMat Y z (i+1) (a+2) * jacMat Y z (i+2) (a+1) :=
      funext fun z => hadj (jacMat Y z) a i
    rw [hfun]
    exact ((hB (i+1) (a+1)).fun_mul (hB (i+2) (a+2))).fun_sub
      ((hB (i+1) (a+2)).fun_mul (hB (i+2) (a+1)))
  refine ⟨fun a i => (hA a i).differentiableAt, ?_⟩
  have h01 : ∀ k, L k 1 (e 0) = L k 0 (e 1) := fun k => hLsym k 1 0
  have h02 : ∀ k, L k 2 (e 0) = L k 0 (e 2) := fun k => hLsym k 2 0
  have h12 : ∀ k, L k 2 (e 1) = L k 1 (e 2) := fun k => hLsym k 2 1
  intro i
  simp only [partialDeriv, fun a => (hA a i).fderiv]
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul]
  fin_cases i <;>
  · simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceAdd, Fin.zero_eta, Fin.mk_one]
    simp only [h01, h02, h12]
    ring

theorem piola_div_of_null (Y : E3 → E3) (W : E3 → Fin 3 → ℝ) (x : E3)
    (hY : DifferentiableAt ℝ Y x)
    (hA : ∀ a i : Fin 3, DifferentiableAt ℝ (fun z => (jacMat Y z).adjugate a i) x)
    (hW : ∀ i : Fin 3, DifferentiableAt ℝ (fun y => W y i) (Y x))
    (hP : ∀ i : Fin 3,
      ∑ a : Fin 3, partialDeriv a (fun z => (jacMat Y z).adjugate a i) x = 0) :
    ∑ a : Fin 3, partialDeriv a (fun z => ∑ i : Fin 3, (jacMat Y z).adjugate a i * W (Y z) i) x
      = (jacMat Y x).det * ∑ i : Fin 3, partialDeriv i (fun y => W y i) (Y x) :=
by
  
  have hchain : ∀ f : E3 → ℝ, DifferentiableAt ℝ f (Y x) → ∀ a : Fin 3,
      partialDeriv a (fun z => f (Y z)) x =
        ∑ k : Fin 3, jacMat Y x k a * partialDeriv k f (Y x) := by
    intro f hf a
    unfold partialDeriv
    rw [fderiv_comp' x hf hY, ContinuousLinearMap.comp_apply]
    have hv : ∀ v : E3, v = ∑ k : Fin 3, v k • e k := by
      intro v
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, e, EuclideanSpace.single_apply]
    conv_lhs => rw [hv (fderiv ℝ Y x (e a))]
    rw [map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_smul, smul_eq_mul]
    rfl
  have hWi : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => W (Y z) i) x :=
    fun i => (hW i).comp x hY
  
  have hprod : ∀ a : Fin 3,
      partialDeriv a (fun z => ∑ i : Fin 3, (jacMat Y z).adjugate a i * W (Y z) i) x
        = ∑ i : Fin 3, (partialDeriv a (fun z => (jacMat Y z).adjugate a i) x * W (Y x) i
          + (jacMat Y x).adjugate a i * partialDeriv a (fun z => W (Y z) i) x) := by
    intro a
    unfold partialDeriv
    rw [fderiv_fun_sum (fun i _ => (hA a i).fun_mul (hWi i)), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [fderiv_fun_mul (hA a i) (hWi i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hc : ∀ a i : Fin 3, partialDeriv a (fun z => W (Y z) i) x =
      ∑ k : Fin 3, jacMat Y x k a * partialDeriv k (fun y => W y i) (Y x) :=
    fun a i => hchain (fun y => W y i) (hW i) a
  
  have hK : ∀ k i : Fin 3, ∑ a : Fin 3, jacMat Y x k a * (jacMat Y x).adjugate a i
      = (jacMat Y x).det * (1 : Matrix (Fin 3) (Fin 3) ℝ) k i := by
    intro k i
    rw [← Matrix.mul_apply, Matrix.mul_adjugate, Matrix.smul_apply, smul_eq_mul]
  have h00 := hK 0 0
  have h01 := hK 0 1
  have h02 := hK 0 2
  have h10 := hK 1 0
  have h11 := hK 1 1
  have h12 := hK 1 2
  have h20 := hK 2 0
  have h21 := hK 2 1
  have h22 := hK 2 2
  have hP0 := hP 0
  have hP1 := hP 1
  have hP2 := hP 2
  rw [Finset.sum_congr rfl (fun a _ => hprod a)]
  simp only [hc]
  simp only [Fin.sum_univ_three, Matrix.one_apply_eq] at h00 h11 h22 hP0 hP1 hP2 ⊢
  simp only [Fin.sum_univ_three, Matrix.one_apply_ne (by decide : (0 : Fin 3) ≠ 1),
    Matrix.one_apply_ne (by decide : (0 : Fin 3) ≠ 2), Matrix.one_apply_ne (by decide : (1 : Fin 3) ≠ 0),
    Matrix.one_apply_ne (by decide : (1 : Fin 3) ≠ 2), Matrix.one_apply_ne (by decide : (2 : Fin 3) ≠ 0),
    Matrix.one_apply_ne (by decide : (2 : Fin 3) ≠ 1)] at h01 h02 h10 h12 h20 h21
  linear_combination W (Y x) 0 * hP0 + W (Y x) 1 * hP1 + W (Y x) 2 * hP2
    + partialDeriv 0 (fun y => W y 0) (Y x) * h00
    + partialDeriv 0 (fun y => W y 1) (Y x) * h01
    + partialDeriv 0 (fun y => W y 2) (Y x) * h02
    + partialDeriv 1 (fun y => W y 0) (Y x) * h10
    + partialDeriv 1 (fun y => W y 1) (Y x) * h11
    + partialDeriv 1 (fun y => W y 2) (Y x) * h12
    + partialDeriv 2 (fun y => W y 0) (Y x) * h20
    + partialDeriv 2 (fun y => W y 1) (Y x) * h21
    + partialDeriv 2 (fun y => W y 2) (Y x) * h22

theorem transport_field_exists (τ σ : E3 → E3) (O₁ O₂ : Set E3) (hO₁ : IsOpen O₁)
    (hτ : ContDiffOn ℝ ∞ τ O₁) (hσ : ContinuousOn σ O₂)
    (hσO : ∀ z ∈ O₂, σ z ∈ O₁) (hστ : ∀ y ∈ O₁, σ (τ y) = y)
    (hJ0 : ∀ y ∈ O₁, (jacMat τ y).det ≠ 0)
    (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) (hXO : tsupport X ⊆ O₂) :
    ∃ X' : E3 → E3, ContDiff ℝ ∞ X' ∧ HasCompactSupport X' ∧ tsupport X' ⊆ O₁ ∧
      (∀ y ∈ O₁, ∀ a : Fin 3,
        (jacMat τ y).det * X' y a = ∑ i : Fin 3, (jacMat τ y).adjugate a i * X (τ y) i) ∧
      (∀ y ∈ O₁, ∀ i : Fin 3, X (τ y) i = ∑ a : Fin 3, jacMat τ y i a * X' y a) ∧
      (∀ y, y ∉ O₁ → X' y = 0) :=
by
  classical
  
  have hfd : ContDiffOn ℝ ∞ (fderiv ℝ τ) O₁ :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hO₁).1 hτ).2
  have hent : ∀ i a : Fin 3, ContDiffOn ℝ ∞ (fun y => jacMat τ y i a) O₁ := by
    intro i a
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ τ y (e a)) O₁ :=
      hfd.clm_apply contDiffOn_const
    exact contDiffOn_euclidean.1 h1 i
  have h00 := hent 0 0
  have h01 := hent 0 1
  have h02 := hent 0 2
  have h10 := hent 1 0
  have h11 := hent 1 1
  have h12 := hent 1 2
  have h20 := hent 2 0
  have h21 := hent 2 1
  have h22 := hent 2 2
  have hdet : ContDiffOn ℝ ∞ (fun y => (jacMat τ y).det) O₁ := by
    simp only [Matrix.det_fin_three]
    fun_prop
  have hadj : ∀ a i : Fin 3, ContDiffOn ℝ ∞ (fun y => (jacMat τ y).adjugate a i) O₁ := by
    intro a i
    simp only [Matrix.adjugate_fin_three]
    fin_cases a <;> fin_cases i <;> simp <;> fun_prop
  have hXτ : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun y => X (τ y) i) O₁ := fun i =>
    (contDiff_euclidean.1 hX i).comp_contDiffOn hτ
  have hcomp : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun y => ((jacMat τ y).det)⁻¹ *
      ∑ i : Fin 3, (jacMat τ y).adjugate a i * X (τ y) i) O₁ := by
    intro a
    exact (hdet.inv fun y hy => hJ0 y hy).mul
      (ContDiffOn.sum fun i _ => (hadj a i).mul (hXτ i))
  
  let F : E3 → E3 := fun y => WithLp.toLp 2 (fun a : Fin 3 => ((jacMat τ y).det)⁻¹ *
      ∑ i : Fin 3, (jacMat τ y).adjugate a i * X (τ y) i)
  have hFs : ContDiffOn ℝ ∞ F O₁ := contDiffOn_euclidean.2 fun a => hcomp a
  let X' : E3 → E3 := fun y => if y ∈ O₁ then F y else 0
  have hX'F : ∀ y ∈ O₁, X' y = F y := fun y hy => if_pos hy
  
  set K : Set E3 := σ '' tsupport X with hKdef
  have hK : IsCompact K := hXc.image_of_continuousOn (hσ.mono hXO)
  have hKO : K ⊆ O₁ := by
    rintro _ ⟨z, hz, rfl⟩
    exact hσO z (hXO hz)
  have h0 : ∀ y, y ∉ K → X' y = 0 := by
    intro y hy
    by_cases hyO : y ∈ O₁
    · have hτX : τ y ∉ tsupport X := by
        intro h
        exact hy ⟨τ y, h, hστ y hyO⟩
      have hXz : X (τ y) = 0 := image_eq_zero_of_notMem_tsupport hτX
      rw [hX'F y hyO]
      ext a
      simp [F, hXz]
    · exact if_neg hyO
  have hX's : ContDiffOn ℝ ∞ X' O₁ := hFs.congr hX'F
  have hX'cd : ContDiff ℝ ∞ X' := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ O₁
    · exact hX's.contDiffAt (hO₁.mem_nhds hy)
    · have hyK : y ∉ K := fun h => hy (hKO h)
      have hev : X' =ᶠ[𝓝 y] fun _ => (0 : E3) :=
        Filter.eventually_of_mem (hK.isClosed.isOpen_compl.mem_nhds hyK) (fun z hz => h0 z hz)
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have htK : tsupport X' ⊆ K :=
    closure_minimal (fun y hy => by_contra (fun h => hy (h0 y h))) hK.isClosed
  have hcs : HasCompactSupport X' := hK.of_isClosed_subset (isClosed_tsupport X') htK
  
  have key : ∀ (J : Matrix (Fin 3) (Fin 3) ℝ), J.det ≠ 0 → ∀ (v : Fin 3 → ℝ) (i : Fin 3),
      v i = ∑ a : Fin 3, J i a * (J.det⁻¹ * ∑ j : Fin 3, J.adjugate a j * v j) := by
    intro J hJ v i
    have h1 : ∀ j, ∑ a : Fin 3, J i a * J.adjugate a j = J.det * (if i = j then 1 else 0) := by
      intro j
      have := congrFun (congrFun (Matrix.mul_adjugate J) i) j
      rw [Matrix.mul_apply] at this
      rw [this, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
    calc v i = J.det⁻¹ * ∑ j : Fin 3, (J.det * (if i = j then 1 else 0)) * v j := by
          simp [hJ]
      _ = J.det⁻¹ * ∑ j : Fin 3, (∑ a : Fin 3, J i a * J.adjugate a j) * v j := by
          simp only [h1]
      _ = ∑ a : Fin 3, J i a * (J.det⁻¹ * ∑ j : Fin 3, J.adjugate a j * v j) := by
          simp only [Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun j _ => by ring
  refine ⟨X', hX'cd, hcs, htK.trans hKO, ?_, ?_, ?_⟩
  · intro y hy a
    rw [hX'F y hy]
    show (jacMat τ y).det * (((jacMat τ y).det)⁻¹ *
      ∑ i : Fin 3, (jacMat τ y).adjugate a i * X (τ y) i) = _
    exact mul_inv_cancel_left₀ (hJ0 y hy) _
  · intro y hy i
    rw [hX'F y hy]
    show X (τ y) i = ∑ a : Fin 3, jacMat τ y i a * (((jacMat τ y).det)⁻¹ *
      ∑ j : Fin 3, (jacMat τ y).adjugate a j * X (τ y) j)
    exact key (jacMat τ y) (hJ0 y hy) (fun j => X (τ y) j) i
  · intro y hy
    exact if_neg hy

theorem sepPerG_chart_le [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p q : M)
    (E W : Set M) (hE : sepChartMeas E) (hW : IsOpen W) (hWp : W ⊆ (chartAt E3 p).source)
    (hWq : W ⊆ (chartAt E3 q).source) :
    sepPerG (g.coeff (chartAt E3 q).symm) (chartAt E3 q '' (E ∩ (chartAt E3 q).source))
        (chartAt E3 q '' W) ≤
      sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
        (chartAt E3 p '' W) :=
by
  classical
  
  have jacdet : ∀ (Y : E3 → E3) (x : E3), (jacMat Y x).det = (fderiv ℝ Y x).det := by
    intro Y x
    have h : jacMat Y x = LinearMap.toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis (fderiv ℝ Y x : E3 →ₗ[ℝ] E3) := by
      ext i a
      rw [LinearMap.toMatrix_apply]
      simp [jacMat, e]
    rw [h, LinearMap.det_toMatrix]
  
  have densZero : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (y : E3),
      y ∉ tsupport X → sepDensDiv G' X y = 0 := by
    intro G' X y hy
    have hX : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have h : (fun z => Real.sqrt (G' z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    rw [h.fderiv_eq]
    simp
  
  have hOp : IsOpen (chartAt E3 p '' W) := (chartAt E3 p).isOpen_image_of_subset_source hW hWp
  have hOq : IsOpen (chartAt E3 q '' W) := (chartAt E3 q).isOpen_image_of_subset_source hW hWq
  have hSp : MeasurableSet (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) := hE p
  have hSq : MeasurableSet (chartAt E3 q '' (E ∩ (chartAt E3 q).source)) := hE q
  set τ : E3 → E3 := fun z => chartAt E3 q ((chartAt E3 p).symm z) with hτdef
  set σ : E3 → E3 := fun z => chartAt E3 p ((chartAt E3 q).symm z) with hσdef
  
  have hOpt : ∀ y ∈ chartAt E3 p '' W,
      y ∈ (chartAt E3 p).target ∧ (chartAt E3 p).symm y ∈ W := by
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨(chartAt E3 p).map_source (hWp hx), by rw [(chartAt E3 p).left_inv (hWp hx)]; exact hx⟩
  have hOqt : ∀ z ∈ chartAt E3 q '' W,
      z ∈ (chartAt E3 q).target ∧ (chartAt E3 q).symm z ∈ W := by
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨(chartAt E3 q).map_source (hWq hx), by rw [(chartAt E3 q).left_inv (hWq hx)]; exact hx⟩
  have hτx : ∀ x ∈ W, τ (chartAt E3 p x) = chartAt E3 q x := by
    intro x hx
    simp only [hτdef, (chartAt E3 p).left_inv (hWp hx)]
  have hτO : ∀ y ∈ chartAt E3 p '' W, τ y ∈ chartAt E3 q '' W := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hτx x hx]
    exact ⟨x, hx, rfl⟩
  have hσO : ∀ z ∈ chartAt E3 q '' W, σ z ∈ chartAt E3 p '' W := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨x, hx, ?_⟩
    simp only [hσdef, (chartAt E3 q).left_inv (hWq hx)]
  have hστ : ∀ y ∈ chartAt E3 p '' W, σ (τ y) = y := by
    rintro _ ⟨x, hx, rfl⟩
    rw [hτx x hx]
    simp only [hσdef, (chartAt E3 q).left_inv (hWq hx)]
  
  have hτs : ContDiffOn ℝ ∞ τ (chartAt E3 p '' W) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm)
        (chartAt E3 p '' W) :=
      (contMDiffOn_chart (x := q)).comp ((contMDiffOn_chart_symm (x := p)).mono
        (fun y hy => (hOpt y hy).1)) (fun y hy => hWq (hOpt y hy).2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  
  have hσc : ContinuousOn σ (chartAt E3 q '' W) :=
    (chartAt E3 p).continuousOn.comp ((chartAt E3 q).continuousOn_symm.mono
      (fun z hz => (hOqt z hz).1)) (fun z hz => hWp (hOqt z hz).2)
  
  have hinj : Set.InjOn τ (chartAt E3 p '' W) := by
    intro y₁ h₁ y₂ h₂ h
    rw [← hστ y₁ h₁, ← hστ y₂ h₂, h]
  
  have himg : τ '' (chartAt E3 p '' (E ∩ (chartAt E3 p).source) ∩ chartAt E3 p '' W) =
      chartAt E3 q '' (E ∩ (chartAt E3 q).source) ∩ chartAt E3 q '' W := by
    ext z
    constructor
    · rintro ⟨_, ⟨⟨x', hx', hx'e⟩, ⟨x, hx, rfl⟩⟩, rfl⟩
      have hxx : x' = x := (chartAt E3 p).injOn hx'.2 (hWp hx) hx'e
      subst hxx
      rw [hτx x' hx]
      exact ⟨⟨x', ⟨hx'.1, hWq hx⟩, rfl⟩, ⟨x', hx, rfl⟩⟩
    · rintro ⟨⟨x', hx', hx'e⟩, ⟨x, hx, rfl⟩⟩
      have hxx : x' = x := (chartAt E3 q).injOn hx'.2 (hWq hx) hx'e
      subst hxx
      exact ⟨chartAt E3 p x', ⟨⟨x', ⟨hx'.1, hWp hx⟩, rfl⟩, ⟨x', hx, rfl⟩⟩, hτx x' hx⟩
  
  have hpt : ∀ y ∈ chartAt E3 p '' W,
      DifferentiableAt ℝ τ y ∧
      (jacMat τ y).det ≠ 0 ∧
      Real.sqrt (g.coeff (chartAt E3 p).symm y).det =
        |(jacMat τ y).det| * Real.sqrt (g.coeff (chartAt E3 q).symm (τ y)).det ∧
      ∀ v : Fin 3 → ℝ,
        ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j * v i * v j =
          ∑ a : Fin 3, ∑ b : Fin 3, g.coeff (chartAt E3 q).symm (τ y) a b *
            (∑ i : Fin 3, jacMat τ y a i * v i) * (∑ j : Fin 3, jacMat τ y b j * v j) := by
    intro y hy
    obtain ⟨hyt, hyW⟩ := hOpt y hy
    obtain ⟨hd, hlaw, -⟩ := sep_chart_transition g p q y hyt (hWq hyW)
    have hlaw' : ∀ i j : Fin 3, g.coeff (chartAt E3 p).symm y i j = ∑ a : Fin 3, ∑ b : Fin 3,
        jacMat τ y a i * g.coeff (chartAt E3 q).symm (τ y) a b * jacMat τ y b j := hlaw
    have hmat : g.coeff (chartAt E3 p).symm y =
        (jacMat τ y).transpose * g.coeff (chartAt E3 q).symm (τ y) * jacMat τ y := by
      ext i j
      rw [hlaw' i j]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_three]
      ring
    have hdet : (g.coeff (chartAt E3 p).symm y).det =
        (jacMat τ y).det ^ 2 * (g.coeff (chartAt E3 q).symm (τ y)).det := by
      rw [hmat, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      ring
    have hposp : 0 < (g.coeff (chartAt E3 p).symm y).det :=
      (coeff_chart_symm_posDef g p y hyt).det_pos
    refine ⟨hd, ?_, ?_, ?_⟩
    · intro h0
      rw [hdet, h0] at hposp
      simp at hposp
    · rw [hdet, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    · intro v
      simp only [hlaw', Fin.sum_univ_three]
      ring
  
  have hJc : ∀ y ∈ chartAt E3 p '' W, ContinuousAt (fun z => (jacMat τ z).det) y := by
    intro y hy
    have h1 : ContinuousOn (fderiv ℝ τ) (chartAt E3 p '' W) :=
      hτs.continuousOn_fderiv_of_isOpen hOp (by simp)
    have h2 : (fun z => (jacMat τ z).det) = fun z => (fderiv ℝ τ z).det := by
      funext z
      exact jacdet τ z
    rw [h2]
    exact ContinuousLinearMap.continuous_det.continuousAt.comp (h1.continuousAt (hOp.mem_nhds hy))
  
  have hWd : ∀ (X : E3 → E3), ContDiff ℝ ∞ X → ∀ w₀ ∈ (chartAt E3 q).target, ∀ i : Fin 3,
      DifferentiableAt ℝ (fun w => Real.sqrt (g.coeff (chartAt E3 q).symm w).det * X w i) w₀ := by
    intro X hX w₀ hw₀ i
    have hent : ∀ a b : Fin 3,
        DifferentiableAt ℝ (fun w => g.coeff (chartAt E3 q).symm w a b) w₀ := fun a b =>
      ((g.smooth q a b).contDiffAt ((chartAt E3 q).open_target.mem_nhds hw₀)).differentiableAt
        (by simp)
    have hdet : DifferentiableAt ℝ (fun w => (g.coeff (chartAt E3 q).symm w).det) w₀ := by
      simp only [Matrix.det_fin_three]
      have h00 := hent 0 0
      have h01 := hent 0 1
      have h02 := hent 0 2
      have h10 := hent 1 0
      have h11 := hent 1 1
      have h12 := hent 1 2
      have h20 := hent 2 0
      have h21 := hent 2 1
      have h22 := hent 2 2
      fun_prop
    have hsq : DifferentiableAt ℝ (fun w => Real.sqrt (g.coeff (chartAt E3 q).symm w).det) w₀ :=
      hdet.sqrt (coeff_chart_symm_posDef g q w₀ hw₀).det_pos.ne'
    have hXi : ContDiff ℝ ∞ (fun w => X w i) :=
      (EuclideanSpace.proj (𝕜 := ℝ) i).contDiff.comp hX
    exact hsq.mul ((hXi.differentiable (by simp)) w₀)
  
  unfold sepPerG
  refine iSup₂_le fun X hX => ?_
  obtain ⟨hXs, hXc, hXt, hXn⟩ := hX
  obtain ⟨X', hX's, hX'c, hX't, hP4, hP5, hP6⟩ :=
    transport_field_exists τ σ (chartAt E3 p '' W) (chartAt E3 q '' W) hOp hτs hσc hσO hστ
      (fun y hy => (hpt y hy).2.1) X hXs hXc hXt
  
  have hbound : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      g.coeff (chartAt E3 p).symm y i j * X' y i * X' y j ≤ 1 := by
    intro y
    by_cases hy : y ∈ chartAt E3 p '' W
    · have hq := (hpt y hy).2.2.2 (fun i => X' y i)
      simp only at hq
      rw [hq]
      have h5 : ∀ a : Fin 3, (∑ i : Fin 3, jacMat τ y a i * X' y i) = X (τ y) a :=
        fun a => (hP5 y hy a).symm
      simp only [h5]
      exact hXn (τ y)
    · rw [hP6 y hy]
      simp
  
  have hpw : ∀ a : Fin 3, ∀ z ∈ chartAt E3 p '' W,
      Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X' z a =
        |(jacMat τ z).det| * ((jacMat τ z).det)⁻¹ * ∑ i : Fin 3, (jacMat τ z).adjugate a i *
          (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i) := by
    intro a z hz
    obtain ⟨-, hJ0z, hsqz, -⟩ := hpt z hz
    have h4 := hP4 z hz a
    rw [hsqz]
    have hsum : ∑ i : Fin 3, (jacMat τ z).adjugate a i *
          (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i) =
        Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * ((jacMat τ z).det * X' z a) := by
      rw [h4, Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [hsum]
    generalize (jacMat τ z).det = d at hJ0z ⊢
    generalize Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det = s
    generalize X' z a = x
    rw [show |d| * d⁻¹ * (s * (d * x)) = |d| * s * x * (d * d⁻¹) by ring,
      mul_inv_cancel₀ hJ0z, mul_one]
  have hrel : ∀ y ∈ chartAt E3 p '' W, sepDensDiv (g.coeff (chartAt E3 p).symm) X' y =
      |(fderiv ℝ τ y).det| * sepDensDiv (g.coeff (chartAt E3 q).symm) X (τ y) := by
    intro y hy
    obtain ⟨hd, hJ0, -, -⟩ := hpt y hy
    have hτyt : τ y ∈ (chartAt E3 q).target := (hOqt _ (hτO y hy)).1
    obtain ⟨hA, hPi⟩ := piola_adjugate_div_zero τ (chartAt E3 p '' W) hOp hτs y hy
    have hP := piola_div_of_null τ
      (fun w i => Real.sqrt (g.coeff (chartAt E3 q).symm w).det * X w i) y
      hd hA (fun i => hWd X hXs (τ y) hτyt i) hPi
    simp only at hP
    rw [← jacdet τ y]
    unfold sepDensDiv
    rcases lt_or_gt_of_ne hJ0 with hneg | hpos
    · have hN : ∀ᶠ z in 𝓝 y, z ∈ chartAt E3 p '' W ∧ (jacMat τ z).det < 0 :=
        Filter.Eventually.and (show ∀ᶠ z in 𝓝 y, z ∈ chartAt E3 p '' W from hOp.mem_nhds hy)
          ((hJc y hy).tendsto.eventually (gt_mem_nhds hneg))
      have hloc : ∀ a : Fin 3,
          partialDeriv a (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X' z a) y =
            -partialDeriv a (fun z => ∑ i : Fin 3, (jacMat τ z).adjugate a i *
              (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i)) y := by
        intro a
        have h : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X' z a) =ᶠ[𝓝 y]
            fun z => -(∑ i : Fin 3, (jacMat τ z).adjugate a i *
              (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i)) := by
          filter_upwards [hN] with z hz
          rw [hpw a z hz.1, abs_of_neg hz.2, neg_mul, mul_inv_cancel₀ hz.2.ne, neg_one_mul]
        unfold partialDeriv
        rw [h.fderiv_eq, fderiv_fun_neg]
        rfl
      rw [Finset.sum_congr rfl (fun a _ => hloc a), Finset.sum_neg_distrib, hP, abs_of_neg hneg]
      ring
    · have hN : ∀ᶠ z in 𝓝 y, z ∈ chartAt E3 p '' W ∧ 0 < (jacMat τ z).det :=
        Filter.Eventually.and (show ∀ᶠ z in 𝓝 y, z ∈ chartAt E3 p '' W from hOp.mem_nhds hy)
          ((hJc y hy).tendsto.eventually (lt_mem_nhds hpos))
      have hloc : ∀ a : Fin 3,
          partialDeriv a (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X' z a) y =
            partialDeriv a (fun z => ∑ i : Fin 3, (jacMat τ z).adjugate a i *
              (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i)) y := by
        intro a
        have h : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X' z a) =ᶠ[𝓝 y]
            fun z => ∑ i : Fin 3, (jacMat τ z).adjugate a i *
              (Real.sqrt (g.coeff (chartAt E3 q).symm (τ z)).det * X (τ z) i) := by
          filter_upwards [hN] with z hz
          rw [hpw a z hz.1, abs_of_pos hz.2, mul_inv_cancel₀ hz.2.ne', one_mul]
        unfold partialDeriv
        rw [h.fderiv_eq]
      rw [Finset.sum_congr rfl (fun a _ => hloc a), hP, abs_of_pos hpos]
  
  have hq0 : ∀ z ∈ chartAt E3 q '' (E ∩ (chartAt E3 q).source) \
      (chartAt E3 q '' (E ∩ (chartAt E3 q).source) ∩ chartAt E3 q '' W),
      sepDensDiv (g.coeff (chartAt E3 q).symm) X z = 0 := by
    rintro z ⟨hzS, hzn⟩
    exact densZero _ _ _ fun hzt => hzn ⟨hzS, hXt hzt⟩
  have hp0 : ∀ y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source) \
      (chartAt E3 p '' (E ∩ (chartAt E3 p).source) ∩ chartAt E3 p '' W),
      sepDensDiv (g.coeff (chartAt E3 p).symm) X' y = 0 := by
    rintro y ⟨hyS, hyn⟩
    exact densZero _ _ _ fun hyt => hyn ⟨hyS, hX't hyt⟩
  have hcov : ∫ z in chartAt E3 q '' (E ∩ (chartAt E3 q).source),
        sepDensDiv (g.coeff (chartAt E3 q).symm) X z =
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) X' y := by
    rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero hSq Set.inter_subset_left hq0,
      setIntegral_eq_of_subset_of_forall_diff_eq_zero hSp Set.inter_subset_left hp0,
      ← himg,
      integral_image_eq_integral_abs_det_fderiv_smul volume (hSp.inter hOp.measurableSet)
        (fun y hy => (hpt y hy.2).1.hasFDerivAt.hasFDerivWithinAt)
        (hinj.mono Set.inter_subset_right) (sepDensDiv (g.coeff (chartAt E3 q).symm) X)]
    refine setIntegral_congr_fun (hSp.inter hOp.measurableSet) fun y hy => ?_
    simp only [smul_eq_mul]
    rw [hrel y hy.2]
  exact le_iSup₂_of_le X' ⟨hX's, hX'c, hX't, hbound⟩ (congrArg ENNReal.ofReal hcov).le

theorem hullRiemPer_add_chart_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F₁ F₂ Ω K : Set M) (p : M) (K' V₁ V₂ : Set E3) (hF₁ : sepChartMeas F₁) (hF₂ : sepChartMeas F₂) (hK' : IsCompact K') (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hK'V₂ : K' ⊆ V₂) (hV₂c : IsCompact (closure V₂)) (hV₂V₁ : closure V₂ ⊆ V₁) (hV₁Ω : V₁ ⊆ chartAt E3 p '' ((Ω \ K) ∩ (chartAt E3 p).source)) (hsd : symmDiff F₁ F₂ ⊆ (chartAt E3 p).symm '' K') : hullRiemPer g F₂ Ω K + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) V₂ ≤ hullRiemPer g F₁ Ω K + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source)) V₁ + sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) (V₁ \ K') :=
by
  classical
  haveI : Nonempty M := ⟨p⟩
  
  have mono : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E A B : Set E3), A ⊆ B →
      sepPerG G' E A ≤ sepPerG G' E B := by
    intro G' E A B hAB
    unfold sepPerG
    exact iSup₂_mono' fun X hX => ⟨X, ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2⟩, le_rfl⟩
  have hmono : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E A B Kc : Set E3), A ⊆ B →
      hullPerG G' E A Kc ≤ hullPerG G' E B Kc := by
    intro G' E A B Kc hAB
    unfold hullPerG
    exact iSup₂_mono' fun X hX =>
      ⟨X, ⟨hX.1, hX.2.1, hX.2.2.1.trans hAB, hX.2.2.2.1, hX.2.2.2.2⟩, le_rfl⟩
  have densZero : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (y : E3),
      y ∉ tsupport X → sepDensDiv G' X y = 0 := by
    intro G' X y hy
    have hX : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    unfold partialDeriv
    have h : (fun z => Real.sqrt (G' z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hX] with z hz
      simp [hz]
    rw [h.fderiv_eq]
    simp
  have hcongr : ∀ (G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (E₁ E₂ A Kc : Set E3), MeasurableSet E₁ →
      MeasurableSet E₂ → E₁ ∩ A = E₂ ∩ A → hullPerG G' E₁ A Kc = hullPerG G' E₂ A Kc := by
    intro G' E₁ E₂ A Kc h1 h2 h
    unfold hullPerG
    refine iSup_congr fun X => iSup_congr fun hX => ?_
    congr 1
    rw [← integral_indicator h1, ← integral_indicator h2]
    congr 1
    funext y
    by_cases hyA : y ∈ A
    · have hiff := Set.ext_iff.mp h y
      simp only [Set.mem_inter_iff, hyA, and_true] at hiff
      by_cases hy1 : y ∈ E₁
      · simp [Set.indicator_apply, hy1, hiff.mp hy1]
      · simp [Set.indicator_apply, hy1, (not_congr hiff).mp hy1]
    · have hz := densZero G' X y (fun hy => hyA (hX.2.2.1 hy))
      simp [Set.indicator_apply, hz]
  
  have hsplit : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U E A B Kc : Set E3), IsOpen U →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → (∀ y ∈ U, 0 < (G y).det) →
      MeasurableSet E → IsOpen A → IsOpen B → A ⊆ U → Disjoint A Kc →
      hullPerG G E (A ∪ B) Kc ≤ sepPerG G E A + hullPerG G E B Kc := by
    intro G U E A B Kc hU hG hdet hE hA hB hAU hAK
    have hsq : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) U := by
      have hdetC : ContDiffOn ℝ ∞ (fun z => (G z).det) U := by
        have heq : (fun z => (G z).det) = fun z =>
            G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
              - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
              + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 := by
          funext z; exact Matrix.det_fin_three _
        rw [heq]
        have h := hG
        exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
          (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
          (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
      exact hdetC.sqrt (fun x hx => (hdet x hx).ne')
    have hzero : ∀ (X : E3 → E3) (y : E3), y ∉ tsupport X → ∀ i : Fin 3,
        (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      intro X y hy i
      have hX0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
      filter_upwards [hX0] with z hz
      simp [hz]
    
    have s1 : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ U →
        (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i)) ∧
        Continuous (sepDensDiv G X) ∧ HasCompactSupport (sepDensDiv G X) := by
      intro X hX hXc hXU
      have hcoord : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i =>
        (contDiff_piLp _).1 hX i
      have hsm : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) := by
        intro i
        rw [contDiff_iff_contDiffAt]
        intro y
        by_cases hy : y ∈ U
        · exact (hsq.contDiffAt (hU.mem_nhds hy)).mul (hcoord i).contDiffAt
        · have hy' : y ∉ tsupport X := fun h => hy (hXU h)
          exact contDiffAt_const.congr_of_eventuallyEq (hzero X y hy' i)
      refine ⟨hsm, ?_, ?_⟩
      · show Continuous fun y => ∑ i : Fin 3,
          fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y (e i)
        refine continuous_finset_sum _ fun i _ => ?_
        exact ((hsm i).continuous_fderiv (by simp)).clm_apply continuous_const
      · refine HasCompactSupport.mono' hXc ?_
        intro y hy
        by_contra hy'
        apply hy
        show ∑ i : Fin 3, fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y (e i) = 0
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [(hzero X y hy' i).fderiv_eq]
        simp
    
    have s2 : ∀ T : Set E3, IsCompact T → T ⊆ A ∪ B →
        ∃ ψ₁ ψ₂ : E3 → ℝ, ContDiff ℝ ∞ ψ₁ ∧ ContDiff ℝ ∞ ψ₂ ∧ (∀ x, 0 ≤ ψ₁ x) ∧
          (∀ x, 0 ≤ ψ₂ x) ∧ (∀ x, ψ₁ x + ψ₂ x ≤ 1) ∧ (∀ x ∈ T, ψ₁ x + ψ₂ x = 1) ∧
          tsupport ψ₁ ⊆ A ∧ tsupport ψ₂ ⊆ B := by
      intro T hT hTAB
