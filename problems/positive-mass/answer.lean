      simp only [Nat.cast_zero, sub_zero]
      nlinarith
    · refine (iteratedFDeriv_norm_le_partials _ hUo' u hu' 1 x hx).trans ?_
      have hterm : ∀ L : Fin 1 → Fin 3,
          |(List.ofFn L).foldr partialDeriv u x| ≤ Cm * ‖x‖ ^ (-p - 1) := by
        intro L
        simp only [List.ofFn_succ, List.ofFn_zero, List.foldr_cons, List.foldr_nil]
