    have hsq : ‖x - y‖ ^ (1 / 2 : ℝ) = Real.sqrt ‖x - y‖ := (Real.sqrt_eq_rpow _).symm
    have hσ0 : 0 ≤ Real.sqrt ‖x - y‖ := Real.sqrt_nonneg _
    have hσσ : Real.sqrt ‖x - y‖ * Real.sqrt ‖x - y‖ = ‖x - y‖ :=
