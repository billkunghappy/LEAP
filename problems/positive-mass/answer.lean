        volume ((sepCyl a y₀ r δ ∩ {z | 0 < σ * (z a - u (sepPlaneProj a z))}) \ Fκ) = 0 := by
    intro s ρ hρ hρε h0
    set D : Set E3 := {z | z ∈ Metric.ball y₀ ρ ∧ ∀ i, 0 < φ i (s i) z} with hDdef
    have hρball : Metric.ball y₀ ρ ⊆ Metric.ball y₀ (εs i₀) := Metric.ball_subset_ball hρε
    have hρε' : Metric.ball y₀ ρ ⊆ Metric.ball y₀ ε := hρball.trans hball'ε
    have hρW : Metric.ball y₀ ρ ⊆ chartAt E3 p '' (interior Kv ∩ (chartAt E3 p).source) :=
