          + christoffel G k i j y • fderiv ℝ (fun z => (G z)⁻¹ i j) y)) y := by
      have hin : ∀ i : Fin 3, HasFDerivAt
          (fun z => ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z)
          (∑ j : Fin 3, ((G y)⁻¹ i j • fderiv ℝ (christoffel G k i j) y
            + christoffel G k i j y • fderiv ℝ (fun z => (G z)⁻¹ i j) y)) y := fun i =>
        HasFDerivAt.sum (u := Finset.univ)
          (A := fun j z => (G z)⁻¹ i j * christoffel G k i j z)
          (fun j _ => (hPd i j).hasFDerivAt.mul (hΓd k i j).hasFDerivAt)
      exact HasFDerivAt.sum (u := Finset.univ)
        (A := fun i z => ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z)
        (fun i _ => hin i)
    have hpart : ∀ m : Fin 3,
        fderiv ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y
          (e m) =
        ∑ i : Fin 3, ∑ j : Fin 3, ((G y)⁻¹ i j * partialDeriv m (christoffel G k i j) y
          + christoffel G k i j y * partialDeriv m (fun z => (G z)⁻¹ i j) y) := by
      intro m
      rw [hHas.fderiv]
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, partialDeriv]
    have hpb : ∀ m : Fin 3,
        |fderiv ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y
          (e m)| ≤ 9 * (b * (Kg * v) + 81 / 2 * b ^ 3 * C ^ 2 * v) := by
      intro m
      rw [hpart m]
      apply hsum9
      intro i j
      have t1 : |(G y)⁻¹ i j * partialDeriv m (christoffel G k i j) y| ≤ b * (Kg * v) := by
        rw [abs_mul]; exact mul_le_mul (hPb i j) (hdΓ m k i j) (abs_nonneg _) hb0
      have t2 : |christoffel G k i j y * partialDeriv m (fun z => (G z)⁻¹ i j) y|
          ≤ 81 / 2 * b ^ 3 * C ^ 2 * v := by
        rw [abs_mul]
        calc _ ≤ (9 / 2 * b * (C * u)) * p :=
              mul_le_mul (hΓ k i j) (hdP m i j) (abs_nonneg _) (by positivity)
          _ = 81 / 2 * b ^ 3 * C ^ 2 * (u * u) := by rw [hpdef]; ring
          _ ≤ 81 / 2 * b ^ 3 * C ^ 2 * v := mul_le_mul_of_nonneg_left huu (by positivity)
      exact (abs_add_le _ _).trans (add_le_add t1 t2)
    calc ‖fderiv ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y‖
        ≤ ∑ m : Fin 3, |fderiv ℝ
            (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y (e m)| :=
          hnorm _
      _ ≤ ∑ m : Fin 3, 9 * (b * (Kg * v) + 81 / 2 * b ^ 3 * C ^ 2 * v) :=
          Finset.sum_le_sum fun m _ => hpb m
      _ = Kd * v := by rw [hKddef]; simp only [Fin.sum_univ_three]; ring
      _ ≤ (Ke + Kp + Kv + Kd) * v := mul_le_mul_of_nonneg_right (by linarith) hv0

theorem exterior_scaled_estimate (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2))
    (v : E3 → ℝ) (s A ρ : ℝ) (hρ : R ≤ ρ) (hA : 0 ≤ A)
    (hv : ContDiffOn ℝ ∞ v {x : E3 | ρ < ‖x‖})
    (hv0 : ∀ x : E3, ρ < ‖x‖ → |v x| ≤ A * ‖x‖ ^ s)
    (hL0 : ∀ x : E3, ρ < ‖x‖ → |lapLoc G v x| ≤ A * ‖x‖ ^ (s - 2))
    (hL1 : ∀ x : E3, ρ < ‖x‖ → ‖fderiv ℝ (lapLoc G v) x‖ ≤ A * ‖x‖ ^ (s - 3)) :
    ∃ R' C' : ℝ, ρ ≤ R' ∧ 0 ≤ C' ∧ ∀ x : E3, R' < ‖x‖ →
      (∀ i : Fin 3, |partialDeriv i v x| ≤ C' * ‖x‖ ^ (s - 1)) ∧
      (∀ i j : Fin 3, |partialDeriv i (fun z => partialDeriv j v z) x| ≤ C' * ‖x‖ ^ (s - 2)) :=
by
  classical
  obtain ⟨C_G, hCG, hG⟩ := holder_schauder_global
  obtain ⟨ε₀, C₀, hε₀, hC₀, hest⟩ := perturbed_ball_estimate C_G hCG hG
  obtain ⟨K, hK, hKb⟩ := lapLoc_coeff_bounds G q hq hsmooth R C hR hC hb
  
  have s1 : ∀ (f : E3 → ℝ) (y : E3), lapLoc G f y =
      ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i (fun z => partialDeriv j f z) y
        - ∑ k : Fin 3, (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G k i j y)
            * partialDeriv k f y := by
    intro f y
    simp only [lapLoc, hessLoc, Fin.sum_univ_three]
    ring
  
  obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = 4 * 2 ^ q * K := ⟨_, rfl⟩
  have hT2 : (0 : ℝ) < 2 ^ q := Real.rpow_pos_of_pos (by norm_num) q
  have hX : 0 ≤ X := by rw [hXdef]; positivity
  have hTend : Tendsto (fun r : ℝ => X * r ^ (-q)) atTop (𝓝 0) := by
    simpa using (tendsto_rpow_neg_atTop hq).const_mul X
  obtain ⟨Rε, hRε⟩ := eventually_atTop.mp (hTend.eventually (Iio_mem_nhds hε₀))
  obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = |s| + |s - 2| + |s - 3| := ⟨_, rfl⟩
  have hS2 : (0 : ℝ) < 2 ^ S := Real.rpow_pos_of_pos (by norm_num) S
  have hρ1 : 1 ≤ ρ := le_trans hR hρ
  refine ⟨max (2 * ρ + 1) Rε, 16 * C₀ * A * 2 ^ S, ?_, ?_, ?_⟩
  · exact le_trans (by linarith) (le_max_left _ _)
  · exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₀) hA) hS2.le
  intro x hx
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = ‖x‖ := ⟨_, rfl⟩
  rw [← hrdef] at hx ⊢
  have hr1 : 2 * ρ + 1 < r := lt_of_le_of_lt (le_max_left _ _) hx
  have hrε : Rε ≤ r := le_of_lt (lt_of_le_of_lt (le_max_right _ _) hx)
  have hr : 0 < r := by linarith
  have hr0 : r ≠ 0 := hr.ne'
  obtain ⟨τ, hτdef⟩ : ∃ τ : ℝ, τ = r / 4 := ⟨_, rfl⟩
  have hτ : 0 < τ := by rw [hτdef]; positivity
  obtain ⟨U, hUdef⟩ : ∃ U : Set E3, U = {y : E3 | ρ < ‖y‖} := ⟨_, rfl⟩
  have hU : IsOpen U := by rw [hUdef]; exact isOpen_lt continuous_const continuous_norm
  have hvU : ContDiffOn ℝ ∞ v U := by rw [hUdef]; exact hv
  
  have geo2 : ∀ z : E3, ‖z‖ < 2 → x + τ • z ∈ U := by
    intro z hz
    rw [hUdef]
    show ρ < ‖x + τ • z‖
    have h1 : ‖τ • z‖ = τ * ‖z‖ := by rw [norm_smul, Real.norm_eq_abs, abs_of_pos hτ]
    have h2 : ‖x‖ ≤ ‖x + τ • z‖ + ‖τ • z‖ := by
      calc ‖x‖ = ‖(x + τ • z) - τ • z‖ := by congr 1; abel
        _ ≤ ‖x + τ • z‖ + ‖τ • z‖ := norm_sub_le _ _
    have h3 : τ * ‖z‖ < τ * 2 := mul_lt_mul_of_pos_left hz hτ
    rw [h1, ← hrdef] at h2
    linarith
  have geoB : ∀ y ∈ Metric.ball x τ, r / 2 ≤ ‖y‖ ∧ ‖y‖ ≤ 2 * r ∧ ρ < ‖y‖ := by
    intro y hy
    rw [Metric.mem_ball, dist_eq_norm] at hy
    have h1 : ‖x‖ ≤ ‖y‖ + ‖y - x‖ := by
      calc ‖x‖ = ‖y - (y - x)‖ := by congr 1; abel
        _ ≤ ‖y‖ + ‖y - x‖ := norm_sub_le _ _
    have h2 : ‖y‖ ≤ ‖x‖ + ‖y - x‖ := by
      calc ‖y‖ = ‖x + (y - x)‖ := by congr 1; abel
        _ ≤ ‖x‖ + ‖y - x‖ := norm_add_le _ _
    rw [← hrdef] at h1 h2
    refine ⟨by linarith, by linarith, by linarith⟩
  have memB : ∀ z ∈ Metric.ball (0 : E3) 1, x + τ • z ∈ Metric.ball x τ := by
    intro z hz
    rw [mem_ball_zero_iff] at hz
    rw [Metric.mem_ball, dist_eq_norm, show x + τ • z - x = τ • z by abel, norm_smul,
      Real.norm_eq_abs, abs_of_pos hτ]
    calc τ * ‖z‖ < τ * 1 := mul_lt_mul_of_pos_left hz hτ
      _ = τ := mul_one τ
  have hyb : ∀ z ∈ Metric.ball (0 : E3) 1,
      r / 2 ≤ ‖x + τ • z‖ ∧ ‖x + τ • z‖ ≤ 2 * r ∧ ρ < ‖x + τ • z‖ :=
    fun z hz => geoB _ (memB z hz)
  
  have cmp : ∀ yn p : ℝ, r / 2 ≤ yn → yn ≤ 2 * r → yn ^ p ≤ 2 ^ |p| * r ^ p := by
    intro yn p h1 h2
    have hyn : 0 < yn := by linarith
    rcases le_total 0 p with hp | hp
    · rw [abs_of_nonneg hp, ← Real.mul_rpow (by norm_num) hr.le]
      exact Real.rpow_le_rpow hyn.le h2 hp
    · rw [abs_of_nonpos hp]
      calc yn ^ p ≤ (r / 2) ^ p := Real.rpow_le_rpow_of_nonpos (by positivity) h1 hp
        _ = 2 ^ (-p) * r ^ p := by
          rw [Real.div_rpow hr.le (by norm_num), Real.rpow_neg (by norm_num), div_eq_inv_mul]
  
  have a0 : |-q| = q := by rw [abs_neg, abs_of_pos hq]
  have a1 : |-q - 1| = q + 1 := by rw [abs_of_neg (by linarith)]; ring
  have a2 : |-q - 2| = q + 2 := by rw [abs_of_neg (by linarith)]; ring
  have e1 : (2 : ℝ) ^ (q + 1) = 2 ^ q * 2 := Real.rpow_add_one (by norm_num) q
  have e2 : (2 : ℝ) ^ (q + 2) = 2 ^ q * 4 := by
    rw [Real.rpow_add (by norm_num), Real.rpow_two]; norm_num
  have rq1 : r ^ (-q - 1) = r ^ (-q) / r := Real.rpow_sub_one hr0 (-q)
  have rq2 : r ^ (-q - 2) = r ^ (-q) / r ^ 2 := by rw [Real.rpow_sub hr, Real.rpow_two]
  have rs1 : r ^ (s - 1) = r ^ s / r := Real.rpow_sub_one hr0 s
  have rs2 : r ^ (s - 2) = r ^ s / r ^ 2 := by rw [Real.rpow_sub hr, Real.rpow_two]
  have rs3 : r ^ (s - 3) = r ^ s / r ^ 3 := by
    rw [Real.rpow_sub hr, show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
  have hu : 0 < r ^ (-q) := Real.rpow_pos_of_pos hr _
  have hrs : 0 < r ^ s := Real.rpow_pos_of_pos hr _
  have p0 : (2 : ℝ) ^ |s| ≤ 2 ^ S := Real.rpow_le_rpow_of_exponent_le (by norm_num)
    (by rw [hSdef]; linarith [abs_nonneg (s - 2), abs_nonneg (s - 3)])
  have p2 : (2 : ℝ) ^ |s - 2| ≤ 2 ^ S := Real.rpow_le_rpow_of_exponent_le (by norm_num)
    (by rw [hSdef]; linarith [abs_nonneg s, abs_nonneg (s - 3)])
  have p3 : (2 : ℝ) ^ |s - 3| ≤ 2 ^ S := Real.rpow_le_rpow_of_exponent_le (by norm_num)
    (by rw [hSdef]; linarith [abs_nonneg s, abs_nonneg (s - 2)])
  
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = X * r ^ (-q) := ⟨_, rfl⟩
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = A * 2 ^ S * r ^ s := ⟨_, rfl⟩
  have hε0 : 0 ≤ ε := by rw [hεdef]; positivity
  have hεε₀ : ε ≤ ε₀ := by rw [hεdef]; exact le_of_lt (hRε r hrε)
  have hM0 : 0 ≤ M := by rw [hMdef]; positivity
  
  have hpdU : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ j : Fin 3,
      ContDiffOn ℝ ∞ (fun z => partialDeriv j f z) U :=
    fun f hf j => (hf.fderiv_of_isOpen hU (by simp)).clm_apply contDiffOn_const
  have hdiffU : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ y ∈ U, DifferentiableAt ℝ f y :=
    fun f hf y hy => (hf.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
  have hLdiff : ∀ y : E3, ρ < ‖y‖ → DifferentiableAt ℝ (lapLoc G v) y := by
    intro y hy
    have hyU : y ∈ U := by rw [hUdef]; exact hy
    obtain ⟨hP, hβ⟩ := hKb y (lt_of_le_of_lt hρ hy)
    have heq : lapLoc G v = fun y =>
        ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i (fun z => partialDeriv j v z) y
          - ∑ k : Fin 3, (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G k i j y)
              * partialDeriv k v y := funext (s1 v)
    rw [heq]
    apply DifferentiableAt.sub
    · apply DifferentiableAt.fun_sum
      intro i _
      apply DifferentiableAt.fun_sum
      intro j _
      exact (hP i j).2.1.mul (hdiffU _ (hpdU _ (hpdU v hvU j) i) y hyU)
    · apply DifferentiableAt.fun_sum
      intro k _
      exact (hβ k).2.1.mul (hdiffU _ (hpdU v hvU k) y hyU)
  
  have mvt : ∀ (f : E3 → ℝ) (L : ℝ), (∀ y ∈ Metric.ball x τ, DifferentiableAt ℝ f y) →
      (∀ y ∈ Metric.ball x τ, ‖fderiv ℝ f y‖ ≤ L) →
      ∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
        |f (x + τ • z) - f (x + τ • z')| ≤ L * (τ * ‖z - z'‖) := by
    intro f L hd hL z hz z' hz'
    have h := (convex_ball x τ).norm_image_sub_le_of_norm_fderiv_le hd hL (memB z' hz') (memB z hz)
    rw [Real.norm_eq_abs] at h
    have e : x + τ • z - (x + τ • z') = τ • (z - z') := by rw [smul_sub]; abel
    rw [e, norm_smul, Real.norm_eq_abs, abs_of_pos hτ] at h
    exact h
  
  have bP : ∀ i j : Fin 3, ∀ y ∈ Metric.ball x τ,
      ‖fderiv ℝ (fun z => (G z)⁻¹ i j) y‖ ≤ K * (2 ^ q * 2 * (r ^ (-q) / r)) := by
    intro i j y hy
    obtain ⟨g1, g2, g3⟩ := geoB y hy
    have hc := cmp ‖y‖ (-q - 1) g1 g2
    rw [a1, e1, rq1] at hc
    exact le_trans ((hKb y (lt_of_le_of_lt hρ g3)).1 i j).2.2 (mul_le_mul_of_nonneg_left hc hK)
  have bβ : ∀ k : Fin 3, ∀ y ∈ Metric.ball x τ,
      ‖fderiv ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * christoffel G k i j z) y‖
        ≤ K * (2 ^ q * 4 * (r ^ (-q) / r ^ 2)) := by
    intro k y hy
    obtain ⟨g1, g2, g3⟩ := geoB y hy
    have hc := cmp ‖y‖ (-q - 2) g1 g2
    rw [a2, e2, rq2] at hc
    exact le_trans ((hKb y (lt_of_le_of_lt hρ g3)).2 k).2.2 (mul_le_mul_of_nonneg_left hc hK)
  have bL : ∀ y ∈ Metric.ball x τ,
      ‖fderiv ℝ (lapLoc G v) y‖ ≤ A * (2 ^ |s - 3| * (r ^ s / r ^ 3)) := by
    intro y hy
    obtain ⟨g1, g2, g3⟩ := geoB y hy
    have hc := cmp ‖y‖ (s - 3) g1 g2
    rw [rs3] at hc
    exact le_trans (hL1 y g3) (mul_le_mul_of_nonneg_left hc hA)
  
  have hwb : ∀ z ∈ Metric.ball (0 : E3) 1, |v (x + τ • z)| ≤ M := by
    intro z hz
    obtain ⟨h1, h2, h3⟩ := hyb z hz
    have hc := cmp _ s h1 h2
    calc |v (x + τ • z)| ≤ A * ‖x + τ • z‖ ^ s := hv0 _ h3
      _ ≤ A * (2 ^ |s| * r ^ s) := mul_le_mul_of_nonneg_left hc hA
      _ ≤ A * (2 ^ S * r ^ s) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right p0 hrs.le) hA
      _ = M := by rw [hMdef]; ring
  have hcoef : ∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
      (∀ i j : Fin 3, |(G (x + τ • z))⁻¹ i j - (if i = j then (1 : ℝ) else 0)| ≤ ε ∧
          |(G (x + τ • z))⁻¹ i j - (G (x + τ • z'))⁻¹ i j| ≤ ε * ‖z - z'‖) ∧
      (∀ k : Fin 3,
          |τ * ∑ i : Fin 3, ∑ j : Fin 3, (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z)|
            ≤ ε ∧
          |τ * ∑ i : Fin 3, ∑ j : Fin 3, (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z)
            - τ * ∑ i : Fin 3, ∑ j : Fin 3,
                (G (x + τ • z'))⁻¹ i j * christoffel G k i j (x + τ • z')| ≤ ε * ‖z - z'‖) ∧
      |τ ^ 2 * lapLoc G v (x + τ • z)| ≤ M ∧
      |τ ^ 2 * lapLoc G v (x + τ • z) - τ ^ 2 * lapLoc G v (x + τ • z')| ≤ M * ‖z - z'‖ := by
    intro z hz z' hz'
    obtain ⟨h1, h2, h3⟩ := hyb z hz
    obtain ⟨hP, hβ⟩ := hKb _ (lt_of_le_of_lt hρ h3)
    have hd : 0 ≤ ‖z - z'‖ := norm_nonneg _
    have hτ2 : 0 < τ ^ 2 := pow_pos hτ 2
    have hεd : ε * ‖z - z'‖ = 4 * (K * 2 ^ q * r ^ (-q) * ‖z - z'‖) := by
      rw [hεdef, hXdef]; ring
    have hεe : ε = 4 * (K * 2 ^ q * r ^ (-q)) := by rw [hεdef, hXdef]; ring
    have hP0 : 0 ≤ K * 2 ^ q * r ^ (-q) := by positivity
    have hPd : 0 ≤ K * 2 ^ q * r ^ (-q) * ‖z - z'‖ := by positivity
    refine ⟨fun i j => ⟨?_, ?_⟩, fun k => ⟨?_, ?_⟩, ?_, ?_⟩
    · have hc := cmp _ (-q) h1 h2
      rw [a0] at hc
      calc _ ≤ K * ‖x + τ • z‖ ^ (-q) := (hP i j).1
        _ ≤ K * (2 ^ q * r ^ (-q)) := mul_le_mul_of_nonneg_left hc hK
        _ = K * 2 ^ q * r ^ (-q) := by ring
        _ ≤ ε := by rw [hεe]; linarith
    · have h := mvt (fun w => (G w)⁻¹ i j) (K * (2 ^ q * 2 * (r ^ (-q) / r)))
        (fun y hy => ((hKb y (lt_of_le_of_lt hρ (geoB y hy).2.2)).1 i j).2.1) (bP i j) z hz z' hz'
      calc _ ≤ K * (2 ^ q * 2 * (r ^ (-q) / r)) * (τ * ‖z - z'‖) := h
        _ = (K * 2 ^ q * r ^ (-q) * ‖z - z'‖) / 2 := by rw [hτdef]; field_simp; ring
        _ ≤ ε * ‖z - z'‖ := by rw [hεd]; linarith
    · have hc := cmp _ (-q - 1) h1 h2
      rw [a1, e1, rq1] at hc
      calc _ = τ * |∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z)| := by
            rw [abs_mul, abs_of_pos hτ]
        _ ≤ τ * (K * (2 ^ q * 2 * (r ^ (-q) / r))) :=
            mul_le_mul_of_nonneg_left (le_trans (hβ k).1 (mul_le_mul_of_nonneg_left hc hK)) hτ.le
        _ = (K * 2 ^ q * r ^ (-q)) / 2 := by rw [hτdef]; field_simp; ring
        _ ≤ ε := by rw [hεe]; linarith
    · have h := mvt (fun w => ∑ i : Fin 3, ∑ j : Fin 3, (G w)⁻¹ i j * christoffel G k i j w)
        (K * (2 ^ q * 4 * (r ^ (-q) / r ^ 2)))
        (fun y hy => ((hKb y (lt_of_le_of_lt hρ (geoB y hy).2.2)).2 k).2.1) (bβ k) z hz z' hz'
      calc _ = τ * |∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z)
            - ∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + τ • z'))⁻¹ i j * christoffel G k i j (x + τ • z')| := by
            rw [← mul_sub, abs_mul, abs_of_pos hτ]
        _ ≤ τ * (K * (2 ^ q * 4 * (r ^ (-q) / r ^ 2)) * (τ * ‖z - z'‖)) :=
            mul_le_mul_of_nonneg_left h hτ.le
        _ = (K * 2 ^ q * r ^ (-q) * ‖z - z'‖) / 4 := by rw [hτdef]; field_simp
        _ ≤ ε * ‖z - z'‖ := by rw [hεd]; linarith
    · have hc := cmp _ (s - 2) h1 h2
      rw [rs2] at hc
      have h0 : 0 ≤ A * 2 ^ |s - 2| * r ^ s := by positivity
      have h4 : A * 2 ^ |s - 2| * r ^ s ≤ M := by
        rw [hMdef]
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left p2 hA) hrs.le
      calc _ = τ ^ 2 * |lapLoc G v (x + τ • z)| := by rw [abs_mul, abs_of_pos hτ2]
        _ ≤ τ ^ 2 * (A * (2 ^ |s - 2| * (r ^ s / r ^ 2))) :=
            mul_le_mul_of_nonneg_left (le_trans (hL0 _ h3) (mul_le_mul_of_nonneg_left hc hA))
              hτ2.le
        _ = A * 2 ^ |s - 2| * r ^ s / 16 := by rw [hτdef]; field_simp; ring
        _ ≤ M := by linarith
    · have h := mvt (lapLoc G v) _ (fun y hy => hLdiff y (geoB y hy).2.2) bL z hz z' hz'
      have h0 : 0 ≤ A * 2 ^ |s - 3| * r ^ s * ‖z - z'‖ := by positivity
      have h4 : A * 2 ^ |s - 3| * r ^ s * ‖z - z'‖ ≤ M * ‖z - z'‖ := by
        rw [hMdef]
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left p3 hA) hrs.le) hd
      calc _ = τ ^ 2 * |lapLoc G v (x + τ • z) - lapLoc G v (x + τ • z')| := by
            rw [← mul_sub, abs_mul, abs_of_pos hτ2]
        _ ≤ τ ^ 2 * (A * (2 ^ |s - 3| * (r ^ s / r ^ 3)) * (τ * ‖z - z'‖)) :=
            mul_le_mul_of_nonneg_left h hτ2.le
        _ = A * 2 ^ |s - 3| * r ^ s * ‖z - z'‖ / 64 := by rw [hτdef]; field_simp; ring
        _ ≤ M * ‖z - z'‖ := by linarith
  
  have hEq : ∀ z ∈ Metric.ball (0 : E3) 1,
      ∑ i : Fin 3, ∑ j : Fin 3, (G (x + τ • z))⁻¹ i j *
          partialDeriv i (fun y => partialDeriv j (fun y' => v (x + τ • y')) y) z
        - ∑ k : Fin 3, (τ * ∑ i : Fin 3, ∑ j : Fin 3,
            (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z)) *
            partialDeriv k (fun y' => v (x + τ • y')) z
        = τ ^ 2 * lapLoc G v (x + τ • z) := by
    intro z hz
    have hz2 : ‖z‖ < 2 := by rw [mem_ball_zero_iff] at hz; linarith
    obtain ⟨h1, h2⟩ := rescale_partialDeriv v U hU hvU x τ z (geo2 z hz2)
    simp only [h1, h2, s1 v (x + τ • z)]
    simp only [Fin.sum_univ_three]
    ring
  
  have hsm : ContDiffOn ℝ ∞ (fun y => v (x + τ • y)) (Metric.ball 0 2) := by
    have haff : ContDiff ℝ ∞ (fun y : E3 => x + τ • y) :=
      contDiff_const.add (contDiff_id.const_smul τ)
    exact hvU.comp haff.contDiffOn
      (fun z hz => geo2 z (by rw [mem_ball_zero_iff] at hz; exact hz))
  
  obtain ⟨hd1, hd2⟩ := hest (fun y => v (x + τ • y)) (fun z => (G (x + τ • z))⁻¹)
    (fun z k => τ * ∑ i : Fin 3, ∑ j : Fin 3,
      (G (x + τ • z))⁻¹ i j * christoffel G k i j (x + τ • z))
    (fun z => τ ^ 2 * lapLoc G v (x + τ • z)) ε M hε0 hεε₀ hM0 hsm hwb hcoef hEq
  have hx0 : x + τ • (0 : E3) ∈ U := geo2 0 (by simp)
  obtain ⟨g1, g2⟩ := rescale_partialDeriv v U hU hvU x τ 0 hx0
  simp only [smul_zero, add_zero] at g1 g2
  have hCM : 0 ≤ C₀ * M := mul_nonneg hC₀ hM0
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · have h := hd1 i
    rw [g1 i, abs_mul, abs_of_pos hτ, hτdef] at h
    have key : 16 * C₀ * A * 2 ^ S * r ^ (s - 1) = 16 * (C₀ * M) / r := by
      rw [rs1, hMdef]; ring
    rw [key, le_div_iff₀ hr]
    nlinarith [abs_nonneg (partialDeriv i v x)]
  · have h := hd2 i j
    rw [g2 i j, abs_mul, abs_of_pos (pow_pos hτ 2), hτdef] at h
    have key : 16 * C₀ * A * 2 ^ S * r ^ (s - 2) = 16 * (C₀ * M) / r ^ 2 := by
      rw [rs2, hMdef]; ring
    rw [key, le_div_iff₀ (pow_pos hr 2)]
    nlinarith [abs_nonneg (partialDeriv i (fun z => partialDeriv j v z) x)]

theorem lapLocal_chart_invariant [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (f : M → ℝ) (V : Set M) (hV : IsOpen V)
    (hf : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f V) (x : E3) (hx : x ∈ Φ.source) (hxV : Φ x ∈ V) :
    lapLocal (g.coeff Φ) (f ∘ Φ) x = lapM g f (Φ x) :=
by
  
  have hu : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hcomp_e : ∀ v : Fin 3 → ℝ, ∀ a : Fin 3, (∑ i : Fin 3, v i • e i) a = v a := by
    intro v a
    simp [Pi.single_apply]
  have hcompo : ∀ (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z → ∀ l d : Fin 3,
      partialDeriv l (fun v => ψ v d) z = (fderiv ℝ ψ z (e l)) d := by
    intro ψ z hψ l d
    have hfun : (fun v => ψ v d) = (EuclideanSpace.proj d : E3 →L[ℝ] ℝ) ∘ ψ := by
      funext v; simp
    rw [partialDeriv, hfun, fderiv_comp z (EuclideanSpace.proj d).differentiableAt hψ,
      ContinuousLinearMap.fderiv]
    simp
  have dmul : ∀ (f g : E3 → ℝ) (z : E3), DifferentiableAt ℝ f z → DifferentiableAt ℝ g z →
      DifferentiableAt ℝ (fun w => f w * g w) z := fun f g z hf hg => hf.mul hg
  have pd_mul : ∀ (f g : E3 → ℝ) (z : E3) (l : Fin 3), DifferentiableAt ℝ f z →
      DifferentiableAt ℝ g z →
      partialDeriv l (fun w => f w * g w) z = partialDeriv l f z * g z + f z * partialDeriv l g z := by
    intro f g z l hf hg
    simp only [partialDeriv, fderiv_fun_mul hf hg, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pd_sum : ∀ (f : Fin 3 → E3 → ℝ) (z : E3) (l : Fin 3), (∀ a, DifferentiableAt ℝ (f a) z) →
      partialDeriv l (fun w => ∑ a : Fin 3, f a w) z = ∑ a : Fin 3, partialDeriv l (f a) z := by
    intro f z l hf
    simp only [partialDeriv, fderiv_fun_sum (fun a _ => hf a), ContinuousLinearMap.sum_apply]
  have pd_comp : ∀ (F : E3 → ℝ) (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z →
      DifferentiableAt ℝ F (ψ z) → ∀ l : Fin 3,
      partialDeriv l (fun w => F (ψ w)) z
        = ∑ d : Fin 3, partialDeriv d F (ψ z) * partialDeriv l (fun v => ψ v d) z := by
    intro F ψ z hψ hF l
    have h1 : partialDeriv l (fun w => F (ψ w)) z = fderiv ℝ F (ψ z) (fderiv ℝ ψ z (e l)) := by
      show fderiv ℝ (F ∘ ψ) z (e l) = _
      rw [fderiv_comp z hF hψ]
      rfl
    rw [h1, hu (fderiv ℝ ψ z (e l)), map_sum]
    simp only [map_smul, smul_eq_mul, hcompo ψ z hψ]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  have hpdU : ∀ (U : Set E3), IsOpen U → ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro U hU f hf i
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) U := hf.fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  
  have pullback_partialDeriv : ∀ (ψ : E3 → E3) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U V : Set E3),
      IsOpen U → IsOpen V → ContDiffOn ℝ ∞ ψ U → (∀ z ∈ U, ψ z ∈ V) →
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) V) → ∀ z ∈ U, ∀ l i j : Fin 3,
      partialDeriv l (fun w => ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w) z =
        ∑ a : Fin 3, ∑ b : Fin 3,
          (partialDeriv l (partialDeriv i (fun v => ψ v a)) z * G (ψ z) a b *
              partialDeriv j (fun v => ψ v b) z +
            partialDeriv i (fun v => ψ v a) z *
              (∑ d : Fin 3, partialDeriv d (fun y => G y a b) (ψ z) *
                partialDeriv l (fun v => ψ v d) z) * partialDeriv j (fun v => ψ v b) z +
            partialDeriv i (fun v => ψ v a) z * G (ψ z) a b *
              partialDeriv l (partialDeriv j (fun v => ψ v b)) z) := by
    intro ψ G U V hU hV hψ hmaps hG z hz l i j
    have hψd : DifferentiableAt ℝ ψ z :=
      (hψ.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)
    have hJd : ∀ a k : Fin 3, DifferentiableAt ℝ (partialDeriv k (fun v => ψ v a)) z := by
      intro a k
      exact ((hpdU U hU _ (contDiffOn_euclidean.mp hψ a) k).contDiffAt
        (hU.mem_nhds hz)).differentiableAt (by simp)
    have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) (ψ z) := fun a b =>
      ((hG a b).contDiffAt (hV.mem_nhds (hmaps z hz))).differentiableAt (by simp)
    have hGψd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun w => G (ψ w) a b) z :=
      fun a b => (hGd a b).comp z hψd
    have htd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun w => partialDeriv i (fun v => ψ v a) w *
        G (ψ w) a b * partialDeriv j (fun v => ψ v b) w) z :=
      fun a b => dmul _ _ _ (dmul _ _ _ (hJd a i) (hGψd a b)) (hJd b j)
    rw [pd_sum _ _ _ (fun a => DifferentiableAt.fun_sum (fun b _ => htd a b))]
    apply Finset.sum_congr rfl
    intro a _
    rw [pd_sum _ _ _ (fun b => htd a b)]
    apply Finset.sum_congr rfl
    intro b _
    rw [pd_mul _ _ _ _ (dmul _ _ _ (hJd a i) (hGψd a b)) (hJd b j),
      pd_mul _ _ _ _ (hJd a i) (hGψd a b), pd_comp (fun y => G y a b) ψ z hψd (hGd a b) l]
    ring
  
  have christoffel_pullback_algebra : ∀ (A G Gt : Matrix (Fin 3) (Fin 3) ℝ)
      (dG H dGt : Fin 3 → Fin 3 → Fin 3 → ℝ),
      A.det ≠ 0 → G.det ≠ 0 → (∀ a b, G a b = G b a) → (∀ c i j, H c i j = H c j i) →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * G a b * A b j) →
      (∀ l i j, dGt l i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (H a l i * G a b * A b j + A a i * (∑ d : Fin 3, dG d a b * A d l) * A b j
          + A a i * G a b * H b l j)) →
      ∀ c i j : Fin 3, ∑ k : Fin 3, A c k * ((1 / 2 : ℝ) * ∑ l : Fin 3, Gt⁻¹ k l *
          (dGt i j l + dGt j i l - dGt l i j)) =
        ∑ a : Fin 3, ∑ b : Fin 3, ((1 / 2 : ℝ) * ∑ l : Fin 3, G⁻¹ c l *
          (dG a b l + dG b a l - dG l a b)) * A a i * A b j + H c i j := by
    intro A G Gt dG H dGt hA hG hGs hH hGt hdGt c i j
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGu : IsUnit G.det := isUnit_iff_ne_zero.mpr hG
    have hGt' : Gt = Matrix.transpose A * G * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGiG : G⁻¹ * G = 1 := Matrix.nonsing_inv_mul G hGu
    have hGtinv : Gt⁻¹ = A⁻¹ * G⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hα : A * Gt⁻¹ = G⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGtinv, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hAB, Matrix.one_mul]
    have hα' : ∀ l, ∑ k : Fin 3, A c k * Gt⁻¹ k l = ∑ b : Fin 3, G⁻¹ c b * A⁻¹ l b := by
      intro l
      have h1 := congrFun (congrFun hα c) l
      simp only [Matrix.mul_apply, Matrix.transpose_apply] at h1
      exact h1
    have hβ : ∀ l, dGt i j l + dGt j i l - dGt l i j = ∑ γ : Fin 3, A γ l *
        (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β γ + dG β α γ - dG γ α β)
          + 2 * ∑ a : Fin 3, G a γ * H a i j) := by
      intro l
      rw [hdGt, hdGt, hdGt]
      simp only [Fin.sum_univ_three, hH _ j i, hH _ l i, hH _ l j]
      simp only [hGs 1 0, hGs 2 0, hGs 2 1]
      ring
    have eAB : ∀ γ b : Fin 3, A γ 0 * A⁻¹ 0 b + A γ 1 * A⁻¹ 1 b + A γ 2 * A⁻¹ 2 b
        = if γ = b then 1 else 0 := by
      intro γ b
      rw [← Matrix.one_apply, ← hAB, Matrix.mul_apply, Fin.sum_univ_three]
    have hcontr : ∀ (u W : Fin 3 → ℝ), ∑ l : Fin 3, (∑ b : Fin 3, u b * A⁻¹ l b) *
        (∑ γ : Fin 3, A γ l * W γ) = ∑ b : Fin 3, u b * W b := by
      intro u W
      simp only [Fin.sum_univ_three]
      linear_combination
        (u 0 * W 0) * (eAB 0 0).trans (if_pos rfl)
        + (u 1 * W 0) * (eAB 0 1).trans (if_neg (by decide))
        + (u 2 * W 0) * (eAB 0 2).trans (if_neg (by decide))
        + (u 0 * W 1) * (eAB 1 0).trans (if_neg (by decide))
        + (u 1 * W 1) * (eAB 1 1).trans (if_pos rfl)
        + (u 2 * W 1) * (eAB 1 2).trans (if_neg (by decide))
        + (u 0 * W 2) * (eAB 2 0).trans (if_neg (by decide))
        + (u 1 * W 2) * (eAB 2 1).trans (if_neg (by decide))
        + (u 2 * W 2) * (eAB 2 2).trans (if_pos rfl)
    have hGG : ∑ a : Fin 3, (∑ b : Fin 3, G⁻¹ c b * G a b) * H a i j = H c i j := by
      have h2 : ∀ a, ∑ b : Fin 3, G⁻¹ c b * G a b = (1 : Matrix (Fin 3) (Fin 3) ℝ) c a := by
        intro a
        rw [← hGiG, Matrix.mul_apply]
        exact Finset.sum_congr rfl (fun b _ => by rw [hGs a b])
      simp only [h2, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
        Finset.mem_univ, if_true]
    calc ∑ k : Fin 3, A c k * ((1 / 2 : ℝ) * ∑ l : Fin 3, Gt⁻¹ k l *
            (dGt i j l + dGt j i l - dGt l i j))
        = (1 / 2 : ℝ) * ∑ l : Fin 3, (∑ k : Fin 3, A c k * Gt⁻¹ k l) *
            (dGt i j l + dGt j i l - dGt l i j) := by
          simp only [Fin.sum_univ_three]
          ring
      _ = (1 / 2 : ℝ) * ∑ l : Fin 3, (∑ b : Fin 3, G⁻¹ c b * A⁻¹ l b) * (∑ γ : Fin 3, A γ l *
            (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β γ + dG β α γ - dG γ α β)
              + 2 * ∑ a : Fin 3, G a γ * H a i j)) := by
          simp only [hα', hβ]
      _ = (1 / 2 : ℝ) * ∑ b : Fin 3, G⁻¹ c b *
            (∑ α : Fin 3, ∑ β : Fin 3, A α i * A β j * (dG α β b + dG β α b - dG b α β)
              + 2 * ∑ a : Fin 3, G a b * H a i j) := by
          rw [hcontr (fun b => G⁻¹ c b) (fun γ => ∑ α : Fin 3, ∑ β : Fin 3,
            A α i * A β j * (dG α β γ + dG β α γ - dG γ α β) + 2 * ∑ a : Fin 3, G a γ * H a i j)]
      _ = _ := by
          rw [← hGG]
          simp only [Fin.sum_univ_three]
          ring
  
  have lap_contraction_algebra : ∀ (A Gm Gt : Matrix (Fin 3) (Fin 3) ℝ)
      (Γt Γ H : Fin 3 → Fin 3 → Fin 3 → ℝ) (P : Fin 3 → ℝ) (Q : Fin 3 → Fin 3 → ℝ),
      A.det ≠ 0 → (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * Gm a b * A b j) →
      (∀ c i j, ∑ k : Fin 3, A c k * Γt k i j =
        ∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * A a i * A b j + H c i j) →
      ∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j *
          ((∑ d : Fin 3, (∑ e : Fin 3, Q e d * A e i) * A d j + ∑ d : Fin 3, P d * H d i j)
            - ∑ k : Fin 3, Γt k i j * (∑ d : Fin 3, P d * A d k)) =
        ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * (Q i j - ∑ k : Fin 3, Γ k i j * P k) := by
    intro A Gm Gt Γt Γ H P Q hA hGt hT1
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGt' : Gt = Matrix.transpose A * Gm * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGtinv : Gt⁻¹ = A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hM : A * Gt⁻¹ * Matrix.transpose A = Gm⁻¹ := by
      rw [hGtinv]
      calc A * (A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹) * Matrix.transpose A
          = (A * A⁻¹) * Gm⁻¹ * (Matrix.transpose A⁻¹ * Matrix.transpose A) := by
            simp only [Matrix.mul_assoc]
        _ = Gm⁻¹ := by
            rw [hAB, ← Matrix.transpose_mul, hAB, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hM' : ∀ a b, ∑ i : Fin 3, ∑ j : Fin 3, A a i * Gt⁻¹ i j * A b j = Gm⁻¹ a b := by
      intro a b
      rw [← hM]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hbr : ∀ i j, ((∑ d : Fin 3, (∑ e : Fin 3, Q e d * A e i) * A d j
          + ∑ d : Fin 3, P d * H d i j)
            - ∑ k : Fin 3, Γt k i j * (∑ d : Fin 3, P d * A d k)) =
        ∑ a : Fin 3, ∑ b : Fin 3, A a i * A b j * (Q a b - ∑ k : Fin 3, Γ k a b * P k) := by
      intro i j
      have h0 := hT1 0 i j
      have h1 := hT1 1 i j
      have h2 := hT1 2 i j
      simp only [Fin.sum_univ_three] at h0 h1 h2 ⊢
      linear_combination (-(P 0)) * h0 + (-(P 1)) * h1 + (-(P 2)) * h2
    simp only [hbr, ← hM']
    simp only [Fin.sum_univ_three]
    ring
  
  have partialDeriv_comm : ∀ (f : E3 → ℝ) (U : Set E3), IsOpen U → ContDiffOn ℝ ∞ f U →
      ∀ z ∈ U, ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j f) z = partialDeriv j (partialDeriv i f) z := by
    intro f U hU hf z hz i j
    have hfz : ContDiffAt ℝ ∞ f z := hf.contDiffAt (hU.mem_nhds hz)
    have hsymm : IsSymmSndFDerivAt ℝ f z :=
      hfz.isSymmSndFDerivAt (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
    have hd : DifferentiableAt ℝ (fderiv ℝ f) z :=
      (hfz.fderiv_right (m := 1) (by
        rw [one_add_one_eq_two]; exact WithTop.coe_le_coe.mpr le_top)).differentiableAt one_ne_zero
    have key2 : ∀ a b : Fin 3,
        partialDeriv a (partialDeriv b f) z = fderiv ℝ (fderiv ℝ f) z (e a) (e b) := by
      intro a b
      show fderiv ℝ (fun y => fderiv ℝ f y (e b)) z (e a) = _
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    rw [key2, key2, hsymm]
  
  have lapLocal_congr : ∀ (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      G =ᶠ[𝓝 y] G' → u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G' v y := by
    intro G G' u v y hG huv
    have hy0 : G y = G' y := hG.eq_of_nhds
    have hent : ∀ a b i, partialDeriv i (fun z => G z a b) y
        = partialDeriv i (fun z => G' z a b) y := by
      intro a b i
      have : (fun z => G z a b) =ᶠ[𝓝 y] (fun z => G' z a b) :=
        hG.mono (fun z hz => by simp [hz])
      simp only [partialDeriv, this.fderiv_eq]
    have hchr : ∀ k i j, christoffel G k i j y = christoffel G' k i j y := by
      intro k i j
      simp only [christoffel, hy0, hent]
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, hy0, hchr, h1, h2]
  
  have key : ∀ (ψ : E3 → E3) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (U V : Set E3),
      IsOpen U → IsOpen V → ContDiffOn ℝ ∞ ψ U → (∀ z ∈ U, ψ z ∈ V) →
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) V) →
      (∀ y a b, G y a b = G y b a) → ContDiffOn ℝ ∞ u V → x ∈ U →
      (G (ψ x)).det ≠ 0 →
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x).det ≠ 0 →
      lapLocal (fun w => Matrix.of fun i j : Fin 3 => ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w)
          (fun w => u (ψ w)) x
        = lapLocal G u (ψ x) := by
    intro ψ G u U V hUo hVo hψ hmaps hG hGsym huV hxU hdetG hdetJ
    have hψc : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun v => ψ v a) U := fun a =>
      contDiffOn_euclidean.mp hψ a
    set Gt : E3 → Matrix (Fin 3) (Fin 3) ℝ := fun w => Matrix.of fun i j : Fin 3 =>
      ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv i (fun v => ψ v a) w * G (ψ w) a b * partialDeriv j (fun v => ψ v b) w
      with hGt
    have hH : ∀ c i j : Fin 3, partialDeriv i (partialDeriv j (fun v => ψ v c)) x
        = partialDeriv j (partialDeriv i (fun v => ψ v c)) x :=
      fun c i j => partialDeriv_comm _ U hUo (hψc c) x hxU i j
    have hT1 : ∀ c i j : Fin 3,
        ∑ k : Fin 3, partialDeriv k (fun v => ψ v c) x * christoffel Gt k i j x
          = ∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b (ψ x) * partialDeriv i (fun v => ψ v a) x *
            partialDeriv j (fun v => ψ v b) x + partialDeriv i (partialDeriv j (fun v => ψ v c)) x := by
      intro c i j
      have h8 := pullback_partialDeriv ψ G U V hUo hVo hψ hmaps hG x hxU
      have h9 := christoffel_pullback_algebra
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x) (G (ψ x)) (Gt x)
        (fun d a b => partialDeriv d (fun y => G y a b) (ψ x))
        (fun c i j => partialDeriv i (partialDeriv j (fun v => ψ v c)) x)
        (fun l i j => partialDeriv l (fun w => Gt w i j) x)
        hdetJ hdetG (fun a b => hGsym _ a b)
        (fun c i j => hH c i j) (fun i j => rfl) (fun l i j => h8 l i j) c i j
      exact h9
    have hψd : ∀ z ∈ U, DifferentiableAt ℝ ψ z := fun z hz =>
      (hψ.contDiffAt (hUo.mem_nhds hz)).differentiableAt (by simp)
    have hud : ∀ z ∈ U, DifferentiableAt ℝ u (ψ z) := fun z hz =>
      (huV.contDiffAt (hVo.mem_nhds (hmaps z hz))).differentiableAt (by simp)
    have h7a : ∀ k : Fin 3, partialDeriv k (fun w => u (ψ w)) x
        = ∑ d : Fin 3, partialDeriv d u (ψ x) * partialDeriv k (fun v => ψ v d) x :=
      fun k => pd_comp u ψ x (hψd x hxU) (hud x hxU) k
    have hJd : ∀ a k : Fin 3, DifferentiableAt ℝ (partialDeriv k (fun v => ψ v a)) x := by
      intro a k
      exact ((hpdU U hUo _ (hψc a) k).contDiffAt (hUo.mem_nhds hxU)).differentiableAt (by simp)
    have hPd : ∀ d : Fin 3, DifferentiableAt ℝ (partialDeriv d u) (ψ x) := fun d =>
      ((hpdU V hVo u huV d).contDiffAt (hVo.mem_nhds (hmaps x hxU))).differentiableAt (by simp)
    have hPψd : ∀ d : Fin 3, DifferentiableAt ℝ (fun y => partialDeriv d u (ψ y)) x := fun d =>
      (hPd d).comp x (hψd x hxU)
    have h7b : ∀ i j : Fin 3, partialDeriv i (fun y => partialDeriv j (fun w => u (ψ w)) y) x
        = ∑ d : Fin 3, (∑ e : Fin 3, partialDeriv e (fun y => partialDeriv d u y) (ψ x) *
            partialDeriv i (fun v => ψ v e) x) * partialDeriv j (fun v => ψ v d) x
          + ∑ d : Fin 3, partialDeriv d u (ψ x) * partialDeriv i (partialDeriv j (fun v => ψ v d)) x := by
      intro i j
      have hev : (fun y => partialDeriv j (fun w => u (ψ w)) y) =ᶠ[𝓝 x]
          (fun y => ∑ d : Fin 3, partialDeriv d u (ψ y) * partialDeriv j (fun v => ψ v d) y) := by
        filter_upwards [hUo.mem_nhds hxU] with y hy
        exact pd_comp u ψ y (hψd y hy) (hud y hy) j
      have e1 : partialDeriv i (fun y => partialDeriv j (fun w => u (ψ w)) y) x
          = partialDeriv i (fun y => ∑ d : Fin 3, partialDeriv d u (ψ y) *
              partialDeriv j (fun v => ψ v d) y) x :=
        congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hev.fderiv_eq
      rw [e1, pd_sum _ _ _ (fun d => dmul _ _ _ (hPψd d) (hJd d j)), ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro d _
      rw [pd_mul _ _ _ _ (hPψd d) (hJd d j),
        pd_comp (partialDeriv d u) ψ x (hψd x hxU) (hPd d) i]
    have h8 := lap_contraction_algebra
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => ψ w a) x) (G (ψ x)) (Gt x)
      (fun k i j => christoffel Gt k i j x) (fun c a b => christoffel G c a b (ψ x))
      (fun c i j => partialDeriv i (partialDeriv j (fun v => ψ v c)) x)
      (fun d => partialDeriv d u (ψ x))
      (fun e d => partialDeriv e (fun y => partialDeriv d u y) (ψ x))
      hdetJ (fun i j => rfl) hT1
    unfold lapLocal
    simp only [h7a, h7b]
    exact h8
  
  have h2 : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) ∧
      ContDiffOn ℝ ∞ (fun w => chartAt E3 (Φ x) (Φ w))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) := by
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
    refine ⟨hΦ.continuousOn.isOpen_inter_preimage Φ.open_source
      (chartAt E3 (Φ x)).open_source, ?_⟩
    have hc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (Φ x))
        (chartAt E3 (Φ x)).source := contMDiffOn_chart
    have hcomp := hc.comp (hΦ.mono Set.inter_subset_left) (fun w hw => hw.2)
    exact contMDiffOn_iff_contDiffOn.mp hcomp
  have hxU : x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source := ⟨hx, mem_chart_source E3 (Φ x)⟩
  have hψd : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      DifferentiableAt ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z := fun z hz =>
    (h2.2.contDiffAt (h2.1.mem_nhds hz)).differentiableAt (by simp)
  have hM1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))).comp
          (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z) := by
    intro z hz
    have hev : (Φ : E3 → M) =ᶠ[𝓝 z]
        ((chartAt E3 (Φ x)).symm ∘ (fun w => chartAt E3 (Φ x) (Φ w))) := by
      filter_upwards [h2.1.mem_nhds hz] with w hw
      exact ((chartAt E3 (Φ x)).left_inv hw.2).symm
    rw [hev.mfderiv_eq, mfderiv_comp z
      (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 (Φ x))
        ((chartAt E3 (Φ x)).map_source hz.2)) (hψd z hz).mdifferentiableAt, mfderiv_eq_fderiv]
  have hM1' : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ u : E3,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))
          (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
    intro z hz u
    rw [hM1 z hz]
    rfl
  
  have s1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ i j : Fin 3,
      g.coeff Φ z i j = ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z *
          g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b *
            partialDeriv j (fun w => chartAt E3 (Φ x) (Φ w) b) z := by
    intro z hz i j
    have hq : (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) = Φ z :=
      (chartAt E3 (Φ x)).left_inv hz.2
    have hgq : g.g ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))) = g.g (Φ z) :=
      congrArg g.g hq
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) :=
      ⟨_, rfl⟩
    have hΦD : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
        D (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
      intro u
      rw [hM1' z hz u, hD]
      rfl
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b
        = g.g (Φ z) (D (e a)) (D (e b)) := by
      intro a b
      rw [← hgq, hD]
      rfl
    have hJ : ∀ k : Fin 3, fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k)
        = ∑ d : Fin 3, partialDeriv k (fun w => chartAt E3 (Φ x) (Φ w) d) z • e d := by
      intro k
      rw [hu (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k))]
      simp only [hcompo _ z (hψd z hz)]
    simp only [hcD]
    show g.g (Φ z) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e i))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e j)) = _
    rw [hΦD, hΦD, hJ i, hJ j]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    simp only [Fin.sum_univ_three]
    ring
  
  have s3 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z).det
        ≠ 0 := by
    intro z hz hdet
    obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ hz.1
    have hinj : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u = 0 → u = 0 := by
      intro u hu0
      rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hu0
      exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hu0
    have hw : fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (∑ i : Fin 3, v i • e i) = 0 := by
      ext a
      rw [map_sum]
      simp only [map_smul]
      have := congrFun hJv a
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        hcompo _ z (hψd z hz)] at this
      simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        WithLp.ofLp_zero, Pi.zero_apply]
      rw [← this]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
      apply hinj
      rw [hM1' z hz, hw]
      exact ContinuousLinearMap.map_zero _
    apply hv0
    funext a
    rw [← hcomp_e v a, h0]
    rfl
  
  have s4 : ∀ y ∈ (chartAt E3 (Φ x)).target,
      (g.coeff (chartAt E3 (Φ x)).symm y).det ≠ 0 := by
    intro y hy hdet
    obtain ⟨v, hv0, hGv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm y := ⟨_, rfl⟩
    have hid := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) (Φ x)).comp_symm_deriv hy
    have hinj : ∀ u : E3, D u = 0 → u = 0 := by
      intro u hu0
      have h1 := DFunLike.congr_fun hid u
      have h' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)) ((chartAt E3 (Φ x)).symm y) (D u)
          = u := by
        rw [hD]
        exact h1
      rw [hu0] at h'
      rw [← h']
      exact ContinuousLinearMap.map_zero _
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (Φ x)).symm y a b
        = g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) := by
      intro a b
      rw [hD]
      rfl
    have hw0 : (∑ i : Fin 3, v i • e i) ≠ 0 := by
      intro h
      apply hv0
      funext a
      rw [← hcomp_e v a, h]
      rfl
    have hpos := g.posDef ((chartAt E3 (Φ x)).symm y) (D (∑ i : Fin 3, v i • e i))
      (fun h => hw0 (hinj _ h))
    have hG : ∀ a, ∑ b : Fin 3, g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) * v b = 0 := by
      intro a
      have := congrFun hGv a
      simp only [Matrix.mulVec, dotProduct, Pi.zero_apply, hcD] at this
      exact this
    have hzero : g.g ((chartAt E3 (Φ x)).symm y) (D (∑ i : Fin 3, v i • e i))
        (D (∑ i : Fin 3, v i • e i)) = 0 := by
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul]
      calc _ = ∑ a : Fin 3, v a * ∑ b : Fin 3,
            g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) * v b := by
            simp only [Fin.sum_univ_three]; ring
        _ = 0 := by simp [hG]
    rw [hzero] at hpos
    exact lt_irrefl _ hpos
  
  have hUo : IsOpen (Φ.source ∩ Φ ⁻¹' ((chartAt E3 (Φ x)).source ∩ V)) :=
    Φ.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage Φ.open_source
      ((chartAt E3 (Φ x)).open_source.inter hV)
  have hxU' : x ∈ Φ.source ∩ Φ ⁻¹' ((chartAt E3 (Φ x)).source ∩ V) :=
    ⟨hx, mem_chart_source E3 (Φ x), hxV⟩
  have hUsub : Φ.source ∩ Φ ⁻¹' ((chartAt E3 (Φ x)).source ∩ V) ⊆
      Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source := fun z hz => ⟨hz.1, hz.2.1⟩
  have hWo : IsOpen ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' V) :=
    (chartAt E3 (Φ x)).isOpen_inter_preimage_symm hV
  have hmapsW : ∀ z ∈ Φ.source ∩ Φ ⁻¹' ((chartAt E3 (Φ x)).source ∩ V),
      chartAt E3 (Φ x) (Φ z) ∈ (chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' V := by
    intro z hz
    refine ⟨(chartAt E3 (Φ x)).map_source hz.2.1, ?_⟩
    show (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) ∈ V
    rw [(chartAt E3 (Φ x)).left_inv hz.2.1]
    exact hz.2.2
  have huW : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 (Φ x)).symm y))
      ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' V) := by
    have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 (Φ x)).symm)
        ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' V) :=
      hf.comp (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun y hy => hy.2)
    exact contMDiffOn_iff_contDiffOn.mp this
  have hkey := key (fun w => chartAt E3 (Φ x) (Φ w)) (g.coeff (chartAt E3 (Φ x)).symm)
    (fun y => f ((chartAt E3 (Φ x)).symm y))
    (Φ.source ∩ Φ ⁻¹' ((chartAt E3 (Φ x)).source ∩ V))
    ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' V)
    hUo hWo (h2.2.mono hUsub) hmapsW
    (fun a b => (g.smooth (Φ x) a b).mono Set.inter_subset_left)
    (fun y a b => g.symm _ _ _) huW hxU'
    (s4 _ ((chartAt E3 (Φ x)).map_source (mem_chart_source E3 (Φ x)))) (s3 x hxU)
  have heqG : g.coeff Φ =ᶠ[𝓝 x] (fun w => Matrix.of fun i j : Fin 3 => ∑ a : Fin 3, ∑ b : Fin 3,
      partialDeriv i (fun v => chartAt E3 (Φ x) (Φ v) a) w *
        g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)) a b *
          partialDeriv j (fun v => chartAt E3 (Φ x) (Φ v) b) w) := by
    filter_upwards [h2.1.mem_nhds hxU] with z hz
    ext i j
    exact s1 z hz i j
  have hequ : (f ∘ Φ) =ᶠ[𝓝 x]
      (fun w => f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)))) := by
    filter_upwards [h2.1.mem_nhds hxU] with z hz
    show f (Φ z) = f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)))
    rw [(chartAt E3 (Φ x)).left_inv hz.2]
  exact (lapLocal_congr _ _ _ _ x heqG hequ).trans hkey

theorem lapM_contMDiff [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) :
    ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => g.lapM u p) :=
by
  
  have hpdU : ∀ (T : Set E3), IsOpen T → ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f T → ∀ i,
      ContDiffOn ℝ ∞ (partialDeriv i f) T := by
    intro T hT f hf i
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) T := hf.fderiv_of_isOpen hT (by simp)
    exact h1.clm_apply contDiffOn_const
  
  have hdetS : ∀ (T : Set E3) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => A y i j) T) →
      ContDiffOn ℝ ∞ (fun y => (A y).det) T := by
    intro T A hA
    simp only [Matrix.det_fin_three]
    exact (((((((hA 0 0).mul (hA 1 1)).mul (hA 2 2)).sub (((hA 0 0).mul (hA 1 2)).mul (hA 2 1))).sub
      (((hA 0 1).mul (hA 1 0)).mul (hA 2 2))).add (((hA 0 1).mul (hA 1 2)).mul (hA 2 0))).add
      (((hA 0 2).mul (hA 1 0)).mul (hA 2 1))).sub (((hA 0 2).mul (hA 1 1)).mul (hA 2 0))
  
  have hinvS : ∀ (T : Set E3) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => A y i j) T) → (∀ y ∈ T, (A y).det ≠ 0) →
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (A y)⁻¹ i j) T := by
    intro T A hA hdet i j
    have hadj : ContDiffOn ℝ ∞ (fun y => (A y).adjugate i j) T := by
      simp only [Matrix.adjugate_apply]
      apply hdetS T (fun y => (A y).updateRow j (Pi.single i 1))
      intro a b
      simp only [Matrix.updateRow_apply]
      by_cases h : a = j
      · simp only [h, if_true]
        exact contDiffOn_const
      · simp only [h, if_false]
        exact hA a b
    have heq : (fun y => (A y)⁻¹ i j) = fun y => ((A y).det)⁻¹ * (A y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [heq]
    exact ((hdetS T A hA).inv hdet).mul hadj
  
  have hlapS : ∀ (T : Set E3), IsOpen T → ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T) →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) T) →
      ContDiffOn ℝ ∞ f T → ContDiffOn ℝ ∞ (lapLocal G f) T := by
    intro T hT G f hG hGinv hf
    have hchr : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (fun y => christoffel G k i j y) T := by
      intro k i j
      unfold christoffel
      exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hGinv k l).mul
        (((hpdU T hT _ (hG j l) i).add (hpdU T hT _ (hG i l) j)).sub (hpdU T hT _ (hG i j) l)))
    have hf1 : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun z => partialDeriv j f z) T :=
      fun j => hpdU T hT f hf j
    have hf2 : ∀ i j : Fin 3,
        ContDiffOn ℝ ∞ (fun y => partialDeriv i (fun z => partialDeriv j f z) y) T :=
      fun i j => hpdU T hT _ (hf1 j) i
    show ContDiffOn ℝ ∞ (fun y => lapLocal G f y) T
    unfold lapLocal
    exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hGinv i j).mul
      ((hf2 i j).sub (ContDiffOn.sum fun k _ => (hchr k i j).mul (hf1 k)))
  
  apply contMDiff_of_locally_contMDiffOn
  intro x₀
  refine ⟨(chartAt E3 x₀).source, (chartAt E3 x₀).open_source, mem_chart_source E3 x₀, ?_⟩
  have hT : IsOpen (chartAt E3 x₀).target := (chartAt E3 x₀).open_target
  have hG₀ : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun y => g.coeff (chartAt E3 x₀).symm y i j) (chartAt E3 x₀).target :=
    fun i j => g.smooth x₀ i j
  have hdet : ∀ y ∈ (chartAt E3 x₀).target, (g.coeff (chartAt E3 x₀).symm y).det ≠ 0 :=
    fun y hy => (coeff_chart_symm_posDef g x₀ y hy).det_pos.ne'
  have hGinv := hinvS _ _ hG₀ hdet
  have hf₀ : ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 x₀).symm y)) (chartAt E3 x₀).target :=
    contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hF := hlapS _ hT _ _ hG₀ hGinv hf₀
  have hcomp : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (lapLocal (g.coeff (chartAt E3 x₀).symm) (fun y => u ((chartAt E3 x₀).symm y)) ∘
        chartAt E3 x₀) (chartAt E3 x₀).source :=
    hF.contMDiffOn.comp contMDiffOn_chart (fun p hp => (chartAt E3 x₀).map_source hp)
  let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    ⟨(chartAt E3 x₀).toPartialEquiv.symm, (chartAt E3 x₀).open_target,
      (chartAt E3 x₀).open_source, contMDiffOn_chart_symm, contMDiffOn_chart⟩
  refine hcomp.congr (fun p hp => ?_)
  have hy : chartAt E3 x₀ p ∈ Φ.source := (chartAt E3 x₀).map_source hp
  have h1 := lapLocal_chart_invariant g Φ u Set.univ isOpen_univ hu.contMDiffOn
    (chartAt E3 x₀ p) hy trivial
  have h2 : Φ (chartAt E3 x₀ p) = p := (chartAt E3 x₀).left_inv hp
  rw [h2] at h1
  exact h1.symm

theorem lapM_gradInner_linear_local [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u v w : M → ℝ) (p : M) :
    ((ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) → (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v) → ∀ a b : ℝ,
      g.lapM (fun q => a * u q + b * v q) p = a * g.lapM u p + b * g.lapM v p ∧
      g.gradInner (fun q => a * u q + b * v q) w p = a * g.gradInner u w p + b * g.gradInner v w p) ∧
    (∀ U : Set M, IsOpen U → p ∈ U → (∀ q ∈ U, u q = v q) →
      g.lapM u p = g.lapM v p ∧ g.gradInner u w p = g.gradInner v w p) :=
by
  classical
  
  have P0 : ∀ (g₁ g₂ : E3 → ℝ) (z : E3) (a b : ℝ), DifferentiableAt ℝ g₁ z →
      DifferentiableAt ℝ g₂ z → ∀ k : Fin 3,
      partialDeriv k (fun x => a * g₁ x + b * g₂ x) z =
        a * partialDeriv k g₁ z + b * partialDeriv k g₂ z := by
    intro g₁ g₂ z a b h₁ h₂ k
    have h : fderiv ℝ (fun x => a * g₁ x + b * g₂ x) z = a • fderiv ℝ g₁ z + b • fderiv ℝ g₂ z :=
      ((h₁.hasFDerivAt.const_mul a).add (h₂.hasFDerivAt.const_mul b)).fderiv
    unfold partialDeriv
    rw [h]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have Loc : ∀ (f₁ f₂ : E3 → ℝ) (y : E3), f₁ =ᶠ[𝓝 y] f₂ →
      (∀ k : Fin 3, partialDeriv k f₁ y = partialDeriv k f₂ y) ∧
      (∀ i j : Fin 3, partialDeriv i (partialDeriv j f₁) y = partialDeriv i (partialDeriv j f₂) y) := by
    intro f₁ f₂ y hfe
    refine ⟨fun j => ?_, fun i j => ?_⟩
    · show fderiv ℝ f₁ y (e j) = fderiv ℝ f₂ y (e j)
      rw [hfe.fderiv_eq]
    · have hev : partialDeriv j f₁ =ᶠ[𝓝 y] partialDeriv j f₂ := by
        filter_upwards [hfe.eventuallyEq_nhds] with z hz
        show fderiv ℝ f₁ z (e j) = fderiv ℝ f₂ z (e j)
        rw [hz.fderiv_eq]
      show fderiv ℝ (partialDeriv j f₁) y (e i) = fderiv ℝ (partialDeriv j f₂) y (e i)
      rw [hev.fderiv_eq]
  have hS : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hy₀S : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have hdiff : ∀ F : E3 → ℝ, ContDiffOn ℝ ∞ F (chartAt E3 p).target →
      ∀ z ∈ (chartAt E3 p).target, DifferentiableAt ℝ F z :=
    fun F hF z hz => (hF.differentiableOn (by simp)).differentiableAt (hS.mem_nhds hz)
  have hpd : ∀ F : E3 → ℝ, ContDiffOn ℝ ∞ F (chartAt E3 p).target → ∀ j : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv j F) (chartAt E3 p).target := by
    intro F hF j
    have hd := ((contDiffOn_infty_iff_fderiv_of_isOpen hS).mp hF).2
    show ContDiffOn ℝ ∞ (fun z => fderiv ℝ F z (e j)) (chartAt E3 p).target
    exact hd.clm_apply contDiffOn_const
  have hsm : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
    intro f hf
    have h1 := hf.comp_contMDiffOn (contMDiffOn_chart_symm (x := p))
    exact contMDiffOn_iff_contDiffOn.mp h1
  
  have Lin : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f₁ f₂ : E3 → ℝ),
      ContDiffOn ℝ ∞ f₁ (chartAt E3 p).target → ContDiffOn ℝ ∞ f₂ (chartAt E3 p).target →
      ∀ a b : ℝ,
      (∀ k : Fin 3, partialDeriv k (fun z => a * f₁ z + b * f₂ z) (chartAt E3 p p) =
        a * partialDeriv k f₁ (chartAt E3 p p) + b * partialDeriv k f₂ (chartAt E3 p p)) ∧
      lapLoc G (fun z => a * f₁ z + b * f₂ z) (chartAt E3 p p) =
        a * lapLoc G f₁ (chartAt E3 p p) + b * lapLoc G f₂ (chartAt E3 p p) := by
    intro G f₁ f₂ h₁ h₂ a b
    have hfirst : ∀ z ∈ (chartAt E3 p).target, ∀ k : Fin 3,
        partialDeriv k (fun x => a * f₁ x + b * f₂ x) z =
          a * partialDeriv k f₁ z + b * partialDeriv k f₂ z :=
      fun z hz k => P0 f₁ f₂ z a b (hdiff _ h₁ z hz) (hdiff _ h₂ z hz) k
    have hsecond : ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j (fun x => a * f₁ x + b * f₂ x)) (chartAt E3 p p) =
          a * partialDeriv i (partialDeriv j f₁) (chartAt E3 p p) +
            b * partialDeriv i (partialDeriv j f₂) (chartAt E3 p p) := by
      intro i j
      have hev : partialDeriv j (fun x => a * f₁ x + b * f₂ x) =ᶠ[𝓝 (chartAt E3 p p)]
          fun z => a * partialDeriv j f₁ z + b * partialDeriv j f₂ z := by
        filter_upwards [hS.mem_nhds hy₀S] with z hz
        exact hfirst z hz j
      have hre : partialDeriv i (partialDeriv j (fun x => a * f₁ x + b * f₂ x)) (chartAt E3 p p) =
          partialDeriv i (fun z => a * partialDeriv j f₁ z + b * partialDeriv j f₂ z)
            (chartAt E3 p p) := by
        show fderiv ℝ _ (chartAt E3 p p) (e i) = fderiv ℝ _ (chartAt E3 p p) (e i)
        rw [hev.fderiv_eq]
      rw [hre]
      exact P0 _ _ _ a b (hdiff _ (hpd _ h₁ j) _ hy₀S) (hdiff _ (hpd _ h₂ j) _ hy₀S) i
    have hfirst0 := hfirst _ hy₀S
    refine ⟨hfirst0, ?_⟩
    unfold lapLoc hessLoc
    simp only [hsecond, hfirst0]
    simp only [Fin.sum_univ_three]
    ring
  refine ⟨fun hu hv a b => ?_, fun U hU hp huv => ?_⟩
  · have h₁ := hsm u hu
    have h₂ := hsm v hv
    obtain ⟨hk, hl⟩ := Lin (g.coeff (chartAt E3 p).symm) _ _ h₁ h₂ a b
    constructor
    · exact hl
    · simp only [RiemannianMetric3.gradInner]
      simp only [hk, Fin.sum_univ_three]
      ring
  · have hφp : (chartAt E3 p).symm (chartAt E3 p p) = p :=
      (chartAt E3 p).left_inv (mem_chart_source E3 p)
    have hcont : ContinuousAt (chartAt E3 p).symm (chartAt E3 p p) :=
      (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
    have hUn : U ∈ 𝓝 ((chartAt E3 p).symm (chartAt E3 p p)) := by
      rw [hφp]; exact hU.mem_nhds hp
    have hev : (fun y => u ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        (fun y => v ((chartAt E3 p).symm y)) :=
      Filter.eventually_of_mem (hcont.preimage_mem_nhds hUn) (fun y hy => huv _ hy)
    obtain ⟨h1, h2⟩ := Loc _ _ _ hev
    constructor
    · simp only [RiemannianMetric3.lapM, lapLoc, hessLoc, h1, h2]
    · simp only [RiemannianMetric3.gradInner, h1]

theorem af_sigmaCompactSpace [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) : SigmaCompactSpace M :=
by
  classical
  have hA : ∀ n : ℕ, IsCompact {x : E3 | 2 ≤ ‖x‖ ∧ ‖x‖ ≤ (n : ℝ)} := by
    intro n
    have heq : {x : E3 | 2 ≤ ‖x‖ ∧ ‖x‖ ≤ (n : ℝ)} =
        Metric.closedBall (0 : E3) (n : ℝ) ∩ {x : E3 | 2 ≤ ‖x‖} := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Metric.mem_closedBall, dist_zero_right]
      tauto
    rw [heq]
    exact (isCompact_closedBall (0 : E3) (n : ℝ)).inter_right
      (isClosed_le continuous_const continuous_norm)
  have hImg : ∀ (k : Fin hAF.numEnds) (n : ℕ),
      IsCompact ((hAF.ends k).Φ '' {x : E3 | 2 ≤ ‖x‖ ∧ ‖x‖ ≤ (n : ℝ)}) := by
    intro k n
    have hΦc : ContinuousOn (hAF.ends k).Φ (hAF.ends k).Φ.source :=
      (hAF.ends k).Φ.contMDiffOn.continuousOn
    refine (hA n).image_of_continuousOn (hΦc.mono ?_)
    intro x hx
    obtain ⟨hx1, _⟩ := hx
    rw [(hAF.ends k).source_eq]
    show (1 : ℝ) < ‖x‖
    linarith
  let F : Option (Fin hAF.numEnds × ℕ) → Set M := fun o =>
    match o with
    | none => (⋃ k, (hAF.ends k).Φ '' {x : E3 | 2 < ‖x‖})ᶜ
    | some kn => (hAF.ends kn.1).Φ '' {x : E3 | 2 ≤ ‖x‖ ∧ ‖x‖ ≤ (kn.2 : ℝ)}
  refine SigmaCompactSpace.of_countable (Set.range F) (Set.countable_range F) ?_ ?_
  · rintro s ⟨o, rfl⟩
    cases o with
    | none => exact hAF.isCompact_core
    | some kn => exact hImg kn.1 kn.2
  · apply Set.eq_univ_of_forall
    intro p
    rw [Set.mem_sUnion]
    by_cases hp : p ∈ (⋃ k, (hAF.ends k).Φ '' {x : E3 | 2 < ‖x‖})ᶜ
    · exact ⟨F none, ⟨none, rfl⟩, hp⟩
    · rw [Set.mem_compl_iff, not_not, Set.mem_iUnion] at hp
      obtain ⟨k, x, hx, hxp⟩ := hp
      have hx' : 2 < ‖x‖ := hx
      obtain ⟨n, hn⟩ := exists_nat_ge ‖x‖
      exact ⟨F (some (k, n)), ⟨some (k, n), rfl⟩, ⟨x, ⟨le_of_lt hx', hn⟩, hxp⟩⟩

theorem gradInner_pdiffeo_formula [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (u w : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w)
    (x : E3) (hx : x ∈ κ.source) :
    g.gradInner u w (κ x) = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff κ x)⁻¹ i j * partialDeriv i (fun z => u (κ z)) x *
        partialDeriv j (fun z => w (κ z)) x :=
by
  
  have hbasis : ∀ v : E3, v = ∑ d : Fin 3, v d • e d := by
    intro v
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v]
    simp [EuclideanSpace.basisFun_apply]
  have hcomp_e : ∀ v : Fin 3 → ℝ, ∀ a : Fin 3, (∑ i : Fin 3, v i • e i) a = v a := by
    intro v a
    simp [Pi.single_apply]
  have hcompo : ∀ (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z → ∀ l d : Fin 3,
      partialDeriv l (fun v => ψ v d) z = (fderiv ℝ ψ z (e l)) d := by
    intro ψ z hψ l d
    have hfun : (fun v => ψ v d) = (EuclideanSpace.proj d : E3 →L[ℝ] ℝ) ∘ ψ := by
      funext v; simp
    rw [partialDeriv, hfun, fderiv_comp z (EuclideanSpace.proj d).differentiableAt hψ,
      ContinuousLinearMap.fderiv]
    simp
  have pd_comp : ∀ (F : E3 → ℝ) (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z →
      DifferentiableAt ℝ F (ψ z) → ∀ l : Fin 3,
      partialDeriv l (fun w' => F (ψ w')) z
        = ∑ d : Fin 3, partialDeriv d F (ψ z) * partialDeriv l (fun v => ψ v d) z := by
    intro F ψ z hψ hF l
    have h1 : partialDeriv l (fun w' => F (ψ w')) z = fderiv ℝ F (ψ z) (fderiv ℝ ψ z (e l)) := by
      show fderiv ℝ (F ∘ ψ) z (e l) = _
      rw [fderiv_comp z hF hψ]
      rfl
    rw [h1, hbasis (fderiv ℝ ψ z (e l)), map_sum]
    simp only [map_smul, smul_eq_mul, hcompo ψ z hψ]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  
  have grad_alg : ∀ (A Gm Gt : Matrix (Fin 3) (Fin 3) ℝ) (P Pt Q Qt : Fin 3 → ℝ), A.det ≠ 0 →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * Gm a b * A b j) →
      (∀ i, Pt i = ∑ a : Fin 3, P a * A a i) →
      (∀ i, Qt i = ∑ a : Fin 3, Q a * A a i) →
      ∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j * Pt i * Qt j =
          ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * P i * Q j := by
    intro A Gm Gt P Pt Q Qt hA hGt hPt hQt
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGt' : Gt = Matrix.transpose A * Gm * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGtinv : Gt⁻¹ = A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hM : A * Gt⁻¹ * Matrix.transpose A = Gm⁻¹ := by
      rw [hGtinv]
      calc A * (A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹) * Matrix.transpose A
          = (A * A⁻¹) * Gm⁻¹ * (Matrix.transpose A⁻¹ * Matrix.transpose A) := by
            simp only [Matrix.mul_assoc]
        _ = Gm⁻¹ := by
            rw [hAB, ← Matrix.transpose_mul, hAB, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hM' : ∀ a b, ∑ i : Fin 3, ∑ j : Fin 3, A a i * Gt⁻¹ i j * A b j = Gm⁻¹ a b := by
      intro a b
      rw [← hM]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    simp only [hPt, hQt, ← hM']
    simp only [Fin.sum_univ_three]
    ring
  
  have h2 : IsOpen (κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source) ∧
      ContDiffOn ℝ ∞ (fun w' => chartAt E3 (κ x) (κ w'))
        (κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source) := by
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ κ κ.source := κ.contMDiffOn_toFun
    refine ⟨hΦ.continuousOn.isOpen_inter_preimage κ.open_source
      (chartAt E3 (κ x)).open_source, ?_⟩
    have hc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (κ x))
        (chartAt E3 (κ x)).source := contMDiffOn_chart
    have hcomp := hc.comp (hΦ.mono Set.inter_subset_left) (fun w' hw' => hw'.2)
    exact contMDiffOn_iff_contDiffOn.mp hcomp
  have hxU : x ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source := ⟨hx, mem_chart_source E3 (κ x)⟩
  have hψd : ∀ z ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source,
      DifferentiableAt ℝ (fun w' => chartAt E3 (κ x) (κ w')) z := fun z hz =>
    (h2.2.contDiffAt (h2.1.mem_nhds hz)).differentiableAt (by simp)
  have hM1 : ∀ z ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z))).comp
          (fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z) := by
    intro z hz
    have hev : (κ : E3 → M) =ᶠ[𝓝 z]
        ((chartAt E3 (κ x)).symm ∘ (fun w' => chartAt E3 (κ x) (κ w'))) := by
      filter_upwards [h2.1.mem_nhds hz] with w' hw'
      exact ((chartAt E3 (κ x)).left_inv hw'.2).symm
    rw [hev.mfderiv_eq, mfderiv_comp z
      (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 (κ x))
        ((chartAt E3 (κ x)).map_source hz.2)) (hψd z hz).mdifferentiableAt, mfderiv_eq_fderiv]
  have hM1' : ∀ z ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source, ∀ v : E3,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z v =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z))
          (fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z v) := by
    intro z hz v
    rw [hM1 z hz]
    rfl
  
  have s1 : ∀ z ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source, ∀ i j : Fin 3,
      g.coeff κ z i j = ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv i (fun w' => chartAt E3 (κ x) (κ w') a) z *
          g.coeff (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z)) a b *
            partialDeriv j (fun w' => chartAt E3 (κ x) (κ w') b) z := by
    intro z hz i j
    have hq : (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z)) = κ z :=
      (chartAt E3 (κ x)).left_inv hz.2
    have hgq : g.g ((chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z))) = g.g (κ z) :=
      congrArg g.g hq
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z)) :=
      ⟨_, rfl⟩
    have hΦD : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z v =
        D (fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z v) := by
      intro v
      rw [hM1' z hz v, hD]
      rfl
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z)) a b
        = g.g (κ z) (D (e a)) (D (e b)) := by
      intro a b
      rw [← hgq, hD]
      rfl
    have hJ : ∀ k : Fin 3, fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z (e k)
        = ∑ d : Fin 3, partialDeriv k (fun w' => chartAt E3 (κ x) (κ w') d) z • e d := by
      intro k
      rw [hbasis (fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z (e k))]
      simp only [hcompo _ z (hψd z hz)]
    simp only [hcD]
    show g.g (κ z) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z (e i))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z (e j)) = _
    rw [hΦD, hΦD, hJ i, hJ j]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    simp only [Fin.sum_univ_three]
    ring
  
  have s3 : ∀ z ∈ κ.source ∩ κ ⁻¹' (chartAt E3 (κ x)).source,
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w' => chartAt E3 (κ x) (κ w') a) z).det
        ≠ 0 := by
    intro z hz hdet
    obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ κ hz.1
    have hinj : ∀ y : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ z y = 0 → y = 0 := by
      intro y hy0
      rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hy0
      exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hy0
    have hw0 : fderiv ℝ (fun w' => chartAt E3 (κ x) (κ w')) z (∑ i : Fin 3, v i • e i) = 0 := by
      ext a
      rw [map_sum]
      simp only [map_smul]
      have := congrFun hJv a
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        hcompo _ z (hψd z hz)] at this
      simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        WithLp.ofLp_zero, Pi.zero_apply]
      rw [← this]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
      apply hinj
      rw [hM1' z hz, hw0]
      exact ContinuousLinearMap.map_zero _
    apply hv0
    funext a
    rw [← hcomp_e v a, h0]
    rfl
  
  have hmapsW : chartAt E3 (κ x) (κ x) ∈ (chartAt E3 (κ x)).target :=
    (chartAt E3 (κ x)).map_source hxU.2
  have chain : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → ∀ i : Fin 3,
      partialDeriv i (fun z => f (κ z)) x = ∑ a : Fin 3,
        partialDeriv a (fun y => f ((chartAt E3 (κ x)).symm y)) (chartAt E3 (κ x) (κ x)) *
          (Matrix.of fun a i : Fin 3 =>
            partialDeriv i (fun w' => chartAt E3 (κ x) (κ w') a) x) a i := by
    intro f hf i
    have huW : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 (κ x)).symm y))
        (chartAt E3 (κ x)).target := by
      have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 (κ x)).symm)
          (chartAt E3 (κ x)).target :=
        hf.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp this
    have hud : DifferentiableAt ℝ (fun y => f ((chartAt E3 (κ x)).symm y))
        (chartAt E3 (κ x) (κ x)) :=
      (huW.contDiffAt ((chartAt E3 (κ x)).open_target.mem_nhds hmapsW)).differentiableAt
        (by simp)
    have hequ : (fun z => f (κ z)) =ᶠ[𝓝 x]
        (fun w' => f ((chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ w')))) := by
      filter_upwards [h2.1.mem_nhds hxU] with z hz2
      show f (κ z) = f ((chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ z)))
      rw [(chartAt E3 (κ x)).left_inv hz2.2]
    have e1 : partialDeriv i (fun z => f (κ z)) x = partialDeriv i
        (fun w' => f ((chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ w')))) x := by
      show fderiv ℝ (fun z => f (κ z)) x (e i) = fderiv ℝ _ x (e i)
      rw [hequ.fderiv_eq]
    rw [e1, pd_comp (fun y => f ((chartAt E3 (κ x)).symm y)) (fun w' => chartAt E3 (κ x) (κ w'))
      x (hψd x hxU) hud i]
    rfl
  have hL : g.gradInner u w (κ x) = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ x)))⁻¹ i j *
        partialDeriv i (fun y => u ((chartAt E3 (κ x)).symm y)) (chartAt E3 (κ x) (κ x)) *
        partialDeriv j (fun y => w ((chartAt E3 (κ x)).symm y)) (chartAt E3 (κ x) (κ x)) := rfl
  rw [hL]
  exact (grad_alg (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w' => chartAt E3 (κ x) (κ w') a) x)
    (g.coeff (chartAt E3 (κ x)).symm (chartAt E3 (κ x) (κ x))) (g.coeff κ x)
    (fun a => partialDeriv a (fun y => u ((chartAt E3 (κ x)).symm y)) (chartAt E3 (κ x) (κ x)))
    (fun i => partialDeriv i (fun z => u (κ z)) x)
    (fun a => partialDeriv a (fun y => w ((chartAt E3 (κ x)).symm y)) (chartAt E3 (κ x) (κ x)))
    (fun i => partialDeriv i (fun z => w (κ z)) x)
    (s3 x hxU) (fun i j => s1 x hxU i j) (chain u hu) (chain w hw)).symm

theorem boundary_flat_chart [IsManifold 𝓘(ℝ, E3) ∞ M] (β : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (p : M) (hp : β p = 0)
    (hreg : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0) :
    ∃ (Ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (r : ℝ), 0 < r ∧
      Ψ.source = Metric.ball (0 : E3) r ∧ Ψ 0 = p ∧
      ∀ z ∈ Metric.ball (0 : E3) r, β (Ψ z) = z 0 :=
by
  classical
  
  have s1 : ∀ L : E3 →L[ℝ] ℝ, L ≠ 0 → ∃ T : E3 ≃L[ℝ] E3, ∀ h : E3, (T h) 0 = L h := by
    intro L hL
    have hdecomp : ∀ h : E3, h = h 0 • e 0 + h 1 • e 1 + h 2 • e 2 := by
      intro h; ext j; fin_cases j <;> simp [EuclideanSpace.single_apply]
    have hLh : ∀ h : E3, L h = h 0 * L (e 0) + h 1 * L (e 1) + h 2 * L (e 2) := by
      intro h
      conv_lhs => rw [hdecomp h]
      simp only [map_add, map_smul, smul_eq_mul]
    have hex : ∃ i : Fin 3, L (e i) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hL
      refine ContinuousLinearMap.ext (fun h => ?_)
      rw [hLh h, hcon 0, hcon 1, hcon 2]
      simp
    obtain ⟨i, hi⟩ := hex
    let P0 : E3 →L[ℝ] ℝ := EuclideanSpace.proj (0 : Fin 3)
    let Pi : E3 →L[ℝ] ℝ := EuclideanSpace.proj i
    let S : E3 →L[ℝ] E3 := ContinuousLinearMap.id ℝ E3
      + (L - P0).smulRight (e 0)
      + (P0 - Pi).smulRight (e i)
    have hS : ∀ h : E3, ∀ j : Fin 3,
        (S h) j = h j + (L h - h 0) * (e 0) j + (h 0 - h i) * (e i) j := by
      intro h j
      simp [S, P0, Pi]
    have hinj : Function.Injective S := by
      rw [injective_iff_map_eq_zero]
      intro h hh
      have hc : ∀ j : Fin 3, h j + (L h - h 0) * (e 0) j + (h 0 - h i) * (e i) j = 0 := by
        intro j
        rw [← hS h j, hh]
        rfl
      have c0 := hc 0
      have c1 := hc 1
      have c2 := hc 2
      have hLh' := hLh h
      have hz : h 0 = 0 ∧ h 1 = 0 ∧ h 2 = 0 := by
        rcases (show i = 0 ∨ i = 1 ∨ i = 2 by fin_cases i <;> simp) with rfl | rfl | rfl <;>
          simp [e, EuclideanSpace.single_apply] at c0 c1 c2
        · have e1 : h 1 = 0 := by linarith
          have e2 : h 2 = 0 := by linarith
          have hm : h 0 * L (e 0) = 0 := by rw [e1, e2] at hLh'; linarith
          exact ⟨(mul_eq_zero.mp hm).resolve_right hi, e1, e2⟩
        · have e0 : h 0 = 0 := by linarith
          have e2 : h 2 = 0 := by linarith
          have hm : h 1 * L (e 1) = 0 := by rw [e0, e2] at hLh'; linarith
          exact ⟨e0, (mul_eq_zero.mp hm).resolve_right hi, e2⟩
        · have e0 : h 0 = 0 := by linarith
          have e1 : h 1 = 0 := by linarith
          have hm : h 2 * L (e 2) = 0 := by rw [e0, e1] at hLh'; linarith
          exact ⟨e0, e1, (mul_eq_zero.mp hm).resolve_right hi⟩
      rw [hdecomp h, hz.1, hz.2.1, hz.2.2]
      simp
    let T : E3 ≃L[ℝ] E3 :=
      (LinearEquiv.ofInjectiveEndo (S : E3 →ₗ[ℝ] E3) hinj).toContinuousLinearEquiv
    refine ⟨T, fun h => ?_⟩
    have hTS : T h = S h := by
      simp only [T, LinearEquiv.coe_toContinuousLinearEquiv', LinearEquiv.coe_ofInjectiveEndo]
      rfl
    rw [hTS, hS]
    fin_cases i <;> simp [EuclideanSpace.single_apply]
  
  have hV : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hx₀ : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have hleft : (chartAt E3 p).symm (chartAt E3 p p) = p :=
    (chartAt E3 p).left_inv (mem_chart_source E3 p)
  have hf : ContDiffOn ℝ ∞ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hβ.comp_contMDiffOn contMDiffOn_chart_symm)
  have hf0 : β ((chartAt E3 p).symm (chartAt E3 p p)) = 0 := by rw [hleft]; exact hp
  
  have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p := hβ.mdifferentiableAt (by simp)
  have h5 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p =
      fderiv ℝ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
    rw [hmd.mfderiv]
    simp [writtenInExtChartAt, extChartAt_model_space_eq_id, Function.comp_def]
  have hL : fderiv ℝ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0 := by
    rw [← h5]; exact hreg
  obtain ⟨T, hT⟩ := s1 _ hL
  
  set f : E3 → ℝ := fun y => β ((chartAt E3 p).symm y) with hfdef
  set x₀ : E3 := chartAt E3 p p with hx₀def
  set L : E3 →L[ℝ] ℝ := fderiv ℝ f x₀ with hLdef
  let H : E3 → E3 := fun x => T (x - x₀) + (f x - L (x - x₀)) • e 0
  have hH : ContDiffOn ℝ ∞ H (chartAt E3 p).target := by
    have h1 : ContDiff ℝ ∞ (fun x : E3 => T (x - x₀)) :=
      (T : E3 →L[ℝ] E3).contDiff.comp (contDiff_id.sub contDiff_const)
    have h2 : ContDiff ℝ ∞ (fun x : E3 => L (x - x₀)) :=
      L.contDiff.comp (contDiff_id.sub contDiff_const)
    exact h1.contDiffOn.add ((hf.sub h2.contDiffOn).smul contDiffOn_const)
  have hH1 : ∀ x : E3, (H x) 0 = f x := by
    intro x
    simp [H, hT, EuclideanSpace.single_apply]
  have hH0 : H x₀ = 0 := by
    simp [H, hf0, f, x₀, hp]
  have hfd : HasFDerivAt f L x₀ :=
    ((hf.contDiffAt (hV.mem_nhds hx₀)).differentiableAt (by simp)).hasFDerivAt
  have hTd : HasFDerivAt H (T : E3 →L[ℝ] E3) x₀ := by
    have hA : HasFDerivAt (fun x : E3 => T (x - x₀)) (T : E3 →L[ℝ] E3) x₀ :=
      ((T : E3 →L[ℝ] E3).hasFDerivAt.comp x₀ ((hasFDerivAt_id x₀).sub_const x₀)).congr_fderiv
        (by ext1 v; simp)
    have hB : HasFDerivAt (fun x : E3 => L (x - x₀)) L x₀ :=
      (L.hasFDerivAt.comp x₀ ((hasFDerivAt_id x₀).sub_const x₀)).congr_fderiv
        (by ext1 v; simp)
    have hC := (hA.add ((hfd.sub hB).smul_const (e 0)))
    refine hC.congr_fderiv ?_
    rw [sub_self]
    ext1 v
    simp
  
  have hHx₀ : ContDiffAt ℝ ∞ H x₀ := hH.contDiffAt (hV.mem_nhds hx₀)
  let Θ₀ := ContDiffAt.toOpenPartialHomeomorph H hHx₀ hTd (by simp)
  have hΘ₀coe : (Θ₀ : E3 → E3) = H := ContDiffAt.toOpenPartialHomeomorph_coe hHx₀ hTd _
  have hx₀Θ₀ : x₀ ∈ Θ₀.source := ContDiffAt.mem_toOpenPartialHomeomorph_source hHx₀ hTd _
  let U : Set E3 := (chartAt E3 p).target ∩
    (fderiv ℝ H) ⁻¹' {A : E3 →L[ℝ] E3 | Function.Injective A}
  have hU : IsOpen U :=
    (hH.continuousOn_fderiv_of_isOpen hV (by simp)).isOpen_inter_preimage hV
      ContinuousLinearMap.isOpen_injective
  have hx₀U : x₀ ∈ U := by
    refine ⟨hx₀, ?_⟩
    show Function.Injective (fderiv ℝ H x₀)
    rw [hTd.fderiv]
    exact T.injective
  let Θ := Θ₀.restrOpen U hU
  have hΘsrc : Θ.source = Θ₀.source ∩ U := Θ₀.restrOpen_source U hU
  have hΘcoe : ∀ x, Θ x = H x := by
    intro x
    rw [← hΘ₀coe]
    rfl
  have hΘeqH : (Θ : E3 → E3) = H := funext hΘcoe
  have hx₀Θ : x₀ ∈ Θ.source := by rw [hΘsrc]; exact ⟨hx₀Θ₀, hx₀U⟩
  have hΘV : Θ.source ⊆ (chartAt E3 p).target := by
    intro x hx
    rw [hΘsrc] at hx
    exact hx.2.1
  have hΘ : ContDiffOn ℝ ∞ Θ Θ.source := (hH.mono hΘV).congr (fun x _ => hΘcoe x)
  have hΘs : ContDiffOn ℝ ∞ Θ.symm Θ.target := by
    intro a ha
    have hy : Θ.symm a ∈ Θ.source := Θ.map_target ha
    rw [hΘsrc] at hy
    have hyV : Θ.symm a ∈ (chartAt E3 p).target := hy.2.1
    have hinj : Function.Injective (fderiv ℝ H (Θ.symm a)) := hy.2.2
    have hHy : ContDiffAt ℝ ∞ H (Θ.symm a) := hH.contDiffAt (hV.mem_nhds hyV)
    let D : E3 ≃L[ℝ] E3 :=
      (LinearEquiv.ofInjectiveEndo (fderiv ℝ H (Θ.symm a) : E3 →ₗ[ℝ] E3) hinj).toContinuousLinearEquiv
    have hD : (D : E3 →L[ℝ] E3) = fderiv ℝ H (Θ.symm a) := by
      ext1 v
      simp only [D, ContinuousLinearEquiv.coe_coe, LinearEquiv.coe_toContinuousLinearEquiv',
        LinearEquiv.coe_ofInjectiveEndo]
      rfl
    have hder : HasFDerivAt (Θ : E3 → E3) (D : E3 →L[ℝ] E3) (Θ.symm a) := by
      rw [hD, hΘeqH]
      exact (hHy.differentiableAt (by simp)).hasFDerivAt
    have hC : ContDiffAt ℝ ∞ (Θ : E3 → E3) (Θ.symm a) := by
      rw [hΘeqH]; exact hHy
    exact (Θ.contDiffAt_symm ha hder hC).contDiffWithinAt
  
  have hΘx₀ : Θ x₀ = 0 := by rw [hΘcoe]; exact hH0
  have h0t : (0 : E3) ∈ Θ.target := by rw [← hΘx₀]; exact Θ.map_source hx₀Θ
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp Θ.open_target 0 h0t
  
  let e' : OpenPartialHomeomorph E3 M :=
    (Θ.symm.trans (chartAt E3 p).symm).restrOpen (Metric.ball 0 r) Metric.isOpen_ball
  have hmaps : ∀ z ∈ Metric.ball (0 : E3) r, Θ.symm z ∈ (chartAt E3 p).target :=
    fun z hz => hΘV (Θ.map_target (hball hz))
  have he'src : e'.source = Metric.ball 0 r := by
    rw [OpenPartialHomeomorph.restrOpen_source, OpenPartialHomeomorph.trans_source]
    ext z
    constructor
    · intro hz; exact hz.2
    · intro hz
      refine ⟨⟨?_, ?_⟩, hz⟩
      · exact hball hz
      · exact hmaps z hz
  have htgt : ∀ y ∈ e'.target, y ∈ (chartAt E3 p).source ∧ chartAt E3 p y ∈ Θ.source := by
    intro y hy
    have hy' : y ∈ (Θ.symm.trans (chartAt E3 p).symm).target ∩
        (Θ.symm.trans (chartAt E3 p).symm).symm ⁻¹' Metric.ball 0 r := hy
    have hy1 := hy'.1
    simp only [OpenPartialHomeomorph.trans_target, OpenPartialHomeomorph.symm_target,
      OpenPartialHomeomorph.symm_symm] at hy1
    exact hy1
  have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun z => (chartAt E3 p).symm (Θ.symm z))
      (Metric.ball 0 r) :=
    contMDiffOn_chart_symm.comp ((contMDiffOn_iff_contDiffOn.mpr hΘs).mono hball)
      (by intro z hz; exact hmaps z hz)
  have h2 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => Θ (chartAt E3 p y)) e'.target :=
    (contMDiffOn_iff_contDiffOn.mpr hΘ).comp
      (contMDiffOn_chart.mono (fun y hy => (htgt y hy).1))
      (by intro y hy; exact (htgt y hy).2)
  have h1' : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (e'.toPartialEquiv : E3 → M)
      e'.toPartialEquiv.source := by
    have hs : e'.toPartialEquiv.source = Metric.ball 0 r := he'src
    rw [hs]
    exact h1
  have h2' : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ e'.toPartialEquiv.invFun
      e'.toPartialEquiv.target := h2
  let Ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    ⟨e'.toPartialEquiv, e'.open_source, e'.open_target, h1', h2'⟩
  have hΘs0 : Θ.symm 0 = x₀ := by rw [← hΘx₀]; exact Θ.left_inv hx₀Θ
  refine ⟨Ψ, r, hr, he'src, ?_, ?_⟩
  · show (chartAt E3 p).symm (Θ.symm 0) = p
    rw [hΘs0]
    exact hleft
  · intro z hz
    show β ((chartAt E3 p).symm (Θ.symm z)) = z 0
    have h3 : (H (Θ.symm z)) 0 = f (Θ.symm z) := hH1 _
    rw [← hΘcoe, Θ.right_inv (hball hz)] at h3
    rw [h3]

theorem nds_component_topology [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re) (ρ : ℝ) (hρ : Re + 1 < ρ) :
    IsCompact (connectedComponentIn ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖})
      ((hAF.ends k).Φ (ρ • e 0))) ∧
    IsCompact (({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) \
      connectedComponentIn ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖})
        ((hAF.ends k).Φ (ρ • e 0))) ∧
    (∀ y : E3, ‖y‖ = ρ → (hAF.ends k).Φ y ∈ connectedComponentIn
      ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) ((hAF.ends k).Φ (ρ • e 0))) ∧
    (∀ p : M, 0 ≤ β p → p ∉ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖} →
      p ∉ connectedComponentIn ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖})
        ((hAF.ends k).Φ (ρ • e 0)) → p ∉ (hAF.ends k).Φ '' {y : E3 | Re < ‖y‖}) :=
by
  classical
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hRe2 : (2 : ℝ) ≤ Re := hβ.2.2.1
  have hβpos : ∀ y : E3, Re < ‖y‖ → 0 < β ((hAF.ends k).Φ y) := hβ.2.2.2.1
  have hKE : IsCompact ({p : M | 0 ≤ β p} \ (hAF.ends k).Φ '' {y : E3 | Re < ‖y‖}) :=
    hβ.2.2.2.2
  have hβc : Continuous β := hβ.1.continuous
  have hΦc : ContinuousOn (hAF.ends k).Φ (hAF.ends k).Φ.source :=
    (hAF.ends k).Φ.contMDiffOn.continuousOn
  obtain ⟨ρc, -, hcl⟩ := endChart_far_isClosed g hAF k
  set Φ := (hAF.ends k).Φ with hΦdef
  
  have hopen : ∀ t : ℝ, 1 ≤ t → IsOpen (Φ '' {y : E3 | t < ‖y‖}) := by
    intro t ht
    have heq : Φ '' {y : E3 | t < ‖y‖} = Φ.target ∩ Φ.symm ⁻¹' {y : E3 | t < ‖y‖} := by
      ext p
      constructor
      · intro hp
        obtain ⟨y, hy, hyp⟩ := hp
        have hy' : t < ‖y‖ := hy
        have hys : y ∈ Φ.source := by
          rw [hsrc]
          show (1 : ℝ) < ‖y‖
          linarith
        rw [← hyp]
        refine ⟨Φ.toPartialEquiv.map_source hys, ?_⟩
        show t < ‖Φ.symm (Φ y)‖
        have hl : Φ.symm (Φ y) = y := Φ.toPartialEquiv.left_inv hys
        rw [hl]
        exact hy'
      · intro hp
        obtain ⟨hpt, hp'⟩ := hp
        exact ⟨Φ.symm p, hp', Φ.toPartialEquiv.right_inv hpt⟩
    rw [heq]
    exact Φ.symm.contMDiffOn.continuousOn.isOpen_inter_preimage
      Φ.open_target (isOpen_lt continuous_const continuous_norm)
  have hannK : ∀ a b : ℝ, 1 < a → IsCompact (Φ '' {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b}) := by
    intro a b ha
    have hc : IsCompact {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b} := by
      have heq : {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b} =
          Metric.closedBall (0 : E3) b ∩ {y : E3 | a ≤ ‖y‖} := by
        ext y
        simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Metric.mem_closedBall, dist_zero_right]
        tauto
      rw [heq]
      exact (isCompact_closedBall (0 : E3) b).inter_right
        (isClosed_le continuous_const continuous_norm)
    refine hc.image_of_continuousOn (hΦc.mono ?_)
    intro y hy
    obtain ⟨hy1, _⟩ := hy
    rw [hsrc]
    show (1 : ℝ) < ‖y‖
    linarith
  have hclosed : ∀ t : ℝ, 1 < t → IsClosed (Φ '' {y : E3 | t ≤ ‖y‖}) := by
    intro t ht
    by_cases h : ρc ≤ t
    · exact hcl t h
    · push_neg at h
      have heq : Φ '' {y : E3 | t ≤ ‖y‖} =
          Φ '' {y : E3 | t ≤ ‖y‖ ∧ ‖y‖ ≤ ρc} ∪ Φ '' {y : E3 | ρc ≤ ‖y‖} := by
        rw [← Set.image_union]
        congr 1
        ext y
        simp only [Set.mem_setOf_eq, Set.mem_union]
        constructor
        · intro hy
          rcases le_total ‖y‖ ρc with h' | h'
          · exact Or.inl ⟨hy, h'⟩
          · exact Or.inr h'
        · rintro (⟨hy, _⟩ | hy)
          · exact hy
          · linarith
      rw [heq]
      exact (hannK t ρc ht).isClosed.union (hcl ρc le_rfl)
  
  have hE : IsClosed {q : M | 0 ≤ β q} := isClosed_le continuous_const hβc
  set Ω := {q : M | 0 ≤ β q} \ Φ '' {y : E3 | ρ < ‖y‖} with hΩdef
  have hΩc : IsClosed Ω := hE.sdiff (hopen ρ (by linarith))
  have hΩK : IsCompact Ω := by
    refine (hKE.union (hannK Re ρ (by linarith))).of_isClosed_subset hΩc ?_
    intro q hq
    obtain ⟨hq0, hqF⟩ := hq
    by_cases hqR : q ∈ Φ '' {y : E3 | Re < ‖y‖}
    · obtain ⟨y, hy, hyq⟩ := hqR
      right
      refine ⟨y, ⟨le_of_lt hy, ?_⟩, hyq⟩
      by_contra hc
      push_neg at hc
      exact hqF ⟨y, hc, hyq⟩
    · exact Or.inl ⟨hq0, hqR⟩
  
  have hann : ∀ y : E3, Re < ‖y‖ → ‖y‖ ≤ ρ →
      Φ y ∈ connectedComponentIn Ω (Φ (ρ • e 0)) := by
    have hrank : 1 < Module.rank ℝ E3 := by
      rw [← Module.finrank_eq_rank, finrank_euclideanSpace_fin]
      norm_num
    have hnorm : ∀ x ∈ Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1, ‖x.1 • x.2‖ = x.1 := by
      intro x hx
      obtain ⟨ht, hθ⟩ := hx
      have hθ' : ‖x.2‖ = 1 := mem_sphere_zero_iff_norm.mp hθ
      have ht0 : 0 < x.1 := by linarith [ht.1]
      rw [norm_smul, hθ', mul_one, Real.norm_eq_abs, abs_of_pos ht0]
    have hDc : IsPreconnected (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1) :=
      isPreconnected_Ioc.prod (isPreconnected_sphere hrank 0 1)
    have hmaps : Set.MapsTo (fun x : ℝ × E3 => x.1 • x.2)
        (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1) Φ.source := by
      intro x hx
      rw [hsrc]
      show (1 : ℝ) < ‖x.1 • x.2‖
      rw [hnorm x hx]
      linarith [hx.1.1]
    have hfc : ContinuousOn (fun x : ℝ × E3 => Φ (x.1 • x.2))
        (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1) :=
      hΦc.comp (continuous_fst.smul continuous_snd).continuousOn hmaps
    have hP : IsPreconnected
        ((fun x : ℝ × E3 => Φ (x.1 • x.2)) '' (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1)) :=
      hDc.image _ hfc
    have hPΩ : (fun x : ℝ × E3 => Φ (x.1 • x.2)) ''
        (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1) ⊆ Ω := by
      intro p hp
      obtain ⟨x, hx, hxp⟩ := hp
      rw [← hxp]
      have hn := hnorm x hx
      have hReln : Re < ‖x.1 • x.2‖ := by rw [hn]; exact hx.1.1
      refine ⟨le_of_lt (hβpos _ hReln), ?_⟩
      rintro ⟨y', hy', hyy⟩
      have hy'' : ρ < ‖y'‖ := hy'
      have hy's : y' ∈ Φ.source := by
        rw [hsrc]
        show (1 : ℝ) < ‖y'‖
        linarith
      have hxs : x.1 • x.2 ∈ Φ.source := hmaps hx
      have heq : y' = x.1 • x.2 := Φ.toPartialEquiv.injOn hy's hxs hyy
      rw [heq, hn] at hy''
      linarith [hx.1.2]
    have hp0 : Φ (ρ • e 0) ∈
        (fun x : ℝ × E3 => Φ (x.1 • x.2)) '' (Set.Ioc Re ρ ×ˢ Metric.sphere (0 : E3) 1) := by
      refine ⟨(ρ, e 0), ⟨⟨by linarith, le_refl ρ⟩, ?_⟩, rfl⟩
      rw [mem_sphere_zero_iff_norm]
      simp [EuclideanSpace.norm_single]
    have hPC := hP.subset_connectedComponentIn hp0 hPΩ
    intro y hy1 hy2
    have hy0 : 0 < ‖y‖ := by linarith
    apply hPC
    refine ⟨(‖y‖, ‖y‖⁻¹ • y), ⟨⟨hy1, hy2⟩, ?_⟩, ?_⟩
    · rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hy0.ne']
    · show Φ (‖y‖ • ‖y‖⁻¹ • y) = Φ y
      rw [smul_smul, mul_inv_cancel₀ hy0.ne', one_smul]
  have hρpos : 0 < ρ := by linarith
  have hρ0 : ‖ρ • e 0‖ = ρ := by
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_pos hρpos]
  have hp₀C : Φ (ρ • e 0) ∈ connectedComponentIn Ω (Φ (ρ • e 0)) :=
    hann _ (by rw [hρ0]; linarith) (le_of_eq hρ0)
  
  have hCcl : IsClosed (connectedComponentIn Ω (Φ (ρ • e 0))) := by
    rw [← closure_subset_iff_isClosed]
    refine (isPreconnected_connectedComponentIn.closure).subset_connectedComponentIn
      (subset_closure hp₀C) ?_
    calc closure (connectedComponentIn Ω (Φ (ρ • e 0))) ⊆ closure Ω :=
          closure_mono (connectedComponentIn_subset _ _)
      _ = Ω := hΩc.closure_eq
  
  have hL : ∀ q ∈ connectedComponentIn Ω (Φ (ρ • e 0)), ∃ N : Set M, IsOpen N ∧ q ∈ N ∧
      N ∩ Ω ⊆ connectedComponentIn Ω (Φ (ρ • e 0)) := by
    intro q hqC
    have hqΩ : q ∈ Ω := connectedComponentIn_subset _ _ hqC
    by_cases hqR : q ∈ Φ '' {y : E3 | Re < ‖y‖}
    · refine ⟨Φ '' {y : E3 | Re < ‖y‖}, hopen Re (by linarith), hqR, ?_⟩
      intro r hr
      obtain ⟨⟨y, hy, hyr⟩, hrΩ⟩ := hr
      rw [← hyr]
      apply hann y hy
      by_contra hc
      push_neg at hc
      exact hrΩ.2 ⟨y, hc, hyr⟩
    · rw [connectedComponentIn_eq hqC]
      have hUo : IsOpen (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ := (hclosed ρ (by linarith)).isOpen_compl
      have hqU : q ∈ (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ := by
        rintro ⟨y, hy, hyq⟩
        have hy' : ρ ≤ ‖y‖ := hy
        exact hqR ⟨y, show Re < ‖y‖ by linarith, hyq⟩
      have hUX : ∀ r ∈ (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ, r ∉ Φ '' {y : E3 | ρ < ‖y‖} := by
        rintro r hr ⟨y, hy, hyr⟩
        have hy' : ρ < ‖y‖ := hy
        exact hr ⟨y, show ρ ≤ ‖y‖ from le_of_lt hy', hyr⟩
      have hq0 : (0 : ℝ) ≤ β q := hqΩ.1
      rcases lt_or_eq_of_le hq0 with hpos | hzero
      · haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
        have hN0o : IsOpen ((Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ ∩ {r : M | 0 < β r}) :=
          hUo.inter (isOpen_lt continuous_const hβc)
        have hqN0 : q ∈ (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ ∩ {r : M | 0 < β r} := ⟨hqU, hpos⟩
        refine ⟨connectedComponentIn ((Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ ∩ {r : M | 0 < β r}) q,
          hN0o.connectedComponentIn, mem_connectedComponentIn hqN0, ?_⟩
        refine subset_trans Set.inter_subset_left ?_
        refine isPreconnected_connectedComponentIn.subset_connectedComponentIn
          (mem_connectedComponentIn hqN0) ?_
        intro r hr
        have hr' := connectedComponentIn_subset _ _ hr
        have hr2 : 0 < β r := hr'.2
        exact ⟨le_of_lt hr2, hUX r hr'.1⟩
      · have h0 : β q = 0 := hzero.symm
        obtain ⟨Ψ, r, hr, hΨs, hΨ0, hΨβ⟩ := boundary_flat_chart β hβ.1 q h0 (hβ.2.1 q h0)
        have h0s : (0 : E3) ∈ Ψ.source := by rw [hΨs]; exact Metric.mem_ball_self hr
        have hO : IsOpen (Ψ.source ∩ Ψ ⁻¹' (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ) :=
          Ψ.contMDiffOn.continuousOn.isOpen_inter_preimage Ψ.open_source hUo
        have h0O : (0 : E3) ∈ Ψ.source ∩ Ψ ⁻¹' (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ := by
          refine ⟨h0s, ?_⟩
          show Ψ 0 ∈ (Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ
          rw [hΨ0]
          exact hqU
        obtain ⟨ε, hε, hεO⟩ := Metric.isOpen_iff.mp hO 0 h0O
        have hballr : ∀ z ∈ Metric.ball (0 : E3) ε, z ∈ Metric.ball (0 : E3) r := by
          intro z hz
          have := (hεO hz).1
          rwa [hΨs] at this
        refine ⟨Ψ.target ∩ Ψ.symm ⁻¹' Metric.ball (0 : E3) ε,
          Ψ.symm.contMDiffOn.continuousOn.isOpen_inter_preimage Ψ.open_target
            Metric.isOpen_ball, ?_, ?_⟩
        · refine ⟨?_, ?_⟩
          · rw [← hΨ0]
            exact Ψ.toPartialEquiv.map_source h0s
          · show Ψ.symm q ∈ Metric.ball (0 : E3) ε
            have hl : Ψ.symm (Ψ 0) = 0 := Ψ.toPartialEquiv.left_inv h0s
            rw [← hΨ0, hl]
            exact Metric.mem_ball_self hε
        · have hconv : Convex ℝ (Metric.ball (0 : E3) ε ∩ {z : E3 | 0 ≤ z 0}) := by
            refine (convex_ball 0 ε).inter ?_
            intro x hx y hy a b ha hb _
            have hx' : 0 ≤ x 0 := hx
            have hy' : 0 ≤ y 0 := hy
            show 0 ≤ (a • x + b • y) 0
            simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
            positivity
          have hsubs : Metric.ball (0 : E3) ε ∩ {z : E3 | 0 ≤ z 0} ⊆ Ψ.source := by
            intro z hz
            rw [hΨs]
            exact hballr z hz.1
          have hPc : IsPreconnected (Ψ '' (Metric.ball (0 : E3) ε ∩ {z : E3 | 0 ≤ z 0})) :=
            hconv.isPreconnected.image _ (Ψ.contMDiffOn.continuousOn.mono hsubs)
          have hz00 : (0 : E3) ∈ {z : E3 | 0 ≤ z 0} := by
            show (0 : ℝ) ≤ (0 : E3) 0
            simp
          have hqP : q ∈ Ψ '' (Metric.ball (0 : E3) ε ∩ {z : E3 | 0 ≤ z 0}) :=
            ⟨0, ⟨Metric.mem_ball_self hε, hz00⟩, hΨ0⟩
          have hPΩ : Ψ '' (Metric.ball (0 : E3) ε ∩ {z : E3 | 0 ≤ z 0}) ⊆ Ω := by
            intro s hs
            obtain ⟨z, ⟨hz, hz0⟩, hzs⟩ := hs
            rw [← hzs]
            refine ⟨?_, hUX _ (hεO hz).2⟩
            show 0 ≤ β (Ψ z)
            rw [hΨβ z (hballr z hz)]
            exact hz0
          refine subset_trans ?_ (hPc.subset_connectedComponentIn hqP hPΩ)
          intro s hs
          obtain ⟨⟨hst, hsb⟩, hsΩ⟩ := hs
          have hrs : Ψ (Ψ.symm s) = s := Ψ.toPartialEquiv.right_inv hst
          refine ⟨Ψ.symm s, ⟨hsb, ?_⟩, hrs⟩
          show 0 ≤ (Ψ.symm s) 0
          have h1 := hΨβ (Ψ.symm s) (hballr _ hsb)
          rw [hrs] at h1
          have h2 : 0 ≤ β s := hsΩ.1
          linarith
  
  have hOCcl : IsClosed (Ω \ connectedComponentIn Ω (Φ (ρ • e 0))) := by
    rw [← closure_subset_iff_isClosed]
    intro q hq
    have hqΩ : q ∈ Ω := by
      have := closure_mono
        (Set.diff_subset : Ω \ connectedComponentIn Ω (Φ (ρ • e 0)) ⊆ Ω) hq
      rwa [hΩc.closure_eq] at this
    refine ⟨hqΩ, fun hqC => ?_⟩
    obtain ⟨N, hNo, hqN, hNC⟩ := hL q hqC
    obtain ⟨s, hsN, hsΩ, hsC⟩ := _root_.mem_closure_iff.mp hq N hNo hqN
    exact hsC (hNC ⟨hsN, hsΩ⟩)
  refine ⟨hΩK.of_isClosed_subset hCcl (connectedComponentIn_subset _ _),
    hΩK.of_isClosed_subset hOCcl Set.diff_subset, ?_, ?_⟩
  · intro y hy
    exact hann y (by rw [hy]; linarith) (le_of_eq hy)
  · intro p _ hpF hpC hpR
    obtain ⟨y, hy, hyp⟩ := hpR
    apply hpC
    rw [← hyp]
    apply hann y hy
    by_contra hc
    push_neg at hc
    exact hpF ⟨y, hc, hyp⟩

theorem nds_chart_I [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re) (ρ : ℝ) (hρ : Re + 1 < ρ)
    (hcl : IsClosed ((hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖}))
    (p : M) (hp0 : 0 < β p) (hpF : p ∉ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖})
    (hpS : p ∉ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ}) :
    ∃ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ) (D : Prop),
      0 < r ∧ κ.source = Metric.ball c r ∧ κ c = p ∧ (c 0 = 0 ∨ r ≤ c 0) ∧ (D → c 0 = 0) ∧
      ∀ x ∈ Metric.ball c r,
        (κ x ∈ ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) ↔ 0 ≤ x 0) ∧
        (κ x ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} ↔ (D ∧ x 0 = 0)) ∧
        (β (κ x) = 0 ↔ (¬ D ∧ x 0 = 0)) ∧
        (¬ D → c 0 = 0 → β (κ x) = x 0) :=
by
  classical
  have hβc : Continuous β := hβ.1.continuous
  
  have hpFb : p ∉ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    rintro ⟨y, hy, hyp⟩
    rcases lt_or_eq_of_le (show ρ ≤ ‖y‖ from hy) with h | h
    · exact hpF ⟨y, h, hyp⟩
    · exact hpS ⟨y, h.symm, hyp⟩
  
  obtain ⟨U, hU⟩ : ∃ U : Set M,
      U = {q : M | 0 < β q} ∩ ((hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ := ⟨_, rfl⟩
  have hUo : IsOpen U := by
    rw [hU]; exact (isOpen_lt continuous_const hβc).inter hcl.isOpen_compl
  have hpch : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hTo : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' U) :=
    (chartAt E3 p).continuousOn_symm.isOpen_inter_preimage (chartAt E3 p).open_target hUo
  have hy₀T : chartAt E3 p p ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' U := by
    refine ⟨(chartAt E3 p).map_source hpch, ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p p) ∈ U
    rw [(chartAt E3 p).left_inv hpch, hU]
    exact ⟨hp0, hpFb⟩
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hTo (chartAt E3 p p) hy₀T
  
  obtain ⟨c, hc⟩ : ∃ c : E3, c = (2 * δ) • e 0 := ⟨_, rfl⟩
  have hc0 : c 0 = 2 * δ := by
    rw [hc]; simp [e, EuclideanSpace.single_apply]
  obtain ⟨v, hv⟩ : ∃ v : E3, v = chartAt E3 p p - c := ⟨_, rfl⟩
  have hdist : ∀ x : E3, dist (x + v) (chartAt E3 p p) = dist x c := by
    intro x
    rw [dist_eq_norm, dist_eq_norm, hv]
    congr 1
    abel
  have hdist' : ∀ w : E3, dist (w - v) c = dist w (chartAt E3 p p) := by
    intro w
    rw [dist_eq_norm, dist_eq_norm, hv]
    congr 1
    abel
  have hcoord : ∀ x ∈ Metric.ball c δ, δ < x 0 := by
    intro x hx
    have hd : dist x c < δ := hx
    have hcd : |x 0 - c 0| ≤ dist x c := by
      rw [EuclideanSpace.dist_eq, Fin.sum_univ_three, Real.dist_eq, Real.dist_eq,
        Real.dist_eq]
      apply Real.le_sqrt_of_sq_le
      have h1 : 0 ≤ |x 1 - c 1| ^ 2 := sq_nonneg _
      have h2 : 0 ≤ |x 2 - c 2| ^ 2 := sq_nonneg _
      linarith
    have h3 := (abs_lt.mp (lt_of_le_of_lt hcd hd)).1
    rw [hc0] at h3
    linarith
  have hxT : ∀ x ∈ Metric.ball c δ,
      x + v ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' U := by
    intro x hx
    apply hball
    show dist (x + v) (chartAt E3 p p) < δ
    rw [hdist]
    exact hx
  
  have hto : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun x : E3 => (chartAt E3 p).symm (x + v))
      (Metric.ball c δ) :=
    (contMDiffOn_chart_symm (x := p)).comp
      ((contDiff_id.add contDiff_const).contDiffOn (s := Metric.ball c δ)).contMDiffOn
      (fun x hx => (hxT x hx).1)
  have hinv : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun w : M => chartAt E3 p w - v)
      ((chartAt E3 p).source ∩ (chartAt E3 p) ⁻¹' Metric.ball (chartAt E3 p p) δ) :=
    (contDiff_id.sub contDiff_const).contMDiff.comp_contMDiffOn
      ((contMDiffOn_chart (x := p)).mono Set.inter_subset_left)
  let e₀ : PartialEquiv E3 M :=
    { toFun := fun x => (chartAt E3 p).symm (x + v)
      invFun := fun w => chartAt E3 p w - v
      source := Metric.ball c δ
      target := (chartAt E3 p).source ∩ (chartAt E3 p) ⁻¹' Metric.ball (chartAt E3 p p) δ
      map_source' := fun x hx => ⟨(chartAt E3 p).map_target (hxT x hx).1, by
        show chartAt E3 p ((chartAt E3 p).symm (x + v)) ∈ Metric.ball (chartAt E3 p p) δ
        rw [(chartAt E3 p).right_inv (hxT x hx).1]
        show dist (x + v) (chartAt E3 p p) < δ
        rw [hdist]
        exact hx⟩
      map_target' := fun w hw => by
        show dist (chartAt E3 p w - v) c < δ
        rw [hdist']
        exact hw.2
      left_inv' := fun x hx => by
        show chartAt E3 p ((chartAt E3 p).symm (x + v)) - v = x
        rw [(chartAt E3 p).right_inv (hxT x hx).1, add_sub_cancel_right]
      right_inv' := fun w hw => by
        show (chartAt E3 p).symm (chartAt E3 p w - v + v) = w
        rw [sub_add_cancel]
        exact (chartAt E3 p).left_inv hw.1 }
  obtain ⟨κ, hκs, hκ⟩ : ∃ κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      κ.source = Metric.ball c δ ∧ ∀ x, κ x = (chartAt E3 p).symm (x + v) :=
    ⟨{ toPartialEquiv := e₀
       open_source := Metric.isOpen_ball
       open_target := (chartAt E3 p).isOpen_inter_preimage Metric.isOpen_ball
       contMDiffOn_toFun := hto
       contMDiffOn_invFun := hinv }, rfl, fun _ => rfl⟩
  
  have hFb : ∀ q : M, q ∈ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖} →
      q ∈ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    rintro q ⟨y, hy, hyq⟩
    exact ⟨y, le_of_lt (show ρ < ‖y‖ from hy), hyq⟩
  have hSb : ∀ q : M, q ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} →
      q ∈ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    rintro q ⟨y, hy, hyq⟩
    exact ⟨y, le_of_eq (show ‖y‖ = ρ from hy).symm, hyq⟩
  have hκU : ∀ x ∈ Metric.ball c δ, 0 < β (κ x) ∧
      κ x ∉ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    intro x hx
    have h := (hxT x hx).2
    rw [hκ x]
    have h' : (chartAt E3 p).symm (x + v) ∈ U := h
    rw [hU] at h'
    exact h'
  refine ⟨κ, c, δ, False, hδ, hκs, ?_, Or.inr (by rw [hc0]; linarith), fun h => h.elim, ?_⟩
  · rw [hκ c, hv, add_sub_cancel]
    exact (chartAt E3 p).left_inv hpch
  · intro x hx
    obtain ⟨hβx, hFx⟩ := hκU x hx
    have hx0 := hcoord x hx
    refine ⟨⟨fun _ => by linarith, fun _ => ⟨le_of_lt hβx, fun h => hFx (hFb _ h)⟩⟩,
      ⟨fun h => (hFx (hSb _ h)).elim, fun h => h.1.elim⟩,
      ⟨fun h => absurd h (ne_of_gt hβx), fun h => by linarith [h.2]⟩,
      fun _ h => by rw [hc0] at h; linarith⟩

theorem nds_chart_N [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re) (ρ : ℝ) (hρ : Re + 1 < ρ)
    (hcl : IsClosed ((hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖}))
    (p : M) (hp0 : β p = 0) :
    ∃ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ) (D : Prop),
      0 < r ∧ κ.source = Metric.ball c r ∧ κ c = p ∧ (c 0 = 0 ∨ r ≤ c 0) ∧ (D → c 0 = 0) ∧
      ∀ x ∈ Metric.ball c r,
        (κ x ∈ ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) ↔ 0 ≤ x 0) ∧
        (κ x ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} ↔ (D ∧ x 0 = 0)) ∧
        (β (κ x) = 0 ↔ (¬ D ∧ x 0 = 0)) ∧
        (¬ D → c 0 = 0 → β (κ x) = x 0) :=
by
  classical
  have hpF : p ∉ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    rintro ⟨y, hy, hyp⟩
    have hy' : ρ ≤ ‖y‖ := hy
    have hRe2 : (2 : ℝ) ≤ Re := hβ.2.2.1
    have h1 := hβ.2.2.2.1 y (by linarith)
    rw [hyp, hp0] at h1
    exact lt_irrefl _ h1
  obtain ⟨Ψ, r₀, hr₀, hΨsrc, hΨ0, hΨβ⟩ := boundary_flat_chart β hβ.1 p hp0 (hβ.2.1 p hp0)
  have hΨcont : ContinuousAt Ψ 0 := by
    apply Ψ.contMDiffOn.continuousOn.continuousAt
    rw [hΨsrc]
    exact Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr₀)
  have hnhds : ((hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖})ᶜ ∈ 𝓝 (Ψ 0) := by
    rw [hΨ0]
    exact hcl.isOpen_compl.mem_nhds hpF
  obtain ⟨r₁, hr₁, hball⟩ := Metric.mem_nhds_iff.mp (hΨcont.preimage_mem_nhds hnhds)
  have hr : 0 < min r₀ r₁ := lt_min hr₀ hr₁
  have hsub0 : Metric.ball (0 : E3) (min r₀ r₁) ⊆ Metric.ball 0 r₀ :=
    Metric.ball_subset_ball (min_le_left _ _)
  have hsub1 : Metric.ball (0 : E3) (min r₀ r₁) ⊆ Metric.ball 0 r₁ :=
    Metric.ball_subset_ball (min_le_right _ _)
  have hsubΨ : Metric.ball (0 : E3) (min r₀ r₁) ⊆ Ψ.toPartialEquiv.source := by
    intro x hx
    show x ∈ Ψ.source
    rw [hΨsrc]
    exact hsub0 hx
  have hesrc : (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).source =
      Metric.ball (0 : E3) (min r₀ r₁) := by
    rw [PartialEquiv.restr_source]
    exact Set.inter_eq_right.mpr hsubΨ
  have hopen_s : IsOpen (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).source := by
    rw [hesrc]
    exact Metric.isOpen_ball
  have hopen_t : IsOpen (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).target := by
    rw [PartialEquiv.restr_target]
    exact Ψ.contMDiffOn_invFun.continuousOn.isOpen_inter_preimage Ψ.open_target
      Metric.isOpen_ball
  have hsm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞
      (⇑(Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))))
      (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).source := by
    rw [PartialEquiv.restr_coe, PartialEquiv.restr_source]
    exact Ψ.contMDiffOn.mono Set.inter_subset_left
  have hsmi : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞
      (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).invFun
      (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁))).target := by
    rw [PartialEquiv.restr_target]
    exact Ψ.contMDiffOn_invFun.mono Set.inter_subset_left
  let κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    PartialDiffeomorph.mk (Ψ.toPartialEquiv.restr (Metric.ball (0 : E3) (min r₀ r₁)))
      hopen_s hopen_t hsm hsmi
  have hκv : ∀ x : E3, κ x = Ψ x := fun x => rfl
  have hκsrc : κ.source = Metric.ball (0 : E3) (min r₀ r₁) := hesrc
  refine ⟨κ, 0, min r₀ r₁, False, hr, hκsrc, ?_, Or.inl (by simp), fun h => h.elim, ?_⟩
  · rw [hκv]
    exact hΨ0
  intro x hx
  have hxβ : β (κ x) = x 0 := by
    rw [hκv]
    exact hΨβ x (hsub0 hx)
  have hxF : κ x ∉ (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} := by
    rw [hκv]
    exact hball (hsub1 hx)
  refine ⟨⟨fun h => ?_, fun h => ⟨?_, ?_⟩⟩, ⟨fun h => ?_, fun h => h.1.elim⟩,
    ⟨fun h => ⟨not_false, by rw [← hxβ]; exact h⟩, fun h => by rw [hxβ]; exact h.2⟩,
    fun _ _ => hxβ⟩
  · rw [← hxβ]
    exact h.1
  · show 0 ≤ β (κ x)
    rw [hxβ]
    exact h
  · rintro ⟨y, hy, hyx⟩
    have hy' : ρ < ‖y‖ := hy
    exact hxF ⟨y, show ρ ≤ ‖y‖ from le_of_lt hy', hyx⟩
  · obtain ⟨y, hy, hyx⟩ := h
    have hy' : ‖y‖ = ρ := hy
    exact (hxF ⟨y, show ρ ≤ ‖y‖ from le_of_eq hy'.symm, hyx⟩).elim

theorem nds_chart_D [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re) (ρ : ℝ) (hρ : Re + 1 < ρ)
    (p : M) (hpS : p ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ}) :
    ∃ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ) (D : Prop),
      0 < r ∧ κ.source = Metric.ball c r ∧ κ c = p ∧ (c 0 = 0 ∨ r ≤ c 0) ∧ (D → c 0 = 0) ∧
      ∀ x ∈ Metric.ball c r,
        (κ x ∈ ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) ↔ 0 ≤ x 0) ∧
        (κ x ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} ↔ (D ∧ x 0 = 0)) ∧
        (β (κ x) = 0 ↔ (¬ D ∧ x 0 = 0)) ∧
        (¬ D → c 0 = 0 → β (κ x) = x 0) :=
by
  classical
  obtain ⟨y, hy, rfl⟩ := hpS
  have hy' : ‖y‖ = ρ := hy
  have hRe2 : (2 : ℝ) ≤ Re := hβ.2.2.1
  have hρ3 : (3 : ℝ) < ρ := by linarith
  have hρ0 : (0 : ℝ) < ρ := by linarith
  have hρne : ρ ≠ 0 := ne_of_gt hρ0
  
  have hext : ∀ u v : E3, u 0 = v 0 → u 1 = v 1 → u 2 = v 2 → u = v := by
    intro u v h0 h1 h2
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hcoord : ∀ u : E3, |u 0| ≤ ‖u‖ := by
    intro u
    have h := PiLp.norm_apply_le u 0
    rwa [Real.norm_eq_abs] at h
  have hproj : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z : E3 => z i) := fun i =>
    (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff
  
  obtain ⟨A, hAdef⟩ : ∃ A : E3 ≃ₗᵢ[ℝ] E3,
      A = (Submodule.span ℝ {ρ • e 0 - y})ᗮ.reflection := ⟨_, rfl⟩
  have hAA : ∀ v, A (A v) = v := by
    intro v; rw [hAdef]; exact Submodule.reflection_reflection _ v
  have hAn : ∀ v, ‖A v‖ = ‖v‖ := fun v => A.norm_map v
  have hne0 : ‖ρ • e 0‖ = ρ := by
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_pos hρ0]
  have hAy : A (ρ • e 0) = y := by
    rw [hAdef]; exact Submodule.reflection_sub (by rw [hne0, hy'])
  
  obtain ⟨w, hwdef⟩ : ∃ w : E3 → E3, w = fun z => ρ • e 0 + (z 1) • e 1 + (z 2) • e 2 :=
    ⟨_, rfl⟩
  have hwz : ∀ z, w z = ρ • e 0 + (z 1) • e 1 + (z 2) • e 2 := fun z => by rw [hwdef]
  have hw0 : ∀ z : E3, (w z) 0 = ρ := by intro z; rw [hwz]; simp [e]
  have hw1 : ∀ z : E3, (w z) 1 = z 1 := by intro z; rw [hwz]; simp [e]
  have hw2 : ∀ z : E3, (w z) 2 = z 2 := by intro z; rw [hwz]; simp [e]
  have hwge : ∀ z : E3, ρ ≤ ‖w z‖ := by
    intro z
    have h := hcoord (w z)
    rw [hw0, abs_of_pos hρ0] at h
    exact h
  have hwpos : ∀ z : E3, 0 < ‖w z‖ := fun z => lt_of_lt_of_le hρ0 (hwge z)
  have hwne : ∀ z : E3, w z ≠ 0 := fun z => norm_pos_iff.mp (hwpos z)
  have hwC : ContDiff ℝ ∞ w := by
    rw [hwdef]
    exact ((contDiff_const (c := ρ • e 0)).add ((hproj 1).smul (contDiff_const (c := e 1)))).add
      ((hproj 2).smul (contDiff_const (c := e 2)))
  
  obtain ⟨σ, hσdef⟩ : ∃ σ : E3 → E3, σ = fun z => A (((ρ - z 0) / ‖w z‖) • w z) := ⟨_, rfl⟩
  have hσz : ∀ z, σ z = A (((ρ - z 0) / ‖w z‖) • w z) := fun z => by rw [hσdef]
  have hσC : ContDiff ℝ ∞ σ := by
    have h1 : ContDiff ℝ ∞ (fun z : E3 => (ρ - z 0) / ‖w z‖) :=
      ((contDiff_const (c := ρ)).sub (hproj 0)).div (ContDiff.norm ℝ hwC hwne)
        (fun z => ne_of_gt (hwpos z))
    rw [hσdef]
    exact A.contDiff.comp (h1.smul hwC)
  have hσn : ∀ z : E3, z 0 < ρ → ‖σ z‖ = ρ - z 0 := by
    intro z hz
    rw [hσz, hAn, norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos (by linarith) (hwpos z)),
      div_mul_cancel₀ _ (ne_of_gt (hwpos z))]
  have hAσ : ∀ z : E3, A (σ z) = ((ρ - z 0) / ‖w z‖) • w z := by
    intro z; rw [hσz]; exact hAA _
  
  obtain ⟨τ, hτdef⟩ : ∃ τ : E3 → E3, τ = fun v => (ρ - ‖v‖) • e 0 +
      (ρ * (A v) 1 / (A v) 0) • e 1 + (ρ * (A v) 2 / (A v) 0) • e 2 := ⟨_, rfl⟩
  have hτz : ∀ v, τ v = (ρ - ‖v‖) • e 0 +
      (ρ * (A v) 1 / (A v) 0) • e 1 + (ρ * (A v) 2 / (A v) 0) • e 2 := fun v => by rw [hτdef]
  have hτ0 : ∀ v : E3, (τ v) 0 = ρ - ‖v‖ := by intro v; rw [hτz]; simp [e]
  have hτ1 : ∀ v : E3, (τ v) 1 = ρ * (A v) 1 / (A v) 0 := by intro v; rw [hτz]; simp [e]
  have hτ2 : ∀ v : E3, (τ v) 2 = ρ * (A v) 2 / (A v) 0 := by intro v; rw [hτz]; simp [e]
  obtain ⟨V, hVdef⟩ : ∃ V : Set E3, V = {v : E3 | 0 < (A v) 0} := ⟨_, rfl⟩
  have hAi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun v : E3 => (A v) i) := fun i =>
    (hproj i).comp A.contDiff
  have hVo : IsOpen V := by
    rw [hVdef]; exact isOpen_lt continuous_const (hAi 0).continuous
  have hV0 : ∀ v ∈ V, 0 < (A v) 0 := by
    intro v hv; rw [hVdef] at hv; exact hv
  have hVnorm : ∀ v ∈ V, 0 < ‖v‖ := by
    intro v hv
    have h := hcoord (A v)
    rw [hAn] at h
    exact lt_of_lt_of_le (hV0 v hv) (le_trans (le_abs_self _) h)
  have hτC : ContDiffOn ℝ ∞ τ V := by
    have hA0 : ∀ v ∈ V, (A v) 0 ≠ 0 := fun v hv => ne_of_gt (hV0 v hv)
    have hn : ContDiffOn ℝ ∞ (fun v : E3 => ‖v‖) V :=
      ContDiffOn.norm ℝ contDiffOn_id (fun v hv => norm_pos_iff.mp (hVnorm v hv))
    rw [hτdef]
    exact ((((contDiffOn_const (c := ρ)).sub hn).smul (contDiffOn_const (c := e 0))).add
      ((((contDiffOn_const (c := ρ)).mul (hAi 1).contDiffOn).div (hAi 0).contDiffOn hA0).smul
        (contDiffOn_const (c := e 1)))).add
      ((((contDiffOn_const (c := ρ)).mul (hAi 2).contDiffOn).div (hAi 0).contDiffOn hA0).smul
        (contDiffOn_const (c := e 2)))
  
  have hσV : ∀ z : E3, z 0 < ρ → σ z ∈ V := by
    intro z hz
    rw [hVdef]
    show 0 < (A (σ z)) 0
    rw [hAσ, PiLp.smul_apply, hw0, smul_eq_mul]
    exact mul_pos (div_pos (by linarith) (hwpos z)) hρ0
  have hkey : ∀ s a : ℝ, s ≠ 0 → ρ * (s * a) / (s * ρ) = a := by
    intro s a hs
    rw [div_eq_iff (mul_ne_zero hs hρne)]
    ring
  have hτσ : ∀ z : E3, z 0 < ρ → τ (σ z) = z := by
    intro z hz
    have hsne : (ρ - z 0) / ‖w z‖ ≠ 0 := ne_of_gt (div_pos (by linarith) (hwpos z))
    apply hext
    · rw [hτ0, hσn z hz]; ring
    · rw [hτ1, hAσ]
      simp only [PiLp.smul_apply, smul_eq_mul, hw0, hw1]
      exact hkey _ _ hsne
    · rw [hτ2, hAσ]
      simp only [PiLp.smul_apply, smul_eq_mul, hw0, hw2]
      exact hkey _ _ hsne
  have hστ : ∀ v ∈ V, σ (τ v) = v := by
    intro v hv
    have hv0 := hV0 v hv
    have hvn := hVnorm v hv
    have hμ : 0 < ρ / (A v) 0 := div_pos hρ0 hv0
    have hwτ : w (τ v) = (ρ / (A v) 0) • A v := by
      apply hext
      · rw [hw0, PiLp.smul_apply, smul_eq_mul, div_mul_cancel₀ _ (ne_of_gt hv0)]
      · rw [hw1, hτ1, PiLp.smul_apply, smul_eq_mul]; ring
      · rw [hw2, hτ2, PiLp.smul_apply, smul_eq_mul]; ring
    have hτv0 : ρ - (τ v) 0 = ‖v‖ := by rw [hτ0]; ring
    have h1 : ‖v‖ / (ρ / (A v) 0 * ‖v‖) * (ρ / (A v) 0) = 1 := by
      rw [div_mul_eq_mul_div, div_eq_one_iff_eq (ne_of_gt (mul_pos hμ hvn))]
      ring
    rw [hσz, hτv0, hwτ, smul_smul, norm_smul, hAn, Real.norm_eq_abs, abs_of_pos hμ, h1,
      one_smul, hAA]
  have h00 : (0 : E3) 0 = 0 := by simp
  have hw00 : w 0 = ρ • e 0 := by
    apply hext
    · rw [hw0]; simp [e]
    · rw [hw1]; simp [e]
    · rw [hw2]; simp [e]
  have hσ0 : σ 0 = y := by
    rw [hσz, hw00, hne0, h00, sub_zero, div_self hρne, one_smul, hAy]
  
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hB : ∀ x ∈ Metric.ball (0 : E3) (1 / 2), x 0 < ρ ∧ ‖σ x‖ = ρ - x 0 ∧
      σ x ∈ (hAF.ends k).Φ.source ∧ Re < ‖σ x‖ := by
    intro x hx
    rw [Metric.mem_ball, dist_zero_right] at hx
    have h := abs_lt.mp (lt_of_le_of_lt (hcoord x) hx)
    have hx0 : x 0 < ρ := by linarith
    have hn := hσn x hx0
    refine ⟨hx0, hn, ?_, by rw [hn]; linarith⟩
    rw [hsrc]
    show 1 < ‖σ x‖
    rw [hn]; linarith
  have hΦl : ∀ z ∈ (hAF.ends k).Φ.source, (hAF.ends k).Φ.symm ((hAF.ends k).Φ z) = z :=
    fun z hz => (hAF.ends k).Φ.toPartialEquiv.left_inv hz
  have hΦr : ∀ q ∈ (hAF.ends k).Φ.target, (hAF.ends k).Φ ((hAF.ends k).Φ.symm q) = q :=
    fun q hq => (hAF.ends k).Φ.toPartialEquiv.right_inv hq
  have hΦm : ∀ z ∈ (hAF.ends k).Φ.source, (hAF.ends k).Φ z ∈ (hAF.ends k).Φ.target :=
    fun z hz => (hAF.ends k).Φ.toPartialEquiv.map_source hz
  have hΦi : ∀ a ∈ (hAF.ends k).Φ.source, ∀ b ∈ (hAF.ends k).Φ.source,
      (hAF.ends k).Φ a = (hAF.ends k).Φ b → a = b :=
    fun a ha b hb h => (hAF.ends k).Φ.toPartialEquiv.injOn ha hb h
  have hto : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun x : E3 => (hAF.ends k).Φ (σ x))
      (Metric.ball (0 : E3) (1 / 2)) :=
    (hAF.ends k).Φ.contMDiffOn.comp hσC.contDiffOn.contMDiffOn (fun x hx => (hB x hx).2.2.1)
  have hTo : IsOpen (V ∩ τ ⁻¹' Metric.ball (0 : E3) (1 / 2)) :=
    hτC.continuousOn.isOpen_inter_preimage hVo Metric.isOpen_ball
  have hinv : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun q : M => τ ((hAF.ends k).Φ.symm q))
      ((hAF.ends k).Φ.target ∩
        (hAF.ends k).Φ.symm ⁻¹' (V ∩ τ ⁻¹' Metric.ball (0 : E3) (1 / 2))) :=
    hτC.contMDiffOn.comp ((hAF.ends k).Φ.symm.contMDiffOn.mono Set.inter_subset_left)
      (fun q hq => hq.2.1)
  let e₀ : PartialEquiv E3 M :=
    { toFun := fun x => (hAF.ends k).Φ (σ x)
      invFun := fun q => τ ((hAF.ends k).Φ.symm q)
      source := Metric.ball (0 : E3) (1 / 2)
      target := (hAF.ends k).Φ.target ∩
        (hAF.ends k).Φ.symm ⁻¹' (V ∩ τ ⁻¹' Metric.ball (0 : E3) (1 / 2))
      map_source' := fun x hx => by
        have hs := (hB x hx).2.2.1
        refine ⟨hΦm _ hs, ?_⟩
        show (hAF.ends k).Φ.symm ((hAF.ends k).Φ (σ x)) ∈
          V ∩ τ ⁻¹' Metric.ball (0 : E3) (1 / 2)
        rw [hΦl _ hs]
        refine ⟨hσV x (hB x hx).1, ?_⟩
        show τ (σ x) ∈ Metric.ball (0 : E3) (1 / 2)
        rw [hτσ x (hB x hx).1]
        exact hx
      map_target' := fun q hq => hq.2.2
      left_inv' := fun x hx => by
        show τ ((hAF.ends k).Φ.symm ((hAF.ends k).Φ (σ x))) = x
        rw [hΦl _ (hB x hx).2.2.1, hτσ x (hB x hx).1]
      right_inv' := fun q hq => by
        show (hAF.ends k).Φ (σ (τ ((hAF.ends k).Φ.symm q))) = q
        rw [hστ _ hq.2.1, hΦr _ hq.1] }
  obtain ⟨κ, hκs, hκ⟩ : ∃ κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      κ.source = Metric.ball (0 : E3) (1 / 2) ∧ ∀ x, κ x = (hAF.ends k).Φ (σ x) :=
    ⟨{ toPartialEquiv := e₀
       open_source := Metric.isOpen_ball
       open_target := (hAF.ends k).Φ.symm.contMDiffOn.continuousOn.isOpen_inter_preimage
         (hAF.ends k).Φ.open_target hTo
       contMDiffOn_toFun := hto
       contMDiffOn_invFun := hinv }, rfl, fun _ => rfl⟩
  refine ⟨κ, 0, 1 / 2, True, by norm_num, hκs, ?_, Or.inl h00, fun _ => h00, ?_⟩
  · rw [hκ, hσ0]
  · intro x hx
    obtain ⟨hx0, hn, hs, hRe⟩ := hB x hx
    have hβx : 0 < β ((hAF.ends k).Φ (σ x)) := hβ.2.2.2.1 _ hRe
    have hinj : ∀ y' : E3, 1 < ‖y'‖ → (hAF.ends k).Φ y' = (hAF.ends k).Φ (σ x) → y' = σ x := by
      intro y' hy1 hEq
      exact hΦi y' (by rw [hsrc]; exact hy1) (σ x) hs hEq
    rw [hκ x]
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨fun h => absurd h (ne_of_gt hβx), fun h => absurd trivial h.1⟩,
      fun h => absurd trivial h⟩
    · rintro ⟨-, hnF⟩
      by_contra hneg
      push_neg at hneg
      exact hnF ⟨σ x, show ρ < ‖σ x‖ by rw [hn]; linarith, rfl⟩
    · intro h0
      refine ⟨le_of_lt hβx, ?_⟩
      rintro ⟨y', hy'', hEq⟩
      have hy3 : ρ < ‖y'‖ := hy''
      have he := hinj y' (by linarith) hEq
      rw [he, hn] at hy3
      linarith
    · rintro ⟨y', hy'', hEq⟩
      have hy3 : ‖y'‖ = ρ := hy''
      have he := hinj y' (by linarith) hEq
      rw [he, hn] at hy3
      exact ⟨trivial, by linarith⟩
    · rintro ⟨-, h0⟩
      exact ⟨σ x, show ‖σ x‖ = ρ by rw [hn, h0, sub_zero], rfl⟩

theorem nds_compact_partition [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] [SigmaCompactSpace M]
    (K : Set M) (hK : IsCompact K) (V : M → Set M) (hV : ∀ p ∈ K, IsOpen (V p) ∧ p ∈ V p) :
    ∃ (n : ℕ) (q : Fin n → M) (ψ : Fin n → M → ℝ), (∀ j, q j ∈ K) ∧
      (∀ j, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ j)) ∧ (∀ j x, 0 ≤ ψ j x) ∧
      (∀ j, IsCompact (tsupport (ψ j)) ∧ tsupport (ψ j) ⊆ V (q j)) ∧
      ∀ x ∈ K, ∑ j, ψ j x = 1 :=
by
  classical
  haveI : LocallyCompactSpace M := Manifold.locallyCompact_of_finiteDimensional 𝓘(ℝ, E3)
  have hW : ∀ p : M, ∃ W : Set M, IsCompact W ∧ W ⊆ V p ∧ (p ∈ K → p ∈ interior W) := by
    intro p
    by_cases hp : p ∈ K
    · obtain ⟨W, hWc, hWi, hWV⟩ := exists_compact_subset (hV p hp).1 (hV p hp).2
      exact ⟨W, hWc, hWV, fun _ => hWi⟩
    · exact ⟨∅, isCompact_empty, Set.empty_subset _, fun h => absurd h hp⟩
  choose W hWc hWV hWi using hW
  obtain ⟨t, htK, hcov⟩ := hK.elim_nhds_subcover (fun p => interior (W p))
    (fun p hp => isOpen_interior.mem_nhds (hWi p hp))
  let e := t.equivFin
  let q : Fin t.card → M := fun j => ((e.symm j : ↥t) : M)
  have hqK : ∀ j, q j ∈ K := fun j => htK _ (e.symm j).2
  have hUo : ∀ j, IsOpen (interior (W (q j))) := fun j => isOpen_interior
  have hUc : K ⊆ ⋃ j, interior (W (q j)) := by
    intro x hx
    have hx' := hcov hx
    simp only [Set.mem_iUnion] at hx'
    obtain ⟨y, hy, hxy⟩ := hx'
    refine Set.mem_iUnion.2 ⟨e ⟨y, hy⟩, ?_⟩
    have hq : q (e ⟨y, hy⟩) = y := by
      show ((e.symm (e ⟨y, hy⟩) : ↥t) : M) = y
      rw [Equiv.symm_apply_apply]
    rw [hq]
    exact hxy
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E3) hK.isClosed
    (fun j => interior (W (q j))) hUo hUc
  refine ⟨t.card, q, fun j => f j, hqK, fun j => (f j).contMDiff, fun j x => f.nonneg j x,
    fun j => ?_, fun x hx => ?_⟩
  · have h1 : tsupport (fun x => f j x) ⊆ W (q j) := (hf j).trans interior_subset
    exact ⟨(hWc (q j)).of_isClosed_subset (isClosed_tsupport _) h1, h1.trans (hWV (q j))⟩
  · have h := f.sum_eq_one hx
    rw [finsum_eq_sum_of_fintype] at h
    exact h

theorem nds_atlas_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re) (ρ : ℝ) (hρ : Re + 1 < ρ) :
    Nonempty (NdsAtlas M β
      (connectedComponentIn ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖})
        ((hAF.ends k).Φ (ρ • e 0)))
      ((hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ})) :=
by
  classical
  have hRe2 : (2 : ℝ) ≤ Re := hβ.2.2.1
  have hρ1 : (1 : ℝ) < ρ := by linarith
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hΦc : ContinuousOn (hAF.ends k).Φ (hAF.ends k).Φ.source :=
    (hAF.ends k).Φ.contMDiffOn.continuousOn
  
  have hannK : ∀ a b : ℝ, 1 < a →
      IsCompact ((hAF.ends k).Φ '' {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b}) := by
    intro a b ha
    have hc : IsCompact {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b} := by
      have heq : {y : E3 | a ≤ ‖y‖ ∧ ‖y‖ ≤ b} =
          Metric.closedBall (0 : E3) b ∩ {y : E3 | a ≤ ‖y‖} := by
        ext y
        simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Metric.mem_closedBall, dist_zero_right]
        tauto
      rw [heq]
      exact (isCompact_closedBall (0 : E3) b).inter_right
        (isClosed_le continuous_const continuous_norm)
    refine hc.image_of_continuousOn (hΦc.mono ?_)
    intro y hy
    obtain ⟨hy1, _⟩ := hy
    rw [hsrc]
    show (1 : ℝ) < ‖y‖
    linarith
  have hcl : IsClosed ((hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖}) := by
    obtain ⟨ρc, _, hclf⟩ := endChart_far_isClosed g hAF k
    by_cases h : ρc ≤ ρ
    · exact hclf ρ h
    · push_neg at h
      have heq : (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖} =
          (hAF.ends k).Φ '' {y : E3 | ρ ≤ ‖y‖ ∧ ‖y‖ ≤ ρc} ∪
            (hAF.ends k).Φ '' {y : E3 | ρc ≤ ‖y‖} := by
        rw [← Set.image_union]
        congr 1
        ext y
        simp only [Set.mem_setOf_eq, Set.mem_union]
        constructor
        · intro hy
          rcases le_total ‖y‖ ρc with h' | h'
          · exact Or.inl ⟨hy, h'⟩
          · exact Or.inr h'
        · rintro (⟨hy, _⟩ | hy)
          · exact hy
          · linarith
      rw [heq]
      exact (hannK ρ ρc hρ1).isClosed.union (hclf ρc le_rfl)
  
  set Ω : Set M := {q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖} with hΩ
  set S : Set M := (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} with hS
  set C : Set M := connectedComponentIn Ω ((hAF.ends k).Φ (ρ • e 0)) with hC
  
  have hdomC : ∀ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ),
      0 < r → κ.source = Metric.ball c r → 0 ≤ c 0 →
      (∀ x ∈ Metric.ball c r, κ x ∈ Ω ↔ 0 ≤ x 0) → κ c ∈ C →
      ∀ x ∈ Metric.ball c r, κ x ∈ C ↔ 0 ≤ x 0 := by
    intro κ c r hr hsrcκ hc hdom hcC x hx
    constructor
    · intro hxC
      exact (hdom x hx).1 (connectedComponentIn_subset _ _ hxC)
    · intro hx0
      have hP : IsPreconnected (Metric.ball c r ∩ {z : E3 | 0 ≤ z 0}) := by
        apply Convex.isPreconnected
        apply (convex_ball c r).inter
        exact convex_halfSpace_ge
          (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).toLinearMap.isLinear 0
      have hcont : ContinuousOn κ (Metric.ball c r ∩ {z : E3 | 0 ≤ z 0}) :=
        κ.contMDiffOn.continuousOn.mono (fun z hz => by rw [hsrcκ]; exact hz.1)
      have hPi := hP.image κ hcont
      have hcP : c ∈ Metric.ball c r ∩ {z : E3 | 0 ≤ z 0} := ⟨Metric.mem_ball_self hr, hc⟩
      have hsub : κ '' (Metric.ball c r ∩ {z : E3 | 0 ≤ z 0}) ⊆ Ω := by
        rintro _ ⟨z, hz, rfl⟩
        exact (hdom z hz.1).2 hz.2
      have h1 := hPi.subset_connectedComponentIn ⟨c, hcP, rfl⟩ hsub
      rw [← connectedComponentIn_eq hcC] at h1
      exact h1 ⟨x, ⟨hx, hx0⟩, rfl⟩
  
  have hB : ∀ p ∈ C, ∃ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ)
      (D : Prop), 0 < r ∧ κ.source = Metric.ball c r ∧ κ c = p ∧ (c 0 = 0 ∨ r ≤ c 0) ∧
      (D → c 0 = 0) ∧ ∀ x ∈ Metric.ball c r,
        (κ x ∈ C ↔ 0 ≤ x 0) ∧ (κ x ∈ S ↔ (D ∧ x 0 = 0)) ∧
        (β (κ x) = 0 ↔ (¬ D ∧ x 0 = 0)) ∧ (¬ D → c 0 = 0 → β (κ x) = x 0) := by
    intro p hp
    have hpΩ : p ∈ Ω := connectedComponentIn_subset _ _ hp
    have hAC : ∃ (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ) (D : Prop),
        0 < r ∧ κ.source = Metric.ball c r ∧ κ c = p ∧ (c 0 = 0 ∨ r ≤ c 0) ∧ (D → c 0 = 0) ∧
        ∀ x ∈ Metric.ball c r,
          (κ x ∈ ({q : M | 0 ≤ β q} \ (hAF.ends k).Φ '' {y : E3 | ρ < ‖y‖}) ↔ 0 ≤ x 0) ∧
          (κ x ∈ (hAF.ends k).Φ '' {y : E3 | ‖y‖ = ρ} ↔ (D ∧ x 0 = 0)) ∧
          (β (κ x) = 0 ↔ (¬ D ∧ x 0 = 0)) ∧
          (¬ D → c 0 = 0 → β (κ x) = x 0) := by
      by_cases hpS : p ∈ S
      · exact nds_chart_D g hAF k β Re hβ ρ hρ p hpS
      · by_cases h0 : β p = 0
        · exact nds_chart_N g hAF k β Re hβ ρ hρ hcl p h0
        · have hβ0 : (0 : ℝ) ≤ β p := hpΩ.1
          exact nds_chart_I g hAF k β Re hβ ρ hρ hcl p (lt_of_le_of_ne hβ0 (Ne.symm h0))
            hpΩ.2 hpS
    obtain ⟨κ, c, r, D, hr, hsrcκ, hκc, hcen, hDc, hx⟩ := hAC
    have hc0 : 0 ≤ c 0 := by
      rcases hcen with h | h
      · exact le_of_eq h.symm
      · exact hr.le.trans h
    have hcC : κ c ∈ C := by rw [hκc]; exact hp
    refine ⟨κ, c, r, D, hr, hsrcκ, hκc, hcen, hDc, fun x hxb => ⟨?_, (hx x hxb).2⟩⟩
    exact hdomC κ c r hr hsrcκ hc0 (fun z hz => (hx z hz).1) hcC x hxb
  choose κ c r D hr hsrcκ hκc hcen hDc hAC using hB
  
  haveI : SigmaCompactSpace M := af_sigmaCompactSpace g hAF
  have hCc : IsCompact C := (nds_component_topology g hAF k β Re hβ ρ hρ).1
  obtain ⟨V, hVdef⟩ : ∃ V : M → Set M, V = fun p =>
      if hp : p ∈ C then κ p hp '' Metric.ball (c p hp) (r p hp / 8) else ∅ := ⟨_, rfl⟩
  have hVeq : ∀ p (hp : p ∈ C), V p = κ p hp '' Metric.ball (c p hp) (r p hp / 8) := by
    intro p hp
    rw [hVdef]
    exact dif_pos hp
  have hV : ∀ p ∈ C, IsOpen (V p) ∧ p ∈ V p := by
    intro p hp
    rw [hVeq p hp]
    have hr8 : 0 < r p hp / 8 := by have := hr p hp; linarith
    have hsub : Metric.ball (c p hp) (r p hp / 8) ⊆ (κ p hp).toOpenPartialHomeomorph.source := by
      intro x hx
      show x ∈ (κ p hp).source
      rw [hsrcκ p hp]
      exact Metric.ball_subset_ball (by linarith) hx
    refine ⟨(κ p hp).toOpenPartialHomeomorph.isOpen_image_of_subset_source Metric.isOpen_ball hsub,
      ⟨c p hp, Metric.mem_ball_self hr8, hκc p hp⟩⟩
  obtain ⟨n, q, ψ, hqC, hψs, hψn, hψsupp, hψsum⟩ := nds_compact_partition C hCc V hV
  exact ⟨{ n := n
           κ := fun j => κ (q j) (hqC j)
           c := fun j => c (q j) (hqC j)
           r := fun j => r (q j) (hqC j)
           D := fun j => D (q j) (hqC j)
           ψ := ψ
           r_pos := fun j => hr _ _
           source_eq := fun j => hsrcκ _ _
           center := fun j => hcen _ _
           D_center := fun j => hDc _ _
           dom := fun j x hx => (hAC _ _ x hx).1
           dir := fun j x hx => (hAC _ _ x hx).2.1
           bdry := fun j x hx => (hAC _ _ x hx).2.2.1
           neu := fun j hD hc0 x hx => (hAC _ _ x hx).2.2.2 hD hc0
           ψ_smooth := hψs
           ψ_nonneg := hψn
           ψ_supp := fun j => by
             have h := hψsupp j
             rw [hVeq (q j) (hqC j)] at h
             exact h
           ψ_sum := hψsum }⟩

theorem nds_direct_method {V : Type*} [AddCommGroup V] [Module ℝ V]
    (B : V → V → ℝ) (L Q : V → ℝ) (CP K : ℝ)
    (hBsymm : ∀ u w, B u w = B w u)
    (hBlin : ∀ (a b : ℝ) (u v w : V), B (a • u + b • v) w = a * B u w + b * B v w)
    (hBnn : ∀ u, 0 ≤ B u u)
    (hLlin : ∀ (a b : ℝ) (u v : V), L (a • u + b • v) = a * L u + b * L v)
    (hQ : ∀ u, 0 ≤ Q u ∧ Q u ≤ CP * B u u)
    (hL : ∀ u, L u ^ 2 ≤ K * Q u) :
    ∃ u : ℕ → V,
      (∀ ε > 0, ∃ N : ℕ, ∀ m n, N ≤ m → N ≤ n → B (u m - u n) (u m - u n) < ε) ∧
      (∀ φ : V, Tendsto (fun n => B (u n) φ + L φ) atTop (𝓝 0)) :=
by
  
  have B2 : ∀ (a b : ℝ) (u v w : V), B w (a • u + b • v) = a * B w u + b * B w v := by
    intro a b u v w
    rw [hBsymm w, hBlin, hBsymm u w, hBsymm v w]
  
  have taylor : ∀ (u φ : V) (t : ℝ),
      B (u + t • φ) (u + t • φ) / 2 + L (u + t • φ) =
        (B u u / 2 + L u) + t * (B u φ + L φ) + t ^ 2 / 2 * B φ φ := by
    intro u φ t
    have hw : u + t • φ = (1 : ℝ) • u + t • φ := by rw [one_smul]
    rw [hw]
    simp only [hBlin, B2, hLlin]
    rw [hBsymm φ u]
    ring
  
  have para : ∀ a b : V,
      (B a a / 2 + L a) + (B b b / 2 + L b)
        - 2 * (B ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • b) ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • b) / 2
          + L ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • b))
        = B (a - b) (a - b) / 4 := by
    intro a b
    have hw : a - b = (1 : ℝ) • a + (-1 : ℝ) • b := by
      rw [one_smul, neg_one_smul, sub_eq_add_neg]
    rw [hw]
    simp only [hBlin, B2, hLlin]
    rw [hBsymm b a]
    ring
  
  have quad : ∀ δ X b : ℝ, 0 ≤ b → (∀ t : ℝ, 0 ≤ δ + t * X + t ^ 2 / 2 * b) →
      X ^ 2 ≤ 2 * δ * (b + 1) := by
    intro δ X b hb h
    have hb1 : 0 < b + 1 := by linarith
    obtain ⟨t, ht⟩ : ∃ t : ℝ, t = -X / (b + 1) := ⟨_, rfl⟩
    have h0 := h t
    have hX : X = -(t * (b + 1)) := by
      rw [ht, div_mul_cancel₀ _ hb1.ne']
      ring
    subst hX
    have h' : t ^ 2 * (b + 2) ≤ 2 * δ := by nlinarith
    nlinarith [mul_le_mul_of_nonneg_left h' hb1.le, mul_nonneg (sq_nonneg t) hb1.le]
  
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = |K| * max CP 0 := ⟨_, rfl⟩
  have hM : 0 ≤ M := by rw [hMdef]; exact mul_nonneg (abs_nonneg K) (le_max_right _ _)
  have hLM : ∀ v, L v ^ 2 ≤ M * B v v := by
    intro v
    have h1 : CP * B v v ≤ max CP 0 * B v v :=
      mul_le_mul_of_nonneg_right (le_max_left _ _) (hBnn v)
    have h2 : K * Q v ≤ |K| * Q v := mul_le_mul_of_nonneg_right (le_abs_self K) (hQ v).1
    have h3 : |K| * Q v ≤ |K| * (max CP 0 * B v v) :=
      mul_le_mul_of_nonneg_left (le_trans (hQ v).2 h1) (abs_nonneg K)
    have h4 : |K| * (max CP 0 * B v v) = M * B v v := by rw [hMdef]; ring
    linarith [hL v]
  have hJlow : ∀ v, -M / 2 ≤ B v v / 2 + L v := by
    intro v
    have hβ := hBnn v
    have hℓ := hLM v
    by_contra hcon
    push_neg at hcon
    have hs : B v v / 2 + L v + M / 2 < 0 := by linarith
    have hs2 : L v - (B v v + M) / 2 < 0 := by linarith
    nlinarith [mul_pos_of_neg_of_neg hs2 hs, sq_nonneg (B v v - M)]
  
  have hbdd : BddBelow (Set.range (fun v => B v v / 2 + L v)) := by
    refine ⟨-M / 2, ?_⟩
    rintro _ ⟨v, rfl⟩
    exact hJlow v
  obtain ⟨m₀, hm₀⟩ : ∃ m₀ : ℝ, m₀ = sInf (Set.range (fun v => B v v / 2 + L v)) := ⟨_, rfl⟩
  have hmin : ∀ v, m₀ ≤ B v v / 2 + L v := by
    intro v
    rw [hm₀]
    exact csInf_le hbdd ⟨v, rfl⟩
  have hex : ∀ n : ℕ, ∃ v, B v v / 2 + L v < m₀ + 1 / ((n : ℝ) + 1) := by
    intro n
    have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    have hne : (Set.range (fun v => B v v / 2 + L v)).Nonempty := ⟨_, ⟨0, rfl⟩⟩
    have hlt : sInf (Set.range (fun v => B v v / 2 + L v)) < m₀ + 1 / ((n : ℝ) + 1) := by
      rw [← hm₀]; linarith
    obtain ⟨_, ⟨v, rfl⟩, hv⟩ := exists_lt_of_csInf_lt hne hlt
    exact ⟨v, hv⟩
  choose u hu using hex
  refine ⟨u, ?_, ?_⟩
  · intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (8 / ε)
    refine ⟨N, fun m n hm hn => ?_⟩
    have hpar := para (u m) (u n)
    have h1 := hmin ((1 / 2 : ℝ) • u m + (1 / 2 : ℝ) • u n)
    have h2 := hu m
    have h3 := hu n
    have hmN : (N : ℝ) ≤ m := by exact_mod_cast hm
    have hnN : (N : ℝ) ≤ n := by exact_mod_cast hn
    have hm' : 1 / ((m : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by linarith)
    have hn' : 1 / ((n : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
      one_div_le_one_div_of_le (by positivity) (by linarith)
    have h8 : 8 < (N : ℝ) * ε := (div_lt_iff₀ hε).mp hN
    have hNε : 8 * (1 / ((N : ℝ) + 1)) < ε := by
      rw [show 8 * (1 / ((N : ℝ) + 1)) = 8 / ((N : ℝ) + 1) by ring,
        div_lt_iff₀ (by positivity)]
      nlinarith
    linarith
  · intro φ
    have hb := hBnn φ
    have hq : ∀ n : ℕ, (B (u n) φ + L φ) ^ 2 ≤ 2 * (1 / ((n : ℝ) + 1)) * (B φ φ + 1) := by
      intro n
      apply quad _ _ _ hb
      intro t
      have h1 := hmin (u n + t • φ)
      rw [taylor] at h1
      linarith [hu n]
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (2 * (B φ φ + 1) / ε ^ 2)
    refine ⟨N, fun n hn => ?_⟩
    rw [Real.dist_eq, sub_zero]
    have hε2 : 0 < ε ^ 2 := by positivity
    have h2 : 2 * (B φ φ + 1) < (N : ℝ) * ε ^ 2 := (div_lt_iff₀ hε2).mp hN
    have hnN : (N : ℝ) ≤ n := by exact_mod_cast hn
    have h3 : 2 * (1 / ((n : ℝ) + 1)) * (B φ φ + 1) < ε ^ 2 := by
      rw [show 2 * (1 / ((n : ℝ) + 1)) * (B φ φ + 1) = 2 * (B φ φ + 1) / ((n : ℝ) + 1) by ring,
        div_lt_iff₀ (by positivity)]
      nlinarith
    exact abs_lt_of_sq_lt_sq (lt_of_le_of_lt (hq n) h3) hε.le

theorem l2_cauchy_limit (U : Set E3) (hU : MeasurableSet U) (h : ℕ → E3 → ℝ)
    (hh : ∀ m, MemLp (h m) 2 (volume.restrict U))
    (hc : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l → ∫ x in U, (h m x - h l x) ^ 2 < ε) :
    ∃ H : E3 → ℝ, MemLp H 2 (volume.restrict U) ∧
      Tendsto (fun m => ∫ x in U, (h m x - H x) ^ 2) atTop (𝓝 0) ∧
      ∀ φ : E3 → ℝ, MemLp φ 2 (volume.restrict U) →
        Tendsto (fun m => ∫ x in U, h m x * φ x) atTop (𝓝 (∫ x in U, H x * φ x)) :=
by
  set μ : Measure E3 := volume.restrict U with hμ
  
  have s1 : ∀ (f g : E3 → ℝ) (hf : MemLp f 2 μ) (hg : MemLp g 2 μ),
      inner ℝ (MemLp.toLp f hf) (MemLp.toLp g hg) = ∫ x, f x * g x ∂μ := by
    intro f g hf hg
    rw [MeasureTheory.L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [hf.coeFn_toLp, hg.coeFn_toLp] with a h1 h2
    rw [h1, h2]
    simp [mul_comm]
  
  have s2 : ∀ (f g : E3 → ℝ) (hf : MemLp f 2 μ) (hg : MemLp g 2 μ),
      ‖MemLp.toLp f hf - MemLp.toLp g hg‖ ^ 2 = ∫ x, (f x - g x) ^ 2 ∂μ := by
    intro f g hf hg
    rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [Lp.coeFn_sub (MemLp.toLp f hf) (MemLp.toLp g hg),
      hf.coeFn_toLp, hg.coeFn_toLp] with a h0 h1 h2
    rw [h0, Pi.sub_apply, h1, h2]
    simp [sq]
  set F : ℕ → Lp ℝ 2 μ := fun m => MemLp.toLp (h m) (hh m) with hF
  have hcauchy : CauchySeq F := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨N, hN⟩ := hc (ε ^ 2) (pow_pos hε 2)
    refine ⟨N, fun m hm l hl => ?_⟩
    rw [dist_eq_norm]
    have h1 : ‖F m - F l‖ ^ 2 < ε ^ 2 := by
      rw [hF, s2]
      exact hN m l hm hl
    exact lt_of_pow_lt_pow_left₀ 2 hε.le h1
  obtain ⟨G, hG⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hGeq : MemLp.toLp (G : E3 → ℝ) (Lp.memLp G) = G := Lp.toLp_coeFn G (Lp.memLp G)
  refine ⟨(G : E3 → ℝ), Lp.memLp G, ?_, ?_⟩
  · have h1 : Tendsto (fun m => ‖F m - G‖ ^ 2) atTop (𝓝 0) := by
      have := (tendsto_iff_norm_sub_tendsto_zero.mp hG).pow 2
      simpa using this
    refine h1.congr (fun m => ?_)
    have e := s2 (h m) (G : E3 → ℝ) (hh m) (Lp.memLp G)
    rw [hGeq] at e
    exact e
  · intro φ hφ
    have h1 : Tendsto (fun m => inner ℝ (F m) (MemLp.toLp φ hφ)) atTop
        (𝓝 (inner ℝ G (MemLp.toLp φ hφ))) := hG.inner tendsto_const_nhds
    have e := s1 (G : E3 → ℝ) φ (Lp.memLp G) hφ
    rw [hGeq] at e
    rw [e] at h1
    exact h1.congr (fun m => s1 _ _ _ _)

theorem nds_half_basic (c : E3) (r : ℝ) (hr : 0 < r) :
    MeasurableSet (ndsHalf c r) ∧ ndsHalf c r ⊆ Metric.ball c r ∧
    ∀ F : E3 → ℝ, ContinuousOn F (Metric.ball c r) →
      MemLp F 2 (volume.restrict (ndsHalf c r)) ∧ IntegrableOn F (ndsHalf c r) :=
by
  have hπ : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hopen : IsOpen (ndsHalf c r) := by
    unfold ndsHalf
    exact Metric.isOpen_ball.inter (isOpen_lt continuous_const hπ)
  have hmeas : MeasurableSet (ndsHalf c r) := hopen.measurableSet
  have hHB : ndsHalf c r ⊆ Metric.ball c (r / 2) := by
    unfold ndsHalf
    exact Set.inter_subset_left
  have hsub : ndsHalf c r ⊆ Metric.ball c r :=
    hHB.trans (Metric.ball_subset_ball (by linarith))
  have hK : Metric.closedBall c (r / 2) ⊆ Metric.ball c r :=
    Metric.closedBall_subset_ball (by linarith)
  have hKc : IsCompact (Metric.closedBall c (r / 2)) := isCompact_closedBall c (r / 2)
  have hHK : ndsHalf c r ⊆ Metric.closedBall c (r / 2) :=
    hHB.trans Metric.ball_subset_closedBall
  refine ⟨hmeas, hsub, fun F hF => ?_⟩
  obtain ⟨C, hC⟩ := hKc.exists_bound_of_continuousOn (hF.mono hK)
  haveI : IsFiniteMeasure (volume.restrict (ndsHalf c r)) := by
    rw [isFiniteMeasure_restrict]
    exact (lt_of_le_of_lt (measure_mono hHK) hKc.measure_lt_top).ne
  have hae : AEStronglyMeasurable F (volume.restrict (ndsHalf c r)) :=
    (hF.mono hsub).aestronglyMeasurable hmeas
  have hbd : ∀ᵐ x ∂(volume.restrict (ndsHalf c r)), ‖F x‖ ≤ C :=
    ae_restrict_of_forall_mem hmeas (fun x hx => hC x (hHK hx))
  have hL2 : MemLp F 2 (volume.restrict (ndsHalf c r)) := MemLp.of_bound hae C hbd
  exact ⟨hL2, hL2.integrable (by norm_num)⟩

theorem flat_coeff_regular [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) :
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (g.coeff Ψ z)⁻¹ i j) Ψ.source) ∧
    (∀ z ∈ Ψ.source, ∀ i j : Fin 3, (g.coeff Ψ z)⁻¹ i j = (g.coeff Ψ z)⁻¹ j i) ∧
    (∀ z ∈ Ψ.source, ((g.coeff Ψ z)⁻¹).PosDef) ∧
    (∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel (g.coeff Ψ) k i j) Ψ.source) :=
by
  classical
  have hS : IsOpen Ψ.source := Ψ.open_source
  have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff Ψ z i j) Ψ.source :=
    fun i j => coeff_contDiffOn_source g Ψ i j
  have hpd : ∀ z ∈ Ψ.source, (g.coeff Ψ z).PosDef := fun z hz => coeff_posDef g Ψ z hz
  
  have hdetgen : ∀ F : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) Ψ.source) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) Ψ.source := by
    intro F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := Ψ.source) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (g.coeff Ψ z).adjugate i j) Ψ.source := by
    intro i j
    simp only [Matrix.adjugate_apply]
    refine hdetgen (fun z => (g.coeff Ψ z).updateRow j (Pi.single i 1)) ?_
    intro a b
    by_cases hab : a = j
    · subst hab
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hab]
      exact hG a b
  
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (g.coeff Ψ z)⁻¹ i j) Ψ.source := by
    intro i j
    have heq : (fun z => (g.coeff Ψ z)⁻¹ i j) =
        fun z => ((g.coeff Ψ z).det)⁻¹ * (g.coeff Ψ z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen _ hG).inv (fun z hz => (hpd z hz).det_pos.ne')).mul (hadj i j)
  
  have hpar : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => g.coeff Ψ z a b) y) Ψ.source := by
    intro a b c
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hS).mp (hG a b)).2
    exact hD.clm_apply contDiffOn_const
  refine ⟨hinv, ?_, fun z hz => (hpd z hz).inv, ?_⟩
  · intro z hz i j
    have h := (hpd z hz).inv.isHermitian.apply j i
    rw [star_trivial] at h
    exact h
  · intro k i j
    show ContDiffOn ℝ ∞ (fun y => christoffel (g.coeff Ψ) k i j y) Ψ.source
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinv k l).mul (((hpar j l i).add (hpar i l j)).sub (hpar i j l))))

theorem nds_chart_cont [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (u w : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w) :
    ContDiffOn ℝ ∞ (fun x => u (κ x)) κ.source ∧
    (∀ a : Fin 3, ContinuousOn (partialDeriv a (fun x => u (κ x))) κ.source) ∧
    ContinuousOn (fun x => g.gradInner u w (κ x)) κ.source ∧
    ContinuousOn (fun x => Real.sqrt (g.coeff κ x).det) κ.source ∧
    (∀ a b : Fin 3, ContinuousOn (fun x => (g.coeff κ x)⁻¹ a b) κ.source) :=
by
  have hS : IsOpen κ.source := κ.open_source
  have hsm : ∀ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v →
      ContDiffOn ℝ ∞ (fun x => v (κ x)) κ.source := by
    intro v hv
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (v ∘ κ) κ.source :=
      hv.comp_contMDiffOn κ.contMDiffOn
    exact contMDiffOn_iff_contDiffOn.mp h1
  have hpd : ∀ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v → ∀ a : Fin 3,
      ContinuousOn (partialDeriv a (fun x => v (κ x))) κ.source := by
    intro v hv a
    have h1 : ContinuousOn (fderiv ℝ (fun x => v (κ x))) κ.source :=
      (hsm v hv).continuousOn_fderiv_of_isOpen hS (by simp)
    exact h1.clm_apply continuousOn_const
  have hinv : ∀ a b : Fin 3, ContinuousOn (fun x => (g.coeff κ x)⁻¹ a b) κ.source :=
    fun a b => ((flat_coeff_regular g κ).1 a b).continuousOn
  refine ⟨hsm u hu, hpd u hu, ?_, ?_, hinv⟩
  · have hF : ContinuousOn (fun x => ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff κ x)⁻¹ i j * partialDeriv i (fun z => u (κ z)) x *
          partialDeriv j (fun z => w (κ z)) x) κ.source := by
      refine continuousOn_finset_sum _ (fun i _ => ?_)
      refine continuousOn_finset_sum _ (fun j _ => ?_)
      exact ((hinv i j).mul (hpd u hu i)).mul (hpd w hw j)
    exact hF.congr (fun x hx => gradInner_pdiffeo_formula g κ u w hu hw x hx)
  · exact (ccs_sqrtdet_smooth (g.coeff κ) κ.source
      (fun i j => coeff_contDiffOn_source g κ i j)
      (fun z hz => (coeff_posDef g κ z hz).det_pos)).continuousOn

theorem gradInner_symm_nonneg [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u w : M → ℝ) (p : M) :
    0 ≤ g.gradInner u u p ∧ g.gradInner u w p = g.gradInner w u p :=
by
  have hPSD : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (W : Fin 3 → E3),
      (∀ v w, B v w = B w v) → (∀ v, v ≠ 0 → 0 < B v v) →
      (Matrix.of fun i j => B (W i) (W j)).PosSemidef := by
    intro B W hs hp
    refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ ?_
    · ext i j
      simp only [Matrix.conjTranspose_apply, Matrix.of_apply, star_trivial]
      exact hs _ _
    · intro x
      have hexp : star x ⬝ᵥ Matrix.mulVec (Matrix.of fun i j => B (W i) (W j)) x
          = B (∑ i, x i • W i) (∑ i, x i • W i) := by
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Matrix.of_apply,
          map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
          smul_eq_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
        rw [hs (W j) (W i)]
        ring
      rw [hexp]
      by_cases hv : (∑ i, x i • W i) = 0
      · rw [hv]; simp
      · exact le_of_lt (hp _ hv)
  have hlin : ∀ (H : Matrix (Fin 3) (Fin 3) ℝ), H.PosSemidef → ∀ a b : Fin 3 → ℝ,
      0 ≤ ∑ i, ∑ j, H i j * a i * a j ∧
        ∑ i, ∑ j, H i j * a i * b j = ∑ i, ∑ j, H i j * b i * a j := by
    intro H hH a b
    have hs : ∀ i j, H i j = H j i := fun i j => by
      have h := hH.isHermitian.apply i j
      simp only [star_trivial] at h
      exact h.symm
    constructor
    · have h := hH.dotProduct_mulVec_nonneg a
      have e : star a ⬝ᵥ Matrix.mulVec H a = ∑ i, ∑ j, H i j * a i * a j := by
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
        ring
      rw [← e]; exact h
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
      rw [hs i j]; ring
  have hG : (g.coeff (chartAt E3 p).symm (chartAt E3 p p)).PosSemidef :=
    hPSD (g.g ((chartAt E3 p).symm (chartAt E3 p p)))
      (fun i => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p) (e i))
      (g.symm _) (g.posDef _)
  exact hlin _ hG.inv
    (fun i => partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p))
    (fun i => partialDeriv i (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p))

theorem nds_int_algebra [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    {β : M → ℝ} {Ω₀ S₀ : Set M} (A : NdsAtlas M β Ω₀ S₀) (F H : M → ℝ)
    (hF : ∀ j, ContinuousOn (fun x => F (A.κ j x)) (Metric.ball (A.c j) (A.r j)))
    (hH : ∀ j, ContinuousOn (fun x => H (A.κ j x)) (Metric.ball (A.c j) (A.r j))) :
    (∀ a b : ℝ, ndsInt g A (fun q => a * F q + b * H q) = a * ndsInt g A F + b * ndsInt g A H) ∧
    ((∀ q ∈ Ω₀, 0 ≤ F q) → 0 ≤ ndsInt g A F) ∧
    (ndsInt g A (fun q => F q * H q)) ^ 2 ≤
      ndsInt g A (fun q => F q ^ 2) * ndsInt g A (fun q => H q ^ 2) :=
by
  have hHb := fun j => nds_half_basic (A.c j) (A.r j) (A.r_pos j)
  have hw : ∀ j, ContinuousOn (fun x => A.ψ j (A.κ j x)) (Metric.ball (A.c j) (A.r j)) ∧
      ContinuousOn (fun x => Real.sqrt (g.coeff (A.κ j) x).det)
        (Metric.ball (A.c j) (A.r j)) := by
    intro j
    rw [← A.source_eq j]
    exact ⟨(A.ψ_smooth j).continuous.comp_continuousOn (A.κ j).contMDiffOn.continuousOn,
      (ccs_sqrtdet_smooth (g.coeff (A.κ j)) (A.κ j).source
        (fun a b => coeff_contDiffOn_source g (A.κ j) a b)
        (fun z hz => (coeff_posDef g (A.κ j) z hz).det_pos)).continuousOn⟩
  have hint : ∀ G : M → ℝ,
      (∀ j, ContinuousOn (fun x => G (A.κ j x)) (Metric.ball (A.c j) (A.r j))) →
      ∀ j, IntegrableOn
        (fun x => A.ψ j (A.κ j x) * G (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det)
        (ndsHalf (A.c j) (A.r j)) :=
    fun G hG j => ((hHb j).2.2 _ (((hw j).1.mul (hG j)).mul (hw j).2)).2
  have hlin : ∀ F' H' : M → ℝ,
      (∀ j, ContinuousOn (fun x => F' (A.κ j x)) (Metric.ball (A.c j) (A.r j))) →
      (∀ j, ContinuousOn (fun x => H' (A.κ j x)) (Metric.ball (A.c j) (A.r j))) →
      ∀ a b : ℝ, ndsInt g A (fun q => a * F' q + b * H' q) =
        a * ndsInt g A F' + b * ndsInt g A H' := by
    intro F' H' hF' hH' a b
    unfold ndsInt
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have e : (fun x => A.ψ j (A.κ j x) * (a * F' (A.κ j x) + b * H' (A.κ j x)) *
        Real.sqrt (g.coeff (A.κ j) x).det) =
        fun x => a * (A.ψ j (A.κ j x) * F' (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det) +
          b * (A.ψ j (A.κ j x) * H' (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det) := by
      funext x; ring
    rw [e, integral_add ((hint F' hF' j).const_mul a) ((hint H' hH' j).const_mul b),
      integral_const_mul, integral_const_mul]
  have hpos : ∀ G : M → ℝ, (∀ q ∈ Ω₀, 0 ≤ G q) → 0 ≤ ndsInt g A G := by
    intro G hG
    unfold ndsInt
    refine Finset.sum_nonneg (fun j _ => ?_)
    refine setIntegral_nonneg (hHb j).1 (fun x hx => ?_)
    have hxB : x ∈ Metric.ball (A.c j) (A.r j) := (hHb j).2.1 hx
    have hx0 : 0 < x 0 := hx.2
    have hΩ : A.κ j x ∈ Ω₀ := (A.dom j x hxB).2 (le_of_lt hx0)
    exact mul_nonneg (mul_nonneg (A.ψ_nonneg j _) (hG _ hΩ)) (Real.sqrt_nonneg _)
  refine ⟨hlin F H hF hH, hpos F, ?_⟩
  have cH2 : ∀ j, ContinuousOn (fun x => (fun q => H q ^ 2) (A.κ j x))
      (Metric.ball (A.c j) (A.r j)) := fun j => (hH j).pow 2
  have cF2 : ∀ j, ContinuousOn (fun x => (fun q => F q ^ 2) (A.κ j x))
      (Metric.ball (A.c j) (A.r j)) := fun j => (hF j).pow 2
  have cP : ∀ j, ContinuousOn (fun x => (fun q => F q * H q) (A.κ j x))
      (Metric.ball (A.c j) (A.r j)) := fun j => (hF j).mul (hH j)
  have cK : ∀ t : ℝ, ∀ j, ContinuousOn
      (fun x => (fun q => 2 * (F q * H q) + t * H q ^ 2) (A.κ j x))
      (Metric.ball (A.c j) (A.r j)) :=
    fun t j => (continuousOn_const.mul (cP j)).add (continuousOn_const.mul (cH2 j))
  have hquad : ∀ t : ℝ, 0 ≤ ndsInt g A (fun q => H q ^ 2) * (t * t) +
      2 * ndsInt g A (fun q => F q * H q) * t + ndsInt g A (fun q => F q ^ 2) := by
    intro t
    have h0 := hpos (fun q => (F q + t * H q) ^ 2) (fun q _ => sq_nonneg _)
    have e : (fun q => (F q + t * H q) ^ 2) =
        fun q => 1 * (F q ^ 2) + t * (2 * (F q * H q) + t * H q ^ 2) := by
      funext q; ring
    have h1 := hlin (fun q => F q ^ 2) (fun q => 2 * (F q * H q) + t * H q ^ 2) cF2 (cK t) 1 t
    have h2 := hlin (fun q => F q * H q) (fun q => H q ^ 2) cP cH2 2 t
    rw [e] at h0
    rw [h1, h2] at h0
    nlinarith [h0]
  have hd := discrim_le_zero hquad
  unfold discrim at hd
  nlinarith [hd]

theorem convex_anchor_poincare (U W O : Set E3) (c : E3) (R : ℝ) (v : E3 → ℝ)
    (hU : MeasurableSet U) (hUc : Convex ℝ U) (hUR : U ⊆ Metric.closedBall c R)
    (hO : IsOpen O) (hRO : Metric.closedBall c R ⊆ O)
    (hW : MeasurableSet W) (hWU : W ⊆ U) (hv : ContDiffOn ℝ ∞ v O) :
    (MeasureTheory.volume W).toReal * ∫ x in U, v x ^ 2 ≤
      2 * (MeasureTheory.volume U).toReal *
        ((∫ x in W, v x ^ 2) + 32 * R ^ 2 * ∫ x in U, ∑ a : Fin 3, (partialDeriv a v x) ^ 2) :=
by
  
  have c1 : ∀ (U : Set E3), MeasurableSet U → Convex ℝ U → ∀ (G : E3 → ENNReal) (p : E3),
      p ∈ U → ∀ (s : ℝ), 1 / 2 ≤ s → s ≤ 1 →
      ∫⁻ x in U, G (p + s • (x - p)) ≤ 8 * ∫⁻ z in U, G z := by
    intro U hU hUc G p hp s hs1 hs2
    have hs0 : 0 < s := by linarith
    have hderiv : ∀ x ∈ U, HasFDerivWithinAt (fun x : E3 => p + s • (x - p))
        (s • ContinuousLinearMap.id ℝ E3) U x := by
      intro x _
      have h1 := ((((hasFDerivAt_id (𝕜 := ℝ) x).sub_const p).const_smul s).const_add p)
      exact h1.hasFDerivWithinAt
    have hinj : Set.InjOn (fun x : E3 => p + s • (x - p)) U := by
      intro x _ y _ hxy
      have h2 : s • (x - p) = s • (y - p) := add_left_cancel hxy
      have h3 : x - p = y - p := smul_right_injective E3 hs0.ne' h2
      exact sub_left_injective h3
    have hcov := lintegral_image_eq_lintegral_abs_det_fderiv_mul volume hU hderiv hinj G
    have hdet : (s • ContinuousLinearMap.id ℝ E3).det = s ^ 3 := by
      show LinearMap.det ((s • ContinuousLinearMap.id ℝ E3 : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = s ^ 3
      rw [ContinuousLinearMap.coe_smul, ContinuousLinearMap.coe_id, LinearMap.det_smul,
        LinearMap.det_id, finrank_euclideanSpace_fin]
      ring
    rw [hdet] at hcov
    have himg : (fun x : E3 => p + s • (x - p)) '' U ⊆ U := by
      rintro _ ⟨x, hx, rfl⟩
      exact hUc.add_smul_sub_mem hp hx ⟨hs0.le, hs2⟩
    have hs3 : (1 / 8 : ℝ) ≤ |s ^ 3| := by
      rw [abs_of_nonneg (by positivity)]
      nlinarith [mul_le_mul hs1 hs1 (by norm_num) hs0.le]
    have hchain : ENNReal.ofReal (1 / 8) * ∫⁻ x in U, G (p + s • (x - p)) ≤
        ∫⁻ z in U, G z := by
      calc ENNReal.ofReal (1 / 8) * ∫⁻ x in U, G (p + s • (x - p))
          ≤ ∫⁻ x in U, ENNReal.ofReal (1 / 8) * G (p + s • (x - p)) :=
            lintegral_const_mul_le _ _
        _ ≤ ∫⁻ x in U, ENNReal.ofReal |s ^ 3| * G (p + s • (x - p)) := by
            refine lintegral_mono fun x => ?_
            exact mul_le_mul_right' (ENNReal.ofReal_le_ofReal hs3) _
        _ = ∫⁻ z in (fun x : E3 => p + s • (x - p)) '' U, G z := hcov.symm
        _ ≤ ∫⁻ z in U, G z := lintegral_mono_set himg
    have h8 : (8 : ENNReal) * ENNReal.ofReal (1 / 8) = 1 := by
      rw [show (8 : ENNReal) = ENNReal.ofReal 8 by simp, ← ENNReal.ofReal_mul (by norm_num)]
      norm_num
    calc ∫⁻ x in U, G (p + s • (x - p))
        = 8 * (ENNReal.ofReal (1 / 8) * ∫⁻ x in U, G (p + s • (x - p))) := by
          rw [← mul_assoc, h8, one_mul]
      _ ≤ 8 * ∫⁻ z in U, G z := mul_le_mul_left' hchain _
  
  have c4 : ∀ (U W : Set E3) (f : E3 → ℝ), W ⊆ U →
      AEMeasurable f (MeasureTheory.volume.restrict W) →
      MeasureTheory.volume W * ∫⁻ x in U, ENNReal.ofReal (f x ^ 2) ≤
        2 * MeasureTheory.volume U * (∫⁻ y in W, ENNReal.ofReal (f y ^ 2)) +
          2 * ∫⁻ x in U, ∫⁻ y in U, ENNReal.ofReal ((f x - f y) ^ 2) := by
    intro U W f hWU hf
    have hpt : ∀ a b : ℝ, ENNReal.ofReal (a ^ 2) ≤
        2 * ENNReal.ofReal (b ^ 2) + 2 * ENNReal.ofReal ((a - b) ^ 2) := by
      intro a b
      have h : a ^ 2 ≤ 2 * b ^ 2 + 2 * (a - b) ^ 2 := by nlinarith [sq_nonneg (a - 2 * b)]
      calc ENNReal.ofReal (a ^ 2) ≤ ENNReal.ofReal (2 * b ^ 2 + 2 * (a - b) ^ 2) :=
            ENNReal.ofReal_le_ofReal h
        _ = _ := by
            rw [ENNReal.ofReal_add (by positivity) (by positivity),
              ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_mul (by norm_num)]
            simp
    have hx : ∀ x, ENNReal.ofReal (f x ^ 2) * MeasureTheory.volume W ≤
        2 * (∫⁻ y in W, ENNReal.ofReal (f y ^ 2)) +
          2 * ∫⁻ y in W, ENNReal.ofReal ((f x - f y) ^ 2) := by
      intro x
      rw [← setLIntegral_const]
      calc ∫⁻ _ in W, ENNReal.ofReal (f x ^ 2)
          ≤ ∫⁻ y in W, (2 * ENNReal.ofReal (f y ^ 2) +
              2 * ENNReal.ofReal ((f x - f y) ^ 2)) :=
            lintegral_mono fun y => hpt _ _
        _ = _ := by
            rw [lintegral_add_left' (((hf.pow_const 2).ennreal_ofReal).const_mul 2),
              lintegral_const_mul' _ _ (by simp), lintegral_const_mul' _ _ (by simp)]
    calc MeasureTheory.volume W * ∫⁻ x in U, ENNReal.ofReal (f x ^ 2)
        ≤ ∫⁻ x in U, MeasureTheory.volume W * ENNReal.ofReal (f x ^ 2) :=
          lintegral_const_mul_le _ _
      _ ≤ ∫⁻ x in U, (2 * (∫⁻ y in W, ENNReal.ofReal (f y ^ 2)) +
            2 * ∫⁻ y in W, ENNReal.ofReal ((f x - f y) ^ 2)) := by
          refine lintegral_mono fun x => ?_
          rw [mul_comm]
          exact hx x
      _ = 2 * (∫⁻ y in W, ENNReal.ofReal (f y ^ 2)) * MeasureTheory.volume U +
            2 * ∫⁻ x in U, ∫⁻ y in W, ENNReal.ofReal ((f x - f y) ^ 2) := by
          rw [lintegral_add_left measurable_const, setLIntegral_const,
            lintegral_const_mul' _ _ (by simp)]
      _ ≤ 2 * (∫⁻ y in W, ENNReal.ofReal (f y ^ 2)) * MeasureTheory.volume U +
            2 * ∫⁻ x in U, ∫⁻ y in U, ENNReal.ofReal ((f x - f y) ^ 2) := by
          gcongr with x
      _ = _ := by ring
  
  have c2 : ∀ (U : Set E3), MeasurableSet U → Convex ℝ U → ∀ (G : E3 → ENNReal), Measurable G →
      ∫⁻ x in U, ∫⁻ y in U, ∫⁻ t in Set.Icc (0 : ℝ) 1, G (y + t • (x - y))
        ≤ 8 * MeasureTheory.volume U * ∫⁻ z in U, G z := by
    intro U hU hUc G hG
    have h1 : ∀ x : E3, ∫⁻ y in U, ∫⁻ t in Set.Icc (0 : ℝ) 1, G (y + t • (x - y)) =
        ∫⁻ t in Set.Icc (0 : ℝ) 1, ∫⁻ y in U, G (y + t • (x - y)) := by
      intro x
      refine lintegral_lintegral_swap ?_
      exact (hG.comp (Continuous.measurable (f := fun q : E3 × ℝ => q.1 + q.2 • (x - q.1))
        (by fun_prop))).aemeasurable
    simp_rw [h1]
    have hK : Measurable (fun q : E3 × ℝ => ∫⁻ y in U, G (y + q.2 • (q.1 - y))) := by
      have hm : Measurable (fun r : (E3 × ℝ) × E3 => G (r.2 + r.1.2 • (r.1.1 - r.2))) :=
        hG.comp (Continuous.measurable (by fun_prop))
      exact hm.lintegral_prod_right'
    rw [lintegral_lintegral_swap hK.aemeasurable]
    have hbound : ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ∫⁻ x in U, ∫⁻ y in U, G (y + t • (x - y)) ≤
          8 * (∫⁻ z in U, G z) * MeasureTheory.volume U := by
      intro t ht
      rcases le_or_gt (1 / 2 : ℝ) t with h | h
      · rw [lintegral_lintegral_swap (f := fun x y : E3 => G (y + t • (x - y)))
          ((hG.comp (Continuous.measurable
          (f := fun q : E3 × E3 => q.2 + t • (q.1 - q.2)) (by fun_prop))).aemeasurable)]
        calc ∫⁻ y in U, ∫⁻ x in U, G (y + t • (x - y))
            ≤ ∫⁻ y in U, 8 * ∫⁻ z in U, G z := by
              refine setLIntegral_mono' hU fun y hy => ?_
              exact c1 U hU hUc G y hy t h ht.2
          _ = _ := setLIntegral_const _ _
      · have heq : ∀ x y : E3, y + t • (x - y) = x + (1 - t) • (y - x) := by
          intro x y
          module
        simp_rw [heq]
        calc ∫⁻ x in U, ∫⁻ y in U, G (x + (1 - t) • (y - x))
            ≤ ∫⁻ x in U, 8 * ∫⁻ z in U, G z := by
              refine setLIntegral_mono' hU fun x hx => ?_
              exact c1 U hU hUc G x hx (1 - t) (by linarith) (by linarith [ht.1])
          _ = _ := setLIntegral_const _ _
    calc ∫⁻ t in Set.Icc (0 : ℝ) 1, ∫⁻ x in U, ∫⁻ y in U, G (y + t • (x - y))
        ≤ ∫⁻ t in Set.Icc (0 : ℝ) 1, 8 * (∫⁻ z in U, G z) * MeasureTheory.volume U :=
          setLIntegral_mono' measurableSet_Icc hbound
      _ = 8 * (∫⁻ z in U, G z) * MeasureTheory.volume U := by
          rw [setLIntegral_const, Real.volume_Icc]
          simp
      _ = _ := by ring
  
  have c3 : ∀ (x y : E3), x ∈ Metric.closedBall c R → y ∈ Metric.closedBall c R →
      ENNReal.ofReal ((v x - v y) ^ 2) ≤ ENNReal.ofReal (4 * R ^ 2) *
        ∫⁻ t in Set.Icc (0 : ℝ) 1,
          ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v (y + t • (x - y))) ^ 2) := by
    intro x y hx hy
    set w : E3 := x - y with hwdef
    have hγB : ∀ t ∈ Set.Icc (0 : ℝ) 1, y + t • w ∈ Metric.closedBall c R :=
      fun t ht => (convex_closedBall c R).add_smul_sub_mem hy hx ht
    have hγO : ∀ t ∈ Set.Icc (0 : ℝ) 1, y + t • w ∈ O := fun t ht => hRO (hγB t ht)
    have hfd : ContinuousOn (fderiv ℝ v) O := hv.continuousOn_fderiv_of_isOpen hO (by simp)
    have hdiff : ∀ z ∈ O, DifferentiableAt ℝ v z :=
      fun z hz => (hv.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hz)
    have hγc : Continuous (fun t : ℝ => y + t • w) := by fun_prop
    have hγmap : Set.MapsTo (fun t : ℝ => y + t • w) (Set.Icc (0 : ℝ) 1) O :=
      fun t ht => hγO t ht
    have hFc : ContinuousOn (fun t : ℝ => fderiv ℝ v (y + t • w)) (Set.Icc (0 : ℝ) 1) :=
      hfd.comp hγc.continuousOn hγmap
    have hφc : ContinuousOn (fun t : ℝ => fderiv ℝ v (y + t • w) w) (Set.Icc (0 : ℝ) 1) :=
      hFc.clm_apply continuousOn_const
    have hpc : ∀ a : Fin 3, ContinuousOn (fun t : ℝ => partialDeriv a v (y + t • w))
        (Set.Icc (0 : ℝ) 1) := fun a => hFc.clm_apply continuousOn_const
    have hGc : ContinuousOn (fun t : ℝ => ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2)
        (Set.Icc (0 : ℝ) 1) := continuousOn_finset_sum _ fun a _ => (hpc a).pow 2
    have hI1 : IntervalIntegrable (fun t : ℝ => fderiv ℝ v (y + t • w) w) volume 0 1 :=
      hφc.intervalIntegrable_of_Icc zero_le_one
    have hI2 : IntervalIntegrable (fun t : ℝ => (fderiv ℝ v (y + t • w) w) ^ 2) volume 0 1 :=
      (hφc.pow 2).intervalIntegrable_of_Icc zero_le_one
    have hIG : IntervalIntegrable
        (fun t : ℝ => ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2) volume 0 1 :=
      hGc.intervalIntegrable_of_Icc zero_le_one
    have hderiv : ∀ t ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => v (y + t • w)) (fderiv ℝ v (y + t • w) w) t := by
      intro t ht
      rw [Set.uIcc_of_le zero_le_one] at ht
      have hγd : HasDerivAt (fun t : ℝ => y + t • w) w t := by
        simpa using ((hasDerivAt_id t).smul_const w).const_add y
      exact (hdiff _ (hγO t ht)).hasFDerivAt.comp_hasDerivAt t hγd
    have hFTC : ∫ t in (0 : ℝ)..1, fderiv ℝ v (y + t • w) w = v x - v y := by
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hI1]
      simp [hwdef]
    set m : ℝ := ∫ t in (0 : ℝ)..1, fderiv ℝ v (y + t • w) w with hm
    have hJ : m ^ 2 ≤ ∫ t in (0 : ℝ)..1, (fderiv ℝ v (y + t • w) w) ^ 2 := by
      have h0 : 0 ≤ ∫ t in (0 : ℝ)..1, (fderiv ℝ v (y + t • w) w - m) ^ 2 :=
        intervalIntegral.integral_nonneg zero_le_one fun t _ => sq_nonneg _
      have hexp : (fun t : ℝ => (fderiv ℝ v (y + t • w) w - m) ^ 2) =
          fun t => ((fderiv ℝ v (y + t • w) w) ^ 2 - (2 * m) * fderiv ℝ v (y + t • w) w) +
            m ^ 2 := by
        funext t; ring
      rw [hexp, intervalIntegral.integral_add (hI2.sub (hI1.const_mul _))
          intervalIntegrable_const,
        intervalIntegral.integral_sub hI2 (hI1.const_mul _), intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const, ← hm] at h0
      simp only [sub_zero, smul_eq_mul, one_mul] at h0
      nlinarith
    have hwsum : ∑ a : Fin 3, w a • e a = w := by
      ext i
      fin_cases i <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    have hwn : ∑ a : Fin 3, (w a) ^ 2 ≤ 4 * R ^ 2 := by
      have h1 : ‖w‖ ^ 2 = ∑ a : Fin 3, (w a) ^ 2 := by
        rw [EuclideanSpace.norm_sq_eq]
        simp [Real.norm_eq_abs, sq_abs]
      have h2 : ‖w‖ ≤ 2 * R := by
        have hd : ‖w‖ = dist x y := by rw [hwdef, dist_eq_norm]
        rw [hd]
        have := dist_triangle_right x y c
        rw [Metric.mem_closedBall] at hx hy
        linarith
      rw [← h1]
      nlinarith [norm_nonneg w]
    have hpt : ∀ t ∈ Set.Icc (0 : ℝ) 1, (fderiv ℝ v (y + t • w) w) ^ 2 ≤
        4 * R ^ 2 * ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2 := by
      intro t _
      have hlin : fderiv ℝ v (y + t • w) w =
          ∑ a : Fin 3, w a * partialDeriv a v (y + t • w) := by
        calc fderiv ℝ v (y + t • w) w = fderiv ℝ v (y + t • w) (∑ a : Fin 3, w a • e a) := by
              rw [hwsum]
          _ = _ := by
              rw [map_sum]
              simp only [map_smul, smul_eq_mul, partialDeriv]
      rw [hlin]
      have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun a => w a)
        (fun a => partialDeriv a v (y + t • w))
      have hG0 : 0 ≤ ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2 :=
        Finset.sum_nonneg fun a _ => sq_nonneg _
      calc _ ≤ (∑ a : Fin 3, (w a) ^ 2) * ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2 := hcs
        _ ≤ _ := mul_le_mul_of_nonneg_right hwn hG0
    have hmono : ∫ t in (0 : ℝ)..1, (fderiv ℝ v (y + t • w) w) ^ 2 ≤
        ∫ t in (0 : ℝ)..1, 4 * R ^ 2 * ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2 :=
      intervalIntegral.integral_mono_on zero_le_one hI2 (hIG.const_mul _) hpt
    rw [intervalIntegral.integral_const_mul] at hmono
    have hreal : (v x - v y) ^ 2 ≤
        4 * R ^ 2 * ∫ t in Set.Icc (0 : ℝ) 1,
          ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2 := by
      rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one, ← hFTC]
      exact hJ.trans hmono
    have hlint : ENNReal.ofReal (∫ t in Set.Icc (0 : ℝ) 1,
        ∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2) =
        ∫⁻ t in Set.Icc (0 : ℝ) 1,
          ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v (y + t • w)) ^ 2) :=
      ofReal_integral_eq_lintegral_ofReal hGc.integrableOn_Icc
        (ae_of_all _ fun t => Finset.sum_nonneg fun a _ => sq_nonneg _)
    rw [← hlint, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  
  have hfd : ContinuousOn (fderiv ℝ v) O := hv.continuousOn_fderiv_of_isOpen hO (by simp)
  have hGrc : ContinuousOn (fun x => ∑ a : Fin 3, (partialDeriv a v x) ^ 2) O :=
    continuousOn_finset_sum _ fun a _ => (hfd.clm_apply continuousOn_const).pow 2
  have hv2c : ContinuousOn (fun x => v x ^ 2) O := hv.continuousOn.pow 2
  have hK : IsCompact (Metric.closedBall c R) := isCompact_closedBall c R
  have hv2B : IntegrableOn (fun x => v x ^ 2) (Metric.closedBall c R) :=
    (hv2c.mono hRO).integrableOn_compact hK
  have hGrB : IntegrableOn (fun x => ∑ a : Fin 3, (partialDeriv a v x) ^ 2)
      (Metric.closedBall c R) := (hGrc.mono hRO).integrableOn_compact hK
  have hv2U : IntegrableOn (fun x => v x ^ 2) U := hv2B.mono_set hUR
  have hv2W : IntegrableOn (fun x => v x ^ 2) W := hv2B.mono_set (hWU.trans hUR)
  have hGrU : IntegrableOn (fun x => ∑ a : Fin 3, (partialDeriv a v x) ^ 2) U :=
    hGrB.mono_set hUR
  
  have hGm : Measurable (fun z => ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v z) ^ 2)) := by
    refine Measurable.ennreal_ofReal ?_
    exact Finset.measurable_sum _ fun a _ =>
      (measurable_fderiv_apply_const ℝ v (e a)).pow_const 2
  have hvW : AEMeasurable v (MeasureTheory.volume.restrict W) :=
    (hv.continuousOn.mono (hWU.trans (hUR.trans hRO))).aemeasurable hW
  
  have hUfin : MeasureTheory.volume U ≠ ⊤ :=
    ((measure_mono hUR).trans_lt measure_closedBall_lt_top).ne
  have hWfin : MeasureTheory.volume W ≠ ⊤ :=
    ((measure_mono (hWU.trans hUR)).trans_lt measure_closedBall_lt_top).ne
  
  have hI : ∫⁻ x in U, ENNReal.ofReal (v x ^ 2) = ENNReal.ofReal (∫ x in U, v x ^ 2) :=
    (ofReal_integral_eq_lintegral_ofReal hv2U (ae_of_all _ fun x => sq_nonneg _)).symm
  have hJ : ∫⁻ x in W, ENNReal.ofReal (v x ^ 2) = ENNReal.ofReal (∫ x in W, v x ^ 2) :=
    (ofReal_integral_eq_lintegral_ofReal hv2W (ae_of_all _ fun x => sq_nonneg _)).symm
  have hE : ∫⁻ x in U, ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v x) ^ 2) =
      ENNReal.ofReal (∫ x in U, ∑ a : Fin 3, (partialDeriv a v x) ^ 2) :=
    (ofReal_integral_eq_lintegral_ofReal hGrU
      (ae_of_all _ fun x => Finset.sum_nonneg fun a _ => sq_nonneg _)).symm
  have hI0 : 0 ≤ ∫ x in U, v x ^ 2 := integral_nonneg fun x => sq_nonneg _
  have hJ0 : 0 ≤ ∫ x in W, v x ^ 2 := integral_nonneg fun x => sq_nonneg _
  have hE0 : 0 ≤ ∫ x in U, ∑ a : Fin 3, (partialDeriv a v x) ^ 2 :=
    integral_nonneg fun x => Finset.sum_nonneg fun a _ => sq_nonneg _
  
  have hS1 : ∫⁻ x in U, ∫⁻ y in U, ENNReal.ofReal ((v x - v y) ^ 2) ≤
      ENNReal.ofReal (4 * R ^ 2) * (8 * MeasureTheory.volume U *
        ∫⁻ z in U, ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v z) ^ 2)) := by
    calc ∫⁻ x in U, ∫⁻ y in U, ENNReal.ofReal ((v x - v y) ^ 2)
        ≤ ∫⁻ x in U, ∫⁻ y in U, ENNReal.ofReal (4 * R ^ 2) * ∫⁻ t in Set.Icc (0 : ℝ) 1,
            ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v (y + t • (x - y))) ^ 2) := by
          refine setLIntegral_mono' hU fun x hx => ?_
          refine setLIntegral_mono' hU fun y hy => ?_
          exact c3 x y (hUR hx) (hUR hy)
      _ = ENNReal.ofReal (4 * R ^ 2) * ∫⁻ x in U, ∫⁻ y in U, ∫⁻ t in Set.Icc (0 : ℝ) 1,
            ENNReal.ofReal (∑ a : Fin 3, (partialDeriv a v (y + t • (x - y))) ^ 2) := by
          simp_rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      _ ≤ _ := mul_le_mul_left' (c2 U hU hUc _ hGm) _
  
  have hS2 := c4 U W v hWU hvW
  have hcomb := hS2.trans (add_le_add le_rfl (mul_le_mul_left' hS1 2))
  clear c1 c2 c3 c4
  rw [hI, hJ, hE, ← ENNReal.ofReal_toReal hUfin, ← ENNReal.ofReal_toReal hWfin] at hcomb
  set u := (MeasureTheory.volume U).toReal with hu
  set w := (MeasureTheory.volume W).toReal with hw
  have hu0 : 0 ≤ u := ENNReal.toReal_nonneg
  have hw0 : 0 ≤ w := ENNReal.toReal_nonneg
  set I := ∫ x in U, v x ^ 2
  set J := ∫ x in W, v x ^ 2
  set E := ∫ x in U, ∑ a : Fin 3, (partialDeriv a v x) ^ 2
  have hrhs : (2 : ENNReal) * ENNReal.ofReal u * ENNReal.ofReal J +
      2 * (ENNReal.ofReal (4 * R ^ 2) * (8 * ENNReal.ofReal u * ENNReal.ofReal E)) =
      ENNReal.ofReal (2 * u * (J + 32 * R ^ 2 * E)) := by
    rw [show (2 : ENNReal) = ENNReal.ofReal 2 by simp,
      show (8 : ENNReal) = ENNReal.ofReal 8 by simp]
    rw [← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (by norm_num), ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by norm_num),
      ← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 1
    ring
  rw [hrhs, ← ENNReal.ofReal_mul hw0] at hcomb
  exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 hcomb

theorem half_ball_dirichlet (c : E3) (r : ℝ) (hr : 0 < r) (hc : c 0 = 0) (v : E3 → ℝ)
    (hv : ContDiffOn ℝ ∞ v (Metric.ball c r)) (O : Set E3) (hO : IsOpen O)
    (hface : {x ∈ Metric.ball c r | x 0 = 0} ⊆ O) (hvO : ∀ x ∈ O, v x = 0) :
    ∫ x in ndsHalf c r, v x ^ 2 ≤
      1024 * r ^ 2 * ∫ x in ndsHalf c r, ∑ a : Fin 3, (partialDeriv a v x) ^ 2 :=
by
  classical
  set S : Set E3 := {x : E3 | 0 < x 0} with hSdef
  have hproj : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hSo : IsOpen S := isOpen_lt continuous_const hproj
  have hNo : IsOpen {x : E3 | x 0 < 0} := isOpen_lt hproj continuous_const
  set vt : E3 → ℝ := S.indicator v with hvt
  
  have hgerm : ∀ x ∈ Metric.ball c r,
      (vt =ᶠ[𝓝 x] v ∧ 0 < x 0) ∨ (vt =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) ∧ x 0 ≤ 0) := by
    intro x hx
    rcases lt_trichotomy (x 0) 0 with h | h | h
    · right
      refine ⟨Filter.eventually_of_mem (hNo.mem_nhds h) (fun y hy => ?_), h.le⟩
      have hyS : y ∉ S := by
        intro hyS
        have h1 : 0 < y 0 := hyS
        have h2 : y 0 < 0 := hy
        linarith
      show S.indicator v y = 0
      rw [Set.indicator_of_notMem hyS]
    · right
      have hxO : x ∈ O := hface ⟨hx, h⟩
      refine ⟨Filter.eventually_of_mem (hO.mem_nhds hxO) (fun y hy => ?_), h.le⟩
      show S.indicator v y = 0
      by_cases hyS : y ∈ S
      · rw [Set.indicator_of_mem hyS, hvO y hy]
      · rw [Set.indicator_of_notMem hyS]
    · left
      refine ⟨Filter.eventually_of_mem (hSo.mem_nhds h) (fun y hy => ?_), h⟩
      show S.indicator v y = v y
      rw [Set.indicator_of_mem hy]
  have hvts : ContDiffOn ℝ ∞ vt (Metric.ball c r) := by
    intro x hx
    rcases hgerm x hx with ⟨hev, _⟩ | ⟨hev, _⟩
    · exact ((hv.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).congr_of_eventuallyEq
        hev).contDiffWithinAt
    · exact (contDiffAt_const.congr_of_eventuallyEq hev).contDiffWithinAt
  have hpd : ∀ x ∈ Metric.ball c r, ∀ a : Fin 3,
      partialDeriv a vt x = S.indicator (partialDeriv a v) x := by
    intro x hx a
    rcases hgerm x hx with ⟨hev, hx0⟩ | ⟨hev, hx0⟩
    · have hxS : x ∈ S := hx0
      rw [Set.indicator_of_mem hxS]
      show fderiv ℝ vt x (e a) = fderiv ℝ v x (e a)
      rw [hev.fderiv_eq]
    · have hxS : x ∉ S := by
        intro h
        have h1 : 0 < x 0 := h
        linarith
      rw [Set.indicator_of_notMem hxS]
      show fderiv ℝ vt x (e a) = 0
      rw [hev.fderiv_eq, fderiv_const_apply]
      rfl
  
  set w : E3 := c - (r / 4) • e 0 with hw
  have hw0 : w 0 = -(r / 4) := by
    simp [hw, hc]
  have hwc : dist w c = r / 4 := by
    have h1 : w - c = -((r / 4) • e 0) := by rw [hw]; abel
    rw [dist_eq_norm, h1, norm_neg, norm_smul]
    simp [abs_of_pos hr]
  have hWU : Metric.closedBall w (r / 8) ⊆ Metric.ball c (r / 2) := by
    intro z hz
    rw [Metric.mem_closedBall] at hz
    rw [Metric.mem_ball]
    have := dist_triangle z w c
    linarith
  have hWS : ∀ z ∈ Metric.closedBall w (r / 8), z ∉ S := by
    intro z hz hzS
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have h1 : |(z - w) 0| ≤ ‖z - w‖ := by
      have := PiLp.norm_apply_le (z - w) 0
      simpa [Real.norm_eq_abs] using this
    have h2 : (z - w) 0 = z 0 - w 0 := by simp
    have h3 : (z - w) 0 ≤ |(z - w) 0| := le_abs_self _
    have hz0 : 0 < z 0 := hzS
    linarith
  
  have hanchor := convex_anchor_poincare (Metric.ball c (r / 2)) (Metric.closedBall w (r / 8))
    (Metric.ball c r) c (r / 2) vt measurableSet_ball (convex_ball c (r / 2))
    Metric.ball_subset_closedBall Metric.isOpen_ball
    (Metric.closedBall_subset_ball (by linarith)) measurableSet_closedBall hWU hvts
  have hW0 : ∫ x in Metric.closedBall w (r / 8), vt x ^ 2 = 0 := by
    refine setIntegral_eq_zero_of_forall_eq_zero (fun z hz => ?_)
    show S.indicator v z ^ 2 = 0
    rw [Set.indicator_of_notMem (hWS z hz)]
    ring
  have hI : ∫ x in Metric.ball c (r / 2), vt x ^ 2 = ∫ x in ndsHalf c r, v x ^ 2 := by
    have h1 : (fun x => vt x ^ 2) = S.indicator (fun y => v y ^ 2) := by
      funext x
      show S.indicator v x ^ 2 = S.indicator (fun y => v y ^ 2) x
      by_cases hx : x ∈ S
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
      · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
        ring
    rw [h1, setIntegral_indicator hSo.measurableSet]
    rfl
  have hE : ∫ x in Metric.ball c (r / 2), ∑ a : Fin 3, (partialDeriv a vt x) ^ 2 =
      ∫ x in ndsHalf c r, ∑ a : Fin 3, (partialDeriv a v x) ^ 2 := by
    rw [setIntegral_congr_fun measurableSet_ball
      (g := S.indicator (fun y => ∑ a : Fin 3, (partialDeriv a v y) ^ 2))]
    · rw [setIntegral_indicator hSo.measurableSet]
      rfl
    · intro x hx
      have hxB : x ∈ Metric.ball c r := Metric.ball_subset_ball (by linarith) hx
      show ∑ a : Fin 3, (partialDeriv a vt x) ^ 2 =
        S.indicator (fun y => ∑ a : Fin 3, (partialDeriv a v y) ^ 2) x
      simp only [hpd x hxB]
      by_cases hxS : x ∈ S
      · simp only [Set.indicator_of_mem hxS]
      · simp only [Set.indicator_of_notMem hxS]
        simp
  
  have hfin : Module.finrank ℝ E3 = 3 := finrank_euclideanSpace_fin
  have hvolU : (volume (Metric.ball c (r / 2))).toReal =
      (r / 2) ^ 3 * (volume (Metric.ball (0 : E3) 1)).toReal := by
    rw [Measure.addHaar_ball volume c (by linarith : (0 : ℝ) ≤ r / 2), hfin,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  have hvolW : (volume (Metric.closedBall w (r / 8))).toReal =
      (r / 8) ^ 3 * (volume (Metric.ball (0 : E3) 1)).toReal := by
    rw [Measure.addHaar_closedBall volume w (by linarith : (0 : ℝ) ≤ r / 8), hfin,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
  have hWpos : 0 < (volume (Metric.closedBall w (r / 8))).toReal :=
    ENNReal.toReal_pos (measure_closedBall_pos volume w (by linarith)).ne'
      measure_closedBall_lt_top.ne
  rw [hW0, hI, hE, zero_add] at hanchor
  have key : (volume (Metric.closedBall w (r / 8))).toReal * ∫ x in ndsHalf c r, v x ^ 2 ≤
      (volume (Metric.closedBall w (r / 8))).toReal *
        (1024 * r ^ 2 * ∫ x in ndsHalf c r, ∑ a : Fin 3, (partialDeriv a v x) ^ 2) := by
    refine hanchor.trans (le_of_eq ?_)
    rw [hvolU, hvolW]
    ring
  exact le_of_mul_le_mul_left key hWpos

theorem nds_chart_chain [IsManifold 𝓘(ℝ, E3) ∞ M] {β : M → ℝ} {Ω₀ S₀ : Set M}
    (A : NdsAtlas M β Ω₀ S₀) (hconn : IsPreconnected Ω₀) (hS : ∃ q ∈ S₀, q ∈ Ω₀) :
    ∃ j₀ : Fin A.n, A.D j₀ ∧ ∀ k : Fin A.n, Relation.ReflTransGen
      (fun j' k' : Fin A.n => ∃ y : E3, ∃ ρ : ℝ, 0 < ρ ∧
        Metric.closedBall y ρ ⊆ ndsHalf (A.c k') (A.r k') ∧
        ∀ z ∈ Metric.closedBall y ρ, A.κ k' z ∈ A.κ j' '' ndsHalf (A.c j') (A.r j')) j₀ k :=
by
  classical
  have hsrc : ∀ j, (A.κ j).source = Metric.ball (A.c j) (A.r j) := A.source_eq
  have hB8 : ∀ j, Metric.ball (A.c j) (A.r j / 8) ⊆ Metric.ball (A.c j) (A.r j) :=
    fun j => Metric.ball_subset_ball (by linarith [A.r_pos j])
  have hB82 : ∀ j, Metric.ball (A.c j) (A.r j / 8) ⊆ Metric.ball (A.c j) (A.r j / 2) :=
    fun j => Metric.ball_subset_ball (by linarith [A.r_pos j])
  have hB2 : ∀ j, Metric.ball (A.c j) (A.r j / 2) ⊆ Metric.ball (A.c j) (A.r j) :=
    fun j => Metric.ball_subset_ball (by linarith [A.r_pos j])
  
  have hOpn : ∀ j (U : Set E3), IsOpen U → U ⊆ Metric.ball (A.c j) (A.r j) →
      IsOpen (A.κ j '' U) := by
    intro j U hU hsub
    have hsub' : U ⊆ (A.κ j).source := by rw [hsrc j]; exact hsub
    exact (A.κ j).toOpenPartialHomeomorph.isOpen_image_of_subset_source hU hsub'
  
  have hCts : ∀ j, ContinuousOn (A.κ j) (Metric.ball (A.c j) (A.r j)) := by
    intro j
    have h := (A.κ j).contMDiffOn.continuousOn
    rw [hsrc j] at h
    exact h
  
  have hπ : Continuous (fun w : E3 => w 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hcrd : ∀ z w : E3, |z 0 - w 0| ≤ dist z w := by
    intro z w
    rw [dist_eq_norm]
    have h := PiLp.norm_apply_le (z - w) 0
    simpa [Real.norm_eq_abs] using h
  have hshift : ∀ (y : E3) (s : ℝ), (y + s • e 0) 0 = y 0 + s ∧
      dist (y + s • e 0) y = |s| := by
    intro y s
    constructor
    · simp [e, EuclideanSpace.single_apply]
    · rw [dist_eq_norm, add_sub_cancel_left]
      simp [e, norm_smul, EuclideanSpace.norm_single]
  
  have hface : ∀ (a b : Fin A.n) (x y : E3), x ∈ Metric.ball (A.c a) (A.r a) →
      y ∈ Metric.ball (A.c b) (A.r b) → A.κ a x = A.κ b y → 0 < x 0 → 0 < y 0 := by
    intro a b x y hx hy hxy hx0
    by_contra hy0
    push_neg at hy0
    have hUo : IsOpen (Metric.ball (A.c a) (A.r a) ∩ {w : E3 | 0 < w 0}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hπ)
    have hT : IsOpen (A.κ a '' (Metric.ball (A.c a) (A.r a) ∩ {w : E3 | 0 < w 0})) :=
      hOpn a _ hUo Set.inter_subset_left
    have hS := (hCts b).isOpen_inter_preimage Metric.isOpen_ball hT
    have hyS : y ∈ Metric.ball (A.c b) (A.r b) ∩
        A.κ b ⁻¹' (A.κ a '' (Metric.ball (A.c a) (A.r a) ∩ {w : E3 | 0 < w 0})) :=
      ⟨hy, ⟨x, ⟨hx, hx0⟩, hxy⟩⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hS y hyS
    have hz := hshift y (-(ε / 2))
    have hzS := hball (show y + (-(ε / 2)) • e 0 ∈ Metric.ball y ε by
      rw [Metric.mem_ball, hz.2, abs_neg, abs_of_pos (by linarith)]
      linarith)
    obtain ⟨hzB, w, ⟨hwB, hw0⟩, hwz⟩ := hzS
    have hΩ : A.κ b (y + (-(ε / 2)) • e 0) ∈ Ω₀ := by
      rw [← hwz]
      exact (A.dom a w hwB).2 (show 0 < w 0 from hw0).le
    have h := (A.dom b _ hzB).1 hΩ
    rw [hz.1] at h
    linarith
  
  have hcover : ∀ q ∈ Ω₀, ∃ j : Fin A.n, ∃ x ∈ Metric.ball (A.c j) (A.r j / 8),
      A.κ j x = q := by
    intro q hq
    have hne : ∑ j, A.ψ j q ≠ 0 := by rw [A.ψ_sum q hq]; exact one_ne_zero
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    have hq' : q ∈ tsupport (A.ψ j) := subset_tsupport _ hj
    obtain ⟨x, hx, hxq⟩ := (A.ψ_supp j).2 hq'
    exact ⟨j, x, hx, hxq⟩
  
  have hlink : ∀ (j k : Fin A.n) (y : E3), y ∈ Metric.ball (A.c k) (A.r k / 8) → 0 ≤ y 0 →
      A.κ k y ∈ A.κ j '' Metric.ball (A.c j) (A.r j / 2) →
      ∃ y' : E3, ∃ ρ : ℝ, 0 < ρ ∧ Metric.closedBall y' ρ ⊆ ndsHalf (A.c k) (A.r k) ∧
        ∀ z ∈ Metric.closedBall y' ρ, A.κ k z ∈ A.κ j '' ndsHalf (A.c j) (A.r j) := by
    intro j k y hy hy0 hyT
    have hrk := A.r_pos k
    have hT : IsOpen (A.κ j '' Metric.ball (A.c j) (A.r j / 2)) :=
      hOpn j _ Metric.isOpen_ball (hB2 j)
    have hS := (hCts k).isOpen_inter_preimage Metric.isOpen_ball hT
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hS y ⟨hB8 k hy, hyT⟩
    obtain ⟨ε', hε'def⟩ : ∃ ε' : ℝ, ε' = min ε (A.r k / 8) := ⟨_, rfl⟩
    have hε'0 : 0 < ε' := by rw [hε'def]; exact lt_min hε (by linarith)
    have hε'1 : ε' ≤ ε := by rw [hε'def]; exact min_le_left _ _
    have hε'2 : ε' ≤ A.r k / 8 := by rw [hε'def]; exact min_le_right _ _
    have hy' := hshift y (ε' / 2)
    have hyc : dist y (A.c k) < A.r k / 8 := hy
    have key : ∀ z ∈ Metric.closedBall (y + (ε' / 2) • e 0) (ε' / 8),
        z ∈ ndsHalf (A.c k) (A.r k) ∧ z ∈ Metric.ball y ε := by
      intro z hz
      rw [Metric.mem_closedBall] at hz
      have h1 : dist z y < ε' := by
        have h := dist_triangle z (y + (ε' / 2) • e 0) y
        rw [hy'.2, abs_of_pos (by linarith)] at h
        linarith
      have h2 : dist z (A.c k) < A.r k / 2 := by
        have h := dist_triangle z y (A.c k)
        linarith
      have h3 : 0 < z 0 := by
        have h := hcrd z (y + (ε' / 2) • e 0)
        rw [hy'.1] at h
        have h' := (abs_le.mp (h.trans hz)).1
        linarith
      refine ⟨(⟨h2, h3⟩ : z ∈ Metric.ball (A.c k) (A.r k / 2) ∩ {x : E3 | 0 < x 0}), ?_⟩
      rw [Metric.mem_ball]
      linarith
    refine ⟨y + (ε' / 2) • e 0, ε' / 8, by linarith, fun z hz => (key z hz).1, ?_⟩
    intro z hz
    obtain ⟨hzH, hzb⟩ := key z hz
    have hzH' : z ∈ Metric.ball (A.c k) (A.r k / 2) ∧ 0 < z 0 := hzH
    obtain ⟨_, x', hx'B, hx'eq⟩ := hball hzb
    have hx'0 : 0 < x' 0 := hface k j z x' (hB2 k hzH'.1) (hB2 j hx'B) hx'eq.symm hzH'.2
    exact ⟨x', (⟨hx'B, hx'0⟩ : x' ∈ Metric.ball (A.c j) (A.r j / 2) ∩ {x : E3 | 0 < x 0}),
      hx'eq⟩
  
  obtain ⟨q, hqS, hqΩ⟩ := hS
  obtain ⟨j₀, x₀, hx₀, hx₀q⟩ := hcover q hqΩ
  have hD₀ : A.D j₀ := ((A.dir j₀ x₀ (hB8 j₀ hx₀)).1 (by rw [hx₀q]; exact hqS)).1
  refine ⟨j₀, hD₀, ?_⟩
  
  intro k₁
  by_contra hk₁
  let Re : Set (Fin A.n) := {k | Relation.ReflTransGen
      (fun j' k' : Fin A.n => ∃ y : E3, ∃ ρ : ℝ, 0 < ρ ∧
        Metric.closedBall y ρ ⊆ ndsHalf (A.c k') (A.r k') ∧
        ∀ z ∈ Metric.closedBall y ρ, A.κ k' z ∈ A.κ j' '' ndsHalf (A.c j') (A.r j')) j₀ k}
  let P : Set M := ⋃ j ∈ Re, A.κ j '' Metric.ball (A.c j) (A.r j / 8)
  let Q : Set M := ⋃ j ∈ Reᶜ, A.κ j '' Metric.ball (A.c j) (A.r j / 8)
  have hP : IsOpen P := isOpen_biUnion (fun j _ => hOpn j _ Metric.isOpen_ball (hB8 j))
  have hQ : IsOpen Q := isOpen_biUnion (fun j _ => hOpn j _ Metric.isOpen_ball (hB8 j))
  have hcov : Ω₀ ⊆ P ∪ Q := by
    intro q' hq'
    obtain ⟨j, x, hx, hxq⟩ := hcover q' hq'
    by_cases hj : j ∈ Re
    · exact Or.inl (Set.mem_iUnion₂.mpr ⟨j, hj, x, hx, hxq⟩)
    · exact Or.inr (Set.mem_iUnion₂.mpr ⟨j, hj, x, hx, hxq⟩)
  have hPn : (Ω₀ ∩ P).Nonempty :=
    ⟨q, hqΩ, Set.mem_iUnion₂.mpr ⟨j₀, Relation.ReflTransGen.refl, x₀, hx₀, hx₀q⟩⟩
  have hc0 : 0 ≤ A.c k₁ 0 := by
    rcases A.center k₁ with h | h
    · rw [h]
    · linarith [A.r_pos k₁]
  have hcm : A.c k₁ ∈ Metric.ball (A.c k₁) (A.r k₁ / 8) :=
    Metric.mem_ball_self (by linarith [A.r_pos k₁])
  have hQn : (Ω₀ ∩ Q).Nonempty :=
    ⟨A.κ k₁ (A.c k₁), (A.dom k₁ _ (hB8 k₁ hcm)).2 hc0,
      Set.mem_iUnion₂.mpr ⟨k₁, hk₁, A.c k₁, hcm, rfl⟩⟩
  obtain ⟨q', hq'Ω, hq'P, hq'Q⟩ := hconn P Q hP hQ hcov hPn hQn
  obtain ⟨j, hj, x, hx, hxq⟩ := Set.mem_iUnion₂.mp hq'P
  obtain ⟨k, hk, y, hy, hyq⟩ := Set.mem_iUnion₂.mp hq'Q
  have hy0 : 0 ≤ y 0 := (A.dom k y (hB8 k hy)).1 (by rw [hyq]; exact hq'Ω)
  have hyT : A.κ k y ∈ A.κ j '' Metric.ball (A.c j) (A.r j / 2) :=
    ⟨x, hB82 j hx, by rw [hxq, hyq]⟩
  exact hk (Relation.ReflTransGen.tail hj (hlink j k y hy hy0 hyT))

theorem nds_chart_transfer [IsManifold 𝓘(ℝ, E3) ∞ M]
    (κ κ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3) (ρ : ℝ) (V : Set E3)
    (hV : MeasurableSet V) (hVs : V ⊆ κ'.source)
    (hWs : Metric.closedBall y ρ ⊆ κ.source)
    (hWV : ∀ z ∈ Metric.closedBall y ρ, κ z ∈ κ' '' V) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : M → ℝ, Continuous h → IntegrableOn (fun x => h (κ' x) ^ 2) V →
      ∫ z in Metric.closedBall y ρ, h (κ z) ^ 2 ≤ C * ∫ x in V, h (κ' x) ^ 2 :=
by
  classical
  
  have hκ_ms : ∀ z ∈ κ.source, κ z ∈ κ.target := fun z hz => κ.toPartialEquiv.map_source hz
  have hκ_li : ∀ z ∈ κ.source, κ.symm (κ z) = z := fun z hz => κ.toPartialEquiv.left_inv hz
  have hκ_ri : ∀ p ∈ κ.target, κ (κ.symm p) = p := fun p hp => κ.toPartialEquiv.right_inv hp
  have hκ'_ms : ∀ z ∈ κ'.source, κ' z ∈ κ'.target := fun z hz => κ'.toPartialEquiv.map_source hz
  have hκ'_li : ∀ z ∈ κ'.source, κ'.symm (κ' z) = z := fun z hz => κ'.toPartialEquiv.left_inv hz
  have hκ'_inj : Set.InjOn κ' κ'.source := κ'.toPartialEquiv.injOn
  
  obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, ∀ x, τ x = κ.symm (κ' x) := ⟨_, fun _ => rfl⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : E3 → E3, ∀ z, σ z = κ'.symm (κ z) := ⟨_, fun _ => rfl⟩
  have hO : IsOpen (κ'.source ∩ κ' ⁻¹' κ.target) :=
    κ'.contMDiffOn.continuousOn.isOpen_inter_preimage κ'.open_source κ.open_target
  have hτs : ContDiffOn ℝ ∞ τ (κ'.source ∩ κ' ⁻¹' κ.target) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (κ.symm ∘ κ') (κ'.source ∩ κ' ⁻¹' κ.target) := by
      refine κ.symm.contMDiffOn.comp (κ'.contMDiffOn.mono Set.inter_subset_left) ?_
      intro x hx
      exact hx.2
    exact (contMDiffOn_iff_contDiffOn.mp h1).congr (fun x _ => hτ x)
  have hσc : ContinuousOn σ (Metric.closedBall y ρ) := by
    have h1 : ContinuousOn (fun z => κ'.symm (κ z)) (Metric.closedBall y ρ) := by
      refine κ'.symm.contMDiffOn.continuousOn.comp (κ.contMDiffOn.continuousOn.mono hWs) ?_
      intro z hz
      obtain ⟨x₀, hx₀V, hx₀⟩ := hWV z hz
      show κ z ∈ κ'.target
      rw [← hx₀]
      exact hκ'_ms x₀ (hVs hx₀V)
    exact h1.congr (fun z _ => hσ z)
  have hkey : ∀ z ∈ Metric.closedBall y ρ, σ z ∈ V ∧ κ' (σ z) = κ z ∧ τ (σ z) = z := by
    intro z hz
    obtain ⟨x₀, hx₀V, hx₀⟩ := hWV z hz
    have hx₀s := hVs hx₀V
    have h1 : σ z = x₀ := by
      rw [hσ, ← hx₀]
      exact hκ'_li x₀ hx₀s
    have h2 : κ' (σ z) = κ z := by rw [h1, hx₀]
    refine ⟨by rw [h1]; exact hx₀V, h2, ?_⟩
    rw [hτ, h2]
    exact hκ_li z (hWs hz)
  obtain ⟨S, hSdef⟩ : ∃ S : Set E3, S = σ '' Metric.closedBall y ρ := ⟨_, rfl⟩
  have hScpt : IsCompact S := by
    rw [hSdef]
    exact (isCompact_closedBall y ρ).image_of_continuousOn hσc
  have hSV : S ⊆ V := by
    rw [hSdef]
    rintro _ ⟨z, hz, rfl⟩
    exact (hkey z hz).1
  have hSO : S ⊆ κ'.source ∩ κ' ⁻¹' κ.target := by
    rw [hSdef]
    rintro _ ⟨z, hz, rfl⟩
    refine ⟨hVs (hkey z hz).1, ?_⟩
    show κ' (σ z) ∈ κ.target
    rw [(hkey z hz).2.1]
    exact hκ_ms z (hWs hz)
  have hκτ : ∀ x ∈ S, κ (τ x) = κ' x := by
    intro x hx
    rw [hτ]
    exact hκ_ri _ (hSO hx).2
  have himg : τ '' S = Metric.closedBall y ρ := by
    rw [hSdef]
    ext z
    constructor
    · rintro ⟨_, ⟨w, hw, rfl⟩, rfl⟩
      rw [(hkey w hw).2.2]
      exact hw
    · intro hz
      exact ⟨σ z, ⟨z, hz, rfl⟩, (hkey z hz).2.2⟩
  have hinj : Set.InjOn τ S := by
    intro x₁ h₁ x₂ h₂ he
    apply hκ'_inj (hVs (hSV h₁)) (hVs (hSV h₂))
    rw [← hκτ x₁ h₁, ← hκτ x₂ h₂, he]
  
  have hfc : ContinuousOn (fun x => fderiv ℝ τ x) (κ'.source ∩ κ' ⁻¹' κ.target) :=
    hτs.continuousOn_fderiv_of_isOpen hO (by simp)
  have hdc : ContinuousOn (fun x => |(fderiv ℝ τ x).det|) S :=
    ((ContinuousLinearMap.continuous_det.comp_continuousOn hfc).abs).mono hSO
  obtain ⟨B₀, hB₀⟩ := hScpt.exists_bound_of_continuousOn hdc
  have hB : ∀ x ∈ S, |(fderiv ℝ τ x).det| ≤ max 0 B₀ := by
    intro x hx
    have h1 := hB₀ x hx
    simp only [Real.norm_eq_abs, abs_abs] at h1
    exact h1.trans (le_max_right _ _)
  have hdiff : DifferentiableOn ℝ τ (κ'.source ∩ κ' ⁻¹' κ.target) := hτs.differentiableOn (by simp)
  have hder : ∀ x ∈ S, HasFDerivWithinAt τ (fderiv ℝ τ x) S x := fun x hx =>
    ((hdiff x (hSO hx)).differentiableAt (hO.mem_nhds (hSO hx))).hasFDerivAt.hasFDerivWithinAt
  have hSm : MeasurableSet S := hScpt.measurableSet
  refine ⟨max 0 B₀, le_max_left _ _, ?_⟩
  intro h _ hint
  have hcov := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hSm hder hinj
    (fun z => h (κ z) ^ 2)
  have hid : ∀ x ∈ S, h (κ (τ x)) ^ 2 = h (κ' x) ^ 2 := fun x hx => by rw [hκτ x hx]
  have hintS : IntegrableOn (fun x => h (κ' x) ^ 2) S := hint.mono_set hSV
  calc ∫ z in Metric.closedBall y ρ, h (κ z) ^ 2
      = ∫ z in τ '' S, h (κ z) ^ 2 := by rw [himg]
    _ = ∫ x in S, |(fderiv ℝ τ x).det| • h (κ (τ x)) ^ 2 := hcov
    _ = ∫ x in S, |(fderiv ℝ τ x).det| * h (κ' x) ^ 2 := by
        refine setIntegral_congr_fun hSm (fun x hx => ?_)
        simp only [smul_eq_mul, hid x hx]
    _ ≤ ∫ x in S, max 0 B₀ * h (κ' x) ^ 2 := by
        refine integral_mono_of_nonneg ?_ (Integrable.const_mul hintS _) ?_
        · exact ae_restrict_of_forall_mem hSm
            (fun x _ => mul_nonneg (abs_nonneg _) (sq_nonneg _))
        · exact ae_restrict_of_forall_mem hSm
            (fun x hx => mul_le_mul_of_nonneg_right (hB x hx) (sq_nonneg _))
    _ = max 0 B₀ * ∫ x in S, h (κ' x) ^ 2 := integral_const_mul _ _
    _ ≤ max 0 B₀ * ∫ x in V, h (κ' x) ^ 2 := by
        refine mul_le_mul_of_nonneg_left ?_ (le_max_left _ _)
        exact setIntegral_mono_set hint (ae_of_all _ (fun x => sq_nonneg _)) hSV.eventuallyLE

theorem nds_int_localize [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    {β : M → ℝ} {Ω₀ S₀ : Set M} (A : NdsAtlas M β Ω₀ S₀) (F : M → ℝ)
    (hF : ∀ j, ContinuousOn (fun x => F (A.κ j x)) (Metric.ball (A.c j) (A.r j))) (k : Fin A.n) :
    ((∀ q ∈ Ω₀, 0 ≤ F q) →
      ∫ x in ndsHalf (A.c k) (A.r k), F (A.κ k x) * Real.sqrt (g.coeff (A.κ k) x).det
        ≤ ndsInt g A F) ∧
    ((∀ q ∈ Ω₀, q ∉ A.κ k '' Metric.ball (A.c k) (A.r k / 2) → F q = 0) →
      ∫ x in ndsHalf (A.c k) (A.r k), F (A.κ k x) * Real.sqrt (g.coeff (A.κ k) x).det
        = ndsInt g A F) :=
by
  classical
  
  have hHB : ∀ a : Fin A.n, MeasurableSet (ndsHalf (A.c a) (A.r a)) ∧
      ndsHalf (A.c a) (A.r a) ⊆ Metric.ball (A.c a) (A.r a) ∧
      ∀ G : E3 → ℝ, ContinuousOn G (Metric.ball (A.c a) (A.r a)) →
        MemLp G 2 (volume.restrict (ndsHalf (A.c a) (A.r a))) ∧
          IntegrableOn G (ndsHalf (A.c a) (A.r a)) :=
    fun a => nds_half_basic (A.c a) (A.r a) (A.r_pos a)
  
  have hdom : ∀ a : Fin A.n, ∀ x ∈ ndsHalf (A.c a) (A.r a), A.κ a x ∈ Ω₀ := by
    intro a x hx
    exact (A.dom a x ((hHB a).2.1 hx)).2 (le_of_lt hx.2)
  
  have hmc : ∀ a : Fin A.n, ContinuousOn (fun x => Real.sqrt (g.coeff (A.κ a) x).det)
      (Metric.ball (A.c a) (A.r a)) := by
    intro a
    rw [← A.source_eq a]
    exact (nds_chart_cont g (A.κ a) (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ))
      contMDiff_const contMDiff_const).2.2.2.1
  have hψc : ∀ a b : Fin A.n, ContinuousOn (fun x => A.ψ a (A.κ b x))
      (Metric.ball (A.c b) (A.r b)) := by
    intro a b
    rw [← A.source_eq b]
    exact (A.ψ_smooth a).continuous.comp_continuousOn (A.κ b).contMDiffOn.continuousOn
  have hint : ∀ a b : Fin A.n, IntegrableOn
      (fun x => A.ψ a (A.κ b x) * F (A.κ b x) * Real.sqrt (g.coeff (A.κ b) x).det)
      (ndsHalf (A.c b) (A.r b)) := by
    intro a b
    exact ((hHB b).2.2 _ (((hψc a b).mul (hF b)).mul (hmc b))).2
  
  
  have hface : ∀ (a b : Fin A.n) (x y : E3), x ∈ Metric.ball (A.c a) (A.r a) →
      y ∈ Metric.ball (A.c b) (A.r b) → A.κ a x = A.κ b y → 0 < x 0 → 0 < y 0 := by
    intro a b x y hx hy hxy hx0
    have hproj : Continuous (fun z : E3 => z 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
    have hUo : IsOpen (Metric.ball (A.c a) (A.r a) ∩ {z : E3 | 0 < z 0}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hproj)
    have hUs : Metric.ball (A.c a) (A.r a) ∩ {z : E3 | 0 < z 0} ⊆ (A.κ a).source := by
      rw [A.source_eq a]; exact Set.inter_subset_left
    have hIo : IsOpen (A.κ a '' (Metric.ball (A.c a) (A.r a) ∩ {z : E3 | 0 < z 0})) :=
      (A.κ a).toOpenPartialHomeomorph.isOpen_image_of_subset_source hUo hUs
    have hIsub : A.κ a '' (Metric.ball (A.c a) (A.r a) ∩ {z : E3 | 0 < z 0}) ⊆ Ω₀ := by
      rintro _ ⟨z, hz, rfl⟩
      exact (A.dom a z hz.1).2 (le_of_lt hz.2)
    have hp : A.κ b y ∈ interior Ω₀ := by
      rw [← hxy]
      exact interior_maximal hIsub hIo ⟨x, ⟨hx, hx0⟩, rfl⟩
    have hbc : ContinuousOn (A.κ b) (Metric.ball (A.c b) (A.r b)) := by
      rw [← A.source_eq b]; exact (A.κ b).contMDiffOn.continuousOn
    have hW : IsOpen (Metric.ball (A.c b) (A.r b) ∩ A.κ b ⁻¹' interior Ω₀) :=
      hbc.isOpen_inter_preimage Metric.isOpen_ball isOpen_interior
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hW y ⟨hy, hp⟩
    by_contra hneg
    push_neg at hneg
    have hy' : y - (ε / 2) • e 0 ∈ Metric.ball y ε := by
      rw [Metric.mem_ball, dist_eq_norm, sub_sub_cancel_left, norm_neg, norm_smul,
        EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_pos (by positivity)]
      linarith
    obtain ⟨h1, h2⟩ := hball hy'
    have h3 := (A.dom b _ h1).1 (interior_subset h2)
    have h4 : (y - (ε / 2) • e 0) 0 = y 0 - ε / 2 := by simp
    rw [h4] at h3
    linarith
  
  have hs2 : ∀ (κ κ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (x : E3), x ∈ κ.source →
      κ x ∈ κ'.target →
      DifferentiableAt ℝ (fun z => κ'.symm (κ z)) x ∧
      Real.sqrt (g.coeff κ x).det =
        |(fderiv ℝ (fun z => κ'.symm (κ z)) x).det| *
          Real.sqrt (g.coeff κ' (κ'.symm (κ x))).det := by
    intro κ κ' x hx hxt
    have hκx : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ κ x :=
      κ.contMDiffOn.contMDiffAt (κ.open_source.mem_nhds hx)
    have hκ's : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ κ'.symm (κ x) :=
      κ'.symm.contMDiffOn.contMDiffAt (κ'.symm.open_source.mem_nhds (by exact hxt))
    have hσ : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun z => κ'.symm (κ z)) x := hκ's.comp x hκx
    have hσd : DifferentiableAt ℝ (fun z => κ'.symm (κ z)) x :=
      mdifferentiableAt_iff_differentiableAt.mp (hσ.mdifferentiableAt (by simp))
    have hσx : κ'.symm (κ x) ∈ κ'.source := κ'.toPartialEquiv.map_target hxt
    have hκ'm : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ' (κ'.symm (κ x)) :=
      (κ'.contMDiffOn.contMDiffAt (κ'.open_source.mem_nhds hσx)).mdifferentiableAt (by simp)
    have hev : (⇑κ' ∘ fun z => κ'.symm (κ z)) =ᶠ[𝓝 x] ⇑κ := by
      have hN : κ.source ∩ κ ⁻¹' κ'.target ∈ 𝓝 x :=
        (κ.contMDiffOn.continuousOn.isOpen_inter_preimage κ.open_source
          κ'.open_target).mem_nhds ⟨hx, hxt⟩
      filter_upwards [hN] with z hz
      exact κ'.toPartialEquiv.right_inv hz.2
    have hcoeq : ∀ i j : Fin 3, g.coeff κ x i j =
        g.coeff (⇑κ' ∘ fun z => κ'.symm (κ z)) x i j := by
      intro i j
      unfold RiemannianMetric3.coeff coeffMatrix
      rw [hev.mfderiv_eq, hev.eq_of_nhds]
    have hmat : g.coeff κ x = (Matrix.of fun a i =>
        fderiv ℝ (fun z => κ'.symm (κ z)) x (e i) a).transpose *
        g.coeff κ' (κ'.symm (κ x)) *
        (Matrix.of fun a i => fderiv ℝ (fun z => κ'.symm (κ z)) x (e i) a) := by
      ext i j
      rw [hcoeq i j, coeff_comp_apply g (⇑κ') (fun z => κ'.symm (κ z)) x hσd hκ'm i j]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul]
      exact Finset.sum_comm
    have hdetP : (fderiv ℝ (fun z => κ'.symm (κ z)) x).det =
        (Matrix.of fun a i => fderiv ℝ (fun z => κ'.symm (κ z)) x (e i) a).det := by
      unfold ContinuousLinearMap.det
      rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
      congr 1
    refine ⟨hσd, ?_⟩
    rw [hmat, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hdetP]
    rw [show ∀ p q : ℝ, p * q * p = p ^ 2 * q from fun p q => by ring]
    rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  have hdet : ∀ j : Fin A.n, ∀ y ∈ Metric.ball (A.c k) (A.r k), A.κ k y ∈ (A.κ j).target →
      DifferentiableAt ℝ (fun z => (A.κ j).symm (A.κ k z)) y ∧
      Real.sqrt (g.coeff (A.κ k) y).det =
        |(fderiv ℝ (fun z => (A.κ j).symm (A.κ k z)) y).det| *
          Real.sqrt (g.coeff (A.κ j) ((A.κ j).symm (A.κ k y))).det := by
    intro j y hy hyt
    exact hs2 (A.κ k) (A.κ j) y (by rw [A.source_eq k]; exact hy) hyt
  have hh : ∀ j : Fin A.n, ∀ q : M, A.ψ j q * F q ≠ 0 →
      q ∈ A.κ j '' Metric.ball (A.c j) (A.r j / 8) := by
    intro j q hq
    have h1 : A.ψ j q ≠ 0 := left_ne_zero_of_mul hq
    exact (A.ψ_supp j).2 (subset_tsupport _ h1)
  
  have hpair : ∀ (j : Fin A.n) (h : M → ℝ),
      (∀ q : M, h q ≠ 0 → q ∈ A.κ j '' Metric.ball (A.c j) (A.r j / 8)) →
      ∃ V : Set E3, V ⊆ ndsHalf (A.c j) (A.r j) ∧
        (∫ y in ndsHalf (A.c k) (A.r k), h (A.κ k y) * Real.sqrt (g.coeff (A.κ k) y).det) =
          (∫ x in V, h (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det) ∧
        ∀ x ∈ ndsHalf (A.c j) (A.r j), A.κ j x ∈ A.κ k '' Metric.ball (A.c k) (A.r k / 2) →
          h (A.κ j x) ≠ 0 → x ∈ V := by
    intro j h hhj
    have hrj := A.r_pos j
    have hrk := A.r_pos k
    have hb8 : Metric.ball (A.c j) (A.r j / 8) ⊆ Metric.ball (A.c j) (A.r j / 2) :=
      Metric.ball_subset_ball (by linarith)
    have hb2 : Metric.ball (A.c j) (A.r j / 2) ⊆ Metric.ball (A.c j) (A.r j) :=
      Metric.ball_subset_ball (by linarith)
    have hk2 : Metric.ball (A.c k) (A.r k / 2) ⊆ Metric.ball (A.c k) (A.r k) :=
      Metric.ball_subset_ball (by linarith)
    have hUo : IsOpen (A.κ j '' Metric.ball (A.c j) (A.r j / 8)) :=
      (A.κ j).toOpenPartialHomeomorph.isOpen_image_of_subset_source
        Metric.isOpen_ball
        (fun z hz => (by rw [A.source_eq j]; exact hb2 (hb8 hz) : z ∈ (A.κ j).source))
    have hkc : ContinuousOn (A.κ k) (Metric.ball (A.c k) (A.r k)) := by
      rw [← A.source_eq k]; exact (A.κ k).contMDiffOn.continuousOn
    have hOm : MeasurableSet (ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
        A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8)))) :=
      (hHB k).1.inter (hkc.isOpen_inter_preimage Metric.isOpen_ball hUo).measurableSet
    have hkey : ∀ y ∈ ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
        A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8))),
        y ∈ Metric.ball (A.c k) (A.r k) ∧ A.κ k y ∈ (A.κ j).target ∧
        A.κ j ((A.κ j).symm (A.κ k y)) = A.κ k y ∧
        (A.κ j).symm (A.κ k y) ∈ ndsHalf (A.c j) (A.r j) := by
      intro y hy
      obtain ⟨hyH, hyB, x', hx', hx'y⟩ := hy
      have hx's : x' ∈ (A.κ j).source := by rw [A.source_eq j]; exact hb2 (hb8 hx')
      have ht : A.κ k y ∈ (A.κ j).target := by
        rw [← hx'y]; exact (A.κ j).toPartialEquiv.map_source hx's
      have hσy : (A.κ j).symm (A.κ k y) = x' := by
        rw [← hx'y]; exact (A.κ j).toPartialEquiv.left_inv hx's
      refine ⟨hyB, ht, (A.κ j).toPartialEquiv.right_inv ht, ?_⟩
      rw [hσy]
      exact ⟨hb8 hx', hface k j y x' hyB (hb2 (hb8 hx')) hx'y.symm hyH.2⟩
    refine ⟨(fun z => (A.κ j).symm (A.κ k z)) '' (ndsHalf (A.c k) (A.r k) ∩
      (Metric.ball (A.c k) (A.r k) ∩ A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8)))),
      ?_, ?_, ?_⟩
    · rintro _ ⟨y, hy, rfl⟩
      exact (hkey y hy).2.2.2
    · have hE1 : (∫ y in ndsHalf (A.c k) (A.r k),
          h (A.κ k y) * Real.sqrt (g.coeff (A.κ k) y).det) =
          ∫ y in ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
            A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8))),
            h (A.κ k y) * Real.sqrt (g.coeff (A.κ k) y).det := by
        refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hHB k).1
          Set.inter_subset_left ?_
        intro y hy
        have hyB : y ∈ Metric.ball (A.c k) (A.r k) := (hHB k).2.1 hy.1
        have hz : h (A.κ k y) = 0 := by
          by_contra hne
          exact hy.2 ⟨hy.1, hyB, hhj _ hne⟩
        rw [hz, zero_mul]
      have hσ' : ∀ y ∈ ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
          A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8))),
          HasFDerivWithinAt (fun z => (A.κ j).symm (A.κ k z))
            (fderiv ℝ (fun z => (A.κ j).symm (A.κ k z)) y)
            (ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
              A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8)))) y := by
        intro y hy
        obtain ⟨hyB, ht, -, -⟩ := hkey y hy
        exact (hdet j y hyB ht).1.hasFDerivAt.hasFDerivWithinAt
      have hinj : Set.InjOn (fun z => (A.κ j).symm (A.κ k z))
          (ndsHalf (A.c k) (A.r k) ∩ (Metric.ball (A.c k) (A.r k) ∩
            A.κ k ⁻¹' (A.κ j '' Metric.ball (A.c j) (A.r j / 8)))) := by
        intro y₁ h₁ y₂ h₂ he
        obtain ⟨hB1, -, he1, -⟩ := hkey y₁ h₁
        obtain ⟨hB2, -, he2, -⟩ := hkey y₂ h₂
        have he' : (A.κ j).symm (A.κ k y₁) = (A.κ j).symm (A.κ k y₂) := he
        have hkk : A.κ k y₁ = A.κ k y₂ := by rw [← he1, ← he2, he']
        have hs1 : y₁ ∈ (A.κ k).source := by rw [A.source_eq k]; exact hB1
        have hs2 : y₂ ∈ (A.κ k).source := by rw [A.source_eq k]; exact hB2
        exact (A.κ k).toPartialEquiv.injOn hs1 hs2 hkk
      rw [hE1, integral_image_eq_integral_abs_det_fderiv_smul volume hOm hσ' hinj]
      refine setIntegral_congr_fun hOm (fun y hy => ?_)
      obtain ⟨hyB, ht, he, -⟩ := hkey y hy
      simp only [smul_eq_mul]
      rw [he, (hdet j y hyB ht).2]
      ring
    · intro x hx hxk hne
      obtain ⟨y, hy, hyx⟩ := hxk
      have hxB : x ∈ Metric.ball (A.c j) (A.r j) := (hHB j).2.1 hx
      have hyB : y ∈ Metric.ball (A.c k) (A.r k) := hk2 hy
      have hy0 : 0 < y 0 := hface j k x y hxB hyB hyx.symm hx.2
      have hyH : y ∈ ndsHalf (A.c k) (A.r k) :=
        (⟨hy, hy0⟩ : y ∈ Metric.ball (A.c k) (A.r k / 2) ∩ {x : E3 | 0 < x 0})
      have hyU : A.κ k y ∈ A.κ j '' Metric.ball (A.c j) (A.r j / 8) := by
        rw [hyx]; exact hhj _ hne
      have hxs : x ∈ (A.κ j).source := by rw [A.source_eq j]; exact hxB
      refine ⟨y, ⟨hyH, hyB, hyU⟩, ?_⟩
      show (A.κ j).symm (A.κ k y) = x
      rw [hyx]
      exact (A.κ j).toPartialEquiv.left_inv hxs
  choose V hVsub hVeq hVcov using
    fun j => hpair j (fun q => A.ψ j q * F q) (hh j)
  have hT : ∀ j : Fin A.n, (∫ x in ndsHalf (A.c k) (A.r k),
      A.ψ j (A.κ k x) * F (A.κ k x) * Real.sqrt (g.coeff (A.κ k) x).det) =
      ∫ x in V j, A.ψ j (A.κ j x) * F (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det :=
    fun j => hVeq j
  
  have hsplit : ∫ x in ndsHalf (A.c k) (A.r k), F (A.κ k x) * Real.sqrt (g.coeff (A.κ k) x).det =
      ∑ j, ∫ x in ndsHalf (A.c k) (A.r k),
        A.ψ j (A.κ k x) * F (A.κ k x) * Real.sqrt (g.coeff (A.κ k) x).det := by
    rw [← integral_finset_sum Finset.univ (fun j _ => hint j k)]
    refine setIntegral_congr_fun (hHB k).1 (fun x hx => ?_)
    simp only
    rw [← Finset.sum_mul, ← Finset.sum_mul, A.ψ_sum _ (hdom k x hx), one_mul]
  refine ⟨fun hpos => ?_, fun hz => ?_⟩
  · 
    rw [hsplit]
    unfold ndsInt
    refine Finset.sum_le_sum (fun j _ => ?_)
    rw [hT j]
    refine setIntegral_mono_set (hint j j) ?_ (hVsub j).eventuallyLE
    refine ae_restrict_of_forall_mem (hHB j).1 (fun x hx => ?_)
    have h1 := A.ψ_nonneg j (A.κ j x)
    have h2 := hpos _ (hdom j x hx)
    have h3 := Real.sqrt_nonneg (g.coeff (A.κ j) x).det
    show (0 : ℝ) ≤ A.ψ j (A.κ j x) * F (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det
    exact mul_nonneg (mul_nonneg h1 h2) h3
  · 
    rw [hsplit]
    unfold ndsInt
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hT j]
    refine (setIntegral_eq_of_subset_of_forall_diff_eq_zero (hHB j).1 (hVsub j) ?_).symm
    intro x hx
    by_contra hne
    have hq : A.ψ j (A.κ j x) * F (A.κ j x) ≠ 0 := left_ne_zero_of_mul hne
    have hF0 : F (A.κ j x) ≠ 0 := right_ne_zero_of_mul hq
    have hin : A.κ j x ∈ A.κ k '' Metric.ball (A.c k) (A.r k / 2) := by
      by_contra hnot
      exact hF0 (hz _ (hdom j x hx.1) hnot)
    exact hx.2 (hVcov j x hx.1 hin hq)

theorem nds_energy_compare [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    {β : M → ℝ} {Ω₀ S₀ : Set M} (A : NdsAtlas M β Ω₀ S₀) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      (∀ j, ∫ x in ndsHalf (A.c j) (A.r j),
          ∑ a : Fin 3, (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2
        ≤ K * ndsInt g A (fun q => g.gradInner u u q)) ∧
      ndsInt g A (fun q => u q ^ 2) ≤
        K * ∑ j, ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 :=
by
  classical
  have hHb := fun j => nds_half_basic (A.c j) (A.r j) (A.r_pos j)
  have hball : ∀ j, (A.κ j).source = Metric.ball (A.c j) (A.r j) := A.source_eq
  have hKs : ∀ j, Metric.closedBall (A.c j) (A.r j / 2) ⊆ Metric.ball (A.c j) (A.r j) :=
    fun j => Metric.closedBall_subset_ball (by linarith [A.r_pos j])
  have hHK : ∀ j, ndsHalf (A.c j) (A.r j) ⊆ Metric.closedBall (A.c j) (A.r j / 2) :=
    fun j x hx => Metric.ball_subset_closedBall hx.1
  have hdetc : ∀ j, ContinuousOn (fun x => Real.sqrt (g.coeff (A.κ j) x).det)
      (Metric.ball (A.c j) (A.r j)) := by
    intro j
    have h := (nds_chart_cont g (A.κ j) (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ))
      contMDiff_const contMDiff_const).2.2.2.1
    rw [hball j] at h
    exact h
  have hinvc : ∀ j (a b : Fin 3), ContinuousOn (fun x => (g.coeff (A.κ j) x)⁻¹ a b)
      (Metric.ball (A.c j) (A.r j)) := by
    intro j a b
    have h := (nds_chart_cont g (A.κ j) (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ))
      contMDiff_const contMDiff_const).2.2.2.2 a b
    rw [hball j] at h
    exact h
  
  have hell : ∀ j, ∃ lam : ℝ, 0 < lam ∧ ∀ x ∈ Metric.closedBall (A.c j) (A.r j / 2),
      ∀ ξ : Fin 3 → ℝ, lam * ∑ a : Fin 3, ξ a ^ 2 ≤
        Real.sqrt (g.coeff (A.κ j) x).det *
          ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * ξ a * ξ b := by
    intro j
    obtain ⟨S, hS⟩ : ∃ S : Set (Fin 3 → ℝ), S = {ζ | ∑ a : Fin 3, ζ a ^ 2 = 1} := ⟨_, rfl⟩
    have hSc : IsCompact S := by
      refine (isCompact_univ_pi (fun _ : Fin 3 => isCompact_Icc (a := (-1 : ℝ)) (b := 1))).of_isClosed_subset ?_ ?_
      · rw [hS]
        exact isClosed_eq (continuous_finset_sum _ fun a _ => (continuous_apply a).pow 2)
          continuous_const
      · intro ζ hζ
        rw [hS] at hζ
        have hζ' : ∑ a : Fin 3, ζ a ^ 2 = 1 := hζ
        rw [Set.mem_univ_pi]
        intro a
        have h1 : ζ a ^ 2 ≤ 1 := by
          have := Finset.single_le_sum (f := fun b => ζ b ^ 2) (fun b _ => sq_nonneg (ζ b))
            (Finset.mem_univ a)
          linarith
        exact Set.mem_Icc.mpr (abs_le.mp ((sq_le_one_iff_abs_le_one _).mp h1))
    have hT : IsCompact (Metric.closedBall (A.c j) (A.r j / 2) ×ˢ S) :=
      (isCompact_closedBall _ _).prod hSc
    have hTne : (Metric.closedBall (A.c j) (A.r j / 2) ×ˢ S).Nonempty := by
      refine ⟨(A.c j, fun a => if a = 0 then 1 else 0),
        Metric.mem_closedBall_self (by linarith [A.r_pos j]), ?_⟩
      rw [hS]
      show ∑ a : Fin 3, (if a = 0 then (1 : ℝ) else 0) ^ 2 = 1
      simp [Fin.sum_univ_three]
    have hKs' : Set.MapsTo Prod.fst (Metric.closedBall (A.c j) (A.r j / 2) ×ˢ S)
        (Metric.ball (A.c j) (A.r j)) := fun p hp => hKs j hp.1
    obtain ⟨F, hF⟩ : ∃ F : E3 × (Fin 3 → ℝ) → ℝ, ∀ p, F p =
        Real.sqrt (g.coeff (A.κ j) p.1).det *
          ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) p.1)⁻¹ a b * p.2 a * p.2 b :=
      ⟨_, fun _ => rfl⟩
    have hFc : ContinuousOn F (Metric.closedBall (A.c j) (A.r j / 2) ×ˢ S) := by
      have e : F = fun p : E3 × (Fin 3 → ℝ) => Real.sqrt (g.coeff (A.κ j) p.1).det *
          ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) p.1)⁻¹ a b * p.2 a * p.2 b := funext hF
      rw [e]
      refine ContinuousOn.mul ((hdetc j).comp continuousOn_fst hKs') ?_
      refine continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ => ?_
      refine (((hinvc j a b).comp continuousOn_fst hKs').mul ?_).mul ?_
      · exact ((continuous_apply a).comp continuous_snd).continuousOn
      · exact ((continuous_apply b).comp continuous_snd).continuousOn
    have hFpos : ∀ x ∈ Metric.closedBall (A.c j) (A.r j / 2), ∀ ζ : Fin 3 → ℝ, ζ ≠ 0 →
        0 < Real.sqrt (g.coeff (A.κ j) x).det *
          ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * ζ a * ζ b := by
      intro x hx ζ hζ
      have hxs : x ∈ (A.κ j).source := by rw [hball j]; exact hKs j hx
      refine mul_pos (Real.sqrt_pos.mpr (coeff_posDef g (A.κ j) x hxs).det_pos) ?_
      have h := ((flat_coeff_regular g (A.κ j)).2.2.1 x hxs).dotProduct_mulVec_pos hζ
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum] at h
      have e : (∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * ζ a * ζ b) =
          ∑ a : Fin 3, ∑ b : Fin 3, ζ a * ((g.coeff (A.κ j) x)⁻¹ a b * ζ b) :=
        Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
      rw [e]
      exact h
    obtain ⟨p₀, hp₀, hmin⟩ := hT.exists_isMinOn hTne hFc
    have hp₀S : ∑ a : Fin 3, p₀.2 a ^ 2 = 1 := by
      have := hp₀.2
      rw [hS] at this
      exact this
    have hp₀ne : p₀.2 ≠ 0 := by
      intro h0
      rw [h0] at hp₀S
      simp at hp₀S
    refine ⟨F p₀, by rw [hF]; exact hFpos p₀.1 hp₀.1 p₀.2 hp₀ne, ?_⟩
    intro x hx ξ
    obtain ⟨s, hs⟩ : ∃ s : ℝ, s = ∑ a : Fin 3, ξ a ^ 2 := ⟨_, rfl⟩
    have hs0 : 0 ≤ s := by rw [hs]; exact Finset.sum_nonneg fun a _ => sq_nonneg _
    rw [← hs]
    rcases hs0.lt_or_eq with hspos | hszero
    · obtain ⟨t, ht⟩ : ∃ t : ℝ, t = Real.sqrt s := ⟨_, rfl⟩
      have htpos : 0 < t := by rw [ht]; exact Real.sqrt_pos.mpr hspos
      have ht2 : t ^ 2 = s := by rw [ht]; exact Real.sq_sqrt hs0
      have htne : t ≠ 0 := htpos.ne'
      have hζS : (fun a => ξ a / t) ∈ S := by
        rw [hS]
        show ∑ a : Fin 3, (ξ a / t) ^ 2 = 1
        simp only [div_pow]
        rw [← Finset.sum_div, ← hs, ← ht2]
        exact div_self (pow_ne_zero 2 htne)
      have hm : F p₀ ≤ F (x, fun a => ξ a / t) := isMinOn_iff.mp hmin _ ⟨hx, hζS⟩
      rw [hF (x, fun a => ξ a / t)] at hm
      have hQ : (∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * ξ a * ξ b) =
          (∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * (ξ a / t) * (ξ b / t)) * s := by
        rw [← ht2, Finset.sum_mul]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun b _ => ?_
        field_simp
      rw [hQ]
      calc F p₀ * s ≤ (Real.sqrt (g.coeff (A.κ j) x).det *
            ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (A.κ j) x)⁻¹ a b * (ξ a / t) * (ξ b / t)) * s :=
            mul_le_mul_of_nonneg_right hm hs0
        _ = _ := by ring
    · have hξ : ξ = 0 := by
        funext a
        have h0 : ∑ a : Fin 3, ξ a ^ 2 = 0 := by rw [← hs]; exact hszero.symm
        have := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => sq_nonneg (ξ i))).1 h0 a
          (Finset.mem_univ a)
        exact pow_eq_zero_iff (by norm_num) |>.mp this
      rw [← hszero, hξ]
      simp
  choose lam hlam0 hlam using hell
  have hbd : ∀ j, ∃ Λ : ℝ, ∀ x ∈ Metric.closedBall (A.c j) (A.r j / 2),
      Real.sqrt (g.coeff (A.κ j) x).det ≤ Λ := by
    intro j
    obtain ⟨C, hC⟩ := (isCompact_closedBall (A.c j) (A.r j / 2)).exists_bound_of_continuousOn
      ((hdetc j).mono (hKs j))
    refine ⟨C, fun x hx => ?_⟩
    have h := hC x hx
    rw [Real.norm_eq_abs] at h
    exact (le_abs_self _).trans h
  choose Λ hΛ using hbd
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : ℝ, K₁ = ∑ j, (lam j)⁻¹ := ⟨_, rfl⟩
  obtain ⟨K₂, hK₂⟩ : ∃ K₂ : ℝ, K₂ = ∑ j, max (Λ j) 0 := ⟨_, rfl⟩
  have hK₁0 : 0 ≤ K₁ := by
    rw [hK₁]; exact Finset.sum_nonneg fun j _ => (inv_pos.mpr (hlam0 j)).le
  have hK₂0 : 0 ≤ K₂ := by
    rw [hK₂]; exact Finset.sum_nonneg fun j _ => le_max_right _ _
  have hlamK : ∀ j, (lam j)⁻¹ ≤ K₁ := by
    intro j
    rw [hK₁]
    exact Finset.single_le_sum (f := fun l => (lam l)⁻¹) (fun l _ => (inv_pos.mpr (hlam0 l)).le)
      (Finset.mem_univ j)
  have hΛK : ∀ j, ∀ x ∈ Metric.closedBall (A.c j) (A.r j / 2),
      Real.sqrt (g.coeff (A.κ j) x).det ≤ K₂ := by
    intro j x hx
    refine (hΛ j x hx).trans ((le_max_left (Λ j) 0).trans ?_)
    rw [hK₂]
    exact Finset.single_le_sum (f := fun l => max (Λ l) 0) (fun l _ => le_max_right _ _)
      (Finset.mem_univ j)
  refine ⟨K₁ + K₂, add_nonneg hK₁0 hK₂0, fun u hu => ?_⟩
  have hcc : ∀ j, ContDiffOn ℝ ∞ (fun x => u (A.κ j x)) (Metric.ball (A.c j) (A.r j)) ∧
      (∀ a : Fin 3, ContinuousOn (partialDeriv a (fun x => u (A.κ j x)))
        (Metric.ball (A.c j) (A.r j))) ∧
      ContinuousOn (fun x => g.gradInner u u (A.κ j x)) (Metric.ball (A.c j) (A.r j)) := by
    intro j
    have h := nds_chart_cont g (A.κ j) u u hu hu
    rw [hball j] at h
    exact ⟨h.1, h.2.1, h.2.2.1⟩
  have hB : 0 ≤ ndsInt g A (fun q => g.gradInner u u q) :=
    (nds_int_algebra g A _ _ (fun j => (hcc j).2.2) (fun j => (hcc j).2.2)).2.1
      (fun q _ => (gradInner_symm_nonneg g u u q).1)
  refine ⟨fun j => ?_, ?_⟩
  · have hpt : ∀ x ∈ ndsHalf (A.c j) (A.r j),
        lam j * ∑ a : Fin 3, (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2 ≤
          g.gradInner u u (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det := by
      intro x hx
      have hxs : x ∈ (A.κ j).source := by rw [hball j]; exact (hHb j).2.1 hx
      have h := hlam j x (hHK j hx) (fun a => partialDeriv a (fun z => u (A.κ j z)) x)
      rw [gradInner_pdiffeo_formula g (A.κ j) u u hu hu x hxs]
      rw [mul_comm _ (Real.sqrt (g.coeff (A.κ j) x).det)]
      exact h
    have hint1 : IntegrableOn
        (fun x => lam j * ∑ a : Fin 3, (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2)
        (ndsHalf (A.c j) (A.r j)) :=
      ((hHb j).2.2 _ (continuousOn_const.mul
        (continuousOn_finset_sum _ fun a _ => ((hcc j).2.1 a).pow 2))).2
    have hint2 : IntegrableOn
        (fun x => g.gradInner u u (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det)
        (ndsHalf (A.c j) (A.r j)) :=
      ((hHb j).2.2 _ ((hcc j).2.2.mul (hdetc j))).2
    have hmono := setIntegral_mono_on hint1 hint2 (hHb j).1 hpt
    rw [integral_const_mul] at hmono
    have hloc := (nds_int_localize g A (fun q => g.gradInner u u q) (fun k => (hcc k).2.2) j).1
      (fun q _ => (gradInner_symm_nonneg g u u q).1)
    have hE := hmono.trans hloc
    have hE' : (∫ x in ndsHalf (A.c j) (A.r j),
          ∑ a : Fin 3, (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2) ≤
        (lam j)⁻¹ * ndsInt g A (fun q => g.gradInner u u q) := by
      rw [← div_eq_inv_mul, le_div_iff₀ (hlam0 j)]
      linarith
    calc _ ≤ (lam j)⁻¹ * ndsInt g A (fun q => g.gradInner u u q) := hE'
      _ ≤ (K₁ + K₂) * ndsInt g A (fun q => g.gradInner u u q) :=
        mul_le_mul_of_nonneg_right (by linarith [hlamK j]) hB
  · have hI : 0 ≤ ∑ j, ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 :=
      Finset.sum_nonneg fun j _ => integral_nonneg fun x => sq_nonneg _
    calc ndsInt g A (fun q => u q ^ 2)
        ≤ ∑ j, K₂ * ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 := by
          unfold ndsInt
          refine Finset.sum_le_sum fun j _ => ?_
          rw [← integral_const_mul]
          have hψc : ContinuousOn (fun x => A.ψ j (A.κ j x)) (Metric.ball (A.c j) (A.r j)) := by
            have := (A.ψ_smooth j).continuous.comp_continuousOn
              (A.κ j).contMDiffOn.continuousOn
            rw [hball j] at this
            exact this
          refine setIntegral_mono_on ?_ ?_ (hHb j).1 ?_
          · exact ((hHb j).2.2 _ ((hψc.mul ((hcc j).1.continuousOn.pow 2)).mul (hdetc j))).2
          · exact ((hHb j).2.2 _ (continuousOn_const.mul ((hcc j).1.continuousOn.pow 2))).2
          · intro x hx
            have hxb := (hHb j).2.1 hx
            have hΩ : A.κ j x ∈ Ω₀ := (A.dom j x hxb).2 (le_of_lt hx.2)
            have hψ1 : A.ψ j (A.κ j x) ≤ 1 := by
              rw [← A.ψ_sum _ hΩ]
              exact Finset.single_le_sum (f := fun l => A.ψ l (A.κ j x))
                (fun l _ => A.ψ_nonneg l _) (Finset.mem_univ j)
            have hd0 := Real.sqrt_nonneg (g.coeff (A.κ j) x).det
            have hdK := hΛK j x (hHK j hx)
            have hw := sq_nonneg (u (A.κ j x))
            show A.ψ j (A.κ j x) * u (A.κ j x) ^ 2 * Real.sqrt (g.coeff (A.κ j) x).det ≤
              K₂ * u (A.κ j x) ^ 2
            calc A.ψ j (A.κ j x) * u (A.κ j x) ^ 2 * Real.sqrt (g.coeff (A.κ j) x).det
                ≤ 1 * u (A.κ j x) ^ 2 * Real.sqrt (g.coeff (A.κ j) x).det :=
                  mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hψ1 hw) hd0
              _ = u (A.κ j x) ^ 2 * Real.sqrt (g.coeff (A.κ j) x).det := by ring
              _ ≤ u (A.κ j x) ^ 2 * K₂ := mul_le_mul_of_nonneg_left hdK hw
              _ = K₂ * u (A.κ j x) ^ 2 := mul_comm _ _
      _ = K₂ * ∑ j, ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 :=
          (Finset.mul_sum _ _ _).symm
      _ ≤ (K₁ + K₂) * ∑ j, ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 :=
          mul_le_mul_of_nonneg_right (by linarith) hI

theorem nds_poincare [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    {β : M → ℝ} {Ω₀ S₀ : Set M} (A : NdsAtlas M β Ω₀ S₀) (hconn : IsPreconnected Ω₀)
    (hS : ∃ q ∈ S₀, q ∈ Ω₀) :
    ∃ CP : ℝ, 0 ≤ CP ∧ ∀ u ∈ ndsV0 S₀,
      ndsInt g A (fun q => u q ^ 2) ≤ CP * ndsInt g A (fun q => g.gradInner u u q) ∧
      ∀ j, ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2
          ≤ CP * ndsInt g A (fun q => g.gradInner u u q) ∧
        ∀ a : Fin 3, ∫ x in ndsHalf (A.c j) (A.r j), (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2
          ≤ CP * ndsInt g A (fun q => g.gradInner u u q) :=
by
  classical
  
  have hHb := fun j => nds_half_basic (A.c j) (A.r j) (A.r_pos j)
  have hball : ∀ j, (A.κ j).source = Metric.ball (A.c j) (A.r j) := A.source_eq
  have hcc : ∀ (j : Fin A.n) (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun x => u (A.κ j x)) (Metric.ball (A.c j) (A.r j)) ∧
      (∀ a : Fin 3, ContinuousOn (partialDeriv a (fun x => u (A.κ j x)))
        (Metric.ball (A.c j) (A.r j))) ∧
      ContinuousOn (fun x => g.gradInner u u (A.κ j x)) (Metric.ball (A.c j) (A.r j)) := by
    intro j u hu
    have h := nds_chart_cont g (A.κ j) u u hu hu
    rw [hball j] at h
    exact ⟨h.1, h.2.1, h.2.2.1⟩
  have hmem : ∀ u : M → ℝ, u ∈ ndsV0 S₀ → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧
      ∃ N : Set M, IsOpen N ∧ S₀ ⊆ N ∧ ∀ q ∈ N, u q = 0 := fun u hu => hu
  have hconv : ∀ (c : E3) (r : ℝ), Convex ℝ (ndsHalf c r) := by
    intro c r
    refine (convex_ball c (r / 2)).inter ?_
    intro x hx y hy a b ha hb hab
    have hx' : 0 < x 0 := hx
    have hy' : 0 < y 0 := hy
    show 0 < (a • x + b • y) 0
    simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    rcases ha.lt_or_eq with ha' | ha'
    · nlinarith [mul_pos ha' hx', mul_nonneg hb hy'.le]
    · subst ha'
      have hb1 : b = 1 := by linarith
      subst hb1
      simpa using hy'
  obtain ⟨I, hI⟩ : ∃ I : (M → ℝ) → Fin A.n → ℝ, ∀ u j,
      I u j = ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 := ⟨_, fun _ _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : (M → ℝ) → Fin A.n → ℝ, ∀ u j,
      E u j = ∫ x in ndsHalf (A.c j) (A.r j),
        ∑ a : Fin 3, (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2 := ⟨_, fun _ _ => rfl⟩
  have hEnn : ∀ u j, 0 ≤ E u j := by
    intro u j
    rw [hE]
    exact integral_nonneg fun x => Finset.sum_nonneg fun a _ => sq_nonneg _
  have hSum : ∀ u j, E u j ≤ ∑ l, E u l := fun u j =>
    Finset.single_le_sum (fun l _ => hEnn u l) (Finset.mem_univ j)
  
  obtain ⟨j₀, hD₀, hreach⟩ := nds_chart_chain A hconn hS
  have hchain : ∀ k, ∃ C : ℝ, 0 ≤ C ∧ ∀ u ∈ ndsV0 S₀, I u k ≤ C * ∑ l, E u l := by
    intro k
    have hk := hreach k
    induction hk with
    | refl =>
      have hc0 : A.c j₀ 0 = 0 := A.D_center j₀ hD₀
      refine ⟨1024 * A.r j₀ ^ 2, by positivity, ?_⟩
      intro u hu
      obtain ⟨hus, N, hN, hSN, hu0⟩ := hmem u hu
      have hκc : ContinuousOn (A.κ j₀) (Metric.ball (A.c j₀) (A.r j₀)) := by
        have := (A.κ j₀).contMDiffOn.continuousOn
        rw [hball j₀] at this
        exact this
      have hO : IsOpen (Metric.ball (A.c j₀) (A.r j₀) ∩ (A.κ j₀) ⁻¹' N) :=
        hκc.isOpen_inter_preimage Metric.isOpen_ball hN
      have h3 := half_ball_dirichlet (A.c j₀) (A.r j₀) (A.r_pos j₀) hc0
        (fun z => u (A.κ j₀ z)) (hcc j₀ u hus).1 _ hO
        (fun x hx => ⟨hx.1, hSN ((A.dir j₀ x hx.1).2 ⟨hD₀, hx.2⟩)⟩)
        (fun x hx => hu0 _ hx.2)
      have h3' : I u j₀ ≤ 1024 * A.r j₀ ^ 2 * E u j₀ := by
        rw [hI, hE]
        exact h3
      calc I u j₀ ≤ 1024 * A.r j₀ ^ 2 * E u j₀ := h3'
        _ ≤ 1024 * A.r j₀ ^ 2 * ∑ l, E u l :=
          mul_le_mul_of_nonneg_left (hSum u j₀) (by positivity)
    | @tail j k₁ _ hRl ih =>
      obtain ⟨Cj, hCj0, hCj⟩ := ih
      obtain ⟨y, ρ, hρ, hWH, hWκ⟩ := hRl
      have hWs : Metric.closedBall y ρ ⊆ (A.κ k₁).source := by
        rw [hball k₁]
        exact hWH.trans (hHb k₁).2.1
      have hVs : ndsHalf (A.c j) (A.r j) ⊆ (A.κ j).source := by
        rw [hball j]
        exact (hHb j).2.1
      obtain ⟨CT, hCT0, hCT⟩ :=
        nds_chart_transfer (A.κ k₁) (A.κ j) y ρ _ (hHb j).1 hVs hWs hWκ
      have hw : 0 < (MeasureTheory.volume (Metric.closedBall y ρ)).toReal :=
        ENNReal.toReal_pos (measure_closedBall_pos MeasureTheory.volume y hρ).ne'
          measure_closedBall_lt_top.ne
      have hm : 0 ≤ (MeasureTheory.volume (ndsHalf (A.c k₁) (A.r k₁))).toReal :=
        ENNReal.toReal_nonneg
      have hX : 0 ≤ CT * Cj + 8 * A.r k₁ ^ 2 :=
        add_nonneg (mul_nonneg hCT0 hCj0) (by positivity)
      refine ⟨2 * (MeasureTheory.volume (ndsHalf (A.c k₁) (A.r k₁))).toReal /
          (MeasureTheory.volume (Metric.closedBall y ρ)).toReal * (CT * Cj + 8 * A.r k₁ ^ 2),
        mul_nonneg (div_nonneg (mul_nonneg zero_le_two hm) hw.le) hX, ?_⟩
      intro u hu
      have hus := (hmem u hu).1
      have hJ : ∫ z in Metric.closedBall y ρ, u (A.κ k₁ z) ^ 2 ≤ CT * I u j := by
        rw [hI]
        exact hCT u hus.continuous ((hHb j).2.2 _ ((hcc j u hus).1.continuousOn.pow 2)).2
      have hJ' : ∫ z in Metric.closedBall y ρ, u (A.κ k₁ z) ^ 2 ≤ CT * Cj * ∑ l, E u l := by
        calc _ ≤ CT * I u j := hJ
          _ ≤ CT * (Cj * ∑ l, E u l) := mul_le_mul_of_nonneg_left (hCj u hu) hCT0
          _ = _ := by ring
      have hr := A.r_pos k₁
      have h2 := convex_anchor_poincare (ndsHalf (A.c k₁) (A.r k₁)) (Metric.closedBall y ρ)
        (Metric.ball (A.c k₁) (A.r k₁)) (A.c k₁) (A.r k₁ / 2) (fun z => u (A.κ k₁ z))
        (hHb k₁).1 (hconv _ _) (fun x hx => Metric.ball_subset_closedBall hx.1)
        Metric.isOpen_ball (Metric.closedBall_subset_ball (by linarith))
        Metric.isClosed_closedBall.measurableSet hWH (hcc k₁ u hus).1
      have h2' : (MeasureTheory.volume (Metric.closedBall y ρ)).toReal * I u k₁ ≤
          2 * (MeasureTheory.volume (ndsHalf (A.c k₁) (A.r k₁))).toReal *
            ((∫ z in Metric.closedBall y ρ, u (A.κ k₁ z) ^ 2) +
              8 * A.r k₁ ^ 2 * E u k₁) := by
        rw [hI, hE]
        have e : (32 : ℝ) * (A.r k₁ / 2) ^ 2 = 8 * A.r k₁ ^ 2 := by ring
        rw [← e]
        exact h2
      have hin : (∫ z in Metric.closedBall y ρ, u (A.κ k₁ z) ^ 2) + 8 * A.r k₁ ^ 2 * E u k₁ ≤
          (CT * Cj + 8 * A.r k₁ ^ 2) * ∑ l, E u l := by
        have h8 : 8 * A.r k₁ ^ 2 * E u k₁ ≤ 8 * A.r k₁ ^ 2 * ∑ l, E u l :=
          mul_le_mul_of_nonneg_left (hSum u k₁) (by positivity)
        linarith
      have hstep : (MeasureTheory.volume (Metric.closedBall y ρ)).toReal * I u k₁ ≤
          2 * (MeasureTheory.volume (ndsHalf (A.c k₁) (A.r k₁))).toReal *
            ((CT * Cj + 8 * A.r k₁ ^ 2) * ∑ l, E u l) :=
        h2'.trans (mul_le_mul_of_nonneg_left hin (mul_nonneg zero_le_two hm))
      have hfin : I u k₁ ≤ (2 * (MeasureTheory.volume (ndsHalf (A.c k₁) (A.r k₁))).toReal *
            ((CT * Cj + 8 * A.r k₁ ^ 2) * ∑ l, E u l)) /
            (MeasureTheory.volume (Metric.closedBall y ρ)).toReal := by
        rw [le_div_iff₀ hw]
        linarith
      calc I u k₁ ≤ _ := hfin
        _ = _ := by field_simp
  choose C hC0 hC using hchain
  obtain ⟨CI, hCIdef⟩ : ∃ CI : ℝ, CI = ∑ k, C k := ⟨_, rfl⟩
  have hCle : ∀ k, C k ≤ CI := fun k => by
    rw [hCIdef]
    exact Finset.single_le_sum (fun l _ => hC0 l) (Finset.mem_univ k)
  have hCI0 : 0 ≤ CI := by
    rw [hCIdef]
    exact Finset.sum_nonneg fun l _ => hC0 l
  
  obtain ⟨K, hK0, hK⟩ := nds_energy_compare g A
  have hn0 : (0 : ℝ) ≤ (A.n : ℝ) := Nat.cast_nonneg _
  have hnCK : 0 ≤ (A.n : ℝ) * CI * K := mul_nonneg (mul_nonneg hn0 hCI0) hK0
  have hn2CK : 0 ≤ (A.n : ℝ) ^ 2 * CI * K ^ 2 :=
    mul_nonneg (mul_nonneg (pow_nonneg hn0 2) hCI0) (pow_nonneg hK0 2)
  refine ⟨K + (A.n : ℝ) * CI * K + (A.n : ℝ) ^ 2 * CI * K ^ 2, by linarith, ?_⟩
  intro u hu
  have hus := (hmem u hu).1
  obtain ⟨hKE, hKL⟩ := hK u hus
  have hB : 0 ≤ ndsInt g A (fun q => g.gradInner u u q) :=
    (nds_int_algebra g A _ _ (fun j => (hcc j u hus).2.2) (fun j => (hcc j u hus).2.2)).2.1
      (fun q _ => (gradInner_symm_nonneg g u u q).1)
  have hSb : ∑ l, E u l ≤ (A.n : ℝ) * K * ndsInt g A (fun q => g.gradInner u u q) := by
    calc ∑ l, E u l ≤ ∑ l : Fin A.n, K * ndsInt g A (fun q => g.gradInner u u q) :=
          Finset.sum_le_sum (fun l _ => by rw [hE]; exact hKE l)
      _ = (A.n : ℝ) * (K * ndsInt g A (fun q => g.gradInner u u q)) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ = _ := by ring
  have hIk : ∀ k, I u k ≤ (A.n : ℝ) * CI * K * ndsInt g A (fun q => g.gradInner u u q) := by
    intro k
    calc I u k ≤ C k * ∑ l, E u l := hC k u hu
      _ ≤ CI * ((A.n : ℝ) * K * ndsInt g A (fun q => g.gradInner u u q)) :=
          mul_le_mul (hCle k) hSb (Finset.sum_nonneg fun l _ => hEnn u l) hCI0
      _ = _ := by ring
  refine ⟨?_, fun j => ⟨?_, fun a => ?_⟩⟩
  · calc ndsInt g A (fun q => u q ^ 2) ≤ K * ∑ j, I u j := by
          simp only [hI]
          exact hKL
      _ ≤ K * ∑ j : Fin A.n, (A.n : ℝ) * CI * K * ndsInt g A (fun q => g.gradInner u u q) :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun j _ => hIk j) hK0
      _ = ((A.n : ℝ) ^ 2 * CI * K ^ 2) * ndsInt g A (fun q => g.gradInner u u q) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hB
  · calc ∫ x in ndsHalf (A.c j) (A.r j), (u (A.κ j x)) ^ 2 = I u j := (hI u j).symm
      _ ≤ (A.n : ℝ) * CI * K * ndsInt g A (fun q => g.gradInner u u q) := hIk j
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hB
  · have hint1 : IntegrableOn (fun x => (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2)
        (ndsHalf (A.c j) (A.r j)) :=
      ((hHb j).2.2 _ (((hcc j u hus).2.1 a).pow 2)).2
    have hint2 : IntegrableOn
        (fun x => ∑ b : Fin 3, (partialDeriv b (fun z => u (A.κ j z)) x) ^ 2)
        (ndsHalf (A.c j) (A.r j)) :=
      ((hHb j).2.2 _ (continuousOn_finset_sum _ fun b _ => ((hcc j u hus).2.1 b).pow 2)).2
    calc ∫ x in ndsHalf (A.c j) (A.r j), (partialDeriv a (fun z => u (A.κ j z)) x) ^ 2
        ≤ E u j := by
          rw [hE]
          refine integral_mono hint1 hint2 fun x => ?_
          exact Finset.single_le_sum
            (f := fun b => (partialDeriv b (fun z => u (A.κ j z)) x) ^ 2)
            (fun b _ => sq_nonneg _) (Finset.mem_univ a)
      _ ≤ K * ndsInt g A (fun q => g.gradInner u u q) := by rw [hE]; exact hKE j
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) hB

theorem pdiffeo_extend_smooth [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ζ : E3 → ℝ)
    (hζ : ContDiffOn ℝ ∞ ζ κ.source) (Q : Set E3) (hQ : IsCompact Q) (hQs : Q ⊆ κ.source)
    (hζQ : ∀ x ∈ κ.source, x ∉ Q → ζ x = 0) :
    ∃ φ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ ∧ (∀ x ∈ κ.source, φ (κ x) = ζ x) ∧
      ∀ q : M, q ∉ κ '' Q → φ q = 0 :=
by
  classical
  set φ : M → ℝ := fun q => if q ∈ κ.target then ζ (κ.symm q) else 0 with hφdef
  have hval : ∀ x ∈ κ.source, φ (κ x) = ζ x := by
    intro x hx
    have h1 : κ x ∈ κ.target := κ.toPartialEquiv.map_source hx
    have h2 : κ.symm (κ x) = x := κ.toPartialEquiv.left_inv hx
    simp only [hφdef, if_pos h1]
    rw [h2]
  have hzero : ∀ q : M, q ∉ κ '' Q → φ q = 0 := by
    intro q hq
    by_cases ht : q ∈ κ.target
    · have hxs : κ.symm q ∈ κ.source := κ.toPartialEquiv.map_target ht
      have hr : κ (κ.symm q) = q := κ.toPartialEquiv.right_inv ht
      have hxQ : κ.symm q ∉ Q := by
        intro hxQ
        exact hq ⟨κ.symm q, hxQ, hr⟩
      simp only [hφdef, if_pos ht]
      exact hζQ _ hxs hxQ
    · simp only [hφdef, if_neg ht]
  have hKt : κ '' Q ⊆ κ.target := by
    rintro _ ⟨x, hx, rfl⟩
    exact κ.toPartialEquiv.map_source (hQs hx)
  have hKc : IsClosed (κ '' Q) :=
    (hQ.image_of_continuousOn (κ.contMDiffOn.continuousOn.mono hQs)).isClosed
  have hζM : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ζ κ.source := hζ.contMDiffOn
  have hcomp : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ζ ∘ κ.symm) κ.target :=
    hζM.comp κ.symm.contMDiffOn (fun q hq => κ.toPartialEquiv.map_target hq)
  refine ⟨φ, ?_, hval, hzero⟩
  intro q
  by_cases ht : q ∈ κ.target
  · have hn : κ.target ∈ 𝓝 q := κ.open_target.mem_nhds ht
    refine (hcomp.contMDiffAt hn).congr_of_eventuallyEq ?_
    filter_upwards [hn] with q' hq'
    simp only [hφdef, if_pos hq', Function.comp]
  · have hqK : q ∉ κ '' Q := fun h => ht (hKt h)
    have hn : (κ '' Q)ᶜ ∈ 𝓝 q := hKc.isOpen_compl.mem_nhds hqK
    refine (contMDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
    filter_upwards [hn] with q' hq'
    exact hzero q' hq'

theorem nds_weak_solution [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    {β : M → ℝ} {Ω₀ S₀ : Set M} (A : NdsAtlas M β Ω₀ S₀) (hconn : IsPreconnected Ω₀)
    (hS : ∃ q ∈ S₀, q ∈ Ω₀) (f : M → ℝ) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) :
    ∃ (u : ℕ → M → ℝ) (v : Fin A.n → E3 → ℝ) (Gr : Fin A.n → Fin 3 → E3 → ℝ),
      ndsWeakSol g A f u v Gr :=
by
  classical
  obtain ⟨CP, hCP0, hP⟩ := nds_poincare g A hconn hS
  have hball : ∀ j, (A.κ j).source = Metric.ball (A.c j) (A.r j) := A.source_eq
  have hHb := fun j => nds_half_basic (A.c j) (A.r j) (A.r_pos j)
  have hcc : ∀ (j : Fin A.n) (u w : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
      ContDiffOn ℝ ∞ (fun x => u (A.κ j x)) (Metric.ball (A.c j) (A.r j)) ∧
      (∀ a : Fin 3, ContinuousOn (partialDeriv a (fun x => u (A.κ j x)))
        (Metric.ball (A.c j) (A.r j))) ∧
      ContinuousOn (fun x => g.gradInner u w (A.κ j x)) (Metric.ball (A.c j) (A.r j)) ∧
      ContinuousOn (fun x => Real.sqrt (g.coeff (A.κ j) x).det) (Metric.ball (A.c j) (A.r j)) ∧
      (∀ a b : Fin 3, ContinuousOn (fun x => (g.coeff (A.κ j) x)⁻¹ a b)
        (Metric.ball (A.c j) (A.r j))) := by
    intro j u w hu hw
    rw [← hball j]
    exact nds_chart_cont g (A.κ j) u w hu hw
  have hsm : ∀ u : ↥(ndsV0 S₀), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u : M → ℝ) ∧
      ∃ N : Set M, IsOpen N ∧ S₀ ⊆ N ∧ ∀ q ∈ N, (u : M → ℝ) q = 0 := fun u => u.2
  have hcoe : ∀ (a b : ℝ) (u v : ↥(ndsV0 S₀)),
      ((a • u + b • v : ↥(ndsV0 S₀)) : M → ℝ) =
        fun q => a * (u : M → ℝ) q + b * (v : M → ℝ) q := by
    intro a b u v
    funext q
    simp
  obtain ⟨B, hB⟩ : ∃ B : ↥(ndsV0 S₀) → ↥(ndsV0 S₀) → ℝ, ∀ u w,
      B u w = ndsInt g A (fun q => g.gradInner (u : M → ℝ) (w : M → ℝ) q) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : ↥(ndsV0 S₀) → ℝ, ∀ u,
      L u = ndsInt g A (fun q => f q * (u : M → ℝ) q) := ⟨_, fun _ => rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : ↥(ndsV0 S₀) → ℝ, ∀ u,
      Q u = ndsInt g A (fun q => (u : M → ℝ) q ^ 2) := ⟨_, fun _ => rfl⟩
  have hBsymm : ∀ u w, B u w = B w u := by
    intro u w
    rw [hB, hB]
    congr 1
    funext q
    exact (gradInner_symm_nonneg g _ _ q).2
  have hBlin : ∀ (a b : ℝ) (u v w : ↥(ndsV0 S₀)),
      B (a • u + b • v) w = a * B u w + b * B v w := by
    intro a b u v w
    rw [hB, hB, hB, hcoe]
    have h1 : (fun q => g.gradInner (fun q => a * (u : M → ℝ) q + b * (v : M → ℝ) q)
        (w : M → ℝ) q) = fun q => a * g.gradInner (u : M → ℝ) (w : M → ℝ) q +
          b * g.gradInner (v : M → ℝ) (w : M → ℝ) q := by
      funext q
      exact ((lapM_gradInner_linear_local g _ _ (w : M → ℝ) q).1 (hsm u).1 (hsm v).1 a b).2
    rw [h1]
    exact (nds_int_algebra g A _ _ (fun j => (hcc j _ _ (hsm u).1 (hsm w).1).2.2.1)
      (fun j => (hcc j _ _ (hsm v).1 (hsm w).1).2.2.1)).1 a b
  have hBnn : ∀ u, 0 ≤ B u u := by
    intro u
    rw [hB]
    exact (nds_int_algebra g A _ _ (fun j => (hcc j _ _ (hsm u).1 (hsm u).1).2.2.1)
      (fun j => (hcc j _ _ (hsm u).1 (hsm u).1).2.2.1)).2.1
      (fun q _ => (gradInner_symm_nonneg g (u : M → ℝ) (u : M → ℝ) q).1)
