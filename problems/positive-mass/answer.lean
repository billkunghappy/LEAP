theorem trapezoid_prism_flux (k s₁ s₂ h : ℝ) (X : E3 → E3) (hk : 0 < k) (hs₁ : 0 < s₁) (hs : s₁ < s₂) (hh : 0 < h) (hX : ContDiff ℝ ∞ X) : ∫ z in {z : E3 | s₁ < z 0 ∧ z 0 < s₂ ∧ |z 1| < k * z 0 ∧ |z 2| < h}, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z = -(∫ p in Set.Ioo s₁ s₂ ×ˢ Set.Ioo (-h) h, (k * X (cylPt p.1 (k * p.1) p.2) 0 - X (cylPt p.1 (k * p.1) p.2) 1 + (k * X (cylPt p.1 (-(k * p.1)) p.2) 0 + X (cylPt p.1 (-(k * p.1)) p.2) 1))) + (∫ p in Set.Ioo (-(k * s₂)) (k * s₂) ×ˢ Set.Ioo (-h) h, X (cylPt s₂ p.1 p.2) 0) - (∫ p in Set.Ioo (-(k * s₁)) (k * s₁) ×ˢ Set.Ioo (-h) h, X (cylPt s₁ p.1 p.2) 0) + (∫ p in {p : ℝ × ℝ | s₁ < p.1 ∧ p.1 < s₂ ∧ |p.2| < k * p.1}, (X (cylPt p.1 p.2 h) 2 - X (cylPt p.1 p.2 (-h)) 2)) :=
by
  classical
  have hcyl : ∀ a b c : ℝ, (cylPt a b c) 0 = a ∧ (cylPt a b c) 1 = b ∧ (cylPt a b c) 2 = c := by
    intro a b c
    simp [cylPt, EuclideanSpace.single_apply]
  have hT : Continuous (fun p : (ℝ × ℝ) × ℝ => cylPt p.1.1 p.1.2 p.2) := by
    unfold cylPt; fun_prop
  have hcc : ∀ f g c : ℝ × ℝ → ℝ, Continuous f → Continuous g → Continuous c →
      Continuous (fun q => cylPt (f q) (g q) (c q)) := by
    intro f g c hf hg hc
    unfold cylPt; fun_prop
