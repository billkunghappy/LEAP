    have hε0 : 0 < min δ ρ₂ := lt_min hδ hρ₂
    have hNo : IsOpen (P.O j₀ ∩ P.proj j₀ ⁻¹' Metric.ball x₀ (min δ ρ₂)) :=
      (P.proj_cont j₀).isOpen_inter_preimage (P.O_open j₀) Metric.isOpen_ball
    have hmemN : ∀ y ∈ P.W j₀, y ∈ Metric.ball x₀ (min δ ρ₂) →
        P.param j₀ y ∈ P.O j₀ ∩ P.proj j₀ ⁻¹' Metric.ball x₀ (min δ ρ₂) := by
      intro y hy hyb
      refine ⟨(hparamOS j₀ y hy).1, ?_⟩
      show P.proj j₀ (P.param j₀ y) ∈ Metric.ball x₀ (min δ ρ₂)
      rw [P.proj_param j₀ y hy]
      exact hyb
    refine ⟨_, hNo, hmemN x₀ hx₀W (Metric.mem_ball_self hε0), ?_, ?_⟩
    · rintro q ⟨⟨hqO, hqb⟩, hqS⟩ hne
      have hq' : q ∈ P.param j₀ '' P.W j₀ := by rw [P.image_eq]; exact ⟨hqO, hqS⟩
      obtain ⟨y, hy, rfl⟩ := hq'
      have hqb' : P.proj j₀ (P.param j₀ y) ∈ Metric.ball x₀ (min δ ρ₂) := hqb
      rw [P.proj_param j₀ y hy] at hqb'
      have hyne : y ≠ x₀ := by
        rintro rfl
