      generalize Real.sqrt (Dt x) = t at hT2 hT0 ⊢
      generalize Dt x = d at hT2 hDtx ⊢
      subst hT2
      generalize h x 0 0 = p at hDtx ⊢
      generalize h x 0 1 = q at hDtx ⊢
      generalize h x 1 1 = s at hDtx hS ⊢
      have hp : p = (t ^ 2 + q * q) / s := by
        field_simp
        linarith
      subst hp
      field_simp
      ring
  
  have lap2_div_of_contracted : ∀ (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (φ : E2 → ℝ) (hm : ∀ i j : Fin 2, ContDiffOn ℝ 1 (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j) (Metric.ball 0 ρ)) (hφ : ContDiffOn ℝ 2 φ (Metric.ball 0 ρ)) (hcc : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ j : Fin 2, ∑ i : Fin 2, pd2 i (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j) x = -(Real.sqrt (h x).det * ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * christoffel2 h j k l x)), ∀ x ∈ Metric.ball (0 : E2) ρ, Real.sqrt (h x).det * lap2 h φ x = ∑ i : Fin 2, pd2 i (fun y => Real.sqrt (h y).det * ∑ j : Fin 2, (h y)⁻¹ i j * pd2 j φ y) x := by
    intro ρ h φ hm hφ hcc x hx
    have hnx : Metric.ball (0 : E2) ρ ∈ 𝓝 x := Metric.isOpen_ball.mem_nhds hx
    have hmd : ∀ i j : Fin 2, HasFDerivAt (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j)
        (fderiv ℝ (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j) x) x :=
      fun i j => (((hm i j).differentiableOn (by simp)).differentiableAt hnx).hasFDerivAt
    have hdφ : ContDiffOn ℝ 1 (fun y => fderiv ℝ φ y) (Metric.ball 0 ρ) :=
      hφ.fderiv_of_isOpen Metric.isOpen_ball (by norm_num)
    have hg : ∀ j : Fin 2, HasFDerivAt (pd2 j φ) (fderiv ℝ (pd2 j φ) x) x := by
      intro j
      have hc : ContDiffOn ℝ 1 (pd2 j φ) (Metric.ball 0 ρ) := hdφ.clm_apply contDiffOn_const
      exact ((hc.differentiableOn (by simp)).differentiableAt hnx).hasFDerivAt
