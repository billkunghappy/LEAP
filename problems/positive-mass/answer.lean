  have hsub1 : Metric.ball (0 : E3) 1 ⊆ Metric.ball 0 2 :=
    Metric.ball_subset_ball (by norm_num)
  
  have hcont : ContinuousOn (fun x => ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3,
