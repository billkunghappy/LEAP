          · linarith [habs.1]
          · linarith
        rw [hn, zero_mul]
      · rw [hu _ ht, mul_zero]
    rw [hz, integral_zero]
  
  have hmollT : ∀ (bm : ContDiffBump (0 : E3)) (u : E3 → ℝ), MemLp u 2 volume →
