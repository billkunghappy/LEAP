      filter_upwards [hlim.eventually (gt_mem_nhds (sub_pos.2 htt'))] with n hn
      have hsub : Metric.closedBall x (t + h n) ⊆ Metric.ball x t' :=
        Metric.closedBall_subset_ball (by linarith)
      have hadm := hle (fun z => χ n z • X z) (Metric.ball x t') ((hχs n).smul hX)
        (hcs _ X hXc)
        (fun y hy => hsub (hχsupp n (tsupport_smul_subset_left _ _ hy)))
        (hsmul_n X (χ n) (hχ01 n) hXn)
      calc ENNReal.ofReal (∫ y in F, χ n y * D y)
          ≤ ENNReal.ofReal ((∫ y in F, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
            (fun z => χ n z • X z) y) + 2 * M * L) := ENNReal.ofReal_le_ofReal (hbd n)
        _ ≤ ENNReal.ofReal (∫ y in F, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
            (fun z => χ n z • X z) y) + ENNReal.ofReal (2 * M * L) := ENNReal.ofReal_add_le
        _ ≤ _ := add_le_add hadm le_rfl
    have hpt : ∀ y, Tendsto (fun n => χ n y) atTop
        (𝓝 ((Metric.closedBall x t).indicator (fun _ => (1 : ℝ)) y)) := by
      intro y
      by_cases hy : dist y x ≤ t
      · have hyc : y ∈ Metric.closedBall x t := hy
        rw [Set.indicator_of_mem hyc]
        have : (fun n => χ n y) = fun _ => (1 : ℝ) := by
          funext n; simp only [hχ]; rw [hR0 n y hy]; ring
        rw [this]
        exact tendsto_const_nhds
      · have hyc : y ∉ Metric.closedBall x t := hy
        rw [Set.indicator_of_notMem hyc]
        push_neg at hy
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [hlim.eventually (gt_mem_nhds (sub_pos.2 hy))] with n hn
        simp only [hχ]
        rw [hR1 n y (by linarith)]
        ring
    have hlimD := dom_lim F (Metric.closedBall x t) D χ measurableSet_closedBall hD
      (fun n => (hχs n).continuous) (fun n => habs _ (hχ01 n)) hpt
    rw [(sphere_congr F x t D).2] at hlimD
    exact le_of_tendsto (ENNReal.tendsto_ofReal hlimD) hev

theorem sepMono_cube_growth (m : ℝ → ℝ) (s c₁ : ℝ) (hs : 0 < s) (hc₁ : 0 < c₁) (hmono : Monotone m) (hpos : ∀ t, 0 < t → t < s → 0 < m t) (hder : ∀ᵐ t ∂(MeasureTheory.volume : MeasureTheory.Measure ℝ), 0 < t → t < s → ∀ d : ℝ, HasDerivAt m d t → c₁ * m t ^ ((2 : ℝ) / 3) ≤ d) : (c₁ / 3) ^ 3 * s ^ 3 ≤ m s :=
by
  have hlim : ∀ (K M : ℝ), (∀ x : ℝ, 0 < x → x < s → K * x ^ 3 ≤ M) → K * s ^ 3 ≤ M := by
    intro K M h
    have ht : Filter.Tendsto (fun x : ℝ => K * x ^ 3) (nhdsWithin s (Set.Iio s))
        (nhds (K * s ^ 3)) :=
      ((continuous_const.mul (continuous_pow 3)).tendsto s).mono_left nhdsWithin_le_nhds
    refine le_of_tendsto ht ?_
    filter_upwards [Ioo_mem_nhdsLT hs] with x hx
    exact h x hx.1 hx.2
  apply hlim
  intro x hx0 hxs
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (s - x) / 2 := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : ℝ, b = (s + x) / 2 := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [ha]; linarith
  have hab : a ≤ b := by rw [ha, hb]; linarith
  have hbs : b < s := by rw [hb]; linarith
  have hba : b - a = x := by rw [ha, hb]; ring
  have hposI : ∀ u ∈ Set.Icc a b, 0 < m u :=
    fun u hu => hpos u (by linarith [hu.1]) (by linarith [hu.2])
  have hfmono : MonotoneOn (fun u => m u ^ ((1 : ℝ) / 3)) (Set.Icc a b) := by
    intro u hu v _ huv
    exact Real.rpow_le_rpow (hposI u hu).le (hmono huv) (by norm_num)
  have hderiv : ∀ t d : ℝ, 0 < m t → HasDerivAt m d t → c₁ * m t ^ ((2 : ℝ) / 3) ≤ d →
      c₁ / 3 ≤ deriv (fun u => m u ^ ((1 : ℝ) / 3)) t := by
    intro t d hm hd hle
    have h1 := hd.rpow_const (p := (1 : ℝ) / 3) (Or.inl hm.ne')
    rw [h1.deriv]
    have hA : 0 < m t ^ ((1 : ℝ) / 3 - 1) := Real.rpow_pos_of_pos hm _
    have hid : m t ^ ((2 : ℝ) / 3) * m t ^ ((1 : ℝ) / 3 - 1) = 1 := by
      rw [← Real.rpow_add hm]; norm_num
    have h2 : c₁ * m t ^ ((2 : ℝ) / 3) * m t ^ ((1 : ℝ) / 3 - 1) ≤
        d * m t ^ ((1 : ℝ) / 3 - 1) := mul_le_mul_of_nonneg_right hle hA.le
    have h3 : c₁ * m t ^ ((2 : ℝ) / 3) * m t ^ ((1 : ℝ) / 3 - 1) = c₁ := by
      rw [mul_assoc, hid, mul_one]
    linarith
  have hae : ∀ᵐ t ∂(MeasureTheory.volume : MeasureTheory.Measure ℝ), t ∈ Set.Icc a b →
      c₁ / 3 ≤ deriv (fun u => m u ^ ((1 : ℝ) / 3)) t := by
    filter_upwards [hder, hmono.ae_differentiableAt] with t h1 h2
    intro htI
    have ht0 : 0 < t := by linarith [htI.1]
    have hts : t < s := by linarith [htI.2]
    exact hderiv t (deriv m t) (hposI t htI) h2.hasDerivAt
      (h1 ht0 hts (deriv m t) h2.hasDerivAt)
  have hf' : MonotoneOn (fun u => m u ^ ((1 : ℝ) / 3)) (Set.uIcc a b) := by
    rw [Set.uIcc_of_le hab]; exact hfmono
  have hfab : m a ^ ((1 : ℝ) / 3) ≤ m b ^ ((1 : ℝ) / 3) :=
    hfmono ⟨le_rfl, hab⟩ ⟨hab, le_rfl⟩ hab
  have hD : 0 ≤ m b ^ ((1 : ℝ) / 3) - m a ^ ((1 : ℝ) / 3) := by linarith
  have hI2 : (∫ u in a..b, deriv (fun u => m u ^ ((1 : ℝ) / 3)) u) ≤
      m b ^ ((1 : ℝ) / 3) - m a ^ ((1 : ℝ) / 3) := by
    have hI := hf'.intervalIntegral_deriv_mem_uIcc
    rcases Set.mem_uIcc.1 hI with h | h
    · exact h.2
    · have h2 : (∫ u in a..b, deriv (fun u => m u ^ ((1 : ℝ) / 3)) u) ≤ 0 := h.2
      linarith
  have hlow : (∫ _ in a..b, (c₁ / 3)) ≤
      ∫ u in a..b, deriv (fun u => m u ^ ((1 : ℝ) / 3)) u :=
    intervalIntegral.integral_mono_ae_restrict hab intervalIntegrable_const
      hf'.intervalIntegrable_deriv ((MeasureTheory.ae_restrict_iff' measurableSet_Icc).2 hae)
  rw [intervalIntegral.integral_const, smul_eq_mul, hba] at hlow
  have hfa : 0 < m a ^ ((1 : ℝ) / 3) := Real.rpow_pos_of_pos (hposI a ⟨le_rfl, hab⟩) _
  have hmb := hposI b ⟨hab, le_rfl⟩
  have h3 : (c₁ / 3 * x) ^ 3 ≤ (m b ^ ((1 : ℝ) / 3)) ^ 3 :=
    pow_le_pow_left₀ (by positivity) (by linarith) 3
  have hcube : (m b ^ ((1 : ℝ) / 3)) ^ 3 = m b := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hmb.le]; norm_num
  calc (c₁ / 3) ^ 3 * x ^ 3 = (c₁ / 3 * x) ^ 3 := by ring
    _ ≤ m b := h3.trans hcube.le
    _ ≤ m s := hmono hbs.le

theorem sepPerMin_density_lower : ∃ η₁ c₀ : ℝ, 0 < η₁ ∧ 0 < c₀ ∧ c₀ ≤ 1 ∧ ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (x : E3) (s : ℝ), IsOpen U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) → (∀ y ∈ U, (G y).PosDef) → (∀ y ∈ U, ∀ i j : Fin 3, |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ η₁) → sepIsPerMin G F U → 0 < s → Metric.closedBall x s ⊆ U → (∀ N ∈ 𝓝 x, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) → ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (F ∩ Metric.ball x s) ∧ ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball x s \ F) :=
by
  obtain ⟨Ciso, hCiso, hiso⟩ := sepPerE_isoperimetric
  obtain ⟨C, hC, hcut⟩ := sepPerE_radial_cut
  obtain ⟨K₁, hK₁⟩ : ∃ K : ℝ, K = 5 * Ciso * (C + 1) := ⟨_, rfl⟩
  have hK₁pos : 0 < K₁ := by rw [hK₁]; positivity
  obtain ⟨c₁, hc₁⟩ : ∃ c : ℝ, c = 1 / K₁ := ⟨_, rfl⟩
  have hc₁pos : 0 < c₁ := by rw [hc₁]; positivity
  refine ⟨1 / 100, min 1 ((c₁ / 3) ^ 3), by norm_num, lt_min one_pos (by positivity),
    min_le_left _ _, ?_⟩
  intro G F U x s hU hG hsymm hpd hclose hmin hs hball hbd
  
  have hmono : ∀ (S V₁ V₂ : Set E3), V₁ ⊆ V₂ →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V₁ ≤
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V₂ := by
    intro S V₁ V₂ hV
    unfold sepPerG
    exact iSup_mono fun X => iSup_mono' fun h =>
      ⟨⟨h.1, h.2.1, h.2.2.1.trans hV, h.2.2.2⟩, le_rfl⟩
  
  have hsum2 : ∀ (S A B : Set E3), MeasurableSet S → Disjoint A B →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S A +
          sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S B ≤
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (A ∪ B) := by
    intro S A B hS hAB
    have hpw : Pairwise (fun k l : Fin 2 => Disjoint (![A, B] k) (![A, B] l)) := by
      intro k l hkl
      fin_cases k <;> fin_cases l <;> simp at hkl ⊢
      · exact hAB
      · exact hAB.symm
    have h := sepPerG_sum_le (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S hS 2 ![A, B] hpw
    have hU2 : (⋃ k, ![A, B] k) = A ∪ B := by
      ext y
      simp [Fin.exists_fin_two]
    rw [Fin.sum_univ_two, hU2] at h
    simpa using h
  
  have core : ∀ S : Set E3, MeasurableSet S →
      (∀ V : Set E3, IsOpen V → IsCompact (closure V) → closure V ⊆ U →
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V < ⊤) →
      (∀ S' V K : Set E3, MeasurableSet S' → IsOpen V → IsCompact (closure V) → closure V ⊆ U →
        IsCompact K → K ⊆ V → symmDiff S S' ⊆ K →
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤
          4 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S' V) →
      (∀ N ∈ 𝓝 x, volume (N ∩ S) ≠ 0) →
      ENNReal.ofReal (min 1 ((c₁ / 3) ^ 3) * s ^ 3) ≤ volume (S ∩ Metric.ball x s) := by
    intro S hS hfin hqm hposS
    set m : ℝ → ℝ := fun t => (volume (S ∩ Metric.ball x t)).toReal with hm
    set P : ℝ → ENNReal := fun t =>
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (Metric.ball x t) with hP
    have hfinvol : ∀ t, volume (S ∩ Metric.ball x t) ≠ ⊤ := fun t =>
      ne_top_of_le_ne_top (measure_ball_lt_top (μ := volume) (x := x) (r := t)).ne
        (measure_mono Set.inter_subset_right)
    have hmeq : ∀ t, ENNReal.ofReal (m t) = volume (S ∩ Metric.ball x t) := fun t =>
      ENNReal.ofReal_toReal (hfinvol t)
    have hmmono : Monotone m := by
      intro a b hab
      exact ENNReal.toReal_mono (hfinvol b)
        (measure_mono (Set.inter_subset_inter_right _ (Metric.ball_subset_ball hab)))
    have hmpos : ∀ t, 0 < t → 0 < m t := by
      intro t ht
      have h1 := hposS (Metric.ball x t) (Metric.ball_mem_nhds x ht)
      rw [Set.inter_comm] at h1
      exact ENNReal.toReal_pos h1 (hfinvol t)
    have hPmono : Monotone P := fun a b hab => hmono S _ _ (Metric.ball_subset_ball hab)
    have hPfin : ∀ t, 0 < t → t ≤ s → P t ≠ ⊤ := by
      intro t ht hts
      refine (hfin _ Metric.isOpen_ball ?_ ?_).ne
      · rw [closure_ball x ht.ne']
        exact isCompact_closedBall x t
      · rw [closure_ball x ht.ne']
        exact (Metric.closedBall_subset_closedBall hts).trans hball
    
    have hkey : ∀ t, ContinuousAt P t → 0 < t → t < s → ∀ d, HasDerivAt m d t →
        c₁ * m t ^ ((2 : ℝ) / 3) ≤ d := by
      intro t hPc ht hts d hd
      by_contra hlt
      push_neg at hlt
      have ha : 0 < m t ^ ((2 : ℝ) / 3) := Real.rpow_pos_of_pos (hmpos t ht) _
      have hca : 0 < c₁ * m t ^ ((2 : ℝ) / 3) := mul_pos hc₁pos ha
      obtain ⟨L, hL⟩ : ∃ L : ℝ, L = (max d 0 + c₁ * m t ^ ((2 : ℝ) / 3)) / 2 := ⟨_, rfl⟩
      have hmaxlt : max d 0 < c₁ * m t ^ ((2 : ℝ) / 3) := max_lt hlt hca
      have hLd : d < L := by have := le_max_left d 0; rw [hL]; linarith
      have hL0 : 0 < L := by have := le_max_right d 0; rw [hL]; linarith
      have hLc : L < c₁ * m t ^ ((2 : ℝ) / 3) := by rw [hL]; linarith
      have hLa : K₁ * L < m t ^ ((2 : ℝ) / 3) := by
        have h1 : K₁ * L < K₁ * (c₁ * m t ^ ((2 : ℝ) / 3)) := mul_lt_mul_of_pos_left hLc hK₁pos
        have h2 : K₁ * (c₁ * m t ^ ((2 : ℝ) / 3)) = m t ^ ((2 : ℝ) / 3) := by
          rw [hc₁, ← mul_assoc, mul_one_div_cancel hK₁pos.ne', one_mul]
        linarith
      
      have hev : ∀ᶠ h in 𝓝[>] (0 : ℝ), h⁻¹ • (m (t + h) - m t) < L :=
        hd.tendsto_slope_zero_right.eventually (gt_mem_nhds hLd)
      obtain ⟨δ, hδ, hδb⟩ := Metric.eventually_nhds_iff.1 (eventually_nhdsWithin_iff.1 hev)
      have hgrow : ∀ h, 0 < h → h < δ → m (t + h) ≤ m t + L * h := by
        intro h hh hhδ
        have h1 := hδb (by rw [Real.dist_eq, sub_zero, abs_of_pos hh]; exact hhδ)
          (Set.mem_Ioi.2 hh)
        rw [smul_eq_mul, inv_mul_lt_iff₀ hh] at h1
        linarith
      obtain ⟨hseq, hhseq⟩ : ∃ f : ℕ → ℝ, f = fun n : ℕ => δ / 2 * (1 / ((n : ℝ) + 1)) :=
        ⟨_, rfl⟩
      have hseqpos : ∀ n, 0 < hseq n := fun n => by rw [hhseq]; positivity
      have hseqlt : ∀ n, hseq n < δ := by
        intro n
        have h1 : 1 / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]
          linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
        have h2 : hseq n ≤ δ / 2 := by
          rw [hhseq]
          exact mul_le_of_le_one_right (by positivity) h1
        linarith
      have hseqt : Tendsto hseq atTop (𝓝 0) := by
        have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul (δ / 2)
        rw [mul_zero] at h1
        rw [hhseq]
        exact h1
      have hgrowth : ∀ n, volume (S ∩ Metric.closedBall x (t + hseq n)) ≤
          volume (S ∩ Metric.ball x t) + ENNReal.ofReal (L * hseq n) := by
        intro n
        calc volume (S ∩ Metric.closedBall x (t + hseq n))
            ≤ volume (S ∩ Metric.ball x (t + hseq n) ∪ Metric.sphere x (t + hseq n)) := by
              apply measure_mono
              rintro y ⟨hyS, hyB⟩
              rw [Metric.mem_closedBall] at hyB
              rcases hyB.lt_or_eq with h | h
              · exact Or.inl ⟨hyS, Metric.mem_ball.2 h⟩
              · exact Or.inr (Metric.mem_sphere.2 h)
          _ ≤ volume (S ∩ Metric.ball x (t + hseq n)) + volume (Metric.sphere x (t + hseq n)) :=
              measure_union_le _ _
          _ = ENNReal.ofReal (m (t + hseq n)) := by
              rw [Measure.addHaar_sphere, add_zero, hmeq]
          _ ≤ ENNReal.ofReal (m t + L * hseq n) :=
              ENNReal.ofReal_le_ofReal (hgrow _ (hseqpos n) (hseqlt n))
          _ ≤ ENNReal.ofReal (m t) + ENNReal.ofReal (L * hseq n) := ENNReal.ofReal_add_le
          _ = volume (S ∩ Metric.ball x t) + ENNReal.ofReal (L * hseq n) := by rw [hmeq]
      have hcutt := fun V : Set E3 => hcut S V x t L hseq hS ht hL0.le hseqpos hseqt hgrowth
      
      have hineq : ∀ t', t < t' → t' < s →
          4 * (P t).toReal ≤ 3 * (P t').toReal + 4 * (C * L) := by
        intro t' htt' ht's
        have ht'0 : 0 < t' := ht.trans htt'
        have hPt' : P t' ≠ ⊤ := hPfin t' ht'0 ht's.le
        have hA := (hcutt (Metric.ball x t')).1
        have hQ : P t' ≤ 4 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
            (S \ Metric.ball x t) (Metric.ball x t') := by
          apply hqm (S \ Metric.ball x t) (Metric.ball x t') (Metric.closedBall x t)
            (hS.diff measurableSet_ball) Metric.isOpen_ball
          · rw [closure_ball x ht'0.ne']
            exact isCompact_closedBall x t'
          · rw [closure_ball x ht'0.ne']
            exact (Metric.closedBall_subset_closedBall ht's.le).trans hball
          · exact isCompact_closedBall x t
          · exact Metric.closedBall_subset_ball htt'
          · rintro y (⟨hy1, hy2⟩ | ⟨hy1, hy2⟩)
            · by_contra hy
              exact hy2 ⟨hy1, fun hb => hy (Metric.ball_subset_closedBall hb)⟩
            · exact absurd hy1.1 hy2
        have hsup : P t + sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S
            (Metric.ball x t' \ Metric.closedBall x t) ≤ P t' := by
          refine (hsum2 S _ _ hS ?_).trans (hmono S _ _ ?_)
          · exact Set.disjoint_left.2 fun y hy1 hy2 => hy2.2 (Metric.ball_subset_closedBall hy1)
          · exact Set.union_subset (Metric.ball_subset_ball htt'.le) Set.diff_subset
        have hAfin : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S
            (Metric.ball x t' \ Metric.closedBall x t) ≠ ⊤ :=
          ne_top_of_le_ne_top hPt' (le_trans le_add_self hsup)
        have hPtfin : P t ≠ ⊤ := ne_top_of_le_ne_top hPt' (le_trans le_self_add hsup)
        have hQfin : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
            (S \ Metric.ball x t) (Metric.ball x t') ≠ ⊤ :=
          ne_top_of_le_ne_top (ENNReal.add_ne_top.2 ⟨hAfin, ENNReal.ofReal_ne_top⟩) hA
        have r1 := ENNReal.toReal_mono (ENNReal.mul_ne_top (by norm_num) hQfin) hQ
        rw [ENNReal.toReal_mul, ENNReal.toReal_ofNat] at r1
        have r2 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨hAfin, ENNReal.ofReal_ne_top⟩) hA
        rw [ENNReal.toReal_add hAfin ENNReal.ofReal_ne_top,
          ENNReal.toReal_ofReal (mul_nonneg hC hL0.le)] at r2
        have r3 := ENNReal.toReal_mono hPt' hsup
        rw [ENNReal.toReal_add hPtfin hAfin] at r3
        linarith
      have hPtfin : P t ≠ ⊤ := hPfin t ht hts.le
      have hpc : Tendsto (fun t' => (P t').toReal) (𝓝[>] t) (𝓝 (P t).toReal) :=
        ((ENNReal.tendsto_toReal hPtfin).comp hPc.tendsto).mono_left nhdsWithin_le_nhds
      have hlim1 : 4 * (P t).toReal ≤ 3 * (P t).toReal + 4 * (C * L) := by
        refine ge_of_tendsto ((hpc.const_mul 3).add_const (4 * (C * L))) ?_
        filter_upwards [Ioo_mem_nhdsGT hts] with t' ht'
        exact hineq t' ht'.1 ht'.2
      have hPt_le : P t ≤ ENNReal.ofReal (4 * (C * L)) := by
        rw [← ENNReal.ofReal_toReal hPtfin]
        exact ENNReal.ofReal_le_ofReal (by linarith)
      have hPS : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (S ∩ Metric.ball x t) Set.univ
          ≤ P t + ENNReal.ofReal (C * L) := by
        have hPt : Tendsto (fun t' => P t' + ENNReal.ofReal (C * L)) (𝓝[>] t)
            (𝓝 (P t + ENNReal.ofReal (C * L))) :=
          (hPc.tendsto.mono_left nhdsWithin_le_nhds).add tendsto_const_nhds
        refine ge_of_tendsto hPt ?_
        filter_upwards [self_mem_nhdsWithin] with t' ht'
        exact (hcutt (Metric.ball x t')).2 t' ht'
      have hiso' := hiso (S ∩ Metric.ball x t) (hS.inter measurableSet_ball)
        (Metric.isBounded_ball.subset Set.inter_subset_right)
      have hbound : volume (S ∩ Metric.ball x t) ^ ((2 : ℝ) / 3) ≤
          ENNReal.ofReal (Ciso * (5 * (C * L))) := by
        calc volume (S ∩ Metric.ball x t) ^ ((2 : ℝ) / 3)
            ≤ ENNReal.ofReal Ciso * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
                (S ∩ Metric.ball x t) Set.univ := hiso'
          _ ≤ ENNReal.ofReal Ciso * (ENNReal.ofReal (4 * (C * L)) + ENNReal.ofReal (C * L)) :=
              mul_le_mul_left' (hPS.trans (add_le_add hPt_le le_rfl)) _
          _ = ENNReal.ofReal (Ciso * (5 * (C * L))) := by
              rw [← ENNReal.ofReal_add (by positivity) (by positivity),
                ← ENNReal.ofReal_mul hCiso.le]
              congr 1
              ring
      rw [← hmeq t, ENNReal.ofReal_rpow_of_nonneg (hmpos t ht).le (by norm_num)] at hbound
      have h5 : m t ^ ((2 : ℝ) / 3) ≤ Ciso * (5 * (C * L)) :=
        (ENNReal.ofReal_le_ofReal_iff (by positivity)).1 hbound
      have h6 : K₁ * L - Ciso * (5 * (C * L)) = 5 * (Ciso * L) := by rw [hK₁]; ring
      have h7 : 0 < Ciso * L := mul_pos hCiso hL0
      linarith
    
    have hcount : Set.Countable {t | ¬ ContinuousAt P t} := hPmono.countable_not_continuousAt
    have hder : ∀ᵐ t ∂(volume : Measure ℝ), 0 < t → t < s → ∀ d, HasDerivAt m d t →
        c₁ * m t ^ ((2 : ℝ) / 3) ≤ d := by
      refine (hcount.ae_notMem volume).mono ?_
      intro t ht h0 hts d hd
      exact hkey t (by simpa using ht) h0 hts d hd
    have h5 := sepMono_cube_growth m s c₁ hs hc₁pos hmmono (fun t ht _ => hmpos t ht) hder
    calc ENNReal.ofReal (min 1 ((c₁ / 3) ^ 3) * s ^ 3) ≤ ENNReal.ofReal (m s) := by
          apply ENNReal.ofReal_le_ofReal
          calc min 1 ((c₁ / 3) ^ 3) * s ^ 3 ≤ (c₁ / 3) ^ 3 * s ^ 3 :=
                mul_le_mul_of_nonneg_right (min_le_right _ _) (by positivity)
            _ ≤ m s := h5
      _ = volume (S ∩ Metric.ball x s) := hmeq s
  
  have hcmp := fun (S V : Set E3) (hV : V ⊆ U) => sepPerG_one_compare G U hU hG hclose S V hV
  have hFfin : ∀ V : Set E3, IsOpen V → IsCompact (closure V) → closure V ⊆ U →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F V < ⊤ := by
    intro V hVo hVc hVU
    calc sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F V ≤ 2 * sepPerG G F V :=
          (hcmp F V (subset_closure.trans hVU)).1
      _ < ⊤ := ENNReal.mul_lt_top (by norm_num) (hmin.2.1 V hVo hVc hVU)
  have hFqm : ∀ S' V K : Set E3, MeasurableSet S' → IsOpen V → IsCompact (closure V) →
      closure V ⊆ U → IsCompact K → K ⊆ V → symmDiff F S' ⊆ K →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F V ≤
        4 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S' V := by
    intro S' V K hS' hVo hVc hVU hK hKV hsd
    have hVU' : V ⊆ U := subset_closure.trans hVU
    calc sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F V ≤ 2 * sepPerG G F V :=
          (hcmp F V hVU').1
      _ ≤ 2 * sepPerG G S' V :=
          mul_le_mul_left' (hmin.2.2 S' V K hS' hVo hVc hVU hK hKV hsd) 2
      _ ≤ 2 * (2 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S' V) :=
          mul_le_mul_left' (hcmp S' V hVU').2 2
      _ = 4 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S' V := by
          rw [← mul_assoc]
          norm_num
  
  have hFcfin : ∀ V : Set E3, IsOpen V → IsCompact (closure V) → closure V ⊆ U →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Fᶜ V < ⊤ := by
    intro V hVo hVc hVU
    rw [sepPerG_one_compl F V hmin.1]
    exact hFfin V hVo hVc hVU
  have hFcqm : ∀ S' V K : Set E3, MeasurableSet S' → IsOpen V → IsCompact (closure V) →
      closure V ⊆ U → IsCompact K → K ⊆ V → symmDiff Fᶜ S' ⊆ K →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Fᶜ V ≤
        4 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S' V := by
    intro S' V K hS' hVo hVc hVU hK hKV hsd
    have hsd' : symmDiff F S'ᶜ ⊆ K := by
      have he : symmDiff F S'ᶜ = symmDiff Fᶜ S' := by
        rw [← compl_symmDiff_compl, compl_compl]
      rw [he]
      exact hsd
    rw [sepPerG_one_compl F V hmin.1, ← sepPerG_one_compl S' V hS']
    exact hFqm S'ᶜ V K hS'.compl hVo hVc hVU hK hKV hsd'
  
  refine ⟨core F hmin.1 hFfin hFqm (fun N hN => (hbd N hN).1), ?_⟩
  have h2 := core Fᶜ hmin.1.compl hFcfin hFcqm
    (fun N hN => by rw [← Set.diff_eq]; exact (hbd N hN).2)
  rwa [Set.inter_comm, ← Set.diff_eq] at h2

theorem sepFlat_L1_to_slab (F : Set E3) (ν : E3) (c₀ τ : ℝ) (hν : ‖ν‖ = 1) (hc₀ : 0 < c₀) (hc₀1 : c₀ ≤ 1) (hτ : 0 < τ) (hτ16 : τ ≤ 1 / 16) (hdens : ∀ x ∈ Metric.ball (0 : E3) 1, (∀ N ∈ 𝓝 x, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) → ∀ s : ℝ, 0 < s → s ≤ 1 / 2 → ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (F ∩ Metric.ball x s) ∧ ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball x s \ F)) (hL1 : volume (symmDiff F {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1) < ENNReal.ofReal (c₀ * τ ^ 3)) : (∀ z ∈ Metric.ball (0 : E3) (1 / 2), (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) → |@inner ℝ E3 _ ν z| ≤ τ) ∧ volume ((Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ}) \ F) = 0 ∧ volume (Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z} ∩ F) = 0 :=
by
  
  have ha : ∀ z ∈ Metric.ball (0 : E3) (1 / 2),
      (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) → |@inner ℝ E3 _ ν z| ≤ τ := by
    intro z hz hb
    have hz' : ‖z‖ < 1 / 2 := mem_ball_zero_iff.mp hz
    have hz1 : z ∈ Metric.ball (0 : E3) 1 := mem_ball_zero_iff.mpr (by linarith)
    obtain ⟨D1, D2⟩ := hdens z hz1 hb τ hτ (by linarith)
    have hgeo : ∀ w ∈ Metric.ball z τ,
        |@inner ℝ E3 _ ν w - @inner ℝ E3 _ ν z| < τ ∧ w ∈ Metric.ball (0 : E3) 1 := by
      intro w hw
      have hw' : ‖w - z‖ < τ := by rwa [Metric.mem_ball, dist_eq_norm] at hw
      refine ⟨?_, ?_⟩
      · rw [← inner_sub_right]
        calc |@inner ℝ E3 _ ν (w - z)| ≤ ‖ν‖ * ‖w - z‖ := abs_real_inner_le_norm _ _
          _ = ‖w - z‖ := by rw [hν, one_mul]
          _ < τ := hw'
      · rw [mem_ball_zero_iff]
        have := norm_sub_norm_le w z
        linarith
    rw [abs_le]
    constructor
    · by_contra hlt
      push_neg at hlt
      have hsub : Metric.ball z τ \ F ⊆
          symmDiff F {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1 := by
        rintro w ⟨hw, hwF⟩
        obtain ⟨h1, h2⟩ := hgeo w hw
        refine ⟨Set.mem_symmDiff.mpr (Or.inr ⟨?_, hwF⟩), h2⟩
        show @inner ℝ E3 _ ν w < 0
        have := (abs_lt.mp h1).2
        linarith
      exact lt_irrefl _ (lt_of_le_of_lt (D2.trans (measure_mono hsub)) hL1)
    · by_contra hlt
      push_neg at hlt
      have hsub : F ∩ Metric.ball z τ ⊆
          symmDiff F {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1 := by
        rintro w ⟨hwF, hw⟩
        obtain ⟨h1, h2⟩ := hgeo w hw
        refine ⟨Set.mem_symmDiff.mpr (Or.inl ⟨hwF, ?_⟩), h2⟩
        show ¬ (@inner ℝ E3 _ ν w < 0)
        have := (abs_lt.mp h1).1
        linarith
      exact lt_irrefl _ (lt_of_le_of_lt (D1.trans (measure_mono hsub)) hL1)
  
  have hdich : ∀ S : Set E3, IsPreconnected S →
      (∀ z ∈ S, ¬ (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0)) →
      volume (S ∩ F) = 0 ∨ volume (S \ F) = 0 := by
    intro S hS hnb
    let U₀ : Set E3 := {x | ∃ N ∈ 𝓝 x, volume (N ∩ F) = 0}
    let U₁ : Set E3 := {x | ∃ N ∈ 𝓝 x, volume (N \ F) = 0}
    have hU₀o : IsOpen U₀ := by
      rw [isOpen_iff_mem_nhds]
      rintro x ⟨N, hN, h0⟩
      refine Filter.mem_of_superset (interior_mem_nhds.mpr hN) ?_
      intro y hy
      exact ⟨N, mem_interior_iff_mem_nhds.mp hy, h0⟩
    have hU₁o : IsOpen U₁ := by
      rw [isOpen_iff_mem_nhds]
      rintro x ⟨N, hN, h0⟩
      refine Filter.mem_of_superset (interior_mem_nhds.mpr hN) ?_
      intro y hy
      exact ⟨N, mem_interior_iff_mem_nhds.mp hy, h0⟩
    have hdisj : Disjoint U₁ U₀ := by
      rw [Set.disjoint_left]
      rintro x ⟨N₁, hN₁, h1⟩ ⟨N₀, hN₀, h0⟩
      have hM : N₀ ∩ N₁ ∈ 𝓝 x := Filter.inter_mem hN₀ hN₁
      have hpos : 0 < volume (N₀ ∩ N₁) := Measure.measure_pos_of_mem_nhds volume hM
      have hle : volume (N₀ ∩ N₁) ≤ volume ((N₀ ∩ N₁) ∩ F) + volume ((N₀ ∩ N₁) \ F) :=
        measure_le_inter_add_diff _ _ _
      have h0' : volume ((N₀ ∩ N₁) ∩ F) = 0 :=
        measure_mono_null (fun y (hy : y ∈ (N₀ ∩ N₁) ∩ F) => (⟨hy.1.1, hy.2⟩ : y ∈ N₀ ∩ F)) h0
      have h1' : volume ((N₀ ∩ N₁) \ F) = 0 :=
        measure_mono_null (fun y (hy : y ∈ (N₀ ∩ N₁) \ F) => (⟨hy.1.2, hy.2⟩ : y ∈ N₁ \ F)) h1
      rw [h0', h1', add_zero] at hle
      exact absurd (lt_of_lt_of_le hpos hle) (lt_irrefl 0)
    have hcov : S ⊆ U₁ ∪ U₀ := by
      intro z hz
      have h := hnb z hz
      push_neg at h
      obtain ⟨N, hN, hN'⟩ := h
      by_cases h0 : volume (N ∩ F) = 0
      · exact Or.inr ⟨N, hN, h0⟩
      · exact Or.inl ⟨N, hN, hN' h0⟩
    have hloc : ∀ s : Set E3, (∀ x ∈ s, ∃ N ∈ 𝓝 x, volume (s ∩ N) = 0) → volume s = 0 := by
      intro s hs
      refine measure_null_of_locally_null s (fun x hx => ?_)
      obtain ⟨N, hN, h0⟩ := hs x hx
      exact ⟨s ∩ N, inter_mem_nhdsWithin s hN, h0⟩
    by_cases hne : (S ∩ U₁).Nonempty
    · right
      have hSU : S ⊆ U₁ := hS.subset_left_of_subset_union hU₁o hU₀o hdisj hcov hne
      apply hloc
      intro x hx
      obtain ⟨N, hN, h0⟩ := hSU hx.1
      exact ⟨N, hN, measure_mono_null
        (fun y (hy : y ∈ (S \ F) ∩ N) => (⟨hy.2, hy.1.2⟩ : y ∈ N \ F)) h0⟩
    · left
      apply hloc
      intro x hx
      have hx0 : x ∈ U₀ := by
        rcases hcov hx.1 with h | h
        · exact absurd ⟨x, hx.1, h⟩ hne
        · exact h
      obtain ⟨N, hN, h0⟩ := hx0
      exact ⟨N, hN, measure_mono_null
        (fun y (hy : y ∈ (S ∩ F) ∩ N) => (⟨hy.2, hy.1.2⟩ : y ∈ N ∩ F)) h0⟩
  
  have hvolB : ∀ c : E3, ENNReal.ofReal (1 / 4096) < volume (Metric.ball c (1 / 8)) := by
    intro c
    rw [EuclideanSpace.volume_ball_fin_three, ← ENNReal.ofReal_pow (by norm_num),
      ← ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_lt_ofReal_iff (by positivity)]
    nlinarith [Real.pi_gt_three]
  have hvn : ‖(1 / 4 : ℝ) • ν‖ = 1 / 4 := by
    rw [norm_smul, hν, Real.norm_of_nonneg (by norm_num)]; norm_num
  have hvi : @inner ℝ E3 _ ν ((1 / 4 : ℝ) • ν) = 1 / 4 := by
    rw [real_inner_smul_right, real_inner_self_eq_norm_sq, hν]; norm_num
  have hcapm : Metric.ball (-((1 / 4 : ℝ) • ν)) (1 / 8) ⊆
      Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ} := by
    intro w hw
    have hw' : ‖w + (1 / 4 : ℝ) • ν‖ < 1 / 8 := by
      rwa [Metric.mem_ball, dist_eq_norm, sub_neg_eq_add] at hw
    have hi : @inner ℝ E3 _ ν (w + (1 / 4 : ℝ) • ν) ≤ ‖w + (1 / 4 : ℝ) • ν‖ := by
      have := real_inner_le_norm ν (w + (1 / 4 : ℝ) • ν)
      rwa [hν, one_mul] at this
    rw [inner_add_right, hvi] at hi
    refine ⟨?_, ?_⟩
    · rw [mem_ball_zero_iff]
      have := norm_sub_le (w + (1 / 4 : ℝ) • ν) ((1 / 4 : ℝ) • ν)
      rw [add_sub_cancel_right] at this
      linarith
    · show @inner ℝ E3 _ ν w < -τ
      linarith
  have hcapp : Metric.ball ((1 / 4 : ℝ) • ν) (1 / 8) ⊆
      Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z} := by
    intro w hw
    have hw' : ‖w - (1 / 4 : ℝ) • ν‖ < 1 / 8 := by
      rwa [Metric.mem_ball, dist_eq_norm] at hw
    have hi : |@inner ℝ E3 _ ν (w - (1 / 4 : ℝ) • ν)| ≤ ‖w - (1 / 4 : ℝ) • ν‖ := by
      have := abs_real_inner_le_norm ν (w - (1 / 4 : ℝ) • ν)
      rwa [hν, one_mul] at this
    rw [inner_sub_right, hvi] at hi
    have hi2 := (abs_le.mp hi).1
    refine ⟨?_, ?_⟩
    · rw [mem_ball_zero_iff]
      have := norm_add_le (w - (1 / 4 : ℝ) • ν) ((1 / 4 : ℝ) • ν)
      rw [sub_add_cancel] at this
      linarith
    · show τ < @inner ℝ E3 _ ν w
      linarith
  have hP0 : ENNReal.ofReal (c₀ * τ ^ 3) ≤ ENNReal.ofReal (1 / 4096) := by
    apply ENNReal.ofReal_le_ofReal
    have h1 : τ ^ 3 ≤ (1 / 16) ^ 3 := pow_le_pow_left₀ hτ.le hτ16 3
    have h2 : 0 ≤ τ ^ 3 := by positivity
    nlinarith
  have hlin : IsLinearMap ℝ (fun z : E3 => @inner ℝ E3 _ ν z) :=
    IsLinearMap.mk (fun x y => inner_add_right ν x y) (fun c x => real_inner_smul_right ν x c)
  refine ⟨ha, ?_, ?_⟩
  · 
    have hconv : Convex ℝ (Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ}) :=
      (convex_ball _ _).inter (convex_halfSpace_lt hlin _)
    have hnb : ∀ z ∈ Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ},
        ¬ (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) := by
      intro z hz hb
      have h1 := (abs_le.mp (ha z hz.1 hb)).1
      have h2 : @inner ℝ E3 _ ν z < -τ := hz.2
      linarith
    rcases hdich _ hconv.isPreconnected hnb with h | h
    · exfalso
      have hsub : (Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ}) \ F ⊆
          symmDiff F {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1 := by
        rintro z ⟨hz, hzF⟩
        refine ⟨Set.mem_symmDiff.mpr (Or.inr ⟨?_, hzF⟩), ?_⟩
        · show @inner ℝ E3 _ ν z < 0
          have : @inner ℝ E3 _ ν z < -τ := hz.2
          linarith
        · rw [mem_ball_zero_iff]
          have := mem_ball_zero_iff.mp hz.1
          linarith
      have hle := measure_le_inter_add_diff volume
        (Metric.ball (0 : E3) (1 / 2) ∩ {z | @inner ℝ E3 _ ν z < -τ}) F
      rw [h, zero_add] at hle
      have hA := (hvolB _).trans_le (measure_mono hcapm)
      exact lt_irrefl _ (((hA.trans_le hle).trans_le (measure_mono hsub)).trans
        (hL1.trans_le hP0))
    · exact h
  · 
    have hconv : Convex ℝ (Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z}) :=
      (convex_ball _ _).inter (convex_halfSpace_gt hlin _)
    have hnb : ∀ z ∈ Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z},
        ¬ (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) := by
      intro z hz hb
      have h1 := (abs_le.mp (ha z hz.1 hb)).2
      have h2 : τ < @inner ℝ E3 _ ν z := hz.2
      linarith
    rcases hdich _ hconv.isPreconnected hnb with h | h
    · exact h
    · exfalso
      have hsub : (Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z}) ∩ F ⊆
          symmDiff F {z : E3 | @inner ℝ E3 _ ν z < 0} ∩ Metric.ball 0 1 := by
        rintro z ⟨hz, hzF⟩
        refine ⟨Set.mem_symmDiff.mpr (Or.inl ⟨hzF, ?_⟩), ?_⟩
        · show ¬ (@inner ℝ E3 _ ν z < 0)
          have : τ < @inner ℝ E3 _ ν z := hz.2
          linarith
        · rw [mem_ball_zero_iff]
          have := mem_ball_zero_iff.mp hz.1
          linarith
      have hle := measure_le_inter_add_diff volume
        (Metric.ball (0 : E3) (1 / 2) ∩ {z | τ < @inner ℝ E3 _ ν z}) F
      rw [h, add_zero] at hle
      have hA := (hvolB _).trans_le (measure_mono hcapp)
      exact lt_irrefl _ (((hA.trans_le hle).trans_le (measure_mono hsub)).trans
        (hL1.trans_le hP0))

theorem sepTouch_strictify (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U W : Set E3) (g : E3 → ℝ)
    (z₀ : E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hpd : ∀ y ∈ U, (G y).PosDef) (hW : IsOpen W) (hWU : W ⊆ U) (hg : ContDiff ℝ ∞ g)
    (hz₀ : z₀ ∈ W) (hH : 0 < levelMeanCurvCoord G g z₀) :
    ∃ R ε : ℝ, 0 < R ∧ 0 < ε ∧ Metric.closedBall z₀ R ⊆ W ∧
      ∀ z ∈ Metric.closedBall z₀ R,
        0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b *
            partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z *
            partialDeriv b (fun y => g y - ε * ‖y - z₀‖ ^ 2) z ∧
        0 < levelMeanCurvCoord G (fun y => g y - ε * ‖y - z₀‖ ^ 2) z :=
by
  classical
  have hz₀U : z₀ ∈ U := hWU hz₀
  have hdet : (G z₀).det ≠ 0 := ((hpd z₀ hz₀U).det_pos).ne'
  
  have hQg : 0 < ∑ a : Fin 3, ∑ b : Fin 3,
      (G z₀)⁻¹ a b * partialDeriv a g z₀ * partialDeriv b g z₀ := by
    by_contra hneg
    push_neg at hneg
    have hs : Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3,
        (G z₀)⁻¹ a b * partialDeriv a g z₀ * partialDeriv b g z₀) = 0 :=
      Real.sqrt_eq_zero'.mpr hneg
    have h0 : levelMeanCurvCoord G g z₀ = 0 := by
      unfold levelMeanCurvCoord
      rw [hs]
      simp
    linarith
  
  have hφ : ∀ y : E3, HasFDerivAt (fun y : E3 => ‖y - z₀‖ ^ 2)
      (2 • (innerSL ℝ (y - z₀)).comp (ContinuousLinearMap.id ℝ E3)) y :=
    fun y => ((hasFDerivAt_id y).sub_const z₀).norm_sq
  have hgd : ∀ y : E3, HasFDerivAt g (fderiv ℝ g y) y :=
    fun y => (hg.differentiable (by simp)).differentiableAt.hasFDerivAt
  have hp1 : ∀ (ε : ℝ) (a : Fin 3),
      partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) =
        fun y => partialDeriv a g y - 2 * ε * (y a - z₀ a) := by
    intro ε a
    funext y
    have hd : HasFDerivAt (fun y => g y - ε * ‖y - z₀‖ ^ 2)
        (fderiv ℝ g y - ε • (2 • (innerSL ℝ (y - z₀)).comp (ContinuousLinearMap.id ℝ E3))) y :=
      (hgd y).sub ((hφ y).const_mul ε)
    unfold partialDeriv
    rw [hd.fderiv]
    simp [EuclideanSpace.inner_single_right] <;> ring
  have hgj : ∀ j : Fin 3, ContDiff ℝ ∞ (partialDeriv j g) := fun j =>
    (contDiff_infty_iff_fderiv.1 hg).2.clm_apply contDiff_const
  have hp2 : ∀ (ε : ℝ) (i j : Fin 3) (y : E3),
      partialDeriv i (partialDeriv j (fun y => g y - ε * ‖y - z₀‖ ^ 2)) y =
        partialDeriv i (partialDeriv j g) y - 2 * ε * (if i = j then (1 : ℝ) else 0) := by
    intro ε i j y
    rw [hp1 ε j]
    have hA : HasFDerivAt (partialDeriv j g) (fderiv ℝ (partialDeriv j g) y) y :=
      ((hgj j).differentiable (by simp)).differentiableAt.hasFDerivAt
    have hB : HasFDerivAt (fun x : E3 => 2 * ε * ((EuclideanSpace.proj j : E3 →L[ℝ] ℝ) x - z₀ j))
        ((2 * ε) • (EuclideanSpace.proj j : E3 →L[ℝ] ℝ)) y :=
      (((EuclideanSpace.proj j : E3 →L[ℝ] ℝ).hasFDerivAt).sub_const (z₀ j)).const_mul (2 * ε)
    have hC : fderiv ℝ (fun x : E3 => partialDeriv j g x - 2 * ε * (x j - z₀ j)) y =
        fderiv ℝ (partialDeriv j g) y - (2 * ε) • (EuclideanSpace.proj j : E3 →L[ℝ] ℝ) :=
      (hA.sub hB).fderiv
    show fderiv ℝ (fun x : E3 => partialDeriv j g x - 2 * ε * (x j - z₀ j)) y (e i) =
      fderiv ℝ (partialDeriv j g) y (e i) - 2 * ε * (if i = j then (1 : ℝ) else 0)
    rw [hC]
    by_cases hij : i = j
    · subst hij; simp
    · simp [hij, Ne.symm hij]
  
  have hcenter : ∃ c : ℝ, ∀ ε : ℝ,
      (∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b *
          partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ *
          partialDeriv b (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ =
        ∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b * partialDeriv a g z₀ * partialDeriv b g z₀) ∧
      levelMeanCurvCoord G (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ =
        levelMeanCurvCoord G g z₀ - ε * c := by
    refine ⟨2 * (∑ i : Fin 3, ∑ j : Fin 3, (G z₀)⁻¹ i j * (if i = j then (1 : ℝ) else 0)) /
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
          (G z₀)⁻¹ i j * partialDeriv i g z₀ * partialDeriv j g z₀) -
      2 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (G z₀)⁻¹ i a * partialDeriv a g z₀ * ((G z₀)⁻¹ j b * partialDeriv b g z₀) *
            (if i = j then (1 : ℝ) else 0)) /
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
          (G z₀)⁻¹ i j * partialDeriv i g z₀ * partialDeriv j g z₀) ^ 3, fun ε => ?_⟩
    have h1 : ∀ a : Fin 3, partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ =
        partialDeriv a g z₀ := by
      intro a
      rw [hp1 ε a]
      simp
    have hhs : ∀ i j : Fin 3, hessLoc G (fun y => g y - ε * ‖y - z₀‖ ^ 2) i j z₀ =
        hessLoc G g i j z₀ - 2 * ε * (if i = j then (1 : ℝ) else 0) := by
      intro i j
      unfold hessLoc
      rw [hp2 ε i j z₀]
      simp only [h1]
      ring
    have hQ : ∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b *
          partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ *
          partialDeriv b (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ =
        ∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b * partialDeriv a g z₀ * partialDeriv b g z₀ := by
      simp only [h1]
    refine ⟨hQ, ?_⟩
    have hlap : lapLoc G (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ = lapLoc G g z₀ -
        2 * ε * ∑ i : Fin 3, ∑ j : Fin 3, (G z₀)⁻¹ i j * (if i = j then (1 : ℝ) else 0) := by
      unfold lapLoc
      simp only [hhs]
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      ring
    have hnum : (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (G z₀)⁻¹ i a * partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ *
            ((G z₀)⁻¹ j b * partialDeriv b (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀) *
            hessLoc G (fun y => g y - ε * ‖y - z₀‖ ^ 2) i j z₀) =
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (G z₀)⁻¹ i a * partialDeriv a g z₀ * ((G z₀)⁻¹ j b * partialDeriv b g z₀) *
            hessLoc G g i j z₀) -
        2 * ε * (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          (G z₀)⁻¹ i a * partialDeriv a g z₀ * ((G z₀)⁻¹ j b * partialDeriv b g z₀) *
            (if i = j then (1 : ℝ) else 0)) := by
      simp only [h1, hhs]
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      ring
    unfold levelMeanCurvCoord
    rw [hlap, hnum, hQ]
    ring
  
  have hGc : ∀ i j : Fin 3, ContinuousAt (fun y => G y i j) z₀ := fun i j =>
    (hG i j).continuousOn.continuousAt (hU.mem_nhds hz₀U)
  have hGm : ContinuousAt G z₀ :=
    continuousAt_pi.2 fun i => continuousAt_pi.2 fun j => hGc i j
  have hinvm : ContinuousAt (fun y => (G y)⁻¹) z₀ := by
    have hRi : ContinuousAt Ring.inverse (G z₀).det := by
      rw [Ring.inverse_eq_inv']
      exact continuousAt_inv₀ hdet
    exact (continuousAt_matrix_inv (G z₀) hRi).comp hGm
  have hinv : ∀ i j : Fin 3, ContinuousAt (fun y => (G y)⁻¹ i j) z₀ := fun i j =>
    continuousAt_pi.1 (continuousAt_pi.1 hinvm i) j
  have hdG : ∀ a b k : Fin 3, ContinuousAt (fun y => partialDeriv k (fun z => G z a b) y) z₀ := by
    intro a b k
    have h1 := ((hG a b).continuousOn_fderiv_of_isOpen hU (by simp)).continuousAt
      (hU.mem_nhds hz₀U)
    exact h1.clm_apply continuousAt_const
  have hchr : ∀ k i j : Fin 3, ContinuousAt (fun y => christoffel G k i j y) z₀ := by
    intro k i j
    unfold christoffel
    exact continuousAt_const.mul (tendsto_finset_sum _ fun l _ =>
      (hinv k l).mul (((hdG j l i).add (hdG i l j)).sub (hdG i j l)))
  have hcont : ∀ h : E3 → ℝ, ContDiff ℝ ∞ h →
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b * partialDeriv a h z₀ * partialDeriv b h z₀ →
      ContinuousAt (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
          (G y)⁻¹ a b * partialDeriv a h y * partialDeriv b h y) z₀ ∧
        ContinuousAt (levelMeanCurvCoord G h) z₀ := by
    intro h hh hQ0
    have hj : ∀ j : Fin 3, ContDiff ℝ ∞ (partialDeriv j h) := fun j =>
      (contDiff_infty_iff_fderiv.1 hh).2.clm_apply contDiff_const
    have hd1 : ∀ a : Fin 3, ContinuousAt (partialDeriv a h) z₀ := fun a =>
      ((hh.continuous_fderiv (by simp)).clm_apply continuous_const).continuousAt
    have hd2 : ∀ i j : Fin 3, ContinuousAt (partialDeriv i (partialDeriv j h)) z₀ := fun i j =>
      (((hj j).continuous_fderiv (by simp)).clm_apply continuous_const).continuousAt
    have hQc : ContinuousAt (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ a b * partialDeriv a h y * partialDeriv b h y) z₀ :=
      tendsto_finset_sum _ fun a _ => tendsto_finset_sum _ fun b _ =>
        ((hinv a b).mul (hd1 a)).mul (hd1 b)
    have hhess : ∀ i j : Fin 3, ContinuousAt (fun y => hessLoc G h i j y) z₀ := by
      intro i j
      unfold hessLoc
      exact (hd2 i j).sub (tendsto_finset_sum _ fun k _ => (hchr k i j).mul (hd1 k))
    have hlap : ContinuousAt (fun y => lapLoc G h y) z₀ := by
      unfold lapLoc
      exact tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ =>
        (hinv i j).mul (hhess i j)
    have hnum : ContinuousAt (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ i a * partialDeriv a h y * ((G y)⁻¹ j b * partialDeriv b h y) *
          hessLoc G h i j y) z₀ :=
      tendsto_finset_sum _ fun i _ => tendsto_finset_sum _ fun j _ =>
        tendsto_finset_sum _ fun a _ => tendsto_finset_sum _ fun b _ =>
          (((hinv i a).mul (hd1 a)).mul ((hinv j b).mul (hd1 b))).mul (hhess i j)
    have hN := hQc.sqrt
    have hN0 : Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3,
        (G z₀)⁻¹ a b * partialDeriv a h z₀ * partialDeriv b h z₀) ≠ 0 :=
      (Real.sqrt_pos.2 hQ0).ne'
    refine ⟨hQc, ?_⟩
    exact (hlap.div hN hN0).sub (hnum.div (hN.pow 3) (pow_ne_zero 3 hN0))
  
  obtain ⟨c, hc⟩ := hcenter
  have hc1 : 0 < 4 * (|c| + 1) := by positivity
  obtain ⟨ε, hε, hεc⟩ : ∃ ε : ℝ, 0 < ε ∧ ε * c < levelMeanCurvCoord G g z₀ := by
    refine ⟨levelMeanCurvCoord G g z₀ / (4 * (|c| + 1)), div_pos hH hc1, ?_⟩
    have hεpos : 0 < levelMeanCurvCoord G g z₀ / (4 * (|c| + 1)) := div_pos hH hc1
    have h2 : levelMeanCurvCoord G g z₀ / (4 * (|c| + 1)) * (4 * (|c| + 1)) =
        levelMeanCurvCoord G g z₀ := div_mul_cancel₀ _ hc1.ne'
    have h1 : levelMeanCurvCoord G g z₀ / (4 * (|c| + 1)) * c ≤
        levelMeanCurvCoord G g z₀ / (4 * (|c| + 1)) * |c| :=
      mul_le_mul_of_nonneg_left (le_abs_self c) hεpos.le
    nlinarith [abs_nonneg c]
  obtain ⟨hQeq, hHeq⟩ := hc ε
  have hh : ContDiff ℝ ∞ (fun y => g y - ε * ‖y - z₀‖ ^ 2) :=
    hg.sub (contDiff_const.mul ((contDiff_id.sub contDiff_const).norm_sq ℝ))
  have hQh0 : 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z₀)⁻¹ a b *
      partialDeriv a (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ *
      partialDeriv b (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ := by
    rw [hQeq]; exact hQg
  have hHh0 : 0 < levelMeanCurvCoord G (fun y => g y - ε * ‖y - z₀‖ ^ 2) z₀ := by
    rw [hHeq]; linarith
  obtain ⟨hQc, hHc⟩ := hcont _ hh hQh0
  have ev := (continuousAt_const.eventually_lt hQc hQh0).and
    (continuousAt_const.eventually_lt hHc hHh0)
  obtain ⟨δ, hδ, hδb⟩ := Metric.eventually_nhds_iff.mp ev
  obtain ⟨r, hr, hrW⟩ := Metric.isOpen_iff.mp hW z₀ hz₀
  have hmin : 0 < min δ r := lt_min hδ hr
  refine ⟨min δ r / 2, ε, by positivity, hε, ?_, ?_⟩
  · intro z hz
    apply hrW
    rw [Metric.mem_closedBall] at hz
    rw [Metric.mem_ball]
    have := min_le_right δ r
    linarith
  · intro z hz
    rw [Metric.mem_closedBall] at hz
    have hzδ : dist z z₀ < δ := by
      have := min_le_left δ r
      linarith
    exact hδb hzδ

theorem sepTouch_unitNormal_Gnorm (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (z : E3)
    (hdet : (G z).det ≠ 0)
    (hN : 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) :
    ∑ i : Fin 3, ∑ j : Fin 3, G z i j * calUnitNormal G f z i * calUnitNormal G f z j = 1 :=
by
  have hAB : G z * (G z)⁻¹ = 1 := Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet)
  have hent : ∀ i k : Fin 3, ∑ j : Fin 3, G z i j * (G z)⁻¹ j k = if i = k then 1 else 0 := by
    intro i k
    have h := congrFun (congrFun hAB i) k
    rw [Matrix.mul_apply, Matrix.one_apply] at h
    exact h
  have hrow : ∀ i : Fin 3, ∑ j : Fin 3, G z i j * (∑ k : Fin 3, (G z)⁻¹ j k * partialDeriv k f z)
      = partialDeriv i f z := by
    intro i
    calc ∑ j : Fin 3, G z i j * (∑ k : Fin 3, (G z)⁻¹ j k * partialDeriv k f z)
        = ∑ k : Fin 3, (∑ j : Fin 3, G z i j * (G z)⁻¹ j k) * partialDeriv k f z := by
          simp_rw [Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun j _ => by ring))
      _ = partialDeriv i f z := by
          simp_rw [hent]
          simp
  have hQ : ∑ i : Fin 3, ∑ j : Fin 3, G z i j * (∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) *
      (∑ k : Fin 3, (G z)⁻¹ j k * partialDeriv k f z) =
      ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z := by
    calc _ = ∑ i : Fin 3, (∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) *
          ∑ j : Fin 3, G z i j * (∑ k : Fin 3, (G z)⁻¹ j k * partialDeriv k f z) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun j _ => by ring)
      _ = ∑ i : Fin 3, (∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) * partialDeriv i f z := by
          simp_rw [hrow]
      _ = _ := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl (fun k _ => by ring)
  have hgen : ∀ (c : ℝ) (v : Fin 3 → ℝ),
      ∑ i : Fin 3, ∑ j : Fin 3, G z i j * (c * v i) * (c * v j) =
        c ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G z i j * v i * v j := by
    intro c v
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  have hs : Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z *
      partialDeriv b f z) ^ 2 =
      ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z :=
    Real.sq_sqrt hN.le
  have hmain := hgen (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z *
      partialDeriv b f z))⁻¹ (fun i => ∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z)
  simp only [] at hmain
  rw [hQ, inv_pow, hs, inv_mul_cancel₀ hN.ne'] at hmain
  unfold calUnitNormal
  exact hmain

theorem sepTouch_W1_norm (M : Matrix (Fin 3) (Fin 3) ℝ) (hpd : M.PosDef) (u w : E3)
    (p t s : ℝ)
    (hu : ∑ i : Fin 3, ∑ j : Fin 3, M i j * u i * u j ≤ 1)
    (hw : ∑ i : Fin 3, ∑ j : Fin 3, M i j * w i * w j ≤ 1)
    (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (hs : |s| ≤ 1) :
    ∑ i : Fin 3, ∑ j : Fin 3, M i j * (p • ((1 - t) • u + (s * t) • w)) i *
      (p • ((1 - t) • u + (s * t) • w)) j ≤ 1 :=
by
  have psd : ∀ x : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, M i j * x i * x j := by
    intro x
    have h := hpd.posSemidef.dotProduct_mulVec_nonneg x
    have e : dotProduct (star x) (M.mulVec x) = ∑ i : Fin 3, ∑ j : Fin 3, M i j * x i * x j := by
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    rw [← e]; exact h
  have hv : ∀ i : Fin 3, (p • ((1 - t) • u + (s * t) • w)) i =
      (p * (1 - t)) * u i + (p * (s * t)) * w i := by
    intro i
    simp only [PiLp.smul_apply, PiLp.add_apply, smul_eq_mul]
    ring
  simp only [hv]
  have h1 := psd (fun i => u i + w i)
  have h2 := psd (fun i => u i - w i)
  have hu0 := psd (fun i => u i)
  have hw0 := psd (fun i => w i)
  have e1 : ∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i + w i) * (u j + w j) =
      (∑ i : Fin 3, ∑ j : Fin 3, M i j * u i * u j) + (∑ i : Fin 3, ∑ j : Fin 3, M i j * w i * w j)
        + ∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i * w j + w i * u j) := by
    simp only [Fin.sum_univ_three]; ring
  have e2 : ∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i - w i) * (u j - w j) =
      (∑ i : Fin 3, ∑ j : Fin 3, M i j * u i * u j) + (∑ i : Fin 3, ∑ j : Fin 3, M i j * w i * w j)
        - ∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i * w j + w i * u j) := by
    simp only [Fin.sum_univ_three]; ring
  have e3 : ∀ a b : ℝ, ∑ i : Fin 3, ∑ j : Fin 3, M i j * (a * u i + b * w i) * (a * u j + b * w j) =
      a ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, M i j * u i * u j)
        + a * b * (∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i * w j + w i * u j))
        + b ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, M i j * w i * w j) := by
    intro a b
    simp only [Fin.sum_univ_three]; ring
  simp only at h1 h2 hu0 hw0
  rw [e1] at h1
  rw [e2] at h2
  rw [e3]
  generalize (∑ i : Fin 3, ∑ j : Fin 3, M i j * u i * u j) = qu at *
  generalize (∑ i : Fin 3, ∑ j : Fin 3, M i j * w i * w j) = qw at *
  generalize (∑ i : Fin 3, ∑ j : Fin 3, M i j * (u i * w j + w i * u j)) = C at *
  generalize ha : p * (1 - t) = a
  generalize hb : p * (s * t) = b
  have ha0 : 0 ≤ a := by rw [← ha]; exact mul_nonneg hp0 (by linarith)
  have hb' : |b| ≤ p * t := by
    rw [← hb, abs_mul, abs_mul, abs_of_nonneg hp0, abs_of_nonneg ht0]
    have := mul_le_mul_of_nonneg_right hs ht0
    nlinarith
  have hab : a + |b| ≤ 1 := by
    have : a + p * t = p := by rw [← ha]; ring
    linarith
  have hCabs : |C| ≤ qu + qw := abs_le.mpr ⟨by linarith, by linarith⟩
  have hbC : b * C ≤ |b| * (qu + qw) :=
    calc b * C ≤ |b * C| := le_abs_self _
      _ = |b| * |C| := abs_mul _ _
      _ ≤ |b| * (qu + qw) := mul_le_mul_of_nonneg_left hCabs (abs_nonneg _)
  have habC : a * b * C ≤ a * |b| * (qu + qw) := by
    have := mul_le_mul_of_nonneg_left hbC ha0
    calc a * b * C = a * (b * C) := by ring
      _ ≤ a * (|b| * (qu + qw)) := this
      _ = a * |b| * (qu + qw) := by ring
  have hbn : 0 ≤ |b| := abs_nonneg _
  have hc1 : (a ^ 2 + a * |b|) * qu ≤ a ^ 2 + a * |b| := by
    have := mul_le_mul_of_nonneg_left hu (by positivity : (0:ℝ) ≤ a ^ 2 + a * |b|)
    linarith
  have hc2 : (b ^ 2 + a * |b|) * qw ≤ b ^ 2 + a * |b| := by
    have := mul_le_mul_of_nonneg_left hw (by positivity : (0:ℝ) ≤ b ^ 2 + a * |b|)
    linarith
  have hsq : (a + |b|) ^ 2 ≤ 1 := by
    have h0 : 0 ≤ a + |b| := by linarith
    nlinarith
  have hb2 : b ^ 2 = |b| ^ 2 := (sq_abs b).symm
  nlinarith

theorem sepTouch_W1_smooth (T C A : Set E3) (h ψ sig : E3 → ℝ) (Y X : E3 → E3) (c η : ℝ)
    (hT : IsOpen T) (hC : IsCompact C) (hCT : C ⊆ T) (hh : ContDiff ℝ ∞ h) (hη : 0 < η)
    (hψ : ContDiff ℝ ∞ ψ) (hψC : ∀ z, z ∉ C → ψ z = 0) (hY : ContDiff ℝ ∞ Y)
    (hX : ContDiffOn ℝ ∞ X T) (hAo : IsOpen A) (hAsub : A ⊆ {z : E3 | z ∈ T ∧ c < h z})
    (hBo : IsOpen ({z : E3 | z ∈ T ∧ c < h z} \ A))
    (hsig : ∀ z ∈ T, sig z = ({z : E3 | z ∈ T ∧ c < h z} \ A).indicator (fun _ => (1 : ℝ)) z -
      A.indicator (fun _ => (1 : ℝ)) z) :
    ContDiff ℝ ∞ (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
        (sig z * calTheta c η (h z)) • X z)) ∧
      HasCompactSupport (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
        (sig z * calTheta c η (h z)) • X z)) ∧
      tsupport (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
        (sig z * calTheta c η (h z)) • X z)) ⊆ C :=
by
  have hΘs : ContDiff ℝ ∞ (calTheta c η) := by
    show ContDiff ℝ ∞ (fun t => Real.smoothTransition (2 * ((t - c) / η) - 1))
    exact Real.smoothTransition.contDiff.comp
      ((contDiff_const.mul ((contDiff_id.sub contDiff_const).div_const η)).sub contDiff_const)
  have hΘ0 : ∀ t, t ≤ c + η / 2 → calTheta c η t = 0 := by
    intro t ht
    unfold calTheta
    apply Real.smoothTransition.zero_of_nonpos
    have h1 : (t - c) / η ≤ 1 / 2 := by
      rw [div_le_iff₀ hη]; linarith
    linarith
  have hθ : ContDiff ℝ ∞ (fun z => calTheta c η (h z)) := hΘs.comp hh
  have hW0 : ∀ z, z ∉ C → ψ z • ((1 - calTheta c η (h z)) • Y z +
      (sig z * calTheta c η (h z)) • X z) = 0 := by
    intro z hz
    rw [hψC z hz, zero_smul]
  have hsupp : Function.support (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
      (sig z * calTheta c η (h z)) • X z)) ⊆ C :=
    Function.support_subset_iff'.mpr hW0
  have hCcl : IsClosed C := hC.isClosed
  have hts : tsupport (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
      (sig z * calTheta c η (h z)) • X z)) ⊆ C :=
    closure_minimal hsupp hCcl
  have hsigA : ∀ z ∈ A, sig z = -1 := by
    intro z hz
    have hzT : z ∈ T := (hAsub hz).1
    rw [hsig z hzT, Set.indicator_of_notMem (fun h' => h'.2 hz), Set.indicator_of_mem hz]
    norm_num
  have hsigB : ∀ z ∈ {z : E3 | z ∈ T ∧ c < h z} \ A, sig z = 1 := by
    intro z hz
    rw [hsig z hz.1.1, Set.indicator_of_mem hz, Set.indicator_of_notMem hz.2]
    norm_num
  refine ⟨?_, HasCompactSupport.intro hC hW0, hts⟩
  rw [contDiff_iff_contDiffAt]
  intro z₀
  by_cases hz₀C : z₀ ∈ C
  · rcases lt_or_ge (h z₀) (c + η / 2) with hlt | hge
    · 
      have hU : {z : E3 | h z < c + η / 2} ∈ 𝓝 z₀ :=
        (isOpen_lt hh.continuous continuous_const).mem_nhds hlt
      refine ((hψ.smul hY).contDiffAt).congr_of_eventuallyEq ?_
      filter_upwards [hU] with z hz
      have hz' : h z < c + η / 2 := hz
      rw [hΘ0 _ hz'.le]
      simp
    · have hz₀T : z₀ ∈ T := hCT hz₀C
      have hXa : ContDiffAt ℝ ∞ X z₀ := hX.contDiffAt (hT.mem_nhds hz₀T)
      by_cases hz₀A : z₀ ∈ A
      · 
        have hg : ContDiffAt ℝ ∞ (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
            (-calTheta c η (h z)) • X z)) z₀ :=
          hψ.contDiffAt.smul (((contDiffAt_const.sub hθ.contDiffAt).smul hY.contDiffAt).add
            (hθ.contDiffAt.neg.smul hXa))
        refine hg.congr_of_eventuallyEq ?_
        filter_upwards [hAo.mem_nhds hz₀A] with z hz
        rw [hsigA z hz, neg_one_mul]
      · 
        have hz₀B : z₀ ∈ {z : E3 | z ∈ T ∧ c < h z} \ A :=
          ⟨⟨hz₀T, by linarith⟩, hz₀A⟩
        have hg : ContDiffAt ℝ ∞ (fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
            (calTheta c η (h z)) • X z)) z₀ :=
          hψ.contDiffAt.smul (((contDiffAt_const.sub hθ.contDiffAt).smul hY.contDiffAt).add
            (hθ.contDiffAt.smul hXa))
        refine hg.congr_of_eventuallyEq ?_
        filter_upwards [hBo.mem_nhds hz₀B] with z hz
        rw [hsigB z hz, one_mul]
  · 
    refine (contDiffAt_const (c := (0 : E3))).congr_of_eventuallyEq ?_
    filter_upwards [hCcl.isOpen_compl.mem_nhds hz₀C] with z hz
    exact hW0 z hz

theorem sepTouch_perY_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U A : Set E3) (h : E3 → ℝ)
    (z₀ : E3) (R c : ℝ) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (hF : MeasurableSet F) (hR : 0 < R) (hRU : Metric.closedBall z₀ R ⊆ U)
    (hh : ContDiff ℝ ∞ h)
    (hNH : ∀ z ∈ Metric.closedBall z₀ R,
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a h z * partialDeriv b h z ∧
      0 < levelMeanCurvCoord G h z)
    (hAo : IsOpen A) (hAsub : A ⊆ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z})
    (hBo : IsOpen ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A))
    (hloc : volume ((symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) \
      Metric.closedBall z₀ (R / 2)) = 0)
    (hfin : sepPerG G F (Metric.ball z₀ R) ≠ ⊤) :
    IntegrableOn (fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z)
        (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) ∧
    ∀ Y : E3 → E3, ContDiff ℝ ∞ Y → HasCompactSupport Y → tsupport Y ⊆ Metric.ball z₀ R →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) →
      (∫ z in (F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩ Metric.closedBall z₀ (R / 2))) ∪
          (A ∩ Metric.closedBall z₀ (R / 2)), sepDensDiv G Y z) +
        (∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
          Real.sqrt (G z).det * levelMeanCurvCoord G h z) ≤
      (sepPerG G F (Metric.ball z₀ R)).toReal :=
by
  classical
  
  have hTU : Metric.ball z₀ R ⊆ U := Metric.ball_subset_closedBall.trans hRU
  have hGT : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (Metric.ball z₀ R) :=
    fun i j => (hG i j).mono hTU
  have hpdT : ∀ z ∈ Metric.ball z₀ R, (G z).PosDef := fun z hz => hpd z (hTU hz)
  have hdetT : ∀ z ∈ Metric.ball z₀ R, 0 < (G z).det := fun z hz => (hpdT z hz).det_pos
  have hNT : ∀ z ∈ Metric.ball z₀ R,
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a h z * partialDeriv b h z :=
    fun z hz => (hNH z (Metric.ball_subset_closedBall hz)).1
  have hΩo : IsOpen {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const hh.continuous)
  have hDm : MeasurableSet (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) :=
    (hF.symmDiff hAo.measurableSet).inter hΩo.measurableSet
  have hF'm : MeasurableSet ((F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩
      Metric.closedBall z₀ (R / 2))) ∪ (A ∩ Metric.closedBall z₀ (R / 2))) :=
    (hF.diff (hΩo.measurableSet.inter Metric.isClosed_closedBall.measurableSet)).union
      (hAo.measurableSet.inter Metric.isClosed_closedBall.measurableSet)
  obtain ⟨Xt, hXtdef⟩ : ∃ X : E3 → E3,
      X = fun z => WithLp.toLp 2 (fun i => calUnitNormal G h z i) := ⟨_, rfl⟩
  have hXt : ∀ z ∈ Metric.ball z₀ R, ∀ i : Fin 3, Xt z i = calUnitNormal G h z i := by
    intro z _ i; rw [hXtdef]
  obtain ⟨-, hXsm', hCSall⟩ := ccs_normal_props G h (Metric.ball z₀ R) Metric.isOpen_ball hGT
    hpdT hh.contDiffOn Xt hXt
  have hXsm : ContDiffOn ℝ ∞ Xt (Metric.ball z₀ R) := hXsm'.mono (fun z hz => ⟨hz, hNT z hz⟩)
  have hXn : ∀ z ∈ Metric.ball z₀ R, ∑ i : Fin 3, ∑ j : Fin 3, G z i j * Xt z i * Xt z j = 1 := by
    intro z hz
    simp only [hXt z hz]
    exact sepTouch_unitNormal_Gnorm G h z (hdetT z hz).ne' (hNT z hz)
  have hdivX : ∀ z ∈ Metric.ball z₀ R,
      sepDensDiv G Xt z = Real.sqrt (G z).det * levelMeanCurvCoord G h z :=
    fun z hz => ccs_divx G h _ Metric.isOpen_ball hGT hsymm hpdT hh.contDiffOn Xt hXt z hz (hNT z hz)
  obtain ⟨sig, hsigdef⟩ : ∃ s : E3 → ℝ, s = fun z =>
      ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A).indicator (fun _ => (1 : ℝ)) z -
        A.indicator (fun _ => (1 : ℝ)) z := ⟨_, rfl⟩
  have hsig : ∀ z ∈ Metric.ball z₀ R, sig z =
      ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A).indicator (fun _ => (1 : ℝ)) z -
        A.indicator (fun _ => (1 : ℝ)) z := by
    intro z _; rw [hsigdef]
  have hsig1 : ∀ z, |sig z| ≤ 1 := by
    intro z
    simp only [hsigdef]
    by_cases hA : z ∈ A
    · have hB : z ∉ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A) := fun h' => h'.2 hA
      rw [Set.indicator_of_mem hA, Set.indicator_of_notMem hB]; norm_num
    · by_cases hB : z ∈ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A)
      · rw [Set.indicator_of_mem hB, Set.indicator_of_notMem hA]; norm_num
      · rw [Set.indicator_of_notMem hB, Set.indicator_of_notMem hA]; norm_num
  have hSD : symmDiff (F ∩ Metric.ball z₀ R) A ∩ {z : E3 | c < h z} =
      symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} := by
    ext z
    have hz := @hAsub z
    simp only [Set.mem_inter_iff, Set.mem_symmDiff, Set.mem_diff, Set.mem_setOf_eq] at hz ⊢
    tauto
  
  have hdivres : ∀ (V : E3 → E3) (S T : Set E3), MeasurableSet S → tsupport V ⊆ T →
      ∫ z in S, sepDensDiv G V z = ∫ z in S ∩ T, sepDensDiv G V z := by
    intro V S T hS hVT
    apply setIntegral_eq_of_subset_of_forall_diff_eq_zero hS Set.inter_subset_left
    intro z hz
    have hzV : z ∉ tsupport V := fun h' => hz.2 ⟨hz.1, hVT h'⟩
    have hev : V =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hzV
    unfold sepDensDiv
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have hev' : (fun w => Real.sqrt (G w).det * V w i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
      filter_upwards [hev] with w hw
      rw [hw]; simp
    unfold partialDeriv
    rw [hev'.fderiv_eq]; simp
  
  have hcomp : (((F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩
      Metric.closedBall z₀ (R / 2))) ∪ (A ∩ Metric.closedBall z₀ (R / 2))) ∩
        Metric.ball z₀ R : Set E3) =ᵐ[volume]
      (((F ∩ Metric.ball z₀ R) \ {z : E3 | c < h z}) ∪ A : Set E3) := by
    rw [ae_eq_set]
    constructor
    · refine measure_mono_null ?_ hloc
      intro z hz
      have hz' := @hAsub z
      simp only [Set.mem_diff, Set.mem_inter_iff, Set.mem_union, Set.mem_symmDiff,
        Set.mem_setOf_eq] at hz hz' ⊢
      tauto
    · refine measure_mono_null ?_ hloc
      intro z hz
      have hz' := @hAsub z
      simp only [Set.mem_diff, Set.mem_inter_iff, Set.mem_union, Set.mem_symmDiff,
        Set.mem_setOf_eq] at hz hz' ⊢
      tauto
  
  have hθlim : ∀ u : E3 → ℝ,
      IntegrableOn u (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) →
      Tendsto (fun k : ℕ => ∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
          calTheta c (1 / ((k : ℝ) + 1)) (h z) * u z) atTop
        (𝓝 (∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}, u z)) := by
    intro u hu
    refine tendsto_integral_of_dominated_convergence (fun z => ‖u z‖) (fun k => ?_) hu.norm
      (fun k => ?_) ?_
    · have hk : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
      exact (((ccs_theta_props c _ hk).1.continuous.comp hh.continuous).aestronglyMeasurable).mul
        hu.aestronglyMeasurable
    · have hk : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
      obtain ⟨-, h0, h1, -⟩ := ccs_theta_props c _ hk
      refine Filter.Eventually.of_forall (fun z => ?_)
      rw [norm_mul, Real.norm_eq_abs (calTheta _ _ _), abs_of_nonneg (h0 _)]
      exact mul_le_of_le_one_left (norm_nonneg _) (h1 _)
    · filter_upwards [ae_restrict_mem hDm] with z hz
      have hδ : 0 < h z - c := sub_pos.2 hz.2.2
      obtain ⟨N, hN⟩ := exists_nat_one_div_lt hδ
      refine tendsto_atTop_of_eventually_const (i₀ := N) (fun k hk => ?_)
      have hθ1 : calTheta c (1 / ((k : ℝ) + 1)) (h z) = 1 := by
        unfold calTheta
        apply Real.smoothTransition.one_of_one_le
        have hNk : (N : ℝ) ≤ k := by exact_mod_cast hk
        have hk' : 1 / ((k : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
          one_div_le_one_div_of_le (by positivity) (by linarith)
        have hpos : (0 : ℝ) < 1 / ((k : ℝ) + 1) := by positivity
        have h1 : 1 ≤ (h z - c) / (1 / ((k : ℝ) + 1)) := by
          rw [le_div_iff₀ hpos]; linarith
        linarith
      rw [hθ1, one_mul]
  
  have key : ∀ Y : E3 → E3, ContDiff ℝ ∞ Y → HasCompactSupport Y →
      tsupport Y ⊆ Metric.ball z₀ R →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) →
      IntegrableOn (fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z)
          (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) ∧
      (∫ z in (F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩ Metric.closedBall z₀ (R / 2))) ∪
          (A ∩ Metric.closedBall z₀ (R / 2)), sepDensDiv G Y z) +
        (∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
          Real.sqrt (G z).det * levelMeanCurvCoord G h z) ≤
      (sepPerG G F (Metric.ball z₀ R)).toReal := by
    intro Y hY hYc hYT hY1
    
    obtain ⟨ρ, hρR, hSρ⟩ := exists_lt_subset_ball (isClosed_tsupport Y) hYT
    obtain ⟨r₁, hr₁def⟩ : ∃ r : ℝ, r = max ρ (3 * R / 4) := ⟨_, rfl⟩
    have hr₁ : R / 2 < r₁ := by
      rw [hr₁def]; exact lt_of_lt_of_le (by linarith) (le_max_right _ _)
    have hr₁R : r₁ < R := by rw [hr₁def]; exact max_lt hρR (by linarith)
    have hr₁pos : 0 < r₁ := by linarith
    obtain ⟨r₂, hr₂def⟩ : ∃ r : ℝ, r = (r₁ + R) / 2 := ⟨_, rfl⟩
    have hr₁₂ : r₁ < r₂ := by rw [hr₂def]; linarith
    have hr₂ : r₂ < R := by rw [hr₂def]; linarith
    let b : ContDiffBump z₀ := ⟨r₁, r₂, hr₁pos, hr₁₂⟩
    obtain ⟨ψ, hψdef⟩ : ∃ f : E3 → ℝ, f = ⇑b := ⟨_, rfl⟩
    have hψs : ContDiff ℝ ∞ ψ := by rw [hψdef]; exact b.contDiff
    have hψ0 : ∀ z, 0 ≤ ψ z := fun z => by rw [hψdef]; exact b.nonneg
    have hψ1 : ∀ z, ψ z ≤ 1 := fun z => by rw [hψdef]; exact b.le_one
    have hψone : ∀ z ∈ Metric.closedBall z₀ r₁, ψ z = 1 :=
      fun z hz => by rw [hψdef]; exact b.one_of_mem_closedBall hz
    have hψzero : ∀ z, z ∉ Metric.closedBall z₀ r₂ → ψ z = 0 := by
      intro z hz
      rw [hψdef]
      apply Function.notMem_support.1
      rw [b.support_eq]
      exact fun h' => hz (Metric.ball_subset_closedBall h')
    have hSr₁ : tsupport Y ⊆ Metric.ball z₀ r₁ :=
      hSρ.trans (Metric.ball_subset_ball (by rw [hr₁def]; exact le_max_left _ _))
    have hdψ : ∀ z ∈ Metric.ball z₀ r₁, fderiv ℝ ψ z = 0 := by
      intro z hz
      have hev : ψ =ᶠ[𝓝 z] fun _ => (1 : ℝ) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hz] with w hw
        exact hψone w (Metric.ball_subset_closedBall hw)
      rw [hev.fderiv_eq]; simp
    have hCc : IsCompact (Metric.closedBall z₀ r₂) := isCompact_closedBall z₀ r₂
    have hCT : Metric.closedBall z₀ r₂ ⊆ Metric.ball z₀ R := Metric.closedBall_subset_ball hr₂
    have hKr₁ : Metric.closedBall z₀ (R / 2) ⊆ Metric.ball z₀ r₁ :=
      Metric.closedBall_subset_ball hr₁
    have hψT : ∀ z, z ∉ Metric.ball z₀ R → ψ z = 0 :=
      fun z hz => hψzero z (fun h' => hz (hCT h'))
    have hYT0 : ∀ z, z ∉ Metric.ball z₀ R → Y z = 0 :=
      fun z hz => image_eq_zero_of_notMem_tsupport (fun h' => hz (hYT h'))
    have hYψ : ∀ z ∈ Metric.ball z₀ R, ∀ i : Fin 3, Y z i = ψ z * Y z i := by
      intro z _ i
      by_cases hz : z ∈ tsupport Y
      · rw [hψone z (Metric.ball_subset_closedBall (hSr₁ hz)), one_mul]
      · rw [image_eq_zero_of_notMem_tsupport hz]; simp
    
    have hae : ∀ᵐ z ∂(volume.restrict
        (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z})), z ∈ Metric.ball z₀ r₁ := by
      rw [ae_restrict_iff' hDm, ae_iff]
      refine measure_mono_null ?_ hloc
      intro z hz
      have hz' : ¬ (z ∈ symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} →
          z ∈ Metric.ball z₀ r₁) := hz
      have h1 : z ∈ symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} := by
        by_contra h'; exact hz' (fun h'' => absurd h'' h')
      have h2 : z ∉ Metric.ball z₀ r₁ := fun h' => hz' (fun _ => h')
      exact ⟨h1, fun hK => h2 (hKr₁ hK)⟩
    
    obtain ⟨d, hddef⟩ : ∃ d : E3 → ℝ, d = fun z => ψ z * sepDensDiv G Xt z := ⟨_, rfl⟩
    have hstep : ∀ η : ℝ, 0 < η →
        IntegrableOn d (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) ∧
        IntegrableOn (fun z => sig z * sepDensDiv G Y z)
          (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) ∧
        (∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
            calTheta c η (h z) * d z) +
          ((∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
              sig z * sepDensDiv G Y z) -
            ∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
              calTheta c η (h z) * (sig z * sepDensDiv G Y z)) ≤
          (sepPerG G F (Metric.ball z₀ R)).toReal -
            ∫ z in (F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩
              Metric.closedBall z₀ (R / 2))) ∪ (A ∩ Metric.closedBall z₀ (R / 2)),
              sepDensDiv G Y z := by
      intro η hη
      obtain ⟨-, hθ0, hθ1, -, -, -⟩ := ccs_theta_props c η hη
      obtain ⟨W₁, hW₁def⟩ : ∃ W : E3 → E3, W = fun z => ψ z • ((1 - calTheta c η (h z)) • Y z +
          (sig z * calTheta c η (h z)) • Xt z) := ⟨_, rfl⟩
      obtain ⟨Zt, hZtdef⟩ : ∃ Z : E3 → E3, Z = fun z => calTheta c η (h z) • Xt z := ⟨_, rfl⟩
      obtain ⟨hW₁s, hW₁c, hW₁C⟩ := sepTouch_W1_smooth (Metric.ball z₀ R)
        (Metric.closedBall z₀ r₂) A h ψ sig Y Xt c η Metric.isOpen_ball hCc hCT hh hη hψs hψzero
        hY hXsm hAo hAsub hBo hsig
      rw [← hW₁def] at hW₁s hW₁c hW₁C
      have hW₁n : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * W₁ y i * W₁ y j ≤ 1 := by
        intro y
        by_cases hy : y ∈ Metric.ball z₀ R
        · rw [hW₁def]
          exact sepTouch_W1_norm (G y) (hpdT y hy) (Y y) (Xt y) (ψ y) (calTheta c η (h y))
            (sig y) (hY1 y) (hXn y hy).le (hψ0 y) (hψ1 y) (hθ0 _) (hθ1 _) (hsig1 y)
        · have : W₁ y = 0 := by rw [hW₁def]; simp [hψT y hy]
          rw [this]; simp
      have hW₁P : ∫ z in F, sepDensDiv G W₁ z ≤ (sepPerG G F (Metric.ball z₀ R)).toReal := by
        have hle : ENNReal.ofReal (∫ z in F, sepDensDiv G W₁ z) ≤
            sepPerG G F (Metric.ball z₀ R) := by
          unfold sepPerG
          exact le_iSup₂_of_le W₁ ⟨hW₁s, hW₁c, hW₁C.trans hCT, hW₁n⟩ le_rfl
        exact (ENNReal.ofReal_le_iff_le_toReal hfin).1 hle
      obtain ⟨hi1, hi2, hi3⟩ := ccs_euclid_calib G (Metric.ball z₀ R) (Metric.ball z₀ R)
        (Metric.closedBall z₀ r₂) (F ∩ Metric.ball z₀ R) A h ψ d sig Y Xt Zt Y W₁ c η
        Metric.isOpen_ball hGT hdetT hh.contDiffOn hη hψs.contDiffOn (fun z _ => hψ0 z) hCc hCT
        (fun z _ hz => hψzero z hz) Metric.isOpen_ball subset_rfl (fun z hz _ => hz)
        hY.contDiffOn hXsm (fun z hz _ => hCSall z hz (hNT z hz) (Y z) (hY1 z)) hAo hAsub hBo
        (hF.inter Metric.isOpen_ball.measurableSet) Set.inter_subset_right hsig hYT0 hYψ
        (fun z hz => by rw [hW₁def]; simp [hψT z hz])
        (fun z _ i => by rw [hW₁def]; simp only [PiLp.smul_apply, PiLp.add_apply, smul_eq_mul])
        (fun z _ i => by rw [hZtdef]; simp only [PiLp.smul_apply, smul_eq_mul])
        (fun z _ _ => by rw [hddef])
      rw [hSD] at hi1 hi2 hi3
      have hZ0 : ∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
          Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z) = 0 := by
        apply integral_eq_zero_of_ae
        filter_upwards [hae] with z hz
        rw [hdψ z hz]; simp
      have hW₁F : ∫ z in F ∩ Metric.ball z₀ R, sepDensDiv G W₁ z =
          ∫ z in F, sepDensDiv G W₁ z :=
        (hdivres W₁ F (Metric.ball z₀ R) hF (hW₁C.trans hCT)).symm
      have hYF' : ∫ z in ((F ∩ Metric.ball z₀ R) \ {z : E3 | c < h z}) ∪ A, sepDensDiv G Y z =
          ∫ z in (F \ ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} ∩
            Metric.closedBall z₀ (R / 2))) ∪ (A ∩ Metric.closedBall z₀ (R / 2)),
            sepDensDiv G Y z := by
        rw [hdivres Y _ (Metric.ball z₀ R) hF'm hYT]
        exact (setIntegral_congr_set hcomp).symm
      refine ⟨hi1, hi2, ?_⟩
      rw [hZ0, hW₁F, hYF'] at hi3
      linarith
    
    obtain ⟨hdi, hsdi, -⟩ := hstep 1 one_pos
    have hdae : d =ᵐ[volume.restrict
        (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z})]
        fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z := by
      filter_upwards [hae, ae_restrict_mem hDm] with z hz hzD
      have hzT : z ∈ Metric.ball z₀ R := hzD.2.1
      rw [hddef]
      simp only
      rw [hψone z (Metric.ball_subset_closedBall hz), one_mul, hdivX z hzT]
    have hint : IntegrableOn (fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z)
        (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) :=
      hdi.congr_fun_ae hdae
    have hdI : ∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}, d z =
        ∫ z in symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z},
          Real.sqrt (G z).det * levelMeanCurvCoord G h z :=
      integral_congr_ae hdae
    
    have hDc : ∀ z ∈ symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}, c < h z :=
      fun z hz => hz.2.2
    have t1 := hθlim d hdi
    have t2 := hθlim (fun z => sig z * sepDensDiv G Y z) hsdi
    have hlim := t1.add ((tendsto_const_nhds (x := ∫ z in symmDiff F A ∩
      {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}, sig z * sepDensDiv G Y z)).sub t2)
    rw [sub_self, add_zero, hdI] at hlim
    have hle := le_of_tendsto' hlim (fun k => (hstep (1 / ((k : ℝ) + 1)) (by positivity)).2.2)
    exact ⟨hint, by linarith⟩
  
  refine ⟨(key 0 contDiff_const HasCompactSupport.zero
    (by rw [tsupport_zero]; exact Set.empty_subset _) (by intro y; simp)).1,
    fun Y hY hYc hYT hY1 => (key Y hY hYc hYT hY1).2⟩

theorem sepPerMin_touch_principle (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U W : Set E3)
    (f : E3 → ℝ) (z₀ : E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (hmin : sepIsPerMin G F U) (hW : IsOpen W) (hWU : W ⊆ U) (hf : ContDiff ℝ ∞ f)
    (hz₀ : z₀ ∈ W) (hf0 : f z₀ = 0)
    (hbd : ∀ N ∈ 𝓝 z₀, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) :
    ((∀ z ∈ W, levelMeanCurvCoord G f z < 0) →
        volume ((W ∩ {z | f z < 0}) \ F) = 0 → False) ∧
    ((∀ z ∈ W, 0 < levelMeanCurvCoord G f z) →
        volume (W ∩ {z | 0 < f z} ∩ F) = 0 → False) :=
by
  classical
  
  have hpdn : ∀ (i : Fin 3) (k : E3 → ℝ),
      partialDeriv i (fun z => -k z) = fun z => -partialDeriv i k z := by
    intro i k
    funext z
    simp only [partialDeriv]
    rw [show (fun z => -k z) = -k from rfl, fderiv_neg]
    rfl
  have hhess : ∀ (k : E3 → ℝ) (i j : Fin 3) (y : E3),
      hessLoc G (fun z => -k z) i j y = -hessLoc G k i j y := by
    intro k i j y
    simp only [hessLoc, hpdn]
    simp only [mul_neg, Finset.sum_neg_distrib]
    ring
  have hlap : ∀ (k : E3 → ℝ) (y : E3), lapLoc G (fun z => -k z) y = -lapLoc G k y := by
    intro k y
    simp only [lapLoc, hhess, mul_neg, Finset.sum_neg_distrib]
  have hlmc_neg : ∀ y : E3,
      levelMeanCurvCoord G (fun z => -f z) y = -levelMeanCurvCoord G f y := by
    intro y
    simp only [levelMeanCurvCoord, hlap, hpdn, hhess, neg_mul, mul_neg, neg_neg,
      Finset.sum_neg_distrib]
    ring
  
  have core : ∀ (A : Set E3) (h : E3 → ℝ) (R c : ℝ), 0 < R →
      Metric.closedBall z₀ R ⊆ U → ContDiff ℝ ∞ h →
      (∀ z ∈ Metric.closedBall z₀ R,
        0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a h z * partialDeriv b h z ∧
        0 < levelMeanCurvCoord G h z) →
      IsOpen A → A ⊆ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} →
      IsOpen ({z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} \ A) →
      volume ((symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) \
        Metric.closedBall z₀ (R / 2)) = 0 →
      volume (symmDiff F A ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z}) = 0 := by
    intro A h R c hR hRU hh hNH hAo hAsub hBo hloc
    have hF : MeasurableSet F := hmin.1
    have hcl : closure (Metric.ball z₀ R) = Metric.closedBall z₀ R :=
      closure_ball z₀ (ne_of_gt hR)
    have hcV : IsCompact (closure (Metric.ball z₀ R)) := by
      rw [hcl]; exact isCompact_closedBall z₀ R
    have hVU : closure (Metric.ball z₀ R) ⊆ U := by rw [hcl]; exact hRU
    have hSlt : sepPerG G F (Metric.ball z₀ R) < ⊤ :=
      hmin.2.1 _ Metric.isOpen_ball hcV hVU
    obtain ⟨hint, hbdY⟩ := sepTouch_perY_bound G F U A h z₀ R c hU hG hsymm hpd hF hR hRU hh
      hNH hAo hAsub hBo hloc hSlt.ne
    have hΩo : IsOpen {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hh.continuous)
    set Ω : Set E3 := {z : E3 | z ∈ Metric.ball z₀ R ∧ c < h z} with hΩdef
    set K : Set E3 := Metric.closedBall z₀ (R / 2) with hKdef
    set D : Set E3 := symmDiff F A ∩ Ω with hDdef
    set F' : Set E3 := (F \ (Ω ∩ K)) ∪ (A ∩ K) with hF'def
    set I : ℝ := ∫ z in D, Real.sqrt (G z).det * levelMeanCurvCoord G h z with hIdef
    set P : ℝ := (sepPerG G F (Metric.ball z₀ R)).toReal with hPdef
    have hKV : K ⊆ Metric.ball z₀ R := Metric.closedBall_subset_ball (by linarith)
    have hKc : IsCompact K := isCompact_closedBall z₀ (R / 2)
    have hF'm : MeasurableSet F' :=
      (hF.diff (hΩo.measurableSet.inter Metric.isClosed_closedBall.measurableSet)).union
        (hAo.measurableSet.inter Metric.isClosed_closedBall.measurableSet)
    have hsd : symmDiff F F' ⊆ K := by
      intro z hz
      by_contra hzK
      rw [Set.mem_symmDiff] at hz
      simp only [hF'def, Set.mem_union, Set.mem_diff, Set.mem_inter_iff] at hz
      tauto
    
    have hzero : ∀ z, sepDensDiv G (0 : E3 → E3) z = 0 := by
      intro z
      simp [sepDensDiv, partialDeriv]
    have hIP : I ≤ P := by
      have h0 := hbdY (0 : E3 → E3) contDiff_const HasCompactSupport.zero
        (by rw [tsupport_zero]; exact Set.empty_subset _) (by intro y; simp)
      simp only [hzero, integral_zero, zero_add] at h0
      exact h0
    have hS' : sepPerG G F' (Metric.ball z₀ R) ≤ ENNReal.ofReal (P - I) := by
      unfold sepPerG
      refine iSup₂_le ?_
      intro Y hY
      apply ENNReal.ofReal_le_ofReal
      have := hbdY Y hY.1 hY.2.1 hY.2.2.1 hY.2.2.2
      linarith
    have hminle : sepPerG G F (Metric.ball z₀ R) ≤ sepPerG G F' (Metric.ball z₀ R) :=
      hmin.2.2 F' _ K hF'm Metric.isOpen_ball hcV hVU hKc hKV hsd
    have hSeq : sepPerG G F (Metric.ball z₀ R) = ENNReal.ofReal P :=
      (ENNReal.ofReal_toReal hSlt.ne).symm
    have hle : ENNReal.ofReal P ≤ ENNReal.ofReal (P - I) := by
      rw [← hSeq]; exact hminle.trans hS'
    have hPI : P ≤ P - I := (ENNReal.ofReal_le_ofReal_iff (by linarith)).1 hle
    have hI0 : I ≤ 0 := by linarith
    
    have hDm : MeasurableSet D := (hF.symmDiff hAo.measurableSet).inter hΩo.measurableSet
    have hpos : ∀ z ∈ D, 0 < Real.sqrt (G z).det * levelMeanCurvCoord G h z := by
      intro z hz
      have hzb : z ∈ Metric.closedBall z₀ R := Metric.ball_subset_closedBall hz.2.1
      have hdet : 0 < (G z).det := (hpd z (hRU hzb)).det_pos
      exact mul_pos (Real.sqrt_pos.2 hdet) (hNH z hzb).2
    by_contra hD
    have hnn : 0 ≤ᵐ[volume.restrict D] fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z :=
      (ae_restrict_iff' hDm).2 (Filter.Eventually.of_forall fun z hz => (hpos z hz).le)
    have hsupp : Function.support (fun z => Real.sqrt (G z).det * levelMeanCurvCoord G h z) ∩ D
        = D := Set.inter_eq_right.2 (fun z hz => ne_of_gt (hpos z hz))
    have hIpos : 0 < I := by
      rw [hIdef, setIntegral_pos_iff_support_of_nonneg_ae hnn hint, hsupp]
      exact pos_iff_ne_zero.2 hD
    linarith
  
  have hquad : ∀ (R ε : ℝ) (z : E3), 0 < R → 0 < ε → z ∉ Metric.closedBall z₀ (R / 2) →
      ε * R ^ 2 / 4 < ε * ‖z - z₀‖ ^ 2 := by
    intro R ε z hR hε hz
    rw [Metric.mem_closedBall, dist_eq_norm, not_le] at hz
    have h1 : (R / 2) ^ 2 < ‖z - z₀‖ ^ 2 := by
      have : 0 ≤ R / 2 := by linarith
      nlinarith
    nlinarith
  constructor
  · 
    intro hneg hvol
    have hgH : 0 < levelMeanCurvCoord G (fun z => -f z) z₀ := by
      rw [hlmc_neg]; linarith [hneg z₀ hz₀]
    obtain ⟨R, ε, hR, hε, hRW, hNH⟩ :=
      sepTouch_strictify G U W (fun z => -f z) z₀ hU hG hpd hW hWU hf.neg hz₀ hgH
    have hh : ContDiff ℝ ∞ (fun y => -f y - ε * ‖y - z₀‖ ^ 2) :=
      hf.neg.sub (contDiff_const.mul ((contDiff_id.sub contDiff_const).norm_sq ℝ))
    have hΩo : IsOpen {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2} :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hh.continuous)
    have hloc : volume ((symmDiff F {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2} ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2}) \ Metric.closedBall z₀ (R / 2)) = 0 := by
      refine measure_mono_null ?_ hvol
      rintro z ⟨⟨hz1, hz2⟩, hz3⟩
      rw [Set.mem_symmDiff] at hz1
      have hzF : z ∉ F := by
        rcases hz1 with ⟨_, hn⟩ | ⟨_, hn⟩
        · exact absurd hz2 hn
        · exact hn
      have hq := hquad R ε z hR hε hz3
      have hfz : f z < 0 := by
        have := hz2.2
        linarith
      exact ⟨⟨hRW (Metric.ball_subset_closedBall hz2.1), hfz⟩, hzF⟩
    have hBo : IsOpen ({z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2} \ {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2}) := by
      rw [Set.diff_self]; exact isOpen_empty
    have hD := core _ (fun y => -f y - ε * ‖y - z₀‖ ^ 2) R (-(ε * R ^ 2 / 4)) hR
      (hRW.trans hWU) hh hNH hΩo (subset_refl _) hBo hloc
    have hz₀Ω : z₀ ∈ {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < -f z - ε * ‖z - z₀‖ ^ 2} := by
      refine ⟨Metric.mem_ball_self hR, ?_⟩
      simp only [hf0, sub_self, norm_zero]
      have : 0 < ε * R ^ 2 := by positivity
      nlinarith
    apply (hbd _ (hΩo.mem_nhds hz₀Ω)).2
    refine measure_mono_null ?_ hD
    rintro z ⟨hz1, hz2⟩
    exact ⟨Set.mem_symmDiff.2 (Or.inr ⟨hz1, hz2⟩), hz1⟩
  · 
    intro hposH hvol
    obtain ⟨R, ε, hR, hε, hRW, hNH⟩ :=
      sepTouch_strictify G U W f z₀ hU hG hpd hW hWU hf hz₀ (hposH z₀ hz₀)
    have hh : ContDiff ℝ ∞ (fun y => f y - ε * ‖y - z₀‖ ^ 2) :=
      hf.sub (contDiff_const.mul ((contDiff_id.sub contDiff_const).norm_sq ℝ))
    have hΩo : IsOpen {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < f z - ε * ‖z - z₀‖ ^ 2} :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hh.continuous)
    have hloc : volume ((symmDiff F (∅ : Set E3) ∩ {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < f z - ε * ‖z - z₀‖ ^ 2}) \ Metric.closedBall z₀ (R / 2)) = 0 := by
      refine measure_mono_null ?_ hvol
      rintro z ⟨⟨hz1, hz2⟩, hz3⟩
      rw [Set.mem_symmDiff] at hz1
      have hzF : z ∈ F := by
        rcases hz1 with ⟨hn, _⟩ | ⟨hn, _⟩
        · exact hn
        · exact absurd hn (by simp)
      have hq := hquad R ε z hR hε hz3
      have hfz : 0 < f z := by
        have := hz2.2
        linarith
      exact ⟨⟨hRW (Metric.ball_subset_closedBall hz2.1), hfz⟩, hzF⟩
    have hBo : IsOpen ({z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < f z - ε * ‖z - z₀‖ ^ 2} \ (∅ : Set E3)) := by
      rw [Set.diff_empty]; exact hΩo
    have hD := core ∅ (fun y => f y - ε * ‖y - z₀‖ ^ 2) R (-(ε * R ^ 2 / 4)) hR
      (hRW.trans hWU) hh hNH isOpen_empty (Set.empty_subset _) hBo hloc
    have hz₀Ω : z₀ ∈ {z : E3 | z ∈ Metric.ball z₀ R ∧
        -(ε * R ^ 2 / 4) < f z - ε * ‖z - z₀‖ ^ 2} := by
      refine ⟨Metric.mem_ball_self hR, ?_⟩
      simp only [hf0, sub_self, norm_zero]
      have : 0 < ε * R ^ 2 := by positivity
      nlinarith
    apply (hbd _ (hΩo.mem_nhds hz₀Ω)).1
    refine measure_mono_null ?_ hD
    rintro z ⟨hz1, hz2⟩
    exact ⟨Set.mem_symmDiff.2 (Or.inl ⟨hz2, fun h => h⟩), hz1⟩

theorem hpHarn_normalize (δ c : ℝ) (hδ : 0 < δ) (hc : 0 < c) (hc1 : c < 1)
    (hN : hpHarnNorm δ c) :
    ∃ δH cH : ℝ, 0 < δH ∧ 0 < cH ∧ cH < 1 ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (y ν : E3) (r a b : ℝ),
    IsOpen U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U) →
    (∀ (z : E3) (i j : Fin 3), G z i j = G z j i) → (∀ z ∈ U, (G z).PosDef) →
    sepIsPerMin G F U → 0 < r → Metric.closedBall y r ⊆ U → ‖ν‖ = 1 → a ≤ b →
    b - a ≤ δH * r →
    (∀ z ∈ Metric.ball y r, ∀ i j : Fin 3,
       |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ δH ∧
       ‖fderiv ℝ (fun w => G w i j) z‖ * r ^ 2 ≤ δH * (b - a)) →
    (∀ N ∈ 𝓝 y, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
    (∀ z ∈ Metric.ball y r, (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
       a ≤ @inner ℝ E3 _ ν z ∧ @inner ℝ E3 _ ν z ≤ b) →
    volume ((Metric.ball y r ∩ {z | @inner ℝ E3 _ ν z < a}) \ F) = 0 →
    volume (Metric.ball y r ∩ {z | b < @inner ℝ E3 _ ν z} ∩ F) = 0 →
    ∃ a' b' : ℝ, a ≤ a' ∧ a' ≤ b' ∧ b' ≤ b ∧ b' - a' ≤ (1 - cH) * (b - a) ∧
      ∀ z ∈ Metric.ball y (r / 8),
        (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
        a' ≤ @inner ℝ E3 _ ν z ∧ @inner ℝ E3 _ ν z ≤ b' :=
by
  refine ⟨δ / 9, c, by positivity, hc, hc1, ?_⟩
  intro G F U y ν r a b hU hG hsymm hpd hmin hr hcb hν hab hba hmet hy hslab hbot htop
  
  obtain ⟨R, hR⟩ : ∃ R : E3 ≃ₗᵢ[ℝ] E3, ∀ w : E3, @inner ℝ E3 _ ν (R w) = w 0 := by
    have he : ‖e 0‖ = ‖ν‖ := by rw [hν]; simp [e]
    refine ⟨(ℝ ∙ (e 0 - ν))ᗮ.reflection, fun w => ?_⟩
    have h1 : (ℝ ∙ (e 0 - ν))ᗮ.reflection (e 0) = ν := Submodule.reflection_sub he
    have h2 : @inner ℝ E3 _ ((ℝ ∙ (e 0 - ν))ᗮ.reflection (e 0))
        ((ℝ ∙ (e 0 - ν))ᗮ.reflection w) = @inner ℝ E3 _ (e 0) w :=
      LinearIsometryEquiv.inner_map_map _ _ _
    rw [h1] at h2
    rw [h2]
    simp [e, EuclideanSpace.inner_single_left]
  
  obtain ⟨L, hL⟩ : ∃ L : E3 ≃L[ℝ] E3, ∀ v, L v = r • R v :=
    ⟨R.toContinuousLinearEquiv.trans
      (LinearEquiv.smulOfNeZero ℝ E3 r hr.ne').toContinuousLinearEquiv, fun v => rfl⟩
  have hfd : ∀ z : E3, fderiv ℝ (fun w : E3 => y + L w) z = (L : E3 →L[ℝ] E3) := by
    intro z; rw [fderiv_const_add]; exact L.fderiv
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : ℝ, c₀ = (r ^ 2)⁻¹ := ⟨_, rfl⟩
  have hc₀pos : 0 < c₀ := by rw [hc₀]; positivity
  have hc₀r : c₀ * r ^ 2 = 1 := by rw [hc₀]; field_simp
  obtain ⟨-, hG', hsymm', hpd', hmin'⟩ :=
    sepAffinePullback G F U hU hmin.1 hG hsymm hpd y L c₀ hc₀pos
  have hφc : Continuous (fun w : E3 => y + L w) := continuous_const.add L.continuous
  have hdist : ∀ w : E3, dist (y + L w) y = r * ‖w‖ := by
    intro w
    rw [dist_eq_norm, add_sub_cancel_left, hL, norm_smul, Real.norm_of_nonneg hr.le,
      LinearIsometryEquiv.norm_map]
  have hball : ∀ (w : E3) (ρ : ℝ), w ∈ Metric.ball (0 : E3) ρ ↔
      y + L w ∈ Metric.ball y (r * ρ) := by
    intro w ρ
    rw [Metric.mem_ball, Metric.mem_ball, hdist, dist_zero_right]
    exact ⟨fun h => mul_lt_mul_of_pos_left h hr, fun h => lt_of_mul_lt_mul_left h hr.le⟩
  obtain ⟨h₀, hh₀⟩ : ∃ h₀ : ℝ, h₀ = @inner ℝ E3 _ ν y := ⟨_, rfl⟩
  have hH : ∀ w : E3, @inner ℝ E3 _ ν (y + L w) = h₀ + r * w 0 := by
    intro w; rw [inner_add_right, hL, real_inner_smul_right, hR, hh₀]
  
  have hnull : ∀ S : Set E3, volume ((fun w => y + L w) ⁻¹' S) = 0 ↔ volume S = 0 := by
    intro S
    have h1 : (fun w => y + L w) ⁻¹' S = L ⁻¹' ((fun h => y + h) ⁻¹' S) := rfl
    rw [h1, MeasureTheory.Measure.addHaar_preimage_continuousLinearEquiv,
      MeasureTheory.measure_preimage_add]
    have hd : LinearMap.det ((L.symm : E3 ≃L[ℝ] E3) : E3 →ₗ[ℝ] E3) ≠ 0 :=
      (LinearEquiv.isUnit_det' L.symm.toLinearEquiv).ne_zero
    rw [mul_eq_zero]
    constructor
    · rintro (h | h)
      · exfalso
        rw [ENNReal.ofReal_eq_zero] at h
        have := abs_pos.2 hd
        linarith
      · exact h
    · intro h; exact Or.inr h
  have hbd : ∀ w : E3, (∀ N ∈ 𝓝 w, volume (N ∩ (fun w => y + L w) ⁻¹' F) ≠ 0 ∧
      volume (N \ (fun w => y + L w) ⁻¹' F) ≠ 0) ↔
      (∀ N ∈ 𝓝 (y + L w), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) := by
    intro w
    constructor
    · intro h N hN
      have hN' : (fun w => y + L w) ⁻¹' N ∈ 𝓝 w := hφc.continuousAt.preimage_mem_nhds hN
      obtain ⟨h1, h2⟩ := h _ hN'
      exact ⟨fun h0 => h1 ((hnull (N ∩ F)).2 h0), fun h0 => h2 ((hnull (N \ F)).2 h0)⟩
    · intro h N hN
      have hψc : Continuous (fun z : E3 => L.symm (z - y)) :=
        L.symm.continuous.comp (continuous_sub_right y)
      have hψ : (fun z : E3 => L.symm (z - y)) (y + L w) = w := by simp
      have hN' : (fun z : E3 => L.symm (z - y)) ⁻¹' N ∈ 𝓝 (y + L w) := by
        apply hψc.continuousAt.preimage_mem_nhds
        simpa using hN
      obtain ⟨h1, h2⟩ := h _ hN'
      have e1 : (fun w => y + L w) ⁻¹' ((fun z : E3 => L.symm (z - y)) ⁻¹' N ∩ F) =
          N ∩ (fun w => y + L w) ⁻¹' F := by
        ext v; simp
      have e2 : (fun w => y + L w) ⁻¹' ((fun z : E3 => L.symm (z - y)) ⁻¹' N \ F) =
          N \ (fun w => y + L w) ⁻¹' F := by
        ext v; simp
      refine ⟨fun h0 => h1 ?_, fun h0 => h2 ?_⟩
      · rw [← hnull, e1]; exact h0
      · rw [← hnull, e2]; exact h0
  
  obtain ⟨ta, hra⟩ : ∃ t : ℝ, r * t = a - h₀ := ⟨(a - h₀) / r, by field_simp⟩
  obtain ⟨tb, hrb⟩ : ∃ t : ℝ, r * t = b - h₀ := ⟨(b - h₀) / r, by field_simp⟩
  have hab' : ta ≤ tb := le_of_mul_le_mul_left (by linarith) hr
  have hwidth : r * (tb - ta) = b - a := by linarith
  
  have hent : ∀ (v : E3) (a b : Fin 3), (c₀ • pullbackMetric G (fun w => y + L w) v) a b =
      ∑ i : Fin 3, ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * G (y + L v) i j := by
    intro v a b
    simp only [pullbackMetric, hfd, Matrix.smul_apply, smul_eq_mul,
      ContinuousLinearEquiv.coe_coe]
    rw [hL (e a), hL (e b)]
    simp only [PiLp.smul_apply, smul_eq_mul]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    linear_combination ((R (e a)) i * (R (e b)) j * G (y + L v) i j) * hc₀r
  have hrho : ∀ i a : Fin 3, |(R (e a)) i| ≤ 1 := by
    intro i a
    have h := PiLp.norm_apply_le (R (e a)) i
    rw [LinearIsometryEquiv.norm_map] at h
    simpa [e] using h
  have horth : ∀ a b : Fin 3,
      ∑ i : Fin 3, (R (e a)) i * (R (e b)) i = if a = b then (1 : ℝ) else 0 := by
    intro a b
    have h : @inner ℝ E3 _ (R (e a)) (R (e b)) = @inner ℝ E3 _ (e a) (e b) :=
      R.inner_map_map _ _
    rw [EuclideanSpace.inner_single_left, PiLp.inner_apply] at h
    simp only [e, EuclideanSpace.single_apply, map_one, one_mul] at h
    rw [← h]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [mul_comm]
  have hdelta : ∀ a b : Fin 3, (if a = b then (1 : ℝ) else 0) =
      ∑ i : Fin 3, ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * (if i = j then (1 : ℝ) else 0) := by
    intro a b
    rw [← horth]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [mul_ite]
  have hLn : ‖(L : E3 →L[ℝ] E3)‖ ≤ r := by
    refine ContinuousLinearMap.opNorm_le_bound _ hr.le (fun v => ?_)
    rw [ContinuousLinearEquiv.coe_coe, hL, norm_smul, Real.norm_of_nonneg hr.le,
      LinearIsometryEquiv.norm_map]
  have hmet' : ∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |(c₀ • pullbackMetric G (fun w => y + L w) z) i j - (if i = j then (1 : ℝ) else 0)| ≤ δ ∧
      ‖fderiv ℝ (fun w => (c₀ • pullbackMetric G (fun u => y + L u) w) i j) z‖ ≤
        δ * (tb - ta) := by
    intro w hw a b
    have hzB : y + L w ∈ Metric.ball y r := by
      have := (hball w 1).1 hw; rwa [mul_one] at this
    have hzU : y + L w ∈ U := hcb (Metric.ball_subset_closedBall hzB)
    have hm := hmet (y + L w) hzB
    constructor
    · rw [hent, hdelta, ← Finset.sum_sub_distrib]
      calc |∑ i : Fin 3, (∑ j : Fin 3, (R (e a)) i * (R (e b)) j * G (y + L w) i j -
              ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * (if i = j then (1 : ℝ) else 0))|
          ≤ ∑ i : Fin 3, |∑ j : Fin 3, (R (e a)) i * (R (e b)) j * G (y + L w) i j -
              ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * (if i = j then (1 : ℝ) else 0)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, δ / 9 := by
            refine Finset.sum_le_sum fun i _ => ?_
            rw [← Finset.sum_sub_distrib]
            refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
            rw [← mul_sub, abs_mul, abs_mul]
            have h1 := hrho i a
            have h2 := hrho j b
            have h3 := (hm i j).1
            have h4 : 0 ≤ |G (y + L w) i j - if i = j then (1 : ℝ) else 0| := abs_nonneg _
            have h5 : |(R (e a)) i| * |(R (e b)) j| ≤ 1 := by
              have := mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
              linarith
            calc |(R (e a)) i| * |(R (e b)) j| * |G (y + L w) i j - if i = j then 1 else 0|
                ≤ 1 * |G (y + L w) i j - if i = j then 1 else 0| :=
                  mul_le_mul_of_nonneg_right h5 h4
              _ ≤ δ / 9 := by linarith
        _ = δ := by simp; ring
    · have hfun : (fun v => (c₀ • pullbackMetric G (fun u => y + L u) v) a b) =
          fun v => ∑ i : Fin 3, ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * G (y + L v) i j :=
        funext fun v => hent v a b
      have hd : ∀ i j : Fin 3, HasFDerivAt (fun v => G (y + L v) i j)
          ((fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)) w := by
        intro i j
        have hdiff : DifferentiableAt ℝ (fun z => G z i j) (y + L w) :=
          ((hG i j).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hzU)
        exact hdiff.hasFDerivAt.comp w ((L : E3 →L[ℝ] E3).hasFDerivAt.const_add y)
      have hsum : HasFDerivAt
          (fun v => ∑ i : Fin 3, ∑ j : Fin 3, (R (e a)) i * (R (e b)) j * G (y + L v) i j)
          (∑ i : Fin 3, ∑ j : Fin 3, ((R (e a)) i * (R (e b)) j) •
            (fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)) w := by
        apply HasFDerivAt.fun_sum; intro i _
        apply HasFDerivAt.fun_sum; intro j _
        exact (hd i j).const_mul _
      rw [hfun, hsum.fderiv]
      have hDb : ∀ i j : Fin 3, ‖fderiv ℝ (fun z => G z i j) (y + L w)‖ * r ≤
          δ / 9 * (tb - ta) := by
        intro i j
        have h2 := (hm i j).2
        rw [← hwidth] at h2
        refine le_of_mul_le_mul_right ?_ hr
        nlinarith
      calc ‖∑ i : Fin 3, ∑ j : Fin 3, ((R (e a)) i * (R (e b)) j) •
            (fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖
          ≤ ∑ i : Fin 3, ‖∑ j : Fin 3, ((R (e a)) i * (R (e b)) j) •
            (fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖ := norm_sum_le _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, δ / 9 * (tb - ta) := by
            refine Finset.sum_le_sum fun i _ => ?_
            refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
            rw [norm_smul, Real.norm_eq_abs, abs_mul]
            have h1 := hrho i a
            have h2 := hrho j b
            have h5 : |(R (e a)) i| * |(R (e b)) j| ≤ 1 := by
              have := mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
              linarith
            have h6 : ‖(fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖ ≤
                δ / 9 * (tb - ta) := by
              refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
              refine le_trans ?_ (hDb i j)
              exact mul_le_mul_of_nonneg_left hLn (norm_nonneg _)
            have h7 : 0 ≤ ‖(fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖ :=
              norm_nonneg _
            calc |(R (e a)) i| * |(R (e b)) j| *
                  ‖(fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖
                ≤ 1 * ‖(fderiv ℝ (fun z => G z i j) (y + L w)).comp (L : E3 →L[ℝ] E3)‖ :=
                  mul_le_mul_of_nonneg_right h5 h7
              _ ≤ δ / 9 * (tb - ta) := by linarith
        _ = δ * (tb - ta) := by simp; ring
  
  have hŨ : IsOpen ((fun w => y + L w) ⁻¹' U) := hU.preimage hφc
  have hcb' : Metric.closedBall (0 : E3) 1 ⊆ (fun w => y + L w) ⁻¹' U := by
    intro w hw
    apply hcb
    rw [Metric.mem_closedBall, hdist]
    rw [Metric.mem_closedBall, dist_zero_right] at hw
    nlinarith
  have hba' : tb - ta ≤ δ := by
    have h1 : r * (tb - ta) ≤ r * δ := by
      rw [hwidth]; nlinarith
    exact le_of_mul_le_mul_left h1 hr
  have hy' : ∀ N ∈ 𝓝 (0 : E3), volume (N ∩ (fun w => y + L w) ⁻¹' F) ≠ 0 ∧
      volume (N \ (fun w => y + L w) ⁻¹' F) ≠ 0 := by
    rw [hbd]
    simpa using hy
  have hslab' : ∀ z ∈ Metric.ball (0 : E3) 1,
      (∀ N ∈ 𝓝 z, volume (N ∩ (fun w => y + L w) ⁻¹' F) ≠ 0 ∧
        volume (N \ (fun w => y + L w) ⁻¹' F) ≠ 0) → ta ≤ z 0 ∧ z 0 ≤ tb := by
    intro w hw hwb
    have hzB : y + L w ∈ Metric.ball y r := by
      have := (hball w 1).1 hw; rwa [mul_one] at this
    obtain ⟨h1, h2⟩ := hslab (y + L w) hzB ((hbd w).1 hwb)
    rw [hH] at h1 h2
    exact ⟨le_of_mul_le_mul_left (by linarith) hr, le_of_mul_le_mul_left (by linarith) hr⟩
  have hbot' : volume ((Metric.ball (0 : E3) 1 ∩ {z | z 0 < ta}) \
      (fun w => y + L w) ⁻¹' F) = 0 := by
    refine measure_mono_null ?_ ((hnull _).2 hbot)
    rintro w ⟨⟨hw1, hw2⟩, hw3⟩
    refine ⟨⟨?_, ?_⟩, hw3⟩
    · have := (hball w 1).1 hw1; rwa [mul_one] at this
    · show @inner ℝ E3 _ ν (y + L w) < a
      rw [hH]
      have h : w 0 < ta := hw2
      have := mul_lt_mul_of_pos_left h hr
      linarith
  have htop' : volume (Metric.ball (0 : E3) 1 ∩ {z | tb < z 0} ∩
      (fun w => y + L w) ⁻¹' F) = 0 := by
    refine measure_mono_null ?_ ((hnull _).2 htop)
    rintro w ⟨⟨hw1, hw2⟩, hw3⟩
    refine ⟨⟨?_, ?_⟩, hw3⟩
    · have := (hball w 1).1 hw1; rwa [mul_one] at this
    · show b < @inner ℝ E3 _ ν (y + L w)
      rw [hH]
      have h : tb < w 0 := hw2
      have := mul_lt_mul_of_pos_left h hr
      linarith
  
  obtain ⟨ta', tb', h1, h2, h3, h4, h5⟩ :=
    hN (fun z => c₀ • pullbackMetric G (fun w => y + L w) z) ((fun w => y + L w) ⁻¹' F)
      ((fun w => y + L w) ⁻¹' U) ta tb hŨ hG' hsymm' hpd' (hmin' hmin) hcb' hab' hba' hmet'
      hy' hslab' hbot' htop'
  refine ⟨h₀ + r * ta', h₀ + r * tb', ?_, ?_, ?_, ?_, ?_⟩
  · have := mul_le_mul_of_nonneg_left h1 hr.le; linarith
  · have := mul_le_mul_of_nonneg_left h2 hr.le; linarith
  · have := mul_le_mul_of_nonneg_left h3 hr.le; linarith
  · have := mul_le_mul_of_nonneg_left h4 hr.le
    have e1 : r * ((1 - c) * (tb - ta)) = (1 - c) * (b - a) := by rw [← hwidth]; ring
    nlinarith
  · intro z hz hzb
    have hinv : y + L (L.symm (z - y)) = z := by simp
    have hw : L.symm (z - y) ∈ Metric.ball (0 : E3) (1 / 8) := by
      rw [hball, hinv]
      have : r * (1 / 8) = r / 8 := by ring
      rw [this]; exact hz
    have hwb := (hbd (L.symm (z - y))).2 (by rw [hinv]; exact hzb)
    obtain ⟨k1, k2⟩ := h5 _ hw hwb
    have hz' : @inner ℝ E3 _ ν z = h₀ + r * (L.symm (z - y)) 0 := by
      rw [← hH, hinv]
    rw [hz']
    exact ⟨by have := mul_le_mul_of_nonneg_left k1 hr.le; linarith,
      by have := mul_le_mul_of_nonneg_left k2 hr.le; linarith⟩

theorem hpHarn_envelopes (F : Set E3) (a b : ℝ) (ha : -(1 / 8) ≤ a) (hab : a ≤ b)
    (hb : b ≤ 1 / 8)
    (hslab : ∀ z ∈ Metric.ball (0 : E3) 1,
      (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) → a ≤ z 0 ∧ z 0 ≤ b)
    (hbot : volume ((Metric.ball (0 : E3) 1 ∩ {z | z 0 < a}) \ F) = 0)
    (htop : volume (Metric.ball (0 : E3) 1 ∩ {z | b < z 0} ∩ F) = 0) :
    ∃ ℓ υ : E2 → ℝ,
      (∀ x ∈ Metric.ball (0 : E2) (1 / 2), a ≤ ℓ x ∧ ℓ x ≤ υ x ∧ υ x ≤ b) ∧
      (∀ x ∈ Metric.ball (0 : E2) (1 / 2),
        (∀ N ∈ 𝓝 (hpLift (ℓ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) ∧
        (∀ N ∈ 𝓝 (hpLift (υ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0)) ∧
      (∀ z ∈ Metric.ball (0 : E3) (1 / 2),
        (∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
        ℓ (hpProj z) ≤ z 0 ∧ z 0 ≤ υ (hpProj z)) ∧
      volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ z 0 < ℓ (hpProj z)} \ F) = 0 ∧
      volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ υ (hpProj z) < z 0} ∩ F) = 0 ∧
      LowerSemicontinuousOn ℓ (Metric.ball (0 : E2) (1 / 2)) ∧
      UpperSemicontinuousOn υ (Metric.ball (0 : E2) (1 / 2)) :=
by
  classical
  obtain ⟨Bd, hBd⟩ : ∃ Bd : E3 → Prop, ∀ z, Bd z ↔
      ∀ N ∈ 𝓝 z, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0 := ⟨_, fun z => Iff.rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : Set E3, ∀ z, z ∈ A ↔ ∃ N ∈ 𝓝 z, volume (N \ F) = 0 :=
    ⟨{z | ∃ N ∈ 𝓝 z, volume (N \ F) = 0}, fun z => Iff.rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : Set E3, ∀ z, z ∈ E ↔ ∃ N ∈ 𝓝 z, volume (N ∩ F) = 0 :=
    ⟨{z | ∃ N ∈ 𝓝 z, volume (N ∩ F) = 0}, fun z => Iff.rfl⟩
  have hAo : IsOpen A := by
    rw [isOpen_iff_mem_nhds]
    intro z hz
    obtain ⟨N, hN, h0⟩ := (hA z).1 hz
    obtain ⟨O, hON, hO, hzO⟩ := _root_.mem_nhds_iff.1 hN
    exact Filter.mem_of_superset (hO.mem_nhds hzO) (fun w hw =>
      (hA w).2 ⟨O, hO.mem_nhds hw, measure_mono_null (Set.diff_subset_diff_left hON) h0⟩)
  have hEo : IsOpen E := by
    rw [isOpen_iff_mem_nhds]
    intro z hz
    obtain ⟨N, hN, h0⟩ := (hE z).1 hz
    obtain ⟨O, hON, hO, hzO⟩ := _root_.mem_nhds_iff.1 hN
    exact Filter.mem_of_superset (hO.mem_nhds hzO) (fun w hw =>
      (hE w).2 ⟨O, hO.mem_nhds hw, measure_mono_null (Set.inter_subset_inter_left F hON) h0⟩)
  have hdisj : ∀ z, z ∈ A → z ∈ E → False := by
    intro z hzA hzE
    obtain ⟨N₁, hN₁, h₁⟩ := (hA z).1 hzA
    obtain ⟨N₂, hN₂, h₂⟩ := (hE z).1 hzE
    have hN : N₁ ∩ N₂ ∈ 𝓝 z := Filter.inter_mem hN₁ hN₂
    have hpos : 0 < volume (N₁ ∩ N₂) :=
      MeasureTheory.Measure.measure_pos_of_mem_nhds volume hN
    have hle : volume (N₁ ∩ N₂) ≤ volume ((N₁ ∩ N₂) ∩ F) + volume ((N₁ ∩ N₂) \ F) :=
      measure_le_inter_add_diff _ _ _
    have e1 : volume ((N₁ ∩ N₂) ∩ F) = 0 :=
      measure_mono_null (fun w (hw : w ∈ (N₁ ∩ N₂) ∩ F) => (⟨hw.1.2, hw.2⟩ : w ∈ N₂ ∩ F)) h₂
    have e2 : volume ((N₁ ∩ N₂) \ F) = 0 :=
      measure_mono_null (fun w (hw : w ∈ (N₁ ∩ N₂) \ F) => (⟨hw.1.1, hw.2⟩ : w ∈ N₁ \ F)) h₁
    rw [e1, e2, add_zero] at hle
    exact absurd (le_antisymm hle (zero_le _)) hpos.ne'
  have hcover : ∀ z, ¬ Bd z → z ∈ A ∨ z ∈ E := by
    intro z hz
    by_cases hzA : z ∈ A
    · exact Or.inl hzA
    by_cases hzE : z ∈ E
    · exact Or.inr hzE
    exfalso
    apply hz
    rw [hBd]
    intro N hN
    exact ⟨fun h => hzE ((hE z).2 ⟨N, hN, h⟩), fun h => hzA ((hA z).2 ⟨N, hN, h⟩)⟩
  have hBdA : ∀ z, Bd z → z ∉ A := by
    intro z hz hzA
    obtain ⟨N, hN, h0⟩ := (hA z).1 hzA
    exact ((hBd z).1 hz N hN).2 h0
  have hBdE : ∀ z, Bd z → z ∉ E := by
    intro z hz hzE
    obtain ⟨N, hN, h0⟩ := (hE z).1 hzE
    exact ((hBd z).1 hz N hN).1 h0
  have hBdc : IsClosed {z | Bd z} := by
    have h : {z | Bd z}ᶜ = A ∪ E := by
      ext z
      constructor
      · intro hz
        exact hcover z hz
      · rintro (h | h) hz
        · exact hBdA z hz h
        · exact hBdE z hz h
    rw [← isOpen_compl_iff, h]
    exact hAo.union hEo
  
  have hl0 : ∀ (t : ℝ) (x : E2), (hpLift t x) 0 = t := by
    intro t x
    simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hl1 : ∀ (t : ℝ) (x : E2), (hpLift t x) 1 = x 0 := by
    intro t x
    simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hl2 : ∀ (t : ℝ) (x : E2), (hpLift t x) 2 = x 1 := by
    intro t x
    simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hp0 : ∀ z : E3, (hpProj z) 0 = z 1 := by
    intro z
    simp [hpProj]
  have hp1 : ∀ z : E3, (hpProj z) 1 = z 2 := by
    intro z
    simp [hpProj]
  have hlp : ∀ z : E3, hpLift (z 0) (hpProj z) = z := by
    intro z
    ext i
    fin_cases i
    · exact hl0 _ _
    · show (hpLift (z 0) (hpProj z)) 1 = z 1
      rw [hl1, hp0]
    · show (hpLift (z 0) (hpProj z)) 2 = z 2
      rw [hl2, hp1]
  have hn3 : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hn2 : ∀ x : E2, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hcont2 : Continuous (fun p : E2 × ℝ => hpLift p.2 p.1) := by
    unfold hpLift cylPt
    fun_prop
  have hcontx : ∀ x : E2, Continuous (fun t : ℝ => hpLift t x) := fun x =>
    hcont2.comp (continuous_const.prodMk continuous_id)
  have hc0 : Continuous (fun w : E3 => w 0) := by fun_prop
  have hinball : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), ∀ t : ℝ, |t| < 1 / 2 →
      hpLift t x ∈ Metric.ball (0 : E3) 1 := by
    intro x hx t ht
    rw [mem_ball_zero_iff] at hx ⊢
    have h1 := hn3 (hpLift t x)
    rw [hl0, hl1, hl2] at h1
    have h2 := hn2 x
    have hx0 : 0 ≤ ‖x‖ := norm_nonneg _
    have ht2 : t ^ 2 < 1 / 4 := by
      have : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
      rw [this]
      nlinarith [abs_nonneg t]
    have hx2 : ‖x‖ ^ 2 < 1 / 4 := by nlinarith
    have hz0 : 0 ≤ ‖hpLift t x‖ := norm_nonneg _
    nlinarith
  have hseedA : ∀ w ∈ Metric.ball (0 : E3) 1, w 0 < a → w ∈ A := by
    intro w hw hwa
    have hO : IsOpen (Metric.ball (0 : E3) 1 ∩ {z | z 0 < a}) :=
      Metric.isOpen_ball.inter (isOpen_lt hc0 continuous_const)
    exact (hA w).2 ⟨_, hO.mem_nhds ⟨hw, hwa⟩, hbot⟩
  have hseedE : ∀ w ∈ Metric.ball (0 : E3) 1, b < w 0 → w ∈ E := by
    intro w hw hwb
    have hO : IsOpen (Metric.ball (0 : E3) 1 ∩ {z | b < z 0}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hc0)
    exact (hE w).2 ⟨_, hO.mem_nhds ⟨hw, hwb⟩, htop⟩
  have hseg : ∀ (U V : Set E3), IsOpen U → IsOpen V → (∀ z, z ∈ U → z ∈ V → False) →
      (∀ z, ¬ Bd z → z ∈ U ∨ z ∈ V) → ∀ (x : E2) (I : Set ℝ), IsPreconnected I →
      (∀ t ∈ I, ¬ Bd (hpLift t x)) → ∀ t₀ ∈ I, hpLift t₀ x ∈ U →
      ∀ t ∈ I, hpLift t x ∈ U := by
    intro U V hU hV hUV hcov x I hI hnb t₀ ht₀ hU0 t ht
    have hP : IsPreconnected ((fun s => hpLift s x) '' I) :=
      hI.image _ (hcontx x).continuousOn
    have hsub : (fun s => hpLift s x) '' I ⊆ U ∪ V := by
      rintro _ ⟨s, hs, rfl⟩
      exact hcov _ (hnb s hs)
    have hdj : Disjoint U V := Set.disjoint_left.2 (fun z h1 h2 => hUV z h1 h2)
    exact hP.subset_left_of_subset_union hU hV hdj hsub ⟨_, ⟨t₀, ht₀, rfl⟩, hU0⟩ ⟨t, ht, rfl⟩
  have habs14 : |(-(1 / 4) : ℝ)| < 1 / 2 := by
    rw [abs_lt]; constructor <;> norm_num
  have habs14' : |(1 / 4 : ℝ)| < 1 / 2 := by
    rw [abs_lt]; constructor <;> norm_num
  
  obtain ⟨S, hS⟩ : ∃ S : E2 → Set ℝ, ∀ x t, t ∈ S x ↔ (a ≤ t ∧ t ≤ b) ∧ Bd (hpLift t x) :=
    ⟨fun x => Set.Icc a b ∩ {t | Bd (hpLift t x)}, fun x t => Iff.rfl⟩
  have hScpt : ∀ x, IsCompact (S x) := by
    intro x
    have h : S x = Set.Icc a b ∩ (fun t => hpLift t x) ⁻¹' {z | Bd z} := by
      ext t
      rw [hS]
      rfl
    rw [h]
    exact isCompact_Icc.inter_right (hBdc.preimage (hcontx x))
  have hSne : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), (S x).Nonempty := by
    intro x hx
    by_contra hne
    have hnb : ∀ t ∈ Set.Icc (-(1 / 4) : ℝ) (1 / 4), ¬ Bd (hpLift t x) := by
      intro t ht hbd
      have htb : |t| < 1 / 2 := abs_lt.2 ⟨by linarith [ht.1], by linarith [ht.2]⟩
      have h := hslab _ (hinball x hx t htb) ((hBd _).1 hbd)
      rw [hl0] at h
      exact hne ⟨t, (hS x t).2 ⟨h, hbd⟩⟩
    have hlo : hpLift (-(1 / 4)) x ∈ A :=
      hseedA _ (hinball x hx _ habs14) (by rw [hl0]; linarith)
    have hhi : hpLift (1 / 4) x ∈ A :=
      hseg A E hAo hEo hdisj hcover x _ isPreconnected_Icc hnb _
        ⟨le_rfl, by norm_num⟩ hlo _ ⟨by norm_num, le_rfl⟩
    have hhiE : hpLift (1 / 4) x ∈ E :=
      hseedE _ (hinball x hx _ habs14') (by rw [hl0]; linarith)
    exact hdisj _ hhi hhiE
  refine ⟨fun x => sInf (S x), fun x => sSup (S x), ?_⟩
  have hℓmem : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), sInf (S x) ∈ S x :=
    fun x hx => (hScpt x).sInf_mem (hSne x hx)
  have hυmem : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), sSup (S x) ∈ S x :=
    fun x hx => (hScpt x).sSup_mem (hSne x hx)
  have hi : ∀ x ∈ Metric.ball (0 : E2) (1 / 2),
      a ≤ sInf (S x) ∧ sInf (S x) ≤ sSup (S x) ∧ sSup (S x) ≤ b := by
    intro x hx
    exact ⟨((hS x _).1 (hℓmem x hx)).1.1,
      csInf_le_csSup (hScpt x).bddBelow (hScpt x).bddAbove (hSne x hx),
      ((hS x _).1 (hυmem x hx)).1.2⟩
  have hgapL : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), ∀ t : ℝ, a ≤ t → t < sInf (S x) →
      ¬ Bd (hpLift t x) := by
    intro x hx t hat htl hbd
    have htS : t ∈ S x :=
      (hS x t).2 ⟨⟨hat, by linarith [(hi x hx).2.1, (hi x hx).2.2]⟩, hbd⟩
    exact absurd (csInf_le (hScpt x).bddBelow htS) (not_le.2 htl)
  have hgapU : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), ∀ t : ℝ, sSup (S x) < t → t ≤ b →
      ¬ Bd (hpLift t x) := by
    intro x hx t hut htb hbd
    have htS : t ∈ S x :=
      (hS x t).2 ⟨⟨by linarith [(hi x hx).1, (hi x hx).2.1], htb⟩, hbd⟩
    exact absurd (le_csSup (hScpt x).bddAbove htS) (not_le.2 hut)
  have hprojD : ∀ z ∈ hpCyl (1 / 2) (1 / 2), hpProj z ∈ Metric.ball (0 : E2) (1 / 2) := by
    intro z hz
    rw [mem_ball_zero_iff]
    have h := hn2 (hpProj z)
    rw [hp0, hp1] at h
    have h1 := hz.1
    have h0 : 0 ≤ ‖hpProj z‖ := norm_nonneg _
    nlinarith
  refine ⟨hi, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro x hx
    exact ⟨(hBd _).1 ((hS x _).1 (hℓmem x hx)).2, (hBd _).1 ((hS x _).1 (hυmem x hx)).2⟩
  · intro z hz hzb
    have hz1 : z ∈ Metric.ball (0 : E3) 1 := Metric.ball_subset_ball (by norm_num) hz
    have h := hslab z hz1 hzb
    have hbd : Bd (hpLift (z 0) (hpProj z)) := by
      rw [hlp]
      exact (hBd z).2 hzb
    have hzS : z 0 ∈ S (hpProj z) := (hS _ _).2 ⟨h, hbd⟩
    exact ⟨csInf_le (hScpt _).bddBelow hzS, le_csSup (hScpt _).bddAbove hzS⟩
  · have hRA : ∀ z, z ∈ hpCyl (1 / 2) (1 / 2) → z 0 < sInf (S (hpProj z)) → z ∈ A := by
      intro z hzc hzl
      have hx := hprojD z hzc
      have hzabs : |z 0| < 1 / 2 := hzc.2
      have hI : ∀ t ∈ Set.Ioo (-(1 / 2) : ℝ) (sInf (S (hpProj z))),
          ¬ Bd (hpLift t (hpProj z)) := by
        intro t ht hbd
        have htb : |t| < 1 / 2 :=
          abs_lt.2 ⟨ht.1, by linarith [ht.2, (hi _ hx).2.1, (hi _ hx).2.2]⟩
        have h := hslab _ (hinball _ hx t htb) ((hBd _).1 hbd)
        rw [hl0] at h
        exact hgapL _ hx t h.1 ht.2 hbd
      have hseed : hpLift (-(1 / 4)) (hpProj z) ∈ A :=
        hseedA _ (hinball _ hx _ habs14) (by rw [hl0]; linarith)
      have h := hseg A E hAo hEo hdisj hcover _ _ isPreconnected_Ioo hI (-(1 / 4))
        ⟨by norm_num, by linarith [(hi _ hx).1]⟩ hseed (z 0)
        ⟨by linarith [(abs_lt.1 hzabs).1], hzl⟩
      rwa [hlp] at h
    apply measure_null_of_locally_null
    intro z hz
    obtain ⟨N, hN, h0⟩ := (hA z).1 (hRA z hz.1.1 hz.1.2)
    refine ⟨_, inter_mem_nhdsWithin _ hN, ?_⟩
    exact measure_mono_null (fun w hw => (⟨hw.2, hw.1.2⟩ : w ∈ N \ F)) h0
  · have hRE : ∀ z, z ∈ hpCyl (1 / 2) (1 / 2) → sSup (S (hpProj z)) < z 0 → z ∈ E := by
      intro z hzc hzu
      have hx := hprojD z hzc
      have hzabs : |z 0| < 1 / 2 := hzc.2
      have hI : ∀ t ∈ Set.Ioo (sSup (S (hpProj z))) (1 / 2),
          ¬ Bd (hpLift t (hpProj z)) := by
        intro t ht hbd
        have htb : |t| < 1 / 2 :=
          abs_lt.2 ⟨by linarith [ht.1, (hi _ hx).1, (hi _ hx).2.1], ht.2⟩
        have h := hslab _ (hinball _ hx t htb) ((hBd _).1 hbd)
        rw [hl0] at h
        exact hgapU _ hx t ht.1 h.2 hbd
      have hseed : hpLift (1 / 4) (hpProj z) ∈ E :=
        hseedE _ (hinball _ hx _ habs14') (by rw [hl0]; linarith)
      have h := hseg E A hEo hAo (fun w h1 h2 => hdisj w h2 h1)
        (fun w hw => (hcover w hw).symm) _ _ isPreconnected_Ioo hI (1 / 4)
        ⟨by linarith [(hi _ hx).2.2], by norm_num⟩ hseed (z 0)
        ⟨hzu, (abs_lt.1 hzabs).2⟩
      rwa [hlp] at h
    apply measure_null_of_locally_null
    intro z hz
    obtain ⟨N, hN, h0⟩ := (hE z).1 (hRE z hz.1.1 hz.1.2)
    refine ⟨_, inter_mem_nhdsWithin _ hN, ?_⟩
    exact measure_mono_null (fun w hw => (⟨hw.2, hw.1.2⟩ : w ∈ N ∩ F)) h0
  · intro x hx y hy
    by_cases hya : y < a
    · filter_upwards [self_mem_nhdsWithin] with x' hx'
      exact lt_of_lt_of_le hya (hi x' hx').1
    · push_neg at hya
      have hloc : ∀ t ∈ Set.Icc a y,
          ∀ᶠ p : E2 × ℝ in 𝓝 (x, t), ¬ Bd (hpLift p.2 p.1) := by
        intro t ht
        have hnb : ¬ Bd (hpLift t x) := hgapL x hx t ht.1 (lt_of_le_of_lt ht.2 hy)
        exact (hBdc.isOpen_compl.preimage hcont2).mem_nhds hnb
      have htube := (isCompact_Icc (a := a) (b := y)).eventually_forall_of_forall_eventually
        (P := fun x' t => ¬ Bd (hpLift t x')) hloc
      filter_upwards [nhdsWithin_le_nhds htube, self_mem_nhdsWithin] with x' h1 h2
      by_contra hle
      push_neg at hle
      exact h1 (sInf (S x')) ⟨(hi x' h2).1, hle⟩ ((hS x' _).1 (hℓmem x' h2)).2
  · intro x hx y hy
    by_cases hyb : b < y
    · filter_upwards [self_mem_nhdsWithin] with x' hx'
      exact lt_of_le_of_lt (hi x' hx').2.2 hyb
    · push_neg at hyb
      have hloc : ∀ t ∈ Set.Icc y b,
          ∀ᶠ p : E2 × ℝ in 𝓝 (x, t), ¬ Bd (hpLift p.2 p.1) := by
        intro t ht
        have hnb : ¬ Bd (hpLift t x) := hgapU x hx t (lt_of_lt_of_le hy ht.1) ht.2
        exact (hBdc.isOpen_compl.preimage hcont2).mem_nhds hnb
      have htube := (isCompact_Icc (a := y) (b := b)).eventually_forall_of_forall_eventually
        (P := fun x' t => ¬ Bd (hpLift t x')) hloc
      filter_upwards [nhdsWithin_le_nhds htube, self_mem_nhdsWithin] with x' h1 h2
      by_contra hle
      push_neg at hle
      exact h1 (sSup (S x')) ⟨hle, (hi x' h2).2.2⟩ ((hS x' _).1 (hυmem x' h2)).2

theorem hpLift_basic : ∀ (t t' : ℝ) (x x' : E2), (hpLift t x) 0 = t ∧ (hpLift t x) 1 = x 0 ∧
    (hpLift t x) 2 = x 1 ∧ hpProj (hpLift t x) = x ∧ ‖hpLift t x‖ ^ 2 = t ^ 2 + ‖x‖ ^ 2 ∧
    hpLift t x - hpLift t' x' = hpLift (t - t') (x - x') ∧ ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 :=
by
  have hc : ∀ (s : ℝ) (y : E2), (hpLift s y) 0 = s ∧ (hpLift s y) 1 = y 0 ∧
      (hpLift s y) 2 = y 1 := by
    intro s y
    refine ⟨?_, ?_, ?_⟩ <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hn2 : ∀ y : E2, ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
      sq_abs, sq_abs]
  intro t t' x x'
  obtain ⟨h0, h1, h2⟩ := hc t x
  refine ⟨h0, h1, h2, ?_, ?_, ?_, hn2 x⟩
  · ext i
    fin_cases i
    · show (hpLift t x) 1 = x 0
      exact h1
    · show (hpLift t x) 2 = x 1
      exact h2
  · rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three, Real.norm_eq_abs, Real.norm_eq_abs,
      Real.norm_eq_abs, sq_abs, sq_abs, sq_abs, h0, h1, h2, hn2 x]
    ring
  · obtain ⟨k0, k1, k2⟩ := hc t' x'
    obtain ⟨d0, d1, d2⟩ := hc (t - t') (x - x')
    ext j
    fin_cases j
    · show (hpLift t x - hpLift t' x') 0 = hpLift (t - t') (x - x') 0
      rw [PiLp.sub_apply, h0, k0, d0]
    · show (hpLift t x - hpLift t' x') 1 = hpLift (t - t') (x - x') 1
      rw [PiLp.sub_apply, h1, k1, d1, PiLp.sub_apply]
    · show (hpLift t x - hpLift t' x') 2 = hpLift (t - t') (x - x') 2
      rw [PiLp.sub_apply, h2, k2, d2, PiLp.sub_apply]

theorem hpLift_tonelli : (∀ S : Set E3, MeasurableSet S →
    Measurable (fun x : E2 => volume {t : ℝ | hpLift t x ∈ S}) ∧
    volume S = ∫⁻ x : E2, volume {t : ℝ | hpLift t x ∈ S}) ∧
    (∀ S : Set E3, volume S = 0 →
      ∀ᵐ x ∂(volume : Measure E2), volume {t : ℝ | hpLift t x ∈ S} = 0) :=
by
  have hcoord : ∀ (t : ℝ) (x : E2),
      hpLift t x = (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x) : Fin 3 → ℝ) : E3) := by
    intro t x
    ext j
    fin_cases j <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply] <;> rfl
  have hΘ : MeasureTheory.MeasurePreserving (fun p : E2 × ℝ => hpLift p.2 p.1)
      (volume.prod volume) volume := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin 2)).prod
      (MeasureTheory.MeasurePreserving.id (volume : Measure ℝ))
    have h2 := MeasureTheory.Measure.measurePreserving_swap
      (μ := (volume : Measure (Fin 2 → ℝ))) (ν := (volume : Measure ℝ))
    have h3 := MeasureTheory.MeasurePreserving.symm
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
      (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
    have h4 := PiLp.volume_preserving_toLp (Fin 3)
    have H := h4.comp (h3.comp (h2.comp h1))
    have hfun : (fun p : E2 × ℝ => hpLift p.2 p.1) =
        (WithLp.toLp 2 ∘ (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm ∘
          Prod.swap ∘ Prod.map WithLp.ofLp id) := by
      funext p
      rw [hcoord]
      simp [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply,
        Fin.insertNth_zero'] <;> rfl
    rw [hfun]
    exact H
  refine ⟨fun S hS => ?_, fun S hS0 => ?_⟩
  · have hP : MeasurableSet ((fun p : E2 × ℝ => hpLift p.2 p.1) ⁻¹' S) := hΘ.measurable hS
    refine ⟨measurable_measure_prodMk_left hP, ?_⟩
    rw [← hΘ.measure_preimage hS.nullMeasurableSet, MeasureTheory.Measure.prod_apply hP]
    rfl
  · have hT := MeasureTheory.measurableSet_toMeasurable (volume : Measure E3) S
    have hT0 : (volume.prod volume) ((fun p : E2 × ℝ => hpLift p.2 p.1) ⁻¹'
        MeasureTheory.toMeasurable (volume : Measure E3) S) = 0 := by
      rw [hΘ.measure_preimage hT.nullMeasurableSet, MeasureTheory.measure_toMeasurable]
      exact hS0
    have hS0' : (volume.prod volume) ((fun p : E2 × ℝ => hpLift p.2 p.1) ⁻¹' S) = 0 :=
      MeasureTheory.measure_mono_null
        (Set.preimage_mono (MeasureTheory.subset_toMeasurable _ _)) hT0
    have hae := MeasureTheory.Measure.measure_ae_null_of_prod_null hS0'
    filter_upwards [hae] with x hx
    exact hx

theorem hpSlice_density_null : ∀ (A : Set E3) (h : E2 → ℝ) (T : Set E2) (c₀ : ℝ),
    MeasurableSet A → 0 < c₀ →
    (∀ S : Set E3, MeasurableSet S →
      Measurable (fun x : E2 => volume {t : ℝ | hpLift t x ∈ S}) ∧
      volume S = ∫⁻ x : E2, volume {t : ℝ | hpLift t x ∈ S}) →
    T ⊆ Metric.ball (0 : E2) (1 / 2) →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2), ∀ ρ : ℝ, 0 < ρ → ρ ≤ 1 / 8 →
      ENNReal.ofReal (c₀ * ρ ^ 3) ≤ volume (Metric.ball (hpLift (h x) x) ρ ∩ A)) →
    (∀ x₀ ∈ Metric.ball (0 : E2) (1 / 2), ∃ r : ℝ, 0 < r ∧ ∀ x ∈ T, dist x x₀ ≤ r →
      volume {t : ℝ | t ∈ Set.Ioo (h x₀ - r) (h x₀ + r) ∧ hpLift t x ∈ A} = 0) →
    volume T = 0 :=
by
  intro A h T c₀ hA hc₀ hTon hTD hdens hwin
  by_contra hT
  
  have hD : MeasurableSet (Metric.ball (0 : E2) (1 / 2)) := measurableSet_ball
  have H₁ := Besicovitch.ae_tendsto_measure_inter_div (volume : Measure E2) T
  have H₂ : ∀ᵐ x ∂(volume : Measure E2).restrict T,
      x ∉ (Metric.ball (0 : E2) (1 / 2))ᶜ := by
    apply measure_eq_zero_iff_ae_notMem.mp
    rw [Measure.restrict_apply hD.compl]
    have hE : (Metric.ball (0 : E2) (1 / 2))ᶜ ∩ T = ∅ := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_empty_iff_false, iff_false,
        not_and]
      intro hx hxT
      exact hx (hTD hxT)
    rw [hE, measure_empty]
  haveI : (ae ((volume : Measure E2).restrict T)).NeBot := ae_neBot.mpr (by
    rw [Ne, Measure.restrict_eq_zero]; exact hT)
  obtain ⟨x₀, hlim, hx₀'⟩ := (H₁.and H₂).exists
  have hx₀ : x₀ ∈ Metric.ball (0 : E2) (1 / 2) := by simpa using hx₀'
  
  obtain ⟨r, hr, Hw⟩ := hwin x₀ hx₀
  
  have hK0 : 0 < volume (Metric.ball (0 : E2) 1) := measure_ball_pos _ _ one_pos
  have hKt : volume (Metric.ball (0 : E2) 1) ≠ ⊤ := measure_ball_lt_top.ne
  obtain ⟨Kr, hKr⟩ : ∃ Kr : ℝ, Kr = (volume (Metric.ball (0 : E2) 1)).toReal := ⟨_, rfl⟩
  have hKr0 : 0 < Kr := by rw [hKr]; exact ENNReal.toReal_pos hK0.ne' hKt
  obtain ⟨θ, hθ⟩ : ∃ θ : ℝ, θ = c₀ / (4 * Kr) := ⟨_, rfl⟩
  have hθ0 : 0 < θ := by rw [hθ]; exact div_pos hc₀ (by positivity)
  have hθlt : 1 - ENNReal.ofReal θ < 1 :=
    ENNReal.sub_lt_self ENNReal.one_ne_top one_ne_zero (ENNReal.ofReal_pos.mpr hθ0).ne'
  have hev := (tendsto_order.1 hlim).1 _ hθlt
  have hδ : 0 < min r (1 / 8) := lt_min hr (by norm_num)
  obtain ⟨ρ, hρratio, hρmem⟩ := (hev.and (Ioo_mem_nhdsGT hδ)).exists
  obtain ⟨hρ0, hρδ⟩ := hρmem
  have hρr : ρ < r := lt_of_lt_of_le hρδ (min_le_left _ _)
  have hρ8 : ρ ≤ 1 / 8 := (lt_of_lt_of_le hρδ (min_le_right _ _)).le
  have hm0 : volume (Metric.closedBall x₀ ρ) ≠ 0 := (measure_closedBall_pos _ x₀ hρ0).ne'
  have hmt : volume (Metric.closedBall x₀ ρ) ≠ ⊤ := measure_closedBall_lt_top.ne
  have Hratio : (1 - ENNReal.ofReal θ) * volume (Metric.closedBall x₀ ρ) ≤
      volume (T ∩ Metric.closedBall x₀ ρ) :=
    (ENNReal.le_div_iff_mul_le (Or.inl hm0) (Or.inl hmt)).1 hρratio.le
  
  have hc : ∀ (s : ℝ) (y : E2), (hpLift s y) 0 = s ∧ (hpLift s y) 1 = y 0 ∧
      (hpLift s y) 2 = y 1 := by
    intro s y
    refine ⟨?_, ?_, ?_⟩ <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have geom : ∀ (t τ : ℝ) (x : E2), hpLift t x ∈ Metric.ball (hpLift τ x₀) ρ →
      |t - τ| < ρ ∧ dist x x₀ < ρ := by
    intro t τ x hmem
    rw [Metric.mem_ball, EuclideanSpace.dist_eq, Fin.sum_univ_three] at hmem
    obtain ⟨a0, a1, a2⟩ := hc t x
    obtain ⟨b0, b1, b2⟩ := hc τ x₀
    rw [a0, a1, a2, b0, b1, b2, Real.dist_eq, Real.dist_eq, Real.dist_eq, sq_abs, sq_abs,
      sq_abs] at hmem
    have hdx : dist x x₀ ^ 2 = (x 0 - x₀ 0) ^ 2 + (x 1 - x₀ 1) ^ 2 := by
      rw [EuclideanSpace.dist_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_two, Real.dist_eq,
        Real.dist_eq, sq_abs, sq_abs]
    have hsq : (t - τ) ^ 2 + dist x x₀ ^ 2 < ρ ^ 2 := by
      rw [hdx]
      have := (Real.sqrt_lt' hρ0).mp hmem
      linarith
    constructor
    · exact abs_lt_of_sq_lt_sq (by nlinarith [sq_nonneg (dist x x₀)]) hρ0.le
    · exact lt_of_pow_lt_pow_left₀ 2 hρ0.le (by nlinarith [sq_nonneg (t - τ)])
  
  have hSm : MeasurableSet (Metric.ball (hpLift (h x₀) x₀) ρ ∩ A) := measurableSet_ball.inter hA
  obtain ⟨hfm, hSvol⟩ := hTon _ hSm
  have hfc : ∀ x, volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A} ≤
      ENNReal.ofReal (2 * ρ) := by
    intro x
    calc volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}
        ≤ volume (Set.Ioo (h x₀ - ρ) (h x₀ + ρ)) := by
          apply measure_mono
          intro t ht
          have h1 := (geom t (h x₀) x ht.1).1
          rw [abs_lt] at h1
          exact ⟨by linarith, by linarith⟩
      _ = ENNReal.ofReal (2 * ρ) := by rw [Real.volume_Ioo]; congr 1; ring
  have hfd : ∀ x, x ∉ Metric.closedBall x₀ ρ →
      volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A} = 0 := by
    intro x hx
    refine measure_mono_null (fun t ht => ?_) measure_empty
    exact (hx (Metric.mem_closedBall.mpr (geom t (h x₀) x ht.1).2.le)).elim
  have hfe : ∀ x ∈ T ∩ Metric.closedBall x₀ ρ,
      volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A} = 0 := by
    rintro x ⟨hxT, hxB⟩
    refine measure_mono_null (fun t ht => ?_)
      (Hw x hxT ((Metric.mem_closedBall.mp hxB).trans hρr.le))
    have h1 := (geom t (h x₀) x ht.1).1
    rw [abs_lt] at h1
    exact ⟨⟨by linarith, by linarith⟩, ht.2⟩
  
  have hBm : MeasurableSet (Metric.closedBall x₀ ρ) := measurableSet_closedBall
  have hMm : MeasurableSet (Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0}) := hBm.inter (hfm (measurableSet_singleton 0))
  have hTM : T ∩ Metric.closedBall x₀ ρ ⊆ Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0} := fun x hx => ⟨hx.2, hfe x hx⟩
  have hMB : Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0} ⊆ Metric.closedBall x₀ ρ := Set.inter_subset_left
  have hMle := Hratio.trans (measure_mono hTM)
  have hdiff : volume (Metric.closedBall x₀ ρ \ (Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0})) ≤ ENNReal.ofReal θ * volume (Metric.closedBall x₀ ρ) := by
    rw [measure_diff hMB hMm.nullMeasurableSet (ne_top_of_le_ne_top hmt (measure_mono hMB))]
    calc _ ≤ volume (Metric.closedBall x₀ ρ) -
          (1 - ENNReal.ofReal θ) * volume (Metric.closedBall x₀ ρ) := tsub_le_tsub_left hMle _
      _ ≤ ENNReal.ofReal θ * volume (Metric.closedBall x₀ ρ) := by
        rw [tsub_le_iff_right, ← add_mul]
        calc volume (Metric.closedBall x₀ ρ) = 1 * volume (Metric.closedBall x₀ ρ) :=
              (one_mul _).symm
          _ ≤ (ENNReal.ofReal θ + (1 - ENNReal.ofReal θ)) * volume (Metric.closedBall x₀ ρ) := by
            gcongr; exact le_add_tsub
  have hfle : ∀ x, volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A} ≤
      (Metric.closedBall x₀ ρ \ (Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0})).indicator (fun _ => ENNReal.ofReal (2 * ρ)) x := by
    intro x
    by_cases hx : x ∈ Metric.closedBall x₀ ρ \ (Metric.closedBall x₀ ρ ∩
      (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
        {0})
    · rw [Set.indicator_of_mem hx]; exact hfc x
    · rw [Set.indicator_of_notMem hx]
      by_cases hxB : x ∈ Metric.closedBall x₀ ρ
      · have hxM : x ∈ Metric.closedBall x₀ ρ ∩
            (fun x : E2 => volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A}) ⁻¹'
              {0} := by
          by_contra h'
          exact hx ⟨hxB, h'⟩
        exact (Set.mem_singleton_iff.mp hxM.2).le
      · rw [hfd x hxB]
  have hint : ∫⁻ x, volume {t : ℝ | hpLift t x ∈ Metric.ball (hpLift (h x₀) x₀) ρ ∩ A} ≤
      ENNReal.ofReal (2 * ρ) * (ENNReal.ofReal θ * volume (Metric.closedBall x₀ ρ)) := by
    refine (lintegral_mono hfle).trans ?_
    rw [lintegral_indicator_const (hBm.diff hMm)]
    gcongr
  
  have hBvol : volume (Metric.closedBall x₀ ρ) = ENNReal.ofReal (ρ ^ 2) * ENNReal.ofReal Kr := by
    rw [Measure.addHaar_closedBall volume x₀ hρ0.le, finrank_euclideanSpace, Fintype.card_fin,
      hKr, ENNReal.ofReal_toReal hKt]
  have hS_le : volume (Metric.ball (hpLift (h x₀) x₀) ρ ∩ A) ≤
      ENNReal.ofReal (c₀ * ρ ^ 3 / 2) := by
    rw [hSvol]
    refine hint.trans (le_of_eq ?_)
    rw [hBvol, ← ENNReal.ofReal_mul (p := ρ ^ 2) (by positivity),
      ← ENNReal.ofReal_mul (p := θ) hθ0.le, ← ENNReal.ofReal_mul (p := 2 * ρ) (by positivity)]
    congr 1
    rw [hθ]
    field_simp
    ring
  have hlow := hdens x₀ hx₀ ρ hρ0 hρ8
  have hpos : 0 < c₀ * ρ ^ 3 := mul_pos hc₀ (pow_pos hρ0 3)
  have hlt : ENNReal.ofReal (c₀ * ρ ^ 3 / 2) < ENNReal.ofReal (c₀ * ρ ^ 3) :=
    (ENNReal.ofReal_lt_ofReal_iff hpos).2 (by linarith)
  exact absurd (hlow.trans hS_le) (not_le.mpr hlt)

theorem hpHarn_slice_jumps (F : Set E3) (a b : ℝ) (ℓ υ : E2 → ℝ) (hF : MeasurableSet F)
    (ha : -(1 / 8) ≤ a) (hab : a ≤ b) (hb : b ≤ 1 / 8)
    (h1 : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), a ≤ ℓ x ∧ ℓ x ≤ υ x ∧ υ x ≤ b)
    (h2 : ∀ x ∈ Metric.ball (0 : E2) (1 / 2),
      (∀ N ∈ 𝓝 (hpLift (ℓ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) ∧
      (∀ N ∈ 𝓝 (hpLift (υ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0))
    (h4 : volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ z 0 < ℓ (hpProj z)} \ F) = 0)
    (h5 : volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ υ (hpProj z) < z 0} ∩ F) = 0)
    (h6 : LowerSemicontinuousOn ℓ (Metric.ball (0 : E2) (1 / 2)))
    (h7 : UpperSemicontinuousOn υ (Metric.ball (0 : E2) (1 / 2)))
    (c₀ : ℝ) (hc₀ : 0 < c₀)
    (hdens : ∀ p : E3, ∀ s : ℝ, 0 < s → Metric.closedBall p s ⊆ Metric.ball (0 : E3) 1 →
      (∀ N ∈ 𝓝 p, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (F ∩ Metric.ball p s) ∧
      ENNReal.ofReal (c₀ * s ^ 3) ≤ volume (Metric.ball p s \ F)) :
    ∀ᵐ x ∂(volume : Measure E2), ‖x‖ < 1 / 2 → hpSliceJumps F ℓ υ x :=
by
  have hB := hpLift_basic
  obtain ⟨hTon, hNull⟩ := hpLift_tonelli
  
  have hball : ∀ x ∈ Metric.ball (0 : E2) (1 / 2), ∀ τ : ℝ, |τ| ≤ 1 / 8 → ∀ ρ : ℝ, 0 < ρ →
      ρ ≤ 1 / 8 → Metric.closedBall (hpLift τ x) ρ ⊆ Metric.ball (0 : E3) 1 := by
    intro x hx τ hτ ρ hρ hρ8 y hy
    have hx' : ‖x‖ < 1 / 2 := mem_ball_zero_iff.mp hx
    have hn : ‖hpLift τ x‖ ^ 2 = τ ^ 2 + ‖x‖ ^ 2 := (hB τ 0 x 0).2.2.2.2.1
    obtain ⟨hτa, hτb⟩ := abs_le.mp hτ
    have hτ2 : τ ^ 2 ≤ 1 / 64 := by nlinarith
    have hxn : ‖x‖ ^ 2 < 1 / 4 := by nlinarith [norm_nonneg x]
    have hp2 : ‖hpLift τ x‖ ^ 2 < 9 / 25 := by rw [hn]; linarith
    have hp : ‖hpLift τ x‖ < 3 / 5 := by nlinarith [norm_nonneg (hpLift τ x)]
    rw [Metric.mem_closedBall, dist_eq_norm] at hy
    rw [mem_ball_zero_iff]
    calc ‖y‖ = ‖(y - hpLift τ x) + hpLift τ x‖ := by rw [sub_add_cancel]
      _ ≤ ‖y - hpLift τ x‖ + ‖hpLift τ x‖ := norm_add_le _ _
      _ < 1 := by linarith
  
  have hJ1 : ∀ᵐ x ∂(volume : Measure E2), ‖x‖ < 1 / 2 →
      volume {t : ℝ | t ∈ Set.Ioo (-(1 / 4)) (ℓ x) ∧ hpLift t x ∉ F} = 0 := by
    filter_upwards [hNull _ h4] with x hx hxn
    refine measure_mono_null ?_ hx
    rintro t ⟨⟨ht1, ht2⟩, htF⟩
    have hxD : x ∈ Metric.ball (0 : E2) (1 / 2) := mem_ball_zero_iff.mpr hxn
    obtain ⟨hl1, hl2, hl3⟩ := h1 x hxD
    obtain ⟨c0, c1, c2, cp, -, -, cn⟩ := hB t 0 x 0
    have hcyl1 : (hpLift t x) 1 ^ 2 + (hpLift t x) 2 ^ 2 < (1 / 2) ^ 2 := by
      rw [c1, c2, ← cn]; nlinarith [norm_nonneg x]
    have hcyl2 : |(hpLift t x) 0| < 1 / 2 := by
      rw [c0, abs_lt]; constructor <;> linarith
    have hlt : (hpLift t x) 0 < ℓ (hpProj (hpLift t x)) := by
      rw [c0, cp]; exact ht2
    show hpLift t x ∈ {z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ z 0 < ℓ (hpProj z)} \ F
    exact ⟨⟨⟨hcyl1, hcyl2⟩, hlt⟩, htF⟩
  have hJ2 : ∀ᵐ x ∂(volume : Measure E2), ‖x‖ < 1 / 2 →
      volume {t : ℝ | t ∈ Set.Ioo (υ x) (1 / 4) ∧ hpLift t x ∈ F} = 0 := by
    filter_upwards [hNull _ h5] with x hx hxn
    refine measure_mono_null ?_ hx
    rintro t ⟨⟨ht1, ht2⟩, htF⟩
    have hxD : x ∈ Metric.ball (0 : E2) (1 / 2) := mem_ball_zero_iff.mpr hxn
    obtain ⟨hl1, hl2, hl3⟩ := h1 x hxD
    obtain ⟨c0, c1, c2, cp, -, -, cn⟩ := hB t 0 x 0
    have hcyl1 : (hpLift t x) 1 ^ 2 + (hpLift t x) 2 ^ 2 < (1 / 2) ^ 2 := by
      rw [c1, c2, ← cn]; nlinarith [norm_nonneg x]
    have hcyl2 : |(hpLift t x) 0| < 1 / 2 := by
      rw [c0, abs_lt]; constructor <;> linarith
    have hlt : υ (hpProj (hpLift t x)) < (hpLift t x) 0 := by
      rw [c0, cp]; exact ht1
    show hpLift t x ∈ {z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ υ (hpProj z) < z 0} ∩ F
    exact ⟨⟨⟨hcyl1, hcyl2⟩, hlt⟩, htF⟩
  
  have hT3 : ∀ n : ℕ, volume {x : E2 | ‖x‖ < 1 / 2 ∧
      volume {t : ℝ | t ∈ Set.Ioo (-(1 / 4)) (ℓ x + 1 / ((n : ℝ) + 1)) ∧ hpLift t x ∉ F} = 0}
      = 0 := by
    intro n
    have hs : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    set s : ℝ := 1 / ((n : ℝ) + 1) with hs_def
    refine hpSlice_density_null Fᶜ ℓ _ c₀ hF.compl hc₀ hTon ?_ ?_ ?_
    · intro x hx
      obtain ⟨hx1, -⟩ := hx
      exact mem_ball_zero_iff.mpr hx1
    · intro x hx ρ hρ hρ8
      obtain ⟨hl1, hl2, hl3⟩ := h1 x hx
      have hτ : |ℓ x| ≤ 1 / 8 := abs_le.mpr ⟨by linarith, by linarith⟩
      have hd := (hdens (hpLift (ℓ x) x) ρ hρ (hball x hx _ hτ ρ hρ hρ8) (h2 x hx).1).2
      rwa [Set.diff_eq] at hd
    · intro x₀ hx₀
      obtain ⟨hl1, hl2, hl3⟩ := h1 x₀ hx₀
      have hev := h6 x₀ hx₀ (ℓ x₀ - s / 2) (by linarith)
      rw [Metric.isOpen_ball.nhdsWithin_eq hx₀] at hev
      obtain ⟨ε, hε, hεl⟩ := Metric.eventually_nhds_iff.mp hev
      have hr0 : 0 < min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) :=
        lt_min (lt_min (by norm_num) (by linarith)) (by linarith)
      have hr1 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ 1 / 8 :=
        (min_le_left _ _).trans (min_le_left _ _)
      have hr2 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ s / 2 :=
        (min_le_left _ _).trans (min_le_right _ _)
      have hr3 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ ε / 2 := min_le_right _ _
      refine ⟨min (min (1 / 8 : ℝ) (s / 2)) (ε / 2), hr0, ?_⟩
      intro x hx hdist
      obtain ⟨-, hxnull⟩ := hx
      refine measure_mono_null ?_ hxnull
      have hlx : ℓ x₀ - s / 2 < ℓ x := hεl (show dist x x₀ < ε by linarith)
      rintro t ⟨⟨ht1, ht2⟩, htA⟩
      exact ⟨⟨by linarith, by linarith⟩, htA⟩
  
  have hT4 : ∀ n : ℕ, volume {x : E2 | ‖x‖ < 1 / 2 ∧
      volume {t : ℝ | t ∈ Set.Ioo (υ x - 1 / ((n : ℝ) + 1)) (1 / 4) ∧ hpLift t x ∈ F} = 0}
      = 0 := by
    intro n
    have hs : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    set s : ℝ := 1 / ((n : ℝ) + 1) with hs_def
    refine hpSlice_density_null F υ _ c₀ hF hc₀ hTon ?_ ?_ ?_
    · intro x hx
      obtain ⟨hx1, -⟩ := hx
      exact mem_ball_zero_iff.mpr hx1
    · intro x hx ρ hρ hρ8
      obtain ⟨hl1, hl2, hl3⟩ := h1 x hx
      have hτ : |υ x| ≤ 1 / 8 := abs_le.mpr ⟨by linarith, by linarith⟩
      have hd := (hdens (hpLift (υ x) x) ρ hρ (hball x hx _ hτ ρ hρ hρ8) (h2 x hx).2).1
      rwa [Set.inter_comm] at hd
    · intro x₀ hx₀
      obtain ⟨hl1, hl2, hl3⟩ := h1 x₀ hx₀
      have hev := h7 x₀ hx₀ (υ x₀ + s / 2) (by linarith)
      rw [Metric.isOpen_ball.nhdsWithin_eq hx₀] at hev
      obtain ⟨ε, hε, hεl⟩ := Metric.eventually_nhds_iff.mp hev
      have hr0 : 0 < min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) :=
        lt_min (lt_min (by norm_num) (by linarith)) (by linarith)
      have hr1 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ 1 / 8 :=
        (min_le_left _ _).trans (min_le_left _ _)
      have hr2 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ s / 2 :=
        (min_le_left _ _).trans (min_le_right _ _)
      have hr3 : min (min (1 / 8 : ℝ) (s / 2)) (ε / 2) ≤ ε / 2 := min_le_right _ _
      refine ⟨min (min (1 / 8 : ℝ) (s / 2)) (ε / 2), hr0, ?_⟩
      intro x hx hdist
      obtain ⟨-, hxnull⟩ := hx
      refine measure_mono_null ?_ hxnull
      have hux : υ x < υ x₀ + s / 2 := hεl (show dist x x₀ < ε by linarith)
      rintro t ⟨⟨ht1, ht2⟩, htA⟩
      exact ⟨⟨by linarith, by linarith⟩, htA⟩
  
  have hae3 : ∀ᵐ x ∂(volume : Measure E2), ∀ n : ℕ, x ∉ {x : E2 | ‖x‖ < 1 / 2 ∧
      volume {t : ℝ | t ∈ Set.Ioo (-(1 / 4)) (ℓ x + 1 / ((n : ℝ) + 1)) ∧ hpLift t x ∉ F} = 0} :=
    ae_all_iff.mpr (fun n => measure_eq_zero_iff_ae_notMem.mp (hT3 n))
  have hae4 : ∀ᵐ x ∂(volume : Measure E2), ∀ n : ℕ, x ∉ {x : E2 | ‖x‖ < 1 / 2 ∧
      volume {t : ℝ | t ∈ Set.Ioo (υ x - 1 / ((n : ℝ) + 1)) (1 / 4) ∧ hpLift t x ∈ F} = 0} :=
    ae_all_iff.mpr (fun n => measure_eq_zero_iff_ae_notMem.mp (hT4 n))
  filter_upwards [hJ1, hJ2, hae3, hae4] with x hx1 hx2 hx3 hx4 hxn
  have j1 := hx1 hxn
  have j2 := hx2 hxn
  refine ⟨j1, j2, ?_, ?_⟩
  · intro s hs hzero
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hs
    apply hx3 n
    refine ⟨hxn, ?_⟩
    refine measure_mono_null ?_
      (measure_union_null (measure_union_null j1 (Real.volume_singleton (a := ℓ x))) hzero)
    rintro t ⟨⟨ht1, ht2⟩, htF⟩
    rcases lt_trichotomy t (ℓ x) with h | h | h
    · exact Or.inl (Or.inl ⟨⟨ht1, h⟩, htF⟩)
    · exact Or.inl (Or.inr h)
    · exact Or.inr ⟨⟨h, by linarith⟩, htF⟩
  · intro s hs hzero
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hs
    apply hx4 n
    refine ⟨hxn, ?_⟩
    refine measure_mono_null ?_
      (measure_union_null (measure_union_null hzero (Real.volume_singleton (a := υ x))) j2)
    rintro t ⟨⟨ht1, ht2⟩, htF⟩
    rcases lt_trichotomy t (υ x) with h | h | h
    · exact Or.inl (Or.inl ⟨⟨by linarith, h⟩, htF⟩)
    · exact Or.inl (Or.inr h)
    · exact Or.inr ⟨⟨h, ht2⟩, htF⟩

theorem hpSL_calib (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : Set E3)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (Metric.ball (0 : E3) 1))
    (hclose : ∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100)
    (Ψ : E3 → ℝ) (hΨ : ContDiff ℝ ∞ Ψ) (hΨc : HasCompactSupport Ψ)
    (hΨs : tsupport Ψ ⊆ hpCyl (1 / 4) (1 / 4)) (hΨ1 : ∀ z, |Ψ z| ≤ 1) :
    ENNReal.ofReal ((9 / 10) * ∫ z in F, partialDeriv 0 Ψ z) ≤
      sepPerG G F (hpCyl (1 / 4) (1 / 4)) :=
by
  classical
  
  have hcb : hpCyl (1 / 4) (1 / 4) ⊆ Metric.ball (0 : E3) 1 := by
    intro z hz
    simp only [hpCyl, Set.mem_setOf_eq] at hz
    obtain ⟨h1, h2⟩ := hz
    rw [mem_ball_zero_iff, EuclideanSpace.norm_eq, Fin.sum_univ_three]
    simp only [Real.norm_eq_abs, sq_abs]
    rw [Real.sqrt_lt' one_pos]
    have h3 := abs_lt.mp h2
    nlinarith
  have hin : ∀ z, Ψ z ≠ 0 → z ∈ Metric.ball (0 : E3) 1 :=
    fun z hz => hcb (hΨs (subset_tsupport _ hz))
  
  have tri : ∀ x y w p q r : ℝ, |x| ≤ p → |y| ≤ q → |w| ≤ r → |x * y * w| ≤ p * q * r := by
    intro x y w p q r hx hy hw
    rw [abs_mul, abs_mul]
    have hp : 0 ≤ p := (abs_nonneg _).trans hx
    have hq : 0 ≤ q := (abs_nonneg _).trans hy
    exact mul_le_mul (mul_le_mul hx hy (abs_nonneg _) hp) hw (abs_nonneg _) (mul_nonneg hp hq)
  have hdet : ∀ z ∈ Metric.ball (0 : E3) 1, 9 / 10 ≤ (G z).det ∧ G z 0 0 ≤ 101 / 100 := by
    intro z hz
    have h := hclose z hz
    have d : ∀ i : Fin 3, 99 / 100 ≤ G z i i ∧ G z i i ≤ 101 / 100 := by
      intro i
      have hi := h i i
      rw [if_pos rfl] at hi
      have := abs_le.mp hi
      constructor <;> linarith [this.1, this.2]
    have dA : ∀ i : Fin 3, |G z i i| ≤ 101 / 100 := by
      intro i
      rw [abs_le]
      constructor <;> linarith [(d i).1, (d i).2]
    have o : ∀ i j : Fin 3, i ≠ j → |G z i j| ≤ 1 / 100 := by
      intro i j hij
      have hij' := h i j
      rwa [if_neg hij, sub_zero] at hij'
    refine ⟨?_, (d 0).2⟩
    rw [Matrix.det_fin_three]
    have p0 : (99 / 100) * (99 / 100) * (99 / 100) ≤ G z 0 0 * G z 1 1 * G z 2 2 :=
      mul_le_mul (mul_le_mul (d 0).1 (d 1).1 (by norm_num) (by linarith [(d 0).1]))
        (d 2).1 (by norm_num) (mul_nonneg (by linarith [(d 0).1]) (by linarith [(d 1).1]))
    have p1 := abs_le.mp (tri _ _ _ _ _ _ (dA 0) (o 1 2 (by decide)) (o 2 1 (by decide)))
    have p2 := abs_le.mp (tri _ _ _ _ _ _ (o 0 1 (by decide)) (o 1 0 (by decide)) (dA 2))
    have p3 := abs_le.mp (tri _ _ _ _ _ _ (o 0 1 (by decide)) (o 1 2 (by decide))
      (o 2 0 (by decide)))
    have p4 := abs_le.mp (tri _ _ _ _ _ _ (o 0 2 (by decide)) (o 1 0 (by decide))
      (o 2 1 (by decide)))
    have p5 := abs_le.mp (tri _ _ _ _ _ _ (o 0 2 (by decide)) (dA 1) (o 2 0 (by decide)))
    linarith [p1.1, p1.2, p2.1, p2.2, p3.1, p3.2, p4.1, p4.2, p5.1, p5.2]
  
  obtain ⟨k, hkdef⟩ : ∃ k : E3 → ℝ, k = fun z => 9 / 10 * (Real.sqrt (G z).det)⁻¹ := ⟨_, rfl⟩
  have hD : ContDiffOn ℝ ∞ (fun z => (G z).det) (Metric.ball (0 : E3) 1) := by
    have hfun : (fun z => (G z).det) = fun z =>
        G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
        - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
        + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 :=
      funext fun z => Matrix.det_fin_three (G z)
    rw [hfun]
    exact ((((((hG 0 0).mul (hG 1 1)).mul (hG 2 2)).sub (((hG 0 0).mul (hG 1 2)).mul (hG 2 1))).sub
      (((hG 0 1).mul (hG 1 0)).mul (hG 2 2))).add (((hG 0 1).mul (hG 1 2)).mul (hG 2 0))).add
      (((hG 0 2).mul (hG 1 0)).mul (hG 2 1)) |>.sub (((hG 0 2).mul (hG 1 1)).mul (hG 2 0))
  have hk : ContDiffOn ℝ ∞ k (Metric.ball (0 : E3) 1) := by
    rw [hkdef]
    refine contDiffOn_const.mul ?_
    refine (hD.sqrt fun z hz => ne_of_gt (by linarith [(hdet z hz).1])).inv ?_
    intro z hz
    exact ne_of_gt (Real.sqrt_pos.2 (by linarith [(hdet z hz).1]))
  have hΨk : ContDiff ℝ ∞ (fun z => Ψ z * k z) := by
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ Metric.ball (0 : E3) 1
    · exact hΨ.contDiffAt.mul (hk.contDiffAt (Metric.isOpen_ball.mem_nhds hx))
    · have hxt : x ∉ tsupport Ψ := fun h => hx (hcb (hΨs h))
      have h0 := (notMem_tsupport_iff_eventuallyEq).1 hxt
      refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq (h0.mono fun z hz => ?_)
      simp only [Pi.zero_apply] at hz
      show Ψ z * k z = 0
      rw [hz, zero_mul]
  obtain ⟨X, hXdef⟩ : ∃ X : E3 → E3, X = fun z => (Ψ z * k z) • e 0 := ⟨_, rfl⟩
  have hXc : ContDiff ℝ ∞ X := by
    rw [hXdef]
    exact hΨk.smul contDiff_const
  have hXt : tsupport X ⊆ tsupport Ψ := by
    rw [hXdef]
    exact (tsupport_smul_subset_left _ _).trans (tsupport_mul_subset_left)
  have hXcs : HasCompactSupport X := hΨc.mono' ((subset_tsupport X).trans hXt)
  have hXs : tsupport X ⊆ hpCyl (1 / 4) (1 / 4) := hXt.trans hΨs
  have hXi : ∀ z (i : Fin 3), X z i = Ψ z * k z * (if i = 0 then 1 else 0) := by
    intro z i
    rw [hXdef]
    simp [EuclideanSpace.single_apply]
  
  have hXb : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1 := by
    intro y
    simp only [hXi, Fin.sum_univ_three]
    simp only [show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide, if_true,
      if_false, mul_zero, mul_one, add_zero]
    by_cases hy : Ψ y = 0
    · rw [hy]; norm_num
    · obtain ⟨hd, hg⟩ := hdet y (hin y hy)
      have hdpos : 0 < (G y).det := by linarith
      have hkk : k y * k y = (81 / 100) / (G y).det := by
        rw [hkdef]
        simp only
        have hs := Real.mul_self_sqrt hdpos.le
        rw [show 9 / 10 * (Real.sqrt (G y).det)⁻¹ * (9 / 10 * (Real.sqrt (G y).det)⁻¹) =
            81 / 100 * (Real.sqrt (G y).det * Real.sqrt (G y).det)⁻¹ by rw [mul_inv]; ring,
          hs]
        ring
      have hΨ2 : Ψ y * Ψ y ≤ 1 := by
        have := abs_le.mp (hΨ1 y)
        nlinarith
      have hq : Ψ y * k y * (Ψ y * k y) ≤ 9 / 10 := by
        have e1 : Ψ y * k y * (Ψ y * k y) = (Ψ y * Ψ y) * ((81 / 100) / (G y).det) := by
          rw [← hkk]; ring
        rw [e1]
        have h81 : (81 / 100) / (G y).det ≤ 9 / 10 := by
          rw [div_le_iff₀ hdpos]; linarith
        have h0 : 0 ≤ (81 / 100) / (G y).det := by positivity
        calc Ψ y * Ψ y * ((81 / 100) / (G y).det) ≤ 1 * (9 / 10) :=
              mul_le_mul hΨ2 h81 h0 zero_le_one
          _ = 9 / 10 := by ring
      have hq0 : 0 ≤ Ψ y * k y * (Ψ y * k y) := mul_self_nonneg _
      have : G y 0 0 * (Ψ y * k y) * (Ψ y * k y) = G y 0 0 * (Ψ y * k y * (Ψ y * k y)) := by
        ring
      rw [this]
      nlinarith
  
  have hfun : ∀ i : Fin 3, (fun z => Real.sqrt (G z).det * X z i) =
      fun z => (if i = 0 then (9 / 10 : ℝ) else 0) * Ψ z := by
    intro i
    funext z
    rw [hXi]
    by_cases hz : Ψ z = 0
    · rw [hz]; simp
    · have hdpos : 0 < (G z).det := by linarith [(hdet z (hin z hz)).1]
      have hs0 : Real.sqrt (G z).det ≠ 0 := ne_of_gt (Real.sqrt_pos.2 hdpos)
      rw [hkdef]
      split_ifs
      · field_simp
      · simp
  have hΨd : Differentiable ℝ Ψ := hΨ.differentiable (by simp)
  have hdiv : ∀ y, sepDensDiv G X y = 9 / 10 * partialDeriv 0 Ψ y := by
    intro y
    have hpi : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y =
        (if i = 0 then (9 / 10 : ℝ) else 0) * partialDeriv i Ψ y := by
      intro i
      rw [hfun i]
      unfold partialDeriv
      rw [fderiv_const_mul (hΨd y)]
      rfl
    unfold sepDensDiv
    rw [Fin.sum_univ_three, hpi 0, hpi 1, hpi 2]
    simp
  have hint : (∫ y in F, sepDensDiv G X y) = 9 / 10 * ∫ y in F, partialDeriv 0 Ψ y := by
    rw [← integral_const_mul]
    congr 1
    funext y
    exact hdiv y
  unfold sepPerG
  refine le_iSup₂_of_le X ⟨hXc, hXcs, hXs, hXb⟩ ?_
  rw [hint]

theorem hpSL_product_field (F : Set E3) (hF : MeasurableSet F) (K : ℕ) (c : ℕ → E2 → ℝ)
    (ψ : ℕ → ℝ → ℝ) (Ψ : E3 → ℝ)
    (hΨ : ∀ z, Ψ z = ∑ k ∈ Finset.range K, c k (hpProj z) * ψ k (z 0))
    (hc : ∀ k, ContDiff ℝ ∞ (c k)) (hc0 : ∀ k x, 0 ≤ c k x)
    (hc1 : ∀ x, ∑ k ∈ Finset.range K, c k x ≤ 1)
    (hcc : ∀ k, HasCompactSupport (c k))
    (hcs : ∀ k, tsupport (c k) ⊆ Metric.ball (0 : E2) (1 / 4))
    (hψ : ∀ k, ContDiff ℝ ∞ (ψ k)) (hψ1 : ∀ k t, |ψ k t| ≤ 1)
    (hψ0 : ∀ k t, 6 / 25 ≤ |t| → ψ k t = 0) :
    ContDiff ℝ ∞ Ψ ∧ HasCompactSupport Ψ ∧ tsupport Ψ ⊆ hpCyl (1 / 4) (1 / 4) ∧
      (∀ z, |Ψ z| ≤ 1) ∧
      ∫ z in F, partialDeriv 0 Ψ z =
        ∫ x, ∑ k ∈ Finset.range K, c k x * hpSliceInt {t | hpLift t x ∈ F} (ψ k) :=
by
  
  have hp0 : ContDiff ℝ ∞ (fun z : E3 => z 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
  have hp1 : ContDiff ℝ ∞ (fun z : E3 => z 1) :=
    (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
  have hp2 : ContDiff ℝ ∞ (fun z : E3 => z 2) :=
    (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
  have hprojE : hpProj = fun z : E3 => (z 1) • e2 0 + (z 2) • e2 1 := by
    funext z
    ext i
    fin_cases i <;> simp [hpProj, EuclideanSpace.single_apply]
  have hprojC : ContDiff ℝ ∞ hpProj := by
    rw [hprojE]
    exact (hp1.smul contDiff_const).add (hp2.smul contDiff_const)
  have hpn : ∀ z : E3, ‖hpProj z‖ ^ 2 = z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two, hprojE]
    simp [EuclideanSpace.single_apply]
  have hzn : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  
  have hψcs : ∀ k, HasCompactSupport (ψ k) := by
    intro k
    refine HasCompactSupport.intro (isCompact_Icc (a := -(6 / 25 : ℝ)) (b := 6 / 25)) ?_
    intro t ht
    apply hψ0 k t
    by_contra h
    push_neg at h
    obtain ⟨h1, h2⟩ := abs_lt.mp h
    exact ht ⟨h1.le, h2.le⟩
  have hdψ : ∀ k, MeasureTheory.Integrable (deriv (ψ k)) := by
    intro k
    exact ((hψ k).continuous_deriv (by simp)).integrable_of_hasCompactSupport (hψcs k).deriv
  
  have hΨfun : Ψ = fun z => ∑ k ∈ Finset.range K, c k (hpProj z) * ψ k (z 0) := funext hΨ
  have hΨs : ContDiff ℝ ∞ Ψ := by
    rw [hΨfun]
    apply ContDiff.sum
    intro k _
    exact ((hc k).comp hprojC).mul ((hψ k).comp hp0)
  
  have hΨ1 : ∀ z, |Ψ z| ≤ 1 := by
    intro z
    rw [hΨ z]
    calc |∑ k ∈ Finset.range K, c k (hpProj z) * ψ k (z 0)|
        ≤ ∑ k ∈ Finset.range K, |c k (hpProj z) * ψ k (z 0)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ k ∈ Finset.range K, c k (hpProj z) := by
          apply Finset.sum_le_sum
          intro k _
          rw [abs_mul, abs_of_nonneg (hc0 k _)]
          exact mul_le_of_le_one_right (hc0 k _) (hψ1 k _)
      _ ≤ 1 := hc1 _
  
  set Q : Set E3 := {z | hpProj z ∈ ⋃ k ∈ Finset.range K, tsupport (c k)} ∩
    {z | |z 0| ≤ 6 / 25} with hQ
  have hsuppQ : Function.support Ψ ⊆ Q := by
    intro z hz
    rw [Function.mem_support, hΨ z] at hz
    obtain ⟨k, hk, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hz
    have h1 : c k (hpProj z) ≠ 0 := left_ne_zero_of_mul hne
    have h2 : ψ k (z 0) ≠ 0 := right_ne_zero_of_mul hne
    refine ⟨?_, ?_⟩
    · simp only [Set.mem_setOf_eq, Set.mem_iUnion]
      exact ⟨k, hk, subset_tsupport _ h1⟩
    · show |z 0| ≤ 6 / 25
      by_contra h
      exact h2 (hψ0 k _ (le_of_lt (not_le.mp h)))
  have hQc : IsClosed Q := by
    apply IsClosed.inter
    · exact (isClosed_biUnion_finset (fun k _ => isClosed_tsupport (c k))).preimage
        hprojC.continuous
    · exact isClosed_le (continuous_abs.comp hp0.continuous) continuous_const
  have htsQ : tsupport Ψ ⊆ Q := closure_minimal hsuppQ hQc
  have hQcyl : Q ⊆ hpCyl (1 / 4) (1 / 4) := by
    rintro z ⟨h1, h2⟩
    simp only [Set.mem_setOf_eq, Set.mem_iUnion] at h1 h2
    obtain ⟨k, hk, hz⟩ := h1
    have hb := hcs k hz
    rw [mem_ball_zero_iff] at hb
    show z 1 ^ 2 + z 2 ^ 2 < (1 / 4) ^ 2 ∧ |z 0| < 1 / 4
    refine ⟨?_, by linarith⟩
    rw [← hpn z]
    have := norm_nonneg (hpProj z)
    nlinarith
  have hQb : Bornology.IsBounded Q := by
    refine (Metric.isBounded_closedBall (x := (0 : E3)) (r := 1)).subset ?_
    intro z hz
    obtain ⟨h1, h2⟩ := hQcyl hz
    rw [mem_closedBall_zero_iff]
    have hn := hzn z
    have h3 : z 0 ^ 2 < 1 / 16 := by
      have := sq_abs (z 0)
      have := abs_nonneg (z 0)
      nlinarith
    have := norm_nonneg z
    nlinarith
  have hΨc : HasCompactSupport Ψ :=
    IsCompact.of_isClosed_subset (Metric.isCompact_of_isClosed_isBounded hQc hQb)
      (isClosed_tsupport _) htsQ
  
  have hderiv : ∀ z, partialDeriv 0 Ψ z =
      ∑ k ∈ Finset.range K, c k (hpProj z) * deriv (ψ k) (z 0) := by
    intro z
    have hD : HasFDerivAt Ψ (fderiv ℝ Ψ z) z := (hΨs.differentiable (by simp) z).hasFDerivAt
    have hD' : HasFDerivAt Ψ (fderiv ℝ Ψ z) (z + (0 : ℝ) • e 0) := by simpa using hD
    have hγ : HasDerivAt (fun s : ℝ => z + s • e 0) (e 0) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (e 0)).const_add z
    have h1 := HasFDerivAt.comp_hasDerivAt (f := fun s : ℝ => z + s • e 0) (0 : ℝ) hD' hγ
    have a1 : ∀ s : ℝ, (z + s • e 0) 1 = z 1 := by
      intro s; simp [EuclideanSpace.single_apply]
    have a2 : ∀ s : ℝ, (z + s • e 0) 2 = z 2 := by
      intro s; simp [EuclideanSpace.single_apply]
    have hpe : ∀ s : ℝ, hpProj (z + s • e 0) = hpProj z := by
      intro s
      show (EuclideanSpace.equiv (Fin 2) ℝ).symm ![(z + s • e 0) 1, (z + s • e 0) 2] =
        (EuclideanSpace.equiv (Fin 2) ℝ).symm ![z 1, z 2]
      rw [a1, a2]
    have h0e : ∀ s : ℝ, (z + s • e 0) 0 = z 0 + s := by
      intro s; simp [EuclideanSpace.single_apply]
    have hcomp : (Ψ ∘ fun s : ℝ => z + s • e 0) =
        fun s => ∑ k ∈ Finset.range K, c k (hpProj z) * ψ k (z 0 + s) := by
      funext s
      simp only [Function.comp, hΨ, hpe, h0e]
    rw [hcomp] at h1
    have h3 : HasDerivAt (fun s : ℝ => ∑ k ∈ Finset.range K, c k (hpProj z) * ψ k (z 0 + s))
        (∑ k ∈ Finset.range K, c k (hpProj z) * deriv (ψ k) (z 0)) 0 := by
      apply HasDerivAt.fun_sum
      intro k _
      apply HasDerivAt.const_mul
      have hd : HasDerivAt (ψ k) (deriv (ψ k) (z 0 + 0)) (z 0 + 0) :=
        ((hψ k).differentiable (by simp) _).hasDerivAt
      have := hd.comp_const_add (z 0) 0
      simpa using this
    exact h1.unique h3
  
  have hpdfun : partialDeriv 0 Ψ = fun z => fderiv ℝ Ψ z (e 0) := rfl
  have hint : MeasureTheory.Integrable (partialDeriv 0 Ψ) := by
    rw [hpdfun]
    exact ((hΨs.continuous_fderiv (by simp)).clm_apply continuous_const).integrable_of_hasCompactSupport
      (HasCompactSupport.fderiv_apply ℝ hΨc (e 0))
  
  have hcoord : ∀ (t : ℝ) (x : E2),
      hpLift t x = (WithLp.toLp 2 (Fin.cons t (WithLp.ofLp x) : Fin 3 → ℝ) : E3) := by
    intro t x
    ext j
    fin_cases j <;> simp [hpLift, cylPt, e, EuclideanSpace.single_apply] <;> rfl
  have hΘ : MeasureTheory.MeasurePreserving (fun p : E2 × ℝ => hpLift p.2 p.1)
      (volume.prod volume) volume := by
    have h1 := (PiLp.volume_preserving_ofLp (Fin 2)).prod
      (MeasureTheory.MeasurePreserving.id (volume : Measure ℝ))
    have h2 := MeasureTheory.Measure.measurePreserving_swap
      (μ := (volume : Measure (Fin 2 → ℝ))) (ν := (volume : Measure ℝ))
    have h3 := MeasureTheory.MeasurePreserving.symm
      (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
      (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0)
    have h4 := PiLp.volume_preserving_toLp (Fin 3)
    have H := h4.comp (h3.comp (h2.comp h1))
    have hfun : (fun p : E2 × ℝ => hpLift p.2 p.1) =
        (WithLp.toLp 2 ∘ (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm ∘
          Prod.swap ∘ Prod.map WithLp.ofLp id) := by
      funext p
      rw [hcoord]
      simp [MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv_apply,
        Fin.insertNth_zero'] <;> rfl
    rw [hfun]
    exact H
  have hgint : MeasureTheory.Integrable (F.indicator (partialDeriv 0 Ψ)) := hint.indicator hF
  have hfub : ∫ z, F.indicator (partialDeriv 0 Ψ) z =
      ∫ x : E2, ∫ t : ℝ, F.indicator (partialDeriv 0 Ψ) (hpLift t x) := by
    have hmap := MeasureTheory.integral_map (μ := (volume : Measure E2).prod (volume : Measure ℝ))
      hΘ.measurable.aemeasurable (f := F.indicator (partialDeriv 0 Ψ))
      (by rw [hΘ.map_eq]; exact hgint.aestronglyMeasurable)
    rw [hΘ.map_eq] at hmap
    rw [hmap]
    have hint2 : MeasureTheory.Integrable
        (fun p : E2 × ℝ => F.indicator (partialDeriv 0 Ψ) (hpLift p.2 p.1))
        ((volume : Measure E2).prod (volume : Measure ℝ)) :=
      hΘ.integrable_comp_of_integrable hgint
    exact MeasureTheory.integral_prod _ hint2
  
  refine ⟨hΨs, hΨc, htsQ.trans hQcyl, hΨ1, ?_⟩
  rw [← MeasureTheory.integral_indicator hF, hfub]
  congr 1
  funext x
  have hcont : Continuous (fun t : ℝ => hpLift t x) := by
    unfold hpLift cylPt
    fun_prop
  have hS : MeasurableSet {t : ℝ | hpLift t x ∈ F} := hF.preimage hcont.measurable
  have hpt : ∀ t, F.indicator (partialDeriv 0 Ψ) (hpLift t x) =
      ∑ k ∈ Finset.range K, c k x *
        ({t | hpLift t x ∈ F}.indicator (fun _ => (1 : ℝ)) t * deriv (ψ k) t) := by
    intro t
    have b0 : (hpLift t x) 0 = t := by
      simp [hpLift, cylPt, EuclideanSpace.single_apply]
    have bp : hpProj (hpLift t x) = x := by
      rw [hprojE]
      ext i
      fin_cases i <;> simp [hpLift, cylPt, EuclideanSpace.single_apply]
    by_cases ht : hpLift t x ∈ F
    · rw [Set.indicator_of_mem ht, hderiv, bp, b0]
      have : t ∈ {t | hpLift t x ∈ F} := ht
      simp [Set.indicator_of_mem this]
    · rw [Set.indicator_of_notMem ht]
      have : t ∉ {t | hpLift t x ∈ F} := ht
      simp [Set.indicator_of_notMem this]
  simp_rw [hpt]
  rw [MeasureTheory.integral_finset_sum]
  · apply Finset.sum_congr rfl
    intro k _
    rw [MeasureTheory.integral_const_mul]
    rfl
  · intro k _
    apply MeasureTheory.Integrable.const_mul
    have : (fun t => {t | hpLift t x ∈ F}.indicator (fun _ => (1 : ℝ)) t * deriv (ψ k) t) =
        {t | hpLift t x ∈ F}.indicator (deriv (ψ k)) := by
      funext t
      by_cases ht : t ∈ {t | hpLift t x ∈ F} <;> simp [ht]
    rw [this]
    exact (hdψ k).indicator hS

theorem hpSL_profile_shape : (ContDiff ℝ ∞ hpProf0 ∧ (∀ t, |hpProf0 t| ≤ 1) ∧ (∀ t, 6 / 25 ≤ |t| → hpProf0 t = 0)) ∧
    ∀ α₁ α₂ α₃ α₄ : ℝ, -(3 / 16) ≤ α₁ → α₁ < α₂ → α₂ < α₃ → α₃ < α₄ → α₄ ≤ 3 / 16 →
      ContDiff ℝ ∞ (hpProf α₁ α₂ α₃ α₄) ∧ (∀ t, |hpProf α₁ α₂ α₃ α₄ t| ≤ 1) ∧
      (∀ t, 6 / 25 ≤ |t| → hpProf α₁ α₂ α₃ α₄ t = 0) :=
by
  have hUp : ∀ α β : ℝ, α < β →
      ContDiff ℝ ∞ (fun t => hpUp α β t) ∧ (∀ t, 0 ≤ hpUp α β t ∧ hpUp α β t ≤ 1) ∧
      (∀ t, t ≤ α → hpUp α β t = 0) ∧ (∀ t, β ≤ t → hpUp α β t = 1) := by
    intro α β hαβ
    have hpos : 0 < β - α := sub_pos.mpr hαβ
    refine ⟨?_, fun t => ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩,
      fun t ht => ?_, fun t ht => ?_⟩
    · have h1 : ContDiff ℝ ∞ (fun t : ℝ => (t - α) / (β - α)) :=
        (contDiff_id.sub contDiff_const).div_const _
      exact Real.smoothTransition.contDiff.comp h1
    · unfold hpUp
      apply Real.smoothTransition.zero_of_nonpos
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) hpos.le
    · unfold hpUp
      apply Real.smoothTransition.one_of_one_le
      rw [one_le_div hpos]
      linarith
  obtain ⟨hAs, hAb, hA0, hA1⟩ := hUp (-(6 / 25)) (-(3 / 16)) (by norm_num)
  obtain ⟨hBs, hBb, hB0, hB1⟩ := hUp (3 / 16) (6 / 25) (by norm_num)
  have hP0s : ContDiff ℝ ∞ hpProf0 := by
    have : hpProf0 = fun t => hpUp (-(6 / 25)) (-(3 / 16)) t - hpUp (3 / 16) (6 / 25) t := by
      funext t; rfl
    rw [this]
    exact hAs.sub hBs
  have hP0b : ∀ t, 0 ≤ hpProf0 t ∧ hpProf0 t ≤ 1 := by
    intro t
    unfold hpProf0
    rcases le_total t (3 / 16) with ht | ht
    · rw [hB0 t ht]
      have := hAb t
      constructor <;> linarith [this.1, this.2]
    · rw [hA1 t (by linarith)]
      have := hBb t
      constructor <;> linarith [this.1, this.2]
  have hP0mid : ∀ t, -(3 / 16) ≤ t → t ≤ 3 / 16 → hpProf0 t = 1 := by
    intro t h1 h2
    unfold hpProf0
    rw [hA1 t h1, hB0 t h2]
    norm_num
  have hP0z : ∀ t, 6 / 25 ≤ |t| → hpProf0 t = 0 := by
    intro t ht
    unfold hpProf0
    rcases le_abs'.mp ht with h | h
    · rw [hA0 t h, hB0 t (by linarith)]
      norm_num
    · rw [hA1 t (by linarith), hB1 t h]
      norm_num
  refine ⟨⟨hP0s, fun t => abs_le.mpr ⟨by linarith [(hP0b t).1], (hP0b t).2⟩, hP0z⟩, ?_⟩
  intro α₁ α₂ α₃ α₄ h1 h2 h3 h4 h5
  obtain ⟨hUs, hUb, hU0, hU1⟩ := hUp α₁ α₂ h2
  obtain ⟨hVs, hVb, hV0, hV1⟩ := hUp α₃ α₄ h4
  refine ⟨?_, ?_, ?_⟩
  · have : hpProf α₁ α₂ α₃ α₄ = fun t => hpProf0 t - 2 * hpUp α₁ α₂ t + 2 * hpUp α₃ α₄ t := by
      funext t; rfl
    rw [this]
    exact (hP0s.sub (contDiff_const.mul hUs)).add (contDiff_const.mul hVs)
  · intro t
    unfold hpProf
    rw [abs_le]
    rcases le_total t (-(3 / 16)) with ht | ht
    · rw [hU0 t (by linarith), hV0 t (by linarith)]
      have := hP0b t
      constructor <;> linarith [this.1, this.2]
    · rcases le_total t (3 / 16) with ht' | ht'
      · rw [hP0mid t ht ht']
        rcases le_total t α₃ with h | h
        · rw [hV0 t h]
          have := hUb t
          constructor <;> linarith [this.1, this.2]
        · rw [hU1 t (by linarith)]
          have := hVb t
          constructor <;> linarith [this.1, this.2]
      · rw [hU1 t (by linarith), hV1 t (by linarith)]
        have := hP0b t
        constructor <;> linarith [this.1, this.2]
  · intro t ht
    unfold hpProf
    rw [hP0z t ht]
    rcases le_abs'.mp ht with h | h
    · rw [hU0 t (by linarith), hV0 t (by linarith)]
      norm_num
    · rw [hU1 t (by linarith), hV1 t (by linarith)]
      norm_num

theorem hpSL_profile_values (S : Set ℝ) (hS : MeasurableSet S) (ℓ υ : ℝ)
    (hℓ : -(1 / 8) ≤ ℓ) (hℓυ : ℓ ≤ υ) (hυ : υ ≤ 1 / 8)
    (hJ1 : volume {t : ℝ | t ∈ Set.Ioo (-(1 / 4)) ℓ ∧ t ∉ S} = 0)
    (hJ2 : volume {t : ℝ | t ∈ Set.Ioo υ (1 / 4) ∧ t ∈ S} = 0) :
    hpSliceInt S hpProf0 = 1 ∧
    (∀ α₁ α₂ α₃ α₄ : ℝ, -(3 / 16) ≤ α₁ → α₁ < α₂ → α₂ < α₃ → α₃ < α₄ → α₄ ≤ 3 / 16 →
      -1 ≤ hpSliceInt S (hpProf α₁ α₂ α₃ α₄) ∧ hpSliceInt S (hpProf α₁ α₂ α₃ α₄) ≤ 3) ∧
    (ℓ < υ → (∀ s : ℝ, 0 < s → volume {t : ℝ | t ∈ Set.Ioo ℓ (ℓ + s) ∧ t ∉ S} ≠ 0) →
      (∀ s : ℝ, 0 < s → volume {t : ℝ | t ∈ Set.Ioo (υ - s) υ ∧ t ∈ S} ≠ 0) →
      ∀ θ : ℝ, 0 < θ → ∃ q₁ q₂ q₃ q₄ : ℚ, -(3 / 16) ≤ (q₁ : ℝ) ∧ (q₁ : ℝ) < q₂ ∧
        (q₂ : ℝ) < q₃ ∧ (q₃ : ℝ) < q₄ ∧ (q₄ : ℝ) ≤ 3 / 16 ∧
        3 - θ ≤ hpSliceInt S (hpProf q₁ q₂ q₃ q₄)) :=
by
  
  have hpRamp : ∃ C : ℝ, 0 < C ∧ ∀ α β : ℝ, α < β →
      Differentiable ℝ (hpUp α β) ∧ Continuous (deriv (hpUp α β)) ∧
      (∀ t, 0 ≤ deriv (hpUp α β) t) ∧ (∀ t, deriv (hpUp α β) t ≤ C / (β - α)) ∧
      (∀ t, t ∉ Set.Icc α β → deriv (hpUp α β) t = 0) ∧ ∫ t, deriv (hpUp α β) t = 1 := by
    have hσd : Differentiable ℝ Real.smoothTransition :=
      (Real.smoothTransition.contDiff (n := 1)).differentiable one_ne_zero
    have hσc : Continuous (deriv Real.smoothTransition) :=
      (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
    have hσ0 : ∀ x, x ∉ Set.Icc (0 : ℝ) 1 → deriv Real.smoothTransition x = 0 := by
      intro x hx
      rcases lt_or_ge x 0 with h | h
      · have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          filter_upwards [Iio_mem_nhds h] with y hy
          exact Real.smoothTransition.zero_of_nonpos (le_of_lt hy)
        rw [hev.deriv_eq, deriv_const]
      · have h1 : 1 < x := by
          by_contra h'
          exact hx ⟨h, not_lt.mp h'⟩
        have hev : Real.smoothTransition =ᶠ[𝓝 x] fun _ => (1 : ℝ) := by
          filter_upwards [Ioi_mem_nhds h1] with y hy
          exact Real.smoothTransition.one_of_one_le (le_of_lt hy)
        rw [hev.deriv_eq, deriv_const]
    have hσcs : HasCompactSupport (deriv Real.smoothTransition) :=
      HasCompactSupport.intro isCompact_Icc hσ0
    obtain ⟨M, hM⟩ := hσc.bounded_above_of_compact_support hσcs
    have hM0 : 0 ≤ M := le_trans (norm_nonneg _) (hM 0)
    have hσnn : ∀ x, 0 ≤ deriv Real.smoothTransition x :=
      fun x => Real.smoothTransition.monotone.deriv_nonneg
    refine ⟨M + 1, by linarith, fun α β hαβ => ?_⟩
    have hd : 0 < β - α := by linarith
    have hu : ∀ t, HasDerivAt (hpUp α β)
        (deriv Real.smoothTransition ((t - α) / (β - α)) * (1 / (β - α))) t := by
      intro t
      have ha : HasDerivAt (fun x : ℝ => (x - α) / (β - α)) (1 / (β - α)) t :=
        ((hasDerivAt_id t).sub_const α).div_const (β - α)
      exact (hσd ((t - α) / (β - α))).hasDerivAt.comp t ha
    have hderiv : deriv (hpUp α β) =
        fun t => deriv Real.smoothTransition ((t - α) / (β - α)) * (1 / (β - α)) :=
      funext fun t => (hu t).deriv
    have hdiff : Differentiable ℝ (hpUp α β) := fun t => (hu t).differentiableAt
    have hcont : Continuous (deriv (hpUp α β)) := by
      rw [hderiv]
      exact (hσc.comp ((continuous_id.sub continuous_const).div_const _)).mul continuous_const
    have hzero : ∀ t, t ∉ Set.Icc α β → deriv (hpUp α β) t = 0 := by
      intro t ht
      rw [hderiv]
      simp only
      rw [hσ0, zero_mul]
      rintro ⟨h1, h2⟩
      apply ht
      constructor
      · have := (div_nonneg_iff.mp h1)
        rcases this with ⟨h3, _⟩ | ⟨_, h4⟩
        · linarith
        · linarith
      · rw [div_le_one hd] at h2
        linarith
    refine ⟨hdiff, hcont, ?_, ?_, hzero, ?_⟩
    · intro t
      rw [hderiv]
      exact mul_nonneg (hσnn _) (by positivity)
    · intro t
      rw [hderiv]
      simp only
      have h1 : deriv Real.smoothTransition ((t - α) / (β - α)) ≤ M + 1 := by
        have := hM ((t - α) / (β - α))
        rw [Real.norm_eq_abs] at this
        linarith [le_abs_self (deriv Real.smoothTransition ((t - α) / (β - α)))]
      rw [mul_one_div]
      exact div_le_div_of_nonneg_right h1 hd.le
    · rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
        integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hαβ.le,
        intervalIntegral.integral_deriv_eq_sub (fun x _ => hdiff x) (hcont.intervalIntegrable _ _)]
      simp only [hpUp, sub_self, zero_div, div_self hd.ne']
      rw [Real.smoothTransition.one, Real.smoothTransition.zero, sub_zero]
  
  have hpWeight : ∀ (w : ℝ → ℝ) (α β K : ℝ), Continuous w → (∀ t, 0 ≤ w t) → (∀ t, w t ≤ K) →
      (∀ t, t ∉ Set.Icc α β → w t = 0) → ∫ t, w t = 1 →
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * w t) ∧
      0 ≤ ∫ t, S.indicator (fun _ => (1 : ℝ)) t * w t ∧
      ∫ t, S.indicator (fun _ => (1 : ℝ)) t * w t ≤ 1 ∧
      ∫ t, S.indicator (fun _ => (1 : ℝ)) t * w t ≤ K * (volume (Set.Icc α β ∩ S)).toReal ∧
      1 - ∫ t, S.indicator (fun _ => (1 : ℝ)) t * w t ≤
        K * (volume (Set.Icc α β \ S)).toReal := by
    intro w α β K hw hw0 hwK hws hw1
    have hwi : Integrable w :=
      hw.integrable_of_hasCompactSupport (HasCompactSupport.intro isCompact_Icc hws)
    have hgeq : (fun t => S.indicator (fun _ => (1 : ℝ)) t * w t) = S.indicator w := by
      funext t
      by_cases h : t ∈ S
      · simp [Set.indicator_of_mem h]
      · simp [Set.indicator_of_notMem h]
    have hgi : Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * w t) := by
      rw [hgeq]; exact hwi.indicator hS
    have hm1 : MeasurableSet (Set.Icc α β ∩ S) := measurableSet_Icc.inter hS
    have hm2 : MeasurableSet (Set.Icc α β \ S) := measurableSet_Icc.diff hS
    have hi1 : Integrable ((Set.Icc α β ∩ S).indicator (fun _ => K)) :=
      ((continuous_const.integrableOn_Icc (a := α) (b := β)).mono_set
        Set.inter_subset_left).integrable_indicator hm1
    have hi2 : Integrable ((Set.Icc α β \ S).indicator (fun _ => K)) :=
      ((continuous_const.integrableOn_Icc (a := α) (b := β)).mono_set
        Set.diff_subset).integrable_indicator hm2
    have hK1 : ∫ t, (Set.Icc α β ∩ S).indicator (fun _ => K) t =
        K * (volume (Set.Icc α β ∩ S)).toReal := by
      rw [integral_indicator hm1, setIntegral_const, smul_eq_mul, measureReal_def, mul_comm]
    have hK2 : ∫ t, (Set.Icc α β \ S).indicator (fun _ => K) t =
        K * (volume (Set.Icc α β \ S)).toReal := by
      rw [integral_indicator hm2, setIntegral_const, smul_eq_mul, measureReal_def, mul_comm]
    refine ⟨hgi, ?_, ?_, ?_, ?_⟩
    · refine integral_nonneg fun t => mul_nonneg ?_ (hw0 t)
      exact Set.indicator_nonneg (fun _ _ => zero_le_one) t
    · refine le_trans (integral_mono hgi hwi fun t => ?_) hw1.le
      by_cases h : t ∈ S
      · simp [Set.indicator_of_mem h]
      · simp [Set.indicator_of_notMem h, hw0 t]
    · rw [← hK1]
      refine integral_mono hgi hi1 fun t => ?_
      by_cases h : t ∈ S
      · by_cases h' : t ∈ Set.Icc α β
        · simp [Set.indicator_of_mem h,
            Set.indicator_of_mem (show t ∈ Set.Icc α β ∩ S from ⟨h', h⟩), hwK t]
        · rw [Set.indicator_of_notMem (show t ∉ Set.Icc α β ∩ S from fun hh => h' hh.1),
            hws t h']
          simp
      · rw [Set.indicator_of_notMem h, Set.indicator_of_notMem (show t ∉ Set.Icc α β ∩ S from
          fun hh => h hh.2)]
        simp
    · have hsub1 : 1 - ∫ t, S.indicator (fun _ => (1 : ℝ)) t * w t =
          ∫ t, (w t - S.indicator (fun _ => (1 : ℝ)) t * w t) := by
        rw [integral_sub hwi hgi, hw1]
      rw [hsub1, ← hK2]
      refine integral_mono (hwi.sub hgi) hi2 fun t => ?_
      by_cases h : t ∈ S
      · rw [Set.indicator_of_mem h, Set.indicator_of_notMem (show t ∉ Set.Icc α β \ S from
          fun hh => hh.2 h)]
        simp
      · by_cases h' : t ∈ Set.Icc α β
        · rw [Set.indicator_of_notMem h,
            Set.indicator_of_mem (show t ∈ Set.Icc α β \ S from ⟨h', h⟩)]
          simp [hwK t]
        · rw [Set.indicator_of_notMem (show t ∉ Set.Icc α β \ S from fun hh => h' hh.1),
            hws t h']
          simp
  
  have hpDens : ∀ (A : Set ℝ), MeasurableSet A → ∀ (p q θ : ℝ), p < q → 0 < θ →
      volume {t : ℝ | t ∈ Set.Ioo p q ∧ t ∈ A} ≠ 0 →
      ∃ α β : ℚ, p < (α : ℝ) ∧ (α : ℝ) < β ∧ (β : ℝ) < q ∧
        volume (Set.Icc (α : ℝ) β \ A) ≤ ENNReal.ofReal (θ * ((β : ℝ) - α)) := by
    intro A hA p q θ _ hθ hpos
    set A' : Set ℝ := {t : ℝ | t ∈ Set.Ioo p q ∧ t ∈ A} with hA'
    have hA'm : MeasurableSet A' := measurableSet_Ioo.inter hA
    obtain ⟨x, hxA', hx⟩ := Measure.exists_mem_of_measure_ne_zero_of_ae hpos
      (Besicovitch.ae_tendsto_measure_inter_div (volume : Measure ℝ) A')
    have hpx : p < x := hxA'.1.1
    have hxq : x < q := hxA'.1.2
    set ε : ℝ := min θ 1 / 4 with hε
    have hε0 : 0 < ε := by
      have : 0 < min θ 1 := lt_min hθ one_pos
      rw [hε]; linarith
    have hεθ : ε ≤ θ / 4 := by
      have := min_le_left θ 1
      rw [hε]; linarith
    have hε1 : ε ≤ 1 / 4 := by
      have := min_le_right θ 1
      rw [hε]; linarith
    have hlt : ENNReal.ofReal (1 - ε) < 1 := by
      rw [ENNReal.ofReal_lt_one]; linarith
    set δ : ℝ := min (x - p) (q - x) with hδ
    have hδ0 : 0 < δ := lt_min (by linarith) (by linarith)
    have hev1 : ∀ᶠ r in 𝓝[>] (0 : ℝ), ENNReal.ofReal (1 - ε) <
        volume (A' ∩ closedBall x r) / volume (closedBall x r) :=
      hx.eventually (lt_mem_nhds hlt)
    have hev2 : ∀ᶠ r in 𝓝[>] (0 : ℝ), 0 < r := self_mem_nhdsWithin
    have hev3 : ∀ᶠ r in 𝓝[>] (0 : ℝ), r < δ := nhdsWithin_le_nhds (Iio_mem_nhds hδ0)
    obtain ⟨r, hr1, hr0, hrδ⟩ := (hev1.and (hev2.and hev3)).exists
    have hrp : r < x - p := lt_of_lt_of_le hrδ (min_le_left _ _)
    have hrq : r < q - x := lt_of_lt_of_le hrδ (min_le_right _ _)
    have hvolB : volume (closedBall x r) = ENNReal.ofReal (2 * r) := by
      rw [Real.volume_closedBall]
    have hmul := ENNReal.mul_lt_of_lt_div hr1
    rw [hvolB, ← ENNReal.ofReal_mul (by linarith)] at hmul
    have hfin : volume (A' ∩ closedBall x r) ≠ ⊤ :=
      ne_top_of_le_ne_top (by rw [hvolB]; exact ENNReal.ofReal_ne_top)
        (measure_mono Set.inter_subset_right)
    have hdiff : volume (closedBall x r \ A') ≤ ENNReal.ofReal (2 * ε * r) := by
      have e1 : closedBall x r \ A' = closedBall x r \ (A' ∩ closedBall x r) := by
        ext t; simp only [Set.mem_diff, Set.mem_inter_iff]; tauto
      rw [e1, measure_diff Set.inter_subset_right
        (hA'm.inter measurableSet_closedBall).nullMeasurableSet hfin, hvolB]
      calc ENNReal.ofReal (2 * r) - volume (A' ∩ closedBall x r)
          ≤ ENNReal.ofReal (2 * r) - ENNReal.ofReal ((1 - ε) * (2 * r)) :=
            tsub_le_tsub_left hmul.le _
        _ = ENNReal.ofReal (2 * r - (1 - ε) * (2 * r)) :=
            (ENNReal.ofReal_sub _ (by nlinarith)).symm
        _ = ENNReal.ofReal (2 * ε * r) := by ring_nf
    obtain ⟨α, hα1, hα2⟩ := exists_rat_btwn (show x - r < x - r / 2 by linarith)
    obtain ⟨β, hβ1, hβ2⟩ := exists_rat_btwn (show x + r / 2 < x + r by linarith)
    refine ⟨α, β, by linarith, by linarith, by linarith, ?_⟩
    have hsub : Set.Icc (α : ℝ) β \ A ⊆ closedBall x r \ A' := by
      rintro t ⟨⟨ht1, ht2⟩, ht3⟩
      refine ⟨?_, fun h => ht3 h.2⟩
      rw [Real.closedBall_eq_Icc]
      exact ⟨by linarith, by linarith⟩
    calc volume (Set.Icc (α : ℝ) β \ A) ≤ volume (closedBall x r \ A') := measure_mono hsub
      _ ≤ ENNReal.ofReal (2 * ε * r) := hdiff
      _ ≤ ENNReal.ofReal (θ * ((β : ℝ) - α)) := by
          apply ENNReal.ofReal_le_ofReal
          have h1 : 2 * ε * r ≤ θ / 2 * r := by nlinarith
          have h2 : r < (β : ℝ) - α := by linarith
          nlinarith
  
  obtain ⟨C, hC0, hramp⟩ := hpRamp
  have R : ∀ α β : ℝ, α < β → Differentiable ℝ (hpUp α β) ∧
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv (hpUp α β) t) ∧
      0 ≤ hpSliceInt S (hpUp α β) ∧ hpSliceInt S (hpUp α β) ≤ 1 ∧
      hpSliceInt S (hpUp α β) ≤ C / (β - α) * (volume (Set.Icc α β ∩ S)).toReal ∧
      1 - hpSliceInt S (hpUp α β) ≤ C / (β - α) * (volume (Set.Icc α β \ S)).toReal := by
    intro α β hαβ
    obtain ⟨hd, hc, hnn, hK, hz, h1⟩ := hramp α β hαβ
    obtain ⟨hi, w0, w1, w2, w3⟩ :=
      hpWeight (deriv (hpUp α β)) α β (C / (β - α)) hc hnn hK hz h1
    exact ⟨hd, hi, w0, w1, w2, w3⟩
  
  have comb : ∀ (f₁ f₂ f₃ f₄ : ℝ → ℝ) (c₃ c₄ : ℝ), Differentiable ℝ f₁ → Differentiable ℝ f₂ →
      Differentiable ℝ f₃ → Differentiable ℝ f₄ →
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv f₁ t) →
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv f₂ t) →
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv f₃ t) →
      Integrable (fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv f₄ t) →
      hpSliceInt S (fun t => f₁ t - f₂ t - c₃ * f₃ t + c₄ * f₄ t) =
        hpSliceInt S f₁ - hpSliceInt S f₂ - c₃ * hpSliceInt S f₃ + c₄ * hpSliceInt S f₄ := by
    intro f₁ f₂ f₃ f₄ c₃ c₄ hd₁ hd₂ hd₃ hd₄ hi₁ hi₂ hi₃ hi₄
    have hder : deriv (fun t => f₁ t - f₂ t - c₃ * f₃ t + c₄ * f₄ t) =
        fun t => deriv f₁ t - deriv f₂ t - c₃ * deriv f₃ t + c₄ * deriv f₄ t := by
      funext t
      exact ((((hd₁ t).hasDerivAt.sub (hd₂ t).hasDerivAt).sub
        ((hd₃ t).hasDerivAt.const_mul c₃)).add ((hd₄ t).hasDerivAt.const_mul c₄)).deriv
    unfold hpSliceInt
    rw [hder]
    have hfun : (fun t => S.indicator (fun _ => (1 : ℝ)) t *
        (deriv f₁ t - deriv f₂ t - c₃ * deriv f₃ t + c₄ * deriv f₄ t)) =
        fun t => S.indicator (fun _ => (1 : ℝ)) t * deriv f₁ t -
          S.indicator (fun _ => (1 : ℝ)) t * deriv f₂ t -
          c₃ * (S.indicator (fun _ => (1 : ℝ)) t * deriv f₃ t) +
          c₄ * (S.indicator (fun _ => (1 : ℝ)) t * deriv f₄ t) := by
      funext t; ring
    rw [hfun, integral_add, integral_sub, integral_sub, integral_const_mul, integral_const_mul]
    all_goals first
      | exact hi₁ | exact hi₂ | exact hi₄.const_mul c₄ | exact hi₃.const_mul c₃
      | exact hi₁.sub hi₂ | exact (hi₁.sub hi₂).sub (hi₃.const_mul c₃)
  have h1 : (-(6 / 25) : ℝ) < -(3 / 16) := by norm_num
  have h2 : (3 / 16 : ℝ) < 6 / 25 := by norm_num
  obtain ⟨d1, i1, a1, b1, c1, e1⟩ := R _ _ h1
  obtain ⟨d2, i2, a2, b2, c2, e2⟩ := R _ _ h2
  have hv1 : volume (Set.Icc (-(6 / 25) : ℝ) (-(3 / 16)) \ S) = 0 := by
    refine measure_mono_null ?_ hJ1
    rintro t ⟨⟨ht1, ht2⟩, ht3⟩
    exact ⟨⟨by linarith, by linarith⟩, ht3⟩
  have hv2 : volume (Set.Icc (3 / 16 : ℝ) (6 / 25) ∩ S) = 0 := by
    refine measure_mono_null ?_ hJ2
    rintro t ⟨⟨ht1, ht2⟩, ht3⟩
    exact ⟨⟨by linarith, by linarith⟩, ht3⟩
  rw [hv1, ENNReal.toReal_zero, mul_zero] at e1
  rw [hv2, ENNReal.toReal_zero, mul_zero] at c2
  have L1 : hpSliceInt S (hpUp (-(6 / 25)) (-(3 / 16))) = 1 := by linarith
  have L2 : hpSliceInt S (hpUp (3 / 16) (6 / 25)) = 0 := by linarith
  have hP0 : hpProf0 = fun t => hpUp (-(6 / 25)) (-(3 / 16)) t - hpUp (3 / 16) (6 / 25) t -
      0 * hpUp (-(6 / 25)) (-(3 / 16)) t + 0 * hpUp (-(6 / 25)) (-(3 / 16)) t := by
    funext t; simp only [hpProf0]; ring
  have V0 : hpSliceInt S hpProf0 = 1 := by
    rw [hP0, comb _ _ _ _ 0 0 d1 d2 d1 d1 i1 i2 i1 i1, L1, L2]; ring
  have VP : ∀ α₁ α₂ α₃ α₄ : ℝ, α₁ < α₂ → α₃ < α₄ →
      hpSliceInt S (hpProf α₁ α₂ α₃ α₄) =
        1 - 2 * hpSliceInt S (hpUp α₁ α₂) + 2 * hpSliceInt S (hpUp α₃ α₄) := by
    intro α₁ α₂ α₃ α₄ h12 h34
    obtain ⟨d3, i3, -⟩ := R _ _ h12
    obtain ⟨d4, i4, -⟩ := R _ _ h34
    have hP : hpProf α₁ α₂ α₃ α₄ = fun t => hpUp (-(6 / 25)) (-(3 / 16)) t -
        hpUp (3 / 16) (6 / 25) t - 2 * hpUp α₁ α₂ t + 2 * hpUp α₃ α₄ t := by
      funext t; simp only [hpProf, hpProf0]
    rw [hP, comb _ _ _ _ 2 2 d1 d2 d3 d4 i1 i2 i3 i4, L1, L2]; ring
  refine ⟨V0, ?_, ?_⟩
  · intro α₁ α₂ α₃ α₄ _ h12 _ h34 _
    rw [VP α₁ α₂ α₃ α₄ h12 h34]
    obtain ⟨-, -, a3, b3, -⟩ := R _ _ h12
    obtain ⟨-, -, a4, b4, -⟩ := R _ _ h34
    constructor <;> linarith
  · intro hlu hJ3 hJ4 θ hθ
    set s : ℝ := (υ - ℓ) / 2 with hs
    have hs0 : 0 < s := by rw [hs]; linarith
    have hθ' : 0 < θ / (4 * C) := by positivity
    obtain ⟨q₁, q₂, hq1, hq12, hq2, hvq⟩ := hpDens Sᶜ hS.compl ℓ (ℓ + s) (θ / (4 * C))
      (by linarith) hθ' (hJ3 s hs0)
    obtain ⟨q₃, q₄, hq3, hq34, hq4, hvq'⟩ := hpDens S hS (υ - s) υ (θ / (4 * C))
      (by linarith) hθ' (hJ4 s hs0)
    rw [Set.diff_compl] at hvq
    obtain ⟨-, -, -, -, c3, -⟩ := R _ _ hq12
    obtain ⟨-, -, -, -, -, e4⟩ := R _ _ hq34
    have hne12 : (q₂ : ℝ) - q₁ ≠ 0 := (sub_pos.2 hq12).ne'
    have hne34 : (q₄ : ℝ) - q₃ ≠ 0 := (sub_pos.2 hq34).ne'
    have t1 := ENNReal.toReal_le_of_le_ofReal (mul_nonneg hθ'.le (by linarith)) hvq
    have t2 := ENNReal.toReal_le_of_le_ofReal (mul_nonneg hθ'.le (by linarith)) hvq'
    have u1 : hpSliceInt S (hpUp q₁ q₂) ≤ θ / 4 := by
      calc hpSliceInt S (hpUp q₁ q₂)
          ≤ C / ((q₂ : ℝ) - q₁) * (volume (Set.Icc (q₁ : ℝ) q₂ ∩ S)).toReal := c3
        _ ≤ C / ((q₂ : ℝ) - q₁) * (θ / (4 * C) * ((q₂ : ℝ) - q₁)) :=
            mul_le_mul_of_nonneg_left t1 (div_nonneg hC0.le (by linarith))
        _ = θ / 4 := by field_simp
    have u2 : 1 - hpSliceInt S (hpUp q₃ q₄) ≤ θ / 4 := by
      calc 1 - hpSliceInt S (hpUp q₃ q₄)
          ≤ C / ((q₄ : ℝ) - q₃) * (volume (Set.Icc (q₃ : ℝ) q₄ \ S)).toReal := e4
        _ ≤ C / ((q₄ : ℝ) - q₃) * (θ / (4 * C) * ((q₄ : ℝ) - q₃)) :=
            mul_le_mul_of_nonneg_left t2 (div_nonneg hC0.le (by linarith))
        _ = θ / 4 := by field_simp
    refine ⟨q₁, q₂, q₃, q₄, by linarith, hq12, by linarith, hq34, by linarith, ?_⟩
    rw [VP _ _ _ _ hq12 hq34]
    linarith

theorem hpSL_sup_limit (I : ℕ → E2 → ℝ) (T : Set E2) (hI : ∀ k, Measurable (I k))
    (hb : ∀ᵐ x ∂(volume : Measure E2), ‖x‖ < 1 / 4 →
      I 0 x = 1 ∧ ∀ k, -1 ≤ I k x ∧ I k x ≤ 3)
    (hT : ∀ᵐ x ∂(volume : Measure E2), x ∈ T → ‖x‖ < 1 / 4 →
      ∀ θ : ℝ, 0 < θ → ∃ k, 3 - θ ≤ I k x)
    (η : ℝ) (hη : 0 < η) :
    ∃ n : ℕ, (volume (Metric.ball (0 : E2) (1 / 4)) +
        2 * volume (T ∩ Metric.ball (0 : E2) (1 / 4))).toReal - η ≤
      ∫ x in Metric.ball (0 : E2) (1 / 4),
        (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one (fun k => I k x) :=
by
  classical
  set B := Metric.ball (0 : E2) (1 / 4) with hBdef
  set S : ℕ → E2 → ℝ := fun n x =>
    (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one (fun k => I k x) with hSdef
  have hBm : MeasurableSet B := measurableSet_ball
  have hBfin : volume B ≠ ⊤ := measure_ball_lt_top.ne
  have hTBfin : volume (T ∩ B) ≠ ⊤ :=
    ne_top_of_le_ne_top hBfin (measure_mono Set.inter_subset_right)
  set β := (volume B).toReal with hβ
  set m := (volume (T ∩ B)).toReal with hm
  have hβ0 : 0 ≤ β := ENNReal.toReal_nonneg
  set θ := η / (2 * (β + 1)) with hθ
  have hθpos : 0 < θ := div_pos hη (by positivity)
  have hSmono : ∀ n p, n ≤ p → ∀ x, S n x ≤ S p x := by
    intro n p hnp x
    exact Finset.sup'_mono (fun k => I k x)
      (fun y hy => by simp only [Finset.mem_range] at hy ⊢; omega) _
  set A : ℕ → Set E2 := fun n => {x | 3 - θ ≤ S n x} ∩ B with hA
  have hAmono : Monotone A := by
    intro n p hnp x hx
    exact ⟨le_trans hx.1 (hSmono n p hnp x), hx.2⟩
  set U := ⋃ n, A n with hU
  have hcov : volume (T ∩ B) ≤ volume U := by
    refine measure_mono_ae (hT.mono fun x hx hxTB => ?_)
    have hxTB' : x ∈ T ∩ B := hxTB
    have hxB : ‖x‖ < 1 / 4 := mem_ball_zero_iff.1 hxTB'.2
    obtain ⟨k, hk⟩ := hx hxTB'.1 hxB θ hθpos
    refine Set.mem_iUnion.2 ⟨k, ?_, hxTB'.2⟩
    show 3 - θ ≤ S k x
    exact le_trans hk (Finset.le_sup' (fun k => I k x) (Finset.mem_range.2 (Nat.lt_succ_self k)))
  have hUB : U ⊆ B := Set.iUnion_subset fun n => Set.inter_subset_right
  have hUfin : volume U ≠ ⊤ := ne_top_of_le_ne_top hBfin (measure_mono hUB)
  have htend : Tendsto (fun n => (volume (A n)).toReal) atTop (𝓝 (volume U).toReal) :=
    (ENNReal.tendsto_toReal hUfin).comp (tendsto_measure_iUnion_atTop hAmono)
  obtain ⟨n, hn⟩ := (htend.eventually_const_lt
    (show (volume U).toReal - η / 4 < (volume U).toReal by linarith)).exists
  have hmU : m ≤ (volume U).toReal := ENNReal.toReal_mono hUfin hcov
  have hSmeas : Measurable (S n) := Finset.measurable_range_sup'' (fun k _ => hI k)
  set a := (volume (A n)).toReal with ha
  have ha0 : 0 ≤ a := ENNReal.toReal_nonneg
  have haβ : a ≤ β := ENNReal.toReal_mono hBfin (measure_mono Set.inter_subset_right)
  have hAnm : MeasurableSet {x | 3 - θ ≤ S n x} := measurableSet_le measurable_const hSmeas
  have hbB : ∀ᵐ x ∂(volume.restrict B), 1 ≤ S n x ∧ S n x ≤ 3 := by
    rw [ae_restrict_iff' hBm]
    filter_upwards [hb] with x hx hxB
    obtain ⟨h0, hk⟩ := hx (mem_ball_zero_iff.1 hxB)
    refine ⟨?_, ?_⟩
    · rw [← h0]
      exact Finset.le_sup' (fun k => I k x) (Finset.mem_range.2 (Nat.succ_pos n))
    · exact Finset.sup'_le _ _ (fun k _ => (hk k).2)
  have hSint : IntegrableOn (S n) B := by
    refine Measure.integrableOn_of_bounded (M := 3) hBfin hSmeas.aestronglyMeasurable ?_
    filter_upwards [hbB] with x hx
    rw [Real.norm_eq_abs, abs_le]
    constructor <;> linarith [hx.1, hx.2]
  have hc1 : IntegrableOn (fun _ : E2 => (1 : ℝ)) B := integrableOn_const hBfin
  have hc2 : IntegrableOn ({x | 3 - θ ≤ S n x}.indicator (fun _ : E2 => (2 - θ : ℝ))) B :=
    (integrableOn_const hBfin).indicator hAnm
  have hgle : (fun x => (1 : ℝ) + {x | 3 - θ ≤ S n x}.indicator (fun _ : E2 => (2 - θ : ℝ)) x)
      ≤ᵐ[volume.restrict B] S n := by
    filter_upwards [hbB] with x hx
    by_cases hxA : x ∈ {x | 3 - θ ≤ S n x}
    · rw [Set.indicator_of_mem hxA]
      have : 3 - θ ≤ S n x := hxA
      linarith
    · rw [Set.indicator_of_notMem hxA]
      linarith [hx.1]
  have hgval : (∫ x in B, ((1 : ℝ) + {x | 3 - θ ≤ S n x}.indicator (fun _ : E2 => (2 - θ : ℝ)) x))
      = β + (2 - θ) * a := by
    rw [integral_add hc1 hc2, setIntegral_const, setIntegral_indicator hAnm, setIntegral_const,
      measureReal_def, measureReal_def, smul_eq_mul, smul_eq_mul, mul_one, Set.inter_comm]
    ring
  have hint : β + (2 - θ) * a ≤ ∫ x in B, S n x := by
    rw [← hgval]
    exact setIntegral_mono_ae_restrict (hc1.add hc2) hSint hgle
  have hθβ : θ * β + θ = η / 2 := by
    rw [hθ]
    field_simp
    try ring
  have hθa : θ * a ≤ θ * β := mul_le_mul_of_nonneg_left haβ hθpos.le
  have hlhs : (volume B + 2 * volume (T ∩ B)).toReal = β + 2 * m := by
    rw [ENNReal.toReal_add hBfin (ENNReal.mul_ne_top ENNReal.ofNat_ne_top hTBfin),
      ENNReal.toReal_mul, ENNReal.toReal_ofNat]
  refine ⟨n, ?_⟩
  show (volume B + 2 * volume (T ∩ B)).toReal - η ≤ ∫ x in B, S n x
  rw [hlhs]
  nlinarith [hint, hθβ, hθa, hn, hmU]

theorem hpSL_bump_select (n : ℕ) (I : ℕ → E2 → ℝ) (hI : ∀ k, Measurable (I k))
    (hb : ∀ᵐ x ∂(volume : Measure E2), ‖x‖ < 1 / 4 → ∀ k, -1 ≤ I k x ∧ I k x ≤ 3)
    (η : ℝ) (hη : 0 < η) :
    ∃ c : ℕ → E2 → ℝ, (∀ k, ContDiff ℝ ∞ (c k)) ∧ (∀ k x, 0 ≤ c k x) ∧
      (∀ x, ∑ k ∈ Finset.range (n + 1), c k x ≤ 1) ∧ (∀ k, HasCompactSupport (c k)) ∧
      (∀ k, tsupport (c k) ⊆ Metric.ball (0 : E2) (1 / 4)) ∧
      (∫ x in Metric.ball (0 : E2) (1 / 4),
          (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one (fun k => I k x)) - η ≤
        ∫ x, ∑ k ∈ Finset.range (n + 1), c k x * I k x :=
by
  classical
  
  have s1 : ∀ (n : ℕ) (I : ℕ → E2 → ℝ), (∀ k, Measurable (I k)) →
      ∃ A : ℕ → Set E2, (∀ k, MeasurableSet (A k)) ∧
        (∀ x, ∑ k ∈ Finset.range (n + 1), (A k).indicator (fun _ => (1 : ℝ)) x = 1) ∧
        (∀ x, ∑ k ∈ Finset.range (n + 1), (A k).indicator (fun _ => (1 : ℝ)) x * I k x =
          (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one (fun k => I k x)) := by
    intro n I hI
    set M : E2 → ℝ := fun x => (Finset.range (n + 1)).sup' Finset.nonempty_range_add_one
      (fun k => I k x) with hMdef
    have hM : Measurable M := by
      have := Finset.measurable_sup' (Finset.nonempty_range_add_one (n := n)) (fun k _ => hI k)
      convert this using 1
      funext x
      simp [M, Finset.sup'_apply]
    let B : ℕ → Set E2 := fun k => {x | I k x = M x}
    have hB : ∀ k, MeasurableSet (B k) := fun k => measurableSet_eq_fun (hI k) hM
    let A : ℕ → Set E2 := fun k => B k \ ⋃ j ∈ Finset.range k, B j
    have hA : ∀ k, MeasurableSet (A k) := fun k =>
      (hB k).diff (Finset.measurableSet_biUnion _ (fun j _ => hB j))
    have key : ∀ x, ∃ k₀, k₀ ∈ Finset.range (n + 1) ∧ x ∈ A k₀ ∧
        ∀ k ∈ Finset.range (n + 1), k ≠ k₀ → x ∉ A k := by
      intro x
      have H : ∃ k, k ≤ n ∧ x ∈ B k := by
        obtain ⟨k, hk, hk'⟩ := Finset.exists_mem_eq_sup' Finset.nonempty_range_add_one
          (fun k => I k x)
        exact ⟨k, Nat.lt_succ_iff.mp (Finset.mem_range.mp hk), hk'.symm⟩
      refine ⟨Nat.find H, Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.find_spec H).1),
        ⟨(Nat.find_spec H).2, ?_⟩, ?_⟩
      · simp only [Set.mem_iUnion, not_exists]
        intro j hj hjB
        have hj' : j < Nat.find H := Finset.mem_range.mp hj
        exact Nat.find_min H hj' ⟨by have := (Nat.find_spec H).1; omega, hjB⟩
      · intro k hk hne hkA
        rcases lt_or_gt_of_ne hne with h | h
        · exact Nat.find_min H h ⟨Nat.lt_succ_iff.mp (Finset.mem_range.mp hk), hkA.1⟩
        · exact hkA.2 (Set.mem_iUnion₂.mpr
            ⟨Nat.find H, Finset.mem_range.mpr h, (Nat.find_spec H).2⟩)
    refine ⟨A, hA, fun x => ?_, fun x => ?_⟩
    · obtain ⟨k₀, hk₀, hx, hother⟩ := key x
      rw [Finset.sum_eq_single k₀ (fun k hk hne => Set.indicator_of_notMem (hother k hk hne) _)
        (fun h => absurd hk₀ h)]
      exact Set.indicator_of_mem hx _
    · obtain ⟨k₀, hk₀, hx, hother⟩ := key x
      rw [Finset.sum_eq_single k₀ (fun k hk hne => by
        rw [Set.indicator_of_notMem (hother k hk hne), zero_mul]) (fun h => absurd hk₀ h)]
      rw [Set.indicator_of_mem hx, one_mul]
      exact hx.1
  
  have s4 : ∀ (M : E2 → ℝ), IntegrableOn M (Metric.ball 0 (1 / 4)) → ∀ ε : ℝ, 0 < ε →
      ∃ r : ℝ, 0 < r ∧ r < 1 / 4 ∧
        ∫ x in Metric.ball (0 : E2) (1 / 4), M x ≤ (∫ x in Metric.ball (0 : E2) r, M x) + ε := by
    intro M hM ε hε
    let s : ℕ → Set E2 := fun j => Metric.ball 0 (1 / 4 - 1 / ((j : ℝ) + 5))
    have hmono : Monotone s := by
      intro i j hij
      apply Metric.ball_subset_ball
      have hij' : (i : ℝ) + 5 ≤ (j : ℝ) + 5 := by
        have : (i : ℝ) ≤ j := by exact_mod_cast hij
        linarith
      have : (1 : ℝ) / ((j : ℝ) + 5) ≤ 1 / ((i : ℝ) + 5) :=
        one_div_le_one_div_of_le (by positivity) hij'
      linarith
    have hU : (⋃ j, s j) = Metric.ball (0 : E2) (1 / 4) := by
      apply Set.Subset.antisymm
      · exact Set.iUnion_subset fun j => Metric.ball_subset_ball (by
          have : (0 : ℝ) < 1 / ((j : ℝ) + 5) := by positivity
          linarith)
      · intro x hx
        rw [mem_ball_zero_iff] at hx
        obtain ⟨j, hj⟩ := exists_nat_one_div_lt (show (0 : ℝ) < 1 / 4 - ‖x‖ by linarith)
        refine Set.mem_iUnion.mpr ⟨j, ?_⟩
        show x ∈ Metric.ball (0 : E2) (1 / 4 - 1 / ((j : ℝ) + 5))
        rw [mem_ball_zero_iff]
        have : (1 : ℝ) / ((j : ℝ) + 5) ≤ 1 / ((j : ℝ) + 1) :=
          one_div_le_one_div_of_le (by positivity) (by linarith)
        linarith
    have ht := MeasureTheory.tendsto_setIntegral_of_monotone (μ := volume) (f := M)
      (fun j => measurableSet_ball) hmono (by rw [hU]; exact hM)
    rw [hU] at ht
    have hev := (tendsto_order.1 ht).1 _
      (show (∫ x in Metric.ball (0 : E2) (1 / 4), M x) - ε < _ by linarith)
    obtain ⟨j, hj⟩ := hev.exists
    refine ⟨1 / 4 - 1 / ((j : ℝ) + 5), ?_, ?_, ?_⟩
