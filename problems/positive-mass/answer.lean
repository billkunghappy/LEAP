      have hN : 0 ≤ ‖ζ - ζ'‖ ^ (α : ℝ) := by positivity
      have hk : κ⁻¹ = d₀ * d₀ ^ (α : ℝ) / (L * ρ ^ (α : ℝ)) := by rw [hκ_def, inv_div]
      have step1 : ‖smthGrad w (x₀ + ρ • ζ) - smthGrad w (x₀ + ρ • ζ')‖ ≤
          L * (2 / d₀) ^ (1 + (α : ℝ)) * (ρ ^ (α : ℝ) * ‖ζ - ζ'‖ ^ (α : ℝ)) := by
        refine le_trans hI1 ?_
        refine mul_le_mul_of_nonneg_right ?_ (by positivity)
        exact mul_le_mul_of_nonneg_left hc hL0
      calc κ⁻¹ * ‖smthGrad w (x₀ + ρ • ζ) - smthGrad w (x₀ + ρ • ζ')‖
          ≤ κ⁻¹ * (L * (2 / d₀) ^ (1 + (α : ℝ)) * (ρ ^ (α : ℝ) * ‖ζ - ζ'‖ ^ (α : ℝ))) :=
            mul_le_mul_of_nonneg_left step1 (inv_nonneg.2 hκ.le)
        _ = (2 / d₀) ^ (1 + (α : ℝ)) * (d₀ * d₀ ^ (α : ℝ)) * ‖ζ - ζ'‖ ^ (α : ℝ) := by
            rw [hk, div_mul_eq_mul_div, div_eq_iff (by positivity)]
            ring
        _ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ) := by
            rw [hc2]; exact mul_le_mul_of_nonneg_right hc3 hN
    obtain ⟨ξ, hξ⟩ : ∃ ξ : Fin 2 → ℝ, ξ = ρ⁻¹ • (z₀ - x₀) := ⟨_, rfl⟩
    have hAξ : x₀ + ρ • ξ = z₀ := by
      rw [hξ, smul_smul, mul_inv_cancel₀ hρp.ne', one_smul]; abel
    have hξn : ‖ξ‖ = 1 := by
