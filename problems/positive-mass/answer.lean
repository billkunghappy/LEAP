    (fun d x => (∑ b, A x d b * E b x) +
      ((∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x))
    F FDa hVm hWm hP.2.2.1 hFa.2 hVW hFa.1 hP.2.2.2

theorem fcr_dq_sob_L2_bound (c : E3) (s r : ℝ) (φ : E3 → ℝ) (Dφ : List (Fin 3) → E3 → ℝ)
    (a : Fin 3) (ha : a ≠ 0) (h : ℝ) (hrs : r + |h| < s) (hφ : fcrSob c s 1 φ Dφ) :
    ∫ x in fcrHalf c r, (fcrDQ a h φ x) ^ 2 ≤ ∫ x in fcrHalf c s, (Dφ [a] x) ^ 2 :=
by
  classical
  by_cases hh : h = 0
  · subst hh
    have h0 : ∫ x in fcrHalf c r, (fcrDQ a 0 φ x) ^ 2 = 0 := by simp [fcrDQ]
    rw [h0]
    exact integral_nonneg (fun x => sq_nonneg _)
  
  have T_avg_int : ∀ (g : E3 → ℝ), StronglyMeasurable g → Integrable g → ∀ (v : E3),
      Integrable (fun p : E3 × ℝ => g (p.1 + p.2 • v))
        ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) := by
    intro g hm hg v
    have hmeas : StronglyMeasurable (fun p : E3 × ℝ => g (p.1 + p.2 • v)) :=
      hm.comp_measurable (measurable_fst.add (measurable_snd.smul_const v))
    refine (integrable_prod_iff' hmeas.aestronglyMeasurable).2 ⟨?_, ?_⟩
    · exact Filter.Eventually.of_forall (fun t => hg.comp_add_right (t • v))
    · refine (integrable_const (∫ x, ‖g x‖)).congr (Filter.Eventually.of_forall (fun t => ?_))
      exact (integral_add_right_eq_self (fun x => ‖g x‖) (t • v)).symm
  
  have T_avg_sq : ∀ (g : E3 → ℝ), StronglyMeasurable g → MemLp g 2 volume → ∀ (v : E3)
      (S : Set E3), ∫ x in S, (∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v)) ^ 2 ≤ ∫ x, g x ^ 2 := by
    intro g hm hg v S
    have hν1 : (volume.restrict (Set.Ioc (0:ℝ) 1)).real Set.univ = 1 := by
      simp [Measure.real, Real.volume_Ioc]
    have hg2 : Integrable (fun x => g x ^ 2) := hg.integrable_sq
    have hm2 : StronglyMeasurable (fun x => g x ^ 2) := hm.pow 2
    have hQ : Integrable (fun p : E3 × ℝ => g (p.1 + p.2 • v) ^ 2)
        ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) :=
      T_avg_int (fun x => g x ^ 2) hm2 hg2 v
    have hW : Integrable (fun x => ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) ^ 2) volume :=
      hQ.integral_prod_left
    have hW0 : ∀ x, 0 ≤ ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) ^ 2 :=
      fun x => integral_nonneg (fun t => sq_nonneg _)
    have hFm : StronglyMeasurable (fun p : E3 × ℝ => g (p.1 + p.2 • v)) :=
      hm.comp_measurable (measurable_fst.add (measurable_snd.smul_const v))
    have hVm : StronglyMeasurable (fun x => ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v)) :=
      hFm.integral_prod_right'
    have hJ : ∀ᵐ x ∂(volume : Measure E3), (∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v)) ^ 2 ≤
        ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) ^ 2 := by
      filter_upwards [hQ.prod_right_ae] with x hx
      have hux : StronglyMeasurable (fun t : ℝ => g (x + t • v)) :=
        hm.comp_measurable (measurable_const.add (measurable_id.smul_const v))
      have hL2 : MemLp (fun t : ℝ => g (x + t • v)) 2 (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
        (memLp_two_iff_integrable_sq hux.aestronglyMeasurable).2 hx
      have hL1 : Integrable (fun t : ℝ => g (x + t • v)) (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
        hL2.integrable one_le_two
      obtain ⟨m, hmdef⟩ : ∃ m, m = ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) := ⟨_, rfl⟩
      rw [← hmdef]
      have hpt : ∀ t : ℝ, 2 * m * g (x + t • v) - m ^ 2 ≤ g (x + t • v) ^ 2 := fun t => by
        nlinarith [sq_nonneg (g (x + t • v) - m)]
      have hint : Integrable (fun t : ℝ => 2 * m * g (x + t • v) - m ^ 2)
          (volume.restrict (Set.Ioc (0:ℝ) 1)) :=
        (hL1.const_mul (2 * m)).sub (integrable_const _)
      have h1 := integral_mono hint hx hpt
      rw [integral_sub (hL1.const_mul (2 * m)) (integrable_const _), integral_const_mul,
        integral_const, hν1, one_smul, ← hmdef] at h1
      nlinarith [h1]
    have hV2 : Integrable (fun x => (∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v)) ^ 2) volume := by
      refine hW.mono' (hVm.aestronglyMeasurable.pow 2) ?_
      filter_upwards [hJ] with x hx
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact hx
    calc ∫ x in S, (∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v)) ^ 2
        ≤ ∫ x in S, ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) ^ 2 :=
          integral_mono_ae hV2.restrict hW.restrict (ae_restrict_of_ae hJ)
      _ ≤ ∫ x, ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • v) ^ 2 :=
          setIntegral_le_integral hW (Filter.Eventually.of_forall hW0)
      _ = ∫ t in Set.Ioc (0:ℝ) 1, ∫ x, g (x + t • v) ^ 2 :=
          integral_integral_swap (f := fun x t => g (x + t • v) ^ 2) hQ
      _ = ∫ t in Set.Ioc (0:ℝ) 1, (∫ x, g x ^ 2) := by
          congr 1; funext t; exact integral_add_right_eq_self (fun x => g x ^ 2) (t • v)
      _ = ∫ x, g x ^ 2 := by rw [integral_const, hν1, one_smul]
  
  have T_ae_eq : ∀ (U : Set E3), IsOpen U → ∀ (u w : E3 → ℝ), IntegrableOn u U →
      IntegrableOn w U →
      (∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∫ x, ζ x * u x = ∫ x, ζ x * w x) →
      ∀ᵐ x ∂(volume.restrict U), u x = w x := by
    intro U hU u w hu hw hpair
    have hint : ∀ (f : E3 → ℝ), IntegrableOn f U → ∀ ζ : E3 → ℝ, Continuous ζ →
        HasCompactSupport ζ → tsupport ζ ⊆ U → Integrable (fun x => ζ x * f x) := by
      intro f hf ζ hζ hζc hζs
      obtain ⟨C, hC⟩ := hζ.bounded_above_of_compact_support hζc
      have h1 : IntegrableOn (fun x => ζ x * f x) U :=
        Integrable.bdd_mul hf hζ.aestronglyMeasurable (Filter.Eventually.of_forall hC)
      have h2 : (fun x => ζ x * f x) = U.indicator (fun x => ζ x * f x) := by
        funext x
        by_cases hx : x ∈ U
        · rw [Set.indicator_of_mem hx]
        · rw [Set.indicator_of_notMem hx,
            image_eq_zero_of_notMem_tsupport (fun h => hx (hζs h)), zero_mul]
      rw [h2]
      exact (integrable_indicator_iff hU.measurableSet).2 h1
    have key := hU.ae_eq_zero_of_integral_contDiff_smul_eq_zero (μ := volume)
      (f := fun x => u x - w x) (IntegrableOn.locallyIntegrableOn (Integrable.sub hu hw)) (by
        intro ζ hζ hζc hζs
        have hzu := hint u hu ζ hζ.continuous hζc hζs
        have hzw := hint w hw ζ hζ.continuous hζc hζs
        simp only [smul_eq_mul, mul_sub]
        rw [integral_sub hzu hzw, hpair ζ hζ hζc hζs, sub_self])
    rw [ae_restrict_iff' hU.measurableSet]
    filter_upwards [key] with x hx hxU
    exact sub_eq_zero.1 (hx hxU)
  
  have T_pair : ∀ (g : E3 → ℝ), StronglyMeasurable g →
      (fcrHalf c s).indicator (Dφ [a]) =ᵐ[volume] g →
      Integrable ((fcrHalf c s).indicator φ) → Integrable g →
      ∀ (ζ : E3 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ fcrHalf c r →
      ∫ x, ζ x * fcrDQ a h φ x = ∫ x, ζ x * ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • (h • e a)) := by
    intro g hgm hg hfb hg1 ζ hζ hζc hζs
    
    have hG : ∀ x ∈ fcrHalf c r, ∀ τ : ℝ, |τ| ≤ |h| → x + τ • e a ∈ fcrHalf c s := by
      intro x hx τ hτ
      have hx' : x ∈ Metric.ball c r ∧ 0 < x 0 := hx
      have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
      have hn : ‖τ • e a‖ = |τ| := by rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
      have htri : dist (x + τ • e a) c ≤ dist x c + ‖τ • e a‖ := by
        rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]; exact norm_add_le _ _
      have h0 : (x + τ • e a) 0 = x 0 := by simp [e, EuclideanSpace.single_apply, Ne.symm ha]
      have hxb : dist x c < r := hx'.1
      refine ⟨Metric.mem_ball.2 (by linarith), ?_⟩
      show 0 < (x + τ • e a) 0
      rw [h0]; exact hx'.2
    
    have hdiff : Differentiable ℝ ζ := hζ.differentiable (by simp)
    have hfdc : Continuous (fderiv ℝ ζ) := hζ.continuous_fderiv (by simp)
    obtain ⟨C₀, hC₀⟩ := hζ.continuous.bounded_above_of_compact_support hζc
    obtain ⟨C₁, hC₁⟩ := hfdc.bounded_above_of_compact_support (hζc.fderiv ℝ)
    have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
    have hdζ : ∀ z, ‖partialDeriv a ζ z‖ ≤ C₁ := by
      intro z
      have h1 : ‖fderiv ℝ ζ z (e a)‖ ≤ ‖fderiv ℝ ζ z‖ * ‖e a‖ := ContinuousLinearMap.le_opNorm _ _
      rw [hea, mul_one] at h1
      exact h1.trans (hC₁ z)
    set fb := (fcrHalf c s).indicator φ with hfb_def
    set gb := (fcrHalf c s).indicator (Dφ [a]) with hgb_def
    
    have hP1pt : ∀ x, ζ x * fcrDQ a h φ x = (ζ x * fb (x + h • e a) - ζ x * fb x) / h := by
      intro x
      by_cases hz : ζ x = 0
      · simp [hz]
      · have hxt : x ∈ tsupport ζ := subset_tsupport _ hz
        have hxr : x ∈ fcrHalf c r := hζs hxt
        have h1 : x + h • e a ∈ fcrHalf c s := hG x hxr h le_rfl
        have h2 : x ∈ fcrHalf c s := by
          have := hG x hxr 0 (by simp)
          simpa using this
        rw [hfb_def, Set.indicator_of_mem h1, Set.indicator_of_mem h2]
        unfold fcrDQ
        ring
    have hi1 : Integrable (fun x => ζ x * fb (x + h • e a)) :=
      Integrable.bdd_mul (hfb.comp_add_right (h • e a)) hζ.continuous.aestronglyMeasurable
        (Filter.Eventually.of_forall hC₀)
    have hi2 : Integrable (fun x => ζ x * fb x) :=
      Integrable.bdd_mul hfb hζ.continuous.aestronglyMeasurable (Filter.Eventually.of_forall hC₀)
    have hi3 : Integrable (fun y => ζ (y - h • e a) * fb y) :=
      Integrable.bdd_mul hfb
        (hζ.continuous.comp (continuous_id.sub continuous_const)).aestronglyMeasurable
        (Filter.Eventually.of_forall (fun y => hC₀ _))
    have hshift : ∫ x, ζ x * fb (x + h • e a) = ∫ y, ζ (y - h • e a) * fb y := by
      have := integral_add_right_eq_self (μ := (volume : Measure E3))
        (fun y => ζ (y - h • e a) * fb y) (h • e a)
      simpa only [add_sub_cancel_right] using this
    have hstep1 : ∫ x, ζ x * fcrDQ a h φ x = ∫ y, fb y * ((ζ (y - h • e a) - ζ y) / h) := by
      rw [integral_congr_ae (Filter.Eventually.of_forall hP1pt), integral_div,
        integral_sub hi1 hi2, hshift]
      have : (fun y => fb y * ((ζ (y - h • e a) - ζ y) / h)) =
          fun y => (ζ (y - h • e a) * fb y - ζ y * fb y) / h := by
        funext y; ring
      rw [this, integral_div, integral_sub hi3 hi2]
    
    have hftc : ∀ y, (ζ (y - h • e a) - ζ y) / h =
        -∫ t in Set.Ioc (0:ℝ) 1, partialDeriv a ζ (y - t • (h • e a)) := by
      intro y
      have hd : ∀ t : ℝ, HasDerivAt (fun t : ℝ => ζ (y - t • (h • e a)))
          (-(h * partialDeriv a ζ (y - t • (h • e a)))) t := by
        intro t
        have h1 : HasDerivAt (fun t : ℝ => y - t • (h • e a)) (-(h • e a)) t := by
          simpa using ((hasDerivAt_id t).smul_const (h • e a)).const_sub y
        have h2 := (hdiff (y - t • (h • e a))).hasFDerivAt.comp_hasDerivAt t h1
        convert h2 using 1
        rw [map_neg, map_smul, smul_eq_mul]
        rfl
      have hcont : Continuous (fun t : ℝ => -(h * partialDeriv a ζ (y - t • (h • e a)))) := by
        unfold partialDeriv
        have hc0 : Continuous (fun t : ℝ => fderiv ℝ ζ (y - t • (h • e a)) (e a)) :=
          (hfdc.comp (continuous_const.sub (continuous_id.smul continuous_const))).clm_apply
            continuous_const
        exact (continuous_const.mul hc0).neg
      have hI := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
        (fun t _ => hd t) (hcont.intervalIntegrable 0 1)
      rw [intervalIntegral.integral_of_le zero_le_one] at hI
      simp only [one_smul, zero_smul, sub_zero] at hI
      rw [integral_neg, integral_const_mul] at hI
      rw [← hI, neg_div, mul_div_cancel_left₀ _ hh]
    
    have hcontP : Continuous (fun p : E3 × ℝ => partialDeriv a ζ (p.1 - p.2 • (h • e a))) := by
      unfold partialDeriv
      exact (hfdc.comp (continuous_fst.sub (continuous_snd.smul continuous_const))).clm_apply
        continuous_const
    have hint3 : Integrable (fun p : E3 × ℝ => fb p.1 * partialDeriv a ζ (p.1 - p.2 • (h • e a)))
        ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) := by
      have hfp : Integrable (fun p : E3 × ℝ => fb p.1 * 1)
          ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) :=
        hfb.mul_prod (integrable_const (1:ℝ))
      simp only [mul_one] at hfp
      exact Integrable.mul_bdd hfp hcontP.aestronglyMeasurable
        (Filter.Eventually.of_forall (fun p => hdζ _))
    have hstep2 : ∫ y, fb y * ((ζ (y - h • e a) - ζ y) / h) =
        -∫ t in Set.Ioc (0:ℝ) 1, ∫ y, fb y * partialDeriv a ζ (y - t • (h • e a)) := by
      simp_rw [hftc, mul_neg, integral_neg]
      congr 1
      simp_rw [← integral_const_mul]
      exact integral_integral_swap (f := fun y t => fb y * partialDeriv a ζ (y - t • (h • e a)))
        hint3
    
    have hP4 : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
        ∫ y, fb y * partialDeriv a ζ (y - t • (h • e a)) =
          -∫ x, ζ x * g (x + t • (h • e a)) := by
      intro t ht0 ht1
      set w : E3 := t • (h • e a) with hw
      have hw' : w = (t * h) • e a := by rw [hw, smul_smul]
      have hτ : |t * h| ≤ |h| := by
        rw [abs_mul, abs_of_nonneg ht0]
        exact mul_le_of_le_one_left (abs_nonneg h) ht1
      have hout : ∀ y, y ∉ fcrHalf c s → y - w ∉ tsupport ζ := by
        intro y hy hyt
        apply hy
        have := hG (y - w) (hζs hyt) (t * h) hτ
        rwa [← hw', sub_add_cancel] at this
      have hζt : ContDiff ℝ ∞ (fun y => ζ (y - w)) := hζ.comp (contDiff_id.sub contDiff_const)
      have hζtc : HasCompactSupport (fun y => ζ (y - w)) :=
        hζc.comp_homeomorph (Homeomorph.subRight w)
      have hζts : tsupport (fun y => ζ (y - w)) ⊆ fcrHalf c s := by
        have heq : tsupport (fun y => ζ (y - w)) = (Homeomorph.subRight w) ⁻¹' tsupport ζ :=
          tsupport_comp_eq_preimage ζ (Homeomorph.subRight w)
        rw [heq]
        intro y hy
        by_contra hys
        exact hout y hys hy
      have hpd : ∀ y, partialDeriv a (fun y => ζ (y - w)) y = partialDeriv a ζ (y - w) := by
        intro y
        unfold partialDeriv
        have : (fun y => ζ (y - w)) = fun y => ζ (y + -w) := by
          funext y; rw [sub_eq_add_neg]
        rw [this, fderiv_comp_add_right, ← sub_eq_add_neg]
      have hweak := hφ.2.2 [] a (by simp) (fun y => ζ (y - w)) hζt hζtc hζts
      rw [hφ.1] at hweak
      simp only [hpd] at hweak
      have hl : ∫ y, fb y * partialDeriv a ζ (y - w) = ∫ y, φ y * partialDeriv a ζ (y - w) := by
        congr 1; funext y
        by_cases hy : y ∈ fcrHalf c s
        · rw [hfb_def, Set.indicator_of_mem hy]
        · have h1 : partialDeriv a ζ (y - w) = 0 := by
            unfold partialDeriv
            have : fderiv ℝ ζ (y - w) = 0 := by
              by_contra hne
              exact hout y hy (support_fderiv_subset ℝ hne)
            rw [this]; rfl
          rw [h1, mul_zero, mul_zero]
      have hr : ∫ y, Dφ [a] y * ζ (y - w) = ∫ y, g y * ζ (y - w) := by
        have h1 : ∫ y, Dφ [a] y * ζ (y - w) = ∫ y, gb y * ζ (y - w) := by
          congr 1; funext y
          by_cases hy : y ∈ fcrHalf c s
          · rw [hgb_def, Set.indicator_of_mem hy]
          · rw [image_eq_zero_of_notMem_tsupport (hout y hy), mul_zero, mul_zero]
        rw [h1]
        refine integral_congr_ae ?_
        filter_upwards [hg] with y hy
        rw [hy]
      have htr : ∫ y, g y * ζ (y - w) = ∫ x, ζ x * g (x + w) := by
        have := integral_add_right_eq_self (μ := (volume : Measure E3))
          (fun y => g y * ζ (y - w)) w
        simp only [add_sub_cancel_right] at this
        rw [← this]
        congr 1; funext x; ring
      rw [hl, hweak, hr, htr]
    
    have hint5 : Integrable (fun p : E3 × ℝ => ζ p.1 * g (p.1 + p.2 • (h • e a)))
        ((volume : Measure E3).prod (volume.restrict (Set.Ioc (0:ℝ) 1))) :=
      Integrable.bdd_mul (T_avg_int g hgm hg1 (h • e a))
        (hζ.continuous.comp continuous_fst).aestronglyMeasurable
        (Filter.Eventually.of_forall (fun p => hC₀ _))
    have hstep3 : ∫ t in Set.Ioc (0:ℝ) 1, ∫ y, fb y * partialDeriv a ζ (y - t • (h • e a)) =
        -∫ t in Set.Ioc (0:ℝ) 1, ∫ x, ζ x * g (x + t • (h • e a)) := by
      rw [← integral_neg]
      refine setIntegral_congr_fun measurableSet_Ioc (fun t ht => ?_)
      exact hP4 t ht.1.le ht.2
    have hstep4 : ∫ t in Set.Ioc (0:ℝ) 1, ∫ x, ζ x * g (x + t • (h • e a)) =
        ∫ x, ζ x * ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • (h • e a)) := by
      simp_rw [← integral_const_mul]
      exact (integral_integral_swap (f := fun x t => ζ x * g (x + t • (h • e a))) hint5).symm
    rw [hstep1, hstep2, hstep3, neg_neg, hstep4]
  
  have hopen : ∀ ρ : ℝ, IsOpen (fcrHalf c ρ) := fun ρ =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hfin : ∀ ρ : ℝ, IsFiniteMeasure (volume.restrict (fcrHalf c ρ)) := fun ρ =>
    isFiniteMeasure_restrict.2 (ne_of_lt (lt_of_le_of_lt (measure_mono Set.inter_subset_left)
      measure_ball_lt_top))
  have hφL : MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    have h0 := hφ.2.1 [] (by simp)
    rwa [hφ.1] at h0
  have hDL : MemLp (Dφ [a]) 2 (volume.restrict (fcrHalf c s)) := hφ.2.1 [a] (by simp)
  have hgb2 : MemLp ((fcrHalf c s).indicator (Dφ [a])) 2 volume :=
    (memLp_indicator_iff_restrict (hopen s).measurableSet).2 hDL
  haveI := hfin s
  have hgb1 : Integrable ((fcrHalf c s).indicator (Dφ [a])) :=
    (integrable_indicator_iff (hopen s).measurableSet).2 (hDL.integrable one_le_two)
  have hfb1 : Integrable ((fcrHalf c s).indicator φ) :=
    (integrable_indicator_iff (hopen s).measurableSet).2 (hφL.integrable one_le_two)
  obtain ⟨g, hgm, hg⟩ : ∃ g : E3 → ℝ, StronglyMeasurable g ∧
      (fcrHalf c s).indicator (Dφ [a]) =ᵐ[volume] g :=
    ⟨_, hgb2.aestronglyMeasurable.stronglyMeasurable_mk, hgb2.aestronglyMeasurable.ae_eq_mk⟩
  have hg2 : MemLp g 2 volume := hgb2.ae_eq hg
  have hg1 : Integrable g := hgb1.congr hg
  haveI := hfin r
  have hDQL : MemLp (fcrDQ a h φ) 2 (volume.restrict (fcrHalf c r)) := by
    have hind : MemLp ((fcrHalf c s).indicator φ) 2 volume :=
      (memLp_indicator_iff_restrict (hopen s).measurableSet).2 hφL
    have htr : MemLp (((fcrHalf c s).indicator φ) ∘ (fun x => x + h • e a)) 2 volume :=
      hind.comp_measurePreserving (measurePreserving_add_right volume (h • e a))
    have hsh : ∀ x ∈ fcrHalf c r, x + h • e a ∈ fcrHalf c s := by
      intro x hx
      have hx' : x ∈ Metric.ball c r ∧ 0 < x 0 := hx
      have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
      have hn : ‖h • e a‖ = |h| := by rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
      have htri : dist (x + h • e a) c ≤ dist x c + ‖h • e a‖ := by
        rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]; exact norm_add_le _ _
      have h0 : (x + h • e a) 0 = x 0 := by simp [e, EuclideanSpace.single_apply, Ne.symm ha]
      have hxb : dist x c < r := hx'.1
      refine ⟨Metric.mem_ball.2 (by linarith), ?_⟩
      show 0 < (x + h • e a) 0
      rw [h0]; exact hx'.2
    have htr' : MemLp (fun x => φ (x + h • e a)) 2 (volume.restrict (fcrHalf c r)) := by
      refine (htr.restrict (fcrHalf c r)).ae_eq ?_
      refine ae_restrict_of_forall_mem (hopen r).measurableSet (fun x hx => ?_)
      simp only [Function.comp_apply]
      exact Set.indicator_of_mem (hsh x hx) φ
    have hsub : fcrHalf c r ⊆ fcrHalf c s := by
      intro x hx
      have hx' : x ∈ Metric.ball c r ∧ 0 < x 0 := hx
      exact ⟨Metric.ball_subset_ball (by linarith [abs_nonneg h]) hx'.1, hx'.2⟩
    have hφ2 : MemLp φ 2 (volume.restrict (fcrHalf c r)) :=
      hφL.mono_measure (Measure.restrict_mono hsub le_rfl)
    have hm := (htr'.sub hφ2).mul_const h⁻¹
    refine hm.ae_eq (Filter.Eventually.of_forall (fun x => ?_))
    simp only [fcrDQ, div_eq_mul_inv, Pi.sub_apply]
  have hDQ : IntegrableOn (fcrDQ a h φ) (fcrHalf c r) :=
    hDQL.integrable one_le_two
  have hV : IntegrableOn (fun x => ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • (h • e a)))
      (fcrHalf c r) :=
    (T_avg_int g hgm hg1 (h • e a)).integral_prod_left.integrableOn
  have hae := T_ae_eq (fcrHalf c r) (hopen r) (fcrDQ a h φ)
    (fun x => ∫ t in Set.Ioc (0:ℝ) 1, g (x + t • (h • e a))) hDQ hV
    (fun ζ h1 h2 h3 => T_pair g hgm hg hfb1 hg1 ζ h1 h2 h3)
  calc ∫ x in fcrHalf c r, (fcrDQ a h φ x) ^ 2
      = ∫ x in fcrHalf c r, (∫ t in Set.Ioc (0:ℝ) 1, g (x + t • (h • e a))) ^ 2 := by
        refine integral_congr_ae ?_
        filter_upwards [hae] with x hx
        rw [hx]
    _ ≤ ∫ x, g x ^ 2 := T_avg_sq g hgm hg2 (h • e a) (fcrHalf c r)
    _ = ∫ x, ((fcrHalf c s).indicator (Dφ [a]) x) ^ 2 := by
        refine integral_congr_ae ?_
        filter_upwards [hg] with x hx
        rw [hx]
    _ = ∫ x in fcrHalf c s, (Dφ [a] x) ^ 2 := by
        rw [← integral_indicator (hopen s).measurableSet]
        congr 1; funext x
        by_cases hx : x ∈ fcrHalf c s
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
        · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]; ring

theorem fcr_dq_bounds (c : E3) (R s s₂ s₃ h₀ : ℝ) (hs₂ : 0 < s₂) (hh₀ : 0 < h₀)
    (h23 : s₂ + h₀ < s₃) (h3s : s₃ + 2 * h₀ ≤ s) (hsR : s < R)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef)
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fcrProb c s A w D G F) (hG : ∀ d, ∃ DG, fcrSob c s 1 (G d) DG)
    (a : Fin 3) (ha : a ≠ 0) :
    ∃ lam Λ M : ℝ, 0 < lam ∧ 0 ≤ Λ ∧ 0 ≤ M ∧ ∀ h : ℝ, h ≠ 0 → |h| ≤ h₀ →
      (∀ x ∈ fcrHalf c s₂, ∀ ξ : Fin 3 → ℝ,
        lam * ∑ i : Fin 3, ξ i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, ξ i * A (x + h • e a) i j * ξ j) ∧
      (∀ x ∈ fcrHalf c s₂, ∀ i j : Fin 3, |A (x + h • e a) i j| ≤ Λ) ∧
      MemLp (fcrDQ a h w) 2 (volume.restrict (fcrHalf c s₂)) ∧
      (∀ d, MemLp (fcrDQ a h (D [d])) 2 (volume.restrict (fcrHalf c s₂))) ∧
      (∀ d, MemLp (fun x => (∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
        fcrDQ a h (G d) x) 2 (volume.restrict (fcrHalf c s₂))) ∧
      MemLp F 2 (volume.restrict (fcrHalf c s₂)) ∧
      ∫ x in fcrHalf c s₂, (fcrDQ a h w x) ^ 2 ≤ M ∧
      (∀ d, ∫ x in fcrHalf c s₂, ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
        fcrDQ a h (G d) x) ^ 2 ≤ M) ∧
      ∫ x in fcrHalf c s₂, (F x) ^ 2 ≤ M :=
by
  classical
  
  have hs3R : s₃ < R := by linarith
  have hs2s : s₂ + h₀ < s := by linarith
  have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r : ℝ, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hsub : fcrHalf c s₂ ⊆ fcrHalf c s := by
    intro x hx
    have hx' : x ∈ Metric.ball c s₂ ∧ 0 < x 0 := hx
    exact ⟨Metric.ball_subset_ball (by linarith) hx'.1, hx'.2⟩
  have hμ : volume.restrict (fcrHalf c s₂) ≤ volume.restrict (fcrHalf c s) :=
    Measure.restrict_mono hsub le_rfl
  have hKsub : Metric.closedBall c s₃ ⊆ Metric.ball c R := Metric.closedBall_subset_ball hs3R
  have hshift : ∀ h : ℝ, |h| ≤ h₀ → ∀ x ∈ fcrHalf c s₂,
      x + h • e a ∈ Metric.closedBall c s₃ ∧ x + h • e a ∈ fcrHalf c s ∧
        x ∈ Metric.closedBall c s₃ := by
    intro h hh x hx
    have hx' : x ∈ Metric.ball c s₂ ∧ 0 < x 0 := hx
    have hxb : dist x c < s₂ := hx'.1
    have hx0 : 0 < x 0 := hx'.2
    have hn : ‖h • e a‖ = |h| := by rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
    have htri : dist (x + h • e a) c ≤ dist x c + ‖h • e a‖ := by
      rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]
      exact norm_add_le _ _
    have hlt : dist (x + h • e a) c < s₃ := by linarith
    have h0 : (x + h • e a) 0 = x 0 := by
      simp [e, EuclideanSpace.single_apply, Ne.symm ha]
    refine ⟨Metric.mem_closedBall.2 hlt.le, ⟨Metric.mem_ball.2 (by linarith), ?_⟩,
      Metric.mem_closedBall.2 (by linarith)⟩
    show 0 < (x + h • e a) 0
    rw [h0]
    exact hx0
  
  obtain ⟨lam, Mx, Γ, hlam, -, -, hcb⟩ := coeff_compact_bounds A (Metric.ball c R) c s₃
    Metric.isOpen_ball hKsub hA hApos
  
  have hCb : ∀ i j : Fin 3, ∃ C : ℝ, ∀ y ∈ Metric.closedBall c s₃, ‖A y i j‖ ≤ C := fun i j =>
    (isCompact_closedBall c s₃).exists_bound_of_continuousOn ((hA i j).continuousOn.mono hKsub)
  choose C hC using hCb
  obtain ⟨Λ, hΛdef⟩ : ∃ Λ : ℝ, Λ = ∑ i : Fin 3, ∑ j : Fin 3, |C i j| := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ := by
    rw [hΛdef]
    exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
  have hCΛ : ∀ i j, |C i j| ≤ Λ := by
    intro i j
    rw [hΛdef]
    calc |C i j| ≤ ∑ j' : Fin 3, |C i j'| :=
          Finset.single_le_sum (f := fun j' => |C i j'|) (fun _ _ => abs_nonneg _)
            (Finset.mem_univ j)
      _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |C i' j'| :=
          Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, |C i' j'|)
            (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ i)
  
  have hLip : ∀ d b : Fin 3, ∃ L : ℝ, 0 ≤ L ∧ ∀ x ∈ Metric.closedBall c s₃,
      ∀ y ∈ Metric.closedBall c s₃, |A y d b - A x d b| ≤ L * ‖y - x‖ := by
    intro d b
    have hfc : ContinuousOn (fderiv ℝ (fun z => A z d b)) (Metric.ball c R) :=
      (hA d b).continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)
    obtain ⟨C', hC'⟩ := (isCompact_closedBall c s₃).exists_bound_of_continuousOn (hfc.mono hKsub)
    refine ⟨max C' 0, le_max_right _ _, fun x hx y hy => ?_⟩
    have hdiff : ∀ z ∈ Metric.closedBall c s₃, DifferentiableAt ℝ (fun z => A z d b) z :=
      fun z hz => ((hA d b).differentiableOn (by simp)).differentiableAt
        (Metric.isOpen_ball.mem_nhds (hKsub hz))
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (C := max C' 0) hdiff
      (fun z hz => (hC' z hz).trans (le_max_left C' 0)) (convex_closedBall c s₃) hx hy
    rw [Real.norm_eq_abs] at hmvt
    exact hmvt
  choose Lc hLc0 hLc using hLip
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = ∑ d : Fin 3, ∑ b : Fin 3, Lc d b := ⟨_, rfl⟩
  have hL0 : 0 ≤ L := by
    rw [hLdef]
    exact Finset.sum_nonneg (fun d _ => Finset.sum_nonneg (fun b _ => hLc0 d b))
  have hLcL : ∀ d b, Lc d b ≤ L := by
    intro d b
    rw [hLdef]
    calc Lc d b ≤ ∑ b' : Fin 3, Lc d b' :=
          Finset.single_le_sum (f := fun b' => Lc d b') (fun _ _ => hLc0 _ _) (Finset.mem_univ b)
      _ ≤ ∑ d' : Fin 3, ∑ b' : Fin 3, Lc d' b' :=
          Finset.single_le_sum (f := fun d' => ∑ b' : Fin 3, Lc d' b')
            (fun _ _ => Finset.sum_nonneg (fun _ _ => hLc0 _ _)) (Finset.mem_univ d)
  
  choose DG hDG using hG
  have hwL : MemLp w 2 (volume.restrict (fcrHalf c s)) := by
    have h0 := hP.1.2.1 [] (by simp)
    rwa [hP.1.1] at h0
  have hDL : ∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s)) :=
    fun b => hP.1.2.1 [b] (by simp)
  have hGL : ∀ d, MemLp (G d) 2 (volume.restrict (fcrHalf c s)) := hP.2.1
  have hFL : MemLp F 2 (volume.restrict (fcrHalf c s)) := hP.2.2.1
  
  obtain ⟨SI, hSI⟩ : ∃ SI : ℝ, SI = ∑ b : Fin 3, ∫ x in fcrHalf c s, (D [b] x) ^ 2 := ⟨_, rfl⟩
  obtain ⟨SJ, hSJ⟩ : ∃ SJ : ℝ, SJ = ∑ d : Fin 3, ∫ x in fcrHalf c s, (DG d [a] x) ^ 2 :=
    ⟨_, rfl⟩
  have hSI0 : 0 ≤ SI := by
    rw [hSI]
    exact Finset.sum_nonneg (fun b _ => integral_nonneg (fun x => sq_nonneg (D [b] x)))
  have hJle : ∀ d, ∫ x in fcrHalf c s, (DG d [a] x) ^ 2 ≤ SJ := by
    intro d
    rw [hSJ]
    exact Finset.single_le_sum (f := fun d => ∫ x in fcrHalf c s, (DG d [a] x) ^ 2)
      (fun d _ => integral_nonneg (fun x => sq_nonneg (DG d [a] x))) (Finset.mem_univ d)
  have hSJ0 : 0 ≤ SJ := le_trans (integral_nonneg (fun x => sq_nonneg (DG 0 [a] x))) (hJle 0)
  have hIa0 : 0 ≤ ∫ x in fcrHalf c s, (D [a] x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hΦ0 : 0 ≤ ∫ x in fcrHalf c s, (F x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = (∫ x in fcrHalf c s, (D [a] x) ^ 2) +
      (∫ x in fcrHalf c s, (F x) ^ 2) + 4 * (L ^ 2 * SI) + 4 * SJ := ⟨_, rfl⟩
  have hL2 : 0 ≤ L ^ 2 := sq_nonneg L
  have hM0 : 0 ≤ M := by
    rw [hMdef]
    have := mul_nonneg hL2 hSI0
    linarith
  
  have hdq : ∀ (φ : E3 → ℝ) (h : ℝ), |h| ≤ h₀ → MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp (fcrDQ a h φ) 2 (volume.restrict (fcrHalf c s₂)) := by
    intro φ h hh hφ
    have hind : MemLp ((fcrHalf c s).indicator φ) 2 volume :=
      (memLp_indicator_iff_restrict (hmeas s)).2 hφ
    have htr : MemLp (((fcrHalf c s).indicator φ) ∘ (fun x => x + h • e a)) 2 volume :=
      hind.comp_measurePreserving (measurePreserving_add_right volume (h • e a))
    have htr' : MemLp (fun x => φ (x + h • e a)) 2 (volume.restrict (fcrHalf c s₂)) := by
      refine (htr.restrict (fcrHalf c s₂)).ae_eq ?_
      refine ae_restrict_of_forall_mem (hmeas s₂) (fun x hx => ?_)
      simp only [Function.comp_apply]
      exact Set.indicator_of_mem (hshift h hh x hx).2.1 φ
    have hφ2 : MemLp φ 2 (volume.restrict (fcrHalf c s₂)) := hφ.mono_measure hμ
    have hm := (htr'.sub hφ2).mul_const h⁻¹
    refine hm.ae_eq (Filter.Eventually.of_forall (fun x => ?_))
    simp only [fcrDQ, div_eq_mul_inv, Pi.sub_apply]
  
  have hAdq : ∀ (h : ℝ), h ≠ 0 → |h| ≤ h₀ → ∀ d b : Fin 3,
      ContinuousOn (fcrDQ a h (fun y => A y d b)) (fcrHalf c s₂) ∧
      ∀ x ∈ fcrHalf c s₂, |fcrDQ a h (fun y => A y d b) x| ≤ L := by
    intro h hh0 hh d b
    constructor
    · have hmaps : Set.MapsTo (fun x : E3 => x + h • e a) (fcrHalf c s₂) (Metric.ball c R) :=
        fun x hx => hKsub (hshift h hh x hx).1
      have hmaps2 : fcrHalf c s₂ ⊆ Metric.ball c R := fun x hx => hKsub (hshift h hh x hx).2.2
      have h1 : ContinuousOn (fun x => A (x + h • e a) d b) (fcrHalf c s₂) :=
        (hA d b).continuousOn.comp (continuous_add_right (h • e a)).continuousOn hmaps
      have h2 : ContinuousOn (fun x => A x d b) (fcrHalf c s₂) := (hA d b).continuousOn.mono hmaps2
      exact (h1.sub h2).div_const h
    · intro x hx
      obtain ⟨hy, -, hxK⟩ := hshift h hh x hx
      have hl := hLc d b x hxK _ hy
      have hn : ‖x + h • e a - x‖ = |h| := by
        rw [add_sub_cancel_left, norm_smul, hea, mul_one, Real.norm_eq_abs]
      rw [hn] at hl
      have hpos : 0 < |h| := abs_pos.2 hh0
      unfold fcrDQ
      rw [abs_div, div_le_iff₀ hpos]
      calc |A (x + h • e a) d b - A x d b| ≤ Lc d b * |h| := hl
        _ ≤ L * |h| := mul_le_mul_of_nonneg_right (hLcL d b) hpos.le
  refine ⟨lam, Λ, M, hlam, hΛ0, hM0, fun h hh0 hh => ?_⟩
  have hs2h : s₂ + |h| < s := by linarith
  have hDb2 : ∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s₂)) :=
    fun b => (hDL b).mono_measure hμ
  have hpmem : ∀ d b, MemLp (fun x => fcrDQ a h (fun y => A y d b) x * D [b] x) 2
      (volume.restrict (fcrHalf c s₂)) := by
    intro d b
    obtain ⟨hc, hbd⟩ := hAdq h hh0 hh d b
    refine MemLp.of_le_mul (c := L) (hDb2 b)
      ((hc.aestronglyMeasurable (hmeas s₂)).mul (hDb2 b).aestronglyMeasurable) ?_
    refine ae_restrict_of_forall_mem (hmeas s₂) (fun x hx => ?_)
    rw [norm_mul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (hbd x hx) (norm_nonneg _)
  have hRmem : ∀ d, MemLp (fun x => (∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
      fcrDQ a h (G d) x) 2 (volume.restrict (fcrHalf c s₂)) := by
    intro d
    exact (memLp_finset_sum Finset.univ (fun b _ => hpmem d b)).add (hdq _ h hh (hGL d))
  refine ⟨fun x hx ξ => (hcb _ (hshift h hh x hx).1).1 ξ, fun x hx i j => ?_,
    hdq w h hh hwL, fun d => hdq _ h hh (hDL d), hRmem, hFL.mono_measure hμ, ?_, fun d => ?_, ?_⟩
  · have h1 := hC i j _ (hshift h hh x hx).1
    rw [Real.norm_eq_abs] at h1
    exact h1.trans ((le_abs_self _).trans (hCΛ i j))
  · have h1 := fcr_dq_sob_L2_bound c s s₂ w D a ha h hs2h hP.1
    rw [hMdef]
    have := mul_nonneg hL2 hSI0
    linarith
  · have hq := fcr_dq_sob_L2_bound c s s₂ (G d) (DG d) a ha h hs2h (hDG d)
    have hqm : MemLp (fcrDQ a h (G d)) 2 (volume.restrict (fcrHalf c s₂)) := hdq _ h hh (hGL d)
    have hint1 : Integrable (fun x => ∑ b : Fin 3, D [b] x ^ 2) (volume.restrict (fcrHalf c s₂)) :=
      integrable_finset_sum _ (fun b _ => (hDb2 b).integrable_sq)
    have key : ∀ y0 y1 y2 q : ℝ, (y0 + y1 + y2 + q) ^ 2 ≤ 4 * (y0 ^ 2 + y1 ^ 2 + y2 ^ 2 + q ^ 2) := by
      intro y0 y1 y2 q
      nlinarith [sq_nonneg (y0 - y1), sq_nonneg (y0 - y2), sq_nonneg (y0 - q),
        sq_nonneg (y1 - y2), sq_nonneg (y1 - q), sq_nonneg (y2 - q)]
    have hpt : ∀ x ∈ fcrHalf c s₂,
        ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x) ^ 2 ≤
          4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) + 4 * fcrDQ a h (G d) x ^ 2 := by
      intro x hx
      have hb : ∀ b, (fcrDQ a h (fun y => A y d b) x * D [b] x) ^ 2 ≤ L ^ 2 * D [b] x ^ 2 := by
        intro b
        have h1 := (hAdq h hh0 hh d b).2 x hx
        have h2 : (fcrDQ a h (fun y => A y d b) x) ^ 2 ≤ L ^ 2 := by
          rw [← sq_abs]
          exact pow_le_pow_left₀ (abs_nonneg _) h1 2
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_right h2 (sq_nonneg _)
      have k := key (fcrDQ a h (fun y => A y d 0) x * D [0] x)
        (fcrDQ a h (fun y => A y d 1) x * D [1] x) (fcrDQ a h (fun y => A y d 2) x * D [2] x)
        (fcrDQ a h (G d) x)
      rw [Fin.sum_univ_three, Fin.sum_univ_three]
      linarith [hb 0, hb 1, hb 2]
    have hRint := (hRmem d).integrable_sq
    have hrhs : Integrable (fun x => 4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) +
        4 * fcrDQ a h (G d) x ^ 2) (volume.restrict (fcrHalf c s₂)) :=
      (hint1.const_mul (4 * L ^ 2)).add (hqm.integrable_sq.const_mul 4)
    have hstep1 := setIntegral_mono_on hRint hrhs (hmeas s₂) hpt
    have heq : ∫ x in fcrHalf c s₂, (4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) +
        4 * fcrDQ a h (G d) x ^ 2) =
          4 * L ^ 2 * (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) +
          4 * (∫ x in fcrHalf c s₂, fcrDQ a h (G d) x ^ 2) := by
      rw [integral_add (hint1.const_mul _) (hqm.integrable_sq.const_mul _), integral_const_mul,
        integral_const_mul, integral_finset_sum _ (fun b _ => (hDb2 b).integrable_sq)]
    rw [heq] at hstep1
    have hsumle : (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) ≤ SI := by
      rw [hSI]
      exact Finset.sum_le_sum (fun b _ => setIntegral_mono_set (hDL b).integrable_sq
        (Filter.Eventually.of_forall (fun x => sq_nonneg _)) hsub.eventuallyLE)
    have h4 : 4 * L ^ 2 * (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) ≤ 4 * L ^ 2 * SI :=
      mul_le_mul_of_nonneg_left hsumle (by positivity)
    have hJ := hJle d
    rw [hMdef]
    linarith
  · calc ∫ x in fcrHalf c s₂, (F x) ^ 2 ≤ ∫ x in fcrHalf c s, (F x) ^ 2 :=
          setIntegral_mono_set hFL.integrable_sq
            (Filter.Eventually.of_forall (fun x => sq_nonneg _)) hsub.eventuallyLE
      _ ≤ M := by
          rw [hMdef]
          have := mul_nonneg hL2 hSI0
          linarith

theorem fcr_energy_absorb (lam Λ Cη : ℝ) (hlam : 0 < lam) (hΛ : 0 ≤ Λ) (hC : 0 ≤ Cη) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (S : Set E3) (B : E3 → Fin 3 → Fin 3 → ℝ) (η u F Q : E3 → ℝ)
      (dη U Rr : Fin 3 → E3 → ℝ) (M : ℝ) (a : Fin 3), MeasurableSet S → 0 ≤ M →
      (∀ x ∈ S, ∀ ξ : Fin 3 → ℝ,
        lam * ∑ i : Fin 3, ξ i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, ξ i * B x i j * ξ j) →
      (∀ x ∈ S, ∀ i j : Fin 3, |B x i j| ≤ Λ) →
      (∀ i j : Fin 3, AEStronglyMeasurable (fun x => B x i j) (volume.restrict S)) →
      Continuous η → (∀ x, 0 ≤ η x ∧ η x ≤ 1) →
      (∀ d, Continuous (dη d)) → (∀ d x, |dη d x| ≤ Cη) →
      MemLp u 2 (volume.restrict S) → (∀ d, MemLp (U d) 2 (volume.restrict S)) →
      (∀ d, MemLp (Rr d) 2 (volume.restrict S)) → MemLp F 2 (volume.restrict S) →
      MemLp Q 2 (volume.restrict S) →
      ∫ x in S, u x ^ 2 ≤ M → (∀ d, ∫ x in S, Rr d x ^ 2 ≤ M) → ∫ x in S, F x ^ 2 ≤ M →
      ∫ x in S, Q x ^ 2 ≤ ∫ x in S, (η x ^ 2 * U a x + 2 * η x * dη a x * u x) ^ 2 →
      (∫ x in S, ∑ d : Fin 3, ((∑ b : Fin 3, B x d b * U b x) + Rr d x) *
          (η x ^ 2 * U d x + 2 * η x * dη d x * u x)) = ∫ x in S, F x * Q x →
      ∫ x in S, η x ^ 2 * ∑ d : Fin 3, U d x ^ 2 ≤ K * M :=
by
  
  obtain ⟨Y, hYdef⟩ : ∃ Y : ℝ, Y = 1 / lam := ⟨_, rfl⟩
  have hlY : lam * Y = 1 := by rw [hYdef]; field_simp
  have hY0 : 0 ≤ Y := by rw [hYdef]; positivity
  obtain ⟨c₁, hc₁⟩ : ∃ c : ℝ, c = 162 * Λ ^ 2 * Cη ^ 2 * Y + 3 * Cη := ⟨_, rfl⟩
  obtain ⟨c₂, hc₂⟩ : ∃ c : ℝ, c = 3 / 2 * Y + Cη := ⟨_, rfl⟩
  have hc₁0 : 0 ≤ c₁ := by rw [hc₁]; positivity
  have hc₂0 : 0 ≤ c₂ := by rw [hc₂]; positivity
  obtain ⟨k, hk⟩ : ∃ k : ℝ, k = 2 * Y + lam * Cη ^ 2 + c₁ + 3 * c₂ := ⟨_, rfl⟩
  have hk0 : 0 ≤ k := by rw [hk]; positivity
  
  have young1 : ∀ ξ t v : ℝ, t ^ 2 ≤ Λ ^ 2 * Cη ^ 2 →
      -(lam / 18) * ξ ^ 2 - 18 * Λ ^ 2 * Cη ^ 2 * Y * v ^ 2 ≤ 2 * t * ξ * v := by
    intro ξ t v ht
    have e : lam * (ξ + 18 * Y * t * v) ^ 2 / 18
        = lam / 18 * ξ ^ 2 + 2 * t * ξ * v + 18 * Y * t ^ 2 * v ^ 2 := by
      linear_combination (2 * t * ξ * v + 18 * Y * t ^ 2 * v ^ 2) * hlY
    have h0 : 0 ≤ lam * (ξ + 18 * Y * t * v) ^ 2 / 18 := by positivity
    have h1 : 18 * Y * t ^ 2 * v ^ 2 ≤ 18 * Y * (Λ ^ 2 * Cη ^ 2) * v ^ 2 := by
      have := mul_le_mul_of_nonneg_left ht (show 0 ≤ 18 * Y by positivity)
      exact mul_le_mul_of_nonneg_right this (sq_nonneg v)
    linarith
  have young2 : ∀ ξ c R : ℝ, c ^ 2 ≤ 1 →
      -(lam / 6) * ξ ^ 2 - 3 / 2 * Y * R ^ 2 ≤ c * R * ξ := by
    intro ξ c R hc
    have e : lam * (ξ + 3 * Y * c * R) ^ 2 / 6
        = lam / 6 * ξ ^ 2 + c * R * ξ + 3 / 2 * Y * c ^ 2 * R ^ 2 := by
      linear_combination (c * R * ξ + 3 / 2 * Y * c ^ 2 * R ^ 2) * hlY
    have h0 : 0 ≤ lam * (ξ + 3 * Y * c * R) ^ 2 / 6 := by positivity
    have h1 := mul_le_mul_of_nonneg_left (mul_le_of_le_one_left (sq_nonneg R) hc)
      (show 0 ≤ 3 / 2 * Y by positivity)
    linarith
  have young3 : ∀ τ v R : ℝ, |τ| ≤ Cη → -Cη * v ^ 2 - Cη * R ^ 2 ≤ 2 * τ * v * R := by
    intro τ v R h
    obtain ⟨h1, h2⟩ := abs_le.mp h
    nlinarith [mul_nonneg (show 0 ≤ Cη + τ by linarith) (sq_nonneg (v + R)),
      mul_nonneg (show 0 ≤ Cη - τ by linarith) (sq_nonneg (v - R))]
  
  have hpt : ∀ (Bm : Fin 3 → Fin 3 → ℝ) (η₀ v : ℝ) (dη₀ U₀ R₀ : Fin 3 → ℝ),
      (∀ ξ : Fin 3 → ℝ,
        lam * ∑ i : Fin 3, ξ i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, ξ i * Bm i j * ξ j) →
      (∀ i j : Fin 3, |Bm i j| ≤ Λ) → 0 ≤ η₀ → η₀ ≤ 1 → (∀ d, |dη₀ d| ≤ Cη) →
      2 / 3 * lam * (η₀ ^ 2 * ∑ d : Fin 3, U₀ d ^ 2) ≤
        (∑ d : Fin 3, ((∑ b : Fin 3, Bm d b * U₀ b) + R₀ d) *
            (η₀ ^ 2 * U₀ d + 2 * η₀ * dη₀ d * v))
          + c₁ * v ^ 2 + c₂ * ∑ d : Fin 3, R₀ d ^ 2 := by
    intro Bm η₀ v dη₀ U₀ R₀ hco hB hη0 hη1 hdη
    have hA := hco (fun i => η₀ * U₀ i)
    have ht : ∀ d b : Fin 3, (Bm d b * dη₀ d) ^ 2 ≤ Λ ^ 2 * Cη ^ 2 := by
      intro d b
      have h1 : |Bm d b * dη₀ d| ≤ Λ * Cη := by
        rw [abs_mul]; exact mul_le_mul (hB d b) (hdη d) (abs_nonneg _) hΛ
      have h2 := pow_le_pow_left₀ (abs_nonneg _) h1 2
      rw [sq_abs] at h2
      calc (Bm d b * dη₀ d) ^ 2 ≤ (Λ * Cη) ^ 2 := h2
        _ = Λ ^ 2 * Cη ^ 2 := by ring
    have hη2 : η₀ ^ 2 ≤ 1 := by nlinarith
    have hτ : ∀ d : Fin 3, |η₀ * dη₀ d| ≤ Cη := by
      intro d
      rw [abs_mul, abs_of_nonneg hη0]
      calc η₀ * |dη₀ d| ≤ 1 * Cη := mul_le_mul hη1 (hdη d) (abs_nonneg _) zero_le_one
        _ = Cη := one_mul _
    have H1 := fun d b => young1 (η₀ * U₀ b) (Bm d b * dη₀ d) v (ht d b)
    have H2 := fun d => young2 (η₀ * U₀ d) η₀ (R₀ d) hη2
    have H3 := fun d => young3 (η₀ * dη₀ d) v (R₀ d) (hτ d)
    simp only [Fin.sum_univ_three] at hA ⊢
    rw [hc₁, hc₂]
    linarith [H1 0 0, H1 0 1, H1 0 2, H1 1 0, H1 1 1, H1 1 2, H1 2 0, H1 2 1, H1 2 2,
      H2 0, H2 1, H2 2, H3 0, H3 1, H3 2]
  
  refine ⟨4 * Y * k, by positivity, ?_⟩
  intro S B η u F Q dη U Rr M a hS hM hco hB hBm hηc hη hdηc hdη hu hU hR hF hQ hum hRm hFm
    hQb hid
  obtain ⟨W, hWd⟩ : ∃ W : E3 → ℝ, ∀ x, W x = ∑ d : Fin 3,
      ((∑ b : Fin 3, B x d b * U b x) + Rr d x) * (η x ^ 2 * U d x + 2 * η x * dη d x * u x) :=
    ⟨_, fun x => rfl⟩
  obtain ⟨P, hPd⟩ : ∃ P : E3 → ℝ, ∀ x, P x = η x ^ 2 * ∑ d : Fin 3, U d x ^ 2 :=
    ⟨_, fun x => rfl⟩
  obtain ⟨V, hVd⟩ : ∃ V : E3 → ℝ, ∀ x, V x = η x ^ 2 * U a x + 2 * η x * dη a x * u x :=
    ⟨_, fun x => rfl⟩
  have hid' : ∫ x in S, W x = ∫ x in S, F x * Q x := by simp only [hWd]; exact hid
  have hQb' : ∫ x in S, Q x ^ 2 ≤ ∫ x in S, V x ^ 2 := by simp only [hVd]; exact hQb
  suffices hmain : ∫ x in S, P x ≤ 4 * Y * k * M by simpa only [hPd] using hmain
  have hη2 : ∀ x, η x ^ 2 ≤ 1 := fun x => by nlinarith [hη x]
  
  have hVm : ∀ d, MemLp (fun x => η x ^ 2 * U d x + 2 * η x * dη d x * u x) 2
      (volume.restrict S) := by
    intro d
    have h1 : MemLp (fun x => η x ^ 2 * U d x) 2 (volume.restrict S) := by
      refine (hU d).of_le ((hηc.pow 2).aestronglyMeasurable.mul (hU d).aestronglyMeasurable) ?_
      refine Filter.Eventually.of_forall (fun x => ?_)
      have h0 : 0 ≤ η x ^ 2 := sq_nonneg _
      rw [norm_mul, Real.norm_eq_abs (η x ^ 2), abs_of_nonneg h0]
      exact mul_le_of_le_one_left (norm_nonneg _) (hη2 x)
    have h2 : MemLp (fun x => 2 * η x * dη d x * u x) 2 (volume.restrict S) := by
      refine hu.of_le_mul (c := 2 * Cη)
        (((continuous_const.mul hηc).mul (hdηc d)).aestronglyMeasurable.mul
          hu.aestronglyMeasurable) ?_
      refine Filter.Eventually.of_forall (fun x => ?_)
      have hb : |2 * η x * dη d x| ≤ 2 * Cη := by
        rw [abs_mul, abs_mul, abs_of_nonneg (show (0:ℝ) ≤ 2 by norm_num),
          abs_of_nonneg (hη x).1]
        have := hdη d x
        have := (hη x).2
        have := (hη x).1
        have := abs_nonneg (dη d x)
        nlinarith
      rw [norm_mul, Real.norm_eq_abs (2 * η x * dη d x)]
      exact mul_le_mul_of_nonneg_right hb (norm_nonneg _)
    exact h1.add h2
  have hZ : ∀ d, MemLp (fun x => (∑ b : Fin 3, B x d b * U b x) + Rr d x) 2
      (volume.restrict S) := by
    intro d
    have hb : ∀ b, MemLp (fun x => B x d b * U b x) 2 (volume.restrict S) := by
      intro b
      refine (hU b).of_le_mul (c := Λ) ((hBm d b).mul (hU b).aestronglyMeasurable) ?_
      filter_upwards [ae_restrict_mem hS] with x hx
      rw [norm_mul, Real.norm_eq_abs (B x d b)]
      exact mul_le_mul_of_nonneg_right (hB x hx d b) (norm_nonneg _)
    simp only [Fin.sum_univ_three]
    exact (((hb 0).add (hb 1)).add (hb 2)).add (hR d)
  have hWi : Integrable W (volume.restrict S) := by
    have hWeq : W = fun x => ∑ d : Fin 3, ((∑ b : Fin 3, B x d b * U b x) + Rr d x) *
        (η x ^ 2 * U d x + 2 * η x * dη d x * u x) := funext hWd
    rw [hWeq]
    exact integrable_finset_sum Finset.univ (fun d _ => (hZ d).integrable_mul (hVm d))
  have hsumU : Integrable (fun x => ∑ d : Fin 3, U d x ^ 2) (volume.restrict S) :=
    integrable_finset_sum _ (fun d _ => (hU d).integrable_sq)
  have hPi : Integrable P (volume.restrict S) := by
    have hPeq : P = fun x => η x ^ 2 * ∑ d : Fin 3, U d x ^ 2 := funext hPd
    rw [hPeq]
    refine hsumU.mono' ((hηc.pow 2).aestronglyMeasurable.mul hsumU.aestronglyMeasurable) ?_
    refine Filter.Eventually.of_forall (fun x => ?_)
    have h0 : 0 ≤ ∑ d : Fin 3, U d x ^ 2 := Finset.sum_nonneg (fun d _ => sq_nonneg _)
    have h1 : 0 ≤ η x ^ 2 := sq_nonneg _
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg h1 h0)]
    exact mul_le_of_le_one_left h0 (hη2 x)
  have hVi : Integrable (fun x => V x ^ 2) (volume.restrict S) := by
    have hVeq : V = fun x => η x ^ 2 * U a x + 2 * η x * dη a x * u x := funext hVd
    rw [hVeq]
    exact (hVm a).integrable_sq
  have hu2 : Integrable (fun x => u x ^ 2) (volume.restrict S) := hu.integrable_sq
  have hR2 : ∀ d, Integrable (fun x => Rr d x ^ 2) (volume.restrict S) :=
    fun d => (hR d).integrable_sq
  have hF2 : Integrable (fun x => F x ^ 2) (volume.restrict S) := hF.integrable_sq
  have hQ2 : Integrable (fun x => Q x ^ 2) (volume.restrict S) := hQ.integrable_sq
  have hFQ : Integrable (fun x => F x * Q x) (volume.restrict S) := hF.integrable_mul hQ
  have hsumR : Integrable (fun x => ∑ d : Fin 3, Rr d x ^ 2) (volume.restrict S) :=
    integrable_finset_sum _ (fun d _ => hR2 d)
  
  have hA1 : Integrable (fun x => W x + c₁ * u x ^ 2) (volume.restrict S) :=
    hWi.add (hu2.const_mul c₁)
  have hA2 : Integrable (fun x => c₂ * ∑ d : Fin 3, Rr d x ^ 2) (volume.restrict S) :=
    hsumR.const_mul c₂
  have hA3 : Integrable (fun x => W x + c₁ * u x ^ 2 + c₂ * ∑ d : Fin 3, Rr d x ^ 2)
      (volume.restrict S) := hA1.add hA2
  have hA4 : Integrable (fun x => 2 / 3 * lam * P x) (volume.restrict S) := hPi.const_mul _
  have E1 : ∫ x in S, 2 / 3 * lam * P x ≤
      ∫ x in S, (W x + c₁ * u x ^ 2 + c₂ * ∑ d : Fin 3, Rr d x ^ 2) := by
    refine setIntegral_mono_on hA4 hA3 hS ?_
    intro x hx
    rw [hPd, hWd]
    exact hpt (B x) (η x) (u x) (fun d => dη d x) (fun d => U d x) (fun d => Rr d x)
      (hco x hx) (hB x hx) (hη x).1 (hη x).2 (fun d => hdη d x)
  have eL : ∫ x in S, 2 / 3 * lam * P x = 2 / 3 * lam * ∫ x in S, P x :=
    integral_const_mul _ _
  have eR : ∫ x in S, (W x + c₁ * u x ^ 2 + c₂ * ∑ d : Fin 3, Rr d x ^ 2) =
      (∫ x in S, W x) + c₁ * (∫ x in S, u x ^ 2) +
        c₂ * ∑ d : Fin 3, ∫ x in S, Rr d x ^ 2 := by
    rw [integral_add hA1 hA2, integral_add hWi (hu2.const_mul c₁), integral_const_mul,
      integral_const_mul, integral_finset_sum _ (fun d _ => hR2 d)]
  rw [eL, eR, Fin.sum_univ_three] at E1
  
  have hB2 : Integrable (fun x => 2 * Y * F x ^ 2 + lam / 8 * Q x ^ 2) (volume.restrict S) :=
    (hF2.const_mul _).add (hQ2.const_mul _)
  have E2 : ∫ x in S, F x * Q x ≤ ∫ x in S, (2 * Y * F x ^ 2 + lam / 8 * Q x ^ 2) := by
    refine integral_mono hFQ hB2 (fun x => ?_)
    have e : lam * (Q x - 4 * Y * F x) ^ 2 / 8
        = lam / 8 * Q x ^ 2 - F x * Q x + 2 * Y * F x ^ 2 := by
      linear_combination (2 * Y * F x ^ 2 - F x * Q x) * hlY
    have h0 : 0 ≤ lam * (Q x - 4 * Y * F x) ^ 2 / 8 := by positivity
    show F x * Q x ≤ 2 * Y * F x ^ 2 + lam / 8 * Q x ^ 2
    linarith
  rw [integral_add (hF2.const_mul _) (hQ2.const_mul _), integral_const_mul,
    integral_const_mul] at E2
  
  have hC2 : Integrable (fun x => 2 * P x + 8 * Cη ^ 2 * u x ^ 2) (volume.restrict S) :=
    (hPi.const_mul _).add (hu2.const_mul _)
  have E3 : ∫ x in S, V x ^ 2 ≤ ∫ x in S, (2 * P x + 8 * Cη ^ 2 * u x ^ 2) := by
    refine integral_mono hVi hC2 (fun x => ?_)
    show V x ^ 2 ≤ 2 * P x + 8 * Cη ^ 2 * u x ^ 2
    rw [hVd, hPd]
    have hη20 : 0 ≤ η x ^ 2 := sq_nonneg _
    have hUa : U a x ^ 2 ≤ ∑ d : Fin 3, U d x ^ 2 :=
      Finset.single_le_sum (f := fun d => U d x ^ 2) (fun d _ => sq_nonneg _)
        (Finset.mem_univ a)
    have hd2 : dη a x ^ 2 ≤ Cη ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hdη a x) 2
    have hp : (η x ^ 2 * U a x) ^ 2 ≤ η x ^ 2 * ∑ d : Fin 3, U d x ^ 2 := by
      calc (η x ^ 2 * U a x) ^ 2 = η x ^ 2 * (η x ^ 2 * U a x ^ 2) := by ring
        _ ≤ 1 * (η x ^ 2 * U a x ^ 2) :=
          mul_le_mul_of_nonneg_right (hη2 x) (by positivity)
        _ = η x ^ 2 * U a x ^ 2 := one_mul _
        _ ≤ η x ^ 2 * ∑ d : Fin 3, U d x ^ 2 := mul_le_mul_of_nonneg_left hUa hη20
    have hq : (2 * η x * dη a x * u x) ^ 2 ≤ 4 * Cη ^ 2 * u x ^ 2 := by
      have h1 : η x ^ 2 * dη a x ^ 2 ≤ 1 * Cη ^ 2 :=
        mul_le_mul (hη2 x) hd2 (sq_nonneg _) zero_le_one
      have h2 := mul_le_mul_of_nonneg_right h1 (show 0 ≤ 4 * u x ^ 2 by positivity)
      calc (2 * η x * dη a x * u x) ^ 2 = η x ^ 2 * dη a x ^ 2 * (4 * u x ^ 2) := by ring
        _ ≤ 1 * Cη ^ 2 * (4 * u x ^ 2) := h2
        _ = 4 * Cη ^ 2 * u x ^ 2 := by ring
    nlinarith [sq_nonneg (η x ^ 2 * U a x - 2 * η x * dη a x * u x)]
  rw [integral_add (hPi.const_mul _) (hu2.const_mul _), integral_const_mul,
    integral_const_mul] at E3
  
  have hR0 := hRm 0
  have hR1 := hRm 1
  have hR2' := hRm 2
  have m1 := mul_le_mul_of_nonneg_left (hQb'.trans E3) (show 0 ≤ lam / 8 by positivity)
  have m2 := mul_le_mul_of_nonneg_left hFm (show 0 ≤ 2 * Y by positivity)
  have m3 := mul_le_mul_of_nonneg_left hum hc₁0
  have m4 := mul_le_mul_of_nonneg_left hum (show 0 ≤ lam * Cη ^ 2 by positivity)
  have m5 := mul_le_mul_of_nonneg_left hR0 hc₂0
  have m6 := mul_le_mul_of_nonneg_left hR1 hc₂0
  have m7 := mul_le_mul_of_nonneg_left hR2' hc₂0
  have habs : lam * ∫ x in S, P x ≤ 12 / 5 * (k * M) := by
    rw [hk]
    linarith [hid']
  have h8 := mul_le_mul_of_nonneg_left habs hY0
  have e9 : Y * (lam * ∫ x in S, P x) = ∫ x in S, P x := by
    linear_combination (∫ x in S, P x) * hlY
  have h10 : 0 ≤ Y * (k * M) := by positivity
  linarith

theorem fcr_dq_memLp (c : E3) (s r : ℝ) (φ : E3 → ℝ) (a : Fin 3) (ha : a ≠ 0) (h : ℝ)
    (hrs : r + |h| ≤ s) (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s))) :
    MemLp (fcrDQ a h φ) 2 (volume.restrict (fcrHalf c r)) :=
by
  have hea0 : (e a) 0 = 0 := by
    simp [e, EuclideanSpace.single_apply, Ne.symm ha]
  have hn : ‖h • e a‖ = |h| := by
    rw [norm_smul]
    simp [e, EuclideanSpace.norm_single]
  have hopen : ∀ ρ, MeasurableSet (fcrHalf c ρ) := fun ρ =>
    (Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)).measurableSet
  have hsub : fcrHalf c r ⊆ (fun x => x + h • e a) ⁻¹' fcrHalf c s := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := hx
    refine ⟨?_, ?_⟩
    · have hx1' : dist x c < r := hx1
      show dist (x + h • e a) c < s
      have hle : dist (x + h • e a) c ≤ dist x c + ‖h • e a‖ := by
        rw [dist_eq_norm, dist_eq_norm]
        calc ‖x + h • e a - c‖ = ‖(x - c) + h • e a‖ := by congr 1; abel
          _ ≤ _ := norm_add_le _ _
      linarith
    · show 0 < (x + h • e a) 0
      have hx2' : 0 < x 0 := hx2
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hea0, mul_zero, add_zero]
      exact hx2'
  have hrs' : fcrHalf c r ⊆ fcrHalf c s := fun x hx =>
    ⟨Metric.ball_subset_ball (by linarith [abs_nonneg h]) hx.1, hx.2⟩
  have hmp : MeasurePreserving (fun x : E3 => x + h • e a) volume volume :=
    measurePreserving_add_right volume (h • e a)
  have hmp' := hmp.restrict_preimage (hopen s)
  have h1 : MemLp (φ ∘ fun x : E3 => x + h • e a) 2
      (volume.restrict ((fun x : E3 => x + h • e a) ⁻¹' fcrHalf c s)) :=
    hφ.comp_measurePreserving hmp'
  have h1' : MemLp (fun x => φ (x + h • e a)) 2 (volume.restrict (fcrHalf c r)) :=
    h1.mono_measure (Measure.restrict_mono hsub le_rfl)
  have h2 : MemLp φ 2 (volume.restrict (fcrHalf c r)) :=
    hφ.mono_measure (Measure.restrict_mono hrs' le_rfl)
  have h3 := (h1'.sub h2).const_mul h⁻¹
  have heq : fcrDQ a h φ = fun x => h⁻¹ * ((fun x => φ (x + h • e a)) - φ) x := by
    funext x
    simp only [fcrDQ, Pi.sub_apply]
    rw [div_eq_inv_mul]
  rw [heq]
  exact h3

theorem fcr_dq_wd (c : E3) (s r : ℝ) (φ ψ : E3 → ℝ) (d a : Fin 3) (ha : a ≠ 0) (h : ℝ)
    (hrs : r + |h| ≤ s) (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s)))
    (hψ : MemLp ψ 2 (volume.restrict (fcrHalf c s))) (hwd : fcrWD c s φ d ψ) :
    fcrWD c r (fcrDQ a h φ) d (fcrDQ a h ψ) :=
by
  have hea0 : (e a) 0 = 0 := by
    simp [e, EuclideanSpace.single_apply, Ne.symm ha]
  have hn : ‖h • e a‖ = |h| := by
    rw [norm_smul]
    simp [e, EuclideanSpace.norm_single]
  obtain ⟨v, hv⟩ : ∃ v : E3, v = h • e a := ⟨_, rfl⟩
  have hnv : ‖v‖ = |h| := by rw [hv]; exact hn
  
  have hshift : ∀ x, x ∈ fcrHalf c r → x + v ∈ fcrHalf c s := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := hx
    refine ⟨?_, ?_⟩
    · have hx1' : dist x c < r := hx1
      show dist (x + v) c < s
      have hle : dist (x + v) c ≤ dist x c + ‖v‖ := by
        rw [dist_eq_norm, dist_eq_norm]
        calc ‖x + v - c‖ = ‖(x - c) + v‖ := by congr 1; abel
          _ ≤ _ := norm_add_le _ _
      linarith
    · show 0 < (x + v) 0
      have hx2' : 0 < x 0 := hx2
      simp only [hv, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hea0, mul_zero, add_zero]
      exact hx2'
  
  have hrs' : fcrHalf c r ⊆ fcrHalf c s := fun x hx =>
    ⟨Metric.ball_subset_ball (by linarith [abs_nonneg h]) hx.1, hx.2⟩
  
  haveI : IsFiniteMeasure (volume.restrict (fcrHalf c s)) :=
    isFiniteMeasure_restrict.2 (ne_top_of_le_ne_top measure_ball_lt_top.ne
      (measure_mono (show fcrHalf c s ⊆ Metric.ball c s from Set.inter_subset_left)))
  have L1 : ∀ f g : E3 → ℝ, MemLp f 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → (∀ x, x ∉ fcrHalf c s → g x = 0) →
      Integrable (fun x => f x * g x) := by
    intro f g hf hg hgc hg0
    have hfi : Integrable f (volume.restrict (fcrHalf c s)) := hf.integrable (by norm_num)
    obtain ⟨C, hC⟩ := hg.bounded_above_of_compact_support hgc
    have h1 : Integrable (fun x => f x * g x) (volume.restrict (fcrHalf c s)) :=
      hfi.mul_bdd hg.aestronglyMeasurable (Filter.Eventually.of_forall hC)
    have hsupp : Function.support (fun x => f x * g x) ⊆ fcrHalf c s := by
      intro x hx
      by_contra hnot
      exact hx (by simp only [hg0 x hnot, mul_zero])
    exact (integrableOn_iff_integrable_of_support_subset hsupp).1 h1
  have hDQ : ∀ (f : E3 → ℝ) (x : E3), fcrDQ a h f x = h⁻¹ * (f (x + v) - f x) := by
    intro f x
    rw [hv]
    simp only [fcrDQ]
    rw [div_eq_inv_mul]
  
  intro ζ hζ hcs hts
  have hts' : tsupport ζ ⊆ fcrHalf c s := hts.trans hrs'
  have hdc : Continuous (partialDeriv d ζ) := by
    unfold partialDeriv
    exact (hζ.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hdcs : HasCompactSupport (partialDeriv d ζ) := HasCompactSupport.fderiv_apply ℝ hcs (e d)
  have hd0 : ∀ x, x ∉ tsupport ζ → partialDeriv d ζ x = 0 := by
    intro x hx
    have h0 : fderiv ℝ ζ x = 0 := by
      by_contra hne
      exact hx (support_fderiv_subset ℝ (Function.mem_support.2 hne))
    simp only [partialDeriv, h0, ContinuousLinearMap.zero_apply]
  have hz0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
  have hoff : ∀ y, y ∉ fcrHalf c s → y - v ∉ tsupport ζ := by
    intro y hy ht
    have h2 := hshift _ (hts ht)
    rw [sub_add_cancel] at h2
    exact hy h2
  
  have hζm : ContDiff ℝ ∞ (fun y => ζ (y - v)) := hζ.comp (contDiff_id.sub contDiff_const)
  have hζm_eq : (fun y => ζ (y - v)) = ζ ∘ (Homeomorph.subRight v) := by
    funext y
    simp only [Function.comp_apply, Homeomorph.subRight_apply]
  have hcsm : HasCompactSupport (fun y => ζ (y - v)) := by
    rw [hζm_eq]; exact hcs.comp_homeomorph _
  have htsm : tsupport (fun y => ζ (y - v)) ⊆ fcrHalf c s := by
    rw [hζm_eq, tsupport_comp_eq_preimage]
    intro y hy
    have h1 : y - v ∈ tsupport ζ := by
      have h3 : (Homeomorph.subRight v) y ∈ tsupport ζ := hy
      rwa [Homeomorph.subRight_apply] at h3
    have h2 := hshift _ (hts h1)
    rwa [sub_add_cancel] at h2
  have hdm : ∀ y, partialDeriv d (fun y => ζ (y - v)) y = partialDeriv d ζ (y - v) := by
    intro y
    simp only [partialDeriv]
    rw [fderiv_comp_sub]
  have hwm := hwd (fun y => ζ (y - v)) hζm hcsm htsm
  simp only [hdm] at hwm
  have hS2 := hwd ζ hζ hcs hts'
  
  have cv1 : ∫ x, φ (x + v) * partialDeriv d ζ x = ∫ y, φ y * partialDeriv d ζ (y - v) := by
    have h1 := integral_add_right_eq_self (μ := volume)
      (fun y => φ y * partialDeriv d ζ (y - v)) v
    simp only [add_sub_cancel_right] at h1
    exact h1
  have cv2 : ∫ x, ψ (x + v) * ζ x = ∫ y, ψ y * ζ (y - v) := by
    have h1 := integral_add_right_eq_self (μ := volume) (fun y => ψ y * ζ (y - v)) v
    simp only [add_sub_cancel_right] at h1
    exact h1
  
  have I2 : Integrable (fun x => φ x * partialDeriv d ζ x) :=
    L1 φ _ hφ hdc hdcs (fun x hx => hd0 x (fun ht => hx (hts' ht)))
  have I4 : Integrable (fun x => ψ x * ζ x) :=
    L1 ψ ζ hψ hζ.continuous hcs (fun x hx => hz0 x (fun ht => hx (hts' ht)))
  have hdm_eq : (fun y => partialDeriv d ζ (y - v)) =
      partialDeriv d ζ ∘ (Homeomorph.subRight v) := by
    funext y
    simp only [Function.comp_apply, Homeomorph.subRight_apply]
  have hdcsm : HasCompactSupport (fun y => partialDeriv d ζ (y - v)) := by
    rw [hdm_eq]; exact hdcs.comp_homeomorph _
  have I1' : Integrable (fun y => φ y * partialDeriv d ζ (y - v)) :=
    L1 φ (fun y => partialDeriv d ζ (y - v)) hφ (hdc.comp (continuous_sub_right v)) hdcsm
      (fun y hy => hd0 _ (hoff y hy))
  have I3' : Integrable (fun y => ψ y * ζ (y - v)) :=
    L1 ψ (fun y => ζ (y - v)) hψ (hζ.continuous.comp (continuous_sub_right v)) hcsm
      (fun y hy => hz0 _ (hoff y hy))
  have I1 : Integrable (fun x => φ (x + v) * partialDeriv d ζ x) := by
    have h1 := I1'.comp_add_right v
    simp only [add_sub_cancel_right] at h1
    exact h1
  have I3 : Integrable (fun x => ψ (x + v) * ζ x) := by
    have h1 := I3'.comp_add_right v
    simp only [add_sub_cancel_right] at h1
    exact h1
  
  have e1 : (fun x => fcrDQ a h φ x * partialDeriv d ζ x) =
      fun x => h⁻¹ * (φ (x + v) * partialDeriv d ζ x - φ x * partialDeriv d ζ x) := by
    funext x; rw [hDQ]; ring
  have e2 : (fun x => fcrDQ a h ψ x * ζ x) =
      fun x => h⁻¹ * (ψ (x + v) * ζ x - ψ x * ζ x) := by
    funext x; rw [hDQ]; ring
  show ∫ x, fcrDQ a h φ x * partialDeriv d ζ x = -∫ x, fcrDQ a h ψ x * ζ x
  rw [e1, e2, integral_const_mul, integral_const_mul, integral_sub I1 I2, integral_sub I3 I4,
    cv1, cv2, hwm, hS2]
  ring

theorem fcr_wd_smul (c : E3) (R s : ℝ) (hsR : s ≤ R) (m : E3 → ℝ)
    (hm : ContDiffOn ℝ ∞ m (Metric.ball c R)) (φ ψ : E3 → ℝ) (a : Fin 3)
    (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s)))
    (hψ : MemLp ψ 2 (volume.restrict (fcrHalf c s))) (hwd : fcrWD c s φ a ψ) :
    fcrWD c s (fun x => m x * φ x) a (fun x => partialDeriv a m x * φ x + m x * ψ x) :=
by
  classical
  have hHsub : fcrHalf c s ⊆ Metric.ball c R :=
    fun x hx => Metric.ball_subset_ball hsR hx.1
  have hpd : ContDiffOn ℝ ∞ (partialDeriv a m) (Metric.ball c R) := by
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ m y (e a)) (Metric.ball c R)
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 hm).2.clm_apply
      contDiffOn_const
  have hpdsupp : ∀ (f : E3 → ℝ) (a : Fin 3),
      Function.support (fun x => partialDeriv a f x) ⊆ tsupport f := by
    intro f a x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply tsupport_fderiv_subset (𝕜 := ℝ)
    apply subset_tsupport
    rw [Function.mem_support]
    intro h
    exact hx (by simp [partialDeriv, h])
  have htest : ∀ m' : E3 → ℝ, ContDiffOn ℝ ∞ m' (Metric.ball c R) →
      ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ fcrHalf c s →
      ContDiff ℝ ∞ (fun x => m' x * ζ x) ∧ HasCompactSupport (fun x => m' x * ζ x) ∧
      tsupport (fun x => m' x * ζ x) ⊆ fcrHalf c s ∧
      ∀ (a : Fin 3) (x : E3), partialDeriv a (fun y => m' y * ζ y) x =
        partialDeriv a m' x * ζ x + m' x * partialDeriv a ζ x := by
    intro m' hm' ζ hζ hζc hζs
    have hoff : ∀ x, x ∉ Metric.ball c R → ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      have h := notMem_tsupport_iff_eventuallyEq.1 (fun h => hx (hHsub (hζs h)))
      filter_upwards [h] with y hy
      simpa using hy
    have hoff2 : ∀ x, x ∉ Metric.ball c R →
        (fun y => m' y * ζ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      filter_upwards [hoff x hx] with y hy
      simp [hy]
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [contDiff_iff_contDiffAt]
      intro x
      by_cases hx : x ∈ Metric.ball c R
      · exact (hm'.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).mul hζ.contDiffAt
      · exact contDiffAt_const.congr_of_eventuallyEq (hoff2 x hx)
    · exact hζc.mul_left
    · exact (tsupport_mul_subset_right).trans hζs
    · intro a x
      by_cases hx : x ∈ Metric.ball c R
      · have hmd : DifferentiableAt ℝ m' x :=
          (hm'.differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hx)
        have hζd : DifferentiableAt ℝ ζ x := hζ.differentiable (by simp) x
        unfold partialDeriv
        rw [fderiv_fun_mul hmd hζd]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have h1 : partialDeriv a (fun y => m' y * ζ y) x = 0 := by
          unfold partialDeriv
          rw [(hoff2 x hx).fderiv_eq]
          simp
        have h2 : partialDeriv a ζ x = 0 := by
          unfold partialDeriv
          rw [(hoff x hx).fderiv_eq]
          simp
        have h3 : ζ x = 0 := (hoff x hx).eq_of_nhds
        rw [h1, h2, h3]
        ring
  have hint : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → Function.support g ⊆ fcrHalf c s →
      Integrable (fun x => u x * g x) := by
    intro u g hu hg hgc hgs
    have hg2 : MemLp g 2 (volume.restrict (fcrHalf c s)) :=
      (hg.memLp_of_hasCompactSupport hgc).restrict _
    have h1 : Integrable (fun x => u x * g x) (volume.restrict (fcrHalf c s)) :=
      hu.integrable_mul hg2
    refine (integrableOn_iff_integrable_of_support_subset ?_).1 h1
    intro x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply hgs
    rw [Function.mem_support]
    intro h
    exact hx (by simp [h])
  intro ζ hζ hζc hζs
  obtain ⟨hη, hηc, hηs, hprod⟩ := htest m hm ζ hζ hζc hζs
  obtain ⟨hξ, hξc, -, -⟩ := htest (partialDeriv a m) hpd ζ hζ hζc hζs
  have h0 : ∫ x, φ x * partialDeriv a (fun y => m y * ζ y) x =
      -∫ x, ψ x * (m x * ζ x) := hwd _ hη hηc hηs
  have hsuppζ : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
  have i1 : Integrable (fun x => φ x * partialDeriv a (fun y => m y * ζ y) x) := by
    refine hint φ _ hφ ?_ ?_ ?_
    · exact (hη.continuous_fderiv (by simp)).clm_apply continuous_const
    · exact hηc.mono' (hpdsupp _ a)
    · exact (hpdsupp _ a).trans hηs
  have i2 : Integrable (fun x => φ x * (partialDeriv a m x * ζ x)) := by
    refine hint φ _ hφ hξ.continuous hξc ?_
    intro x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply hsuppζ
    rw [Function.mem_support]
    intro h
    exact hx (by simp [h])
  have i3 : Integrable (fun x => ψ x * (m x * ζ x)) :=
    hint ψ _ hψ hη.continuous hηc ((subset_tsupport _).trans hηs)
  have e1 : (fun x => m x * φ x * partialDeriv a ζ x) =
      fun x => φ x * partialDeriv a (fun y => m y * ζ y) x -
        φ x * (partialDeriv a m x * ζ x) := by
    funext x
    rw [hprod a x]
    ring
  have e2 : (fun x => (partialDeriv a m x * φ x + m x * ψ x) * ζ x) =
      fun x => φ x * (partialDeriv a m x * ζ x) + ψ x * (m x * ζ x) := by
    funext x
    ring
  show ∫ x, m x * φ x * partialDeriv a ζ x =
    -∫ x, (partialDeriv a m x * φ x + m x * ψ x) * ζ x
  rw [e1, e2, integral_sub i1 i2, integral_add i2 i3, h0]
  ring

theorem fcr_discrete_ibp (c : E3) (s r : ℝ) (f g : E3 → ℝ) (a : Fin 3) (ha : a ≠ 0) (h : ℝ)
    (hrs : r + |h| < s) (hf : MemLp f 2 (volume.restrict (fcrHalf c s)))
    (hg : MemLp g 2 (volume.restrict (fcrHalf c s)))
    (hg0 : ∀ x, x ∉ Metric.ball c r → g x = 0) :
    ∫ x in fcrHalf c s, f x * fcrDQ a (-h) g x = -∫ x in fcrHalf c s, fcrDQ a h f x * g x :=
by
  classical
  set H := fcrHalf c s with hHdef
  have hH : MeasurableSet H := by
    have hopen : IsOpen H := Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
    exact hopen.measurableSet
  set v : E3 := h • e a with hv
  set w : E3 := (-h) • e a with hw
  have hvw : ∀ x : E3, x + w + v = x := by
    intro x
    rw [hv, hw, add_assoc, ← add_smul, neg_add_cancel, zero_smul, add_zero]
  have hwv : ∀ x : E3, x + v + w = x := by
    intro x
    rw [hv, hw, add_assoc, ← add_smul, add_neg_cancel, zero_smul, add_zero]
  have hcoord : ∀ x : E3, (x + v) 0 = x 0 := by
    intro x
    simp [hv, EuclideanSpace.single_apply, Ne.symm ha]
  have hnv : ‖v‖ = |h| := by
    simp [hv, norm_smul, EuclideanSpace.norm_single]
  
  have hshift : ∀ x ∈ Metric.ball c r, (x + v ∈ H ↔ x ∈ H) := by
    intro x hx
    have hx' : dist x c < r := hx
    have h1 : dist x c < s := by linarith [abs_nonneg h]
    have h2 : dist (x + v) c < s := by
      have hle : dist (x + v) c ≤ dist x c + ‖v‖ := by
        rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]
        exact norm_add_le _ _
      linarith
    simp only [hHdef, fcrHalf, Set.mem_inter_iff, Metric.mem_ball, Set.mem_setOf_eq, hcoord]
    exact ⟨fun h' => ⟨h1, h'.2⟩, fun h' => ⟨h2, h'.2⟩⟩
  
  have hL : ∀ x, f x * fcrDQ a (-h) g x = (f x * g x - f x * g (x + w)) / h := by
    intro x
    simp only [fcrDQ, hw]
    rw [div_neg]
    ring
  have hR : ∀ x, fcrDQ a h f x * g x = (f (x + v) * g x - f x * g x) / h := by
    intro x
    simp only [fcrDQ, hv]
    ring
  
  have hF : MemLp (H.indicator f) 2 volume := (memLp_indicator_iff_restrict hH).mpr hf
  have hG : MemLp (H.indicator g) 2 volume := (memLp_indicator_iff_restrict hH).mpr hg
  have hGw : MemLp (fun y => H.indicator g (y + w)) 2 volume :=
    hG.comp_measurePreserving (measurePreserving_add_right volume w)
  have hQint : Integrable (fun y => H.indicator f y * H.indicator g (y + w)) volume :=
    hF.integrable_mul hGw
  have hQeq : ∀ y, H.indicator (fun y => f y * g (y + w)) y =
      H.indicator f y * H.indicator g (y + w) := by
    intro y
    by_cases hy : y ∈ H
    · by_cases hg' : g (y + w) = 0
      · by_cases hm : y + w ∈ H
        · simp [Set.indicator_apply, hy, hm, hg']
        · simp [Set.indicator_apply, hy, hm, hg']
      · have hb : y + w ∈ Metric.ball c r := by
          by_contra hb
          exact hg' (hg0 _ hb)
        have hm : y + w ∈ H := by
          have hi := hshift (y + w) hb
          rw [hvw] at hi
          exact hi.mp hy
        simp [Set.indicator_apply, hy, hm]
    · simp [Set.indicator_apply, hy]
  have hQ : Integrable (H.indicator (fun y => f y * g (y + w))) volume := by
    have e0 : H.indicator (fun y => f y * g (y + w)) =
        fun y => H.indicator f y * H.indicator g (y + w) := funext hQeq
    rw [e0]
    exact hQint
  have hQ'eq : ∀ x, H.indicator (fun x => f (x + v) * g x) x =
      H.indicator (fun y => f y * g (y + w)) (x + v) := by
    intro x
    by_cases hgx : g x = 0
    · simp [Set.indicator_apply, hgx, hwv]
    · have hb : x ∈ Metric.ball c r := by
        by_contra hb
        exact hgx (hg0 _ hb)
      have hiff := hshift x hb
      by_cases hx : x ∈ H
      · have hx' : x + v ∈ H := hiff.mpr hx
        simp [Set.indicator_apply, hx, hx', hwv]
      · have hx' : x + v ∉ H := fun h' => hx (hiff.mp h')
        simp [Set.indicator_apply, hx, hx']
  have hQ' : Integrable (H.indicator (fun x => f (x + v) * g x)) volume := by
    have e0 : H.indicator (fun x => f (x + v) * g x) =
        fun x => H.indicator (fun y => f y * g (y + w)) (x + v) := funext hQ'eq
    rw [e0]
    exact hQ.comp_add_right v
  have hPon : Integrable (fun x => f x * g x) (volume.restrict H) := hf.integrable_mul hg
  have hQon : Integrable (fun y => f y * g (y + w)) (volume.restrict H) :=
    (integrable_indicator_iff hH).mp hQ
  have hQ'on : Integrable (fun x => f (x + v) * g x) (volume.restrict H) :=
    (integrable_indicator_iff hH).mp hQ'
  
  have hshiftInt : ∫ x in H, f (x + v) * g x = ∫ y in H, f y * g (y + w) := by
    rw [← integral_indicator hH, ← integral_indicator hH]
    calc ∫ x, H.indicator (fun x => f (x + v) * g x) x
        = ∫ x, H.indicator (fun y => f y * g (y + w)) (x + v) := by
          congr 1
          funext x
          exact hQ'eq x
      _ = ∫ y, H.indicator (fun y => f y * g (y + w)) y := integral_add_right_eq_self _ v
  have e1 : ∫ x in H, f x * fcrDQ a (-h) g x =
      ((∫ x in H, f x * g x) - ∫ x in H, f x * g (x + w)) / h := by
    simp_rw [hL]
    rw [integral_div, integral_sub hPon hQon]
  have e2 : ∫ x in H, fcrDQ a h f x * g x =
      ((∫ x in H, f (x + v) * g x) - ∫ x in H, f x * g x) / h := by
    simp_rw [hR]
    rw [integral_div, integral_sub hQ'on hPon]
  rw [e1, e2, hshiftInt]
  ring

theorem fcr_moll_deriv (c : E3) (ρ : ℝ) (k : ℕ) (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
    (hD : fcrSob c ρ k w D) (b : ContDiffBump (0 : E3)) :
    (∀ L : List (Fin 3), ContDiff ℝ ∞ (L.foldr partialDeriv (fcrMoll b ((fcrHalf c ρ).indicator w)))) ∧
    ∀ L : List (Fin 3), L.length ≤ k → ∀ x : E3, -b.rOut < x 0 →
      x ∈ Metric.ball c (ρ - 3 * b.rOut) →
      L.foldr partialDeriv (fcrMoll b ((fcrHalf c ρ).indicator w)) x =
        fcrMoll b ((fcrHalf c ρ).indicator (D L)) x :=
by
  classical
  
  have hφs : ContDiff ℝ ∞ (b.normed volume) := b.contDiff_normed (n := ⊤)
  have hφd : ∀ y, HasFDerivAt (b.normed volume) (fderiv ℝ (b.normed volume) y) y :=
    fun y => ((hφs.differentiable (by simp)) y).hasFDerivAt
  have hφdc : Continuous (fderiv ℝ (b.normed volume)) := hφs.continuous_fderiv (by simp)
  obtain ⟨C₁, hC₁⟩ : ∃ C, ∀ y, ‖fderiv ℝ (b.normed volume) y‖ ≤ C :=
    ((b.hasCompactSupport_normed (μ := volume)).fderiv ℝ).exists_bound_of_continuous hφdc
  obtain ⟨C₀, hC₀⟩ : ∃ C, ∀ y, ‖b.normed volume y‖ ≤ C :=
    (b.hasCompactSupport_normed (μ := volume)).exists_bound_of_continuous b.continuous_normed
  
  have hmollC : ∀ f : E3 → ℝ, Integrable f → ContDiff ℝ ∞ (fcrMoll b f) := by
    intro f hf
    have heq : fcrMoll b f = (fun y => convolution (b.normed volume) f
        (ContinuousLinearMap.mul ℝ ℝ) volume y) ∘ (fun x => x + (2 * b.rOut) • e 0) := by
      funext x
      show fcrMoll b f x = convolution (b.normed volume) f (ContinuousLinearMap.mul ℝ ℝ) volume
        (x + (2 * b.rOut) • e 0)
      rw [convolution_mul_swap]
      rfl
    rw [heq]
    exact ((b.hasCompactSupport_normed (μ := volume)).contDiff_convolution_left
      (ContinuousLinearMap.mul ℝ ℝ) (b.contDiff_normed (n := ⊤)) hf.locallyIntegrable).comp
      (contDiff_id.add contDiff_const)
  
  have hpdC : ∀ (a : Fin 3) (G : E3 → ℝ), ContDiff ℝ ∞ G → ContDiff ℝ ∞ (partialDeriv a G) := by
    intro a G hG
    show ContDiff ℝ ∞ (fun y => fderiv ℝ G y (e a))
    exact (contDiff_infty_iff_fderiv.mp hG).2.clm_apply contDiff_const
  
  have hpd : ∀ f : E3 → ℝ, Integrable f → ∀ (a : Fin 3) (x : E3),
      partialDeriv a (fcrMoll b f) x =
        ∫ t, partialDeriv a (b.normed volume) (x + (2 * b.rOut) • e 0 - t) * f t := by
    intro f hf a x
    have hF'meas : ∀ y : E3, AEStronglyMeasurable
        (fun t => f t • fderiv ℝ (b.normed volume) (y + (2 * b.rOut) • e 0 - t)) volume := by
      intro y
      exact hf.aestronglyMeasurable.smul
        (hφdc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    have hFmeas : ∀ y : E3, AEStronglyMeasurable
        (fun t => b.normed volume (y + (2 * b.rOut) • e 0 - t) * f t) volume := by
      intro y
      exact (b.continuous_normed.comp (continuous_const.sub continuous_id)).aestronglyMeasurable.mul
        hf.aestronglyMeasurable
    have hFint : Integrable (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t) * f t) volume :=
      hf.bdd_mul (b.continuous_normed.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
        (Filter.Eventually.of_forall fun t => hC₀ _)
    have hbound : ∀ y t, ‖f t • fderiv ℝ (b.normed volume) (y + (2 * b.rOut) • e 0 - t)‖
        ≤ C₁ * ‖f t‖ := by
      intro y t
      rw [norm_smul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hC₁ _) (norm_nonneg _)
    have hderiv : ∀ t y, HasFDerivAt (fun y => b.normed volume (y + (2 * b.rOut) • e 0 - t) * f t)
        (f t • fderiv ℝ (b.normed volume) (y + (2 * b.rOut) • e 0 - t)) y := by
      intro t y
      have h1 : HasFDerivAt (fun y : E3 => y + (2 * b.rOut) • e 0 - t)
          (ContinuousLinearMap.id ℝ E3) y :=
        ((hasFDerivAt_id y).add_const _).sub_const _
      have h2 : HasFDerivAt ((b.normed volume) ∘ (fun y : E3 => y + (2 * b.rOut) • e 0 - t))
          ((fderiv ℝ (b.normed volume) (y + (2 * b.rOut) • e 0 - t)).comp
            (ContinuousLinearMap.id ℝ E3)) y :=
        HasFDerivAt.comp y (hφd (y + (2 * b.rOut) • e 0 - t)) h1
      rw [ContinuousLinearMap.comp_id] at h2
      exact h2.mul_const (f t)
    have hmain := hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume) (s := Set.univ)
      (x₀ := x)
      (F := fun y t => b.normed volume (y + (2 * b.rOut) • e 0 - t) * f t)
      (F' := fun y t => f t • fderiv ℝ (b.normed volume) (y + (2 * b.rOut) • e 0 - t))
      (bound := fun t => C₁ * ‖f t‖)
      Filter.univ_mem (Filter.Eventually.of_forall hFmeas) hFint (hF'meas x)
      (Filter.Eventually.of_forall fun t y _ => hbound y t) (hf.norm.const_mul C₁)
      (Filter.Eventually.of_forall fun t y _ => hderiv t y)
    have hF'int : Integrable
        (fun t => f t • fderiv ℝ (b.normed volume) (x + (2 * b.rOut) • e 0 - t)) volume :=
      (hf.norm.const_mul C₁).mono' (hF'meas x) (Filter.Eventually.of_forall fun t => hbound x t)
    have hfe : fcrMoll b f = fun y => ∫ t, b.normed volume (y + (2 * b.rOut) • e 0 - t) * f t := rfl
    show fderiv ℝ (fcrMoll b f) x (e a) = _
    rw [hfe, hmain.fderiv, ContinuousLinearMap.integral_apply hF'int]
    congr 1
    funext t
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    unfold partialDeriv
    ring
  
  have hker : ∀ p : E3, ContDiff ℝ ∞ (fun t => b.normed volume (p - t)) ∧
      HasCompactSupport (fun t => b.normed volume (p - t)) ∧
      tsupport (fun t => b.normed volume (p - t)) ⊆ Metric.closedBall p b.rOut ∧
      ∀ (a : Fin 3) (t : E3), partialDeriv a (fun t => b.normed volume (p - t)) t =
        -partialDeriv a (b.normed volume) (p - t) := by
    intro p
    have hsupp : Function.support (fun t => b.normed volume (p - t)) ⊆ Metric.ball p b.rOut := by
      intro t ht
      have h : p - t ∈ Function.support (b.normed volume) := ht
      rw [b.support_normed_eq] at h
      rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev]
      rwa [Metric.mem_ball, dist_eq_norm, sub_zero] at h
    have hts : tsupport (fun t => b.normed volume (p - t)) ⊆ Metric.closedBall p b.rOut :=
      closure_minimal (hsupp.trans Metric.ball_subset_closedBall) Metric.isClosed_closedBall
    refine ⟨hφs.comp (contDiff_const.sub contDiff_id), ?_, hts, ?_⟩
    · exact (isCompact_closedBall p b.rOut).of_isClosed_subset (isClosed_tsupport _) hts
    · intro a t
      have h1 : HasFDerivAt (fun t : E3 => p - t) (-ContinuousLinearMap.id ℝ E3) t :=
        (hasFDerivAt_id t).const_sub p
      have h3 : HasFDerivAt (fun t => b.normed volume (p - t))
          ((fderiv ℝ (b.normed volume) (p - t)).comp (-ContinuousLinearMap.id ℝ E3)) t :=
        (hφd (p - t)).comp t h1
      show fderiv ℝ (fun t => b.normed volume (p - t)) t (e a) =
        -fderiv ℝ (b.normed volume) (p - t) (e a)
      rw [h3.fderiv]
      simp
  
  have hgeo : ∀ x : E3, -b.rOut < x 0 → x ∈ Metric.ball c (ρ - 3 * b.rOut) →
      Metric.closedBall (x + (2 * b.rOut) • e 0) b.rOut ⊆ fcrHalf c ρ := by
    intro x hx0 hxc t ht
    have hr := b.rOut_pos
    rw [Metric.mem_closedBall] at ht
    have hcoord : |t 0 - x 0 - 2 * b.rOut| ≤ b.rOut := by
      have h := PiLp.norm_apply_le (t - (x + (2 * b.rOut) • e 0)) 0
      rw [← dist_eq_norm] at h
      have h' : (t - (x + (2 * b.rOut) • e 0)).ofLp 0 = t 0 - x 0 - 2 * b.rOut := by
        simp [EuclideanSpace.single_apply, sub_sub]
      rw [h', Real.norm_eq_abs] at h
      linarith
    have hpx : dist (x + (2 * b.rOut) • e 0) x = 2 * b.rOut := by
      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, EuclideanSpace.norm_single, norm_one,
        mul_one, Real.norm_eq_abs, abs_of_pos (by linarith)]
    have hxc' := Metric.mem_ball.mp hxc
    show t ∈ Metric.ball c ρ ∩ {x : E3 | 0 < x 0}
    refine ⟨?_, ?_⟩
    · rw [Metric.mem_ball]
      have h1 := dist_triangle t (x + (2 * b.rOut) • e 0) c
      have h2 := dist_triangle (x + (2 * b.rOut) • e 0) x c
      linarith
    · show 0 < t 0
      linarith [(abs_le.mp hcoord).1]
  
  have hHo : IsOpen (fcrHalf c ρ) := Metric.isOpen_ball.inter
    (isOpen_lt continuous_const (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hHm : MeasurableSet (fcrHalf c ρ) := hHo.measurableSet
  have hHsub : fcrHalf c ρ ⊆ Metric.ball c ρ := fun x hx => hx.1
  have hHfin : volume (fcrHalf c ρ) ≠ ⊤ :=
    ((measure_mono hHsub).trans_lt measure_ball_lt_top).ne
  haveI : IsFiniteMeasure (volume.restrict (fcrHalf c ρ)) := isFiniteMeasure_restrict.mpr hHfin
  have hint : ∀ L : List (Fin 3), L.length ≤ k → Integrable ((fcrHalf c ρ).indicator (D L)) := by
    intro L hL
    exact (integrable_indicator_iff hHm).mpr ((hD.2.1 L hL).integrable (by norm_num))
  have hw : Integrable ((fcrHalf c ρ).indicator w) := by
    have h := hint [] (by simp)
    rwa [hD.1] at h
  
  have hstep : ∀ (L : List (Fin 3)) (a : Fin 3), L.length < k → ∀ x : E3, -b.rOut < x 0 →
      x ∈ Metric.ball c (ρ - 3 * b.rOut) →
      partialDeriv a (fcrMoll b ((fcrHalf c ρ).indicator (D L))) x =
        fcrMoll b ((fcrHalf c ρ).indicator (D (a :: L))) x := by
    intro L a hL x hx0 hxc
    obtain ⟨hζs, hζc, hζt, hζd⟩ := hker (x + (2 * b.rOut) • e 0)
    have hζH := hζt.trans (hgeo x hx0 hxc)
    have hvan : ∀ t, t ∉ fcrHalf c ρ → b.normed volume (x + (2 * b.rOut) • e 0 - t) = 0 ∧
        partialDeriv a (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t)) t = 0 := by
      intro t ht
      have ht' : t ∉ tsupport (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t)) :=
        fun h => ht (hζH h)
      refine ⟨image_eq_zero_of_notMem_tsupport (f := fun t =>
        b.normed volume (x + (2 * b.rOut) • e 0 - t)) ht', ?_⟩
      have h2 : t ∉ tsupport (fderiv ℝ (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t))) :=
        fun h => ht' (tsupport_fderiv_subset ℝ h)
      show fderiv ℝ (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t)) t (e a) = 0
      rw [image_eq_zero_of_notMem_tsupport h2, ContinuousLinearMap.zero_apply]
    have hweak := hD.2.2 L a hL _ hζs hζc hζH
    rw [hpd _ (hint L hL.le) a x]
    calc ∫ t, partialDeriv a (b.normed volume) (x + (2 * b.rOut) • e 0 - t) *
          (fcrHalf c ρ).indicator (D L) t
        = ∫ t, -(D L t * partialDeriv a
            (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t)) t) := by
          congr 1
          funext t
          by_cases ht : t ∈ fcrHalf c ρ
          · rw [Set.indicator_of_mem ht, hζd]
            ring
          · rw [Set.indicator_of_notMem ht, (hvan t ht).2]
            ring
      _ = -∫ t, D L t * partialDeriv a
            (fun t => b.normed volume (x + (2 * b.rOut) • e 0 - t)) t := integral_neg _
      _ = ∫ t, D (a :: L) t * b.normed volume (x + (2 * b.rOut) • e 0 - t) := by
          rw [hweak, neg_neg]
      _ = fcrMoll b ((fcrHalf c ρ).indicator (D (a :: L))) x := by
          unfold fcrMoll
          congr 1
          funext t
          by_cases ht : t ∈ fcrHalf c ρ
          · rw [Set.indicator_of_mem ht]
            ring
          · rw [Set.indicator_of_notMem ht, (hvan t ht).1]
            ring
  
  refine ⟨?_, ?_⟩
  · intro L
    induction L with
    | nil => exact hmollC _ hw
    | cons a L ih => exact hpdC a _ ih
  · have hU : IsOpen ({x : E3 | -b.rOut < x 0} ∩ Metric.ball c (ρ - 3 * b.rOut)) :=
      (isOpen_lt continuous_const
        (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous).inter Metric.isOpen_ball
    intro L
    induction L with
    | nil =>
      intro _ x _ _
      simp only [List.foldr_nil]
      rw [hD.1]
    | cons a L ih =>
      intro hL x hx0 hxc
      have hL' : L.length < k := by
        simp only [List.length_cons] at hL
        omega
      have hev : L.foldr partialDeriv (fcrMoll b ((fcrHalf c ρ).indicator w)) =ᶠ[𝓝 x]
          fcrMoll b ((fcrHalf c ρ).indicator (D L)) := by
        filter_upwards [hU.mem_nhds ⟨hx0, hxc⟩] with y hy
        exact ih hL'.le y hy.1 hy.2
      rw [List.foldr_cons]
      show fderiv ℝ (L.foldr partialDeriv (fcrMoll b ((fcrHalf c ρ).indicator w))) x (e a) = _
      rw [hev.fderiv_eq]
      exact hstep L a hL' x hx0 hxc

theorem fcr_moll_L2 (b : ContDiffBump (0 : E3)) (f : E3 → ℝ) (hf : MemLp f 2 volume) (S : Set E3) :
    ∫ x in S, (fcrMoll b f x) ^ 2 ≤ ∫ x, (f x) ^ 2 :=
by
  set φ : E3 → ℝ := b.normed volume with hφdef
  set a : E3 := (2 * b.rOut) • e 0 with hadef
  have hφ0 : ∀ y, 0 ≤ φ y := fun y => b.nonneg_normed y
  have hφint : Integrable φ volume := b.integrable_normed
  have hφ1 : ∫ y, φ y = 1 := b.integral_normed
  have hφc : Continuous φ := b.continuous_normed
  obtain ⟨C, hC⟩ := b.hasCompactSupport_normed.exists_bound_of_continuous hφc
  have hf2 : Integrable (fun t => f t ^ 2) volume := hf.integrable_sq
  
  have hpt : ∀ x, (fcrMoll b f x) ^ 2 ≤ ∫ t, φ (x + a - t) * f t ^ 2 := by
    intro x
    have hk : Integrable (fun t => φ (x + a - t)) volume := hφint.comp_sub_left (x + a)
    have hk1 : ∫ t, φ (x + a - t) = 1 := by
      rw [integral_sub_left_eq_self φ volume (x + a)]
      exact hφ1
    have hkm : AEStronglyMeasurable (fun t => φ (x + a - t)) volume :=
      (hφc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    have hkf2 : Integrable (fun t => φ (x + a - t) * f t ^ 2) volume :=
      hf2.bdd_mul hkm (ae_of_all _ (fun t => hC _))
    have hkf : Integrable (fun t => φ (x + a - t) * f t) volume := by
      refine (hk.add hkf2).mono' (hkm.mul hf.aestronglyMeasurable) (ae_of_all _ (fun t => ?_))
      show ‖φ (x + a - t) * f t‖ ≤ φ (x + a - t) + φ (x + a - t) * f t ^ 2
      have h0 := hφ0 (x + a - t)
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg h0]
      have h1 : |f t| ≤ 1 + f t ^ 2 := by nlinarith [abs_nonneg (f t), sq_abs (f t)]
      calc φ (x + a - t) * |f t| ≤ φ (x + a - t) * (1 + f t ^ 2) :=
            mul_le_mul_of_nonneg_left h1 h0
        _ = φ (x + a - t) + φ (x + a - t) * f t ^ 2 := by ring
    have hmdef : fcrMoll b f x = ∫ t, φ (x + a - t) * f t := rfl
    have hnn : 0 ≤ ∫ t, φ (x + a - t) * (f t - fcrMoll b f x) ^ 2 :=
      integral_nonneg (fun t => mul_nonneg (hφ0 _) (sq_nonneg _))
    have hexp : ∫ t, φ (x + a - t) * (f t - fcrMoll b f x) ^ 2 =
        (∫ t, φ (x + a - t) * f t ^ 2) - 2 * fcrMoll b f x * (∫ t, φ (x + a - t) * f t)
          + fcrMoll b f x ^ 2 * ∫ t, φ (x + a - t) := by
      have e : (fun t => φ (x + a - t) * (f t - fcrMoll b f x) ^ 2) = fun t =>
          (φ (x + a - t) * f t ^ 2 - (2 * fcrMoll b f x) * (φ (x + a - t) * f t))
            + fcrMoll b f x ^ 2 * φ (x + a - t) := by
        funext t; ring
      have i1 : Integrable (fun t => φ (x + a - t) * f t ^ 2
          - (2 * fcrMoll b f x) * (φ (x + a - t) * f t)) volume := hkf2.sub (hkf.const_mul _)
      have i2 : Integrable (fun t => fcrMoll b f x ^ 2 * φ (x + a - t)) volume := hk.const_mul _
      have i3 : Integrable (fun t => (2 * fcrMoll b f x) * (φ (x + a - t) * f t)) volume :=
        hkf.const_mul _
      rw [e, integral_add i1 i2, integral_sub hkf2 i3, integral_const_mul, integral_const_mul]
    rw [hexp, hk1, ← hmdef] at hnn
    nlinarith
  
  have hconv : ∀ y, convolution (fun t => f t ^ 2) φ (ContinuousLinearMap.mul ℝ ℝ) volume y =
      ∫ t, φ (y - t) * f t ^ 2 := by
    intro y
    rw [convolution_def]
    congr 1
    funext t
    simp only [ContinuousLinearMap.mul_apply']
    ring
  have hKint : Integrable
      (convolution (fun t => f t ^ 2) φ (ContinuousLinearMap.mul ℝ ℝ) volume) volume :=
    hf2.integrable_convolution _ hφint
  have hN : Integrable (fun x => ∫ t, φ (x + a - t) * f t ^ 2) volume := by
    refine (hKint.comp_add_right a).congr (ae_of_all _ (fun x => ?_))
    exact hconv (x + a)
  have hNval : ∫ x, (∫ t, φ (x + a - t) * f t ^ 2) = ∫ x, f x ^ 2 := by
    have h1 : (fun x => ∫ t, φ (x + a - t) * f t ^ 2) = fun x =>
        convolution (fun t => f t ^ 2) φ (ContinuousLinearMap.mul ℝ ℝ) volume (x + a) :=
      funext fun x => (hconv (x + a)).symm
    rw [h1, integral_add_right_eq_self
      (fun y => convolution (fun t => f t ^ 2) φ (ContinuousLinearMap.mul ℝ ℝ) volume y) a,
      integral_convolution _ hf2 hφint, hφ1, ContinuousLinearMap.mul_apply', mul_one]
  
  have hNnn : ∀ x, 0 ≤ ∫ t, φ (x + a - t) * f t ^ 2 :=
    fun x => integral_nonneg (fun t => mul_nonneg (hφ0 _) (sq_nonneg _))
  calc ∫ x in S, (fcrMoll b f x) ^ 2 ≤ ∫ x in S, (∫ t, φ (x + a - t) * f t ^ 2) :=
        integral_mono_of_nonneg (ae_of_all _ (fun x => sq_nonneg _)) hN.restrict (ae_of_all _ hpt)
    _ ≤ ∫ x, (∫ t, φ (x + a - t) * f t ^ 2) := setIntegral_le_integral hN (ae_of_all _ hNnn)
    _ = ∫ x, (f x) ^ 2 := hNval

theorem fcr_moll_weak_limit (g : E3 → ℝ) (hg : Integrable g) (ψ : E3 → ℝ) (hψ : Continuous ψ)
    (hψc : HasCompactSupport ψ) (b : ℕ → ContDiffBump (0 : E3))
    (hb : Tendsto (fun j => (b j).rOut) atTop (𝓝 0)) :
    Tendsto (fun j => ∫ x, fcrMoll (b j) g x * ψ x) atTop (𝓝 (∫ x, g x * ψ x)) :=
by
  
  
  have hadj : ∀ (bb : ContDiffBump (0 : E3)) (k : E3 → ℝ), Continuous k → HasCompactSupport k →
      ∫ x, MeasureTheory.convolution (bb.normed MeasureTheory.volume) g
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume x * k x =
        ∫ y, g y * MeasureTheory.convolution (bb.normed MeasureTheory.volume) k
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume y := by
    intro bb k hk hkc
    have hφi : MeasureTheory.Integrable
        (bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3)) :=
      bb.integrable_normed
    have hconv : ∀ (u : E3 → ℝ) (x : E3),
        MeasureTheory.convolution (bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3)) u
            (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume x =
          ∫ t, bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (x - t) * u t := by
      intro u x
      rw [MeasureTheory.convolution_lsmul_swap]
      rfl
    obtain ⟨C, hC⟩ := hk.bounded_above_of_compact_support hkc
    have hint0 : MeasureTheory.Integrable
        (fun p : E3 × E3 =>
          g p.2 * bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (p.1 - p.2))
        ((MeasureTheory.volume : MeasureTheory.Measure E3).prod MeasureTheory.volume) := by
      have := hg.convolution_integrand (ContinuousLinearMap.lsmul ℝ ℝ) hφi
        (μ := MeasureTheory.volume) (ν := MeasureTheory.volume)
      simpa using this
    have hint : MeasureTheory.Integrable
        (Function.uncurry fun x t =>
          g t * bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (x - t) * k x)
        ((MeasureTheory.volume : MeasureTheory.Measure E3).prod MeasureTheory.volume) := by
      have := hint0.mul_bdd (c := C) (hk.comp continuous_fst).aestronglyMeasurable
        (Filter.Eventually.of_forall fun p => hC p.1)
      exact this
    calc ∫ x, MeasureTheory.convolution (bb.normed MeasureTheory.volume) g
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume x * k x
        = ∫ x, ∫ t, g t * bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (x - t)
            * k x := by
          congr 1; funext x; rw [hconv, ← MeasureTheory.integral_mul_const]; congr 1; funext t
          ring
      _ = ∫ t, ∫ x, g t * bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (x - t)
            * k x :=
          MeasureTheory.integral_integral_swap hint
      _ = ∫ t, g t * MeasureTheory.convolution (bb.normed MeasureTheory.volume) k
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume t := by
          congr 1; funext t; rw [hconv, ← MeasureTheory.integral_const_mul]; congr 1; funext x
          rw [show bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (t - x) =
              bb.normed (MeasureTheory.volume : MeasureTheory.Measure E3) (x - t) by
            rw [← neg_sub, bb.normed_neg]]
          ring
  
  obtain ⟨C, hC⟩ := hψc.exists_bound_of_continuous hψ
  
  obtain ⟨K, hK⟩ : ∃ K : ℕ → E3 → ℝ, ∀ j z, K j z = ψ (z - (2 * (b j).rOut) • e 0) :=
    ⟨fun j z => ψ (z - (2 * (b j).rOut) • e 0), fun _ _ => rfl⟩
  have hKfun : ∀ j, K j = fun z => ψ (z - (2 * (b j).rOut) • e 0) := fun j => funext (hK j)
  have hKc : ∀ j, Continuous (K j) := by
    intro j
    rw [hKfun j]
    exact hψ.comp (continuous_id.sub continuous_const)
  have hKcs : ∀ j, HasCompactSupport (K j) := by
    intro j
    have h := hψc.comp_homeomorph (Homeomorph.subRight ((2 * (b j).rOut) • e 0))
    have hfun : K j = ψ ∘ ⇑(Homeomorph.subRight ((2 * (b j).rOut) • e 0)) := by
      funext z
      rw [hK j z]
      simp [Homeomorph.subRight_apply]
    rw [hfun]
    exact h
  have hKb : ∀ j z, |K j z| ≤ C := by
    intro j z
    rw [hK j z]
    have h := hC (z - (2 * (b j).rOut) • e 0)
    rwa [Real.norm_eq_abs] at h
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℕ → E3 → ℝ, ∀ j, Ψ j = MeasureTheory.convolution
      ((b j).normed MeasureTheory.volume) (K j) (ContinuousLinearMap.lsmul ℝ ℝ)
      MeasureTheory.volume :=
    ⟨fun j => MeasureTheory.convolution ((b j).normed MeasureTheory.volume) (K j)
      (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume, fun _ => rfl⟩
  
  have hrep : ∀ j, ∫ x, fcrMoll (b j) g x * ψ x = ∫ y, g y * Ψ j y := by
    intro j
    have h1 : ∀ x, fcrMoll (b j) g x * ψ x =
        MeasureTheory.convolution ((b j).normed MeasureTheory.volume) g
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume (x + (2 * (b j).rOut) • e 0) *
          K j (x + (2 * (b j).rOut) • e 0) := by
      intro x
      rw [hK j, add_sub_cancel_right, MeasureTheory.convolution_lsmul_swap]
      rfl
    have h2 := MeasureTheory.integral_add_right_eq_self (μ := MeasureTheory.volume)
      (fun y => MeasureTheory.convolution ((b j).normed MeasureTheory.volume) g
          (ContinuousLinearMap.lsmul ℝ ℝ) MeasureTheory.volume y * K j y)
      ((2 * (b j).rOut) • e 0)
    simp only at h2
    rw [MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall h1), h2, hΨ j]
    exact hadj (b j) (K j) (hKc j) (hKcs j)
  
  have hbound : ∀ j y, |Ψ j y| ≤ 3 * C := by
    intro j y
    have hd : dist (Ψ j y) (K j y) ≤ 2 * C := by
      rw [hΨ j]
      apply ContDiffBump.dist_normed_convolution_le (hKc j).aestronglyMeasurable
      intro x _
      rw [Real.dist_eq]
      obtain ⟨a1, a2⟩ := abs_le.mp (hKb j x)
      obtain ⟨b1, b2⟩ := abs_le.mp (hKb j y)
      rw [abs_le]
      constructor <;> linarith
    rw [Real.dist_eq] at hd
    obtain ⟨a1, a2⟩ := abs_le.mp hd
    obtain ⟨b1, b2⟩ := abs_le.mp (hKb j y)
    rw [abs_le]
    constructor <;> linarith
  
  have hlim : ∀ y, Tendsto (fun j => Ψ j y) atTop (𝓝 (ψ y)) := by
    intro y
    have hv : Tendsto (fun j => (2 * (b j).rOut) • e 0) atTop (𝓝 (0 : E3)) := by
      have h := (hb.const_mul 2).smul_const (e 0)
      simpa using h
    have hjoint : Tendsto (Function.uncurry K) (atTop ×ˢ 𝓝 y) (𝓝 (ψ y)) := by
      have h1 : Tendsto (fun p : ℕ × E3 => p.2 - (2 * (b p.1).rOut) • e 0)
          (atTop ×ˢ 𝓝 y) (𝓝 (y - 0)) :=
        tendsto_snd.sub (hv.comp tendsto_fst)
      rw [sub_zero] at h1
      have h2 := (hψ.tendsto y).comp h1
      refine h2.congr (fun p => ?_)
      show ψ (p.2 - (2 * (b p.1).rOut) • e 0) = K p.1 p.2
      rw [hK]
    have h := ContDiffBump.convolution_tendsto_right (μ := MeasureTheory.volume) (φ := b)
      (g := K) (k := fun _ => y) hb
      (Filter.Eventually.of_forall fun j => (hKc j).aestronglyMeasurable) hjoint
      tendsto_const_nhds
    refine h.congr (fun j => ?_)
    rw [hΨ j]
  
  have hΨc : ∀ j, Continuous (Ψ j) := by
    intro j
    rw [hΨ j]
    exact (b j).hasCompactSupport_normed.continuous_convolution_left
      (ContinuousLinearMap.lsmul ℝ ℝ) (b j).continuous_normed (hKc j).locallyIntegrable
  have hdct : Tendsto (fun j => ∫ y, g y * Ψ j y) atTop (𝓝 (∫ y, g y * ψ y)) := by
    refine MeasureTheory.tendsto_integral_of_dominated_convergence
      (fun y => ‖g y‖ * (3 * C)) ?_ ?_ ?_ ?_
    · intro j
      exact hg.aestronglyMeasurable.mul (hΨc j).aestronglyMeasurable
    · exact hg.norm.mul_const _
    · intro j
      refine Filter.Eventually.of_forall (fun y => ?_)
      rw [norm_mul, Real.norm_eq_abs (Ψ j y)]
      exact mul_le_mul_of_nonneg_left (hbound j y) (norm_nonneg _)
    · exact Filter.Eventually.of_forall (fun y => (hlim y).const_mul (g y))
  
  exact hdct.congr (fun j => (hrep j).symm)

theorem fcr_h1_test (c : E3) (R s s₂ s₃ : ℝ) (hs₂ : 0 < s₂) (h23 : s₂ < s₃) (h3s : s₃ ≤ s)
    (hsR : s < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fcrProb c s A w D G F) (ψ : E3 → ℝ) (Ψ : Fin 3 → E3 → ℝ)
    (hψ : MemLp ψ 2 (volume.restrict (fcrHalf c s₃)))
    (hΨ : ∀ d, MemLp (Ψ d) 2 (volume.restrict (fcrHalf c s₃)))
    (hwd : ∀ d, fcrWD c s₃ ψ d (Ψ d))
    (hψ0 : ∀ x, x ∉ Metric.ball c s₂ → ψ x = 0)
    (hΨ0 : ∀ d x, x ∉ Metric.ball c s₂ → Ψ d x = 0) :
    ∫ x in fcrHalf c s,
      ((∑ d : Fin 3, ((∑ b : Fin 3, A x d b * D [b] x) + G d x) * Ψ d x) + F x * ψ x) = 0 :=
by
  classical
  
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hfin : ∀ r, IsFiniteMeasure (volume.restrict (fcrHalf c r)) := fun r =>
    isFiniteMeasure_restrict.mpr
      ((measure_mono (fun x hx => hx.1 : fcrHalf c r ⊆ Metric.ball c r)).trans_lt
        measure_ball_lt_top).ne
  have hF : MemLp F 2 (volume.restrict (fcrHalf c s)) := hP.2.2.1
  
  have hind : ∀ f : E3 → ℝ, MemLp f 2 (volume.restrict (fcrHalf c s₃)) →
      (∀ x, x ∉ Metric.ball c s₂ → f x = 0) →
      MemLp ((fcrHalf c s₃).indicator f) 2 volume ∧ Integrable ((fcrHalf c s₃).indicator f) ∧
      (∀ t, t ∉ Metric.ball c s₂ → (fcrHalf c s₃).indicator f t = 0) ∧
      (∀ x ∈ fcrHalf c s, (fcrHalf c s₃).indicator f x = f x) := by
    intro f hf hf0
    haveI := hfin s₃
    refine ⟨(memLp_indicator_iff_restrict (hmeas s₃)).2 hf,
      (integrable_indicator_iff (hmeas s₃)).2 (hf.integrable (by norm_num)), ?_, ?_⟩
    · intro t ht
      exact Set.indicator_apply_eq_zero.2 (fun _ => hf0 t ht)
    · intro x hx
      by_cases hx3 : x ∈ fcrHalf c s₃
      · exact Set.indicator_of_mem hx3 f
      · rw [Set.indicator_of_notMem hx3]
        have hxb : x ∉ Metric.ball c s₂ := fun hb =>
          hx3 ⟨Metric.ball_subset_ball h23.le hb, hx.2⟩
        exact (hf0 x hxb).symm
  
  have hvan : ∀ (bm : ContDiffBump (0 : E3)) (f : E3 → ℝ),
      (∀ t, t ∉ Metric.ball c s₂ → f t = 0) →
      ∀ x, s₂ + 3 * bm.rOut ≤ dist x c → fcrMoll bm f x = 0 := by
    intro bm f hf x hx
    have hr := bm.rOut_pos
    unfold fcrMoll
    have hz : (fun t => bm.normed volume (x + (2 * bm.rOut) • e 0 - t) * f t) = fun _ => 0 := by
      funext t
      by_cases ht : t ∈ Metric.ball c s₂
      · have hn : bm.normed volume (x + (2 * bm.rOut) • e 0 - t) = 0 := by
          apply Function.notMem_support.1
          rw [bm.support_normed_eq]
          intro hmem
          rw [Metric.mem_ball, dist_zero_right] at hmem
          have ht' : dist t c < s₂ := ht
          have h1 : dist x c ≤ dist x t + dist t c := dist_triangle x t c
          have h2 : ‖(2 * bm.rOut) • e 0‖ = 2 * bm.rOut := by
            rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
              abs_of_pos (by linarith)]
          have h3 : dist x t ≤ ‖x + (2 * bm.rOut) • e 0 - t‖ + ‖(2 * bm.rOut) • e 0‖ := by
            rw [dist_eq_norm]
            calc ‖x - t‖ = ‖(x + (2 * bm.rOut) • e 0 - t) - (2 * bm.rOut) • e 0‖ := by
                  congr 1; abel
              _ ≤ _ := norm_sub_le _ _
          linarith
        rw [hn, zero_mul]
      · rw [hf t ht, mul_zero]
    rw [hz, integral_zero]
  
  have hmollf : ∀ (bm : ContDiffBump (0 : E3)) (f : E3 → ℝ),
      MemLp f 2 (volume.restrict (fcrHalf c s₃)) →
      (∀ x, x ∉ Metric.ball c s₂ → f x = 0) → s₂ + 3 * bm.rOut < s →
      ContDiff ℝ ∞ (fcrMoll bm ((fcrHalf c s₃).indicator f)) ∧
      HasCompactSupport (fcrMoll bm ((fcrHalf c s₃).indicator f)) ∧
      tsupport (fcrMoll bm ((fcrHalf c s₃).indicator f)) ⊆ Metric.ball c s ∧
      MemLp (fcrMoll bm ((fcrHalf c s₃).indicator f)) 2 volume := by
    intro bm f hf hf0 hr
    have hs0 : fcrSob c s₃ 0 f (fun _ => f) :=
      ⟨rfl, fun _ _ => hf, fun _ _ hL => absurd hL (Nat.not_lt_zero _)⟩
    have hsm : ContDiff ℝ ∞ (fcrMoll bm ((fcrHalf c s₃).indicator f)) := by
      have h := (fcr_moll_deriv c s₃ 0 f (fun _ => f) hs0 bm).1 []
      simpa only [List.foldr_nil] using h
    have hvf := (hind f hf hf0).2.2.1
    have hsupp : Function.support (fcrMoll bm ((fcrHalf c s₃).indicator f)) ⊆
        Metric.closedBall c (s₂ + 3 * bm.rOut) := by
      intro x hx
      rw [Metric.mem_closedBall]
      by_contra hcon
      exact hx (hvan bm _ hvf x (not_le.1 hcon).le)
    have hcs : HasCompactSupport (fcrMoll bm ((fcrHalf c s₃).indicator f)) :=
      HasCompactSupport.intro (isCompact_closedBall c (s₂ + 3 * bm.rOut))
        (fun x hx => Function.notMem_support.1 (fun h => hx (hsupp h)))
    refine ⟨hsm, hcs, ?_, hsm.continuous.memLp_of_hasCompactSupport hcs⟩
    exact (closure_minimal hsupp Metric.isClosed_closedBall).trans
      (Metric.closedBall_subset_ball hr)
  
  have hsob : fcrSob c s₃ 1 ψ (fun L => match L with | [] => ψ | d :: _ => Ψ d) := by
    refine ⟨rfl, ?_, ?_⟩
    · intro L hL
      rcases L with _ | ⟨d, _ | ⟨d', t⟩⟩
      · exact hψ
      · exact hΨ d
      · simp at hL
    · intro L d hL ζ h1 h2 h3
      rcases L with _ | ⟨d', t⟩
      · exact hwd d ζ h1 h2 h3
      · simp at hL
  
  have hconv : ∀ u v : E3 → ℝ,
      ∫ x in fcrHalf c s, u x * v x = ∫ x, (fcrHalf c s).indicator u x * v x := by
    intro u v
    rw [← integral_indicator (hmeas s)]
    congr 1
    funext x
    exact Set.indicator_mul_left _ u v
  
  have hamgm : ∀ (f h : E3 → ℝ), MemLp f 2 volume → MemLp h 2 volume → ∀ θ : ℝ, 0 < θ →
      |∫ x, f x * h x| ≤ (1 / (2 * θ)) * (∫ x, f x ^ 2) + (θ / 2) * ∫ x, h x ^ 2 := by
    intro f h hf hh θ hθ
    have hint : Integrable (fun x => f x * h x) := hf.integrable_mul hh
    have hint2 : Integrable (fun x => (1 / (2 * θ)) * f x ^ 2 + (θ / 2) * h x ^ 2) :=
      (hf.integrable_sq.const_mul _).add (hh.integrable_sq.const_mul _)
    calc |∫ x, f x * h x| ≤ ∫ x, |f x * h x| := abs_integral_le_integral_abs
      _ ≤ ∫ x, ((1 / (2 * θ)) * f x ^ 2 + (θ / 2) * h x ^ 2) := by
          refine integral_mono hint.abs hint2 (fun x => ?_)
          have hθ2 : 0 < 2 * θ := by linarith
          have e2 : (1 / (2 * θ)) * f x ^ 2 + (θ / 2) * h x ^ 2 =
              (f x ^ 2 + θ ^ 2 * h x ^ 2) / (2 * θ) := by
            field_simp
            try ring
          show |f x * h x| ≤ (1 / (2 * θ)) * f x ^ 2 + (θ / 2) * h x ^ 2
          rw [e2, le_div_iff₀ hθ2, abs_mul, ← sq_abs (f x), ← sq_abs (h x)]
          nlinarith [sq_nonneg (|f x| - θ * |h x|)]
      _ = (1 / (2 * θ)) * (∫ x, f x ^ 2) + (θ / 2) * ∫ x, h x ^ 2 := by
          rw [integral_add (hf.integrable_sq.const_mul _) (hh.integrable_sq.const_mul _),
            integral_const_mul, integral_const_mul]
  have hpair : ∀ (W g : E3 → ℝ), MemLp W 2 volume → MemLp g 2 volume → Integrable g →
      ∀ (bm : ℕ → ContDiffBump (0 : E3)), Tendsto (fun j => (bm j).rOut) atTop (𝓝 0) →
      (∀ j, MemLp (fcrMoll (bm j) g) 2 volume) →
      Tendsto (fun j => ∫ x, W x * fcrMoll (bm j) g x) atTop (𝓝 (∫ x, W x * g x)) := by
    intro W g hW hg2 hg1 bm hb hm
    have hM0 : 0 ≤ ∫ x, g x ^ 2 := integral_nonneg (fun x => sq_nonneg _)
    have hmM : ∀ j, ∫ x, fcrMoll (bm j) g x ^ 2 ≤ ∫ x, g x ^ 2 := by
      intro j
      have h := fcr_moll_L2 (bm j) g hg2 Set.univ
      rwa [setIntegral_univ] at h
    rw [Metric.tendsto_atTop]
    intro ε hε
    have h1M : 0 < 1 + ∫ x, g x ^ 2 := by linarith
    obtain ⟨θ, hθdef⟩ : ∃ θ : ℝ, θ = ε / 4 / (1 + ∫ x, g x ^ 2) := ⟨_, rfl⟩
    have hθ : 0 < θ := by rw [hθdef]; exact div_pos (div_pos hε (by norm_num)) h1M
    have hθM : θ * (1 + ∫ x, g x ^ 2) = ε / 4 := by
      rw [hθdef]; field_simp
    have hW2 : MemLp W (ENNReal.ofReal 2) volume := by rw [ENNReal.ofReal_ofNat]; exact hW
    obtain ⟨k, hkc, hkint, hkcont, hkL⟩ :=
      hW2.exists_hasCompactSupport_integral_rpow_sub_le (by norm_num : (0 : ℝ) < 2)
        (pow_pos hθ 2)
    have hk2 : MemLp k 2 volume := by rw [ENNReal.ofReal_ofNat] at hkL; exact hkL
    have hWk : ∫ x, (W x - k x) ^ 2 ≤ θ ^ 2 := by
      simp only [Real.rpow_two, Real.norm_eq_abs, sq_abs] at hkint
      exact hkint
    have hWk2 : MemLp (fun x => W x - k x) 2 volume := hW.sub hk2
    have hlim := fcr_moll_weak_limit g hg1 k hkcont hkc bm hb
    rw [Metric.tendsto_atTop] at hlim
    obtain ⟨N, hN⟩ := hlim (ε / 2) (by linarith)
    refine ⟨N, fun j hj => ?_⟩
    have hNj := hN j hj
    rw [Real.dist_eq] at hNj ⊢
    have i1 : Integrable (fun x => (W x - k x) * fcrMoll (bm j) g x) := hWk2.integrable_mul (hm j)
    have i2 : Integrable (fun x => fcrMoll (bm j) g x * k x) := (hm j).integrable_mul hk2
    have i3 : Integrable (fun x => g x * k x) := hg2.integrable_mul hk2
    have i4 : Integrable (fun x => (W x - k x) * g x) := hWk2.integrable_mul hg2
    have a1 : ∫ x, W x * fcrMoll (bm j) g x =
        (∫ x, (W x - k x) * fcrMoll (bm j) g x) + ∫ x, fcrMoll (bm j) g x * k x := by
      rw [← integral_add i1 i2]
      congr 1
      funext x
      ring
    have a2 : ∫ x, W x * g x = (∫ x, (W x - k x) * g x) + ∫ x, g x * k x := by
      rw [← integral_add i4 i3]
      congr 1
      funext x
      ring
    have b1 : |∫ x, (W x - k x) * fcrMoll (bm j) g x| ≤
        (1 / (2 * θ)) * (∫ x, (W x - k x) ^ 2) + (θ / 2) * ∫ x, fcrMoll (bm j) g x ^ 2 :=
      hamgm _ _ hWk2 (hm j) θ hθ
    have b2 : |∫ x, (W x - k x) * g x| ≤
        (1 / (2 * θ)) * (∫ x, (W x - k x) ^ 2) + (θ / 2) * ∫ x, g x ^ 2 :=
      hamgm _ _ hWk2 hg2 θ hθ
    have hcoef : 0 ≤ 1 / (2 * θ) := div_nonneg zero_le_one (by linarith)
    have c1 : (1 / (2 * θ)) * (∫ x, (W x - k x) ^ 2) ≤ θ / 2 := by
      calc (1 / (2 * θ)) * (∫ x, (W x - k x) ^ 2) ≤ (1 / (2 * θ)) * θ ^ 2 :=
            mul_le_mul_of_nonneg_left hWk hcoef
        _ = θ / 2 := by
          field_simp
          try ring
    have c2 : (θ / 2) * (∫ x, fcrMoll (bm j) g x ^ 2) ≤ (θ / 2) * ∫ x, g x ^ 2 :=
      mul_le_mul_of_nonneg_left (hmM j) (by linarith)
    have B1 := abs_le.mp b1
    have B2 := abs_le.mp b2
    have B3 := abs_lt.mp hNj
    have hθM' : θ / 2 + θ / 2 * ∫ x, g x ^ 2 = ε / 8 := by linear_combination hθM / 2
    rw [a1, a2, abs_lt]
    constructor <;> linarith
  
  have hV : ∀ d, MemLp (fun x => (∑ b : Fin 3, A x d b * D [b] x) + G d x) 2
      (volume.restrict (fcrHalf c s)) := by
    intro d
    have hterm : ∀ b : Fin 3, MemLp (fun x => A x d b * D [b] x) 2
        (volume.restrict (fcrHalf c s)) := by
      intro b
      obtain ⟨C, hC⟩ := (isCompact_closedBall c s).exists_bound_of_continuousOn
        ((hA d b).continuousOn.mono (Metric.closedBall_subset_ball hsR))
      have hcont : ContinuousOn (fun x => A x d b) (fcrHalf c s) :=
        (hA d b).continuousOn.mono (fun x hx => Metric.ball_subset_ball hsR.le hx.1)
      refine MemLp.of_le_mul (c := C) (hP.1.2.1 [b] (by simp))
        ((hcont.aestronglyMeasurable (hmeas s)).mul
          (hP.1.2.1 [b] (by simp)).aestronglyMeasurable) ?_
      refine (ae_restrict_iff' (hmeas s)).2 (Filter.Eventually.of_forall fun x hx => ?_)
      show ‖A x d b * D [b] x‖ ≤ C * ‖D [b] x‖
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hC x (Metric.ball_subset_closedBall hx.1)) (norm_nonneg _)
    have hsum := memLp_finset_sum Finset.univ (fun b _ => hterm b)
    exact hsum.add (hP.2.1 d)
  suffices key : ∀ V : Fin 3 → E3 → ℝ, (∀ d, MemLp (V d) 2 (volume.restrict (fcrHalf c s))) →
      (∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c s →
        ∫ x in fcrHalf c s, ((∑ a : Fin 3, V a x * partialDeriv a ζ x) + F x * ζ x) = 0) →
      ∫ x in fcrHalf c s, ((∑ d : Fin 3, V d x * Ψ d x) + F x * ψ x) = 0 by
    exact key (fun d x => (∑ b : Fin 3, A x d b * D [b] x) + G d x) hV hP.2.2.2
  intro V hVL hEq
  
  have honetest : ∀ bm : ContDiffBump (0 : E3), s₂ + 6 * bm.rOut < s₃ →
      ∫ x in fcrHalf c s, ((∑ d : Fin 3, V d x * fcrMoll bm ((fcrHalf c s₃).indicator (Ψ d)) x) +
        F x * fcrMoll bm ((fcrHalf c s₃).indicator ψ) x) = 0 := by
    intro bm hb'
    have hr := bm.rOut_pos
    obtain ⟨hsm, hcs, hts, -⟩ := hmollf bm ψ hψ hψ0 (by linarith)
    have hderiv : ∀ x ∈ fcrHalf c s, ∀ a : Fin 3,
        partialDeriv a (fcrMoll bm ((fcrHalf c s₃).indicator ψ)) x =
          fcrMoll bm ((fcrHalf c s₃).indicator (Ψ a)) x := by
      intro x hx a
      have hx0 : (0 : ℝ) < x 0 := hx.2
      by_cases hxc : dist x c < s₃ - 3 * bm.rOut
      · have h := (fcr_moll_deriv c s₃ 1 ψ _ hsob bm).2 [a] (by simp) x (by linarith)
          (Metric.mem_ball.2 hxc)
        simpa only [List.foldr_cons, List.foldr_nil] using h
      · have hxO : s₂ + 3 * bm.rOut < dist x c := by push_neg at hxc; linarith
        have hO : IsOpen {y : E3 | s₂ + 3 * bm.rOut < dist y c} :=
          isOpen_lt continuous_const (continuous_id.dist continuous_const)
        have hev : fcrMoll bm ((fcrHalf c s₃).indicator ψ) =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
          Filter.eventually_of_mem (hO.mem_nhds hxO)
            (fun y hy => hvan bm _ (hind ψ hψ hψ0).2.2.1 y (le_of_lt hy))
        show fderiv ℝ (fcrMoll bm ((fcrHalf c s₃).indicator ψ)) x (e a) = _
        rw [hev.fderiv_eq, fderiv_const_apply, ContinuousLinearMap.zero_apply,
          hvan bm _ (hind (Ψ a) (hΨ a) (hΨ0 a)).2.2.1 x hxO.le]
    have h := hEq _ hsm hcs hts
    refine Eq.trans (setIntegral_congr_fun (hmeas s) (fun x hx => ?_)) h
    have hd := hderiv x hx
    simp only [hd]
  
  have hδ : 0 < (s₃ - s₂) / 7 := div_pos (by linarith) (by norm_num)
  obtain ⟨bm, hbm⟩ : ∃ bm : ℕ → ContDiffBump (0 : E3),
      ∀ j, (bm j).rOut = (s₃ - s₂) / 7 / ((j : ℝ) + 1) :=
    ⟨fun j => ⟨(s₃ - s₂) / 7 / ((j : ℝ) + 1) / 2, (s₃ - s₂) / 7 / ((j : ℝ) + 1),
      div_pos (div_pos hδ (Nat.cast_add_one_pos j)) two_pos,
      half_lt_self (div_pos hδ (Nat.cast_add_one_pos j))⟩, fun _ => rfl⟩
  have hb6 : ∀ j, s₂ + 6 * (bm j).rOut < s₃ := by
    intro j
    have hj : (1 : ℝ) ≤ (j : ℝ) + 1 := by
      have := Nat.cast_nonneg (α := ℝ) j
      linarith
    have hle : (bm j).rOut ≤ (s₃ - s₂) / 7 := by
      rw [hbm j]
      exact div_le_self hδ.le hj
    linarith
  have hb3 : ∀ j, s₂ + 3 * (bm j).rOut < s := by
    intro j
    have := hb6 j
    have := (bm j).rOut_pos
    linarith
  have hblim : Tendsto (fun j => (bm j).rOut) atTop (𝓝 0) := by
    simp only [hbm]
    exact tendsto_const_nhds.div_atTop
      (tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
  
  obtain ⟨hψb2, hψb1, -, hψbH⟩ := hind ψ hψ hψ0
  have hΨb := fun d => hind (Ψ d) (hΨ d) (hΨ0 d)
  have hVt : ∀ d, MemLp ((fcrHalf c s).indicator (V d)) 2 volume :=
    fun d => (memLp_indicator_iff_restrict (hmeas s)).2 (hVL d)
  have hFt : MemLp ((fcrHalf c s).indicator F) 2 volume :=
    (memLp_indicator_iff_restrict (hmeas s)).2 hF
  
  obtain ⟨T, hTdef⟩ : ∃ T : ℕ → ℝ, T = fun j =>
      (∑ d : Fin 3, ∫ x, (fcrHalf c s).indicator (V d) x *
        fcrMoll (bm j) ((fcrHalf c s₃).indicator (Ψ d)) x) +
      ∫ x, (fcrHalf c s).indicator F x * fcrMoll (bm j) ((fcrHalf c s₃).indicator ψ) x :=
    ⟨_, rfl⟩
  have hT : ∀ j, T j = 0 := by
    intro j
    rw [hTdef]
    have hmψ := (hmollf (bm j) ψ hψ hψ0 (hb3 j)).2.2.2
    have hmΨ := fun d => (hmollf (bm j) (Ψ d) (hΨ d) (hΨ0 d) (hb3 j)).2.2.2
    have i1 : ∀ d, Integrable (fun x => V d x * fcrMoll (bm j) ((fcrHalf c s₃).indicator (Ψ d)) x)
        (volume.restrict (fcrHalf c s)) :=
      fun d => (hVL d).integrable_mul ((hmΨ d).restrict _)
    have i2 : Integrable (fun x => F x * fcrMoll (bm j) ((fcrHalf c s₃).indicator ψ) x)
        (volume.restrict (fcrHalf c s)) :=
      hF.integrable_mul (hmψ.restrict _)
    have h := honetest (bm j) (hb6 j)
    rw [integral_add (integrable_finset_sum _ (fun d _ => i1 d)) i2,
      integral_finset_sum _ (fun d _ => i1 d)] at h
    refine Eq.trans ?_ h
    show (∑ d : Fin 3, ∫ x, (fcrHalf c s).indicator (V d) x *
        fcrMoll (bm j) ((fcrHalf c s₃).indicator (Ψ d)) x) +
      ∫ x, (fcrHalf c s).indicator F x * fcrMoll (bm j) ((fcrHalf c s₃).indicator ψ) x = _
    congr 1
    · exact Finset.sum_congr rfl (fun d _ => (hconv _ _).symm)
    · exact (hconv _ _).symm
  
  have hlimΨ : ∀ d, Tendsto (fun j => ∫ x, (fcrHalf c s).indicator (V d) x *
      fcrMoll (bm j) ((fcrHalf c s₃).indicator (Ψ d)) x) atTop
      (𝓝 (∫ x, (fcrHalf c s).indicator (V d) x * (fcrHalf c s₃).indicator (Ψ d) x)) := fun d =>
    hpair _ _ (hVt d) (hΨb d).1 (hΨb d).2.1 bm hblim
      (fun j => (hmollf (bm j) (Ψ d) (hΨ d) (hΨ0 d) (hb3 j)).2.2.2)
  have hlimψ : Tendsto (fun j => ∫ x, (fcrHalf c s).indicator F x *
      fcrMoll (bm j) ((fcrHalf c s₃).indicator ψ) x) atTop
      (𝓝 (∫ x, (fcrHalf c s).indicator F x * (fcrHalf c s₃).indicator ψ x)) :=
    hpair _ _ hFt hψb2 hψb1 bm hblim (fun j => (hmollf (bm j) ψ hψ hψ0 (hb3 j)).2.2.2)
  have hsum : Tendsto T atTop
      (𝓝 ((∑ d : Fin 3, ∫ x, (fcrHalf c s).indicator (V d) x * (fcrHalf c s₃).indicator (Ψ d) x) +
        ∫ x, (fcrHalf c s).indicator F x * (fcrHalf c s₃).indicator ψ x)) := by
    rw [hTdef]
    exact (tendsto_finset_sum Finset.univ (fun d _ => hlimΨ d)).add hlimψ
  have hzero : Tendsto T atTop (𝓝 0) := by
    rw [show T = fun _ => (0 : ℝ) from funext hT]
    exact tendsto_const_nhds
  have hL := tendsto_nhds_unique hsum hzero
  
  have hΨbH : ∀ d, ∀ x ∈ fcrHalf c s, (fcrHalf c s₃).indicator (Ψ d) x = Ψ d x :=
    fun d => (hΨb d).2.2.2
  rw [setIntegral_congr_fun (hmeas s) (g := fun x =>
      (∑ d : Fin 3, V d x * (fcrHalf c s₃).indicator (Ψ d) x) +
        F x * (fcrHalf c s₃).indicator ψ x) (fun x hx => by
      have h1 := hψbH x hx
      have h2 : ∀ d, (fcrHalf c s₃).indicator (Ψ d) x = Ψ d x := fun d => hΨbH d x hx
      simp only [h1, h2])]
  have j1 : ∀ d, Integrable (fun x => V d x * (fcrHalf c s₃).indicator (Ψ d) x)
      (volume.restrict (fcrHalf c s)) :=
    fun d => (hVL d).integrable_mul ((hΨb d).1.restrict _)
  have j2 : Integrable (fun x => F x * (fcrHalf c s₃).indicator ψ x)
      (volume.restrict (fcrHalf c s)) :=
    hF.integrable_mul (hψb2.restrict _)
  rw [integral_add (integrable_finset_sum _ (fun d _ => j1 d)) j2,
    integral_finset_sum _ (fun d _ => j1 d)]
  refine Eq.trans ?_ hL
  congr 1
  · exact Finset.sum_congr rfl (fun d _ => hconv _ _)
  · exact hconv _ _

theorem fcr_dq_identity (c : E3) (R s s' s₁ s₂ s₃ h₀ : ℝ) (hs' : 0 < s') (h01 : s' < s₁)
    (hh₀ : 0 < h₀) (h12 : s₁ + h₀ < s₂) (h23 : s₂ + h₀ < s₃) (h3s : s₃ + 2 * h₀ ≤ s)
    (hsR : s < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fcrProb c s A w D G F) (hG : ∀ d, ∃ DG, fcrSob c s 1 (G d) DG)
    (η : ContDiffBump c) (hηr : η.rOut = s₁) (a : Fin 3) (ha : a ≠ 0)
    (h : ℝ) (hh : h ≠ 0) (hhh : |h| ≤ h₀) :
    ((∫ x in fcrHalf c s₂, ∑ d : Fin 3,
       ((∑ b : Fin 3, A (x + h • e a) d b * fcrDQ a h (D [b]) x) +
         ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x)) *
       (η x ^ 2 * fcrDQ a h (D [d]) x + 2 * η x * partialDeriv d η x * fcrDQ a h w x)) =
     ∫ x in fcrHalf c s₂, F x * fcrDQ a (-h) (fun y => η y ^ 2 * fcrDQ a h w y) x) ∧
    ∫ x in fcrHalf c s₂, (fcrDQ a (-h) (fun y => η y ^ 2 * fcrDQ a h w y) x) ^ 2 ≤
     ∫ x in fcrHalf c s₂,
       (η x ^ 2 * fcrDQ a h (D [a]) x + 2 * η x * partialDeriv a η x * fcrDQ a h w x) ^ 2 ∧
    MemLp (fcrDQ a (-h) (fun y => η y ^ 2 * fcrDQ a h w y)) 2
      (volume.restrict (fcrHalf c s₂)) :=
by
  
  have habs : |(-h)| = |h| := abs_neg h
  have hR1 : (s - h₀) + |h| ≤ s := by linarith
  have hR2 : s₃ + |(-h)| ≤ s - h₀ := by rw [habs]; linarith
  have hR3 : s₂ + |(-h)| < s - h₀ := by rw [habs]; linarith
  have hR4 : s₁ + |h| < s := by linarith
  have hR5 : s₂ + |h| ≤ s := by linarith
  have hs₂pos : 0 < s₂ := by linarith
  
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hsub : ∀ r t : ℝ, r ≤ t → fcrHalf c r ⊆ fcrHalf c t := by
    intro r t hrt x hx
    exact ⟨Metric.ball_subset_ball hrt hx.1, hx.2⟩
  have hmono : ∀ (r t : ℝ) (f : E3 → ℝ), r ≤ t → MemLp f 2 (volume.restrict (fcrHalf c t)) →
      MemLp f 2 (volume.restrict (fcrHalf c r)) := fun r t f hrt hf =>
    hf.mono_measure (Measure.restrict_mono (hsub r t hrt) le_rfl)
  have hext : ∀ (r t : ℝ) (f : E3 → ℝ), r ≤ t → MemLp f 2 (volume.restrict (fcrHalf c r)) →
      (∀ x, x ∉ Metric.ball c r → f x = 0) → MemLp f 2 (volume.restrict (fcrHalf c t)) := by
    intro r t f hrt hf hf0
    have h1 : MemLp ((fcrHalf c r).indicator f) 2 volume :=
      (memLp_indicator_iff_restrict (hmeas r)).2 hf
    refine (h1.restrict (fcrHalf c t)).ae_eq ?_
    refine (ae_restrict_iff' (hmeas t)).2 (Filter.Eventually.of_forall fun x hx => ?_)
    by_cases hxr : x ∈ fcrHalf c r
    · exact Set.indicator_of_mem hxr f
    · rw [Set.indicator_of_notMem hxr]
      have hxb : x ∉ Metric.ball c r := fun hb => hxr ⟨hb, hx.2⟩
      exact (hf0 x hxb).symm
  have hsetint : ∀ (r t : ℝ) (f : E3 → ℝ), r ≤ t → (∀ x, x ∉ Metric.ball c r → f x = 0) →
      ∫ x in fcrHalf c t, f x = ∫ x in fcrHalf c r, f x := by
    intro r t f hrt hf0
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hmeas t) (hsub r t hrt) ?_
    intro x hx
    exact hf0 x (fun hb => hx.2 ⟨hb, hx.1.2⟩)
  
  have hη0 : ∀ x, x ∉ Metric.ball c s₁ → η x = 0 := by
    intro x hx
    have hx' : x ∉ Function.support (⇑η) := by rw [η.support_eq, hηr]; exact hx
    exact Function.notMem_support.1 hx'
  have hη01 : ∀ x, 0 ≤ η x ∧ η x ≤ 1 := fun x => ⟨η.nonneg, η.le_one⟩
  have hηsm : ContDiff ℝ ∞ (⇑η) := η.contDiff
  have hηc1 : ContDiff ℝ 1 (⇑η) := η.contDiff
  have hfdc : Continuous (fderiv ℝ (⇑η)) := hηc1.continuous_fderiv (by norm_num)
  obtain ⟨C₀, hC₀⟩ := Continuous.bounded_above_of_compact_support hfdc
    (η.hasCompactSupport.fderiv ℝ)
  have hdη : ∀ (d : Fin 3) (x : E3), |partialDeriv d (⇑η) x| ≤ max C₀ 0 := by
    intro d x
    have hed : ‖e d‖ = 1 := by simp [EuclideanSpace.norm_single]
    have h1 : ‖fderiv ℝ (⇑η) x (e d)‖ ≤ ‖fderiv ℝ (⇑η) x‖ * ‖e d‖ :=
      ContinuousLinearMap.le_opNorm _ _
    rw [hed, mul_one, Real.norm_eq_abs] at h1
    exact h1.trans ((hC₀ x).trans (le_max_left _ _))
  have hdηc : ∀ d : Fin 3, Continuous (fun x => partialDeriv d (⇑η) x) := by
    intro d
    exact hfdc.clm_apply continuous_const
  have hdη2 : ∀ (d : Fin 3) (x : E3),
      partialDeriv d (fun y => η y ^ 2) x = 2 * η x * partialDeriv d (⇑η) x := by
    intro d x
    have hd : DifferentiableAt ℝ (⇑η) x := hηc1.differentiable one_ne_zero x
    have he : (fun y => η y ^ 2) = (fun y => η y * η y) := by funext y; ring
    unfold partialDeriv
    have hm : HasFDerivAt (fun y => η y * η y)
        (η x • fderiv ℝ (⇑η) x + η x • fderiv ℝ (⇑η) x) x :=
      hd.hasFDerivAt.mul hd.hasFDerivAt
    rw [he, hm.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hη2sm : ContDiffOn ℝ ∞ (fun x => η x ^ 2) (Metric.ball c (s - h₀)) :=
    (hηsm.pow 2).contDiffOn
  have hsqmul : ∀ (r : ℝ) (f : E3 → ℝ), MemLp f 2 (volume.restrict (fcrHalf c r)) →
      MemLp (fun x => η x ^ 2 * f x) 2 (volume.restrict (fcrHalf c r)) := by
    intro r f hf
    refine MemLp.of_le_mul (c := 1) hf
      ((η.continuous.pow 2).aestronglyMeasurable.mul hf.aestronglyMeasurable)
      (Filter.Eventually.of_forall fun x => ?_)
    show ‖η x ^ 2 * f x‖ ≤ 1 * ‖f x‖
    have e2 := hη01 x
    have e3 : η x ^ 2 ≤ 1 := by nlinarith
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_of_nonneg (sq_nonneg (η x)), one_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) e3
  
  have hD0 : D [] = w := hP.1.1
  have hwL : MemLp w 2 (volume.restrict (fcrHalf c s)) := by
    have h0 := hP.1.2.1 [] (by simp)
    rwa [hD0] at h0
  have hDL : ∀ d, MemLp (D [d]) 2 (volume.restrict (fcrHalf c s)) :=
    fun d => hP.1.2.1 [d] (by simp)
  have hwd : ∀ d, fcrWD c s w d (D [d]) := by
    intro d ζ h1 h2 h3
    have h0 := hP.1.2.2 [] d (by simp) ζ h1 h2 h3
    rw [hD0] at h0
    exact h0
  
  have hV : ∀ d, MemLp (fun x => (∑ b : Fin 3, A x d b * D [b] x) + G d x) 2
      (volume.restrict (fcrHalf c s)) := by
    intro d
    have hterm : ∀ b : Fin 3, MemLp (fun x => A x d b * D [b] x) 2
        (volume.restrict (fcrHalf c s)) := by
      intro b
      obtain ⟨C, hC⟩ := (isCompact_closedBall c s).exists_bound_of_continuousOn
        ((hA d b).continuousOn.mono (Metric.closedBall_subset_ball hsR))
      have hcont : ContinuousOn (fun x => A x d b) (fcrHalf c s) :=
        (hA d b).continuousOn.mono (fun x hx => Metric.ball_subset_ball hsR.le hx.1)
      refine MemLp.of_le_mul (c := C) (hDL b)
        ((hcont.aestronglyMeasurable (hmeas s)).mul (hDL b).aestronglyMeasurable) ?_
      refine (ae_restrict_iff' (hmeas s)).2 (Filter.Eventually.of_forall fun x hx => ?_)
      show ‖A x d b * D [b] x‖ ≤ C * ‖D [b] x‖
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hC x (Metric.ball_subset_closedBall hx.1)) (norm_nonneg _)
    have hsum := memLp_finset_sum Finset.univ (fun b _ => hterm b)
    exact hsum.add (hP.2.1 d)
  
  have hu : MemLp (fcrDQ a h w) 2 (volume.restrict (fcrHalf c (s - h₀))) :=
    fcr_dq_memLp c s (s - h₀) w a ha h hR1 hwL
  have hU : ∀ d, MemLp (fcrDQ a h (D [d])) 2 (volume.restrict (fcrHalf c (s - h₀))) :=
    fun d => fcr_dq_memLp c s (s - h₀) (D [d]) a ha h hR1 (hDL d)
  have huwd : ∀ d, fcrWD c (s - h₀) (fcrDQ a h w) d (fcrDQ a h (D [d])) :=
    fun d => fcr_dq_wd c s (s - h₀) w (D [d]) d a ha h hR1 hwL (hDL d) (hwd d)
  
  set ψ : E3 → ℝ := fun y => η y ^ 2 * fcrDQ a h w y with hψ
  set Ψ : Fin 3 → E3 → ℝ := fun d x => η x ^ 2 * fcrDQ a h (D [d]) x +
    2 * η x * partialDeriv d (⇑η) x * fcrDQ a h w x with hΨ
  have hψwd : ∀ d, fcrWD c (s - h₀) ψ d (Ψ d) := by
    intro d
    have h1 := fcr_wd_smul c (s - h₀) (s - h₀) le_rfl (fun x => η x ^ 2) hη2sm (fcrDQ a h w)
      (fcrDQ a h (D [d])) d hu (hU d) (huwd d)
    have h2 : fcrWD c (s - h₀) (fun x => η x ^ 2 * fcrDQ a h w x) d
        (fun x => partialDeriv d (fun y => η y ^ 2) x * fcrDQ a h w x +
          η x ^ 2 * fcrDQ a h (D [d]) x) := h1
    have he : (fun x => partialDeriv d (fun y => η y ^ 2) x * fcrDQ a h w x +
          η x ^ 2 * fcrDQ a h (D [d]) x) = Ψ d := by
      funext x
      simp only [hΨ, hdη2]
      ring
    rw [he] at h2
    exact h2
  have hψL : MemLp ψ 2 (volume.restrict (fcrHalf c (s - h₀))) := hsqmul _ _ hu
  have hΨL : ∀ d, MemLp (Ψ d) 2 (volume.restrict (fcrHalf c (s - h₀))) := by
    intro d
    have h1 : MemLp (fun x => η x ^ 2 * fcrDQ a h (D [d]) x) 2
        (volume.restrict (fcrHalf c (s - h₀))) := hsqmul _ _ (hU d)
    have hc : Continuous (fun x => 2 * η x * partialDeriv d (⇑η) x) :=
      (continuous_const.mul η.continuous).mul (hdηc d)
    have h2 : MemLp (fun x => 2 * η x * partialDeriv d (⇑η) x * fcrDQ a h w x) 2
        (volume.restrict (fcrHalf c (s - h₀))) := by
      refine MemLp.of_le_mul (c := 2 * max C₀ 0) hu
        (hc.aestronglyMeasurable.mul hu.aestronglyMeasurable)
        (Filter.Eventually.of_forall fun x => ?_)
      show ‖2 * η x * partialDeriv d (⇑η) x * fcrDQ a h w x‖ ≤
        2 * max C₀ 0 * ‖fcrDQ a h w x‖
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, abs_two]
      have e1 := hdη d x
      have e2 := hη01 x
      have e3 : |η x| ≤ 1 := by rw [abs_of_nonneg e2.1]; exact e2.2
      have e4 := abs_nonneg (fcrDQ a h w x)
      have e5 := abs_nonneg (partialDeriv d (⇑η) x)
      have e7 : |η x| * |partialDeriv d (⇑η) x| ≤ max C₀ 0 := by
        calc _ ≤ 1 * max C₀ 0 := mul_le_mul e3 e1 e5 zero_le_one
          _ = _ := one_mul _
      have e8 := mul_le_mul_of_nonneg_right e7 e4
      nlinarith [e8]
    exact h1.add h2
  
  have hψ0 : ∀ x, x ∉ Metric.ball c s₁ → ψ x = 0 := by
    intro x hx
    simp [hψ, hη0 x hx]
  have hΨ0 : ∀ d x, x ∉ Metric.ball c s₁ → Ψ d x = 0 := by
    intro d x hx
    simp [hΨ, hη0 x hx]
  have hfar : ∀ x, x ∉ Metric.ball c s₂ →
      x ∉ Metric.ball c s₁ ∧ x + (-h) • e a ∉ Metric.ball c s₁ := by
    intro x hx
    have hx' : s₂ ≤ dist x c := not_lt.1 hx
    have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
    have hn : ‖(-h) • e a‖ = |h| := by rw [norm_smul, hea, mul_one, Real.norm_eq_abs, abs_neg]
    constructor
    · intro hb
      have hb' : dist x c < s₁ := hb
      linarith
    · intro hb
      have h1 : dist (x + (-h) • e a) c < s₁ := hb
      have h2 : dist x c ≤ dist (x + (-h) • e a) c + ‖(-h) • e a‖ := by
        rw [dist_eq_norm, dist_eq_norm]
        calc ‖x - c‖ = ‖(x + (-h) • e a - c) - (-h) • e a‖ := by congr 1; abel
          _ ≤ ‖x + (-h) • e a - c‖ + ‖(-h) • e a‖ := norm_sub_le _ _
      linarith
  have hQ0 : ∀ x, x ∉ Metric.ball c s₂ → fcrDQ a (-h) ψ x = 0 := by
    intro x hx
    obtain ⟨h1, h2⟩ := hfar x hx
    show (ψ (x + (-h) • e a) - ψ x) / (-h) = 0
    rw [hψ0 _ h2, hψ0 x h1]
    simp
  have hQd0 : ∀ d x, x ∉ Metric.ball c s₂ → fcrDQ a (-h) (Ψ d) x = 0 := by
    intro d x hx
    obtain ⟨h1, h2⟩ := hfar x hx
    show (Ψ d (x + (-h) • e a) - Ψ d x) / (-h) = 0
    rw [hΨ0 d _ h2, hΨ0 d x h1]
    simp
  
  have hQL3 : MemLp (fcrDQ a (-h) ψ) 2 (volume.restrict (fcrHalf c s₃)) :=
    fcr_dq_memLp c (s - h₀) s₃ ψ a ha (-h) hR2 hψL
  have hQdL3 : ∀ d, MemLp (fcrDQ a (-h) (Ψ d)) 2 (volume.restrict (fcrHalf c s₃)) :=
    fun d => fcr_dq_memLp c (s - h₀) s₃ (Ψ d) a ha (-h) hR2 (hΨL d)
  have hQwd : ∀ d, fcrWD c s₃ (fcrDQ a (-h) ψ) d (fcrDQ a (-h) (Ψ d)) :=
    fun d => fcr_dq_wd c (s - h₀) s₃ ψ (Ψ d) d a ha (-h) hR2 hψL (hΨL d) (hψwd d)
  have hC3 : MemLp (fcrDQ a (-h) ψ) 2 (volume.restrict (fcrHalf c s₂)) :=
    hmono s₂ s₃ _ (by linarith) hQL3
  have hQLs : MemLp (fcrDQ a (-h) ψ) 2 (volume.restrict (fcrHalf c s)) :=
    hext s₃ s _ (by linarith) hQL3
      (fun x hx => hQ0 x (fun hb => hx (Metric.ball_subset_ball (by linarith) hb)))
  have hQdLs : ∀ d, MemLp (fcrDQ a (-h) (Ψ d)) 2 (volume.restrict (fcrHalf c s)) :=
    fun d => hext s₃ s _ (by linarith) (hQdL3 d)
      (fun x hx => hQd0 d x (fun hb => hx (Metric.ball_subset_ball (by linarith) hb)))
  have hΨLs : ∀ d, MemLp (Ψ d) 2 (volume.restrict (fcrHalf c s)) :=
    fun d => hext (s - h₀) s _ (by linarith) (hΨL d)
      (fun x hx => hΨ0 d x (fun hb => hx (Metric.ball_subset_ball (by linarith) hb)))
  
  have hE4 : ∫ x in fcrHalf c s,
      ((∑ d : Fin 3, ((∑ b : Fin 3, A x d b * D [b] x) + G d x) * fcrDQ a (-h) (Ψ d) x) +
        F x * fcrDQ a (-h) ψ x) = 0 :=
    fcr_h1_test c R s s₂ s₃ hs₂pos (by linarith) (by linarith) hsR A hA w D G F hP
      (fcrDQ a (-h) ψ) (fun d => fcrDQ a (-h) (Ψ d)) hQL3 hQdL3 hQwd hQ0 hQd0
  have hint1 : ∀ d, Integrable (fun x => ((∑ b : Fin 3, A x d b * D [b] x) + G d x) *
      fcrDQ a (-h) (Ψ d) x) (volume.restrict (fcrHalf c s)) :=
    fun d => (hV d).integrable_mul (hQdLs d)
  have hint2 : Integrable (fun x => F x * fcrDQ a (-h) ψ x) (volume.restrict (fcrHalf c s)) :=
    hP.2.2.1.integrable_mul hQLs
  have hsplit : (∑ d : Fin 3, ∫ x in fcrHalf c s,
        ((∑ b : Fin 3, A x d b * D [b] x) + G d x) * fcrDQ a (-h) (Ψ d) x) +
      ∫ x in fcrHalf c s, F x * fcrDQ a (-h) ψ x = 0 := by
    have e1 := integral_finset_sum (μ := volume.restrict (fcrHalf c s)) Finset.univ
      (fun d _ => hint1 d)
    have e2 := integral_add (integrable_finset_sum Finset.univ (fun d _ => hint1 d)) hint2
    rw [← e1, ← e2]
    exact hE4
  
  have hibp : ∀ d, ∫ x in fcrHalf c s, ((∑ b : Fin 3, A x d b * D [b] x) + G d x) *
        fcrDQ a (-h) (Ψ d) x =
      -∫ x in fcrHalf c s, fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x *
        Ψ d x :=
    fun d => fcr_discrete_ibp c s s₁ (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) (Ψ d)
      a ha h hR4 (hV d) (hΨLs d) (hΨ0 d)
  
  have hpt : ∀ (d : Fin 3) (x : E3),
      (∑ b : Fin 3, A (x + h • e a) d b * fcrDQ a h (D [b]) x) +
        ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x) =
      fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x := by
    intro d x
    simp only [fcrDQ, Fin.sum_univ_three]
    field_simp
    ring
  have hDV : ∀ d, MemLp (fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y)) 2
      (volume.restrict (fcrHalf c s₂)) :=
    fun d => fcr_dq_memLp c s s₂ _ a ha h hR5 (hV d)
  have hΨL2 : ∀ d, MemLp (Ψ d) 2 (volume.restrict (fcrHalf c s₂)) :=
    fun d => hmono s₂ (s - h₀) _ (by linarith) (hΨL d)
  have hint3 : ∀ d, Integrable
      (fun x => fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x * Ψ d x)
      (volume.restrict (fcrHalf c s₂)) :=
    fun d => (hDV d).integrable_mul (hΨL2 d)
  have hstep1 : (∫ x in fcrHalf c s₂, ∑ d : Fin 3,
       ((∑ b : Fin 3, A (x + h • e a) d b * fcrDQ a h (D [b]) x) +
         ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x)) *
         Ψ d x) =
      ∑ d : Fin 3, ∫ x in fcrHalf c s,
        fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x * Ψ d x := by
    simp_rw [hpt]
    rw [integral_finset_sum _ (fun d _ => hint3 d)]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    have e := hsetint s₂ s
      (fun x => fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x * Ψ d x)
      (by linarith) (fun x hx => by
        show _ * Ψ d x = 0
        rw [hΨ0 d x (fun hb => hx (Metric.ball_subset_ball (by linarith) hb)), mul_zero])
    exact e.symm
  have hC1 : (∫ x in fcrHalf c s₂, ∑ d : Fin 3,
       ((∑ b : Fin 3, A (x + h • e a) d b * fcrDQ a h (D [b]) x) +
         ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x)) *
         Ψ d x) = ∫ x in fcrHalf c s₂, F x * fcrDQ a (-h) ψ x := by
    rw [hstep1]
    have e3 : (∑ d : Fin 3, ∫ x in fcrHalf c s,
          fcrDQ a h (fun y => (∑ b : Fin 3, A y d b * D [b] y) + G d y) x * Ψ d x) =
        -∑ d : Fin 3, ∫ x in fcrHalf c s,
          ((∑ b : Fin 3, A x d b * D [b] x) + G d x) * fcrDQ a (-h) (Ψ d) x := by
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      rw [hibp d, neg_neg]
    have e4 : ∫ x in fcrHalf c s, F x * fcrDQ a (-h) ψ x =
        ∫ x in fcrHalf c s₂, F x * fcrDQ a (-h) ψ x :=
      hsetint s₂ s (fun x => F x * fcrDQ a (-h) ψ x) (by linarith) (fun x hx => by
        show F x * fcrDQ a (-h) ψ x = 0
        rw [hQ0 x hx, mul_zero])
    rw [e3, ← e4]
    linarith [hsplit]
  
  have hsob : fcrSob c (s - h₀) 1 ψ (fun L => match L with | [] => ψ | d :: _ => Ψ d) := by
    refine ⟨rfl, ?_, ?_⟩
    · intro L hL
      rcases L with _ | ⟨d, _ | ⟨d', t⟩⟩
      · exact hψL
      · exact hΨL d
      · simp at hL
    · intro L d hL ζ h1 h2 h3
      rcases L with _ | ⟨d', t⟩
      · exact hψwd d ζ h1 h2 h3
      · simp at hL
  have hb2 := fcr_dq_sob_L2_bound c (s - h₀) s₂ ψ
    (fun L => match L with | [] => ψ | d :: _ => Ψ d) a ha (-h) hR3 hsob
  have hC2 : ∫ x in fcrHalf c s₂, (fcrDQ a (-h) ψ x) ^ 2 ≤
      ∫ x in fcrHalf c s₂, (Ψ a x) ^ 2 := by
    have e : ∫ x in fcrHalf c (s - h₀), (Ψ a x) ^ 2 = ∫ x in fcrHalf c s₂, (Ψ a x) ^ 2 :=
      hsetint s₂ (s - h₀) (fun x => (Ψ a x) ^ 2) (by linarith) (fun x hx => by
        show (Ψ a x) ^ 2 = 0
        rw [hΨ0 a x (fun hb => hx (Metric.ball_subset_ball (by linarith) hb))]
        ring)
    rw [← e]
    exact hb2
  exact ⟨hC1, hC2, hC3⟩

theorem fcr_wd_of_dq_bound (c : E3) (s s' : ℝ) (φ : E3 → ℝ) (a : Fin 3) (ha : a ≠ 0)
    (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s))) (hseq : ℕ → ℝ) (hne : ∀ j, hseq j ≠ 0)
    (hlt : ∀ j, s' + |hseq j| < s) (hlim : Tendsto hseq atTop (𝓝 0)) (K : ℝ)
    (hK : ∀ j, ∫ x in fcrHalf c s', (fcrDQ a (hseq j) φ x) ^ 2 ≤ K) :
    ∃ χ : E3 → ℝ, fcrWD c s' φ a χ ∧ MemLp χ 2 (volume.restrict (fcrHalf c s')) :=
by
  classical
  
  
  have hW : ∀ {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
      (x : ℕ → H) (B : ℝ), (∀ n, ‖x n‖ ≤ B) → ∃ (φ : ℕ → ℕ) (g : H), StrictMono φ ∧
        ∀ y : H, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 (inner ℝ g y)) := by
    intro H _ _ _ x B hx
    have hB0 : 0 ≤ B := le_trans (norm_nonneg _) (hx 0)
    have hs : IsCompact (Set.univ.pi (fun k : ℕ => Set.Icc (-(B * ‖x k‖)) (B * ‖x k‖))) :=
      isCompact_univ_pi (fun k => isCompact_Icc)
    have hv : ∀ n, (fun k : ℕ => inner ℝ (x n) (x k)) ∈
        Set.univ.pi (fun k : ℕ => Set.Icc (-(B * ‖x k‖)) (B * ‖x k‖)) := by
      intro n
      simp only [Set.mem_pi, Set.mem_univ, true_implies, Set.mem_Icc]
      intro k
      have h1 : |inner ℝ (x n) (x k)| ≤ ‖x n‖ * ‖x k‖ := abs_real_inner_le_norm _ _
      have h2 : ‖x n‖ * ‖x k‖ ≤ B * ‖x k‖ := mul_le_mul_of_nonneg_right (hx n) (norm_nonneg _)
      exact abs_le.mp (h1.trans h2)
    obtain ⟨c, -, φ, hφ, hc⟩ := hs.tendsto_subseq hv
    have hφk : ∀ k, Tendsto (fun m => inner ℝ (x (φ m)) (x k)) atTop (𝓝 (c k)) := by
      intro k
      exact (tendsto_pi_nhds.1 hc) k
    have hz : ∀ m, ‖x (φ m)‖ ≤ B := fun m => hx (φ m)
    let S : Submodule ℝ H :=
      { carrier := {y | ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L)}
        add_mem' := by
          rintro a b ⟨La, ha⟩ ⟨Lb, hb⟩
          refine ⟨La + Lb, ?_⟩
          simpa only [inner_add_right] using ha.add hb
        zero_mem' := ⟨0, by simp⟩
        smul_mem' := by
          rintro r a ⟨La, ha⟩
          refine ⟨r * La, ?_⟩
          simpa only [real_inner_smul_right] using ha.const_mul r }
    have hSmem : ∀ y, y ∈ S ↔ ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L) :=
      fun y => Iff.rfl
    have hScl : IsClosed (S : Set H) := by
      refine isClosed_of_closure_subset ?_
      intro y hy
      have hcs : CauchySeq (fun m => inner ℝ (x (φ m)) y) := by
        rw [Metric.cauchySeq_iff']
        intro ε hε
        have hδ : 0 < ε / (4 * (B + 1)) := by positivity
        obtain ⟨y', hy'S, hyy'⟩ := Metric.mem_closure_iff.1 hy _ hδ
        obtain ⟨L', hL'⟩ := (hSmem y').1 hy'S
        obtain ⟨N, hN⟩ := Metric.cauchySeq_iff'.1 hL'.cauchySeq (ε / 2) (by positivity)
        refine ⟨N, fun n hn => ?_⟩
        have hkey : B * (ε / (4 * (B + 1))) ≤ ε / 4 := by
          rw [← mul_div_assoc, div_le_div_iff₀ (by positivity) (by norm_num)]
          nlinarith
        have hb : ∀ j, |inner ℝ (x (φ j)) (y - y')| ≤ ε / 4 := by
          intro j
          calc |inner ℝ (x (φ j)) (y - y')| ≤ ‖x (φ j)‖ * ‖y - y'‖ := abs_real_inner_le_norm _ _
            _ ≤ B * (ε / (4 * (B + 1))) := by
              apply mul_le_mul (hz j) _ (norm_nonneg _) hB0
              rw [← dist_eq_norm]; exact hyy'.le
            _ ≤ ε / 4 := hkey
        have hsplit : inner ℝ (x (φ n)) y - inner ℝ (x (φ N)) y =
            inner ℝ (x (φ n)) (y - y') + (inner ℝ (x (φ n)) y' - inner ℝ (x (φ N)) y')
              - inner ℝ (x (φ N)) (y - y') := by
          rw [inner_sub_right, inner_sub_right]; ring
        have h1 := hN n hn
        rw [Real.dist_eq] at h1 ⊢
        rw [hsplit]
        have e1 := abs_le.mp (hb n)
        have e2 := abs_le.mp (hb N)
        have e3 := abs_lt.mp h1
        rw [abs_lt]
        constructor <;> linarith [e1.1, e1.2, e2.1, e2.2, e3.1, e3.2]
      obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcs
      exact (hSmem y).2 ⟨L, hL⟩
    let K : Submodule ℝ H := (Submodule.span ℝ (Set.range x)).topologicalClosure
    have hspan : Submodule.span ℝ (Set.range x) ≤ S := by
      rw [Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      exact (hSmem _).2 ⟨c k, hφk k⟩
    have hKS : K ≤ S := Submodule.topologicalClosure_minimal _ hspan hScl
    have hxK : ∀ n, x n ∈ K := fun n =>
      Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨n, rfl⟩)
    have hKoS : Kᗮ ≤ S := by
      intro y hy
      refine (hSmem y).2 ⟨0, ?_⟩
      have h0 : (fun m => inner ℝ (x (φ m)) y) = fun _ => (0 : ℝ) := by
        funext m
        exact Submodule.inner_right_of_mem_orthogonal (hxK (φ m)) hy
      rw [h0]
      exact tendsto_const_nhds
    haveI : CompleteSpace K := (Submodule.isClosed_topologicalClosure _).completeSpace_coe
    have hsup : K ⊔ Kᗮ = ⊤ := Submodule.sup_orthogonal_of_completeSpace
    have hall : ∀ y, ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L) := by
      intro y
      have hy : y ∈ K ⊔ Kᗮ := by rw [hsup]; exact Submodule.mem_top
      exact (hSmem y).1 (sup_le hKS hKoS hy)
    choose f hf using hall
    let T : ℕ → H →L[ℝ] ℝ := fun m => innerSL ℝ (x (φ m))
    have hT : Tendsto (fun m y => T m y) atTop (𝓝 f) := by
      rw [tendsto_pi_nhds]
      intro y
      simpa [T, innerSL_apply] using hf y
    have hTb : Bornology.IsBounded (Set.range T) := by
      rw [isBounded_iff_forall_norm_le]
      refine ⟨B, ?_⟩
      rintro _ ⟨m, rfl⟩
      simp only [T, innerSL_apply_norm]
      exact hz m
    let ℓ : H →L[ℝ] ℝ := ContinuousLinearMap.ofTendstoOfBoundedRange f T hT hTb
    refine ⟨φ, (InnerProductSpace.toDual ℝ H).symm ℓ, hφ, fun y => ?_⟩
    rw [InnerProductSpace.toDual_symm_apply]
    have hℓ : ℓ y = f y := by
      simp [ℓ, ContinuousLinearMap.ofTendstoOfBoundedRange_apply]
    rw [hℓ]
    exact hf y
  
  have hss : s' < s := by
    have h1 := hlt 0
    have h2 := abs_nonneg (hseq 0)
    linarith
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r : ℝ, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hsub : fcrHalf c s' ⊆ fcrHalf c s := by
    intro x hx
    exact ⟨Metric.ball_subset_ball hss.le hx.1, hx.2⟩
  have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
  have hG : ∀ t : ℝ, s' + |t| < s → ∀ x ∈ fcrHalf c s', x + t • e a ∈ fcrHalf c s := by
    intro t ht x hx
    obtain ⟨hx1, hx2⟩ := hx
    refine ⟨?_, ?_⟩
    · have hxb : dist x c < s' := hx1
      have hn : ‖t • e a‖ = |t| := by
        rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
      show dist (x + t • e a) c < s
      have htri : dist (x + t • e a) c ≤ dist x c + ‖t • e a‖ := by
        rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]
        exact norm_add_le _ _
      linarith
    · have hx2' : 0 < x 0 := hx2
      have h0 : (x + t • e a) 0 = x 0 := by
        simp [EuclideanSpace.single_apply, Ne.symm ha]
      show 0 < (x + t • e a) 0
      rw [h0]
      exact hx2'
  
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : E3 → ℝ, ψ = (fcrHalf c s).indicator φ := ⟨_, rfl⟩
  have hψφ : ∀ x ∈ fcrHalf c s, ψ x = φ x := fun x hx => by simp [hψdef, hx]
  have hψL2 : MemLp ψ 2 volume := by
    rw [hψdef]; exact (memLp_indicator_iff_restrict (hmeas s)).2 hφ
  haveI : IsFiniteMeasure (volume.restrict (fcrHalf c s)) := by
    refine isFiniteMeasure_restrict.2 ?_
    exact ((measure_mono (show fcrHalf c s ⊆ Metric.ball c s from Set.inter_subset_left)).trans_lt
      measure_ball_lt_top).ne
  have hψL1 : Integrable ψ := by
    rw [hψdef]; exact (integrable_indicator_iff (hmeas s)).2 (hφ.integrable (by norm_num))
  
  have hdqψ : ∀ t : ℝ, MemLp (fcrDQ a t ψ) 2 volume := by
    intro t
    have h1 : MemLp (fun x => ψ (x + t • e a)) 2 volume :=
      hψL2.comp_measurePreserving (measurePreserving_add_right volume (t • e a))
    have h2 := (h1.sub hψL2).mul_const t⁻¹
    convert h2 using 1
  have hdqEq : ∀ t : ℝ, s' + |t| < s → ∀ x ∈ fcrHalf c s', fcrDQ a t φ x = fcrDQ a t ψ x := by
    intro t ht x hx
    simp only [fcrDQ, hψφ x (hsub hx), hψφ _ (hG t ht x hx)]
  have hf : ∀ j, MemLp (fcrDQ a (hseq j) φ) 2 (volume.restrict (fcrHalf c s')) := by
    intro j
    refine ((hdqψ (hseq j)).restrict (fcrHalf c s')).ae_eq ?_
    filter_upwards [ae_restrict_mem (hmeas s')] with x hx
    exact (hdqEq _ (hlt j) x hx).symm
  
  obtain ⟨X, hX⟩ : ∃ X : ℕ → Lp ℝ 2 (volume.restrict (fcrHalf c s')),
      ∀ j, X j = (hf j).toLp _ := ⟨fun j => (hf j).toLp _, fun j => rfl⟩
  have hXae : ∀ j, (X j : E3 → ℝ) =ᵐ[volume.restrict (fcrHalf c s')] fcrDQ a (hseq j) φ :=
    fun j => by rw [hX j]; exact (hf j).coeFn_toLp
  have hXb : ∀ j, ‖X j‖ ≤ max K 0 + 1 := by
    intro j
    have h1 : ‖X j‖ ^ 2 = ∫ x in fcrHalf c s', (fcrDQ a (hseq j) φ x) ^ 2 := by
      rw [← real_inner_self_eq_norm_sq, L2.inner_def]
      refine integral_congr_ae ?_
      filter_upwards [hXae j] with x hx
      rw [hx]; simp [sq]
    have h2 := hK j
    have h3 := norm_nonneg (X j)
    nlinarith [le_max_left K 0, le_max_right K 0, sq_nonneg (‖X j‖ - 1)]
  obtain ⟨σ, g, hσ, hconv⟩ := hW X (max K 0 + 1) hXb
  refine ⟨(g : E3 → ℝ), ?_, Lp.memLp g⟩
  intro ζ hζ hζc hζs
  have hζcont : Continuous ζ := hζ.continuous
  have hζd : Differentiable ℝ ζ := hζ.differentiable (by simp)
  have hV : ∀ x, x ∉ fcrHalf c s' → ζ x = 0 := fun x hx =>
    image_eq_zero_of_notMem_tsupport (fun h => hx (hζs h))
  obtain ⟨C₀, hC₀⟩ := Continuous.bounded_above_of_compact_support
    (hζ.continuous_fderiv (by simp)) (hζc.fderiv ℝ)
  obtain ⟨Cz, hCz⟩ := Continuous.bounded_above_of_compact_support hζcont hζc
  have hbddmul : ∀ (u w : E3 → ℝ) (C : ℝ), Integrable u → Continuous w → (∀ x, ‖w x‖ ≤ C) →
      Integrable (fun x => u x * w x) := by
    intro u w C hu hw hC
    refine (hu.norm.const_mul C).mono' (hu.aestronglyMeasurable.mul hw.aestronglyMeasurable)
      (Eventually.of_forall fun x => ?_)
    rw [norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (hC x) (norm_nonneg _)
  
  have hIBP : ∀ h : ℝ, h ≠ 0 → ∫ x, fcrDQ a h ψ x * ζ x = -∫ x, ψ x * fcrDQ a (-h) ζ x := by
    intro h hh
    have i1 : Integrable (fun x => ψ (x + h • e a) * ζ x) :=
      hbddmul (fun x => ψ (x + h • e a)) ζ Cz (hψL1.comp_add_right _) hζcont hCz
    have i2 : Integrable (fun x => ψ x * ζ x) := hbddmul ψ ζ Cz hψL1 hζcont hCz
    have i3 : Integrable (fun x => ψ x * ζ (x + (-h) • e a)) :=
      hbddmul ψ (fun x => ζ (x + (-h) • e a)) Cz hψL1 (hζcont.comp (continuous_add_right _))
        (fun x => hCz _)
    have e1 : (fun x => fcrDQ a h ψ x * ζ x) =
        fun x => (ψ (x + h • e a) * ζ x - ψ x * ζ x) * h⁻¹ := by
      funext x; simp only [fcrDQ, div_eq_mul_inv]; ring
    have e2 : (fun x => ψ x * fcrDQ a (-h) ζ x) =
        fun x => (ψ x * ζ (x + (-h) • e a) - ψ x * ζ x) * (-h)⁻¹ := by
      funext x; simp only [fcrDQ, div_eq_mul_inv]; ring
    have hshift : ∫ x, ψ (x + h • e a) * ζ x = ∫ x, ψ x * ζ (x + (-h) • e a) := by
      have h0 := integral_add_right_eq_self (μ := volume)
        (fun y => ψ y * ζ (y + (-h) • e a)) (h • e a)
      rw [← h0]
      congr 1
      funext x
      rw [add_assoc, ← add_smul, add_neg_cancel, zero_smul, add_zero]
    rw [e1, e2, integral_mul_const, integral_mul_const, integral_sub i1 i2, integral_sub i3 i2,
      hshift, inv_neg]
    ring
  
  have hdqcont : ∀ t : ℝ, Continuous (fcrDQ a t ζ) := fun t => by
    show Continuous (fun x => (ζ (x + t • e a) - ζ x) / t)
    exact ((hζcont.comp (continuous_add_right _)).sub hζcont).div_const t
  have hdqb : ∀ t : ℝ, t ≠ 0 → ∀ x, ‖fcrDQ a t ζ x‖ ≤ max C₀ 0 := by
    intro t ht x
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (s := Set.univ)
      (fun z _ => hζd z) (fun z _ => (hC₀ z).trans (le_max_left C₀ 0)) convex_univ
      (Set.mem_univ x) (Set.mem_univ (x + t • e a))
    rw [add_sub_cancel_left, norm_smul, hea, mul_one, Real.norm_eq_abs] at hmvt
    rw [fcrDQ, norm_div, Real.norm_eq_abs t, div_le_iff₀ (abs_pos.2 ht)]
    exact hmvt
  have hslope : ∀ x, Tendsto (fun j => fcrDQ a (-hseq j) ζ x) atTop (𝓝 (partialDeriv a ζ x)) := by
    intro x
    have h1 : HasDerivAt (fun t : ℝ => x + t • e a) (e a) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (e a)).const_add x
    have h2 : HasFDerivAt ζ (fderiv ℝ ζ x) (x + (0 : ℝ) • e a) := by
      rw [zero_smul, add_zero]; exact (hζd x).hasFDerivAt
    have hk : HasDerivAt (fun t : ℝ => ζ (x + t • e a)) (fderiv ℝ ζ x (e a)) 0 :=
      h2.comp_hasDerivAt (0 : ℝ) h1
    have hT := hasDerivAt_iff_tendsto_slope_zero.1 hk
    have hs : Tendsto (fun j => -hseq j) atTop (𝓝[≠] 0) := by
      refine tendsto_nhdsWithin_iff.2 ⟨?_, Eventually.of_forall fun j => ?_⟩
      · simpa using hlim.neg
      · simpa using hne j
    refine (hT.comp hs).congr (fun j => ?_)
    simp only [Function.comp, fcrDQ, zero_add, zero_smul, add_zero, smul_eq_mul, div_eq_inv_mul]
  have hDCT : Tendsto (fun j => ∫ x, ψ x * fcrDQ a (-hseq j) ζ x) atTop
      (𝓝 (∫ x, ψ x * partialDeriv a ζ x)) := by
    refine tendsto_integral_of_dominated_convergence (fun x => max C₀ 0 * ‖ψ x‖)
      (fun j => ?_) (hψL1.norm.const_mul _) (fun j => Eventually.of_forall fun x => ?_)
      (Eventually.of_forall fun x => ?_)
    · exact hψL1.aestronglyMeasurable.mul (hdqcont (-hseq j)).aestronglyMeasurable
    · rw [norm_mul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hdqb _ (neg_ne_zero.2 (hne j)) x) (norm_nonneg _)
    · exact (hslope x).const_mul (ψ x)
  
  have hζL2 : MemLp ζ 2 (volume.restrict (fcrHalf c s')) :=
    (hζcont.memLp_of_hasCompactSupport hζc).restrict _
  have hfull : ∀ w : E3 → ℝ, ∫ x in fcrHalf c s', w x * ζ x = ∫ x, w x * ζ x := fun w =>
    setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by rw [hV x hx, mul_zero])
  have hin : ∀ u : Lp ℝ 2 (volume.restrict (fcrHalf c s')),
      inner ℝ u (hζL2.toLp ζ) = ∫ x, u x * ζ x := by
    intro u
    rw [L2.inner_def, ← hfull]
    refine integral_congr_ae ?_
    filter_upwards [hζL2.coeFn_toLp] with x hx
    rw [hx]; simp [mul_comm]
  have hpair : ∀ j, inner ℝ (X j) (hζL2.toLp ζ) = -∫ x, ψ x * fcrDQ a (-hseq j) ζ x := by
    intro j
    rw [hin, ← hIBP (hseq j) (hne j), ← hfull (X j), ← hfull (fcrDQ a (hseq j) ψ)]
    refine integral_congr_ae ?_
    filter_upwards [hXae j, ae_restrict_mem (hmeas s')] with x hx hxm
    rw [hx, hdqEq _ (hlt j) x hxm]
  have hφψ : ∫ x, φ x * partialDeriv a ζ x = ∫ x, ψ x * partialDeriv a ζ x := by
    refine integral_congr_ae (Eventually.of_forall fun x => ?_)
    by_cases hx : x ∈ fcrHalf c s
    · simp only [hψφ x hx]
    · have hxt : x ∉ tsupport ζ := fun h => hx (hsub (hζs h))
      have h0 : fderiv ℝ ζ x = 0 := by
        by_contra hne'
        exact hxt (support_fderiv_subset ℝ hne')
      simp only [partialDeriv, h0, ContinuousLinearMap.zero_apply, mul_zero]
  have h1 : Tendsto (fun m => inner ℝ (X (σ m)) (hζL2.toLp ζ)) atTop
      (𝓝 (-∫ x, ψ x * partialDeriv a ζ x)) :=
    (hDCT.comp hσ.tendsto_atTop).neg.congr (fun m => (hpair (σ m)).symm)
  have h2 := tendsto_nhds_unique (hconv (hζL2.toLp ζ)) h1
  rw [hin] at h2
  rw [hφψ]
  linarith

theorem fcr_tangential_energy (c : E3) (R s s' : ℝ) (hs' : 0 < s') (hss : s' < s) (hsR : s < R)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hAs : ∀ x ∈ Metric.ball c R, ∀ a b : Fin 3, A x a b = A x b a)
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef)
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fcrProb c s A w D G F) (hG : ∀ d, ∃ DG, fcrSob c s 1 (G d) DG)
    (a : Fin 3) (ha : a ≠ 0) (b : Fin 3) :
    ∃ χ : E3 → ℝ, fcrWD c s' (D [b]) a χ ∧ MemLp χ 2 (volume.restrict (fcrHalf c s')) :=
by
  
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = (s - s') / 4 := ⟨_, rfl⟩
  have hδ0 : 0 < δ := by rw [hδ]; linarith
  have hδs : s' + 4 * δ = s := by rw [hδ]; ring
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
  
  obtain ⟨η, hηin, hηout⟩ : ∃ η : ContDiffBump c, η.rIn = s' ∧ η.rOut = s' + δ :=
    ⟨⟨s', s' + δ, hs', by linarith⟩, rfl, rfl⟩
  have hηc1 : ContDiff ℝ 1 (⇑η) := η.contDiff
  have hfdc : Continuous (fderiv ℝ (⇑η)) := hηc1.continuous_fderiv (by norm_num)
  obtain ⟨C₀, hC₀⟩ := Continuous.bounded_above_of_compact_support hfdc
    (η.hasCompactSupport.fderiv ℝ)
  have hdη : ∀ (d : Fin 3) (x : E3), |partialDeriv d (⇑η) x| ≤ max C₀ 0 := by
    intro d x
    have hed : ‖e d‖ = 1 := by simp [EuclideanSpace.norm_single]
    have h1 : ‖fderiv ℝ (⇑η) x (e d)‖ ≤ ‖fderiv ℝ (⇑η) x‖ * ‖e d‖ :=
      ContinuousLinearMap.le_opNorm _ _
    rw [hed, mul_one, Real.norm_eq_abs] at h1
    exact h1.trans ((hC₀ x).trans (le_max_left _ _))
  have hdηc : ∀ d : Fin 3, Continuous (fun x => partialDeriv d (⇑η) x) := by
    intro d
    exact hfdc.clm_apply continuous_const
  
  obtain ⟨lam, Λ, M, hlam, hΛ, hM, hbd⟩ := fcr_dq_bounds c R s (s' + 2 * δ) (s' + 3 * δ)
    (δ / 2) (by linarith) (by linarith) (by linarith) (by linarith) hsR A hA hApos w D G F hP hG
    a ha
  obtain ⟨K, hK0, hK⟩ := fcr_energy_absorb lam Λ (max C₀ 0) hlam hΛ (le_max_right _ _)
  
  have hU : ∀ h : ℝ, h ≠ 0 → |h| ≤ δ / 2 →
      ∫ x in fcrHalf c s', (fcrDQ a h (D [b]) x) ^ 2 ≤ K * M := by
    intro h hh hhh
    obtain ⟨hco, hB, hu, hUd, hR, hF, hum, hRm, hFm⟩ := hbd h hh hhh
    obtain ⟨hid, hQb, hQm⟩ := fcr_dq_identity c R s s' (s' + δ) (s' + 2 * δ) (s' + 3 * δ)
      (δ / 2) hs' (by linarith) (by linarith) (by linarith) (by linarith) (by linarith) hsR A hA
      w D G F hP hG η hηout a ha h hh hhh
    have hBm : ∀ i j : Fin 3, AEStronglyMeasurable (fun x => A (x + h • e a) i j)
        (volume.restrict (fcrHalf c (s' + 2 * δ))) := by
      intro i j
      refine ContinuousOn.aestronglyMeasurable ?_ (hopen _).measurableSet
      have hmaps : Set.MapsTo (fun x : E3 => x + h • e a) (fcrHalf c (s' + 2 * δ))
          (Metric.ball c R) := by
        intro x hx
        have hx' : x ∈ Metric.ball c (s' + 2 * δ) ∧ 0 < x 0 := hx
        have hxb : dist x c < s' + 2 * δ := hx'.1
        have hn : ‖h • e a‖ ≤ δ / 2 := by
          rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
          exact hhh
        show dist (x + h • e a) c < R
        have htri : dist (x + h • e a) c ≤ dist x c + ‖h • e a‖ := by
          rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]
          exact norm_add_le _ _
        linarith
      exact (hA i j).continuousOn.comp (continuous_add_right (h • e a)).continuousOn hmaps
    have hmain := hK (fcrHalf c (s' + 2 * δ)) (fun x i j => A (x + h • e a) i j) (⇑η)
      (fcrDQ a h w) F (fcrDQ a (-h) (fun y => η y ^ 2 * fcrDQ a h w y))
      (fun d => partialDeriv d (⇑η)) (fun d => fcrDQ a h (D [d]))
      (fun d x => (∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x)
      M a (hopen _).measurableSet hM hco hB hBm η.continuous
      (fun x => ⟨η.nonneg, η.le_one⟩) hdηc hdη hu hUd hR hF hQm hum hRm hFm hQb hid
    have hsum : Integrable (fun x => ∑ d : Fin 3, fcrDQ a h (D [d]) x ^ 2)
        (volume.restrict (fcrHalf c (s' + 2 * δ))) :=
      integrable_finset_sum _ (fun d _ => (hUd d).integrable_sq)
    have hint2 : IntegrableOn (fun x => η x ^ 2 * ∑ d : Fin 3, fcrDQ a h (D [d]) x ^ 2)
        (fcrHalf c (s' + 2 * δ)) := by
      refine hsum.mono' ?_ ?_
      · exact (η.continuous.pow 2).aestronglyMeasurable.mul hsum.aestronglyMeasurable
      · refine Filter.Eventually.of_forall (fun x => ?_)
        have h0 : 0 ≤ ∑ d : Fin 3, fcrDQ a h (D [d]) x ^ 2 :=
          Finset.sum_nonneg (fun d _ => sq_nonneg _)
        have h1 : 0 ≤ η x ^ 2 := sq_nonneg _
        have h2 : η x ^ 2 ≤ 1 := by
          have e1 := η.nonneg (x := x)
          have e2 := η.le_one (x := x)
          nlinarith
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg h1 h0)]
        nlinarith
    have hsub : fcrHalf c s' ⊆ fcrHalf c (s' + 2 * δ) := by
      intro x hx
      have hx' : x ∈ Metric.ball c s' ∧ 0 < x 0 := hx
      exact ⟨Metric.ball_subset_ball (by linarith) hx'.1, hx'.2⟩
    have hb1 : IntegrableOn (fun x => fcrDQ a h (D [b]) x ^ 2) (fcrHalf c s') :=
      (show IntegrableOn (fun x => fcrDQ a h (D [b]) x ^ 2) (fcrHalf c (s' + 2 * δ)) volume from
        (hUd b).integrable_sq).mono_set hsub
    calc ∫ x in fcrHalf c s', (fcrDQ a h (D [b]) x) ^ 2
        ≤ ∫ x in fcrHalf c s', η x ^ 2 * ∑ d : Fin 3, fcrDQ a h (D [d]) x ^ 2 := by
          refine setIntegral_mono_on hb1 (hint2.mono_set hsub) (hopen _).measurableSet ?_
          intro x hx
          have hx' : x ∈ Metric.ball c s' ∧ 0 < x 0 := hx
          have hη1 : η x = 1 := η.one_of_mem_closedBall (by
            rw [hηin]; exact Metric.ball_subset_closedBall hx'.1)
          rw [hη1, one_pow, one_mul]
          exact Finset.single_le_sum (f := fun d => fcrDQ a h (D [d]) x ^ 2)
            (fun d _ => sq_nonneg _) (Finset.mem_univ b)
      _ ≤ ∫ x in fcrHalf c (s' + 2 * δ), η x ^ 2 * ∑ d : Fin 3, fcrDQ a h (D [d]) x ^ 2 := by
          refine setIntegral_mono_set hint2 ?_ hsub.eventuallyLE
          exact Filter.Eventually.of_forall (fun x =>
            mul_nonneg (sq_nonneg _) (Finset.sum_nonneg (fun d _ => sq_nonneg _)))
      _ ≤ K * M := hmain
  
  have hne : ∀ j : ℕ, δ / 2 / ((j : ℝ) + 2) ≠ 0 := by
    intro j
    have hj : (0 : ℝ) < (j : ℝ) + 2 := by positivity
    exact div_ne_zero (by linarith) (ne_of_gt hj)
  have hseqb : ∀ j : ℕ, |δ / 2 / ((j : ℝ) + 2)| ≤ δ / 2 := by
    intro j
    have hj : (1 : ℝ) ≤ (j : ℝ) + 2 := by
      have := Nat.cast_nonneg (α := ℝ) j
      linarith
    rw [abs_of_nonneg (div_nonneg (by linarith) (by linarith))]
    exact div_le_self (by linarith) hj
  have hlim : Tendsto (fun j : ℕ => δ / 2 / ((j : ℝ) + 2)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop
      (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
  exact fcr_wd_of_dq_bound c s s' (D [b]) a ha (hP.1.2.1 [b] (by simp))
    (fun j => δ / 2 / ((j : ℝ) + 2)) hne
    (fun j => by have := hseqb j; linarith) hlim (K * M)
    (fun j => hU _ (hne j) (hseqb j))

theorem fcr_regularity_all_orders (c : E3) (R ρ ρ' : ℝ) (hρ' : 0 < ρ') (hρρ' : ρ' < ρ)
    (hρR : ρ < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hAs : ∀ x ∈ Metric.ball c R, ∀ a b : Fin 3, A x a b = A x b a)
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef)
    (F : E3 → ℝ) (hF : ContDiffOn ℝ ∞ F (Metric.ball c R))
    (w : E3 → ℝ) (D1 : List (Fin 3) → E3 → ℝ) (hw : fcrSob c ρ 1 w D1)
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c ρ →
      ∫ x in fcrHalf c ρ,
        (∑ a : Fin 3, ∑ b : Fin 3, A x a b * D1 [b] x * partialDeriv a ζ x + F x * ζ x) = 0) :
    ∀ k : ℕ, ∃ D : List (Fin 3) → E3 → ℝ, fcrSob c ρ' k w D :=
by
  
  have hmem : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ),
      fcrSob c s k φ D → MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    intro s k φ D h
    have h0 := h.2.1 [] (Nat.zero_le _)
    rwa [h.1] at h0
  have hmemH : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ), (∃ D, fcrSob c s k φ D) →
      MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    rintro s k φ ⟨D, h⟩
    exact hmem s k φ D h
  have hfirst : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ),
      fcrSob c s (k + 1) φ D → ∀ a, fcrWD c s φ a (D [a]) ∧
        MemLp (D [a]) 2 (volume.restrict (fcrHalf c s)) := by
    intro s k φ D h a
    refine ⟨fun ζ h1 h2 h3 => ?_, h.2.1 [a] (by simp)⟩
    have h0 := h.2.2 [] a (by simp) ζ h1 h2 h3
    rw [h.1] at h0
    exact h0
  have hL2 : ∀ (s : ℝ) (χ : E3 → ℝ), MemLp χ 2 (volume.restrict (fcrHalf c s)) →
      ∃ D, fcrSob c s 0 χ D := by
    intro s χ hχ
    exact ⟨fun _ => χ, rfl, fun _ _ => hχ, fun _ _ hL => absurd hL (Nat.not_lt_zero _)⟩
  have hHmono : ∀ (s s' : ℝ) (k k' : ℕ) (φ : E3 → ℝ), s' ≤ s → k' ≤ k →
      (∃ D, fcrSob c s k φ D) → ∃ D, fcrSob c s' k' φ D := by
    rintro s s' k k' φ hss hk ⟨D, hD⟩
    exact ⟨D, (fcr_sob_mono c s s' hss).1 k k' φ D hk hD⟩
  have hadd : ∀ (s : ℝ) (k : ℕ) (φ₁ φ₂ : E3 → ℝ), (∃ D, fcrSob c s k φ₁ D) →
      (∃ D, fcrSob c s k φ₂ D) → ∃ D, fcrSob c s k (fun x => φ₁ x + φ₂ x) D := by
    rintro s k φ₁ φ₂ ⟨D₁, h₁⟩ ⟨D₂, h₂⟩
    exact ⟨_, fcr_sob_add c s k φ₁ φ₂ D₁ D₂ h₁ h₂⟩
  have hsum3 : ∀ (s : ℝ) (k : ℕ) (φ : Fin 3 → E3 → ℝ), (∀ b, ∃ D, fcrSob c s k (φ b) D) →
      ∃ D, fcrSob c s k (fun x => ∑ b : Fin 3, φ b x) D := by
    intro s k φ h
    have h012 := hadd s k _ _ (hadd s k _ _ (h 0) (h 1)) (h 2)
    have he : (fun x => ∑ b : Fin 3, φ b x) = (fun x => (φ 0 x + φ 1 x) + φ 2 x) := by
      funext x
      simp [Fin.sum_univ_three]
    rw [he]
    exact h012
  have hpd : ∀ (m : E3 → ℝ) (a : Fin 3), ContDiffOn ℝ ∞ m (Metric.ball c R) →
      ContDiffOn ℝ ∞ (partialDeriv a m) (Metric.ball c R) := by
    intro m a hm
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ m y (e a)) (Metric.ball c R)
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 hm).2.clm_apply
      contDiffOn_const
  have hsmulH : ∀ (s : ℝ) (k : ℕ) (m φ : E3 → ℝ), s < R → ContDiffOn ℝ ∞ m (Metric.ball c R) →
      (∃ D, fcrSob c s k φ D) → ∃ D, fcrSob c s k (fun x => m x * φ x) D := by
    rintro s k m φ hs hm ⟨D, hD⟩
    exact fcr_sob_smul c R s hs m hm k φ D hD
  
  have hassemble : ∀ (s : ℝ) (j : ℕ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (E : Fin 3 → Fin 3 → E3 → ℝ) (Z : E3 → ℝ),
      (∀ b, fcrWD c s v b (D [b])) →
      (∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s))) →
      (∀ a b, a ≠ 0 → fcrWD c s (D [b]) a (E a b) ∧ ∃ D', fcrSob c s j (E a b) D') →
      fcrWD c s (D [0]) 0 Z → (∃ D', fcrSob c s j Z D') →
      ∀ b, ∃ D', fcrSob c s (j + 1) (D [b]) D' := by
    intro s j v D E Z hv hDm hE hZ hZs b
    refine (fcr_sob_succ_iff c s j (D [b])).2 ⟨hDm b, fun a => ?_⟩
    by_cases ha : a = 0
    · subst ha
      by_cases hb : b = 0
      · subst hb
        exact ⟨Z, hZ, hZs⟩
      · exact ⟨E b 0, fcr_weak_symm c s b 0 v (D [b]) (D [0]) (E b 0) (hv b) (hv 0)
          (hE b 0 hb).1, (hE b 0 hb).2⟩
    · exact ⟨E a b, (hE a b ha).1, (hE a b ha).2⟩
  
  have hQ : ∀ k : ℕ, ∀ (s' s : ℝ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (G : Fin 3 → E3 → ℝ) (Fs : E3 → ℝ), 0 < s' → s' < s → s < R →
      fcrProb c s A v D G Fs → (∀ d, ∃ DG, fcrSob c s (k + 1) (G d) DG) →
      (∃ DF, fcrSob c s k Fs DF) → ∀ b, ∃ D', fcrSob c s' (k + 1) (D [b]) D' := by
    intro k
    induction k with
    | zero =>
      intro s' s v D G Fs hs' hss hsR hP hG hFs
      have hP' := fcr_prob_mono c s s' hss.le A v D G Fs hP
      have hs'R : s' < R := hss.trans hsR
      have hm := fcr_sob_mono c s s' hss.le
      
      have hT : ∀ a b : Fin 3, ∃ χ : E3 → ℝ, a ≠ 0 →
          (fcrWD c s' (D [b]) a χ ∧ MemLp χ 2 (volume.restrict (fcrHalf c s'))) := by
        intro a b
        by_cases ha : a = 0
        · exact ⟨0, fun h => absurd ha h⟩
        · obtain ⟨χ, h1, h2⟩ := fcr_tangential_energy c R s s' hs' hss hsR A hA hAs hApos
            v D G Fs hP hG a ha b
          exact ⟨χ, fun _ => ⟨h1, h2⟩⟩
      choose E hE using hT
      choose DG hDG using hG
      have hGD : ∀ a, fcrWD c s' (G a) a (DG a [a]) ∧
          MemLp (DG a [a]) 2 (volume.restrict (fcrHalf c s')) := by
        intro a
        obtain ⟨h1, h2⟩ := hfirst s 0 (G a) (DG a) (hDG a) a
        exact ⟨hm.2.1 _ _ _ h1, hm.2.2 _ h2⟩
      have hZ := fcr_normal_step c R s' hs'R A hA hApos v D G Fs hP' E (fun a => DG a [a])
        hE hGD
      have hZs := fcr_normalZ_sob c R s' hs'R A hA hApos 0 D E (fun a => DG a [a]) Fs
        (fun b => hL2 s' _ (hP'.1.2.1 [b] (by simp)))
        (fun a b ha => hL2 s' _ (hE a b ha).2)
        (fun a => hL2 s' _ (hGD a).2)
        (hL2 s' _ hP'.2.2.1)
      exact hassemble s' 0 v D E _ (fun b => (hfirst s' 0 v D hP'.1 b).1)
        (fun b => (hfirst s' 0 v D hP'.1 b).2)
        (fun a b ha => ⟨(hE a b ha).1, hL2 s' _ (hE a b ha).2⟩) hZ hZs
    | succ k ih =>
      intro s' s v D G Fs hs' hss hsR hP hG hFs
      obtain ⟨s₁, hs₁⟩ : ∃ s₁ : ℝ, s₁ = (s' + s) / 2 := ⟨_, rfl⟩
      have hs'1 : s' < s₁ := by rw [hs₁]; linarith
      have hs1s : s₁ < s := by rw [hs₁]; linarith
      have hs1R : s₁ < R := hs1s.trans hsR
      have hs'R : s' < R := hss.trans hsR
      have hs1pos : 0 < s₁ := hs'.trans hs'1
      have hP₁ := fcr_prob_mono c s s₁ hs1s.le A v D G Fs hP
      have hm1 := fcr_sob_mono c s s₁ hs1s.le
      have hm2 := fcr_sob_mono c s₁ s' hs'1.le
      have hm3 := fcr_sob_mono c s s' hss.le
      
      have hDb : ∀ b, ∃ D', fcrSob c s₁ (k + 1) (D [b]) D' :=
        ih s₁ s v D G Fs hs1pos hs1s hsR hP
          (fun d => hHmono s s (k + 1 + 1) (k + 1) (G d) le_rfl (by omega) (hG d))
          (hHmono s s (k + 1) k Fs le_rfl (by omega) hFs)
      choose Db hDbs using hDb
      have hE1 : ∀ a b, fcrWD c s₁ (D [b]) a (Db b [a]) ∧
          MemLp (Db b [a]) 2 (volume.restrict (fcrHalf c s₁)) :=
        fun a b => hfirst s₁ k (D [b]) (Db b) (hDbs b) a
      
      have hGd : ∀ d a, ∃ ψ, fcrWD c s (G d) a ψ ∧ ∃ D', fcrSob c s (k + 1) ψ D' :=
        fun d => ((fcr_sob_succ_iff c s (k + 1) (G d)).1 (hG d)).2
      choose Gd hGdw hGds using hGd
      have hFd : ∀ a, ∃ ψ, fcrWD c s Fs a ψ ∧ ∃ D', fcrSob c s k ψ D' :=
        ((fcr_sob_succ_iff c s k Fs).1 hFs).2
      choose Fd hFdw hFds using hFd
      
      have hEH : ∀ a b, a ≠ 0 → ∃ D', fcrSob c s' (k + 1) (Db b [a]) D' := by
        intro a b ha
        have hPa := fcr_diff_problem c R s₁ hs1R A hA v D G Fs hP₁ a ha (fun b => Db b [a])
          (fun b => hE1 a b) (fun d => Gd d a)
          (fun d => ⟨hm1.2.1 _ _ _ (hGdw d a), hm1.2.2 _ (hmemH s (k + 1) _ (hGds d a))⟩)
          (Fd a) ⟨hm1.2.1 _ _ _ (hFdw a), hm1.2.2 _ (hmemH s k _ (hFds a))⟩
        have hG' : ∀ d, ∃ DG, fcrSob c s₁ (k + 1)
            (fun x => (∑ b : Fin 3, partialDeriv a (fun y => A y d b) x * D [b] x) + Gd d a x)
            DG := by
          intro d
          exact hadd s₁ (k + 1) _ _
            (hsum3 s₁ (k + 1) (fun b x => partialDeriv a (fun y => A y d b) x * D [b] x)
              (fun b => hsmulH s₁ (k + 1) _ _ hs1R (hpd _ a (hA d b)) ⟨Db b, hDbs b⟩))
            (hHmono s s₁ (k + 1) (k + 1) _ hs1s.le le_rfl (hGds d a))
        exact ih s' s₁ (D [a]) _ _ (Fd a) hs' hs'1 hs1R hPa hG'
          (hHmono s s₁ k k _ hs1s.le le_rfl (hFds a)) b
      
      have hZ := fcr_normal_step c R s₁ hs1R A hA hApos v D G Fs hP₁ (fun a b => Db b [a])
        (fun a => Gd a a) (fun a b _ => hE1 a b)
        (fun a => ⟨hm1.2.1 _ _ _ (hGdw a a), hm1.2.2 _ (hmemH s (k + 1) _ (hGds a a))⟩)
      have hZs := fcr_normalZ_sob c R s' hs'R A hA hApos (k + 1) D (fun a b => Db b [a])
        (fun a => Gd a a) Fs
        (fun b => hHmono s₁ s' (k + 1) (k + 1) _ hs'1.le le_rfl ⟨Db b, hDbs b⟩)
        (fun a b ha => hEH a b ha)
        (fun a => hHmono s s' (k + 1) (k + 1) _ hss.le le_rfl (hGds a a))
        (hHmono s s' (k + 1) (k + 1) _ hss.le le_rfl hFs)
      
      exact hassemble s' (k + 1) v D (fun a b => Db b [a]) _
        (fun b => hm3.2.1 _ _ _ (hfirst s 0 v D hP.1 b).1)
        (fun b => hm3.2.2 _ (hfirst s 0 v D hP.1 b).2)
        (fun a b ha => ⟨hm2.2.1 _ _ _ (hE1 a b).1, hEH a b ha⟩)
        (hm2.2.1 _ _ _ hZ) hZs
  
  have hF0 : MemLp F 2 (volume.restrict (fcrHalf c ρ)) := by
    obtain ⟨DF, hDF⟩ := fcr_smooth_sob c R ρ hρR F hF 0
    exact hmem ρ 0 F DF hDF
  have hP0 : fcrProb c ρ A w D1 (fun _ _ => 0) F := by
    refine ⟨hw, fun _ => MemLp.zero', hF0, fun ζ h1 h2 h3 => ?_⟩
    refine Eq.trans ?_ (hweak ζ h1 h2 h3)
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [add_zero, Finset.sum_mul]
  
  intro k
  cases k with
  | zero => exact ⟨D1, (fcr_sob_mono c ρ ρ' hρρ'.le).1 1 0 w D1 (by norm_num) hw⟩
  | succ j =>
    have hb := hQ j ρ' ρ w D1 (fun _ _ => 0) F hρ' hρρ' hρR hP0
      (fun _ => fcr_smooth_sob c R ρ hρR (fun _ => 0) contDiffOn_const (j + 1))
      (fcr_smooth_sob c R ρ hρR F hF j)
    have hm := fcr_sob_mono c ρ ρ' hρρ'.le
    refine (fcr_sob_succ_iff c ρ' j w).2 ⟨hm.2.2 _ (hmem ρ 1 w D1 hw), fun b => ?_⟩
    exact ⟨D1 [b], hm.2.1 _ _ _ (hfirst ρ 0 w D1 hw b).1,
      hHmono ρ' ρ' (j + 1) j _ le_rfl (by omega) (hb b)⟩

theorem box_iterated_sobolev (x₀ x₁ x₂ τ : ℝ) (hτ : 0 < τ)
    (f f0 f1 f10 f2 f20 f21 f210 : ℝ → ℝ → ℝ → ℝ)
    (hc : ∀ F ∈ ([f, f0, f1, f10, f2, f20, f21, f210] : List (ℝ → ℝ → ℝ → ℝ)),
      ContinuousOn (fun p : ℝ × ℝ × ℝ => F p.1 p.2.1 p.2.2)
        (Set.Icc x₀ (x₀ + τ) ×ˢ (Set.Icc x₁ (x₁ + τ) ×ˢ Set.Icc x₂ (x₂ + τ))))
    (h0 : ∀ t ∈ Set.Icc x₀ (x₀ + τ), ∀ s ∈ Set.Icc x₁ (x₁ + τ), ∀ r ∈ Set.Icc x₂ (x₂ + τ),
      HasDerivAt (fun t' => f t' s r) (f0 t s r) t)
    (h1 : ∀ t ∈ Set.Icc x₀ (x₀ + τ), ∀ s ∈ Set.Icc x₁ (x₁ + τ), ∀ r ∈ Set.Icc x₂ (x₂ + τ),
      HasDerivAt (fun s' => f t s' r) (f1 t s r) s ∧
      HasDerivAt (fun s' => f0 t s' r) (f10 t s r) s)
    (h2 : ∀ t ∈ Set.Icc x₀ (x₀ + τ), ∀ s ∈ Set.Icc x₁ (x₁ + τ), ∀ r ∈ Set.Icc x₂ (x₂ + τ),
      HasDerivAt (fun r' => f t s r') (f2 t s r) r ∧
      HasDerivAt (fun r' => f0 t s r') (f20 t s r) r ∧
      HasDerivAt (fun r' => f1 t s r') (f21 t s r) r ∧
      HasDerivAt (fun r' => f10 t s r') (f210 t s r) r) :
    f x₀ x₁ x₂ ^ 2 ≤ (1 + 1 / τ) ^ 3 *
      (([f, f0, f1, f10, f2, f20, f21, f210] : List (ℝ → ℝ → ℝ → ℝ)).map
        (fun F => ∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F t s r ^ 2)).sum :=
by
  have hC : 0 ≤ 1 + 1 / τ := by positivity
  have hx₀ : x₀ ∈ Set.Icc x₀ (x₀ + τ) := ⟨le_rfl, by linarith⟩
  have hx₁ : x₁ ∈ Set.Icc x₁ (x₁ + τ) := ⟨le_rfl, by linarith⟩
  have hx₂ : x₂ ∈ Set.Icc x₂ (x₂ + τ) := ⟨le_rfl, by linarith⟩
  
  have line : ∀ (a : ℝ) (h h' : ℝ → ℝ), (∀ t ∈ Set.Icc a (a + τ), HasDerivAt h (h' t) t) →
      ContinuousOn h' (Set.Icc a (a + τ)) →
      h a ^ 2 ≤ (1 + 1 / τ) * ((∫ t in a..a + τ, h t ^ 2) + ∫ t in a..a + τ, h' t ^ 2) := by
    intro a h h' hd hc'
    have hle : a ≤ a + τ := by linarith
    have hu : Set.uIcc a (a + τ) = Set.Icc a (a + τ) := Set.uIcc_of_le hle
    have hhc : ContinuousOn h (Set.Icc a (a + τ)) := HasDerivAt.continuousOn hd
    have hψ : ∀ t ∈ Set.uIcc a (a + τ), HasDerivAt (fun t => (a + τ - t) / τ * (h t * h t))
        ((-1 / τ) * (h t * h t) + (a + τ - t) / τ * (h' t * h t + h t * h' t)) t := by
      intro t ht
      rw [hu] at ht
      have hw : HasDerivAt (fun t => (a + τ - t) / τ) (-1 / τ) t :=
        (((hasDerivAt_const t (a + τ)).sub (hasDerivAt_id' t)).div_const τ).congr_deriv (by ring)
      exact hw.mul ((hd t ht).mul (hd t ht))
    have hψc : ContinuousOn (fun t => (-1 / τ) * (h t * h t) +
        (a + τ - t) / τ * (h' t * h t + h t * h' t)) (Set.uIcc a (a + τ)) := by
      rw [hu]
      exact (continuousOn_const.mul (hhc.mul hhc)).add
        (((continuousOn_const.sub continuousOn_id).div_const τ).mul
          ((hc'.mul hhc).add (hhc.mul hc')))
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hψ hψc.intervalIntegrable
    have key : h a ^ 2 = ∫ t in a..a + τ, -((-1 / τ) * (h t * h t) +
        (a + τ - t) / τ * (h' t * h t + h t * h' t)) := by
      rw [intervalIntegral.integral_neg, hftc]
      have e1 : a + τ - (a + τ) = 0 := by ring
      have e2 : (a + τ - a) / τ = 1 := by rw [add_sub_cancel_left]; exact div_self hτ.ne'
      simp only [e1, e2, zero_div, zero_mul, one_mul, zero_sub, neg_neg]
      ring
    have hpt : ∀ t ∈ Set.Icc a (a + τ), -((-1 / τ) * (h t * h t) +
        (a + τ - t) / τ * (h' t * h t + h t * h' t)) ≤ (1 + 1 / τ) * (h t ^ 2 + h' t ^ 2) := by
      intro t ht
      have hw0 : 0 ≤ (a + τ - t) / τ := div_nonneg (by linarith [ht.2]) hτ.le
      have hw1 : (a + τ - t) / τ ≤ 1 := (div_le_one hτ).2 (by linarith [ht.1])
      have hinv : 0 ≤ 1 / τ := by positivity
      have e3 : (-1 / τ) = -(1 / τ) := by ring
      rw [e3]
      nlinarith [mul_nonneg hw0 (sq_nonneg (h t + h' t)),
        mul_nonneg (sub_nonneg.2 hw1) (add_nonneg (sq_nonneg (h t)) (sq_nonneg (h' t))),
        mul_nonneg hinv (sq_nonneg (h' t))]
    have hi1 : IntervalIntegrable (fun t => h t ^ 2) MeasureTheory.volume a (a + τ) := by
      apply ContinuousOn.intervalIntegrable; rw [hu]; exact hhc.pow 2
    have hi2 : IntervalIntegrable (fun t => h' t ^ 2) MeasureTheory.volume a (a + τ) := by
      apply ContinuousOn.intervalIntegrable; rw [hu]; exact hc'.pow 2
    have hmono : (∫ t in a..a + τ, -((-1 / τ) * (h t * h t) +
        (a + τ - t) / τ * (h' t * h t + h t * h' t))) ≤
        ∫ t in a..a + τ, (1 + 1 / τ) * (h t ^ 2 + h' t ^ 2) :=
      intervalIntegral.integral_mono_on hle hψc.intervalIntegrable.neg
        ((hi1.add hi2).const_mul (1 + 1 / τ)) hpt
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add hi1 hi2] at hmono
    rw [key]; exact hmono
  
  have int2 : ∀ (a K : ℝ) (u v₁ v₂ : ℝ → ℝ), ContinuousOn u (Set.Icc a (a + τ)) →
      ContinuousOn v₁ (Set.Icc a (a + τ)) → ContinuousOn v₂ (Set.Icc a (a + τ)) →
      (∀ x ∈ Set.Icc a (a + τ), u x ≤ K * (v₁ x + v₂ x)) →
      (∫ x in a..a + τ, u x) ≤ K * ((∫ x in a..a + τ, v₁ x) + ∫ x in a..a + τ, v₂ x) := by
    intro a K u v₁ v₂ hu hv₁ hv₂ hle
    have hu' : Set.uIcc a (a + τ) = Set.Icc a (a + τ) := Set.uIcc_of_le (by linarith)
    have i0 : IntervalIntegrable u MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hu)
    have i1 : IntervalIntegrable v₁ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₁)
    have i2 : IntervalIntegrable v₂ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₂)
    calc (∫ x in a..a + τ, u x) ≤ ∫ x in a..a + τ, K * (v₁ x + v₂ x) :=
          intervalIntegral.integral_mono_on (by linarith) i0 ((i1.add i2).const_mul K) hle
      _ = _ := by rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add i1 i2]
  have int4 : ∀ (a K : ℝ) (u v₁ v₂ v₃ v₄ : ℝ → ℝ), ContinuousOn u (Set.Icc a (a + τ)) →
      ContinuousOn v₁ (Set.Icc a (a + τ)) → ContinuousOn v₂ (Set.Icc a (a + τ)) →
      ContinuousOn v₃ (Set.Icc a (a + τ)) → ContinuousOn v₄ (Set.Icc a (a + τ)) →
      (∀ x ∈ Set.Icc a (a + τ), u x ≤ K * (v₁ x + v₂ x + v₃ x + v₄ x)) →
      (∫ x in a..a + τ, u x) ≤ K * ((∫ x in a..a + τ, v₁ x) + (∫ x in a..a + τ, v₂ x) +
        (∫ x in a..a + τ, v₃ x) + ∫ x in a..a + τ, v₄ x) := by
    intro a K u v₁ v₂ v₃ v₄ hu hv₁ hv₂ hv₃ hv₄ hle
    have hu' : Set.uIcc a (a + τ) = Set.Icc a (a + τ) := Set.uIcc_of_le (by linarith)
    have i0 : IntervalIntegrable u MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hu)
    have i1 : IntervalIntegrable v₁ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₁)
    have i2 : IntervalIntegrable v₂ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₂)
    have i3 : IntervalIntegrable v₃ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₃)
    have i4 : IntervalIntegrable v₄ MeasureTheory.volume a (a + τ) :=
      ContinuousOn.intervalIntegrable (by rw [hu']; exact hv₄)
    calc (∫ x in a..a + τ, u x) ≤ ∫ x in a..a + τ, K * (v₁ x + v₂ x + v₃ x + v₄ x) :=
          intervalIntegral.integral_mono_on (by linarith) i0
            ((((i1.add i2).add i3).add i4).const_mul K) hle
      _ = _ := by
        rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add ((i1.add i2).add i3) i4,
          intervalIntegral.integral_add (i1.add i2) i3, intervalIntegral.integral_add i1 i2]
  
  have sq : ∀ (F F1 F2 F21 : ℝ → ℝ → ℝ),
      (∀ s ∈ Set.Icc x₁ (x₁ + τ),
        ContinuousOn (F2 s) (Set.Icc x₂ (x₂ + τ)) ∧ ContinuousOn (F21 s) (Set.Icc x₂ (x₂ + τ))) →
      (ContinuousOn (fun s => ∫ r in x₂..x₂ + τ, F s r ^ 2) (Set.Icc x₁ (x₁ + τ)) ∧
        ContinuousOn (fun s => ∫ r in x₂..x₂ + τ, F1 s r ^ 2) (Set.Icc x₁ (x₁ + τ)) ∧
        ContinuousOn (fun s => ∫ r in x₂..x₂ + τ, F2 s r ^ 2) (Set.Icc x₁ (x₁ + τ)) ∧
        ContinuousOn (fun s => ∫ r in x₂..x₂ + τ, F21 s r ^ 2) (Set.Icc x₁ (x₁ + τ))) →
      ContinuousOn (fun s => F1 s x₂) (Set.Icc x₁ (x₁ + τ)) →
      (∀ s ∈ Set.Icc x₁ (x₁ + τ), HasDerivAt (fun s' => F s' x₂) (F1 s x₂) s) →
      (∀ s ∈ Set.Icc x₁ (x₁ + τ), ∀ r ∈ Set.Icc x₂ (x₂ + τ),
        HasDerivAt (fun r' => F s r') (F2 s r) r ∧ HasDerivAt (fun r' => F1 s r') (F21 s r) r) →
      F x₁ x₂ ^ 2 ≤ (1 + 1 / τ) ^ 2 *
        ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F s r ^ 2) +
         (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F1 s r ^ 2) +
         (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F2 s r ^ 2) +
         (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F21 s r ^ 2)) := by
    intro F F1 F2 F21 hcr hcs hc1 hd1 hd2
    have R1 : ∀ s ∈ Set.Icc x₁ (x₁ + τ), F s x₂ ^ 2 ≤ (1 + 1 / τ) *
        ((∫ r in x₂..x₂ + τ, F s r ^ 2) + ∫ r in x₂..x₂ + τ, F2 s r ^ 2) :=
      fun s hs => line x₂ (F s) (F2 s) (fun r hr => (hd2 s hs r hr).1) (hcr s hs).1
    have R2 : ∀ s ∈ Set.Icc x₁ (x₁ + τ), F1 s x₂ ^ 2 ≤ (1 + 1 / τ) *
        ((∫ r in x₂..x₂ + τ, F1 s r ^ 2) + ∫ r in x₂..x₂ + τ, F21 s r ^ 2) :=
      fun s hs => line x₂ (F1 s) (F21 s) (fun r hr => (hd2 s hs r hr).2) (hcr s hs).2
    have S : F x₁ x₂ ^ 2 ≤ (1 + 1 / τ) *
        ((∫ s in x₁..x₁ + τ, F s x₂ ^ 2) + ∫ s in x₁..x₁ + τ, F1 s x₂ ^ 2) :=
      line x₁ (fun s => F s x₂) (fun s => F1 s x₂) hd1 hc1
    have hFc : ContinuousOn (fun s => F s x₂) (Set.Icc x₁ (x₁ + τ)) := HasDerivAt.continuousOn hd1
    have I1 : (∫ s in x₁..x₁ + τ, F s x₂ ^ 2) ≤ (1 + 1 / τ) *
        ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F s r ^ 2) +
          ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F2 s r ^ 2) :=
      int2 x₁ (1 + 1 / τ) (fun s => F s x₂ ^ 2) _ _ (hFc.pow 2) hcs.1 hcs.2.2.1 R1
    have I2 : (∫ s in x₁..x₁ + τ, F1 s x₂ ^ 2) ≤ (1 + 1 / τ) *
        ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F1 s r ^ 2) +
          ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F21 s r ^ 2) :=
      int2 x₁ (1 + 1 / τ) (fun s => F1 s x₂ ^ 2) _ _ (hc1.pow 2) hcs.2.1 hcs.2.2.2 R2
    calc F x₁ x₂ ^ 2 ≤ (1 + 1 / τ) *
        ((∫ s in x₁..x₁ + τ, F s x₂ ^ 2) + ∫ s in x₁..x₁ + τ, F1 s x₂ ^ 2) := S
      _ ≤ (1 + 1 / τ) * ((1 + 1 / τ) *
            ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F s r ^ 2) +
              ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F2 s r ^ 2) +
          (1 + 1 / τ) *
            ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F1 s r ^ 2) +
              ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F21 s r ^ 2)) :=
          mul_le_mul_of_nonneg_left (add_le_add I1 I2) hC
      _ = _ := by ring
  
  have sl : ∀ F : ℝ → ℝ → ℝ → ℝ, ContinuousOn (fun p : ℝ × ℝ × ℝ => F p.1 p.2.1 p.2.2)
        (Set.Icc x₀ (x₀ + τ) ×ˢ (Set.Icc x₁ (x₁ + τ) ×ˢ Set.Icc x₂ (x₂ + τ))) →
      (∀ t ∈ Set.Icc x₀ (x₀ + τ), ∀ s ∈ Set.Icc x₁ (x₁ + τ),
        ContinuousOn (fun r => F t s r) (Set.Icc x₂ (x₂ + τ))) ∧
      (∀ t ∈ Set.Icc x₀ (x₀ + τ), ContinuousOn (fun s => F t s x₂) (Set.Icc x₁ (x₁ + τ))) ∧
      ContinuousOn (fun t => F t x₁ x₂) (Set.Icc x₀ (x₀ + τ)) := by
    intro F hF
    refine ⟨fun t ht s hs => ?_, fun t ht => ?_, ?_⟩
    · exact hF.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id)).continuousOn
        (fun r hr => ⟨ht, hs, hr⟩)
    · exact hF.comp (continuous_const.prodMk (continuous_id.prodMk continuous_const)).continuousOn
        (fun s hs => ⟨ht, hs, hx₂⟩)
    · exact hF.comp (continuous_id.prodMk (continuous_const.prodMk continuous_const)).continuousOn
        (fun t ht => ⟨ht, hx₁, hx₂⟩)
  
  obtain ⟨c, cc, cmem, cid⟩ : ∃ c : ℝ → ℝ → ℝ, (∀ x, Continuous (c x)) ∧
      (∀ x y, c x y ∈ Set.Icc x (x + τ)) ∧ (∀ x y, y ∈ Set.Icc x (x + τ) → c x y = y) :=
    ⟨fun x y => max x (min (x + τ) y),
      fun x => continuous_const.max (continuous_const.min continuous_id),
      fun x y => ⟨le_max_left _ _, max_le (by linarith) (min_le_left _ _)⟩,
      fun x y hy => by
        show max x (min (x + τ) y) = y
        rw [min_eq_right hy.2, max_eq_right hy.1]⟩
  have pc : ∀ F : ℝ → ℝ → ℝ → ℝ, ContinuousOn (fun p : ℝ × ℝ × ℝ => F p.1 p.2.1 p.2.2)
        (Set.Icc x₀ (x₀ + τ) ×ˢ (Set.Icc x₁ (x₁ + τ) ×ˢ Set.Icc x₂ (x₂ + τ))) →
      (∀ t ∈ Set.Icc x₀ (x₀ + τ),
        ContinuousOn (fun s => ∫ r in x₂..x₂ + τ, F t s r ^ 2) (Set.Icc x₁ (x₁ + τ))) ∧
      ContinuousOn (fun t => ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F t s r ^ 2)
        (Set.Icc x₀ (x₀ + τ)) := by
    intro F hF
    have hG : Continuous (fun p : ℝ × ℝ × ℝ => F (c x₀ p.1) (c x₁ p.2.1) (c x₂ p.2.2)) :=
      hF.comp_continuous (f := fun p : ℝ × ℝ × ℝ => (c x₀ p.1, c x₁ p.2.1, c x₂ p.2.2))
        (((cc x₀).comp continuous_fst).prodMk (((cc x₁).comp continuous_snd.fst).prodMk
          ((cc x₂).comp continuous_snd.snd)))
        (fun p => ⟨cmem _ _, cmem _ _, cmem _ _⟩)
    have hA : Continuous (fun q : ℝ × ℝ =>
        ∫ r in x₂..x₂ + τ, F (c x₀ q.1) (c x₁ q.2) (c x₂ r) ^ 2) := by
      apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun (q : ℝ × ℝ) (r : ℝ) => F (c x₀ q.1) (c x₁ q.2) (c x₂ r) ^ 2)
      have hm : Continuous (fun p : (ℝ × ℝ) × ℝ => (p.1.1, p.1.2, p.2)) := by fun_prop
      exact (hG.comp hm).pow 2
    have hB : Continuous (fun t : ℝ =>
        ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, F (c x₀ t) (c x₁ s) (c x₂ r) ^ 2) := by
      apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun t s => ∫ r in x₂..x₂ + τ, F (c x₀ t) (c x₁ s) (c x₂ r) ^ 2)
      exact hA
    have hAeq : ∀ t ∈ Set.Icc x₀ (x₀ + τ), ∀ s ∈ Set.Icc x₁ (x₁ + τ),
        (∫ r in x₂..x₂ + τ, F (c x₀ t) (c x₁ s) (c x₂ r) ^ 2) =
          ∫ r in x₂..x₂ + τ, F t s r ^ 2 := by
      intro t ht s hs
      apply intervalIntegral.integral_congr
      intro r hr
      rw [Set.uIcc_of_le (by linarith)] at hr
      simp only [cid _ _ ht, cid _ _ hs, cid _ _ hr]
    refine ⟨fun t ht => ?_, ?_⟩
    · exact (hA.comp (continuous_const.prodMk continuous_id)).continuousOn.congr
        (fun s hs => (hAeq t ht s hs).symm)
    · refine hB.continuousOn.congr (fun t ht => ?_)
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le (by linarith)] at hs
      exact (hAeq t ht s hs).symm
  
  have hcf := hc f (by simp)
  have hcf0 := hc f0 (by simp)
  have hcf1 := hc f1 (by simp)
  have hcf10 := hc f10 (by simp)
  have hcf2 := hc f2 (by simp)
  have hcf20 := hc f20 (by simp)
  have hcf21 := hc f21 (by simp)
  have hcf210 := hc f210 (by simp)
  have Pf : ∀ t ∈ Set.Icc x₀ (x₀ + τ), f t x₁ x₂ ^ 2 ≤ (1 + 1 / τ) ^ 2 *
      ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f1 t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f2 t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f21 t s r ^ 2)) := by
    intro t ht
    exact sq (f t) (f1 t) (f2 t) (f21 t)
      (fun s hs => ⟨(sl f2 hcf2).1 t ht s hs, (sl f21 hcf21).1 t ht s hs⟩)
      ⟨(pc f hcf).1 t ht, (pc f1 hcf1).1 t ht, (pc f2 hcf2).1 t ht, (pc f21 hcf21).1 t ht⟩
      ((sl f1 hcf1).2.1 t ht)
      (fun s hs => (h1 t ht s hs x₂ hx₂).1)
      (fun s hs r hr => ⟨(h2 t ht s hs r hr).1, (h2 t ht s hs r hr).2.2.1⟩)
  have Pf0 : ∀ t ∈ Set.Icc x₀ (x₀ + τ), f0 t x₁ x₂ ^ 2 ≤ (1 + 1 / τ) ^ 2 *
      ((∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f0 t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f10 t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f20 t s r ^ 2) +
       (∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f210 t s r ^ 2)) := by
    intro t ht
    exact sq (f0 t) (f10 t) (f20 t) (f210 t)
      (fun s hs => ⟨(sl f20 hcf20).1 t ht s hs, (sl f210 hcf210).1 t ht s hs⟩)
      ⟨(pc f0 hcf0).1 t ht, (pc f10 hcf10).1 t ht, (pc f20 hcf20).1 t ht,
        (pc f210 hcf210).1 t ht⟩
      ((sl f10 hcf10).2.1 t ht)
      (fun s hs => (h1 t ht s hs x₂ hx₂).2)
      (fun s hs r hr => ⟨(h2 t ht s hs r hr).2.1, (h2 t ht s hs r hr).2.2.2⟩)
  have T : f x₀ x₁ x₂ ^ 2 ≤ (1 + 1 / τ) *
      ((∫ t in x₀..x₀ + τ, f t x₁ x₂ ^ 2) + ∫ t in x₀..x₀ + τ, f0 t x₁ x₂ ^ 2) :=
    line x₀ (fun t => f t x₁ x₂) (fun t => f0 t x₁ x₂)
      (fun t ht => h0 t ht x₁ hx₁ x₂ hx₂) (sl f0 hcf0).2.2
  have J1 := int4 x₀ ((1 + 1 / τ) ^ 2) (fun t => f t x₁ x₂ ^ 2) _ _ _ _
    ((sl f hcf).2.2.pow 2) (pc f hcf).2 (pc f1 hcf1).2 (pc f2 hcf2).2 (pc f21 hcf21).2 Pf
  have J2 := int4 x₀ ((1 + 1 / τ) ^ 2) (fun t => f0 t x₁ x₂ ^ 2) _ _ _ _
    ((sl f0 hcf0).2.2.pow 2) (pc f0 hcf0).2 (pc f10 hcf10).2 (pc f20 hcf20).2
    (pc f210 hcf210).2 Pf0
  calc f x₀ x₁ x₂ ^ 2 ≤ (1 + 1 / τ) *
      ((∫ t in x₀..x₀ + τ, f t x₁ x₂ ^ 2) + ∫ t in x₀..x₀ + τ, f0 t x₁ x₂ ^ 2) := T
    _ ≤ (1 + 1 / τ) * (((1 + 1 / τ) ^ 2 *
          ((∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f1 t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f2 t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f21 t s r ^ 2))) +
        ((1 + 1 / τ) ^ 2 *
          ((∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f0 t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f10 t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f20 t s r ^ 2) +
           (∫ t in x₀..x₀ + τ, ∫ s in x₁..x₁ + τ, ∫ r in x₂..x₂ + τ, f210 t s r ^ 2)))) :=
        mul_le_mul_of_nonneg_left (add_le_add J1 J2) hC
    _ = _ := by
        simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        ring

theorem box_integral_iterated (z : E3) (τ : ℝ) (hτ : 0 < τ) (f : E3 → ℝ)
    (hf : ContinuousOn f {y : E3 | ∀ i : Fin 3, z i ≤ y i ∧ y i ≤ z i + τ}) :
    ∫ y in {y : E3 | ∀ i : Fin 3, z i < y i ∧ y i < z i + τ}, f y =
      ∫ t in z 0..z 0 + τ, ∫ s in z 1..z 1 + τ, ∫ r in z 2..z 2 + τ, f (WithLp.toLp 2 ![t, s, r]) :=
by
  classical
  set P : ℝ × ℝ × ℝ → E3 := fun p => WithLp.toLp 2 ![p.1, p.2.1, p.2.2] with hPdef
  let Ψ : ℝ × ℝ × ℝ ≃ᵐ E3 :=
    ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow.symm).trans
      ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm.trans
        (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)))
  have hΨ : (Ψ : ℝ × ℝ × ℝ → E3) = P := by
    funext p
    obtain ⟨t, s, r⟩ := p
    ext i
    fin_cases i <;> rfl
  have hmp0 : MeasurePreserving (Ψ : ℝ × ℝ × ℝ → E3) volume volume := by
    have h1 : MeasurePreserving
        ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow.symm) volume volume :=
      (MeasurePreserving.id (volume : Measure ℝ)).prod (volume_preserving_finTwoArrow ℝ).symm
    have h2 := (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).symm
    have h3 := PiLp.volume_preserving_toLp (Fin 3)
    exact h3.comp (h2.comp h1)
  have hmp : MeasurePreserving P volume volume := hΨ ▸ hmp0
  have hemb : MeasurableEmbedding P := hΨ ▸ Ψ.measurableEmbedding
  have hpre : P ⁻¹' {y : E3 | ∀ i : Fin 3, z i < y i ∧ y i < z i + τ} =
      Set.Ioo (z 0) (z 0 + τ) ×ˢ (Set.Ioo (z 1) (z 1 + τ) ×ˢ Set.Ioo (z 2) (z 2 + τ)) := by
    ext p
    obtain ⟨t, s, r⟩ := p
    constructor
    · intro h
      exact ⟨h 0, h 1, h 2⟩
    · rintro ⟨h0, h1, h2⟩ i
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
  have hPcont : Continuous P := by
    refine (PiLp.continuous_toLp 2 _).comp ?_
    refine continuous_pi fun i => ?_
    fin_cases i
    · exact continuous_fst
    · exact continuous_snd.fst
    · exact continuous_snd.snd
  have hmaps : Set.MapsTo P
      (Set.Icc (z 0) (z 0 + τ) ×ˢ (Set.Icc (z 1) (z 1 + τ) ×ˢ Set.Icc (z 2) (z 2 + τ)))
      {y : E3 | ∀ i : Fin 3, z i ≤ y i ∧ y i ≤ z i + τ} := by
    rintro ⟨t, s, r⟩ ⟨h0, h1, h2⟩ i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2
  have hFc : ContinuousOn (fun p => f (P p))
      (Set.Icc (z 0) (z 0 + τ) ×ˢ (Set.Icc (z 1) (z 1 + τ) ×ˢ Set.Icc (z 2) (z 2 + τ))) :=
    hf.comp hPcont.continuousOn hmaps
  have hK : IsCompact
      (Set.Icc (z 0) (z 0 + τ) ×ˢ (Set.Icc (z 1) (z 1 + τ) ×ˢ Set.Icc (z 2) (z 2 + τ))) :=
    isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)
  have hint : IntegrableOn (fun p => f (P p))
      (Set.Ioo (z 0) (z 0 + τ) ×ˢ (Set.Ioo (z 1) (z 1 + τ) ×ˢ Set.Ioo (z 2) (z 2 + τ))) :=
    (hFc.integrableOn_compact hK).mono_set
      (Set.prod_mono Set.Ioo_subset_Icc_self
        (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self))
  have h0 : z 0 ≤ z 0 + τ := by linarith
  have h1 : z 1 ≤ z 1 + τ := by linarith
  have h2 : z 2 ≤ z 2 + τ := by linarith
  rw [← hmp.setIntegral_preimage_emb hemb f _, hpre]
  simp only [intervalIntegral.integral_of_le h0, intervalIntegral.integral_of_le h1,
    intervalIntegral.integral_of_le h2, MeasureTheory.integral_Ioc_eq_integral_Ioo]
  have e1 := setIntegral_prod (μ := (volume : Measure ℝ)) (ν := (volume : Measure (ℝ × ℝ)))
    (fun p => f (P p)) hint
  refine e1.trans ?_
  refine setIntegral_congr_fun measurableSet_Ioo (fun t ht => ?_)
  have hct : ContinuousOn (fun q : ℝ × ℝ => f (P (t, q)))
      (Set.Icc (z 1) (z 1 + τ) ×ˢ Set.Icc (z 2) (z 2 + τ)) := by
    refine hFc.comp (continuous_const.prodMk continuous_id).continuousOn ?_
    intro q hq
    exact ⟨Set.Ioo_subset_Icc_self ht, hq⟩
  have hint_t : IntegrableOn (fun q : ℝ × ℝ => f (P (t, q)))
      (Set.Ioo (z 1) (z 1 + τ) ×ˢ Set.Ioo (z 2) (z 2 + τ)) :=
    (hct.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
  exact setIntegral_prod (μ := (volume : Measure ℝ)) (ν := (volume : Measure ℝ))
    (fun q : ℝ × ℝ => f (P (t, q))) hint_t

theorem box_sobolev_sup (τ : ℝ) (hτ : 0 < τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (z : E3) (g : E3 → ℝ) (U : Set E3), IsOpen U → ContDiffOn ℝ ∞ g U →
      {y : E3 | ∀ i : Fin 3, z i ≤ y i ∧ y i ≤ z i + τ} ⊆ U →
      g z ^ 2 ≤ K * (([[], [0], [1], [1, 0], [2], [2, 0], [2, 1], [2, 1, 0]] :
          List (List (Fin 3))).map
        (fun S => ∫ y in {y : E3 | ∀ i : Fin 3, z i < y i ∧ y i < z i + τ},
          (S.foldr partialDeriv g y) ^ 2)).sum :=
by
  refine ⟨(1 + 1 / τ) ^ 3, by positivity, ?_⟩
  intro z g U hU hg hbox
  
  have iterPD : ∀ L : List (Fin 3), ContDiffOn ℝ ∞ (L.foldr partialDeriv g) U := by
    intro L
    induction L with
    | nil => simpa using hg
    | cons a L ih =>
      rw [List.foldr_cons]
      have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (L.foldr partialDeriv g)) U :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp ih).2
      show ContDiffOn ℝ ∞ (fun y => fderiv ℝ (L.foldr partialDeriv g) y (e a)) _
      exact h1.clm_apply contDiffOn_const
  have hdiff : ∀ L : List (Fin 3), ∀ p ∈ U, DifferentiableAt ℝ (L.foldr partialDeriv g) p :=
    fun L p hp => ((iterPD L).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hp)
  
  have hPcont : Continuous (fun p : ℝ × ℝ × ℝ => (WithLp.toLp 2 ![p.1, p.2.1, p.2.2] : E3)) := by
    refine (PiLp.continuous_toLp 2 _).comp ?_
    refine continuous_pi fun i => ?_
    fin_cases i
    · exact continuous_fst
    · exact continuous_snd.fst
    · exact continuous_snd.snd
  have hmem : ∀ t ∈ Set.Icc (z 0) (z 0 + τ), ∀ s ∈ Set.Icc (z 1) (z 1 + τ),
      ∀ r ∈ Set.Icc (z 2) (z 2 + τ), (WithLp.toLp 2 ![t, s, r] : E3) ∈ U := by
    intro t ht s hs r hr
    apply hbox
    intro i
    fin_cases i
    · exact ht
    · exact hs
    · exact hr
  have hcontL : ∀ L : List (Fin 3), ContinuousOn
      (fun p : ℝ × ℝ × ℝ => L.foldr partialDeriv g (WithLp.toLp 2 ![p.1, p.2.1, p.2.2]))
      (Set.Icc (z 0) (z 0 + τ) ×ˢ (Set.Icc (z 1) (z 1 + τ) ×ˢ Set.Icc (z 2) (z 2 + τ))) := by
    intro L
    refine (iterPD L).continuousOn.comp hPcont.continuousOn ?_
    intro p hp
    exact hmem p.1 hp.1 p.2.1 hp.2.1 p.2.2 hp.2.2
  
  have hline : ∀ (F : E3 → ℝ) (t s r : ℝ), DifferentiableAt ℝ F (WithLp.toLp 2 ![t, s, r]) →
      HasDerivAt (fun t' => F (WithLp.toLp 2 ![t', s, r]))
          (partialDeriv 0 F (WithLp.toLp 2 ![t, s, r])) t ∧
      HasDerivAt (fun s' => F (WithLp.toLp 2 ![t, s', r]))
          (partialDeriv 1 F (WithLp.toLp 2 ![t, s, r])) s ∧
      HasDerivAt (fun r' => F (WithLp.toLp 2 ![t, s, r']))
          (partialDeriv 2 F (WithLp.toLp 2 ![t, s, r])) r := by
    intro F t s r hF
    have l0 : HasDerivAt (fun t' : ℝ => (WithLp.toLp 2 ![t', s, r] : E3)) (e 0) t := by
      have h : (fun t' : ℝ => (WithLp.toLp 2 ![t', s, r] : E3)) =
          fun t' => (WithLp.toLp 2 ![0, s, r] : E3) + t' • e 0 := by
        funext t'; ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
      rw [h]
      simpa using ((hasDerivAt_id t).smul_const (e 0)).const_add (WithLp.toLp 2 ![0, s, r] : E3)
    have l1 : HasDerivAt (fun s' : ℝ => (WithLp.toLp 2 ![t, s', r] : E3)) (e 1) s := by
      have h : (fun s' : ℝ => (WithLp.toLp 2 ![t, s', r] : E3)) =
          fun s' => (WithLp.toLp 2 ![t, 0, r] : E3) + s' • e 1 := by
        funext s'; ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
      rw [h]
      simpa using ((hasDerivAt_id s).smul_const (e 1)).const_add (WithLp.toLp 2 ![t, 0, r] : E3)
    have l2 : HasDerivAt (fun r' : ℝ => (WithLp.toLp 2 ![t, s, r'] : E3)) (e 2) r := by
      have h : (fun r' : ℝ => (WithLp.toLp 2 ![t, s, r'] : E3)) =
          fun r' => (WithLp.toLp 2 ![t, s, 0] : E3) + r' • e 2 := by
        funext r'; ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
      rw [h]
      simpa using ((hasDerivAt_id r).smul_const (e 2)).const_add (WithLp.toLp 2 ![t, s, 0] : E3)
    exact ⟨hF.hasFDerivAt.comp_hasDerivAt t l0, hF.hasFDerivAt.comp_hasDerivAt s l1,
      hF.hasFDerivAt.comp_hasDerivAt r l2⟩
  
  have key := box_iterated_sobolev (z 0) (z 1) (z 2) τ hτ
    (fun t s r => ([] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([0] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([1] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([1, 0] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([2] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([2, 0] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([2, 1] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (fun t s r => ([2, 1, 0] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![t, s, r]))
    (by
      intro F hF
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hF
      rcases hF with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact hcontL []
      · exact hcontL [0]
      · exact hcontL [1]
      · exact hcontL [1, 0]
      · exact hcontL [2]
      · exact hcontL [2, 0]
      · exact hcontL [2, 1]
      · exact hcontL [2, 1, 0])
    (by
      intro t ht s hs r hr
      exact (hline _ t s r (hdiff [] _ (hmem t ht s hs r hr))).1)
    (by
      intro t ht s hs r hr
      exact ⟨(hline _ t s r (hdiff [] _ (hmem t ht s hs r hr))).2.1,
        (hline _ t s r (hdiff [0] _ (hmem t ht s hs r hr))).2.1⟩)
    (by
      intro t ht s hs r hr
      exact ⟨(hline _ t s r (hdiff [] _ (hmem t ht s hs r hr))).2.2,
        (hline _ t s r (hdiff [0] _ (hmem t ht s hs r hr))).2.2,
        (hline _ t s r (hdiff [1] _ (hmem t ht s hs r hr))).2.2,
        (hline _ t s r (hdiff [1, 0] _ (hmem t ht s hs r hr))).2.2⟩)
  
  have hz : (WithLp.toLp 2 ![z 0, z 1, z 2] : E3) = z := by
    ext i; fin_cases i <;> rfl
  have hlhs : ([] : List (Fin 3)).foldr partialDeriv g (WithLp.toLp 2 ![z 0, z 1, z 2]) = g z := by
    show g (WithLp.toLp 2 ![z 0, z 1, z 2]) = g z
    rw [hz]
  
  have hfub : ∀ L : List (Fin 3),
      ∫ y in {y : E3 | ∀ i : Fin 3, z i < y i ∧ y i < z i + τ}, (L.foldr partialDeriv g y) ^ 2 =
        ∫ t in z 0..z 0 + τ, ∫ s in z 1..z 1 + τ, ∫ r in z 2..z 2 + τ,
          (L.foldr partialDeriv g (WithLp.toLp 2 ![t, s, r])) ^ 2 :=
    fun L => box_integral_iterated z τ hτ (fun y => (L.foldr partialDeriv g y) ^ 2)
      (((iterPD L).continuousOn.mono hbox).pow 2)
  have hsum : (([[], [0], [1], [1, 0], [2], [2, 0], [2, 1], [2, 1, 0]] :
          List (List (Fin 3))).map
        (fun S => ∫ y in {y : E3 | ∀ i : Fin 3, z i < y i ∧ y i < z i + τ},
          (S.foldr partialDeriv g y) ^ 2)).sum =
      (([[], [0], [1], [1, 0], [2], [2, 0], [2, 1], [2, 1, 0]] : List (List (Fin 3))).map
        (fun S => ∫ t in z 0..z 0 + τ, ∫ s in z 1..z 1 + τ, ∫ r in z 2..z 2 + τ,
          (S.foldr partialDeriv g (WithLp.toLp 2 ![t, s, r])) ^ 2)).sum := by
    congr 1
    exact List.map_congr_left (fun L _ => hfub L)
  rw [hsum, ← hlhs]
  exact key

theorem iteratedFDeriv_norm_le_partials (U : Set E3) (hU : IsOpen U) (v : E3 → ℝ)
    (hv : ContDiffOn ℝ ∞ v U) (m : ℕ) (z : E3) (hz : z ∈ U) :
    ‖iteratedFDeriv ℝ m v z‖ ≤ ∑ L : Fin m → Fin 3, |(List.ofFn L).foldr partialDeriv v z| :=
by
  classical
  
  have hB : ∀ n : ℕ, ∀ L : Fin n → Fin 3, ∀ y ∈ U,
      iteratedFDeriv ℝ n v y (fun k => e (L k)) = (List.ofFn L).foldr partialDeriv v y := by
    intro n
    induction n with
    | zero =>
      intro L y hy
      simp [iteratedFDeriv_zero_apply]
    | succ n ih =>
      intro L y hy
      have hc : ContDiffAt ℝ ∞ v y := hv.contDiffAt (hU.mem_nhds hy)
      have hlt : ((n : ℕ) : WithTop ℕ∞) < ∞ :=
        WithTop.coe_lt_coe.2 (ENat.coe_lt_top n)
      have hdiff : DifferentiableAt ℝ (iteratedFDeriv ℝ n v) y :=
        hc.differentiableAt_iteratedFDeriv hlt
      rw [iteratedFDeriv_succ_apply_left]
      rw [← fderiv_continuousMultilinear_apply_const_apply hdiff]
      have hev : (fun w => iteratedFDeriv ℝ n v w (Fin.tail (fun k => e (L k)))) =ᶠ[𝓝 y]
          (List.ofFn (fun i : Fin n => L i.succ)).foldr partialDeriv v := by
        filter_upwards [hU.mem_nhds hy] with w hw
        exact ih (fun i => L i.succ) w hw
      rw [hev.fderiv_eq, List.ofFn_succ, List.foldr_cons]
      rfl
  
  have hA : ∀ T : ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ,
      ‖T‖ ≤ ∑ L : Fin m → Fin 3, |T (fun k => e (L k))| := by
    intro T
    refine ContinuousMultilinearMap.opNorm_le_bound
      (Finset.sum_nonneg (fun _ _ => abs_nonneg _)) ?_
    intro h
    have hexp : h = fun k => ∑ i : Fin 3, h k i • e i := by
      funext k
      have h1 := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr (h k)
      simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] at h1
      exact h1.symm
    have hT : T h = ∑ r : Fin m → Fin 3, (∏ k, h k (r k)) * T (fun k => e (r k)) := by
      conv_lhs => rw [hexp]
      rw [ContinuousMultilinearMap.map_sum]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [ContinuousMultilinearMap.map_smul_univ, smul_eq_mul]
    rw [Real.norm_eq_abs, hT, Finset.sum_mul]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun r _ => ?_))
    rw [abs_mul, Finset.abs_prod, mul_comm]
    refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
    refine Finset.prod_le_prod (fun k _ => abs_nonneg _) (fun k _ => ?_)
    have h2 := PiLp.norm_apply_le (h k) (r k)
    rwa [Real.norm_eq_abs] at h2
  calc ‖iteratedFDeriv ℝ m v z‖
      ≤ ∑ L : Fin m → Fin 3, |iteratedFDeriv ℝ m v z (fun k => e (L k))| := hA _
    _ = ∑ L : Fin m → Fin 3, |(List.ofFn L).foldr partialDeriv v z| :=
        Finset.sum_congr rfl (fun L _ => by rw [hB m L z hz])

theorem fcr_box_jet_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (m : ℕ) (y : E3) (g : E3 → ℝ) (U : Set E3), IsOpen U → ContDiff ℝ ∞ g →
      {z : E3 | ∀ i : Fin 3, y i ≤ z i ∧ z i ≤ y i + τ} ⊆ U →
      ‖iteratedFDeriv ℝ m g y‖ ≤ ∑ L : Fin m → Fin 3, Real.sqrt (K *
        (([[], [0], [1], [1, 0], [2], [2, 0], [2, 1], [2, 1, 0]] : List (List (Fin 3))).map
          (fun S => ∫ z in {z : E3 | ∀ i : Fin 3, y i < z i ∧ z i < y i + τ},
            ((S ++ List.ofFn L).foldr partialDeriv g z) ^ 2)).sum) :=
by
  obtain ⟨K, hK0, hK⟩ := box_sobolev_sup τ hτ
  refine ⟨K, hK0, ?_⟩
  intro m y g U hU hg hbox
  have hyU : y ∈ U := hbox (fun i => ⟨le_rfl, by linarith⟩)
  have hsm : ∀ L' : List (Fin 3), ContDiff ℝ ∞ (L'.foldr partialDeriv g) := by
    intro L'
    induction L' with
    | nil => simpa using hg
    | cons a L'' ih =>
      rw [List.foldr_cons]
      have h1 : ContDiff ℝ ∞ (fderiv ℝ (L''.foldr partialDeriv g)) :=
        (contDiff_infty_iff_fderiv.mp ih).2
      have h2 : ContDiff ℝ ∞ (fun x => fderiv ℝ (L''.foldr partialDeriv g) x (e a)) :=
        h1.clm_apply contDiff_const
      exact h2
  refine (iteratedFDeriv_norm_le_partials U hU g hg.contDiffOn m y hyU).trans ?_
  refine Finset.sum_le_sum (fun L _ => ?_)
  apply Real.abs_le_sqrt
  have h := hK y ((List.ofFn L).foldr partialDeriv g) U hU (hsm _).contDiffOn hbox
  simpa only [List.foldr_append] using h

theorem seeley_weight_moment (K p : ℕ) (hp : p < K) :
    ∑ i ∈ Finset.range K, (∏ j ∈ (Finset.range K).erase i,
        ((-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j))) * (-(2:ℝ) ^ i) ^ p = 1 :=
by
  have hinj : Set.InjOn (fun i : ℕ => (2:ℝ) ^ i) ((Finset.range K : Finset ℕ) : Set ℕ) :=
    (pow_right_injective₀ (by norm_num : (0:ℝ) < 2) (by norm_num)).injOn
  have hdeg : (Polynomial.X ^ p : Polynomial ℝ).degree < ((Finset.range K).card : WithBot ℕ) := by
    rw [Polynomial.degree_X_pow, Finset.card_range]; exact_mod_cast hp
  have hE := Lagrange.eq_interpolate hinj hdeg
  have hE2 := congrArg (Polynomial.eval (-1 : ℝ)) hE
  rw [Lagrange.interpolate_eq_sum] at hE2
  simp only [Polynomial.eval_X_pow, Polynomial.eval_finset_sum, Polynomial.eval_mul,
    Polynomial.eval_C, Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_X] at hE2
  have hterm : ∀ i ∈ Finset.range K, (∏ j ∈ (Finset.range K).erase i,
      ((-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j))) * (-(2:ℝ) ^ i) ^ p
      = (-1) ^ p * (((2:ℝ) ^ i) ^ p / (∏ j ∈ (Finset.range K).erase i, ((2:ℝ) ^ i - (2:ℝ) ^ j))
          * ∏ j ∈ (Finset.range K).erase i, (-1 - (2:ℝ) ^ j)) := by
    intro i _
    rw [Finset.prod_div_distrib, neg_pow]
    ring
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, ← hE2, ← mul_pow]
  norm_num

theorem seeley_weight_bound : (∀ (K i : ℕ), i < K → |∏ j ∈ (Finset.range K).erase i,
        ((-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j))| ≤
        Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2)) ∧
    ∀ p : ℕ, Summable (fun i : ℕ =>
        Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) * ((2:ℝ) ^ i) ^ p) :=
by
  
  have hlow : ∀ i j : ℕ, j < i →
      |(-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j)| ≤ 4 * (1 / 2 : ℝ) ^ (i - j) := by
    intro i j hji
    obtain ⟨d, rfl⟩ : ∃ d, i = j + d := ⟨i - j, by omega⟩
    have hd : 1 ≤ d := by omega
    rw [show j + d - j = d by omega, pow_add]
    have ha1 : (1:ℝ) ≤ (2:ℝ) ^ j := one_le_pow₀ (by norm_num)
    have hst : (1 / 2 : ℝ) ^ d * (2:ℝ) ^ d = 1 := by rw [← mul_pow]; norm_num
    have hs2 : (1 / 2 : ℝ) ^ d ≤ 1 / 2 := by
      calc (1 / 2 : ℝ) ^ d ≤ (1 / 2) ^ 1 := pow_le_pow_of_le_one (by norm_num) (by norm_num) hd
        _ = 1 / 2 := by norm_num
    have ht2 : (2:ℝ) ≤ (2:ℝ) ^ d := by
      calc (2:ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ d := pow_le_pow_right₀ (by norm_num) hd
    generalize (2:ℝ) ^ j = a at *
    generalize (2:ℝ) ^ d = t at *
    generalize (1 / 2 : ℝ) ^ d = s at *
    have h1 : a * s * t = a := by rw [mul_assoc, hst, mul_one]
    have h2 : a * s ≤ a * (1 / 2) := mul_le_mul_of_nonneg_left hs2 (by linarith)
    have hden : 0 < a * t - a := by nlinarith
    have hnum : -1 - a < 0 := by linarith
    rw [abs_div, abs_of_neg hnum, abs_of_pos hden, div_le_iff₀ hden]
    nlinarith
  
  have hup : ∀ i j : ℕ, i < j →
      |(-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j)| ≤ 1 + 4 * (1 / 2 : ℝ) ^ (j - i) := by
    intro i j hij
    obtain ⟨d, rfl⟩ : ∃ d, j = i + d := ⟨j - i, by omega⟩
    have hd : 1 ≤ d := by omega
    rw [show i + d - i = d by omega, pow_add]
    have hb1 : (1:ℝ) ≤ (2:ℝ) ^ i := one_le_pow₀ (by norm_num)
    have hst : (1 / 2 : ℝ) ^ d * (2:ℝ) ^ d = 1 := by rw [← mul_pow]; norm_num
    have hs2 : (1 / 2 : ℝ) ^ d ≤ 1 / 2 := by
      calc (1 / 2 : ℝ) ^ d ≤ (1 / 2) ^ 1 := pow_le_pow_of_le_one (by norm_num) (by norm_num) hd
        _ = 1 / 2 := by norm_num
    have ht2 : (2:ℝ) ≤ (2:ℝ) ^ d := by
      calc (2:ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ d := pow_le_pow_right₀ (by norm_num) hd
    generalize (2:ℝ) ^ i = b at *
    generalize (2:ℝ) ^ d = t at *
    generalize (1 / 2 : ℝ) ^ d = s at *
    have h1 : b * s * t = b := by rw [mul_assoc, hst, mul_one]
    have h2 : b * s ≤ b * (1 / 2) := mul_le_mul_of_nonneg_left hs2 (by linarith)
    have hden : 0 < b * t - b := by nlinarith
    have hnum : -1 - b * t < 0 := by nlinarith
    have hden' : b - b * t < 0 := by linarith
    rw [abs_div, abs_of_neg hnum, abs_of_neg hden', div_le_iff₀ (by linarith)]
    nlinarith
  
  have hsumT : ∀ n : ℕ, ∑ j ∈ Finset.range n, (n - j) = n * (n + 1) / 2 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ]
      have hc : ∑ j ∈ Finset.range n, (n + 1 - j) = ∑ j ∈ Finset.range n, ((n - j) + 1) :=
        Finset.sum_congr rfl (fun j hj => by rw [Finset.mem_range] at hj; omega)
      rw [hc, Finset.sum_add_distrib, ih, Finset.sum_const, Finset.card_range, smul_eq_mul,
        mul_one]
      have h2 : (n + 1) * (n + 1 + 1) = n * (n + 1) + (n + 1) * 2 := by ring
      rw [h2, Nat.add_mul_div_right _ _ (by norm_num : 0 < 2)]
      omega
  
  have hlowprod : ∀ i : ℕ, ∏ j ∈ Finset.range i, |(-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j)| ≤
      (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) := by
    intro i
    calc _ ≤ ∏ j ∈ Finset.range i, (4 * (1 / 2 : ℝ) ^ (i - j)) :=
          Finset.prod_le_prod (fun j _ => abs_nonneg _)
            (fun j hj => hlow i j (Finset.mem_range.mp hj))
      _ = (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) := by
          rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
            Finset.prod_pow_eq_pow_sum, hsumT]
  
  have hgeom : ∀ n : ℕ, ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1) = 1 - (1 / 2) ^ n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [Finset.sum_range_succ, ih, pow_succ]; ring
  
  have hupprod : ∀ i K : ℕ, ∏ j ∈ Finset.Ico (i + 1) K,
      |(-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j)| ≤ Real.exp 4 := by
    intro i K
    calc _ ≤ ∏ j ∈ Finset.Ico (i + 1) K, Real.exp (4 * (1 / 2 : ℝ) ^ (j - i)) := by
          refine Finset.prod_le_prod (fun j _ => abs_nonneg _) (fun j hj => ?_)
          have hj' := (Finset.mem_Ico.mp hj).1
          calc _ ≤ 1 + 4 * (1 / 2 : ℝ) ^ (j - i) := hup i j (by omega)
            _ ≤ _ := by
                have := Real.add_one_le_exp (4 * (1 / 2 : ℝ) ^ (j - i))
                linarith
      _ = Real.exp (∑ j ∈ Finset.Ico (i + 1) K, 4 * (1 / 2 : ℝ) ^ (j - i)) :=
          (Real.exp_sum _ _).symm
      _ ≤ Real.exp 4 := by
          apply Real.exp_le_exp.mpr
          rw [Finset.sum_Ico_eq_sum_range]
          have hc : ∀ k ∈ Finset.range (K - (i + 1)),
              4 * (1 / 2 : ℝ) ^ (i + 1 + k - i) = 4 * (1 / 2 : ℝ) ^ (k + 1) :=
            fun k _ => by rw [show i + 1 + k - i = k + 1 by omega]
          rw [Finset.sum_congr rfl hc, ← Finset.mul_sum, hgeom]
          have : (0:ℝ) ≤ (1 / 2) ^ (K - (i + 1)) := by positivity
          linarith
  
  have hsum : ∀ p : ℕ, Summable (fun i : ℕ =>
        Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) * ((2:ℝ) ^ i) ^ p) := by
    intro p
    refine Summable.of_norm_bounded_eventually_nat
      ((summable_geometric_of_lt_one (by norm_num) (by norm_num : (1 / 2 : ℝ) < 1)).mul_left
        (Real.exp 4)) ?_
    rw [Filter.eventually_atTop]
    refine ⟨2 * p + 5, fun i hi => ?_⟩
    have hN : 3 * i + i * p ≤ i * (i + 1) / 2 := by
      rw [Nat.le_div_iff_mul_le (by norm_num)]
      nlinarith
    have hpos : 0 ≤ Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) * ((2:ℝ) ^ i) ^ p := by
      positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hpos]
    have hle : (1 / 2 : ℝ) ^ (i * (i + 1) / 2) ≤ (1 / 2 : ℝ) ^ (3 * i + i * p) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) hN
    have hid : (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (3 * i + i * p) * ((2:ℝ) ^ i) ^ p = (1 / 2 : ℝ) ^ i := by
      have h4 : (4:ℝ) ^ i = ((2:ℝ) ^ i) ^ 2 := by
        rw [← pow_mul, mul_comm, pow_mul]; norm_num
      have hh : (1 / 2 : ℝ) ^ (3 * i + i * p) = ((1 / 2 : ℝ) ^ i) ^ 3 * ((1 / 2 : ℝ) ^ i) ^ p := by
        rw [← pow_mul, ← pow_mul, ← pow_add, mul_comm i 3]
      have hx : (2:ℝ) ^ i * (1 / 2 : ℝ) ^ i = 1 := by rw [← mul_pow]; norm_num
      rw [h4, hh]
      calc ((2:ℝ) ^ i) ^ 2 * (((1 / 2 : ℝ) ^ i) ^ 3 * ((1 / 2 : ℝ) ^ i) ^ p) * ((2:ℝ) ^ i) ^ p
          = ((2:ℝ) ^ i * (1 / 2 : ℝ) ^ i) ^ 2 * ((2:ℝ) ^ i * (1 / 2 : ℝ) ^ i) ^ p
              * (1 / 2 : ℝ) ^ i := by ring
        _ = (1 / 2 : ℝ) ^ i := by rw [hx]; simp
    calc Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2) * ((2:ℝ) ^ i) ^ p
        ≤ Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (3 * i + i * p) * ((2:ℝ) ^ i) ^ p :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hle (by positivity))
            (by positivity)
      _ = Real.exp 4 * (1 / 2 : ℝ) ^ i := by rw [← hid]; ring
  
  refine ⟨fun K i hiK => ?_, hsum⟩
  have hset : (Finset.range K).erase i = Finset.range i ∪ Finset.Ico (i + 1) K := by
    ext j
    simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_union, Finset.mem_Ico]
    omega
  have hdisj : Disjoint (Finset.range i) (Finset.Ico (i + 1) K) := by
    rw [Finset.disjoint_left]
    intro j h1 h2
    simp only [Finset.mem_range, Finset.mem_Ico] at h1 h2
    omega
  rw [Finset.abs_prod, hset, Finset.prod_union hdisj]
  calc _ ≤ ((4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2)) * Real.exp 4 :=
        mul_le_mul (hlowprod i) (hupprod i K) (Finset.prod_nonneg (fun j _ => abs_nonneg _))
          (by positivity)
    _ = _ := by ring

theorem seeley_weights_limit (D : ℕ → ℝ) (W : ℕ → ℕ → ℝ)
    (hD : ∀ p : ℕ, Summable (fun i : ℕ => D i * ((2:ℝ) ^ i) ^ p))
    (hWD : ∀ K i : ℕ, |W K i| ≤ D i) (hW0 : ∀ K i : ℕ, K ≤ i → W K i = 0)
    (hWm : ∀ K p : ℕ, p < K → ∑ i ∈ Finset.range K, W K i * (-(2:ℝ) ^ i) ^ p = 1) :
    ∃ a : ℕ → ℝ, (∀ p : ℕ, Summable (fun k : ℕ => |a k| * ((2:ℝ) ^ k) ^ p)) ∧
      ∀ p : ℕ, ∑' k : ℕ, a k * (-(2:ℝ) ^ k) ^ p = 1 :=
by
  have hS : IsCompact (Set.univ.pi (fun i : ℕ => Set.Icc (-D i) (D i))) :=
    isCompact_univ_pi (fun i => isCompact_Icc)
  have hmem : ∀ K, W K ∈ Set.univ.pi (fun i : ℕ => Set.Icc (-D i) (D i)) := by
    intro K
    rw [Set.mem_univ_pi]
    intro i
    exact abs_le.mp (hWD K i)
  obtain ⟨a, ha, φ, hφ, hlim⟩ := hS.tendsto_subseq hmem
  have haD : ∀ k, |a k| ≤ D k := by
    intro k
    rw [Set.mem_univ_pi] at ha
    exact abs_le.mpr (ha k)
  have hpt : ∀ k, Filter.Tendsto (fun n => W (φ n) k) Filter.atTop (𝓝 (a k)) := by
    intro k
    exact tendsto_pi_nhds.mp hlim k
  refine ⟨a, ?_, ?_⟩
  · intro p
    refine Summable.of_nonneg_of_le (fun k => ?_) (fun k => ?_) (hD p)
    · exact mul_nonneg (abs_nonneg _) (by positivity)
    · exact mul_le_mul_of_nonneg_right (haD k) (by positivity)
  · intro p
    have hfin : ∀ n, p < φ n → ∑' k : ℕ, W (φ n) k * (-(2:ℝ) ^ k) ^ p = 1 := by
      intro n hn
      rw [tsum_eq_sum (s := Finset.range (φ n))]
      · exact hWm (φ n) p hn
      · intro k hk
        rw [Finset.mem_range, not_lt] at hk
        rw [hW0 (φ n) k hk, zero_mul]
    have h1 : Filter.Tendsto (fun n => ∑' k : ℕ, W (φ n) k * (-(2:ℝ) ^ k) ^ p)
        Filter.atTop (𝓝 1) := by
      refine tendsto_const_nhds.congr' ?_
      rw [Filter.EventuallyEq, Filter.eventually_atTop]
      refine ⟨p + 1, fun n hn => ?_⟩
      have hle : n ≤ φ n := hφ.id_le n
      exact (hfin n (by omega)).symm
    have h2 : Filter.Tendsto (fun n => ∑' k : ℕ, W (φ n) k * (-(2:ℝ) ^ k) ^ p)
        Filter.atTop (𝓝 (∑' k : ℕ, a k * (-(2:ℝ) ^ k) ^ p)) := by
      refine tendsto_tsum_of_dominated_convergence (bound := fun k => D k * ((2:ℝ) ^ k) ^ p)
        (hD p) (fun k => (hpt k).mul_const _) ?_
      refine Filter.Eventually.of_forall (fun n k => ?_)
      have h2k : (0:ℝ) < (2:ℝ) ^ k := pow_pos (by norm_num) k
      rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_neg, abs_of_pos h2k]
      exact mul_le_mul_of_nonneg_right (hWD (φ n) k) (by positivity)
    exact tendsto_nhds_unique h2 h1

theorem seeley_multilinear_identity (a : ℕ → ℝ)
    (ha : ∀ p : ℕ, Summable (fun k : ℕ => |a k| * ((2:ℝ) ^ k) ^ p))
    (hmom : ∀ p : ℕ, ∑' k : ℕ, a k * (-(2:ℝ) ^ k) ^ p = 1) :
    ∀ (m : ℕ) (T : ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ) (v : Fin m → E3),
      HasSum (fun k : ℕ => a k * T (fun i => v i - ((1 + (2:ℝ) ^ k) * v i 0) • e 0)) (T v) :=
by
  intro m T v
  obtain ⟨m₁, hm₁⟩ : ∃ f : Fin m → E3, f = fun i => (v i 0) • e 0 := ⟨_, rfl⟩
  obtain ⟨m₂, hm₂⟩ : ∃ f : Fin m → E3, f = fun i => v i - (v i 0) • e 0 := ⟨_, rfl⟩
  
  have hexp : ∀ c : ℝ, T (fun i => c • m₁ i + m₂ i) =
      ∑ s : Finset (Fin m), c ^ s.card * T (s.piecewise m₁ m₂) := by
    intro c
    have h1 : (fun i => c • m₁ i + m₂ i) = (fun i => c • m₁ i) + m₂ := rfl
    rw [h1, ContinuousMultilinearMap.map_add_univ]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    have h2 : s.piecewise (fun i => c • m₁ i) m₂ =
        s.piecewise (fun i => (fun _ => c) i • (s.piecewise m₁ m₂) i) (s.piecewise m₁ m₂) := by
      apply Finset.piecewise_congr
      · intro i hi
        simp [Finset.piecewise_eq_of_mem _ _ _ hi]
      · intro i hi
        simp [Finset.piecewise_eq_of_notMem _ _ _ hi]
    rw [h2, ContinuousMultilinearMap.map_piecewise_smul, Finset.prod_const, smul_eq_mul]
  
  have hmomS : ∀ p : ℕ, HasSum (fun k => a k * (-(2:ℝ) ^ k) ^ p) 1 := by
    intro p
    have hs : Summable (fun k => a k * (-(2:ℝ) ^ k) ^ p) := by
      refine Summable.of_norm_bounded (ha p) (fun k => le_of_eq ?_)
      rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_neg, abs_of_pos (pow_pos two_pos k : (0:ℝ) < 2 ^ k)]
    have := hs.hasSum
    rwa [hmom p] at this
  
  have hS : HasSum (fun k => ∑ s : Finset (Fin m),
      a k * (-(2:ℝ) ^ k) ^ s.card * T (s.piecewise m₁ m₂))
      (∑ s : Finset (Fin m), T (s.piecewise m₁ m₂)) := by
    refine hasSum_sum (fun s _ => ?_)
    have := (hmomS s.card).mul_right (T (s.piecewise m₁ m₂))
    rwa [one_mul] at this
  
  have hval : ∑ s : Finset (Fin m), T (s.piecewise m₁ m₂) = T v := by
    rw [← ContinuousMultilinearMap.map_add_univ]
    congr 1
    funext i
    simp [hm₁, hm₂]
  rw [hval] at hS
  
  refine hS.congr_fun (fun k => ?_)
  have hvec : (fun i => v i - ((1 + (2:ℝ) ^ k) * v i 0) • e 0) =
      fun i => (-(2:ℝ) ^ k) • m₁ i + m₂ i := by
    funext i
    rw [hm₁, hm₂]
    module
  rw [hvec, hexp, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  ring

theorem halfspace_hasFDerivAt_glue {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (h : E3 → X) (Q : E3 → E3 →L[ℝ] X) (hh : Continuous h) (hQ : Continuous Q)
    (hoff : ∀ y : E3, y 0 ≠ 0 → HasFDerivAt h (Q y) y) (y : E3) :
    HasFDerivAt h (Q y) y :=
by
  have hπ : Continuous (fun z : E3 => z 0) := by fun_prop
  have key : ∀ s : Set E3, IsOpen s → Convex ℝ s → (∀ z ∈ s, z 0 ≠ 0) →
      HasFDerivWithinAt h (Q y) (closure s) y := by
    intro s hso hsc hs0
    have hdiff : DifferentiableOn ℝ h s := fun z hz =>
      (hoff z (hs0 z hz)).differentiableAt.differentiableWithinAt
    have hlim : Filter.Tendsto (fun z => fderiv ℝ h z) (nhdsWithin y s) (nhds (Q y)) := by
      refine ((hQ.tendsto y).mono_left nhdsWithin_le_nhds).congr' ?_
      exact eventually_nhdsWithin_of_forall (fun z hz => ((hoff z (hs0 z hz)).fderiv).symm)
    exact hasFDerivWithinAt_closure_of_tendsto_fderiv hdiff hsc hso
      (fun _ _ => hh.continuousWithinAt) hlim
  have hPcv : Convex ℝ {z : E3 | 0 < z 0} := by
    rw [convex_iff_forall_pos]
    intro x hx w hw a b ha hb _
    simp only [Set.mem_setOf_eq, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul] at hx hw ⊢
    have h1 : 0 < a * x 0 := mul_pos ha hx
    have h2 : 0 < b * w 0 := mul_pos hb hw
    linarith
  have hNcv : Convex ℝ {z : E3 | z 0 < 0} := by
    rw [convex_iff_forall_pos]
    intro x hx w hw a b ha hb _
    simp only [Set.mem_setOf_eq, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul] at hx hw ⊢
    have h1 : a * x 0 < 0 := mul_neg_of_pos_of_neg ha hx
    have h2 : b * w 0 < 0 := mul_neg_of_pos_of_neg hb hw
    linarith
  have hP := key {z : E3 | 0 < z 0} (isOpen_lt continuous_const hπ) hPcv
    (fun z hz => ne_of_gt hz)
  have hN := key {z : E3 | z 0 < 0} (isOpen_lt hπ continuous_const) hNcv
    (fun z hz => ne_of_lt hz)
  have hcov : Set.univ ⊆ closure {z : E3 | 0 < z 0} ∪ closure {z : E3 | z 0 < 0} := by
    intro z _
    rcases lt_or_ge (z 0) 0 with hz | hz
    · exact Or.inr (subset_closure hz)
    · left
      rw [Metric.mem_closure_iff]
      intro ε hε
      refine ⟨z + (ε / 2) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ), ?_, ?_⟩
      · show 0 < (z + (ε / 2) • EuclideanSpace.single (0 : Fin 3) (1 : ℝ)) 0
        simp only [PiLp.add_apply, PiLp.smul_apply, EuclideanSpace.single_apply, if_pos rfl,
          smul_eq_mul, mul_one]
        simp only [if_true, mul_one]
        linarith
      · rw [dist_eq_norm, sub_add_cancel_left, norm_neg, norm_smul, EuclideanSpace.norm_single,
          norm_one, mul_one, Real.norm_eq_abs, abs_of_pos (by linarith)]
        linarith
  exact hasFDerivWithinAt_univ.mp ((hP.union hN).mono hcov)

theorem seeley_halfspace_extension (a : ℕ → ℝ)
    (ha : ∀ p : ℕ, Summable (fun k : ℕ => |a k| * ((2:ℝ) ^ k) ^ p))
    (hid : ∀ (m : ℕ) (T : ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ) (v : Fin m → E3),
      HasSum (fun k : ℕ => a k * T (fun i => v i - ((1 + (2:ℝ) ^ k) * v i 0) • e 0)) (T v))
    (hglue : ∀ (m : ℕ) (h : E3 → ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ)
      (Q : E3 → E3 →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ),
      Continuous h → Continuous Q → (∀ y : E3, y 0 ≠ 0 → HasFDerivAt h (Q y) y) →
      ∀ y : E3, HasFDerivAt h (Q y) y)
    (w : E3 → ℝ) (hw : ContDiff ℝ ∞ w) (B : ℕ → ℝ)
    (hB : ∀ (m : ℕ) (y : E3), 0 ≤ y 0 → ‖iteratedFDeriv ℝ m w y‖ ≤ B m) :
    ∃ W : E3 → ℝ, ContDiff ℝ ∞ W ∧
      (∀ (m : ℕ) (y : E3), ‖iteratedFDeriv ℝ m W y‖ ≤ (1 + ∑' k : ℕ, |a k| * ((2:ℝ) ^ k) ^ m) * B m) ∧
      ∀ (m : ℕ) (y : E3), 0 ≤ y 0 → iteratedFDeriv ℝ m W y = iteratedFDeriv ℝ m w y :=
by
  
  have hle : ∀ m : ℕ, (m : WithTop ℕ∞) ≤ ∞ := fun m => by
    exact_mod_cast WithTop.coe_le_coe.mpr (le_top : (m : ℕ∞) ≤ ⊤)
  have hlt : ∀ m : ℕ, (m : WithTop ℕ∞) < ∞ := fun m => by
    exact_mod_cast WithTop.coe_lt_coe.mpr (ENat.coe_lt_top m)
  
  have hjet : ∀ g : E3 → ℝ, ContDiff ℝ ∞ g → ∀ (m : ℕ) (x : E3),
      HasFDerivAt (fun y => iteratedFDeriv ℝ m g y) ((iteratedFDeriv ℝ (m + 1) g x).curryLeft) x := by
    intro g hg m x
    exact (contDiff_iff_ftaylorSeries.mp hg).fderiv m (hlt m) x
  have hc0 : Continuous (fun y : E3 => y 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  
  obtain ⟨L, hLdef⟩ : ∃ L : ℕ → E3 →L[ℝ] E3, L = fun k => ContinuousLinearMap.id ℝ E3 -
      (1 + (2:ℝ) ^ k) • (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e 0) := ⟨_, rfl⟩
  have hLx : ∀ (k : ℕ) (x : E3), L k x = x - ((1 + (2:ℝ) ^ k) * x 0) • e 0 := by
    intro k x
    rw [hLdef]
    simp [smul_smul]
  have hLi : ∀ (k : ℕ) (x : E3) (i : Fin 3),
      (L k x) i = x i - (1 + (2:ℝ) ^ k) * x 0 * (if i = 0 then 1 else 0) := by
    intro k x i
    rw [hLx]
    by_cases h : i = 0
    · subst h; simp
    · simp [h, EuclideanSpace.single_apply]
  have hL0 : ∀ (k : ℕ) (x : E3), (L k x) 0 = -((2:ℝ) ^ k) * x 0 := by
    intro k x
    rw [hLi]; simp; ring
  have hLn : ∀ k : ℕ, ‖L k‖ ≤ (2:ℝ) ^ k := by
    intro k
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun x => ?_)
    have h1 : ‖L k x‖ ^ 2 ≤ ((2:ℝ) ^ k * ‖x‖) ^ 2 := by
      rw [mul_pow, EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq, Fin.sum_univ_three,
        Fin.sum_univ_three]
      have c0 := hL0 k x
      have c1 : (L k x) 1 = x 1 := by rw [hLi]; simp
      have c2 : (L k x) 2 = x 2 := by rw [hLi]; simp
      simp only [Real.norm_eq_abs, sq_abs]
      rw [c0, c1, c2]
      have hp : (1:ℝ) ≤ ((2:ℝ) ^ k) ^ 2 := one_le_pow₀ (one_le_pow₀ (by norm_num))
      nlinarith [mul_le_mul_of_nonneg_right hp (sq_nonneg (x 1)),
        mul_le_mul_of_nonneg_right hp (sq_nonneg (x 2))]
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp h1
  have hpos : ∀ (k : ℕ) (z : E3), z 0 ≤ 0 → 0 ≤ (L k z) 0 := by
    intro k z hz
    rw [hL0]
    have := pow_pos (two_pos : (0:ℝ) < 2) k
    nlinarith
  
  obtain ⟨f, hfdef⟩ : ∃ f : ℕ → E3 → ℝ, f = fun k y => a k * w (L k y) := ⟨_, rfl⟩
  have hfeq : ∀ k, f k = a k • (w ∘ ⇑(L k)) := by
    intro k; funext y; simp [hfdef, smul_eq_mul]
  have hf : ∀ k, ContDiff ℝ ∞ (f k) := by
    intro k; rw [hfeq k]; exact (hw.comp_continuousLinearMap (g := L k)).const_smul (a k)
  have hTf : ∀ (k m : ℕ) (z : E3), iteratedFDeriv ℝ m (f k) z =
      a k • (iteratedFDeriv ℝ m w (L k z)).compContinuousLinearMap (fun _ => L k) := by
    intro k m z
    rw [hfeq k, iteratedFDeriv_const_smul_apply
      ((hw.comp_continuousLinearMap (g := L k)).contDiffAt.of_le (hle m)),
      ContinuousLinearMap.iteratedFDeriv_comp_right (L k) hw z (hle m)]
  have hB0 : ∀ m, 0 ≤ B m := fun m => le_trans (norm_nonneg _) (hB m 0 (by simp))
  have hbnd : ∀ (m k : ℕ) (z : E3), z 0 ≤ 0 →
      ‖iteratedFDeriv ℝ m (f k) z‖ ≤ |a k| * ((2:ℝ) ^ k) ^ m * B m := by
    intro m k z hz
    rw [hTf, norm_smul, Real.norm_eq_abs]
    have h1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
      (iteratedFDeriv ℝ m w (L k z)) (fun _ : Fin m => L k)
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at h1
    have h2 : ‖L k‖ ^ m ≤ ((2:ℝ) ^ k) ^ m := pow_le_pow_left₀ (norm_nonneg _) (hLn k) m
    have h3 := hB m (L k z) (hpos k z hz)
    have h4 : ‖(iteratedFDeriv ℝ m w (L k z)).compContinuousLinearMap (fun _ => L k)‖ ≤
        B m * ((2:ℝ) ^ k) ^ m :=
      h1.trans (mul_le_mul h3 h2 (by positivity) (hB0 m))
    calc |a k| * _ ≤ |a k| * (B m * ((2:ℝ) ^ k) ^ m) := mul_le_mul_of_nonneg_left h4 (abs_nonneg _)
      _ = _ := by ring
  have hu : ∀ m : ℕ, Summable (fun k : ℕ => |a k| * ((2:ℝ) ^ k) ^ m * B m) :=
    fun m => (ha m).mul_right (B m)
  
  obtain ⟨S, hSdef⟩ : ∃ S : (m : ℕ) → E3 → ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ,
      S = fun m z => ∑' k, iteratedFDeriv ℝ m (f k) z := ⟨_, rfl⟩
  have hSapp : ∀ (m : ℕ) (z : E3), S m z = ∑' k, iteratedFDeriv ℝ m (f k) z := by
    intro m z; rw [hSdef]
  have hSfun : ∀ m : ℕ, S m = fun z => ∑' k, iteratedFDeriv ℝ m (f k) z := by
    intro m; rw [hSdef]
  have hSsum : ∀ (m : ℕ) (z : E3), z 0 ≤ 0 → Summable (fun k => iteratedFDeriv ℝ m (f k) z) :=
    fun m z hz => Summable.of_norm_bounded (hu m) (fun k => hbnd m k z hz)
  have hSbnd : ∀ (m : ℕ) (z : E3), z 0 ≤ 0 →
      ‖S m z‖ ≤ ∑' k, |a k| * ((2:ℝ) ^ k) ^ m * B m := by
    intro m z hz
    rw [hSapp]
    exact tsum_of_norm_bounded (hu m).hasSum (fun k => hbnd m k z hz)
  have hScont : ∀ m : ℕ, ContinuousOn (S m) {z : E3 | z 0 ≤ 0} := by
    intro m
    rw [hSfun m]
    exact continuousOn_tsum (fun k => ((hf k).continuous_iteratedFDeriv (hle m)).continuousOn)
      (hu m) (fun k x hx => hbnd m k x hx)
  
  have hopen : IsOpen {y : E3 | y 0 < 0} := isOpen_lt hc0 continuous_const
  have hlin : IsLinearMap ℝ (fun y : E3 => y 0) := ⟨fun x y => by simp, fun c x => by simp⟩
  have hpre : IsPreconnected {y : E3 | y 0 < 0} :=
    (convex_halfSpace_lt hlin (0:ℝ)).isPreconnected
  have hx0 : (-(e 0) : E3) ∈ {y : E3 | y 0 < 0} := by
    show (-(e 0) : E3) 0 < 0
    simp
  have hS4 : ∀ (m : ℕ) (z : E3), z 0 < 0 → HasFDerivAt (S m) ((S (m + 1) z).curryLeft) z := by
    intro m z hz
    have hsw : (∑' k, (iteratedFDeriv ℝ (m + 1) (f k) z).curryLeft) =
        (∑' k, iteratedFDeriv ℝ (m + 1) (f k) z).curryLeft :=
      ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => E3) ℝ).toContinuousLinearEquiv.map_tsum).symm
    have key := hasFDerivAt_tsum_of_isPreconnected
      (u := fun k => |a k| * ((2:ℝ) ^ k) ^ (m + 1) * B (m + 1))
      (f := fun k => iteratedFDeriv ℝ m (f k))
      (f' := fun k x => (iteratedFDeriv ℝ (m + 1) (f k) x).curryLeft)
      (s := {y : E3 | y 0 < 0}) (x₀ := -(e 0)) (x := z)
      (hu (m + 1)) hopen hpre (fun k x _ => hjet (f k) (hf k) m x)
      (fun k x hx => by
        rw [ContinuousMultilinearMap.curryLeft_norm]
        exact hbnd (m + 1) k x (le_of_lt hx))
      hx0 (hSsum m _ (le_of_lt hx0)) hz
    rw [hSfun m, hSapp (m + 1) z, ← hsw]
    exact key
  
  have hSeq : ∀ (m : ℕ) (x : E3), x 0 = 0 → S m x = iteratedFDeriv ℝ m w x := by
    intro m x hx
    have hsum := hSsum m x hx.le
    have hLxx : ∀ k, L k x = x := fun k => by rw [hLx, hx]; simp
    ext v
    rw [hSapp, ContinuousMultilinearMap.tsum_eval hsum]
    have hterm : ∀ k, (iteratedFDeriv ℝ m (f k) x) v = a k *
        (iteratedFDeriv ℝ m w x) (fun i => v i - ((1 + (2:ℝ) ^ k) * v i 0) • e 0) := by
      intro k
      rw [hTf, ContinuousMultilinearMap.smul_apply,
        ContinuousMultilinearMap.compContinuousLinearMap_apply, hLxx, smul_eq_mul]
      simp only [hLx]
    rw [tsum_congr hterm]
    exact (hid m _ v).tsum_eq
  
  obtain ⟨P, hPdef⟩ : ∃ P : E3 → FormalMultilinearSeries ℝ E3 ℝ,
      P = fun x m => if x 0 ≤ 0 then S m x else iteratedFDeriv ℝ m w x := ⟨_, rfl⟩
  have hPapp : ∀ (x : E3) (m : ℕ), P x m = if x 0 ≤ 0 then S m x else iteratedFDeriv ℝ m w x := by
    intro x m; rw [hPdef]
  have hPc : ∀ m : ℕ, Continuous (fun x => P x m) := by
    intro m
    have hfun : (fun x => P x m) = fun x => if x 0 ≤ 0 then S m x else iteratedFDeriv ℝ m w x := by
      funext x; exact hPapp x m
    rw [hfun]
    exact continuous_if_le (f := fun x : E3 => x 0) (g := fun _ => (0:ℝ)) (f' := S m)
      (g' := fun x => iteratedFDeriv ℝ m w x) hc0 continuous_const (hScont m)
      ((hw.continuous_iteratedFDeriv (hle m)).continuousOn) (fun x hx => hSeq m x hx)
  have hPd : ∀ (m : ℕ) (x : E3), HasFDerivAt (fun y => P y m) ((P x (m + 1)).curryLeft) x := by
    intro m
    refine hglue m (fun y => P y m) (fun x => (P x (m + 1)).curryLeft) (hPc m) ?_ ?_
    · exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => E3) ℝ).continuous.comp
        (hPc (m + 1))
    · intro y hy
      rcases lt_or_gt_of_ne hy with hneg | hposy
      · have hev : (fun x => P x m) =ᶠ[𝓝 y] S m := by
          filter_upwards [hopen.mem_nhds hneg] with x hx
          rw [hPapp, if_pos (le_of_lt hx)]
        show HasFDerivAt (fun y => P y m) ((P y (m + 1)).curryLeft) y
        rw [hPapp y (m + 1), if_pos hneg.le]
        exact (hS4 m y hneg).congr_of_eventuallyEq hev
      · have hev : (fun x => P x m) =ᶠ[𝓝 y] (fun x => iteratedFDeriv ℝ m w x) := by
          filter_upwards [(isOpen_lt continuous_const hc0).mem_nhds hposy] with x hx
          rw [hPapp, if_neg (not_le.mpr hx)]
        show HasFDerivAt (fun y => P y m) ((P y (m + 1)).curryLeft) y
        rw [hPapp y (m + 1), if_neg (not_le.mpr hposy)]
        exact (hjet w hw m y).congr_of_eventuallyEq hev
  obtain ⟨W, hWdef⟩ : ∃ W : E3 → ℝ, W = fun x => (P x 0) 0 := ⟨_, rfl⟩
  have hTS : HasFTaylorSeriesUpTo ((⊤ : ℕ∞) : WithTop ℕ∞) W P := by
    refine HasFTaylorSeriesUpTo.mk (fun x => ?_) (fun m _ x => hPd m x) (fun m _ => hPc m)
    rw [hWdef, ContinuousMultilinearMap.curry0_apply]
  have hWs : ContDiff ℝ ∞ W := hTS.contDiff
  have hWD : ∀ (m : ℕ) (y : E3), iteratedFDeriv ℝ m W y = P y m :=
    fun m y => (hTS.eq_iteratedFDeriv (hle m) y).symm
  have hA0 : ∀ m : ℕ, 0 ≤ ∑' k : ℕ, |a k| * ((2:ℝ) ^ k) ^ m :=
    fun m => tsum_nonneg (fun k => by positivity)
  refine ⟨W, hWs, ?_, ?_⟩
  · intro m y
    rw [hWD, hPapp]
    split_ifs with h
    · have h1 := hSbnd m y h
      rw [tsum_mul_right] at h1
      nlinarith [hA0 m, hB0 m]
    · have h1 := hB m y (le_of_lt (not_le.mp h))
      nlinarith [hA0 m, hB0 m]
  · intro m y hy
    rw [hWD, hPapp]
    split_ifs with h
    · exact hSeq m y (le_antisymm h hy)
    · rfl

theorem fcr_seeley_package : ∃ A : ℕ → ℝ, ∀ (u : E3 → ℝ), ContDiff ℝ ∞ u → ∀ B : ℕ → ℝ,
    (∀ (m : ℕ) (y : E3), 0 ≤ y 0 → ‖iteratedFDeriv ℝ m u y‖ ≤ B m) →
    ∃ U : E3 → ℝ, ContDiff ℝ ∞ U ∧ (∀ (m : ℕ) (y : E3), ‖iteratedFDeriv ℝ m U y‖ ≤ A m * B m) ∧
      ∀ y : E3, 0 ≤ y 0 → U y = u y :=
by
  classical
  obtain ⟨hbound, hsum⟩ := seeley_weight_bound
  obtain ⟨a, ha, hmom⟩ := seeley_weights_limit
    (fun i => Real.exp 4 * (4:ℝ) ^ i * (1 / 2 : ℝ) ^ (i * (i + 1) / 2))
    (fun K i => if i < K then ∏ j ∈ (Finset.range K).erase i,
        ((-1 - (2:ℝ) ^ j) / ((2:ℝ) ^ i - (2:ℝ) ^ j)) else 0)
    hsum
    (by
      intro K i
      by_cases h : i < K
      · simp only [if_pos h]
        exact hbound K i h
      · simp only [if_neg h, abs_zero]
        positivity)
    (by
      intro K i h
      simp only [if_neg (not_lt.mpr h)])
    (by
      intro K p hp
      refine Eq.trans ?_ (seeley_weight_moment K p hp)
      refine Finset.sum_congr rfl ?_
      intro i hi
      simp only [if_pos (Finset.mem_range.mp hi)])
  have hid := seeley_multilinear_identity a ha hmom
  have hglue : ∀ (m : ℕ) (h : E3 → ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ)
      (Q : E3 → E3 →L[ℝ] ContinuousMultilinearMap ℝ (fun _ : Fin m => E3) ℝ),
      Continuous h → Continuous Q → (∀ y : E3, y 0 ≠ 0 → HasFDerivAt h (Q y) y) →
      ∀ y : E3, HasFDerivAt h (Q y) y :=
    fun m h Q hh hQ hoff y => halfspace_hasFDerivAt_glue h Q hh hQ hoff y
  refine ⟨fun m => 1 + ∑' k : ℕ, |a k| * ((2:ℝ) ^ k) ^ m, ?_⟩
  intro u hu B hB
  obtain ⟨U, hU, hUb, hUe⟩ := seeley_halfspace_extension a ha hid hglue u hu B hB
  refine ⟨U, hU, hUb, ?_⟩
  intro y hy
  have h0 := congrArg (fun T => T (Fin.elim0 : Fin 0 → E3)) (hUe 0 y hy)
  simpa only [iteratedFDeriv_zero_apply] using h0

theorem fcr_ae_identify (O : Set E3) (hO : IsOpen O) (w v' : E3 → ℝ) (hw : IntegrableOn w O)
    (hv' : Continuous v') (M : ℕ → E3 → ℝ) (hM : ∀ k, Continuous (M k)) (B : ℝ)
    (hbd : ∀ k, ∀ x ∈ O, |M k x| ≤ B)
    (hpt : ∀ x ∈ O, Tendsto (fun k => M k x) atTop (𝓝 (v' x)))
    (hweak : ∀ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ O →
      Tendsto (fun k => ∫ x, M k x * ψ x) atTop (𝓝 (∫ x, w x * ψ x))) :
    ∀ᵐ x ∂(volume.restrict O), w x = v' x :=
by
  have hOm : MeasurableSet O := hO.measurableSet
  have key : ∀ ψ : E3 → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ O →
      ∫ x, ψ x • (w - v') x = 0 := by
    intro ψ hψ hψc hψs
    have hψcont : Continuous ψ := hψ.continuous
    have hoff : ∀ x, x ∉ O → ψ x = 0 := fun x hx =>
      image_eq_zero_of_notMem_tsupport (fun h => hx (hψs h))
    have hbint : Integrable (fun x => B * |ψ x|) :=
      ((hψcont.integrable_of_hasCompactSupport hψc).abs).const_mul B
    have hdct : Tendsto (fun k => ∫ x, M k x * ψ x) atTop (𝓝 (∫ x, v' x * ψ x)) := by
      refine tendsto_integral_of_dominated_convergence (fun x => B * |ψ x|)
        (fun k => ((hM k).mul hψcont).aestronglyMeasurable) hbint ?_ ?_
      · intro k
        refine Filter.Eventually.of_forall (fun x => ?_)
        by_cases hx : x ∈ O
        · rw [Real.norm_eq_abs, abs_mul]
          exact mul_le_mul_of_nonneg_right (hbd k x hx) (abs_nonneg _)
        · simp [hoff x hx]
      · refine Filter.Eventually.of_forall (fun x => ?_)
        by_cases hx : x ∈ O
        · exact (hpt x hx).mul_const (ψ x)
        · simp only [hoff x hx, mul_zero]
          exact tendsto_const_nhds
    have heq : ∫ x, w x * ψ x = ∫ x, v' x * ψ x :=
      tendsto_nhds_unique (hweak ψ hψ hψc hψs) hdct
    have hv'int : Integrable (fun x => v' x * ψ x) :=
      (hv'.mul hψcont).integrable_of_hasCompactSupport hψc.mul_left
    obtain ⟨C, hC⟩ := hψc.exists_bound_of_continuous hψcont
    have hwind : Integrable (O.indicator w) := (integrable_indicator_iff hOm).mpr hw
    have hwint : Integrable (fun x => w x * ψ x) := by
      have h1 : Integrable (fun x => O.indicator w x * ψ x) :=
        hwind.mul_bdd hψcont.aestronglyMeasurable (Filter.Eventually.of_forall hC)
      refine h1.congr (Filter.Eventually.of_forall (fun x => ?_))
      by_cases hx : x ∈ O
      · simp [Set.indicator_of_mem hx]
      · simp [hoff x hx]
    have hfun : (fun x => ψ x • (w - v') x) = fun x => w x * ψ x - v' x * ψ x := by
      funext x
      simp only [smul_eq_mul, Pi.sub_apply]
      ring
    rw [hfun, integral_sub hwint hv'int, heq, sub_self]
  have hloc : LocallyIntegrableOn (w - v') O volume :=
    hw.locallyIntegrableOn.sub (hv'.locallyIntegrable.locallyIntegrableOn O)
  have h := hO.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc key
  rw [ae_restrict_iff' hOm]
  filter_upwards [h] with x hx hxO
  exact sub_eq_zero.mp (hx hxO)

theorem fcr_smooth_representative (c : E3) (ρ ρ' : ℝ) (hρ' : 0 < ρ') (hρρ' : ρ' < ρ)
    (w : E3 → ℝ) (hw : ∀ k : ℕ, ∃ D : List (Fin 3) → E3 → ℝ, fcrSob c ρ k w D) :
    ∃ v' : E3 → ℝ, ContDiff ℝ ∞ v' ∧ ∀ᵐ x ∂(volume.restrict (fcrHalf c ρ')), w x = v' x :=
by
  classical
  
  choose D hD using hw
  obtain ⟨d, hd⟩ : ∃ d : ℝ, d = ρ - ρ' := ⟨_, rfl⟩
  obtain ⟨ε₀, hε₀⟩ : ∃ ε₀ : ℝ, ε₀ = d / 12 := ⟨_, rfl⟩
  obtain ⟨ρ₂, hρ₂⟩ : ∃ ρ₂ : ℝ, ρ₂ = ρ' + d / 4 := ⟨_, rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : ℝ, τ = d / 8 := ⟨_, rfl⟩
  have hd0 : 0 < d := by rw [hd]; linarith
  have hε₀0 : 0 < ε₀ := by rw [hε₀]; linarith
  have hτ0 : 0 < τ := by rw [hτ]; linarith
  have hρ'ρ₂ : ρ' < ρ₂ := by rw [hρ₂]; linarith
  have hrad : ρ₂ + 2 * τ ≤ ρ - 3 * ε₀ := by rw [hρ₂, hτ, hε₀]; rw [hd]; linarith
  have hhalfo : IsOpen {x : E3 | 0 < x 0} :=
    isOpen_lt continuous_const (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hHo : IsOpen (fcrHalf c ρ) := Metric.isOpen_ball.inter hhalfo
  have hH'o : IsOpen (fcrHalf c ρ') := Metric.isOpen_ball.inter hhalfo
  have hHm : MeasurableSet (fcrHalf c ρ) := hHo.measurableSet
  have hHsub : fcrHalf c ρ ⊆ Metric.ball c ρ := fun x hx => hx.1
  have hH'sub : fcrHalf c ρ' ⊆ fcrHalf c ρ :=
    fun x hx => ⟨Metric.ball_subset_ball hρρ'.le hx.1, hx.2⟩
  have hHfin : volume (fcrHalf c ρ) ≠ ⊤ :=
    ((measure_mono hHsub).trans_lt measure_ball_lt_top).ne
  haveI : IsFiniteMeasure (volume.restrict (fcrHalf c ρ)) := isFiniteMeasure_restrict.mpr hHfin
  have hwL2 : MemLp w 2 (volume.restrict (fcrHalf c ρ)) := by
    have h := (hD 0).2.1 [] (by simp)
    rwa [(hD 0).1] at h
  have hwInt : IntegrableOn w (fcrHalf c ρ) := hwL2.integrable (by norm_num)
  have hg0 : Integrable ((fcrHalf c ρ).indicator w) := (integrable_indicator_iff hHm).mpr hwInt
  obtain ⟨b, hb⟩ : ∃ b : ℕ → ContDiffBump (0 : E3), ∀ j, (b j).rOut = ε₀ / ((j : ℝ) + 1) :=
    ⟨fun j => ⟨ε₀ / ((j : ℝ) + 1) / 2, ε₀ / ((j : ℝ) + 1),
      div_pos (div_pos hε₀0 (Nat.cast_add_one_pos j)) two_pos,
      half_lt_self (div_pos hε₀0 (Nat.cast_add_one_pos j))⟩, fun _ => rfl⟩
  have hbε : ∀ j, (b j).rOut ≤ ε₀ := by
    intro j
    rw [hb j]
    have hj : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    exact div_le_self hε₀0.le (by linarith)
  have hbt : Tendsto (fun j => (b j).rOut) atTop (𝓝 0) := by
    have h := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul ε₀
    rw [mul_zero] at h
    refine h.congr (fun j => ?_)
    rw [hb j]
    ring
  have hMs : ∀ j, ContDiff ℝ ∞ (fcrMoll (b j) ((fcrHalf c ρ).indicator w)) :=
    fun j => (fcr_moll_deriv c ρ 0 w (D 0) (hD 0) (b j)).1 []
  
  obtain ⟨K, hK0, hK⟩ := fcr_box_jet_bound τ hτ0
  obtain ⟨Bm, hBm⟩ : ∃ Bm : ℕ → ℝ, ∀ m, Bm m = ∑ L : Fin m → Fin 3, Real.sqrt (K *
      (([[], [0], [1], [1, 0], [2], [2, 0], [2, 1], [2, 1, 0]] : List (List (Fin 3))).map
        (fun S => ∫ x, ((fcrHalf c ρ).indicator (D (m + 3) (S ++ List.ofFn L)) x) ^ 2)).sum) :=
    ⟨_, fun _ => rfl⟩
  have hBm0 : ∀ m, 0 ≤ Bm m := fun m => by
    rw [hBm m]
    exact Finset.sum_nonneg (fun _ _ => Real.sqrt_nonneg _)
  have hjet : ∀ (m : ℕ) (bb : ContDiffBump (0 : E3)), bb.rOut ≤ ε₀ → ∀ y : E3, 0 ≤ y 0 →
      dist y c ≤ ρ₂ →
      ‖iteratedFDeriv ℝ m (fcrMoll bb ((fcrHalf c ρ).indicator w)) y‖ ≤ Bm m := by
    intro m bb hbb y hy0 hyc
    obtain ⟨hsm, htr⟩ := fcr_moll_deriv c ρ (m + 3) w (D (m + 3)) (hD (m + 3)) bb
    have hr := bb.rOut_pos
    have hU : IsOpen ({x : E3 | -bb.rOut < x 0} ∩ Metric.ball c (ρ - 3 * bb.rOut)) :=
      (isOpen_lt continuous_const
        (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous).inter Metric.isOpen_ball
    have hbox : {z : E3 | ∀ i : Fin 3, y i ≤ z i ∧ z i ≤ y i + τ} ⊆
        {x : E3 | -bb.rOut < x 0} ∩ Metric.ball c (ρ - 3 * bb.rOut) := by
      intro z hz
      have hz' : ∀ i : Fin 3, y i ≤ z i ∧ z i ≤ y i + τ := hz
      refine ⟨?_, ?_⟩
      · show -bb.rOut < z 0
        linarith [(hz' 0).1]
      · have hzy : ‖z - y‖ < 2 * τ := by
          rw [EuclideanSpace.norm_eq, Real.sqrt_lt' (by linarith), Fin.sum_univ_three]
          simp only [WithLp.ofLp_sub, Pi.sub_apply, Real.norm_eq_abs, sq_abs]
          obtain ⟨a0, b0⟩ := hz' 0
          obtain ⟨a1, b1⟩ := hz' 1
          obtain ⟨a2, b2⟩ := hz' 2
          have h0 : (z 0 - y 0) ^ 2 ≤ τ ^ 2 := by nlinarith
          have h1 : (z 1 - y 1) ^ 2 ≤ τ ^ 2 := by nlinarith
          have h2 : (z 2 - y 2) ^ 2 ≤ τ ^ 2 := by nlinarith
          nlinarith
        have hyc' : ‖y - c‖ ≤ ρ₂ := by rwa [dist_eq_norm] at hyc
        rw [Metric.mem_ball, dist_eq_norm]
        calc ‖z - c‖ = ‖(z - y) + (y - c)‖ := by rw [sub_add_sub_cancel]
          _ ≤ ‖z - y‖ + ‖y - c‖ := norm_add_le _ _
          _ < ρ - 3 * bb.rOut := by linarith
    have hopen_sub : {z : E3 | ∀ i : Fin 3, y i < z i ∧ z i < y i + τ} ⊆
        {z : E3 | ∀ i : Fin 3, y i ≤ z i ∧ z i ≤ y i + τ} :=
      fun z hz i => ⟨(hz i).1.le, (hz i).2.le⟩
    have hmeas : MeasurableSet {z : E3 | ∀ i : Fin 3, y i < z i ∧ z i < y i + τ} := by
      rw [Set.setOf_forall]
      exact MeasurableSet.iInter fun i =>
        (measurableSet_lt measurable_const
          (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).continuous.measurable).inter
          (measurableSet_lt (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).continuous.measurable
            measurable_const)
    have h0 := hK m y (fcrMoll bb ((fcrHalf c ρ).indicator w)) _ hU (hsm []) hbox
    refine h0.trans ?_
    rw [hBm m]
    refine Finset.sum_le_sum (fun L _ => Real.sqrt_le_sqrt ?_)
    refine mul_le_mul_of_nonneg_left (List.sum_le_sum (fun S hS => ?_)) hK0
    have hlen : S.length ≤ 3 := by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hS
      rcases hS with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp
    have hlen' : (S ++ List.ofFn L).length ≤ m + 3 := by
      rw [List.length_append, List.length_ofFn]
      omega
    have hmem : MemLp ((fcrHalf c ρ).indicator (D (m + 3) (S ++ List.ofFn L))) 2 volume :=
      (memLp_indicator_iff_restrict hHm).mpr ((hD (m + 3)).2.1 _ hlen')
    have hcongr : ∫ z in {z : E3 | ∀ i : Fin 3, y i < z i ∧ z i < y i + τ},
        ((S ++ List.ofFn L).foldr partialDeriv (fcrMoll bb ((fcrHalf c ρ).indicator w)) z) ^ 2 =
        ∫ z in {z : E3 | ∀ i : Fin 3, y i < z i ∧ z i < y i + τ},
          (fcrMoll bb ((fcrHalf c ρ).indicator (D (m + 3) (S ++ List.ofFn L))) z) ^ 2 := by
      refine setIntegral_congr_fun hmeas (fun z hz => ?_)
      have hz' := hbox (hopen_sub hz)
      exact congrArg (fun t => t ^ 2) (htr _ hlen' z hz'.1 hz'.2)
    exact hcongr.le.trans (fcr_moll_L2 bb _ hmem _)
  
  obtain ⟨χ, hχin, hχout⟩ : ∃ χ : ContDiffBump c, χ.rIn = ρ' ∧ χ.rOut = ρ₂ :=
    ⟨⟨ρ', ρ₂, hρ', hρ'ρ₂⟩, rfl, rfl⟩
  have hχs : ContDiff ℝ ∞ (χ : E3 → ℝ) := χ.contDiff
  have hX : ∀ i : ℕ, ∃ X : ℝ, 0 ≤ X ∧ ∀ y, ‖iteratedFDeriv ℝ i (χ : E3 → ℝ) y‖ ≤ X := by
    intro i
    obtain ⟨C, hC⟩ := (χ.hasCompactSupport.iteratedFDeriv (𝕜 := ℝ) i).exists_bound_of_continuous
      ((χ.contDiff (n := ⊤)).continuous_iteratedFDeriv (by exact_mod_cast le_top))
    exact ⟨max C 0, le_max_right _ _, fun y => (hC y).trans (le_max_left _ _)⟩
  choose X hX0 hXb using hX
  obtain ⟨B', hB'⟩ : ∃ B' : ℕ → ℝ, ∀ m, B' m =
      ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * X i * Bm (m - i) := ⟨_, fun _ => rfl⟩
  have hB'0 : ∀ m, 0 ≤ B' m := fun m => by
    rw [hB' m]
    exact Finset.sum_nonneg (fun i _ =>
      mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hX0 i)) (hBm0 _))
  have hu : ∀ j (m : ℕ) (y : E3), 0 ≤ y 0 →
      ‖iteratedFDeriv ℝ m (fun z => χ z * fcrMoll (b j) ((fcrHalf c ρ).indicator w) z) y‖
        ≤ B' m := by
    intro j m y hy0
    by_cases hyc : dist y c ≤ ρ₂
    · refine (norm_iteratedFDeriv_mul_le hχs (hMs j) y (by exact_mod_cast le_top)).trans ?_
      rw [hB' m]
      refine Finset.sum_le_sum (fun i _ => ?_)
      have h1 := hXb i y
      have h2 := hjet (m - i) (b j) (hbε j) y hy0 hyc
      have h3 : ‖iteratedFDeriv ℝ i (χ : E3 → ℝ) y‖ *
          ‖iteratedFDeriv ℝ (m - i) (fcrMoll (b j) ((fcrHalf c ρ).indicator w)) y‖ ≤
          X i * Bm (m - i) := mul_le_mul h1 h2 (norm_nonneg _) (hX0 i)
      have h4 := mul_le_mul_of_nonneg_left h3 (Nat.cast_nonneg (m.choose i) :
        (0 : ℝ) ≤ (m.choose i : ℝ))
      simpa only [mul_assoc] using h4
    · have hy : y ∉ tsupport (fun z => χ z * fcrMoll (b j) ((fcrHalf c ρ).indicator w) z) := by
        intro hy
        have h := tsupport_mul_subset_left hy
        rw [χ.tsupport_eq, hχout, Metric.mem_closedBall] at h
        exact hyc h
      have h0 : iteratedFDeriv ℝ m
          (fun z => χ z * fcrMoll (b j) ((fcrHalf c ρ).indicator w) z) y = 0 := by
        by_contra hne
        exact hy (support_iteratedFDeriv_subset (𝕜 := ℝ) m (Function.mem_support.mpr hne))
      rw [h0, norm_zero]
      exact hB'0 m
  
  obtain ⟨A, hA⟩ := fcr_seeley_package
  have hext : ∀ j, ∃ U : E3 → ℝ, ContDiff ℝ ∞ U ∧
      (∀ (m : ℕ) (y : E3), ‖iteratedFDeriv ℝ m U y‖ ≤ A m * B' m) ∧
      ∀ y : E3, 0 ≤ y 0 → U y = χ y * fcrMoll (b j) ((fcrHalf c ρ).indicator w) y :=
    fun j => hA _ (hχs.mul (hMs j)) B' (fun m y hy => hu j m y hy)
  choose U hUs hUb hUeq using hext
  obtain ⟨φ, F, hφ, hFs, hFt, -⟩ := smooth_arzela_ascoli_family (ι := Unit)
    (fun j _ => U j) (fun n => A n * B' n) (fun m _ => hUs m) (fun m _ n y => hUb m n y)
  refine ⟨F (), hFs (), ?_⟩
  
  refine fcr_ae_identify (fcrHalf c ρ') hH'o w (F ()) (hwInt.mono_set hH'sub) (hFs ()).continuous
    (fun k => fcrMoll (b (φ k)) ((fcrHalf c ρ).indicator w)) (fun k => (hMs (φ k)).continuous)
    (Bm 0) ?_ ?_ ?_
  · intro k x hx
    have hx0 : (0 : ℝ) ≤ x 0 := (show (0 : ℝ) < x 0 from hx.2).le
    have hxc : dist x c ≤ ρ₂ := le_of_lt (lt_trans (Metric.mem_ball.mp hx.1) hρ'ρ₂)
    have h := hjet 0 (b (φ k)) (hbε _) x hx0 hxc
    rwa [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at h
  · intro x hx
    have hx0 : (0 : ℝ) ≤ x 0 := (show (0 : ℝ) < x 0 from hx.2).le
    have hχ1 : χ x = 1 :=
      χ.one_of_mem_closedBall (by rw [hχin]; exact Metric.ball_subset_closedBall hx.1)
    refine (hFt () x).congr (fun k => ?_)
    show U (φ k) x = fcrMoll (b (φ k)) ((fcrHalf c ρ).indicator w) x
    rw [hUeq (φ k) x hx0, hχ1, one_mul]
  · intro ψ hψ hψc hψs
    have hlim := fcr_moll_weak_limit ((fcrHalf c ρ).indicator w) hg0 ψ hψ.continuous hψc
      (fun k => b (φ k)) (hbt.comp hφ.tendsto_atTop)
    have heq : ∫ x, (fcrHalf c ρ).indicator w x * ψ x = ∫ x, w x * ψ x := by
      congr 1
      funext x
      by_cases hxH : x ∈ fcrHalf c ρ
      · rw [Set.indicator_of_mem hxH]
      · rw [Set.indicator_of_notMem hxH, zero_mul]
        have hxs : x ∉ tsupport ψ := fun h => hxH (hH'sub (hψs h))
        rw [image_eq_zero_of_notMem_tsupport hxs, mul_zero]
    rw [← heq]
    exact hlim

theorem fcr_weak_to_strong (c : E3) (ρ s : ℝ) (hs : 0 < s) (hsρ : s ≤ ρ)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c ρ))
    (F : E3 → ℝ) (hF : ContDiffOn ℝ ∞ F (Metric.ball c ρ))
    (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ)
    (hGL : ∀ a, MemLp (Gr a) 2 (volume.restrict (fcrHalf c ρ)))
    (hgrad : ∀ (a : Fin 3) (ζ : E3 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ fcrHalf c ρ → ∫ x, v x * partialDeriv a ζ x = -∫ x, Gr a x * ζ x)
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c ρ →
      ∫ x in fcrHalf c ρ,
        (∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x + F x * ζ x) = 0)
    (v' : E3 → ℝ) (hv' : ContDiff ℝ ∞ v')
