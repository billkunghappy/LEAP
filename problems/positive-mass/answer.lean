    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  have hQpos : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ v : E3, v ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * v i * v j := by
    intro q y hy v hv
    have hx : (fun i => v i : Fin 3 → ℝ) ≠ 0 := by
      intro h
      apply hv
      ext i
      exact congrFun h i
    have h := (hposDef q y hy).dotProduct_mulVec_pos hx
    have key : star (fun i => v i : Fin 3 → ℝ) ⬝ᵥ
        (g.coeff (chartAt E3 q).symm y).mulVec (fun i => v i) =
          ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * v i * v j := by
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
      ring
    rw [key] at h
    exact h
  
  have hchart : ∀ (q : M) (Wk : Set M), Wk ⊆ U ∩ (chartAt E3 q).source →
      hullPerG (g.coeff (chartAt E3 q).symm) (chartAt E3 q '' (E ∩ (chartAt E3 q).source))
          (chartAt E3 q '' Wk) (chartAt E3 q '' (K ∩ (chartAt E3 q).source)) ≤
        hullPerG (g.coeff (chartAt E3 q).symm) (chartAt E3 q '' (E ∩ (chartAt E3 q).source))
            (chartAt E3 q '' (Wk ∩ A)) (chartAt E3 q '' (K ∩ (chartAt E3 q).source)) +
          hullPerG (g.coeff (chartAt E3 q).symm) (chartAt E3 q '' (E ∩ (chartAt E3 q).source))
            (chartAt E3 q '' (Wk ∩ B)) (chartAt E3 q '' (K ∩ (chartAt E3 q).source)) := by
    intro q Wk hWs
    have hWsrc : Wk ⊆ (chartAt E3 q).source := fun x hx => (hWs hx).2
    have hOT : chartAt E3 q '' Wk ⊆ (chartAt E3 q).target := by
      rintro y ⟨x, hx, rfl⟩
      exact (chartAt E3 q).map_source (hWsrc hx)
    have hOA : IsOpen (chartAt E3 q '' (A ∩ (chartAt E3 q).source)) :=
      (chartAt E3 q).isOpen_image_of_subset_source (hA.inter (chartAt E3 q).open_source)
        Set.inter_subset_right
    have hOB : IsOpen (chartAt E3 q '' (B ∩ (chartAt E3 q).source)) :=
      (chartAt E3 q).isOpen_image_of_subset_source (hB.inter (chartAt E3 q).open_source)
        Set.inter_subset_right
    have hO : chartAt E3 q '' Wk ⊆ chartAt E3 q '' (A ∩ (chartAt E3 q).source) ∪
        chartAt E3 q '' (B ∩ (chartAt E3 q).source) := by
      rintro y ⟨x, hx, rfl⟩
      rcases hUAB (hWs hx).1 with h | h
      · exact Or.inl ⟨x, ⟨h, hWsrc hx⟩, rfl⟩
      · exact Or.inr ⟨x, ⟨h, hWsrc hx⟩, rfl⟩
    have hnullq : volume (chartAt E3 q '' (K ∩ (chartAt E3 q).source) ∩
        chartAt E3 q '' (A ∩ (chartAt E3 q).source)) = 0 := by
      rw [← (chartAt E3 q).injOn.image_inter Set.inter_subset_right Set.inter_subset_right]
      have hset : (K ∩ (chartAt E3 q).source) ∩ (A ∩ (chartAt E3 q).source) =
          (K ∩ A) ∩ (chartAt E3 q).source := by
        ext x
        constructor
        · rintro ⟨⟨h1, h2⟩, h3, _⟩
          exact ⟨⟨h1, h3⟩, h2⟩
        · rintro ⟨⟨h1, h3⟩, h2⟩
          exact ⟨⟨h1, h2⟩, h3, h2⟩
      rw [hset]
      exact hnull q
    have hinter : ∀ S : Set M, chartAt E3 q '' Wk ∩ chartAt E3 q '' (S ∩ (chartAt E3 q).source) =
        chartAt E3 q '' (Wk ∩ S) := by
      intro S
      rw [← (chartAt E3 q).injOn.image_inter hWsrc Set.inter_subset_right]
      congr 1
      ext x
      constructor
      · rintro ⟨h1, h2, _⟩
        exact ⟨h1, h2⟩
      · rintro ⟨h1, h2⟩
        exact ⟨h1, h2, hWsrc h1⟩
    have h := HL (g.coeff (chartAt E3 q).symm) (chartAt E3 q).target (chartAt E3 q).open_target
      (g.smooth q) (fun y hy => (hposDef q y hy).det_pos) (hQpos q)
      (chartAt E3 q '' (E ∩ (chartAt E3 q).source)) (chartAt E3 q '' Wk)
      (chartAt E3 q '' (A ∩ (chartAt E3 q).source)) (chartAt E3 q '' (B ∩ (chartAt E3 q).source))
      (chartAt E3 q '' (K ∩ (chartAt E3 q).source)) hOT hOA hOB hO hnullq
    rwa [hinter A, hinter B] at h
  unfold hullRiemPer
  refine iSup_le fun n => iSup_le fun p => iSup_le fun W => iSup_le fun hW => ?_
  have hWA : (∀ k, IsOpen (W k ∩ A) ∧ W k ∩ A ⊆ (U ∩ A) ∩ (chartAt E3 (p k)).source) ∧
      Pairwise (fun k l => Disjoint (W k ∩ A) (W l ∩ A)) :=
    ⟨fun k => ⟨(hW.1 k).1.inter hA,
        fun x hx => ⟨⟨((hW.1 k).2 hx.1).1, hx.2⟩, ((hW.1 k).2 hx.1).2⟩⟩,
      fun k l hkl => (hW.2 hkl).mono Set.inter_subset_left Set.inter_subset_left⟩
  have hWB : (∀ k, IsOpen (W k ∩ B) ∧ W k ∩ B ⊆ (U ∩ B) ∩ (chartAt E3 (p k)).source) ∧
      Pairwise (fun k l => Disjoint (W k ∩ B) (W l ∩ B)) :=
    ⟨fun k => ⟨(hW.1 k).1.inter hB,
        fun x hx => ⟨⟨((hW.1 k).2 hx.1).1, hx.2⟩, ((hW.1 k).2 hx.1).2⟩⟩,
      fun k l hkl => (hW.2 hkl).mono Set.inter_subset_left Set.inter_subset_left⟩
  refine le_trans (Finset.sum_le_sum fun k _ => hchart (p k) (W k) (hW.1 k).2) ?_
  rw [Finset.sum_add_distrib]
  refine add_le_add ?_ ?_
  · exact le_iSup_of_le n (le_iSup_of_le p (le_iSup_of_le (fun k => W k ∩ A)
      (le_iSup_of_le hWA le_rfl)))
  · exact le_iSup_of_le n (le_iSup_of_le p (le_iSup_of_le (fun k => W k ∩ B)
      (le_iSup_of_le hWB le_rfl)))

theorem hullRiemPer_sector_add_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (F₁ F₂ Ω K : Set M) (p : M) (ε : ℝ)
    (hBΩ : Metric.ball (chartAt E3 p p) ε ⊆ chartAt E3 p '' (Ω ∩ (chartAt E3 p).source))
    (k : ℕ) (φ : Fin k → E3 → ℝ)
    (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) (Metric.ball (chartAt E3 p p) ε))
    (hdφ : ∀ i, ∀ z ∈ Metric.ball (chartAt E3 p p) ε, fderiv ℝ (φ i) z ≠ 0)
    (hwall : ∀ z ∈ Metric.ball (chartAt E3 p p) ε,
      ((chartAt E3 p).symm z ∈ K ↔ ∃ i, φ i z = 0))
    (K' V₁ V₂ : Set E3) (hF₁ : sepChartMeas F₁) (hF₂ : sepChartMeas F₂) (hK' : IsCompact K')
    (hV₁ : IsOpen V₁) (hV₂ : IsOpen V₂) (hK'V₂ : K' ⊆ V₂) (hV₂c : IsCompact (closure V₂))
    (hV₂V₁ : closure V₂ ⊆ V₁) (hV₁B : V₁ ⊆ Metric.ball (chartAt E3 p p) ε)
    (hsd : symmDiff F₁ F₂ ⊆ (chartAt E3 p).symm '' K') :
    hullRiemPer g F₂ Ω K +
        hspSectorPer (g.coeff (chartAt E3 p).symm) (Metric.ball (chartAt E3 p p) ε) φ
          (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) V₂ ≤
      hullRiemPer g F₁ Ω K +
        hspSectorPer (g.coeff (chartAt E3 p).symm) (Metric.ball (chartAt E3 p p) ε) φ
          (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source)) V₁ +
        hspSectorPer (g.coeff (chartAt E3 p).symm) (Metric.ball (chartAt E3 p p) ε) φ
          (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) (V₁ \ K') :=
by
  classical
  set κ := chartAt E3 p with hκ
  set G := g.coeff κ.symm with hGdef
  set B := Metric.ball (κ p) ε with hBdef
  
  have hBt : B ⊆ κ.target := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hBΩ hz
    exact κ.map_source hx.2
  have hF2 : ∀ S : Set E3, S ⊆ B → κ.symm '' S ⊆ Ω ∩ κ.source := by
    rintro S hS _ ⟨z, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hBΩ (hS hz)
    rw [κ.left_inv hx.2]
    exact hx
  have himg : ∀ S : Set E3, S ⊆ B → κ '' (κ.symm '' S) = S := fun S hS =>
    κ.toPartialEquiv.image_symm_image_of_subset_target (hS.trans hBt)
  have hopen : ∀ S : Set E3, IsOpen S → S ⊆ B → IsOpen (κ.symm '' S) := fun S hS hSB =>
    κ.isOpen_image_symm_of_subset_target hS (hSB.trans hBt)
  have hcpt : ∀ S : Set E3, IsCompact S → S ⊆ B → IsCompact (κ.symm '' S) := fun S hS hSB =>
    hS.image_of_continuousOn (κ.continuousOn_symm.mono (hSB.trans hBt))
  have hV₂B : V₂ ⊆ B := subset_closure.trans (hV₂V₁.trans hV₁B)
  have hcV₂B : closure V₂ ⊆ B := hV₂V₁.trans hV₁B
  have hK'B : K' ⊆ B := hK'V₂.trans hV₂B
  have hDB : V₁ \ K' ⊆ B := Set.diff_subset.trans hV₁B
  
  obtain ⟨L, hLdef⟩ : ∃ S : Set M, S = κ.symm '' K' := ⟨_, rfl⟩
  obtain ⟨V₁', hV₁'def⟩ : ∃ S : Set M, S = κ.symm '' V₁ := ⟨_, rfl⟩
  obtain ⟨V₂', hV₂'def⟩ : ∃ S : Set M, S = κ.symm '' V₂ := ⟨_, rfl⟩
  obtain ⟨C₂, hC₂def⟩ : ∃ S : Set M, S = κ.symm '' closure V₂ := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ S : Set M, S = κ.symm '' (V₁ \ K') := ⟨_, rfl⟩
  have hsd' : symmDiff F₁ F₂ ⊆ L := by rw [hLdef]; exact hsd
  have hLo : IsOpen Lᶜ := by rw [hLdef]; exact (hcpt K' hK' hK'B).isClosed.isOpen_compl
  have hC₂o : IsOpen C₂ᶜ := by rw [hC₂def]; exact (hcpt _ hV₂c hcV₂B).isClosed.isOpen_compl
  have hV₁'o : IsOpen V₁' := by rw [hV₁'def]; exact hopen V₁ hV₁ hV₁B
  have hV₂'o : IsOpen V₂' := by rw [hV₂'def]; exact hopen V₂ hV₂ hV₂B
  have hDo : IsOpen D := by rw [hDdef]; exact hopen _ (hV₁.sdiff hK'.isClosed) hDB
  have hV₁'s : V₁' ⊆ κ.source := by rw [hV₁'def]; exact fun x hx => (hF2 V₁ hV₁B hx).2
  have hV₂'Ω : V₂' ⊆ Ω ∩ κ.source := by rw [hV₂'def]; exact hF2 V₂ hV₂B
  have hDs : D ⊆ κ.source := by rw [hDdef]; exact fun x hx => (hF2 _ hDB hx).2
  have hV₁'img : κ '' V₁' = V₁ := by rw [hV₁'def]; exact himg V₁ hV₁B
  have hV₂'img : κ '' V₂' = V₂ := by rw [hV₂'def]; exact himg V₂ hV₂B
  have hDimg : κ '' D = V₁ \ K' := by rw [hDdef]; exact himg _ hDB
  have hLV₁' : L ⊆ V₁' := by
    rw [hLdef, hV₁'def]; exact Set.image_mono (hK'V₂.trans (subset_closure.trans hV₂V₁))
  have hV₂'C₂ : V₂' ⊆ C₂ := by rw [hV₂'def, hC₂def]; exact Set.image_mono subset_closure
  
  have hZnull : volume (⋃ i, B ∩ φ i ⁻¹' {0}) = 0 :=
    measure_iUnion_null fun i => submersion_zero_null B Metric.isOpen_ball (φ i) (hφ i) (hdφ i)
  obtain ⟨Z, hZdef⟩ : ∃ S : Set E3, S = {z | z ∈ B ∧ ∃ i, φ i z = 0} := ⟨_, rfl⟩
  have hZB : Z ⊆ B := by rw [hZdef]; exact fun z hz => hz.1
  have hNw : sepChartNull (κ.symm '' Z) := by
    refine sepChartNull_of_image_null p _ (fun x hx => (hF2 Z hZB hx).2) ?_
    show volume (κ '' (κ.symm '' Z)) = 0
    rw [himg Z hZB]
    refine measure_mono_null ?_ hZnull
    rw [hZdef]
    rintro z ⟨hzB, i, hi⟩
    exact Set.mem_iUnion.2 ⟨i, hzB, hi⟩
  have hnullmono : ∀ S : Set M, S ⊆ κ.symm '' Z → sepChartNull S := fun S hS q =>
    measure_mono_null (Set.image_mono (Set.inter_subset_inter_left _ hS)) (hNw q)
  have hwallsub : ∀ S : Set E3, S ⊆ B → K ∩ κ.symm '' S ⊆ κ.symm '' Z := by
    rintro S hSB x ⟨hxK, z, hz, rfl⟩
    refine ⟨z, ?_, rfl⟩
    rw [hZdef]
    exact ⟨hSB hz, (hwall z (hSB hz)).1 hxK⟩
  
  have hmono : ∀ E U U' : Set M, U ⊆ U' → hullRiemPer g E U K ≤ hullRiemPer g E U' K := by
    intro E U U' hUU'
    unfold hullRiemPer
    refine iSup_mono fun n => iSup_mono fun q => iSup_mono fun W => ?_
    exact iSup_le fun h => le_iSup_of_le
      ⟨fun j => ⟨(h.1 j).1, (h.1 j).2.trans (Set.inter_subset_inter_left _ hUU')⟩, h.2⟩ le_rfl
  
  have hloc : ∀ E₁ E₂ U : Set M, sepChartMeas E₁ → sepChartMeas E₂ →
      (∀ x ∈ U, (x ∈ E₁ ↔ x ∈ E₂)) → hullRiemPer g E₁ U K ≤ hullRiemPer g E₂ U K := by
    intro E₁ E₂ U hE₁ hE₂ hU
    unfold hullRiemPer
    refine iSup_mono fun n => iSup_mono fun q => iSup_mono fun W => iSup_mono fun h => ?_
    refine Finset.sum_le_sum fun j _ => ?_
    unfold hullPerG
    refine iSup_mono fun X => iSup_mono fun hX => ?_
    apply le_of_eq
    congr 1
    rw [← integral_indicator (hE₁ (q j)), ← integral_indicator (hE₂ (q j))]
    congr 1
    funext y
    by_cases hy : y ∈ tsupport X
    · obtain ⟨w, hw, rfl⟩ := hX.2.2.1 hy
      have hws := (h.1 j).2 hw
      have key : ∀ E : Set M, chartAt E3 (q j) w ∈
          chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) ↔ w ∈ E := by
        intro E
        constructor
        · rintro ⟨x, hx, hxw⟩
          have hxw' := (chartAt E3 (q j)).injOn hx.2 hws.2 hxw
          rw [← hxw']
          exact hx.1
        · intro hwE
          exact ⟨w, ⟨hwE, hws.2⟩, rfl⟩
      by_cases h1 : w ∈ E₁
      · have h2 : w ∈ E₂ := (hU w hws.1).1 h1
        rw [Set.indicator_of_mem ((key E₁).2 h1), Set.indicator_of_mem ((key E₂).2 h2)]
      · have h2 : w ∉ E₂ := fun h2 => h1 ((hU w hws.1).2 h2)
        rw [Set.indicator_of_notMem (fun h' => h1 ((key E₁).1 h')),
          Set.indicator_of_notMem (fun h' => h2 ((key E₂).1 h'))]
    · have h0 : sepDensDiv (g.coeff (chartAt E3 (q j)).symm) X y = 0 := by
        have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 hy
        unfold sepDensDiv
        refine Finset.sum_eq_zero fun i _ => ?_
        have hev' : (fun z => Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det * X z i)
            =ᶠ[𝓝 y] fun _ => (0 : ℝ) := hev.mono fun z hz => by simp [hz]
        unfold partialDeriv
        rw [hev'.fderiv_eq]
        simp
      simp only [Set.indicator, h0, ite_self]
  
  have hs9 : hullRiemPer g F₂ Ω K ≤
      hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ + hullRiemPer g F₁ (Ω ∩ Lᶜ) K := by
    have h1 : hullRiemPer g F₂ Ω K ≤
        hullRiemPer g F₂ (Ω ∩ V₁') K + hullRiemPer g F₂ (Ω ∩ Lᶜ) K :=
      hullRiemPer_union_le_of_null g F₂ Ω K V₁' Lᶜ hV₁'o hLo
        (fun x _ => by
          by_cases hx : x ∈ L
          · exact Or.inl (hLV₁' hx)
          · exact Or.inr hx)
        (hnullmono _ (by rw [hV₁'def]; exact hwallsub V₁ hV₁B))
    have h2 : hullRiemPer g F₂ (Ω ∩ V₁') K ≤ hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ := by
      refine (hmono _ _ _ Set.inter_subset_right).trans ?_
      have h : hullRiemPer g F₂ V₁' K ≤ hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) (κ '' V₁') :=
        hullRiemPer_chart_sector_le g K F₂ hF₂ p ε hBt k φ hφ hdφ hwall V₁' hV₁'s
          (by rw [hV₁'img]; exact hV₁B)
      rwa [hV₁'img] at h
    have h3 : hullRiemPer g F₂ (Ω ∩ Lᶜ) K ≤ hullRiemPer g F₁ (Ω ∩ Lᶜ) K := by
      refine hloc F₂ F₁ _ hF₂ hF₁ fun x hx => ⟨fun h2 => ?_, fun h1 => ?_⟩
      · by_contra h1
        exact hx.2 (hsd' (Set.mem_symmDiff.2 (Or.inr ⟨h2, h1⟩)))
      · by_contra h2
        exact hx.2 (hsd' (Set.mem_symmDiff.2 (Or.inl ⟨h1, h2⟩)))
    exact h1.trans (add_le_add h2 h3)
  
  have hs10 : hullRiemPer g F₁ (Ω ∩ Lᶜ) K ≤
      hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') + hullRiemPer g F₁ (Ω ∩ C₂ᶜ) K := by
    have h1 : hullRiemPer g F₁ (Ω ∩ Lᶜ) K ≤
        hullRiemPer g F₁ ((Ω ∩ Lᶜ) ∩ D) K + hullRiemPer g F₁ ((Ω ∩ Lᶜ) ∩ C₂ᶜ) K :=
      hullRiemPer_union_le_of_null g F₁ (Ω ∩ Lᶜ) K D C₂ᶜ hDo hC₂o
        (fun x hx => by
          by_cases hxC : x ∈ C₂
          · left
            rw [hC₂def] at hxC
            obtain ⟨z, hz, rfl⟩ := hxC
            rw [hDdef]
            refine ⟨z, ⟨hV₂V₁ hz, fun hzK => hx.2 ?_⟩, rfl⟩
            rw [hLdef]
            exact ⟨z, hzK, rfl⟩
          · exact Or.inr hxC)
        (hnullmono _ (by rw [hDdef]; exact hwallsub _ hDB))
    have h2 : hullRiemPer g F₁ ((Ω ∩ Lᶜ) ∩ D) K ≤
        hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') := by
      refine (hmono _ _ _ Set.inter_subset_right).trans ?_
      have h : hullRiemPer g F₁ D K ≤ hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (κ '' D) :=
        hullRiemPer_chart_sector_le g K F₁ hF₁ p ε hBt k φ hφ hdφ hwall D hDs
          (by rw [hDimg]; exact hDB)
      rwa [hDimg] at h
    have h3 : hullRiemPer g F₁ ((Ω ∩ Lᶜ) ∩ C₂ᶜ) K ≤ hullRiemPer g F₁ (Ω ∩ C₂ᶜ) K :=
      hmono _ _ _ fun x hx => ⟨hx.1.1, hx.2⟩
    exact h1.trans (add_le_add h2 h3)
  
  obtain ⟨Kc, hKcdef⟩ : ∃ S : Set E3, S = κ '' (K ∩ κ.source) := ⟨_, rfl⟩
  have hKcw : ∀ z ∈ B, (∃ i, φ i z = 0) → z ∈ Kc := by
    intro z hz hw
    rw [hKcdef]
    exact ⟨κ.symm z, ⟨(hwall z hz).2 hw, κ.map_target (hBt hz)⟩, κ.right_inv (hBt hz)⟩
  have hglue : hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) V₂ ≤
      hullPerG G (κ '' (F₁ ∩ κ.source)) V₂ Kc :=
    sector_glue_le_hullPerG G B Metric.isOpen_ball
      (fun i j => (g.smooth p i j).mono hBt) (fun y hy => coeff_chart_symm_posDef g p y (hBt hy))
      k φ hφ hdφ Kc hKcw (κ '' (F₁ ∩ κ.source)) V₂ (hF₁ p) hV₂ hV₂B
  have hone : hullPerG G (κ '' (F₁ ∩ κ.source)) V₂ Kc ≤ hullRiemPer g F₁ V₂' K := by
    rw [← hV₂'img, hKcdef]
    unfold hullRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le (fun _ => V₂')
      (le_iSup_of_le ⟨fun _ => ⟨hV₂'o, fun x hx => ⟨hx, (hV₂'Ω hx).2⟩⟩,
        fun a b hab => (hab (Subsingleton.elim a b)).elim⟩ ?_)))
    rw [Fin.sum_univ_one]
  have hdisj : Disjoint (Ω ∩ C₂ᶜ) V₂' :=
    Set.disjoint_left.2 fun x hx hx2 => hx.2 (hV₂'C₂ hx2)
  have hsum := hullRiemPer_disjoint_sum_le g F₁ Ω K ![Ω ∩ C₂ᶜ, V₂']
    (by
      intro i
      fin_cases i
      · exact Set.inter_subset_left
      · exact fun x hx => (hV₂'Ω hx).1)
    (by
      intro i j hij
      fin_cases i <;> fin_cases j
      · exact absurd rfl hij
      · exact hdisj
      · exact hdisj.symm
      · exact absurd rfl hij)
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at hsum
  have hs11 : hullRiemPer g F₁ (Ω ∩ C₂ᶜ) K + hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) V₂ ≤
      hullRiemPer g F₁ Ω K :=
    (add_le_add le_rfl (hglue.trans hone)).trans hsum
  
  calc hullRiemPer g F₂ Ω K + hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) V₂
      ≤ (hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ +
          (hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') +
            hullRiemPer g F₁ (Ω ∩ C₂ᶜ) K)) +
          hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) V₂ :=
        add_le_add (hs9.trans (add_le_add le_rfl hs10)) le_rfl
    _ = hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ +
          hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') +
          (hullRiemPer g F₁ (Ω ∩ C₂ᶜ) K + hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) V₂) := by
        ring
    _ ≤ hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ +
          hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') + hullRiemPer g F₁ Ω K :=
        add_le_add le_rfl hs11
    _ = hullRiemPer g F₁ Ω K + hspSectorPer G B φ (κ '' (F₂ ∩ κ.source)) V₁ +
          hspSectorPer G B φ (κ '' (F₁ ∩ κ.source)) (V₁ \ K') := by
        ring

theorem hull_sector_perMin [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (K Ω Kv A₀ F : Set M) (hK : IsClosed K) (hΩ : IsOpen Ω) (hKv : IsCompact Kv)
    (hKvΩ : Kv ⊆ Ω) (hF : sepChartMeas F) (hFA : symmDiff F A₀ ⊆ Kv)
    (hfin : hullRiemPer g F Ω K < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ Kv →
      hullRiemPer g F Ω K ≤ hullRiemPer g F' Ω K)
    (p : M) (ε : ℝ) (hε : 0 < ε)
    (hB : Metric.ball (chartAt E3 p p) ε ⊆
      chartAt E3 p '' (interior Kv ∩ (chartAt E3 p).source))
    (k : ℕ) (φ : Fin k → E3 → ℝ)
    (hφ : ∀ i, ContDiffOn ℝ ∞ (φ i) (Metric.ball (chartAt E3 p p) ε))
    (hdφ : ∀ i, ∀ z ∈ Metric.ball (chartAt E3 p p) ε, fderiv ℝ (φ i) z ≠ 0)
    (hwall : ∀ z ∈ Metric.ball (chartAt E3 p p) ε,
      ((chartAt E3 p).symm z ∈ K ↔ ∃ i, φ i z = 0))
    (hcal : ∀ i, ∀ z ∈ Metric.ball (chartAt E3 p p) ε, φ i z ≤ 0 →
      sepDensDiv (g.coeff (chartAt E3 p).symm)
        (hcrNormalField (g.coeff (chartAt E3 p).symm) (φ i)) z ≤ 0) :
    sepIsPerMin (g.coeff (chartAt E3 p).symm)
      (chartAt E3 p '' (F ∩ (chartAt E3 p).source) ∩
        {z | z ∈ Metric.ball (chartAt E3 p p) ε ∧ ∀ i, 0 < φ i z})
      (Metric.ball (chartAt E3 p p) ε) :=
by
  classical
  set κ := chartAt E3 p with hκ
  set G := g.coeff κ.symm with hGdef
  set B := Metric.ball (κ p) ε with hBdef
  set Fκ := κ '' (F ∩ κ.source) with hFκdef
  set D : Set E3 := {z | z ∈ B ∧ ∀ i, 0 < φ i z} with hDdef
  set Kc := κ '' (K ∩ κ.source) with hKcdef
  
  have hBo : IsOpen B := Metric.isOpen_ball
  have hBt : B ⊆ κ.target := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hB hz
    exact κ.map_source hx.2
  have hBKv : ∀ z ∈ B, κ.symm z ∈ interior Kv := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hB hz
    rw [κ.left_inv hx.2]
    exact hx.1
  have hBΩ : B ⊆ κ '' (Ω ∩ κ.source) := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hB hz
    exact ⟨x, ⟨hKvΩ (interior_subset hx.1), hx.2⟩, rfl⟩
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) κ.target :=
    fun i j => g.smooth p i j
  have hpd : ∀ y ∈ κ.target, (G y).PosDef := fun y hy => coeff_chart_symm_posDef g p y hy
  have hdet : ∀ y ∈ κ.target, 0 < (G y).det := fun y hy => (hpd y hy).det_pos
  have hGsB : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) B :=
    fun i j => (hGs i j).mono hBt
  have hpdB : ∀ y ∈ B, (G y).PosDef := fun y hy => hpd y (hBt hy)
  
  have hSo : ∀ s : Fin k → Bool, IsOpen (hspSector B φ s) := by
    intro s
    have e : hspSector B φ s =
        B ∩ ⋂ i, (B ∩ (fun z => (if s i then (1 : ℝ) else -1) * φ i z) ⁻¹' Set.Ioi 0) := by
      ext z
      simp only [hspSector, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter,
        Set.mem_preimage, Set.mem_Ioi]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => ⟨h1, h2 i⟩⟩
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => (h2 i).2⟩
    rw [e]
    refine hBo.inter (isOpen_iInter_of_finite fun i => ?_)
    exact (continuousOn_const.mul (hφ i).continuousOn).isOpen_inter_preimage hBo isOpen_Ioi
  have hDeq : hspSector B φ (fun _ : Fin k => true) = D := by
    ext z
    simp [hspSector, hDdef]
  have hDo : IsOpen D := hDeq ▸ hSo _
  have hSD : ∀ s : Fin k → Bool, s ≠ (fun _ : Fin k => true) → hspSector B φ s ∩ D = ∅ := by
    intro s hs
    obtain ⟨i, hi⟩ : ∃ i, s i ≠ true := by
      by_contra h
      push_neg at h
      exact hs (funext h)
    have hfi : s i = false := by simpa using hi
    ext z
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
    intro hz hzD
    have h1 := hz.2 i
    rw [hfi] at h1
    simp only [Bool.false_eq_true, ↓reduceIte] at h1
    have h2 := hzD.2 i
    linarith
  
  have hKcw : ∀ z ∈ B, (∃ i, φ i z = 0) → z ∈ Kc := by
    intro z hz hw
    have hK := (hwall z hz).2 hw
    exact ⟨κ.symm z, ⟨hK, κ.map_target (hBt hz)⟩, κ.right_inv (hBt hz)⟩
  
  have hone : ∀ V : Set E3, IsOpen V → V ⊆ B → hullPerG G Fκ V Kc ≤ hullRiemPer g F Ω K := by
    intro V hV hVB
    have hVt : V ⊆ κ.target := hVB.trans hBt
    have hWo : IsOpen (κ.symm '' V) := κ.isOpen_image_symm_of_subset_target hV hVt
    have hWsub : κ.symm '' V ⊆ Ω ∩ κ.source := by
      rintro _ ⟨z, hz, rfl⟩
      exact ⟨hKvΩ (interior_subset (hBKv z (hVB hz))), κ.map_target (hVt hz)⟩
    have himg : κ '' (κ.symm '' V) = V := κ.toPartialEquiv.image_symm_image_of_subset_target hVt
    rw [← himg]
    unfold hullRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le (fun _ => κ.symm '' V)
      (le_iSup_of_le ⟨fun _ => ⟨hWo, hWsub⟩, fun a b hab => (hab (Subsingleton.elim a b)).elim⟩
        ?_)))
    rw [Fin.sum_univ_one]
  
  have hfinS : ∀ V : Set E3, IsOpen V → V ⊆ B → hspSectorPer G B φ Fκ V < ⊤ := by
    intro V hV hVB
    have h1 := sector_glue_le_hullPerG G B hBo hGsB hpdB k φ hφ hdφ Kc hKcw Fκ V (hF p) hV hVB
    exact lt_of_le_of_lt (h1.trans (hone V hV hVB)) hfin
  have hΦle : ∀ V : Set E3, sepPerG G (Fκ ∩ D) V ≤ hspSectorPer G B φ Fκ V := by
    intro V
    unfold hspSectorPer
    rw [← hDeq]
    exact Finset.single_le_sum (f := fun s => sepPerG G (Fκ ∩ hspSector B φ s) V)
      (fun _ _ => zero_le _) (Finset.mem_univ _)
  
  unfold sepIsPerMin
  refine ⟨(hF p).inter hDo.measurableSet,
    fun V hV _ hVB => lt_of_le_of_lt (hΦle V) (hfinS V hV (subset_closure.trans hVB)), ?_⟩
  
  intro F' V K' hF' hV _ hVB hK'c hK'V hsd
  have hVB' : V ⊆ B := subset_closure.trans hVB
  have hVt : V ⊆ κ.target := hVB'.trans hBt
  have hK't : K' ⊆ κ.target := hK'V.trans hVt
  have hF'sub : F' \ (Fκ ∩ D) ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inr hz))
  have hΦsub : (Fκ ∩ D) \ F' ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inl hz))
  
  have hproj : sepPerG G (F' ∩ D) V ≤ sepPerG G F' V := by
    refine iSup₂_le fun Y hY => ?_
    obtain ⟨hYs, hYc, hYV, hYn⟩ := hY
    have hdt := sep_div_test_bound G κ.target V κ.open_target hVt hGs hpd Y hYs hYc hYV hYn
      (fun _ => 0) contDiffOn_const
    have hdc : HasCompactSupport (sepDensDiv G Y) :=
      hYc.mono' ((subset_tsupport _).trans hdt.2.1)
    obtain ⟨C, hC⟩ := hdc.exists_bound_of_continuous hdt.1
    exact sector_field_removal G B hBo hGsB hpdB k φ hφ hdφ V K' F' hV hVB' hK'c hK'V hF'
      (fun z hzF _ ⟨i, hi⟩ => hF'sub ⟨hzF, fun hzΦ => absurd (hzΦ.2.2 i) (not_lt.2 hi)⟩)
      (fun i z hz hle => hcal i z (hVB' (hK'V hz)) hle)
      Y (fun z _ _ => hYs.contDiffAt) hYc hYV hYn
      ⟨C, fun z _ _ => by have := hC z; rwa [Real.norm_eq_abs] at this⟩
  
  set F'' : Set E3 := F' ∩ D with hF''def
  set Ψ : Set E3 := F'' ∪ (Fκ \ D) with hΨdef
  have hΨm : MeasurableSet Ψ :=
    (hF'.inter hDo.measurableSet).union ((hF p).diff hDo.measurableSet)
  have hsdΨ : symmDiff Fκ Ψ ⊆ K' := by
    intro z hz
    rcases Set.mem_symmDiff.1 hz with ⟨hzF, hzΨ⟩ | ⟨hzΨ, hzF⟩
    · have hzD : z ∈ D := by
        by_contra h
        exact hzΨ (Or.inr ⟨hzF, h⟩)
      exact hΦsub ⟨⟨hzF, hzD⟩, fun hzF' => hzΨ (Or.inl ⟨hzF', hzD⟩)⟩
    · rcases hzΨ with ⟨hzF', _⟩ | ⟨hzF2, _⟩
      · exact hF'sub ⟨hzF', fun h => hzF h.1⟩
      · exact absurd hzF2 hzF
  have hΨtop : Ψ ∩ hspSector B φ (fun _ : Fin k => true) = F'' := by
    rw [hDeq]
    ext z
    simp only [hΨdef, hF''def, Set.mem_inter_iff, Set.mem_union, Set.mem_diff]
    tauto
  have hΨs : ∀ s : Fin k → Bool, s ≠ (fun _ : Fin k => true) →
      Ψ ∩ hspSector B φ s = Fκ ∩ hspSector B φ s := by
    intro s hs
    have h0 := hSD s hs
    ext z
    constructor
    · rintro ⟨hzΨ | hzΨ, hzs⟩
      · have : z ∈ hspSector B φ s ∩ D := ⟨hzs, hzΨ.2⟩
        rw [h0] at this
        simp at this
      · exact ⟨hzΨ.1, hzs⟩
    · rintro ⟨hzF, hzs⟩
      refine ⟨Or.inr ⟨hzF, fun hzD => ?_⟩, hzs⟩
      have : z ∈ hspSector B φ s ∩ D := ⟨hzs, hzD⟩
      rw [h0] at this
      simp at this
  
  set L := κ.symm '' K' with hLdef
  set Ft := (F \ L) ∪ κ.symm '' (Ψ ∩ K') with hFtdef
  have hLKv : L ⊆ Kv := by
    rintro _ ⟨z, hz, rfl⟩
    exact interior_subset (hBKv z (hVB' (hK'V hz)))
  have hP1 : symmDiff F Ft ⊆ L := by
    intro x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hxF, hxFt⟩ | ⟨hxFt, hxF⟩
    · by_contra hxL
      exact hxFt (Or.inl ⟨hxF, hxL⟩)
    · rcases hxFt with ⟨hxF', _⟩ | ⟨z, hz, rfl⟩
      · exact absurd hxF' hxF
      · exact ⟨z, hz.2, rfl⟩
  have hP2 : symmDiff Ft A₀ ⊆ Kv := by
    intro x hx
    by_cases hxF : x ∈ F
    · by_cases hxFt : x ∈ Ft
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨_, hA⟩ | ⟨_, hn⟩
        · exact Set.mem_symmDiff.2 (Or.inl ⟨hxF, hA⟩)
        · exact absurd hxFt hn
      · exact hLKv (hP1 (Set.mem_symmDiff.2 (Or.inl ⟨hxF, hxFt⟩)))
    · by_cases hxFt : x ∈ Ft
      · exact hLKv (hP1 (Set.mem_symmDiff.2 (Or.inr ⟨hxFt, hxF⟩)))
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨h, _⟩ | ⟨hA, _⟩
        · exact absurd h hxFt
        · exact Set.mem_symmDiff.2 (Or.inr ⟨hA, hxF⟩)
  have hΨsub1 : Ψ \ Fκ ⊆ K' := fun z hz => hsdΨ (Set.mem_symmDiff.2 (Or.inr hz))
  have hΨsub2 : Fκ \ Ψ ⊆ K' := fun z hz => hsdΨ (Set.mem_symmDiff.2 (Or.inl hz))
  have hP3 : κ '' (Ft ∩ κ.source) = Ψ := by
    ext z
    constructor
    · rintro ⟨x, ⟨hxFt, hxs⟩, rfl⟩
      rcases hxFt with ⟨hxF, hxL⟩ | ⟨w, hw, rfl⟩
      · by_contra hz
        have hK : κ x ∈ K' := hΨsub2 ⟨⟨x, ⟨hxF, hxs⟩, rfl⟩, hz⟩
        exact hxL ⟨κ x, hK, κ.left_inv hxs⟩
      · rw [κ.right_inv (hK't hw.2)]
        exact hw.1
    · intro hz
      by_cases hzK : z ∈ K'
      · exact ⟨κ.symm z, ⟨Or.inr ⟨z, ⟨hz, hzK⟩, rfl⟩, κ.map_target (hK't hzK)⟩,
          κ.right_inv (hK't hzK)⟩
      · have hzΦ : z ∈ Fκ := by
          by_contra h
          exact hzK (hΨsub1 ⟨hz, h⟩)
        obtain ⟨x, ⟨hxF, hxs⟩, rfl⟩ := hzΦ
        refine ⟨x, ⟨Or.inl ⟨hxF, ?_⟩, hxs⟩, rfl⟩
        rintro ⟨w, hw, hwx⟩
        apply hzK
        rw [← hwx, κ.right_inv (hK't hw)]
        exact hw
  
  have hP4 : sepChartMeas Ft := by
    intro q
    set κq := chartAt E3 q with hκq
    have hI : ∀ S : Set M, κq '' (S ∩ κq.source) = κq.target ∩ κq.symm ⁻¹' S := by
      intro S
      rw [Set.inter_comm S]
      exact κq.image_source_inter_eq' S
    have hLc : IsCompact L := hK'c.image_of_continuousOn (κ.continuousOn_symm.mono hK't)
    have hIL : MeasurableSet (κq.target ∩ κq.symm ⁻¹' L) := by
      have ho : IsOpen (κq.target ∩ κq.symm ⁻¹' Lᶜ) :=
        κq.continuousOn_symm.isOpen_inter_preimage κq.open_target hLc.isClosed.isOpen_compl
      have heq : κq.target ∩ κq.symm ⁻¹' L = κq.target \ (κq.target ∩ κq.symm ⁻¹' Lᶜ) := by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff, Set.mem_compl_iff]
        tauto
      rw [heq]
      exact κq.open_target.measurableSet.diff ho.measurableSet
    have hIF : MeasurableSet (κq.target ∩ κq.symm ⁻¹' F) := by
      rw [← hI]
      exact hF q
    have hBt' : Ψ ∩ K' ⊆ κ.target := fun z hz => hK't hz.2
    have hBm : MeasurableSet (Ψ ∩ K') := hΨm.inter hK'c.isClosed.measurableSet
    have hsymmB : κ.symm '' (Ψ ∩ K') = κ.source ∩ κ ⁻¹' (Ψ ∩ K') :=
      κ.symm_image_eq_source_inter_preimage hBt'
    have hDo' : IsOpen (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κq.continuousOn_symm.isOpen_inter_preimage κq.open_target κ.open_source
    have hτc : ContinuousOn (fun z => κ (κq.symm z)) (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κ.continuousOn.comp (κq.continuousOn_symm.mono Set.inter_subset_left) (fun z hz => hz.2)
    have hIB : MeasurableSet ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩
        (fun z => κ (κq.symm z)) ⁻¹' (Ψ ∩ K')) := by
      have hpw : Measurable ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
          (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) :=
        hτc.measurable_piecewise continuousOn_const hDo'.measurableSet
      have heq : (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (Ψ ∩ K') =
          (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
            (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) ⁻¹' (Ψ ∩ K') := by
        ext z
        constructor
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD]
          exact hzB
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD] at hzB
          exact hzB
      rw [heq]
      exact hDo'.measurableSet.inter (hpw hBm)
    have hmain : κq.target ∩ κq.symm ⁻¹' Ft =
        ((κq.target ∩ κq.symm ⁻¹' F) \ (κq.target ∩ κq.symm ⁻¹' L)) ∪
          ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (Ψ ∩ K')) := by
      rw [hFtdef, hsymmB]
      ext z
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    show MeasurableSet (κq '' (Ft ∩ κq.source))
    rw [hI, hmain]
    exact (hIF.diff hIL).union hIB
  have hP5 : hullRiemPer g F Ω K ≤ hullRiemPer g Ft Ω K := hmin Ft hP4 hP2
  have hne : hullRiemPer g F Ω K ≠ ⊤ := hfin.ne
  
  have hcmp : ∀ V₁ V₂ : Set E3, IsOpen V₁ → IsOpen V₂ → K' ⊆ V₂ → IsCompact (closure V₂) →
      closure V₂ ⊆ V₁ → V₁ ⊆ V →
      hspSectorPer G B φ Fκ V₂ ≤ hspSectorPer G B φ Ψ V₁ + hspSectorPer G B φ Fκ (V₁ \ K') := by
    intro V₁ V₂ hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ hV₁V
    have h3 : hullRiemPer g Ft Ω K + hspSectorPer G B φ Fκ V₂ ≤
        hullRiemPer g F Ω K + hspSectorPer G B φ (κ '' (Ft ∩ κ.source)) V₁ +
          hspSectorPer G B φ Fκ (V₁ \ K') :=
      hullRiemPer_sector_add_le g F Ft Ω K p ε hBΩ k φ hφ hdφ hwall K' V₁ V₂ hF hP4
        hK'c hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ (hV₁V.trans hVB') hP1
    rw [hP3] at h3
    have h4 : hullRiemPer g F Ω K + hspSectorPer G B φ Fκ V₂ ≤
        hullRiemPer g F Ω K + (hspSectorPer G B φ Ψ V₁ + hspSectorPer G B φ Fκ (V₁ \ K')) := by
      calc hullRiemPer g F Ω K + hspSectorPer G B φ Fκ V₂
          ≤ hullRiemPer g Ft Ω K + hspSectorPer G B φ Fκ V₂ := add_le_add hP5 le_rfl
        _ ≤ _ := h3
        _ = _ := add_assoc _ _ _
    exact (ENNReal.add_le_add_iff_left hne).1 h4
  
  have hSig : hspSectorPer G B φ Fκ V ≤ hspSectorPer G B φ Ψ V :=
    sectorPer_local_compare G κ.target B k φ Fκ Ψ V K' κ.open_target hGs hdet
      (fun s => (hSo s).measurableSet) (hF p) hΨm hV hVt hK'c hK'V hsdΨ (hfinS V hV hVB') hcmp
  
  have hsplit : ∀ E : Set E3, hspSectorPer G B φ E V =
      sepPerG G (E ∩ hspSector B φ (fun _ : Fin k => true)) V +
        ∑ s ∈ Finset.univ.erase (fun _ : Fin k => true), sepPerG G (E ∩ hspSector B φ s) V := by
    intro E
    unfold hspSectorPer
    exact (Finset.add_sum_erase _ _ (Finset.mem_univ _)).symm
  have hR : ∑ s ∈ Finset.univ.erase (fun _ : Fin k => true), sepPerG G (Ψ ∩ hspSector B φ s) V =
      ∑ s ∈ Finset.univ.erase (fun _ : Fin k => true), sepPerG G (Fκ ∩ hspSector B φ s) V := by
    refine Finset.sum_congr rfl fun s hs => ?_
    rw [hΨs s (Finset.ne_of_mem_erase hs)]
  rw [hsplit Fκ, hsplit Ψ, hR, hΨtop, hDeq] at hSig
  have hRfin : ∑ s ∈ Finset.univ.erase (fun _ : Fin k => true),
      sepPerG G (Fκ ∩ hspSector B φ s) V ≠ ⊤ := by
    refine ne_top_of_le_ne_top (hfinS V hV hVB').ne ?_
    rw [hsplit Fκ]
    exact le_add_self
  have hmain : sepPerG G (Fκ ∩ D) V ≤ sepPerG G F'' V :=
    (ENNReal.add_le_add_iff_right hRfin).1 hSig
  exact hmain.trans hproj

theorem minimal_graph_difference_elliptic [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (p : M) (a : Fin 3) (ρ : ℝ) (hρ : 0 < ρ)
    (hball : Metric.closedBall (chartAt E3 p p) (10 * ρ) ⊆ (chartAt E3 p).target)
    (U V : E3 → ℝ) (hU : ContDiff ℝ ∞ U) (hV : ContDiff ℝ ∞ V)
    (hslabU : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      |U (coordPlaneProj a y) - (chartAt E3 p p) a| ≤ 8 * ρ)
    (hslabV : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      |V (coordPlaneProj a y) - (chartAt E3 p p) a| ≤ 8 * ρ)
    (hMU : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun z => z a - U (coordPlaneProj a z))
        (coordPlaneProj a y + U (coordPlaneProj a y) • e a) = 0)
    (hMV : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun z => z a - V (coordPlaneProj a z))
        (coordPlaneProj a y + V (coordPlaneProj a y) • e a) = 0)
    (hle : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      U (coordPlaneProj a y) ≤ V (coordPlaneProj a y)) :
    ∀ y₁ : E3, ‖coordPlaneProj a (y₁ - chartAt E3 p p)‖ < 2 * ρ →
      V (coordPlaneProj a y₁) - U (coordPlaneProj a y₁) = 0 →
      ∃ (A : E3 → Matrix (Fin 3) (Fin 3) ℝ) (r lam Lam K : ℝ), 0 < r ∧ 0 < lam ∧
        ∀ y ∈ Metric.ball y₁ r, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ ∧
          (∀ v : Fin 3 → ℝ, lam * ∑ i, v i ^ 2 ≤ ∑ i, ∑ j, A y i j * v i * v j) ∧
          (∀ i j, |A y i j| ≤ Lam) ∧
          ∑ i, ∑ j, A y i j * partialDeriv i (partialDeriv j
              (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y'))) y ≤
            K * ((V (coordPlaneProj a y) - U (coordPlaneProj a y)) +
              ∑ i, |partialDeriv i
                (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y')) y|) :=
by
  intro y₁ hy₁ h0
  
  
  
  have coeff_chart_symm_posDef : ∀ y : E3, y ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro y hy
    classical
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : dotProduct (star x) ((g.coeff (chartAt E3 p).symm y).mulVec x) =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  
  have coordPlaneProj_graph_partials : ∀ (a : Fin 3) (φ : E3 → ℝ), ContDiff ℝ ∞ φ →
      ContDiff ℝ ∞ (fun z => φ (coordPlaneProj a z)) ∧
      (∀ (y : E3) (t : ℝ) (k : Fin 3),
        partialDeriv k (fun z => z a - φ (coordPlaneProj a z)) (coordPlaneProj a y + t • e a) =
          (if k = a then 1 else 0) - partialDeriv k (fun z => φ (coordPlaneProj a z)) y) ∧
      (∀ (y : E3) (t : ℝ) (i j : Fin 3),
        partialDeriv i (partialDeriv j (fun z => z a - φ (coordPlaneProj a z)))
            (coordPlaneProj a y + t • e a) =
          -partialDeriv i (partialDeriv j (fun z => φ (coordPlaneProj a z))) y) ∧
      (∀ y : E3, partialDeriv a (fun z => φ (coordPlaneProj a z)) y = 0) ∧
      (∀ k : Fin 3, ContDiff ℝ 1 (partialDeriv k (fun z => φ (coordPlaneProj a z)))) ∧
      (∀ i j : Fin 3,
        Continuous (partialDeriv i (partialDeriv j (fun z => φ (coordPlaneProj a z))))) := by
    intro a φ hφ
    have hpadd : ∀ (x y : E3),
        coordPlaneProj a (x + y) = coordPlaneProj a x + coordPlaneProj a y := by
      intro x y
      simp only [coordPlaneProj, PiLp.add_apply, add_smul]
      abel
    have hpsmul : ∀ (r : ℝ) (x : E3), coordPlaneProj a (r • x) = r • coordPlaneProj a x := by
      intro r x
      simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, smul_sub, mul_smul]
    have hplin : IsLinearMap ℝ (coordPlaneProj a) := ⟨hpadd, hpsmul⟩
    let πL : E3 →L[ℝ] E3 := LinearMap.toContinuousLinearMap (IsLinearMap.mk' _ hplin)
    have hπcd : ContDiff ℝ ∞ (coordPlaneProj a) := πL.contDiff
    have hπc : Continuous (coordPlaneProj a) := hπcd.continuous
    have hea : coordPlaneProj a (e a) = 0 := by
      simp [coordPlaneProj]
    have hya : ∀ y : E3, (coordPlaneProj a y) a = 0 := by
      intro y
      simp [coordPlaneProj]
    have hidem : ∀ y : E3, coordPlaneProj a (coordPlaneProj a y) = coordPlaneProj a y := by
      intro y
      show coordPlaneProj a y - (coordPlaneProj a y) a • e a = coordPlaneProj a y
      rw [hya, zero_smul, sub_zero]
    have hshift : ∀ (y : E3) (t : ℝ),
        coordPlaneProj a (coordPlaneProj a y + t • e a) = coordPlaneProj a y := by
      intro y t
      rw [hpadd, hpsmul, hea, smul_zero, add_zero, hidem]
    have hφ1 : ContDiff ℝ 1 φ := hφ.of_le (by norm_cast)
    have hφ2 : ContDiff ℝ 2 φ := hφ.of_le (by norm_cast)
    have hφd : Differentiable ℝ φ := hφ1.differentiable one_ne_zero
    have hφπ : ContDiff ℝ ∞ (fun z => φ (coordPlaneProj a z)) := hφ.comp πL.contDiff
    have hφπd : Differentiable ℝ (fun z => φ (coordPlaneProj a z)) :=
      hφd.comp πL.differentiable
    have core : ∀ (F : E3 → ℝ), Differentiable ℝ F → ∀ (k : Fin 3) (z : E3),
        partialDeriv k (fun z => F (coordPlaneProj a z)) z =
          fderiv ℝ F (coordPlaneProj a z) (coordPlaneProj a (e k)) := by
      intro F hF k z
      have h : HasFDerivAt (fun z => F (coordPlaneProj a z))
          ((fderiv ℝ F (coordPlaneProj a z)).comp πL) z :=
        (hF (πL z)).hasFDerivAt.comp z πL.hasFDerivAt
      unfold partialDeriv
      rw [h.fderiv]
      rfl
    have hlin1 : ∀ (z : E3) (k : Fin 3),
        partialDeriv k (fun z => z a - φ (coordPlaneProj a z)) z =
          (if k = a then 1 else 0) - partialDeriv k (fun z => φ (coordPlaneProj a z)) z := by
      intro z k
      have hs : HasFDerivAt (fun z : E3 => z a - φ (coordPlaneProj a z))
          (EuclideanSpace.proj (𝕜 := ℝ) a - fderiv ℝ (fun z => φ (coordPlaneProj a z)) z) z :=
        (EuclideanSpace.proj (𝕜 := ℝ) a).hasFDerivAt.sub (hφπd z).hasFDerivAt
      unfold partialDeriv
      rw [hs.fderiv, ContinuousLinearMap.sub_apply]
      congr 1
      by_cases h : k = a
      · subst h; simp
      · simp [h, Ne.symm h]
    have hψ : ∀ j : Fin 3, ContDiff ℝ 1 (fun x => fderiv ℝ φ x (coordPlaneProj a (e j))) :=
      fun j => (hφ2.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const
    have hpj : ∀ j : Fin 3, partialDeriv j (fun z => φ (coordPlaneProj a z)) =
        fun z => fderiv ℝ φ (coordPlaneProj a z) (coordPlaneProj a (e j)) :=
      fun j => funext fun z => core φ hφd j z
    have hpjh : ∀ j : Fin 3, partialDeriv j (fun z => z a - φ (coordPlaneProj a z)) =
        fun z => (if j = a then (1 : ℝ) else 0) -
          fderiv ℝ φ (coordPlaneProj a z) (coordPlaneProj a (e j)) := by
      intro j; funext z; rw [hlin1, hpj]
    have hpij : ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j (fun z => φ (coordPlaneProj a z))) =
        fun z => fderiv ℝ (fun x => fderiv ℝ φ x (coordPlaneProj a (e j))) (coordPlaneProj a z)
          (coordPlaneProj a (e i)) := by
      intro i j
      rw [hpj j]
      funext z
      exact core _ ((hψ j).differentiable one_ne_zero) i z
    refine ⟨hφπ, ?_, ?_, ?_, ?_, ?_⟩
    · intro y t k
      rw [hlin1, core φ hφd, core φ hφd, hshift]
    · intro y t i j
      rw [hpjh, hpij]
      have h1 : partialDeriv i (fun z => (if j = a then (1 : ℝ) else 0) -
            fderiv ℝ φ (coordPlaneProj a z) (coordPlaneProj a (e j)))
            (coordPlaneProj a y + t • e a) =
          -partialDeriv i (fun z => fderiv ℝ φ (coordPlaneProj a z) (coordPlaneProj a (e j)))
            (coordPlaneProj a y + t • e a) := by
        simp only [partialDeriv]
        rw [fderiv_const_sub, ContinuousLinearMap.neg_apply]
      rw [h1, core _ ((hψ j).differentiable one_ne_zero) i, hshift]
    · intro y
      rw [core φ hφd, hea, map_zero]
    · intro k
      rw [hpj k]
      exact (hψ k).comp πL.contDiff
    · intro i j
      rw [hpij i j]
      exact (((hψ j).continuous_fderiv one_ne_zero).comp hπc).clm_apply continuous_const
  
  
  have mcP_mcR_contDiffAt : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3), IsOpen T →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) → ∀ (z₁ : E3), z₁ ∈ T →
      (G z₁).det ≠ 0 → ∀ (ξ₁ : Fin 3 → ℝ), 0 < mcS G z₁ ξ₁ →
      (∀ i j : Fin 3, ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => mcP G q.1 q.2 i j) (z₁, ξ₁)) ∧
      ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => mcR G q.1 q.2) (z₁, ξ₁) := by
    intro G T hT hG z₁ hz₁ hdet ξ₁ hS
    have hdetgen : ∀ M : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ k l, ContDiffAt ℝ 1 (fun z => M z k l) z₁) →
          ContDiffAt ℝ 1 (fun z => (M z).det) z₁ := by
      intro M hM
      simp only [Matrix.det_fin_three]
      exact (((((((hM 0 0).mul (hM 1 1)).mul (hM 2 2)).sub
        (((hM 0 0).mul (hM 1 2)).mul (hM 2 1))).sub
        (((hM 0 1).mul (hM 1 0)).mul (hM 2 2))).add (((hM 0 1).mul (hM 1 2)).mul (hM 2 0))).add
        (((hM 0 2).mul (hM 1 0)).mul (hM 2 1))).sub (((hM 0 2).mul (hM 1 1)).mul (hM 2 0))
    have hG2 : ∀ i j, ContDiffAt ℝ 2 (fun z => G z i j) z₁ :=
      fun i j => ((hG i j).contDiffAt (hT.mem_nhds hz₁)).of_le (by norm_cast)
    have hG1 : ∀ i j, ContDiffAt ℝ 1 (fun z => G z i j) z₁ :=
      fun i j => (hG2 i j).of_le (by norm_num)
    have hdG : ∀ l i j, ContDiffAt ℝ 1 (fun z => partialDeriv l (fun z => G z i j) z) z₁ :=
      fun l i j => ((hG2 i j).fderiv_right (m := 1) (by norm_num)).clm_apply contDiffAt_const
    have hdet1 : ContDiffAt ℝ 1 (fun z => (G z).det) z₁ := hdetgen G hG1
    have hadj : ∀ i j, ContDiffAt ℝ 1 (fun z => (G z).adjugate i j) z₁ := by
      intro i j
      simp only [Matrix.adjugate_apply]
      apply hdetgen (fun z => (G z).updateRow j (Pi.single i 1))
      intro k l
      simp only [Matrix.updateRow_apply]
      by_cases hk : k = j
      · simp only [if_pos hk]; exact contDiffAt_const
      · simp only [if_neg hk]; exact hG1 k l
    have hinv : ∀ i j, ContDiffAt ℝ 1 (fun z => (G z)⁻¹ i j) z₁ := by
      intro i j
      have heq : (fun z => (G z)⁻¹ i j) = fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
        funext z
        rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      rw [heq]
      exact (hdet1.inv hdet).mul (hadj i j)
    have hchr : ∀ k i j, ContDiffAt ℝ 1 (fun z => christoffel G k i j z) z₁ := by
      intro k i j
      unfold christoffel
      exact contDiffAt_const.mul (ContDiffAt.sum fun l _ =>
        (hinv k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
    have lift : ∀ φ : E3 → ℝ, ContDiffAt ℝ 1 φ z₁ →
        ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => φ q.1) (z₁, ξ₁) :=
      fun φ hφ => hφ.comp (z₁, ξ₁) contDiffAt_fst
    have hcoord : ∀ k : Fin 3, ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => q.2 k) (z₁, ξ₁) :=
      fun k => ((contDiff_apply ℝ ℝ k).comp contDiff_snd).contDiffAt
    have hinvq : ∀ i j,
        ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => (G q.1)⁻¹ i j) (z₁, ξ₁) :=
      fun i j => lift _ (hinv i j)
    have hchrq : ∀ k i j,
        ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => christoffel G k i j q.1) (z₁, ξ₁) :=
      fun k i j => lift _ (hchr k i j)
    have hSq : ContDiffAt ℝ 1 (fun q : E3 × (Fin 3 → ℝ) => mcS G q.1 q.2) (z₁, ξ₁) := by
      unfold mcS
      exact ContDiffAt.sum fun i _ => ContDiffAt.sum fun j _ =>
        ((hinvq i j).mul (hcoord i)).mul (hcoord j)
    have hNq : ContDiffAt ℝ 1
        (fun q : E3 × (Fin 3 → ℝ) => Real.sqrt (mcS G q.1 q.2)) (z₁, ξ₁) :=
      hSq.sqrt hS.ne'
