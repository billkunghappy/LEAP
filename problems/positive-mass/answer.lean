            mul_le_mul_of_nonneg_left h2 (by positivity)
        _ = L₀ * (2 / R) ^ (1 + (α : ℝ)) * dist x z ^ (α : ℝ) := by ring
    have h4 : dist (smthGrad w x) (smthGrad w z) ≤ M' * dist x z ^ (α : ℝ) := by
      rw [dist_eq_norm]
      refine le_trans h3 (mul_le_mul_of_nonneg_right ?_ (by positivity))
      rw [hM']; exact le_max_left _ _
    rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg hαr0.le]
    have hc : ((Real.toNNReal M' : NNReal) : ENNReal) = ENNReal.ofReal M' := rfl
    rw [hc, ← ENNReal.ofReal_mul hM'0]
    exact ENNReal.ofReal_le_ofReal h4
  · intro p hp
    have hpd : R / 2 < R - dist p y := by have := Metric.mem_ball.1 hp; linarith
    have h1 := hIIm L₀ hII₀ p (hR2 hp) (1 / 2) (by norm_num) (by norm_num) (R / 2) (by positivity) hpd.le
    have h2 : (1 / 2 : ℝ) ^ (α : ℝ) ≤ 1 := Real.rpow_le_one (by norm_num) (by norm_num) hαr0.le
    have h2' := mul_le_mul_of_nonneg_left h2 (by linarith : (0 : ℝ) ≤ 2 * L₀)
    rw [hMcoe]
    have h3 : ‖smthGrad w p‖ ≤ 16 * K / R + 4 * L₀ / R := by
      rw [← add_div, le_div_iff₀ hR]
      have e2 : 4 * (K : ℝ) / (1 / 2) = 8 * K := by ring
      rw [e2] at h1
