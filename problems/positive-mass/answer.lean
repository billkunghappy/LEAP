      fun k i j => (hchr k i j).eq_of_nhds
    have hder : ∀ l k i j, partialDeriv l (christoffel G k i j) y
        = partialDeriv l (christoffel G' k i j) y := by
      intro l k i j
      simp only [partialDeriv, (hchr k i j).fderiv_eq]
    intro l i j k
    simp only [riemannLocal, hval, hder]
