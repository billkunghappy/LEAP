    exact ContDiffOn.sum fun k _ => hYfs k q
  · intro x
    by_cases h : ∃ k, Yf k x ≠ 0
    · obtain ⟨k, hk⟩ := h
      have hVx : V x = Yf k x := by
        rw [hV]
        refine Finset.sum_eq_single k (fun l _ hlk => ?_) (fun h => absurd (Finset.mem_univ k) h)
        by_contra hl
        exact Set.disjoint_left.1 (hWd hlk) (hCW l (hYfC l x hl)) (hCW k (hYfC k x hk))
