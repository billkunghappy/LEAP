  refine ⟨Real.exp 100 * ∫ ζ : E3, (1 + ‖ζ‖) ^ (-(7 : ℝ)), ?_, ?_⟩
  · exact mul_nonneg (Real.exp_pos 100).le
      (integral_nonneg (fun ζ => Real.rpow_nonneg (by positivity) _))
  intro i j k hk
  have hkf := funext hk
  subst hkf
  beta_reduce
  
  have hKc : Continuous (fun ζ : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
      Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) := by
    fun_prop
  have hGc : Continuous (fun ζ : E3 =>
      -(ζ j / 2) * ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4))) := by
    fun_prop
  have hKi : Integrable (fun ζ : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
      Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) :=
    hD.mono' hKc.aestronglyMeasurable (ae_of_all _ fun ζ => by
      rw [Real.norm_eq_abs]; exact (s2 i j ζ).1.trans (dom ζ))
  have hGi : Integrable (fun ζ : E3 =>
      -(ζ j / 2) * ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4))) :=
    hD.mono' hGc.aestronglyMeasurable (ae_of_all _ fun ζ => by
      rw [Real.norm_eq_abs]; exact (s2 i j ζ).2.2.trans (dom ζ))
  have hMc : Continuous (fun ζ : E3 => |(4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
      Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)| *
        ‖ζ‖ ^ (1 / 2 : ℝ)) :=
    (continuous_abs.comp hKc).mul (continuous_norm.rpow_const (fun _ => Or.inr (by norm_num)))
  have hMi : Integrable (fun ζ : E3 => |(4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
      Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)| *
        ‖ζ‖ ^ (1 / 2 : ℝ)) :=
    hD.mono' hMc.aestronglyMeasurable (ae_of_all _ fun ζ => by
      rw [Real.norm_of_nonneg (mul_nonneg (abs_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))]
      exact (s2 i j ζ).2.1.trans (dom ζ))
  
  have hGd : ContDiff ℝ ∞ (fun ζ' => partialDeriv j
      (fun ζ'' : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ''‖ ^ 2) / 4)) ζ') :=
    (hp.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
  have hibp := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
    (f := fun _ : E3 => (1 : ℝ))
    (g := fun ζ' => partialDeriv j
      (fun ζ'' : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ''‖ ^ 2) / 4)) ζ')
    (v := e i) ?_ ?_ ?_ (differentiable_const _) (hGd.differentiable (by simp))
  rotate_left
  · simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, zero_mul]
    exact integrable_zero _ _ _
  · refine hKi.congr (ae_of_all _ fun x => ?_)
    beta_reduce
    rw [one_mul]
    exact (hp2 i j x).symm
  · refine hGi.congr (ae_of_all _ fun x => ?_)
    beta_reduce
    rw [one_mul]
    exact (hp1 j x).symm
  have h0 : ∫ ζ : E3, (4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
      Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2) = 0 := by
    have e1 : (fun ζ : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) *
        Real.exp (-(‖ζ‖ ^ 2) / 4) * (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) =
        fun x => (fun _ : E3 => (1 : ℝ)) x * fderiv ℝ (fun ζ' => partialDeriv j
          (fun ζ'' : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ''‖ ^ 2) / 4)) ζ')
          x (e i) := by
      funext x
      rw [one_mul]
      exact (hp2 i j x).symm
    rw [e1, hibp]
    simp
  
  have hle := integral_mono_of_nonneg
    (ae_of_all _ fun ζ => mul_nonneg (abs_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))
    hD (ae_of_all _ fun ζ => (s2 i j ζ).2.1.trans (dom ζ))
  rw [integral_const_mul] at hle
  exact ⟨hKi, h0, hMi, hle⟩

theorem hess_kernel_lip : ∃ c₂ : ℝ, 0 ≤ c₂ ∧ ∀ (i j : Fin 3) (k : E3 → ℝ),
    (∀ ζ : E3, k ζ = (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
      (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) →
    ∀ η : E3, ‖η‖ ≤ 1 →
      Integrable (fun ζ : E3 => |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) ∧
      ∫ ζ : E3, |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) ≤ c₂ * ‖η‖ :=
by
  have hc : (0 : ℝ) < (4 * Real.pi) ^ (-(3 / 2 : ℝ)) := Real.rpow_pos_of_pos (by positivity) _
  
  have s2 : ∀ (i j : Fin 3) (k : E3 → ℝ),
      (∀ ζ : E3, k ζ = (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
        (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) →
      ∀ (ζ η : E3) (t : ℝ),
      HasDerivAt (fun s : ℝ => k (ζ + s • η))
        ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ + t • η‖ ^ 2) / 4) *
          (-(inner ℝ (ζ + t • η) η) / 2 *
              ((ζ + t • η) i * (ζ + t • η) j / 4 - (if i = j then (1 : ℝ) else 0) / 2)
            + (η i * (ζ + t • η) j + (ζ + t • η) i * η j) / 4)) t := by
    intro i j k hk ζ η t
    have hfun : (fun s : ℝ => k (ζ + s • η)) = fun s : ℝ =>
        (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ + s • η‖ ^ 2) / 4) *
          ((ζ i + s * η i) * (ζ j + s * η j) / 4 - (if i = j then (1 : ℝ) else 0) / 2) := by
      funext s
      rw [hk]
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    rw [hfun]
    have hγ : HasDerivAt (fun s : ℝ => ζ + s • η) η t := by
      simpa using ((hasDerivAt_id t).smul_const η).const_add ζ
    have hN := hγ.norm_sq
    have hE := ((hN.neg).div_const 4).exp
    have hi : HasDerivAt (fun s : ℝ => ζ i + s * η i) (η i) t := by
      simpa using ((hasDerivAt_id t).mul_const (η i)).const_add (ζ i)
    have hj : HasDerivAt (fun s : ℝ => ζ j + s * η j) (η j) t := by
      simpa using ((hasDerivAt_id t).mul_const (η j)).const_add (ζ j)
    have hP := ((hi.mul hj).div_const 4).sub_const ((if i = j then (1 : ℝ) else 0) / 2)
    have h := (hE.const_mul ((4 * Real.pi) ^ (-(3 / 2 : ℝ)))).mul hP
    convert h using 1
    simp only [Pi.mul_apply, Pi.neg_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    ring
  
  have s3 : ∀ (i j : Fin 3) (w ζ η : E3), ‖w - ζ‖ ≤ 1 →
      |(4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖w‖ ^ 2) / 4) *
          (-(inner ℝ w η) / 2 * (w i * w j / 4 - (if i = j then (1 : ℝ) else 0) / 2)
            + (η i * w j + w i * η j) / 4)|
        ≤ (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖ *
            Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 3 := by
    intro i j w ζ η hw
    have hρ0 : 0 ≤ ‖w‖ := norm_nonneg _
    have hr0 : 0 ≤ ‖ζ‖ := norm_nonneg _
    have hn0 : 0 ≤ ‖η‖ := norm_nonneg _
    have hwi : |w i| ≤ ‖w‖ := by rw [← Real.norm_eq_abs]; exact PiLp.norm_apply_le w i
    have hwj : |w j| ≤ ‖w‖ := by rw [← Real.norm_eq_abs]; exact PiLp.norm_apply_le w j
    have hηi : |η i| ≤ ‖η‖ := by rw [← Real.norm_eq_abs]; exact PiLp.norm_apply_le η i
    have hηj : |η j| ≤ ‖η‖ := by rw [← Real.norm_eq_abs]; exact PiLp.norm_apply_le η j
    have hin : |inner ℝ w η| ≤ ‖w‖ * ‖η‖ := abs_real_inner_le_norm w η
    have hδ0 : 0 ≤ (if i = j then (1 : ℝ) else 0) := by split_ifs <;> norm_num
    have hδ1 : (if i = j then (1 : ℝ) else 0) ≤ 1 := by split_ifs <;> norm_num
    have hρr : ‖w‖ ≤ ‖ζ‖ + 1 := by have := norm_le_insert' w ζ; linarith
    have hrρ : ‖ζ‖ ≤ ‖w‖ + 1 := by
      have := norm_le_insert' ζ w
      rw [norm_sub_rev] at this
      linarith
    have hij : |w i * w j| ≤ ‖w‖ * ‖w‖ := by
      rw [abs_mul]; exact mul_le_mul hwi hwj (abs_nonneg _) hρ0
    have hP : |w i * w j / 4 - (if i = j then (1 : ℝ) else 0) / 2| ≤ ‖w‖ * ‖w‖ / 4 + 1 / 2 := by
      rw [abs_le] at hij ⊢
      constructor <;> linarith [hij.1, hij.2]
    have hQ1 : |η i * w j| ≤ ‖η‖ * ‖w‖ := by
      rw [abs_mul]; exact mul_le_mul hηi hwj (abs_nonneg _) hn0
    have hQ2 : |w i * η j| ≤ ‖w‖ * ‖η‖ := by
      rw [abs_mul]; exact mul_le_mul hwi hηj (abs_nonneg _) hρ0
    have hQ : |η i * w j + w i * η j| ≤ 2 * (‖w‖ * ‖η‖) := by
      calc |η i * w j + w i * η j| ≤ |η i * w j| + |w i * η j| := abs_add_le _ _
        _ ≤ ‖η‖ * ‖w‖ + ‖w‖ * ‖η‖ := add_le_add hQ1 hQ2
        _ = 2 * (‖w‖ * ‖η‖) := by ring
    have hB : |-(inner ℝ w η) / 2 * (w i * w j / 4 - (if i = j then (1 : ℝ) else 0) / 2)
            + (η i * w j + w i * η j) / 4| ≤ ‖η‖ * (1 + ‖ζ‖) ^ 3 := by
      have hcube : ‖w‖ ^ 3 ≤ (1 + ‖ζ‖) ^ 3 := pow_le_pow_left₀ hρ0 (by linarith) 3
      have hlin : ‖w‖ ≤ (1 + ‖ζ‖) ^ 3 := by
        have h1 : 1 ≤ 1 + ‖ζ‖ := by linarith
        have h2 : (1 + ‖ζ‖) ≤ (1 + ‖ζ‖) ^ 3 := le_self_pow₀ h1 (by norm_num)
        linarith
      calc _ ≤ |-(inner ℝ w η) / 2 * (w i * w j / 4 - (if i = j then (1 : ℝ) else 0) / 2)|
              + |(η i * w j + w i * η j) / 4| := abs_add_le _ _
        _ = |inner ℝ w η| / 2 * |w i * w j / 4 - (if i = j then (1 : ℝ) else 0) / 2|
              + |η i * w j + w i * η j| / 4 := by
            rw [abs_mul, abs_div, abs_div, abs_neg]; norm_num
        _ ≤ (‖w‖ * ‖η‖) / 2 * (‖w‖ * ‖w‖ / 4 + 1 / 2) + 2 * (‖w‖ * ‖η‖) / 4 := by
            gcongr
        _ = ‖η‖ * (‖w‖ ^ 3 / 8 + 3 * ‖w‖ / 4) := by ring
        _ ≤ ‖η‖ * (1 + ‖ζ‖) ^ 3 := by
            apply mul_le_mul_of_nonneg_left _ hn0
            linarith
    have hE : Real.exp (-(‖w‖ ^ 2) / 4) ≤ Real.exp (1 / 4) * Real.exp (-(‖ζ‖ ^ 2) / 8) := by
      rw [← Real.exp_add]
      apply Real.exp_le_exp.mpr
      nlinarith [mul_nonneg (sub_nonneg.mpr hrρ) (by positivity : (0 : ℝ) ≤ ‖w‖ + 1 + ‖ζ‖),
        sq_nonneg (‖w‖ - 1)]
    rw [abs_mul, abs_mul, abs_of_pos hc, abs_of_pos (Real.exp_pos _)]
    calc (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖w‖ ^ 2) / 4) * |_|
        ≤ (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * (Real.exp (1 / 4) * Real.exp (-(‖ζ‖ ^ 2) / 8)) *
            (‖η‖ * (1 + ‖ζ‖) ^ 3) := by gcongr
      _ = _ := by ring
  
  have s5 : ∀ r : ℝ, 0 ≤ r → Real.exp (-(r ^ 2) / 8) * (1 + r) ^ 8 ≤ 2 ^ 8 * (1 + 24 * 8 ^ 4) := by
    intro r hr
    obtain ⟨x, hx⟩ : ∃ x : ℝ, x = r ^ 2 / 8 := ⟨_, rfl⟩
    have hx0 : 0 ≤ x := by rw [hx]; positivity
    have h1 : (1 + r) ^ 8 ≤ 2 ^ 8 * (1 + r ^ 8) := by
      rcases le_total r 1 with h | h
      · have h' : (1 + r) ^ 8 ≤ 2 ^ 8 := pow_le_pow_left₀ (by linarith) (by linarith) 8
        have : 0 ≤ r ^ 8 := by positivity
        nlinarith
      · have h' : (1 + r) ^ 8 ≤ (2 * r) ^ 8 := pow_le_pow_left₀ (by linarith) (by linarith) 8
        rw [mul_pow] at h'
        nlinarith
    have h2 : x ^ 4 / 24 ≤ Real.exp x := by
      have := Real.pow_div_factorial_le_exp x hx0 4
      simpa [Nat.factorial] using this
    have h3 : Real.exp (-x) * Real.exp x = 1 := by rw [← Real.exp_add]; simp
    have h4 : Real.exp (-x) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
    have hE0 : 0 < Real.exp (-x) := Real.exp_pos _
    have h8 : r ^ 8 = 8 ^ 4 * x ^ 4 := by rw [hx]; ring
    have h5 : Real.exp (-x) * r ^ 8 ≤ 24 * 8 ^ 4 := by
      rw [h8]
      calc Real.exp (-x) * (8 ^ 4 * x ^ 4) = 24 * 8 ^ 4 * (Real.exp (-x) * (x ^ 4 / 24)) := by ring
        _ ≤ 24 * 8 ^ 4 * (Real.exp (-x) * Real.exp x) := by gcongr
        _ = 24 * 8 ^ 4 := by rw [h3, mul_one]
    have hneg : -(r ^ 2) / 8 = -x := by rw [hx]; ring
    rw [hneg]
    calc Real.exp (-x) * (1 + r) ^ 8 ≤ Real.exp (-x) * (2 ^ 8 * (1 + r ^ 8)) := by gcongr
      _ = 2 ^ 8 * (Real.exp (-x) + Real.exp (-x) * r ^ 8) := by ring
      _ ≤ 2 ^ 8 * (1 + 24 * 8 ^ 4) := by linarith
  
  have s4 : ∀ (i j : Fin 3) (k : E3 → ℝ),
      (∀ ζ : E3, k ζ = (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
        (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)) →
      ∀ ζ η : E3, ‖η‖ ≤ 1 →
      |k (ζ + η) - k ζ| ≤ (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖ *
            Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 3 := by
    intro i j k hk ζ η hη
    have h := norm_image_sub_le_of_norm_deriv_le_segment_01' (f := fun s : ℝ => k (ζ + s • η))
      (f' := fun t : ℝ => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ + t • η‖ ^ 2) / 4) *
          (-(inner ℝ (ζ + t • η) η) / 2 *
              ((ζ + t • η) i * (ζ + t • η) j / 4 - (if i = j then (1 : ℝ) else 0) / 2)
            + (η i * (ζ + t • η) j + (ζ + t • η) i * η j) / 4))
      (C := (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖ *
            Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 3)
      (fun x _ => (s2 i j k hk ζ η x).hasDerivWithinAt)
      (fun x hx => by
        rw [Real.norm_eq_abs]
        apply s3 i j (ζ + x • η) ζ η
        rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg hx.1]
        exact mul_le_one₀ hx.2.le (norm_nonneg _) hη)
    simp only [one_smul, zero_smul, add_zero, Real.norm_eq_abs] at h
    exact h
  have hI : Integrable (fun ζ : E3 => (1 + ‖ζ‖) ^ (-(4 : ℝ))) := by
    apply integrable_one_add_norm
    rw [finrank_euclideanSpace_fin]
    norm_num
  have hI0 : 0 ≤ ∫ ζ : E3, (1 + ‖ζ‖) ^ (-(4 : ℝ)) :=
    integral_nonneg (fun ζ => Real.rpow_nonneg (by positivity) _)
  refine ⟨(4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * (2 ^ 8 * (1 + 24 * 8 ^ 4)) *
    ∫ ζ : E3, (1 + ‖ζ‖) ^ (-(4 : ℝ)), by positivity, ?_⟩
  intro i j k hk η hη
  have hci : Continuous (fun ζ : E3 => ζ i) := (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).continuous
  have hcj : Continuous (fun ζ : E3 => ζ j) := (EuclideanSpace.proj j : E3 →L[ℝ] ℝ).continuous
  have hkc : Continuous k := by
    have hkeq : k = fun ζ : E3 => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
        (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2) := funext hk
    rw [hkeq]
    exact (continuous_const.mul (Real.continuous_exp.comp
      ((continuous_norm.pow 2).neg.div_const 4))).mul
      (((hci.mul hcj).div_const 4).sub continuous_const)
  have hFc : Continuous (fun ζ : E3 => |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) :=
    ((hkc.comp (continuous_id.add continuous_const)).sub hkc).abs.mul
      (continuous_norm.rpow_const (fun _ => Or.inr (by norm_num)))
  have hF0 : ∀ ζ : E3, 0 ≤ |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) :=
    fun ζ => mul_nonneg (abs_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _)
  have hmaj : ∀ ζ : E3, |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) ≤
      ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * (2 ^ 8 * (1 + 24 * 8 ^ 4)) * ‖η‖) *
        (1 + ‖ζ‖) ^ (-(4 : ℝ)) := by
    intro ζ
    have hr0 : 0 ≤ ‖ζ‖ := norm_nonneg _
    have h4 := s4 i j k hk ζ η hη
    have hsq : ‖ζ‖ ^ (1 / 2 : ℝ) ≤ 1 + ‖ζ‖ := by
      rcases le_total ‖ζ‖ 1 with h | h
      · have := Real.rpow_le_one hr0 h (by norm_num : (0 : ℝ) ≤ 1 / 2)
        linarith
      · have := Real.rpow_le_rpow_of_exponent_le h (by norm_num : (1 / 2 : ℝ) ≤ 1)
        rw [Real.rpow_one] at this
        linarith
    have hpos : 0 < (1 + ‖ζ‖) ^ 4 := by positivity
    have key : Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 4 ≤
        (2 ^ 8 * (1 + 24 * 8 ^ 4)) * ((1 + ‖ζ‖) ^ 4)⁻¹ := by
      rw [← div_eq_mul_inv, le_div_iff₀ hpos]
      calc Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 4 * (1 + ‖ζ‖) ^ 4
          = Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 8 := by ring
        _ ≤ _ := s5 ‖ζ‖ hr0
    have hrpow : (1 + ‖ζ‖) ^ (-(4 : ℝ)) = ((1 + ‖ζ‖) ^ 4)⁻¹ := by
      rw [Real.rpow_neg (by positivity), show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num,
        Real.rpow_natCast]
    calc |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)
        ≤ ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖ *
            Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 3) * (1 + ‖ζ‖) :=
          mul_le_mul h4 hsq (Real.rpow_nonneg hr0 _) (le_trans (abs_nonneg _) h4)
      _ = ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖) *
            (Real.exp (-(‖ζ‖ ^ 2) / 8) * (1 + ‖ζ‖) ^ 4) := by ring
      _ ≤ ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * ‖η‖) *
            ((2 ^ 8 * (1 + 24 * 8 ^ 4)) * ((1 + ‖ζ‖) ^ 4)⁻¹) :=
          mul_le_mul_of_nonneg_left key (by positivity)
      _ = _ := by rw [hrpow]; ring
  have hg : Integrable (fun ζ : E3 =>
      ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) * (2 ^ 8 * (1 + 24 * 8 ^ 4)) * ‖η‖) *
        (1 + ‖ζ‖) ^ (-(4 : ℝ))) := hI.const_mul _
  have hFi : Integrable (fun ζ : E3 => |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) :=
    hg.mono' hFc.aestronglyMeasurable (ae_of_all _ fun ζ => by
      rw [Real.norm_eq_abs, abs_of_nonneg (hF0 ζ)]
      exact hmaj ζ)
  refine ⟨hFi, ?_⟩
  calc ∫ ζ : E3, |k (ζ + η) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)
      ≤ ∫ ζ : E3, ((4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (1 / 4) *
          (2 ^ 8 * (1 + 24 * 8 ^ 4)) * ‖η‖) * (1 + ‖ζ‖) ^ (-(4 : ℝ)) :=
        integral_mono_of_nonneg (ae_of_all _ hF0) hg (ae_of_all _ hmaj)
    _ = _ := by rw [integral_const_mul]; ring

theorem kernel_holder_small (k f : E3 → ℝ) (K M s : ℝ) (x : E3) (hK : 0 ≤ K) (hs : 0 ≤ s)
    (hk : Integrable k) (hk0 : ∫ ζ : E3, k ζ = 0)
    (hkm : Integrable (fun ζ : E3 => |k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)))
    (hM : ∫ ζ : E3, |k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) ≤ M)
    (hfc : Continuous f) (hfb : ∃ B : ℝ, ∀ z : E3, |f z| ≤ B)
    (hf : ∀ y z : E3, |f y - f z| ≤ K * ‖y - z‖ ^ (1 / 2 : ℝ)) :
    |∫ ζ : E3, k ζ * f (x - s • ζ)| ≤ K * s ^ (1 / 2 : ℝ) * M :=
by
  obtain ⟨B, hB⟩ := hfb
  have hFc : Continuous (fun ζ : E3 => f (x - s • ζ)) := by fun_prop
  have I₁ : Integrable (fun ζ : E3 => k ζ * f (x - s • ζ)) := by
    refine Integrable.mono' (hk.norm.const_mul B)
      (hk.aestronglyMeasurable.mul hFc.aestronglyMeasurable) (Filter.Eventually.of_forall ?_)
    intro ζ
    rw [norm_mul, Real.norm_eq_abs (f _), mul_comm B]
    exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)
  have I₂ : Integrable (fun ζ : E3 => k ζ * f x) := hk.mul_const (f x)
  have hsplit : ∫ ζ : E3, k ζ * f (x - s • ζ)
      = ∫ ζ : E3, (k ζ * f (x - s • ζ) - k ζ * f x) := by
    rw [integral_sub I₁ I₂, integral_mul_const, hk0, zero_mul, sub_zero]
  have hpt : ∀ ζ : E3, ‖k ζ * f (x - s • ζ) - k ζ * f x‖
      ≤ K * s ^ (1 / 2 : ℝ) * (|k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) := by
    intro ζ
    have h1 : ‖x - s • ζ - x‖ = s * ‖ζ‖ := by
      rw [sub_sub_cancel_left, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_nonneg hs]
    have h2 := hf (x - s • ζ) x
    rw [h1, Real.mul_rpow hs (norm_nonneg ζ)] at h2
    rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
    calc |k ζ| * |f (x - s • ζ) - f x|
        ≤ |k ζ| * (K * (s ^ (1 / 2 : ℝ) * ‖ζ‖ ^ (1 / 2 : ℝ))) :=
          mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
      _ = K * s ^ (1 / 2 : ℝ) * (|k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) := by ring
  have hG : Integrable (fun ζ : E3 => K * s ^ (1 / 2 : ℝ) * (|k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ))) :=
    hkm.const_mul _
  have hle := norm_integral_le_of_norm_le hG (Filter.Eventually.of_forall hpt)
  rw [integral_const_mul] at hle
  rw [hsplit, ← Real.norm_eq_abs]
  calc _ ≤ _ := hle
    _ ≤ K * s ^ (1 / 2 : ℝ) * M :=
      mul_le_mul_of_nonneg_left hM (mul_nonneg hK (Real.rpow_nonneg hs _))

theorem kernel_holder_diff (k f : E3 → ℝ) (K M s : ℝ) (x y : E3) (hK : 0 ≤ K) (hs : 0 < s)
    (hk : Integrable k) (hk0 : ∫ ζ : E3, k ζ = 0)
    (hkm : Integrable (fun ζ : E3 => |k (ζ + s⁻¹ • (y - x)) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)))
    (hM : ∫ ζ : E3, |k (ζ + s⁻¹ • (y - x)) - k ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) ≤ M)
    (hfc : Continuous f) (hfb : ∃ B : ℝ, ∀ z : E3, |f z| ≤ B)
    (hf : ∀ y z : E3, |f y - f z| ≤ K * ‖y - z‖ ^ (1 / 2 : ℝ)) :
    |(∫ ζ : E3, k ζ * f (x - s • ζ)) - ∫ ζ : E3, k ζ * f (y - s • ζ)| ≤ K * s ^ (1 / 2 : ℝ) * M :=
by
  obtain ⟨B, hB⟩ := hfb
  have hφc : Continuous (fun ζ : E3 => f (x - s • ζ)) :=
    hfc.comp (continuous_const.sub (continuous_const.smul continuous_id))
  have hφb : ∀ ζ : E3, ‖f (x - s • ζ)‖ ≤ B := fun ζ => by
    rw [Real.norm_eq_abs]; exact hB _
  have hkh : Integrable (fun ζ : E3 => k (ζ + s⁻¹ • (y - x))) := hk.comp_add_right _
  have i1 : Integrable (fun ζ : E3 => k ζ * f (x - s • ζ)) :=
    hk.mul_bdd hφc.aestronglyMeasurable (Filter.Eventually.of_forall hφb)
  have i2 : Integrable (fun ζ : E3 => k (ζ + s⁻¹ • (y - x)) * f (x - s • ζ)) :=
    hkh.mul_bdd hφc.aestronglyMeasurable (Filter.Eventually.of_forall hφb)
  have hsub : ∀ ξ : E3, y - s • (ξ + s⁻¹ • (y - x)) = x - s • ξ := by
    intro ξ
    rw [smul_add, smul_inv_smul₀ hs.ne']
    abel
  have star : ∫ ζ : E3, k ζ * f (y - s • ζ)
      = ∫ ξ : E3, k (ξ + s⁻¹ • (y - x)) * f (x - s • ξ) := by
    have h1 := integral_add_right_eq_self (μ := (volume : Measure E3))
      (fun ζ => k ζ * f (y - s • ζ)) (s⁻¹ • (y - x))
    simp only [hsub] at h1
    exact h1.symm
  have hint : Integrable (fun ζ : E3 => k (ζ + s⁻¹ • (y - x)) - k ζ) := hkh.sub hk
  have hmean : ∫ ζ : E3, (k (ζ + s⁻¹ • (y - x)) - k ζ) = 0 := by
    rw [integral_sub hkh hk]
    have h2 := integral_add_right_eq_self (μ := (volume : Measure E3)) k (s⁻¹ • (y - x))
    rw [h2]; ring
  have small : ∀ k' : E3 → ℝ, Integrable k' → ∫ ζ : E3, k' ζ = 0 →
      Integrable (fun ζ : E3 => |k' ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) →
      ∫ ζ : E3, |k' ζ| * ‖ζ‖ ^ (1 / 2 : ℝ) ≤ M →
      |∫ ζ : E3, k' ζ * f (x - s • ζ)| ≤ K * s ^ (1 / 2 : ℝ) * M := by
    intro k' hk' hk'0 hk'm hk'M
    have I₂ : Integrable (fun ζ : E3 => k' ζ * f x) := hk'.mul_const (f x)
    have I₁ : Integrable (fun ζ : E3 => k' ζ * f (x - s • ζ)) :=
      hk'.mul_bdd hφc.aestronglyMeasurable (Filter.Eventually.of_forall hφb)
    have hsplit : ∫ ζ : E3, k' ζ * f (x - s • ζ)
        = ∫ ζ : E3, (k' ζ * f (x - s • ζ) - k' ζ * f x) := by
      rw [integral_sub I₁ I₂, integral_mul_const, hk'0, zero_mul, sub_zero]
    have hpt : ∀ ζ : E3, ‖k' ζ * f (x - s • ζ) - k' ζ * f x‖
        ≤ K * s ^ (1 / 2 : ℝ) * (|k' ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) := by
      intro ζ
      have h1 : ‖x - s • ζ - x‖ = s * ‖ζ‖ := by
        rw [sub_sub_cancel_left, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_nonneg hs.le]
      have h2 := hf (x - s • ζ) x
      rw [h1, Real.mul_rpow hs.le (norm_nonneg ζ)] at h2
      rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
      calc |k' ζ| * |f (x - s • ζ) - f x|
          ≤ |k' ζ| * (K * (s ^ (1 / 2 : ℝ) * ‖ζ‖ ^ (1 / 2 : ℝ))) :=
            mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
        _ = K * s ^ (1 / 2 : ℝ) * (|k' ζ| * ‖ζ‖ ^ (1 / 2 : ℝ)) := by ring
    have hG : Integrable (fun ζ : E3 => K * s ^ (1 / 2 : ℝ) * (|k' ζ| * ‖ζ‖ ^ (1 / 2 : ℝ))) :=
      hk'm.const_mul _
    have hle := norm_integral_le_of_norm_le hG (Filter.Eventually.of_forall hpt)
    rw [integral_const_mul] at hle
    rw [hsplit, ← Real.norm_eq_abs]
    calc _ ≤ _ := hle
      _ ≤ K * s ^ (1 / 2 : ℝ) * M :=
        mul_le_mul_of_nonneg_left hk'M (mul_nonneg hK (Real.rpow_nonneg hs.le _))
  have key := small (fun ζ => k (ζ + s⁻¹ • (y - x)) - k ζ) hint hmean hkm hM
  have hdiff : (∫ ζ : E3, k ζ * f (x - s • ζ)) - ∫ ζ : E3, k ζ * f (y - s • ζ)
      = -∫ ζ : E3, (k (ζ + s⁻¹ • (y - x)) - k ζ) * f (x - s • ζ) := by
    rw [star, ← integral_sub i1 i2, ← integral_neg]
    congr 1; funext ζ; ring
  rw [hdiff, abs_neg]
  exact key

theorem time_split_bound (T₁ T₂ : ℝ → ℝ) (a b d : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) (hd : 0 < d)
    (h1 : IntegrableOn T₁ (Set.Ioi 0)) (h2 : IntegrableOn T₂ (Set.Ioi 0))
    (hs1 : ∀ t : ℝ, 0 < t → |T₁ t| ≤ a * t ^ (-(3 / 4 : ℝ)))
    (hs2 : ∀ t : ℝ, 0 < t → |T₂ t| ≤ a * t ^ (-(3 / 4 : ℝ)))
    (hl : ∀ t : ℝ, d ^ 2 ≤ t → |T₁ t - T₂ t| ≤ b * t ^ (-(5 / 4 : ℝ))) :
    |(∫ t in Set.Ioi (0 : ℝ), T₁ t) - ∫ t in Set.Ioi (0 : ℝ), T₂ t|
      ≤ 8 * a * d ^ (1 / 2 : ℝ) + 4 * b * d ^ (-(1 / 2 : ℝ)) :=
by
  set D : ℝ := d ^ 2 with hDdef
  have hD : 0 < D := by positivity
  have hU : Set.Ioc 0 D ∪ Set.Ioi D = Set.Ioi (0 : ℝ) := Set.Ioc_union_Ioi_eq_Ioi hD.le
  have hsubS : Set.Ioc 0 D ⊆ Set.Ioi (0 : ℝ) := Set.Ioc_subset_Ioi_self
  have hsubL : Set.Ioi D ⊆ Set.Ioi (0 : ℝ) := Set.Ioi_subset_Ioi hD.le
  have h1S := h1.mono_set hsubS
  have h1L := h1.mono_set hsubL
  have h2S := h2.mono_set hsubS
  have h2L := h2.mono_set hsubL
  have hsplit : ∀ T : ℝ → ℝ, IntegrableOn T (Set.Ioc 0 D) → IntegrableOn T (Set.Ioi D) →
      ∫ t in Set.Ioi (0 : ℝ), T t = (∫ t in Set.Ioc 0 D, T t) + ∫ t in Set.Ioi D, T t := by
    intro T hS hL
    rw [← hU]
    exact MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi hS hL
  have hpS : IntegrableOn (fun t : ℝ => t ^ (-(3 / 4 : ℝ))) (Set.Ioc 0 D) :=
    (intervalIntegrable_iff_integrableOn_Ioc_of_le hD.le).mp
      (intervalIntegral.intervalIntegrable_rpow' (by norm_num))
  have hvS : ∫ t in Set.Ioc 0 D, t ^ (-(3 / 4 : ℝ)) = 4 * D ^ (1 / 4 : ℝ) := by
    rw [← intervalIntegral.integral_of_le hD.le, integral_rpow (Or.inl (by norm_num))]
    rw [show (-(3 / 4 : ℝ)) + 1 = 1 / 4 by norm_num, Real.zero_rpow (by norm_num)]
    ring
  have hsmall : ∀ T : ℝ → ℝ, (∀ t : ℝ, 0 < t → |T t| ≤ a * t ^ (-(3 / 4 : ℝ))) →
      |∫ t in Set.Ioc 0 D, T t| ≤ 4 * a * D ^ (1 / 4 : ℝ) := by
    intro T hT
    have h := MeasureTheory.norm_integral_le_of_norm_le (hpS.const_mul a)
      (MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioc (fun t ht => by
        rw [Real.norm_eq_abs]; exact hT t ht.1))
    rw [MeasureTheory.integral_const_mul, hvS, Real.norm_eq_abs] at h
    linarith
  have hpL : IntegrableOn (fun t : ℝ => t ^ (-(5 / 4 : ℝ))) (Set.Ioi D) :=
    integrableOn_Ioi_rpow_of_lt (by norm_num) hD
  have hvL : ∫ t in Set.Ioi D, t ^ (-(5 / 4 : ℝ)) = 4 * D ^ (-(1 / 4) : ℝ) := by
    rw [integral_Ioi_rpow_of_lt (by norm_num) hD]
    rw [show (-(5 / 4 : ℝ)) + 1 = -(1 / 4) by norm_num]
    ring
  have hlarge : |(∫ t in Set.Ioi D, T₁ t) - ∫ t in Set.Ioi D, T₂ t|
      ≤ 4 * b * D ^ (-(1 / 4) : ℝ) := by
    rw [← MeasureTheory.integral_sub h1L h2L]
    have h := MeasureTheory.norm_integral_le_of_norm_le (hpL.const_mul b)
      (MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioi (fun t (ht : D < t) => by
        rw [Real.norm_eq_abs]; exact hl t ht.le))
    rw [MeasureTheory.integral_const_mul, hvL, Real.norm_eq_abs] at h
    linarith
  have e1 : D ^ (1 / 4 : ℝ) = d ^ (1 / 2 : ℝ) := by
    rw [hDdef, ← Real.rpow_natCast, ← Real.rpow_mul hd.le]; norm_num
  have e2 : D ^ (-(1 / 4) : ℝ) = d ^ (-(1 / 2) : ℝ) := by
    rw [hDdef, ← Real.rpow_natCast, ← Real.rpow_mul hd.le]; norm_num
  rw [hsplit T₁ h1S h1L, hsplit T₂ h2S h2L]
  have hA1 := hsmall T₁ hs1
  have hA2 := hsmall T₂ hs2
  rw [e1] at hA1 hA2
  rw [e2] at hlarge
  have key : ∀ x y z w : ℝ, |(x + y) - (z + w)| ≤ |x| + |z| + |y - w| := by
    intro x y z w
    calc |(x + y) - (z + w)| = |(x + -z) + (y - w)| := by congr 1; ring
      _ ≤ |x + -z| + |y - w| := abs_add_le _ _
      _ ≤ |x| + |-z| + |y - w| := by gcongr; exact abs_add_le _ _
      _ = |x| + |z| + |y - w| := by rw [abs_neg]
  have hk := key (∫ t in Set.Ioc 0 D, T₁ t) (∫ t in Set.Ioi D, T₁ t)
    (∫ t in Set.Ioc 0 D, T₂ t) (∫ t in Set.Ioi D, T₂ t)
  linarith

theorem holder_schauder_global : ∃ C_G : ℝ, 0 ≤ C_G ∧
    ∀ (ψ : E3 → ℝ), ContDiff ℝ ∞ ψ → HasCompactSupport ψ → ∀ K : ℝ,
      (∀ x y : E3, |∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) x
          - ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) y| ≤ K * ‖x - y‖ ^ (1 / 2 : ℝ)) →
      ∀ (i j : Fin 3) (x y : E3), |partialDeriv i (fun z => partialDeriv j ψ z) x
          - partialDeriv i (fun z => partialDeriv j ψ z) y| ≤ C_G * K * ‖x - y‖ ^ (1 / 2 : ℝ) :=
by
  obtain ⟨c₁, hc₁, hmom⟩ := hess_kernel_moments
  obtain ⟨c₂, hc₂, hlip⟩ := hess_kernel_lip
  obtain ⟨hp₁smooth, -, hp₁d2⟩ := gaussian_partials
  refine ⟨8 * c₁ + 4 * c₂, by linarith, ?_⟩
  intro ψ hψ hψc K hK i j x y
  by_cases hxy : x = y
  · subst hxy
    simp
  
  have hpd : ∀ g : E3 → ℝ, ContDiff ℝ ∞ g → ∀ a : Fin 3,
      ContDiff ℝ ∞ (fun z => partialDeriv a g z) :=
    fun g hg a => (hg.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
  have hcs : ∀ g : E3 → ℝ, HasCompactSupport g → ∀ a : Fin 3,
      HasCompactSupport (fun z => partialDeriv a g z) :=
    fun g hg a => (hg.fderiv (𝕜 := ℝ)).comp_left (g := fun L : E3 →L[ℝ] ℝ => L (e a)) rfl
  have hC1 : ∀ g : E3 → ℝ, ContDiff ℝ ∞ g → ContDiff ℝ 1 g :=
    fun g hg => hg.of_le (by exact_mod_cast le_top)
  
  have hd : 0 < ‖x - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hxy)
  have hdh : 0 < ‖x - y‖ ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos hd _
  have hK0 : 0 ≤ K := by
    have h := hK x y
    by_contra hneg
    push_neg at hneg
    have h2 : K * ‖x - y‖ ^ (1 / 2 : ℝ) < 0 := mul_neg_of_neg_of_pos hneg hdh
    have h3 := abs_nonneg (∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) x
          - ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) y)
    linarith
  
  set p : E3 → ℝ := fun ζ => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) with hpdef
  set H : E3 → ℝ := fun ζ => (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
      (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2) with hHdef
  set f : E3 → ℝ := fun z => ∑ k : Fin 3, partialDeriv k (fun y => partialDeriv k ψ y) z with hfdef
  set u : E3 → ℝ := fun z => partialDeriv i (fun z => partialDeriv j ψ z) z with hudef
  set T : E3 → ℝ → ℝ := fun w t => t⁻¹ * ∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ) with hTdef
  have hψj : ContDiff ℝ ∞ (fun z => partialDeriv j ψ z) := hpd ψ hψ j
  have hψjc : HasCompactSupport (fun z => partialDeriv j ψ z) := hcs ψ hψc j
  have hu : ContDiff ℝ ∞ u := hpd _ hψj i
  have huc : HasCompactSupport u := hcs _ hψjc i
  have hf : ContDiff ℝ ∞ f := ContDiff.sum (fun k _ => hpd _ (hpd ψ hψ k) k)
  have hfc : HasCompactSupport f := by
    have e3 : f = fun z => partialDeriv 0 (fun y => partialDeriv 0 ψ y) z
        + partialDeriv 1 (fun y => partialDeriv 1 ψ y) z
        + partialDeriv 2 (fun y => partialDeriv 2 ψ y) z := by
      funext z; exact Fin.sum_univ_three _
    rw [e3]
    exact ((hcs _ (hcs ψ hψc 0) 0).add (hcs _ (hcs ψ hψc 1) 1)).add (hcs _ (hcs ψ hψc 2) 2)
  obtain ⟨B, hB⟩ := hfc.exists_bound_of_continuous hf.continuous
  have hfb : ∃ B : ℝ, ∀ z : E3, |f z| ≤ B :=
    ⟨B, fun z => by rw [← Real.norm_eq_abs]; exact hB z⟩
  have hfH : ∀ y z : E3, |f y - f z| ≤ K * ‖y - z‖ ^ (1 / 2 : ℝ) := hK
  obtain ⟨hHi, hH0, hHm, hHM⟩ := hmom i j H (fun ζ => rfl)
  have hite : (if j = i then (1 : ℝ) else 0) = if i = j then (1 : ℝ) else 0 := by
    by_cases hij : i = j
    · simp [hij]
    · simp [hij, Ne.symm hij]
  
  have hrep : ∀ w : E3, IntegrableOn (T w) (Set.Ioi 0) ∧
      u w = -∫ t in Set.Ioi (0 : ℝ), T w t := by
    intro w
    obtain ⟨hint, heq⟩ := heat_rep_scalar u hu huc w
    have hA : ∀ t ∈ Set.Ioi (0 : ℝ),
        (∫ ζ : E3, (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
          ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k u z) (w - Real.sqrt t • ζ))
          = T w t := by
      intro t ht
      have ht' : (0 : ℝ) < t := ht
      have hs : 0 < Real.sqrt t := Real.sqrt_pos.mpr ht'
      have e1 : (∫ ζ : E3, (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
          ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k u z) (w - Real.sqrt t • ζ))
          = ∫ ζ : E3, p ζ * partialDeriv i (fun z => partialDeriv j f z) (w - Real.sqrt t • ζ) := by
        congr 1
        funext ζ
        congr 1
        exact laplacian_hessian_comm ψ hψ i j _
      have e2 : (∫ ζ : E3, p ζ * partialDeriv i (fun z => partialDeriv j f z) (w - Real.sqrt t • ζ))
          = (Real.sqrt t)⁻¹ * ∫ ζ : E3, partialDeriv i p ζ * partialDeriv j f (w - Real.sqrt t • ζ) :=
        conv_ibp_scaled p (fun z => partialDeriv j f z) (hC1 _ hp₁smooth) (hC1 _ (hpd _ hf j))
          (hcs _ hfc j) i w (Real.sqrt t) hs
      have e3 : (∫ ζ : E3, partialDeriv i p ζ * partialDeriv j f (w - Real.sqrt t • ζ))
          = (Real.sqrt t)⁻¹ * ∫ ζ : E3, partialDeriv j (fun ζ' => partialDeriv i p ζ') ζ
              * f (w - Real.sqrt t • ζ) :=
        conv_ibp_scaled (fun ζ => partialDeriv i p ζ) f (hC1 _ (hpd _ hp₁smooth i)) (hC1 _ hf) hfc
          j w (Real.sqrt t) hs
      have e4 : (∫ ζ : E3, partialDeriv j (fun ζ' => partialDeriv i p ζ') ζ * f (w - Real.sqrt t • ζ))
          = ∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ) := by
        congr 1
        funext ζ
        congr 1
        refine (hp₁d2 j i ζ).trans ?_
        show (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
            (ζ j * ζ i / 4 - (if j = i then (1 : ℝ) else 0) / 2)
          = (4 * Real.pi) ^ (-(3 / 2 : ℝ)) * Real.exp (-(‖ζ‖ ^ 2) / 4) *
            (ζ i * ζ j / 4 - (if i = j then (1 : ℝ) else 0) / 2)
        rw [mul_comm (ζ j) (ζ i), hite]
      calc _ = _ := e1
        _ = _ := e2
        _ = (Real.sqrt t)⁻¹ * ((Real.sqrt t)⁻¹ * ∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ)) := by
          rw [e3, e4]
        _ = t⁻¹ * ∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ) := by
          rw [← mul_assoc, ← mul_inv, Real.mul_self_sqrt ht'.le]
        _ = T w t := rfl
    refine ⟨hint.congr_fun hA measurableSet_Ioi, ?_⟩
    exact heq.trans (congrArg Neg.neg (setIntegral_congr_fun measurableSet_Ioi hA))
  
  have ex1 : ∀ t : ℝ, 0 < t → t⁻¹ * Real.sqrt t ^ (1 / 2 : ℝ) = t ^ (-(3 / 4 : ℝ)) := by
    intro t ht
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul ht.le, ← Real.rpow_neg_one, ← Real.rpow_add ht]
    norm_num
  have ex2 : ∀ t : ℝ, 0 < t →
      t⁻¹ * Real.sqrt t ^ (1 / 2 : ℝ) * (Real.sqrt t)⁻¹ = t ^ (-(5 / 4 : ℝ)) := by
    intro t ht
    rw [ex1 t ht, Real.sqrt_eq_rpow, ← Real.rpow_neg ht.le, ← Real.rpow_add ht]
    norm_num
  
  have hsmall : ∀ w : E3, ∀ t : ℝ, 0 < t → |T w t| ≤ c₁ * K * t ^ (-(3 / 4 : ℝ)) := by
    intro w t ht
    have h8 := kernel_holder_small H f K c₁ (Real.sqrt t) w hK0 (Real.sqrt_nonneg t) hHi hH0 hHm hHM
      hf.continuous hfb hfH
    show |t⁻¹ * ∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ)| ≤ _
    rw [abs_mul, abs_of_pos (inv_pos.mpr ht)]
    calc t⁻¹ * |∫ ζ : E3, H ζ * f (w - Real.sqrt t • ζ)|
        ≤ t⁻¹ * (K * Real.sqrt t ^ (1 / 2 : ℝ) * c₁) :=
          mul_le_mul_of_nonneg_left h8 (inv_pos.mpr ht).le
      _ = c₁ * K * (t⁻¹ * Real.sqrt t ^ (1 / 2 : ℝ)) := by ring
      _ = c₁ * K * t ^ (-(3 / 4 : ℝ)) := by rw [ex1 t ht]
  
  have hlarge : ∀ t : ℝ, ‖x - y‖ ^ 2 ≤ t →
      |T x t - T y t| ≤ c₂ * K * ‖x - y‖ * t ^ (-(5 / 4 : ℝ)) := by
    intro t ht
    have ht0 : 0 < t := lt_of_lt_of_le (by positivity) ht
    have hs : 0 < Real.sqrt t := Real.sqrt_pos.mpr ht0
    have hsd : ‖x - y‖ ≤ Real.sqrt t := by
      have h := Real.sqrt_le_sqrt ht
      rwa [Real.sqrt_sq (norm_nonneg _)] at h
    have hη : ‖(Real.sqrt t)⁻¹ • (y - x)‖ = ‖x - y‖ * (Real.sqrt t)⁻¹ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs), norm_sub_rev, mul_comm]
    have hη1 : ‖(Real.sqrt t)⁻¹ • (y - x)‖ ≤ 1 := by
      rw [hη, ← div_eq_mul_inv, div_le_one hs]
      exact hsd
    obtain ⟨hli, hlM⟩ := hlip i j H (fun ζ => rfl) _ hη1
    have h9 := kernel_holder_diff H f K (c₂ * ‖(Real.sqrt t)⁻¹ • (y - x)‖) (Real.sqrt t) x y hK0 hs
      hHi hH0 hli hlM hf.continuous hfb hfH
    show |t⁻¹ * (∫ ζ : E3, H ζ * f (x - Real.sqrt t • ζ))
        - t⁻¹ * ∫ ζ : E3, H ζ * f (y - Real.sqrt t • ζ)| ≤ _
    rw [← mul_sub, abs_mul, abs_of_pos (inv_pos.mpr ht0)]
    calc t⁻¹ * |(∫ ζ : E3, H ζ * f (x - Real.sqrt t • ζ)) - ∫ ζ : E3, H ζ * f (y - Real.sqrt t • ζ)|
        ≤ t⁻¹ * (K * Real.sqrt t ^ (1 / 2 : ℝ) * (c₂ * ‖(Real.sqrt t)⁻¹ • (y - x)‖)) :=
          mul_le_mul_of_nonneg_left h9 (inv_pos.mpr ht0).le
      _ = c₂ * K * ‖x - y‖ * (t⁻¹ * Real.sqrt t ^ (1 / 2 : ℝ) * (Real.sqrt t)⁻¹) := by
          rw [hη]; ring
      _ = c₂ * K * ‖x - y‖ * t ^ (-(5 / 4 : ℝ)) := by rw [ex2 t ht0]
  
  have hsplit := time_split_bound (T x) (T y) (c₁ * K) (c₂ * K * ‖x - y‖) ‖x - y‖
    (mul_nonneg hc₁ hK0) (mul_nonneg (mul_nonneg hc₂ hK0) (norm_nonneg _)) hd
    (hrep x).1 (hrep y).1 (hsmall x) (hsmall y) hlarge
  have hdd : ‖x - y‖ * ‖x - y‖ ^ (-(1 / 2 : ℝ)) = ‖x - y‖ ^ (1 / 2 : ℝ) := by
    have h := Real.rpow_add hd 1 (-(1 / 2 : ℝ))
    rw [Real.rpow_one] at h
    rw [← h]
    norm_num
  
  show |u x - u y| ≤ (8 * c₁ + 4 * c₂) * K * ‖x - y‖ ^ (1 / 2 : ℝ)
  rw [(hrep x).2, (hrep y).2]
  have e5 : 4 * (c₂ * K * ‖x - y‖) * ‖x - y‖ ^ (-(1 / 2 : ℝ))
      = 4 * c₂ * K * (‖x - y‖ * ‖x - y‖ ^ (-(1 / 2 : ℝ))) := by ring
  calc |-(∫ t in Set.Ioi (0 : ℝ), T x t) - -(∫ t in Set.Ioi (0 : ℝ), T y t)|
      = |(∫ t in Set.Ioi (0 : ℝ), T x t) - ∫ t in Set.Ioi (0 : ℝ), T y t| := by
        rw [neg_sub_neg, abs_sub_comm]
    _ ≤ 8 * (c₁ * K) * ‖x - y‖ ^ (1 / 2 : ℝ)
          + 4 * (c₂ * K * ‖x - y‖) * ‖x - y‖ ^ (-(1 / 2 : ℝ)) := hsplit
    _ = (8 * c₁ + 4 * c₂) * K * ‖x - y‖ ^ (1 / 2 : ℝ) := by
        rw [e5, hdd]; ring

theorem giaquinta_iteration (P : ℝ → ℝ → Prop) (τ₀ τ₁ A K₁ : ℝ) (hτ : τ₀ < τ₁) (hA : 0 ≤ A)
    (hmonoK : ∀ t K K', P t K → K ≤ K' → P t K')
    (hmonot : ∀ t s K, t ≤ s → P s K → P t K)
    (hclosed : ∀ t K, (∀ K', K < K' → P t K') → P t K)
    (hinit : P τ₁ K₁)
    (hstep : ∀ t s K, τ₀ ≤ t → t < s → s ≤ τ₁ → P s K → P t (K / 2 + A * ((s - t) ^ 3)⁻¹)) :
    P τ₀ (4000 * A * ((τ₁ - τ₀) ^ 3)⁻¹) :=
by
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = τ₁ - τ₀ := ⟨_, rfl⟩
  have hD : 0 < D := by rw [hDdef]; linarith
  obtain ⟨E, hEdef⟩ : ∃ E : ℝ, E = A * (D ^ 3)⁻¹ := ⟨_, rfl⟩
  have hE : 0 ≤ E := by rw [hEdef]; positivity
  obtain ⟨c, hcdef⟩ : ∃ c : ℕ → ℝ, c = fun m => (5 / 6 : ℝ) ^ m := ⟨_, rfl⟩
  obtain ⟨t, htdef⟩ : ∃ t : ℕ → ℝ, t = fun m => τ₁ - D * c m := ⟨_, rfl⟩
  obtain ⟨b, hbdef⟩ : ∃ b : ℕ → ℝ, b = fun m => 2000 * E * ((6 / 5 : ℝ) ^ m) ^ 3 := ⟨_, rfl⟩
  have hc0 : ∀ m, 0 < c m := fun m => by rw [hcdef]; positivity
  have hc1 : ∀ m, c m ≤ 1 := fun m => by
    rw [hcdef]; exact pow_le_one₀ (by norm_num) (by norm_num)
  have hcs : ∀ m, c (m + 1) = c m * (5 / 6) := fun m => by rw [hcdef]; exact pow_succ _ _
  have ht_lo : ∀ m, τ₀ ≤ t m := by
    intro m
    have := mul_le_of_le_one_right hD.le (hc1 m)
    rw [htdef]
    show τ₀ ≤ τ₁ - D * c m
    linarith
  have ht_hi : ∀ m, t m ≤ τ₁ := by
    intro m
    have := mul_pos hD (hc0 m)
    rw [htdef]
    show τ₁ - D * c m ≤ τ₁
    linarith
  have hgap : ∀ m, t (m + 1) - t m = D * c m / 6 := by
    intro m
    rw [htdef]
    show (τ₁ - D * c (m + 1)) - (τ₁ - D * c m) = _
    rw [hcs]; ring
  have ht_lt : ∀ m, t m < t (m + 1) := by
    intro m
    have h1 := hgap m
    have h2 : 0 < D * c m / 6 := by have := hc0 m; positivity
    linarith
  have hinvc : ∀ m, (6 / 5 : ℝ) ^ m = (c m)⁻¹ := by
    intro m
    rw [hcdef]
    show (6 / 5 : ℝ) ^ m = ((5 / 6 : ℝ) ^ m)⁻¹
    rw [← inv_pow]; norm_num
  have hs2 : ∀ m, A * ((t (m + 1) - t m) ^ 3)⁻¹ = 216 * E * ((6 / 5 : ℝ) ^ m) ^ 3 := by
    intro m
    rw [hgap, hinvc, hEdef]
    have hcne : c m ≠ 0 := (hc0 m).ne'
    have hDne : D ≠ 0 := hD.ne'
    field_simp
    ring
  have hb0 : ∀ m, 0 ≤ b m := fun m => by rw [hbdef]; positivity
  have hs3 : ∀ m, b (m + 1) / 2 + 216 * E * ((6 / 5 : ℝ) ^ m) ^ 3 ≤ b m := by
    intro m
    rw [hbdef]
    show 2000 * E * ((6 / 5 : ℝ) ^ (m + 1)) ^ 3 / 2 + 216 * E * ((6 / 5 : ℝ) ^ m) ^ 3
      ≤ 2000 * E * ((6 / 5 : ℝ) ^ m) ^ 3
    have hu : 0 ≤ ((6 / 5 : ℝ) ^ m) ^ 3 := by positivity
    have := mul_nonneg hE hu
    rw [pow_succ (6 / 5 : ℝ) m, mul_pow]
    nlinarith
  have hQ : ∀ n : ℕ, ∀ m : ℕ, P (t m) (K₁ * (1 / 2 : ℝ) ^ n + b m) := by
    intro n
    induction n with
    | zero =>
      intro m
      have h1 := hmonot (t m) τ₁ K₁ (ht_hi m) hinit
      refine hmonoK _ _ _ h1 ?_
      have := hb0 m
      simp only [pow_zero, mul_one]
      linarith
    | succ n ih =>
      intro m
      have h1 := hstep (t m) (t (m + 1)) _ (ht_lo m) (ht_lt m) (ht_hi (m + 1)) (ih (m + 1))
      rw [hs2] at h1
      refine hmonoK _ _ _ h1 ?_
      have := hs3 m
      rw [pow_succ (1 / 2 : ℝ) n]
      linarith
  have ht0 : t 0 = τ₀ := by
    rw [htdef, hcdef]
    show τ₁ - D * (5 / 6 : ℝ) ^ 0 = τ₀
    rw [pow_zero, mul_one, hDdef]; ring
  have hb00 : b 0 = 2000 * E := by
    rw [hbdef]
    show 2000 * E * ((6 / 5 : ℝ) ^ 0) ^ 3 = 2000 * E
    simp
  have h0 : ∀ n : ℕ, P τ₀ (K₁ * (1 / 2 : ℝ) ^ n + 2000 * E) := by
    intro n
    have := hQ n 0
    rwa [ht0, hb00] at this
  have hgoal : 4000 * A * ((τ₁ - τ₀) ^ 3)⁻¹ = 4000 * E := by rw [hEdef, hDdef]; ring
  rw [hgoal]
  apply hclosed
  intro K' hK'
  have hδ : 0 < K' - 2000 * E := by linarith
  have hpos : 0 < (K' - 2000 * E) / (|K₁| + 1) := by positivity
  obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hpos (show (1 / 2 : ℝ) < 1 by norm_num)
  have hpn : 0 ≤ (1 / 2 : ℝ) ^ n := by positivity
  have h1 : K₁ * (1 / 2 : ℝ) ^ n ≤ |K₁| * (1 / 2 : ℝ) ^ n :=
    mul_le_mul_of_nonneg_right (le_abs_self _) hpn
  have h2 : (1 / 2 : ℝ) ^ n * (|K₁| + 1) < K' - 2000 * E := by
    rwa [lt_div_iff₀ (by positivity)] at hn
  refine hmonoK _ _ _ (h0 n) ?_
  nlinarith

theorem interior_interpolation (w : E3 → ℝ) (s m h M₀ H : ℝ) (hm : 0 < m) (hh : 0 < h)
    (hmh : m + h ≤ s) (hw : ContDiffOn ℝ 2 w (Metric.ball 0 s))
    (hM : ∀ x ∈ Metric.ball (0 : E3) s, |w x| ≤ M₀)
    (hH : ∀ x ∈ Metric.ball (0 : E3) s, ∀ y ∈ Metric.ball (0 : E3) s, ∀ i j : Fin 3,
      |partialDeriv i (fun z => partialDeriv j w z) x - partialDeriv i (fun z => partialDeriv j w z) y|
        ≤ H * ‖x - y‖ ^ (1 / 2 : ℝ)) :
    ∀ x ∈ Metric.ball (0 : E3) m, ∀ y ∈ Metric.ball (0 : E3) m, ∀ i j : Fin 3,
      |partialDeriv i (fun z => partialDeriv j w z) x| ≤ 100 * (h ^ (1 / 2 : ℝ) * H + M₀ / h ^ 2) ∧
      |partialDeriv i w x| ≤ 100 * (h ^ (3 / 2 : ℝ) * H + M₀ / h) ∧
      |partialDeriv i w x - partialDeriv i w y|
        ≤ 100 * (h * H + M₀ / h ^ (3 / 2 : ℝ)) * ‖x - y‖ ^ (1 / 2 : ℝ) ∧
      |w x - w y| ≤ 100 * (h ^ 2 * H + M₀ / h ^ (1 / 2 : ℝ)) * ‖x - y‖ ^ (1 / 2 : ℝ) :=
by
  
  have hs : 0 < s := by linarith
  have hM0 : 0 ≤ M₀ := le_trans (abs_nonneg _) (hM 0 (Metric.mem_ball_self hs))
  have he : ∀ i : Fin 3, ‖e i‖ = 1 := fun i => by simp [EuclideanSpace.norm_single]
  have hH0 : 0 ≤ H := by
    have hy₀ : (s / 2) • e 0 ∈ Metric.ball (0 : E3) s := by
      rw [mem_ball_zero_iff, norm_smul, he, Real.norm_eq_abs, abs_of_pos (by linarith : (0:ℝ) < s / 2)]
      linarith
    have h1 := hH 0 (Metric.mem_ball_self hs) _ hy₀ 0 0
    have hn : ‖(0 : E3) - (s / 2) • e 0‖ = s / 2 := by
      rw [zero_sub, norm_neg, norm_smul, he, Real.norm_eq_abs,
        abs_of_pos (by linarith : (0:ℝ) < s / 2), mul_one]
    rw [hn] at h1
    have hp : 0 < (s / 2) ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by linarith) _
    by_contra hneg
    push_neg at hneg
    have : H * (s / 2) ^ (1 / 2 : ℝ) < 0 := mul_neg_of_neg_of_pos hneg hp
    linarith [abs_nonneg (partialDeriv 0 (fun z => partialDeriv 0 w z) 0
      - partialDeriv 0 (fun z => partialDeriv 0 w z) ((s / 2) • e 0))]
  
  have hU : IsOpen (Metric.ball (0 : E3) s) := Metric.isOpen_ball
  have hdw : ∀ p ∈ Metric.ball (0 : E3) s, DifferentiableAt ℝ w p := fun p hp =>
    (hw.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hp)
  have hd1 : ∀ j : Fin 3, ∀ p ∈ Metric.ball (0 : E3) s,
      DifferentiableAt ℝ (fun z => partialDeriv j w z) p := by
    intro j p hp
    have h1 : ContDiffOn ℝ 1 (fderiv ℝ w) (Metric.ball 0 s) :=
      hw.fderiv_of_isOpen hU (by norm_num)
    have h2 : ContDiffOn ℝ 1 (fun z => fderiv ℝ w z (e j)) (Metric.ball 0 s) :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn one_ne_zero).differentiableAt (hU.mem_nhds hp)
  
  have hline : ∀ (f : E3 → ℝ) (x : E3) (i : Fin 3) (t : ℝ), DifferentiableAt ℝ f (x + t • e i) →
      HasDerivAt (fun τ : ℝ => f (x + τ • e i)) (partialDeriv i f (x + t • e i)) t := by
    intro f x i t hf
    have hl : HasDerivAt (fun τ : ℝ => x + τ • e i) (e i) t := by
      have := ((hasDerivAt_id' t).smul_const (e i)).const_add x
      rwa [one_smul] at this
    exact hf.hasFDerivAt.comp_hasDerivAt t hl
  
  have mvt : ∀ (φ φ' : ℝ → ℝ) (a b C : ℝ), a ≤ b → (∀ t ∈ Set.Icc a b, HasDerivAt φ (φ' t) t) →
      (∀ t ∈ Set.Icc a b, |φ' t| ≤ C) → |φ b - φ a| ≤ C * (b - a) := by
    intro φ φ' a b C hab hd hC
    have := (convex_Icc a b).norm_image_sub_le_of_norm_hasDerivWithin_le (f := φ) (f' := φ')
      (fun t ht => (hd t ht).hasDerivWithinAt)
      (fun t ht => by rw [Real.norm_eq_abs]; exact hC t ht)
      (Set.left_mem_Icc.mpr hab) (Set.right_mem_Icc.mpr hab)
    rwa [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr hab)] at this
  
  have cd1 : ∀ (f f1 : ℝ → ℝ) (ρ E : ℝ), 0 < ρ → (∀ t ∈ Set.Icc (-ρ) ρ, HasDerivAt f (f1 t) t) →
      (∀ t ∈ Set.Icc (-ρ) ρ, |f1 t - f1 0| ≤ E) →
      |f ρ - f (-ρ) - 2 * ρ * f1 0| ≤ 2 * ρ * E := by
    intro f f1 ρ E hρ hd hE
    have h := mvt (fun u => f u - u * f1 0) (fun u => f1 u - f1 0) (-ρ) ρ E (by linarith)
      (fun t ht => (hd t ht).sub (hasDerivAt_mul_const (f1 0))) hE
    have e1 : f ρ - f (-ρ) - 2 * ρ * f1 0 = (f ρ - ρ * f1 0) - (f (-ρ) - (-ρ) * f1 0) := by ring
    rw [e1]
    calc _ ≤ E * (ρ - -ρ) := h
      _ = 2 * ρ * E := by ring
  
  have cd2 : ∀ (g g1 g2 : ℝ → ℝ) (ρ E : ℝ), 0 < ρ →
      (∀ t ∈ Set.Icc (-ρ) ρ, HasDerivAt g (g1 t) t) →
      (∀ t ∈ Set.Icc (-ρ) ρ, HasDerivAt g1 (g2 t) t) →
      (∀ t ∈ Set.Icc (-ρ) ρ, |g2 t - g2 0| ≤ E) →
      |g ρ - g (-ρ) - 2 * ρ * g1 0| ≤ 2 * E * ρ ^ 2 := by
    intro g g1 g2 ρ E hρ hd hd1' hE
    have h0 : (0:ℝ) ∈ Set.Icc (-ρ) ρ := ⟨by linarith, hρ.le⟩
    have hE0 : 0 ≤ E := by
      have := hE 0 h0
      rwa [sub_self, abs_zero] at this
    have hb : ∀ u ∈ Set.Icc (0:ℝ) ρ, |g1 u - g1 0 - u * g2 0| ≤ E * u ∧
        |g1 (-u) - g1 0 + u * g2 0| ≤ E * u := by
      intro u hu
      have hsub : ∀ t ∈ Set.Icc 0 u, t ∈ Set.Icc (-ρ) ρ :=
        fun t ht => ⟨by linarith [ht.1], by linarith [ht.2, hu.2]⟩
      have hsub' : ∀ t ∈ Set.Icc (-u) 0, t ∈ Set.Icc (-ρ) ρ :=
        fun t ht => ⟨by linarith [ht.1, hu.2], by linarith [ht.2]⟩
      have k1 := mvt (fun t => g1 t - t * g2 0) (fun t => g2 t - g2 0) 0 u E hu.1
        (fun t ht => (hd1' t (hsub t ht)).sub (hasDerivAt_mul_const (g2 0)))
        (fun t ht => hE t (hsub t ht))
      have k2 := mvt (fun t => g1 t - t * g2 0) (fun t => g2 t - g2 0) (-u) 0 E
        (by linarith [hu.1])
        (fun t ht => (hd1' t (hsub' t ht)).sub (hasDerivAt_mul_const (g2 0)))
        (fun t ht => hE t (hsub' t ht))
      constructor
      · have e1 : g1 u - g1 0 - u * g2 0 = (g1 u - u * g2 0) - (g1 0 - 0 * g2 0) := by ring
        rw [e1]
        calc _ ≤ E * (u - 0) := k1
          _ = E * u := by ring
      · have e1 : g1 (-u) - g1 0 + u * g2 0
            = -((g1 0 - 0 * g2 0) - (g1 (-u) - (-u) * g2 0)) := by ring
        rw [e1, abs_neg]
        calc _ ≤ E * (0 - -u) := k2
          _ = E * u := by ring
    have hφ : ∀ u ∈ Set.Icc (0:ℝ) ρ, HasDerivAt (fun u => g u - g (-u) - u * (2 * g1 0))
        ((g1 u - g1 0 - u * g2 0) + (g1 (-u) - g1 0 + u * g2 0)) u := by
      intro u hu
      have hu1 : u ∈ Set.Icc (-ρ) ρ := ⟨by linarith [hu.1], hu.2⟩
      have hu2 : -u ∈ Set.Icc (-ρ) ρ := ⟨by linarith [hu.2], by linarith [hu.1]⟩
      have k1 : HasDerivAt (fun u => g (-u)) (g1 (-u) * (-1)) u :=
        (hd (-u) hu2).comp u (hasDerivAt_neg u)
      have k := ((hd u hu1).sub k1).sub (hasDerivAt_mul_const (2 * g1 0))
      exact k.congr_deriv (by ring)
    have hφb : ∀ u ∈ Set.Icc (0:ℝ) ρ,
        |(g1 u - g1 0 - u * g2 0) + (g1 (-u) - g1 0 + u * g2 0)| ≤ 2 * E * ρ := by
      intro u hu
      obtain ⟨b1, b2⟩ := hb u hu
      have : E * u ≤ E * ρ := mul_le_mul_of_nonneg_left hu.2 hE0
      calc _ ≤ |g1 u - g1 0 - u * g2 0| + |g1 (-u) - g1 0 + u * g2 0| := abs_add_le _ _
        _ ≤ 2 * E * ρ := by linarith
    have h := mvt (fun u => g u - g (-u) - u * (2 * g1 0))
      (fun u => (g1 u - g1 0 - u * g2 0) + (g1 (-u) - g1 0 + u * g2 0)) 0 ρ (2 * E * ρ) hρ.le
      hφ hφb
    have e1 : g ρ - g (-ρ) - 2 * ρ * g1 0
        = (g ρ - g (-ρ) - ρ * (2 * g1 0)) - (g 0 - g (-0) - 0 * (2 * g1 0)) := by
      rw [neg_zero]; ring
    rw [e1]
    calc _ ≤ 2 * E * ρ * (ρ - 0) := h
      _ = 2 * E * ρ ^ 2 := by ring
  
  have extract : ∀ (A B c ρ X Y : ℝ), 0 < ρ → |A| ≤ X → |B| ≤ X →
      |A - B - 2 * ρ * c| ≤ 2 * ρ * Y → |c| ≤ X / ρ + Y := by
    intro A B c ρ X Y hρ hA hB hc
    have k : |ρ * c| ≤ X + ρ * Y := by
      rw [abs_le] at hA hB hc ⊢
      obtain ⟨a1, a2⟩ := hA
      obtain ⟨b1, b2⟩ := hB
      obtain ⟨c1, c2⟩ := hc
      constructor <;> linarith
    rw [abs_mul, abs_of_pos hρ] at k
    rw [div_add' _ _ _ hρ.ne', le_div_iff₀ hρ]
    linarith
  
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = h / 2 := ⟨_, rfl⟩
  have hρ : 0 < ρ := by rw [hρdef]; linarith
  obtain ⟨q, hqdef⟩ : ∃ q : ℝ, q = ρ ^ (1 / 2 : ℝ) := ⟨_, rfl⟩
  have hnorm : ∀ (p : E3) (i : Fin 3) (τ : ℝ), ‖p + τ • e i‖ ≤ ‖p‖ + |τ| := by
    intro p i τ
    calc ‖p + τ • e i‖ ≤ ‖p‖ + ‖τ • e i‖ := norm_add_le _ _
      _ = ‖p‖ + |τ| := by rw [norm_smul, he, mul_one, Real.norm_eq_abs]
  have habs : ∀ τ ∈ Set.Icc (-ρ) ρ, |τ| ≤ ρ := fun τ hτ => abs_le.mpr hτ
  have hdist : ∀ (p : E3) (i : Fin 3) (τ : ℝ), τ ∈ Set.Icc (-ρ) ρ →
      ‖p + τ • e i - p‖ ^ (1 / 2 : ℝ) ≤ q := by
    intro p i τ hτ
    rw [add_sub_cancel_left, norm_smul, he, mul_one, Real.norm_eq_abs, hqdef]
    exact Real.rpow_le_rpow (abs_nonneg _) (habs τ hτ) (by norm_num)
  
  have grad : ∀ j : Fin 3, ∀ y : E3, ‖y‖ < m + ρ →
      |partialDeriv j w y| ≤ M₀ / ρ + H * q * ρ := by
    intro j y hy
    have hin : ∀ τ ∈ Set.Icc (-ρ) ρ, y + τ • e j ∈ Metric.ball (0 : E3) s := by
      intro τ hτ
      rw [mem_ball_zero_iff]
      have := hnorm y j τ
      have := habs τ hτ
      linarith
    have hy0 : y + (0:ℝ) • e j = y := by rw [zero_smul, add_zero]
    have hys : y ∈ Metric.ball (0:E3) s := by
      have := hin 0 ⟨by linarith, hρ.le⟩
      rwa [hy0] at this
    have h1 := cd2 (fun τ => w (y + τ • e j)) (fun τ => partialDeriv j w (y + τ • e j))
      (fun τ => partialDeriv j (fun z => partialDeriv j w z) (y + τ • e j)) ρ (H * q) hρ
      (fun t ht => hline w y j t (hdw _ (hin t ht)))
      (fun t ht => hline (fun z => partialDeriv j w z) y j t (hd1 j _ (hin t ht)))
      (fun t ht => by
        show |partialDeriv j (fun z => partialDeriv j w z) (y + t • e j)
          - partialDeriv j (fun z => partialDeriv j w z) (y + (0:ℝ) • e j)| ≤ H * q
        rw [hy0]
        calc _ ≤ H * ‖y + t • e j - y‖ ^ (1 / 2 : ℝ) := hH _ (hin t ht) _ hys j j
          _ ≤ H * q := mul_le_mul_of_nonneg_left (hdist y j t ht) hH0)
    exact extract (w (y + ρ • e j)) (w (y + (-ρ) • e j)) (partialDeriv j w y) ρ M₀ (H * q * ρ) hρ
      (hM _ (hin ρ ⟨by linarith, le_refl _⟩)) (hM _ (hin (-ρ) ⟨le_refl _, by linarith⟩))
      (by
        have e2 : partialDeriv j w y = partialDeriv j w (y + (0:ℝ) • e j) := by rw [hy0]
        rw [e2]
        calc _ ≤ 2 * (H * q) * ρ ^ 2 := h1
          _ = 2 * ρ * (H * q * ρ) := by ring)
  
  have hess : ∀ i j : Fin 3, ∀ x : E3, ‖x‖ < m →
      |partialDeriv i (fun z => partialDeriv j w z) x| ≤ (M₀ / ρ + H * q * ρ) / ρ + H * q := by
    intro i j x hx
    have hin : ∀ τ ∈ Set.Icc (-ρ) ρ, ‖x + τ • e i‖ < m + ρ := by
      intro τ hτ
      have := hnorm x i τ
      have := habs τ hτ
      linarith
    have hin' : ∀ τ ∈ Set.Icc (-ρ) ρ, x + τ • e i ∈ Metric.ball (0 : E3) s := by
      intro τ hτ
      rw [mem_ball_zero_iff]
      have := hin τ hτ
      linarith
    have hx0 : x + (0:ℝ) • e i = x := by rw [zero_smul, add_zero]
    have hxs : x ∈ Metric.ball (0:E3) s := by rw [mem_ball_zero_iff]; linarith
    have h1 := cd1 (fun τ => partialDeriv j w (x + τ • e i))
      (fun τ => partialDeriv i (fun z => partialDeriv j w z) (x + τ • e i)) ρ (H * q) hρ
      (fun t ht => hline (fun z => partialDeriv j w z) x i t (hd1 j _ (hin' t ht)))
      (fun t ht => by
        show |partialDeriv i (fun z => partialDeriv j w z) (x + t • e i)
          - partialDeriv i (fun z => partialDeriv j w z) (x + (0:ℝ) • e i)| ≤ H * q
        rw [hx0]
        calc _ ≤ H * ‖x + t • e i - x‖ ^ (1 / 2 : ℝ) := hH _ (hin' t ht) _ hxs i j
          _ ≤ H * q := mul_le_mul_of_nonneg_left (hdist x i t ht) hH0)
    exact extract (partialDeriv j w (x + ρ • e i)) (partialDeriv j w (x + (-ρ) • e i))
      (partialDeriv i (fun z => partialDeriv j w z) x) ρ (M₀ / ρ + H * q * ρ) (H * q) hρ
      (grad j _ (hin ρ ⟨by linarith, le_refl _⟩)) (grad j _ (hin (-ρ) ⟨le_refl _, by linarith⟩))
      (by
        have e2 : partialDeriv i (fun z => partialDeriv j w z) x
            = partialDeriv i (fun z => partialDeriv j w z) (x + (0:ℝ) • e i) := by rw [hx0]
        rw [e2]
        exact h1)
  
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = h ^ (1 / 2 : ℝ) := ⟨_, rfl⟩
  have hr : 0 < r := by rw [hrdef]; exact Real.rpow_pos_of_pos hh _
  have hr0 : r ≠ 0 := hr.ne'
  have hrr : h = r ^ 2 := by rw [hrdef, ← Real.sqrt_eq_rpow, Real.sq_sqrt hh.le]
  have h32 : h ^ (3 / 2 : ℝ) = r ^ 3 := by
    rw [hrdef, ← Real.rpow_natCast, ← Real.rpow_mul hh.le]; norm_num
  have hqr : q ≤ r := by
    rw [hqdef, hrdef]; exact Real.rpow_le_rpow hρ.le (by rw [hρdef]; linarith) (by norm_num)
  
  have holder : ∀ (f : E3 → ℝ) (B L : ℝ), 0 ≤ B → 0 ≤ L →
      (∀ x ∈ Metric.ball (0:E3) m, DifferentiableAt ℝ f x) →
      (∀ x ∈ Metric.ball (0:E3) m, |f x| ≤ B) →
      (∀ x ∈ Metric.ball (0:E3) m, ∀ k : Fin 3, |partialDeriv k f x| ≤ L) →
      ∀ x ∈ Metric.ball (0:E3) m, ∀ y ∈ Metric.ball (0:E3) m,
        |f x - f y| ≤ (2 * B / r + 3 * L * r) * ‖x - y‖ ^ (1 / 2 : ℝ) := by
    intro f B L hB hL hf hb hp x hx y hy
    have hlip : |f x - f y| ≤ 3 * L * ‖x - y‖ := by
      have hnorm : ∀ z ∈ Metric.ball (0:E3) m, ‖fderiv ℝ f z‖ ≤ 3 * L := by
        intro z hz
        refine ContinuousLinearMap.opNorm_le_bound _ (by linarith) ?_
        intro v
        have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
          ext i
          fin_cases i <;> simp [e, EuclideanSpace.single_apply]
        have hD : fderiv ℝ f z v = v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z
            + v 2 * partialDeriv 2 f z := by
          conv_lhs => rw [hv]
          simp only [map_add, map_smul, smul_eq_mul]
          rfl
        have h0 : |v 0| ≤ ‖v‖ := by
          have := PiLp.norm_apply_le v 0
          rwa [Real.norm_eq_abs] at this
        have h1 : |v 1| ≤ ‖v‖ := by
          have := PiLp.norm_apply_le v 1
          rwa [Real.norm_eq_abs] at this
        have h2 : |v 2| ≤ ‖v‖ := by
          have := PiLp.norm_apply_le v 2
          rwa [Real.norm_eq_abs] at this
        have m0 : |v 0 * partialDeriv 0 f z| ≤ ‖v‖ * L := by
          rw [abs_mul]; exact mul_le_mul h0 (hp z hz 0) (abs_nonneg _) (norm_nonneg _)
        have m1 : |v 1 * partialDeriv 1 f z| ≤ ‖v‖ * L := by
          rw [abs_mul]; exact mul_le_mul h1 (hp z hz 1) (abs_nonneg _) (norm_nonneg _)
        have m2 : |v 2 * partialDeriv 2 f z| ≤ ‖v‖ * L := by
          rw [abs_mul]; exact mul_le_mul h2 (hp z hz 2) (abs_nonneg _) (norm_nonneg _)
        rw [Real.norm_eq_abs, hD]
        calc |v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z + v 2 * partialDeriv 2 f z|
            ≤ |v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z| + |v 2 * partialDeriv 2 f z| :=
              abs_add_le _ _
          _ ≤ |v 0 * partialDeriv 0 f z| + |v 1 * partialDeriv 1 f z|
                + |v 2 * partialDeriv 2 f z| := by
              linarith [abs_add_le (v 0 * partialDeriv 0 f z) (v 1 * partialDeriv 1 f z)]
          _ ≤ 3 * L * ‖v‖ := by linarith
      have h := (convex_ball (0:E3) m).norm_image_sub_le_of_norm_fderiv_le hf hnorm hy hx
      rwa [Real.norm_eq_abs] at h
    obtain ⟨d, hd⟩ : ∃ d : ℝ, d = ‖x - y‖ := ⟨_, rfl⟩
    rw [← hd] at hlip ⊢
    have hd0 : 0 ≤ d := by rw [hd]; exact norm_nonneg _
    have hqq : d ^ (1 / 2 : ℝ) * d ^ (1 / 2 : ℝ) = d := by
      rw [← Real.sqrt_eq_rpow]; exact Real.mul_self_sqrt hd0
    have hq0 : 0 ≤ d ^ (1 / 2 : ℝ) := Real.rpow_nonneg hd0 _
    have hBr : 0 ≤ 2 * B / r := div_nonneg (by linarith) hr.le
    have hLr : 0 ≤ 3 * L * r := by have := mul_nonneg hL hr.le; linarith
    rcases le_or_gt h d with hhd | hhd
    · have hrq : r ≤ d ^ (1 / 2 : ℝ) := by
        rw [hrdef]; exact Real.rpow_le_rpow hh.le hhd (by norm_num)
      have k1 : |f x - f y| ≤ 2 * B := by
        have a1 := abs_le.mp (hb x hx)
        have a2 := abs_le.mp (hb y hy)
        rw [abs_le]
        constructor <;> linarith [a1.1, a1.2, a2.1, a2.2]
      have k2 : 2 * B / r * r = 2 * B := div_mul_cancel₀ _ hr0
      have k3 : 2 * B / r * r ≤ 2 * B / r * d ^ (1 / 2 : ℝ) := mul_le_mul_of_nonneg_left hrq hBr
      have k4 : 0 ≤ 3 * L * r * d ^ (1 / 2 : ℝ) := mul_nonneg hLr hq0
      rw [add_mul]
      linarith
    · have hrq : d ^ (1 / 2 : ℝ) ≤ r := by
        rw [hrdef]; exact Real.rpow_le_rpow hd0 hhd.le (by norm_num)
      have k1 : 3 * L * d = 3 * L * d ^ (1 / 2 : ℝ) * d ^ (1 / 2 : ℝ) := by
        rw [mul_assoc (3 * L), hqq]
      have k2 : 3 * L * d ^ (1 / 2 : ℝ) * d ^ (1 / 2 : ℝ) ≤ 3 * L * d ^ (1 / 2 : ℝ) * r :=
        mul_le_mul_of_nonneg_left hrq (mul_nonneg (by linarith) hq0)
      have k4 : 0 ≤ 2 * B / r * d ^ (1 / 2 : ℝ) := mul_nonneg hBr hq0
      rw [add_mul]
      linarith
  
  obtain ⟨P, hPdef⟩ : ∃ P : ℝ, P = M₀ / r ^ 4 := ⟨_, rfl⟩
  have hP : 0 ≤ P := by rw [hPdef]; exact div_nonneg hM0 (by positivity)
  have hM₀P : M₀ = P * r ^ 4 := by rw [hPdef]; exact (div_mul_cancel₀ _ (pow_ne_zero 4 hr0)).symm
  have hρr : ρ = r ^ 2 / 2 := by rw [hρdef, hrr]
  have f1 : M₀ / ρ + H * q * ρ = 2 * P * r ^ 2 + H * q * r ^ 2 / 2 := by
    rw [hM₀P, hρr]; field_simp <;> ring
  have f2 : (M₀ / ρ + H * q * ρ) / ρ + H * q = 4 * P + 2 * (H * q) := by
    rw [f1, hρr]; field_simp <;> ring
  have f3 : 2 * (M₀ / ρ + H * q * ρ) / r + 3 * ((M₀ / ρ + H * q * ρ) / ρ + H * q) * r
      = 16 * P * r + 7 * (H * q * r) := by
    rw [f2, f1]; field_simp <;> ring
  have f4 : 2 * M₀ / r + 3 * (M₀ / ρ + H * q * ρ) * r = 8 * P * r ^ 3 + 3 / 2 * (H * q * r ^ 3) := by
    rw [f1, hM₀P]; field_simp <;> ring
  have g1 : M₀ / (r ^ 2) ^ 2 = P := by rw [hPdef]; ring
  have g2 : M₀ / r ^ 2 = P * r ^ 2 := by rw [hM₀P, div_eq_iff (pow_ne_zero 2 hr0)]; ring
  have g3 : M₀ / r ^ 3 = P * r := by rw [hM₀P, div_eq_iff (pow_ne_zero 3 hr0)]; ring
  have g4 : M₀ / r = P * r ^ 3 := by rw [hM₀P, div_eq_iff hr0]; ring
  have hHq : H * q ≤ H * r := mul_le_mul_of_nonneg_left hqr hH0
  have hW1 : 0 ≤ M₀ / ρ + H * q * ρ :=
    le_trans (abs_nonneg _) (grad 0 0 (by rw [norm_zero]; linarith))
  have hW2 : 0 ≤ (M₀ / ρ + H * q * ρ) / ρ + H * q :=
    le_trans (abs_nonneg _) (hess 0 0 0 (by rw [norm_zero]; linarith))
  have hms : Metric.ball (0 : E3) m ⊆ Metric.ball 0 s := Metric.ball_subset_ball (by linarith)
  
  intro x hx y hy i j
  have hxn : ‖x‖ < m := mem_ball_zero_iff.mp hx
  have hxn' : ‖x‖ < m + ρ := by linarith
  rw [← hrdef, h32, hrr, g1, g2, g3, g4]
  have hrH : 0 ≤ r * H := mul_nonneg hr.le hH0
  refine ⟨?_, ?_, ?_, ?_⟩
  · have hb := hess i j x hxn
    rw [f2] at hb
    linarith
  · have hb := grad i x hxn'
    rw [f1] at hb
    have a1 : H * q * r ^ 2 ≤ H * r * r ^ 2 := mul_le_mul_of_nonneg_right hHq (by positivity)
    have a2 : 0 ≤ P * r ^ 2 := by positivity
    have a3 : 0 ≤ r ^ 3 * H := mul_nonneg (by positivity) hH0
    nlinarith
  · have kk := holder (fun z => partialDeriv i w z) _ _ hW1 hW2
      (fun p hp => hd1 i p (hms hp))
      (fun p hp => grad i p (by have := mem_ball_zero_iff.mp hp; linarith))
      (fun p hp l => hess l i p (mem_ball_zero_iff.mp hp)) x hx y hy
    rw [f3] at kk
    refine le_trans kk ?_
    have a1 : H * q * r ≤ H * r * r := mul_le_mul_of_nonneg_right hHq hr.le
    have a2 : 0 ≤ P * r := by positivity
    have a3 : 0 ≤ r ^ 2 * H := mul_nonneg (by positivity) hH0
    exact mul_le_mul_of_nonneg_right (by nlinarith) (Real.rpow_nonneg (norm_nonneg _) _)
  · have kk := holder w _ _ hM0 hW1
      (fun p hp => hdw p (hms hp))
      (fun p hp => hM p (hms hp))
      (fun p hp l => grad l p (by have := mem_ball_zero_iff.mp hp; linarith)) x hx y hy
    rw [f4] at kk
    refine le_trans kk ?_
    have a1 : H * q * r ^ 3 ≤ H * r * r ^ 3 := mul_le_mul_of_nonneg_right hHq (by positivity)
    have a2 : 0 ≤ P * r ^ 3 := by positivity
    have a3 : 0 ≤ (r ^ 2) ^ 2 * H := mul_nonneg (by positivity) hH0
    exact mul_le_mul_of_nonneg_right (by nlinarith) (Real.rpow_nonneg (norm_nonneg _) _)

theorem lip_of_partials (f : E3 → ℝ) (S : Set E3) (hconv : Convex ℝ S) (L : ℝ)
    (hf : ∀ x ∈ S, DifferentiableAt ℝ f x) (hb : ∀ x ∈ S, ∀ k : Fin 3, |partialDeriv k f x| ≤ L) :
    ∀ x ∈ S, ∀ y ∈ S, |f x - f y| ≤ 3 * L * ‖x - y‖ :=
by
  intro x hx y hy
  have hL : 0 ≤ L := le_trans (abs_nonneg _) (hb x hx 0)
  have hnorm : ∀ z ∈ S, ‖fderiv ℝ f z‖ ≤ 3 * L := by
    intro z hz
    refine ContinuousLinearMap.opNorm_le_bound _ (by linarith) ?_
    intro v
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext i
      fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    have hD : fderiv ℝ f z v = v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z
        + v 2 * partialDeriv 2 f z := by
      conv_lhs => rw [hv]
      simp only [map_add, map_smul, smul_eq_mul]
      rfl
    have h0 : |v 0| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 0
      rwa [Real.norm_eq_abs] at this
    have h1 : |v 1| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 1
      rwa [Real.norm_eq_abs] at this
    have h2 : |v 2| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 2
      rwa [Real.norm_eq_abs] at this
    have b0 := hb z hz 0
    have b1 := hb z hz 1
    have b2 := hb z hz 2
    have m0 : |v 0 * partialDeriv 0 f z| ≤ ‖v‖ * L := by
      rw [abs_mul]; exact mul_le_mul h0 b0 (abs_nonneg _) (norm_nonneg _)
    have m1 : |v 1 * partialDeriv 1 f z| ≤ ‖v‖ * L := by
      rw [abs_mul]; exact mul_le_mul h1 b1 (abs_nonneg _) (norm_nonneg _)
    have m2 : |v 2 * partialDeriv 2 f z| ≤ ‖v‖ * L := by
      rw [abs_mul]; exact mul_le_mul h2 b2 (abs_nonneg _) (norm_nonneg _)
    rw [Real.norm_eq_abs, hD]
    calc |v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z + v 2 * partialDeriv 2 f z|
        ≤ |v 0 * partialDeriv 0 f z + v 1 * partialDeriv 1 f z| + |v 2 * partialDeriv 2 f z| :=
          abs_add_le _ _
      _ ≤ |v 0 * partialDeriv 0 f z| + |v 1 * partialDeriv 1 f z| + |v 2 * partialDeriv 2 f z| := by
          linarith [abs_add_le (v 0 * partialDeriv 0 f z) (v 1 * partialDeriv 1 f z)]
      _ ≤ 3 * L * ‖v‖ := by linarith
  have h := hconv.norm_image_sub_le_of_norm_fderiv_le hf hnorm hy hx
  rwa [Real.norm_eq_abs] at h

theorem radial_cutoff_holder : ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ t δ : ℝ, 0 ≤ t → 0 < δ → δ ≤ 1 →
    ∃ η : E3 → ℝ, ContDiff ℝ ∞ η ∧
      (∀ x : E3, ‖x‖ ≤ t → η x = 1) ∧
      (∀ x : E3, t + δ ^ 2 / 4 < ‖x‖ → η x = 0 ∧ (∀ k : Fin 3, partialDeriv k η x = 0) ∧
        ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k η z) x = 0) ∧
      (∀ x : E3, |η x| ≤ 1) ∧
      (∀ x y : E3, |η x - η y| ≤ Λ / δ * ‖x - y‖ ^ (1 / 2 : ℝ)) ∧
      (∀ (k : Fin 3) (x : E3), |partialDeriv k η x| ≤ Λ / δ ^ 2) ∧
      (∀ (k : Fin 3) (x y : E3), |partialDeriv k η x - partialDeriv k η y|
        ≤ Λ / δ ^ 3 * ‖x - y‖ ^ (1 / 2 : ℝ)) ∧
      (∀ x : E3, |∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k η z) x| ≤ Λ / δ ^ 4) ∧
      (∀ x y : E3, |∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k η z) x
        - ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k η z) y| ≤ Λ / δ ^ 5 * ‖x - y‖ ^ (1 / 2 : ℝ)) :=
by
  
  have habs : ∀ a b A B : ℝ, |a| ≤ A → |b| ≤ B → |a * b| ≤ A * B := by
    intro a b A B ha hb
    rw [abs_mul]; exact mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)
  have hloc0 : ∀ (f : ℝ → ℝ) (c : ℝ), (∀ y, y < 0 → f y = c) → ∀ y, y < 0 → deriv f y = 0 := by
    intro f c hf y hy
    have hev : f =ᶠ[𝓝 y] fun _ => c := by
      filter_upwards [Iio_mem_nhds hy] with z hz using hf z hz
    rw [hev.deriv_eq]; simp
  have hloc1 : ∀ (f : ℝ → ℝ) (c : ℝ), (∀ y, 1 < y → f y = c) → ∀ y, 1 < y → deriv f y = 0 := by
    intro f c hf y hy
    have hev : f =ᶠ[𝓝 y] fun _ => c := by
      filter_upwards [Ioi_mem_nhds hy] with z hz using hf z hz
    rw [hev.deriv_eq]; simp
  have hbd : ∀ f : ℝ → ℝ, Continuous f → (∀ y, y < 0 → f y = 0) → (∀ y, 1 < y → f y = 0) →
      ∃ C, 0 ≤ C ∧ ∀ y, |f y| ≤ C := by
    intro f hf h0 h1
    obtain ⟨C, hC⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
      hf.continuousOn
    refine ⟨max C 0, le_max_right _ _, fun y => ?_⟩
    rcases lt_or_ge y 0 with hy | hy
    · rw [h0 y hy, abs_zero]; exact le_max_right _ _
    rcases lt_or_ge 1 y with hy' | hy'
    · rw [h1 y hy', abs_zero]; exact le_max_right _ _
    · have := hC y ⟨hy, hy'⟩
      rw [Real.norm_eq_abs] at this
      exact this.trans (le_max_left _ _)
  
  have hφs : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  obtain ⟨hφd, hφ1s⟩ := contDiff_infty_iff_deriv.mp hφs
  obtain ⟨hφ1d, hφ2s⟩ := contDiff_infty_iff_deriv.mp hφ1s
  obtain ⟨hφ2d, hφ3s⟩ := contDiff_infty_iff_deriv.mp hφ2s
  have z0 : ∀ y : ℝ, y < 0 → Real.smoothTransition y = 0 :=
    fun y hy => Real.smoothTransition.zero_of_nonpos hy.le
  have o1 : ∀ y : ℝ, 1 < y → Real.smoothTransition y = 1 :=
    fun y hy => Real.smoothTransition.one_of_one_le hy.le
  have z10 := hloc0 _ 0 z0
  have z11 := hloc1 _ 1 o1
  have z20 := hloc0 _ 0 z10
  have z21 := hloc1 _ 0 z11
  have z30 := hloc0 _ 0 z20
  have z31 := hloc1 _ 0 z21
  obtain ⟨C1, hC1, hb1⟩ := hbd _ hφ1s.continuous z10 z11
  obtain ⟨C2, hC2, hb2⟩ := hbd _ hφ2s.continuous z20 z21
  obtain ⟨C3, hC3, hb3⟩ := hbd _ hφ3s.continuous z30 z31
  obtain ⟨Φ, hΦ0, hΦ1, hΦ2, hΦ3⟩ : ∃ Φ : ℝ, 0 ≤ Φ ∧ (∀ y, |deriv Real.smoothTransition y| ≤ Φ) ∧
      (∀ y, |deriv (deriv Real.smoothTransition) y| ≤ Φ) ∧
      (∀ y, |deriv (deriv (deriv Real.smoothTransition)) y| ≤ Φ) :=
    ⟨C1 + C2 + C3, by linarith, fun y => by linarith [hb1 y], fun y => by linarith [hb2 y],
      fun y => by linarith [hb3 y]⟩
  have hφD : ∀ y, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition y) y :=
    fun y => (hφd y).hasDerivAt
  have hφ1D : ∀ y, HasDerivAt (deriv Real.smoothTransition)
      (deriv (deriv Real.smoothTransition) y) y := fun y => (hφ1d y).hasDerivAt
  have hφ2D : ∀ y, HasDerivAt (deriv (deriv Real.smoothTransition))
      (deriv (deriv (deriv Real.smoothTransition)) y) y := fun y => (hφ2d y).hasDerivAt
  
  have hproj : ∀ (k : Fin 3) (w : E3), (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) w = w k :=
    fun k w => rfl
  have hsingle : ∀ k l : Fin 3, (e l) k = if l = k then (1 : ℝ) else 0 := by
    intro k l
    show (EuclideanSpace.single l (1 : ℝ)) k = _
    rw [EuclideanSpace.single_apply]
    by_cases h : l = k
    · subst h; simp
    · simp [h, Ne.symm h]
  have hcoord : ∀ (x : E3) (k : Fin 3), (innerSL ℝ x) (e k) = x k := by
    intro x k
    rw [innerSL_apply_apply]
    show inner ℝ x (EuclideanSpace.single k (1 : ℝ)) = _
    rw [EuclideanSpace.inner_single_right]
    simp
  have hcoordle : ∀ (x : E3) (k : Fin 3), |x k| ≤ ‖x‖ := by
    intro x k
    have := PiLp.norm_apply_le x k
    rwa [Real.norm_eq_abs] at this
  have hsum3 : ∀ x : E3, x 0 * x 0 + x 1 * x 1 + x 2 * x 2 = ‖x‖ ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp only [Real.norm_eq_abs, sq_abs]
    ring
  have hcD : ∀ (k : Fin 3) (x : E3),
      HasFDerivAt (fun z : E3 => z k) (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) x :=
    fun k x => (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt
  have hH1 : ∀ (h h' : ℝ → ℝ), (∀ s, HasDerivAt h (h' s) s) → ∀ x : E3,
      HasFDerivAt (fun z : E3 => h (‖z‖ ^ 2)) (h' (‖x‖ ^ 2) • (2 • innerSL ℝ x)) x := by
    intro h h' hh x
    exact (hh (‖x‖ ^ 2)).comp_hasFDerivAt x (hasStrictFDerivAt_norm_sq x).hasFDerivAt
  have hP1 : ∀ (h h' : ℝ → ℝ), (∀ s, HasDerivAt h (h' s) s) → ∀ k : Fin 3,
      partialDeriv k (fun z : E3 => h (‖z‖ ^ 2)) = fun z => 2 * z k * h' (‖z‖ ^ 2) := by
    intro h h' hh k
    funext x
    unfold partialDeriv
    rw [(hH1 h h' hh x).fderiv]
    simp only [ContinuousLinearMap.smul_apply, hcoord, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat]
    ring
  have hH2 : ∀ (k l : Fin 3) (G : E3 → ℝ) (x : E3), DifferentiableAt ℝ G x →
      partialDeriv l (fun z => 2 * z k * G z) x
        = 2 * ((if l = k then (1 : ℝ) else 0) * G x + x k * partialDeriv l G x) := by
    intro k l G x hG
    have h3 : HasFDerivAt (fun z => 2 * z k * G z)
        ((2 * x k) • fderiv ℝ G x + G x • ((2 : ℝ) • (EuclideanSpace.proj k : E3 →L[ℝ] ℝ))) x :=
      ((hcD k x).const_mul 2).mul hG.hasFDerivAt
    unfold partialDeriv
    rw [h3.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hproj, hsingle]
    ring
  have hlip : ∀ (f : E3 → ℝ) (L : ℝ), Differentiable ℝ f →
      (∀ x (k : Fin 3), |partialDeriv k f x| ≤ L) → ∀ x y, |f x - f y| ≤ 3 * L * ‖x - y‖ := by
    intro f L hf hb x y
    have hL : 0 ≤ L := (abs_nonneg _).trans (hb x 0)
    have hn : ∀ z, ‖fderiv ℝ f z‖ ≤ 3 * L := by
      intro z
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun w => ?_)
      have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
        ext i; fin_cases i <;> simp [e, EuclideanSpace.single_apply]
      have hexp : fderiv ℝ f z w = w 0 * partialDeriv 0 f z + w 1 * partialDeriv 1 f z
          + w 2 * partialDeriv 2 f z := by
        conv_lhs => rw [hw]
        simp only [partialDeriv, map_add, map_smul, smul_eq_mul]
      rw [Real.norm_eq_abs, hexp]
      calc |w 0 * partialDeriv 0 f z + w 1 * partialDeriv 1 f z + w 2 * partialDeriv 2 f z|
          ≤ |w 0 * partialDeriv 0 f z| + |w 1 * partialDeriv 1 f z|
              + |w 2 * partialDeriv 2 f z| :=
            (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
        _ ≤ ‖w‖ * L + ‖w‖ * L + ‖w‖ * L :=
            add_le_add (add_le_add (habs _ _ _ _ (hcoordle w 0) (hb z 0))
              (habs _ _ _ _ (hcoordle w 1) (hb z 1))) (habs _ _ _ _ (hcoordle w 2) (hb z 2))
        _ = 3 * L * ‖w‖ := by ring
    have := convex_univ.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hf z) (fun z _ => hn z)
      (Set.mem_univ y) (Set.mem_univ x)
    rwa [Real.norm_eq_abs] at this
  have hhol : ∀ (f : E3 → ℝ) (B L P : ℝ), 0 ≤ P → (∀ x, |f x| ≤ B) →
      (∀ x y, |f x - f y| ≤ L * ‖x - y‖) → 2 * B * L ≤ P ^ 2 →
      ∀ x y, |f x - f y| ≤ P * ‖x - y‖ ^ (1 / 2 : ℝ) := by
    intro f B L P hP hB hL hBLP x y
    rw [← Real.sqrt_eq_rpow]
    have hu0 : 0 ≤ |f x - f y| := abs_nonneg _
    have hu1 : |f x - f y| ≤ 2 * B := by
      have : |f x - f y| ≤ |f x| + |f y| := by
        calc |f x - f y| = |f x + (-f y)| := by rw [sub_eq_add_neg]
          _ ≤ |f x| + |-f y| := abs_add_le _ _
          _ = |f x| + |f y| := by rw [abs_neg]
      linarith [hB x, hB y]
    have hu2 := hL x y
    have hd := norm_nonneg (x - y)
    have hs := Real.sqrt_nonneg ‖x - y‖
    have hss := Real.sq_sqrt hd
    have hB0 : 0 ≤ 2 * B := hu0.trans hu1
    have key : |f x - f y| ^ 2 ≤ (P * Real.sqrt ‖x - y‖) ^ 2 := by
      rw [mul_pow, hss]
      nlinarith [mul_le_mul hu1 hu2 hu0 hB0, mul_le_mul_of_nonneg_right hBLP hd]
    have := abs_le_of_sq_le_sq key (mul_nonneg hP hs)
    rwa [abs_abs] at this
  
  obtain ⟨Λ, hΛ⟩ : ∃ Λ : ℝ, Λ = 2000 * (Φ + 1) := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ := by rw [hΛ]; linarith
  refine ⟨Λ, hΛ0, ?_⟩
  intro t δ ht hδ _
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = t + δ ^ 2 / 4 := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ D : ℝ, D = δ ^ 2 / 4 * (2 * t + δ ^ 2 / 4) := ⟨_, rfl⟩
  obtain ⟨v, hv⟩ : ∃ v : ℝ, v = 1 / D := ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = 1 / δ ^ 2 := ⟨_, rfl⟩
  have hδ2 : 0 < δ ^ 2 := by positivity
  have hD0 : 0 < D := by
    rw [hD]; exact mul_pos (by positivity) (by linarith)
  have hρ0 : 0 ≤ ρ := by rw [hρ]; linarith
  have hv0 : 0 < v := by rw [hv]; positivity
  have hW0 : 0 < W := by rw [hW]; positivity
  have hDv : D * v = 1 := by rw [hv]; field_simp
  have hρt : ρ ^ 2 - t ^ 2 = D := by rw [hρ, hD]; ring
  have hu : ρ * v ≤ 4 * W := by
    rw [hv, hW, mul_one_div, mul_one_div, div_le_div_iff₀ hD0 hδ2, hρ, hD]
    nlinarith [mul_nonneg ht hδ2.le]
  have hvW : v ≤ 16 * W ^ 2 := by
    rw [hv, hW, div_pow, one_pow, mul_one_div, div_le_div_iff₀ hD0 (by positivity), hD]
    nlinarith [mul_nonneg ht hδ2.le]
  
