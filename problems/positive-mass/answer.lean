  have heq := tendsto_nhds_unique (hlimB.add_const (L ⟨φ, hφV⟩)) (hUel ⟨φ, hφV⟩)
  rw [hLφ] at heq
  have hI2 : ∀ a b : Fin 3, Integrable
      (fun x => Real.sqrt (g.coeff (A.κ j) x).det * (g.coeff (A.κ j) x)⁻¹ a b *
