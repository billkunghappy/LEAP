          rcases hQQ with ⟨h1', h2'⟩ | ⟨h1', h2'⟩
          · right; rw [h2']; exact hzp
          · left; rw [h1']; exact hzp
      rcases hmem with h | h
      · exact hzS (Set.mem_union_left _ (T1 Q₁ hQ₁o hQ₁t hQ₁ z h))
      · exact hzS (Set.mem_union_right _ (T0 Q₂ hQ₂o hQ₂t hQ₂ z h))
    · intro hzg
      rw [Set.mem_compl_iff, Set.mem_union]
      rintro (hE | hE')
      · obtain ⟨Nz, hNz, hNz0⟩ := T2 z hzt hE
        exact hmeasQ Nz Q₂ z hNz hQ₂o (hnear₂ z hz hzg) hNz0 hQ₂
      · obtain ⟨Nz, hNz, hNz0⟩ := T2' z hzt hE'
        exact hmeasQ' Nz Q₁ z hNz hQ₁o (hnear₁ z hz hzg) hNz0 hQ₁
  
  exact ⟨E, E', hEo, hE'o, hdisj, hAE, hBE', hScpt, hSmin⟩

theorem minimal_set_separates_ends [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k l : Fin hAF.numEnds) (hkl : k ≠ l) :
    ∃ (S : Set M) (R : ℝ), IsCompact S ∧ IsMinimalSurfaceSet g S ∧
      ∀ C : Set M, IsPreconnected C → Disjoint C S →
        ¬ ((C ∩ (hAF.ends k).Φ '' {y : E3 | R < ‖y‖}).Nonempty ∧
          (C ∩ (hAF.ends l).Φ '' {y : E3 | R < ‖y‖}).Nonempty) :=
by
  
  obtain ⟨ρ, a, c, ha2, hρs, hρeq, hc, hcpt⟩ := radial_exhaustion_exists g hAF
  have hq0 : 0 < hAF.q := lt_trans (by norm_num) hAF.q_gt
  
  have hbar : ∀ m : Fin hAF.numEnds, ∃ Rb : ℝ, ∀ y : E3, Rb < ‖y‖ →
      0 < levelMeanCurvCoord (g.coeff (hAF.ends m).Φ) (fun z => ‖z‖) y := by
    intro m
    have hsrc : (hAF.ends m).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends m).source_eq
    have hsmooth : ∀ i j : Fin 3,
        ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends m).Φ x i j) {x : E3 | 1 < ‖x‖} := by
      intro i j
      rw [← hsrc]
      exact coeff_contDiffOn_source g (hAF.ends m).Φ i j
    obtain ⟨Rm, Cm, hR1, hC0, hb⟩ :=
      metric_coeff_bounds (g.coeff (hAF.ends m).Φ) hAF.q hq0 hsmooth (hAF.decay m)
    have hdec : Dec1 (g.coeff (hAF.ends m).Φ) hAF.q Rm Cm := by
      intro x hx i j
      obtain ⟨_, hrest⟩ := hb x hx
      refine ⟨(hrest i j 0).1, fun l' => ?_⟩
      have h1 := (hrest i j l').2.1
      calc |partialDeriv l' (fun y => g.coeff (hAF.ends m).Φ y i j) x|
          = ‖fderiv ℝ (fun y => g.coeff (hAF.ends m).Φ y i j) x (e l')‖ := by
            rw [Real.norm_eq_abs]; rfl
        _ ≤ ‖fderiv ℝ (fun y => g.coeff (hAF.ends m).Φ y i j) x‖ * ‖e l'‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ (fun y => g.coeff (hAF.ends m).Φ y i j) x‖ := by
            simp [EuclideanSpace.norm_single]
        _ ≤ _ := h1
    obtain ⟨Rb, -, hRb⟩ := coordSphere_levelMeanCurvCoord_pos (g.coeff (hAF.ends m).Φ) hAF.q
      Rm Cm hq0 hR1 hC0 (fun x hx => (hb x hx).1) hdec
    exact ⟨Rb, hRb⟩
  choose Rb hRb using hbar
  obtain ⟨Rs, hRs⟩ := Finite.exists_le Rb
  set r₁ : ℝ := max (max a c) Rs + 1 with hr₁
  have har : a < r₁ := by
    have := le_max_left a c
    have := le_max_left (max a c) Rs
    linarith
  have hcr : c < r₁ := by
    have := le_max_right a c
    have := le_max_left (max a c) Rs
    linarith
  have hRbr : ∀ m, Rb m < r₁ := by
    intro m
    have := hRs m
    have := le_max_right (max a c) Rs
    linarith
  
  have hsub : ∀ (m : Fin hAF.numEnds) (r : ℝ), 1 ≤ r →
      {y : E3 | r < ‖y‖} ⊆ (hAF.ends m).Φ.source := by
    intro m r hr y hy
    rw [(hAF.ends m).source_eq]
    show (1 : ℝ) < ‖y‖
    have : r < ‖y‖ := hy
    linarith
  have hopen : ∀ (m : Fin hAF.numEnds) (r : ℝ), 1 ≤ r →
      IsOpen ((hAF.ends m).Φ '' {y : E3 | r < ‖y‖}) := by
    intro m r hr
    exact (hAF.ends m).Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
      (isOpen_lt continuous_const continuous_norm) (hsub m r hr)
  have htgt : ∀ (m : Fin hAF.numEnds) (y : E3), 1 < ‖y‖ →
      (hAF.ends m).Φ y ∈ (hAF.ends m).Φ.target := by
    intro m y hy
    have hy' : y ∈ (hAF.ends m).Φ.source := by
      rw [(hAF.ends m).source_eq]; exact hy
    exact (hAF.ends m).Φ.toOpenPartialHomeomorph.map_source hy'
  have hne : ∀ m m' : Fin hAF.numEnds, m ≠ m' → ∀ y z : E3, 1 < ‖y‖ → 1 < ‖z‖ →
      (hAF.ends m).Φ y ≠ (hAF.ends m').Φ z := by
    intro m m' hmm' y z hy hz heq
    have h1 := htgt m y hy
    have h2 := htgt m' z hz
    rw [heq] at h1
    exact Set.disjoint_left.1 (hAF.disjoint hmm') h1 h2
  
  have hD1 : ∀ p : M, r₁ ≤ ρ p →
      ∃ (m : Fin hAF.numEnds) (y : E3), a < ‖y‖ ∧ (hAF.ends m).Φ y = p := by
    intro p hp
    by_contra hcon
    push_neg at hcon
    have := hc p hcon
    linarith
  
  have hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p := by
    intro p hp
    obtain ⟨m, y, hay, rfl⟩ := hD1 p hp
    have hy : ρ ((hAF.ends m).Φ y) = ‖y‖ := hρeq m y hay
    have hy1 : (1 : ℝ) < ‖y‖ := by linarith
    have hfh : ∀ᶠ z in 𝓝 y, ρ ((hAF.ends m).Φ z) = ‖z‖ :=
      Filter.eventually_of_mem ((isOpen_lt continuous_const continuous_norm).mem_nhds hay)
        (fun z hz => hρeq m z hz)
    have hysrc : y ∈ (hAF.ends m).Φ.source := by
      rw [(hAF.ends m).source_eq]; exact hy1
    rw [levelMeanCurv_eq_coord g (hAF.ends m).Φ ρ (fun z => ‖z‖) hρs y hysrc hfh]
    apply hRb m y
    have := hRbr m
    linarith
  
  have hAsub : (hAF.ends l).Φ '' {y : E3 | r₁ < ‖y‖} ⊆ {p : M | r₁ < ρ p} := by
    rintro _ ⟨y, hy, rfl⟩
    have hy' : r₁ < ‖y‖ := hy
    show r₁ < ρ _
    rw [hρeq l y (by linarith)]
    exact hy'
  have hAo : IsOpen ((hAF.ends l).Φ '' {y : E3 | r₁ < ‖y‖}) := hopen l r₁ (by linarith)
  have hBo : IsOpen ({p : M | r₁ < ρ p} \ (hAF.ends l).Φ '' {y : E3 | r₁ < ‖y‖}) := by
    rw [isOpen_iff_forall_mem_open]
    rintro p ⟨hp, hpA⟩
    have hp' : r₁ < ρ p := hp
    obtain ⟨m, y, hay, rfl⟩ := hD1 p (le_of_lt hp')
    have hyr : r₁ < ‖y‖ := by
      rw [hρeq m y hay] at hp'
      exact hp'
    by_cases hml : m = l
    · subst hml
      exact absurd ⟨y, hyr, rfl⟩ hpA
    · refine ⟨(hAF.ends m).Φ '' {z : E3 | r₁ < ‖z‖}, ?_, hopen m r₁ (by linarith),
        ⟨y, hyr, rfl⟩⟩
      rintro _ ⟨z, hz, rfl⟩
      have hz' : r₁ < ‖z‖ := hz
      refine ⟨?_, ?_⟩
      · show r₁ < ρ _
        rw [hρeq m z (by linarith)]
        exact hz'
      · rintro ⟨z', hz'', heq⟩
        have hz''' : r₁ < ‖z'‖ := hz''
        exact hne m l hml z z' (by linarith) (by linarith) heq.symm
  
  obtain ⟨E, E', hEo, hE'o, hdisj, hAE, hBE', hScpt, hSmin⟩ :=
    separating_minimal_surface_of_mean_convex_exhaustion g ρ r₁
      ((hAF.ends l).Φ '' {y : E3 | r₁ < ‖y‖}) hρs hcpt hmc hAsub hAo hBo
  refine ⟨(E ∪ E')ᶜ, r₁, hScpt, hSmin, ?_⟩
  
  rintro C hC hCS ⟨⟨x, hxC, hxk⟩, ⟨z, hzC, hzl⟩⟩
  have hCsub : C ⊆ E ∪ E' := by
    intro w hw
    by_contra hw'
    exact Set.disjoint_left.1 hCS hw hw'
  obtain ⟨y, hy, rfl⟩ := hxk
  have hy' : r₁ < ‖y‖ := hy
  have hxE' : (hAF.ends k).Φ y ∈ E' := by
    apply hBE'
    refine ⟨?_, ?_⟩
    · show r₁ < ρ _
      rw [hρeq k y (by linarith)]
      exact hy'
    · rintro ⟨z', hz', heq⟩
      have hz'' : r₁ < ‖z'‖ := hz'
      exact hne k l hkl y z' (by linarith) (by linarith) heq.symm
  have hzE : z ∈ E := hAE hzl
  rcases hC.subset_or_subset hEo hE'o hdisj hCsub with h | h
  · exact Set.disjoint_left.1 hdisj (h hxC) hxE'
  · exact Set.disjoint_left.1 hdisj hzE (h hzC)

theorem homeomorph_of_tau_flow (X : Set M) (τ : M → ℝ) (a b m : ℝ) (ham : a < m) (hmb : m < b)
    (hτc : ContinuousOn τ X) (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b) (Θ : M → ℝ → M)
    (hΘX : ∀ x ∈ X, ∀ s : ℝ, a < τ x + s → τ x + s < b → Θ x s ∈ X ∧ τ (Θ x s) = τ x + s)
    (hΘ0 : ∀ x ∈ X, Θ x 0 = x)
    (hΘadd : ∀ x ∈ X, ∀ s s' : ℝ, a < τ x + s → τ x + s < b → a < τ x + s + s' →
      τ x + s + s' < b → Θ (Θ x s) s' = Θ x (s + s'))
    (hΘc : ContinuousOn (fun p : M × ℝ => Θ p.1 p.2)
      {p : M × ℝ | p.1 ∈ X ∧ a < τ p.1 + p.2 ∧ τ p.1 + p.2 < b}) :
    Nonempty (↥X ≃ₜ ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b)) :=
by
  have hF1 : ∀ x ∈ X, Θ x (m - τ x) ∈ X ∧ τ (Θ x (m - τ x)) = m := by
    intro x hx
    have h := hΘX x hx (m - τ x) (by linarith) (by linarith)
    exact ⟨h.1, by rw [h.2]; ring⟩
  have hG1 : ∀ y ∈ X, τ y = m → ∀ t : ℝ, a < t → t < b →
      Θ y (t - m) ∈ X ∧ τ (Θ y (t - m)) = t := by
    intro y hy hym t ht1 ht2
    have h := hΘX y hy (t - m) (by rw [hym]; linarith) (by rw [hym]; linarith)
    exact ⟨h.1, by rw [h.2, hym]; ring⟩
  let F : ↥X → ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b) := fun x =>
    (⟨Θ x.1 (m - τ x.1), (hF1 x.1 x.2).1, (hF1 x.1 x.2).2⟩, ⟨τ x.1, hτb x.1 x.2⟩)
  let G : ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b) → ↥X := fun p =>
    ⟨Θ p.1.1 (p.2.1 - m), (hG1 p.1.1 p.1.2.1 p.1.2.2 p.2.1 p.2.2.1 p.2.2.2).1⟩
  have hleft : ∀ x : ↥X, G (F x) = x := by
    intro x
    apply Subtype.ext
    show Θ (Θ x.1 (m - τ x.1)) (τ x.1 - m) = x.1
    have hb := hτb x.1 x.2
    rw [hΘadd x.1 x.2 (m - τ x.1) (τ x.1 - m) (by linarith) (by linarith) (by linarith)
      (by linarith)]
    rw [show m - τ x.1 + (τ x.1 - m) = 0 by ring]
    exact hΘ0 x.1 x.2
  have hright : ∀ p : ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b), F (G p) = p := by
    rintro ⟨⟨y, hyX, hym⟩, ⟨t, ht1, ht2⟩⟩
    have hym' : τ y = m := hym
    have hz := hG1 y hyX hym' t ht1 ht2
    apply Prod.ext
    · apply Subtype.ext
      show Θ (Θ y (t - m)) (m - τ (Θ y (t - m))) = y
      rw [hz.2]
      rw [hΘadd y hyX (t - m) (m - t) (by linarith) (by linarith) (by linarith) (by linarith)]
      rw [show t - m + (m - t) = 0 by ring]
      exact hΘ0 y hyX
    · apply Subtype.ext
      show τ (Θ y (t - m)) = t
      exact hz.2
  have hS : ∀ x : ↥X, (x.1, m - τ x.1) ∈
      {p : M × ℝ | p.1 ∈ X ∧ a < τ p.1 + p.2 ∧ τ p.1 + p.2 < b} := by
    intro x
    refine ⟨x.2, ?_, ?_⟩
    · show a < τ x.1 + (m - τ x.1)
      linarith
    · show τ x.1 + (m - τ x.1) < b
      linarith
  have hS' : ∀ p : ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b), (p.1.1, p.2.1 - m) ∈
      {q : M × ℝ | q.1 ∈ X ∧ a < τ q.1 + q.2 ∧ τ q.1 + q.2 < b} := by
    intro p
    have h1 : τ p.1.1 = m := p.1.2.2
    have h2 := p.2.2
    refine ⟨p.1.2.1, ?_, ?_⟩
    · show a < τ p.1.1 + (p.2.1 - m)
      linarith [h2.1]
    · show τ p.1.1 + (p.2.1 - m) < b
      linarith [h2.2]
  have hτr : Continuous (fun x : ↥X => τ x.1) := hτc.restrict
  have hFc : Continuous F := by
    refine Continuous.prodMk ?_ ?_
    · refine Continuous.subtype_mk ?_ _
      have hsel : Continuous (fun x : ↥X => (x.1, m - τ x.1)) :=
        continuous_subtype_val.prodMk (continuous_const.sub hτr)
      exact hΘc.comp_continuous hsel hS
    · exact hτr.subtype_mk _
  have hGc : Continuous G := by
    refine Continuous.subtype_mk ?_ _
    have hsel : Continuous
        (fun p : ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b) => (p.1.1, p.2.1 - m)) :=
      (continuous_subtype_val.comp continuous_fst).prodMk
        ((continuous_subtype_val.comp continuous_snd).sub continuous_const)
    exact hΘc.comp_continuous hsel hS'
  exact ⟨⟨⟨F, G, hleft, hright⟩, hFc, hGc⟩⟩

theorem tau_gradient_field [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (X : Set M)
    (hX : IsOpen X) (τ : M → ℝ) (hτs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X)
    (hτr : ∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) :
    ∃ V : (x : M) → TangentSpace 𝓘(ℝ, E3) x,
      (∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
        (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x) ∧
      (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x (V x) = 1) :=
by
  classical
  
  have vec_expand : ∀ v : E3, v = ∑ i : Fin 3, v i • e i := by
    intro v
    ext j
    simp [Pi.single_apply]
  have bil_expand : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (z c : Fin 3 → ℝ),
      B (∑ a, z a • e a) (∑ b, c b • e b) =
        dotProduct z (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b)) c) := by
    intro B z c
    simp [map_sum, map_smul, ContinuousLinearMap.sum_apply, Matrix.mulVec, dotProduct,
      Finset.mul_sum, mul_comm, mul_left_comm]
    rw [Finset.sum_comm]
  have lin_expand : ∀ (ℓ : E3 →L[ℝ] ℝ) (c : Fin 3 → ℝ),
      ℓ (∑ b, c b • e b) = ∑ b, c b * ℓ (e b) := by
    intro ℓ c
    simp [map_sum, map_smul]
  have bil_detpos : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) →
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 := by
    intro B hB hdet
    obtain ⟨z, hz0, hz⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hv : (∑ a, z a • e a) ≠ 0 := by
      intro h0; apply hz0; funext j
      have := congrArg (fun v : E3 => v j) h0
      simpa [EuclideanSpace.single_apply, Pi.single_apply] using this
    have := hB _ hv
    rw [bil_expand, hz] at this
    simp at this
  have bil_riesz : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (ξ : Fin 3 → ℝ),
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 → ∀ v : E3,
      B v (∑ i, (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b))⁻¹ ξ) i • e i) =
        ∑ j, v j * ξ j := by
    intro B ξ hdet v
    conv_lhs => rw [vec_expand v]
    rw [bil_expand, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet),
      Matrix.one_mulVec]
    simp [dotProduct]
  have bil_unique : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) → ∀ w₁ w₂ : E3,
      (∀ v, B v w₁ = B v w₂) → w₁ = w₂ := by
    intro B hB w₁ w₂ h
    by_contra hne
    have := hB (w₁ - w₂) (sub_ne_zero.mpr hne)
    rw [(B (w₁ - w₂)).map_sub w₁ w₂, h (w₁ - w₂), sub_self] at this
    exact lt_irrefl _ this
  
  have det_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ 1 (fun y => H y i j) y₀) →
      ContDiffAt ℝ 1 (fun y => (H y).det) y₀ := by
    intro H y₀ hH
    have : (fun y => (H y).det) = fun y => ∑ σ : Equiv.Perm (Fin 3),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, H y (σ i) i := by
      funext y; exact Matrix.det_apply' _
    rw [this]
    refine ContDiffAt.sum fun σ _ => contDiffAt_const.mul ?_
    exact contDiffAt_prod fun i _ => hH _ _
  have inv_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ 1 (fun y => H y i j) y₀) → (H y₀).det ≠ 0 → ∀ i k : Fin 3,
      ContDiffAt ℝ 1 (fun y => (H y)⁻¹ i k) y₀ := by
    intro H y₀ hH hd i k
    have hinv : ∀ y, (H y)⁻¹ i k = ((H y).det)⁻¹ * (H y).adjugate i k := by
      intro y
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
      simp [Matrix.smul_apply]
    simp only [hinv]
    refine ((det_contDiffAt H y₀ hH).inv hd).mul ?_
    simp only [Matrix.adjugate_apply]
    refine det_contDiffAt _ y₀ fun a b => ?_
    by_cases h : a = k
    · subst h; simp [Matrix.updateRow_apply, contDiffAt_const]
    · simp only [Matrix.updateRow_apply, h, if_false]; exact hH a b
  
  have chart_inv : ∀ (x₀ x : M), x ∈ (chartAt E3 x₀).source →
      (∀ u, tangentCoordChange 𝓘(ℝ, E3) x x₀ x
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) u) = u) ∧
      (∀ v, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
        (tangentCoordChange 𝓘(ℝ, E3) x x₀ x v) = v) := by
    intro x₀ x hx
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hx
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hx
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 x₀) hx
    have hT : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x =
        tangentCoordChange 𝓘(ℝ, E3) x x₀ x :=
      mfderiv_chartAt_eq_tangentCoordChange hx
    constructor
    · intro u
      have hd2' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀)
          ((chartAt E3 x₀).symm (chartAt E3 x₀ x)) := by rw [hxy]; exact hd2
      have hc := mfderiv_comp (chartAt E3 x₀ x) hd2' hd1
      have hid : ((chartAt E3 x₀) ∘ (chartAt E3 x₀).symm) =ᶠ[𝓝 (chartAt E3 x₀ x)] id := by
        filter_upwards [(chartAt E3 x₀).eventually_right_inverse hy] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hxy, hT] at hc
      have := congrArg (fun L => L u) hc
      simpa using this.symm
    · intro v
      have hc := mfderiv_comp x hd1 hd2
      have hid : ((chartAt E3 x₀).symm ∘ (chartAt E3 x₀)) =ᶠ[𝓝 x] id := by
        filter_upwards [(chartAt E3 x₀).eventually_left_inverse hx] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hT] at hc
      have := congrArg (fun L => L v) hc
      simpa using this.symm
  have chain_tau : ∀ (x₀ : M) (y : E3), y ∈ (chartAt E3 x₀).target →
      (chartAt E3 x₀).symm y ∈ X → ∀ v : E3,
      fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y v =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y v) := by
    intro x₀ y hy hyX v
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hτd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y) :=
      (hτs.contMDiffAt (hX.mem_nhds hyX)).mdifferentiableAt (by simp)
    have hc := mfderiv_comp y hτd hd1
    rw [mfderiv_eq_fderiv] at hc
    exact congrArg (fun L => L v) hc
  have xi_smooth : ∀ (x₀ : M), x₀ ∈ X → ∀ j : Fin 3,
      ContDiffAt ℝ 1 (fun y => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j))
        (chartAt E3 x₀ x₀) := by
    intro x₀ hx₀ j
    have hO : IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      (chartAt E3 x₀).isOpen_inter_preimage_symm hX
    have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X :=
      ⟨mem_chart_target E3 x₀, by
        show (chartAt E3 x₀).symm (chartAt E3 x₀ x₀) ∈ X
        rw [(chartAt E3 x₀).left_inv (mem_chart_source E3 x₀)]; exact hx₀⟩
    have hf : ContDiffOn ℝ ∞ (fun z => τ ((chartAt E3 x₀).symm z))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) := by
      have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (τ ∘ (chartAt E3 x₀).symm)
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
        hτs.comp (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun y hy => hy.2)
      exact contMDiffOn_iff_contDiffOn.mp this
    have hfd : ContDiffOn ℝ 1 (fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      hf.fderiv_of_isOpen hO (WithTop.coe_le_coe.mpr le_top)
    exact (hfd.clm_apply contDiffOn_const).contDiffAt (hO.mem_nhds hy₀)
  
  have section_cmd : ∀ (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (x₀ : M) (W : E3 → E3),
      ContDiffAt ℝ 1 W (chartAt E3 x₀ x₀) →
      (∀ᶠ x in 𝓝 x₀, tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x)) →
      ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
        (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀ := by
    intro V x₀ W hW hV
    rw [Bundle.contMDiffAt_section]
    have hc : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 (chartAt E3 x₀) x₀ := by
      have := contMDiffAt_extChartAt (I := 𝓘(ℝ, E3)) (n := 1) (x := x₀)
      simpa [extChartAt_coe] using this
    have h1 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 (fun x => W (chartAt E3 x₀ x)) x₀ :=
      hW.contMDiffAt.comp x₀ hc
    refine h1.congr_of_eventuallyEq ?_
    filter_upwards [hV] with x hx
    rw [← hx, tangentCoordChange_def, TangentBundle.trivializationAt_apply]
    rfl
  
  let ℓ : M → E3 →L[ℝ] ℝ := fun x => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x
  let w : M → E3 := fun x =>
    ∑ i, (Matrix.mulVec (Matrix.of fun a b => g.g x (e a) (e b))⁻¹ (fun j => ℓ x (e j))) i • e i
  let V : (x : M) → TangentSpace 𝓘(ℝ, E3) x := fun x => (ℓ x (w x))⁻¹ • w x
  have hwR : ∀ x v, g.g x v (w x) = ℓ x v := by
    intro x v
    have h1 := bil_riesz (g.g x) (fun j => ℓ x (e j)) (bil_detpos _ (g.posDef x)) v
    calc g.g x v (w x) = ∑ j, v j * ℓ x (e j) := h1
      _ = ℓ x (∑ i, v i • e i) := (lin_expand (ℓ x) (fun i => v i)).symm
      _ = ℓ x v := by rw [← vec_expand v]
  have hpos : ∀ x ∈ X, 0 < ℓ x (w x) := by
    intro x hx
    have hw0 : w x ≠ 0 := by
      intro h0
      apply hτr x hx
      ext v
      have := hwR x v
      rw [h0, map_zero] at this
      simpa using this.symm
    have := g.posDef x (w x) hw0
    rwa [hwR] at this
  refine ⟨V, ?_, ?_⟩
  swap
  · intro x hx
    show ℓ x ((ℓ x (w x))⁻¹ • w x) = 1
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ (hpos x hx).ne']
  intro x₀ hx₀
  let G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 x₀).symm
  let ξ : E3 → Fin 3 → ℝ := fun y j => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j)
  let c : E3 → Fin 3 → ℝ := fun y => Matrix.mulVec (G y)⁻¹ (ξ y)
  let W : E3 → E3 := fun y => (∑ i, c y i * ξ y i)⁻¹ • ∑ i, c y i • e i
  
  have hK : ∀ x ∈ (chartAt E3 x₀).source ∩ X,
      tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x) ∧
      ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
    rintro x ⟨hxs, hxX⟩
    obtain ⟨hTA0, hAT0⟩ := chart_inv x₀ x hxs
    let A : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
    let T : E3 →L[ℝ] E3 := tangentCoordChange 𝓘(ℝ, E3) x x₀ x
    have hTA : ∀ u, T (A u) = u := hTA0
    have hAT : ∀ v, A (T v) = v := hAT0
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hxs
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hxs
    have hG : G (chartAt E3 x₀ x) =
        Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b) := by
      ext a b
      simp only [G, RiemannianMetric3.coeff, coeffMatrix, Matrix.of_apply,
        ContinuousLinearMap.bilinearComp_apply]
      rw [hxy]
      rfl
    have hξ : ξ (chartAt E3 x₀ x) = fun j => ℓ x (A (e j)) := by
      funext j
      simp only [ξ]
      rw [chain_tau x₀ _ hy (by rw [hxy]; exact hxX), hxy]
      rfl
    have hdetB : (Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b)).det ≠ 0 := by
      refine bil_detpos _ (fun v hv => ?_)
      rw [ContinuousLinearMap.bilinearComp_apply]
      apply g.posDef
      intro h0
      apply hv
      rw [← hTA v]
      exact (congrArg T h0).trans (map_zero T)
    let u : E3 := ∑ i, c (chartAt E3 x₀ x) i • e i
    have hRu : ∀ v, (g.g x).bilinearComp A A v u = ∑ j, v j * ℓ x (A (e j)) := by
      intro v
      have := bil_riesz ((g.g x).bilinearComp A A) (fun j => ℓ x (A (e j))) hdetB v
      simp only [u, c, hG, hξ]
      exact this
    have hAu : ∀ v, g.g x v (A u) = ℓ x v := by
      intro v
      have h1 := hRu (T v)
      rw [ContinuousLinearMap.bilinearComp_apply, hAT v] at h1
      rw [h1]
      calc ∑ j, (T v) j * ℓ x (A (e j)) = ((ℓ x).comp A) (∑ i, (T v) i • e i) :=
            (lin_expand ((ℓ x).comp A) (fun i => (T v) i)).symm
        _ = ℓ x v := by
            rw [← vec_expand (T v), ContinuousLinearMap.comp_apply, hAT v]
    have hwAu : w x = A u :=
      bil_unique (g.g x) (g.posDef x) _ _ (fun v => (hwR x v).trans (hAu v).symm)
    have hlw : ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
      rw [hwAu, hξ]
      exact lin_expand ((ℓ x).comp A) (c (chartAt E3 x₀ x))
    refine ⟨?_, hlw⟩
    show T ((ℓ x (w x))⁻¹ • w x) = W (chartAt E3 x₀ x)
    rw [hlw, hwAu, map_smul, hTA]
  
  have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target := mem_chart_target E3 x₀
  have hGs : ∀ i j, ContDiffAt ℝ 1 (fun y => G y i j) (chartAt E3 x₀ x₀) := fun i j =>
    ((g.smooth x₀ i j).contDiffAt ((chartAt E3 x₀).open_target.mem_nhds hy₀)).of_le
      (by exact_mod_cast le_top)
  have hK₀ := hK x₀ ⟨mem_chart_source E3 x₀, hx₀⟩
  have hdetG : (G (chartAt E3 x₀ x₀)).det ≠ 0 := by
    intro h0
    have hc0 : c (chartAt E3 x₀ x₀) = 0 := by
      simp only [c, Matrix.inv_def, h0, Ring.inverse_zero, zero_smul, Matrix.zero_mulVec]
    have := hpos x₀ hx₀
    rw [hK₀.2, hc0] at this
    simp at this
  have hξs : ∀ j, ContDiffAt ℝ 1 (fun y => ξ y j) (chartAt E3 x₀ x₀) := fun j =>
    xi_smooth x₀ hx₀ j
  have hcs : ∀ i, ContDiffAt ℝ 1 (fun y => c y i) (chartAt E3 x₀ x₀) := by
    intro i
    simp only [c, Matrix.mulVec, dotProduct]
    exact ContDiffAt.sum fun k _ => (inv_contDiffAt G _ hGs hdetG i k).mul (hξs k)
  have hden : ContDiffAt ℝ 1 (fun y => ∑ i, c y i * ξ y i) (chartAt E3 x₀ x₀) :=
    ContDiffAt.sum fun i _ => (hcs i).mul (hξs i)
  have hden0 : ∑ i, c (chartAt E3 x₀ x₀) i * ξ (chartAt E3 x₀ x₀) i ≠ 0 := by
    rw [← hK₀.2]; exact (hpos x₀ hx₀).ne'
  have hWs : ContDiffAt ℝ 1 W (chartAt E3 x₀ x₀) :=
    (hden.inv hden0).smul (ContDiffAt.sum fun i _ => (hcs i).smul contDiffAt_const)
  refine section_cmd V x₀ W hWs ?_
  filter_upwards [((chartAt E3 x₀).open_source.inter hX).mem_nhds
    ⟨mem_chart_source E3 x₀, hx₀⟩] with x hx using (hK x hx).1

theorem local_flow_of_contMDiffAt [IsManifold 𝓘(ℝ, E3) ∞ M] (X : Set M) (hX : IsOpen X)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (x₀ : M) (hx₀ : x₀ ∈ X)
    (hV : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
      (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀) :
    ∃ (N : Set M) (ε : ℝ) (ψ : M → ℝ → M), IsOpen N ∧ x₀ ∈ N ∧ N ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, ψ x s ∈ X :=
by
  set φ := extChartAt 𝓘(ℝ, E3) x₀ with hφ
  set F : E3 → E3 := fun y => tangentCoordChange 𝓘(ℝ, E3) (φ.symm y) x₀ (φ.symm y)
    (V (φ.symm y)) with hFdef
  
  have hF : ContDiffAt ℝ 1 F (φ x₀) := by
    have h1 := (Bundle.contMDiffAt_section x₀).mp hV
    have h2 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 φ.symm (φ x₀) :=
      (contMDiffOn_extChartAt_symm x₀).contMDiffAt
        ((isOpen_extChartAt_target x₀).mem_nhds (mem_extChartAt_target x₀))
    rw [← extChartAt_to_inv (I := 𝓘(ℝ, E3)) x₀] at h1
    have h3 := h1.comp _ h2
    rw [contMDiffAt_iff_contDiffAt] at h3
    refine h3.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
    simp only [hFdef, hφ, Function.comp_apply, TangentBundle.trivializationAt_apply,
      tangentCoordChange_def, extChartAt_to_inv]
    rfl
  
  have hode : ∀ (f : E3 → E3) (y₀ : E3), ContDiffAt ℝ 1 f y₀ → ∀ (O : Set E3), IsOpen O →
      y₀ ∈ O → ∃ (δ : ℝ) (α : E3 × ℝ → E3), 0 < δ ∧
        ContinuousOn α (Metric.ball y₀ δ ×ˢ Set.Ioo (-δ) δ) ∧
        ∀ y ∈ Metric.ball y₀ δ, α (y, 0) = y ∧ ∀ t ∈ Set.Ioo (-δ) δ,
          HasDerivAt (fun s => α (y, s)) (f (α (y, t))) t ∧ α (y, t) ∈ O := by
    intro f y₀ hf O hO hy₀
    obtain ⟨ε₁, hε₁, a, r, L, K, hr, hPL⟩ := IsPicardLindelof.of_contDiffAt_one hf (0:ℝ)
    obtain ⟨α, hα1, hαc⟩ := hPL.exists_forall_mem_closedBall_eq_hasDerivWithinAt_continuousOn
    have hD : closedBall y₀ (r:ℝ) ×ˢ Set.Icc (0 - ε₁) (0 + ε₁) ∈ 𝓝 (y₀, (0:ℝ)) :=
      prod_mem_nhds (closedBall_mem_nhds y₀ hr) (Icc_mem_nhds (by linarith) (by linarith))
    have hy₀b : y₀ ∈ closedBall y₀ (r:ℝ) := mem_closedBall_self hr.le
    have hα0 : α (y₀, 0) = y₀ := (hα1 y₀ hy₀b).1
    have hcont : ContinuousAt α (y₀, 0) := hαc.continuousAt hD
    have hpre : α ⁻¹' O ∈ 𝓝 (y₀, (0:ℝ)) :=
      hcont.preimage_mem_nhds (by rw [hα0]; exact hO.mem_nhds hy₀)
    obtain ⟨δ', hδ', hball⟩ := Metric.mem_nhds_iff.mp (Filter.inter_mem hD hpre)
    have hbox : ball y₀ (min δ' ε₁) ×ˢ Set.Ioo (-(min δ' ε₁)) (min δ' ε₁) ⊆
        closedBall y₀ (r:ℝ) ×ˢ Set.Icc (0 - ε₁) (0 + ε₁) ∩ α ⁻¹' O := by
      have h1 : Set.Ioo (-(min δ' ε₁)) (min δ' ε₁) = ball (0:ℝ) (min δ' ε₁) := by
        rw [Real.ball_eq_Ioo]; simp
      rw [h1, ball_prod_same]
      exact (ball_subset_ball (min_le_left _ _)).trans hball
    refine ⟨min δ' ε₁, α, lt_min hδ' hε₁, ?_, ?_⟩
    · exact hαc.mono (fun p hp => (hbox hp).1)
    · intro y hy
      have hyr : y ∈ closedBall y₀ (r:ℝ) :=
        (hbox (Set.mk_mem_prod hy (show (0:ℝ) ∈ Set.Ioo _ _ from
          ⟨by linarith [lt_min hδ' hε₁], lt_min hδ' hε₁⟩))).1.1
      refine ⟨(hα1 y hyr).1, fun t ht => ?_⟩
      have hp := hbox (Set.mk_mem_prod hy ht)
      refine ⟨?_, hp.2⟩
      have htI : Set.Icc (0 - ε₁) (0 + ε₁) ∈ 𝓝 t := by
        have := ht.1; have := ht.2; have := min_le_right δ' ε₁
        exact Icc_mem_nhds (by linarith) (by linarith)
      exact ((hα1 y hyr).2 t hp.1.2).hasDerivAt htI
  
  have hcurve : ∀ (c : ℝ → E3) (J : Set ℝ), (∀ t ∈ J, c t ∈ φ.target) →
      (∀ t ∈ J, HasDerivAt c (F (c t)) t) →
      IsMIntegralCurveOn (fun t => φ.symm (c t)) V J := by
    intro c J hcJ hc t ht
    apply HasMFDerivAt.hasMFDerivWithinAt
    set z := φ.symm (c t) with hz
    have hzs : z ∈ (extChartAt 𝓘(ℝ, E3) x₀).source := φ.map_target (hcJ t ht)
    have hzz : z ∈ (extChartAt 𝓘(ℝ, E3) z).source := mem_extChartAt_source z
    have hφz : extChartAt 𝓘(ℝ, E3) x₀ z = c t := φ.right_inv (hcJ t ht)
    refine ⟨(continuousAt_extChartAt_symm'' (hcJ t ht)).comp (hc t ht).continuousAt, ?_⟩
    have h1 := hasFDerivWithinAt_tangentCoordChange (I := 𝓘(ℝ, E3)) ⟨hzs, hzz⟩
    rw [hφz, ModelWithCorners.range_eq_univ, hasFDerivWithinAt_univ] at h1
    have h2 := h1.comp_hasDerivAt t (hc t ht)
    simp only [hFdef] at h2
    rw [← hz, tangentCoordChange_comp ⟨⟨hzz, hzs⟩, hzz⟩, tangentCoordChange_self hzz] at h2
    simp only [mfld_simps, hasFDerivWithinAt_univ]
    exact h2.hasFDerivAt
  
  set O' : Set E3 := φ.target ∩ φ.symm ⁻¹' X with hO'def
  have hO' : IsOpen O' :=
    (continuousOn_extChartAt_symm x₀).isOpen_inter_preimage (isOpen_extChartAt_target x₀) hX
  have hy₀O' : φ x₀ ∈ O' := ⟨mem_extChartAt_target x₀, by
    show φ.symm (φ x₀) ∈ X
    rw [hφ, extChartAt_to_inv]; exact hx₀⟩
  obtain ⟨δ, α, hδ, hαc, hα⟩ := hode F (φ x₀) hF O' hO' hy₀O'
  refine ⟨(φ.source ∩ φ ⁻¹' Metric.ball (φ x₀) δ) ∩ X, δ, fun x s => φ.symm (α (φ x, s)),
    ?_, ?_, Set.inter_subset_right, hδ, ?_, ?_⟩
  · exact ((continuousOn_extChartAt x₀).isOpen_inter_preimage (isOpen_extChartAt_source x₀)
      Metric.isOpen_ball).inter hX
  · exact ⟨⟨mem_extChartAt_source x₀, Metric.mem_ball_self hδ⟩, hx₀⟩
  · have hg : ContinuousOn (fun p : M × ℝ => (φ p.1, p.2))
        (((φ.source ∩ φ ⁻¹' Metric.ball (φ x₀) δ) ∩ X) ×ˢ Set.Ioo (-δ) δ) :=
      ((continuousOn_extChartAt x₀).comp continuousOn_fst
        (fun p hp => hp.1.1.1)).prodMk continuousOn_snd
    have hgm : Set.MapsTo (fun p : M × ℝ => (φ p.1, p.2))
        (((φ.source ∩ φ ⁻¹' Metric.ball (φ x₀) δ) ∩ X) ×ˢ Set.Ioo (-δ) δ)
        (Metric.ball (φ x₀) δ ×ˢ Set.Ioo (-δ) δ) :=
      fun p hp => ⟨hp.1.1.2, hp.2⟩
    have hαm : Set.MapsTo α (Metric.ball (φ x₀) δ ×ˢ Set.Ioo (-δ) δ) φ.target := by
      intro p hp
      have := ((hα p.1 hp.1).2 p.2 hp.2).2
      exact this.1
    exact (continuousOn_extChartAt_symm x₀).comp (hαc.comp hg hgm) (hαm.comp hgm)
  · intro x hx
    have hxs : x ∈ φ.source := hx.1.1
    have hxb : φ x ∈ Metric.ball (φ x₀) δ := hx.1.2
    refine ⟨?_, ?_, ?_⟩
    · show φ.symm (α (φ x, 0)) = x
      rw [(hα (φ x) hxb).1]
      exact φ.left_inv hxs
    · exact hcurve (fun s => α (φ x, s)) (Set.Ioo (-δ) δ)
        (fun t ht => ((hα (φ x) hxb).2 t ht).2.1) (fun t ht => ((hα (φ x) hxb).2 t ht).1)
    · intro s hs
      exact ((hα (φ x) hxb).2 s hs).2.2

theorem integral_curve_eqOn_of_mem [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (X : Set M)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x)
    (hV : ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
      (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x)
    (γ γ' : ℝ → M) (α β t₀ : ℝ) (ht₀ : t₀ ∈ Set.Ioo α β)
    (hγ : IsMIntegralCurveOn γ V (Set.Ioo α β)) (hγ' : IsMIntegralCurveOn γ' V (Set.Ioo α β))
    (hγX : ∀ t ∈ Set.Ioo α β, γ t ∈ X) (hγ'X : ∀ t ∈ Set.Ioo α β, γ' t ∈ X)
    (h₀ : γ t₀ = γ' t₀) : Set.EqOn γ γ' (Set.Ioo α β) :=
by
  set S : Set ℝ := {t | γ t = γ' t} ∩ Set.Ioo α β with hS
  have hopen : IsOpen S := by
    rw [isOpen_iff_mem_nhds]
    rintro t₁ ⟨h1, ht₁⟩
    have hmem : Set.Ioo α β ∈ 𝓝 t₁ := Ioo_mem_nhds ht₁.1 ht₁.2
    have hVt := hV (γ t₁) (hγX t₁ ht₁)
    have heq : γ =ᶠ[𝓝 t₁] γ' :=
      isMIntegralCurveAt_eventuallyEq_of_contMDiffAt_boundaryless hVt
        (hγ.isMIntegralCurveAt hmem) (hγ'.isMIntegralCurveAt hmem) h1
    filter_upwards [heq, hmem] with t h2 h3 using ⟨h2, h3⟩
  have hne : (Set.Ioo α β ∩ S).Nonempty := ⟨t₀, ht₀, h₀, ht₀⟩
  have hcl : closure S ∩ Set.Ioo α β ⊆ S := by
    rintro t ⟨htc, ht⟩
    refine ⟨?_, ht⟩
    haveI : (𝓝[S] t).NeBot := mem_closure_iff_nhdsWithin_neBot.mp htc
    have hm : Set.Ioo α β ∈ 𝓝 t := Ioo_mem_nhds ht.1 ht.2
    have t1 : Filter.Tendsto γ (𝓝[S] t) (𝓝 (γ t)) :=
      ((hγ.continuousOn.continuousAt hm).continuousWithinAt).tendsto
    have t2 : Filter.Tendsto γ' (𝓝[S] t) (𝓝 (γ' t)) :=
      ((hγ'.continuousOn.continuousAt hm).continuousWithinAt).tendsto
    have he : γ =ᶠ[𝓝[S] t] γ' := eventually_nhdsWithin_of_forall (fun s hs => hs.1)
    exact tendsto_nhds_unique_of_eventuallyEq t1 t2 he
  have hsub : Set.Ioo α β ⊆ S :=
    isPreconnected_Ioo.subset_of_closure_inter_subset hopen hne hcl
  intro t ht
  exact (hsub ht).1

theorem tau_affine_along_integral_curve [IsManifold 𝓘(ℝ, E3) ∞ M] (X : Set M) (hX : IsOpen X)
    (τ : M → ℝ) (hτs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x)
    (hVτ : ∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x (V x) = 1)
    (γ : ℝ → M) (α β s₀ : ℝ) (hs₀ : s₀ ∈ Set.Ioo α β)
    (hγ : IsMIntegralCurveOn γ V (Set.Ioo α β)) (hγX : ∀ t ∈ Set.Ioo α β, γ t ∈ X) :
    ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀) :=
by
  intro s hs
  have key : ∀ t ∈ Set.Ioo α β, HasDerivAt (fun u => τ (γ u) - u) 0 t := by
    intro t ht
    have h1 : HasMFDerivAt 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) γ t
        ((1 : ℝ →L[ℝ] ℝ).smulRight (V (γ t))) :=
      (hγ t ht).hasMFDerivAt (isOpen_Ioo.mem_nhds ht)
    have hxX : γ t ∈ X := hγX t ht
    have h2 : HasMFDerivAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ (γ t) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ (γ t)) :=
      ((hτs.contMDiffAt (hX.mem_nhds hxX)).mdifferentiableAt (by simp)).hasMFDerivAt
    have h3 := HasMFDerivAt.comp t h2 h1
    rw [hasMFDerivAt_iff_hasFDerivAt] at h3
    have h4 := h3.hasDerivAt
    have hval : ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ (γ t)).comp
        ((1 : ℝ →L[ℝ] ℝ).smulRight (V (γ t)))) 1 = 1 := by
      rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.smulRight_apply,
        ContinuousLinearMap.one_apply, one_smul]
      exact hVτ (γ t) hxX
    have h4' : HasDerivAt (fun u => τ (γ u)) 1 t := by
      convert h4 using 1
      exact hval.symm
    have h5 := h4'.sub (hasDerivAt_id' t)
    rw [sub_self] at h5
    exact h5
  have hc := isOpen_Ioo.is_const_of_deriv_eq_zero isPreconnected_Ioo
    (fun t ht => (key t ht).differentiableAt.differentiableWithinAt)
    (fun t ht => (key t ht).deriv) hs hs₀
  simp only at hc
  linarith

theorem uniform_flow_on_compact (X K : Set M) (hKX : K ⊆ X) (hK : IsCompact K)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x)
    (hloc : ∀ x₀ ∈ X, ∃ (N : Set M) (ε : ℝ) (ψ : M → ℝ → M), IsOpen N ∧ x₀ ∈ N ∧ N ⊆ X ∧
      0 < ε ∧ ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, ψ x s ∈ X)
    (huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β)) :
    ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M), IsOpen O ∧ K ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Ψ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X :=
by
  classical
  have hP0 : ∀ x₀ : M, ∃ (N : Set M) (e : ℝ) (ψ : M → ℝ → M), x₀ ∈ X → (IsOpen N ∧ x₀ ∈ N ∧
      N ⊆ X ∧ 0 < e ∧ ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-e) e) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-e) e) ∧
        ∀ s ∈ Set.Ioo (-e) e, ψ x s ∈ X) := by
    intro x₀
    by_cases h : x₀ ∈ X
    · obtain ⟨N, e, ψ, hh⟩ := hloc x₀ h
      exact ⟨N, e, ψ, fun _ => hh⟩
    · exact ⟨∅, 1, fun x _ => x, fun h' => absurd h' h⟩
  choose Nf εf ψf hP using hP0
  obtain ⟨t, htK, hcov⟩ := hK.elim_nhds_subcover Nf (fun x hx =>
    (hP x (hKX hx)).1.mem_nhds (hP x (hKX hx)).2.1)
  have hS : (insert (1 : ℝ) (t.image εf)).Nonempty := Finset.insert_nonempty _ _
  obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = (insert (1 : ℝ) (t.image εf)).min' hS := ⟨_, rfl⟩
  have hε0 : 0 < ε := by
    have hm := Finset.min'_mem _ hS
    rw [← hεdef] at hm
    rcases Finset.mem_insert.1 hm with h | h
    · rw [h]; norm_num
    · obtain ⟨i, hi, hie⟩ := Finset.mem_image.1 h
      rw [← hie]; exact (hP i (hKX (htK i hi))).2.2.2.1
  have hεle : ∀ i ∈ t, ε ≤ εf i := by
    intro i hi
    rw [hεdef]
    exact Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hi))
  have hJsub : ∀ i ∈ t, Set.Ioo (-ε) ε ⊆ Set.Ioo (-εf i) (εf i) := by
    intro i hi s hs
    have := hεle i hi
    exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
  have h0J : (0 : ℝ) ∈ Set.Ioo (-ε) ε := ⟨by linarith, hε0⟩
  obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : M → ℝ → M, Ψ = fun x s =>
      if h : ∃ i ∈ t, x ∈ Nf i then ψf (Classical.choose h) x s else x := ⟨_, rfl⟩
  have hA : ∀ i ∈ t, ∀ x ∈ Nf i, ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s = ψf i x s := by
    intro i hi x hx s hs
    have h : ∃ i ∈ t, x ∈ Nf i := ⟨i, hi, hx⟩
    obtain ⟨hjt, hjx⟩ := Classical.choose_spec h
    have hΨ : Ψ x s = ψf (Classical.choose h) x s := by
      rw [hΨdef]
      exact dif_pos h
    rw [hΨ]
    have Pj := (hP _ (hKX (htK _ hjt))).2.2.2.2.2 x hjx
    have Pi := (hP i (hKX (htK i hi))).2.2.2.2.2 x hx
    exact huniq _ (ψf i x) (-ε) ε 0 h0J (Pj.2.1.mono (hJsub _ hjt))
      (Pi.2.1.mono (hJsub i hi)) (fun r hr => Pj.2.2 r (hJsub _ hjt hr))
      (fun r hr => Pi.2.2 r (hJsub i hi hr)) (by rw [Pj.1, Pi.1]) hs
  have hmemO : ∀ x ∈ ⋃ i ∈ t, Nf i, ∃ i ∈ t, x ∈ Nf i := by
    intro x hx
    obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.1 hx
    exact ⟨i, hi, hxi⟩
  refine ⟨⋃ i ∈ t, Nf i, ε, Ψ, isOpen_biUnion (fun i hi => (hP i (hKX (htK i hi))).1), hcov,
    ?_, hε0, ?_, ?_⟩
  · intro x hx
    obtain ⟨i, hi, hxi⟩ := hmemO x hx
    exact (hP i (hKX (htK i hi))).2.2.1 hxi
  · intro p hp
    obtain ⟨i, hi, hxi⟩ := hmemO p.1 hp.1
    have Pi := hP i (hKX (htK i hi))
    have hW : Nf i ×ˢ Set.Ioo (-ε) ε ∈ 𝓝 p := (Pi.1.prod isOpen_Ioo).mem_nhds ⟨hxi, hp.2⟩
    have hc : ContinuousAt (fun q : M × ℝ => ψf i q.1 q.2) p :=
      Pi.2.2.2.2.1.continuousAt
        (Filter.mem_of_superset hW (Set.prod_mono subset_rfl (hJsub i hi)))
    refine (hc.congr (Filter.eventually_of_mem hW ?_)).continuousWithinAt
    intro q hq
    exact (hA i hi q.1 hq.1 q.2 hq.2).symm
  · intro x hx
    obtain ⟨i, hi, hxi⟩ := hmemO x hx
    have Pi := (hP i (hKX (htK i hi))).2.2.2.2.2 x hxi
    refine ⟨by rw [hA i hi x hxi 0 h0J]; exact Pi.1, ?_,
      fun s hs => by rw [hA i hi x hxi s hs]; exact Pi.2.2 s (hJsub i hi hs)⟩
    have hcurve := Pi.2.1.mono (hJsub i hi)
    intro r hr
    have h1 := hcurve r hr
    have heq : Ψ x r = ψf i x r := hA i hi x hxi r hr
    have h2 := h1.congr_mono (f₁ := Ψ x) (fun y hy => hA i hi x hxi y hy) heq subset_rfl
    have hV : V (Ψ x r) = V (ψf i x r) := by rw [heq]
    show HasMFDerivWithinAt _ _ _ _ _ _
    rw [hV]
    exact h2

theorem long_integral_curve_exists (X : Set M) (τ : M → ℝ) (a b : ℝ)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b)
    (huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β))
    (hτlin : ∀ (γ : ℝ → M) (α β s₀ : ℝ), s₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀))
    (hunif : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X)
    (x : M) (hx : x ∈ X) (T₁ T₂ : ℝ) (hT₁ : T₁ ≤ 0) (hT₂ : 0 ≤ T₂)
    (ha : a < τ x + T₁) (hb : τ x + T₂ < b) :
    ∃ (γ : ℝ → M) (α β : ℝ), α < T₁ ∧ T₂ < β ∧ γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X :=
by
  classical
  
  have glue : ∀ (γ γ' : ℝ → M) (α β α' β' t₁ : ℝ), t₁ ∈ Set.Ioo α β → t₁ ∈ Set.Ioo α' β' →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α' β') →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α' β', γ' t ∈ X) → γ t₁ = γ' t₁ →
      ∃ γ'' : ℝ → M, IsMIntegralCurveOn γ'' V (Set.Ioo (min α α') (max β β')) ∧
        (∀ t ∈ Set.Ioo (min α α') (max β β'), γ'' t ∈ X) ∧ Set.EqOn γ'' γ (Set.Ioo α β) := by
    intro γ γ' α β α' β' t₁ ht₁ ht₁' hγ hγ' hγX hγ'X h₁
    have hJ₁ : Set.Ioo (max α α') (min β β') ⊆ Set.Ioo α β :=
      Set.Ioo_subset_Ioo (le_max_left _ _) (min_le_left _ _)
    have hJ₂ : Set.Ioo (max α α') (min β β') ⊆ Set.Ioo α' β' :=
      Set.Ioo_subset_Ioo (le_max_right _ _) (min_le_right _ _)
    have ht₁J : t₁ ∈ Set.Ioo (max α α') (min β β') :=
      ⟨max_lt ht₁.1 ht₁'.1, lt_min ht₁.2 ht₁'.2⟩
    have hEq : Set.EqOn γ γ' (Set.Ioo (max α α') (min β β')) :=
      huniq γ γ' _ _ t₁ ht₁J (hγ.mono hJ₁) (hγ'.mono hJ₂)
        (fun t ht => hγX t (hJ₁ ht)) (fun t ht => hγ'X t (hJ₂ ht)) h₁
    have hE1 : Set.EqOn ((Set.Ioo α β).piecewise γ γ') γ (Set.Ioo α β) :=
      fun t ht => Set.piecewise_eq_of_mem _ _ _ ht
    have hE2 : Set.EqOn ((Set.Ioo α β).piecewise γ γ') γ' (Set.Ioo α' β') := by
      intro t ht
      by_cases h : t ∈ Set.Ioo α β
      · rw [Set.piecewise_eq_of_mem _ _ _ h]
        exact hEq ⟨max_lt h.1 ht.1, lt_min h.2 ht.2⟩
      · exact Set.piecewise_eq_of_notMem _ _ _ h
    have hU : Set.Ioo α β ∪ Set.Ioo α' β' = Set.Ioo (min α α') (max β β') :=
      Set.Ioo_union_Ioo' (ht₁'.1.trans ht₁.2) (ht₁.1.trans ht₁'.2)
    have hG : ∀ (W : Set ℝ) (η : ℝ → M), IsOpen W →
        IsMIntegralCurveOn η V W → Set.EqOn ((Set.Ioo α β).piecewise γ γ') η W → ∀ t ∈ W,
        HasMFDerivWithinAt 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) ((Set.Ioo α β).piecewise γ γ')
          (Set.Ioo (min α α') (max β β')) t
          ((1 : ℝ →L[ℝ] ℝ).smulRight (V ((Set.Ioo α β).piecewise γ γ' t))) := by
      intro W η hWo hη hEqW t ht
      have hW : W ∈ nhds t := hWo.mem_nhds ht
      have h1 := (hη t ht).hasMFDerivAt hW
      have h2 : (Set.Ioo α β).piecewise γ γ' =ᶠ[nhds t] η := Filter.eventuallyEq_of_mem hW hEqW
      have h3 := h1.congr_of_eventuallyEq h2
      rw [hEqW ht]
      exact h3.hasMFDerivWithinAt
    refine ⟨(Set.Ioo α β).piecewise γ γ', ?_, ?_, hE1⟩
    · intro t ht
      rw [← hU] at ht
      rcases ht with ht | ht
      · exact hG _ γ isOpen_Ioo hγ hE1 t ht
      · exact hG _ γ' isOpen_Ioo hγ' hE2 t ht
    · intro t ht
      rw [← hU] at ht
      rcases ht with ht | ht
      · rw [hE1 ht]; exact hγX t ht
      · rw [hE2 ht]; exact hγ'X t ht
  
  obtain ⟨O, ε, Ψ, hKO, hOX, hε, hΨ⟩ := hunif (τ x + T₁) (τ x + T₂) ha hb
  have hSM : ∀ z ∈ X, ∀ t : ℝ, τ z = τ x + t → T₁ ≤ t → t ≤ T₂ → z ∈ O := by
    intro z hz t hτz h1 h2
    refine hKO ⟨hz, ?_⟩
    rw [Set.mem_preimage, Set.mem_Icc, hτz]
    constructor <;> linarith
  
  have hext : ∀ (γ : ℝ → M) (α β t₁ : ℝ), t₁ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) → γ t₁ ∈ O →
      ∃ γ'' : ℝ → M, IsMIntegralCurveOn γ'' V (Set.Ioo (min α (t₁ - ε)) (max β (t₁ + ε))) ∧
        (∀ t ∈ Set.Ioo (min α (t₁ - ε)) (max β (t₁ + ε)), γ'' t ∈ X) ∧
        Set.EqOn γ'' γ (Set.Ioo α β) := by
    intro γ α β t₁ ht₁ hγ hγX hyO
    obtain ⟨hy0, hyI, hyX⟩ := hΨ (γ t₁) hyO
    have hsub : Set.Ioo (t₁ - ε) (t₁ + ε) ⊆ {t | t + -t₁ ∈ Set.Ioo (-ε) ε} := by
      intro t ht
      simp only [Set.mem_setOf_eq, Set.mem_Ioo] at ht ⊢
      constructor <;> linarith [ht.1, ht.2]
    have hγ' : IsMIntegralCurveOn (Ψ (γ t₁) ∘ fun s => s + -t₁) V
        (Set.Ioo (t₁ - ε) (t₁ + ε)) :=
      (hyI.comp_add (-t₁)).mono hsub
    have hγ'X : ∀ s ∈ Set.Ioo (t₁ - ε) (t₁ + ε), (Ψ (γ t₁) ∘ fun s => s + -t₁) s ∈ X := by
      intro s hs
      exact hyX (s + -t₁) (hsub hs)
    have ht₁' : t₁ ∈ Set.Ioo (t₁ - ε) (t₁ + ε) := ⟨by linarith, by linarith⟩
    have h₁ : γ t₁ = (Ψ (γ t₁) ∘ fun s => s + -t₁) t₁ := by
      simp only [Function.comp_apply, add_neg_cancel, hy0]
    exact glue γ _ α β _ _ t₁ ht₁ ht₁' hγ hγ' hγX hγ'X h₁
  
  obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ε / 2 := ⟨_, rfl⟩
  have hδpos : 0 < δ := by rw [hδ]; linarith
  have hτ0 : ∀ (γ : ℝ → M) (α β : ℝ), α < 0 → 0 < β → γ 0 = x →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ t ∈ Set.Ioo α β, τ (γ t) = τ x + t := by
    intro γ α β hα hβ h0 hγ hγX t ht
    have := hτlin γ α β 0 ⟨hα, hβ⟩ hγ hγX t ht
    rw [this, h0, sub_zero]
  have h0 : ∃ α β : ℝ, α < 0 ∧ 0 < β ∧ ∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X := by
    have hxO : x ∈ O := hSM x hx 0 (by ring) hT₁ hT₂
    obtain ⟨h1, h2, h3⟩ := hΨ x hxO
    exact ⟨-ε, ε, by linarith, hε, Ψ x, h1, h2, h3⟩
  have hfwd : ∀ α β : ℝ, α < 0 → 0 < β → β ≤ T₂ → (∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∃ α' β' : ℝ, α' ≤ α ∧ β + δ ≤ β' ∧ ∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α' β') ∧ ∀ t ∈ Set.Ioo α' β', γ t ∈ X := by
    rintro α β hα hβ hβT ⟨γ, hγ0, hγ, hγX⟩
    have ht₁ : max 0 (β - δ) ∈ Set.Ioo α β :=
      ⟨lt_of_lt_of_le hα (le_max_left _ _), max_lt hβ (by linarith)⟩
    have hyO : γ (max 0 (β - δ)) ∈ O :=
      hSM _ (hγX _ ht₁) _ (hτ0 γ α β hα hβ hγ0 hγ hγX _ ht₁)
        (le_trans hT₁ (le_max_left _ _)) (max_le hT₂ (by linarith))
    obtain ⟨γ'', h1, h2, h3⟩ := hext γ α β _ ht₁ hγ hγX hyO
    refine ⟨_, _, min_le_left _ _, ?_, γ'', ?_, h1, h2⟩
    · have := le_max_right 0 (β - δ)
      have := le_max_right β (max 0 (β - δ) + ε)
      linarith
    · rw [h3 ⟨hα, hβ⟩, hγ0]
  have hbwd : ∀ α β : ℝ, α < 0 → 0 < β → T₁ ≤ α → (∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∃ α' β' : ℝ, α' ≤ α - δ ∧ β ≤ β' ∧ ∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α' β') ∧ ∀ t ∈ Set.Ioo α' β', γ t ∈ X := by
    rintro α β hα hβ hTα ⟨γ, hγ0, hγ, hγX⟩
    have ht₂ : min 0 (α + δ) ∈ Set.Ioo α β :=
      ⟨lt_min hα (by linarith), lt_of_le_of_lt (min_le_left _ _) hβ⟩
    have hyO : γ (min 0 (α + δ)) ∈ O :=
      hSM _ (hγX _ ht₂) _ (hτ0 γ α β hα hβ hγ0 hγ hγX _ ht₂)
        (le_min hT₁ (by linarith)) (le_trans (min_le_left _ _) hT₂)
    obtain ⟨γ'', h1, h2, h3⟩ := hext γ α β _ ht₂ hγ hγX hyO
    refine ⟨_, _, ?_, le_max_left _ _, γ'', ?_, h1, h2⟩
    · have := min_le_right α (min 0 (α + δ) - ε)
      have := min_le_right 0 (α + δ)
      linarith
    · rw [h3 ⟨hα, hβ⟩, hγ0]
  
  have hQ : ∀ n : ℕ, ∃ α β : ℝ, α < 0 ∧ 0 < β ∧ (∃ γ : ℝ → M, γ 0 = x ∧
      IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X) ∧
      (T₂ < β ∨ (n : ℝ) * δ ≤ β) ∧ (α < T₁ ∨ α ≤ -((n : ℝ) * δ)) := by
    intro n
    induction n with
    | zero =>
      obtain ⟨α, β, hα, hβ, hP⟩ := h0
      exact ⟨α, β, hα, hβ, hP, Or.inr (by simp; linarith), Or.inr (by simp; linarith)⟩
    | succ n ih =>
      obtain ⟨α, β, hα, hβ, hP, hF, hB⟩ := ih
      have hring : ((n : ℝ) + 1) * δ = (n : ℝ) * δ + δ := by ring
      push_cast
      obtain ⟨α₁, β₁, hα₁, hβ₁, hP₁, hF₁, hαα₁, hββ₁⟩ : ∃ α₁ β₁ : ℝ, α₁ < 0 ∧ 0 < β₁ ∧
          (∃ γ : ℝ → M, γ 0 = x ∧
            IsMIntegralCurveOn γ V (Set.Ioo α₁ β₁) ∧ ∀ t ∈ Set.Ioo α₁ β₁, γ t ∈ X) ∧
          (T₂ < β₁ ∨ ((n : ℝ) + 1) * δ ≤ β₁) ∧ α₁ ≤ α ∧ β ≤ β₁ := by
        by_cases hT : T₂ < β
        · exact ⟨α, β, hα, hβ, hP, Or.inl hT, le_rfl, le_rfl⟩
        · have hT' : β ≤ T₂ := le_of_not_gt hT
          obtain ⟨α', β', h1, h2, h3⟩ := hfwd α β hα hβ hT' hP
          have hnδ : (n : ℝ) * δ ≤ β := hF.resolve_left hT
          exact ⟨α', β', by linarith, by linarith, h3, Or.inr (by linarith), h1, by linarith⟩
      have hB₁ : α₁ < T₁ ∨ α₁ ≤ -((n : ℝ) * δ) := by
        rcases hB with h | h
        · left; linarith
        · right; linarith
      by_cases hT : α₁ < T₁
      · exact ⟨α₁, β₁, hα₁, hβ₁, hP₁, hF₁, Or.inl hT⟩
      · have hT' : T₁ ≤ α₁ := le_of_not_gt hT
        obtain ⟨α', β', h1, h2, h3⟩ := hbwd α₁ β₁ hα₁ hβ₁ hT' hP₁
        have hnδ : α₁ ≤ -((n : ℝ) * δ) := hB₁.resolve_left hT
        refine ⟨α', β', by linarith, by linarith, h3, ?_, Or.inr (by linarith)⟩
        rcases hF₁ with h | h
        · left; linarith
        · right; linarith
  
  obtain ⟨N, hN⟩ := exists_nat_gt (max T₂ (-T₁) / δ)
  have hNδ : max T₂ (-T₁) < (N : ℝ) * δ := by rwa [div_lt_iff₀ hδpos] at hN
  obtain ⟨α, β, hα, hβ, ⟨γ, hγ0, hγ, hγX⟩, hF, hB⟩ := hQ N
  have e1 := le_max_left T₂ (-T₁)
  have e2 := le_max_right T₂ (-T₁)
  refine ⟨γ, α, β, ?_, ?_, hγ0, hγ, hγX⟩
  · rcases hB with h | h
    · exact h
    · linarith
  · rcases hF with h | h
    · exact h
    · linarith

theorem global_flow_assembly (X : Set M) (hX : IsOpen X) (τ : M → ℝ) (a b : ℝ)
    (hτc : ContinuousOn τ X) (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b)
    (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x)
    (huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β))
    (hτlin : ∀ (γ : ℝ → M) (α β s₀ : ℝ), s₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀))
    (hunif : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      IsOpen O ∧ X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Ψ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X)
    (hlong : ∀ x ∈ X, ∀ T₁ T₂ : ℝ, T₁ ≤ 0 → 0 ≤ T₂ → a < τ x + T₁ → τ x + T₂ < b →
      ∃ (γ : ℝ → M) (α β : ℝ), α < T₁ ∧ T₂ < β ∧ γ 0 = x ∧
        IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X) :
    ∃ Θ : M → ℝ → M,
      (∀ x ∈ X, ∀ s : ℝ, a < τ x + s → τ x + s < b → Θ x s ∈ X ∧ τ (Θ x s) = τ x + s) ∧
      (∀ x ∈ X, Θ x 0 = x) ∧
      (∀ x ∈ X, ∀ s s' : ℝ, a < τ x + s → τ x + s < b → a < τ x + s + s' →
        τ x + s + s' < b → Θ (Θ x s) s' = Θ x (s + s')) ∧
      ContinuousOn (fun p : M × ℝ => Θ p.1 p.2)
        {p : M × ℝ | p.1 ∈ X ∧ a < τ p.1 + p.2 ∧ τ p.1 + p.2 < b} :=
by
  classical
  
  have hsel : ∃ Θ : M → ℝ → M, ∀ (x : M) (γ : ℝ → M) (α β t : ℝ), (0 : ℝ) ∈ Set.Ioo α β →
      t ∈ Set.Ioo α β → IsMIntegralCurveOn γ V (Set.Ioo α β) →
      (∀ u ∈ Set.Ioo α β, γ u ∈ X) → γ 0 = x → Θ x t = γ t := by
    refine ⟨fun x t => if h : ∃ (γ : ℝ → M) (α β : ℝ), (0 : ℝ) ∈ Set.Ioo α β ∧
        t ∈ Set.Ioo α β ∧ IsMIntegralCurveOn γ V (Set.Ioo α β) ∧
        (∀ u ∈ Set.Ioo α β, γ u ∈ X) ∧ γ 0 = x
      then Classical.choose h t else x, ?_⟩
    intro x γ α β t h0 ht hγ hγX hγ0
    have hP : ∃ (γ : ℝ → M) (α β : ℝ), (0 : ℝ) ∈ Set.Ioo α β ∧
        t ∈ Set.Ioo α β ∧ IsMIntegralCurveOn γ V (Set.Ioo α β) ∧
        (∀ u ∈ Set.Ioo α β, γ u ∈ X) ∧ γ 0 = x :=
      ⟨γ, α, β, h0, ht, hγ, hγX, hγ0⟩
    dsimp only
    rw [dif_pos hP]
    obtain ⟨α₀, β₀, h0', ht', hγ', hγX', hγ0'⟩ := Classical.choose_spec hP
    have hsub1 : Set.Ioo (max α α₀) (min β β₀) ⊆ Set.Ioo α β := fun u hu =>
      ⟨lt_of_le_of_lt (le_max_left _ _) hu.1, lt_of_lt_of_le hu.2 (min_le_left _ _)⟩
    have hsub2 : Set.Ioo (max α α₀) (min β β₀) ⊆ Set.Ioo α₀ β₀ := fun u hu =>
      ⟨lt_of_le_of_lt (le_max_right _ _) hu.1, lt_of_lt_of_le hu.2 (min_le_right _ _)⟩
    have hmem : ∀ u, u ∈ Set.Ioo α β → u ∈ Set.Ioo α₀ β₀ →
        u ∈ Set.Ioo (max α α₀) (min β β₀) :=
      fun u h1 h2 => ⟨max_lt h1.1 h2.1, lt_min h1.2 h2.2⟩
    have hEq := huniq (Classical.choose hP) γ (max α α₀) (min β β₀) 0 (hmem 0 h0 h0')
      (hγ'.mono hsub2) (hγ.mono hsub1)
      (fun u hu => hγX' u (hsub2 hu)) (fun u hu => hγX u (hsub1 hu)) (hγ0'.trans hγ0.symm)
    exact hEq (hmem t ht ht')
  obtain ⟨Θ, hK⟩ := hsel
  
  have F1 : ∀ x ∈ X, ∀ s : ℝ, a < τ x + s → τ x + s < b →
      Θ x s ∈ X ∧ τ (Θ x s) = τ x + s := by
    intro x hx s h1 h2
    have hb := hτb x hx
    have hA : a < τ x + min s 0 := by
      rcases min_choice s 0 with h | h <;> rw [h] <;> linarith
    have hB : τ x + max s 0 < b := by
      rcases max_choice s 0 with h | h <;> rw [h] <;> linarith
    obtain ⟨γ, α, β, hα, hβ, hγ0, hγ, hγX⟩ :=
      hlong x hx (min s 0) (max s 0) (min_le_right _ _) (le_max_right _ _) hA hB
    have e1 := min_le_right s 0
    have e2 := min_le_left s 0
    have e3 := le_max_right s 0
    have e4 := le_max_left s 0
    have h0 : (0 : ℝ) ∈ Set.Ioo α β := ⟨by linarith, by linarith⟩
    have hs : s ∈ Set.Ioo α β := ⟨by linarith, by linarith⟩
    rw [hK x γ α β s h0 hs hγ hγX hγ0]
    refine ⟨hγX s hs, ?_⟩
    rw [hτlin γ α β 0 h0 hγ hγX s hs, hγ0, sub_zero]
  
  have F2 : ∀ x ∈ X, Θ x 0 = x := by
    intro x hx
    obtain ⟨γ, α, β, hα, hβ, hγ0, hγ, hγX⟩ := hlong x hx 0 0 le_rfl le_rfl
      (by rw [add_zero]; exact (hτb x hx).1) (by rw [add_zero]; exact (hτb x hx).2)
    rw [hK x γ α β 0 ⟨hα, hβ⟩ ⟨hα, hβ⟩ hγ hγX hγ0, hγ0]
  
  have F3 : ∀ x ∈ X, ∀ s s' : ℝ, a < τ x + s → τ x + s < b → a < τ x + s + s' →
      τ x + s + s' < b → Θ (Θ x s) s' = Θ x (s + s') := by
    intro x hx s s' h1 h2 h3 h4
    have hb := hτb x hx
    obtain ⟨T₁, hT₁⟩ : ∃ T : ℝ, T = min 0 (min s (s + s')) := ⟨_, rfl⟩
    obtain ⟨T₂, hT₂⟩ : ∃ T : ℝ, T = max 0 (max s (s + s')) := ⟨_, rfl⟩
    have e1 : T₁ ≤ 0 := hT₁ ▸ min_le_left _ _
    have e2 : T₁ ≤ s := hT₁ ▸ (min_le_right _ _).trans (min_le_left _ _)
    have e3 : T₁ ≤ s + s' := hT₁ ▸ (min_le_right _ _).trans (min_le_right _ _)
    have f1 : 0 ≤ T₂ := hT₂ ▸ le_max_left _ _
    have f2 : s ≤ T₂ := hT₂ ▸ (le_max_left _ _).trans (le_max_right _ _)
    have f3 : s + s' ≤ T₂ := hT₂ ▸ (le_max_right _ _).trans (le_max_right _ _)
    have hA : a < τ x + T₁ := by
      rcases min_choice 0 (min s (s + s')) with h | h
      · linarith
      · rcases min_choice s (s + s') with h' | h' <;> linarith
    have hB : τ x + T₂ < b := by
      rcases max_choice 0 (max s (s + s')) with h | h
      · linarith
      · rcases max_choice s (s + s') with h' | h' <;> linarith
    obtain ⟨γ, α, β, hα, hβ, hγ0, hγ, hγX⟩ := hlong x hx T₁ T₂ e1 f1 hA hB
    have m0 : (0 : ℝ) ∈ Set.Ioo α β := ⟨by linarith, by linarith⟩
    have ms : s ∈ Set.Ioo α β := ⟨by linarith, by linarith⟩
    have mss : s + s' ∈ Set.Ioo α β := ⟨by linarith, by linarith⟩
    rw [hK x γ α β s m0 ms hγ hγX hγ0, hK x γ α β (s + s') m0 mss hγ hγX hγ0]
    have hδ : IsMIntegralCurveOn (γ ∘ fun u => u + s) V (Set.Ioo (α - s) (β - s)) :=
      (hγ.comp_add s).mono (fun u hu => by
        show u + s ∈ Set.Ioo α β
        exact ⟨by linarith [hu.1], by linarith [hu.2]⟩)
    have hδX : ∀ u ∈ Set.Ioo (α - s) (β - s), (γ ∘ fun u => u + s) u ∈ X := fun u hu =>
      hγX (u + s) ⟨by linarith [hu.1], by linarith [hu.2]⟩
    have hδ0 : (γ ∘ fun u => u + s) 0 = γ s := by simp
    have hfin := hK (γ s) (γ ∘ fun u => u + s) (α - s) (β - s) s'
      ⟨by linarith [ms.1], by linarith [ms.2]⟩
      ⟨by linarith [mss.1], by linarith [mss.2]⟩ hδ hδX hδ0
    rw [hfin]
    show γ (s' + s) = γ (s + s')
    rw [add_comm]
  
  have hshort : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ),
      X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Θ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) := by
    intro c d hc hd
    obtain ⟨O, ε, Ψ, -, hKO, -, hε, hΨc, hΨ⟩ := hunif c d hc hd
    refine ⟨O, ε, hKO, hε, hΨc.congr ?_⟩
    intro p hp
    obtain ⟨h0, hint, hXΨ⟩ := hΨ p.1 hp.1
    exact hK p.1 (Ψ p.1) (-ε) ε p.2 ⟨by linarith, hε⟩ hp.2 hint hXΨ h0
  
  refine ⟨Θ, F1, F2, F3, ?_⟩
  rintro ⟨x₀, s₀⟩ ⟨hx₀, hl₀, hu₀⟩
  have hl₀' : a < τ x₀ + s₀ := hl₀
  have hu₀' : τ x₀ + s₀ < b := hu₀
  have hb₀ := hτb x₀ hx₀
  obtain ⟨μ, hμ⟩ : ∃ μ : ℝ, μ = min (τ x₀) (τ x₀ + s₀) := ⟨_, rfl⟩
  obtain ⟨ν, hν⟩ : ∃ ν : ℝ, ν = max (τ x₀) (τ x₀ + s₀) := ⟨_, rfl⟩
  have hμ1 : μ ≤ τ x₀ := hμ ▸ min_le_left _ _
  have hμ2 : μ ≤ τ x₀ + s₀ := hμ ▸ min_le_right _ _
  have hν1 : τ x₀ ≤ ν := hν ▸ le_max_left _ _
  have hν2 : τ x₀ + s₀ ≤ ν := hν ▸ le_max_right _ _
  have hμa : a < μ := by rw [hμ]; exact lt_min hb₀.1 hl₀'
  have hνb : ν < b := by rw [hν]; exact max_lt hb₀.2 hu₀'
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min (μ - a) (b - ν) / 3 := ⟨_, rfl⟩
  have hηpos : 0 < η := by
    rw [hη]; exact div_pos (lt_min (by linarith) (by linarith)) (by norm_num)
  have hη1 : 3 * η ≤ μ - a := by rw [hη]; linarith [min_le_left (μ - a) (b - ν)]
  have hη2 : 3 * η ≤ b - ν := by rw [hη]; linarith [min_le_right (μ - a) (b - ν)]
  obtain ⟨O, ε, hKO, hε, hΘc⟩ := hshort (μ - 2 * η) (ν + 2 * η) (by linarith) (by linarith)
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = ⌈(|s₀| + η) / ε⌉₊ + 1 := ⟨_, rfl⟩
  have hNpos : (0 : ℝ) < n := by rw [hn]; positivity
  have hNne : (n : ℝ) ≠ 0 := hNpos.ne'
  have hNε : |s₀| + η < n * ε := by
    have h1 : (|s₀| + η) / ε ≤ ⌈(|s₀| + η) / ε⌉₊ := Nat.le_ceil _
    rw [div_le_iff₀ hε] at h1
    have h2 : (n : ℝ) = (⌈(|s₀| + η) / ε⌉₊ : ℝ) + 1 := by rw [hn]; push_cast; ring
    have h3 : (n : ℝ) * ε = (⌈(|s₀| + η) / ε⌉₊ : ℝ) * ε + ε := by rw [h2]; ring
    linarith
  have hUo : IsOpen (X ∩ τ ⁻¹' Set.Ioo (τ x₀ - η) (τ x₀ + η)) :=
    hτc.isOpen_inter_preimage hX isOpen_Ioo
  obtain ⟨W, hWdef⟩ : ∃ W : Set (M × ℝ),
      W = (X ∩ τ ⁻¹' Set.Ioo (τ x₀ - η) (τ x₀ + η)) ×ˢ Set.Ioo (s₀ - η) (s₀ + η) :=
    ⟨_, rfl⟩
  have hWo : IsOpen W := by rw [hWdef]; exact hUo.prod isOpen_Ioo
  have hpW : ((x₀, s₀) : M × ℝ) ∈ W := by
    rw [hWdef]
    exact Set.mk_mem_prod ⟨hx₀, ⟨by linarith, by linarith⟩⟩ ⟨by linarith, by linarith⟩
  have hWmem : ∀ p ∈ W, p.1 ∈ X ∧ τ x₀ - η < τ p.1 ∧ τ p.1 < τ x₀ + η ∧
      s₀ - η < p.2 ∧ p.2 < s₀ + η := by
    intro p hp
    rw [hWdef] at hp
    obtain ⟨⟨hx, h1, h2⟩, h3, h4⟩ := hp
    exact ⟨hx, h1, h2, h3, h4⟩
  have hslab : ∀ p ∈ W, ∀ k : ℕ, k ≤ n →
      μ - 2 * η ≤ τ p.1 + (k : ℝ) * p.2 / n ∧ τ p.1 + (k : ℝ) * p.2 / n ≤ ν + 2 * η := by
    intro p hp k hk
    obtain ⟨hx, h1, h2, h3, h4⟩ := hWmem p hp
    have hθ0 : (0 : ℝ) ≤ (k : ℝ) / n := by positivity
    have hθ1 : (k : ℝ) / n ≤ 1 := (div_le_one hNpos).mpr (by exact_mod_cast hk)
    have heq : τ p.1 + (k : ℝ) * p.2 / n =
        (1 - (k : ℝ) / n) * τ p.1 + ((k : ℝ) / n) * (τ p.1 + p.2) := by ring
    rw [heq]
    constructor
    · nlinarith [mul_nonneg (sub_nonneg.mpr hθ1)
          (show (0 : ℝ) ≤ τ p.1 - (μ - 2 * η) by linarith),
        mul_nonneg hθ0 (show (0 : ℝ) ≤ τ p.1 + p.2 - (μ - 2 * η) by linarith)]
    · nlinarith [mul_nonneg (sub_nonneg.mpr hθ1)
          (show (0 : ℝ) ≤ (ν + 2 * η) - τ p.1 by linarith),
        mul_nonneg hθ0 (show (0 : ℝ) ≤ (ν + 2 * η) - (τ p.1 + p.2) by linarith)]
  have hstep : ∀ p ∈ W, p.2 / n ∈ Set.Ioo (-ε) ε := by
    intro p hp
    obtain ⟨-, -, -, h3, h4⟩ := hWmem p hp
    have habs : |p.2| < n * ε := by
      rw [abs_lt]
      constructor
      · have := neg_abs_le s₀; linarith
      · have := le_abs_self s₀; linarith
    have hlt : |p.2 / n| < ε := by
      rw [abs_div, abs_of_pos hNpos, div_lt_iff₀ hNpos]; linarith
    exact abs_lt.mp hlt
  have hM : ∀ p ∈ W, ∀ k : ℕ, k ≤ n → Θ p.1 ((k : ℝ) * p.2 / n) ∈ O := by
    intro p hp k hk
    obtain ⟨hx, -⟩ := hWmem p hp
    obtain ⟨h1, h2⟩ := hslab p hp k hk
    obtain ⟨hX', hτ'⟩ := F1 p.1 hx _ (by linarith) (by linarith)
    exact hKO ⟨hX', by rw [Set.mem_preimage, hτ']; exact ⟨h1, h2⟩⟩
  have hR : ∀ p ∈ W, ∀ k : ℕ, k + 1 ≤ n →
      Θ (Θ p.1 ((k : ℝ) * p.2 / n)) (p.2 / n) = Θ p.1 (((k + 1 : ℕ) : ℝ) * p.2 / n) := by
    intro p hp k hk
    obtain ⟨hx, -⟩ := hWmem p hp
    obtain ⟨h1, h2⟩ := hslab p hp k (by omega)
    obtain ⟨h3, h4⟩ := hslab p hp (k + 1) hk
    have heq : (k : ℝ) * p.2 / n + p.2 / n = ((k + 1 : ℕ) : ℝ) * p.2 / n := by
      push_cast; ring
    rw [F3 p.1 hx _ _ (by linarith) (by linarith) (by linarith) (by linarith), heq]
  have hC : ∀ k : ℕ, k ≤ n →
      ContinuousOn (fun p : M × ℝ => Θ p.1 ((k : ℝ) * p.2 / n)) W := by
    intro k
    induction k with
    | zero =>
      intro _
      refine continuousOn_fst.congr ?_
      intro p hp
      obtain ⟨hx, -⟩ := hWmem p hp
      simp only [Nat.cast_zero, zero_mul, zero_div]
      exact F2 p.1 hx
    | succ k ih =>
      intro hk
      have hcont : ContinuousOn (fun p : M × ℝ => (Θ p.1 ((k : ℝ) * p.2 / n), p.2 / n)) W :=
        (ih (by omega)).prodMk (continuous_snd.div_const _).continuousOn
      have hmaps : Set.MapsTo (fun p : M × ℝ => (Θ p.1 ((k : ℝ) * p.2 / n), p.2 / n)) W
          (O ×ˢ Set.Ioo (-ε) ε) :=
        fun p hp => Set.mk_mem_prod (hM p hp k (by omega)) (hstep p hp)
      refine (hΘc.comp hcont hmaps).congr ?_
      intro p hp
      exact (hR p hp k hk).symm
  have hF : ContinuousOn (fun p : M × ℝ => Θ p.1 p.2) W := by
    refine (hC n le_rfl).congr ?_
    intro p _
    have h : (n : ℝ) * p.2 / n = p.2 := mul_div_cancel_left₀ p.2 hNne
    simp only [h]
  exact (hF.continuousAt (hWo.mem_nhds hpW)).continuousWithinAt

theorem proper_submersion_interval_trivial [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (X : Set M) (hX : IsOpen X) (τ : M → ℝ) (a b m : ℝ)
    (ham : a < m) (hmb : m < b) (hτs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X)
    (hτr : ∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0)
    (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b)
    (hτp : ∀ c d : ℝ, a < c → d < b → IsCompact (X ∩ τ ⁻¹' Set.Icc c d)) :
    Nonempty (↥X ≃ₜ ↥(X ∩ τ ⁻¹' {m}) × ↥(Set.Ioo a b)) :=
by
  
  obtain ⟨V, hVs, hVτ⟩ := tau_gradient_field g X hX τ hτs hτr
  
  have hloc : ∀ x₀ ∈ X, ∃ (N : Set M) (ε : ℝ) (ψ : M → ℝ → M), IsOpen N ∧ x₀ ∈ N ∧ N ⊆ X ∧
      0 < ε ∧ ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, ψ x s ∈ X :=
    fun x₀ hx₀ => local_flow_of_contMDiffAt X hX V x₀ hx₀ (hVs x₀ hx₀)
  
  have huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β) :=
    fun γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀ =>
      integral_curve_eqOn_of_mem X V hVs γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀
  
  have hτlin : ∀ (γ : ℝ → M) (α β s₀ : ℝ), s₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀) :=
    fun γ α β s₀ hs₀ hγ hγX =>
      tau_affine_along_integral_curve X hX τ hτs V hVτ γ α β s₀ hs₀ hγ hγX
  
  have hunif : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      IsOpen O ∧ X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Ψ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X :=
    fun c d hc hd => uniform_flow_on_compact X (X ∩ τ ⁻¹' Set.Icc c d) Set.inter_subset_left
      (hτp c d hc hd) V hloc huniq
  
  have hunif' : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X := by
    intro c d hc hd
    obtain ⟨O, ε, Ψ, _, h1, h2, h3, _, h5⟩ := hunif c d hc hd
    exact ⟨O, ε, Ψ, h1, h2, h3, h5⟩
  have hlong : ∀ x ∈ X, ∀ T₁ T₂ : ℝ, T₁ ≤ 0 → 0 ≤ T₂ → a < τ x + T₁ → τ x + T₂ < b →
      ∃ (γ : ℝ → M) (α β : ℝ), α < T₁ ∧ T₂ < β ∧ γ 0 = x ∧
        IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X :=
    fun x hx T₁ T₂ h1 h2 h3 h4 =>
      long_integral_curve_exists X τ a b V hτb huniq hτlin hunif' x hx T₁ T₂ h1 h2 h3 h4
  
  obtain ⟨Θ, hF1, hF2, hF3, hF4⟩ :=
    global_flow_assembly X hX τ a b hτs.continuousOn hτb V huniq hτlin hunif hlong
  
  exact homeomorph_of_tau_flow X τ a b m ham hmb hτs.continuousOn hτb Θ hF1 hF2 hF3 hF4

theorem fderiv_pos_proportional (F F' : E3 → ℝ) (y₀ : E3) (hF : DifferentiableAt ℝ F y₀)
    (hF' : DifferentiableAt ℝ F' y₀) (h0 : F y₀ = 0) (h0' : F' y₀ = 0)
    (hne : fderiv ℝ F y₀ ≠ 0) (hne' : fderiv ℝ F' y₀ ≠ 0)
    (hsgn : ∀ᶠ y in 𝓝 y₀, 0 ≤ F y * F' y) :
    ∃ c : ℝ, 0 < c ∧ fderiv ℝ F' y₀ = c • fderiv ℝ F y₀ :=
by
  
  have hdir : ∀ v : E3, 0 ≤ fderiv ℝ F y₀ v * fderiv ℝ F' y₀ v := by
    intro v
    by_contra hneg
    push_neg at hneg
    have hγ : HasDerivAt (fun t : ℝ => y₀ + t • v) v 0 := by
      have h1 : HasDerivAt (fun t : ℝ => t • v) ((1 : ℝ) • v) 0 :=
        (hasDerivAt_id (0 : ℝ)).smul_const v
      rw [one_smul] at h1
      exact h1.const_add y₀
    have hγ0 : (fun t : ℝ => y₀ + t • v) 0 = y₀ := by simp
    have hslope : ∀ (G : E3 → ℝ), DifferentiableAt ℝ G y₀ → G y₀ = 0 →
        Tendsto (fun t : ℝ => t⁻¹ * G (y₀ + t • v)) (𝓝[≠] 0) (𝓝 (fderiv ℝ G y₀ v)) := by
      intro G hG hG0
      have hGa : HasFDerivAt G (fderiv ℝ G y₀) ((fun t : ℝ => y₀ + t • v) 0) := by
        rw [hγ0]; exact hG.hasFDerivAt
      have hd : HasDerivAt (G ∘ fun t : ℝ => y₀ + t • v) (fderiv ℝ G y₀ v) 0 :=
        hGa.comp_hasDerivAt (0 : ℝ) hγ
      have ht := (hasDerivAt_iff_tendsto_slope_zero).mp hd
      refine ht.congr' ?_
      filter_upwards with t
      simp [Function.comp, hG0, smul_eq_mul]
    have hprod := (hslope F hF h0).mul (hslope F' hF' h0')
    have hev1 := hprod.eventually_lt_const hneg
    have hcont : Tendsto (fun t : ℝ => y₀ + t • v) (𝓝 0) (𝓝 y₀) := by
      have h := (hγ.continuousAt).tendsto
      simpa using h
    have hev2 : ∀ᶠ t in 𝓝[≠] (0 : ℝ), 0 ≤ F (y₀ + t • v) * F' (y₀ + t • v) :=
      (hcont.eventually hsgn).filter_mono nhdsWithin_le_nhds
    obtain ⟨t, ht1, ht2⟩ := (hev1.and hev2).exists
    have : (t⁻¹ * F (y₀ + t • v)) * (t⁻¹ * F' (y₀ + t • v)) =
        (t⁻¹ * t⁻¹) * (F (y₀ + t • v) * F' (y₀ + t • v)) := by ring
    have h3 : 0 ≤ (t⁻¹ * t⁻¹) * (F (y₀ + t • v) * F' (y₀ + t • v)) :=
      mul_nonneg (mul_self_nonneg _) ht2
    linarith
  
  set L := fderiv ℝ F y₀ with hLdef
  set L' := fderiv ℝ F' y₀ with hL'def
  obtain ⟨v₀, hv₀⟩ : ∃ v₀ : E3, L v₀ ≠ 0 := by
    by_contra hall
    push_neg at hall
    exact hne (ContinuousLinearMap.ext fun x => by simp [hall x])
  set a := L v₀ with ha
  set b := L' v₀ with hb
  set c := b / a with hc
  have hbc : b = c * a := by rw [hc]; field_simp
  have hprop : ∀ w : E3, L' w = c * L w := by
    intro w
    set x := L w with hx
    set y := L' w with hy
    set δ := y - c * x with hδ
    set κ := 1 / (1 + |a * b|) with hκ
    have hpos1 : 0 < 1 + |a * b| := by positivity
    have hκpos : 0 < κ := by positivity
    have hκmul : κ * (1 + |a * b|) = 1 := by rw [hκ]; field_simp
    set t := -(δ * a * κ) with ht
    have hLv : L (w + (t - x / a) • v₀) = t * a := by
      rw [map_add, map_smul, smul_eq_mul, ← hx, ← ha]
      field_simp
      ring
    have hL'v : L' (w + (t - x / a) • v₀) = δ + t * b := by
      rw [map_add, map_smul, smul_eq_mul, ← hy, ← hb, hbc, hδ]
      field_simp
      ring
    have hP := hdir (w + (t - x / a) • v₀)
    rw [hLv, hL'v] at hP
    have hkey : t * a * (δ + t * b) = (δ * a) ^ 2 * (κ * (κ * (a * b) - 1)) := by
      rw [ht]; ring
    rw [hkey] at hP
    have hab : κ * (a * b) < 1 := by
      have h1 : a * b ≤ |a * b| := le_abs_self _
      have h2 : κ * (a * b) ≤ κ * |a * b| := mul_le_mul_of_nonneg_left h1 hκpos.le
      nlinarith
    have hneg : κ * (κ * (a * b) - 1) < 0 := mul_neg_of_pos_of_neg hκpos (by linarith)
    have hsq : (δ * a) ^ 2 ≤ 0 := by
      by_contra hcon
      push_neg at hcon
      have := mul_neg_of_pos_of_neg hcon hneg
      linarith
    have hsq0 : (δ * a) ^ 2 = 0 := le_antisymm hsq (sq_nonneg _)
    have hδa : δ * a = 0 := pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hsq0
    have hδ0 : δ = 0 := by
      rcases mul_eq_zero.mp hδa with h | h
      · exact h
      · exact absurd h hv₀
    rw [hδ] at hδ0
    linarith
  have hL'eq : L' = c • L := ContinuousLinearMap.ext fun w => by
    rw [ContinuousLinearMap.smul_apply, smul_eq_mul]
    exact hprop w
  refine ⟨c, ?_, hL'eq⟩
  have hc0 : c ≠ 0 := by
    intro h
    apply hne'
    rw [hL'eq, h, zero_smul]
  have hcnn : 0 ≤ c := by
    have h : 0 ≤ a * b := hdir v₀
    rw [hbc] at h
    by_contra hcon
    push_neg at hcon
    have ha2 : 0 < a * a := mul_self_pos.mpr hv₀
    have : c * (a * a) < 0 := mul_neg_of_neg_of_pos hcon ha2
    nlinarith
  exact lt_of_le_of_ne hcnn (Ne.symm hc0)

theorem second_order_product_sum {ι : Type*} (J : Finset ι) (Ψ F : ι → E3 → ℝ) (U : Set E3)
    (hU : IsOpen U) (y₀ : E3) (hy₀ : y₀ ∈ U) (hΨ : ∀ m ∈ J, ContDiffOn ℝ ∞ (Ψ m) U)
    (hF : ∀ m ∈ J, ContDiffOn ℝ ∞ (F m) U) (hF0 : ∀ m ∈ J, F m y₀ = 0) :
    fderiv ℝ (fun z => ∑ m ∈ J, Ψ m z * F m z) y₀ = ∑ m ∈ J, Ψ m y₀ • fderiv ℝ (F m) y₀ ∧
      ∀ i j : Fin 3, partialDeriv i (partialDeriv j (fun z => ∑ m ∈ J, Ψ m z * F m z)) y₀ =
        ∑ m ∈ J, (Ψ m y₀ * partialDeriv i (partialDeriv j (F m)) y₀
          + partialDeriv i (Ψ m) y₀ * partialDeriv j (F m) y₀
          + partialDeriv i (F m) y₀ * partialDeriv j (Ψ m) y₀) :=
by
  
  have s2 : ∀ (A B : ι → E3 → ℝ) (y : E3), (∀ m ∈ J, DifferentiableAt ℝ (A m) y) →
      (∀ m ∈ J, DifferentiableAt ℝ (B m) y) →
      HasFDerivAt (fun z => ∑ m ∈ J, A m z * B m z)
        (∑ m ∈ J, (A m y • fderiv ℝ (B m) y + B m y • fderiv ℝ (A m) y)) y := by
    intro A B y hA hB
    exact HasFDerivAt.fun_sum (fun m hm => (hA m hm).hasFDerivAt.fun_mul (hB m hm).hasFDerivAt)
  
  have s1 : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ j : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv j f) U := by
    intro f hf j
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y (e j)) U
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2.clm_apply contDiffOn_const
  
  have hdiff : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ z ∈ U, DifferentiableAt ℝ f z := by
    intro f hf z hz
    exact (hf.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hz)
  refine ⟨?_, ?_⟩
  · rw [(s2 Ψ F y₀ (fun m hm => hdiff _ (hΨ m hm) y₀ hy₀)
      (fun m hm => hdiff _ (hF m hm) y₀ hy₀)).fderiv]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    rw [hF0 m hm, zero_smul, add_zero]
  · intro i j
    have hEq : partialDeriv j (fun z => ∑ m ∈ J, Ψ m z * F m z) =ᶠ[𝓝 y₀]
        fun z => (∑ m ∈ J, Ψ m z * partialDeriv j (F m) z)
          + ∑ m ∈ J, F m z * partialDeriv j (Ψ m) z := by
      filter_upwards [hU.mem_nhds hy₀] with z hz
      have h := (s2 Ψ F z (fun m hm => hdiff _ (hΨ m hm) z hz)
        (fun m hm => hdiff _ (hF m hm) z hz)).fderiv
      show fderiv ℝ (fun z => ∑ m ∈ J, Ψ m z * F m z) z (e j) =
        (∑ m ∈ J, Ψ m z * fderiv ℝ (F m) z (e j)) + ∑ m ∈ J, F m z * fderiv ℝ (Ψ m) z (e j)
      rw [h]
      simp only [ContinuousLinearMap.coe_sum', Finset.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.coe_smul', Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib]
    have hQ : HasFDerivAt (fun z => (∑ m ∈ J, Ψ m z * partialDeriv j (F m) z)
          + ∑ m ∈ J, F m z * partialDeriv j (Ψ m) z) _ y₀ :=
      (s2 Ψ (fun m => partialDeriv j (F m)) y₀ (fun m hm => hdiff _ (hΨ m hm) y₀ hy₀)
        (fun m hm => hdiff _ (s1 _ (hF m hm) j) y₀ hy₀)).add
      (s2 F (fun m => partialDeriv j (Ψ m)) y₀ (fun m hm => hdiff _ (hF m hm) y₀ hy₀)
        (fun m hm => hdiff _ (s1 _ (hΨ m hm) j) y₀ hy₀))
    show fderiv ℝ (partialDeriv j (fun z => ∑ m ∈ J, Ψ m z * F m z)) y₀ (e i) = _
    rw [hEq.fderiv_eq, hQ.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_sum', Finset.sum_apply,
      ContinuousLinearMap.coe_smul', Pi.smul_apply, smul_eq_mul, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    rw [hF0 m hm]
    simp only [partialDeriv]
    ring

theorem frontier_collar_function [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U) (hFc : IsCompact (frontier U))
    (hfront : IsMinimalSurfaceSet g (frontier U)) :
    ∃ (N : Set M) (ε : ℝ) (τ : M → ℝ), IsOpen N ∧ frontier U ⊆ N ∧ IsCompact (closure N) ∧
      0 < ε ∧ ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ (U ∩ N) ∧
      (∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) ∧
      (∀ x ∈ U ∩ N, 0 < τ x ∧ τ x < ε) ∧
      (∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ τ ⁻¹' Set.Icc c d)) ∧
      (∀ δ : ℝ, 0 < δ → δ < ε → IsClosed (frontier U ∪ (U ∩ N ∩ τ ⁻¹' Set.Iic δ))) ∧
      (∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
        U ∩ O ⊆ N ∩ τ ⁻¹' Set.Iio δ) :=
by
  classical
  haveI : LocallyCompactSpace M := ChartedSpace.locallyCompactSpace E3 M
  
  have hs1 : ∀ β : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β → ∀ p : M,
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0 → ∀ᶠ x in 𝓝 p, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β x ≠ 0 := by
    intro β hβ p hp
    have hcd : ContDiffOn ℝ ∞ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
      contMDiffOn_iff_contDiffOn.mp (hβ.comp_contMDiffOn contMDiffOn_chart_symm)
    have hcont : ContinuousOn (fderiv ℝ (fun y => β ((chartAt E3 p).symm y)))
        (chartAt E3 p).target :=
      hcd.continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)
    have hbr : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p =
        fderiv ℝ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
      have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p := hβ.mdifferentiableAt (by simp)
      rw [hmd.mfderiv]
      simp only [writtenInExtChartAt, extChartAt_coe, extChartAt_coe_symm, chartAt_self_eq,
        modelWithCornersSelf_coe, modelWithCornersSelf_coe_symm, Set.range_id, fderivWithin_univ,
        OpenPartialHomeomorph.refl_apply, Function.comp_def, id]
    have hne0 : fderiv ℝ (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0 := by
      rw [← hbr]; exact hp
    have hev : ∀ᶠ y in 𝓝 (chartAt E3 p p),
        fderiv ℝ (fun y => β ((chartAt E3 p).symm y)) y ≠ 0 :=
      (hcont.continuousAt ((chartAt E3 p).open_target.mem_nhds (mem_chart_target E3 p))).eventually_ne
        hne0
    have hev' := ((chartAt E3 p).continuousAt (mem_chart_source E3 p)).eventually hev
    filter_upwards [hev', chart_source_mem_nhds E3 p] with x hx hxs
    intro h0
    apply hx
    have hy : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hxs
    have hsx : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    have hmdβ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β ((chartAt E3 p).symm (chartAt E3 p x)) :=
      hβ.mdifferentiableAt (by simp)
    have hcs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 p).symm (chartAt E3 p).target :=
      contMDiffOn_chart_symm
    have hmds : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p x) :=
      (hcs.contMDiffAt ((chartAt E3 p).open_target.mem_nhds hy)).mdifferentiableAt (by simp)
    have hcomp := mfderiv_comp (chartAt E3 p x) hmdβ hmds
    have h0' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β ((chartAt E3 p).symm (chartAt E3 p x)) = 0 := by
      rw [hsx]; exact h0
