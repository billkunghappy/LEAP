      have h1 := (hpoleW y hyρ hyne).1
      have h2 := hδr hyδ
      rw [hr0x₀, Real.dist_eq, sub_zero, abs_of_pos (hr0pos y hyne)] at h2
      have h3 : Real.log (pcgbPoleRad P j₀ x₀ y) < -(C + 2) :=
        (Real.log_lt_iff_lt_exp (hr0pos y hyne)).mpr h2
      have h4 := (abs_le.mp h1).2
      linarith
    · have hpos : 0 < min δ ρ₂ / 2 := half_pos hε0
      have hy1d : dist (x₀ + (min δ ρ₂ / 2) • e2 0) x₀ = min δ ρ₂ / 2 := by
        rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_pos hpos]
        simp
      have hy1b : x₀ + (min δ ρ₂ / 2) • e2 0 ∈ Metric.ball x₀ (min δ ρ₂) := by
        rw [Metric.mem_ball, hy1d]
        linarith
      have hy1cb : x₀ + (min δ ρ₂ / 2) • e2 0 ∈ Metric.closedBall x₀ r₁ := by
        rw [Metric.mem_closedBall, hy1d]
        have := min_le_right δ ρ₂
        linarith
      have hy1W : x₀ + (min δ ρ₂ / 2) • e2 0 ∈ P.W j₀ := hball₁ hy1cb
      refine ⟨P.param j₀ (x₀ + (min δ ρ₂ / 2) • e2 0),
        ⟨hmemN _ hy1W hy1b, (hparamOS j₀ _ hy1W).2⟩, ?_, ?_⟩
      · have := hpos₁ _ hy1cb
        linarith
      · intro heq
        have h1 := congrArg (P.proj j₀) heq
        rw [P.proj_param j₀ _ hy1W, P.proj_param j₀ _ hx₀W] at h1
        have h2 := hy1d
        rw [h1, dist_self] at h2
        linarith
  
  have hneg : ∀ q ∈ S, 0 < b q → q ≠ P.param j₀ x₀ → w q < 0 :=
