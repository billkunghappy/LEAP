  have hκc : ∀ k : Fin 2, Continuous (fun z : E2 => ‖z‖ * |pd2 k η z| + η z) := fun k =>
    (continuous_norm.mul (hpdc k).abs).add hη.continuous
  have hκs : ∀ k : Fin 2, HasCompactSupport (fun z : E2 => ‖z‖ * |pd2 k η z| + η z) := fun k =>
