      linarith
    have h12 : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T,
        ‖(fun ζ => a (x₀ + ρ • ζ)) ζ - (fun ζ => a (x₀ + ρ • ζ)) 0‖ ≤ ε * ‖ζ‖ ^ (α : ℝ) := by
      intro ζ hζ
      simp only [smul_zero, add_zero]
      rw [← dist_eq_norm]
      have h1 := hHa.dist_le (hAS ζ hζ) hx₀
      rw [hdistA, Real.mul_rpow hρp.le (norm_nonneg _)] at h1
      have hρσ : ρ ≤ σ * R := le_trans h7a (mul_le_mul_of_nonneg_left hd₀R hσ0.le)
      have h2 : ρ ^ (α : ℝ) ≤ (σ * R) ^ (α : ℝ) := Real.rpow_le_rpow hρp.le hρσ hαr0.le
      have h3 : (K : ℝ) * ρ ^ (α : ℝ) ≤ ε :=
        le_trans (mul_le_mul_of_nonneg_left h2 hK0) (le_trans hσK heε)
      have hN : 0 ≤ ‖ζ‖ ^ (α : ℝ) := by positivity
      calc dist (a (x₀ + ρ • ζ)) (a x₀) ≤ (K : ℝ) * (ρ ^ (α : ℝ) * ‖ζ‖ ^ (α : ℝ)) := h1
        _ = ((K : ℝ) * ρ ^ (α : ℝ)) * ‖ζ‖ ^ (α : ℝ) := by ring
