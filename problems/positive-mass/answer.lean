    have hg0 := hIIm L hII x₀ hx₀ τ' hτ'0 hτ'1 d₀ hd₀p.le hd₀x
    have hRα : d₀ ^ (α : ℝ) ≤ R ^ (α : ℝ) := Real.rpow_le_rpow hd₀p.le hd₀R hαr0.le
    have hR1α : R ^ (1 + (α : ℝ)) = R * R ^ (α : ℝ) := by rw [Real.rpow_add hR, Real.rpow_one]
    have hB : (K : ℝ) * (d₀ * d₀ ^ (α : ℝ)) * (1 + 2 * ‖smthGrad w x₀‖) ≤ L * ε := by
      have hA2 : d₀ * d₀ ^ (α : ℝ) ≤ R * R ^ (α : ℝ) := mul_le_mul hd₀R hRα hdα.le hR.le
      have hA3 : d₀ ^ (α : ℝ) * (d₀ * ‖smthGrad w x₀‖) ≤
