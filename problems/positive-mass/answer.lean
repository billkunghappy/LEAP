          (gsSimonsE (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
            (gsAmbCod (g.coeff (chartAt E3 z).symm) F)) x ≤
      lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
        (gsSffSq (g.coeff (chartAt E3 z).symm) F) x at hsim
    have hprod := mul_le_mul_of_nonneg_right hKlo hax
    nlinarith [Real.sqrt_nonneg (gsSffSq (g.coeff (chartAt E3 z).symm) F x)]

theorem ejpRic_lower_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpos : ∀ y ∈ U, (G y).PosDef) : ∃ k₀ : ℝ, 0 ≤ k₀ ∧ ∀ (Φ : E3 → ℝ) (y : E3), y ∈ K → fderiv ℝ Φ y ≠ 0 → -k₀ ≤ ejpRic G Φ y :=
by
  have hpd : ∀ w : E3 → ℝ, ContDiffOn ℝ ∞ w U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i w) U := by
    intro w hw i
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ w y) U :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hw).2
    exact h1.clm_apply contDiffOn_const
  have h00 := hG 0 0
  have h01 := hG 0 1
  have h02 := hG 0 2
  have h10 := hG 1 0
  have h11 := hG 1 1
  have h12 := hG 1 2
  have h20 := hG 2 0
  have h21 := hG 2 1
  have h22 := hG 2 2
  have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) U := by
    simp only [Matrix.det_fin_three]
    fun_prop
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) U := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U := by
    intro i j
    have heq : ∀ y, (G y)⁻¹ i j = ((G y).det)⁻¹ * (G y).adjugate i j := by
      intro y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv]
    simp only [heq]
    exact (hdet.inv (fun y hy => (hpos y hy).det_pos.ne')).mul (hadj i j)
  have hchr : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    have hc : christoffel G k i j = fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y) := rfl
    rw [hc]
    apply ContDiffOn.mul contDiffOn_const
    apply ContDiffOn.sum
    intro l _
    exact (hinv k l).mul (((hpd _ (hG j l) i).add (hpd _ (hG i l) j)).sub (hpd _ (hG i j) l))
  have hric : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (fun y => ricci G j k y) U := by
    intro j k
    simp only [ricci]
    apply ContDiffOn.add
    · apply ContDiffOn.sum
      intro i _
      exact (hpd _ (hchr i j k) i).sub (hpd _ (hchr i i k) j)
    · apply ContDiffOn.sum
      intro i _
      apply ContDiffOn.sum
      intro p _
      exact ((hchr i i p).mul (hchr p j k)).sub ((hchr i j p).mul (hchr p i k))
  set T : Set (E3 × (Fin 3 → ℝ)) := K ×ˢ Metric.sphere (0 : Fin 3 → ℝ) 1 with hTdef
  have hT : IsCompact T := hK.prod (isCompact_sphere 0 1)
  set num : E3 × (Fin 3 → ℝ) → ℝ := fun p => ∑ j : Fin 3, ∑ k : Fin 3,
    ricci G j k p.1 * (∑ b : Fin 3, (G p.1)⁻¹ j b * p.2 b) *
      (∑ b : Fin 3, (G p.1)⁻¹ k b * p.2 b) with hnumdef
  set den : E3 × (Fin 3 → ℝ) → ℝ := fun p => ∑ i : Fin 3, ∑ j : Fin 3,
    (G p.1)⁻¹ i j * p.2 i * p.2 j with hdendef
  have hAc : ∀ i j : Fin 3, ContinuousOn (fun p : E3 × (Fin 3 → ℝ) => (G p.1)⁻¹ i j) T :=
    fun i j => ((hinv i j).continuousOn.mono hKU).comp continuous_fst.continuousOn
      (fun p hp => hp.1)
  have hBc : ∀ i j : Fin 3, ContinuousOn (fun p : E3 × (Fin 3 → ℝ) => ricci G i j p.1) T :=
    fun i j => ((hric i j).continuousOn.mono hKU).comp continuous_fst.continuousOn
      (fun p hp => hp.1)
  have hxc : ∀ b : Fin 3, ContinuousOn (fun p : E3 × (Fin 3 → ℝ) => p.2 b) T := fun b =>
    ((continuous_apply b).comp continuous_snd).continuousOn
  have hnum : ContinuousOn num T := by
    apply continuousOn_finset_sum
    intro j _
    apply continuousOn_finset_sum
    intro k _
    refine ((hBc j k).mul ?_).mul ?_
    · apply continuousOn_finset_sum
      intro b _
      exact (hAc j b).mul (hxc b)
    · apply continuousOn_finset_sum
      intro b _
      exact (hAc k b).mul (hxc b)
  have hden : ContinuousOn den T := by
    apply continuousOn_finset_sum
    intro i _
    apply continuousOn_finset_sum
    intro j _
    exact ((hAc i j).mul (hxc i)).mul (hxc j)
  have hdenpos : ∀ p ∈ T, 0 < den p := by
    rintro ⟨y, u⟩ ⟨hy, hu⟩
    have hu0 : u ≠ 0 := by
      intro h
      rw [h] at hu
      simp at hu
    have hP := (hpos y (hKU hy)).inv
    have h1 := hP.dotProduct_mulVec_pos hu0
    have h2 : dotProduct (star u) (Matrix.mulVec (G y)⁻¹ u) = den (y, u) := by
      simp only [hdendef, star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
      ring
    linarith
  have hf : ContinuousOn (fun p => num p / den p) T :=
    hnum.div hden (fun p hp => (hdenpos p hp).ne')
  obtain ⟨m, hm⟩ := hT.bddBelow_image hf
  refine ⟨max 0 (-m), le_max_left _ _, ?_⟩
  intro Φ y hy hd
  set ξ : Fin 3 → ℝ := fun i => partialDeriv i Φ y with hξdef
  have hξ0 : ξ ≠ 0 := by
    intro h
    apply hd
    have hz : ∀ i : Fin 3, fderiv ℝ Φ y (e i) = 0 := by
      intro i
      have := congrFun h i
      simpa [hξdef, partialDeriv] using this
    have hv : ∀ v : E3, v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      intro v
      ext i
      fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    refine ContinuousLinearMap.ext (fun v => ?_)
    rw [hv v, map_add, map_add, map_smul, map_smul, map_smul, hz 0, hz 1, hz 2]
    simp
  have hr : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ0
  set u : Fin 3 → ℝ := ‖ξ‖⁻¹ • ξ with hudef
  have hu : u ∈ Metric.sphere (0 : Fin 3 → ℝ) 1 := by
    rw [mem_sphere_zero_iff_norm, hudef, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ hr.ne']
  have hmem : (y, u) ∈ T := ⟨hy, hu⟩
  have hle : m ≤ num (y, u) / den (y, u) := hm ⟨(y, u), hmem, rfl⟩
  have hnu : num (y, u) = (‖ξ‖⁻¹) ^ 2 * num (y, ξ) := by
    simp only [hnumdef, hudef, Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hdu : den (y, u) = (‖ξ‖⁻¹) ^ 2 * den (y, ξ) := by
    simp only [hdendef, hudef, Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hc : (‖ξ‖⁻¹) ^ 2 ≠ 0 := by positivity
  rw [hnu, hdu, mul_div_mul_left _ _ hc] at hle
  have hratio : ejpRic G Φ y = num (y, ξ) / den (y, ξ) := rfl
  rw [hratio]
  linarith [le_max_right 0 (-m)]

theorem pullback_jacobi_supersolution [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ k₀ : ℝ, 0 ≤ k₀ ∧ ∀ Sig : Set M, IsMinimalSurfaceSet g Sig → IsStableMinimalSet g Sig → ∀ (ρ : ℝ) (F : E2 → E3), ContDiffOn ℝ ∞ F (Metric.ball 0 ρ) → (∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.ball (chartAt E3 z z) (2 * r) ∧ (chartAt E3 z).symm (F x) ∈ Sig ∧ Function.Injective (fderiv ℝ F x)) → ∃ a b φ : E2 → ℝ, ContinuousOn a (Metric.ball 0 ρ) ∧ ContinuousOn b (Metric.ball 0 ρ) ∧ ContDiffOn ℝ 2 φ (Metric.ball 0 ρ) ∧ ∀ x ∈ Metric.ball (0 : E2) ρ, IsSurfA2At g Sig (chartAt E3 z) ((chartAt E3 z).symm (F x)) (a x) ∧ -k₀ ≤ b x ∧ 0 < φ x ∧ lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) φ x + (a x + b x) * φ x ≤ 0 :=
by
  classical
  
  have hlapc : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w₁ w₂ : E2 → ℝ) (U : Set E2) (x : E2),
      IsOpen U → x ∈ U → Set.EqOn h₁ h₂ U → Set.EqOn w₁ w₂ U → lap2 h₁ w₁ x = lap2 h₂ w₂ x := by
    intro h₁ h₂ w₁ w₂ U x hU hx hh hw
    have hUx : U ∈ 𝓝 x := hU.mem_nhds hx
    have hhx : h₁ x = h₂ x := hh hx
    have hent : ∀ (a b k : Fin 2),
        pd2 k (fun z => h₁ z a b) x = pd2 k (fun z => h₂ z a b) x := by
      intro a b k
      have hev : (fun z => h₁ z a b) =ᶠ[𝓝 x] (fun z => h₂ z a b) :=
        Filter.eventually_of_mem hUx (fun y hy => by simp only [hh hy])
      show fderiv ℝ (fun z => h₁ z a b) x (e2 k) = fderiv ℝ (fun z => h₂ z a b) x (e2 k)
      rw [hev.fderiv_eq]
    have hchr : ∀ k i j : Fin 2, christoffel2 h₁ k i j x = christoffel2 h₂ k i j x := by
      intro k i j
      simp only [christoffel2, hhx, hent]
    have hw1 : ∀ k : Fin 2, pd2 k w₁ =ᶠ[𝓝 x] pd2 k w₂ := by
      intro k
      filter_upwards [hUx] with y hy
      have hev : w₁ =ᶠ[𝓝 y] w₂ := Filter.eventually_of_mem (hU.mem_nhds hy) (fun t ht => hw ht)
      show fderiv ℝ w₁ y (e2 k) = fderiv ℝ w₂ y (e2 k)
      rw [hev.fderiv_eq]
    have hw0 : ∀ k : Fin 2, pd2 k w₁ x = pd2 k w₂ x := fun k => (hw1 k).eq_of_nhds
    have hw2 : ∀ i k : Fin 2, pd2 i (pd2 k w₁) x = pd2 i (pd2 k w₂) x := by
      intro i k
      show fderiv ℝ (pd2 k w₁) x (e2 i) = fderiv ℝ (pd2 k w₂) x (e2 i)
      rw [(hw1 k).fderiv_eq]
    simp only [lap2, hhx, hchr, hw0, hw2]
  
  obtain ⟨k₀, hk₀, hRicB⟩ := ejpRic_lower_bound (g.coeff (chartAt E3 z).symm)
    (chartAt E3 z).target (Metric.closedBall (chartAt E3 z z) (4 * r)) (chartAt E3 z).open_target
    (isCompact_closedBall _ _) hball (g.smooth z) (fun y hy => coeff_chart_symm_posDef g z y hy)
  refine ⟨k₀, hk₀, ?_⟩
  intro Sig hSm hstab ρ F hF hFx
  obtain ⟨φM, hφM⟩ := hstab
  have hFK : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.closedBall (chartAt E3 z z) (4 * r) := by
    intro x hx
    have h1 := (hFx x hx).1
    rw [Metric.mem_ball] at h1
    rw [Metric.mem_closedBall]
    linarith
  have hFt : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ (chartAt E3 z).target :=
    fun x hx => hball (hFK x hx)
  have hsrc : ∀ x ∈ Metric.ball (0 : E2) ρ, (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source :=
    fun x hx => (chartAt E3 z).map_target (hFt x hx)
  
  have hA : ∀ x : E2, ∃ t : ℝ, x ∈ Metric.ball (0 : E2) ρ →
      IsSurfA2At g Sig (chartAt E3 z) ((chartAt E3 z).symm (F x)) t := by
    intro x
    by_cases hx : x ∈ Metric.ball (0 : E2) ρ
    · obtain ⟨t, -, ht, -⟩ := surfA2_chart_invariant g Sig hSm z _ (hFx x hx).2.1 (hsrc x hx)
      exact ⟨t, fun _ => ht⟩
    · exact ⟨0, fun h => absurd h hx⟩
  choose a ha using hA
  have hsym : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  
  have hloc : ∀ x₀ ∈ Metric.ball (0 : E2) ρ, ∃ (O : Set E2) (Φ : E3 → ℝ) (U' : Set E3),
      IsOpen O ∧ x₀ ∈ O ∧ O ⊆ Metric.ball 0 ρ ∧ IsOpen U' ∧ U' ⊆ (chartAt E3 z).target ∧
      ContDiffOn ℝ ∞ Φ U' ∧ (∀ y ∈ U', fderiv ℝ Φ y ≠ 0) ∧
      ∀ x ∈ O, F x ∈ U' ∧ Φ (F x) = 0 ∧
        φM ((chartAt E3 z).symm (F x)) = ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F x) ∧
        a x = secondFundSq (g.coeff (chartAt E3 z).symm) Φ (F x) ∧
        0 ≤ ejpJac (g.coeff (chartAt E3 z).symm) Φ (F x) := by
    intro x₀ hx₀
    obtain ⟨-, V, f, hVo, hqV, hf, hdf, hVS, hst⟩ := hφM _ (hFx x₀ hx₀).2.1
    obtain ⟨hΦs, hΦd⟩ := ejp_chart_transfer g z f hf
    have hU'o : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V) :=
      (chartAt E3 z).continuousOn_symm.isOpen_inter_preimage (chartAt E3 z).open_target hVo
    have hOo : IsOpen (Metric.ball (0 : E2) ρ ∩
        F ⁻¹' ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V)) :=
      hF.continuousOn.isOpen_inter_preimage Metric.isOpen_ball hU'o
    have hVS' : (V ∩ (chartAt E3 z).source) ∩ Sig =
        (V ∩ (chartAt E3 z).source) ∩ f ⁻¹' {0} := by
      ext y
      constructor
      · rintro ⟨⟨hyV, hys⟩, hyS⟩
        have h' : y ∈ V ∩ Sig := ⟨hyV, hyS⟩
        rw [hVS] at h'
        exact ⟨⟨hyV, hys⟩, h'.2⟩
      · rintro ⟨⟨hyV, hys⟩, hy0⟩
        have h' : y ∈ V ∩ f ⁻¹' {0} := ⟨hyV, hy0⟩
        rw [← hVS] at h'
        exact ⟨⟨hyV, hys⟩, h'.2⟩
    refine ⟨_, fun y => f ((chartAt E3 z).symm y), _, hOo, ⟨hx₀, hFt x₀ hx₀, hqV⟩,
      Set.inter_subset_left, hU'o, Set.inter_subset_left, hΦs.mono Set.inter_subset_left, ?_, ?_⟩
    · intro w hw
      have h1 := (hΦd ((chartAt E3 z).symm w) ((chartAt E3 z).map_target hw.1) (hdf _ hw.2)).1
      rwa [(chartAt E3 z).right_inv hw.1] at h1
    · intro x hx
      have hxW : x ∈ Metric.ball (0 : E2) ρ := hx.1
      have hp : (chartAt E3 z).symm (F x) ∈ V := hx.2.2
      have hpS : (chartAt E3 z).symm (F x) ∈ Sig := (hFx x hxW).2.1
      have hκp : chartAt E3 z ((chartAt E3 z).symm (F x)) = F x :=
        (chartAt E3 z).right_inv (hFt x hxW)
      obtain ⟨-, hgr, hjac⟩ := hΦd _ (hsrc x hxW) (hdf _ hp)
      rw [hκp] at hgr hjac
      obtain ⟨h1, h2⟩ := hst _ ⟨hp, hpS⟩
      have hf0 : f ((chartAt E3 z).symm (F x)) = 0 := by
        have h' : (chartAt E3 z).symm (F x) ∈ V ∩ Sig := ⟨hp, hpS⟩
        rw [hVS] at h'
        exact h'.2
      have hsf := ha x hxW _ f (hVo.inter (chartAt E3 z).open_source) ⟨hp, hsrc x hxW⟩
        Set.inter_subset_right hf (fun y hy => hdf y hy.1) hVS'
      rw [hκp] at hsf
      refine ⟨hx.2, hf0, ?_, hsf.symm, ?_⟩
      · rw [hgr] at h1
        exact eq_inv_of_mul_eq_one_right h1
      · rw [hjac] at h2
        exact h2
  
  have hkey : ∀ x₀ ∈ Metric.ball (0 : E2) ρ, ∃ O : Set E2, IsOpen O ∧ x₀ ∈ O ∧
      O ⊆ Metric.ball 0 ρ ∧ ∃ ψ' Jf Rf af : E2 → ℝ, ContDiffOn ℝ ∞ ψ' O ∧ ContinuousOn Jf O ∧
      ContinuousOn Rf O ∧ ContinuousOn af O ∧ ∀ x ∈ O,
        φM ((chartAt E3 z).symm (F x)) = ψ' x ∧ a x = af x ∧ 0 < ψ' x ∧ 0 ≤ Jf x ∧
        -k₀ ≤ Rf x ∧
        lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x =
          -(ψ' x) ^ 2 * Jf x - (af x + Rf x) * ψ' x := by
    intro x₀ hx₀
    obtain ⟨O, Φ, U', hOo, hx₀O, hOW, hU'o, hU'T, hΦ, hdΦ, hO⟩ := hloc x₀ hx₀
    have hGU : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j) U' :=
      fun i j => (g.smooth z i j).mono hU'T
    have hPU : ∀ y ∈ U', (g.coeff (chartAt E3 z).symm y).PosDef :=
      fun y hy => coeff_chart_symm_posDef g z y (hU'T hy)
    obtain ⟨hSpos, hSs, hψs, hPots⟩ :=
      ejp_level_regularity (g.coeff (chartAt E3 z).symm) Φ U' hU'o hGU hPU hΦ hdΦ
    obtain ⟨hpd, hinv, hchr, -, hNs⟩ :=
      ejp_coord_smooth (g.coeff (chartAt E3 z).symm) Φ U' hU'o hGU hPU hΦ
    have hH := lmcCoord_contDiffOn (g.coeff (chartAt E3 z).symm) U' hU'o hGU hPU Φ hΦ hdΦ
    have hric : ∀ j k : Fin 3,
        ContDiffOn ℝ ∞ (fun y => ricci (g.coeff (chartAt E3 z).symm) j k y) U' := by
      intro j k
      simp only [ricci]
      apply ContDiffOn.add
      · apply ContDiffOn.sum
        intro i _
        exact (hpd _ (hchr i j k) i).sub (hpd _ (hchr i i k) j)
      · apply ContDiffOn.sum
        intro i _
        apply ContDiffOn.sum
        intro p _
        exact ((hchr i i p).mul (hchr p j k)).sub ((hchr i j p).mul (hchr p i k))
    have hRic : ContinuousOn (ejpRic (g.coeff (chartAt E3 z).symm) Φ) U' := by
      have h1 : ContDiffOn ℝ ∞ (fun y => ∑ j : Fin 3, ∑ k : Fin 3,
          ricci (g.coeff (chartAt E3 z).symm) j k y * ejpN (g.coeff (chartAt E3 z).symm) Φ y j *
            ejpN (g.coeff (chartAt E3 z).symm) Φ y k) U' := by
        apply ContDiffOn.sum
        intro j _
        apply ContDiffOn.sum
        intro k _
        exact ((hric j k).mul (hNs j)).mul (hNs k)
      exact h1.continuousOn.div hSs.continuousOn (fun y hy => (hSpos y hy).ne')
    have hJac : ContinuousOn (ejpJac (g.coeff (chartAt E3 z).symm) Φ) U' := by
      have h1 : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
          (g.coeff (chartAt E3 z).symm y)⁻¹ i j *
            partialDeriv i (levelMeanCurvCoord (g.coeff (chartAt E3 z).symm) Φ) y *
            partialDeriv j Φ y) U' := by
        apply ContDiffOn.sum
        intro i _
        apply ContDiffOn.sum
        intro j _
        exact ((hinv i j).mul (hpd _ hH i)).mul (hpd _ hΦ j)
      exact h1.continuousOn
    have hsff : ContinuousOn (secondFundSq (g.coeff (chartAt E3 z).symm) Φ) U' := by
      have h1 : ContinuousOn (fun y => ejpPot (g.coeff (chartAt E3 z).symm) Φ y -
          ejpRic (g.coeff (chartAt E3 z).symm) Φ y) U' := hPots.continuousOn.sub hRic
      refine h1.congr (fun y _ => ?_)
      simp only [ejpPot]
      ring
    have hFO : ContDiffOn ℝ ∞ F O := hF.mono hOW
    have hmaps : Set.MapsTo F O U' := fun x hx => (hO x hx).1
    refine ⟨O, hOo, hx₀O, hOW, fun x => ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F x),
      fun x => ejpJac (g.coeff (chartAt E3 z).symm) Φ (F x),
      fun x => ejpRic (g.coeff (chartAt E3 z).symm) Φ (F x),
      fun x => secondFundSq (g.coeff (chartAt E3 z).symm) Φ (F x),
      hψs.comp hFO hmaps, hJac.comp hFO.continuousOn hmaps, hRic.comp hFO.continuousOn hmaps,
      hsff.comp hFO.continuousOn hmaps, ?_⟩
    intro x hx
    obtain ⟨hxU, hΦ0, hφx, hax, hJx⟩ := hO x hx
    have hψpos : 0 < ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F x) :=
      inv_pos.mpr (Real.sqrt_pos.mpr (hSpos _ hxU))
    have hRx : -k₀ ≤ ejpRic (g.coeff (chartAt E3 z).symm) Φ (F x) :=
      hRicB Φ (F x) (hFK x (hOW hx)) (hdΦ _ hxU)
    refine ⟨hφx, hax, hψpos, hJx, hRx, ?_⟩
    have hw : Set.EqOn (fun x => φM ((chartAt E3 z).symm (F x)))
        (fun x => ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F x)) O :=
      fun x hx => (hO x hx).2.2.1
    have hL := hlapc (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (pullMetric2 (g.coeff (chartAt E3 z).symm) F) _ _ O x hOo hx (fun _ _ => rfl) hw
    have hs2 := ejp_immersion_lap2 (g.coeff (chartAt E3 z).symm) Φ
      (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) U' hU'o hGU hsym hPU hΦ hdΦ hψs F O hOo hFO
      (fun x hx => ⟨(hO x hx).1, (hO x hx).2.1, (hFx x (hOW hx)).2.2⟩) x hx
    have hs1 := ejp_ambient_identity (g.coeff (chartAt E3 z).symm) Φ U' hU'o hGU hsym hPU hΦ hdΦ
      (F x) hxU
    rw [hL, hs2]
    simp only [ejpPot] at hs1
    linear_combination hs1
  
  refine ⟨a, fun x => -(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun x => φM ((chartAt E3 z).symm (F x))) x) / φM ((chartAt E3 z).symm (F x)) - a x,
    fun x => φM ((chartAt E3 z).symm (F x)), ?_, ?_, ?_, ?_⟩
  · 
    intro x₀ hx₀
    obtain ⟨O, hOo, hx₀O, -, ψ', Jf, Rf, af, -, -, -, haf, hval⟩ := hkey x₀ hx₀
    have hev : af =ᶠ[𝓝 x₀] a :=
      Filter.eventually_of_mem (hOo.mem_nhds hx₀O) (fun x hx => ((hval x hx).2.1).symm)
    exact ((haf.continuousAt (hOo.mem_nhds hx₀O)).congr hev).continuousWithinAt
  · 
    intro x₀ hx₀
    obtain ⟨O, hOo, hx₀O, -, ψ', Jf, Rf, af, hψ', hJf, hRf, haf, hval⟩ := hkey x₀ hx₀
    have hc : ContinuousOn
        (fun x => -(-(ψ' x) ^ 2 * Jf x - (af x + Rf x) * ψ' x) / ψ' x - af x) O :=
      ((((hψ'.continuousOn.pow 2).neg.mul hJf).sub ((haf.add hRf).mul hψ'.continuousOn)).neg.div
        hψ'.continuousOn (fun x hx => ((hval x hx).2.2.1).ne')).sub haf
    have hev : (fun x => -(-(ψ' x) ^ 2 * Jf x - (af x + Rf x) * ψ' x) / ψ' x - af x) =ᶠ[𝓝 x₀]
        (fun x => -(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x) / φM ((chartAt E3 z).symm (F x)) - a x) := by
      refine Filter.eventually_of_mem (hOo.mem_nhds hx₀O) (fun x hx => ?_)
      obtain ⟨h1, h2, -, -, -, h6⟩ := hval x hx
      simp only [h1, h2, h6]
    exact ((hc.continuousAt (hOo.mem_nhds hx₀O)).congr hev).continuousWithinAt
  · 
    refine contDiffOn_of_locally_contDiffOn (fun x₀ hx₀ => ?_)
    obtain ⟨O, hOo, hx₀O, -, ψ', Jf, Rf, af, hψ', -, -, -, hval⟩ := hkey x₀ hx₀
    refine ⟨O, hOo, hx₀O, ?_⟩
    have h2 : ContDiffOn ℝ 2 ψ' O := hψ'.of_le (by
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | norm_num
        | simp)
    exact (h2.mono Set.inter_subset_right).congr (fun x hx => (hval x hx.2).1)
  · 
    intro x₀ hx₀
    obtain ⟨O, hOo, hx₀O, -, ψ', Jf, Rf, af, -, -, -, -, hval⟩ := hkey x₀ hx₀
    obtain ⟨h1, h2, hψ, hJ, hR, h6⟩ := hval x₀ hx₀O
    refine ⟨ha x₀ hx₀, ?_, ?_, ?_⟩
    · show -k₀ ≤ -(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x₀) / φM ((chartAt E3 z).symm (F x₀)) - a x₀
      rw [h6, h1, h2]
      have he : -(-(ψ' x₀) ^ 2 * Jf x₀ - (af x₀ + Rf x₀) * ψ' x₀) / ψ' x₀ - af x₀ =
          ψ' x₀ * Jf x₀ + Rf x₀ := by
        field_simp
        ring
      rw [he]
      nlinarith [mul_nonneg hψ.le hJ]
    · show 0 < φM ((chartAt E3 z).symm (F x₀))
      rw [h1]
      exact hψ
    · show lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x₀ +
        (a x₀ + (-(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x₀) / φM ((chartAt E3 z).symm (F x₀)) - a x₀)) *
          φM ((chartAt E3 z).symm (F x₀)) ≤ 0
      have hne : φM ((chartAt E3 z).symm (F x₀)) ≠ 0 := by rw [h1]; exact hψ.ne'
      have he : (a x₀ + (-(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x₀) / φM ((chartAt E3 z).symm (F x₀)) - a x₀)) *
          φM ((chartAt E3 z).symm (F x₀)) = -(lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
          (fun x => φM ((chartAt E3 z).symm (F x))) x₀) := by
        field_simp
        ring
      rw [he]
      linarith

theorem normal_disc_stability (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (a b φ : E2 → ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hpd : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef) (ha : ContinuousOn a (Metric.ball 0 ρ)) (hb : ContinuousOn b (Metric.ball 0 ρ)) (hφ : ContDiffOn ℝ 2 φ (Metric.ball 0 ρ)) (hJ : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 < φ x ∧ lap2 h φ x + (a x + b x) * φ x ≤ 0) : ∀ (r M : ℝ) (Ψ Θ : E2 → ℝ), 0 < r → r < ρ → ContDiff ℝ 1 Ψ → (∀ x, 0 ≤ Ψ x) → (∀ x : E2, r ≤ ‖x‖ → Ψ x = 0) → Measurable Θ → (∀ x, 0 ≤ Θ x ∧ Θ x ≤ M) → (∀ x : E2, r ≤ ‖x‖ → Θ x = 0) → (∀ x ∈ Metric.ball (0 : E2) ρ, ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x ≤ 4 * Ψ x * Θ x) → ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * Real.sqrt (h x).det ≤ ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det :=
by
  
  have metric2_inv_regular : ∀ (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hpd : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef), (∀ x ∈ Metric.ball (0 : E2) ρ, 0 < (h x).det) ∧ ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) (Metric.ball 0 ρ) ∧ ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ i j) (Metric.ball 0 ρ) := by
    intro ρ h hh hpd
    have hdetfun : ∀ x, (h x).det = h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 :=
      fun x => Matrix.det_fin_two _
    have hdetC : ContDiffOn ℝ ∞ (fun x => (h x).det) (Metric.ball 0 ρ) := by
      simp only [hdetfun]
      exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
    have hpos : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 < (h x).det := fun x hx => (hpd x hx).det_pos
    refine ⟨hpos, hdetC.sqrt (fun x hx => (hpos x hx).ne'), ?_⟩
    intro i j
    have hent : ∀ x, (h x)⁻¹ i j = ((h x).det)⁻¹ * (h x).adjugate i j := by
      intro x
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    have hadj : ContDiffOn ℝ ∞ (fun x => (h x).adjugate i j) (Metric.ball 0 ρ) := by
      simp only [Matrix.adjugate_fin_two]
      fin_cases i <;> fin_cases j <;> simp <;>
        first | exact hh _ _ | exact (hh _ _).neg
    simp only [hent]
    exact (hdetC.inv (fun x hx => (hpos x hx).ne')).mul hadj
  
  have sqrtdet_inv_contracted : ∀ (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hpd : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef), ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ j : Fin 2, ∑ i : Fin 2, pd2 i (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j) x = -(Real.sqrt (h x).det * ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * christoffel2 h j k l x) := by
    intro ρ h hh hpd x hx j
    have hnx : Metric.ball (0 : E2) ρ ∈ 𝓝 x := Metric.isOpen_ball.mem_nhds hx
    have hsym : ∀ y ∈ Metric.ball (0 : E2) ρ, h y 1 0 = h y 0 1 := fun y hy => by
