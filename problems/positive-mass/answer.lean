    (fun y _ => mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) hpt hzero

theorem collar_gain_neg [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E O Ω O'' : Set M) (w : M → ℝ) (t₀ a b c d : ℝ) (hE : IsOpen E) (hfr : frontier E = Sig)
    (hO : IsOpen O) (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ O \ Sig, g.levelMeanCurv w x < 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (hne : (O ∩ Sig).Nonempty) (ha : 0 < a) (hab : a < b) (hbc : b ≤ c) (hcd : c < d)
    (hd : d ≤ t₀) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω)
    (hO'' : IsOpen O'') (hsub : {x | x ∈ O ∧ w x ≤ t₀} ⊆ O'') (h1 : ∀ x ∈ O'', ∑ j, φ j x = 1) :
    calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) x *
          g.levelMeanCurv w x) ≤
      calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
          g.levelMeanCurv w x) ∧
    calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
          g.levelMeanCurv w x) < 0 :=
by
  classical
  
  have cut01 : ∀ α β : ℝ, ∀ x, 0 ≤ O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ∧
      O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ≤ 1 := by
    intro α β x
    by_cases hx : x ∈ O
    · rw [Set.indicator_of_mem hx]
      have h1 := Real.smoothTransition.nonneg ((w x - α) / (β - α))
      have h2 := Real.smoothTransition.le_one ((w x - α) / (β - α))
      constructor <;> linarith
    · rw [Set.indicator_of_notMem hx]
      exact ⟨le_refl _, zero_le_one⟩
  have cut0 : ∀ α β : ℝ, α < β → ∀ x, O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ≠ 0 → x ∈ O ∧ w x < β := by
    intro α β hαβ x hx
    by_cases hxO : x ∈ O
    · refine ⟨hxO, ?_⟩
      by_contra hge
      push_neg at hge
      apply hx
      rw [Set.indicator_of_mem hxO]
      have h1 : 1 ≤ (w x - α) / (β - α) := by
        rw [le_div_iff₀ (by linarith)]
        linarith
      rw [Real.smoothTransition.one_of_one_le h1]
      ring
    · exact absurd (Set.indicator_of_notMem hxO _) hx
  have cut1 : ∀ α β : ℝ, α < β → ∀ x ∈ O, w x ≤ α → O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x = 1 := by
    intro α β hαβ x hxO hwx
    rw [Set.indicator_of_mem hxO]
    have h1 : (w x - α) / (β - α) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    rw [Real.smoothTransition.zero_of_nonpos h1]
    ring
  obtain ⟨ζ, hζ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) := ⟨_, rfl⟩
  obtain ⟨χ, hχ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) := ⟨_, rfl⟩
  rw [← hζ, ← hχ]
  have hζ01 : ∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1 := by rw [hζ]; exact cut01 a b
  have hχ01 : ∀ x, 0 ≤ χ x ∧ χ x ≤ 1 := by rw [hχ]; exact cut01 c d
  have hζ0 : ∀ x, ζ x ≠ 0 → x ∈ O ∧ w x < b := by rw [hζ]; exact cut0 a b hab
  have hζ1 : ∀ x ∈ O, w x ≤ a → ζ x = 1 := by rw [hζ]; exact cut1 a b hab
  have hχ1 : ∀ x ∈ O, w x ≤ c → χ x = 1 := by rw [hχ]; exact cut1 c d hcd
  have hζO : ∀ x, x ∉ O → ζ x = 0 := fun x hx => by rw [hζ]; exact Set.indicator_of_notMem hx _
  have hχO : ∀ x, x ∉ O → χ x = 0 := fun x hx => by rw [hχ]; exact Set.indicator_of_notMem hx _
  
  have hEsig : ∀ x ∈ E, x ∉ Sig := by
    intro x hx hxS
    rw [← hfr, hE.frontier_eq] at hxS
    exact hxS.2 hx
  
  have hpt : ∀ x ∈ E, χ x * g.levelMeanCurv w x ≤ ζ x * g.levelMeanCurv w x ∧
      ζ x * g.levelMeanCurv w x ≤ 0 := by
    intro x hxE
    by_cases hxO : x ∈ O
    · have hH' := hH x ⟨hxO, hEsig x hxE⟩
      have hle : ζ x ≤ χ x := by
        by_cases hwc' : w x ≤ c
        · rw [hχ1 x hxO hwc']
          exact (hζ01 x).2
        · have h0 : ζ x = 0 := by
            by_contra h
            have := (hζ0 x h).2
            exact hwc' (by linarith)
          rw [h0]
          exact (hχ01 x).1
      exact ⟨mul_le_mul_of_nonpos_right hle hH'.le,
        mul_nonpos_of_nonneg_of_nonpos (hζ01 x).1 hH'.le⟩
    · rw [hζO x hxO, hχO x hxO]
      simp
  
  obtain ⟨Fζ, hFζ⟩ : ∃ F : Fin n → E3 → ℝ, F = fun j y =>
      φ j ((chartAt E3 (q j)).symm y) * (ζ ((chartAt E3 (q j)).symm y) *
        g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  obtain ⟨Fχ, hFχ⟩ : ∃ F : Fin n → E3 → ℝ, F = fun j y =>
      φ j ((chartAt E3 (q j)).symm y) * (χ ((chartAt E3 (q j)).symm y) *
        g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  have hcalζ : calVolSum g q φ E (fun x => ζ x * g.levelMeanCurv w x) =
      ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fζ j y := by
    rw [hFζ]; rfl
  have hcalχ : calVolSum g q φ E (fun x => χ x * g.levelMeanCurv w x) =
      ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fχ j y := by
    rw [hFχ]; rfl
  rw [hcalζ, hcalχ]
  have hSm : ∀ j, MeasurableSet (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) :=
    fun j => ((chartAt E3 (q j)).isOpen_image_of_subset_source
      (hE.inter (chartAt E3 (q j)).open_source) Set.inter_subset_right).measurableSet
  have hψs : ∀ j, tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
    fun j => (hφ.2.2.2 j).2.trans Set.inter_subset_right
  have hintζ : ∀ j, MeasureTheory.IntegrableOn (Fζ j)
      (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have h := collar_curv_integrableOn g Sig E O w t₀ a b hE hfr hO hcpt hwc hw0 hws hdw hbd ha
      hab (by linarith) (φ j) (hφ.1 j) (q j) (hφ.2.2.2 j).1 (hψs j)
    rw [← hζ] at h
    rw [hFζ]
    exact h
  have hintχ : ∀ j, MeasureTheory.IntegrableOn (Fχ j)
      (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have h := collar_curv_integrableOn g Sig E O w t₀ c d hE hfr hO hcpt hwc hw0 hws hdw hbd
      (by linarith) hcd hd (φ j) (hφ.1 j) (q j) (hφ.2.2.2 j).1 (hψs j)
    rw [← hχ] at h
    rw [hFχ]
    exact h
  
  have hFpt : ∀ j, ∀ y ∈ chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
      Fχ j y ≤ Fζ j y ∧ Fζ j y ≤ 0 := by
    intro j
    rintro _ ⟨x, ⟨hxE, hxs⟩, rfl⟩
    rw [hFζ, hFχ]
    simp only [(chartAt E3 (q j)).left_inv hxs]
    have h0 := hφ.2.1 j x
    have h2 := Real.sqrt_nonneg (g.coeff (chartAt E3 (q j)).symm (chartAt E3 (q j) x)).det
    obtain ⟨hA, hB⟩ := hpt x hxE
    exact ⟨mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hA h0) h2,
      mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos h0 hB) h2⟩
  refine ⟨?_, ?_⟩
  · refine Finset.sum_le_sum fun j _ => ?_
    exact MeasureTheory.setIntegral_mono_on (hintχ j) (hintζ j) (hSm j)
      (fun y hy => (hFpt j y hy).1)
  · 
    obtain ⟨p₀, hp₀O, hp₀S⟩ := hne
    have hNa : IsOpen (O ∩ w ⁻¹' Set.Iio a) := hwc.isOpen_inter_preimage hO isOpen_Iio
    have hp₀cl : p₀ ∈ closure E := by
      rw [← hfr] at hp₀S
      exact frontier_subset_closure hp₀S
    have hp₀N : p₀ ∈ O ∩ w ⁻¹' Set.Iio a := by
      refine ⟨hp₀O, ?_⟩
      show w p₀ < a
      rw [hw0 p₀ hp₀O hp₀S]
      exact ha
    obtain ⟨x₁, ⟨hx₁O, hx₁a⟩, hx₁E⟩ := mem_closure_iff.1 hp₀cl _ hNa hp₀N
    have hx₁a' : w x₁ < a := hx₁a
    have hx₁O'' : x₁ ∈ O'' := hsub ⟨hx₁O, by linarith⟩
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero
      (by rw [h1 x₁ hx₁O'']; exact one_ne_zero : ∑ j, φ j x₁ ≠ 0)
    have hjpos : 0 < φ j x₁ := lt_of_le_of_ne (hφ.2.1 j x₁) (Ne.symm hj)
    have hx₁s : x₁ ∈ (chartAt E3 (q j)).source := hψs j (subset_tsupport _ hj)
    
    set N : Set E3 := chartAt E3 (q j) ''
      (E ∩ (O ∩ w ⁻¹' Set.Iio a) ∩ {x | 0 < φ j x} ∩ (chartAt E3 (q j)).source) with hNdef
    have hNo : IsOpen N :=
      (chartAt E3 (q j)).isOpen_image_of_subset_source
        (((hE.inter hNa).inter (isOpen_lt continuous_const (hφ.1 j).continuous)).inter
          (chartAt E3 (q j)).open_source) Set.inter_subset_right
    have hNne : N.Nonempty :=
      ⟨chartAt E3 (q j) x₁, x₁, ⟨⟨⟨hx₁E, hx₁O, hx₁a⟩, hjpos⟩, hx₁s⟩, rfl⟩
    have hNS : N ⊆ chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) := by
      rintro _ ⟨x, ⟨⟨⟨hxE, -⟩, -⟩, hxs⟩, rfl⟩
      exact ⟨x, ⟨hxE, hxs⟩, rfl⟩
    have hlt : ∀ y ∈ N, Fζ j y < 0 := by
      rintro _ ⟨x, ⟨⟨⟨hxE, hxO, hxa⟩, hxφ⟩, hxs⟩, rfl⟩
      rw [hFζ]
      simp only [(chartAt E3 (q j)).left_inv hxs]
      have hxa' : w x < a := hxa
      have hxφ' : 0 < φ j x := hxφ
      have hHx := hH x ⟨hxO, hEsig x hxE⟩
      have hζx := hζ1 x hxO hxa'.le
      have hdet : 0 < Real.sqrt (g.coeff (chartAt E3 (q j)).symm (chartAt E3 (q j) x)).det :=
        Real.sqrt_pos.2 (coeff_chart_symm_posDef g (q j) _
          ((chartAt E3 (q j)).map_source hxs)).det_pos
      rw [hζx, one_mul]
      exact mul_neg_of_neg_of_pos (mul_neg_of_pos_of_neg hxφ' hHx) hdet
    have hneg_j : ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fζ j y < 0 := by
      have hnn : 0 ≤ᵐ[MeasureTheory.volume.restrict
          (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source))] fun y => -Fζ j y :=
        (MeasureTheory.ae_restrict_iff' (hSm j)).2
          (MeasureTheory.ae_of_all _ fun y hy => neg_nonneg.2 (hFpt j y hy).2)
      have hpos := (MeasureTheory.setIntegral_pos_iff_support_of_nonneg_ae hnn
        (hintζ j).neg).2 ?_
      · rw [MeasureTheory.integral_neg] at hpos
        linarith
      · refine lt_of_lt_of_le (hNo.measure_pos MeasureTheory.volume hNne)
          (MeasureTheory.measure_mono ?_)
        intro y hy
        exact ⟨show -Fζ j y ≠ 0 from ne_of_gt (neg_pos.2 (hlt y hy)), hNS hy⟩
    have hle : ∀ i ∈ Finset.univ,
        ∫ y in chartAt E3 (q i) '' (E ∩ (chartAt E3 (q i)).source), Fζ i y ≤ (fun _ => (0 : ℝ)) i :=
      fun i _ => MeasureTheory.setIntegral_nonpos (hSm i) (fun y hy => (hFpt i y hy).2)
    calc ∑ i, ∫ y in chartAt E3 (q i) '' (E ∩ (chartAt E3 (q i)).source), Fζ i y
        < ∑ i : Fin n, (fun _ => (0 : ℝ)) i :=
          Finset.sum_lt_sum hle ⟨j, Finset.mem_univ _, hneg_j⟩
      _ = 0 := Finset.sum_const_zero

theorem collar_removal_decreases_hull [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Sig E Ω O : Set M) (w : M → ℝ) (t₀ : ℝ) (hE : IsOpen E)
    (hfr : frontier E = Sig) (hΩ : IsOpen Ω) (hO : IsOpen O) (hOΩ : O ⊆ Ω)
    (hfin : hullRiemPer g E Ω Sig < ⊤) (ht₀ : 0 < t₀)
    (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ O \ Sig, g.levelMeanCurv w x < 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (hne : (O ∩ Sig).Nonempty) :
    ∃ t : ℝ, 0 < t ∧ t ≤ t₀ ∧
      hullRiemPer g (E \ {x | x ∈ O ∧ w x ≤ t}) Ω Sig < hullRiemPer g E Ω Sig :=
by
  
  obtain ⟨t, ht_eq⟩ : ∃ t : ℝ, t = t₀ / 2 := ⟨_, rfl⟩
  have ht : 0 < t := by rw [ht_eq]; linarith
  have htt₀ : t ≤ t₀ := by rw [ht_eq]; linarith
  have hSigc : IsClosed Sig := hfr ▸ isClosed_frontier
  have hESig : Disjoint E Sig := by
    rw [← hfr, hE.frontier_eq]; exact Set.disjoint_sdiff_right
  have hSigi : interior Sig = ∅ := by
    rw [← hfr, ← frontier_compl]; exact interior_frontier hE.isClosed_compl
  have hEm : sepChartMeas E := by
    intro q'
    exact ((chartAt E3 q').isOpen_image_of_subset_source (hE.inter (chartAt E3 q').open_source)
      Set.inter_subset_right).measurableSet
  
  have hP0 : calPartition (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) O :=
    ⟨fun j => j.elim0, fun j => j.elim0, fun x => by simp, fun j => j.elim0⟩
  obtain ⟨n, q, φ, O', hφ, hO'o, hKO'', hφ1, -⟩ :=
    calPartition_extend g O hO (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) hP0 ∅ isOpen_empty (fun x hx => hx.elim)
      {x | x ∈ O ∧ w x ≤ t₀} hcpt (fun x hx => hx.1)
  have hKO' : {x | x ∈ O ∧ w x ≤ t₀} ⊆ O' := fun x hx => hKO'' (Or.inl hx)
  
  obtain ⟨β, hβdef⟩ : ∃ β : M → ℝ, β = O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - t / 4) / (t / 2 - t / 4))) := ⟨_, rfl⟩
  obtain ⟨hβs, hβ01, hβ1, hβ0, -, hcl, -⟩ := collar_cutoff_props Sig O w t₀ (t / 4) (t / 2)
    hSigc hO hcpt hwc hw0 hws (by linarith) (by linarith) (by linarith)
  rw [← hβdef] at hβs hβ01 hβ1 hβ0
  
  have hUo : IsOpen {x | x ∈ O ∧ w x < 3 * t / 4} :=
    hwc.isOpen_inter_preimage hO (isOpen_Iio (a := 3 * t / 4))
  have hC₁c : IsClosed {x | x ∈ O ∧ w x ≤ 3 * t / 4} := (hcl (3 * t / 4) (by linarith)).1
  have hUC₁ : {x | x ∈ O ∧ w x < 3 * t / 4} ⊆ {x | x ∈ O ∧ w x ≤ 3 * t / 4} :=
    fun x hx => ⟨hx.1, hx.2.le⟩
  
  have hLR := hullRiemPer_disjoint_sum_le g E Ω Sig
    ![Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}, {x | x ∈ O ∧ w x < 3 * t / 4}]
    (fun j => by
      fin_cases j
      · exact Set.diff_subset
      · intro x hx
        exact hOΩ (show x ∈ {x | x ∈ O ∧ w x < 3 * t / 4} from hx).1)
    (by
      have hd : Disjoint (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) {x | x ∈ O ∧ w x < 3 * t / 4} :=
        Set.disjoint_left.2 fun x hx hx' => hx.2 (hUC₁ hx')
      intro a b hab
      fin_cases a <;> fin_cases b
      · exact absurd rfl hab
      · exact hd
      · exact hd.symm
      · exact absurd rfl hab)
  rw [Fin.sum_univ_two] at hLR
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hLR
  have hP₁fin : hullRiemPer g E (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) Sig ≠ ⊤ :=
    (lt_of_le_of_lt (le_trans le_self_add hLR) hfin).ne
  have hPUfin : hullRiemPer g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig ≠ ⊤ :=
    (lt_of_le_of_lt (le_trans le_add_self hLR) hfin).ne
  obtain ⟨P, hPeq, hPnn⟩ : ∃ P : ℝ, hullRiemPer g E Ω Sig = ENNReal.ofReal P ∧ 0 ≤ P :=
    ⟨_, (ENNReal.ofReal_toReal hfin.ne).symm, ENNReal.toReal_nonneg⟩
  obtain ⟨P₁, hP₁eq, hP₁nn⟩ : ∃ P₁ : ℝ,
      hullRiemPer g E (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) Sig = ENNReal.ofReal P₁ ∧ 0 ≤ P₁ :=
    ⟨_, (ENNReal.ofReal_toReal hP₁fin).symm, ENNReal.toReal_nonneg⟩
  obtain ⟨PU, hPUeq, hPUnn⟩ : ∃ PU : ℝ,
      hullRiemPer g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig = ENNReal.ofReal PU ∧ 0 ≤ PU :=
    ⟨_, (ENNReal.ofReal_toReal hPUfin).symm, ENNReal.toReal_nonneg⟩
  have hsumR : P₁ + PU ≤ P := by
    rw [hP₁eq, hPUeq, hPeq, ← ENNReal.ofReal_add hP₁nn hPUnn] at hLR
    exact (ENNReal.ofReal_le_ofReal_iff hPnn).1 hLR
  
  obtain ⟨V, hVs, hVd, hV1, hVsupp, hVform⟩ := collar_jump_field g Sig E O w t₀ (t / 8) (t / 4)
    hE hfr hO hcpt hwc hw0 hwpos hws hdw hbd (by linarith) (by linarith) (by linarith)
  have hβtsupp : tsupport β ⊆ {x | x ∈ O ∧ w x < 3 * t / 4} := by
    refine (closure_minimal (fun x hx => ?_) (hcl (t / 2) (by linarith)).1).trans ?_
    · obtain ⟨h1, h2⟩ := hβ0 x hx
      exact ⟨h1, h2.le⟩
    · intro x hx
      exact ⟨hx.1, by linarith [hx.2]⟩
  have hφU : calPartition q (fun j x => β x * φ j x) {x | x ∈ O ∧ w x < 3 * t / 4} := by
    refine ⟨fun j => hβs.mul (hφ.1 j), fun j x => mul_nonneg (hβ01 x).1 (hφ.2.1 j x),
      fun x => ?_, fun j => ⟨?_, ?_⟩⟩
    · rw [← Finset.mul_sum]
      exact mul_le_one₀ (hβ01 x).2 (Finset.sum_nonneg fun j _ => hφ.2.1 j x) (hφ.2.2.1 x)
    · exact (hφ.2.2.2 j).1.of_isClosed_subset (isClosed_tsupport _) tsupport_mul_subset_right
    · intro x hx
      exact ⟨hβtsupp (tsupport_mul_subset_left hx),
        ((hφ.2.2.2 j).2 (tsupport_mul_subset_right hx)).2⟩
  have hlow := hull_jump_lower_bound g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig hE hSigc hSigi hESig
    hUo q (fun j x => β x * φ j x) hφU V hVs hVd hV1
