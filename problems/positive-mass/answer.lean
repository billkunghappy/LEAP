  have hκI : ∀ k : Fin 2, (∫ z, ‖z‖ * |pd2 k η z| + η z) ≤ Cη + 1 := by
    intro k
    have i1 : Integrable (fun z : E2 => ‖z‖ * |pd2 k η z|) :=
      (continuous_norm.mul (hpdc k).abs).integrable_of_hasCompactSupport (hκ1s k)
    have i2 : Integrable η := hη.continuous.integrable_of_hasCompactSupport hηc
    rw [integral_add i1 i2, hη1]
    linarith [hηd k]
  
  have hconv : ∀ (κ φ : E2 → ℝ), Continuous κ → HasCompactSupport κ → Integrable φ →
      Continuous (fun x => ∫ y, κ (x - y) * φ y) := by
    intro κ φ hk hkc hφ
    have h := hkc.continuous_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ)
      (μ := volume) hφ.locallyIntegrable hk
    convert h using 1
    funext x
    rw [convolution_def]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul, mul_comm]
  
  obtain ⟨F, hFdef⟩ : ∃ F : Fin 2 → Fin 2 → E2 → ℝ, F = fun k b x =>
      ∫ y, (‖x - y‖ * |pd2 k η (x - y)| + η (x - y)) *
        |(Metric.closedBall x₀ (4 * ρ)).indicator (G b) y| := ⟨_, rfl⟩
  have hFc : ∀ k b : Fin 2, Continuous (F k b) := by
    intro k b
