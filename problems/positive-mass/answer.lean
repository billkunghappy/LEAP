theorem stern_bad_chart_indep [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hβr : ∀ p : M, β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0) (q : M) (y : E3)
    (hy : y ∈ (chartAt E3 q).target) (hpos : 0 < g.gradInner u u ((chartAt E3 q).symm y)) :
    fderiv ℝ (fun z => u ((chartAt E3 q).symm z)) y ≠ 0 ∧
      (β ((chartAt E3 q).symm y) = 0 → ∀ a c : ℝ,
        a • fderiv ℝ (fun z => β ((chartAt E3 q).symm z)) y +
          c • fderiv ℝ (fun z => u ((chartAt E3 q).symm z)) y = 0 → a = 0 ∧ c = 0) :=
by
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    ext k
    simp [EuclideanSpace.single_apply, Pi.single_apply]
  set ch := chartAt E3 q with hch
  set x := ch.symm y with hx
  set ch' := chartAt E3 x with hch'
  set y' := ch' x with hy'
  have hxs : x ∈ ch.source := ch.map_target hy
  have hy'T : y' ∈ ch'.target := mem_chart_target E3 x
  have hback : ch'.symm y' = x := ch'.left_inv (mem_chart_source E3 x)
  have hA : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ch'.symm y' :=
    mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 x) hy'T
  have hB : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ch (ch'.symm y') := by
    rw [hback]; exact mdifferentiableAt_atlas (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 q) hxs
  have hτ : DifferentiableAt ℝ (fun z => ch (ch'.symm z)) y' :=
    mdifferentiableAt_iff_differentiableAt.mp (hB.comp y' hA)
  have hev : ∀ᶠ z in 𝓝 y', ch.symm (ch (ch'.symm z)) = ch'.symm z := by
    have hO := ch'.isOpen_inter_preimage_symm ch.open_source
    exact Filter.eventually_of_mem (hO.mem_nhds ⟨hy'T, (show ch'.symm y' ∈ ch.source by rw [hback]; exact hxs)⟩)
      (fun z hz => ch.left_inv hz.2)
  have hTy : ch (ch'.symm y') = y := by rw [hback]; exact ch.right_inv hy
  have chain : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      fderiv ℝ (fun z => f (ch'.symm z)) y' =
        (fderiv ℝ (fun z => f (ch.symm z)) y).comp (fderiv ℝ (fun z => ch (ch'.symm z)) y') := by
    intro f hf
    have hc : ContDiffOn ℝ ∞ (fun z => f (ch.symm z)) ch.target :=
      contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn contMDiffOn_chart_symm)
    have hd : DifferentiableAt ℝ (fun z => f (ch.symm z)) (ch (ch'.symm y')) := by
      rw [hTy]
      exact (hc.differentiableOn (by simp)).differentiableAt (ch.open_target.mem_nhds hy)
    have hU : (fun z => f (ch'.symm z)) =ᶠ[𝓝 y']
        ((fun z => f (ch.symm z)) ∘ (fun z => ch (ch'.symm z))) := by
      filter_upwards [hev] with z hz
      simp only [Function.comp_apply]
      rw [hz]
    rw [hU.fderiv_eq, fderiv_comp y' hd hτ, hTy]
  have hgi : ∀ w : M → ℝ, g.gradInner u w x = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff ch'.symm y')⁻¹ i j * fderiv ℝ (fun z => u (ch'.symm z)) y' (e i) *
        fderiv ℝ (fun z => w (ch'.symm z)) y' (e j) := fun w => rfl
  have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β x = fderiv ℝ (fun z => β (ch'.symm z)) y' := by
    have hh : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β x := hβ.mdifferentiableAt (by simp)
    rw [hh.mfderiv]
    simp [writtenInExtChartAt, Function.comp_def]
    rfl
  have hAc : fderiv ℝ (fun z => u (ch.symm z)) y ≠ 0 := by
    intro h0
    have h1 : fderiv ℝ (fun z => u (ch'.symm z)) y' = 0 := by
      rw [chain u hu, h0]; simp
    have h2 := hgi u
    rw [h1] at h2
    simp at h2
    linarith
  refine ⟨hAc, fun hβ0 a c hrel => ?_⟩
  have hrel' : a • fderiv ℝ (fun z => β (ch'.symm z)) y' +
      c • fderiv ℝ (fun z => u (ch'.symm z)) y' = 0 := by
    rw [chain β hβ, chain u hu, ← ContinuousLinearMap.smul_comp,
      ← ContinuousLinearMap.smul_comp, ← ContinuousLinearMap.add_comp, hrel]
    simp
  have hcomp : ∀ i : Fin 3, a * fderiv ℝ (fun z => β (ch'.symm z)) y' (e i) +
      c * fderiv ℝ (fun z => u (ch'.symm z)) y' (e i) = 0 := by
    intro i
    have := congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hrel'
    simpa using this
  have alg : ∀ (B : Matrix (Fin 3) (Fin 3) ℝ) (P Q : Fin 3 → ℝ),
      (∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * Q j = 0) →
      (0 < ∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * P j) →
      (∀ i, a * Q i + c * P i = 0) → c = 0 := by
    intro B P Q hT hS hc
    have e1 : c * (∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * P j) =
        ∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * (a * Q j + c * P j) -
          a * ∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * Q j := by
      simp only [Fin.sum_univ_three]; ring
    have e2 : c * (∑ i : Fin 3, ∑ j : Fin 3, B i j * P i * P j) = 0 := by
      rw [e1, hT]; simp [hc]
    rcases mul_eq_zero.mp e2 with h | h
    · exact h
    · linarith
  have hc0 : c = 0 := by
    have hT := hgi β
    rw [hneu x hβ0] at hT
    have hS := hgi u
    rw [hS] at hpos
    exact alg _ (fun i => fderiv ℝ (fun z => u (ch'.symm z)) y' (e i))
      (fun i => fderiv ℝ (fun z => β (ch'.symm z)) y' (e i)) hT.symm hpos hcomp
  refine ⟨?_, hc0⟩
  by_contra ha
  have hV0 : ∀ i : Fin 3, fderiv ℝ (fun z => β (ch'.symm z)) y' (e i) = 0 := by
    intro i
    have h := hcomp i
    rw [hc0, zero_mul, add_zero] at h
    exact (mul_eq_zero.mp h).resolve_left ha
  have hVz : fderiv ℝ (fun z => β (ch'.symm z)) y' = 0 := by
    refine ContinuousLinearMap.ext (fun v => ?_)
    conv_lhs => rw [hexp v]
    simp [map_sum, map_smul, hV0]
  exact hβr x hβ0 (by rw [hmf]; exact hVz)

theorem stern_submersion_preimage_volume (K O : Set E3) (hK : IsCompact K) (hO : IsOpen O)
    (hKO : K ⊆ O) (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f O) (nw : E3 → ℝ)
    (hnw : ContinuousOn nw K) (hreg : ∀ y ∈ K, 0 < nw y → fderiv ℝ f y ≠ 0)
    (η₀ : ℝ) (hη₀ : 0 < η₀) :
    ∃ Ca : ℝ, 0 ≤ Ca ∧ ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r →
      volume U ≤ ENNReal.ofReal r →
      volume (K ∩ f ⁻¹' U ∩ {y | η₀ ≤ nw y}) ≤ ENNReal.ofReal (Ca * r) :=
by
  classical
  
  have hD : ∀ (ψ : E3 →L[ℝ] ℝ) (a : Fin 3),
      (ContinuousLinearMap.id ℝ E3 + ψ.smulRight (e a)).det = 1 + ψ (e a) := by
    intro ψ a
    have hdet : (ContinuousLinearMap.id ℝ E3 + ψ.smulRight (e a)).det =
        (LinearMap.toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
          (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
          ((ContinuousLinearMap.id ℝ E3 + ψ.smulRight (e a)) : E3 →ₗ[ℝ] E3)).det :=
      (LinearMap.det_toMatrix _ _).symm
    rw [hdet, Matrix.det_fin_three]
    simp [LinearMap.toMatrix_apply, EuclideanSpace.single_apply]
    fin_cases a <;> simp [e]
  
  have hV : ∀ (a : Fin 3) (c : E3) (ρ : ℝ), 0 ≤ ρ → ∀ (U : Set ℝ), MeasurableSet U →
      ∀ (r : ℝ), 0 ≤ r → volume U ≤ ENNReal.ofReal r →
      volume {z : E3 | z a ∈ U ∧ ∀ i, i ≠ a → |z i - c i| < ρ} ≤
        ENNReal.ofReal (4 * ρ ^ 2 * r) := by
    intro a c ρ hρ U hU r hr hUr
    set s : Fin 3 → Set ℝ := fun i => if i = a then U else Set.Ioo (c i - ρ) (c i + ρ) with hs
    have hsub : {z : E3 | z a ∈ U ∧ ∀ i, i ≠ a → |z i - c i| < ρ} ⊆
        (WithLp.ofLp) ⁻¹' (Set.univ.pi s) := by
      rintro z ⟨hza, hzi⟩
      simp only [Set.mem_preimage, Set.mem_univ_pi]
      intro i
      by_cases hi : i = a
      · subst hi; simp [hs, hza]
      · have := hzi i hi
        simp only [hs, if_neg hi, Set.mem_Ioo]
        constructor <;> linarith [(abs_lt.mp this).1, (abs_lt.mp this).2]
    have hsm : ∀ i, MeasurableSet (s i) := by
      intro i
      by_cases hi : i = a
      · simp [hs, hi, hU]
      · simp only [hs, if_neg hi]; exact measurableSet_Ioo
    have hvol : volume ((WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹' (Set.univ.pi s)) =
        ∏ i, volume (s i) := by
      rw [(PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage
        (MeasurableSet.univ_pi hsm).nullMeasurableSet, volume_pi_pi]
    have hother : ∀ i ∈ Finset.univ.erase a, volume (s i) = ENNReal.ofReal (2 * ρ) := by
      intro i hi
      have hia : i ≠ a := Finset.ne_of_mem_erase hi
      simp only [hs, if_neg hia, Real.volume_Ioo]
      congr 1; ring
    have hprod : ∏ i, volume (s i) ≤ ENNReal.ofReal r * ENNReal.ofReal (2 * ρ) ^ 2 := by
      rw [← Finset.mul_prod_erase Finset.univ (fun i => volume (s i)) (Finset.mem_univ a),
        Finset.prod_congr rfl hother, Finset.prod_const,
        Finset.card_erase_of_mem (Finset.mem_univ a)]
      simp only [Finset.card_univ, Fintype.card_fin]
      have : s a = U := by simp [hs]
      rw [this]
      gcongr
    calc volume {z : E3 | z a ∈ U ∧ ∀ i, i ≠ a → |z i - c i| < ρ}
        ≤ volume ((WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹' (Set.univ.pi s)) := measure_mono hsub
      _ = ∏ i, volume (s i) := hvol
      _ ≤ ENNReal.ofReal r * ENNReal.ofReal (2 * ρ) ^ 2 := hprod
      _ = ENNReal.ofReal (4 * ρ ^ 2 * r) := by
        rw [← ENNReal.ofReal_pow (by linarith), ← ENNReal.ofReal_mul hr]
        congr 1; ring
  
  have hI : ∀ (B : Set E3), Convex ℝ B → ∀ (a : Fin 3),
      (∀ y ∈ B, HasFDerivAt f (fderiv ℝ f y) y) → (∀ y ∈ B, fderiv ℝ f y (e a) ≠ 0) →
      Set.InjOn (fun y => y + (f y - y a) • e a) B := by
    intro B hB a hfd hne y hy z hz hyz
    have hcoord : ∀ i, (y + (f y - y a) • e a) i = (z + (f z - z a) • e a) i := fun i => by
      simp only at hyz
      rw [hyz]
    have hi : ∀ i, i ≠ a → y i = z i := by
      intro i hia
      have := hcoord i
      simpa [EuclideanSpace.single_apply, hia] using this
    have hfa : f y = f z := by
      have := hcoord a
      simpa [EuclideanSpace.single_apply] using this
    have hzy : z - y = (z a - y a) • e a := by
      ext i
      by_cases hia : i = a
      · subst hia; simp [EuclideanSpace.single_apply]
      · simp [EuclideanSpace.single_apply, hia, hi i hia]
    set γ : ℝ → E3 := fun s => y + s • (z - y) with hγ
    have hγB : ∀ s ∈ Set.Icc (0:ℝ) 1, γ s ∈ B := fun s hs => hB.add_smul_sub_mem hy hz hs
    have hderiv : ∀ s ∈ Set.Icc (0:ℝ) 1,
        HasDerivAt (fun s => f (γ s)) (fderiv ℝ f (γ s) (z - y)) s := by
      intro s hs
      have h1 : HasDerivAt γ (z - y) s :=
        (((hasDerivAt_id s).smul_const (z - y)).const_add y).congr_deriv (one_smul ℝ _)
      exact (hfd _ (hγB s hs)).comp_hasDerivAt s h1
    obtain ⟨c, hc, hc0⟩ := exists_hasDerivAt_eq_zero (f := fun s => f (γ s))
      (f' := fun s => fderiv ℝ f (γ s) (z - y)) (by norm_num : (0:ℝ) < 1)
      (fun s hs => (hderiv s hs).continuousAt.continuousWithinAt)
      (by simp [hγ, hfa])
      (fun s hs => hderiv s (Set.Ioo_subset_Icc_self hs))
    have hc0' : fderiv ℝ f (γ c) (z - y) = 0 := hc0
    rw [hzy, map_smul, smul_eq_mul] at hc0'
    have hne' := hne _ (hγB c (Set.Ioo_subset_Icc_self hc))
    have hza : z a - y a = 0 := by
      rcases mul_eq_zero.mp hc0' with h | h
      · exact h
      · exact absurd h hne'
    have : z - y = 0 := by rw [hzy, hza, zero_smul]
    exact (sub_eq_zero.mp this).symm
  
  have hlocal : ∀ y₀ ∈ O, fderiv ℝ f y₀ ≠ 0 →
      ∃ ρ C : ℝ, 0 < ρ ∧ 0 ≤ C ∧ ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r →
        volume U ≤ ENNReal.ofReal r →
        volume (Metric.ball y₀ ρ ∩ f ⁻¹' U) ≤ ENNReal.ofReal (C * r) := by
    intro y₀ hy₀ hd
    obtain ⟨a, ha⟩ : ∃ a : Fin 3, fderiv ℝ f y₀ (e a) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hd
      refine ContinuousLinearMap.ext fun v => ?_
      have hv : v = ∑ i, v i • e i := by
        ext j
        simp [Pi.single_apply]
      rw [hv, map_sum]
      simp [hcon]
    set lam := fderiv ℝ f y₀ (e a) with hlam
    have hj : 0 < |lam| / 2 := by
      have := abs_pos.mpr ha
      linarith
    have hcont : ContinuousOn (fun y => fderiv ℝ f y (e a)) O :=
      (hf.continuousOn_fderiv_of_isOpen hO (by simp)).clm_apply continuousOn_const
    have hca : ContinuousAt (fun y => fderiv ℝ f y (e a)) y₀ :=
      hcont.continuousAt (hO.mem_nhds hy₀)
    obtain ⟨δ, hδ, hδc⟩ := Metric.continuousAt_iff.mp hca (|lam| / 2) hj
    obtain ⟨ε', hε', hε'O⟩ := Metric.isOpen_iff.mp hO y₀ hy₀
    set ρ := min δ ε' with hρ
    have hρpos : 0 < ρ := lt_min hδ hε'
    have hBO : Metric.ball y₀ ρ ⊆ O := fun y hy =>
      hε'O (Metric.ball_subset_ball (min_le_right _ _) hy)
    have hbig : ∀ y ∈ Metric.ball y₀ ρ, |lam| / 2 < |fderiv ℝ f y (e a)| := by
      intro y hy
      have h1 := hδc (lt_of_lt_of_le (Metric.mem_ball.mp hy) (min_le_left _ _))
      rw [Real.dist_eq, abs_sub_comm] at h1
      have h2 := abs_sub_abs_le_abs_sub lam (fderiv ℝ f y (e a))
      linarith
    have hdiff : ∀ y ∈ Metric.ball y₀ ρ, HasFDerivAt f (fderiv ℝ f y) y := by
      intro y hy
      exact ((hf.differentiableOn (by simp)).differentiableAt
        (hO.mem_nhds (hBO hy))).hasFDerivAt
    set F' : E3 → E3 →L[ℝ] E3 := fun y => ContinuousLinearMap.id ℝ E3 +
        (fderiv ℝ f y - EuclideanSpace.proj a).smulRight (e a) with hF'
    have hFd : ∀ y ∈ Metric.ball y₀ ρ,
        HasFDerivAt (fun y => y + (f y - y a) • e a) (F' y) y := by
      intro y hy
      exact (hasFDerivAt_id y).add
        (((hdiff y hy).sub (EuclideanSpace.proj a).hasFDerivAt).smul_const (e a))
    have hpe : EuclideanSpace.proj a (e a) = 1 := by
      show (e a) a = 1
      simp
    have hdet : ∀ y, (F' y).det = fderiv ℝ f y (e a) := by
      intro y
      simp only [hF']
      rw [hD]
      rw [ContinuousLinearMap.sub_apply, hpe]
      ring
    have hinj : Set.InjOn (fun y => y + (f y - y a) • e a) (Metric.ball y₀ ρ) :=
      hI _ (convex_ball y₀ ρ) a hdiff (fun y hy => by
        have := hbig y hy
        intro h0
        rw [h0, abs_zero] at this
        linarith)
    have hSmeas : ∀ U : Set ℝ, MeasurableSet U → MeasurableSet (Metric.ball y₀ ρ ∩ f ⁻¹' U) := by
      intro U hU
      have hm : Measurable ((Metric.ball y₀ ρ).piecewise f (fun _ => (0:ℝ))) :=
        ContinuousOn.measurable_piecewise (hf.continuousOn.mono hBO) continuousOn_const
          measurableSet_ball
      have : Metric.ball y₀ ρ ∩ f ⁻¹' U =
          Metric.ball y₀ ρ ∩ ((Metric.ball y₀ ρ).piecewise f (fun _ => (0:ℝ))) ⁻¹' U := by
        ext y
        constructor
        · rintro ⟨hy, hyU⟩
          exact ⟨hy, by simpa [Set.piecewise, hy] using hyU⟩
        · rintro ⟨hy, hyU⟩
          exact ⟨hy, by simpa [Set.piecewise, hy] using hyU⟩
      rw [this]
      exact measurableSet_ball.inter (hm hU)
    refine ⟨ρ, 4 * ρ ^ 2 / (|lam| / 2), hρpos, by positivity, ?_⟩
    intro U hU r hr hUr
    have hS := hSmeas U hU
    have hcov := lintegral_abs_det_fderiv_eq_addHaar_image volume hS
      (fun y hy => (hFd y hy.1).hasFDerivWithinAt) (hinj.mono Set.inter_subset_left)
    have hlow : ENNReal.ofReal (|lam| / 2) * volume (Metric.ball y₀ ρ ∩ f ⁻¹' U) ≤
        ∫⁻ y in Metric.ball y₀ ρ ∩ f ⁻¹' U, ENNReal.ofReal |(F' y).det| := by
      rw [← setLIntegral_const]
      exact setLIntegral_mono' hS (fun y hy =>
        ENNReal.ofReal_le_ofReal (by rw [hdet]; exact (hbig y hy.1).le))
    have himg : (fun y => y + (f y - y a) • e a) '' (Metric.ball y₀ ρ ∩ f ⁻¹' U) ⊆
        {z : E3 | z a ∈ U ∧ ∀ i, i ≠ a → |z i - y₀ i| < ρ} := by
      rintro _ ⟨y, ⟨hyB, hyU⟩, rfl⟩
      refine ⟨?_, fun i hi => ?_⟩
      · simpa [EuclideanSpace.single_apply] using hyU
      · have h1 : (y + (f y - y a) • e a) i = y i := by
          simp [EuclideanSpace.single_apply, hi]
        rw [h1]
        have h2 := PiLp.norm_apply_le (y - y₀) i
        have h3 : ‖y - y₀‖ < ρ := mem_ball_iff_norm.mp hyB
        have h4 : (y - y₀) i = y i - y₀ i := by simp
        rw [h4, Real.norm_eq_abs] at h2
        linarith
    have hslab := hV a y₀ ρ hρpos.le U hU r hr hUr
    have hchain : ENNReal.ofReal (|lam| / 2) * volume (Metric.ball y₀ ρ ∩ f ⁻¹' U) ≤
        ENNReal.ofReal (4 * ρ ^ 2 * r) :=
      hlow.trans (hcov.le.trans ((measure_mono himg).trans hslab))
    have hfin : volume (Metric.ball y₀ ρ ∩ f ⁻¹' U) ≤
        ENNReal.ofReal (4 * ρ ^ 2 * r) / ENNReal.ofReal (|lam| / 2) := by
      rw [ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.mpr hj).ne')
        (Or.inl ENNReal.ofReal_ne_top), mul_comm]
      exact hchain
    rw [← ENNReal.ofReal_div_of_pos hj] at hfin
    refine hfin.trans (le_of_eq ?_)
    congr 1
    ring
  
  have hK'c : IsCompact (K ∩ nw ⁻¹' Set.Ici η₀) :=
    hK.of_isClosed_subset (hnw.preimage_isClosed_of_isClosed hK.isClosed isClosed_Ici)
      Set.inter_subset_left
  have hloc : ∀ y ∈ K ∩ nw ⁻¹' Set.Ici η₀, ∃ ρ C : ℝ, 0 < ρ ∧ 0 ≤ C ∧
      ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r → volume U ≤ ENNReal.ofReal r →
        volume (Metric.ball y ρ ∩ f ⁻¹' U) ≤ ENNReal.ofReal (C * r) := fun y hy =>
    hlocal y (hKO hy.1) (hreg y hy.1 (lt_of_lt_of_le hη₀ hy.2))
  
  choose! ρ C hρ hC hb using hloc
  obtain ⟨t, htK, hcover⟩ := hK'c.elim_nhds_subcover (fun y => Metric.ball y (ρ y))
    (fun y hy => Metric.ball_mem_nhds y (hρ y hy))
  refine ⟨∑ y ∈ t, C y, Finset.sum_nonneg (fun y hy => hC y (htK y hy)), ?_⟩
  intro U hU r hr hUr
  calc volume (K ∩ f ⁻¹' U ∩ {y | η₀ ≤ nw y})
      ≤ volume (⋃ y ∈ t, (Metric.ball y (ρ y) ∩ f ⁻¹' U)) := by
        apply measure_mono
        rintro x ⟨⟨hxK, hxU⟩, hxn⟩
        have := hcover ⟨hxK, hxn⟩
        simp only [Set.mem_iUnion] at this ⊢
        obtain ⟨y, hy, hxy⟩ := this
        exact ⟨y, hy, hxy, hxU⟩
    _ ≤ ∑ y ∈ t, volume (Metric.ball y (ρ y) ∩ f ⁻¹' U) := measure_biUnion_finset_le _ _
    _ ≤ ∑ y ∈ t, ENNReal.ofReal (C y * r) :=
        Finset.sum_le_sum (fun y hy => hb y (htK y hy) U hU r hr hUr)
    _ = ENNReal.ofReal (∑ y ∈ t, C y * r) :=
        (ENNReal.ofReal_sum_of_nonneg (fun y hy => mul_nonneg (hC y (htK y hy)) hr)).symm
    _ = ENNReal.ofReal ((∑ y ∈ t, C y) * r) := by rw [Finset.sum_mul]

theorem stern_slab_preimage_volume (K O : Set E3) (hK : IsCompact K) (hO : IsOpen O)
    (hKO : K ⊆ O) (f b : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f O) (hb : ContDiffOn ℝ ∞ b O)
    (nw : E3 → ℝ) (hnw : ContinuousOn nw K)
    (hind : ∀ y ∈ K, b y = 0 → 0 < nw y → ∀ a c : ℝ,
      a • fderiv ℝ b y + c • fderiv ℝ f y = 0 → a = 0 ∧ c = 0)
    (η₀ : ℝ) (hη₀ : 0 < η₀) :
    ∃ Cs s₆ : ℝ, 0 ≤ Cs ∧ 0 < s₆ ∧ ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r →
      volume U ≤ ENNReal.ofReal r → ∀ s : ℝ, 0 < s → s < s₆ →
      volume (K ∩ f ⁻¹' U ∩ {y | η₀ ≤ nw y} ∩ {y | 0 < b y ∧ b y < s}) ≤
        ENNReal.ofReal (Cs * s * r) :=
by
  classical
  
  have hdet : ∀ (l m : E3 →L[ℝ] ℝ) (i : Fin 3),
      (l.smulRight (e 0) + m.smulRight (e 1) +
        (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).smulRight (e 2)).det =
      (LinearMap.toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
          (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
          ((l.smulRight (e 0) + m.smulRight (e 1) +
            (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).smulRight (e 2)) : E3 →ₗ[ℝ] E3)).det :=
    fun l m i => (LinearMap.det_toMatrix _ _).symm
  have hdet0 : ∀ l m : E3 →L[ℝ] ℝ,
      (l.smulRight (e 0) + m.smulRight (e 1) +
        (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e 2)).det =
      l (e 1) * m (e 2) - l (e 2) * m (e 1) := by
    intro l m
    rw [hdet, Matrix.det_fin_three]
    simp [LinearMap.toMatrix_apply, EuclideanSpace.single_apply]
    try ring
  have hdet1 : ∀ l m : E3 →L[ℝ] ℝ,
      (l.smulRight (e 0) + m.smulRight (e 1) +
        (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e 2)).det =
      l (e 2) * m (e 0) - l (e 0) * m (e 2) := by
    intro l m
    rw [hdet, Matrix.det_fin_three]
    simp [LinearMap.toMatrix_apply, EuclideanSpace.single_apply]
    try ring
  have hdet2 : ∀ l m : E3 →L[ℝ] ℝ,
      (l.smulRight (e 0) + m.smulRight (e 1) +
        (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).smulRight (e 2)).det =
      l (e 0) * m (e 1) - l (e 1) * m (e 0) := by
    intro l m
    rw [hdet, Matrix.det_fin_three]
    simp [LinearMap.toMatrix_apply, EuclideanSpace.single_apply]
    try ring
  
  have hext : ∀ φ : E3 →L[ℝ] ℝ, φ (e 0) = 0 → φ (e 1) = 0 → φ (e 2) = 0 → φ = 0 := by
    intro φ h0 h1 h2
    refine ContinuousLinearMap.ext fun v => ?_
    have hv : v = ∑ j, v j • e j := by
      ext j
      simp [Pi.single_apply]
    rw [hv, map_sum]
    simp only [map_smul, smul_eq_mul, ContinuousLinearMap.zero_apply]
    rw [Fin.sum_univ_three, h0, h1, h2]
    ring
  
  have hgood : ∀ l m : E3 →L[ℝ] ℝ, (∀ a c : ℝ, a • l + c • m = 0 → a = 0 ∧ c = 0) →
      ∃ i : Fin 3, (l.smulRight (e 0) + m.smulRight (e 1) +
        (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).smulRight (e 2)).det ≠ 0 := by
    intro l m hlm
    by_contra hcon
    push_neg at hcon
    have c0 := hcon 0
    have c1 := hcon 1
    have c2 := hcon 2
    rw [hdet0] at c0
    rw [hdet1] at c1
    rw [hdet2] at c2
    have hz : (-(l (e 0) * m (e 0) + l (e 1) * m (e 1) + l (e 2) * m (e 2))) • l +
        (l (e 0) ^ 2 + l (e 1) ^ 2 + l (e 2) ^ 2) • m = 0 := by
      apply hext
      · simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        linear_combination (-(l (e 1))) * c2 + l (e 2) * c1
      · simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        linear_combination l (e 0) * c2 - l (e 2) * c0
      · simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        linear_combination (-(l (e 0))) * c1 + l (e 1) * c0
    have hγ := (hlm _ _ hz).2
    have hp0 : l (e 0) = 0 := by
      nlinarith [sq_nonneg (l (e 0)), sq_nonneg (l (e 1)), sq_nonneg (l (e 2))]
    have hp1 : l (e 1) = 0 := by
      nlinarith [sq_nonneg (l (e 0)), sq_nonneg (l (e 1)), sq_nonneg (l (e 2))]
    have hp2 : l (e 2) = 0 := by
      nlinarith [sq_nonneg (l (e 0)), sq_nonneg (l (e 1)), sq_nonneg (l (e 2))]
    have hl : l = 0 := hext l hp0 hp1 hp2
    have h10 := (hlm 1 0 (by rw [hl]; simp)).1
    exact one_ne_zero h10
  
  have hstrict : ∀ y₀ ∈ O, ∀ i : Fin 3,
      HasStrictFDerivAt (fun y : E3 => b y • e 0 + f y • e 1 + y i • e 2)
        ((fderiv ℝ b y₀).smulRight (e 0) + (fderiv ℝ f y₀).smulRight (e 1) +
          (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).smulRight (e 2)) y₀ := by
    intro y₀ hy₀ i
    have hb' : HasStrictFDerivAt b (fderiv ℝ b y₀) y₀ :=
      (hb.contDiffAt (hO.mem_nhds hy₀)).hasStrictFDerivAt (by simp)
    have hf' : HasStrictFDerivAt f (fderiv ℝ f y₀) y₀ :=
      (hf.contDiffAt (hO.mem_nhds hy₀)).hasStrictFDerivAt (by simp)
    have hp : HasStrictFDerivAt (fun y : E3 => y i) (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) y₀ :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasStrictFDerivAt
    exact ((hb'.smul_const (e 0)).add (hf'.smul_const (e 1))).add (hp.smul_const (e 2))
  
  have hexp : ∀ (F : E3 → E3) (A : E3 →L[ℝ] E3) (y₀ : E3), HasStrictFDerivAt F A y₀ →
      A.det ≠ 0 → ∃ ρ : ℝ, 0 < ρ ∧ ∃ m : ℝ, 0 < m ∧ ∀ S : Set E3, S ⊆ Metric.ball y₀ ρ →
        ENNReal.ofReal m * volume S ≤ volume (F '' S) := by
    intro F A y₀ hF hA
    have hd : 0 < |A.det| := abs_pos.mpr hA
    set m₀ : NNReal := (|A.det| / 2).toNNReal with hm₀
    have hlt : (m₀ : ENNReal) < ENNReal.ofReal |A.det| :=
      (ENNReal.ofReal_lt_ofReal_iff hd).mpr (by linarith)
    have hev := mul_le_addHaar_image_of_lt_det (volume : Measure E3) A hlt
    have hpos : ∀ᶠ δ : NNReal in 𝓝[>] 0, 0 < δ := self_mem_nhdsWithin
    obtain ⟨δ, hδ, hδpos⟩ := (hev.and hpos).exists
    obtain ⟨t, ht, happrox⟩ := hF.approximates_deriv_on_nhds (Or.inr hδpos)
    obtain ⟨ρ, hρ, hρt⟩ := Metric.mem_nhds_iff.mp ht
    refine ⟨ρ, hρ, |A.det| / 2, by linarith, fun S hS => ?_⟩
    exact hδ S F (happrox.mono_set (hS.trans hρt))
  
  have hbox : ∀ (U : Set ℝ), MeasurableSet U → ∀ r : ℝ, 0 ≤ r → volume U ≤ ENNReal.ofReal r →
      ∀ s R : ℝ, 0 ≤ s → 0 ≤ R →
      volume {z : E3 | z 0 ∈ Set.Ioo 0 s ∧ z 1 ∈ U ∧ z 2 ∈ Set.Icc (-R) R} ≤
        ENNReal.ofReal (2 * R * s * r) := by
    intro U hU r hr hUr s R hs hR
    set T : Fin 3 → Set ℝ := ![Set.Ioo 0 s, U, Set.Icc (-R) R] with hT
    have hsub : {z : E3 | z 0 ∈ Set.Ioo 0 s ∧ z 1 ∈ U ∧ z 2 ∈ Set.Icc (-R) R} ⊆
        (WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹' (Set.univ.pi T) := by
      rintro z ⟨h0, h1, h2⟩
      simp only [Set.mem_preimage, Set.mem_univ_pi]
      intro i
      fin_cases i
      · exact h0
      · exact h1
      · exact h2
    have hTm : ∀ i, MeasurableSet (T i) := by
      intro i
      fin_cases i
      · exact measurableSet_Ioo
      · exact hU
      · exact measurableSet_Icc
    have hvol : volume ((WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹' (Set.univ.pi T)) =
        ∏ i, volume (T i) := by
      rw [(PiLp.volume_preserving_ofLp (Fin 3)).measure_preimage
        (MeasurableSet.univ_pi hTm).nullMeasurableSet, volume_pi_pi]
    have hprod : ∏ i, volume (T i) =
        ENNReal.ofReal s * volume U * ENNReal.ofReal (2 * R) := by
      rw [Fin.prod_univ_three]
      show volume (Set.Ioo 0 s) * volume U * volume (Set.Icc (-R) R) = _
      rw [Real.volume_Ioo, Real.volume_Icc, sub_zero, show R - -R = 2 * R by ring]
    calc volume {z : E3 | z 0 ∈ Set.Ioo 0 s ∧ z 1 ∈ U ∧ z 2 ∈ Set.Icc (-R) R}
        ≤ volume ((WithLp.ofLp : E3 → (Fin 3 → ℝ)) ⁻¹' (Set.univ.pi T)) := measure_mono hsub
      _ = ENNReal.ofReal s * volume U * ENNReal.ofReal (2 * R) := by rw [hvol, hprod]
      _ ≤ ENNReal.ofReal s * ENNReal.ofReal r * ENNReal.ofReal (2 * R) := by gcongr
      _ = ENNReal.ofReal (2 * R * s * r) := by
        rw [← ENNReal.ofReal_mul hs, ← ENNReal.ofReal_mul (mul_nonneg hs hr)]
        congr 1
        ring
  
  have hlocal : ∀ y₀ ∈ K, b y₀ = 0 → η₀ ≤ nw y₀ → ∃ ρ : ℝ, 0 < ρ ∧ ∃ C : ℝ, 0 ≤ C ∧
      ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r → volume U ≤ ENNReal.ofReal r →
        ∀ s : ℝ, 0 < s →
        volume (Metric.ball y₀ ρ ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) ≤
          ENNReal.ofReal (C * s * r) := by
    intro y₀ hy₀K hb0 hnw0
    obtain ⟨i, hi⟩ := hgood _ _ (hind y₀ hy₀K hb0 (lt_of_lt_of_le hη₀ hnw0))
    obtain ⟨ρ, hρ, m, hm, hS⟩ := hexp _ _ y₀ (hstrict y₀ (hKO hy₀K) i) hi
    have hR : 0 ≤ ‖y₀‖ + ρ := add_nonneg (norm_nonneg _) hρ.le
    refine ⟨ρ, hρ, 2 * (‖y₀‖ + ρ) / m,
      div_nonneg (mul_nonneg zero_le_two hR) hm.le, ?_⟩
    intro U hU r hr hUr s hs
    have himg : (fun y : E3 => b y • e 0 + f y • e 1 + y i • e 2) ''
        (Metric.ball y₀ ρ ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) ⊆
        {z : E3 | z 0 ∈ Set.Ioo 0 s ∧ z 1 ∈ U ∧
          z 2 ∈ Set.Icc (-(‖y₀‖ + ρ)) (‖y₀‖ + ρ)} := by
      rintro _ ⟨y, ⟨hyB, hyU, hyb⟩, rfl⟩
      have h0 : (b y • e 0 + f y • e 1 + y i • e 2) 0 = b y := by
        simp [EuclideanSpace.single_apply]
      have h1 : (b y • e 0 + f y • e 1 + y i • e 2) 1 = f y := by
        simp [EuclideanSpace.single_apply]
      have h2 : (b y • e 0 + f y • e 1 + y i • e 2) 2 = y i := by
        simp [EuclideanSpace.single_apply]
      refine ⟨?_, ?_, ?_⟩
      · show (b y • e 0 + f y • e 1 + y i • e 2) 0 ∈ Set.Ioo 0 s
        rw [h0]; exact hyb
      · show (b y • e 0 + f y • e 1 + y i • e 2) 1 ∈ U
        rw [h1]; exact hyU
      · show (b y • e 0 + f y • e 1 + y i • e 2) 2 ∈ Set.Icc (-(‖y₀‖ + ρ)) (‖y₀‖ + ρ)
        rw [h2]
        have h3 := PiLp.norm_apply_le y i
        have h4 : ‖y - y₀‖ < ρ := mem_ball_iff_norm.mp hyB
        have h5 := norm_sub_norm_le y y₀
        rw [Real.norm_eq_abs] at h3
        exact abs_le.mp (by linarith)
    have hchain : ENNReal.ofReal m *
        volume (Metric.ball y₀ ρ ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) ≤
        ENNReal.ofReal (2 * (‖y₀‖ + ρ) * s * r) :=
      (hS _ Set.inter_subset_left).trans ((measure_mono himg).trans
        (hbox U hU r hr hUr s _ hs.le hR))
    have hfin : volume (Metric.ball y₀ ρ ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) ≤
        ENNReal.ofReal (2 * (‖y₀‖ + ρ) * s * r) / ENNReal.ofReal m := by
      rw [ENNReal.le_div_iff_mul_le (Or.inl (ENNReal.ofReal_pos.mpr hm).ne')
        (Or.inl ENNReal.ofReal_ne_top), mul_comm]
      exact hchain
    rw [← ENNReal.ofReal_div_of_pos hm] at hfin
    refine hfin.trans (le_of_eq ?_)
    congr 1
    ring
  
  have hK₁ : IsCompact (K ∩ nw ⁻¹' Set.Ici η₀) :=
    hK.of_isClosed_subset (hnw.preimage_isClosed_of_isClosed hK.isClosed isClosed_Ici)
      Set.inter_subset_left
  have hbK₁ : ContinuousOn b (K ∩ nw ⁻¹' Set.Ici η₀) :=
    hb.continuousOn.mono (fun y hy => hKO hy.1)
  have hK₀ : IsCompact (K ∩ nw ⁻¹' Set.Ici η₀ ∩ b ⁻¹' {0}) :=
    hK₁.of_isClosed_subset (hbK₁.preimage_isClosed_of_isClosed hK₁.isClosed isClosed_singleton)
      Set.inter_subset_left
  have hloc : ∀ y ∈ K ∩ nw ⁻¹' Set.Ici η₀ ∩ b ⁻¹' {0}, ∃ ρ : ℝ, 0 < ρ ∧ ∃ C : ℝ, 0 ≤ C ∧
      ∀ U : Set ℝ, MeasurableSet U → ∀ r : ℝ, 0 ≤ r → volume U ≤ ENNReal.ofReal r →
        ∀ s : ℝ, 0 < s →
        volume (Metric.ball y ρ ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) ≤
          ENNReal.ofReal (C * s * r) :=
    fun y hy => hlocal y hy.1.1 hy.2 hy.1.2
  choose! ρ hρ C hC hbd using hloc
  obtain ⟨t, htK, hcover⟩ := hK₀.elim_nhds_subcover (fun y => Metric.ball y (ρ y))
    (fun y hy => Metric.ball_mem_nhds y (hρ y hy))
  have hWo : IsOpen (⋃ y ∈ t, Metric.ball y (ρ y)) :=
    isOpen_biUnion (fun y _ => Metric.isOpen_ball)
  obtain ⟨s₆, hs₆, hthin⟩ : ∃ s₆ : ℝ, 0 < s₆ ∧ ∀ y ∈ K ∩ nw ⁻¹' Set.Ici η₀, 0 < b y →
      b y < s₆ → y ∈ ⋃ y ∈ t, Metric.ball y (ρ y) := by
    by_cases hne : ((K ∩ nw ⁻¹' Set.Ici η₀) \ ⋃ y ∈ t, Metric.ball y (ρ y)).Nonempty
    · obtain ⟨y', hy', hmin⟩ := (hK₁.diff hWo).exists_isMinOn hne
        (continuous_abs.comp_continuousOn (hbK₁.mono Set.diff_subset))
      have hb' : b y' ≠ 0 := fun h => hy'.2 (hcover ⟨hy'.1, h⟩)
      refine ⟨|b y'|, abs_pos.mpr hb', fun y hy hpos hlt => ?_⟩
      by_contra hyW
      have hle : |b y'| ≤ |b y| := isMinOn_iff.mp hmin y ⟨hy, hyW⟩
      rw [abs_of_pos hpos] at hle
      linarith
    · refine ⟨1, one_pos, fun y hy _ _ => ?_⟩
      by_contra hyW
      exact hne ⟨y, hy, hyW⟩
  refine ⟨∑ y ∈ t, C y, s₆, Finset.sum_nonneg (fun y hy => hC y (htK y hy)), hs₆, ?_⟩
  intro U hU r hr hUr s hs hss
  calc volume (K ∩ f ⁻¹' U ∩ {y | η₀ ≤ nw y} ∩ {y | 0 < b y ∧ b y < s})
      ≤ volume (⋃ y ∈ t, (Metric.ball y (ρ y) ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s}))) := by
        apply measure_mono
        rintro x ⟨⟨⟨hxK, hxU⟩, hxn⟩, hxb⟩
        have hxW := hthin x ⟨hxK, hxn⟩ hxb.1 (lt_trans hxb.2 hss)
        simp only [Set.mem_iUnion] at hxW ⊢
        obtain ⟨y, hy, hxy⟩ := hxW
        exact ⟨y, hy, hxy, hxU, hxb⟩
    _ ≤ ∑ y ∈ t, volume (Metric.ball y (ρ y) ∩ (f ⁻¹' U ∩ {y | 0 < b y ∧ b y < s})) :=
        measure_biUnion_finset_le _ _
    _ ≤ ∑ y ∈ t, ENNReal.ofReal (C y * s * r) :=
        Finset.sum_le_sum (fun y hy => hbd y (htK y hy) U hU r hr hUr s hs)
    _ = ENNReal.ofReal (∑ y ∈ t, C y * s * r) :=
        (ENNReal.ofReal_sum_of_nonneg (fun y hy =>
          mul_nonneg (mul_nonneg (hC y (htK y hy)) hs.le) hr)).symm
    _ = ENNReal.ofReal ((∑ y ∈ t, C y) * s * r) := by rw [Finset.sum_mul, Finset.sum_mul]

theorem stern_thin_band_volume [IsManifold 𝓘(ℝ, E3) ∞ M] (β : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hβr : ∀ p : M, β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0) (q : M) (Kc : Set E3)
    (hKc : IsCompact Kc) (hKT : Kc ⊆ (chartAt E3 q).target) :
    ∃ Cb s₀ : ℝ, 0 < s₀ ∧ ∀ s : ℝ, 0 < s → s < s₀ →
      volume (Kc ∩ {y | 0 < β ((chartAt E3 q).symm y) ∧ β ((chartAt E3 q).symm y) < s}) ≤
        ENNReal.ofReal (Cb * s) :=
by
  classical
  set c := chartAt E3 q with hc
  set b : E3 → ℝ := fun y => β (c.symm y) with hbdef
  have hT : IsOpen c.target := c.open_target
  
  have hbT : ContDiffOn ℝ ∞ b c.target := by
    have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (β ∘ c.symm) c.target :=
      hβ.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp this
  have hreg : ∀ y ∈ c.target, b y = 0 → fderiv ℝ b y ≠ 0 := by
    intro y hy hb0 hd
    have hxs : c.symm y ∈ c.source := c.map_target hy
    have hcx : c (c.symm y) = y := c.right_inv hy
    have hbd : DifferentiableAt ℝ b y :=
      (hbT.contDiffAt (hT.mem_nhds hy)).differentiableAt (by simp)
    have hev : β =ᶠ[𝓝 (c.symm y)] (b ∘ c) := by
      filter_upwards [c.open_source.mem_nhds hxs] with z hz
      show β z = β (c.symm (c z))
      rw [c.left_inv hz]
    have hmc : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) c (c.symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hxs
    have hmb : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) b (c (c.symm y)) := by
      rw [hcx]; exact hbd.mdifferentiableAt
    have hb0' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) b (c (c.symm y)) = 0 := by
      rw [mfderiv_eq_fderiv, hcx]; exact hd
    have h1 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β (c.symm y) = 0 := by
      rw [hev.mfderiv_eq, mfderiv_comp (c.symm y) hmb hmc, hb0']
      exact ContinuousLinearMap.zero_comp _
    exact hβr (c.symm y) hb0 h1
  
  have growth : ∀ y₀ ∈ c.target, fderiv ℝ b y₀ ≠ 0 →
      ∃ R cc : ℝ, ∃ v : E3, 0 < R ∧ 0 < cc ∧ ‖v‖ = 1 ∧ Metric.ball y₀ (2 * R) ⊆ c.target ∧
        ∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v) := by
    intro y₀ hy₀ hd
    obtain ⟨w, hw⟩ : ∃ w, fderiv ℝ b y₀ w ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hd (ContinuousLinearMap.ext hcon)
    have hw0 : w ≠ 0 := by
      rintro rfl
      simp at hw
    have hwn : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hwi : 0 < ‖w‖⁻¹ := inv_pos.mpr hwn
    obtain ⟨v, hv1, hav⟩ : ∃ v : E3, ‖v‖ = 1 ∧ 0 < fderiv ℝ b y₀ v := by
      rcases lt_or_gt_of_ne hw with h | h
      · refine ⟨-(‖w‖⁻¹ • w), ?_, ?_⟩
        · rw [norm_neg, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_neg, map_smul, smul_eq_mul]
          nlinarith
      · refine ⟨‖w‖⁻¹ • w, ?_, ?_⟩
        · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_smul, smul_eq_mul]
          exact mul_pos hwi h
    have hfc : ContinuousOn (fderiv ℝ b) c.target :=
      hbT.continuousOn_fderiv_of_isOpen hT (by simp)
    have hfca : ContinuousAt (fderiv ℝ b) y₀ := hfc.continuousAt (hT.mem_nhds hy₀)
    obtain ⟨δ₁, hδ₁, hδ₁'⟩ := Metric.continuousAt_iff.mp hfca (fderiv ℝ b y₀ v / 2)
      (by linarith)
    obtain ⟨δ₂, hδ₂, hδ₂'⟩ := Metric.isOpen_iff.mp hT y₀ hy₀
    have hδ : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
    have hballT : Metric.ball y₀ (min δ₁ δ₂) ⊆ c.target :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hδ₂'
    have hder : ∀ z ∈ Metric.ball y₀ (min δ₁ δ₂), fderiv ℝ b y₀ v / 2 < fderiv ℝ b z v := by
      intro z hz
      have hz1 : dist z y₀ < δ₁ := lt_of_lt_of_le hz (min_le_left _ _)
      have h1 := hδ₁' hz1
      rw [dist_eq_norm] at h1
      have h2 : ‖(fderiv ℝ b z - fderiv ℝ b y₀) v‖ ≤ ‖fderiv ℝ b z - fderiv ℝ b y₀‖ * ‖v‖ :=
        ContinuousLinearMap.le_opNorm _ _
      rw [hv1, mul_one, ContinuousLinearMap.sub_apply, Real.norm_eq_abs] at h2
      have h3 := neg_abs_le (fderiv ℝ b z v - fderiv ℝ b y₀ v)
      linarith
    refine ⟨min δ₁ δ₂ / 2, fderiv ℝ b y₀ v / 2, v, by linarith, by linarith, hv1, ?_, ?_⟩
    · rw [show 2 * (min δ₁ δ₂ / 2) = min δ₁ δ₂ by ring]
      exact hballT
    · intro y hy t ht0 htR
      have hseg : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t → y + τ • v ∈ Metric.ball y₀ (min δ₁ δ₂) := by
        intro τ hτ0 hτt
        rw [Metric.mem_ball] at hy ⊢
        calc dist (y + τ • v) y₀ ≤ dist (y + τ • v) y + dist y y₀ := dist_triangle _ _ _
          _ = τ + dist y y₀ := by
              rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hv1, mul_one, Real.norm_eq_abs,
                abs_of_nonneg hτ0]
          _ < min δ₁ δ₂ := by linarith
      have hderiv : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t →
          HasDerivAt (fun τ => b (y + τ • v)) (fderiv ℝ b (y + τ • v) v) τ := by
        intro τ hτ0 hτt
        have hmem := hballT (hseg τ hτ0 hτt)
        have hbd : DifferentiableAt ℝ b (y + τ • v) :=
          (hbT.contDiffAt (hT.mem_nhds hmem)).differentiableAt (by simp)
        have hp : HasDerivAt (fun τ : ℝ => y + τ • v) v τ := by
          simpa using ((hasDerivAt_id τ).smul_const v).const_add y
        exact hbd.hasFDerivAt.comp_hasDerivAt τ hp
      rcases eq_or_lt_of_le ht0 with h | h
      · subst h
        simp
      · have hcont : ContinuousOn (fun τ => b (y + τ • v)) (Set.Icc 0 t) := by
          intro τ hτ
          exact (hderiv τ hτ.1 hτ.2).continuousAt.continuousWithinAt
        obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (fun τ => b (y + τ • v))
          (fun τ => fderiv ℝ b (y + τ • v) v) h hcont
          (fun τ hτ => hderiv τ hτ.1.le hτ.2.le)
        have hgt := hder _ (hseg ξ hξ.1.le hξ.2.le)
        rw [hξeq] at hgt
        simp only [zero_smul, add_zero, sub_zero] at hgt
        rw [lt_div_iff₀ h] at hgt
        linarith
  
  have pack : ∀ (y₀ v : E3) (R cc : ℝ), 0 < R → 0 < cc → ‖v‖ = 1 →
      ContinuousOn b (Metric.ball y₀ R) →
      (∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v)) →
      ∀ s : ℝ, 0 < s → s < R * cc →
        volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≤
          ENNReal.ofReal (2 * (volume (Metric.ball y₀ (2 * R))).toReal / (R * cc) * s) := by
    intro y₀ v R cc hR hcc hv hbc hgrow s hs hsR
    have hUo : IsOpen (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) :=
      hbc.isOpen_inter_preimage Metric.isOpen_ball (isOpen_Ioo (a := (0 : ℝ)) (b := s))
    have hhpos : 0 < s / cc := div_pos hs hcc
    have hx1 : 1 < R * cc / s := by rw [lt_div_iff₀ hs]; linarith
    have hN1 : 0 < ⌊R * cc / s⌋₊ := Nat.floor_pos.mpr hx1.le
    have hNx : (⌊R * cc / s⌋₊ : ℝ) ≤ R * cc / s := Nat.floor_le (by linarith)
    have hxN : R * cc / s < ⌊R * cc / s⌋₊ + 1 := Nat.lt_floor_add_one _
    have hNh : (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R := by
      calc (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R * cc / s * (s / cc) :=
            mul_le_mul_of_nonneg_right hNx hhpos.le
        _ = R := by field_simp
    have hUkm : ∀ k : ℕ, MeasurableSet
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := fun k =>
      (measurable_add_const _) hUo.measurableSet
    have hUkv : ∀ k : ℕ, volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) =
        volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) := fun k =>
      measure_preimage_add_right volume _ _
    have hUksub : ∀ k ∈ Finset.range ⌊R * cc / s⌋₊,
        (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ⊆ Metric.ball y₀ (2 * R) := by
      intro k hk z hz
      have hkN : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast (Finset.mem_range.mp hk).le
      have hd : dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ < R := hz.1
      have hkh : 0 ≤ (k : ℝ) * (s / cc) := mul_nonneg (Nat.cast_nonneg k) hhpos.le
      have hkh2 : (k : ℝ) * (s / cc) ≤ ⌊R * cc / s⌋₊ * (s / cc) :=
        mul_le_mul_of_nonneg_right hkN hhpos.le
      have hdz : dist z (z + (-((k : ℝ) * (s / cc))) • v) = (k : ℝ) * (s / cc) := by
        rw [dist_eq_norm, sub_add_cancel_left, norm_neg, norm_smul, hv, mul_one,
          Real.norm_eq_abs, abs_neg, abs_of_nonneg hkh]
      rw [Metric.mem_ball]
      calc dist z y₀ ≤ dist z (z + (-((k : ℝ) * (s / cc))) • v) +
            dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ := dist_triangle _ _ _
        _ < (k : ℝ) * (s / cc) + R := by rw [hdz]; linarith
        _ ≤ 2 * R := by linarith
    have key : ∀ j k : ℕ, j < k → k < ⌊R * cc / s⌋₊ → Disjoint
        ((fun z => z + (-((j : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}))
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j k hjk hkN
      rw [Set.disjoint_left]
      intro z hzj hzk
      have hj : z + (-((j : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzj
      have hk : z + (-((k : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzk
      have hjk' : (j : ℝ) + 1 ≤ k := by exact_mod_cast hjk
      have hkN' : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hkN.le
      have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg j
      have ht0 : s / cc ≤ ((k : ℝ) - j) * (s / cc) := by nlinarith
      have htR : ((k : ℝ) - j) * (s / cc) ≤ R := by
        have : ((k : ℝ) - j) * (s / cc) ≤ (⌊R * cc / s⌋₊ : ℝ) * (s / cc) := by nlinarith
        linarith
      have heq : z + (-((k : ℝ) * (s / cc))) • v + (((k : ℝ) - j) * (s / cc)) • v =
          z + (-((j : ℝ) * (s / cc))) • v := by
        rw [add_assoc, ← add_smul]
        congr 2
        ring
      have hg := hgrow _ hk.1 (((k : ℝ) - j) * (s / cc)) (by linarith) htR
      rw [heq] at hg
      have h1 : 0 < b (z + (-((k : ℝ) * (s / cc))) • v) := hk.2.1
      have h2 : b (z + (-((j : ℝ) * (s / cc))) • v) < s := hj.2.2
      have h3 : cc * (s / cc) ≤ cc * (((k : ℝ) - j) * (s / cc)) :=
        mul_le_mul_of_nonneg_left ht0 hcc.le
      have hcs : cc * (s / cc) = s := by field_simp
      linarith
    have hdisj : Set.PairwiseDisjoint (↑(Finset.range ⌊R * cc / s⌋₊) : Set ℕ)
        (fun k : ℕ => (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j hj k hk hne
      rcases lt_or_gt_of_ne hne with h' | h'
      · exact key j k h' (Finset.mem_range.mp hk)
      · exact (key k j h' (Finset.mem_range.mp hj)).symm
    have hsum : ∑ k ∈ Finset.range ⌊R * cc / s⌋₊, volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) ≤
        volume (Metric.ball y₀ (2 * R)) := by
      rw [← measure_biUnion_finset hdisj (fun k _ => hUkm k)]
      exact measure_mono (Set.iUnion₂_subset hUksub)
    simp only [hUkv, Finset.sum_const, Finset.card_range, nsmul_eq_mul] at hsum
    have hWt : volume (Metric.ball y₀ (2 * R)) ≠ ⊤ := measure_ball_lt_top.ne
    have hUt : volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≠ ⊤ := by
      intro htop
      rw [htop, ENNReal.mul_top (Nat.cast_ne_zero.mpr (by omega))] at hsum
      exact hWt (top_le_iff.mp hsum)
    have hreal : (⌊R * cc / s⌋₊ : ℝ) *
        (volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal ≤
        (volume (Metric.ball y₀ (2 * R))).toReal := by
      have := ENNReal.toReal_mono hWt hsum
      rwa [ENNReal.toReal_mul, ENNReal.toReal_natCast] at this
    rw [← ENNReal.ofReal_toReal hUt]
    apply ENNReal.ofReal_le_ofReal
    have hU0 : 0 ≤ (volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal :=
      ENNReal.toReal_nonneg
    have hN1' : (1 : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hN1
    have hRc : R * cc ≤ 2 * ⌊R * cc / s⌋₊ * s := by
      have h2N : R * cc / s ≤ 2 * ⌊R * cc / s⌋₊ := by linarith
      rw [div_le_iff₀ hs] at h2N
      linarith
    rw [div_mul_eq_mul_div, le_div_iff₀ (mul_pos hR hcc)]
    calc (volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal * (R * cc)
        ≤ (volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal *
            (2 * ⌊R * cc / s⌋₊ * s) := mul_le_mul_of_nonneg_left hRc hU0
      _ = 2 * s * ((⌊R * cc / s⌋₊ : ℝ) *
            (volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal) := by ring
      _ ≤ 2 * s * (volume (Metric.ball y₀ (2 * R))).toReal :=
          mul_le_mul_of_nonneg_left hreal (by linarith)
      _ = 2 * (volume (Metric.ball y₀ (2 * R))).toReal * s := by ring
  
  have hloc : ∀ y₀ ∈ Kc, ∃ r C s₁ : ℝ, 0 < r ∧ 0 ≤ C ∧ 0 < s₁ ∧ ∀ s : ℝ, 0 < s → s < s₁ →
      volume (Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s}) ≤ ENNReal.ofReal (C * s) := by
    intro y₀ hy₀
    have hy₀T := hKT hy₀
    by_cases hb0 : b y₀ = 0
    · obtain ⟨R, cc, v, hR, hcc, hv, hball, hgrow⟩ := growth y₀ hy₀T (hreg y₀ hy₀T hb0)
      have hbc : ContinuousOn b (Metric.ball y₀ R) :=
        hbT.continuousOn.mono ((Metric.ball_subset_ball (by linarith)).trans hball)
      refine ⟨R, 2 * (volume (Metric.ball y₀ (2 * R))).toReal / (R * cc), R * cc, hR,
        div_nonneg (mul_nonneg zero_le_two ENNReal.toReal_nonneg) (mul_pos hR hcc).le,
        mul_pos hR hcc, ?_⟩
      exact pack y₀ v R cc hR hcc hv hbc hgrow
    · have hm : 0 < |b y₀| := abs_pos.mpr hb0
      have hca : ContinuousAt b y₀ := hbT.continuousOn.continuousAt (hT.mem_nhds hy₀T)
      obtain ⟨r, hr, hr'⟩ := Metric.continuousAt_iff.mp hca (|b y₀| / 2) (by linarith)
      refine ⟨r, 0, |b y₀| / 2, hr, le_rfl, by linarith, fun s hs hss => ?_⟩
      have hempty : Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s} = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        rintro z ⟨hz, hz1, hz2⟩
        have h1 : dist (b z) (b y₀) < |b y₀| / 2 := hr' hz
        rw [Real.dist_eq] at h1
        have h2 := abs_sub_abs_le_abs_sub (b y₀) (b z)
        have h3 : |b y₀ - b z| = |b z - b y₀| := abs_sub_comm _ _
        rw [abs_of_pos hz1] at h2
        linarith
      rw [hempty, measure_empty]
      exact zero_le _
  
  choose! r C s₁ hr hC hs₁ hbd using hloc
  obtain ⟨t, htK, hcover⟩ := hKc.elim_nhds_subcover (fun y => Metric.ball y (r y))
    (fun y hy => Metric.ball_mem_nhds y (hr y hy))
  refine ⟨∑ y ∈ t, C y, (insert 1 (t.image s₁)).min' (Finset.insert_nonempty _ _), ?_,
    fun s hs hss => ?_⟩
  · have hm := Finset.min'_mem (insert 1 (t.image s₁)) (Finset.insert_nonempty _ _)
    rw [Finset.mem_insert, Finset.mem_image] at hm
    rcases hm with h | ⟨y, hy, hy'⟩
    · rw [h]; exact one_pos
    · rw [← hy']; exact hs₁ y (htK y hy)
  · have hle : ∀ y ∈ t, s < s₁ y := fun y hy => lt_of_lt_of_le hss
      (Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hy)))
    calc volume (Kc ∩ {y | 0 < b y ∧ b y < s})
        ≤ volume (⋃ y ∈ t, (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s})) := by
          apply measure_mono
          rintro z ⟨hzK, hz⟩
          have hzc := hcover hzK
          rw [Set.mem_iUnion₂] at hzc ⊢
          obtain ⟨y, hy, hzy⟩ := hzc
          exact ⟨y, hy, hzy, hz⟩
      _ ≤ ∑ y ∈ t, volume (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s}) :=
          measure_biUnion_finset_le _ _
      _ ≤ ∑ y ∈ t, ENNReal.ofReal (C y * s) :=
          Finset.sum_le_sum (fun y hy => hbd y (htK y hy) s hs (hle y hy))
      _ = ENNReal.ofReal (∑ y ∈ t, C y * s) :=
          (ENNReal.ofReal_sum_of_nonneg (fun y hy => mul_nonneg (hC y (htK y hy)) hs.le)).symm
      _ = ENNReal.ofReal ((∑ y ∈ t, C y) * s) := by rw [Finset.sum_mul]

theorem stern_bad_chart_bound (D DA Kc : Set E3) (hD : MeasurableSet D) (hDA : MeasurableSet DA)
    (hDAD : DA ⊆ D) (hKc : IsCompact Kc) (hKD : Kc ⊆ D)
    (fB fC nw b : E3 → ℝ) (hfB : ContinuousOn fB Kc) (hfC : ContinuousOn fC Kc)
    (hnw : ContinuousOn nw Kc) (hb : ContinuousOn b Kc)
    (hvan : ∀ y ∈ D \ Kc, fB y = 0 ∧ fC y = 0)
    (W C₀ C₁ Mη τ Cb Nm a₁ a₂ η₀ s : ℝ) (hW : 0 ≤ W) (hC₀ : 0 ≤ C₀) (hC₁ : 0 ≤ C₁)
    (hMη : 0 ≤ Mη) (hτ : 0 ≤ τ) (hCb : 0 ≤ Cb) (hNm : 0 ≤ Nm) (ha₁ : 0 ≤ a₁) (ha₂ : 0 ≤ a₂)
    (hη₀ : 0 ≤ η₀) (hs : 0 < s)
    (hn0 : ∀ y ∈ Kc, 0 ≤ nw y) (hnm : ∀ y ∈ Kc, nw y ≤ Nm)
    (hptB : ∀ y ∈ Kc, -(W * (C₀ * nw y)) ≤ fB y)
    (hptC : ∀ y ∈ Kc, -(W * (s⁻¹ * Mη * Set.indicator {z | 0 < b z ∧ b z < s}
      (fun _ => (1 : ℝ)) y * (C₁ * nw y + τ))) ≤ fC y)
    (h1 : volume ((D \ DA) ∩ Kc ∩ {y | η₀ ≤ nw y}) ≤ ENNReal.ofReal a₁)
    (h2 : volume ((D \ DA) ∩ Kc ∩ {y | η₀ ≤ nw y} ∩ {y | 0 < b y ∧ b y < s}) ≤
      ENNReal.ofReal (s * a₂))
    (h3 : volume (Kc ∩ {y | 0 < b y ∧ b y < s}) ≤ ENNReal.ofReal (Cb * s)) :
    -(W * (C₀ * (η₀ * (volume Kc).toReal + Nm * a₁) + Mη * C₁ * (η₀ * Cb + Nm * a₂) +
        Mη * τ * Cb)) ≤
      ((∫ y in D, fB y) + (∫ y in D, fC y)) - ((∫ y in DA, fB y) + (∫ y in DA, fC y)) :=
by
  
  have hred : ∀ f : E3 → ℝ, ContinuousOn f Kc → (∀ y ∈ D \ Kc, f y = 0) →
      (∫ y in D, f y) - (∫ y in DA, f y) = ∫ y in (D \ DA) ∩ Kc, f y := by
    intro f hf hv
    have hIK : IntegrableOn f Kc := hf.integrableOn_compact hKc
    have hID : IntegrableOn f D := hIK.of_forall_diff_eq_zero hD hv
    rw [← integral_diff hDA hID hDAD]
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hD.diff hDA)
      Set.inter_subset_left ?_
    intro x hx
    exact hv x ⟨hx.1.1, fun hk => hx.2 ⟨hx.1, hk⟩⟩
  have eB := hred fB hfB (fun y hy => (hvan y hy).1)
  have eC := hred fC hfC (fun y hy => (hvan y hy).2)
  set S := (D \ DA) ∩ Kc with hSdef
  have hS : MeasurableSet S := (hD.diff hDA).inter hKc.measurableSet
  have hSK : S ⊆ Kc := Set.inter_subset_right
  have hSfin : volume S < ⊤ := lt_of_le_of_lt (measure_mono hSK) hKc.measure_lt_top
  have hSle : (volume S).toReal ≤ (volume Kc).toReal :=
    ENNReal.toReal_mono hKc.measure_lt_top.ne (measure_mono hSK)
  have hconst : ∀ c : ℝ, IntegrableOn (fun _ : E3 => c) S volume :=
    fun c => integrableOn_const hSfin.ne
  have hreal : ∀ (A : Set E3) (c : ℝ), ∫ _ in A, c = (volume A).toReal * c := by
    intro A c
    rw [setIntegral_const, smul_eq_mul, Measure.real]
  
  set T := Kc ∩ nw ⁻¹' Set.Ici η₀ with hTdef
  have hTm : MeasurableSet T :=
    (hnw.preimage_isClosed_of_isClosed hKc.isClosed isClosed_Ici).measurableSet
  set Bd := Kc \ (Kc ∩ b ⁻¹' (Set.Ioo 0 s)ᶜ) with hBddef
  have hBdm : MeasurableSet Bd :=
    hKc.measurableSet.diff
      (hb.preimage_isClosed_of_isClosed hKc.isClosed isOpen_Ioo.isClosed_compl).measurableSet
  have hBdmem : ∀ y ∈ Kc, (y ∈ Bd ↔ (0 < b y ∧ b y < s)) := by
    intro y hy
    constructor
    · rintro ⟨_, h⟩
      by_contra hc
      exact h ⟨hy, hc⟩
    · intro h
      exact ⟨hy, fun h' => h'.2 h⟩
  have hIfB : IntegrableOn fB S volume := (hfB.integrableOn_compact hKc).mono_set hSK
  have hIfC : IntegrableOn fC S volume := (hfC.integrableOn_compact hKc).mono_set hSK
  
  have hk : 0 ≤ W * C₀ := mul_nonneg hW hC₀
  have hBulk : -(W * (C₀ * (η₀ * (volume Kc).toReal + Nm * a₁))) ≤ ∫ y in S, fB y := by
    have hmono : ∫ y in S, ((-(W * C₀ * η₀)) + T.indicator (fun _ => -(W * C₀ * Nm)) y) ≤
        ∫ y in S, fB y := by
      refine setIntegral_mono_on ((hconst _).add ((hconst _).indicator hTm)) hIfB hS ?_
      intro y hy
      have hyK := hSK hy
      have h0 := hptB y hyK
      have hnmy := hnm y hyK
      by_cases hyT : y ∈ T
      · rw [Set.indicator_of_mem hyT]
        have : W * C₀ * nw y ≤ W * C₀ * Nm := mul_le_mul_of_nonneg_left hnmy hk
        have : 0 ≤ W * C₀ * η₀ := mul_nonneg hk hη₀
        have e : W * (C₀ * nw y) = W * C₀ * nw y := by ring
        linarith
      · rw [Set.indicator_of_notMem hyT]
        have hlt : nw y < η₀ := by
          by_contra hc
          exact hyT ⟨hyK, le_of_not_gt hc⟩
        have : W * C₀ * nw y ≤ W * C₀ * η₀ := mul_le_mul_of_nonneg_left hlt.le hk
        have e : W * (C₀ * nw y) = W * C₀ * nw y := by ring
        linarith
    rw [integral_add (hconst _) ((hconst _).indicator hTm), setIntegral_indicator hTm,
      hreal, hreal] at hmono
    have hST : (volume (S ∩ T)).toReal ≤ a₁ := by
      refine ENNReal.toReal_le_of_le_ofReal ha₁ (le_trans (measure_mono ?_) h1)
      rintro y ⟨hyS, hyT⟩
      exact ⟨hyS, hyT.2⟩
    have i1 := mul_le_mul_of_nonneg_left hSle (mul_nonneg hk hη₀)
    have i2 := mul_le_mul_of_nonneg_left hST (mul_nonneg hk hNm)
    have e : W * (C₀ * (η₀ * (volume Kc).toReal + Nm * a₁)) =
        W * C₀ * η₀ * (volume Kc).toReal + W * C₀ * Nm * a₁ := by ring
    have e2 : (volume S).toReal * -(W * C₀ * η₀) + (volume (S ∩ T)).toReal * -(W * C₀ * Nm) =
        -(W * C₀ * η₀ * (volume S).toReal) - W * C₀ * Nm * (volume (S ∩ T)).toReal := by ring
    linarith
  
  set K := W * s⁻¹ * Mη with hKdef
  have hK : 0 ≤ K := mul_nonneg (mul_nonneg hW (inv_nonneg.2 hs.le)) hMη
  have hKC1 : 0 ≤ K * C₁ := mul_nonneg hK hC₁
  have hKs : K * s = W * Mη := by
    calc K * s = W * Mη * (s⁻¹ * s) := by rw [hKdef]; ring
      _ = W * Mη := by rw [inv_mul_cancel₀ hs.ne', mul_one]
  have hCol : -(W * (Mη * C₁ * (η₀ * Cb + Nm * a₂) + Mη * τ * Cb)) ≤ ∫ y in S, fC y := by
    have hmono : ∫ y in S, (Bd.indicator (fun _ => -(K * (C₁ * η₀ + τ))) y +
        (T ∩ Bd).indicator (fun _ => -(K * C₁ * Nm)) y) ≤ ∫ y in S, fC y := by
      refine setIntegral_mono_on (((hconst _).indicator hBdm).add
        ((hconst _).indicator (hTm.inter hBdm))) hIfC hS ?_
      intro y hy
      have hyK := hSK hy
      have h0 := hptC y hyK
      have hnmy := hnm y hyK
      by_cases hband : 0 < b y ∧ b y < s
      · have hyB : y ∈ Bd := (hBdmem y hyK).2 hband
        rw [Set.indicator_of_mem (show y ∈ {z | 0 < b z ∧ b z < s} from hband)] at h0
        rw [Set.indicator_of_mem hyB]
        have e : W * (s⁻¹ * Mη * 1 * (C₁ * nw y + τ)) = K * C₁ * nw y + K * τ := by
          rw [hKdef]; ring
        by_cases hyT : y ∈ T
        · rw [Set.indicator_of_mem (show y ∈ T ∩ Bd from ⟨hyT, hyB⟩)]
          have : K * C₁ * nw y ≤ K * C₁ * Nm := mul_le_mul_of_nonneg_left hnmy hKC1
          have : 0 ≤ K * C₁ * η₀ := mul_nonneg hKC1 hη₀
          have e2 : K * (C₁ * η₀ + τ) = K * C₁ * η₀ + K * τ := by ring
          linarith
        · rw [Set.indicator_of_notMem (show y ∉ T ∩ Bd from fun h => hyT h.1)]
          have hlt : nw y < η₀ := by
            by_contra hc
            exact hyT ⟨hyK, le_of_not_gt hc⟩
          have : K * C₁ * nw y ≤ K * C₁ * η₀ := mul_le_mul_of_nonneg_left hlt.le hKC1
          have e2 : K * (C₁ * η₀ + τ) = K * C₁ * η₀ + K * τ := by ring
          linarith
      · have hyB : y ∉ Bd := fun h => hband ((hBdmem y hyK).1 h)
        rw [Set.indicator_of_notMem (show y ∉ {z | 0 < b z ∧ b z < s} from hband)] at h0
        rw [Set.indicator_of_notMem hyB,
          Set.indicator_of_notMem (show y ∉ T ∩ Bd from fun h => hyB h.2)]
        have e : W * (s⁻¹ * Mη * 0 * (C₁ * nw y + τ)) = 0 := by ring
        linarith
    rw [integral_add ((hconst _).indicator hBdm) ((hconst _).indicator (hTm.inter hBdm)),
      setIntegral_indicator hBdm, setIntegral_indicator (hTm.inter hBdm),
      hreal, hreal] at hmono
    have hv1 : (volume (S ∩ Bd)).toReal ≤ Cb * s := by
      refine ENNReal.toReal_le_of_le_ofReal (mul_nonneg hCb hs.le)
        (le_trans (measure_mono ?_) h3)
      rintro y ⟨hyS, hyB⟩
      exact ⟨hSK hyS, (hBdmem y (hSK hyS)).1 hyB⟩
    have hv2 : (volume (S ∩ (T ∩ Bd))).toReal ≤ s * a₂ := by
      refine ENNReal.toReal_le_of_le_ofReal (mul_nonneg hs.le ha₂)
        (le_trans (measure_mono ?_) h2)
      rintro y ⟨hyS, hyT, hyB⟩
      exact ⟨⟨hyS, hyT.2⟩, (hBdmem y (hSK hyS)).1 hyB⟩
    have hP : 0 ≤ K * (C₁ * η₀ + τ) :=
      mul_nonneg hK (add_nonneg (mul_nonneg hC₁ hη₀) hτ)
    have hQ : 0 ≤ K * C₁ * Nm := mul_nonneg hKC1 hNm
    have i1 := mul_le_mul_of_nonneg_left hv1 hP
    have i2 := mul_le_mul_of_nonneg_left hv2 hQ
    have e1 : K * (C₁ * η₀ + τ) * (Cb * s) = W * Mη * (C₁ * η₀ + τ) * Cb := by
      rw [show K * (C₁ * η₀ + τ) * (Cb * s) = (K * s) * (C₁ * η₀ + τ) * Cb by ring, hKs]
    have e2 : K * C₁ * Nm * (s * a₂) = W * Mη * C₁ * Nm * a₂ := by
      rw [show K * C₁ * Nm * (s * a₂) = (K * s) * C₁ * Nm * a₂ by ring, hKs]
    have e3 : W * (Mη * C₁ * (η₀ * Cb + Nm * a₂) + Mη * τ * Cb) =
        W * Mη * (C₁ * η₀ + τ) * Cb + W * Mη * C₁ * Nm * a₂ := by ring
    have e4 : (volume (S ∩ Bd)).toReal * -(K * (C₁ * η₀ + τ)) +
        (volume (S ∩ (T ∩ Bd))).toReal * -(K * C₁ * Nm) =
        -(K * (C₁ * η₀ + τ) * (volume (S ∩ Bd)).toReal) -
          K * C₁ * Nm * (volume (S ∩ (T ∩ Bd))).toReal := by ring
    linarith
  have e : -(W * (C₀ * (η₀ * (volume Kc).toReal + Nm * a₁) + Mη * C₁ * (η₀ * Cb + Nm * a₂) +
        Mη * τ * Cb)) = -(W * (C₀ * (η₀ * (volume Kc).toReal + Nm * a₁))) +
        -(W * (Mη * C₁ * (η₀ * Cb + Nm * a₂) + Mη * τ * Cb)) := by ring
  linarith

theorem stern_bad_set_estimate [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L → ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ),
      sternAdmissible (sternDomain (hAF.ends k) β Y L) q φ →
      ∀ θ : ℝ, 0 < θ → ∀ δ : ℝ, 0 < δ →
      ∃ U : Set ℝ, IsOpen U ∧ volume U < ENNReal.ofReal δ ∧ -L ∈ U ∧ L ∈ U ∧
        (∀ p ∈ sternDomain (hAF.ends k) β Y L, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p = 0 → u p ∈ U) ∧
        ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∃ s₁ : ℝ, 0 < s₁ ∧ ∀ s : ℝ, 0 < s → s < s₁ →
          sternBulk g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' (Set.Icc (-L) L \ U)) ε s +
            sternCollar g β u q φ
              (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' (Set.Icc (-L) L \ U)) ε s - θ ≤
          sternBulk g β u q φ (sternDomain (hAF.ends k) β Y L) ε s +
            sternCollar g β u q φ (sternDomain (hAF.ends k) β Y L) ε s :=
by
  classical
  obtain ⟨hΨ, hdomL⟩ := hdom
  have hβs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β := hβ.1
  have hβc : Continuous β := hβs.continuous
  have huc : Continuous u := hu.continuous
  have hR1 : 0 ≤ R₁ := by
    have h1 := hXY.1
    have h2 := hXY.2.1
    linarith
  have hnsq : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  obtain ⟨M₀, hM₀⟩ := (hdomL (R₁ + 2) (by linarith)).1.exists_bound_of_continuousOn
    huc.continuousOn
  
  have hd0 : ∀ x : ℝ, x ≤ 0 → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMin.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.zero_of_nonpos hx]
    exact Real.smoothTransition.nonneg y
  have hd1 : ∀ x : ℝ, 1 ≤ x → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMax.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.one_of_one_le hx]
    exact Real.smoothTransition.le_one y
  have hdnn : ∀ x : ℝ, 0 ≤ deriv Real.smoothTransition x := fun x =>
    Real.smoothTransition.monotone.deriv_nonneg
  have hdc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by norm_num)
  obtain ⟨Mη, hMη⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hdc.continuousOn
  have hdle : ∀ x : ℝ, deriv Real.smoothTransition x ≤ Mη := by
    intro x
    by_cases h0 : x ≤ 0
    · rw [hd0 x h0]; exact le_trans (norm_nonneg _) (hMη 0 ⟨le_rfl, zero_le_one⟩)
    by_cases h1 : 1 ≤ x
    · rw [hd1 x h1]; exact le_trans (norm_nonneg _) (hMη 0 ⟨le_rfl, zero_le_one⟩)
    push_neg at h0 h1
    have := hMη x ⟨h0.le, h1.le⟩
    rw [Real.norm_eq_abs] at this
    exact le_trans (le_abs_self _) this
  have hMη0 : 0 ≤ Mη := le_trans (hdnn 0) (hdle 0)
  
  have hH : ∀ a d Wb Z X : ℝ, 0 ≤ a → 0 ≤ d → a * d ≤ Wb → 0 ≤ Z → -Z ≤ X →
      -(Wb * Z) ≤ a * X * d := by
    intro a d Wb Z X ha hd hW hZ hX
    nlinarith [mul_nonneg (mul_nonneg ha hd) (by linarith : (0 : ℝ) ≤ X + Z),
      mul_nonneg (sub_nonneg.2 hW) hZ]
  have hH2 : ∀ a Wb Z X : ℝ, 0 ≤ a → a ≤ Wb → 0 ≤ Z → -Z ≤ X → -(Wb * Z) ≤ a * X := by
    intro a Wb Z X ha hW hZ hX
    nlinarith [mul_nonneg ha (by linarith : (0 : ℝ) ≤ X + Z), mul_nonneg (sub_nonneg.2 hW) hZ]
  have hsmall : ∀ S : ℝ, 0 ≤ S → ∀ θ' : ℝ, 0 < θ' → ∃ x : ℝ, 0 < x ∧ x * S ≤ θ' := by
    intro S hS θ' hθ'
    refine ⟨θ' / (S + 1), div_pos hθ' (by linarith), ?_⟩
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith
  refine ⟨max (R₁ + 2) (|M₀| + 1), ?_⟩
  intro L hL n q φ hadm θ hθ δ hδ
  have hLR2 : R₁ + 2 ≤ L := le_trans (le_max_left _ _) hL
  have hLM : |M₀| + 1 ≤ L := le_trans (le_max_right _ _) hL
  have hLR : R₁ < L := by linarith
  set Ω := sternDomain (hAF.ends k) β Y L with hΩdef
  have hΩc : IsCompact Ω := (hdomL L hLR).1
  
  have huL : ∀ p ∈ Ω, u p ∈ Set.Icc (-L) L := by
    intro p hp
    by_cases hout : p ∈ sternOuter (hAF.ends k) Y (R₁ + 2)
    · unfold sternOuter at hout
      obtain ⟨x, hx, rfl⟩ := hout
      simp only [Set.mem_setOf_eq] at hx
      have hxn : R₁ < ‖x‖ := by
        by_contra hcon
        push_neg at hcon
        have h1 : ‖x‖ ^ 2 ≤ R₁ ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hcon 2
        have h2 := hnsq x
        have h3 : x 0 ^ 2 ≤ (R₁ + 2) ^ 2 := by nlinarith [sq_nonneg (x 1), sq_nonneg (x 2)]
        have h4 : |x 0| ≤ |R₁ + 2| := sq_le_sq.mp h3
        rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ R₁ + 2)] at h4
        exact hx ⟨h4, by nlinarith [sq_nonneg (x 0)]⟩
      have hin : |x 0| ≤ L ∧ x 1 ^ 2 + x 2 ^ 2 ≤ L ^ 2 := by
        by_contra hcon
        exact hp.2 (Set.mem_image_of_mem _ hcon)
      rw [(hΨ x hxn).1, Set.mem_Icc]
      exact abs_le.mp hin.1
    · have hp' : p ∈ sternDomain (hAF.ends k) β Y (R₁ + 2) := ⟨hp.1, hout⟩
      have h1 := hM₀ p hp'
      rw [Real.norm_eq_abs] at h1
      have h2 := abs_le.mp (le_trans h1 (le_abs_self M₀))
      rw [Set.mem_Icc]
      constructor <;> linarith [h2.1, h2.2]
  obtain ⟨Ω', O, hpart, -, -, -⟩ := hadm
  obtain ⟨hφs, hφ0, -, hφsupp⟩ := hpart
  
  have hchart : ∀ j : Fin n, ∃ A E : ℝ, 0 ≤ A ∧ 0 ≤ E ∧ ∀ η₀ : ℝ, 0 < η₀ → ∃ Dc : ℝ, 0 ≤ Dc ∧
      ∀ U : Set ℝ, IsOpen U → ∀ r : ℝ, 0 ≤ r → volume U ≤ ENNReal.ofReal r →
      ∀ ε : ℝ, 0 < ε → ∀ τ : ℝ, 0 < τ → ∃ s₃ : ℝ, 0 < s₃ ∧ ∀ s : ℝ, 0 < s → s < s₃ →
        -(η₀ * A + r * Dc + τ * E) ≤
          ((∫ y in chartAt E3 (q j) '' (Ω ∩ (chartAt E3 (q j)).source),
              φ j ((chartAt E3 (q j)).symm y) *
                (Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
                  g.lapM (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
                Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) +
            (∫ y in chartAt E3 (q j) '' (Ω ∩ (chartAt E3 (q j)).source),
              φ j ((chartAt E3 (q j)).symm y) *
                (s⁻¹ * deriv Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
                  g.gradInner β (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
                Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)) -
          ((∫ y in chartAt E3 (q j) '' (Ω ∩ u ⁻¹' (Set.Icc (-L) L \ U) ∩
                (chartAt E3 (q j)).source),
              φ j ((chartAt E3 (q j)).symm y) *
                (Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
                  g.lapM (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
                Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) +
            (∫ y in chartAt E3 (q j) '' (Ω ∩ u ⁻¹' (Set.Icc (-L) L \ U) ∩
                (chartAt E3 (q j)).source),
              φ j ((chartAt E3 (q j)).symm y) *
                (s⁻¹ * deriv Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
                  g.gradInner β (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
                Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)) := by
    intro j
    set c := chartAt E3 (q j) with hc
    have hsupp := hφsupp j
    set Kc := c '' (Ω ∩ tsupport (φ j)) with hKcdef
    set D := c '' (Ω ∩ c.source) with hDdef
    have hKcc : IsCompact Kc := (hΩc.inter_right (isClosed_tsupport _)).image_of_continuousOn
      (c.continuousOn.mono (fun x hx => (hsupp.2 hx.2).2))
    have hKD : Kc ⊆ D := Set.image_mono (fun x hx => ⟨hx.1, (hsupp.2 hx.2).2⟩)
    have hKT : Kc ⊆ c.target := by
      rintro _ ⟨x, hx, rfl⟩
      exact c.map_source (hsupp.2 hx.2).2
    have hKS : ∀ y ∈ Kc, c.symm y ∈ Ω := by
      rintro _ ⟨x, hx, rfl⟩
      rw [c.left_inv (hsupp.2 hx.2).2]
      exact hx.1
    have hmeas : ∀ S : Set M, IsClosed S → MeasurableSet (c '' (S ∩ c.source)) := by
      intro S hS
      have h1 : c '' (S ∩ c.source) = c.target \ (c.target ∩ c.symm ⁻¹' Sᶜ) := by
        rw [c.image_eq_target_inter_inv_preimage Set.inter_subset_right]
        ext y
        constructor
        · rintro ⟨hy, hyS, -⟩
          exact ⟨hy, fun h => h.2 hyS⟩
        · rintro ⟨hy, hn⟩
          exact ⟨hy, not_not.mp (fun h => hn ⟨hy, h⟩), c.map_target hy⟩
      rw [h1]
      exact c.open_target.measurableSet.diff
        (c.isOpen_inter_preimage_symm hS.isOpen_compl).measurableSet
    have hDm : MeasurableSet D := hmeas Ω hΩc.isClosed
    have hvan0 : ∀ y ∈ D \ Kc, φ j (c.symm y) = 0 := by
      rintro _ ⟨⟨x, hx, rfl⟩, hy⟩
      rw [c.left_inv hx.2]
      exact image_eq_zero_of_notMem_tsupport (fun h => hy ⟨x, ⟨hx.1, h⟩, rfl⟩)
    have hG : ContinuousOn (g.coeff c.symm) c.target :=
      continuousOn_pi.2 fun i => continuousOn_pi.2 fun j' => (g.smooth (q j) i j').continuousOn
    have hsd : ContinuousOn (fun y => Real.sqrt (g.coeff c.symm y).det) c.target :=
      Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hG)
    have hψc : ContinuousOn (fun y => φ j (c.symm y)) c.target :=
      (hφs j).continuous.comp_continuousOn c.continuousOn_symm
    have hbc : ContinuousOn (fun y => β (c.symm y)) c.target :=
      hβc.comp_continuousOn c.continuousOn_symm
    have hQ : ContinuousOn (fun y => g.gradInner u u (c.symm y)) c.target :=
      (stern_gradInner_chart g u u Set.univ isOpen_univ hu hu.contMDiffOn (q j)).mono
        (fun y hy => ⟨hy, Set.mem_univ _⟩)
    have hnwc : ContinuousOn (fun y => Real.sqrt (g.gradInner u u (c.symm y))) Kc :=
      Real.continuous_sqrt.comp_continuousOn (hQ.mono hKT)
    have hwc : ContinuousOn (fun y => φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det) Kc :=
      (hψc.mono hKT).mul (hsd.mono hKT)
    obtain ⟨Nm₀, hNm₀⟩ := hKcc.exists_bound_of_continuousOn hnwc
    obtain ⟨W₀, hW₀⟩ := hKcc.exists_bound_of_continuousOn hwc
    have hNm : 0 ≤ max Nm₀ 0 := le_max_right _ _
    have hW : 0 ≤ max W₀ 0 := le_max_right _ _
    have hnm : ∀ y ∈ Kc, Real.sqrt (g.gradInner u u (c.symm y)) ≤ max Nm₀ 0 := by
      intro y hy
      have h1 := hNm₀ y hy
      rw [Real.norm_eq_abs] at h1
      exact le_trans (le_abs_self _) (le_trans h1 (le_max_left _ _))
    have hWb : ∀ y ∈ Kc, φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det ≤ max W₀ 0 := by
      intro y hy
      have h1 := hW₀ y hy
      rw [Real.norm_eq_abs] at h1
      exact le_trans (le_abs_self _) (le_trans h1 (le_max_left _ _))
    obtain ⟨C₀, hC₀, hbulk⟩ := stern_bad_bulk_pointwise g β u hβc hu hharm (q j) Kc hKcc hKT
    obtain ⟨C₁, hC₁, hcol⟩ :=
      stern_bad_collar_pointwise g β u hβs hβ.2.1 hu hneu (q j) Kc hKcc hKT
    obtain ⟨Cb₀, sb, hsb, hband⟩ := stern_thin_band_volume β hβs hβ.2.1 (q j) Kc hKcc hKT
    have hCb : 0 ≤ max Cb₀ 0 := le_max_right _ _
    have hV : 0 ≤ (volume Kc).toReal := ENNReal.toReal_nonneg
    have hf : ContDiffOn ℝ ∞ (fun z => u (c.symm z)) c.target :=
      contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn (contMDiffOn_chart_symm (x := q j)))
    have hb : ContDiffOn ℝ ∞ (fun z => β (c.symm z)) c.target :=
      contMDiffOn_iff_contDiffOn.mp (hβs.comp_contMDiffOn (contMDiffOn_chart_symm (x := q j)))
    refine ⟨max W₀ 0 * (C₀ * (volume Kc).toReal + Mη * C₁ * max Cb₀ 0),
      max W₀ 0 * (Mη * max Cb₀ 0),
      mul_nonneg hW (add_nonneg (mul_nonneg hC₀ hV) (mul_nonneg (mul_nonneg hMη0 hC₁) hCb)),
      mul_nonneg hW (mul_nonneg hMη0 hCb), fun η₀ hη₀ => ?_⟩
    obtain ⟨Ca, hCa, hsub⟩ := stern_submersion_preimage_volume Kc c.target hKcc c.open_target hKT
      (fun z => u (c.symm z)) hf (fun y => Real.sqrt (g.gradInner u u (c.symm y))) hnwc
      (fun y hy hn => (stern_bad_chart_indep g β u hβs hβ.2.1 hu hneu (q j) y (hKT hy)
        (Real.sqrt_pos.mp hn)).1) η₀ hη₀
    obtain ⟨Cs, s₆, hCs, hs₆, hslab⟩ := stern_slab_preimage_volume Kc c.target hKcc
      c.open_target hKT (fun z => u (c.symm z)) (fun z => β (c.symm z)) hf hb
      (fun y => Real.sqrt (g.gradInner u u (c.symm y))) hnwc
      (fun y hy hb0 hn => (stern_bad_chart_indep g β u hβs hβ.2.1 hu hneu (q j) y (hKT hy)
        (Real.sqrt_pos.mp hn)).2 hb0) η₀ hη₀
    refine ⟨max W₀ 0 * (C₀ * max Nm₀ 0 * Ca + Mη * C₁ * max Nm₀ 0 * Cs),
      mul_nonneg hW (add_nonneg (mul_nonneg (mul_nonneg hC₀ hNm) hCa)
        (mul_nonneg (mul_nonneg (mul_nonneg hMη0 hC₁) hNm) hCs)),
      fun U hUo r hr hUr ε hε τ hτ => ?_⟩
    obtain ⟨s₇, hs₇, hcol'⟩ := hcol ε hε τ hτ
    refine ⟨min (min s₇ sb) s₆, lt_min (lt_min hs₇ hsb) hs₆, fun s hs hss => ?_⟩
    have hs7 : s < s₇ := lt_of_lt_of_le hss (le_trans (min_le_left _ _) (min_le_left _ _))
    have hsb' : s < sb := lt_of_lt_of_le hss (le_trans (min_le_left _ _) (min_le_right _ _))
    have hs6 : s < s₆ := lt_of_lt_of_le hss (min_le_right _ _)
    set A := Ω ∩ u ⁻¹' (Set.Icc (-L) L \ U) with hAdef
    have hAc : IsClosed A := hΩc.isClosed.inter ((isClosed_Icc.sdiff hUo).preimage huc)
    set DA := c '' (A ∩ c.source) with hDAdef
    have hDAm : MeasurableSet DA := hmeas A hAc
    have hDAD : DA ⊆ D := Set.image_mono (fun x hx => ⟨hx.1.1, hx.2⟩)
    have hUin : ∀ y ∈ (D \ DA) ∩ Kc, u (c.symm y) ∈ U := by
      rintro y ⟨⟨-, hyDA⟩, hy⟩
      by_contra hU
      apply hyDA
      exact ⟨c.symm y, ⟨⟨hKS y hy, huL _ (hKS y hy), hU⟩, c.map_target (hKT hy)⟩,
        c.right_inv (hKT hy)⟩
    obtain ⟨hφεs, hlapc, -, -⟩ := stern_phi_chart_reps g u hu ε hε (q j)
    have hgφ : ContinuousOn (fun y => g.gradInner β (sternPhiM g u ε) (c.symm y)) Kc :=
      (stern_gradInner_chart g β (sternPhiM g u ε) Set.univ isOpen_univ hβs hφεs.contMDiffOn
        (q j)).mono (fun y hy => ⟨hKT hy, Set.mem_univ _⟩)
    have hηc : ContinuousOn (fun y => Real.smoothTransition (β (c.symm y) / s)) Kc :=
      Real.smoothTransition.continuous.comp_continuousOn ((hbc.mono hKT).div_const s)
    have hη'c : ContinuousOn (fun y => deriv Real.smoothTransition (β (c.symm y) / s)) Kc :=
      hdc.comp_continuousOn ((hbc.mono hKT).div_const s)
    have hfBc : ContinuousOn (fun y => φ j (c.symm y) *
        (Real.smoothTransition (β (c.symm y) / s) * g.lapM (sternPhiM g u ε) (c.symm y)) *
        Real.sqrt (g.coeff c.symm y).det) Kc :=
      ((hψc.mono hKT).mul (hηc.mul (hlapc.mono hKT))).mul (hsd.mono hKT)
    have hfCc : ContinuousOn (fun y => φ j (c.symm y) *
        (s⁻¹ * deriv Real.smoothTransition (β (c.symm y) / s) *
          g.gradInner β (sternPhiM g u ε) (c.symm y)) *
        Real.sqrt (g.coeff c.symm y).det) Kc :=
      ((hψc.mono hKT).mul ((continuousOn_const.mul hη'c).mul hgφ)).mul (hsd.mono hKT)
    have hvan : ∀ y ∈ D \ Kc, φ j (c.symm y) *
          (Real.smoothTransition (β (c.symm y) / s) * g.lapM (sternPhiM g u ε) (c.symm y)) *
          Real.sqrt (g.coeff c.symm y).det = 0 ∧
        φ j (c.symm y) * (s⁻¹ * deriv Real.smoothTransition (β (c.symm y) / s) *
          g.gradInner β (sternPhiM g u ε) (c.symm y)) * Real.sqrt (g.coeff c.symm y).det = 0 := by
      intro y hy
      rw [hvan0 y hy]
      simp
    have hptB : ∀ y ∈ Kc, -(max W₀ 0 * (C₀ * Real.sqrt (g.gradInner u u (c.symm y)))) ≤
        φ j (c.symm y) *
          (Real.smoothTransition (β (c.symm y) / s) * g.lapM (sternPhiM g u ε) (c.symm y)) *
          Real.sqrt (g.coeff c.symm y).det := by
      intro y hy
      have hn := Real.sqrt_nonneg (g.gradInner u u (c.symm y))
      have hη0 := Real.smoothTransition.nonneg (β (c.symm y) / s)
      have hη1 := Real.smoothTransition.le_one (β (c.symm y) / s)
      refine hH _ _ _ _ _ (hφ0 j _) (Real.sqrt_nonneg _) (hWb y hy) (mul_nonneg hC₀ hn) ?_
      by_cases hβp : 0 < β (c.symm y)
      · have h := hbulk y hy hβp ε hε
        nlinarith [mul_nonneg hη0 (by linarith : (0 : ℝ) ≤
            g.lapM (sternPhiM g u ε) (c.symm y) + C₀ * Real.sqrt (g.gradInner u u (c.symm y))),
          mul_nonneg (sub_nonneg.2 hη1) (mul_nonneg hC₀ hn)]
      · rw [Real.smoothTransition.zero_of_nonpos
          (div_nonpos_iff.mpr (Or.inr ⟨not_lt.mp hβp, hs.le⟩)), zero_mul]
        linarith [mul_nonneg hC₀ hn]
    have hptC : ∀ y ∈ Kc, -(max W₀ 0 * (s⁻¹ * Mη *
        Set.indicator {z | 0 < β (c.symm z) ∧ β (c.symm z) < s} (fun _ => (1 : ℝ)) y *
        (C₁ * Real.sqrt (g.gradInner u u (c.symm y)) + τ))) ≤
        φ j (c.symm y) * (s⁻¹ * deriv Real.smoothTransition (β (c.symm y) / s) *
          g.gradInner β (sternPhiM g u ε) (c.symm y)) * Real.sqrt (g.coeff c.symm y).det := by
      intro y hy
      have hn := Real.sqrt_nonneg (g.gradInner u u (c.symm y))
      have hZ : 0 ≤ C₁ * Real.sqrt (g.gradInner u u (c.symm y)) + τ :=
        add_nonneg (mul_nonneg hC₁ hn) hτ.le
      have hsi : 0 ≤ s⁻¹ := inv_nonneg.2 hs.le
      by_cases hbnd : 0 < β (c.symm y) ∧ β (c.symm y) < s
      · have hind : Set.indicator {z | 0 < β (c.symm z) ∧ β (c.symm z) < s}
            (fun _ => (1 : ℝ)) y = 1 := by
          simp [Set.indicator, hbnd]
        rw [hind]
        have hgI := hcol' y hy hbnd.1 (lt_trans hbnd.2 hs7)
        have hY := hH2 _ _ _ _ (hdnn (β (c.symm y) / s)) (hdle (β (c.symm y) / s)) hZ hgI
        have hX := mul_le_mul_of_nonneg_left hY hsi
        refine hH _ _ _ _ _ (hφ0 j _) (Real.sqrt_nonneg _) (hWb y hy)
          (mul_nonneg (mul_nonneg (mul_nonneg hsi hMη0) zero_le_one) hZ) ?_
        linarith [hX]
      · have hind : Set.indicator {z | 0 < β (c.symm z) ∧ β (c.symm z) < s}
            (fun _ => (1 : ℝ)) y = 0 := by
          simp [Set.indicator, hbnd]
        have hz : deriv Real.smoothTransition (β (c.symm y) / s) = 0 := by
          by_cases hb0 : β (c.symm y) ≤ 0
          · exact hd0 _ (div_nonpos_iff.mpr (Or.inr ⟨hb0, hs.le⟩))
          · have hbs : s ≤ β (c.symm y) := by
              by_contra hcon
              exact hbnd ⟨lt_of_not_ge hb0, lt_of_not_ge hcon⟩
            exact hd1 _ ((le_div_iff₀ hs).2 (by linarith))
        rw [hind, hz]
        simp
    have h1 : volume ((D \ DA) ∩ Kc ∩ {y | η₀ ≤ Real.sqrt (g.gradInner u u (c.symm y))}) ≤
        ENNReal.ofReal (Ca * r) := by
      refine le_trans (measure_mono ?_) (hsub U hUo.measurableSet r hr hUr)
      rintro y ⟨hy, hyn⟩
      exact ⟨⟨hy.2, hUin y hy⟩, hyn⟩
    have h2 : volume ((D \ DA) ∩ Kc ∩ {y | η₀ ≤ Real.sqrt (g.gradInner u u (c.symm y))} ∩
        {y | 0 < β (c.symm y) ∧ β (c.symm y) < s}) ≤ ENNReal.ofReal (s * (Cs * r)) := by
      have h := hslab U hUo.measurableSet r hr hUr s hs hs6
      rw [show Cs * s * r = s * (Cs * r) by ring] at h
      refine le_trans (measure_mono ?_) h
      rintro y ⟨⟨hy, hyn⟩, hyb⟩
      exact ⟨⟨⟨hy.2, hUin y hy⟩, hyn⟩, hyb⟩
    have h3 : volume (Kc ∩ {y | 0 < β (c.symm y) ∧ β (c.symm y) < s}) ≤
        ENNReal.ofReal (max Cb₀ 0 * s) :=
      le_trans (hband s hs hsb') (ENNReal.ofReal_le_ofReal
        (mul_le_mul_of_nonneg_right (le_max_left _ _) hs.le))
    have key := stern_bad_chart_bound D DA Kc hDm hDAm hDAD hKcc hKD
      (fun y => φ j (c.symm y) *
        (Real.smoothTransition (β (c.symm y) / s) * g.lapM (sternPhiM g u ε) (c.symm y)) *
        Real.sqrt (g.coeff c.symm y).det)
      (fun y => φ j (c.symm y) * (s⁻¹ * deriv Real.smoothTransition (β (c.symm y) / s) *
          g.gradInner β (sternPhiM g u ε) (c.symm y)) * Real.sqrt (g.coeff c.symm y).det)
      (fun y => Real.sqrt (g.gradInner u u (c.symm y))) (fun y => β (c.symm y))
      hfBc hfCc hnwc (hbc.mono hKT) hvan (max W₀ 0) C₀ C₁ Mη τ (max Cb₀ 0) (max Nm₀ 0)
      (Ca * r) (Cs * r) η₀ s hW hC₀ hC₁ hMη0 hτ.le hCb hNm (mul_nonneg hCa hr)
      (mul_nonneg hCs hr) hη₀.le hs (fun y _ => Real.sqrt_nonneg _) hnm hptB hptC h1 h2 h3
    refine le_trans (le_of_eq ?_) key
    ring
  
  choose A E hA hE hrest using hchart
  have hSA : 0 ≤ ∑ j, A j := Finset.sum_nonneg (fun j _ => hA j)
  have hSE : 0 ≤ ∑ j, E j := Finset.sum_nonneg (fun j _ => hE j)
  obtain ⟨η₀, hη₀, hη₀A⟩ := hsmall _ hSA (θ / 3) (by linarith)
  have hrest' := fun j => hrest j η₀ hη₀
  choose Dc hDc hrest2 using hrest'
  have hSD : 0 ≤ ∑ j, Dc j := Finset.sum_nonneg (fun j _ => hDc j)
  obtain ⟨δ₀, hδ₀, hδ₀D⟩ := hsmall _ hSD (θ / 3) (by linarith)
  have hnull : volume (u '' {p | p ∈ Ω ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p = 0} ∪ {-L, L}) = 0 :=
    measure_union_null (stern_crit_values_null u hu Ω hΩc) ((Set.toFinite _).measure_zero _)
  obtain ⟨U, hCU, hUo, hUlt⟩ := Set.exists_isOpen_lt_of_lt _ _
    (lt_of_eq_of_lt hnull (ENNReal.ofReal_pos.mpr (lt_min hδ hδ₀)))
  have hUδ₀ : volume U ≤ ENNReal.ofReal δ₀ :=
    hUlt.le.trans (ENNReal.ofReal_le_ofReal (min_le_right _ _))
  refine ⟨U, hUo, lt_of_lt_of_le hUlt (ENNReal.ofReal_le_ofReal (min_le_left _ _)),
    hCU (Set.mem_union_right _ (by simp)), hCU (Set.mem_union_right _ (by simp)),
    fun p hp hz => hCU (Set.mem_union_left _ ⟨p, ⟨hp, hz⟩, rfl⟩), fun ε hε _ => ?_⟩
  obtain ⟨τ, hτ, hτE⟩ := hsmall _ hSE (θ / 3) (by linarith)
  have h3 := fun j => hrest2 j U hUo δ₀ hδ₀.le hUδ₀ ε hε τ hτ
  choose s₃ hs₃ hb using h3
  obtain ⟨s₂, hs₂pos, hs₂le⟩ : ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ j, s₂ ≤ s₃ j := by
    refine ⟨(insert 1 (Finset.univ.image s₃)).min' (Finset.insert_nonempty _ _), ?_, fun j => ?_⟩
    · have hm := Finset.min'_mem (insert 1 (Finset.univ.image s₃)) (Finset.insert_nonempty _ _)
      rw [Finset.mem_insert, Finset.mem_image] at hm
      rcases hm with h | ⟨j, -, hj⟩
      · rw [h]; exact one_pos
      · rw [← hj]; exact hs₃ j
    · exact Finset.min'_le _ _
        (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ j)))
  refine ⟨s₂, hs₂pos, fun s hs hss => ?_⟩
  have hsum := Finset.sum_le_sum (s := Finset.univ)
    (fun j _ => hb j s hs (lt_of_lt_of_le hss (hs₂le j)))
  simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_neg_distrib,
    ← Finset.mul_sum] at hsum
  simp only [sternBulk, sternCollar, calVolSum]
  linarith [hsum, hη₀A, hδ₀D, hτE]

theorem stern_gauss_chart [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (q : M) :
    ContinuousOn (fun y => sternGaussM g u ((chartAt E3 q).symm y))
      {y | y ∈ (chartAt E3 q).target ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm y) ≠ 0} :=
by
  classical
  have hsymm : ∀ (z : M) (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun z y i j => g.symm _ _ _
  have htrans : ∀ a b : M, ContDiffOn ℝ ∞ (fun y => chartAt E3 b ((chartAt E3 a).symm y))
      ((chartAt E3 a).target ∩ (chartAt E3 a).symm ⁻¹' (chartAt E3 b).source) := by
    intro a b
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ ((chartAt E3 b) ∘ (chartAt E3 a).symm)
        ((chartAt E3 a).target ∩ (chartAt E3 a).symm ⁻¹' (chartAt E3 b).source) :=
      (contMDiffOn_chart).comp (contMDiffOn_chart_symm.mono Set.inter_subset_left)
        (fun y hy => hy.2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  have hGc : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (W : Set E2), IsOpen W →
      (∀ x ∈ W, h₁ x = h₂ x) → ∀ x ∈ W, gaussCurv2 h₁ x = gaussCurv2 h₂ x := by
    intro h₁ h₂ W hW hhe x hx
    have hpd2 : ∀ z ∈ W, ∀ (F : Matrix (Fin 2) (Fin 2) ℝ → ℝ) (i : Fin 2),
        pd2 i (fun w => F (h₁ w)) z = pd2 i (fun w => F (h₂ w)) z := by
      intro z hz F i
      have hev : (fun w => F (h₁ w)) =ᶠ[𝓝 z] (fun w => F (h₂ w)) :=
        Filter.eventually_of_mem (hW.mem_nhds hz) (fun w hw => by simp only [hhe w hw])
      unfold pd2
      rw [hev.fderiv_eq]
    have hpd3 : ∀ z ∈ W, ∀ a b c : Fin 2,
        pd2 c (fun w => h₁ w a b) z = pd2 c (fun w => h₂ w a b) z :=
      fun z hz a b c => hpd2 z hz (fun A => A a b) c
    have hchr : ∀ z ∈ W, ∀ k i j : Fin 2, christoffel2 h₁ k i j z = christoffel2 h₂ k i j z := by
      intro z hz k i j
      simp only [christoffel2, hhe z hz, hpd3 z hz]
    have hchrd : ∀ (a b c i : Fin 2),
        pd2 i (christoffel2 h₁ a b c) x = pd2 i (christoffel2 h₂ a b c) x := by
      intro a b c i
      have hev : christoffel2 h₁ a b c =ᶠ[𝓝 x] christoffel2 h₂ a b c :=
        Filter.eventually_of_mem (hW.mem_nhds hx) (fun w hw => hchr w hw a b c)
      unfold pd2
      rw [hev.fderiv_eq]
    simp only [gaussCurv2, ricci2, hhe x hx, hchrd, hchr x hx]
  have hReg : IsOpen {x : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0} :=
    isOpen_iff_mem_nhds.mpr (fun x hx => mfderiv_ne_zero_eventually Set.univ u isOpen_univ
      hu.contMDiffOn x trivial hx)
  
  have key : ∀ p : M, p ∈ (chartAt E3 q).source → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 →
      sternGaussM g u p = levelGaussLoc (g.coeff (chartAt E3 q).symm)
        (fun z => u ((chartAt E3 q).symm z)) (chartAt E3 q p) := by
    intro p hp hdp
    have hfq : ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 q).symm z)) (chartAt E3 q).target :=
      contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
    have hfp : ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
      contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
    obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Set E3, Ω = (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹'
        ((chartAt E3 p).source ∩ {x : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0}) := ⟨_, rfl⟩
    have hΩo : IsOpen Ω := by
      rw [hΩdef]
      exact (chartAt E3 q).isOpen_inter_preimage_symm ((chartAt E3 p).open_source.inter hReg)
    have hΩmem : ∀ y ∈ Ω, y ∈ (chartAt E3 q).target ∧
        (chartAt E3 q).symm y ∈ (chartAt E3 p).source ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm y) ≠ 0 := by
      intro y hy
      rw [hΩdef] at hy
      exact ⟨hy.1, hy.2.1, hy.2.2⟩
    have hyq : chartAt E3 q p ∈ Ω := by
      rw [hΩdef]
      refine ⟨(chartAt E3 q).map_source hp, ?_⟩
      show (chartAt E3 q).symm (chartAt E3 q p) ∈
        (chartAt E3 p).source ∩ {x : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0}
      rw [(chartAt E3 q).left_inv hp]
      exact ⟨mem_chart_source E3 p, hdp⟩
    have hpos : 0 < gradSqLoc (g.coeff (chartAt E3 q).symm) (fun z => u ((chartAt E3 q).symm z))
        (chartAt E3 q p) :=
      chart_Nsq_pos g u hu q (chartAt E3 q p) ((chartAt E3 q).map_source hp)
        (by rw [(chartAt E3 q).left_inv hp]; exact hdp)
    have hfd : fderiv ℝ (fun z => u ((chartAt E3 q).symm z)) (chartAt E3 q p) ≠ 0 := by
      intro h0
      unfold gradSqLoc gradInnerLoc partialDeriv at hpos
      rw [h0] at hpos
      simp at hpos
    have hhd : fderiv ℝ (fun y => u ((chartAt E3 q).symm y) - u p) (chartAt E3 q p) ≠ 0 := by
      rw [fderiv_sub_const]; exact hfd
    have hh : ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 q).symm y) - u p) Ω :=
      (hfq.mono (fun y hy => (hΩmem y hy).1)).sub contDiffOn_const
    have hh0 : (fun y => u ((chartAt E3 q).symm y) - u p) (chartAt E3 q p) = 0 := by
      show u ((chartAt E3 q).symm (chartAt E3 q p)) - u p = 0
      rw [(chartAt E3 q).left_inv hp, sub_self]
    obtain ⟨W, F₂, x₀, hWo, hx₀, hF₂s, hF₂x₀, -, hF₂W⟩ :=
      regular_zero_set_local_param Ω hΩo _ hh _ hyq hh0 hhd
    have hW1 : ∀ x ∈ W, F₂ x ∈ (chartAt E3 q).target := fun x hx => (hΩmem _ (hF₂W x hx).1).1
    have hW2 : ∀ x ∈ W, (chartAt E3 q).symm (F₂ x) ∈ (chartAt E3 p).source :=
      fun x hx => (hΩmem _ (hF₂W x hx).1).2.1
    have hW3 : ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm (F₂ x)) ≠ 0 :=
      fun x hx => (hΩmem _ (hF₂W x hx).1).2.2
    have hW4 : ∀ x ∈ W, u ((chartAt E3 q).symm (F₂ x)) = u p := by
      intro x hx
      have h : u ((chartAt E3 q).symm (F₂ x)) - u p = 0 := (hF₂W x hx).2.1
      linarith
    have hF₂d : ∀ x ∈ W, DifferentiableAt ℝ F₂ x := fun x hx =>
      (hF₂s.contDiffAt (hWo.mem_nhds hx)).differentiableAt (by simp)
    have hΩ'o : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source) :=
      (chartAt E3 q).isOpen_inter_preimage_symm (chartAt E3 p).open_source
    have hτd : ∀ y ∈ (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source,
        DifferentiableAt ℝ (fun y => chartAt E3 p ((chartAt E3 q).symm y)) y := fun y hy =>
      ((htrans q p).contDiffAt (hΩ'o.mem_nhds hy)).differentiableAt (by simp)
    have hτinj : ∀ y ∈ (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source,
        Function.Injective (fderiv ℝ (fun y => chartAt E3 p ((chartAt E3 q).symm y)) y) := by
      intro y hy
      have hy2 : (chartAt E3 q).symm y ∈ (chartAt E3 p).source := hy.2
      have hτy : chartAt E3 p ((chartAt E3 q).symm y) ∈
          (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source := by
        refine ⟨(chartAt E3 p).map_source hy2, ?_⟩
        show (chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm y)) ∈ (chartAt E3 q).source
        rw [(chartAt E3 p).left_inv hy2]
        exact (chartAt E3 q).map_target hy.1
      have hτ'd : DifferentiableAt ℝ (fun z => chartAt E3 q ((chartAt E3 p).symm z))
          (chartAt E3 p ((chartAt E3 q).symm y)) :=
        ((htrans p q).contDiffAt (((chartAt E3 p).isOpen_inter_preimage_symm
          (chartAt E3 q).open_source).mem_nhds hτy)).differentiableAt (by simp)
      have hev : (fun z => chartAt E3 q ((chartAt E3 p).symm z)) ∘
          (fun y => chartAt E3 p ((chartAt E3 q).symm y)) =ᶠ[𝓝 y] id := by
        filter_upwards [hΩ'o.mem_nhds hy] with y' hy'
        have hy'2 : (chartAt E3 q).symm y' ∈ (chartAt E3 p).source := hy'.2
        show chartAt E3 q ((chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm y'))) = y'
        rw [(chartAt E3 p).left_inv hy'2, (chartAt E3 q).right_inv hy'.1]
      have hcomp := fderiv_comp y hτ'd (hτd y hy)
      rw [hev.fderiv_eq, fderiv_id] at hcomp
      intro v w hvw
      have h2 := DFunLike.congr_fun hcomp v
      have h3 := DFunLike.congr_fun hcomp w
      simp only [ContinuousLinearMap.id_apply, ContinuousLinearMap.comp_apply] at h2 h3
      rw [h2, h3]
      exact congrArg _ hvw
    have hF₁s : ContDiffOn ℝ ∞ (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) W :=
      (htrans q p).comp hF₂s (fun x hx => ⟨hW1 x hx, hW2 x hx⟩)
    have hF₁d : ∀ x ∈ W,
        DifferentiableAt ℝ (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) x :=
      fun x hx => (hF₁s.contDiffAt (hWo.mem_nhds hx)).differentiableAt (by simp)
    have hF₁inj : ∀ x ∈ W, Function.Injective
        (fderiv ℝ (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) x) := by
      intro x hx
      have hc := fderiv_comp x (hτd (F₂ x) ⟨hW1 x hx, hW2 x hx⟩) (hF₂d x hx)
      intro v w hvw
      have hvw' : (fderiv ℝ ((fun y => chartAt E3 p ((chartAt E3 q).symm y)) ∘ F₂) x) v =
          (fderiv ℝ ((fun y => chartAt E3 p ((chartAt E3 q).symm y)) ∘ F₂) x) w := hvw
      rw [hc] at hvw'
      simp only [ContinuousLinearMap.comp_apply] at hvw'
      exact (hF₂W x hx).2.2 (hτinj (F₂ x) ⟨hW1 x hx, hW2 x hx⟩ hvw')
    have hEq := level_gauss_equation (g.coeff (chartAt E3 q).symm) (chartAt E3 q).target
      (chartAt E3 q).open_target (fun i j => g.smooth q i j) (hsymm q)
      (fun y hy => coeff_chart_symm_posDef g q y hy) _ hfq F₂ W hWo hF₂s hW1
      (fun x hx => (hF₂W x hx).2.2) (u p) hW4
      (fun x hx => chart_Nsq_pos g u hu q (F₂ x) (hW1 x hx) (hW3 x hx)) x₀ hx₀
    have hEp := level_gauss_equation (g.coeff (chartAt E3 p).symm) (chartAt E3 p).target
      (chartAt E3 p).open_target (fun i j => g.smooth p i j) (hsymm p)
      (fun y hy => coeff_chart_symm_posDef g p y hy) _ hfp
      (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) W hWo hF₁s
      (fun x hx => (chartAt E3 p).map_source (hW2 x hx)) hF₁inj (u p)
      (fun x hx => by
        show u ((chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm (F₂ x)))) = u p
        rw [(chartAt E3 p).left_inv (hW2 x hx)]
        exact hW4 x hx)
      (fun x hx => chart_Nsq_pos g u hu p (chartAt E3 p ((chartAt E3 q).symm (F₂ x)))
        ((chartAt E3 p).map_source (hW2 x hx))
        (by rw [(chartAt E3 p).left_inv (hW2 x hx)]; exact hW3 x hx)) x₀ hx₀
    have hmet : ∀ x ∈ W, pullMetric2 (g.coeff (chartAt E3 p).symm)
        (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) x =
        pullMetric2 (g.coeff (chartAt E3 q).symm) F₂ x := by
      intro x hx
      have hc := pullMetric2_reparam_compat g p q
        (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x))) F₂ id x
        (hF₁d x hx) (hF₂d x hx) differentiableAt_id ((chartAt E3 p).map_source (hW2 x hx))
        (hW1 x hx)
        (Filter.eventually_of_mem (hWo.mem_nhds hx)
          (fun x' hx' => (chartAt E3 p).left_inv (hW2 x' hx')))
      ext a b
      rw [hc a b, fderiv_id]
      simp [EuclideanSpace.single_apply]
    have e1 := hGc _ _ W hWo hmet x₀ hx₀
    have hx₀' : (chartAt E3 q).symm (F₂ x₀) = p := by
      rw [hF₂x₀, (chartAt E3 q).left_inv hp]
    have hEp' : gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 p).symm)
        (fun x => chartAt E3 p ((chartAt E3 q).symm (F₂ x)))) x₀ =
        levelGaussLoc (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z))
          (chartAt E3 p ((chartAt E3 q).symm (F₂ x₀))) := hEp
    have hEq' : gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 q).symm) F₂) x₀ =
        levelGaussLoc (g.coeff (chartAt E3 q).symm) (fun z => u ((chartAt E3 q).symm z))
          (F₂ x₀) := hEq
    rw [hx₀'] at hEp'
    rw [hF₂x₀] at hEq'
    unfold sternGaussM
    exact (hEp'.symm.trans e1).trans hEq'
  set c := chartAt E3 q with hc
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff c.symm with hGdef
  set f : E3 → ℝ := fun z => u (c.symm z) with hfdef
  set V : Set E3 := c.target with hVdef
  have hVo : IsOpen V := c.open_target
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V := fun i j => g.smooth q i j
  have hpd : ∀ y ∈ V, (G y).PosDef := fun y hy => coeff_chart_symm_posDef g q y hy
  have hf : ContDiffOn ℝ ∞ f V :=
    contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  obtain ⟨E1, E2, E3', E4, -⟩ := ejp_coord_smooth G f V hVo hGs hpd hf
  
  have hinv : ∀ i j : Fin 3, ContinuousOn (fun y => (G y)⁻¹ i j) V :=
    fun i j => (E2 i j).continuousOn
  have hdf : ∀ i : Fin 3, ContinuousOn (fun y => partialDeriv i f y) V :=
    fun i => (E1 f hf i).continuousOn
  have hch : ∀ k i j : Fin 3, ContinuousOn (fun y => christoffel G k i j y) V :=
    fun k i j => (E3' k i j).continuousOn
  have hdch : ∀ l k i j : Fin 3,
      ContinuousOn (fun y => partialDeriv l (christoffel G k i j) y) V :=
    fun l k i j => (E1 _ (E3' k i j) l).continuousOn
  have hhes : ∀ a b : Fin 3, ContinuousOn (fun y => hessLoc G f a b y) V :=
    fun a b => (E4 a b).continuousOn
  have hric : ∀ j k : Fin 3, ContinuousOn (fun y => ricci G j k y) V := by
    intro j k
    simp only [ricci]
    exact (continuousOn_finset_sum _ fun i _ => (hdch i i j k).sub (hdch j i i k)).add
      (continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun p _ =>
        ((hch i i p).mul (hch p j k)).sub ((hch i j p).mul (hch p i k)))
  have hR : ContinuousOn (fun y => scalarCurvatureLocal G y) V := by
    simp only [scalarCurvatureLocal]
    exact continuousOn_finset_sum _ fun j _ => continuousOn_finset_sum _ fun k _ =>
      (hinv j k).mul (hric j k)
  have hgu : ∀ i : Fin 3, ContinuousOn (fun y => gradUpLoc G f y i) V := by
    intro i
    simp only [gradUpLoc]
    exact continuousOn_finset_sum _ fun a _ => (hinv i a).mul (hdf a)
  have hN : ContinuousOn (fun y => gradSqLoc G f y) V := by
    simp only [gradSqLoc, gradInnerLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      ((hinv i j).mul (hdf i)).mul (hdf j)
  have hrg : ContinuousOn (fun y => ricGradLoc G f y) V := by
    simp only [ricGradLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      ((hgu i).mul (hgu j)).mul (hric i j)
  have hlap : ContinuousOn (fun y => lapLoc G f y) V := by
    simp only [lapLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      (hinv i j).mul (hhes i j)
  have hgg : ContinuousOn (fun y => hessGGLoc G f f y) V := by
    simp only [hessGGLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      ((hgu i).mul (hgu j)).mul (hhes i j)
  have hsq : ContinuousOn (fun y => hessSqLoc G f y) V := by
    simp only [hessSqLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
        (((hinv i a).mul (hinv j b)).mul (hhes i j)).mul (hhes a b)
  have hgs : ContinuousOn (fun y => hessGradSqLoc G f y) V := by
    simp only [hessGradSqLoc]
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
        ((hinv i j).mul ((hhes i a).mul (hgu a))).mul ((hhes j b).mul (hgu b))
  
  set Rq : Set E3 := {y | y ∈ V ∧ 0 < gradSqLoc G f y} with hRqdef
  have hRV : Rq ⊆ V := fun y hy => hy.1
  have hne : ∀ y ∈ Rq, gradSqLoc G f y ≠ 0 := fun y hy => hy.2.ne'
  have hne2 : ∀ y ∈ Rq, gradSqLoc G f y ^ 2 ≠ 0 := fun y hy => pow_ne_zero 2 (hy.2.ne')
  have hLG : ContinuousOn (fun y => levelGaussLoc G f y) Rq := by
    simp only [levelGaussLoc]
    have hR' := hR.mono hRV
    have hrg' := hrg.mono hRV
    have hN' := hN.mono hRV
    have hlap' := hlap.mono hRV
    have hgg' := hgg.mono hRV
    have hsq' := hsq.mono hRV
    have hgs' := hgs.mono hRV
    exact continuousOn_const.mul
      (((hR'.sub ((continuousOn_const.mul hrg').div hN' hne)).add
        (((hlap'.sub (hgg'.div hN' hne)).pow 2).div hN' hne)).sub
        (((hsq'.sub ((continuousOn_const.mul hgs').div hN' hne)).add
          ((hgg'.pow 2).div (hN'.pow 2) hne2)).div hN' hne))
  
  have hsub : {y | y ∈ c.target ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (c.symm y) ≠ 0} ⊆ Rq := by
    intro y hy
    exact ⟨hy.1, chart_Nsq_pos g u hu q y hy.1 hy.2⟩
  refine (hLG.mono hsub).congr ?_
  intro y hy
  have hp : c.symm y ∈ c.source := c.map_target hy.1
  have h := key (c.symm y) hp hy.2
  simp only []
  rw [h, c.right_inv hy.1]

theorem stern_band_pointwise [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (β u : M → ℝ) (hβc : Continuous β)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (p : M) (hp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) (ε : ℝ) (hε : 0 < ε) :
    0 < g.gradInner u u p ∧
    (0 < β p → -(|sternGaussM g u p| * ε / (2 * Real.sqrt (g.gradInner u u p))) ≤
      g.lapM (sternPhiM g u ε) p + Real.sqrt (g.gradInner u u p) * sternGaussM g u p) ∧
    g.gradInner β (sternPhiM g u ε) p =
      Real.sqrt (g.gradInner u u p) / sternPhiM g u ε p *
        g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p ∧
    0 ≤ 1 - Real.sqrt (g.gradInner u u p) / sternPhiM g u ε p ∧
    1 - Real.sqrt (g.gradInner u u p) / sternPhiM g u ε p ≤ ε / (2 * g.gradInner u u p) :=
by
  
  have hy₀ : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have hsy : (chartAt E3 p).symm (chartAt E3 p p) = p :=
    (chartAt E3 p).left_inv (mem_chart_source E3 p)
  have hQ : 0 < g.gradInner u u p :=
    chart_Nsq_pos g u hu p _ hy₀ (by rw [hsy]; exact hp)
  have hphi : sternPhiM g u ε p = Real.sqrt (g.gradInner u u p + ε) := rfl
  
  set Q := g.gradInner u u p with hQdef
  set n := Real.sqrt Q with hndef
  set b := Real.sqrt (Q + ε) with hbdef
  have hn : 0 < n := Real.sqrt_pos.2 hQ
  have hb : 0 < b := Real.sqrt_pos.2 (by linarith)
  have hn2 : n ^ 2 = Q := Real.sq_sqrt hQ.le
  have hb2 : b ^ 2 = Q + ε := Real.sq_sqrt (by linarith)
  have hnb : n ≤ b := Real.sqrt_le_sqrt (by linarith)
  have expand : ε * b - (b - n) * (2 * Q) = (b - n) ^ 2 * (b + 2 * n) := by
    linear_combination (-b) * hb2 + (3 * b - 2 * n) * hn2
  have hexp0 : 0 ≤ (b - n) ^ 2 * (b + 2 * n) := by positivity
  have hc4 : 0 ≤ 1 - n / b := by
    have : n / b ≤ 1 := (div_le_one hb).2 hnb
    linarith
  have hc5 : 1 - n / b ≤ ε / (2 * Q) := by
    have e1 : 1 - n / b = (b - n) / b := by field_simp
    rw [e1, div_le_div_iff₀ hb (by positivity)]
    linarith
  
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 p).symm y i j)
      (chartAt E3 p).target := fun i j => g.smooth p i j
  have hsym : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 p).symm y i j = g.coeff (chartAt E3 p).symm y j i := by
    intro y i j
    exact g.symm _ _ _
  have hpdT : ∀ y ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g p y hy
  obtain ⟨hũ, hFeq, -⟩ := chart_pullback_gradInner g u hu p
  have hT : (chartAt E3 p).target ∈ 𝓝 (chartAt E3 p p) :=
    (chartAt E3 p).open_target.mem_nhds hy₀
  
  have hgerm : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f f' : E3 → ℝ) (y : E3),
      f =ᶠ[𝓝 y] f' → lapLoc G f y = lapLoc G f' y := by
    intro G f f' y h
    have h1 : ∀ k, partialDeriv k f y = partialDeriv k f' y := by
      intro k
      simp only [partialDeriv, h.fderiv_eq]
    have h2 : ∀ j, partialDeriv j f =ᶠ[𝓝 y] partialDeriv j f' := by
      intro j
      filter_upwards [Filter.EventuallyEq.fderiv (𝕜 := ℝ) h] with z hz
      simp only [partialDeriv, hz]
    have h3 : ∀ i j, partialDeriv i (partialDeriv j f) y =
        partialDeriv i (partialDeriv j f') y := by
      intro i j
      show fderiv ℝ (partialDeriv j f) y (e i) = fderiv ℝ (partialDeriv j f') y (e i)
      rw [(h2 j).fderiv_eq]
    simp only [lapLoc, hessLoc, h1, h3]
  refine ⟨hQ, ?_, ?_, ?_, ?_⟩
  · 
    intro hβp
    have hVo : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' {x : M | 0 < β x}) :=
      (chartAt E3 p).continuousOn_symm.isOpen_inter_preimage (chartAt E3 p).open_target
        (isOpen_lt continuous_const hβc)
    have hVT : (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' {x : M | 0 < β x} ⊆
        (chartAt E3 p).target := Set.inter_subset_left
    have hy₀V : chartAt E3 p p ∈
        (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' {x : M | 0 < β x} := by
      refine ⟨hy₀, ?_⟩
      show 0 < β ((chartAt E3 p).symm (chartAt E3 p p))
      rw [hsy]; exact hβp
    have hlap : ∀ y ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' {x : M | 0 < β x},
        lapLoc (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z)) y = 0 := by
      intro y hy
      have hβy : 0 < β ((chartAt E3 p).symm y) := hy.2
      have h0 := hharm _ hβy.le
      rw [nli_chart_lapM_eq g p u hu y hy.1] at h0
      rw [← h0]
      simp only [lapLoc, hessLoc, Fin.sum_univ_three]
      ring
    have hB := (stern_bochner_local (g.coeff (chartAt E3 p).symm)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' {x : M | 0 < β x}) hVo
      (fun i j => (hGs i j).mono hVT) hsym (fun y hy => hpdT y hy.1)
      (fun z => u ((chartAt E3 p).symm z)) (hũ.mono hVT) hlap ε hε (chartAt E3 p p) hy₀V).2 hQ
    have hev1 : sternPhiLoc (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z)) ε
        =ᶠ[𝓝 (chartAt E3 p p)] fun z => sternPhiM g u ε ((chartAt E3 p).symm z) := by
      filter_upwards [hT] with z hz
      simp only [sternPhiLoc, sternPhiM, gradSqLoc, gradInnerLoc]
      rw [hFeq z hz]
    have hlapeq : lapLoc (g.coeff (chartAt E3 p).symm)
        (sternPhiLoc (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z)) ε)
        (chartAt E3 p p) = g.lapM (sternPhiM g u ε) p := hgerm _ _ _ _ hev1
    have hB' : (1 / 2 : ℝ) * hessSqLoc (g.coeff (chartAt E3 p).symm)
          (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p p) +
        (1 / 2 : ℝ) * Q * (g.scalarCurvature p - 2 * sternGaussM g u p) ≤
        b * g.lapM (sternPhiM g u ε) p := by
      rw [← hlapeq]
      exact hB
    have hH : 0 ≤ hessSqLoc (g.coeff (chartAt E3 p).symm)
        (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p p) :=
      (stern_kato_alg (g.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹
        (fun i j => hessLoc (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z))
          i j (chartAt E3 p p))
        (hpdT _ hy₀).inv 0 (fun a => ∑ c : Fin 3,
          (g.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ a c * (0 : Fin 3 → ℝ) c)
        (fun _ => rfl)).2.1
    have hQR : 0 ≤ Q * g.scalarCurvature p := mul_nonneg hQ.le (hR p)
    have hbd : -(Q * sternGaussM g u p) ≤ b * g.lapM (sternPhiM g u ε) p := by
      nlinarith
    
    set K := sternGaussM g u p with hKdef
    set Δ := g.lapM (sternPhiM g u ε) p with hΔdef
    have t1 : 2 * n * (-(Q * K)) ≤ 2 * n * (b * Δ) :=
      mul_le_mul_of_nonneg_left hbd (by positivity)
    have t2 : 0 ≤ |K| * (ε * b - (b - n) * (2 * Q)) :=
      mul_nonneg (abs_nonneg K) (by rw [expand]; exact hexp0)
    have t3 : 0 ≤ (b - n) * (K + |K|) * (2 * Q) :=
      mul_nonneg (mul_nonneg (sub_nonneg.2 hnb) (by linarith [neg_abs_le K])) (by positivity)
    have hQb : n * Q * K = n * (n ^ 2) * K := by rw [hn2]
    have hQb2 : Q * b * K = n ^ 2 * b * K := by rw [hn2]
    have hX : b * 0 ≤ b * (2 * n * (Δ + n * K) + |K| * ε) := by
      nlinarith
    have hX' : 0 ≤ 2 * n * (Δ + n * K) + |K| * ε := le_of_mul_le_mul_left hX hb
    rw [neg_le, le_div_iff₀ (by positivity)]
    nlinarith
  · 
    set F : E3 → ℝ := fun z => ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm z)⁻¹ i j *
          partialDeriv i (fun z => u ((chartAt E3 p).symm z)) z *
          partialDeriv j (fun z => u ((chartAt E3 p).symm z)) z with hFdef
    have hsm := ejp_coord_smooth (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z))
      (chartAt E3 p).target (chartAt E3 p).open_target hGs hpdT hũ
    have hFs : ContDiffOn ℝ ∞ F (chartAt E3 p).target := by
      apply ContDiffOn.sum
      intro i _
      apply ContDiffOn.sum
      intro j _
      exact ((hsm.2.1 i j).mul (hsm.1 _ hũ i)).mul (hsm.1 _ hũ j)
    have hFd : DifferentiableAt ℝ F (chartAt E3 p p) :=
      (hFs.contDiffAt hT).differentiableAt (by simp)
    have hF0 : F (chartAt E3 p p) = Q := rfl
    have hne1 : F (chartAt E3 p p) + ε ≠ 0 := by rw [hF0]; linarith
    have hne2 : F (chartAt E3 p p) ≠ 0 := by rw [hF0]; exact hQ.ne'
    have hchain : ∀ j : Fin 3,
        partialDeriv j (fun z => sternPhiM g u ε ((chartAt E3 p).symm z)) (chartAt E3 p p) =
          n / b * partialDeriv j (fun z => Real.sqrt (g.gradInner u u ((chartAt E3 p).symm z)))
            (chartAt E3 p p) := by
      intro j
      have e1 : (fun z => sternPhiM g u ε ((chartAt E3 p).symm z)) =ᶠ[𝓝 (chartAt E3 p p)]
          fun z => Real.sqrt (F z + ε) := by
        filter_upwards [hT] with z hz
        simp only [sternPhiM, hFdef]
        rw [hFeq z hz]
      have e2 : (fun z => Real.sqrt (g.gradInner u u ((chartAt E3 p).symm z)))
          =ᶠ[𝓝 (chartAt E3 p p)] fun z => Real.sqrt (F z) := by
        filter_upwards [hT] with z hz
        simp only [hFdef]
        rw [hFeq z hz]
      have d1 : partialDeriv j (fun z => sternPhiM g u ε ((chartAt E3 p).symm z)) (chartAt E3 p p)
          = (1 / (2 * Real.sqrt (F (chartAt E3 p p) + ε))) * fderiv ℝ F (chartAt E3 p p) (e j) := by
        unfold partialDeriv
        rw [e1.fderiv_eq, fderiv_sqrt (hFd.add_const ε) hne1, fderiv_add_const,
          ContinuousLinearMap.smul_apply, smul_eq_mul]
      have d2 : partialDeriv j (fun z => Real.sqrt (g.gradInner u u ((chartAt E3 p).symm z)))
          (chartAt E3 p p)
          = (1 / (2 * Real.sqrt (F (chartAt E3 p p)))) * fderiv ℝ F (chartAt E3 p p) (e j) := by
        unfold partialDeriv
        rw [e2.fderiv_eq, fderiv_sqrt hFd hne2, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [d1, d2, hF0]
      field_simp
      simp only [hbdef, hndef]
      ring
    show ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ i j *
        partialDeriv i (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) *
        partialDeriv j (fun y => sternPhiM g u ε ((chartAt E3 p).symm y)) (chartAt E3 p p) =
      n / sternPhiM g u ε p * ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ i j *
        partialDeriv i (fun y => β ((chartAt E3 p).symm y)) (chartAt E3 p p) *
        partialDeriv j (fun y => Real.sqrt (g.gradInner u u ((chartAt E3 p).symm y)))
          (chartAt E3 p p)
    rw [hphi]
    simp only [hchain, Fin.sum_univ_three]
    ring
  · rw [hphi]; exact hc4
  · rw [hphi]; exact hc5

theorem stern_chart_integral_compare (D Kc : Set E3) (hD : MeasurableSet D) (hKc : IsCompact Kc)
    (hKD : Kc ⊆ D) (b Af Cf : E3 → ℝ) (hb : ContinuousOn b Kc) (hA : ContinuousOn Af Kc)
    (hC : ContinuousOn Cf Kc) (Cb s₀ : ℝ)
    (hband : ∀ s : ℝ, 0 < s → s < s₀ →
      volume (Kc ∩ {y | 0 < b y ∧ b y < s}) ≤ ENNReal.ofReal (Cb * s)) :
    ∃ Λ : ℝ, 0 ≤ Λ ∧ ∀ ε s : ℝ, 0 < ε → 0 < s → s < s₀ →
      ∀ fB fC f1 f2 : E3 → ℝ, ContinuousOn fB Kc → ContinuousOn fC Kc → ContinuousOn f1 Kc →
        ContinuousOn f2 Kc →
        (∀ y ∈ D \ Kc, fB y = 0 ∧ fC y = 0 ∧ f1 y = 0 ∧ f2 y = 0) →
        (∀ y ∈ Kc, -(ε * Af y) ≤ fB y + f1 y) →
        (∀ y ∈ Kc, -(ε / s * Cf y * Set.indicator {z | 0 < b z ∧ b z < s} (fun _ => (1 : ℝ)) y) ≤
          fC y - f2 y) →
        -(ε * Λ) ≤ (∫ y in D, fB y) + (∫ y in D, fC y) + (∫ y in D, f1 y) - (∫ y in D, f2 y) :=
by
  obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn hC
  set M₀ := max M 0 with hM₀def
  have hM₀0 : 0 ≤ M₀ := le_max_right _ _
  have hM₀ : ∀ y ∈ Kc, |Cf y| ≤ M₀ := fun y hy =>
    le_trans (by rw [← Real.norm_eq_abs]; exact hM y hy) (le_max_left _ _)
  refine ⟨max (∫ y in Kc, Af y) 0 + M₀ * max Cb 0,
    add_nonneg (le_max_right _ _) (mul_nonneg hM₀0 (le_max_right _ _)), ?_⟩
  intro ε s hε hs hss fB fC f1 f2 hfB hfC hf1 hf2 hvan hbulk hbandpt
  have hKm : MeasurableSet Kc := hKc.measurableSet
  have eB : ∫ y in D, fB y = ∫ y in Kc, fB y :=
    setIntegral_eq_of_subset_of_forall_diff_eq_zero hD hKD (fun y hy => (hvan y hy).1)
  have eC : ∫ y in D, fC y = ∫ y in Kc, fC y :=
    setIntegral_eq_of_subset_of_forall_diff_eq_zero hD hKD (fun y hy => (hvan y hy).2.1)
  have e1 : ∫ y in D, f1 y = ∫ y in Kc, f1 y :=
    setIntegral_eq_of_subset_of_forall_diff_eq_zero hD hKD (fun y hy => (hvan y hy).2.2.1)
  have e2 : ∫ y in D, f2 y = ∫ y in Kc, f2 y :=
    setIntegral_eq_of_subset_of_forall_diff_eq_zero hD hKD (fun y hy => (hvan y hy).2.2.2)
  have iB : IntegrableOn fB Kc := hfB.integrableOn_compact hKc
  have iC : IntegrableOn fC Kc := hfC.integrableOn_compact hKc
  have i1 : IntegrableOn f1 Kc := hf1.integrableOn_compact hKc
  have i2 : IntegrableOn f2 Kc := hf2.integrableOn_compact hKc
  have iB1 : IntegrableOn (fun y => fB y + f1 y) Kc := (hfB.add hf1).integrableOn_compact hKc
  have iC2 : IntegrableOn (fun y => fC y - f2 y) Kc := (hfC.sub hf2).integrableOn_compact hKc
  have iA' : IntegrableOn (fun y => -(ε * Af y)) Kc :=
    ((continuousOn_const.mul hA).neg).integrableOn_compact hKc
  have hsum1 : ∫ y in Kc, (fB y + f1 y) = (∫ y in Kc, fB y) + ∫ y in Kc, f1 y :=
    integral_add iB i1
  have hsum2 : ∫ y in Kc, (fC y - f2 y) = (∫ y in Kc, fC y) - ∫ y in Kc, f2 y :=
    integral_sub iC i2
  
  have hI1 : -(ε * max (∫ y in Kc, Af y) 0) ≤ ∫ y in Kc, (fB y + f1 y) := by
    have hmono : ∫ y in Kc, -(ε * Af y) ≤ ∫ y in Kc, (fB y + f1 y) :=
      setIntegral_mono_on iA' iB1 hKm hbulk
    have hc : ∫ y in Kc, -(ε * Af y) = -(ε * ∫ y in Kc, Af y) := by
      rw [integral_neg, integral_const_mul]
    have : ε * ∫ y in Kc, Af y ≤ ε * max (∫ y in Kc, Af y) 0 :=
      mul_le_mul_of_nonneg_left (le_max_left _ _) hε.le
    linarith
  
  have hI2 : -(ε * (M₀ * max Cb 0)) ≤ ∫ y in Kc, (fC y - f2 y) := by
    obtain ⟨U, hUo, hUeq⟩ := (_root_.continuousOn_iff'.mp hb) (Set.Ioo 0 s) isOpen_Ioo
    have hWm : MeasurableSet (U ∩ Kc) := hUo.measurableSet.inter hKm
    have hWsub : U ∩ Kc ⊆ Kc := Set.inter_subset_right
    have hmemW : ∀ y ∈ Kc, (y ∈ {z | 0 < b z ∧ b z < s} ↔ y ∈ U ∩ Kc) := by
      intro y hy
      rw [← hUeq]
      simp [Set.mem_Ioo, hy]
    have hKW : Kc ∩ {y | 0 < b y ∧ b y < s} = U ∩ Kc := by
      ext y
      constructor
      · rintro ⟨hy, hy'⟩
        exact (hmemW y hy).1 hy'
      · intro hy
        exact ⟨hWsub hy, (hmemW y (hWsub hy)).2 hy⟩
    have hvol : volume (U ∩ Kc) ≤ ENNReal.ofReal (Cb * s) := by
      rw [← hKW]
      exact hband s hs hss
    have hes0 : 0 ≤ ε / s := div_nonneg hε.le hs.le
    have hpt : ∀ y ∈ Kc,
        -(ε / s * M₀) * (U ∩ Kc).indicator (fun _ => (1 : ℝ)) y ≤ fC y - f2 y := by
      intro y hy
      have h := hbandpt y hy
      by_cases hyW : y ∈ U ∩ Kc
      · have hyB : y ∈ {z | 0 < b z ∧ b z < s} := (hmemW y hy).2 hyW
        rw [Set.indicator_of_mem hyW]
        rw [Set.indicator_of_mem hyB] at h
        have hcf : Cf y ≤ M₀ := le_trans (le_abs_self _) (hM₀ y hy)
        have : ε / s * Cf y ≤ ε / s * M₀ := mul_le_mul_of_nonneg_left hcf hes0
        linarith
      · have hyB : y ∉ {z | 0 < b z ∧ b z < s} := fun h' => hyW ((hmemW y hy).1 h')
        rw [Set.indicator_of_notMem hyW]
        rw [Set.indicator_of_notMem hyB] at h
        linarith
    have igW : IntegrableOn
        (fun y => -(ε / s * M₀) * (U ∩ Kc).indicator (fun _ => (1 : ℝ)) y) Kc := by
      have h1 : IntegrableOn ((U ∩ Kc).indicator (fun _ => (1 : ℝ))) Kc :=
        IntegrableOn.indicator
          (continuousOn_const.integrableOn_compact hKc : IntegrableOn (fun _ => (1 : ℝ)) Kc) hWm
      exact Integrable.const_mul h1 _
    have hmono := setIntegral_mono_on igW iC2 hKm hpt
    have hcomp : ∫ y in Kc, -(ε / s * M₀) * (U ∩ Kc).indicator (fun _ => (1 : ℝ)) y
        = -(ε / s * M₀) * volume.real (U ∩ Kc) := by
      rw [integral_const_mul, setIntegral_indicator hWm, setIntegral_const,
        Set.inter_eq_right.mpr hWsub, smul_eq_mul, mul_one]
    have hreal : volume.real (U ∩ Kc) ≤ s * max Cb 0 := by
      rw [measureReal_def]
      have h1 := ENNReal.toReal_mono ENNReal.ofReal_ne_top hvol
      rw [ENNReal.toReal_ofReal'] at h1
      refine le_trans h1 (max_le ?_ (mul_nonneg hs.le (le_max_right _ _)))
      rw [mul_comm]
      exact mul_le_mul_of_nonneg_left (le_max_left _ _) hs.le
    have hfin : -(ε / s * M₀) * (s * max Cb 0) = -(ε * (M₀ * max Cb 0)) := by
      have hss' : ε / s * s = ε := div_mul_cancel₀ ε hs.ne'
      calc -(ε / s * M₀) * (s * max Cb 0) = -((ε / s * s) * (M₀ * max Cb 0)) := by ring
        _ = -(ε * (M₀ * max Cb 0)) := by rw [hss']
    have hle : -(ε / s * M₀) * (s * max Cb 0) ≤ -(ε / s * M₀) * volume.real (U ∩ Kc) :=
      mul_le_mul_of_nonpos_left hreal (by nlinarith [mul_nonneg hes0 hM₀0])
    linarith
  rw [eB, eC, e1, e2]
  have hsplit : -(ε * (max (∫ y in Kc, Af y) 0 + M₀ * max Cb 0)) =
      -(ε * max (∫ y in Kc, Af y) 0) + -(ε * (M₀ * max Cb 0)) := by ring
  linarith

theorem stern_band_eps_limit [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L → ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ),
      sternAdmissible (sternDomain (hAF.ends k) β Y L) q φ →
      ∀ A : Set ℝ, IsCompact A → A ⊆ Set.Ioo (-L) L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ A → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ θ : ℝ, 0 < θ → ∃ ε₁ : ℝ, 0 < ε₁ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₁ →
        ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ s : ℝ, 0 < s → s < s₂ →
          -sternBandJ g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) s - θ ≤
            sternBulk g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) ε s +
              sternCollar g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) ε s :=
by
  classical
  refine ⟨R₁ + 1, fun L hL n q φ hadm A hA hAL hreg θ hθ => ?_⟩
  have hLR : R₁ < L := by linarith
  set S := sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A with hSdef
  have hβs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β := hβ.1
  have hβc : Continuous β := hβs.continuous
  have huc : Continuous u := hu.continuous
  have hSc : IsCompact S := (hdom.2 L hLR).1.inter_right (hA.isClosed.preimage huc)
  have hSreg : ∀ p ∈ S, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 := fun p hp => hreg p hp.1 hp.2
  obtain ⟨Ω', O, hpart, -, -, -⟩ := hadm
  obtain ⟨hφs, hφ0, -, hφsupp⟩ := hpart
  
  have hd0 : ∀ x : ℝ, x ≤ 0 → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMin.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.zero_of_nonpos hx]
    exact Real.smoothTransition.nonneg y
  have hd1 : ∀ x : ℝ, 1 ≤ x → deriv Real.smoothTransition x = 0 := by
    intro x hx
    apply IsLocalMax.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.smoothTransition.one_of_one_le hx]
    exact Real.smoothTransition.le_one y
  have hdnn : ∀ x : ℝ, 0 ≤ deriv Real.smoothTransition x := fun x =>
    Real.smoothTransition.monotone.deriv_nonneg
  have hdc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by norm_num)
  obtain ⟨Mη, hMη⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
    hdc.continuousOn
  have hdle : ∀ x : ℝ, deriv Real.smoothTransition x ≤ Mη := by
    intro x
    by_cases h0 : x ≤ 0
    · rw [hd0 x h0]; exact le_trans (norm_nonneg _) (hMη 0 ⟨le_rfl, zero_le_one⟩)
    by_cases h1 : 1 ≤ x
    · rw [hd1 x h1]; exact le_trans (norm_nonneg _) (hMη 0 ⟨le_rfl, zero_le_one⟩)
    push_neg at h0 h1
    have := hMη x ⟨h0.le, h1.le⟩
    rw [Real.norm_eq_abs] at this
    exact le_trans (le_abs_self _) this
  have hMη0 : 0 ≤ Mη := le_trans (hdnn 0) (hdle 0)
  
  have hchart : ∀ j : Fin n, ∃ Λ s₀ : ℝ, 0 < s₀ ∧ 0 ≤ Λ ∧ ∀ ε s : ℝ, 0 < ε → 0 < s → s < s₀ →
      -(ε * Λ) ≤
        (∫ y in chartAt E3 (q j) '' (S ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) *
            (Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
              g.lapM (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) +
        (∫ y in chartAt E3 (q j) '' (S ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) *
            (s⁻¹ * deriv Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
              g.gradInner β (sternPhiM g u ε) ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) +
        (∫ y in chartAt E3 (q j) '' (S ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) *
            (Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
              Real.sqrt (g.gradInner u u ((chartAt E3 (q j)).symm y)) *
              sternGaussM g u ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) -
        (∫ y in chartAt E3 (q j) '' (S ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) *
            (s⁻¹ * deriv Real.smoothTransition (β ((chartAt E3 (q j)).symm y) / s) *
              g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) := by
    intro j
    set c := chartAt E3 (q j) with hc
    have hsupp := hφsupp j
    set Kc := c '' (S ∩ tsupport (φ j)) with hKcdef
    set D := c '' (S ∩ c.source) with hDdef
    have hKcc : IsCompact Kc := (hSc.inter_right (isClosed_tsupport _)).image_of_continuousOn
      (c.continuousOn.mono (fun x hx => (hsupp.2 hx.2).2))
    have hKD : Kc ⊆ D := Set.image_mono (fun x hx => ⟨hx.1, (hsupp.2 hx.2).2⟩)
    have hKT : Kc ⊆ c.target := by
      rintro _ ⟨x, hx, rfl⟩
      exact c.map_source (hsupp.2 hx.2).2
    have hKS : ∀ y ∈ Kc, c.symm y ∈ S := by
      rintro _ ⟨x, hx, rfl⟩
      rw [c.left_inv (hsupp.2 hx.2).2]
      exact hx.1
    have hKreg : ∀ y ∈ Kc, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (c.symm y) ≠ 0 :=
      fun y hy => hSreg _ (hKS y hy)
    have hDm : MeasurableSet D := by
      have h1 : D = c.target \ (c.target ∩ c.symm ⁻¹' Sᶜ) := by
        rw [hDdef, c.image_eq_target_inter_inv_preimage Set.inter_subset_right]
        ext y
        constructor
        · rintro ⟨hy, hyS, -⟩
          exact ⟨hy, fun h => h.2 hyS⟩
        · rintro ⟨hy, hn⟩
          exact ⟨hy, not_not.mp (fun h => hn ⟨hy, h⟩), c.map_target hy⟩
      rw [h1]
      exact c.open_target.measurableSet.diff
        (c.isOpen_inter_preimage_symm hSc.isClosed.isOpen_compl).measurableSet
    have hvan0 : ∀ y ∈ D \ Kc, φ j (c.symm y) = 0 := by
      rintro _ ⟨⟨x, hx, rfl⟩, hy⟩
      rw [c.left_inv hx.2]
      exact image_eq_zero_of_notMem_tsupport (fun h => hy ⟨x, ⟨hx.1, h⟩, rfl⟩)
    
    have hG : ContinuousOn (g.coeff c.symm) c.target :=
      continuousOn_pi.2 fun i => continuousOn_pi.2 fun j' => (g.smooth (q j) i j').continuousOn
    have hsd : ContinuousOn (fun y => Real.sqrt (g.coeff c.symm y).det) c.target :=
      Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hG)
    have hψc : ContinuousOn (fun y => φ j (c.symm y)) c.target :=
      (hφs j).continuous.comp_continuousOn c.continuousOn_symm
    have hbc : ContinuousOn (fun y => β (c.symm y)) c.target :=
      hβc.comp_continuousOn c.continuousOn_symm
    have hQ : ContinuousOn (fun y => g.gradInner u u (c.symm y)) c.target :=
      (stern_gradInner_chart g u u Set.univ isOpen_univ hu hu.contMDiffOn (q j)).mono
        (fun y hy => ⟨hy, Set.mem_univ _⟩)
    obtain ⟨-, -, hRegO, hNs⟩ := stern_phi_chart_reps g u hu 1 one_pos (q j)
    have hXc : ContinuousOn
        (fun y => g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y)) Kc :=
      (stern_gradInner_chart g β _ _ hRegO hβs hNs (q j)).mono
        (fun y hy => ⟨hKT hy, hKreg y hy⟩)
    have hKgc : ContinuousOn (fun y => sternGaussM g u (c.symm y)) Kc :=
      (stern_gauss_chart g u hu (q j)).mono (fun y hy => ⟨hKT hy, hKreg y hy⟩)
    have hQpos : ∀ y ∈ Kc, 0 < g.gradInner u u (c.symm y) := fun y hy =>
      (stern_band_pointwise g hR β u hβc hu hharm (c.symm y) (hKreg y hy) 1 one_pos).1
    have hnz1 : ∀ y ∈ Kc, (2 * Real.sqrt (g.gradInner u u (c.symm y))) ≠ 0 := fun y hy =>
      mul_ne_zero two_ne_zero (Real.sqrt_pos.2 (hQpos y hy)).ne'
    have hnz2 : ∀ y ∈ Kc, (2 * g.gradInner u u (c.symm y)) ≠ 0 := fun y hy =>
      mul_ne_zero two_ne_zero (hQpos y hy).ne'
    have hsqQ : ContinuousOn (fun y => Real.sqrt (g.gradInner u u (c.symm y))) Kc :=
      Real.continuous_sqrt.comp_continuousOn (hQ.mono hKT)
    have hAf : ContinuousOn (fun y => φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det *
        |sternGaussM g u (c.symm y)| * (2 * Real.sqrt (g.gradInner u u (c.symm y)))⁻¹) Kc :=
      (((hψc.mono hKT).mul (hsd.mono hKT)).mul hKgc.abs).mul
        ((continuousOn_const.mul hsqQ).inv₀ hnz1)
    have hCf : ContinuousOn (fun y => Mη * (φ j (c.symm y) * Real.sqrt (g.coeff c.symm y).det *
        |g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) (c.symm y)| *
