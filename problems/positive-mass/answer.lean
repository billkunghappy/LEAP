  intro x₀ hx₀
  
  have hEL1 := smth_EL_C1_test Λ O hO hΛ D hD v hv hvO hEL
  obtain ⟨R, h₀, lam, Lam, K, M₀, hR, hh₀, hlam, hLam, hK, hM₀, hball, hstr⟩ :=
    smth_diffquot_structure Λ O hO hΛ hell D hD v hv hvO hEL1 x₀ hx₀
  obtain ⟨C, α, hC, hα, hhol⟩ := smth_linear_holder x₀ R lam Lam K M₀ hR hlam hLam hK hM₀
  
  have hdq : ∀ (m : Fin 2) (h : ℝ), 0 < h → h ≤ h₀ →
      ∀ y ∈ Metric.ball x₀ (R / 8), ∀ y' ∈ Metric.ball x₀ (R / 8),
        |(v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h -
          (v (y' + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y') / h| ≤ C * dist y y' ^ α := by
    intro m h hh hhh y hy y' hy'
    obtain ⟨P, p, hPc, hpc, hwb, hcoer, hPb, hpb, hweak⟩ := hstr m h hh hhh
    have hw : ContDiff ℝ 1
        (fun y => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h) :=
      ((hv.comp (contDiff_id.add contDiff_const)).sub hv).div_const h
    exact hhol _ P p hw hPc hpc hwb hcoer hPb hpb hweak y hy y' hy'
  
  have hlim : ∀ (m : Fin 2) (y : Fin 2 → ℝ),
      Tendsto (fun h : ℝ => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h)
        (𝓝[>] 0) (𝓝 (smthGrad v y m)) := by
    intro m y
    have h1 : HasDerivAt (fun t : ℝ => y + t • (Pi.single m (1 : ℝ) : Fin 2 → ℝ))
        (Pi.single m (1 : ℝ) : Fin 2 → ℝ) 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const
        (Pi.single m (1 : ℝ) : Fin 2 → ℝ)).const_add y
    have h2 : HasFDerivAt v (fderiv ℝ v y) (y + (0 : ℝ) • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) := by
      rw [zero_smul, add_zero]
      exact (hv.differentiable (by norm_num) y).hasFDerivAt
    have hd : HasDerivAt (fun t : ℝ => v (y + t • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)))
        (smthGrad v y m) 0 :=
      h2.comp_hasDerivAt (0 : ℝ) h1
    have ht := hd.tendsto_slope_zero_right
    refine ht.congr' ?_
    filter_upwards with t
    simp only [zero_add, zero_smul, add_zero, smul_eq_mul]
    rw [div_eq_inv_mul]
  have hgrad : ∀ (m : Fin 2), ∀ y ∈ Metric.ball x₀ (R / 8), ∀ y' ∈ Metric.ball x₀ (R / 8),
      |smthGrad v y m - smthGrad v y' m| ≤ C * dist y y' ^ α := by
    intro m y hy y' hy'
    have T := ((hlim m y).sub (hlim m y')).abs
    refine le_of_tendsto T ?_
    filter_upwards [Ioc_mem_nhdsGT hh₀] with h hh
    exact hdq m h hh.1 hh.2 y hy y' hy'
  
  refine ⟨R / 8, ⟨C, hC⟩, ⟨α, hα.le⟩, by positivity, ?_, ?_, ?_⟩
  · show (0 : ℝ) < α
    exact hα
  · intro z hz
    apply hball
    exact Metric.ball_subset_closedBall
      (Metric.ball_subset_ball (by linarith) hz)
  · intro y hy y' hy'
    rw [edist_pi_le_iff]
    intro m
    have key : ENNReal.ofReal |smthGrad v y m - smthGrad v y' m| ≤
        ENNReal.ofReal (C * dist y y' ^ α) := ENNReal.ofReal_le_ofReal (hgrad m y hy y' hy')
    convert key using 1
    · rw [edist_dist, Real.dist_eq]
    · rw [edist_dist, ENNReal.ofReal_mul hC, ENNReal.ofReal_eq_coe_nnreal hC,
        ← ENNReal.ofReal_rpow_of_nonneg dist_nonneg hα.le]
      rfl

theorem smth_holC_mono (k : ℕ) (u : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (hu : smthHolC (k + 1) u S) : smthHolC k u S :=
by
  induction k generalizing u with
  | succ k ih =>
    exact ⟨hu.1, fun m => ih _ (hu.2 m)⟩
  | zero =>
    obtain ⟨hd, hpar⟩ := hu
    refine ⟨fun x hx => (hd x hx).continuousAt.continuousWithinAt, ?_⟩
    intro x₀ hx₀
    obtain ⟨r, hr, hrS⟩ := Metric.isOpen_iff.mp hS x₀ hx₀
    have hcont : ∀ m : Fin 2, ∃ δ > 0, ∀ y, dist y x₀ < δ →
        |smthGrad u y m| ≤ |smthGrad u x₀ m| + 1 := by
      intro m
      have hc : ContinuousAt (fun x => smthGrad u x m) x₀ :=
        (hpar m).1.continuousAt (hS.mem_nhds hx₀)
      obtain ⟨δ, hδ, h⟩ := Metric.continuousAt_iff.mp hc 1 one_pos
      refine ⟨δ, hδ, fun y hy => ?_⟩
      have h1 := h hy
      rw [Real.dist_eq] at h1
      have := abs_sub_abs_le_abs_sub (smthGrad u y m) (smthGrad u x₀ m)
      linarith
    obtain ⟨δ₀, hδ₀, h₀⟩ := hcont 0
    obtain ⟨δ₁, hδ₁, h₁⟩ := hcont 1
    obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = (|smthGrad u x₀ 0| + 1) + (|smthGrad u x₀ 1| + 1) :=
      ⟨_, rfl⟩
    have hB0 : 0 ≤ B := by rw [hBdef]; positivity
    have hρ : 0 < min r (min δ₀ δ₁) := lt_min hr (lt_min hδ₀ hδ₁)
    have hball : Metric.ball x₀ (min r (min δ₀ δ₁)) ⊆ S :=
      (Metric.ball_subset_ball (min_le_left _ _)).trans hrS
    have hbound : ∀ y ∈ Metric.ball x₀ (min r (min δ₀ δ₁)), ‖fderiv ℝ u y‖ ≤ B := by
      intro y hy
      rw [Metric.mem_ball] at hy
      have hy0 : dist y x₀ < δ₀ :=
        lt_of_lt_of_le hy ((min_le_right _ _).trans (min_le_left _ _))
      have hy1 : dist y x₀ < δ₁ :=
        lt_of_lt_of_le hy ((min_le_right _ _).trans (min_le_right _ _))
      have b0 := h₀ y hy0
      have b1 := h₁ y hy1
      refine ContinuousLinearMap.opNorm_le_bound _ hB0 (fun h => ?_)
      have hdec : h = h 0 • (Pi.single 0 1 : Fin 2 → ℝ) + h 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
        funext i; fin_cases i <;> simp
      have hlin : fderiv ℝ u y h = h 0 * smthGrad u y 0 + h 1 * smthGrad u y 1 := by
        conv_lhs => rw [hdec]
        simp only [map_add, map_smul, smul_eq_mul, smthGrad]
      have hh0 : |h 0| ≤ ‖h‖ := by
        have := norm_le_pi_norm h 0
        rwa [Real.norm_eq_abs] at this
      have hh1 : |h 1| ≤ ‖h‖ := by
        have := norm_le_pi_norm h 1
        rwa [Real.norm_eq_abs] at this
      rw [Real.norm_eq_abs, hlin]
      calc |h 0 * smthGrad u y 0 + h 1 * smthGrad u y 1|
          ≤ |h 0 * smthGrad u y 0| + |h 1 * smthGrad u y 1| := abs_add_le _ _
        _ = |h 0| * |smthGrad u y 0| + |h 1| * |smthGrad u y 1| := by
            rw [abs_mul, abs_mul]
        _ ≤ ‖h‖ * (|smthGrad u x₀ 0| + 1) + ‖h‖ * (|smthGrad u x₀ 1| + 1) :=
            add_le_add (mul_le_mul hh0 b0 (abs_nonneg _) (norm_nonneg _))
              (mul_le_mul hh1 b1 (abs_nonneg _) (norm_nonneg _))
        _ = B * ‖h‖ := by rw [hBdef]; ring
    have hlip : LipschitzOnWith ⟨B, hB0⟩ u (Metric.ball x₀ (min r (min δ₀ δ₁))) := by
      refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
        (fun y hy => hd y (hball hy)) (fun y hy => ?_) (convex_ball _ _)
      rw [← NNReal.coe_le_coe, coe_nnnorm]
      exact hbound y hy
    exact ⟨min r (min δ₀ δ₁), ⟨B, hB0⟩, 1, hρ, one_pos, hball, hlip.holderOnWith⟩

theorem smth_holC_local (k : ℕ) (u : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) : (∀ T : Set (Fin 2 → ℝ), IsOpen T → T ⊆ S → smthHolC k u S → smthHolC k u T) ∧ ((∀ x ∈ S, ∃ T : Set (Fin 2 → ℝ), IsOpen T ∧ x ∈ T ∧ T ⊆ S ∧ smthHolC k u T) → smthHolC k u S) :=
by
  induction k generalizing u with
  | zero =>
    refine ⟨?_, ?_⟩
    · intro T hT hTS hu
      simp only [smthHolC] at hu ⊢
      obtain ⟨hc, hh⟩ := hu
      refine ⟨hc.mono hTS, ?_⟩
      intro x₀ hx₀
      obtain ⟨ρ, C, α, hρ, hα, hball, hH⟩ := hh x₀ (hTS hx₀)
      obtain ⟨ε, hε, hεT⟩ := Metric.isOpen_iff.mp hT x₀ hx₀
      exact ⟨min ρ ε, C, α, lt_min hρ hε, hα,
        (Metric.ball_subset_ball (min_le_right ρ ε)).trans hεT,
        hH.mono (Metric.ball_subset_ball (min_le_left ρ ε))⟩
    · intro hloc
      simp only [smthHolC] at hloc ⊢
      refine ⟨?_, ?_⟩
      · intro x hx
        obtain ⟨T, hT, hxT, hTS, hcT, _⟩ := hloc x hx
        exact (hcT.continuousAt (hT.mem_nhds hxT)).continuousWithinAt
      · intro x₀ hx₀
        obtain ⟨T, hT, hxT, hTS, _, hhT⟩ := hloc x₀ hx₀
        obtain ⟨ρ, C, α, hρ, hα, hball, hH⟩ := hhT x₀ hxT
        exact ⟨ρ, C, α, hρ, hα, hball.trans hTS, hH⟩
  | succ k ih =>
    refine ⟨?_, ?_⟩
    · intro T hT hTS hu
      simp only [smthHolC] at hu ⊢
      obtain ⟨hd, hg⟩ := hu
      exact ⟨fun x hx => hd x (hTS hx),
        fun m => (ih (fun x => smthGrad u x m)).1 T hT hTS (hg m)⟩
    · intro hloc
      simp only [smthHolC] at hloc ⊢
      refine ⟨?_, ?_⟩
      · intro x hx
        obtain ⟨T, _, hxT, _, hdT, _⟩ := hloc x hx
        exact hdT x hxT
      · intro m
        refine (ih (fun x => smthGrad u x m)).2 ?_
        intro x hx
        obtain ⟨T, hT, hxT, hTS, _, hgT⟩ := hloc x hx
        exact ⟨T, hT, hxT, hTS, hgT m⟩

theorem smth_holC_contDiffOn (k : ℕ) (u : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (hu : smthHolC k u S) : ContDiffOn ℝ k u S :=
by
  induction k generalizing u with
  | zero =>
    have h0 : ContinuousOn u S := hu.1
    simpa using (contDiffOn_zero (𝕜 := ℝ)).mpr h0
  | succ k ih =>
    have hd : ∀ x ∈ S, DifferentiableAt ℝ u x := hu.1
    have hpar : ∀ m : Fin 2, ContDiffOn ℝ k (fun x => smthGrad u x m) S :=
      fun m => ih _ (hu.2 m)
    have hlin : ∀ x y : Fin 2 → ℝ,
        fderiv ℝ u x y = y 0 * smthGrad u x 0 + y 1 * smthGrad u x 1 := by
      intro x y
      have hy : y = y 0 • (Pi.single 0 1 : Fin 2 → ℝ) + y 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
        funext i; fin_cases i <;> simp
      conv_lhs => rw [hy]
      simp only [map_add, map_smul, smul_eq_mul, smthGrad]
    have hfd : ContDiffOn ℝ k (fderiv ℝ u) S := by
      refine contDiffOn_clm_apply.mpr ?_
      intro y
      refine ContDiffOn.congr (f := fun x => y 0 * smthGrad u x 0 + y 1 * smthGrad u x 1)
        ((contDiffOn_const.mul (hpar 0)).add (contDiffOn_const.mul (hpar 1))) ?_
      intro x _
      exact hlin x y
    have hdiff : DifferentiableOn ℝ u S := fun x hx => (hd x hx).differentiableWithinAt
    rw [Nat.cast_succ]
    exact (contDiffOn_succ_iff_fderiv_of_isOpen hS).mpr
      ⟨hdiff, fun h => absurd h (WithTop.natCast_ne_top k), hfd⟩

theorem smth_holC_algebra (k : ℕ) (u w : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (c : ℝ) (hu : smthHolC k u S) (hw : smthHolC k w S) : smthHolC k (fun _ => c) S ∧ smthHolC k (fun x => u x + w x) S ∧ smthHolC k (fun x => u x * w x) S :=
by
  
  have hcongr : ∀ (n : ℕ) (f g : (Fin 2 → ℝ) → ℝ), (∀ x ∈ S, f x = g x) →
      smthHolC n f S → smthHolC n g S := by
    intro n
    induction n with
    | zero =>
      intro f g hfg hf
      refine ⟨hf.1.congr (fun x hx => (hfg x hx).symm), fun x₀ hx₀ => ?_⟩
      obtain ⟨ρ, C, α, hρ, hα, hsub, hH⟩ := hf.2 x₀ hx₀
      refine ⟨ρ, C, α, hρ, hα, hsub, ?_⟩
      intro x hx y hy
      rw [← hfg x (hsub hx), ← hfg y (hsub hy)]
      exact hH x hx y hy
    | succ n ih =>
      intro f g hfg hf
      have hev : ∀ x ∈ S, f =ᶠ[𝓝 x] g := fun x hx =>
        Filter.eventually_of_mem (hS.mem_nhds hx) hfg
      refine ⟨fun x hx => (hf.1 x hx).congr_of_eventuallyEq (hev x hx).symm, fun m => ?_⟩
      refine ih _ _ (fun x hx => ?_) (hf.2 m)
      simp only [smthGrad]
      rw [(hev x hx).fderiv_eq]
  
  have hconst : ∀ (n : ℕ) (c : ℝ), smthHolC n (fun _ => c) S := by
    intro n
    induction n with
    | zero =>
      intro c
      refine ⟨continuousOn_const, fun x₀ hx₀ => ?_⟩
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hS x₀ hx₀
      refine ⟨ε, 0, 1, hε, one_pos, hball, ?_⟩
      intro x _ y _
      simp
    | succ n ih =>
      intro c
      refine ⟨fun x _ => differentiableAt_const c, fun m => ?_⟩
      have h0 : (fun x => smthGrad (fun _ => c) x m) = fun _ => (0 : ℝ) := by
        funext x
        simp [smthGrad]
      rw [h0]
      exact ih 0
  
  have hgrad : ∀ (f g : (Fin 2 → ℝ) → ℝ) (x : Fin 2 → ℝ) (m : Fin 2),
      DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      smthGrad (fun y => f y + g y) x m = smthGrad f x m + smthGrad g x m ∧
      smthGrad (fun y => f y * g y) x m = smthGrad f x m * g x + f x * smthGrad g x m := by
    intro f g x m hf hg
    simp only [smthGrad]
    constructor
    · rw [fderiv_fun_add hf hg, ContinuousLinearMap.add_apply]
    · rw [fderiv_fun_mul hf hg, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
      ring
  
  have mk : ∀ (h : (Fin 2 → ℝ) → ℝ) (A : Set (Fin 2 → ℝ)) (K : ℝ) (β : NNReal), 0 ≤ K →
      (∀ x ∈ A, ∀ y ∈ A, |h x - h y| ≤ K * dist x y ^ (β : ℝ)) →
      HolderOnWith (Real.toNNReal K) β h A := by
    intro h A K β hK hb
    intro x hx y hy
    calc edist (h x) (h y) = ENNReal.ofReal |h x - h y| := by rw [edist_dist, Real.dist_eq]
      _ ≤ ENNReal.ofReal (K * dist x y ^ (β : ℝ)) := ENNReal.ofReal_le_ofReal (hb x hx y hy)
      _ = ENNReal.ofReal K * ENNReal.ofReal (dist x y ^ (β : ℝ)) := ENNReal.ofReal_mul hK
      _ = ((Real.toNNReal K : NNReal) : ENNReal) * edist x y ^ (β : ℝ) := by
        rw [edist_dist, ENNReal.ofReal_rpow_of_nonneg (dist_nonneg (x := x) (y := y))
          (NNReal.coe_nonneg β)]
        rfl
  
  have hbase : ∀ f g : (Fin 2 → ℝ) → ℝ, smthHolC 0 f S → smthHolC 0 g S →
      smthHolC 0 (fun x => f x + g x) S ∧ smthHolC 0 (fun x => f x * g x) S := by
    intro f g hf hg
    have loc : ∀ x₀ ∈ S, ∃ (ρ : ℝ) (C₁ C₂ β : NNReal), 0 < ρ ∧ 0 < β ∧
        Metric.ball x₀ ρ ⊆ S ∧
        ∀ x ∈ Metric.ball x₀ ρ, ∀ y ∈ Metric.ball x₀ ρ,
          |f x - f y| ≤ C₁ * dist x y ^ (β : ℝ) ∧ |g x - g y| ≤ C₂ * dist x y ^ (β : ℝ) ∧
          dist x y ^ (β : ℝ) ≤ 1 := by
      intro x₀ hx₀
      obtain ⟨ρ₁, C₁, α₁, hρ₁, hα₁, hsub₁, hH₁⟩ := hf.2 x₀ hx₀
      obtain ⟨ρ₂, C₂, α₂, hρ₂, hα₂, hsub₂, hH₂⟩ := hg.2 x₀ hx₀
      have hρ : 0 < min (min ρ₁ ρ₂) (1 / 2) := lt_min (lt_min hρ₁ hρ₂) (by norm_num)
      have hB1 : Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)) ⊆ Metric.ball x₀ ρ₁ :=
        Metric.ball_subset_ball (le_trans (min_le_left _ _) (min_le_left _ _))
      have hB2 : Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)) ⊆ Metric.ball x₀ ρ₂ :=
        Metric.ball_subset_ball (le_trans (min_le_left _ _) (min_le_right _ _))
      have hdist : ∀ x ∈ Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)),
          ∀ y ∈ Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)), dist x y ≤ 1 := by
        intro x hx y hy
        rw [Metric.mem_ball] at hx hy
        have h1 := dist_triangle x x₀ y
        rw [dist_comm x₀ y] at h1
        have : min (min ρ₁ ρ₂) (1 / 2) ≤ 1 / 2 := min_le_right _ _
        linarith
      have hD : ∀ x ∈ Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)),
          ∀ y ∈ Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2)), edist x y ≤ ((1 : NNReal) : ENNReal) := by
        intro x hx y hy
        rw [edist_dist, ENNReal.coe_one]
        exact ENNReal.ofReal_le_one.mpr (hdist x hx y hy)
      have hH₁' := HolderOnWith.of_le hD (hH₁.mono hB1) (min_le_left α₁ α₂)
      have hH₂' := HolderOnWith.of_le hD (hH₂.mono hB2) (min_le_right α₁ α₂)
      obtain ⟨C₁', hH₁''⟩ : ∃ C : NNReal, HolderOnWith C (min α₁ α₂) f
          (Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2))) := ⟨_, hH₁'⟩
      obtain ⟨C₂', hH₂''⟩ : ∃ C : NNReal, HolderOnWith C (min α₁ α₂) g
          (Metric.ball x₀ (min (min ρ₁ ρ₂) (1 / 2))) := ⟨_, hH₂'⟩
      refine ⟨min (min ρ₁ ρ₂) (1 / 2), C₁', C₂', min α₁ α₂, hρ, lt_min hα₁ hα₂, hB1.trans hsub₁,
        fun x hx y hy => ⟨?_, ?_, ?_⟩⟩
      · rw [← Real.dist_eq]; exact hH₁''.dist_le hx hy
      · rw [← Real.dist_eq]; exact hH₂''.dist_le hx hy
      · exact Real.rpow_le_one dist_nonneg (hdist x hx y hy) (NNReal.coe_nonneg _)
    refine ⟨⟨hf.1.add hg.1, fun x₀ hx₀ => ?_⟩, ⟨hf.1.mul hg.1, fun x₀ hx₀ => ?_⟩⟩
    · obtain ⟨ρ, C₁, C₂, β, hρ, hβ, hsub, hb⟩ := loc x₀ hx₀
      refine ⟨ρ, _, β, hρ, hβ, hsub, mk _ _ ((C₁ : ℝ) + C₂) β (by positivity) ?_⟩
      intro x hx y hy
      show |(f x + g x) - (f y + g y)| ≤ _
      obtain ⟨h1, h2, -⟩ := hb x hx y hy
      have e : (f x + g x) - (f y + g y) = (f x - f y) + (g x - g y) := by ring
      rw [e]
      calc |(f x - f y) + (g x - g y)| ≤ |f x - f y| + |g x - g y| := abs_add_le _ _
        _ ≤ C₁ * dist x y ^ (β : ℝ) + C₂ * dist x y ^ (β : ℝ) := add_le_add h1 h2
        _ = ((C₁ : ℝ) + C₂) * dist x y ^ (β : ℝ) := by ring
    · obtain ⟨ρ, C₁, C₂, β, hρ, hβ, hsub, hb⟩ := loc x₀ hx₀
      have hx₀B : x₀ ∈ Metric.ball x₀ ρ := Metric.mem_ball_self hρ
      have bf : ∀ z ∈ Metric.ball x₀ ρ, |f z| ≤ |f x₀| + C₁ := by
        intro z hz
        obtain ⟨h1, -, h3⟩ := hb z hz x₀ hx₀B
        have h4 : |f z - f x₀| ≤ C₁ :=
          le_trans h1 (mul_le_of_le_one_right (NNReal.coe_nonneg _) h3)
        have h5 := abs_sub_abs_le_abs_sub (f z) (f x₀)
        linarith
      have bg : ∀ z ∈ Metric.ball x₀ ρ, |g z| ≤ |g x₀| + C₂ := by
        intro z hz
        obtain ⟨-, h2, h3⟩ := hb z hz x₀ hx₀B
        have h4 : |g z - g x₀| ≤ C₂ :=
          le_trans h2 (mul_le_of_le_one_right (NNReal.coe_nonneg _) h3)
        have h5 := abs_sub_abs_le_abs_sub (g z) (g x₀)
        linarith
      refine ⟨ρ, _, β, hρ, hβ, hsub,
        mk _ _ ((C₁ : ℝ) * (|g x₀| + C₂) + (|f x₀| + C₁) * C₂) β (by positivity) ?_⟩
      intro x hx y hy
      show |f x * g x - f y * g y| ≤ _
      obtain ⟨h1, h2, -⟩ := hb x hx y hy
      have hδ : 0 ≤ dist x y ^ (β : ℝ) := Real.rpow_nonneg dist_nonneg _
      have bgx := bg x hx
      have bfy := bf y hy
      have e : f x * g x - f y * g y = (f x - f y) * g x + f y * (g x - g y) := by ring
      rw [e]
      calc |(f x - f y) * g x + f y * (g x - g y)|
          ≤ |(f x - f y) * g x| + |f y * (g x - g y)| := abs_add_le _ _
        _ = |f x - f y| * |g x| + |f y| * |g x - g y| := by rw [abs_mul, abs_mul]
        _ ≤ ((C₁ : ℝ) * dist x y ^ (β : ℝ)) * (|g x₀| + C₂) +
              (|f x₀| + C₁) * ((C₂ : ℝ) * dist x y ^ (β : ℝ)) :=
            add_le_add (mul_le_mul h1 bgx (abs_nonneg _) (by positivity))
              (mul_le_mul bfy h2 (abs_nonneg _) (by positivity))
        _ = ((C₁ : ℝ) * (|g x₀| + C₂) + (|f x₀| + C₁) * C₂) * dist x y ^ (β : ℝ) := by ring
  
  have hmono : ∀ (n : ℕ) (f : (Fin 2 → ℝ) → ℝ), smthHolC (n + 1) f S → smthHolC n f S := by
    intro n
    induction n with
    | zero =>
      intro f hf
      obtain ⟨hd, hg⟩ := hf
      refine ⟨fun x hx => (hd x hx).continuousAt.continuousWithinAt, fun x₀ hx₀ => ?_⟩
      have hev : ∀ m : Fin 2, ∀ᶠ x in 𝓝 x₀, |smthGrad f x m| ≤ |smthGrad f x₀ m| + 1 := by
        intro m
        have hc : ContinuousAt (fun x => smthGrad f x m) x₀ :=
          (hg m).1.continuousAt (hS.mem_nhds hx₀)
        filter_upwards [hc.eventually (Metric.ball_mem_nhds _ one_pos)] with x hx
        rw [Real.dist_eq] at hx
        have := abs_sub_abs_le_abs_sub (smthGrad f x m) (smthGrad f x₀ m)
        linarith
      obtain ⟨ρ, hρ, hball⟩ :=
        Metric.eventually_nhds_iff_ball.mp ((hev 0).and ((hev 1).and (hS.mem_nhds hx₀)))
      have hB0 : 0 ≤ (|smthGrad f x₀ 0| + 1) + (|smthGrad f x₀ 1| + 1) := by positivity
      have hnorm : ∀ x ∈ Metric.ball x₀ ρ,
          ‖fderiv ℝ f x‖ ≤ (|smthGrad f x₀ 0| + 1) + (|smthGrad f x₀ 1| + 1) := by
        intro x hx
        obtain ⟨h0, h1, -⟩ := hball x hx
        refine ContinuousLinearMap.opNorm_le_bound _ hB0 (fun v => ?_)
        have hv : v = v 0 • (Pi.single 0 1 : Fin 2 → ℝ) + v 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
          funext i
          fin_cases i <;> simp
        have hval : fderiv ℝ f x v = v 0 * smthGrad f x 0 + v 1 * smthGrad f x 1 := by
          conv_lhs => rw [hv]
          rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
          rfl
        have hv0 : |v 0| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 0
        have hv1 : |v 1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 1
        rw [hval, Real.norm_eq_abs]
        calc |v 0 * smthGrad f x 0 + v 1 * smthGrad f x 1|
            ≤ |v 0 * smthGrad f x 0| + |v 1 * smthGrad f x 1| := abs_add_le _ _
          _ = |v 0| * |smthGrad f x 0| + |v 1| * |smthGrad f x 1| := by rw [abs_mul, abs_mul]
          _ ≤ ‖v‖ * (|smthGrad f x₀ 0| + 1) + ‖v‖ * (|smthGrad f x₀ 1| + 1) :=
            add_le_add (mul_le_mul hv0 h0 (abs_nonneg _) (norm_nonneg _))
              (mul_le_mul hv1 h1 (abs_nonneg _) (norm_nonneg _))
          _ = ((|smthGrad f x₀ 0| + 1) + (|smthGrad f x₀ 1| + 1)) * ‖v‖ := by ring
      have hlip : LipschitzOnWith (Real.toNNReal ((|smthGrad f x₀ 0| + 1) + (|smthGrad f x₀ 1| + 1)))
          f (Metric.ball x₀ ρ) := by
        refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (𝕜 := ℝ)
          (fun x hx => hd x (hball x hx).2.2) (fun x hx => ?_) (convex_ball x₀ ρ)
        rw [← NNReal.coe_le_coe, coe_nnnorm, Real.coe_toNNReal _ hB0]
        exact hnorm x hx
      exact ⟨ρ, _, 1, hρ, one_pos, fun x hx => (hball x hx).2.2, hlip.holderOnWith⟩
    | succ n ih =>
      intro f hf
      exact ⟨hf.1, fun m => ih _ (hf.2 m)⟩
  
  have hP : ∀ n : ℕ, ∀ f g : (Fin 2 → ℝ) → ℝ, smthHolC n f S → smthHolC n g S →
      smthHolC n (fun x => f x + g x) S ∧ smthHolC n (fun x => f x * g x) S := by
    intro n
    induction n with
    | zero => exact hbase
    | succ n ih =>
      intro f g hf hg
      have hf' := hmono n f hf
      have hg' := hmono n g hg
      refine ⟨⟨fun x hx => (hf.1 x hx).fun_add (hg.1 x hx), fun m => ?_⟩,
        ⟨fun x hx => (hf.1 x hx).fun_mul (hg.1 x hx), fun m => ?_⟩⟩
      · refine hcongr n (fun x => smthGrad f x m + smthGrad g x m) _
          (fun x hx => ((hgrad f g x m (hf.1 x hx) (hg.1 x hx)).1).symm) ?_
        exact (ih _ _ (hf.2 m) (hg.2 m)).1
      · refine hcongr n (fun x => smthGrad f x m * g x + f x * smthGrad g x m) _
          (fun x hx => ((hgrad f g x m (hf.1 x hx) (hg.1 x hx)).2).symm) ?_
        exact (ih _ _ (ih _ _ (hf.2 m) hg').2 (ih _ _ hf' (hg.2 m)).2).1
  exact ⟨hconst k c, (hP k u w hu hw).1, (hP k u w hu hw).2⟩

theorem smth_holC_comp (Ψ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΨ : ContDiffOn ℝ ∞ Ψ O) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (v : (Fin 2 → ℝ) → ℝ) (k : ℕ) (hv : smthHolC (k + 1) v S) (hvO : ∀ x ∈ S, (x, v x, smthGrad v x) ∈ O) : smthHolC k (fun x => Ψ (x, v x, smthGrad v x)) S :=
by
  have hinf0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  have congr : ∀ (n : ℕ) (f g : (Fin 2 → ℝ) → ℝ), (∀ x ∈ S, f x = g x) →
      smthHolC n f S → smthHolC n g S := by
    intro n
    induction n with
    | zero =>
      intro f g hfg hf
      refine ⟨hf.1.congr (fun x hx => (hfg x hx).symm), ?_⟩
      intro x₀ hx₀
      obtain ⟨ρ, C, α, hρ, hα, hsub, hH⟩ := hf.2 x₀ hx₀
      refine ⟨ρ, C, α, hρ, hα, hsub, ?_⟩
      intro x hx y hy
      rw [← hfg x (hsub hx), ← hfg y (hsub hy)]
      exact hH x hx y hy
    | succ n ih =>
      intro f g hfg hf
      have hev : ∀ x ∈ S, g =ᶠ[nhds x] f := fun x hx =>
        Filter.eventually_of_mem (hS.mem_nhds hx) (fun y hy => (hfg y hy).symm)
      refine ⟨fun x hx => (hf.1 x hx).congr_of_eventuallyEq (hev x hx), fun m => ?_⟩
      refine ih _ _ (fun x hx => ?_) (hf.2 m)
      simp only [smthGrad]
      rw [(hev x hx).fderiv_eq]
  
  have base : ∀ Ψ' : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ Ψ' O →
      smthHolC 1 v S → smthHolC 0 (fun x => Ψ' (x, v x, smthGrad v x)) S := by
    intro Ψ' hΨ' hv1
    have hXat : ∀ x ∈ S, ContinuousAt (fun y => (y, v y, smthGrad v y)) x := by
      intro x hx
      refine continuousAt_id.prodMk ((hv1.1 x hx).continuousAt.prodMk ?_)
      exact continuousAt_pi.2 fun j => (hv1.2 j).1.continuousAt (hS.mem_nhds hx)
    refine ⟨hΨ'.continuousOn.comp (fun x hx => (hXat x hx).continuousWithinAt)
      (fun x hx => hvO x hx), ?_⟩
    intro x₀ hx₀
    have h0 : smthHolC 0 v S := smth_holC_mono 0 v S hS hv1
    obtain ⟨ρv, Cv, αv, hρv, hαv, hsubv, hHv⟩ := h0.2 x₀ hx₀
    obtain ⟨ρ0, C0, α0, hρ0, hα0, hsub0, hH0⟩ := (hv1.2 0).2 x₀ hx₀
    obtain ⟨ρ1, C1, α1, hρ1, hα1, hsub1, hH1⟩ := (hv1.2 1).2 x₀ hx₀
    obtain ⟨ε, hε, hεO⟩ := Metric.isOpen_iff.1 hO _ (hvO x₀ hx₀)
    have hKO : Metric.closedBall ((x₀, v x₀, smthGrad v x₀) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        (ε / 2) ⊆ O :=
      (Metric.closedBall_subset_ball (half_lt_self hε)).trans hεO
    obtain ⟨L, hL⟩ := (hΨ'.mono hKO).exists_lipschitzOnWith hinf0 (convex_closedBall _ _)
      (isCompact_closedBall _ _)
    obtain ⟨δ, hδ, hδX⟩ := Metric.continuousAt_iff.1 (hXat x₀ hx₀) (ε / 2) (half_pos hε)
    set ρ : ℝ := min (min (min ρv ρ0) (min ρ1 δ)) (1 / 2) with hρdef
    have hρ : 0 < ρ := lt_min (lt_min (lt_min hρv hρ0) (lt_min hρ1 hδ)) (by norm_num)
    have hρv' : ρ ≤ ρv := (min_le_left _ _).trans ((min_le_left _ _).trans (min_le_left _ _))
    have hρ0' : ρ ≤ ρ0 := (min_le_left _ _).trans ((min_le_left _ _).trans (min_le_right _ _))
    have hρ1' : ρ ≤ ρ1 := (min_le_left _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
    have hρδ : ρ ≤ δ := (min_le_left _ _).trans ((min_le_right _ _).trans (min_le_right _ _))
    have hρh : ρ ≤ 1 / 2 := min_le_right _ _
    have hBv : Metric.ball x₀ ρ ⊆ Metric.ball x₀ ρv := Metric.ball_subset_ball hρv'
    have hB0 : Metric.ball x₀ ρ ⊆ Metric.ball x₀ ρ0 := Metric.ball_subset_ball hρ0'
    have hB1 : Metric.ball x₀ ρ ⊆ Metric.ball x₀ ρ1 := Metric.ball_subset_ball hρ1'
    set β : NNReal := min (min αv α0) (min α1 1) with hβdef
    have hβ : 0 < β := lt_min (lt_min hαv hα0) (lt_min hα1 one_pos)
    have hβv : β ≤ αv := (min_le_left _ _).trans (min_le_left _ _)
    have hβ0 : β ≤ α0 := (min_le_left _ _).trans (min_le_right _ _)
    have hβ1 : β ≤ α1 := (min_le_right _ _).trans (min_le_left _ _)
    have hβone : β ≤ 1 := (min_le_right _ _).trans (min_le_right _ _)
    set Cm : NNReal := max (max 1 Cv) (max C0 C1) with hCmdef
    have hCm1 : (1 : NNReal) ≤ Cm := (le_max_left _ _).trans (le_max_left _ _)
    have hCmv : Cv ≤ Cm := (le_max_right _ _).trans (le_max_left _ _)
    have hCm0 : C0 ≤ Cm := (le_max_left _ _).trans (le_max_right _ _)
    have hCm1' : C1 ≤ Cm := (le_max_right _ _).trans (le_max_right _ _)
    have hd : ∀ x ∈ Metric.ball x₀ ρ, ∀ y ∈ Metric.ball x₀ ρ, edist x y ≤ 1 := by
      intro x hx y hy
      rw [edist_dist]
      apply ENNReal.ofReal_le_one.2
      have h1 := Metric.mem_ball.1 hx
      have h2 := Metric.mem_ball.1 hy
      have h3 := dist_triangle_right x y x₀
      linarith
    have hpow : ∀ (d : ENNReal) (a C : NNReal), d ≤ 1 → β ≤ a → C ≤ Cm →
        (C : ENNReal) * d ^ (a : ℝ) ≤ (Cm : ENNReal) * d ^ (β : ℝ) := by
      intro d a C hd1 hβa hC
      calc (C : ENNReal) * d ^ (a : ℝ) ≤ (C : ENNReal) * d ^ (β : ℝ) :=
            mul_le_mul_left' (ENNReal.rpow_le_rpow_of_exponent_ge hd1 (by exact_mod_cast hβa)) _
        _ ≤ (Cm : ENNReal) * d ^ (β : ℝ) := mul_le_mul_right' (by exact_mod_cast hC) _
    have hXH : HolderOnWith Cm β (fun x => (x, v x, smthGrad v x)) (Metric.ball x₀ ρ) := by
      intro x hx y hy
      have hd1 := hd x hx y hy
      simp only [Prod.edist_eq]
      refine max_le ?_ (max_le ?_ ?_)
      · calc edist x y = ((1 : NNReal) : ENNReal) * edist x y ^ ((1 : NNReal) : ℝ) := by simp
          _ ≤ _ := hpow _ 1 1 hd1 hβone hCm1
      · exact (hHv x (hBv hx) y (hBv hy)).trans (hpow _ _ _ hd1 hβv hCmv)
      · refine edist_pi_le_iff.2 (fun j => ?_)
        fin_cases j
        · exact (hH0 x (hB0 hx) y (hB0 hy)).trans (hpow _ _ _ hd1 hβ0 hCm0)
        · exact (hH1 x (hB1 hx) y (hB1 hy)).trans (hpow _ _ _ hd1 hβ1 hCm1')
    have hmaps : Set.MapsTo (fun x => (x, v x, smthGrad v x)) (Metric.ball x₀ ρ)
        (Metric.closedBall (x₀, v x₀, smthGrad v x₀) (ε / 2)) := by
      intro x hx
      exact Metric.mem_closedBall.2
        (le_of_lt (hδX (lt_of_lt_of_le (Metric.mem_ball.1 hx) hρδ)))
    have hcomp := hL.holderOnWith.comp hXH hmaps
    refine ⟨ρ, _, _, hρ, ?_, hBv.trans hsubv, hcomp⟩
    rw [one_mul]
    exact hβ
  
  have H : ∀ n : ℕ, ∀ Ψ' : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ, ContDiffOn ℝ ∞ Ψ' O →
      smthHolC (n + 1) v S → smthHolC n (fun x => Ψ' (x, v x, smthGrad v x)) S := by
    intro n
    induction n with
    | zero => exact base
    | succ n ih =>
      intro Ψ' hΨ' hv2
      have hv' : smthHolC (n + 1) v S := smth_holC_mono (n + 1) v S hS hv2
      have hΨ1 : ContDiffOn ℝ ∞ (fderiv ℝ Ψ') O := hΨ'.fderiv_of_isOpen hO le_rfl
      have IH : ∀ c : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
          smthHolC n (fun x => fderiv ℝ Ψ' (x, v x, smthGrad v x) c) S :=
        fun c => ih _ (hΨ1.clm_apply contDiffOn_const) hv'
      have hgm : ∀ m : Fin 2, smthHolC n (fun x => smthGrad v x m) S :=
        fun m => smth_holC_mono n _ S hS (hv2.2 m)
      have hjm : ∀ j m : Fin 2,
          smthHolC n (fun x => smthGrad (fun y => smthGrad v y j) x m) S :=
        fun j m => (hv2.2 j).2 m
      have hdec : ∀ (a : Fin 2 → ℝ) (t : ℝ) (p : Fin 2 → ℝ),
          ((a, t, p) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
            (a, (0 : ℝ), (0 : Fin 2 → ℝ)) + t • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) +
              (p 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
                p 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
        intro a t p
        refine Prod.ext ?_ (Prod.ext ?_ ?_)
        · funext i; simp
        · simp
        · funext i; fin_cases i <;> simp
      
      have chain : ∀ x ∈ S, ∀ m : Fin 2,
          DifferentiableAt ℝ (fun y => Ψ' (y, v y, smthGrad v y)) x ∧
          smthGrad (fun y => Ψ' (y, v y, smthGrad v y)) x m =
            fderiv ℝ Ψ' (x, v x, smthGrad v x) (Pi.single m 1, 0, 0) +
            smthGrad v x m * fderiv ℝ Ψ' (x, v x, smthGrad v x) (0, 1, 0) +
            (smthGrad (fun y => smthGrad v y 0) x m *
                fderiv ℝ Ψ' (x, v x, smthGrad v x) (0, 0, Pi.single 0 1) +
              smthGrad (fun y => smthGrad v y 1) x m *
                fderiv ℝ Ψ' (x, v x, smthGrad v x) (0, 0, Pi.single 1 1)) := by
        intro x hx m
        have hdΨ : DifferentiableAt ℝ Ψ' (x, v x, smthGrad v x) :=
          (hΨ'.differentiableOn hinf0).differentiableAt (hO.mem_nhds (hvO x hx))
        have hXd : HasFDerivAt (fun y => (y, v y, smthGrad v y))
            ((ContinuousLinearMap.id ℝ (Fin 2 → ℝ)).prod ((fderiv ℝ v x).prod
              (ContinuousLinearMap.pi fun j => fderiv ℝ (fun y => smthGrad v y j) x))) x := by
          refine (hasFDerivAt_id x).prodMk ((hv2.1 x hx).hasFDerivAt.prodMk ?_)
          exact (hasFDerivAt_pi (φ := fun j y => smthGrad v y j)).2
            fun j => ((hv2.2 j).1 x hx).hasFDerivAt
        have hg := hdΨ.hasFDerivAt.comp x hXd
        refine ⟨hg.differentiableAt, ?_⟩
        show fderiv ℝ (Ψ' ∘ (fun y => (y, v y, smthGrad v y))) x (Pi.single m 1) = _
        rw [hg.fderiv]
        simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
          ContinuousLinearMap.id_apply, ContinuousLinearMap.pi_apply]
        rw [hdec (Pi.single m 1) _ _]
        simp only [map_add, map_smul, smul_eq_mul]
        simp only [smthGrad]
        rfl
      refine ⟨fun x hx => (chain x hx 0).1, fun m => ?_⟩
      have T2 := (smth_holC_algebra n _ _ S hS 0 (hgm m) (IH (0, 1, 0))).2.2
      have T30 := (smth_holC_algebra n _ _ S hS 0 (hjm 0 m) (IH (0, 0, Pi.single 0 1))).2.2
      have T31 := (smth_holC_algebra n _ _ S hS 0 (hjm 1 m) (IH (0, 0, Pi.single 1 1))).2.2
      have T12 := (smth_holC_algebra n _ _ S hS 0 (IH (Pi.single m 1, 0, 0)) T2).2.1
      have T3 := (smth_holC_algebra n _ _ S hS 0 T30 T31).2.1
      have T := (smth_holC_algebra n _ _ S hS 0 T12 T3).2.1
      refine congr n _ _ (fun x hx => ?_) T
      beta_reduce
      rw [(chain x hx m).2]
  exact H k Ψ hΨ hv

theorem smth_dq_limit (u : (Fin 2 → ℝ) → ℝ) (y : Fin 2 → ℝ) (r h₀ : ℝ) (hr : 0 < r) (hh₀ : 0 < h₀) (hu : ContDiffOn ℝ 1 u (Metric.ball y (r + h₀))) (m : Fin 2) (M α : NNReal) (hα : 0 < α) (hdq : ∀ h : ℝ, 0 < |h| → |h| < h₀ → HolderOnWith M α (smthGrad (smthDQ u m h)) (Metric.ball y r) ∧ ∀ x ∈ Metric.ball y r, ‖smthGrad (smthDQ u m h) x‖ ≤ (M : ℝ)) : ContDiffOn ℝ 1 (fun x => smthGrad u x m) (Metric.ball y r) ∧ HolderOnWith M α (smthGrad (fun x => smthGrad u x m)) (Metric.ball y r) :=
by
  
  have hdec : ∀ (L : (Fin 2 → ℝ) →L[ℝ] ℝ) (v : Fin 2 → ℝ),
      L v = ∑ j : Fin 2, v j * L (Pi.single j 1) := by
    intro L v
    have hv : v = v 0 • (Pi.single 0 1 : Fin 2 → ℝ) + v 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
      funext i; fin_cases i <;> simp
    conv_lhs => rw [hv]
    simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_two]
  
  have taylor : ∀ (f : (Fin 2 → ℝ) → ℝ) (B : Set (Fin 2 → ℝ)), Convex ℝ B →
      (∀ x ∈ B, DifferentiableAt ℝ f x) → HolderOnWith M α (smthGrad f) B →
      ∀ x ∈ B, ∀ z ∈ B, |f z - f x - ∑ j : Fin 2, smthGrad f x j * (z - x) j| ≤
        2 * (M : ℝ) * ‖z - x‖ ^ (α : ℝ) * ‖z - x‖ := by
    intro f B hB hf hH x hx z hz
    set ρ := ‖z - x‖ with hρ
    have hS : Convex ℝ (B ∩ closedBall x ρ) := hB.inter (convex_closedBall x ρ)
    have hxS : x ∈ B ∩ closedBall x ρ := ⟨hx, mem_closedBall_self (norm_nonneg _)⟩
    have hzS : z ∈ B ∩ closedBall x ρ := ⟨hz, by rw [mem_closedBall, dist_eq_norm]⟩
    have hbound : ∀ p ∈ B ∩ closedBall x ρ,
        ‖fderiv ℝ f p - fderiv ℝ f x‖ ≤ 2 * (M : ℝ) * ρ ^ (α : ℝ) := by
      intro p hp
      have hc : dist (smthGrad f p) (smthGrad f x) ≤ M * dist p x ^ (α : ℝ) := hH.dist_le hp.1 hx
      have hpx : dist p x ≤ ρ := hp.2
      have hpow : dist p x ^ (α : ℝ) ≤ ρ ^ (α : ℝ) := Real.rpow_le_rpow dist_nonneg hpx α.2
      have hc' : ‖smthGrad f p - smthGrad f x‖ ≤ M * ρ ^ (α : ℝ) := by
        rw [← dist_eq_norm]; exact hc.trans (mul_le_mul_of_nonneg_left hpow M.2)
      have hρα : 0 ≤ ρ ^ (α : ℝ) := Real.rpow_nonneg (norm_nonneg _) _
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) ?_
      intro v
      rw [hdec, Real.norm_eq_abs]
      have hj : ∀ j, (fderiv ℝ f p - fderiv ℝ f x) (Pi.single j 1) =
          (smthGrad f p - smthGrad f x) j := by
        intro j; simp [smthGrad]
      simp only [hj, Fin.sum_univ_two]
      set c := smthGrad f p - smthGrad f x
      have h0 : |v 0| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 0
      have h1 : |v 1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 1
      have k0 : |c 0| ≤ ‖c‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm c 0
      have k1 : |c 1| ≤ ‖c‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm c 1
      calc |v 0 * c 0 + v 1 * c 1| ≤ |v 0 * c 0| + |v 1 * c 1| := abs_add_le _ _
        _ = |v 0| * |c 0| + |v 1| * |c 1| := by rw [abs_mul, abs_mul]
        _ ≤ ‖v‖ * ‖c‖ + ‖v‖ * ‖c‖ :=
            add_le_add (mul_le_mul h0 k0 (abs_nonneg _) (norm_nonneg _))
              (mul_le_mul h1 k1 (abs_nonneg _) (norm_nonneg _))
        _ = 2 * ‖c‖ * ‖v‖ := by ring
        _ ≤ 2 * (M * ρ ^ (α : ℝ)) * ‖v‖ := by
            apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
            linarith
        _ = 2 * (M : ℝ) * ρ ^ (α : ℝ) * ‖v‖ := by ring
    have hmvt := hS.norm_image_sub_le_of_norm_fderiv_le' (fun p hp => hf p hp.1) hbound hxS hzS
    have hsum : ∑ j : Fin 2, smthGrad f x j * (z - x) j = fderiv ℝ f x (z - x) := by
      rw [hdec (fderiv ℝ f x) (z - x)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [smthGrad]; ring
    rw [hsum, ← Real.norm_eq_abs]
    exact hmvt
  
  have tlim : ∀ (B : Set (Fin 2 → ℝ)), IsOpen B → ∀ x ∈ B, ∀ (f : ℕ → (Fin 2 → ℝ) → ℝ)
      (a : ℕ → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (L : Fin 2 → ℝ) (C β : ℝ), 0 < β →
      (∀ n : ℕ, ∀ z ∈ B, |f n z - f n x - ∑ j : Fin 2, a n j * (z - x) j| ≤
        C * ‖z - x‖ ^ β * ‖z - x‖) →
      (∀ z ∈ B, Tendsto (fun n => f n z) atTop (𝓝 (w z))) →
      Tendsto a atTop (𝓝 L) → DifferentiableAt ℝ w x ∧ smthGrad w x = L := by
    intro B hB x hx f a w L C β hβ hT hf ha
    have hTinf : ∀ z ∈ B, |w z - w x - ∑ j : Fin 2, L j * (z - x) j| ≤
        C * ‖z - x‖ ^ β * ‖z - x‖ := by
      intro z hz
      have hcoord : ∀ j : Fin 2, Tendsto (fun n => a n j) atTop (𝓝 (L j)) :=
        fun j => tendsto_pi_nhds.1 ha j
      have hlim : Tendsto (fun n => |f n z - f n x - ∑ j : Fin 2, a n j * (z - x) j|) atTop
          (𝓝 |w z - w x - ∑ j : Fin 2, L j * (z - x) j|) := by
        refine (((hf z hz).sub (hf x hx)).sub ?_).abs
        exact tendsto_finset_sum _ (fun j _ => (hcoord j).mul_const _)
      exact le_of_tendsto' hlim (fun n => hT n z hz)
    set ℓ : (Fin 2 → ℝ) →L[ℝ] ℝ :=
      L 0 • ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 0 +
      L 1 • ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Fin 2 => ℝ) 1 with hℓdef
    have hℓ : ∀ v : Fin 2 → ℝ, ℓ v = ∑ j : Fin 2, L j * v j := by
      intro v
      simp [hℓdef, Fin.sum_univ_two]
    have hD : HasFDerivAt w ℓ x := by
      rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
      intro c hc
      have h1 : ∀ᶠ k in 𝓝 (0 : Fin 2 → ℝ), x + k ∈ B := by
        have hcont : Tendsto (fun k : Fin 2 → ℝ => x + k) (𝓝 0) (𝓝 x) := by
          have := (continuous_const.add continuous_id : Continuous fun k : Fin 2 → ℝ => x + k).tendsto 0
          simpa using this
        exact hcont (hB.mem_nhds hx)
      have h2 : ∀ᶠ k in 𝓝 (0 : Fin 2 → ℝ), C * ‖k‖ ^ β < c := by
        have hcont : Tendsto (fun k : Fin 2 → ℝ => C * ‖k‖ ^ β) (𝓝 0) (𝓝 (C * ‖(0 : Fin 2 → ℝ)‖ ^ β)) := by
          refine Tendsto.const_mul C ?_
          exact ((Real.continuousAt_rpow_const _ β (Or.inr hβ.le)).tendsto).comp
            (continuous_norm.tendsto 0)
        rw [norm_zero, Real.zero_rpow hβ.ne', mul_zero] at hcont
        exact hcont.eventually_lt_const hc
      filter_upwards [h1, h2] with k hk1 hk2
      have h := hTinf (x + k) hk1
      simp only [add_sub_cancel_left] at h
      rw [hℓ, Real.norm_eq_abs]
      calc |w (x + k) - w x - ∑ j : Fin 2, L j * k j| ≤ C * ‖k‖ ^ β * ‖k‖ := h
        _ ≤ c * ‖k‖ := mul_le_mul_of_nonneg_right hk2.le (norm_nonneg _)
    refine ⟨hD.differentiableAt, ?_⟩
    funext j
    simp only [smthGrad, hD.fderiv, hℓ]
    fin_cases j <;> simp [Fin.sum_univ_two]
  
  have c1 : ∀ (w : (Fin 2 → ℝ) → ℝ) (B : Set (Fin 2 → ℝ)), IsOpen B →
      (∀ x ∈ B, DifferentiableAt ℝ w x) → HolderOnWith M α (smthGrad w) B →
      ContDiffOn ℝ 1 w B := by
    intro w B hB hd hH
    have hgc : ContinuousOn (smthGrad w) B := hH.continuousOn hα
    have hfc : ContinuousOn (fderiv ℝ w) B := by
      rw [continuousOn_clm_apply]
      intro v
      have e1 : (fun x => fderiv ℝ w x v) = fun x => ∑ j : Fin 2, v j * smthGrad w x j := by
        funext x; rw [hdec]; rfl
      rw [e1]
      refine continuousOn_finset_sum _ (fun j _ => ?_)
      exact continuousOn_const.mul ((continuous_apply j).comp_continuousOn hgc)
    have : ContDiffOn ℝ (0 + 1) w B := by
      rw [contDiffOn_succ_iff_fderiv_of_isOpen hB]
      refine ⟨fun x hx => (hd x hx).differentiableWithinAt, by simp, ?_⟩
      exact contDiffOn_zero.2 hfc
    simpa using this
  
  have hbig : ∀ z ∈ ball y (r + h₀), DifferentiableAt ℝ u z := fun z hz =>
    ((hu.differentiableOn (by norm_num)) z hz).differentiableAt (isOpen_ball.mem_nhds hz)
  set e₀ : Fin 2 → ℝ := Pi.single m (1 : ℝ) with he₀
  have hnorm_e : ‖e₀‖ = 1 := by rw [he₀, Pi.norm_single, norm_one]
  
  have dqd : ∀ h : ℝ, |h| < h₀ → ∀ x ∈ ball y r, DifferentiableAt ℝ (smthDQ u m h) x := by
    intro h hh x hx
    have hx1 : x ∈ ball y (r + h₀) := ball_subset_ball (by linarith) hx
    have hx2 : x + h • e₀ ∈ ball y (r + h₀) := by
      rw [mem_ball] at hx ⊢
      calc dist (x + h • e₀) y ≤ dist (x + h • e₀) x + dist x y := dist_triangle _ _ _
        _ = ‖h • e₀‖ + dist x y := by rw [dist_eq_norm, add_sub_cancel_left]
        _ < h₀ + r := by rw [norm_smul, hnorm_e, mul_one, Real.norm_eq_abs]; linarith
        _ = r + h₀ := by ring
    have hc : DifferentiableAt ℝ (fun z => u (z + h • e₀)) x :=
      (hbig _ hx2).comp x (differentiableAt_id.add_const _)
    have hc2 : DifferentiableAt ℝ (fun z => (u (z + h • e₀) - u z) * h⁻¹) x :=
      (hc.sub (hbig x hx1)).mul_const _
    have e2 : smthDQ u m h = fun z => (u (z + h • e₀) - u z) * h⁻¹ := by
      funext z; simp only [smthDQ, he₀, div_eq_mul_inv]
    rw [e2]; exact hc2
  
  have dqlim : ∀ x, DifferentiableAt ℝ u x → ∀ s : ℕ → ℝ, (∀ n, s n ≠ 0) →
      Tendsto s atTop (𝓝 0) →
      Tendsto (fun n => smthDQ u m (s n) x) atTop (𝓝 (smthGrad u x m)) := by
    intro x hux s hs0 hs
    have hline : HasDerivAt (fun t : ℝ => x + t • e₀) e₀ 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const e₀).const_add x
    have hu' : HasFDerivAt u (fderiv ℝ u x) (x + (0 : ℝ) • e₀) := by
      rw [zero_smul, add_zero]; exact hux.hasFDerivAt
    have hγ : HasDerivAt (fun t : ℝ => u (x + t • e₀)) (fderiv ℝ u x e₀) 0 :=
      hu'.comp_hasDerivAt (0 : ℝ) hline
    have hsl := hγ.tendsto_slope_zero
    have hs' : Tendsto s atTop (𝓝[≠] 0) :=
      tendsto_nhdsWithin_iff.2 ⟨hs, Eventually.of_forall hs0⟩
    have h3 := hsl.comp hs'
    have e3 : smthGrad u x m = fderiv ℝ u x e₀ := rfl
    rw [e3]
    refine h3.congr (fun n => ?_)
    simp only [Function.comp, zero_add, zero_smul, add_zero, smul_eq_mul, smthDQ, he₀]
    rw [div_eq_inv_mul]
  
  set B := ball y r with hBdef
  set w : (Fin 2 → ℝ) → ℝ := fun x => smthGrad u x m with hwdef
  set s : ℕ → ℝ := fun n => h₀ / ((n : ℝ) + 2) with hsdef
  have hspos : ∀ n, 0 < s n := fun n => div_pos hh₀ (by positivity)
  have hslt : ∀ n, s n < h₀ := fun n =>
    div_lt_self hh₀ (by have := n.cast_nonneg (α := ℝ); linarith)
  have habs : ∀ n, |s n| = s n := fun n => abs_of_pos (hspos n)
  have hs0 : Tendsto s atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
  have Hn : ∀ n, HolderOnWith M α (smthGrad (smthDQ u m (s n))) B := fun n =>
    (hdq (s n) (by rw [habs]; exact hspos n) (by rw [habs]; exact hslt n)).1
  have Bn : ∀ n, ∀ x ∈ B, ‖smthGrad (smthDQ u m (s n)) x‖ ≤ M := fun n =>
    (hdq (s n) (by rw [habs]; exact hspos n) (by rw [habs]; exact hslt n)).2
  have Dn : ∀ n, ∀ x ∈ B, DifferentiableAt ℝ (smthDQ u m (s n)) x := fun n =>
    dqd (s n) (by rw [habs]; exact hslt n)
  have Tn : ∀ n, ∀ x ∈ B, ∀ z ∈ B, |smthDQ u m (s n) z - smthDQ u m (s n) x -
      ∑ j : Fin 2, smthGrad (smthDQ u m (s n)) x j * (z - x) j| ≤
        2 * (M : ℝ) * ‖z - x‖ ^ (α : ℝ) * ‖z - x‖ := fun n =>
    taylor _ B (convex_ball y r) (Dn n) (Hn n)
  have Cn : ∀ z ∈ B, Tendsto (fun n => smthDQ u m (s n) z) atTop (𝓝 (w z)) := by
    intro z hz
    exact dqlim z (hbig z (ball_subset_ball (by linarith) hz)) s (fun n => (hspos n).ne') hs0
  have hαpos : (0 : ℝ) < (α : ℝ) := NNReal.coe_pos.2 hα
  have key : ∀ x ∈ B, ∀ x' ∈ B, ∃ φ : ℕ → ℕ, ∃ L L' : Fin 2 → ℝ, StrictMono φ ∧
      DifferentiableAt ℝ w x ∧ smthGrad w x = L ∧ DifferentiableAt ℝ w x' ∧ smthGrad w x' = L' ∧
      Tendsto (fun n => smthGrad (smthDQ u m (s (φ n))) x) atTop (𝓝 L) ∧
      Tendsto (fun n => smthGrad (smthDQ u m (s (φ n))) x') atTop (𝓝 L') := by
    intro x hx x' hx'
    have hP : ∀ n, (smthGrad (smthDQ u m (s n)) x, smthGrad (smthDQ u m (s n)) x') ∈
        closedBall (0 : (Fin 2 → ℝ) × (Fin 2 → ℝ)) M := by
      intro n
      rw [mem_closedBall_zero_iff, Prod.norm_def]
      exact max_le (Bn n x hx) (Bn n x' hx')
    obtain ⟨⟨L, L'⟩, -, φ, hφ, hlim⟩ := tendsto_subseq_of_bounded isBounded_closedBall hP
    have hl1 : Tendsto (fun n => smthGrad (smthDQ u m (s (φ n))) x) atTop (𝓝 L) := hlim.fst_nhds
    have hl2 : Tendsto (fun n => smthGrad (smthDQ u m (s (φ n))) x') atTop (𝓝 L') :=
      hlim.snd_nhds
    obtain ⟨d1, g1⟩ := tlim B isOpen_ball x hx (fun n => smthDQ u m (s (φ n)))
      (fun n => smthGrad (smthDQ u m (s (φ n))) x) w L (2 * M) α hαpos
      (fun n z hz => Tn (φ n) x hx z hz) (fun z hz => (Cn z hz).comp hφ.tendsto_atTop) hl1
    obtain ⟨d2, g2⟩ := tlim B isOpen_ball x' hx' (fun n => smthDQ u m (s (φ n)))
      (fun n => smthGrad (smthDQ u m (s (φ n))) x') w L' (2 * M) α hαpos
      (fun n z hz => Tn (φ n) x' hx' z hz) (fun z hz => (Cn z hz).comp hφ.tendsto_atTop) hl2
    exact ⟨φ, L, L', hφ, d1, g1, d2, g2, hl1, hl2⟩
  have hH : HolderOnWith M α (smthGrad w) B := by
    intro x hx x' hx'
    obtain ⟨φ, L, L', hφ, -, g1, -, g2, hl1, hl2⟩ := key x hx x' hx'
    rw [g1, g2]
    exact le_of_tendsto' (hl1.edist hl2) (fun n => (Hn (φ n)).edist_le hx hx')
  have hd : ∀ x ∈ B, DifferentiableAt ℝ w x := by
    intro x hx
    obtain ⟨φ, L, L', hφ, d1, -⟩ := key x hx x hx
    exact d1
  exact ⟨c1 w B isOpen_ball hd hH, hH⟩

theorem smth_ibp_shift (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (P : (Fin 2 → ℝ) → Fin 2 → ℝ) (Q : (Fin 2 → ℝ) → ℝ) (hP : ∀ i : Fin 2, ContDiffOn ℝ 1 (fun x => P x i) S) (hQ : ContinuousOn Q S) (heq : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S → ∫ x, (∑ i : Fin 2, P x i * smthGrad φ x i + Q x * φ x) = 0) (m : Fin 2) : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S → ∫ x, ∑ i : Fin 2, (smthGrad (fun y => P y i) x m - (if i = m then Q x else 0)) * smthGrad φ x i = 0 :=
by
  
  have s1 : ∀ (g h : (Fin 2 → ℝ) → ℝ), ContinuousOn g S → Continuous h → HasCompactSupport h →
      tsupport h ⊆ S → Integrable (fun x => g x * h x) := by
    intro g h hg hh hhc hhS
    have hcont : Continuous (fun x => g x * h x) := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ S
      · exact (hg.continuousAt (hS.mem_nhds hx)).mul hh.continuousAt
      · have hxt : x ∉ tsupport h := fun h' => hx (hhS h')
        have hev : h =ᶠ[𝓝 x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxt
        have hev2 : (fun y => g y * h y) =ᶠ[𝓝 x] fun _ => (0:ℝ) := by
          filter_upwards [hev] with y hy
          simp [hy]
        exact continuousAt_const.congr hev2.symm
    exact hcont.integrable_of_hasCompactSupport hhc.mul_left
  
  have tsup_grad : ∀ h : (Fin 2 → ℝ) → ℝ, tsupport h ⊆ S → ∀ k : Fin 2,
      tsupport (fun x => smthGrad h x k) ⊆ S := by
    intro h hhS k x hx
    by_contra hxS
    have hxt : x ∉ tsupport (fderiv ℝ h) := fun h' => hxS (hhS (tsupport_fderiv_subset ℝ h'))
    have hev : fderiv ℝ h =ᶠ[𝓝 x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxt
    have hev2 : (fun y => smthGrad h y k) =ᶠ[𝓝 x] 0 := by
      filter_upwards [hev] with y hy
      simp [smthGrad, hy]
    exact (notMem_tsupport_iff_eventuallyEq).2 hev2 hx
  
  have s3 : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S →
      ∀ k : Fin 2, ContDiff ℝ ∞ (fun x => smthGrad φ x k) ∧
        HasCompactSupport (fun x => smthGrad φ x k) ∧ tsupport (fun x => smthGrad φ x k) ⊆ S := by
    intro φ hφ hφc hφS k
    have hd : ContDiff ℝ ∞ (fderiv ℝ φ) := (contDiff_infty_iff_fderiv.mp hφ).2
    exact ⟨hd.clm_apply contDiff_const, hφc.fderiv_apply ℝ _, tsup_grad φ hφS k⟩
  
  have s4 : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → ∀ (x : Fin 2 → ℝ) (i k : Fin 2),
      smthGrad (fun y => smthGrad φ y k) x i = smthGrad (fun y => smthGrad φ y i) x k := by
    intro φ hφ x i k
    have hd : ContDiff ℝ ∞ (fderiv ℝ φ) := (contDiff_infty_iff_fderiv.mp hφ).2
    have hdd : DifferentiableAt ℝ (fderiv ℝ φ) x := (hd.differentiable (by simp)).differentiableAt
    have key : ∀ a b : Fin 2, fderiv ℝ (fun y => smthGrad φ y a) x (Pi.single b 1) =
        fderiv ℝ (fderiv ℝ φ) x (Pi.single b 1) (Pi.single a 1) := by
      intro a b
      show fderiv ℝ (fun y => fderiv ℝ φ y (Pi.single a 1)) x (Pi.single b 1) = _
      rw [fderiv_clm_apply hdd (differentiableAt_const _)]
      simp
    have hS2 : IsSymmSndFDerivAt ℝ φ x := hφ.contDiffAt.isSymmSndFDerivAt (by
      simp only [minSmoothness_of_isRCLikeNormedField]
      exact (WithTop.coe_le_coe.mpr (le_top : (2 : ℕ∞) ≤ ⊤)))
    show fderiv ℝ (fun y => smthGrad φ y k) x (Pi.single i 1) =
      fderiv ℝ (fun y => smthGrad φ y i) x (Pi.single k 1)
    rw [key, key]
    exact hS2 _ _
  
  have s2 : ∀ (p h : (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ 1 p S → ContDiff ℝ 1 h →
      HasCompactSupport h → tsupport h ⊆ S → ∀ k : Fin 2,
      ∫ x, p x * smthGrad h x k = -∫ x, smthGrad p x k * h x := by
    intro p h hp hh hhc hhS k
    have hoff : ∀ x, x ∉ S → h =ᶠ[𝓝 x] 0 ∧ fderiv ℝ h =ᶠ[𝓝 x] 0 := by
      intro x hx
      have hxt : x ∉ tsupport h := fun h' => hx (hhS h')
      refine ⟨(notMem_tsupport_iff_eventuallyEq).1 hxt, (notMem_tsupport_iff_eventuallyEq).1 ?_⟩
      exact fun h' => hxt (tsupport_fderiv_subset ℝ h')
    have hFoff : ∀ x, x ∉ S → (fun y => p y * h y) =ᶠ[𝓝 x] fun _ => (0:ℝ) := by
      intro x hx
      filter_upwards [(hoff x hx).1] with y hy
      simp [hy]
    have hpd : ∀ x ∈ S, DifferentiableAt ℝ p x := fun x hx =>
      (hp.differentiableOn (by simp)).differentiableAt (hS.mem_nhds hx)
    have hhd : Differentiable ℝ h := hh.differentiable (by simp)
    have hFd : Differentiable ℝ (fun y => p y * h y) := by
      intro x
      by_cases hx : x ∈ S
      · exact (hpd x hx).mul (hhd x)
      · exact (differentiableAt_const (0:ℝ)).congr_of_eventuallyEq (hFoff x hx)
    have hFder : ∀ x, fderiv ℝ (fun y => p y * h y) x (Pi.single k 1) * 1 =
        smthGrad p x k * h x + p x * smthGrad h x k := by
      intro x
      by_cases hx : x ∈ S
      · rw [show (fun y => p y * h y) = p * h from rfl, fderiv_mul (hpd x hx) (hhd x)]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
          smthGrad]
        ring
      · have h1 : fderiv ℝ (fun y => p y * h y) x = 0 := by
          rw [(hFoff x hx).fderiv_eq]; simp
        have h2 : h x = 0 := (hoff x hx).1.self_of_nhds
        have h3 : fderiv ℝ h x = 0 := (hoff x hx).2.self_of_nhds
        simp [h1, h2, h3, smthGrad]
    have hcp : ContinuousOn (fun x => smthGrad p x k) S :=
      (hp.continuousOn_fderiv_of_isOpen hS le_rfl).clm_apply continuousOn_const
    have hU := s1 (fun x => smthGrad p x k) h hcp hh.continuous hhc hhS
    have hV := s1 p (fun x => smthGrad h x k) hp.continuousOn
      ((hh.continuous_fderiv one_ne_zero).clm_apply continuous_const) (hhc.fderiv_apply ℝ _)
      (tsup_grad h hhS k)
    have hFi := s1 p h hp.continuousOn hh.continuous hhc hhS
    have hfun : (fun x => fderiv ℝ (fun y => p y * h y) x (Pi.single k 1) * 1) =
        fun x => smthGrad p x k * h x + p x * smthGrad h x k := funext hFder
    have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
      (f := fun y => p y * h y) (g := fun _ => (1:ℝ)) (v := Pi.single k 1) (μ := volume)
      (by rw [hfun]; exact hU.add hV) (by simp) (by simpa using hFi) hFd (differentiable_const 1)
    rw [hfun, integral_add hU hV] at key
    simp at key
    linarith
  
  intro φ hφ hφc hφS
  have hψ : ∀ i : Fin 2, ContDiff ℝ ∞ (fun x => smthGrad φ x i) ∧
      HasCompactSupport (fun x => smthGrad φ x i) ∧ tsupport (fun x => smthGrad φ x i) ⊆ S :=
    s3 φ hφ hφc hφS
  have hψψ : ∀ i : Fin 2, ContDiff ℝ ∞ (fun x => smthGrad (fun y => smthGrad φ y i) x m) ∧
      HasCompactSupport (fun x => smthGrad (fun y => smthGrad φ y i) x m) ∧
      tsupport (fun x => smthGrad (fun y => smthGrad φ y i) x m) ⊆ S :=
    fun i => s3 _ (hψ i).1 (hψ i).2.1 (hψ i).2.2 m
  have h0 := heq _ (hψ m).1 (hψ m).2.1 (hψ m).2.2
  have hsw : (fun x => ∑ i : Fin 2, P x i * smthGrad (fun y => smthGrad φ y m) x i +
      Q x * smthGrad φ x m) = fun x => P x 0 * smthGrad (fun y => smthGrad φ y 0) x m +
      P x 1 * smthGrad (fun y => smthGrad φ y 1) x m + Q x * smthGrad φ x m := by
    funext x
    rw [Fin.sum_univ_two, s4 φ hφ x 0 m, s4 φ hφ x 1 m]
  rw [hsw] at h0
  have T1 : ∀ i : Fin 2, Integrable (fun x => P x i * smthGrad (fun y => smthGrad φ y i) x m) :=
    fun i => s1 (fun x => P x i) _ (hP i).continuousOn (hψψ i).1.continuous (hψψ i).2.1
      (hψψ i).2.2
  have T2 : Integrable (fun x => Q x * smthGrad φ x m) :=
    s1 Q _ hQ (hψ m).1.continuous (hψ m).2.1 (hψ m).2.2
  have U : ∀ i : Fin 2, Integrable (fun x => smthGrad (fun y => P y i) x m * smthGrad φ x i) :=
    fun i => s1 (fun x => smthGrad (fun y => P y i) x m) _
      (((hP i).continuousOn_fderiv_of_isOpen hS le_rfl).clm_apply continuousOn_const)
      (hψ i).1.continuous (hψ i).2.1 (hψ i).2.2
  have IBP : ∀ i : Fin 2, ∫ x, P x i * smthGrad (fun y => smthGrad φ y i) x m =
      -∫ x, smthGrad (fun y => P y i) x m * smthGrad φ x i :=
    fun i => s2 (fun x => P x i) _ (hP i) ((hψ i).1.of_le (by simp)) (hψ i).2.1 (hψ i).2.2 m
  have T11 : Integrable (fun x => P x 0 * smthGrad (fun y => smthGrad φ y 0) x m +
      P x 1 * smthGrad (fun y => smthGrad φ y 1) x m) := (T1 0).add (T1 1)
  have U01 : Integrable (fun x => smthGrad (fun y => P y 0) x m * smthGrad φ x 0 +
      smthGrad (fun y => P y 1) x m * smthGrad φ x 1) := (U 0).add (U 1)
  rw [integral_add T11 T2, integral_add (T1 0) (T1 1), IBP 0, IBP 1] at h0
  have htarget : (fun x => ∑ i : Fin 2, (smthGrad (fun y => P y i) x m -
      (if i = m then Q x else 0)) * smthGrad φ x i) = fun x =>
      (smthGrad (fun y => P y 0) x m * smthGrad φ x 0 +
        smthGrad (fun y => P y 1) x m * smthGrad φ x 1) - Q x * smthGrad φ x m := by
    funext x
    fin_cases m <;> simp [Fin.sum_univ_two] <;> ring
  rw [htarget, integral_sub U01 T2, integral_add (U 0) (U 1)]
  linarith

theorem smth_sch_weighted_interp (α : NNReal) (y : Fin 2 → ℝ) (R K L : ℝ) (w : (Fin 2 → ℝ) → ℝ) (hR : 0 < R) (hL : 0 ≤ L) (hw : ContDiffOn ℝ 1 w (Metric.ball y R)) (hK : ∀ x ∈ Metric.ball y R, |w x| ≤ K) (hwt : ∀ x ∈ Metric.ball y R, ∀ z ∈ Metric.ball y R, (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖ ≤ L * dist x z ^ (α : ℝ)) : (∀ p ∈ Metric.ball y R, ∀ q ∈ Metric.ball p ((R - dist p y) / 2), ∀ q' ∈ Metric.ball p ((R - dist p y) / 2), ‖smthGrad w q - smthGrad w q'‖ ≤ L * (2 / (R - dist p y)) ^ (1 + (α : ℝ)) * dist q q' ^ (α : ℝ)) ∧ (∀ p ∈ Metric.ball y R, ∀ τ : ℝ, 0 < τ → τ < 1 → ‖smthGrad w p‖ ≤ 4 * K / (τ * (R - dist p y)) + 2 * L * τ ^ (α : ℝ) / (R - dist p y)) :=
by
  have hα0 : (0 : ℝ) ≤ (α : ℝ) := α.2
  have hα1 : (0 : ℝ) ≤ 1 + (α : ℝ) := by linarith
  have part1 : ∀ p ∈ Metric.ball y R, ∀ q ∈ Metric.ball p ((R - dist p y) / 2),
      ∀ q' ∈ Metric.ball p ((R - dist p y) / 2),
      ‖smthGrad w q - smthGrad w q'‖ ≤
        L * (2 / (R - dist p y)) ^ (1 + (α : ℝ)) * dist q q' ^ (α : ℝ) := by
    intro p hp q hq q' hq'
    have hpd : 0 < R - dist p y := by have := Metric.mem_ball.1 hp; linarith
    have hqd : (R - dist p y) / 2 < R - dist q y := by
      have h1 := Metric.mem_ball.1 hq
      have h2 := dist_triangle q p y
      linarith
    have hq'd : (R - dist p y) / 2 < R - dist q' y := by
      have h1 := Metric.mem_ball.1 hq'
      have h2 := dist_triangle q' p y
      linarith
    have hqb : q ∈ Metric.ball y R := by rw [Metric.mem_ball]; linarith
    have hq'b : q' ∈ Metric.ball y R := by rw [Metric.mem_ball]; linarith
    have hm : (R - dist p y) / 2 ≤ min (R - dist q y) (R - dist q' y) := le_min hqd.le hq'd.le
    have hd2 : (0 : ℝ) ≤ (R - dist p y) / 2 := by linarith
    have hmα : ((R - dist p y) / 2) ^ (1 + (α : ℝ)) ≤
        (min (R - dist q y) (R - dist q' y)) ^ (1 + (α : ℝ)) :=
      Real.rpow_le_rpow hd2 hm hα1
    have h2 : ((R - dist p y) / 2) ^ (1 + (α : ℝ)) * ‖smthGrad w q - smthGrad w q'‖ ≤
        L * dist q q' ^ (α : ℝ) :=
      le_trans (mul_le_mul_of_nonneg_right hmα (norm_nonneg _)) (hwt q hqb q' hq'b)
    have hdinv : (0 : ℝ) ≤ 2 / (R - dist p y) := div_nonneg (by norm_num) hpd.le
    have e1 : (2 / (R - dist p y)) ^ (1 + (α : ℝ)) * ((R - dist p y) / 2) ^ (1 + (α : ℝ)) = 1 := by
      rw [← Real.mul_rpow hdinv hd2]
      rw [show 2 / (R - dist p y) * ((R - dist p y) / 2) = 1 by field_simp, Real.one_rpow]
    have hpow0 : (0 : ℝ) ≤ (2 / (R - dist p y)) ^ (1 + (α : ℝ)) := Real.rpow_nonneg hdinv _
    calc ‖smthGrad w q - smthGrad w q'‖
        = (2 / (R - dist p y)) ^ (1 + (α : ℝ)) *
            (((R - dist p y) / 2) ^ (1 + (α : ℝ)) * ‖smthGrad w q - smthGrad w q'‖) := by
          rw [← mul_assoc, e1, one_mul]
      _ ≤ (2 / (R - dist p y)) ^ (1 + (α : ℝ)) * (L * dist q q' ^ (α : ℝ)) :=
          mul_le_mul_of_nonneg_left h2 hpow0
      _ = L * (2 / (R - dist p y)) ^ (1 + (α : ℝ)) * dist q q' ^ (α : ℝ) := by ring
  refine ⟨part1, ?_⟩
  intro p hp τ hτ0 hτ1
  have hpd : 0 < R - dist p y := by have := Metric.mem_ball.1 hp; linarith
  obtain ⟨d, hd⟩ : ∃ d : ℝ, d = R - dist p y := ⟨_, rfl⟩
  rw [← hd] at hpd ⊢
  have hdne : d ≠ 0 := hpd.ne'
  have hτne : τ ≠ 0 := hτ0.ne'
  have hK0 : 0 ≤ K := le_trans (abs_nonneg _) (hK p hp)
  obtain ⟨h, hh⟩ : ∃ h : ℝ, h = τ * d / 2 := ⟨_, rfl⟩
  have hh0 : 0 < h := by rw [hh]; positivity
  have hhd : h < d / 2 := by rw [hh]; nlinarith
  have hb : 0 ≤ 4 * K / (τ * d) + 2 * L * τ ^ (α : ℝ) / d := by
    have h1 : 0 ≤ 4 * K / (τ * d) := div_nonneg (by linarith) (by positivity)
    have h2 : 0 ≤ 2 * L * τ ^ (α : ℝ) / d :=
      div_nonneg (mul_nonneg (by linarith) (Real.rpow_nonneg hτ0.le _)) hpd.le
    linarith
  refine (pi_norm_le_iff_of_nonneg hb).2 (fun k => ?_)
  rw [Real.norm_eq_abs]
  obtain ⟨v, hv⟩ : ∃ v : Fin 2 → ℝ, v = Pi.single k (1 : ℝ) := ⟨_, rfl⟩
  have hvn : ‖v‖ = 1 := by rw [hv, Pi.norm_single, norm_one]
  have hdist : ∀ t : ℝ, 0 ≤ t → dist (p + t • v) p = t := by
    intro t ht
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hvn, Real.norm_eq_abs, abs_of_nonneg ht,
      mul_one]
  have hseg : ∀ t ∈ Set.Icc (0 : ℝ) h, p + t • v ∈ Metric.ball p ((R - dist p y) / 2) := by
    intro t ht
    rw [Metric.mem_ball, hdist t ht.1, ← hd]
    linarith [ht.2]
  have hpb : p ∈ Metric.ball p ((R - dist p y) / 2) := Metric.mem_ball_self (by linarith)
  have hsegR : ∀ t ∈ Set.Icc (0 : ℝ) h, p + t • v ∈ Metric.ball y R := by
    intro t ht
    rw [Metric.mem_ball]
    have h1 := dist_triangle (p + t • v) p y
    rw [hdist t ht.1] at h1
    linarith [ht.2]
  have hdiff : ∀ t ∈ Set.Icc (0 : ℝ) h, DifferentiableAt ℝ w (p + t • v) := by
    intro t ht
    exact (hw.differentiableOn one_ne_zero).differentiableAt
      (Metric.isOpen_ball.mem_nhds (hsegR t ht))
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = L * (2 / d) ^ (1 + (α : ℝ)) * h ^ (α : ℝ) := ⟨_, rfl⟩
  have hdinv : (0 : ℝ) ≤ 2 / d := div_nonneg (by norm_num) hpd.le
  have hosc : ∀ t ∈ Set.Icc (0 : ℝ) h,
      |smthGrad w (p + t • v) k - smthGrad w p k| ≤ B := by
    intro t ht
    have h1 := part1 p hp (p + t • v) (hseg t ht) p hpb
    rw [hdist t ht.1, ← hd] at h1
    have h2 : t ^ (α : ℝ) ≤ h ^ (α : ℝ) := Real.rpow_le_rpow ht.1 ht.2 hα0
    have h3 : |smthGrad w (p + t • v) k - smthGrad w p k| ≤
        ‖smthGrad w (p + t • v) - smthGrad w p‖ := by
      have := norm_le_pi_norm (smthGrad w (p + t • v) - smthGrad w p) k
      rwa [Pi.sub_apply, Real.norm_eq_abs] at this
    rw [hB]
    refine le_trans h3 (le_trans h1 ?_)
    exact mul_le_mul_of_nonneg_left h2 (mul_nonneg hL (Real.rpow_nonneg hdinv _))
  have hderiv : ∀ t ∈ Set.Icc (0 : ℝ) h,
      HasDerivWithinAt (fun t => w (p + t • v) - t * smthGrad w p k)
        (smthGrad w (p + t • v) k - smthGrad w p k) (Set.Icc 0 h) t := by
    intro t ht
    have hl : HasDerivAt (fun t : ℝ => p + t • v) v t := by
      simpa using ((hasDerivAt_id t).smul_const v).const_add p
    have hc : HasDerivAt (fun t => w (p + t • v)) (fderiv ℝ w (p + t • v) v) t :=
      (hdiff t ht).hasFDerivAt.comp_hasDerivAt t hl
    have hc' : fderiv ℝ w (p + t • v) v = smthGrad w (p + t • v) k := by
      rw [hv]; rfl
    rw [← hc']
    exact (hc.sub (hasDerivAt_mul_const (smthGrad w p k))).hasDerivWithinAt
  have hmvt : ‖(w (p + h • v) - h * smthGrad w p k) - (w (p + (0 : ℝ) • v) - 0 * smthGrad w p k)‖
      ≤ B * (h - 0) :=
    norm_image_sub_le_of_norm_deriv_le_segment' hderiv
      (fun t ht => by rw [Real.norm_eq_abs]; exact hosc t (Set.Ico_subset_Icc_self ht))
      h ⟨hh0.le, le_rfl⟩
  simp only [zero_smul, add_zero, zero_mul, sub_zero, Real.norm_eq_abs] at hmvt
  have hw2 : |w (p + h • v) - w p| ≤ 2 * K := by
    have a1 := abs_le.1 (hK _ (hsegR h ⟨hh0.le, le_rfl⟩))
    have a2 := abs_le.1 (hK p hp)
    rw [abs_le]; constructor <;> linarith
  have hkey : h * |smthGrad w p k| ≤ 2 * K + B * h := by
    have e : h * |smthGrad w p k| = |h * smthGrad w p k| := by rw [abs_mul, abs_of_pos hh0]
    rw [e]
    have a1 := abs_le.1 hmvt
    have a2 := abs_le.1 hw2
    rw [abs_le]; constructor <;> linarith
  have hB' : B = 2 * L * τ ^ (α : ℝ) / d := by
    rw [hB, hh, Real.rpow_add (by positivity : (0 : ℝ) < 2 / d), Real.rpow_one]
    have e2 : (2 / d) ^ (α : ℝ) * (τ * d / 2) ^ (α : ℝ) = τ ^ (α : ℝ) := by
      rw [← Real.mul_rpow hdinv (by positivity)]
      congr 1
      field_simp
    calc L * (2 / d * (2 / d) ^ (α : ℝ)) * (τ * d / 2) ^ (α : ℝ)
        = L * (2 / d) * ((2 / d) ^ (α : ℝ) * (τ * d / 2) ^ (α : ℝ)) := by ring
      _ = 2 * L * τ ^ (α : ℝ) / d := by rw [e2]; field_simp
  have hfin : |smthGrad w p k| ≤ (2 * K + B * h) / h := by
    rw [le_div_iff₀ hh0]; linarith
  refine le_trans hfin (le_of_eq ?_)
  rw [hB', hh]
  field_simp
  ring

theorem smth_sch_blowup_eq (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (ha : ContinuousOn a S) (hF : ContinuousOn F S) (hw : ContDiffOn ℝ 1 w S) (hsol : smthLinSol a F w S) (x₀ : Fin 2 → ℝ) (ρ κ T : ℝ) (hρ : 0 < ρ) (hκ : 0 < κ) (hT : 0 < T) (hsub : Metric.ball x₀ (ρ * T) ⊆ S) (W : (Fin 2 → ℝ) → ℝ) (hW : ∀ ζ, W ζ = (w (x₀ + ρ • ζ) - w x₀ - ρ * ∑ j : Fin 2, smthGrad w x₀ j * ζ j) / (ρ * κ)) (G : (Fin 2 → ℝ) → Fin 2 → ℝ) (hG : ∀ ζ i, G ζ i = (F (x₀ + ρ • ζ) i - F x₀ i - ∑ j : Fin 2, (a (x₀ + ρ • ζ) i j - a x₀ i j) * smthGrad w x₀ j) / κ) : ContDiffOn ℝ 1 W (Metric.ball 0 T) ∧ (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ j : Fin 2, smthGrad W ζ j = (smthGrad w (x₀ + ρ • ζ) j - smthGrad w x₀ j) / κ) ∧ smthLinSol (fun ζ => a (x₀ + ρ • ζ)) G W (Metric.ball 0 T) :=
by
  have hρ0 : ρ ≠ 0 := hρ.ne'
  have hκ0 : κ ≠ 0 := hκ.ne'
  
  have hA : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, x₀ + ρ • ζ ∈ S := by
    intro ζ hζ
    apply hsub
    rw [Metric.mem_ball, dist_zero_right] at hζ
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hρ.le]
    exact mul_lt_mul_of_pos_left hζ hρ
  
  have hWC : ContDiffOn ℝ 1 W (Metric.ball 0 T) := by
    have hWfun : W = fun ζ => (w (x₀ + ρ • ζ) - w x₀ - ρ * ∑ j : Fin 2, smthGrad w x₀ j * ζ j)
        / (ρ * κ) := funext hW
    rw [hWfun]
    have hAcd : ContDiff ℝ 1 (fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ) := by fun_prop
    have h1 : ContDiffOn ℝ 1 (fun ζ : Fin 2 → ℝ => w (x₀ + ρ • ζ)) (Metric.ball 0 T) :=
      hw.comp hAcd.contDiffOn (fun ζ hζ => hA ζ hζ)
    have h2 : ContDiff ℝ 1 (fun ζ : Fin 2 → ℝ => ρ * ∑ j : Fin 2, smthGrad w x₀ j * ζ j) := by
      fun_prop
    exact ((h1.sub contDiffOn_const).sub h2.contDiffOn).div_const _
  
  have hWg : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ j : Fin 2,
      smthGrad W ζ j = (smthGrad w (x₀ + ρ • ζ) j - smthGrad w x₀ j) / κ := by
    intro ζ hζ j
    have hdw : DifferentiableAt ℝ w (x₀ + ρ • ζ) :=
      (hw.differentiableOn one_ne_zero).differentiableAt (hS.mem_nhds (hA ζ hζ))
    have hAd : HasFDerivAt (fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ)
        (ρ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) ζ :=
      ((hasFDerivAt_id ζ).const_smul ρ).const_add x₀
    have h1 : HasFDerivAt (fun ζ : Fin 2 → ℝ => w (x₀ + ρ • ζ))
        ((fderiv ℝ w (x₀ + ρ • ζ)).comp (ρ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ))) ζ :=
      hdw.hasFDerivAt.comp ζ hAd
    have h2 : HasFDerivAt (fun ζ : Fin 2 → ℝ => ∑ k : Fin 2, smthGrad w x₀ k * ζ k)
        (∑ k : Fin 2, smthGrad w x₀ k •
          (ContinuousLinearMap.proj k : (Fin 2 → ℝ) →L[ℝ] ℝ)) ζ := by
      have := HasFDerivAt.sum (u := Finset.univ) (A := fun k (ζ : Fin 2 → ℝ) => smthGrad w x₀ k * ζ k)
        (A' := fun k => smthGrad w x₀ k • (ContinuousLinearMap.proj k : (Fin 2 → ℝ) →L[ℝ] ℝ))
        (x := ζ) (fun k _ => (hasFDerivAt_apply k ζ).const_mul (smthGrad w x₀ k))
      convert this using 1
    have h3 := ((h1.sub_const (w x₀)).sub (h2.const_mul ρ)).mul_const (ρ * κ)⁻¹
    have h4 : HasFDerivAt W ((ρ * κ)⁻¹ • ((fderiv ℝ w (x₀ + ρ • ζ)).comp
        (ρ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) -
        ρ • ∑ k : Fin 2, smthGrad w x₀ k •
          (ContinuousLinearMap.proj k : (Fin 2 → ℝ) →L[ℝ] ℝ))) ζ := by
      refine h3.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
      rw [hW y, div_eq_mul_inv]
      rfl
    show fderiv ℝ W ζ (Pi.single j 1) = _
    rw [h4.fderiv]
    simp only [smthGrad, ContinuousLinearMap.smul_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.comp_apply, ContinuousLinearMap.coe_smul', ContinuousLinearMap.coe_id',
      Pi.smul_apply, id_eq, map_smul, ContinuousLinearMap.coe_sum', Finset.sum_apply,
      ContinuousLinearMap.coe_smul', ContinuousLinearMap.proj_apply, smul_eq_mul]
    simp only [Pi.single_apply, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ,
      if_true]
    field_simp
    try ring
  refine ⟨hWC, hWg, ?_⟩
  
  intro φ hφ hφc hφs
  
  set ψ : (Fin 2 → ℝ) → ℝ := fun x => φ (ρ⁻¹ • (x - x₀)) with hψdef
  have hψ : ContDiff ℝ ∞ ψ := hφ.comp (by fun_prop)
  have hBA : ∀ ζ : Fin 2 → ℝ, ρ⁻¹ • (x₀ + ρ • ζ - x₀) = ζ := by
    intro ζ
    rw [add_sub_cancel_left, smul_smul, inv_mul_cancel₀ hρ0, one_smul]
  have hAB : ∀ x : Fin 2 → ℝ, x₀ + ρ • (ρ⁻¹ • (x - x₀)) = x := by
    intro x
    rw [smul_smul, mul_inv_cancel₀ hρ0, one_smul]
    abel
  have hKc : IsCompact ((fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ) '' tsupport φ) :=
    hφc.isCompact.image (by fun_prop)
  have hsuppK : Function.support ψ ⊆ (fun ζ : Fin 2 → ℝ => x₀ + ρ • ζ) '' tsupport φ := by
    intro x hx
    exact ⟨ρ⁻¹ • (x - x₀), subset_tsupport _ hx, hAB x⟩
  have hψc : HasCompactSupport ψ := by
    refine HasCompactSupport.intro' hKc hKc.isClosed (fun x hx => ?_)
    by_contra h
    exact hx (hsuppK h)
  have hψS : tsupport ψ ⊆ S := by
    refine (closure_minimal hsuppK hKc.isClosed).trans ?_
    rintro _ ⟨y, hy, rfl⟩
    exact hA y (hφs hy)
  have hψg : ∀ (ζ : Fin 2 → ℝ) (i : Fin 2),
      smthGrad ψ (x₀ + ρ • ζ) i = ρ⁻¹ * smthGrad φ ζ i := by
    intro ζ i
    have hB : HasFDerivAt (fun x : Fin 2 → ℝ => ρ⁻¹ • (x - x₀))
        (ρ⁻¹ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) (x₀ + ρ • ζ) :=
      ((hasFDerivAt_id _).sub_const x₀).const_smul ρ⁻¹
    have hφd : DifferentiableAt ℝ φ (ρ⁻¹ • (x₀ + ρ • ζ - x₀)) :=
      (hφ.differentiable (by simp)).differentiableAt
    have h : HasFDerivAt ψ ((fderiv ℝ φ (ρ⁻¹ • (x₀ + ρ • ζ - x₀))).comp
        (ρ⁻¹ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ))) (x₀ + ρ • ζ) :=
      hφd.hasFDerivAt.comp (x₀ + ρ • ζ) hB
    show fderiv ℝ ψ (x₀ + ρ • ζ) (Pi.single i 1) = ρ⁻¹ * fderiv ℝ φ ζ (Pi.single i 1)
    rw [h.fderiv, hBA]
    simp
  
  have hDcont : ∀ i : Fin 2, Continuous (fun x => smthGrad ψ x i) := fun i =>
    (hψ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hDcs : ∀ i : Fin 2, HasCompactSupport (fun x => smthGrad ψ x i) := fun i =>
    hψc.fderiv_apply (𝕜 := ℝ) _
  have hDts : ∀ i : Fin 2, tsupport (fun x => smthGrad ψ x i) ⊆ S := by
    intro i
    refine (closure_minimal ?_ (isClosed_tsupport ψ)).trans hψS
    intro x hx
    apply support_fderiv_subset ℝ
    intro h0
    apply hx
    show fderiv ℝ ψ x (Pi.single i 1) = 0
    rw [h0, ContinuousLinearMap.zero_apply]
  
  have h0 : ∀ i : Fin 2, ∫ x, smthGrad ψ x i = 0 := by
    intro i
    have hI : Integrable (fun x => smthGrad ψ x i) :=
      (hDcont i).integrable_of_hasCompactSupport (hDcs i)
    have := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : Fin 2 → ℝ => (1 : ℝ)) (g := ψ) (v := (Pi.single i 1 : Fin 2 → ℝ))
      (by simp) (by simpa using hI) (by simpa using hψ.continuous.integrable_of_hasCompactSupport hψc)
      (differentiable_const _) (hψ.differentiable (by simp))
    simpa [smthGrad] using this
  
  have hint : ∀ g : (Fin 2 → ℝ) → ℝ, ContinuousOn g S → ∀ i : Fin 2,
      Integrable (fun x => g x * smthGrad ψ x i) := by
    intro g hg i
    have h1 : ContinuousOn (fun x => g x * smthGrad ψ x i) S := hg.mul (hDcont i).continuousOn
    have h2 : tsupport (fun x => g x * smthGrad ψ x i) ⊆ S :=
      tsupport_mul_subset_right.trans (hDts i)
    exact (h1.continuous_of_tsupport_subset hS h2).integrable_of_hasCompactSupport
      (hDcs i).mul_left
  have hac : ∀ i j : Fin 2, ContinuousOn (fun x => a x i j) S := fun i j =>
    continuousOn_pi.1 (continuousOn_pi.1 ha i) j
  have hFc : ∀ i : Fin 2, ContinuousOn (fun x => F x i) S := fun i => continuousOn_pi.1 hF i
  have hgc : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad w x j) S := fun j =>
    (hw.continuousOn_fderiv_of_isOpen hS le_rfl).clm_apply continuousOn_const
  
  set P : (Fin 2 → ℝ) → ℝ := fun x => ∑ i : Fin 2, ∑ j : Fin 2,
    a x i j * (smthGrad w x j - smthGrad w x₀ j) * smthGrad ψ x i with hP
  set Q : (Fin 2 → ℝ) → ℝ := fun x => ∑ i : Fin 2,
    (F x i - F x₀ i - ∑ j : Fin 2, (a x i j - a x₀ i j) * smthGrad w x₀ j) * smthGrad ψ x i
    with hQ
  have hPQ : ∫ x, P x = ∫ x, Q x := by
    have i1 : Integrable (fun x => ∑ i : Fin 2, ∑ j : Fin 2,
        a x i j * smthGrad w x j * smthGrad ψ x i) :=
      integrable_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
        hint (fun x => a x i j * smthGrad w x j) ((hac i j).mul (hgc j)) i
    have i3 : Integrable (fun x => ∑ i : Fin 2, ∑ j : Fin 2,
        a x i j * smthGrad w x₀ j * smthGrad ψ x i) :=
      integrable_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
        hint (fun x => a x i j * smthGrad w x₀ j) ((hac i j).mul continuousOn_const) i
    have i4 : Integrable (fun x => ∑ i : Fin 2, F x i * smthGrad ψ x i) :=
      integrable_finset_sum _ fun i _ => hint (fun x => F x i) (hFc i) i
    have i5 : Integrable (fun x => ∑ i : Fin 2, F x₀ i * smthGrad ψ x i) :=
      integrable_finset_sum _ fun i _ => hint (fun _ => F x₀ i) continuousOn_const i
    have i6 : Integrable (fun x => ∑ i : Fin 2, ∑ j : Fin 2,
        a x₀ i j * smthGrad w x₀ j * smthGrad ψ x i) :=
      integrable_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
        hint (fun _ => a x₀ i j * smthGrad w x₀ j) continuousOn_const i
    have z5 : ∫ x, ∑ i : Fin 2, F x₀ i * smthGrad ψ x i = 0 := by
      rw [integral_finset_sum _ fun i _ => hint (fun _ => F x₀ i) continuousOn_const i]
      simp [integral_const_mul, h0]
    have z6 : ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x₀ i j * smthGrad w x₀ j * smthGrad ψ x i = 0 := by
      rw [integral_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
        hint (fun _ => a x₀ i j * smthGrad w x₀ j) continuousOn_const i]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [integral_finset_sum _ fun j _ =>
        hint (fun _ => a x₀ i j * smthGrad w x₀ j) continuousOn_const i]
      simp [integral_const_mul, h0]
    have eP : P = fun x => (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i) := by
      funext x
      simp only [hP, Fin.sum_univ_two]
      ring
    have eQ : Q = fun x => (∑ i : Fin 2, F x i * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i)
        - (∑ i : Fin 2, F x₀ i * smthGrad ψ x i)
        + (∑ i : Fin 2, ∑ j : Fin 2, a x₀ i j * smthGrad w x₀ j * smthGrad ψ x i) := by
      funext x
      simp only [hQ, Fin.sum_univ_two]
      ring
    have e1 : ∫ x, P x = (∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad ψ x i)
        - ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i := by
      rw [eP]
      exact integral_sub i1 i3
    have e2 : ∫ x, Q x = (∫ x, (∑ i : Fin 2, F x i * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i)
        - (∑ i : Fin 2, F x₀ i * smthGrad ψ x i))
        + ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x₀ i j * smthGrad w x₀ j * smthGrad ψ x i := by
      rw [eQ]
      exact integral_add ((i4.sub i3).sub i5) i6
    have e3 : (∫ x, (∑ i : Fin 2, F x i * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i)
        - (∑ i : Fin 2, F x₀ i * smthGrad ψ x i)) =
        (∫ x, (∑ i : Fin 2, F x i * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i))
        - ∫ x, ∑ i : Fin 2, F x₀ i * smthGrad ψ x i :=
      integral_sub (i4.sub i3) i5
    have e4 : (∫ x, (∑ i : Fin 2, F x i * smthGrad ψ x i)
        - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i)) =
        (∫ x, ∑ i : Fin 2, F x i * smthGrad ψ x i)
        - ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x₀ j * smthGrad ψ x i :=
      integral_sub i4 i3
    have e5 := hsol ψ hψ hψc hψS
    rw [e1, e2, e3, e4, z5, z6, e5]
    ring
  
  have hcv : ∀ f : (Fin 2 → ℝ) → ℝ, ∫ ζ, f (x₀ + ρ • ζ) = (ρ ^ 2)⁻¹ * ∫ x, f x := by
    intro f
    have h1 := Measure.integral_comp_smul (volume : Measure (Fin 2 → ℝ)) (fun y => f (x₀ + y)) ρ
    have h2 : ∫ y, f (x₀ + y) = ∫ x, f x := integral_add_left_eq_self f x₀
    simp only [Module.finrank_fin_fun] at h1
    rw [h1, h2, abs_of_pos (by positivity), smul_eq_mul]
  
  have hφ0 : ∀ ζ, ζ ∉ Metric.ball (0 : Fin 2 → ℝ) T → ∀ i, smthGrad φ ζ i = 0 := by
    intro ζ hζ i
    have : fderiv ℝ φ ζ = 0 := by
      by_contra h
      exact hζ (hφs (support_fderiv_subset ℝ h))
    show fderiv ℝ φ ζ (Pi.single i 1) = 0
    rw [this, ContinuousLinearMap.zero_apply]
  have hL : (fun ζ => ∑ i : Fin 2, ∑ j : Fin 2, a (x₀ + ρ • ζ) i j * smthGrad W ζ j *
      smthGrad φ ζ i) = fun ζ => (ρ / κ) * P (x₀ + ρ • ζ) := by
    funext ζ
    simp only [hP, hψg]
    by_cases hζ : ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T
    · simp only [hWg ζ hζ, Fin.sum_univ_two]
      field_simp
      try ring
    · simp [hφ0 ζ hζ]
  have hR : (fun ζ => ∑ i : Fin 2, G ζ i * smthGrad φ ζ i) =
      fun ζ => (ρ / κ) * Q (x₀ + ρ • ζ) := by
    funext ζ
    simp only [hQ, hψg, hG, Fin.sum_univ_two]
    field_simp
    try ring
  show ∫ ζ, ∑ i : Fin 2, ∑ j : Fin 2, a (x₀ + ρ • ζ) i j * smthGrad W ζ j * smthGrad φ ζ i =
    ∫ ζ, ∑ i : Fin 2, G ζ i * smthGrad φ ζ i
  rw [hL, hR, integral_const_mul, integral_const_mul, hcv P, hcv Q, hPQ]

theorem smth_rig_single_bounds (α : NNReal) (hα0 : 0 < α) (hα1 : α < 1) (T : ℝ) (W : (Fin 2 → ℝ) → ℝ) (hW : ContDiffOn ℝ 1 W (Metric.ball 0 T)) (hW0 : W 0 = 0) (hg0 : smthGrad W 0 = 0) (hH : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖smthGrad W ζ - smthGrad W ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ)) : (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T, |W ζ' - W ζ - ∑ j : Fin 2, smthGrad W ζ j * (ζ' j - ζ j)| ≤ 8 * ‖ζ' - ζ‖ ^ (1 + (α : ℝ))) ∧ (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖smthGrad W ζ‖ ≤ 4 * (1 + ‖ζ‖)) ∧ (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, |W ζ| ≤ 8 * (1 + ‖ζ‖) ^ 2) ∧ (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T, |W ζ - W ζ'| ≤ 16 * (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ (α : ℝ)) :=
by
  have ha0 : (0 : ℝ) ≤ (α : ℝ) := NNReal.coe_nonneg α
  have ha1 : (α : ℝ) ≤ 1 := by exact_mod_cast hα1.le
  
  have T0 : ∀ (p h : Fin 2 → ℝ), fderiv ℝ W p h = ∑ j : Fin 2, smthGrad W p j * h j := by
    intro p h
    have hh : h = ∑ j : Fin 2, h j • (Pi.single j (1 : ℝ) : Fin 2 → ℝ) := by
      ext i
      fin_cases i <;> simp [Fin.sum_univ_two]
    conv_lhs => rw [hh]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul, smthGrad]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  
  have pair : ∀ v h : Fin 2 → ℝ, |∑ j : Fin 2, v j * h j| ≤ 2 * ‖v‖ * ‖h‖ := by
    intro v h
    rw [Fin.sum_univ_two]
    have h0 : |v 0| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 0
    have h1 : |v 1| ≤ ‖v‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm v 1
    have k0 : |h 0| ≤ ‖h‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm h 0
    have k1 : |h 1| ≤ ‖h‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm h 1
    calc |v 0 * h 0 + v 1 * h 1| ≤ |v 0 * h 0| + |v 1 * h 1| := abs_add_le _ _
      _ = |v 0| * |h 0| + |v 1| * |h 1| := by rw [abs_mul, abs_mul]
      _ ≤ ‖v‖ * ‖h‖ + ‖v‖ * ‖h‖ :=
          add_le_add (mul_le_mul h0 k0 (abs_nonneg _) (norm_nonneg _))
            (mul_le_mul h1 k1 (abs_nonneg _) (norm_nonneg _))
      _ = 2 * ‖v‖ * ‖h‖ := by ring
  have hB : IsOpen (Metric.ball (0 : Fin 2 → ℝ) T) := Metric.isOpen_ball
  have hdiff : ∀ x ∈ Metric.ball (0 : Fin 2 → ℝ) T, DifferentiableAt ℝ W x := fun x hx =>
    (hW.differentiableOn one_ne_zero).differentiableAt (hB.mem_nhds hx)
  
  have TAY : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T,
      |W ζ' - W ζ - ∑ j : Fin 2, smthGrad W ζ j * (ζ' j - ζ j)| ≤
        8 * ‖ζ' - ζ‖ ^ (1 + (α : ℝ)) := by
    intro ζ hζ ζ' hζ'
    have hsc : Convex ℝ (Metric.ball (0 : Fin 2 → ℝ) T ∩ Metric.closedBall ζ ‖ζ' - ζ‖) :=
      (convex_ball _ _).inter (convex_closedBall _ _)
    have hζs : ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T ∩ Metric.closedBall ζ ‖ζ' - ζ‖ :=
      ⟨hζ, Metric.mem_closedBall_self (norm_nonneg _)⟩
    have hζ's : ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T ∩ Metric.closedBall ζ ‖ζ' - ζ‖ :=
      ⟨hζ', by rw [Metric.mem_closedBall, dist_eq_norm]⟩
    have hfd : ∀ x ∈ Metric.ball (0 : Fin 2 → ℝ) T ∩ Metric.closedBall ζ ‖ζ' - ζ‖,
        HasFDerivAt (fun y => W y - fderiv ℝ W ζ y) (fderiv ℝ W x - fderiv ℝ W ζ) x :=
      fun x hx => (hdiff x hx.1).hasFDerivAt.sub (fderiv ℝ W ζ).hasFDerivAt
    have hbound : ∀ x ∈ Metric.ball (0 : Fin 2 → ℝ) T ∩ Metric.closedBall ζ ‖ζ' - ζ‖,
        ‖fderiv ℝ (fun y => W y - fderiv ℝ W ζ y) x‖ ≤ 8 * ‖ζ' - ζ‖ ^ (α : ℝ) := by
      intro x hx
      rw [(hfd x hx).fderiv]
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun h => ?_)
      rw [ContinuousLinearMap.sub_apply, Real.norm_eq_abs, T0, T0, ← Finset.sum_sub_distrib]
      have e : ∑ j : Fin 2, (smthGrad W x j * h j - smthGrad W ζ j * h j) =
          ∑ j : Fin 2, (smthGrad W x - smthGrad W ζ) j * h j := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [Pi.sub_apply]
        ring
      rw [e]
      refine le_trans (pair _ _) ?_
      have h1 := hH x hx.1 ζ hζ
      have hxr : ‖x - ζ‖ ≤ ‖ζ' - ζ‖ := by rw [← dist_eq_norm]; exact hx.2
      have h2 : ‖x - ζ‖ ^ (α : ℝ) ≤ ‖ζ' - ζ‖ ^ (α : ℝ) :=
        Real.rpow_le_rpow (norm_nonneg _) hxr ha0
      have h3 : ‖smthGrad W x - smthGrad W ζ‖ ≤ 4 * ‖ζ' - ζ‖ ^ (α : ℝ) := by linarith
      have hn := norm_nonneg h
      calc 2 * ‖smthGrad W x - smthGrad W ζ‖ * ‖h‖ ≤ 2 * (4 * ‖ζ' - ζ‖ ^ (α : ℝ)) * ‖h‖ := by
            gcongr
        _ = 8 * ‖ζ' - ζ‖ ^ (α : ℝ) * ‖h‖ := by ring
    have mvt : ‖(W ζ' - fderiv ℝ W ζ ζ') - (W ζ - fderiv ℝ W ζ ζ)‖ ≤
        8 * ‖ζ' - ζ‖ ^ (α : ℝ) * ‖ζ' - ζ‖ :=
      hsc.norm_image_sub_le_of_norm_fderiv_le (fun x hx => (hfd x hx).differentiableAt)
        hbound hζs hζ's
    have hLd : fderiv ℝ W ζ (ζ' - ζ) = ∑ j : Fin 2, smthGrad W ζ j * (ζ' j - ζ j) := by
      rw [T0]; rfl
    have e2 : W ζ' - W ζ - ∑ j : Fin 2, smthGrad W ζ j * (ζ' j - ζ j) =
        (W ζ' - fderiv ℝ W ζ ζ') - (W ζ - fderiv ℝ W ζ ζ) := by
      rw [← hLd, map_sub]; ring
    rw [e2, ← Real.norm_eq_abs]
    have e3 : ‖ζ' - ζ‖ ^ (1 + (α : ℝ)) = ‖ζ' - ζ‖ * ‖ζ' - ζ‖ ^ (α : ℝ) :=
      Real.rpow_one_add' (norm_nonneg _) (by positivity)
    rw [e3]
    calc _ ≤ 8 * ‖ζ' - ζ‖ ^ (α : ℝ) * ‖ζ' - ζ‖ := mvt
      _ = 8 * (‖ζ' - ζ‖ * ‖ζ' - ζ‖ ^ (α : ℝ)) := by ring
  have h0B : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, (0 : Fin 2 → ℝ) ∈ Metric.ball (0 : Fin 2 → ℝ) T :=
    fun ζ hζ => Metric.mem_ball_self (lt_of_le_of_lt (norm_nonneg ζ) (mem_ball_zero_iff.1 hζ))
  have F1 : ∀ t : ℝ, 0 ≤ t → t ^ (α : ℝ) ≤ 1 + t := by
    intro t ht
    rcases le_or_gt t 1 with h | h
    · have := Real.rpow_le_one ht h ha0
      linarith
    · have := Real.rpow_le_rpow_of_exponent_le h.le ha1
      rw [Real.rpow_one] at this
      linarith
  have G2 : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖smthGrad W ζ‖ ≤ 4 * (1 + ‖ζ‖) := by
    intro ζ hζ
    have h := hH ζ hζ 0 (h0B ζ hζ)
    rw [hg0, sub_zero, sub_zero] at h
    have := F1 ‖ζ‖ (norm_nonneg _)
    linarith
  have G3 : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, |W ζ| ≤ 8 * (1 + ‖ζ‖) ^ 2 := by
    intro ζ hζ
    have h := TAY 0 (h0B ζ hζ) ζ hζ
    simp only [hW0, hg0, Pi.zero_apply, zero_mul, Finset.sum_const_zero, sub_zero] at h
    have hn := norm_nonneg ζ
    have hb : ‖ζ‖ ^ (1 + (α : ℝ)) ≤ (1 + ‖ζ‖) ^ 2 := by
      calc ‖ζ‖ ^ (1 + (α : ℝ)) ≤ (1 + ‖ζ‖) ^ (1 + (α : ℝ)) :=
            Real.rpow_le_rpow hn (by linarith) (by linarith)
        _ ≤ (1 + ‖ζ‖) ^ (2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
        _ = (1 + ‖ζ‖) ^ 2 := Real.rpow_two _
    linarith
  refine ⟨TAY, G2, G3, ?_⟩
  intro ζ hζ ζ' hζ'
  have hn := norm_nonneg ζ
  have hn' := norm_nonneg ζ'
  have hr := norm_nonneg (ζ - ζ')
  have hA : 0 ≤ ‖ζ - ζ'‖ ^ (α : ℝ) := Real.rpow_nonneg hr _
  have hP : 1 ≤ 1 + ‖ζ‖ + ‖ζ'‖ := by linarith
  have hPP : 1 + ‖ζ‖ + ‖ζ'‖ ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 := by nlinarith
  have hPPA := mul_le_mul_of_nonneg_right hPP hA
  rcases le_or_gt ‖ζ - ζ'‖ 1 with h1 | h1
  · have E1 := TAY ζ' hζ' ζ hζ
    have E2 : ‖ζ - ζ'‖ ^ (1 + (α : ℝ)) ≤ ‖ζ - ζ'‖ ^ (α : ℝ) :=
      Real.rpow_le_rpow_of_exponent_ge' hr h1 ha0 (by linarith)
    have E5 : ‖ζ - ζ'‖ ≤ ‖ζ - ζ'‖ ^ (α : ℝ) := by
      have := Real.rpow_le_rpow_of_exponent_ge' hr h1 ha0 ha1
      rwa [Real.rpow_one] at this
    have E3 : |∑ j : Fin 2, smthGrad W ζ' j * (ζ j - ζ' j)| ≤
        2 * ‖smthGrad W ζ'‖ * ‖ζ - ζ'‖ := pair (smthGrad W ζ') (ζ - ζ')
    have E4 := G2 ζ' hζ'
    have S1 : 2 * ‖smthGrad W ζ'‖ * ‖ζ - ζ'‖ ≤ 2 * (4 * (1 + ‖ζ'‖)) * ‖ζ - ζ'‖ := by gcongr
    have S2 : 8 * (1 + ‖ζ'‖) * ‖ζ - ζ'‖ ≤ 8 * (1 + ‖ζ'‖) * ‖ζ - ζ'‖ ^ (α : ℝ) :=
      mul_le_mul_of_nonneg_left E5 (by positivity)
    have S3 : 0 ≤ ‖ζ‖ * ‖ζ - ζ'‖ ^ (α : ℝ) := mul_nonneg hn hA
    have S4 : 0 ≤ ‖ζ'‖ * ‖ζ - ζ'‖ ^ (α : ℝ) := mul_nonneg hn' hA
    have a1 := abs_le.1 E1
    have a3 := abs_le.1 E3
    rw [abs_le]
    constructor <;> nlinarith
  · have E1 := abs_le.1 (G3 ζ hζ)
    have E2 := abs_le.1 (G3 ζ' hζ')
    have Q1 : (1 + ‖ζ‖) ^ 2 ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 := by nlinarith
    have Q2 : (1 + ‖ζ'‖) ^ 2 ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 := by nlinarith
    have hA1 : 1 ≤ ‖ζ - ζ'‖ ^ (α : ℝ) := Real.one_le_rpow h1.le ha0
    have Q3 : (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * 1 ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ (α : ℝ) :=
      mul_le_mul_of_nonneg_left hA1 (by positivity)
    rw [abs_le]
    constructor <;> nlinarith

theorem smth_rig_extract {E : Type*} [NormedAddCommGroup E] [ProperSpace E] (α B : ℝ) (hα : 0 < α) (hB : 0 ≤ B) (T : ℕ → ℝ) (hT : Filter.Tendsto T Filter.atTop Filter.atTop) (g : ℕ → (Fin 2 → ℝ) → E) (hbd : ∀ k, ∀ ζ : Fin 2 → ℝ, ‖ζ‖ < T k → ‖g k ζ‖ ≤ B * (1 + ‖ζ‖) ^ 2) (hhol : ∀ k, ∀ ζ ζ' : Fin 2 → ℝ, ‖ζ‖ < T k → ‖ζ'‖ < T k → ‖g k ζ - g k ζ'‖ ≤ B * (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ α) : ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∃ g₀ : (Fin 2 → ℝ) → E, ∀ ζ, Filter.Tendsto (fun k => g (φ k) ζ) Filter.atTop (nhds (g₀ ζ)) :=
by
  classical
  let emb : (Fin 2 → ℚ) → (Fin 2 → ℝ) := fun q i => (q i : ℝ)
  let f : ℕ → (Fin 2 → ℚ) → E := fun k q => if ‖emb q‖ < T k then g k (emb q) else 0
  let r : (Fin 2 → ℚ) → ℝ := fun q => B * (1 + ‖emb q‖) ^ 2
  have hf : ∀ k q, f k q ∈ Metric.closedBall (0 : E) (r q) := by
    intro k q
    rw [mem_closedBall_zero_iff]
    by_cases h : ‖emb q‖ < T k
    · simp only [f, if_pos h]
      exact hbd k _ h
    · simp only [f, if_neg h, norm_zero, r]
      positivity
  have hcpt : IsCompact (Set.univ.pi fun q => Metric.closedBall (0 : E) (r q)) :=
    isCompact_univ_pi fun q => isCompact_closedBall _ _
  obtain ⟨a, -, φ, hφ, hlim⟩ := hcpt.tendsto_subseq (x := f) (fun k => Set.mem_univ_pi.2 (hf k))
  have hF : ∀ q, Filter.Tendsto (fun k => f (φ k) q) Filter.atTop (nhds (a q)) :=
    fun q => tendsto_pi_nhds.1 hlim q
  have hTφ : Filter.Tendsto (fun k => T (φ k)) Filter.atTop Filter.atTop :=
    hT.comp hφ.tendsto_atTop
  have hconv : ∀ q, Filter.Tendsto (fun k => g (φ k) (emb q)) Filter.atTop (nhds (a q)) := by
    intro q
    refine (hF q).congr' ?_
    filter_upwards [hTφ.eventually_gt_atTop ‖emb q‖] with k hk
    simp only [f, if_pos hk]
  have hcauchy : ∀ ζ, CauchySeq (fun k => g (φ k) ζ) := by
    intro ζ
    rw [Metric.cauchySeq_iff]
    intro ε hε
    set M : ℝ := B * (2 + 2 * ‖ζ‖) ^ 2 + 1 with hM
    have hM0 : 0 < M := by positivity
    have hBM : B * (2 + 2 * ‖ζ‖) ^ 2 ≤ M := by linarith
    have hc : 0 < ε / (6 * M) := by positivity
    set δ : ℝ := min (1 / 2) ((ε / (6 * M)) ^ α⁻¹) with hδ
    have hδ0 : 0 < δ := lt_min (by norm_num) (Real.rpow_pos_of_pos hc _)
    have hδ1 : δ ≤ 1 / 2 := min_le_left _ _
    have hδα : δ ^ α ≤ ε / (6 * M) := by
      calc δ ^ α ≤ ((ε / (6 * M)) ^ α⁻¹) ^ α :=
            Real.rpow_le_rpow hδ0.le (min_le_right _ _) hα.le
        _ = ε / (6 * M) := Real.rpow_inv_rpow hc.le hα.ne'
    have hq : ∀ i, ∃ q : ℚ, ζ i - δ < q ∧ (q : ℝ) < ζ i + δ :=
      fun i => exists_rat_btwn (by linarith)
    choose q hq using hq
    have hp : ‖ζ - emb q‖ < δ := by
      rw [pi_norm_lt_iff hδ0]
      intro i
      simp only [Pi.sub_apply, Real.norm_eq_abs, emb]
      rw [abs_lt]
      constructor <;> linarith [(hq i).1, (hq i).2]
    have hpn : ‖emb q‖ ≤ ‖ζ‖ + 1 := by
      have h := norm_sub_le ζ (ζ - emb q)
      rw [sub_sub_cancel] at h
      linarith
    have hcmp : ∀ k, ‖ζ‖ + 1 < T (φ k) → ‖g (φ k) ζ - g (φ k) (emb q)‖ ≤ ε / 6 := by
      intro k hk
      have h1 := hhol (φ k) ζ (emb q) (by linarith) (by linarith)
      have hz := norm_nonneg ζ
      have hz' := norm_nonneg (emb q)
      have h2 : (1 + ‖ζ‖ + ‖emb q‖) ^ 2 ≤ (2 + 2 * ‖ζ‖) ^ 2 := by
        apply pow_le_pow_left₀ (by positivity)
        linarith
      have h3 : ‖ζ - emb q‖ ^ α ≤ δ ^ α := Real.rpow_le_rpow (norm_nonneg _) hp.le hα.le
      have h4 : 0 ≤ ‖ζ - emb q‖ ^ α := Real.rpow_nonneg (norm_nonneg _) _
      calc ‖g (φ k) ζ - g (φ k) (emb q)‖ ≤ B * (1 + ‖ζ‖ + ‖emb q‖) ^ 2 * ‖ζ - emb q‖ ^ α := h1
        _ ≤ B * (2 + 2 * ‖ζ‖) ^ 2 * δ ^ α :=
          mul_le_mul (mul_le_mul_of_nonneg_left h2 hB) h3 h4 (by positivity)
        _ ≤ M * (ε / (6 * M)) := mul_le_mul hBM hδα (Real.rpow_nonneg hδ0.le _) hM0.le
        _ = ε / 6 := by field_simp
    obtain ⟨N₁, hN₁⟩ := Metric.cauchySeq_iff.1 (hconv q).cauchySeq (ε / 3) (by positivity)
    obtain ⟨N₂, hN₂⟩ := Filter.eventually_atTop.1 (hTφ.eventually_gt_atTop (‖ζ‖ + 1))
    refine ⟨max N₁ N₂, fun m hm n hn => ?_⟩
    have hm1 := hN₁ m (le_of_max_le_left hm) n (le_of_max_le_left hn)
    have e1 : dist (g (φ m) ζ) (g (φ m) (emb q)) ≤ ε / 6 := by
      rw [dist_eq_norm]
      exact hcmp m (hN₂ m (le_of_max_le_right hm))
    have e2 : dist (g (φ n) (emb q)) (g (φ n) ζ) ≤ ε / 6 := by
      rw [dist_comm, dist_eq_norm]
      exact hcmp n (hN₂ n (le_of_max_le_right hn))
    have e3 := dist_triangle4 (g (φ m) ζ) (g (φ m) (emb q)) (g (φ n) (emb q)) (g (φ n) ζ)
    linarith
  have hlim2 : ∀ ζ, ∃ y, Filter.Tendsto (fun k => g (φ k) ζ) Filter.atTop (nhds y) :=
    fun ζ => cauchySeq_tendsto_of_complete (hcauchy ζ)
  choose g₀ hg₀ using hlim2
  exact ⟨φ, hφ, g₀, hg₀⟩

theorem smth_rig_weak_limit (B : ℝ) (T : ℕ → ℝ) (b : ℕ → (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (G : ℕ → (Fin 2 → ℝ) → Fin 2 → ℝ) (W : ℕ → (Fin 2 → ℝ) → ℝ) (b₀ : Fin 2 → Fin 2 → ℝ) (V : (Fin 2 → ℝ) → Fin 2 → ℝ) (hT : Filter.Tendsto T Filter.atTop Filter.atTop) (hbc : ∀ k, ContinuousOn (b k) (Metric.ball 0 (T k))) (hGc : ∀ k, ContinuousOn (G k) (Metric.ball 0 (T k))) (hWc : ∀ k, ContinuousOn (smthGrad (W k)) (Metric.ball 0 (T k))) (hbB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k), ‖b k ζ‖ ≤ B) (hWB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k), ‖smthGrad (W k) ζ‖ ≤ B * (1 + ‖ζ‖)) (hGB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k), ‖G k ζ‖ ≤ B * (1 + ‖ζ‖)) (hb : ∀ ζ, Filter.Tendsto (fun k => b k ζ) Filter.atTop (nhds b₀)) (hW : ∀ ζ, Filter.Tendsto (fun k => smthGrad (W k) ζ) Filter.atTop (nhds (V ζ))) (hG : ∀ ζ, Filter.Tendsto (fun k => G k ζ) Filter.atTop (nhds 0)) (hsol : ∀ k, smthLinSol (b k) (G k) (W k) (Metric.ball 0 (T k))) : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V x j * smthGrad φ x i = 0 :=
by
  intro φ hφ hcs
  have hfd : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv (by simp)
  have hgi : ∀ i : Fin 2, Continuous (fun x => smthGrad φ x i) := fun i =>
    hfd.clm_apply continuous_const
  have hgc : Continuous (smthGrad φ) := continuous_pi hgi
  have hg0 : ∀ x, x ∉ tsupport φ → smthGrad φ x = 0 := by
    intro x hx
    have h1 : x ∉ tsupport (fderiv ℝ φ) := fun h => hx (tsupport_fderiv_subset ℝ h)
    have h2 : fderiv ℝ φ x = 0 := image_eq_zero_of_notMem_tsupport h1
    funext i
    simp [smthGrad, h2]
  have hgint : MeasureTheory.Integrable (fun x => ‖smthGrad φ x‖) := by
    refine Continuous.integrable_of_hasCompactSupport hgc.norm ?_
    refine hcs.mono' ?_
    intro x hx
    by_contra h
    apply hx
    simp [hg0 x h]
  obtain ⟨r, hr⟩ := hcs.isCompact.isBounded.subset_closedBall (0 : Fin 2 → ℝ)
  have hev : ∀ᶠ k in Filter.atTop, r < T k := hT.eventually_gt_atTop r
  have hsub : ∀ k, r < T k → tsupport φ ⊆ Metric.ball (0 : Fin 2 → ℝ) (T k) :=
    fun k hk => hr.trans (Metric.closedBall_subset_ball hk)
  have hcont : ∀ (U : Set (Fin 2 → ℝ)) (f : (Fin 2 → ℝ) → ℝ), IsOpen U → tsupport φ ⊆ U →
      ContinuousOn f U → (∀ x, smthGrad φ x = 0 → f x = 0) → Continuous f := by
    intro U f hU hKU hf hf0
    refine hf.continuous_of_tsupport_subset hU ?_
    refine subset_trans ?_ hKU
    refine closure_minimal ?_ (isClosed_tsupport φ)
    intro x hx
    by_contra h
    exact hx (hf0 x (hg0 x h))
  have hL : Filter.Tendsto (fun k => ∫ x, ∑ i : Fin 2, ∑ j : Fin 2,
      b k x i j * smthGrad (W k) x j * smthGrad φ x i) Filter.atTop
      (nhds (∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V x j * smthGrad φ x i)) := by
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun x => 4 * (B * (B * (1 + r))) * ‖smthGrad φ x‖) ?_ ?_ ?_ ?_
    · filter_upwards [hev] with k hk
      refine (hcont _ _ Metric.isOpen_ball (hsub k hk) ?_ ?_).aestronglyMeasurable
      · have hA : ∀ i j : Fin 2, ContinuousOn (fun x => b k x i j) (Metric.ball 0 (T k)) :=
          fun i j => (continuous_apply j).comp_continuousOn
            ((continuous_apply i).comp_continuousOn (hbc k))
        have hBj : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad (W k) x j)
            (Metric.ball 0 (T k)) := fun j => (continuous_apply j).comp_continuousOn (hWc k)
        refine continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ => ?_))
        exact ((hA i j).mul (hBj j)).mul (hgi i).continuousOn
      · intro x hx
        simp [hx]
    · filter_upwards [hev] with k hk
      refine Filter.Eventually.of_forall (fun x => ?_)
      by_cases hx : x ∈ tsupport φ
      · have hxb : x ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) := hsub k hk hx
        have hxr : ‖x‖ ≤ r := mem_closedBall_zero_iff.1 (hr hx)
        have hb1 := hbB k x hxb
        have hB0 : 0 ≤ B := le_trans (norm_nonneg _) hb1
        have hw1 : ‖smthGrad (W k) x‖ ≤ B * (1 + r) :=
          le_trans (hWB k x hxb) (mul_le_mul_of_nonneg_left (by linarith) hB0)
        have hBr : 0 ≤ B * (1 + r) := le_trans (norm_nonneg _) hw1
        have key : ∀ i j : Fin 2, |b k x i j * smthGrad (W k) x j * smthGrad φ x i| ≤
            B * (B * (1 + r)) * ‖smthGrad φ x‖ := by
          intro i j
          have h1 : |b k x i j| ≤ B := by
            rw [← Real.norm_eq_abs]
            exact le_trans (norm_le_pi_norm (b k x i) j)
              (le_trans (norm_le_pi_norm (b k x) i) hb1)
          have h2 : |smthGrad (W k) x j| ≤ B * (1 + r) := by
            rw [← Real.norm_eq_abs]
            exact le_trans (norm_le_pi_norm _ j) hw1
          have h3 : |smthGrad φ x i| ≤ ‖smthGrad φ x‖ := by
            rw [← Real.norm_eq_abs]
            exact norm_le_pi_norm _ i
          rw [abs_mul, abs_mul]
          exact mul_le_mul (mul_le_mul h1 h2 (abs_nonneg _) hB0) h3 (abs_nonneg _)
            (mul_nonneg hB0 hBr)
        rw [Real.norm_eq_abs]
        simp only [Fin.sum_univ_two]
        have k00 := abs_le.1 (key 0 0)
        have k01 := abs_le.1 (key 0 1)
        have k10 := abs_le.1 (key 1 0)
        have k11 := abs_le.1 (key 1 1)
        rw [abs_le]
        constructor <;> linarith [k00.1, k00.2, k01.1, k01.2, k10.1, k10.2, k11.1, k11.2]
      · simp [hg0 x hx]
    · exact hgint.const_mul _
    · refine Filter.Eventually.of_forall (fun x => ?_)
      exact tendsto_finset_sum _ (fun i _ => tendsto_finset_sum _ (fun j _ =>
        ((tendsto_pi_nhds.1 (tendsto_pi_nhds.1 (hb x) i) j).mul
          (tendsto_pi_nhds.1 (hW x) j)).mul_const _))
  have hR0 : Filter.Tendsto (fun k => ∫ x, ∑ i : Fin 2, G k x i * smthGrad φ x i) Filter.atTop
      (nhds (∫ x : Fin 2 → ℝ, (0 : ℝ))) := by
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun x => 2 * (B * (1 + r)) * ‖smthGrad φ x‖) ?_ ?_ ?_ ?_
    · filter_upwards [hev] with k hk
      refine (hcont _ _ Metric.isOpen_ball (hsub k hk) ?_ ?_).aestronglyMeasurable
      · have hGi : ∀ i : Fin 2, ContinuousOn (fun x => G k x i) (Metric.ball 0 (T k)) :=
          fun i => (continuous_apply i).comp_continuousOn (hGc k)
        refine continuousOn_finset_sum _ (fun i _ => ?_)
        exact (hGi i).mul (hgi i).continuousOn
      · intro x hx
        simp [hx]
    · filter_upwards [hev] with k hk
      refine Filter.Eventually.of_forall (fun x => ?_)
      by_cases hx : x ∈ tsupport φ
      · have hxb : x ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) := hsub k hk hx
        have hxr : ‖x‖ ≤ r := mem_closedBall_zero_iff.1 (hr hx)
        have hB0 : 0 ≤ B := le_trans (norm_nonneg _) (hbB k x hxb)
        have hw1 : ‖G k x‖ ≤ B * (1 + r) :=
          le_trans (hGB k x hxb) (mul_le_mul_of_nonneg_left (by linarith) hB0)
        have hBr : 0 ≤ B * (1 + r) := le_trans (norm_nonneg _) hw1
        have key : ∀ i : Fin 2, |G k x i * smthGrad φ x i| ≤
            B * (1 + r) * ‖smthGrad φ x‖ := by
          intro i
          have h2 : |G k x i| ≤ B * (1 + r) := by
            rw [← Real.norm_eq_abs]
            exact le_trans (norm_le_pi_norm _ i) hw1
          have h3 : |smthGrad φ x i| ≤ ‖smthGrad φ x‖ := by
            rw [← Real.norm_eq_abs]
            exact norm_le_pi_norm _ i
          rw [abs_mul]
          exact mul_le_mul h2 h3 (abs_nonneg _) hBr
        rw [Real.norm_eq_abs]
        simp only [Fin.sum_univ_two]
        have k0 := abs_le.1 (key 0)
        have k1 := abs_le.1 (key 1)
        rw [abs_le]
        constructor <;> linarith [k0.1, k0.2, k1.1, k1.2]
      · simp [hg0 x hx]
    · exact hgint.const_mul _
    · refine Filter.Eventually.of_forall (fun x => ?_)
      have h := tendsto_finset_sum (Finset.univ : Finset (Fin 2))
        (fun i _ => (tendsto_pi_nhds.1 (hG x) i).mul_const (smthGrad φ x i))
      simpa using h
  rw [MeasureTheory.integral_zero] at hR0
  have hE : (fun k => ∫ x, ∑ i : Fin 2, ∑ j : Fin 2,
      b k x i j * smthGrad (W k) x j * smthGrad φ x i) =ᶠ[Filter.atTop]
      (fun k => ∫ x, ∑ i : Fin 2, G k x i * smthGrad φ x i) := by
    filter_upwards [hev] with k hk
    exact hsol k φ hφ hcs (hsub k hk)
  exact tendsto_nhds_unique (hL.congr' hE) hR0

theorem smth_rig_diff_of_taylor (α : NNReal) (hα0 : 0 < α) (H C : ℝ) (W : (Fin 2 → ℝ) → ℝ) (V : (Fin 2 → ℝ) → Fin 2 → ℝ) (hV : ∀ ζ ζ' : Fin 2 → ℝ, ‖V ζ - V ζ'‖ ≤ H * ‖ζ - ζ'‖ ^ (α : ℝ)) (hT : ∀ ζ ζ' : Fin 2 → ℝ, |W ζ' - W ζ - ∑ j : Fin 2, V ζ j * (ζ' j - ζ j)| ≤ C * ‖ζ' - ζ‖ ^ (1 + (α : ℝ))) : ContDiff ℝ 1 W ∧ ∀ ζ, smthGrad W ζ = V ζ :=
by
  have hα : (0 : ℝ) < (α : ℝ) := NNReal.coe_pos.2 hα0
  
  have hlim : ∀ (M : ℝ) (ζ : Fin 2 → ℝ),
      Filter.Tendsto (fun x : Fin 2 → ℝ => M * ‖x - ζ‖ ^ (α : ℝ)) (nhds ζ) (nhds 0) := by
    intro M ζ
    have h1 : Filter.Tendsto (fun x : Fin 2 → ℝ => ‖x - ζ‖) (nhds ζ) (nhds 0) := by
      have := ((continuous_id.sub (continuous_const (y := ζ))).norm).tendsto ζ
      simpa using this
    have h2 : Filter.Tendsto (fun t : ℝ => t ^ (α : ℝ)) (nhds 0) (nhds 0) := by
      have := Real.continuousAt_rpow_const 0 (α : ℝ) (Or.inr hα.le)
      have h0 : (0 : ℝ) ^ (α : ℝ) = 0 := Real.zero_rpow hα.ne'
      rw [ContinuousAt, h0] at this
      exact this
    have h3 := (h2.comp h1).const_mul M
    rw [mul_zero] at h3
    exact h3
  
  have hVc : Continuous V := by
    refine continuous_iff_continuousAt.2 (fun ζ => ?_)
    show Filter.Tendsto V (nhds ζ) (nhds (V ζ))
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun x => norm_nonneg _) (fun x => hV x ζ) (hlim H ζ)
  
  set L : (Fin 2 → ℝ) → ((Fin 2 → ℝ) →L[ℝ] ℝ) := fun ζ =>
    ∑ j : Fin 2, (V ζ j) • (ContinuousLinearMap.proj j : (Fin 2 → ℝ) →L[ℝ] ℝ) with hLdef
  have hLapp : ∀ ζ h : Fin 2 → ℝ, L ζ h = ∑ j : Fin 2, V ζ j * h j := by
    intro ζ h
    simp [hLdef, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply]
  have hLc : Continuous L := by
    refine continuous_finset_sum _ (fun j _ => ?_)
    exact ((continuous_apply j).comp hVc).smul continuous_const
  have hD : ∀ ζ, HasFDerivAt W (L ζ) ζ := by
    intro ζ
    rw [hasFDerivAt_iff_isLittleO_nhds_zero, Asymptotics.isLittleO_iff]
    intro c hc
    have hl := hlim |C| 0
    simp only [sub_zero] at hl
    filter_upwards [hl.eventually_lt_const hc] with h hh
    have hT' := hT ζ (ζ + h)
    have e1 : ζ + h - ζ = h := add_sub_cancel_left ζ h
    have e2 : ∑ j : Fin 2, V ζ j * ((ζ + h) j - ζ j) = L ζ h := by
      rw [hLapp]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp
    rw [e1, e2] at hT'
    have hn : 0 ≤ ‖h‖ := norm_nonneg h
    have hsplit : ‖h‖ ^ (1 + (α : ℝ)) = ‖h‖ * ‖h‖ ^ (α : ℝ) := by
      rw [Real.rpow_add' hn (by linarith), Real.rpow_one]
    have hp : 0 ≤ ‖h‖ ^ (α : ℝ) := Real.rpow_nonneg hn _
    have hq : 0 ≤ ‖h‖ ^ (1 + (α : ℝ)) := Real.rpow_nonneg hn _
    have hC : C * ‖h‖ ^ (1 + (α : ℝ)) ≤ |C| * ‖h‖ ^ (1 + (α : ℝ)) :=
      mul_le_mul_of_nonneg_right (le_abs_self C) hq
    have hfin : |C| * ‖h‖ ^ (1 + (α : ℝ)) ≤ c * ‖h‖ := by
      rw [hsplit]
      have := mul_le_mul_of_nonneg_right hh.le hn
      nlinarith
    rw [Real.norm_eq_abs]
    linarith
  refine ⟨contDiff_one_iff_hasFDerivAt.2 ⟨L, hLc, hD⟩, fun ζ => ?_⟩
  funext k
  show fderiv ℝ W ζ (Pi.single k 1) = V ζ k
  rw [(hD ζ).fderiv, hLapp]
  simp [Pi.single_apply]

theorem smth_liou_moll_smooth (ρ W : (Fin 2 → ℝ) → ℝ) (hρ : ContDiff ℝ ∞ ρ) (hρc : HasCompactSupport ρ) (hW : ContDiff ℝ 1 W) : ContDiff ℝ 2 (fun x => ∫ z, ρ z * W (x - z)) ∧ ∀ (x : Fin 2 → ℝ) (j : Fin 2), smthGrad (fun x => ∫ z, ρ z * W (x - z)) x j = ∫ z, ρ z * smthGrad W (x - z) j :=
by
  have hρcont : Continuous ρ := hρ.continuous
  have hρint : Integrable ρ := hρcont.integrable_of_hasCompactSupport hρc
  have hWcont : Continuous W := hW.continuous
  have hdW : Continuous (fderiv ℝ W) := hW.continuous_fderiv one_ne_zero
  have hWdiff : Differentiable ℝ W := hW.differentiable one_ne_zero
  have hconv : (fun x => ∫ z, ρ z * W (x - z)) =
      convolution ρ W (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    ext x
    simp [convolution_def]
  have h1 : ContDiff ℝ 2 (fun x => ∫ z, ρ z * W (x - z)) := by
    rw [hconv]
    exact contDiff_infty.mp
      (hρc.contDiff_convolution_left (n := ⊤) _ hρ hWcont.locallyIntegrable) 2
  refine ⟨h1, fun x j => ?_⟩
  obtain ⟨R, hR⟩ : ∃ R : ℝ, ∀ z, ρ z ≠ 0 → ‖z‖ ≤ R := by
    obtain ⟨R, hR⟩ := hρc.isCompact.isBounded.subset_closedBall 0
    exact ⟨R, fun z hz => by
      have := hR (subset_tsupport ρ hz)
      simpa using this⟩
  obtain ⟨C, hC⟩ := (isCompact_closedBall x (R + 1)).exists_bound_of_continuousOn hdW.continuousOn
  have hF'cont : ∀ y, Continuous (fun z => ρ z • fderiv ℝ W (y - z)) := fun y =>
    hρcont.smul (hdW.comp (continuous_const.sub continuous_id))
  have key : HasFDerivAt (fun x => ∫ z, ρ z * W (x - z))
      (∫ z, ρ z • fderiv ℝ W (x - z)) x := by
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (bound := fun z => ‖ρ z‖ * C)
      (F := fun y z => ρ z * W (y - z)) (F' := fun y z => ρ z • fderiv ℝ W (y - z))
      (ball_mem_nhds x one_pos) ?_ ?_ ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall fun y =>
        (hρcont.mul (hWcont.comp (continuous_const.sub continuous_id))).aestronglyMeasurable
    · exact (hρcont.mul (hWcont.comp (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport
        (hρc.mul_right)
    · exact (hF'cont x).aestronglyMeasurable
    · refine Filter.Eventually.of_forall fun z y hy => ?_
      rw [norm_smul]
      by_cases hz : ρ z = 0
      · simp only [hz, norm_zero, zero_mul]
        exact le_refl _
      · refine mul_le_mul_of_nonneg_left (hC _ ?_) (norm_nonneg _)
        rw [mem_closedBall, dist_eq_norm]
        have h1 := hR z hz
        have h2 : ‖y - x‖ < 1 := by rw [← dist_eq_norm]; exact hy
        calc ‖y - z - x‖ = ‖(y - x) - z‖ := by congr 1; abel
          _ ≤ ‖y - x‖ + ‖z‖ := norm_sub_le _ _
          _ ≤ R + 1 := by linarith
    · exact hρint.norm.mul_const C
    · refine Filter.Eventually.of_forall fun z y _ => ?_
      have h := ((hWdiff (y - z)).hasFDerivAt.comp y ((hasFDerivAt_id y).sub_const z)).const_mul (ρ z)
      simpa using h
  have hint : Integrable (fun z => ρ z • fderiv ℝ W (x - z)) :=
    (hF'cont x).integrable_of_hasCompactSupport hρc.smul_right
  show fderiv ℝ (fun x => ∫ z, ρ z * W (x - z)) x (Pi.single j 1) = _
  rw [key.fderiv, ContinuousLinearMap.integral_apply hint]
  simp [smthGrad]

theorem smth_liou_moll_weak (b₀ : Fin 2 → Fin 2 → ℝ) (V : (Fin 2 → ℝ) → Fin 2 → ℝ) (hV : Continuous V) (ρ : (Fin 2 → ℝ) → ℝ) (hρ : Continuous ρ) (hρc : HasCompactSupport ρ) (hsol : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V x j * smthGrad φ x i = 0) : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * (∫ z, ρ z * V (x - z) j) * smthGrad φ x i = 0 :=
by
  intro φ hφ hφc
  have hgradc : ∀ i : Fin 2, Continuous (fun x => smthGrad φ x i) := by
    intro i
    have h := (hφ.continuous_fderiv (by simp)).clm_apply
      (continuous_const (y := (Pi.single i (1:ℝ) : Fin 2 → ℝ)))
    simpa [smthGrad] using h
  have hgrad0 : ∀ i : Fin 2, ∀ x, x ∉ tsupport φ → smthGrad φ x i = 0 := by
    intro i x hx
    have h0 : fderiv ℝ φ x = 0 := by
      have h1 : x ∉ Function.support (fderiv ℝ φ) := fun h => hx (support_fderiv_subset ℝ h)
      simpa using h1
    simp [smthGrad, h0]
  
  have hshift : ∀ z : Fin 2 → ℝ,
      ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V (x - z) j * smthGrad φ x i = 0 := by
    intro z
    have hφzs : ContDiff ℝ ∞ (fun y => φ (y + z)) := hφ.comp (contDiff_id.add contDiff_const)
    have hφzc : HasCompactSupport (fun y => φ (y + z)) := by
      have := hφc.comp_homeomorph (Homeomorph.addRight z)
      simpa [Function.comp_def, Homeomorph.coe_addRight] using this
    have hgz : ∀ y (i : Fin 2), smthGrad (fun y => φ (y + z)) y i = smthGrad φ (y + z) i := by
      intro y i
      simp only [smthGrad]
      rw [fderiv_comp_add_right]
    have h := hsol (fun y => φ (y + z)) hφzs hφzc
    simp only [hgz] at h
    have h2 := MeasureTheory.integral_sub_right_eq_self (μ := (volume : Measure (Fin 2 → ℝ)))
      (fun y => ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V y j * smthGrad φ (y + z) i) z
    simp only [sub_add_cancel] at h2
    rw [h2]
    exact h
  
  have hK : IsCompact (tsupport φ ×ˢ tsupport ρ) := hφc.prod hρc
  let F : (Fin 2 → ℝ) → (Fin 2 → ℝ) → ℝ := fun x z =>
    ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * (ρ z * V (x - z) j) * smthGrad φ x i
  have hFc : Continuous (Function.uncurry F) := by
    apply continuous_finset_sum
    intro i _
    apply continuous_finset_sum
    intro j _
    exact (continuous_const.mul ((hρ.comp continuous_snd).mul ((continuous_apply j).comp
      (hV.comp (continuous_fst.sub continuous_snd))))).mul ((hgradc i).comp continuous_fst)
  have hFs : HasCompactSupport (Function.uncurry F) := by
    apply HasCompactSupport.intro hK
    rintro ⟨x, z⟩ hp
    simp only [Function.uncurry_apply_pair, F]
    by_cases hx : x ∈ tsupport φ
    · have hz : z ∉ tsupport ρ := fun hz => hp ⟨hx, hz⟩
      have hρz : ρ z = 0 := image_eq_zero_of_notMem_tsupport hz
      simp [hρz]
    · simp [hgrad0 _ x hx]
  have hFint : Integrable (Function.uncurry F) (volume.prod volume) :=
    hFc.integrable_of_hasCompactSupport hFs
  have hinner : ∀ x, ∫ z, F x z =
      ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * (∫ z, ρ z * V (x - z) j) * smthGrad φ x i := by
    intro x
    have hg : ∀ j : Fin 2, Integrable (fun z => ρ z * V (x - z) j) := by
      intro j
      exact (hρ.mul ((continuous_apply j).comp (hV.comp (continuous_const.sub continuous_id)))
        ).integrable_of_hasCompactSupport hρc.mul_right
    simp only [F]
    rw [integral_finset_sum _ (fun i _ => integrable_finset_sum _
      (fun j _ => ((hg j).const_mul _).mul_const _))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [integral_finset_sum _ (fun j _ => ((hg j).const_mul _).mul_const _)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [integral_mul_const, integral_const_mul]
  have hfact : ∀ z, ∫ x, F x z =
      ρ z * ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V (x - z) j * smthGrad φ x i := by
    intro z
    rw [← integral_const_mul]
    congr 1
    funext x
    simp only [F, Fin.sum_univ_two]
    ring
  calc ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * (∫ z, ρ z * V (x - z) j) * smthGrad φ x i
      = ∫ x, ∫ z, F x z := by
        congr 1
        funext x
        rw [hinner]
    _ = ∫ z, ∫ x, F x z := integral_integral_swap hFint
    _ = ∫ z, ρ z * ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * V (x - z) j * smthGrad φ x i := by
        congr 1
        funext z
        exact hfact z
    _ = 0 := by simp only [hshift, mul_zero, integral_zero]

theorem smth_liou_moll_holder (α : NNReal) (H δ : ℝ) (hδ : 0 < δ) (V : (Fin 2 → ℝ) → Fin 2 → ℝ) (hV : Continuous V) (hH : ∀ ζ ζ' : Fin 2 → ℝ, ‖V ζ - V ζ'‖ ≤ H * ‖ζ - ζ'‖ ^ (α : ℝ)) (ρ : (Fin 2 → ℝ) → ℝ) (hρ : Continuous ρ) (hρc : HasCompactSupport ρ) (hρ0 : ∀ z, 0 ≤ ρ z) (hρ1 : ∫ z, ρ z = 1) (hρs : ∀ z, ρ z ≠ 0 → ‖z‖ < δ) : (∀ x y : Fin 2 → ℝ, ‖(fun j => ∫ z, ρ z * V (x - z) j) - (fun j => ∫ z, ρ z * V (y - z) j)‖ ≤ H * ‖x - y‖ ^ (α : ℝ)) ∧ (∀ x : Fin 2 → ℝ, ‖(fun j => ∫ z, ρ z * V (x - z) j) - V x‖ ≤ H * δ ^ (α : ℝ)) :=
by
  
  have hH0 : 0 ≤ H := by
    have h := hH (fun _ => (1:ℝ)) 0
    have he : ‖((fun _ : Fin 2 => (1:ℝ)) - 0 : Fin 2 → ℝ)‖ = 1 := by
      rw [sub_zero, pi_norm_const, norm_one]
    rw [he, Real.one_rpow, mul_one] at h
    exact (norm_nonneg _).trans h
  
  have avg : ∀ f : (Fin 2 → ℝ) → ℝ, Continuous f → ∀ c : ℝ,
      (∀ z, ρ z ≠ 0 → |f z| ≤ c) → |∫ z, ρ z * f z| ≤ c := by
    intro f hf c hfc
    have hg : MeasureTheory.Integrable (fun z => ρ z * c) :=
      (hρ.mul continuous_const).integrable_of_hasCompactSupport hρc.mul_right
    have hb : ∀ z, ‖ρ z * f z‖ ≤ ρ z * c := by
      intro z
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hρ0 z)]
      by_cases h0 : ρ z = 0
      · simp [h0]
      · exact mul_le_mul_of_nonneg_left (hfc z h0) (hρ0 z)
    have h := MeasureTheory.norm_integral_le_of_norm_le hg (Filter.Eventually.of_forall hb)
    rw [MeasureTheory.integral_mul_const, hρ1, one_mul, Real.norm_eq_abs] at h
    exact h
  
  have hint : ∀ h : (Fin 2 → ℝ) → ℝ, Continuous h →
      MeasureTheory.Integrable (fun z => ρ z * h z) :=
    fun h hh => (hρ.mul hh).integrable_of_hasCompactSupport hρc.mul_right
  have hVc : ∀ (x : Fin 2 → ℝ) (j : Fin 2), Continuous (fun z => V (x - z) j) :=
    fun x j => (continuous_apply j).comp (hV.comp (continuous_const.sub continuous_id))
  refine ⟨fun x y => ?_, fun x => ?_⟩
  · 
    refine (pi_norm_le_iff_of_nonneg
      (mul_nonneg hH0 (Real.rpow_nonneg (norm_nonneg _) _))).2 (fun j => ?_)
    have i1 : MeasureTheory.Integrable (fun z => ρ z * V (x - z) j) := hint _ (hVc x j)
    have i2 : MeasureTheory.Integrable (fun z => ρ z * V (y - z) j) := hint _ (hVc y j)
    show ‖(∫ z, ρ z * V (x - z) j) - ∫ z, ρ z * V (y - z) j‖ ≤ _
    rw [← MeasureTheory.integral_sub i1 i2, Real.norm_eq_abs]
    simp_rw [← mul_sub]
    refine avg _ ((hVc x j).sub (hVc y j)) _ (fun z _ => ?_)
    have h1 := norm_le_pi_norm (V (x - z) - V (y - z)) j
    have h2 := hH (x - z) (y - z)
    rw [sub_sub_sub_cancel_right] at h2
    rw [Pi.sub_apply, Real.norm_eq_abs] at h1
    exact h1.trans h2
  · 
    refine (pi_norm_le_iff_of_nonneg
      (mul_nonneg hH0 (Real.rpow_nonneg hδ.le _))).2 (fun j => ?_)
    have i1 : MeasureTheory.Integrable (fun z => ρ z * V (x - z) j) := hint _ (hVc x j)
    have i2 : MeasureTheory.Integrable (fun z => ρ z * V x j) :=
      hint (fun _ => V x j) continuous_const
    have hc : (∫ z, ρ z * V x j) = V x j := by
      rw [MeasureTheory.integral_mul_const, hρ1, one_mul]
    show ‖(∫ z, ρ z * V (x - z) j) - V x j‖ ≤ _
    rw [← hc, ← MeasureTheory.integral_sub i1 i2, Real.norm_eq_abs]
    simp_rw [← mul_sub]
    refine avg _ ((hVc x j).sub continuous_const) _ (fun z hz => ?_)
    have h1 := norm_le_pi_norm (V (x - z) - V x) j
    have h2 := hH (x - z) x
    have e : x - z - x = -z := by abel
    rw [e, norm_neg] at h2
    rw [Pi.sub_apply, Real.norm_eq_abs] at h1
    have h3 : ‖z‖ ^ (α : ℝ) ≤ δ ^ (α : ℝ) :=
      Real.rpow_le_rpow (norm_nonneg z) (hρs z hz).le α.2
    calc |V (x - z) j - V x j| ≤ H * ‖z‖ ^ (α : ℝ) := h1.trans h2
      _ ≤ H * δ ^ (α : ℝ) := mul_le_mul_of_nonneg_left h3 hH0

theorem smth_liou_pointwise (b₀ : Fin 2 → Fin 2 → ℝ) (u : (Fin 2 → ℝ) → ℝ) (hu : ContDiff ℝ 2 u) (hsol : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad u x j * smthGrad φ x i = 0) : ∀ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad (fun y => smthGrad u y j) x i = 0 :=
by
  have hu1 : ContDiff ℝ 1 (fderiv ℝ u) := hu.fderiv_right (by norm_num)
  have hf : ∀ j : Fin 2, ContDiff ℝ 1 (fun y => smthGrad u y j) := fun j =>
    hu1.clm_apply contDiff_const
  have hDc : ∀ i j : Fin 2, Continuous (fun x => smthGrad (fun y => smthGrad u y j) x i) :=
    fun i j => ((hf j).continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨L, hL⟩ : ∃ L : (Fin 2 → ℝ) → ℝ,
      L = fun x => ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad (fun y => smthGrad u y j) x i :=
    ⟨_, rfl⟩
  have hLc : Continuous L := by
    rw [hL]
    exact continuous_finset_sum _ (fun i _ => continuous_finset_sum _ (fun j _ =>
      continuous_const.mul (hDc i j)))
  have hibp : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
      ∫ x, φ x * L x = 0 := by
    intro φ hφ hφc
    have hφd : Differentiable ℝ φ := hφ.differentiable (by simp)
    have hφc' : Continuous φ := hφ.continuous
    have hψ : ∀ i : Fin 2, Continuous (fun x => smthGrad φ x i) := fun i =>
      (hφ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hψc : ∀ i : Fin 2, HasCompactSupport (fun x => smthGrad φ x i) := fun i =>
      hφc.fderiv_apply (𝕜 := ℝ) _
    have I1 : ∀ i j : Fin 2,
        Integrable (fun x => smthGrad (fun y => smthGrad u y j) x i * φ x) := fun i j =>
      ((hDc i j).mul hφc').integrable_of_hasCompactSupport hφc.mul_left
    have I2 : ∀ i j : Fin 2, Integrable (fun x => smthGrad u x j * smthGrad φ x i) := fun i j =>
      ((hf j).continuous.mul (hψ i)).integrable_of_hasCompactSupport (hψc i).mul_left
    have I3 : ∀ j : Fin 2, Integrable (fun x => smthGrad u x j * φ x) := fun j =>
      ((hf j).continuous.mul hφc').integrable_of_hasCompactSupport hφc.mul_left
    have P : ∀ i j : Fin 2, ∫ x, smthGrad u x j * smthGrad φ x i =
        -∫ x, smthGrad (fun y => smthGrad u y j) x i * φ x := by
      intro i j
      exact integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
        (f := fun y => smthGrad u y j) (g := φ) (v := (Pi.single i (1 : ℝ) : Fin 2 → ℝ))
        (I1 i j) (I2 i j) (I3 j) ((hf j).differentiable one_ne_zero) hφd
    have e1 : ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad u x j * smthGrad φ x i =
        ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * ∫ x, smthGrad u x j * smthGrad φ x i := by
      have hint : ∀ i j : Fin 2,
          Integrable (fun x => b₀ i j * smthGrad u x j * smthGrad φ x i) := by
        intro i j
        simpa only [mul_assoc] using (I2 i j).const_mul (b₀ i j)
      rw [integral_finset_sum _ (fun i _ => integrable_finset_sum _ (fun j _ => hint i j))]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [integral_finset_sum _ (fun j _ => hint i j)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← integral_const_mul]
      congr 1
      funext x
      ring
    have e2 : ∫ x, φ x * L x =
        ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j *
          ∫ x, smthGrad (fun y => smthGrad u y j) x i * φ x := by
      have hint : ∀ i j : Fin 2,
          Integrable (fun x => b₀ i j * (smthGrad (fun y => smthGrad u y j) x i * φ x)) :=
        fun i j => (I1 i j).const_mul (b₀ i j)
      have hfun : (fun x => φ x * L x) = fun x => ∑ i : Fin 2, ∑ j : Fin 2,
          b₀ i j * (smthGrad (fun y => smthGrad u y j) x i * φ x) := by
        funext x
        rw [hL]
        simp only [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
        ring
      rw [hfun, integral_finset_sum _ (fun i _ => integrable_finset_sum _ (fun j _ => hint i j))]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [integral_finset_sum _ (fun j _ => hint i j)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [integral_const_mul]
    have h0 := hsol φ hφ hφc
    rw [e1] at h0
    simp only [P, mul_neg, Finset.sum_neg_distrib, neg_eq_zero] at h0
    rw [e2]
    exact h0
  have hae : ∀ᵐ x ∂(volume : Measure (Fin 2 → ℝ)), L x = 0 :=
    ae_eq_zero_of_integral_contDiff_smul_eq_zero hLc.locallyIntegrable
      (fun g hg hgc => by simpa only [smul_eq_mul] using hibp g hg hgc)
  have hL0 : L = fun _ => 0 :=
    (Continuous.ae_eq_iff_eq volume hLc continuous_const).1 hae
  intro x
  have hx := congrFun hL0 x
  rw [hL] at hx
  exact hx

theorem smth_liou_cholesky (α : NNReal) (lam H : ℝ) (hlam : 0 < lam) (b₀ : Fin 2 → Fin 2 → ℝ) (hell : ∀ η : Fin 2 → ℝ, lam * ∑ i : Fin 2, η i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * η i * η j) (u : (Fin 2 → ℝ) → ℝ) (hu : ContDiff ℝ 2 u) (hL : ∀ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad (fun y => smthGrad u y j) x i = 0) (hH : ∀ x y : Fin 2 → ℝ, ‖smthGrad u x - smthGrad u y‖ ≤ H * ‖x - y‖ ^ (α : ℝ)) : ∃ (A : (Fin 2 → ℝ) → (Fin 2 → ℝ)) (H' : ℝ), ContDiff ℝ 2 (fun z => u (A z)) ∧ (∀ x, smthGrad (fun y => smthGrad (fun z => u (A z)) y 0) x 0 + smthGrad (fun y => smthGrad (fun z => u (A z)) y 1) x 1 = 0) ∧ (∀ x y : Fin 2 → ℝ, ‖smthGrad (fun z => u (A z)) x - smthGrad (fun z => u (A z)) y‖ ≤ H' * ‖x - y‖ ^ (α : ℝ)) ∧ ((∀ x, smthGrad (fun z => u (A z)) x = smthGrad (fun z => u (A z)) 0) → ∀ x, smthGrad u x = smthGrad u 0) :=
by
  
  obtain ⟨a, s, t, ha, ht, ha2, has, hst⟩ : ∃ a s t : ℝ, 0 < a ∧ 0 < t ∧ a ^ 2 = b₀ 0 0 ∧
      2 * (a * s) = b₀ 0 1 + b₀ 1 0 ∧ s ^ 2 + t ^ 2 = b₀ 1 1 := by
    have h1 : lam ≤ b₀ 0 0 := by
      have := hell ![1, 0]
      calc lam = lam * ∑ i : Fin 2, (![1, 0] : Fin 2 → ℝ) i ^ 2 := by
            simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]; ring
        _ ≤ _ := this
        _ = b₀ 0 0 := by
            simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]; ring
    have hp : 0 < b₀ 0 0 := lt_of_lt_of_le hlam h1
    have h2 : lam * (((b₀ 0 1 + b₀ 1 0) / 2) ^ 2 + b₀ 0 0 ^ 2) ≤
        b₀ 0 0 * (b₀ 0 0 * b₀ 1 1 - ((b₀ 0 1 + b₀ 1 0) / 2) ^ 2) := by
      have := hell ![-((b₀ 0 1 + b₀ 1 0) / 2), b₀ 0 0]
      calc lam * (((b₀ 0 1 + b₀ 1 0) / 2) ^ 2 + b₀ 0 0 ^ 2)
          = lam * ∑ i : Fin 2, (![-((b₀ 0 1 + b₀ 1 0) / 2), b₀ 0 0] : Fin 2 → ℝ) i ^ 2 := by
            simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]; ring
        _ ≤ _ := this
        _ = _ := by
            simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]; ring
    have hD : 0 < b₀ 0 0 * b₀ 1 1 - ((b₀ 0 1 + b₀ 1 0) / 2) ^ 2 := by
      by_contra hc
      push_neg at hc
      have e1 : b₀ 0 0 * (b₀ 0 0 * b₀ 1 1 - ((b₀ 0 1 + b₀ 1 0) / 2) ^ 2) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hp.le hc
      have e2 : 0 < lam * (((b₀ 0 1 + b₀ 1 0) / 2) ^ 2 + b₀ 0 0 ^ 2) := by positivity
      linarith
    have hsp : Real.sqrt (b₀ 0 0) ≠ 0 := (Real.sqrt_pos.2 hp).ne'
    refine ⟨Real.sqrt (b₀ 0 0), ((b₀ 0 1 + b₀ 1 0) / 2) / Real.sqrt (b₀ 0 0),
      Real.sqrt ((b₀ 0 0 * b₀ 1 1 - ((b₀ 0 1 + b₀ 1 0) / 2) ^ 2) / b₀ 0 0),
      Real.sqrt_pos.2 hp, Real.sqrt_pos.2 (div_pos hD hp), Real.sq_sqrt hp.le, ?_, ?_⟩
    · field_simp
    · rw [div_pow, Real.sq_sqrt hp.le, Real.sq_sqrt (div_nonneg hD.le hp.le)]
      field_simp
      ring
  
  obtain ⟨L, hL0, hL1⟩ : ∃ L : (Fin 2 → ℝ) →L[ℝ] (Fin 2 → ℝ),
      (∀ y, L y 0 = a * y 0) ∧ (∀ y, L y 1 = s * y 0 + t * y 1) :=
    ⟨ContinuousLinearMap.pi ![a • ContinuousLinearMap.proj 0,
      s • ContinuousLinearMap.proj 0 + t • ContinuousLinearMap.proj 1],
      fun y => by simp, fun y => by simp⟩
  have hLe0 : L (Pi.single 0 1) =
      a • (Pi.single 0 1 : Fin 2 → ℝ) + s • (Pi.single 1 1 : Fin 2 → ℝ) := by
    ext i; fin_cases i <;> simp [hL0, hL1]
  have hLe1 : L (Pi.single 1 1) = t • (Pi.single 1 1 : Fin 2 → ℝ) := by
    ext i; fin_cases i <;> simp [hL0, hL1]
  
  have hchain : ∀ f : (Fin 2 → ℝ) → ℝ, Differentiable ℝ f → ∀ y w,
      fderiv ℝ (fun z => f (L z)) y w = fderiv ℝ f (L y) (L w) := by
    intro f hf y w
    have h : HasFDerivAt (fun z => f (L z)) ((fderiv ℝ f (L y)).comp L) y :=
      (hf (L y)).hasFDerivAt.comp y L.hasFDerivAt
    rw [h.fderiv]
    rfl
  have hc0 : ∀ f : (Fin 2 → ℝ) → ℝ, Differentiable ℝ f → ∀ y,
      smthGrad (fun z => f (L z)) y 0 = a * smthGrad f (L y) 0 + s * smthGrad f (L y) 1 := by
    intro f hf y
    show fderiv ℝ (fun z => f (L z)) y (Pi.single 0 1) =
      a * fderiv ℝ f (L y) (Pi.single 0 1) + s * fderiv ℝ f (L y) (Pi.single 1 1)
    rw [hchain f hf, hLe0, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  have hc1 : ∀ f : (Fin 2 → ℝ) → ℝ, Differentiable ℝ f → ∀ y,
      smthGrad (fun z => f (L z)) y 1 = t * smthGrad f (L y) 1 := by
    intro f hf y
    show fderiv ℝ (fun z => f (L z)) y (Pi.single 1 1) = t * fderiv ℝ f (L y) (Pi.single 1 1)
    rw [hchain f hf, hLe1, map_smul, smul_eq_mul]
  
  have hud : Differentiable ℝ u := hu.differentiable (by norm_num)
  have hD1 : ContDiff ℝ 1 (fderiv ℝ u) := hu.fderiv_right (by norm_num)
  have hGd : ∀ m : Fin 2, Differentiable ℝ (fun y => smthGrad u y m) := by
    intro m
    exact (hD1.clm_apply contDiff_const).differentiable (by norm_num)
  have hhess : ∀ (x : Fin 2 → ℝ) (i j : Fin 2), smthGrad (fun y => smthGrad u y j) x i =
      fderiv ℝ (fderiv ℝ u) x (Pi.single i 1) (Pi.single j 1) := by
    intro x i j
    show fderiv ℝ (fun y => fderiv ℝ u y (Pi.single j 1)) x (Pi.single i 1) = _
    rw [fderiv_clm_apply ((hD1.differentiable (by norm_num)) x) (differentiableAt_const _)]
    simp
  have hsym : ∀ x : Fin 2 → ℝ,
      smthGrad (fun y => smthGrad u y 1) x 0 = smthGrad (fun y => smthGrad u y 0) x 1 := by
    intro x
    rw [hhess, hhess]
    exact (hu.contDiffAt.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])) _ _
  
  have hlin2 : ∀ (F K : (Fin 2 → ℝ) → ℝ) (c d : ℝ), Differentiable ℝ F → Differentiable ℝ K →
      ∀ x i, smthGrad (fun y => c * F y + d * K y) x i =
        c * smthGrad F x i + d * smthGrad K x i := by
    intro F K c d hF hK x i
    show fderiv ℝ (fun y => c * F y + d * K y) x (Pi.single i 1) =
      c * fderiv ℝ F x (Pi.single i 1) + d * fderiv ℝ K x (Pi.single i 1)
    have h : HasFDerivAt (fun y => c * F y + d * K y)
        (c • fderiv ℝ F x + d • fderiv ℝ K x) x :=
      ((hF x).hasFDerivAt.const_mul c).add ((hK x).hasFDerivAt.const_mul d)
    rw [h.fderiv]
    simp
  have hlin1 : ∀ (K : (Fin 2 → ℝ) → ℝ) (d : ℝ), Differentiable ℝ K →
      ∀ x i, smthGrad (fun y => d * K y) x i = d * smthGrad K x i := by
    intro K d hK x i
    show fderiv ℝ (fun y => d * K y) x (Pi.single i 1) = d * fderiv ℝ K x (Pi.single i 1)
    rw [fderiv_const_mul (hK x)]
    simp
  
  have hV0 : ∀ y, smthGrad (fun z => u (L z)) y 0 =
      a * smthGrad u (L y) 0 + s * smthGrad u (L y) 1 := hc0 u hud
  have hV1 : ∀ y, smthGrad (fun z => u (L z)) y 1 = t * smthGrad u (L y) 1 := hc1 u hud
  have hGLd : ∀ m : Fin 2, Differentiable ℝ (fun z => smthGrad u (L z) m) :=
    fun m => (hGd m).comp L.differentiable
  have hv2 : ContDiff ℝ 2 (u ∘ ⇑L) := hu.comp_continuousLinearMap
  refine ⟨L, (|a| + |s| + |t|) * max H 0 * (|a| + |s| + |t|) ^ (α : ℝ),
    hv2, ?_, ?_, ?_⟩
  · 
    intro x
    have e0 : (fun y => smthGrad (fun z => u (L z)) y 0) =
        fun y => a * smthGrad u (L y) 0 + s * smthGrad u (L y) 1 := funext hV0
    have e1 : (fun y => smthGrad (fun z => u (L z)) y 1) =
        fun y => t * smthGrad u (L y) 1 := funext hV1
    rw [e0, e1, hlin2 _ _ a s (hGLd 0) (hGLd 1), hlin1 _ t (hGLd 1),
      hc0 _ (hGd 0), hc0 _ (hGd 1), hc1 _ (hGd 1)]
    have hLx := hL (L x)
    simp only [Fin.sum_univ_two] at hLx
    have hs := hsym (L x)
    linear_combination hLx + smthGrad (fun y => smthGrad u y 0) (L x) 0 * ha2 +
      smthGrad (fun y => smthGrad u y 0) (L x) 1 * has +
      smthGrad (fun y => smthGrad u y 1) (L x) 1 * hst + (a * s - b₀ 0 1) * hs
  · 
    intro x y
    have hK0 : 0 ≤ |a| + |s| + |t| := by positivity
    have hHp : 0 ≤ max H 0 := le_max_right _ _
    have hd := norm_nonneg (x - y)
    have hx0 : |x 0 - y 0| ≤ ‖x - y‖ := by
      have := norm_le_pi_norm (x - y) 0
      rwa [Pi.sub_apply, Real.norm_eq_abs] at this
    have hx1 : |x 1 - y 1| ≤ ‖x - y‖ := by
      have := norm_le_pi_norm (x - y) 1
      rwa [Pi.sub_apply, Real.norm_eq_abs] at this
    have hE : ‖L x - L y‖ ≤ (|a| + |s| + |t|) * ‖x - y‖ := by
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 ?_
      intro i
      rw [Pi.sub_apply, Real.norm_eq_abs]
      fin_cases i
      · show |L x 0 - L y 0| ≤ _
        rw [hL0, hL0, ← mul_sub, abs_mul]
        have := mul_le_mul_of_nonneg_left hx0 (abs_nonneg a)
        nlinarith [abs_nonneg s, abs_nonneg t]
      · show |L x 1 - L y 1| ≤ _
        rw [hL1, hL1]
        have e : s * x 0 + t * x 1 - (s * y 0 + t * y 1) =
            s * (x 0 - y 0) + t * (x 1 - y 1) := by ring
        rw [e]
        have e1 := mul_le_mul_of_nonneg_left hx0 (abs_nonneg s)
        have e2 := mul_le_mul_of_nonneg_left hx1 (abs_nonneg t)
        calc |s * (x 0 - y 0) + t * (x 1 - y 1)|
            ≤ |s * (x 0 - y 0)| + |t * (x 1 - y 1)| := abs_add_le _ _
          _ = |s| * |x 0 - y 0| + |t| * |x 1 - y 1| := by rw [abs_mul, abs_mul]
          _ ≤ (|a| + |s| + |t|) * ‖x - y‖ := by nlinarith [abs_nonneg a]
    have hΔ : ‖smthGrad u (L x) - smthGrad u (L y)‖ ≤
        max H 0 * ((|a| + |s| + |t|) ^ (α : ℝ) * ‖x - y‖ ^ (α : ℝ)) := by
      calc ‖smthGrad u (L x) - smthGrad u (L y)‖ ≤ H * ‖L x - L y‖ ^ (α : ℝ) := hH _ _
        _ ≤ max H 0 * ‖L x - L y‖ ^ (α : ℝ) :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg (norm_nonneg _) _)
        _ ≤ max H 0 * ((|a| + |s| + |t|) * ‖x - y‖) ^ (α : ℝ) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (norm_nonneg _) hE α.2) hHp
        _ = _ := by rw [Real.mul_rpow hK0 hd]
    have hn := norm_nonneg (smthGrad u (L x) - smthGrad u (L y))
    have h0 : |smthGrad u (L x) 0 - smthGrad u (L y) 0| ≤
        ‖smthGrad u (L x) - smthGrad u (L y)‖ := by
      have := norm_le_pi_norm (smthGrad u (L x) - smthGrad u (L y)) 0
      rwa [Pi.sub_apply, Real.norm_eq_abs] at this
    have h1 : |smthGrad u (L x) 1 - smthGrad u (L y) 1| ≤
        ‖smthGrad u (L x) - smthGrad u (L y)‖ := by
      have := norm_le_pi_norm (smthGrad u (L x) - smthGrad u (L y)) 1
      rwa [Pi.sub_apply, Real.norm_eq_abs] at this
    have hV : ‖smthGrad (fun z => u (L z)) x - smthGrad (fun z => u (L z)) y‖ ≤
        (|a| + |s| + |t|) * ‖smthGrad u (L x) - smthGrad u (L y)‖ := by
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 ?_
      intro i
      rw [Pi.sub_apply, Real.norm_eq_abs]
      fin_cases i
      · show |smthGrad (fun z => u (L z)) x 0 - smthGrad (fun z => u (L z)) y 0| ≤ _
        rw [hV0, hV0]
        have e : a * smthGrad u (L x) 0 + s * smthGrad u (L x) 1 -
            (a * smthGrad u (L y) 0 + s * smthGrad u (L y) 1) =
            a * (smthGrad u (L x) 0 - smthGrad u (L y) 0) +
              s * (smthGrad u (L x) 1 - smthGrad u (L y) 1) := by ring
        rw [e]
        have e1 := mul_le_mul_of_nonneg_left h0 (abs_nonneg a)
        have e2 := mul_le_mul_of_nonneg_left h1 (abs_nonneg s)
        calc _ ≤ |a * (smthGrad u (L x) 0 - smthGrad u (L y) 0)| +
              |s * (smthGrad u (L x) 1 - smthGrad u (L y) 1)| := abs_add_le _ _
          _ = |a| * |smthGrad u (L x) 0 - smthGrad u (L y) 0| +
              |s| * |smthGrad u (L x) 1 - smthGrad u (L y) 1| := by rw [abs_mul, abs_mul]
          _ ≤ _ := by nlinarith [abs_nonneg t]
      · show |smthGrad (fun z => u (L z)) x 1 - smthGrad (fun z => u (L z)) y 1| ≤ _
        rw [hV1, hV1, ← mul_sub, abs_mul]
        have e2 := mul_le_mul_of_nonneg_left h1 (abs_nonneg t)
        nlinarith [abs_nonneg a, abs_nonneg s]
    calc ‖smthGrad (fun z => u (L z)) x - smthGrad (fun z => u (L z)) y‖
        ≤ (|a| + |s| + |t|) * ‖smthGrad u (L x) - smthGrad u (L y)‖ := hV
      _ ≤ (|a| + |s| + |t|) *
          (max H 0 * ((|a| + |s| + |t|) ^ (α : ℝ) * ‖x - y‖ ^ (α : ℝ))) :=
          mul_le_mul_of_nonneg_left hΔ hK0
      _ = _ := by ring
  · 
    intro hc z
    obtain ⟨y, hy⟩ : ∃ y, L y = z := by
      refine ⟨![z 0 / a, (z 1 - s * (z 0 / a)) / t], ?_⟩
      ext i
      fin_cases i
      · show L _ 0 = z 0
        rw [hL0]
        simp only [Matrix.cons_val_zero]
        field_simp
      · show L _ 1 = z 1
        rw [hL1]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
        field_simp
        ring
    have k1 := congrFun (hc y) 1
    have k0 := congrFun (hc y) 0
    rw [hV1, hV1, hy, map_zero] at k1
    rw [hV0, hV0, hy, map_zero] at k0
    have g1 : smthGrad u z 1 = smthGrad u 0 1 := mul_left_cancel₀ ht.ne' k1
    rw [g1] at k0
    have g0 : smthGrad u z 0 = smthGrad u 0 0 := mul_left_cancel₀ ha.ne' (by linarith)
    ext i
    fin_cases i
    · exact g0
    · exact g1

theorem smth_liou_harmonic (α : NNReal) (hα1 : α < 1) (H : ℝ) (V : (Fin 2 → ℝ) → ℝ) (hV : ContDiff ℝ 2 V) (hharm : ∀ x, smthGrad (fun y => smthGrad V y 0) x 0 + smthGrad (fun y => smthGrad V y 1) x 1 = 0) (hH : ∀ x y : Fin 2 → ℝ, ‖smthGrad V x - smthGrad V y‖ ≤ H * ‖x - y‖ ^ (α : ℝ)) : ∀ x, smthGrad V x = smthGrad V 0 :=
by
  
  have liou : ∀ (f : ℂ → ℂ), Differentiable ℂ f → ∀ (β C : ℝ), β < 1 →
      (∀ w w' : ℂ, ‖f w - f w'‖ ≤ C * ‖w - w'‖ ^ β) → ∀ w, f w = f 0 := by
    intro f hf β C hβ hHf
    have hd : ∀ w₀, deriv f w₀ = 0 := by
      intro w₀
      have hb : ∀ R : ℝ, 0 < R → ‖deriv f w₀‖ ≤ C * R ^ (β - 1) := by
        intro R hR
        have h1 : DiffContOnCl ℂ (fun w => f w - f w₀) (Metric.ball w₀ R) :=
          (hf.sub_const (f w₀)).diffContOnCl
        have h2 : ∀ z ∈ Metric.sphere w₀ R, ‖(fun w => f w - f w₀) z‖ ≤ C * R ^ β := by
          intro z hz
          have hz' : ‖z - w₀‖ = R := by rw [← dist_eq_norm]; exact hz
          have := hHf z w₀
          rw [hz'] at this
          exact this
        have h3 := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR h1 h2
        rw [deriv_sub_const] at h3
        rw [Real.rpow_sub_one hR.ne', ← mul_div_assoc]
        exact h3
      have hlim : Filter.Tendsto (fun R : ℝ => C * R ^ (β - 1)) Filter.atTop (nhds 0) := by
        have := (tendsto_rpow_neg_atTop (y := 1 - β) (by linarith)).const_mul C
        rw [mul_zero, neg_sub] at this
        exact this
      have hle : ‖deriv f w₀‖ ≤ 0 :=
        ge_of_tendsto hlim ((Filter.eventually_gt_atTop 0).mono hb)
      exact norm_le_zero_iff.mp hle
    intro w
    exact is_const_of_deriv_eq_zero hf hd w 0
  
  have hV1 : ContDiff ℝ 1 (fderiv ℝ V) := hV.fderiv_right (m := 1) (by norm_num)
  have hdV : Differentiable ℝ (fderiv ℝ V) := hV1.differentiable one_ne_zero
  have hP : ∀ k : Fin 2, Differentiable ℝ (fun y => smthGrad V y k) := by
    intro k
    have : ContDiff ℝ 1 (fun y => fderiv ℝ V y (Pi.single k 1)) := hV1.clm_apply contDiff_const
    exact this.differentiable one_ne_zero
  
  have hD2 : ∀ (x : Fin 2 → ℝ) (i k : Fin 2), smthGrad (fun y => smthGrad V y k) x i =
      fderiv ℝ (fderiv ℝ V) x (Pi.single i 1) (Pi.single k 1) := by
    intro x i k
    show fderiv ℝ (fun y => fderiv ℝ V y (Pi.single k 1)) x (Pi.single i 1) = _
    rw [fderiv_clm_apply (hdV x) (differentiableAt_const _)]
    simp
  have hsymm : ∀ x : Fin 2 → ℝ,
      smthGrad (fun y => smthGrad V y 0) x 1 = smthGrad (fun y => smthGrad V y 1) x 0 := by
    intro x
    rw [hD2, hD2]
    have hs : IsSymmSndFDerivAt ℝ V x :=
      hV.contDiffAt.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    exact hs _ _
  
  let cL : ℂ →L[ℝ] (Fin 2 → ℝ) := ContinuousLinearMap.pi ![Complex.reCLM, Complex.imCLM]
  have hcL0 : ∀ z : ℂ, cL z 0 = z.re := fun z => by simp [cL]
  have hcL1 : ∀ z : ℂ, cL z 1 = z.im := fun z => by simp [cL]
  have hc1 : cL 1 = Pi.single 0 1 := by
    funext i; fin_cases i <;> simp [cL]
  have hcI : cL Complex.I = Pi.single 1 1 := by
    funext i; fin_cases i <;> simp [cL]
  
  set P₀ : (Fin 2 → ℝ) → ℝ := fun y => smthGrad V y 0 with hP₀def
  set P₁ : (Fin 2 → ℝ) → ℝ := fun y => smthGrad V y 1 with hP₁def
  set f : ℂ → ℂ := fun w => ((P₀ (cL w) : ℝ) : ℂ) - Complex.I * ((P₁ (cL w) : ℝ) : ℂ) with hfdef
  have hderiv : ∀ w : ℂ, HasFDerivAt f (Complex.ofRealCLM.comp ((fderiv ℝ P₀ (cL w)).comp cL) -
      Complex.I • Complex.ofRealCLM.comp ((fderiv ℝ P₁ (cL w)).comp cL)) w := by
    intro w
    have h0 : HasFDerivAt (fun w => ((P₀ (cL w) : ℝ) : ℂ))
        (Complex.ofRealCLM.comp ((fderiv ℝ P₀ (cL w)).comp cL)) w :=
      Complex.ofRealCLM.hasFDerivAt.comp w (((hP 0) (cL w)).hasFDerivAt.comp w cL.hasFDerivAt)
    have h1 : HasFDerivAt (fun w => ((P₁ (cL w) : ℝ) : ℂ))
        (Complex.ofRealCLM.comp ((fderiv ℝ P₁ (cL w)).comp cL)) w :=
      Complex.ofRealCLM.hasFDerivAt.comp w (((hP 1) (cL w)).hasFDerivAt.comp w cL.hasFDerivAt)
    exact h0.sub (h1.const_mul Complex.I)
  have hf : Differentiable ℂ f := by
    intro w
    refine differentiableAt_complex_iff_differentiableAt_real.2 ⟨(hderiv w).differentiableAt, ?_⟩
    rw [(hderiv w).fderiv]
    have hcr1 := hharm (cL w)
    have hcr2 := hsymm (cL w)
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.comp_apply, Complex.ofRealCLM_apply, hc1, hcI, smul_eq_mul]
    have e1 : ((fderiv ℝ P₀ (cL w) (Pi.single 1 1) : ℝ) : ℂ) =
        ((fderiv ℝ P₁ (cL w) (Pi.single 0 1) : ℝ) : ℂ) := by exact_mod_cast hcr2
    have e2 : ((fderiv ℝ P₀ (cL w) (Pi.single 0 1) : ℝ) : ℂ) +
        ((fderiv ℝ P₁ (cL w) (Pi.single 1 1) : ℝ) : ℂ) = 0 := by exact_mod_cast hcr1
    linear_combination e1 - Complex.I * e2 +
      ((fderiv ℝ P₁ (cL w) (Pi.single 0 1) : ℝ) : ℂ) * Complex.I_sq
  
  have hH0 : 0 ≤ H := by
    have h := hH 0 (Pi.single 0 1)
    have hn : ‖(0 : Fin 2 → ℝ) - Pi.single 0 1‖ = 1 := by
      rw [zero_sub, norm_neg, Pi.norm_single, norm_one]
    rw [hn, Real.one_rpow, mul_one] at h
    exact (norm_nonneg _).trans h
  have hcn : ∀ w w' : ℂ, ‖cL w - cL w'‖ ≤ ‖w - w'‖ := by
    intro w w'
    rw [← map_sub]
    refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).2 (fun i => ?_)
    fin_cases i
    · simpa [hcL0, Real.norm_eq_abs] using Complex.abs_re_le_norm (w - w')
    · simpa [hcL1, Real.norm_eq_abs] using Complex.abs_im_le_norm (w - w')
  have hhol : ∀ w w' : ℂ, ‖f w - f w'‖ ≤ 2 * H * ‖w - w'‖ ^ (α : ℝ) := by
    intro w w'
    have e : f w - f w' = ((P₀ (cL w) - P₀ (cL w') : ℝ) : ℂ) -
        Complex.I * ((P₁ (cL w) - P₁ (cL w') : ℝ) : ℂ) := by
      simp only [hfdef]; push_cast; ring
    have hA : |P₀ (cL w) - P₀ (cL w')| ≤ ‖smthGrad V (cL w) - smthGrad V (cL w')‖ := by
      have := norm_le_pi_norm (smthGrad V (cL w) - smthGrad V (cL w')) 0
      simpa [hP₀def, Real.norm_eq_abs] using this
    have hB : |P₁ (cL w) - P₁ (cL w')| ≤ ‖smthGrad V (cL w) - smthGrad V (cL w')‖ := by
      have := norm_le_pi_norm (smthGrad V (cL w) - smthGrad V (cL w')) 1
      simpa [hP₁def, Real.norm_eq_abs] using this
    have hpow : ‖cL w - cL w'‖ ^ (α : ℝ) ≤ ‖w - w'‖ ^ (α : ℝ) :=
      Real.rpow_le_rpow (norm_nonneg _) (hcn w w') α.2
    have hHx := hH (cL w) (cL w')
    have hm : H * ‖cL w - cL w'‖ ^ (α : ℝ) ≤ H * ‖w - w'‖ ^ (α : ℝ) :=
      mul_le_mul_of_nonneg_left hpow hH0
    have hn : ‖f w - f w'‖ ≤ |P₀ (cL w) - P₀ (cL w')| + |P₁ (cL w) - P₁ (cL w')| := by
      rw [e]
      refine (norm_sub_le _ _).trans ?_
      rw [norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Complex.norm_real,
        Real.norm_eq_abs, Real.norm_eq_abs]
    linarith
  have hα' : (α : ℝ) < 1 := by exact_mod_cast hα1
  have hconst := liou f hf (α : ℝ) (2 * H) hα' hhol
  
  intro x
  have hx : cL ⟨x 0, x 1⟩ = x := by
    funext i; fin_cases i <;> simp [cL]
  have hw := hconst ⟨x 0, x 1⟩
  simp only [hfdef, hx, map_zero] at hw
  have hre := congrArg Complex.re hw
  have him := congrArg Complex.im hw
  simp at hre him
  funext i
  fin_cases i
  · simpa [hP₀def] using hre
  · simpa [hP₁def] using him

theorem smth_rig_liouville (α : NNReal) (hα0 : 0 < α) (hα1 : α < 1) (lam H : ℝ) (hlam : 0 < lam) (b₀ : Fin 2 → Fin 2 → ℝ) (hell : ∀ η : Fin 2 → ℝ, lam * ∑ i : Fin 2, η i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * η i * η j) (W : (Fin 2 → ℝ) → ℝ) (hW : ContDiff ℝ 1 W) (hH : ∀ ζ ζ' : Fin 2 → ℝ, ‖smthGrad W ζ - smthGrad W ζ'‖ ≤ H * ‖ζ - ζ'‖ ^ (α : ℝ)) (hsol : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j * smthGrad W x j * smthGrad φ x i = 0) : ∀ ζ, smthGrad W ζ = smthGrad W 0 :=
by
  
  have hVc : Continuous (smthGrad W) := by
    have hfd : Continuous (fderiv ℝ W) := hW.continuous_fderiv one_ne_zero
    exact continuous_pi (fun j => hfd.clm_apply continuous_const)
  
  have key : ∀ δ : ℝ, 0 < δ → ∀ ζ : Fin 2 → ℝ,
      ‖smthGrad W ζ - smthGrad W 0‖ ≤ 2 * H * δ ^ (α : ℝ) := by
    intro δ hδ ζ
    let β : ContDiffBump (0 : Fin 2 → ℝ) := ⟨δ / 2, δ, half_pos hδ, half_lt_self hδ⟩
    have hρs : ContDiff ℝ ∞ (β.normed volume) := β.contDiff_normed
    have hρc : HasCompactSupport (β.normed volume) := β.hasCompactSupport_normed
    have hρ0 : ∀ z, 0 ≤ β.normed volume z := fun z => β.nonneg_normed z
    have hρ1 : ∫ z, β.normed volume z = 1 := β.integral_normed
    have hρsupp : ∀ z, β.normed volume z ≠ 0 → ‖z‖ < δ := by
      intro z hz
      have hz' : z ∈ Function.support (β.normed volume) := hz
      rw [β.support_normed_eq] at hz'
      simpa using hz'
    obtain ⟨hu2, hgu⟩ := smth_liou_moll_smooth (β.normed volume) W hρs hρc hW
    have hgu' : ∀ x, smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) x =
        fun j => ∫ z, β.normed volume z * smthGrad W (x - z) j := fun x => funext (hgu x)
    have hsol_u : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
        ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b₀ i j *
          smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) x j * smthGrad φ x i = 0 := by
      intro φ hφ hφc
      have h := smth_liou_moll_weak b₀ (smthGrad W) hVc (β.normed volume) hρs.continuous hρc
        hsol φ hφ hφc
      simp only [hgu]
      exact h
    obtain ⟨hHu, happ⟩ := smth_liou_moll_holder α H δ hδ (smthGrad W) hVc hH (β.normed volume)
      hρs.continuous hρc hρ0 hρ1 hρsupp
    have hHu' : ∀ x y : Fin 2 → ℝ,
        ‖smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) x -
          smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) y‖ ≤ H * ‖x - y‖ ^ (α : ℝ) := by
      intro x y
      rw [hgu' x, hgu' y]
      exact hHu x y
    have happ' : ∀ x : Fin 2 → ℝ,
        ‖smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) x - smthGrad W x‖ ≤
          H * δ ^ (α : ℝ) := by
      intro x
      rw [hgu' x]
      exact happ x
    have hL := smth_liou_pointwise b₀ _ hu2 hsol_u
    obtain ⟨A, H', hA2, hAharm, hAH, hback⟩ :=
      smth_liou_cholesky α lam H hlam b₀ hell _ hu2 hL hHu'
    have hconstA := smth_liou_harmonic α hα1 H' _ hA2 hAharm hAH
    have hconst := hback hconstA
    set U := smthGrad (fun x => ∫ z, β.normed volume z * W (x - z)) with hU
    calc ‖smthGrad W ζ - smthGrad W 0‖
        = ‖(smthGrad W ζ - U ζ) + (U ζ - U 0) + (U 0 - smthGrad W 0)‖ := by
          congr 1; abel
      _ ≤ ‖smthGrad W ζ - U ζ‖ + ‖U ζ - U 0‖ + ‖U 0 - smthGrad W 0‖ := norm_add₃_le
      _ ≤ H * δ ^ (α : ℝ) + 0 + H * δ ^ (α : ℝ) := by
          gcongr
          · rw [norm_sub_rev]; exact happ' ζ
          · rw [hconst ζ, sub_self, norm_zero]
          · exact happ' 0
      _ = 2 * H * δ ^ (α : ℝ) := by ring
  
  intro ζ
  have hα' : (0 : ℝ) < (α : ℝ) := hα0
  have h1 : Tendsto (fun δ : ℝ => δ ^ (α : ℝ)) (𝓝 0) (𝓝 0) := by
    have h := (Real.continuousAt_rpow_const 0 (α : ℝ) (Or.inr (by positivity))).tendsto
    rwa [Real.zero_rpow hα'.ne'] at h
  have h2 : Tendsto (fun δ : ℝ => 2 * H * δ ^ (α : ℝ)) (𝓝[>] 0) (𝓝 0) := by
    have h := (tendsto_nhdsWithin_of_tendsto_nhds (s := Set.Ioi (0 : ℝ)) h1).const_mul (2 * H)
    rwa [mul_zero] at h
  have hle : ‖smthGrad W ζ - smthGrad W 0‖ ≤ 0 :=
    ge_of_tendsto h2 (eventually_nhdsWithin_of_forall (fun δ hδ => key δ hδ ζ))
  exact sub_eq_zero.mp (norm_le_zero_iff.mp hle)

theorem smth_sch_rigidity (α : NNReal) (lam : ℝ) (K : NNReal) (hα0 : 0 < α) (hα1 : α < 1) (hlam : 0 < lam) : ∃ ε : ℝ, 0 < ε ∧ ∀ (T : ℝ) (b : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (G : (Fin 2 → ℝ) → Fin 2 → ℝ) (W : (Fin 2 → ℝ) → ℝ) (ξ : Fin 2 → ℝ), 1 / ε ≤ T → ‖ξ‖ ≤ 1 → ContDiffOn ℝ 1 W (Metric.ball 0 T) → W 0 = 0 → smthGrad W 0 = 0 → (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖smthGrad W ζ - smthGrad W ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ)) → 1 / 2 ≤ ‖smthGrad W ξ‖ → (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ η : Fin 2 → ℝ, lam * ∑ i : Fin 2, η i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, b ζ i j * η i * η j) → (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ i j : Fin 2, |b ζ i j| ≤ (K : ℝ)) → ContinuousOn b (Metric.ball 0 T) → ContinuousOn G (Metric.ball 0 T) → (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖b ζ - b 0‖ ≤ ε * ‖ζ‖ ^ (α : ℝ)) → (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖G ζ‖ ≤ ε * ‖ζ‖ ^ (α : ℝ)) → smthLinSol b G W (Metric.ball 0 T) → False :=
by
  
  by_contra hne
  have key : ∀ k : ℕ, ∃ (T : ℝ) (b : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (G : (Fin 2 → ℝ) → Fin 2 → ℝ)
      (W : (Fin 2 → ℝ) → ℝ) (ξ : Fin 2 → ℝ),
      (k : ℝ) + 1 ≤ T ∧ ‖ξ‖ ≤ 1 ∧ ContDiffOn ℝ 1 W (Metric.ball 0 T) ∧ W 0 = 0 ∧ smthGrad W 0 = 0 ∧
      (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T,
        ‖smthGrad W ζ - smthGrad W ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ)) ∧
      1 / 2 ≤ ‖smthGrad W ξ‖ ∧
      (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ η : Fin 2 → ℝ,
        lam * ∑ i : Fin 2, η i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, b ζ i j * η i * η j) ∧
      (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ i j : Fin 2, |b ζ i j| ≤ (K : ℝ)) ∧
      ContinuousOn b (Metric.ball 0 T) ∧ ContinuousOn G (Metric.ball 0 T) ∧
      (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖b ζ - b 0‖ ≤ 1 / ((k : ℝ) + 1) * ‖ζ‖ ^ (α : ℝ)) ∧
      (∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖G ζ‖ ≤ 1 / ((k : ℝ) + 1) * ‖ζ‖ ^ (α : ℝ)) ∧
      smthLinSol b G W (Metric.ball 0 T) := by
    intro k
    by_contra hk
    apply hne
    refine ⟨1 / ((k : ℝ) + 1), by positivity, ?_⟩
    intro T b G W ξ e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14
    rw [one_div_one_div] at e1
    exact hk ⟨T, b, G, W, ξ, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14⟩
  choose T b G W ξ h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 using key
  have hα : (0 : ℝ) < (α : ℝ) := NNReal.coe_pos.2 hα0
  have hα1' : (α : ℝ) ≤ 1 := by exact_mod_cast hα1.le
  have hK0 : (0 : ℝ) ≤ (K : ℝ) := K.2
  have F2 : ∀ t : ℝ, 0 ≤ t → t ^ (α : ℝ) ≤ 1 + t := by
    intro t ht
    rcases le_or_gt t 1 with h | h
    · have := Real.rpow_le_one ht h hα.le
      linarith
    · have := Real.rpow_le_rpow_of_exponent_le h.le hα1'
      rw [Real.rpow_one] at this
      linarith
  have hTpos : ∀ k, 0 < T k := fun k => by
    have := h1 k
    have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
    linarith
  have h0B : ∀ k, (0 : Fin 2 → ℝ) ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) :=
    fun k => Metric.mem_ball_self (hTpos k)
  have hTt : Filter.Tendsto T Filter.atTop Filter.atTop :=
    Filter.tendsto_atTop_mono (fun k => by linarith [h1 k]) tendsto_natCast_atTop_atTop
  have h9' : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k), ‖b k ζ‖ ≤ (K : ℝ) := by
    intro k ζ hζ
    refine (pi_norm_le_iff_of_nonneg hK0).2 (fun i => ?_)
    refine (pi_norm_le_iff_of_nonneg hK0).2 (fun j => ?_)
    rw [Real.norm_eq_abs]
    exact h9 k ζ hζ i j
  have h15 : ∀ k, ContinuousOn (smthGrad (W k)) (Metric.ball 0 (T k)) := by
    intro k
    have hfd := (h3 k).continuousOn_fderiv_of_isOpen Metric.isOpen_ball le_rfl
    exact continuousOn_pi.2 (fun j => hfd.clm_apply continuousOn_const)
  have S1 := fun k => smth_rig_single_bounds α hα0 hα1 (T k) (W k) (h3 k) (h4 k) (h5 k) (h6 k)
  
  have hbd : ∀ k, ∀ ζ : Fin 2 → ℝ, ‖ζ‖ < T k →
      ‖((W k ζ, smthGrad (W k) ζ, b k 0, ξ k) :
        ℝ × (Fin 2 → ℝ) × (Fin 2 → Fin 2 → ℝ) × (Fin 2 → ℝ))‖ ≤ (16 + (K : ℝ)) * (1 + ‖ζ‖) ^ 2 := by
    intro k ζ hζ
    have hζB : ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) := mem_ball_zero_iff.2 hζ
    have hs : 0 ≤ ‖ζ‖ := norm_nonneg _
    have hA : 1 ≤ (1 + ‖ζ‖) ^ 2 := by nlinarith
    have hB : 1 + ‖ζ‖ ≤ (1 + ‖ζ‖) ^ 2 := by nlinarith
    have hC : 0 ≤ (K : ℝ) * (1 + ‖ζ‖) ^ 2 := by positivity
    have hD : (K : ℝ) ≤ (K : ℝ) * (1 + ‖ζ‖) ^ 2 := by nlinarith
    have e1 := (S1 k).2.2.1 ζ hζB
    have e2 := (S1 k).2.1 ζ hζB
    have e3 := h9' k 0 (h0B k)
    have e4 := h2 k
    refine norm_prod_le_iff.2 ⟨?_, norm_prod_le_iff.2 ⟨?_, norm_prod_le_iff.2 ⟨?_, ?_⟩⟩⟩
    · show ‖W k ζ‖ ≤ _
      rw [Real.norm_eq_abs]
      linarith
    · show ‖smthGrad (W k) ζ‖ ≤ _
      linarith
    · show ‖b k 0‖ ≤ _
      linarith
    · show ‖ξ k‖ ≤ _
      linarith
  have hhol : ∀ k, ∀ ζ ζ' : Fin 2 → ℝ, ‖ζ‖ < T k → ‖ζ'‖ < T k →
      ‖((W k ζ, smthGrad (W k) ζ, b k 0, ξ k) :
          ℝ × (Fin 2 → ℝ) × (Fin 2 → Fin 2 → ℝ) × (Fin 2 → ℝ)) -
        (W k ζ', smthGrad (W k) ζ', b k 0, ξ k)‖ ≤
        (16 + (K : ℝ)) * (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ (α : ℝ) := by
    intro k ζ ζ' hζ hζ'
    have hζB : ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) := mem_ball_zero_iff.2 hζ
    have hζB' : ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) (T k) := mem_ball_zero_iff.2 hζ'
    have hs := norm_nonneg ζ
    have hs' := norm_nonneg ζ'
    have hD : 0 ≤ ‖ζ - ζ'‖ ^ (α : ℝ) := by positivity
    have hP : 1 ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 := by nlinarith
    have hPD : ‖ζ - ζ'‖ ^ (α : ℝ) ≤ (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ (α : ℝ) := by nlinarith
    have hKPD : 0 ≤ (K : ℝ) * (1 + ‖ζ‖ + ‖ζ'‖) ^ 2 * ‖ζ - ζ'‖ ^ (α : ℝ) := by positivity
    have e1 := (S1 k).2.2.2 ζ hζB ζ' hζB'
    have e2 := h6 k ζ hζB ζ' hζB'
    refine norm_prod_le_iff.2 ⟨?_, norm_prod_le_iff.2 ⟨?_, norm_prod_le_iff.2 ⟨?_, ?_⟩⟩⟩
    · show ‖W k ζ - W k ζ'‖ ≤ _
      rw [Real.norm_eq_abs]
      linarith
    · show ‖smthGrad (W k) ζ - smthGrad (W k) ζ'‖ ≤ _
      linarith
    · show ‖b k 0 - b k 0‖ ≤ _
      rw [sub_self, norm_zero]
      linarith
    · show ‖ξ k - ξ k‖ ≤ _
      rw [sub_self, norm_zero]
      linarith
  obtain ⟨ψ, hψ, g₀, hg₀⟩ :=
    smth_rig_extract (E := ℝ × (Fin 2 → ℝ) × (Fin 2 → Fin 2 → ℝ) × (Fin 2 → ℝ)) (α : ℝ)
      (16 + (K : ℝ)) hα (by positivity) T hTt
      (fun k ζ => (W k ζ, smthGrad (W k) ζ, b k 0, ξ k)) hbd hhol
  obtain ⟨Winf, hWinf⟩ : ∃ f : (Fin 2 → ℝ) → ℝ, ∀ ζ, f ζ = (g₀ ζ).1 := ⟨_, fun _ => rfl⟩
  obtain ⟨V, hV⟩ : ∃ f : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ ζ, f ζ = (g₀ ζ).2.1 := ⟨_, fun _ => rfl⟩
  obtain ⟨b0, hb0⟩ : ∃ m : Fin 2 → Fin 2 → ℝ, m = (g₀ 0).2.2.1 := ⟨_, rfl⟩
  obtain ⟨xinf, hxinf⟩ : ∃ x : Fin 2 → ℝ, x = (g₀ 0).2.2.2 := ⟨_, rfl⟩
  have L1 : ∀ ζ, Filter.Tendsto (fun k => W (ψ k) ζ) Filter.atTop (nhds (Winf ζ)) := by
    intro ζ
    rw [hWinf]
    exact (continuous_fst.tendsto _).comp (hg₀ ζ)
  have L2 : ∀ ζ, Filter.Tendsto (fun k => smthGrad (W (ψ k)) ζ) Filter.atTop (nhds (V ζ)) := by
    intro ζ
    rw [hV]
    exact ((continuous_fst.comp continuous_snd).tendsto _).comp (hg₀ ζ)
  have L3 : Filter.Tendsto (fun k => b (ψ k) 0) Filter.atTop (nhds b0) := by
    rw [hb0]
    exact ((continuous_fst.comp (continuous_snd.comp continuous_snd)).tendsto _).comp (hg₀ 0)
  have L4 : Filter.Tendsto (fun k => ξ (ψ k)) Filter.atTop (nhds xinf) := by
    rw [hxinf]
    exact ((continuous_snd.comp (continuous_snd.comp continuous_snd)).tendsto _).comp (hg₀ 0)
  have hTψ : Filter.Tendsto (fun k => T (ψ k)) Filter.atTop Filter.atTop :=
    hTt.comp hψ.tendsto_atTop
  have Ev : ∀ ζ : Fin 2 → ℝ, ∀ᶠ k in Filter.atTop, ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T (ψ k)) :=
    fun ζ => (hTψ.eventually_gt_atTop ‖ζ‖).mono (fun k hk => mem_ball_zero_iff.2 hk)
  have hε0 : Filter.Tendsto (fun k => 1 / ((ψ k : ℝ) + 1)) Filter.atTop (nhds 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat.comp hψ.tendsto_atTop
  
  have D1 : ∀ ζ ζ' : Fin 2 → ℝ, ‖V ζ - V ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ) := by
    intro ζ ζ'
    refine le_of_tendsto ((L2 ζ).sub (L2 ζ')).norm ?_
    filter_upwards [Ev ζ, Ev ζ'] with k hk hk'
    exact h6 (ψ k) ζ hk ζ' hk'
  have D3 : ∀ ζ ζ' : Fin 2 → ℝ,
      |Winf ζ' - Winf ζ - ∑ j : Fin 2, V ζ j * (ζ' j - ζ j)| ≤ 8 * ‖ζ' - ζ‖ ^ (1 + (α : ℝ)) := by
    intro ζ ζ'
    have ht : Filter.Tendsto
        (fun k => |W (ψ k) ζ' - W (ψ k) ζ - ∑ j : Fin 2, smthGrad (W (ψ k)) ζ j * (ζ' j - ζ j)|)
        Filter.atTop (nhds |Winf ζ' - Winf ζ - ∑ j : Fin 2, V ζ j * (ζ' j - ζ j)|) := by
      refine (continuous_abs.tendsto _).comp ?_
      refine ((L1 ζ').sub (L1 ζ)).sub ?_
      exact tendsto_finset_sum _ (fun j _ => (tendsto_pi_nhds.1 (L2 ζ) j).mul_const _)
    refine le_of_tendsto ht ?_
    filter_upwards [Ev ζ, Ev ζ'] with k hk hk'
    exact (S1 (ψ k)).1 ζ hk ζ' hk'
  obtain ⟨hC1, hgrad⟩ := smth_rig_diff_of_taylor α hα0 4 8 Winf V D1 D3
  have D5 : V 0 = 0 := by
    have h := L2 0
    simp only [h5] at h
    exact tendsto_nhds_unique h tendsto_const_nhds
  have D6 : 1 / 2 ≤ ‖V xinf‖ := by
    have hlim1 : Filter.Tendsto (fun k => 1 / 2 - 4 * ‖ξ (ψ k) - xinf‖ ^ (α : ℝ)) Filter.atTop
        (nhds (1 / 2 - 4 * ‖xinf - xinf‖ ^ (α : ℝ))) :=
      tendsto_const_nhds.sub (((L4.sub_const xinf).norm.rpow_const (Or.inr hα.le)).const_mul 4)
    rw [sub_self, norm_zero, Real.zero_rpow hα.ne', mul_zero, sub_zero] at hlim1
    refine le_of_tendsto_of_tendsto hlim1 (L2 xinf).norm ?_
    filter_upwards [Ev xinf, hTψ.eventually_gt_atTop 1] with k hk hk1
    have hxk : ξ (ψ k) ∈ Metric.ball (0 : Fin 2 → ℝ) (T (ψ k)) :=
      mem_ball_zero_iff.2 (lt_of_le_of_lt (h2 (ψ k)) hk1)
    have e1 := h7 (ψ k)
    have e2 := h6 (ψ k) (ξ (ψ k)) hxk xinf hk
    have e3 := norm_sub_norm_le (smthGrad (W (ψ k)) (ξ (ψ k))) (smthGrad (W (ψ k)) xinf)
    linarith
  have D7 : ∀ η : Fin 2 → ℝ,
      lam * ∑ i : Fin 2, η i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, b0 i j * η i * η j := by
    intro η
    have ht : Filter.Tendsto (fun k => ∑ i : Fin 2, ∑ j : Fin 2, b (ψ k) 0 i j * η i * η j)
        Filter.atTop (nhds (∑ i : Fin 2, ∑ j : Fin 2, b0 i j * η i * η j)) :=
      tendsto_finset_sum _ (fun i _ => tendsto_finset_sum _ (fun j _ =>
        ((tendsto_pi_nhds.1 (tendsto_pi_nhds.1 L3 i) j).mul_const _).mul_const _))
    exact ge_of_tendsto' ht (fun k => h8 (ψ k) 0 (h0B (ψ k)) η)
  have D8 : ∀ ζ, Filter.Tendsto (fun k => b (ψ k) ζ) Filter.atTop (nhds b0) := by
    intro ζ
    rw [tendsto_iff_norm_sub_tendsto_zero]
    have hb := (hε0.mul_const (‖ζ‖ ^ (α : ℝ))).add (tendsto_iff_norm_sub_tendsto_zero.1 L3)
    rw [zero_mul, zero_add] at hb
    refine squeeze_zero' (Filter.Eventually.of_forall (fun k => norm_nonneg _)) ?_ hb
    filter_upwards [Ev ζ] with k hk
    have e1 := h12 (ψ k) ζ hk
    have e2 := norm_sub_le_norm_sub_add_norm_sub (b (ψ k) ζ) (b (ψ k) 0) b0
    linarith
  have D9 : ∀ ζ, Filter.Tendsto (fun k => G (ψ k) ζ) Filter.atTop (nhds 0) := by
    intro ζ
    have hb := hε0.mul_const (‖ζ‖ ^ (α : ℝ))
    rw [zero_mul] at hb
    refine squeeze_zero_norm' ?_ hb
    filter_upwards [Ev ζ] with k hk
    exact h13 (ψ k) ζ hk
  have hbB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T (ψ k)), ‖b (ψ k) ζ‖ ≤ (K : ℝ) + 4 := by
    intro k ζ hζ
    have := h9' (ψ k) ζ hζ
    linarith
  have hWB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T (ψ k)),
      ‖smthGrad (W (ψ k)) ζ‖ ≤ ((K : ℝ) + 4) * (1 + ‖ζ‖) := by
    intro k ζ hζ
    have e1 := (S1 (ψ k)).2.1 ζ hζ
    have hKs : 0 ≤ (K : ℝ) * (1 + ‖ζ‖) := by positivity
    linarith
  have hGB : ∀ k, ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) (T (ψ k)),
      ‖G (ψ k) ζ‖ ≤ ((K : ℝ) + 4) * (1 + ‖ζ‖) := by
    intro k ζ hζ
    have e1 := h13 (ψ k) ζ hζ
    have hn : (0 : ℝ) ≤ (ψ k : ℝ) := Nat.cast_nonneg _
    have hε1 : 1 / ((ψ k : ℝ) + 1) ≤ 1 := by
      rw [div_le_one (by positivity)]
      linarith
    have hX := F2 ‖ζ‖ (norm_nonneg _)
    have hX0 : 0 ≤ ‖ζ‖ ^ (α : ℝ) := by positivity
    have e2 := mul_le_mul_of_nonneg_right hε1 hX0
    have hKs : 0 ≤ (K : ℝ) * (1 + ‖ζ‖) := by positivity
    have hs := norm_nonneg ζ
    linarith
  have D10 := smth_rig_weak_limit ((K : ℝ) + 4) (fun k => T (ψ k)) (fun k => b (ψ k))
    (fun k => G (ψ k)) (fun k => W (ψ k)) b0 V hTψ (fun k => h10 (ψ k)) (fun k => h11 (ψ k))
    (fun k => h15 (ψ k)) hbB hWB hGB D8 L2 D9 (fun k => h14 (ψ k))
  
  have hVeq : smthGrad Winf = V := funext hgrad
  have hsol' : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ →
      ∫ x, ∑ i : Fin 2, ∑ j : Fin 2, b0 i j * smthGrad Winf x j * smthGrad φ x i = 0 := by
    rw [hVeq]
    exact D10
  have hH' : ∀ ζ ζ' : Fin 2 → ℝ,
      ‖smthGrad Winf ζ - smthGrad Winf ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ) := by
    rw [hVeq]
    exact D1
  have hconst := smth_rig_liouville α hα0 hα1 lam 4 hlam b0 D7 Winf hC1 hH' hsol' xinf
  rw [hVeq, D5] at hconst
  rw [hconst, norm_zero] at D6
  norm_num at D6

theorem smth_sch_params (α : NNReal) (K R e : ℝ) (hα0 : 0 < α) (hK : 0 ≤ K) (hR : 0 < R) (he : 0 < e) : ∃ σ τ τ' L₀ : ℝ, 0 < σ ∧ σ ≤ 1 / 4 ∧ σ ≤ e / 2 ∧ K * (σ * R) ^ (α : ℝ) ≤ e ∧ 0 < τ ∧ τ < 1 ∧ 4 * τ ^ (α : ℝ) ≤ σ ^ (α : ℝ) / 4 ∧ 0 < τ' ∧ τ' < 1 ∧ 4 * K * R ^ (α : ℝ) * τ' ^ (α : ℝ) ≤ e / 2 ∧ 1 ≤ L₀ ∧ 32 * K / (σ ^ (α : ℝ) * τ) ≤ L₀ ∧ 2 * K * (R ^ (1 + (α : ℝ)) + 8 * K * R ^ (α : ℝ) / τ') / e ≤ L₀ :=
by
  have ha : (0 : ℝ) < (α : ℝ) := by exact_mod_cast hα0
  have ha0 : (α : ℝ) ≠ 0 := ne_of_gt ha
  have hai : (0 : ℝ) < (α : ℝ)⁻¹ := inv_pos.mpr ha
  
  have hK1 : 0 < K + 1 := by linarith
  have hδ : 0 < e / (K + 1) := div_pos he hK1
  have hδa : 0 < (e / (K + 1)) ^ (α : ℝ)⁻¹ := Real.rpow_pos_of_pos hδ _
  set σ : ℝ := min (min (1 / 4) (e / 2)) ((e / (K + 1)) ^ (α : ℝ)⁻¹ / R) with hσdef
  have hσ0 : 0 < σ := lt_min (lt_min (by norm_num) (by linarith)) (div_pos hδa hR)
  have hσ14 : σ ≤ 1 / 4 := le_trans (min_le_left _ _) (min_le_left _ _)
  have hσe : σ ≤ e / 2 := le_trans (min_le_left _ _) (min_le_right _ _)
  have hσR : σ * R ≤ (e / (K + 1)) ^ (α : ℝ)⁻¹ := by
    have h := min_le_right (min (1 / 4) (e / 2)) ((e / (K + 1)) ^ (α : ℝ)⁻¹ / R)
    rw [← hσdef] at h
    exact (le_div_iff₀ hR).mp h
  have hσRa : (σ * R) ^ (α : ℝ) ≤ e / (K + 1) := by
    have h := Real.rpow_le_rpow (by positivity) hσR ha.le
    rwa [Real.rpow_inv_rpow hδ.le ha0] at h
  have hKσ : K * (σ * R) ^ (α : ℝ) ≤ e := by
    have h1 : K * (σ * R) ^ (α : ℝ) ≤ K * (e / (K + 1)) := mul_le_mul_of_nonneg_left hσRa hK
    have h2 : K * (e / (K + 1)) ≤ e := by
      rw [mul_div_assoc', div_le_iff₀ hK1]
      nlinarith
    linarith
  
  have hσa : 0 < σ ^ (α : ℝ) := Real.rpow_pos_of_pos hσ0 _
  have hσa1 : σ ^ (α : ℝ) ≤ 1 := Real.rpow_le_one hσ0.le (by linarith) ha.le
  have hx0 : 0 < σ ^ (α : ℝ) / 16 := by positivity
  have hx1 : σ ^ (α : ℝ) / 16 < 1 := by linarith
  have hτ0 : 0 < (σ ^ (α : ℝ) / 16) ^ (α : ℝ)⁻¹ := Real.rpow_pos_of_pos hx0 _
  have hτ1 : (σ ^ (α : ℝ) / 16) ^ (α : ℝ)⁻¹ < 1 := Real.rpow_lt_one hx0.le hx1 hai
  have hτa : ((σ ^ (α : ℝ) / 16) ^ (α : ℝ)⁻¹) ^ (α : ℝ) = σ ^ (α : ℝ) / 16 :=
    Real.rpow_inv_rpow hx0.le ha0
  
  have hP : 0 ≤ K * R ^ (α : ℝ) := mul_nonneg hK (Real.rpow_nonneg hR.le _)
  have hP1 : 0 < 8 * (K * R ^ (α : ℝ) + 1) := by linarith
  set t : ℝ := min (1 / 2) (e / (8 * (K * R ^ (α : ℝ) + 1))) with htdef
  have ht0 : 0 < t := lt_min (by norm_num) (div_pos he hP1)
  have ht1 : t < 1 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
  have hte : t ≤ e / (8 * (K * R ^ (α : ℝ) + 1)) := min_le_right _ _
  have hτ'0 : 0 < t ^ (α : ℝ)⁻¹ := Real.rpow_pos_of_pos ht0 _
  have hτ'1 : t ^ (α : ℝ)⁻¹ < 1 := Real.rpow_lt_one ht0.le ht1 hai
  have hτ'a : (t ^ (α : ℝ)⁻¹) ^ (α : ℝ) = t := Real.rpow_inv_rpow ht0.le ha0
  have hC : 4 * K * R ^ (α : ℝ) * (t ^ (α : ℝ)⁻¹) ^ (α : ℝ) ≤ e / 2 := by
    rw [hτ'a]
    have h1 : 4 * (K * R ^ (α : ℝ)) * t ≤ 4 * (K * R ^ (α : ℝ)) * (e / (8 * (K * R ^ (α : ℝ) + 1))) :=
      mul_le_mul_of_nonneg_left hte (by linarith)
    have h2 : 4 * (K * R ^ (α : ℝ)) * (e / (8 * (K * R ^ (α : ℝ) + 1))) ≤ e / 2 := by
      rw [mul_div_assoc', div_le_div_iff₀ hP1 (by norm_num)]
      nlinarith
    calc 4 * K * R ^ (α : ℝ) * t = 4 * (K * R ^ (α : ℝ)) * t := by ring
      _ ≤ e / 2 := le_trans h1 h2
  refine ⟨σ, (σ ^ (α : ℝ) / 16) ^ (α : ℝ)⁻¹, t ^ (α : ℝ)⁻¹,
    max 1 (max (32 * K / (σ ^ (α : ℝ) * (σ ^ (α : ℝ) / 16) ^ (α : ℝ)⁻¹))
      (2 * K * (R ^ (1 + (α : ℝ)) + 8 * K * R ^ (α : ℝ) / t ^ (α : ℝ)⁻¹) / e)),
    hσ0, hσ14, hσe, hKσ, hτ0, hτ1, ?_, hτ'0, hτ'1, hC, le_max_left _ _,
    le_trans (le_max_left _ _) (le_max_right _ _),
    le_trans (le_max_right _ _) (le_max_right _ _)⟩
  rw [hτa]
  linarith

theorem smth_lin_schauder_est (α : NNReal) (lam : ℝ) (K : NNReal) (R : ℝ) (hα0 : 0 < α) (hα1 : α < 1) (hlam : 0 < lam) (hR : 0 < R) : ∃ M : NNReal, ∀ (y : Fin 2 → ℝ) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ), smthSchauderData lam K α a F w (Metric.ball y R) → HolderOnWith M α (smthGrad w) (Metric.ball y (R / 2)) ∧ ∀ x ∈ Metric.ball y (R / 2), ‖smthGrad w x‖ ≤ (M : ℝ) :=
by
  
  obtain ⟨ε, hε, hrig⟩ := smth_sch_rigidity α lam K hα0 hα1 hlam
  have he : 0 < min ε (1 / 2) := lt_min hε (by norm_num)
  have hK0 : (0 : ℝ) ≤ (K : ℝ) := K.2
  obtain ⟨σ, τ, τ', L₀, hσ0, hσ4, hσe, hσK, hτ0, hτ1, hτσ, hτ'0, hτ'1, hτ'K, hL1, hL2, hL3⟩ :=
    smth_sch_params α K R (min ε (1 / 2)) hα0 hK0 hR he
  generalize hedef : min ε (1 / 2) = e at he hσe hσK hτ'K hL3
  have heε : e ≤ ε := hedef ▸ min_le_left _ _
  have hαr0 : (0 : ℝ) < (α : ℝ) := by exact_mod_cast hα0
  have hαr1 : (α : ℝ) < 1 := by exact_mod_cast hα1
  obtain ⟨M', hM'⟩ : ∃ M' : ℝ,
      M' = max (L₀ * (2 / R) ^ (1 + (α : ℝ))) (16 * K / R + 4 * L₀ / R) := ⟨_, rfl⟩
  have hM'0 : 0 ≤ M' := by
    rw [hM']
    refine le_trans ?_ (le_max_right _ _)
    exact add_nonneg (div_nonneg (by positivity) hR.le) (div_nonneg (by linarith) hR.le)
  have hMcoe : ((Real.toNNReal M' : NNReal) : ℝ) = M' := Real.coe_toNNReal _ hM'0
  refine ⟨Real.toNNReal M', ?_⟩
  intro y a F w hdata
  obtain ⟨hE, hBa, hHa, hBF, hHF, hBw, hC1, ⟨C₀, hC₀⟩, hSol⟩ := hdata
  have haC : ContinuousOn a (Metric.ball y R) := hHa.continuousOn hα0
  have hFC : ContinuousOn F (Metric.ball y R) := hHF.continuousOn hα0
  have hdpos : ∀ x ∈ Metric.ball y R, 0 < R - dist x y := fun x hx => by
    have := Metric.mem_ball.1 hx; linarith
  
  obtain ⟨Q, hQ⟩ : ∃ Q : Set ℝ, Q = {v | ∃ x ∈ Metric.ball y R, ∃ z ∈ Metric.ball y R, x ≠ z ∧
      v = (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖ /
        dist x z ^ (α : ℝ)} := ⟨_, rfl⟩
  have hQnn : ∀ v ∈ Q, 0 ≤ v := by
    rw [hQ]
    rintro v ⟨x, hx, z, hz, hxz, rfl⟩
    have hm0 : 0 < min (R - dist x y) (R - dist z y) := lt_min (hdpos x hx) (hdpos z hz)
    positivity
  have hQb : BddAbove Q := by
    refine ⟨R ^ (1 + (α : ℝ)) * C₀, ?_⟩
    rw [hQ]
    rintro v ⟨x, hx, z, hz, hxz, rfl⟩
    have hdist : 0 < dist x z := dist_pos.2 hxz
    have hm0 : 0 < min (R - dist x y) (R - dist z y) := lt_min (hdpos x hx) (hdpos z hz)
    have hmR : min (R - dist x y) (R - dist z y) ≤ R :=
      le_trans (min_le_left _ _) (by linarith [dist_nonneg (x := x) (y := y)])
    have h1 : (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) ≤ R ^ (1 + (α : ℝ)) :=
      Real.rpow_le_rpow hm0.le hmR (by positivity)
    have h2 : ‖smthGrad w x - smthGrad w z‖ ≤ C₀ * dist x z ^ (α : ℝ) := by
      rw [← dist_eq_norm]; exact hC₀.dist_le hx hz
    have hdα : 0 < dist x z ^ (α : ℝ) := Real.rpow_pos_of_pos hdist _
    rw [mul_div_assoc]
    refine mul_le_mul h1 ?_ (by positivity) (by positivity)
    rw [div_le_iff₀ hdα]; exact h2
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = sSup Q := ⟨_, rfl⟩
  have hL0 : 0 ≤ L := hL ▸ Real.sSup_nonneg hQnn
  have hwt : ∀ x ∈ Metric.ball y R, ∀ z ∈ Metric.ball y R,
      (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖ ≤
        L * dist x z ^ (α : ℝ) := by
    intro x hx z hz
    by_cases hxz : x = z
    · subst hxz; simp [Real.zero_rpow hαr0.ne']
    · have hdα : 0 < dist x z ^ (α : ℝ) := Real.rpow_pos_of_pos (dist_pos.2 hxz) _
      have hmem : (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) *
          ‖smthGrad w x - smthGrad w z‖ / dist x z ^ (α : ℝ) ∈ Q := by
        rw [hQ]; exact ⟨x, hx, z, hz, hxz, rfl⟩
      have := le_csSup hQb hmem
      rw [← hL, div_le_iff₀ hdα] at this
      exact this
  obtain ⟨hI, hII⟩ := smth_sch_weighted_interp α y R K L w hR hL0 hC1 hBw hwt
  
  have hIIm : ∀ L' : ℝ, (∀ p ∈ Metric.ball y R, ∀ t : ℝ, 0 < t → t < 1 →
      ‖smthGrad w p‖ ≤ 4 * (K : ℝ) / (t * (R - dist p y)) + 2 * L' * t ^ (α : ℝ) / (R - dist p y)) →
      ∀ p ∈ Metric.ball y R, ∀ t : ℝ, 0 < t → t < 1 → ∀ d : ℝ, 0 ≤ d → d ≤ R - dist p y →
        d * ‖smthGrad w p‖ ≤ 4 * (K : ℝ) / t + 2 * L' * t ^ (α : ℝ) := by
    intro L' hL' p hp t ht0 ht1 d hd0 hdp
    have hpp := hdpos p hp
    calc d * ‖smthGrad w p‖ ≤ (R - dist p y) * ‖smthGrad w p‖ :=
          mul_le_mul_of_nonneg_right hdp (norm_nonneg _)
      _ ≤ (R - dist p y) * (4 * (K : ℝ) / (t * (R - dist p y)) +
            2 * L' * t ^ (α : ℝ) / (R - dist p y)) :=
          mul_le_mul_of_nonneg_left (hL' p hp t ht0 ht1) hpp.le
      _ = 4 * (K : ℝ) / t + 2 * L' * t ^ (α : ℝ) := by
          field_simp
  
  have key : L ≤ L₀ := by
    by_contra hcon
    push_neg at hcon
    have hLpos : 0 < L := by linarith
    have hQne : Q.Nonempty := by
      by_contra hne
      rw [Set.not_nonempty_iff_eq_empty] at hne
      rw [hne, Real.sSup_empty] at hL
      linarith
    obtain ⟨v, hvQ, hv⟩ := exists_lt_of_lt_csSup hQne (show L / 2 < sSup Q by rw [← hL]; linarith)
    rw [hQ] at hvQ
    obtain ⟨x₀, hx₀, z₀, hz₀, hxz, rfl⟩ := hvQ
    generalize hd₀def : min (R - dist x₀ y) (R - dist z₀ y) = d₀ at hv
    generalize hρdef : dist x₀ z₀ = ρ at hv
    generalize hDdef : ‖smthGrad w x₀ - smthGrad w z₀‖ = D at hv
    have hx₀p := hdpos x₀ hx₀
    have hz₀p := hdpos z₀ hz₀
    have hd₀x : d₀ ≤ R - dist x₀ y := hd₀def ▸ min_le_left _ _
    have hd₀z : d₀ ≤ R - dist z₀ y := hd₀def ▸ min_le_right _ _
    have hd₀p : 0 < d₀ := hd₀def ▸ lt_min hx₀p hz₀p
    have hd₀R : d₀ ≤ R := by linarith [dist_nonneg (x := x₀) (y := y)]
    have hρp : 0 < ρ := hρdef ▸ dist_pos.2 hxz
    have hρα : 0 < ρ ^ (α : ℝ) := Real.rpow_pos_of_pos hρp _
    have hdα : 0 < d₀ ^ (α : ℝ) := Real.rpow_pos_of_pos hd₀p _
    have hd1α : d₀ ^ (1 + (α : ℝ)) = d₀ * d₀ ^ (α : ℝ) := by
      rw [Real.rpow_add hd₀p, Real.rpow_one]
    have hstar : L / 2 * ρ ^ (α : ℝ) < d₀ * d₀ ^ (α : ℝ) * D := by
      rw [lt_div_iff₀ hρα, hd1α] at hv; exact hv
    
    have hgx := hIIm L hII x₀ hx₀ τ hτ0 hτ1 d₀ hd₀p.le hd₀x
    have hgz := hIIm L hII z₀ hz₀ τ hτ0 hτ1 d₀ hd₀p.le hd₀z
    have hDle : D ≤ ‖smthGrad w x₀‖ + ‖smthGrad w z₀‖ := hDdef ▸ norm_sub_le _ _
    have hσα : 0 < σ ^ (α : ℝ) := Real.rpow_pos_of_pos hσ0 _
    have h7a : ρ ≤ σ * d₀ := by
      by_contra h
      push_neg at h
      have hsd : σ ^ (α : ℝ) * d₀ ^ (α : ℝ) ≤ ρ ^ (α : ℝ) := by
        rw [← Real.mul_rpow hσ0.le hd₀p.le]
        exact Real.rpow_le_rpow (mul_nonneg hσ0.le hd₀p.le) h.le hαr0.le
      have h1 : d₀ * D ≤ 2 * (4 * (K : ℝ) / τ + 2 * L * τ ^ (α : ℝ)) := by
        have := mul_le_mul_of_nonneg_left hDle hd₀p.le
        linarith only [this, hgx, hgz]
      have h2 : d₀ ^ (α : ℝ) * (L / 2 * σ ^ (α : ℝ)) <
          d₀ ^ (α : ℝ) * (2 * (4 * (K : ℝ) / τ + 2 * L * τ ^ (α : ℝ))) := by
        have e1 := mul_le_mul_of_nonneg_left hsd (by linarith only [hLpos] : (0 : ℝ) ≤ L / 2)
        have e2 := mul_le_mul_of_nonneg_left h1 hdα.le
        linarith only [e1, e2, hstar]
      have h3 := lt_of_mul_lt_mul_left h2 hdα.le
      have h4 := mul_le_mul_of_nonneg_left hτσ hLpos.le
      have h5 : L * σ ^ (α : ℝ) < 32 * (K : ℝ) / τ := by
        have e3 : 32 * (K : ℝ) / τ = 8 * (4 * (K : ℝ) / τ) := by ring
        rw [e3]; linarith only [h3, h4]
      have h6 : L < 32 * (K : ℝ) / (σ ^ (α : ℝ) * τ) := by
        rw [lt_div_iff₀ (mul_pos hσα hτ0)]
        have e4 : 32 * (K : ℝ) / τ * τ = 32 * K := div_mul_cancel₀ _ hτ0.ne'
        have := mul_lt_mul_of_pos_right h5 hτ0
        rw [e4] at this
        linarith only [this]
      linarith only [h6, hL2, hcon]
    
    obtain ⟨T, hT_def⟩ : ∃ T : ℝ, T = d₀ / (2 * ρ) := ⟨_, rfl⟩
    obtain ⟨κ, hκ_def⟩ : ∃ κ : ℝ, κ = L * ρ ^ (α : ℝ) / (d₀ * d₀ ^ (α : ℝ)) := ⟨_, rfl⟩
    have hκ : 0 < κ := by rw [hκ_def]; positivity
    have hT : 0 < T := by rw [hT_def]; positivity
    have hTσ : 1 / (2 * σ) ≤ T := by
      rw [hT_def, div_le_div_iff₀ (by positivity) (by positivity)]; linarith
    have hT2 : 2 ≤ T := le_trans (by rw [le_div_iff₀ (by positivity)]; linarith) hTσ
    have hTε : 1 / ε ≤ T := by
      have h1 : 1 / ε ≤ 1 / e := one_div_le_one_div_of_le he heε
      have h2 : 1 / e ≤ 1 / (2 * σ) := one_div_le_one_div_of_le (by positivity) (by linarith)
      linarith
    have hρT : ρ * T = d₀ / 2 := by rw [hT_def]; field_simp
    have hsub : Metric.ball x₀ (ρ * T) ⊆ Metric.ball y R := by
      intro q hq
      rw [Metric.mem_ball] at hq ⊢
      rw [hρT] at hq
      have := dist_triangle q x₀ y
      linarith
    obtain ⟨W, hW⟩ : ∃ W : (Fin 2 → ℝ) → ℝ, ∀ ζ, W ζ = (w (x₀ + ρ • ζ) - w x₀ -
        ρ * ∑ j : Fin 2, smthGrad w x₀ j * ζ j) / (ρ * κ) := ⟨_, fun _ => rfl⟩
    obtain ⟨G, hG⟩ : ∃ G : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ ζ i, G ζ i = (F (x₀ + ρ • ζ) i - F x₀ i -
        ∑ j : Fin 2, (a (x₀ + ρ • ζ) i j - a x₀ i j) * smthGrad w x₀ j) / κ :=
      ⟨_, fun _ _ => rfl⟩
    obtain ⟨hWC, hWg, hWsol⟩ := smth_sch_blowup_eq a F w (Metric.ball y R) Metric.isOpen_ball
      haC hFC hC1 hSol x₀ ρ κ T hρp hκ hT hsub W hW G hG
    
    have hdistA : ∀ ζ : Fin 2 → ℝ, dist (x₀ + ρ • ζ) x₀ = ρ * ‖ζ‖ := by
      intro ζ
      rw [dist_eq_norm, show x₀ + ρ • ζ - x₀ = ρ • ζ by abel, norm_smul,
        Real.norm_of_nonneg hρp.le]
    have hdistAA : ∀ ζ ζ' : Fin 2 → ℝ, dist (x₀ + ρ • ζ) (x₀ + ρ • ζ') = ρ * ‖ζ - ζ'‖ := by
      intro ζ ζ'
      rw [dist_eq_norm, show x₀ + ρ • ζ - (x₀ + ρ • ζ') = ρ • (ζ - ζ') by rw [smul_sub]; abel,
        norm_smul, Real.norm_of_nonneg hρp.le]
    have hAin : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T,
        x₀ + ρ • ζ ∈ Metric.ball x₀ ((R - dist x₀ y) / 2) := by
      intro ζ hζ
      rw [Metric.mem_ball, dist_zero_right] at hζ
      rw [Metric.mem_ball, hdistA]
      have := mul_lt_mul_of_pos_left hζ hρp
      rw [hρT] at this
      linarith
    have hAS : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, x₀ + ρ • ζ ∈ Metric.ball y R := by
      intro ζ hζ
      apply hsub
      rw [Metric.mem_ball, dist_zero_right] at hζ
      rw [Metric.mem_ball, hdistA]
      exact mul_lt_mul_of_pos_left hζ hρp
    have hgW : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T,
        smthGrad W ζ - smthGrad W ζ' =
          κ⁻¹ • (smthGrad w (x₀ + ρ • ζ) - smthGrad w (x₀ + ρ • ζ')) := by
      intro ζ hζ ζ' hζ'
      funext j
      rw [Pi.sub_apply, hWg ζ hζ j, hWg ζ' hζ' j, Pi.smul_apply, Pi.sub_apply, smul_eq_mul,
        div_sub_div_same, div_eq_inv_mul]
      congr 1
      ring
    
    have h6 : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ∀ ζ' ∈ Metric.ball (0 : Fin 2 → ℝ) T,
        ‖smthGrad W ζ - smthGrad W ζ'‖ ≤ 4 * ‖ζ - ζ'‖ ^ (α : ℝ) := by
      intro ζ hζ ζ' hζ'
      rw [hgW ζ hζ ζ' hζ', norm_smul, norm_inv, Real.norm_of_nonneg hκ.le]
      have hI1 := hI x₀ hx₀ (x₀ + ρ • ζ) (hAin ζ hζ) (x₀ + ρ • ζ') (hAin ζ' hζ')
      rw [hdistAA, Real.mul_rpow hρp.le (norm_nonneg _)] at hI1
      have hc : (2 / (R - dist x₀ y)) ^ (1 + (α : ℝ)) ≤ (2 / d₀) ^ (1 + (α : ℝ)) :=
        Real.rpow_le_rpow (by positivity) (div_le_div_of_nonneg_left (by norm_num) hd₀p hd₀x)
          (by positivity)
      have hc2 : (2 / d₀) ^ (1 + (α : ℝ)) * (d₀ * d₀ ^ (α : ℝ)) = 2 ^ (1 + (α : ℝ)) := by
        rw [← hd1α, ← Real.mul_rpow (by positivity) hd₀p.le, div_mul_cancel₀ _ hd₀p.ne']
