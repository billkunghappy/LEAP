    have hpos : 0 < ∫ x in {x : E3 | 0 < x 0}, -(σ * partialDeriv 0 K x) := by
      rw [setIntegral_pos_iff_support_of_nonneg_ae hnn (hIK.const_mul σ).neg.integrableOn]
      obtain ⟨O, hO⟩ : ∃ O : Set E3,
          O = {x : E3 | deriv lam (x 0) < 0} ∩ {x : E3 | dist (pr x) xs < δ} ∩
            {x : E3 | 0 < x 0} :=
        ⟨_, rfl⟩
      have hOo : IsOpen O := by
        rw [hO]
        refine ((isOpen_lt (hdcont.comp hπ0) continuous_const).inter
          (isOpen_lt (hprC.continuous.dist continuous_const) continuous_const)).inter
          (isOpen_lt continuous_const hπ0)
      have hOne : O.Nonempty := by
        refine ⟨xs + t₁ • e 0, ?_⟩
        rw [hO]
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · show deriv lam ((xs + t₁ • e 0) 0) < 0
          rw [hcoord, hxs0, zero_add]; exact ht₁neg
        · show dist (pr (xs + t₁ • e 0)) xs < δ
          rw [hpr_line, hpr_face xs hxs0, dist_self]; exact hδ
        · show 0 < (xs + t₁ • e 0) 0
          rw [hcoord, hxs0, zero_add]; exact ht₁.1
      have hOsub : O ⊆ Function.support (fun x => -(σ * partialDeriv 0 K x)) ∩
          {x : E3 | 0 < x 0} := by
        intro x hx
        rw [hO] at hx
        obtain ⟨⟨h1, h2⟩, h3⟩ := hx
        refine ⟨?_, h3⟩
        show -(σ * partialDeriv 0 K x) ≠ 0
        rw [hK0 x]
        have h4 := hσψpos (pr x) h2
        have h1' : deriv lam (x 0) < 0 := h1
        have : -(σ * (deriv lam (x 0) * (V 0 (pr x) * β (pr x)))) =
            (-deriv lam (x 0)) * (σ * (V 0 (pr x) * β (pr x))) := by ring
        rw [this]
        exact ne_of_gt (mul_pos (by linarith) h4)
      exact lt_of_lt_of_le (hOo.measure_pos volume hOne) (measure_mono hOsub)
    linarith
  
  have heq := hS4 (fun a y => ∑ b : Fin 3, A y a b * partialDeriv b v' y) hV
    (fun ζ h1 h2 h3 => hB ζ h1 h2 (subset_trans h3 Set.inter_subset_left))
  have hcon := hS6 (fun a y => ∑ b : Fin 3, A y a b * partialDeriv b v' y) hV hB heq
  exact ⟨fun x hx hx0 => heq x hx hx0, fun x hx hx0 => hcon x hx hx0⟩

theorem flat_conormal_regularity (c : E3) (r : ℝ) (hr : 0 < r) (hc : c 0 = 0 ∨ r ≤ c 0)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c r))
    (hAs : ∀ x ∈ Metric.ball c r, ∀ a b : Fin 3, A x a b = A x b a)
    (hApos : ∀ x ∈ Metric.ball c r, (A x).PosDef)
    (F : E3 → ℝ) (hF : ContDiffOn ℝ ∞ F (Metric.ball c r))
    (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ) (vn : ℕ → E3 → ℝ)
    (hvn : ∀ m, ContDiffOn ℝ ∞ (vn m) (Metric.ball c r))
    (hvL : MemLp v 2 (volume.restrict (ndsHalf c r)))
    (hGL : ∀ a, MemLp (Gr a) 2 (volume.restrict (ndsHalf c r)))
    (hv0 : Tendsto (fun m => ∫ x in ndsHalf c r, (vn m x - v x) ^ 2) atTop (𝓝 0))
    (hv1 : ∀ a, Tendsto (fun m => ∫ x in ndsHalf c r,
      (partialDeriv a (vn m) x - Gr a x) ^ 2) atTop (𝓝 0))
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c (r / 2) →
      ∫ x in ndsHalf c r,
        (∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x + F x * ζ x) = 0) :
    ∃ v' : E3 → ℝ, ContDiffOn ℝ ∞ v' (Metric.ball c (r / 4)) ∧
      (∀ᵐ x ∂(volume.restrict (Metric.ball c (r / 4) ∩ {x : E3 | 0 < x 0})), v x = v' x) ∧
      (∀ x ∈ Metric.ball c (r / 4), 0 ≤ x 0 →
        ∑ a : Fin 3, partialDeriv a (fun y => ∑ b : Fin 3, A y a b * partialDeriv b v' y) x = F x) ∧
      (∀ x ∈ Metric.ball c (r / 4), x 0 = 0 → ∑ b : Fin 3, A x 0 b * partialDeriv b v' x = 0) :=
by
  have hw1 := fcr_weak_grad c r hr v Gr vn hvn hvL hGL hv0 hv1
  have hreg := fcr_regularity_all_orders c r (r / 2) (3 * r / 8) (by linarith) (by linarith)
    (by linarith) A hA hAs hApos F hF v _ hw1
    (fun ζ h1 h2 h3 => hweak ζ h1 h2 h3)
  obtain ⟨v', hv', hae⟩ := fcr_smooth_representative c (3 * r / 8) (r / 4) (by linarith)
    (by linarith) v hreg
  have hsub : Metric.ball c (r / 2) ⊆ Metric.ball c r :=
    Metric.ball_subset_ball (by linarith)
  obtain ⟨h3, h4⟩ := fcr_weak_to_strong c (r / 2) (r / 4) (by linarith) (by linarith) A
    (fun a b => (hA a b).mono hsub) F (hF.mono hsub) v Gr hGL
    (fun a ζ h1 h2 h3 => hw1.2.2 [] a (by simp) ζ h1 h2 h3)
    (fun ζ h1 h2 h3 => hweak ζ h1 h2 h3) v' hv' hae
  exact ⟨v', hv'.contDiffOn, hae, h3, h4⟩

theorem fdr_zero_trace_limit (c : E3) (r : ℝ) (hr : 0 < r)
    (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ) (vn : ℕ → E3 → ℝ)
    (hvn : ∀ m, ContDiffOn ℝ ∞ (vn m) (Metric.ball c r))
    (hvz : ∀ m, ∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball c r | x 0 = 0} ⊆ O ∧
      ∀ x ∈ O, vn m x = 0)
    (hvL : MemLp v 2 (volume.restrict (ndsHalf c r)))
    (hGL : ∀ a, MemLp (Gr a) 2 (volume.restrict (ndsHalf c r)))
    (hv0 : Tendsto (fun m => ∫ x in ndsHalf c r, (vn m x - v x) ^ 2) atTop (𝓝 0))
    (hv1 : ∀ a, Tendsto (fun m => ∫ x in ndsHalf c r,
      (partialDeriv a (vn m) x - Gr a x) ^ 2) atTop (𝓝 0)) :
    fdrZT c (r / 2) v Gr :=
by
  have h0 : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hHo : IsOpen (ndsHalf c r) := Metric.isOpen_ball.inter (isOpen_lt continuous_const h0)
  have hHm : MeasurableSet (ndsHalf c r) := hHo.measurableSet
  
  have memLp_half : ∀ g : E3 → ℝ, ContinuousOn g (Metric.ball c r) →
      MemLp g 2 (volume.restrict (ndsHalf c r)) := by
    intro g hg
    have hsubB : ndsHalf c r ⊆ Metric.ball c r :=
      fun x hx => Metric.ball_subset_ball (by linarith) hx.1
    have hsubK : ndsHalf c r ⊆ Metric.closedBall c (r / 2) :=
      fun x hx => Metric.ball_subset_closedBall hx.1
    obtain ⟨C, hC⟩ := (isCompact_closedBall c (r / 2)).exists_bound_of_continuousOn
      (hg.mono (Metric.closedBall_subset_ball (by linarith)))
    haveI : IsFiniteMeasure (volume.restrict (ndsHalf c r)) :=
      isFiniteMeasure_restrict.mpr (ne_of_lt (lt_of_le_of_lt
        (measure_mono (Set.inter_subset_left)) measure_ball_lt_top))
    have htop : MemLp g ⊤ (volume.restrict (ndsHalf c r)) :=
      memLp_top_of_bound ((hg.mono hsubB).aestronglyMeasurable hHm) C
        (ae_restrict_of_forall_mem hHm (fun x hx => hC x (hsubK hx)))
    exact htop.mono_exponent le_top
  
  have L2pair : ∀ (u : ℕ → E3 → ℝ) (v ψ : E3 → ℝ),
      (∀ m, MemLp (u m) 2 (volume.restrict (ndsHalf c r))) →
      MemLp v 2 (volume.restrict (ndsHalf c r)) → MemLp ψ 2 (volume.restrict (ndsHalf c r)) →
      Tendsto (fun m => ∫ x in ndsHalf c r, (u m x - v x) ^ 2) atTop (𝓝 0) →
      Tendsto (fun m => ∫ x in ndsHalf c r, u m x * ψ x) atTop
        (𝓝 (∫ x in ndsHalf c r, v x * ψ x)) := by
    intro u v ψ hu hv hψ h
    set μ := volume.restrict (ndsHalf c r) with hμ
    set P := ∫ x, ψ x ^ 2 ∂μ with hP
    have hP0 : 0 ≤ P := integral_nonneg (fun x => sq_nonneg _)
    have hψ2 : Integrable (fun x => ψ x ^ 2) μ := hψ.integrable_sq
    have pw : ∀ (t A B : ℝ), 0 < t → |A * B| ≤ (t * A ^ 2 + B ^ 2 / t) / 2 := by
      intro t A B ht
      rw [abs_mul]
      have h1 : 0 ≤ (t * |A| - |B|) ^ 2 := sq_nonneg _
      have h2 : (t * A ^ 2 + B ^ 2 / t) / 2 - |A| * |B| = (t * |A| - |B|) ^ 2 / (2 * t) := by
        rw [← sq_abs A, ← sq_abs B]
        field_simp
        ring
      have h3 : 0 ≤ (t * |A| - |B|) ^ 2 / (2 * t) := div_nonneg h1 (by linarith)
      linarith
    have key : ∀ m, ∀ t : ℝ, 0 < t →
        |∫ x, u m x * ψ x ∂μ - ∫ x, v x * ψ x ∂μ| ≤
          (t * ∫ x, (u m x - v x) ^ 2 ∂μ + P / t) / 2 := by
      intro m t ht
      have hd : MemLp (u m - v) 2 μ := (hu m).sub hv
      have hd2 : Integrable (fun x => (u m x - v x) ^ 2) μ := hd.integrable_sq
      have i1 : Integrable (fun x => u m x * ψ x) μ := (hu m).integrable_mul hψ
      have i2 : Integrable (fun x => v x * ψ x) μ := hv.integrable_mul hψ
      have i3 : Integrable (fun x => (u m x - v x) * ψ x) μ := hd.integrable_mul hψ
      rw [← integral_sub i1 i2]
      have e1 : (fun x => u m x * ψ x - v x * ψ x) = fun x => (u m x - v x) * ψ x := by
        funext x; ring
      rw [e1]
      refine (abs_integral_le_integral_abs).trans ?_
      have i5 : Integrable (fun x => t * (u m x - v x) ^ 2) μ := hd2.const_mul t
      have i6 : Integrable (fun x => ψ x ^ 2 / t) μ := hψ2.div_const t
      have i4 : Integrable (fun x => (t * (u m x - v x) ^ 2 + ψ x ^ 2 / t) / 2) μ :=
        (i5.add i6).div_const 2
      calc ∫ x, |(u m x - v x) * ψ x| ∂μ
          ≤ ∫ x, (t * (u m x - v x) ^ 2 + ψ x ^ 2 / t) / 2 ∂μ :=
            integral_mono i3.abs i4 (fun x => pw t _ _ ht)
        _ = (t * ∫ x, (u m x - v x) ^ 2 ∂μ + P / t) / 2 := by
            rw [integral_div, integral_add i5 i6, integral_const_mul, integral_div]
    rw [Metric.tendsto_atTop]
    intro δ hδ
    obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = (P + 1) / δ := ⟨_, rfl⟩
    have ht : 0 < t := by rw [ht_def]; exact div_pos (by linarith) hδ
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp h (δ / t) (div_pos hδ ht)
    refine ⟨N, fun m hm => ?_⟩
    have h1 := hN m hm
    rw [Real.dist_eq, sub_zero] at h1
    rw [Real.dist_eq]
    have h2 := key m t ht
    have hε : ∫ x, (u m x - v x) ^ 2 ∂μ < δ / t := lt_of_le_of_lt (le_abs_self _) h1
    have h3 : t * ∫ x, (u m x - v x) ^ 2 ∂μ < δ := by
      rw [lt_div_iff₀ ht] at hε
      linarith
    have h4 : P / t < δ := by
      rw [div_lt_iff₀ ht]
      have : δ * t = P + 1 := by rw [ht_def]; field_simp
      linarith
    linarith
  intro a ζ hζ hζc hζs
  show ∫ x in ndsHalf c r, v x * partialDeriv a ζ x = -∫ x in ndsHalf c r, Gr a x * ζ x
  
  
  have smooth_ibp : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f (Metric.ball c r) →
      (∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball c r | x 0 = 0} ⊆ O ∧ ∀ x ∈ O, f x = 0) →
      ∫ x in ndsHalf c r, f x * partialDeriv a ζ x =
        -∫ x in ndsHalf c r, partialDeriv a f x * ζ x := by
    intro f hf hfz
    obtain ⟨O, hOo, hOf, hO0⟩ := hfz
    have hTB : tsupport ζ ⊆ Metric.ball c r :=
      hζs.trans (Metric.ball_subset_ball (by linarith))
    have hPo : IsOpen (Metric.ball c r ∩ {x : E3 | 0 < x 0}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const h0)
    have hfd : ∀ x ∈ Metric.ball c r, ContDiffAt ℝ ∞ f x :=
      fun x hx => hf.contDiffAt (Metric.isOpen_ball.mem_nhds hx)
    have hζ0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
    have hdζ0 : ∀ x, x ∉ tsupport ζ → fderiv ℝ ζ x = 0 := by
      intro x hx
      by_contra hne
      exact hx (support_fderiv_subset ℝ hne)
    obtain ⟨w, hw⟩ : ∃ w : E3 → ℝ, w = fun x => if 0 < x 0 then f x * ζ x else 0 := ⟨_, rfl⟩
    have hw' : ∀ x, w x = if 0 < x 0 then f x * ζ x else 0 := fun x => by rw [hw]
    
    have hZ : ∀ x, x ∉ ndsHalf c r → w =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      by_cases hxT : x ∈ tsupport ζ
      · have hxb : x ∈ Metric.ball c (r / 2) := hζs hxT
        have hx0 : ¬ 0 < x 0 := fun h => hx ⟨hxb, h⟩
        rcases lt_or_eq_of_le (not_lt.mp hx0) with hlt | heq
        · filter_upwards [(isOpen_lt h0 continuous_const).mem_nhds
            (show x ∈ {y : E3 | y 0 < 0} from hlt)] with y hy
          have hy' : ¬ 0 < y 0 := not_lt.mpr (le_of_lt hy)
          rw [hw' y, if_neg hy']
        · filter_upwards [hOo.mem_nhds (hOf ⟨hTB hxT, heq⟩)] with y hy
          rw [hw' y, hO0 y hy, zero_mul, ite_self]
      · filter_upwards [(isClosed_tsupport ζ).isOpen_compl.mem_nhds hxT] with y hy
        rw [hw' y, hζ0 y hy, mul_zero, ite_self]
    
    have hP : ∀ x ∈ Metric.ball c r ∩ {x : E3 | 0 < x 0}, w =ᶠ[𝓝 x] fun y => f y * ζ y := by
      intro x hx
      filter_upwards [hPo.mem_nhds hx] with y hy
      have hy' : 0 < y 0 := hy.2
      rw [hw' y, if_pos hy']
    have hHP : ∀ x ∈ ndsHalf c r, x ∈ Metric.ball c r ∩ {x : E3 | 0 < x 0} :=
      fun x hx => ⟨Metric.ball_subset_ball (by linarith) hx.1, hx.2⟩
    have hwsm : ContDiff ℝ ∞ w := by
      rw [contDiff_iff_contDiffAt]
      intro x
      by_cases hx : x ∈ ndsHalf c r
      · exact ((hfd x (hHP x hx).1).mul hζ.contDiffAt).congr_of_eventuallyEq (hP x (hHP x hx))
      · exact contDiffAt_const.congr_of_eventuallyEq (hZ x hx)
    have hwc : HasCompactSupport w := by
      refine hζc.mono' ?_
      intro x hx
      refine subset_tsupport ζ (fun hz => hx ?_)
      rw [hw' x, hz, mul_zero, ite_self]
    have hdw : ∀ x, partialDeriv a w x = (ndsHalf c r).indicator
        (fun y => partialDeriv a f y * ζ y + f y * partialDeriv a ζ y) x := by
      intro x
      by_cases hx : x ∈ ndsHalf c r
      · rw [Set.indicator_of_mem hx]
        unfold partialDeriv
        rw [(hP x (hHP x hx)).fderiv_eq]
        have hfdx : DifferentiableAt ℝ f x := ((hfd x (hHP x hx).1).differentiableAt (by simp))
        have hζdx : DifferentiableAt ℝ ζ x := hζ.contDiffAt.differentiableAt (by simp)
        rw [show (fun y => f y * ζ y) = f * ζ from rfl, fderiv_mul hfdx hζdx]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · rw [Set.indicator_of_notMem hx]
        unfold partialDeriv
        rw [(hZ x hx).fderiv_eq, fderiv_const_apply]
        simp
    have hdwc : Continuous (fun x => fderiv ℝ w x (e a)) :=
      (hwsm.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdws : HasCompactSupport (fun x => fderiv ℝ w x (e a)) := hwc.fderiv_apply ℝ (e a)
    have hI0 : Integrable (fun x => fderiv ℝ (fun _ : E3 => (1 : ℝ)) x (e a) * w x) := by
      simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, zero_mul]
      exact integrable_zero _ _ _
    have hI1 : Integrable (fun x => (fun _ : E3 => (1 : ℝ)) x * fderiv ℝ w x (e a)) := by
      simp only [one_mul]
      exact hdwc.integrable_of_hasCompactSupport hdws
    have hI2 : Integrable (fun x => (fun _ : E3 => (1 : ℝ)) x * w x) := by
      simp only [one_mul]
      exact hwsm.continuous.integrable_of_hasCompactSupport hwc
    have hint0 : ∫ x, partialDeriv a w x = 0 := by
      have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
        (f := fun _ : E3 => (1 : ℝ)) (g := w) (v := e a) hI0 hI1 hI2
        (differentiable_const _) (hwsm.differentiable (by simp))
      simp only [one_mul, fderiv_const_apply, ContinuousLinearMap.zero_apply, zero_mul,
        integral_zero, neg_zero] at h
      exact h
    have hP1c : Continuous (fun y => partialDeriv a f y * ζ y) := by
      refine continuous_iff_continuousAt.mpr fun x => ?_
      by_cases hx : x ∈ Metric.ball c r
      · have h1 : ContinuousAt (fderiv ℝ f) x :=
          (hf.continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).continuousAt
            (Metric.isOpen_ball.mem_nhds hx)
        exact (h1.clm_apply continuousAt_const).mul hζ.continuous.continuousAt
      · have hxT : x ∉ tsupport ζ := fun h => hx (hTB h)
        refine (continuousAt_const (y := (0 : ℝ))).congr ?_
        filter_upwards [(isClosed_tsupport ζ).isOpen_compl.mem_nhds hxT] with y hy
        rw [hζ0 y hy, mul_zero]
    have hP2c : Continuous (fun y => f y * partialDeriv a ζ y) := by
      refine continuous_iff_continuousAt.mpr fun x => ?_
      by_cases hx : x ∈ Metric.ball c r
      · have h1 : ContinuousAt f x :=
          hf.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hx)
        have h2 : Continuous (fun y => fderiv ℝ ζ y (e a)) :=
          (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
        exact h1.mul h2.continuousAt
      · have hxT : x ∉ tsupport ζ := fun h => hx (hTB h)
        refine (continuousAt_const (y := (0 : ℝ))).congr ?_
        filter_upwards [(isClosed_tsupport ζ).isOpen_compl.mem_nhds hxT] with y hy
        show (0 : ℝ) = f y * fderiv ℝ ζ y (e a)
        rw [hdζ0 y hy, ContinuousLinearMap.zero_apply, mul_zero]
    have hP1s : HasCompactSupport (fun y => partialDeriv a f y * ζ y) := by
      refine hζc.mono' ?_
      intro x hx
      by_contra hxT
      exact hx (by simp only [hζ0 x hxT, mul_zero])
    have hP2s : HasCompactSupport (fun y => f y * partialDeriv a ζ y) := by
      refine hζc.mono' ?_
      intro x hx
      by_contra hxT
      apply hx
      show f x * fderiv ℝ ζ x (e a) = 0
      rw [hdζ0 x hxT, ContinuousLinearMap.zero_apply, mul_zero]
    have hJ1 : Integrable (fun y => partialDeriv a f y * ζ y) :=
      hP1c.integrable_of_hasCompactSupport hP1s
    have hJ2 : Integrable (fun y => f y * partialDeriv a ζ y) :=
      hP2c.integrable_of_hasCompactSupport hP2s
    have hfun : (fun x => partialDeriv a w x) = (ndsHalf c r).indicator
        (fun y => partialDeriv a f y * ζ y + f y * partialDeriv a ζ y) := funext hdw
    have hsum : ∫ x in ndsHalf c r, (partialDeriv a f x * ζ x + f x * partialDeriv a ζ x)
        = 0 := by
      rw [← integral_indicator hHm, ← hfun]
      exact hint0
    rw [integral_add hJ1.integrableOn hJ2.integrableOn] at hsum
    linarith
  
  have hdζc : Continuous (partialDeriv a ζ) :=
    (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hvnL : ∀ m, MemLp (vn m) 2 (volume.restrict (ndsHalf c r)) :=
    fun m => memLp_half _ (hvn m).continuousOn
  have hdvnL : ∀ m, MemLp (partialDeriv a (vn m)) 2 (volume.restrict (ndsHalf c r)) :=
    fun m => memLp_half _
      (((hvn m).continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).clm_apply
        continuousOn_const)
  have L1 := L2pair vn v (partialDeriv a ζ) hvnL hvL (memLp_half _ hdζc.continuousOn) hv0
  have L2 := L2pair (fun m => partialDeriv a (vn m)) (Gr a) ζ
    hdvnL (hGL a) (memLp_half _ hζ.continuous.continuousOn) (hv1 a)
  have L1' : Tendsto (fun m => -∫ x in ndsHalf c r, partialDeriv a (vn m) x * ζ x) atTop
      (𝓝 (∫ x in ndsHalf c r, v x * partialDeriv a ζ x)) :=
    L1.congr (fun m => smooth_ibp (vn m) (hvn m) (hvz m))
  exact tendsto_nhds_unique L1' L2.neg

theorem fdr_prob_mono (c : E3) (s s₁ : ℝ) (hs : s₁ ≤ s) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fdrProb c s A w D G F) : fdrProb c s₁ A w D G F :=
by
  obtain ⟨hSob, hZT, hG, hF, hW⟩ := hP
  have hball : Metric.ball c s₁ ⊆ Metric.ball c s := Metric.ball_subset_ball hs
  have hmeas : MeasurableSet (fcrHalf c s) := by
    have h0 : Continuous (fun x : E3 => x 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
    exact (Metric.isOpen_ball.inter (isOpen_lt continuous_const h0)).measurableSet
  have hsub : fcrHalf c s₁ ⊆ fcrHalf c s := fun x hx => ⟨hball hx.1, hx.2⟩
  have hL2 : ∀ φ : E3 → ℝ, MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp φ 2 (volume.restrict (fcrHalf c s₁)) :=
    fun φ h => h.mono_measure (Measure.restrict_mono hsub le_rfl)
  have hSob' : fcrSob c s₁ 1 w D :=
    ⟨hSob.1, fun L hL => hL2 _ (hSob.2.1 L hL),
      fun L a hL ζ h1 h2 h3 => hSob.2.2 L a hL ζ h1 h2 (h3.trans hsub)⟩
  have hK : ∀ (ζ : E3 → ℝ), tsupport ζ ⊆ Metric.ball c s₁ → ∀ f : E3 → ℝ,
      (∀ x, x ∉ tsupport ζ → f x = 0) →
      ∫ x in fcrHalf c s, f x = ∫ x in fcrHalf c s₁, f x := by
    intro ζ h3 f hf
    refine MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hmeas hsub
      (fun x hx => hf x ?_)
    intro hxt
    exact hx.2 ⟨h3 hxt, hx.1.2⟩
  have hz0 : ∀ (ζ : E3 → ℝ) (x : E3), x ∉ tsupport ζ → ζ x = 0 :=
    fun ζ x hx => image_eq_zero_of_notMem_tsupport hx
  have hd0 : ∀ (ζ : E3 → ℝ) (x : E3) (a : Fin 3), x ∉ tsupport ζ → partialDeriv a ζ x = 0 := by
    intro ζ x a hxt
    have hfd : fderiv ℝ ζ x = 0 := by
      by_contra hne
      exact hxt (support_fderiv_subset ℝ hne)
    simp [partialDeriv, hfd]
  refine ⟨hSob', ?_, fun a => hL2 (G a) (hG a), hL2 F hF, ?_⟩
  · intro a ζ h1 h2 h3
    have h := hZT a ζ h1 h2 (h3.trans hball)
    have e1 := hK ζ h3 (fun x => w x * partialDeriv a ζ x)
      (fun x hx => by simp [hd0 ζ x a hx])
    have e2 := hK ζ h3 (fun x => D [a] x * ζ x)
      (fun x hx => by simp [hz0 ζ x hx])
    exact e1.symm.trans (h.trans (congrArg Neg.neg e2))
  · rintro ζ h1 h2 h3 ⟨O₁, hO₁, hsub₁, hz₁⟩
    have hOo : IsOpen (O₁ ∪ (tsupport ζ)ᶜ) := hO₁.union (isClosed_tsupport ζ).isOpen_compl
    have hOf : {x ∈ Metric.ball c s | x 0 = 0} ⊆ O₁ ∪ (tsupport ζ)ᶜ := by
      intro x hx
      by_cases hxt : x ∈ tsupport ζ
      · exact Or.inl (hsub₁ ⟨h3 hxt, hx.2⟩)
      · exact Or.inr hxt
    have hOz : ∀ x ∈ O₁ ∪ (tsupport ζ)ᶜ, ζ x = 0 := by
      rintro x (hx | hx)
      · exact hz₁ x hx
      · exact hz0 ζ x hx
    have h := hW ζ h1 h2 (h3.trans hball) ⟨_, hOo, hOf, hOz⟩
    have e := hK ζ h3 (fun x => ∑ a : Fin 3,
        ((∑ b : Fin 3, A x a b * D [b] x) + G a x) * partialDeriv a ζ x + F x * ζ x)
      (fun x hx => by
        have hd := fun a => hd0 ζ x a hx
        simp [hz0 ζ x hx, hd])
    exact e.symm.trans h

theorem fdr_normal_step (c : E3) (R s : ℝ) (hsR : s < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef)
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fdrProb c s A w D G F) (E : Fin 3 → Fin 3 → E3 → ℝ) (GD : Fin 3 → E3 → ℝ)
    (hE : ∀ a b, a ≠ 0 → fcrWD c s (D [b]) a (E a b) ∧
      MemLp (E a b) 2 (volume.restrict (fcrHalf c s)))
    (hGD : ∀ a, fcrWD c s (G a) a (GD a) ∧ MemLp (GD a) 2 (volume.restrict (fcrHalf c s))) :
    fcrWD c s (D [0]) 0 (fcrNormalZ A D E GD F) :=
by
  classical
  have hc0 : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hHopen : IsOpen (fcrHalf c s) :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const hc0)
  have hHsub : fcrHalf c s ⊆ Metric.ball c R :=
    fun x hx => Metric.ball_subset_ball hsR.le hx.1
  have h10 : (1 : Fin 3) ≠ 0 := by decide
  have h20 : (2 : Fin 3) ≠ 0 := by decide
  have h12 : (1 : Fin 3) ≠ 2 := by decide
  
  have hpd : ∀ (m' : E3 → ℝ) (a : Fin 3), ContDiffOn ℝ ∞ m' (Metric.ball c R) →
      ContDiffOn ℝ ∞ (partialDeriv a m') (Metric.ball c R) := by
    intro m' a hm'
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ m' y (e a)) (Metric.ball c R)
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 hm').2.clm_apply
      contDiffOn_const
  
  have hpdsupp : ∀ (f : E3 → ℝ) (a : Fin 3),
      Function.support (fun x => partialDeriv a f x) ⊆ tsupport f := by
    intro f a x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply tsupport_fderiv_subset (𝕜 := ℝ)
    apply subset_tsupport
    rw [Function.mem_support]
    intro h
    exact hx (by simp [partialDeriv, h])
  
  have htd : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ fcrHalf c s →
      ∀ a : Fin 3, Continuous (fun x => partialDeriv a ζ x) ∧
        HasCompactSupport (fun x => partialDeriv a ζ x) ∧
        Function.support (fun x => partialDeriv a ζ x) ⊆ fcrHalf c s := by
    intro ζ hζ hζc hζs a
    exact ⟨(hζ.continuous_fderiv (by simp)).clm_apply continuous_const,
      hζc.mono' (hpdsupp _ a), (hpdsupp _ a).trans hζs⟩
  
  have htest : ∀ m' : E3 → ℝ, ContDiffOn ℝ ∞ m' (Metric.ball c R) →
      ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ fcrHalf c s →
      ContDiff ℝ ∞ (fun x => m' x * ζ x) ∧ HasCompactSupport (fun x => m' x * ζ x) ∧
      tsupport (fun x => m' x * ζ x) ⊆ fcrHalf c s ∧
      ∀ (a : Fin 3) (x : E3), partialDeriv a (fun y => m' y * ζ y) x =
        partialDeriv a m' x * ζ x + m' x * partialDeriv a ζ x := by
    intro m' hm' ζ hζ hζc hζs
    have hoff : ∀ x, x ∉ Metric.ball c R → ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      have h := notMem_tsupport_iff_eventuallyEq.1 (fun h => hx (hHsub (hζs h)))
      filter_upwards [h] with y hy
      simpa using hy
    have hoff2 : ∀ x, x ∉ Metric.ball c R →
        (fun y => m' y * ζ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      filter_upwards [hoff x hx] with y hy
      simp [hy]
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [contDiff_iff_contDiffAt]
      intro x
      by_cases hx : x ∈ Metric.ball c R
      · exact (hm'.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).mul hζ.contDiffAt
      · exact contDiffAt_const.congr_of_eventuallyEq (hoff2 x hx)
    · exact hζc.mul_left
    · exact (tsupport_mul_subset_right).trans hζs
    · intro a x
      by_cases hx : x ∈ Metric.ball c R
      · have hmd : DifferentiableAt ℝ m' x :=
          (hm'.differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hx)
        have hζd : DifferentiableAt ℝ ζ x := hζ.differentiable (by simp) x
        unfold partialDeriv
        rw [fderiv_fun_mul hmd hζd]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have h1 : partialDeriv a (fun y => m' y * ζ y) x = 0 := by
          unfold partialDeriv
          rw [(hoff2 x hx).fderiv_eq]
          simp
        have h2 : partialDeriv a ζ x = 0 := by
          unfold partialDeriv
          rw [(hoff x hx).fderiv_eq]
          simp
        have h3 : ζ x = 0 := (hoff x hx).eq_of_nhds
        rw [h1, h2, h3]
        ring
  
  have hint : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → Function.support g ⊆ fcrHalf c s →
      Integrable (fun x => u x * g x) := by
    intro u g hu hg hgc hgs
    have hg2 : MemLp g 2 (volume.restrict (fcrHalf c s)) :=
      (hg.memLp_of_hasCompactSupport hgc).restrict _
    have h1 : Integrable (fun x => u x * g x) (volume.restrict (fcrHalf c s)) :=
      hu.integrable_mul hg2
    refine (integrableOn_iff_integrable_of_support_subset ?_).1 h1
    intro x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply hgs
    rw [Function.mem_support]
    intro h
    exact hx (by simp [h])
  
  have hwd : ∀ m' : E3 → ℝ, ContDiffOn ℝ ∞ m' (Metric.ball c R) →
      ∀ (φ ψ : E3 → ℝ) (a : Fin 3),
      MemLp φ 2 (volume.restrict (fcrHalf c s)) → MemLp ψ 2 (volume.restrict (fcrHalf c s)) →
      fcrWD c s φ a ψ →
      fcrWD c s (fun x => m' x * φ x) a (fun x => partialDeriv a m' x * φ x + m' x * ψ x) := by
    intro m' hm' φ ψ a hφ hψ hw ζ hζ hζc hζs
    obtain ⟨hη, hηc, hηs, hprod⟩ := htest m' hm' ζ hζ hζc hζs
    obtain ⟨hξ, hξc, -, -⟩ := htest (partialDeriv a m') (hpd m' a hm') ζ hζ hζc hζs
    have h0 : ∫ x, φ x * partialDeriv a (fun y => m' y * ζ y) x =
        -∫ x, ψ x * (m' x * ζ x) := hw _ hη hηc hηs
    have hsuppζ : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
    have i1 : Integrable (fun x => φ x * partialDeriv a (fun y => m' y * ζ y) x) := by
      refine hint φ _ hφ ?_ ?_ ?_
      · exact (hη.continuous_fderiv (by simp)).clm_apply continuous_const
      · exact hηc.mono' (hpdsupp _ a)
      · exact (hpdsupp _ a).trans hηs
    have i2 : Integrable (fun x => φ x * (partialDeriv a m' x * ζ x)) := by
      refine hint φ _ hφ hξ.continuous hξc ?_
      intro x hx
      simp only [Function.mem_support, ne_eq] at hx
      apply hsuppζ
      rw [Function.mem_support]
      intro h
      exact hx (by simp [h])
    have i3 : Integrable (fun x => ψ x * (m' x * ζ x)) :=
      hint ψ _ hψ hη.continuous hηc ((subset_tsupport _).trans hηs)
    have e1 : (fun x => m' x * φ x * partialDeriv a ζ x) =
        fun x => φ x * partialDeriv a (fun y => m' y * ζ y) x -
          φ x * (partialDeriv a m' x * ζ x) := by
      funext x
      rw [hprod a x]
      ring
    have e2 : (fun x => (partialDeriv a m' x * φ x + m' x * ψ x) * ζ x) =
        fun x => φ x * (partialDeriv a m' x * ζ x) + ψ x * (m' x * ζ x) := by
      funext x
      ring
    show ∫ x, m' x * φ x * partialDeriv a ζ x =
      -∫ x, (partialDeriv a m' x * φ x + m' x * ψ x) * ζ x
    rw [e1, e2, integral_sub i1 i2, integral_add i2 i3, h0]
    ring
  
  have hL2 : ∀ m' : E3 → ℝ, ContinuousOn m' (Metric.ball c R) → ∀ φ : E3 → ℝ,
      MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp (fun x => m' x * φ x) 2 (volume.restrict (fcrHalf c s)) := by
    intro m' hm' φ hφ
    obtain ⟨C, hC⟩ := (isCompact_closedBall c s).exists_bound_of_continuousOn
      (hm'.mono (Metric.closedBall_subset_ball hsR))
    have hmeas : AEStronglyMeasurable m' (volume.restrict (fcrHalf c s)) :=
      (hm'.mono hHsub).aestronglyMeasurable hHopen.measurableSet
    refine MemLp.of_le_mul (c := C) hφ (hmeas.mul hφ.1) ?_
    refine (ae_restrict_iff' hHopen.measurableSet).2 (Filter.Eventually.of_forall fun x hx => ?_)
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hC x (Metric.ball_subset_closedBall hx.1)) (norm_nonneg _)
  
  have hWadd : ∀ (a : Fin 3) (φ₁ φ₂ ψ₁ ψ₂ : E3 → ℝ),
      MemLp φ₁ 2 (volume.restrict (fcrHalf c s)) → MemLp φ₂ 2 (volume.restrict (fcrHalf c s)) →
      MemLp ψ₁ 2 (volume.restrict (fcrHalf c s)) → MemLp ψ₂ 2 (volume.restrict (fcrHalf c s)) →
      fcrWD c s φ₁ a ψ₁ → fcrWD c s φ₂ a ψ₂ →
      fcrWD c s (fun x => φ₁ x + φ₂ x) a (fun x => ψ₁ x + ψ₂ x) ∧
      fcrWD c s (fun x => φ₁ x - φ₂ x) a (fun x => ψ₁ x - ψ₂ x) := by
    intro a φ₁ φ₂ ψ₁ ψ₂ k1 k2 k3 k4 w1 w2
    constructor
    · intro ζ hζ hζc hζs
      obtain ⟨g1, g2, g3⟩ := htd ζ hζ hζc hζs a
      have hz3 : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
      have j1 := hint φ₁ _ k1 g1 g2 g3
      have j2 := hint φ₂ _ k2 g1 g2 g3
      have j3 := hint ψ₁ ζ k3 hζ.continuous hζc hz3
      have j4 := hint ψ₂ ζ k4 hζ.continuous hζc hz3
      have e1 : (fun x => (φ₁ x + φ₂ x) * partialDeriv a ζ x) =
          fun x => φ₁ x * partialDeriv a ζ x + φ₂ x * partialDeriv a ζ x := by
        funext x; ring
      have e2 : (fun x => (ψ₁ x + ψ₂ x) * ζ x) = fun x => ψ₁ x * ζ x + ψ₂ x * ζ x := by
        funext x; ring
      show ∫ x, (φ₁ x + φ₂ x) * partialDeriv a ζ x = -∫ x, (ψ₁ x + ψ₂ x) * ζ x
      rw [e1, e2, integral_add j1 j2, integral_add j3 j4, w1 ζ hζ hζc hζs, w2 ζ hζ hζc hζs]
      ring
    · intro ζ hζ hζc hζs
      obtain ⟨g1, g2, g3⟩ := htd ζ hζ hζc hζs a
      have hz3 : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
      have j1 := hint φ₁ _ k1 g1 g2 g3
      have j2 := hint φ₂ _ k2 g1 g2 g3
      have j3 := hint ψ₁ ζ k3 hζ.continuous hζc hz3
      have j4 := hint ψ₂ ζ k4 hζ.continuous hζc hz3
      have e1 : (fun x => (φ₁ x - φ₂ x) * partialDeriv a ζ x) =
          fun x => φ₁ x * partialDeriv a ζ x - φ₂ x * partialDeriv a ζ x := by
        funext x; ring
      have e2 : (fun x => (ψ₁ x - ψ₂ x) * ζ x) = fun x => ψ₁ x * ζ x - ψ₂ x * ζ x := by
        funext x; ring
      show ∫ x, (φ₁ x - φ₂ x) * partialDeriv a ζ x = -∫ x, (ψ₁ x - ψ₂ x) * ζ x
      rw [e1, e2, integral_sub j1 j2, integral_sub j3 j4, w1 ζ hζ hζc hζs, w2 ζ hζ hζc hζs]
      ring
  have hWsum : ∀ (a : Fin 3) (S : Finset (Fin 3)) (φ ψ : Fin 3 → E3 → ℝ),
      (∀ i ∈ S, MemLp (φ i) 2 (volume.restrict (fcrHalf c s)) ∧
        MemLp (ψ i) 2 (volume.restrict (fcrHalf c s)) ∧ fcrWD c s (φ i) a (ψ i)) →
      fcrWD c s (fun x => ∑ i ∈ S, φ i x) a (fun x => ∑ i ∈ S, ψ i x) := by
    intro a S φ ψ h ζ hζ hζc hζs
    obtain ⟨g1, g2, g3⟩ := htd ζ hζ hζc hζs a
    have hz3 : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
    have e1 : (fun x => (∑ i ∈ S, φ i x) * partialDeriv a ζ x) =
        fun x => ∑ i ∈ S, φ i x * partialDeriv a ζ x := by
      funext x; rw [Finset.sum_mul]
    have e2 : (fun x => (∑ i ∈ S, ψ i x) * ζ x) = fun x => ∑ i ∈ S, ψ i x * ζ x := by
      funext x; rw [Finset.sum_mul]
    show ∫ x, (∑ i ∈ S, φ i x) * partialDeriv a ζ x = -∫ x, (∑ i ∈ S, ψ i x) * ζ x
    rw [e1, e2, integral_finset_sum S (f := fun i x => φ i x * partialDeriv a ζ x)
        (fun i hi => hint (φ i) _ (h i hi).1 g1 g2 g3),
      integral_finset_sum S (f := fun i x => ψ i x * ζ x)
        (fun i hi => hint (ψ i) ζ (h i hi).2.1 hζ.continuous hζc hz3),
      ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun i hi => (h i hi).2.2 ζ hζ hζc hζs)
  have hWsmul : ∀ (m : E3 → ℝ), ContDiffOn ℝ ∞ m (Metric.ball c R) → ∀ (a : Fin 3) (φ ψ : E3 → ℝ),
      MemLp φ 2 (volume.restrict (fcrHalf c s)) → MemLp ψ 2 (volume.restrict (fcrHalf c s)) →
      fcrWD c s φ a ψ →
      MemLp (fun x => m x * φ x) 2 (volume.restrict (fcrHalf c s)) ∧
      MemLp (fun x => partialDeriv a m x * φ x + m x * ψ x) 2 (volume.restrict (fcrHalf c s)) ∧
      fcrWD c s (fun x => m x * φ x) a (fun x => partialDeriv a m x * φ x + m x * ψ x) := by
    intro m hm a φ ψ hφ hψ hw
    exact ⟨hL2 m hm.continuousOn φ hφ,
      (hL2 _ (hpd m a hm).continuousOn φ hφ).add (hL2 m hm.continuousOn ψ hψ),
      hwd m hm φ ψ a hφ hψ hw⟩
  
  have hWcongr : ∀ (a : Fin 3) (φ φ' ψ ψ' : E3 → ℝ), fcrWD c s φ a ψ →
      (∀ x ∈ fcrHalf c s, φ x = φ' x) → (∀ x ∈ fcrHalf c s, ψ x = ψ' x) →
      fcrWD c s φ' a ψ' := by
    intro a φ φ' ψ ψ' h hφ hψ ζ hζ hζc hζs
    have e1 : (fun x => φ' x * partialDeriv a ζ x) = fun x => φ x * partialDeriv a ζ x := by
      funext x
      by_cases hx : x ∈ fcrHalf c s
      · rw [hφ x hx]
      · have h0 : partialDeriv a ζ x = 0 := by
          by_contra hne
          exact hx (((hpdsupp ζ a).trans hζs) (Function.mem_support.2 hne))
        rw [h0, mul_zero, mul_zero]
    have e2 : (fun x => ψ' x * ζ x) = fun x => ψ x * ζ x := by
      funext x
      by_cases hx : x ∈ fcrHalf c s
      · rw [hψ x hx]
      · have h0 : ζ x = 0 := by
          by_contra hne
          exact hx (((subset_tsupport ζ).trans hζs) (Function.mem_support.2 hne))
        rw [h0, mul_zero, mul_zero]
    show ∫ x, φ' x * partialDeriv a ζ x = -∫ x, ψ' x * ζ x
    rw [e1, e2]
    exact h ζ hζ hζc hζs
  
  have hDL : ∀ b : Fin 3, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s)) :=
    fun b => hP.1.2.1 [b] (by simp)
  have hwD : ∀ b : Fin 3, fcrWD c s w b (D [b]) := by
    intro b ζ k1 k2 k3
    have h0 := hP.1.2.2 [] b (by simp) ζ k1 k2 k3
    rw [hP.1.1] at h0
    exact h0
  have hsymmW : ∀ (a b : Fin 3) (φ ψa ψb χ : E3 → ℝ),
      fcrWD c s φ a ψa → fcrWD c s φ b ψb → fcrWD c s ψb a χ → fcrWD c s ψa b χ := by
    intro a b φ ψa ψb χ ha hb hχ ζ hζ hζc hζs
    have hf' : ContDiff ℝ ∞ (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
    have htest' : ∀ i : Fin 3, ContDiff ℝ ∞ (partialDeriv i ζ) ∧
        HasCompactSupport (partialDeriv i ζ) ∧ tsupport (partialDeriv i ζ) ⊆ fcrHalf c s := by
      intro i
      refine ⟨?_, ?_, ?_⟩
      · show ContDiff ℝ ∞ (fun y => fderiv ℝ ζ y (e i))
        exact hf'.clm_apply contDiff_const
      · show HasCompactSupport (fun y => fderiv ℝ ζ y (e i))
        exact hζc.fderiv_apply (𝕜 := ℝ) (e i)
      · refine subset_trans ?_ hζs
        refine subset_trans ?_ (tsupport_fderiv_subset ℝ)
        apply closure_mono
        intro x hx h
        apply hx
        show fderiv ℝ ζ x (e i) = 0
        rw [h]
        rfl
    have hschwarz : ∀ x, partialDeriv a (partialDeriv b ζ) x =
        partialDeriv b (partialDeriv a ζ) x := by
      intro x
      have hdx : DifferentiableAt ℝ (fderiv ℝ ζ) x :=
        (hf'.differentiable (by simp)).differentiableAt
      have key : ∀ v w : E3, fderiv ℝ (fun y => fderiv ℝ ζ y w) x v =
          fderiv ℝ (fderiv ℝ ζ) x v w := by
        intro v w
        rw [fderiv_clm_apply hdx (differentiableAt_const w)]
        simp
      have hsymm : IsSymmSndFDerivAt ℝ ζ x :=
        hζ.contDiffAt.isSymmSndFDerivAt (by
          rw [minSmoothness_of_isRCLikeNormedField]
          first
            | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
            | exact WithTop.coe_le_coe.2 le_top
            | decide)
      show fderiv ℝ (fun y => fderiv ℝ ζ y (e b)) x (e a) =
        fderiv ℝ (fun y => fderiv ℝ ζ y (e a)) x (e b)
      rw [key, key]
      exact hsymm.eq (e a) (e b)
    have h1 := ha (partialDeriv b ζ) (htest' b).1 (htest' b).2.1 (htest' b).2.2
    have h2 := hb (partialDeriv a ζ) (htest' a).1 (htest' a).2.1 (htest' a).2.2
    have h3 := hχ ζ hζ hζc hζs
    have he : (fun x => φ x * partialDeriv a (partialDeriv b ζ) x) =
        (fun x => φ x * partialDeriv b (partialDeriv a ζ) x) := by
      funext x
      rw [hschwarz x]
    rw [he] at h1
    linarith
  have hDb0 : ∀ b : Fin 3, b ≠ 0 → fcrWD c s (D [b]) 0 (E b 0) := fun b hb =>
    hsymmW b 0 w (D [b]) (D [0]) (E b 0) (hwD b) (hwD 0) (hE b 0 hb).1
  have hpos : ∀ x ∈ Metric.ball c R, 0 < A x 0 0 := fun x hx => (hApos x hx).diag_pos
  have hne : ∀ x ∈ Metric.ball c R, A x 0 0 ≠ 0 := fun x hx => ne_of_gt (hpos x hx)
  obtain ⟨Vf, hVf⟩ : ∃ Vf : Fin 3 → E3 → ℝ,
      Vf = fun a x => (∑ b : Fin 3, A x a b * D [b] x) + G a x := ⟨_, rfl⟩
  obtain ⟨Wf, hWf⟩ : ∃ Wf : Fin 3 → E3 → ℝ, Wf = fun a x =>
      (∑ b : Fin 3, (partialDeriv a (fun y => A y a b) x * D [b] x + A x a b * E a b x))
        + GD a x := ⟨_, rfl⟩
  have hVL : ∀ a : Fin 3, MemLp (Vf a) 2 (volume.restrict (fcrHalf c s)) := by
    intro a
    rw [hVf]
    exact (memLp_finset_sum (f := fun b x => A x a b * D [b] x) Finset.univ
      (fun b _ => hL2 _ (hA a b).continuousOn (D [b]) (hDL b))).add (hP.2.2.1 a)
  
  have hTan : ∀ a : Fin 3, a ≠ 0 →
      MemLp (Wf a) 2 (volume.restrict (fcrHalf c s)) ∧ fcrWD c s (Vf a) a (Wf a) := by
    intro a ha
    have hb := fun b : Fin 3 => hWsmul (fun y => A y a b) (hA a b) a (D [b]) (E a b) (hDL b)
      (hE a b ha).2 (hE a b ha).1
    have hS1 : MemLp (fun x => ∑ b : Fin 3, A x a b * D [b] x) 2
        (volume.restrict (fcrHalf c s)) :=
      memLp_finset_sum (f := fun b x => A x a b * D [b] x) Finset.univ (fun b _ => (hb b).1)
    have hS2 : MemLp (fun x => ∑ b : Fin 3,
        (partialDeriv a (fun y => A y a b) x * D [b] x + A x a b * E a b x)) 2
        (volume.restrict (fcrHalf c s)) :=
      memLp_finset_sum
        (f := fun b x => partialDeriv a (fun y => A y a b) x * D [b] x + A x a b * E a b x)
        Finset.univ (fun b _ => (hb b).2.1)
    have hS3 : fcrWD c s (fun x => ∑ b : Fin 3, A x a b * D [b] x) a (fun x => ∑ b : Fin 3,
        (partialDeriv a (fun y => A y a b) x * D [b] x + A x a b * E a b x)) :=
      hWsum a Finset.univ (fun b x => A x a b * D [b] x)
        (fun b x => partialDeriv a (fun y => A y a b) x * D [b] x + A x a b * E a b x)
        (fun b _ => hb b)
    rw [hVf, hWf]
    exact ⟨hS2.add (hGD a).2,
      (hWadd a _ _ _ _ hS1 (hP.2.2.1 a) hS2 (hGD a).2 hS3 (hGD a).1).1⟩
  
  have heqn : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ fcrHalf c s →
      ∫ x, ((∑ a : Fin 3, Vf a x * partialDeriv a ζ x) + F x * ζ x) = 0 := by
    intro ζ hζ hζc hζs
    have hO : ∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball c s | x 0 = 0} ⊆ O ∧
        ∀ x ∈ O, ζ x = 0 := by
      refine ⟨(tsupport ζ)ᶜ, (isClosed_tsupport ζ).isOpen_compl, ?_, ?_⟩
      · rintro x ⟨-, hx0⟩ hxt
        have h1 : 0 < x 0 := (hζs hxt).2
        rw [hx0] at h1
        exact lt_irrefl _ h1
      · intro x hx
        exact image_eq_zero_of_notMem_tsupport hx
    have h0 : ∫ x in fcrHalf c s,
        ((∑ a : Fin 3, ((∑ b : Fin 3, A x a b * D [b] x) + G a x) * partialDeriv a ζ x)
          + F x * ζ x) = 0 :=
      hP.2.2.2.2 ζ hζ hζc (fun x hx => (hζs hx).1) hO
    rw [hVf]
    show ∫ x, ((∑ a : Fin 3, ((∑ b : Fin 3, A x a b * D [b] x) + G a x) * partialDeriv a ζ x)
          + F x * ζ x) = 0
    rw [← h0]
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have hz : ζ x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hx (hζs h))
    have hd : ∀ a, partialDeriv a ζ x = 0 := fun a => by
      by_contra hne'
      exact hx (((hpdsupp ζ a).trans hζs) (Function.mem_support.2 hne'))
    simp [hz, hd]
  
  have hNorm : fcrWD c s (Vf 0) 0 (fun x => F x - Wf 1 x - Wf 2 x) := by
    intro ζ hζ hζc hζs
    have heq := heqn ζ hζ hζc hζs
    simp only [Fin.sum_univ_three] at heq
    have hz3 : Function.support ζ ⊆ fcrHalf c s := (subset_tsupport ζ).trans hζs
    have iV : ∀ a, Integrable (fun x => Vf a x * partialDeriv a ζ x) := by
      intro a
      obtain ⟨g1, g2, g3⟩ := htd ζ hζ hζc hζs a
      exact hint (Vf a) _ (hVL a) g1 g2 g3
    have iF : Integrable (fun x => F x * ζ x) := hint F ζ hP.2.2.2.1 hζ.continuous hζc hz3
    have iW1 : Integrable (fun x => Wf 1 x * ζ x) :=
      hint (Wf 1) ζ (hTan 1 h10).1 hζ.continuous hζc hz3
    have iW2 : Integrable (fun x => Wf 2 x * ζ x) :=
      hint (Wf 2) ζ (hTan 2 h20).1 hζ.continuous hζc hz3
    have i01 : Integrable (fun x => Vf 0 x * partialDeriv 0 ζ x +
        Vf 1 x * partialDeriv 1 ζ x) := (iV 0).add (iV 1)
    have i012 : Integrable (fun x => Vf 0 x * partialDeriv 0 ζ x +
        Vf 1 x * partialDeriv 1 ζ x + Vf 2 x * partialDeriv 2 ζ x) := i01.add (iV 2)
    have iFW1 : Integrable (fun x => F x * ζ x - Wf 1 x * ζ x) := iF.sub iW1
    rw [integral_add i012 iF, integral_add i01 (iV 2), integral_add (iV 0) (iV 1)] at heq
    have k1 := (hTan 1 h10).2 ζ hζ hζc hζs
    have k2 := (hTan 2 h20).2 ζ hζ hζc hζs
    have e : (fun x => (F x - Wf 1 x - Wf 2 x) * ζ x) =
        fun x => F x * ζ x - Wf 1 x * ζ x - Wf 2 x * ζ x := by
      funext x; ring
    show ∫ x, Vf 0 x * partialDeriv 0 ζ x = -∫ x, (F x - Wf 1 x - Wf 2 x) * ζ x
    rw [e, integral_sub iFW1 iW2, integral_sub iF iW1]
    linarith
  
  have hTb : ∀ b ∈ ({1, 2} : Finset (Fin 3)),
      MemLp ((fun b x => A x 0 b * D [b] x) b) 2 (volume.restrict (fcrHalf c s)) ∧
      MemLp ((fun b x => partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x) b)
        2 (volume.restrict (fcrHalf c s)) ∧
      fcrWD c s ((fun b x => A x 0 b * D [b] x) b) 0
        ((fun b x => partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x) b) := by
    intro b hb
    have hb0 : b ≠ 0 := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hb
      rcases hb with rfl | rfl <;> decide
    exact hWsmul (fun y => A y 0 b) (hA 0 b) 0 (D [b]) (E b 0) (hDL b) (hE b 0 hb0).2
      (hDb0 b hb0)
  have hTL : MemLp (fun x => ∑ b ∈ ({1, 2} : Finset (Fin 3)), A x 0 b * D [b] x) 2
      (volume.restrict (fcrHalf c s)) :=
    memLp_finset_sum (f := fun b x => A x 0 b * D [b] x) _ (fun b hb => (hTb b hb).1)
  have hT'L : MemLp (fun x => ∑ b ∈ ({1, 2} : Finset (Fin 3)),
      (partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x)) 2
      (volume.restrict (fcrHalf c s)) :=
    memLp_finset_sum
      (f := fun b x => partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x) _
      (fun b hb => (hTb b hb).2.1)
  have hTw : fcrWD c s (fun x => ∑ b ∈ ({1, 2} : Finset (Fin 3)), A x 0 b * D [b] x) 0
      (fun x => ∑ b ∈ ({1, 2} : Finset (Fin 3)),
        (partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x)) :=
    hWsum 0 _ _ _ hTb
  have hYL0 : MemLp (fun x => F x - Wf 1 x - Wf 2 x) 2 (volume.restrict (fcrHalf c s)) :=
    (hP.2.2.2.1.sub (hTan 1 h10).1).sub (hTan 2 h20).1
  
  have hU1 := hWadd 0 (Vf 0) _ _ _ (hVL 0) hTL hYL0 hT'L hNorm hTw
  have hU2 := hWadd 0 _ (G 0) _ (GD 0) ((hVL 0).sub hTL) (hP.2.2.1 0) (hYL0.sub hT'L)
    (hGD 0).2 hU1.2 (hGD 0).1
  have hUL : MemLp (fun x => A x 0 0 * D [0] x) 2 (volume.restrict (fcrHalf c s)) :=
    hL2 _ (hA 0 0).continuousOn _ (hDL 0)
  have hYL : MemLp (fun x => F x - Wf 1 x - Wf 2 x - (∑ b ∈ ({1, 2} : Finset (Fin 3)),
      (partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x)) - GD 0 x) 2
      (volume.restrict (fcrHalf c s)) :=
    (hYL0.sub hT'L).sub (hGD 0).2
  have hUY : fcrWD c s (fun x => A x 0 0 * D [0] x) 0
      (fun x => F x - Wf 1 x - Wf 2 x - (∑ b ∈ ({1, 2} : Finset (Fin 3)),
        (partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x)) - GD 0 x) := by
    refine hWcongr 0 _ _ _ _ hU2.2 (fun x _ => ?_) (fun x _ => rfl)
    show Vf 0 x - (∑ b ∈ ({1, 2} : Finset (Fin 3)), A x 0 b * D [b] x) - G 0 x =
      A x 0 0 * D [0] x
    rw [hVf]
    simp only [Fin.sum_univ_three, Finset.sum_pair h12]
    ring
  
  have hm : ContDiffOn ℝ ∞ (fun x => (A x 0 0)⁻¹) (Metric.ball c R) := (hA 0 0).inv hne
  have hfin := (hWsmul _ hm 0 _ _ hUL hYL hUY).2.2
  refine hWcongr 0 _ _ _ _ hfin (fun x hx => ?_) (fun x hx => ?_)
  · have hxR := hHsub hx
    show (A x 0 0)⁻¹ * (A x 0 0 * D [0] x) = D [0] x
    exact inv_mul_cancel_left₀ (hne x hxR) _
  · have hxR := hHsub hx
    have hdm : partialDeriv 0 (fun y => (A y 0 0)⁻¹) x =
        -((A x 0 0) ^ 2)⁻¹ * partialDeriv 0 (fun y => A y 0 0) x := by
      have hfd : DifferentiableAt ℝ (fun y => A y 0 0) x :=
        ((hA 0 0).differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hxR)
      have hh := (hasDerivAt_inv (hne x hxR)).comp_hasFDerivAt x hfd.hasFDerivAt
      unfold partialDeriv
      rw [show (fun y => (A y 0 0)⁻¹) = (fun t : ℝ => t⁻¹) ∘ (fun y => A y 0 0) from rfl,
        hh.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    show partialDeriv 0 (fun y => (A y 0 0)⁻¹) x * (A x 0 0 * D [0] x) +
        (A x 0 0)⁻¹ * (F x - Wf 1 x - Wf 2 x - (∑ b ∈ ({1, 2} : Finset (Fin 3)),
          (partialDeriv 0 (fun y => A y 0 b) x * D [b] x + A x 0 b * E b 0 x)) - GD 0 x) =
      fcrNormalZ A D E GD F x
    rw [hdm, hWf]
    unfold fcrNormalZ
    simp only [Finset.sum_pair h12]
    have h00 := hne x hxR
    field_simp
    ring

theorem fdr_zt_tangential (c : E3) (s : ℝ) (w : E3 → ℝ) (Dg : Fin 3 → E3 → ℝ)
    (hzt : fdrZT c s w Dg) (a : Fin 3) (ha : a ≠ 0) (E : Fin 3 → E3 → ℝ)
    (hDg : ∀ b, MemLp (Dg b) 2 (volume.restrict (fcrHalf c s)))
    (hE : ∀ b, fcrWD c s (Dg b) a (E b) ∧ MemLp (E b) 2 (volume.restrict (fcrHalf c s))) :
    fdrZT c s (Dg a) E :=
by
  have hπc : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hHopen : IsOpen (fcrHalf c s) := by
    show IsOpen (Metric.ball c s ∩ {x : E3 | 0 < x 0})
    exact Metric.isOpen_ball.inter (isOpen_lt continuous_const hπc)
  have hHmeas : MeasurableSet (fcrHalf c s) := hHopen.measurableSet
  
  have htestd : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → ∀ i : Fin 3,
      ContDiff ℝ ∞ (partialDeriv i ζ) ∧ HasCompactSupport (partialDeriv i ζ) ∧
        tsupport (partialDeriv i ζ) ⊆ tsupport ζ := by
    intro ζ hζ hζc i
    have hf' : ContDiff ℝ ∞ (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
    refine ⟨?_, ?_, ?_⟩
    · show ContDiff ℝ ∞ (fun y => fderiv ℝ ζ y (e i))
      exact hf'.clm_apply contDiff_const
    · show HasCompactSupport (fun y => fderiv ℝ ζ y (e i))
      exact hζc.fderiv_apply (𝕜 := ℝ) (e i)
    · refine subset_trans ?_ (tsupport_fderiv_subset ℝ)
      apply closure_mono
      intro x hx h
      apply hx
      show fderiv ℝ ζ x (e i) = 0
      rw [h]
      rfl
  
  have hschwarz : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → ∀ (i j : Fin 3) (x : E3),
      partialDeriv i (partialDeriv j ζ) x = partialDeriv j (partialDeriv i ζ) x := by
    intro ζ hζ i j x
    have hf' : ContDiff ℝ ∞ (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
    have hdx : DifferentiableAt ℝ (fderiv ℝ ζ) x :=
      (hf'.differentiable (by simp)).differentiableAt
    have key : ∀ v w : E3, fderiv ℝ (fun y => fderiv ℝ ζ y w) x v =
        fderiv ℝ (fderiv ℝ ζ) x v w := by
      intro v w
      rw [fderiv_clm_apply hdx (differentiableAt_const w)]
      simp
    have hsymm : IsSymmSndFDerivAt ℝ ζ x :=
      hζ.contDiffAt.isSymmSndFDerivAt (by
        rw [minSmoothness_of_isRCLikeNormedField]
        first
          | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
          | exact WithTop.coe_le_coe.2 le_top
          | decide)
    show fderiv ℝ (fun y => fderiv ℝ ζ y (e j)) x (e i) =
      fderiv ℝ (fun y => fderiv ℝ ζ y (e i)) x (e j)
    rw [key, key]
    exact hsymm.eq (e i) (e j)
  
  have hint : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → Integrable (fun x => u x * g x) (volume.restrict (fcrHalf c s)) := by
    intro u g hu hg hgc
    have hgv : MemLp g 2 (volume : Measure E3) := hg.memLp_of_hasCompactSupport hgc
    exact hu.integrable_mul (hgv.restrict (fcrHalf c s))
  
  obtain ⟨θ, hθdef⟩ : ∃ θ : ℕ → E3 → ℝ,
      θ = fun (n : ℕ) (x : E3) => Real.smoothTransition (((n : ℝ) + 1) * x 0 - 1) := ⟨_, rfl⟩
  have hθs : ∀ n, ContDiff ℝ ∞ (θ n) := by
    intro n
    rw [hθdef]
    have hπ : ContDiff ℝ ∞ (fun z : E3 => z 0) :=
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    exact (Real.smoothTransition.contDiff (n := ⊤)).comp ((contDiff_const.mul hπ).sub contDiff_const)
  have hθb : ∀ n x, 0 ≤ θ n x ∧ θ n x ≤ 1 := by
    intro n x
    rw [hθdef]
    exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hθge : ∀ n x, θ n x ≠ 0 → 1 ≤ ((n : ℝ) + 1) * x 0 := by
    intro n x h
    by_contra hx
    push_neg at hx
    apply h
    rw [hθdef]
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hS0 : ∀ (n : ℕ) (x : E3), 1 ≤ ((n : ℝ) + 1) * x 0 → 0 < x 0 := by
    intro n x h
    by_contra hx
    push_neg at hx
    have := mul_nonpos_of_nonneg_of_nonpos (by positivity : (0 : ℝ) ≤ (n : ℝ) + 1) hx
    linarith
  have hθpos : ∀ n x, θ n x ≠ 0 → 0 < x 0 := fun n x h => hS0 n x (hθge n x h)
  have hθ1 : ∀ x : E3, 0 < x 0 → Tendsto (fun n => θ n x) atTop (𝓝 1) := by
    intro x hx
    obtain ⟨N, hN⟩ := exists_nat_ge (2 / x 0)
    apply tendsto_atTop_of_eventually_const (i₀ := N)
    intro n hn
    rw [hθdef]
    apply Real.smoothTransition.one_of_one_le
    have h1 : 2 / x 0 ≤ (n : ℝ) := hN.trans (by exact_mod_cast hn)
    have h2 : 2 ≤ (n : ℝ) * x 0 := by rwa [div_le_iff₀ hx] at h1
    have h3 : ((n : ℝ) + 1) * x 0 = (n : ℝ) * x 0 + x 0 := by ring
    linarith
  have he0 : (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) (e a) = 0 := by
    show (e a) 0 = 0
    simp [EuclideanSpace.single_apply, Ne.symm ha]
  have hθd : ∀ n x, fderiv ℝ (θ n) x (e a) = 0 := by
    intro n x
    have hℓ : HasFDerivAt (fun y : E3 => ((n : ℝ) + 1) * y 0 - 1)
        (((n : ℝ) + 1) • (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ)) x :=
      (((EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt).const_mul
        ((n : ℝ) + 1)).sub_const 1
    have hst : HasDerivAt Real.smoothTransition
        (deriv Real.smoothTransition (((n : ℝ) + 1) * x 0 - 1)) (((n : ℝ) + 1) * x 0 - 1) :=
      (((Real.smoothTransition.contDiff (n := ⊤)).differentiable (by simp)) _).hasDerivAt
    have hc := hst.comp_hasFDerivAt x hℓ
    have hθeq : θ n = Real.smoothTransition ∘ (fun y : E3 => ((n : ℝ) + 1) * y 0 - 1) := by
      rw [hθdef]
      rfl
    rw [hθeq, hc.fderiv, ContinuousLinearMap.smul_apply, ContinuousLinearMap.smul_apply, he0]
    simp
  
  have hibp : ∀ φ ψ : E3 → ℝ, MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp ψ 2 (volume.restrict (fcrHalf c s)) → fcrWD c s φ a ψ →
      ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c s →
        ∫ x in fcrHalf c s, φ x * partialDeriv a ζ x = -∫ x in fcrHalf c s, ψ x * ζ x := by
    intro φ ψ hφ hψ hwd ζ hζ hζc hζs
    obtain ⟨hd1, hd2, hd3⟩ := htestd ζ hζ hζc a
    have hcut : ∀ n, ContDiff ℝ ∞ (fun x => θ n x * ζ x) ∧
        HasCompactSupport (fun x => θ n x * ζ x) ∧
        tsupport (fun x => θ n x * ζ x) ⊆ fcrHalf c s := by
      intro n
      refine ⟨(hθs n).mul hζ, hζc.mul_left, ?_⟩
      have hcl : IsClosed (tsupport ζ ∩ {x : E3 | 1 ≤ ((n : ℝ) + 1) * x 0}) :=
        (isClosed_tsupport ζ).inter (isClosed_le continuous_const (continuous_const.mul hπc))
      refine (closure_minimal ?_ hcl).trans ?_
      · intro x hx
        have hx' : θ n x * ζ x ≠ 0 := hx
        exact ⟨subset_tsupport _ (right_ne_zero_of_mul hx'), hθge n x (left_ne_zero_of_mul hx')⟩
      · intro x hx
        exact Set.mem_inter (hζs hx.1) (hS0 n x hx.2)
    have hdcut : ∀ n x, partialDeriv a (fun y => θ n y * ζ y) x = θ n x * partialDeriv a ζ x := by
      intro n x
      have h1 : DifferentiableAt ℝ (θ n) x := ((hθs n).differentiable (by simp)) x
      have h2 : DifferentiableAt ℝ ζ x := (hζ.differentiable (by simp)) x
      show fderiv ℝ (fun y => θ n y * ζ y) x (e a) = θ n x * fderiv ℝ ζ x (e a)
      rw [show (fun y => θ n y * ζ y) = θ n * ζ from rfl,
        (h1.hasFDerivAt.mul h2.hasFDerivAt).fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [hθd n x]
      ring
    have hseq : ∀ n : ℕ, ∫ x in fcrHalf c s, φ x * (θ n x * partialDeriv a ζ x) =
        -∫ x in fcrHalf c s, ψ x * (θ n x * ζ x) := by
      intro n
      obtain ⟨c1, c2, c3⟩ := hcut n
      have h : ∫ x, φ x * partialDeriv a (fun y => θ n y * ζ y) x =
          -∫ x, ψ x * (θ n x * ζ x) := hwd _ c1 c2 c3
      have e1 : (fun x => φ x * partialDeriv a (fun y => θ n y * ζ y) x) =
          fun x => φ x * (θ n x * partialDeriv a ζ x) := funext fun x => by rw [hdcut n x]
      rw [e1] at h
      have hz1 : ∀ x ∉ fcrHalf c s, φ x * (θ n x * partialDeriv a ζ x) = 0 := by
        intro x hx
        by_cases h0 : θ n x = 0
        · simp [h0]
        · have hxb : x ∉ tsupport ζ := fun h' => hx (Set.mem_inter (hζs h') (hθpos n x h0))
          rw [image_eq_zero_of_notMem_tsupport (fun h' => hxb (hd3 h'))]
          simp
      have hz2 : ∀ x ∉ fcrHalf c s, ψ x * (θ n x * ζ x) = 0 := by
        intro x hx
        by_cases h0 : θ n x = 0
        · simp [h0]
        · have hxb : x ∉ tsupport ζ := fun h' => hx (Set.mem_inter (hζs h') (hθpos n x h0))
          rw [image_eq_zero_of_notMem_tsupport hxb]
          simp
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero hz1,
        setIntegral_eq_integral_of_forall_compl_eq_zero hz2]
      exact h
    have hT1 : Tendsto (fun n : ℕ => ∫ x in fcrHalf c s, φ x * (θ n x * partialDeriv a ζ x))
        atTop (𝓝 (∫ x in fcrHalf c s, φ x * partialDeriv a ζ x)) := by
      refine tendsto_integral_of_dominated_convergence (fun x => ‖φ x * partialDeriv a ζ x‖)
        (fun n => ?_) ?_ (fun n => ?_) ?_
      · exact (hint φ _ hφ ((hθs n).continuous.mul hd1.continuous) hd2.mul_left).aestronglyMeasurable
      · exact (hint φ _ hφ hd1.continuous hd2).norm
      · refine Filter.Eventually.of_forall fun x => ?_
        show ‖φ x * (θ n x * partialDeriv a ζ x)‖ ≤ ‖φ x * partialDeriv a ζ x‖
        have hb := hθb n x
        have hθn : ‖θ n x‖ ≤ 1 := by
          rw [Real.norm_eq_abs, abs_of_nonneg hb.1]
          exact hb.2
        rw [norm_mul, norm_mul, norm_mul]
        calc ‖φ x‖ * (‖θ n x‖ * ‖partialDeriv a ζ x‖)
            ≤ ‖φ x‖ * (1 * ‖partialDeriv a ζ x‖) := by gcongr
          _ = ‖φ x‖ * ‖partialDeriv a ζ x‖ := by ring
      · refine (ae_restrict_iff' hHmeas).2 (Filter.Eventually.of_forall fun x hx => ?_)
        have := ((hθ1 x hx.2).mul_const (partialDeriv a ζ x)).const_mul (φ x)
        simpa using this
    have hT2 : Tendsto (fun n : ℕ => ∫ x in fcrHalf c s, ψ x * (θ n x * ζ x))
        atTop (𝓝 (∫ x in fcrHalf c s, ψ x * ζ x)) := by
      refine tendsto_integral_of_dominated_convergence (fun x => ‖ψ x * ζ x‖)
        (fun n => ?_) ?_ (fun n => ?_) ?_
      · exact (hint ψ _ hψ ((hθs n).continuous.mul hζ.continuous) hζc.mul_left).aestronglyMeasurable
      · exact (hint ψ _ hψ hζ.continuous hζc).norm
      · refine Filter.Eventually.of_forall fun x => ?_
        show ‖ψ x * (θ n x * ζ x)‖ ≤ ‖ψ x * ζ x‖
        have hb := hθb n x
        have hθn : ‖θ n x‖ ≤ 1 := by
          rw [Real.norm_eq_abs, abs_of_nonneg hb.1]
          exact hb.2
        rw [norm_mul, norm_mul, norm_mul]
        calc ‖ψ x‖ * (‖θ n x‖ * ‖ζ x‖)
            ≤ ‖ψ x‖ * (1 * ‖ζ x‖) := by gcongr
          _ = ‖ψ x‖ * ‖ζ x‖ := by ring
      · refine (ae_restrict_iff' hHmeas).2 (Filter.Eventually.of_forall fun x hx => ?_)
        have := ((hθ1 x hx.2).mul_const (ζ x)).const_mul (ψ x)
        simpa using this
    have hT3 : Tendsto (fun n : ℕ => ∫ x in fcrHalf c s, φ x * (θ n x * partialDeriv a ζ x))
        atTop (𝓝 (-∫ x in fcrHalf c s, ψ x * ζ x)) :=
      hT2.neg.congr (fun n => (hseq n).symm)
    exact tendsto_nhds_unique hT1 hT3
  
  intro b ζ hζ hζc hζs
  obtain ⟨hb1, hb2, hb3⟩ := htestd ζ hζ hζc b
  obtain ⟨ha1, ha2, ha3⟩ := htestd ζ hζ hζc a
  have h1 := hzt a (partialDeriv b ζ) hb1 hb2 (hb3.trans hζs)
  have h2 := hzt b (partialDeriv a ζ) ha1 ha2 (ha3.trans hζs)
  have hsw : partialDeriv a (partialDeriv b ζ) = partialDeriv b (partialDeriv a ζ) :=
    funext (hschwarz ζ hζ a b)
  rw [hsw, h2] at h1
  have h3 := hibp (Dg b) (E b) (hDg b) (hE b).2 (hE b).1 ζ hζ hζc hζs
  linarith

theorem fdr_diff_problem (c : E3) (R s : ℝ) (hsR : s < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fdrProb c s A w D G F) (a : Fin 3) (E : Fin 3 → E3 → ℝ)
    (hE : ∀ b, fcrWD c s (D [b]) a (E b) ∧ MemLp (E b) 2 (volume.restrict (fcrHalf c s)))
    (hzta : fdrZT c s (D [a]) E)
    (GDa : Fin 3 → E3 → ℝ)
    (hGa : ∀ d, fcrWD c s (G d) a (GDa d) ∧ MemLp (GDa d) 2 (volume.restrict (fcrHalf c s)))
    (FDa : E3 → ℝ)
    (hFa : fcrWD c s F a FDa ∧ MemLp FDa 2 (volume.restrict (fcrHalf c s))) :
    fdrProb c s A (D [a]) (fun L => match L with | [] => D [a] | b :: _ => E b)
      (fun d x => (∑ b : Fin 3, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x) FDa :=
by
  
  have hπc : Continuous (fun x : E3 => x 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  have hPopen : IsOpen {x : E3 | 0 < x 0} := isOpen_lt continuous_const hπc
  have hNopen : IsOpen {x : E3 | x 0 < 0} := isOpen_lt hπc continuous_const
  have hHopen : IsOpen (fcrHalf c s) := by
    show IsOpen (Metric.ball c s ∩ {x : E3 | 0 < x 0})
    exact Metric.isOpen_ball.inter hPopen
  have hHmeas : MeasurableSet (fcrHalf c s) := hHopen.measurableSet
  have hHball : fcrHalf c s ⊆ Metric.ball c R :=
    fun x hx => Metric.ball_subset_ball hsR.le hx.1
  
  have htestd : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → ∀ i : Fin 3,
      ContDiff ℝ ∞ (partialDeriv i ζ) ∧ HasCompactSupport (partialDeriv i ζ) ∧
        tsupport (partialDeriv i ζ) ⊆ tsupport ζ := by
    intro ζ hζ hζc i
    have hf' : ContDiff ℝ ∞ (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
    refine ⟨?_, ?_, ?_⟩
    · show ContDiff ℝ ∞ (fun y => fderiv ℝ ζ y (e i))
      exact hf'.clm_apply contDiff_const
    · show HasCompactSupport (fun y => fderiv ℝ ζ y (e i))
      exact hζc.fderiv_apply (𝕜 := ℝ) (e i)
    · refine subset_trans ?_ (tsupport_fderiv_subset ℝ)
      apply closure_mono
      intro x hx h
      apply hx
      show fderiv ℝ ζ x (e i) = 0
      rw [h]
      rfl
  
  have hschwarz : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → ∀ (i j : Fin 3) (x : E3),
      partialDeriv i (partialDeriv j ζ) x = partialDeriv j (partialDeriv i ζ) x := by
    intro ζ hζ i j x
    have hf' : ContDiff ℝ ∞ (fderiv ℝ ζ) := (contDiff_infty_iff_fderiv.1 hζ).2
    have hdx : DifferentiableAt ℝ (fderiv ℝ ζ) x :=
      (hf'.differentiable (by simp)).differentiableAt
    have key : ∀ v w : E3, fderiv ℝ (fun y => fderiv ℝ ζ y w) x v =
        fderiv ℝ (fderiv ℝ ζ) x v w := by
      intro v w
      rw [fderiv_clm_apply hdx (differentiableAt_const w)]
      simp
    have hsymm : IsSymmSndFDerivAt ℝ ζ x :=
      hζ.contDiffAt.isSymmSndFDerivAt (by
        rw [minSmoothness_of_isRCLikeNormedField]
        first
          | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
          | exact WithTop.coe_le_coe.2 le_top
          | decide)
    show fderiv ℝ (fun y => fderiv ℝ ζ y (e j)) x (e i) =
      fderiv ℝ (fun y => fderiv ℝ ζ y (e i)) x (e j)
    rw [key, key]
    exact hsymm.eq (e i) (e j)
  
  have hint : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → Integrable (fun x => u x * g x) (volume.restrict (fcrHalf c s)) := by
    intro u g hu hg hgc
    have hgv : MemLp g 2 (volume : Measure E3) := hg.memLp_of_hasCompactSupport hgc
    exact hu.integrable_mul (hgv.restrict (fcrHalf c s))
  have hintV : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g → tsupport g ⊆ fcrHalf c s → Integrable (fun x => u x * g x) := by
    intro u g hu hg hgc hgs
    have hsupp : Function.support (fun x => u x * g x) ⊆ fcrHalf c s := by
      intro x hx
      apply hgs
      apply subset_tsupport
      intro h0
      apply hx
      simp [h0]
    exact (integrableOn_iff_integrable_of_support_subset hsupp).1 (hint u g hu hg hgc)
  
  have hmemsmul : ∀ m : E3 → ℝ, ContinuousOn m (Metric.ball c R) → ∀ φ : E3 → ℝ,
      MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp (fun x => m x * φ x) 2 (volume.restrict (fcrHalf c s)) := by
    intro m hm φ hφ
    obtain ⟨C, hC⟩ := (isCompact_closedBall c s).exists_bound_of_continuousOn
      (hm.mono (Metric.closedBall_subset_ball hsR))
    refine MemLp.of_le_mul (c := C) hφ
      (((hm.mono hHball).aestronglyMeasurable hHmeas).mul hφ.1) ?_
    refine (ae_restrict_iff' hHmeas).2 (Filter.Eventually.of_forall fun x hx => ?_)
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hC x (Metric.ball_subset_closedBall hx.1)) (norm_nonneg _)
  have hpdm : ∀ m : E3 → ℝ, ContDiffOn ℝ ∞ m (Metric.ball c R) →
      ContDiffOn ℝ ∞ (partialDeriv a m) (Metric.ball c R) := by
    intro m hm
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ m y (e a)) (Metric.ball c R)
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 hm).2.clm_apply
      contDiffOn_const
  
  have hsmtest : ∀ m : E3 → ℝ, ContDiffOn ℝ ∞ m (Metric.ball c R) → ∀ ζ : E3 → ℝ,
      ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c R →
      ContDiff ℝ ∞ (fun x => m x * ζ x) ∧ HasCompactSupport (fun x => m x * ζ x) ∧
        tsupport (fun x => m x * ζ x) ⊆ tsupport ζ ∧
        ∀ x, partialDeriv a (fun y => m y * ζ y) x =
          partialDeriv a m x * ζ x + m x * partialDeriv a ζ x := by
    intro m hm ζ hζ hζc hζs
    have hout : ∀ x, x ∉ Metric.ball c R → ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
      fun x hx => notMem_tsupport_iff_eventuallyEq.1 (fun h => hx (hζs h))
    have hout' : ∀ x, x ∉ Metric.ball c R → (fun y => m y * ζ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
      fun x hx => (hout x hx).mono fun y hy => by simp [hy]
    refine ⟨?_, hζc.mul_left, tsupport_mul_subset_right, ?_⟩
    · refine contDiff_iff_contDiffAt.2 fun x => ?_
      by_cases hx : x ∈ Metric.ball c R
      · exact (hm.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).mul hζ.contDiffAt
      · exact contDiffAt_const.congr_of_eventuallyEq (hout' x hx)
    · intro x
      by_cases hx : x ∈ Metric.ball c R
      · have hmd : DifferentiableAt ℝ m x :=
          (hm.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).differentiableAt (by simp)
        have hζd : DifferentiableAt ℝ ζ x := hζ.contDiffAt.differentiableAt (by simp)
        show fderiv ℝ (fun y => m y * ζ y) x (e a) =
          fderiv ℝ m x (e a) * ζ x + m x * fderiv ℝ ζ x (e a)
        rw [show (fun y => m y * ζ y) = m * ζ from rfl,
          (hmd.hasFDerivAt.mul hζd.hasFDerivAt).fderiv]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have hz : ζ x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hx (hζs h))
        show fderiv ℝ (fun y => m y * ζ y) x (e a) =
          fderiv ℝ m x (e a) * ζ x + m x * fderiv ℝ ζ x (e a)
        rw [(hout' x hx).fderiv_eq, (hout x hx).fderiv_eq, hz]
        simp
  
  have hwdsmul : ∀ m : E3 → ℝ, ContDiffOn ℝ ∞ m (Metric.ball c R) → ∀ φ ψ : E3 → ℝ,
      MemLp φ 2 (volume.restrict (fcrHalf c s)) → MemLp ψ 2 (volume.restrict (fcrHalf c s)) →
      fcrWD c s φ a ψ →
      fcrWD c s (fun x => m x * φ x) a (fun x => partialDeriv a m x * φ x + m x * ψ x) := by
    intro m hm φ ψ hφ hψ hwd ζ hζ hζc hζs
    have hζR : tsupport ζ ⊆ Metric.ball c R := hζs.trans hHball
    obtain ⟨hη, hηc, hηs, hprod⟩ := hsmtest m hm ζ hζ hζc hζR
    obtain ⟨hξ, hξc, hξs, -⟩ := hsmtest (partialDeriv a m) (hpdm m hm) ζ hζ hζc hζR
    obtain ⟨hdη, hdηc, hdηs⟩ := htestd _ hη hηc a
    have h1 : ∫ x, φ x * partialDeriv a (fun y => m y * ζ y) x = -∫ x, ψ x * (m x * ζ x) :=
      hwd _ hη hηc (hηs.trans hζs)
    have I1 : Integrable (fun x => φ x * partialDeriv a (fun y => m y * ζ y) x) :=
      hintV φ _ hφ hdη.continuous hdηc (hdηs.trans (hηs.trans hζs))
    have I2 : Integrable (fun x => φ x * (partialDeriv a m x * ζ x)) :=
      hintV φ _ hφ hξ.continuous hξc (hξs.trans hζs)
    have I3 : Integrable (fun x => ψ x * (m x * ζ x)) :=
      hintV ψ _ hψ hη.continuous hηc (hηs.trans hζs)
    show ∫ x, m x * φ x * partialDeriv a ζ x = -∫ x, (partialDeriv a m x * φ x + m x * ψ x) * ζ x
    have e1 : (fun x => m x * φ x * partialDeriv a ζ x) = fun x =>
        φ x * partialDeriv a (fun y => m y * ζ y) x - φ x * (partialDeriv a m x * ζ x) := by
      funext x
      rw [hprod x]
      ring
    have e2 : (fun x => (partialDeriv a m x * φ x + m x * ψ x) * ζ x) = fun x =>
        φ x * (partialDeriv a m x * ζ x) + ψ x * (m x * ζ x) := by
      funext x
      ring
    rw [e1, e2, integral_sub I1 I2, integral_add I2 I3, h1]
    ring
  
  have hwdadd : ∀ {φ₁ φ₂ ψ₁ ψ₂ : E3 → ℝ}, fcrWD c s φ₁ a ψ₁ → fcrWD c s φ₂ a ψ₂ →
      MemLp φ₁ 2 (volume.restrict (fcrHalf c s)) → MemLp φ₂ 2 (volume.restrict (fcrHalf c s)) →
      MemLp ψ₁ 2 (volume.restrict (fcrHalf c s)) → MemLp ψ₂ 2 (volume.restrict (fcrHalf c s)) →
      fcrWD c s (fun x => φ₁ x + φ₂ x) a (fun x => ψ₁ x + ψ₂ x) := by
    intro φ₁ φ₂ ψ₁ ψ₂ h₁ h₂ m1 m2 m3 m4 ζ hζ hζc hζs
    obtain ⟨hd, hdc, hds⟩ := htestd ζ hζ hζc a
    have e1 := h₁ ζ hζ hζc hζs
    have e2 := h₂ ζ hζ hζc hζs
    show ∫ x, (φ₁ x + φ₂ x) * partialDeriv a ζ x = -∫ x, (ψ₁ x + ψ₂ x) * ζ x
    simp only [add_mul]
    rw [integral_add (hintV φ₁ _ m1 hd.continuous hdc (hds.trans hζs))
        (hintV φ₂ _ m2 hd.continuous hdc (hds.trans hζs)),
      integral_add (hintV ψ₁ _ m3 hζ.continuous hζc hζs) (hintV ψ₂ _ m4 hζ.continuous hζc hζs),
      e1, e2]
    ring
  have hwdsum : ∀ f g : Fin 3 → E3 → ℝ, (∀ b, MemLp (f b) 2 (volume.restrict (fcrHalf c s))) →
      (∀ b, MemLp (g b) 2 (volume.restrict (fcrHalf c s))) → (∀ b, fcrWD c s (f b) a (g b)) →
      fcrWD c s (fun x => ∑ b, f b x) a (fun x => ∑ b, g b x) := by
    intro f g hf hg hfg ζ hζ hζc hζs
    obtain ⟨hd, hdc, hds⟩ := htestd ζ hζ hζc a
    show ∫ x, (∑ b, f b x) * partialDeriv a ζ x = -∫ x, (∑ b, g b x) * ζ x
    simp only [Finset.sum_mul]
    rw [integral_finset_sum _ (fun b _ => hintV (f b) _ (hf b) hd.continuous hdc (hds.trans hζs)),
      integral_finset_sum _ (fun b _ => hintV (g b) _ (hg b) hζ.continuous hζc hζs),
      ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun b _ => hfg b ζ hζ hζc hζs)
  
  have hcut : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c s → ∀ O : Set E3, IsOpen O →
      {x ∈ Metric.ball c s | x 0 = 0} ⊆ O → (∀ x ∈ O, ζ x = 0) →
      ∃ ζh : E3 → ℝ, ContDiff ℝ ∞ ζh ∧ HasCompactSupport ζh ∧ tsupport ζh ⊆ fcrHalf c s ∧
        ∀ x ∈ fcrHalf c s, ζh =ᶠ[𝓝 x] ζ := by
    intro ζ hζ hζc hζs O hO hOf hOz
    have hAg : ∀ x ∈ fcrHalf c s, (fun y : E3 => if 0 < y 0 then ζ y else 0) =ᶠ[𝓝 x] ζ := by
      intro x hx
      filter_upwards [hPopen.mem_nhds hx.2] with y hy
      have hy' : 0 < y 0 := hy
      simp [hy']
    have hK : ∀ x, x ∉ fcrHalf c s →
        (fun y : E3 => if 0 < y 0 then ζ y else 0) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      by_cases hxb : x ∈ Metric.ball c s
      · have hx0 : ¬ 0 < x 0 := fun h => hx ⟨hxb, h⟩
        rcases lt_or_eq_of_le (not_lt.1 hx0) with hlt | heq
        · filter_upwards [hNopen.mem_nhds hlt] with y hy
          have hy' : ¬ 0 < y 0 := not_lt.2 (le_of_lt hy)
          simp [hy']
        · filter_upwards [hO.mem_nhds (hOf ⟨hxb, heq⟩)] with y hy
          simp [hOz y hy]
      · have h1 : ζ =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.1 (fun h => hxb (hζs h))
        filter_upwards [h1] with y hy
        have hy' : ζ y = 0 := hy
        simp [hy']
    refine ⟨fun y : E3 => if 0 < y 0 then ζ y else 0, ?_, ?_, ?_, hAg⟩
    · refine contDiff_iff_contDiffAt.2 fun x => ?_
      by_cases hx : x ∈ fcrHalf c s
      · exact hζ.contDiffAt.congr_of_eventuallyEq (hAg x hx)
      · exact contDiffAt_const.congr_of_eventuallyEq (hK x hx)
    · refine hζc.mono ?_
      intro x hx
      rw [Function.mem_support] at hx ⊢
      intro h0
      apply hx
      simp [h0]
    · intro x hx
      by_contra hxn
      exact notMem_tsupport_iff_eventuallyEq.2 (hK x hxn) hx
  
  have hagree1 : ∀ (f g : E3 → ℝ) (x : E3), f =ᶠ[𝓝 x] g → ∀ i,
      partialDeriv i f x = partialDeriv i g x := by
    intro f g x h i
    show fderiv ℝ f x (e i) = fderiv ℝ g x (e i)
    rw [h.fderiv_eq]
  have hagreeH : ∀ (f g : E3 → ℝ), (∀ x ∈ fcrHalf c s, f =ᶠ[𝓝 x] g) →
      ∀ x ∈ fcrHalf c s, ∀ i j : Fin 3,
      f x = g x ∧ partialDeriv i f x = partialDeriv i g x ∧
      partialDeriv i (partialDeriv j f) x = partialDeriv i (partialDeriv j g) x := by
    intro f g h x hx i j
    refine ⟨(h x hx).eq_of_nhds, hagree1 f g x (h x hx) i, ?_⟩
    apply hagree1
    filter_upwards [hHopen.mem_nhds hx] with y hy
    exact hagree1 f g y (h y hy) j
  have hzeroO : ∀ (ζ : E3 → ℝ) (O : Set E3), IsOpen O → (∀ x ∈ O, ζ x = 0) →
      ∀ i, ∀ x ∈ O, partialDeriv i ζ x = 0 := by
    intro ζ O hO hz i x hx
    have h : ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      filter_upwards [hO.mem_nhds hx] with y hy
      exact hz y hy
    rw [hagree1 ζ _ x h i]
    show fderiv ℝ (fun _ : E3 => (0 : ℝ)) x (e i) = 0
    simp
  
  have hwdH : ∀ (φ ψ : E3 → ℝ) (i : Fin 3), fcrWD c s φ i ψ → ∀ η : E3 → ℝ,
      ContDiff ℝ ∞ η → HasCompactSupport η → tsupport η ⊆ fcrHalf c s →
      ∫ x in fcrHalf c s, φ x * partialDeriv i η x = -∫ x in fcrHalf c s, ψ x * η x := by
    intro φ ψ i hwd η hη hηc hηs
    obtain ⟨-, -, hd3⟩ := htestd η hη hηc i
    have z1 : ∀ x ∉ fcrHalf c s, φ x * partialDeriv i η x = 0 := by
      intro x hx
      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hηs (hd3 h)))]
      simp
    have z2 : ∀ x ∉ fcrHalf c s, ψ x * η x = 0 := by
      intro x hx
      rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hηs h))]
      simp
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero z1,
      setIntegral_eq_integral_of_forall_compl_eq_zero z2]
    exact hwd η hη hηc hηs
  
  have hcrux : ∀ (V W : Fin 3 → E3 → ℝ) (F₀ FD : E3 → ℝ),
      (∀ d, MemLp (V d) 2 (volume.restrict (fcrHalf c s))) →
      (∀ d, MemLp (W d) 2 (volume.restrict (fcrHalf c s))) →
      MemLp F₀ 2 (volume.restrict (fcrHalf c s)) → MemLp FD 2 (volume.restrict (fcrHalf c s)) →
      (∀ d, fcrWD c s (V d) a (W d)) → fcrWD c s F₀ a FD →
      fdrWeakEq c s V F₀ → fdrWeakEq c s W FD := by
    intro V W F₀ FD hV hW hF hFD hVW hFFD hid ζ hζ hζc hζs hOex
    obtain ⟨O, hO, hOf, hOz⟩ := hOex
    obtain ⟨ζh, hc1, hc2, hc3, hc4⟩ := hcut ζ hζ hζc hζs O hO hOf hOz
    have hag := hagreeH ζh ζ hc4
    obtain ⟨ha1, ha2, ha3⟩ := htestd ζ hζ hζc a
    have h0 := hid (partialDeriv a ζ) ha1 ha2 (ha3.trans hζs)
      ⟨O, hO, hOf, hzeroO ζ O hO hOz a⟩
    have hIV : ∀ d, Integrable (fun x => V d x * partialDeriv d (partialDeriv a ζ) x)
        (volume.restrict (fcrHalf c s)) := fun d =>
      hint (V d) _ (hV d) (htestd _ ha1 ha2 d).1.continuous (htestd _ ha1 ha2 d).2.1
    rw [integral_add (integrable_finset_sum _ (fun d _ => hIV d))
        (hint F₀ _ hF ha1.continuous ha2),
      integral_finset_sum _ (fun d _ => hIV d)] at h0
    have hkey : ∀ d, ∫ x in fcrHalf c s, V d x * partialDeriv d (partialDeriv a ζ) x =
        -∫ x in fcrHalf c s, W d x * partialDeriv d ζ x := by
      intro d
      obtain ⟨hd1, hd2, hd3⟩ := htestd ζh hc1 hc2 d
      have e1 : ∫ x in fcrHalf c s, V d x * partialDeriv d (partialDeriv a ζ) x =
          ∫ x in fcrHalf c s, V d x * partialDeriv a (partialDeriv d ζh) x := by
        refine setIntegral_congr_fun hHmeas (fun x hx => ?_)
        simp only [hschwarz ζ hζ d a x, (hag x hx a d).2.2]
      have e2 : ∫ x in fcrHalf c s, W d x * partialDeriv d ζh x =
          ∫ x in fcrHalf c s, W d x * partialDeriv d ζ x := by
        refine setIntegral_congr_fun hHmeas (fun x hx => ?_)
        simp only [(hag x hx d d).2.1]
      rw [e1, hwdH (V d) (W d) a (hVW d) _ hd1 hd2 (hd3.trans hc3), e2]
    have hF' : ∫ x in fcrHalf c s, F₀ x * partialDeriv a ζ x =
        -∫ x in fcrHalf c s, FD x * ζ x := by
      have e1 : ∫ x in fcrHalf c s, F₀ x * partialDeriv a ζ x =
          ∫ x in fcrHalf c s, F₀ x * partialDeriv a ζh x := by
        refine setIntegral_congr_fun hHmeas (fun x hx => ?_)
        simp only [(hag x hx a a).2.1]
      have e2 : ∫ x in fcrHalf c s, FD x * ζh x = ∫ x in fcrHalf c s, FD x * ζ x := by
        refine setIntegral_congr_fun hHmeas (fun x hx => ?_)
        simp only [(hag x hx a a).1]
      rw [e1, hwdH F₀ FD a hFFD ζh hc1 hc2 hc3, e2]
    simp only [hkey, hF', Finset.sum_neg_distrib] at h0
    have hIW : ∀ d, Integrable (fun x => W d x * partialDeriv d ζ x)
        (volume.restrict (fcrHalf c s)) := fun d =>
      hint (W d) _ (hW d) (htestd ζ hζ hζc d).1.continuous (htestd ζ hζ hζc d).2.1
    rw [integral_add (integrable_finset_sum _ (fun d _ => hIW d))
        (hint FD _ hFD hζ.continuous hζc),
      integral_finset_sum _ (fun d _ => hIW d)]
    linarith
  
  have hDm : ∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s)) :=
    fun b => hP.1.2.1 [b] (by simp)
  have hpd : ∀ d b : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv a (fun y => A y d b)) (Metric.ball c R) :=
    fun d b => hpdm _ (hA d b)
  have hfirst : ∀ i, fcrWD c s w i (D [i]) := by
    intro i ζ h1 h2 h3
    have h0 := hP.1.2.2 [] i (by simp) ζ h1 h2 h3
    rw [hP.1.1] at h0
    exact h0
  have hsob : fcrSob c s 1 (D [a]) (fun L => match L with | [] => D [a] | b :: _ => E b) := by
    refine ⟨rfl, fun L hL => ?_, fun L b hL => ?_⟩
    · cases L with
      | nil => exact hDm a
      | cons b t => exact (hE b).2
    · cases L with
      | nil =>
        intro ζ hζ hζc hζs
        obtain ⟨hb1, hb2, hb3⟩ := htestd ζ hζ hζc b
        obtain ⟨ha1, ha2, ha3⟩ := htestd ζ hζ hζc a
        have h1 := hfirst a (partialDeriv b ζ) hb1 hb2 (hb3.trans hζs)
        have h2 := hfirst b (partialDeriv a ζ) ha1 ha2 (ha3.trans hζs)
        have h3 := (hE b).1 ζ hζ hζc hζs
        have he : (fun x => w x * partialDeriv a (partialDeriv b ζ) x) =
            (fun x => w x * partialDeriv b (partialDeriv a ζ) x) := by
          funext x
          rw [hschwarz ζ hζ a b x]
        rw [he] at h1
        show ∫ x, D [a] x * partialDeriv b ζ x = -∫ x, E b x * ζ x
        linarith
      | cons b' t => simp at hL
  have hVm : ∀ d, MemLp (fun x => (∑ b, A x d b * D [b] x) + G d x) 2
      (volume.restrict (fcrHalf c s)) := fun d =>
    (memLp_finset_sum Finset.univ
      (fun b _ => hmemsmul _ (hA d b).continuousOn _ (hDm b))).add (hP.2.2.1 d)
  have hG'm : ∀ d, MemLp (fun x => (∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x)
      2 (volume.restrict (fcrHalf c s)) := fun d =>
    (memLp_finset_sum Finset.univ
      (fun b _ => hmemsmul _ (hpd d b).continuousOn _ (hDm b))).add (hGa d).2
  have hWm : ∀ d, MemLp (fun x => (∑ b, A x d b * E b x) +
      ((∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x)) 2
      (volume.restrict (fcrHalf c s)) := fun d =>
    (memLp_finset_sum Finset.univ
      (fun b _ => hmemsmul _ (hA d b).continuousOn _ (hE b).2)).add (hG'm d)
  have hVW : ∀ d, fcrWD c s (fun x => (∑ b, A x d b * D [b] x) + G d x) a
      (fun x => (∑ b, A x d b * E b x) +
        ((∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x)) := by
    intro d
    have hS := hwdsum (fun b x => A x d b * D [b] x)
      (fun b x => partialDeriv a (fun y => A y d b) x * D [b] x + A x d b * E b x)
      (fun b => hmemsmul _ (hA d b).continuousOn _ (hDm b))
      (fun b => (hmemsmul _ (hpd d b).continuousOn _ (hDm b)).add
        (hmemsmul _ (hA d b).continuousOn _ (hE b).2))
      (fun b => hwdsmul _ (hA d b) _ _ (hDm b) (hE b).2 (hE b).1)
    have hT := hwdadd hS (hGa d).1
      (memLp_finset_sum Finset.univ (fun b _ => hmemsmul _ (hA d b).continuousOn _ (hDm b)))
      (hP.2.2.1 d)
      (memLp_finset_sum Finset.univ (fun b _ => (hmemsmul _ (hpd d b).continuousOn _ (hDm b)).add
        (hmemsmul _ (hA d b).continuousOn _ (hE b).2)))
      (hGa d).2
    have e : (fun x => (∑ b, (partialDeriv a (fun y => A y d b) x * D [b] x + A x d b * E b x))
        + GDa d x) = (fun x => (∑ b, A x d b * E b x) +
          ((∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x)) := by
      funext x
      rw [Finset.sum_add_distrib]
      ring
    rw [← e]
    exact hT
  refine ⟨hsob, hzta, hG'm, hFa.2, ?_⟩
  exact hcrux (fun d x => (∑ b, A x d b * D [b] x) + G d x)
    (fun d x => (∑ b, A x d b * E b x) +
      ((∑ b, partialDeriv a (fun y => A y d b) x * D [b] x) + GDa d x))
    F FDa hVm hWm hP.2.2.2.1 hFa.2 hVW hFa.1 hP.2.2.2.2

theorem fdr_dq_bounds (c : E3) (R s s₂ s₃ h₀ : ℝ) (hs₂ : 0 < s₂) (hh₀ : 0 < h₀)
    (h23 : s₂ + h₀ < s₃) (h3s : s₃ + 2 * h₀ ≤ s) (hsR : s < R)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef)
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hw : fcrSob c s 1 w D) (hF : MemLp F 2 (volume.restrict (fcrHalf c s)))
    (hG : ∀ d, ∃ DG, fcrSob c s 1 (G d) DG)
    (a : Fin 3) (ha : a ≠ 0) :
    ∃ lam Λ M : ℝ, 0 < lam ∧ 0 ≤ Λ ∧ 0 ≤ M ∧ ∀ h : ℝ, h ≠ 0 → |h| ≤ h₀ →
      (∀ x ∈ fcrHalf c s₂, ∀ ξ : Fin 3 → ℝ,
        lam * ∑ i : Fin 3, ξ i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, ξ i * A (x + h • e a) i j * ξ j) ∧
      (∀ x ∈ fcrHalf c s₂, ∀ i j : Fin 3, |A (x + h • e a) i j| ≤ Λ) ∧
      MemLp (fcrDQ a h w) 2 (volume.restrict (fcrHalf c s₂)) ∧
      (∀ d, MemLp (fcrDQ a h (D [d])) 2 (volume.restrict (fcrHalf c s₂))) ∧
      (∀ d, MemLp (fun x => (∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
        fcrDQ a h (G d) x) 2 (volume.restrict (fcrHalf c s₂))) ∧
      MemLp F 2 (volume.restrict (fcrHalf c s₂)) ∧
      ∫ x in fcrHalf c s₂, (fcrDQ a h w x) ^ 2 ≤ M ∧
      (∀ d, ∫ x in fcrHalf c s₂, ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
        fcrDQ a h (G d) x) ^ 2 ≤ M) ∧
      ∫ x in fcrHalf c s₂, (F x) ^ 2 ≤ M :=
by
  classical
  
  have hs3R : s₃ < R := by linarith
  have hs2s : s₂ + h₀ < s := by linarith
  have hea : ‖e a‖ = 1 := by simp [EuclideanSpace.norm_single]
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r : ℝ, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hsub : fcrHalf c s₂ ⊆ fcrHalf c s := by
    intro x hx
    have hx' : x ∈ Metric.ball c s₂ ∧ 0 < x 0 := hx
    exact ⟨Metric.ball_subset_ball (by linarith) hx'.1, hx'.2⟩
  have hμ : volume.restrict (fcrHalf c s₂) ≤ volume.restrict (fcrHalf c s) :=
    Measure.restrict_mono hsub le_rfl
  have hKsub : Metric.closedBall c s₃ ⊆ Metric.ball c R := Metric.closedBall_subset_ball hs3R
  have hshift : ∀ h : ℝ, |h| ≤ h₀ → ∀ x ∈ fcrHalf c s₂,
      x + h • e a ∈ Metric.closedBall c s₃ ∧ x + h • e a ∈ fcrHalf c s ∧
        x ∈ Metric.closedBall c s₃ := by
    intro h hh x hx
    have hx' : x ∈ Metric.ball c s₂ ∧ 0 < x 0 := hx
    have hxb : dist x c < s₂ := hx'.1
    have hx0 : 0 < x 0 := hx'.2
    have hn : ‖h • e a‖ = |h| := by rw [norm_smul, hea, mul_one, Real.norm_eq_abs]
    have htri : dist (x + h • e a) c ≤ dist x c + ‖h • e a‖ := by
      rw [dist_eq_norm, dist_eq_norm, add_sub_right_comm]
      exact norm_add_le _ _
    have hlt : dist (x + h • e a) c < s₃ := by linarith
    have h0 : (x + h • e a) 0 = x 0 := by
      simp [e, EuclideanSpace.single_apply, Ne.symm ha]
    refine ⟨Metric.mem_closedBall.2 hlt.le, ⟨Metric.mem_ball.2 (by linarith), ?_⟩,
      Metric.mem_closedBall.2 (by linarith)⟩
    show 0 < (x + h • e a) 0
    rw [h0]
    exact hx0
  
  obtain ⟨lam, Mx, Γ, hlam, -, -, hcb⟩ := coeff_compact_bounds A (Metric.ball c R) c s₃
    Metric.isOpen_ball hKsub hA hApos
  
  have hCb : ∀ i j : Fin 3, ∃ C : ℝ, ∀ y ∈ Metric.closedBall c s₃, ‖A y i j‖ ≤ C := fun i j =>
    (isCompact_closedBall c s₃).exists_bound_of_continuousOn ((hA i j).continuousOn.mono hKsub)
  choose C hC using hCb
  obtain ⟨Λ, hΛdef⟩ : ∃ Λ : ℝ, Λ = ∑ i : Fin 3, ∑ j : Fin 3, |C i j| := ⟨_, rfl⟩
  have hΛ0 : 0 ≤ Λ := by
    rw [hΛdef]
    exact Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
  have hCΛ : ∀ i j, |C i j| ≤ Λ := by
    intro i j
    rw [hΛdef]
    calc |C i j| ≤ ∑ j' : Fin 3, |C i j'| :=
          Finset.single_le_sum (f := fun j' => |C i j'|) (fun _ _ => abs_nonneg _)
            (Finset.mem_univ j)
      _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |C i' j'| :=
          Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, |C i' j'|)
            (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (Finset.mem_univ i)
  
  have hLip : ∀ d b : Fin 3, ∃ L : ℝ, 0 ≤ L ∧ ∀ x ∈ Metric.closedBall c s₃,
      ∀ y ∈ Metric.closedBall c s₃, |A y d b - A x d b| ≤ L * ‖y - x‖ := by
    intro d b
    have hfc : ContinuousOn (fderiv ℝ (fun z => A z d b)) (Metric.ball c R) :=
      (hA d b).continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)
    obtain ⟨C', hC'⟩ := (isCompact_closedBall c s₃).exists_bound_of_continuousOn (hfc.mono hKsub)
    refine ⟨max C' 0, le_max_right _ _, fun x hx y hy => ?_⟩
    have hdiff : ∀ z ∈ Metric.closedBall c s₃, DifferentiableAt ℝ (fun z => A z d b) z :=
      fun z hz => ((hA d b).differentiableOn (by simp)).differentiableAt
        (Metric.isOpen_ball.mem_nhds (hKsub hz))
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (C := max C' 0) hdiff
      (fun z hz => (hC' z hz).trans (le_max_left C' 0)) (convex_closedBall c s₃) hx hy
    rw [Real.norm_eq_abs] at hmvt
    exact hmvt
  choose Lc hLc0 hLc using hLip
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = ∑ d : Fin 3, ∑ b : Fin 3, Lc d b := ⟨_, rfl⟩
  have hL0 : 0 ≤ L := by
    rw [hLdef]
    exact Finset.sum_nonneg (fun d _ => Finset.sum_nonneg (fun b _ => hLc0 d b))
  have hLcL : ∀ d b, Lc d b ≤ L := by
    intro d b
    rw [hLdef]
    calc Lc d b ≤ ∑ b' : Fin 3, Lc d b' :=
          Finset.single_le_sum (f := fun b' => Lc d b') (fun _ _ => hLc0 _ _) (Finset.mem_univ b)
      _ ≤ ∑ d' : Fin 3, ∑ b' : Fin 3, Lc d' b' :=
          Finset.single_le_sum (f := fun d' => ∑ b' : Fin 3, Lc d' b')
            (fun _ _ => Finset.sum_nonneg (fun _ _ => hLc0 _ _)) (Finset.mem_univ d)
  
  choose DG hDG using hG
  have hwL : MemLp w 2 (volume.restrict (fcrHalf c s)) := by
    have h0 := hw.2.1 [] (by simp)
    rwa [hw.1] at h0
  have hDL : ∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s)) :=
    fun b => hw.2.1 [b] (by simp)
  have hGL : ∀ d, MemLp (G d) 2 (volume.restrict (fcrHalf c s)) := by
    intro d
    have h0 := (hDG d).2.1 [] (by simp)
    rwa [(hDG d).1] at h0
  have hFL : MemLp F 2 (volume.restrict (fcrHalf c s)) := hF
  
  obtain ⟨SI, hSI⟩ : ∃ SI : ℝ, SI = ∑ b : Fin 3, ∫ x in fcrHalf c s, (D [b] x) ^ 2 := ⟨_, rfl⟩
  obtain ⟨SJ, hSJ⟩ : ∃ SJ : ℝ, SJ = ∑ d : Fin 3, ∫ x in fcrHalf c s, (DG d [a] x) ^ 2 :=
    ⟨_, rfl⟩
  have hSI0 : 0 ≤ SI := by
    rw [hSI]
    exact Finset.sum_nonneg (fun b _ => integral_nonneg (fun x => sq_nonneg (D [b] x)))
  have hJle : ∀ d, ∫ x in fcrHalf c s, (DG d [a] x) ^ 2 ≤ SJ := by
    intro d
    rw [hSJ]
    exact Finset.single_le_sum (f := fun d => ∫ x in fcrHalf c s, (DG d [a] x) ^ 2)
      (fun d _ => integral_nonneg (fun x => sq_nonneg (DG d [a] x))) (Finset.mem_univ d)
  have hSJ0 : 0 ≤ SJ := le_trans (integral_nonneg (fun x => sq_nonneg (DG 0 [a] x))) (hJle 0)
  have hIa0 : 0 ≤ ∫ x in fcrHalf c s, (D [a] x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  have hΦ0 : 0 ≤ ∫ x in fcrHalf c s, (F x) ^ 2 := integral_nonneg (fun x => sq_nonneg _)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = (∫ x in fcrHalf c s, (D [a] x) ^ 2) +
      (∫ x in fcrHalf c s, (F x) ^ 2) + 4 * (L ^ 2 * SI) + 4 * SJ := ⟨_, rfl⟩
  have hL2 : 0 ≤ L ^ 2 := sq_nonneg L
  have hM0 : 0 ≤ M := by
    rw [hMdef]
    have := mul_nonneg hL2 hSI0
    linarith
  
  have hdq : ∀ (φ : E3 → ℝ) (h : ℝ), |h| ≤ h₀ → MemLp φ 2 (volume.restrict (fcrHalf c s)) →
      MemLp (fcrDQ a h φ) 2 (volume.restrict (fcrHalf c s₂)) := by
    intro φ h hh hφ
    have hind : MemLp ((fcrHalf c s).indicator φ) 2 volume :=
      (memLp_indicator_iff_restrict (hmeas s)).2 hφ
    have htr : MemLp (((fcrHalf c s).indicator φ) ∘ (fun x => x + h • e a)) 2 volume :=
      hind.comp_measurePreserving (measurePreserving_add_right volume (h • e a))
    have htr' : MemLp (fun x => φ (x + h • e a)) 2 (volume.restrict (fcrHalf c s₂)) := by
      refine (htr.restrict (fcrHalf c s₂)).ae_eq ?_
      refine ae_restrict_of_forall_mem (hmeas s₂) (fun x hx => ?_)
      simp only [Function.comp_apply]
      exact Set.indicator_of_mem (hshift h hh x hx).2.1 φ
    have hφ2 : MemLp φ 2 (volume.restrict (fcrHalf c s₂)) := hφ.mono_measure hμ
    have hm := (htr'.sub hφ2).mul_const h⁻¹
    refine hm.ae_eq (Filter.Eventually.of_forall (fun x => ?_))
    simp only [fcrDQ, div_eq_mul_inv, Pi.sub_apply]
  
  have hAdq : ∀ (h : ℝ), h ≠ 0 → |h| ≤ h₀ → ∀ d b : Fin 3,
      ContinuousOn (fcrDQ a h (fun y => A y d b)) (fcrHalf c s₂) ∧
      ∀ x ∈ fcrHalf c s₂, |fcrDQ a h (fun y => A y d b) x| ≤ L := by
    intro h hh0 hh d b
    constructor
    · have hmaps : Set.MapsTo (fun x : E3 => x + h • e a) (fcrHalf c s₂) (Metric.ball c R) :=
        fun x hx => hKsub (hshift h hh x hx).1
      have hmaps2 : fcrHalf c s₂ ⊆ Metric.ball c R := fun x hx => hKsub (hshift h hh x hx).2.2
      have h1 : ContinuousOn (fun x => A (x + h • e a) d b) (fcrHalf c s₂) :=
        (hA d b).continuousOn.comp (continuous_add_right (h • e a)).continuousOn hmaps
      have h2 : ContinuousOn (fun x => A x d b) (fcrHalf c s₂) := (hA d b).continuousOn.mono hmaps2
      exact (h1.sub h2).div_const h
    · intro x hx
      obtain ⟨hy, -, hxK⟩ := hshift h hh x hx
      have hl := hLc d b x hxK _ hy
      have hn : ‖x + h • e a - x‖ = |h| := by
        rw [add_sub_cancel_left, norm_smul, hea, mul_one, Real.norm_eq_abs]
      rw [hn] at hl
      have hpos : 0 < |h| := abs_pos.2 hh0
      unfold fcrDQ
      rw [abs_div, div_le_iff₀ hpos]
      calc |A (x + h • e a) d b - A x d b| ≤ Lc d b * |h| := hl
        _ ≤ L * |h| := mul_le_mul_of_nonneg_right (hLcL d b) hpos.le
  refine ⟨lam, Λ, M, hlam, hΛ0, hM0, fun h hh0 hh => ?_⟩
  have hs2h : s₂ + |h| < s := by linarith
  have hDb2 : ∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s₂)) :=
    fun b => (hDL b).mono_measure hμ
  have hpmem : ∀ d b, MemLp (fun x => fcrDQ a h (fun y => A y d b) x * D [b] x) 2
      (volume.restrict (fcrHalf c s₂)) := by
    intro d b
    obtain ⟨hc, hbd⟩ := hAdq h hh0 hh d b
    refine MemLp.of_le_mul (c := L) (hDb2 b)
      ((hc.aestronglyMeasurable (hmeas s₂)).mul (hDb2 b).aestronglyMeasurable) ?_
    refine ae_restrict_of_forall_mem (hmeas s₂) (fun x hx => ?_)
    rw [norm_mul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right (hbd x hx) (norm_nonneg _)
  have hRmem : ∀ d, MemLp (fun x => (∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) +
      fcrDQ a h (G d) x) 2 (volume.restrict (fcrHalf c s₂)) := by
    intro d
    exact (memLp_finset_sum Finset.univ (fun b _ => hpmem d b)).add (hdq _ h hh (hGL d))
  refine ⟨fun x hx ξ => (hcb _ (hshift h hh x hx).1).1 ξ, fun x hx i j => ?_,
    hdq w h hh hwL, fun d => hdq _ h hh (hDL d), hRmem, hFL.mono_measure hμ, ?_, fun d => ?_, ?_⟩
  · have h1 := hC i j _ (hshift h hh x hx).1
    rw [Real.norm_eq_abs] at h1
    exact h1.trans ((le_abs_self _).trans (hCΛ i j))
  · have h1 := fcr_dq_sob_L2_bound c s s₂ w D a ha h hs2h hw
    rw [hMdef]
    have := mul_nonneg hL2 hSI0
    linarith
  · have hq := fcr_dq_sob_L2_bound c s s₂ (G d) (DG d) a ha h hs2h (hDG d)
    have hqm : MemLp (fcrDQ a h (G d)) 2 (volume.restrict (fcrHalf c s₂)) := hdq _ h hh (hGL d)
    have hint1 : Integrable (fun x => ∑ b : Fin 3, D [b] x ^ 2) (volume.restrict (fcrHalf c s₂)) :=
      integrable_finset_sum _ (fun b _ => (hDb2 b).integrable_sq)
    have key : ∀ y0 y1 y2 q : ℝ, (y0 + y1 + y2 + q) ^ 2 ≤ 4 * (y0 ^ 2 + y1 ^ 2 + y2 ^ 2 + q ^ 2) := by
      intro y0 y1 y2 q
      nlinarith [sq_nonneg (y0 - y1), sq_nonneg (y0 - y2), sq_nonneg (y0 - q),
        sq_nonneg (y1 - y2), sq_nonneg (y1 - q), sq_nonneg (y2 - q)]
    have hpt : ∀ x ∈ fcrHalf c s₂,
        ((∑ b : Fin 3, fcrDQ a h (fun y => A y d b) x * D [b] x) + fcrDQ a h (G d) x) ^ 2 ≤
          4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) + 4 * fcrDQ a h (G d) x ^ 2 := by
      intro x hx
      have hb : ∀ b, (fcrDQ a h (fun y => A y d b) x * D [b] x) ^ 2 ≤ L ^ 2 * D [b] x ^ 2 := by
        intro b
        have h1 := (hAdq h hh0 hh d b).2 x hx
        have h2 : (fcrDQ a h (fun y => A y d b) x) ^ 2 ≤ L ^ 2 := by
          rw [← sq_abs]
          exact pow_le_pow_left₀ (abs_nonneg _) h1 2
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_right h2 (sq_nonneg _)
      have k := key (fcrDQ a h (fun y => A y d 0) x * D [0] x)
        (fcrDQ a h (fun y => A y d 1) x * D [1] x) (fcrDQ a h (fun y => A y d 2) x * D [2] x)
        (fcrDQ a h (G d) x)
      rw [Fin.sum_univ_three, Fin.sum_univ_three]
      linarith [hb 0, hb 1, hb 2]
    have hRint := (hRmem d).integrable_sq
    have hrhs : Integrable (fun x => 4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) +
        4 * fcrDQ a h (G d) x ^ 2) (volume.restrict (fcrHalf c s₂)) :=
      (hint1.const_mul (4 * L ^ 2)).add (hqm.integrable_sq.const_mul 4)
    have hstep1 := setIntegral_mono_on hRint hrhs (hmeas s₂) hpt
    have heq : ∫ x in fcrHalf c s₂, (4 * L ^ 2 * (∑ b : Fin 3, D [b] x ^ 2) +
        4 * fcrDQ a h (G d) x ^ 2) =
          4 * L ^ 2 * (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) +
          4 * (∫ x in fcrHalf c s₂, fcrDQ a h (G d) x ^ 2) := by
      rw [integral_add (hint1.const_mul _) (hqm.integrable_sq.const_mul _), integral_const_mul,
        integral_const_mul, integral_finset_sum _ (fun b _ => (hDb2 b).integrable_sq)]
    rw [heq] at hstep1
    have hsumle : (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) ≤ SI := by
      rw [hSI]
      exact Finset.sum_le_sum (fun b _ => setIntegral_mono_set (hDL b).integrable_sq
        (Filter.Eventually.of_forall (fun x => sq_nonneg _)) hsub.eventuallyLE)
    have h4 : 4 * L ^ 2 * (∑ b : Fin 3, ∫ x in fcrHalf c s₂, D [b] x ^ 2) ≤ 4 * L ^ 2 * SI :=
      mul_le_mul_of_nonneg_left hsumle (by positivity)
    have hJ := hJle d
    rw [hMdef]
    linarith
  · calc ∫ x in fcrHalf c s₂, (F x) ^ 2 ≤ ∫ x in fcrHalf c s, (F x) ^ 2 :=
          setIntegral_mono_set hFL.integrable_sq
            (Filter.Eventually.of_forall (fun x => sq_nonneg _)) hsub.eventuallyLE
      _ ≤ M := by
          rw [hMdef]
          have := mul_nonneg hL2 hSI0
          linarith

theorem fdr_dq_zt (c : E3) (s r : ℝ) (φ : E3 → ℝ) (Φ : Fin 3 → E3 → ℝ) (a : Fin 3) (ha : a ≠ 0)
    (h : ℝ) (hrs : r + |h| ≤ s) (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s)))
    (hΦ : ∀ d, MemLp (Φ d) 2 (volume.restrict (fcrHalf c s))) (hzt : fdrZT c s φ Φ) :
    fdrZT c r (fcrDQ a h φ) (fun d => fcrDQ a h (Φ d)) :=
by
  
  have hea0 : (e a) 0 = 0 := by
    simp [e, EuclideanSpace.single_apply, Ne.symm ha]
  have hn : ‖h • e a‖ = |h| := by
    rw [norm_smul]
    simp [e, EuclideanSpace.norm_single]
  obtain ⟨v, hv⟩ : ∃ v : E3, v = h • e a := ⟨_, rfl⟩
  have hnv : ‖v‖ = |h| := by rw [hv]; exact hn
  have hx0 : ∀ x : E3, (x + v) 0 = x 0 := by
    intro x
    simp only [hv, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hea0, mul_zero, add_zero]
  have hball : ∀ x : E3, dist x c < r → dist (x + v) c < s := by
    intro x hx
    have hle : dist (x + v) c ≤ dist x c + ‖v‖ := by
      rw [dist_eq_norm, dist_eq_norm]
      calc ‖x + v - c‖ = ‖(x - c) + v‖ := by congr 1; abel
        _ ≤ _ := norm_add_le _ _
    linarith
  have hrs' : r ≤ s := by linarith [abs_nonneg h]
  have hopen : ∀ ρ : ℝ, IsOpen (fcrHalf c ρ) := fun ρ =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ ρ, MeasurableSet (fcrHalf c ρ) := fun ρ => (hopen ρ).measurableSet
  
  haveI : IsFiniteMeasure (volume.restrict (fcrHalf c s)) :=
    isFiniteMeasure_restrict.2 (ne_top_of_le_ne_top measure_ball_lt_top.ne
      (measure_mono (show fcrHalf c s ⊆ Metric.ball c s from Set.inter_subset_left)))
  obtain ⟨φb, hφb⟩ : ∃ f : E3 → ℝ, f = (fcrHalf c s).indicator φ := ⟨_, rfl⟩
  obtain ⟨Φb, hΦb⟩ : ∃ F : Fin 3 → E3 → ℝ, F = fun d => (fcrHalf c s).indicator (Φ d) :=
    ⟨_, rfl⟩
  have hφbI : Integrable φb := by
    rw [hφb]
    exact IntegrableOn.integrable_indicator (hφ.integrable (by norm_num)) (hmeas s)
  have hΦbI : ∀ d, Integrable (Φb d) := by
    intro d
    rw [hΦb]
    exact IntegrableOn.integrable_indicator ((hΦ d).integrable (by norm_num)) (hmeas s)
  
  have hsi : ∀ (f g : E3 → ℝ), ∫ x in fcrHalf c s, f x * g x =
      ∫ x, (fcrHalf c s).indicator f x * g x := by
    intro f g
    rw [← integral_indicator (hmeas s)]
    congr 1
    funext x
    exact Set.indicator_mul_left _ _ _
  have hglob : ∀ (d : Fin 3) (ζ : E3 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c s →
      ∫ x, φb x * partialDeriv d ζ x = -∫ x, Φb d x * ζ x := by
    intro d ζ h1 h2 h3
    have h4 : ∫ x in fcrHalf c s, φ x * partialDeriv d ζ x =
        -∫ x in fcrHalf c s, Φ d x * ζ x := hzt d ζ h1 h2 h3
    rw [hsi φ (partialDeriv d ζ), hsi (Φ d) ζ] at h4
    rw [hφb, hΦb]
    exact h4
  have hDQ : ∀ (f : E3 → ℝ) (x : E3), fcrDQ a h f x = h⁻¹ * (f (x + v) - f x) := by
    intro f x
    rw [hv]
    simp only [fcrDQ]
    rw [div_eq_inv_mul]
  
  intro d ζ hζ hcs hts
  show ∫ x in fcrHalf c r, fcrDQ a h φ x * partialDeriv d ζ x =
    -∫ x in fcrHalf c r, fcrDQ a h (Φ d) x * ζ x
  have hts' : tsupport ζ ⊆ Metric.ball c s := hts.trans (Metric.ball_subset_ball hrs')
  have hdc : Continuous (partialDeriv d ζ) := by
    unfold partialDeriv
    exact (hζ.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hdcs : HasCompactSupport (partialDeriv d ζ) := HasCompactSupport.fderiv_apply ℝ hcs (e d)
  have hd0 : ∀ x, x ∉ tsupport ζ → partialDeriv d ζ x = 0 := by
    intro x hx
    have h0 : fderiv ℝ ζ x = 0 := by
      by_contra hne
      exact hx (support_fderiv_subset ℝ (Function.mem_support.2 hne))
    simp only [partialDeriv, h0, ContinuousLinearMap.zero_apply]
  have hz0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
  
  have hζm : ContDiff ℝ ∞ (fun y => ζ (y - v)) := hζ.comp (contDiff_id.sub contDiff_const)
  have hζm_eq : (fun y => ζ (y - v)) = ζ ∘ (Homeomorph.subRight v) := by
    funext y
    simp only [Function.comp_apply, Homeomorph.subRight_apply]
  have hcsm : HasCompactSupport (fun y => ζ (y - v)) := by
    rw [hζm_eq]; exact hcs.comp_homeomorph _
  have htsm : tsupport (fun y => ζ (y - v)) ⊆ Metric.ball c s := by
    rw [hζm_eq, tsupport_comp_eq_preimage]
    intro y hy
    have h1 : y - v ∈ tsupport ζ := by
      have h3 : (Homeomorph.subRight v) y ∈ tsupport ζ := hy
      rwa [Homeomorph.subRight_apply] at h3
    have h2 := hball _ (hts h1)
    rw [sub_add_cancel] at h2
    exact h2
  have hdm : ∀ y, partialDeriv d (fun y => ζ (y - v)) y = partialDeriv d ζ (y - v) := by
    intro y
    simp only [partialDeriv]
    rw [fderiv_comp_sub]
  
  have hwm := hglob d (fun y => ζ (y - v)) hζm hcsm htsm
  simp only [hdm] at hwm
  have hS2 := hglob d ζ hζ hcs hts'
  
  have cv1 : ∫ x, φb (x + v) * partialDeriv d ζ x = ∫ y, φb y * partialDeriv d ζ (y - v) := by
    have h1 := integral_add_right_eq_self (μ := volume)
      (fun y => φb y * partialDeriv d ζ (y - v)) v
    simp only [add_sub_cancel_right] at h1
    exact h1
  have cv2 : ∫ x, Φb d (x + v) * ζ x = ∫ y, Φb d y * ζ (y - v) := by
    have h1 := integral_add_right_eq_self (μ := volume) (fun y => Φb d y * ζ (y - v)) v
    simp only [add_sub_cancel_right] at h1
    exact h1
  
  obtain ⟨C₁, hC₁⟩ := hdc.bounded_above_of_compact_support hdcs
  obtain ⟨C₀, hC₀⟩ := hζ.continuous.bounded_above_of_compact_support hcs
  have I2 : Integrable (fun x => φb x * partialDeriv d ζ x) :=
    hφbI.mul_bdd hdc.aestronglyMeasurable (Filter.Eventually.of_forall hC₁)
  have I4 : Integrable (fun x => Φb d x * ζ x) :=
    (hΦbI d).mul_bdd hζ.continuous.aestronglyMeasurable (Filter.Eventually.of_forall hC₀)
  have I1' : Integrable (fun y => φb y * partialDeriv d ζ (y - v)) :=
    hφbI.mul_bdd (hdc.comp (continuous_sub_right v)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => hC₁ (y - v))
  have I3' : Integrable (fun y => Φb d y * ζ (y - v)) :=
    (hΦbI d).mul_bdd (hζ.continuous.comp (continuous_sub_right v)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => hC₀ (y - v))
  have I1 : Integrable (fun x => φb (x + v) * partialDeriv d ζ x) := by
    have h1 := I1'.comp_add_right v
    simp only [add_sub_cancel_right] at h1
    exact h1
  have I3 : Integrable (fun x => Φb d (x + v) * ζ x) := by
    have h1 := I3'.comp_add_right v
    simp only [add_sub_cancel_right] at h1
    exact h1
  
  have e1 : (fun x => fcrDQ a h φb x * partialDeriv d ζ x) =
      fun x => h⁻¹ * (φb (x + v) * partialDeriv d ζ x - φb x * partialDeriv d ζ x) := by
    funext x; rw [hDQ]; ring
  have e2 : (fun x => fcrDQ a h (Φb d) x * ζ x) =
      fun x => h⁻¹ * (Φb d (x + v) * ζ x - Φb d x * ζ x) := by
    funext x; rw [hDQ]; ring
  have hW : ∫ x, fcrDQ a h φb x * partialDeriv d ζ x = -∫ x, fcrDQ a h (Φb d) x * ζ x := by
    rw [e1, e2, integral_const_mul, integral_const_mul, integral_sub I1 I2, integral_sub I3 I4,
      cv1, cv2, hwm, hS2]
    ring
  
  have P : ∀ (f g : E3 → ℝ), (∀ x, x ∉ tsupport ζ → g x = 0) → ∀ x,
      (fcrHalf c r).indicator (fun y => fcrDQ a h f y * g y) x =
        fcrDQ a h ((fcrHalf c s).indicator f) x * g x := by
    intro f g hg x
    by_cases hx : x ∈ fcrHalf c r
    · rw [Set.indicator_of_mem hx]
      show fcrDQ a h f x * g x = _
      obtain ⟨hx1, hx2⟩ := hx
      have hxs : x ∈ fcrHalf c s := ⟨Metric.ball_subset_ball hrs' hx1, hx2⟩
      have hxvs : x + v ∈ fcrHalf c s := by
        refine ⟨hball x hx1, ?_⟩
        show 0 < (x + v) 0
        rw [hx0]
        exact hx2
      rw [hDQ, hDQ, Set.indicator_of_mem hxs, Set.indicator_of_mem hxvs]
    · rw [Set.indicator_of_notMem hx]
      by_cases hgx : g x = 0
      · rw [hgx, mul_zero]
      · have hxt : x ∈ tsupport ζ := by
          by_contra hc
          exact hgx (hg x hc)
        have hxb : x ∈ Metric.ball c r := hts hxt
        have hneg : ¬ (0 < x 0) := fun hpos => hx ⟨hxb, hpos⟩
        have h1 : x ∉ fcrHalf c s := fun hm => hneg hm.2
        have h2 : x + v ∉ fcrHalf c s := by
          intro hm
          have h3 : 0 < (x + v) 0 := hm.2
          rw [hx0] at h3
          exact hneg h3
        rw [hDQ, Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
        ring
  
  have eL : ∫ x in fcrHalf c r, fcrDQ a h φ x * partialDeriv d ζ x =
      ∫ x, fcrDQ a h φb x * partialDeriv d ζ x := by
    rw [← integral_indicator (hmeas r)]
    congr 1
    funext x
    rw [P φ _ hd0 x, hφb]
  have eR : ∫ x in fcrHalf c r, fcrDQ a h (Φ d) x * ζ x =
      ∫ x, fcrDQ a h (Φb d) x * ζ x := by
    rw [← integral_indicator (hmeas r)]
    congr 1
    funext x
    rw [P (Φ d) ζ hz0 x, hΦb]
  rw [eL, eR]
  exact hW

theorem fdr_zt_smul (c : E3) (s : ℝ) (m : E3 → ℝ) (hm : ContDiff ℝ ∞ m) (φ : E3 → ℝ)
    (Φ : Fin 3 → E3 → ℝ) (hφ : MemLp φ 2 (volume.restrict (fcrHalf c s)))
    (hΦ : ∀ d, MemLp (Φ d) 2 (volume.restrict (fcrHalf c s))) (hzt : fdrZT c s φ Φ) :
    fdrZT c s (fun x => m x * φ x) (fun d x => partialDeriv d m x * φ x + m x * Φ d x) :=
by
  classical
  have hpdsupp : ∀ (f : E3 → ℝ) (a : Fin 3),
      Function.support (fun x => partialDeriv a f x) ⊆ tsupport f := by
    intro f a x hx
    simp only [Function.mem_support, ne_eq] at hx
    apply tsupport_fderiv_subset (𝕜 := ℝ)
    apply subset_tsupport
    rw [Function.mem_support]
    intro h
    exact hx (by simp [partialDeriv, h])
  have hint : ∀ u g : E3 → ℝ, MemLp u 2 (volume.restrict (fcrHalf c s)) → Continuous g →
      HasCompactSupport g →
      Integrable (fun x => u x * g x) (volume.restrict (fcrHalf c s)) := by
    intro u g hu hg hgc
    have hg2 : MemLp g 2 (volume.restrict (fcrHalf c s)) :=
      (hg.memLp_of_hasCompactSupport hgc).restrict _
    exact hu.integrable_mul hg2
  intro d ζ hζ hζc hζs
  have hη : ContDiff ℝ ∞ (fun x => m x * ζ x) := hm.mul hζ
  have hηc : HasCompactSupport (fun x => m x * ζ x) := hζc.mul_left
  have hηs : tsupport (fun x => m x * ζ x) ⊆ Metric.ball c s :=
    (tsupport_mul_subset_right).trans hζs
  have hprod : ∀ x, partialDeriv d (fun y => m y * ζ y) x =
      partialDeriv d m x * ζ x + m x * partialDeriv d ζ x := by
    intro x
    have hmd : DifferentiableAt ℝ m x := hm.differentiable (by simp) x
    have hζd : DifferentiableAt ℝ ζ x := hζ.differentiable (by simp) x
    unfold partialDeriv
    rw [fderiv_fun_mul hmd hζd]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have h0 : ∫ x in fcrHalf c s, φ x * partialDeriv d (fun y => m y * ζ y) x =
      -∫ x in fcrHalf c s, Φ d x * (m x * ζ x) := hzt d _ hη hηc hηs
  have hξ : Continuous (fun x => partialDeriv d m x * ζ x) :=
    ((hm.continuous_fderiv (by simp)).clm_apply continuous_const).mul hζ.continuous
  have i1 : Integrable (fun x => φ x * partialDeriv d (fun y => m y * ζ y) x)
      (volume.restrict (fcrHalf c s)) := by
    refine hint φ _ hφ ?_ ?_
    · exact (hη.continuous_fderiv (by simp)).clm_apply continuous_const
    · exact hηc.mono' (hpdsupp _ d)
  have i2 : Integrable (fun x => φ x * (partialDeriv d m x * ζ x))
      (volume.restrict (fcrHalf c s)) :=
    hint φ _ hφ hξ hζc.mul_left
  have i3 : Integrable (fun x => Φ d x * (m x * ζ x)) (volume.restrict (fcrHalf c s)) :=
    hint (Φ d) _ (hΦ d) hη.continuous hηc
  have e1 : (fun x => m x * φ x * partialDeriv d ζ x) =
      fun x => φ x * partialDeriv d (fun y => m y * ζ y) x -
        φ x * (partialDeriv d m x * ζ x) := by
    funext x
    rw [hprod x]
    ring
  have e2 : (fun x => (partialDeriv d m x * φ x + m x * Φ d x) * ζ x) =
      fun x => φ x * (partialDeriv d m x * ζ x) + Φ d x * (m x * ζ x) := by
    funext x
    ring
  show ∫ x in fcrHalf c s, m x * φ x * partialDeriv d ζ x =
    -∫ x in fcrHalf c s, (partialDeriv d m x * φ x + m x * Φ d x) * ζ x
  rw [e1, e2, integral_sub i1 i2, integral_add i2 i3, h0]
  ring

theorem fdr_h1_test (c : E3) (R s s₂ s₃ : ℝ) (hs₂ : 0 < s₂) (h23 : s₂ < s₃) (h3s : s₃ ≤ s)
    (hsR : s < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (w : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ) (G : Fin 3 → E3 → ℝ) (F : E3 → ℝ)
    (hP : fdrProb c s A w D G F) (ψ : E3 → ℝ) (Ψ : Fin 3 → E3 → ℝ)
    (hψ : MemLp ψ 2 (volume.restrict (fcrHalf c s₃)))
    (hΨ : ∀ d, MemLp (Ψ d) 2 (volume.restrict (fcrHalf c s₃)))
    (hzt : fdrZT c s₃ ψ Ψ)
    (hψ0 : ∀ x, x ∉ Metric.ball c s₂ → ψ x = 0)
    (hΨ0 : ∀ d x, x ∉ Metric.ball c s₂ → Ψ d x = 0) :
    ∫ x in fcrHalf c s,
      ((∑ d : Fin 3, ((∑ b : Fin 3, A x d b * D [b] x) + G d x) * Ψ d x) + F x * ψ x) = 0 :=
by
  classical
  
  have hopen : ∀ r : ℝ, IsOpen (fcrHalf c r) := fun r =>
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hmeas : ∀ r, MeasurableSet (fcrHalf c r) := fun r => (hopen r).measurableSet
  have hfin : ∀ r, IsFiniteMeasure (volume.restrict (fcrHalf c r)) := fun r =>
    isFiniteMeasure_restrict.mpr
      ((measure_mono (fun x hx => hx.1 : fcrHalf c r ⊆ Metric.ball c r)).trans_lt
        measure_ball_lt_top).ne
  have hF : MemLp F 2 (volume.restrict (fcrHalf c s)) := hP.2.2.2.1
  
  have hind : ∀ f : E3 → ℝ, MemLp f 2 (volume.restrict (fcrHalf c s₃)) →
      (∀ x, x ∉ Metric.ball c s₂ → f x = 0) →
      MemLp ((fcrHalf c s₃).indicator f) 2 volume ∧ Integrable ((fcrHalf c s₃).indicator f) ∧
      (∀ t, t ∉ fcrHalf c s₂ → (fcrHalf c s₃).indicator f t = 0) ∧
      (∀ x ∈ fcrHalf c s, (fcrHalf c s₃).indicator f x = f x) := by
    intro f hf hf0
    haveI := hfin s₃
    refine ⟨(memLp_indicator_iff_restrict (hmeas s₃)).2 hf,
      (integrable_indicator_iff (hmeas s₃)).2 (hf.integrable (by norm_num)), ?_, ?_⟩
    · intro t ht
      by_cases htb : t ∈ Metric.ball c s₂
      · have ht3 : t ∉ fcrHalf c s₃ := fun h => ht ⟨htb, h.2⟩
