  have hKfin : volume K < ⊤ := hKc.measure_lt_top
  have hmK : m ≤ (volume K).toReal := (ENNReal.ofReal_le_iff_le_toReal hKfin.ne).1 hKvol
  
  obtain ⟨δ, hδ, hδO⟩ := hKc.exists_thickening_subset_open hO hKO
