            ![-(L * Real.sin p.2), L * Real.cos p.2] a *
            ![-(L * Real.sin p.2), L * Real.cos p.2] b) ≠ 0 :=
        fun p => (mul_pos (Real.sqrt_pos.2 (hq1 p)) (Real.sqrt_pos.2 (hq2 p))).ne'
      have hfin := hnum.mul (hden.inv₀ hden0)
      refine hfin.congr fun p => ?_
      show _ = curvKappa (cylGam G p.1 L p.2) (cylGam G p.1 L p.2)⁻¹ (cylDG G p.1 L p.2) L p.2
      simp only [curvKappa]
      exact (div_eq_mul_inv _ _).symm
    exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (μ := volume) (f := fun t s => curvIntegrand G t L s) hcont 0 (2 * Real.pi)
  
  refine ⟨R₁ + 1, fun L hL => ?_⟩
  have hLR : R₁ < L := by linarith
  have hκ := hκgen (hAF.ends k) _ R₀ R₁ C hXY L hLR
  intro n q φ hadm A hA hAsub hreg θ hθ
  obtain ⟨κ', hκ'⟩ : ∃ f : ℝ → ℝ, f = fun t =>
      2 * Real.pi - sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun s t =>
      sbgbSliceJ g β u q φ (sternDomain (hAF.ends k) β Y L) t s := ⟨_, rfl⟩
  have hκ'c : Continuous κ' := by rw [hκ']; exact continuous_const.sub hκ
  obtain ⟨B, hB⟩ := hA.exists_bound_of_continuousOn hκ'c.continuousOn
  have hκ'int : MeasureTheory.IntegrableOn κ' A := hκ'c.continuousOn.integrableOn_compact hA
  have hcoarea := stern_band_coarea g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe
    hX hdom hconn hchart L hL q φ hadm A hA hAsub hreg
  obtain ⟨s₀, hs₀, Cb, hbd, hlim⟩ := stern_slice_collar_limit g hAF hR k β Re hβ hmin u hu hharm
    hneu X Y R₀ R₁ C hXY hRe hX hdom hconn hchart L hL q φ hadm A hA hAsub hreg
  have hgb : ∀ t ∈ A, sbgbSliceLim g β u q φ (sternDomain (hAF.ends k) β Y L) t ≤ κ' t := by
    intro t ht
    have htL : |t| < L := abs_lt.mpr (hAsub ht)
    rw [hκ']
    refine stern_slice_gauss_bonnet g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe
      hX hdom hconn hchart L hL q φ hadm t htL ?_
    intro p hp
    refine hreg p hp.1 ?_
    rw [show u p = t from hp.2]
    exact ht
  have hFint : ∀ s : ℝ, 0 < s → MeasureTheory.IntegrableOn (F s) A := by
    intro s hs
    rw [hF]
    exact (hcoarea s hs).1
  have hFeq : ∀ s : ℝ, 0 < s →
      sternBandJ g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) s = ∫ t in A, F s t := by
    intro s hs
    rw [hF]
    exact (hcoarea s hs).2
  have hFbd : ∀ s : ℝ, 0 < s → s < s₀ → ∀ t ∈ A, |F s t| ≤ Cb := by
    intro s hs hs' t ht
    rw [hF]
    exact hbd s hs hs' t ht
  have hFlim : ∀ t ∈ A, Tendsto (fun s => F s t) (𝓝[>] (0 : ℝ))
      (𝓝 (sbgbSliceLim g β u q φ (sternDomain (hAF.ends k) β Y L) t)) := by
    intro t ht
    rw [hF]
    exact hlim t ht
  
  have hHint : ∀ s : ℝ, 0 < s →
      MeasureTheory.IntegrableOn (fun t => max (F s t) (κ' t)) A := by
    intro s hs
    refine ((hFint s hs).sup hκ'int).congr (Filter.Eventually.of_forall fun t => ?_)
    simp only [Pi.sup_apply]
  have hmeasA : MeasurableSet A := hA.measurableSet
  have hDCT : Tendsto (fun s => ∫ t in A, max (F s t) (κ' t)) (𝓝[>] (0 : ℝ))
      (𝓝 (∫ t in A, κ' t)) := by
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun _ => |Cb| + |B|) ?_ ?_ ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact (hHint s hs).aestronglyMeasurable
    · filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
      refine (MeasureTheory.ae_restrict_iff' hmeasA).mpr (Filter.Eventually.of_forall fun t ht => ?_)
      have ha := abs_le.mp (hFbd s hs.1 hs.2 t ht)
      have hb' : |κ' t| ≤ B := by
        have := hB t ht
        rwa [Real.norm_eq_abs] at this
      have hb := abs_le.mp hb'
      have h1 := le_abs_self Cb
      have h2 := le_abs_self B
      have h3 := abs_nonneg Cb
      have h4 := abs_nonneg B
      rw [Real.norm_eq_abs, abs_le]
      constructor
      · exact le_trans (by linarith) (le_max_left _ _)
      · exact max_le (by linarith) (by linarith)
    · exact continuous_const.continuousOn.integrableOn_compact hA
    · refine (MeasureTheory.ae_restrict_iff' hmeasA).mpr (Filter.Eventually.of_forall fun t ht => ?_)
      have h := (hFlim t ht).max (tendsto_const_nhds (x := κ' t))
      rwa [max_eq_right (hgb t ht)] at h
  have hlt : ∫ t in A, κ' t < (∫ t in A, κ' t) + θ := by linarith
  have hev := hDCT (Iio_mem_nhds hlt)
  obtain ⟨s₂, hs₂, hsub⟩ :=
    mem_nhdsGT_iff_exists_Ioo_subset.mp (Filter.inter_mem hev (Ioo_mem_nhdsGT hs₀))
  refine ⟨s₂, hs₂, fun s hs hss => ?_⟩
  have hmem := hsub ⟨hs, hss⟩
  have hI : ∫ t in A, max (F s t) (κ' t) < (∫ t in A, κ' t) + θ := hmem.1
  have hmono : ∫ t in A, F s t ≤ ∫ t in A, max (F s t) (κ' t) :=
    MeasureTheory.integral_mono (hFint s hs) (hHint s hs) (fun t => le_max_left _ _)
  have hk2 : κ' = fun t =>
      -(sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t - 2 * Real.pi) := by
    rw [hκ']
    funext t
    ring
  have hkint : ∫ t in A, κ' t =
      -(∫ t in A, (sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t - 2 * Real.pi)) := by
    rw [hk2, MeasureTheory.integral_neg]
  rw [hFeq s hs]
  linarith

theorem stern_integration_core [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0)
    (hboch : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f V → (∀ y ∈ V, lapLoc G f y = 0) →
      ∀ (ε : ℝ), 0 < ε →
      ∀ y ∈ V, ricGradLoc G f y ≤ sternPhiLoc G f ε y * lapLoc G (sternPhiLoc G f ε) y ∧
        (0 < gradSqLoc G f y →
          (1 / 2 : ℝ) * hessSqLoc G f y +
              (1 / 2 : ℝ) * gradSqLoc G f y * (scalarCurvatureLocal G y - 2 * levelGaussLoc G f y)
            ≤ sternPhiLoc G f ε y * lapLoc G (sternPhiLoc G f ε) y))
    (hneuloc : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f b : E3 → ℝ), ContDiffOn ℝ ∞ f V → ContDiffOn ℝ ∞ b V →
      (∀ z ∈ V, b z = 0 → gradInnerLoc G f b z = 0) →
      ∀ (y : E3), y ∈ V → b y = 0 → 0 < gradSqLoc G b y →
      ∀ (ε : ℝ), 0 < ε →
      -(gradInnerLoc G (sternPhiLoc G f ε) b y) = hessGGLoc G b f y / sternPhiLoc G f ε y)
    (hsard : ∀ (f : E3 → ℝ) (V : Set E3), IsOpen V → ContDiffOn ℝ ∞ f V →
      MeasureTheory.volume (f '' {y | y ∈ V ∧ fderiv ℝ f y = 0}) = 0)
    (hgauss : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f V →
      ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W →
      (∀ x ∈ W, F x ∈ V) → (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (c : ℝ), (∀ x ∈ W, f (F x) = c) → (∀ x ∈ W, 0 < gradSqLoc G f (F x)) →
      ∀ x ∈ W, gaussCurv2 (pullMetric2 G F) x = levelGaussLoc G f (F x)) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  obtain ⟨L₁a, hA⟩ := stern_cutoff_divergence g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁b, hB⟩ := stern_bad_set_estimate g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁c, hC⟩ := stern_band_eps_limit g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁d, hD⟩ := stern_band_gauss_bonnet g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  refine ⟨max (max (max L₁a L₁b) (max L₁c L₁d)) (R₁ + 1), fun L hL => ?_⟩
  have hL0 : max (max L₁a L₁b) (max L₁c L₁d) ≤ L := le_trans (le_max_left _ _) hL
  have hLa : L₁a ≤ L :=
    le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hL0
  have hLb : L₁b ≤ L :=
    le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hL0
  have hLc : L₁c ≤ L :=
    le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hL0
  have hLd : L₁d ≤ L :=
    le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hL0
  have hLR : R₁ < L := by
    have := le_trans (le_max_right _ _) hL
    linarith
  obtain ⟨n, q, φ, hadm, s₀, hs₀, hdiv⟩ := hA L hLa
  have hlim := stern_flux_eps_limit g (hAF.ends k) X Y _ R₀ R₁ C hXY L hLR
  have key : ∀ θ : ℝ, 0 < θ →
      curvTerm (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L - 4 * Real.pi * L - θ ≤
        cylFlux (gradVec (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)) L := by
    intro θ hθ
    have hθ' : 0 < θ / 4 := by positivity
    obtain ⟨δ, hδ, hcomp⟩ :=
      stern_kappa_comparison g (hAF.ends k) X Y _ R₀ R₁ C hXY L hLR (θ / 4) hθ'
    obtain ⟨U, hUo, hUvol, hLU1, hLU2, hcrit, hbad⟩ := hB L hLb q φ hadm (θ / 4) hθ' δ hδ
    have hAc : IsCompact (Set.Icc (-L) L \ U) := isCompact_Icc.diff hUo
    have hAsub : Set.Icc (-L) L \ U ⊆ Set.Ioo (-L) L := by
      rintro t ⟨⟨h1, h2⟩, htU⟩
      refine ⟨lt_of_le_of_ne h1 ?_, lt_of_le_of_ne h2 ?_⟩
      · rintro rfl
        exact htU hLU1
      · rintro rfl
        exact htU hLU2
    have hAreg : ∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ Set.Icc (-L) L \ U →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 := by
      intro p hp hpA hzero
      exact hpA.2 (hcrit p hp hzero)
    have hAmeas : MeasurableSet (Set.Icc (-L) L \ U) := hAc.isClosed.measurableSet
    have hAvol : volume (Set.Icc (-L) L \ (Set.Icc (-L) L \ U)) < ENNReal.ofReal δ := by
      refine lt_of_le_of_lt (measure_mono ?_) hUvol
      rintro t ⟨ht1, ht2⟩
      by_contra htU
      exact ht2 ⟨ht1, htU⟩
    have hI := hcomp (Set.Icc (-L) L \ U) hAmeas Set.diff_subset hAvol
    obtain ⟨ε₁, hε₁, hband⟩ := hC L hLc q φ hadm (Set.Icc (-L) L \ U) hAc hAsub hAreg (θ / 4) hθ'
    obtain ⟨s₃, hs₃, hgb⟩ := hD L hLd q φ hadm (Set.Icc (-L) L \ U) hAc hAsub hAreg (θ / 4) hθ'
    have hev : ∀ᶠ ε in 𝓝[>] (0 : ℝ),
        curvTerm (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L - 4 * Real.pi * L - θ ≤
          cylFlux (sternVecEps (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) ε) L := by
      filter_upwards [Ioo_mem_nhdsGT (lt_min hε₁ one_pos)] with ε hε
      have hε0 : 0 < ε := hε.1
      have hεe : ε < ε₁ := lt_of_lt_of_le hε.2 (min_le_left _ _)
      have hε1 : ε ≤ 1 := le_of_lt (lt_of_lt_of_le hε.2 (min_le_right _ _))
      obtain ⟨s₁, hs₁, hbad'⟩ := hbad ε hε0 hε1
      obtain ⟨s₂, hs₂, hband'⟩ := hband ε hε0 hεe
      have hm : 0 < min (min s₀ s₁) (min s₂ s₃) := lt_min (lt_min hs₀ hs₁) (lt_min hs₂ hs₃)
      have hspos : 0 < min (min s₀ s₁) (min s₂ s₃) / 2 := half_pos hm
      have hslt : min (min s₀ s₁) (min s₂ s₃) / 2 < min (min s₀ s₁) (min s₂ s₃) :=
        half_lt_self hm
      have h0 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₀ :=
        lt_of_lt_of_le hslt (le_trans (min_le_left _ _) (min_le_left _ _))
      have h1 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₁ :=
        lt_of_lt_of_le hslt (le_trans (min_le_left _ _) (min_le_right _ _))
      have h2 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₂ :=
        lt_of_lt_of_le hslt (le_trans (min_le_right _ _) (min_le_left _ _))
      have h3 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₃ :=
        lt_of_lt_of_le hslt (le_trans (min_le_right _ _) (min_le_right _ _))
      have e1 := hdiv _ hspos h0 ε hε0
      have e2 := hbad' _ hspos h1
      have e3 := hband' _ hspos h2
      have e4 := hgb _ hspos h3
      linarith
    exact ge_of_tendsto hlim hev
  unfold sternBoundary
  apply le_of_forall_pos_le_add
  intro θ hθ
  have := key θ hθ
  linarith

theorem stern_inequality_of_components [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hcomp : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ p₀ ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        (connectedComponentIn (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) p₀ ∩
          sternSide (hAF.ends k) Y L).Nonempty) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  obtain ⟨hΨ, hdomL⟩ := hdom
  have hR02 : (2 : ℝ) ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hYs : ContDiffOn ℝ ∞ Y {x : E3 | R₁ < ‖x‖} := hXY.2.2.2.2.1
  have hYX := hXY.2.2.2.2.2.1
  have hY1 : ∀ x : E3, R₁ < ‖x‖ → 1 < ‖Y x‖ := fun x hx => by
    have := (hYX x hx).1
    linarith
  have hYinj : Set.InjOn Y {x : E3 | R₁ < ‖x‖} := by
    intro a ha b hb hab
    rw [← (hYX a ha).2, ← (hYX b hb).2, hab]
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hΦc : ContinuousOn (hAF.ends k).Φ (hAF.ends k).Φ.source :=
    (hAF.ends k).Φ.contMDiffOn.continuousOn
  have hΨc : ContinuousOn (sternPsi (hAF.ends k) Y) {x : E3 | R₁ < ‖x‖} := by
    refine hΦc.comp hYs.continuousOn ?_
    intro x hx
    rw [hsrc]
    exact hY1 x hx
  have hΨinj : Set.InjOn (sternPsi (hAF.ends k) Y) {x : E3 | R₁ < ‖x‖} := by
    intro a ha b hb hab
    have h1 : Y a ∈ (hAF.ends k).Φ.source := by rw [hsrc]; exact hY1 a ha
    have h2 : Y b ∈ (hAF.ends k).Φ.source := by rw [hsrc]; exact hY1 b hb
    exact hYinj ha hb ((hAF.ends k).Φ.toPartialEquiv.injOn h1 h2 hab)
  have hnsq : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  
  have hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) := by
    intro L hL t ht hreg
    have hL0 : 0 < L := by linarith
    have hbig : ∀ x : E3, L ^ 2 ≤ ‖x‖ ^ 2 → R₁ < ‖x‖ := by
      intro x hx
      have hn := norm_nonneg x
      by_contra hcon
      push_neg at hcon
      nlinarith
    set K := sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t} with hKdef
    let f : ℝ → E3 := fun s => cylPt t (L * Real.cos s) (L * Real.sin s)
    have hfc : Continuous f := by
      simp only [f, cylPt]
      fun_prop
    have hfU : ∀ s : ℝ, R₁ < ‖f s‖ := by
      intro s
      apply hbig
      rw [hnsq]
      obtain ⟨h0, h1, h2⟩ := hcyl t (L * Real.cos s) (L * Real.sin s)
      simp only [f]
      rw [h0, h1, h2]
      have := Real.cos_sq_add_sin_sq s
      nlinarith [sq_nonneg t]
    set Cc := Set.range (fun s => sternPsi (hAF.ends k) Y (f s)) with hCdef
    have hCconn : IsConnected Cc := by
      have : Set.range (fun s => sternPsi (hAF.ends k) Y (f s)) =
          (fun s => sternPsi (hAF.ends k) Y (f s)) '' Set.univ := Set.image_univ.symm
      rw [hCdef, this]
      refine isConnected_univ.image _ ?_
      exact hΨc.comp hfc.continuousOn (fun s _ => hfU s)
    have hCK : Cc ⊆ K := by
      rintro p ⟨s, rfl⟩
      obtain ⟨h0, h1, h2⟩ := hcyl t (L * Real.cos s) (L * Real.sin s)
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · exact le_of_lt (hΨ (f s) (hfU s)).2
      · rintro ⟨x', hx', hxe⟩
        have hx'U : R₁ < ‖x'‖ := by
          apply hbig
          rw [hnsq]
          simp only [Set.mem_setOf_eq, not_and_or, not_le] at hx'
          rcases hx' with h | h
          · have : L ^ 2 < x' 0 ^ 2 := by
              rw [← sq_abs (x' 0)]
              exact pow_lt_pow_left₀ h hL0.le (by norm_num)
            nlinarith [sq_nonneg (x' 1), sq_nonneg (x' 2)]
          · nlinarith [sq_nonneg (x' 0)]
        have hxeq : x' = f s := hΨinj hx'U (hfU s) hxe
        apply hx'
        rw [hxeq]
        simp only [f]
        rw [h0, h1, h2]
        refine ⟨le_of_lt ht, ?_⟩
        have := Real.cos_sq_add_sin_sq s
        nlinarith
      · show u (sternPsi (hAF.ends k) Y (f s)) = t
        rw [(hΨ (f s) (hfU s)).1]
        simp only [f]
        exact h0
    have hreach : ∀ p₀ ∈ K, Cc ⊆ connectedComponentIn K p₀ := by
      intro p₀ hp₀
      obtain ⟨q, hqcomp, hqside⟩ := hcomp L hL t ht hreg p₀ hp₀
      obtain ⟨x, ⟨hx0, hx12⟩, rfl⟩ := hqside
      have hxU : R₁ < ‖x‖ := by
        apply hbig
        rw [hnsq]
        nlinarith [sq_nonneg (x 0)]
      have hqK : sternPsi (hAF.ends k) Y x ∈ K := connectedComponentIn_subset K p₀ hqcomp
      have hxt : x 0 = t := by
        have h1 : u (sternPsi (hAF.ends k) Y x) = t := hqK.2
        rw [(hΨ x hxU).1] at h1
        exact h1
      have hqC : sternPsi (hAF.ends k) Y x ∈ Cc := by
        let z : ℂ := ⟨x 1, x 2⟩
        have hz : ‖z‖ = L := by
          have h1 : ‖z‖ ^ 2 = L ^ 2 := by
            rw [Complex.sq_norm, Complex.normSq_mk]
            nlinarith
          have := norm_nonneg z
          nlinarith
        refine ⟨Complex.arg z, ?_⟩
        have hfx : f (Complex.arg z) = x := by
          obtain ⟨h0, h1, h2⟩ :=
            hcyl t (L * Real.cos (Complex.arg z)) (L * Real.sin (Complex.arg z))
          have hc : L * Real.cos (Complex.arg z) = x 1 := by
            rw [← hz]; exact Complex.norm_mul_cos_arg z
          have hs : L * Real.sin (Complex.arg z) = x 2 := by
            rw [← hz]; exact Complex.norm_mul_sin_arg z
          ext i
          fin_cases i
          · exact h0.trans hxt.symm
          · exact h1.trans hc
          · exact h2.trans hs
        show sternPsi (hAF.ends k) Y (f (Complex.arg z)) = sternPsi (hAF.ends k) Y x
        rw [hfx]
      have hsub : Cc ⊆ connectedComponentIn K (sternPsi (hAF.ends k) Y x) :=
        hCconn.isPreconnected.subset_connectedComponentIn hqC hCK
      rwa [← connectedComponentIn_eq hqcomp] at hsub
    have hc₀ : sternPsi (hAF.ends k) Y (f 0) ∈ Cc := ⟨0, rfl⟩
    have hc₀K : sternPsi (hAF.ends k) Y (f 0) ∈ K := hCK hc₀
    have hKeq : K = connectedComponentIn K (sternPsi (hAF.ends k) Y (f 0)) := by
      refine Set.Subset.antisymm ?_ (connectedComponentIn_subset _ _)
      intro p₀ hp₀
      have h1 : sternPsi (hAF.ends k) Y (f 0) ∈ connectedComponentIn K p₀ := hreach p₀ hp₀ hc₀
      rw [← connectedComponentIn_eq h1]
      exact mem_connectedComponentIn hp₀
    rw [hKeq]
    exact isConnected_connectedComponentIn_iff.mpr hc₀K
  have hharmV : ∀ x : E3, R₁ < ‖x‖ → g.lapM u (sternPsi (hAF.ends k) Y x) = 0 :=
    fun x hx => hharm _ (le_of_lt (hΨ x hx).2)
  have hchart := stern_chart_identities g (hAF.ends k) u hu X Y _ R₀ R₁ C hXY
    (fun x hx => (hΨ x hx).1) hharmV
  exact stern_integration_core g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe hX
    ⟨hΨ, hdomL⟩ hconn hchart stern_bochner_local stern_neumann_local morse_sard_E3
    level_gauss_equation

theorem stern_cylinder_inequality [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (hlev : NoCompactRegularLevel β u)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2)) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  have hq0 : 0 < min hAF.q (3 / 4) :=
    lt_min (lt_trans (by norm_num) hAF.q_gt) (by norm_num)
  have hq1 : min hAF.q (3 / 4) < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hesc := end_chart_escape g hAF k
  have hdom := stern_domain_facts (hAF.ends k) β u Re hβ X Y (min hAF.q (3 / 4)) R₀ R₁ C
    hq0 hq1 hXY hRe hX hesc
  have hβc : Continuous β := hβ.1.continuous
  have huc : Continuous u := hu.continuous
  have hcomp : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ p₀ ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        (connectedComponentIn (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) p₀ ∩
          sternSide (hAF.ends k) Y L).Nonempty := by
    intro L hL t ht hreg p₀ hp₀
    exact level_components_reach_side (hAF.ends k) β u Y R₁ L t hβc huc hL ht
      (fun x hx => (hdom.1 x hx).1) (hdom.2 L hL).1 (hdom.2 L hL).2.2.1
      ((hdom.2 L hL).2.2.2 t ht) hlev hreg p₀ hp₀
  exact stern_inequality_of_components g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hcomp

theorem stern_harmonic_cylinder_bound [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds) :
    ∃ (R₀ R₁ C : ℝ) (X Y : E3 → E3),
      CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C ∧
      (∀ x : E3, R₁ < ‖x‖ →
        ∑ i : Fin 3, ∑ j : Fin 3,
          (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ i j *
            christoffel (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) 0 i j x = 0) ∧
      ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
        0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  
  have hnormsq : ∀ t a b : ℝ, ‖cylPt t a b‖ ^ 2 = t ^ 2 + a ^ 2 + b ^ 2 := by
    intro t a b
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [cylPt, e, EuclideanSpace.single_apply]
  have hnormge : ∀ t a b L : ℝ, L ^ 2 ≤ t ^ 2 + a ^ 2 + b ^ 2 → L ≤ ‖cylPt t a b‖ := by
    intro t a b L hL
    have h1 := hnormsq t a b
    have h2 : 0 ≤ ‖cylPt t a b‖ := norm_nonneg _
    nlinarith
  have hcongr : ∀ (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R : ℝ),
      (∀ x : E3, R < ‖x‖ → G₁ x = G₂ x) →
      (∀ x : E3, R < ‖x‖ → ∀ k i j : Fin 3, christoffel G₁ k i j x = christoffel G₂ k i j x) ∧
      (∀ L : ℝ, R < L → sternBoundary G₁ L = sternBoundary G₂ L) := by
    intro G₁ G₂ R h
    have hpd : ∀ x : E3, R < ‖x‖ → ∀ (F : Matrix (Fin 3) (Fin 3) ℝ → ℝ) (c : Fin 3),
        partialDeriv c (fun z => F (G₁ z)) x = partialDeriv c (fun z => F (G₂ z)) x := by
      intro x hx F c
      have hU : {y : E3 | R < ‖y‖} ∈ 𝓝 x :=
        (isOpen_lt continuous_const continuous_norm).mem_nhds hx
      have hev : (fun z => F (G₁ z)) =ᶠ[𝓝 x] (fun z => F (G₂ z)) :=
        Filter.eventually_of_mem hU (fun y hy => by simp only [h y hy])
      unfold partialDeriv
      rw [Filter.EventuallyEq.fderiv_eq hev]
    have hpd3 : ∀ x : E3, R < ‖x‖ → ∀ a b c : Fin 3,
        partialDeriv c (fun z => G₁ z a b) x = partialDeriv c (fun z => G₂ z a b) x :=
      fun x hx a b c => hpd x hx (fun A => A a b) c
    have hchr : ∀ x : E3, R < ‖x‖ → ∀ k i j : Fin 3,
        christoffel G₁ k i j x = christoffel G₂ k i j x := by
      intro x hx k i j
      simp only [christoffel, h x hx, hpd3 x hx]
    have hgrad : ∀ x : E3, R < ‖x‖ → gradVec G₁ x = gradVec G₂ x := by
      intro x hx
      have h1 : ∀ l : Fin 3, partialDeriv l (fun z => Real.sqrt ((G₁ z)⁻¹ 0 0)) x =
          partialDeriv l (fun z => Real.sqrt ((G₂ z)⁻¹ 0 0)) x :=
        fun l => hpd x hx (fun A => Real.sqrt (A⁻¹ 0 0)) l
      funext l
      simp only [gradVec, h x hx, h1]
    refine ⟨hchr, fun L hL => ?_⟩
    have hside : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
      intro t s
      refine lt_of_lt_of_le hL (hnormge _ _ _ _ ?_)
      have := Real.cos_sq_add_sin_sq s
      nlinarith [sq_nonneg t]
    have hcap : ∀ t ρ s : ℝ, t ^ 2 = L ^ 2 →
        R < ‖cylPt t (ρ * Real.cos s) (ρ * Real.sin s)‖ := by
      intro t ρ s ht
      refine lt_of_lt_of_le hL (hnormge _ _ _ _ ?_)
      nlinarith [sq_nonneg (ρ * Real.cos s), sq_nonneg (ρ * Real.sin s)]
    have hcurv : ∀ t s : ℝ, curvIntegrand G₁ t L s = curvIntegrand G₂ t L s := by
      intro t s
      have hP := hside t s
      simp only [curvIntegrand, h _ hP, hpd3 _ hP]
    have hgs : ∀ t s : ℝ, gradVec G₁ (cylPt t (L * Real.cos s) (L * Real.sin s)) =
        gradVec G₂ (cylPt t (L * Real.cos s) (L * Real.sin s)) :=
      fun t s => hgrad _ (hside t s)
    have hgc1 : ∀ ρ s : ℝ, gradVec G₁ (cylPt L (ρ * Real.cos s) (ρ * Real.sin s)) =
        gradVec G₂ (cylPt L (ρ * Real.cos s) (ρ * Real.sin s)) :=
      fun ρ s => hgrad _ (hcap L ρ s rfl)
    have hgc2 : ∀ ρ s : ℝ, gradVec G₁ (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s)) =
        gradVec G₂ (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s)) :=
      fun ρ s => hgrad _ (hcap (-L) ρ s (by ring))
    simp only [sternBoundary, curvTerm, cylFlux, capFlux, sideFlux, hcurv, hgs, hgc1, hgc2]
  
  obtain ⟨D⟩ := exterior_cover_exists g hComplete hAF hR k
  have hqeq : D.af.q = hAF.q := D.q_eq
  have hq0' : 0 < D.af.q := lt_trans (by norm_num) D.af.q_gt
  have hq'pos : 0 < min hAF.q (3 / 4) :=
    lt_min (lt_trans (by norm_num) hAF.q_gt) (by norm_num)
  have hq'lt1 : min hAF.q (3 / 4) < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hsrc' : (D.af.ends D.endIdx).Φ.source = {x : E3 | 1 < ‖x‖} :=
    (D.af.ends D.endIdx).source_eq
  have hsmooth' : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun y => D.metric.coeff (D.af.ends D.endIdx).Φ y i j) {x : E3 | 1 < ‖x‖} := by
    intro i j
    rw [← hsrc']
    exact coeff_contDiffOn_source D.metric (D.af.ends D.endIdx).Φ i j
  have hsymm' : ∀ (y : E3) (i j : Fin 3), D.metric.coeff (D.af.ends D.endIdx).Φ y i j =
      D.metric.coeff (D.af.ends D.endIdx).Φ y j i := by
    intro y i j
    exact D.metric.symm _ _ _
  obtain ⟨RG, CG, hRG1, hCG0, hbG⟩ :=
    metric_coeff_bounds (D.metric.coeff (D.af.ends D.endIdx).Φ) D.af.q hq0' hsmooth'
      (D.af.decay D.endIdx)
  
  obtain ⟨u, Ru, Cu, hReRu, hCu, hu, hharm, hneu, hend⟩ :=
    neumann_harmonic_exists D.metric D.af D.endIdx D.β D.Re D.exterior
  rw [hqeq] at hend
  have hlev : NoCompactRegularLevel D.β u :=
    no_compact_regular_level D.metric (D.af.ends D.endIdx) D.β D.Re D.exterior D.separates
      u hu hharm hneu
  
  have hR2 : (2 : ℝ) ≤ max (max Ru RG) 2 := le_max_right _ _
  have hRu : Ru ≤ max (max Ru RG) 2 := le_trans (le_max_left _ _) (le_max_left _ _)
  have hRG : RG ≤ max (max Ru RG) 2 := le_trans (le_max_right _ _) (le_max_left _ _)
  have hv : ContDiffOn ℝ ∞ (fun z => u ((D.af.ends D.endIdx).Φ z))
      {y : E3 | max (max Ru RG) 2 < ‖y‖} := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u ∘ (D.af.ends D.endIdx).Φ)
        (D.af.ends D.endIdx).Φ.source :=
      hu.comp_contMDiffOn (D.af.ends D.endIdx).Φ.contMDiffOn
    have h2 := contMDiffOn_iff_contDiffOn.mp h1
    rw [hsrc'] at h2
    refine h2.mono ?_
    intro y hy
    show (1 : ℝ) < ‖y‖
    have : max (max Ru RG) 2 < ‖y‖ := hy
    linarith
  have hvb : ∀ y : E3, max (max Ru RG) 2 < ‖y‖ →
      |u ((D.af.ends D.endIdx).Φ y) - y 0| ≤ Cu * ‖y‖ ^ (1 - min hAF.q (3 / 4)) ∧
      (∀ i : Fin 3, |partialDeriv i (fun z => u ((D.af.ends D.endIdx).Φ z)) y
          - (if i = 0 then (1 : ℝ) else 0)| ≤ Cu * ‖y‖ ^ (-(min hAF.q (3 / 4)))) ∧
      (∀ i j : Fin 3, |partialDeriv i (fun z => partialDeriv j
          (fun w => u ((D.af.ends D.endIdx).Φ w)) z) y|
          ≤ Cu * ‖y‖ ^ (-(min hAF.q (3 / 4)) - 1)) := by
    intro y hy
    exact (hend y (lt_of_le_of_lt hRu hy)).2
  obtain ⟨R₀, R₁, C', Y, hRR₀, hXY⟩ :=
    harmonic_coord_change (fun z => u ((D.af.ends D.endIdx).Φ z)) (min hAF.q (3 / 4))
      (max (max Ru RG) 2) Cu hq'pos hq'lt1 hR2 hCu hv hvb
  
  have hgauge' := gauge_of_harmonic_first_coord (D.metric.coeff (D.af.ends D.endIdx).Φ)
    (fun z => u ((D.af.ends D.endIdx).Φ z)) (min hAF.q (3 / 4)) (max (max Ru RG) 2)
    R₀ R₁ C' Y
    (fun i j => (hsmooth' i j).mono (fun y (hy : max (max Ru RG) 2 < ‖y‖) =>
      (show (1 : ℝ) < ‖y‖ by linarith)))
    hsymm'
    (fun y hy => ne_of_gt (lt_of_lt_of_le (by norm_num)
      (hbG y (lt_of_le_of_lt hRG hy)).1))
    hv
    (fun y hy => (hend y (lt_of_le_of_lt hRu hy)).1)
    hXY hRR₀
  
  have hXY' : CoordChange (fun y => cylPt (u ((D.af.ends D.endIdx).Φ y)) (y 1) (y 2)) Y
      (min D.af.q (3 / 4)) R₀ R₁ C' := by
    rw [hqeq]; exact hXY
  obtain ⟨L₁, hstern'⟩ := stern_cylinder_inequality D.metric D.af D.scal_nonneg D.endIdx
    D.β D.Re D.exterior D.minimal u hu hharm hneu hlev _ Y R₀ R₁ C' hXY'
    (le_trans hReRu (le_trans hRu hRR₀)) (fun y _ => rfl)
  
  have hfar : ∀ x : E3, R₁ < ‖x‖ →
      pullbackMetric (g.coeff (hAF.ends k).Φ) Y x =
        pullbackMetric (D.metric.coeff (D.af.ends D.endIdx).Φ) Y x := by
    intro x hx
    have h1 : R₀ < ‖Y x‖ := (hXY.2.2.2.2.2.1 x hx).1
    have h2 : (2 : ℝ) ≤ R₀ := hXY.1
    have h3 : (1 : ℝ) < ‖Y x‖ := by linarith
    unfold pullbackMetric
    rw [D.coeff_eq (Y x) h3]
  obtain ⟨hchr, hst⟩ := hcongr _ _ R₁ hfar
  refine ⟨R₀, R₁, C', _, Y, hXY, ?_, max L₁ (R₁ + 1), ?_⟩
  · intro x hx
    rw [hfar x hx]
    simp only [hchr x hx]
    exact hgauge' x hx
  · intro L hL
    have hL1 : L₁ ≤ L := le_trans (le_max_left _ _) hL
    have hL2 : R₁ < L := by
      have := le_trans (le_max_right _ _) hL
      linarith
    rw [hst L hL2]
    exact hstern' L hL1

theorem lin3_solve_bound (E : Fin 3 → Fin 3 → ℝ) (m n : Fin 3 → ℝ) (ε ν : ℝ) (hε : ε ≤ 1 / 6)
    (hE : ∀ i j : Fin 3, |E i j| ≤ ε) (hn : ∀ i : Fin 3, |n i| ≤ ν)
    (heq : ∀ i : Fin 3, m i + ∑ j : Fin 3, E i j * m j = n i) :
    ∀ i : Fin 3, |m i| ≤ 2 * ν ∧ |m i - n i| ≤ 6 * ε * ν :=
by
  have hε0 : 0 ≤ ε := le_trans (abs_nonneg _) (hE 0 0)
  have hν0 : 0 ≤ ν := le_trans (abs_nonneg _) (hn 0)
  have hS0 : 0 ≤ |m 0| + |m 1| + |m 2| := by
    have := abs_nonneg (m 0); have := abs_nonneg (m 1); have := abs_nonneg (m 2); linarith
  have hterm : ∀ i j : Fin 3, |E i j * m j| ≤ ε * |m j| := by
    intro i j
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hE i j) (abs_nonneg _)
  have hdiff : ∀ i : Fin 3, |m i - n i| ≤ ε * (|m 0| + |m 1| + |m 2|) := by
    intro i
    have h := heq i
    rw [Fin.sum_univ_three] at h
    have e0 := abs_le.mp (hterm i 0)
    have e1 := abs_le.mp (hterm i 1)
    have e2 := abs_le.mp (hterm i 2)
    rw [abs_le]
    constructor <;> linarith [e0.1, e0.2, e1.1, e1.2, e2.1, e2.2]
  have hmi : ∀ i : Fin 3, |m i| ≤ ν + ε * (|m 0| + |m 1| + |m 2|) := by
    intro i
    have h1 := abs_sub_abs_le_abs_sub (m i) (n i)
    have h2 := hn i
    have h3 := hdiff i
    linarith
  have hS : |m 0| + |m 1| + |m 2| ≤ 6 * ν := by
    have a0 := hmi 0
    have a1 := hmi 1
    have a2 := hmi 2
    have hp : ε * (|m 0| + |m 1| + |m 2|) ≤ 1 / 6 * (|m 0| + |m 1| + |m 2|) :=
      mul_le_mul_of_nonneg_right hε hS0
    linarith
  have hp1 : ε * (|m 0| + |m 1| + |m 2|) ≤ ε * (6 * ν) :=
    mul_le_mul_of_nonneg_left hS hε0
  have hp2 : (6 * ε) * ν ≤ 1 * ν :=
    mul_le_mul_of_nonneg_right (by linarith) hν0
  intro i
  have h1 := hdiff i
  have h2 := hmi i
  constructor
  · linarith
  · linarith

theorem pullback_entry_algebra (B M g dg : Fin 3 → Fin 3 → ℝ) (φ η μ ν : ℝ)
    (hB : ∀ i a : Fin 3, |B i a| ≤ 2)
    (hBφ : ∀ i a : Fin 3, |B i a - (if i = a then (1 : ℝ) else 0)| ≤ φ)
    (hg : ∀ i j : Fin 3, |g i j - (if i = j then (1 : ℝ) else 0)| ≤ η) (hη : η ≤ 1)
    (hM : ∀ i a : Fin 3, |M i a| ≤ μ) (hdg : ∀ i j : Fin 3, |dg i j| ≤ ν) (a b : Fin 3) :
    |∑ i : Fin 3, ∑ j : Fin 3, B i a * g i j * B j b - (if a = b then (1 : ℝ) else 0)|
        ≤ 7 * φ + 36 * η ∧
    |∑ i : Fin 3, ∑ j : Fin 3,
        (M i a * g i j * B j b + B i a * dg i j * B j b + B i a * g i j * M j b)|
        ≤ 72 * μ + 36 * ν :=
by
  have sum3 : ∀ (f : Fin 3 → ℝ) (c : ℝ), (∀ i, |f i| ≤ c) → |∑ i, f i| ≤ 3 * c := by
    intro f c hf
    rw [Fin.sum_univ_three]
    have h0 := abs_le.mp (hf 0)
    have h1 := abs_le.mp (hf 1)
    have h2 := abs_le.mp (hf 2)
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have sum9 : ∀ (f : Fin 3 → Fin 3 → ℝ) (c : ℝ), (∀ i j, |f i j| ≤ c) →
      |∑ i, ∑ j, f i j| ≤ 9 * c := by
    intro f c hf
    have h := sum3 (fun i => ∑ j, f i j) (3 * c) (fun i => sum3 (f i) c (hf i))
    linarith
  have mul2 : ∀ (x y X Y : ℝ), |x| ≤ X → |y| ≤ Y → |x * y| ≤ X * Y := by
    intro x y X Y hx hy
    rw [abs_mul]
    exact mul_le_mul hx hy (abs_nonneg _) (le_trans (abs_nonneg _) hx)
  have mul3 : ∀ (x y z X Y Z : ℝ), |x| ≤ X → |y| ≤ Y → |z| ≤ Z → |x * y * z| ≤ X * Y * Z :=
    fun x y z X Y Z hx hy hz => mul2 _ _ _ _ (mul2 _ _ _ _ hx hy) hz
  have hg2 : ∀ i j : Fin 3, |g i j| ≤ 2 := by
    intro i j
    have h := abs_le.mp (hg i j)
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl] at h
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [if_neg hij] at h
      exact abs_le.mpr ⟨by linarith, by linarith⟩
  have s4 : ∑ i : Fin 3, ∑ j : Fin 3, B i a * g i j * B j b - (if a = b then (1 : ℝ) else 0)
      = ∑ i : Fin 3, ∑ j : Fin 3, B i a * (g i j - (if i = j then (1 : ℝ) else 0)) * B j b
        + ∑ i : Fin 3, B i a * (B i b - (if i = b then (1 : ℝ) else 0))
        + (B b a - (if b = a then (1 : ℝ) else 0)) := by
    fin_cases a <;> fin_cases b <;> simp [Fin.sum_univ_three] <;> ring
  constructor
  · rw [s4]
    have T1 := sum9 (fun i j => B i a * (g i j - (if i = j then (1 : ℝ) else 0)) * B j b)
      (2 * η * 2) (fun i j => mul3 _ _ _ _ _ _ (hB i a) (hg i j) (hB j b))
    have T2 := sum3 (fun i => B i a * (B i b - (if i = b then (1 : ℝ) else 0)))
      (2 * φ) (fun i => mul2 _ _ _ _ (hB i a) (hBφ i b))
    have T3 := hBφ b a
    have e1 := abs_le.mp T1
    have e2 := abs_le.mp T2
    have e3 := abs_le.mp T3
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  · have h := sum9 (fun i j =>
        M i a * g i j * B j b + B i a * dg i j * B j b + B i a * g i j * M j b)
      (μ * 2 * 2 + 2 * ν * 2 + 2 * 2 * μ) (by
        intro i j
        have u1 := abs_le.mp (mul3 _ _ _ _ _ _ (hM i a) (hg2 i j) (hB j b))
        have u2 := abs_le.mp (mul3 _ _ _ _ _ _ (hB i a) (hdg i j) (hB j b))
        have u3 := abs_le.mp (mul3 _ _ _ _ _ _ (hB i a) (hg2 i j) (hM j b))
        exact abs_le.mpr ⟨by linarith, by linarith⟩)
    linarith

theorem coordChange_norm_compare (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hXY : CoordChange X Y q R₀ R₁ C) (x : E3) (hx : R₁ < ‖x‖) :
    R₀ < ‖Y x‖ ∧ ‖x‖ ≤ (1 + C) * ‖Y x‖ ∧ ‖Y x‖ ^ (-q) ≤ (1 + C) * ‖x‖ ^ (-q) ∧
      ‖Y x‖ ^ (-q - 1) ≤ (1 + C) ^ 2 * ‖x‖ ^ (-q - 1) :=
by
  obtain ⟨hR0, hR01, hC, -, -, hinv, -, hbd⟩ := hXY
  obtain ⟨hs0, hXYx⟩ := hinv x hx
  obtain ⟨hdisp, -, -⟩ := hbd (Y x) hs0
  rw [hXYx] at hdisp
  have hs1 : (1 : ℝ) ≤ ‖Y x‖ := by linarith
  have hrpos : 0 < ‖x‖ := by linarith
  have hκ1 : (1 : ℝ) ≤ 1 + C := by linarith
  have hκpos : (0 : ℝ) < 1 + C := by linarith
  have hpow : ‖Y x‖ ^ (1 - q) ≤ ‖Y x‖ := by
    have h := Real.rpow_le_rpow_of_exponent_le hs1 (by linarith : 1 - q ≤ 1)
    rwa [Real.rpow_one] at h
  have htri : ‖x‖ ≤ ‖Y x‖ + ‖x - Y x‖ := norm_le_insert' x (Y x)
  have hB : ‖x‖ ≤ (1 + C) * ‖Y x‖ := by
    have h := mul_le_mul_of_nonneg_left hpow hC.le
    linarith
  have hbase : ‖x‖ / (1 + C) ≤ ‖Y x‖ := by
    rw [div_le_iff₀ hκpos]; linarith
  have hbpos : 0 < ‖x‖ / (1 + C) := div_pos hrpos hκpos
  have key : ∀ a : ℝ, 0 ≤ a → ‖Y x‖ ^ (-a) ≤ ‖x‖ ^ (-a) * (1 + C) ^ a := by
    intro a ha
    have h1 := Real.rpow_le_rpow_of_nonpos hbpos hbase (by linarith : -a ≤ 0)
    rw [Real.div_rpow hrpos.le hκpos.le, Real.rpow_neg hκpos.le a, div_inv_eq_mul] at h1
    exact h1
  have hr0 : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hrpos.le _
  have hr1 : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hrpos.le _
  refine ⟨hs0, hB, ?_, ?_⟩
  · have h1 := key q hq0.le
    have h2 : (1 + C) ^ q ≤ 1 + C := by
      have h := Real.rpow_le_rpow_of_exponent_le hκ1 hq1.le
      rwa [Real.rpow_one] at h
    calc ‖Y x‖ ^ (-q) ≤ ‖x‖ ^ (-q) * (1 + C) ^ q := h1
      _ ≤ ‖x‖ ^ (-q) * (1 + C) := mul_le_mul_of_nonneg_left h2 hr0
      _ = (1 + C) * ‖x‖ ^ (-q) := mul_comm _ _
  · have h1 := key (q + 1) (by linarith)
    have he : -(q + 1) = -q - 1 := by ring
    rw [he] at h1
    have h2 : (1 + C) ^ (q + 1) ≤ (1 + C) ^ (2 : ℕ) := by
      have h := Real.rpow_le_rpow_of_exponent_le hκ1 (by linarith : q + 1 ≤ 2)
      rwa [Real.rpow_two] at h
    calc ‖Y x‖ ^ (-q - 1) ≤ ‖x‖ ^ (-q - 1) * (1 + C) ^ (q + 1) := h1
      _ ≤ ‖x‖ ^ (-q - 1) * (1 + C) ^ (2 : ℕ) := mul_le_mul_of_nonneg_left h2 hr1
      _ = (1 + C) ^ 2 * ‖x‖ ^ (-q - 1) := mul_comm _ _

theorem pullback_metric_decay (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
