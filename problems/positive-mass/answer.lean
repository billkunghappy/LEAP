theorem hpHarn_envelope_viscosity : ∀ Λ₀ β₀ : ℝ, 0 < Λ₀ → 0 < β₀ → ∃ δ₃ : ℝ, 0 < δ₃ ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (a b : ℝ) (ℓ υ : E2 → ℝ),
    IsOpen U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U) →
    (∀ (z : E3) (i j : Fin 3), G z i j = G z j i) → (∀ z ∈ U, (G z).PosDef) →
    Metric.closedBall (0 : E3) 1 ⊆ U → a < b → b - a ≤ δ₃ →
    (∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
       |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ δ₃ ∧
       ‖fderiv ℝ (fun w => G w i j) z‖ ≤ δ₃ * (b - a)) →
    -(1 / 8) ≤ a → b ≤ 1 / 8 →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2), a ≤ ℓ x ∧ ℓ x ≤ υ x ∧ υ x ≤ b) →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2),
      (∀ N ∈ 𝓝 (hpLift (ℓ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) ∧
      (∀ N ∈ 𝓝 (hpLift (υ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0)) →
    volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ z 0 < ℓ (hpProj z)} \ F) = 0 →
    volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ υ (hpProj z) < z 0} ∩ F) = 0 →
    (∀ (W : Set E3) (f : E3 → ℝ) (z₀ : E3), IsOpen W → W ⊆ U → ContDiff ℝ ∞ f → z₀ ∈ W →
      f z₀ = 0 → (∀ N ∈ 𝓝 z₀, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      ((∀ z ∈ W, levelMeanCurvCoord G f z < 0) →
          volume ((W ∩ {z | f z < 0}) \ F) = 0 → False) ∧
      ((∀ z ∈ W, 0 < levelMeanCurvCoord G f z) →
          volume (W ∩ {z | 0 < f z} ∩ F) = 0 → False)) →
    hpSuperSol (fun x => (ℓ x - a) / (b - a)) Λ₀ β₀ ∧
      hpSuperSol (fun x => (b - υ x) / (b - a)) Λ₀ β₀ :=
by
  intro Λ₀ β₀ hΛ₀ hβ₀
  obtain ⟨A, hAeq⟩ : ∃ A : ℝ, A = 2 * Λ₀ + 1 := ⟨_, rfl⟩
