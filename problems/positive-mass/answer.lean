      have hA5 := mul_le_mul_of_nonneg_left hτ'K hL0
      have hA6 := mul_le_mul_of_nonneg_left hA2 hK0
      have hA7 := mul_le_mul_of_nonneg_left hA3 hK0
      have hA8 := mul_le_mul_of_nonneg_left heε hL0
      have e1 : (K : ℝ) * (R ^ (α : ℝ) * (4 * (K : ℝ) / τ' + 2 * L * τ' ^ (α : ℝ))) =
          (8 * K * R ^ (α : ℝ) / τ') * K / 2 + L * (4 * K * R ^ (α : ℝ) * τ' ^ (α : ℝ)) / 2 := by
        ring
      linarith only [hA4, hA5, hA6, hA7, hA8, e1]
    have h13 : ∀ ζ ∈ Metric.ball (0 : Fin 2 → ℝ) T, ‖G ζ‖ ≤ ε * ‖ζ‖ ^ (α : ℝ) := by
      intro ζ hζ
      have hN : 0 ≤ ‖ζ‖ ^ (α : ℝ) := by positivity
      refine (pi_norm_le_iff_of_nonneg (by positivity)).2 (fun i => ?_)
      have hq := hAS ζ hζ
      have hFd : ‖F (x₀ + ρ • ζ) - F x₀‖ ≤ (K : ℝ) * (ρ ^ (α : ℝ) * ‖ζ‖ ^ (α : ℝ)) := by
        rw [← dist_eq_norm, ← Real.mul_rpow hρp.le (norm_nonneg _), ← hdistA]
        exact hHF.dist_le hq hx₀
      have had : ‖a (x₀ + ρ • ζ) - a x₀‖ ≤ (K : ℝ) * (ρ ^ (α : ℝ) * ‖ζ‖ ^ (α : ℝ)) := by
        rw [← dist_eq_norm, ← Real.mul_rpow hρp.le (norm_nonneg _), ← hdistA]
        exact hHa.dist_le hq hx₀
      obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = (K : ℝ) * (ρ ^ (α : ℝ) * ‖ζ‖ ^ (α : ℝ)) := ⟨_, rfl⟩
      rw [← hδ] at hFd had
      have hFi : |F (x₀ + ρ • ζ) i - F x₀ i| ≤ δ := by
        have := norm_le_pi_norm (F (x₀ + ρ • ζ) - F x₀) i
        simp only [Pi.sub_apply, Real.norm_eq_abs] at this
        linarith only [this, hFd]
      have haij : ∀ j, |a (x₀ + ρ • ζ) i j - a x₀ i j| ≤ δ := by
        intro j
        have h1 := norm_le_pi_norm (a (x₀ + ρ • ζ) - a x₀) i
        have h2 := norm_le_pi_norm ((a (x₀ + ρ • ζ) - a x₀) i) j
        simp only [Pi.sub_apply] at h1 h2
        rw [Real.norm_eq_abs] at h2
        linarith only [h1, h2, had]
      have hgj : ∀ j, |smthGrad w x₀ j| ≤ ‖smthGrad w x₀‖ := fun j => by
        have := norm_le_pi_norm (smthGrad w x₀) j
        rwa [Real.norm_eq_abs] at this
      have hδ0 : 0 ≤ δ := by rw [hδ]; positivity
      have hm : ∀ j, |(a (x₀ + ρ • ζ) i j - a x₀ i j) * smthGrad w x₀ j| ≤
