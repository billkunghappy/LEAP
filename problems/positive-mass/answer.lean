theorem slab_chart_from_flow_box [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (φ : M → ℝ) (S : Set M) (Ψ : ℝ → M → M) (s₁ : ℝ)
    (B : Set M) (f : M → ℝ) (hB : IsOpen B) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ x ∈ B, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0)
    (hBF : B ∩ frontier U = B ∩ f ⁻¹' {0}) (hFmin : IsMinimalSurfaceSet g (frontier U))
    (q : M) (B' : Set M) (τ : ℝ) (Fl : ℝ → M → M) (hB'o : IsOpen B') (hB'B : B' ⊆ B)
    (hτ : 0 < τ)
    (hFl : ∀ y ∈ B', Fl 0 y = y ∧ ∀ t ∈ Set.Ioo (-τ) τ,
        Fl t y ∈ B ∩ (chartAt E3 q).source ∧ f (Fl t y) = f y + t)
    (hFls : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2)))
        (Set.Ioo (-τ) τ ×ˢ (chartAt E3 q '' B')))
    (hker : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ chartAt E3 q '' B', ∀ (a : ℝ) (w : E3),
        fderiv ℝ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2))) (t, u)
          (a, w) = 0 →
        w = -a • fderiv ℝ (fun p : ℝ × E3 => chartAt E3 q (Fl p.1 ((chartAt E3 q).symm p.2)))
          (0, u) (1, 0))
    (hFlinj : ∀ y ∈ B', ∀ y' ∈ B', ∀ t ∈ Set.Ioo (-τ) τ, Fl t y = Fl t y' → y = y')
    (y₀ : M) (hy₀ : y₀ ∈ B' ∩ frontier U) (e c : ℝ) (he : e = 1 ∨ e = -1) (hc : 0 < c)
    (hcτ : c < τ)
    (lam : M → ℝ) (Λ : ℝ) (hlam : ∀ y ∈ B' ∩ frontier U, 0 < lam y ∧ lam y ≤ Λ)
    (hlams : ∀ (W : Set E2) (Fh : E2 → E3) (p : M), IsOpen W → ContDiffOn ℝ ∞ Fh W →
        (∀ x ∈ W, Fh x ∈ (chartAt E3 p).target ∧ (chartAt E3 p).symm (Fh x) ∈ frontier U ∩ B) →
        ContDiffOn ℝ ∞ (fun x => lam ((chartAt E3 p).symm (Fh x))) W)
    (hlamφ : ∀ y ∈ B' ∩ frontier U, lam y = φ y * Real.sqrt (g.gradInner f f y))
    (hs₁ : 0 < s₁) (hs₁Λ : s₁ * Λ < τ)
    (O₀ : Set M) (hO₀ : IsOpen O₀) (hℓO₀ : Fl (c * e) y₀ ∈ O₀)
    (hSO : ∀ w ∈ O₀, w ∈ S ↔ ∃ y ∈ B' ∩ frontier U, w = Fl (c * e) y)
    (hΨ : ∀ y ∈ B' ∩ frontier U, Fl (c * e) y ∈ O₀ → ∀ s ∈ Set.Ioo (-s₁) s₁,
        Ψ s (Fl (c * e) y) = Fl (s * lam y * e) y) :
    collarSlabChartAt g U φ S Ψ s₁ (Fl (c * e) y₀) :=
by
  classical
  set κ := chartAt E3 q with hκ
  set Fhat : ℝ × E3 → E3 := fun p => κ (Fl p.1 (κ.symm p.2)) with hFhat
  set Vh : Set E3 := κ '' B' with hVh
  set fh : E3 → ℝ := fun u => f (κ.symm u) with hfh
  have hI0 : (0 : ℝ) ∈ Set.Ioo (-τ) τ := ⟨by linarith, hτ⟩
  
  have CF1 : B' ⊆ κ.source := fun y hy => by
    have h1 := ((hFl y hy).2 0 hI0).1.2
    rwa [(hFl y hy).1] at h1
  
  have hVo : IsOpen Vh := κ.isOpen_image_of_subset_source hB'o CF1
  have hVt : Vh ⊆ κ.target := by
    rintro _ ⟨y, hy, rfl⟩
    exact κ.map_source (CF1 hy)
  
  have CF3 : ∀ u ∈ Vh, κ.symm u ∈ B' := by
    rintro _ ⟨y, hy, rfl⟩
    rw [κ.left_inv (CF1 hy)]
    exact hy
  
  have CF4 : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ Vh,
      Fhat (t, u) ∈ κ.target ∧ κ.symm (Fhat (t, u)) = Fl t (κ.symm u) := by
    intro t ht u hu
    have h1 := ((hFl _ (CF3 u hu)).2 t ht).1.2
    exact ⟨κ.map_source h1, κ.left_inv h1⟩
  have CF4' : ∀ u ∈ Vh, Fhat (0, u) = u := by
    intro u hu
    show κ (Fl 0 (κ.symm u)) = u
    rw [(hFl _ (CF3 u hu)).1, κ.right_inv (hVt hu)]
  
  have CF5 : ContDiffOn ℝ ∞ fh κ.target :=
    contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn contMDiffOn_chart_symm)
  
  have CF6 : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ Vh, fh (Fhat (t, u)) = fh u + t := by
    intro t ht u hu
    show f (κ.symm (Fhat (t, u))) = f (κ.symm u) + t
    rw [(CF4 t ht u hu).2]
    exact ((hFl _ (CF3 u hu)).2 t ht).2
  
  have CF7 : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ Vh, ∀ u' ∈ Vh, Fhat (t, u) = Fhat (t, u') → u = u' := by
    intro t ht u hu u' hu' h
    have h1 := ((hFl _ (CF3 u hu)).2 t ht).1.2
    have h2 := ((hFl _ (CF3 u' hu')).2 t ht).1.2
    have h3 : Fl t (κ.symm u) = Fl t (κ.symm u') := κ.injOn h1 h2 h
    have h4 := hFlinj _ (CF3 u hu) _ (CF3 u' hu') t ht h3
    rw [← κ.right_inv (hVt hu), h4, κ.right_inv (hVt hu')]
  
  have CF8 : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ Vh, ∀ w : E3,
      fderiv ℝ Fhat (t, u) (0, w) = 0 → w = 0 := by
    intro t ht u hu w h
    have h1 := hker t ht u hu 0 w h
    simpa using h1
  
  have CF9 : ∀ x ∈ B, (x ∈ frontier U ↔ f x = 0) := by
    intro x hx
    constructor
    · intro h
      have h1 : x ∈ B ∩ f ⁻¹' {0} := by rw [← hBF]; exact ⟨hx, h⟩
      exact h1.2
    · intro h
      have h1 : x ∈ B ∩ frontier U := by rw [hBF]; exact ⟨hx, h⟩
      exact h1.2
  
  have hderiv : ∀ t ∈ Set.Ioo (-τ) τ, ∀ u ∈ Vh, ∀ (a : ℝ) (w : E3),
      fderiv ℝ fh (Fhat (t, u)) (fderiv ℝ Fhat (t, u) (a, w)) = a + fderiv ℝ fh u w := by
    intro t ht u hu a w
    have hD : IsOpen (Set.Ioo (-τ) τ ×ˢ Vh) := isOpen_Ioo.prod hVo
    have hmem : (t, u) ∈ Set.Ioo (-τ) τ ×ˢ Vh := ⟨ht, hu⟩
    have hFd : DifferentiableAt ℝ Fhat (t, u) :=
      (hFls.contDiffAt (hD.mem_nhds hmem)).differentiableAt (by simp)
    have hfd1 : DifferentiableAt ℝ fh (Fhat (t, u)) :=
      (CF5.contDiffAt (κ.open_target.mem_nhds (CF4 t ht u hu).1)).differentiableAt (by simp)
    have hfd2 : DifferentiableAt ℝ fh u :=
      (CF5.contDiffAt (κ.open_target.mem_nhds (hVt hu))).differentiableAt (by simp)
    have hev : (fun p : ℝ × E3 => fh (Fhat p)) =ᶠ[𝓝 (t, u)] (fun p => fh p.2 + p.1) := by
      filter_upwards [hD.mem_nhds hmem] with p hp
      exact CF6 p.1 hp.1 p.2 hp.2
    have h1 : fderiv ℝ (fun p : ℝ × E3 => fh (Fhat p)) (t, u) =
        (fderiv ℝ fh (Fhat (t, u))).comp (fderiv ℝ Fhat (t, u)) :=
      fderiv_comp (t, u) hfd1 hFd
    have hs : HasFDerivAt (Prod.snd : ℝ × E3 → E3) (ContinuousLinearMap.snd ℝ ℝ E3) (t, u) :=
      hasFDerivAt_snd
    have h2a : HasFDerivAt (fun p : ℝ × E3 => fh p.2)
        ((fderiv ℝ fh u).comp (ContinuousLinearMap.snd ℝ ℝ E3)) (t, u) := by
      have hg : HasFDerivAt fh (fderiv ℝ fh u) u := hfd2.hasFDerivAt
      have h := hg.comp (t, u) hs
      exact h
    have h2b : HasFDerivAt (fun p : ℝ × E3 => p.1) (ContinuousLinearMap.fst ℝ ℝ E3) (t, u) :=
      hasFDerivAt_fst
    have h2 : HasFDerivAt (fun p : ℝ × E3 => fh p.2 + p.1)
        ((fderiv ℝ fh u).comp (ContinuousLinearMap.snd ℝ ℝ E3) +
          ContinuousLinearMap.fst ℝ ℝ E3) (t, u) :=
      h2a.add h2b
    have h3 := congrArg (fun L : ℝ × E3 →L[ℝ] ℝ => L (a, w))
      (h1.symm.trans (hev.fderiv_eq.trans h2.fderiv))
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.coe_snd', ContinuousLinearMap.coe_fst'] at h3
    rw [h3]
    ring
  
  have hy₀B : y₀ ∈ B := hB'B hy₀.1
  have hu₀V : κ y₀ ∈ Vh := ⟨y₀, hy₀.1, rfl⟩
  have hfu₀ : fh (κ y₀) = 0 := by
    show f (κ.symm (κ y₀)) = 0
    rw [κ.left_inv (CF1 hy₀.1)]
    exact (CF9 y₀ hy₀B).1 hy₀.2
  have hdfu₀ : fderiv ℝ fh (κ y₀) ≠ 0 := by
    intro h0
    have h1 := hderiv 0 hI0 (κ y₀) hu₀V 1 0
    rw [CF4' (κ y₀) hu₀V, h0] at h1
    simp at h1
  
  have hceI : c * e ∈ Set.Ioo (-τ) τ := by
    rcases he with rfl | rfl <;> constructor <;> linarith
  have hcont1 : ContinuousOn (fun u => Fhat (c * e, u)) Vh :=
    hFls.continuousOn.comp (by fun_prop : Continuous fun u : E3 => (c * e, u)).continuousOn
      (fun u hu => ⟨hceI, hu⟩)
  have hcont2 : ContinuousOn (fun u => κ.symm (Fhat (c * e, u))) Vh :=
    κ.continuousOn_symm.comp hcont1 (fun u hu => (CF4 _ hceI u hu).1)
  have hAo : IsOpen (Vh ∩ (fun u => κ.symm (Fhat (c * e, u))) ⁻¹' O₀) :=
    hcont2.isOpen_inter_preimage hVo hO₀
  have hu₀A : κ y₀ ∈ Vh ∩ (fun u => κ.symm (Fhat (c * e, u))) ⁻¹' O₀ := by
    refine ⟨hu₀V, ?_⟩
    show κ.symm (Fhat (c * e, κ y₀)) ∈ O₀
    rw [(CF4 _ hceI _ hu₀V).2, κ.left_inv (CF1 hy₀.1)]
    exact hℓO₀
  obtain ⟨W, Fh, x₀, hWo, hx₀W, hFhs, hFhx₀, hFhi, hFhW⟩ :=
    regular_zero_set_local_param _ hAo fh
      (CF5.mono (Set.inter_subset_left.trans hVt)) (κ y₀) hu₀A hfu₀ hdfu₀
  have hFhV : ∀ x ∈ W, Fh x ∈ Vh := fun x hx => (hFhW x hx).1.1
  have hFhO : ∀ x ∈ W, κ.symm (Fhat (c * e, Fh x)) ∈ O₀ := fun x hx => (hFhW x hx).1.2
  have hyt : ∀ x ∈ W, κ.symm (Fh x) ∈ B' ∩ frontier U := by
    intro x hx
    have h1 := CF3 _ (hFhV x hx)
    exact ⟨h1, (CF9 _ (hB'B h1)).2 (hFhW x hx).2.1⟩
  have hyx₀ : κ.symm (Fh x₀) = y₀ := by rw [hFhx₀, κ.left_inv (CF1 hy₀.1)]
  
  have hlamW : ContDiffOn ℝ ∞ (fun x => lam (κ.symm (Fh x))) W :=
    hlams W Fh q hWo hFhs (fun x hx => ⟨hVt (hFhV x hx), (hyt x hx).2, hB'B (hyt x hx).1⟩)
  have hμs : ContDiffOn ℝ ∞ (fun x => lam (κ.symm (Fh x)) * e) W := hlamW.mul contDiffOn_const
  have he0 : e ≠ 0 := by rcases he with rfl | rfl <;> norm_num
  have hea : |e| = 1 := by rcases he with rfl | rfl <;> norm_num
  have hlampos : ∀ x ∈ W, 0 < lam (κ.symm (Fh x)) := fun x hx => (hlam _ (hyt x hx)).1
  have hμ0 : ∀ x ∈ W, lam (κ.symm (Fh x)) * e ≠ 0 :=
    fun x hx => mul_ne_zero (hlampos x hx).ne' he0
  
  have HP1 : ∀ (s : ℝ) (x : E2), (hpLift s x) 0 = s := by
    intro s x
    simp [hpLift, cylPt, PositiveMass.e, EuclideanSpace.single_apply]
  have HP2 : ∀ (s : ℝ) (x : E2), hpProj (hpLift s x) = x := by
    intro s x
    ext i
    fin_cases i <;> simp [hpProj, hpLift, cylPt, PositiveMass.e, EuclideanSpace.single_apply]
  
  obtain ⟨hΩo, hφs, hφi, hφd, hφ0⟩ :=
    flow_graph_injective_immersion τ hτ Vh hVo Fhat hFls CF8 CF7 fh κ.target κ.open_target CF5
      hVt CF6 hderiv W hWo Fh hFhs hFhV (fun x hx => (hFhW x hx).2.1)
      (fun x hx => (hFhW x hx).2.2) hFhi (fun x => lam (κ.symm (Fh x)) * e) hμs hμ0
  set Ω := {y : E3 | hpProj y ∈ W ∧ |y 0 * (lam (κ.symm (Fh (hpProj y))) * e)| < τ} with hΩ
  have hΩI : ∀ y ∈ Ω, y 0 * (lam (κ.symm (Fh (hpProj y))) * e) ∈ Set.Ioo (-τ) τ :=
    fun y hy => abs_lt.mp hy.2
  have hφt : ∀ y ∈ Ω, Fhat (y 0 * (lam (κ.symm (Fh (hpProj y))) * e), Fh (hpProj y)) ∈
      (chartAt E3 q).target :=
    fun y hy => (CF4 _ (hΩI y hy) _ (hFhV _ hy.1)).1
  obtain ⟨Φ, hΦs, hΦe⟩ := partialDiffeomorph_of_injOn q Ω hΩo _ hφs hφi hφt hφd
  have hΦsrc : ∀ y ∈ Ω, y ∈ Φ.source := fun y hy => by rw [hΦs]; exact hy
  have hΦf : ∀ y ∈ Ω, Φ y = Fl (y 0 * (lam (κ.symm (Fh (hpProj y))) * e))
      (κ.symm (Fh (hpProj y))) := by
    intro y hy
    rw [hΦe y hy]
    exact (CF4 _ (hΩI y hy) _ (hFhV _ hy.1)).2
  have hΦfv : ∀ y ∈ Ω, f (Φ y) = y 0 * (lam (κ.symm (Fh (hpProj y))) * e) := by
    intro y hy
    rw [hΦf y hy, ((hFl _ (hyt _ hy.1).1).2 _ (hΩI y hy)).2,
      (CF9 _ (hB'B (hyt _ hy.1).1)).1 (hyt _ hy.1).2, zero_add]
  have hlx : ∀ x ∈ W, hpLift (c / lam (κ.symm (Fh x))) x ∈ Ω ∧
      Φ (hpLift (c / lam (κ.symm (Fh x))) x) = Fl (c * e) (κ.symm (Fh x)) := by
    intro x hx
    have hl := (hlampos x hx).ne'
    have hmul : c / lam (κ.symm (Fh x)) * (lam (κ.symm (Fh x)) * e) = c * e := by
      rw [show c / lam (κ.symm (Fh x)) * (lam (κ.symm (Fh x)) * e) =
        c * e * (lam (κ.symm (Fh x)) / lam (κ.symm (Fh x))) by ring, div_self hl, mul_one]
    have hmem : hpLift (c / lam (κ.symm (Fh x))) x ∈ Ω := by
      refine ⟨by rw [HP2]; exact hx, ?_⟩
      rw [HP1, HP2, hmul]
      exact abs_lt.mpr hceI
    refine ⟨hmem, ?_⟩
    rw [hΦf _ hmem, HP1, HP2, hmul]
  have hP1 : ∀ x ∈ W, Fl (c * e) (κ.symm (Fh x)) ∈ Φ.target ∧
      Fl (c * e) (κ.symm (Fh x)) ∈ O₀ ∧ Fl (c * e) (κ.symm (Fh x)) ∈ S := by
    intro x hx
    obtain ⟨hm, hΦx⟩ := hlx x hx
    have hO : Fl (c * e) (κ.symm (Fh x)) ∈ O₀ := by
      have h1 := hFhO x hx
      rw [(CF4 _ hceI _ (hFhV x hx)).2] at h1
      exact h1
    refine ⟨?_, hO, (hSO _ hO).2 ⟨_, hyt x hx, rfl⟩⟩
    rw [← hΦx]
    exact Φ.toPartialEquiv.map_source (hΦsrc _ hm)
  have hpc : Continuous hpProj := by
    unfold hpProj
    apply (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp
    refine continuous_pi (fun i => ?_)
    fin_cases i
    · simpa using (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).continuous
    · simpa using (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).continuous
  
  refine ⟨W, O₀ ∩ Φ.target, fun x => Fl (c * e) (κ.symm (Fh x)),
    fun w => hpProj (Φ.toPartialEquiv.symm w), q, Φ, hWo, hO₀.inter Φ.open_target,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · 
    have h1 := hP1 x₀ hx₀W
    rw [hyx₀] at h1
    exact ⟨h1.2.1, h1.1⟩
  · 
    have h1 : ContinuousOn (fun x => κ.symm (Fhat (c * e, Fh x))) W :=
      hcont2.comp hFhs.continuousOn (fun x hx => hFhV x hx)
    refine h1.congr (fun x hx => ?_)
    exact (CF4 _ hceI _ (hFhV x hx)).2.symm
  · 
    have hcs : ContinuousOn Φ.toPartialEquiv.symm Φ.target :=
      Φ.contMDiffOn_invFun.continuousOn
    exact (hpc.comp_continuousOn hcs).mono Set.inter_subset_right
  · 
    ext w
    constructor
    · rintro ⟨x, hx, rfl⟩
      obtain ⟨h1, h2, h3⟩ := hP1 x hx
      exact ⟨⟨h2, h1⟩, h3⟩
    · rintro ⟨⟨hwO, hwt⟩, hwS⟩
      have hys : Φ.toPartialEquiv.symm w ∈ Φ.source := Φ.toPartialEquiv.map_target hwt
      have hyΩ : Φ.toPartialEquiv.symm w ∈ Ω := by rw [← hΦs]; exact hys
      have hΦy : Φ (Φ.toPartialEquiv.symm w) = w := Φ.toPartialEquiv.right_inv hwt
      obtain ⟨y', hy', hwy'⟩ := (hSO w hwO).1 hwS
      have hfw1 : f w = (Φ.toPartialEquiv.symm w) 0 *
          (lam (κ.symm (Fh (hpProj (Φ.toPartialEquiv.symm w)))) * e) := by
        rw [← hΦfv _ hyΩ, hΦy]
      have hfw2 : f w = c * e := by
        rw [hwy', ((hFl _ hy'.1).2 _ hceI).2, (CF9 _ (hB'B hy'.1)).1 hy'.2, zero_add]
      refine ⟨hpProj (Φ.toPartialEquiv.symm w), hyΩ.1, ?_⟩
      show Fl (c * e) (κ.symm (Fh (hpProj (Φ.toPartialEquiv.symm w)))) = w
      have h3 := hΦf _ hyΩ
      rw [hΦy, ← hfw1, hfw2] at h3
      exact h3.symm
  · 
    intro x hx
    obtain ⟨hm, hΦx⟩ := hlx x hx
    have h2 : Φ.toPartialEquiv.symm (Φ (hpLift (c / lam (κ.symm (Fh x))) x)) =
        hpLift (c / lam (κ.symm (Fh x))) x :=
      Φ.toPartialEquiv.left_inv (hΦsrc _ hm)
    show hpProj (Φ.toPartialEquiv.symm (Fl (c * e) (κ.symm (Fh x)))) = x
    rw [← hΦx, h2, HP2]
  · 
    intro s hs x hx
    have hl := hlampos x hx
    have hlΛ := (hlam _ (hyt x hx)).2
    have hmem : hpLift s x ∈ Ω := by
      refine ⟨by rw [HP2]; exact hx, ?_⟩
      rw [HP1, HP2, abs_mul, abs_mul, hea, mul_one, abs_of_pos hl]
      have hs' : |s| < s₁ := abs_lt.mpr hs
      calc |s| * lam (κ.symm (Fh x)) < s₁ * lam (κ.symm (Fh x)) :=
            mul_lt_mul_of_pos_right hs' hl
        _ ≤ s₁ * Λ := mul_le_mul_of_nonneg_left hlΛ hs₁.le
        _ < τ := hs₁Λ
    have hΨx : Ψ s (Fl (c * e) (κ.symm (Fh x))) =
        Fl (s * lam (κ.symm (Fh x)) * e) (κ.symm (Fh x)) :=
      hΨ _ (hyt x hx) (hP1 x hx).2.1 s hs
    have hmem2 := hΩI _ hmem
    rw [HP1, HP2] at hmem2
    refine ⟨hΦsrc _ hmem, ?_, ?_⟩
    · show Φ (hpLift s x) = Ψ s (Fl (c * e) (κ.symm (Fh x)))
      rw [hΦf _ hmem, HP1, HP2, hΨx, mul_assoc]
    · show Ψ s (Fl (c * e) (κ.symm (Fh x))) ∈ (chartAt E3 q).source
      rw [hΨx]
      have h3 : s * lam (κ.symm (Fh x)) * e ∈ Set.Ioo (-τ) τ := by
        rw [mul_assoc]; exact hmem2
      exact ((hFl _ (hyt x hx).1).2 _ h3).1.2
  · 
    intro x hx V f' hV hpV hf' hdf' hVF hnorm
    have hl := hlampos x hx
    have hm0 : hpLift 0 x ∈ Ω := by
      refine ⟨by rw [HP2]; exact hx, ?_⟩
      rw [HP1, zero_mul, abs_zero]
      exact hτ
    have hΨ0 : Ψ 0 (Fl (c * e) (κ.symm (Fh x))) = κ.symm (Fh x) := by
      rw [hΨ _ (hyt x hx) (hP1 x hx).2.1 0 ⟨by linarith, hs₁⟩, zero_mul, zero_mul,
        (hFl _ (hyt x hx).1).1]
    have hΦ0 : Φ (hpLift 0 x) = κ.symm (Fh x) := by
      rw [hΦf _ hm0, HP1, HP2, zero_mul, (hFl _ (hyt x hx).1).1]
    beta_reduce at hpV hnorm
    rw [hΨ0] at hpV hnorm
    obtain ⟨u, hu0, hgu, hdu⟩ := defining_function_lapse_ratio g (frontier U) (κ.symm (Fh x))
      (hyt x hx).2 B V f f' hB hV (hB'B (hyt x hx).1) hpV hf hf' hdf hdf' hBF hVF Φ
      (hpLift 0 x) (hΦsrc _ hm0) hΦ0
    have hd1 : partialDeriv 0 (fun y => f (Φ y)) (hpLift 0 x) = lam (κ.symm (Fh x)) * e := by
      have hev : (fun y => f (Φ y)) =ᶠ[𝓝 (hpLift 0 x)]
          (fun y : E3 => fh (Fhat (y 0 * (lam (κ.symm (Fh (hpProj y))) * e), Fh (hpProj y)))) := by
        filter_upwards [hΩo.mem_nhds hm0] with y hy
        show f (Φ y) = f (κ.symm (Fhat (y 0 * (lam (κ.symm (Fh (hpProj y))) * e), Fh (hpProj y))))
        rw [hΦe y hy]
      unfold partialDeriv
      rw [hev.fderiv_eq]
      exact hφ0 x hx
    rw [hdu, hd1]
    have hlamφ' := hlamφ _ (hyt x hx)
    rw [hgu, Real.sqrt_mul (sq_nonneg u), Real.sqrt_sq_eq_abs] at hnorm
    rw [abs_mul, abs_mul, hea, mul_one, abs_of_pos hl, hlamφ']
    linear_combination hnorm

theorem collar_normal_slab_charts [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M)
    (hUo : IsOpen U) (hFc : IsCompact (frontier U)) (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hNc : IsCompact (closure N)) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc c d))
    (hσi : ∀ δ : ℝ, 0 < δ → δ < ε → IsClosed (frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic δ)))
    (hσ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ σ ⁻¹' Set.Iio δ)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (φ lam : M → ℝ)
    (hdata : ∀ p ∈ frontier U, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ frontier U, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
          g.jacobiDeriv f x = lam x / φ x)
    (x₀ p₀ : M) (hx₀ : x₀ ∈ U ∩ N)
    (hp₀C : p₀ ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U)
    (hthin : ∀ O : Set M, IsOpen O →
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ O →
      ∃ δ : ℝ, 0 < δ ∧ δ < ε ∧ connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' Set.Iic δ ⊆ O)
    (hFCpc : IsPreconnected (closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U))
    (Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x)
    (hNg1 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), Ng x (-ℓ) = -Ng x ℓ)
    (hNg2 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → ℓ (Ng x ℓ) = 1)
    (hNg3 : ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
      (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
      ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent ∞
        (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x)
    (nB : ℕ) (B : Fin nB → Set M) (f : Fin nB → M → ℝ)
    (hBcov : closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ ⋃ i, B i)
    (hB : ∀ i, IsOpen (B i) ∧ B i ⊆ N ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i) ∧
      (∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0) ∧
      B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0} ∧
      B i ∩ frontier U ⊆ closure (connectedComponentIn (U ∩ N) x₀))
    (hBpos : ∀ i, ∀ x ∈ B i, 0 < f i x → x ∈ connectedComponentIn (U ∩ N) x₀)
    (hBσ : ∀ i, ∀ x ∈ B i, x ∈ connectedComponentIn (U ∩ N) x₀ → σ x = |f i x|)
    (hBsgn : ∀ i k, ∀ x ∈ B i ∩ B k, ∃ e : ℝ, (e = 1 ∨ e = -1) ∧ ∀ᶠ y in 𝓝 x, f i y = e * f k y)
    (hleaf : ∀ c : ℝ, 0 < c → c < ε →
      IsCompact (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}) ∧
      IsPreconnected (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}) ∧
      (c ≤ σ x₀ → (∃ x ∈ connectedComponentIn (U ∩ N) x₀, σ x < c) →
        (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}).Nonempty)) :
    ∃ (S : Set M) (Ψ : ℝ → M → M) (s₁ : ℝ),
      0 < s₁ ∧ IsCompact S ∧ S.Nonempty ∧ IsPreconnected S ∧
      (∀ ℓ ∈ S, Ψ 0 ℓ ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U) ∧
      (∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∃ ℓ ∈ S, Ψ 0 ℓ = p) ∧
      (∀ s ∈ Set.Ioo 0 s₁, ∀ ℓ ∈ S, Ψ s ℓ ∈ connectedComponentIn (U ∩ N) x₀) ∧
      (∀ s ∈ Set.Ioo 0 s₁, ∀ s' ∈ Set.Ioo 0 s₁, ∀ ℓ ∈ S, ∀ ℓ' ∈ S,
        Ψ s ℓ = Ψ s' ℓ' → s = s' ∧ ℓ = ℓ') ∧
      (∀ m ∈ Set.Ioo 0 s₁, ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ connectedComponentIn (U ∩ N) x₀,
        σ x ≤ δ → ∃ s ∈ Set.Ioo 0 m, ∃ ℓ ∈ S, Ψ s ℓ = x) ∧
      (∀ s ∈ Set.Ioo (-s₁) s₁, ∀ ℓ ∈ S, s ≠ 0 → Ψ s ℓ ∉ frontier U) ∧
      (∀ ℓ ∈ S, collarSlabChartAt g U φ S Ψ s₁ ℓ) :=
by
  classical
  haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  have hCU : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hCo : IsOpen C := (hUo.inter hNo).connectedComponentIn
  have hFCc : IsCompact (closure C ∩ frontier U) := hFc.inter_left isClosed_closure
  have hBo : ∀ i, IsOpen (B i) := fun i => (hB i).1
  have hBN : ∀ i, B i ⊆ N := fun i => (hB i).2.1
  have hfs : ∀ i, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i) := fun i => (hB i).2.2.1
  have hdf : ∀ i, ∀ x ∈ B i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f i) x ≠ 0 := fun i => (hB i).2.2.2.1
  have hBF : ∀ i, B i ∩ frontier U = B i ∩ (f i) ⁻¹' {0} := fun i => (hB i).2.2.2.2.1
  have hBC : ∀ i, B i ∩ frontier U ⊆ closure C := fun i => (hB i).2.2.2.2.2
  have hFf : ∀ i, ∀ x ∈ B i, (x ∈ frontier U ↔ f i x = 0) := by
    intro i x hx
    constructor
    · intro h
      have h' : x ∈ B i ∩ frontier U := ⟨hx, h⟩
      rw [hBF i] at h'
      exact h'.2
    · intro h
      have h' : x ∈ B i ∩ (f i) ⁻¹' {0} := ⟨hx, h⟩
      rw [← hBF i] at h'
      exact h'.2
  have hFC : ∀ i, ∀ x ∈ B i, x ∈ frontier U → x ∈ closure C ∩ frontier U :=
    fun i x hx hF => ⟨hBC i ⟨hx, hF⟩, hF⟩
  have habs : ∀ e : ℝ, (e = 1 ∨ e = -1) → ∀ a : ℝ, |a * e| = |a| := by
    intro e he a
    rcases he with rfl | rfl <;> simp
  have hne : ∀ e : ℝ, (e = 1 ∨ e = -1) → e ≠ 0 := by
    intro e he
    rcases he with rfl | rfl <;> norm_num
  
  obtain ⟨R, ι, q, B', D, Fl, T, hT, hFCD, hbox⟩ :=
    collar_flow_boxes Ng hNg2 hNg3 nB B f hBo hfs hdf (closure C ∩ frontier U) hFCc hBcov
      (fun i p hp hpB => (hFf i p hpB).1 hp.2)
  have hB'o : ∀ r, IsOpen (B' r) := fun r => (hbox r).1
  have hDo : ∀ r, IsOpen (D r) := fun r => (hbox r).2.1
  have hDB' : ∀ r, D r ⊆ B' r := fun r => (hbox r).2.2.1
  have hB'B : ∀ r, B' r ⊆ B (ι r) := fun r => (hbox r).2.2.2.1
  have hFl := fun r => (hbox r).2.2.2.2.1
  have hFls := fun r => (hbox r).2.2.2.2.2.1
  have hker := fun r => (hbox r).2.2.2.2.2.2.1
  have hinj := fun r => (hbox r).2.2.2.2.2.2.2.1
  have hback := fun r => (hbox r).2.2.2.2.2.2.2.2
  have hFlB : ∀ r, ∀ y ∈ B' r, ∀ t ∈ Set.Ioo (-T) T, Fl r t y ∈ B (ι r) :=
    fun r y hy t ht => ((hFl r y hy).2.2 t ht).1.1
  have hFlf : ∀ r, ∀ y ∈ B' r, ∀ t ∈ Set.Ioo (-T) T,
      f (ι r) (Fl r t y) = f (ι r) y + t :=
    fun r y hy t ht => ((hFl r y hy).2.2 t ht).2
  have hF0 : ∀ r, ∀ y ∈ B' r, y ∈ frontier U → f (ι r) y = 0 :=
    fun r y hy hF => (hFf (ι r) y (hB'B r hy)).1 hF
  have hmemT : ∀ e : ℝ, (e = 1 ∨ e = -1) → ∀ t ∈ Set.Ioo (-T) T, t * e ∈ Set.Ioo (-T) T := by
    intro e he t ht
    rcases he with rfl | rfl
    · simpa using ht
    · simp only [mul_neg, mul_one]
      exact ⟨by linarith [ht.2], by linarith [ht.1]⟩
  
  have hbp : ∀ r, ∀ x ∈ D r, Fl r (-f (ι r) x) x ∈ B' r ∧
      Fl r (-f (ι r) x) x ∈ frontier U ∧ Fl r (f (ι r) x) (Fl r (-f (ι r) x) x) = x ∧
      |f (ι r) x| < T ∧ x ∈ B (ι r) := by
    intro r x hx
    obtain ⟨hfT, hyB', hyl⟩ := hback r x hx
    have hxB' := hDB' r hx
    have hmT : -f (ι r) x ∈ Set.Ioo (-T) T := by
      rw [abs_lt] at hfT
      exact ⟨by linarith [hfT.2], by linarith [hfT.1]⟩
    have hy0 : f (ι r) (Fl r (-f (ι r) x) x) = 0 := by
      rw [hFlf r x hxB' _ hmT]; ring
    exact ⟨hyB', (hFf (ι r) _ (hB'B r hyB')).2 hy0, hyl, hfT, hB'B r hxB'⟩
  
  obtain ⟨Λf, Λ, μ, hμ, hΛb, hΛφ, hΛs⟩ :=
    collar_lapse_function g U φ lam hdata nB B f hBo hfs hdf hBF hBsgn
      (closure C ∩ frontier U) hFCc Set.inter_subset_right hBcov
  have hΛpos : ∀ y ∈ closure C ∩ frontier U, 0 < Λf y :=
    fun y hy => lt_of_lt_of_le hμ (hΛb y hy).1
  
  obtain ⟨δ₀, hδ₀, hδ₀ε, hthinD⟩ := hthin (⋃ r, D r) (isOpen_iUnion hDo) hFCD
  have hσx₀ : 0 < σ x₀ := (hσb x₀ hx₀).1
  obtain ⟨m₀, hm₀def⟩ : ∃ m₀ : ℝ, m₀ = min (min δ₀ (σ x₀)) (T / 2) := ⟨_, rfl⟩
  have hm₀ : 0 < m₀ := by
    rw [hm₀def]; exact lt_min (lt_min hδ₀ hσx₀) (by linarith)
  have hm₁ : m₀ ≤ δ₀ := by rw [hm₀def]; exact le_trans (min_le_left _ _) (min_le_left _ _)
  have hm₂ : m₀ ≤ σ x₀ := by rw [hm₀def]; exact le_trans (min_le_left _ _) (min_le_right _ _)
  have hm₃ : m₀ ≤ T / 2 := by rw [hm₀def]; exact min_le_right _ _
  obtain ⟨O, hO, hFO, hUO⟩ := hσ0 m₀ hm₀
  obtain ⟨x₁, hx₁O, hx₁C⟩ := mem_closure_iff.1 hp₀C.1 O hO (hFO hp₀C.2)
  have hx₁σ : σ x₁ < m₀ := (hUO ⟨(hCU hx₁C).1, hx₁O⟩).2
  have hσx₁ : 0 < σ x₁ := (hσb x₁ (hCU hx₁C)).1
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = (σ x₁ + m₀) / 2 := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hcdef]; linarith
  have hcm : c < m₀ := by rw [hcdef]; linarith
  have hx₁c : σ x₁ < c := by rw [hcdef]; linarith
  have hcδ : c < δ₀ := by linarith
  have hcε : c < ε := by linarith
  have hcT : c < T := by linarith
  obtain ⟨hScpt, hSpc, hSne'⟩ := hleaf c hc0 hcε
  have hSne : (C ∩ σ ⁻¹' {c}).Nonempty := hSne' (by linarith) ⟨x₁, hx₁C, hx₁c⟩
  
  have hseg : ∀ r, ∀ y ∈ B' r, y ∈ frontier U → ∀ e : ℝ, (e = 1 ∨ e = -1) →
      ∀ a ∈ Set.Ioo 0 T, Fl r (a * e) y ∈ C → ∀ t ∈ Set.Ioo 0 T, Fl r (t * e) y ∈ C := by
    intro r y hy hyF e he a ha haC t ht
    have hsub : Set.Ioo 0 T ⊆ Set.Ioo (-T) T := fun s hs => ⟨by linarith [hs.1], hs.2⟩
    have hcont : ContinuousOn (fun s => Fl r (s * e) y) (Set.Ioo 0 T) := by
      have h1 := (hFl r y hy).2.1.continuousOn
      refine h1.comp (continuous_mul_right e).continuousOn ?_
      intro s hs
      exact hmemT e he s (hsub hs)
    have hA := isPreconnected_Ioo.image _ hcont
    have hAsub : (fun s => Fl r (s * e) y) '' Set.Ioo 0 T ⊆ U ∪ (closure U)ᶜ := by
      rintro _ ⟨s, hs, rfl⟩
      have hsT := hmemT e he s (hsub hs)
      have hzB := hFlB r y hy _ hsT
      have hfz : f (ι r) (Fl r (s * e) y) ≠ 0 := by
        rw [hFlf r y hy _ hsT, hF0 r y hy hyF, zero_add]
        exact mul_ne_zero (ne_of_gt hs.1) (hne e he)
      by_cases hzU : Fl r (s * e) y ∈ U
      · exact Or.inl hzU
      · right
        intro hzc
        apply hfz
        apply (hFf (ι r) _ hzB).1
        rw [hUo.frontier_eq]
        exact ⟨hzc, hzU⟩
    have hAU := hA.subset_left_of_subset_union hUo isClosed_closure.isOpen_compl
      (Disjoint.mono_left subset_closure disjoint_compl_right) hAsub
      ⟨_, ⟨a, ha, rfl⟩, (hCU haC).1⟩
    have hAX : (fun s => Fl r (s * e) y) '' Set.Ioo 0 T ⊆ U ∩ N := by
      intro z hz
      refine ⟨hAU hz, ?_⟩
      obtain ⟨s, hs, rfl⟩ := hz
      exact hBN _ (hFlB r y hy _ (hmemT e he s (hsub hs)))
    have hAC := hA.subset_connectedComponentIn ⟨a, ha, rfl⟩ hAX
    rw [← connectedComponentIn_eq haC] at hAC
    exact hAC ⟨t, ht, rfl⟩
  
  have hcurve : ∀ r r' : Fin R, ∀ y ∈ B' r, y ∈ frontier U → ∀ y' ∈ B' r', y' ∈ frontier U →
      ∀ e e' : ℝ, (e = 1 ∨ e = -1) → (e' = 1 ∨ e' = -1) →
      ∀ t₁ ∈ Set.Ioo (-T) T, t₁ ≠ 0 → Fl r (t₁ * e) y = Fl r' (t₁ * e') y' →
      ∀ t ∈ Set.Ioo (-T) T, Fl r (t * e) y = Fl r' (t * e') y' := by
    intro r r' y hy hyF y' hy' hy'F e e' he he' t₁ ht₁ ht₁0 hmeet t ht
    have hγ₁ : IsMIntegralCurveOn ((fun s => Fl r s y) ∘ fun s => s * e)
        (fun x => e • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f (ι r)) x)) (Set.Ioo (-T) T) :=
      ((hFl r y hy).2.1.comp_mul e).mono (fun s hs => hmemT e he s hs)
    have hγ₂ : IsMIntegralCurveOn ((fun s => Fl r' s y') ∘ fun s => s * e')
        (fun x => e' • Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (f (ι r')) x)) (Set.Ioo (-T) T) :=
      ((hFl r' y' hy').2.1.comp_mul e').mono (fun s hs => hmemT e' he' s hs)
    have key := collar_curves_agree Ng hNg1 hNg3 (B (ι r)) (B (ι r')) (f (ι r)) (f (ι r'))
      (hBo _) (hBo _) (hfs _) (hfs _) (hdf _) (hdf _) (hBsgn (ι r) (ι r')) T
      ((fun s => Fl r s y) ∘ fun s => s * e) ((fun s => Fl r' s y') ∘ fun s => s * e')
      e e' he he' hγ₁ hγ₂
      (fun s hs => hFlB r y hy _ (hmemT e he s hs))
      (fun s hs => hFlB r' y' hy' _ (hmemT e' he' s hs))
      (fun s hs => by
        show f (ι r) (Fl r (s * e) y) = e * s
        rw [hFlf r y hy _ (hmemT e he s hs), hF0 r y hy hyF]; ring)
      (fun s hs => by
        show |f (ι r') (Fl r' (s * e') y')| = |s|
        rw [hFlf r' y' hy' _ (hmemT e' he' s hs), hF0 r' y' hy' hy'F, zero_add]
        exact habs e' he' s)
      t₁ ht₁ ht₁0 hmeet
    exact key ht
  
  have hrepex : ∀ ℓ ∈ C ∩ σ ⁻¹' {c}, ∃ (r : Fin R) (e : ℝ) (y : M), y ∈ B' r ∧
      y ∈ frontier U ∧ (e = 1 ∨ e = -1) ∧ Fl r (c * e) y = ℓ ∧ ℓ ∈ D r ∧
      0 < e * f (ι r) ℓ := by
    rintro ℓ ⟨hℓC, hℓc⟩
    have hℓc' : σ ℓ = c := hℓc
    obtain ⟨r, hr⟩ := Set.mem_iUnion.1
      (hthinD ⟨hℓC, show σ ℓ ≤ δ₀ by rw [hℓc']; exact hcδ.le⟩)
    obtain ⟨hyB', hyF, hyl, -, hℓB⟩ := hbp r ℓ hr
    have habsℓ : |f (ι r) ℓ| = c := by rw [← hBσ (ι r) ℓ hℓB hℓC]; exact hℓc'
    rcases (abs_eq hc0.le).1 habsℓ with h | h
    · refine ⟨r, 1, _, hyB', hyF, Or.inl rfl, ?_, hr, ?_⟩
      · rw [mul_one, ← h]; exact hyl
      · rw [h, one_mul]; exact hc0
    · refine ⟨r, -1, _, hyB', hyF, Or.inr rfl, ?_, hr, ?_⟩
      · rw [show c * -1 = f (ι r) ℓ by rw [h]; ring]; exact hyl
      · rw [h]; linarith
  obtain ⟨r₀, -⟩ := Set.mem_iUnion.1 (hFCD hp₀C)
  haveI : Nonempty (Fin R) := ⟨r₀⟩
  choose! rr ee yy hrep using hrepex
  have hyyFC : ∀ ℓ ∈ C ∩ σ ⁻¹' {c}, yy ℓ ∈ closure C ∩ frontier U := fun ℓ hℓ =>
    hFC _ _ (hB'B _ (hrep ℓ hℓ).1) (hrep ℓ hℓ).2.1
  
  obtain ⟨s₁, hs₁def⟩ : ∃ s₁ : ℝ, s₁ = T / (2 * (|Λ| + 1)) := ⟨_, rfl⟩
  have hΛ1 : 0 < |Λ| + 1 := by positivity
  have hs₁ : 0 < s₁ := by rw [hs₁def]; positivity
  have hs₁eq : s₁ * (|Λ| + 1) = T / 2 := by
    rw [hs₁def]; field_simp; try ring
  have hsmall : ∀ y ∈ closure C ∩ frontier U, ∀ s : ℝ, |s| < s₁ → |s * Λf y| < T / 2 := by
    intro y hy s hs
    have h1 := hΛb y hy
    have h2 := hΛpos y hy
    rw [abs_mul, abs_of_pos h2]
    have h3 : Λf y ≤ |Λ| + 1 := by linarith [le_abs_self Λ, h1.2]
    calc |s| * Λf y ≤ |s| * (|Λ| + 1) := mul_le_mul_of_nonneg_left h3 (abs_nonneg s)
      _ < s₁ * (|Λ| + 1) := mul_lt_mul_of_pos_right hs hΛ1
      _ = T / 2 := hs₁eq
  have hs₁Λ : s₁ * Λ < T := by
