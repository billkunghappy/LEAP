  obtain ⟨ε, k, f, hε, hk, hballε, hfs, hf0, hdf, hfM, hfK⟩ :=
    contact_sheets g S hS m K hKdef p hpK _ (hWo.mem_nhds hWy)
  haveI : Nonempty (Fin k) := ⟨⟨0, hk⟩⟩
  have hballT : Metric.ball y₀ ε ⊆ (chartAt E3 p).target := fun z hz => (hballε hz).2
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (Metric.ball y₀ ε) :=
    fun i j => (g.smooth p i j).mono hballT
