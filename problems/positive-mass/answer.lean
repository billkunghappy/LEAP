      _ = volume.restrict (Metric.ball y r) {x | 1 ≤ ENNReal.ofReal |u (x + h) - u x|} :=
          (Measure.restrict_apply' measurableSet_ball).symm
      _ = 1 * volume.restrict (Metric.ball y r) {x | 1 ≤ ENNReal.ofReal |u (x + h) - u x|} :=
          (one_mul _).symm
