  have inv_quad_amgm : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (hA : A.PosDef) (ξ ζ : Fin 2 → ℝ) (Ψ Θ : ℝ) (hΨ : 0 ≤ Ψ) (hΘ : 0 ≤ Θ) (hξ : ∑ i : Fin 2, ∑ j : Fin 2, A i j * ξ i * ξ j ≤ 4 * Ψ * Θ), ∑ i : Fin 2, ∑ j : Fin 2, A i j * ξ i * ζ j - Ψ * ∑ i : Fin 2, ∑ j : Fin 2, A i j * ζ i * ζ j ≤ Θ := by
    intro A hA ξ ζ Ψ Θ hΨ hΘ hξ
    have hsym : A 1 0 = A 0 1 := by
      have := hA.isHermitian.apply 0 1
      simpa using this
    have hp : 0 < A 0 0 := hA.diag_pos
    have hD : 0 < A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
      have := hA.det_pos
      rwa [Matrix.det_fin_two] at this
    simp only [Fin.sum_univ_two] at hξ ⊢
    rw [hsym] at hξ hD ⊢
    set p := A 0 0
    set q := A 0 1
    set s := A 1 1
    set X := p * ξ 0 * ξ 0 + q * ξ 0 * ξ 1 + (q * ξ 1 * ξ 0 + s * ξ 1 * ξ 1) with hX
    set Z := p * ζ 0 * ζ 0 + q * ζ 0 * ζ 1 + (q * ζ 1 * ζ 0 + s * ζ 1 * ζ 1) with hZ
    set B := p * ξ 0 * ζ 0 + q * ξ 0 * ζ 1 + (q * ξ 1 * ζ 0 + s * ξ 1 * ζ 1) with hB
    have hZ0 : 0 ≤ Z := by
      have e : p * Z = (p * ζ 0 + q * ζ 1) ^ 2 + (p * s - q * q) * ζ 1 ^ 2 := by
        rw [hZ]; ring
      have : 0 ≤ p * Z := by
        rw [e]; positivity
      by_contra hc
      push_neg at hc
      have := mul_neg_of_pos_of_neg hp hc
      linarith
    have hLag : X * Z - B ^ 2 = (p * s - q * q) * (ξ 0 * ζ 1 - ξ 1 * ζ 0) ^ 2 := by
      rw [hX, hZ, hB]; ring
    have hB2 : B ^ 2 ≤ X * Z := by
      have : 0 ≤ (p * s - q * q) * (ξ 0 * ζ 1 - ξ 1 * ζ 0) ^ 2 := by positivity
      linarith
    have hXZ : X * Z ≤ 4 * Ψ * Θ * Z := mul_le_mul_of_nonneg_right hξ hZ0
    have hW : 0 ≤ Ψ * Z := mul_nonneg hΨ hZ0
    have hsq : B ^ 2 ≤ (Ψ * Z + Θ) ^ 2 := by nlinarith [sq_nonneg (Ψ * Z - Θ)]
    have := (abs_le_of_sq_le_sq' hsq (by positivity)).2
    linarith
  
  have ball_integrableOn_of_vanish : ∀ (ρ r M : ℝ) (θ c : E2 → ℝ) (hr : r < ρ) (hθ : Measurable θ) (hθM : ∀ x, |θ x| ≤ M) (hc : ContinuousOn c (Metric.ball 0 ρ)) (hvan : ∀ x : E2, r ≤ ‖x‖ → θ x * c x = 0), MeasureTheory.IntegrableOn (fun x => θ x * c x) (Metric.ball (0 : E2) ρ) := by
    intro ρ r M θ c hr hθ hθM hc hvan
    have hK : Metric.closedBall (0 : E2) r ⊆ Metric.ball 0 ρ := Metric.closedBall_subset_ball hr
    have hcK : IntegrableOn c (Metric.closedBall (0 : E2) r) :=
      (hc.mono hK).integrableOn_compact (isCompact_closedBall 0 r)
    have hθc : IntegrableOn (fun x => θ x * c x) (Metric.closedBall (0 : E2) r) :=
      Integrable.bdd_mul hcK hθ.aestronglyMeasurable
        (ae_of_all _ (fun x => by rw [Real.norm_eq_abs]; exact hθM x))
    refine hθc.of_forall_diff_eq_zero Metric.isOpen_ball.measurableSet ?_
    intro x hx
    apply hvan
    have : x ∉ Metric.closedBall (0 : E2) r := hx.2
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at this
    exact this.le
  intro r M Ψ Θ hr0 hrρ hΨ hΨ0 hΨr hΘm hΘ hΘr hgrad
  have hDo : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
  have h1top : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  obtain ⟨hdet, hu, hA⟩ := metric2_inv_regular ρ h hh hpd
  have hm : ∀ i j : Fin 2, ContDiffOn ℝ 1
      (fun y => Real.sqrt (h y).det * (h y)⁻¹ i j) (Metric.ball 0 ρ) :=
    fun i j => (hu.mul (hA i j)).of_le h1top
  have hdφ : ContDiffOn ℝ 1 (fun y => fderiv ℝ φ y) (Metric.ball 0 ρ) :=
    hφ.fderiv_of_isOpen hDo (by norm_num)
  have hg : ∀ j : Fin 2, ContDiffOn ℝ 1 (pd2 j φ) (Metric.ball 0 ρ) := by
    intro j
    exact hdφ.clm_apply contDiffOn_const
  have hcc := sqrtdet_inv_contracted ρ h hh hpd
  have hdiv := lap2_div_of_contracted ρ h φ hm hφ hcc
  obtain ⟨V, hVdef⟩ : ∃ V : Fin 2 → E2 → ℝ,
      V = fun i y => Real.sqrt (h y).det * ∑ j : Fin 2, (h y)⁻¹ i j * pd2 j φ y := ⟨_, rfl⟩
  have hVx : ∀ i x, V i x = Real.sqrt (h x).det * ∑ j : Fin 2, (h x)⁻¹ i j * pd2 j φ x := by
    intro i x; rw [hVdef]
  have hdiv' : ∀ x ∈ Metric.ball (0 : E2) ρ,
      Real.sqrt (h x).det * lap2 h φ x = ∑ i : Fin 2, pd2 i (V i) x := by
    intro x hx; rw [hdiv x hx, hVdef]
  have hVc : ∀ i, ContDiffOn ℝ 1 (V i) (Metric.ball 0 ρ) := by
    intro i
    rw [hVdef]
    exact (hu.of_le h1top).mul
      (ContDiffOn.sum fun j _ => ((hA i j).of_le h1top).mul (hg j))
  have hφ1 : ContDiffOn ℝ 1 φ (Metric.ball 0 ρ) := hφ.of_le (by norm_num)
  have hG : ∀ i, ContDiffOn ℝ 1 (fun y => V i y / φ y) (Metric.ball 0 ρ) := fun i =>
    (hVc i).div hφ1 (fun y hy => (hJ y hy).1.ne')
  choose F hFc hFr hFd hFo using fun i : Fin 2 =>
    cutoff_mul_contDiff ρ r Ψ (fun y => V i y / φ y) hrρ hΨ hΨr (hG i)
  
  have hquot : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2,
      pd2 i (fun y => V i y / φ y) x
        = V i x * (-(φ x ^ 2)⁻¹ * pd2 i φ x) + (φ x)⁻¹ * pd2 i (V i) x := by
    intro x hx i
    have hnx : Metric.ball (0 : E2) ρ ∈ 𝓝 x := hDo.mem_nhds hx
    have hVd : HasFDerivAt (V i) (fderiv ℝ (V i) x) x :=
      (((hVc i).differentiableOn (by simp)).differentiableAt hnx).hasFDerivAt
    have hφd : HasFDerivAt φ (fderiv ℝ φ x) x :=
      ((hφ1.differentiableOn (by simp)).differentiableAt hnx).hasFDerivAt
    have hinv : HasFDerivAt (fun y => (φ y)⁻¹) ((-(φ x ^ 2)⁻¹) • fderiv ℝ φ x) x :=
      (hasDerivAt_inv (hJ x hx).1.ne').comp_hasFDerivAt x hφd
    have hmul : HasFDerivAt (fun y => V i y * (φ y)⁻¹)
        (V i x • ((-(φ x ^ 2)⁻¹) • fderiv ℝ φ x) + (φ x)⁻¹ • fderiv ℝ (V i) x) x :=
      hVd.mul hinv
    have hfun : (fun y => V i y / φ y) = fun y => V i y * (φ y)⁻¹ := by
      funext y; rw [div_eq_mul_inv]
    unfold pd2
    rw [hfun, hmul.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have hpt : ∀ x ∈ Metric.ball (0 : E2) ρ,
      (a x + b x) * Ψ x * Real.sqrt (h x).det + ∑ i : Fin 2, pd2 i (F i) x
        ≤ Θ x * Real.sqrt (h x).det := by
    intro x hx
    have hφx := (hJ x hx).1
    have hφne := hφx.ne'
    have hux : 0 ≤ Real.sqrt (h x).det := Real.sqrt_nonneg _
    have hs6 := inv_quad_amgm (h x)⁻¹ (hpd x hx).inv (fun i => pd2 i Ψ x)
      (fun j => pd2 j φ x / φ x) (Ψ x) (Θ x) (hΨ0 x) (hΘ x).1 (hgrad x hx)
    have hP : ∑ i : Fin 2, pd2 i (F i) x =
        Real.sqrt (h x).det *
          (∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i Ψ x * (pd2 j φ x / φ x))
        + Ψ x * Real.sqrt (h x).det * lap2 h φ x / φ x
        - Ψ x * Real.sqrt (h x).det *
          (∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * (pd2 i φ x / φ x) * (pd2 j φ x / φ x)) := by
      have e1 : Ψ x * Real.sqrt (h x).det * lap2 h φ x / φ x
          = Ψ x * (∑ i : Fin 2, pd2 i (V i) x) / φ x := by
        rw [← hdiv' x hx]; ring
      rw [e1, Fin.sum_univ_two, hFd 0 x hx 0, hFd 1 x hx 1, hquot x hx 0, hquot x hx 1]
      simp only [hVx, Fin.sum_univ_two]
      field_simp
      ring
    have hJx := (hJ x hx).2
    have e2 : (a x + b x) + lap2 h φ x / φ x ≤ 0 := by
      have e : (a x + b x) + lap2 h φ x / φ x = (lap2 h φ x + (a x + b x) * φ x) / φ x := by
        field_simp; ring
      rw [e]
      exact div_nonpos_of_nonpos_of_nonneg hJx hφx.le
    have e3 : Ψ x * Real.sqrt (h x).det * ((a x + b x) + lap2 h φ x / φ x) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (mul_nonneg (hΨ0 x) hux) e2
    beta_reduce at hs6
    have e4 := mul_le_mul_of_nonneg_left hs6 hux
    have e5 : Ψ x * Real.sqrt (h x).det * lap2 h φ x / φ x
        = Ψ x * Real.sqrt (h x).det * (lap2 h φ x / φ x) := by ring
    rw [hP, e5]
    nlinarith [e3, e4]
  
  have hf1c : ContinuousOn (fun x => (a x + b x) * Ψ x * Real.sqrt (h x).det)
      (Metric.ball 0 ρ) :=
    ((ha.add hb).mul hΨ.continuous.continuousOn).mul hu.continuousOn
  have hf1 : IntegrableOn (fun x => (a x + b x) * Ψ x * Real.sqrt (h x).det)
      (Metric.ball (0 : E2) ρ) := by
    have := ball_integrableOn_of_vanish ρ r 1 (fun _ => (1 : ℝ))
      (fun x => (a x + b x) * Ψ x * Real.sqrt (h x).det) hrρ measurable_const
      (fun _ => by norm_num) hf1c (fun x hx => by simp [hΨr x hx])
    simpa using this
  have hg1 : IntegrableOn (fun x => Θ x * Real.sqrt (h x).det) (Metric.ball (0 : E2) ρ) :=
    ball_integrableOn_of_vanish ρ r M Θ (fun x => Real.sqrt (h x).det) hrρ hΘm
      (fun x => by rw [abs_of_nonneg (hΘ x).1]; exact (hΘ x).2) hu.continuousOn
      (fun x hx => by simp [hΘr x hx])
  have hPi : ∀ i : Fin 2, Integrable (fun x => pd2 i (F i) x) := fun i =>
    (pd2_compact_integral r (F i) i (hFc i) (hFr i)).1
  have hPint : Integrable (fun x => ∑ i : Fin 2, pd2 i (F i) x) :=
    integrable_finset_sum Finset.univ (fun i _ => hPi i)
  have hP0 : ∫ x in Metric.ball (0 : E2) ρ, ∑ i : Fin 2, pd2 i (F i) x = 0 := by
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero]
    · rw [integral_finset_sum Finset.univ (fun i _ => hPi i)]
      exact Finset.sum_eq_zero (fun i _ => (pd2_compact_integral r (F i) i (hFc i) (hFr i)).2)
    · intro x hx
      have hρx : ρ ≤ ‖x‖ := by
        simpa [Metric.mem_ball, dist_zero_right, not_lt] using hx
      exact Finset.sum_eq_zero (fun i _ => hFo i x hρx i)
  have hmono : ∫ x in Metric.ball (0 : E2) ρ,
      ((a x + b x) * Ψ x * Real.sqrt (h x).det + ∑ i : Fin 2, pd2 i (F i) x)
        ≤ ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det :=
    setIntegral_mono_on (Integrable.add hf1 hPint.integrableOn) hg1 measurableSet_ball hpt
  rw [integral_add hf1 hPint.integrableOn, hP0, add_zero] at hmono
  exact hmono

theorem normal_ray_jacobi (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hρ : 0 < ρ) (hs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hsymm : ∀ (x : E2) (i j : Fin 2), h x i j = h x j i) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (θ : E2) (hθ : ‖θ‖ = 1) (q : ℝ → ℝ) (hq : ∀ τ : ℝ, q τ = h (τ • θ) 0 0 * θ 1 ^ 2 - 2 * h (τ • θ) 0 1 * θ 0 * θ 1 + h (τ • θ) 1 1 * θ 0 ^ 2) : q 0 = 1 ∧ (∀ τ : ℝ, |τ| < ρ → q τ = (h (τ • θ)).det) ∧ ContDiffOn ℝ ∞ q (Set.Ioo (-ρ) ρ) ∧ ∀ t : ℝ, 0 < t → t < ρ → 4 * t * q t ^ 2 * gaussCurv2 h (t • θ) = t * deriv q t ^ 2 - 2 * t * q t * deriv (deriv q) t - 4 * q t * deriv q t :=
by
  have hnf₂ : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i :=
    fun x hx => (hnf x hx).2
  have hdetB : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).det ≠ 0 :=
    fun x hx => ((hnf x hx).1.det_pos).ne'
  have h0 : h 0 = 1 := normal_form_center_eq_one ρ hρ h hs hnf₂
  have F1 : θ 0 ^ 2 + θ 1 ^ 2 = 1 := by
    have h1 := hθ
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs, sq_abs,
      sq_abs] at h1
    have h2 : (0 : ℝ) ≤ θ 0 ^ 2 + θ 1 ^ 2 := by positivity
    have h3 := Real.sq_sqrt h2
    rw [h1] at h3
    linarith
  have F2 : ∀ τ : ℝ, ‖τ • θ‖ = |τ| := by
    intro τ
    rw [norm_smul, hθ, mul_one, Real.norm_eq_abs]
  have hmem : ∀ τ : ℝ, |τ| < ρ → τ • θ ∈ Metric.ball (0 : E2) ρ := by
    intro τ hτ
    rw [Metric.mem_ball, dist_zero_right, F2]
    exact hτ
  
  have hq0 : q 0 = 1 := by
    have a1 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 0 = 1 := Matrix.one_apply_eq 0
    have a2 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 := Matrix.one_apply_ne (by decide)
    have a3 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 1 1 = 1 := Matrix.one_apply_eq 1
    rw [hq, zero_smul, h0, a1, a2, a3]
    linarith
  
  have hdet : ∀ τ : ℝ, |τ| < ρ → q τ = (h (τ • θ)).det := by
    intro τ hτ
    by_cases hτ0 : τ = 0
    · subst hτ0
      rw [hq0, zero_smul, h0, Matrix.det_one]
    · have hx := hmem τ hτ
      have r0 := hnf₂ _ hx 0
      have r1 := hnf₂ _ hx 1
      simp only [Fin.sum_univ_two, PiLp.smul_apply, smul_eq_mul] at r0 r1
      have hsy : h (τ • θ) 1 0 = h (τ • θ) 0 1 := hsymm _ 1 0
      rw [hsy] at r1
      have E1 : h (τ • θ) 0 0 * θ 0 + h (τ • θ) 0 1 * θ 1 - θ 0 = 0 := by
        have e : τ * (h (τ • θ) 0 0 * θ 0 + h (τ • θ) 0 1 * θ 1 - θ 0) = 0 := by
          linear_combination r0
        exact (mul_eq_zero.mp e).resolve_left hτ0
      have E2 : h (τ • θ) 0 1 * θ 0 + h (τ • θ) 1 1 * θ 1 - θ 1 = 0 := by
        have e : τ * (h (τ • θ) 0 1 * θ 0 + h (τ • θ) 1 1 * θ 1 - θ 1) = 0 := by
          linear_combination r1
        exact (mul_eq_zero.mp e).resolve_left hτ0
      rw [hq τ, Matrix.det_fin_two, hsy]
      linear_combination
        -(h (τ • θ) 1 1 * θ 0 - h (τ • θ) 0 1 * θ 1) * E1
        + (h (τ • θ) 0 1 * θ 0 - h (τ • θ) 0 0 * θ 1) * E2
        + (h (τ • θ) 0 0 * h (τ • θ) 1 1 - h (τ • θ) 0 1 ^ 2) * F1
  
  have hcd : ContDiffOn ℝ ∞ q (Set.Ioo (-ρ) ρ) := by
    have hσ : ContDiffOn ℝ ∞ (fun τ : ℝ => τ • θ) (Set.Ioo (-ρ) ρ) :=
      (contDiff_id.smul contDiff_const).contDiffOn
    have hmaps : Set.MapsTo (fun τ : ℝ => τ • θ) (Set.Ioo (-ρ) ρ) (Metric.ball (0 : E2) ρ) := by
      intro τ hτ
      exact hmem τ (abs_lt.mpr ⟨hτ.1, hτ.2⟩)
    have hc : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun τ : ℝ => h (τ • θ) i j) (Set.Ioo (-ρ) ρ) :=
      fun i j => (hs i j).comp hσ hmaps
    have e : q = fun τ => h (τ • θ) 0 0 * θ 1 ^ 2 - 2 * h (τ • θ) 0 1 * θ 0 * θ 1 +
        h (τ • θ) 1 1 * θ 0 ^ 2 := funext hq
    rw [e]
    exact (((hc 0 0).mul contDiffOn_const).sub
      (((contDiffOn_const.mul (hc 0 1)).mul contDiffOn_const).mul contDiffOn_const)).add
      ((hc 1 1).mul contDiffOn_const)
  
  obtain ⟨L, A, R1, R2, R3, R4, R5, R6, R7, R8, R9⟩ := normal_form_rotate ρ h hs hsymm hnf₂ θ hθ
  refine ⟨hq0, hdet, hcd, ?_⟩
  intro t ht htρ
  have htU : t • e2 0 ∈ Metric.ball (0 : E2) ρ := by
    rw [Metric.mem_ball, dist_zero_right, norm_smul, EuclideanSpace.norm_single, norm_one,
      mul_one, Real.norm_eq_abs, abs_of_pos ht]
    exact htρ
  have hdet' : ∀ y ∈ Metric.ball (0 : E2) ρ,
      ((fun y => A.transpose * h (L y) * A) y).det ≠ 0 := by
    intro y hy
    show (A.transpose * h (L y) * A).det ≠ 0
    rw [R8 y]
    apply hdetB
    rw [Metric.mem_ball, dist_zero_right, R3 y]
    rwa [Metric.mem_ball, dist_zero_right] at hy
  have hq' : ∀ τ : ℝ, q τ = (fun y => A.transpose * h (L y) * A) (τ • e2 0) 1 1 :=
    fun τ => (hq τ).trans (R9 τ).symm
  have AX := normal_form_axis_curvature ρ (fun y => A.transpose * h (L y) * A) R5 R6 R7 t ht
    (Metric.ball 0 ρ) Metric.isOpen_ball subset_rfl htU hdet' q hq'
  have hy₀ : L (t • e2 0) ∈ Metric.ball (0 : E2) ρ := by
    rw [R4 t]
    exact hmem t (by rw [abs_of_pos ht]; exact htρ)
  have ROT := gaussCurv2_orthogonal_comp h L A R1 R2 (Metric.ball 0 ρ) Metric.isOpen_ball hs
    hdetB (t • e2 0) hy₀
  rw [ROT, R4 t] at AX
  exact AX

theorem integral_ball_polar_E2 (r : ℝ) (f : E2 → ℝ) (hr : 0 < r) (hf : ContinuousOn f (Metric.closedBall 0 r)) : IntervalIntegrable (fun φ : ℝ => ∫ s in (0 : ℝ)..r, s * f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) MeasureTheory.volume (-Real.pi) Real.pi ∧ ∫ x in Metric.ball (0 : E2) r, f x = ∫ φ in (-Real.pi)..Real.pi, ∫ s in (0 : ℝ)..r, s * f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) :=
by
  
  have hθn : ∀ φ : ℝ, ‖(Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2)‖ = 1 := by
    intro φ
    have h0 : (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 0 = Real.cos φ := by
      simp [e2, EuclideanSpace.single_apply]
    have h1 : (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 1 = Real.sin φ := by
      simp [e2, EuclideanSpace.single_apply]
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, h0, h1, Real.norm_eq_abs, Real.norm_eq_abs,
      sq_abs, sq_abs, Real.cos_sq_add_sin_sq, Real.sqrt_one]
  have hsn : ∀ s φ : ℝ, ‖s • (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2)‖ = |s| := by
    intro s φ
    rw [norm_smul, hθn, mul_one, Real.norm_eq_abs]
  
  have hΦ : MeasurePreserving
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ) volume volume :=
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
      (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  have hΦsymm : ∀ a b : ℝ,
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ).symm (a, b) = a • e2 0 + b • e2 1 := by
    intro a b
    have h : ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ) (a • e2 0 + b • e2 1) = (a, b) := by
      simp [MeasurableEquiv.finTwoArrow_apply, e2, EuclideanSpace.single_apply]
    rw [← h, MeasurableEquiv.symm_apply_apply]
  have hpolar : ∀ g : E2 → ℝ, ∫ x, g x = ∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
      p.1 * g (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by
    intro g
    have h1 : ∫ x, g x = ∫ p : ℝ × ℝ, g
        (((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
          E2 ≃ᵐ ℝ × ℝ).symm p) := by
      rw [← hΦ.integral_comp' (fun p => g
        (((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
          E2 ≃ᵐ ℝ × ℝ).symm p))]
      simp only [MeasurableEquiv.symm_apply_apply]
    rw [h1, ← integral_comp_polarCoord_symm, polarCoord_target]
    refine setIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo) ?_
    intro p _
    simp only [polarCoord_symm_apply, hΦsymm, smul_eq_mul]
    rw [smul_add, smul_smul, smul_smul]
  
  obtain ⟨F, hF⟩ : ∃ F : ℝ × ℝ → ℝ, ∀ p : ℝ × ℝ,
      F p = p.1 * f (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := ⟨_, fun p => rfl⟩
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  
  have hFc : ContinuousOn F (Set.Icc 0 r ×ˢ Set.Icc (-Real.pi) Real.pi) := by
    have hFeq : F = fun p : ℝ × ℝ =>
        p.1 * f (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := funext hF
    have hP : Continuous (fun p : ℝ × ℝ =>
        p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by fun_prop
    have hmaps : Set.MapsTo (fun p : ℝ × ℝ =>
        p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1))
        (Set.Icc 0 r ×ˢ Set.Icc (-Real.pi) Real.pi) (Metric.closedBall 0 r) := by
      intro p hp
      rw [mem_closedBall_zero_iff, hsn, abs_of_nonneg hp.1.1]
      exact hp.1.2
    rw [hFeq]
    exact continuous_fst.continuousOn.mul (hf.comp hP.continuousOn hmaps)
  have hint : IntegrableOn F (Set.Icc 0 r ×ˢ Set.Icc (-Real.pi) Real.pi) :=
    hFc.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  have hμ : (volume : Measure (ℝ × ℝ)).restrict (Set.Ioo 0 r ×ˢ Set.Ioo (-Real.pi) Real.pi) =
      ((volume : Measure ℝ).restrict (Set.Ioo 0 r)).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-Real.pi) Real.pi)) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint' : Integrable F (((volume : Measure ℝ).restrict (Set.Ioo 0 r)).prod
      ((volume : Measure ℝ).restrict (Set.Ioo (-Real.pi) Real.pi))) := by
    rw [← hμ]
    exact hint.mono_set (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
  have hinner : ∀ y : ℝ, ∫ x in Set.Ioo 0 r, F (x, y) = ∫ x in (0 : ℝ)..r, F (x, y) := by
    intro y
    rw [intervalIntegral.integral_of_le hr.le, integral_Ioc_eq_integral_Ioo]
  have hinner' : ∀ y : ℝ, ∫ x in (0 : ℝ)..r, F (x, y) =
      ∫ s in (0 : ℝ)..r, s * f (s • (Real.cos y • e2 0 + Real.sin y • e2 1)) := by
    intro y
    simp only [hF]
  constructor
  · have h := hint'.integral_prod_right
    simp only [hinner, hinner'] at h
    exact (intervalIntegrable_iff_integrableOn_Ioo_of_le hpi).2 h
  · have hT : MeasurableSet (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi) :=
      measurableSet_Ioi.prod measurableSet_Ioo
    have hS : MeasurableSet (Set.Ioo (0 : ℝ) r ×ˢ Set.Ioo (-Real.pi) Real.pi) :=
      measurableSet_Ioo.prod measurableSet_Ioo
    have hST : Set.Ioo (0 : ℝ) r ×ˢ Set.Ioo (-Real.pi) Real.pi ⊆
        Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi :=
      Set.prod_mono Set.Ioo_subset_Ioi_self subset_rfl
    calc ∫ x in Metric.ball (0 : E2) r, f x
        = ∫ x, (Metric.ball (0 : E2) r).indicator f x :=
          (integral_indicator measurableSet_ball).symm
      _ = ∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
            p.1 * (Metric.ball (0 : E2) r).indicator f
              (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := hpolar _
      _ = ∫ p in Set.Ioo (0 : ℝ) r ×ˢ Set.Ioo (-Real.pi) Real.pi,
            p.1 * (Metric.ball (0 : E2) r).indicator f
              (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by
          refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hT hST ?_
          rintro p ⟨⟨hp1, hp2⟩, hpS⟩
          have hp1' : (0 : ℝ) < p.1 := hp1
          have hrp : r ≤ p.1 := by
            by_contra hlt
            push_neg at hlt
            exact hpS ⟨⟨hp1', hlt⟩, hp2⟩
          have hnm : p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1) ∉
              Metric.ball (0 : E2) r := by
            rw [mem_ball_zero_iff, hsn, abs_of_pos hp1']
            exact not_lt.2 hrp
          rw [Set.indicator_of_notMem hnm, mul_zero]
      _ = ∫ p in Set.Ioo (0 : ℝ) r ×ˢ Set.Ioo (-Real.pi) Real.pi, F p := by
          refine setIntegral_congr_fun hS ?_
          rintro p ⟨⟨hp1, hp2⟩, _⟩
          have hm : p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1) ∈
              Metric.ball (0 : E2) r := by
            rw [mem_ball_zero_iff, hsn, abs_of_pos hp1]
            exact hp2
          show p.1 * (Metric.ball (0 : E2) r).indicator f
            (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) = F p
          rw [Set.indicator_of_mem hm, hF]
      _ = ∫ y in Set.Ioo (-Real.pi) Real.pi, ∫ x in Set.Ioo 0 r, F (x, y) := by
          rw [hμ]
          exact integral_prod_symm F hint'
      _ = ∫ y in Set.Ioo (-Real.pi) Real.pi,
            ∫ s in (0 : ℝ)..r, s * f (s • (Real.cos y • e2 0 + Real.sin y • e2 1)) := by
          simp only [hinner, hinner']
      _ = ∫ φ in (-Real.pi)..Real.pi,
            ∫ s in (0 : ℝ)..r, s * f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
          rw [intervalIntegral.integral_of_le hpi, integral_Ioc_eq_integral_Ioo]

theorem ray_taylor_identity (ρ r : ℝ) (q k : ℝ → ℝ) (hr : 0 < r) (hrρ : r < ρ) (hq : ContDiffOn ℝ 2 q (Set.Ioo (-ρ) ρ)) (hpos : ∀ τ ∈ Set.Ioo (-ρ) ρ, 0 < q τ) (hq0 : q 0 = 1) (hode : ∀ t : ℝ, 0 < t → t < ρ → 4 * t * q t ^ 2 * k t = t * deriv q t ^ 2 - 2 * t * q t * deriv (deriv q) t - 4 * q t * deriv q t) : ∫ s in (0 : ℝ)..r, s * Real.sqrt (q s) = r ^ 2 / 2 - (1 / 2) * ∫ s in (0 : ℝ)..r, (r - s) ^ 2 * k s * (s * Real.sqrt (q s)) :=
by
  
  have key : ∀ (J J1 J2 : ℝ → ℝ), (∀ u ∈ Set.Icc (0:ℝ) r, HasDerivAt J (J1 u) u) →
      (∀ u ∈ Set.Icc (0:ℝ) r, HasDerivAt J1 (J2 u) u) → ContinuousOn J2 (Set.Icc 0 r) →
      J 0 = 0 → J1 0 = 1 → (∀ u ∈ Set.Ioc (0:ℝ) r, J2 u = -(k u * J u)) →
      ∫ s in (0:ℝ)..r, J s = r ^ 2 / 2 - (1 / 2) * ∫ s in (0:ℝ)..r, (r - s) ^ 2 * k s * J s := by
    intro J J1 J2 hJ hJ1 hJ2c hJ0 hJ10 hode'
    have hJc : ContinuousOn J (Set.Icc 0 r) :=
      fun u hu => (hJ u hu).continuousAt.continuousWithinAt
    have hPhi : ∀ u ∈ Set.uIcc (0:ℝ) r,
        HasDerivAt (fun u => (r - u) ^ 2 * J1 u + 2 * (r - u) * J u)
          ((r - u) ^ 2 * J2 u - 2 * J u) u := by
      intro u hu
      rw [Set.uIcc_of_le hr.le] at hu
      have h1 : HasDerivAt (fun u => r - u) (-1) u := by
        simpa using (hasDerivAt_id u).const_sub r
      have h2 := ((h1.pow 2).mul (hJ1 u hu)).add ((h1.const_mul 2).mul (hJ u hu))
      convert h2 using 1
      norm_num
      ring
    have hpolyc : ContinuousOn (fun u : ℝ => (r - u) ^ 2) (Set.Icc 0 r) :=
      (continuousOn_const.sub continuousOn_id).pow 2
    have hA : IntervalIntegrable (fun u => (r - u) ^ 2 * J2 u) MeasureTheory.volume 0 r := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le hr.le]
      exact hpolyc.mul hJ2c
    have hB : IntervalIntegrable (fun u => 2 * J u) MeasureTheory.volume 0 r := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le hr.le]
      exact continuousOn_const.mul hJc
    have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hPhi (hA.sub hB)
    rw [intervalIntegral.integral_sub hA hB, intervalIntegral.integral_const_mul] at hFTC
    have hcongr : ∫ u in (0:ℝ)..r, (r - u) ^ 2 * J2 u =
        ∫ u in (0:ℝ)..r, -((r - u) ^ 2 * k u * J u) := by
      apply intervalIntegral.integral_congr_ae
      refine Filter.Eventually.of_forall (fun u hu => ?_)
      rw [Set.uIoc_of_le hr.le] at hu
      rw [hode' u hu]
      ring
    rw [hcongr, intervalIntegral.integral_neg] at hFTC
    simp only [sub_zero, hJ0, hJ10] at hFTC
    linear_combination (-1/2 : ℝ) * hFTC
  
  have alg : ∀ t Q Q1 Q2 K : ℝ, 0 < Q →
      4 * t * Q ^ 2 * K = t * Q1 ^ 2 - 2 * t * Q * Q2 - 4 * Q * Q1 →
      2 * (Q1 / (2 * Real.sqrt Q)) + t * ((Q2 * (2 * Real.sqrt Q) - Q1 * (2 * (Q1 / (2 * Real.sqrt Q)))) / (2 * Real.sqrt Q) ^ 2)
        = -(K * (t * Real.sqrt Q)) := by
    intro t Q Q1 Q2 K hQ h
    have hS : 0 < Real.sqrt Q := Real.sqrt_pos.2 hQ
    have hSS : Real.sqrt Q ^ 2 = Q := Real.sq_sqrt hQ.le
    rw [← hSS] at h
    generalize Real.sqrt Q = S at h hS ⊢
    have e : 2 * (Q1 / (2 * S)) + t * ((Q2 * (2 * S) - Q1 * (2 * (Q1 / (2 * S)))) / (2 * S) ^ 2)
        = (4 * S ^ 2 * Q1 + 2 * t * S ^ 2 * Q2 - t * Q1 ^ 2) / (4 * S ^ 3) := by
      field_simp
      ring
    rw [e, div_eq_iff (by positivity)]
    linear_combination h
  
  have hUo : IsOpen (Set.Ioo (-ρ) ρ) := isOpen_Ioo
  have hq1 : ContDiffOn ℝ 1 (deriv q) (Set.Ioo (-ρ) ρ) := hq.deriv_of_isOpen hUo (by norm_num)
  have hq2c : ContinuousOn (deriv (deriv q)) (Set.Ioo (-ρ) ρ) :=
    hq1.continuousOn_deriv_of_isOpen hUo le_rfl
  have hqc : ContinuousOn q (Set.Ioo (-ρ) ρ) := hq.continuousOn
  have hq1c : ContinuousOn (deriv q) (Set.Ioo (-ρ) ρ) := hq1.continuousOn
  have hd0 : ∀ t ∈ Set.Ioo (-ρ) ρ, HasDerivAt q (deriv q t) t := fun t ht =>
    ((hq.differentiableOn (by norm_num)).differentiableAt (hUo.mem_nhds ht)).hasDerivAt
  have hd1 : ∀ t ∈ Set.Ioo (-ρ) ρ, HasDerivAt (deriv q) (deriv (deriv q) t) t := fun t ht =>
    ((hq1.differentiableOn (by norm_num)).differentiableAt (hUo.mem_nhds ht)).hasDerivAt
  have hne : ∀ t ∈ Set.Ioo (-ρ) ρ, 2 * Real.sqrt (q t) ≠ 0 := fun t ht =>
    (mul_pos two_pos (Real.sqrt_pos.2 (hpos t ht))).ne'
  have hw : ∀ t ∈ Set.Ioo (-ρ) ρ, HasDerivAt (fun s => Real.sqrt (q s))
      (deriv q t / (2 * Real.sqrt (q t))) t := fun t ht => (hd0 t ht).sqrt (hpos t ht).ne'
  have hv : ∀ t ∈ Set.Ioo (-ρ) ρ, HasDerivAt (fun s => deriv q s / (2 * Real.sqrt (q s)))
      ((deriv (deriv q) t * (2 * Real.sqrt (q t)) - deriv q t * (2 * (deriv q t / (2 * Real.sqrt (q t))))) / (2 * Real.sqrt (q t)) ^ 2) t :=
    fun t ht => (hd1 t ht).div ((hw t ht).const_mul 2) (hne t ht)
  have D1 : ∀ t ∈ Set.Ioo (-ρ) ρ, HasDerivAt (fun s => s * Real.sqrt (q s))
      (Real.sqrt (q t) + t * (deriv q t / (2 * Real.sqrt (q t)))) t := fun t ht =>
    ((hasDerivAt_id' t).mul (hw t ht)).congr_deriv (by ring)
  have D2 : ∀ t ∈ Set.Ioo (-ρ) ρ,
      HasDerivAt (fun s => Real.sqrt (q s) + s * (deriv q s / (2 * Real.sqrt (q s))))
        (2 * (deriv q t / (2 * Real.sqrt (q t))) + t * ((deriv (deriv q) t * (2 * Real.sqrt (q t)) - deriv q t * (2 * (deriv q t / (2 * Real.sqrt (q t))))) / (2 * Real.sqrt (q t)) ^ 2)) t :=
    fun t ht => ((hw t ht).add ((hasDerivAt_id' t).mul (hv t ht))).congr_deriv (by ring)
  have hsc : ContinuousOn (fun t => 2 * Real.sqrt (q t)) (Set.Ioo (-ρ) ρ) :=
    continuousOn_const.mul hqc.sqrt
  have hvc : ContinuousOn (fun t => deriv q t / (2 * Real.sqrt (q t))) (Set.Ioo (-ρ) ρ) :=
    hq1c.div hsc hne
  have C2 : ContinuousOn (fun t => 2 * (deriv q t / (2 * Real.sqrt (q t))) + t * ((deriv (deriv q) t * (2 * Real.sqrt (q t)) - deriv q t * (2 * (deriv q t / (2 * Real.sqrt (q t))))) / (2 * Real.sqrt (q t)) ^ 2)) (Set.Ioo (-ρ) ρ) :=
    (continuousOn_const.mul hvc).add (continuousOn_id.mul
      (((hq2c.mul hsc).sub (hq1c.mul (continuousOn_const.mul hvc))).div (hsc.pow 2)
        (fun t ht => pow_ne_zero 2 (hne t ht))))
  
  have hsub : Set.Icc (0:ℝ) r ⊆ Set.Ioo (-ρ) ρ := fun u hu =>
    ⟨by linarith [hu.1], by linarith [hu.2]⟩
  exact key (fun s => s * Real.sqrt (q s))
    (fun s => Real.sqrt (q s) + s * (deriv q s / (2 * Real.sqrt (q s))))
    (fun t => 2 * (deriv q t / (2 * Real.sqrt (q t))) + t * ((deriv (deriv q) t * (2 * Real.sqrt (q t)) - deriv q t * (2 * (deriv q t / (2 * Real.sqrt (q t))))) / (2 * Real.sqrt (q t)) ^ 2))
    (fun u hu => D1 u (hsub hu)) (fun u hu => D2 u (hsub hu)) (C2.mono hsub)
    (by simp) (by simp [hq0])
    (fun u hu => alg u (q u) (deriv q u) (deriv (deriv q) u) (k u)
      (hpos u (hsub (Set.Ioc_subset_Icc_self hu))) (hode u hu.1 (by linarith [hu.2])))

theorem normal_disc_gauss_bonnet (ρ : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hρ : 0 < ρ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) : ContinuousOn (gaussCurv2 h) (Metric.ball 0 ρ) ∧ ∀ r : ℝ, 0 < r → r < ρ → ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det = Real.pi * r ^ 2 - (1 / 2) * ∫ x in Metric.ball (0 : E2) r, (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det :=
by
  
  have hsym : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i j : Fin 2, h x j i = h x i j := by
    intro x hx i j
    have := (hnf x hx).1.isHermitian.apply i j
    simpa using this
  have hdetpos : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 < (h x).det := fun x hx => (hnf x hx).1.det_pos
  
  have hKc : ContinuousOn (gaussCurv2 h) (Metric.ball 0 ρ) := by
    
    have hU : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
    have hpdS : ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w (Metric.ball 0 ρ) → ∀ i : Fin 2,
        ContDiffOn ℝ ∞ (pd2 i w) (Metric.ball 0 ρ) := by
      intro w hw i
      have hf := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hw).2
      exact hf.clm_apply contDiffOn_const
    have hd : ContDiffOn ℝ ∞ (fun x => (h x).det) (Metric.ball 0 ρ) := by
      have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
        funext x
        rw [Matrix.det_fin_two]
      rw [e]
      exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
    have hdi : ContDiffOn ℝ ∞ (fun x => ((h x).det)⁻¹) (Metric.ball 0 ρ) :=
      hd.inv (fun x hx => (hdetpos x hx).ne')
    have hadj : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x).adjugate i j) (Metric.ball 0 ρ) := by
      intro i j
      have e : (fun x => (h x).adjugate i j) = fun x =>
          (!![h x 1 1, -h x 0 1; -h x 1 0, h x 0 0] : Matrix (Fin 2) (Fin 2) ℝ) i j := by
        funext x
        rw [Matrix.adjugate_fin_two]
      rw [e]
      fin_cases i <;> fin_cases j
      · simpa using hh 1 1
      · simpa using (hh 0 1).neg
      · simpa using (hh 1 0).neg
      · simpa using hh 0 0
    have hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ i j) (Metric.ball 0 ρ) := by
      intro i j
      refine (hdi.mul (hadj i j)).congr ?_
      intro x _
      rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
    have hchr : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) (Metric.ball 0 ρ) := by
      intro k i j
      unfold christoffel2
      exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
        (((hpdS _ (hh j l) i).add (hpdS _ (hh i l) j)).sub (hpdS _ (hh i j) l)))
    have hric : ∀ j k : Fin 2, ContDiffOn ℝ ∞ (ricci2 h j k) (Metric.ball 0 ρ) := by
      intro j k
      unfold ricci2
      exact (ContDiffOn.sum fun i _ => (hpdS _ (hchr i j k) i).sub (hpdS _ (hchr i i k) j)).add
        (ContDiffOn.sum fun i _ => ContDiffOn.sum fun p _ =>
          ((hchr i i p).mul (hchr p j k)).sub ((hchr i j p).mul (hchr p i k)))
    have hG : ContDiffOn ℝ ∞ (gaussCurv2 h) (Metric.ball 0 ρ) := by
      unfold gaussCurv2
      exact contDiffOn_const.mul (ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ =>
        (hinv j k).mul (hric j k))
    exact hG.continuousOn
  
  obtain ⟨h', h'def⟩ : ∃ h' : E2 → Matrix (Fin 2) (Fin 2) ℝ,
      h' = fun x => Matrix.of fun i j => (h x i j + h x j i) / 2 := ⟨_, rfl⟩
  have h'sym : ∀ (x : E2) (i j : Fin 2), h' x i j = h' x j i := by
    intro x i j
    rw [h'def]
    simp only [Matrix.of_apply]
    ring
  have h'eq : ∀ x ∈ Metric.ball (0 : E2) ρ, h' x = h x := by
    intro x hx
    ext i j
    rw [h'def]
    simp only [Matrix.of_apply]
    rw [hsym x hx i j]
    ring
  have h'smooth : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h' x i j) (Metric.ball 0 ρ) := by
    intro i j
    rw [h'def]
    simp only [Matrix.of_apply]
    exact ((hh i j).add (hh j i)).div_const 2
  have h'nf : ∀ x ∈ Metric.ball (0 : E2) ρ,
      (h' x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h' x i j * x j = x i := by
    intro x hx
    rw [h'eq x hx]
    exact hnf x hx
  have hK' : ∀ x ∈ Metric.ball (0 : E2) ρ, gaussCurv2 h' x = gaussCurv2 h x := by
    
    have hball : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
    have hpd : ∀ y ∈ Metric.ball (0 : E2) ρ, ∀ a b c : Fin 2,
        pd2 c (fun z => h' z a b) y = pd2 c (fun z => h z a b) y := by
      intro y hy a b c
      have hev : (fun z => h' z a b) =ᶠ[𝓝 y] (fun z => h z a b) :=
        Filter.eventually_of_mem (hball.mem_nhds hy) (fun z hz => by simp only [h'eq z hz])
      unfold pd2
      rw [Filter.EventuallyEq.fderiv_eq hev]
    have hchr : ∀ y ∈ Metric.ball (0 : E2) ρ, ∀ k i j : Fin 2,
        christoffel2 h' k i j y = christoffel2 h k i j y := by
      intro y hy k i j
      simp only [christoffel2, h'eq y hy, hpd y hy]
    intro x hx
    have hpdc : ∀ c k i j : Fin 2,
        pd2 c (christoffel2 h' k i j) x = pd2 c (christoffel2 h k i j) x := by
      intro c k i j
      have hev : christoffel2 h' k i j =ᶠ[𝓝 x] christoffel2 h k i j :=
        Filter.eventually_of_mem (hball.mem_nhds hx) (fun y hy => hchr y hy k i j)
      unfold pd2
      rw [Filter.EventuallyEq.fderiv_eq hev]
    simp only [gaussCurv2, ricci2, h'eq x hx, hpdc, hchr x hx]
  refine ⟨hKc, ?_⟩
  intro r hr hrρ
  
  have hcl : Metric.closedBall (0 : E2) r ⊆ Metric.ball 0 ρ := Metric.closedBall_subset_ball hrρ
  have hc : ∀ i j : Fin 2, ContinuousOn (fun x => h x i j) (Metric.closedBall 0 r) :=
    fun i j => ((hh i j).continuousOn).mono hcl
  have hu : ContinuousOn (fun x => Real.sqrt (h x).det) (Metric.closedBall (0 : E2) r) := by
    have e : (fun x => Real.sqrt (h x).det) =
        fun x => Real.sqrt (h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0) := by
      funext x
      rw [Matrix.det_fin_two]
    rw [e]
    exact Real.continuous_sqrt.comp_continuousOn
      (((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0)))
  have hf2 : ContinuousOn (fun x => (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det)
      (Metric.closedBall (0 : E2) r) :=
    ((((continuous_const.sub continuous_norm).pow 2).continuousOn).mul (hKc.mono hcl)).mul hu
  
  have hθ0 : ∀ φ : ℝ, (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 0 = Real.cos φ := by
    intro φ
    simp [e2, EuclideanSpace.single_apply]
  have hθ1 : ∀ φ : ℝ, (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 1 = Real.sin φ := by
    intro φ
    simp [e2, EuclideanSpace.single_apply]
  have hθn : ∀ φ : ℝ, ‖(Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2)‖ = 1 := by
    intro φ
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, hθ0, hθ1, Real.norm_eq_abs, Real.norm_eq_abs,
      sq_abs, sq_abs, Real.cos_sq_add_sin_sq, Real.sqrt_one]
  have hsn : ∀ θ : E2, ‖θ‖ = 1 → ∀ s : ℝ, ‖s • θ‖ = |s| := by
    intro θ hθ s
    rw [norm_smul, hθ, mul_one, Real.norm_eq_abs]
  have h2le : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  
  have hray : ∀ φ : ℝ,
      ∫ s in (0 : ℝ)..r, s * Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det =
        r ^ 2 / 2 - (1 / 2) * ∫ s in (0 : ℝ)..r,
          s * ((r - ‖s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)‖) ^ 2 *
            gaussCurv2 h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) *
            Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det) := by
    intro φ
    obtain ⟨θ, hθdef⟩ : ∃ θ : E2, θ = Real.cos φ • e2 0 + Real.sin φ • e2 1 := ⟨_, rfl⟩
    rw [← hθdef]
    have hθ : ‖θ‖ = 1 := hθdef ▸ hθn φ
    have hmem : ∀ τ : ℝ, |τ| < ρ → τ • θ ∈ Metric.ball (0 : E2) ρ := by
      intro τ hτ
      rw [Metric.mem_ball, dist_zero_right, hsn θ hθ τ]
      exact hτ
    obtain ⟨q, hq⟩ : ∃ q : ℝ → ℝ, ∀ τ : ℝ, q τ = h' (τ • θ) 0 0 * θ 1 ^ 2 -
        2 * h' (τ • θ) 0 1 * θ 0 * θ 1 + h' (τ • θ) 1 1 * θ 0 ^ 2 := ⟨_, fun τ => rfl⟩
    obtain ⟨R0, R1, R2, R3⟩ := normal_ray_jacobi ρ h' hρ h'smooth h'sym h'nf θ hθ q hq
    have hpos : ∀ τ ∈ Set.Ioo (-ρ) ρ, 0 < q τ := by
      intro τ hτ
      have hτ' : |τ| < ρ := abs_lt.mpr ⟨hτ.1, hτ.2⟩
      rw [R1 τ hτ', h'eq _ (hmem τ hτ')]
      exact hdetpos _ (hmem τ hτ')
    have T := ray_taylor_identity ρ r q (fun t => gaussCurv2 h' (t • θ)) hr hrρ
      (R2.of_le h2le) hpos R0 R3
    have e1 : ∫ s in (0 : ℝ)..r, s * Real.sqrt (h (s • θ)).det =
        ∫ s in (0 : ℝ)..r, s * Real.sqrt (q s) := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le hr.le] at hs
      have hs' : |s| < ρ := by
        rw [abs_of_nonneg hs.1]
        linarith [hs.2]
      simp only
      rw [R1 s hs', h'eq _ (hmem s hs')]
    have e2 : ∫ s in (0 : ℝ)..r, s * ((r - ‖s • θ‖) ^ 2 * gaussCurv2 h (s • θ) *
          Real.sqrt (h (s • θ)).det) =
        ∫ s in (0 : ℝ)..r, (r - s) ^ 2 * gaussCurv2 h' (s • θ) * (s * Real.sqrt (q s)) := by
      apply intervalIntegral.integral_congr
      intro s hs
      rw [Set.uIcc_of_le hr.le] at hs
      have hs' : |s| < ρ := by
        rw [abs_of_nonneg hs.1]
        linarith [hs.2]
      simp only
      rw [R1 s hs', h'eq _ (hmem s hs'), hK' _ (hmem s hs'), hsn θ hθ s, abs_of_nonneg hs.1]
      ring
    rw [e1, e2]
    exact T
  
  have hEu : ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det =
      ∫ φ in (-Real.pi)..Real.pi, ∫ s in (0 : ℝ)..r,
        s * Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det :=
    (integral_ball_polar_E2 r (fun x => Real.sqrt (h x).det) hr hu).2
  have hP := integral_ball_polar_E2 r
    (fun x => (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det) hr hf2
  have hIf : IntervalIntegrable (fun φ : ℝ => ∫ s in (0 : ℝ)..r,
      s * ((r - ‖s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)‖) ^ 2 *
        gaussCurv2 h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) *
        Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det))
      MeasureTheory.volume (-Real.pi) Real.pi := hP.1
  have hEf : ∫ x in Metric.ball (0 : E2) r, (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det =
      ∫ φ in (-Real.pi)..Real.pi, ∫ s in (0 : ℝ)..r,
        s * ((r - ‖s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)‖) ^ 2 *
          gaussCurv2 h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) *
          Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det) := hP.2
  rw [hEu, hEf, intervalIntegral.integral_congr (fun φ _ => hray φ),
    intervalIntegral.integral_sub intervalIntegrable_const (hIf.const_mul (1 / 2)),
    intervalIntegral.integral_const, intervalIntegral.integral_const_mul, smul_eq_mul]
  ring

theorem normal_disc_area_bound (ρ ε : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (a b : E2 → ℝ) (hρ : 0 < ρ) (hε : 0 ≤ ε) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (ha : ContinuousOn a (Metric.ball 0 ρ)) (hb : ContinuousOn b (Metric.ball 0 ρ)) (hK : ContinuousOn (gaussCurv2 h) (Metric.ball 0 ρ)) (hpt : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 ≤ a x ∧ -(a x) / 2 - ε ≤ gaussCurv2 h x ∧ -ε ≤ b x) (hGB : ∀ r : ℝ, 0 < r → r < ρ → ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det = Real.pi * r ^ 2 - (1 / 2) * ∫ x in Metric.ball (0 : E2) r, (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det) (hstab : ∀ (r M : ℝ) (Ψ Θ : E2 → ℝ), 0 < r → r < ρ → ContDiff ℝ 1 Ψ → (∀ x, 0 ≤ Ψ x) → (∀ x : E2, r ≤ ‖x‖ → Ψ x = 0) → Measurable Θ → (∀ x, 0 ≤ Θ x ∧ Θ x ≤ M) → (∀ x : E2, r ≤ ‖x‖ → Θ x = 0) → (∀ x ∈ Metric.ball (0 : E2) ρ, ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x ≤ 4 * Ψ x * Θ x) → ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * Real.sqrt (h x).det ≤ ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det) : ∀ r : ℝ, 0 < r → r < ρ → 3 * ε * r ^ 2 ≤ 1 → ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det ≤ 4 * Real.pi * r ^ 2 :=
by
  intro r hr hrρ hsmall
  have hr2 : 0 < r ^ 2 := by positivity
  
  have hP : ∀ y : ℝ, HasDerivAt (fun z : ℝ => (max 0 z) ^ 2) (2 * max 0 y) y := by
    intro y
    rw [hasDerivAt_iff_isLittleO, Asymptotics.isLittleO_iff]
    intro c hc
    filter_upwards [Metric.ball_mem_nhds y hc] with z hz
    rw [Metric.mem_ball, Real.dist_eq] at hz
    have hb : |max 0 z ^ 2 - max 0 y ^ 2 - (z - y) * (2 * max 0 y)| ≤ (z - y) ^ 2 := by
      rcases le_total 0 z with h1 | h1 <;> rcases le_total 0 y with h2 | h2
      · rw [max_eq_right h1, max_eq_right h2, abs_le]; constructor <;> nlinarith
      · rw [max_eq_right h1, max_eq_left h2, abs_le]; constructor <;> nlinarith
      · rw [max_eq_left h1, max_eq_right h2, abs_le]; constructor <;> nlinarith
      · rw [max_eq_left h1, max_eq_left h2, abs_le]; constructor <;> nlinarith
    simp only [Real.norm_eq_abs, smul_eq_mul]
    calc |max 0 z ^ 2 - max 0 y ^ 2 - (z - y) * (2 * max 0 y)| ≤ (z - y) ^ 2 := hb
      _ = |z - y| * |z - y| := by rw [← sq_abs, sq]
      _ ≤ c * |z - y| := mul_le_mul_of_nonneg_right hz.le (abs_nonneg _)
  
  obtain ⟨mf, hmf⟩ : ∃ mf : ℝ → ℝ, mf = fun t => max 0 (1 - t / r ^ 2) := ⟨_, rfl⟩
  obtain ⟨qf, hqf⟩ : ∃ qf : ℝ → ℝ, qf = fun t => 1 - t / r ^ 2 / 2 := ⟨_, rfl⟩
  obtain ⟨F, hFd⟩ : ∃ F : ℝ → ℝ, F = fun t => r ^ 2 * mf t ^ 2 * qf t ^ 2 := ⟨_, rfl⟩
  obtain ⟨D, hDd⟩ : ∃ D : ℝ → ℝ, D = fun t => -(mf t * qf t * (2 * qf t + mf t)) := ⟨_, rfl⟩
  have hF : ∀ t, HasDerivAt F (D t) t := by
    intro t
    have h1 : HasDerivAt (fun t : ℝ => 1 - t / r ^ 2) (-(1 / r ^ 2)) t :=
      ((hasDerivAt_id' t).div_const (r ^ 2)).const_sub 1
    have h2 := (hP (1 - t / r ^ 2)).comp t h1
    have h4 : HasDerivAt (fun t : ℝ => 1 - t / r ^ 2 / 2) (-(1 / r ^ 2 / 2)) t :=
      (((hasDerivAt_id' t).div_const (r ^ 2)).div_const 2).const_sub 1
    have h5 := (h2.mul (h4.mul h4)).const_mul (r ^ 2)
    simp only [hFd, hDd, hmf, hqf]
    convert h5 using 1
    · funext s; simp only [Pi.mul_apply, Function.comp_apply]; ring
    · simp only [Pi.mul_apply, Function.comp_apply]; field_simp; ring
  have hDc : Continuous D := by
    simp only [hDd, hmf, hqf]; fun_prop
  have hFC1 : ContDiff ℝ 1 F := by
    rw [contDiff_one_iff_deriv]
    refine ⟨fun t => (hF t).differentiableAt, ?_⟩
    have : deriv F = D := funext fun t => (hF t).deriv
    rw [this]; exact hDc
  have hDval : ∀ t, D t = -(max 0 (1 - t / r ^ 2) * (1 - t / r ^ 2 / 2) *
      (2 * (1 - t / r ^ 2 / 2) + max 0 (1 - t / r ^ 2))) := by
    intro t; simp only [hDd, hmf, hqf]
  
  obtain ⟨Ψ, hΨd⟩ : ∃ Ψ : E2 → ℝ, Ψ = fun x => F (‖x‖ ^ 2) := ⟨_, rfl⟩
  have hΨC1 : ContDiff ℝ 1 Ψ := by
    rw [hΨd]; exact hFC1.comp (contDiff_norm_sq ℝ)
  have hΨfd : ∀ x : E2, HasFDerivAt Ψ (D (‖x‖ ^ 2) • (2 • innerSL ℝ x)) x := by
    intro x
    rw [hΨd]
    exact (hF (‖x‖ ^ 2)).comp_hasFDerivAt x (hasStrictFDerivAt_norm_sq x).hasFDerivAt
  have hpd : ∀ x : E2, ∀ i : Fin 2, pd2 i Ψ x = (2 * D (‖x‖ ^ 2)) * x i := by
    intro x i
    simp only [pd2]
    rw [(hΨfd x).fderiv]
    simp [e2, EuclideanSpace.inner_single_right] <;> ring
  have hΨval : ∀ x : E2, Ψ x = r ^ 2 * (max 0 (1 - ‖x‖ ^ 2 / r ^ 2)) ^ 2 *
      (1 - ‖x‖ ^ 2 / r ^ 2 / 2) ^ 2 := by
    intro x; simp only [hΨd, hFd, hmf, hqf]
  
  have S1 : ∀ y : ℝ, 0 ≤ y → 0 ≤ r ^ 2 * (max 0 (1 - y)) ^ 2 * (1 - y / 2) ^ 2 ∧
      r ^ 2 * (max 0 (1 - y)) ^ 2 * (1 - y / 2) ^ 2 ≤ r ^ 2 := by
    intro y hy
    refine ⟨by positivity, ?_⟩
    rcases le_total (1 - y) 0 with h1 | h1
    · rw [max_eq_left h1]; norm_num <;> positivity
    · rw [max_eq_right h1]
      have hp0 : 0 ≤ (1 - y) * (1 - y / 2) := mul_nonneg h1 (by linarith)
      have hp1 : (1 - y) * (1 - y / 2) ≤ 1 := by nlinarith
      have hp2 : ((1 - y) * (1 - y / 2)) ^ 2 ≤ 1 := by nlinarith
      calc r ^ 2 * (1 - y) ^ 2 * (1 - y / 2) ^ 2 = r ^ 2 * ((1 - y) * (1 - y / 2)) ^ 2 := by ring
        _ ≤ r ^ 2 * 1 := mul_le_mul_of_nonneg_left hp2 hr2.le
        _ = r ^ 2 := mul_one _
  have S2 : ∀ y : ℝ, 1 ≤ y → r ^ 2 * (max 0 (1 - y)) ^ 2 * (1 - y / 2) ^ 2 = 0 := by
    intro y hy; rw [max_eq_left (by linarith)]; ring
  have S3 : ∀ σ : ℝ, 0 ≤ σ → σ ≤ 1 →
      r ^ 2 * (1 - σ) ^ 2 ≤ r ^ 2 * (max 0 (1 - σ ^ 2)) ^ 2 * (1 - σ ^ 2 / 2) ^ 2 := by
    intro σ h0 h1
    have hs2 : σ ^ 2 ≤ 1 := by nlinarith
    rw [max_eq_right (by linarith)]
    have e : 1 - σ ≤ (1 - σ ^ 2) * (1 - σ ^ 2 / 2) := by
      nlinarith [mul_nonneg (mul_nonneg h0 (sq_nonneg (1 - σ))) (by linarith : (0:ℝ) ≤ 1 + σ / 2)]
    have e' := pow_le_pow_left₀ (by linarith : (0:ℝ) ≤ 1 - σ) e 2
    calc r ^ 2 * (1 - σ) ^ 2 ≤ r ^ 2 * ((1 - σ ^ 2) * (1 - σ ^ 2 / 2)) ^ 2 :=
          mul_le_mul_of_nonneg_left e' hr2.le
      _ = r ^ 2 * (1 - σ ^ 2) ^ 2 * (1 - σ ^ 2 / 2) ^ 2 := by ring
  have S4 : ∀ y : ℝ, 0 ≤ y →
      (2 * -(max 0 (1 - y) * (1 - y / 2) * (2 * (1 - y / 2) + max 0 (1 - y)))) ^ 2 * (y * r ^ 2)
        ≤ 8 * (r ^ 2 * (max 0 (1 - y)) ^ 2 * (1 - y / 2) ^ 2) := by
    intro y hy
    rcases le_total (1 - y) 0 with h1 | h1
    · rw [max_eq_left h1]; simp
    · rw [max_eq_right h1]
      nlinarith [mul_nonneg (mul_nonneg (sq_nonneg ((1 - y) * (1 - y / 2) * r))
        (sq_nonneg (2 * y - 1))) (by linarith : (0:ℝ) ≤ 2 - y)]
  
  have hΨb : ∀ x : E2, 0 ≤ Ψ x ∧ Ψ x ≤ r ^ 2 := fun x => by
    rw [hΨval]; exact S1 _ (by positivity)
  have hΨ0 : ∀ x : E2, r ≤ ‖x‖ → Ψ x = 0 := by
    intro x hx; rw [hΨval]; apply S2
    rw [le_div_iff₀ hr2, one_mul]; exact pow_le_pow_left₀ hr.le hx 2
  have hΨlow : ∀ x : E2, ‖x‖ ≤ r → (r - ‖x‖) ^ 2 ≤ Ψ x := by
    intro x hx
    rw [hΨval]
    have hσ0 : 0 ≤ ‖x‖ / r := by positivity
    have hσ1 : ‖x‖ / r ≤ 1 := (div_le_one hr).mpr hx
    have e1 : ‖x‖ ^ 2 / r ^ 2 = (‖x‖ / r) ^ 2 := by rw [div_pow]
    have e2' : r - ‖x‖ = r * (1 - ‖x‖ / r) := by field_simp
    rw [e1, e2', mul_pow]; exact S3 _ hσ0 hσ1
  have hcb : ∀ x : E2, (2 * D (‖x‖ ^ 2)) ^ 2 * ‖x‖ ^ 2 ≤ 8 * Ψ x := by
    intro x
    have hy0 : 0 ≤ ‖x‖ ^ 2 / r ^ 2 := by positivity
    have := S4 _ hy0
    rw [div_mul_cancel₀ _ hr2.ne'] at this
    rw [hDval, hΨval]; exact this
  
  have hquad : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ c : ℝ,
      ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * (c * x i) * (c * x j) = c ^ 2 * ‖x‖ ^ 2 := by
    intro x hx c
    obtain ⟨hpdx, hfix⟩ := hnf x hx
    have hdet : IsUnit (h x).det := isUnit_iff_ne_zero.mpr hpdx.det_pos.ne'
    have hv : Matrix.mulVec (h x) (fun i => x i) = (fun i => x i) := by
      funext i
      simpa [Matrix.mulVec, dotProduct] using hfix i
    have hv' : Matrix.mulVec (h x)⁻¹ (fun i => x i) = (fun i => x i) := by
      calc Matrix.mulVec (h x)⁻¹ (fun i => x i)
          = Matrix.mulVec (h x)⁻¹ (Matrix.mulVec (h x) (fun i => x i)) := by rw [hv]
        _ = (fun i => x i) := by
          rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hdet, Matrix.one_mulVec]
    have H0 := congrFun hv' 0
    have H1 := congrFun hv' 1
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two] at H0 H1
    have hn : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
        sq_abs, sq_abs]
    rw [hn]
    simp only [Fin.sum_univ_two]
    linear_combination c ^ 2 * x 0 * H0 + c ^ 2 * x 1 * H1
  
  obtain ⟨Θ, hΘd⟩ : ∃ Θ : E2 → ℝ, Θ = (Metric.ball (0 : E2) r).indicator (fun _ => (2 : ℝ)) :=
    ⟨_, rfl⟩
  have hΘin : ∀ x : E2, ‖x‖ < r → Θ x = 2 := by
    intro x hx; rw [hΘd]; exact Set.indicator_of_mem (mem_ball_zero_iff.mpr hx) _
  have hΘout : ∀ x : E2, r ≤ ‖x‖ → Θ x = 0 := by
    intro x hx; rw [hΘd]
    exact Set.indicator_of_notMem (fun hm => absurd (mem_ball_zero_iff.mp hm) (not_lt.mpr hx)) _
  have hΘb : ∀ x, 0 ≤ Θ x ∧ Θ x ≤ 2 := by
    intro x
    by_cases hx : ‖x‖ < r
    · rw [hΘin x hx]; norm_num
    · rw [hΘout x (not_lt.mp hx)]; norm_num
  have hmB : MeasurableSet (Metric.ball (0 : E2) r) := Metric.isOpen_ball.measurableSet
  have hmBρ : MeasurableSet (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball.measurableSet
  have hΘm : Measurable Θ := by rw [hΘd]; exact measurable_const.indicator hmB
  
  have hgrad : ∀ x ∈ Metric.ball (0 : E2) ρ, ∑ i : Fin 2, ∑ j : Fin 2,
      (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x ≤ 4 * Ψ x * Θ x := by
    intro x hx
    simp only [hpd x]
    rw [hquad x hx]
    have hc := hcb x
    by_cases hxr : ‖x‖ < r
    · rw [hΘin x hxr]; linarith
    · have hrx : r ≤ ‖x‖ := not_lt.mp hxr
      have h0 := hΨ0 x hrx
      rw [hΘout x hrx, h0]
      rw [h0] at hc
      linarith
  have hS := hstab r 2 Ψ Θ hr hrρ hΨC1 (fun x => (hΨb x).1) hΨ0 hΘm hΘb hΘout hgrad
  
  have hsub : Metric.ball (0 : E2) r ⊆ Metric.ball 0 ρ := Metric.ball_subset_ball hrρ.le
  have hdiff : ∀ x ∈ Metric.ball (0 : E2) ρ \ Metric.ball 0 r, r ≤ ‖x‖ := by
    intro x hx
    have := hx.2
    rw [mem_ball_zero_iff, not_lt] at this
    exact this
  have e5 : ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * Real.sqrt (h x).det =
      ∫ x in Metric.ball (0 : E2) r, (a x + b x) * Ψ x * Real.sqrt (h x).det := by
    apply setIntegral_eq_of_subset_of_forall_diff_eq_zero hmBρ hsub
    intro x hx
    rw [hΨ0 x (hdiff x hx)]; ring
  have e6 : ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det =
      2 * ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det := by
    have e6a : ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det =
        ∫ x in Metric.ball (0 : E2) r, Θ x * Real.sqrt (h x).det := by
      apply setIntegral_eq_of_subset_of_forall_diff_eq_zero hmBρ hsub
      intro x hx
      rw [hΘout x (hdiff x hx), zero_mul]
    rw [e6a, ← integral_const_mul]
    apply setIntegral_congr_fun hmB
    intro x hx
    dsimp only
    rw [hΘin x (mem_ball_zero_iff.mp hx)]
  rw [e5, e6] at hS
  
  have hu : ContinuousOn (fun x => Real.sqrt (h x).det) (Metric.ball (0 : E2) ρ) := by
    have hc : ∀ i j : Fin 2, ContinuousOn (fun x => h x i j) (Metric.ball (0 : E2) ρ) :=
      fun i j => (hh i j).continuousOn
    have e : (fun x => Real.sqrt (h x).det) =
        fun x => Real.sqrt (h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0) := by
      funext x; rw [Matrix.det_fin_two]
    rw [e]
    exact Real.continuous_sqrt.comp_continuousOn
      (((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0)))
  have hcl : Metric.closedBall (0 : E2) r ⊆ Metric.ball 0 ρ := Metric.closedBall_subset_ball hrρ
  have hint : ∀ f : E2 → ℝ, ContinuousOn f (Metric.closedBall 0 r) →
      IntegrableOn f (Metric.ball 0 r) := fun f hf =>
    (hf.integrableOn_compact (isCompact_closedBall 0 r)).mono_set Metric.ball_subset_closedBall
  have hucl : ContinuousOn (fun x => Real.sqrt (h x).det) (Metric.closedBall (0 : E2) r) :=
    hu.mono hcl
  have hScl : ContinuousOn (fun x => (a x + b x) * Ψ x * Real.sqrt (h x).det)
      (Metric.closedBall (0 : E2) r) :=
    (((ha.mono hcl).add (hb.mono hcl)).mul hΨC1.continuous.continuousOn).mul hucl
  have hIu := hint _ hucl
  have hIS := hint _ hScl
  have hIK : IntegrableOn
      (fun x => -(1 / 2) * ((r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det))
      (Metric.ball 0 r) :=
    hint _ (continuousOn_const.mul
      (((((continuous_const.sub continuous_norm).pow 2).continuousOn).mul (hK.mono hcl)).mul hucl))
  have hIR : IntegrableOn
      (fun x => 1 / 4 * ((a x + b x) * Ψ x * Real.sqrt (h x).det) +
        (3 / 4 * ε * r ^ 2) * Real.sqrt (h x).det) (Metric.ball 0 r) :=
    hint _ ((continuousOn_const.mul hScl).add (continuousOn_const.mul hucl))
  
  have hpoint : ∀ x ∈ Metric.ball (0 : E2) r,
      -(1 / 2) * ((r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det) ≤
        1 / 4 * ((a x + b x) * Ψ x * Real.sqrt (h x).det) +
          (3 / 4 * ε * r ^ 2) * Real.sqrt (h x).det := by
    intro x hx
    have hxr : ‖x‖ < r := mem_ball_zero_iff.mp hx
    obtain ⟨ha0, hKx, hbx⟩ := hpt x (hsub hx)
    have hu0 : 0 ≤ Real.sqrt (h x).det := Real.sqrt_nonneg _
    obtain ⟨hΨ0x, hΨr⟩ := hΨb x
    have hw : (r - ‖x‖) ^ 2 ≤ Ψ x := hΨlow x hxr.le
    have hw0 : 0 ≤ (r - ‖x‖) ^ 2 := sq_nonneg _
    have p1 : 0 ≤ (r - ‖x‖) ^ 2 * Real.sqrt (h x).det * (gaussCurv2 h x + a x / 2 + ε) :=
      mul_nonneg (mul_nonneg hw0 hu0) (by linarith)
    have p2 : 0 ≤ (Ψ x - (r - ‖x‖) ^ 2) * a x * Real.sqrt (h x).det :=
      mul_nonneg (mul_nonneg (by linarith) ha0) hu0
    have p3 : 0 ≤ (r ^ 2 - (r - ‖x‖) ^ 2) * ε * Real.sqrt (h x).det :=
      mul_nonneg (mul_nonneg (by linarith) hε) hu0
    have p4 : 0 ≤ (b x + ε) * Ψ x * Real.sqrt (h x).det :=
      mul_nonneg (mul_nonneg (by linarith) hΨ0x) hu0
    have p5 : 0 ≤ ε * (r ^ 2 - Ψ x) * Real.sqrt (h x).det :=
      mul_nonneg (mul_nonneg hε (by linarith)) hu0
    linarith
  have hmono := setIntegral_mono_on hIK hIR hmB hpoint
  have eL : ∫ x in Metric.ball (0 : E2) r,
      -(1 / 2) * ((r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det) =
      -(1 / 2) * ∫ x in Metric.ball (0 : E2) r,
        (r - ‖x‖) ^ 2 * gaussCurv2 h x * Real.sqrt (h x).det :=
    integral_const_mul _ _
  have eR : ∫ x in Metric.ball (0 : E2) r, (1 / 4 * ((a x + b x) * Ψ x * Real.sqrt (h x).det) +
        (3 / 4 * ε * r ^ 2) * Real.sqrt (h x).det) =
      1 / 4 * (∫ x in Metric.ball (0 : E2) r, (a x + b x) * Ψ x * Real.sqrt (h x).det) +
        (3 / 4 * ε * r ^ 2) * ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det := by
    rw [integral_add (hIS.const_mul _) (hIu.const_mul _), integral_const_mul, integral_const_mul]
  rw [eL, eR] at hmono
  have hGB' := hGB r hr hrρ
  have hA0 : 0 ≤ ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det :=
    setIntegral_nonneg hmB (fun x _ => Real.sqrt_nonneg _)
  have h3 := mul_le_mul_of_nonneg_right hsmall hA0
  nlinarith

theorem log_step_profile : ∃ S : ℝ → ℝ, ContDiff ℝ 1 S ∧ (∀ t : ℝ, t ≤ 0 → S t = 1) ∧ (∀ t : ℝ, 1 ≤ t → S t = 0) ∧ (∀ t : ℝ, 0 ≤ S t ∧ S t ≤ 1) ∧ ∀ t : ℝ, deriv S t ^ 2 ≤ 9 * S t :=
by
  
  have hq : ∀ t : ℝ, HasDerivAt (fun s : ℝ => (max s 0) ^ 2) (2 * max t 0) t := by
    intro t
    rcases lt_trichotomy t 0 with ht | ht | ht
    · have hev : (fun s : ℝ => (max s 0) ^ 2) =ᶠ[nhds t] (fun _ => (0:ℝ)) := by
        filter_upwards [eventually_lt_nhds ht] with s hs
        rw [max_eq_right hs.le]; norm_num
      rw [max_eq_right ht.le, mul_zero]
      exact (hasDerivAt_const t (0:ℝ)).congr_of_eventuallyEq hev
    · subst ht
      have h1 : HasDerivWithinAt (fun s : ℝ => (max s 0) ^ 2) 0 (Set.Iic 0) 0 := by
        refine (hasDerivWithinAt_const (0:ℝ) (Set.Iic 0) (0:ℝ)).congr ?_ ?_
        · intro x hx
          rw [max_eq_right (Set.mem_Iic.mp hx)]; norm_num
        · norm_num
      have h2 : HasDerivWithinAt (fun s : ℝ => (max s 0) ^ 2) 0 (Set.Ici 0) 0 := by
        have h : HasDerivAt (fun s : ℝ => s ^ 2) 0 0 := by
          simpa using hasDerivAt_pow 2 (0:ℝ)
        refine h.hasDerivWithinAt.congr ?_ ?_
        · intro x hx
          rw [max_eq_left (Set.mem_Ici.mp hx)]
        · simp
      have h3 := h1.union h2
      rw [Set.Iic_union_Ici, hasDerivWithinAt_univ] at h3
      convert h3 using 1
      simp
    · have hev : (fun s : ℝ => (max s 0) ^ 2) =ᶠ[nhds t] (fun s => s ^ 2) := by
        filter_upwards [eventually_gt_nhds ht] with s hs
        rw [max_eq_left hs.le]
      rw [max_eq_left ht.le]
      have h : HasDerivAt (fun s : ℝ => s ^ 2) (2 * t) t := by
        simpa using hasDerivAt_pow 2 t
      exact h.congr_of_eventuallyEq hev
  
  obtain ⟨S, hSdef⟩ : ∃ S : ℝ → ℝ, S = fun t => 1 - 2 * (max t 0) ^ 2
      + 4 * (max (t - 1/2) 0) ^ 2 - 2 * (max (t - 1) 0) ^ 2 := ⟨_, rfl⟩
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ → ℝ, D = fun t => -4 * max t 0 + 8 * max (t - 1/2) 0
      - 4 * max (t - 1) 0 := ⟨_, rfl⟩
  
  have hS : ∀ t : ℝ, HasDerivAt S (D t) t := by
    intro t
    have h0 := hq t
    have h1 := (hq (t - 1/2)).comp_sub_const t (1/2)
    have h2 := (hq (t - 1)).comp_sub_const t 1
    have h := (((h0.const_mul 2).const_sub 1).add (h1.const_mul 4)).sub (h2.const_mul 2)
    rw [hSdef, hDdef]
    convert h using 1
    ring
  have hderiv : deriv S = D := funext fun t => (hS t).deriv
  
  have hb : ∀ t : ℝ, 0 ≤ S t ∧ S t ≤ 1 ∧ D t ^ 2 ≤ 9 * S t := by
    intro t
    simp only [hSdef, hDdef]
    rcases le_or_gt t 0 with h1 | h1
    · rw [max_eq_right h1, max_eq_right (by linarith : t - 1/2 ≤ 0),
        max_eq_right (by linarith : t - 1 ≤ 0)]
      norm_num
    rcases le_or_gt t (1/2) with h2 | h2
    · rw [max_eq_left h1.le, max_eq_right (by linarith : t - 1/2 ≤ 0),
        max_eq_right (by linarith : t - 1 ≤ 0)]
      have ht2 : t ^ 2 ≤ 1/4 := by
        nlinarith [mul_nonneg h1.le (by linarith : (0:ℝ) ≤ 1/2 - t)]
      refine ⟨by nlinarith, by nlinarith [sq_nonneg t], by nlinarith⟩
    rcases le_or_gt t 1 with h3 | h3
    · rw [max_eq_left h1.le, max_eq_left (by linarith : (0:ℝ) ≤ t - 1/2),
        max_eq_right (by linarith : t - 1 ≤ 0)]
      have hw : (1 - t) ^ 2 ≤ 1/4 := by
        nlinarith [mul_nonneg (sub_nonneg.2 h3) (by linarith : (0:ℝ) ≤ t - 1/2)]
      refine ⟨by nlinarith [sq_nonneg (1 - t)], by nlinarith [sq_nonneg (1 - t)],
        by nlinarith [sq_nonneg (1 - t)]⟩
    · rw [max_eq_left h1.le, max_eq_left (by linarith : (0:ℝ) ≤ t - 1/2),
        max_eq_left (by linarith : (0:ℝ) ≤ t - 1)]
      refine ⟨by nlinarith, by nlinarith, by nlinarith⟩
  refine ⟨S, ?_, ?_, ?_, fun t => ⟨(hb t).1, (hb t).2.1⟩, ?_⟩
  · 
    rw [contDiff_one_iff_deriv]
    refine ⟨fun t => (hS t).differentiableAt, ?_⟩
    rw [hderiv, hDdef]
    exact ((continuous_const.mul (continuous_id.max continuous_const)).add
      (continuous_const.mul ((continuous_id.sub continuous_const).max continuous_const))).sub
      (continuous_const.mul ((continuous_id.sub continuous_const).max continuous_const))
  · 
    intro t ht
    simp only [hSdef]
    rw [max_eq_right ht, max_eq_right (by linarith : t - 1/2 ≤ 0),
      max_eq_right (by linarith : t - 1 ≤ 0)]
    norm_num
  · 
    intro t ht
    simp only [hSdef]
    rw [max_eq_left (by linarith : (0:ℝ) ≤ t), max_eq_left (by linarith : (0:ℝ) ≤ t - 1/2),
      max_eq_left (by linarith : (0:ℝ) ≤ t - 1)]
    ring
  · intro t
    rw [hderiv]
    exact (hb t).2.2

theorem log_step_weight (N : ℕ) (r₁ : ℝ) (S : ℝ → ℝ) (hN : 1 ≤ N) (hr₁ : 0 < r₁) (hS : ContDiff ℝ 1 S) (hS0 : ∀ t : ℝ, t ≤ 0 → S t = 1) (hS1 : ∀ t : ℝ, 1 ≤ t → S t = 0) (hSb : ∀ t : ℝ, 0 ≤ S t ∧ S t ≤ 1) (hS' : ∀ t : ℝ, deriv S t ^ 2 ≤ 9 * S t) : ∃ Ψ : E2 → ℝ, ContDiff ℝ 1 Ψ ∧ (∀ x, 0 ≤ Ψ x ∧ Ψ x ≤ 1) ∧ (∀ x : E2, ‖x‖ ≤ r₁ → Ψ x = 1) ∧ (∀ x : E2, 2 ^ N * r₁ ≤ ‖x‖ → Ψ x = 0) ∧ ∀ x : E2, ∃ c : ℝ, (∀ i : Fin 2, pd2 i Ψ x = c * x i) ∧ (N * Real.log 2) ^ 2 * c ^ 2 * ‖x‖ ^ 4 ≤ 9 * Ψ x ∧ (‖x‖ < r₁ → c = 0) :=
by
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hl2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hΛ : 0 < (N : ℝ) * Real.log 2 := by positivity
  have h2Λ : 0 < 2 * ((N : ℝ) * Real.log 2) := by positivity
  have hr2 : 0 < r₁ ^ 2 := by positivity
  
  have hT1 : ∀ x : E2, ‖x‖ ≤ r₁ →
      Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)) ≤ 0 := by
    intro x hx
    have h1 : ‖x‖ ^ 2 ≤ r₁ ^ 2 := pow_le_pow_left₀ (norm_nonneg x) hx 2
    have h2 : ‖x‖ ^ 2 / r₁ ^ 2 ≤ 1 := (div_le_one hr2).mpr h1
    have h3 : 0 ≤ ‖x‖ ^ 2 / r₁ ^ 2 := by positivity
    exact div_nonpos_of_nonpos_of_nonneg (Real.log_nonpos h3 h2) h2Λ.le
  have hT2 : ∀ x : E2, 2 ^ N * r₁ ≤ ‖x‖ →
      1 ≤ Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)) := by
    intro x hx
    have h1 : (2 ^ N * r₁) ^ 2 ≤ ‖x‖ ^ 2 := pow_le_pow_left₀ (by positivity) hx 2
    have h2 : ((2 : ℝ) ^ N) ^ 2 ≤ ‖x‖ ^ 2 / r₁ ^ 2 := by
      rw [le_div_iff₀ hr2]
      rw [mul_pow] at h1
      exact h1
    have h3 := Real.log_le_log (by positivity) h2
    have h4 : Real.log (((2 : ℝ) ^ N) ^ 2) = 2 * ((N : ℝ) * Real.log 2) := by
      rw [Real.log_pow, Real.log_pow]
      push_cast
      ring
    rw [h4] at h3
    rw [le_div_iff₀ h2Λ, one_mul]
    exact h3
  
  have hloc : ∀ x : E2, ‖x‖ < r₁ →
      (fun y : E2 => S (Real.log (‖y‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))))
        =ᶠ[𝓝 x] fun _ => (1 : ℝ) := by
    intro x hx
    have hmem : Metric.ball (0 : E2) r₁ ∈ 𝓝 x :=
      Metric.isOpen_ball.mem_nhds (mem_ball_zero_iff.mpr hx)
    exact Filter.eventually_of_mem hmem
      (fun y hy => hS0 _ (hT1 y (le_of_lt (mem_ball_zero_iff.mp hy))))
  
  have hcd : ∀ x : E2, x ≠ 0 → ContDiffAt ℝ 1
      (fun y : E2 => S (Real.log (‖y‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)))) x := by
    intro x hx
    have hne : ‖x‖ ^ 2 / r₁ ^ 2 ≠ 0 :=
      div_ne_zero (pow_ne_zero 2 (norm_ne_zero_iff.mpr hx)) hr2.ne'
    have C1 : ContDiffAt ℝ 1 (fun y : E2 => ‖y‖ ^ 2 / r₁ ^ 2) x :=
      ((contDiff_norm_sq ℝ).contDiffAt).div_const _
    have C2 : ContDiffAt ℝ 1 Real.log (‖x‖ ^ 2 / r₁ ^ 2) := Real.contDiffAt_log.mpr hne
    have C3 := (C2.comp x C1).div_const (2 * ((N : ℝ) * Real.log 2))
    exact hS.contDiffAt.comp x C3
  
  have hpd : ∀ x : E2, x ≠ 0 → ∀ i : Fin 2,
      pd2 i (fun y : E2 => S (Real.log (‖y‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)))) x =
        deriv S (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))) /
          (((N : ℝ) * Real.log 2) * ‖x‖ ^ 2) * x i := by
    intro x hx i
    have hxn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    have ht0 : ‖x‖ ^ 2 ≠ 0 := pow_ne_zero 2 hxn
    have hne : ‖x‖ ^ 2 / r₁ ^ 2 ≠ 0 := div_ne_zero ht0 hr2.ne'
    have D1 : HasDerivAt (fun t : ℝ => t / r₁ ^ 2) (1 / r₁ ^ 2) (‖x‖ ^ 2) :=
      (hasDerivAt_id' _).div_const _
    have D2 := (D1.log hne).div_const (2 * ((N : ℝ) * Real.log 2))
    have D4 := ((hS.differentiable one_ne_zero)
      (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)))).hasDerivAt.comp (‖x‖ ^ 2) D2
    have D5 := (hasStrictFDerivAt_norm_sq x).hasFDerivAt
    have D6 := D4.comp_hasFDerivAt x D5
    have D7 : fderiv ℝ
        (fun y : E2 => S (Real.log (‖y‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)))) x = _ :=
      D6.fderiv
    unfold pd2
    rw [D7]
    simp only [ContinuousLinearMap.smul_apply, innerSL_apply_apply, smul_eq_mul, e2,
      EuclideanSpace.inner_single_right]
    simp
    field_simp
  refine ⟨fun y : E2 => S (Real.log (‖y‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))),
    ?_, fun x => hSb _, fun x hx => hS0 _ (hT1 x hx), fun x hx => hS1 _ (hT2 x hx), ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro x
    by_cases h : ‖x‖ < r₁
    · exact contDiffAt_const.congr_of_eventuallyEq (hloc x h)
    · have hx : x ≠ 0 := norm_pos_iff.mp (lt_of_lt_of_le hr₁ (not_lt.mp h))
      exact hcd x hx
  · intro x
    by_cases h : ‖x‖ < r₁
    · refine ⟨0, fun i => ?_, ?_, fun _ => rfl⟩
      · unfold pd2
        rw [(hloc x h).fderiv_eq]
        simp
      · have := (hSb (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2)))).1
        simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, zero_mul]
        linarith
    · have hx : x ≠ 0 := norm_pos_iff.mp (lt_of_lt_of_le hr₁ (not_lt.mp h))
      have hxn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
      refine ⟨deriv S (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))) /
          (((N : ℝ) * Real.log 2) * ‖x‖ ^ 2), hpd x hx, ?_, fun h' => absurd h' h⟩
      have key : ((N : ℝ) * Real.log 2) ^ 2 *
          (deriv S (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))) /
            (((N : ℝ) * Real.log 2) * ‖x‖ ^ 2)) ^ 2 * ‖x‖ ^ 4 =
          deriv S (Real.log (‖x‖ ^ 2 / r₁ ^ 2) / (2 * ((N : ℝ) * Real.log 2))) ^ 2 := by
        field_simp
      rw [key]
      exact hS' _

theorem log_step_theta_integral (N : ℕ) (r₁ ρ : ℝ) (u : E2 → ℝ) (hN : 1 ≤ N) (hr₁ : 0 < r₁) (hρ : 2 ^ N * r₁ < ρ) (hu : ContinuousOn u (Metric.ball 0 ρ)) (harea : ∀ r : ℝ, 0 < r → r ≤ 2 ^ N * r₁ → ∫ x in Metric.ball (0 : E2) r, u x ≤ 4 * Real.pi * r ^ 2) : ∫ x in Metric.ball (0 : E2) ρ, (∑ k ∈ Finset.range N, 9 / (4 * (N * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) * (Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x) * u x ≤ 36 * Real.pi / (N * Real.log 2 ^ 2) :=
by
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hN0 : (N : ℝ) ≠ 0 := by positivity
  have hL2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hL0 : Real.log 2 ≠ 0 := ne_of_gt hL2
  have hrk : ∀ k ∈ Finset.range N,
      (0 : ℝ) < 2 ^ (k + 1) * r₁ ∧ (2 : ℝ) ^ (k + 1) * r₁ ≤ 2 ^ N * r₁ := by
    intro k hk
    have hk' : k + 1 ≤ N := Finset.mem_range.mp hk
    have hpow : (2 : ℝ) ^ (k + 1) ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hk'
    exact ⟨by positivity, mul_le_mul_of_nonneg_right hpow hr₁.le⟩
  have hball : ∀ R : ℝ, R < ρ →
      MeasureTheory.IntegrableOn
        (fun x => (Metric.ball (0 : E2) R).indicator (fun _ => (1 : ℝ)) x * u x)
        (Metric.ball (0 : E2) ρ) ∧
      ∫ x in Metric.ball (0 : E2) ρ,
          (Metric.ball (0 : E2) R).indicator (fun _ => (1 : ℝ)) x * u x
        = ∫ x in Metric.ball (0 : E2) R, u x := by
    intro R hR
    have hfun : (fun x => (Metric.ball (0 : E2) R).indicator (fun _ => (1 : ℝ)) x * u x) =
        (Metric.ball (0 : E2) R).indicator u := by
      funext x
      by_cases hx : x ∈ Metric.ball (0 : E2) R
      · simp [Set.indicator_of_mem hx]
      · simp [Set.indicator_of_notMem hx]
    rw [hfun]
    have hint : MeasureTheory.IntegrableOn u (Metric.closedBall (0 : E2) R) :=
      ContinuousOn.integrableOn_compact (isCompact_closedBall 0 R)
        (hu.mono (Metric.closedBall_subset_ball hR))
    have hint2 : MeasureTheory.IntegrableOn u (Metric.ball (0 : E2) R) :=
      hint.mono_set Metric.ball_subset_closedBall
    refine ⟨(hint2.integrable_indicator measurableSet_ball).integrableOn, ?_⟩
    rw [MeasureTheory.setIntegral_indicator measurableSet_ball,
      Set.inter_eq_right.mpr (Metric.ball_subset_ball hR.le)]
  have hrw : (fun x => (∑ k ∈ Finset.range N, 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
        (Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x) * u x) =
      fun x => ∑ k ∈ Finset.range N, 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
        ((Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x * u x) := by
    funext x
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun k _ => mul_assoc _ _ _)
  rw [hrw, MeasureTheory.integral_finset_sum]
  · calc ∑ k ∈ Finset.range N, ∫ x in Metric.ball (0 : E2) ρ,
          9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
            ((Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x * u x)
        ≤ ∑ k ∈ Finset.range N, 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
            (4 * Real.pi * (2 ^ (k + 1) * r₁) ^ 2) := by
          refine Finset.sum_le_sum (fun k hk => ?_)
          obtain ⟨h0, hle⟩ := hrk k hk
          rw [MeasureTheory.integral_const_mul, (hball _ (lt_of_le_of_lt hle hρ)).2]
          exact mul_le_mul_of_nonneg_left (harea _ h0 hle) (by positivity)
      _ = ∑ k ∈ Finset.range N, 36 * Real.pi / ((N : ℝ) * Real.log 2) ^ 2 := by
          refine Finset.sum_congr rfl (fun k _ => ?_)
          have h4 : (4 : ℝ) ^ k = (2 ^ k) ^ 2 := by
            rw [sq, ← mul_pow]; norm_num
          have e : ((2 : ℝ) ^ (k + 1) * r₁) ^ 2 = 4 * (4 ^ k * r₁ ^ 2) := by
            rw [h4]; ring
          have hk0 : (4 : ℝ) ^ k * r₁ ^ 2 ≠ 0 := by positivity
          rw [e]
          field_simp
          ring
      _ = 36 * Real.pi / (N * Real.log 2 ^ 2) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          field_simp
  · intro k hk
    exact MeasureTheory.Integrable.const_mul (hball _ (lt_of_le_of_lt (hrk k hk).2 hρ)).1 _

theorem log_step_lower (r₁ R ρ ε : ℝ) (Ψ u a b : E2 → ℝ) (hr₁ : 0 < r₁) (hr₁R : r₁ ≤ R) (hRρ : R < ρ) (hε : 0 ≤ ε) (hΨ : Continuous Ψ) (hΨb : ∀ x, 0 ≤ Ψ x ∧ Ψ x ≤ 1) (hΨ1 : ∀ x : E2, ‖x‖ ≤ r₁ → Ψ x = 1) (hΨ0 : ∀ x : E2, R ≤ ‖x‖ → Ψ x = 0) (hu : ContinuousOn u (Metric.ball 0 ρ)) (hu0 : ∀ x, 0 ≤ u x) (ha : ContinuousOn a (Metric.ball 0 ρ)) (hb : ContinuousOn b (Metric.ball 0 ρ)) (hpt : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 ≤ a x ∧ -ε ≤ b x) (hA : ∫ x in Metric.ball (0 : E2) R, u x ≤ 4 * Real.pi * R ^ 2) : (∫ x in Metric.ball (0 : E2) r₁, a x * u x) - 4 * Real.pi * ε * R ^ 2 ≤ ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * u x :=
by
  have hKD : Metric.closedBall (0 : E2) R ⊆ Metric.ball 0 ρ := Metric.closedBall_subset_ball hRρ
  have hC1D : Metric.closedBall (0 : E2) r₁ ⊆ Metric.ball 0 ρ :=
    Metric.closedBall_subset_ball (lt_of_le_of_lt hr₁R hRρ)
  have hB1R : Metric.ball (0 : E2) r₁ ⊆ Metric.ball 0 R := Metric.ball_subset_ball hr₁R
  have hBRD : Metric.ball (0 : E2) R ⊆ Metric.ball 0 ρ := Metric.ball_subset_ball hRρ.le
  have hB1D : Metric.ball (0 : E2) r₁ ⊆ Metric.ball 0 ρ := hB1R.trans hBRD
  have I1 : MeasureTheory.IntegrableOn (fun x => a x * u x) (Metric.ball (0 : E2) r₁) :=
    (((ha.mul hu).mono hC1D).integrableOn_compact (isCompact_closedBall 0 r₁)).mono_set
      Metric.ball_subset_closedBall
  have I2 : MeasureTheory.IntegrableOn u (Metric.ball (0 : E2) R) :=
    ((hu.mono hKD).integrableOn_compact (isCompact_closedBall 0 R)).mono_set
      Metric.ball_subset_closedBall
  have I3 : MeasureTheory.IntegrableOn (fun x => (a x + b x) * Ψ x * u x)
      (Metric.closedBall (0 : E2) R) :=
    ((((ha.add hb).mul hΨ.continuousOn).mul hu).mono hKD).integrableOn_compact
      (isCompact_closedBall 0 R)
  have IF : MeasureTheory.IntegrableOn (fun x => (a x + b x) * Ψ x * u x)
      (Metric.ball (0 : E2) ρ) := by
    refine I3.of_forall_diff_eq_zero measurableSet_ball ?_
    intro x hx
    have hx2 : ¬ ‖x‖ ≤ R := by
      intro h; exact hx.2 (mem_closedBall_zero_iff.mpr h)
    rw [hΨ0 x (le_of_lt (not_le.mp hx2))]
    ring
  have J1 : MeasureTheory.Integrable
      ((Metric.ball (0 : E2) r₁).indicator (fun x => a x * u x)) :=
    I1.integrable_indicator measurableSet_ball
  have J2 : MeasureTheory.Integrable ((Metric.ball (0 : E2) R).indicator u) :=
    I2.integrable_indicator measurableSet_ball
  have IG : MeasureTheory.IntegrableOn
      (fun x => (Metric.ball (0 : E2) r₁).indicator (fun x => a x * u x) x
        - ε * (Metric.ball (0 : E2) R).indicator u x) (Metric.ball (0 : E2) ρ) :=
    (J1.sub (J2.const_mul ε)).integrableOn
  have hpw : ∀ x ∈ Metric.ball (0 : E2) ρ,
      (Metric.ball (0 : E2) r₁).indicator (fun x => a x * u x) x
        - ε * (Metric.ball (0 : E2) R).indicator u x ≤ (a x + b x) * Ψ x * u x := by
    intro x hx
    obtain ⟨ha0, hb0⟩ := hpt x hx
    have hu0x := hu0 x
    obtain ⟨hΨ0x, hΨ1x⟩ := hΨb x
    by_cases h1 : ‖x‖ < r₁
    · have m1 : x ∈ Metric.ball (0 : E2) r₁ := mem_ball_zero_iff.mpr h1
      have m2 : x ∈ Metric.ball (0 : E2) R := mem_ball_zero_iff.mpr (lt_of_lt_of_le h1 hr₁R)
      rw [Set.indicator_of_mem m1, Set.indicator_of_mem m2, hΨ1 x h1.le]
      nlinarith [mul_nonneg (by linarith : 0 ≤ b x + ε) hu0x]
    · have m1 : x ∉ Metric.ball (0 : E2) r₁ := fun h => h1 (mem_ball_zero_iff.mp h)
      rw [Set.indicator_of_notMem m1]
      by_cases h2 : ‖x‖ < R
      · have m2 : x ∈ Metric.ball (0 : E2) R := mem_ball_zero_iff.mpr h2
        rw [Set.indicator_of_mem m2]
        have hp0 : 0 ≤ Ψ x * u x := mul_nonneg hΨ0x hu0x
        have hpu : Ψ x * u x ≤ u x := mul_le_of_le_one_left hu0x hΨ1x
        have e : (a x + b x) * Ψ x * u x = a x * (Ψ x * u x) + b x * (Ψ x * u x) := by ring
        rw [e]
        nlinarith [mul_nonneg ha0 hp0, mul_nonneg (by linarith : 0 ≤ b x + ε) hp0,
          mul_nonneg hε (by linarith : 0 ≤ u x - Ψ x * u x)]
      · have m2 : x ∉ Metric.ball (0 : E2) R := fun h => h2 (mem_ball_zero_iff.mp h)
        rw [Set.indicator_of_notMem m2, hΨ0 x (not_lt.mp h2)]
        simp
  have hM := MeasureTheory.setIntegral_mono_on IG IF measurableSet_ball hpw
  have hG : ∫ x in Metric.ball (0 : E2) ρ,
      ((Metric.ball (0 : E2) r₁).indicator (fun x => a x * u x) x
        - ε * (Metric.ball (0 : E2) R).indicator u x)
      = (∫ x in Metric.ball (0 : E2) r₁, a x * u x) - ε * ∫ x in Metric.ball (0 : E2) R, u x := by
    rw [MeasureTheory.integral_sub J1.integrableOn (J2.const_mul ε).integrableOn,
      MeasureTheory.integral_const_mul,
      MeasureTheory.setIntegral_indicator measurableSet_ball,
      MeasureTheory.setIntegral_indicator measurableSet_ball,
      Set.inter_eq_right.mpr hB1D, Set.inter_eq_right.mpr hBRD]
  have hεA : ε * ∫ x in Metric.ball (0 : E2) R, u x ≤ 4 * Real.pi * ε * R ^ 2 := by
    have := mul_le_mul_of_nonneg_left hA hε
    linarith
  linarith

theorem normal_form_inv_quad (A : Matrix (Fin 2) (Fin 2) ℝ) (x : E2) (c : ℝ) (hA : A.PosDef) (hx : ∀ i : Fin 2, ∑ j : Fin 2, A i j * x j = x i) : ∑ i : Fin 2, ∑ j : Fin 2, A⁻¹ i j * (c * x i) * (c * x j) = c ^ 2 * ‖x‖ ^ 2 :=
by
  have hdet : IsUnit A.det := (hA.det_pos).ne'.isUnit
  have hinv : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hdet
  have hAv : Matrix.mulVec A (fun j => x j) = fun j => x j := by
    funext i
    simp only [Matrix.mulVec, dotProduct]
    exact hx i
  have hv : ∀ i : Fin 2, ∑ j : Fin 2, A⁻¹ i j * x j = x i := by
    intro i
    have h1 : Matrix.mulVec (A⁻¹ * A) (fun j => x j) = fun j => x j := by
      rw [hinv, Matrix.one_mulVec]
    rw [← Matrix.mulVec_mulVec, hAv] at h1
    have h2 := congrFun h1 i
    simpa only [Matrix.mulVec, dotProduct] using h2
  have hn : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
      sq_abs, sq_abs]
  have h0 := hv 0
  have h1 := hv 1
  simp only [Fin.sum_univ_two] at h0 h1 ⊢
  rw [hn]
  linear_combination (c ^ 2 * x 0) * h0 + (c ^ 2 * x 1) * h1

theorem normal_disc_log_step (N : ℕ) (r₁ ρ ε : ℝ) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (a b : E2 → ℝ) (hN : 1 ≤ N) (hr₁ : 0 < r₁) (hρ : 2 ^ N * r₁ < ρ) (hε : 0 ≤ ε) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 ρ)) (hnf : ∀ x ∈ Metric.ball (0 : E2) ρ, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (ha : ContinuousOn a (Metric.ball 0 ρ)) (hb : ContinuousOn b (Metric.ball 0 ρ)) (hpt : ∀ x ∈ Metric.ball (0 : E2) ρ, 0 ≤ a x ∧ -ε ≤ b x) (harea : ∀ r : ℝ, 0 < r → r ≤ 2 ^ N * r₁ → ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det ≤ 4 * Real.pi * r ^ 2) (hstab : ∀ (r M : ℝ) (Ψ Θ : E2 → ℝ), 0 < r → r < ρ → ContDiff ℝ 1 Ψ → (∀ x, 0 ≤ Ψ x) → (∀ x : E2, r ≤ ‖x‖ → Ψ x = 0) → Measurable Θ → (∀ x, 0 ≤ Θ x ∧ Θ x ≤ M) → (∀ x : E2, r ≤ ‖x‖ → Θ x = 0) → (∀ x ∈ Metric.ball (0 : E2) ρ, ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x ≤ 4 * Ψ x * Θ x) → ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * Real.sqrt (h x).det ≤ ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det) : ∫ x in Metric.ball (0 : E2) r₁, a x * Real.sqrt (h x).det ≤ 36 * Real.pi / (N * Real.log 2 ^ 2) + 4 * Real.pi * ε * (2 ^ N * r₁) ^ 2 :=
by
  
  obtain ⟨S, hSC, hS0, hS1, hSb, hS'⟩ := log_step_profile
  obtain ⟨Ψ, hΨC, hΨb, hΨ1, hΨ0, hΨg⟩ := log_step_weight N r₁ S hN hr₁ hSC hS0 hS1 hSb hS'
  
  have hNr : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hL2 : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hΛ : 0 < (N : ℝ) * Real.log 2 := by positivity
  have hP1 : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
  have hR0 : (0 : ℝ) < 2 ^ N * r₁ := by positivity
  have hr₁R : r₁ ≤ 2 ^ N * r₁ := by nlinarith
  
  have hu : ContinuousOn (fun x => Real.sqrt (h x).det) (Metric.ball 0 ρ) := by
    have hc : ∀ i j : Fin 2, ContinuousOn (fun x => h x i j) (Metric.ball 0 ρ) :=
      fun i j => (hh i j).continuousOn
    have hdet : (fun x => Real.sqrt (h x).det) =
        fun x => Real.sqrt (h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0) := by
      funext x
      rw [Matrix.det_fin_two]
    rw [hdet]
    exact Real.continuous_sqrt.comp_continuousOn
      (((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0)))
  
  have hck : ∀ k : ℕ, 0 ≤ 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) :=
    fun k => by positivity
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : E2 → ℝ, Θ = fun x => ∑ k ∈ Finset.range N,
      9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
        (Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x := ⟨_, rfl⟩
  have hΘm : Measurable Θ := by
    rw [hΘ]
    exact Finset.measurable_sum _
      (fun k _ => measurable_const.mul (measurable_const.indicator measurableSet_ball))
  have hΘb : ∀ x, 0 ≤ Θ x ∧ Θ x ≤ ∑ k ∈ Finset.range N,
      9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) := by
    intro x
    simp only [hΘ]
    constructor
    · refine Finset.sum_nonneg (fun k _ => ?_)
      by_cases hxk : x ∈ Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)
      · simpa [hxk] using hck k
      · simp [hxk]
    · refine Finset.sum_le_sum (fun k _ => ?_)
      by_cases hxk : x ∈ Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)
      · simp [hxk]
      · simpa [hxk] using hck k
  have hΘ0 : ∀ x : E2, 2 ^ N * r₁ ≤ ‖x‖ → Θ x = 0 := by
    intro x hx
    simp only [hΘ]
    refine Finset.sum_eq_zero (fun k hk => ?_)
    have hk' : k + 1 ≤ N := Finset.mem_range.mp hk
    have hpow : (2 : ℝ) ^ (k + 1) ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hk'
    have hle : (2 : ℝ) ^ (k + 1) * r₁ ≤ 2 ^ N * r₁ := by nlinarith
    have hnot : x ∉ Metric.ball (0 : E2) (2 ^ (k + 1) * r₁) := by
      rw [mem_ball_zero_iff]
      linarith
    simp [Set.indicator_apply, hnot]
  
  have hdom : ∀ x : E2, r₁ ≤ ‖x‖ → ‖x‖ < 2 ^ N * r₁ →
      9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2) ≤ Θ x := by
    intro x h1 h2
    have hx1 : 1 ≤ ‖x‖ / r₁ := by rw [le_div_iff₀ hr₁]; linarith
    obtain ⟨n, hn1, hn2⟩ := exists_nat_pow_near hx1 (one_lt_two : (1 : ℝ) < 2)
    have hn1' : 2 ^ n * r₁ ≤ ‖x‖ := by rwa [le_div_iff₀ hr₁] at hn1
    have hn2' : ‖x‖ < 2 ^ (n + 1) * r₁ := by rwa [div_lt_iff₀ hr₁] at hn2
    have hnN : n < N := by
      have h3 : (2 : ℝ) ^ n < 2 ^ N := by
        have : (2 : ℝ) ^ n * r₁ < 2 ^ N * r₁ := lt_of_le_of_lt hn1' h2
        exact lt_of_mul_lt_mul_right this hr₁.le
      exact (pow_lt_pow_iff_right₀ (by norm_num : (1 : ℝ) < 2)).mp h3
    have hmem : x ∈ Metric.ball (0 : E2) (2 ^ (n + 1) * r₁) := by
      rw [mem_ball_zero_iff]; exact hn2'
    have hterm : 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ n * r₁ ^ 2)) *
        (Metric.ball (0 : E2) (2 ^ (n + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x =
        9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ n * r₁ ^ 2)) := by
      simp [Set.indicator_apply, hmem]
    have h4 : (4 : ℝ) ^ n * r₁ ^ 2 ≤ ‖x‖ ^ 2 := by
      have e : (4 : ℝ) ^ n * r₁ ^ 2 = (2 ^ n * r₁) ^ 2 := by
        rw [mul_pow, ← pow_mul, mul_comm n 2, pow_mul]; norm_num
      rw [e]
      exact pow_le_pow_left₀ (by positivity) hn1' 2
    have h5 : 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2) ≤
        9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ n * r₁ ^ 2)) := by
      apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
      exact mul_le_mul_of_nonneg_left h4 (by positivity)
    rw [← hterm] at h5
    refine le_trans h5 ?_
    simp only [hΘ]
    refine Finset.single_le_sum (f := fun k => 9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2)) *
        (Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)).indicator (fun _ => (1 : ℝ)) x)
      (fun k _ => ?_) (Finset.mem_range.mpr hnN)
    by_cases hxk : x ∈ Metric.ball (0 : E2) (2 ^ (k + 1) * r₁)
    · simpa [hxk] using hck k
    · simp [hxk]
  
  have hgrad : ∀ x ∈ Metric.ball (0 : E2) ρ, ∑ i : Fin 2, ∑ j : Fin 2,
      (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x ≤ 4 * Ψ x * Θ x := by
    intro x hx
    obtain ⟨c, hc, hcb, hc0⟩ := hΨg x
    have hq : ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i Ψ x * pd2 j Ψ x =
        c ^ 2 * ‖x‖ ^ 2 := by
      simp only [hc]
      exact normal_form_inv_quad (h x) x c (hnf x hx).1 (hnf x hx).2
    rw [hq]
    have hΨx := hΨb x
    have hΘx := hΘb x
    have hRHS : 0 ≤ 4 * Ψ x * Θ x := by
      have := hΨx.1; have := hΘx.1; positivity
    rcases lt_or_ge ‖x‖ r₁ with h1 | h1
    · rw [hc0 h1]; simpa using hRHS
    rcases le_or_gt (2 ^ N * r₁) ‖x‖ with h2 | h2
    · have hz := hΨ0 x h2
      rw [hz] at hcb
      have hxpos : 0 < ‖x‖ := by linarith
      have hle : c ^ 2 * ‖x‖ ^ 2 ≤ 0 := by
        by_contra hneg
        push_neg at hneg
        have hpos : 0 < ((N : ℝ) * Real.log 2) ^ 2 * (c ^ 2 * ‖x‖ ^ 2) * ‖x‖ ^ 2 := by
          positivity
        have e : ((N : ℝ) * Real.log 2) ^ 2 * c ^ 2 * ‖x‖ ^ 4 =
            ((N : ℝ) * Real.log 2) ^ 2 * (c ^ 2 * ‖x‖ ^ 2) * ‖x‖ ^ 2 := by ring
        linarith
      linarith
    · have hT := hdom x h1 h2
      have hxpos : 0 < ‖x‖ := by linarith
      have hA : 0 < ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2 := by positivity
      have e1 : 4 * Ψ x * (9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2)) =
          9 * Ψ x / (((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2) := by
        field_simp <;> ring
      have h3 : c ^ 2 * ‖x‖ ^ 2 ≤ 4 * Ψ x * (9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2)) := by
        rw [e1, le_div_iff₀ hA]
        have e2 : c ^ 2 * ‖x‖ ^ 2 * (((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2) =
            ((N : ℝ) * Real.log 2) ^ 2 * c ^ 2 * ‖x‖ ^ 4 := by ring
        rw [e2]
        exact hcb
      have h4 : 4 * Ψ x * (9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * ‖x‖ ^ 2)) ≤ 4 * Ψ x * Θ x :=
        mul_le_mul_of_nonneg_left hT (by linarith [hΨx.1])
      linarith
  
  have hS := hstab (2 ^ N * r₁) (∑ k ∈ Finset.range N,
      9 / (4 * ((N : ℝ) * Real.log 2) ^ 2 * (4 ^ k * r₁ ^ 2))) Ψ Θ hR0 hρ hΨC
    (fun x => (hΨb x).1) hΨ0 hΘm hΘb hΘ0 hgrad
  
  have hI : ∫ x in Metric.ball (0 : E2) ρ, Θ x * Real.sqrt (h x).det ≤
      36 * Real.pi / (N * Real.log 2 ^ 2) := by
    rw [hΘ]
    exact log_step_theta_integral N r₁ ρ (fun x => Real.sqrt (h x).det) hN hr₁ hρ hu harea
  
  have hL : (∫ x in Metric.ball (0 : E2) r₁, a x * Real.sqrt (h x).det) -
      4 * Real.pi * ε * (2 ^ N * r₁) ^ 2 ≤
      ∫ x in Metric.ball (0 : E2) ρ, (a x + b x) * Ψ x * Real.sqrt (h x).det :=
    log_step_lower r₁ (2 ^ N * r₁) ρ ε Ψ (fun x => Real.sqrt (h x).det) a b hr₁ hr₁R hρ hε
      hΨC.continuous hΨb hΨ1 hΨ0 hu (fun x => Real.sqrt_nonneg _) ha hb hpt
      (harea _ hR0 le_rfl)
  
  linarith

theorem normal_disc_log_cutoff (δ : ℝ) (hδ : 0 < δ) : ∃ R₀ ε₀ : ℝ, 2 ≤ R₀ ∧ 0 < ε₀ ∧ ∀ μ : ℝ, 0 < μ → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (a b φ : E2 → ℝ), (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 (R₀ / μ))) → (∀ x ∈ Metric.ball (0 : E2) (R₀ / μ), (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) → ContinuousOn a (Metric.ball 0 (R₀ / μ)) → ContinuousOn b (Metric.ball 0 (R₀ / μ)) → ContDiffOn ℝ 2 φ (Metric.ball 0 (R₀ / μ)) → (∀ x ∈ Metric.ball (0 : E2) (R₀ / μ), 0 ≤ a x ∧ -(a x) / 2 - ε₀ * μ ^ 2 ≤ gaussCurv2 h x ∧ -(ε₀ * μ ^ 2) ≤ b x ∧ 0 < φ x ∧ lap2 h φ x + (a x + b x) * φ x ≤ 0) → ∫ x in Metric.ball (0 : E2) (1 / μ), a x * Real.sqrt (h x).det ≤ δ :=
by
  have hL : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hpi : 0 < Real.pi := Real.pi_pos
  obtain ⟨N, hNdef⟩ : ∃ N : ℕ, N = ⌈72 * Real.pi / (δ * Real.log 2 ^ 2)⌉₊ + 1 := ⟨_, rfl⟩
  have hN1 : 1 ≤ N := by omega
  have hNge : 72 * Real.pi / (δ * Real.log 2 ^ 2) ≤ (N : ℝ) := by
    have hc := Nat.le_ceil (72 * Real.pi / (δ * Real.log 2 ^ 2))
    rw [hNdef]
    push_cast
    linarith
  have hP : (0 : ℝ) < 2 ^ N := by positivity
  obtain ⟨ε₀, hε₀def⟩ : ∃ ε₀ : ℝ,
      ε₀ = min (1 / (3 * ((2 : ℝ) ^ N) ^ 2)) (δ / (8 * Real.pi * ((2 : ℝ) ^ N) ^ 2)) := ⟨_, rfl⟩
  have hε₀pos : 0 < ε₀ := by
    rw [hε₀def]
    exact lt_min (by positivity) (by positivity)
  have hε₀1 : ε₀ ≤ 1 / (3 * ((2 : ℝ) ^ N) ^ 2) := by rw [hε₀def]; exact min_le_left _ _
  have hε₀2 : ε₀ ≤ δ / (8 * Real.pi * ((2 : ℝ) ^ N) ^ 2) := by rw [hε₀def]; exact min_le_right _ _
  have hR : (2 : ℝ) ^ (N + 1) = 2 * 2 ^ N := by rw [pow_succ]; ring
  have hP1 : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
  refine ⟨2 ^ (N + 1), ε₀, ?_, hε₀pos, ?_⟩
  · rw [hR]; linarith
  intro μ hμ h a b φ hh hnf ha hb hφ hpt
  have hρ : (0 : ℝ) < 2 ^ (N + 1) / μ := by positivity
  have hstab := normal_disc_stability (2 ^ (N + 1) / μ) h a b φ hh (fun x hx => (hnf x hx).1)
    ha hb hφ (fun x hx => ⟨(hpt x hx).2.2.2.1, (hpt x hx).2.2.2.2⟩)
  obtain ⟨hK, hGB⟩ := normal_disc_gauss_bonnet (2 ^ (N + 1) / μ) h hρ hh hnf
  have hε : 0 ≤ ε₀ * μ ^ 2 := by positivity
  have harea0 := normal_disc_area_bound (2 ^ (N + 1) / μ) (ε₀ * μ ^ 2) h a b hρ hε hh hnf ha hb
    hK (fun x hx => ⟨(hpt x hx).1, (hpt x hx).2.1, (hpt x hx).2.2.1⟩) hGB hstab
  have hr1 : (0 : ℝ) < 2 ^ N * (1 / μ) := by positivity
  have hlt : (2 : ℝ) ^ N * (1 / μ) < 2 ^ (N + 1) / μ := by
    have e : (2 : ℝ) ^ (N + 1) / μ = 2 * (2 ^ N * (1 / μ)) := by rw [hR]; ring
    rw [e]; linarith
  have e2 : (2 ^ N * (1 / μ)) ^ 2 * μ ^ 2 = ((2 : ℝ) ^ N) ^ 2 := by
    field_simp
  have harea : ∀ r : ℝ, 0 < r → r ≤ 2 ^ N * (1 / μ) →
      ∫ x in Metric.ball (0 : E2) r, Real.sqrt (h x).det ≤ 4 * Real.pi * r ^ 2 := by
    intro r hr hrle
    refine harea0 r hr (lt_of_le_of_lt hrle hlt) ?_
    have hsq : r ^ 2 ≤ (2 ^ N * (1 / μ)) ^ 2 := pow_le_pow_left₀ hr.le hrle 2
    calc 3 * (ε₀ * μ ^ 2) * r ^ 2 ≤ 3 * (ε₀ * μ ^ 2) * (2 ^ N * (1 / μ)) ^ 2 := by gcongr
      _ = 3 * ε₀ * ((2 : ℝ) ^ N) ^ 2 := by rw [← e2]; ring
      _ ≤ 3 * (1 / (3 * ((2 : ℝ) ^ N) ^ 2)) * ((2 : ℝ) ^ N) ^ 2 := by gcongr
      _ = 1 := by field_simp
  have hlog := normal_disc_log_step N (1 / μ) (2 ^ (N + 1) / μ) (ε₀ * μ ^ 2) h a b hN1
    (by positivity) hlt hε hh hnf ha hb (fun x hx => ⟨(hpt x hx).1, (hpt x hx).2.2.1⟩) harea hstab
  refine hlog.trans ?_
  have h1 : 36 * Real.pi / (N * Real.log 2 ^ 2) ≤ δ / 2 := by
    have hpos : 0 < δ * Real.log 2 ^ 2 := by positivity
    have hm := (div_le_iff₀ hpos).mp hNge
    have hNpos : (0 : ℝ) < N * Real.log 2 ^ 2 := by
      have : (1 : ℝ) ≤ N := by exact_mod_cast hN1
      positivity
    rw [div_le_iff₀ hNpos]
    nlinarith
  have h2 : 4 * Real.pi * (ε₀ * μ ^ 2) * (2 ^ N * (1 / μ)) ^ 2 ≤ δ / 2 := by
    calc 4 * Real.pi * (ε₀ * μ ^ 2) * (2 ^ N * (1 / μ)) ^ 2
        = 4 * Real.pi * ε₀ * ((2 : ℝ) ^ N) ^ 2 := by rw [← e2]; ring
      _ ≤ 4 * Real.pi * (δ / (8 * Real.pi * ((2 : ℝ) ^ N) ^ 2)) * ((2 : ℝ) ^ N) ^ 2 := by gcongr
      _ = δ / 2 := by field_simp; ring
  linarith

theorem normal_form_ray_jacobi (R : ℝ) (hR : 0 < R) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 R)) (hnf : ∀ x ∈ Metric.ball (0 : E2) R, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (θ : E2) (hθ : ‖θ‖ = 1) : ContDiffOn ℝ ∞ (fun τ : ℝ => (h (τ • θ)).det) (Set.Ioo (-R) R) ∧ (h 0).det = 1 ∧ ∀ t : ℝ, 0 < t → t < R → 4 * t * (h (t • θ)).det ^ 2 * gaussCurv2 h (t • θ) = t * deriv (fun τ : ℝ => (h (τ • θ)).det) t ^ 2 - 2 * t * (h (t • θ)).det * deriv (deriv (fun τ : ℝ => (h (τ • θ)).det)) t - 4 * (h (t • θ)).det * deriv (fun τ : ℝ => (h (τ • θ)).det) t :=
by
  
  have hchr : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (y : E2), h₁ =ᶠ[𝓝 y] h₂ →
      ∀ k i j : Fin 2, christoffel2 h₁ k i j y = christoffel2 h₂ k i j y := by
    intro h₁ h₂ y hy k i j
    have hpd : ∀ a b c : Fin 2,
        pd2 c (fun z => h₁ z a b) y = pd2 c (fun z => h₂ z a b) y := by
      intro a b c
      have hev : (fun z => h₁ z a b) =ᶠ[𝓝 y] (fun z => h₂ z a b) :=
        hy.mono fun z hz => by simp only [hz]
      unfold pd2
      rw [hev.fderiv_eq]
    simp only [christoffel2, hpd, hy.eq_of_nhds]
  have hloc : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2), h₁ =ᶠ[𝓝 x] h₂ →
      gaussCurv2 h₁ x = gaussCurv2 h₂ x := by
    intro h₁ h₂ x hx
    have hev : ∀ k i j : Fin 2, christoffel2 h₁ k i j =ᶠ[𝓝 x] christoffel2 h₂ k i j :=
      fun k i j => hx.eventuallyEq_nhds.mono fun y hy => hchr h₁ h₂ y hy k i j
    have hpdc : ∀ c k i j : Fin 2,
        pd2 c (christoffel2 h₁ k i j) x = pd2 c (christoffel2 h₂ k i j) x := by
      intro c k i j
      unfold pd2
      rw [(hev k i j).fderiv_eq]
    have hric : ∀ j k : Fin 2, ricci2 h₁ j k x = ricci2 h₂ j k x := by
      intro j k
      simp only [ricci2, hpdc, hchr h₁ h₂ x hx]
    simp only [gaussCurv2, hric, hx.eq_of_nhds]
  
  obtain ⟨hs, hs_def⟩ : ∃ hs : E2 → Matrix (Fin 2) (Fin 2) ℝ,
      ∀ x i j, hs x i j = (h x i j + h x j i) / 2 :=
    ⟨fun x => Matrix.of fun i j => (h x i j + h x j i) / 2, fun x i j => rfl⟩
  have hsym : ∀ (x : E2) (i j : Fin 2), hs x i j = hs x j i := by
    intro x i j
    rw [hs_def, hs_def, add_comm]
  have hsmooth : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => hs x i j) (Metric.ball 0 R) := by
    intro i j
    simp only [hs_def]
    exact ((hh i j).add (hh j i)).div_const 2
  have hagree : ∀ x ∈ Metric.ball (0 : E2) R, hs x = h x := by
    intro x hx
    ext i j
    rw [hs_def]
    have e := (hnf x hx).1.isHermitian.apply i j
    rw [star_trivial] at e
    rw [e]
    ring
  have hnf' : ∀ x ∈ Metric.ball (0 : E2) R,
      (hs x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, hs x i j * x j = x i := by
    intro x hx
    rw [hagree x hx]
    exact hnf x hx
  obtain ⟨q, hq⟩ : ∃ q : ℝ → ℝ, ∀ τ : ℝ, q τ = hs (τ • θ) 0 0 * θ 1 ^ 2 -
      2 * hs (τ • θ) 0 1 * θ 0 * θ 1 + hs (τ • θ) 1 1 * θ 0 ^ 2 := ⟨_, fun _ => rfl⟩
  obtain ⟨hq0, hqdet, hqC, hode⟩ := normal_ray_jacobi R hs hR hsmooth hsym hnf' θ hθ q hq
  have hmem : ∀ τ ∈ Set.Ioo (-R) R, τ • θ ∈ Metric.ball (0 : E2) R := by
    intro τ hτ
    rw [mem_ball_zero_iff, norm_smul, hθ, mul_one, Real.norm_eq_abs]
    exact abs_lt.mpr hτ
  have hDq : ∀ τ ∈ Set.Ioo (-R) R, (h (τ • θ)).det = q τ := by
    intro τ hτ
    rw [← hagree _ (hmem τ hτ), hqdet τ (abs_lt.mpr hτ)]
  refine ⟨hqC.congr (fun τ hτ => hDq τ hτ), ?_, ?_⟩
  · have e := hDq 0 ⟨by linarith, hR⟩
    rw [zero_smul] at e
    rw [e, hq0]
  · intro t ht htR
    have htI : t ∈ Set.Ioo (-R) R := ⟨by linarith, htR⟩
    have hEv : (fun τ : ℝ => (h (τ • θ)).det) =ᶠ[𝓝 t] q :=
      Filter.eventuallyEq_of_mem (isOpen_Ioo.mem_nhds htI) hDq
    have e1 : deriv (fun τ : ℝ => (h (τ • θ)).det) t = deriv q t := hEv.deriv_eq
    have e2 : deriv (deriv (fun τ : ℝ => (h (τ • θ)).det)) t = deriv (deriv q) t :=
      hEv.deriv.deriv_eq
    have e0 : (h (t • θ)).det = q t := hDq t htI
    have e3 : gaussCurv2 h (t • θ) = gaussCurv2 hs (t • θ) :=
      hloc h hs _ (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds (hmem t htI))
        (fun x hx => (hagree x hx).symm))
    rw [e1, e2, e0, e3]
    exact hode t ht htR

theorem jacobi_q_radial_bounds (μ ε : ℝ) (hμ : 0 < μ) (hε : 0 ≤ ε) (q k : ℝ → ℝ) (hq : ContDiffOn ℝ 2 q (Set.Ioo (-(1 / μ)) (1 / μ))) (hq0 : q 0 = 1) (hpos : ∀ τ ∈ Set.Ioo (-(1 / μ)) (1 / μ), 0 < q τ) (hode : ∀ t : ℝ, 0 < t → t < 1 / μ → 4 * t * q t ^ 2 * k t = t * deriv q t ^ 2 - 2 * t * q t * deriv (deriv q) t - 4 * q t * deriv q t) (hk : ∀ t : ℝ, 0 < t → t < 1 / μ → -(μ ^ 2) ≤ k t ∧ k t ≤ ε * μ ^ 2) : (∀ s : ℝ, 0 ≤ s → s < 1 / μ → Real.sqrt (q s) ≤ 2) ∧ ∀ s : ℝ, 0 < s → s < 1 / μ → -(2 / 3) * ε * μ ^ 2 * s ≤ deriv (fun τ : ℝ => Real.sqrt (q τ)) s :=
by
  have hμinv : 0 < 1 / μ := by positivity
  have hIo : IsOpen (Set.Ioo (-(1 / μ)) (1 / μ)) := isOpen_Ioo
  have hmemI : ∀ t : ℝ, 0 ≤ t → t < 1 / μ → t ∈ Set.Ioo (-(1 / μ)) (1 / μ) :=
    fun t h0 h1 => ⟨by linarith, h1⟩
  have hdq : DifferentiableOn ℝ q (Set.Ioo (-(1 / μ)) (1 / μ)) := hq.differentiableOn (by norm_num)
  have hq1 : ContDiffOn ℝ 1 (deriv q) (Set.Ioo (-(1 / μ)) (1 / μ)) :=
    hq.deriv_of_isOpen hIo (by norm_num)
  have hddq : DifferentiableOn ℝ (deriv q) (Set.Ioo (-(1 / μ)) (1 / μ)) :=
    hq1.differentiableOn (by norm_num)
  have hcdq : ContinuousOn (deriv q) (Set.Ioo (-(1 / μ)) (1 / μ)) := hq1.continuousOn
  have hqd : ∀ τ ∈ Set.Ioo (-(1 / μ)) (1 / μ), HasDerivAt q (deriv q τ) τ :=
    fun τ hτ => ((hdq τ hτ).differentiableAt (hIo.mem_nhds hτ)).hasDerivAt
  have hq'd : ∀ τ ∈ Set.Ioo (-(1 / μ)) (1 / μ), HasDerivAt (deriv q) (deriv (deriv q) τ) τ :=
    fun τ hτ => ((hddq τ hτ).differentiableAt (hIo.mem_nhds hτ)).hasDerivAt
  have hS : ∀ τ ∈ Set.Ioo (-(1 / μ)) (1 / μ), 0 < Real.sqrt (q τ) :=
    fun τ hτ => Real.sqrt_pos.mpr (hpos τ hτ)
  have hud : ∀ τ ∈ Set.Ioo (-(1 / μ)) (1 / μ),
      HasDerivAt (fun x : ℝ => Real.sqrt (q x)) (deriv q τ / (2 * Real.sqrt (q τ))) τ :=
    fun τ hτ => (hqd τ hτ).sqrt (hpos τ hτ).ne'
  have huc : ContinuousOn (fun x : ℝ => Real.sqrt (q x)) (Set.Ioo (-(1 / μ)) (1 / μ)) :=
    fun τ hτ => (hud τ hτ).continuousAt.continuousWithinAt
  have hPc : ContinuousOn (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))))
      (Set.Ioo (-(1 / μ)) (1 / μ)) := by
    refine (continuousOn_pow 2).mul (hcdq.div (continuousOn_const.mul huc) ?_)
    intro x hx
    exact mul_ne_zero two_ne_zero (hS x hx).ne'
  
  have hPd : ∀ t : ℝ, 0 < t → t < 1 / μ →
      HasDerivAt (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))))
        (-(k t) * t ^ 2 * Real.sqrt (q t)) t := by
    intro t ht0 ht1
    have htI := hmemI t ht0.le ht1
    have hSt := hS t htI
    have hne : (2 * Real.sqrt (q t)) ≠ 0 := mul_ne_zero two_ne_zero hSt.ne'
    have hp2 : HasDerivAt (fun x : ℝ => x ^ 2) (2 * t) t := by simpa using hasDerivAt_pow 2 t
    have h1 := hp2.mul ((hq'd t htI).div ((hud t htI).const_mul 2) hne)
    refine h1.congr_deriv ?_
    have hS2 : Real.sqrt (q t) ^ 2 = q t := Real.sq_sqrt (hpos t htI).le
    have hode' := hode t ht0 ht1
    rw [← hS2] at hode'
    simp only [Pi.div_apply]
    generalize Real.sqrt (q t) = S at hSt hode' ⊢
    generalize deriv q t = A at hode' ⊢
    generalize deriv (deriv q) t = A' at hode' ⊢
    have hS0 : S ≠ 0 := hSt.ne'
    linear_combination (norm := skip) (t / (4 * S ^ 3)) * hode'
    field_simp
    ring
  
  have hA : ∀ s : ℝ, 0 ≤ s → s < 1 / μ → Real.sqrt (q s) ≤ 6 / 5 := by
    intro s hs0 hs1
    have hKI : Set.Icc 0 s ⊆ Set.Ioo (-(1 / μ)) (1 / μ) :=
      fun t ht => hmemI t ht.1 (lt_of_le_of_lt ht.2 hs1)
    have hint : ∀ t ∈ interior (Set.Icc (0:ℝ) s), 0 < t ∧ t < 1 / μ := by
      intro t ht
      rw [interior_Icc] at ht
      exact ⟨ht.1, lt_trans ht.2 hs1⟩
    have h0K : (0:ℝ) ∈ Set.Icc 0 s := Set.left_mem_Icc.mpr hs0
    obtain ⟨t₀, ht₀K, ht₀max⟩ := isCompact_Icc.exists_isMaxOn ⟨0, h0K⟩ (huc.mono hKI)
    have hmax : ∀ t ∈ Set.Icc 0 s, Real.sqrt (q t) ≤ Real.sqrt (q t₀) := fun t ht => ht₀max ht
    have hu0 : Real.sqrt (q 0) = 1 := by rw [hq0, Real.sqrt_one]
    have hM1 : 1 ≤ Real.sqrt (q t₀) := by
      have := hmax 0 h0K
      rw [hu0] at this
      exact this
    have hstepA : ∀ t ∈ Set.Icc 0 s, t ^ 2 * (deriv q t / (2 * Real.sqrt (q t))) ≤
        μ ^ 2 * Real.sqrt (q t₀) / 3 * t ^ 3 := by
      have hanti : AntitoneOn (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))) -
          μ ^ 2 * Real.sqrt (q t₀) / 3 * x ^ 3) (Set.Icc 0 s) := by
        refine antitoneOn_of_hasDerivWithinAt_nonpos (convex_Icc 0 s)
          ((hPc.mono hKI).sub (continuous_const.mul (continuous_pow 3)).continuousOn)
          (f' := fun t => -(k t) * t ^ 2 * Real.sqrt (q t) -
            μ ^ 2 * Real.sqrt (q t₀) / 3 * (3 * t ^ 2)) ?_ ?_
        · intro t ht
          obtain ⟨ht0, ht1⟩ := hint t ht
          have hp3 : HasDerivAt (fun x : ℝ => x ^ 3) (3 * t ^ 2) t := by
            simpa using hasDerivAt_pow 3 t
          exact ((hPd t ht0 ht1).sub (hp3.const_mul _)).hasDerivWithinAt
        · intro t ht
          obtain ⟨ht0, ht1⟩ := hint t ht
          have htK : t ∈ Set.Icc 0 s := interior_subset ht
          have hkt := (hk t ht0 ht1).1
          have hu := hmax t htK
          have hX : 0 ≤ t ^ 2 * Real.sqrt (q t) := by positivity
          have e1 : -(k t) * (t ^ 2 * Real.sqrt (q t)) ≤ μ ^ 2 * (t ^ 2 * Real.sqrt (q t)) :=
            mul_le_mul_of_nonneg_right (by linarith) hX
          have e2 : μ ^ 2 * t ^ 2 * Real.sqrt (q t) ≤ μ ^ 2 * t ^ 2 * Real.sqrt (q t₀) :=
            mul_le_mul_of_nonneg_left hu (by positivity)
          simp only
          nlinarith
      have hf0 : (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))) -
          μ ^ 2 * Real.sqrt (q t₀) / 3 * x ^ 3) 0 = 0 := by simp
      intro t ht
      have := hanti h0K ht ht.1
      rw [hf0] at this
      simp only at this
      linarith
    have hstepB : Real.sqrt (q t₀) - μ ^ 2 * Real.sqrt (q t₀) / 6 * t₀ ^ 2 ≤ 1 := by
      have hanti : AntitoneOn (fun x : ℝ => Real.sqrt (q x) -
          μ ^ 2 * Real.sqrt (q t₀) / 6 * x ^ 2) (Set.Icc 0 s) := by
        refine antitoneOn_of_hasDerivWithinAt_nonpos (convex_Icc 0 s)
          ((huc.mono hKI).sub (continuous_const.mul (continuous_pow 2)).continuousOn)
          (f' := fun t => deriv q t / (2 * Real.sqrt (q t)) -
            μ ^ 2 * Real.sqrt (q t₀) / 6 * (2 * t)) ?_ ?_
        · intro t ht
          obtain ⟨ht0, ht1⟩ := hint t ht
          have hp2 : HasDerivAt (fun x : ℝ => x ^ 2) (2 * t) t := by
            simpa using hasDerivAt_pow 2 t
          exact ((hud t (hmemI t ht0.le ht1)).sub (hp2.const_mul _)).hasDerivWithinAt
        · intro t ht
          obtain ⟨ht0, ht1⟩ := hint t ht
          have htK : t ∈ Set.Icc 0 s := interior_subset ht
          have h1 := hstepA t htK
          simp only
          have ht2 : 0 < t ^ 2 := by positivity
          by_contra hcon
          push_neg at hcon
          have := mul_pos ht2 hcon
          nlinarith
      have hf0 : (fun x : ℝ => Real.sqrt (q x) - μ ^ 2 * Real.sqrt (q t₀) / 6 * x ^ 2) 0 = 1 := by
        simp [hq0]
      have := hanti h0K ht₀K ht₀K.1
      rw [hf0] at this
      simpa using this
    have hμt : μ * t₀ < 1 := by
      have h := lt_of_le_of_lt ht₀K.2 hs1
      rw [lt_div_iff₀ hμ] at h
      linarith
    have hμt0 : 0 ≤ μ * t₀ := mul_nonneg hμ.le ht₀K.1
    have hsq : μ ^ 2 * t₀ ^ 2 ≤ 1 := by nlinarith
    have hfin : Real.sqrt (q t₀) ≤ 6 / 5 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hsq) (by linarith : (0:ℝ) ≤ Real.sqrt (q t₀))]
    exact le_trans (hmax s (Set.right_mem_Icc.mpr hs0)) hfin
  refine ⟨fun s hs0 hs1 => le_trans (hA s hs0 hs1) (by norm_num), ?_⟩
  
  intro s hs0 hs1
  have hKI : Set.Icc 0 s ⊆ Set.Ioo (-(1 / μ)) (1 / μ) :=
    fun t ht => hmemI t ht.1 (lt_of_le_of_lt ht.2 hs1)
  have hint : ∀ t ∈ interior (Set.Icc (0:ℝ) s), 0 < t ∧ t < 1 / μ := by
    intro t ht
    rw [interior_Icc] at ht
    exact ⟨ht.1, lt_trans ht.2 hs1⟩
  have h0K : (0:ℝ) ∈ Set.Icc 0 s := Set.left_mem_Icc.mpr hs0.le
  have hmono : MonotoneOn (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))) +
      2 / 3 * ε * μ ^ 2 * x ^ 3) (Set.Icc 0 s) := by
    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc 0 s)
      ((hPc.mono hKI).add (continuous_const.mul (continuous_pow 3)).continuousOn)
      (f' := fun t => -(k t) * t ^ 2 * Real.sqrt (q t) + 2 / 3 * ε * μ ^ 2 * (3 * t ^ 2)) ?_ ?_
    · intro t ht
      obtain ⟨ht0, ht1⟩ := hint t ht
      have hp3 : HasDerivAt (fun x : ℝ => x ^ 3) (3 * t ^ 2) t := by
        simpa using hasDerivAt_pow 3 t
      exact ((hPd t ht0 ht1).add (hp3.const_mul _)).hasDerivWithinAt
    · intro t ht
      obtain ⟨ht0, ht1⟩ := hint t ht
      have hkt := (hk t ht0 ht1).2
      have hu2 : Real.sqrt (q t) ≤ 2 := le_trans (hA t ht0.le ht1) (by norm_num)
      have hX0 : 0 ≤ t ^ 2 * Real.sqrt (q t) := by positivity
      have hX2 : t ^ 2 * Real.sqrt (q t) ≤ t ^ 2 * 2 :=
        mul_le_mul_of_nonneg_left hu2 (sq_nonneg t)
      have hεμ : 0 ≤ ε * μ ^ 2 := by positivity
      have e1 : -(ε * μ ^ 2) * (t ^ 2 * Real.sqrt (q t)) ≤ -(k t) * (t ^ 2 * Real.sqrt (q t)) :=
        mul_le_mul_of_nonneg_right (by linarith) hX0
      have e2 : ε * μ ^ 2 * (t ^ 2 * Real.sqrt (q t)) ≤ ε * μ ^ 2 * (t ^ 2 * 2) :=
        mul_le_mul_of_nonneg_left hX2 hεμ
      simp only
      nlinarith
  have hf0 : (fun x : ℝ => x ^ 2 * (deriv q x / (2 * Real.sqrt (q x))) +
      2 / 3 * ε * μ ^ 2 * x ^ 3) 0 = 0 := by simp
  have hsK : s ∈ Set.Icc 0 s := Set.right_mem_Icc.mpr hs0.le
  have h1 := hmono h0K hsK hs0.le
  rw [hf0] at h1
  simp only at h1
  rw [(hud s (hmemI s hs0.le hs1)).deriv]
  have hs2 : 0 < s ^ 2 := by positivity
  by_contra hcon
  push_neg at hcon
  have := mul_pos hs2 (sub_pos.mpr hcon)
  nlinarith

theorem integral_ball_polar_rad (ρ : ℝ) (hρ : 0 < ρ) (f : E2 → ℝ) (hf : ContinuousOn f (Metric.closedBall 0 ρ)) : (∫ x in Metric.ball (0 : E2) ρ, f x) = (∫ s in (0 : ℝ)..ρ, ∫ φ in (-Real.pi)..Real.pi, f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s) ∧ ContinuousOn (fun s : ℝ => ∫ φ in (-Real.pi)..Real.pi, f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s) (Set.Icc 0 ρ) :=
by
  
  have hθn : ∀ φ : ℝ, ‖(Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2)‖ = 1 := by
    intro φ
    have h0 : (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 0 = Real.cos φ := by
      simp [e2, EuclideanSpace.single_apply]
    have h1 : (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2) 1 = Real.sin φ := by
      simp [e2, EuclideanSpace.single_apply]
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two, h0, h1, Real.norm_eq_abs, Real.norm_eq_abs,
      sq_abs, sq_abs, Real.cos_sq_add_sin_sq, Real.sqrt_one]
  have hsn : ∀ s φ : ℝ, ‖s • (Real.cos φ • e2 0 + Real.sin φ • e2 1 : E2)‖ = |s| := by
    intro s φ
    rw [norm_smul, hθn, mul_one, Real.norm_eq_abs]
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  
  have hcont : ContinuousOn (fun s : ℝ => ∫ φ in (-Real.pi)..Real.pi,
      f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s) (Set.Icc 0 ρ) := by
    have hc : Continuous (fun s : ℝ => max 0 (min s ρ)) :=
      continuous_const.max (continuous_id.min continuous_const)
    have hc0 : ∀ s : ℝ, 0 ≤ max 0 (min s ρ) := fun s => le_max_left _ _
    have hcρ : ∀ s : ℝ, max 0 (min s ρ) ≤ ρ := fun s => max_le hρ.le (min_le_right _ _)
    have hQ : Continuous (fun p : ℝ × ℝ =>
        max 0 (min p.1 ρ) • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) :=
      (hc.comp continuous_fst).smul (by fun_prop)
    have hQmem : ∀ p : ℝ × ℝ,
        max 0 (min p.1 ρ) • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1) ∈
          Metric.closedBall (0 : E2) ρ := by
      intro p
      rw [mem_closedBall_zero_iff, hsn, abs_of_nonneg (hc0 _)]
      exact hcρ _
    have hG : Continuous (Function.uncurry (fun (s φ : ℝ) =>
        f (max 0 (min s ρ) • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * max 0 (min s ρ))) :=
      (hf.comp_continuous hQ hQmem).mul (hc.comp continuous_fst)
    have hP := intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (μ := MeasureTheory.volume) hG (-Real.pi) Real.pi
    refine hP.continuousOn.congr ?_
    intro s hs
    have hcs : max 0 (min s ρ) = s := by
      rw [min_eq_left hs.2, max_eq_right hs.1]
    simp only [hcs]
  refine ⟨?_, hcont⟩
  
  have hΦ : MeasurePreserving
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ) volume volume :=
    (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
      (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  have hΦsymm : ∀ a b : ℝ,
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ).symm (a, b) = a • e2 0 + b • e2 1 := by
    intro a b
    have h : ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
        E2 ≃ᵐ ℝ × ℝ) (a • e2 0 + b • e2 1) = (a, b) := by
      simp [MeasurableEquiv.finTwoArrow_apply, e2, EuclideanSpace.single_apply]
    rw [← h, MeasurableEquiv.symm_apply_apply]
  have hpolar : ∀ g : E2 → ℝ, ∫ x, g x = ∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
      p.1 * g (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by
    intro g
    have h1 : ∫ x, g x = ∫ p : ℝ × ℝ, g
        (((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
          E2 ≃ᵐ ℝ × ℝ).symm p) := by
      rw [← hΦ.integral_comp' (fun p => g
        (((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :
          E2 ≃ᵐ ℝ × ℝ).symm p))]
      simp only [MeasurableEquiv.symm_apply_apply]
    rw [h1, ← integral_comp_polarCoord_symm, polarCoord_target]
    refine setIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo) ?_
    intro p _
    simp only [polarCoord_symm_apply, hΦsymm, smul_eq_mul]
    rw [smul_add, smul_smul, smul_smul]
  
  obtain ⟨F, hF⟩ : ∃ F : ℝ × ℝ → ℝ, ∀ p : ℝ × ℝ,
      F p = f (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) * p.1 := ⟨_, fun p => rfl⟩
  have hFc : ContinuousOn F (Set.Icc 0 ρ ×ˢ Set.Icc (-Real.pi) Real.pi) := by
    have hFeq : F = fun p : ℝ × ℝ =>
        f (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) * p.1 := funext hF
    have hP : Continuous (fun p : ℝ × ℝ =>
        p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by fun_prop
    have hmaps : Set.MapsTo (fun p : ℝ × ℝ =>
        p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1))
        (Set.Icc 0 ρ ×ˢ Set.Icc (-Real.pi) Real.pi) (Metric.closedBall 0 ρ) := by
      intro p hp
      rw [mem_closedBall_zero_iff, hsn, abs_of_nonneg hp.1.1]
      exact hp.1.2
    rw [hFeq]
    exact (hf.comp hP.continuousOn hmaps).mul continuous_fst.continuousOn
  have hint : IntegrableOn F (Set.Icc 0 ρ ×ˢ Set.Icc (-Real.pi) Real.pi) :=
    hFc.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  have hμ : (volume : Measure (ℝ × ℝ)).restrict (Set.Ioo 0 ρ ×ˢ Set.Ioo (-Real.pi) Real.pi) =
      ((volume : Measure ℝ).restrict (Set.Ioo 0 ρ)).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-Real.pi) Real.pi)) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint' : Integrable F (((volume : Measure ℝ).restrict (Set.Ioo 0 ρ)).prod
      ((volume : Measure ℝ).restrict (Set.Ioo (-Real.pi) Real.pi))) := by
    rw [← hμ]
    exact hint.mono_set (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
  have hinner : ∀ s : ℝ, ∫ φ in Set.Ioo (-Real.pi) Real.pi, F (s, φ) =
      ∫ φ in (-Real.pi)..Real.pi, f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s := by
    intro s
    rw [intervalIntegral.integral_of_le hpi, integral_Ioc_eq_integral_Ioo]
    simp only [hF]
  have hT : MeasurableSet (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi) :=
    measurableSet_Ioi.prod measurableSet_Ioo
  have hS : MeasurableSet (Set.Ioo (0 : ℝ) ρ ×ˢ Set.Ioo (-Real.pi) Real.pi) :=
    measurableSet_Ioo.prod measurableSet_Ioo
  have hST : Set.Ioo (0 : ℝ) ρ ×ˢ Set.Ioo (-Real.pi) Real.pi ⊆
      Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi :=
    Set.prod_mono Set.Ioo_subset_Ioi_self subset_rfl
  calc ∫ x in Metric.ball (0 : E2) ρ, f x
      = ∫ x, (Metric.ball (0 : E2) ρ).indicator f x :=
        (integral_indicator measurableSet_ball).symm
    _ = ∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
          p.1 * (Metric.ball (0 : E2) ρ).indicator f
            (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := hpolar _
    _ = ∫ p in Set.Ioo (0 : ℝ) ρ ×ˢ Set.Ioo (-Real.pi) Real.pi,
          p.1 * (Metric.ball (0 : E2) ρ).indicator f
            (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) := by
        refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hT hST ?_
        rintro p ⟨⟨hp1, hp2⟩, hpS⟩
        have hp1' : (0 : ℝ) < p.1 := hp1
        have hrp : ρ ≤ p.1 := by
          by_contra hlt
          push_neg at hlt
          exact hpS ⟨⟨hp1', hlt⟩, hp2⟩
        have hnm : p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1) ∉
            Metric.ball (0 : E2) ρ := by
          rw [mem_ball_zero_iff, hsn, abs_of_pos hp1']
          exact not_lt.2 hrp
        rw [Set.indicator_of_notMem hnm, mul_zero]
    _ = ∫ p in Set.Ioo (0 : ℝ) ρ ×ˢ Set.Ioo (-Real.pi) Real.pi, F p := by
        refine setIntegral_congr_fun hS ?_
        rintro p ⟨⟨hp1, hp2⟩, _⟩
        have hm : p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1) ∈
            Metric.ball (0 : E2) ρ := by
          rw [mem_ball_zero_iff, hsn, abs_of_pos hp1]
          exact hp2
        show p.1 * (Metric.ball (0 : E2) ρ).indicator f
          (p.1 • (Real.cos p.2 • e2 0 + Real.sin p.2 • e2 1)) = F p
        rw [Set.indicator_of_mem hm, hF, mul_comm]
    _ = ∫ s in Set.Ioo 0 ρ, ∫ φ in Set.Ioo (-Real.pi) Real.pi, F (s, φ) := by
        rw [hμ]
        exact integral_prod F hint'
    _ = ∫ s in Set.Ioo 0 ρ,
          ∫ φ in (-Real.pi)..Real.pi, f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s := by
        simp only [hinner]
    _ = ∫ s in (0 : ℝ)..ρ,
          ∫ φ in (-Real.pi)..Real.pi, f (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * s := by
        rw [intervalIntegral.integral_of_le hρ.le, integral_Ioc_eq_integral_Ioo]

theorem lap2_divergence_form (U : Set E2) (hU : IsOpen U) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w : E2 → ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) U) (hpd : ∀ x ∈ U, (h x).PosDef) (hw : ContDiffOn ℝ 2 w U) (x : E2) (hx : x ∈ U) : pd2 0 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j w z) x + pd2 1 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j w z) x = Real.sqrt (h x).det * lap2 h w x :=
by
  have hxU : U ∈ 𝓝 x := hU.mem_nhds hx
  have hsymm : ∀ z ∈ U, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have := (hpd z hz).isHermitian.apply j i
    simpa using this
  have hdh : ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x := fun a b =>
    ((hh a b).differentiableOn (by simp)).differentiableAt hxU
  
  have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have padd : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_add hf hg]
    rfl
  have psub : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z - g z) x = pd2 k f x - pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_sub hf hg]
    rfl
  have pneg : ∀ (f : E2 → ℝ) (k : Fin 2), pd2 k (fun z => -f z) x = -pd2 k f x := by
    intro f k
    unfold pd2
    rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
    rfl
  have pinv : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => (f z)⁻¹) x = -pd2 k f x / (f x) ^ 2 := by
    intro f k hf hf0
    unfold pd2
    have H := (hasDerivAt_inv hf0).comp_hasFDerivAt x hf.hasFDerivAt
    rw [show (fun z => (f z)⁻¹) = (fun y : ℝ => y⁻¹) ∘ f from rfl, H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  have psqrt : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => Real.sqrt (f z)) x = pd2 k f x / (2 * Real.sqrt (f x)) := by
    intro f k hf hf0
    unfold pd2
    rw [fderiv_sqrt hf hf0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hinvE : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    rfl
  have hadj00 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 0 = A 1 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj01 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 1 = -A 0 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj10 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 0 = -A 1 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj11 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 1 = A 0 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hdetE : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.det = A 0 0 * A 1 1 - A 0 1 * A 1 0 :=
    fun A => Matrix.det_fin_two A
  have hDpos : 0 < (h x).det := (hpd x hx).det_pos
  have hD0 : (h x).det ≠ 0 := hDpos.ne'
  have hx10 : h x 1 0 = h x 0 1 := hsymm x hx 1 0
  have hd10 : ∀ l : Fin 2, pd2 l (fun z => h z 1 0) x = pd2 l (fun z => h z 0 1) x := by
    intro l
    have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
      Filter.eventually_of_mem hxU (fun z hz => hsymm z hz 1 0)
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq hev]
  
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z; exact hdetE (h z)
  have hdD : DifferentiableAt ℝ (fun z => (h z).det) x := by
    rw [hdetfun]; exact ((hdh 0 0).mul (hdh 1 1)).sub ((hdh 0 1).mul (hdh 1 0))
  have hdS : DifferentiableAt ℝ (fun z => Real.sqrt (h z).det) x := hdD.sqrt hD0
  have hdw : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j w) x := by
    intro j
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ w y) U := hw.fderiv_of_isOpen hU (by norm_num)
    have h2 : ContDiffOn ℝ 1 (pd2 j w) U := h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by norm_num)).differentiableAt hxU
  have hdI : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x := by
    intro i j
    have e : (fun z => (h z)⁻¹ i j) = fun z => ((h z).det)⁻¹ * (h z).adjugate i j :=
      funext fun z => hinvE (h z) i j
    rw [e]
    refine (hdD.inv hD0).mul ?_
    fin_cases i <;> fin_cases j
    · simp only [Fin.zero_eta, hadj00]; exact hdh 1 1
    · simp only [Fin.zero_eta, Fin.mk_one, hadj01]; exact (hdh 0 1).neg
    · simp only [Fin.zero_eta, Fin.mk_one, hadj10]; exact (hdh 1 0).neg
    · simp only [Fin.mk_one, hadj11]; exact hdh 0 0
  
  have pD : ∀ k : Fin 2, pd2 k (fun z => (h z).det) x =
      pd2 k (fun z => h z 0 0) x * h x 1 1 + h x 0 0 * pd2 k (fun z => h z 1 1) x -
        (pd2 k (fun z => h z 0 1) x * h x 1 0 + h x 0 1 * pd2 k (fun z => h z 1 0) x) := by
    intro k
    rw [hdetfun, psub _ _ k ((hdh 0 0).fun_mul (hdh 1 1)) ((hdh 0 1).fun_mul (hdh 1 0)),
      pmul _ _ k (hdh 0 0) (hdh 1 1), pmul _ _ k (hdh 0 1) (hdh 1 0)]
  have pS : ∀ k : Fin 2, pd2 k (fun z => Real.sqrt (h z).det) x =
      Real.sqrt (h x).det * pd2 k (fun z => (h z).det) x / (2 * (h x).det) := by
    intro k
    rw [psqrt _ k hdD hD0]
    have hs0 : 0 < Real.sqrt (h x).det := Real.sqrt_pos.mpr hDpos
    have hss : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det :=
      Real.mul_self_sqrt hDpos.le
    generalize Real.sqrt (h x).det = s at hs0 hss ⊢
    rw [← hss]
    field_simp
  have pI00 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 1 1 +
        (h x).det⁻¹ * pd2 k (fun z => h z 1 1) x := by
    intro k
    simp only [hinvE, hadj00]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 1), pinv _ k hdD hD0]
  have pI01 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 0 1) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 0 1) x) := by
    intro k
    simp only [hinvE, hadj01]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 1).fun_neg, pinv _ k hdD hD0, pneg]
  have pI10 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 1 0) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 1 0) x) := by
    intro k
    simp only [hinvE, hadj10]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 0).fun_neg, pinv _ k hdD hD0, pneg]
  have pI11 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 0 0 +
        (h x).det⁻¹ * pd2 k (fun z => h z 0 0) x := by
    intro k
    simp only [hinvE, hadj11]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 0), pinv _ k hdD hD0]
  
  simp only [Fin.sum_univ_two]
  have hdA : ∀ i : Fin 2, DifferentiableAt ℝ
      (fun z => (h z)⁻¹ i 0 * pd2 0 w z + (h z)⁻¹ i 1 * pd2 1 w z) x :=
    fun i => ((hdI i 0).fun_mul (hdw 0)).fun_add ((hdI i 1).fun_mul (hdw 1))
  rw [pmul _ _ 0 hdS (hdA 0), pmul _ _ 1 hdS (hdA 1),
    padd _ _ 0 ((hdI 0 0).fun_mul (hdw 0)) ((hdI 0 1).fun_mul (hdw 1)),
    padd _ _ 1 ((hdI 1 0).fun_mul (hdw 0)) ((hdI 1 1).fun_mul (hdw 1)),
    pmul _ _ 0 (hdI 0 0) (hdw 0), pmul _ _ 0 (hdI 0 1) (hdw 1),
    pmul _ _ 1 (hdI 1 0) (hdw 0), pmul _ _ 1 (hdI 1 1) (hdw 1),
    pS 0, pS 1, pI00 0, pI01 0, pI10 1, pI11 1, pD 0, pD 1]
  simp only [lap2, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10, hadj11]
  have hD1 : h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 ≠ 0 := by
    have e := hdetE (h x)
    rw [hx10] at e
    rw [← e]
    exact hD0
  generalize Real.sqrt (h x).det = s
  simp only [hx10, hd10]
  field_simp
  simp only [hdetE (h x), hx10]
  ring

theorem spherical_mean_ftc (R : ℝ) (F : E2 → ℝ) (hF : ContDiffOn ℝ 1 F (Metric.ball 0 R)) (s : ℝ) (hs : 0 ≤ s) (hsR : s < R) : (∫ φ in (-Real.pi)..Real.pi, F (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) = 2 * Real.pi * F 0 + (∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1)) ∧ ContinuousOn (fun t : ℝ => ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Set.Icc 0 s) :=
by
  suffices key : ∀ u : ℝ → E2, Continuous u → (∀ φ, ‖u φ‖ = 1) →
      (∫ φ in (-Real.pi)..Real.pi, F (s • u φ)) = 2 * Real.pi * F 0 +
        (∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • u φ) (u φ)) ∧
      ContinuousOn (fun t : ℝ => ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • u φ) (u φ))
        (Set.Icc 0 s) by
    have hun : ∀ φ : ℝ, ‖Real.cos φ • e2 0 + Real.sin φ • e2 1‖ = 1 := by
      intro φ
      rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
      simp [e2, EuclideanSpace.single_apply]
    exact key (fun φ => Real.cos φ • e2 0 + Real.sin φ • e2 1) (by fun_prop) hun
  intro u hu hun
  have hmem : ∀ φ : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) s, t • u φ ∈ Metric.ball (0 : E2) R := by
    intro φ t ht
    rw [mem_ball_zero_iff, norm_smul, hun, mul_one, Real.norm_eq_abs, abs_of_nonneg ht.1]
    linarith [ht.2]
  have hdF : ContinuousOn (fderiv ℝ F) (Metric.ball 0 R) :=
    hF.continuousOn_fderiv_of_isOpen Metric.isOpen_ball le_rfl
  let G : ℝ → ℝ → ℝ := fun t φ =>
    fderiv ℝ F (((Set.projIcc 0 s hs t : Set.Icc (0 : ℝ) s) : ℝ) • u φ) (u φ)
  have hGc : Continuous (Function.uncurry G) := by
    have hm : Continuous (fun p : ℝ × ℝ =>
        ((Set.projIcc 0 s hs p.1 : Set.Icc (0 : ℝ) s) : ℝ) • u p.2) :=
      (continuous_subtype_val.comp (continuous_projIcc.comp continuous_fst)).smul
        (hu.comp continuous_snd)
    have h1 : Continuous (fun p : ℝ × ℝ =>
        fderiv ℝ F (((Set.projIcc 0 s hs p.1 : Set.Icc (0 : ℝ) s) : ℝ) • u p.2)) :=
      hdF.comp_continuous hm (fun p => hmem p.2 _ (Set.projIcc 0 s hs p.1).2)
    exact h1.clm_apply (hu.comp continuous_snd)
  have hagree : ∀ t ∈ Set.Icc (0 : ℝ) s, ∀ φ : ℝ, G t φ = fderiv ℝ F (t • u φ) (u φ) := by
    intro t ht φ
    simp only [G, Set.projIcc_of_mem hs ht]
  have hGt : ∀ φ : ℝ, Continuous (fun t => G t φ) := fun φ =>
    hGc.comp (continuous_id.prodMk continuous_const)
  have hray : ∀ φ : ℝ, F (s • u φ) = F 0 + ∫ t in (0 : ℝ)..s, G t φ := by
    intro φ
    have hderiv : ∀ x ∈ Set.uIcc (0 : ℝ) s,
        HasDerivAt (fun τ : ℝ => F (τ • u φ)) (G x φ) x := by
      intro x hx
      rw [Set.uIcc_of_le hs] at hx
      rw [hagree x hx φ]
      have hd : DifferentiableAt ℝ F (x • u φ) :=
        (hF.differentiableOn (by norm_num)).differentiableAt
          (Metric.isOpen_ball.mem_nhds (hmem φ x hx))
      have hl : HasDerivAt (fun τ : ℝ => τ • u φ) (u φ) x := by
        simpa using (hasDerivAt_id x).smul_const (u φ)
      exact hd.hasFDerivAt.comp_hasDerivAt x hl
    have hint : IntervalIntegrable (fun t => G t φ) MeasureTheory.volume 0 s :=
      (hGt φ).intervalIntegrable _ _
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint
    simp only [zero_smul] at h
    linarith
  have hχc : Continuous (fun φ => ∫ t in (0 : ℝ)..s, G t φ) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun φ t => G t φ) (hGc.comp continuous_swap) 0 s
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hfub : (∫ φ in (-Real.pi)..Real.pi, ∫ t in (0 : ℝ)..s, G t φ) =
      ∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi, G t φ := by
    simp_rw [intervalIntegral.integral_of_le hs, intervalIntegral.integral_of_le hpi]
    apply MeasureTheory.integral_integral_swap
    rw [MeasureTheory.Measure.prod_restrict, ← MeasureTheory.Measure.volume_eq_prod]
    exact ((hGc.comp continuous_swap).continuousOn.integrableOn_compact
      (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self)
  have hpsi : ∀ t ∈ Set.Icc (0 : ℝ) s, (∫ φ in (-Real.pi)..Real.pi, G t φ) =
      ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • u φ) (u φ) := by
    intro t ht
    exact intervalIntegral.integral_congr (fun φ _ => hagree t ht φ)
  refine ⟨?_, ?_⟩
  · have h1 : (∫ φ in (-Real.pi)..Real.pi, F (s • u φ)) =
        ∫ φ in (-Real.pi)..Real.pi, (F 0 + ∫ t in (0 : ℝ)..s, G t φ) :=
      intervalIntegral.integral_congr (fun φ _ => hray φ)
    have h2 : (∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi, G t φ) =
        ∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi, fderiv ℝ F (t • u φ) (u φ) := by
      apply intervalIntegral.integral_congr
      intro t ht
      rw [Set.uIcc_of_le hs] at ht
      exact hpsi t ht
    rw [h1, intervalIntegral.integral_add intervalIntegrable_const (hχc.intervalIntegrable _ _),
      intervalIntegral.integral_const, smul_eq_mul, hfub, h2]
    ring
  · have hc : Continuous (fun t => ∫ φ in (-Real.pi)..Real.pi, G t φ) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hGc _ _
    exact hc.continuousOn.congr (fun t ht => (hpsi t ht).symm)

theorem divergence_disc_polar (R t : ℝ) (ht : 0 < t) (htR : t < R) (V₀ V₁ : E2 → ℝ) (hV₀ : ContDiffOn ℝ 1 V₀ (Metric.ball 0 R)) (hV₁ : ContDiffOn ℝ 1 V₁ (Metric.ball 0 R)) : (∫ x in Metric.ball (0 : E2) t, (pd2 0 V₀ x + pd2 1 V₁ x)) = ∫ φ in (-Real.pi)..Real.pi, t * (V₀ (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * Real.cos φ + V₁ (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * Real.sin φ) :=
by
  have hB : IsOpen (Metric.ball (0 : E2) R) := Metric.isOpen_ball
  have hnorm : ∀ φ : ℝ, ‖Real.cos φ • e2 0 + Real.sin φ • e2 1‖ = 1 := by
    intro φ
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
    simp [e2, EuclideanSpace.single_apply]
  have hmem : ∀ s φ : ℝ, 0 ≤ s → s ≤ t →
      s • (Real.cos φ • e2 0 + Real.sin φ • e2 1) ∈ Metric.ball (0 : E2) R := by
    intro s φ hs hst
    rw [mem_ball_zero_iff, norm_smul, hnorm, mul_one, Real.norm_eq_abs, abs_of_nonneg hs]
    linarith
  have hc0 : ∀ s φ : ℝ, (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) 0 = s * Real.cos φ := by
    intro s φ; simp [e2, EuclideanSpace.single_apply]
  have hc1 : ∀ s φ : ℝ, (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) 1 = s * Real.sin φ := by
    intro s φ; simp [e2, EuclideanSpace.single_apply]
  have hθ0 : ∀ φ : ℝ, (Real.cos φ • e2 0 + Real.sin φ • e2 1) 0 = Real.cos φ := by
    intro φ; simp [e2, EuclideanSpace.single_apply]
  have hθ1 : ∀ φ : ℝ, (Real.cos φ • e2 0 + Real.sin φ • e2 1) 1 = Real.sin φ := by
    intro φ; simp [e2, EuclideanSpace.single_apply]
  have hd0 : ∀ y ∈ Metric.ball (0 : E2) R, DifferentiableAt ℝ V₀ y := fun y hy =>
    (hV₀.differentiableOn (by norm_num)).differentiableAt (hB.mem_nhds hy)
  have hd1 : ∀ y ∈ Metric.ball (0 : E2) R, DifferentiableAt ℝ V₁ y := fun y hy =>
    (hV₁.differentiableOn (by norm_num)).differentiableAt (hB.mem_nhds hy)
  have hcf0 : ContinuousOn (fun y => fderiv ℝ V₀ y) (Metric.ball 0 R) :=
    hV₀.continuousOn_fderiv_of_isOpen hB le_rfl
  have hcf1 : ContinuousOn (fun y => fderiv ℝ V₁ y) (Metric.ball 0 R) :=
    hV₁.continuousOn_fderiv_of_isOpen hB le_rfl
  obtain ⟨G, hGdef⟩ : ∃ G : E2 → ℝ, G = fun y => y 0 * V₀ y + y 1 * V₁ y := ⟨_, rfl⟩
  have hG : ContDiffOn ℝ 1 G (Metric.ball 0 R) := by
    rw [hGdef]
    exact (((contDiff_piLp_apply 2 (i := 0)).contDiffOn).mul hV₀).add
      (((contDiff_piLp_apply 2 (i := 1)).contDiffOn).mul hV₁)
  have hcfG : ContinuousOn (fun y => fderiv ℝ G y) (Metric.ball 0 R) :=
    hG.continuousOn_fderiv_of_isOpen hB le_rfl
  have hG0 : G 0 = 0 := by rw [hGdef]; simp
  have hGd : ∀ x ∈ Metric.ball (0 : E2) R, ∀ v : E2,
      fderiv ℝ G x v = x 0 * fderiv ℝ V₀ x v + V₀ x * v 0 +
        (x 1 * fderiv ℝ V₁ x v + V₁ x * v 1) := by
    intro x hx v
    have h : HasFDerivAt G ((x 0 • fderiv ℝ V₀ x + V₀ x • PiLp.proj 2 (fun _ : Fin 2 => ℝ) 0) +
        (x 1 • fderiv ℝ V₁ x + V₁ x • PiLp.proj 2 (fun _ : Fin 2 => ℝ) 1)) x := by
      rw [hGdef]
      exact ((PiLp.hasFDerivAt_apply 2 x 0).mul (hd0 x hx).hasFDerivAt).add
        ((PiLp.hasFDerivAt_apply 2 x 1).mul (hd1 x hx).hasFDerivAt)
    rw [h.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, PiLp.proj_apply,
      smul_eq_mul]
  have hθc : Continuous (fun φ : ℝ => Real.cos φ • e2 0 + Real.sin φ • e2 1) := by fun_prop
  have hPc : ∀ s : ℝ, Continuous (fun φ : ℝ => s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) :=
    fun s => hθc.const_smul s
  
  have hf : ContinuousOn (fun x => pd2 0 V₀ x + pd2 1 V₁ x) (Metric.closedBall 0 t) :=
    ((hcf0.clm_apply continuousOn_const).add (hcf1.clm_apply continuousOn_const)).mono
      (Metric.closedBall_subset_ball htR)
  obtain ⟨hpol, -⟩ := integral_ball_polar_rad t ht (fun x => pd2 0 V₀ x + pd2 1 V₁ x) hf
  simp only [] at hpol
  rw [hpol]
  
  obtain ⟨hftc, -⟩ := spherical_mean_ftc R G hG t ht.le htR
  have hRHS : (∫ φ in (-Real.pi)..Real.pi, t * (V₀ (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * Real.cos φ + V₁ (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) * Real.sin φ)) = ∫ φ in (-Real.pi)..Real.pi, G (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
    refine intervalIntegral.integral_congr (fun φ _ => ?_)
    simp only [hGdef, hc0, hc1]
    ring
  rw [hRHS, hftc, hG0, mul_zero, zero_add]
  refine intervalIntegral.integral_congr (fun s hs => ?_)
  rw [Set.uIcc_of_le ht.le] at hs
  obtain ⟨hs0, hst⟩ := hs
  dsimp only
  
  have hA : Continuous (fun φ : ℝ => (pd2 0 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
      pd2 1 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) * s) := by
    have h0 : Continuous (fun φ : ℝ => fderiv ℝ V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) :=
      hcf0.comp_continuous (hPc s) (fun φ => hmem s φ hs0 hst)
    have h1 : Continuous (fun φ : ℝ => fderiv ℝ V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) :=
      hcf1.comp_continuous (hPc s) (fun φ => hmem s φ hs0 hst)
    exact ((h0.clm_apply continuous_const).add (h1.clm_apply continuous_const)).mul continuous_const
  have hBf : Continuous (fun φ : ℝ => fderiv ℝ G (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
      (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
    have h0 : Continuous (fun φ : ℝ => fderiv ℝ G (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) :=
      hcfG.comp_continuous (hPc s) (fun φ => hmem s φ hs0 hst)
    exact h0.clm_apply hθc
  have hderiv : ∀ φ ∈ Set.uIcc (-Real.pi) Real.pi, HasDerivAt
      (fun ψ : ℝ => V₁ (s • (Real.cos ψ • e2 0 + Real.sin ψ • e2 1)) * Real.cos ψ -
        V₀ (s • (Real.cos ψ • e2 0 + Real.sin ψ • e2 1)) * Real.sin ψ)
      ((pd2 0 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
          pd2 1 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) * s -
        fderiv ℝ G (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
          (Real.cos φ • e2 0 + Real.sin φ • e2 1)) φ := by
    intro φ _
    have hx := hmem s φ hs0 hst
    have hP : HasDerivAt (fun ψ : ℝ => s • (Real.cos ψ • e2 0 + Real.sin ψ • e2 1))
        (s • ((-Real.sin φ) • e2 0 + Real.cos φ • e2 1)) φ :=
      (((Real.hasDerivAt_cos φ).smul_const (e2 0)).add
        ((Real.hasDerivAt_sin φ).smul_const (e2 1))).const_smul s
    have h0 := (hd0 _ hx).hasFDerivAt.comp_hasDerivAt φ hP
    have h1 := (hd1 _ hx).hasFDerivAt.comp_hasDerivAt φ hP
    have hH := (h1.mul (Real.hasDerivAt_cos φ)).sub (h0.mul (Real.hasDerivAt_sin φ))
    refine hH.congr_deriv ?_
    have hD0 : fderiv ℝ V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (s • ((-Real.sin φ) • e2 0 + Real.cos φ • e2 1)) =
        s * (-Real.sin φ * pd2 0 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
          Real.cos φ * pd2 1 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) := by
      simp only [pd2, map_add, map_smul, smul_eq_mul]
    have hD1 : fderiv ℝ V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (s • ((-Real.sin φ) • e2 0 + Real.cos φ • e2 1)) =
        s * (-Real.sin φ * pd2 0 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
          Real.cos φ * pd2 1 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) := by
      simp only [pd2, map_add, map_smul, smul_eq_mul]
    have hT0 : fderiv ℝ V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (Real.cos φ • e2 0 + Real.sin φ • e2 1) =
        Real.cos φ * pd2 0 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
          Real.sin φ * pd2 1 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
      simp only [pd2, map_add, map_smul, smul_eq_mul]
    have hT1 : fderiv ℝ V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (Real.cos φ • e2 0 + Real.sin φ • e2 1) =
        Real.cos φ * pd2 0 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
          Real.sin φ * pd2 1 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
      simp only [pd2, map_add, map_smul, smul_eq_mul]
    simp only [Function.comp_apply]
    rw [hD0, hD1, hGd _ hx, hT0, hT1, hc0, hc1, hθ0, hθ1]
    have hcs := Real.cos_sq_add_sin_sq φ
    generalize pd2 0 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = a00
    generalize pd2 1 V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = a01
    generalize pd2 0 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = a10
    generalize pd2 1 V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = a11
    generalize V₀ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = v0
    generalize V₁ (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) = v1
    generalize Real.cos φ = c at hcs ⊢
    generalize Real.sin φ = σ at hcs ⊢
    linear_combination (s * (a00 + a11)) * hcs
  have hF := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv
    ((hA.sub hBf).intervalIntegrable (-Real.pi) Real.pi)
  have hsub := intervalIntegral.integral_sub (μ := MeasureTheory.volume)
    (hA.intervalIntegrable (-Real.pi) Real.pi) (hBf.intervalIntegrable (-Real.pi) Real.pi)
  have hper : (V₁ (s • (Real.cos Real.pi • e2 0 + Real.sin Real.pi • e2 1)) * Real.cos Real.pi -
        V₀ (s • (Real.cos Real.pi • e2 0 + Real.sin Real.pi • e2 1)) * Real.sin Real.pi) -
      (V₁ (s • (Real.cos (-Real.pi) • e2 0 + Real.sin (-Real.pi) • e2 1)) * Real.cos (-Real.pi) -
        V₀ (s • (Real.cos (-Real.pi) • e2 0 + Real.sin (-Real.pi) • e2 1)) *
          Real.sin (-Real.pi)) = 0 := by
    rw [Real.cos_neg, Real.sin_neg, Real.sin_pi, neg_zero, sub_self]
  linarith

theorem normal_disc_flux_polar (R : ℝ) (hR : 0 < R) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w : E2 → ℝ) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 R)) (hnf : ∀ x ∈ Metric.ball (0 : E2) R, (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) (hw : ContDiffOn ℝ 2 w (Metric.ball 0 R)) : ContinuousOn (fun x => Real.sqrt (h x).det * lap2 h w x) (Metric.ball 0 R) ∧ ∀ t : ℝ, 0 < t → t < R → (∫ x in Metric.ball (0 : E2) t, Real.sqrt (h x).det * lap2 h w x) = ∫ φ in (-Real.pi)..Real.pi, t * Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det * fderiv ℝ w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1) :=
by
  have hU : IsOpen (Metric.ball (0 : E2) R) := Metric.isOpen_ball
  have hpd : ∀ x ∈ Metric.ball (0 : E2) R, (h x).PosDef := fun x hx => (hnf x hx).1
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  
  have hdetC : ContDiffOn ℝ ∞ (fun x => (h x).det) (Metric.ball 0 R) := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    rw [e]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hdetne : ∀ x ∈ Metric.ball (0 : E2) R, (h x).det ≠ 0 :=
    fun x hx => (hpd x hx).det_pos.ne'
  have hsqC : ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) (Metric.ball 0 R) :=
    hdetC.sqrt hdetne
  have hinvC : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ i j) (Metric.ball 0 R) := by
    intro i j
    have e : (fun x => (h x)⁻¹ i j) = fun x => ((h x).det)⁻¹ * (h x).adjugate i j := by
      funext x
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
      rfl
    rw [e]
    refine (hdetC.inv hdetne).mul ?_
    have hadj : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x).adjugate a b) (Metric.ball 0 R) := by
      intro a b
      simp only [Matrix.adjugate_fin_two]
      fin_cases a <;> fin_cases b <;> simp
      · exact hh 1 1
      · exact (hh 0 1).neg
      · exact (hh 1 0).neg
      · exact hh 0 0
    exact hadj i j
  have hpdw : ∀ j : Fin 2, ContDiffOn ℝ 1 (pd2 j w) (Metric.ball 0 R) := by
    intro j
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ w y) (Metric.ball 0 R) :=
      hw.fderiv_of_isOpen hU (by norm_num)
    exact h1.clm_apply contDiffOn_const
  set V : Fin 2 → E2 → ℝ := fun i z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ i j * pd2 j w z
    with hVdef
  have hV : ∀ i : Fin 2, ContDiffOn ℝ 1 (V i) (Metric.ball 0 R) := by
    intro i
    refine (hsqC.of_le h1inf).mul ?_
    exact ContDiffOn.sum (fun j _ => ((hinvC i j).of_le h1inf).mul (hpdw j))
  have hdiv : ∀ x ∈ Metric.ball (0 : E2) R,
      pd2 0 (V 0) x + pd2 1 (V 1) x = Real.sqrt (h x).det * lap2 h w x :=
    fun x hx => lap2_divergence_form (Metric.ball 0 R) hU h w hh hpd hw x hx
  
  have hfix : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef → ∀ v : Fin 2 → ℝ,
      (∀ i : Fin 2, ∑ j : Fin 2, A i j * v j = v i) → ∀ j : Fin 2, ∑ i : Fin 2, v i * A⁻¹ i j = v j := by
    intro A hA v hv j
    have hsymm : ∀ i k : Fin 2, A i k = A k i := by
      intro i k
      have := hA.isHermitian.apply k i
      simpa using this
    have h1 : Matrix.vecMul v A = v := by
      funext k
      simp only [Matrix.vecMul, dotProduct]
      rw [← hv k]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hsymm i k, mul_comm]
    have hdet : IsUnit A.det := isUnit_iff_ne_zero.mpr hA.det_pos.ne'
    have h2 : Matrix.vecMul v A⁻¹ = v := by
      calc Matrix.vecMul v A⁻¹ = Matrix.vecMul (Matrix.vecMul v A) A⁻¹ := by rw [h1]
        _ = Matrix.vecMul v (A * A⁻¹) := Matrix.vecMul_vecMul _ _ _
        _ = v := by rw [Matrix.mul_nonsing_inv _ hdet, Matrix.vecMul_one]
    have := congrFun h2 j
    simpa [Matrix.vecMul, dotProduct] using this
  
  have hpdC : ∀ i k : Fin 2, ContinuousOn (fun x => pd2 k (V i) x) (Metric.ball 0 R) := by
    intro i k
    exact ((hV i).continuousOn_fderiv_of_isOpen hU le_rfl).clm_apply continuousOn_const
  refine ⟨((hpdC 0 0).add (hpdC 1 1)).congr (fun x hx => (hdiv x hx).symm), ?_⟩
  
  intro t ht htR
  have hsub : Metric.ball (0 : E2) t ⊆ Metric.ball 0 R := Metric.ball_subset_ball htR.le
  rw [MeasureTheory.setIntegral_congr_fun measurableSet_ball
    (fun x hx => (hdiv x (hsub hx)).symm)]
  rw [divergence_disc_polar R t ht htR (V 0) (V 1) (hV 0) (hV 1)]
  refine intervalIntegral.integral_congr (fun φ _ => ?_)
  have hnorm : ‖Real.cos φ • e2 0 + Real.sin φ • e2 1‖ = 1 := by
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
    simp [e2, EuclideanSpace.single_apply]
  have hx : t • (Real.cos φ • e2 0 + Real.sin φ • e2 1) ∈ Metric.ball (0 : E2) R := by
    rw [mem_ball_zero_iff, norm_smul, hnorm, mul_one, Real.norm_eq_abs, abs_of_pos ht]
    exact htR
  have hc0 : (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) 0 = t * Real.cos φ := by
    simp [e2, EuclideanSpace.single_apply]
  have hc1 : (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) 1 = t * Real.sin φ := by
    simp [e2, EuclideanSpace.single_apply]
  have hE := hfix _ (hnf _ hx).1 (fun i => (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) i)
    (hnf _ hx).2
  have hE0 := hE 0
  have hE1 := hE 1
  simp only [Fin.sum_univ_two, hc0, hc1] at hE0 hE1
  have hD : fderiv ℝ w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
      (Real.cos φ • e2 0 + Real.sin φ • e2 1) =
      Real.cos φ * pd2 0 w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) +
        Real.sin φ * pd2 1 w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
    simp only [pd2, map_add, map_smul, smul_eq_mul]
  rw [hD]
  simp only [hVdef, Fin.sum_univ_two]
  linear_combination
    (Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
      pd2 0 w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) * hE0 +
    (Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
      pd2 1 w (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) * hE1

theorem normal_disc_mean_value : ∃ ρ₀ c₀ ε₁ : ℝ, 0 < ρ₀ ∧ ρ₀ ≤ 1 / 2 ∧ 0 < c₀ ∧ 0 < ε₁ ∧ ∀ μ : ℝ, 0 < μ → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (a : E2 → ℝ), (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) (Metric.ball 0 (1 / μ))) → (∀ x ∈ Metric.ball (0 : E2) (1 / μ), (h x).PosDef ∧ ∀ i : Fin 2, ∑ j : Fin 2, h x i j * x j = x i) → ContDiffOn ℝ 2 a (Metric.ball 0 (1 / μ)) → a 0 = μ ^ 2 → (∀ x ∈ Metric.ball (0 : E2) (1 / μ), 0 ≤ a x ∧ a x ≤ μ ^ 2 ∧ -(a x) / 2 - ε₁ * μ ^ 2 ≤ gaussCurv2 h x ∧ gaussCurv2 h x ≤ ε₁ * μ ^ 2 ∧ -2 * (a x) ^ 2 - ε₁ * μ ^ 2 * a x - ε₁ * μ ^ 3 * Real.sqrt (a x) ≤ lap2 h a x) → c₀ ≤ ∫ x in Metric.ball (0 : E2) (ρ₀ / μ), a x * Real.sqrt (h x).det :=
by
  refine ⟨1 / 2, Real.pi / 8, 1 / 2, by norm_num, le_refl _, by positivity, by norm_num, ?_⟩
  intro μ hμ h a hh hnf ha2 ha0 hb
  have hR : (0 : ℝ) < 1 / μ := by positivity
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  
  have hnorm : ∀ φ : ℝ, ‖Real.cos φ • e2 0 + Real.sin φ • e2 1‖ = 1 := by
    intro φ
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
    simp [e2, EuclideanSpace.single_apply]
  have hmem : ∀ (φ τ : ℝ), |τ| < 1 / μ →
      τ • (Real.cos φ • e2 0 + Real.sin φ • e2 1) ∈ Metric.ball (0 : E2) (1 / μ) := by
    intro φ τ hτ
    rw [mem_ball_zero_iff, norm_smul, hnorm, mul_one, Real.norm_eq_abs]
    exact hτ
  
  have hpt : ∀ x ∈ Metric.ball (0 : E2) (1 / μ), 0 ≤ a x ∧ a x ≤ μ ^ 2 ∧
      -(μ ^ 2) ≤ gaussCurv2 h x ∧ gaussCurv2 h x ≤ 1 / 2 * μ ^ 2 ∧
      -(3 * μ ^ 4) ≤ lap2 h a x := by
    intro x hx
    obtain ⟨h1, h2, h3, h4, h5⟩ := hb x hx
    have hs : Real.sqrt (a x) ≤ μ := by
      calc Real.sqrt (a x) ≤ Real.sqrt (μ ^ 2) := Real.sqrt_le_sqrt h2
        _ = μ := Real.sqrt_sq hμ.le
    have hs0 := Real.sqrt_nonneg (a x)
    refine ⟨h1, h2, by linarith, h4, ?_⟩
    have e1 : a x ^ 2 ≤ μ ^ 4 := by nlinarith
    have e2 : μ ^ 2 * a x ≤ μ ^ 4 := by nlinarith
    have e3 : μ ^ 3 * Real.sqrt (a x) ≤ μ ^ 4 := by
      have : μ ^ 3 * Real.sqrt (a x) ≤ μ ^ 3 * μ := mul_le_mul_of_nonneg_left hs (by positivity)
      nlinarith
    nlinarith
  
  have hdetpos : ∀ x ∈ Metric.ball (0 : E2) (1 / μ), 0 < (h x).det :=
    fun x hx => (hnf x hx).1.det_pos
  have hdetC : ContDiffOn ℝ ∞ (fun x => (h x).det) (Metric.ball 0 (1 / μ)) := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    rw [e]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have huC : ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) (Metric.ball 0 (1 / μ)) :=
    hdetC.sqrt (fun x hx => (hdetpos x hx).ne')
  have hu1 : ContDiffOn ℝ 1 (fun x => Real.sqrt (h x).det) (Metric.ball 0 (1 / μ)) :=
    huC.of_le (by exact_mod_cast le_top)
  have ha1 : ContDiffOn ℝ 1 a (Metric.ball 0 (1 / μ)) := ha2.of_le (by norm_num)
  have hFC : ContDiffOn ℝ 1 (fun x => a x * Real.sqrt (h x).det) (Metric.ball 0 (1 / μ)) :=
    ha1.mul hu1
  have hdiff : ∀ (g : E2 → ℝ), ContDiffOn ℝ 1 g (Metric.ball 0 (1 / μ)) →
      ∀ x ∈ Metric.ball (0 : E2) (1 / μ), DifferentiableAt ℝ g x := by
    intro g hg x hx
    exact (hg.differentiableOn (by norm_num)).differentiableAt (Metric.isOpen_ball.mem_nhds hx)
  have hdirC : ∀ s : ℝ, Continuous (fun φ : ℝ => s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
    intro s; fun_prop
  have hcompφ : ∀ (g : E2 → ℝ) (s : ℝ), ContinuousOn g (Metric.ball 0 (1 / μ)) → |s| < 1 / μ →
      Continuous (fun φ : ℝ => g (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) := by
    intro g s hg hs
    exact hg.comp_continuous (hdirC s) (fun φ => hmem φ s hs)
  have hcompD : ∀ (g : E2 → ℝ) (s : ℝ), ContDiffOn ℝ 1 g (Metric.ball 0 (1 / μ)) → |s| < 1 / μ →
      Continuous (fun φ : ℝ => fderiv ℝ g (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (Real.cos φ • e2 0 + Real.sin φ • e2 1)) := by
    intro g s hg hs
    have h1 : Continuous (fun φ : ℝ => fderiv ℝ g (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))) :=
      (hg.continuousOn_fderiv_of_isOpen Metric.isOpen_ball le_rfl).comp_continuous (hdirC s)
        (fun φ => hmem φ s hs)
    have h2 : Continuous (fun φ : ℝ => Real.cos φ • e2 0 + Real.sin φ • e2 1) := by fun_prop
    exact h1.clm_apply h2
  
  have hray : ∀ φ : ℝ,
      (∀ s : ℝ, 0 ≤ s → s < 1 / μ →
        Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det ≤ 2) ∧
      ∀ s : ℝ, 0 < s → s < 1 / μ → -(1 / 3) * μ ^ 2 * s ≤
        deriv (fun τ : ℝ => Real.sqrt (h (τ • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det) s := by
    intro φ
    obtain ⟨hqC, hq0, hode⟩ := normal_form_ray_jacobi (1 / μ) hR h hh hnf _ (hnorm φ)
    have hB := jacobi_q_radial_bounds μ (1 / 2) hμ (by norm_num)
      (fun τ : ℝ => (h (τ • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det)
      (fun t : ℝ => gaussCurv2 h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)))
      (hqC.of_le h2inf)
      (by simp only [zero_smul]; exact hq0)
      (fun τ hτ => hdetpos _ (hmem φ τ (abs_lt.mpr hτ)))
      hode
      (fun t ht htR => by
        have hx := hmem φ t (by rw [abs_of_pos ht]; exact htR)
        exact ⟨(hpt _ hx).2.2.1, (hpt _ hx).2.2.2.1⟩)
    refine ⟨hB.1, fun s hs hsR => ?_⟩
    have := hB.2 s hs hsR
    linarith
  have hdet0 : (h 0).det = 1 := (normal_form_ray_jacobi (1 / μ) hR h hh hnf _ (hnorm 0)).2.1
  
  have hdu : ∀ (φ t : ℝ), |t| < 1 / μ →
      HasDerivAt (fun τ : ℝ => Real.sqrt (h (τ • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det)
        (fderiv ℝ (fun x => Real.sqrt (h x).det) (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
          (Real.cos φ • e2 0 + Real.sin φ • e2 1)) t := by
    intro φ t ht
    have hd := hdiff _ hu1 _ (hmem φ t ht)
    have hl : HasDerivAt (fun τ : ℝ => τ • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
        (Real.cos φ • e2 0 + Real.sin φ • e2 1) t := by
      simpa using (hasDerivAt_id t).smul_const (Real.cos φ • e2 0 + Real.sin φ • e2 1)
    exact hd.hasFDerivAt.comp_hasDerivAt t hl
  
  have harea : ∀ t : ℝ, 0 < t → t < 1 / μ →
      (∫ x in Metric.ball (0 : E2) t, Real.sqrt (h x).det) ≤ 2 * Real.pi * t ^ 2 := by
    intro t ht htR
    have hcl : Metric.closedBall (0 : E2) t ⊆ Metric.ball 0 (1 / μ) :=
      Metric.closedBall_subset_ball htR
    obtain ⟨hpol, hcont⟩ := integral_ball_polar_rad t ht (fun x => Real.sqrt (h x).det)
      (huC.continuousOn.mono hcl)
    rw [hpol]
    have hle : ∀ s ∈ Set.Icc (0 : ℝ) t,
        (∫ φ in (-Real.pi)..Real.pi,
          Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det * s) ≤
          4 * Real.pi * s := by
      intro s hs
      have hs' : |s| < 1 / μ := by rw [abs_of_nonneg hs.1]; linarith [hs.2]
      have hc : (∫ φ in (-Real.pi)..Real.pi, (2 * s)) = 4 * Real.pi * s := by
        rw [intervalIntegral.integral_const, smul_eq_mul]; ring
      rw [← hc]
      apply intervalIntegral.integral_mono_on (by linarith [Real.pi_pos])
      · exact ((hcompφ _ s huC.continuousOn hs').mul continuous_const).intervalIntegrable _ _
      · exact intervalIntegrable_const
      · intro φ _
        have := (hray φ).1 s hs.1 (by linarith [hs.2])
        nlinarith [hs.1]
    calc (∫ s in (0 : ℝ)..t, ∫ φ in (-Real.pi)..Real.pi,
          Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det * s)
        ≤ ∫ s in (0 : ℝ)..t, 4 * Real.pi * s :=
          intervalIntegral.integral_mono_on ht.le (hcont.intervalIntegrable_of_Icc ht.le)
            ((continuous_const.mul continuous_id).intervalIntegrable _ _) hle
      _ = 2 * Real.pi * t ^ 2 := by
          rw [intervalIntegral.integral_const_mul, integral_id]; ring
  
  have hflux : ∀ t : ℝ, 0 < t → t < 1 / μ → -(6 * Real.pi * μ ^ 4 * t) ≤
      ∫ φ in (-Real.pi)..Real.pi,
        Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
          fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
            (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
    intro t ht htR
    obtain ⟨hcontL, hfl⟩ := normal_disc_flux_polar (1 / μ) hR h a hh hnf ha2
    have hfl' := hfl t ht htR
    have hcl : Metric.closedBall (0 : E2) t ⊆ Metric.ball 0 (1 / μ) :=
      Metric.closedBall_subset_ball htR
    have hint1 : IntegrableOn (fun x => Real.sqrt (h x).det * lap2 h a x) (Metric.ball 0 t) :=
      ((hcontL.mono hcl).integrableOn_compact (isCompact_closedBall 0 t)).mono_set
        Metric.ball_subset_closedBall
    have hint2 : IntegrableOn (fun x => Real.sqrt (h x).det * (-(3 * μ ^ 4))) (Metric.ball 0 t) :=
      (((huC.continuousOn.mono hcl).mul continuousOn_const).integrableOn_compact
        (isCompact_closedBall 0 t)).mono_set Metric.ball_subset_closedBall
    have hmono : (∫ x in Metric.ball (0 : E2) t, Real.sqrt (h x).det * (-(3 * μ ^ 4))) ≤
        ∫ x in Metric.ball (0 : E2) t, Real.sqrt (h x).det * lap2 h a x := by
      refine MeasureTheory.setIntegral_mono_on hint2 hint1 Metric.isOpen_ball.measurableSet ?_
      intro x hx
      exact mul_le_mul_of_nonneg_left
        (hpt x (Metric.ball_subset_ball htR.le hx)).2.2.2.2 (Real.sqrt_nonneg _)
    rw [MeasureTheory.integral_mul_const] at hmono
    have hA := harea t ht htR
    have hrw : (∫ φ in (-Real.pi)..Real.pi,
        t * Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
          fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
            (Real.cos φ • e2 0 + Real.sin φ • e2 1)) =
        t * ∫ φ in (-Real.pi)..Real.pi,
          Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
            fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
              (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext φ; ring
    rw [hrw] at hfl'
    have hμ4 : 0 ≤ 3 * μ ^ 4 := by positivity
    have key : -(6 * Real.pi * μ ^ 4 * t ^ 2) ≤ t * ∫ φ in (-Real.pi)..Real.pi,
          Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
            fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
              (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
      rw [← hfl']
      nlinarith
    by_contra hcon
    push_neg at hcon
    have := mul_lt_mul_of_pos_left hcon ht
    nlinarith
  
  have hW : ∀ s : ℝ, 0 ≤ s → s ≤ 1 / 2 / μ → Real.pi * μ ^ 2 ≤
      ∫ φ in (-Real.pi)..Real.pi,
        a (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) *
          Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det := by
    intro s hs hsρ
    have hhalf : 1 / 2 / μ < 1 / μ := by
      rw [div_lt_div_iff_of_pos_right hμ]; norm_num
    have hsR : s < 1 / μ := lt_of_le_of_lt hsρ hhalf
    obtain ⟨hftc, hψc⟩ := spherical_mean_ftc (1 / μ) (fun x => a x * Real.sqrt (h x).det) hFC
      s hs hsR
    simp only [] at hftc hψc
    rw [hftc, ha0, hdet0, Real.sqrt_one, mul_one]
    
    have hψ : ∀ t ∈ Set.Ioc (0 : ℝ) s, -(7 * Real.pi * μ ^ 4) * t ≤
        ∫ φ in (-Real.pi)..Real.pi,
          fderiv ℝ (fun x => a x * Real.sqrt (h x).det)
            (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
      intro t ht
      have htR : t < 1 / μ := lt_of_le_of_lt ht.2 hsR
      have ht' : |t| < 1 / μ := by rw [abs_of_pos ht.1]; exact htR
      have hpw : ∀ φ : ℝ,
          Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
              fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
                (Real.cos φ • e2 0 + Real.sin φ • e2 1) + -(1 / 3 * μ ^ 4 * t) ≤
            fderiv ℝ (fun x => a x * Real.sqrt (h x).det)
              (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
        intro φ
        have hx := hmem φ t ht'
        rw [fderiv_fun_mul (hdiff _ ha1 _ hx) (hdiff _ hu1 _ hx)]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        have hD := (hray φ).2 t ht.1 htR
        rw [(hdu φ t ht').deriv] at hD
        obtain ⟨ha0x, hamx, -, -, -⟩ := hpt _ hx
        have hm : 0 ≤ μ ^ 2 * t := mul_nonneg (by positivity) ht.1.le
        nlinarith
      have hint1 : IntervalIntegrable (fun φ : ℝ =>
          Real.sqrt (h (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det *
              fderiv ℝ a (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1))
                (Real.cos φ • e2 0 + Real.sin φ • e2 1)) MeasureTheory.volume (-Real.pi) Real.pi :=
        ((hcompφ _ t huC.continuousOn ht').mul (hcompD a t ha1 ht')).intervalIntegrable _ _
      have hint2 : IntervalIntegrable (fun φ : ℝ =>
          fderiv ℝ (fun x => a x * Real.sqrt (h x).det)
              (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1))
          MeasureTheory.volume (-Real.pi) Real.pi :=
        (hcompD _ t hFC ht').intervalIntegrable _ _
      have hmono := intervalIntegral.integral_mono_on (by linarith [Real.pi_pos])
        (hint1.add intervalIntegrable_const) hint2 (fun φ _ => hpw φ)
      rw [intervalIntegral.integral_add hint1 intervalIntegrable_const,
        intervalIntegral.integral_const, smul_eq_mul] at hmono
      have hf := hflux t ht.1 htR
      have hpos : 0 ≤ Real.pi * μ ^ 4 * t :=
        mul_nonneg (mul_nonneg Real.pi_pos.le (by positivity)) ht.1.le
      nlinarith [Real.pi_pos]
    have hint3 : MeasureTheory.IntegrableOn (fun t : ℝ => -(7 * Real.pi * μ ^ 4) * t)
        (Set.Ioc 0 s) := by
      exact (continuous_const.mul continuous_id).integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
    have hint4 := (hψc.integrableOn_Icc (μ := MeasureTheory.volume)).mono_set
      (Set.Ioc_subset_Icc_self (a := (0 : ℝ)) (b := s))
    have hI : (∫ t in (0 : ℝ)..s, -(7 * Real.pi * μ ^ 4) * t) ≤
        ∫ t in (0 : ℝ)..s, ∫ φ in (-Real.pi)..Real.pi,
          fderiv ℝ (fun x => a x * Real.sqrt (h x).det)
            (t • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) (Real.cos φ • e2 0 + Real.sin φ • e2 1) := by
      rw [intervalIntegral.integral_of_le hs, intervalIntegral.integral_of_le hs]
      exact MeasureTheory.setIntegral_mono_on hint3 hint4 measurableSet_Ioc hψ
    rw [intervalIntegral.integral_const_mul, integral_id] at hI
    have hμs : μ * s ≤ 1 / 2 := by
      have := mul_le_mul_of_nonneg_left hsρ hμ.le
      rw [show μ * (1 / 2 / μ) = 1 / 2 by field_simp] at this
      exact this
    have hμs0 : 0 ≤ μ * s := by positivity
    have hsq : μ ^ 4 * s ^ 2 ≤ μ ^ 2 * (1 / 4) := by
      have : (μ * s) ^ 2 ≤ (1 / 2) ^ 2 := pow_le_pow_left₀ hμs0 hμs 2
      nlinarith
    nlinarith [Real.pi_pos]
  
  have hρ : (0 : ℝ) < 1 / 2 / μ := by positivity
  have hclρ : Metric.closedBall (0 : E2) (1 / 2 / μ) ⊆ Metric.ball 0 (1 / μ) := by
    apply Metric.closedBall_subset_ball
    rw [div_lt_div_iff_of_pos_right hμ]; norm_num
  obtain ⟨hpol, hcont⟩ := integral_ball_polar_rad (1 / 2 / μ) hρ
    (fun x => a x * Real.sqrt (h x).det) (hFC.continuousOn.mono hclρ)
  simp only [] at hpol hcont
  rw [hpol]
  have hle : ∀ s ∈ Set.Icc (0 : ℝ) (1 / 2 / μ), Real.pi * μ ^ 2 * s ≤
      ∫ φ in (-Real.pi)..Real.pi,
        a (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1)) *
          Real.sqrt (h (s • (Real.cos φ • e2 0 + Real.sin φ • e2 1))).det * s := by
    intro s hs
    rw [intervalIntegral.integral_mul_const]
    have := hW s hs.1 hs.2
    nlinarith [hs.1]
  calc Real.pi / 8 = ∫ s in (0 : ℝ)..(1 / 2 / μ), Real.pi * μ ^ 2 * s := by
        rw [intervalIntegral.integral_const_mul, integral_id]
        field_simp
        ring
    _ ≤ _ := intervalIntegral.integral_mono_on hρ.le
        ((continuous_const.mul continuous_id).intervalIntegrable _ _)
        (hcont.intervalIntegrable_of_Icc hρ.le) hle

theorem stable_curvature_bound [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Z : Set M) (hZ : IsCompact Z) :
    ∃ Λ : ℝ, ∀ Sig : Set M, IsCompact Sig → IsMinimalSurfaceSet g Sig →
      IsStableMinimalSet g Sig → Sig ⊆ Z → HasCurvatureBound g Sig Λ :=
by
  classical
  
  obtain ⟨ρ₀, c₀, ε₁, hρ₀, hρ₀2, hc₀, hε₁, hMV⟩ := normal_disc_mean_value
  obtain ⟨R₀, ε₀, hR₀, hε₀, hLC⟩ := normal_disc_log_cutoff (c₀ / 2) (by linarith)
  have hεpos : 0 < min ε₀ ε₁ := lt_min hε₀ hε₁
  
  have hrad : ∀ z : M, ∃ r : ℝ, 0 < r ∧
      Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target := by
    intro z
    obtain ⟨r, hr, hsub⟩ := Metric.isOpen_iff.mp (chartAt E3 z).open_target _
      (mem_chart_target E3 z)
    refine ⟨r / 8, by positivity, fun y hy => hsub ?_⟩
    rw [Metric.mem_closedBall] at hy
    rw [Metric.mem_ball]
    linarith
  choose r hr hball using hrad
  choose ρ₁ hρ₁ hF using fun z => surface_normal_disc g z (r z) (hr z) (hball z)
  choose k₀ C₁ C₂ hk₀ hC₁ hC₂ hGS using
    fun z => pullback_gauss_simons g z (r z) (hr z) (hball z)
  choose k₁ hk₁ hJS using fun z => pullback_jacobi_supersolution g z (r z) (hr z) (hball z)
  set ε : ℝ := min ε₀ ε₁ with hεdef
  let Λz : M → ℝ := fun z => 1 + R₀ / ρ₁ z + (k₀ z + k₁ z + C₁ z + C₂ z) / ε
  have hΛz0 : ∀ z, 0 ≤ Λz z := by
    intro z
    have h1 : 0 ≤ R₀ / ρ₁ z := div_nonneg (by linarith) (hρ₁ z).le
    have h2 : 0 ≤ (k₀ z + k₁ z + C₁ z + C₂ z) / ε :=
      div_nonneg (by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]) hεpos.le
    show 0 ≤ 1 + R₀ / ρ₁ z + (k₀ z + k₁ z + C₁ z + C₂ z) / ε
    linarith
  let O : M → Set M := fun z =>
    (chartAt E3 z).source ∩ (chartAt E3 z) ⁻¹' Metric.ball (chartAt E3 z z) (r z)
  have hO : ∀ z ∈ Z, O z ∈ 𝓝 z := by
    intro z _
    refine Filter.inter_mem (chart_source_mem_nhds E3 z) ?_
    exact ((chartAt E3 z).continuousAt (mem_chart_source E3 z)).preimage_mem_nhds
      (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (hr z)))
  
  obtain ⟨t, -, hcov⟩ := hZ.elim_nhds_subcover O hO
  refine ⟨1 + ∑ z ∈ t, Λz z, ?_⟩
  
  intro Sig hSc hSm hSs hSZ
  have huniq : ∀ (κ : OpenPartialHomeomorph M E3) (p : M) (t₁ t₂ : ℝ), p ∈ Sig →
      p ∈ κ.source → IsSurfA2At g Sig κ p t₁ → IsSurfA2At g Sig κ p t₂ → t₁ = t₂ := by
    intro κ p t₁ t₂ hp hpκ h₁ h₂
    obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, -, -, -⟩ :=
      hSm.2 p hp κ.source (κ.open_source.mem_nhds hpκ)
    rw [← h₁ V f hVo hpV hVO hf hdf hVS, ← h₂ V f hVo hpV hVO hf hdf hVS]
  rcases Sig.eq_empty_or_nonempty with hE | hne
  · intro p hp
    rw [hE] at hp
    simp at hp
  obtain ⟨q, hqS, lam, hlam0, hlamq, hlammax⟩ := surfA2_attains_max g Sig hSc hSm hne
  
  have hle : lam ≤ 1 + ∑ z ∈ t, Λz z := by
    by_contra hgt
    push_neg at hgt
    have hsum0 : 0 ≤ ∑ z ∈ t, Λz z := Finset.sum_nonneg (fun z _ => hΛz0 z)
    have hlam1 : 1 ≤ lam := by linarith
    have hlampos : 0 < lam := by linarith
    obtain ⟨z, hzt, hqz⟩ := Set.mem_iUnion₂.mp (hcov (hSZ hqS))
    have hΛzle : Λz z ≤ lam := by
      have := Finset.single_le_sum (fun z _ => hΛz0 z) hzt
      linarith
    have hΛzle' : 1 + R₀ / ρ₁ z + (k₀ z + k₁ z + C₁ z + C₂ z) / ε ≤ lam := hΛzle
    have hR0le : R₀ / ρ₁ z ≤ lam := by
      have : 0 ≤ (k₀ z + k₁ z + C₁ z + C₂ z) / ε :=
        div_nonneg (by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]) hεpos.le
      linarith
    have hKle : (k₀ z + k₁ z + C₁ z + C₂ z) / ε ≤ lam := by
      have : 0 ≤ R₀ / ρ₁ z := div_nonneg (by linarith) (hρ₁ z).le
      linarith
    have hK : k₀ z + k₁ z + C₁ z + C₂ z ≤ ε * lam := by
      rw [div_le_iff₀ hεpos] at hKle
      linarith
    have hρpos : 0 < R₀ / lam := div_pos (by linarith) hlampos
    have hρle : R₀ / lam ≤ ρ₁ z := by
      rw [div_le_iff₀ hlampos]
      rw [div_le_iff₀ (hρ₁ z)] at hR0le
      linarith
    have hεle0 : ε ≤ ε₀ := min_le_left _ _
    have hεle1 : ε ≤ ε₁ := min_le_right _ _
    have hlam2 : lam ≤ lam ^ 2 := by nlinarith
    have hlam3 : lam ^ 2 ≤ lam ^ 3 := by nlinarith
    have hεl : ε * lam ≤ ε * lam ^ 2 := mul_le_mul_of_nonneg_left hlam2 hεpos.le
    have hA0 : ε * lam ^ 2 ≤ ε₀ * lam ^ 2 := mul_le_mul_of_nonneg_right hεle0 (sq_nonneg _)
    have hA1 : ε * lam ^ 2 ≤ ε₁ * lam ^ 2 := mul_le_mul_of_nonneg_right hεle1 (sq_nonneg _)
    have hA3 : ε₁ * lam ^ 2 ≤ ε₁ * lam ^ 3 := mul_le_mul_of_nonneg_left hlam3 hε₁.le
    have hk0b : k₀ z ≤ ε₀ * lam ^ 2 := by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]
    have hk0b' : k₀ z ≤ ε₁ * lam ^ 2 := by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]
    have hk1b : k₁ z ≤ ε₀ * lam ^ 2 := by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]
    have hC1b : C₁ z ≤ ε₁ * lam ^ 2 := by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]
    have hC2b : C₂ z ≤ ε₁ * lam ^ 3 := by linarith [hk₀ z, hk₁ z, hC₁ z, hC₂ z]
    
    obtain ⟨hqsrc, hqball⟩ := hqz
    obtain ⟨F, hF0, hFs, hhs, hFx⟩ :=
      hF z Sig hSc hSm q hqS hqsrc hqball (R₀ / lam) hρpos hρle
    have hFx' : ∀ x ∈ Metric.ball (0 : E2) (R₀ / lam),
        F x ∈ Metric.ball (chartAt E3 z z) (2 * r z) ∧
        (chartAt E3 z).symm (F x) ∈ Sig ∧ Function.Injective (fderiv ℝ F x) :=
      fun x hx => ⟨(hFx x hx).1, (hFx x hx).2.1, (hFx x hx).2.2.1⟩
    obtain ⟨a, ha2, ha⟩ := hGS z Sig hSm (R₀ / lam) F hFs hFx'
    obtain ⟨a', b, φ, -, hbc, hφ, hJ⟩ := hJS z Sig hSm hSs (R₀ / lam) F hFs hFx'
    have hsrc : ∀ x ∈ Metric.ball (0 : E2) (R₀ / lam),
        (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source := by
      intro x hx
      apply (chartAt E3 z).map_target
      apply hball z
      have := (hFx x hx).1
      rw [Metric.mem_ball] at this
      rw [Metric.mem_closedBall]
      linarith [hr z]
    
    have haa' : ∀ x ∈ Metric.ball (0 : E2) (R₀ / lam), a' x = a x := fun x hx =>
      huniq _ _ _ _ (hFx x hx).2.1 (hsrc x hx) (hJ x hx).1 (ha x hx).1
    have hale : ∀ x ∈ Metric.ball (0 : E2) (R₀ / lam), a x ≤ lam ^ 2 := by
      intro x hx
      obtain ⟨t1, -, h1, h2⟩ :=
        surfA2_chart_invariant g Sig hSm z _ (hFx x hx).2.1 (hsrc x hx)
      rw [huniq _ _ _ _ (hFx x hx).2.1 (hsrc x hx) (ha x hx).1 h1]
      exact hlammax _ (hFx x hx).2.1 t1 h2
    have h0mem : (0 : E2) ∈ Metric.ball (0 : E2) (R₀ / lam) := Metric.mem_ball_self hρpos
    have ha0 : a 0 = lam ^ 2 := by
      obtain ⟨t1, -, h1, h2⟩ := surfA2_chart_invariant g Sig hSm z q hqS hqsrc
      have e1 := (ha 0 h0mem).1
      rw [hF0, (chartAt E3 z).left_inv hqsrc] at e1
      rw [huniq _ _ _ _ hqS hqsrc e1 h1]
      exact huniq _ _ _ _ hqS (mem_chart_source E3 q) h2 hlamq
    
    have hI1 := hLC lam hlampos (pullMetric2 (g.coeff (chartAt E3 z).symm) F) a b φ hhs
      (fun x hx => (hFx x hx).2.2.2) ha2.continuousOn hbc hφ (by
        intro x hx
        obtain ⟨-, ha0x, hK1, -, -⟩ := ha x hx
        obtain ⟨-, hb, hφx, hL⟩ := hJ x hx
        rw [haa' x hx] at hL
        exact ⟨ha0x, by linarith, by linarith, hφx, hL⟩)
    
    have h1R : 1 / lam ≤ R₀ / lam := div_le_div_of_nonneg_right (by linarith) hlampos.le
    have hsub : Metric.ball (0 : E2) (1 / lam) ⊆ Metric.ball 0 (R₀ / lam) :=
      Metric.ball_subset_ball h1R
    have hI2 := hMV lam hlampos (pullMetric2 (g.coeff (chartAt E3 z).symm) F) a
      (fun i j => (hhs i j).mono hsub) (fun x hx => (hFx x (hsub hx)).2.2.2) (ha2.mono hsub) ha0
      (by
        intro x hx
        obtain ⟨-, ha0x, hK1, hK2, hS⟩ := ha x (hsub hx)
        have hsq : 0 ≤ Real.sqrt (a x) := Real.sqrt_nonneg _
        have e1 : C₁ z * a x ≤ ε₁ * lam ^ 2 * a x := mul_le_mul_of_nonneg_right hC1b ha0x
        have e2 : C₂ z * Real.sqrt (a x) ≤ ε₁ * lam ^ 3 * Real.sqrt (a x) :=
          mul_le_mul_of_nonneg_right hC2b hsq
        exact ⟨ha0x, hale x (hsub hx), by linarith, by linarith, by linarith⟩)
    
    have hcl : Metric.closedBall (0 : E2) (1 / lam) ⊆ Metric.ball 0 (R₀ / lam) :=
      Metric.closedBall_subset_ball (div_lt_div_of_pos_right (by linarith) hlampos)
    have hc : ∀ i j : Fin 2, ContinuousOn
        (fun x => pullMetric2 (g.coeff (chartAt E3 z).symm) F x i j)
        (Metric.closedBall 0 (1 / lam)) := fun i j => ((hhs i j).continuousOn).mono hcl
    have hdet : (fun x => a x * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det) =
        fun x => a x * Real.sqrt
          (pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 0 *
              pullMetric2 (g.coeff (chartAt E3 z).symm) F x 1 1 -
            pullMetric2 (g.coeff (chartAt E3 z).symm) F x 0 1 *
              pullMetric2 (g.coeff (chartAt E3 z).symm) F x 1 0) := by
      funext x
      rw [Matrix.det_fin_two]
    have hcont : ContinuousOn
        (fun x => a x * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det)
        (Metric.closedBall 0 (1 / lam)) := by
      rw [hdet]
      exact (ha2.continuousOn.mono hcl).mul (Real.continuous_sqrt.comp_continuousOn
        (((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))))
    have hint : IntegrableOn
        (fun x => a x * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det)
        (Metric.ball 0 (1 / lam)) :=
      (hcont.integrableOn_compact (isCompact_closedBall 0 (1 / lam))).mono_set
        Metric.ball_subset_closedBall
    have hρ1 : ρ₀ / lam ≤ 1 / lam := div_le_div_of_nonneg_right (by linarith) hlampos.le
    have hmono : ∫ x in Metric.ball (0 : E2) (ρ₀ / lam),
          a x * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det ≤
        ∫ x in Metric.ball (0 : E2) (1 / lam),
          a x * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 z).symm) F x).det := by
      apply MeasureTheory.setIntegral_mono_set hint
      · refine (MeasureTheory.ae_restrict_iff' Metric.isOpen_ball.measurableSet).2
          (Filter.Eventually.of_forall ?_)
        intro x hx
        exact mul_nonneg (ha x (hsub hx)).2.1 (Real.sqrt_nonneg _)
      · exact (Metric.ball_subset_ball hρ1).eventuallyLE
    linarith
  
  intro p hp
  obtain ⟨V, f, hVO, hVo, hpV, hf, hdf, hVS, -, -, -⟩ :=
    hSm.2 p hp _ (chart_source_mem_nhds E3 p)
  obtain ⟨t', -, -, h2⟩ := surfA2_chart_invariant g Sig hSm p p hp (mem_chart_source E3 p)
  refine ⟨V, f, hVo, hpV, hf, hdf, hVS, ?_⟩
  rw [h2 V f hVo hpV hVO hf hdf hVS]
  have h3 := hlammax p hp t' h2
  have h4 : lam ^ 2 ≤ (1 + ∑ z ∈ t, Λz z) ^ 2 := pow_le_pow_left₀ hlam0 hle 2
  linarith

theorem chart_image_regular [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p : M)
    (Sig : Set M) (hSig : IsMinimalSurfaceSet g Sig) :
    (∀ z ∈ (chartAt E3 p).target,
       z ∈ closure ((chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source)) →
       z ∈ (chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source)) ∧
    (∀ z ∈ (chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source), ∃ r > 0, ∃ F : E3 → ℝ,
       Metric.ball z r ⊆ (chartAt E3 p).target ∧ ContDiffOn ℝ ∞ F (Metric.ball z r) ∧
       (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
       ∀ y ∈ Metric.ball z r,
         (y ∈ (chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source) ↔ F y = 0)) :=
by
  refine ⟨?_, ?_⟩
  · intro z hzt hzc
    by_contra hz
    have ha : (chartAt E3 p).symm z ∉ Sig := by
      intro hS
      apply hz
      refine ⟨(chartAt E3 p).symm z, ⟨hS, (chartAt E3 p).map_target hzt⟩, ?_⟩
      exact (chartAt E3 p).right_inv hzt
    have hWo : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' Sigᶜ) :=
      (chartAt E3 p).isOpen_inter_preimage_symm hSig.1.isOpen_compl
    obtain ⟨y, ⟨_, hyW⟩, ⟨s, ⟨hsS, hss⟩, rfl⟩⟩ := mem_closure_iff.1 hzc _ hWo ⟨hzt, ha⟩
    apply hyW
    show (chartAt E3 p).symm ((chartAt E3 p) s) ∈ Sig
    rw [(chartAt E3 p).left_inv hss]
    exact hsS
  · rintro z ⟨x, ⟨hxS, hxs⟩, rfl⟩
    obtain ⟨V, f, hVO, hVo, hxV, hf, hdf, hVS, -, -, -⟩ :=
      hSig.2 x hxS (chartAt E3 p).source ((chartAt E3 p).open_source.mem_nhds hxs)
    obtain ⟨hFsm, hFd⟩ := ejp_chart_transfer g p f hf
    have hUo : IsOpen ((chartAt E3 p) '' V) :=
      (chartAt E3 p).isOpen_image_of_subset_source hVo hVO
    obtain ⟨r, hr, hrU⟩ := Metric.isOpen_iff.1 hUo ((chartAt E3 p) x) ⟨x, hxV, rfl⟩
    have hbt : Metric.ball ((chartAt E3 p) x) r ⊆ (chartAt E3 p).target := by
      intro y hy
      obtain ⟨x', hx', rfl⟩ := hrU hy
      exact (chartAt E3 p).map_source (hVO hx')
    refine ⟨r, hr, fun y => f ((chartAt E3 p).symm y), hbt, hFsm.mono hbt, ?_, ?_⟩
    · intro y hy
      obtain ⟨x', hx', rfl⟩ := hrU hy
      exact (hFd x' (hVO hx') (hdf x' hx')).1
    · intro y hy
      obtain ⟨x', hx', rfl⟩ := hrU hy
      have hl : (chartAt E3 p).symm ((chartAt E3 p) x') = x' := (chartAt E3 p).left_inv (hVO hx')
      show _ ↔ f ((chartAt E3 p).symm ((chartAt E3 p) x')) = 0
      rw [hl]
      constructor
      · rintro ⟨s, ⟨hsS, hss⟩, hse⟩
        have hsx : s = x' := by
          rw [← (chartAt E3 p).left_inv hss, hse, hl]
        subst hsx
        have h' : s ∈ V ∩ Sig := ⟨hx', hsS⟩
        rw [hVS] at h'
        exact h'.2
      · intro h0
        have h' : x' ∈ V ∩ f ⁻¹' {0} := ⟨hx', h0⟩
        rw [← hVS] at h'
        exact ⟨x', ⟨h'.2, hVO hx'⟩, rfl⟩

theorem graph_jet_relations (b : Fin 3) (w F : E3 → ℝ) (z : E3)
    (hw : ContDiffAt ℝ 2 w (coordPlaneProj b z))
    (hpl : ∀ y, w (coordPlaneProj b y) = w y)
    (hz : z b = w (coordPlaneProj b z))
    (hF : ContDiffAt ℝ 2 F z)
    (hvan : ∀ᶠ y in 𝓝 z, F (coordPlaneProj b y + w (coordPlaneProj b y) • e b) = 0) :
    (∀ j : Fin 3, partialDeriv j F z =
       partialDeriv b F z * partialDeriv j (fun y => y b - w (coordPlaneProj b y)) z) ∧
    ∃ r s : Fin 3 → ℝ, ∀ i j : Fin 3,
      partialDeriv i (partialDeriv j F) z =
        partialDeriv b F z *
            partialDeriv i (partialDeriv j (fun y => y b - w (coordPlaneProj b y))) z +
          partialDeriv i (fun y => y b - w (coordPlaneProj b y)) z * r j +
          s i * partialDeriv j (fun y => y b - w (coordPlaneProj b y)) z :=
by
  set Fw : E3 → ℝ := fun y => y b - w (coordPlaneProj b y) with hFwdef
  
  have hPcd : ContDiff ℝ 2 (coordPlaneProj b) := by
    unfold coordPlaneProj; fun_prop
  have hprojcd : ContDiff ℝ 2 (fun y : E3 => y b) := by fun_prop
  have hFw : ContDiffAt ℝ 2 Fw z :=
    hprojcd.contDiffAt.sub (hw.comp z hPcd.contDiffAt)
  
  have hshear : ∀ y, coordPlaneProj b y + w (coordPlaneProj b y) • e b = y - Fw y • e b := by
    intro y
    simp only [hFwdef, coordPlaneProj, sub_smul]
    abel
  have hz0 : Fw z = 0 := by
    simp only [hFwdef]
    exact sub_eq_zero.mpr hz
  have hγz : z - Fw z • e b = z := by rw [hz0, zero_smul, sub_zero]
  have hvan' : ∀ᶠ y in 𝓝 z, F (y - Fw y • e b) = 0 :=
    hvan.mono fun y hy => by rw [← hshear]; exact hy
  
  have chain : ∀ (i : Fin 3) (h : E3 → ℝ) (y : E3), DifferentiableAt ℝ h (y - Fw y • e b) →
      DifferentiableAt ℝ Fw y →
      DifferentiableAt ℝ (fun x => h (x - Fw x • e b)) y ∧
      partialDeriv i (fun x => h (x - Fw x • e b)) y =
        partialDeriv i h (y - Fw y • e b) -
          partialDeriv i Fw y * partialDeriv b h (y - Fw y • e b) := by
    intro i h y hh hFwy
    have hγ : HasFDerivAt (fun x : E3 => x - Fw x • e b)
        (ContinuousLinearMap.id ℝ E3 - (fderiv ℝ Fw y).smulRight (e b)) y :=
      (hasFDerivAt_id y).sub (hFwy.hasFDerivAt.smul_const (e b))
    have hc := hh.hasFDerivAt.comp y hγ
    refine ⟨hc.differentiableAt, ?_⟩
    unfold partialDeriv
    rw [show (fun x => h (x - Fw x • e b)) = h ∘ (fun x : E3 => x - Fw x • e b) from rfl,
      hc.fderiv]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.id_apply, ContinuousLinearMap.smulRight_apply, map_sub, map_smul,
      smul_eq_mul]
  
  have hγc : Tendsto (fun x : E3 => x - Fw x • e b) (𝓝 z) (𝓝 z) := by
    have hcont : ContinuousAt (fun x : E3 => x - Fw x • e b) z :=
      continuousAt_id.sub (hFw.continuousAt.smul continuousAt_const)
    have h : Tendsto (fun x : E3 => x - Fw x • e b) (𝓝 z) (𝓝 (z - Fw z • e b)) := hcont.tendsto
    rwa [hγz] at h
  have hFev : ∀ᶠ x in 𝓝 z, DifferentiableAt ℝ F x :=
    (hF.eventually (by simp)).mono fun x hx => hx.differentiableAt (by simp)
  have hFwev : ∀ᶠ x in 𝓝 z, DifferentiableAt ℝ Fw x :=
    (hFw.eventually (by simp)).mono fun x hx => hx.differentiableAt (by simp)
  have hFγ : ∀ᶠ y in 𝓝 z, DifferentiableAt ℝ F (y - Fw y • e b) := hγc.eventually hFev
  have hfirst : ∀ᶠ y in 𝓝 z, ∀ j : Fin 3,
      partialDeriv j F (y - Fw y • e b) -
        partialDeriv j Fw y * partialDeriv b F (y - Fw y • e b) = 0 := by
    filter_upwards [hFγ, hFwev, hvan'.eventually_nhds] with y h1 h2 h3 j
    obtain ⟨-, hc⟩ := chain j F y h1 h2
    rw [← hc]
    have h3' : (fun x => F (x - Fw x • e b)) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := h3
    unfold partialDeriv
    rw [h3'.fderiv_eq]
    simp
  refine ⟨fun j => ?_, ?_⟩
  · have h := hfirst.self_of_nhds j
    rw [hγz] at h
    linear_combination h
  
  have hdF : ∀ k, DifferentiableAt ℝ (partialDeriv k F) z := by
    intro k
    have h1 : DifferentiableAt ℝ (fderiv ℝ F) z :=
      (hF.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    exact h1.clm_apply (differentiableAt_const (e k))
  have hdFw : ∀ k, DifferentiableAt ℝ (partialDeriv k Fw) z := by
    intro k
    have h1 : DifferentiableAt ℝ (fderiv ℝ Fw) z :=
      (hFw.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    exact h1.clm_apply (differentiableAt_const (e k))
  have hFwz : DifferentiableAt ℝ Fw z := hFw.differentiableAt (by norm_num)
  have hdF' : ∀ k, DifferentiableAt ℝ (partialDeriv k F) (z - Fw z • e b) := fun k => by
    rw [hγz]; exact hdF k
  refine ⟨fun j => partialDeriv b (partialDeriv j F) z -
      partialDeriv j Fw z * partialDeriv b (partialDeriv b F) z,
    fun i => partialDeriv i (partialDeriv b F) z, fun i j => ?_⟩
  obtain ⟨hA1d, hA1⟩ := chain i (partialDeriv j F) z (hdF' j) hFwz
  obtain ⟨hA3d, hA3⟩ := chain i (partialDeriv b F) z (hdF' b) hFwz
  rw [hγz] at hA1 hA3
  have hev : (fun y => partialDeriv j F (y - Fw y • e b) -
      partialDeriv j Fw y * partialDeriv b F (y - Fw y • e b)) =ᶠ[𝓝 z] fun _ => (0 : ℝ) :=
    hfirst.mono fun y hy => hy j
  have hΨ0 := hev.fderiv_eq (𝕜 := ℝ)
  have hmul : DifferentiableAt ℝ
      (fun y => partialDeriv j Fw y * partialDeriv b F (y - Fw y • e b)) z :=
    (hdFw j).mul hA3d
  have hc0 : fderiv ℝ (fun _ : E3 => (0 : ℝ)) z = 0 := by simp
  rw [fderiv_fun_sub hA1d hmul, fderiv_fun_mul (hdFw j) hA3d, hc0] at hΨ0
  have hΨ := congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hΨ0
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul, fderiv_const, Pi.zero_apply,
    ContinuousLinearMap.zero_apply] at hΨ
  change partialDeriv i (fun y => partialDeriv j F (y - Fw y • e b)) z -
      (partialDeriv j Fw z * partialDeriv i (fun y => partialDeriv b F (y - Fw y • e b)) z +
        partialDeriv b F (z - Fw z • e b) * partialDeriv i (partialDeriv j Fw) z) = 0 at hΨ
  rw [hA1, hA3, hγz] at hΨ
  beta_reduce
  linear_combination hΨ

theorem tangent_hess_sq_le (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (y : E3)
    (hG : (G y).PosDef) (hH : ∀ i j : Fin 3, hessLoc G f i j y = hessLoc G f j i y)
    (hξ : ∃ k : Fin 3, partialDeriv k f y ≠ 0) (t t' : Fin 3 → ℝ)
    (ht : ∑ i : Fin 3, partialDeriv i f y * t i = 0)
    (ht' : ∑ i : Fin 3, partialDeriv i f y * t' i = 0) :
    (∑ i : Fin 3, ∑ j : Fin 3, t i * hessLoc G f i j y * t' j) ^ 2 ≤
      (∑ i : Fin 3, ∑ j : Fin 3, t i * G y i j * t j) *
        (∑ i : Fin 3, ∑ j : Fin 3, t' i * G y i j * t' j) *
        ((∑ a : Fin 3, ∑ c : Fin 3, (G y)⁻¹ a c * partialDeriv a f y * partialDeriv c f y) *
          secondFundSq G f y) :=
by
  have key : ∀ (A P H : Matrix (Fin 3) (Fin 3) ℝ) (ξ ν t t' : Fin 3 → ℝ) (S : ℝ),
      A.PosDef → ξ ≠ 0 → (∀ i, ν i = ∑ a : Fin 3, A⁻¹ i a * ξ a) →
      S = ∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ a b * ξ a * ξ b →
      (∀ i j, P i j = A⁻¹ i j - ν i * ν j / S) → (∀ i j, H i j = H j i) →
      ∑ i : Fin 3, ξ i * t i = 0 → ∑ i : Fin 3, ξ i * t' i = 0 →
      (∑ i : Fin 3, ∑ j : Fin 3, t i * H i j * t' j) ^ 2 ≤
        (∑ i : Fin 3, ∑ j : Fin 3, t i * A i j * t j) *
          (∑ i : Fin 3, ∑ j : Fin 3, t' i * A i j * t' j) *
          (S * ((∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
            P i j * H j k * P k l * H l i) / S)) := by
    intro A P H ξ ν t t' S hA hξ hν hS hP hH ht ht'
    obtain ⟨W, hWdef⟩ : ∃ W, W = A⁻¹ := ⟨_, rfl⟩
    rw [← hWdef] at hν hS hP
    have hW : W.PosDef := by rw [hWdef]; exact hA.inv
    have hWA : W * A = 1 := by
      rw [hWdef]; exact Matrix.nonsing_inv_mul A (isUnit_iff_ne_zero.mpr hA.det_pos.ne')
    have hWs : ∀ i j, W i j = W j i := by
      intro i j
      have h := hW.isHermitian.apply i j
      simp only [star_trivial] at h
      exact h.symm
    have hSpos : 0 < S := by
      have h := hW.dotProduct_mulVec_pos hξ
      have e : dotProduct (star ξ) (Matrix.mulVec W ξ) = S := by
        rw [hS]
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
        ring
      linarith
    have hS0 : S ≠ 0 := hSpos.ne'
    
    have hquad : ∀ (a : ℝ) (v w : Fin 3 → ℝ),
        dotProduct (star (v - a • w)) (Matrix.mulVec W (v - a • w)) =
          (∑ i : Fin 3, ∑ j : Fin 3, v i * W i j * v j)
            - 2 * a * (∑ i : Fin 3, ∑ j : Fin 3, v i * W i j * w j)
            + a ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, w i * W i j * w j) := by
      intro a v w
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Pi.sub_apply,
        Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
      rw [hWs 1 0, hWs 2 0, hWs 2 1]
      ring
    
    have hPsd : P.PosSemidef := by
      refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ ?_
      · ext i j
        simp only [Matrix.conjTranspose_apply, star_trivial, hP, hWs j i]
        ring
      · intro x
        have h0 := hW.posSemidef.dotProduct_mulVec_nonneg
          (x - ((∑ i : Fin 3, x i * ν i) / S) • ξ)
        rw [hquad] at h0
        have e1 : ∑ i : Fin 3, ∑ j : Fin 3, x i * W i j * ξ j = ∑ i : Fin 3, x i * ν i := by
          simp only [hν, Fin.sum_univ_three]; ring
        have e2 : ∑ i : Fin 3, ∑ j : Fin 3, ξ i * W i j * ξ j = S := by
          rw [hS]; simp only [Fin.sum_univ_three]; ring
        have e3 : dotProduct (star x) (Matrix.mulVec P x) =
            (∑ i : Fin 3, ∑ j : Fin 3, x i * W i j * x j)
            - (∑ i : Fin 3, x i * ν i) ^ 2 / S := by
          simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, hP,
            Fin.sum_univ_three]
          ring
        rw [e1, e2] at h0
        rw [e3]
        have e4 : (∑ i : Fin 3, x i * ν i) ^ 2 / S =
            2 * ((∑ i : Fin 3, x i * ν i) / S) * (∑ i : Fin 3, x i * ν i) -
              ((∑ i : Fin 3, x i * ν i) / S) ^ 2 * S := by
          field_simp
          ring
        linarith
    
    have hWu : ∀ s : Fin 3 → ℝ, Matrix.mulVec W (Matrix.mulVec A s) = s := by
      intro s; rw [Matrix.mulVec_mulVec, hWA, Matrix.one_mulVec]
    have hνu : ∀ u : Fin 3 → ℝ,
        ∑ j : Fin 3, ν j * u j = ∑ a : Fin 3, ξ a * (Matrix.mulVec W u) a := by
      intro u
      simp only [hν, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      rw [hWs 1 0, hWs 2 0, hWs 2 1]
      ring
    have hPu : ∀ (u : Fin 3 → ℝ) (i : Fin 3),
        (Matrix.mulVec P u) i = (Matrix.mulVec W u) i - ν i / S * ∑ j : Fin 3, ν j * u j := by
      intro u i
      simp only [Matrix.mulVec, dotProduct, hP, Fin.sum_univ_three]
      ring
    have hrec : ∀ s : Fin 3 → ℝ, ∑ i : Fin 3, ξ i * s i = 0 →
        ∀ i, s i = ∑ j : Fin 3, P i j * (Matrix.mulVec A s) j := by
      intro s hs i
      have h1 := hPu (Matrix.mulVec A s) i
      rw [hνu, hWu, hs, mul_zero, sub_zero] at h1
      exact h1.symm
    
    obtain ⟨B, hB⟩ := Matrix.posSemidef_iff_eq_conjTranspose_mul_self.mp hPsd
    have hPB : ∀ i j, P i j = ∑ α : Fin 3, B α i * B α j := by
      intro i j
      rw [hB, Matrix.mul_apply]
      simp only [Matrix.conjTranspose_apply, star_trivial]
    obtain ⟨u, hu⟩ : ∃ u, u = Matrix.mulVec A t := ⟨_, rfl⟩
    obtain ⟨u', hu'⟩ : ∃ u', u' = Matrix.mulVec A t' := ⟨_, rfl⟩
    have htu := hrec t ht
    have htu' := hrec t' ht'
    rw [← hu] at htu
    rw [← hu'] at htu'
    have hRt : ∑ i : Fin 3, ∑ j : Fin 3, t i * A i j * t j = ∑ i : Fin 3, t i * u i := by
      rw [hu]; simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]; ring
    have hRt' : ∑ i : Fin 3, ∑ j : Fin 3, t' i * A i j * t' j = ∑ i : Fin 3, t' i * u' i := by
      rw [hu']; simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]; ring
    have hQS : ∀ q : ℝ, S * (q / S) = q := fun q => by field_simp
    rw [hRt, hRt', hQS]
    obtain ⟨x, hx⟩ : ∃ x : Fin 3 → ℝ, ∀ α, x α = ∑ k : Fin 3, B α k * u k :=
      ⟨fun α => ∑ k : Fin 3, B α k * u k, fun _ => rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : Fin 3 → ℝ, ∀ α, y α = ∑ k : Fin 3, B α k * u' k :=
      ⟨fun α => ∑ k : Fin 3, B α k * u' k, fun _ => rfl⟩
    obtain ⟨h, hh⟩ : ∃ h : Fin 3 → Fin 3 → ℝ,
        ∀ α β, h α β = ∑ i : Fin 3, ∑ j : Fin 3, B α i * H i j * B β j :=
      ⟨fun α β => ∑ i : Fin 3, ∑ j : Fin 3, B α i * H i j * B β j, fun _ _ => rfl⟩
    have htx : ∀ i, t i = ∑ α : Fin 3, B α i * x α := by
      intro i; rw [htu i]; simp only [hPB, hx, Fin.sum_univ_three]; ring
    have hty : ∀ i, t' i = ∑ α : Fin 3, B α i * y α := by
      intro i; rw [htu' i]; simp only [hPB, hy, Fin.sum_univ_three]; ring
    have hxx : ∑ i : Fin 3, t i * u i = ∑ α : Fin 3, x α ^ 2 := by
      simp only [htx, hx, Fin.sum_univ_three]; ring
    have hyy : ∑ i : Fin 3, t' i * u' i = ∑ α : Fin 3, y α ^ 2 := by
      simp only [hty, hy, Fin.sum_univ_three]; ring
    have hL : ∑ i : Fin 3, ∑ j : Fin 3, t i * H i j * t' j =
        ∑ α : Fin 3, ∑ β : Fin 3, x α * h α β * y β := by
      simp only [htx, hty, hh, Fin.sum_univ_three]; ring
    have hhs : ∀ α β, h β α = h α β := by
      intro α β
      simp only [hh, Fin.sum_univ_three]
      rw [hH 1 0, hH 2 0, hH 2 1]
      ring
    have hQ1 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
        P i j * H j k * P k l * H l i = ∑ α : Fin 3, ∑ β : Fin 3, h α β * h β α := by
      simp only [hPB, hh, Fin.sum_univ_three]
      ring
    have hQ : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
        P i j * H j k * P k l * H l i = ∑ α : Fin 3, ∑ β : Fin 3, h α β ^ 2 := by
      rw [hQ1]
      refine Finset.sum_congr rfl (fun α _ => Finset.sum_congr rfl (fun β _ => ?_))
      rw [hhs α β]; ring
    rw [hL, hxx, hyy, hQ]
    
    have cs : (∑ p : Fin 3 × Fin 3, x p.1 * y p.2 * h p.1 p.2) ^ 2 ≤
        (∑ p : Fin 3 × Fin 3, (x p.1 * y p.2) ^ 2) * ∑ p : Fin 3 × Fin 3, h p.1 p.2 ^ 2 :=
      Finset.sum_mul_sq_le_sq_mul_sq _ _ _
    have e1 : ∑ p : Fin 3 × Fin 3, x p.1 * y p.2 * h p.1 p.2 =
        ∑ α : Fin 3, ∑ β : Fin 3, x α * h α β * y β := by
      rw [Fintype.sum_prod_type]; simp only [Fin.sum_univ_three]; ring
    have e2 : ∑ p : Fin 3 × Fin 3, (x p.1 * y p.2) ^ 2 =
        (∑ α : Fin 3, x α ^ 2) * ∑ β : Fin 3, y β ^ 2 := by
      rw [Fintype.sum_prod_type]; simp only [Fin.sum_univ_three]; ring
    have e3 : ∑ p : Fin 3 × Fin 3, h p.1 p.2 ^ 2 = ∑ α : Fin 3, ∑ β : Fin 3, h α β ^ 2 := by
      rw [Fintype.sum_prod_type]
    rw [e1, e2, e3] at cs
    exact cs
  have hξv : (fun k : Fin 3 => partialDeriv k f y) ≠ 0 := by
    obtain ⟨k, hk⟩ := hξ
    intro h0
    exact hk (congrFun h0 k)
  unfold secondFundSq
  exact key (G y)
    (Matrix.of fun i j => (G y)⁻¹ i j -
      (∑ a : Fin 3, (G y)⁻¹ i a * partialDeriv a f y) *
        (∑ b : Fin 3, (G y)⁻¹ j b * partialDeriv b f y) /
      (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y))
    (Matrix.of fun i j => hessLoc G f i j y) (fun k => partialDeriv k f y)
    (fun i => ∑ a : Fin 3, (G y)⁻¹ i a * partialDeriv a f y) t t'
    (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y)
    hG hξv (fun i => rfl) rfl (fun i j => rfl) hH ht ht'

theorem coeff_compact_bounds (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Ω : Set E3) (c : E3)
    (R0 : ℝ) (hΩ : IsOpen Ω) (hball : Metric.closedBall c R0 ⊆ Ω)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Ω)
    (hpos : ∀ y ∈ Ω, (G y).PosDef) :
    ∃ m Mx Γ : ℝ, 0 < m ∧ 0 ≤ Mx ∧ 0 ≤ Γ ∧ ∀ y ∈ Metric.closedBall c R0,
      (∀ v : Fin 3 → ℝ, m * ∑ i : Fin 3, v i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, v i * G y i j * v j) ∧
      (∀ v : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, v i * G y i j * v j ≤ Mx * ∑ i : Fin 3, v i ^ 2) ∧
      (∀ v : Fin 3 → ℝ,
        ∑ i : Fin 3, ∑ j : Fin 3, v i * (G y)⁻¹ i j * v j ≤ m⁻¹ * ∑ i : Fin 3, v i ^ 2) ∧
      (∀ k i j : Fin 3, |christoffel G k i j y| ≤ Γ) :=
by
  
  have hs2 : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (v : Fin 3 → ℝ),
      ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j ≤
        (∑ i : Fin 3, ∑ j : Fin 3, |A i j|) * ∑ i : Fin 3, v i ^ 2 := by
    intro A v
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro i _
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro j _
    have hi : v i ^ 2 ≤ ∑ k : Fin 3, v k ^ 2 :=
      Finset.single_le_sum (f := fun k => v k ^ 2) (fun k _ => sq_nonneg (v k))
        (Finset.mem_univ i)
    have hj : v j ^ 2 ≤ ∑ k : Fin 3, v k ^ 2 :=
      Finset.single_le_sum (f := fun k => v k ^ 2) (fun k _ => sq_nonneg (v k))
        (Finset.mem_univ j)
    have h1 : v i * A i j * v j ≤ |A i j| * (|v i| * |v j|) := by
      calc v i * A i j * v j ≤ |v i * A i j * v j| := le_abs_self _
        _ = |A i j| * (|v i| * |v j|) := by rw [abs_mul, abs_mul]; ring
    have h2 : |v i| * |v j| ≤ ∑ k : Fin 3, v k ^ 2 := by
      nlinarith [sq_nonneg (|v i| - |v j|), sq_abs (v i), sq_abs (v j)]
    calc v i * A i j * v j ≤ |A i j| * (|v i| * |v j|) := h1
      _ ≤ |A i j| * ∑ k : Fin 3, v k ^ 2 := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
  
  have hbr : ∀ (C : Matrix (Fin 3) (Fin 3) ℝ) (v : Fin 3 → ℝ),
      ∑ i : Fin 3, ∑ j : Fin 3, v i * C i j * v j = dotProduct v (Matrix.mulVec C v) := by
    intro C v
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
    ring
  have hbrS : ∀ v : Fin 3 → ℝ, ∑ i : Fin 3, v i ^ 2 = dotProduct v v := by
    intro v
    simp only [dotProduct, Fin.sum_univ_three]
    ring
  
  have hs1 : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → ∀ m : ℝ, 0 < m →
      (∀ v : Fin 3 → ℝ,
        ∑ i : Fin 3, ∑ j : Fin 3, v i * A⁻¹ i j * v j ≤ m⁻¹ * ∑ i : Fin 3, v i ^ 2) →
      ∀ v : Fin 3 → ℝ, m * ∑ i : Fin 3, v i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j := by
    intro A hA m hm hinv v
    have hdet : IsUnit A.det := (hA.det_pos.ne').isUnit
    have hBA : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hdet
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hdet
    have hAT : Matrix.transpose A = A := by
      have h := hA.isHermitian
      rw [Matrix.IsHermitian, Matrix.conjTranspose_eq_transpose_of_trivial] at h
      exact h
    have hpsd : 0 ≤ dotProduct (m • v - Matrix.mulVec A v)
        (Matrix.mulVec A⁻¹ (m • v - Matrix.mulVec A v)) := by
      have h := hA.inv.posSemidef.dotProduct_mulVec_nonneg (m • v - Matrix.mulVec A v)
      simpa using h
    have hBz : Matrix.mulVec A⁻¹ (m • v - Matrix.mulVec A v) =
        m • (Matrix.mulVec A⁻¹ v) - v := by
      rw [Matrix.mulVec_sub, Matrix.mulVec_smul, Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
    have hcross : dotProduct (Matrix.mulVec A v) (Matrix.mulVec A⁻¹ v) = dotProduct v v := by
      rw [dotProduct_comm, Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hAT,
        Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]
    have hid : dotProduct (m • v - Matrix.mulVec A v)
        (Matrix.mulVec A⁻¹ (m • v - Matrix.mulVec A v)) =
        m ^ 2 * dotProduct v (Matrix.mulVec A⁻¹ v) - 2 * m * dotProduct v v +
          dotProduct v (Matrix.mulVec A v) := by
      rw [hBz]
      simp only [sub_dotProduct, dotProduct_sub, smul_dotProduct, dotProduct_smul, smul_eq_mul,
        hcross]
      rw [dotProduct_comm (Matrix.mulVec A v) v]
      ring
    have hq := hinv v
    rw [hbr, hbrS] at hq
    rw [hbr, hbrS]
    have hS : 0 ≤ dotProduct v v := by rw [← hbrS]; positivity
    have h3 : m ^ 2 * dotProduct v (Matrix.mulVec A⁻¹ v) ≤ m * dotProduct v v := by
      calc m ^ 2 * dotProduct v (Matrix.mulVec A⁻¹ v) ≤ m ^ 2 * (m⁻¹ * dotProduct v v) :=
            mul_le_mul_of_nonneg_left hq (by positivity)
        _ = m * dotProduct v v := by field_simp
    nlinarith
  
  have hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) Ω := fun i j => (hG i j).continuousOn
  have hGm : ContinuousOn G Ω := continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hGc i j
  have hdetc : ContinuousOn (fun y => (G y).det) Ω :=
    (continuous_id.matrix_det).comp_continuousOn hGm
  have hadjc : ∀ i j : Fin 3, ContinuousOn (fun y => (G y).adjugate i j) Ω := by
    intro i j
    have h : Continuous (fun A : Matrix (Fin 3) (Fin 3) ℝ => A.adjugate i j) :=
      (continuous_apply j).comp ((continuous_apply i).comp (continuous_id.matrix_adjugate))
    exact h.comp_continuousOn hGm
  have hInv : ∀ i j : Fin 3, ContinuousOn (fun y => (G y)⁻¹ i j) Ω := by
    intro i j
    have heq : (fun y => (G y)⁻¹ i j) = fun y => ((G y).det)⁻¹ * (G y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetc.inv₀ (fun y hy => (hpos y hy).det_pos.ne')).mul (hadjc i j)
  have hPD : ∀ l i j : Fin 3, ContinuousOn (fun y => partialDeriv l (fun z => G z i j) y) Ω := by
    intro l i j
    unfold partialDeriv
    exact ((hG i j).continuousOn_fderiv_of_isOpen hΩ (by simp)).clm_apply continuousOn_const
  have hChr : ∀ k i j : Fin 3, ContinuousOn (fun y => christoffel G k i j y) Ω := by
    intro k i j
    unfold christoffel
    exact continuousOn_const.mul (continuousOn_finset_sum _ fun l _ =>
      (hInv k l).mul (((hPD i j l).add (hPD j i l)).sub (hPD l i j)))
  
  have hK : IsCompact (Metric.closedBall c R0) := isCompact_closedBall c R0
  have hPc : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, |G y i j|)
      (Metric.closedBall c R0) :=
    (continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      (hGc i j).abs).mono hball
  have hQc : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, |(G y)⁻¹ i j|)
      (Metric.closedBall c R0) :=
    (continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
      (hInv i j).abs).mono hball
  have hTc : ContinuousOn
      (fun y => ∑ k : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, |christoffel G k i j y|)
      (Metric.closedBall c R0) :=
    (continuousOn_finset_sum _ fun k _ => continuousOn_finset_sum _ fun i _ =>
      continuousOn_finset_sum _ fun j _ => (hChr k i j).abs).mono hball
  obtain ⟨CP, hCP⟩ := hK.exists_bound_of_continuousOn hPc
  obtain ⟨CQ, hCQ⟩ := hK.exists_bound_of_continuousOn hQc
  obtain ⟨CT, hCT⟩ := hK.exists_bound_of_continuousOn hTc
  
  have hm0 : 0 < (max CQ 0 + 1)⁻¹ := inv_pos.2 (by linarith [le_max_right CQ 0])
  refine ⟨(max CQ 0 + 1)⁻¹, max CP 0, max CT 0, hm0, le_max_right _ _, le_max_right _ _, ?_⟩
  intro y hy
  have hyΩ : y ∈ Ω := hball hy
  have hP : ∑ i : Fin 3, ∑ j : Fin 3, |G y i j| ≤ max CP 0 := by
    have h := hCP y hy
    rw [Real.norm_eq_abs] at h
    exact (le_abs_self _).trans (h.trans (le_max_left _ _))
  have hQ : ∑ i : Fin 3, ∑ j : Fin 3, |(G y)⁻¹ i j| ≤ max CQ 0 + 1 := by
    have h := hCQ y hy
    rw [Real.norm_eq_abs] at h
    have := le_max_left CQ 0
    linarith [le_abs_self (∑ i : Fin 3, ∑ j : Fin 3, |(G y)⁻¹ i j|)]
  have hT : ∑ k : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3, |christoffel G k i j y| ≤ max CT 0 := by
    have h := hCT y hy
    rw [Real.norm_eq_abs] at h
    exact (le_abs_self _).trans (h.trans (le_max_left _ _))
  have hS : ∀ v : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, v i ^ 2 :=
    fun v => Finset.sum_nonneg fun i _ => sq_nonneg (v i)
  have hinvb : ∀ v : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, v i * (G y)⁻¹ i j * v j ≤
      (max CQ 0 + 1)⁻¹⁻¹ * ∑ i : Fin 3, v i ^ 2 := by
    intro v
    rw [inv_inv]
    exact (hs2 _ v).trans (mul_le_mul_of_nonneg_right hQ (hS v))
  refine ⟨hs1 (G y) (hpos y hyΩ) _ hm0 hinvb,
    fun v => (hs2 _ v).trans (mul_le_mul_of_nonneg_right hP (hS v)), hinvb, ?_⟩
  intro k i j
  refine le_trans ?_ hT
  calc |christoffel G k i j y| ≤ ∑ j' : Fin 3, |christoffel G k i j' y| :=
        Finset.single_le_sum (f := fun j' => |christoffel G k i j' y|)
          (fun _ _ => abs_nonneg _) (Finset.mem_univ j)
    _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |christoffel G k i' j' y| :=
        Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, |christoffel G k i' j' y|)
          (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _) (Finset.mem_univ i)
    _ ≤ ∑ k' : Fin 3, ∑ i' : Fin 3, ∑ j' : Fin 3, |christoffel G k' i' j' y| :=
        Finset.single_le_sum
          (f := fun k' => ∑ i' : Fin 3, ∑ j' : Fin 3, |christoffel G k' i' j' y|)
          (fun _ _ => Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _)
          (Finset.mem_univ k)

theorem planar_hessian_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (z : E3) (b : Fin 3)
    (w : E3 → ℝ) (m Mx Γ Λ : ℝ) (hm : 0 < m) (hG : (G z).PosDef)
    (hup : ∀ v : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, v i * G z i j * v j ≤ Mx * ∑ i : Fin 3, v i ^ 2)
    (hinv : ∀ v : Fin 3 → ℝ,
      ∑ i : Fin 3, ∑ j : Fin 3, v i * (G z)⁻¹ i j * v j ≤ m⁻¹ * ∑ i : Fin 3, v i ^ 2)
    (hΓ : ∀ k i j : Fin 3, |christoffel G k i j z| ≤ Γ)
    (hw : ContDiffAt ℝ 2 w (coordPlaneProj b z))
    (hpl : ∀ y, w (coordPlaneProj b y) = w y)
    (hslope : ‖fderiv ℝ w (coordPlaneProj b z)‖ ≤ 2)
    (htan : ∀ t t' : Fin 3 → ℝ,
      ∑ i : Fin 3, partialDeriv i (fun y => y b - w (coordPlaneProj b y)) z * t i = 0 →
      ∑ i : Fin 3, partialDeriv i (fun y => y b - w (coordPlaneProj b y)) z * t' i = 0 →
      (∑ i : Fin 3, ∑ j : Fin 3,
          t i * hessLoc G (fun y => y b - w (coordPlaneProj b y)) i j z * t' j) ^ 2 ≤
        (∑ i : Fin 3, ∑ j : Fin 3, t i * G z i j * t j) *
          (∑ i : Fin 3, ∑ j : Fin 3, t' i * G z i j * t' j) *
          ((∑ a : Fin 3, ∑ c : Fin 3, (G z)⁻¹ a c *
              partialDeriv a (fun y => y b - w (coordPlaneProj b y)) z *
              partialDeriv c (fun y => y b - w (coordPlaneProj b y)) z) * Λ ^ 2)) :
    ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b z)‖ ≤
      4 * (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) :=
by
  classical
  
  have hea : (e b) b = 1 := by simp [e]
  have hP1 : ∀ (y : E3) (s : ℝ), coordPlaneProj b (y + s • e b) = coordPlaneProj b y := by
    intro y s
    simp only [coordPlaneProj, PiLp.add_apply, PiLp.smul_apply, hea, smul_eq_mul, mul_one,
      add_smul]
    abel
  have hP4 : ∀ (y : E3) (s : ℝ), w (y + s • e b) = w y := by
    intro y s
    rw [← hpl (y + s • e b), hP1, hpl]
  have hPcd : ContDiff ℝ 2 (coordPlaneProj b) := by unfold coordPlaneProj; fun_prop
  have hwz : ContDiffAt ℝ 2 w z := by
    have h := hw.comp z hPcd.contDiffAt
    have h' : (w ∘ coordPlaneProj b) = w := funext hpl
    rwa [h'] at h
  have hP2 : (fun y => w (y + (z b) • e b)) = w := funext fun y => hP4 y (z b)
  have hP3 : coordPlaneProj b z + (z b) • e b = z := by simp [coordPlaneProj]
  have hL : fderiv ℝ w (coordPlaneProj b z) = fderiv ℝ w z := by
    have h := fderiv_comp_add_right (𝕜 := ℝ) (f := w) (x := coordPlaneProj b z) ((z b) • e b)
    rw [hP2, hP3] at h
    exact h
  have hB : iteratedFDeriv ℝ 2 w (coordPlaneProj b z) = iteratedFDeriv ℝ 2 w z := by
    have h := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := w) 2 ((z b) • e b)
      (coordPlaneProj b z)
    rw [hP2, hP3] at h
    exact h
  
  have hb0 : ∀ y : E3, fderiv ℝ w y (e b) = 0 := by
    intro y
    by_cases hd : DifferentiableAt ℝ w y
    · have hℓ : HasDerivAt (fun s : ℝ => y + s • e b) (e b) 0 := by
        have h := ((hasDerivAt_id (0:ℝ)).smul_const (e b)).const_add y
        simpa using h
      have hd' : HasFDerivAt w (fderiv ℝ w y) ((fun s : ℝ => y + s • e b) 0) := by
        simpa using hd.hasFDerivAt
      have h1 := hd'.comp_hasDerivAt (0:ℝ) hℓ
      have h2 : (w ∘ fun s : ℝ => y + s • e b) = fun _ => w y := funext fun s => hP4 y s
      rw [h2] at h1
      exact h1.unique (hasDerivAt_const 0 (w y))
    · rw [fderiv_zero_of_not_differentiableAt hd]
      rfl
  
  set Fw : E3 → ℝ := fun y => y b - w (coordPlaneProj b y) with hFw
  have hF : Fw = fun y => y b - w y := funext fun y => by
    show y b - w (coordPlaneProj b y) = y b - w y
    rw [hpl]
  have hd1 : ∀ y, DifferentiableAt ℝ w y → ∀ l : Fin 3,
      partialDeriv l (fun y : E3 => y b - w y) y =
        (if l = b then (1:ℝ) else 0) - partialDeriv l w y := by
    intro y hy l
    have hproj : HasFDerivAt (fun y : E3 => y b) (EuclideanSpace.proj b : E3 →L[ℝ] ℝ) y :=
      (EuclideanSpace.proj b : E3 →L[ℝ] ℝ).hasFDerivAt
    have h := (hproj.sub hy.hasFDerivAt).fderiv
    unfold partialDeriv
    rw [show (fun y : E3 => y b - w y) = (fun y : E3 => y b) - w from rfl, h]
    by_cases hl : l = b
    · subst hl; simp [e]
    · simp [e, hl, Ne.symm hl, EuclideanSpace.single_apply]
  have hev : ∀ᶠ y in 𝓝 z, DifferentiableAt ℝ w y :=
    (hwz.eventually (by simp)).mono fun y hy => hy.differentiableAt (by norm_num)
  have hξF : ∀ k, partialDeriv k Fw z = (if k = b then (1:ℝ) else 0) - partialDeriv k w z := by
    intro k
    rw [hF]
    exact hd1 z (hwz.differentiableAt (by norm_num)) k
  have hDF : ∀ k l, partialDeriv k (partialDeriv l Fw) z = -partialDeriv k (partialDeriv l w) z := by
    intro k l
    rw [hF]
    have h' : partialDeriv l (fun y : E3 => y b - w y) =ᶠ[𝓝 z]
        fun y => (if l = b then (1:ℝ) else 0) - partialDeriv l w y :=
      hev.mono fun y hy => hd1 y hy l
    show fderiv ℝ (partialDeriv l (fun y : E3 => y b - w y)) z (e k) =
      -(fderiv ℝ (partialDeriv l w) z (e k))
    rw [h'.fderiv_eq, fderiv_const_sub]
    rfl
  
  have hkey : ∀ a c, partialDeriv a (partialDeriv c w) z =
      fderiv ℝ (fderiv ℝ w) z (e a) (e c) := by
    have hd : DifferentiableAt ℝ (fderiv ℝ w) z :=
      (hwz.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    intro a c
    show fderiv ℝ (fun x => fderiv ℝ w x (e c)) z (e a) = _
    rw [fderiv_clm_apply hd (differentiableAt_const _)]
    simp
  have hsy : IsSymmSndFDerivAt ℝ w z :=
    hwz.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
  have hW0 : ∀ k, partialDeriv k (partialDeriv b w) z = 0 ∧
      partialDeriv b (partialDeriv k w) z = 0 := by
    have h0 : partialDeriv b w = fun _ => 0 := funext fun y => hb0 y
    have h1 : ∀ k, partialDeriv k (partialDeriv b w) z = 0 := by
      intro k
      rw [h0]
      simp [partialDeriv]
    intro k
    refine ⟨h1 k, ?_⟩
    rw [hkey, hsy (e b) (e k), ← hkey]
    exact h1 k
  
  have hξb : partialDeriv b Fw z = 1 := by
    rw [hξF b, if_pos rfl, show partialDeriv b w z = 0 from hb0 z, sub_zero]
  have hξ2 : ∀ k, |partialDeriv k Fw z| ≤ 2 := by
    intro k
    by_cases hk : k = b
    · subst hk; rw [hξb]; norm_num
    · rw [hξF k, if_neg hk, zero_sub, abs_neg]
      calc |partialDeriv k w z| = ‖fderiv ℝ w z (e k)‖ := by rw [Real.norm_eq_abs]; rfl
        _ ≤ ‖fderiv ℝ w z‖ * ‖e k‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ w z‖ := by simp [EuclideanSpace.norm_single]
        _ ≤ 2 := by rw [← hL]; exact hslope
  have hDb : ∀ k, partialDeriv k (partialDeriv b Fw) z = 0 ∧
      partialDeriv b (partialDeriv k Fw) z = 0 := by
    intro k
    refine ⟨?_, ?_⟩
    · rw [hDF, (hW0 k).1, neg_zero]
    · rw [hDF, (hW0 k).2, neg_zero]
  have hΓ0 : 0 ≤ Γ := (abs_nonneg _).trans (hΓ 0 0 0)
  have hξs : ∑ c : Fin 3, |partialDeriv c Fw z| ≤ 5 := by
    have h1 : ∀ c, |partialDeriv c Fw z| ≤ 2 - (if c = b then (1:ℝ) else 0) := by
      intro c
      by_cases hc : c = b
      · subst hc; rw [hξb, if_pos rfl]; norm_num
      · rw [if_neg hc]; linarith [hξ2 c]
    calc ∑ c : Fin 3, |partialDeriv c Fw z|
        ≤ ∑ c : Fin 3, (2 - (if c = b then (1:ℝ) else 0)) :=
          Finset.sum_le_sum fun c _ => h1 c
      _ = 5 := by simp [Finset.sum_sub_distrib]; norm_num
  have hξ9 : ∑ c : Fin 3, partialDeriv c Fw z ^ 2 ≤ 9 := by
    have h1 : ∀ c, partialDeriv c Fw z ^ 2 ≤ 4 - 3 * (if c = b then (1:ℝ) else 0) := by
      intro c
      by_cases hc : c = b
      · subst hc; rw [hξb, if_pos rfl]; norm_num
      · rw [if_neg hc, ← sq_abs]
        have := hξ2 c
        nlinarith [abs_nonneg (partialDeriv c Fw z)]
    calc ∑ c : Fin 3, partialDeriv c Fw z ^ 2
        ≤ ∑ c : Fin 3, (4 - 3 * (if c = b then (1:ℝ) else 0)) :=
          Finset.sum_le_sum fun c _ => h1 c
      _ = 9 := by simp [Finset.sum_sub_distrib]; norm_num
  have hC : ∀ k l, |∑ c : Fin 3, christoffel G c k l z * partialDeriv c Fw z| ≤ 5 * Γ := by
    intro k l
    calc |∑ c : Fin 3, christoffel G c k l z * partialDeriv c Fw z|
        ≤ ∑ c : Fin 3, |christoffel G c k l z * partialDeriv c Fw z| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ c : Fin 3, Γ * |partialDeriv c Fw z| := by
          refine Finset.sum_le_sum fun c _ => ?_
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right (hΓ c k l) (abs_nonneg _)
      _ = Γ * ∑ c : Fin 3, |partialDeriv c Fw z| := by rw [Finset.mul_sum]
      _ ≤ Γ * 5 := mul_le_mul_of_nonneg_left hξs hΓ0
      _ = 5 * Γ := by ring
  
  have L1 : ∀ (t y : Fin 3 → ℝ) (a : Fin 3) (c : ℝ),
      (∀ k, t k = (if k = a then (1:ℝ) else 0) - c * (if k = b then (1:ℝ) else 0)) →
      ∑ k : Fin 3, y k * t k = y a - c * y b := by
    intro t y a c ht
    simp only [ht, mul_sub, Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  have L2 : ∀ (t y : Fin 3 → ℝ) (a : Fin 3) (c : ℝ),
      (∀ k, t k = (if k = a then (1:ℝ) else 0) - c * (if k = b then (1:ℝ) else 0)) →
      ∑ k : Fin 3, t k * y k = y a - c * y b := by
    intro t y a c ht
    rw [← L1 t y a c ht]
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  
  have hquad : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → ∀ v : Fin 3 → ℝ,
      0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j := by
    intro A hA v
    by_cases hv : v = 0
    · subst hv; simp
    · have h1 := hA.dotProduct_mulVec_pos hv
      have h3 : dotProduct (star v) (A.mulVec v) =
          ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j := by
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
        apply Finset.sum_congr rfl; intro i _
        apply Finset.sum_congr rfl; intro j _
        ring
      rw [← h3]; exact h1.le
  have hMx : 0 ≤ Mx := by
    have h1 := hup (fun _ => 1)
    have h2 := hquad _ hG (fun _ => 1)
    simp only [one_pow, one_mul, mul_one, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul] at h1 h2
    push_cast at h1
    linarith
  have hα : ∀ v : Fin 3 → ℝ, ∑ k : Fin 3, v k ^ 2 ≤ 5 →
      0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, v i * G z i j * v j ∧
        ∑ i : Fin 3, ∑ j : Fin 3, v i * G z i j * v j ≤ 5 * Mx := by
    intro v hv
    refine ⟨hquad _ hG v, (hup v).trans ?_⟩
    have := mul_le_mul_of_nonneg_left hv hMx
    linarith
  have hS0 : 0 ≤ ∑ a : Fin 3, ∑ c : Fin 3, (G z)⁻¹ a c * partialDeriv a Fw z *
      partialDeriv c Fw z := by
    have h := hquad _ hG.inv (fun k => partialDeriv k Fw z)
    refine le_of_le_of_eq h ?_
    apply Finset.sum_congr rfl; intro i _
    apply Finset.sum_congr rfl; intro j _
    ring
  have hS9 : ∑ a : Fin 3, ∑ c : Fin 3, (G z)⁻¹ a c * partialDeriv a Fw z *
      partialDeriv c Fw z ≤ 9 / m := by
    have h := hinv (fun k => partialDeriv k Fw z)
    have e1 : ∑ a : Fin 3, ∑ c : Fin 3, (G z)⁻¹ a c * partialDeriv a Fw z *
        partialDeriv c Fw z = ∑ i : Fin 3, ∑ j : Fin 3,
          partialDeriv i Fw z * (G z)⁻¹ i j * partialDeriv j Fw z := by
      apply Finset.sum_congr rfl; intro i _
      apply Finset.sum_congr rfl; intro j _
      ring
    rw [e1]
    refine h.trans ?_
    have hm' : 0 ≤ m⁻¹ := inv_nonneg.mpr hm.le
    calc m⁻¹ * ∑ i : Fin 3, partialDeriv i Fw z ^ 2 ≤ m⁻¹ * 9 :=
          mul_le_mul_of_nonneg_left hξ9 hm'
      _ = 9 / m := by ring
  have hR0 : 0 ≤ 5 * Mx * |Λ| * Real.sqrt (9 / m) :=
    mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hMx) (abs_nonneg _)) (Real.sqrt_nonneg _)
  
  have hent : ∀ i j, i ≠ b → j ≠ b →
      |partialDeriv i (partialDeriv j w) z| ≤ 5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ := by
    intro i j hi hj
    obtain ⟨t, ht⟩ : ∃ t : Fin 3 → ℝ, ∀ k, t k = (if k = i then (1:ℝ) else 0) -
        partialDeriv i Fw z * (if k = b then (1:ℝ) else 0) := ⟨_, fun k => rfl⟩
    obtain ⟨t', ht'⟩ : ∃ t : Fin 3 → ℝ, ∀ k, t k = (if k = j then (1:ℝ) else 0) -
        partialDeriv j Fw z * (if k = b then (1:ℝ) else 0) := ⟨_, fun k => rfl⟩
    have ho : ∑ k : Fin 3, partialDeriv k Fw z * t k = 0 := by
      have h := L1 t (fun k => partialDeriv k Fw z) i _ ht
      simp only at h
      rw [h, hξb]; ring
    have ho' : ∑ k : Fin 3, partialDeriv k Fw z * t' k = 0 := by
      have h := L1 t' (fun k => partialDeriv k Fw z) j _ ht'
      simp only at h
      rw [h, hξb]; ring
    have hnorm : ∀ (s : Fin 3 → ℝ) (a : Fin 3), a ≠ b →
        (∀ k, s k = (if k = a then (1:ℝ) else 0) -
          partialDeriv a Fw z * (if k = b then (1:ℝ) else 0)) →
        ∑ k : Fin 3, s k ^ 2 ≤ 5 := by
      intro s a ha hs
      have hsa : s a = 1 := by rw [hs, if_pos rfl, if_neg ha]; ring
      have hsb : s b = -partialDeriv a Fw z := by rw [hs, if_neg (Ne.symm ha), if_pos rfl]; ring
      have h := L1 s s a _ hs
      have h2 : ∑ k : Fin 3, s k ^ 2 = ∑ k : Fin 3, s k * s k :=
        Finset.sum_congr rfl fun k _ => sq (s k)
      rw [h2, h, hsa, hsb]
      have := hξ2 a
      have h3 : partialDeriv a Fw z ^ 2 ≤ 4 := by
        rw [← sq_abs]; nlinarith [abs_nonneg (partialDeriv a Fw z)]
      nlinarith
    have hn := hnorm t i hi ht
    have hn' := hnorm t' j hj ht'
    have hbil : ∀ X : Fin 3 → Fin 3 → ℝ, ∑ k : Fin 3, ∑ l : Fin 3, t k * X k l * t' l =
        (X i j - partialDeriv j Fw z * X i b) -
          partialDeriv i Fw z * (X b j - partialDeriv j Fw z * X b b) := by
      intro X
      have h1 : ∀ k, ∑ l : Fin 3, t k * X k l * t' l =
          t k * (X k j - partialDeriv j Fw z * X k b) := by
        intro k
        have h := L1 t' (fun l => t k * X k l) j _ ht'
        rw [h]; ring
      rw [Finset.sum_congr rfl fun k _ => h1 k]
      exact L2 t (fun k => X k j - partialDeriv j Fw z * X k b) i _ ht
    have hX := htan t t' ho ho'
    have hXe := hbil (fun k l => hessLoc G Fw k l z)
    have hH : ∀ k l, hessLoc G Fw k l z = partialDeriv k (partialDeriv l Fw) z -
        ∑ c : Fin 3, christoffel G c k l z * partialDeriv c Fw z := fun k l => rfl
    rw [hH i j, hH i b, hH b j, hH b b, (hDb i).1, (hDb j).2, (hDb b).1] at hXe
    obtain ⟨hα0, hα5⟩ := hα t hn
    obtain ⟨hα0', hα5'⟩ := hα t' hn'
    have hprod : (∑ k : Fin 3, ∑ l : Fin 3, t k * hessLoc G Fw k l z * t' l) ^ 2 ≤
        (5 * Mx * |Λ| * Real.sqrt (9 / m)) ^ 2 := by
      refine hX.trans ?_
      have h1 := mul_le_mul hα5 hα5' hα0' (mul_nonneg (by norm_num) hMx)
      have h2 := mul_le_mul_of_nonneg_right hS9 (sq_nonneg Λ)
      have h3 := mul_le_mul h1 h2 (mul_nonneg hS0 (sq_nonneg Λ)) (mul_self_nonneg _)
      refine h3.trans (le_of_eq ?_)
      rw [mul_pow, mul_pow, mul_pow, sq_abs, Real.sq_sqrt (div_nonneg (by norm_num) hm.le)]
      ring
    have hXabs := abs_le_of_sq_le_sq hprod hR0
    have p2 : |partialDeriv j Fw z * ∑ c : Fin 3, christoffel G c i b z * partialDeriv c Fw z|
        ≤ 2 * (5 * Γ) := by
      rw [abs_mul]; exact mul_le_mul (hξ2 j) (hC i b) (abs_nonneg _) (by norm_num)
    have p3 : |partialDeriv i Fw z * ∑ c : Fin 3, christoffel G c b j z * partialDeriv c Fw z|
        ≤ 2 * (5 * Γ) := by
      rw [abs_mul]; exact mul_le_mul (hξ2 i) (hC b j) (abs_nonneg _) (by norm_num)
    have p4 : |partialDeriv i Fw z * (partialDeriv j Fw z *
        ∑ c : Fin 3, christoffel G c b b z * partialDeriv c Fw z)| ≤ 2 * (2 * (5 * Γ)) := by
      rw [abs_mul, abs_mul]
      exact mul_le_mul (hξ2 i) (mul_le_mul (hξ2 j) (hC b b) (abs_nonneg _) (by norm_num))
        (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by norm_num)
    rw [← abs_neg, ← hDF i j]
    obtain ⟨a1, a2⟩ := abs_le.mp hXabs
    obtain ⟨b1, b2⟩ := abs_le.mp (hC i j)
    obtain ⟨c1, c2⟩ := abs_le.mp p2
    obtain ⟨d1, d2⟩ := abs_le.mp p3
    obtain ⟨e1, e2⟩ := abs_le.mp p4
    rw [abs_le]
    constructor <;> linarith
  
  have hne : ∀ b' : Fin 3, b' + 1 ≠ b' := by decide
  have hK1 : 0 ≤ 5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ :=
    (abs_nonneg _).trans (hent (b + 1) (b + 1) (hne b) (hne b))
  have hbasis : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hbil2 : ∀ u v : E3, fderiv ℝ (fderiv ℝ w) z u v =
      ∑ a : Fin 3, ∑ c : Fin 3, u a * v c * fderiv ℝ (fderiv ℝ w) z (e a) (e c) := by
    intro u v
    conv_lhs => rw [hbasis u, hbasis v]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => ?_
    ring
  have hentB : ∀ a c, |fderiv ℝ (fderiv ℝ w) z (e a) (e c)| ≤
      (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) *
        ((if a = b then (0:ℝ) else 1) * (if c = b then (0:ℝ) else 1)) := by
    intro a c
    rw [← hkey]
    by_cases ha : a = b
    · subst ha; simp [(hW0 c).2]
    · by_cases hc : c = b
      · subst hc; simp [ha, (hW0 a).1]
      · simp only [ha, hc, if_false, mul_one]; exact hent a c ha hc
  have hχ : ∀ b' : Fin 3, ∑ a : Fin 3, ∑ c : Fin 3,
      (if a = b' then (0:ℝ) else 1) * (if c = b' then (0:ℝ) else 1) = 4 := by
    intro b'
    fin_cases b' <;> simp [Fin.sum_univ_three] <;> norm_num
  have hop : ‖iteratedFDeriv ℝ 2 w z‖ ≤ 4 * (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) := by
    refine ContinuousMultilinearMap.opNorm_le_bound (by linarith) fun v => ?_
    rw [iteratedFDeriv_two_apply, Fin.prod_univ_two, hbil2, Real.norm_eq_abs]
    calc |∑ a : Fin 3, ∑ c : Fin 3, v 0 a * v 1 c * fderiv ℝ (fderiv ℝ w) z (e a) (e c)|
        ≤ ∑ a : Fin 3, |∑ c : Fin 3, v 0 a * v 1 c * fderiv ℝ (fderiv ℝ w) z (e a) (e c)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ a : Fin 3, ∑ c : Fin 3, |v 0 a * v 1 c * fderiv ℝ (fderiv ℝ w) z (e a) (e c)| :=
          Finset.sum_le_sum fun a _ => Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ a : Fin 3, ∑ c : Fin 3, ‖v 0‖ * ‖v 1‖ *
            ((5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) *
              ((if a = b then (0:ℝ) else 1) * (if c = b then (0:ℝ) else 1))) := by
          refine Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun c _ => ?_
          rw [abs_mul, abs_mul]
          have h1 : |v 0 a| ≤ ‖v 0‖ := by
            have := PiLp.norm_apply_le (v 0) a; rwa [Real.norm_eq_abs] at this
          have h2 : |v 1 c| ≤ ‖v 1‖ := by
            have := PiLp.norm_apply_le (v 1) c; rwa [Real.norm_eq_abs] at this
          exact mul_le_mul (mul_le_mul h1 h2 (abs_nonneg _) (norm_nonneg _)) (hentB a c)
            (abs_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      _ = ‖v 0‖ * ‖v 1‖ * (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) *
            ∑ a : Fin 3, ∑ c : Fin 3,
              ((if a = b then (0:ℝ) else 1) * (if c = b then (0:ℝ) else 1)) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun c _ => ?_
          ring
      _ = 4 * (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ) * (‖v 0‖ * ‖v 1‖) := by
          rw [hχ b]; ring
  rw [hB]
  exact hop

theorem graph_level_transfer [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p : M)
    (R0 Λ : ℝ) (hR0 : 0 < R0)
    (hball : Metric.closedBall (chartAt E3 p p) R0 ⊆ (chartAt E3 p).target) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ Sig : Set M, IsMinimalSurfaceSet g Sig → HasCurvatureBound g Sig Λ →
      ∀ x ∈ Sig, x ∈ (chartAt E3 p).source →
      ∀ (b : Fin 3) (w : E3 → ℝ) (r : ℝ), 0 < r →
        ContDiffAt ℝ 2 w (coordPlaneProj b (chartAt E3 p x)) →
        (∀ y, w (coordPlaneProj b y) = w y) →
        (chartAt E3 p x) b = w (coordPlaneProj b (chartAt E3 p x)) →
        (∀ y, ‖coordPlaneProj b (y - chartAt E3 p x)‖ < r →
          coordPlaneProj b y + w (coordPlaneProj b y) • e b ∈
            (chartAt E3 p) '' (Sig ∩ (chartAt E3 p).source)) →
        ((chartAt E3 p x ∈ Metric.closedBall (chartAt E3 p p) R0 →
            ‖fderiv ℝ w (coordPlaneProj b (chartAt E3 p x))‖ ≤ 2 →
            ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b (chartAt E3 p x))‖ ≤ K) ∧
          levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
            (fun z => z b - w (coordPlaneProj b z)) (chartAt E3 p x) = 0) :=
by
  classical
  
  have hu : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hξne : ∀ (F : E3 → ℝ) (y : E3), fderiv ℝ F y ≠ 0 →
      ∃ k : Fin 3, partialDeriv k F y ≠ 0 := by
    intro F y hdF
    by_contra h
    push_neg at h
    apply hdF
    refine ContinuousLinearMap.ext fun v => ?_
    rw [ContinuousLinearMap.zero_apply, hu v, map_sum]
    refine Finset.sum_eq_zero fun d _ => ?_
    rw [map_smul, smul_eq_mul]
    rw [show fderiv ℝ F y (e d) = partialDeriv d F y from rfl, h d, mul_zero]
  have hschwarz : ∀ (H : E3 → ℝ) (y : E3), ContDiffAt ℝ 2 H y → ∀ i j : Fin 3,
      partialDeriv i (partialDeriv j H) y = partialDeriv j (partialDeriv i H) y := by
    intro H y hF2 i j
    have hsy : IsSymmSndFDerivAt ℝ H y :=
      hF2.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    have hd : DifferentiableAt ℝ (fderiv ℝ H) y :=
      (hF2.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    have key : ∀ a c : Fin 3,
        partialDeriv a (partialDeriv c H) y = fderiv ℝ (fderiv ℝ H) y (e a) (e c) := by
      intro a c
      show fderiv ℝ (fun x => fderiv ℝ H x (e c)) y (e a) = _
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    rw [key, key]
    exact hsy _ _
  have hquad : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → ∀ v : Fin 3 → ℝ,
      0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j := by
    intro A hA v
    by_cases hv : v = 0
    · subst hv; simp
    · have h1 := hA.dotProduct_mulVec_pos hv
      have h3 : dotProduct (star v) (A.mulVec v) =
          ∑ i : Fin 3, ∑ j : Fin 3, v i * A i j * v j := by
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
        apply Finset.sum_congr rfl; intro i _
        apply Finset.sum_congr rfl; intro j _
        ring
      rw [← h3]; exact h1.le
  
  have hGsymm : ∀ (w : E3) (a c : Fin 3),
      g.coeff (chartAt E3 p).symm w a c = g.coeff (chartAt E3 p).symm w c a :=
    fun w a c => g.symm _ _ _
  have hchr : ∀ (k i j : Fin 3) (w : E3),
      christoffel (g.coeff (chartAt E3 p).symm) k i j w =
        christoffel (g.coeff (chartAt E3 p).symm) k j i w := by
    intro k i j w
    have hf : (fun z => g.coeff (chartAt E3 p).symm z j i) =
        (fun z => g.coeff (chartAt E3 p).symm z i j) := funext fun z => hGsymm z j i
    simp only [christoffel, hf, Fin.sum_univ_three]
    ring
  have hHsym : ∀ (H : E3 → ℝ) (y : E3), ContDiffAt ℝ 2 H y → ∀ i j : Fin 3,
      hessLoc (g.coeff (chartAt E3 p).symm) H i j y =
        hessLoc (g.coeff (chartAt E3 p).symm) H j i y := by
    intro H y hH i j
    simp only [hessLoc]
    rw [hschwarz H y hH i j]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hchr k i j]
  
  have hcontP : ∀ a : Fin 3, Continuous (coordPlaneProj a) := by
    intro a; unfold coordPlaneProj; fun_prop
  have hPcd : ∀ a : Fin 3, ContDiff ℝ 2 (coordPlaneProj a) := by
    intro a; unfold coordPlaneProj; fun_prop
  have hprojcd : ∀ a : Fin 3, ContDiff ℝ 2 (fun y : E3 => y a) := by
    intro a; fun_prop
  have hP0 : ∀ a : Fin 3, coordPlaneProj a 0 = 0 := by
    intro a; simp [coordPlaneProj]
  
  obtain ⟨m, Mx, Γ, hm, hMx, hΓ0, hbd⟩ := coeff_compact_bounds (g.coeff (chartAt E3 p).symm)
    (chartAt E3 p).target (chartAt E3 p p) R0 (chartAt E3 p).open_target hball
    (fun i j => g.smooth p i j) (fun y hy => coeff_chart_symm_posDef g p y hy)
  refine ⟨4 * (5 * Mx * |Λ| * Real.sqrt (9 / m) + 45 * Γ),
    mul_nonneg (by norm_num) (add_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hMx)
      (abs_nonneg _)) (Real.sqrt_nonneg _)) (mul_nonneg (by norm_num) hΓ0)), ?_⟩
  
  intro Sig hmin hcurv x hxS hxs b w r hr hw hpl hzb hgr
  have hzt : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hxs
  have hPD : (g.coeff (chartAt E3 p).symm (chartAt E3 p x)).PosDef :=
    coeff_chart_symm_posDef g p _ hzt
  have hGi : ∀ i j : Fin 3, (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ i j =
      (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ j i := by
    intro i j
    have h := hPD.inv.isHermitian.apply j i
    simpa using h
  have hFwC2 : ContDiffAt ℝ 2 (fun y : E3 => y b - w (coordPlaneProj b y)) (chartAt E3 p x) := by
    have h1 : ContDiffAt ℝ 2 (fun y : E3 => w (coordPlaneProj b y)) (chartAt E3 p x) :=
      hw.comp (chartAt E3 p x) (hPcd b).contDiffAt
    exact ((hprojcd b).contDiffAt).sub h1
  
  have hT : ∀ (V : Set M) (f : M → ℝ), IsOpen V → x ∈ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      (∀ x' ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x' ≠ 0) → V ∩ Sig = V ∩ f ⁻¹' {0} →
      (∃ lam : ℝ, lam ≠ 0 ∧
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y))
            (chartAt E3 p x) * |lam| =
          lam * levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
            (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x)) ∧
      secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y))
          (chartAt E3 p x) =
        secondFundSq (g.coeff (chartAt E3 p).symm) (fun y => y b - w (coordPlaneProj b y))
          (chartAt E3 p x) ∧
      ∃ k : Fin 3,
        partialDeriv k (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) ≠ 0 := by
    intro V f hV hxV hf hdf hVS
    obtain ⟨hFsm, hFd⟩ := ejp_chart_transfer g p f hf
    have hFC2 : ContDiffAt ℝ 2 (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p x) :=
      (hFsm.contDiffAt ((chartAt E3 p).open_target.mem_nhds hzt)).of_le
        (WithTop.coe_le_coe.2 le_top)
    have hdFz := (hFd x hxs (hdf x hxV)).1
    obtain ⟨k0, hk0⟩ := hξne _ _ hdFz
    
    have hvan : ∀ᶠ y in 𝓝 (chartAt E3 p x),
        (fun y => f ((chartAt E3 p).symm y))
          (coordPlaneProj b y + w (coordPlaneProj b y) • e b) = 0 := by
      have hγc : ContinuousAt (fun y => coordPlaneProj b y + w (coordPlaneProj b y) • e b)
          (chartAt E3 p x) :=
        (hcontP b).continuousAt.add
          ((hw.continuousAt.comp (hcontP b).continuousAt).smul continuousAt_const)
      have hγz : coordPlaneProj b (chartAt E3 p x) +
          w (coordPlaneProj b (chartAt E3 p x)) • e b = chartAt E3 p x := by
        rw [← hzb]; simp [coordPlaneProj]
      have hWo : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' V) :=
        (chartAt E3 p).isOpen_inter_preimage_symm hV
      have hzW : chartAt E3 p x ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' V := by
        refine ⟨hzt, ?_⟩
        show (chartAt E3 p).symm (chartAt E3 p x) ∈ V
        rw [(chartAt E3 p).left_inv hxs]; exact hxV
      have hCo : IsOpen {y : E3 | ‖coordPlaneProj b (y - chartAt E3 p x)‖ < r} :=
        isOpen_lt ((hcontP b).comp (continuous_id.sub continuous_const)).norm continuous_const
      have hzC : chartAt E3 p x ∈ {y : E3 | ‖coordPlaneProj b (y - chartAt E3 p x)‖ < r} := by
        show ‖coordPlaneProj b (chartAt E3 p x - chartAt E3 p x)‖ < r
        rw [sub_self, hP0, norm_zero]; exact hr
      have hW' : (fun y => coordPlaneProj b y + w (coordPlaneProj b y) • e b) ⁻¹'
          ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' V) ∈ 𝓝 (chartAt E3 p x) := by
        apply hγc.preimage_mem_nhds
        rw [hγz]; exact hWo.mem_nhds hzW
      filter_upwards [hW', hCo.mem_nhds hzC] with y hy1 hy2
      obtain ⟨x'', ⟨hx''S, hx''s⟩, hx''eq⟩ := hgr y hy2
      have hsx : (chartAt E3 p).symm (coordPlaneProj b y + w (coordPlaneProj b y) • e b) = x'' := by
        rw [← hx''eq, (chartAt E3 p).left_inv hx''s]
      have hx''V : x'' ∈ V := by rw [← hsx]; exact hy1.2
      have h' : x'' ∈ V ∩ Sig := ⟨hx''V, hx''S⟩
      rw [hVS] at h'
      show f ((chartAt E3 p).symm (coordPlaneProj b y + w (coordPlaneProj b y) • e b)) = 0
      rw [hsx]; exact h'.2
    
    obtain ⟨hgrad, r0, s0, hhess⟩ := graph_jet_relations b w (fun y => f ((chartAt E3 p).symm y))
      (chartAt E3 p x) hw hpl hzb hFC2 hvan
    obtain ⟨lam, hlam⟩ : ∃ lam : ℝ,
        lam = partialDeriv b (fun y => f ((chartAt E3 p).symm y)) (chartAt E3 p x) := ⟨_, rfl⟩
    rw [← hlam] at hgrad hhess
    have hlam0 : lam ≠ 0 := by
      intro h0
      apply hk0
      rw [hgrad k0, h0, zero_mul]
    have hξw : ∃ k : Fin 3,
        partialDeriv k (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) ≠ 0 := by
      refine ⟨k0, fun h0 => hk0 ?_⟩
      rw [hgrad k0, h0, mul_zero]
    
    have hFsym := hschwarz _ _ hFC2
    have hFwsym := hschwarz _ _ hFwC2
    have h2' : ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j (fun y => f ((chartAt E3 p).symm y))) (chartAt E3 p x) =
          lam * partialDeriv i (partialDeriv j (fun y => y b - w (coordPlaneProj b y)))
              (chartAt E3 p x) +
            (fun k => (r0 k + s0 k) / 2) i *
              partialDeriv j (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) +
            (fun k => (r0 k + s0 k) / 2) j *
              partialDeriv i (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) := by
      intro i j
      have e1 := hhess i j
      have e2 := hhess j i
      rw [hFsym j i, hFwsym j i] at e2
      simp only
      linear_combination (e1 + e2) / 2
    
    have hlmc := levelMeanCurvCoord_rescale (g.coeff (chartAt E3 p).symm)
      (fun y => y b - w (coordPlaneProj b y)) (fun y => f ((chartAt E3 p).symm y))
      (chartAt E3 p x) hGi lam hlam0 (fun k => (r0 k + s0 k) / 2) hgrad h2'
    
    have hdiff : ∀ i j : Fin 3,
        hessLoc (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y)) i j
            (chartAt E3 p x) -
          lam * hessLoc (g.coeff (chartAt E3 p).symm) (fun y => y b - w (coordPlaneProj b y))
            i j (chartAt E3 p x) =
        (r0 i + s0 i) / 2 *
            partialDeriv j (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) +
          (r0 j + s0 j) / 2 *
            partialDeriv i (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) := by
      intro i j
      simp only [hessLoc]
      rw [h2' i j]
      simp only [hgrad, Fin.sum_univ_three]
      ring
    have hsfs := secondFundSq_congr_scale (g.coeff (chartAt E3 p).symm)
      (fun y => y b - w (coordPlaneProj b y)) (fun y => f ((chartAt E3 p).symm y))
      (chartAt E3 p x) lam hPD
      (fun h => by obtain ⟨k, hk⟩ := hξw; exact hk (congrFun h k))
      hlam0 hgrad
      (fun i j => by rw [hdiff i j, hdiff j i]; ring)
      (fun v hv => by
        simp only [hdiff]
        simp only [Fin.sum_univ_three] at hv ⊢
        linear_combination ((r0 0 + s0 0) * v 0 + (r0 1 + s0 1) * v 1 + (r0 2 + s0 2) * v 2) * hv)
    exact ⟨⟨lam, hlam0, hlmc⟩, hsfs, hξw⟩
  refine ⟨?_, ?_⟩
  
  · intro hzB hslope
    obtain ⟨V', f', hV', hxV', hf', hdf', hVS', hsfs'⟩ := hcurv x hxS
    
    have hxx : chartAt E3 x x ∈ (chartAt E3 x).target := mem_chart_target E3 x
    have hlinv : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hΦx : Φ (chartAt E3 p x) = x := hlinv
    have hzΦ : chartAt E3 p x ∈ Φ.source := hzt
    have h7 := sep_chart_transition g p x (chartAt E3 p x) hzt
      (by rw [hlinv]; exact mem_chart_source E3 x)
    rw [hlinv] at h7
    obtain ⟨h7d, h7G, h7ξ⟩ := h7
    have hentry : ∀ a i : Fin 3,
        fderiv ℝ (fun w => chartAt E3 x ((chartAt E3 p).symm w)) (chartAt E3 p x) (e i) a =
          partialDeriv i (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) (chartAt E3 p x) := by
      intro a i
      have h := ((EuclideanSpace.proj a : E3 →L[ℝ] ℝ).hasFDerivAt.comp (chartAt E3 p x)
        h7d.hasFDerivAt).fderiv
      show _ = fderiv ℝ (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) (chartAt E3 p x) (e i)
      rw [show (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) =
        (EuclideanSpace.proj a : E3 →L[ℝ] ℝ) ∘ (fun w => chartAt E3 x ((chartAt E3 p).symm w))
        from rfl, h]
      rfl
    have h6 := hessLoc_chart_invariant g Φ f' Set.univ isOpen_univ hf'.contMDiffOn
      (chartAt E3 p x) hzΦ (Set.mem_univ _)
    rw [hΦx] at h6
    have h6' : (Matrix.of fun a i : Fin 3 =>
          partialDeriv i (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) (chartAt E3 p x)).det
          ≠ 0 ∧
        ∀ i j : Fin 3, hessLoc (g.coeff (chartAt E3 p).symm) (fun y => f' ((chartAt E3 p).symm y))
            i j (chartAt E3 p x) =
          ∑ a : Fin 3, ∑ c : Fin 3,
            partialDeriv i (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) (chartAt E3 p x) *
              partialDeriv j (fun w => chartAt E3 x ((chartAt E3 p).symm w) c) (chartAt E3 p x) *
              hessLoc (g.coeff (chartAt E3 x).symm) (fun y => f' ((chartAt E3 x).symm y)) a c
                (chartAt E3 x x) := h6
    have hPDx := coeff_chart_symm_posDef g x (chartAt E3 x x) hxx
    have hchartT : secondFundSq (g.coeff (chartAt E3 p).symm)
          (fun y => f' ((chartAt E3 p).symm y)) (chartAt E3 p x) =
        secondFundSq (g.coeff (chartAt E3 x).symm) (fun y => f' ((chartAt E3 x).symm y))
          (chartAt E3 x x) := by
      refine secondFundSq_congr_tensor (g.coeff (chartAt E3 x).symm) (g.coeff (chartAt E3 p).symm)
        (fun y => f' ((chartAt E3 x).symm y)) (fun y => f' ((chartAt E3 p).symm y))
        (chartAt E3 x x) (chartAt E3 p x)
        (Matrix.of fun a i : Fin 3 =>
          partialDeriv i (fun w => chartAt E3 x ((chartAt E3 p).symm w) a) (chartAt E3 p x))
        h6'.1 hPDx.det_pos.ne' ?_ ?_ ?_
      · intro i j
        rw [h7G i j]
        simp only [hentry, Matrix.of_apply]
      · intro i
        rw [h7ξ f' hf' i]
        simp only [hentry, Matrix.of_apply]
      · intro i j
        rw [h6'.2 i j]
        simp only [Matrix.of_apply]
    
    obtain ⟨-, hsfsT, hξw⟩ := hT V' f' hV' hxV' hf' hdf' hVS'
    have hsfs : secondFundSq (g.coeff (chartAt E3 p).symm)
        (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) ≤ Λ ^ 2 := by
      rw [← hsfsT, hchartT]; exact hsfs'
    have hS0 : 0 ≤ ∑ a : Fin 3, ∑ c : Fin 3,
        (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ a c *
          partialDeriv a (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) *
          partialDeriv c (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) := by
      have h := hquad _ hPD.inv
        (fun k => partialDeriv k (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x))
      refine le_of_le_of_eq h ?_
      apply Finset.sum_congr rfl; intro i _
      apply Finset.sum_congr rfl; intro j _
      ring
    obtain ⟨-, hup, hinv, hΓ⟩ := hbd _ hzB
    refine planar_hessian_bound (g.coeff (chartAt E3 p).symm) (chartAt E3 p x) b w m Mx Γ Λ hm
      hPD hup hinv hΓ hw hpl hslope ?_
    intro t t' ht ht'
    have h5 := tangent_hess_sq_le (g.coeff (chartAt E3 p).symm)
      (fun y => y b - w (coordPlaneProj b y)) (chartAt E3 p x) hPD (hHsym _ _ hFwC2) hξw
      t t' ht ht'
    refine h5.trans ?_
    apply mul_le_mul_of_nonneg_left _ (mul_nonneg (hquad _ hPD t) (hquad _ hPD t'))
    exact mul_le_mul_of_nonneg_left hsfs hS0
  
  · obtain ⟨V, f, -, hV, hxV, hf, hdf, hVS, hH, -, -⟩ := hmin.2 x hxS Set.univ Filter.univ_mem
    have hfx : f x = 0 := by
      have h : x ∈ V ∩ Sig := ⟨hxV, hxS⟩
      rw [hVS] at h; exact h.2
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hlmcF : g.levelMeanCurv f ((chartAt E3 p).symm (chartAt E3 p x)) =
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => f ((chartAt E3 p).symm y))
          (chartAt E3 p x) :=
      levelMeanCurv_eq_coord g Φ f (fun y => f ((chartAt E3 p).symm y)) hf (chartAt E3 p x) hzt
        (Filter.Eventually.of_forall (fun _ => rfl))
    rw [(chartAt E3 p).left_inv hxs, hH x hxV hfx] at hlmcF
    obtain ⟨⟨lam, hlam0, hrel⟩, -, -⟩ := hT V f hV hxV hf hdf hVS
    rw [← hlmcF, zero_mul] at hrel
    exact (mul_eq_zero.mp hrel.symm).resolve_left hlam0

theorem ift_planar_graph (S : Set E3) (z : E3) (r : ℝ) (hr : 0 < r) (F : E3 → ℝ)
    (hF : ContDiffOn ℝ ∞ F (Metric.ball z r))
    (hSF : ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0)) (hz : z ∈ S) (b : Fin 3)
    (hb : fderiv ℝ F z (e b) ≠ 0) :
    ∃ δ₁ > 0, ∃ δ₂ > 0, ∃ w : E3 → ℝ, (∀ y, w (coordPlaneProj b y) = w y) ∧
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z)‖ < δ₁} ∧ w z = z b ∧
      (∀ y, ‖coordPlaneProj b (y - z)‖ < δ₁ → |w y - z b| < δ₂ ∧
        coordPlaneProj b y + w y • e b ∈ S ∧
        coordPlaneProj b y + w y • e b ∈ Metric.ball z r) ∧
      (∀ y, ‖coordPlaneProj b (y - z)‖ < δ₁ → |y b - z b| < δ₂ → y ∈ S → y b = w y) :=
by
  
  have hea : (e b) b = 1 := by simp [e]
  have he1 : ‖e b‖ = 1 := by simp [e]
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hP6 : ∀ u : E3, u = coordPlaneProj b u + (u b) • e b := by
    intro u
    simp [coordPlaneProj]
  have hPadd : ∀ (q : E3) (t : ℝ), coordPlaneProj b (q + t • e b) = coordPlaneProj b q := by
    intro q t
    simp only [coordPlaneProj, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hea, mul_one,
      add_smul]
    abel
  have hcoord : ∀ (q : E3) (t : ℝ), (coordPlaneProj b q + t • e b) b = t := by
    intro q t
    simp only [PiLp.add_apply, PiLp.smul_apply, hpa, hea, smul_eq_mul, mul_one, zero_add]
  
  obtain ⟨Pr, hPr⟩ : ∃ Pr : E3 →L[ℝ] ℝ, ∀ v : E3, Pr v = v b :=
    ⟨EuclideanSpace.proj b, fun v => rfl⟩
  obtain ⟨Pb, hPb⟩ : ∃ Pb : E3 →L[ℝ] E3, ∀ v : E3, Pb v = coordPlaneProj b v :=
    ⟨ContinuousLinearMap.id ℝ E3 - Pr.smulRight (e b), fun v => by
      simp [coordPlaneProj, hPr]⟩
  have hPbfun : (⇑Pb) = coordPlaneProj b := funext hPb
  have hPrfun : (⇑Pr) = fun v : E3 => v b := funext hPr
  have hPc : ContDiff ℝ ∞ (coordPlaneProj b) := by
    rw [← hPbfun]; exact Pb.contDiff
  have hPrc : ContDiff ℝ ∞ (fun v : E3 => v b) := by
    rw [← hPrfun]; exact Pr.contDiff
  
  have hderiv : ∀ y : E3, DifferentiableAt ℝ F y → fderiv ℝ F y (e b) ≠ 0 →
      ∃ f' : E3 ≃L[ℝ] E3,
        HasFDerivAt (fun x => coordPlaneProj b x + F x • e b) (f' : E3 →L[ℝ] E3) y := by
    intro y hFd hd
    obtain ⟨L, hL⟩ : ∃ L : E3 →L[ℝ] E3,
        ∀ u, L u = coordPlaneProj b u + fderiv ℝ F y u • e b :=
      ⟨Pb + (fderiv ℝ F y).smulRight (e b), fun u => by simp [hPb]⟩
    obtain ⟨Mi, hMi⟩ : ∃ Mi : E3 →L[ℝ] E3, ∀ v, Mi v = coordPlaneProj b v +
        ((fderiv ℝ F y (e b))⁻¹ * (v b - fderiv ℝ F y (coordPlaneProj b v))) • e b :=
      ⟨Pb + ((fderiv ℝ F y (e b))⁻¹ • (Pr - (fderiv ℝ F y).comp Pb)).smulRight (e b),
        fun v => by simp [hPb, hPr]⟩
    have hDsplit : ∀ u, fderiv ℝ F y u =
        fderiv ℝ F y (coordPlaneProj b u) + u b * fderiv ℝ F y (e b) := by
      intro u
      conv_lhs => rw [hP6 u]
      rw [map_add, map_smul, smul_eq_mul]
    have hLI : Function.LeftInverse Mi L := by
      intro u
      rw [hMi, hL, hPadd, hP3, hcoord, hDsplit u]
      have hc : (fderiv ℝ F y (e b))⁻¹ * (fderiv ℝ F y (coordPlaneProj b u) +
          u b * fderiv ℝ F y (e b) - fderiv ℝ F y (coordPlaneProj b u)) = u b := by
        field_simp
        ring
      rw [hc]
      exact (hP6 u).symm
    have hRI : Function.RightInverse Mi L := by
      intro v
      rw [hL, hMi, hPadd, hP3, map_add, map_smul, smul_eq_mul]
      have hc : fderiv ℝ F y (coordPlaneProj b v) + (fderiv ℝ F y (e b))⁻¹ *
          (v b - fderiv ℝ F y (coordPlaneProj b v)) * fderiv ℝ F y (e b) = v b := by
        field_simp
        ring
      rw [hc]
      exact (hP6 v).symm
    refine ⟨ContinuousLinearEquiv.equivOfInverse L Mi hLI hRI, ?_⟩
    have h1 : HasFDerivAt (coordPlaneProj b) Pb y := by
      rw [← hPbfun]; exact Pb.hasFDerivAt
    have h2 := hFd.hasFDerivAt.smul_const (e b)
    have h3 : HasFDerivAt (fun x => coordPlaneProj b x + F x • e b)
        (Pb + (fderiv ℝ F y).smulRight (e b)) y := h1.add h2
    refine h3.congr_fderiv ?_
    ext1 u
    show (Pb + (fderiv ℝ F y).smulRight (e b)) u = L u
    rw [hL]
    simp [hPb]
  
  have hFz : F z = 0 := (hSF z (Metric.mem_ball_self hr)).1 hz
  have hΨc : ContDiffOn ℝ ∞ (fun x => coordPlaneProj b x + F x • e b) (Metric.ball z r) :=
    hPc.contDiffOn.add (hF.smul contDiffOn_const)
  have hΨat : ∀ y ∈ Metric.ball z r,
      ContDiffAt ℝ ∞ (fun x => coordPlaneProj b x + F x • e b) y :=
    fun y hy => hΨc.contDiffAt (Metric.isOpen_ball.mem_nhds hy)
  have hFdiff : ∀ y ∈ Metric.ball z r, DifferentiableAt ℝ F y :=
    fun y hy => (hF.contDiffAt (Metric.isOpen_ball.mem_nhds hy)).differentiableAt (by simp)
  obtain ⟨f0, hf0⟩ := hderiv z (hFdiff z (Metric.mem_ball_self hr)) hb
  have hΨz := hΨat z (Metric.mem_ball_self hr)
  obtain ⟨Φ, hΦ, hzΦ⟩ : ∃ Φ : OpenPartialHomeomorph E3 E3,
      (⇑Φ = fun x => coordPlaneProj b x + F x • e b) ∧ z ∈ Φ.source :=
    ⟨ContDiffAt.toOpenPartialHomeomorph _ hΨz hf0 (by simp),
      ContDiffAt.toOpenPartialHomeomorph_coe hΨz hf0 (by simp),
      ContDiffAt.mem_toOpenPartialHomeomorph_source hΨz hf0 (by simp)⟩
  have hcontD : ContinuousOn (fderiv ℝ F) (Metric.ball z r) :=
    hF.continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)
  have hcz : ContinuousAt (fun y => fderiv ℝ F y (e b)) z :=
    (hcontD.continuousAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))).clm_apply
      continuousAt_const
  have hG : {y | fderiv ℝ F y (e b) ≠ 0 ∧ y ∈ Metric.ball z r} ∩ Φ.source ∈ 𝓝 z :=
    Filter.inter_mem ((hcz.eventually_ne hb).and
      (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))) (Φ.open_source.mem_nhds hzΦ)
  obtain ⟨ε, hε, hεG⟩ := Metric.mem_nhds_iff.mp hG
  have hsm : ∀ q ∈ Φ.target, Φ.symm q ∈ Metric.ball z ε → ContDiffAt ℝ ∞ Φ.symm q := by
    intro q hq hqε
    obtain ⟨⟨hd, hr'⟩, -⟩ := hεG hqε
    obtain ⟨f', hf'⟩ := hderiv _ (hFdiff _ hr') hd
    have h1 : HasFDerivAt (⇑Φ) (f' : E3 →L[ℝ] E3) (Φ.symm q) := by rw [hΦ]; exact hf'
    have h2 : ContDiffAt ℝ ∞ (⇑Φ) (Φ.symm q) := by rw [hΦ]; exact hΨat _ hr'
    exact Φ.contDiffAt_symm hq h1 h2
  
  have hΦz : Φ z = coordPlaneProj b z := by
    rw [hΦ]; simp only [hFz, zero_smul, add_zero]
  have hq₀t : coordPlaneProj b z ∈ Φ.target := hΦz ▸ Φ.map_source hzΦ
  have hsymm₀ : Φ.symm (coordPlaneProj b z) = z := by
    rw [← hΦz]; exact Φ.left_inv hzΦ
  have hε2 : 0 < ε / 2 := by linarith
  obtain ⟨η₁, hη₁, hη₁'⟩ := Metric.continuousAt_iff.mp (Φ.continuousAt_symm hq₀t) (ε / 2) hε2
  obtain ⟨η₂, hη₂, hη₂'⟩ := Metric.isOpen_iff.mp Φ.open_target _ hq₀t
  obtain ⟨δ₁, hδ₁pos, hδ₁η₁, hδ₁η₂, hδ₁ε⟩ : ∃ δ : ℝ, 0 < δ ∧ δ ≤ η₁ ∧ δ ≤ η₂ ∧ δ ≤ ε / 2 :=
    ⟨min (min η₁ η₂) (ε / 2), lt_min (lt_min hη₁ hη₂) hε2,
      le_trans (min_le_left _ _) (min_le_left _ _),
      le_trans (min_le_left _ _) (min_le_right _ _), min_le_right _ _⟩
  have hK : ∀ y : E3, ‖coordPlaneProj b (y - z)‖ < δ₁ →
      coordPlaneProj b y ∈ Φ.target ∧ ‖Φ.symm (coordPlaneProj b y) - z‖ < ε / 2 := by
    intro y hy
    have hd : dist (coordPlaneProj b y) (coordPlaneProj b z) = ‖coordPlaneProj b (y - z)‖ := by
      rw [dist_eq_norm, hP5]
    refine ⟨hη₂' ?_, ?_⟩
    · rw [Metric.mem_ball, hd]; linarith
    · have h := hη₁' (show dist (coordPlaneProj b y) (coordPlaneProj b z) < η₁ by
        rw [hd]; linarith)
      rw [hsymm₀, dist_eq_norm] at h
      exact h
  have hgraph : ∀ y : E3, ‖coordPlaneProj b (y - z)‖ < δ₁ →
      F (Φ.symm (coordPlaneProj b y)) = 0 ∧
      coordPlaneProj b y + (Φ.symm (coordPlaneProj b y)) b • e b =
        Φ.symm (coordPlaneProj b y) := by
    intro y hy
    obtain ⟨hq, -⟩ := hK y hy
    have h1 : coordPlaneProj b (Φ.symm (coordPlaneProj b y)) +
        F (Φ.symm (coordPlaneProj b y)) • e b = coordPlaneProj b y := by
      have := Φ.right_inv hq
      rw [hΦ] at this
      exact this
    have hF0 : F (Φ.symm (coordPlaneProj b y)) = 0 := by
      have h2 := congrArg (fun v : E3 => v b) h1
      simp only [hcoord, hpa] at h2
      exact h2
    refine ⟨hF0, ?_⟩
    rw [hF0, zero_smul, add_zero] at h1
    conv_rhs => rw [hP6 (Φ.symm (coordPlaneProj b y))]
    rw [h1]
  refine ⟨δ₁, hδ₁pos, ε / 2, hε2, fun y => (Φ.symm (coordPlaneProj b y)) b,
    ?_, ?_, ?_, ?_, ?_⟩
  · intro y
    simp only [hP3]
  · intro y hy
    obtain ⟨hq, hx⟩ := hK y hy
    have hxε : Φ.symm (coordPlaneProj b y) ∈ Metric.ball z ε := by
      rw [Metric.mem_ball, dist_eq_norm]; linarith
    have h1 := hPrc.contDiffAt.comp y ((hsm _ hq hxε).comp y hPc.contDiffAt)
    exact h1.contDiffWithinAt
  · show (Φ.symm (coordPlaneProj b z)) b = z b
    rw [hsymm₀]
  · intro y hy
    obtain ⟨hq, hx⟩ := hK y hy
    obtain ⟨hF0, hgr⟩ := hgraph y hy
    have hxε : Φ.symm (coordPlaneProj b y) ∈ Metric.ball z ε := by
      rw [Metric.mem_ball, dist_eq_norm]; linarith
    obtain ⟨⟨-, hxr⟩, -⟩ := hεG hxε
    refine ⟨?_, ?_, ?_⟩
    · have h := PiLp.norm_apply_le (Φ.symm (coordPlaneProj b y) - z) b
      rw [Real.norm_eq_abs, PiLp.sub_apply] at h
      show |(Φ.symm (coordPlaneProj b y)) b - z b| < ε / 2
      linarith
    · show coordPlaneProj b y + (Φ.symm (coordPlaneProj b y)) b • e b ∈ S
      rw [hgr]; exact (hSF _ hxr).2 hF0
    · show coordPlaneProj b y + (Φ.symm (coordPlaneProj b y)) b • e b ∈ Metric.ball z r
      rw [hgr]; exact hxr
  · intro y hy hyb hyS
    have hnorm : ‖y - z‖ ≤ ‖coordPlaneProj b (y - z)‖ + |y b - z b| := by
      have h := norm_add_le (coordPlaneProj b (y - z)) ((y - z) b • e b)
      rw [← hP6 (y - z), norm_smul, he1, mul_one, Real.norm_eq_abs, PiLp.sub_apply] at h
      exact h
    have hyε : y ∈ Metric.ball z ε := by
      rw [Metric.mem_ball, dist_eq_norm]; linarith
    obtain ⟨⟨-, hyr⟩, hys⟩ := hεG hyε
    have hFy : F y = 0 := (hSF y hyr).1 hyS
    have hΦy : Φ y = coordPlaneProj b y := by
      rw [hΦ]; simp only [hFy, zero_smul, add_zero]
    show y b = (Φ.symm (coordPlaneProj b y)) b
    rw [← hΦy, Φ.left_inv hys]

theorem graph_tangent_identity (S : Set E3) (x : E3) (r : ℝ) (hr : 0 < r) (F : E3 → ℝ)
    (hFd : DifferentiableAt ℝ F x) (hSF : ∀ y ∈ Metric.ball x r, y ∈ S → F y = 0)
    (b : Fin 3) (w : E3 → ℝ) (hw : ∀ y, w (coordPlaneProj b y) = w y)
    (hwd : DifferentiableAt ℝ w x) (hx : x b = w x) (r' : ℝ) (hr' : 0 < r')
    (hgr : ∀ y, ‖coordPlaneProj b (y - x)‖ < r' → coordPlaneProj b y + w y • e b ∈ S) :
    (∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u)) ∧
    (fderiv ℝ F x ≠ 0 → fderiv ℝ F x (e b) ≠ 0) :=
by
  have hγx : coordPlaneProj b x + w x • e b = x := by
    rw [← hx]; simp [coordPlaneProj]
  let L : E3 →L[ℝ] E3 := ContinuousLinearMap.id ℝ E3 -
    (EuclideanSpace.proj b : E3 →L[ℝ] ℝ).smulRight (e b) + (fderiv ℝ w x).smulRight (e b)
  have hLu : ∀ u, L u = u - (u b) • e b + (fderiv ℝ w x u) • e b := by
    intro u; rfl
  have hγ : HasFDerivAt (fun y : E3 => coordPlaneProj b y + w y • e b) L x := by
    have h1 := ((hasFDerivAt_id x).sub
      (((EuclideanSpace.proj b : E3 →L[ℝ] ℝ).hasFDerivAt).smul_const (e b))).add
      (hwd.hasFDerivAt.smul_const (e b))
    refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
    simp [coordPlaneProj]
  have hcont : Continuous (fun y : E3 => ‖coordPlaneProj b (y - x)‖) := by
    unfold coordPlaneProj; fun_prop
  have hU1 : {y : E3 | ‖coordPlaneProj b (y - x)‖ < r'} ∈ 𝓝 x :=
    (isOpen_lt hcont continuous_const).mem_nhds (by simp [coordPlaneProj, hr'])
  have hU2 : (fun y : E3 => coordPlaneProj b y + w y • e b) ⁻¹' Metric.ball x r ∈ 𝓝 x := by
    apply hγ.continuousAt.preimage_mem_nhds
    rw [hγx]; exact Metric.ball_mem_nhds x hr
  have hev : (F ∘ fun y : E3 => coordPlaneProj b y + w y • e b) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
    filter_upwards [hU1, hU2] with y hy1 hy2
    exact hSF _ hy2 (hgr y hy1)
  have hF' : HasFDerivAt F (fderiv ℝ F x) (coordPlaneProj b x + w x • e b) := by
    rw [hγx]; exact hFd.hasFDerivAt
  have hcomp := hF'.comp x hγ
  have h0 : (fderiv ℝ F x).comp L = 0 :=
    hcomp.unique ((hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq hev)
  have key : ∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u) := by
    intro u
    have h := congrArg (fun T : E3 →L[ℝ] ℝ => T u) h0
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply, hLu, map_add,
      map_sub, map_smul, smul_eq_mul] at h
    linear_combination h
  refine ⟨key, fun hne h0' => hne ?_⟩
  refine ContinuousLinearMap.ext fun u => ?_
  rw [key u, h0', zero_mul]
  rfl

theorem sheet_uniqueness (c : E3) (R0 : ℝ) (S : Set E3)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (b : Fin 3) (U : Set E3) (hUo : IsOpen U) (hUc : IsPreconnected U)
    (hUs : ∀ y, y ∈ U ↔ coordPlaneProj b y ∈ U) (w₁ w₂ : E3 → ℝ)
    (hw₁ : ∀ y, w₁ (coordPlaneProj b y) = w₁ y) (hw₂ : ∀ y, w₂ (coordPlaneProj b y) = w₂ y)
    (hd₁ : DifferentiableOn ℝ w₁ U) (hc₂ : ContinuousOn w₂ U)
    (hg₁ : ∀ y ∈ U, coordPlaneProj b y + w₁ y • e b ∈ S ∩ Metric.ball c R0)
    (hg₂ : ∀ y ∈ U, coordPlaneProj b y + w₂ y • e b ∈ S ∩ Metric.ball c R0)
    (y₀ : E3) (hy₀ : y₀ ∈ U) (h₀ : w₁ y₀ = w₂ y₀) :
    ∀ y ∈ U, w₁ y = w₂ y :=
by
  
  have graph_tangent_identity : ∀ (S : Set E3) (x : E3) (r : ℝ) (_hr : 0 < r) (F : E3 → ℝ)
      (_hFd : DifferentiableAt ℝ F x) (_hSF : ∀ y ∈ Metric.ball x r, y ∈ S → F y = 0)
      (b : Fin 3) (w : E3 → ℝ) (_hw : ∀ y, w (coordPlaneProj b y) = w y)
      (_hwd : DifferentiableAt ℝ w x) (_hx : x b = w x) (r' : ℝ) (_hr' : 0 < r')
      (_hgr : ∀ y, ‖coordPlaneProj b (y - x)‖ < r' → coordPlaneProj b y + w y • e b ∈ S),
      (∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u)) ∧
      (fderiv ℝ F x ≠ 0 → fderiv ℝ F x (e b) ≠ 0) := by
    intro S x r hr F hFd hSF b w _ hwd hx r' hr' hgr
    have hγx : coordPlaneProj b x + w x • e b = x := by
      rw [← hx]; simp [coordPlaneProj]
    let L : E3 →L[ℝ] E3 := ContinuousLinearMap.id ℝ E3 -
      (EuclideanSpace.proj b : E3 →L[ℝ] ℝ).smulRight (e b) + (fderiv ℝ w x).smulRight (e b)
    have hLu : ∀ u, L u = u - (u b) • e b + (fderiv ℝ w x u) • e b := by
      intro u; rfl
    have hγ : HasFDerivAt (fun y : E3 => coordPlaneProj b y + w y • e b) L x := by
      have h1 := ((hasFDerivAt_id x).sub
        (((EuclideanSpace.proj b : E3 →L[ℝ] ℝ).hasFDerivAt).smul_const (e b))).add
        (hwd.hasFDerivAt.smul_const (e b))
      refine h1.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => ?_)
      simp [coordPlaneProj]
    have hcont : Continuous (fun y : E3 => ‖coordPlaneProj b (y - x)‖) := by
      unfold coordPlaneProj; fun_prop
    have hU1 : {y : E3 | ‖coordPlaneProj b (y - x)‖ < r'} ∈ 𝓝 x :=
      (isOpen_lt hcont continuous_const).mem_nhds (by simp [coordPlaneProj, hr'])
    have hU2 : (fun y : E3 => coordPlaneProj b y + w y • e b) ⁻¹' Metric.ball x r ∈ 𝓝 x := by
      apply hγ.continuousAt.preimage_mem_nhds
      rw [hγx]; exact Metric.ball_mem_nhds x hr
    have hev : (F ∘ fun y : E3 => coordPlaneProj b y + w y • e b) =ᶠ[𝓝 x]
        fun _ => (0 : ℝ) := by
      filter_upwards [hU1, hU2] with y hy1 hy2
      exact hSF _ hy2 (hgr y hy1)
    have hF' : HasFDerivAt F (fderiv ℝ F x) (coordPlaneProj b x + w x • e b) := by
      rw [hγx]; exact hFd.hasFDerivAt
    have hcomp := hF'.comp x hγ
    have h0 : (fderiv ℝ F x).comp L = 0 :=
      hcomp.unique ((hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq hev)
    have key : ∀ u, fderiv ℝ F x u = fderiv ℝ F x (e b) * (u b - fderiv ℝ w x u) := by
      intro u
      have h := congrArg (fun T : E3 →L[ℝ] ℝ => T u) h0
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply, hLu, map_add,
        map_sub, map_smul, smul_eq_mul] at h
      linear_combination h
    refine ⟨key, fun hne h0' => hne ?_⟩
    refine ContinuousLinearMap.ext fun u => ?_
    rw [key u, h0', zero_mul]
    rfl
  
  have hPt : ∀ (y : E3) (t : ℝ), (coordPlaneProj b y + t • e b) b = t := by
    intro y t
    simp [coordPlaneProj, EuclideanSpace.single_apply]
  have hPP : ∀ (y : E3) (t : ℝ),
      coordPlaneProj b (coordPlaneProj b y + t • e b) = coordPlaneProj b y := by
    intro y t
    show (coordPlaneProj b y + t • e b) - (coordPlaneProj b y + t • e b) b • e b =
      coordPlaneProj b y
    rw [hPt]
    abel
  have hPsub : ∀ y' y : E3,
      coordPlaneProj b (y' - y) = coordPlaneProj b y' - coordPlaneProj b y := by
    intro y' y
    show (y' - y) - (y' - y) b • e b = (y' - y' b • e b) - (y - y b • e b)
    rw [PiLp.sub_apply, sub_smul]
    abel
  have hPc : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  
  have hopen : ∀ y ∈ U, w₁ y = w₂ y → ∀ᶠ x in 𝓝 y, w₁ x = w₂ x := by
    intro y hy hyy
    obtain ⟨z, hz⟩ : ∃ z : E3, z = coordPlaneProj b y + w₁ y • e b := ⟨_, rfl⟩
    have hzSB : z ∈ S ∩ Metric.ball c R0 := by rw [hz]; exact hg₁ y hy
    obtain ⟨r, hr, F, hF, hF0, hSF⟩ := hS2 z hzSB
    have hFdOn : DifferentiableOn ℝ F (Metric.ball z r) := hF.differentiableOn (by simp)
    have hFd : DifferentiableAt ℝ F z :=
      hFdOn.differentiableAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))
    have hPz : coordPlaneProj b z = coordPlaneProj b y := by rw [hz, hPP]
    have hPyU : coordPlaneProj b y ∈ U := (hUs y).1 hy
    have hzU : z ∈ U := (hUs z).2 (by rw [hPz]; exact hPyU)
    have hwd : DifferentiableAt ℝ w₁ z := hd₁.differentiableAt (hUo.mem_nhds hzU)
    have hzb : z b = w₁ z := by
      rw [← hw₁ z, hPz, hw₁ y, hz, hPt]
    obtain ⟨r', hr', hball'⟩ := Metric.isOpen_iff.1 hUo _ hPyU
    have hgr : ∀ y', ‖coordPlaneProj b (y' - z)‖ < r' →
        coordPlaneProj b y' + w₁ y' • e b ∈ S := by
      intro y' hy'
      rw [hPsub, hPz] at hy'
      have h1 : coordPlaneProj b y' ∈ U :=
        hball' (by rw [Metric.mem_ball, dist_eq_norm]; exact hy')
      exact (hg₁ y' ((hUs y').2 h1)).1
    have hSF' : ∀ y' ∈ Metric.ball z r, y' ∈ S → F y' = 0 := fun y' h hS => (hSF y' h).1 hS
    have hzb' : fderiv ℝ F z (e b) ≠ 0 :=
      (graph_tangent_identity S z r hr F hFd hSF' b w₁ hw₁ hwd hzb r' hr' hgr).2
        (hF0 z (Metric.mem_ball_self hr))
    
    have hcont : ContinuousOn (fun x => fderiv ℝ F x (e b)) (Metric.ball z r) :=
      (hF.continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).clm_apply
        continuousOn_const
    have hev : ∀ᶠ x in 𝓝 z, fderiv ℝ F x (e b) ≠ 0 :=
      (hcont.continuousAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))).eventually_ne
        hzb'
    obtain ⟨ε, hε, hεb⟩ := Metric.eventually_nhds_iff_ball.1 hev
    have hρpos : 0 < min ε r := lt_min hε hr
    have hsubr : Metric.ball z (min ε r) ⊆ Metric.ball z r :=
      Metric.ball_subset_ball (min_le_right _ _)
    have hρ : ∀ x ∈ Metric.ball z (min ε r), fderiv ℝ F x (e b) ≠ 0 :=
      fun x hx => hεb x (Metric.ball_subset_ball (min_le_left _ _) hx)
    
    have hK : ∀ (p : E3) (a c' : ℝ), a < c' → p + a • e b ∈ Metric.ball z (min ε r) →
        p + c' • e b ∈ Metric.ball z (min ε r) → F (p + a • e b) = 0 →
        F (p + c' • e b) = 0 → False := by
      intro p a c' hac ha hc hFa hFc
      have hseg : ∀ t ∈ Set.Icc a c', p + t • e b ∈ Metric.ball z (min ε r) := by
        intro t ht
        have hl : (t - a) / (c' - a) ∈ Set.Icc (0 : ℝ) 1 := by
          constructor
          · exact div_nonneg (by linarith [ht.1]) (by linarith)
          · rw [div_le_one (by linarith)]
            linarith [ht.2]
        have hm := (convex_ball z (min ε r)).add_smul_sub_mem ha hc hl
        have hca : c' - a ≠ 0 := by linarith
        have hdiff : p + c' • e b - (p + a • e b) = (c' - a) • e b := by
          rw [sub_smul]
          abel
        have hat : a + (t - a) = t := by ring
        have heq : p + a • e b + ((t - a) / (c' - a)) • (p + c' • e b - (p + a • e b)) =
            p + t • e b := by
          rw [hdiff, smul_smul, div_mul_cancel₀ _ hca, add_assoc, ← add_smul, hat]
        rwa [heq] at hm
      have hderiv : ∀ t ∈ Set.Icc a c',
          HasDerivAt (fun s : ℝ => F (p + s • e b)) (fderiv ℝ F (p + t • e b) (e b)) t := by
        intro t ht
        have hγ : HasDerivAt (fun s : ℝ => p + s • e b) ((1 : ℝ) • e b) t :=
          ((hasDerivAt_id' t).smul_const (e b)).const_add p
        rw [one_smul] at hγ
        have hFt : DifferentiableAt ℝ F (p + t • e b) :=
          hFdOn.differentiableAt (Metric.isOpen_ball.mem_nhds (hsubr (hseg t ht)))
        exact hFt.hasFDerivAt.comp_hasDerivAt t hγ
      obtain ⟨t, ht, ht0⟩ := exists_hasDerivAt_eq_zero (f := fun s : ℝ => F (p + s • e b))
        (f' := fun s : ℝ => fderiv ℝ F (p + s • e b) (e b)) hac
        (fun t ht => (hderiv t ht).continuousAt.continuousWithinAt)
        (by show F (p + a • e b) = F (p + c' • e b); rw [hFa, hFc])
        (fun t ht => hderiv t (Set.Ioo_subset_Icc_self ht))
      exact hρ _ (hseg t (Set.Ioo_subset_Icc_self ht)) ht0
    
    have hw₁c : ContinuousAt w₁ y := (hd₁.differentiableAt (hUo.mem_nhds hy)).continuousAt
    have hw₂c : ContinuousAt w₂ y := hc₂.continuousAt (hUo.mem_nhds hy)
    have hγ₁ : ContinuousAt (fun x => coordPlaneProj b x + w₁ x • e b) y :=
      hPc.continuousAt.add (hw₁c.smul continuousAt_const)
    have hγ₂ : ContinuousAt (fun x => coordPlaneProj b x + w₂ x • e b) y :=
      hPc.continuousAt.add (hw₂c.smul continuousAt_const)
    have hz1 : (fun x => coordPlaneProj b x + w₁ x • e b) y ∈ Metric.ball z (min ε r) := by
      show coordPlaneProj b y + w₁ y • e b ∈ Metric.ball z (min ε r)
      rw [← hz]
      exact Metric.mem_ball_self hρpos
    have hz2 : (fun x => coordPlaneProj b x + w₂ x • e b) y ∈ Metric.ball z (min ε r) := by
      show coordPlaneProj b y + w₂ y • e b ∈ Metric.ball z (min ε r)
      rw [← hyy, ← hz]
      exact Metric.mem_ball_self hρpos
    filter_upwards [hγ₁.preimage_mem_nhds (Metric.isOpen_ball.mem_nhds hz1),
      hγ₂.preimage_mem_nhds (Metric.isOpen_ball.mem_nhds hz2), hUo.mem_nhds hy]
      with x hx1 hx2 hxU
    have hx1' : coordPlaneProj b x + w₁ x • e b ∈ Metric.ball z (min ε r) := hx1
    have hx2' : coordPlaneProj b x + w₂ x • e b ∈ Metric.ball z (min ε r) := hx2
    have hF1 : F (coordPlaneProj b x + w₁ x • e b) = 0 := (hSF _ (hsubr hx1')).1 (hg₁ x hxU).1
    have hF2 : F (coordPlaneProj b x + w₂ x • e b) = 0 := (hSF _ (hsubr hx2')).1 (hg₂ x hxU).1
    rcases lt_trichotomy (w₁ x) (w₂ x) with h | h | h
    · exact (hK _ _ _ h hx1' hx2' hF1 hF2).elim
    · exact h
    · exact (hK _ _ _ h hx2' hx1' hF2 hF1).elim
  
  intro y₁ hy₁
  by_contra hne
  have hu : IsOpen {x | ∀ᶠ x' in 𝓝 x, w₁ x' = w₂ x'} := isOpen_setOf_eventually_nhds
  have hv : IsOpen (U ∩ (fun x => w₁ x - w₂ x) ⁻¹' {0}ᶜ) :=
    (hd₁.continuousOn.sub hc₂).isOpen_inter_preimage hUo isOpen_compl_singleton
  have hcover : U ⊆ {x | ∀ᶠ x' in 𝓝 x, w₁ x' = w₂ x'} ∪
      (U ∩ (fun x => w₁ x - w₂ x) ⁻¹' {0}ᶜ) := by
    intro x hx
    by_cases h : w₁ x = w₂ x
    · exact Or.inl (hopen x hx h)
    · refine Or.inr ⟨hx, ?_⟩
      simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
      exact fun h' => h (sub_eq_zero.1 h')
  have hy₁v : y₁ ∈ U ∩ (fun x => w₁ x - w₂ x) ⁻¹' {0}ᶜ := by
    refine ⟨hy₁, ?_⟩
    simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff]
    exact fun h' => hne (sub_eq_zero.1 h')
  obtain ⟨x, hxU, hxu, hxv⟩ := hUc _ _ hu hv hcover ⟨y₀, hy₀, hopen y₀ hy₀ h₀⟩ ⟨y₁, hy₁, hy₁v⟩
  have hx2 := hxv.2
  simp only [Set.mem_preimage, Set.mem_compl_iff, Set.mem_singleton_iff] at hx2
  have hxu' : ∀ᶠ x' in 𝓝 x, w₁ x' = w₂ x' := hxu
  exact hx2 (sub_eq_zero.2 hxu'.self_of_nhds)

theorem sheet_slope_apriori (c : E3) (R0 K : ℝ) (S : Set E3) (hR0 : 0 < R0) (hK : 0 ≤ K)
    (hS3 : ∀ z ∈ S ∩ Metric.ball c R0, ∀ (b : Fin 3) (w : E3 → ℝ) (r : ℝ), 0 < r →
      ContDiffAt ℝ 2 w (coordPlaneProj b z) → (∀ y, w (coordPlaneProj b y) = w y) →
      z b = w (coordPlaneProj b z) →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < r →
        coordPlaneProj b y + w (coordPlaneProj b y) • e b ∈ S) →
      ‖fderiv ℝ w (coordPlaneProj b z)‖ ≤ 2 →
      ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b z)‖ ≤ K)
    (b : Fin 3) (z0 : E3) (hz0c : ‖z0 - c‖ < R0 / 4) (r s : ℝ) (hr : 0 < r)
    (hKr : K * r ≤ 1 / 8) (hrR : 4 * r ≤ R0) (hs0 : 0 ≤ s) (hs : s ≤ 7 / 4)
    (w : E3 → ℝ) (hw : ∀ y, w (coordPlaneProj b y) = w y)
    (hwc : ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < r}) (hwz : w z0 = z0 b)
    (hgr : ∀ y, ‖coordPlaneProj b (y - z0)‖ < r → coordPlaneProj b y + w y • e b ∈ S)
    (hd0 : ‖fderiv ℝ w z0‖ ≤ s) :
    ∀ y, ‖coordPlaneProj b (y - z0)‖ < r →
      ‖fderiv ℝ w y‖ ≤ s + K * ‖coordPlaneProj b (y - z0)‖ ∧
      ‖iteratedFDeriv ℝ 2 w y‖ ≤ K ∧
      |w y - z0 b| ≤ (s + 1 / 8) * ‖coordPlaneProj b (y - z0)‖ ∧
      coordPlaneProj b y + w y • e b ∈ Metric.ball c R0 :=
by
  intro y hy
  
  have hea : (e b) b = 1 := by simp [e]
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP6 : ∀ u : E3, u = coordPlaneProj b u + (u b) • e b := by
    intro u
    simp [coordPlaneProj]
  have hP5 : ∀ (u v : E3), coordPlaneProj b (u - v) = coordPlaneProj b u - coordPlaneProj b v := by
    intro u v
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hPadd : ∀ (u v : E3),
      coordPlaneProj b (u + v) = coordPlaneProj b u + coordPlaneProj b v := by
    intro u v
    simp only [coordPlaneProj, PiLp.add_apply, add_smul]
    abel
  have hPsmul : ∀ (a : ℝ) (u : E3), coordPlaneProj b (a • u) = a • coordPlaneProj b u := by
    intro a u
    simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, smul_sub, smul_smul]
  have hPe : coordPlaneProj b (e b) = 0 := by
    simp only [coordPlaneProj, hea, one_smul, sub_self]
  have hne : ∀ a : ℝ, ‖a • e b‖ = |a| := by
    intro a
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hC : IsOpen {y : E3 | ‖coordPlaneProj b (y - z0)‖ < r} :=
    isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  
  have htrans : ∀ x : E3, (fun v => w (v + (-(x b)) • e b)) = w := by
    intro x
    funext v
    have h1 : coordPlaneProj b (v + (-(x b)) • e b) = coordPlaneProj b v := by
      rw [hPadd, hPsmul, hPe, smul_zero, add_zero]
    show w (v + (-(x b)) • e b) = w v
    rw [← hw (v + (-(x b)) • e b), h1, hw]
  have hPx : ∀ x : E3, x + (-(x b)) • e b = coordPlaneProj b x := by
    intro x
    simp only [coordPlaneProj, neg_smul, ← sub_eq_add_neg]
  have hDtr : ∀ x, fderiv ℝ w x = fderiv ℝ w (coordPlaneProj b x) := by
    intro x
    conv_lhs => rw [← htrans x]
    rw [fderiv_comp_add_right, hPx]
  have hD2tr : ∀ x, iteratedFDeriv ℝ 2 w x = iteratedFDeriv ℝ 2 w (coordPlaneProj b x) := by
    intro x
    conv_lhs => rw [← htrans x]
    rw [iteratedFDeriv_comp_add_right, hPx]
  
  have hcd : ∀ p : E3, ‖coordPlaneProj b (p - z0)‖ < r → ContDiffAt ℝ ∞ w p :=
    fun p hp => hwc.contDiffAt (hC.mem_nhds hp)
  have hdiff : ∀ p : E3, ‖coordPlaneProj b (p - z0)‖ < r → DifferentiableAt ℝ w p :=
    fun p hp => (hcd p hp).differentiableAt (by simp)
  have h11 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
    rw [one_add_one_eq_two]; exact WithTop.coe_le_coe.2 le_top
  have hdiff2 : ∀ p : E3, ‖coordPlaneProj b (p - z0)‖ < r →
      DifferentiableAt ℝ (fderiv ℝ w) p :=
    fun p hp => ((hcd p hp).fderiv_right (m := 1) h11).differentiableAt (by simp)
  have hcontD : ContinuousOn (fderiv ℝ w) {y : E3 | ‖coordPlaneProj b (y - z0)‖ < r} :=
    hwc.continuousOn_fderiv_of_isOpen hC (by simp)
  have hHess : ∀ p : E3, ‖fderiv ℝ (fderiv ℝ w) p‖ = ‖iteratedFDeriv ℝ 2 w p‖ := by
    intro p
    rw [← norm_iteratedFDeriv_one (f := fderiv ℝ w), norm_iteratedFDeriv_fderiv]
  
  have mvt : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (G : E3 → F) (x d : E3)
      (t M : ℝ), 0 ≤ t →
      (∀ u ∈ Set.Icc (0 : ℝ) t, DifferentiableAt ℝ G (x + u • d)) →
      (∀ u ∈ Set.Icc (0 : ℝ) t, ‖fderiv ℝ G (x + u • d)‖ ≤ M) →
      ‖G (x + t • d) - G x‖ ≤ M * (t * ‖d‖) := by
    intro F _ _ G x d t M ht hd hb
    have hseg : ∀ p ∈ segment ℝ x (x + t • d), ∃ u ∈ Set.Icc (0 : ℝ) t, p = x + u • d := by
      intro p hp
      rw [segment_eq_image'] at hp
      obtain ⟨θ, hθ, rfl⟩ := hp
      refine ⟨θ * t, ⟨mul_nonneg hθ.1 ht, mul_le_of_le_one_left ht hθ.2⟩, ?_⟩
      simp only [add_sub_cancel_left, smul_smul]
    have h := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (f := G) (C := M)
      (fun p hp => by obtain ⟨u, hu, rfl⟩ := hseg p hp; exact hd u hu)
      (fun p hp => by obtain ⟨u, hu, rfl⟩ := hseg p hp; exact hb u hu)
      (convex_segment x (x + t • d)) (left_mem_segment ℝ x (x + t • d))
      (right_mem_segment ℝ x (x + t • d))
    rwa [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg ht] at h
  
  have boot : ∀ (f : ℝ → ℝ) (A B : ℝ), A < B → ContinuousOn f (Set.Icc 0 1) → f 0 ≤ A →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, (∀ u ∈ Set.Icc (0 : ℝ) t, f u ≤ B) → f t ≤ A) →
      ∀ t ∈ Set.Icc (0 : ℝ) 1, f t ≤ A := by
    intro f A B hAB hf h0 hstep
    have claim : ∀ t ∈ Set.Icc (0 : ℝ) 1, f t < B := by
      by_contra hcon
      push_neg at hcon
      have hTne : (Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B).Nonempty := by
        obtain ⟨t, ht, hft⟩ := hcon
        exact ⟨t, ht, hft⟩
      have hTc : IsClosed (Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B) :=
        hf.preimage_isClosed_of_isClosed isClosed_Icc isClosed_Ici
      have hTb : BddBelow (Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B) := ⟨0, fun x hx => hx.1.1⟩
      have hτ : sInf (Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B) ∈
          Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B := hTc.csInf_mem hTne hTb
      obtain ⟨τ, hτdef⟩ : ∃ τ, τ = sInf (Set.Icc (0 : ℝ) 1 ∩ f ⁻¹' Set.Ici B) := ⟨_, rfl⟩
      rw [← hτdef] at hτ
      have hτ1 : 0 ≤ τ := hτ.1.1
      have hτ2 : τ ≤ 1 := hτ.1.2
      have hτ3 : B ≤ f τ := hτ.2
      have hbelow : ∀ u ∈ Set.Icc (0 : ℝ) 1, u < τ → f u < B := by
        intro u hu huτ
        by_contra hfu
        push_neg at hfu
        have : τ ≤ u := by rw [hτdef]; exact csInf_le hTb ⟨hu, hfu⟩
        linarith
      have hτ0 : 0 < τ := by
        rcases eq_or_lt_of_le hτ1 with h | h
        · exfalso
          rw [← h] at hτ3
          linarith
        · exact h
      obtain ⟨δ, hδ, hδf⟩ := Metric.continuousWithinAt_iff.mp (hf τ hτ.1) (B - A) (by linarith)
      have hu0a : 0 ≤ max 0 (τ - δ / 2) := le_max_left _ _
      have hu0c : τ - δ / 2 ≤ max 0 (τ - δ / 2) := le_max_right _ _
      have hu0b : max 0 (τ - δ / 2) < τ := max_lt hτ0 (by linarith)
      have hu0I : max 0 (τ - δ / 2) ∈ Set.Icc (0 : ℝ) 1 := ⟨hu0a, by linarith⟩
      have hdist : dist (max 0 (τ - δ / 2)) τ < δ := by
        rw [Real.dist_eq, abs_lt]
        constructor <;> linarith
      have h1 := hδf hu0I hdist
      have h2 : f (max 0 (τ - δ / 2)) ≤ A :=
        hstep _ hu0I (fun v hv => le_of_lt (hbelow v ⟨hv.1, by linarith [hv.2]⟩
          (by linarith [hv.2])))
      rw [Real.dist_eq, abs_lt] at h1
      linarith [h1.1]
    intro t ht
    exact hstep t ht (fun u hu => le_of_lt (claim u ⟨hu.1, le_trans hu.2 ht.2⟩))
  
  have hess : ∀ p : E3, coordPlaneProj b p = p → ‖coordPlaneProj b (p - z0)‖ < r →
      ‖fderiv ℝ w p‖ ≤ 2 → |w p - z0 b| ≤ 2 * ‖coordPlaneProj b (p - z0)‖ →
      ‖iteratedFDeriv ℝ 2 w p‖ ≤ K := by
    intro p hpp hpC hpd hph
    have hxS : coordPlaneProj b p + w p • e b ∈ S := hgr p hpC
    have hPx' : coordPlaneProj b (coordPlaneProj b p + w p • e b) = p := by
      rw [hPadd, hPsmul, hPe, smul_zero, add_zero, hP3, hpp]
    have hxz : coordPlaneProj b p + w p • e b - z0 =
        coordPlaneProj b (p - z0) + (w p - z0 b) • e b := by
      rw [hP5, sub_smul]
      conv_lhs => rw [hP6 z0]
      abel
    have hxn : ‖coordPlaneProj b p + w p • e b - z0‖ ≤ 3 * ‖coordPlaneProj b (p - z0)‖ := by
      rw [hxz]
      calc ‖coordPlaneProj b (p - z0) + (w p - z0 b) • e b‖
          ≤ ‖coordPlaneProj b (p - z0)‖ + ‖(w p - z0 b) • e b‖ := norm_add_le _ _
        _ = ‖coordPlaneProj b (p - z0)‖ + |w p - z0 b| := by rw [hne]
        _ ≤ 3 * ‖coordPlaneProj b (p - z0)‖ := by linarith
    have hxball : coordPlaneProj b p + w p • e b ∈ Metric.ball c R0 := by
      rw [Metric.mem_ball, dist_eq_norm]
      have h1 := norm_sub_le_norm_sub_add_norm_sub (coordPlaneProj b p + w p • e b) z0 c
      linarith
    have hcd' : ContDiffAt ℝ 2 w (coordPlaneProj b (coordPlaneProj b p + w p • e b)) := by
      rw [hPx']
      exact (hcd p hpC).of_le (WithTop.coe_le_coe.2 le_top)
    have hxb : (coordPlaneProj b p + w p • e b) b =
        w (coordPlaneProj b (coordPlaneProj b p + w p • e b)) := by
      rw [hPx']
      simp only [PiLp.add_apply, PiLp.smul_apply, hpa, hea, smul_eq_mul, mul_one, zero_add]
    have hgr' : ∀ y', ‖coordPlaneProj b (y' - (coordPlaneProj b p + w p • e b))‖ <
        r - ‖coordPlaneProj b (p - z0)‖ →
        coordPlaneProj b y' + w (coordPlaneProj b y') • e b ∈ S := by
      intro y' hy'
      rw [hw]
      apply hgr
      have e1 : coordPlaneProj b (y' - z0) =
          coordPlaneProj b (y' - (coordPlaneProj b p + w p • e b)) +
            coordPlaneProj b (p - z0) := by
        rw [hP5 y' z0, hP5 y' (coordPlaneProj b p + w p • e b), hP5 p z0, hPx', hpp]
        abel
      rw [e1]
      linarith [norm_add_le (coordPlaneProj b (y' - (coordPlaneProj b p + w p • e b)))
        (coordPlaneProj b (p - z0))]
    have hpd' : ‖fderiv ℝ w (coordPlaneProj b (coordPlaneProj b p + w p • e b))‖ ≤ 2 := by
      rw [hPx']; exact hpd
    have h := hS3 _ ⟨hxS, hxball⟩ b w (r - ‖coordPlaneProj b (p - z0)‖) (by linarith) hcd' hw
      hxb hgr' hpd'
    rwa [hPx'] at h
  
  obtain ⟨d, hd⟩ : ∃ d : E3, d = coordPlaneProj b (y - z0) := ⟨_, rfl⟩
  obtain ⟨q0, hq0⟩ : ∃ q0 : E3, q0 = coordPlaneProj b z0 := ⟨_, rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : ℝ, L = ‖d‖ := ⟨_, rfl⟩
  have hL0 : 0 ≤ L := by rw [hL]; exact norm_nonneg _
  have hLy : ‖coordPlaneProj b (y - z0)‖ = L := by rw [hL, hd]
  have hLr : L < r := by rw [← hLy]; exact hy
  have hdP : coordPlaneProj b d = d := by rw [hd, hP3]
  have hq0P : coordPlaneProj b q0 = q0 := by rw [hq0, hP3]
  have hqP : ∀ u : ℝ, coordPlaneProj b (q0 + u • d) = q0 + u • d := by
    intro u
    rw [hPadd, hPsmul, hdP, hq0P]
  have hqz : ∀ u : ℝ, coordPlaneProj b (q0 + u • d - z0) = u • d := by
    intro u
    rw [hP5, hqP, ← hq0, add_sub_cancel_left]
  have hqn : ∀ u ∈ Set.Icc (0 : ℝ) 1, ‖coordPlaneProj b (q0 + u • d - z0)‖ = u * L := by
    intro u hu
    rw [hqz, norm_smul, Real.norm_of_nonneg hu.1, hL]
  have huL : ∀ u ∈ Set.Icc (0 : ℝ) 1, u * L ≤ L := by
    intro u hu
    calc u * L ≤ 1 * L := mul_le_mul_of_nonneg_right hu.2 hL0
      _ = L := one_mul L
  have hqC : ∀ u ∈ Set.Icc (0 : ℝ) 1, ‖coordPlaneProj b (q0 + u • d - z0)‖ < r := by
    intro u hu
    rw [hqn u hu]
    linarith [huL u hu]
  have hq1 : q0 + (1 : ℝ) • d = coordPlaneProj b y := by
    rw [one_smul, hd, hq0, hP5, add_sub_cancel]
  have hwq0 : w q0 = z0 b := by rw [hq0, hw z0, hwz]
  have hDq0 : fderiv ℝ w q0 = fderiv ℝ w z0 := by rw [hq0, ← hDtr z0]
  have hKuL : ∀ u ∈ Set.Icc (0 : ℝ) 1, K * (u * L) ≤ 1 / 8 := by
    intro u hu
    have h1 : u * L ≤ r := by linarith [huL u hu]
    have h2 : K * (u * L) ≤ K * r := mul_le_mul_of_nonneg_left h1 hK
    linarith
  have hfc : ContinuousOn (fun u : ℝ => ‖fderiv ℝ w (q0 + u • d)‖) (Set.Icc 0 1) := by
    have hm : Set.MapsTo (fun u : ℝ => q0 + u • d) (Set.Icc 0 1)
        {y : E3 | ‖coordPlaneProj b (y - z0)‖ < r} := fun u hu => hqC u hu
    have hcm : Continuous (fun u : ℝ => q0 + u • d) := by fun_prop
    exact (hcontD.comp hcm.continuousOn hm).norm
  
  have est : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      (∀ u ∈ Set.Icc (0 : ℝ) t, ‖fderiv ℝ w (q0 + u • d)‖ ≤ 2) →
      ∀ u ∈ Set.Icc (0 : ℝ) t,
        |w (q0 + u • d) - z0 b| ≤ 2 * (u * L) ∧
        ‖iteratedFDeriv ℝ 2 w (q0 + u • d)‖ ≤ K ∧
        ‖fderiv ℝ w (q0 + u • d)‖ ≤ s + K * (u * L) := by
    intro t ht H
    have E1 : ∀ u ∈ Set.Icc (0 : ℝ) t, |w (q0 + u • d) - z0 b| ≤ 2 * (u * L) := by
      intro u hu
      have h := mvt w q0 d u 2 hu.1
        (fun v hv => hdiff _ (hqC v ⟨hv.1, by linarith [hv.2, hu.2, ht.2]⟩))
        (fun v hv => H v ⟨hv.1, le_trans hv.2 hu.2⟩)
      rw [Real.norm_eq_abs, hwq0, ← hL] at h
      exact h
    have E2 : ∀ u ∈ Set.Icc (0 : ℝ) t, ‖iteratedFDeriv ℝ 2 w (q0 + u • d)‖ ≤ K := by
      intro u hu
      have hu1 : u ∈ Set.Icc (0 : ℝ) 1 := ⟨hu.1, le_trans hu.2 ht.2⟩
      apply hess (q0 + u • d) (hqP u) (hqC u hu1) (H u hu)
      rw [hqn u hu1]
      exact E1 u hu
    intro u hu
    refine ⟨E1 u hu, E2 u hu, ?_⟩
    have h := mvt (fderiv ℝ w) q0 d u K hu.1
      (fun v hv => hdiff2 _ (hqC v ⟨hv.1, by linarith [hv.2, hu.2, ht.2]⟩))
      (fun v hv => by rw [hHess]; exact E2 v ⟨hv.1, le_trans hv.2 hu.2⟩)
    rw [← hL] at h
    have h2 : ‖fderiv ℝ w q0‖ ≤ s := by rw [hDq0]; exact hd0
    have h3 := norm_sub_norm_le (fderiv ℝ w (q0 + u • d)) (fderiv ℝ w q0)
    linarith
  
  have hf0 : (fun u : ℝ => ‖fderiv ℝ w (q0 + u • d)‖) 0 ≤ 15 / 8 := by
    show ‖fderiv ℝ w (q0 + (0 : ℝ) • d)‖ ≤ 15 / 8
    rw [zero_smul, add_zero, hDq0]
    linarith
  have hall := boot (fun u : ℝ => ‖fderiv ℝ w (q0 + u • d)‖) (15 / 8) 2 (by norm_num) hfc hf0
    (fun t ht H => by
      show ‖fderiv ℝ w (q0 + t • d)‖ ≤ 15 / 8
      have h1 := (est t ht H t ⟨ht.1, le_refl t⟩).2.2
      have h2 := hKuL t ht
      linarith)
  have H1 : ∀ u ∈ Set.Icc (0 : ℝ) 1, ‖fderiv ℝ w (q0 + u • d)‖ ≤ 2 := by
    intro u hu
    have := hall u hu
    simp only at this
    linarith
  have hE := est 1 ⟨zero_le_one, le_refl 1⟩ H1
  have h1I : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_refl 1⟩
  
  have hdrift : |w y - z0 b| ≤ (s + 1 / 8) * L := by
    have h := mvt w q0 d 1 (s + 1 / 8) zero_le_one
      (fun v hv => hdiff _ (hqC v hv))
      (fun v hv => by
        have h1 := (hE v hv).2.2
        have h2 := hKuL v hv
        linarith)
    rw [Real.norm_eq_abs, one_mul, ← hL, hq1, hw y, hwq0] at h
    exact h
  rw [hLy]
  refine ⟨?_, ?_, hdrift, ?_⟩
  · 
    rw [hDtr y, ← hq1]
    have h := (hE 1 h1I).2.2
    rwa [one_mul] at h
  · 
    rw [hD2tr y, ← hq1]
    exact (hE 1 h1I).2.1
  · 
    have hgz : coordPlaneProj b y + w y • e b - z0 = d + (w y - z0 b) • e b := by
      rw [hd, hP5, sub_smul]
      conv_lhs => rw [hP6 z0]
      abel
    have hgn : ‖coordPlaneProj b y + w y • e b - z0‖ ≤ 3 * L := by
      rw [hgz]
      have h1 : (s + 1 / 8) * L ≤ 2 * L := mul_le_mul_of_nonneg_right (by linarith) hL0
      calc ‖d + (w y - z0 b) • e b‖ ≤ ‖d‖ + ‖(w y - z0 b) • e b‖ := norm_add_le _ _
        _ = L + |w y - z0 b| := by rw [hne, hL]
        _ ≤ 3 * L := by linarith
    rw [Metric.mem_ball, dist_eq_norm]
    have h1 := norm_sub_le_norm_sub_add_norm_sub (coordPlaneProj b y + w y • e b) z0 c
    linarith

theorem sheet_boundary_patch (c : E3) (R0 : ℝ) (S : Set E3)
    (hS1 : ∀ z ∈ Metric.ball c R0, z ∈ closure S → z ∈ S)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (b : Fin 3) (z0 : E3) (R : ℝ) (hR : 0 < R) (w : E3 → ℝ)
    (hw : ∀ y, w (coordPlaneProj b y) = w y)
    (hwc : ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < R}) (hwz : w z0 = z0 b)
    (hgr : ∀ y, ‖coordPlaneProj b (y - z0)‖ < R → coordPlaneProj b y + w y • e b ∈ S)
    (hlip : ∀ y y', ‖coordPlaneProj b (y - z0)‖ < R → ‖coordPlaneProj b (y' - z0)‖ < R →
      |w y - w y'| ≤ 2 * ‖coordPlaneProj b (y - y')‖)
    (hball : ∀ y (t : ℝ), ‖coordPlaneProj b (y - z0)‖ ≤ R → |t - z0 b| ≤ 2 * R →
      coordPlaneProj b y + t • e b ∈ Metric.ball c R0)
    (q : E3) (hq : ‖coordPlaneProj b (q - z0)‖ = R) :
    ∃ ε > 0, ∃ v : E3 → ℝ, (∀ y, v (coordPlaneProj b y) = v y) ∧
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj b (y - q)‖ < ε} ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε →
        coordPlaneProj b y + v y • e b ∈ S ∩ Metric.ball c R0) ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε → ‖coordPlaneProj b (y - z0)‖ < R → v y = w y) :=
by
  
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have he : ‖e b‖ = 1 := by simp [e]
  have hgpb : ∀ (y : E3) (s : ℝ), (coordPlaneProj b y + s • e b) b = s := by
    intro y s
    simp [hpa, e]
  have hPgp : ∀ (y : E3) (s : ℝ),
      coordPlaneProj b (coordPlaneProj b y + s • e b) = coordPlaneProj b y := by
    intro y s
    conv_lhs => rw [coordPlaneProj, hgpb]
    simp
  have hPsmul : ∀ (a : ℝ) (v : E3), coordPlaneProj b (a • v) = a • coordPlaneProj b v := by
    intro a v
    simp only [coordPlaneProj, PiLp.smul_apply, smul_eq_mul, smul_sub, mul_smul]
  have hPn : ∀ v : E3, ‖coordPlaneProj b v‖ ≤ ‖v‖ := by
    intro v
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    by_cases hi : i = b
    · rw [hi, hpa]
      simp only [norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
      positivity
    · have hvi : (coordPlaneProj b v) i = v i := by
        simp [coordPlaneProj, e, EuclideanSpace.single_apply, hi]
      exact le_of_eq (by rw [hvi])
  have hsat : ∀ y, ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ =
      ‖coordPlaneProj b (y - z0)‖ := by
    intro y
    rw [hP5, hP3, ← hP5]
  have hCopen : IsOpen {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} :=
    isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  
  have hL : LipschitzOnWith 2 w {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
    apply LipschitzOnWith.of_dist_le_mul
    intro x hx y hy
    rw [Real.dist_eq, dist_eq_norm]
    have h1 := hlip x y hx hy
    have h2 := hPn (x - y)
    push_cast
    linarith
  
  obtain ⟨t, ht⟩ : ∃ t : ℝ, ∀ y, ‖coordPlaneProj b (y - z0)‖ < R →
      |w y - t| ≤ 2 * ‖coordPlaneProj b (y - q)‖ := by
    obtain ⟨W, hWL, hWeq⟩ := hL.extend_real
    refine ⟨W (coordPlaneProj b q), fun y hy => ?_⟩
    have hPy : coordPlaneProj b y ∈ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
      show ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ < R
      rw [hsat]
      exact hy
    have h1 : w y = W (coordPlaneProj b y) := by
      rw [← hw y]
      exact hWeq hPy
    have h2 := hWL.dist_le_mul (coordPlaneProj b y) (coordPlaneProj b q)
    have h3 : dist (coordPlaneProj b y) (coordPlaneProj b q) =
        ‖coordPlaneProj b y - coordPlaneProj b q‖ := dist_eq_norm _ _
    rw [h3] at h2
    push_cast at h2
    rw [h1, ← Real.dist_eq, hP5]
    exact h2
  
  have hz0C : ‖coordPlaneProj b (z0 - z0)‖ < R := by
    rw [sub_self]
    simpa [coordPlaneProj] using hR
  have hnq : ‖coordPlaneProj b (z0 - q)‖ = R := by
    rw [hP5, norm_sub_rev, ← hP5, hq]
  have htb : |t - z0 b| ≤ 2 * R := by
    have h := ht z0 hz0C
    rw [hnq, hwz, abs_sub_comm] at h
    exact h
  obtain ⟨p, hp⟩ : ∃ p : E3, p = coordPlaneProj b q + t • e b := ⟨_, rfl⟩
  have hpB : p ∈ Metric.ball c R0 := by
    rw [hp]
    exact hball q t (le_of_eq hq) htb
  have hPp : coordPlaneProj b p = coordPlaneProj b q := by rw [hp, hPgp]
  have hpb : p b = t := by rw [hp, hgpb]
  have hPpq : ∀ y, coordPlaneProj b (y - p) = coordPlaneProj b (y - q) := by
    intro y
    rw [hP5, hP5, hPp]
  have hD : ∀ y (s : ℝ), ‖(coordPlaneProj b y + s • e b) - p‖ ≤
      ‖coordPlaneProj b (y - q)‖ + |s - t| := by
    intro y s
    have h1 : (coordPlaneProj b y + s • e b) - p =
        coordPlaneProj b (y - q) + (s - t) • e b := by
      rw [hp, hP5, sub_smul]
      abel
    rw [h1]
    calc ‖coordPlaneProj b (y - q) + (s - t) • e b‖
        ≤ ‖coordPlaneProj b (y - q)‖ + ‖(s - t) • e b‖ := norm_add_le _ _
      _ = ‖coordPlaneProj b (y - q)‖ + |s - t| := by
          rw [norm_smul, he, mul_one, Real.norm_eq_abs]
  
  have hX : ∀ δ > 0, ∃ y, ‖coordPlaneProj b (y - z0)‖ < R ∧
      ‖(coordPlaneProj b y + w y • e b) - p‖ < δ := by
    intro δ hδ
    obtain ⟨η, hη⟩ : ∃ η : ℝ, η = min (1 / 2) (δ / (6 * R)) := ⟨_, rfl⟩
    have hη0 : 0 < η := by
      rw [hη]
      exact lt_min (by norm_num) (div_pos hδ (mul_pos (by norm_num) hR))
    have hη1 : η ≤ 1 / 2 := by rw [hη]; exact min_le_left _ _
    have hη2 : η ≤ δ / (6 * R) := by rw [hη]; exact min_le_right _ _
    have hηR : η * R ≤ δ / 6 := by
      have h1 : η * R ≤ δ / (6 * R) * R := mul_le_mul_of_nonneg_right hη2 hR.le
      have h2 : δ / (6 * R) * R = δ / 6 := by
        rw [div_mul_eq_mul_div, mul_div_mul_right _ _ hR.ne']
      linarith
    obtain ⟨y, hy⟩ : ∃ y : E3, y = z0 + (1 - η) • (q - z0) := ⟨_, rfl⟩
    have hyC : ‖coordPlaneProj b (y - z0)‖ < R := by
      have h1 : y - z0 = (1 - η) • (q - z0) := by
        rw [hy]
        abel
      rw [h1, hPsmul, norm_smul, hq, Real.norm_eq_abs,
        abs_of_pos (show (0 : ℝ) < 1 - η by linarith)]
      nlinarith
    have hyq : ‖coordPlaneProj b (y - q)‖ = η * R := by
      have h1 : y - q = (-η) • (q - z0) := by
        rw [hy, sub_smul, one_smul, neg_smul]
        abel
      rw [h1, hPsmul, norm_smul, hq, Real.norm_eq_abs, abs_neg, abs_of_pos hη0]
    refine ⟨y, hyC, ?_⟩
    have h1 := hD y (w y)
    have h2 := ht y hyC
    rw [hyq] at h1 h2
    linarith
  have hpcl : p ∈ closure S := by
    rw [Metric.mem_closure_iff]
    intro ε hε
    obtain ⟨y, hyC, hy⟩ := hX ε hε
    exact ⟨_, hgr y hyC, by rw [dist_comm, dist_eq_norm]; exact hy⟩
  have hpS : p ∈ S := hS1 p hpB hpcl
  
  obtain ⟨r, hr, F, hF, hF0, hSF⟩ := hS2 p ⟨hpS, hpB⟩
  
  have hb : fderiv ℝ F p (e b) ≠ 0 := by
    intro h0
    have hα : 0 < ‖fderiv ℝ F p‖ := norm_pos_iff.mpr (hF0 p (Metric.mem_ball_self hr))
    have hcont : ContinuousAt (fderiv ℝ F) p :=
      (hF.continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).continuousAt
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))
    obtain ⟨δ, hδ, hδc⟩ :=
      Metric.continuousAt_iff.1 hcont (‖fderiv ℝ F p‖ / 8) (div_pos hα (by norm_num))
    obtain ⟨y, hyC, hyp⟩ := hX (min δ r) (lt_min hδ hr)
    obtain ⟨x, hx⟩ : ∃ x : E3, x = coordPlaneProj b y + w y • e b := ⟨_, rfl⟩
    rw [← hx] at hyp
    have hxp_r : ‖x - p‖ < r := lt_of_lt_of_le hyp (min_le_right _ _)
    have hxp_d : ‖x - p‖ < δ := lt_of_lt_of_le hyp (min_le_left _ _)
    have hxball : x ∈ Metric.ball p r := by
      rw [Metric.mem_ball, dist_eq_norm]
      exact hxp_r
    have hFd : DifferentiableAt ℝ F x :=
      (hF.contDiffAt (Metric.isOpen_ball.mem_nhds hxball)).differentiableAt (by simp)
    have hSF' : ∀ x' ∈ Metric.ball x (r - ‖x - p‖), x' ∈ S → F x' = 0 := by
      intro x' hx' hx'S
      have h1 : x' ∈ Metric.ball p r := by
        rw [Metric.mem_ball] at hx' ⊢
        have h2 := dist_triangle x' x p
        rw [dist_eq_norm x p] at h2
        linarith
      exact (hSF x' h1).1 hx'S
    have hPx : coordPlaneProj b x = coordPlaneProj b y := by rw [hx, hPgp]
    have hxC' : ‖coordPlaneProj b (x - z0)‖ = ‖coordPlaneProj b (y - z0)‖ := by
      rw [hP5, hPx, ← hP5]
    have hxC : x ∈ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
      show ‖coordPlaneProj b (x - z0)‖ < R
      rw [hxC']
      exact hyC
    have hwd : DifferentiableAt ℝ w x :=
      (hwc.contDiffAt (hCopen.mem_nhds hxC)).differentiableAt (by simp)
    have hxw : x b = w x := by
      rw [← hw x, hPx, hw, hx, hgpb]
    have hr' : 0 < R - ‖coordPlaneProj b (y - z0)‖ := by linarith
    have hgr' : ∀ y', ‖coordPlaneProj b (y' - x)‖ < R - ‖coordPlaneProj b (y - z0)‖ →
        coordPlaneProj b y' + w y' • e b ∈ S := by
      intro y' hy'
      apply hgr
      have h1 : coordPlaneProj b (y' - z0) =
          coordPlaneProj b (y' - x) + coordPlaneProj b (x - z0) := by
        rw [hP5, hP5, hP5]
        abel
      rw [h1]
      calc ‖coordPlaneProj b (y' - x) + coordPlaneProj b (x - z0)‖
          ≤ ‖coordPlaneProj b (y' - x)‖ + ‖coordPlaneProj b (x - z0)‖ := norm_add_le _ _
        _ < R := by rw [hxC']; linarith
    have htan := (graph_tangent_identity S x (r - ‖x - p‖) (by linarith) F hFd hSF' b w hw
      hwd hxw _ hr' hgr').1
    have hdw : ‖fderiv ℝ w x‖ ≤ 2 := by
      have h := norm_fderiv_le_of_lipschitzOn ℝ (hCopen.mem_nhds hxC) hL
      push_cast at h
      exact h
    have hbd : ‖fderiv ℝ F x‖ ≤ 3 * |fderiv ℝ F x (e b)| := by
      apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
      intro u
      rw [Real.norm_eq_abs, htan u, abs_mul]
      have h1 : |u b| ≤ ‖u‖ := by
        have := PiLp.norm_apply_le u b
        rwa [Real.norm_eq_abs] at this
      have h2 : |fderiv ℝ w x u| ≤ 2 * ‖u‖ := by
        have := (fderiv ℝ w x).le_opNorm u
        rw [Real.norm_eq_abs] at this
        calc |fderiv ℝ w x u| ≤ ‖fderiv ℝ w x‖ * ‖u‖ := this
          _ ≤ 2 * ‖u‖ := mul_le_mul_of_nonneg_right hdw (norm_nonneg u)
      have h3 : |u b - fderiv ℝ w x u| ≤ 3 * ‖u‖ := by
        obtain ⟨h1a, h1b⟩ := abs_le.1 h1
        obtain ⟨h2a, h2b⟩ := abs_le.1 h2
        rw [abs_le]
        constructor <;> linarith
      have h4 := abs_nonneg (fderiv ℝ F x (e b))
      calc |fderiv ℝ F x (e b)| * |u b - fderiv ℝ w x u|
          ≤ |fderiv ℝ F x (e b)| * (3 * ‖u‖) := mul_le_mul_of_nonneg_left h3 h4
        _ = 3 * |fderiv ℝ F x (e b)| * ‖u‖ := by ring
    have h5 : ‖fderiv ℝ F x - fderiv ℝ F p‖ < ‖fderiv ℝ F p‖ / 8 := by
      have := hδc (show dist x p < δ by rw [dist_eq_norm]; exact hxp_d)
      rwa [dist_eq_norm] at this
    have h6 : |fderiv ℝ F x (e b)| ≤ ‖fderiv ℝ F x - fderiv ℝ F p‖ := by
      have h7 : fderiv ℝ F x (e b) = (fderiv ℝ F x - fderiv ℝ F p) (e b) := by
        rw [ContinuousLinearMap.sub_apply, h0, sub_zero]
      rw [h7, ← Real.norm_eq_abs]
      calc ‖(fderiv ℝ F x - fderiv ℝ F p) (e b)‖
          ≤ ‖fderiv ℝ F x - fderiv ℝ F p‖ * ‖e b‖ := ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ F x - fderiv ℝ F p‖ := by rw [he, mul_one]
    have h8 : ‖fderiv ℝ F p‖ ≤ ‖fderiv ℝ F x‖ + ‖fderiv ℝ F x - fderiv ℝ F p‖ := by
      have := norm_sub_norm_le (fderiv ℝ F p) (fderiv ℝ F x)
      rw [norm_sub_rev] at this
      linarith
    linarith
  
  obtain ⟨r', hr'⟩ : ∃ r' : ℝ, r' = min r (R0 - dist p c) := ⟨_, rfl⟩
  have hr'0 : 0 < r' := by
    rw [hr']
    exact lt_min hr (sub_pos.2 (Metric.mem_ball.1 hpB))
  have hsub1 : Metric.ball p r' ⊆ Metric.ball p r :=
    Metric.ball_subset_ball (by rw [hr']; exact min_le_left _ _)
  have hsub2 : Metric.ball p r' ⊆ Metric.ball c R0 := by
    intro y hy
    rw [Metric.mem_ball] at hy ⊢
    have h1 := dist_triangle y p c
    have h2 : r' ≤ R0 - dist p c := by rw [hr']; exact min_le_right _ _
    linarith
  
  obtain ⟨δ₁, hδ₁, δ₂, hδ₂, v, hvp, hvc, hvz, hvg, hvu⟩ :=
    ift_planar_graph S p r' hr'0 F (hF.mono hsub1) (fun y hy => hSF y (hsub1 hy)) hpS b hb
  
  refine ⟨min δ₁ (δ₂ / 2), lt_min hδ₁ (by linarith), v, hvp, ?_, ?_, ?_⟩
  · refine hvc.mono ?_
    intro y hy
    have hy' : ‖coordPlaneProj b (y - q)‖ < min δ₁ (δ₂ / 2) := hy
    show ‖coordPlaneProj b (y - p)‖ < δ₁
    rw [hPpq]
    exact lt_of_lt_of_le hy' (min_le_left _ _)
  · intro y hy
    have hy1 : ‖coordPlaneProj b (y - p)‖ < δ₁ := by
      rw [hPpq]
      exact lt_of_lt_of_le hy (min_le_left _ _)
    exact ⟨(hvg y hy1).2.1, hsub2 (hvg y hy1).2.2⟩
  · intro y hy hyC
    obtain ⟨Y, hY⟩ : ∃ Y : E3, Y = coordPlaneProj b y + w y • e b := ⟨_, rfl⟩
    have hPY : coordPlaneProj b Y = coordPlaneProj b y := by rw [hY, hPgp]
    have hYb : Y b = w y := by rw [hY, hgpb]
    have hY1 : ‖coordPlaneProj b (Y - p)‖ < δ₁ := by
      rw [hPpq, hP5, hPY, ← hP5]
      exact lt_of_lt_of_le hy (min_le_left _ _)
    have hY2 : |Y b - p b| < δ₂ := by
      rw [hYb, hpb]
      have h1 := ht y hyC
      have h2 : ‖coordPlaneProj b (y - q)‖ < δ₂ / 2 := lt_of_lt_of_le hy (min_le_right _ _)
      linarith
    have hYS : Y ∈ S := by
      rw [hY]
      exact hgr y hyC
    have h1 := hvu Y hY1 hY2 hYS
    rw [hYb, ← hvp Y, hPY, hvp] at h1
    exact h1.symm

theorem sheet_collar_uniform (T : Set E3) (b : Fin 3) (z0 : E3) (R : ℝ) (w : E3 → ℝ)
    (hpatch : ∀ q : E3, q b = 0 → ‖q - coordPlaneProj b z0‖ = R → ∃ ε > 0, ∃ v : E3 → ℝ,
      (∀ y, v (coordPlaneProj b y) = v y) ∧
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj b (y - q)‖ < ε} ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε → coordPlaneProj b y + v y • e b ∈ T) ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε → ‖coordPlaneProj b (y - z0)‖ < R → v y = w y)) :
    ∃ η > 0, ∃ p : E3 → E3 → ℝ, ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      (∀ y, p x (coordPlaneProj b y) = p x y) ∧
      ContDiffOn ℝ ∞ (p x) {y | ‖coordPlaneProj b (y - x)‖ < η} ∧
      (∀ y, ‖coordPlaneProj b (y - x)‖ < η → coordPlaneProj b y + p x y • e b ∈ T) ∧
      (∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - z0)‖ < R → p x y = w y) :=
by
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hP7 : ∀ q : E3, q b = 0 → coordPlaneProj b q = q := by
    intro q hq
    simp [coordPlaneProj, hq]
  set Γ : Set E3 := {x | x b = 0 ∧ ‖x - coordPlaneProj b z0‖ = R} with hΓ
  have hcpt : IsCompact Γ := by
    have h1 : Γ = Metric.sphere (coordPlaneProj b z0) R ∩ {x : E3 | x b = 0} := by
      ext x
      simp only [hΓ, Set.mem_setOf_eq, Set.mem_inter_iff, mem_sphere_iff_norm]
      exact And.comm
    rw [h1]
    refine (isCompact_sphere _ _).inter_right (isClosed_eq ?_ continuous_const)
    fun_prop
  have h' : ∀ q : Γ, ∃ ε > 0, ∃ v : E3 → ℝ,
      (∀ y, v (coordPlaneProj b y) = v y) ∧
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj b (y - (q : E3))‖ < ε} ∧
      (∀ y, ‖coordPlaneProj b (y - (q : E3))‖ < ε → coordPlaneProj b y + v y • e b ∈ T) ∧
      (∀ y, ‖coordPlaneProj b (y - (q : E3))‖ < ε → ‖coordPlaneProj b (y - z0)‖ < R →
        v y = w y) :=
    fun q => hpatch q.1 q.2.1 q.2.2
  choose ε hε v hv using h'
  obtain ⟨δ, hδ, hL⟩ := lebesgue_number_lemma_of_metric hcpt
    (c := fun i : Γ => Metric.ball (i : E3) (ε i)) (fun i => Metric.isOpen_ball)
    (fun x hx => Set.mem_iUnion.2 ⟨⟨x, hx⟩, Metric.mem_ball_self (hε ⟨x, hx⟩)⟩)
  have hincl : ∀ x ∈ Γ, ∀ i : Γ, Metric.ball x δ ⊆ Metric.ball (i : E3) (ε i) →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < δ → ‖coordPlaneProj b (y - (i : E3))‖ < ε i := by
    intro x hx i hi y hy
    rw [hP5, hP7 x hx.1] at hy
    rw [hP5, hP7 (i : E3) i.2.1]
    have hm : coordPlaneProj b y ∈ Metric.ball x δ := by
      rw [Metric.mem_ball, dist_eq_norm]
      exact hy
    have hm' := hi hm
    rw [Metric.mem_ball, dist_eq_norm] at hm'
    exact hm'
  have hfam : ∀ x : E3, ∃ f : E3 → ℝ, x ∈ Γ →
      (∀ y, f (coordPlaneProj b y) = f y) ∧
      ContDiffOn ℝ ∞ f {y | ‖coordPlaneProj b (y - x)‖ < δ} ∧
      (∀ y, ‖coordPlaneProj b (y - x)‖ < δ → coordPlaneProj b y + f y • e b ∈ T) ∧
      (∀ y, ‖coordPlaneProj b (y - x)‖ < δ → ‖coordPlaneProj b (y - z0)‖ < R → f y = w y) := by
    intro x
    by_cases hx : x ∈ Γ
    · obtain ⟨i, hi⟩ := hL x hx
      obtain ⟨hA, hB, hC, hD⟩ := hv i
      exact ⟨v i, fun _ => ⟨hA, hB.mono (fun y hy => hincl x hx i hi y hy),
        fun y hy => hC y (hincl x hx i hi y hy),
        fun y hy hyR => hD y (hincl x hx i hi y hy) hyR⟩⟩
    · exact ⟨fun _ => 0, fun h => absurd h hx⟩
  choose p hp using hfam
  exact ⟨δ, hδ, p, fun x hxb hxR => hp x ⟨hxb, hxR⟩⟩

theorem sheet_collar_compat (c : E3) (R0 : ℝ) (S : Set E3)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (b : Fin 3) (z0 : E3) (R η : ℝ) (hR : 0 < R) (hη : 0 < η) (w : E3 → ℝ)
    (x x' : E3) (hx : x b = 0) (hxR : ‖x - coordPlaneProj b z0‖ = R)
    (hx' : x' b = 0) (hx'R : ‖x' - coordPlaneProj b z0‖ = R) (hxx' : x ≠ x')
    (p₁ p₂ : E3 → ℝ) (hp₁ : ∀ y, p₁ (coordPlaneProj b y) = p₁ y)
    (hp₂ : ∀ y, p₂ (coordPlaneProj b y) = p₂ y)
    (hp₁c : ContDiffOn ℝ ∞ p₁ {y | ‖coordPlaneProj b (y - x)‖ < η})
    (hp₂c : ContDiffOn ℝ ∞ p₂ {y | ‖coordPlaneProj b (y - x')‖ < η})
    (hp₁g : ∀ y, ‖coordPlaneProj b (y - x)‖ < η →
      coordPlaneProj b y + p₁ y • e b ∈ S ∩ Metric.ball c R0)
    (hp₂g : ∀ y, ‖coordPlaneProj b (y - x')‖ < η →
      coordPlaneProj b y + p₂ y • e b ∈ S ∩ Metric.ball c R0)
    (hp₁w : ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - z0)‖ < R → p₁ y = w y)
    (hp₂w : ∀ y, ‖coordPlaneProj b (y - x')‖ < η → ‖coordPlaneProj b (y - z0)‖ < R → p₂ y = w y) :
    ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - x')‖ < η → p₁ y = p₂ y :=
by
  intro y hy hy'
  have hP5 : ∀ (u v : E3),
      coordPlaneProj b (u - v) = coordPlaneProj b u - coordPlaneProj b v := by
    intro u v
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP7 : ∀ q : E3, q b = 0 → coordPlaneProj b q = q := by
    intro q hq
    simp [coordPlaneProj, hq]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hopen : ∀ q : E3, IsOpen {y : E3 | ‖coordPlaneProj b (y - q)‖ < η} := fun q =>
    isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  have hconv : ∀ q : E3, Convex ℝ {y : E3 | ‖coordPlaneProj b (y - q)‖ < η} := by
    intro q
    rw [convex_iff_forall_pos]
    intro u hu v hv a a' ha ha' haa
    have hlin : coordPlaneProj b (a • u + a' • v - q) =
        a • coordPlaneProj b (u - q) + a' • coordPlaneProj b (v - q) := by
      have ha'' : a' = 1 - a := by linarith
      subst ha''
      ext i
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    show ‖coordPlaneProj b (a • u + a' • v - q)‖ < η
    rw [hlin]
    have hu' : ‖coordPlaneProj b (u - q)‖ < η := hu
    have hv' : ‖coordPlaneProj b (v - q)‖ < η := hv
    calc ‖a • coordPlaneProj b (u - q) + a' • coordPlaneProj b (v - q)‖
        ≤ ‖a • coordPlaneProj b (u - q)‖ + ‖a' • coordPlaneProj b (v - q)‖ := norm_add_le _ _
      _ = a * ‖coordPlaneProj b (u - q)‖ + a' * ‖coordPlaneProj b (v - q)‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg ha.le, Real.norm_of_nonneg ha'.le]
      _ < a * η + a' * η := by
          have h1 := mul_lt_mul_of_pos_left hu' ha
          have h2 := mul_lt_mul_of_pos_left hv' ha'
          linarith
      _ = η := by rw [← add_mul, haa, one_mul]
  have hsat : ∀ (q u : E3),
      coordPlaneProj b (coordPlaneProj b u - q) = coordPlaneProj b (u - q) := by
    intro q u
    rw [hP5, hP3, ← hP5]
  have hUo : IsOpen ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) := (hopen x).inter (hopen x')
  have hUc : IsPreconnected ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) := ((hconv x).inter (hconv x')).isPreconnected
  have hUs : ∀ u, u ∈ ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) ↔ coordPlaneProj b u ∈
      ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) := by
    intro u
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, hsat]
  have hd₁ : DifferentiableOn ℝ p₁ ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) :=
    (hp₁c.mono Set.inter_subset_left).differentiableOn (by simp)
  have hc₂ : ContinuousOn p₂ ({y : E3 | ‖coordPlaneProj b (y - x)‖ < η} ∩
      {y : E3 | ‖coordPlaneProj b (y - x')‖ < η}) :=
    (hp₂c.mono Set.inter_subset_right).continuousOn
  
  have hdiffb : (x' - x) b = 0 := by
    simp only [PiLp.sub_apply, hx, hx', sub_zero]
  have hxx2 : ‖x' - x‖ < 2 * η := by
    have h1 : x' - x = coordPlaneProj b (y - x) - coordPlaneProj b (y - x') := by
      rw [← hP5, show y - x - (y - x') = x' - x by abel, hP7 _ hdiffb]
    rw [h1]
    have h2 := norm_sub_le (coordPlaneProj b (y - x)) (coordPlaneProj b (y - x'))
    linarith
  have hmx : (1 / 2 : ℝ) • (x + x') - x = (1 / 2 : ℝ) • (x' - x) := by
    ext i
    simp only [PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    ring
  have hmx' : (1 / 2 : ℝ) • (x + x') - x' = (1 / 2 : ℝ) • (x - x') := by
    ext i
    simp only [PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
    ring
  have hmb : ((1 / 2 : ℝ) • (x + x')) b = 0 := by
    simp only [PiLp.smul_apply, PiLp.add_apply, hx, hx', add_zero, smul_eq_mul, mul_zero]
  have hm1 : ‖coordPlaneProj b ((1 / 2 : ℝ) • (x + x') - x)‖ < η := by
    rw [hmx, hP7 _ (by simp only [PiLp.smul_apply, hdiffb, smul_eq_mul, mul_zero]),
      norm_smul, Real.norm_of_nonneg (by norm_num)]
    linarith
  have hm2 : ‖coordPlaneProj b ((1 / 2 : ℝ) • (x + x') - x')‖ < η := by
    have hdb : (x - x') b = 0 := by simp only [PiLp.sub_apply, hx, hx', sub_zero]
    rw [hmx', hP7 _ (by simp only [PiLp.smul_apply, hdb, smul_eq_mul, mul_zero]),
      norm_smul, Real.norm_of_nonneg (by norm_num), norm_sub_rev]
    linarith
  have hmz : ‖coordPlaneProj b ((1 / 2 : ℝ) • (x + x') - z0)‖ < R := by
    have he : coordPlaneProj b ((1 / 2 : ℝ) • (x + x') - z0) =
        (1 / 2 : ℝ) • ((x - coordPlaneProj b z0) + (x' - coordPlaneProj b z0)) := by
      rw [hP5, hP7 _ hmb]
      ext i
      simp only [PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    have hpl := parallelogram_law_with_norm ℝ (x - coordPlaneProj b z0)
      (x' - coordPlaneProj b z0)
    have hsub : (x - coordPlaneProj b z0) - (x' - coordPlaneProj b z0) = x - x' := by abel
    rw [hsub, hxR, hx'R] at hpl
    have hpos : 0 < ‖x - x'‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hxx')
    have hn0 := norm_nonneg ((x - coordPlaneProj b z0) + (x' - coordPlaneProj b z0))
    have hlt : ‖(x - coordPlaneProj b z0) + (x' - coordPlaneProj b z0)‖ < 2 * R := by
      by_contra hc
      push_neg at hc
      nlinarith
    rw [he, norm_smul, Real.norm_of_nonneg (by norm_num)]
    linarith
  have h₀ : p₁ ((1 / 2 : ℝ) • (x + x')) = p₂ ((1 / 2 : ℝ) • (x + x')) :=
    (hp₁w _ hm1 hmz).trans (hp₂w _ hm2 hmz).symm
  exact sheet_uniqueness c R0 S hS2 b _ hUo hUc hUs p₁ p₂ hp₁ hp₂ hd₁ hc₂
    (fun u hu => hp₁g u hu.1) (fun u hu => hp₂g u hu.2) _ ⟨hm1, hm2⟩ h₀ y ⟨hy, hy'⟩

theorem sheet_collar_glue (S : Set E3) (b : Fin 3) (z0 : E3) (R η : ℝ) (hR : 0 < R)
    (w : E3 → ℝ) (hw : ∀ y, w (coordPlaneProj b y) = w y)
    (hwc : ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < R}) (hwz : w z0 = z0 b)
    (hgr : ∀ y, ‖coordPlaneProj b (y - z0)‖ < R → coordPlaneProj b y + w y • e b ∈ S)
    (pc : E3 → E3 → ℝ)
    (hp : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, pc x (coordPlaneProj b y) = pc x y)
    (hpc : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ContDiffOn ℝ ∞ (pc x) {y | ‖coordPlaneProj b (y - x)‖ < η})
    (hpg : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → coordPlaneProj b y + pc x y • e b ∈ S)
    (hpw : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - z0)‖ < R → pc x y = w y)
    (hpp : ∀ x x' : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      x' b = 0 → ‖x' - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - x')‖ < η → pc x y = pc x' y) :
    ∃ w' : E3 → ℝ, (∀ y, w' (coordPlaneProj b y) = w' y) ∧
      ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z0)‖ < R + η} ∧ w' z0 = z0 b ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < R + η → coordPlaneProj b y + w' y • e b ∈ S) ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < R → w' y = w y) :=
by
  
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP7 : ∀ q : E3, q b = 0 → coordPlaneProj b q = q := by
    intro q hq
    simp [coordPlaneProj, hq]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hP6 : ∀ y, coordPlaneProj b (coordPlaneProj b y - z0) = coordPlaneProj b (y - z0) := by
    intro y
    rw [hP5, hP3, ← hP5]
  have hCylOpen : ∀ (x : E3) (r : ℝ), IsOpen {y : E3 | ‖coordPlaneProj b (y - x)‖ < r} :=
    fun x r => isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  
  obtain ⟨π, hπ⟩ : ∃ π : E3 → E3, ∀ y, π y = coordPlaneProj b z0 +
      (R / ‖coordPlaneProj b (y - z0)‖) • coordPlaneProj b (y - z0) := ⟨_, fun y => rfl⟩
  have hrad : ∀ y, R ≤ ‖coordPlaneProj b (y - z0)‖ →
      (π y) b = 0 ∧ ‖π y - coordPlaneProj b z0‖ = R ∧
      ‖coordPlaneProj b (y - π y)‖ = ‖coordPlaneProj b (y - z0)‖ - R := by
    intro y hy
    have hN : 0 < ‖coordPlaneProj b (y - z0)‖ := lt_of_lt_of_le hR hy
    have ht0 : 0 ≤ R / ‖coordPlaneProj b (y - z0)‖ := div_nonneg hR.le hN.le
    have ht1 : R / ‖coordPlaneProj b (y - z0)‖ ≤ 1 := (div_le_one hN).mpr hy
    have htN : R / ‖coordPlaneProj b (y - z0)‖ * ‖coordPlaneProj b (y - z0)‖ = R :=
      div_mul_cancel₀ R hN.ne'
    have h1 : (π y) b = 0 := by
      rw [hπ]
      simp only [PiLp.add_apply, PiLp.smul_apply, hpa, smul_eq_mul, mul_zero, add_zero]
    refine ⟨h1, ?_, ?_⟩
    · rw [hπ, add_sub_cancel_left, norm_smul_of_nonneg ht0, htN]
    · have key : coordPlaneProj b (y - π y) =
          (1 - R / ‖coordPlaneProj b (y - z0)‖) • coordPlaneProj b (y - z0) := by
        have e1 : coordPlaneProj b (y - π y) = coordPlaneProj b y - π y := by
          rw [hP5, hP7 _ h1]
        rw [e1, hπ, sub_smul, one_smul]
        generalize R / ‖coordPlaneProj b (y - z0)‖ = t
        rw [hP5 y z0]
        abel
      rw [key, norm_smul_of_nonneg (by linarith), sub_mul, one_mul, htN]
  
  obtain ⟨w', hw'⟩ : ∃ w' : E3 → ℝ, ∀ y, w' y =
      if ‖coordPlaneProj b (y - z0)‖ < R then w y else pc (π y) y := ⟨_, fun y => rfl⟩
  
  have hK0 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - z0)‖ < R + η := by
    intro x hx hxR y hy
    have h1 : coordPlaneProj b (y - z0) =
        (coordPlaneProj b y - x) + (x - coordPlaneProj b z0) := by
      rw [hP5]; abel
    have h2 : coordPlaneProj b (y - x) = coordPlaneProj b y - x := by rw [hP5, hP7 x hx]
    rw [h1]
    calc ‖(coordPlaneProj b y - x) + (x - coordPlaneProj b z0)‖
        ≤ ‖coordPlaneProj b y - x‖ + ‖x - coordPlaneProj b z0‖ := norm_add_le _ _
      _ < R + η := by rw [← h2, hxR]; linarith
  have hK1 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → w' y = pc x y := by
    intro x hx hxR y hy
    rw [hw']
    split_ifs with hN
    · exact (hpw x hx hxR y hy hN).symm
    · obtain ⟨r1, r2, r3⟩ := hrad y (not_lt.mp hN)
      have h0 := hK0 x hx hxR y hy
      exact hpp (π y) x r1 r2 hx hxR y (by rw [r3]; linarith) hy
  
  have hplan : ∀ y, w' (coordPlaneProj b y) = w' y := by
    intro y
    have hπP : π (coordPlaneProj b y) = π y := by rw [hπ, hπ, hP6]
    rw [hw', hw', hP6, hπP]
    split_ifs with hN
    · exact hw y
    · obtain ⟨r1, r2, -⟩ := hrad y (not_lt.mp hN)
      exact hp (π y) r1 r2 y
  
  have hcentre : w' z0 = z0 b := by
    have hN0 : ‖coordPlaneProj b (z0 - z0)‖ = 0 := by
      rw [sub_self, hP7 0 (by simp), norm_zero]
    rw [hw', if_pos (by rw [hN0]; exact hR), hwz]
  
  have hgraph : ∀ y, ‖coordPlaneProj b (y - z0)‖ < R + η →
      coordPlaneProj b y + w' y • e b ∈ S := by
    intro y hy
    rw [hw']
    split_ifs with hN
    · exact hgr y hN
    · obtain ⟨r1, r2, r3⟩ := hrad y (not_lt.mp hN)
      exact hpg (π y) r1 r2 y (by rw [r3]; linarith)
  
  have hsmooth : ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z0)‖ < R + η} := by
    intro y hy
    have hy' : ‖coordPlaneProj b (y - z0)‖ < R + η := hy
    apply ContDiffAt.contDiffWithinAt
    by_cases hN : ‖coordPlaneProj b (y - z0)‖ < R
    · have hU : {u : E3 | ‖coordPlaneProj b (u - z0)‖ < R} ∈ 𝓝 y :=
        (hCylOpen z0 R).mem_nhds hN
      have hev : w' =ᶠ[𝓝 y] w :=
        Filter.eventually_of_mem hU (fun u hu => by rw [hw']; exact if_pos hu)
      exact (hwc.contDiffAt hU).congr_of_eventuallyEq hev
    · obtain ⟨r1, r2, r3⟩ := hrad y (not_lt.mp hN)
      have hyx : ‖coordPlaneProj b (y - π y)‖ < η := by rw [r3]; linarith
      have hU : {u : E3 | ‖coordPlaneProj b (u - π y)‖ < η} ∈ 𝓝 y :=
        (hCylOpen (π y) η).mem_nhds hyx
      have hev : w' =ᶠ[𝓝 y] pc (π y) :=
        Filter.eventually_of_mem hU (fun u hu => hK1 (π y) r1 r2 u hu)
      exact ((hpc (π y) r1 r2).contDiffAt hU).congr_of_eventuallyEq hev
  exact ⟨w', hplan, hsmooth, hcentre, hgraph, fun y hy => by rw [hw']; exact if_pos hy⟩

theorem sheet_extend_step (c : E3) (R0 K : ℝ) (S : Set E3) (hR0 : 0 < R0) (hK : 0 ≤ K)
    (hS1 : ∀ z ∈ Metric.ball c R0, z ∈ closure S → z ∈ S)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (hS3 : ∀ z ∈ S ∩ Metric.ball c R0, ∀ (b : Fin 3) (w : E3 → ℝ) (r : ℝ), 0 < r →
      ContDiffAt ℝ 2 w (coordPlaneProj b z) → (∀ y, w (coordPlaneProj b y) = w y) →
      z b = w (coordPlaneProj b z) →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < r →
        coordPlaneProj b y + w (coordPlaneProj b y) • e b ∈ S) →
      ‖fderiv ℝ w (coordPlaneProj b z)‖ ≤ 2 →
      ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b z)‖ ≤ K)
    (b : Fin 3) (z0 : E3) (hz0c : ‖z0 - c‖ < R0 / 4) (r1 s : ℝ) (hr1 : 0 < r1)
    (hKr1 : K * r1 ≤ 1 / 8) (h4r1 : 4 * r1 ≤ R0) (hs0 : 0 ≤ s) (hs : s ≤ 7 / 4)
    (R : ℝ) (hR : 0 < R) (hRr : R < r1) (w : E3 → ℝ)
    (hw : ∀ y, w (coordPlaneProj b y) = w y)
    (hwc : ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < R}) (hwz : w z0 = z0 b)
    (hgr : ∀ y, ‖coordPlaneProj b (y - z0)‖ < R → coordPlaneProj b y + w y • e b ∈ S)
    (hd0 : ‖fderiv ℝ w z0‖ ≤ s) :
    ∃ R' > R, ∃ w' : E3 → ℝ, (∀ y, w' (coordPlaneProj b y) = w' y) ∧
      ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z0)‖ < R'} ∧ w' z0 = z0 b ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < R' → coordPlaneProj b y + w' y • e b ∈ S) ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < R → w' y = w y) :=
by
  
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP7 : ∀ q : E3, q b = 0 → coordPlaneProj b q = q := by
    intro q hq
    simp [coordPlaneProj, hq]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hsat : ∀ y, ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ = ‖coordPlaneProj b (y - z0)‖ := by
    intro y
    rw [hP5, hP3, ← hP5]
  have hCopen : IsOpen {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} :=
    isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  have hCconv : Convex ℝ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
    rw [convex_iff_forall_pos]
    intro x hx y hy a a' ha ha' haa
    have hlin : coordPlaneProj b (a • x + a' • y - z0) =
        a • coordPlaneProj b (x - z0) + a' • coordPlaneProj b (y - z0) := by
      have ha'' : a' = 1 - a := by linarith
      subst ha''
      ext i
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    show ‖coordPlaneProj b (a • x + a' • y - z0)‖ < R
    rw [hlin]
    have hx' : ‖coordPlaneProj b (x - z0)‖ < R := hx
    have hy' : ‖coordPlaneProj b (y - z0)‖ < R := hy
    calc ‖a • coordPlaneProj b (x - z0) + a' • coordPlaneProj b (y - z0)‖
        ≤ ‖a • coordPlaneProj b (x - z0)‖ + ‖a' • coordPlaneProj b (y - z0)‖ := norm_add_le _ _
      _ = a * ‖coordPlaneProj b (x - z0)‖ + a' * ‖coordPlaneProj b (y - z0)‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg ha.le, Real.norm_of_nonneg ha'.le]
      _ < a * R + a' * R := by
          have h1 := mul_lt_mul_of_pos_left hx' ha
          have h2 := mul_lt_mul_of_pos_left hy' ha'
          linarith
      _ = R := by rw [← add_mul, haa, one_mul]
  
  have hap := sheet_slope_apriori c R0 K S hR0 hK hS3 b z0 hz0c R s hR
    (le_trans (mul_le_mul_of_nonneg_left hRr.le hK) hKr1) (by linarith) hs0 hs w hw hwc hwz
    hgr hd0
  have hd2 : ∀ y ∈ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R}, ‖fderiv ℝ w y‖ ≤ 2 := by
    intro y hy
    have hy' : ‖coordPlaneProj b (y - z0)‖ < R := hy
    have h1 := (hap y hy').1
    have h2 : K * ‖coordPlaneProj b (y - z0)‖ ≤ K * R := mul_le_mul_of_nonneg_left hy'.le hK
    have h3 : K * R ≤ K * r1 := mul_le_mul_of_nonneg_left hRr.le hK
    linarith
  have hdiff : DifferentiableOn ℝ w {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} :=
    hwc.differentiableOn (by simp)
  
  have hlip : ∀ y y', ‖coordPlaneProj b (y - z0)‖ < R → ‖coordPlaneProj b (y' - z0)‖ < R →
      |w y - w y'| ≤ 2 * ‖coordPlaneProj b (y - y')‖ := by
    intro y y' hy hy'
    have hPy : coordPlaneProj b y ∈ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
      show ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ < R
      rw [hsat]
      exact hy
    have hPy' : coordPlaneProj b y' ∈ {y : E3 | ‖coordPlaneProj b (y - z0)‖ < R} := by
      show ‖coordPlaneProj b (coordPlaneProj b y' - z0)‖ < R
      rw [hsat]
      exact hy'
    have h := Convex.norm_image_sub_le_of_norm_fderiv_le
      (fun x hx => hdiff.differentiableAt (hCopen.mem_nhds hx)) hd2 hCconv hPy' hPy
    rw [hw, hw, Real.norm_eq_abs, ← hP5] at h
    exact h
  
  have hball : ∀ y (t : ℝ), ‖coordPlaneProj b (y - z0)‖ ≤ R → |t - z0 b| ≤ 2 * R →
      coordPlaneProj b y + t • e b ∈ Metric.ball c R0 := by
    intro y t hy ht
    have hv : coordPlaneProj b y + t • e b - c =
        (coordPlaneProj b (y - z0) + (t - z0 b) • e b) + (z0 - c) := by
      ext i
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    have he : ‖e b‖ = 1 := by simp [e]
    have hnorm : ‖coordPlaneProj b y + t • e b - c‖ < R0 := by
      rw [hv]
      calc ‖(coordPlaneProj b (y - z0) + (t - z0 b) • e b) + (z0 - c)‖
          ≤ ‖coordPlaneProj b (y - z0) + (t - z0 b) • e b‖ + ‖z0 - c‖ := norm_add_le _ _
        _ ≤ (‖coordPlaneProj b (y - z0)‖ + ‖(t - z0 b) • e b‖) + ‖z0 - c‖ :=
            by linarith [norm_add_le (coordPlaneProj b (y - z0)) ((t - z0 b) • e b)]
        _ = ‖coordPlaneProj b (y - z0)‖ + |t - z0 b| + ‖z0 - c‖ := by
            rw [norm_smul, he, mul_one, Real.norm_eq_abs]
        _ < R0 := by linarith
    rw [Metric.mem_ball, dist_eq_norm]
    exact hnorm
  
  have hpatch : ∀ q : E3, q b = 0 → ‖q - coordPlaneProj b z0‖ = R → ∃ ε > 0, ∃ v : E3 → ℝ,
      (∀ y, v (coordPlaneProj b y) = v y) ∧
      ContDiffOn ℝ ∞ v {y | ‖coordPlaneProj b (y - q)‖ < ε} ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε →
        coordPlaneProj b y + v y • e b ∈ S ∩ Metric.ball c R0) ∧
      (∀ y, ‖coordPlaneProj b (y - q)‖ < ε → ‖coordPlaneProj b (y - z0)‖ < R → v y = w y) := by
    intro q hq hqR
    have hq' : ‖coordPlaneProj b (q - z0)‖ = R := by
      rw [hP5, hP7 q hq]
      exact hqR
    exact sheet_boundary_patch c R0 S hS1 hS2 b z0 R hR w hw hwc hwz hgr hlip hball q hq'
  
  obtain ⟨η, hη, p, hp⟩ := sheet_collar_uniform (S ∩ Metric.ball c R0) b z0 R w hpatch
  
  have hpp : ∀ x x' : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      x' b = 0 → ‖x' - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - x')‖ < η →
        p x y = p x' y := by
    intro x x' hx hxR hx' hx'R y hy hy'
    by_cases hxx : x = x'
    · subst hxx
      rfl
    · obtain ⟨a1, a2, a3, a4⟩ := hp x hx hxR
      obtain ⟨b1, b2, b3, b4⟩ := hp x' hx' hx'R
      exact sheet_collar_compat c R0 S hS2 b z0 R η hR hη w x x' hx hxR hx' hx'R hxx
        (p x) (p x') a1 b1 a2 b2 a3 b3 a4 b4 y hy hy'
  
  have hp1 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, p x (coordPlaneProj b y) = p x y := by
    intro x hx hxR
    exact (hp x hx hxR).1
  have hp2 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ContDiffOn ℝ ∞ (p x) {y | ‖coordPlaneProj b (y - x)‖ < η} := by
    intro x hx hxR
    exact (hp x hx hxR).2.1
  have hp3 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → coordPlaneProj b y + p x y • e b ∈ S := by
    intro x hx hxR y hy
    exact ((hp x hx hxR).2.2.1 y hy).1
  have hp4 : ∀ x : E3, x b = 0 → ‖x - coordPlaneProj b z0‖ = R →
      ∀ y, ‖coordPlaneProj b (y - x)‖ < η → ‖coordPlaneProj b (y - z0)‖ < R → p x y = w y := by
    intro x hx hxR
    exact (hp x hx hxR).2.2.2
  obtain ⟨w', h1, h2, h3, h4, h5⟩ :=
    sheet_collar_glue S b z0 R η hR w hw hwc hwz hgr p hp1 hp2 hp3 hp4 hpp
  exact ⟨R + η, by linarith, w', h1, h2, h3, h4, h5⟩

theorem sheet_radius_continuation (S : Set E3) (b : Fin 3) (z0 : E3) (s r1 : ℝ) (hr1 : 0 < r1)
    (hU : ∀ (r r' : ℝ) (w w' : E3 → ℝ), 0 < r → r ≤ r1 → 0 < r' → r' ≤ r1 →
      (∀ y, w (coordPlaneProj b y) = w y) →
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < r} → w z0 = z0 b →
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < r → coordPlaneProj b y + w y • e b ∈ S) →
      ‖fderiv ℝ w z0‖ ≤ s →
      (∀ y, w' (coordPlaneProj b y) = w' y) →
      ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z0)‖ < r'} → w' z0 = z0 b →
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < r' → coordPlaneProj b y + w' y • e b ∈ S) →
      ‖fderiv ℝ w' z0‖ ≤ s →
      ∀ y, ‖coordPlaneProj b (y - z0)‖ < min r r' → w y = w' y)
    (hE : ∀ (R : ℝ) (w : E3 → ℝ), 0 < R → R < r1 →
      (∀ y, w (coordPlaneProj b y) = w y) →
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < R} → w z0 = z0 b →
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < R → coordPlaneProj b y + w y • e b ∈ S) →
      ‖fderiv ℝ w z0‖ ≤ s →
      ∃ R' > R, ∃ w' : E3 → ℝ, (∀ y, w' (coordPlaneProj b y) = w' y) ∧
        ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z0)‖ < R'} ∧ w' z0 = z0 b ∧
        (∀ y, ‖coordPlaneProj b (y - z0)‖ < R' → coordPlaneProj b y + w' y • e b ∈ S) ∧
        ‖fderiv ℝ w' z0‖ ≤ s)
    (δ0 : ℝ) (hδ0 : 0 < δ0) (w0 : E3 → ℝ) (hw0 : ∀ y, w0 (coordPlaneProj b y) = w0 y)
    (hw0c : ContDiffOn ℝ ∞ w0 {y | ‖coordPlaneProj b (y - z0)‖ < δ0}) (hw0z : w0 z0 = z0 b)
    (hw0g : ∀ y, ‖coordPlaneProj b (y - z0)‖ < δ0 → coordPlaneProj b y + w0 y • e b ∈ S)
    (hd0 : ‖fderiv ℝ w0 z0‖ ≤ s) :
    ∃ w : E3 → ℝ, (∀ y, w (coordPlaneProj b y) = w y) ∧
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < r1} ∧ w z0 = z0 b ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < r1 → coordPlaneProj b y + w y • e b ∈ S) ∧
      ‖fderiv ℝ w z0‖ ≤ s :=
by
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hτP : ∀ y : E3, ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ =
      ‖coordPlaneProj b (y - z0)‖ := by
    intro y
    rw [hP5, hP3, ← hP5]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hCylOpen : ∀ ρ : ℝ, IsOpen {y : E3 | ‖coordPlaneProj b (y - z0)‖ < ρ} := by
    intro ρ
    exact isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  have hτz : ‖coordPlaneProj b (z0 - z0)‖ = 0 := by simp [coordPlaneProj]
  let Q : ℝ → Prop := fun ρ => ∃ w : E3 → ℝ, (∀ y, w (coordPlaneProj b y) = w y) ∧
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < ρ} ∧ w z0 = z0 b ∧
      (∀ y, ‖coordPlaneProj b (y - z0)‖ < ρ → coordPlaneProj b y + w y • e b ∈ S) ∧
      ‖fderiv ℝ w z0‖ ≤ s
  show Q r1
  
  have hmono : ∀ ρ ρ' : ℝ, Q ρ → ρ' ≤ ρ → Q ρ' := by
    rintro ρ ρ' ⟨w, h1, h2, h3, h4, h5⟩ hle
    refine ⟨w, h1, h2.mono ?_, h3, fun y hy => h4 y (lt_of_lt_of_le hy hle), h5⟩
    intro y hy
    exact lt_of_lt_of_le hy hle
  
  have hlim : ∀ ρ : ℝ, 0 < ρ → ρ ≤ r1 → (∀ t : ℝ, 0 < t → t < ρ → Q t) → Q ρ := by
    intro ρ hρ hρr1 hall
    have hall' : ∀ t : ℝ, ∃ w : E3 → ℝ, 0 < t → t < ρ →
        ((∀ y, w (coordPlaneProj b y) = w y) ∧
        ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z0)‖ < t} ∧ w z0 = z0 b ∧
        (∀ y, ‖coordPlaneProj b (y - z0)‖ < t → coordPlaneProj b y + w y • e b ∈ S) ∧
        ‖fderiv ℝ w z0‖ ≤ s) := by
      intro t
      by_cases ht : 0 < t ∧ t < ρ
      · obtain ⟨w, hw⟩ := hall t ht.1 ht.2
        exact ⟨w, fun _ _ => hw⟩
      · exact ⟨fun _ => 0, fun h1 h2 => absurd ⟨h1, h2⟩ ht⟩
    choose W hW using hall'
    have hK : ∀ t t' : ℝ, ∀ y : E3, 0 < t → t < ρ → 0 < t' → t' < ρ →
        ‖coordPlaneProj b (y - z0)‖ < min t t' → W t y = W t' y := by
      intro t t' y ht htρ ht' ht'ρ hy
      obtain ⟨a1, a2, a3, a4, a5⟩ := hW t ht htρ
      obtain ⟨b1, b2, b3, b4, b5⟩ := hW t' ht' ht'ρ
      exact hU t t' (W t) (W t') ht (by linarith) ht' (by linarith) a1 a2 a3 a4 a5
        b1 b2 b3 b4 b5 y hy
    have hmid : ∀ y : E3, ‖coordPlaneProj b (y - z0)‖ < ρ →
        0 < (‖coordPlaneProj b (y - z0)‖ + ρ) / 2 ∧
        (‖coordPlaneProj b (y - z0)‖ + ρ) / 2 < ρ ∧
        ‖coordPlaneProj b (y - z0)‖ < (‖coordPlaneProj b (y - z0)‖ + ρ) / 2 := by
      intro y hy
      have hn := norm_nonneg (coordPlaneProj b (y - z0))
      refine ⟨by linarith, by linarith, by linarith⟩
    let w : E3 → ℝ := fun y => if ‖coordPlaneProj b (y - z0)‖ < ρ then
      W ((‖coordPlaneProj b (y - z0)‖ + ρ) / 2) y else 0
    have hG0 : ∀ (t : ℝ) (y : E3), 0 < t → t < ρ → ‖coordPlaneProj b (y - z0)‖ < t →
        w y = W t y := by
      intro t y ht htρ hy
      have hyρ : ‖coordPlaneProj b (y - z0)‖ < ρ := lt_trans hy htρ
      obtain ⟨m1, m2, m3⟩ := hmid y hyρ
      show (if ‖coordPlaneProj b (y - z0)‖ < ρ then
        W ((‖coordPlaneProj b (y - z0)‖ + ρ) / 2) y else 0) = W t y
      rw [if_pos hyρ]
      exact hK _ t y m1 m2 ht htρ (lt_min m3 hy)
    have hev : ∀ (t : ℝ) (y : E3), 0 < t → t < ρ → ‖coordPlaneProj b (y - z0)‖ < t →
        w =ᶠ[𝓝 y] W t := by
      intro t y ht htρ hy
      exact Filter.eventually_of_mem ((hCylOpen t).mem_nhds hy)
        (fun x hx => hG0 t x ht htρ hx)
    have hz : ‖coordPlaneProj b (z0 - z0)‖ < ρ / 2 := by rw [hτz]; linarith
    refine ⟨w, ?_, ?_, ?_, ?_, ?_⟩
    · intro y
      show (if ‖coordPlaneProj b (coordPlaneProj b y - z0)‖ < ρ then
          W ((‖coordPlaneProj b (coordPlaneProj b y - z0)‖ + ρ) / 2) (coordPlaneProj b y)
          else 0) =
        (if ‖coordPlaneProj b (y - z0)‖ < ρ then
          W ((‖coordPlaneProj b (y - z0)‖ + ρ) / 2) y else 0)
      rw [hτP y]
      split_ifs with hy
      · obtain ⟨m1, m2, m3⟩ := hmid y hy
        exact (hW _ m1 m2).1 y
      · rfl
    · intro y hy
      have hy' : ‖coordPlaneProj b (y - z0)‖ < ρ := hy
      obtain ⟨m1, m2, m3⟩ := hmid y hy'
      have hc := (hW _ m1 m2).2.1.contDiffAt ((hCylOpen _).mem_nhds m3)
      exact (hc.congr_of_eventuallyEq (hev _ y m1 m2 m3)).contDiffWithinAt
    · rw [hG0 (ρ / 2) z0 (by linarith) (by linarith) hz]
      exact (hW _ (by linarith) (by linarith)).2.2.1
    · intro y hy
      obtain ⟨m1, m2, m3⟩ := hmid y hy
      rw [hG0 _ y m1 m2 m3]
      exact (hW _ m1 m2).2.2.2.1 y m3
    · rw [(hev (ρ / 2) z0 (by linarith) (by linarith) hz).fderiv_eq]
      exact (hW _ (by linarith) (by linarith)).2.2.2.2
  
  have hinit : Q (min δ0 r1) :=
    hmono δ0 _ ⟨w0, hw0, hw0c, hw0z, hw0g, hd0⟩ (min_le_left _ _)
  let A : Set ℝ := {ρ | 0 < ρ ∧ ρ ≤ r1 ∧ Q ρ}
  have hminA : min δ0 r1 ∈ A := ⟨lt_min hδ0 hr1, min_le_right _ _, hinit⟩
  have hAne : A.Nonempty := ⟨_, hminA⟩
  have hAbdd : BddAbove A := ⟨r1, fun x hx => hx.2.1⟩
  have hs1 : min δ0 r1 ≤ sSup A := le_csSup hAbdd hminA
  have hspos : 0 < sSup A := lt_of_lt_of_le (lt_min hδ0 hr1) hs1
  have hsle : sSup A ≤ r1 := csSup_le hAne (fun x hx => hx.2.1)
  have hQs : Q (sSup A) := by
    apply hlim _ hspos hsle
    intro t ht hts
    obtain ⟨a, ha, hta⟩ := exists_lt_of_lt_csSup hAne hts
    exact hmono a t ha.2.2 hta.le
  have heq : sSup A = r1 := by
    by_contra hne
    have hlt : sSup A < r1 := lt_of_le_of_ne hsle hne
    obtain ⟨w, h1, h2, h3, h4, h5⟩ := hQs
    obtain ⟨R', hR', hQR'⟩ := hE (sSup A) w hspos hlt h1 h2 h3 h4 h5
    have hlt2 : sSup A < min R' r1 := lt_min hR' hlt
    have hmem : min R' r1 ∈ A :=
      ⟨lt_trans hspos hlt2, min_le_right _ _, hmono R' _ hQR' (min_le_left _ _)⟩
    have := le_csSup hAbdd hmem
    linarith
  rw [heq] at hQs
  exact hQs

theorem sheet_through_point (c : E3) (R0 K : ℝ) (S : Set E3) (hR0 : 0 < R0) (hK : 0 ≤ K)
    (hS1 : ∀ z ∈ Metric.ball c R0, z ∈ closure S → z ∈ S)
    (hS2 : ∀ z ∈ S ∩ Metric.ball c R0, ∃ r > 0, ∃ F : E3 → ℝ,
      ContDiffOn ℝ ∞ F (Metric.ball z r) ∧ (∀ y ∈ Metric.ball z r, fderiv ℝ F y ≠ 0) ∧
      ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0))
    (hS3 : ∀ z ∈ S ∩ Metric.ball c R0, ∀ (b : Fin 3) (w : E3 → ℝ) (r : ℝ), 0 < r →
      ContDiffAt ℝ 2 w (coordPlaneProj b z) → (∀ y, w (coordPlaneProj b y) = w y) →
      z b = w (coordPlaneProj b z) →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < r →
        coordPlaneProj b y + w (coordPlaneProj b y) • e b ∈ S) →
      ‖fderiv ℝ w (coordPlaneProj b z)‖ ≤ 2 →
      ‖iteratedFDeriv ℝ 2 w (coordPlaneProj b z)‖ ≤ K)
    (z : E3) (hz : z ∈ S) (hzc : ‖z - c‖ < R0 / 4) (r1 s : ℝ) (hr1 : 0 < r1)
    (hKr1 : K * r1 ≤ 1 / 8) (h4r1 : 4 * r1 ≤ R0) (hs0 : 0 ≤ s) (hs : s ≤ 7 / 4)
    (b : Fin 3) (r : ℝ) (hr : 0 < r) (F : E3 → ℝ) (hF : ContDiffOn ℝ ∞ F (Metric.ball z r))
    (hSF : ∀ y ∈ Metric.ball z r, (y ∈ S ↔ F y = 0)) (hF0 : fderiv ℝ F z ≠ 0)
    (hslope : ∀ u, |fderiv ℝ F z (coordPlaneProj b u)| ≤ s * |fderiv ℝ F z (e b)| * ‖u‖) :
    ∃ w : E3 → ℝ, (∀ y, w (coordPlaneProj b y) = w y) ∧
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z)‖ < r1} ∧ w z = z b ∧
      ‖fderiv ℝ w z‖ ≤ s ∧
      ∀ y, ‖coordPlaneProj b (y - z)‖ < r1 →
        coordPlaneProj b y + w y • e b ∈ S ∧
        coordPlaneProj b y + w y • e b ∈ Metric.ball c R0 ∧
        ‖fderiv ℝ w y‖ ≤ s + K * ‖coordPlaneProj b (y - z)‖ ∧
        ‖iteratedFDeriv ℝ 2 w y‖ ≤ K ∧
        |w y - z b| ≤ (s + 1 / 8) * ‖coordPlaneProj b (y - z)‖ :=
by
  
  have hP5 : ∀ (y z : E3),
      coordPlaneProj b (y - z) = coordPlaneProj b y - coordPlaneProj b z := by
    intro y z
    simp only [coordPlaneProj, PiLp.sub_apply, sub_smul]
    abel
  have hea : (e b) b = 1 := by simp [e]
  have hpa : ∀ q : E3, (coordPlaneProj b q) b = 0 := by
    intro q
    simp [coordPlaneProj, e]
  have hP3 : ∀ q : E3, coordPlaneProj b (coordPlaneProj b q) = coordPlaneProj b q := by
    intro q
    conv_lhs => rw [coordPlaneProj, hpa, zero_smul, sub_zero]
  have hP6 : ∀ u : E3, u = coordPlaneProj b u + (u b) • e b := by
    intro u
    simp [coordPlaneProj]
  have hcontP : Continuous (coordPlaneProj b) := by
    unfold coordPlaneProj
    fun_prop
  have hCylOpen : ∀ (c' : E3) (ρ : ℝ), IsOpen {y : E3 | ‖coordPlaneProj b (y - c')‖ < ρ} := by
    intro c' ρ
    exact isOpen_lt (hcontP.comp (continuous_id.sub continuous_const)).norm continuous_const
  have hzcyl : ∀ ρ : ℝ, 0 < ρ → z ∈ {y : E3 | ‖coordPlaneProj b (y - z)‖ < ρ} := by
    intro ρ hρ
    show ‖coordPlaneProj b (z - z)‖ < ρ
    simp [coordPlaneProj, hρ]
  have hCylConvex : ∀ ρ : ℝ, Convex ℝ {y : E3 | ‖coordPlaneProj b (y - z)‖ < ρ} := by
    intro ρ
    rw [convex_iff_forall_pos]
    intro x hx y hy a a' ha ha' haa
    have hlin : coordPlaneProj b (a • x + a' • y - z) =
        a • coordPlaneProj b (x - z) + a' • coordPlaneProj b (y - z) := by
      have ha'' : a' = 1 - a := by linarith
      subst ha''
      ext i
      simp only [coordPlaneProj, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    show ‖coordPlaneProj b (a • x + a' • y - z)‖ < ρ
    rw [hlin]
    have hx' : ‖coordPlaneProj b (x - z)‖ < ρ := hx
    have hy' : ‖coordPlaneProj b (y - z)‖ < ρ := hy
    calc ‖a • coordPlaneProj b (x - z) + a' • coordPlaneProj b (y - z)‖
        ≤ ‖a • coordPlaneProj b (x - z)‖ + ‖a' • coordPlaneProj b (y - z)‖ := norm_add_le _ _
      _ = a * ‖coordPlaneProj b (x - z)‖ + a' * ‖coordPlaneProj b (y - z)‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg ha.le, Real.norm_of_nonneg ha'.le]
      _ < a * ρ + a' * ρ := by
          have h1 := mul_lt_mul_of_pos_left hx' ha
          have h2 := mul_lt_mul_of_pos_left hy' ha'
          linarith
      _ = ρ := by rw [← add_mul, haa, one_mul]
  
  have hb : fderiv ℝ F z (e b) ≠ 0 := by
    intro h0
    apply hF0
    refine ContinuousLinearMap.ext fun u => ?_
    have h1 := hslope u
    rw [h0, abs_zero, mul_zero, zero_mul] at h1
    have h2 : fderiv ℝ F z (coordPlaneProj b u) = 0 := abs_nonpos_iff.mp h1
    calc fderiv ℝ F z u = fderiv ℝ F z (coordPlaneProj b u + (u b) • e b) := by rw [← hP6 u]
      _ = 0 := by rw [map_add, map_smul, h2, h0, smul_zero, add_zero]
      _ = (0 : E3 →L[ℝ] ℝ) u := rfl
  
  obtain ⟨δ₁, hδ₁, δ₂, hδ₂, wl, hwlp, hwlc, hwlz, hwlg, -⟩ :=
    ift_planar_graph S z r hr F hF hSF hz b hb
  have hFd : DifferentiableAt ℝ F z :=
    (hF.contDiffAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr))).differentiableAt
      (by simp)
  have hwld : DifferentiableAt ℝ wl z :=
    (hwlc.contDiffAt ((hCylOpen z δ₁).mem_nhds (hzcyl δ₁ hδ₁))).differentiableAt (by simp)
  obtain ⟨htan, -⟩ := graph_tangent_identity S z r hr F hFd
    (fun y hy hyS => (hSF y hy).1 hyS) b wl hwlp hwld hwlz.symm δ₁ hδ₁
    (fun y hy => (hwlg y hy).2.1)
  have heb : fderiv ℝ wl z (e b) = 0 := by
    have h1 := htan (e b)
    rw [hea] at h1
    have h2 : fderiv ℝ F z (e b) * fderiv ℝ wl z (e b) = 0 := by
      rw [mul_sub, mul_one] at h1
      linarith
    exact (mul_eq_zero.mp h2).resolve_left hb
  have hPv : ∀ v, fderiv ℝ wl z (coordPlaneProj b v) = fderiv ℝ wl z v := by
    intro v
    conv_rhs => rw [hP6 v]
    rw [map_add, map_smul, heb, smul_zero, add_zero]
  have hbound : ∀ v, |fderiv ℝ wl z v| ≤ s * ‖v‖ := by
    intro v
    have h1 := htan (coordPlaneProj b v)
    rw [hpa, zero_sub, hPv] at h1
    have h2 := hslope v
    rw [h1, abs_mul, abs_neg] at h2
    have hpos : 0 < |fderiv ℝ F z (e b)| := abs_pos.mpr hb
    have h3 : |fderiv ℝ F z (e b)| * |fderiv ℝ wl z v| ≤
        |fderiv ℝ F z (e b)| * (s * ‖v‖) := by
      calc |fderiv ℝ F z (e b)| * |fderiv ℝ wl z v| ≤ s * |fderiv ℝ F z (e b)| * ‖v‖ := h2
        _ = |fderiv ℝ F z (e b)| * (s * ‖v‖) := by ring
    exact le_of_mul_le_mul_left h3 hpos
  have hd0l : ‖fderiv ℝ wl z‖ ≤ s :=
    ContinuousLinearMap.opNorm_le_bound _ hs0 (fun v => by rw [Real.norm_eq_abs]; exact hbound v)
  
  have hU : ∀ (ρ ρ' : ℝ) (w w' : E3 → ℝ), 0 < ρ → ρ ≤ r1 → 0 < ρ' → ρ' ≤ r1 →
      (∀ y, w (coordPlaneProj b y) = w y) →
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z)‖ < ρ} → w z = z b →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < ρ → coordPlaneProj b y + w y • e b ∈ S) →
      ‖fderiv ℝ w z‖ ≤ s →
      (∀ y, w' (coordPlaneProj b y) = w' y) →
      ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z)‖ < ρ'} → w' z = z b →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < ρ' → coordPlaneProj b y + w' y • e b ∈ S) →
      ‖fderiv ℝ w' z‖ ≤ s →
      ∀ y, ‖coordPlaneProj b (y - z)‖ < min ρ ρ' → w y = w' y := by
    intro ρ ρ' w w' hρ hρ1 hρ' hρ'1 hw hwc hwz hgr hd hw' hwc' hwz' hgr' hd'
    have hball : ∀ y, ‖coordPlaneProj b (y - z)‖ < ρ →
        coordPlaneProj b y + w y • e b ∈ Metric.ball c R0 :=
      fun y hy => (sheet_slope_apriori c R0 K S hR0 hK hS3 b z hzc ρ s hρ
        (le_trans (mul_le_mul_of_nonneg_left hρ1 hK) hKr1) (by linarith) hs0 hs w hw hwc hwz
        hgr hd y hy).2.2.2
    have hball' : ∀ y, ‖coordPlaneProj b (y - z)‖ < ρ' →
        coordPlaneProj b y + w' y • e b ∈ Metric.ball c R0 :=
      fun y hy => (sheet_slope_apriori c R0 K S hR0 hK hS3 b z hzc ρ' s hρ'
        (le_trans (mul_le_mul_of_nonneg_left hρ'1 hK) hKr1) (by linarith) hs0 hs w' hw' hwc'
        hwz' hgr' hd' y hy).2.2.2
    have hsub : {y : E3 | ‖coordPlaneProj b (y - z)‖ < min ρ ρ'} ⊆
        {y : E3 | ‖coordPlaneProj b (y - z)‖ < ρ} := by
      intro y hy
      have hy' : ‖coordPlaneProj b (y - z)‖ < min ρ ρ' := hy
      show ‖coordPlaneProj b (y - z)‖ < ρ
      exact lt_of_lt_of_le hy' (min_le_left _ _)
    have hsub' : {y : E3 | ‖coordPlaneProj b (y - z)‖ < min ρ ρ'} ⊆
        {y : E3 | ‖coordPlaneProj b (y - z)‖ < ρ'} := by
      intro y hy
      have hy' : ‖coordPlaneProj b (y - z)‖ < min ρ ρ' := hy
      show ‖coordPlaneProj b (y - z)‖ < ρ'
      exact lt_of_lt_of_le hy' (min_le_right _ _)
    have hUs : ∀ y, y ∈ {y : E3 | ‖coordPlaneProj b (y - z)‖ < min ρ ρ'} ↔
        coordPlaneProj b y ∈ {y : E3 | ‖coordPlaneProj b (y - z)‖ < min ρ ρ'} := by
      intro y
      simp only [Set.mem_setOf_eq]
      rw [hP5 (coordPlaneProj b y) z, hP3, ← hP5]
    exact sheet_uniqueness c R0 S hS2 b _ (hCylOpen z _) (hCylConvex _).isPreconnected hUs
      w w' hw hw' ((hwc.differentiableOn (by simp)).mono hsub) (hwc'.continuousOn.mono hsub')
      (fun y hy => ⟨hgr y (hsub hy), hball y (hsub hy)⟩)
      (fun y hy => ⟨hgr' y (hsub' hy), hball' y (hsub' hy)⟩)
      z (hzcyl _ (lt_min hρ hρ')) (by rw [hwz, hwz'])
  
  have hE : ∀ (R : ℝ) (w : E3 → ℝ), 0 < R → R < r1 →
      (∀ y, w (coordPlaneProj b y) = w y) →
      ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - z)‖ < R} → w z = z b →
      (∀ y, ‖coordPlaneProj b (y - z)‖ < R → coordPlaneProj b y + w y • e b ∈ S) →
      ‖fderiv ℝ w z‖ ≤ s →
      ∃ R' > R, ∃ w' : E3 → ℝ, (∀ y, w' (coordPlaneProj b y) = w' y) ∧
        ContDiffOn ℝ ∞ w' {y | ‖coordPlaneProj b (y - z)‖ < R'} ∧ w' z = z b ∧
        (∀ y, ‖coordPlaneProj b (y - z)‖ < R' → coordPlaneProj b y + w' y • e b ∈ S) ∧
        ‖fderiv ℝ w' z‖ ≤ s := by
    intro R w hR hRr hw hwc hwz hgr hd
    obtain ⟨R', hR', w', h1, h2, h3, h4, h5⟩ := sheet_extend_step c R0 K S hR0 hK hS1 hS2 hS3
      b z hzc r1 s hr1 hKr1 h4r1 hs0 hs R hR hRr w hw hwc hwz hgr hd
    refine ⟨R', hR', w', h1, h2, h3, h4, ?_⟩
    have hev : w' =ᶠ[𝓝 z] w :=
      Filter.eventually_of_mem ((hCylOpen z R).mem_nhds (hzcyl R hR)) (fun y hy => h5 y hy)
    rw [hev.fderiv_eq]
    exact hd
  
  obtain ⟨w, hw, hwc, hwz, hgr, hd⟩ := sheet_radius_continuation S b z s r1 hr1 hU hE δ₁ hδ₁
    wl hwlp hwlc hwlz (fun y hy => (hwlg y hy).2.1) hd0l
  refine ⟨w, hw, hwc, hwz, hd, fun y hy => ?_⟩
  obtain ⟨a1, a2, a3, a4⟩ := sheet_slope_apriori c R0 K S hR0 hK hS3 b z hzc r1 s hr1 hKr1
    h4r1 hs0 hs w hw hwc hwz hgr hd y hy
  exact ⟨hgr y hy, a4, a1, a2, a3⟩

theorem tilted_graphs_parallel (a b : Fin 3) (z0 z : E3) (ρ K r1 : ℝ) (hρ : 0 < ρ)
    (hK : 0 ≤ K) (hKρ : 1000000 * (K * ρ) ≤ 1) (hr1 : 200 * ρ ≤ r1)
    (hzz : ‖z - z0‖ < 2 * ρ) (w0 wz : E3 → ℝ)
    (hw0 : ∀ y, w0 (coordPlaneProj a y) = w0 y) (hwz : ∀ y, wz (coordPlaneProj b y) = wz y)
    (hc0 : ContDiffOn ℝ ∞ w0 {y | ‖coordPlaneProj a (y - z0)‖ < r1})
    (hcz : ContDiffOn ℝ ∞ wz {y | ‖coordPlaneProj b (y - z)‖ < r1})
    (h0 : w0 z0 = z0 a) (h1 : wz z = z b)
    (hH0 : ∀ y, ‖coordPlaneProj a (y - z0)‖ < r1 → ‖iteratedFDeriv ℝ 2 w0 y‖ ≤ K)
    (hHz : ∀ y, ‖coordPlaneProj b (y - z)‖ < r1 → ‖iteratedFDeriv ℝ 2 wz y‖ ≤ K)
    (hs0 : ‖fderiv ℝ w0 z0‖ ≤ Real.sqrt 2) (hsz : ‖fderiv ℝ wz z‖ ≤ Real.sqrt 2)
    (hpar : ∀ y, ‖coordPlaneProj a (y - z0)‖ < r1 → ‖coordPlaneProj b (y - z)‖ < r1 →
      y a = w0 y → y b = wz y →
      ∃ μ : ℝ, ∀ u, u a - fderiv ℝ w0 y u = μ * (u b - fderiv ℝ wz y u)) :
    ∀ u, |(coordPlaneProj a u) b - fderiv ℝ wz z (coordPlaneProj a u)| ≤
      7 / 4 * |(e a) b - fderiv ℝ wz z (e a)| * ‖u‖ :=
by
  
  have t_planar (b : Fin 3) (w : E3 → ℝ) (hw : ∀ y, w (coordPlaneProj b y) = w y) (x : E3) :
      fderiv ℝ w x (e b) = 0 := by
    by_cases hd : DifferentiableAt ℝ w x
    · have hline : HasDerivAt (fun t : ℝ => x + t • e b) (e b) 0 := by
        simpa using ((hasDerivAt_id (0 : ℝ)).smul_const (e b)).const_add x
      have h2 : HasFDerivAt w (fderiv ℝ w x) ((fun t : ℝ => x + t • e b) 0) := by
        simpa using hd.hasFDerivAt
      have hcomp := h2.comp_hasDerivAt (0 : ℝ) hline
      have hconst : (w ∘ fun t : ℝ => x + t • e b) = fun _ => w x := by
        funext t
        simp only [Function.comp]
        rw [← hw (x + t • e b), ← hw x]
        congr 1
        ext j
        by_cases hj : j = b
        · subst hj; simp [coordPlaneProj, e]
        · simp [coordPlaneProj, e, EuclideanSpace.single_apply, hj]
      rw [hconst] at hcomp
      exact (hcomp.unique (hasDerivAt_const (0 : ℝ) (w x)))
    · rw [fderiv_zero_of_not_differentiableAt hd]; rfl
  
  have t_basic (c j : Fin 3) (u : E3) :
      (coordPlaneProj c u) j = if j = c then 0 else u j := by
    by_cases h : j = c
    · subst h; simp [coordPlaneProj, e]
    · simp [coordPlaneProj, e, EuclideanSpace.single_apply, h]
  have t_normP (c : Fin 3) (y : E3) : ‖coordPlaneProj c y‖ ≤ ‖y‖ := by
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
    apply Real.sqrt_le_sqrt
    apply Finset.sum_le_sum
    intro i _
    rw [t_basic]
    split_ifs <;> simp [sq_nonneg]
  have t_coord (y : E3) (j : Fin 3) : |y j| ≤ ‖y‖ := by
    have := PiLp.norm_apply_le y j
    simpa [Real.norm_eq_abs] using this
  have t_convex (c : Fin 3) (p : E3) (r : ℝ) :
      Convex ℝ {y : E3 | ‖coordPlaneProj c (y - p)‖ < r} := by
    let L : E3 →L[ℝ] E3 :=
      ContinuousLinearMap.id ℝ E3 - (EuclideanSpace.proj c : E3 →L[ℝ] ℝ).smulRight (e c)
    have hL : ∀ y, L y = coordPlaneProj c y := by
      intro y
      simp [L, coordPlaneProj]
    have hset : {y : E3 | ‖coordPlaneProj c (y - p)‖ < r} =
        L.toLinearMap ⁻¹' Metric.ball (L p) r := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Metric.mem_ball, dist_eq_norm,
        ContinuousLinearMap.coe_coe]
      rw [← map_sub, hL]
    rw [hset]
    exact (convex_ball _ _).linear_preimage _
  
  have t_lip (b : Fin 3) (p : E3) (r K : ℝ) (w : E3 → ℝ)
      (hc : ContDiffOn ℝ ∞ w {y | ‖coordPlaneProj b (y - p)‖ < r})
      (hH : ∀ y, ‖coordPlaneProj b (y - p)‖ < r → ‖iteratedFDeriv ℝ 2 w y‖ ≤ K) :
      ∀ x y : E3, ‖coordPlaneProj b (x - p)‖ < r → ‖coordPlaneProj b (y - p)‖ < r →
        ‖fderiv ℝ w x - fderiv ℝ w y‖ ≤ K * ‖x - y‖ := by
    have hopen : IsOpen {y : E3 | ‖coordPlaneProj b (y - p)‖ < r} := by
      have : Continuous (coordPlaneProj b) := by unfold coordPlaneProj; fun_prop
      exact isOpen_lt (this.comp (continuous_id.sub continuous_const)).norm continuous_const
    intro x y hx hy
    have hd : ∀ q ∈ {y : E3 | ‖coordPlaneProj b (y - p)‖ < r},
        DifferentiableAt ℝ (fderiv ℝ w) q := by
      intro q hq
      have h1 : ContDiffAt ℝ ∞ w q := hc.contDiffAt (hopen.mem_nhds hq)
      have h2 : ContDiffAt ℝ 1 (fderiv ℝ w) q :=
        h1.fderiv_right (by exact WithTop.coe_le_coe.2 le_top)
      exact h2.differentiableAt one_ne_zero
    have hb : ∀ q ∈ {y : E3 | ‖coordPlaneProj b (y - p)‖ < r},
        ‖fderiv ℝ (fderiv ℝ w) q‖ ≤ K := by
      intro q hq
      rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
      exact hH q hq
    exact Convex.norm_image_sub_le_of_norm_fderiv_le hd hb (t_convex b p r) hy hx
  
  have t_transfer (a b : Fin 3) (hab : a ≠ b) (D0 Dy Dz : E3 →L[ℝ] ℝ) (μ : ℝ)
      (h0a : D0 (e a) = 0) (hyb : Dy (e b) = 0) (hD0 : ‖D0‖ ≤ 17 / 12)
      (hδ : ‖Dz - Dy‖ ≤ 1 / 100)
      (hμ : ∀ u : E3, u a - D0 u = μ * (u b - Dy u)) :
      ∀ u : E3, |(coordPlaneProj a u) b - Dz (coordPlaneProj a u)| ≤
        7 / 4 * |(e a) b - Dz (e a)| * ‖u‖ := by
    intro u
    have eaa : (e a) a = 1 := by simp [e]
    have eab : (e a) b = 0 := by simp [e, EuclideanSpace.single_apply, hab.symm]
    have eba : (e b) a = 0 := by simp [e, EuclideanSpace.single_apply, hab]
    have ebb : (e b) b = 1 := by simp [e]
    have hXa : (coordPlaneProj a u) a = 0 := by rw [t_basic]; simp
    have hD0X : D0 (coordPlaneProj a u) = D0 u := by
      simp only [coordPlaneProj, map_sub, map_smul, h0a, smul_eq_mul, mul_zero, sub_zero]
    have hXn : ‖coordPlaneProj a u‖ ≤ ‖u‖ := t_normP a u
    set X := coordPlaneProj a u with hX
    have i1 := hμ (e a)
    have i2 := hμ (e b)
    have i3 := hμ X
    rw [eaa, eab, h0a] at i1
    rw [eba, ebb, hyb] at i2
    rw [hXa, hD0X] at i3
    have hμb : |μ| ≤ 17 / 12 := by
      have : μ = -D0 (e b) := by linarith
      rw [this, abs_neg]
      calc |D0 (e b)| = ‖D0 (e b)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖D0‖ * ‖e b‖ := D0.le_opNorm _
        _ = ‖D0‖ := by simp
        _ ≤ 17 / 12 := hD0
    have hμ0 : 0 < |μ| := by
      apply abs_pos.2
      intro h
      rw [h] at i1
      linarith
    set Δ := Dz - Dy with hΔ
    have hΔX : |Δ X| ≤ 1 / 100 * ‖u‖ := by
      calc |Δ X| = ‖Δ X‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖Δ‖ * ‖X‖ := Δ.le_opNorm _
        _ ≤ 1 / 100 * ‖u‖ := mul_le_mul hδ hXn (norm_nonneg _) (by norm_num)
    have hΔa : |Δ (e a)| ≤ 1 / 100 := by
      calc |Δ (e a)| = ‖Δ (e a)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖Δ‖ * ‖e a‖ := Δ.le_opNorm _
        _ = ‖Δ‖ := by simp
        _ ≤ 1 / 100 := hδ
    have hD0u : |D0 u| ≤ 17 / 12 * ‖u‖ := by
      calc |D0 u| = ‖D0 u‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖D0‖ * ‖u‖ := D0.le_opNorm _
        _ ≤ 17 / 12 * ‖u‖ := mul_le_mul_of_nonneg_right hD0 (norm_nonneg _)
    have hDzX : Dz X = Dy X + Δ X := by rw [hΔ]; simp
    have hDza : Dz (e a) = Dy (e a) + Δ (e a) := by rw [hΔ]; simp
    have k1 : μ * (X b - Dz X) = -D0 u - μ * Δ X := by
      rw [hDzX]; linear_combination (-1 : ℝ) * i3
    have k2 : μ * ((e a) b - Dz (e a)) = 1 - μ * Δ (e a) := by
      rw [hDza, eab]; linear_combination (-1 : ℝ) * i1
    have m1 : |μ| * |X b - Dz X| ≤ 1717 / 1200 * ‖u‖ := by
      rw [← abs_mul, k1]
      have h1 : |μ * Δ X| ≤ 17 / 12 * (1 / 100 * ‖u‖) := by
        rw [abs_mul]; exact mul_le_mul hμb hΔX (abs_nonneg _) (by norm_num)
      calc |-D0 u - μ * Δ X| ≤ |D0 u| + |μ * Δ X| := by
            rw [show -D0 u - μ * Δ X = -(D0 u) + -(μ * Δ X) by ring]
            refine (abs_add_le _ _).trans ?_
            rw [abs_neg, abs_neg]
        _ ≤ 17 / 12 * ‖u‖ + 17 / 12 * (1 / 100 * ‖u‖) := add_le_add hD0u h1
        _ = 1717 / 1200 * ‖u‖ := by ring
    have m2 : 1183 / 1200 ≤ |μ| * |(e a) b - Dz (e a)| := by
      rw [← abs_mul, k2]
      have h1 : |μ * Δ (e a)| ≤ 17 / 12 * (1 / 100) := by
        rw [abs_mul]; exact mul_le_mul hμb hΔa (abs_nonneg _) (by norm_num)
      have h2 := abs_sub_abs_le_abs_sub 1 (μ * Δ (e a))
      rw [abs_one] at h2
      linarith
    have hu0 : 0 ≤ ‖u‖ := norm_nonneg _
    have m3 : |μ| * |X b - Dz X| ≤ |μ| * (7 / 4 * |(e a) b - Dz (e a)| * ‖u‖) := by
      have h3 : 1183 / 1200 * ‖u‖ ≤ |μ| * |(e a) b - Dz (e a)| * ‖u‖ :=
        mul_le_mul_of_nonneg_right m2 hu0
      nlinarith
    exact le_of_mul_le_mul_left m3 hμ0
  
  have t_cross (a b : Fin 3) (hab : a ≠ b) (z0 z : E3) (ρ K r1 : ℝ) (hρ : 0 < ρ)
      (hK : 0 ≤ K) (hKρ : 1000000 * (K * ρ) ≤ 1) (hr1 : 200 * ρ ≤ r1)
      (hzz : ‖z - z0‖ < 2 * ρ) (w0 wz : E3 → ℝ)
      (hwz : ∀ y, wz (coordPlaneProj b y) = wz y)
      (hd0 : ∀ y, ‖coordPlaneProj a (y - z0)‖ < r1 → DifferentiableAt ℝ w0 y)
      (hdz : ∀ y, ‖coordPlaneProj b (y - z)‖ < r1 → DifferentiableAt ℝ wz y)
      (h0 : w0 z0 = z0 a) (h1 : wz z = z b)
      (hL0 : ∀ y, ‖coordPlaneProj a (y - z0)‖ < r1 →
        ‖fderiv ℝ w0 y - fderiv ℝ w0 z0‖ ≤ K * ‖y - z0‖)
      (hLz : ∀ y, ‖coordPlaneProj b (y - z)‖ < r1 →
        ‖fderiv ℝ wz y - fderiv ℝ wz z‖ ≤ K * ‖y - z‖)
      (hs0 : ‖fderiv ℝ w0 z0‖ ≤ Real.sqrt 2) (hD0a : fderiv ℝ w0 z0 (e a) = 0)
      (v : E3) (hva : v a = 1) (hv : ‖v - e a‖ ≤ 4 / 7)
      (htan : v b = fderiv ℝ wz z v) :
      ∃ y : E3, ‖coordPlaneProj a (y - z0)‖ < r1 ∧ ‖coordPlaneProj b (y - z)‖ < r1 ∧
        y a = w0 y ∧ y b = wz y ∧ ‖y - z‖ ≤ 48 * ρ ∧ ‖y - z0‖ ≤ 50 * ρ := by
    set A := fderiv ℝ w0 z0 with hA
    set B := fderiv ℝ wz z with hB
    have hκ0 : 0 ≤ K * ρ := mul_nonneg hK hρ.le
    have hκ1 : K * ρ ≤ 1 / 1000000 := by linarith
    have hs2 : Real.sqrt 2 ≤ 17 / 12 := by
      rw [Real.sqrt_le_left (by norm_num)]; norm_num
    have hA' : ‖A‖ ≤ 17 / 12 := hs0.trans hs2
    have hvn : ‖v‖ ≤ 11 / 7 := by
      calc ‖v‖ = ‖(v - e a) + e a‖ := by rw [sub_add_cancel]
        _ ≤ ‖v - e a‖ + ‖e a‖ := norm_add_le _ _
        _ ≤ 4 / 7 + 1 := by
            have : ‖e a‖ = 1 := by simp
            rw [this]; linarith
        _ = 11 / 7 := by norm_num
    have hAv : |A v| ≤ 17 / 12 * (4 / 7) := by
      have : A v = A (v - e a) := by rw [map_sub, hD0a, sub_zero]
      rw [this]
      calc |A (v - e a)| = ‖A (v - e a)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖A‖ * ‖v - e a‖ := A.le_opNorm _
        _ ≤ 17 / 12 * (4 / 7) := mul_le_mul hA' hv (norm_nonneg _) (by norm_num)
    have hAeb : |A (e b)| ≤ 17 / 12 := by
      calc |A (e b)| = ‖A (e b)‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖A‖ * ‖e b‖ := A.le_opNorm _
        _ = ‖A‖ := by simp
        _ ≤ 17 / 12 := hA'
    have cylz : ∀ y, ‖y - z‖ ≤ 48 * ρ → ‖coordPlaneProj b (y - z)‖ < r1 :=
      fun y hy => lt_of_le_of_lt ((t_normP b _).trans hy) (by linarith)
    have cyl0 : ∀ y, ‖y - z0‖ ≤ 50 * ρ → ‖coordPlaneProj a (y - z0)‖ < r1 :=
      fun y hy => lt_of_le_of_lt ((t_normP a _).trans hy) (by linarith)
    
    have hx : ∀ t : ℝ, |t| ≤ 30 * ρ → ‖(z + t • v) - z‖ ≤ 48 * ρ := by
      intro t ht
      rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
      calc |t| * ‖v‖ ≤ (30 * ρ) * (11 / 7) := mul_le_mul ht hvn (norm_nonneg _) (by positivity)
        _ ≤ 48 * ρ := by linarith
    
    have hSzc : Convex ℝ ({y : E3 | ‖coordPlaneProj b (y - z)‖ < r1} ∩
        Metric.closedBall z (48 * ρ)) := (t_convex b z r1).inter (convex_closedBall _ _)
    have hSzd : ∀ q ∈ ({y : E3 | ‖coordPlaneProj b (y - z)‖ < r1} ∩
        Metric.closedBall z (48 * ρ)), DifferentiableAt ℝ wz q := fun q hq => hdz q hq.1
    have hSzb : ∀ q ∈ ({y : E3 | ‖coordPlaneProj b (y - z)‖ < r1} ∩
        Metric.closedBall z (48 * ρ)), ‖fderiv ℝ wz q - B‖ ≤ 48 * (K * ρ) := by
      intro q hq
      have h := hLz q hq.1
      have hq2 : ‖q - z‖ ≤ 48 * ρ := by
        have := hq.2; rwa [Metric.mem_closedBall, dist_eq_norm] at this
      calc _ ≤ K * ‖q - z‖ := h
        _ ≤ K * (48 * ρ) := mul_le_mul_of_nonneg_left hq2 hK
        _ = 48 * (K * ρ) := by ring
    have hxS : ∀ t : ℝ, |t| ≤ 30 * ρ → z + t • v ∈ ({y : E3 | ‖coordPlaneProj b (y - z)‖ < r1} ∩
        Metric.closedBall z (48 * ρ)) := by
      intro t ht
      refine ⟨cylz _ (hx t ht), ?_⟩
      rw [Metric.mem_closedBall, dist_eq_norm]; exact hx t ht
    
    let γ : ℝ → E3 := fun t => coordPlaneProj b (z + t • v) + wz (z + t • v) • e b
    have hγdef : ∀ t, γ t = coordPlaneProj b (z + t • v) + wz (z + t • v) • e b :=
      fun t => rfl
    have hdec : ∀ q : E3, coordPlaneProj b q + q b • e b = q := by
      intro q; simp [coordPlaneProj]
    have hγdiff : ∀ s t : ℝ, |s| ≤ 30 * ρ → |t| ≤ 30 * ρ → ∃ d : ℝ,
        |d| ≤ 1 / 10000 * |t - s| ∧ γ t - γ s = (t - s) • v + d • e b := by
      intro s t hs ht
      have hxx : (z + t • v) - (z + s • v) = (t - s) • v := by rw [sub_smul]; abel
      refine ⟨wz (z + t • v) - wz (z + s • v) - B ((z + t • v) - (z + s • v)), ?_, ?_⟩
      · have h := Convex.norm_image_sub_le_of_norm_fderiv_le' hSzd hSzb hSzc (hxS s hs)
          (hxS t ht)
        rw [Real.norm_eq_abs] at h
        refine h.trans ?_
        rw [hxx, norm_smul, Real.norm_eq_abs]
        have e1 : |t - s| * ‖v‖ ≤ |t - s| * (11 / 7) :=
          mul_le_mul_of_nonneg_left hvn (abs_nonneg _)
        have e2 : 48 * (K * ρ) * (|t - s| * ‖v‖) ≤ 48 * (K * ρ) * (|t - s| * (11 / 7)) :=
          mul_le_mul_of_nonneg_left e1 (by positivity)
        have e3 : K * ρ * |t - s| ≤ 1 / 1000000 * |t - s| :=
          mul_le_mul_of_nonneg_right hκ1 (abs_nonneg _)
        nlinarith [abs_nonneg (t - s)]
      · rw [hxx, map_smul, smul_eq_mul, ← htan, hγdef, hγdef]
        ext j
        simp only [coordPlaneProj, PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
        ring
    have hγ0 : γ 0 = z := by
      rw [hγdef, zero_smul, add_zero, h1]; exact hdec z
    have hγz : ∀ t : ℝ, |t| ≤ 30 * ρ → ‖γ t - z‖ ≤ 48 * ρ := by
      intro t ht
      obtain ⟨d, hd, he⟩ := hγdiff 0 t (by rw [abs_zero]; positivity) ht
      rw [hγ0, sub_zero] at he
