          (ord_mm 3 1 4 _ _ (by norm_num) (h3 p) (h1 q)))
          (ord_mm 2 2 4 _ _ (by norm_num) (h2 p) (h2 q)))
          (ord_mm 2 3 4 _ _ (by norm_num) (h2 p) (h3 q)))
          (ord_mm 3 2 4 _ _ (by norm_num) (h3 p) (h2 q)))
          (ord_mm 3 3 4 _ _ (by norm_num) (h3 p) (h3 q)))
    · exact ord_mm 2 3 5 _ _ (by norm_num) (hB2 p q)
        (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _
          (ord_add 3 _ _ (ord_add 3 _ _
          (ord_mm 1 2 3 _ _ (by norm_num) (h1 p) (h2 q))
          (ord_mm 2 1 3 _ _ (by norm_num) (h2 p) (h1 q)))
          (ord_mm 1 3 3 _ _ (by norm_num) (h1 p) (h3 q)))
          (ord_mm 3 1 3 _ _ (by norm_num) (h3 p) (h1 q)))
          (ord_mm 2 2 3 _ _ (by norm_num) (h2 p) (h2 q)))
          (ord_mm 2 3 3 _ _ (by norm_num) (h2 p) (h3 q)))
          (ord_mm 3 2 3 _ _ (by norm_num) (h3 p) (h2 q)))
          (ord_mm 3 3 3 _ _ (by norm_num) (h3 p) (h3 q)))
  
  obtain ⟨hinvS, -, -⟩ := pcgb_px_coeff_bounds W hW h hh hpd x₀ R₀ hR₀ hball
  have hτ : ∀ p q : Fin 2, pcgbOrd x₀ σ 3 (pcgbTay2 (fun y => (h y)⁻¹ p q) x₀) := by
    intro p q
    obtain ⟨K, hK, hb⟩ := pcgb_taylor2_remainder W hW _ (hinvS p q) x₀ R₀ hR₀ hball
    refine ⟨K, hK, fun x hx => ?_⟩
    have hxR : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr ((hx.trans_le hσR).le)
    have hxW : x ∈ W := hball hxR
    obtain ⟨e0, e1, -⟩ := hb x hxR
    refine ⟨?_, e0, e1⟩
    have hφd : DifferentiableAt ℝ (fun y => (h y)⁻¹ p q) x :=
      ((hinvS p q).contDiffAt (hW.mem_nhds hxW)).differentiableAt (by simp)
    obtain ⟨-, -, -, -, hLs, hBs, -, -⟩ := pcgb_form_pd2 x₀ x p
      (fun k => pd2 k (fun y => (h y)⁻¹ p q) x₀)
      (fun k l => pd2 k (pd2 l (fun y => (h y)⁻¹ p q)) x₀)
      (fun _ _ _ => 0) (fun _ _ _ _ => 0)
    have hd1 := (hLs.differentiable (by simp)) x
    have hd2 := (hBs.differentiable (by simp)) x
    show DifferentiableAt ℝ (fun y => (h y)⁻¹ p q - (h x₀)⁻¹ p q
      - ∑ k : Fin 2, pd2 k (fun y => (h y)⁻¹ p q) x₀ * (y - x₀) k
      - (1 / 2 : ℝ) * ∑ k : Fin 2, ∑ l : Fin 2,
          pd2 k (pd2 l (fun y => (h y)⁻¹ p q)) x₀ * (y - x₀) k * (y - x₀) l) x
    exact ((hφd.sub_const _).sub hd1).sub (hd2.const_mul (1 / 2 : ℝ))
  
  have hgrad : ∀ (a : Fin 2) (y : E2), pd2 a (pcgbJetD h x₀) y =
      pcgbJv1 (h x₀) x₀ y a + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y a +
        pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y a := by
    intro a y
    obtain ⟨-, h2, h3, h4, -, hQs, hTs, hUs⟩ := pcgb_form_pd2 x₀ y a (fun _ => 0) (h x₀)
      (pcgbJT (h x₀) (pcgbJg1 h x₀)) (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀))
    have hd1 := (hQs.differentiable (by simp)) y
    have hd2 := (hTs.differentiable (by simp)) y
    have hd3 := (hUs.differentiable (by simp)) y
    have hDdef : pcgbJetD h x₀ = fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, h x₀ a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT (h x₀) (pcgbJg1 h x₀) a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) a b c d *
            (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := rfl
    rw [hDdef]
    unfold pd2 at h2 h3 h4 ⊢
    have hd12 : DifferentiableAt ℝ (fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, h x₀ a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT (h x₀) (pcgbJg1 h x₀) a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c)) y :=
      hd1.add hd2
    rw [fderiv_fun_add hd12 hd3, fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.add_apply, h2, h3, h4]
    rfl
  have hsplit : ∀ (y : E2) (p q : Fin 2), (h y)⁻¹ p q = (h x₀)⁻¹ p q +
      pcgbJA1 (pcgbJg1 h x₀) x₀ y p q + pcgbJA2 (pcgbJg2 h x₀) x₀ y p q +
        pcgbTay2 (fun y => (h y)⁻¹ p q) x₀ y := by
    intro y p q
    simp only [pcgbTay2, pcgbJA1, pcgbJA2, pcgbJg1, pcgbJg2]
    ring
  
  have halg : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ), (∀ a c : Fin 2, H a c = H c a) → H.det ≠ 0 →
      ∀ (g1 : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ) (g2 : Fin 2 → Fin 2 → Matrix (Fin 2) (Fin 2) ℝ)
        (x : E2),
      ∑ p : Fin 2, ∑ q : Fin 2,
          (H⁻¹ p q + pcgbJA1 g1 x₀ x p q + pcgbJA2 g2 x₀ x p q) *
          (pcgbJv1 H x₀ x p + pcgbJv2 (pcgbJT H g1) x₀ x p + pcgbJv3 (pcgbJU H g1 g2) x₀ x p) *
          (pcgbJv1 H x₀ x q + pcgbJv2 (pcgbJT H g1) x₀ x q + pcgbJv3 (pcgbJU H g1 g2) x₀ x q)
        - 4 * pcgbJD H g1 g2 x₀ x =
      pcgbJE5 H⁻¹ (pcgbJA1 g1 x₀ x) (pcgbJA2 g2 x₀ x) (pcgbJv1 H x₀ x)
        (pcgbJv2 (pcgbJT H g1) x₀ x) (pcgbJv3 (pcgbJU H g1 g2) x₀ x) := by
    intro H hHs' hdet' g1 g2 x
    have hsym : H 1 0 = H 0 1 := hHs' 1 0
    have hu : IsUnit H.det := Ne.isUnit hdet'
    have hR1 := Matrix.mul_nonsing_inv H hu
    have hR2 := Matrix.nonsing_inv_mul H hu
    have n01 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 :=
      Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide)
    have n10 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 :=
      Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)
    have r00 : H 0 0 * H⁻¹ 0 0 + H 0 1 * H⁻¹ 1 0 = 1 := by
      have := congrFun (congrFun hR1 0) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq] at this; exact this
    have r01 : H 0 0 * H⁻¹ 0 1 + H 0 1 * H⁻¹ 1 1 = 0 := by
      have := congrFun (congrFun hR1 0) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, n01] at this; exact this
    have r10 : H 0 1 * H⁻¹ 0 0 + H 1 1 * H⁻¹ 1 0 = 0 := by
      have := congrFun (congrFun hR1 1) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, n10, hsym] at this
      exact this
    have r11 : H 0 1 * H⁻¹ 0 1 + H 1 1 * H⁻¹ 1 1 = 1 := by
      have := congrFun (congrFun hR1 1) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq, hsym] at this; exact this
    have s00 : H⁻¹ 0 0 * H 0 0 + H⁻¹ 0 1 * H 0 1 = 1 := by
      have := congrFun (congrFun hR2 0) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq, hsym] at this; exact this
    have s01 : H⁻¹ 0 0 * H 0 1 + H⁻¹ 0 1 * H 1 1 = 0 := by
      have := congrFun (congrFun hR2 0) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, n01] at this; exact this
    have s10 : H⁻¹ 1 0 * H 0 0 + H⁻¹ 1 1 * H 0 1 = 0 := by
      have := congrFun (congrFun hR2 1) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, n10, hsym] at this
      exact this
    have s11 : H⁻¹ 1 0 * H 0 1 + H⁻¹ 1 1 * H 1 1 = 1 := by
      have := congrFun (congrFun hR2 1) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq] at this; exact this
    have F1L0 : pcgbJv1 H x₀ x 0 * H⁻¹ 0 0 + pcgbJv1 H x₀ x 1 * H⁻¹ 1 0 = 2 * (x - x₀) 0 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * r00 + (2 * (x - x₀) 1) * r10
    have F1L1 : pcgbJv1 H x₀ x 0 * H⁻¹ 0 1 + pcgbJv1 H x₀ x 1 * H⁻¹ 1 1 = 2 * (x - x₀) 1 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * r01 + (2 * (x - x₀) 1) * r11
    have F1R0 : H⁻¹ 0 0 * pcgbJv1 H x₀ x 0 + H⁻¹ 0 1 * pcgbJv1 H x₀ x 1 = 2 * (x - x₀) 0 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * s00 + (2 * (x - x₀) 1) * s01
    have F1R1 : H⁻¹ 1 0 * pcgbJv1 H x₀ x 0 + H⁻¹ 1 1 * pcgbJv1 H x₀ x 1 = 2 * (x - x₀) 1 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * s10 + (2 * (x - x₀) 1) * s11
    have Eu1 : (x - x₀) 0 * pcgbJv1 H x₀ x 0 + (x - x₀) 1 * pcgbJv1 H x₀ x 1 =
        2 * pcgbPxQuad H x₀ x := by
      simp only [pcgbJv1, pcgbPxQuad, Fin.sum_univ_two]; ring
    have Eu2 : (x - x₀) 0 * pcgbJv2 (pcgbJT H g1) x₀ x 0 +
        (x - x₀) 1 * pcgbJv2 (pcgbJT H g1) x₀ x 1 =
        3 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (x - x₀) a * (x - x₀) b * (x - x₀) c := by
      simp only [pcgbJv2, Fin.sum_univ_two]; ring
    have Eu3 : (x - x₀) 0 * pcgbJv3 (pcgbJU H g1 g2) x₀ x 0 +
        (x - x₀) 1 * pcgbJv3 (pcgbJU H g1 g2) x₀ x 1 =
        4 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (x - x₀) a * (x - x₀) b * (x - x₀) c * (x - x₀) d := by
      simp only [pcgbJv3, Fin.sum_univ_two]; ring
    have F3 : ∑ p : Fin 2, ∑ q : Fin 2,
        pcgbJA1 g1 x₀ x p q * pcgbJv1 H x₀ x p * pcgbJv1 H x₀ x q =
        -8 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (x - x₀) a * (x - x₀) b * (x - x₀) c := by
      simp only [pcgbJA1, pcgbJv1, pcgbJT, Fin.sum_univ_two, hsym]; ring
    have hv2W : ∀ p : Fin 2, pcgbJv2 (pcgbJT H g1) x₀ x p =
        ∑ b : Fin 2, ∑ c : Fin 2, pcgbJW (pcgbJT H g1) p b c * (x - x₀) b * (x - x₀) c :=
      fun p => rfl
    have F4 : ∑ p : Fin 2, ∑ q : Fin 2,
        (H⁻¹ p q * pcgbJv2 (pcgbJT H g1) x₀ x p * pcgbJv2 (pcgbJT H g1) x₀ x q
          + pcgbJA1 g1 x₀ x p q * (pcgbJv1 H x₀ x p * pcgbJv2 (pcgbJT H g1) x₀ x q
              + pcgbJv2 (pcgbJT H g1) x₀ x p * pcgbJv1 H x₀ x q)
          + pcgbJA2 g2 x₀ x p q * pcgbJv1 H x₀ x p * pcgbJv1 H x₀ x q) =
        -12 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (x - x₀) a * (x - x₀) b * (x - x₀) c * (x - x₀) d := by
      simp only [hv2W]
      simp only [pcgbJA1, pcgbJA2, pcgbJv1, pcgbJU, Fin.sum_univ_two, hsym]
      ring
    simp only [pcgbJE5, pcgbJD]
    simp only [Fin.sum_univ_two] at F3 F4 Eu2 Eu3 ⊢
    linear_combination
      (pcgbJv1 H x₀ x 0 + pcgbJv2 (pcgbJT H g1) x₀ x 0 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 0) * F1L0 +
      (pcgbJv1 H x₀ x 1 + pcgbJv2 (pcgbJT H g1) x₀ x 1 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 1) * F1L1 +
      (pcgbJv2 (pcgbJT H g1) x₀ x 0 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 0) * F1R0 +
      (pcgbJv2 (pcgbJT H g1) x₀ x 1 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 1) * F1R1 +
      2 * Eu1 + 4 * Eu2 + 4 * Eu3 + F3 + F4
  
  have hid : ∀ y : E2, pcgbPxEik h (pcgbJetD h x₀) y =
      pcgbJE5 (h x₀)⁻¹ (pcgbJA1 (pcgbJg1 h x₀) x₀ y) (pcgbJA2 (pcgbJg2 h x₀) x₀ y)
        (pcgbJv1 (h x₀) x₀ y) (pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y)
        (pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y) +
      ∑ p : Fin 2, ∑ q : Fin 2, pcgbTay2 (fun y => (h y)⁻¹ p q) x₀ y *
        (pcgbJv1 (h x₀) x₀ y p + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y p +
          pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y p) *
        (pcgbJv1 (h x₀) x₀ y q + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y q +
          pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y q) := by
    intro y
    have hal := halg (h x₀) hHs hdet (pcgbJg1 h x₀) (pcgbJg2 h x₀) y
    have t00 := hsplit y 0 0
    have t01 := hsplit y 0 1
    have t10 := hsplit y 1 0
    have t11 := hsplit y 1 1
    have hDy : pcgbJetD h x₀ y = pcgbJD (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) x₀ y := rfl
    unfold pcgbPxEik
    simp only [Fin.sum_univ_two] at hal ⊢
    rw [← hgrad 0 y, ← hgrad 1 y] at hal
    rw [← hgrad 0 y, ← hgrad 1 y, hDy]
    linear_combination hal +
      pd2 0 (pcgbJetD h x₀) y * pd2 0 (pcgbJetD h x₀) y * t00 +
      pd2 0 (pcgbJetD h x₀) y * pd2 1 (pcgbJetD h x₀) y * t01 +
      pd2 1 (pcgbJetD h x₀) y * pd2 0 (pcgbJetD h x₀) y * t10 +
      pd2 1 (pcgbJetD h x₀) y * pd2 1 (pcgbJetD h x₀) y * t11
  
  have hfinal : pcgbOrd x₀ σ 5 (pcgbPxEik h (pcgbJetD h x₀)) := by
    refine ord_congr 5 _ _ hid ?_
    exact ord_add 5 _ _ (hE5gen _ _ _ _ _ _ (hA1 _) (hA2 _) (hv1 _) (hv2 _) (hv3 _))
      (ord_sum 5 _ fun p => ord_sum 5 _ fun q =>
        ord_mm 4 1 5 _ _ (by norm_num)
          (ord_mm 3 1 4 _ _ (by norm_num) (hτ p q) (hw _ _ _ p)) (hw _ _ _ q))
  obtain ⟨c, hc, hb⟩ := hfinal
  refine ⟨c, hc, fun x hx => ?_⟩
  obtain ⟨-, e1, e2⟩ := hb x (by rw [hσdef]; exact hx)
  exact ⟨e1, e2⟩

theorem pcgb_lap2_contDiffOn (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) V) (hpd : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) : ContDiffOn ℝ ∞ (lap2 h u) V :=
by
  have hinf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f V → ∀ c : Fin 2, ContDiffOn ℝ ∞ (pd2 c f) V := by
    intro f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) V :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hV).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdet : ∀ y ∈ V, (h y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) V := by
    have heq : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y
      exact Matrix.det_fin_two (h y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hadj : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate i j) V := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_two] <;>
      first | exact hh _ _ | exact (hh _ _).neg
  have hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) V := by
    intro i j
    have heq : (fun y => (h y)⁻¹ i j) = fun y => ((h y).det)⁻¹ * (h y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetS.inv hdet).mul (hadj i j)
  have hchr : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) V := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) V
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
      (((hinf _ (hh j l) i).add (hinf _ (hh i l) j)).sub (hinf _ (hh i j) l)))
  have hpu : ∀ k : Fin 2, ContDiffOn ℝ ∞ (pd2 k u) V := fun k => hinf u hu k
  have hppu : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (pd2 i (pd2 j u)) V :=
    fun i j => hinf _ (hpu j) i
  show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
    (pd2 i (pd2 j u) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k u x)) V
  exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hinv i j).mul ((hppu i j).sub
    (ContDiffOn.sum fun k _ => (hchr k i j).mul (hpu k)))

theorem pcgb_jet_lap_bound (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ (M : Matrix (Fin 2) (Fin 2) ℝ) (K : ℝ), (∀ a c : Fin 2, M a c = M c a) ∧ 0 ≤ K ∧
      ∀ x : E2, dist x x₀ < min R₀ 1 →
        |lap2 h (pcgbJetD h x₀) x - 4 - pcgbPxQuad M x₀ x| ≤ K * dist x x₀ ^ 3 ∧
        ‖fderiv ℝ (fun y => lap2 h (pcgbJetD h x₀) y - 4 - pcgbPxQuad M x₀ y) x‖ ≤
          K * dist x x₀ ^ 2 :=
by
  
  have s3 : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (g1 : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ)
      (g2 : Fin 2 → Fin 2 → Matrix (Fin 2) (Fin 2) ℝ),
      ContDiff ℝ ∞ (pcgbJD H g1 g2 x₀) ∧ (∀ k : Fin 2, pd2 k (pcgbJD H g1 g2 x₀) x₀ = 0) ∧
      (∀ i j : Fin 2, pd2 i (pd2 j (pcgbJD H g1 g2 x₀)) x₀ = H j i + H i j) ∧
      (∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJD H g1 g2 x₀))) x₀ =
        pcgbJW (pcgbJT H g1) j i m + pcgbJW (pcgbJT H g1) j m i) := by
    intro H g1 g2
    obtain ⟨-, -, -, -, -, hQs, hTs, hUs⟩ :=
      pcgb_form_pd2 x₀ x₀ 0 (fun _ => 0) H (pcgbJT H g1) (pcgbJU H g1 g2)
    have hDe : pcgbJD H g1 g2 x₀ = fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, H a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := rfl
    have hDs : ContDiff ℝ ∞ (pcgbJD H g1 g2 x₀) := by rw [hDe]; exact (hQs.add hTs).add hUs
    have h1 : ∀ j : Fin 2, pd2 j (pcgbJD H g1 g2 x₀) = fun y =>
        (∑ b : Fin 2, (H j b + H b j) * (y - x₀) b) +
        (∑ b : Fin 2, ∑ c : Fin 2, pcgbJW (pcgbJT H g1) j b c * (y - x₀) b * (y - x₀) c) +
        (∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJV (pcgbJU H g1 g2) j b c d * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
      intro j
      funext y
      obtain ⟨-, e2, e3, e4, -, -, -, -⟩ :=
        pcgb_form_pd2 x₀ y j (fun _ => 0) H (pcgbJT H g1) (pcgbJU H g1 g2)
      rw [hDe]
      unfold pd2 at e2 e3 e4 ⊢
      rw [fderiv_fun_add ((hQs.add hTs).differentiable (by simp) y)
          (hUs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (hQs.differentiable (by simp) y) (hTs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply, e2, e3, e4]
      simp only [pcgbJW, pcgbJV]
    have h2 : ∀ i j : Fin 2, pd2 i (pd2 j (pcgbJD H g1 g2 x₀)) = fun y =>
        (H j i + H i j) +
        (∑ c : Fin 2, (pcgbJW (pcgbJT H g1) j i c + pcgbJW (pcgbJT H g1) j c i) * (y - x₀) c) +
        (∑ c : Fin 2, ∑ d : Fin 2, (pcgbJV (pcgbJU H g1 g2) j i c d +
          pcgbJV (pcgbJU H g1 g2) j c i d + pcgbJV (pcgbJU H g1 g2) j c d i) *
            (y - x₀) c * (y - x₀) d) := by
      intro i j
      rw [h1 j]
      funext y
      obtain ⟨e1, e2, e3, -, hLs, hBs, hTs', -⟩ :=
        pcgb_form_pd2 x₀ y i (fun b => H j b + H b j) (pcgbJW (pcgbJT H g1) j)
          (pcgbJV (pcgbJU H g1 g2) j) (fun _ _ _ _ => 0)
      unfold pd2 at e1 e2 e3 ⊢
      rw [fderiv_fun_add ((hLs.add hBs).differentiable (by simp) y)
          (hTs'.differentiable (by simp) y),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (hLs.differentiable (by simp) y) (hBs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply, e1, e2, e3]
    have h3 : ∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJD H g1 g2 x₀))) x₀ =
        pcgbJW (pcgbJT H g1) j i m + pcgbJW (pcgbJT H g1) j m i := by
      intro m i j
      rw [h2 i j]
      obtain ⟨e1, e2, -, -, hLs, hBs, -, -⟩ :=
        pcgb_form_pd2 x₀ x₀ m
          (fun c => pcgbJW (pcgbJT H g1) j i c + pcgbJW (pcgbJT H g1) j c i)
          (fun c d => pcgbJV (pcgbJU H g1 g2) j i c d + pcgbJV (pcgbJU H g1 g2) j c i d +
            pcgbJV (pcgbJU H g1 g2) j c d i) (fun _ _ _ => 0) (fun _ _ _ _ => 0)
      unfold pd2 at e1 e2 ⊢
      have hc : ContDiff ℝ ∞ (fun _ : E2 => H j i + H i j) := contDiff_const
      rw [fderiv_fun_add ((hc.add hLs).differentiable (by simp) x₀)
          (hBs.differentiable (by simp) x₀),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (differentiableAt_const _) (hLs.differentiable (by simp) x₀),
        ContinuousLinearMap.add_apply, e1, e2]
      simp
    refine ⟨hDs, fun k => ?_, fun i j => ?_, h3⟩
    · rw [h1 k]; simp
    · rw [h2 i j]; simp
  
  have hx₀ : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀
  have hsymy : ∀ y ∈ W, ∀ r s : Fin 2, h y r s = h y s r := by
    intro y hy r s
    have := (hpd y hy).isHermitian.apply s r
    simpa using this
  have hsym10 : h x₀ 1 0 = h x₀ 0 1 := hsymy x₀ hx₀ 1 0
  have hdet2 : (h x₀).det = h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 := by
    rw [Matrix.det_fin_two, hsym10]
  have hdetne : h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 ≠ 0 := by
    rw [← hdet2]; exact hH.det_pos.ne'
  have hI00 : (h x₀)⁻¹ 0 0 = h x₀ 1 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI01 : (h x₀)⁻¹ 0 1 = -h x₀ 0 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI10 : (h x₀)⁻¹ 1 0 = -h x₀ 0 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI11 : (h x₀)⁻¹ 1 1 = h x₀ 0 0 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  generalize hΔdef : h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 = Δ at hI00 hI01 hI10 hI11 hdetne
  have hHiH : ∀ p s : Fin 2, ∑ r : Fin 2, (h x₀)⁻¹ p r * h x₀ r s = if p = s then 1 else 0 := by
    intro p s
    have hm := Matrix.nonsing_inv_mul (h x₀) (isUnit_iff_ne_zero.mpr hH.det_pos.ne')
    have := congrFun (congrFun hm p) s
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  
  have hGs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) W :=
    (pcgb_px_coeff_bounds W hW h hh hpd x₀ R₀ hR₀ hball).1
  have dA : ∀ u : E2 → ℝ, ContDiffOn ℝ ∞ u W → DifferentiableAt ℝ u x₀ := fun u hu =>
    (hu.contDiffAt (hW.mem_nhds hx₀)).differentiableAt (by simp)
  have pdS : ∀ (j : Fin 2) (u : E2 → ℝ), ContDiffOn ℝ ∞ u W → ContDiffOn ℝ ∞ (pd2 j u) W := by
    intro j u hu
    show ContDiffOn ℝ ∞ (fun x => fderiv ℝ u x (e2 j)) W
    exact (hu.fderiv_of_isOpen hW le_rfl).clm_apply contDiffOn_const
  have pSub : ∀ (k : Fin 2) (u v : E2 → ℝ), DifferentiableAt ℝ u x₀ → DifferentiableAt ℝ v x₀ →
      pd2 k (fun y => u y - v y) x₀ = pd2 k u x₀ - pd2 k v x₀ := by
    intro k u v hu hv
    unfold pd2
    rw [fderiv_fun_sub hu hv, ContinuousLinearMap.sub_apply]
  have pMul : ∀ (k : Fin 2) (u v : E2 → ℝ), DifferentiableAt ℝ u x₀ → DifferentiableAt ℝ v x₀ →
      pd2 k (fun y => u y * v y) x₀ = u x₀ * pd2 k v x₀ + v x₀ * pd2 k u x₀ := by
    intro k u v hu hv
    unfold pd2
    rw [fderiv_fun_mul hu hv, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
  have pSum : ∀ (k : Fin 2) (F : Fin 2 → E2 → ℝ), (∀ i, DifferentiableAt ℝ (F i) x₀) →
      pd2 k (fun y => ∑ i : Fin 2, F i y) x₀ = ∑ i : Fin 2, pd2 k (F i) x₀ := by
    intro k F hF
    unfold pd2
    rw [fderiv_fun_sum (fun i _ => hF i), ContinuousLinearMap.sum_apply]
  have hΓs : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) W
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hGs k l).mul
      (((pdS i _ (hh j l)).add (pdS j _ (hh i l))).sub (pdS l _ (hh i j))))
  
  have hAsym : ∀ k r s : Fin 2, pd2 k (fun y => h y r s) x₀ = pd2 k (fun y => h y s r) x₀ := by
    intro k r s
    have ev : (fun y => h y r s) =ᶠ[𝓝 x₀] (fun y => h y s r) :=
      Filter.eventually_of_mem (hW.mem_nhds hx₀) (fun y hy => hsymy y hy r s)
    unfold pd2
    rw [ev.fderiv_eq]
  have hE : ∀ k r q : Fin 2, ∑ s : Fin 2, (h x₀ r s * pd2 k (fun y => (h y)⁻¹ s q) x₀ +
      (h x₀)⁻¹ s q * pd2 k (fun y => h y r s) x₀) = 0 := by
    intro k r q
    have ev : (fun y => ∑ s : Fin 2, h y r s * (h y)⁻¹ s q) =ᶠ[𝓝 x₀]
        (fun _ => if r = q then (1 : ℝ) else 0) := by
      filter_upwards [hW.mem_nhds hx₀] with y hy
      have hm := Matrix.mul_nonsing_inv (h y) (isUnit_iff_ne_zero.mpr (hpd y hy).det_pos.ne')
      have := congrFun (congrFun hm r) q
      rwa [Matrix.mul_apply, Matrix.one_apply] at this
    have h0 : pd2 k (fun y => ∑ s : Fin 2, h y r s * (h y)⁻¹ s q) x₀ = 0 := by
      unfold pd2; rw [ev.fderiv_eq]; simp
    rw [pSum k (fun s y => h y r s * (h y)⁻¹ s q)
      (fun s => dA _ ((hh r s).mul (hGs s q)))] at h0
    refine (Finset.sum_congr rfl fun s _ => ?_).trans h0
    rw [pMul k (fun y => h y r s) (fun y => (h y)⁻¹ s q) (dA _ (hh r s)) (dA _ (hGs s q))]
  have hg1 : ∀ k p q : Fin 2, pd2 k (fun y => (h y)⁻¹ p q) x₀ =
      -∑ r : Fin 2, ∑ s : Fin 2,
        (h x₀)⁻¹ p r * pd2 k (fun y => h y r s) x₀ * (h x₀)⁻¹ s q := by
    intro k p q
    have e2 : ∑ s : Fin 2, (∑ r : Fin 2, (h x₀)⁻¹ p r * h x₀ r s) *
        pd2 k (fun y => (h y)⁻¹ s q) x₀ = pd2 k (fun y => (h y)⁻¹ p q) x₀ := by
      simp only [hHiH]; simp
    have e3 : ∑ r : Fin 2, (h x₀)⁻¹ p r * ∑ s : Fin 2, (h x₀ r s *
        pd2 k (fun y => (h y)⁻¹ s q) x₀ + (h x₀)⁻¹ s q * pd2 k (fun y => h y r s) x₀) = 0 := by
      simp only [hE, mul_zero, Finset.sum_const_zero]
    simp only [Fin.sum_univ_two] at e2 e3 ⊢
    linear_combination e3 - e2
  
  have hT : ∀ a b c : Fin 2, pcgbJT (h x₀) (pcgbJg1 h x₀) a b c =
      1 / 2 * pd2 c (fun y => h y a b) x₀ := by
    intro a b c
    simp only [pcgbJT, pcgbJg1, hg1, Fin.sum_univ_two]
    revert a b
    simp only [Fin.forall_fin_two]
    simp only [hI00, hI01, hI10, hI11, hsym10, hAsym c 1 0]
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> (field_simp; rw [← hΔdef]; ring)
  
  obtain ⟨hDs, hd1, hd2, hd3⟩ := s3 (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)
  change ContDiff ℝ ∞ (pcgbJetD h x₀) at hDs
  change ∀ k : Fin 2, pd2 k (pcgbJetD h x₀) x₀ = 0 at hd1
  change ∀ i j : Fin 2, pd2 i (pd2 j (pcgbJetD h x₀)) x₀ = h x₀ j i + h x₀ i j at hd2
  change ∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJetD h x₀))) x₀ =
    pcgbJW (pcgbJT (h x₀) (pcgbJg1 h x₀)) j i m +
      pcgbJW (pcgbJT (h x₀) (pcgbJg1 h x₀)) j m i at hd3
  generalize pcgbJetD h x₀ = D at hDs hd1 hd2 hd3 ⊢
  have hDW : ContDiffOn ℝ ∞ D W := hDs.contDiffOn
  
  have hpm : ∀ m : Fin 2, pd2 m (lap2 h D) x₀ =
      ∑ i : Fin 2, ∑ j : Fin 2,
        ((h x₀)⁻¹ i j * (pd2 m (pd2 i (pd2 j D)) x₀ -
            ∑ k : Fin 2, (christoffel2 h k i j x₀ * pd2 m (pd2 k D) x₀ +
              pd2 k D x₀ * pd2 m (christoffel2 h k i j) x₀)) +
          (pd2 i (pd2 j D) x₀ - ∑ k : Fin 2, christoffel2 h k i j x₀ * pd2 k D x₀) *
            pd2 m (fun y => (h y)⁻¹ i j) x₀) := by
    intro m
    have hl : lap2 h D = fun x => ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
        (pd2 i (pd2 j D) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) := rfl
    have sK : ∀ i j : Fin 2, ContDiffOn ℝ ∞
        (fun x => ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) W :=
      fun i j => ContDiffOn.sum fun k _ => (hΓs k i j).mul (pdS k _ hDW)
    have sI : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) W :=
      fun i j => (pdS i _ (pdS j _ hDW)).sub (sK i j)
    have sS : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x)) W :=
      fun i j => (hGs i j).mul (sI i j)
    rw [hl, pSum m (fun i x => ∑ j : Fin 2, (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x))
      (fun i => dA _ (ContDiffOn.sum fun j _ => sS i j))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [pSum m (fun j x => (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x)) (fun j => dA _ (sS i j))]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hk : ∀ k : Fin 2, pd2 m (fun x => christoffel2 h k i j x * pd2 k D x) x₀ =
        christoffel2 h k i j x₀ * pd2 m (pd2 k D) x₀ +
          pd2 k D x₀ * pd2 m (christoffel2 h k i j) x₀ :=
      fun k => pMul m _ _ (dA _ (hΓs k i j)) (dA _ (pdS k _ hDW))
    rw [pMul m (fun y => (h y)⁻¹ i j) _ (dA _ (hGs i j)) (dA _ (sI i j)),
      pSub m _ _ (dA _ (pdS i _ (pdS j _ hDW))) (dA _ (sK i j)),
      pSum m (fun k x => christoffel2 h k i j x * pd2 k D x)
        (fun k => dA _ ((hΓs k i j).mul (pdS k _ hDW)))]
    simp only [hk]
  
  have hpm0 : ∀ m : Fin 2, pd2 m (lap2 h D) x₀ = 0 := by
    intro m
    rw [hpm m]
    simp only [hd1, hd2, hd3, mul_zero, zero_mul, add_zero, sub_zero, Finset.sum_const_zero]
    simp only [pcgbJW, hT, christoffel2, hg1, Fin.sum_univ_two]
    revert m
    simp only [Fin.forall_fin_two]
    simp only [hI00, hI01, hI10, hI11, hsym10, hAsym 0 1 0, hAsym 1 1 0]
    constructor <;> (field_simp; rw [← hΔdef]; ring)
  
  have hfs : ContDiffOn ℝ ∞ (fun y => lap2 h D y - 4) W :=
    (pcgb_lap2_contDiffOn W hW h hh hpd D hDW).sub contDiffOn_const
  have hf0 : lap2 h D x₀ - 4 = 0 := by
    simp only [lap2, hd1, mul_zero, Finset.sum_const_zero, sub_zero, hd2]
    simp only [Fin.sum_univ_two, hI00, hI01, hI10, hI11, hsym10]
    field_simp
    rw [← hΔdef]
    ring
  have hf1 : ∀ k : Fin 2, pd2 k (fun y => lap2 h D y - 4) x₀ = 0 := by
    intro k
    have : pd2 k (fun y => lap2 h D y - 4) x₀ = pd2 k (lap2 h D) x₀ := by
      unfold pd2; rw [fderiv_sub_const]
    rw [this, hpm0 k]
  
  obtain ⟨K, hK, hb⟩ :=
    pcgb_taylor2_remainder W hW (fun y => lap2 h D y - 4) hfs x₀ R₀ hR₀ hball
  refine ⟨Matrix.of fun a c => (1 / 4 : ℝ) *
      (pd2 a (pd2 c (fun y => lap2 h D y - 4)) x₀ + pd2 c (pd2 a (fun y => lap2 h D y - 4)) x₀),
    K, ?_, hK, ?_⟩
  · intro a c
    simp only [Matrix.of_apply]
    ring
  · intro x hx
    have hTay : pcgbTay2 (fun y => lap2 h D y - 4) x₀ = fun y => lap2 h D y - 4 -
        pcgbPxQuad (Matrix.of fun a c => (1 / 4 : ℝ) *
          (pd2 a (pd2 c (fun y => lap2 h D y - 4)) x₀ +
            pd2 c (pd2 a (fun y => lap2 h D y - 4)) x₀)) x₀ y := by
      funext y
      simp only [pcgbTay2, pcgbPxQuad, hf0, hf1, zero_mul, Finset.sum_const_zero, sub_zero,
        Matrix.of_apply, Fin.sum_univ_two]
      ring
    have hxb : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr (le_trans hx.le (min_le_left _ _))
    obtain ⟨e0, e1, -⟩ := hb x hxb
    rw [hTay] at e0 e1
    exact ⟨e0, e1⟩

theorem pcgb_parametrix_jet (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ (D : E2 → ℝ) (M : Matrix (Fin 2) (Fin 2) ℝ) (σ c₀ K : ℝ),
      0 < σ ∧ σ ≤ R₀ ∧ σ ≤ 1 ∧ 0 < c₀ ∧ 0 ≤ K ∧ (∀ a c : Fin 2, M a c = M c a) ∧
      ContDiff ℝ ∞ D ∧
      ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → pcgbPxJet h D M x₀ c₀ K x :=
by
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  have hsym : h x₀ 1 0 = h x₀ 0 1 := by
    have := hH.isHermitian.apply 0 1
    simpa using this
  have h00 : 0 < h x₀ 0 0 := hH.diag_pos
  have h11 : 0 < h x₀ 1 1 := hH.diag_pos
  have hdet : 0 < (h x₀).det := hH.det_pos
  have hdet2 : (h x₀).det = h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 1 0 := Matrix.det_fin_two _
  obtain ⟨tr, htrdef⟩ : ∃ tr : ℝ, tr = h x₀ 0 0 + h x₀ 1 1 := ⟨_, rfl⟩
  have htr : 0 < tr := by rw [htrdef]; linarith
  obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = (h x₀).det / tr := ⟨_, rfl⟩
  have hlam : 0 < lam := by rw [hlamdef]; exact div_pos hdet htr
  have hs2 : ∀ x : E2, dist x x₀ ^ 2 = (x - x₀) 0 ^ 2 + (x - x₀) 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => sq_nonneg _)),
      Fin.sum_univ_two]
    simp [Real.dist_eq, sq_abs]
  
  have hQlow : ∀ x : E2, lam * dist x x₀ ^ 2 ≤ pcgbPxQuad (h x₀) x₀ x := by
    intro x
    have hQ : pcgbPxQuad (h x₀) x₀ x =
        h x₀ 0 0 * (x - x₀) 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 0 * (x - x₀) 1 +
          (h x₀ 1 0 * (x - x₀) 1 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp only [pcgbPxQuad, Fin.sum_univ_two]
    have key : tr * pcgbPxQuad (h x₀) x₀ x - (h x₀).det * dist x x₀ ^ 2 =
        (h x₀ 0 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 1) ^ 2 +
          (h x₀ 1 0 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1) ^ 2 := by
      rw [hQ, hs2, hdet2, htrdef, hsym]; ring
    rw [hlamdef, div_mul_eq_mul_div, div_le_iff₀ htr]
    nlinarith [sq_nonneg (h x₀ 0 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 1),
      sq_nonneg (h x₀ 1 0 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1)]
  
  obtain ⟨T, hTdef⟩ : ∃ T : Fin 2 → Fin 2 → Fin 2 → ℝ, T = pcgbJT (h x₀) (pcgbJg1 h x₀) :=
    ⟨_, rfl⟩
  obtain ⟨U, hUdef⟩ : ∃ U : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ,
      U = pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) := ⟨_, rfl⟩
  have hDdef : pcgbJetD h x₀ = fun y => pcgbPxQuad (h x₀) x₀ y +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    rw [hTdef, hUdef]; rfl
  obtain ⟨-, -, -, -, -, hQs, hTs, hUs⟩ := pcgb_form_pd2 x₀ x₀ 0 (fun _ => 0) (h x₀) T U
  have hDs : ContDiff ℝ ∞ (pcgbJetD h x₀) := by
    rw [hDdef]; exact (hQs.add hTs).add hUs
  
  obtain ⟨φ, hφdef⟩ : ∃ φ : E2 → ℝ, φ = fun y => pcgbJetD h x₀ y - pcgbPxQuad (h x₀) x₀ y :=
    ⟨_, rfl⟩
  have hφeq : φ = fun y =>
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    rw [hφdef, hDdef]; funext y; ring
  have hφs : ContDiff ℝ ∞ φ := by rw [hφeq]; exact hTs.add hUs
  have hpdφ : ∀ l : Fin 2, pd2 l φ = fun y =>
      (∑ b : Fin 2, ∑ c : Fin 2, pcgbJW T l b c * (y - x₀) b * (y - x₀) c) +
      (∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        pcgbJV U l b c d * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    intro l
    funext y
    obtain ⟨-, -, h3, h4, -⟩ := pcgb_form_pd2 x₀ y l (fun _ => 0) (fun _ _ => 0) T U
    have hd1 := (hTs.differentiable (by simp)) y
    have hd2 := (hUs.differentiable (by simp)) y
    rw [hφeq]
    unfold pd2 at h3 h4 ⊢
    rw [fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply, h3, h4]
    simp only [pcgbJW, pcgbJV]
  have hφx₀ : φ x₀ = 0 := by rw [hφeq]; simp
  have hpd1 : ∀ k : Fin 2, pd2 k φ x₀ = 0 := by
    intro k; rw [hpdφ k]; simp
  have hpd2 : ∀ k l : Fin 2, pd2 k (pd2 l φ) x₀ = 0 := by
    intro k l
    rw [hpdφ l]
    obtain ⟨-, h2, h3, -, -, hBs', hTs', -⟩ :=
      pcgb_form_pd2 x₀ x₀ k (fun _ => 0) (pcgbJW T l) (pcgbJV U l) (fun _ _ _ _ => 0)
    have hd1 := (hBs'.differentiable (by simp)) x₀
    have hd2 := (hTs'.differentiable (by simp)) x₀
    unfold pd2 at h2 h3 ⊢
    rw [fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply, h2, h3]
    simp
  have hTay : pcgbTay2 φ x₀ = φ := by
    funext y
    unfold pcgbTay2
    rw [hφx₀]
    simp only [hpd1, hpd2]
    simp
  obtain ⟨K₂, hK₂, hb2⟩ := pcgb_taylor2_remainder Set.univ isOpen_univ φ hφs.contDiffOn x₀ R₀
    hR₀ (Set.subset_univ _)
  rw [hTay] at hb2
  
  obtain ⟨K₃, hK₃, hb3⟩ := pcgb_jet_eikonal_bound W hW h hh hpd x₀ R₀ hR₀ hball
  obtain ⟨M, K₄, hMs, hK₄, hb4⟩ := pcgb_jet_lap_bound W hW h hh hpd x₀ R₀ hR₀ hball
  have hK2p : 0 < 2 * (K₂ + 1) := by linarith
  refine ⟨pcgbJetD h x₀, M, min (min R₀ 1) (lam / (2 * (K₂ + 1))), lam / 2, K₂ + K₃ + K₄,
    ?_, ?_, ?_, ?_, ?_, hMs, hDs, ?_⟩
  · exact lt_min (lt_min hR₀ one_pos) (div_pos hlam hK2p)
  · exact le_trans (min_le_left _ _) (min_le_left _ _)
  · exact le_trans (min_le_left _ _) (min_le_right _ _)
  · linarith
  · linarith
  · intro x hx0 hxσ
    have hσ1 : dist x x₀ < min R₀ 1 := lt_of_lt_of_le hxσ (min_le_left _ _)
    have hσ2 : dist x x₀ < lam / (2 * (K₂ + 1)) := lt_of_lt_of_le hxσ (min_le_right _ _)
    have hxR : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr (le_of_lt (lt_of_lt_of_le hσ1 (min_le_left _ _)))
    obtain ⟨e0, e1, e2⟩ := hb2 x hxR
    obtain ⟨e3, e4⟩ := hb3 x hσ1
    obtain ⟨e5, e6⟩ := hb4 x hσ1
    have hs0 : 0 ≤ dist x x₀ := le_of_lt hx0
    have hφx : φ x = pcgbJetD h x₀ x - pcgbPxQuad (h x₀) x₀ x := by rw [hφdef]
    have hKK2 : K₂ ≤ K₂ + K₃ + K₄ := by linarith
    have hKK3 : K₃ ≤ K₂ + K₃ + K₄ := by linarith
    have hKK4 : K₄ ≤ K₂ + K₃ + K₄ := by linarith
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hQ := hQlow x
      have habs := (abs_le.mp e0).1
      rw [hφx] at habs
      have h1 : dist x x₀ * (2 * (K₂ + 1)) < lam := (lt_div_iff₀ hK2p).mp hσ2
      have hK2s : K₂ * dist x x₀ ≤ lam / 2 := by nlinarith
      have h3 : K₂ * dist x x₀ ^ 3 ≤ lam / 2 * dist x x₀ ^ 2 := by
        have e : K₂ * dist x x₀ ^ 3 = (K₂ * dist x x₀) * dist x x₀ ^ 2 := by ring
        rw [e]
        exact mul_le_mul_of_nonneg_right hK2s (pow_nonneg hs0 2)
      linarith
    · rw [hφx] at e0
      exact e0.trans (mul_le_mul_of_nonneg_right hKK2 (pow_nonneg hs0 3))
    · rw [hφdef] at e1
      exact e1.trans (mul_le_mul_of_nonneg_right hKK2 (pow_nonneg hs0 2))
    · rw [hφdef] at e2
      exact e2.trans (mul_le_mul_of_nonneg_right hKK2 hs0)
    · exact e3.trans (mul_le_mul_of_nonneg_right hKK3 (pow_nonneg hs0 5))
    · exact e4.trans (mul_le_mul_of_nonneg_right hKK3 (pow_nonneg hs0 4))
    · exact e5.trans (mul_le_mul_of_nonneg_right hKK4 (pow_nonneg hs0 3))
    · exact e6.trans (mul_le_mul_of_nonneg_right hKK4 (pow_nonneg hs0 2))

theorem pcgb_log_quad_correction (H M : Matrix (Fin 2) (Fin 2) ℝ) (hH : H.PosDef)
    (hM : ∀ a c : Fin 2, M a c = M c a) (x₀ : E2) :
    ContDiffOn ℝ ∞ (pcgbPxPsi H M x₀) {x | x ≠ x₀} ∧
      ∃ K : ℝ, 0 ≤ K ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < 1 → pcgbPxPsiEst H M x₀ K x :=
by
  
  have t_hasQ : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2),
      HasFDerivAt (pcgbPxQuad A x₀)
        (∑ a : Fin 2, ∑ c : Fin 2, A a c •
          ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) y := by
    intro A x₀ y
    have hl : ∀ a : Fin 2, HasFDerivAt (fun y : E2 => (y - x₀) a)
        (EuclideanSpace.proj a : E2 →L[ℝ] ℝ) y := by
      intro a
      have h1 := ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).hasFDerivAt (x := y)).sub_const (x₀ a)
      convert h1 using 1
    have hterm : ∀ a c : Fin 2, HasFDerivAt (fun y : E2 => A a c * (y - x₀) a * (y - x₀) c)
        (A a c • ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) y := by
      intro a c
      have := ((hl a).const_mul (A a c)).mul (hl c)
      convert this using 1
      ext w
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hs := HasFDerivAt.sum (u := Finset.univ) (fun a _ =>
      HasFDerivAt.sum (u := Finset.univ) (fun c _ => hterm a c))
    convert hs using 1
  have t_evalQ : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2) (j : Fin 2),
      (∑ a : Fin 2, ∑ c : Fin 2, A a c •
          ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) (e2 j) =
        ∑ c : Fin 2, (A j c + A c j) * (y - x₀) c := by
    intro A x₀ y j
    fin_cases j <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply] <;> ring
  
  have t_iter3 : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2),
      ContDiff ℝ ∞ (pcgbPxQuad A x₀) ∧ ∀ y : E2, iteratedFDeriv ℝ 3 (pcgbPxQuad A x₀) y = 0 := by
    intro A x₀
    have hcoord : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := fun a =>
      (EuclideanSpace.proj a : E2 →L[ℝ] ℝ).contDiff.comp (contDiff_id.sub contDiff_const)
    refine ⟨?_, ?_⟩
    · exact ContDiff.sum fun a _ => ContDiff.sum fun c _ =>
        (contDiff_const.mul (hcoord a)).mul (hcoord c)
    intro y
    set L : E2 →L[ℝ] E2 →L[ℝ] ℝ := ∑ a : Fin 2, ∑ c : Fin 2, A a c •
      ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).smulRight (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
       (EuclideanSpace.proj c : E2 →L[ℝ] ℝ).smulRight (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))
      with hL
    have h1 : fderiv ℝ (pcgbPxQuad A x₀) = fun y => L (y - x₀) := by
      funext z
      rw [(t_hasQ A x₀ z).fderiv]
      ext w
      simp [hL, Fin.sum_univ_two]
    have h2 : fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀)) = fun _ => L := by
      funext z
      rw [h1]
      have := (L.hasFDerivAt (x := z - x₀)).comp z ((hasFDerivAt_id z).sub_const x₀)
      have e : (fun y => L (y - x₀)) = (⇑L ∘ fun x => id x - x₀) := rfl
      rw [e, this.fderiv]
      ext w
      simp
    have h3 : fderiv ℝ (fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀))) y = 0 := by
      rw [h2]
      exact fderiv_const_apply (𝕜 := ℝ) (x := y) L
    rw [← norm_eq_zero, ← norm_iteratedFDeriv_fderiv (n := 2),
      ← norm_iteratedFDeriv_fderiv (n := 1), norm_iteratedFDeriv_one, h3, norm_zero]
  
  have t_scaling : ∀ (φ n₀ : E2 → ℝ), ContDiffOn ℝ ∞ φ {z | z ≠ 0} → ContDiff ℝ ∞ n₀ →
      (∀ t : ℝ, 0 < t → ∀ z : E2, φ (t • z) = t ^ 2 * φ z + t ^ 2 * Real.log t * n₀ z) →
      ∀ (k : ℕ) (t : ℝ), 0 < t → ∀ z : E2, z ≠ 0 →
        t ^ k • iteratedFDeriv ℝ k φ (t • z) =
          t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z := by
    intro φ n₀ hφ hn hs k t ht z hz
    set g : E2 ≃L[ℝ] E2 :=
      (LinearEquiv.smulOfNeZero ℝ E2 t ht.ne').toContinuousLinearEquiv with hg
    have hgw : ∀ w : E2, g w = t • w := fun w => rfl
    have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have h1 := ContinuousLinearEquiv.iteratedFDerivWithin_comp_right g φ uniqueDiffOn_univ
      (x := z) (Set.mem_univ _) k
    rw [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at h1
    have hfun : (φ ∘ ⇑g) = fun w => t ^ 2 • φ w + (t ^ 2 * Real.log t) • n₀ w := by
      funext w
      simp only [Function.comp_apply, hgw, smul_eq_mul]
      rw [hs t ht w]
    have hφz : ContDiffAt ℝ ∞ φ z := hφ.contDiffAt (isOpen_ne.mem_nhds hz)
    have hA : ContDiffAt ℝ k (fun w => t ^ 2 • φ w) z := (hφz.of_le hk).const_smul _
    have hB : ContDiffAt ℝ k (fun w => (t ^ 2 * Real.log t) • n₀ w) z :=
      ((hn.contDiffAt).of_le hk).const_smul _
    have h2 : iteratedFDeriv ℝ k (φ ∘ ⇑g) z =
        t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z := by
      rw [hfun, iteratedFDeriv_add_apply' hA hB, iteratedFDeriv_const_smul_apply' (hφz.of_le hk),
        iteratedFDeriv_const_smul_apply' ((hn.contDiffAt).of_le hk)]
    rw [← h2, h1]
    ext m
    simp only [ContinuousMultilinearMap.smul_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply]
    have h3 : (fun i => ((g : E2 →L[ℝ] E2)) (m i)) = fun i => t • m i := by
      funext i
      exact hgw (m i)
    rw [h3, ContinuousMultilinearMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, hgw]
  
  have t_bounds : ∀ (φ n₀ : E2 → ℝ), ContDiffOn ℝ ∞ φ {z | z ≠ 0} → ContDiff ℝ ∞ n₀ →
      (∀ z : E2, iteratedFDeriv ℝ 3 n₀ z = 0) →
      (∀ (k : ℕ) (t : ℝ), 0 < t → ∀ z : E2, z ≠ 0 →
        t ^ k • iteratedFDeriv ℝ k φ (t • z) =
          t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z) →
      ∃ B : ℝ, 0 ≤ B ∧ ∀ z : E2, z ≠ 0 →
        ‖φ z‖ ≤ B * ‖z‖ ^ 2 * (1 + |Real.log ‖z‖|) ∧
        ‖fderiv ℝ φ z‖ ≤ B * ‖z‖ * (1 + |Real.log ‖z‖|) ∧
        ‖iteratedFDeriv ℝ 2 φ z‖ ≤ B * (1 + |Real.log ‖z‖|) ∧
        ‖iteratedFDeriv ℝ 3 φ z‖ ≤ B / ‖z‖ := by
    intro φ n₀ hφ hn hn3 hsc
    have hU : IsOpen {z : E2 | z ≠ 0} := isOpen_ne
    have hSU : Metric.sphere (0 : E2) 1 ⊆ {z : E2 | z ≠ 0} := by
      intro u hu
      have h1 : ‖u‖ = 1 := mem_sphere_zero_iff_norm.mp hu
      intro h0
      rw [h0, norm_zero] at h1
      exact zero_ne_one h1
    have hbd : ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ u ∈ Metric.sphere (0 : E2) 1,
        ‖iteratedFDeriv ℝ k φ u‖ ≤ C ∧ ‖iteratedFDeriv ℝ k n₀ u‖ ≤ C := by
      intro k
      have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
      have hc1 : ContinuousOn (iteratedFDeriv ℝ k φ) (Metric.sphere (0 : E2) 1) :=
        ((hφ.continuousOn_iteratedFDerivWithin (m := k) hk hU.uniqueDiffOn).congr
          (fun z hz => (iteratedFDerivWithin_of_isOpen k hU hz).symm)).mono hSU
      have hc2 : ContinuousOn (iteratedFDeriv ℝ k n₀) (Metric.sphere (0 : E2) 1) :=
        (hn.continuous_iteratedFDeriv (m := k) hk).continuousOn
      obtain ⟨C1, hC1⟩ := (isCompact_sphere (0 : E2) 1).exists_bound_of_continuousOn hc1
      obtain ⟨C2, hC2⟩ := (isCompact_sphere (0 : E2) 1).exists_bound_of_continuousOn hc2
      refine ⟨|C1| + |C2|, by positivity, fun u hu => ⟨?_, ?_⟩⟩
      · exact (hC1 u hu).trans ((le_abs_self _).trans (le_add_of_nonneg_right (abs_nonneg _)))
      · exact (hC2 u hu).trans ((le_abs_self _).trans (le_add_of_nonneg_left (abs_nonneg _)))
    have hgen : ∀ (k : ℕ) (C : ℝ), 0 ≤ C → (∀ u ∈ Metric.sphere (0 : E2) 1,
        ‖iteratedFDeriv ℝ k φ u‖ ≤ C ∧ ‖iteratedFDeriv ℝ k n₀ u‖ ≤ C) →
        ∀ z : E2, z ≠ 0 →
          ‖z‖ ^ k * ‖iteratedFDeriv ℝ k φ z‖ ≤ ‖z‖ ^ 2 * C * (1 + |Real.log ‖z‖|) ∧
          ‖z‖ ^ k * ‖iteratedFDeriv ℝ k φ z‖ ≤
            ‖z‖ ^ 2 * C + ‖z‖ ^ 2 * |Real.log ‖z‖| * ‖iteratedFDeriv ℝ k n₀ (‖z‖⁻¹ • z)‖ := by
      intro k C hC hb z hz
      have hs : 0 < ‖z‖ := norm_pos_iff.mpr hz
      set s := ‖z‖ with hsdef
      have hu : s⁻¹ • z ∈ Metric.sphere (0 : E2) 1 := by
        rw [mem_sphere_zero_iff_norm, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hs,
          inv_mul_cancel₀ hs.ne']
      have hu0 : s⁻¹ • z ≠ 0 := hSU hu
      have hsu : s • (s⁻¹ • z) = z := by rw [smul_smul, mul_inv_cancel₀ hs.ne', one_smul]
      have hid := hsc k s hs (s⁻¹ • z) hu0
      rw [hsu] at hid
      have hn1 := congrArg norm hid
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (pow_pos hs k)] at hn1
      have htri := norm_add_le (s ^ 2 • iteratedFDeriv ℝ k φ (s⁻¹ • z))
        ((s ^ 2 * Real.log s) • iteratedFDeriv ℝ k n₀ (s⁻¹ • z))
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (pow_pos hs 2),
        abs_mul, abs_of_pos (pow_pos hs 2)] at htri
      obtain ⟨b1, b2⟩ := hb _ hu
      have hs2 : 0 ≤ s ^ 2 := by positivity
      have hL : 0 ≤ |Real.log s| := abs_nonneg _
      have e1 : s ^ 2 * ‖iteratedFDeriv ℝ k φ (s⁻¹ • z)‖ ≤ s ^ 2 * C :=
        mul_le_mul_of_nonneg_left b1 hs2
      have e2 : s ^ 2 * |Real.log s| * ‖iteratedFDeriv ℝ k n₀ (s⁻¹ • z)‖ ≤
          s ^ 2 * |Real.log s| * C :=
        mul_le_mul_of_nonneg_left b2 (mul_nonneg hs2 hL)
      constructor
      · nlinarith
      · linarith
    obtain ⟨C0, hC0, hb0⟩ := hbd 0
    obtain ⟨C1, hC1, hb1⟩ := hbd 1
    obtain ⟨C2, hC2, hb2⟩ := hbd 2
    obtain ⟨C3, hC3, hb3⟩ := hbd 3
    refine ⟨C0 + C1 + C2 + C3, by positivity, fun z hz => ?_⟩
    have hs : 0 < ‖z‖ := norm_pos_iff.mpr hz
    have g0 := (hgen 0 C0 hC0 hb0 z hz).1
    have g1 := (hgen 1 C1 hC1 hb1 z hz).1
    have g2 := (hgen 2 C2 hC2 hb2 z hz).1
    have g3 := (hgen 3 C3 hC3 hb3 z hz).2
    rw [hn3, norm_zero, mul_zero, add_zero] at g3
    rw [norm_iteratedFDeriv_zero, pow_zero, one_mul] at g0
    rw [norm_iteratedFDeriv_one, pow_one] at g1
    set s := ‖z‖
    set L := 1 + |Real.log s|
    have hL1 : 0 ≤ L := by positivity
    refine ⟨?_, ?_, ?_, ?_⟩
    · have : C0 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      nlinarith
    · apply le_of_mul_le_mul_left _ hs
      have : C1 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      calc s * ‖fderiv ℝ φ z‖ ≤ s ^ 2 * C1 * L := g1
        _ ≤ s * ((C0 + C1 + C2 + C3) * s * L) := by nlinarith
    · apply le_of_mul_le_mul_left _ (pow_pos hs 2)
      have : C2 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      calc s ^ 2 * ‖iteratedFDeriv ℝ 2 φ z‖ ≤ s ^ 2 * C2 * L := g2
        _ ≤ s ^ 2 * ((C0 + C1 + C2 + C3) * L) := by nlinarith
    · rw [le_div_iff₀ hs]
      apply le_of_mul_le_mul_left _ (pow_pos hs 2)
      have : C3 ≤ C0 + C1 + C2 + C3 := by linarith
      calc s ^ 2 * (‖iteratedFDeriv ℝ 3 φ z‖ * s) = s ^ 3 * ‖iteratedFDeriv ℝ 3 φ z‖ := by ring
        _ ≤ s ^ 2 * C3 := g3
        _ ≤ s ^ 2 * (C0 + C1 + C2 + C3) := mul_le_mul_of_nonneg_left this (by positivity)
  have t_lin : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2) (j : Fin 2),
      HasFDerivAt (fun y : E2 => ∑ c : Fin 2, A j c * (y - x₀) c)
        (∑ c : Fin 2, A j c • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ)) y := by
    intro A x₀ y j
    have hl : ∀ a : Fin 2, HasFDerivAt (fun y : E2 => (y - x₀) a)
        (EuclideanSpace.proj a : E2 →L[ℝ] ℝ) y := by
      intro a
      have h1 := ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).hasFDerivAt (x := y)).sub_const (x₀ a)
      convert h1 using 1
    have hs := HasFDerivAt.sum (u := Finset.univ) (fun c _ => (hl c).const_mul (A j c))
    convert hs using 1
  have t_evalL : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      (∑ c : Fin 2, A j c • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ)) (e2 i) = A j i := by
    intro A i j
    fin_cases i <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply]
  have hQpos : ∀ y : E2, y ≠ x₀ → 0 < pcgbPxQuad H x₀ y := by
    intro y hy
    show 0 < ∑ a : Fin 2, ∑ c : Fin 2, H a c * (y - x₀) a * (y - x₀) c
    have hv0 : (fun a => (y - x₀) a : Fin 2 → ℝ) ≠ 0 := by
      intro h0
      apply hy
      rw [← sub_eq_zero]
      ext a
      simpa using congrFun h0 a
    have hpd' := hH.dotProduct_mulVec_pos hv0
    have hform : star (fun a => (y - x₀) a : Fin 2 → ℝ) ⬝ᵥ
        H.mulVec (fun a => (y - x₀) a) =
        ∑ a : Fin 2, ∑ c : Fin 2, H a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
      ring
    rw [← hform]
    exact hpd'
  have hsH : H 1 0 = H 0 1 := by
    have := hH.isHermitian.apply 1 0
    simpa using this.symm
  have hsM : M 1 0 = M 0 1 := hM 1 0
  
  have t_trace : ∀ x : E2, x ≠ x₀ →
      ∑ i : Fin 2, ∑ j : Fin 2, H⁻¹ i j * pcgbPsiG2 H M x₀ i j x =
        (pcgbPxQuad M x₀ x - pcgbPxMu H M * pcgbPxQuad H x₀ x) / (2 * pcgbPxQuad H x₀ x) := by
    intro x hx
    have hQ := hQpos x hx
    have hinv : H⁻¹ = (H.det)⁻¹ • !![H 1 1, -H 0 1; -H 1 0, H 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have hdet : H.det = H 0 0 * H 1 1 - H 0 1 * H 1 0 := Matrix.det_fin_two H
    have hd : H.det ≠ 0 := hH.det_pos.ne'
    have hQe : pcgbPxQuad H x₀ x =
        H 0 0 * (x - x₀) 0 * (x - x₀) 0 + H 0 1 * (x - x₀) 0 * (x - x₀) 1 +
        (H 1 0 * (x - x₀) 1 * (x - x₀) 0 + H 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp [pcgbPxQuad, Fin.sum_univ_two]
    have hQme : pcgbPxQuad M x₀ x =
        M 0 0 * (x - x₀) 0 * (x - x₀) 0 + M 0 1 * (x - x₀) 0 * (x - x₀) 1 +
        (M 1 0 * (x - x₀) 1 * (x - x₀) 0 + M 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp [pcgbPxQuad, Fin.sum_univ_two]
    unfold pcgbPsiG2 pcgbPxMu
    rw [hQme]
    generalize hq : pcgbPxQuad H x₀ x = q at hQ hQe ⊢
    rw [hinv]
    simp only [Fin.sum_univ_two, Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
      Matrix.cons_val_fin_one, smul_eq_mul]
    simp only [hsH, hsM] at hQe hdet ⊢
    generalize H.det = d at hd hdet ⊢
    generalize Real.log q = lg
    generalize (x - x₀) 0 = w0 at hQe ⊢
    generalize (x - x₀) 1 = w1 at hQe ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    field_simp
    subst hQe hdet
    ring
  
  have t_first : ∀ y : E2, y ≠ x₀ → ∀ j : Fin 2,
      pd2 j (pcgbPxPsi H M x₀) y = pcgbPsiG1 H M x₀ j y := by
    intro y hy j
    have hQ := hQpos y hy
    have hd := (((t_hasQ M x₀ y).sub ((t_hasQ H x₀ y).const_mul (pcgbPxMu H M))).mul
      ((t_hasQ H x₀ y).log hQ.ne')).mul_const ((16 : ℝ)⁻¹)
    have hd' := hd.congr_of_eventuallyEq (f₁ := pcgbPxPsi H M x₀)
      (Filter.Eventually.of_forall fun z => by
        simp only [pcgbPxPsi, Pi.mul_apply, Pi.sub_apply, div_eq_mul_inv])
    unfold pd2
    rw [hd'.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, t_evalQ, Pi.sub_apply]
    unfold pcgbPsiG1
    generalize Real.log (pcgbPxQuad H x₀ y) = lg
    generalize pcgbPxQuad M x₀ y = qm
    generalize hq : pcgbPxQuad H x₀ y = q at hQ ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    fin_cases j <;> simp only [Fin.sum_univ_two, Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
      rw [hsH, hsM] <;> field_simp <;> ring
  
  have t_second : ∀ x : E2, x ≠ x₀ → ∀ i j : Fin 2,
      pd2 i (pcgbPsiG1 H M x₀ j) x = pcgbPsiG2 H M x₀ i j x := by
    intro x hx i j
    have hQ := hQpos x hx
    set N : Matrix (Fin 2) (Fin 2) ℝ := M - pcgbPxMu H M • H with hN
    have hNe : ∀ a c : Fin 2, N a c = M a c - pcgbPxMu H M * H a c := fun a c => by
      simp [hN]
    have hn := (t_hasQ M x₀ x).sub ((t_hasQ H x₀ x).const_mul (pcgbPxMu H M))
    have hinv := (hasDerivAt_inv hQ.ne').comp_hasFDerivAt x (t_hasQ H x₀ x)
    have hd := ((((t_lin N x₀ x j).mul ((t_hasQ H x₀ x).log hQ.ne')).mul_const ((8 : ℝ)⁻¹)).add
      (((hn.mul (t_lin H x₀ x j)).mul hinv).mul_const ((8 : ℝ)⁻¹)))
    have hd' := hd.congr_of_eventuallyEq (f₁ := pcgbPsiG1 H M x₀ j)
      (Filter.Eventually.of_forall fun z => by
        simp only [pcgbPsiG1, hNe, Function.comp_apply, Pi.add_apply, Pi.mul_apply, Pi.sub_apply]
        ring)
    unfold pd2
    rw [hd'.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, t_evalQ, t_evalL,
      Function.comp_apply, Pi.sub_apply, Pi.mul_apply]
    unfold pcgbPsiG2
    simp only [hNe]
    generalize Real.log (pcgbPxQuad H x₀ x) = lg
    generalize pcgbPxQuad M x₀ x = qm
    generalize hq : pcgbPxQuad H x₀ x = q at hQ ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    fin_cases i <;> fin_cases j <;>
      simp only [Fin.sum_univ_two, Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
      rw [hsH, hsM] <;> field_simp <;> ring
  obtain ⟨hQs, -⟩ := t_iter3 H x₀
  obtain ⟨hQms, -⟩ := t_iter3 M x₀
  have hψ : ContDiffOn ℝ ∞ (pcgbPxPsi H M x₀) {x | x ≠ x₀} := by
    show ContDiffOn ℝ ∞ (fun x => (pcgbPxQuad M x₀ x - pcgbPxMu H M * pcgbPxQuad H x₀ x) *
      Real.log (pcgbPxQuad H x₀ x) / 16) {x | x ≠ x₀}
    exact ((hQms.contDiffOn.sub (contDiffOn_const.mul hQs.contDiffOn)).mul
      (hQs.contDiffOn.log fun y hy => (hQpos y hy).ne')).div_const 16
  obtain ⟨φ, hφdef⟩ : ∃ φ : E2 → ℝ, φ = fun z => pcgbPxPsi H M x₀ (x₀ + z) := ⟨_, rfl⟩
  obtain ⟨A₈, hA₈⟩ : ∃ A₈ : Matrix (Fin 2) (Fin 2) ℝ,
      A₈ = (1 / 8 : ℝ) • (M - pcgbPxMu H M • H) := ⟨_, rfl⟩
  obtain ⟨n₀, hn₀def⟩ : ∃ n₀ : E2 → ℝ, n₀ = fun z => pcgbPxQuad A₈ x₀ (x₀ + z) := ⟨_, rfl⟩
  obtain ⟨hA₈s, hA₈3⟩ := t_iter3 A₈ x₀
  have hshift : ContDiff ℝ ∞ (fun z : E2 => x₀ + z) := contDiff_const.add contDiff_id
  have hφs : ContDiffOn ℝ ∞ φ {z | z ≠ 0} := by
    rw [hφdef]
    refine hψ.comp hshift.contDiffOn ?_
    intro z hz
    simpa using hz
  have hn₀s : ContDiff ℝ ∞ n₀ := by
    rw [hn₀def]
    exact hA₈s.comp hshift
  have hn₀3 : ∀ z : E2, iteratedFDeriv ℝ 3 n₀ z = 0 := by
    intro z
    rw [hn₀def, iteratedFDeriv_comp_add_left]
    exact hA₈3 _
  have hn₀v : ∀ z : E2, n₀ z =
      (pcgbPxQuad M x₀ (x₀ + z) - pcgbPxMu H M * pcgbPxQuad H x₀ (x₀ + z)) / 8 := by
    intro z
    rw [hn₀def, hA₈]
    simp only [pcgbPxQuad, Matrix.smul_apply, Matrix.sub_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  have hQsc : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (t : ℝ) (z : E2),
      pcgbPxQuad A x₀ (x₀ + t • z) = t ^ 2 * pcgbPxQuad A x₀ (x₀ + z) := by
    intro A t z
    simp only [pcgbPxQuad, add_sub_cancel_left, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  have hscale : ∀ t : ℝ, 0 < t → ∀ z : E2,
      φ (t • z) = t ^ 2 * φ z + t ^ 2 * Real.log t * n₀ z := by
    intro t ht z
    rw [hn₀v z, hφdef]
    show pcgbPxPsi H M x₀ (x₀ + t • z) =
      t ^ 2 * pcgbPxPsi H M x₀ (x₀ + z) + t ^ 2 * Real.log t *
        ((pcgbPxQuad M x₀ (x₀ + z) - pcgbPxMu H M * pcgbPxQuad H x₀ (x₀ + z)) / 8)
    unfold pcgbPxPsi
    rw [hQsc H, hQsc M]
    by_cases hz : z = 0
    · subst hz
      have h1 : pcgbPxQuad H x₀ (x₀ + 0) = 0 := by simp [pcgbPxQuad]
      have h2 : pcgbPxQuad M x₀ (x₀ + 0) = 0 := by simp [pcgbPxQuad]
      rw [h1, h2]
      simp
    · have ha := hQpos (x₀ + z) (by simpa using hz)
      have ht2 : t ^ 2 ≠ 0 := by positivity
      rw [Real.log_mul ht2 ha.ne', Real.log_pow]
      push_cast
      ring
  obtain ⟨B, hB0, hBb⟩ := t_bounds φ n₀ hφs hn₀s hn₀3
    (t_scaling φ n₀ hφs hn₀s hscale)
  have hpdcongr : ∀ (i : Fin 2) (x : E2) (f g : E2 → ℝ), f =ᶠ[𝓝 x] g → pd2 i f x = pd2 i g x := by
    intro i x f g h
    unfold pd2
    rw [h.fderiv_eq]
  refine ⟨hψ, B, hB0, fun x h0 _ => ?_⟩
  have hne : x ≠ x₀ := dist_pos.mp h0
  have hz : x - x₀ ≠ 0 := sub_ne_zero.mpr hne
  have hnz : ‖x - x₀‖ = dist x x₀ := (dist_eq_norm x x₀).symm
  have hxz : x₀ + (x - x₀) = x := by abel
  have hiter : ∀ k : ℕ, iteratedFDeriv ℝ k φ (x - x₀) =
      iteratedFDeriv ℝ k (pcgbPxPsi H M x₀) x := by
    intro k
    rw [hφdef, iteratedFDeriv_comp_add_left, hxz]
  obtain ⟨b0, b1, b2, b3⟩ := hBb (x - x₀) hz
  rw [hnz] at b0 b1 b2 b3
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have hpd : ∀ i j : Fin 2, pd2 i (pd2 j (pcgbPxPsi H M x₀)) x = pcgbPsiG2 H M x₀ i j x := by
      intro i j
      rw [← t_second x hne i j]
      apply hpdcongr
      filter_upwards [isOpen_ne.mem_nhds hne] with y hy
      exact t_first y hy j
    rw [← t_trace x hne]
    simp only [hpd]
  · have e : φ (x - x₀) = pcgbPxPsi H M x₀ x := by rw [hφdef]; simp only [hxz]
    rw [e, Real.norm_eq_abs] at b0
    exact b0
  · rw [← norm_iteratedFDeriv_one, hiter 1, norm_iteratedFDeriv_one] at b1
    exact b1
  · rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
    rw [hiter 2] at b2
    exact b2
  · rw [hiter 3] at b3
    exact b3

theorem pcgb_lap2_half_log (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (D : E2 → ℝ) (hD : ContDiffOn ℝ 2 D V) (hpos : ∀ x ∈ V, 0 < D x) :
    ∀ x ∈ V, lap2 h (fun y => (1 / 2 : ℝ) * Real.log (D y)) x =
      lap2 h D x / (2 * D x) -
        (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a D x * pd2 c D x) / (2 * D x ^ 2) :=
by
  intro x hx
  have hVx : V ∈ 𝓝 x := hV.mem_nhds hx
  have hdiff : ∀ y ∈ V, DifferentiableAt ℝ D y := fun y hy =>
    (hD.contDiffAt (hV.mem_nhds hy)).differentiableAt (by norm_num)
  
  have hfirst : ∀ y ∈ V, ∀ j : Fin 2,
      pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y)) y = pd2 j D y * (2 * D y)⁻¹ := by
    intro y hy j
    have hDy : D y ≠ 0 := (hpos y hy).ne'
    have h1 := ((hdiff y hy).hasFDerivAt.log hDy).const_mul (1 / 2 : ℝ)
    show fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y)) y (e2 j) = fderiv ℝ D y (e2 j) * _
    rw [h1.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [mul_inv]
    ring
  have hev : ∀ j : Fin 2, pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y)) =ᶠ[𝓝 x]
      (fun y => pd2 j D y * (2 * D y)⁻¹) :=
    fun j => Filter.eventually_of_mem hVx (fun y hy => hfirst y hy j)
  
  have hC2 : ContDiffAt ℝ 2 D x := hD.contDiffAt hVx
  have hfd : DifferentiableAt ℝ (fderiv ℝ D) x :=
    (hC2.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have hpdj : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j D) x := fun j => by
    show DifferentiableAt ℝ (fun y => fderiv ℝ D y (e2 j)) x
    exact hfd.clm_apply (differentiableAt_const _)
  have hDx : D x ≠ 0 := (hpos x hx).ne'
  have hq0 : (2 * D x) ≠ 0 := mul_ne_zero two_ne_zero hDx
  have hq : HasFDerivAt (fun y => 2 * D y) ((2 : ℝ) • fderiv ℝ D x) x :=
    (hdiff x hx).hasFDerivAt.const_mul 2
  have hr : HasFDerivAt (fun y => (2 * D y)⁻¹)
      ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)) x :=
    (hasDerivAt_inv hq0).comp_hasFDerivAt x hq
  
  have hsecond : ∀ i j : Fin 2, pd2 i (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x =
      pd2 i (pd2 j D) x * (2 * D x)⁻¹ - pd2 j D x * pd2 i D x * (2 * D x ^ 2)⁻¹ := by
    intro i j
    have hprod : HasFDerivAt (fun y => pd2 j D y * (2 * D y)⁻¹)
        (pd2 j D x • ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)) +
          (2 * D x)⁻¹ • fderiv ℝ (pd2 j D) x) x :=
      (hpdj j).hasFDerivAt.mul hr
    have e1 : pd2 i (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x =
        fderiv ℝ (fun y => pd2 j D y * (2 * D y)⁻¹) x (e2 i) := by
      show fderiv ℝ (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x (e2 i) = _
      rw [(hev j).fderiv_eq]
    rw [e1, hprod.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [show fderiv ℝ D x (e2 i) = pd2 i D x from rfl,
      show fderiv ℝ (pd2 j D) x (e2 i) = pd2 i (pd2 j D) x from rfl]
    field_simp
    ring
  unfold lap2
  simp only [hsecond]
  simp only [hfirst x hx]
  simp only [Fin.sum_univ_two]
  field_simp
  ring

theorem pcgb_holder_half_of_grad (F : E2 → ℝ) (x₀ : E2) (K : ℝ) (hK : 0 ≤ K)
    (hd : ∀ x : E2, x ≠ x₀ → DifferentiableAt ℝ F x)
    (hg : ∀ x : E2, x ≠ x₀ → ‖fderiv ℝ F x‖ ≤ K / Real.sqrt (dist x x₀))
    (hv : ∀ x : E2, |F x - F x₀| ≤ K * Real.sqrt (dist x x₀)) :
    ∀ x y : E2, |F x - F y| ≤ 3 * K * dist x y ^ (1 / 2 : ℝ) :=
by
  intro x y
  wlog hxy : dist y x₀ ≤ dist x x₀ generalizing x y
  · have h := this y x (le_of_lt (not_le.mp hxy))
    rw [abs_sub_comm, dist_comm]
    exact h
  rw [← Real.sqrt_eq_rpow]
  have hr0 : 0 ≤ dist x x₀ := dist_nonneg
  have hd0 : 0 ≤ dist x y := dist_nonneg
  have hs0 : 0 ≤ dist y x₀ := dist_nonneg
  have ha0 := Real.sqrt_nonneg (dist x x₀)
  have hb0 := Real.sqrt_nonneg (dist x y)
  have ha := Real.sq_sqrt hr0
  have hb := Real.sq_sqrt hd0
  rcases le_or_gt (4 * dist x x₀) (9 * dist x y) with hA | hB
  · 
    have h1 : |F x - F y| ≤ |F x - F x₀| + |F y - F x₀| := by
      have := abs_sub_le (F x) (F x₀) (F y)
      rwa [abs_sub_comm (F x₀) (F y)] at this
    have h2 := hv x
    have h3 := hv y
    have h4 : Real.sqrt (dist y x₀) ≤ Real.sqrt (dist x x₀) := Real.sqrt_le_sqrt hxy
    have h5 : 2 * Real.sqrt (dist x x₀) ≤ 3 * Real.sqrt (dist x y) := by
      nlinarith [sq_nonneg (2 * Real.sqrt (dist x x₀) - 3 * Real.sqrt (dist x y)),
        mul_nonneg ha0 hb0]
    have h6 : K * (2 * Real.sqrt (dist x x₀)) ≤ K * (3 * Real.sqrt (dist x y)) :=
      mul_le_mul_of_nonneg_left h5 hK
    have h7 : K * Real.sqrt (dist y x₀) ≤ K * Real.sqrt (dist x x₀) :=
      mul_le_mul_of_nonneg_left h4 hK
    nlinarith
  · 
    have hrpos : 0 < dist x x₀ := by linarith
    have hball : ∀ z ∈ Metric.closedBall x (dist x y),
        z ≠ x₀ ∧ dist x x₀ ≤ 4 * dist z x₀ := by
      intro z hz
      rw [Metric.mem_closedBall] at hz
      have ht := dist_triangle x z x₀
      rw [dist_comm x z] at ht
      have h4 : dist x x₀ ≤ 4 * dist z x₀ := by linarith
      refine ⟨?_, h4⟩
      intro hzx
      rw [hzx, dist_self] at h4
      linarith
    have hsr : 0 < Real.sqrt (dist x x₀) := Real.sqrt_pos.mpr hrpos
    have hder : ∀ z ∈ Metric.closedBall x (dist x y), DifferentiableAt ℝ F z :=
      fun z hz => hd z (hball z hz).1
    have hbound : ∀ z ∈ Metric.closedBall x (dist x y),
        ‖fderiv ℝ F z‖ ≤ 2 * K / Real.sqrt (dist x x₀) := by
      intro z hz
      obtain ⟨hz0, hz4⟩ := hball z hz
      have ht : 0 < dist z x₀ := dist_pos.mpr hz0
      have hst : 0 < Real.sqrt (dist z x₀) := Real.sqrt_pos.mpr ht
      have hc := Real.sq_sqrt ht.le
      have h1 : Real.sqrt (dist x x₀) ≤ 2 * Real.sqrt (dist z x₀) := by
        nlinarith [sq_nonneg (Real.sqrt (dist x x₀) - 2 * Real.sqrt (dist z x₀)),
          mul_nonneg ha0 hst.le]
      calc ‖fderiv ℝ F z‖ ≤ K / Real.sqrt (dist z x₀) := hg z hz0
        _ ≤ 2 * K / Real.sqrt (dist x x₀) := by
          rw [div_le_div_iff₀ hst hsr]
          have := mul_le_mul_of_nonneg_left h1 hK
          linarith
    have hyB : y ∈ Metric.closedBall x (dist x y) := by
      rw [Metric.mem_closedBall, dist_comm]
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le hder hbound
      (convex_closedBall x (dist x y)) (Metric.mem_closedBall_self hd0) hyB
    rw [Real.norm_eq_abs, ← dist_eq_norm, dist_comm y x] at hmvt
    have hdr : dist x y ≤ dist x x₀ := by linarith
    have hsq : dist x y ≤ Real.sqrt (dist x y) * Real.sqrt (dist x x₀) := by
      have e1 := Real.mul_self_sqrt hd0
      have e2 := Real.sqrt_le_sqrt hdr
      nlinarith
    have hfin : 2 * K / Real.sqrt (dist x x₀) * dist x y ≤ 2 * K * Real.sqrt (dist x y) := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hsr]
      have := mul_le_mul_of_nonneg_left hsq (by linarith : (0 : ℝ) ≤ 2 * K)
      linarith
    rw [abs_sub_comm]
    have hKb : 0 ≤ K * Real.sqrt (dist x y) := mul_nonneg hK hb0
    linarith

theorem pcgb_px_quad_bounds (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2) :
    ContDiff ℝ ∞ (pcgbPxQuad A x₀) ∧ ∀ y : E2,
      |pcgbPxQuad A x₀ y| ≤ (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) * dist y x₀ ^ 2 ∧
      ‖fderiv ℝ (pcgbPxQuad A x₀) y‖ ≤ 2 * (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) * dist y x₀ ∧
      ‖fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀)) y‖ ≤ 2 * (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) :=
by
  set ℓ : Fin 2 → (E2 →L[ℝ] ℝ) := fun a => EuclideanSpace.proj a with hℓdef
  have hℓv : ∀ (a : Fin 2) (v : E2), ℓ a v = v a := fun a v => rfl
  have hℓn : ∀ a, ‖ℓ a‖ ≤ 1 := fun a =>
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => by
      rw [hℓv, one_mul]; exact PiLp.norm_apply_le v a)
  have hz : ∀ (a : Fin 2) (y : E2), |(y - x₀) a| ≤ dist y x₀ := fun a y => by
    rw [dist_eq_norm, ← Real.norm_eq_abs]; exact PiLp.norm_apply_le _ _
  have hzd : ∀ (a : Fin 2) (y : E2), HasFDerivAt (fun y : E2 => (y - x₀) a) (ℓ a) y := by
    intro a y
    have e : (fun y : E2 => (y - x₀) a) = fun y => ℓ a y - ℓ a x₀ := by
      funext w; exact (ℓ a).map_sub w x₀
    rw [e]; exact ((ℓ a).hasFDerivAt).sub_const _
  have hzc : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := fun a =>
    ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).contDiff).comp (contDiff_id.sub contDiff_const)
  have eQ : pcgbPxQuad A x₀ =
      fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c * ((y - x₀) a * (y - x₀) c) := by
    funext w; simp only [pcgbPxQuad, mul_assoc]
  have hQd : ∀ y, HasFDerivAt (pcgbPxQuad A x₀)
      (∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)) y := by
    intro y
    rw [eQ]
    refine HasFDerivAt.fun_sum (fun a _ => HasFDerivAt.fun_sum (fun c _ => ?_))
    exact ((hzd a y).fun_mul (hzd c y)).const_mul (A a c)
  set H : E2 →L[ℝ] (E2 →L[ℝ] ℝ) := ∑ a : Fin 2, ∑ c : Fin 2,
    A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) with hHdef
  have hfQ : fderiv ℝ (pcgbPxQuad A x₀) =
      fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a) :=
    funext fun y => (hQd y).fderiv
  have hPd : ∀ y, HasFDerivAt
      (fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)) H y := by
    intro y
    refine HasFDerivAt.fun_sum (fun a _ => HasFDerivAt.fun_sum (fun c _ => ?_))
    have h1 : HasFDerivAt (fun y : E2 => (y - x₀) a • ℓ c + (y - x₀) c • ℓ a)
        ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) y :=
      ((hzd a y).smul_const (ℓ c)).add ((hzd c y).smul_const (ℓ a))
    exact h1.const_smul (A a c)
  refine ⟨?_, fun y => ⟨?_, ?_, ?_⟩⟩
  · rw [eQ]
    exact ContDiff.sum (fun a _ => ContDiff.sum (fun c _ =>
      contDiff_const.mul ((hzc a).mul (hzc c))))
  · have key : |pcgbPxQuad A x₀ y| ≤ ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * dist y x₀ ^ 2 := by
      rw [eQ]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun a _ =>
        (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun c _ => ?_))
      rw [abs_mul, abs_mul]
      have h1 := hz a y
      have h2 := hz c y
      have h3 := mul_le_mul h1 h2 (abs_nonneg _) dist_nonneg
      exact mul_le_mul_of_nonneg_left (by nlinarith) (abs_nonneg _)
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring
  · rw [hfQ]
    have key : ‖∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)‖ ≤
        ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * (2 * dist y x₀) := by
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun a _ =>
        (norm_sum_le _ _).trans (Finset.sum_le_sum fun c _ => ?_))
      have t : ‖(y - x₀) a • ℓ c + (y - x₀) c • ℓ a‖ ≤ 2 * dist y x₀ := by
        refine (norm_add_le _ _).trans ?_
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        have k1 := mul_le_mul (hz a y) (hℓn c) (norm_nonneg _) dist_nonneg
        have k2 := mul_le_mul (hz c y) (hℓn a) (norm_nonneg _) dist_nonneg
        linarith
      rw [norm_smul, Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left t (abs_nonneg _)
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring
  · rw [hfQ, (hPd y).fderiv, hHdef]
    have key : ‖∑ a : Fin 2, ∑ c : Fin 2,
        A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a))‖ ≤
        ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * 2 := by
      have hs1 := norm_sum_le (Finset.univ : Finset (Fin 2))
        (fun a : Fin 2 => (∑ c : Fin 2,
          A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) : E2 →L[ℝ] (E2 →L[ℝ] ℝ)))
      refine le_trans hs1 ?_
      refine Finset.sum_le_sum fun a _ => ?_
      have hs2 := norm_sum_le (Finset.univ : Finset (Fin 2))
        (fun c : Fin 2 =>
          (A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) : E2 →L[ℝ] (E2 →L[ℝ] ℝ)))
      refine le_trans hs2 ?_
      refine Finset.sum_le_sum fun c _ => ?_
      have t : ‖(ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)‖ ≤ 2 := by
        have hadd := norm_add_le ((ℓ a).smulRight (ℓ c)) ((ℓ c).smulRight (ℓ a))
        rw [ContinuousLinearMap.norm_smulRight_apply,
          ContinuousLinearMap.norm_smulRight_apply] at hadd
        have k1 := mul_le_one₀ (hℓn a) (norm_nonneg _) (hℓn c)
        have k2 := mul_le_one₀ (hℓn c) (norm_nonneg _) (hℓn a)
        linarith
      have hsm := ContinuousLinearMap.opNorm_smul_le (A a c)
        ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a))
      rw [Real.norm_eq_abs] at hsm
      exact hsm.trans (mul_le_mul_of_nonneg_left t (abs_nonneg _))
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring

theorem pcgb_px_pole_bounds (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1) (D Q : E2 → ℝ)
    (hD : ContDiff ℝ ∞ D) (hQ : ContDiff ℝ ∞ Q) (c₀ l Λ K : ℝ) (hc₀ : 0 < c₀) (hl : 0 < l)
    (hΛ : 0 ≤ Λ) (hK : 0 ≤ K)
    (hyp : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      c₀ * dist x x₀ ^ 2 ≤ D x ∧ l * dist x x₀ ^ 2 ≤ Q x ∧ Q x ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ Q x‖ ≤ Λ * dist x x₀ ∧ ‖fderiv ℝ (fderiv ℝ Q) x‖ ≤ Λ ∧
      |D x - Q x| ≤ K * dist x x₀ ^ 3 ∧
      ‖fderiv ℝ (fun y => D y - Q y) x‖ ≤ K * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => D y - Q y)) x‖ ≤ K * dist x x₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      |(1 / 2 : ℝ) * Real.log (D x) - Real.log (Real.sqrt (Q x))| ≤ C ∧
      ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y))) x‖ ≤ C ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y)))) x‖ ≤
        C / dist x x₀ :=
by
  
  have hDd : Differentiable ℝ D := hD.differentiable (by simp)
  have hQd : Differentiable ℝ Q := hQ.differentiable (by simp)
  have hE : ContDiff ℝ ∞ (fun y => D y - Q y) := hD.sub hQ
  have hP1 : Differentiable ℝ (fderiv ℝ Q) :=
    (hQ.fderiv_right (m := ∞) (by simp)).differentiable (by simp)
  have hR1 : Differentiable ℝ (fderiv ℝ (fun y => D y - Q y)) :=
    (hE.fderiv_right (m := ∞) (by simp)).differentiable (by simp)
  have hDD : ∀ y, fderiv ℝ D y = fderiv ℝ Q y + fderiv ℝ (fun z => D z - Q z) y := by
    intro y
    rw [fderiv_fun_sub (hDd y) (hQd y)]
    abel
  
  have hgrad : ∀ y, 0 < D y → 0 < Q y →
      HasFDerivAt (fun z => (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z))
        (((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y) y := by
    intro y hDy hQy
    have h1 := ((hDd y).hasFDerivAt.log hDy.ne').const_mul (1 / 2 : ℝ)
    have h2 := ((hQd y).hasFDerivAt.log hQy.ne').const_mul (1 / 2 : ℝ)
    have h3 : HasFDerivAt (fun z => (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z))
        ((1 / 2 : ℝ) • ((D y)⁻¹ • fderiv ℝ D y) - (1 / 2 : ℝ) • ((Q y)⁻¹ • fderiv ℝ Q y)) y :=
      h1.sub h2
    refine h3.congr_fderiv ?_
    rw [hDD y]
    module
  have hVo : IsOpen ({y : E2 | 0 < D y} ∩ {y : E2 | 0 < Q y}) :=
    (isOpen_lt continuous_const hD.continuous).inter (isOpen_lt continuous_const hQ.continuous)
  have hFgrad : ∀ y ∈ ({y : E2 | 0 < D y} ∩ {y : E2 | 0 < Q y}),
      HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y)))
        (((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y) y := by
    intro y hy
    refine (hgrad y hy.1 hy.2).congr_of_eventuallyEq ?_
    filter_upwards [hVo.mem_nhds hy] with z hz
    have hz2 : 0 < Q z := hz.2
    show (1 / 2 : ℝ) * Real.log (D z) - Real.log (Real.sqrt (Q z)) =
      (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z)
    rw [Real.log_sqrt hz2.le]
    ring
  
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = K / (2 * c₀ * l) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = 1 / (2 * c₀) := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = K * (2 * Λ + K) / (2 * c₀ ^ 2 * l ^ 2) := ⟨_, rfl⟩
  obtain ⟨Bt, hBt⟩ : ∃ Bt : ℝ, Bt = 1 / (2 * c₀ ^ 2) := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  have hB0 : 0 ≤ B := by rw [hB]; positivity
  have hG0 : 0 ≤ G := by rw [hG]; positivity
  have hBt0 : 0 ≤ Bt := by rw [hBt]; positivity
  
  have key : ∀ s d q : ℝ, 0 < s → s ≤ 1 → c₀ * s ^ 2 ≤ d → l * s ^ 2 ≤ q → q ≤ Λ * s ^ 2 →
      |d - q| ≤ K * s ^ 3 →
      |(1 / 2 : ℝ) * Real.log d - Real.log (Real.sqrt q)| ≤ (K / l + Λ / c₀) / 2 ∧
      s * |(2 * d)⁻¹ - (2 * q)⁻¹| ≤ A ∧ s ^ 2 * (2 * d)⁻¹ ≤ B ∧
      s ^ 3 * |2 * ((2 * q) ^ 2)⁻¹ - 2 * ((2 * d) ^ 2)⁻¹| ≤ G ∧
      s ^ 4 * (2 * ((2 * d) ^ 2)⁻¹) ≤ Bt := by
    intro s d q hs hs1 hd hq1 hq2 hdq
    have hs2 : 0 < s ^ 2 := by positivity
    have hd0 : 0 < d := lt_of_lt_of_le (by positivity) hd
    have hq0 : 0 < q := lt_of_lt_of_le (by positivity) hq1
    have hd0' : d ≠ 0 := hd0.ne'
    have hq0' : q ≠ 0 := hq0.ne'
    have hs32 : s ^ 3 ≤ s ^ 2 := by
      calc s ^ 3 = s ^ 2 * s := by ring
        _ ≤ s ^ 2 := mul_le_of_le_one_right hs2.le hs1
    have hdq' : d - q ≤ K * s ^ 3 := le_trans (le_abs_self _) hdq
    have hqd : |q - d| ≤ K * s ^ 3 := by rw [abs_sub_comm]; exact hdq
    have hdqprod : c₀ * s ^ 2 * (l * s ^ 2) ≤ d * q := mul_le_mul hd hq1 (by positivity) hd0.le
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [Real.log_sqrt hq0.le]
      have hup : Real.log d - Real.log q ≤ K / l := by
        rw [← Real.log_div hd0' hq0']
        refine le_trans (Real.log_le_sub_one_of_pos (div_pos hd0 hq0)) ?_
        rw [div_sub_one hq0', div_le_div_iff₀ hq0 hl]
        have e1 : (d - q) * l ≤ K * s ^ 3 * l := mul_le_mul_of_nonneg_right hdq' hl.le
        have e2 : K * l * s ^ 3 ≤ K * l * s ^ 2 := mul_le_mul_of_nonneg_left hs32 (by positivity)
        have e3 : K * (l * s ^ 2) ≤ K * q := mul_le_mul_of_nonneg_left hq1 hK
        linarith
      have hlo : Real.log q - Real.log d ≤ Λ / c₀ := by
        rw [← Real.log_div hq0' hd0']
        refine le_trans (Real.log_le_sub_one_of_pos (div_pos hq0 hd0)) ?_
        have : q / d ≤ Λ / c₀ := by
          rw [div_le_div_iff₀ hd0 hc₀]
          have e1 : q * c₀ ≤ Λ * s ^ 2 * c₀ := mul_le_mul_of_nonneg_right hq2 hc₀.le
          have e2 : Λ * (c₀ * s ^ 2) ≤ Λ * d := mul_le_mul_of_nonneg_left hd hΛ
          linarith
        linarith
      have hKl : 0 ≤ K / l := by positivity
      have hΛc : 0 ≤ Λ / c₀ := by positivity
      rw [abs_le]
      constructor <;> linarith
    · rw [show (2 * d)⁻¹ - (2 * q)⁻¹ = (q - d) / (2 * d * q) by field_simp, abs_div,
        abs_of_pos (by positivity : (0:ℝ) < 2 * d * q), hA, ← mul_div_assoc,
