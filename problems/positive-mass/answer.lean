by
  classical
  
  have hImem : ∀ (S : Set M) (y : E3), y ∈ chartAt E3 q '' (S ∩ (chartAt E3 q).source) →
      ∃ p, p ∈ S ∧ p ∈ (chartAt E3 q).source ∧ chartAt E3 q p = y ∧
