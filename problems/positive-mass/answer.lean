      rfl
    have h2 : mfderiv 𝓘(ℝ, E2) 𝓘(ℝ, E3) ((chartAt E3 z₂).symm ∘ (F₂ ∘ τ)) x v =
        L₂ (fderiv ℝ F₂ (τ x) (fderiv ℝ τ x v)) := by
      rw [mfderiv_comp_apply x hd₂ (hF₂.comp x hτ).mdifferentiableAt, mfderiv_eq_fderiv,
        fderiv_comp x hF₂ hτ]
      rfl
    rw [← h1, ← h2, hm]
    rfl
  
  have hs3 : ∀ u w : E2,
      g.g ((chartAt E3 z₂).symm (F₂ (τ x))) (L₂ (fderiv ℝ F₂ (τ x) u))
          (L₂ (fderiv ℝ F₂ (τ x) w)) =
        ∑ c : Fin 2, ∑ d : Fin 2, u c *
          g.g ((chartAt E3 z₂).symm (F₂ (τ x))) (L₂ (fderiv ℝ F₂ (τ x) (e2 c)))
            (L₂ (fderiv ℝ F₂ (τ x) (e2 d))) * w d := by
    intro u w
    conv_lhs => rw [hexp2 u, hexp2 w]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Finset.mul_sum]
    first
      | (refine Finset.sum_congr rfl (fun c _ => Finset.sum_congr rfl (fun d _ => ?_)); ring1)
      | (rw [Finset.sum_comm]
         refine Finset.sum_congr rfl (fun c _ => Finset.sum_congr rfl (fun d _ => ?_)); ring1)
  
  intro a b
  have hR : ∀ c d : Fin 2, pullMetric2 (g.coeff (chartAt E3 z₂).symm) F₂ (τ x) c d =
      g.g ((chartAt E3 z₂).symm (F₂ (τ x))) (L₂ (fderiv ℝ F₂ (τ x) (e2 c)))
        (L₂ (fderiv ℝ F₂ (τ x) (e2 d))) := fun c d => hs1 _ F₂ (τ x) c d
  have key : g.g ((chartAt E3 z₁).symm (F₁ x)) (L₁ (fderiv ℝ F₁ x (e2 a)))
      (L₁ (fderiv ℝ F₁ x (e2 b))) =
      ∑ c : Fin 2, ∑ d : Fin 2,
        fderiv ℝ τ x (e2 a) c * pullMetric2 (g.coeff (chartAt E3 z₂).symm) F₂ (τ x) c d *
          fderiv ℝ τ x (e2 b) d := by
    rw [hchain, hchain, hp, hs3]
    simp only [hR]
  rw [hs1 _ F₁ x a b]
  exact key

theorem slab_graph_param_regular [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (z : M) (W : Set E2) (hW : IsOpen W)
    (a : ℝ) (v : ℝ → E2 → ℝ)
    (hv : ContDiffOn ℝ ∞ (fun p : ℝ × E2 => v p.1 p.2) (Set.Ioo (-a) a ×ˢ W))
    (hsrc : ∀ t ∈ Set.Ioo (-a) a, ∀ x ∈ W, hpLift (v t x) x ∈ Φ.source ∧
      Φ (hpLift (v t x) x) ∈ (chartAt E3 z).source) :
    ContDiffOn ℝ ∞ (fun p : ℝ × E2 => chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2)))
      (Set.Ioo (-a) a ×ˢ W) ∧
    (∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun p : ℝ × E2 => pullMetric2 (g.coeff (chartAt E3 z).symm)
      (fun x => chartAt E3 z (Φ (hpLift (v p.1 x) x))) p.2 c d) (Set.Ioo (-a) a ×ˢ W)) ∧
    (∀ t ∈ Set.Ioo (-a) a, ∀ x ∈ W,
      chartAt E3 z (Φ (hpLift (v t x) x)) ∈ (chartAt E3 z).target ∧
      DifferentiableAt ℝ (fun x' => chartAt E3 z (Φ (hpLift (v t x') x'))) x ∧
      Function.Injective (fderiv ℝ (fun x' => chartAt E3 z (Φ (hpLift (v t x') x'))) x)) :=
by
  have hD : IsOpen (Set.Ioo (-a) a ×ˢ W) := isOpen_Ioo.prod hW
  
  have hOo : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source) :=
    Φ.contMDiffOn.continuousOn.isOpen_inter_preimage Φ.open_source (chartAt E3 z).open_source
  have hH : ContDiffOn ℝ ∞ (fun y => chartAt E3 z (Φ y)) (Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => chartAt E3 z (Φ y))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source) :=
      (contMDiffOn_chart (x := z)).comp (Φ.contMDiffOn.mono Set.inter_subset_left)
        (fun y hy => hy.2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  have hinv : ∀ y ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source,
      Φ.symm ((chartAt E3 z).symm (chartAt E3 z (Φ y))) = y := by
    intro y hy
    rw [(chartAt E3 z).left_inv hy.2]
    exact Φ.toPartialEquiv.left_inv hy.1
  have hQd : ∀ y ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source,
      DifferentiableAt ℝ (fun q => Φ.symm ((chartAt E3 z).symm q)) (chartAt E3 z (Φ y)) := by
    intro y hy
    have hTo : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' Φ.target) :=
      (chartAt E3 z).isOpen_inter_preimage_symm Φ.open_target
    have hq : chartAt E3 z (Φ y) ∈ (chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' Φ.target := by
      refine ⟨(chartAt E3 z).map_source hy.2, ?_⟩
      show (chartAt E3 z).symm (chartAt E3 z (Φ y)) ∈ Φ.target
      rw [(chartAt E3 z).left_inv hy.2]
      exact Φ.toPartialEquiv.map_source hy.1
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun q => Φ.symm ((chartAt E3 z).symm q))
        ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' Φ.target) :=
      Φ.symm.contMDiffOn.comp ((contMDiffOn_chart_symm (x := z)).mono Set.inter_subset_left)
        (fun q hq => hq.2)
    have h2 := contMDiffOn_iff_contDiffOn.mp h1
    exact (h2.differentiableOn (by simp)).differentiableAt (hTo.mem_nhds hq)
  
  have hPL : ∀ (s : ℝ) (x : E2), hpProj (hpLift s x) = x := by
    intro s x; ext i; fin_cases i <;> simp [hpLift, hpProj, cylPt, e, EuclideanSpace.single_apply]
  have hPeq : hpProj = fun z : E3 => (z 1) • e2 0 + (z 2) • e2 1 := by
    funext z; ext i; fin_cases i <;> simp [hpProj, e2, EuclideanSpace.single_apply]
  have hPdiff : Differentiable ℝ hpProj := by rw [hPeq]; fun_prop
  have hL : ContDiffOn ℝ ∞ (fun p : ℝ × E2 => hpLift (v p.1 p.2) p.2) (Set.Ioo (-a) a ×ˢ W) := by
    have hΛ : ContDiff ℝ ∞ (fun q : ℝ × E2 => q.1 • e 0 + (q.2 0) • e 1 + (q.2 1) • e 2) := by
      fun_prop
    have hin : ContDiffOn ℝ ∞ (fun p : ℝ × E2 => (v p.1 p.2, p.2)) (Set.Ioo (-a) a ×ˢ W) :=
      hv.prodMk contDiffOn_snd
    exact hΛ.comp_contDiffOn hin
  have hstar : ∀ p ∈ Set.Ioo (-a) a ×ˢ W,
      hpLift (v p.1 p.2) p.2 ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 z).source :=
    fun p hp => hsrc p.1 hp.1 p.2 hp.2
  have hF1 : ContDiffOn ℝ ∞ (fun p : ℝ × E2 => chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2)))
      (Set.Ioo (-a) a ×ˢ W) := hH.comp hL hstar
  have key : ∀ p ∈ Set.Ioo (-a) a ×ˢ W,
      ContDiffAt ℝ ∞ (fun p : ℝ × E2 => chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2))) p :=
    fun p hp => hF1.contDiffAt (hD.mem_nhds hp)
  refine ⟨hF1, ?_, ?_⟩
  · intro c d p hp
    apply ContDiffAt.contDiffWithinAt
    have hfd : ContDiffAt ℝ ∞ (fun q : ℝ × E2 =>
        fderiv ℝ (fun x => chartAt E3 z (Φ (hpLift (v q.1 x) x))) q.2) p := by
      refine ContDiffAt.fderiv
        (f := fun (q : ℝ × E2) (x : E2) => chartAt E3 z (Φ (hpLift (v q.1 x) x)))
        (g := Prod.snd) (x₀ := p) (m := ∞) (n := ∞) ?_ contDiffAt_snd ?_
      · have h2 : ContDiffAt ℝ ∞ (fun r : (ℝ × E2) × E2 => (r.1.1, r.2)) (p, p.2) := by
          fun_prop
        have h3 : ContDiffAt ℝ ∞
            ((fun p : ℝ × E2 => chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2))) ∘
              (fun r : (ℝ × E2) × E2 => (r.1.1, r.2))) (p, p.2) :=
          ContDiffAt.comp (p, p.2) (key p hp) h2
        exact h3
      · simp
    have hA : ∀ (c' : Fin 2) (k : Fin 3), ContDiffAt ℝ ∞ (fun q : ℝ × E2 =>
        (fderiv ℝ (fun x => chartAt E3 z (Φ (hpLift (v q.1 x) x))) q.2 (e2 c')) k) p := by
      intro c' k
      have h1 := hfd.clm_apply (contDiffAt_const (c := e2 c'))
      exact (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).contDiff.contDiffAt.comp p h1
    have hB : ∀ k l : Fin 3, ContDiffAt ℝ ∞ (fun q : ℝ × E2 =>
        g.coeff (chartAt E3 z).symm (chartAt E3 z (Φ (hpLift (v q.1 q.2) q.2))) k l) p := by
      intro k l
      have hmem : chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2)) ∈ (chartAt E3 z).target :=
        (chartAt E3 z).map_source (hstar p hp).2
      exact ((g.smooth z k l).contDiffAt ((chartAt E3 z).open_target.mem_nhds hmem)).comp p
        (key p hp)
    simp only [pullMetric2]
    apply ContDiffAt.sum
    intro k _
    apply ContDiffAt.sum
    intro l _
    exact ((hA c k).mul (hB k l)).mul (hA d l)
  · intro t ht x hx
    have hy := hsrc t ht x hx
    have hfc : ContDiffAt ℝ ∞ (fun x' => chartAt E3 z (Φ (hpLift (v t x') x'))) x := by
      have h2 : ContDiffAt ℝ ∞ (fun x' : E2 => (t, x')) x := by fun_prop
      have h3 : ContDiffAt ℝ ∞
          ((fun p : ℝ × E2 => chartAt E3 z (Φ (hpLift (v p.1 p.2) p.2))) ∘
            (fun x' : E2 => (t, x'))) x :=
        ContDiffAt.comp x (key (t, x) ⟨ht, hx⟩) h2
      exact h3
    have hfx : DifferentiableAt ℝ (fun x' => chartAt E3 z (Φ (hpLift (v t x') x'))) x :=
      hfc.differentiableAt (by simp)
    refine ⟨(chartAt E3 z).map_source hy.2, hfx, ?_⟩
    have hQ : DifferentiableAt ℝ (fun q => hpProj (Φ.symm ((chartAt E3 z).symm q)))
        (chartAt E3 z (Φ (hpLift (v t x) x))) :=
      (hPdiff _).comp _ (hQd _ hy)
    have hev : ((fun q => hpProj (Φ.symm ((chartAt E3 z).symm q))) ∘
        (fun x' => chartAt E3 z (Φ (hpLift (v t x') x')))) =ᶠ[𝓝 x] id := by
      filter_upwards [hW.mem_nhds hx] with x' hx'
      show hpProj (Φ.symm ((chartAt E3 z).symm (chartAt E3 z (Φ (hpLift (v t x') x'))))) = x'
      rw [hinv _ (hsrc t ht x' hx'), hPL]
    have hcomp := fderiv_comp x hQ hfx
    have hid : fderiv ℝ ((fun q => hpProj (Φ.symm ((chartAt E3 z).symm q))) ∘
        (fun x' => chartAt E3 z (Φ (hpLift (v t x') x')))) x = ContinuousLinearMap.id ℝ E2 := by
      rw [hev.fderiv_eq, fderiv_id]
    have hli : Function.LeftInverse
        (fderiv ℝ (fun q => hpProj (Φ.symm ((chartAt E3 z).symm q)))
          (chartAt E3 z (Φ (hpLift (v t x) x))))
        (fderiv ℝ (fun x' => chartAt E3 z (Φ (hpLift (v t x') x'))) x) := by
      intro ξ
      have h := congrArg (fun L : E2 →L[ℝ] E2 => L ξ) (hcomp.symm.trans hid)
      simpa using h
    exact hli.injective

theorem slab_atlas_of_local_charts [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (φ : M → ℝ) (S : Set M) (Ψ : ℝ → M → M) (s₁ : ℝ)
    (hs₁ : 0 < s₁) (hS : IsCompact S)
    (hloc : ∀ ℓ ∈ S, collarSlabChartAt g U φ S Ψ s₁ ℓ) :
    ∃ (P : EigPatchedSurface M S) (z : Fin P.n → M)
      (Φ : Fin P.n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞),
      (∀ j, ∀ s ∈ Set.Ioo (-s₁) s₁, ∀ x ∈ P.W j, hpLift s x ∈ (Φ j).source ∧
        Φ j (hpLift s x) = Ψ s (P.param j x) ∧ Ψ s (P.param j x) ∈ (chartAt E3 (z j)).source) ∧
      (∀ j, ∀ x ∈ P.W j, ∀ (V : Set M) (f : M → ℝ), IsOpen V → Ψ 0 (P.param j x) ∈ V →
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) →
        V ∩ frontier U = V ∩ f ⁻¹' {0} →
        Real.sqrt (g.gradInner f f (Ψ 0 (P.param j x))) * φ (Ψ 0 (P.param j x)) = 1 →
        |partialDeriv 0 (fun y => f (Φ j y)) (hpLift 0 x)| = 1) :=
by
  have h0 : (0:ℝ) ∈ Set.Ioo (-s₁) s₁ := ⟨by linarith, hs₁⟩
  
  have hPL : ∀ (t : ℝ) (y : E2), hpProj (hpLift t y) = y := by
    intro t y
    ext i
    fin_cases i <;> simp [hpProj, hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hLs : ContDiff ℝ ∞ (fun y : E2 => hpLift 0 y) := by
    unfold hpLift cylPt
    have h1 : ContDiff ℝ ∞ (fun y : E2 => y 0) :=
      (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).contDiff
    have h2 : ContDiff ℝ ∞ (fun y : E2 => y 1) :=
      (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).contDiff
    exact (contDiff_const.add (h1.smul contDiff_const)).add (h2.smul contDiff_const)
  have hPs : ContDiff ℝ ∞ hpProj := by
    unfold hpProj
    have h1 : ContDiff ℝ ∞ (fun z : E3 => z 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    have h2 : ContDiff ℝ ∞ (fun z : E3 => z 2) :=
      (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    have h3 : ContDiff ℝ ∞ (fun z : E3 => (![z 1, z 2] : Fin 2 → ℝ)) := by
      rw [contDiff_pi]
      intro i
      fin_cases i
      · simpa using h1
      · simpa using h2
    exact (EuclideanSpace.equiv (Fin 2) ℝ).symm.contDiff.comp h3
  
  have trans : ∀ (W₁ W₂ : Set E2) (O₂ : Set M) (pm₁ pm₂ : E2 → M) (pj₂ : M → E2)
      (Φ₁ Φ₂ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞),
      IsOpen W₁ → IsOpen O₂ → ContinuousOn pm₁ W₁ → (∀ x ∈ W₁, pm₁ x ∈ S) →
      pm₂ '' W₂ = O₂ ∩ S → (∀ x ∈ W₂, pj₂ (pm₂ x) = x) →
      (∀ x ∈ W₁, hpLift 0 x ∈ Φ₁.source ∧ Φ₁ (hpLift 0 x) = Ψ 0 (pm₁ x)) →
      (∀ x ∈ W₂, hpLift 0 x ∈ Φ₂.source ∧ Φ₂ (hpLift 0 x) = Ψ 0 (pm₂ x)) →
      IsOpen (W₁ ∩ pm₁ ⁻¹' O₂) ∧
      ∀ x ∈ W₁ ∩ pm₁ ⁻¹' O₂, pj₂ (pm₁ x) ∈ W₂ ∧ pm₂ (pj₂ (pm₁ x)) = pm₁ x ∧
        ContDiffAt ℝ ∞ (fun x' => pj₂ (pm₁ x')) x := by
    intro W₁ W₂ O₂ pm₁ pm₂ pj₂ Φ₁ Φ₂ hW₁ hO₂ hpm₁ hpm₁S himg₂ hpj₂ hΦ₁ hΦ₂
    have hD : IsOpen (W₁ ∩ pm₁ ⁻¹' O₂) := hpm₁.isOpen_inter_preimage hW₁ hO₂
    have hpt : ∀ x ∈ W₁ ∩ pm₁ ⁻¹' O₂, ∃ x'' ∈ W₂, pm₂ x'' = pm₁ x := by
      intro x hx
      have hmem : pm₁ x ∈ pm₂ '' W₂ := by
        rw [himg₂]
        exact ⟨hx.2, hpm₁S x hx.1⟩
      obtain ⟨x'', hx'', heq⟩ := hmem
      exact ⟨x'', hx'', heq⟩
    have hT : ∀ x ∈ W₁ ∩ pm₁ ⁻¹' O₂, Φ₁ (hpLift 0 x) ∈ Φ₂.target ∧
        hpProj (Φ₂.invFun (Φ₁ (hpLift 0 x))) = pj₂ (pm₁ x) := by
      intro x hx
      obtain ⟨x'', hx'', heq⟩ := hpt x hx
      have e1 : Φ₁ (hpLift 0 x) = Φ₂ (hpLift 0 x'') := by
        rw [(hΦ₁ x hx.1).2, (hΦ₂ x'' hx'').2, heq]
      have e2 : Φ₂.invFun (Φ₂ (hpLift 0 x'')) = hpLift 0 x'' :=
        Φ₂.toPartialEquiv.left_inv' (hΦ₂ x'' hx'').1
      refine ⟨?_, ?_⟩
      · rw [e1]
        exact Φ₂.toPartialEquiv.map_source (hΦ₂ x'' hx'').1
      · rw [e1, e2, hPL, ← heq, hpj₂ x'' hx'']
    have hTs : ContDiffOn ℝ ∞ (fun x' => hpProj (Φ₂.invFun (Φ₁ (hpLift 0 x'))))
        (W₁ ∩ pm₁ ⁻¹' O₂) := by
      have a1 : ContMDiffOn 𝓘(ℝ, E2) 𝓘(ℝ, E3) ∞ (fun y : E2 => hpLift 0 y)
          (W₁ ∩ pm₁ ⁻¹' O₂) := hLs.contMDiff.contMDiffOn
      have a2 := Φ₁.contMDiffOn_toFun.comp a1 (fun x hx => (hΦ₁ x hx.1).1)
      have a3 := Φ₂.contMDiffOn_invFun.comp a2 (fun x hx => (hT x hx).1)
      have a4 := (hPs.contMDiff.contMDiffOn (s := Set.univ)).comp a3
        (fun x _ => Set.mem_univ _)
      exact contMDiffOn_iff_contDiffOn.mp a4
    refine ⟨hD, fun x hx => ?_⟩
    obtain ⟨x'', hx'', heq⟩ := hpt x hx
    have hpjx : pj₂ (pm₁ x) = x'' := by rw [← heq, hpj₂ x'' hx'']
    refine ⟨by rw [hpjx]; exact hx'', by rw [hpjx]; exact heq, ?_⟩
    have hca := hTs.contDiffAt (hD.mem_nhds hx)
    refine hca.congr_of_eventuallyEq ?_
    filter_upwards [hD.mem_nhds hx] with x' hx'
    exact ((hT x' hx').2).symm
  
  have metric : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (z : M) (W : Set E2),
      IsOpen W →
      (∀ x ∈ W, hpLift 0 x ∈ Φ.source ∧ Φ (hpLift 0 x) ∈ (chartAt E3 z).source) →
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => pullMetric2 (g.coeff (chartAt E3 z).symm)
          (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x a b) W) ∧
      (∀ x ∈ W, (pullMetric2 (g.coeff (chartAt E3 z).symm)
          (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x).PosDef) ∧
      (∀ x ∈ W, chartAt E3 z (Φ (hpLift 0 x)) ∈ (chartAt E3 z).target ∧
          DifferentiableAt ℝ (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x) := by
    intro Φ z W hW hsrc
    obtain ⟨-, hsm, hreg⟩ := slab_graph_param_regular g Φ z W hW 1 (fun _ _ => 0)
      contDiffOn_const (fun t _ x hx => hsrc x hx)
    have hι : ContDiff ℝ ∞ (fun x : E2 => ((0:ℝ), x)) := contDiff_const.prodMk contDiff_id
    have h01 : (0:ℝ) ∈ Set.Ioo (-1) 1 := ⟨by norm_num, by norm_num⟩
    refine ⟨fun a b => (hsm a b).comp hι.contDiffOn (fun x hx => ⟨h01, hx⟩), ?_, ?_⟩
    · intro x hx
      obtain ⟨htgt, -, hinj⟩ := hreg 0 h01 x hx
      have hinj' : Function.Injective
          (fderiv ℝ (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x) := hinj
      have htgt' : chartAt E3 z (Φ (hpLift 0 x)) ∈ (chartAt E3 z).target := htgt
      have hG := coeff_chart_symm_posDef g z _ htgt'
      set D := fderiv ℝ (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x with hD
      let A : Matrix (Fin 3) (Fin 2) ℝ := Matrix.of fun k i => (D (e2 i)) k
      have hAinj : Function.Injective A.mulVec := by
        intro v w hvw
        have key : ∀ u : Fin 2 → ℝ, A.mulVec u = fun k => (D (u 0 • e2 0 + u 1 • e2 1)) k := by
          intro u
          funext k
          simp [A, Matrix.mulVec, dotProduct, Fin.sum_univ_two, map_add, map_smul, mul_comm]
        rw [key v, key w] at hvw
        have h2 : D (v 0 • e2 0 + v 1 • e2 1) = D (w 0 • e2 0 + w 1 • e2 1) := by
          ext k
          exact congrFun hvw k
        have h3 := hinj' h2
        funext i
        fin_cases i
        · have := congrArg (fun u : E2 => u 0) h3
          simpa [EuclideanSpace.single_apply] using this
        · have := congrArg (fun u : E2 => u 1) h3
          simpa [EuclideanSpace.single_apply] using this
      have hPD := hG.conjTranspose_mul_mul_same hAinj
      have heq : pullMetric2 (g.coeff (chartAt E3 z).symm)
          (fun x' => chartAt E3 z (Φ (hpLift 0 x'))) x =
          A.conjTranspose * (g.coeff (chartAt E3 z).symm (chartAt E3 z (Φ (hpLift 0 x)))) * A := by
        ext i j
        simp only [pullMetric2, Matrix.mul_apply, Matrix.conjTranspose_apply, A, Matrix.of_apply,
          star_trivial, Finset.sum_mul]
        rw [Finset.sum_comm]
      rw [heq]
      exact hPD
    · intro x hx
      obtain ⟨htgt, hdiff, -⟩ := hreg 0 h01 x hx
      exact ⟨htgt, hdiff⟩
  
  have compat : ∀ (z₁ z₂ : M) (Φ₁ Φ₂ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
      (W₁ W₂ : Set E2) (pm₁ pm₂ : E2 → M) (τ : E2 → E2),
      IsOpen W₁ → IsOpen W₂ →
      (∀ x ∈ W₁, hpLift 0 x ∈ Φ₁.source ∧ Φ₁ (hpLift 0 x) = Ψ 0 (pm₁ x) ∧
        Ψ 0 (pm₁ x) ∈ (chartAt E3 z₁).source) →
      (∀ x ∈ W₂, hpLift 0 x ∈ Φ₂.source ∧ Φ₂ (hpLift 0 x) = Ψ 0 (pm₂ x) ∧
        Ψ 0 (pm₂ x) ∈ (chartAt E3 z₂).source) →
      ∀ x ∈ W₁, DifferentiableAt ℝ τ x →
      (∀ᶠ x' in 𝓝 x, x' ∈ W₁ ∧ τ x' ∈ W₂ ∧ pm₂ (τ x') = pm₁ x') →
      ∀ a b : Fin 2,
        pullMetric2 (g.coeff (chartAt E3 z₁).symm)
          (fun x' => chartAt E3 z₁ (Φ₁ (hpLift 0 x'))) x a b =
        ∑ c : Fin 2, ∑ d : Fin 2,
          fderiv ℝ τ x (e2 a) c *
            pullMetric2 (g.coeff (chartAt E3 z₂).symm)
              (fun x' => chartAt E3 z₂ (Φ₂ (hpLift 0 x'))) (τ x) c d *
            fderiv ℝ τ x (e2 b) d := by
    intro z₁ z₂ Φ₁ Φ₂ W₁ W₂ pm₁ pm₂ τ hW₁ hW₂ hΦ₁ hΦ₂ x hx hτ hloc
    have hτx : τ x ∈ W₂ := hloc.self_of_nhds.2.1
    have m1 := (metric Φ₁ z₁ W₁ hW₁ (fun y hy => ⟨(hΦ₁ y hy).1, by
      rw [(hΦ₁ y hy).2.1]; exact (hΦ₁ y hy).2.2⟩)).2.2 x hx
    have m2 := (metric Φ₂ z₂ W₂ hW₂ (fun y hy => ⟨(hΦ₂ y hy).1, by
      rw [(hΦ₂ y hy).2.1]; exact (hΦ₂ y hy).2.2⟩)).2.2 (τ x) hτx
    refine pullMetric2_reparam_compat g z₁ z₂ _ _ τ x m1.2 m2.2 hτ m1.1 m2.1 ?_
    filter_upwards [hloc] with x' hx'
    show (chartAt E3 z₁).symm (chartAt E3 z₁ (Φ₁ (hpLift 0 x'))) =
      (chartAt E3 z₂).symm (chartAt E3 z₂ (Φ₂ (hpLift 0 (τ x'))))
    have s1 : Φ₁ (hpLift 0 x') ∈ (chartAt E3 z₁).source := by
      rw [(hΦ₁ x' hx'.1).2.1]; exact (hΦ₁ x' hx'.1).2.2
    have s2 : Φ₂ (hpLift 0 (τ x')) ∈ (chartAt E3 z₂).source := by
      rw [(hΦ₂ _ hx'.2.1).2.1]; exact (hΦ₂ _ hx'.2.1).2.2
    rw [(chartAt E3 z₁).left_inv s1, (chartAt E3 z₂).left_inv s2,
      (hΦ₁ x' hx'.1).2.1, (hΦ₂ _ hx'.2.1).2.1, hx'.2.2]
  
  unfold collarSlabChartAt at hloc
  choose Wc Oc pmc pjc zc Φc hWo hOo hℓO hpmc hpjc himg hpjpm hslab hlapse using hloc
  obtain ⟨t, ht⟩ := hS.elim_finite_subcover (fun i : S => Oc i.1 i.2) (fun i => hOo i.1 i.2)
    (fun x hx => Set.mem_iUnion.2 ⟨⟨x, hx⟩, hℓO x hx⟩)
  have hpmS : ∀ ℓ (hℓ : ℓ ∈ S), ∀ x ∈ Wc ℓ hℓ, pmc ℓ hℓ x ∈ S := by
    intro ℓ hℓ x hx
    have hmem : pmc ℓ hℓ x ∈ pmc ℓ hℓ '' Wc ℓ hℓ := ⟨x, hx, rfl⟩
    rw [himg ℓ hℓ] at hmem
    exact hmem.2
  have htr : ∀ i k : S, IsOpen (Wc i.1 i.2 ∩ pmc i.1 i.2 ⁻¹' Oc k.1 k.2) ∧
      ∀ x ∈ Wc i.1 i.2 ∩ pmc i.1 i.2 ⁻¹' Oc k.1 k.2,
        pjc k.1 k.2 (pmc i.1 i.2 x) ∈ Wc k.1 k.2 ∧
        pmc k.1 k.2 (pjc k.1 k.2 (pmc i.1 i.2 x)) = pmc i.1 i.2 x ∧
        ContDiffAt ℝ ∞ (fun x' => pjc k.1 k.2 (pmc i.1 i.2 x')) x := fun i k =>
    trans (Wc i.1 i.2) (Wc k.1 k.2) (Oc k.1 k.2) (pmc i.1 i.2) (pmc k.1 k.2) (pjc k.1 k.2)
      (Φc i.1 i.2) (Φc k.1 k.2) (hWo _ _) (hOo _ _) (hpmc _ _) (hpmS _ _) (himg _ _)
      (hpjpm _ _) (fun x hx => ⟨(hslab _ _ 0 h0 x hx).1, (hslab _ _ 0 h0 x hx).2.1⟩)
      (fun x hx => ⟨(hslab _ _ 0 h0 x hx).1, (hslab _ _ 0 h0 x hx).2.1⟩)
  have hmet := fun (i : S) => metric (Φc i.1 i.2) (zc i.1 i.2) (Wc i.1 i.2) (hWo _ _)
    (fun x hx => ⟨(hslab _ _ 0 h0 x hx).1, by
      rw [(hslab _ _ 0 h0 x hx).2.1]; exact (hslab _ _ 0 h0 x hx).2.2⟩)
  let idx : Fin t.card → S := fun j => (t.equivFin.symm j).1
  let P : EigPatchedSurface M S :=
    { n := t.card
      W := fun j => Wc (idx j).1 (idx j).2
      param := fun j => pmc (idx j).1 (idx j).2
      proj := fun j => pjc (idx j).1 (idx j).2
      O := fun j => Oc (idx j).1 (idx j).2
      h := fun j x => pullMetric2 (g.coeff (chartAt E3 (zc (idx j).1 (idx j).2)).symm)
        (fun x' => chartAt E3 (zc (idx j).1 (idx j).2) (Φc (idx j).1 (idx j).2 (hpLift 0 x'))) x
      W_open := fun j => hWo _ _
      O_open := fun j => hOo _ _
      param_cont := fun j => hpmc _ _
      proj_cont := fun j => hpjc _ _
      image_eq := fun j => himg _ _
      proj_param := fun j => hpjpm _ _
      cover := by
        intro x hx
        have hx' := ht hx
        simp only [Set.mem_iUnion] at hx'
        obtain ⟨i, hi, hxi⟩ := hx'
        refine Set.mem_iUnion.2 ⟨t.equivFin ⟨i, hi⟩, ?_⟩
        have e : idx (t.equivFin ⟨i, hi⟩) = i := by simp [idx]
        show x ∈ Oc (idx (t.equivFin ⟨i, hi⟩)).1 (idx (t.equivFin ⟨i, hi⟩)).2
        rw [e]
        exact hxi
      trans_smooth := fun j k x hx => ((htr (idx j) (idx k)).2 x hx).2.2.contDiffWithinAt
      h_smooth := fun j a b => (hmet (idx j)).1 a b
      h_posDef := fun j x hx => (hmet (idx j)).2.1 x hx
      h_compat := by
        intro j k x hx a b
        obtain ⟨hD, hpt⟩ := htr (idx j) (idx k)
        exact compat _ _ _ _ _ _ _ _ _ (hWo _ _) (hWo _ _) (hslab _ _ 0 h0) (hslab _ _ 0 h0)
          x hx.1 ((hpt x hx).2.2.differentiableAt (by simp))
          (Filter.eventually_of_mem (hD.mem_nhds hx)
            (fun x' hx' => ⟨hx'.1, (hpt x' hx').1, (hpt x' hx').2.1⟩)) a b }
  refine ⟨P, fun j => zc (idx j).1 (idx j).2, fun j => Φc (idx j).1 (idx j).2, ?_, ?_⟩
  · intro j s hs x hx
    exact hslab (idx j).1 (idx j).2 s hs x hx
  · intro j x hx
    exact hlapse (idx j).1 (idx j).2 x hx

theorem collar_slab_coordinates [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M)
    (hUo : IsOpen U) (hFc : IsCompact (frontier U)) (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hNc : IsCompact (closure N)) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc c d))
    (hσi : ∀ δ : ℝ, 0 < δ → δ < ε → IsClosed (frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic δ)))
    (hσ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ σ ⁻¹' Set.Iio δ)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (φ lam : M → ℝ)
    (hdata : ∀ p ∈ frontier U, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ frontier U, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
          g.jacobiDeriv f x = lam x / φ x)
    (x₀ p₀ : M) (hx₀ : x₀ ∈ U ∩ N)
    (hp₀C : p₀ ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U)
    (hthin : ∀ O : Set M, IsOpen O →
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ O →
      ∃ δ : ℝ, 0 < δ ∧ δ < ε ∧ connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' Set.Iic δ ⊆ O)
    (hFCpc : IsPreconnected (closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U)) :
    ∃ (S : Set M) (P : EigPatchedSurface M S) (z : Fin P.n → M)
      (Φ : Fin P.n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (Ψ : ℝ → M → M) (s₁ : ℝ),
      0 < s₁ ∧ IsCompact S ∧ S.Nonempty ∧ IsPreconnected S ∧
      (∀ j, ∀ s ∈ Set.Ioo (-s₁) s₁, ∀ x ∈ P.W j, hpLift s x ∈ (Φ j).source ∧
        Φ j (hpLift s x) = Ψ s (P.param j x) ∧ Ψ s (P.param j x) ∈ (chartAt E3 (z j)).source) ∧
      (∀ ℓ ∈ S, Ψ 0 ℓ ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U) ∧
      (∀ p ∈ closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U, ∃ ℓ ∈ S, Ψ 0 ℓ = p) ∧
      (∀ s ∈ Set.Ioo 0 s₁, ∀ ℓ ∈ S, Ψ s ℓ ∈ connectedComponentIn (U ∩ N) x₀) ∧
      (∀ s ∈ Set.Ioo 0 s₁, ∀ s' ∈ Set.Ioo 0 s₁, ∀ ℓ ∈ S, ∀ ℓ' ∈ S,
        Ψ s ℓ = Ψ s' ℓ' → s = s' ∧ ℓ = ℓ') ∧
      (∀ m ∈ Set.Ioo 0 s₁, ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ connectedComponentIn (U ∩ N) x₀,
        σ x ≤ δ → ∃ s ∈ Set.Ioo 0 m, ∃ ℓ ∈ S, Ψ s ℓ = x) ∧
      (∀ s ∈ Set.Ioo (-s₁) s₁, ∀ ℓ ∈ S, s ≠ 0 → Ψ s ℓ ∉ frontier U) ∧
      (∀ j, ∀ x ∈ P.W j, ∀ (V : Set M) (f : M → ℝ), IsOpen V → Ψ 0 (P.param j x) ∈ V →
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) →
        V ∩ frontier U = V ∩ f ⁻¹' {0} →
        Real.sqrt (g.gradInner f f (Ψ 0 (P.param j x))) * φ (Ψ 0 (P.param j x)) = 1 →
        |partialDeriv 0 (fun y => f (Φ j y)) (hpLift 0 x)| = 1) :=
by
  
  have hX : IsOpen (U ∩ N) := hUo.inter hNo
  have hCX : connectedComponentIn (U ∩ N) x₀ ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hx₀C : x₀ ∈ connectedComponentIn (U ∩ N) x₀ := mem_connectedComponentIn hx₀
  have hCcl : ∀ y ∈ closure (connectedComponentIn (U ∩ N) x₀), y ∈ U ∩ N →
      y ∈ connectedComponentIn (U ∩ N) x₀ := by
    intro y hyc hyX
    have hpre : IsPreconnected (insert y (connectedComponentIn (U ∩ N) x₀)) :=
      isPreconnected_connectedComponentIn.subset_closure (Set.subset_insert y _)
        (Set.insert_subset hyc subset_closure)
    have hsub : insert y (connectedComponentIn (U ∩ N) x₀) ⊆ U ∩ N := Set.insert_subset hyX hCX
    exact hpre.subset_connectedComponentIn (Set.mem_insert_of_mem y hx₀C) hsub
      (Set.mem_insert y _)
  have hσc : ContinuousOn σ (U ∩ N) := hσs.continuousOn
  obtain ⟨Θ, hΘX, hΘ0, hΘc⟩ := tau_flow_exists g (U ∩ N) hX σ 0 ε hσs hσr hσb hσp
  have hleaf : ∀ c : ℝ, 0 < c → c < ε →
      IsCompact (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}) ∧
      IsPreconnected (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}) ∧
      (c ≤ σ x₀ → (∃ x ∈ connectedComponentIn (U ∩ N) x₀, σ x < c) →
        (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}).Nonempty) := by
    intro c hc0 hcε
    refine ⟨?_, ?_, ?_⟩
    · 
      have hK : IsCompact (U ∩ N ∩ σ ⁻¹' {c}) := by
        have h := hσp c c hc0 hcε
        rwa [Set.Icc_self] at h
      have heq : connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c} =
          closure (connectedComponentIn (U ∩ N) x₀) ∩ (U ∩ N ∩ σ ⁻¹' {c}) := by
        ext y
        constructor
        · rintro ⟨hyC, hyc⟩
          exact ⟨subset_closure hyC, hCX hyC, hyc⟩
        · rintro ⟨hycl, hyX, hyc⟩
          exact ⟨hCcl y hycl hyX, hyc⟩
      rw [heq]
      exact hK.inter_left isClosed_closure
    · 
      rcases (connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c}).eq_empty_or_nonempty with hS |
        ⟨y₀, hy₀C, hy₀c⟩
      · rw [hS]
        exact isPreconnected_empty
      have hmaps : Set.MapsTo (fun x : M => (x, c - σ x)) (connectedComponentIn (U ∩ N) x₀)
          {p : M × ℝ | p.1 ∈ U ∩ N ∧ 0 < σ p.1 + p.2 ∧ σ p.1 + p.2 < ε} := by
        intro x hx
        refine ⟨hCX hx, ?_, ?_⟩
        · show 0 < σ x + (c - σ x)
          linarith
        · show σ x + (c - σ x) < ε
          linarith
      have hιc : ContinuousOn (fun x : M => (x, c - σ x)) (connectedComponentIn (U ∩ N) x₀) :=
        continuousOn_id.prodMk (continuousOn_const.sub (hσc.mono hCX))
      have hψc : ContinuousOn (fun x : M => Θ x (c - σ x)) (connectedComponentIn (U ∩ N) x₀) :=
        hΘc.comp hιc hmaps
      have himg := isPreconnected_connectedComponentIn.image _ hψc
      have hψX : ∀ x ∈ connectedComponentIn (U ∩ N) x₀,
          Θ x (c - σ x) ∈ U ∩ N ∧ σ (Θ x (c - σ x)) = c := by
        intro x hx
        have h := hΘX x (hCX hx) (c - σ x) (by linarith) (by linarith)
        refine ⟨h.1, ?_⟩
        rw [h.2]
        ring
      have hback : ∀ y ∈ connectedComponentIn (U ∩ N) x₀, σ y = c → Θ y (c - σ y) = y := by
        intro y hy hyc
        rw [hyc, sub_self]
        exact hΘ0 y (hCX hy)
      have hy₀c' : σ y₀ = c := hy₀c
      have hy₀img : y₀ ∈ (fun x : M => Θ x (c - σ x)) '' connectedComponentIn (U ∩ N) x₀ :=
        ⟨y₀, hy₀C, hback y₀ hy₀C hy₀c'⟩
      have himgC : (fun x : M => Θ x (c - σ x)) '' connectedComponentIn (U ∩ N) x₀ ⊆
          connectedComponentIn (U ∩ N) x₀ := by
        have h1 := himg.subset_connectedComponentIn hy₀img
          (by
            rintro _ ⟨x, hx, rfl⟩
            exact (hψX x hx).1)
        rw [← connectedComponentIn_eq hy₀C] at h1
        exact h1
      have heq : (fun x : M => Θ x (c - σ x)) '' connectedComponentIn (U ∩ N) x₀ =
          connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' {c} := by
        apply Set.Subset.antisymm
        · rintro _ ⟨x, hx, rfl⟩
          exact ⟨himgC ⟨x, hx, rfl⟩, (hψX x hx).2⟩
        · rintro y ⟨hyC, hyc⟩
          exact ⟨y, hyC, hback y hyC hyc⟩
      rw [← heq]
      exact himg
    · 
      rintro hcx ⟨x, hxC, hxc⟩
      have hpc : IsPreconnected (σ '' connectedComponentIn (U ∩ N) x₀) :=
        isPreconnected_connectedComponentIn.image _ (hσc.mono hCX)
      obtain ⟨y, hyC, hyc⟩ :=
        hpc.Icc_subset ⟨x, hxC, rfl⟩ ⟨x₀, hx₀C, rfl⟩ ⟨hxc.le, hcx⟩
      exact ⟨y, hyC, hyc⟩
  
  obtain ⟨Ng, hNg1, hNg2, hNg3⟩ := normalized_gradient_smooth g
  
  obtain ⟨nB, B, f, hBcov, hB, hBpos, hBσ, hBsgn⟩ :=
    collar_signed_family g U hUo hFc hfront N ε σ hNo hFN hNc hε hσs hσr hσb hσ0 hgood x₀ hx₀
      hFCpc
  
  obtain ⟨S, Ψ, s₁, hs₁, hSc, hSne, hSpc, hA3, hA3', hA4, hA5, hA6, hA8, hloc⟩ :=
    collar_normal_slab_charts g U hUo hFc hfront N ε σ hNo hFN hNc hε hσs hσr hσb hσp hσi hσ0
      hgood φ lam hdata x₀ p₀ hx₀ hp₀C hthin hFCpc Ng hNg1 hNg2 hNg3 nB B f hBcov hB hBpos hBσ
      hBsgn hleaf
  
  obtain ⟨P, z, Φ, hA2, hA7⟩ := slab_atlas_of_local_charts g U φ S Ψ s₁ hs₁ hSc hloc
  exact ⟨S, P, z, Φ, Ψ, s₁, hs₁, hSc, hSne, hSpc, hA2, hA3, hA3', hA4, hA5, hA6, hA8, hA7⟩

theorem slab_leaf_jacobi_vanishing [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig)
    (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (x₀ : E2) (B : Set E3) (hB : IsOpen B)
    (hBs : B ⊆ Φ.source) (hx₀B : hpLift 0 x₀ ∈ B)
    (V : Set M) (f : M → ℝ) (hVo : IsOpen V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (hdf : ∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) (hVS : V ∩ Sig = V ∩ f ⁻¹' {0})
    (hBV : ∀ y ∈ B, Φ y ∈ V) (hBS : ∀ y ∈ B, (Φ y ∈ Sig ↔ y 0 = 0))
    (hnorm : ∀ y ∈ B, y 0 = 0 → |partialDeriv 0 (fun y' => f (Φ y')) y| = 1)
    (hjac : g.jacobiDeriv f (Φ (hpLift 0 x₀)) = 0) :
    levelMeanCurvCoord (g.coeff Φ) (fun y => y 0) (hpLift 0 x₀) = 0 ∧
    HasDerivAt (fun s => levelMeanCurvCoord (g.coeff Φ) (fun y => y 0) (hpLift s x₀)) 0 0 :=
by
  classical
  have hy₀0 : (hpLift 0 x₀) 0 = 0 := by
    simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hy₀src : hpLift 0 x₀ ∈ Φ.source := hBs hx₀B
  set y₀ := hpLift 0 x₀ with hy₀def
  
  have hLfd : ∀ z : E3, HasFDerivAt (fun y : E3 => y 0)
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) z :=
    fun z => (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).hasFDerivAt
  have hLcd : ContDiff ℝ ∞ (fun y : E3 => y 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
  have he00 : (e 0) 0 = 1 := by simp [e]
  have he10 : (e 1) 0 = 0 := by simp [e, EuclideanSpace.single_apply]
  have he20 : (e 2) 0 = 0 := by simp [e, EuclideanSpace.single_apply]
  have hpL : ∀ j : Fin 3, partialDeriv j (fun y : E3 => y 0) = fun _ => (e j) 0 := by
    intro j
    funext z
    simp only [partialDeriv, (hLfd z).fderiv]
    rfl
  have hdL : ∀ z : E3, fderiv ℝ (fun y : E3 => y 0) z ≠ 0 := by
    intro z h
    have h1 : fderiv ℝ (fun y : E3 => y 0) z (e 0) = 1 := by
      rw [(hLfd z).fderiv]
      exact he00
    rw [h] at h1
    simp at h1
  have hpconst : ∀ (c : ℝ) (i : Fin 3) (y : E3), partialDeriv i (fun _ : E3 => c) y = 0 := by
    intro c i y
    simp [partialDeriv]
  
  set G := g.coeff Φ with hGdef
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) Φ.source :=
    fun i j => coeff_contDiffOn_source g Φ i j
