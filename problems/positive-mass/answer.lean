        measure_closedBall_lt_top.ne, hball _ (abs_nonneg L), hball _ (Real.sqrt_nonneg _),
        sq_abs, Real.sq_sqrt hLs]
      ring
    rw [hvol] at h1'
    exact h1'
  have hlim : Tendsto (fun s : ℝ => max C₀ 0 * (Real.pi * s)) (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    have hc : Continuous (fun s : ℝ => max C₀ 0 * (Real.pi * s)) := by fun_prop
    exact (hc.tendsto' 0 0 (by simp)).mono_left nhdsWithin_le_nhds
  refine squeeze_zero_norm' ?_ hlim
  filter_upwards [Ioo_mem_nhdsGT h14] with s hs
  rw [Real.norm_eq_abs]
  exact key s hs.1 hs.2

theorem collar_band_vanish : ∀ (W U K : Set E2), IsOpen W → IsOpen U → U ⊆ W → IsCompact K →
    K ⊆ W → ∀ (a w e₁ e₂ : E2 → ℝ), ContinuousOn a W → (∀ x ∈ W, x ∉ K → a x = 0) →
    ContDiffOn ℝ ∞ w W → (∀ x ∈ K, w x = 0 → fderiv ℝ w x ≠ 0) → ContinuousOn e₁ W →
    ContinuousOn e₂ U → (∀ x ∈ K, w x = 0 → x ∈ U) → (∀ x ∈ K, w x = 0 → e₁ x + e₂ x = 0) →
    Tendsto (fun s : ℝ => (∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₁ x) +
      ∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₂ x)
      (𝓝[>] (0 : ℝ)) (𝓝 0) :=
by
  intro W U K hW hU hUW hK hKW a w e₁ e₂ ha ha0 hw hwreg he₁ he₂ hZU hedge
  
  have hη0 : ∀ y : ℝ, y ≤ 0 → deriv Real.smoothTransition y = 0 := by
    intro y hy
    rcases lt_or_eq_of_le hy with h | h
    · have hev : Real.smoothTransition =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [Iio_mem_nhds h] with z hz
        exact Real.smoothTransition.zero_of_nonpos (le_of_lt hz)
      rw [hev.deriv_eq, deriv_const]
    · subst h
      have hmin : IsLocalMin Real.smoothTransition 0 := by
        refine Filter.Eventually.of_forall (fun z => ?_)
        rw [Real.smoothTransition.zero_of_nonpos le_rfl]
        exact Real.smoothTransition.nonneg z
      exact hmin.deriv_eq_zero
  have hη1 : ∀ y : ℝ, 1 ≤ y → deriv Real.smoothTransition y = 0 := by
    intro y hy
    rcases lt_or_eq_of_le hy with h | h
    · have hev : Real.smoothTransition =ᶠ[𝓝 y] fun _ => (1 : ℝ) := by
        filter_upwards [Ioi_mem_nhds h] with z hz
        exact Real.smoothTransition.one_of_one_le (le_of_lt hz)
      rw [hev.deriv_eq, deriv_const]
    · subst h
      have hmax : IsLocalMax Real.smoothTransition 1 := by
        refine Filter.Eventually.of_forall (fun z => ?_)
        rw [Real.smoothTransition.one_of_one_le le_rfl]
        exact Real.smoothTransition.le_one z
      exact hmax.deriv_eq_zero
  have hηc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  obtain ⟨Cη, hCη0, hCη⟩ : ∃ C : ℝ, 0 ≤ C ∧ ∀ y : ℝ, |deriv Real.smoothTransition y| ≤ C := by
    obtain ⟨C₀, hC₀⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
      hηc.continuousOn
    refine ⟨max C₀ 0, le_max_right _ _, fun y => ?_⟩
    by_cases h0 : y ≤ 0
    · rw [hη0 y h0, abs_zero]; exact le_max_right _ _
    by_cases h1 : 1 ≤ y
    · rw [hη1 y h1, abs_zero]; exact le_max_right _ _
    push_neg at h0 h1
    have := hC₀ y ⟨h0.le, h1.le⟩
    rw [Real.norm_eq_abs] at this
    exact this.trans (le_max_left _ _)
  
  have hvan : ∀ s : ℝ, 0 < s → ∀ x ∈ W,
      a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) ≠ 0 →
      x ∈ K ∧ 0 < w x ∧ w x < s := by
    intro s hs x hxW hne
    have ha' : a x ≠ 0 := left_ne_zero_of_mul hne
    have hd : deriv Real.smoothTransition (w x / s) ≠ 0 :=
      right_ne_zero_of_mul (right_ne_zero_of_mul hne)
    have hxK : x ∈ K := by
      by_contra hxK
      exact ha' (ha0 x hxW hxK)
    refine ⟨hxK, ?_, ?_⟩
    · by_contra h
      push_neg at h
      apply hd
      apply hη0
      rw [div_le_iff₀ hs, zero_mul]
      exact h
    · by_contra h
      push_neg at h
      apply hd
      apply hη1
      rw [le_div_iff₀ hs, one_mul]
      exact h
  
  have hmargin : ∀ V : Set E2, IsOpen V → (∀ x ∈ K, w x = 0 → x ∈ V) →
      ∃ m : ℝ, 0 < m ∧ ∀ x ∈ K, |w x| < m → x ∈ V := by
    intro V hV hZ
    have hKV : IsCompact (K \ V) := hK.diff hV
    rcases (K \ V).eq_empty_or_nonempty with he | hne
    · refine ⟨1, one_pos, fun x hxK _ => ?_⟩
      by_contra hxV
      have hx : x ∈ K \ V := ⟨hxK, hxV⟩
      rw [he] at hx
      exact hx
    · have hcont : ContinuousOn (fun x => |w x|) (K \ V) :=
        ((hw.continuousOn.mono hKW).mono Set.diff_subset).abs
      obtain ⟨x₀, hx₀, hmin⟩ := hKV.exists_isMinOn hne hcont
      refine ⟨|w x₀|, ?_, fun x hxK hlt => ?_⟩
      · rcases (abs_nonneg (w x₀)).lt_or_eq with h | h
        · exact h
        · exfalso
          exact hx₀.2 (hZ x₀ hx₀.1 (abs_eq_zero.mp h.symm))
      · by_contra hxV
        have h2 := isMinOn_iff.mp hmin x ⟨hxK, hxV⟩
        linarith
  
  obtain ⟨A₀, hA₀⟩ := hK.exists_bound_of_continuousOn (ha.mono hKW)
  have hA0 : 0 ≤ max A₀ 0 := le_max_right _ _
  have hA : ∀ x ∈ K, |a x| ≤ max A₀ 0 := by
    intro x hx
    have := hA₀ x hx
    rw [Real.norm_eq_abs] at this
    exact this.trans (le_max_left _ _)
  obtain ⟨m₂, hm₂, hm₂U⟩ := hmargin U hU hZU
  have hfd : ContinuousOn (fderiv ℝ w) W := hw.continuousOn_fderiv_of_isOpen hW (by simp)
  obtain ⟨Cb₀, sb, hsb, hband⟩ := pcgb_thin_band_volume
    ((W ∩ w ⁻¹' {0}ᶜ) ∪ (W ∩ (fderiv ℝ w) ⁻¹' {0}ᶜ))
    ((hw.continuousOn.isOpen_inter_preimage hW isOpen_compl_singleton).union
      (hfd.isOpen_inter_preimage hW isOpen_compl_singleton))
    K hK
    (fun x hx => by
      by_cases h : w x = 0
      · exact Or.inr ⟨hKW hx, hwreg x hx h⟩
      · exact Or.inl ⟨hKW hx, h⟩)
    w (hw.mono (Set.union_subset Set.inter_subset_left Set.inter_subset_left))
    (fun x hx h0 => by
      rcases hx with ⟨_, hx⟩ | ⟨_, hx⟩
      · exact absurd h0 hx
      · exact hx)
  have hCb0 : 0 ≤ max Cb₀ 0 := le_max_right _ _
  have hCb : ∀ s : ℝ, 0 < s → s < sb →
      volume (K ∩ {x | 0 < w x ∧ w x < s}) ≤ ENNReal.ofReal (max Cb₀ 0 * s) := by
    intro s hs hss
    exact (hband s hs hss).trans
      (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (le_max_left _ _) hs.le))
  
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε' hε'
  have hQ0 : 0 ≤ max A₀ 0 * Cη * max Cb₀ 0 := mul_nonneg (mul_nonneg hA0 hCη0) hCb0
  have hQ1 : 0 < 2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1) := by linarith
  have hε : 0 < ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1)) := div_pos hε' hQ1
  have hεeq : ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1)) *
      (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1)) = ε' := div_mul_cancel₀ _ hQ1.ne'
  
  obtain ⟨mε, hmε, hmεV⟩ := hmargin
    (U ∩ (fun x => e₁ x + e₂ x) ⁻¹' Set.Ioo (-(ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))))
      (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))))
    (((he₁.mono hUW).add he₂).isOpen_inter_preimage hU isOpen_Ioo)
    (fun x hx h0 => by
      refine ⟨hZU x hx h0, ?_⟩
      show e₁ x + e₂ x ∈ Set.Ioo _ _
      rw [hedge x hx h0]
      exact ⟨by linarith, hε⟩)
  refine ⟨min (min m₂ mε) sb, lt_min (lt_min hm₂ hmε) hsb, fun {s} hs hds => ?_⟩
  have hs0 : 0 < s := hs
  rw [Real.dist_eq, sub_zero, abs_of_pos hs0] at hds
  have hsm₂ : s < m₂ := lt_of_lt_of_le hds (le_trans (min_le_left _ _) (min_le_left _ _))
  have hsmε : s < mε := lt_of_lt_of_le hds (le_trans (min_le_left _ _) (min_le_right _ _))
  have hssb : s < sb := lt_of_lt_of_le hds (min_le_right _ _)
  
  have hk : ContinuousOn (fun x => s⁻¹ * deriv Real.smoothTransition (w x / s)) W :=
    continuousOn_const.mul (hηc.comp_continuousOn (hw.continuousOn.div_const s))
  have hI₁ : IntegrableOn
      (fun x => a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₁ x) W := by
    have hc : ContinuousOn
        (fun x => a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₁ x) W :=
      (ha.mul hk).mul he₁
    refine ((hc.mono hKW).integrableOn_compact hK).of_forall_diff_eq_zero hW.measurableSet ?_
    intro x hx
    simp only [ha0 x hx.1 hx.2, zero_mul]
  have hK₂c : IsClosed (K ∩ w ⁻¹' Set.Icc 0 s) :=
    (hw.continuousOn.mono hKW).preimage_isClosed_of_isClosed hK.isClosed isClosed_Icc
  have hK₂ : IsCompact (K ∩ w ⁻¹' Set.Icc 0 s) := hK.of_isClosed_subset hK₂c Set.inter_subset_left
  have hK₂U : K ∩ w ⁻¹' Set.Icc 0 s ⊆ U := by
    intro x hx
    have hx2 : w x ∈ Set.Icc 0 s := hx.2
    apply hm₂U x hx.1
    rw [abs_of_nonneg hx2.1]
    linarith [hx2.2]
  have hI₂ : IntegrableOn
      (fun x => a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₂ x) W := by
    have hc : ContinuousOn
        (fun x => a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₂ x) U :=
      ((ha.mono hUW).mul (hk.mono hUW)).mul he₂
    refine ((hc.mono hK₂U).integrableOn_compact hK₂).of_forall_diff_eq_zero hW.measurableSet ?_
    intro x hx
    by_contra h
    have hv := hvan s hs0 x hx.1 (left_ne_zero_of_mul h)
    exact hx.2 ⟨hv.1, show w x ∈ Set.Icc 0 s from ⟨hv.2.1.le, hv.2.2.le⟩⟩
  have hmerge : (∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₁ x) +
      ∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₂ x =
      ∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * (e₁ x + e₂ x) := by
    rw [← integral_add hI₁ hI₂]
    congr 1
    ext x
    ring
  
  have hBW : K ∩ {x | 0 < w x ∧ w x < s} ⊆ W := fun x hx => hKW hx.1
  have hrestr : ∫ x in W, a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * (e₁ x + e₂ x) =
      ∫ x in K ∩ {x | 0 < w x ∧ w x < s},
        a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * (e₁ x + e₂ x) := by
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hW.measurableSet hBW ?_
    intro x hx
    by_contra h
    exact hx.2 (hvan s hs0 x hx.1 (left_ne_zero_of_mul h))
  have hpt : ∀ x ∈ K ∩ {x | 0 < w x ∧ w x < s},
      ‖a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * (e₁ x + e₂ x)‖ ≤
        max A₀ 0 * (s⁻¹ * Cη) * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) := by
    intro x hx
    have hxK : x ∈ K := hx.1
    have hxb : 0 < w x ∧ w x < s := hx.2
    have h1 : |a x| ≤ max A₀ 0 := hA x hxK
    have hsi : 0 < s⁻¹ := inv_pos.mpr hs0
    have h2 : |s⁻¹ * deriv Real.smoothTransition (w x / s)| ≤ s⁻¹ * Cη := by
      rw [abs_mul, abs_of_pos hsi]
      exact mul_le_mul_of_nonneg_left (hCη _) hsi.le
    have h3 : |e₁ x + e₂ x| ≤ ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1)) := by
      have hV := hmεV x hxK (by rw [abs_of_pos hxb.1]; linarith [hxb.2])
      have hV2 : e₁ x + e₂ x ∈ Set.Ioo (-(ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))))
          (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) := hV.2
      exact (abs_lt.mpr hV2).le
    rw [Real.norm_eq_abs, abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul h1 h2 (abs_nonneg _) hA0) h3 (abs_nonneg _)
      (mul_nonneg hA0 (mul_nonneg hsi.le hCη0))
  have hfin : volume (K ∩ {x | 0 < w x ∧ w x < s}) < ⊤ :=
    lt_of_le_of_lt (measure_mono Set.inter_subset_left) hK.measure_lt_top
  have hbound := norm_setIntegral_le_of_norm_le_const hfin hpt
  have hvol : volume.real (K ∩ {x | 0 < w x ∧ w x < s}) ≤ max Cb₀ 0 * s := by
    rw [measureReal_def]
    exact ENNReal.toReal_le_of_le_ofReal (mul_nonneg hCb0 hs0.le) (hCb s hs0 hssb)
  have hss : s⁻¹ * s = 1 := inv_mul_cancel₀ hs0.ne'
  have hcs0 : 0 ≤ max A₀ 0 * (s⁻¹ * Cη) * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) :=
    mul_nonneg (mul_nonneg hA0 (mul_nonneg (inv_pos.mpr hs0).le hCη0)) hε.le
  have hfinal : max A₀ 0 * (s⁻¹ * Cη) * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) *
      (max Cb₀ 0 * s) =
      max A₀ 0 * Cη * max Cb₀ 0 * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) := by
    calc max A₀ 0 * (s⁻¹ * Cη) * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) *
          (max Cb₀ 0 * s)
        = max A₀ 0 * Cη * max Cb₀ 0 * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) *
            (s⁻¹ * s) := by ring
      _ = max A₀ 0 * Cη * max Cb₀ 0 * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) := by
          rw [hss, mul_one]
  have hle := hbound.trans (mul_le_mul_of_nonneg_left hvol hcs0)
  rw [hfinal] at hle
  have hQε : max A₀ 0 * Cη * max Cb₀ 0 * (ε' / (2 * (max A₀ 0 * Cη * max Cb₀ 0 + 1))) < ε' := by
    nlinarith [mul_nonneg hQ0 hε.le, hεeq, hε]
  rw [dist_zero_right, hmerge, hrestr]
  exact lt_of_le_of_lt hle hQε

theorem sgb_curv_density_regular : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (W : Set E2), IsOpen W →
    (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a b) W) → (∀ y ∈ W, (h y).PosDef) →
    ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W →
    IsOpen {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} ∧
    ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h w x) * sgbLevelCurv2 h w x)
      {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} ∧
    ∀ x ∈ W, fderiv ℝ w x ≠ 0 → 0 < sgbGradSq2 h w x :=
by
  intro h W hW hh hpd w hw
  have hUW : {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} ⊆ W := fun x hx => hx.1
  
  have hdet_eq : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
    funext y; exact Matrix.det_fin_two _
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) W := by
    rw [hdet_eq]; exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hdetpos : ∀ y ∈ W, 0 < (h y).det := fun y hy => (hpd y hy).det_pos
  have hsqdet : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det) W :=
    hdetS.sqrt (fun y hy => (hdetpos y hy).ne')
  
  have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate a c) W := by
    intro a c
    have e : (fun y => (h y).adjugate a c) =
        fun y => !![h y 1 1, -h y 0 1; -h y 1 0, h y 0 0] a c := by
      funext y; rw [Matrix.adjugate_fin_two]
    rw [e]
    fin_cases a <;> fin_cases c
    · simpa using hh 1 1
    · simpa using (hh 0 1).neg
    · simpa using (hh 1 0).neg
    · simpa using hh 0 0
  have hinvS : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a c) W := by
    intro a c
    have e : (fun y => (h y)⁻¹ a c) = fun y => ((h y).det)⁻¹ * (h y).adjugate a c := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv]
    rw [e]
    exact (hdetS.inv (fun y hy => (hdetpos y hy).ne')).mul (hadj a c)
  
  have hfd : ContDiffOn ℝ ∞ (fderiv ℝ w) W := hw.fderiv_of_isOpen hW (by simp)
  have hpd2 : ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a w) W := by
    intro a
    show ContDiffOn ℝ ∞ (fun x => fderiv ℝ w x (e2 a)) W
    exact hfd.clm_apply contDiffOn_const
  
  have hG : ContDiffOn ℝ ∞ (sgbGradSq2 h w) W := by
    have e : sgbGradSq2 h w =
        fun x => ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a w x * pd2 c w x := by
      funext x; rfl
    rw [e]
    exact ContDiffOn.sum (fun a _ => ContDiffOn.sum
      (fun c _ => ((hinvS a c).mul (hpd2 a)).mul (hpd2 c)))
  
  have hUopen : IsOpen {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} :=
    hG.continuousOn.isOpen_inter_preimage hW isOpen_Ioi
  
  have hGU : ContDiffOn ℝ ∞ (fun y => Real.sqrt (sgbGradSq2 h w y))
      {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} :=
    (hG.mono hUW).sqrt (fun y hy => hy.2.ne')
  have hV : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a w y) / Real.sqrt (sgbGradSq2 h w y))
      {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} := by
    intro i
    have hnum : ContDiffOn ℝ ∞
        (fun y => Real.sqrt (h y).det * (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a w y)) W :=
      hsqdet.mul (ContDiffOn.sum (fun a _ => (hinvS i a).mul (hpd2 a)))
    exact (hnum.mono hUW).div hGU (fun y hy => (Real.sqrt_pos.mpr hy.2).ne')
  have hdV : ∀ i : Fin 2, ContinuousOn (fun x => pd2 i (fun y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a w y) / Real.sqrt (sgbGradSq2 h w y)) x)
      {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} := by
    intro i
    exact ((hV i).continuousOn_fderiv_of_isOpen hUopen (by simp)).clm_apply continuousOn_const
  have hκ : ContinuousOn (fun x => sgbLevelCurv2 h w x)
      {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} := by
    have hsd : ContinuousOn (fun x => (Real.sqrt (h x).det)⁻¹)
        {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} :=
      (hsqdet.continuousOn.mono hUW).inv₀
        (fun x hx => (Real.sqrt_pos.mpr (hdetpos x (hUW hx))).ne')
    have hs : ContinuousOn (fun x => ∑ i : Fin 2, pd2 i (fun y => Real.sqrt (h y).det *
        (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a w y) / Real.sqrt (sgbGradSq2 h w y)) x)
        {x : E2 | x ∈ W ∧ 0 < sgbGradSq2 h w x} :=
      continuousOn_finset_sum _ (fun i _ => hdV i)
    unfold sgbLevelCurv2
    exact (hsd.mul hs).neg
  refine ⟨hUopen, (hG.continuousOn.mono hUW).sqrt.mul hκ, ?_⟩
  
  intro x hx hne
  have hA := (hpd x hx).inv
  have hv : (fun a : Fin 2 => fderiv ℝ w x (e2 a)) ≠ 0 := by
    intro hv0
    apply hne
    have h0 : fderiv ℝ w x (e2 0) = 0 := congrFun hv0 0
    have h1 : fderiv ℝ w x (e2 1) = 0 := congrFun hv0 1
    ext y
    have hy : y = y 0 • e2 0 + y 1 • e2 1 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    conv_lhs => rw [hy]
    simp [h0, h1]
  have hpos := hA.dotProduct_mulVec_pos hv
  calc (0 : ℝ) < _ := hpos
    _ = sgbGradSq2 h w x := by
      simp only [sgbGradSq2, pd2, star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
      ring

theorem edge_quot_continuousOn [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (β u : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) :
    ContinuousOn (fun p => g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
      Real.sqrt (g.gradInner u u p)) {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0} :=
by
  apply continuousOn_of_forall_continuousAt
  intro p₀ hp₀
  obtain ⟨-, -, hUo, hN⟩ := stern_phi_chart_reps g u hu 1 one_pos p₀
  have hNum : ContinuousOn
      (fun y => g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) ((chartAt E3 p₀).symm y))
      {y | y ∈ (chartAt E3 p₀).target ∧
        (chartAt E3 p₀).symm y ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}} :=
    stern_gradInner_chart g β (fun x => Real.sqrt (g.gradInner u u x))
      {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0} hUo hβ hN p₀
  have hB : ContinuousOn (fun y => g.gradInner u u ((chartAt E3 p₀).symm y))
      {y | y ∈ (chartAt E3 p₀).target ∧ (chartAt E3 p₀).symm y ∈ (Set.univ : Set M)} :=
    stern_gradInner_chart g u u Set.univ isOpen_univ hu hu.contMDiffOn p₀
  have hB' : ContinuousOn (fun y => Real.sqrt (g.gradInner u u ((chartAt E3 p₀).symm y)))
      {y | y ∈ (chartAt E3 p₀).target ∧
        (chartAt E3 p₀).symm y ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}} :=
    (hB.mono (fun y hy => ⟨hy.1, Set.mem_univ _⟩)).sqrt
  have hne : ∀ y ∈ {y | y ∈ (chartAt E3 p₀).target ∧
        (chartAt E3 p₀).symm y ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}},
      Real.sqrt (g.gradInner u u ((chartAt E3 p₀).symm y)) ≠ 0 := by
    intro y hy
    have h1 := (chart_pullback_gradInner g u hu p₀).2.1 y hy.1
    have h2 := chart_Nsq_pos g u hu p₀ y hy.1 hy.2
    apply ne_of_gt
    apply Real.sqrt_pos.mpr
    rw [h1]
    exact h2
  have hE' := hNum.div hB' hne
  have hTo : IsOpen {y | y ∈ (chartAt E3 p₀).target ∧
        (chartAt E3 p₀).symm y ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}} :=
    (chartAt E3 p₀).isOpen_inter_preimage_symm hUo
  have hsrc : p₀ ∈ (chartAt E3 p₀).source := mem_chart_source E3 p₀
  have hmem : (chartAt E3 p₀) p₀ ∈ {y | y ∈ (chartAt E3 p₀).target ∧
        (chartAt E3 p₀).symm y ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}} := by
    refine ⟨(chartAt E3 p₀).map_source hsrc, ?_⟩
    show (chartAt E3 p₀).symm ((chartAt E3 p₀) p₀) ∈ {p : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0}
    rw [(chartAt E3 p₀).left_inv hsrc]
    exact hp₀
  have hat := hE'.continuousAt (hTo.mem_nhds hmem)
  have hcomp := hat.comp ((chartAt E3 p₀).continuousAt hsrc)
  refine hcomp.congr_of_eventuallyEq ?_
  filter_upwards [(chartAt E3 p₀).open_source.mem_nhds hsrc] with p hp
  simp only [Function.comp_apply, Pi.div_apply, (chartAt E3 p₀).left_inv hp]

theorem patched_collar_compare [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hEdge : ∀ (z : M) (W : Set E2) (F : E2 → E3), IsOpen W → ContDiffOn ℝ ∞ F W →
      (∀ x ∈ W, F x ∈ (chartAt E3 z).target) →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (c : ℝ), (∀ x ∈ W, u ((chartAt E3 z).symm (F x)) = c) →
      (∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 z).symm (F x)) ≠ 0) →
      ∀ x ∈ W, β ((chartAt E3 z).symm (F x)) = 0 →
      g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) ((chartAt E3 z).symm (F x)) /
          Real.sqrt (g.gradInner u u ((chartAt E3 z).symm (F x))) =
        -(Real.sqrt (sgbGradSq2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
              (fun y => β ((chartAt E3 z).symm (F y))) x) *
          sgbLevelCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
              (fun y => β ((chartAt E3 z).symm (F y))) x))
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js) :
    Tendsto (fun s : ℝ =>
      eigWInt P ρ (fun i x => (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
            g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
              Real.sqrt (g.gradInner u u p)) (P.param i x)) +
        eigWInt P ρ (fun j x => s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) -
        ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) *
          Real.sqrt (sgbGradSq2 (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t)
            (sgbSideDef L) x) *
          sgbLevelCurv2 (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t) (sgbSideDef L) x *
          Real.sqrt (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x).det)
      (𝓝[>] (0 : ℝ)) (𝓝 0) :=
by
  classical
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19,
    h20, h21, h22, h23, h24, h25, h26, h27⟩ := hgood
  
  have hη0 : ∀ y : ℝ, y ≤ 0 → deriv Real.smoothTransition y = 0 := by
    intro y hy
    rcases hy.lt_or_eq with hy | hy
    · have h : Real.smoothTransition =ᶠ[𝓝 y] fun _ => (0:ℝ) := by
        filter_upwards [Iio_mem_nhds hy] with z hz
        exact Real.smoothTransition.zero_of_nonpos hz.le
      rw [h.deriv_eq, deriv_const]
    · rw [hy]
      apply IsLocalMin.deriv_eq_zero
      filter_upwards with z
      rw [Real.smoothTransition.zero_of_nonpos le_rfl]
      exact Real.smoothTransition.nonneg z
  have hη1 : ∀ y : ℝ, 1 ≤ y → deriv Real.smoothTransition y = 0 := by
    intro y hy
    rcases hy.lt_or_eq with hy | hy
    · have h : Real.smoothTransition =ᶠ[𝓝 y] fun _ => (1:ℝ) := by
        filter_upwards [Ioi_mem_nhds hy] with z hz
        exact Real.smoothTransition.one_of_one_le hz.le
      rw [h.deriv_eq, deriv_const]
    · rw [← hy]
      apply IsLocalMax.deriv_eq_zero
      filter_upwards with z
      rw [Real.smoothTransition.one_of_one_le le_rfl]
      exact Real.smoothTransition.le_one z
  have hηpos : ∀ v s : ℝ, 0 < s → deriv Real.smoothTransition (v / s) ≠ 0 → 0 < v ∧ v < s := by
    intro v s hs hne
    constructor
    · by_contra hv
      push_neg at hv
      exact hne (hη0 _ (by rw [div_le_iff₀ hs]; linarith))
    · by_contra hv
      push_neg at hv
      exact hne (hη1 _ (by rw [le_div_iff₀ hs]; linarith))
  
  have hgerm : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w₁ w₂ : E2 → ℝ) (x : E2),
      h₁ =ᶠ[𝓝 x] h₂ → w₁ =ᶠ[𝓝 x] w₂ →
      sgbGradSq2 h₁ w₁ x = sgbGradSq2 h₂ w₂ x ∧
        sgbLevelCurv2 h₁ w₁ x = sgbLevelCurv2 h₂ w₂ x := by
    intro h₁ h₂ w₁ w₂ x hh hw
    have hpd : ∀ a : Fin 2, (pd2 a w₁) =ᶠ[𝓝 x] (pd2 a w₂) := by
      intro a
      filter_upwards [hw.eventuallyEq_nhds] with y hy
      simp only [pd2, hy.fderiv_eq]
    have hG : (sgbGradSq2 h₁ w₁) =ᶠ[𝓝 x] (sgbGradSq2 h₂ w₂) := by
      filter_upwards [hh, hpd 0, hpd 1] with y hy1 hy2 hy3
      simp only [sgbGradSq2, Fin.sum_univ_two, hy1, hy2, hy3]
    refine ⟨hG.eq_of_nhds, ?_⟩
    have hV : ∀ i : Fin 2, (fun y => Real.sqrt (h₁ y).det *
        (∑ a : Fin 2, (h₁ y)⁻¹ i a * pd2 a w₁ y) / Real.sqrt (sgbGradSq2 h₁ w₁ y)) =ᶠ[𝓝 x]
        (fun y => Real.sqrt (h₂ y).det *
        (∑ a : Fin 2, (h₂ y)⁻¹ i a * pd2 a w₂ y) / Real.sqrt (sgbGradSq2 h₂ w₂ y)) := by
      intro i
      filter_upwards [hh, hpd 0, hpd 1, hG] with y hy1 hy2 hy3 hy4
      simp only [Fin.sum_univ_two, hy1, hy2, hy3, hy4]
    have hpdV : ∀ i : Fin 2, pd2 i (fun y => Real.sqrt (h₁ y).det *
        (∑ a : Fin 2, (h₁ y)⁻¹ i a * pd2 a w₁ y) / Real.sqrt (sgbGradSq2 h₁ w₁ y)) x =
        pd2 i (fun y => Real.sqrt (h₂ y).det *
        (∑ a : Fin 2, (h₂ y)⁻¹ i a * pd2 a w₂ y) / Real.sqrt (sgbGradSq2 h₂ w₂ y)) x := by
      intro i
      exact congrArg (fun T : E2 →L[ℝ] ℝ => T (e2 i)) (hV i).fderiv_eq
    unfold sgbLevelCurv2
    rw [hh.eq_of_nhds, Finset.sum_congr rfl (fun i _ => hpdV i)]
  
  have hmemS : ∀ j : Fin P.n, ∀ x ∈ P.W j, P.param j x ∈ S := fun j x hx =>
    (((P.image_eq j).subset) (Set.mem_image_of_mem _ hx)).2
  have hdetc : ∀ i : Fin P.n, ContinuousOn (fun x => Real.sqrt (P.h i x).det) (P.W i) := by
    intro i
    have hfun : (fun x => (P.h i x).det) =
        fun x => P.h i x 0 0 * P.h i x 1 1 - P.h i x 0 1 * P.h i x 1 0 := by
      funext x
      exact Matrix.det_fin_two _
    apply ContinuousOn.sqrt
    rw [hfun]
    exact ((P.h_smooth i 0 0).continuousOn.mul (P.h_smooth i 1 1).continuousOn).sub
      ((P.h_smooth i 0 1).continuousOn.mul (P.h_smooth i 1 0).continuousOn)
  
  have hind : ∀ z ∈ S, ∀ s : ℝ, 0 < s → s < σ₀ →
      (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
        (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
          g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
            Real.sqrt (g.gradInner u u p)) z =
      s⁻¹ * deriv Real.smoothTransition (β z / s) *
        (g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) z /
          Real.sqrt (g.gradInner u u z)) := by
    intro z hz s hs hsσ
    by_cases hzS : z ∈ sternDomain Φ β Y L ∩ u ⁻¹' {t}
    · simp only [Set.indicator_of_mem hzS]
      ring
    · rw [Set.indicator_apply, if_neg hzS]
      have hb : b z < 0 := by
        by_contra hb
        push_neg at hb
        apply hzS
        rw [← h13]
        exact ⟨hz, hb⟩
      have hd : deriv Real.smoothTransition (β z / s) = 0 := by
        by_cases hβ' : β z < σ₀
        · have hbe := (h27 z hz hβ').1.self_of_nhds
          exact hη0 _ (by rw [div_le_iff₀ hs]; linarith)
        · push_neg at hβ'
          exact hη1 _ (by rw [le_div_iff₀ hs]; linarith)
      rw [hd]
      ring
  
  have hloc : ∀ j : Fin P.n, ∀ x ∈ P.W j, β (P.param j x) < σ₀ →
      (fun y => b (P.param j y)) =ᶠ[𝓝 x] (fun y => β (P.param j y)) := by
    intro j x hx hβx
    have hc : ContinuousAt (P.param j) x :=
      (P.param_cont j).continuousAt ((P.W_open j).mem_nhds hx)
    exact Filter.Tendsto.eventually hc (h27 _ (hmemS j x hx) hβx).1
  
  have hside : ∀ s : ℝ, 0 < s → s < σ₀ →
      (∫ x in P.W js, ρ js (P.param js x) * (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
            g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
              Real.sqrt (g.gradInner u u p)) (P.param js x) * Real.sqrt (P.h js x).det) = 0 ∧
      (∫ x in P.W js, ρ js (P.param js x) *
          (s⁻¹ * deriv Real.smoothTransition (b (P.param js x) / s) *
            Real.sqrt (sgbGradSq2 (P.h js) (fun y => b (P.param js y)) x) *
            sgbLevelCurv2 (P.h js) (fun y => b (P.param js y)) x) * Real.sqrt (P.h js x).det) =
        ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) *
          Real.sqrt (sgbGradSq2 (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t)
            (sgbSideDef L) x) *
          sgbLevelCurv2 (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t) (sgbSideDef L) x *
          Real.sqrt (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x).det := by
    intro s hs hsσ
    refine ⟨setIntegral_eq_zero_of_forall_eq_zero (fun x hx => ?_), ?_⟩
    · rw [hind _ (hmemS js x hx) s hs hsσ,
        hη1 (β (P.param js x) / s) (by rw [le_div_iff₀ hs]; linarith [(h23 x hx).2.2])]
      ring
    refine Eq.trans (setIntegral_congr_fun (P.W_open js).measurableSet ?_)
      (setIntegral_eq_integral_of_forall_compl_eq_zero ?_)
    · intro x hx
      beta_reduce
      have hζdef : sgbSideDef L x = L ^ 2 - x 0 ^ 2 - x 1 ^ 2 := rfl
      by_cases hr : L ^ 2 - δ₀ < x 0 ^ 2 + x 1 ^ 2
      · have hO' : IsOpen (P.W js ∩ {y : E2 | L ^ 2 - δ₀ < y 0 ^ 2 + y 1 ^ 2}) :=
          (P.W_open js).inter (isOpen_lt continuous_const (by fun_prop))
        have hevb : (fun y => b (P.param js y)) =ᶠ[𝓝 x] sgbSideDef L :=
          Filter.eventually_of_mem (hO'.mem_nhds ⟨hx, hr⟩)
            (fun y hy => h24 y hy.1 (le_of_lt hy.2))
        have hevh : P.h js =ᶠ[𝓝 x] sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t :=
          Filter.eventually_of_mem ((P.W_open js).mem_nhds hx) (fun y hy => (h23 y hy).2.1)
        obtain ⟨hG, hLc⟩ := hgerm _ _ _ _ x hevh hevb
        have hbx : b (P.param js x) = sgbSideDef L x := h24 x hx hr.le
        have hhx : P.h js x = sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x := (h23 x hx).2.1
        by_cases hd : deriv Real.smoothTransition (sgbSideDef L x / s) = 0
        · rw [hbx, hd]
          ring
        · obtain ⟨hζ0, -⟩ := hηpos _ _ hs hd
          have hρ1 : ρ js (P.param js x) = 1 := h25 x hx hr.le (by linarith)
          rw [hbx, hρ1, hG, hLc, hhx]
          ring
      · push_neg at hr
        have hζ : δ₀ ≤ sgbSideDef L x := by linarith
        have hd2 : deriv Real.smoothTransition (sgbSideDef L x / s) = 0 :=
          hη1 _ (by rw [le_div_iff₀ hs]; linarith)
        have hbz : s ≤ b (P.param js x) := by
          by_contra hlt
          push_neg at hlt
          rcases h26 _ (hmemS js x hx) (by linarith) with hβ' | ⟨x', hx', hpx, hr'⟩
          · linarith [(h23 x hx).2.2]
          · rw [h19 js hx' hx hpx] at hr'
            have hbe := h24 x hx hr'
            linarith
        have hd1 : deriv Real.smoothTransition (b (P.param js x) / s) = 0 :=
          hη1 _ (by rw [le_div_iff₀ hs]; linarith)
        rw [hd1, hd2]
        ring
    · intro x hx
      rw [h22] at hx
      simp only [Set.mem_setOf_eq, not_and_or, not_lt] at hx
      have hζdef : sgbSideDef L x = L ^ 2 - x 0 ^ 2 - x 1 ^ 2 := rfl
      have hd : deriv Real.smoothTransition (sgbSideDef L x / s) = 0 := by
        rcases hx with hx | hx
        · exact hη1 _ (by rw [le_div_iff₀ hs]; linarith)
        · exact hη0 _ (by rw [div_le_iff₀ hs]; linarith)
      rw [hd]
      ring
  
  have hpatch : ∀ j : Fin P.n, j ≠ js → Tendsto (fun s : ℝ =>
      (∫ x in P.W j, ρ j (P.param j x) * (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
            g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
              Real.sqrt (g.gradInner u u p)) (P.param j x) * Real.sqrt (P.h j x).det) +
      ∫ x in P.W j, ρ j (P.param j x) *
          (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
            Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) * Real.sqrt (P.h j x).det)
      (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    intro j hj
    obtain ⟨z₀, F, hpar, hπ, hh⟩ := h20 j hj
    obtain ⟨hWo, hFs, hFx⟩ := hpar
    have hKW : Kc j ⊆ P.W j := (h3 j).2
    obtain ⟨w, hw_def⟩ : ∃ f : E2 → ℝ, f = fun x => β (P.param j x) := ⟨_, rfl⟩
    obtain ⟨a, ha_def⟩ : ∃ f : E2 → ℝ,
        f = fun x => ρ j (P.param j x) * Real.sqrt (P.h j x).det := ⟨_, rfl⟩
    obtain ⟨e₁, he₁_def⟩ : ∃ f : E2 → ℝ, f = fun x =>
        g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) (P.param j x) /
          Real.sqrt (g.gradInner u u (P.param j x)) := ⟨_, rfl⟩
    obtain ⟨e₂, he₂_def⟩ : ∃ f : E2 → ℝ, f = fun x =>
        Real.sqrt (sgbGradSq2 (P.h j) w x) * sgbLevelCurv2 (P.h j) w x := ⟨_, rfl⟩
    
    have hβc : ContDiffOn ℝ ∞ (fun y => β ((chartAt E3 z₀).symm y)) (chartAt E3 z₀).target := by
      have hm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (β ∘ (chartAt E3 z₀).symm)
          (chartAt E3 z₀).target := hβ.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp hm
    have hw : ContDiffOn ℝ ∞ w (P.W j) := by
      rw [hw_def]
      exact (hβc.comp hFs (fun x hx => (hFx x hx).1)).congr (fun x hx => by
        simp only [Function.comp_apply, hπ x hx])
    have ha : ContinuousOn a (P.W j) := by
      rw [ha_def]
      exact (h2 j j).continuousOn.mul (hdetc j)
    have ha0 : ∀ x ∈ P.W j, x ∉ Kc j → a x = 0 := by
      intro x hx hxK
      rw [ha_def]
      simp only [h4 j x hx hxK, zero_mul]
    have he₁ : ContinuousOn e₁ (P.W j) := by
      rw [he₁_def]
      exact (edge_quot_continuousOn g β u hβ hu).comp (P.param_cont j)
        (fun x hx => (h12 _ (hmemS j x hx)).2)
    obtain ⟨hUo, he₂c, hpos⟩ := sgb_curv_density_regular (P.h j) (P.W j) (P.W_open j)
      (P.h_smooth j) (P.h_posDef j) w hw
    have he₂ : ContinuousOn e₂ {x : E2 | x ∈ P.W j ∧ 0 < sgbGradSq2 (P.h j) w x} := by
      rw [he₂_def]
      exact he₂c
    have hwreg : ∀ x ∈ Kc j, w x = 0 → fderiv ℝ w x ≠ 0 := by
      intro x hxK hw0
      have hxW := hKW hxK
      simp only [hw_def] at hw0
      have hev := hloc j x hxW (by linarith)
      have hb0 : b (P.param j x) = 0 := by
        have hbe := hev.eq_of_nhds
        simp only at hbe
        rw [hbe]
        exact hw0
      have hne := h10 j x hxW hb0
      rw [hev.fderiv_eq, ← hw_def] at hne
      exact hne
    have hZU : ∀ x ∈ Kc j, w x = 0 →
        x ∈ {x : E2 | x ∈ P.W j ∧ 0 < sgbGradSq2 (P.h j) w x} :=
      fun x hxK hw0 => ⟨hKW hxK, hpos x (hKW hxK) (hwreg x hxK hw0)⟩
    have hedge : ∀ x ∈ Kc j, w x = 0 → e₁ x + e₂ x = 0 := by
      intro x hxK hw0
      have hxW := hKW hxK
      simp only [hw_def] at hw0
      have hE := hEdge z₀ (P.W j) F hWo hFs (fun x hx => (hFx x hx).1)
        (fun x hx => (hFx x hx).2.2) t
        (fun x hx => by rw [← hπ x hx]; exact (h12 _ (hmemS j x hx)).1)
        (fun x hx => by rw [← hπ x hx]; exact (h12 _ (hmemS j x hx)).2) x hxW
        (by rw [← hπ x hxW]; exact hw0)
      rw [← hh, ← hπ x hxW] at hE
      have hev : (fun y => β ((chartAt E3 z₀).symm (F y))) =ᶠ[𝓝 x] w := by
        rw [hw_def]
        exact Filter.eventually_of_mem ((P.W_open j).mem_nhds hxW)
          (fun y hy => by simp only [hπ y hy])
      obtain ⟨hG, hLc⟩ := hgerm (P.h j) (P.h j) _ w x Filter.EventuallyEq.rfl hev
      rw [hG, hLc] at hE
      rw [he₁_def, he₂_def]
      simp only
      rw [hE]
      ring
    
    have hPA : ∀ s : ℝ, 0 < s → s < σ₀ → ∀ x ∈ P.W j,
        ρ j (P.param j x) * (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
            g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
              Real.sqrt (g.gradInner u u p)) (P.param j x) * Real.sqrt (P.h j x).det =
        a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₁ x := by
      intro s hs hsσ x hx
      rw [hind _ (hmemS j x hx) s hs hsσ]
      simp only [ha_def, hw_def, he₁_def]
      ring
    have hPB : ∀ s : ℝ, 0 < s → s < σ₀ → ∀ x ∈ P.W j,
        ρ j (P.param j x) * (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) * Real.sqrt (P.h j x).det =
        a x * (s⁻¹ * deriv Real.smoothTransition (w x / s)) * e₂ x := by
      intro s hs hsσ x hx
      have hzS := hmemS j x hx
      simp only [ha_def, hw_def, he₂_def]
      by_cases hβx : β (P.param j x) < σ₀
      · have hev := hloc j x hx hβx
        obtain ⟨hG, hLc⟩ := hgerm (P.h j) (P.h j) _ _ x Filter.EventuallyEq.rfl hev
        have hbz : b (P.param j x) = β (P.param j x) := by
          have hbe := hev.eq_of_nhds
          simp only at hbe
          exact hbe
        rw [hG, hLc, hbz]
        ring
      · push_neg at hβx
        have hd : deriv Real.smoothTransition (β (P.param j x) / s) = 0 :=
          hη1 _ (by rw [le_div_iff₀ hs]; linarith)
        rw [hd]
        by_cases hd' : deriv Real.smoothTransition (b (P.param j x) / s) = 0
        · rw [hd']
          ring
        · obtain ⟨hb0, hbs⟩ := hηpos _ _ hs hd'
          rcases h26 _ hzS (by linarith) with hβ' | ⟨x', hx', hpx, hr⟩
          · linarith
          · have hbζ := h24 x' hx' hr
            rw [hpx] at hbζ
            have hζdef : sgbSideDef L x' = L ^ 2 - x' 0 ^ 2 - x' 1 ^ 2 := rfl
            have hρ1 : ρ js (P.param j x) = 1 := by
              rw [← hpx]
              exact h25 x' hx' hr (by linarith)
            have hsum := h9 _ hzS hb0.le
            rw [← Finset.add_sum_erase _ _ (Finset.mem_univ js), hρ1] at hsum
            have hz0 : ∑ i ∈ Finset.univ.erase js, ρ i (P.param j x) = 0 := by linarith
            have hρj := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => h1 i (P.param j x))).mp hz0 j
              (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ j⟩)
            rw [hρj]
            ring
    
    refine (collar_band_vanish (P.W j) {x : E2 | x ∈ P.W j ∧ 0 < sgbGradSq2 (P.h j) w x}
      (Kc j) (P.W_open j) hUo (fun x hx => hx.1) (h3 j).1 hKW a w e₁ e₂
      ha ha0 hw hwreg he₁ he₂ hZU hedge).congr' ?_
    filter_upwards [Ioo_mem_nhdsGT h14] with s hs
    congr 1
    · exact setIntegral_congr_fun (P.W_open j).measurableSet
        (fun x hx => (hPA s hs.1 hs.2 x hx).symm)
    · exact setIntegral_congr_fun (P.W_open j).measurableSet
        (fun x hx => (hPB s hs.1 hs.2 x hx).symm)
  
  have hsum := tendsto_finset_sum (Finset.univ.erase js)
    (fun j hj => hpatch j (Finset.ne_of_mem_erase hj))
  simp only [Finset.sum_const_zero] at hsum
  refine hsum.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT h14] with s hs
  obtain ⟨hA, hB⟩ := hside s hs.1 hs.2
  simp only [eigWInt]
  rw [← Finset.add_sum_erase _ _ (Finset.mem_univ js),
    ← Finset.add_sum_erase _ _ (Finset.mem_univ js), Finset.sum_add_distrib]
  simp only [hA, hB]
  ring

theorem stern_slice_patched_reduction [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0)
    (hArea : ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W → Set.InjOn F W →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (W' : Set E2), MeasurableSet W' → W' ⊆ W → ∀ (h : E3 → ℝ),
      ∫ y in F '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        sbgbAreaConst⁻¹ * ∫ x in W', h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
    (hEdge : ∀ (z : M) (W : Set E2) (F : E2 → E3), IsOpen W → ContDiffOn ℝ ∞ F W →
      (∀ x ∈ W, F x ∈ (chartAt E3 z).target) →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (c : ℝ), (∀ x ∈ W, u ((chartAt E3 z).symm (F x)) = c) →
      (∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 z).symm (F x)) ≠ 0) →
      ∀ x ∈ W, β ((chartAt E3 z).symm (F x)) = 0 →
      g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) ((chartAt E3 z).symm (F x)) /
          Real.sqrt (g.gradInner u u ((chartAt E3 z).symm (F x))) =
        -(Real.sqrt (sgbGradSq2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
              (fun y => β ((chartAt E3 z).symm (F y))) x) *
          sgbLevelCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
              (fun y => β ((chartAt E3 z).symm (F y))) x))
    (hSide : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L t : ℝ), 0 ≤ R → R < L → |t| < L →
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) {y : E3 | R < ‖y‖}) →
      (∀ (y : E3) (a b : Fin 3), G y a b = G y b a) →
      (∀ y : E3, R < ‖y‖ → (G y).PosDef) →
      Tendsto (fun s : ℝ => ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) *
          Real.sqrt (sgbGradSq2 (sgbSideMetric G t) (sgbSideDef L) x) *
          sgbLevelCurv2 (sgbSideMetric G t) (sgbSideDef L) x *
          Real.sqrt (sgbSideMetric G t x).det)
        (𝓝[>] (0 : ℝ)) (𝓝 (sternKappa G L t))) :
    ∀ L : ℝ, R₁ + 1 ≤ L → ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ),
      sternAdmissible (sternDomain (hAF.ends k) β Y L) q φ →
      ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∃ (S : Set M) (P : EigPatchedSurface M S) (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2)
        (b : M → ℝ),
        (∀ i z, 0 ≤ ρ i z) ∧
        (∀ i j, ContDiffOn ℝ ∞ (fun x => ρ i (P.param j x)) (P.W j)) ∧
        (∀ i, IsCompact (Kc i) ∧ Kc i ⊆ P.W i) ∧
        (∀ i, ∀ x ∈ P.W i, x ∉ Kc i → ρ i (P.param i x) = 0) ∧
        (∀ i z, z ∉ P.O i → ρ i z = 0) ∧
        (∀ i, ContDiffOn ℝ ∞ (fun x => b (P.param i x)) (P.W i)) ∧
        IsCompact {z | z ∈ S ∧ 0 ≤ b z} ∧
        IsConnected {z | z ∈ S ∧ 0 ≤ b z} ∧
        (∀ z, z ∈ S → 0 ≤ b z → ∑ i, ρ i z = 1) ∧
        (∀ i, ∀ x ∈ P.W i, b (P.param i x) = 0 →
          fderiv ℝ (fun y => b (P.param i y)) x ≠ 0) ∧
        (∃ z ∈ S, b z = 0) ∧
        ∀ θ : ℝ, 0 < θ → ∃ s₁ : ℝ, 0 < s₁ ∧ ∀ s : ℝ, 0 < s → s < s₁ →
          sbgbSliceJ g β u q φ (sternDomain (hAF.ends k) β Y L) t s ≤
            sgbCollarGB P ρ b s -
              sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t + θ :=
by
  intro L hL n q φ hadm t ht hreg
  obtain ⟨σ₀, δ₀, S, P, ρ, Kc, b, js, hgood⟩ :=
    stern_slice_patched_data g hAF k β Re hβ u hu hneu X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
      L hL t ht hreg
  have hgood' := hgood
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, -⟩ := hgood'
  refine ⟨S, P, ρ, Kc, b, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, ?_⟩
  
  have hreg7 : ∀ Φ : EndChart M,
      (∀ a c : Fin 3, ContDiffOn ℝ ∞ (fun y => pullbackMetric (g.coeff Φ.Φ) Y y a c)
        {y : E3 | R₁ < ‖y‖}) ∧
      (∀ (y : E3) (a c : Fin 3),
        pullbackMetric (g.coeff Φ.Φ) Y y a c = pullbackMetric (g.coeff Φ.Φ) Y y c a) ∧
      (∀ y : E3, R₁ < ‖y‖ → (pullbackMetric (g.coeff Φ.Φ) Y y).PosDef) := by
    intro Φ
    have hcoeffS : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (i j : Fin 3),
        ContDiffOn ℝ ∞ (fun x => g.coeff Φ x i j) Φ.source := by
      intro Φ i j
      have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
        intro w
        ext k
        simp [e, Pi.single_apply]
      have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
          B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
        intro B D w1 w2
        calc B (D w1) (D w2)
            = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
              rw [← hw w1, ← hw w2]
          _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
              simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
                ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
              conv_lhs => rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
              ring
      have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
      apply contDiffOn_of_locally_contDiffOn
      intro x0 hx0
      have hu : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
        hΦ.continuousOn.isOpen_inter_preimage Φ.open_source (chartAt E3 (Φ x0)).open_source
      have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (Φ x0) (Φ y))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
        have h1 := (contMDiffOn_iff_target.mp hΦ).2 (Φ x0)
        rw [extChartAt_source] at h1
        have h2 := contMDiffOn_iff_contDiffOn.mp h1
        simpa [extChartAt_coe, Function.comp_def] using h2
      have hmaps : Set.MapsTo (fun y => chartAt E3 (Φ x0) (Φ y))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) (chartAt E3 (Φ x0)).target :=
        fun y hy => (chartAt E3 (Φ x0)).map_source hy.2
      have hD : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hu).mp hF).2
      have hcoord : ∀ k a : Fin 3, ContDiffOn ℝ ∞
          (fun x => (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k)) a)
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
        intro k a
        have h2 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k))
            (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := hD.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
      have hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞
          (fun x => g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
        fun a b => (g.smooth (Φ x0) a b).comp hF hmaps
      have hR : ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
          (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
          (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
          g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
        apply ContDiffOn.sum
        intro a _
        apply ContDiffOn.sum
        intro b _
        exact ((hcoord i a).mul (hcoord j b)).mul (hG a b)
      have key : ∀ x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source,
          g.coeff Φ x i j = ∑ a : Fin 3, ∑ b : Fin 3,
          (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
          (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
          g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b := by
        intro x hx
        have hcont : ContinuousAt Φ x :=
          hΦ.continuousOn.continuousAt (Φ.open_source.mem_nhds hx.1)
        have hFdiff : DifferentiableAt ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x :=
          (hF.contDiffAt (hu.mem_nhds hx)).differentiableAt (by simp)
        have hFx : chartAt E3 (Φ x0) (Φ x) ∈ (chartAt E3 (Φ x0)).target := hmaps hx
        have hev : (Φ : E3 → M) =ᶠ[𝓝 x]
            ((chartAt E3 (Φ x0)).symm ∘ fun y => chartAt E3 (Φ x0) (Φ y)) := by
          have hmem : (Φ : E3 → M) ⁻¹' (chartAt E3 (Φ x0)).source ∈ 𝓝 x :=
            hcont.preimage_mem_nhds ((chartAt E3 (Φ x0)).open_source.mem_nhds hx.2)
          filter_upwards [hmem] with y hy
          simp only [Function.comp_apply]
          exact ((chartAt E3 (Φ x0)).left_inv hy).symm
        have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm
            (chartAt E3 (Φ x0) (Φ x)) :=
          ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
            ((chartAt E3 (Φ x0)).open_target.mem_nhds hFx)).mdifferentiableAt (by simp)
        have hfac : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x v =
            mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))
              (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x v) := by
          intro v
          rw [hev.mfderiv_eq, mfderiv_comp x hg hFdiff.mdifferentiableAt, mfderiv_eq_fderiv]
          rfl
        have hpt : (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) = Φ x :=
          (chartAt E3 (Φ x0)).left_inv hx.2
        have h1 : g.coeff Φ x i j = g.g (Φ x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e i))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e j)) := rfl
        have h2 : ∀ a b : Fin 3,
            g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b =
            g.g (Φ x)
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e a))
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e b)) := by
          intro a b
          show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) _ _ = _
          rw [show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) = g.g (Φ x) from
            congrArg g.g hpt]
        rw [h1, hfac, hfac]
        simp only [h2]
        exact hexp (g.g (Φ x))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)))
          _ _
      refine ⟨Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source, hu,
        ⟨hx0, mem_chart_source E3 (Φ x0)⟩, ?_⟩
      rw [Set.inter_eq_right.mpr Set.inter_subset_left]
      exact hR.congr key
    have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
      intro w
      ext k
      simp [e, Pi.single_apply]
    have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
        B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
      intro B D w1 w2
      calc B (D w1) (D w2)
          = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
            rw [← hw w1, ← hw w2]
        _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
            simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
              ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
            conv_lhs => rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
            ring
    set G := pullbackMetric (g.coeff Φ.Φ) Y with hGdef
    obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY
    have hU : IsOpen {x : E3 | R₁ < ‖x‖} := isOpen_lt continuous_const continuous_norm
    have hV : IsOpen {y : E3 | R₀ < ‖y‖} := isOpen_lt continuous_const continuous_norm
    have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hmapsW : Set.MapsTo Y {x : E3 | R₁ < ‖x‖} {y : E3 | 1 < ‖y‖} := by
      intro x hx
      have h1 := (hinv x hx).1
      show (1 : ℝ) < ‖Y x‖
      linarith
    have hsmooth : ∀ i j : Fin 3,
        ContDiffOn ℝ ∞ (fun y => g.coeff Φ.Φ y i j) {y : E3 | 1 < ‖y‖} := by
      intro i j
      have h := hcoeffS Φ.Φ i j
      rwa [Φ.source_eq] at h
    have hcoordF : ∀ (F : E3 → E3) (S : Set E3), ContDiffOn ℝ ∞ F S →
        ∀ d : Fin 3, ContDiffOn ℝ ∞ (fun w => F w d) S := by
      intro F S hF d
      exact (EuclideanSpace.proj d : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hF
    have hfd : ∀ a i : Fin 3, ContDiffOn ℝ ∞ (fun z => (fderiv ℝ Y z (e a)) i)
        {x : E3 | R₁ < ‖x‖} := by
      intro a i
      have h1 : ContDiffOn ℝ ∞ (fderiv ℝ Y) {x : E3 | R₁ < ‖x‖} := hYs.fderiv_of_isOpen hU le_rfl
      have h2 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ Y z (e a)) {x : E3 | R₁ < ‖x‖} :=
        h1.clm_apply contDiffOn_const
      exact hcoordF _ _ h2 i
    have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R₁ < ‖x‖} := by
      intro a b
      have hGY : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => g.coeff Φ.Φ (Y x) i j)
          {x : E3 | R₁ < ‖x‖} := fun i j => (hsmooth i j).comp hYs hmapsW
      show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e b)) j) _
      exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ =>
        ((hfd a i).mul (hGY i j)).mul (hfd b j)))
    have hsymmG : ∀ (y : E3) (a c : Fin 3), G y a c = G y c a := by
      intro y a c
      show ∑ i : Fin 3, ∑ j : Fin 3,
          (fderiv ℝ Y y (e a)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e c)) j =
        ∑ i : Fin 3, ∑ j : Fin 3,
          (fderiv ℝ Y y (e c)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e a)) j
      conv_lhs => rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      have hs : g.coeff Φ.Φ (Y y) j i = g.coeff Φ.Φ (Y y) i j := by
        simp only [RiemannianMetric3.coeff, coeffMatrix]
        exact g.symm _ _ _
      rw [hs]
      ring
    refine ⟨hGs, hsymmG, fun x hx => ?_⟩
    have hYx : Y x ∈ Φ.Φ.source := by rw [Φ.source_eq]; exact hmapsW hx
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ.Φ hYx
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) w = 0 → w = 0 := by
      intro w hw0
      have hL : ∀ u : E3, (hloc.mfderivToContinuousLinearEquiv hne) u =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) u := by
        intro u
        rw [← hloc.mfderivToContinuousLinearEquiv_coe hne]
        rfl
      apply (hloc.mfderivToContinuousLinearEquiv hne).injective
      rw [hL, hw0, map_zero]
    have hYd : DifferentiableAt ℝ Y x := (hYs.contDiffAt (hU.mem_nhds hx)).differentiableAt hne
    have hXd : DifferentiableAt ℝ X (Y x) :=
      (hXs.contDiffAt (hV.mem_nhds (hinv x hx).1)).differentiableAt hne
    have hc2 : (fderiv ℝ X (Y x)).comp (fderiv ℝ Y x) = ContinuousLinearMap.id ℝ E3 := by
      rw [← fderiv_comp x hXd hYd]
      have hev : X ∘ Y =ᶠ[𝓝 x] id := by
        filter_upwards [hU.mem_nhds hx] with z hz
        exact (hinv z hz).2
      rw [hev.fderiv_eq, fderiv_id]
    have hJinj : ∀ v : E3, fderiv ℝ Y x v = 0 → v = 0 := by
      intro v hv
      have h := congrArg (fun T : E3 →L[ℝ] E3 => T v) hc2
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply, hv,
        map_zero] at h
      exact h.symm
    have hGform : ∀ a c : Fin 3, G x a c = g.g (Φ.Φ (Y x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e a)))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e c))) := by
      intro a c
      have hh := hexp (g.g (Φ.Φ (Y x))) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x))
        (fderiv ℝ Y x (e a)) (fderiv ℝ Y x (e c))
      refine Eq.trans ?_ hh.symm
      show ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e c)) j = _
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      simp only [RiemannianMetric3.coeff, coeffMatrix]
      exact mul_right_comm _ _ _
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [star_trivial]
      exact hsymmG x j i
    · intro w hw0
      set v : E3 := w 0 • e 0 + w 1 • e 1 + w 2 • e 2 with hvdef
      have hv0 : v ≠ 0 := by
        intro h0
        apply hw0
        have h0' := congrArg (fun u : E3 => u 0) h0
        have h1' := congrArg (fun u : E3 => u 1) h0
        have h2' := congrArg (fun u : E3 => u 2) h0
        simp [v, e, EuclideanSpace.single_apply] at h0' h1' h2'
        funext k
        fin_cases k
        · simpa using h0'
        · simpa using h1'
        · simpa using h2'
      have hpos := g.posDef (Φ.Φ (Y x)) _ (fun h => hv0 (hJinj _ (hDinj _ h)))
      have key : star w ⬝ᵥ (G x).mulVec w =
          g.g (Φ.Φ (Y x)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v)) := by
        simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Pi.star_apply, star_trivial,
          hGform, hvdef, map_add, map_smul, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      rw [key]
      exact hpos
  obtain ⟨hGs, hGsymm, hGpd⟩ := hreg7 (hAF.ends k)
  have hR0 : (2 : ℝ) ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hSd := hSide (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) R₁ L t (by linarith)
    (by linarith) ht hGs hGsymm hGpd
  have hB := patched_bulk_compare g (hAF.ends k) β u hβ.1.continuous Y R₁ L t σ₀ δ₀ S P ρ Kc b js
    hgood
  have hC := patched_collar_compare g (hAF.ends k) β u hβ.1 hu hEdge Y R₁ L t σ₀ δ₀ S P ρ Kc b js
    hgood
  have hlim := (hB.sub hC).sub
    (hSd.sub_const (sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t))
  rw [show ((0 : ℝ) - 0) - (sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t -
      sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t) = 0 by ring] at hlim
  intro θ hθ
  have hev := hlim (Iio_mem_nhds hθ)
  obtain ⟨s₁, hs₁, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hev
  refine ⟨s₁, hs₁, fun s hs hss => ?_⟩
  have hmem := hsub ⟨hs, hss⟩
  simp only [Set.mem_preimage, Set.mem_Iio] at hmem
  rw [stern_slice_patch_identity g (hAF.ends k) β u hβ.1 hu hArea Y R₁ L t σ₀ δ₀ S P ρ Kc b js
    hgood q φ hadm s hs]
  unfold sgbCollarGB
  linarith

theorem stern_slice_gauss_bonnet [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0) :
    ∀ L : ℝ, R₁ + 1 ≤ L → ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ),
      sternAdmissible (sternDomain (hAF.ends k) β Y L) q φ →
      ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      sbgbSliceLim g β u q φ (sternDomain (hAF.ends k) β Y L) t ≤
        2 * Real.pi - sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t :=
by
  intro L hL n q φ hadm t ht hreg
  have hA : IsCompact ({t} : Set ℝ) := isCompact_singleton
  have hAsub : ({t} : Set ℝ) ⊆ Set.Ioo (-L) L := by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact abs_lt.mp ht
  have hAreg : ∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ ({t} : Set ℝ) →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 := fun p hp hpt => hreg p ⟨hp, hpt⟩
  obtain ⟨s₀, hs₀, Cb, -, hlim⟩ := stern_slice_collar_limit g hAF hR k β Re hβ hmin u hu hharm
    hneu X Y R₀ R₁ C hXY hRe hX hdom hconn hchart L hL q φ hadm {t} hA hAsub hAreg
  have hlimt := hlim t (Set.mem_singleton t)
  obtain ⟨S, P, ρ, Kc, b, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, hcmp⟩ :=
    stern_slice_patched_reduction g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe hX
      hdom hconn hchart
      (fun F W hW hF hinj hdF W' hW' hW'W h =>
        sbgb_hausdorff_area_formula F W hW hF hinj hdF W' hW' hW'W h)
      (fun z W F hW hF hFt hinj c hlev hreg' x hx hβx =>
        stern_edge_curvature_pointwise g β u hβ.1 hβ.2.1 hu hneu hmin z W F hW hF hFt hinj c
          hlev hreg' x hx hβx)
      (fun G R L' t' hR0 hRL ht' hG hsymm hpd =>
        stern_side_collar_limit G R L' t' hR0 hRL ht' hG hsymm hpd)
      L hL q φ hadm t ht hreg
  have hgb := patched_collar_gauss_bonnet S P ρ Kc h1 h2 h3 h4 h5 b h6 h7 h8 h9 h10 h11
  apply le_of_forall_pos_le_add
  intro θ hθ
  obtain ⟨s₁, hs₁, hc⟩ := hcmp (θ / 2) (half_pos hθ)
  obtain ⟨s₂, hs₂, hg⟩ := hgb (θ / 2) (half_pos hθ)
  have hev : ∀ᶠ s in 𝓝[>] (0 : ℝ), sbgbSliceJ g β u q φ (sternDomain (hAF.ends k) β Y L) t s ≤
      2 * Real.pi - sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t + θ := by
    filter_upwards [Ioo_mem_nhdsGT (lt_min hs₁ hs₂)] with s hs
    have e1 := hc s hs.1 (lt_of_lt_of_le hs.2 (min_le_left _ _))
    have e2 := hg s hs.1 (lt_of_lt_of_le hs.2 (min_le_right _ _))
    linarith
  exact le_of_tendsto hlimt hev

theorem stern_band_gauss_bonnet [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L → ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ),
      sternAdmissible (sternDomain (hAF.ends k) β Y L) q φ →
      ∀ A : Set ℝ, IsCompact A → A ⊆ Set.Ioo (-L) L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ A → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ θ : ℝ, 0 < θ → ∃ s₂ : ℝ, 0 < s₂ ∧ ∀ s : ℝ, 0 < s → s < s₂ →
        sternBandJ g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) s ≤
          -(∫ t in A, (sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t
            - 2 * Real.pi)) + θ :=
by
  classical
  
  
  have hκgen : ∀ (Φ : EndChart M) (q R₀ R₁ C : ℝ), CoordChange X Y q R₀ R₁ C →
      ∀ L : ℝ, R₁ < L → Continuous fun t => sternKappa (pullbackMetric (g.coeff Φ.Φ) Y) L t := by
    intro Φ q R₀ R₁ C hXY L hL
    have hcoeffS : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (i j : Fin 3),
        ContDiffOn ℝ ∞ (fun x => g.coeff Φ x i j) Φ.source := by
      intro Φ i j
      have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
        intro w
        ext k
        simp [e, Pi.single_apply]
      have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
          B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
        intro B D w1 w2
        calc B (D w1) (D w2)
            = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
              rw [← hw w1, ← hw w2]
          _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
              simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
                ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
              conv_lhs => rw [Finset.sum_comm]
              refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
              ring
      have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
      apply contDiffOn_of_locally_contDiffOn
      intro x0 hx0
      have hu : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
        hΦ.continuousOn.isOpen_inter_preimage Φ.open_source (chartAt E3 (Φ x0)).open_source
      have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (Φ x0) (Φ y))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
        have h1 := (contMDiffOn_iff_target.mp hΦ).2 (Φ x0)
        rw [extChartAt_source] at h1
        have h2 := contMDiffOn_iff_contDiffOn.mp h1
        simpa [extChartAt_coe, Function.comp_def] using h2
      have hmaps : Set.MapsTo (fun y => chartAt E3 (Φ x0) (Φ y))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) (chartAt E3 (Φ x0)).target :=
