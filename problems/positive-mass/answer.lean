        (tsupport_mul_subset_left), fun x hx => ⟨hζsub k (tsupport_mul_subset_left hx),
        ((hφ.2.2.2 j).2 (tsupport_mul_subset_right hx)).2⟩⟩
    have hcomp : ∀ k y, y ∈ (chartAt E3 (p k)).target →
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)) ((chartAt E3 (p k)).symm y)
