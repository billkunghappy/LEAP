    have hzero : ∀ (Z : E3 → E3) (y : E3), y ∉ tsupport Z → sepDensDiv G Z y = 0 := by
      intro Z y hy
      rw [hloc Z 0 y (notMem_tsupport_iff_eventuallyEq.1 hy)]
      simp [sepDensDiv, partialDeriv]
    have hcoord : ∀ (Z : E3 → E3) (y : E3), ContDiffAt ℝ ∞ Z y → ∀ i : Fin 3,
        ContDiffAt ℝ ∞ (fun z => Z z i) y := by
      intro Z y hZ i
      exact (contDiffAt_piLp _).1 hZ i
    have hc : ∀ z (i : Fin 3), X' z i = χ z * X z i := by
      intro z i
      rw [hX' z]
      rfl
    
    have ha : ∀ y, y ∉ chartAt E3 q '' (K ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ X' y := by
      intro y hyK
      by_cases hyT : y ∈ tsupport X
      · by_cases hyL : y ∈ chartAt E3 q '' (L ∩ (chartAt E3 q).source)
        · have h0 := hχL y hyL hyT
          have hev : X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
            filter_upwards [h0] with z hz
            rw [hX' z, hz, zero_smul]
          exact contDiffAt_const.congr_of_eventuallyEq hev
        · have hyKL : y ∉ chartAt E3 q '' ((K ∪ L) ∩ (chartAt E3 q).source) := by
            rintro ⟨x, ⟨hxKL, hxs⟩, hxy⟩
            rcases hxKL with hxK | hxL
            · exact hyK ⟨x, ⟨hxK, hxs⟩, hxy⟩
            · exact hyL ⟨x, ⟨hxL, hxs⟩, hxy⟩
          have h1 : ContDiffAt ℝ ∞ (fun z => χ z • X z) y := hχ.contDiffAt.smul (hXs y hyKL)
          have hfun : X' = fun z => χ z • X z := funext hX'
          rw [hfun]
          exact h1
      · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyT
        have hev : X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
          filter_upwards [h0] with z hz
          rw [hX' z, hz, Pi.zero_apply, smul_zero]
        exact contDiffAt_const.congr_of_eventuallyEq hev
    
    have hsupp : Function.support X' ⊆ Function.support X := by
      intro y hy h0
      apply hy
      rw [hX' y, h0, smul_zero]
    have hb : HasCompactSupport X' := hXc.mono hsupp
    have hTT : tsupport X' ⊆ tsupport X := closure_mono hsupp
    have hcU : tsupport X' ⊆ chartAt E3 q '' W := hTT.trans hXU
    have hd : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1 := by
      intro y
      have hs := hXn y
      have e1 : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j =
          (χ y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
        simp only [hc, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        ring
      rw [e1]
      obtain ⟨h0, h1⟩ := hχb y
      have h2 := mul_le_mul_of_nonneg_left hs (sq_nonneg (χ y))
      nlinarith
    
    obtain ⟨D, hD⟩ : ∃ D : Set E3, D = tsupport X \
        ({y | ∀ᶠ z in 𝓝 y, χ z = 1} ∪ {y | ∀ᶠ z in 𝓝 y, χ z = 0}) := ⟨_, rfl⟩
    have hDc : IsCompact D := by
      rw [hD]
      exact hXc.isCompact.diff (isOpen_setOf_eventually_nhds.union isOpen_setOf_eventually_nhds)
    have hDs : ∀ y ∈ D, ContDiffAt ℝ ∞ X y := by
      intro y hy
      rw [hD] at hy
      obtain ⟨hyT, hyn⟩ := hy
      apply hXs
      rintro ⟨x, ⟨hxKL, hxs⟩, hxy⟩
      rcases hxKL with hxK | hxL
      · exact hyn (Or.inl (hχK y ⟨x, ⟨hxK, hxs⟩, hxy⟩ hyT))
      · exact hyn (Or.inr (hχL y ⟨x, ⟨hxL, hxs⟩, hxy⟩ hyT))
    have hprod : ∀ y, y ∈ (chartAt E3 q).target → ContDiffAt ℝ ∞ X y →
        sepDensDiv G X' y = χ y * sepDensDiv G X y +
          ∑ i : Fin 3, partialDeriv i χ y * (Real.sqrt (G y).det * X y i) := by
      intro y hyT hyX
      have hJy := hJ.contDiffAt (hTo.mem_nhds hyT)
      unfold sepDensDiv partialDeriv
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hh : DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * X z i) y :=
        (hJy.mul (hcoord X y hyX i)).differentiableAt (by simp)
      have hχd : DifferentiableAt ℝ χ y := hχ.contDiffAt.differentiableAt (by simp)
      have e1 : (fun z => Real.sqrt (G z).det * X' z i) =
          fun z => χ z * (Real.sqrt (G z).det * X z i) := by
        funext z
        rw [hc z i]
        ring
      have hder : HasFDerivAt (fun z => χ z * (Real.sqrt (G z).det * X z i))
          (χ y • fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y +
            (Real.sqrt (G y).det * X y i) • fderiv ℝ χ y) y :=
        hχd.hasFDerivAt.mul hh.hasFDerivAt
      rw [e1, hder.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hΦc : ContinuousOn
        (fun y => ∑ i : Fin 3, partialDeriv i χ y * (Real.sqrt (G y).det * X y i)) D := by
      apply continuousOn_finset_sum
      intro i _ y hy
      have hyX := hDs y hy
      have hyT : y ∈ (chartAt E3 q).target := by
        rw [hD] at hy
        exact hTX hy.1
      have h1 : ContinuousAt (fun y => partialDeriv i χ y) y := by
        unfold partialDeriv
        exact ((hχ.continuous_fderiv (by simp)).clm_apply continuous_const).continuousAt
      have h2 : ContinuousAt (fun z => Real.sqrt (G z).det * X z i) y :=
        ((hJ.contDiffAt (hTo.mem_nhds hyT)).mul (hcoord X y hyX i)).continuousAt
      exact (h1.mul h2).continuousWithinAt
    obtain ⟨M0, hM0⟩ := hDc.exists_bound_of_continuousOn hΦc
    have hC0 : 0 ≤ C := le_trans (abs_nonneg _) (hXd 0)
    have hbd : ∃ C' : ℝ, ∀ y, |sepDensDiv G X' y| ≤ C' := by
      refine ⟨C + max M0 0, fun y => ?_⟩
      have hm1 := le_max_left M0 0
      have hm2 := le_max_right M0 0
      by_cases hyT : y ∈ tsupport X
      · by_cases hy1 : ∀ᶠ z in 𝓝 y, χ z = 1
        · have hev : X' =ᶠ[𝓝 y] X := by
            filter_upwards [hy1] with z hz
            rw [hX' z, hz, one_smul]
          rw [hloc X' X y hev]
          linarith [hXd y]
        · by_cases hy0 : ∀ᶠ z in 𝓝 y, χ z = 0
          · have hev : X' =ᶠ[𝓝 y] 0 := by
              filter_upwards [hy0] with z hz
              rw [hX' z, hz, zero_smul]
              rfl
            rw [hloc X' 0 y hev]
            have h00 : sepDensDiv G 0 y = 0 := by simp [sepDensDiv, partialDeriv]
            rw [h00, abs_zero]
            linarith
          · have hyD : y ∈ D := by
              rw [hD]
              exact ⟨hyT, fun h => h.elim hy1 hy0⟩
            rw [hprod y (hTX hyT) (hDs y hyD)]
            have h1 := hM0 y hyD
            simp only [Real.norm_eq_abs] at h1
            have h2 := hXd y
            obtain ⟨hχ0, hχ1⟩ := hχb y
            have h3 : |χ y * sepDensDiv G X y| ≤ C := by
              rw [abs_mul, abs_of_nonneg hχ0]
              calc χ y * |sepDensDiv G X y| ≤ 1 * C := mul_le_mul hχ1 h2 (abs_nonneg _) zero_le_one
                _ = C := one_mul C
            have h3' := abs_le.1 h3
            have h1' := abs_le.1 h1
            rw [abs_le]
            constructor <;> linarith [h3'.1, h3'.2, h1'.1, h1'.2]
      · rw [hzero X' y (fun h => hyT (hTT h)), abs_zero]
        linarith
    
    have hFO : chartAt E3 q '' (F ∩ (chartAt E3 q).source) ⊆
        {y | ∀ᶠ z in 𝓝 y, X' z = X z} := by
      intro y hy
      show ∀ᶠ z in 𝓝 y, X' z = X z
      by_cases hyT : y ∈ tsupport X
      · filter_upwards [hχF y hy hyT] with z hz
        rw [hX' z, hz, one_smul]
      · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyT
        filter_upwards [h0] with z hz
        rw [hX' z, hz, Pi.zero_apply, smul_zero]
    have hOo : IsOpen {y | ∀ᶠ z in 𝓝 y, X' z = X z} := isOpen_setOf_eventually_nhds
    have hf : ∀ y ∈ {y | ∀ᶠ z in 𝓝 y, X' z = X z}, sepDensDiv G X' y = sepDensDiv G X y :=
      fun y hy => hloc X' X y hy
    have hint : ∫ y in chartAt E3 q '' (F ∩ (chartAt E3 q).source), sepDensDiv G X' y =
        ∫ y in chartAt E3 q '' (F ∩ (chartAt E3 q).source), sepDensDiv G X y := by
      apply integral_congr_ae
      have h1 : ∀ᵐ y ∂(volume.restrict {y | ∀ᶠ z in 𝓝 y, X' z = X z}),
          sepDensDiv G X' y = sepDensDiv G X y :=
        ae_restrict_of_forall_mem hOo.measurableSet hf
      exact ae_restrict_of_ae_restrict_of_subset hFO h1
    rw [← hint]
    exact le_iSup₂_of_le (f := fun (Y : E3 → E3) (_ :
        (∀ y, y ∉ chartAt E3 q '' (K ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ Y y) ∧
        HasCompactSupport Y ∧ tsupport Y ⊆ chartAt E3 q '' W ∧
        (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) ∧
        ∃ C : ℝ, ∀ y, |sepDensDiv G Y y| ≤ C) =>
        ENNReal.ofReal (∫ y in chartAt E3 q '' (F ∩ (chartAt E3 q).source), sepDensDiv G Y y))
      X' ⟨ha, hb, hcU, hd, hbd⟩ le_rfl
  
  unfold hullRiemPer
  refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun h =>
    Finset.sum_le_sum fun k _ => ?_
  exact key (p k) (W k) (fun x hx => ((h.1 k).2 hx).2)

theorem hullRiemPer_congr_chartNull [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F F' U K : Set M) (h : sepChartNull (symmDiff F F')) : hullRiemPer g F U K = hullRiemPer g F' U K :=
by
  have key : ∀ (q : M) (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U' Kc : Set E3),
      hullPerG G (chartAt E3 q '' (F ∩ (chartAt E3 q).source)) U' Kc =
        hullPerG G (chartAt E3 q '' (F' ∩ (chartAt E3 q).source)) U' Kc := by
    intro q G U' Kc
    have hsub : symmDiff (chartAt E3 q '' (F ∩ (chartAt E3 q).source))
        (chartAt E3 q '' (F' ∩ (chartAt E3 q).source)) ⊆
        chartAt E3 q '' (symmDiff F F' ∩ (chartAt E3 q).source) := by
      intro y hy
      rcases Set.mem_symmDiff.1 hy with ⟨⟨x, ⟨hxF, hxS⟩, rfl⟩, hn⟩ | ⟨⟨x, ⟨hxF', hxS⟩, rfl⟩, hn⟩
      · exact ⟨x, ⟨Set.mem_symmDiff.2 (Or.inl ⟨hxF, fun h' => hn ⟨x, ⟨h', hxS⟩, rfl⟩⟩), hxS⟩, rfl⟩
      · exact ⟨x, ⟨Set.mem_symmDiff.2 (Or.inr ⟨hxF', fun h' => hn ⟨x, ⟨h', hxS⟩, rfl⟩⟩), hxS⟩, rfl⟩
    have hae := MeasureTheory.measure_symmDiff_eq_zero_iff.1
      (MeasureTheory.measure_mono_null hsub (h q))
    unfold hullPerG
    refine iSup_congr fun X => iSup_congr fun _ => ?_
    rw [MeasureTheory.setIntegral_congr_set hae]
  unfold hullRiemPer
  simp only [key]

theorem levelMeanCurv_congr_of_eventuallyEq [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (f₁ f₂ : M → ℝ) (p : M) (h : f₁ =ᶠ[𝓝 p] f₂) : g.levelMeanCurv f₁ p = g.levelMeanCurv f₂ p :=
by
  have hT : Filter.Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) :=
    (chartAt E3 p).tendsto_symm (mem_chart_source E3 p)
  have hF : (fun y => f₁ ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
      (fun y => f₂ ((chartAt E3 p).symm y)) := h.comp_tendsto hT
  have hD1 : ∀ a : Fin 3,
      partialDeriv a (fun y => f₁ ((chartAt E3 p).symm y)) (chartAt E3 p p) =
        partialDeriv a (fun y => f₂ ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
    intro a
    unfold partialDeriv
    rw [hF.fderiv_eq]
  have hD1' : ∀ j : Fin 3,
      partialDeriv j (fun y => f₁ ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        partialDeriv j (fun y => f₂ ((chartAt E3 p).symm y)) := by
    intro j
    filter_upwards [hF.fderiv (𝕜 := ℝ)] with z hz
    unfold partialDeriv
    rw [hz]
  have hD2 : ∀ i j : Fin 3,
      partialDeriv i (partialDeriv j (fun y => f₁ ((chartAt E3 p).symm y))) (chartAt E3 p p) =
        partialDeriv i (partialDeriv j (fun y => f₂ ((chartAt E3 p).symm y)))
          (chartAt E3 p p) := by
    intro i j
    show fderiv ℝ (partialDeriv j (fun y => f₁ ((chartAt E3 p).symm y))) (chartAt E3 p p) (e i) =
      fderiv ℝ (partialDeriv j (fun y => f₂ ((chartAt E3 p).symm y))) (chartAt E3 p p) (e i)
    rw [(hD1' j).fderiv_eq]
  have hH : ∀ i j : Fin 3,
      hessLoc (g.coeff (chartAt E3 p).symm) (fun y => f₁ ((chartAt E3 p).symm y)) i j
          (chartAt E3 p p) =
        hessLoc (g.coeff (chartAt E3 p).symm) (fun y => f₂ ((chartAt E3 p).symm y)) i j
          (chartAt E3 p p) := by
    intro i j
    simp only [hessLoc, hD2, hD1]
  have hL : lapLoc (g.coeff (chartAt E3 p).symm) (fun y => f₁ ((chartAt E3 p).symm y))
        (chartAt E3 p p) =
      lapLoc (g.coeff (chartAt E3 p).symm) (fun y => f₂ ((chartAt E3 p).symm y))
        (chartAt E3 p p) := by
    simp only [lapLoc, hH]
  have hN : g.gradInner f₁ f₁ p = g.gradInner f₂ f₂ p := by
    simp only [RiemannianMetric3.gradInner, hD1]
  simp only [RiemannianMetric3.levelMeanCurv]
  rw [hL, hN]
  simp only [hD1, hH]

theorem hull_field_inner_cut [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Λ : M → ℝ) (hΛ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ Λ) (hΛ01 : ∀ x, 0 ≤ Λ x ∧ Λ x ≤ 1) (K O W : Set M) (hO : IsOpen O) (hΛO : ∀ x ∈ O, Λ x = 1) (hKΛ : K ∩ tsupport Λ ⊆ O) (q : M) (hW : W ⊆ (chartAt E3 q).source) (X : E3 → E3) (hX : (∀ y, y ∉ chartAt E3 q '' (K ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ X y) ∧ HasCompactSupport X ∧ tsupport X ⊆ chartAt E3 q '' W ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * X y i * X y j ≤ 1) ∧ ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 q).symm) X y| ≤ C) : ∃ X' : E3 → E3, ((∀ y, y ∉ chartAt E3 q '' ((K \ O) ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ X' y) ∧ HasCompactSupport X' ∧ tsupport X' ⊆ chartAt E3 q '' W ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * X' y i * X' y j ≤ 1) ∧ ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 q).symm) X' y| ≤ C) ∧ ∀ y, y ∉ chartAt E3 q '' (tsupport Λ ∩ (chartAt E3 q).source) → sepDensDiv (g.coeff (chartAt E3 q).symm) X' y = sepDensDiv (g.coeff (chartAt E3 q).symm) X y :=
by
  classical
  obtain ⟨hXs, hXc, hXt, hXn, C0, hC0⟩ := hX
  
  have hpd : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  have hent : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y i j)
      (chartAt E3 q).target := fun i j => g.smooth q i j
  
  have hJ : ContDiffOn ℝ ∞ (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det)
      (chartAt E3 q).target := by
    have hdet : ContDiffOn ℝ ∞ (fun y => (g.coeff (chartAt E3 q).symm y).det)
        (chartAt E3 q).target := by
      simp only [Matrix.det_fin_three]
      have e3 := fun a b c d a' b' => ((hent a b).mul (hent c d)).mul (hent a' b')
      exact (((((e3 0 0 1 1 2 2).sub (e3 0 0 1 2 2 1)).sub (e3 0 1 1 0 2 2)).add
        (e3 0 1 1 2 2 0)).add (e3 0 2 1 0 2 1)).sub (e3 0 2 1 1 2 0)
    exact hdet.sqrt (fun y hy => (hpd y hy).det_pos.ne')
  have hTo : IsOpen (chartAt E3 q).target := (chartAt E3 q).open_target
  have hTX : tsupport X ⊆ (chartAt E3 q).target := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hXt hy
    exact (chartAt E3 q).map_source (hW hx)
  
  obtain ⟨lam, hlamdef⟩ : ∃ l : E3 → ℝ, l = fun y => Λ ((chartAt E3 q).symm y) := ⟨_, rfl⟩
  have hlamz : ∀ z, lam z = Λ ((chartAt E3 q).symm z) := by
    intro z; rw [hlamdef]
  have hlam : ContDiffOn ℝ ∞ lam (chartAt E3 q).target := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (Λ ∘ (chartAt E3 q).symm) (chartAt E3 q).target :=
      hΛ.comp_contMDiffOn contMDiffOn_chart_symm
    rw [hlamdef]; exact contMDiffOn_iff_contDiffOn.mp h1
  generalize hG : g.coeff (chartAt E3 q).symm = G at hpd hent hJ hXn hC0 ⊢
  
  have hloc : ∀ (Z₁ Z₂ : E3 → E3) (y : E3), Z₁ =ᶠ[𝓝 y] Z₂ →
      sepDensDiv G Z₁ y = sepDensDiv G Z₂ y := by
    intro Z₁ Z₂ y h
    unfold sepDensDiv partialDeriv
    refine Finset.sum_congr rfl fun i _ => ?_
    have h' : (fun z => Real.sqrt (G z).det * Z₁ z i) =ᶠ[𝓝 y]
        (fun z => Real.sqrt (G z).det * Z₂ z i) :=
      h.mono fun z hz => by simp only [hz]
    rw [h'.fderiv_eq]
  have hzero : ∀ (Z : E3 → E3) (y : E3), y ∉ tsupport Z → sepDensDiv G Z y = 0 := by
    intro Z y hy
    rw [hloc Z 0 y (notMem_tsupport_iff_eventuallyEq.1 hy)]
    simp [sepDensDiv, partialDeriv]
  have hdiv0 : ∀ y, sepDensDiv G (fun _ => (0 : E3)) y = 0 := by
    intro y
    simp [sepDensDiv, partialDeriv]
  have hcoord : ∀ (Z : E3 → E3) (y : E3), ContDiffAt ℝ ∞ Z y → ∀ i : Fin 3,
      ContDiffAt ℝ ∞ (fun z => Z z i) y := by
    intro Z y hZ i
    exact (contDiffAt_piLp _).1 hZ i
  
  have hbound : ∃ B : ℝ, ∀ y, ‖X y‖ ≤ B := by
    by_cases hne : (tsupport X).Nonempty
    swap
    · refine ⟨0, fun y => ?_⟩
      have hy : y ∉ tsupport X := fun h => hne ⟨y, h⟩
      rw [image_eq_zero_of_notMem_tsupport hy, norm_zero]
    obtain ⟨y₁, hy₁⟩ := hne
    obtain ⟨Q, hQdef⟩ : ∃ Q : E3 × E3 → ℝ,
        Q = fun p => ∑ i : Fin 3, ∑ j : Fin 3, G p.1 i j * p.2 i * p.2 j := ⟨_, rfl⟩
    have hQc : ContinuousOn Q ((chartAt E3 q).target ×ˢ Set.univ) := by
      rw [hQdef]
      refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
      have hc1 : ContinuousOn (fun p : E3 × E3 => G p.1 i j)
          ((chartAt E3 q).target ×ˢ Set.univ) :=
        (hent i j).continuousOn.comp continuousOn_fst (fun p hp => hp.1)
      have hc2 : Continuous (fun p : E3 × E3 => p.2 i) := by fun_prop
      have hc3 : Continuous (fun p : E3 × E3 => p.2 j) := by fun_prop
      exact (hc1.mul hc2.continuousOn).mul hc3.continuousOn
    have hSc : IsCompact (tsupport X ×ˢ Metric.sphere (0 : E3) 1) :=
      (HasCompactSupport.isCompact hXc).prod (isCompact_sphere _ _)
    have hSne : (tsupport X ×ˢ Metric.sphere (0 : E3) 1).Nonempty := by
      refine ⟨(y₁, e 0), hy₁, ?_⟩
      rw [mem_sphere_zero_iff_norm, EuclideanSpace.norm_single, norm_one]
    have hSsub : tsupport X ×ˢ Metric.sphere (0 : E3) 1 ⊆
        (chartAt E3 q).target ×ˢ Set.univ :=
      Set.prod_mono hTX (Set.subset_univ _)
    obtain ⟨p₀, hp₀, hmin⟩ := hSc.exists_isMinOn hSne (hQc.mono hSsub)
    have hcpos : 0 < Q p₀ := by
      have hy0 : p₀.1 ∈ (chartAt E3 q).target := hTX hp₀.1
      have hv0 : ‖p₀.2‖ = 1 := mem_sphere_zero_iff_norm.1 hp₀.2
      have hx : (fun i => p₀.2 i : Fin 3 → ℝ) ≠ 0 := by
        intro h0
        have h00 : p₀.2 = 0 := by
          ext i
          simpa using congrFun h0 i
        rw [h00, norm_zero] at hv0
        exact zero_ne_one hv0
      have h1 := (hpd p₀.1 hy0).dotProduct_mulVec_pos hx
      have h2 : star (fun i => p₀.2 i : Fin 3 → ℝ) ⬝ᵥ (G p₀.1).mulVec (fun i => p₀.2 i)
          = Q p₀ := by
        rw [hQdef]
        simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
        ring
      rw [← h2]; exact h1
    refine ⟨1 + 1 / Q p₀, fun y => ?_⟩
    have hBpos : 0 < 1 / Q p₀ := by positivity
    by_cases hy0 : X y = 0
    · rw [hy0, norm_zero]; linarith
    have hyX : y ∈ tsupport X := subset_tsupport _ hy0
    have hr : 0 < ‖X y‖ := norm_pos_iff.2 hy0
    have hv : (y, ‖X y‖⁻¹ • X y) ∈ tsupport X ×ˢ Metric.sphere (0 : E3) 1 := by
      refine ⟨hyX, ?_⟩
      rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hr.ne']
    have hle : Q p₀ ≤ Q (y, ‖X y‖⁻¹ • X y) := isMinOn_iff.1 hmin _ hv
    have hhom : Q (y, ‖X y‖⁻¹ • X y) = (‖X y‖⁻¹) ^ 2 * Q (y, X y) := by
      rw [hQdef]
      simp only [PiLp.smul_apply, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
        Fin.sum_univ_three]
      ring
    have hQy : Q (y, X y) ≤ 1 := by rw [hQdef]; exact hXn y
    have h1 : Q p₀ ≤ (‖X y‖⁻¹) ^ 2 := by
      calc Q p₀ ≤ (‖X y‖⁻¹) ^ 2 * Q (y, X y) := hle.trans_eq hhom
        _ ≤ (‖X y‖⁻¹) ^ 2 * 1 := mul_le_mul_of_nonneg_left hQy (sq_nonneg _)
        _ = _ := mul_one _
    have h2 : Q p₀ * ‖X y‖ ^ 2 ≤ 1 := by
      have h3 := mul_le_mul_of_nonneg_right h1 (sq_nonneg ‖X y‖)
      rwa [← mul_pow, inv_mul_cancel₀ hr.ne', one_pow] at h3
    have h3 : ‖X y‖ ^ 2 ≤ 1 / Q p₀ := by rw [le_div_iff₀ hcpos]; linarith
    by_cases hr1 : ‖X y‖ ≤ 1
    · linarith
    · push_neg at hr1
      have h4 : ‖X y‖ ≤ ‖X y‖ ^ 2 := by nlinarith
      linarith
  obtain ⟨B, hB⟩ := hbound
  
  have hDex : ∃ D : ℝ, ∀ y ∈ tsupport X, ∀ i : Fin 3,
      |partialDeriv i lam y * Real.sqrt (G y).det| ≤ D := by
    have hfd : ContinuousOn (fun y => fderiv ℝ lam y) (chartAt E3 q).target :=
      hlam.continuousOn_fderiv_of_isOpen hTo (by simp)
    have hcont : ContinuousOn
        (fun y => ∑ i : Fin 3, |partialDeriv i lam y * Real.sqrt (G y).det|)
        (chartAt E3 q).target := by
      unfold partialDeriv
      exact continuousOn_finset_sum _ fun i _ =>
        ((hfd.clm_apply continuousOn_const).mul hJ.continuousOn).abs
    obtain ⟨D, hD⟩ :=
      (HasCompactSupport.isCompact hXc).exists_bound_of_continuousOn (hcont.mono hTX)
    refine ⟨D, fun y hy i => ?_⟩
    have h1 := hD y hy
    rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg fun _ _ => abs_nonneg _)] at h1
    exact le_trans (Finset.single_le_sum
      (f := fun i => |partialDeriv i lam y * Real.sqrt (G y).det|)
      (fun _ _ => abs_nonneg _) (Finset.mem_univ i)) h1
  obtain ⟨D, hD⟩ := hDex
  
  have hO1 : ∀ y ∈ (chartAt E3 q).target, (chartAt E3 q).symm y ∈ O →
      (fun z => (1 - lam z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
    intro y hy hyO
    have h1 : ∀ᶠ z in 𝓝 y, (chartAt E3 q).symm z ∈ O :=
      ((chartAt E3 q).continuousAt_symm hy).preimage_mem_nhds (hO.mem_nhds hyO)
    filter_upwards [h1] with z hz
    rw [hlamz, hΛO _ hz, sub_self, zero_smul]
  have hO0 : ∀ y ∈ (chartAt E3 q).target, (chartAt E3 q).symm y ∉ tsupport Λ →
      (fun z => (1 - lam z) • X z) =ᶠ[𝓝 y] X := by
    intro y hy hyL
    have h1 : ∀ᶠ z in 𝓝 y, (chartAt E3 q).symm z ∈ (tsupport Λ)ᶜ :=
      ((chartAt E3 q).continuousAt_symm hy).preimage_mem_nhds
        ((isClosed_tsupport Λ).isOpen_compl.mem_nhds hyL)
    filter_upwards [h1] with z hz
    rw [hlamz, image_eq_zero_of_notMem_tsupport hz, sub_zero, one_smul]
  
  have hsm : ∀ y, y ∉ chartAt E3 q '' ((K \ O) ∩ (chartAt E3 q).source) →
      ContDiffAt ℝ ∞ (fun z => (1 - lam z) • X z) y := by
    intro y hy
    by_cases hyT : y ∈ (chartAt E3 q).target
    · by_cases hyK : y ∈ chartAt E3 q '' (K ∩ (chartAt E3 q).source)
      · obtain ⟨k, ⟨hkK, hks⟩, rfl⟩ := hyK
        have hkO : k ∈ O := by
          by_contra hkO
          exact hy ⟨k, ⟨⟨hkK, hkO⟩, hks⟩, rfl⟩
        have h0 := hO1 _ hyT (by rw [(chartAt E3 q).left_inv hks]; exact hkO)
        exact contDiffAt_const.congr_of_eventuallyEq h0
      · exact (contDiffAt_const.sub (hlam.contDiffAt (hTo.mem_nhds hyT))).smul (hXs y hyK)
    · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 (fun h => hyT (hTX h))
      have h1 : (fun z => (1 - lam z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        filter_upwards [h0] with z hz
        simp [hz]
      exact contDiffAt_const.congr_of_eventuallyEq h1
  have hcs : HasCompactSupport (fun z => (1 - lam z) • X z) :=
    HasCompactSupport.intro hXc (fun y hy => by simp [image_eq_zero_of_notMem_tsupport hy])
  have hts1 : tsupport (fun z => (1 - lam z) • X z) ⊆ tsupport X :=
    tsupport_smul_subset_right (fun z => 1 - lam z) X
  have hts : tsupport (fun z => (1 - lam z) • X z) ⊆ chartAt E3 q '' W := hts1.trans hXt
  have hnorm : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      G y i j * ((1 - lam y) • X y) i * ((1 - lam y) • X y) j ≤ 1 := by
    intro y
    have hQ := hXn y
    have hl01 := hΛ01 ((chartAt E3 q).symm y)
    have h0 : 0 ≤ 1 - lam y := by rw [hlamz]; linarith
    have h1 : 1 - lam y ≤ 1 := by rw [hlamz]; linarith
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3,
        G y i j * ((1 - lam y) • X y) i * ((1 - lam y) • X y) j
        = (1 - lam y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
      simp only [PiLp.smul_apply, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
        Fin.sum_univ_three]
      ring
    rw [e1]
    have h2 : (1 - lam y) ^ 2 ≤ 1 := pow_le_one₀ h0 h1
    have h3 := mul_le_mul_of_nonneg_left hQ (sq_nonneg (1 - lam y))
    linarith
  
  have hagree : ∀ y, y ∉ chartAt E3 q '' (tsupport Λ ∩ (chartAt E3 q).source) →
      sepDensDiv G (fun z => (1 - lam z) • X z) y = sepDensDiv G X y := by
    intro y hy
    by_cases hyT : y ∈ (chartAt E3 q).target
    · have hL : (chartAt E3 q).symm y ∉ tsupport Λ := by
        intro h
        exact hy ⟨_, ⟨h, (chartAt E3 q).map_target hyT⟩, (chartAt E3 q).right_inv hyT⟩
      exact hloc _ _ y (hO0 y hyT hL)
    · have h1 : y ∉ tsupport X := fun h => hyT (hTX h)
      rw [hzero _ y h1, hzero _ y (fun h => h1 (hts1 h))]
  
  have hbd : ∀ y, |sepDensDiv G (fun z => (1 - lam z) • X z) y| ≤ |C0| + 3 * (|D| * |B|) := by
    intro y
    have hpos : 0 ≤ |C0| + 3 * (|D| * |B|) := by positivity
    have hC0' : |sepDensDiv G X y| ≤ |C0| := (hC0 y).trans (le_abs_self _)
    have hDB : 0 ≤ |D| * |B| := by positivity
    by_cases hyT : y ∈ (chartAt E3 q).target
    · by_cases hyK : y ∈ chartAt E3 q '' (K ∩ (chartAt E3 q).source)
      · obtain ⟨k, ⟨hkK, hks⟩, rfl⟩ := hyK
        by_cases hkO : k ∈ O
        · rw [hloc _ _ _ (hO1 _ hyT (by rw [(chartAt E3 q).left_inv hks]; exact hkO)), hdiv0,
            abs_zero]
          exact hpos
        · have hkL : k ∉ tsupport Λ := fun h => hkO (hKΛ ⟨hkK, h⟩)
          rw [hloc _ _ _ (hO0 _ hyT (by rw [(chartAt E3 q).left_inv hks]; exact hkL))]
          linarith
      · by_cases hyX : y ∈ tsupport X
        · have hXy := hXs y hyK
          have hJy := hJ.contDiffAt (hTo.mem_nhds hyT)
          have hly : DifferentiableAt ℝ lam y :=
            (hlam.contDiffAt (hTo.mem_nhds hyT)).differentiableAt (by simp)
          have hh : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * X z i) y :=
            fun i => (hJy.mul (hcoord X y hXy i)).differentiableAt (by simp)
          have hprod : sepDensDiv G (fun z => (1 - lam z) • X z) y =
              (1 - lam y) * sepDensDiv G X y -
                ∑ i : Fin 3, partialDeriv i lam y * (Real.sqrt (G y).det * X y i) := by
            unfold sepDensDiv partialDeriv
            rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            have e1 : (fun z => Real.sqrt (G z).det * ((1 - lam z) • X z) i) =
                fun z => (1 - lam z) * (Real.sqrt (G z).det * X z i) := by
              funext z
              simp only [PiLp.smul_apply, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul]
              ring
            have h3 : HasFDerivAt (fun z => (1 - lam z) * (Real.sqrt (G z).det * X z i))
                ((1 - lam y) • fderiv ℝ (fun z => Real.sqrt (G z).det * X z i) y +
                  (Real.sqrt (G y).det * X y i) • (0 - fderiv ℝ lam y)) y :=
              ((hasFDerivAt_const (1 : ℝ) y).sub hly.hasFDerivAt).mul (hh i).hasFDerivAt
            rw [e1, h3.fderiv]
            simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
              ContinuousLinearMap.sub_apply, ContinuousLinearMap.zero_apply, smul_eq_mul]
            ring
          rw [hprod]
          have hl01 := hΛ01 ((chartAt E3 q).symm y)
          have hlz := hlamz y
          have t1 : |(1 - lam y) * sepDensDiv G X y| ≤ |C0| := by
            rw [abs_mul, abs_of_nonneg (by rw [hlz]; linarith)]
            calc (1 - lam y) * |sepDensDiv G X y| ≤ 1 * |sepDensDiv G X y| :=
                  mul_le_mul_of_nonneg_right (by rw [hlz]; linarith) (abs_nonneg _)
              _ ≤ |C0| := by rw [one_mul]; exact hC0'
          have t2 : ∀ i : Fin 3,
              |partialDeriv i lam y * (Real.sqrt (G y).det * X y i)| ≤ |D| * |B| := by
            intro i
            have e : partialDeriv i lam y * (Real.sqrt (G y).det * X y i) =
                (partialDeriv i lam y * Real.sqrt (G y).det) * X y i := by ring
            rw [e, abs_mul]
            have hXi : |X y i| ≤ |B| := by
              have h5 := PiLp.norm_apply_le (X y) i
              rw [Real.norm_eq_abs] at h5
              exact h5.trans ((hB y).trans (le_abs_self _))
            exact mul_le_mul ((hD y hyX i).trans (le_abs_self _)) hXi (abs_nonneg _)
              (abs_nonneg _)
          have t3 : |∑ i : Fin 3, partialDeriv i lam y * (Real.sqrt (G y).det * X y i)| ≤
              3 * (|D| * |B|) := by
            refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
            rw [Fin.sum_univ_three]
            linarith [t2 0, t2 1, t2 2]
          have a1 := abs_le.1 t1
          have a3 := abs_le.1 t3
          rw [abs_le]
          constructor <;> linarith [a1.1, a1.2, a3.1, a3.2]
        · rw [hzero _ y (fun h => hyX (hts1 h)), abs_zero]
          exact hpos
    · rw [hzero _ y (fun h => hyT (hTX (hts1 h))), abs_zero]
      exact hpos
  exact ⟨fun z => (1 - lam z) • X z, ⟨hsm, hcs, hts, hnorm, ⟨_, hbd⟩⟩, hagree⟩

theorem chart_Nsq_pos [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (p : M) (y : E3) (hy : y ∈ (chartAt E3 p).target) (hd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ ((chartAt E3 p).symm y) ≠ 0) : 0 < ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ a b * partialDeriv a (fun z => ρ ((chartAt E3 p).symm z)) y * partialDeriv b (fun z => ρ ((chartAt E3 p).symm z)) y :=
by
  classical
  have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
  have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
    mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
  have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
    mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
  
  have hG : (g.coeff (chartAt E3 p).symm y).PosDef := by
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have hGi : ((g.coeff (chartAt E3 p).symm y)⁻¹).PosDef := hG.inv
  
  have hρx : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ ((chartAt E3 p).symm y) :=
    hρ.mdifferentiableAt (by simp)
  have hfc : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (ρ ∘ (chartAt E3 p).symm) y :=
    MDifferentiableAt.comp y hρx hf
  have hκx : (chartAt E3 p) ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hy
  have hfc' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (ρ ∘ (chartAt E3 p).symm)
      ((chartAt E3 p) ((chartAt E3 p).symm y)) := by
    rw [hκx]; exact hfc
  have hloc : ((ρ ∘ (chartAt E3 p).symm) ∘ (chartAt E3 p)) =ᶠ[𝓝 ((chartAt E3 p).symm y)] ρ := by
    filter_upwards [(chartAt E3 p).eventually_left_inverse hq] with z hz
    simp [Function.comp, hz]
  have hchain0 := mfderiv_comp ((chartAt E3 p).symm y) hfc' hg
  rw [hloc.mfderiv_eq, hκx, mfderiv_eq_fderiv] at hchain0
  
  set ξ : Fin 3 → ℝ := fun a => partialDeriv a (fun z => ρ ((chartAt E3 p).symm z)) y with hξdef
  have hξ : ξ ≠ 0 := by
    intro h0
    apply hd
    rw [hchain0]
    have hz : fderiv ℝ (ρ ∘ (chartAt E3 p).symm) y = 0 := by
      ext u
      have hu : u = ∑ a, u a • e a := by
        ext j
        fin_cases j <;> simp [e, Fin.sum_univ_three, EuclideanSpace.single_apply]
      have hb : ∀ a, fderiv ℝ (ρ ∘ (chartAt E3 p).symm) y (e a) = 0 := by
        intro a
        have := congrFun h0 a
        exact this
      rw [hu, map_sum]
      simp [map_smul, hb]
    rw [hz, ContinuousLinearMap.zero_comp]
  
  have hpos := hGi.dotProduct_mulVec_pos hξ
  have heq : star ξ ⬝ᵥ ((g.coeff (chartAt E3 p).symm y)⁻¹).mulVec ξ =
      ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ a b *
        partialDeriv a (fun z => ρ ((chartAt E3 p).symm z)) y *
        partialDeriv b (fun z => ρ ((chartAt E3 p).symm z)) y := by
    simp only [hξdef, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
    ring
  rw [← heq]
  exact hpos

theorem slab_blend_field [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ Θ : M → ℝ) (T : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hT : IsOpen T) (hN : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → (chartAt E3 q).symm y ∈ T → 0 < ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ a b * partialDeriv a (fun z => ρ ((chartAt E3 q).symm z)) y * partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y) (hΘ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ Θ) (hΘ01 : ∀ x, 0 ≤ Θ x ∧ Θ x ≤ 1) (hΘT : tsupport Θ ⊆ T) (Y : M → E3) (hY : calSmoothField Y) (hY1 : ∀ x, g.g x (Y x) (Y x) ≤ 1) : ∃ V Z : M → E3, calSmoothField V ∧ (∀ x, g.g x (V x) (V x) ≤ 1) ∧ calSmoothField Z ∧ ∀ q : M, ∀ y ∈ (chartAt E3 q).target, ∀ wV wY wZ : E3, wV = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) (V ((chartAt E3 q).symm y)) → wY = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) (Y ((chartAt E3 q).symm y)) → wZ = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) (Z ((chartAt E3 q).symm y)) → ∀ i : Fin 3, wV i = (1 - Θ ((chartAt E3 q).symm y)) * wY i + Θ ((chartAt E3 q).symm y) * calUnitNormal (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) y i ∧ wZ i = Θ ((chartAt E3 q).symm y) * calUnitNormal (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) y i :=
by
  classical
  
  have bilin_riesz : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ),
      (∀ v : E3, v ≠ 0 → 0 < B v v) → ∀ (ℓ : E3 →L[ℝ] ℝ), ∃ v : E3, ∀ w : E3, B v w = ℓ w := by
    intro B hpos ℓ
    let D := InnerProductSpace.toDual ℝ E3
    let Tm : E3 →ₗ[ℝ] E3 :=
      { toFun := fun v => D.symm (B v)
        map_add' := fun v w => by simp
        map_smul' := fun c v => by simp }
    have hinj : Function.Injective Tm := by
      intro v w hvw
      have h1 : B v = B w := by
        have := congrArg D hvw
        simpa [Tm] using this
      by_contra hne
      have h2 := hpos (v - w) (sub_ne_zero.mpr hne)
      have h3 : B (v - w) = 0 := by rw [map_sub, h1, sub_self]
      rw [h3] at h2
      simp at h2
    have hsurj := LinearMap.injective_iff_surjective.mp hinj
    obtain ⟨v, hv⟩ := hsurj (D.symm ℓ)
    refine ⟨v, fun w => ?_⟩
    have h1 : B v = ℓ := by
      have := congrArg D hv
      simpa [Tm] using this
    rw [h1]
  
  have blend_quad_le : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v w : E3, B v w = B w v) →
      (∀ v : E3, 0 ≤ B v v) → ∀ (Y₀ X₀ : E3), B Y₀ Y₀ ≤ 1 → B X₀ X₀ = 1 → ∀ (θ : ℝ),
      0 ≤ θ → θ ≤ 1 →
      B ((1 - θ) • Y₀ + θ • X₀) ((1 - θ) • Y₀ + θ • X₀) ≤ 1 := by
    intro B hsymm hpsd Y₀ X₀ hY₀ hX₀ θ hθ0 hθ1
    have hcs := hpsd (Y₀ - (B Y₀ X₀) • X₀)
    have hXY : B X₀ Y₀ = B Y₀ X₀ := hsymm X₀ Y₀
    simp only [map_sub, map_smul, ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, hX₀, hXY] at hcs
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, hX₀, hXY]
    have hc2 : B Y₀ X₀ ^ 2 ≤ 1 := by nlinarith
    have hc := abs_le.mp (sq_le_one_iff_abs_le_one (B Y₀ X₀) |>.mp hc2)
    have ha : 0 ≤ 1 - θ := sub_nonneg.2 hθ1
    nlinarith [mul_nonneg (mul_nonneg ha ha) (sub_nonneg.2 hY₀),
      mul_nonneg (mul_nonneg ha hθ0) (sub_nonneg.2 hc.2)]
  
  have hposdef : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target →
      (g.coeff (chartAt E3 q).symm y).PosDef := by
    intro q y hy
    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three,
          map_add, ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply,
          star_trivial, RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have grad_chart_rep : ∀ (N : M → E3),
      (∀ (x : M) (w : E3), g.g x (N x) w = (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ x w : ℝ)) →
      ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ (w : E3),
      w = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (N ((chartAt E3 q).symm y)) →
      (∀ i : Fin 3, w i = ∑ k : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i k *
        partialDeriv k (fun z => ρ ((chartAt E3 q).symm z)) y) ∧
      g.g ((chartAt E3 q).symm y) (N ((chartAt E3 q).symm y)) (N ((chartAt E3 q).symm y)) =
        ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ a b *
          partialDeriv a (fun z => ρ ((chartAt E3 q).symm z)) y *
          partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y := by
    intro N hN0 q y hy w hw
    have hx : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hx
    have hinv : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y v) = v := by
      have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
      have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
        apply Filter.EventuallyEq.mfderiv_eq
        filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
        exact hz
      rw [mfderiv_id] at hid
      intro v
      have h1 := congrArg (fun L => L v) (hcomp.symm.trans hid)
      simpa using h1
    obtain ⟨K, hK⟩ : ∃ K : E3 →L[ℝ] E3,
        K = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) := ⟨_, rfl⟩
    obtain ⟨L, hL⟩ : ∃ L : E3 →L[ℝ] E3,
        L = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y := ⟨_, rfl⟩
    have hKL : ∀ v, K (L v) = v := by intro v; rw [hK, hL]; exact hinv v
    have hKinj : Function.Injective K := by
      have hsurj : Function.Surjective (K : E3 →ₗ[ℝ] E3) := fun v => ⟨L v, hKL v⟩
      exact LinearMap.injective_iff_surjective.mpr hsurj
    have hLK : ∀ v, L (K v) = v := fun v => hKinj (hKL (K v))
    have hρd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ ((chartAt E3 q).symm y) :=
      hρ.mdifferentiableAt (by simp)
    have hchain : ∀ b : Fin 3, partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ ((chartAt E3 q).symm y) (L (e b)) := by
      intro b
      have h1 := mfderiv_comp y hρd hf
      rw [mfderiv_eq_fderiv] at h1
      unfold partialDeriv
      rw [show (fun z => ρ ((chartAt E3 q).symm z)) = ρ ∘ (chartAt E3 q).symm from rfl, h1, hL]
      rfl
    have hw' : L w = N ((chartAt E3 q).symm y) := by rw [hw, ← hK]; exact hLK _
    have hexp : w = ∑ a : Fin 3, w a • e a := by
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, e, EuclideanSpace.single_apply]
    have h1 : ∀ b : Fin 3, g.g ((chartAt E3 q).symm y) (L w) (L (e b)) =
        ∑ a : Fin 3, w a * g.coeff (chartAt E3 q).symm y a b := by
      intro b
      conv_lhs => rw [hexp]
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul, RiemannianMetric3.coeff, coeffMatrix, hL]
      rfl
    have hsys : ∀ b : Fin 3, ∑ a : Fin 3, w a * g.coeff (chartAt E3 q).symm y a b =
        partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y := by
      intro b
      rw [← h1 b, hw', hN0, hchain b]
    have hmv : (g.coeff (chartAt E3 q).symm y).mulVec (fun a => w a) =
        fun b => partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y := by
      funext b
      rw [← hsys b]
      simp only [Matrix.mulVec, dotProduct]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      have hs : g.coeff (chartAt E3 q).symm y b a = g.coeff (chartAt E3 q).symm y a b := by
        simp only [RiemannianMetric3.coeff, coeffMatrix]
        exact g.symm _ _ _
      rw [hs]
      ring
    have hdet : IsUnit (g.coeff (chartAt E3 q).symm y).det :=
      isUnit_iff_ne_zero.mpr (hposdef q y hy).det_pos.ne'
    have hsol : (fun a => w a) = ((g.coeff (chartAt E3 q).symm y)⁻¹).mulVec
        (fun b => partialDeriv b (fun z => ρ ((chartAt E3 q).symm z)) y) := by
      have h2 := congrArg (fun v => ((g.coeff (chartAt E3 q).symm y)⁻¹).mulVec v) hmv
      simp only [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hdet, Matrix.one_mulVec] at h2
      exact h2
    have hcomp : ∀ i : Fin 3, w i = ∑ k : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i k *
        partialDeriv k (fun z => ρ ((chartAt E3 q).symm z)) y := by
      intro i
      have h2 := congrFun hsol i
      simpa [Matrix.mulVec, dotProduct] using h2
    refine ⟨hcomp, ?_⟩
    have h3 : ∀ c : E3 →L[ℝ] ℝ, c (L w) = ∑ b : Fin 3, w b * c (L (e b)) := by
      intro c
      conv_lhs => rw [hexp]
      simp only [map_sum, map_smul, smul_eq_mul]
    rw [← hw', h3 (g.g _ (L w))]
    simp only [h1, hsys]
    simp only [hcomp, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    ring
  
  have unit_normal_contDiffOn : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
      (S : Set E3), IsOpen S → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) S) →
      (∀ z ∈ S, 0 < (G z).det) → ContDiffOn ℝ ∞ f S → ∀ (n : E3 → E3),
      (∀ z ∈ S, ∀ i : Fin 3, n z i = calUnitNormal G f z i) →
      ContDiffOn ℝ ∞ n {z : E3 | z ∈ S ∧
        0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} := by
    intro G f S hS hG hdet hf n hn
    have hdetT : ContDiffOn ℝ ∞ (fun y => (G y).det) S := by
      have e : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
          - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three _
      rw [e]
      have h := hG
      exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    have hdinv : ContDiffOn ℝ ∞ (fun z => ((G z).det)⁻¹) S :=
      hdetT.inv (fun z hz => (hdet z hz).ne')
    have h00 := hG 0 0
    have h01 := hG 0 1
    have h02 := hG 0 2
    have h10 := hG 1 0
    have h11 := hG 1 1
    have h12 := hG 1 2
    have h20 := hG 2 0
    have h21 := hG 2 1
    have h22 := hG 2 2
    have hadj : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z).adjugate a b) S := by
      intro a b
      fin_cases a <;> fin_cases b <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
    have hinvE : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ a b) S := by
      intro a b
      have e1 : (fun z => (G z)⁻¹ a b) = fun z => ((G z).det)⁻¹ * (G z).adjugate a b := by
        funext z
        rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      rw [e1]
      exact hdinv.mul (hadj a b)
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) S := hf.fderiv_of_isOpen hS (by simp)
    have hpd : ∀ k : Fin 3, ContDiffOn ℝ ∞ (fun z => partialDeriv k f z) S := fun k =>
      hfd.clm_apply contDiffOn_const
    have hNsq : ContDiffOn ℝ ∞ (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
        (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) S :=
      ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun b _ => ((hinvE a b).mul (hpd a)).mul (hpd b)))
    have hST : {z : E3 | z ∈ S ∧
        0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} ⊆ S :=
      fun z hz => hz.1
    rw [contDiffOn_piLp]
    intro i
    have hc : ContDiffOn ℝ ∞ (fun z => calUnitNormal G f z i) {z : E3 | z ∈ S ∧
        0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} :=
      (((hNsq.mono hST).sqrt (fun z hz => hz.2.ne')).inv
        (fun z hz => (Real.sqrt_pos.2 hz.2).ne')).mul
        ((ContDiffOn.sum (fun k _ => (hinvE i k).mul (hpd k))).mono hST)
    exact hc.congr (fun z hz => hn z hz.1 i)
  
  have blend_local_smooth : ∀ (S : Set E3), IsOpen S → ∀ (th : E3 → ℝ),
      ContDiffOn ℝ ∞ th S → ∀ (Yt n : E3 → E3), ContDiffOn ℝ ∞ Yt S → ∀ (U : Set E3),
      IsOpen U → ContDiffOn ℝ ∞ n (S ∩ U) →
      (∀ z ∈ S, z ∉ U → ∃ u : Set E3, IsOpen u ∧ z ∈ u ∧ ∀ z' ∈ S ∩ u, th z' = 0) →
      ContDiffOn ℝ ∞ (fun z => (1 - th z) • Yt z + th z • n z) S ∧
      ContDiffOn ℝ ∞ (fun z => th z • n z) S := by
    intro S hS th hth Yt n hYt U hU hn hzero
    constructor
    · apply contDiffOn_of_locally_contDiffOn
      intro z hz
      by_cases hzU : z ∈ U
      · refine ⟨U, hU, hzU, ?_⟩
        exact ((contDiffOn_const.sub (hth.mono Set.inter_subset_left)).smul
          (hYt.mono Set.inter_subset_left)).add ((hth.mono Set.inter_subset_left).smul hn)
      · obtain ⟨u, hu, hzu, hu0⟩ := hzero z hz hzU
        refine ⟨u, hu, hzu, ?_⟩
        refine (hYt.mono Set.inter_subset_left).congr (fun z' hz' => ?_)
        simp [hu0 z' hz']
    · apply contDiffOn_of_locally_contDiffOn
      intro z hz
      by_cases hzU : z ∈ U
      · refine ⟨U, hU, hzU, ?_⟩
        exact (hth.mono Set.inter_subset_left).smul hn
      · obtain ⟨u, hu, hzu, hu0⟩ := hzero z hz hzU
        refine ⟨u, hu, hzu, ?_⟩
        refine (contDiffOn_const (c := (0 : E3))).congr (fun z' hz' => ?_)
        simp [hu0 z' hz']
  
  choose Nr hNr using fun x : M => bilin_riesz (g.g x) (g.posDef x)
    (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ x : E3 →L[ℝ] ℝ)
  have hNr' : ∀ (x : M) (w : E3), g.g x (Nr x) w = (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ρ x w : ℝ) :=
    fun x w => hNr x w
  obtain ⟨X, hX⟩ : ∃ X : M → E3, ∀ x, X x = (Real.sqrt (g.g x (Nr x) (Nr x)))⁻¹ • Nr x :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : M → E3, ∀ x, V x = (1 - Θ x) • Y x + Θ x • X x := ⟨_, fun _ => rfl⟩
  obtain ⟨Z, hZ⟩ : ∃ Z : M → E3, ∀ x, Z x = Θ x • X x := ⟨_, fun _ => rfl⟩
  
  have hpos : ∀ x ∈ T, 0 < g.g x (Nr x) (Nr x) := by
    intro x hxT
    have h2 := (grad_chart_rep Nr hNr' x (chartAt E3 x x) (mem_chart_target E3 x) _ rfl).2
    rw [(chartAt E3 x).left_inv (mem_chart_source E3 x)] at h2
    rw [h2]
    exact hN x (chartAt E3 x x) (mem_chart_target E3 x)
      (by rw [(chartAt E3 x).left_inv (mem_chart_source E3 x)]; exact hxT)
  
  have hrepX : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ w : E3,
      w = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (X ((chartAt E3 q).symm y)) → ∀ i : Fin 3,
      w i = calUnitNormal (g.coeff (chartAt E3 q).symm)
        (fun z => ρ ((chartAt E3 q).symm z)) y i := by
    intro q y hy w hw i
    obtain ⟨u, hu⟩ : ∃ u : E3, u = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 q).symm y) (Nr ((chartAt E3 q).symm y)) := ⟨_, rfl⟩
    obtain ⟨h1, h2⟩ := grad_chart_rep Nr hNr' q y hy u hu
    have hwu : w = (Real.sqrt (g.g ((chartAt E3 q).symm y) (Nr ((chartAt E3 q).symm y))
        (Nr ((chartAt E3 q).symm y))))⁻¹ • u := by
      rw [hw, hu, hX, map_smul]
    rw [hwu, PiLp.smul_apply, smul_eq_mul, h1 i, h2]
    rfl
  
  have hrep : ∀ q : M, ∀ y ∈ (chartAt E3 q).target, ∀ wV wY wZ : E3,
        wV = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (V ((chartAt E3 q).symm y)) →
        wY = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (Y ((chartAt E3 q).symm y)) →
        wZ = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (Z ((chartAt E3 q).symm y)) →
        ∀ i : Fin 3,
          wV i = (1 - Θ ((chartAt E3 q).symm y)) * wY i +
            Θ ((chartAt E3 q).symm y) *
              calUnitNormal (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) y i ∧
          wZ i = Θ ((chartAt E3 q).symm y) *
              calUnitNormal (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) y i := by
    intro q y hy wV wY wZ hwV hwY hwZ i
    obtain ⟨wX, hwX⟩ : ∃ wX : E3, wX = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 q).symm y) (X ((chartAt E3 q).symm y)) := ⟨_, rfl⟩
    have hX' := hrepX q y hy wX hwX i
    have eV : wV = (1 - Θ ((chartAt E3 q).symm y)) • wY +
        Θ ((chartAt E3 q).symm y) • wX := by
      rw [hwV, hwY, hwX, hV, map_add, map_smul, map_smul]
    have eZ : wZ = Θ ((chartAt E3 q).symm y) • wX := by
      rw [hwZ, hwX, hZ, map_smul]
    constructor
    · rw [eV, PiLp.add_apply, PiLp.smul_apply, PiLp.smul_apply, smul_eq_mul, smul_eq_mul, hX']
    · rw [eZ, PiLp.smul_apply, smul_eq_mul, hX']
  
  have hnorm : ∀ x, g.g x (V x) (V x) ≤ 1 := by
    intro x
    rw [hV x]
    by_cases hx0 : Θ x = 0
    · rw [hx0]
      simpa using hY1 x
    · have hxT : x ∈ T := hΘT (subset_tsupport Θ (Function.mem_support.mpr hx0))
      have hn := hpos x hxT
      have hX1 : g.g x (X x) (X x) = 1 := by
        simp only [hX x, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
        rw [← mul_assoc, ← mul_inv, Real.mul_self_sqrt hn.le, inv_mul_cancel₀ hn.ne']
      have hpsd : ∀ v : E3, 0 ≤ g.g x v v := by
        intro v
        by_cases hv : v = 0
        · subst hv; simp
        · exact (g.posDef x v hv).le
      exact blend_quad_le (g.g x) (g.symm x) hpsd (Y x) (X x) (hY1 x) hX1
        (Θ x) (hΘ01 x).1 (hΘ01 x).2
  
  have hsm : ∀ q : M,
      ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 q).symm y) (V ((chartAt E3 q).symm y)) : E3)) (chartAt E3 q).target ∧
      ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 q).symm y) (Z ((chartAt E3 q).symm y)) : E3)) (chartAt E3 q).target := by
    intro q
    have hS : IsOpen (chartAt E3 q).target := (chartAt E3 q).open_target
    have hf : ContDiffOn ℝ ∞ (fun z => ρ ((chartAt E3 q).symm z)) (chartAt E3 q).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ρ ∘ (chartAt E3 q).symm)
          (chartAt E3 q).target :=
        hρ.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have hth : ContDiffOn ℝ ∞ (fun z => Θ ((chartAt E3 q).symm z)) (chartAt E3 q).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (Θ ∘ (chartAt E3 q).symm)
          (chartAt E3 q).target :=
        hΘ.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have hn3 := unit_normal_contDiffOn (g.coeff (chartAt E3 q).symm)
      (fun z => ρ ((chartAt E3 q).symm z)) (chartAt E3 q).target hS (fun i j => g.smooth q i j)
      (fun z hz => (hposdef q z hz).det_pos) hf
      (fun z => WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 q).symm)
        (fun z => ρ ((chartAt E3 q).symm z)) z i)) (fun z _ i => rfl)
    have hU : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' T) :=
      (chartAt E3 q).isOpen_inter_preimage_symm hT
    have hn5 : ContDiffOn ℝ ∞ (fun z => (WithLp.toLp 2 (fun i => calUnitNormal
        (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) z i) : E3))
        ((chartAt E3 q).target ∩ ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' T)) :=
      hn3.mono (fun z hz => ⟨hz.1, hN q z hz.1 hz.2.2⟩)
    have hzero : ∀ z ∈ (chartAt E3 q).target,
        z ∉ (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' T →
        ∃ u : Set E3, IsOpen u ∧ z ∈ u ∧ ∀ z' ∈ (chartAt E3 q).target ∩ u,
          (fun z => Θ ((chartAt E3 q).symm z)) z' = 0 := by
      intro z hz hzU
      have hzT : (chartAt E3 q).symm z ∉ T := fun h => hzU ⟨hz, h⟩
      have hzs : (chartAt E3 q).symm z ∉ tsupport Θ := fun h => hzT (hΘT h)
      refine ⟨(chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (tsupport Θ)ᶜ,
        (chartAt E3 q).isOpen_inter_preimage_symm (isClosed_tsupport Θ).isOpen_compl,
        ⟨hz, hzs⟩, fun z' hz' => ?_⟩
      exact image_eq_zero_of_notMem_tsupport hz'.2.2
    have h5 := blend_local_smooth (chartAt E3 q).target hS
      (fun z => Θ ((chartAt E3 q).symm z)) hth
      (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (Y ((chartAt E3 q).symm y)) : E3))
      (fun z => (WithLp.toLp 2 (fun i => calUnitNormal
        (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) z i) : E3))
      (hY q) _ hU hn5 hzero
    constructor
    · refine h5.1.congr (fun y hy => ?_)
      refine PiLp.ext (fun i => ?_)
      beta_reduce
      rw [(hrep q y hy _ _ _ rfl rfl rfl i).1, PiLp.add_apply, PiLp.smul_apply, PiLp.smul_apply,
        smul_eq_mul, smul_eq_mul]
    · refine h5.2.congr (fun y hy => ?_)
      refine PiLp.ext (fun i => ?_)
      beta_reduce
      rw [(hrep q y hy _ _ _ rfl rfl rfl i).2, PiLp.smul_apply, smul_eq_mul]
  exact ⟨V, Z, fun q => (hsm q).1, hnorm, fun q => (hsm q).2, hrep⟩

theorem slab_chart_step [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (r η : ℝ) (T F : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hT : IsOpen T) (hF : sepChartMeas F) (hη : 0 < η) (p : M) (hN : ∀ y ∈ (chartAt E3 p).target, (chartAt E3 p).symm y ∈ T → 0 < ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ a b * partialDeriv a (fun z => ρ ((chartAt E3 p).symm z)) y * partialDeriv b (fun z => ρ ((chartAt E3 p).symm z)) y) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ) (hφ0 : ∀ x, 0 ≤ φ x) (hφc : IsCompact (tsupport φ)) (hφp : tsupport φ ⊆ T ∩ (chartAt E3 p).source) (Y V Z : M → E3) (hY : calSmoothField Y) (hY1 : ∀ x, g.g x (Y x) (Y x) ≤ 1) (hVZ : ∀ y ∈ (chartAt E3 p).target, (chartAt E3 p).symm y ∈ tsupport φ → ∀ wV wY wZ : E3, wV = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) → wY = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (Y ((chartAt E3 p).symm y)) → wZ = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (Z ((chartAt E3 p).symm y)) → ∀ i : Fin 3, wV i = (1 - calTheta r η (ρ ((chartAt E3 p).symm y))) * wY i + calTheta r η (ρ ((chartAt E3 p).symm y)) * calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) y i ∧ wZ i = calTheta r η (ρ ((chartAt E3 p).symm y)) * calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) y i) : MeasureTheory.IntegrableOn (fun y => φ ((chartAt E3 p).symm y) * g.levelMeanCurv ρ ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det) (chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source)) ∧ MeasureTheory.IntegrableOn (fun y => sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y) (chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source)) ∧ (∫ y in chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source), calTheta r η (ρ ((chartAt E3 p).symm y)) * (φ ((chartAt E3 p).symm y) * g.levelMeanCurv ρ ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det)) + (∫ y in chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source), Real.sqrt (g.coeff (chartAt E3 p).symm y).det * fderiv ℝ (fun z => φ ((chartAt E3 p).symm z)) y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (Z ((chartAt E3 p).symm y)) : E3)) + ((∫ y in chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y) - ∫ y in chartAt E3 p '' ((F ∩ T ∩ {x | r < ρ x}) ∩ (chartAt E3 p).source), calTheta r η (ρ ((chartAt E3 p).symm y)) * sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y) ≤ (∫ y in chartAt E3 p '' (F ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y) - ∫ y in chartAt E3 p '' ((F \ (T ∩ {x | r < ρ x})) ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have hTp : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) :=
    (chartAt E3 p).isOpen_inter_preimage_symm hT
  have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 p).symm z i j)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) :=
    fun i j => (g.smooth p i j).mono Set.inter_subset_left
  have hpd : ∀ z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T,
      (g.coeff (chartAt E3 p).symm z).PosDef :=
    fun z hz => coeff_chart_symm_posDef g p z hz.1
  have hdet : ∀ z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T,
      0 < (g.coeff (chartAt E3 p).symm z).det := fun z hz => (hpd z hz).det_pos
  have hsymm : ∀ (z : E3) (i j : Fin 3),
      g.coeff (chartAt E3 p).symm z i j = g.coeff (chartAt E3 p).symm z j i :=
    fun z i j => g.symm _ _ _
  have hcomp : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 p).symm y))
        ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) := by
    intro u hu
    exact (contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)).mono
      Set.inter_subset_left
  have hf : ContDiffOn ℝ ∞ (fun y => ρ ((chartAt E3 p).symm y))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) := hcomp ρ hρ
  have hψ : ContDiffOn ℝ ∞ (fun y => φ ((chartAt E3 p).symm y))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) := hcomp φ hφ
  have hψ0 : ∀ z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T,
      0 ≤ (fun y => φ ((chartAt E3 p).symm y)) z := fun z _ => hφ0 _
  have hφs : tsupport φ ⊆ (chartAt E3 p).source := hφp.trans Set.inter_subset_right
  have hφT : tsupport φ ⊆ T := hφp.trans Set.inter_subset_left
  have hC : IsCompact (chartAt E3 p '' tsupport φ) :=
    hφc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hφs)
  have hCT : chartAt E3 p '' tsupport φ ⊆
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨(chartAt E3 p).map_source (hφs hx), ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p x) ∈ T
    rw [(chartAt E3 p).left_inv (hφs hx)]
    exact hφT hx
  have hψC : ∀ z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T,
      z ∉ chartAt E3 p '' tsupport φ → (fun y => φ ((chartAt E3 p).symm y)) z = 0 := by
    intro z hz hzC
    by_contra hne
    exact hzC ⟨(chartAt E3 p).symm z, subset_tsupport _ (Function.mem_support.mpr hne),
      (chartAt E3 p).right_inv hz.1⟩
  
  have hvan : ∀ U : M → E3, ∀ z : E3, z ∉ chartAt E3 p '' tsupport φ →
      calPiece p φ U z = 0 := by
    intro U z hz
    by_cases hzt : z ∈ (chartAt E3 p).target
    · have hφz : φ ((chartAt E3 p).symm z) = 0 := by
        apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hz ⟨_, hmem, (chartAt E3 p).right_inv hzt⟩
      rw [calPiece, Set.indicator_of_mem hzt]
      simp only [hφz, zero_smul]
    · exact Set.indicator_of_notMem hzt _
  have hdivvan : ∀ U : M → E3, ∀ z : E3, z ∉ chartAt E3 p '' tsupport φ →
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ U) z = 0 := by
    intro U z hz
    have hO : (chartAt E3 p '' tsupport φ)ᶜ ∈ 𝓝 z := hC.isClosed.isOpen_compl.mem_nhds hz
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev : (fun w => Real.sqrt (g.coeff (chartAt E3 p).symm w).det * calPiece p φ U w i)
        =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
      filter_upwards [hO] with w hw
      rw [hvan U w hw]
      simp
    unfold partialDeriv
    rw [hev.fderiv_eq]
    simp
  
  have hfd0 : ∀ z ∈ (chartAt E3 p).target, (chartAt E3 p).symm z ∉ tsupport φ →
      fderiv ℝ (fun y => φ ((chartAt E3 p).symm y)) z = 0 := by
    intro z hz hzφ
    have hU : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (tsupport φ)ᶜ) :=
      (chartAt E3 p).isOpen_inter_preimage_symm (isClosed_tsupport φ).isOpen_compl
    have hev : (fun y => φ ((chartAt E3 p).symm y)) =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
      filter_upwards [hU.mem_nhds ⟨hz, hzφ⟩] with w hw
      exact image_eq_zero_of_notMem_tsupport hw.2
    rw [hev.fderiv_eq]
    simp
  
  have hlmc : ∀ z ∈ (chartAt E3 p).target,
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => ρ ((chartAt E3 p).symm y)) z =
        g.levelMeanCurv ρ ((chartAt E3 p).symm z) := by
    intro z hz
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have h := levelMeanCurv_eq_coord g Φ ρ (fun y => ρ ((chartAt E3 p).symm y)) hρ z hz
      (Filter.Eventually.of_forall fun _ => rfl)
    exact h.symm
  
  obtain ⟨Xt, hXtdef⟩ : ∃ Xt : E3 → E3, Xt = fun y => WithLp.toLp 2 (fun i =>
      calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) y i) :=
    ⟨_, rfl⟩
  have hXti : ∀ (z : E3) (i : Fin 3), Xt z i =
      calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) z i := by
    intro z i
    rw [hXtdef]
  have hnp := ccs_normal_props (g.coeff (chartAt E3 p).symm) (fun y => ρ ((chartAt E3 p).symm y))
    _ hTp hG hpd hf Xt (fun z _ i => hXti z i)
  have hXt : ContDiffOn ℝ ∞ Xt ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T) :=
    hnp.2.1.mono (fun z hz => ⟨hz, hN z hz.1 hz.2⟩)
  have hCS : ∀ z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T,
      r < ρ ((chartAt E3 p).symm z) →
      |fderiv ℝ (fun y => ρ ((chartAt E3 p).symm y)) z
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z)
          (Y ((chartAt E3 p).symm z)) : E3)| ≤
      fderiv ℝ (fun y => ρ ((chartAt E3 p).symm y)) z (Xt z) := by
    intro z hz _
    refine hnp.2.2 z hz (hN z hz.1 hz.2) _ ?_
    rw [ccs_rep_norm g Y p z hz.1 _ rfl]
    exact hY1 _
  
  have hBo : IsOpen ({z : E3 | z ∈ (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T ∧
      r < ρ ((chartAt E3 p).symm z)} \ ∅) := by
    rw [Set.diff_empty]
    exact hf.continuousOn.isOpen_inter_preimage hTp isOpen_Ioi
  obtain ⟨sig, hsigdef⟩ : ∃ sig : E3 → ℝ, sig = fun z =>
