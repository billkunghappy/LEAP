      (hu.contDiffAt (hV.mem_nhds hxV)).differentiableAt (by simp)
    obtain ⟨-, -, hdt, hds⟩ := hΦchain u p hdu
    have hκδ0 : 0 ≤ (κ0 + 1) * δ := by positivity
    have hEδ : κ0 * Real.exp p.1 ≤ (κ0 + 1) * δ :=
      (hκ0e p).trans (mul_le_mul_of_nonneg_left (hexple p hp) hκpos.le)
    have hDu : ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ G := hw2.trans hpow
    have hκe0 : 0 ≤ κ0 * Real.exp p.1 := by positivity
    refine ⟨?_, ?_, ?_⟩
    · rw [hCKe, hwf]
      have := hw1.trans hpow
      have h2 : 0 ≤ (κ0 + 1) * δ * G := mul_nonneg hκδ0 hG0
      simp only; linarith
    · rw [hCKe, (hwd p).1]
      have h3 : κ0 * Real.exp p.1 * ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ (κ0 + 1) * δ * G :=
        mul_le_mul hEδ hDu (norm_nonneg _) hκδ0
      linarith
    · rw [hCKe, (hwd p).2]
      have h3 : κ0 * Real.exp p.1 * ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ (κ0 + 1) * δ * G :=
        mul_le_mul hEδ hDu (norm_nonneg _) hκδ0
      linarith
  · 
    intro hw0
    have hcov := cyl_polar_cover P hPdet x₀ (Real.log δ) (fun x => u x - u x₀) (by simp)
      (fun p hp => by
        have := hw0 p hp
        rw [hwf] at this
        exact this)
    filter_upwards [hcov] with x hx
    exact sub_eq_zero.mp hx

theorem cyl_energy_identities (T C₁ : ℝ) (a b c w : ℝ × ℝ → ℝ) (hC₁ : 0 ≤ C₁)
    (hcyl : fplCylData T C₁ a b c w)
    (hdec : ∀ K : ℕ, ∃ CK : ℝ, ∀ p : ℝ × ℝ, p.1 < T →
      |w p| ≤ CK * Real.exp (K * p.1) ∧ |fplDt w p| ≤ CK * Real.exp (K * p.1) ∧
      |fplDs w p| ≤ CK * Real.exp (K * p.1)) :
    (∃ (C : ℝ) (g q : ℝ → ℝ), 0 ≤ C ∧
      (∀ t < T, 0 ≤ fplH a w t ∧ 0 ≤ fplX a b w t ∧ 0 ≤ fplY a w t ∧
        fplD a b w t ^ 2 ≤ fplH a w t * fplX a b w t ∧
        HasDerivAt (fplH a w) (2 * fplD a b w t + g t) t ∧
        |g t| ≤ C * Real.exp t * fplH a w t ∧
        HasDerivAt (fplD a b w) (fplX a b w t + fplY a w t) t ∧
        HasDerivAt (fun s => fplX a b w s - fplY a w s) (q t) t ∧
        |q t| ≤ C * Real.exp t * (fplX a b w t + fplY a w t)) ∧
      Tendsto (fplD a b w) atBot (𝓝 0) ∧
      Tendsto (fun s => fplX a b w s - fplY a w s) atBot (𝓝 0) ∧
      (∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, fplH a w t ≤ CK * Real.exp (K * t))) ∧
    (∀ t < T, fplH a w t = 0 → ∀ θ : ℝ, w (t, θ) = 0) :=
by
  obtain ⟨ha, hb, hc, hw, hper, hpt⟩ := hcyl
  set U : Set (ℝ × ℝ) := {p : ℝ × ℝ | p.1 < T} with hUdef
  have hU : IsOpen U := isOpen_lt continuous_fst continuous_const
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hD : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U →
      ContDiffOn ℝ ∞ (fplDt F) U ∧ ContDiffOn ℝ ∞ (fplDs F) U := by
    intro F hF
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ F) U := hF.fderiv_of_isOpen (m := ∞) hU le_rfl
    exact ⟨h1.clm_apply contDiffOn_const, h1.clm_apply contDiffOn_const⟩
  have hdiff : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U → ∀ p ∈ U, DifferentiableAt ℝ F p :=
    fun F hF p hp => (hF.contDiffAt (hU.mem_nhds hp)).differentiableAt (by simp)
  have hcont : ∀ F : ℝ × ℝ → ℝ, ContinuousOn F U → ∀ t : ℝ, t < T →
      Continuous (fun θ : ℝ => F (t, θ)) :=
    fun F hF t ht => hF.comp_continuous (continuous_const.prodMk continuous_id) (fun _ => ht)
  have hlt : ∀ (F : ℝ × ℝ → ℝ) (t θ : ℝ), DifferentiableAt ℝ F (t, θ) →
      HasDerivAt (fun s => F (s, θ)) (fplDt F (t, θ)) t := by
    intro F t θ hF
    have h2 : HasDerivAt (fun s : ℝ => (s, θ)) ((1 : ℝ), (0 : ℝ)) t :=
      (hasDerivAt_id' t).prodMk (hasDerivAt_const t θ)
    exact hF.hasFDerivAt.comp_hasDerivAt t h2
  have hls : ∀ (F : ℝ × ℝ → ℝ) (t θ : ℝ), DifferentiableAt ℝ F (t, θ) →
      HasDerivAt (fun s => F (t, s)) (fplDs F (t, θ)) θ := by
    intro F t θ hF
    have h2 : HasDerivAt (fun s : ℝ => (t, s)) ((0 : ℝ), (1 : ℝ)) θ :=
      (hasDerivAt_const θ t).prodMk (hasDerivAt_id' θ)
    exact hF.hasFDerivAt.comp_hasDerivAt θ h2
  have hmix : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U → ∀ p ∈ U,
      fplDs (fplDt F) p = fplDt (fplDs F) p := by
    intro F hF p hp
    have hfd : DifferentiableAt ℝ (fderiv ℝ F) p :=
      ((hF.fderiv_of_isOpen (m := ∞) hU le_rfl).contDiffAt (hU.mem_nhds hp)).differentiableAt
        (by simp)
    have hsym := (hF.contDiffAt (hU.mem_nhds hp)).isSymmSndFDerivAt
      (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have h1 := fderiv_clm_apply (c := fderiv ℝ F) (u := fun _ => ((1 : ℝ), (0 : ℝ))) hfd
      (differentiableAt_const _)
    have h2 := fderiv_clm_apply (c := fderiv ℝ F) (u := fun _ => ((0 : ℝ), (1 : ℝ))) hfd
      (differentiableAt_const _)
    unfold fplDs fplDt
    rw [h1, h2]
    simp
    exact hsym _ _
  have hperD : ∀ F : ℝ × ℝ → ℝ, (∀ p : ℝ × ℝ, p.1 < T → F (p.1, p.2 + 2 * Real.pi) = F p) →
      ∀ p : ℝ × ℝ, p.1 < T → fderiv ℝ F (p.1, p.2 + 2 * Real.pi) = fderiv ℝ F p := by
    intro F hF p hp
    have hv : ∀ q : ℝ × ℝ, q + ((0 : ℝ), 2 * Real.pi) = (q.1, q.2 + 2 * Real.pi) :=
      fun q => Prod.ext (add_zero q.1) rfl
    have hev : (fun q => F (q + ((0 : ℝ), 2 * Real.pi))) =ᶠ[𝓝 p] F := by
      filter_upwards [hU.mem_nhds (show p ∈ U from hp)] with q hq
      rw [hv]; exact hF q hq
    have h2 := hev.fderiv_eq (𝕜 := ℝ)
    rw [fderiv_comp_add_right] at h2
    rw [← hv]; exact h2
  have hend : ∀ t : ℝ, t < T → a (t, Real.pi) = a (t, -Real.pi) ∧ b (t, Real.pi) = b (t, -Real.pi) ∧
      c (t, Real.pi) = c (t, -Real.pi) ∧ w (t, Real.pi) = w (t, -Real.pi) ∧
      fplDt w (t, Real.pi) = fplDt w (t, -Real.pi) ∧
      fplDs w (t, Real.pi) = fplDs w (t, -Real.pi) := by
    intro t ht
    have e : (((t, -Real.pi) : ℝ × ℝ).1, ((t, -Real.pi) : ℝ × ℝ).2 + 2 * Real.pi) =
        ((t, Real.pi) : ℝ × ℝ) :=
      Prod.ext rfl (show -Real.pi + 2 * Real.pi = Real.pi by ring)
    have h := hper (t, -Real.pi) ht
    have hd := hperD w (fun p hp => (hper p hp).2.2.2) (t, -Real.pi) ht
    rw [e] at h hd
    refine ⟨h.1, h.2.1, h.2.2.1, h.2.2.2, ?_, ?_⟩
    · unfold fplDt; rw [hd]
    · unfold fplDs; rw [hd]
  have hderI : ∀ G : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G U → ∀ t : ℝ, t < T →
      HasDerivAt (fun s => ∫ θ in (-Real.pi)..Real.pi, G (s, θ))
        (∫ θ in (-Real.pi)..Real.pi, fplDt G (t, θ)) t := by
    intro G hG t ht
    have hKc : IsCompact (Set.Icc (t - (T - t) / 2) (t + (T - t) / 2) ×ˢ
        Set.Icc (-Real.pi) Real.pi) := isCompact_Icc.prod isCompact_Icc
    have hKU : Set.Icc (t - (T - t) / 2) (t + (T - t) / 2) ×ˢ Set.Icc (-Real.pi) Real.pi ⊆ U := by
      intro q hq
      show q.1 < T
      have := hq.1.2
      linarith
    obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn ((hD G hG).1.continuousOn.mono hKU)
    refine (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun x θ => G (x, θ)) (F' := fun x θ => fplDt G (x, θ)) (bound := fun _ => M)
      (s := Set.Ioo (t - (T - t) / 2) (t + (T - t) / 2))
      (Ioo_mem_nhds (by linarith) (by linarith)) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_).2
    · filter_upwards [Iio_mem_nhds ht] with x hx
      exact (hcont G hG.continuousOn x hx).aestronglyMeasurable
    · exact (hcont G hG.continuousOn t ht).intervalIntegrable _ _
    · exact (hcont _ (hD G hG).1.continuousOn t ht).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun θ hθ x hx => hM (x, θ) ⟨⟨hx.1.le, hx.2.le⟩, ?_⟩)
      rw [Set.uIoc_of_le hpi] at hθ
      exact ⟨hθ.1.le, hθ.2⟩
    · refine Filter.Eventually.of_forall (fun θ _ x hx => hlt G x θ (hdiff G hG _ ?_))
      show x < T
      linarith [hx.2]
  have hDs0 : ∀ R : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ R U → ∀ t : ℝ, t < T →
      R (t, Real.pi) = R (t, -Real.pi) → ∫ θ in (-Real.pi)..Real.pi, fplDs R (t, θ) = 0 := by
    intro R hR t ht h
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun θ => R (t, θ))
      (fun θ _ => hls R t θ (hdiff R hR _ ht))
      ((hcont _ (hD R hR).2.continuousOn t ht).intervalIntegrable _ _)]
    show R (t, Real.pi) - R (t, -Real.pi) = 0
    rw [h, sub_self]
  have ha0U : ∀ q ∈ U, a q ≠ 0 := fun q hq => by
    have := (hpt q hq).2.1; intro h; rw [h] at this; norm_num at this
  have ha20U : ∀ q ∈ U, a q ^ 2 ≠ 0 := fun q hq => pow_ne_zero 2 (ha0U q hq)
  have hwt := (hD w hw).1
  have hws := (hD w hw).2
  have hat := (hD a ha).1
  have hbs := (hD b hb).2
  have hV0 : ContDiffOn ℝ ∞ (fplV0 a b w) U := (ha.mul hwt).add (hb.mul hws)
  have hV1 : ContDiffOn ℝ ∞ (fplV1 b c w) U := (hb.mul hwt).add (hc.mul hws)
  have hG1 : ContDiffOn ℝ ∞ (fun q => a q * w q ^ 2) U := ha.mul (hw.pow 2)
  have hR1 : ContDiffOn ℝ ∞ (fun q => b q * w q ^ 2) U := hb.mul (hw.pow 2)
  have hG2 : ContDiffOn ℝ ∞ (fun q => w q * fplV0 a b w q) U := hw.mul hV0
  have hR2 : ContDiffOn ℝ ∞ (fun q => w q * fplV1 b c w q) U := hw.mul hV1
  have hG3 : ContDiffOn ℝ ∞ (fun q => fplV0 a b w q ^ 2 / a q) U := (hV0.pow 2).div ha ha0U
  have hG4 : ContDiffOn ℝ ∞ (fun q => fplDs w q ^ 2 / a q) U := (hws.pow 2).div ha ha0U
  have hZ : ContDiffOn ℝ ∞ (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
      2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) U :=
    ((((hb.div (ha.pow 2) ha20U).neg).mul (hV0.pow 2)).sub
      ((contDiffOn_const.div (ha.pow 2) ha20U).mul (hV0.mul hws))).add
      ((hb.div (ha.pow 2) ha20U).mul (hws.pow 2))
  have hgC : ContDiffOn ℝ ∞ (fun q => (fplDt a q + fplDs b q) * w q ^ 2) U :=
    (hat.add hbs).mul (hw.pow 2)
  have hqC : ContDiffOn ℝ ∞ (fun q => (fplDt a q + fplDs b q) *
      (fplDs w q ^ 2 - fplV0 a b w q ^ 2) / a q ^ 2) U :=
    ((hat.add hbs).mul ((hws.pow 2).sub (hV0.pow 2))).div (ha.pow 2) ha20U
  have hP1 : ∀ t θ : ℝ, t < T → fplDt (fun q => a q * w q ^ 2) (t, θ) =
      2 * (w (t, θ) * fplV0 a b w (t, θ)) + (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2 -
        fplDs (fun q => b q * w q ^ 2) (t, θ) := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have e1 := (hlt (fun q => a q * w q ^ 2) t θ (hdiff _ hG1 _ hp)).unique
      ((hlt a t θ (hdiff a ha _ hp)).mul ((hlt w t θ (hdiff w hw _ hp)).pow 2))
    have e2 := (hls (fun q => b q * w q ^ 2) t θ (hdiff _ hR1 _ hp)).unique
      ((hls b t θ (hdiff b hb _ hp)).mul ((hls w t θ (hdiff w hw _ hp)).pow 2))
    rw [e1, e2]
    simp only [fplV0]
    norm_num
    ring
  have hP2 : ∀ t θ : ℝ, t < T → fplDt (fun q => w q * fplV0 a b w q) (t, θ) =
      fplV0 a b w (t, θ) ^ 2 / a (t, θ) + fplDs w (t, θ) ^ 2 / a (t, θ) -
        fplDs (fun q => w q * fplV1 b c w q) (t, θ) := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have ha0 := ha0U _ hp
    have e1 := (hlt (fun q => w q * fplV0 a b w q) t θ (hdiff _ hG2 _ hp)).unique
      ((hlt w t θ (hdiff w hw _ hp)).mul (hlt _ t θ (hdiff _ hV0 _ hp)))
    have e2 := (hls (fun q => w q * fplV1 b c w q) t θ (hdiff _ hR2 _ hp)).unique
      ((hls w t θ (hdiff w hw _ hp)).mul (hls _ t θ (hdiff _ hV1 _ hp)))
    have E1 := (hpt _ hp).2.2.2.2.2.2.2.2
    have E2 := (hpt _ hp).1
    rw [e1, e2]
    have hV0t : fplDt (fplV0 a b w) (t, θ) = -fplDs (fplV1 b c w) (t, θ) := by linarith
    have hc' : c (t, θ) = (1 + b (t, θ) ^ 2) / a (t, θ) := by
      field_simp; linarith
    rw [hV0t]
    simp only [fplV0, fplV1]
    rw [hc']
    field_simp
    ring
  have hP3 : ∀ t θ : ℝ, t < T →
      fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ) -
        fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ) =
      fplDs (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, θ) +
      (fplDt a (t, θ) + fplDs b (t, θ)) * (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) /
        a (t, θ) ^ 2 := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have ha0 := ha0U _ hp
    have ha20 := ha20U _ hp
    have dA := hdiff a ha _ hp
    have dB := hdiff b hb _ hp
    have dC := hdiff c hc _ hp
    have dWt := hdiff _ hwt _ hp
    have dWs := hdiff _ hws _ hp
    have dV0 := hdiff _ hV0 _ hp
    have dV1 := hdiff _ hV1 _ hp
    have E4 := hmix w hw _ hp
    have e1 := (hlt (fun q => fplV0 a b w q ^ 2 / a q) t θ (hdiff _ hG3 _ hp)).unique
      (((hlt _ t θ dV0).pow 2).div (hlt _ t θ dA) ha0)
    have e2 := (hlt (fun q => fplDs w q ^ 2 / a q) t θ (hdiff _ hG4 _ hp)).unique
      (((hlt _ t θ dWs).pow 2).div (hlt _ t θ dA) ha0)
    have e3 := (hls (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) t θ
        (hdiff _ hZ _ hp)).unique
      (((((hls _ t θ dB).div ((hls _ t θ dA).pow 2) ha20).neg.mul ((hls _ t θ dV0).pow 2)).sub
        (((hasDerivAt_const θ (2 : ℝ)).div ((hls _ t θ dA).pow 2) ha20).mul
          ((hls _ t θ dV0).mul (hls _ t θ dWs)))).add
        (((hls _ t θ dB).div ((hls _ t θ dA).pow 2) ha20).mul ((hls _ t θ dWs).pow 2)))
    have e4 := (hls (fplV0 a b w) t θ dV0).unique
      (((hls _ t θ dA).mul (hls _ t θ dWt)).add ((hls _ t θ dB).mul (hls _ t θ dWs)))
    have e5 := (hls (fplV1 b c w) t θ dV1).unique
      (((hls _ t θ dB).mul (hls _ t θ dWt)).add ((hls _ t θ dC).mul (hls _ t θ dWs)))
    have hconst : HasDerivAt (fun s => a (t, s) * c (t, s) - b (t, s) ^ 2) 0 θ := by
      have : (fun s => a (t, s) * c (t, s) - b (t, s) ^ 2) = fun _ => (1 : ℝ) :=
        funext fun s => (hpt (t, s) ht).1
      rw [this]; exact hasDerivAt_const _ _
    have e6 := hconst.unique (((hls _ t θ dA).mul (hls _ t θ dC)).sub ((hls _ t θ dB).pow 2))
    have E1 := (hpt _ hp).2.2.2.2.2.2.2.2
    have E2 := (hpt _ hp).1
    rw [e1, e2, e3, e4]
    rw [e5] at E1
    norm_num at e6 E1 ⊢
    have hV0t : fplDt (fplV0 a b w) (t, θ) = -(fplDs b (t, θ) * fplDt w (t, θ) +
        b (t, θ) * fplDs (fplDt w) (t, θ) + (fplDs c (t, θ) * fplDs w (t, θ) +
        c (t, θ) * fplDs (fplDs w) (t, θ))) := by linarith
    have hcs : fplDs c (t, θ) = (2 * b (t, θ) * fplDs b (t, θ) - fplDs a (t, θ) * c (t, θ)) /
        a (t, θ) := by
      field_simp; linarith
    have hc' : c (t, θ) = (1 + b (t, θ) ^ 2) / a (t, θ) := by
      field_simp; linarith
    rw [hV0t, hcs, hc', ← E4]
    simp only [fplV0]
    field_simp
    ring
  obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ, ∀ t, g t =
      ∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨qf, hq⟩ : ∃ qf : ℝ → ℝ, ∀ t, qf t =
      ∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) *
        (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  have habs : ∀ x y u v E : ℝ, |x| ≤ 2 → |y| ≤ 2 → |u| ≤ E → |v| ≤ E →
      |x * u + y * v| ≤ 4 * E := by
    intro x y u v E hx hy hu hv
    calc |x * u + y * v| ≤ |x * u| + |y * v| := abs_add_le _ _
      _ = |x| * |u| + |y| * |v| := by rw [abs_mul, abs_mul]
      _ ≤ 2 * E + 2 * E := add_le_add (mul_le_mul hx hu (abs_nonneg _) (by norm_num))
          (mul_le_mul hy hv (abs_nonneg _) (by norm_num))
      _ = 4 * E := by ring
  have hlims : Tendsto (fplD a b w) atBot (𝓝 0) ∧
      Tendsto (fun s => fplX a b w s - fplY a w s) atBot (𝓝 0) := by
    obtain ⟨C', hC'⟩ := hdec 1
    have hb1 : ∀ t θ : ℝ, t < T → |w (t, θ)| ≤ C' * Real.exp t ∧
        |fplDt w (t, θ)| ≤ C' * Real.exp t ∧ |fplDs w (t, θ)| ≤ C' * Real.exp t := by
      intro t θ ht
      have h := hC' (t, θ) ht
      simp only [Nat.cast_one, one_mul] at h
      exact h
    have hV : ∀ t θ : ℝ, t < T → |fplV0 a b w (t, θ)| ≤ 4 * (C' * Real.exp t) := by
      intro t θ ht
      have haa : |a (t, θ)| ≤ 2 :=
        abs_le.2 ⟨by linarith [(hpt (t, θ) ht).2.1], (hpt (t, θ) ht).2.2.1⟩
      exact habs _ _ _ _ _ haa (hpt (t, θ) ht).2.2.2.1 (hb1 t θ ht).2.1 (hb1 t θ ht).2.2
    have hlimE : ∀ K0 : ℝ, Tendsto (fun t : ℝ => K0 * (C' * Real.exp t) ^ 2 *
        |Real.pi - -Real.pi|) atBot (𝓝 0) := by
      intro K0
      have h := (((Real.tendsto_exp_atBot.const_mul C').pow 2).const_mul K0).mul_const
        |Real.pi - -Real.pi|
      rw [show K0 * (C' * 0) ^ 2 * |Real.pi - -Real.pi| = (0 : ℝ) by ring] at h
      exact h
    constructor
    · refine squeeze_zero_norm' ?_ (hlimE 4)
      filter_upwards [eventually_lt_atBot T] with t ht
      show ‖fplD a b w t‖ ≤ 4 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi|
      unfold fplD
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro θ _
      have h1 := (hb1 t θ ht).1
      have h2 := hV t θ ht
      have hE : 0 ≤ C' * Real.exp t := le_trans (abs_nonneg _) h1
      rw [Real.norm_eq_abs, abs_mul]
      exact (mul_le_mul h1 h2 (abs_nonneg _) hE).trans (le_of_eq (by ring))
    · refine squeeze_zero_norm' ?_ (hlimE 34)
      filter_upwards [eventually_lt_atBot T] with t ht
      show ‖fplX a b w t - fplY a w t‖ ≤ 34 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi|
      have hX : ‖fplX a b w t‖ ≤ 32 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi| := by
        unfold fplX
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro θ _
        have ha2 := (hpt (t, θ) ht).2.1
        have hA : 0 < a (t, θ) := by linarith
        have h2 := hV t θ ht
        have hsq : fplV0 a b w (t, θ) ^ 2 ≤ (4 * (C' * Real.exp t)) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
        have hm := mul_nonneg (sq_nonneg (C' * Real.exp t)) (by linarith : 0 ≤ a (t, θ) - 1 / 2)
        rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) hA.le), div_le_iff₀ hA]
        nlinarith [sq_nonneg (fplV0 a b w (t, θ))]
      have hY : ‖fplY a w t‖ ≤ 2 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi| := by
        unfold fplY
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro θ _
        have ha2 := (hpt (t, θ) ht).2.1
        have hA : 0 < a (t, θ) := by linarith
        have h2 := (hb1 t θ ht).2.2
        have hsq : fplDs w (t, θ) ^ 2 ≤ (C' * Real.exp t) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
        have hm := mul_nonneg (sq_nonneg (C' * Real.exp t)) (by linarith : 0 ≤ a (t, θ) - 1 / 2)
        rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) hA.le), div_le_iff₀ hA]
        nlinarith [sq_nonneg (fplDs w (t, θ))]
      calc ‖fplX a b w t - fplY a w t‖ ≤ ‖fplX a b w t‖ + ‖fplY a w t‖ := norm_sub_le _ _
        _ ≤ _ := by linarith
  have hHdec : ∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, fplH a w t ≤ CK * Real.exp (K * t) := by
    intro K
    obtain ⟨CK, hCK⟩ := hdec K
    refine ⟨2 * CK ^ 2 * Real.exp (K * |T|) * |Real.pi - -Real.pi|, fun t ht => ?_⟩
    have hP : 0 ≤ |Real.pi - -Real.pi| := abs_nonneg _
    have hu := Real.exp_pos (K * t)
    have huv : Real.exp (K * t) ≤ Real.exp (K * |T|) :=
      Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (by linarith [le_abs_self T])
        (Nat.cast_nonneg K))
    have hn : ‖fplH a w t‖ ≤ 2 * (CK * Real.exp (K * t)) ^ 2 * |Real.pi - -Real.pi| := by
      unfold fplH
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro θ _
      have ha2 := (hpt (t, θ) ht).2.1
      have ha3 := (hpt (t, θ) ht).2.2.1
      have h1 : |w (t, θ)| ≤ CK * Real.exp (K * t) := (hCK (t, θ) ht).1
      have hsq : w (t, θ) ^ 2 ≤ (CK * Real.exp (K * t)) ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      have hm := mul_nonneg (by linarith : 0 ≤ 2 - a (t, θ)) (sq_nonneg (w (t, θ)))
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (by linarith) (sq_nonneg _))]
      nlinarith [sq_nonneg (w (t, θ))]
    have h1 := le_abs_self (fplH a w t)
    rw [← Real.norm_eq_abs] at h1
    have h3 := mul_nonneg (mul_nonneg (mul_nonneg (sq_nonneg CK) hP) hu.le) (sub_nonneg.2 huv)
    nlinarith
  have hvan : ∀ t < T, fplH a w t = 0 → ∀ θ : ℝ, w (t, θ) = 0 := by
    intro t ht hH θ
    have hperf : Function.Periodic (fun θ => w (t, θ)) (2 * Real.pi) :=
      fun θ => (hper (t, θ) ht).2.2.2
    obtain ⟨y, hy, hfy⟩ := hperf.exists_mem_Ico Real.two_pi_pos θ (-Real.pi)
    have hfy' : w (t, θ) = w (t, y) := hfy
    rw [hfy']
    by_contra hne
    have hpos : 0 < fplH a w t := by
      unfold fplH
      refine intervalIntegral.integral_pos (by linarith [Real.pi_pos]) ?_ ?_
        ⟨y, ⟨hy.1, by linarith [hy.2]⟩, ?_⟩
      · exact (hcont _ hG1.continuousOn t ht).continuousOn
      · intro x _
        exact mul_nonneg (by linarith [(hpt (t, x) ht).2.1]) (sq_nonneg _)
      · exact mul_pos (by linarith [(hpt (t, y) ht).2.1])
          (lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hne)))
    linarith
  refine ⟨⟨4 * C₁, g, qf, by linarith, fun t ht => ?_, hlims.1, hlims.2, hHdec⟩, hvan⟩
  have ii : ∀ F : ℝ × ℝ → ℝ, ContinuousOn F U →
      IntervalIntegrable (fun θ => F (t, θ)) volume (-Real.pi) Real.pi :=
    fun F hF => (hcont F hF t ht).intervalIntegrable _ _
  have iH : IntervalIntegrable (fun θ => a (t, θ) * w (t, θ) ^ 2) volume (-Real.pi) Real.pi :=
    ii _ hG1.continuousOn
  have iD : IntervalIntegrable (fun θ => w (t, θ) * fplV0 a b w (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG2.continuousOn
  have iX : IntervalIntegrable (fun θ => fplV0 a b w (t, θ) ^ 2 / a (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG3.continuousOn
  have iY : IntervalIntegrable (fun θ => fplDs w (t, θ) ^ 2 / a (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG4.continuousOn
  have ig : IntervalIntegrable (fun θ => (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2) volume
      (-Real.pi) Real.pi := ii _ hgC.continuousOn
  have iqq : IntervalIntegrable (fun θ => (fplDt a (t, θ) + fplDs b (t, θ)) *
      (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2) volume
      (-Real.pi) Real.pi := ii _ hqC.continuousOn
  have iR1 : IntervalIntegrable (fun θ => fplDs (fun q => b q * w q ^ 2) (t, θ)) volume
      (-Real.pi) Real.pi := ii _ (hD _ hR1).2.continuousOn
  have iR2 : IntervalIntegrable (fun θ => fplDs (fun q => w q * fplV1 b c w q) (t, θ)) volume
      (-Real.pi) Real.pi := ii _ (hD _ hR2).2.continuousOn
  have iG3t : IntervalIntegrable (fun θ => fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hG3).1.continuousOn
  have iG4t : IntervalIntegrable (fun θ => fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hG4).1.continuousOn
  have iZs : IntervalIntegrable (fun θ => fplDs (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
      2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hZ).2.continuousOn
  obtain ⟨ea, eb, ec, ew, ewt, ews⟩ := hend t ht
  have hH0 : 0 ≤ fplH a w t := by
    unfold fplH
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      mul_nonneg (by linarith [(hpt (t, θ) ht).2.1]) (sq_nonneg _))
  have hX0 : 0 ≤ fplX a b w t := by
    unfold fplX
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      div_nonneg (sq_nonneg _) (by linarith [(hpt (t, θ) ht).2.1]))
  have hY0 : 0 ≤ fplY a w t := by
    unfold fplY
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      div_nonneg (sq_nonneg _) (by linarith [(hpt (t, θ) ht).2.1]))
  have hCS : fplD a b w t ^ 2 ≤ fplH a w t * fplX a b w t := by
    have key : ∀ x : ℝ, 0 ≤ fplH a w t * (x * x) + (2 * fplD a b w t) * x + fplX a b w t := by
      intro x
      have e : ∫ θ in (-Real.pi)..Real.pi, ((x * x) * (a (t, θ) * w (t, θ) ^ 2) +
          (2 * x) * (w (t, θ) * fplV0 a b w (t, θ)) + fplV0 a b w (t, θ) ^ 2 / a (t, θ)) =
          fplH a w t * (x * x) + (2 * fplD a b w t) * x + fplX a b w t := by
        rw [intervalIntegral.integral_add ((iH.const_mul _).add (iD.const_mul _)) iX,
          intervalIntegral.integral_add (iH.const_mul _) (iD.const_mul _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
        unfold fplH fplD fplX
        ring
      rw [← e]
      apply intervalIntegral.integral_nonneg hpi
      intro θ _
      have ha2 := (hpt (t, θ) ht).2.1
      have ha0 : a (t, θ) ≠ 0 := ha0U (t, θ) ht
      have hr : (x * x) * (a (t, θ) * w (t, θ) ^ 2) +
          (2 * x) * (w (t, θ) * fplV0 a b w (t, θ)) + fplV0 a b w (t, θ) ^ 2 / a (t, θ) =
          a (t, θ) * (x * w (t, θ) + fplV0 a b w (t, θ) / a (t, θ)) ^ 2 := by
        field_simp; ring
      rw [hr]
      exact mul_nonneg (by linarith) (sq_nonneg _)
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith
  have hHd : HasDerivAt (fplH a w) (2 * fplD a b w t + g t) t := by
    have h1 : HasDerivAt (fplH a w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => a q * w q ^ 2) (t, θ)) t := hderI _ hG1 t ht
    refine h1.congr_deriv ?_
    have eR1 : (fun q => b q * w q ^ 2) (t, Real.pi) = (fun q => b q * w q ^ 2) (t, -Real.pi) := by
      simp only [eb, ew]
    rw [intervalIntegral.integral_congr (fun θ _ => hP1 t θ ht),
      intervalIntegral.integral_sub ((iD.const_mul 2).add ig) iR1,
      intervalIntegral.integral_add (iD.const_mul 2) ig, intervalIntegral.integral_const_mul,
      hDs0 _ hR1 t ht eR1, hg]
    unfold fplD
    ring
  have hDd : HasDerivAt (fplD a b w) (fplX a b w t + fplY a w t) t := by
    have h1 : HasDerivAt (fplD a b w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => w q * fplV0 a b w q) (t, θ)) t :=
      hderI _ hG2 t ht
    refine h1.congr_deriv ?_
    have eR2 : (fun q => w q * fplV1 b c w q) (t, Real.pi) =
        (fun q => w q * fplV1 b c w q) (t, -Real.pi) := by
      simp only [fplV1, eb, ec, ew, ewt, ews]
    rw [intervalIntegral.integral_congr (fun θ _ => hP2 t θ ht),
      intervalIntegral.integral_sub (iX.add iY) iR2, intervalIntegral.integral_add iX iY,
      hDs0 _ hR2 t ht eR2]
    unfold fplX fplY
    ring
  have hQd : HasDerivAt (fun s => fplX a b w s - fplY a w s) (qf t) t := by
    have h3 : HasDerivAt (fplX a b w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ)) t :=
      hderI _ hG3 t ht
    have h4 : HasDerivAt (fplY a w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ)) t :=
      hderI _ hG4 t ht
    refine (h3.sub h4).congr_deriv ?_
    have eZ : (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, Real.pi) =
        (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2)
          (t, -Real.pi) := by
      simp only [fplV0, ea, eb, ew, ewt, ews]
    rw [← intervalIntegral.integral_sub iG3t iG4t,
      intervalIntegral.integral_congr (fun θ _ => hP3 t θ ht),
      intervalIntegral.integral_add iZs iqq, hDs0 _ hZ t ht eZ, zero_add, hq]
  have hkb : ∀ θ : ℝ, |fplDt a (t, θ) + fplDs b (t, θ)| ≤ 2 * (C₁ * Real.exp t) := by
    intro θ
    have h1 : |fplDt a (t, θ)| ≤ C₁ * Real.exp t := (hpt (t, θ) ht).2.2.2.2.1
    have h2 : |fplDs b (t, θ)| ≤ C₁ * Real.exp t := (hpt (t, θ) ht).2.2.2.2.2.2.2.1
    linarith [abs_add_le (fplDt a (t, θ)) (fplDs b (t, θ))]
  have hE : 0 ≤ C₁ * Real.exp t := mul_nonneg hC₁ (Real.exp_pos t).le
  have hgb : |g t| ≤ 4 * C₁ * Real.exp t * fplH a w t := by
    rw [hg]
    calc |∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2|
        ≤ ∫ θ in (-Real.pi)..Real.pi, |(fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2| :=
          intervalIntegral.abs_integral_le_integral_abs hpi
      _ ≤ ∫ θ in (-Real.pi)..Real.pi, 4 * C₁ * Real.exp t * (a (t, θ) * w (t, θ) ^ 2) := by
          refine intervalIntegral.integral_mono_on hpi ig.abs (iH.const_mul _) (fun θ _ => ?_)
          have hk := hkb θ
          have ha2 := (hpt (t, θ) ht).2.1
          rw [abs_mul, abs_of_nonneg (sq_nonneg (w (t, θ)))]
          have h1 := mul_le_mul_of_nonneg_right hk (sq_nonneg (w (t, θ)))
          have h2 := mul_nonneg (mul_nonneg hE (sq_nonneg (w (t, θ))))
            (show 0 ≤ 2 * a (t, θ) - 1 by linarith)
          nlinarith
      _ = 4 * C₁ * Real.exp t * fplH a w t := intervalIntegral.integral_const_mul _ _
  have hqb : |qf t| ≤ 4 * C₁ * Real.exp t * (fplX a b w t + fplY a w t) := by
    rw [hq]
    calc |∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) *
          (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2|
        ≤ ∫ θ in (-Real.pi)..Real.pi, |(fplDt a (t, θ) + fplDs b (t, θ)) *
          (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2| :=
          intervalIntegral.abs_integral_le_integral_abs hpi
      _ ≤ ∫ θ in (-Real.pi)..Real.pi, 4 * C₁ * Real.exp t *
          (fplV0 a b w (t, θ) ^ 2 / a (t, θ) + fplDs w (t, θ) ^ 2 / a (t, θ)) := by
          refine intervalIntegral.integral_mono_on hpi iqq.abs ((iX.add iY).const_mul _)
            (fun θ _ => ?_)
          have hk := hkb θ
          have ha2 := (hpt (t, θ) ht).2.1
          have hA : 0 < a (t, θ) := by linarith
          have h1 : |fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2| ≤
              fplDs w (t, θ) ^ 2 + fplV0 a b w (t, θ) ^ 2 :=
            abs_le.2 ⟨by nlinarith [sq_nonneg (fplDs w (t, θ)), sq_nonneg (fplV0 a b w (t, θ))],
              by nlinarith [sq_nonneg (fplDs w (t, θ)), sq_nonneg (fplV0 a b w (t, θ))]⟩
          have h2 := mul_le_mul hk h1 (abs_nonneg _) (by linarith)
          have h3 := mul_nonneg (mul_nonneg hE (add_nonneg (sq_nonneg (fplDs w (t, θ)))
            (sq_nonneg (fplV0 a b w (t, θ))))) (show 0 ≤ 2 * a (t, θ) - 1 by linarith)
          have heq : 4 * C₁ * Real.exp t * (fplV0 a b w (t, θ) ^ 2 / a (t, θ) +
              fplDs w (t, θ) ^ 2 / a (t, θ)) * a (t, θ) ^ 2 =
              4 * C₁ * Real.exp t * (fplDs w (t, θ) ^ 2 + fplV0 a b w (t, θ) ^ 2) * a (t, θ) := by
            field_simp; ring
          rw [abs_div, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < a (t, θ) ^ 2),
            div_le_iff₀ (by positivity), heq]
          nlinarith
      _ = 4 * C₁ * Real.exp t * (fplX a b w t + fplY a w t) := by
          rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add iX iY]
          rfl
  exact ⟨hH0, hX0, hY0, hCS, hHd, hgb, hDd, hQd, hqb⟩

theorem lap2_flat_point_locally_const (V : Set E2) (hV : IsOpen V)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) (hharm : ∀ x ∈ V, lap2 h u x = 0)
    (x₀ : E2) (hx₀ : x₀ ∈ V)
    (hflat : ∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k u x₀ = 0) :
    ∀ᶠ x in 𝓝 x₀, u x = u x₀ :=
by
  obtain ⟨ρ, hρ, hball, hdec⟩ := flat_taylor_decay V hV u hu x₀ hx₀ hflat
  obtain ⟨T, C₁, a, b, c, w, hC₁, hcyl, hwdec, hfin⟩ :=
    lap2_cylinder_reduction V hV h hh hpos u hu hharm x₀ ρ hρ hball hdec
  obtain ⟨⟨C, g, q, hC, hpt, hDlim, hQlim, hHdec⟩, hvan⟩ :=
    cyl_energy_identities T C₁ a b c w hC₁ hcyl hwdec
  have hH0 := frequency_ode_vanish T C hC (fplH a w) (fplD a b w) (fplX a b w) (fplY a w)
    (fun s => fplX a b w s - fplY a w s) g q
    (fun t ht => (hpt t ht).1) (fun t ht => (hpt t ht).2.1) (fun t ht => (hpt t ht).2.2.1)
    (fun t ht => (hpt t ht).2.2.2.1) (fun t ht => (hpt t ht).2.2.2.2.1)
    (fun t ht => (hpt t ht).2.2.2.2.2.1) (fun t ht => (hpt t ht).2.2.2.2.2.2.1)
    (fun _ _ => rfl) (fun t ht => (hpt t ht).2.2.2.2.2.2.2.1)
    (fun t ht => (hpt t ht).2.2.2.2.2.2.2.2) hDlim hQlim hHdec
  apply hfin
  intro p hp
  exact hvan p.1 hp (hH0 p.1 hp) p.2

theorem e2_crit_nonflat_null (hsub : ∀ (W : Set E2) (f : E2 → ℝ), IsOpen W → ContDiffOn ℝ ∞ f W →
      (∀ z ∈ W, fderiv ℝ f z ≠ 0) → MeasureTheory.volume (W ∩ f ⁻¹' {0}) = 0)
    (V : Set E2) (hV : IsOpen V) (f : E2 → ℝ) (hf : ContDiffOn ℝ ∞ f V) :
    MeasureTheory.volume {x | x ∈ V ∧ fderiv ℝ f x = 0 ∧
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k f x ≠ 0} = 0 :=
by
  classical
  
  have hsm : ∀ (m : ℕ) (u : Fin m → E2),
      ContDiffOn ℝ ∞ (fun y => iteratedFDeriv ℝ m f y u) V ∧
      ∀ y ∈ V, ∀ v : E2,
        fderiv ℝ (fun y' => iteratedFDeriv ℝ m f y' u) y v =
          fderiv ℝ (iteratedFDeriv ℝ m f) y v u := by
    intro m u
    have hat : ∀ y ∈ V, ContDiffAt ℝ ∞ (iteratedFDeriv ℝ m f) y := by
      intro y hy
      have hfy : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hV.mem_nhds hy)
      refine hfy.iteratedFDeriv_right ?_
      rw [← WithTop.coe_natCast, ← WithTop.coe_add, top_add]
    refine ⟨fun y hy => ?_, fun y hy v => ?_⟩
    · have h1 := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin m => E2) ℝ u).contDiff.contDiffAt.comp
        y (hat y hy)
      exact h1.contDiffWithinAt
    · have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ m f) y :=
        (hat y hy).differentiableAt (by simp)
      exact fderiv_continuousMultilinear_apply_const_apply hd u v
  
  have hbw : ∀ (m : ℕ) (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => E2) ℝ), L ≠ 0 →
      ∃ ι : Fin m → Fin 2, L (fun i => e2 (ι i)) ≠ 0 := by
    intro m L hL
    by_contra hcon
    push_neg at hcon
    apply hL
    apply ContinuousMultilinearMap.toMultilinearMap_injective
    rw [ContinuousMultilinearMap.toMultilinearMap_zero]
    refine Module.Basis.ext_multilinear (ιM := fun _ => Fin 2)
      (fun _ => (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis) ?_
    intro v
    simp only [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply,
      ContinuousMultilinearMap.coe_coe, MultilinearMap.zero_apply]
    exact hcon v
  
  let φ : (Σ m : ℕ, Fin m → Fin 2) → E2 → ℝ :=
    fun p y => iteratedFDeriv ℝ p.1 f y (fun i => e2 (p.2 i))
  let N : (Σ m : ℕ, Fin m → Fin 2) → Set E2 :=
    fun p => (V ∩ (fderiv ℝ (φ p)) ⁻¹' {0}ᶜ) ∩ φ p ⁻¹' {0}
  have hN : ∀ p, MeasureTheory.volume (N p) = 0 := by
    intro p
    have hφ := (hsm p.1 (fun i => e2 (p.2 i))).1
    have hopen : IsOpen (V ∩ (fderiv ℝ (φ p)) ⁻¹' {0}ᶜ) :=
      (hφ.continuousOn_fderiv_of_isOpen hV (by simp)).isOpen_inter_preimage hV
        isOpen_compl_singleton
    exact hsub _ (φ p) hopen (hφ.mono Set.inter_subset_left) (fun z hz => hz.2)
  have hcover : {x | x ∈ V ∧ fderiv ℝ f x = 0 ∧
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k f x ≠ 0} ⊆ ⋃ p, N p := by
    rintro x ⟨hxV, hdf, H⟩
    have hk1 := Nat.find_spec H
    set k₀ := Nat.find H with hk₀
    have hne1 : k₀ ≠ 1 := by
      intro h1
      apply hk1.2
      rw [h1]
      rw [← norm_eq_zero, norm_iteratedFDeriv_one, hdf, norm_zero]
    obtain ⟨m, hm⟩ : ∃ m, k₀ = m + 1 := ⟨k₀ - 1, by omega⟩
    have hm1 : 1 ≤ m := by omega
    have hDm : iteratedFDeriv ℝ m f x = 0 := by
      have hmin := Nat.find_min H (show m < Nat.find H by omega)
      push_neg at hmin
      exact hmin hm1
    have hDm1 : iteratedFDeriv ℝ (m + 1) f x ≠ 0 := by rw [← hm]; exact hk1.2
    obtain ⟨v, hv⟩ : ∃ v, iteratedFDeriv ℝ (m + 1) f x v ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hDm1 (ContinuousMultilinearMap.ext hcon)
    rw [iteratedFDeriv_succ_apply_left] at hv
    have hL : fderiv ℝ (iteratedFDeriv ℝ m f) x (v 0) ≠ 0 := by
      intro h0
      rw [h0, ContinuousMultilinearMap.zero_apply] at hv
      exact hv rfl
    obtain ⟨ι, hι⟩ := hbw m _ hL
    refine Set.mem_iUnion.2 ⟨⟨m, ι⟩, ⟨hxV, ?_⟩, ?_⟩
    · show fderiv ℝ (φ ⟨m, ι⟩) x ∉ ({0} : Set (E2 →L[ℝ] ℝ))
      intro h0
      have h0' : fderiv ℝ (φ ⟨m, ι⟩) x = 0 := h0
      have hfor := (hsm m (fun i => e2 (ι i))).2 x hxV (v 0)
      apply hι
      rw [← hfor]
      show fderiv ℝ (φ ⟨m, ι⟩) x (v 0) = 0
      rw [h0']
      rfl
    · show iteratedFDeriv ℝ m f x (fun i => e2 (ι i)) = 0
      rw [hDm]
      rfl
  exact MeasureTheory.measure_mono_null hcover (MeasureTheory.measure_iUnion_null hN)

theorem pcgb_no_flat_point {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ)
    (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b)
    (hsucp : ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      (∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x = 0) →
      ∀ᶠ y in 𝓝 x, Gd.w (P.param j y) = Gd.w (P.param j x)) :
    ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x ≠ 0 :=
by
  intro j x hx hbx hp
  by_contra hcon
  push_neg at hcon
  
  have hparamS : ∀ i, ∀ y ∈ P.W i, P.param i y ∈ S ∧ P.param i y ∈ P.O i := by
    intro i y hy
    have h1 : P.param i y ∈ P.param i '' P.W i := Set.mem_image_of_mem _ hy
    rw [P.image_eq i] at h1
    exact ⟨h1.2, h1.1⟩
  have hC0 : ∀ q ∈ S, ∃ i, ∃ y ∈ P.W i, P.param i y = q := by
    intro q hq
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (P.cover hq)
    have h1 : q ∈ P.param i '' P.W i := by rw [P.image_eq i]; exact ⟨hi, hq⟩
    obtain ⟨y, hy, hyq⟩ := h1
    exact ⟨i, y, hy, hyq⟩
  have htrans : ∀ i, ∀ y ∈ P.W i, ∀ p : E2 → Prop, (∀ᶠ z in 𝓝 y, p z) →
      ∀ᶠ q in 𝓝 (P.param i y), q ∈ S → ∃ z ∈ P.W i, P.param i z = q ∧ p z := by
    intro i y hy p hpz
    obtain ⟨t, ht, hto, hyt⟩ := _root_.eventually_nhds_iff.mp hpz
    have hN : IsOpen (P.O i ∩ P.proj i ⁻¹' (t ∩ P.W i)) :=
      (P.proj_cont i).isOpen_inter_preimage (P.O_open i) (hto.inter (P.W_open i))
    have hqN : P.param i y ∈ P.O i ∩ P.proj i ⁻¹' (t ∩ P.W i) := by
      refine ⟨(hparamS i y hy).2, ?_⟩
      show P.proj i (P.param i y) ∈ t ∩ P.W i
      rw [P.proj_param i y hy]
      exact ⟨hyt, hy⟩
    filter_upwards [hN.mem_nhds hqN] with q hq hqS
    have h1 : q ∈ P.param i '' P.W i := by rw [P.image_eq i]; exact ⟨hq.1, hqS⟩
    obtain ⟨z, hz, rfl⟩ := h1
    have h2 : P.proj i (P.param i z) ∈ t ∩ P.W i := hq.2
    rw [P.proj_param i z hz] at h2
    exact ⟨z, hz, rfl, ht z h2.1⟩
  have hback : ∀ i, ∀ y ∈ P.W i, ∀ Φ : X → Prop, (∀ᶠ q in 𝓝 (P.param i y), Φ q) →
      ∀ᶠ z in 𝓝 y, z ∈ P.W i ∧ Φ (P.param i z) := by
    intro i y hy Φ hΦ
    have hc : ContinuousAt (P.param i) y :=
      (P.param_cont i).continuousAt ((P.W_open i).mem_nhds hy)
    have hW : ∀ᶠ z in 𝓝 y, z ∈ P.W i := (P.W_open i).mem_nhds hy
    exact hW.and (Filter.Tendsto.eventually hc hΦ)
  have hsmoothAt : ∀ i, ∀ y ∈ P.W i, P.param i y ∈ Gd.U → P.param i y ≠ Gd.p₀ →
      ContDiffAt ℝ ∞ (fun z => Gd.w (P.param i z)) y := by
    intro i y hy hU hne
    have hV : IsOpen (P.W i ∩ P.param i ⁻¹' (Gd.U \ {Gd.p₀})) :=
      (P.param_cont i).isOpen_inter_preimage (P.W_open i) (Gd.U_open.sdiff isClosed_singleton)
    exact (Gd.smooth i).contDiffAt (hV.mem_nhds ⟨hy, hU, hne⟩)
  have hbp₀ : 0 < b Gd.p₀ := by
    have h1 := Gd.ball_pos Gd.x₀ (Metric.mem_closedBall_self Gd.r_pos.le)
    rw [Gd.param_x₀] at h1
    linarith [Gd.r_pos]
  
  have hgood : ∀ (c : ℝ) (i : Fin P.n), ∀ y ∈ P.W i, 0 < b (P.param i y) →
      P.param i y ≠ Gd.p₀ → (∀ᶠ z in 𝓝 y, Gd.w (P.param i z) = c) →
      ∀ᶠ q in 𝓝 (P.param i y), q ∈ S → Gd.w q = c ∧ 0 < b q ∧ q ≠ Gd.p₀ := by
    intro c i y hy hby hpy hc
    have hbc : ContinuousAt (fun z => b (P.param i z)) y :=
      (hb i).continuousOn.continuousAt ((P.W_open i).mem_nhds hy)
    have hbpos : ∀ᶠ z in 𝓝 y, 0 < b (P.param i z) :=
      Filter.Tendsto.eventually hbc (lt_mem_nhds hby)
    have hne : ∀ᶠ q in 𝓝 (P.param i y), q ≠ Gd.p₀ := eventually_ne_nhds hpy
    filter_upwards [htrans i y hy _ (hc.and hbpos), hne] with q hq hq0 hqS
    obtain ⟨z, hz, rfl, hzc, hzb⟩ := hq hqS
    exact ⟨hzc, hzb, hq0⟩
  
  have hbdry : ∀ (c : ℝ), c < 0 → ∀ q ∈ S, b q = 0 →
      ∀ᶠ q' in 𝓝 q, q' ∈ S → c < Gd.w q' := by
    intro c hc q hqS hq0
    obtain ⟨i, y, hy, rfl⟩ := hC0 q hqS
    have hw0 := (Gd.dirichlet i y hy hq0).1
    have hne : P.param i y ≠ Gd.p₀ := by
      intro h
      rw [h] at hq0
      linarith
    have hU : P.param i y ∈ Gd.U := Gd.R_sub ⟨hqS, hq0.ge⟩
    have hcont := (hsmoothAt i y hy hU hne).continuousAt
    have hnb : ∀ᶠ t in 𝓝 (Gd.w (P.param i y)), c < t := by
      rw [hw0]
      exact lt_mem_nhds hc
    have hev : ∀ᶠ z in 𝓝 y, c < Gd.w (P.param i z) := Filter.Tendsto.eventually hcont hnb
    filter_upwards [htrans i y hy _ hev] with q' hq' hq'S
    obtain ⟨z, hz, rfl, hzc⟩ := hq' hq'S
    exact hzc
  
  have hpole : ∀ c : ℝ, ∀ᶠ q in 𝓝 Gd.p₀, q ∈ S → q ≠ Gd.p₀ → Gd.w q < c := by
    intro c
    have hx₀W : Gd.x₀ ∈ P.W Gd.j₀ := Gd.ball_sub (Metric.mem_closedBall_self Gd.r_pos.le)
    have hHpd : (P.h Gd.j₀ Gd.x₀).PosDef := P.h_posDef Gd.j₀ Gd.x₀ hx₀W
    obtain ⟨Mb, hMb⟩ : ∃ Mb : ℝ, Mb = ∑ a : Fin 2, ∑ a' : Fin 2, |P.h Gd.j₀ Gd.x₀ a a'| :=
      ⟨_, rfl⟩
    have hMb0 : 0 ≤ Mb := by
      rw [hMb]
      exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun a' _ => abs_nonneg _))
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = Real.exp (c - Gd.C) := ⟨_, rfl⟩
    have hE0 : 0 < E := by rw [hE]; exact Real.exp_pos _
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min Gd.r (min 1 (E ^ 2 / (Mb + 1))) := ⟨_, rfl⟩
    have hδ0 : 0 < δ := by
      rw [hδ]
      exact lt_min Gd.r_pos (lt_min one_pos (div_pos (pow_pos hE0 2) (by linarith)))
    have key : ∀ y ∈ Metric.ball Gd.x₀ δ, y ≠ Gd.x₀ → Gd.w (P.param Gd.j₀ y) < c := by
      intro y hy hyne
      have hd : dist y Gd.x₀ < δ := hy
      rw [hδ] at hd
      obtain ⟨hdr, hd'⟩ := lt_min_iff.mp hd
      obtain ⟨hd1, hdE⟩ := lt_min_iff.mp hd'
      have hd0 : 0 ≤ dist y Gd.x₀ := dist_nonneg
      have hvne : (fun a => (y - Gd.x₀) a) ≠ 0 := by
        intro h
        apply hyne
        have : y - Gd.x₀ = 0 := by
          ext a
          have := congrFun h a
          simpa using this
        exact sub_eq_zero.mp this
      have hQpos : 0 < ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' := by
        have h := hHpd.dotProduct_mulVec_pos hvne
        have heq : dotProduct (star (fun a => (y - Gd.x₀) a))
            ((P.h Gd.j₀ Gd.x₀).mulVec (fun a => (y - Gd.x₀) a)) =
            ∑ a : Fin 2, ∑ a' : Fin 2,
              P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' := by
          simp [dotProduct, Matrix.mulVec, Fin.sum_univ_two]
          ring
        linarith
      have hva : ∀ a, |(y - Gd.x₀) a| ≤ dist y Gd.x₀ := by
        intro a
        rw [dist_eq_norm]
        have := PiLp.norm_apply_le (y - Gd.x₀) a
        rwa [Real.norm_eq_abs] at this
      have hQle : ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' ≤ Mb * dist y Gd.x₀ ^ 2 := by
        rw [hMb, Finset.sum_mul]
        apply Finset.sum_le_sum
        intro a _
        rw [Finset.sum_mul]
        apply Finset.sum_le_sum
        intro a' _
        have h1 := hva a
        have h2 := hva a'
        calc P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a'
            ≤ |P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a'| := le_abs_self _
          _ = |P.h Gd.j₀ Gd.x₀ a a'| * |(y - Gd.x₀) a| * |(y - Gd.x₀) a'| := by
            rw [abs_mul, abs_mul]
          _ ≤ |P.h Gd.j₀ Gd.x₀ a a'| * dist y Gd.x₀ * dist y Gd.x₀ := by gcongr
          _ = |P.h Gd.j₀ Gd.x₀ a a'| * dist y Gd.x₀ ^ 2 := by ring
      have hQE : ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' < E ^ 2 := by
        have h1 : dist y Gd.x₀ ^ 2 ≤ dist y Gd.x₀ := by nlinarith
        have h2 : dist y Gd.x₀ * (Mb + 1) < E ^ 2 := (lt_div_iff₀ (by linarith)).mp hdE
        have h3 : Mb * dist y Gd.x₀ ^ 2 ≤ Mb * dist y Gd.x₀ := mul_le_mul_of_nonneg_left h1 hMb0
        nlinarith
      have hrad : pcgbPoleRad P Gd.j₀ Gd.x₀ y < E := by
        unfold pcgbPoleRad
        rw [Real.sqrt_lt' hE0]
        exact hQE
      have hradpos : 0 < pcgbPoleRad P Gd.j₀ Gd.x₀ y := by
        unfold pcgbPoleRad
        exact Real.sqrt_pos.mpr hQpos
      have hlog : Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y) < c - Gd.C := by
        rw [Real.log_lt_iff_lt_exp hradpos, ← hE]
        exact hrad
      have hpb := (Gd.pole y (Metric.mem_ball.mpr hdr) hyne).1
      have := (abs_le.mp hpb).2
      linarith
    have hballnhds : ∀ᶠ z in 𝓝 Gd.x₀, z ∈ Metric.ball Gd.x₀ δ := Metric.ball_mem_nhds _ hδ0
    have htr := htrans Gd.j₀ Gd.x₀ hx₀W _ hballnhds
    rw [Gd.param_x₀] at htr
    filter_upwards [htr] with q hq hqS hqne
    obtain ⟨z, hz, rfl, hzb⟩ := hq hqS
    have hzne : z ≠ Gd.x₀ := by
      intro h
      apply hqne
      rw [h, Gd.param_x₀]
    exact key z hzb hzne
  
  have hinterior : ∀ (c : ℝ), ∀ q ∈ S, 0 < b q → q ≠ Gd.p₀ →
      (∃ᶠ q' in 𝓝 q, q' ∈ S ∧
        ∀ᶠ q'' in 𝓝 q', q'' ∈ S → Gd.w q'' = c ∧ 0 < b q'' ∧ q'' ≠ Gd.p₀) →
      ∀ᶠ q' in 𝓝 q, q' ∈ S → Gd.w q' = c ∧ 0 < b q' ∧ q' ≠ Gd.p₀ := by
    intro c q hqS hbq hqp hfreq
    obtain ⟨i, y, hy, rfl⟩ := hC0 q hqS
    have hU : P.param i y ∈ Gd.U := Gd.R_sub ⟨hqS, hbq.le⟩
    have hcd := hsmoothAt i y hy hU hqp
    have hacc : ∃ᶠ z in 𝓝 y, ∀ᶠ z' in 𝓝 z, Gd.w (P.param i z') = c := by
      intro hnot
      have h1 := htrans i y hy _ hnot
      obtain ⟨q', ⟨hq'S, hq'good⟩, hq'z⟩ := (hfreq.and_eventually h1).exists
      obtain ⟨z, hz, rfl, hznot⟩ := hq'z hq'S
      apply hznot
      have h2 := hback i z hz _ hq'good
      filter_upwards [h2] with z' hz'
      exact (hz'.2 (hparamS i z' hz'.1).1).1
    have hflat : ∀ k : ℕ, 1 ≤ k →
        iteratedFDeriv ℝ k (fun z => Gd.w (P.param i z)) y = 0 := by
      intro k hk
      by_contra hne
      have hcont : ContinuousAt (iteratedFDeriv ℝ k (fun z => Gd.w (P.param i z))) y :=
        hcd.continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
      have hev := hcont.eventually_ne hne
      obtain ⟨z, hzc, hzne⟩ := (hacc.and_eventually hev).exists
      apply hzne
      have heq : (fun z' => Gd.w (P.param i z')) =ᶠ[𝓝 z] (fun _ => c) := hzc
      rw [(heq.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_const_of_ne (by omega : k ≠ 0)]
      rfl
    have hloc := hsucp i y hy hbq hqp hflat
    have hval : Gd.w (P.param i y) = c := by
      obtain ⟨z, hzc, hzl⟩ := (hacc.and_eventually hloc).exists
      rw [← hzl]
      exact hzc.self_of_nhds
    exact hgood c i y hy hbq hqp (hloc.mono fun z hz => hz.trans hval)
  
  have hq₁S := (hparamS j x hx).1
  have hc0 : Gd.w (P.param j x) < 0 := Gd.neg _ hq₁S hbx hp
  have hloc₁ := hsucp j x hx hbx hp hcon
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Gd.w (P.param j x) := ⟨_, rfl⟩
  rw [← hcdef] at hc0 hloc₁
  have hgood₁ := hgood c j x hx hbx hp hloc₁
  let Good : X → Prop := fun q =>
    ∀ᶠ q' in 𝓝 q, q' ∈ S → Gd.w q' = c ∧ 0 < b q' ∧ q' ≠ Gd.p₀
  have hu : IsOpen {q | Good q} := isOpen_setOf_eventually_nhds
  have hv : IsOpen {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'} := isOpen_setOf_eventually_nhds
  have hdisj : {q | q ∈ S ∧ 0 ≤ b q} ∩
      ({q | Good q} ∩ {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'}) = ∅ := by
    ext q
    constructor
    · rintro ⟨⟨hqS, _⟩, hqu, hqv⟩
      exact absurd hqu (hqv.self_of_nhds hqS)
    · intro h
      exact h.elim
  have hcover : {q | q ∈ S ∧ 0 ≤ b q} ⊆
      {q | Good q} ∪ {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'} := by
    rintro q ⟨hqS, hbq⟩
    by_cases hqv : ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'
    · exact Or.inr hqv
    left
    have F : ∃ᶠ q' in 𝓝 q, q' ∈ S ∧ Good q' := by
      rw [Filter.not_eventually] at hqv
      exact hqv.mono fun q' h =>
        ⟨(_root_.not_imp.mp h).1, not_not.mp (_root_.not_imp.mp h).2⟩
    rcases eq_or_lt_of_le hbq with h0 | hpos
    · exfalso
      obtain ⟨q', ⟨hq'S, hq'g⟩, hlt⟩ := (F.and_eventually (hbdry c hc0 q hqS h0.symm)).exists
      have h1 := (hq'g.self_of_nhds hq'S).1
      have h2 := hlt hq'S
      linarith
    · by_cases hqp : q = Gd.p₀
      · exfalso
        rw [hqp] at F
        obtain ⟨q', ⟨hq'S, hq'g⟩, hlt⟩ := (F.and_eventually (hpole c)).exists
        obtain ⟨h1, _, h3⟩ := hq'g.self_of_nhds hq'S
        have h4 := hlt hq'S h3
        linarith
      · exact hinterior c q hqS hpos hqp F
  rcases isPreconnected_iff_subset_of_disjoint.mp hRconn.isPreconnected _ _ hu hv hcover hdisj
    with hRu | hRv
  · obtain ⟨qb, hqbS, hqb0⟩ := hbd
    have hg : Good qb := hRu ⟨hqbS, hqb0.ge⟩
    have h1 := (hg.self_of_nhds hqbS).2.1
    linarith
  · have hg : ∀ᶠ q' in 𝓝 (P.param j x), q' ∈ S → ¬ Good q' := hRv ⟨hq₁S, hbx.le⟩
    exact hg.self_of_nhds hq₁S hgood₁

theorem e2_submersion_zero_null (W : Set E2) (hW : IsOpen W) (f : E2 → ℝ)
    (hf : ContDiffOn ℝ ∞ f W) (hdf : ∀ z ∈ W, fderiv ℝ f z ≠ 0) :
    MeasureTheory.volume (W ∩ f ⁻¹' {0}) = 0 :=
by
  classical
  set v0 : E2 := EuclideanSpace.single (0 : Fin 2) (1 : ℝ) with hv0
  set v1 : E2 := EuclideanSpace.single (1 : Fin 2) (1 : ℝ) with hv1
  have h1n : (1 : WithTop ℕ∞) ≤ ∞ := by simp
  have hfd : ∀ z ∈ W, HasFDerivAt f (fderiv ℝ f z) z := fun z hz =>
    ((hf.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hz)).hasFDerivAt
  have hDc : ContinuousOn (fderiv ℝ f) W := hf.continuousOn_fderiv_of_isOpen hW h1n
  
  have hZm : ∀ v : E2, MeasurableSet {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0} := by
    intro v
    have hc : ContinuousOn (fun z => fderiv ℝ f z v) W := hDc.clm_apply continuousOn_const
    have hA : IsOpen (W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) :=
      hc.isOpen_inter_preimage hW isOpen_compl_singleton
    have hB : IsOpen ((W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) ∩ f ⁻¹' {0}ᶜ) :=
      (hf.continuousOn.mono Set.inter_subset_left).isOpen_inter_preimage hA
        isOpen_compl_singleton
    have hEq : {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0} =
        (W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) \
          ((W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) ∩ f ⁻¹' {0}ᶜ) := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_inter_iff, Set.mem_preimage,
        Set.mem_compl_iff, Set.mem_singleton_iff]
      tauto
    rw [hEq]
    exact hA.measurableSet.diff hB.measurableSet
  
  have hslice : ∀ v p : E2,
      volume {t : ℝ | p + t • v ∈ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0}} = 0 := by
    intro v p
    apply measure_null_of_locally_null
    intro b hb
    simp only [Set.mem_setOf_eq] at hb
    obtain ⟨hbW, hb0, hbd⟩ := hb
    have hℓ : HasDerivAt (fun t : ℝ => p + t • v) v b := by
      simpa using ((hasDerivAt_id b).smul_const v).const_add p
    have hg : HasDerivAt (fun t : ℝ => f (p + t • v)) (fderiv ℝ f (p + b • v) v) b :=
      (hfd _ hbW).comp_hasDerivAt b hℓ
    have hev : ∀ᶠ z in 𝓝[≠] b, f (p + z • v) ≠ 0 := hg.eventually_ne hbd
    rw [eventually_nhdsWithin_iff] at hev
    refine ⟨_, inter_mem_nhdsWithin _ hev, ?_⟩
    apply measure_mono_null _ (Real.volume_singleton (a := b))
    rintro t ⟨ht, htV⟩
    simp only [Set.mem_setOf_eq] at ht
    by_contra hne
    exact htV hne ht.2.1
  
  have hτ : MeasurePreserving (fun q : ℝ × ℝ => q.1 • v0 + q.2 • v1) volume volume := by
    have h1 := (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
      (volume_preserving_finTwoArrow ℝ)
    have h2 := MeasurePreserving.symm
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow) h1
    convert h2 using 1
    funext q
    ext j
    fin_cases j <;> simp [v0, v1] <;> rfl
  have hZ1 : volume {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v1 ≠ 0} = 0 := by
    rw [← hτ.measure_preimage (hZm v1).nullMeasurableSet, Measure.volume_eq_prod,
      Measure.prod_apply ((hZm v1).preimage hτ.measurable)]
    refine (lintegral_congr (fun a => ?_)).trans lintegral_zero
    exact hslice v1 (a • v0)
  have hZ0 : volume {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0} = 0 := by
    rw [← hτ.measure_preimage (hZm v0).nullMeasurableSet, Measure.volume_eq_prod,
      Measure.prod_apply_symm ((hZm v0).preimage hτ.measurable)]
    refine (lintegral_congr (fun b => ?_)).trans lintegral_zero
    have hs : (fun a : ℝ => (a, b)) ⁻¹'
        ((fun q : ℝ × ℝ => q.1 • v0 + q.2 • v1) ⁻¹'
          {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0}) =
        {t : ℝ | b • v1 + t • v0 ∈ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0}} := by
      ext t
      simp only [Set.mem_preimage, Set.mem_setOf_eq]
      rw [add_comm]
    rw [hs]
    exact hslice v0 (b • v1)
  have hcover : W ∩ f ⁻¹' {0} ⊆ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0} ∪
      {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v1 ≠ 0} := by
    rintro z ⟨hzW, hz0⟩
    have hz0' : f z = 0 := hz0
    by_cases h0 : fderiv ℝ f z v0 = 0
    · by_cases h1 : fderiv ℝ f z v1 = 0
      · exfalso
        apply hdf z hzW
        ext w
        have hw : w = w 0 • v0 + w 1 • v1 := by
          ext j
          fin_cases j <;> simp [v0, v1]
        calc fderiv ℝ f z w = fderiv ℝ f z (w 0 • v0 + w 1 • v1) := by
              conv_lhs => rw [hw]
          _ = 0 := by simp [h0, h1]
          _ = (0 : E2 →L[ℝ] ℝ) w := rfl
      · exact Or.inr ⟨hzW, hz0', h1⟩
    · exact Or.inl ⟨hzW, hz0', h0⟩
  exact measure_mono_null hcover (measure_union_null hZ0 hZ1)

theorem pcgb_defect_small {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ → ∀ s : ℝ, 0 < s →
      pcgbDefect P ρ b Gd.w ε s ≤ θ :=
by
  intro θ hθ
  have hθ' : 0 < θ / ((P.n : ℝ) + 1) := div_pos hθ (by positivity)
  
  have hV : ∀ j : Fin P.n, ∃ V : Set E2, IsOpen V ∧ V ⊆ P.W j ∧
      (∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ → x ∈ V) ∧
      ContDiffOn ℝ ∞ (fun y => Gd.w (P.param j y)) V ∧
      (∀ y ∈ V, lap2 (P.h j) (fun y => Gd.w (P.param j y)) y = 0) := by
    intro j
    refine ⟨(P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) ∩
      (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0), ?_, ?_, ?_, ?_, ?_⟩
    · exact ((P.param_cont j).isOpen_inter_preimage (P.W_open j)
        (Gd.U_open.sdiff isClosed_singleton)).inter
        ((hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi)
    · exact fun y hy => hy.1.1
    · intro x hx hb0 hp
      have hS : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
      rw [P.image_eq j] at hS
      have hU : P.param j x ∈ Gd.U := Gd.R_sub ⟨hS.2, le_of_lt hb0⟩
      exact ⟨⟨hx, hU, hp⟩, hx, hb0⟩
    · exact (Gd.smooth j).mono (fun y hy => hy.1)
    · intro y hy
      have h1 : (0 : ℝ) < b (P.param j y) := hy.2.2
      have h2 : P.param j y ≠ Gd.p₀ := hy.1.2.2
      exact Gd.harm j y hy.1.1 (le_of_lt h1) h2
  
  have hsucp : ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      (∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x = 0) →
      ∀ᶠ y in 𝓝 x, Gd.w (P.param j y) = Gd.w (P.param j x) := by
    intro j x hx hb0 hp hflat
    obtain ⟨V, hVo, hVW, hVmem, hVs, hVh⟩ := hV j
    exact lap2_flat_point_locally_const V hVo (P.h j) (fun a c => (P.h_smooth j a c).mono hVW)
      (fun y hy => P.h_posDef j y (hVW hy)) _ hVs hVh x (hVmem x hx hb0 hp) hflat
  
  have hchart : ∀ j : Fin P.n, ∀ᶠ ε in 𝓝[>] (0 : ℝ), ∀ s : ℝ, 0 < s →
      ∫ x in P.W j, ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
        gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det ≤ θ / ((P.n : ℝ) + 1) := by
    intro j
    have hW : IsOpen (P.W j) := P.W_open j
    have hB : IsOpen (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0) :=
      (hb j).continuousOn.isOpen_inter_preimage hW isOpen_Ioi
    have hmat : ContinuousOn (P.h j) (P.W j) :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c => (P.h_smooth j a c).continuousOn
    have hdetc : ContinuousOn (fun x => (P.h j x).det) (P.W j) :=
      (continuous_id.matrix_det).comp_continuousOn hmat
    have hA : ContinuousOn (fun x => ρ j (P.param j x) * gaussCurv2 (P.h j) x *
        Real.sqrt (P.h j x).det) (P.W j) :=
      ((hρs j j).continuousOn.mul (gaussCurv2_continuousOn (P.h j) (P.W j) hW (P.h_smooth j)
        (P.h_posDef j))).mul hdetc.sqrt
    have hAK : ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) * gaussCurv2 (P.h j) x *
        Real.sqrt (P.h j x).det = 0 := by
      intro x hx hxK
      rw [hρK j x hx hxK]
      ring
    have hinvc : ContinuousOn (fun x => (P.h j x)⁻¹) (P.W j) := by
      refine ContinuousOn.congr ((hdetc.inv₀ fun x hx => (P.h_posDef j x hx).det_pos.ne').smul
        ((continuous_id.matrix_adjugate).comp_continuousOn hmat)) ?_
      intro x _
      show (P.h j x)⁻¹ = (P.h j x).det⁻¹ • (P.h j x).adjugate
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
    have hGm : AEStronglyMeasurable (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)))
        (volume.restrict (P.W j)) := by
      have h1 : ∀ a c : Fin 2, AEStronglyMeasurable (fun x => (P.h j x)⁻¹ a c)
          (volume.restrict (P.W j)) := fun a c =>
        (continuousOn_pi.1 (continuousOn_pi.1 hinvc a) c).aestronglyMeasurable hW.measurableSet
      have h2 : ∀ a : Fin 2, AEStronglyMeasurable (pd2 a (fun y => Gd.w (P.param j y)))
          (volume.restrict (P.W j)) := fun a =>
        (measurable_fderiv_apply_const ℝ (fun y => Gd.w (P.param j y)) (e2 a)).aestronglyMeasurable
      unfold sgbGradSq2
      exact Finset.aestronglyMeasurable_fun_sum _ fun a _ =>
        Finset.aestronglyMeasurable_fun_sum _ fun c _ => ((h1 a c).mul (h2 a)).mul (h2 c)
    have hGnn : ∀ x ∈ P.W j, 0 ≤ sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x :=
      fun x hx => ((posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hx)).1
        (fun a => pd2 a (fun y => Gd.w (P.param j y)) x)).1
    have hnull : volume {x | x ∈ P.W j ∧ x ∈ P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0 ∧
        ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det ≠ 0 ∧
        sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x = 0} = 0 := by
      obtain ⟨V, hVo, hVW, hVmem, hVs, hVh⟩ := hV j
      have hpole : volume {x | x ∈ P.W j ∧ P.param j x = Gd.p₀} = 0 := by
        apply Set.Subsingleton.measure_zero
        intro x hx y hy
        rw [← P.proj_param j x hx.1, ← P.proj_param j y hy.1, hx.2, hy.2]
      have hZ : volume {x | x ∈ V ∧ fderiv ℝ (fun y => Gd.w (P.param j y)) x = 0 ∧
          ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x ≠ 0} = 0 :=
        e2_crit_nonflat_null (fun W f hW hf hdf => e2_submersion_zero_null W hW f hf hdf)
          V hVo _ hVs
      refine measure_mono_null ?_ (measure_union_null hpole hZ)
      rintro x ⟨hxW, ⟨-, hbx⟩, -, hGx⟩
      by_cases hp : P.param j x = Gd.p₀
      · exact Or.inl ⟨hxW, hp⟩
      · have hbx' : (0 : ℝ) < b (P.param j x) := hbx
        have hξ := ((posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hxW)).1
          (fun a => pd2 a (fun y => Gd.w (P.param j y)) x)).2 hGx
        have h0 : fderiv ℝ (fun y => Gd.w (P.param j y)) x (e2 0) = 0 := congrFun hξ 0
        have h1 : fderiv ℝ (fun y => Gd.w (P.param j y)) x (e2 1) = 0 := congrFun hξ 1
        have hD : fderiv ℝ (fun y => Gd.w (P.param j y)) x = 0 := by
          refine ContinuousLinearMap.ext fun v => ?_
          have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
            ext i
            fin_cases i <;> simp
          rw [ContinuousLinearMap.zero_apply, hv, map_add, map_smul, map_smul, h0, h1]
          simp
        exact Or.inr ⟨hVmem x hxW hbx' hp, hD,
          pcgb_no_flat_point S P b hb hRconn hbd Gd hsucp j x hxW hbx' hp⟩
    obtain ⟨ε₀, hε₀, hdct⟩ := e2_eps_weight_dct (P.W j) (Kc j)
      (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0) hW (hK j).1 (hK j).2 hB
      (fun x => ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det)
      (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y))) hA hAK hGm hGnn hnull
      (θ / ((P.n : ℝ) + 1)) hθ'
    filter_upwards [Ioo_mem_nhdsGT hε₀] with ε hε s hs
    have hε0 : 0 < ε := hε.1
    refine hdct ε hε.1 hε.2 (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
        (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
      Real.sqrt (P.h j x).det) ?_
    intro x hx
    have hGx := hGnn x hx
    have hq : 0 ≤ ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε) :=
      div_nonneg hε0.le (by linarith)
    have hind_nn : 0 ≤ (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0).indicator
        (fun y => |ρ j (P.param j y) * gaussCurv2 (P.h j) y * Real.sqrt (P.h j y).det| *
          (ε / (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε))) x := by
      apply Set.indicator_nonneg
      intro y hy
      exact mul_nonneg (abs_nonneg _) (div_nonneg hε0.le (by linarith [hGnn y hy.1]))
    by_cases hbx : 0 < b (P.param j x)
    · have hmem : x ∈ P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0 := ⟨hx, hbx⟩
      have hη0 := Real.smoothTransition.nonneg (b (P.param j x) / s)
      have hη1 := Real.smoothTransition.le_one (b (P.param j x) / s)
      have heq : ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det = Real.smoothTransition (b (P.param j x) / s) *
          ((ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det) *
            (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) := by ring
      have hbound : |ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det| ≤
          |ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det| *
            (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε)) := by
        rw [heq, abs_mul, abs_of_nonneg hη0, abs_mul, abs_of_nonneg hq]
        exact mul_le_of_le_one_left (mul_nonneg (abs_nonneg _) hq) hη1
      rw [Set.indicator_of_mem hmem]
      exact hbound
    · have hη : Real.smoothTransition (b (P.param j x) / s) = 0 :=
        Real.smoothTransition.zero_of_nonpos
          (div_nonpos_of_nonpos_of_nonneg (not_lt.1 hbx) hs.le)
      have hzero : |ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det| = 0 := by
        rw [hη]
        simp
      exact (le_of_eq hzero).trans hind_nn
  
  have hall := Filter.eventually_all.2 hchart
  obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hall
  refine ⟨u, hu, fun ε hε hεu s hs => ?_⟩
  have hj := hsub ⟨hε, hεu⟩
  simp only [Set.mem_setOf_eq] at hj
  have hdef : pcgbDefect P ρ b Gd.w ε s = ∑ j : Fin P.n, ∫ x in P.W j,
      ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
        gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det := rfl
  rw [hdef]
  calc _ ≤ ∑ _j : Fin P.n, θ / ((P.n : ℝ) + 1) := Finset.sum_le_sum fun j _ => hj j s hs
    _ = (P.n : ℝ) * (θ / ((P.n : ℝ) + 1)) := by simp
    _ ≤ θ := by
      rw [mul_div_assoc', div_le_iff₀ (by positivity)]
      nlinarith

theorem pcgb_levelset_second_order (W : Set E2) (hW : IsOpen W) (b w : E2 → ℝ)
    (hb : ContDiffOn ℝ ∞ b W) (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W)
    (hbx : b x = 0) (hdb : fderiv ℝ b x ≠ 0) (hvan : ∀ y ∈ W, b y = 0 → w y = 0) :
    ∃ lam : ℝ, (∀ a : Fin 2, pd2 a w x = lam * pd2 a b x) ∧
      ∀ τ : Fin 2 → ℝ, τ 0 * pd2 0 b x + τ 1 * pd2 1 b x = 0 →
        ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j w) x =
          lam * ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j b) x :=
by
  classical
  have hinf0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have h11inf : (1 : WithTop ℕ∞) + 1 ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have hWn : W ∈ 𝓝 x := hW.mem_nhds hx
  have hbA : ContDiffAt ℝ ∞ b x := hb.contDiffAt hWn
  have hwA : ContDiffAt ℝ ∞ w x := hw.contDiffAt hWn
  
  have hdd : ∀ g : E2 → ℝ, ContDiffAt ℝ ∞ g x → DifferentiableAt ℝ (fderiv ℝ g) x :=
    fun g hg => (hg.fderiv_right (m := 1) h11inf).differentiableAt one_ne_zero
  
  have hbS : HasStrictFDerivAt b (fderiv ℝ b x) x :=
    hbA.hasStrictFDerivAt' (hbA.differentiableAt hinf0).hasFDerivAt hinf0
  have hwS : HasStrictFDerivAt w (fderiv ℝ w x) x :=
    hwA.hasStrictFDerivAt' (hwA.differentiableAt hinf0).hasFDerivAt hinf0
  have hmin : IsMinFilter w (𝓝[{y | b y = b x}] x) x := by
    show ∀ᶠ y in 𝓝[{y | b y = b x}] x, w x ≤ w y
    filter_upwards [mem_nhdsWithin_of_mem_nhds hWn, self_mem_nhdsWithin] with y hyW hyb
    have hy0 : b y = 0 := by simpa [hbx] using hyb
    rw [hvan x hx hbx, hvan y hyW hy0]
  have hext : IsLocalExtrOn w {y | b y = b x} x := Or.inl hmin
  obtain ⟨α, β, hαβ, hrel⟩ := hext.exists_multipliers_of_hasStrictFDerivAt_1d hbS hwS
  have hβ : β ≠ 0 := by
    rintro rfl
    have hα : α ≠ 0 := by
      intro h
      apply hαβ
      simp [h]
    simp only [zero_smul, add_zero] at hrel
    exact hdb ((smul_eq_zero.mp hrel).resolve_left hα)
  have hDw : ∀ u : E2, fderiv ℝ w x u = (-α / β) * fderiv ℝ b x u := by
    intro u
    have h := congrArg (fun f : E2 →L[ℝ] ℝ => f u) hrel
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
      ContinuousLinearMap.zero_apply] at h
    rw [div_mul_eq_mul_div, eq_div_iff hβ]
    linear_combination h
  
  have hexp : ∀ g : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ g) x → ∀ i j : Fin 2,
      pd2 i (pd2 j g) x = fderiv ℝ (fderiv ℝ g) x (e2 i) (e2 j) := by
    intro g hg i j
    have h1 : HasFDerivAt (fun y => fderiv ℝ g y (e2 j))
        ((fderiv ℝ g x).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ g) x).flip (e2 j)) x :=
      hg.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 j) x)
    show fderiv ℝ (fun y => fderiv ℝ g y (e2 j)) x (e2 i) = _
    rw [h1.fderiv]
    simp
  have hquad : ∀ g : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ g) x → ∀ τ : Fin 2 → ℝ,
      ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j g) x =
        fderiv ℝ (fderiv ℝ g) x (τ 0 • e2 0 + τ 1 • e2 1) (τ 0 • e2 0 + τ 1 • e2 1) := by
    intro g hg τ
    simp only [Fin.sum_univ_two, hexp g hg, map_add, map_smul, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hsecond : ∀ g : E2 → ℝ, ContDiffOn ℝ ∞ g W → ∀ γ : ℝ → E2, ContDiffAt ℝ ∞ γ 0 →
      γ 0 = x → (∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ W ∧ g (γ t) = 0) →
      fderiv ℝ (fderiv ℝ g) x (deriv γ 0) (deriv γ 0) + fderiv ℝ g x (deriv (deriv γ) 0) = 0 := by
    intro g hg γ hγ hγ0 hev
    have hgd : ∀ y ∈ W, DifferentiableAt ℝ g y :=
      fun y hy => (hg.contDiffAt (hW.mem_nhds hy)).differentiableAt hinf0
    have hγ2 : ContDiffAt ℝ 2 γ 0 := hγ.of_le h2inf
    have hγev : ∀ᶠ t in 𝓝 (0 : ℝ), DifferentiableAt ℝ γ t :=
      (hγ2.eventually (by simp)).mono fun t ht => ht.differentiableAt (by simp)
    have hγd0 : DifferentiableAt ℝ γ 0 := hγ.differentiableAt hinf0
    have hγdd : DifferentiableAt ℝ (deriv γ) 0 := by
      have h1 : DifferentiableAt ℝ (fderiv ℝ γ) 0 :=
        (hγ.fderiv_right (m := 1) h11inf).differentiableAt one_ne_zero
      exact h1.clm_apply (differentiableAt_const (1 : ℝ))
    have hcomp : (fun t => g (γ t)) =ᶠ[𝓝 (0 : ℝ)] fun _ => (0 : ℝ) := hev.mono fun t ht => ht.2
    have hk0 : (fun y => ((fderiv ℝ g ∘ γ) y) (deriv γ y)) =ᶠ[𝓝 (0 : ℝ)] fun _ => (0 : ℝ) := by
      filter_upwards [hcomp.deriv, hev, hγev] with t h1t ht hγt
      have hD := (hgd _ ht.1).hasFDerivAt.comp_hasDerivAt t hγt.hasDerivAt
      rw [deriv_const] at h1t
      exact hD.deriv.symm.trans h1t
    have hc : HasDerivAt (fderiv ℝ g ∘ γ) (fderiv ℝ (fderiv ℝ g) x (deriv γ 0)) 0 :=
      (hdd g (hg.contDiffAt (hγ0 ▸ hWn))).hasFDerivAt.comp_hasDerivAt_of_eq 0
        hγd0.hasDerivAt hγ0.symm
    have hk := hc.clm_apply hγdd.hasDerivAt
    have e := hk.unique ((hasDerivAt_const (0 : ℝ) (0 : ℝ)).congr_of_eventuallyEq hk0)
    simpa [Function.comp, hγ0] using e
  
  have hcurve : ∀ v : E2, v ≠ 0 → fderiv ℝ b x v = 0 → ∃ γ : ℝ → E2, ContDiffAt ℝ ∞ γ 0 ∧
      γ 0 = x ∧ HasDerivAt γ v 0 ∧ ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ W ∧ b (γ t) = 0 := by
    intro v hv0 hDbv
    have hu_exp : ∀ u : E2, u = u 0 • e2 0 + u 1 • e2 1 := by
      intro u; ext i; fin_cases i <;> simp
    have hinner : ∀ u : E2, innerSL ℝ v u = v 0 * u 0 + v 1 * u 1 := by
      intro u
      simp [PiLp.inner_apply, Fin.sum_univ_two] <;> ring
    have hDb : ∀ u : E2, fderiv ℝ b x u = u 0 * fderiv ℝ b x (e2 0) + u 1 * fderiv ℝ b x (e2 1) := by
      intro u
      conv_lhs => rw [hu_exp u]
      simp only [map_add, map_smul, smul_eq_mul]
    have hβne : fderiv ℝ b x (e2 0) ≠ 0 ∨ fderiv ℝ b x (e2 1) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hdb
      refine ContinuousLinearMap.ext fun u => ?_
      rw [hDb u, hcon.1, hcon.2]
      simp
    have hvne : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hv0
      rw [hu_exp v, hcon.1, hcon.2]
      simp
    have hpos : 0 < v 0 ^ 2 + v 1 ^ 2 := by
      rcases hvne with h | h
      · have := lt_of_le_of_ne (sq_nonneg (v 0)) (Ne.symm (pow_ne_zero 2 h))
        nlinarith [sq_nonneg (v 1)]
      · have := lt_of_le_of_ne (sq_nonneg (v 1)) (Ne.symm (pow_ne_zero 2 h))
        nlinarith [sq_nonneg (v 0)]
    let L : E2 →L[ℝ] ℝ × ℝ := (fderiv ℝ b x).prod (innerSL ℝ v)
    have hLapp : ∀ u : E2, L u = (fderiv ℝ b x u, innerSL ℝ v u) := fun u => rfl
    have hLinj : Function.Injective L := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      rw [hLapp] at hu
      have h1 : fderiv ℝ b x u = 0 := congrArg Prod.fst hu
      have h2 : innerSL ℝ v u = 0 := congrArg Prod.snd hu
      rw [hDb] at h1
      rw [hinner] at h2
      have e2' := hDbv
      rw [hDb] at e2'
      have hD : u 0 * v 1 - u 1 * v 0 = 0 := by
        rcases hβne with h | h
        · have : fderiv ℝ b x (e2 0) * (u 0 * v 1 - u 1 * v 0) = 0 := by
            linear_combination (v 1) * h1 - (u 1) * e2'
          exact (mul_eq_zero.mp this).resolve_left h
        · have : fderiv ℝ b x (e2 1) * (u 0 * v 1 - u 1 * v 0) = 0 := by
            linear_combination (u 0) * e2' - (v 0) * h1
          exact (mul_eq_zero.mp this).resolve_left h
      have hu0 : u 0 = 0 := by
        have : u 0 * (v 0 ^ 2 + v 1 ^ 2) = 0 := by linear_combination (v 0) * h2 + (v 1) * hD
        exact (mul_eq_zero.mp this).resolve_right (ne_of_gt hpos)
      have hu1 : u 1 = 0 := by
        have : u 1 * (v 0 ^ 2 + v 1 ^ 2) = 0 := by linear_combination (v 1) * h2 - (v 0) * hD
        exact (mul_eq_zero.mp this).resolve_right (ne_of_gt hpos)
      rw [hu_exp u, hu0, hu1]
      simp
    have hfin : Module.finrank ℝ E2 = Module.finrank ℝ (ℝ × ℝ) := by
      rw [finrank_euclideanSpace_fin]; simp
    have hLsurj : Function.Surjective L :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin (f := (L : E2 →ₗ[ℝ] ℝ × ℝ))).mp
        hLinj
    let L' : E2 ≃L[ℝ] ℝ × ℝ := ContinuousLinearEquiv.ofBijective L
      (LinearMap.ker_eq_bot.mpr hLinj) (LinearMap.range_eq_top.mpr hLsurj)
    have hL'coe : (L' : E2 →L[ℝ] ℝ × ℝ) = L := ContinuousLinearEquiv.coe_ofBijective _ _ _
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : E2 → ℝ × ℝ, Φ = fun y => (b y, innerSL ℝ v y) := ⟨_, rfl⟩
    have hΦL : HasFDerivAt Φ L x := by
      rw [hΦdef]
      exact (hbA.differentiableAt hinf0).hasFDerivAt.prodMk (innerSL ℝ v).hasFDerivAt
    have hΦL' : HasFDerivAt Φ (L' : E2 →L[ℝ] ℝ × ℝ) x := by rw [hL'coe]; exact hΦL
    have hΦc : ContDiffAt ℝ ∞ Φ x := by
      rw [hΦdef]
      exact hbA.prodMk (innerSL ℝ v).contDiff.contDiffAt
    have hS : HasStrictFDerivAt Φ (L' : E2 →L[ℝ] ℝ × ℝ) x := hΦc.hasStrictFDerivAt' hΦL' hinf0
    obtain ⟨Ψ, hΨc, hΨx, hright, hΨd⟩ : ∃ Ψ : ℝ × ℝ → E2, ContDiffAt ℝ ∞ Ψ (Φ x) ∧
        Ψ (Φ x) = x ∧ (∀ᶠ z in 𝓝 (Φ x), Φ (Ψ z) = z) ∧
        HasFDerivAt Ψ (L'.symm : ℝ × ℝ →L[ℝ] E2) (Φ x) :=
      ⟨_, hΦc.to_localInverse hΦL' hinf0, hΦc.localInverse_apply_image hΦL' hinf0,
        hS.eventually_right_inverse, hS.to_localInverse.hasFDerivAt⟩
    have hLv : L' v = ((0 : ℝ), innerSL ℝ v v) := by
      rw [← ContinuousLinearEquiv.coe_coe, hL'coe, hLapp, hDbv]
    have hℓ : HasDerivAt (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v))
        ((0 : ℝ), innerSL ℝ v v) 0 := by
      have := ((hasDerivAt_id (0 : ℝ)).smul_const ((0 : ℝ), innerSL ℝ v v)).const_add (Φ x)
      simpa using this
    have hℓc : ContDiffAt ℝ ∞ (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0 :=
      (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffAt
    have hℓ0 : (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0 = Φ x := by simp
    refine ⟨fun t => Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v)), ?_, ?_, ?_, ?_⟩
    · have h1 : ContDiffAt ℝ ∞ Ψ ((fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0) := by
        rw [hℓ0]; exact hΨc
      exact h1.comp (0 : ℝ) hℓc
    · simp [hΨx]
    · have h1 := hΨd.comp_hasDerivAt_of_eq (0 : ℝ) hℓ hℓ0.symm
      have h2 : (L'.symm : ℝ × ℝ →L[ℝ] E2) ((0 : ℝ), innerSL ℝ v v) = v := by
        rw [ContinuousLinearEquiv.coe_coe, ContinuousLinearEquiv.symm_apply_eq, hLv]
      rw [h2] at h1
      exact h1
    · have hγc : ContinuousAt (fun t : ℝ => Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v))) 0 := by
        have h1 : ContDiffAt ℝ ∞ Ψ ((fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0) := by
          rw [hℓ0]; exact hΨc
        exact (h1.comp (0 : ℝ) hℓc).continuousAt
      have hmemW : ∀ᶠ t in 𝓝 (0 : ℝ), Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v)) ∈ W := by
        apply hγc.eventually_mem
        simp only [zero_smul, add_zero, hΨx]
        exact hWn
      have htend : Tendsto (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) (𝓝 0) (𝓝 (Φ x)) := by
        have := hℓ.continuousAt.tendsto
        rw [zero_smul, add_zero] at this
        exact this
      have hfst : ∀ y, (Φ y).1 = b y := fun y => by rw [hΦdef]
      filter_upwards [hmemW, htend.eventually hright] with t htW htR
      refine ⟨htW, ?_⟩
      have h1 := congrArg Prod.fst htR
      rw [← hfst (Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v))), h1]
      simp [hfst, hbx]
  refine ⟨-α / β, fun a => hDw (e2 a), ?_⟩
  intro τ hτ
  obtain ⟨v, hv⟩ : ∃ v : E2, v = τ 0 • e2 0 + τ 1 • e2 1 := ⟨_, rfl⟩
  rw [hquad w (hdd w hwA) τ, hquad b (hdd b hbA) τ, ← hv]
  by_cases hv0 : v = 0
  · simp [hv0]
  have hDbv : fderiv ℝ b x v = 0 := by
    rw [hv]
    simp only [map_add, map_smul, smul_eq_mul]
    exact hτ
  obtain ⟨γ, hγc, hγ0, hγv, hγev⟩ := hcurve v hv0 hDbv
  have eb := hsecond b hb γ hγc hγ0 (hγev.mono fun t ht => ht)
  have ew := hsecond w hw γ hγc hγ0 (hγev.mono fun t ht => ⟨ht.1, hvan _ ht.1 ht.2⟩)
  rw [hγv.deriv] at eb ew
  linear_combination ew - (-α / β) * eb - hDw (deriv (deriv γ) 0)

theorem pcgb_boundary_curvature_algebra (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a c) W)
    (hpd : ∀ y ∈ W, (h y).PosDef) (b w : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W)
    (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W) (hdb : fderiv ℝ b x ≠ 0)
    (hdw : fderiv ℝ w x ≠ 0) (lam : ℝ)
    (H1 : ∀ a : Fin 2, pd2 a w x = lam * pd2 a b x)
    (H2 : ∀ τ : Fin 2 → ℝ, τ 0 * pd2 0 b x + τ 1 * pd2 1 b x = 0 →
        ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j w) x =
          lam * ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j b) x)
    (H3 : lap2 h w x = 0) :
    ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x :=
by
  have hxU : W ∈ 𝓝 x := hW.mem_nhds hx
  have hsymm : ∀ z ∈ W, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have := (hpd z hz).isHermitian.apply j i
    simpa using this
  have hdh : ∀ a c : Fin 2, DifferentiableAt ℝ (fun z => h z a c) x := fun a c =>
    ((hh a c).differentiableOn (by simp)).differentiableAt hxU
  
  have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have padd : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_add hf hg]
    rfl
  have psub : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z - g z) x = pd2 k f x - pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_sub hf hg]
    rfl
  have pneg : ∀ (f : E2 → ℝ) (k : Fin 2), pd2 k (fun z => -f z) x = -pd2 k f x := by
    intro f k
    unfold pd2
    rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
    rfl
  have pinv : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => (f z)⁻¹) x = -pd2 k f x / (f x) ^ 2 := by
    intro f k hf hf0
    unfold pd2
    have H := (hasDerivAt_inv hf0).comp_hasFDerivAt x hf.hasFDerivAt
    rw [show (fun z => (f z)⁻¹) = (fun y : ℝ => y⁻¹) ∘ f from rfl, H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  have psqrt : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => Real.sqrt (f z)) x = pd2 k f x / (2 * Real.sqrt (f x)) := by
    intro f k hf hf0
    unfold pd2
    rw [fderiv_sqrt hf hf0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pdiv : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      g x ≠ 0 →
      pd2 k (fun z => f z / g z) x = pd2 k f x * (g x)⁻¹ + f x * (-pd2 k g x / (g x) ^ 2) := by
    intro f g k hf hg hg0
    have e : (fun z => f z / g z) = fun z => f z * (g z)⁻¹ := funext fun z => div_eq_mul_inv _ _
    rw [e, pmul _ _ k hf (hg.fun_inv hg0), pinv _ k hg hg0]
  have hfz : ∀ f : E2 → ℝ, pd2 0 f x = 0 → pd2 1 f x = 0 → fderiv ℝ f x = 0 := by
    intro f h0 h1
    refine ContinuousLinearMap.ext fun v => ?_
    have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i; fin_cases i <;> simp [e2]
    rw [hv, map_add, map_smul, map_smul]
    unfold pd2 at h0 h1
    rw [h0, h1]
    simp
  
  have hinvE : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    rfl
  have hadj00 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 0 = A 1 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj01 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 1 = -A 0 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj10 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 0 = -A 1 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj11 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 1 = A 0 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hdetE : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.det = A 0 0 * A 1 1 - A 0 1 * A 1 0 :=
    fun A => Matrix.det_fin_two A
  have hDpos : 0 < (h x).det := (hpd x hx).det_pos
  have hD0 : (h x).det ≠ 0 := hDpos.ne'
  have hx10 : h x 1 0 = h x 0 1 := hsymm x hx 1 0
  have hd10 : ∀ l : Fin 2, pd2 l (fun z => h z 1 0) x = pd2 l (fun z => h z 0 1) x := by
    intro l
    have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
      Filter.eventually_of_mem hxU (fun z hz => hsymm z hz 1 0)
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq hev]
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z; exact hdetE (h z)
  have hdD : DifferentiableAt ℝ (fun z => (h z).det) x := by
    rw [hdetfun]; exact ((hdh 0 0).mul (hdh 1 1)).sub ((hdh 0 1).mul (hdh 1 0))
  have hdS : DifferentiableAt ℝ (fun z => Real.sqrt (h z).det) x := hdD.sqrt hD0
  have hdpd : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ j : Fin 2,
      DifferentiableAt ℝ (pd2 j f) x := by
    intro f hf j
    have h2 : ContDiffOn ℝ 2 f W := contDiffOn_infty.mp hf 2
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ f y) W := h2.fderiv_of_isOpen hW (by norm_num)
    have h3 : ContDiffOn ℝ 1 (pd2 j f) W := h1.clm_apply contDiffOn_const
    exact (h3.differentiableOn (by norm_num)).differentiableAt hxU
  have hdbj := hdpd b hb
  have hdI : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x := by
    intro i j
    have e : (fun z => (h z)⁻¹ i j) = fun z => ((h z).det)⁻¹ * (h z).adjugate i j :=
      funext fun z => hinvE (h z) i j
    rw [e]
    refine (hdD.inv hD0).mul ?_
    fin_cases i <;> fin_cases j
    · simp only [Fin.zero_eta, hadj00]; exact hdh 1 1
    · simp only [Fin.zero_eta, Fin.mk_one, hadj01]; exact (hdh 0 1).neg
    · simp only [Fin.zero_eta, Fin.mk_one, hadj10]; exact (hdh 1 0).neg
    · simp only [Fin.mk_one, hadj11]; exact hdh 0 0
  
  have pD : ∀ k : Fin 2, pd2 k (fun z => (h z).det) x =
      pd2 k (fun z => h z 0 0) x * h x 1 1 + h x 0 0 * pd2 k (fun z => h z 1 1) x -
        (pd2 k (fun z => h z 0 1) x * h x 1 0 + h x 0 1 * pd2 k (fun z => h z 1 0) x) := by
    intro k
    rw [hdetfun, psub _ _ k ((hdh 0 0).fun_mul (hdh 1 1)) ((hdh 0 1).fun_mul (hdh 1 0)),
      pmul _ _ k (hdh 0 0) (hdh 1 1), pmul _ _ k (hdh 0 1) (hdh 1 0)]
  have pS : ∀ k : Fin 2, pd2 k (fun z => Real.sqrt (h z).det) x =
      Real.sqrt (h x).det * pd2 k (fun z => (h z).det) x / (2 * (h x).det) := by
    intro k
    rw [psqrt _ k hdD hD0]
    have hs0 : 0 < Real.sqrt (h x).det := Real.sqrt_pos.mpr hDpos
    have hss : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det :=
      Real.mul_self_sqrt hDpos.le
    generalize Real.sqrt (h x).det = s at hs0 hss ⊢
    rw [← hss]
    field_simp
  have pI00 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 1 1 +
        (h x).det⁻¹ * pd2 k (fun z => h z 1 1) x := by
    intro k
    simp only [hinvE, hadj00]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 1), pinv _ k hdD hD0]
  have pI01 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 0 1) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 0 1) x) := by
    intro k
    simp only [hinvE, hadj01]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 1).fun_neg, pinv _ k hdD hD0, pneg]
  have pI10 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 1 0) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 1 0) x) := by
    intro k
    simp only [hinvE, hadj10]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 0).fun_neg, pinv _ k hdD hD0, pneg]
  have pI11 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 0 0 +
        (h x).det⁻¹ * pd2 k (fun z => h z 0 0) x := by
    intro k
    simp only [hinvE, hadj11]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 0), pinv _ k hdD hD0]
  
  have hdiv : pd2 0 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j b z) x +
      pd2 1 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j b z) x =
      Real.sqrt (h x).det * lap2 h b x := by
    simp only [Fin.sum_univ_two]
    have hdA : ∀ i : Fin 2, DifferentiableAt ℝ
        (fun z => (h z)⁻¹ i 0 * pd2 0 b z + (h z)⁻¹ i 1 * pd2 1 b z) x :=
      fun i => ((hdI i 0).fun_mul (hdbj 0)).fun_add ((hdI i 1).fun_mul (hdbj 1))
    rw [pmul _ _ 0 hdS (hdA 0), pmul _ _ 1 hdS (hdA 1),
      padd _ _ 0 ((hdI 0 0).fun_mul (hdbj 0)) ((hdI 0 1).fun_mul (hdbj 1)),
      padd _ _ 1 ((hdI 1 0).fun_mul (hdbj 0)) ((hdI 1 1).fun_mul (hdbj 1)),
      pmul _ _ 0 (hdI 0 0) (hdbj 0), pmul _ _ 0 (hdI 0 1) (hdbj 1),
      pmul _ _ 1 (hdI 1 0) (hdbj 0), pmul _ _ 1 (hdI 1 1) (hdbj 1),
      pS 0, pS 1, pI00 0, pI01 0, pI10 1, pI11 1, pD 0, pD 1]
    simp only [lap2, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10, hadj11]
    have hD1 : h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 ≠ 0 := by
      have e := hdetE (h x)
      rw [hx10] at e
      rw [← e]
      exact hD0
    generalize Real.sqrt (h x).det = s
    simp only [hx10, hd10]
    field_simp
    simp only [hdetE (h x), hx10]
    ring
  simp only [Fin.sum_univ_two] at hdiv
  have hX1 := eq_sub_of_add_eq' hdiv
  
  have hA10 : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := by
    have := (hpd x hx).inv.isHermitian.apply 0 1
    simpa using this
  have hβ : (fun a : Fin 2 => pd2 a b x) ≠ 0 := by
    intro h0
    exact hdb (hfz b (congrFun h0 0) (congrFun h0 1))
  have hNpos : 0 < sgbGradSq2 h b x := by
    have hp := (hpd x hx).inv.dotProduct_mulVec_pos hβ
    have e : sgbGradSq2 h b x = dotProduct (star (fun a : Fin 2 => pd2 a b x))
        (Matrix.mulVec (h x)⁻¹ (fun a : Fin 2 => pd2 a b x)) := by
      simp only [sgbGradSq2, dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply,
        star_trivial]
      ring
    rw [e]; exact hp
  have hN0 : sgbGradSq2 h b x ≠ 0 := hNpos.ne'
  have hlam : lam ≠ 0 := by
    intro hl
    apply hdw
    refine hfz w ?_ ?_
    · rw [H1 0, hl, zero_mul]
    · rw [H1 1, hl, zero_mul]
  
  have pGf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      DifferentiableAt ℝ (sgbGradSq2 h f) x ∧ ∀ k : Fin 2, pd2 k (sgbGradSq2 h f) x =
        ∑ a : Fin 2, ∑ d : Fin 2, (pd2 k (fun y => (h y)⁻¹ a d) x * pd2 a f x * pd2 d f x +
          (h x)⁻¹ a d * (pd2 k (pd2 a f) x * pd2 d f x + pd2 a f x * pd2 k (pd2 d f) x)) := by
    intro f hf
    have hf1 := hdpd f hf
    have hT : ∀ a d : Fin 2,
        DifferentiableAt ℝ (fun y => (h y)⁻¹ a d * pd2 a f y * pd2 d f y) x :=
      fun a d => ((hdI a d).fun_mul (hf1 a)).fun_mul (hf1 d)
    have pT : ∀ a d k : Fin 2, pd2 k (fun y => (h y)⁻¹ a d * pd2 a f y * pd2 d f y) x =
        pd2 k (fun y => (h y)⁻¹ a d) x * pd2 a f x * pd2 d f x +
          (h x)⁻¹ a d * (pd2 k (pd2 a f) x * pd2 d f x + pd2 a f x * pd2 k (pd2 d f) x) := by
      intro a d k
      rw [pmul _ _ k ((hdI a d).fun_mul (hf1 a)) (hf1 d), pmul _ _ k (hdI a d) (hf1 a)]
      ring
    have e : sgbGradSq2 h f = fun y => ((h y)⁻¹ 0 0 * pd2 0 f y * pd2 0 f y +
        (h y)⁻¹ 0 1 * pd2 0 f y * pd2 1 f y) + ((h y)⁻¹ 1 0 * pd2 1 f y * pd2 0 f y +
        (h y)⁻¹ 1 1 * pd2 1 f y * pd2 1 f y) := by
      funext y; simp only [sgbGradSq2, Fin.sum_univ_two]
    rw [e]
    refine ⟨((hT 0 0).fun_add (hT 0 1)).fun_add ((hT 1 0).fun_add (hT 1 1)), fun k => ?_⟩
    rw [padd _ _ k ((hT 0 0).fun_add (hT 0 1)) ((hT 1 0).fun_add (hT 1 1)),
      padd _ _ k (hT 0 0) (hT 0 1), padd _ _ k (hT 1 0) (hT 1 1), pT, pT, pT, pT]
    simp only [Fin.sum_univ_two]
  obtain ⟨hGwd, hGw'⟩ := pGf w hw
  obtain ⟨hGbd, hGb'⟩ := pGf b hb
  have hGwx : sgbGradSq2 h w x = lam ^ 2 * sgbGradSq2 h b x := by
    simp only [sgbGradSq2, H1, Fin.sum_univ_two]
    ring
  have hGw0 : sgbGradSq2 h w x ≠ 0 := by
    rw [hGwx]; exact mul_ne_zero (pow_ne_zero 2 hlam) hN0
  
  have pLog : ∀ k : Fin 2,
      pd2 k (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
        (1 / 2 : ℝ) * ((sgbGradSq2 h w x)⁻¹ * pd2 k (sgbGradSq2 h w) x) := by
    intro k
    unfold pd2
    rw [fderiv_const_mul (hGwd.log hGw0), fderiv.log hGwd hGw0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have hdV : DifferentiableAt ℝ (fun y => Real.sqrt (sgbGradSq2 h b y)) x := hGbd.sqrt hN0
  have hV0 : Real.sqrt (sgbGradSq2 h b x) ≠ 0 := (Real.sqrt_pos.mpr hNpos).ne'
  have hdU : ∀ i : Fin 2, DifferentiableAt ℝ (fun y => Real.sqrt (h y).det *
      ((h y)⁻¹ i 0 * pd2 0 b y + (h y)⁻¹ i 1 * pd2 1 b y)) x :=
    fun i => hdS.fun_mul (((hdI i 0).fun_mul (hdbj 0)).fun_add ((hdI i 1).fun_mul (hdbj 1)))
  have hRHS : Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x =
      -lap2 h b x + (((h x)⁻¹ 0 0 * pd2 0 b x + (h x)⁻¹ 0 1 * pd2 1 b x) *
          pd2 0 (sgbGradSq2 h b) x +
        ((h x)⁻¹ 1 0 * pd2 0 b x + (h x)⁻¹ 1 1 * pd2 1 b x) * pd2 1 (sgbGradSq2 h b) x) /
        (2 * sgbGradSq2 h b x) := by
    have hLC : sgbLevelCurv2 h b x = -((Real.sqrt (h x).det)⁻¹ *
        (pd2 0 (fun y => Real.sqrt (h y).det * ((h y)⁻¹ 0 0 * pd2 0 b y +
            (h y)⁻¹ 0 1 * pd2 1 b y) / Real.sqrt (sgbGradSq2 h b y)) x +
          pd2 1 (fun y => Real.sqrt (h y).det * ((h y)⁻¹ 1 0 * pd2 0 b y +
            (h y)⁻¹ 1 1 * pd2 1 b y) / Real.sqrt (sgbGradSq2 h b y)) x)) := by
      simp only [sgbLevelCurv2, Fin.sum_univ_two]
    rw [hLC, pdiv _ _ 0 (hdU 0) hdV hV0, pdiv _ _ 1 (hdU 1) hdV hV0,
      psqrt _ 0 hGbd hN0, psqrt _ 1 hGbd hN0, hX1]
    have hrr : Real.sqrt (sgbGradSq2 h b x) * Real.sqrt (sgbGradSq2 h b x) = sgbGradSq2 h b x :=
      Real.mul_self_sqrt hNpos.le
    have hs0 : Real.sqrt (h x).det ≠ 0 := (Real.sqrt_pos.mpr hDpos).ne'
    generalize Real.sqrt (sgbGradSq2 h b x) = r at hrr hV0 ⊢
    generalize Real.sqrt (h x).det = s at hs0 ⊢
    rw [← hrr]
    field_simp
    ring
  
  have H3' := H3
  simp only [lap2, H1, Fin.sum_univ_two, hA10] at H3'
  have H2' := H2 ![-(pd2 1 b x), pd2 0 b x]
    (by simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]; ring)
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons] at H2'
  have hNe : sgbGradSq2 h b x = (h x)⁻¹ 0 0 * pd2 0 b x * pd2 0 b x +
      (h x)⁻¹ 0 1 * pd2 0 b x * pd2 1 b x + ((h x)⁻¹ 0 1 * pd2 1 b x * pd2 0 b x +
      (h x)⁻¹ 1 1 * pd2 1 b x * pd2 1 b x) := by
    simp only [sgbGradSq2, Fin.sum_univ_two, hA10]
  
  rw [hRHS]
  simp only [pLog, hGw', hGb', hGwx, H1]
  simp only [lap2, Fin.sum_univ_two, hA10]
  linear_combination (norm := skip) (1 / lam) * H3' +
    (-((h x)⁻¹ 0 0 * (h x)⁻¹ 1 1 - (h x)⁻¹ 0 1 * (h x)⁻¹ 0 1) /
      (lam * sgbGradSq2 h b x)) * H2'
  field_simp
  rw [hNe]
  ring

theorem pcgb_thin_band_volume (W : Set E2) (hW : IsOpen W) (Kc : Set E2) (hKc : IsCompact Kc)
    (hKW : Kc ⊆ W) (b : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W)
    (hreg : ∀ x ∈ W, b x = 0 → fderiv ℝ b x ≠ 0) :
    ∃ Cb s₄ : ℝ, 0 < s₄ ∧ ∀ s : ℝ, 0 < s → s < s₄ →
      MeasureTheory.volume (Kc ∩ {x | 0 < b x ∧ b x < s}) ≤ ENNReal.ofReal (Cb * s) :=
by
  classical
  
  have growth : ∀ y₀ ∈ W, fderiv ℝ b y₀ ≠ 0 →
      ∃ R cc : ℝ, ∃ v : E2, 0 < R ∧ 0 < cc ∧ ‖v‖ = 1 ∧ Metric.ball y₀ (2 * R) ⊆ W ∧
        ∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v) := by
    intro y₀ hy₀ hd
    obtain ⟨w, hw⟩ : ∃ w, fderiv ℝ b y₀ w ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hd (ContinuousLinearMap.ext hcon)
    have hw0 : w ≠ 0 := by
      rintro rfl
      simp at hw
    have hwn : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hwi : 0 < ‖w‖⁻¹ := inv_pos.mpr hwn
    obtain ⟨v, hv1, hav⟩ : ∃ v : E2, ‖v‖ = 1 ∧ 0 < fderiv ℝ b y₀ v := by
      rcases lt_or_gt_of_ne hw with h | h
      · refine ⟨-(‖w‖⁻¹ • w), ?_, ?_⟩
        · rw [norm_neg, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_neg, map_smul, smul_eq_mul]
          nlinarith
      · refine ⟨‖w‖⁻¹ • w, ?_, ?_⟩
        · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_smul, smul_eq_mul]
          exact mul_pos hwi h
    have hfc : ContinuousOn (fderiv ℝ b) W :=
      hb.continuousOn_fderiv_of_isOpen hW (by simp)
    have hfca : ContinuousAt (fderiv ℝ b) y₀ := hfc.continuousAt (hW.mem_nhds hy₀)
    obtain ⟨δ₁, hδ₁, hδ₁'⟩ := Metric.continuousAt_iff.mp hfca (fderiv ℝ b y₀ v / 2)
      (by linarith)
    obtain ⟨δ₂, hδ₂, hδ₂'⟩ := Metric.isOpen_iff.mp hW y₀ hy₀
    have hδ : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
    have hballT : Metric.ball y₀ (min δ₁ δ₂) ⊆ W :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hδ₂'
    have hder : ∀ z ∈ Metric.ball y₀ (min δ₁ δ₂), fderiv ℝ b y₀ v / 2 < fderiv ℝ b z v := by
      intro z hz
      have hz1 : dist z y₀ < δ₁ := lt_of_lt_of_le hz (min_le_left _ _)
      have h1 := hδ₁' hz1
      rw [dist_eq_norm] at h1
      have h2 : ‖(fderiv ℝ b z - fderiv ℝ b y₀) v‖ ≤ ‖fderiv ℝ b z - fderiv ℝ b y₀‖ * ‖v‖ :=
        ContinuousLinearMap.le_opNorm _ _
      rw [hv1, mul_one, ContinuousLinearMap.sub_apply, Real.norm_eq_abs] at h2
      have h3 := neg_abs_le (fderiv ℝ b z v - fderiv ℝ b y₀ v)
      linarith
    refine ⟨min δ₁ δ₂ / 2, fderiv ℝ b y₀ v / 2, v, by linarith, by linarith, hv1, ?_, ?_⟩
    · rw [show 2 * (min δ₁ δ₂ / 2) = min δ₁ δ₂ by ring]
      exact hballT
    · intro y hy t ht0 htR
      have hseg : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t → y + τ • v ∈ Metric.ball y₀ (min δ₁ δ₂) := by
        intro τ hτ0 hτt
        rw [Metric.mem_ball] at hy ⊢
        calc dist (y + τ • v) y₀ ≤ dist (y + τ • v) y + dist y y₀ := dist_triangle _ _ _
          _ = τ + dist y y₀ := by
              rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hv1, mul_one, Real.norm_eq_abs,
                abs_of_nonneg hτ0]
          _ < min δ₁ δ₂ := by linarith
      have hderiv : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t →
          HasDerivAt (fun τ => b (y + τ • v)) (fderiv ℝ b (y + τ • v) v) τ := by
        intro τ hτ0 hτt
        have hmem := hballT (hseg τ hτ0 hτt)
        have hbd : DifferentiableAt ℝ b (y + τ • v) :=
          (hb.contDiffAt (hW.mem_nhds hmem)).differentiableAt (by simp)
        have hp : HasDerivAt (fun τ : ℝ => y + τ • v) v τ := by
          simpa using ((hasDerivAt_id τ).smul_const v).const_add y
        exact hbd.hasFDerivAt.comp_hasDerivAt τ hp
      rcases eq_or_lt_of_le ht0 with h | h
      · subst h
        simp
      · have hcont : ContinuousOn (fun τ => b (y + τ • v)) (Set.Icc 0 t) := by
          intro τ hτ
          exact (hderiv τ hτ.1 hτ.2).continuousAt.continuousWithinAt
        obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (fun τ => b (y + τ • v))
          (fun τ => fderiv ℝ b (y + τ • v) v) h hcont
          (fun τ hτ => hderiv τ hτ.1.le hτ.2.le)
        have hgt := hder _ (hseg ξ hξ.1.le hξ.2.le)
        rw [hξeq] at hgt
        simp only [zero_smul, add_zero, sub_zero] at hgt
        rw [lt_div_iff₀ h] at hgt
        linarith
  
  have pack : ∀ (y₀ v : E2) (R cc : ℝ), 0 < R → 0 < cc → ‖v‖ = 1 →
      ContinuousOn b (Metric.ball y₀ R) →
      (∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v)) →
      ∀ s : ℝ, 0 < s → s < R * cc →
        MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≤
          ENNReal.ofReal (2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal /
            (R * cc) * s) := by
    intro y₀ v R cc hR hcc hv hbc hgrow s hs hsR
    have hUo : IsOpen (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) :=
      hbc.isOpen_inter_preimage Metric.isOpen_ball (isOpen_Ioo (a := (0 : ℝ)) (b := s))
    have hhpos : 0 < s / cc := div_pos hs hcc
    have hx1 : 1 < R * cc / s := by rw [lt_div_iff₀ hs]; linarith
    have hN1 : 0 < ⌊R * cc / s⌋₊ := Nat.floor_pos.mpr hx1.le
    have hNx : (⌊R * cc / s⌋₊ : ℝ) ≤ R * cc / s := Nat.floor_le (by linarith)
    have hxN : R * cc / s < ⌊R * cc / s⌋₊ + 1 := Nat.lt_floor_add_one _
    have hNh : (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R := by
      calc (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R * cc / s * (s / cc) :=
            mul_le_mul_of_nonneg_right hNx hhpos.le
        _ = R := by field_simp
    have hUkm : ∀ k : ℕ, MeasurableSet
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := fun k =>
      (measurable_add_const _) hUo.measurableSet
    have hUkv : ∀ k : ℕ, MeasureTheory.volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) =
        MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) := fun k =>
      MeasureTheory.measure_preimage_add_right MeasureTheory.volume _ _
    have hUksub : ∀ k ∈ Finset.range ⌊R * cc / s⌋₊,
        (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ⊆ Metric.ball y₀ (2 * R) := by
      intro k hk z hz
      have hkN : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast (Finset.mem_range.mp hk).le
      have hd : dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ < R := hz.1
      have hkh : 0 ≤ (k : ℝ) * (s / cc) := mul_nonneg (Nat.cast_nonneg k) hhpos.le
      have hkh2 : (k : ℝ) * (s / cc) ≤ ⌊R * cc / s⌋₊ * (s / cc) :=
        mul_le_mul_of_nonneg_right hkN hhpos.le
      have hdz : dist z (z + (-((k : ℝ) * (s / cc))) • v) = (k : ℝ) * (s / cc) := by
        rw [dist_eq_norm, sub_add_cancel_left, norm_neg, norm_smul, hv, mul_one,
          Real.norm_eq_abs, abs_neg, abs_of_nonneg hkh]
      rw [Metric.mem_ball]
      calc dist z y₀ ≤ dist z (z + (-((k : ℝ) * (s / cc))) • v) +
            dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ := dist_triangle _ _ _
        _ < (k : ℝ) * (s / cc) + R := by rw [hdz]; linarith
        _ ≤ 2 * R := by linarith
    have key : ∀ j k : ℕ, j < k → k < ⌊R * cc / s⌋₊ → Disjoint
        ((fun z => z + (-((j : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}))
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j k hjk hkN
      rw [Set.disjoint_left]
      intro z hzj hzk
      have hj : z + (-((j : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzj
      have hk : z + (-((k : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzk
      have hjk' : (j : ℝ) + 1 ≤ k := by exact_mod_cast hjk
      have hkN' : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hkN.le
      have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg j
      have ht0 : s / cc ≤ ((k : ℝ) - j) * (s / cc) := by nlinarith
      have htR : ((k : ℝ) - j) * (s / cc) ≤ R := by
        have : ((k : ℝ) - j) * (s / cc) ≤ (⌊R * cc / s⌋₊ : ℝ) * (s / cc) := by nlinarith
        linarith
      have heq : z + (-((k : ℝ) * (s / cc))) • v + (((k : ℝ) - j) * (s / cc)) • v =
          z + (-((j : ℝ) * (s / cc))) • v := by
        rw [add_assoc, ← add_smul]
        congr 2
        ring
      have hg := hgrow _ hk.1 (((k : ℝ) - j) * (s / cc)) (by linarith) htR
      rw [heq] at hg
      have h1 : 0 < b (z + (-((k : ℝ) * (s / cc))) • v) := hk.2.1
      have h2 : b (z + (-((j : ℝ) * (s / cc))) • v) < s := hj.2.2
      have h3 : cc * (s / cc) ≤ cc * (((k : ℝ) - j) * (s / cc)) :=
        mul_le_mul_of_nonneg_left ht0 hcc.le
      have hcs : cc * (s / cc) = s := by field_simp
      linarith
    have hdisj : Set.PairwiseDisjoint (↑(Finset.range ⌊R * cc / s⌋₊) : Set ℕ)
        (fun k : ℕ => (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j hj k hk hne
      rcases lt_or_gt_of_ne hne with h' | h'
      · exact key j k h' (Finset.mem_range.mp hk)
      · exact (key k j h' (Finset.mem_range.mp hj)).symm
    have hsum : ∑ k ∈ Finset.range ⌊R * cc / s⌋₊, MeasureTheory.volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) ≤
        MeasureTheory.volume (Metric.ball y₀ (2 * R)) := by
      rw [← MeasureTheory.measure_biUnion_finset hdisj (fun k _ => hUkm k)]
      exact MeasureTheory.measure_mono (Set.iUnion₂_subset hUksub)
    simp only [hUkv, Finset.sum_const, Finset.card_range, nsmul_eq_mul] at hsum
    have hWt : MeasureTheory.volume (Metric.ball y₀ (2 * R)) ≠ ⊤ := measure_ball_lt_top.ne
    have hUt : MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≠ ⊤ := by
      intro htop
      rw [htop, ENNReal.mul_top (Nat.cast_ne_zero.mpr (by omega))] at hsum
      exact hWt (top_le_iff.mp hsum)
    have hreal : (⌊R * cc / s⌋₊ : ℝ) *
        (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal ≤
        (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal := by
      have := ENNReal.toReal_mono hWt hsum
      rwa [ENNReal.toReal_mul, ENNReal.toReal_natCast] at this
    rw [← ENNReal.ofReal_toReal hUt]
    apply ENNReal.ofReal_le_ofReal
    have hU0 : 0 ≤ (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal :=
      ENNReal.toReal_nonneg
    have hN1' : (1 : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hN1
    have hRc : R * cc ≤ 2 * ⌊R * cc / s⌋₊ * s := by
      have h2N : R * cc / s ≤ 2 * ⌊R * cc / s⌋₊ := by linarith
      rw [div_le_iff₀ hs] at h2N
      linarith
    rw [div_mul_eq_mul_div, le_div_iff₀ (mul_pos hR hcc)]
    calc (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal * (R * cc)
        ≤ (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal *
            (2 * ⌊R * cc / s⌋₊ * s) := mul_le_mul_of_nonneg_left hRc hU0
      _ = 2 * s * ((⌊R * cc / s⌋₊ : ℝ) *
            (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal) := by
          ring
      _ ≤ 2 * s * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal :=
          mul_le_mul_of_nonneg_left hreal (by linarith)
      _ = 2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal * s := by ring
  
  have hloc : ∀ y₀ ∈ Kc, ∃ r C s₁ : ℝ, 0 < r ∧ 0 ≤ C ∧ 0 < s₁ ∧ ∀ s : ℝ, 0 < s → s < s₁ →
      MeasureTheory.volume (Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s}) ≤
        ENNReal.ofReal (C * s) := by
    intro y₀ hy₀
    have hy₀T := hKW hy₀
    by_cases hb0 : b y₀ = 0
    · obtain ⟨R, cc, v, hR, hcc, hv, hball, hgrow⟩ := growth y₀ hy₀T (hreg y₀ hy₀T hb0)
      have hbc : ContinuousOn b (Metric.ball y₀ R) :=
        hb.continuousOn.mono ((Metric.ball_subset_ball (by linarith)).trans hball)
      refine ⟨R, 2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal / (R * cc), R * cc, hR,
        div_nonneg (mul_nonneg zero_le_two ENNReal.toReal_nonneg) (mul_pos hR hcc).le,
        mul_pos hR hcc, ?_⟩
      exact pack y₀ v R cc hR hcc hv hbc hgrow
    · have hm : 0 < |b y₀| := abs_pos.mpr hb0
      have hca : ContinuousAt b y₀ := hb.continuousOn.continuousAt (hW.mem_nhds hy₀T)
      obtain ⟨r, hr, hr'⟩ := Metric.continuousAt_iff.mp hca (|b y₀| / 2) (by linarith)
      refine ⟨r, 0, |b y₀| / 2, hr, le_rfl, by linarith, fun s hs hss => ?_⟩
      have hempty : Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s} = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        rintro z ⟨hz, hz1, hz2⟩
        have h1 : dist (b z) (b y₀) < |b y₀| / 2 := hr' hz
        rw [Real.dist_eq] at h1
        have h2 := abs_sub_abs_le_abs_sub (b y₀) (b z)
        have h3 : |b y₀ - b z| = |b z - b y₀| := abs_sub_comm _ _
        rw [abs_of_pos hz1] at h2
        linarith
      rw [hempty, MeasureTheory.measure_empty]
      exact zero_le _
  
  choose! r C s₁ hr hC hs₁ hbd using hloc
  obtain ⟨t, htK, hcover⟩ := hKc.elim_nhds_subcover (fun y => Metric.ball y (r y))
    (fun y hy => Metric.ball_mem_nhds y (hr y hy))
  refine ⟨∑ y ∈ t, C y, (insert 1 (t.image s₁)).min' (Finset.insert_nonempty _ _), ?_,
    fun s hs hss => ?_⟩
  · have hm := Finset.min'_mem (insert 1 (t.image s₁)) (Finset.insert_nonempty _ _)
    rw [Finset.mem_insert, Finset.mem_image] at hm
    rcases hm with h | ⟨y, hy, hy'⟩
    · rw [h]; exact one_pos
    · rw [← hy']; exact hs₁ y (htK y hy)
  · have hle : ∀ y ∈ t, s < s₁ y := fun y hy => lt_of_lt_of_le hss
      (Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hy)))
    calc MeasureTheory.volume (Kc ∩ {x | 0 < b x ∧ b x < s})
        ≤ MeasureTheory.volume (⋃ y ∈ t, (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s})) := by
          apply MeasureTheory.measure_mono
          rintro z ⟨hzK, hz⟩
          have hzc := hcover hzK
          rw [Set.mem_iUnion₂] at hzc ⊢
          obtain ⟨y, hy, hzy⟩ := hzc
          exact ⟨y, hy, hzy, hz⟩
      _ ≤ ∑ y ∈ t, MeasureTheory.volume (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s}) :=
          MeasureTheory.measure_biUnion_finset_le _ _
      _ ≤ ∑ y ∈ t, ENNReal.ofReal (C y * s) :=
          Finset.sum_le_sum (fun y hy => hbd y (htK y hy) s hs (hle y hy))
      _ = ENNReal.ofReal (∑ y ∈ t, C y * s) :=
          (ENNReal.ofReal_sum_of_nonneg (fun y hy => mul_nonneg (hC y (htK y hy)) hs.le)).symm
      _ = ENNReal.ofReal ((∑ y ∈ t, C y) * s) := by rw [Finset.sum_mul]

theorem pcgb_patch_collar_bound (W : Set E2) (hW : IsOpen W) (Kc : Set E2) (hKc : IsCompact Kc)
    (hKW : Kc ⊆ W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a c) W) (hpd : ∀ y ∈ W, (h y).PosDef)
    (b w : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W) (V : Set E2) (hV : IsOpen V) (hVW : V ⊆ W)
    (σ₀ : ℝ) (hσ₀ : 0 < σ₀) (hbV : ∀ x ∈ W, 0 ≤ b x → b x ≤ σ₀ → x ∈ V)
    (hw : ContDiffOn ℝ ∞ w V)
    (hreg : ∀ x ∈ W, b x = 0 → fderiv ℝ b x ≠ 0)
    (hdw : ∀ x ∈ W, b x = 0 → fderiv ℝ w x ≠ 0)
    (hzero : ∀ x ∈ W, b x = 0 → ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ δ : ℝ, 0 < δ → ∃ σ : ℝ, 0 < σ ∧ ∀ ε : ℝ, 0 < ε → ∀ x ∈ Kc,
      0 < b x → b x < σ →
      |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
        ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
          pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x| ≤ δ + A * ε :=
by
  classical
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  have sep : ∀ (K : Set E2), IsCompact K → ∀ (bb F : E2 → ℝ), ContinuousOn bb K →
      ContinuousOn F K → ∀ (δ' : ℝ), (∀ x ∈ K, bb x = 0 → F x < δ') →
      ∃ σ : ℝ, 0 < σ ∧ ∀ x ∈ K, 0 ≤ bb x → bb x < σ → F x < δ' := by
    intro K hK bb F hbb hF δ' hz
    have hK1 : IsClosed (K ∩ bb ⁻¹' Set.Ici 0) :=
      hbb.preimage_isClosed_of_isClosed hK.isClosed isClosed_Ici
    have hK2 : IsClosed ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
      (hF.mono Set.inter_subset_left).preimage_isClosed_of_isClosed hK1 isClosed_Ici
    have hK'c : IsCompact ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
      hK.of_isClosed_subset hK2 (fun x hx => hx.1.1)
    rcases Set.eq_empty_or_nonempty ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') with hE | hE
    · refine ⟨1, one_pos, fun x hx h0 _ => ?_⟩
      by_contra hc
      have hmem : x ∈ ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
        ⟨⟨hx, h0⟩, not_lt.mp hc⟩
      rw [hE] at hmem
      exact hmem
    · obtain ⟨x₀, hx₀, hmin⟩ := hK'c.exists_isMinOn hE (hbb.mono (fun x hx => hx.1.1))
      have hx₀b : (0 : ℝ) ≤ bb x₀ := hx₀.1.2
      have hx₀F : δ' ≤ F x₀ := hx₀.2
      have hpos : 0 < bb x₀ := by
        rcases lt_or_eq_of_le hx₀b with h | h
        · exact h
        · exact absurd (hz x₀ hx₀.1.1 h.symm) (not_lt.mpr hx₀F)
      refine ⟨bb x₀, hpos, fun x hx h0 hlt => ?_⟩
      by_contra hc
      have hmem : x ∈ ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
        ⟨⟨hx, h0⟩, not_lt.mp hc⟩
      have := isMinOn_iff.mp hmin x hmem
      linarith
  
  have gpos : ∀ (f : E2 → ℝ) (x : E2), (h x).PosDef → fderiv ℝ f x ≠ 0 →
      0 < sgbGradSq2 h f x := by
    intro f x hx hd
    have hξ : (![pd2 0 f x, pd2 1 f x] : Fin 2 → ℝ) ≠ 0 := by
      intro h0
      apply hd
      have h0' : fderiv ℝ f x (e2 0) = 0 := by simpa [pd2] using congrFun h0 0
      have h1' : fderiv ℝ f x (e2 1) = 0 := by simpa [pd2] using congrFun h0 1
      refine ContinuousLinearMap.ext (fun v => ?_)
      have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
        ext i
        fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
      rw [hv, map_add, map_smul, map_smul, h0', h1']
      simp
    refine lt_of_lt_of_eq (hx.inv.dotProduct_mulVec_pos hξ) ?_
    simp only [sgbGradSq2, dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial,
      Pi.star_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
    ring
  
  have hdetW : ∀ y ∈ W, (h y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) W := by
    have e : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y
      exact Matrix.det_fin_two _
    rw [e]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hinvW : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a c) W := by
    have hdi : ContDiffOn ℝ ∞ (fun y => ((h y).det)⁻¹) W := hdetS.inv hdetW
    have e : ∀ y, ∀ a c : Fin 2, (h y)⁻¹ a c = ((h y).det)⁻¹ * (h y).adjugate a c := by
      intro y a c
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate a c) W := by
      intro a c
      have e2' : (fun y => (h y).adjugate a c) = fun y =>
          (!![h y 1 1, -h y 0 1; -h y 1 0, h y 0 0] : Matrix (Fin 2) (Fin 2) ℝ) a c := by
        funext y
        rw [Matrix.adjugate_fin_two]
      rw [e2']
      fin_cases a <;> fin_cases c
      · simpa using hh 1 1
      · simpa using (hh 0 1).neg
      · simpa using (hh 1 0).neg
      · simpa using hh 0 0
    intro a c
    exact (hdi.mul (hadj a c)).congr (fun y _ => e y a c)
  
  have pdS : ∀ (U : Set E2), IsOpen U → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a f) U := by
    intro U hU f hf a
    exact (hf.fderiv_of_isOpen hU le_rfl).clm_apply contDiffOn_const
  have gS : ∀ (U : Set E2), IsOpen U → U ⊆ W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (sgbGradSq2 h f) U := by
    intro U hU hUW f hf
    have hp := pdS U hU f hf
    show ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a f x * pd2 c f x) U
    exact ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
      (((hinvW a c).mono hUW).mul (hp a)).mul (hp c)))
  
  have kC : ∀ (U : Set E2), IsOpen U → U ⊆ W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      (∀ x ∈ U, 0 < sgbGradSq2 h f x) → ContinuousOn (sgbLevelCurv2 h f) U := by
    intro U hU hUW f hf hpos
    have hsd : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det) U :=
      (hdetS.mono hUW).sqrt (fun y hy => hdetW y (hUW hy))
    have hsdne : ∀ y ∈ U, Real.sqrt (h y).det ≠ 0 :=
      fun y hy => (Real.sqrt_pos.2 (hpd y (hUW hy)).det_pos).ne'
    have hG : ContDiffOn ℝ ∞ (sgbGradSq2 h f) U := gS U hU hUW f hf
    have hsG : ContDiffOn ℝ ∞ (fun y => Real.sqrt (sgbGradSq2 h f y)) U :=
      hG.sqrt (fun y hy => (hpos y hy).ne')
    have hsGne : ∀ y ∈ U, Real.sqrt (sgbGradSq2 h f y) ≠ 0 :=
      fun y hy => (Real.sqrt_pos.2 (hpos y hy)).ne'
    have hp := pdS U hU f hf
    have hY : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det *
        (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y)) U := by
      intro i
      have h1 : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det *
          (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y)) U :=
        hsd.mul (ContDiffOn.sum (fun a _ => ((hinvW i a).mono hUW).mul (hp a)))
      exact h1.div hsG hsGne
    have hYd : ∀ i : Fin 2, ContinuousOn (fun x => pd2 i (fun y => Real.sqrt (h y).det *
        (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y)) x) U := by
      intro i
      exact ((hY i).continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
    have hinvd : ContinuousOn (fun x => (Real.sqrt (h x).det)⁻¹) U :=
      hsd.continuousOn.inv₀ hsdne
    show ContinuousOn (fun x => -((Real.sqrt (h x).det)⁻¹ * ∑ i : Fin 2,
      pd2 i (fun y => Real.sqrt (h y).det * (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) /
        Real.sqrt (sgbGradSq2 h f y)) x)) U
    exact (hinvd.mul (continuousOn_finset_sum _ (fun i _ => hYd i))).neg
  
  have logd : ∀ (F : E2 → ℝ) (x : E2) (ε : ℝ), DifferentiableAt ℝ F x → 0 < F x + ε →
      ∀ c : Fin 2, pd2 c (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) x =
        pd2 c F x / (2 * (F x + ε)) := by
    intro F x ε hF hpos c
    have h1 : HasFDerivAt (fun y => F y + ε) (fderiv ℝ F x) x := hF.hasFDerivAt.add_const ε
    have h2 := (h1.log hpos.ne').const_mul (1 / 2 : ℝ)
    simp only [pd2]
    rw [h2.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  
  have alg : ∀ q g ε A : ℝ, 0 < g → 0 < ε → |q| / (2 * g ^ 2) ≤ A →
      |q / (2 * g) - q / (2 * (g + ε))| ≤ A * ε := by
    intro q g ε A hg hε hA
    have hgε : 0 < g + ε := by linarith
    have h2g : (2 * g) ≠ 0 := (mul_pos two_pos hg).ne'
    have h2gε : (2 * (g + ε)) ≠ 0 := (mul_pos two_pos hgε).ne'
    have hden : 0 < 2 * g * (g + ε) := mul_pos (mul_pos two_pos hg) hgε
    have hden2 : 0 < 2 * g ^ 2 := mul_pos two_pos (pow_pos hg 2)
    have e : q / (2 * g) - q / (2 * (g + ε)) = q * ε / (2 * g * (g + ε)) := by
      field_simp
      ring
    rw [e, abs_div, abs_mul, abs_of_pos hε, abs_of_pos hden]
    have h1 : |q| * ε / (2 * g * (g + ε)) ≤ |q| * ε / (2 * g ^ 2) := by
      apply div_le_div_of_nonneg_left (mul_nonneg (abs_nonneg q) hε.le) hden2
      nlinarith
    calc |q| * ε / (2 * g * (g + ε)) ≤ |q| * ε / (2 * g ^ 2) := h1
      _ = |q| / (2 * g ^ 2) * ε := by ring
      _ ≤ A * ε := mul_le_mul_of_nonneg_right hA hε.le
  
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ, Q = fun x => ∑ a : Fin 2, ∑ c : Fin 2,
      (h x)⁻¹ a c * pd2 a b x * pd2 c (sgbGradSq2 h w) x := ⟨_, rfl⟩
  have hpdb : ∀ a, ContDiffOn ℝ ∞ (pd2 a b) W := pdS W hW b hb
  have hGV : ContDiffOn ℝ ∞ (sgbGradSq2 h w) V := gS V hV hVW w hw
  have hGbW : ContDiffOn ℝ ∞ (sgbGradSq2 h b) W := gS W hW Set.Subset.rfl b hb
  have hGdiff : ∀ x ∈ V, DifferentiableAt ℝ (sgbGradSq2 h w) x :=
    fun x hx => (hGV.contDiffAt (hV.mem_nhds hx)).differentiableAt hne
  have hpdG : ∀ c, ContinuousOn (pd2 c (sgbGradSq2 h w)) V :=
    fun c => (pdS V hV _ hGV c).continuousOn
  have hQc : ContinuousOn Q V := by
    rw [hQ]
    exact continuousOn_finset_sum _ (fun a _ => continuousOn_finset_sum _ (fun c _ =>
      (((hinvW a c).mono hVW).continuousOn.mul ((hpdb a).continuousOn.mono hVW)).mul (hpdG c)))
  
  have hPε : ∀ x ∈ V, 0 < sgbGradSq2 h w x → ∀ ε : ℝ, 0 ≤ ε →
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
      Q x / (2 * (sgbGradSq2 h w x + ε)) := by
    intro x hx hG ε hε
    have hpos : 0 < sgbGradSq2 h w x + ε := by linarith
    simp only [logd _ x ε (hGdiff x hx) hpos, hQ]
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    ring
  have hP0 : ∀ x ∈ V, 0 < sgbGradSq2 h w x →
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Q x / (2 * sgbGradSq2 h w x) := by
    intro x hx hG
    have := hPε x hx hG 0 le_rfl
    simpa only [add_zero] using this
  
  obtain ⟨O, hOdef⟩ : ∃ O : Set E2,
      O = {x | x ∈ V ∧ 0 < sgbGradSq2 h w x ∧ 0 < sgbGradSq2 h b x} := ⟨_, rfl⟩
  have hOmem : ∀ x, x ∈ O ↔ (x ∈ V ∧ 0 < sgbGradSq2 h w x ∧ 0 < sgbGradSq2 h b x) := by
    intro x
    subst hOdef
    exact Iff.rfl
  have hOV : O ⊆ V := fun x hx => ((hOmem x).1 hx).1
  have hOW : O ⊆ W := hOV.trans hVW
  have hOo : IsOpen O := by
    have h1 : IsOpen (V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) :=
      hGV.continuousOn.isOpen_inter_preimage hV isOpen_Ioi
    have h2 : IsOpen ((V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) ∩ sgbGradSq2 h b ⁻¹' Set.Ioi 0) :=
      (hGbW.continuousOn.mono (fun x hx => hVW hx.1)).isOpen_inter_preimage h1 isOpen_Ioi
    have e : O = (V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) ∩ sgbGradSq2 h b ⁻¹' Set.Ioi 0 := by
      ext x
      rw [hOmem x]
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_Ioi, and_assoc]
    rw [e]
    exact h2
  
  have hf0c : ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)) O := by
    have hk : ContinuousOn (sgbLevelCurv2 h b) O :=
      kC O hOo hOW b (hb.mono hOW) (fun x hx => ((hOmem x).1 hx).2.2)
    have hs : ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h b x)) O :=
      (hGbW.continuousOn.mono hOW).sqrt
    have hq : ContinuousOn (fun x => Q x / (2 * sgbGradSq2 h w x)) O :=
      (hQc.mono hOV).div (continuousOn_const.mul (hGV.continuousOn.mono hOV))
        (fun x hx => (mul_pos two_pos ((hOmem x).1 hx).2.1).ne')
    exact (hs.mul hk).sub hq
  
  have hbK : ContinuousOn b Kc := hb.continuousOn.mono hKW
  have hK0c : IsCompact (Kc ∩ b ⁻¹' Set.Icc 0 σ₀) :=
    hKc.of_isClosed_subset (hbK.preimage_isClosed_of_isClosed hKc.isClosed isClosed_Icc)
      Set.inter_subset_left
  have hK0V : Kc ∩ b ⁻¹' Set.Icc 0 σ₀ ⊆ V := fun x hx => hbV x (hKW hx.1) hx.2.1 hx.2.2
  obtain ⟨σ', hσ', hσ'P⟩ := sep (Kc ∩ b ⁻¹' Set.Icc 0 σ₀) hK0c b
    (fun x => |sgbGradSq2 h w x - sgbGradSq2 h b x| - (sgbGradSq2 h w x + sgbGradSq2 h b x))
    (hbK.mono Set.inter_subset_left)
    ((((hGV.continuousOn.mono hK0V).sub
        (hGbW.continuousOn.mono (fun x hx => hKW hx.1))).abs).sub
      ((hGV.continuousOn.mono hK0V).add
        (hGbW.continuousOn.mono (fun x hx => hKW hx.1)))) 0
    (fun x hx hbx => by
      have hxW := hKW hx.1
      have h1 := gpos w x (hpd x hxW) (hdw x hxW hbx)
      have h2 := gpos b x (hpd x hxW) (hreg x hxW hbx)
      have h3 : |sgbGradSq2 h w x - sgbGradSq2 h b x| <
          sgbGradSq2 h w x + sgbGradSq2 h b x :=
        abs_sub_lt_iff.mpr ⟨by linarith, by linarith⟩
      show |sgbGradSq2 h w x - sgbGradSq2 h b x| -
        (sgbGradSq2 h w x + sgbGradSq2 h b x) < 0
      linarith)
  have hσ₁ : 0 < min σ₀ (σ' / 2) := lt_min hσ₀ (half_pos hσ')
  have hK1c : IsCompact (Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2))) :=
    hKc.of_isClosed_subset (hbK.preimage_isClosed_of_isClosed hKc.isClosed isClosed_Icc)
      Set.inter_subset_left
  have hK1O : Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)) ⊆ O := by
    intro x hx
    have hb0 : 0 ≤ b x := hx.2.1
    have hb1 : b x ≤ min σ₀ (σ' / 2) := hx.2.2
    have hbσ₀ : b x ≤ σ₀ := hb1.trans (min_le_left _ _)
    have hbσ' : b x < σ' := lt_of_le_of_lt (hb1.trans (min_le_right _ _)) (half_lt_self hσ')
    have hxV := hbV x (hKW hx.1) hb0 hbσ₀
    have hneg : |sgbGradSq2 h w x - sgbGradSq2 h b x| -
        (sgbGradSq2 h w x + sgbGradSq2 h b x) < 0 :=
      hσ'P x ⟨hx.1, hb0, hbσ₀⟩ hb0 hbσ'
    have e1 := le_abs_self (sgbGradSq2 h w x - sgbGradSq2 h b x)
    have e2 := neg_abs_le (sgbGradSq2 h w x - sgbGradSq2 h b x)
    exact (hOmem x).2 ⟨hxV, by linarith, by linarith⟩
  
  have hrc : ContinuousOn (fun x => |Q x| / (2 * sgbGradSq2 h w x ^ 2)) O :=
    (hQc.mono hOV).abs.div (continuousOn_const.mul ((hGV.continuousOn.mono hOV).pow 2))
      (fun x hx => (mul_pos two_pos (pow_pos ((hOmem x).1 hx).2.1 2)).ne')
  obtain ⟨C, hC⟩ := hK1c.exists_bound_of_continuousOn (hrc.mono hK1O)
  refine ⟨max C 0, le_max_right _ _, ?_⟩
  have hdiff : ∀ x ∈ Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)), ∀ ε : ℝ, 0 < ε →
      |Q x / (2 * sgbGradSq2 h w x) - Q x / (2 * (sgbGradSq2 h w x + ε))| ≤ max C 0 * ε := by
    intro x hx ε hε
    have hG : 0 < sgbGradSq2 h w x := ((hOmem x).1 (hK1O hx)).2.1
    have hr : |Q x| / (2 * sgbGradSq2 h w x ^ 2) ≤ max C 0 := by
      have h1 : ‖|Q x| / (2 * sgbGradSq2 h w x ^ 2)‖ ≤ C := hC x hx
      rw [Real.norm_eq_abs] at h1
      exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
    exact alg (Q x) (sgbGradSq2 h w x) ε (max C 0) hG hε hr
  
  intro δ hδ
  obtain ⟨σ₂, hσ₂, hσ₂P⟩ := sep (Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2))) hK1c b
    (fun x => |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)|)
    (hbK.mono Set.inter_subset_left) ((hf0c.mono hK1O).abs) δ
    (fun x hx hbx => by
      have hxO := hK1O hx
      have hxW := hKW hx.1
      have hG := ((hOmem x).1 hxO).2.1
      have h1 := hzero x hxW hbx
      rw [hP0 x ((hOmem x).1 hxO).1 hG] at h1
      show |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
        Q x / (2 * sgbGradSq2 h w x)| < δ
      rw [← h1, sub_self, abs_zero]
      exact hδ)
  refine ⟨min (min σ₀ (σ' / 2)) σ₂, lt_min hσ₁ hσ₂, fun ε hε x hx hbx hbσ => ?_⟩
  have hx1 : x ∈ Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)) :=
    ⟨hx, hbx.le, hbσ.le.trans (min_le_left _ _)⟩
  have hxO := hK1O hx1
  have hG := ((hOmem x).1 hxO).2.1
  have hxV := ((hOmem x).1 hxO).1
  have h1 : |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)| < δ :=
    hσ₂P x hx1 hbx.le (lt_of_lt_of_le hbσ (min_le_right _ _))
  have h2 := hdiff x hx1 ε hε
  rw [hPε x hxV hG ε hε.le]
  have h3 := abs_sub_le (Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x)
    (Q x / (2 * sgbGradSq2 h w x)) (Q x / (2 * (sgbGradSq2 h w x + ε)))
  linarith

theorem pcgb_collar_error_small {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ →
      ∃ s₀ : ℝ, 0 < s₀ ∧ ∀ s : ℝ, 0 < s → s < s₀ →
        pcgbCollarErr P ρ b Gd.w ε s ≤ θ :=
by
  
  obtain ⟨Cη, hCη0, hη⟩ : ∃ Cη : ℝ, 0 ≤ Cη ∧ ∀ t : ℝ,
      |deriv Real.smoothTransition t| ≤ Cη ∧
        (deriv Real.smoothTransition t ≠ 0 → 0 < t ∧ t < 1) := by
    have hvan : ∀ t : ℝ, ¬ (0 < t ∧ t < 1) → deriv Real.smoothTransition t = 0 := by
      intro t ht
      by_cases h0 : t ≤ 0
      · have hmin : IsLocalMin Real.smoothTransition t :=
          Filter.Eventually.of_forall (fun y => by
            rw [Real.smoothTransition.zero_of_nonpos h0]
            exact Real.smoothTransition.nonneg y)
        exact hmin.deriv_eq_zero
      · have h1 : 1 ≤ t := by
          by_contra h1
          exact ht ⟨lt_of_not_ge h0, lt_of_not_ge h1⟩
        have hmax : IsLocalMax Real.smoothTransition t :=
          Filter.Eventually.of_forall (fun y => by
            rw [Real.smoothTransition.one_of_one_le h1]
            exact Real.smoothTransition.le_one y)
        exact hmax.deriv_eq_zero
    have hc : Continuous (deriv Real.smoothTransition) :=
      (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by norm_num)
    obtain ⟨C, hC⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
      hc.continuousOn
    refine ⟨max C 0, le_max_right _ _, fun t => ⟨?_, ?_⟩⟩
    · by_cases ht : 0 < t ∧ t < 1
      · have := hC t ⟨ht.1.le, ht.2.le⟩
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _)
      · rw [hvan t ht, abs_zero]
        exact le_max_right _ _
    · intro hne
      by_contra ht
      exact hne (hvan t ht)
  
  have hband : ∀ (W : Set E2), IsOpen W → ∀ (K : Set E2), IsCompact K → K ⊆ W →
      ∀ (bb : E2 → ℝ), ContinuousOn bb W → ∀ (ρ' d f : E2 → ℝ),
      (∀ x ∈ W, x ∉ K → ρ' x = 0) → ∀ (R D Cb s : ℝ), 0 < s → 0 ≤ R → 0 ≤ D → 0 ≤ Cb →
      (∀ x ∈ K, |ρ' x * d x| ≤ R) → (∀ x ∈ K, 0 < bb x → bb x < s → |f x| ≤ D) →
      MeasureTheory.volume (K ∩ {x | 0 < bb x ∧ bb x < s}) ≤ ENNReal.ofReal (Cb * s) →
      |∫ x in W, ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x| ≤
        R * Cη * D * Cb := by
    intro W hW K hK hKW bb hbb ρ' d f hρ' R D Cb s hs hR0 hD0 hCb0 hR hD hvolB
    have hBdW : K ∩ {x | 0 < bb x ∧ bb x < s} ⊆ W := fun x hx => hKW hx.1
    have hBdeq : K ∩ {x | 0 < bb x ∧ bb x < s} = K ∩ (W ∩ bb ⁻¹' Set.Ioo 0 s) := by
      ext x
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨h1, hKW h1, h2, h3⟩
      · rintro ⟨h1, -, h2, h3⟩
        exact ⟨h1, h2, h3⟩
    have hBdm : MeasurableSet (K ∩ {x | 0 < bb x ∧ bb x < s}) := by
      rw [hBdeq]
      exact hK.isClosed.measurableSet.inter
        (hbb.isOpen_inter_preimage hW isOpen_Ioo).measurableSet
    have hz : ∀ x ∈ W \ (K ∩ {x | 0 < bb x ∧ bb x < s}),
        ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x = 0 := by
      rintro x ⟨hxW, hxB⟩
      by_cases hxK : x ∈ K
      · have hnot : ¬ (0 < bb x ∧ bb x < s) := fun h => hxB ⟨hxK, h⟩
        have hη0 : deriv Real.smoothTransition (bb x / s) = 0 := by
          by_contra hne
          obtain ⟨h1, h2⟩ := (hη (bb x / s)).2 hne
          exact hnot ⟨(div_pos_iff_of_pos_right hs).mp h1, (div_lt_one hs).mp h2⟩
        rw [hη0]
        ring
      · rw [hρ' x hxW hxK]
        ring
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hW.measurableSet hBdW hz]
    have hvol : MeasureTheory.volume (K ∩ {x | 0 < bb x ∧ bb x < s}) < ⊤ :=
      lt_of_le_of_lt (MeasureTheory.measure_mono Set.inter_subset_left) hK.measure_lt_top
    have hbound : ∀ x ∈ K ∩ {x | 0 < bb x ∧ bb x < s},
        ‖ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x‖ ≤
          R * s⁻¹ * Cη * D := by
      rintro x ⟨hxK, h1, h2⟩
      rw [Real.norm_eq_abs]
      have e : ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x =
          (ρ' x * d x) * s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x := by ring
      rw [e, abs_mul, abs_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
      have a1 := hR x hxK
      have a2 := (hη (bb x / s)).1
      have a3 := hD x hxK h1 h2
      have hsi : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
      exact mul_le_mul (mul_le_mul (mul_le_mul_of_nonneg_right a1 hsi) a2 (abs_nonneg _)
        (mul_nonneg hR0 hsi)) a3 (abs_nonneg _) (mul_nonneg (mul_nonneg hR0 hsi) hCη0)
    have hI := MeasureTheory.norm_setIntegral_le_of_norm_le_const hvol hbound
    have hreal : MeasureTheory.volume.real (K ∩ {x | 0 < bb x ∧ bb x < s}) ≤ Cb * s := by
      rw [MeasureTheory.measureReal_def]
      exact ENNReal.toReal_le_of_le_ofReal (mul_nonneg hCb0 hs.le) hvolB
    rw [← Real.norm_eq_abs]
    have hc0 : 0 ≤ R * s⁻¹ * Cη * D :=
      mul_nonneg (mul_nonneg (mul_nonneg hR0 (inv_nonneg.mpr hs.le)) hCη0) hD0
    calc _ ≤ R * s⁻¹ * Cη * D * MeasureTheory.volume.real (K ∩ {x | 0 < bb x ∧ bb x < s}) := hI
      _ ≤ R * s⁻¹ * Cη * D * (Cb * s) := mul_le_mul_of_nonneg_left hreal hc0
      _ = R * Cη * D * Cb := by field_simp
  
  have hVo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (Gd.U_open.sdiff isClosed_singleton)
  have hcollar : ∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) → b (P.param j x) ≤ Gd.r →
      x ∈ P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀}) := by
    intro j x hx h0 hr
    have hS : P.param j x ∈ P.O j ∩ S := by
      rw [← P.image_eq j]
      exact ⟨x, hx, rfl⟩
    refine ⟨hx, Gd.R_sub ⟨hS.2, h0⟩, ?_⟩
    intro heq
    have heq' : P.param j x = Gd.p₀ := heq
    have hpos := Gd.ball_pos Gd.x₀ (Metric.mem_closedBall_self Gd.r_pos.le)
    rw [Gd.param_x₀, ← heq'] at hpos
    linarith [Gd.r_pos]
  
  have hzero : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
        pd2 c (fun y => (1 / 2 : ℝ) *
          Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y)) x =
      Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
        sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x := by
    intro j x hx hbx
    have hxV := hcollar j x hx (le_of_eq hbx.symm) (by rw [hbx]; exact Gd.r_pos.le)
    have hbV : ContDiffOn ℝ ∞ (fun y => b (P.param j y))
        (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) := (hb j).mono Set.inter_subset_left
    obtain ⟨lam, H1, H2⟩ := pcgb_levelset_second_order _ (hVo j) (fun y => b (P.param j y))
      (fun z => Gd.w (P.param j z)) hbV (Gd.smooth j) x hxV hbx (hreg j x hx hbx)
      (fun y hy hby => (Gd.dirichlet j y hy.1 hby).1)
    have hharm := Gd.harm j x hx (le_of_eq hbx.symm) hxV.2.2
    exact pcgb_boundary_curvature_algebra _ (hVo j) (P.h j)
      (fun a c => (P.h_smooth j a c).mono Set.inter_subset_left)
      (fun y hy => P.h_posDef j y hy.1) (fun y => b (P.param j y))
      (fun z => Gd.w (P.param j z)) hbV (Gd.smooth j) x hxV (hreg j x hx hbx)
      (Gd.dirichlet j x hx hbx).2 lam H1 H2 hharm
  
  have hs4 := fun j => pcgb_patch_collar_bound (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
    (P.h j) (P.h_smooth j) (P.h_posDef j) (fun y => b (P.param j y))
    (fun z => Gd.w (P.param j z)) (hb j) _ (hVo j) Set.inter_subset_left Gd.r Gd.r_pos
    (hcollar j) (Gd.smooth j) (hreg j) (fun x hx hbx => (Gd.dirichlet j x hx hbx).2) (hzero j)
  choose A hA0 hAσ using hs4
  have hs3 := fun j => pcgb_thin_band_volume (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
    (fun y => b (P.param j y)) (hb j) (hreg j)
  choose Cb s4 hs4pos hCb using hs3
  have hRbd : ∀ j, ∃ R : ℝ, ∀ x ∈ Kc j,
      ‖ρ j (P.param j x) * Real.sqrt (P.h j x).det‖ ≤ R := by
    intro j
    have hdet : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
      have e : (fun x => (P.h j x).det) =
          fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
        funext x
        exact Matrix.det_fin_two _
      rw [e]
      exact ((P.h_smooth j 0 0).continuousOn.mul (P.h_smooth j 1 1).continuousOn).sub
        ((P.h_smooth j 0 1).continuousOn.mul (P.h_smooth j 1 0).continuousOn)
    have hc : ContinuousOn (fun x => ρ j (P.param j x) * Real.sqrt (P.h j x).det) (P.W j) :=
      (hρs j j).continuousOn.mul hdet.sqrt
    exact (hK j).1.exists_bound_of_continuousOn (hc.mono (hK j).2)
  choose Rb hRb using hRbd
  
  intro θ hθ
  have hB0 : ∀ j, 0 ≤ max (Rb j) 0 * Cη * max (Cb j) 0 := fun j =>
    mul_nonneg (mul_nonneg (le_max_right _ _) hCη0) (le_max_right _ _)
  have hSB0 : 0 ≤ ∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 :=
    Finset.sum_nonneg (fun j _ => hB0 j)
  have hSA0 : 0 ≤ ∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j :=
    Finset.sum_nonneg (fun j _ => mul_nonneg (hB0 j) (hA0 j))
  refine ⟨θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) + 2), by positivity, ?_⟩
  intro ε hε hεlt
  have hδ : 0 < θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) := by positivity
  have hσj := fun j => hAσ j _ hδ
  choose σ hσpos hσ using hσj
  have hT0 : 0 ≤ ∑ j, (1 / σ j + 1 / s4 j) :=
    Finset.sum_nonneg (fun j _ => add_nonneg (one_div_pos.mpr (hσpos j)).le
      (one_div_pos.mpr (hs4pos j)).le)
  refine ⟨1 / (1 + ∑ j, (1 / σ j + 1 / s4 j)), by positivity, ?_⟩
  intro s hs hss
  have hterm : ∀ j, 1 / σ j + 1 / s4 j ≤ ∑ j, (1 / σ j + 1 / s4 j) := fun j =>
    Finset.single_le_sum (f := fun j => 1 / σ j + 1 / s4 j)
      (fun i _ => add_nonneg (one_div_pos.mpr (hσpos i)).le (one_div_pos.mpr (hs4pos i)).le)
      (Finset.mem_univ j)
  have hsσ : ∀ j, s < σ j := by
    intro j
    have h1 : 1 / σ j < 1 + ∑ j, (1 / σ j + 1 / s4 j) := by
      have := hterm j
      have := (one_div_pos.mpr (hs4pos j)).le
      linarith
    have h2 := (one_div_lt (hσpos j) (by positivity)).mp h1
    linarith
  have hss4 : ∀ j, s < s4 j := by
    intro j
    have h1 : 1 / s4 j < 1 + ∑ j, (1 / σ j + 1 / s4 j) := by
      have := hterm j
      have := (one_div_pos.mpr (hσpos j)).le
      linarith
    have h2 := (one_div_lt (hs4pos j) (by positivity)).mp h1
    linarith
  
  have hI : ∀ j, |∫ x in P.W j, ρ j (P.param j x) *
      (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        (Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)) *
      Real.sqrt (P.h j x).det| ≤
      max (Rb j) 0 * Cη * max (Cb j) 0 *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        max (Rb j) 0 * Cη * max (Cb j) 0 * A j * ε := by
    intro j
    have hD0 : 0 ≤ θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) + A j * ε :=
      add_nonneg hδ.le (mul_nonneg (hA0 j) hε.le)
    have key := hband (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
      (fun y => b (P.param j y)) (hb j).continuousOn (fun x => ρ j (P.param j x))
      (fun x => Real.sqrt (P.h j x).det)
      (fun x => Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)
      (hρK j) (max (Rb j) 0)
      (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) + A j * ε)
      (max (Cb j) 0) s hs (le_max_right _ _) hD0 (le_max_right _ _)
      (fun x hx => by
        have := hRb j x hx
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _))
      (fun x hx h1 h2 => hσ j ε hε x hx h1 (h2.trans (hsσ j)))
      ((hCb j s hs (hss4 j)).trans
        (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (le_max_left _ _) hs.le)))
    calc _ ≤ _ := key
      _ = _ := by ring
  
  have hδθ : (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) *
      (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) ≤ θ / 2 := by
    rw [← mul_div_assoc, div_le_iff₀ (by positivity)]
    nlinarith
  have hεθ : (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) * ε ≤ θ / 2 := by
    have h1 := (lt_div_iff₀ (by positivity)).mp hεlt
    nlinarith
  unfold pcgbCollarErr eigWInt
  calc _ ≤ ∑ j, (max (Rb j) 0 * Cη * max (Cb j) 0 *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        max (Rb j) 0 * Cη * max (Cb j) 0 * A j * ε) :=
        Finset.sum_le_sum (fun j _ => (le_abs_self _).trans (hI j))
    _ = (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) * ε := by
        rw [Finset.sum_add_distrib, Finset.sum_mul, Finset.sum_mul]
    _ ≤ θ / 2 + θ / 2 := add_le_add hδθ hεθ
    _ = θ := by ring

theorem patched_collar_gauss_bonnet {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) :
    ∀ θ : ℝ, 0 < θ → ∃ s₀ : ℝ, 0 < s₀ ∧ ∀ s : ℝ, 0 < s → s < s₀ →
      sgbCollarGB P ρ b s ≤ 2 * Real.pi + θ :=
by
  intro θ hθ
  obtain ⟨Gd⟩ := pcgb_green_function S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1 hreg hbd
  obtain ⟨s₁, hs₁, hmain⟩ := pcgb_main_inequality S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd
  obtain ⟨ε₁, hε₁, hdef⟩ := pcgb_defect_small S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd (θ / 2) (half_pos hθ)
  obtain ⟨ε₂, hε₂, hcol⟩ := pcgb_collar_error_small S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd (θ / 2) (half_pos hθ)
  have hm : 0 < min ε₁ ε₂ := lt_min hε₁ hε₂
  have hε0 : 0 < min ε₁ ε₂ / 2 := half_pos hm
  have hεlt : min ε₁ ε₂ / 2 < min ε₁ ε₂ := half_lt_self hm
  have hε1 : min ε₁ ε₂ / 2 < ε₁ := lt_of_lt_of_le hεlt (min_le_left _ _)
  have hε2 : min ε₁ ε₂ / 2 < ε₂ := lt_of_lt_of_le hεlt (min_le_right _ _)
  obtain ⟨s₂, hs₂, hcol'⟩ := hcol (min ε₁ ε₂ / 2) hε0 hε2
  refine ⟨min s₁ s₂, lt_min hs₁ hs₂, fun s hs hss => ?_⟩
  have h1 := hmain (min ε₁ ε₂ / 2) hε0 s hs (lt_of_lt_of_le hss (min_le_left _ _))
  have h2 := hdef (min ε₁ ε₂ / 2) hε0 hε1 s hs
  have h3 := hcol' s hs (lt_of_lt_of_le hss (min_le_right _ _))
  linarith

theorem pdiffeo_lift_smooth [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (P : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (f : E3 → ℝ) (hf : ContDiff ℝ ∞ f)
    (hfc : HasCompactSupport f) (hfs : tsupport f ⊆ P.source) :
    ∃ F : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F ∧ (∀ y ∈ P.source, F (P y) = f y) ∧
      (∀ z, z ∉ P '' tsupport f → F z = 0) ∧ IsCompact (P '' tsupport f) ∧
      tsupport F ⊆ P '' tsupport f ∧ (∀ z, F z = 0 ∨ ∃ y ∈ P.source, F z = f y) :=
by
  classical
  let F : M → ℝ := P.target.indicator (fun z => f (P.toPartialEquiv.symm z))
  have hFin : ∀ z ∈ P.target, F z = f (P.toPartialEquiv.symm z) :=
    fun z hz => Set.indicator_of_mem hz _
  have hFout : ∀ z ∉ P.target, F z = 0 := fun z hz => Set.indicator_of_notMem hz _
  have hK : IsCompact (P '' tsupport f) :=
    hfc.isCompact.image_of_continuousOn (P.contMDiffOn.continuousOn.mono hfs)
  have hKc : IsClosed (P '' tsupport f) := hK.isClosed
  have hKt : P '' tsupport f ⊆ P.target := by
    rintro _ ⟨y, hy, rfl⟩
    exact P.toPartialEquiv.map_source (hfs hy)
  have hC2 : ∀ y ∈ P.source, F (P y) = f y := by
    intro y hy
    rw [hFin _ (P.toPartialEquiv.map_source hy)]
    exact congrArg f (P.toPartialEquiv.left_inv hy)
  have hC3 : ∀ z, z ∉ P '' tsupport f → F z = 0 := by
    intro z hz
    by_cases hzt : z ∈ P.target
    · rw [hFin z hzt]
      apply image_eq_zero_of_notMem_tsupport
      intro hy
      exact hz ⟨_, hy, P.toPartialEquiv.right_inv hzt⟩
    · exact hFout z hzt
  have hC5 : tsupport F ⊆ P '' tsupport f :=
    closure_minimal (Function.support_subset_iff'.mpr hC3) hKc
  have hC6 : ∀ z, F z = 0 ∨ ∃ y ∈ P.source, F z = f y := by
    intro z
    by_cases hzt : z ∈ P.target
    · exact Or.inr ⟨_, P.toPartialEquiv.map_target hzt, hFin z hzt⟩
    · exact Or.inl (hFout z hzt)
  have hC1 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    apply contMDiff_of_tsupport
    intro x hx
    have hxT : x ∈ P.target := hKt (hC5 hx)
    have hT : P.target ∈ 𝓝 x := P.open_target.mem_nhds hxT
    have hG : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ P.invFun) P.target :=
      hf.contMDiff.comp_contMDiffOn P.contMDiffOn_invFun
    refine (hG.contMDiffAt hT).congr_of_eventuallyEq ?_
    filter_upwards [hT] with z hz
    exact hFin z hz
  exact ⟨F, hC1, hC2, hC3, hK, hC5, hC6⟩

theorem slice_side_bumps : ∀ L t : ℝ, ∃ ψ χ : E3 → ℝ, ContDiff ℝ ∞ ψ ∧ ContDiff ℝ ∞ χ ∧
    HasCompactSupport ψ ∧ HasCompactSupport χ ∧
    tsupport ψ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 1} ∧
    tsupport χ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 3 / 8} ∧
    (∀ y, 0 ≤ ψ y ∧ ψ y ≤ 1) ∧ (∀ y, 0 ≤ χ y) ∧
    (∀ a c : ℝ, L ^ 2 - 1 ≤ a ^ 2 + c ^ 2 → a ^ 2 + c ^ 2 ≤ L ^ 2 + 1 / 2 → ψ (cylPt t a c) = 1) ∧
    (∀ a c : ℝ, L ^ 2 - 3 / 2 ≤ a ^ 2 + c ^ 2 → a ^ 2 + c ^ 2 ≤ L ^ 2 + 1 / 4 →
      χ (cylPt t a c) = 1) :=
by
  intro L t
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun y : E3 => y i) := fun i => contDiff_piLp_apply 2
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => (hc i).continuous
  have hη : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hnsq : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hpos : ∀ x : ℝ, Real.smoothTransition x ≠ 0 → 0 < x := by
    intro x hx
    by_contra h
    push_neg at h
    exact hx (Real.smoothTransition.zero_of_nonpos h)
  have hclosed : ∀ c : ℝ, IsClosed {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + c} := by
    intro c
    exact (isClosed_le ((hcont 0).sub continuous_const).abs continuous_const).inter
      ((isClosed_le continuous_const (((hcont 1).pow 2).add ((hcont 2).pow 2))).inter
        (isClosed_le (((hcont 1).pow 2).add ((hcont 2).pow 2)) continuous_const))
  have hbdd : ∀ c : ℝ, c ≤ 1 → {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + c} ⊆ Metric.closedBall (0 : E3) (|t| + |L| + 2) := by
    intro c hc1 y hy
    obtain ⟨h1, h2, h3⟩ := hy
    rw [mem_closedBall_zero_iff]
    have h0 : |y 0| ≤ |t| + 1 := by
      have := abs_sub_abs_le_abs_sub (y 0) t
      linarith
    have hy0 : y 0 ^ 2 ≤ (|t| + 1) ^ 2 := by
      rw [← sq_abs (y 0)]
      exact pow_le_pow_left₀ (abs_nonneg _) h0 2
    have hL : L ^ 2 = |L| ^ 2 := (sq_abs L).symm
    have hn := hnsq y
    have hB : 0 ≤ |t| + |L| + 2 := by positivity
    have ht0 := abs_nonneg t
    have hL0 := abs_nonneg L
    have hsq : ‖y‖ ^ 2 ≤ (|t| + |L| + 2) ^ 2 := by nlinarith [mul_nonneg ht0 hL0]
    by_contra hcon
    push_neg at hcon
    nlinarith [norm_nonneg y]
  have hr : ContDiff ℝ ∞ (fun y : E3 => y 1 ^ 2 + y 2 ^ 2) := ((hc 1).pow 2).add ((hc 2).pow 2)
  have hd : ContDiff ℝ ∞ (fun y : E3 => 2 - 2 * (y 0 - t) ^ 2) :=
    contDiff_const.sub (contDiff_const.mul (((hc 0).sub contDiff_const).pow 2))
  obtain ⟨ψ, hψ⟩ : ∃ ψ : E3 → ℝ, ψ = fun y =>
      Real.smoothTransition (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4)) *
      Real.smoothTransition (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2))) *
      Real.smoothTransition (2 - 2 * (y 0 - t) ^ 2) := ⟨_, rfl⟩
  obtain ⟨χ, hχ⟩ : ∃ χ : E3 → ℝ, χ = fun y =>
      Real.smoothTransition (4 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4)) *
      Real.smoothTransition (8 * (L ^ 2 + 3 / 8 - (y 1 ^ 2 + y 2 ^ 2))) *
      Real.smoothTransition (2 - 2 * (y 0 - t) ^ 2) := ⟨_, rfl⟩
  have hψS : tsupport ψ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 1} := by
    refine closure_minimal ?_ (hclosed 1)
    intro y hy
    rw [Function.mem_support, hψ] at hy
    obtain ⟨hAB, hC⟩ := mul_ne_zero_iff.mp hy
    obtain ⟨hA, hB⟩ := mul_ne_zero_iff.mp hAB
    have pA := hpos _ hA
    have pB := hpos _ hB
    have pC := hpos _ hC
    exact ⟨abs_le.mpr ⟨by nlinarith, by nlinarith⟩, by linarith, by linarith⟩
  have hχS : tsupport χ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 3 / 8} := by
    refine closure_minimal ?_ (hclosed (3 / 8))
    intro y hy
    rw [Function.mem_support, hχ] at hy
    obtain ⟨hAB, hC⟩ := mul_ne_zero_iff.mp hy
    obtain ⟨hA, hB⟩ := mul_ne_zero_iff.mp hAB
    have pA := hpos _ hA
    have pB := hpos _ hB
    have pC := hpos _ hC
    exact ⟨abs_le.mpr ⟨by nlinarith, by nlinarith⟩, by linarith, by linarith⟩
  refine ⟨ψ, χ, ?_, ?_, ?_, ?_, hψS, hχS, ?_, ?_, ?_, ?_⟩
  · rw [hψ]
    exact ((hη.comp (contDiff_const.mul ((hr.sub contDiff_const).add contDiff_const))).mul
      (hη.comp (contDiff_const.mul (contDiff_const.sub hr)))).mul (hη.comp hd)
  · rw [hχ]
    exact ((hη.comp (contDiff_const.mul ((hr.sub contDiff_const).add contDiff_const))).mul
      (hη.comp (contDiff_const.mul (contDiff_const.sub hr)))).mul (hη.comp hd)
  · exact (isCompact_closedBall (0 : E3) (|t| + |L| + 2)).of_isClosed_subset
      (isClosed_tsupport ψ) (hψS.trans (hbdd 1 le_rfl))
  · exact (isCompact_closedBall (0 : E3) (|t| + |L| + 2)).of_isClosed_subset
      (isClosed_tsupport χ) (hχS.trans (hbdd (3 / 8) (by norm_num)))
  · intro y
    rw [hψ]
    have a1 := Real.smoothTransition.nonneg (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4))
    have a2 := Real.smoothTransition.nonneg (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2)))
    have a3 := Real.smoothTransition.nonneg (2 - 2 * (y 0 - t) ^ 2)
    have b1 := Real.smoothTransition.le_one (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4))
    have b2 := Real.smoothTransition.le_one (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2)))
    have b3 := Real.smoothTransition.le_one (2 - 2 * (y 0 - t) ^ 2)
    refine ⟨mul_nonneg (mul_nonneg a1 a2) a3, ?_⟩
    exact mul_le_one₀ (mul_le_one₀ b1 a2 b2) a3 b3
  · intro y
    rw [hχ]
    exact mul_nonneg (mul_nonneg (Real.smoothTransition.nonneg _)
      (Real.smoothTransition.nonneg _)) (Real.smoothTransition.nonneg _)
  · intro a c h1 h2
    obtain ⟨e0, e1, e2⟩ := hcyl a c
    have k1 : Real.smoothTransition (4 / 3 * (a ^ 2 + c ^ 2 - L ^ 2 + 7 / 4)) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k2 : Real.smoothTransition (2 * (L ^ 2 + 1 - (a ^ 2 + c ^ 2))) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k3 : Real.smoothTransition (2 - 2 * (t - t) ^ 2) = 1 :=
      Real.smoothTransition.one_of_one_le (by norm_num)
    rw [hψ]
    simp only [e0, e1, e2, k1, k2, k3, mul_one]
  · intro a c h1 h2
    obtain ⟨e0, e1, e2⟩ := hcyl a c
    have k1 : Real.smoothTransition (4 * (a ^ 2 + c ^ 2 - L ^ 2 + 7 / 4)) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k2 : Real.smoothTransition (8 * (L ^ 2 + 3 / 8 - (a ^ 2 + c ^ 2))) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k3 : Real.smoothTransition (2 - 2 * (t - t) ^ 2) = 1 :=
      Real.smoothTransition.one_of_one_le (by norm_num)
    rw [hχ]
    simp only [e0, e1, e2, k1, k2, k3, mul_one]

theorem pullback_metric_side_regular [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hXY : CoordChange X Y q R₀ R₁ C) :
    (∀ a c : Fin 3, ContDiffOn ℝ ∞ (fun y => pullbackMetric (g.coeff Φ.Φ) Y y a c)
      {y : E3 | R₁ < ‖y‖}) ∧
    (∀ (y : E3) (a c : Fin 3),
      pullbackMetric (g.coeff Φ.Φ) Y y a c = pullbackMetric (g.coeff Φ.Φ) Y y c a) ∧
    (∀ y : E3, R₁ < ‖y‖ → (pullbackMetric (g.coeff Φ.Φ) Y y).PosDef) :=
by
  have hcoeffS : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (i j : Fin 3),
      ContDiffOn ℝ ∞ (fun x => g.coeff Φ x i j) Φ.source := by
    intro Φ i j
    have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
      intro w
      ext k
      simp [e, Pi.single_apply]
    have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
        B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
      intro B D w1 w2
      calc B (D w1) (D w2)
          = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
            rw [← hw w1, ← hw w2]
        _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
            simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
              ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
            conv_lhs => rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
            ring
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
    apply contDiffOn_of_locally_contDiffOn
    intro x0 hx0
    have hu : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      hΦ.continuousOn.isOpen_inter_preimage Φ.open_source (chartAt E3 (Φ x0)).open_source
    have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (Φ x0) (Φ y))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      have h1 := (contMDiffOn_iff_target.mp hΦ).2 (Φ x0)
      rw [extChartAt_source] at h1
      have h2 := contMDiffOn_iff_contDiffOn.mp h1
      simpa [extChartAt_coe, Function.comp_def] using h2
    have hmaps : Set.MapsTo (fun y => chartAt E3 (Φ x0) (Φ y))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) (chartAt E3 (Φ x0)).target :=
      fun y hy => (chartAt E3 (Φ x0)).map_source hy.2
    have hD : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hu).mp hF).2
    have hcoord : ∀ k a : Fin 3, ContDiffOn ℝ ∞
        (fun x => (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k)) a)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      intro k a
      have h2 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := hD.clm_apply contDiffOn_const
      exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
    have hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞
        (fun x => g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      fun a b => (g.smooth (Φ x0) a b).comp hF hmaps
    have hR : ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
        g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      apply ContDiffOn.sum
      intro a _
      apply ContDiffOn.sum
      intro b _
      exact ((hcoord i a).mul (hcoord j b)).mul (hG a b)
    have key : ∀ x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source,
        g.coeff Φ x i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
        g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b := by
      intro x hx
      have hcont : ContinuousAt Φ x :=
        hΦ.continuousOn.continuousAt (Φ.open_source.mem_nhds hx.1)
      have hFdiff : DifferentiableAt ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x :=
        (hF.contDiffAt (hu.mem_nhds hx)).differentiableAt (by simp)
      have hFx : chartAt E3 (Φ x0) (Φ x) ∈ (chartAt E3 (Φ x0)).target := hmaps hx
      have hev : (Φ : E3 → M) =ᶠ[𝓝 x]
          ((chartAt E3 (Φ x0)).symm ∘ fun y => chartAt E3 (Φ x0) (Φ y)) := by
        have hmem : (Φ : E3 → M) ⁻¹' (chartAt E3 (Φ x0)).source ∈ 𝓝 x :=
          hcont.preimage_mem_nhds ((chartAt E3 (Φ x0)).open_source.mem_nhds hx.2)
        filter_upwards [hmem] with y hy
        simp only [Function.comp_apply]
        exact ((chartAt E3 (Φ x0)).left_inv hy).symm
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm
          (chartAt E3 (Φ x0) (Φ x)) :=
        ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
          ((chartAt E3 (Φ x0)).open_target.mem_nhds hFx)).mdifferentiableAt (by simp)
      have hfac : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))
            (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x v) := by
        intro v
        rw [hev.mfderiv_eq, mfderiv_comp x hg hFdiff.mdifferentiableAt, mfderiv_eq_fderiv]
        rfl
      have hpt : (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) = Φ x :=
        (chartAt E3 (Φ x0)).left_inv hx.2
      have h1 : g.coeff Φ x i j = g.g (Φ x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e i))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e j)) := rfl
      have h2 : ∀ a b : Fin 3,
          g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b =
          g.g (Φ x)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e b)) := by
        intro a b
        show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) _ _ = _
        rw [show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) = g.g (Φ x) from
          congrArg g.g hpt]
      rw [h1, hfac, hfac]
      simp only [h2]
      exact hexp (g.g (Φ x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)))
        _ _
    refine ⟨Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source, hu,
      ⟨hx0, mem_chart_source E3 (Φ x0)⟩, ?_⟩
    rw [Set.inter_eq_right.mpr Set.inter_subset_left]
    exact hR.congr key
  have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
    intro w
    ext k
    simp [e, Pi.single_apply]
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hw w1, ← hw w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  set G := pullbackMetric (g.coeff Φ.Φ) Y with hGdef
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY
  have hU : IsOpen {x : E3 | R₁ < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hV : IsOpen {y : E3 | R₀ < ‖y‖} := isOpen_lt continuous_const continuous_norm
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hmapsW : Set.MapsTo Y {x : E3 | R₁ < ‖x‖} {y : E3 | 1 < ‖y‖} := by
    intro x hx
    have h1 := (hinv x hx).1
    show (1 : ℝ) < ‖Y x‖
    linarith
  have hsmooth : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun y => g.coeff Φ.Φ y i j) {y : E3 | 1 < ‖y‖} := by
    intro i j
    have h := hcoeffS Φ.Φ i j
    rwa [Φ.source_eq] at h
  have hcoordF : ∀ (F : E3 → E3) (S : Set E3), ContDiffOn ℝ ∞ F S →
      ∀ d : Fin 3, ContDiffOn ℝ ∞ (fun w => F w d) S := by
    intro F S hF d
    exact (EuclideanSpace.proj d : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hF
  have hfd : ∀ a i : Fin 3, ContDiffOn ℝ ∞ (fun z => (fderiv ℝ Y z (e a)) i)
      {x : E3 | R₁ < ‖x‖} := by
    intro a i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ Y) {x : E3 | R₁ < ‖x‖} := hYs.fderiv_of_isOpen hU le_rfl
    have h2 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ Y z (e a)) {x : E3 | R₁ < ‖x‖} :=
      h1.clm_apply contDiffOn_const
    exact hcoordF _ _ h2 i
  have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R₁ < ‖x‖} := by
    intro a b
    have hGY : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => g.coeff Φ.Φ (Y x) i j)
        {x : E3 | R₁ < ‖x‖} := fun i j => (hsmooth i j).comp hYs hmapsW
    show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 3, ∑ j : Fin 3,
      (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e b)) j) _
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ =>
      ((hfd a i).mul (hGY i j)).mul (hfd b j)))
  have hsymmG : ∀ (y : E3) (a c : Fin 3), G y a c = G y c a := by
    intro y a c
    show ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y y (e a)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e c)) j =
      ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y y (e c)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e a)) j
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    have hs : g.coeff Φ.Φ (Y y) j i = g.coeff Φ.Φ (Y y) i j := by
      simp only [RiemannianMetric3.coeff, coeffMatrix]
      exact g.symm _ _ _
    rw [hs]
    ring
  refine ⟨hGs, hsymmG, fun x hx => ?_⟩
  have hYx : Y x ∈ Φ.Φ.source := by rw [Φ.source_eq]; exact hmapsW hx
  have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ.Φ hYx
  have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) w = 0 → w = 0 := by
    intro w hw0
    have hL : ∀ u : E3, (hloc.mfderivToContinuousLinearEquiv hne) u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) u := by
      intro u
      rw [← hloc.mfderivToContinuousLinearEquiv_coe hne]
      rfl
    apply (hloc.mfderivToContinuousLinearEquiv hne).injective
    rw [hL, hw0, map_zero]
  have hYd : DifferentiableAt ℝ Y x := (hYs.contDiffAt (hU.mem_nhds hx)).differentiableAt hne
  have hXd : DifferentiableAt ℝ X (Y x) :=
    (hXs.contDiffAt (hV.mem_nhds (hinv x hx).1)).differentiableAt hne
  have hc2 : (fderiv ℝ X (Y x)).comp (fderiv ℝ Y x) = ContinuousLinearMap.id ℝ E3 := by
    rw [← fderiv_comp x hXd hYd]
    have hev : X ∘ Y =ᶠ[𝓝 x] id := by
      filter_upwards [hU.mem_nhds hx] with z hz
      exact (hinv z hz).2
    rw [hev.fderiv_eq, fderiv_id]
  have hJinj : ∀ v : E3, fderiv ℝ Y x v = 0 → v = 0 := by
    intro v hv
    have h := congrArg (fun T : E3 →L[ℝ] E3 => T v) hc2
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply, hv,
      map_zero] at h
    exact h.symm
  have hGform : ∀ a c : Fin 3, G x a c = g.g (Φ.Φ (Y x))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e a)))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e c))) := by
    intro a c
    have hh := hexp (g.g (Φ.Φ (Y x))) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x))
      (fderiv ℝ Y x (e a)) (fderiv ℝ Y x (e c))
    refine Eq.trans ?_ hh.symm
    show ∑ i : Fin 3, ∑ j : Fin 3,
      (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e c)) j = _
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    exact mul_right_comm _ _ _
  apply Matrix.PosDef.of_dotProduct_mulVec_pos
  · apply Matrix.IsHermitian.ext
    intro i j
    simp only [star_trivial]
    exact hsymmG x j i
  · intro w hw0
    set v : E3 := w 0 • e 0 + w 1 • e 1 + w 2 • e 2 with hvdef
    have hv0 : v ≠ 0 := by
      intro h0
      apply hw0
      have h0' := congrArg (fun u : E3 => u 0) h0
      have h1' := congrArg (fun u : E3 => u 1) h0
      have h2' := congrArg (fun u : E3 => u 2) h0
      simp [v, e, EuclideanSpace.single_apply] at h0' h1' h2'
      funext k
      fin_cases k
      · simpa using h0'
      · simpa using h1'
      · simpa using h2'
    have hpos := g.posDef (Φ.Φ (Y x)) _ (fun h => hv0 (hJinj _ (hDinj _ h)))
    have key : star w ⬝ᵥ (G x).mulVec w =
        g.g (Φ.Φ (Y x)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v)) := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Pi.star_apply, star_trivial,
        hGform, hvdef, map_add, map_smul, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    rw [key]
    exact hpos

theorem ssd_side_patch_chart [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (X Y : E3 → E3)
    (q R₀ R₁ C t : ℝ) (hXY : CoordChange X Y q R₀ R₁ C)
    (hu1 : ∀ x : E3, R₁ < ‖x‖ → u (sternPsi Φ Y x) = x 0)
    (hch : ∀ x : E3, R₁ < ‖x‖ → g.coeff (sternPsi Φ Y) x = pullbackMetric (g.coeff Φ.Φ) Y x)
    (hpd : ∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
      (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x).PosDef) :
    ContMDiffOn 𝓘(ℝ, E2) 𝓘(ℝ, E3) ∞ (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1)))
      {x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} ∧
    (∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y (cylPt t (x 0) (x 1))) ≠ 0) ∧
    ∀ q' : M, ContDiffOn ℝ ∞ (fun x : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))
      ({x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} ∩
        (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1))) ⁻¹' (chartAt E3 q').source) ∧
      ∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
        sternPsi Φ Y (cylPt t (x 0) (x 1)) ∈ (chartAt E3 q').source →
        Function.Injective
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x) ∧
        sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x =
          pullMetric2 (g.coeff (chartAt E3 q').symm)
            (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x :=
by
  classical
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hD : IsOpen {y : E3 | R₁ < ‖y‖} := isOpen_lt continuous_const continuous_norm
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY
  
  have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
    intro w
    ext k
    simp [e, Pi.single_apply]
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hw w1, ← hw w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  
  have hs6 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (x : E2),
      (pullMetric2 G F x).PosDef → Function.Injective (fderiv ℝ F x) := by
    intro G F x hP
    rw [injective_iff_map_eq_zero]
    intro v hv
    by_contra hv0
    have hw0 : (fun i : Fin 2 => v i) ≠ 0 := by
      intro h
      apply hv0
      ext i
      simpa using congrFun h i
    have hpos := hP.dotProduct_mulVec_pos hw0
    have hvdec : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i
      fin_cases i <;> simp [e2]
