        rintro w ⟨hwN, hwB, hwneg⟩
        refine ⟨interior_subset hwN, ?_⟩
        rintro ⟨-, -, hwD⟩
        have := ((hφ ⟨0, hk⟩ (s ⟨0, hk⟩)).2.2.1 w (hρi ⟨0, hk⟩ hwB)).1.1 (hwD ⟨0, hk⟩)
        simp only [Set.mem_preimage, Set.mem_Iio] at hwneg
