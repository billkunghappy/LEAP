  have hNpos : ∀ p : M, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 →
      0 < Real.sqrt (g.gradInner u u p) := fun p hp =>
    Real.sqrt_pos.2 (stern_band_pointwise g hR β u hβc hu hharm p hp 1 one_pos).1
  have hηc : Continuous Real.smoothTransition := Real.smoothTransition.continuous
  have hη'c : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by norm_num)
  have hβj : ∀ j : Fin n, ContinuousOn (fun y => Real.smoothTransition
      (β ((chartAt E3 (q j)).symm y) / s))
      {y | y ∈ (chartAt E3 (q j)).target ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0} := fun j =>
    hηc.comp_continuousOn ((hβc.comp_continuousOn
      ((chartAt E3 (q j)).continuousOn_symm.mono (fun y hy => hy.1))).div_const s)
  have hβj' : ∀ j : Fin n, ContinuousOn (fun y => deriv Real.smoothTransition
      (β ((chartAt E3 (q j)).symm y) / s))
      {y | y ∈ (chartAt E3 (q j)).target ∧
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 (q j)).symm y) ≠ 0} := fun j =>
    hη'c.comp_continuousOn ((hβc.comp_continuousOn
      ((chartAt E3 (q j)).continuousOn_symm.mono (fun y hy => hy.1))).div_const s)
  
  obtain ⟨i1, e1⟩ := gen (fun p => Real.smoothTransition (β p / s) * sternGaussM g u p)
