  intro ζ hζ hcs hsupp hD
  have hr := A.r_pos j
  have hhalf : Metric.ball (A.c j) (A.r j / 2) ⊆ Metric.ball (A.c j) (A.r j) :=
    Metric.ball_subset_ball (by linarith)
  have hQs : tsupport ζ ⊆ (A.κ j).source := by
    rw [hball j]
    exact hsupp.trans hhalf
  have hζ0 : ∀ x ∈ (A.κ j).source, x ∉ tsupport ζ → ζ x = 0 :=
    fun x _ hx => image_eq_zero_of_notMem_tsupport hx
  obtain ⟨φ, hφs, hφκ, hφ0⟩ :=
    pdiffeo_extend_smooth (A.κ j) ζ hζ.contDiffOn (tsupport ζ) hcs hQs hζ0
  have hKc : IsClosed (A.κ j '' tsupport ζ) :=
    (hcs.image_of_continuousOn ((A.κ j).contMDiffOn.continuousOn.mono hQs)).isClosed
  have hφV : φ ∈ ndsV0 S₀ := by
    show ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ ∧ ∃ N : Set M, IsOpen N ∧ S₀ ⊆ N ∧ ∀ q ∈ N, φ q = 0
    refine ⟨hφs, ?_⟩
    by_cases hDj : A.D j
    · obtain ⟨O, hO, hface, hζO⟩ := hD hDj
      refine ⟨(A.κ j '' tsupport ζ)ᶜ ∪ A.κ j '' (O ∩ Metric.ball (A.c j) (A.r j)),
        hKc.isOpen_compl.union ?_, ?_, ?_⟩
      · exact (A.κ j).toOpenPartialHomeomorph.isOpen_image_of_subset_source
          (hO.inter Metric.isOpen_ball)
          (fun x hx => (by rw [hball j]; exact hx.2 : x ∈ (A.κ j).source))
      · intro q hq
        by_cases hqK : q ∈ A.κ j '' tsupport ζ
        · right
