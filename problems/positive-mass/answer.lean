by
  
  obtain ⟨ε₀, A₀, hε₀, hA₀, hstep⟩ := cutoff_step C_G hCG hG
  refine ⟨ε₀, 100 * (32000 * A₀ + 16), hε₀, by positivity, ?_⟩
  intro w a b F ε M hε hεε₀ hM hw hwb hcoef heq
  
  have hB2 : IsOpen (Metric.ball (0 : E3) 2) := Metric.isOpen_ball
