        exact (hF x hx).2.2
      · rw [hHfs]
  · 
    rw [hWf0]
    ext x
    simp only [Set.mem_setOf_eq, mul_one]
  · 
    intro x hx
    have hx' := hW0 x hx
    rw [hPf0x, hHf0]
    exact ⟨rfl, rfl, (hA8 x hx').2.2.1⟩
  · intro x hx h1
    have hx' := hW0 x hx
    rw [hPf0x]
    exact hA9 x hx' h1
  · 
    intro x hx h1 h2
    have hx' := hW0 x hx
    apply hR5 0 (Pf 0 x)
    · rw [hΨf0, hPf0x]; exact hA12 x hx' h1 h2
    · intro j hj
      revert hj
      refine Fin.cases ?_ (fun i => ?_) j
      · intro h; exact absurd rfl h
      · intro _
        rw [hΨfs]
        have hZ : Pf 0 x ∈ Z := by rw [hPf0x]; exact hA11 x hx' (by linarith)
        exact image_eq_zero_of_notMem_tsupport (fun h => (hUZ _ (hOU i (hψsupp i h))).1 hZ)
  · 
    intro p hp hbp
    rcases hS1' p hp with ⟨x, hx, rfl⟩ | ⟨i, hpO, hpt⟩
    · right
      refine ⟨x, hx, rfl, ?_⟩
      have hx' := hW0 x hx
      rw [hPf0x] at hbp
      exact hA19 x hx' hbp
    · left
      exact hA18 p hpt (hUZ p (hOU i hpO)).1 hbp
  · 
    intro p hp hβp
    refine ⟨(hA20 p hβp).1, hR3 0 p ?_⟩
    rw [hΨf0]
    exact (hA20 p hβp).2

theorem stern_slice_patched_data [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0) :
    ∀ L : ℝ, R₁ + 1 ≤ L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∃ (σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S) (ρ : Fin P.n → M → ℝ)
        (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n),
        sspGood g (hAF.ends k) β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js :=
by
  intro L hL t ht hreg
  have hR₁L : R₁ < L := by linarith
  obtain ⟨σ₀, b, ψs, Z, V, Os, prs, Kcs, hside⟩ :=
    ssp_side_data g (hAF.ends k) β u hβ.1 hu X Y _ R₀ R₁ C hXY hdom.1
      (fun x hx => (hchart x hx).1) L t hL ht
  have hside' := hside
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, ⟨hZc, hVo⟩, -, hnotV, -⟩ := hside'
  obtain ⟨hcptΩ, -, hOC, -⟩ := hdom.2 L hR₁L
  have hcpt : IsCompact (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) :=
    hcptΩ.inter_right (isClosed_singleton.preimage hu.continuous)
  have hcon := hconn L hR₁L t ht hreg
  set U : Set M := Zᶜ ∩ (sternOuterClosed (hAF.ends k) Y L)ᶜ with hUdef
  have hUo : IsOpen U := hZc.isOpen_compl.inter hOC.isOpen_compl
  have hK : IsCompact (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t} ∩ Vᶜ) :=
    hcpt.inter_right hVo.isClosed_compl
  have hKU : sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t} ∩ Vᶜ ⊆ U := by
    intro p hp
    exact hnotV p hp.1 hp.2
  have hKt : ∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t} ∩ Vᶜ,
      u p = t ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 := fun p hp => ⟨hp.1.2, hreg p hp.1⟩
  obtain ⟨m, W, pm, pr, O, z, F, ψ, Kc, hch⟩ :=
    ssp_chart_data g β u hβ.1 hβ.2.1 hu hneu t U _ hUo hK hKU hKt
  obtain ⟨S, P, ρ, Kc', js, hgood⟩ :=
    ssp_assemble g (hAF.ends k) β u Y R₁ L t σ₀ b ψs Z V Os prs Kcs hside U
      (fun p hp => hp) m W pm pr O z F ψ Kc hch hcpt hcon
  exact ⟨σ₀, 1, S, P, ρ, Kc', b, js, hgood⟩

theorem slice_cofactor_identity : ∀ (G : Matrix (Fin 3) (Fin 3) ℝ), 0 < G.det →
    ∀ (a b ξ : Fin 3 → ℝ), ξ ≠ 0 → ∑ k, ξ k * a k = 0 → ∑ k, ξ k * b k = 0 →
    Real.sqrt G.det * Real.sqrt (∑ i, ∑ j, G⁻¹ i j * ξ i * ξ j) / Real.sqrt (∑ k, ξ k ^ 2) *
        Real.sqrt (∑ k : Fin 3, (![a 1 * b 2 - a 2 * b 1, a 2 * b 0 - a 0 * b 2,
          a 0 * b 1 - a 1 * b 0] : Fin 3 → ℝ) k ^ 2) =
      Real.sqrt ((∑ k, ∑ l, a k * G k l * a l) * (∑ k, ∑ l, b k * G k l * b l) -
        (∑ k, ∑ l, a k * G k l * b l) * (∑ k, ∑ l, b k * G k l * a l)) :=
by
  intro G hD a b ξ hξ ha hb
  rw [Fin.sum_univ_three] at ha hb
  
  have hN : 0 < ∑ k, ξ k ^ 2 := by
    obtain ⟨m, hm⟩ := Function.ne_iff.mp hξ
    have hm' : ξ m ≠ 0 := by simpa using hm
    exact Finset.sum_pos' (fun i _ => sq_nonneg _)
      ⟨m, Finset.mem_univ _, lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hm'))⟩
  have hN3 : ∑ k, ξ k ^ 2 = ξ 0 ^ 2 + ξ 1 ^ 2 + ξ 2 ^ 2 := Fin.sum_univ_three _
  have hN' : 0 < ξ 0 ^ 2 + ξ 1 ^ 2 + ξ 2 ^ 2 := hN3 ▸ hN
  
  obtain ⟨μ, hμ⟩ : ∃ μ : ℝ, μ = (ξ 0 * (a 1 * b 2 - a 2 * b 1) + ξ 1 * (a 2 * b 0 - a 0 * b 2) +
      ξ 2 * (a 0 * b 1 - a 1 * b 0)) / (ξ 0 ^ 2 + ξ 1 ^ 2 + ξ 2 ^ 2) := ⟨_, rfl⟩
  have hv0 : a 1 * b 2 - a 2 * b 1 = μ * ξ 0 := by
    rw [hμ, div_mul_eq_mul_div, eq_div_iff hN'.ne']
    linear_combination (ξ 1 * b 2 - ξ 2 * b 1) * ha - (ξ 1 * a 2 - ξ 2 * a 1) * hb
  have hv1 : a 2 * b 0 - a 0 * b 2 = μ * ξ 1 := by
    rw [hμ, div_mul_eq_mul_div, eq_div_iff hN'.ne']
    linear_combination (ξ 2 * b 0 - ξ 0 * b 2) * ha - (ξ 2 * a 0 - ξ 0 * a 2) * hb
  have hv2 : a 0 * b 1 - a 1 * b 0 = μ * ξ 2 := by
    rw [hμ, div_mul_eq_mul_div, eq_div_iff hN'.ne']
    linear_combination (ξ 0 * b 1 - ξ 1 * b 0) * ha - (ξ 0 * a 1 - ξ 1 * a 0) * hb
  have hw : (![a 1 * b 2 - a 2 * b 1, a 2 * b 0 - a 0 * b 2,
      a 0 * b 1 - a 1 * b 0] : Fin 3 → ℝ) = fun k => μ * ξ k := by
    ext k
    fin_cases k
    · exact hv0
    · exact hv1
    · exact hv2
  
  have hgram : (∑ k, ∑ l, a k * G k l * a l) * (∑ k, ∑ l, b k * G k l * b l) -
      (∑ k, ∑ l, a k * G k l * b l) * (∑ k, ∑ l, b k * G k l * a l) =
      ∑ i, ∑ j, G.adjugate i j * (![a 1 * b 2 - a 2 * b 1, a 2 * b 0 - a 0 * b 2,
        a 0 * b 1 - a 1 * b 0] : Fin 3 → ℝ) i * (![a 1 * b 2 - a 2 * b 1, a 2 * b 0 - a 0 * b 2,
        a 0 * b 1 - a 1 * b 0] : Fin 3 → ℝ) j := by
    rw [Matrix.adjugate_fin_three]
    simp only [Fin.sum_univ_three, Matrix.of_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
    ring
  rw [hw] at hgram
  have hinv : ∀ i j, G⁻¹ i j = G.det⁻¹ * G.adjugate i j := by
    intro i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hQ : ∑ i, ∑ j, G⁻¹ i j * ξ i * ξ j =
      G.det⁻¹ * ∑ i, ∑ j, G.adjugate i j * ξ i * ξ j := by
    simp only [hinv, Fin.sum_univ_three]
    ring
  have hS : ∑ i, ∑ j, G.adjugate i j * (fun k => μ * ξ k) i * (fun k => μ * ξ k) j =
      μ ^ 2 * ∑ i, ∑ j, G.adjugate i j * ξ i * ξ j := by
    simp only [Fin.sum_univ_three]
    ring
  have hDD : G.det * G.det⁻¹ = 1 := mul_inv_cancel₀ hD.ne'
  have hG : (∑ k, ∑ l, a k * G k l * a l) * (∑ k, ∑ l, b k * G k l * b l) -
      (∑ k, ∑ l, a k * G k l * b l) * (∑ k, ∑ l, b k * G k l * a l) =
      G.det * (μ ^ 2 * ∑ i, ∑ j, G⁻¹ i j * ξ i * ξ j) := by
    rw [hgram, hS, hQ]
    linear_combination (-(μ ^ 2) * ∑ i, ∑ j, G.adjugate i j * ξ i * ξ j) * hDD
  have hsum : ∑ k : Fin 3, (fun k => μ * ξ k) k ^ 2 = μ ^ 2 * ∑ k, ξ k ^ 2 := by
    simp only [Fin.sum_univ_three]
    ring
  have hNs : Real.sqrt (∑ k, ξ k ^ 2) ≠ 0 := (Real.sqrt_pos.mpr hN).ne'
  rw [hw, hsum, hG, Real.sqrt_mul hD.le, Real.sqrt_mul (sq_nonneg μ),
    Real.sqrt_mul (sq_nonneg μ), Real.sqrt_sq_eq_abs]
  field_simp

theorem slice_area_density_identity [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hcof : ∀ (G : Matrix (Fin 3) (Fin 3) ℝ), 0 < G.det →
      ∀ (a b ξ : Fin 3 → ℝ), ξ ≠ 0 → ∑ k, ξ k * a k = 0 → ∑ k, ξ k * b k = 0 →
      Real.sqrt G.det * Real.sqrt (∑ i, ∑ j, G⁻¹ i j * ξ i * ξ j) / Real.sqrt (∑ k, ξ k ^ 2) *
          Real.sqrt (∑ k : Fin 3, (![a 1 * b 2 - a 2 * b 1, a 2 * b 0 - a 0 * b 2,
            a 0 * b 1 - a 1 * b 0] : Fin 3 → ℝ) k ^ 2) =
        Real.sqrt ((∑ k, ∑ l, a k * G k l * a l) * (∑ k, ∑ l, b k * G k l * b l) -
          (∑ k, ∑ l, a k * G k l * b l) * (∑ k, ∑ l, b k * G k l * a l)))
    (p : M) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W)
    (hFt : ∀ x ∈ W, F x ∈ (chartAt E3 p).target) (c : ℝ)
    (hlev : ∀ x ∈ W, u ((chartAt E3 p).symm (F x)) = c) (x : E2) (hx : x ∈ W)
    (hdu : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm (F x)) ≠ 0) :
    sbgbAreaDens (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z)) (F x) *
        Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
      sbgbAreaConst * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 p).symm) F x).det :=
by
  classical
  have hy : F x ∈ (chartAt E3 p).target := hFt x hx
  have hq : (chartAt E3 p).symm (F x) ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
  have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x) :=
    mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
  have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm (F x)) :=
    mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
  
  have hG : (g.coeff (chartAt E3 p).symm (F x)).PosDef := by
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) (F x) =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm (F x))).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x)) := mfderiv_comp (F x) hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) (F x) =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id (F x) := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm (F x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x) w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x) w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro v hv0
      have hvx : (∑ i, v i • e i : E3) ≠ 0 := by
        intro h0
        apply hv0
        funext j
        have h1 := congrArg (fun w : E3 => w j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm (F x)) _ hDv
      have key : star v ⬝ᵥ (g.coeff (chartAt E3 p).symm (F x)).mulVec v =
          g.g ((chartAt E3 p).symm (F x))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x) (∑ i, v i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (F x) (∑ i, v i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have hux : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm (F x)) :=
    hu.mdifferentiableAt (by simp)
  have hfc : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (u ∘ (chartAt E3 p).symm) (F x) :=
    MDifferentiableAt.comp (F x) hux hf
  have hfd : DifferentiableAt ℝ (fun z => u ((chartAt E3 p).symm z)) (F x) :=
    mdifferentiableAt_iff_differentiableAt.mp hfc
  have hκx : (chartAt E3 p) ((chartAt E3 p).symm (F x)) = F x := (chartAt E3 p).right_inv hy
  have hfc' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (u ∘ (chartAt E3 p).symm)
      ((chartAt E3 p) ((chartAt E3 p).symm (F x))) := by
    rw [hκx]; exact hfc
  have hloc : ((u ∘ (chartAt E3 p).symm) ∘ (chartAt E3 p)) =ᶠ[𝓝 ((chartAt E3 p).symm (F x))] u := by
    filter_upwards [(chartAt E3 p).eventually_left_inverse hq] with z hz
    simp [Function.comp, hz]
  have hchain0 := mfderiv_comp ((chartAt E3 p).symm (F x)) hfc' hg
  rw [hloc.mfderiv_eq, hκx, mfderiv_eq_fderiv] at hchain0
  have hFd : DifferentiableAt ℝ F x :=
    (hF.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)
  
  have hexp : ∀ v : E3, fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) (F x) v =
      ∑ k : Fin 3, partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x) * v k := by
    intro v
    have hv := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
    simp only [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] at hv
    conv_lhs => rw [← hv]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_smul, smul_eq_mul, mul_comm]
    rfl
  
  have horth : ∀ i : Fin 2, ∑ k : Fin 3,
      partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x) * (fderiv ℝ F x (e2 i)) k = 0 := by
    intro i
    have hev : ((fun z => u ((chartAt E3 p).symm z)) ∘ F) =ᶠ[𝓝 x] (fun _ => c) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun x' hx' => hlev x' hx')
    have h0 : fderiv ℝ ((fun z => u ((chartAt E3 p).symm z)) ∘ F) x = 0 := by
      rw [hev.fderiv_eq]; exact fderiv_const_apply c
    rw [fderiv_comp x hfd hFd] at h0
    have h1 := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) h0
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.zero_apply] at h1
    rw [← hexp]; exact h1
  
  have hnorm : ‖fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) (F x)‖ =
      Real.sqrt (∑ k : Fin 3, partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x) ^ 2) := by
    obtain ⟨v, hv⟩ := (InnerProductSpace.toDual ℝ E3).surjective
      (fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) (F x))
    have hk : ∀ k : Fin 3, partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x) = v k := by
      intro k
      show fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) (F x) (e k) = v k
      rw [← hv, InnerProductSpace.toDual_apply, EuclideanSpace.inner_single_right]
      simp
    rw [← hv, LinearIsometryEquiv.norm_map, EuclideanSpace.norm_eq]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hk, Real.norm_eq_abs, sq_abs]
  have hdet : 0 < (g.coeff (chartAt E3 p).symm (F x)).det := hG.det_pos
  have hξ : (fun k : Fin 3 => partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x)) ≠ 0 := by
    intro h0
    have hz : ∀ k : Fin 3, partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x) = 0 :=
      fun k => congrFun h0 k
    apply hdu
    rw [hchain0]
    have hz0 : fderiv ℝ (u ∘ (chartAt E3 p).symm) (F x) = 0 := by
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := hexp v
      simp only [hz, zero_mul, Finset.sum_const_zero] at this
      exact this
    rw [hz0, ContinuousLinearMap.zero_comp]
  have H := hcof (g.coeff (chartAt E3 p).symm (F x)) hdet
    (fun k => (fderiv ℝ F x (e2 0)) k) (fun k => (fderiv ℝ F x (e2 1)) k)
    (fun k : Fin 3 => partialDeriv k (fun z => u ((chartAt E3 p).symm z)) (F x)) hξ
    (horth 0) (horth 1)
  beta_reduce at H
  rw [Matrix.det_fin_two]
  simp only [sbgbAreaDens, gradSqLoc, gradInnerLoc, gsCrossN, gsTan, pullMetric2]
  rw [hnorm]
  linear_combination sbgbAreaConst * H

theorem sbgb_area_integrableOn_iff (F : E2 → E3) (W : Set E2) (hW : IsOpen W)
    (hF : ContDiffOn ℝ ∞ F W) (hinj : Set.InjOn F W)
    (hdF : ∀ x ∈ W, Function.Injective (fderiv ℝ F x))
    (W' : Set E2) (hW' : MeasurableSet W') (hW'W : W' ⊆ W) (h : E3 → ℝ) :
    MeasureTheory.IntegrableOn h (F '' W') (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ↔
      MeasureTheory.IntegrableOn (fun x => h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
        W' :=
by
  have hspec := sbgb_area_const_spec
  have hc : 0 < sbgbAreaConst := hspec.1
  have hlin := sbgb_linear_area hspec
  have hloc := fun x₀ hx₀ ε hε hε1 =>
    sbgb_local_compare hlin F W hW hF hdF x₀ hx₀ ε hε hε1
  have hmeas : ∀ T : Set E2, MeasurableSet T → T ⊆ W →
      MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) (F '' T) =
        ∫⁻ x in T, ENNReal.ofReal
          (sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) :=
    fun T hT hTW => sbgb_measure_form hc F W hW hinj hF.continuousOn hloc T hT hTW
  set ρ : E2 → ℝ := fun x => sbgbAreaConst⁻¹ * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)
    with hρdef
  have hρnn : ∀ x, 0 ≤ ρ x := fun x => mul_nonneg (inv_nonneg.mpr hc.le) (Real.sqrt_nonneg _)
  have htan : ∀ (i : Fin 2) (j : Fin 3), Measurable (fun x => gsTan F i x j) := by
    intro i j
    have h1 : Measurable (fun x => fderiv ℝ F x (e2 i)) := measurable_fderiv_apply_const ℝ F _
    exact (EuclideanSpace.proj j : E3 →L[ℝ] ℝ).continuous.measurable.comp h1
  have hρm : Measurable ρ := by
    have hsum : Measurable (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) := by
      have e1 : (fun x => ∑ k : Fin 3, gsCrossN F x k ^ 2) = fun x =>
          (gsTan F 0 x 1 * gsTan F 1 x 2 - gsTan F 0 x 2 * gsTan F 1 x 1) ^ 2 +
          (gsTan F 0 x 2 * gsTan F 1 x 0 - gsTan F 0 x 0 * gsTan F 1 x 2) ^ 2 +
          (gsTan F 0 x 0 * gsTan F 1 x 1 - gsTan F 0 x 1 * gsTan F 1 x 0) ^ 2 := by
        funext x
        simp [Fin.sum_univ_three, gsCrossN]
      rw [e1]
      have a01 := htan 0 1; have a02 := htan 0 2; have a00 := htan 0 0
      have b01 := htan 1 1; have b02 := htan 1 2; have b00 := htan 1 0
      exact ((((a01.mul b02).sub (a02.mul b01)).pow_const 2).add
        (((a02.mul b00).sub (a00.mul b02)).pow_const 2)).add
        (((a00.mul b01).sub (a01.mul b00)).pow_const 2)
    exact measurable_const.mul hsum.sqrt
  have he : MeasurableEmbedding (W'.restrict F) :=
    ContinuousOn.measurableEmbedding hW' (hF.continuousOn.mono hW'W) (hinj.mono hW'W)
  set μ' : MeasureTheory.Measure W' := MeasureTheory.Measure.comap Subtype.val MeasureTheory.volume
    with hμ'
  set f : W' → NNReal := fun x => (ρ x).toNNReal with hfdef
  have hf : Measurable f := (hρm.comp measurable_subtype_coe).real_toNNReal
  have key : MeasureTheory.Measure.map (W'.restrict F) (μ'.withDensity (fun x => (f x : ENNReal))) =
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)).restrict (F '' W') := by
    ext B hB
    rw [he.map_apply, MeasureTheory.withDensity_apply _ (he.measurable hB),
      MeasureTheory.Measure.restrict_apply hB]
    have hT : Subtype.val '' ((W'.restrict F) ⁻¹' B) = W' ∩ F ⁻¹' B := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact ⟨y.2, hy⟩
      · rintro ⟨hx1, hx2⟩
        exact ⟨⟨x, hx1⟩, hx2, rfl⟩
    have hTm : MeasurableSet (W' ∩ F ⁻¹' B) := by
      rw [← hT]
      exact (MeasurableEmbedding.subtype_coe hW').measurableSet_image' (he.measurable hB)
    have h1 : ∫⁻ x in (W'.restrict F) ⁻¹' B, (f x : ENNReal) ∂μ' =
        ∫⁻ x in (W'.restrict F) ⁻¹' B, (fun y : E2 => ENNReal.ofReal (ρ y)) (x : E2) ∂μ' := rfl
    rw [h1, hμ', MeasureTheory.setLIntegral_subtype hW' _ (fun y : E2 => ENNReal.ofReal (ρ y)), hT,
      ← hmeas (W' ∩ F ⁻¹' B) hTm (Set.inter_subset_left.trans hW'W),
      Set.image_inter_preimage, Set.inter_comm]
  have hpt : (fun x : W' => f x • h (W'.restrict F x)) =
      (fun y : E2 => ρ y * h (F y)) ∘ Subtype.val := by
    funext x
    simp only [hfdef, NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (hρnn x),
      Set.restrict_apply, Function.comp]
  have hfun : (fun y : E2 => ρ y * h (F y)) =
      fun y => sbgbAreaConst⁻¹ * (h (F y) * Real.sqrt (∑ k : Fin 3, gsCrossN F y k ^ 2)) := by
    funext y
    simp only [hρdef]
    ring
  have hunit : IsUnit (sbgbAreaConst⁻¹) := isUnit_iff_ne_zero.mpr (inv_ne_zero hc.ne')
  calc MeasureTheory.IntegrableOn h (F '' W') (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ))
      ↔ MeasureTheory.Integrable h (MeasureTheory.Measure.map (W'.restrict F)
          (μ'.withDensity (fun x => (f x : ENNReal)))) := by
        rw [key]; rfl
    _ ↔ MeasureTheory.Integrable (h ∘ W'.restrict F)
          (μ'.withDensity (fun x => (f x : ENNReal))) := he.integrable_map_iff
    _ ↔ MeasureTheory.Integrable (fun x : W' => f x • h (W'.restrict F x)) μ' :=
        MeasureTheory.integrable_withDensity_iff_integrable_smul hf
    _ ↔ MeasureTheory.Integrable ((fun y : E2 => ρ y * h (F y)) ∘ Subtype.val) μ' := by
        rw [hpt]
    _ ↔ MeasureTheory.IntegrableOn (fun y : E2 => ρ y * h (F y)) W' :=
        (MeasureTheory.integrableOn_iff_comap_subtypeVal hW').symm
    _ ↔ MeasureTheory.IntegrableOn
          (fun x => h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) W' := by
        rw [hfun]
        exact MeasureTheory.integrable_const_mul_iff hunit _
  exact Iff.rfl

theorem slice_patch_integrand_continuity [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js) (i : Fin P.n) :
    ContinuousOn (fun x => g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) (P.param i x) /
        Real.sqrt (g.gradInner u u (P.param i x))) (P.W i) ∧
      ContinuousOn (fun x => sternGaussM g u (P.param i x)) (P.W i) :=
by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, h12, -, -, -, -, -, -, -, -, h21, -⟩ := hgood
  
  have hS : ∀ x ∈ P.W i, P.param i x ∈ S := by
    intro x hx
    have h1 : P.param i x ∈ P.param i '' P.W i := Set.mem_image_of_mem _ hx
    rw [P.image_eq i] at h1
    exact h1.2
  have hreg : ∀ x ∈ P.W i, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (P.param i x) ≠ 0 :=
    fun x hx => (h12 _ (hS x hx)).2
  
  have hpos : ∀ p : M, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 → 0 < g.gradInner u u p := by
    intro p hp
    have hy : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
    have hsy : (chartAt E3 p).symm (chartAt E3 p p) = p :=
      (chartAt E3 p).left_inv (mem_chart_source E3 p)
    have hd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm (chartAt E3 p p)) ≠ 0 := by
      rw [hsy]; exact hp
    exact chart_Nsq_pos g u hu p (chartAt E3 p p) hy hd
  refine ⟨?_, ?_⟩
  · apply continuousOn_of_forall_continuousAt
    intro x₀ hx₀
    obtain ⟨-, -, hUo, hN⟩ := stern_phi_chart_reps g u hu 1 one_pos (P.param i x₀)
    set κ := chartAt E3 (P.param i x₀) with hκ
    set U : Set M := {x : M | mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x ≠ 0} with hUdef
    have hVo : IsOpen (P.W i ∩ P.param i ⁻¹' κ.source) :=
      (P.param_cont i).isOpen_inter_preimage (P.W_open i) κ.open_source
    have hx₀V : x₀ ∈ P.W i ∩ P.param i ⁻¹' κ.source := ⟨hx₀, mem_chart_source E3 _⟩
    have hψ : ContinuousOn (fun x => κ (P.param i x)) (P.W i ∩ P.param i ⁻¹' κ.source) :=
      κ.continuousOn.comp ((P.param_cont i).mono Set.inter_subset_left) (fun x hx => hx.2)
    have hmaps : Set.MapsTo (fun x => κ (P.param i x)) (P.W i ∩ P.param i ⁻¹' κ.source)
        {y | y ∈ κ.target ∧ κ.symm y ∈ U} := by
      intro x hx
      refine ⟨κ.map_source hx.2, ?_⟩
      show κ.symm (κ (P.param i x)) ∈ U
      rw [κ.left_inv hx.2]
      exact hreg x hx.1
    have hnum0 := stern_gradInner_chart g β (fun y => Real.sqrt (g.gradInner u u y)) U hUo hβ hN
      (P.param i x₀)
    have hden0 := stern_gradInner_chart g u u U hUo hu hu.contMDiffOn (P.param i x₀)
    have hnum : ContinuousOn (fun x => g.gradInner β (fun y => Real.sqrt (g.gradInner u u y))
        (P.param i x)) (P.W i ∩ P.param i ⁻¹' κ.source) := by
      refine (hnum0.comp hψ hmaps).congr ?_
      intro x hx
      simp only [Function.comp]
      rw [κ.left_inv hx.2]
    have hrad : ContinuousOn (fun x => g.gradInner u u (P.param i x))
        (P.W i ∩ P.param i ⁻¹' κ.source) := by
      refine (hden0.comp hψ hmaps).congr ?_
      intro x hx
      simp only [Function.comp]
      rw [κ.left_inv hx.2]
    have hne : ∀ x ∈ P.W i ∩ P.param i ⁻¹' κ.source,
        Real.sqrt (g.gradInner u u (P.param i x)) ≠ 0 :=
      fun x hx => ne_of_gt (Real.sqrt_pos.mpr (hpos _ (hreg x hx.1)))
    have hq := hnum.div hrad.sqrt hne
    exact hq.continuousAt (hVo.mem_nhds hx₀V)
  · have hK := gaussCurv2_continuousOn (P.h i) (P.W i) (P.W_open i) (P.h_smooth i) (P.h_posDef i)
    exact hK.congr (fun x hx => (h21 i x hx).symm)

theorem slice_chart_patch_term [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hArea : ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W → Set.InjOn F W →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (W' : Set E2), MeasurableSet W' → W' ⊆ W → ∀ (h : E3 → ℝ),
      ∫ y in F '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        sbgbAreaConst⁻¹ * ∫ x in W', h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
    (hIff : ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W → Set.InjOn F W →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (W' : Set E2), MeasurableSet W' → W' ⊆ W → ∀ (h : E3 → ℝ),
      (MeasureTheory.IntegrableOn h (F '' W') (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ↔
        MeasureTheory.IntegrableOn
          (fun x => h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2)) W'))
    (hDens : ∀ (p : M) (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W →
      (∀ x ∈ W, F x ∈ (chartAt E3 p).target) → ∀ (c : ℝ),
      (∀ x ∈ W, u ((chartAt E3 p).symm (F x)) = c) →
      ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm (F x)) ≠ 0 →
      sbgbAreaDens (g.coeff (chartAt E3 p).symm) (fun z => u ((chartAt E3 p).symm z)) (F x) *
          Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
        sbgbAreaConst * Real.sqrt (pullMetric2 (g.coeff (chartAt E3 p).symm) F x).det)
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js)
    {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ)
    (hadm : sternAdmissible (sternDomain Φ β Y L) q φ) (h : M → ℝ)
    (hh : ∀ i, ContinuousOn (fun x => h (P.param i x)) (P.W i)) (i : Fin P.n) (j : Fin n)
    (hAmeas : MeasurableSet ((chartAt E3 (q j)) ''
      (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 (q j)).source))) :
    MeasureTheory.IntegrableOn (fun y => ρ i ((chartAt E3 (q j)).symm y) *
        (φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
          sbgbAreaDens (g.coeff (chartAt E3 (q j)).symm) (fun z => u ((chartAt E3 (q j)).symm z)) y))
      ((chartAt E3 (q j)) '' (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 (q j)).source))
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) ∧
    ∫ y in (chartAt E3 (q j)) '' (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 (q j)).source),
        ρ i ((chartAt E3 (q j)).symm y) *
          (φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
            sbgbAreaDens (g.coeff (chartAt E3 (q j)).symm) (fun z => u ((chartAt E3 (q j)).symm z)) y)
        ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
      ∫ x in P.W i ∩ P.param i ⁻¹' ((chartAt E3 (q j)).source ∩ (sternDomain Φ β Y L ∩ u ⁻¹' {t})),
        φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) * Real.sqrt (P.h i x).det :=
by
  obtain ⟨h1, h2, h3, h4, h5, -, h7, -, -, -, -, h12, h13, -, -, -, -, h18, h19, -⟩ := hgood
  obtain ⟨Ω', O, hcal, -, -, -⟩ := hadm
  have hc0 : sbgbAreaConst ≠ 0 := by
    have hpi : (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
        MeasureTheory.Measure (Fin 2 → ℝ)) = MeasureTheory.volume := by
      have h := MeasureTheory.hausdorffMeasure_pi_real (ι := Fin 2)
      simpa using h
    have hmp := EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)
    have htrans : ∀ S : Set E2, (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
        MeasureTheory.Measure (Fin 2 → ℝ)) ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) =
          MeasureTheory.volume S := by
      intro S
      have himg : ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) =
          (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm '' S := rfl
      rw [hpi, himg, ← hmp.map_eq, MeasurableEquiv.map_apply,
        Set.preimage_image_eq _ (MeasurableEquiv.injective _)]
    have hlow : ∀ S : Set E2, MeasureTheory.volume S ≤
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := by
      intro S
      have h := (PiLp.lipschitzWith_ofLp 2 (fun _ : Fin 2 => ℝ)).hausdorffMeasure_image_le
        (d := 2) (by norm_num) S
      calc MeasureTheory.volume S
          = (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) :
              MeasureTheory.Measure (Fin 2 → ℝ)) ((WithLp.ofLp : E2 → (Fin 2 → ℝ)) '' S) :=
            (htrans S).symm
        _ ≤ ((1 : NNReal) : ENNReal) ^ (2 : ℝ) *
              (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := h
        _ = (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S := by
            simp
    obtain ⟨K, hK⟩ : ∃ K : NNReal, AntilipschitzWith K (WithLp.ofLp : E2 → (Fin 2 → ℝ)) :=
      ⟨_, PiLp.antilipschitzWith_ofLp 2 (fun _ : Fin 2 => ℝ)⟩
    have hup : ∀ S : Set E2,
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S ≤
          (K : ENNReal) ^ (2 : ℝ) * MeasureTheory.volume S := by
      intro S
      have h := hK.le_hausdorffMeasure_image (d := 2) (by norm_num) S
      rw [htrans] at h
      exact h
    have hKfin : (K : ENNReal) ^ (2 : ℝ) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.coe_ne_top
    haveI : MeasureTheory.IsFiniteMeasureOnCompacts
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) :=
      ⟨fun Kc hKc => lt_of_le_of_lt (hup Kc)
        (ENNReal.mul_lt_top hKfin.lt_top hKc.measure_lt_top)⟩
    obtain ⟨l, hl⟩ : ∃ l : NNReal,
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) =
          l • MeasureTheory.volume :=
      ⟨_, MeasureTheory.Measure.isAddLeftInvariant_eq_smul _ _⟩
    have hμS : ∀ S : Set E2,
        (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ) : MeasureTheory.Measure E2) S =
          (l : ENNReal) * MeasureTheory.volume S := by
      intro S
      rw [hl, MeasureTheory.Measure.coe_nnreal_smul_apply]
    have hB : (MeasureTheory.volume : MeasureTheory.Measure E2) (Metric.ball 0 1) =
        ENNReal.ofReal Real.pi := by
      rw [EuclideanSpace.volume_ball_fin_two]
      simp
    have hl0 : l ≠ 0 := by
      intro h0
      have h1 := hlow (Metric.ball 0 1)
      rw [hμS, h0, hB, ENNReal.coe_zero, zero_mul] at h1
      exact absurd (ENNReal.ofReal_pos.mpr Real.pi_pos) (not_lt.mpr h1)
    have hlpos : (0 : ℝ) < l :=
      lt_of_le_of_ne l.2 (Ne.symm (NNReal.coe_ne_zero.mpr hl0))
    have hconst : sbgbAreaConst = ((l : ℝ))⁻¹ := by
      unfold sbgbAreaConst
      rw [hμS, hB, ENNReal.toReal_mul, ENNReal.coe_toReal,
        ENNReal.toReal_ofReal Real.pi_pos.le, div_mul_cancel_right₀ Real.pi_ne_zero]
    rw [hconst]
    exact ne_of_gt (inv_pos.mpr hlpos)
  set κ := chartAt E3 (q j) with hκ
  set Sg := sternDomain Φ β Y L ∩ u ⁻¹' {t} with hSg
  have hSgS : ∀ z ∈ Sg, z ∈ S := by
    intro z hz
    have hz' : z ∈ Sg := hz
    rw [← h13] at hz'
    exact hz'.1
  have hSgc : IsClosed Sg := by
    show IsClosed Sg
    rw [← h13]; exact h7.isClosed
  have hpS : ∀ x ∈ P.W i, P.param i x ∈ S := by
    intro x hx
    have hmem : P.param i x ∈ P.param i '' P.W i := ⟨x, hx, rfl⟩
    rw [P.image_eq i] at hmem
    exact hmem.2
  set F : E2 → E3 := fun x => κ (P.param i x) with hFdef
  set W : Set E2 := P.W i ∩ P.param i ⁻¹' κ.source with hWdef
  set W' : Set E2 := P.W i ∩ P.param i ⁻¹' (κ.source ∩ Sg) with hW'def
  have hWo : IsOpen W := (P.param_cont i).isOpen_inter_preimage (P.W_open i) κ.open_source
  have hW'W : W' ⊆ W := fun x hx => ⟨hx.1, hx.2.1⟩
  have hW'm : MeasurableSet W' := by
    have heq : W' = W \ (P.W i ∩ P.param i ⁻¹' Sgᶜ) := by
      ext x
      simp only [hW'def, hWdef, Set.mem_diff, Set.mem_inter_iff, Set.mem_preimage,
        Set.mem_compl_iff]
      tauto
    rw [heq]
    exact hWo.measurableSet.diff
      ((P.param_cont i).isOpen_inter_preimage (P.W_open i) hSgc.isOpen_compl).measurableSet
  have hFs : ContDiffOn ℝ ∞ F W := (h18 i (q j)).1
  have hpt : ∀ x ∈ W, Function.Injective (fderiv ℝ F x) ∧
      P.h i x = pullMetric2 (g.coeff κ.symm) F x := fun x hx => (h18 i (q j)).2 x hx
  have hFinj : Set.InjOn F W := by
    intro x hx x' hx' hxx
    exact h19 i hx.1 hx'.1 (κ.injOn hx.2 hx'.2 hxx)
  have hFd : ∀ x ∈ W, Function.Injective (fderiv ℝ F x) := fun x hx => (hpt x hx).1
  have hsymm : ∀ x ∈ W, κ.symm (F x) = P.param i x := fun x hx => κ.left_inv hx.2
  have htgt : ∀ x ∈ W, F x ∈ κ.target := fun x hx => κ.map_source hx.2
  have hlev : ∀ x ∈ W, u (κ.symm (F x)) = t := by
    intro x hx
    rw [hsymm x hx]
    exact (h12 _ (hpS x hx.1)).1
  have hmf : ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (κ.symm (F x)) ≠ 0 := by
    intro x hx
    rw [hsymm x hx]
    exact (h12 _ (hpS x hx.1)).2
  
  have hP : ∀ x ∈ W',
      ρ i (κ.symm (F x)) * (φ j (κ.symm (F x)) * h (κ.symm (F x)) *
          sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) (F x)) *
          Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
        sbgbAreaConst * (φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) *
          Real.sqrt (P.h i x).det) := by
    intro x hx
    have hxW := hW'W hx
    have D : sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) (F x) *
        Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
        sbgbAreaConst * Real.sqrt (P.h i x).det := by
      rw [(hpt x hxW).2]
      exact hDens (q j) F W hWo hFs htgt t hlev x hxW (hmf x hxW)
    rw [hsymm x hxW]
    linear_combination (ρ i (P.param i x) * φ j (P.param i x) * h (P.param i x)) * D
  
  have hk_cont : ContinuousOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
      h (P.param i x) * Real.sqrt (P.h i x).det) (P.W i) := by
    have hφc : ContinuousOn (fun x => φ j (P.param i x)) (P.W i) :=
      (hcal.1 j).continuous.comp_continuousOn (P.param_cont i)
    have hρc : ContinuousOn (fun x => ρ i (P.param i x)) (P.W i) := (h2 i i).continuousOn
    have hdet : ContinuousOn (fun x => (P.h i x).det) (P.W i) := by
      simp only [Matrix.det_fin_two]
      exact ((P.h_smooth i 0 0).continuousOn.mul (P.h_smooth i 1 1).continuousOn).sub
        ((P.h_smooth i 0 1).continuousOn.mul (P.h_smooth i 1 0).continuousOn)
    exact ((hφc.mul hρc).mul (hh i)).mul (Real.continuous_sqrt.comp_continuousOn hdet)
  have hk_int : MeasureTheory.IntegrableOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
      h (P.param i x) * Real.sqrt (P.h i x).det) W' := by
    have hKi : MeasureTheory.IntegrableOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
        h (P.param i x) * Real.sqrt (P.h i x).det) (Kc i) :=
      ContinuousOn.integrableOn_compact (h3 i).1 (hk_cont.mono (h3 i).2)
    refine hKi.of_forall_diff_eq_zero hW'm ?_
    intro x hx
    have h0 : ρ i (P.param i x) = 0 := h4 i x hx.1.1 hx.2
    simp [h0]
  
  have hsub : F '' W' ⊆ κ '' (Sg ∩ κ.source) := by
    rintro _ ⟨x, ⟨hxW, hxT, hxS⟩, rfl⟩
    exact ⟨P.param i x, ⟨hxS, hxT⟩, rfl⟩
  have hvan : ∀ y ∈ κ '' (Sg ∩ κ.source) \ F '' W',
      ρ i (κ.symm y) * (φ j (κ.symm y) * h (κ.symm y) *
        sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) y) = 0 := by
    rintro y ⟨⟨z, ⟨hzS, hzT⟩, rfl⟩, hnot⟩
    have hz0 : ρ i z = 0 := by
      apply h5
      intro hzO
      have hmem : z ∈ P.param i '' P.W i := by
        rw [P.image_eq i]; exact ⟨hzO, hSgS z hzS⟩
      obtain ⟨x, hx, rfl⟩ := hmem
      exact hnot ⟨x, ⟨hx, hzT, hzS⟩, rfl⟩
    rw [κ.left_inv hzT, hz0, zero_mul]
  
  have hIntF : MeasureTheory.IntegrableOn (fun y => ρ i (κ.symm y) * (φ j (κ.symm y) *
      h (κ.symm y) * sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) y)) (F '' W')
      (MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) := by
    refine (hIff F W hWo hFs hFinj hFd W' hW'm hW'W _).mpr ?_
    exact MeasureTheory.IntegrableOn.congr_fun
      (MeasureTheory.Integrable.const_mul hk_int sbgbAreaConst)
      (fun x hx => (hP x hx).symm) hW'm
  refine ⟨hIntF.of_forall_diff_eq_zero hAmeas hvan, ?_⟩
  have hA := hArea F W hWo hFs hFinj hFd W' hW'm hW'W (fun y => ρ i (κ.symm y) *
    (φ j (κ.symm y) * h (κ.symm y) * sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) y))
  have hI : ∫ x in W', ρ i (κ.symm (F x)) * (φ j (κ.symm (F x)) * h (κ.symm (F x)) *
          sbgbAreaDens (g.coeff κ.symm) (fun z => u (κ.symm z)) (F x)) *
          Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2) =
      ∫ x in W', sbgbAreaConst * (φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) *
          Real.sqrt (P.h i x).det) :=
    MeasureTheory.setIntegral_congr_fun hW'm hP
  rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hAmeas hsub hvan, hA, hI,
    MeasureTheory.integral_const_mul, inv_mul_cancel_left₀ hc0]

theorem slice_patch_recombine [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ)
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js)
    {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ)
    (hadm : sternAdmissible (sternDomain Φ β Y L) q φ) (h : M → ℝ)
    (hh : ∀ i, ContinuousOn (fun x => h (P.param i x)) (P.W i)) (i : Fin P.n) :
    ∑ j : Fin n, ∫ x in P.W i ∩ P.param i ⁻¹' ((chartAt E3 (q j)).source ∩
        (sternDomain Φ β Y L ∩ u ⁻¹' {t})),
        φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) * Real.sqrt (P.h i x).det =
      ∫ x in P.W i, ρ i (P.param i x) *
        (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator h (P.param i x) * Real.sqrt (P.h i x).det :=
by
  obtain ⟨-, h2, h3, h4, -, -, h7, -, -, -, -, -, h13, -⟩ := hgood
  obtain ⟨Ω', O, ⟨hφs, -, -, hφsupp⟩, -, hΩO, hsum⟩ := hadm
  have hSc : IsClosed (sternDomain Φ β Y L ∩ u ⁻¹' {t}) := by
    rw [← h13]; exact h7.isClosed
  have hWm : MeasurableSet (P.W i) := (P.W_open i).measurableSet
  have hW'eq : P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t}) =
      P.W i \ (P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t})ᶜ) := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_preimage, Set.mem_compl_iff]
    tauto
  have hW'm : MeasurableSet (P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t})) := by
    rw [hW'eq]
    exact hWm.diff ((P.param_cont i).isOpen_inter_preimage (P.W_open i)
      hSc.isOpen_compl).measurableSet
  have hD : ContinuousOn (fun x => Real.sqrt (P.h i x).det) (P.W i) := by
    have h00 := (P.h_smooth i 0 0).continuousOn
    have h11 := (P.h_smooth i 1 1).continuousOn
    have h01 := (P.h_smooth i 0 1).continuousOn
    have h10 := (P.h_smooth i 1 0).continuousOn
    refine (((h00.mul h11).sub (h01.mul h10)).sqrt).congr ?_
    intro x _
    simp only [Matrix.det_fin_two]
  have hk : ∀ j : Fin n, ContinuousOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
      h (P.param i x) * Real.sqrt (P.h i x).det) (P.W i) := by
    intro j
    have hφc : ContinuousOn (fun x => φ j (P.param i x)) (P.W i) :=
      (hφs j).continuous.comp_continuousOn (P.param_cont i)
    exact ((hφc.mul (h2 i i).continuousOn).mul (hh i)).mul hD
  have hkint : ∀ j : Fin n, IntegrableOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
      h (P.param i x) * Real.sqrt (P.h i x).det)
      (P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t})) := by
    intro j
    have hK : IntegrableOn (fun x => φ j (P.param i x) * ρ i (P.param i x) *
        h (P.param i x) * Real.sqrt (P.h i x).det) (Kc i) :=
      ContinuousOn.integrableOn_compact (h3 i).1 ((hk j).mono (h3 i).2)
    refine hK.of_forall_diff_eq_zero hW'm ?_
    intro x hx
    simp only [h4 i x hx.1.1 hx.2, mul_zero, zero_mul]
  have hstep5 : ∀ j : Fin n,
      ∫ x in P.W i ∩ P.param i ⁻¹' ((chartAt E3 (q j)).source ∩
        (sternDomain Φ β Y L ∩ u ⁻¹' {t})),
        φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) * Real.sqrt (P.h i x).det =
      ∫ x in P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t}),
        φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) * Real.sqrt (P.h i x).det := by
    intro j
    refine (setIntegral_eq_of_subset_of_forall_diff_eq_zero hW'm ?_ ?_).symm
    · intro x hx
      exact ⟨hx.1, hx.2.2⟩
    · intro x hx
      have hnot : P.param i x ∉ (chartAt E3 (q j)).source := by
        intro hs
        exact hx.2 ⟨hx.1.1, hs, hx.1.2⟩
      have hz : φ j (P.param i x) = 0 :=
        image_eq_zero_of_notMem_tsupport (fun ht => hnot ((hφsupp j).2 ht).2)
      simp only [hz, zero_mul]
  have hR : ∫ x in P.W i, ρ i (P.param i x) *
        (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator h (P.param i x) * Real.sqrt (P.h i x).det =
      ∫ x in P.W i ∩ P.param i ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t}), ρ i (P.param i x) *
        (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator h (P.param i x) *
          Real.sqrt (P.h i x).det := by
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hWm Set.inter_subset_left ?_
    intro x hx
    have hns : P.param i x ∉ sternDomain Φ β Y L ∩ u ⁻¹' {t} := fun hs => hx.2 ⟨hx.1, hs⟩
    simp only [Set.indicator_of_notMem hns, mul_zero, zero_mul]
  rw [Finset.sum_congr rfl (fun j _ => hstep5 j),
    ← integral_finset_sum Finset.univ (fun j _ => (hkint j).integrable), hR]
  refine setIntegral_congr_fun hW'm ?_
  intro x hx
  have hO : P.param i x ∈ O := hΩO hx.2.1
  have hmem : P.param i x ∈ sternDomain Φ β Y L ∩ u ⁻¹' {t} := hx.2
  simp only [← Finset.sum_mul, hsum _ hO, one_mul, Set.indicator_of_mem hmem h]

theorem stern_slice_patch_identity [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ)
    (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hArea : ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W → Set.InjOn F W →
      (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (W' : Set E2), MeasurableSet W' → W' ⊆ W → ∀ (h : E3 → ℝ),
      ∫ y in F '' W', h y ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        sbgbAreaConst⁻¹ * ∫ x in W', h (F x) * Real.sqrt (∑ k : Fin 3, gsCrossN F x k ^ 2))
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js)
    {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ)
    (hadm : sternAdmissible (sternDomain Φ β Y L) q φ) (s : ℝ) (hs : 0 < s) :
    sbgbSliceJ g β u q φ (sternDomain Φ β Y L) t s =
      eigWInt P ρ (fun i x => (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => Real.smoothTransition (β p / s) * sternGaussM g u p) (P.param i x)) -
        eigWInt P ρ (fun i x => (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
            g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
              Real.sqrt (g.gradInner u u p)) (P.param i x)) :=
by
  have hg' := hgood
  obtain ⟨-, -, -, -, -, -, h7, -, h9, -, -, -, h13, -⟩ := hg'
  
  have hSigClosed : IsClosed (sternDomain Φ β Y L ∩ u ⁻¹' {t}) := by
    rw [← h13]; exact h7.isClosed
  have hSigSum : ∀ z ∈ sternDomain Φ β Y L ∩ u ⁻¹' {t}, ∑ i, ρ i z = 1 := by
    intro z hz
    rw [← h13] at hz
    exact h9 z hz.1 hz.2
  
  have hAmeas : ∀ p : M, MeasurableSet ((chartAt E3 p) ''
      (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 p).source)) := by
    intro p
    have heq : (chartAt E3 p) '' (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 p).source) =
        (chartAt E3 p).target \ ((chartAt E3 p).target ∩
          (chartAt E3 p).symm ⁻¹' (sternDomain Φ β Y L ∩ u ⁻¹' {t})ᶜ) := by
      ext y
      constructor
      · rintro ⟨z, ⟨hzS, hzs⟩, rfl⟩
        refine ⟨(chartAt E3 p).map_source hzs, fun hy => ?_⟩
        have h1 : (chartAt E3 p).symm ((chartAt E3 p) z) ∉ sternDomain Φ β Y L ∩ u ⁻¹' {t} :=
          hy.2
        rw [(chartAt E3 p).left_inv hzs] at h1
        exact h1 hzS
      · rintro ⟨hyt, hy⟩
        have hyS : (chartAt E3 p).symm y ∈ sternDomain Φ β Y L ∩ u ⁻¹' {t} := by
          by_contra hc
          exact hy ⟨hyt, hc⟩
        exact ⟨(chartAt E3 p).symm y, ⟨hyS, (chartAt E3 p).map_target hyt⟩,
          (chartAt E3 p).right_inv hyt⟩
    rw [heq]
    exact (chartAt E3 p).open_target.measurableSet.diff
      ((chartAt E3 p).continuousOn_symm.isOpen_inter_preimage (chartAt E3 p).open_target
        hSigClosed.isOpen_compl).measurableSet
  
  have htransfer : ∀ h : M → ℝ, (∀ i, ContinuousOn (fun x => h (P.param i x)) (P.W i)) →
      sbgbSliceInt g u q φ (sternDomain Φ β Y L) t h =
        eigWInt P ρ (fun i x => (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator h (P.param i x)) := by
    intro h hh
    have hterm := fun (i : Fin P.n) (j : Fin n) => slice_chart_patch_term g Φ β u hu hArea
      sbgb_area_integrableOn_iff (slice_area_density_identity g u hu slice_cofactor_identity)
      Y R₁ L t σ₀ δ₀ S P ρ Kc b js hgood q φ hadm h hh i j (hAmeas (q j))
    have hj : ∀ j : Fin n,
        ∫ y in chartAt E3 (q j) '' (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
            sbgbAreaDens (g.coeff (chartAt E3 (q j)).symm) (fun z => u ((chartAt E3 (q j)).symm z)) y
          ∂(MeasureTheory.Measure.hausdorffMeasure (2 : ℝ)) =
        ∑ i, ∫ x in P.W i ∩ P.param i ⁻¹' ((chartAt E3 (q j)).source ∩
            (sternDomain Φ β Y L ∩ u ⁻¹' {t})),
          φ j (P.param i x) * ρ i (P.param i x) * h (P.param i x) * Real.sqrt (P.h i x).det := by
      intro j
      have hcongr : Set.EqOn
          (fun y => φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
            sbgbAreaDens (g.coeff (chartAt E3 (q j)).symm) (fun z => u ((chartAt E3 (q j)).symm z)) y)
          (fun y => ∑ i, ρ i ((chartAt E3 (q j)).symm y) *
            (φ j ((chartAt E3 (q j)).symm y) * h ((chartAt E3 (q j)).symm y) *
              sbgbAreaDens (g.coeff (chartAt E3 (q j)).symm)
                (fun z => u ((chartAt E3 (q j)).symm z)) y))
          (chartAt E3 (q j) '' (sternDomain Φ β Y L ∩ u ⁻¹' {t} ∩ (chartAt E3 (q j)).source)) := by
        rintro y ⟨z, ⟨hzS, hzs⟩, rfl⟩
        dsimp only
        rw [← Finset.sum_mul, (chartAt E3 (q j)).left_inv hzs, hSigSum z hzS, one_mul]
      rw [setIntegral_congr_fun (hAmeas (q j)) hcongr,
        integral_finset_sum _ (fun i _ => (hterm i j).1)]
      exact Finset.sum_congr rfl (fun i _ => (hterm i j).2)
    unfold sbgbSliceInt eigWInt
    rw [Finset.sum_congr rfl (fun j _ => hj j), Finset.sum_comm]
    exact Finset.sum_congr rfl (fun i _ =>
      slice_patch_recombine g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js hgood q φ hadm h hh i)
  
  have hd : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  have hc1 : ∀ i, ContinuousOn (fun x => (fun p => Real.smoothTransition (β p / s) *
      sternGaussM g u p) (P.param i x)) (P.W i) := by
    intro i
    have hb : ContinuousOn (fun x => β (P.param i x)) (P.W i) :=
      hβ.continuous.comp_continuousOn (P.param_cont i)
    exact (Real.smoothTransition.continuous.comp_continuousOn (hb.div_const s)).mul
      (slice_patch_integrand_continuity g Φ β u hβ hu Y R₁ L t σ₀ δ₀ S P ρ Kc b js hgood i).2
  have hc2 : ∀ i, ContinuousOn (fun x => (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
      g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
        Real.sqrt (g.gradInner u u p)) (P.param i x)) (P.W i) := by
    intro i
    have hb : ContinuousOn (fun x => β (P.param i x)) (P.W i) :=
      hβ.continuous.comp_continuousOn (P.param_cont i)
    have h1 := (continuousOn_const (c := s⁻¹) (s := P.W i)).mul
      (hd.comp_continuousOn (hb.div_const s))
    have h2 := h1.mul
      (slice_patch_integrand_continuity g Φ β u hβ hu Y R₁ L t σ₀ δ₀ S P ρ Kc b js hgood i).1
    refine h2.congr ?_
    intro x _
    simp only [Function.comp]
    ring
  unfold sbgbSliceJ
  rw [htransfer (fun p => Real.smoothTransition (β p / s) * sternGaussM g u p) hc1,
    htransfer (fun p => s⁻¹ * deriv Real.smoothTransition (β p / s) *
      g.gradInner β (fun x => Real.sqrt (g.gradInner u u x)) p /
        Real.sqrt (g.gradInner u u p)) hc2]

theorem patched_bulk_compare [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Φ : EndChart M) (β u : M → ℝ) (hβ : Continuous β)
    (Y : E3 → E3) (R₁ L t σ₀ δ₀ : ℝ) (S : Set M) (P : EigPatchedSurface M S)
    (ρ : Fin P.n → M → ℝ) (Kc : Fin P.n → Set E2) (b : M → ℝ) (js : Fin P.n)
    (hgood : sspGood g Φ β u Y R₁ L t σ₀ δ₀ S P ρ Kc b js) :
    Tendsto (fun s : ℝ =>
      eigWInt P ρ (fun i x => (sternDomain Φ β Y L ∩ u ⁻¹' {t}).indicator
          (fun p => Real.smoothTransition (β p / s) * sternGaussM g u p) (P.param i x)) -
        eigWInt P ρ (fun j x => Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x))
      (𝓝[>] (0 : ℝ)) (𝓝 0) :=
by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19,
    h20, h21, h22, h23, h24, h25, h26, h27⟩ := hgood
  have hS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
