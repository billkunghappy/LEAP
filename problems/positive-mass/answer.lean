theorem smth_avg_holder (S : Set (Fin 2 → ℝ)) (f : ℝ → (Fin 2 → ℝ) → ℝ) (KH β : NNReal) (hH : ∀ s ∈ Set.Icc (0:ℝ) 1, HolderOnWith KH β (f s) S) (hc : ∀ x ∈ S, ContinuousOn (fun s => f s x) (Set.Icc 0 1)) : (∀ x ∈ S, ∀ c₀ ε : ℝ, (∀ s ∈ Set.Icc (0:ℝ) 1, |f s x - c₀| ≤ ε) → |(∫ s in (0:ℝ)..1, f s x) - c₀| ≤ ε) ∧ HolderOnWith KH β (fun x => ∫ s in (0:ℝ)..1, f s x) S :=
by
  have hI : ∀ x ∈ S, IntervalIntegrable (fun s => f s x) MeasureTheory.volume 0 1 :=
    fun x hx => (hc x hx).intervalIntegrable_of_Icc zero_le_one
  have hsub : ∀ s ∈ Set.uIoc (0:ℝ) 1, s ∈ Set.Icc (0:ℝ) 1 := by
    intro s hs
    rw [Set.uIoc_of_le zero_le_one] at hs
    exact Set.Ioc_subset_Icc_self hs
  have hbound : ∀ (g : ℝ → ℝ) (C : ℝ), (∀ s ∈ Set.Icc (0:ℝ) 1, |g s| ≤ C) →
      |∫ s in (0:ℝ)..1, g s| ≤ C := by
    intro g C hg
    have h := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := (0:ℝ)) (b := 1) (C := C) (f := g)
      (fun s hs => by rw [Real.norm_eq_abs]; exact hg s (hsub s hs))
    rw [Real.norm_eq_abs] at h
    simpa using h
  have hA : ∀ x ∈ S, ∀ c₀ ε : ℝ, (∀ s ∈ Set.Icc (0:ℝ) 1, |f s x - c₀| ≤ ε) →
      |(∫ s in (0:ℝ)..1, f s x) - c₀| ≤ ε := by
    intro x hx c₀ ε h
    have e : (∫ s in (0:ℝ)..1, f s x) - c₀ = ∫ s in (0:ℝ)..1, (f s x - c₀) := by
      rw [intervalIntegral.integral_sub (hI x hx) intervalIntegrable_const]
      simp
    rw [e]
    exact hbound _ _ h
  have hd : ∀ x ∈ S, ∀ y ∈ S,
      |(∫ s in (0:ℝ)..1, f s x) - ∫ s in (0:ℝ)..1, f s y| ≤ (KH:ℝ) * dist x y ^ (β:ℝ) := by
    intro x hx y hy
    rw [← intervalIntegral.integral_sub (hI x hx) (hI y hy)]
    refine hbound _ _ (fun s hs => ?_)
    have := (hH s hs).dist_le hx hy
    rwa [Real.dist_eq] at this
  refine ⟨hA, ?_⟩
  intro x hx y hy
  rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg (NNReal.coe_nonneg β),
    ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg KH)]
  apply ENNReal.ofReal_le_ofReal
  rw [Real.dist_eq]
  exact hd x hx y hy

theorem smth_shift_holder {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] (X : (Fin 2 → ℝ) → Y) (T S : Set (Fin 2 → ℝ)) (CX β : NNReal) (hX : HolderOnWith CX β X T) (u : Fin 2 → ℝ) (hS : ∀ x ∈ S, x ∈ T ∧ x + u ∈ T) : HolderOnWith CX β (fun x => X (x + u)) S ∧ ∀ s : ℝ, 0 ≤ s → s ≤ 1 → HolderOnWith CX β (fun x => X x + s • (X (x + u) - X x)) S :=
by
  have hA : HolderOnWith CX β (fun x => X (x + u)) S := by
    intro x hx y hy
    have h := hX (x + u) (hS x hx).2 (y + u) (hS y hy).2
    rw [edist_add_right] at h
    exact h
  refine ⟨hA, ?_⟩
  intro s hs0 hs1 x hx y hy
  have h1 : dist (X x) (X y) ≤ (CX : ℝ) * dist x y ^ (β : ℝ) :=
    hX.dist_le (hS x hx).1 (hS y hy).1
  have h2 : dist (X (x + u)) (X (y + u)) ≤ (CX : ℝ) * dist x y ^ (β : ℝ) :=
    hA.dist_le hx hy
  rw [dist_eq_norm (X x) (X y)] at h1
  rw [dist_eq_norm (X (x + u)) (X (y + u))] at h2
  have key : dist (X x + s • (X (x + u) - X x)) (X y + s • (X (y + u) - X y))
      ≤ (CX : ℝ) * dist x y ^ (β : ℝ) := by
    rw [dist_eq_norm (X x + s • (X (x + u) - X x)) (X y + s • (X (y + u) - X y))]
    have e : (X x + s • (X (x + u) - X x)) - (X y + s • (X (y + u) - X y)) =
        (1 - s) • (X x - X y) + s • (X (x + u) - X (y + u)) := by module
    rw [e]
    have hs1' : 0 ≤ 1 - s := by linarith
    calc ‖(1 - s) • (X x - X y) + s • (X (x + u) - X (y + u))‖
        ≤ ‖(1 - s) • (X x - X y)‖ + ‖s • (X (x + u) - X (y + u))‖ := norm_add_le _ _
      _ = (1 - s) * ‖X x - X y‖ + s * ‖X (x + u) - X (y + u)‖ := by
          rw [norm_smul, norm_smul, Real.norm_of_nonneg hs1', Real.norm_of_nonneg hs0]
      _ ≤ (1 - s) * ((CX : ℝ) * dist x y ^ (β : ℝ)) + s * ((CX : ℝ) * dist x y ^ (β : ℝ)) := by
          gcongr
      _ = (CX : ℝ) * dist x y ^ (β : ℝ) := by ring
  show edist (X x + s • (X (x + u) - X x)) (X y + s • (X (y + u) - X y)) ≤ (CX : ENNReal) * edist x y ^ (β : ℝ)
  rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg (NNReal.coe_nonneg β),
    ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg CX)]
  exact ENNReal.ofReal_le_ofReal key

theorem smth_avg_lip_comp (Φ : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) → (((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) →L[ℝ] ℝ)) (Bset : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (L : NNReal) (hL : LipschitzOnWith L Φ Bset) (hLb : ∀ z ∈ Bset, ‖Φ z‖ ≤ L) (S : Set (Fin 2 → ℝ)) (Z : ℝ → (Fin 2 → ℝ) → ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (CZ β : NNReal) (hZH : ∀ s ∈ Set.Icc (0:ℝ) 1, HolderOnWith CZ β (Z s) S) (hZB : ∀ s ∈ Set.Icc (0:ℝ) 1, ∀ x ∈ S, Z s x ∈ Bset) (hZc : ∀ x ∈ S, ContinuousOn (fun s => Z s x) (Set.Icc 0 1)) (V : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) (hV : ‖V‖ ≤ 1) : (∀ x ∈ S, |∫ s in (0:ℝ)..1, Φ (Z s x) V| ≤ L) ∧ (∀ x ∈ S, ∀ c₀ ε : ℝ, (∀ s ∈ Set.Icc (0:ℝ) 1, |Φ (Z s x) V - c₀| ≤ ε) → |(∫ s in (0:ℝ)..1, Φ (Z s x) V) - c₀| ≤ ε) ∧ HolderOnWith (L * CZ) β (fun x => ∫ s in (0:ℝ)..1, Φ (Z s x) V) S :=
by
  have hop : ∀ T : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) →L[ℝ] ℝ, |T V| ≤ ‖T‖ := by
    intro T
    rw [← Real.norm_eq_abs]
    calc ‖T V‖ ≤ ‖T‖ * ‖V‖ := T.le_opNorm V
      _ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left hV (norm_nonneg T)
      _ = ‖T‖ := mul_one _
  have hint : ∀ x ∈ S, IntervalIntegrable (fun s => Φ (Z s x) V) MeasureTheory.volume 0 1 := by
    intro x hx
    have h1 : ContinuousOn (fun s => Φ (Z s x)) (Set.Icc 0 1) :=
      hL.continuousOn.comp (hZc x hx) (fun s hs => hZB s hs x hx)
    have h2 : ContinuousOn (fun s => Φ (Z s x) V) (Set.Icc 0 1) :=
      h1.clm_apply continuousOn_const
    exact h2.intervalIntegrable_of_Icc zero_le_one
  have hIoc : ∀ s ∈ Set.uIoc (0:ℝ) 1, s ∈ Set.Icc (0:ℝ) 1 := by
    intro s hs
    rw [Set.uIoc_of_le zero_le_one] at hs
    exact Set.Ioc_subset_Icc_self hs
  have hreal : ∀ x ∈ S, ∀ y ∈ S, dist (∫ s in (0:ℝ)..1, Φ (Z s x) V)
      (∫ s in (0:ℝ)..1, Φ (Z s y) V) ≤ (L:ℝ) * CZ * dist x y ^ (β:ℝ) := by
    intro x hx y hy
    rw [Real.dist_eq, ← intervalIntegral.integral_sub (hint x hx) (hint y hy),
      ← Real.norm_eq_abs]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0:ℝ)) (b := 1)
      (f := fun s => Φ (Z s x) V - Φ (Z s y) V) (C := (L:ℝ) * CZ * dist x y ^ (β:ℝ)) ?_
    · simpa only [sub_zero, abs_one, mul_one] using hb
    · intro s hs
      have hs' := hIoc s hs
      have hzx := hZB s hs' x hx
      have hzy := hZB s hs' y hy
      show ‖Φ (Z s x) V - Φ (Z s y) V‖ ≤ _
      rw [Real.norm_eq_abs, ← ContinuousLinearMap.sub_apply]
      calc |(Φ (Z s x) - Φ (Z s y)) V| ≤ ‖Φ (Z s x) - Φ (Z s y)‖ := hop _
        _ = dist (Φ (Z s x)) (Φ (Z s y)) := (dist_eq_norm _ _).symm
        _ ≤ L * dist (Z s x) (Z s y) := hL.dist_le_mul _ hzx _ hzy
        _ ≤ L * (CZ * dist x y ^ (β:ℝ)) :=
          mul_le_mul_of_nonneg_left ((hZH s hs').dist_le hx hy) L.coe_nonneg
        _ = L * CZ * dist x y ^ (β:ℝ) := by ring
  refine ⟨?_, ?_, ?_⟩
  · intro x hx
    rw [← Real.norm_eq_abs]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0:ℝ)) (b := 1)
      (f := fun s => Φ (Z s x) V) (C := (L:ℝ)) ?_
    · simpa only [sub_zero, abs_one, mul_one] using hb
    · intro s hs
      rw [Real.norm_eq_abs]
      exact (hop _).trans (hLb _ (hZB s (hIoc s hs) x hx))
  · intro x hx c₀ ε hc
    have heq : (∫ s in (0:ℝ)..1, Φ (Z s x) V) - c₀ =
        ∫ s in (0:ℝ)..1, (Φ (Z s x) V - c₀) := by
      rw [intervalIntegral.integral_sub (hint x hx) intervalIntegrable_const]
      simp
    rw [heq, ← Real.norm_eq_abs]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0:ℝ)) (b := 1)
      (f := fun s => Φ (Z s x) V - c₀) (C := ε) ?_
    · simpa only [sub_zero, abs_one, mul_one] using hb
    · intro s hs
      rw [Real.norm_eq_abs]
      exact hc s (hIoc s hs)
  · intro x hx y hy
    rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg β.coe_nonneg,
      ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg _)]
    apply ENNReal.ofReal_le_ofReal
    rw [NNReal.coe_mul]
    exact hreal x hx y hy

theorem smth_ell_perturb (M₀ a : Fin 2 → Fin 2 → ℝ) (lam0 : ℝ) (hlam0 : 0 < lam0) (hM : ∀ ξ : Fin 2 → ℝ, lam0 * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, M₀ i j * ξ i * ξ j) (ha : ∀ i j : Fin 2, |a i j - M₀ i j| ≤ lam0 / 8) : ∀ ξ : Fin 2 → ℝ, lam0 / 2 * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, a i j * ξ i * ξ j :=
by
  intro ξ
  have key : ∀ A B u v c : ℝ, |A - B| ≤ c → B * u * v - c / 2 * (u ^ 2 + v ^ 2) ≤ A * u * v := by
    intro A B u v c h
    obtain ⟨h1, h2⟩ := abs_le.mp h
    have e1 : 0 ≤ c + (A - B) := by linarith
    have e2 : 0 ≤ c - (A - B) := by linarith
    nlinarith [mul_nonneg e1 (sq_nonneg (u + v)), mul_nonneg e2 (sq_nonneg (u - v))]
  have H := hM ξ
  have b00 := key (a 0 0) (M₀ 0 0) (ξ 0) (ξ 0) (lam0 / 8) (ha 0 0)
  have b01 := key (a 0 1) (M₀ 0 1) (ξ 0) (ξ 1) (lam0 / 8) (ha 0 1)
  have b10 := key (a 1 0) (M₀ 1 0) (ξ 1) (ξ 0) (lam0 / 8) (ha 1 0)
  have b11 := key (a 1 1) (M₀ 1 1) (ξ 1) (ξ 1) (lam0 / 8) (ha 1 1)
  have P : 0 ≤ lam0 * (ξ 0 ^ 2 + ξ 1 ^ 2) :=
    mul_nonneg hlam0.le (add_nonneg (sq_nonneg _) (sq_nonneg _))
  simp only [Fin.sum_univ_two] at H ⊢
  nlinarith [H, b00, b01, b10, b11, P]

theorem smth_local_coeff_ball (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (hell : ∀ w ∈ O, ∀ q : Fin 2 → ℝ, q ≠ 0 → 0 < fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, q)) w (0, 0, q)) (z₀ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) (hz₀ : z₀ ∈ O) : ∃ (r lam0 : ℝ) (L : NNReal), 0 < r ∧ 0 < lam0 ∧ Metric.closedBall z₀ r ⊆ O ∧ (∀ ξ : Fin 2 → ℝ, lam0 * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀ (0, 0, Pi.single j 1) * ξ i * ξ j) ∧ (∀ z ∈ Metric.closedBall z₀ r, ∀ i j : Fin 2, |fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z (0, 0, Pi.single j 1) - fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀ (0, 0, Pi.single j 1)| ≤ lam0 / 8) ∧ (∀ i : Fin 2, LipschitzOnWith L (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) (Metric.closedBall z₀ r) ∧ ∀ z ∈ Metric.closedBall z₀ r, ‖fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z‖ ≤ L) ∧ LipschitzOnWith L (fderiv ℝ Λ) (Metric.closedBall z₀ r) ∧ ∀ z ∈ Metric.closedBall z₀ r, ‖fderiv ℝ Λ z‖ ≤ L :=
by
  classical
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hΛ1 : ContDiffOn ℝ ∞ (fderiv ℝ Λ) O := hΛ.fderiv_of_isOpen hO le_rfl
  have hA : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) O :=
    fun i => hΛ1.clm_apply contDiffOn_const
  have hDA : ∀ i : Fin 2, ContDiffOn ℝ ∞
      (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) O :=
    fun i => (hA i).fderiv_of_isOpen hO le_rfl
  
  have hdec : ∀ ξ : Fin 2 → ℝ,
      (((0 : Fin 2 → ℝ), (0 : ℝ), ξ) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        ξ 0 • (((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) +
        ξ 1 • (((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ)) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) := by
    intro ξ
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · simp
    · simp
    · funext k; fin_cases k <;> simp
  
  have hexp : ∀ z ∈ O, ∀ ξ : Fin 2 → ℝ,
      fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, ξ)) z (0, 0, ξ) =
        ∑ i : Fin 2, ∑ j : Fin 2, fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z
          (0, 0, Pi.single j 1) * ξ i * ξ j := by
    intro z hz ξ
    have hfun : (fun w' => fderiv ℝ Λ w' (0, 0, ξ)) = fun w' =>
        ξ 0 * fderiv ℝ Λ w' (0, 0, Pi.single 0 1) + ξ 1 * fderiv ℝ Λ w' (0, 0, Pi.single 1 1) := by
      funext w'; rw [hdec ξ]; simp only [map_add, map_smul, smul_eq_mul]
    have d : ∀ i : Fin 2, DifferentiableAt ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z :=
      fun i => ((hA i).differentiableOn (by simp)).differentiableAt (hO.mem_nhds hz)
    have hd := (((d 0).hasFDerivAt.const_mul (ξ 0)).fun_add ((d 1).hasFDerivAt.const_mul (ξ 1))).fderiv
    rw [hfun, hd, hdec ξ]
    simp only [Fin.sum_univ_two, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      map_add, map_smul, smul_eq_mul]
    ring
  have hpos : ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2,
      fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀ (0, 0, Pi.single j 1) * ξ i * ξ j := by
    intro ξ hξ
    rw [← hexp z₀ hz₀ ξ]
    exact hell z₀ hz₀ ξ hξ
  
  have hcoer : ∀ M : Fin 2 → Fin 2 → ℝ,
      (∀ ξ : Fin 2 → ℝ, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, M i j * ξ i * ξ j) →
      ∃ lam0 : ℝ, 0 < lam0 ∧ ∀ ξ : Fin 2 → ℝ,
        lam0 * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, M i j * ξ i * ξ j := by
    intro M hM
    have hA0 : 0 < M 0 0 := by
      have h := hM ![1, 0] (by intro h; have := congrFun h 0; simp at this)
      simpa [Fin.sum_univ_two] using h
    have hD0 : 0 < M 1 1 := by
      have h := hM ![0, 1] (by intro h; have := congrFun h 1; simp at this)
      simpa [Fin.sum_univ_two] using h
    have hdisc : 0 < 4 * M 0 0 * M 1 1 - (M 0 1 + M 1 0) ^ 2 := by
      have h := hM ![-(M 0 1 + M 1 0), 2 * M 0 0]
        (by intro h; have := congrFun h 1; simp at this; linarith)
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one] at h
      nlinarith
    refine ⟨(4 * M 0 0 * M 1 1 - (M 0 1 + M 1 0) ^ 2) / (4 * (M 0 0 + M 1 1)),
      div_pos hdisc (by linarith), fun ξ => ?_⟩
    simp only [Fin.sum_univ_two]
    rw [div_mul_eq_mul_div, div_le_iff₀ (by linarith)]
    nlinarith [sq_nonneg (2 * M 0 0 * ξ 0 + (M 0 1 + M 1 0) * ξ 1),
      sq_nonneg ((M 0 1 + M 1 0) * ξ 0 + 2 * M 1 1 * ξ 1)]
  obtain ⟨lam0, hlam0, hcoer0⟩ := hcoer _ hpos
  
  have hcont : ∀ i : Fin 2,
      ContinuousAt (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) z₀ :=
    fun i => (hDA i).continuousOn.continuousAt (hO.mem_nhds hz₀)
  have hδ : ∀ i : Fin 2, ∃ δ > 0, ∀ z, dist z z₀ < δ →
      dist (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z)
        (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀) < lam0 / 8 :=
    fun i => Metric.continuousAt_iff.1 (hcont i) (lam0 / 8) (by positivity)
  choose δ hδpos hδ using hδ
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hO z₀ hz₀
  have hδm : 0 < min (δ 0) (δ 1) := lt_min (hδpos 0) (hδpos 1)
  obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = min (ε / 2) (min (δ 0) (δ 1) / 2) := ⟨_, rfl⟩
  have hr0 : 0 < r := by rw [hrdef]; exact lt_min (by linarith) (by linarith)
  have hrε : r ≤ ε / 2 := by rw [hrdef]; exact min_le_left _ _
  have hrδ : r ≤ min (δ 0) (δ 1) / 2 := by rw [hrdef]; exact min_le_right _ _
  have hrO : Metric.closedBall z₀ r ⊆ O :=
    (Metric.closedBall_subset_ball (by linarith)).trans hball
  have hVn : ∀ j : Fin 2,
      ‖(((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single j 1 : Fin 2 → ℝ)) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ ≤ 1 :=
    fun j => norm_prod_le_iff.2 ⟨by simp, norm_prod_le_iff.2 ⟨by simp, by rw [Pi.norm_single, norm_one]⟩⟩
  have hclose : ∀ z ∈ Metric.closedBall z₀ r, ∀ i j : Fin 2,
      |fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z (0, 0, Pi.single j 1) -
        fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀ (0, 0, Pi.single j 1)| ≤
        lam0 / 8 := by
    intro z hz i j
    have hzd : dist z z₀ < δ i := by
      have h1 : dist z z₀ ≤ r := hz
      have h3 : min (δ 0) (δ 1) ≤ δ i := by
        fin_cases i
        · exact min_le_left _ _
        · exact min_le_right _ _
      have h4 := hδpos i
      linarith
    have hd := hδ i z hzd
    rw [dist_eq_norm] at hd
    rw [← ContinuousLinearMap.sub_apply, ← Real.norm_eq_abs]
    calc _ ≤ ‖fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z -
            fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀‖ *
          ‖(((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single j 1 : Fin 2 → ℝ)) :
            (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ ‖fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z -
            fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z₀‖ * 1 :=
          mul_le_mul_of_nonneg_left (hVn j) (norm_nonneg _)
      _ ≤ lam0 / 8 := by rw [mul_one]; exact hd.le
  
  have hweak : ∀ (f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) →L[ℝ] ℝ))
      (K K' : NNReal), K ≤ K' →
      (LipschitzOnWith K f (Metric.closedBall z₀ r) ∧ ∀ z ∈ Metric.closedBall z₀ r, ‖f z‖ ≤ K) →
      (LipschitzOnWith K' f (Metric.closedBall z₀ r) ∧ ∀ z ∈ Metric.closedBall z₀ r, ‖f z‖ ≤ K') := by
    intro f K K' hKK' ⟨hL, hB⟩
    refine ⟨LipschitzOnWith.of_dist_le_mul fun x hx y hy => (hL.dist_le_mul x hx y hy).trans
      (mul_le_mul_of_nonneg_right (NNReal.coe_le_coe.2 hKK') dist_nonneg), fun z hz => ?_⟩
    exact (hB z hz).trans (NNReal.coe_le_coe.2 hKK')
  have hlip : ∀ f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) →L[ℝ] ℝ),
      ContDiffOn ℝ 1 f O → ∃ L : NNReal, LipschitzOnWith L f (Metric.closedBall z₀ r) ∧
        ∀ z ∈ Metric.closedBall z₀ r, ‖f z‖ ≤ L := by
    intro f hf
    have hfB := hf.mono hrO
    obtain ⟨K, hK⟩ := hfB.exists_lipschitzOnWith one_ne_zero (convex_closedBall z₀ r)
      (isCompact_closedBall z₀ r)
    obtain ⟨C, hC⟩ := (isCompact_closedBall z₀ r).exists_bound_of_continuousOn hfB.continuousOn
    refine ⟨max K C.toNNReal, LipschitzOnWith.of_dist_le_mul fun x hx y hy =>
      (hK.dist_le_mul x hx y hy).trans
        (mul_le_mul_of_nonneg_right (NNReal.coe_le_coe.2 (le_max_left _ _)) dist_nonneg),
      fun z hz => ?_⟩
    exact (hC z hz).trans ((Real.le_coe_toNNReal C).trans (NNReal.coe_le_coe.2 (le_max_right _ _)))
  obtain ⟨L0, hL0⟩ := hlip _ ((hDA 0).of_le h1inf)
  obtain ⟨L1, hL1⟩ := hlip _ ((hDA 1).of_le h1inf)
  obtain ⟨L2, hL2⟩ := hlip _ (hΛ1.of_le h1inf)
  have hLA : ∀ i : Fin 2,
      LipschitzOnWith (max (max L0 L1) L2)
        (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) (Metric.closedBall z₀ r) ∧
      ∀ z ∈ Metric.closedBall z₀ r,
        ‖fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) z‖ ≤ (max (max L0 L1) L2 : NNReal) := by
    intro i
    fin_cases i
    · exact hweak _ _ _ ((le_max_left _ _).trans (le_max_left _ _)) hL0
    · exact hweak _ _ _ ((le_max_right _ _).trans (le_max_left _ _)) hL1
  have hLΛ := hweak _ _ _ (le_max_right (max L0 L1) L2) hL2
  exact ⟨r, lam0, max (max L0 L1) L2, hr0, hlam0, hrO, hcoer0, hclose, hLA, hLΛ.1, hLΛ.2⟩

theorem smth_graph_holder (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (x₀ : Fin 2 → ℝ) (ρ : ℝ) (C α β : NNReal) (hρ : 0 < ρ) (hhol : HolderOnWith C α (smthGrad v) (Metric.ball x₀ ρ)) (hβα : β ≤ α) (hβ1 : β ≤ 1) (r : ℝ) (hr : 0 < r) (hrρ : r ≤ ρ) (hr1 : r ≤ 1 / 2) : ∃ L : NNReal, (∀ x ∈ Metric.ball x₀ r, ‖smthGrad v x‖ ≤ L) ∧ HolderOnWith L β (smthGrad v) (Metric.ball x₀ r) ∧ HolderOnWith L β (fun x => ((x, v x, smthGrad v x) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (Metric.ball x₀ r) :=
by
  have hBρ : Metric.ball x₀ r ⊆ Metric.ball x₀ ρ := Metric.ball_subset_ball hrρ
  have hx₀ρ : x₀ ∈ Metric.ball x₀ ρ := Metric.mem_ball_self hρ
  
  have hdiam : ∀ x ∈ Metric.ball x₀ r, ∀ y ∈ Metric.ball x₀ r,
      edist x y ≤ ((1 : NNReal) : ENNReal) := by
    intro x hx y hy
    rw [ENNReal.coe_one, edist_dist, ENNReal.ofReal_le_one]
    have h1 : dist x x₀ < r := hx
    have h2 : dist y x₀ < r := hy
    have := dist_triangle_right x y x₀
    linarith
  
  have hdown : ∀ {Y : Type} [PseudoEMetricSpace Y] (f : (Fin 2 → ℝ) → Y) (K K' γ : NNReal),
      K ≤ K' → β ≤ γ → HolderOnWith K γ f (Metric.ball x₀ r) →
      HolderOnWith K' β f (Metric.ball x₀ r) := by
    intro Y _ f K K' γ hKK hβγ hf
    have h := HolderOnWith.of_le hdiam hf hβγ
    simp only [NNReal.one_rpow, mul_one] at h
    intro x hx y hy
    exact (h x hx y hy).trans (mul_le_mul_right' (ENNReal.coe_le_coe.2 hKK) _)
  
  set M : NNReal := ‖smthGrad v x₀‖₊ + C with hM
  have hbound : ∀ x ∈ Metric.ball x₀ r, ‖smthGrad v x‖ ≤ (M : ℝ) := by
    intro x hx
    have hd := hhol.dist_le (hBρ hx) hx₀ρ
    have hxr : dist x x₀ < r := hx
    have hpow : dist x x₀ ^ (α : ℝ) ≤ 1 := Real.rpow_le_one dist_nonneg (by linarith) α.2
    have hC : (C : ℝ) * dist x x₀ ^ (α : ℝ) ≤ C := mul_le_of_le_one_right C.2 hpow
    have htri := norm_sub_norm_le (smthGrad v x) (smthGrad v x₀)
    rw [← dist_eq_norm] at htri
    have hMe : (M : ℝ) = ‖smthGrad v x₀‖ + (C : ℝ) := by
      rw [hM, NNReal.coe_add, coe_nnnorm]
    rw [hMe]
    linarith
  
  have hvd : Differentiable ℝ v := hv.differentiable one_ne_zero
  have hlip : LipschitzOnWith (2 * M) v (Metric.ball x₀ r) := by
    refine Convex.lipschitzOnWith_of_nnnorm_fderiv_le (fun x _ => hvd x) ?_ (convex_ball x₀ r)
    intro z hz
    rw [← NNReal.coe_le_coe, coe_nnnorm, NNReal.coe_mul, NNReal.coe_ofNat]
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun u => ?_)
    have hu : u = u 0 • (Pi.single 0 1 : Fin 2 → ℝ) + u 1 • (Pi.single 1 1 : Fin 2 → ℝ) := by
      funext i; fin_cases i <;> simp
    have heq : fderiv ℝ v z u = u 0 * smthGrad v z 0 + u 1 * smthGrad v z 1 := by
      conv_lhs => rw [hu]
      simp only [map_add, map_smul, smul_eq_mul, smthGrad]
    have h0 : |u 0| ≤ ‖u‖ := by
      have := norm_le_pi_norm u 0
      rwa [Real.norm_eq_abs] at this
    have h1 : |u 1| ≤ ‖u‖ := by
      have := norm_le_pi_norm u 1
      rwa [Real.norm_eq_abs] at this
    have g0 : |smthGrad v z 0| ≤ M := by
      have := norm_le_pi_norm (smthGrad v z) 0
      rw [Real.norm_eq_abs] at this
      exact this.trans (hbound z hz)
    have g1 : |smthGrad v z 1| ≤ M := by
      have := norm_le_pi_norm (smthGrad v z) 1
      rw [Real.norm_eq_abs] at this
      exact this.trans (hbound z hz)
    rw [heq, Real.norm_eq_abs]
    calc |u 0 * smthGrad v z 0 + u 1 * smthGrad v z 1|
        ≤ |u 0 * smthGrad v z 0| + |u 1 * smthGrad v z 1| := abs_add_le _ _
      _ = |u 0| * |smthGrad v z 0| + |u 1| * |smthGrad v z 1| := by rw [abs_mul, abs_mul]
      _ ≤ ‖u‖ * M + ‖u‖ * M := by gcongr
      _ = 2 * M * ‖u‖ := by ring
  
  set L : NNReal := 1 + 2 * M + C with hL
  have hML : M ≤ L := by
    rw [← NNReal.coe_le_coe, hL]; push_cast
    linarith [NNReal.coe_nonneg M, NNReal.coe_nonneg C]
  have hCL : C ≤ L := by
    rw [← NNReal.coe_le_coe, hL]; push_cast
    linarith [NNReal.coe_nonneg M, NNReal.coe_nonneg C]
  have h1L : (1 : NNReal) ≤ L := by
    rw [← NNReal.coe_le_coe, hL]; push_cast
    linarith [NNReal.coe_nonneg M, NNReal.coe_nonneg C]
  have h2ML : 2 * M ≤ L := by
    rw [← NNReal.coe_le_coe, hL]; push_cast
    linarith [NNReal.coe_nonneg M, NNReal.coe_nonneg C]
  
  have hG : HolderOnWith L β (smthGrad v) (Metric.ball x₀ r) :=
    hdown _ C L α hCL hβα (hhol.mono hBρ)
  have hI : HolderOnWith L β (fun x : Fin 2 → ℝ => x) (Metric.ball x₀ r) :=
    hdown _ 1 L 1 h1L hβ1 (LipschitzWith.id.lipschitzOnWith.holderOnWith)
  have hV : HolderOnWith L β v (Metric.ball x₀ r) :=
    hdown _ (2 * M) L 1 h2ML hβ1 hlip.holderOnWith
  refine ⟨L, fun x hx => (hbound x hx).trans (NNReal.coe_le_coe.2 hML), hG, ?_⟩
  intro x hx y hy
  rw [Prod.edist_eq, Prod.edist_eq]
  exact max_le (hI x hx y hy) (max_le (hV x hx y hy) (hG x hx y hy))

theorem smth_dq_calculus (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (m : Fin 2) (h : ℝ) (hh : h ≠ 0) : ContDiff ℝ 1 (smthDQ v m h) ∧ (∀ x, smthGrad (smthDQ v m h) x = fun j => (smthGrad v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) j - smthGrad v x j) / h) ∧ (∀ x, smthDQ v m h x = ∫ s in (0:ℝ)..1, smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m) ∧ ∀ (T S : Set (Fin 2 → ℝ)) (C β : NNReal), HolderOnWith C β (smthGrad v) T → (∀ x ∈ S, x ∈ T ∧ x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ) ∈ T) → ∃ C₀ : NNReal, HolderOnWith C₀ β (smthGrad (smthDQ v m h)) S :=
by
  have hd : Differentiable ℝ v := hv.differentiable one_ne_zero
  have hdef : smthDQ v m h = fun x =>
      (v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - v x) * h⁻¹ := by
    funext x; simp only [smthDQ, div_eq_mul_inv]
  have hC1 : ContDiff ℝ 1 (smthDQ v m h) := by
    rw [hdef]
    exact ((hv.comp (contDiff_id.add contDiff_const)).sub hv).mul contDiff_const
  have hgrad : ∀ x, smthGrad (smthDQ v m h) x = fun j =>
      (smthGrad v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) j - smthGrad v x j) / h := by
    intro x
    have H1 : HasFDerivAt (fun y => v (y + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)))
        (fderiv ℝ v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) x := by
      have := (hd (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))).hasFDerivAt.comp x
        ((hasFDerivAt_id x).add_const (h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)))
      simpa [Function.comp_def] using this
    have H3 := (H1.sub (hd x).hasFDerivAt).mul_const h⁻¹
    have hF : fderiv ℝ (smthDQ v m h) x =
        h⁻¹ • (fderiv ℝ v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - fderiv ℝ v x) := by
      rw [hdef]; exact H3.fderiv
    funext j
    simp only [smthGrad, hF, ContinuousLinearMap.smul_apply, ContinuousLinearMap.sub_apply,
      smul_eq_mul]
    rw [div_eq_inv_mul]
  have hint : ∀ x, smthDQ v m h x =
      ∫ s in (0:ℝ)..1, smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m := by
    intro x
    have hγ : ∀ s : ℝ, HasDerivAt (fun s : ℝ => x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))
        (h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) s := by
      intro s
      exact ((hasDerivAt_mul_const h).smul_const (Pi.single m (1:ℝ) : Fin 2 → ℝ)).const_add x
    have hf : ∀ s ∈ Set.uIcc (0:ℝ) 1,
        HasDerivAt (fun s : ℝ => v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)))
          (h * smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m) s := by
      intro s _
      have := (hd (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))).hasFDerivAt.comp_hasDerivAt s
        (hγ s)
      convert this using 1
      simp only [smthGrad, ContinuousLinearMap.map_smul, smul_eq_mul]
    have hcont : Continuous
        (fun s : ℝ => h * smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m) := by
      have h1 : Continuous (fun y => smthGrad v y m) :=
        (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
      exact continuous_const.mul (h1.comp (continuous_const.add
        ((continuous_id.mul continuous_const).smul continuous_const)))
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hf (hcont.intervalIntegrable 0 1)
    rw [intervalIntegral.integral_const_mul] at hftc
    simp only [one_mul, zero_mul, zero_smul, add_zero] at hftc
    rw [show smthDQ v m h x = (v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - v x) / h from rfl,
      ← hftc]
    exact mul_div_cancel_left₀ _ hh
  refine ⟨hC1, hgrad, hint, ?_⟩
  intro T S C β hhol hS
  refine ⟨‖h⁻¹‖₊ * (2 * C), ?_⟩
  intro x hx y hy
  have hG : ∀ z, smthGrad (smthDQ v m h) z = h⁻¹ •
      (smthGrad v (z + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - smthGrad v z) := by
    intro z
    rw [hgrad z]
    funext j
    simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    rw [div_eq_inv_mul]
  obtain ⟨hxT, hxuT⟩ := hS x hx
  obtain ⟨hyT, hyuT⟩ := hS y hy
  have h1 := hhol _ hxuT _ hyuT
  have h2 := hhol x hxT y hyT
  rw [edist_add_right] at h1
  rw [hG x, hG y, edist_smul₀, ENNReal.smul_def, smul_eq_mul]
  calc (‖h⁻¹‖₊ : ENNReal) *
        edist (smthGrad v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - smthGrad v x)
          (smthGrad v (y + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - smthGrad v y)
      ≤ (‖h⁻¹‖₊ : ENNReal) *
        (edist (smthGrad v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)))
            (smthGrad v (y + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) +
          edist (smthGrad v x) (smthGrad v y)) := by
        gcongr
        simpa only [sub_eq_add_neg, edist_neg_neg] using edist_add_add_le
          (smthGrad v (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (-smthGrad v x)
          (smthGrad v (y + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (-smthGrad v y)
    _ ≤ (‖h⁻¹‖₊ : ENNReal) * (C * edist x y ^ (β:ℝ) + C * edist x y ^ (β:ℝ)) := by
        gcongr
    _ = ((‖h⁻¹‖₊ * (2 * C) : NNReal) : ENNReal) * edist x y ^ (β:ℝ) := by
        push_cast; ring

theorem smth_ftc_split (Ψ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΨ : ContDiffOn ℝ 1 Ψ O) (z z' : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) (hseg : ∀ s ∈ Set.Icc (0:ℝ) 1, z + s • (z' - z) ∈ O) (h : ℝ) (hh : h ≠ 0) (e₀ : Fin 2 → ℝ) (t : ℝ) (p : Fin 2 → ℝ) (hd : z' - z = h • (e₀, t, p)) : (Ψ z' - Ψ z) / h = (∫ s in (0:ℝ)..1, fderiv ℝ Ψ (z + s • (z' - z)) (e₀, 0, 0)) + t * (∫ s in (0:ℝ)..1, fderiv ℝ Ψ (z + s • (z' - z)) (0, 1, 0)) + ∑ j : Fin 2, p j * ∫ s in (0:ℝ)..1, fderiv ℝ Ψ (z + s • (z' - z)) (0, 0, Pi.single j 1) :=
by
  have hcont : ContinuousOn (fun s : ℝ => fderiv ℝ Ψ (z + s • (z' - z))) (Set.uIcc 0 1) := by
    rw [Set.uIcc_of_le zero_le_one]
    exact (hΨ.continuousOn_fderiv_of_isOpen hO le_rfl).comp
      (continuous_const.add (continuous_id.smul continuous_const)).continuousOn
      (fun s hs => hseg s hs)
  have hint : ∀ V : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      IntervalIntegrable (fun s : ℝ => fderiv ℝ Ψ (z + s • (z' - z)) V) MeasureTheory.volume 0 1 :=
    fun V => (hcont.clm_apply continuousOn_const).intervalIntegrable
  have hftc : (∫ s in (0:ℝ)..1, fderiv ℝ Ψ (z + s • (z' - z)) (z' - z)) = Ψ z' - Ψ z := by
    have key := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun s : ℝ => Ψ (z + s • (z' - z)))
      (f' := fun s : ℝ => fderiv ℝ Ψ (z + s • (z' - z)) (z' - z)) ?_ (hint _)
    · simp only [one_smul, zero_smul, add_zero, add_sub_cancel] at key
      exact key
    · intro s hs
      rw [Set.uIcc_of_le zero_le_one] at hs
      have hγ := hseg s hs
      have hΨd : HasFDerivAt Ψ (fderiv ℝ Ψ (z + s • (z' - z))) (z + s • (z' - z)) :=
        (((hΨ.differentiableOn one_ne_zero) _ hγ).differentiableAt (hO.mem_nhds hγ)).hasFDerivAt
      have hg : HasDerivAt (fun s : ℝ => z + s • (z' - z)) (z' - z) s := by
        simpa using ((hasDerivAt_id s).smul_const (z' - z)).const_add z
      exact hΨd.comp_hasDerivAt s hg
  have hdec : ((e₀, t, p) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
      ((e₀, 0, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) + t • ((0, 1, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        + (p 0 • ((0, 0, Pi.single 0 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
          + p 1 • ((0, 0, Pi.single 1 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) := by
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · simp
    · simp
    · funext i
      fin_cases i <;> simp
  have hpt : ∀ s : ℝ, fderiv ℝ Ψ (z + s • (z' - z)) (z' - z) =
      h * (fderiv ℝ Ψ (z + s • (z' - z)) (e₀, 0, 0)
        + t * fderiv ℝ Ψ (z + s • (z' - z)) (0, 1, 0)
        + (p 0 * fderiv ℝ Ψ (z + s • (z' - z)) (0, 0, Pi.single 0 1)
          + p 1 * fderiv ℝ Ψ (z + s • (z' - z)) (0, 0, Pi.single 1 1))) := by
    intro s
    have e : z' - z = h • (((e₀, 0, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        + t • ((0, 1, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        + (p 0 • ((0, 0, Pi.single 0 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
          + p 1 • ((0, 0, Pi.single 1 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)))) := by
      rw [hd, hdec]
    have e2 : fderiv ℝ Ψ (z + s • (z' - z)) (z' - z) =
        fderiv ℝ Ψ (z + s • (z' - z)) (h • (((e₀, 0, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        + t • ((0, 1, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        + (p 0 • ((0, 0, Pi.single 0 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
          + p 1 • ((0, 0, Pi.single 1 1) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))))) := by
      rw [← e]
    rw [e2]
    simp only [map_smul, map_add, smul_eq_mul]
  have hI := intervalIntegral.integral_congr (a := (0:ℝ)) (b := 1) (μ := MeasureTheory.volume)
    (fun s (_ : s ∈ Set.uIcc (0:ℝ) 1) => hpt s)
  have iA := hint (e₀, 0, 0)
  have iB := (hint (0, 1, 0)).const_mul t
  have iC0 := (hint (0, 0, Pi.single 0 1)).const_mul (p 0)
  have iC1 := (hint (0, 0, Pi.single 1 1)).const_mul (p 1)
  rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add (iA.add iB) (iC0.add iC1),
    intervalIntegral.integral_add iA iB, intervalIntegral.integral_add iC0 iC1,
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
    intervalIntegral.integral_const_mul, hftc] at hI
  rw [Fin.sum_univ_two, hI, mul_div_cancel_left₀ _ hh]

theorem smth_holder_combo (S : Set (Fin 2 → ℝ)) (f₁ f₂ f₃ f₄ : (Fin 2 → ℝ) → ℝ) (t : ℝ) (ht : |t| ≤ 1) (K₁ β : NNReal) (hb : ∀ x ∈ S, |f₁ x| ≤ K₁ ∧ |f₂ x| ≤ K₁ ∧ |f₃ x| ≤ K₁ ∧ |f₄ x| ≤ K₁) (h₁ : HolderOnWith K₁ β f₁ S) (h₂ : HolderOnWith K₁ β f₂ S) (h₃ : HolderOnWith K₁ β f₃ S) (h₄ : HolderOnWith K₁ β f₄ S) : (∀ x ∈ S, |-(f₁ x * f₂ x + f₃ x) + t * f₄ x| ≤ ((2 * K₁ * K₁ + 2 * K₁ : NNReal) : ℝ)) ∧ HolderOnWith (2 * K₁ * K₁ + 2 * K₁) β (fun x => -(f₁ x * f₂ x + f₃ x) + t * f₄ x) S :=
by
  have hk : (0:ℝ) ≤ (K₁:ℝ) := K₁.coe_nonneg
  have hC : ((2 * K₁ * K₁ + 2 * K₁ : NNReal) : ℝ) = 2 * (K₁:ℝ) * K₁ + 2 * K₁ := by
    push_cast; ring
  refine ⟨fun x hx => ?_, ?_⟩
  · obtain ⟨a₁, a₂, a₃, a₄⟩ := hb x hx
    rw [hC]
    have p1 : |f₁ x * f₂ x| ≤ (K₁:ℝ) * K₁ := by
      rw [abs_mul]; exact mul_le_mul a₁ a₂ (abs_nonneg _) hk
    have p2 : |t * f₄ x| ≤ 1 * (K₁:ℝ) := by
      rw [abs_mul]; exact mul_le_mul ht a₄ (abs_nonneg _) zero_le_one
    have t1 := abs_add_le (-(f₁ x * f₂ x + f₃ x)) (t * f₄ x)
    have t2 := abs_add_le (f₁ x * f₂ x) (f₃ x)
    rw [abs_neg] at t1
    nlinarith [mul_nonneg hk hk]
  · intro x hx y hy
    obtain ⟨a₁, a₂, a₃, a₄⟩ := hb x hx
    obtain ⟨b₁, b₂, b₃, b₄⟩ := hb y hy
    have e₁ := h₁.dist_le hx hy
    have e₂ := h₂.dist_le hx hy
    have e₃ := h₃.dist_le hx hy
    have e₄ := h₄.dist_le hx hy
    rw [Real.dist_eq] at e₁ e₂ e₃ e₄
    have hD0 : 0 ≤ dist x y ^ (β:ℝ) := Real.rpow_nonneg dist_nonneg _
    have key : |(-(f₁ x * f₂ x + f₃ x) + t * f₄ x) - (-(f₁ y * f₂ y + f₃ y) + t * f₄ y)|
        ≤ (2 * (K₁:ℝ) * K₁ + 2 * K₁) * dist x y ^ (β:ℝ) := by
      have eq : (-(f₁ x * f₂ x + f₃ x) + t * f₄ x) - (-(f₁ y * f₂ y + f₃ y) + t * f₄ y)
          = (-(f₁ x * (f₂ x - f₂ y) + f₂ y * (f₁ x - f₁ y)) + -(f₃ x - f₃ y))
            + t * (f₄ x - f₄ y) := by ring
      rw [eq]
      have q1 : |f₁ x * (f₂ x - f₂ y)| ≤ (K₁:ℝ) * (K₁ * dist x y ^ (β:ℝ)) := by
        rw [abs_mul]; exact mul_le_mul a₁ e₂ (abs_nonneg _) hk
      have q2 : |f₂ y * (f₁ x - f₁ y)| ≤ (K₁:ℝ) * (K₁ * dist x y ^ (β:ℝ)) := by
        rw [abs_mul]; exact mul_le_mul b₂ e₁ (abs_nonneg _) hk
      have q4 : |t * (f₄ x - f₄ y)| ≤ 1 * ((K₁:ℝ) * dist x y ^ (β:ℝ)) := by
        rw [abs_mul]; exact mul_le_mul ht e₄ (abs_nonneg _) zero_le_one
      have r1 := abs_add_le (-(f₁ x * (f₂ x - f₂ y) + f₂ y * (f₁ x - f₁ y)) + -(f₃ x - f₃ y))
        (t * (f₄ x - f₄ y))
      have r2 := abs_add_le (-(f₁ x * (f₂ x - f₂ y) + f₂ y * (f₁ x - f₁ y))) (-(f₃ x - f₃ y))
      have r3 := abs_add_le (f₁ x * (f₂ x - f₂ y)) (f₂ y * (f₁ x - f₁ y))
      rw [abs_neg, abs_neg] at r2
      nlinarith
    rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg β.coe_nonneg,
      ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg _)]
    apply ENNReal.ofReal_le_ofReal
    rw [Real.dist_eq, hC]
    exact key

theorem smth_dq_weak_eq (U S : Set (Fin 2 → ℝ)) (hU : IsOpen U) (hS : IsOpen S) (P : (Fin 2 → ℝ) → Fin 2 → ℝ) (Q : (Fin 2 → ℝ) → ℝ) (hP : ∀ i : Fin 2, ContinuousOn (fun x => P x i) U) (hQ : ContinuousOn Q U) (heq : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ U → ∫ x, (∑ i : Fin 2, P x i * smthGrad φ x i + Q x * φ x) = 0) (m : Fin 2) (h : ℝ) (hh : h ≠ 0) (hshift : ∀ x ∈ S, ∀ s ∈ Set.Icc (0:ℝ) 1, x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ) ∈ U) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (ha : ∀ i j : Fin 2, ContinuousOn (fun x => a x i j) S) (hw : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad w x j) S) (hF : ∀ i : Fin 2, ContinuousOn (fun x => F x i) S) (hid : ∀ x ∈ S, ∀ i : Fin 2, (P (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) i - P x i) / h = ∑ j : Fin 2, a x i j * smthGrad w x j - F x i + (if i = m then (1:ℝ) else 0) * ∫ s in (0:ℝ)..1, Q (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) : smthLinSol a F w S :=
by
  
  have t_s1 : ∀ (W K : Set (Fin 2 → ℝ)) (f : (Fin 2 → ℝ) → ℝ), IsOpen W → IsCompact K → K ⊆ W →
      ContinuousOn f W → (∀ x, x ∉ K → f x = 0) → Integrable f := by
    intro W K f hW hK hKW hf h0
    have hc : Continuous f := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ W
      · exact hf.continuousAt (hW.mem_nhds hx)
      · have hxK : x ∉ K := fun h => hx (hKW h)
        have hev : f =ᶠ[𝓝 x] fun _ => (0:ℝ) := by
          filter_upwards [hK.isClosed.isOpen_compl.mem_nhds hxK] with y hy
          exact h0 y hy
        exact continuousAt_const.congr hev.symm
    exact hc.integrable_of_hasCompactSupport (HasCompactSupport.intro hK h0)
  
  have t_g0 : ∀ (u : (Fin 2 → ℝ) → ℝ) (x : Fin 2 → ℝ), x ∉ tsupport u →
      ∀ i, smthGrad u x i = 0 := by
    intro u x hx i
    have : fderiv ℝ u x = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hx (tsupport_fderiv_subset ℝ h))
    simp [smthGrad, this]
  have t_gc : ∀ u : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ u → ∀ i,
      Continuous (fun x => smthGrad u x i) := by
    intro u hu i
    exact (hu.continuous_fderiv (by simp)).clm_apply continuous_const
  
  have t_s6 : ∀ (f g : (Fin 2 → ℝ) → ℝ) (c : Fin 2 → ℝ) (t : ℝ),
      Integrable (fun x => f x * g x) → Integrable (fun x => f x * g (x - c)) →
      ∫ x, f x * ((g x - g (x - c)) / t) = -∫ x, (f (x + c) - f x) / t * g x := by
    intro f g c t hf1 hf2
    have htr : ∫ x, f x * g (x - c) = ∫ x, f (x + c) * g x := by
      rw [← integral_add_right_eq_self (fun x => f x * g (x - c)) c]
      simp only [add_sub_cancel_right]
    have hf3 : Integrable (fun x => f (x + c) * g x) := by
      have := hf2.comp_add_right c
      simpa only [add_sub_cancel_right] using this
    have e1 : (fun x => f x * ((g x - g (x - c)) / t)) =
        fun x => (f x * g x - f x * g (x - c)) / t := by
      funext x; ring
    have e2 : (fun x => (f (x + c) - f x) / t * g x) =
        fun x => (f (x + c) * g x - f x * g x) / t := by
      funext x; ring
    rw [e1, e2, integral_div, integral_div, integral_sub hf1 hf2, integral_sub hf3 hf1, htr]
    ring
  
  have t_swap : ∀ (G : ℝ → (Fin 2 → ℝ) → ℝ) (L : Set (Fin 2 → ℝ)), IsCompact L →
      (∀ p : ℝ × (Fin 2 → ℝ), p.1 ∈ Set.Icc (0:ℝ) 1 → ContinuousAt (Function.uncurry G) p) →
      (∀ s ∈ Set.Icc (0:ℝ) 1, ∀ x, x ∉ L → G s x = 0) →
      ∫ x, (∫ s in (0:ℝ)..1, G s x) = ∫ s in (0:ℝ)..1, ∫ x, G s x := by
    intro G L hL hc h0
    simp only [intervalIntegral.integral_of_le zero_le_one]
    have hcont : ContinuousOn (Function.uncurry G) (Set.Icc (0:ℝ) 1 ×ˢ L) :=
      fun p hp => (hc p hp.1).continuousWithinAt
    have h1 : IntegrableOn (Function.uncurry G) (Set.Icc (0:ℝ) 1 ×ˢ L) :=
      hcont.integrableOn_compact (isCompact_Icc.prod hL)
    have h2 : IntegrableOn (Function.uncurry G)
        (Set.Icc (0:ℝ) 1 ×ˢ (Set.univ : Set (Fin 2 → ℝ))) := by
      refine h1.of_forall_diff_eq_zero (measurableSet_Icc.prod MeasurableSet.univ) ?_
      rintro ⟨s, x⟩ ⟨⟨hs, -⟩, hn⟩
      have hx : x ∉ L := fun hx => hn ⟨hs, hx⟩
      exact h0 s hs x hx
    have h3 : IntegrableOn (Function.uncurry G)
        (Set.Ioc (0:ℝ) 1 ×ˢ (Set.univ : Set (Fin 2 → ℝ))) :=
      h2.mono_set (Set.prod_mono Set.Ioc_subset_Icc_self subset_rfl)
    have hmeas : (volume.restrict (Set.Ioc (0:ℝ) 1)).prod (volume : Measure (Fin 2 → ℝ)) =
        (volume : Measure (ℝ × (Fin 2 → ℝ))).restrict (Set.Ioc (0:ℝ) 1 ×ˢ Set.univ) := by
      rw [Measure.volume_eq_prod, ← Measure.prod_restrict, Measure.restrict_univ]
    have hint : Integrable (Function.uncurry G)
        ((volume.restrict (Set.Ioc (0:ℝ) 1)).prod volume) := by
      rw [hmeas]; exact h3
    exact (integral_integral_swap hint).symm
  
  have t_s2 : ∀ (f : (Fin 2 → ℝ) → ℝ), ContDiff ℝ ∞ f → HasCompactSupport f →
      ∀ (c : Fin 2 → ℝ) (t : ℝ),
      ContDiff ℝ ∞ (fun y => (f y - f (y - c)) / t) ∧
      HasCompactSupport (fun y => (f y - f (y - c)) / t) ∧
      tsupport (fun y => (f y - f (y - c)) / t) ⊆ tsupport f ∪ (fun x => x + c) '' tsupport f ∧
      ∀ y i, smthGrad (fun y => (f y - f (y - c)) / t) y i =
        (smthGrad f y i - smthGrad f (y - c) i) / t := by
    intro f hf hfc c t
    have hA : IsCompact (tsupport f ∪ (fun x => x + c) '' tsupport f) :=
      hfc.isCompact.union (hfc.isCompact.image (continuous_add_right c))
    have hsupp : ∀ y, y ∉ tsupport f ∪ (fun x => x + c) '' tsupport f →
        (f y - f (y - c)) / t = 0 := by
      intro y hy
      have h1 : f y = 0 := image_eq_zero_of_notMem_tsupport (fun hh => hy (Or.inl hh))
      have h2 : f (y - c) = 0 :=
        image_eq_zero_of_notMem_tsupport (fun hh => hy (Or.inr ⟨y - c, hh, sub_add_cancel y c⟩))
      rw [h1, h2]; simp
    have hfd : Differentiable ℝ f := hf.differentiable (by simp)
    refine ⟨(hf.sub (hf.comp (contDiff_id.sub contDiff_const))).div_const t,
      HasCompactSupport.intro hA hsupp, ?_, ?_⟩
    · refine closure_minimal ?_ hA.isClosed
      intro y hy
      by_contra hn
      exact hy (hsupp y hn)
    · intro y i
      have h1 : HasFDerivAt (fun y => f (y - c)) (fderiv ℝ f (y - c)) y := by
        have := (hfd (y - c)).hasFDerivAt.comp y ((hasFDerivAt_id y).sub_const c)
        simpa using this
      have h2 : HasFDerivAt (fun y => (f y - f (y - c)) / t)
          (t⁻¹ • (fderiv ℝ f y - fderiv ℝ f (y - c))) y := by
        have := ((hfd y).hasFDerivAt.sub h1).const_smul t⁻¹
        convert this using 1
        funext z; simp [smul_eq_mul, div_eq_inv_mul]
      simp only [smthGrad, h2.fderiv, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.sub_apply, smul_eq_mul]
      ring
  intro φ hφ hφc hφS
  have hseg : ∀ x ∈ tsupport φ, ∀ s ∈ Set.Icc (0:ℝ) 1,
      x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ) ∈ U :=
    fun x hx s hs => hshift x (hφS hx) s hs
  
  have hs5 : ∫ x, Q x * ((φ x - φ (x - h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) / h) =
      ∫ x, (∫ s in (0:ℝ)..1, Q (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) *
        smthGrad φ x m := by
    obtain ⟨em, hem⟩ : ∃ em : Fin 2 → ℝ, em = (Pi.single m (1:ℝ) : Fin 2 → ℝ) := ⟨_, rfl⟩
    rw [← hem] at hseg ⊢
    have hD : Continuous (fun x => smthGrad φ x m) := t_gc φ hφ m
    have hD0 : ∀ x, x ∉ tsupport φ → smthGrad φ x m = 0 := fun x hx => t_g0 φ x hx m
    have hφd : Differentiable ℝ φ := hφ.differentiable (by simp)
    
    have hftc : ∀ y, ∫ s in (0:ℝ)..1, smthGrad φ (y - (s * h) • em) m =
        (φ y - φ (y - h • em)) / h := by
      intro y
      have hder : ∀ s ∈ Set.uIcc (0:ℝ) 1, HasDerivAt (fun s : ℝ => φ (y - (s * h) • em))
          (-h * smthGrad φ (y - (s * h) • em) m) s := by
        intro s _
        have hγ : HasDerivAt (fun s : ℝ => y - (s * h) • em) (-((1 * h) • em)) s :=
          (((hasDerivAt_id s).mul_const h).smul_const em).const_sub y
        have := (hφd (y - (s * h) • em)).hasFDerivAt.comp_hasDerivAt s hγ
        convert this using 1
        simp only [smthGrad, ← hem, map_neg, map_smul, one_mul, smul_eq_mul]
        ring
      have hint : IntervalIntegrable (fun s : ℝ => -h * smthGrad φ (y - (s * h) • em) m)
          volume 0 1 := by
        apply Continuous.intervalIntegrable
        exact continuous_const.mul (hD.comp (continuous_const.sub
          ((continuous_id.mul continuous_const).smul continuous_const)))
      have key := intervalIntegral.integral_eq_sub_of_hasDerivAt hder hint
      rw [intervalIntegral.integral_const_mul] at key
      simp only [one_mul, zero_mul, zero_smul, sub_zero] at key
      field_simp
      linarith
    
    have hc1 : ∀ p : ℝ × (Fin 2 → ℝ), p.1 ∈ Set.Icc (0:ℝ) 1 →
        ContinuousAt (Function.uncurry (fun s x => Q (x + (s * h) • em) * smthGrad φ x m)) p := by
      rintro ⟨s₀, x₀⟩ hs₀
      by_cases hx₀ : x₀ ∈ tsupport φ
      · have hQc : ContinuousAt Q (x₀ + (s₀ * h) • em) :=
          hQ.continuousAt (hU.mem_nhds (hseg x₀ hx₀ s₀ hs₀))
        have hmap : Continuous (fun p : ℝ × (Fin 2 → ℝ) => p.2 + (p.1 * h) • em) := by fun_prop
        exact (hQc.comp_of_eq hmap.continuousAt rfl).mul (hD.comp continuous_snd).continuousAt
      · have hopen : IsOpen {p : ℝ × (Fin 2 → ℝ) | p.2 ∈ (tsupport φ)ᶜ} :=
          (isClosed_tsupport φ).isOpen_compl.preimage continuous_snd
        refine (continuousAt_const : ContinuousAt (fun _ : ℝ × (Fin 2 → ℝ) => (0:ℝ)) _).congr ?_
        filter_upwards [hopen.mem_nhds (show (s₀, x₀) ∈ {p : ℝ × (Fin 2 → ℝ) | p.2 ∈ (tsupport φ)ᶜ}
          from hx₀)] with p hp
        show (0:ℝ) = Q (p.2 + (p.1 * h) • em) * smthGrad φ p.2 m
        rw [hD0 _ hp, mul_zero]
    have hz1 : ∀ s ∈ Set.Icc (0:ℝ) 1, ∀ x, x ∉ tsupport φ →
        Q (x + (s * h) • em) * smthGrad φ x m = 0 := by
      intro s _ x hx; rw [hD0 x hx, mul_zero]
    
    have hc2 : ∀ p : ℝ × (Fin 2 → ℝ), p.1 ∈ Set.Icc (0:ℝ) 1 →
        ContinuousAt (Function.uncurry (fun s y => Q y * smthGrad φ (y - (s * h) • em) m)) p := by
      rintro ⟨s₀, y₀⟩ hs₀
      have hmap : Continuous (fun p : ℝ × (Fin 2 → ℝ) => p.2 - (p.1 * h) • em) := by fun_prop
      by_cases hz : y₀ - (s₀ * h) • em ∈ tsupport φ
      · have hy : y₀ ∈ U := by
          have := hseg _ hz s₀ hs₀
          rwa [sub_add_cancel] at this
        have hQc : ContinuousAt Q y₀ := hQ.continuousAt (hU.mem_nhds hy)
        exact (hQc.comp_of_eq continuous_snd.continuousAt rfl).mul (hD.comp hmap).continuousAt
      · have hopen : IsOpen {p : ℝ × (Fin 2 → ℝ) | p.2 - (p.1 * h) • em ∈ (tsupport φ)ᶜ} :=
          (isClosed_tsupport φ).isOpen_compl.preimage hmap
        refine (continuousAt_const : ContinuousAt (fun _ : ℝ × (Fin 2 → ℝ) => (0:ℝ)) _).congr ?_
        filter_upwards [hopen.mem_nhds (show (s₀, y₀) ∈
          {p : ℝ × (Fin 2 → ℝ) | p.2 - (p.1 * h) • em ∈ (tsupport φ)ᶜ} from hz)] with p hp
        show (0:ℝ) = Q p.2 * smthGrad φ (p.2 - (p.1 * h) • em) m
        rw [hD0 _ hp, mul_zero]
    have hL2 : IsCompact ((fun p : ℝ × (Fin 2 → ℝ) => p.2 + (p.1 * h) • em) ''
        (Set.Icc (0:ℝ) 1 ×ˢ tsupport φ)) :=
      (isCompact_Icc.prod hφc.isCompact).image (by fun_prop)
    have hz2 : ∀ s ∈ Set.Icc (0:ℝ) 1, ∀ y,
        y ∉ (fun p : ℝ × (Fin 2 → ℝ) => p.2 + (p.1 * h) • em) '' (Set.Icc (0:ℝ) 1 ×ˢ tsupport φ) →
        Q y * smthGrad φ (y - (s * h) • em) m = 0 := by
      intro s hs y hy
      have : y - (s * h) • em ∉ tsupport φ :=
        fun hz => hy ⟨(s, y - (s * h) • em), ⟨hs, hz⟩, sub_add_cancel y _⟩
      rw [hD0 _ this, mul_zero]
    
    have hsw1 := t_swap (fun s x => Q (x + (s * h) • em) * smthGrad φ x m) (tsupport φ)
      hφc.isCompact hc1 hz1
    have hsw2 := t_swap (fun s y => Q y * smthGrad φ (y - (s * h) • em) m) _ hL2 hc2 hz2
    have htr : ∀ s : ℝ, ∫ y, Q y * smthGrad φ (y - (s * h) • em) m =
        ∫ x, Q (x + (s * h) • em) * smthGrad φ x m := by
      intro s
      rw [← integral_add_right_eq_self (fun y => Q y * smthGrad φ (y - (s * h) • em) m)
        ((s * h) • em)]
      simp only [add_sub_cancel_right]
    calc ∫ x, Q x * ((φ x - φ (x - h • em)) / h)
        = ∫ y, ∫ s in (0:ℝ)..1, Q y * smthGrad φ (y - (s * h) • em) m := by
          congr 1; funext y
          rw [intervalIntegral.integral_const_mul, hftc y]
      _ = ∫ s in (0:ℝ)..1, ∫ y, Q y * smthGrad φ (y - (s * h) • em) m := hsw2
      _ = ∫ s in (0:ℝ)..1, ∫ x, Q (x + (s * h) • em) * smthGrad φ x m := by
          congr 1; funext s; exact htr s
      _ = ∫ x, ∫ s in (0:ℝ)..1, Q (x + (s * h) • em) * smthGrad φ x m := hsw1.symm
      _ = _ := by
          congr 1; funext x
          rw [intervalIntegral.integral_mul_const]
  obtain ⟨em, hem⟩ : ∃ em : Fin 2 → ℝ, em = (Pi.single m (1:ℝ) : Fin 2 → ℝ) := ⟨_, rfl⟩
  rw [← hem] at hshift hid hs5
  
  have hSU0 : S ⊆ U := by
    intro x hx; have := hshift x hx 0 ⟨le_rfl, zero_le_one⟩; simpa using this
  have hSU1 : ∀ x ∈ S, x + h • em ∈ U := by
    intro x hx; have := hshift x hx 1 ⟨zero_le_one, le_rfl⟩; simpa using this
  have hK : IsCompact (tsupport φ) := hφc.isCompact
  have hKU : tsupport φ ⊆ U := hφS.trans hSU0
  have hKcU : (fun x => x + h • em) '' tsupport φ ⊆ U := by
    rintro _ ⟨x, hx, rfl⟩; exact hSU1 x (hφS hx)
  have hKc : IsCompact ((fun x => x + h • em) '' tsupport φ) :=
    hK.image (continuous_add_right _)
  
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : (Fin 2 → ℝ) → ℝ, ψ = fun y => (φ y - φ (y - h • em)) / h :=
    ⟨_, rfl⟩
  obtain ⟨hψ, hψc, hψsupp, hψgrad⟩ := t_s2 φ hφ hφc (h • em) h
  rw [← hψdef] at hψ hψc hψsupp hψgrad
  have hψU : tsupport ψ ⊆ U := hψsupp.trans (Set.union_subset hKU hKcU)
  have hDφ : ∀ i, Continuous (fun x => smthGrad φ x i) := t_gc φ hφ
  have hDψ : ∀ i, Continuous (fun x => smthGrad ψ x i) := t_gc ψ hψ
  have hφ0 : ∀ x, x ∉ tsupport φ → ∀ i, smthGrad φ x i = 0 := t_g0 φ
  have hψ0 : ∀ x, x ∉ tsupport ψ → ∀ i, smthGrad ψ x i = 0 := t_g0 ψ
  
  have I1 : ∀ i, Integrable (fun x => P x i * smthGrad ψ x i) := fun i =>
    t_s1 U (tsupport ψ) _ hU hψc hψU ((hP i).mul (hDψ i).continuousOn)
      (fun x hx => by rw [hψ0 x hx i, mul_zero])
  have I2 : Integrable (fun x => Q x * ψ x) :=
    t_s1 U (tsupport ψ) _ hU hψc hψU (hQ.mul hψ.continuous.continuousOn)
      (fun x hx => by rw [image_eq_zero_of_notMem_tsupport hx, mul_zero])
  have I3 : ∀ i, Integrable (fun x => P x i * smthGrad φ x i) := fun i =>
    t_s1 U (tsupport φ) _ hU hK hKU ((hP i).mul (hDφ i).continuousOn)
      (fun x hx => by rw [hφ0 x hx i, mul_zero])
  have I4 : ∀ i, Integrable (fun x => P x i * smthGrad φ (x - h • em) i) := fun i =>
    t_s1 U _ _ hU hKc hKcU
      ((hP i).mul ((hDφ i).comp (continuous_id.sub continuous_const)).continuousOn)
      (fun x hx => by
        have : x - h • em ∉ tsupport φ := fun hz => hx ⟨x - h • em, hz, sub_add_cancel x _⟩
        rw [hφ0 _ this i, mul_zero])
  have hPc : ∀ i, ContinuousOn (fun x => P (x + h • em) i) S := fun i =>
    (hP i).comp (continuousOn_id.add continuousOn_const) (fun x hx => hSU1 x hx)
  have I7 : ∀ i, Integrable (fun x => (P (x + h • em) i - P x i) / h * smthGrad φ x i) :=
    fun i => t_s1 S (tsupport φ) _ hS hK hφS
      ((((hPc i).sub ((hP i).mono hSU0)).div_const h).mul (hDφ i).continuousOn)
      (fun x hx => by rw [hφ0 x hx i, mul_zero])
  have IA : Integrable
      (fun x => ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i) := by
    refine t_s1 S (tsupport φ) _ hS hK hφS ?_ ?_
    · exact continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _
        (fun j _ => ((ha i j).mul (hw j)).mul (hDφ i).continuousOn))
    · intro x hx; simp [hφ0 x hx]
  have IB : Integrable (fun x => ∑ i : Fin 2, F x i * smthGrad φ x i) := by
    refine t_s1 S (tsupport φ) _ hS hK hφS ?_ ?_
    · exact continuousOn_finset_sum _ (fun i _ => (hF i).mul (hDφ i).continuousOn)
    · intro x hx; simp [hφ0 x hx]
  
  have hPi : ∀ i, ∫ x, P x i * smthGrad ψ x i =
      -∫ x, (P (x + h • em) i - P x i) / h * smthGrad φ x i := by
    intro i
    have h6 := t_s6 (fun x => P x i) (fun x => smthGrad φ x i) (h • em) h (I3 i) (I4 i)
    refine Eq.trans ?_ h6
    congr 1; funext x
    beta_reduce
    rw [hψgrad]
  have hQψ : ∫ x, Q x * ψ x =
      ∫ x, (∫ s in (0:ℝ)..1, Q (x + (s * h) • em)) * smthGrad φ x m := by
    rw [hψdef]; exact hs5
  have E1 := heq ψ hψ hψc hψU
  have I1s : Integrable (fun x => P x 0 * smthGrad ψ x 0 + P x 1 * smthGrad ψ x 1) :=
    (I1 0).add (I1 1)
  simp only [Fin.sum_univ_two] at E1
  rw [integral_add I1s I2, integral_add (I1 0) (I1 1), hPi 0, hPi 1, hQψ] at E1
  
  have E3 : ∀ x, (∫ s in (0:ℝ)..1, Q (x + (s * h) • em)) * smthGrad φ x m =
      ((P (x + h • em) 0 - P x 0) / h * smthGrad φ x 0 +
        (P (x + h • em) 1 - P x 1) / h * smthGrad φ x 1)
      - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i)
      + ∑ i : Fin 2, F x i * smthGrad φ x i := by
    intro x
    by_cases hx : x ∈ S
    · rw [hid x hx 0, hid x hx 1]
      simp only [Fin.sum_univ_two]
      rcases (show m = 0 ∨ m = 1 by fin_cases m <;> simp) with rfl | rfl
      · rw [if_pos rfl, if_neg (by decide : ¬ (1:Fin 2) = 0)]; ring
      · rw [if_neg (by decide : ¬ (0:Fin 2) = 1), if_pos rfl]; ring
    · have hxK : x ∉ tsupport φ := fun h' => hx (hφS h')
      simp [hφ0 x hxK]
  
  have I7s : Integrable (fun x => (P (x + h • em) 0 - P x 0) / h * smthGrad φ x 0 +
      (P (x + h • em) 1 - P x 1) / h * smthGrad φ x 1) := (I7 0).add (I7 1)
  have I7sA : Integrable (fun x => ((P (x + h • em) 0 - P x 0) / h * smthGrad φ x 0 +
      (P (x + h • em) 1 - P x 1) / h * smthGrad φ x 1)
      - (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i)) := I7s.sub IA
  have hJ : ∫ x, (∫ s in (0:ℝ)..1, Q (x + (s * h) • em)) * smthGrad φ x m =
      ((∫ x, (P (x + h • em) 0 - P x 0) / h * smthGrad φ x 0) +
        ∫ x, (P (x + h • em) 1 - P x 1) / h * smthGrad φ x 1)
      - (∫ x, ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i)
      + ∫ x, ∑ i : Fin 2, F x i * smthGrad φ x i := by
    rw [show (fun x => (∫ s in (0:ℝ)..1, Q (x + (s * h) • em)) * smthGrad φ x m) = _ from
      funext E3]
    rw [integral_add I7sA IB, integral_sub I7s IA, integral_add (I7 0) (I7 1)]
  linarith

theorem smth_dq_nonlinear_eq (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (hell : ∀ w ∈ O, ∀ q : Fin 2 → ℝ, q ≠ 0 → 0 < fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, q)) w (0, 0, q)) (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (hvO : ∀ x ∈ D, (x, v x, smthGrad v x) ∈ O) (hEL : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0) (x₀ : Fin 2 → ℝ) (ρ : ℝ) (C α : NNReal) (hρ : 0 < ρ) (hα : 0 < α) (hball : Metric.ball x₀ ρ ⊆ D) (hhol : HolderOnWith C α (smthGrad v) (Metric.ball x₀ ρ)) : ∃ (R h₀ lam : ℝ) (K β : NNReal), 0 < R ∧ 0 < h₀ ∧ h₀ ≤ R ∧ 0 < lam ∧ 0 < β ∧ β < 1 ∧ 2 * R ≤ ρ ∧ ∀ (m : Fin 2) (h : ℝ), 0 < |h| → |h| < h₀ → ∃ (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ), smthSchauderData lam K β a F (smthDQ v m h) (Metric.ball x₀ R) :=
by
  
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hΛ1 : ContDiffOn ℝ ∞ (fderiv ℝ Λ) O := hΛ.fderiv_of_isOpen hO le_rfl
  have hA1 : ∀ i : Fin 2, ContDiffOn ℝ 1 (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) O :=
    fun i => (hΛ1.clm_apply contDiffOn_const).of_le h1inf
  
  obtain ⟨β, hβdef⟩ : ∃ β : NNReal, β = min α (1 / 2) := ⟨_, rfl⟩
  have hβ0 : 0 < β := by rw [hβdef]; exact lt_min hα (by norm_num)
  have hβ1 : β < 1 := by rw [hβdef]; exact (min_le_right _ _).trans_lt (by norm_num)
  have hβα : β ≤ α := by rw [hβdef]; exact min_le_left _ _
  
  obtain ⟨X, hXdef⟩ : ∃ X : (Fin 2 → ℝ) → (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      ∀ y, X y = (y, v y, smthGrad v y) := ⟨_, fun _ => rfl⟩
  have hXeq : X = fun y => ((y, v y, smthGrad v y) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) :=
    funext hXdef
  have hgc : Continuous (smthGrad v) :=
    continuous_pi fun k => (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hXc : Continuous X := by
    rw [hXeq]; exact continuous_id.prodMk (hv.continuous.prodMk hgc)
  have hx₀D : x₀ ∈ D := hball (Metric.mem_ball_self hρ)
  have hz₀ : X x₀ ∈ O := by rw [hXdef]; exact hvO x₀ hx₀D
  
  obtain ⟨r, lam0, L, hr, hlam0, hBO, hM₀, hclose, hLA, hLΛ, hBΛ⟩ :=
    smth_local_coeff_ball Λ O hO hΛ hell (X x₀) hz₀
  
  obtain ⟨δ, hδ, hδX⟩ := Metric.continuousAt_iff.1 hXc.continuousAt r hr
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = min (ρ / 2) (min (δ / 2) (1 / 4)) := ⟨_, rfl⟩
  have hm1 := min_le_left (ρ / 2) (min (δ / 2) (1 / 4))
  have hm2 := min_le_right (ρ / 2) (min (δ / 2) (1 / 4))
  have hm3 := min_le_left (δ / 2) (1 / 4 : ℝ)
  have hm4 := min_le_right (δ / 2) (1 / 4 : ℝ)
  have hR0 : 0 < R := by
    rw [hRdef]; exact lt_min (by linarith) (lt_min (by linarith) (by norm_num))
  have hRρ : 2 * R ≤ ρ := by rw [hRdef]; linarith
  have hRδ : 2 * R ≤ δ := by rw [hRdef]; linarith
  have hR4 : 2 * R ≤ 1 / 2 := by rw [hRdef]; linarith
  have hTD : Metric.ball x₀ (2 * R) ⊆ D := (Metric.ball_subset_ball hRρ).trans hball
  have hXT : ∀ y ∈ Metric.ball x₀ (2 * R), X y ∈ Metric.ball (X x₀) r := by
    intro y hy
    exact Metric.mem_ball.2 (hδX (lt_of_lt_of_le (Metric.mem_ball.1 hy) hRδ))
  have hnorm_e : ∀ m : Fin 2, ‖(Pi.single m (1:ℝ) : Fin 2 → ℝ)‖ = 1 := by
    intro m; rw [Pi.norm_single, norm_one]
  have geo : ∀ (m : Fin 2) (h : ℝ), |h| < R → ∀ x ∈ Metric.ball x₀ R, ∀ s ∈ Set.Icc (0:ℝ) 1,
      x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ) ∈ Metric.ball x₀ (2 * R) := by
    intro m h hh x hx s hs
    rw [Metric.mem_ball] at hx ⊢
    have h1 : ‖(s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)‖ ≤ |h| := by
      rw [norm_smul, hnorm_e, mul_one, Real.norm_eq_abs, abs_mul, abs_of_nonneg hs.1]
      exact mul_le_of_le_one_left (abs_nonneg h) hs.2
    have h2 : dist (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) x =
        ‖(s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)‖ := by
      rw [dist_eq_norm, add_sub_cancel_left]
    have h3 := dist_triangle (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) x x₀
    linarith
  
  obtain ⟨Lv, hLvb, hgH, hXH'⟩ :=
    smth_graph_holder v hv x₀ ρ C α β hρ hhol hβα hβ1.le (2 * R) (by linarith) hRρ hR4
  have hXH : HolderOnWith Lv β X (Metric.ball x₀ (2 * R)) := by rw [hXeq]; exact hXH'
  
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : NNReal, K₁ = max (max L (L * Lv)) Lv := ⟨_, rfl⟩
  have hLK₁ : L ≤ K₁ := by rw [hK₁]; exact (le_max_left _ _).trans (le_max_left _ _)
  have hLLvK₁ : L * Lv ≤ K₁ := by rw [hK₁]; exact (le_max_right _ _).trans (le_max_left _ _)
  have hLvK₁ : Lv ≤ K₁ := by rw [hK₁]; exact le_max_right _ _
  have hK₁K : K₁ ≤ 2 * K₁ * K₁ + 2 * K₁ := by
    have : K₁ ≤ 2 * K₁ := le_mul_of_one_le_left (zero_le _) (by norm_num)
    exact this.trans le_add_self
  have hLK₁r : (L : ℝ) ≤ K₁ := NNReal.coe_le_coe.2 hLK₁
  have hLvK₁r : (Lv : ℝ) ≤ K₁ := NNReal.coe_le_coe.2 hLvK₁
  have hK₁Kr : (K₁ : ℝ) ≤ ((2 * K₁ * K₁ + 2 * K₁ : NNReal) : ℝ) := NNReal.coe_le_coe.2 hK₁K
  have hmono : ∀ {Y : Type} [PseudoEMetricSpace Y] (f : (Fin 2 → ℝ) → Y)
      (S : Set (Fin 2 → ℝ)) (K K' : NNReal), K ≤ K' → HolderOnWith K β f S →
      HolderOnWith K' β f S := by
    intro Y _ f S K K' hKK hf x hx y hy
    exact (hf x hx y hy).trans (mul_le_mul_right' (ENNReal.coe_le_coe.2 hKK) _)
  have hpi : ∀ {Y : Type} [PseudoEMetricSpace Y] (f : (Fin 2 → ℝ) → Fin 2 → Y)
      (S : Set (Fin 2 → ℝ)) (K : NNReal), (∀ i, HolderOnWith K β (fun x => f x i) S) →
      HolderOnWith K β f S := by
    intro Y _ f S K hf x hx y hy
    exact edist_pi_le_iff.2 fun i => hf i x hx y hy
  have hVn : ∀ (p : Fin 2 → ℝ) (t : ℝ) (q : Fin 2 → ℝ), ‖p‖ ≤ 1 → ‖t‖ ≤ 1 → ‖q‖ ≤ 1 →
      ‖((p, t, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ ≤ 1 := by
    intro p t q hp ht hq
    exact norm_prod_le_iff.2 ⟨hp, norm_prod_le_iff.2 ⟨ht, hq⟩⟩
  have hdec : ∀ (a : Fin 2 → ℝ) (t : ℝ) (p : Fin 2 → ℝ),
      ((a, t, p) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        (a, (0 : ℝ), (0 : Fin 2 → ℝ)) + t • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) +
          (p 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
            p 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
    intro a t p
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · funext i; simp
    · simp
    · funext i; fin_cases i <;> simp
  refine ⟨R, R, lam0 / 2, 2 * K₁ * K₁ + 2 * K₁, β, hR0, hR0, le_rfl, by linarith, hβ0, hβ1,
    hRρ, ?_⟩
  
  intro m h hh0 hhR
  have hh : h ≠ 0 := abs_pos.1 hh0
  have hgeo := geo m h hhR
  have hS0 : ∀ x ∈ Metric.ball x₀ R, x ∈ Metric.ball x₀ (2 * R) := by
    intro x hx
    have := hgeo x hx 0 ⟨le_rfl, zero_le_one⟩
    simpa using this
  have hS1 : ∀ x ∈ Metric.ball x₀ R,
      x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ) ∈ Metric.ball x₀ (2 * R) := by
    intro x hx
    have := hgeo x hx 1 ⟨zero_le_one, le_rfl⟩
    simpa using this
  obtain ⟨hwC1, hwgrad, hwint, hwhol⟩ := smth_dq_calculus v hv m h hh
  
  have hZB : ∀ s ∈ Set.Icc (0:ℝ) 1, ∀ x ∈ Metric.ball x₀ R,
      X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x) ∈
        Metric.closedBall (X x₀) r := by
    intro s hs x hx
    exact Metric.ball_subset_closedBall ((convex_ball (X x₀) r).add_smul_sub_mem
      (hXT x (hS0 x hx)) (hXT _ (hS1 x hx)) hs)
  have hZH : ∀ s ∈ Set.Icc (0:ℝ) 1, HolderOnWith Lv β
      (fun x => X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x))
      (Metric.ball x₀ R) := by
    intro s hs
    exact (smth_shift_holder X (Metric.ball x₀ (2 * R)) (Metric.ball x₀ R) Lv β hXH
      (h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) (fun x hx => ⟨hS0 x hx, hS1 x hx⟩)).2 s hs.1 hs.2
  have hZc : ∀ x ∈ Metric.ball x₀ R, ContinuousOn
      (fun s : ℝ => X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x))
      (Set.Icc 0 1) := by
    intro x _
    exact (continuous_const.add (continuous_id.smul continuous_const)).continuousOn
  have hZ'B : ∀ s ∈ Set.Icc (0:ℝ) 1, ∀ x ∈ Metric.ball x₀ R,
      X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) ∈ Metric.closedBall (X x₀) r :=
    fun s hs x hx => Metric.ball_subset_closedBall (hXT _ (hgeo x hx s hs))
  have hZ'H : ∀ s ∈ Set.Icc (0:ℝ) 1, HolderOnWith Lv β
      (fun x => X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (Metric.ball x₀ R) :=
    fun s hs => (smth_shift_holder X (Metric.ball x₀ (2 * R)) (Metric.ball x₀ R) Lv β hXH
      ((s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) (fun x hx => ⟨hS0 x hx, hgeo x hx s hs⟩)).1
  have hZ'c : ∀ x ∈ Metric.ball x₀ R, ContinuousOn
      (fun s : ℝ => X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (Set.Icc 0 1) :=
    fun x _ => (hXc.comp (continuous_const.add
      ((continuous_id.mul continuous_const).smul continuous_const))).continuousOn
  
  obtain ⟨a, ha⟩ : ∃ a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ, ∀ x i j, a x i j =
      ∫ s in (0:ℝ)..1, fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
        (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) (0, 0, Pi.single j 1) :=
    ⟨_, fun _ _ _ => rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ x i, b x i =
      ∫ s in (0:ℝ)..1, fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
        (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) (0, 1, 0) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ x i, c x i =
      ∫ s in (0:ℝ)..1, fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
        (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x))
        ((Pi.single m (1:ℝ) : Fin 2 → ℝ), 0, 0) :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : (Fin 2 → ℝ) → ℝ, ∀ x, G x =
      ∫ s in (0:ℝ)..1, fderiv ℝ Λ (X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (0, 1, 0) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ x i, F x i =
      -(b x i * smthDQ v m h x + c x i) + (if i = m then (1:ℝ) else 0) * G x :=
    ⟨_, fun _ _ => rfl⟩
  
  have hsa := fun i j : Fin 2 => smth_avg_lip_comp
    (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) (Metric.closedBall (X x₀) r) L
    (hLA i).1 (hLA i).2 (Metric.ball x₀ R)
    (fun s x => X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) Lv β hZH hZB hZc
    (0, 0, Pi.single j 1) (hVn _ _ _ (by simp) (by simp) (hnorm_e j).le)
  have hsb := fun i : Fin 2 => smth_avg_lip_comp
    (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) (Metric.closedBall (X x₀) r) L
    (hLA i).1 (hLA i).2 (Metric.ball x₀ R)
    (fun s x => X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) Lv β hZH hZB hZc
    (0, 1, 0) (hVn _ _ _ (by simp) (by simp) (by simp))
  have hsc := fun i : Fin 2 => smth_avg_lip_comp
    (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))) (Metric.closedBall (X x₀) r) L
    (hLA i).1 (hLA i).2 (Metric.ball x₀ R)
    (fun s x => X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) Lv β hZH hZB hZc
    ((Pi.single m (1:ℝ) : Fin 2 → ℝ), 0, 0) (hVn _ _ _ (hnorm_e m).le (by simp) (by simp))
  have hsG := smth_avg_lip_comp (fderiv ℝ Λ) (Metric.closedBall (X x₀) r) L hLΛ hBΛ
    (Metric.ball x₀ R) (fun s x => X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) Lv β
    hZ'H hZ'B hZ'c (0, 1, 0) (hVn _ _ _ (by simp) (by simp) (by simp))
  have hAH : ∀ i j : Fin 2, HolderOnWith K₁ β (fun x => a x i j) (Metric.ball x₀ R) := by
    intro i j
    have e1 : (fun x => a x i j) = fun x => ∫ s in (0:ℝ)..1,
        fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
          (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) (0, 0, Pi.single j 1) :=
      funext fun x => ha x i j
    rw [e1]
    exact hmono _ _ _ _ hLLvK₁ (hsa i j).2.2
  have hbH : ∀ i : Fin 2, HolderOnWith K₁ β (fun x => b x i) (Metric.ball x₀ R) := by
    intro i
    have e1 : (fun x => b x i) = fun x => ∫ s in (0:ℝ)..1,
        fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
          (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x)) (0, 1, 0) :=
      funext fun x => hb x i
    rw [e1]
    exact hmono _ _ _ _ hLLvK₁ (hsb i).2.2
  have hcH : ∀ i : Fin 2, HolderOnWith K₁ β (fun x => c x i) (Metric.ball x₀ R) := by
    intro i
    have e1 : (fun x => c x i) = fun x => ∫ s in (0:ℝ)..1,
        fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
          (X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x))
          ((Pi.single m (1:ℝ) : Fin 2 → ℝ), 0, 0) :=
      funext fun x => hc x i
    rw [e1]
    exact hmono _ _ _ _ hLLvK₁ (hsc i).2.2
  have hGH : HolderOnWith K₁ β G (Metric.ball x₀ R) := by
    have e1 : G = fun x => ∫ s in (0:ℝ)..1,
        fderiv ℝ Λ (X (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) (0, 1, 0) := funext hG
    rw [e1]
    exact hmono _ _ _ _ hLLvK₁ hsG.2.2
  
  have hgm : HolderOnWith Lv β (fun y => smthGrad v y m) (Metric.ball x₀ (2 * R)) :=
    fun x hx y hy => (edist_le_pi_edist _ _ m).trans (hgH x hx y hy)
  have hsw := smth_avg_holder (Metric.ball x₀ R)
    (fun s x => smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m) Lv β
    (fun s hs => (smth_shift_holder (fun y => smthGrad v y m) (Metric.ball x₀ (2 * R))
      (Metric.ball x₀ R) Lv β hgm ((s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))
      (fun x hx => ⟨hS0 x hx, hgeo x hx s hs⟩)).1)
    (fun x _ => ((continuous_apply m).comp (hgc.comp (continuous_const.add
      ((continuous_id.mul continuous_const).smul continuous_const)))).continuousOn)
  have hweq : smthDQ v m h = fun x => ∫ s in (0:ℝ)..1,
      smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) m := funext hwint
  have hwH : HolderOnWith K₁ β (smthDQ v m h) (Metric.ball x₀ R) := by
    rw [hweq]; exact hmono _ _ _ _ hLvK₁ hsw.2
  have hwb : ∀ x ∈ Metric.ball x₀ R, |smthDQ v m h x| ≤ Lv := by
    intro x hx
    rw [hwint x]
    have := hsw.1 x hx 0 Lv (fun s hs => by
      beta_reduce
      rw [sub_zero, ← Real.norm_eq_abs]
      exact (norm_le_pi_norm (smthGrad v (x + (s * h) • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) m).trans
        (hLvb _ (hgeo x hx s hs)))
    simpa using this
  
  have hFi : ∀ i : Fin 2, (∀ x ∈ Metric.ball x₀ R, |F x i| ≤ ((2 * K₁ * K₁ + 2 * K₁ : NNReal) : ℝ))
      ∧ HolderOnWith (2 * K₁ * K₁ + 2 * K₁) β (fun x => F x i) (Metric.ball x₀ R) := by
    intro i
    have ht : |(if i = m then (1:ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    have hcomb := smth_holder_combo (Metric.ball x₀ R) (fun x => b x i) (smthDQ v m h)
      (fun x => c x i) G (if i = m then (1:ℝ) else 0) ht K₁ β
      (fun x hx => ⟨by beta_reduce; rw [hb]; exact ((hsb i).1 x hx).trans hLK₁r,
        (hwb x hx).trans hLvK₁r,
        by beta_reduce; rw [hc]; exact ((hsc i).1 x hx).trans hLK₁r,
        by rw [hG]; exact (hsG.1 x hx).trans hLK₁r⟩)
      (hbH i) hwH (hcH i) hGH
    have e1 : (fun x => F x i) = fun x => -((fun x => b x i) x * smthDQ v m h x +
        (fun x => c x i) x) + (if i = m then (1:ℝ) else 0) * G x := funext fun x => hF x i
    refine ⟨fun x hx => ?_, ?_⟩
    · rw [hF x i]; exact hcomb.1 x hx
    · rw [e1]; exact hcomb.2
  
  refine ⟨a, F, ?_⟩
  unfold smthSchauderData
  refine ⟨?_, ?_, ?_, fun x hx i => (hFi i).1 x hx, hpi _ _ _ fun i => (hFi i).2,
    fun x hx => ((hwb x hx).trans hLvK₁r).trans hK₁Kr, hwC1.contDiffOn,
    hwhol (Metric.ball x₀ (2 * R)) (Metric.ball x₀ R) Lv β hgH
      (fun x hx => ⟨hS0 x hx, hS1 x hx⟩), ?_⟩
  · 
    intro x hx ξ
    have hcl : ∀ i j : Fin 2, |a x i j - fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
        (X x₀) (0, 0, Pi.single j 1)| ≤ lam0 / 8 := by
      intro i j
      rw [ha]
      exact (hsa i j).2.1 x hx _ _ (fun s hs => hclose _ (hZB s hs x hx) i j)
    exact smth_ell_perturb (fun i j => fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
      (X x₀) (0, 0, Pi.single j 1)) (a x) lam0 hlam0 hM₀ hcl ξ
  · 
    intro x hx i j
    rw [ha]
    exact (((hsa i j).1 x hx).trans hLK₁r).trans hK₁Kr
  · 
    refine hpi _ _ _ fun i => hpi _ _ _ fun j => ?_
    show HolderOnWith _ β (fun x => a x i j) _
    exact hmono _ _ _ _ hK₁K (hAH i j)
  · 
    refine smth_dq_weak_eq D (Metric.ball x₀ R) hD Metric.isOpen_ball
      (fun y i => fderiv ℝ Λ (X y) (0, 0, Pi.single i 1)) (fun y => fderiv ℝ Λ (X y) (0, 1, 0))
      ?_ ?_ ?_ m h hh (fun x hx s hs => hTD (hgeo x hx s hs)) a F (smthDQ v m h)
      (fun i j => (hAH i j).continuousOn hβ0) ?_ (fun i => (hFi i).2.continuousOn hβ0) ?_
    · intro i
      exact (hΛ1.continuousOn.comp hXc.continuousOn
        (fun y hy => by rw [hXdef]; exact hvO y hy)).clm_apply continuousOn_const
    · exact (hΛ1.continuousOn.comp hXc.continuousOn
        (fun y hy => by rw [hXdef]; exact hvO y hy)).clm_apply continuousOn_const
    · intro φ hφ hφc hφD
      have h0 := hEL φ hφ hφc hφD
      have hz3 : (((0 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) :
          (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) = 0 := rfl
      have hzero : ∀ x, x ∉ D →
          fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0 := by
        intro x hx
        have hxt : x ∉ tsupport φ := fun h => hx (hφD h)
        have hφx : φ x = 0 := image_eq_zero_of_notMem_tsupport hxt
        have hdφ : fderiv ℝ φ x = 0 :=
          image_eq_zero_of_notMem_tsupport (fun h => hxt (tsupport_fderiv_subset ℝ h))
        have hg : smthGrad φ x = 0 := by
          funext k; simp [smthGrad, hdφ]
        rw [hφx, hg, hz3]
        exact map_zero _
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero hzero] at h0
      have hfun : (fun x => ∑ i : Fin 2, fderiv ℝ Λ (X x) (0, 0, Pi.single i 1) *
            smthGrad φ x i + fderiv ℝ Λ (X x) (0, 1, 0) * φ x) =
          fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) := by
        funext x
        rw [hXdef, hdec 0 (φ x) (smthGrad φ x), hz3]
        simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_two, map_zero, zero_add]
        ring
      beta_reduce
      rw [hfun]
      exact h0
    · intro j
      show ContinuousOn (fun x => fderiv ℝ (smthDQ v m h) x (Pi.single j 1)) _
      exact ((hwC1.continuous_fderiv one_ne_zero).clm_apply continuous_const).continuousOn
    · intro x hx i
      have hseg : ∀ s ∈ Set.Icc (0:ℝ) 1,
          X x + s • (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x) ∈ O :=
        fun s hs => hBO (hZB s hs x hx)
      have hd : X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ)) - X x =
          h • ((Pi.single m (1:ℝ) : Fin 2 → ℝ), smthDQ v m h x, smthGrad (smthDQ v m h) x) := by
        rw [hXdef, hXdef, hwgrad x]
        refine Prod.ext ?_ (Prod.ext ?_ ?_)
        · simp
        · simp only [Prod.snd_sub, Prod.fst_sub, Prod.smul_snd, Prod.smul_fst, smul_eq_mul,
            smthDQ]
          field_simp
        · funext j
          simp only [Prod.snd_sub, Prod.smul_snd, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
          field_simp
      have key := smth_ftc_split (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) O hO (hA1 i)
        (X x) (X (x + h • (Pi.single m (1:ℝ) : Fin 2 → ℝ))) hseg h hh
        (Pi.single m (1:ℝ)) (smthDQ v m h x) (smthGrad (smthDQ v m h) x) hd
      beta_reduce at key ⊢
      rw [key, hF x i, hG x, hb x i, hc x i]
      simp only [ha x i, Fin.sum_univ_two]
      ring

theorem smth_holC0_common (ι : Type) [Fintype ι] (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (f : ι → (Fin 2 → ℝ) → ℝ) (hf : ∀ i, smthHolC 0 (f i) S) (x₀ : Fin 2 → ℝ) (hx₀ : x₀ ∈ S) : ∃ (ρ : ℝ) (B C α : NNReal), 0 < ρ ∧ ρ ≤ 1 / 4 ∧ 0 < α ∧ α < 1 ∧ Metric.ball x₀ ρ ⊆ S ∧ ∀ i, HolderOnWith C α (f i) (Metric.ball x₀ ρ) ∧ ∀ x ∈ Metric.ball x₀ ρ, |f i x| ≤ (B : ℝ) :=
by
  obtain ⟨ε, hε, hεS⟩ := Metric.isOpen_iff.mp hS x₀ hx₀
  choose ρ' C' α' hρ' hα' hball' hHol' using fun i => (hf i).2 x₀ hx₀
  have lower : ∀ (r : ι → ℝ) (c : ℝ), 0 < c → (∀ i, 0 < r i) →
      ∃ t : ℝ, 0 < t ∧ t < c ∧ ∀ i, t ≤ r i := by
    intro r c hc hr
    have hsum : 0 ≤ ∑ j, 1 / r j := Finset.sum_nonneg (fun j _ => (one_div_pos.mpr (hr j)).le)
    have hc1 : 0 < 1 / c := one_div_pos.mpr hc
    refine ⟨1 / (1 / c + ∑ j, 1 / r j + 1), one_div_pos.mpr (by linarith), ?_, ?_⟩
    · calc 1 / (1 / c + ∑ j, 1 / r j + 1) < 1 / (1 / c) :=
            one_div_lt_one_div_of_lt hc1 (by linarith)
        _ = c := one_div_one_div c
    · intro i
      have hi : 1 / r i ≤ ∑ j, 1 / r j :=
        Finset.single_le_sum (f := fun j => 1 / r j)
          (fun j _ => (one_div_pos.mpr (hr j)).le) (Finset.mem_univ i)
      calc 1 / (1 / c + ∑ j, 1 / r j + 1) ≤ 1 / (1 / r i) :=
            one_div_le_one_div_of_le (one_div_pos.mpr (hr i)) (by linarith)
        _ = r i := one_div_one_div (r i)
  obtain ⟨ρ, hρ0, hρlt, hρle⟩ := lower ρ' (min (1 / 4) ε) (lt_min (by norm_num) hε) hρ'
  obtain ⟨a, ha0, ha1, hale⟩ :=
    lower (fun i => (α' i : ℝ)) 1 one_pos (fun i => NNReal.coe_pos.mpr (hα' i))
  have hρ4 : ρ ≤ 1 / 4 := (lt_of_lt_of_le hρlt (min_le_left _ _)).le
  have hρε : ρ ≤ ε := (lt_of_lt_of_le hρlt (min_le_right _ _)).le
  obtain ⟨α, hαdef⟩ : ∃ α : NNReal, α = Real.toNNReal a := ⟨_, rfl⟩
  have hαa : (α : ℝ) = a := by rw [hαdef]; exact Real.coe_toNNReal a ha0.le
  have hαle : ∀ i, α ≤ α' i := fun i => by
    rw [← NNReal.coe_le_coe, hαa]; exact hale i
  refine ⟨ρ, ∑ i, (‖f i x₀‖₊ + C' i), ∑ i, C' i, α, hρ0, hρ4, ?_, ?_,
    (Metric.ball_subset_ball hρε).trans hεS, ?_⟩
  · rw [← NNReal.coe_pos, hαa]; exact ha0
  · rw [← NNReal.coe_lt_coe, hαa, NNReal.coe_one]; exact ha1
  · intro i
    have hCi : C' i ≤ ∑ j, C' j :=
      Finset.single_le_sum (f := C') (fun j _ => zero_le _) (Finset.mem_univ i)
    have hBeq : ((∑ j, (‖f j x₀‖₊ + C' j) : NNReal) : ℝ) = ∑ j, (|f j x₀| + (C' j : ℝ)) := by
      rw [NNReal.coe_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [NNReal.coe_add, coe_nnnorm, Real.norm_eq_abs]
    have hBi : |f i x₀| + (C' i : ℝ) ≤ ((∑ j, (‖f j x₀‖₊ + C' j) : NNReal) : ℝ) := by
      rw [hBeq]
      exact Finset.single_le_sum (f := fun j => |f j x₀| + (C' j : ℝ))
        (fun j _ => add_nonneg (abs_nonneg _) (NNReal.coe_nonneg _)) (Finset.mem_univ i)
    have hf' : HolderOnWith (C' i) (α' i) (f i) (Metric.ball x₀ ρ) :=
      (hHol' i).mono (Metric.ball_subset_ball (hρle i))
    have hdiam : ∀ x ∈ Metric.ball x₀ ρ, ∀ y ∈ Metric.ball x₀ ρ,
        edist x y ≤ ((1 : NNReal) : ENNReal) := by
      intro x hx y hy
      rw [edist_dist, ENNReal.coe_one, ENNReal.ofReal_le_one]
      have h1 := dist_triangle_right x y x₀
      rw [Metric.mem_ball] at hx hy
      linarith
    refine ⟨?_, ?_⟩
    · have h := HolderOnWith.of_le hdiam hf' (hαle i)
      rw [NNReal.one_rpow, mul_one] at h
      exact h.mono_const hCi
    · intro x hx
      have hx0 : x₀ ∈ Metric.ball x₀ ρ := Metric.mem_ball_self hρ0
      have hd : dist x x₀ ≤ 1 := by rw [Metric.mem_ball] at hx; linarith
      have h := hf'.dist_le_of_le hx hx0 hd
      rw [Real.one_rpow, mul_one, Real.dist_eq] at h
      have h2 := abs_sub_abs_le_abs_sub (f i x) (f i x₀)
      linarith

theorem smth_unif_ellipticity (K : Set (Fin 2 → ℝ)) (hK : IsCompact K) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (ha : ∀ i j : Fin 2, ContinuousOn (fun x => a x i j) K) (hell : ∀ x ∈ K, ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j) : ∃ lam : ℝ, 0 < lam ∧ ∀ x ∈ K, ∀ ξ : Fin 2 → ℝ, lam * ∑ i : Fin 2, ξ i ^ 2 ≤ ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j :=
by
  rcases Set.eq_empty_or_nonempty K with hKe | hKne
  · refine ⟨1, one_pos, ?_⟩
    intro x hx
    rw [hKe] at hx
    exact absurd hx (Set.notMem_empty x)
  set S : Set (Fin 2 → ℝ) := Metric.sphere (0 : Fin 2 → ℝ) 1 with hSdef
  have hS : IsCompact S := isCompact_sphere 0 1
  have hP : IsCompact (K ×ˢ S) := hK.prod hS
  obtain ⟨x₁, hx₁⟩ := hKne
  obtain ⟨η₁, hη₁⟩ : S.Nonempty := NormedSpace.sphere_nonempty.mpr zero_le_one
  have hPne : (K ×ˢ S).Nonempty := ⟨(x₁, η₁), Set.mk_mem_prod hx₁ hη₁⟩
  have hcont : ContinuousOn
      (fun p : (Fin 2 → ℝ) × (Fin 2 → ℝ) =>
        ∑ i : Fin 2, ∑ j : Fin 2, a p.1 i j * p.2 i * p.2 j) (K ×ˢ S) := by
    have hA : ∀ i j : Fin 2, ContinuousOn (fun p : (Fin 2 → ℝ) × (Fin 2 → ℝ) => a p.1 i j)
        (K ×ˢ S) := fun i j =>
      (ha i j).comp continuousOn_fst (fun p hp => (Set.mem_prod.mp hp).1)
    have hC : ∀ i : Fin 2, ContinuousOn (fun p : (Fin 2 → ℝ) × (Fin 2 → ℝ) => p.2 i)
        (K ×ˢ S) := fun i => ((continuous_apply i).comp continuous_snd).continuousOn
    refine continuousOn_finset_sum _ (fun i _ => ?_)
    refine continuousOn_finset_sum _ (fun j _ => ?_)
    exact ((hA i j).mul (hC i)).mul (hC j)
  obtain ⟨p₀, hp₀, hmin⟩ := hP.exists_isMinOn hPne hcont
  set m : ℝ := ∑ i : Fin 2, ∑ j : Fin 2, a p₀.1 i j * p₀.2 i * p₀.2 j with hmdef
  have hmin' : ∀ x ∈ K, ∀ η ∈ S, m ≤ ∑ i : Fin 2, ∑ j : Fin 2, a x i j * η i * η j := by
    intro x hx η hη
    exact (isMinOn_iff.mp hmin) (x, η) (Set.mk_mem_prod hx hη)
  have hm : 0 < m := by
    obtain ⟨hx₀, hη₀⟩ := Set.mem_prod.mp hp₀
    have hn : ‖p₀.2‖ = 1 := mem_sphere_zero_iff_norm.mp hη₀
    have hne : p₀.2 ≠ 0 := by
      intro h
      rw [h, norm_zero] at hn
      exact zero_ne_one hn
    exact hell p₀.1 hx₀ p₀.2 hne
  refine ⟨m / 2, half_pos hm, ?_⟩
  intro x hx ξ
  by_cases hξ : ξ = 0
  · subst hξ
    simp
  have hr : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
  set r : ℝ := ‖ξ‖ with hrdef
  set η : Fin 2 → ℝ := r⁻¹ • ξ with hηdef
  have hηn : ‖η‖ = 1 := by
    rw [hηdef, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hr, inv_mul_cancel₀ hr.ne']
  have hηS : η ∈ S := mem_sphere_zero_iff_norm.mpr hηn
  have hcoord : ∀ i : Fin 2, ξ i = r * η i := by
    intro i
    rw [hηdef, Pi.smul_apply, smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hr.ne', one_mul]
  have hhom : ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j =
      r ^ 2 * ∑ i : Fin 2, ∑ j : Fin 2, a x i j * η i * η j := by
    simp only [Fin.sum_univ_two, hcoord 0, hcoord 1]
    ring
  have hbd : ∀ i : Fin 2, ξ i ^ 2 ≤ r ^ 2 := by
    intro i
    have h1 : |ξ i| ≤ r := by
      have := norm_le_pi_norm ξ i
      rwa [Real.norm_eq_abs] at this
    have h2 : 0 ≤ |ξ i| := abs_nonneg _
    rw [← sq_abs]
    exact pow_le_pow_left₀ h2 h1 2
  have hsum : ∑ i : Fin 2, ξ i ^ 2 ≤ 2 * r ^ 2 := by
    rw [Fin.sum_univ_two]
    linarith [hbd 0, hbd 1]
  have hmq := hmin' x hx η hηS
  rw [hhom]
  have hr2 : 0 ≤ r ^ 2 := sq_nonneg r
  calc m / 2 * ∑ i : Fin 2, ξ i ^ 2 ≤ m / 2 * (2 * r ^ 2) :=
        mul_le_mul_of_nonneg_left hsum (by linarith)
    _ = r ^ 2 * m := by ring
    _ ≤ r ^ 2 * ∑ i : Fin 2, ∑ j : Fin 2, a x i j * η i * η j :=
        mul_le_mul_of_nonneg_left hmq hr2

theorem smth_lin_dq_eq (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (ha : ∀ i j : Fin 2, ContinuousOn (fun x => a x i j) S) (hF : ∀ i : Fin 2, ContinuousOn (fun x => F x i) S) (hwd : ∀ x ∈ S, DifferentiableAt ℝ w x) (hwg : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad w x j) S) (heq : smthLinSol a F w S) (x₀ : Fin 2 → ℝ) (R : ℝ) (hR : 0 < R) (hball : Metric.ball x₀ (2 * R) ⊆ S) (m : Fin 2) (h : ℝ) (hh : 0 < |h|) (hhR : |h| < R) : smthLinSol (fun x => a (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ))) (fun x i => smthDQ (fun y => F y i) m h x - ∑ j : Fin 2, smthDQ (fun y => a y i j) m h x * smthGrad w x j) (smthDQ w m h) (Metric.ball x₀ R) :=
by
  intro φ hφ hφc hφB
  generalize hτ : h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ) = τ
  have hdq : ∀ (u : (Fin 2 → ℝ) → ℝ) (x : Fin 2 → ℝ), smthDQ u m h x = (u (x + τ) - u x) / h := by
    intro u x; rw [← hτ]; rfl
  have hv : ‖τ‖ = |h| := by
    rw [← hτ, norm_smul, Pi.norm_single, norm_one, mul_one, Real.norm_eq_abs]
  have hBS : Metric.ball x₀ R ⊆ S := (Metric.ball_subset_ball (by linarith)).trans hball
  have hshift : ∀ x ∈ Metric.ball x₀ R, x + τ ∈ S := by
    intro x hx
    apply hball
    rw [Metric.mem_ball] at hx ⊢
    have h1 : dist (x + τ) x = |h| := by rw [dist_eq_norm, add_sub_cancel_left, hv]
    have h2 := dist_triangle (x + τ) x x₀
    linarith
  have hφS : tsupport φ ⊆ S := hφB.trans hBS
  
  have hdcont : ∀ i : Fin 2, Continuous (fun x => smthGrad φ x i) := by
    intro i
    simp only [smthGrad]
    exact (hφ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hdsupp : ∀ i : Fin 2, ∀ x, x ∉ tsupport φ → smthGrad φ x i = 0 := by
    intro i x hx
    have hx' : x ∉ tsupport (fderiv ℝ φ) := fun h' => hx (tsupport_fderiv_subset ℝ h')
    have h0 : fderiv ℝ φ x = 0 := image_eq_zero_of_notMem_tsupport hx'
    simp [smthGrad, h0]
  
  have hint : ∀ g : (Fin 2 → ℝ) → ℝ, ContinuousOn g (Metric.ball x₀ R) → ∀ i : Fin 2,
      Integrable (fun x => g x * smthGrad φ x i) := by
    intro g hg i
    have hsub : tsupport (fun x => g x * smthGrad φ x i) ⊆ tsupport φ := by
      refine closure_minimal ?_ (isClosed_tsupport φ)
      intro x hx
      by_contra hx'
      apply hx
      simp only [hdsupp i x hx', mul_zero]
    have hc : Continuous (fun x => g x * smthGrad φ x i) :=
      (hg.mul (hdcont i).continuousOn).continuous_of_tsupport_subset Metric.isOpen_ball
        (hsub.trans hφB)
    exact hc.integrable_of_hasCompactSupport
      (IsCompact.of_isClosed_subset hφc (isClosed_tsupport _) hsub)
  
  have hcomp : ∀ g : (Fin 2 → ℝ) → ℝ, ContinuousOn g S →
      ContinuousOn (fun x => g (x + τ)) (Metric.ball x₀ R) :=
    fun g hg => hg.comp (continuous_add_right τ).continuousOn hshift
  have hdqc : ∀ g : (Fin 2 → ℝ) → ℝ, ContinuousOn g S →
      ContinuousOn (smthDQ g m h) (Metric.ball x₀ R) := by
    intro g hg
    have e : smthDQ g m h = fun x => (g (x + τ) - g x) / h := funext (hdq g)
    rw [e]
    exact ((hcomp g hg).sub (hg.mono hBS)).div_const h
  
  have hgdq : ∀ x, DifferentiableAt ℝ w x → DifferentiableAt ℝ w (x + τ) → ∀ j : Fin 2,
      smthGrad (smthDQ w m h) x j = (smthGrad w (x + τ) j - smthGrad w x j) / h := by
    intro x hx hxh j
    have h0 : HasFDerivAt (fun y : Fin 2 → ℝ => y + τ)
        (ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) x := (hasFDerivAt_id x).add_const _
    have h1 : HasFDerivAt (fun y => w (y + τ)) (fderiv ℝ w (x + τ)) x := by
      have := hxh.hasFDerivAt.comp x h0
      simpa [Function.comp_def] using this
    have h2 : HasFDerivAt (fun y => (w (y + τ) - w y) * h⁻¹)
        (h⁻¹ • (fderiv ℝ w (x + τ) - fderiv ℝ w x)) x :=
      (h1.sub hx.hasFDerivAt).mul_const h⁻¹
    have h3 : smthDQ w m h = fun y => (w (y + τ) - w y) * h⁻¹ := by
      funext y; rw [hdq, div_eq_mul_inv]
    simp only [smthGrad]
    rw [h3, h2.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sub_apply, smul_eq_mul]
    ring
  
  obtain ⟨P1, hP1⟩ : ∃ P1 : (Fin 2 → ℝ) → ℝ, P1 = fun x => ∑ i : Fin 2, ∑ j : Fin 2,
      a (x + τ) i j * smthGrad w (x + τ) j * smthGrad φ x i := ⟨_, rfl⟩
  obtain ⟨P0, hP0⟩ : ∃ P0 : (Fin 2 → ℝ) → ℝ, P0 = fun x => ∑ i : Fin 2, ∑ j : Fin 2,
      a x i j * smthGrad w x j * smthGrad φ x i := ⟨_, rfl⟩
  obtain ⟨R1, hR1⟩ : ∃ R1 : (Fin 2 → ℝ) → ℝ, R1 = fun x => ∑ i : Fin 2,
      F (x + τ) i * smthGrad φ x i := ⟨_, rfl⟩
  obtain ⟨R0, hR0⟩ : ∃ R0 : (Fin 2 → ℝ) → ℝ, R0 = fun x => ∑ i : Fin 2,
      F x i * smthGrad φ x i := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : (Fin 2 → ℝ) → ℝ, Q = fun x => ∑ i : Fin 2, ∑ j : Fin 2,
      smthDQ (fun y => a y i j) m h x * smthGrad w x j * smthGrad φ x i := ⟨_, rfl⟩
  
  have iP1 : Integrable P1 := by
    rw [hP1]
    exact integrable_finset_sum _ (fun i _ => integrable_finset_sum _ (fun j _ =>
      hint _ ((hcomp _ (ha i j)).mul (hcomp _ (hwg j))) i))
  have iP0 : Integrable P0 := by
    rw [hP0]
    exact integrable_finset_sum _ (fun i _ => integrable_finset_sum _ (fun j _ =>
      hint _ (((ha i j).mono hBS).mul ((hwg j).mono hBS)) i))
  have iR1 : Integrable R1 := by
    rw [hR1]
    exact integrable_finset_sum _ (fun i _ => hint _ (hcomp _ (hF i)) i)
  have iR0 : Integrable R0 := by
    rw [hR0]
    exact integrable_finset_sum _ (fun i _ => hint _ ((hF i).mono hBS) i)
  have iQ : Integrable Q := by
    rw [hQ]
    exact integrable_finset_sum _ (fun i _ => integrable_finset_sum _ (fun j _ =>
      hint _ ((hdqc _ (ha i j)).mul ((hwg j).mono hBS)) i))
  
  have hP0R0 : (∫ x, P0 x) = ∫ x, R0 x := by
    rw [hP0, hR0]; exact heq φ hφ hφc hφS
  
  have hP1R1 : (∫ x, P1 x) = ∫ x, R1 x := by
    have hψ : ContDiff ℝ ∞ (fun y => φ (y + -τ)) := hφ.comp (contDiff_id.add contDiff_const)
    have hψc : HasCompactSupport (fun y => φ (y + -τ)) :=
      hφc.comp_homeomorph (Homeomorph.addRight (-τ))
    have hψS : tsupport (fun y => φ (y + -τ)) ⊆ S := by
      intro y hy
      have hy' : y ∈ (Homeomorph.addRight (-τ)) ⁻¹' tsupport φ := by
        rw [← tsupport_comp_eq_preimage]; exact hy
      have hy'' : y + -τ ∈ Metric.ball x₀ R := hφB hy'
      have := hshift _ hy''
      rwa [neg_add_cancel_right] at this
    have hgψ : ∀ y i, smthGrad (fun y => φ (y + -τ)) y i = smthGrad φ (y + -τ) i := by
      intro y i
      simp only [smthGrad]
      rw [fderiv_comp_add_right]
    obtain ⟨G, hG⟩ : ∃ G : (Fin 2 → ℝ) → ℝ, G = fun y => ∑ i : Fin 2, ∑ j : Fin 2,
        a y i j * smthGrad w y j * smthGrad φ (y + -τ) i := ⟨_, rfl⟩
    obtain ⟨H, hH⟩ : ∃ H : (Fin 2 → ℝ) → ℝ, H = fun y => ∑ i : Fin 2,
        F y i * smthGrad φ (y + -τ) i := ⟨_, rfl⟩
    have key : (∫ y, G y) = ∫ y, H y := by
      have := heq _ hψ hψc hψS
      simp only [hgψ] at this
      rw [hG, hH]; exact this
    have e1 : (∫ x, P1 x) = ∫ x, G (x + τ) := by
      congr 1; funext x; rw [hP1, hG]; simp only [add_neg_cancel_right]
    have e2 : (∫ x, R1 x) = ∫ x, H (x + τ) := by
      congr 1; funext x; rw [hR1, hH]; simp only [add_neg_cancel_right]
    rw [e1, e2, integral_add_right_eq_self G τ, integral_add_right_eq_self H τ]
    exact key
  
  have hL : ∀ x, (∑ i : Fin 2, ∑ j : Fin 2,
      a (x + τ) i j * smthGrad (smthDQ w m h) x j * smthGrad φ x i) =
      (P1 x - P0 x) / h - Q x := by
    intro x
    rw [hP1, hP0, hQ]
    by_cases hx : x ∈ Metric.ball x₀ R
    · have hxS := hBS hx
      have g0 := hgdq x (hwd x hxS) (hwd _ (hshift x hx)) 0
      have g1 := hgdq x (hwd x hxS) (hwd _ (hshift x hx)) 1
      simp only [Fin.sum_univ_two, g0, g1, hdq]
      ring
    · have hx' : x ∉ tsupport φ := fun h' => hx (hφB h')
      simp only [Fin.sum_univ_two, hdsupp 0 x hx', hdsupp 1 x hx', mul_zero]
      ring
  have hRt : ∀ x, (∑ i : Fin 2, (smthDQ (fun y => F y i) m h x -
      ∑ j : Fin 2, smthDQ (fun y => a y i j) m h x * smthGrad w x j) * smthGrad φ x i) =
      (R1 x - R0 x) / h - Q x := by
    intro x
    rw [hR1, hR0, hQ]
    simp only [Fin.sum_univ_two, hdq]
    ring
  show (∫ x, ∑ i : Fin 2, ∑ j : Fin 2,
      a (x + τ) i j * smthGrad (smthDQ w m h) x j * smthGrad φ x i) =
    ∫ x, ∑ i : Fin 2, (smthDQ (fun y => F y i) m h x -
      ∑ j : Fin 2, smthDQ (fun y => a y i j) m h x * smthGrad w x j) * smthGrad φ x i
  have eL : (∫ x, ∑ i : Fin 2, ∑ j : Fin 2,
      a (x + τ) i j * smthGrad (smthDQ w m h) x j * smthGrad φ x i) =
      ∫ x, ((P1 x - P0 x) / h - Q x) := by
    congr 1; funext x; exact hL x
  have eR : (∫ x, ∑ i : Fin 2, (smthDQ (fun y => F y i) m h x -
      ∑ j : Fin 2, smthDQ (fun y => a y i j) m h x * smthGrad w x j) * smthGrad φ x i) =
      ∫ x, ((R1 x - R0 x) / h - Q x) := by
    congr 1; funext x; exact hRt x
  have i1 : Integrable (fun x => (P1 x - P0 x) / h) := (iP1.sub iP0).div_const h
  have i2 : Integrable (fun x => (R1 x - R0 x) / h) := (iR1.sub iR0).div_const h
  rw [eL, eR, integral_sub i1 iQ, integral_sub i2 iQ, integral_div, integral_div,
    integral_sub iP1 iP0, integral_sub iR1 iR0, hP1R1, hP0R0]

theorem smth_dq_mvt_bounds (f : (Fin 2 → ℝ) → ℝ) (x₀ : Fin 2 → ℝ) (R : ℝ) (m : Fin 2) (B C α : NNReal) (hR : 0 < R) (hd : ∀ x ∈ Metric.ball x₀ (2 * R), DifferentiableAt ℝ f x) (hB : ∀ x ∈ Metric.ball x₀ (2 * R), |smthGrad f x m| ≤ (B : ℝ)) (hH : HolderOnWith C α (fun x => smthGrad f x m) (Metric.ball x₀ (2 * R))) (h : ℝ) (hh : 0 < |h|) (hhR : |h| < R) : (∀ x ∈ Metric.ball x₀ R, |smthDQ f m h x| ≤ (B : ℝ)) ∧ HolderOnWith C α (smthDQ f m h) (Metric.ball x₀ R) :=
by
  set e : Fin 2 → ℝ := Pi.single m (1 : ℝ) with he
  have hh0 : h ≠ 0 := abs_pos.mp hh
  have hen : ‖e‖ = 1 := by rw [he, Pi.norm_single, norm_one]
  have hseg : ∀ x ∈ Metric.ball x₀ R, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      x + (t * h) • e ∈ Metric.ball x₀ (2 * R) := by
    intro x hx t ht
    rw [Metric.mem_ball] at hx ⊢
    have h1 : ‖(t * h) • e‖ ≤ |h| := by
      rw [norm_smul, hen, mul_one, Real.norm_eq_abs, abs_mul, abs_of_nonneg ht.1]
      calc t * |h| ≤ 1 * |h| := by gcongr; exact ht.2
        _ = |h| := one_mul _
    calc dist (x + (t * h) • e) x₀ ≤ dist (x + (t * h) • e) x + dist x x₀ := dist_triangle _ _ _
      _ = ‖(t * h) • e‖ + dist x x₀ := by rw [dist_eq_norm, add_sub_cancel_left]
      _ < 2 * R := by linarith
  have hderiv : ∀ x ∈ Metric.ball x₀ R, ∀ t ∈ Set.Icc (0 : ℝ) 1,
      HasDerivAt (fun s : ℝ => f (x + (s * h) • e)) (h * smthGrad f (x + (t * h) • e) m) t := by
    intro x hx t ht
    have hγ : HasDerivAt (fun s : ℝ => x + (s * h) • e) (h • e) t := by
      have h2 := ((hasDerivAt_id t).mul_const h).smul_const e
      simp only [id, one_mul] at h2
      exact h2.const_add x
    have hf := (hd _ (hseg x hx t ht)).hasFDerivAt
    refine (hf.comp_hasDerivAt t hγ).congr_deriv ?_
    rw [ContinuousLinearMap.map_smul, smul_eq_mul]
    rfl
  refine ⟨fun x hx => ?_, ?_⟩
  · obtain ⟨τ, hτ, hτeq⟩ := exists_hasDerivAt_eq_slope (fun s : ℝ => f (x + (s * h) • e))
      (fun t => h * smthGrad f (x + (t * h) • e) m) zero_lt_one
      (fun t ht => (hderiv x hx t ht).continuousAt.continuousWithinAt)
      (fun t ht => hderiv x hx t (Set.Ioo_subset_Icc_self ht))
    have hτ' := Set.Ioo_subset_Icc_self hτ
    simp only [one_mul, zero_mul, zero_smul, add_zero, sub_zero, div_one] at hτeq
    have hdq : smthDQ f m h x = smthGrad f (x + (τ * h) • e) m := by
      show (f (x + h • e) - f x) / h = _
      rw [← hτeq]
      field_simp
    rw [hdq]
    exact hB _ (hseg x hx τ hτ')
  · intro x hx y hy
    obtain ⟨τ, hτ, hτeq⟩ := exists_hasDerivAt_eq_slope
      (fun s : ℝ => f (x + (s * h) • e) - f (y + (s * h) • e))
      (fun t => h * smthGrad f (x + (t * h) • e) m - h * smthGrad f (y + (t * h) • e) m)
      zero_lt_one
      (fun t ht => ((hderiv x hx t ht).sub (hderiv y hy t ht)).continuousAt.continuousWithinAt)
      (fun t ht => (hderiv x hx t (Set.Ioo_subset_Icc_self ht)).sub
        (hderiv y hy t (Set.Ioo_subset_Icc_self ht)))
    have hτ' := Set.Ioo_subset_Icc_self hτ
    simp only [one_mul, zero_mul, zero_smul, add_zero, sub_zero, div_one] at hτeq
    have hdq : smthDQ f m h x - smthDQ f m h y =
        smthGrad f (x + (τ * h) • e) m - smthGrad f (y + (τ * h) • e) m := by
      show (f (x + h • e) - f x) / h - (f (y + h • e) - f y) / h = _
      rw [div_sub_div_same, show f (x + h • e) - f x - (f (y + h • e) - f y) =
        f (x + h • e) - f (y + h • e) - (f x - f y) by ring, ← hτeq, ← mul_sub]
      field_simp
    have hp := hseg x hx τ hτ'
    have hq := hseg y hy τ hτ'
    calc edist (smthDQ f m h x) (smthDQ f m h y)
        = edist (smthGrad f (x + (τ * h) • e) m) (smthGrad f (y + (τ * h) • e) m) := by
          rw [edist_dist, edist_dist, Real.dist_eq, Real.dist_eq, hdq]
      _ ≤ C * edist (x + (τ * h) • e) (y + (τ * h) • e) ^ (α : ℝ) := hH _ hp _ hq
      _ = C * edist x y ^ (α : ℝ) := by rw [edist_add_right]

theorem smth_lin_C2_step (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (ha : ∀ i j : Fin 2, smthHolC 1 (fun x => a x i j) S) (hF : ∀ i : Fin 2, smthHolC 1 (fun x => F x i) S) (hell : ∀ x ∈ S, ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j) (hw : smthHolC 1 w S) (heq : smthLinSol a F w S) : smthHolC 2 w S :=
by
  
  have of_dist : ∀ {X : Type} [PseudoMetricSpace X] (T : Set (Fin 2 → ℝ)) (f : (Fin 2 → ℝ) → X)
      (K α : NNReal), (∀ x ∈ T, ∀ y ∈ T, dist (f x) (f y) ≤ (K : ℝ) * dist x y ^ (α : ℝ)) →
      HolderOnWith K α f T := by
    intro X _ T f K α hf x hx y hy
    rw [edist_dist, edist_dist, ENNReal.ofReal_rpow_of_nonneg dist_nonneg (NNReal.coe_nonneg α),
      ← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_mul (NNReal.coe_nonneg K)]
    exact ENNReal.ofReal_le_ofReal (hf x hx y hy)
  
  have prod_le : ∀ p q p' q' b d : ℝ, |p| ≤ b → |q'| ≤ b → |p - p'| ≤ d → |q - q'| ≤ d →
      |p * q - p' * q'| ≤ 2 * b * d := by
    intro p q p' q' b d hp hq' h1 h2
    have hb : 0 ≤ b := (abs_nonneg _).trans hp
    have e : p * q - p' * q' = p * (q - q') + q' * (p - p') := by ring
    rw [e]
    calc |p * (q - q') + q' * (p - p')| ≤ |p| * |q - q'| + |q'| * |p - p'| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ b * d + b * d := add_le_add (mul_le_mul hp h2 (abs_nonneg _) hb)
          (mul_le_mul hq' h1 (abs_nonneg _) hb)
      _ = 2 * b * d := by ring
  have comb : ∀ A A' P0 P0' P1 P1' c d : ℝ, |A - A'| ≤ c → |P0 - P0'| ≤ d → |P1 - P1'| ≤ d →
      |A - (P0 + P1) - (A' - (P0' + P1'))| ≤ c + 2 * d := by
    intro A A' P0 P0' P1 P1' c d h1 h2 h3
    have e : A - (P0 + P1) - (A' - (P0' + P1')) = (A - A') - ((P0 - P0') + (P1 - P1')) := by ring
    rw [e]
    have h4 := abs_sub (A - A') ((P0 - P0') + (P1 - P1'))
    have h5 := abs_add_le (P0 - P0') (P1 - P1')
    linarith
  
  have hgdq : ∀ (u : (Fin 2 → ℝ) → ℝ) (m : Fin 2) (h : ℝ) (x : Fin 2 → ℝ), DifferentiableAt ℝ u x →
      DifferentiableAt ℝ u (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) → ∀ j : Fin 2,
      smthGrad (smthDQ u m h) x j =
        (smthGrad u (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) j - smthGrad u x j) / h := by
    intro u m h x hx hxh j
    have h0 : HasFDerivAt (fun y : Fin 2 → ℝ => y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ))
        (ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) x := (hasFDerivAt_id x).add_const _
    have h1 : HasFDerivAt (fun y => u (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)))
        (fderiv ℝ u (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ))) x := by
      have := hxh.hasFDerivAt.comp x h0
      simpa [Function.comp_def] using this
    have h2 : HasFDerivAt
        (fun y => (u (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - u y) * h⁻¹)
        (h⁻¹ • (fderiv ℝ u (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - fderiv ℝ u x)) x :=
      (h1.sub hx.hasFDerivAt).mul_const h⁻¹
    have h3 : smthDQ u m h =
        fun y => (u (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - u y) * h⁻¹ := by
      funext y; simp only [smthDQ, div_eq_mul_inv]
    simp only [smthGrad]
    rw [h3, h2.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sub_apply, smul_eq_mul]
    ring
  
  refine (smth_holC_local 2 w S hS).2 ?_
  intro x₀ hx₀
  
  have ha0 : ∀ i j : Fin 2, smthHolC 0 (fun x => a x i j) S :=
    fun i j => smth_holC_mono 0 _ S hS (ha i j)
  have hF0 : ∀ i : Fin 2, smthHolC 0 (fun x => F x i) S :=
    fun i => smth_holC_mono 0 _ S hS (hF i)
  obtain ⟨ρ, B, C, α, hρ, hρ4, hα0, hα1, hρS, hfam⟩ := smth_holC0_common
    ((Fin 2 × Fin 2) ⊕ ((Fin 2 × Fin 2 × Fin 2) ⊕ ((Fin 2 × Fin 2) ⊕ Fin 2))) S hS
    (Sum.elim (fun p x => a x p.1 p.2)
      (Sum.elim (fun p x => smthGrad (fun y => a y p.1 p.2.1) x p.2.2)
        (Sum.elim (fun p x => smthGrad (fun y => F y p.1) x p.2) (fun j x => smthGrad w x j))))
    (by
      rintro (p | p | p | j)
      · exact ha0 p.1 p.2
      · exact (ha p.1 p.2.1).2 p.2.2
      · exact (hF p.1).2 p.2
      · exact hw.2 j)
    x₀ hx₀
  have hA : ∀ i j : Fin 2, HolderOnWith C α (fun x => a x i j) (ball x₀ ρ) ∧
      ∀ x ∈ ball x₀ ρ, |a x i j| ≤ (B : ℝ) := fun i j => hfam (Sum.inl (i, j))
  have hDA : ∀ i j m : Fin 2,
      HolderOnWith C α (fun x => smthGrad (fun y => a y i j) x m) (ball x₀ ρ) ∧
      ∀ x ∈ ball x₀ ρ, |smthGrad (fun y => a y i j) x m| ≤ (B : ℝ) :=
    fun i j m => hfam (Sum.inr (Sum.inl (i, j, m)))
  have hDF : ∀ i m : Fin 2,
      HolderOnWith C α (fun x => smthGrad (fun y => F y i) x m) (ball x₀ ρ) ∧
      ∀ x ∈ ball x₀ ρ, |smthGrad (fun y => F y i) x m| ≤ (B : ℝ) :=
    fun i m => hfam (Sum.inr (Sum.inr (Sum.inl (i, m))))
  have hDW : ∀ j : Fin 2, HolderOnWith C α (fun x => smthGrad w x j) (ball x₀ ρ) ∧
      ∀ x ∈ ball x₀ ρ, |smthGrad w x j| ≤ (B : ℝ) :=
    fun j => hfam (Sum.inr (Sum.inr (Sum.inr j)))
  
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = ρ / 4 := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hRdef]; positivity
  have hcl : closedBall x₀ (2 * R) ⊆ ball x₀ ρ := closedBall_subset_ball (by rw [hRdef]; linarith)
  have h2R : ball x₀ (2 * R) ⊆ ball x₀ ρ := ball_subset_closedBall.trans hcl
  have hRS : ball x₀ R ⊆ ball x₀ ρ := ball_subset_ball (by rw [hRdef]; linarith)
  obtain ⟨lam, hlam, hlamE⟩ := smth_unif_ellipticity (closedBall x₀ (2 * R))
    (isCompact_closedBall _ _) a (fun i j => (ha0 i j).1.mono (hcl.trans hρS))
    (fun x hx => hell x (hρS (hcl hx)))
  have hB0 : (0 : ℝ) ≤ B := NNReal.coe_nonneg B
  have hC0 : (0 : ℝ) ≤ C := NNReal.coe_nonneg C
  obtain ⟨K₀, hK₀⟩ : ∃ K₀ : NNReal, K₀ = B + C + 2 * B * B + 4 * B * C := ⟨_, rfl⟩
  have hK₀r : (K₀ : ℝ) = B + C + 2 * B * B + 4 * B * C := by rw [hK₀]; push_cast; ring
  have hBB : 0 ≤ (B : ℝ) * B := mul_nonneg hB0 hB0
  have hBC : 0 ≤ (B : ℝ) * C := mul_nonneg hB0 hC0
  have hBK : (B : ℝ) ≤ K₀ := by rw [hK₀r]; linarith
  have hCK : (C : ℝ) ≤ K₀ := by rw [hK₀r]; linarith
  have hFK2 : (C : ℝ) + 4 * B * C ≤ K₀ := by rw [hK₀r]; linarith
  
  obtain ⟨M, hM⟩ := smth_lin_schauder_est α lam K₀ R hα0 hα1 hlam hR
  have hw1 : ContDiffOn ℝ 1 w S := by exact_mod_cast smth_holC_contDiffOn 1 w S hS hw
  
  have hdata : ∀ m : Fin 2, ∀ h : ℝ, 0 < |h| → |h| < R →
      smthSchauderData lam K₀ α (fun x => a (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)))
        (fun x i => smthDQ (fun y => F y i) m h x -
          ∑ j : Fin 2, smthDQ (fun y => a y i j) m h x * smthGrad w x j)
        (smthDQ w m h) (ball x₀ R) := by
    intro m h hh hhR
    have hv : ‖h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)‖ = |h| := by
      rw [norm_smul, Pi.norm_single, norm_one, mul_one, Real.norm_eq_abs]
    have hshift : ∀ x ∈ ball x₀ R,
        x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ) ∈ ball x₀ (2 * R) := by
      intro x hx
      rw [mem_ball] at hx ⊢
      have h1 : dist (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) x = |h| := by
        rw [dist_eq_norm, add_sub_cancel_left, hv]
      have h2 := dist_triangle (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) x x₀
      linarith
    have hshS : ∀ x ∈ ball x₀ R, x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ) ∈ ball x₀ ρ :=
      fun x hx => h2R (hshift x hx)
    have hdist : ∀ x y : Fin 2 → ℝ, dist (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ))
        (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) = dist x y := fun x y => dist_add_right _ _ _
    have mvt : ∀ f : (Fin 2 → ℝ) → ℝ, (∀ x ∈ S, DifferentiableAt ℝ f x) →
        HolderOnWith C α (fun x => smthGrad f x m) (ball x₀ ρ) →
        (∀ x ∈ ball x₀ ρ, |smthGrad f x m| ≤ (B : ℝ)) →
        (∀ x ∈ ball x₀ R, |smthDQ f m h x| ≤ (B : ℝ)) ∧
          HolderOnWith C α (smthDQ f m h) (ball x₀ R) :=
      fun f hd hH hB => smth_dq_mvt_bounds f x₀ R m B C α hR (fun x hx => hd x (hρS (h2R hx)))
        (fun x hx => hB x (h2R hx)) (hH.mono h2R) h hh hhR
    have dqF := fun i : Fin 2 => mvt (fun y => F y i) (hF i).1 (hDF i m).1 (hDF i m).2
    have dqA := fun i j : Fin 2 => mvt (fun y => a y i j) (ha i j).1 (hDA i j m).1 (hDA i j m).2
    have dqW := mvt w hw.1 (hDW m).1 (hDW m).2
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · 
      intro x hx ξ
      exact hlamE _ (ball_subset_closedBall (hshift x hx)) ξ
    · 
      intro x hx i j
      exact ((hA i j).2 _ (hshS x hx)).trans hBK
    · 
      refine of_dist _ _ _ _ (fun x hx y hy => ?_)
      have hD : 0 ≤ (K₀ : ℝ) * dist x y ^ (α : ℝ) := by positivity
      refine (dist_pi_le_iff hD).2 (fun i => (dist_pi_le_iff hD).2 (fun j => ?_))
      have h1 := (hA i j).1.dist_le (hshS x hx) (hshS y hy)
      rw [hdist] at h1
      exact h1.trans (mul_le_mul_of_nonneg_right hCK (by positivity))
    · 
      intro x hx i
      have e1 := (dqF i).1 x hx
      have e2 := (dqA i 0).1 x hx
      have e3 := (dqA i 1).1 x hx
      have e4 := (hDW 0).2 x (hRS hx)
      have e5 := (hDW 1).2 x (hRS hx)
      simp only [Fin.sum_univ_two]
      calc _ ≤ |smthDQ (fun y => F y i) m h x| +
            (|smthDQ (fun y => a y i 0) m h x| * |smthGrad w x 0| +
              |smthDQ (fun y => a y i 1) m h x| * |smthGrad w x 1|) := by
            refine (abs_sub _ _).trans (add_le_add le_rfl ?_)
            rw [← abs_mul, ← abs_mul]
            exact abs_add_le _ _
        _ ≤ B + (B * B + B * B) := add_le_add e1 (add_le_add
            (mul_le_mul e2 e4 (abs_nonneg _) hB0) (mul_le_mul e3 e5 (abs_nonneg _) hB0))
        _ ≤ K₀ := by rw [hK₀r]; linarith
    · 
      refine of_dist _ _ _ _ (fun x hx y hy => ?_)
      have hDn : 0 ≤ dist x y ^ (α : ℝ) := by positivity
      have hD : 0 ≤ (K₀ : ℝ) * dist x y ^ (α : ℝ) := by positivity
      refine (dist_pi_le_iff hD).2 (fun i => ?_)
      have hxρ := hRS hx
      have hyρ := hRS hy
      have f1 := (dqF i).2.dist_le hx hy
      have f2 := (dqA i 0).2.dist_le hx hy
      have f3 := (dqA i 1).2.dist_le hx hy
      have f4 := (hDW 0).1.dist_le hxρ hyρ
      have f5 := (hDW 1).1.dist_le hxρ hyρ
      simp only [Real.dist_eq] at f1 f2 f3 f4 f5 ⊢
      have p0 := prod_le _ _ _ _ _ _ ((dqA i 0).1 x hx) ((hDW 0).2 y hyρ) f2 f4
      have p1 := prod_le _ _ _ _ _ _ ((dqA i 1).1 x hx) ((hDW 1).2 y hyρ) f3 f5
      simp only [Fin.sum_univ_two]
      calc _ ≤ (C : ℝ) * dist x y ^ (α : ℝ) + 2 * (2 * B * (C * dist x y ^ (α : ℝ))) :=
            comb _ _ _ _ _ _ _ _ f1 p0 p1
        _ = (C + 4 * B * C) * dist x y ^ (α : ℝ) := by ring
        _ ≤ K₀ * dist x y ^ (α : ℝ) := mul_le_mul_of_nonneg_right hFK2 hDn
    · 
      intro x hx
      exact (dqW.1 x hx).trans hBK
    · 
      have hc : ContDiffOn ℝ 1
          (fun x => (w (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - w x) / h) (ball x₀ R) := by
        refine ContDiffOn.div_const (ContDiffOn.sub ?_ (hw1.mono (hRS.trans hρS))) h
        exact hw1.comp (contDiffOn_id.add contDiffOn_const) (fun x hx => hρS (hshS x hx))
      exact hc
    · 
      have hh0 : |h| ≠ 0 := hh.ne'
      refine ⟨Real.toNNReal (2 * C / |h|), of_dist _ _ _ _ (fun x hx y hy => ?_)⟩
      rw [Real.coe_toNNReal _ (by positivity)]
      have hD : 0 ≤ 2 * (C : ℝ) / |h| * dist x y ^ (α : ℝ) := by positivity
      refine (dist_pi_le_iff hD).2 (fun j => ?_)
      have hxS := hρS (hRS hx)
      have hyS := hρS (hRS hy)
      rw [hgdq w m h x (hw.1 x hxS) (hw.1 _ (hρS (hshS x hx))) j,
        hgdq w m h y (hw.1 y hyS) (hw.1 _ (hρS (hshS y hy))) j, Real.dist_eq]
      have g1 := (hDW j).1.dist_le (hshS x hx) (hshS y hy)
      have g2 := (hDW j).1.dist_le (hRS hx) (hRS hy)
      rw [hdist] at g1
      simp only [Real.dist_eq] at g1 g2
      rw [div_sub_div_same, abs_div, div_le_iff₀ hh]
      have e2 : 2 * (C : ℝ) / |h| * dist x y ^ (α : ℝ) * |h| = 2 * C * dist x y ^ (α : ℝ) := by
        field_simp
      rw [e2]
      have e : ∀ p q r s : ℝ, p - q - (r - s) = (p - r) - (q - s) := by intros; ring
      rw [e]
      have h4 := abs_sub (smthGrad w (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) j -
        smthGrad w (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) j) (smthGrad w x j - smthGrad w y j)
      linarith
    · 
      exact smth_lin_dq_eq S hS a F w (fun i j => (ha0 i j).1) (fun i => (hF0 i).1) hw.1
        (fun j => (hw.2 j).1) heq x₀ R hR (h2R.trans hρS) m h hh hhR
  
  have hlim : ∀ m : Fin 2, ContDiffOn ℝ 1 (fun x => smthGrad w x m) (ball x₀ (R / 2)) ∧
      HolderOnWith M α (smthGrad (fun x => smthGrad w x m)) (ball x₀ (R / 2)) := by
    intro m
    refine smth_dq_limit w x₀ (R / 2) (R / 2) (half_pos hR) (half_pos hR) ?_ m M α hα0 ?_
    · refine hw1.mono ?_
      rw [add_halves]
      exact hRS.trans hρS
    · intro h hpos hlt
      exact hM x₀ _ _ (smthDQ w m h) (hdata m h hpos (by linarith))
  
  have hcoord : ∀ (f : (Fin 2 → ℝ) → (Fin 2 → ℝ)) (C' α' : NNReal) (s : Set (Fin 2 → ℝ))
      (m : Fin 2), HolderOnWith C' α' f s → HolderOnWith C' α' (fun x => f x m) s := by
    intro f C' α' s m hf x hx y hy
    exact (edist_le_pi_edist (f x) (f y) m).trans (hf x hx y hy)
  have hR2 : 0 < R / 2 := half_pos hR
  have hRR : ball x₀ (R / 2) ⊆ ball x₀ R := ball_subset_ball (by linarith)
  refine ⟨ball x₀ (R / 2), isOpen_ball, mem_ball_self hR2, hRR.trans (hRS.trans hρS), ?_⟩
  refine ⟨fun x hx => hw.1 x (hρS (hRS (hRR hx))), fun m => ⟨?_, fun j => ⟨?_, ?_⟩⟩⟩
  · intro x hx
    exact ((hlim m).1.differentiableOn (by norm_num)).differentiableAt (isOpen_ball.mem_nhds hx)
  · exact (hcoord _ M α _ j (hlim m).2).continuousOn hα0
  · intro x hx
    have hxd := mem_ball.1 hx
    refine ⟨R / 2 - dist x x₀, M, α, by linarith, hα0, ?_, ?_⟩
    · exact ball_subset_ball' (by linarith)
    · exact (hcoord _ M α _ j (hlim m).2).mono (ball_subset_ball' (by linarith))

theorem smth_lin_deriv_eq (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ) (ha : ∀ i j : Fin 2, smthHolC 1 (fun x => a x i j) S) (hF : ∀ i : Fin 2, smthHolC 1 (fun x => F x i) S) (hw : smthHolC 2 w S) (heq : smthLinSol a F w S) (m : Fin 2) : smthLinSol a (fun x i => smthGrad (fun y => F y i) x m - ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) (fun x => smthGrad w x m) S :=
by
  
  have hw1 : ∀ j : Fin 2, smthHolC 1 (fun x => smthGrad w x j) S := fun j => hw.2 j
  have haC : ∀ i j : Fin 2, ContDiffOn ℝ 1 (fun x => a x i j) S := by
    intro i j
    have := smth_holC_contDiffOn 1 _ S hS (ha i j)
    exact_mod_cast this
  have hFC : ∀ i : Fin 2, ContDiffOn ℝ 1 (fun x => F x i) S := by
    intro i
    have := smth_holC_contDiffOn 1 _ S hS (hF i)
    exact_mod_cast this
  have hWC : ∀ j : Fin 2, ContDiffOn ℝ 1 (fun x => smthGrad w x j) S := by
    intro j
    have := smth_holC_contDiffOn 1 _ S hS (hw1 j)
    exact_mod_cast this
  have cA : ∀ i j : Fin 2, ContinuousOn (fun x => a x i j) S := fun i j => (haC i j).continuousOn
  have cF : ∀ i : Fin 2, ContinuousOn (fun x => F x i) S := fun i => (hFC i).continuousOn
  have cW : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad w x j) S :=
    fun j => (hWC j).continuousOn
  have cdA : ∀ i j : Fin 2, ContinuousOn (fun x => smthGrad (fun y => a y i j) x m) S :=
    fun i j => ((ha i j).2 m).1
  have cdF : ∀ i : Fin 2, ContinuousOn (fun x => smthGrad (fun y => F y i) x m) S :=
    fun i => ((hF i).2 m).1
  have cWW : ∀ j : Fin 2, ContinuousOn (fun x => smthGrad (fun y => smthGrad w y m) x j) S :=
    fun j => ((hw1 m).2 j).1
  
  have hφgrad : ∀ (φ : (Fin 2 → ℝ) → ℝ) (i : Fin 2), tsupport φ ⊆ S →
      tsupport (fun x => smthGrad φ x i) ⊆ S := by
    intro φ i hφD
    exact ((tsupport_comp_subset (g := fun L : (Fin 2 → ℝ) →L[ℝ] ℝ => L (Pi.single i 1))
      rfl (fderiv ℝ φ)).trans (tsupport_fderiv_subset ℝ)).trans hφD
  have hint : ∀ (f : (Fin 2 → ℝ) → ℝ) (φ : (Fin 2 → ℝ) → ℝ) (i : Fin 2), ContinuousOn f S →
      ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S →
      Integrable (fun x => f x * smthGrad φ x i) := by
    intro f φ i hf hφ hφc hφD
    have hgc : Continuous (fun x => smthGrad φ x i) :=
      (hφ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hgk : HasCompactSupport (fun x => smthGrad φ x i) :=
      HasCompactSupport.comp_left (g := fun L : (Fin 2 → ℝ) →L[ℝ] ℝ => L (Pi.single i 1))
        (hφc.fderiv ℝ) rfl
    have hcont : Continuous (fun x => f x * smthGrad φ x i) :=
      (hf.mul hgc.continuousOn).continuous_of_tsupport_subset hS
        (tsupport_mul_subset_right.trans (hφgrad φ i hφD))
    exact hcont.integrable_of_hasCompactSupport hgk.mul_left
  
  have hsymm : ∀ x ∈ S, ∀ j : Fin 2,
      smthGrad (fun y => smthGrad w y j) x m = smthGrad (fun y => smthGrad w y m) x j := by
    intro x hx j
    have hC2 : ContDiffOn ℝ 2 w S := by
      have := smth_holC_contDiffOn 2 w S hS hw
      exact_mod_cast this
    have hcd : ContDiffAt ℝ 2 w x := hC2.contDiffAt (hS.mem_nhds hx)
    have hSy : IsSymmSndFDerivAt ℝ w x := hcd.isSymmSndFDerivAt (by simp)
    have hdd : DifferentiableAt ℝ (fderiv ℝ w) x :=
      (hcd.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
    have key : ∀ j' m' : Fin 2, fderiv ℝ (fun y => smthGrad w y j') x (Pi.single m' 1) =
        fderiv ℝ (fderiv ℝ w) x (Pi.single m' 1) (Pi.single j' 1) := by
      intro j' m'
      show fderiv ℝ (fun y => fderiv ℝ w y (Pi.single j' 1)) x (Pi.single m' 1) = _
      rw [fderiv_clm_apply hdd (differentiableAt_const _)]
      simp
    show fderiv ℝ (fun y => smthGrad w y j) x (Pi.single m 1) =
      fderiv ℝ (fun y => smthGrad w y m) x (Pi.single j 1)
    rw [key, key]
    exact hSy _ _
  
  have hprod : ∀ x ∈ S, ∀ i : Fin 2,
      smthGrad (fun y => a y i 0 * smthGrad w y 0 + a y i 1 * smthGrad w y 1 - F y i) x m =
        smthGrad (fun y => a y i 0) x m * smthGrad w x 0 +
          a x i 0 * smthGrad (fun y => smthGrad w y 0) x m +
          (smthGrad (fun y => a y i 1) x m * smthGrad w x 1 +
            a x i 1 * smthGrad (fun y => smthGrad w y 1) x m) -
          smthGrad (fun y => F y i) x m := by
    intro x hx i
    have hd := (((((ha i 0).1 x hx).hasFDerivAt.mul ((hw1 0).1 x hx).hasFDerivAt).add
      (((ha i 1).1 x hx).hasFDerivAt.mul ((hw1 1).1 x hx).hasFDerivAt)).sub
        ((hF i).1 x hx).hasFDerivAt)
    have hfd : fderiv ℝ
        (fun y => a y i 0 * smthGrad w y 0 + a y i 1 * smthGrad w y 1 - F y i) x = _ :=
      hd.fderiv
    show fderiv ℝ (fun y => a y i 0 * smthGrad w y 0 + a y i 1 * smthGrad w y 1 - F y i) x
      (Pi.single m 1) = _
    rw [hfd]
    simp only [smthGrad, ContinuousLinearMap.sub_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hP : ∀ i : Fin 2, ContDiffOn ℝ 1
      (fun x => a x i 0 * smthGrad w x 0 + a x i 1 * smthGrad w x 1 - F x i) S :=
    fun i => (((haC i 0).mul (hWC 0)).add ((haC i 1).mul (hWC 1))).sub (hFC i)
  have heq' : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S →
      ∫ x, (∑ i : Fin 2, (a x i 0 * smthGrad w x 0 + a x i 1 * smthGrad w x 1 - F x i) *
        smthGrad φ x i + (0 : ℝ) * φ x) = 0 := by
    intro φ hφ hφc hφD
    have hL : Integrable
        (fun x => ∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i) :=
      integrable_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
        hint (fun x => a x i j * smthGrad w x j) φ i ((cA i j).mul (cW j)) hφ hφc hφD
    have hR : Integrable (fun x => ∑ i : Fin 2, F x i * smthGrad φ x i) :=
      integrable_finset_sum _ fun i _ => hint (fun x => F x i) φ i (cF i) hφ hφc hφD
    have hpt : (fun x => ∑ i : Fin 2, (a x i 0 * smthGrad w x 0 + a x i 1 * smthGrad w x 1 -
          F x i) * smthGrad φ x i + (0 : ℝ) * φ x) =
        fun x => (∑ i : Fin 2, ∑ j : Fin 2, a x i j * smthGrad w x j * smthGrad φ x i) -
          ∑ i : Fin 2, F x i * smthGrad φ x i := by
      funext x
      simp only [Fin.sum_univ_two]
      ring
    rw [hpt, integral_sub hL hR, heq φ hφ hφc hφD, sub_self]
  have hs : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ S →
      ∫ x, ∑ i : Fin 2, (smthGrad
        (fun y => a y i 0 * smthGrad w y 0 + a y i 1 * smthGrad w y 1 - F y i) x m -
          (if i = m then (0 : ℝ) else 0)) * smthGrad φ x i = 0 :=
    smth_ibp_shift S hS
      (fun x i => a x i 0 * smthGrad w x 0 + a x i 1 * smthGrad w x 1 - F x i)
      (fun _ => (0 : ℝ)) hP continuousOn_const heq' m
  
  intro φ hφ hφc hφD
  have hzero : ∀ x, x ∉ S → ∀ i : Fin 2, smthGrad φ x i = 0 :=
    fun x hx i => image_eq_zero_of_notMem_tsupport (f := fun y => smthGrad φ y i) (x := x)
      (fun h => hx (hφgrad φ i hφD h))
  have h0 := hs φ hφ hφc hφD
  have hL' : Integrable (fun x => ∑ i : Fin 2, ∑ j : Fin 2,
      a x i j * smthGrad (fun x => smthGrad w x m) x j * smthGrad φ x i) :=
    integrable_finset_sum _ fun i _ => integrable_finset_sum _ fun j _ =>
      hint (fun x => a x i j * smthGrad (fun x => smthGrad w x m) x j) φ i
        ((cA i j).mul (cWW j)) hφ hφc hφD
  have cFm : ∀ i : Fin 2, ContinuousOn (fun x => smthGrad (fun y => F y i) x m -
      ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) S :=
    fun i => (cdF i).sub (continuousOn_finset_sum _ (fun j _ => (cdA i j).mul (cW j)))
  have hR' : Integrable (fun x => ∑ i : Fin 2, (smthGrad (fun y => F y i) x m -
      ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) * smthGrad φ x i) :=
    integrable_finset_sum _ fun i _ => hint _ φ i (cFm i) hφ hφc hφD
  have hpt : (fun x => ∑ i : Fin 2, (smthGrad
        (fun y => a y i 0 * smthGrad w y 0 + a y i 1 * smthGrad w y 1 - F y i) x m -
          (if i = m then (0 : ℝ) else 0)) * smthGrad φ x i) =
      fun x => (∑ i : Fin 2, ∑ j : Fin 2,
          a x i j * smthGrad (fun x => smthGrad w x m) x j * smthGrad φ x i) -
        ∑ i : Fin 2, (smthGrad (fun y => F y i) x m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) * smthGrad φ x i := by
    funext x
    by_cases hx : x ∈ S
    · simp only [Fin.sum_univ_two, ite_self, sub_zero]
      rw [hprod x hx 0, hprod x hx 1, hsymm x hx 0, hsymm x hx 1]
      ring
    · simp only [Fin.sum_univ_two, hzero x hx 0, hzero x hx 1, mul_zero, add_zero, sub_zero]
  rw [hpt, integral_sub hL' hR'] at h0
  exact sub_eq_zero.mp h0

theorem smth_lin_higher (S : Set (Fin 2 → ℝ)) (hS : IsOpen S) (a : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ) (k : ℕ) (ha : ∀ i j : Fin 2, smthHolC (k + 1) (fun x => a x i j) S) (hell : ∀ x ∈ S, ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 → 0 < ∑ i : Fin 2, ∑ j : Fin 2, a x i j * ξ i * ξ j) : ∀ (F : (Fin 2 → ℝ) → Fin 2 → ℝ) (w : (Fin 2 → ℝ) → ℝ), (∀ i : Fin 2, smthHolC (k + 1) (fun x => F x i) S) → smthHolC 1 w S → smthLinSol a F w S → smthHolC (k + 2) w S :=
by
  have down : ∀ (j n : ℕ) (u : (Fin 2 → ℝ) → ℝ), smthHolC (j + n) u S → smthHolC n u S := by
    intro j
    induction j with
    | zero => intro n u h; simpa using h
    | succ j ih =>
      intro n u h
      apply ih n u
      apply smth_holC_mono (j + n) u S hS
      have e : j + 1 + n = j + n + 1 := by omega
      rw [e] at h
      exact h
  induction k with
  | zero =>
    intro F w hF hw heq
    exact smth_lin_C2_step S hS a F w ha hF hell hw heq
  | succ k ih =>
    intro F w hF hw heq
    have ha' : ∀ i j : Fin 2, smthHolC (k + 1) (fun x => a x i j) S :=
      fun i j => smth_holC_mono (k + 1) _ S hS (ha i j)
    have hF' : ∀ i : Fin 2, smthHolC (k + 1) (fun x => F x i) S :=
      fun i => smth_holC_mono (k + 1) _ S hS (hF i)
    have hw2 : smthHolC (k + 2) w S := ih ha' F w hF' hw heq
    have hwd : ∀ x ∈ S, DifferentiableAt ℝ w x := hw2.1
    have hW : ∀ j : Fin 2, smthHolC (k + 1) (fun x => smthGrad w x j) S := fun j => hw2.2 j
    have hwm : ∀ m : Fin 2, smthHolC (k + 2) (fun x => smthGrad w x m) S := by
      intro m
      have hFm : ∀ i : Fin 2, smthHolC (k + 1) (fun x => smthGrad (fun y => F y i) x m -
          ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) S := by
        intro i
        have hA : smthHolC (k + 1) (fun x => smthGrad (fun y => F y i) x m) S := (hF i).2 m
        have hB : ∀ j : Fin 2, smthHolC (k + 1) (fun x => smthGrad (fun y => a y i j) x m) S :=
          fun j => (ha i j).2 m
        have hc := (smth_holC_algebra (k + 1) _ _ S hS (-1) hA hA).1
        have p0 := (smth_holC_algebra (k + 1) _ _ S hS 0 (hB 0) (hW 0)).2.2
        have p1 := (smth_holC_algebra (k + 1) _ _ S hS 0 (hB 1) (hW 1)).2.2
        have s01 := (smth_holC_algebra (k + 1) _ _ S hS 0 p0 p1).2.1
        have ns := (smth_holC_algebra (k + 1) _ _ S hS 0 hc s01).2.2
        have tot := (smth_holC_algebra (k + 1) _ _ S hS 0 hA ns).2.1
        have e : (fun x => smthGrad (fun y => F y i) x m -
            ∑ j : Fin 2, smthGrad (fun y => a y i j) x m * smthGrad w x j) =
            (fun x => smthGrad (fun y => F y i) x m + (fun _ => (-1 : ℝ)) x *
              ((fun x => smthGrad (fun y => a y i 0) x m) x * (fun x => smthGrad w x 0) x +
                (fun x => smthGrad (fun y => a y i 1) x m) x * (fun x => smthGrad w x 1) x)) := by
          funext x
          simp only [Fin.sum_univ_two]
          ring
        rw [e]
        exact tot
      have hwm1 : smthHolC 1 (fun x => smthGrad w x m) S := down k 1 _ (hW m)
      have hlin := smth_lin_deriv_eq S hS a F w (fun i j => down k 1 _ (ha' i j))
        (fun i => down k 1 _ (hF' i)) (down k 2 w hw2) heq m
      exact ih ha' _ _ hFm hwm1 hlin
    exact ⟨hwd, hwm⟩

theorem smth_weak_holder_smooth (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O)
    (hell : ∀ w ∈ O, ∀ q : Fin 2 → ℝ, q ≠ 0 →
      0 < fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, q)) w (0, 0, q))
    (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v)
    (hvO : ∀ x ∈ D, (x, v x, smthGrad v x) ∈ O)
    (hEL : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D →
      ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0)
    (hhol : ∀ x₀ ∈ D, ∃ (ρ : ℝ) (C α : NNReal), 0 < ρ ∧ 0 < α ∧ Metric.ball x₀ ρ ⊆ D ∧
      HolderOnWith C α (smthGrad v) (Metric.ball x₀ ρ)) :
    ContDiffOn ℝ ∞ v D :=
by
  
  have down : ∀ (j k : ℕ) (u : (Fin 2 → ℝ) → ℝ), smthHolC (j + k) u D → smthHolC k u D := by
    intro j
    induction j with
    | zero => intro k u h; simpa using h
    | succ j ih =>
      intro k u h
      apply ih k u
      apply smth_holC_mono (j + k) u D hD
      have e : j + 1 + k = j + k + 1 := by omega
      rw [e] at h
      exact h
  have hinf0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hcoord : ∀ (f : (Fin 2 → ℝ) → (Fin 2 → ℝ)) (C α : NNReal) (s : Set (Fin 2 → ℝ))
      (m : Fin 2), HolderOnWith C α f s → HolderOnWith C α (fun x => f x m) s := by
    intro f C α s m hf x hx y hy
    exact (edist_le_pi_edist (f x) (f y) m).trans (hf x hx y hy)
  have hvdiff : ∀ x, DifferentiableAt ℝ v x := fun x => hv.differentiable (by norm_num) x
  
  
  
  have H2 : smthHolC 2 v D := by
    refine (smth_holC_local 2 v D hD).2 ?_
    intro x₀ hx₀
    obtain ⟨ρ, C, α, hρ, hα, hsub, hH⟩ := hhol x₀ hx₀
    obtain ⟨R, h₀, lam, K, β, hR, hh₀, hh₀R, hlam, hβ0, hβ1, h2R, hdata⟩ :=
      smth_dq_nonlinear_eq Λ O hO hΛ hell D hD v hv hvO hEL x₀ ρ C α hρ hα hsub hH
    obtain ⟨M, hM⟩ := smth_lin_schauder_est β lam K R hβ0 hβ1 hlam hR
    have hR2 : 0 < R / 2 := half_pos hR
    have hh' : 0 < min h₀ (R / 2) := lt_min hh₀ hR2
    have hlim : ∀ m : Fin 2,
        ContDiffOn ℝ 1 (fun x => smthGrad v x m) (Metric.ball x₀ (R / 2)) ∧
        HolderOnWith M β (smthGrad (fun x => smthGrad v x m)) (Metric.ball x₀ (R / 2)) := by
      intro m
      refine smth_dq_limit v x₀ (R / 2) (min h₀ (R / 2)) hR2 hh' hv.contDiffOn m M β hβ0 ?_
      intro h hpos hlt
      obtain ⟨a, F, hd⟩ := hdata m h hpos (lt_of_lt_of_le hlt (min_le_left _ _))
      exact hM x₀ a F (smthDQ v m h) hd
    refine ⟨Metric.ball x₀ (R / 2), Metric.isOpen_ball, Metric.mem_ball_self hR2, ?_, ?_⟩
    · exact (Metric.ball_subset_ball (by linarith)).trans hsub
    · refine ⟨fun x _ => hvdiff x, fun m => ⟨?_, fun j => ⟨?_, ?_⟩⟩⟩
      · intro x hx
        exact ((hlim m).1.differentiableOn (by norm_num)).differentiableAt
          (Metric.isOpen_ball.mem_nhds hx)
      · exact (hcoord _ M β _ j (hlim m).2).continuousOn hβ0
      · intro x hx
        have hxd := Metric.mem_ball.1 hx
        refine ⟨R / 2 - dist x x₀, M, β, by linarith, hβ0, ?_, ?_⟩
        · exact Metric.ball_subset_ball' (by linarith)
        · exact (hcoord _ M β _ j (hlim m).2).mono (Metric.ball_subset_ball' (by linarith))
  
  
  
  have hΛ1 : ContDiffOn ℝ ∞ (fderiv ℝ Λ) O := hΛ.fderiv_of_isOpen hO le_rfl
  have happ : ∀ c : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      ContDiffOn ℝ ∞ (fun w => fderiv ℝ Λ w c) O :=
    fun c => hΛ1.clm_apply contDiffOn_const
  have happ2 : ∀ c c' : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      ContDiffOn ℝ ∞ (fun w => fderiv ℝ (fun w' => fderiv ℝ Λ w' c) w c') O :=
    fun c c' => ((happ c).fderiv_of_isOpen hO le_rfl).clm_apply contDiffOn_const
  have hdiffO : ∀ (f : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ f O →
      ∀ z ∈ O, DifferentiableAt ℝ f z :=
    fun f hf z hz => (hf.differentiableOn hinf0).differentiableAt (hO.mem_nhds hz)
  have hdd2 : ∀ z ∈ O, DifferentiableAt ℝ (fderiv ℝ Λ) z :=
    fun z hz => (hΛ1.differentiableOn hinf0).differentiableAt (hO.mem_nhds hz)
  have hD2 : ∀ z ∈ O, ∀ c h : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      fderiv ℝ (fun w' => fderiv ℝ Λ w' c) z h = fderiv ℝ (fderiv ℝ Λ) z h c := by
    intro z hz c h
    rw [fderiv_clm_apply (hdd2 z hz) (differentiableAt_const c)]
    simp
  
  have hdec : ∀ (a : Fin 2 → ℝ) (t : ℝ) (p : Fin 2 → ℝ),
      ((a, t, p) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        (a, (0 : ℝ), (0 : Fin 2 → ℝ)) + t • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) +
          (p 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
            p 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
    intro a t p
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · funext i; simp
    · simp
    · funext i; fin_cases i <;> simp
  have hdec0 : ∀ (p : Fin 2 → ℝ),
      (((0 : Fin 2 → ℝ), (0 : ℝ), p) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
          p 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
            p 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ)) := by
    intro p
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · funext i; simp
    · simp
    · funext i; fin_cases i <;> simp
  
  have hφgrad : ∀ (φ : (Fin 2 → ℝ) → ℝ) (i : Fin 2), tsupport φ ⊆ D →
      tsupport (fun x => smthGrad φ x i) ⊆ D := by
    intro φ i hφD
    exact ((tsupport_comp_subset (g := fun L : (Fin 2 → ℝ) →L[ℝ] ℝ => L (Pi.single i 1))
      rfl (fderiv ℝ φ)).trans (tsupport_fderiv_subset ℝ)).trans hφD
  have hint : ∀ (f : (Fin 2 → ℝ) → ℝ) (φ : (Fin 2 → ℝ) → ℝ) (i : Fin 2), ContinuousOn f D →
      ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D →
      Integrable (fun x => f x * smthGrad φ x i) := by
    intro f φ i hf hφ hφc hφD
    have hgc : Continuous (fun x => smthGrad φ x i) :=
      (hφ.continuous_fderiv hinf0).clm_apply continuous_const
    have hgk : HasCompactSupport (fun x => smthGrad φ x i) :=
      HasCompactSupport.comp_left (g := fun L : (Fin 2 → ℝ) →L[ℝ] ℝ => L (Pi.single i 1))
        (hφc.fderiv ℝ) rfl
    have hcont : Continuous (fun x => f x * smthGrad φ x i) :=
      (hf.mul hgc.continuousOn).continuous_of_tsupport_subset hD
        (tsupport_mul_subset_right.trans (hφgrad φ i hφD))
    exact hcont.integrable_of_hasCompactSupport hgk.mul_left
  have abs_lem : ∀ (L R S : (Fin 2 → ℝ) → ℝ), Integrable R → Integrable S →
      (∀ x, L x = R x + S x) → ∫ x, S x = 0 → ∫ x, L x = ∫ x, R x := by
    intro L R S hR hS hpt h0
    rw [show L = fun x => R x + S x from funext hpt, integral_add hR hS, h0, add_zero]
  
  have hEL' : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D →
      ∫ x, (∑ i : Fin 2, fderiv ℝ Λ (x, v x, smthGrad v x) (0, 0, Pi.single i 1) *
          smthGrad φ x i + fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0) * φ x) = 0 := by
    intro φ hφ hφc hφD
    have h0 := hEL φ hφ hφc hφD
    have hz3 : (((0 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        0 := rfl
    have hzero : ∀ x, x ∉ D →
        fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0 := by
      intro x hx
      have hxt : x ∉ tsupport φ := fun h => hx (hφD h)
      have hφx : φ x = 0 := image_eq_zero_of_notMem_tsupport hxt
      have hdφ : fderiv ℝ φ x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun h => hxt (tsupport_fderiv_subset ℝ h))
      have hg : smthGrad φ x = 0 := by
        funext k; simp [smthGrad, hdφ]
      rw [hφx, hg, hz3]
      exact map_zero _
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero hzero] at h0
    have hfun : (fun x => ∑ i : Fin 2, fderiv ℝ Λ (x, v x, smthGrad v x) (0, 0, Pi.single i 1) *
          smthGrad φ x i + fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0) * φ x) =
        fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) := by
      funext x
      rw [hdec 0 (φ x) (smthGrad φ x), hz3]
      simp only [map_add, map_smul, smul_eq_mul, Fin.sum_univ_two, map_zero, zero_add]
      ring
    rw [hfun]
    exact h0
  
  
  
  have step : ∀ k : ℕ, smthHolC (k + 2) v D → smthHolC (k + 3) v D := by
    intro k hk
    have hkd : ∀ m : Fin 2, smthHolC (k + 1) (fun x => smthGrad v x m) D := fun m => hk.2 m
    have hgd : ∀ (j : Fin 2), ∀ x ∈ D, DifferentiableAt ℝ (fun y => smthGrad v y j) x :=
      fun j => (hkd j).1
    have hC2 : ContDiffOn ℝ 2 v D := by
      have := smth_holC_contDiffOn 2 v D hD (down k 2 v hk)
      exact_mod_cast this
    have comp : ∀ (Ψ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ), ContDiffOn ℝ ∞ Ψ O →
        smthHolC (k + 1) (fun x => Ψ (x, v x, smthGrad v x)) D :=
      fun Ψ hΨ => smth_holC_comp Ψ O hO hΨ D hD v (k + 1) hk hvO
    have cont0 : ∀ u : (Fin 2 → ℝ) → ℝ, smthHolC (k + 1) u D → ContinuousOn u D :=
      fun u h => (down (k + 1) 0 u h).1
    
    have hP : ∀ i : Fin 2, ContDiffOn ℝ 1
        (fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, 0, Pi.single i 1)) D := by
      intro i
      have h1 := down k 1 _ (comp _ (happ (0, 0, Pi.single i 1)))
      have := smth_holC_contDiffOn 1 _ D hD h1
      exact_mod_cast this
    have hQ : ContinuousOn (fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0)) D :=
      cont0 _ (comp _ (happ (0, 1, 0)))
    have hs8 := fun m => smth_ibp_shift D hD
      (fun x i => fderiv ℝ Λ (x, v x, smthGrad v x) (0, 0, Pi.single i 1))
      (fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0)) hP hQ hEL' m
    
    have hchain : ∀ x ∈ D, ∀ i m : Fin 2,
        smthGrad (fun y => fderiv ℝ Λ (y, v y, smthGrad v y) (0, 0, Pi.single i 1)) x m =
          fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
              (Pi.single m 1, 0, 0) +
            smthGrad v x m * fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
              (x, v x, smthGrad v x) (0, 1, 0) +
            (smthGrad (fun y => smthGrad v y m) x 0 *
                fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
                  (0, 0, Pi.single 0 1) +
              smthGrad (fun y => smthGrad v y m) x 1 *
                fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
                  (0, 0, Pi.single 1 1)) := by
      intro x hx i m
      have hXO := hvO x hx
      have hcd : ContDiffAt ℝ 2 v x := hC2.contDiffAt (hD.mem_nhds hx)
      have hS : IsSymmSndFDerivAt ℝ v x := hcd.isSymmSndFDerivAt (by simp)
      have hdd : DifferentiableAt ℝ (fderiv ℝ v) x :=
        (hcd.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
      have key : ∀ j m' : Fin 2, fderiv ℝ (fun y => smthGrad v y j) x (Pi.single m' 1) =
          fderiv ℝ (fderiv ℝ v) x (Pi.single m' 1) (Pi.single j 1) := by
        intro j m'
        show fderiv ℝ (fun y => fderiv ℝ v y (Pi.single j 1)) x (Pi.single m' 1) = _
        rw [fderiv_clm_apply hdd (differentiableAt_const _)]
        simp
      have hsym : ∀ j : Fin 2, fderiv ℝ (fun y => smthGrad v y j) x (Pi.single m 1) =
          smthGrad (fun y => smthGrad v y m) x j := by
        intro j
        show _ = fderiv ℝ (fun y => smthGrad v y m) x (Pi.single j 1)
        rw [key, key]
        exact hS _ _
      have hXd : HasFDerivAt (fun y => (y, v y, smthGrad v y))
          ((ContinuousLinearMap.id ℝ (Fin 2 → ℝ)).prod ((fderiv ℝ v x).prod
            (ContinuousLinearMap.pi fun j => fderiv ℝ (fun y => smthGrad v y j) x))) x := by
        refine (hasFDerivAt_id x).prodMk ((hvdiff x).hasFDerivAt.prodMk ?_)
        exact (hasFDerivAt_pi (φ := fun j y => smthGrad v y j)).2
          fun j => (hgd j x hx).hasFDerivAt
      have hg := (hdiffO _ (happ (0, 0, Pi.single i 1)) _ hXO).hasFDerivAt.comp x hXd
      show fderiv ℝ ((fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) ∘
          (fun y => (y, v y, smthGrad v y))) x (Pi.single m 1) = _
      rw [hg.fderiv]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
        ContinuousLinearMap.id_apply]
      rw [hdec (Pi.single m 1) _ _]
      simp only [map_add, map_smul, smul_eq_mul, ContinuousLinearMap.pi_apply, hsym]
      simp only [smthGrad]
    
    have hwm : ∀ m : Fin 2, smthHolC (k + 2) (fun x => smthGrad v x m) D := by
      intro m
      obtain ⟨F, hFdef⟩ : ∃ F : (Fin 2 → ℝ) → Fin 2 → ℝ, ∀ x i, F x i =
          -1 * fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
              (Pi.single m 1, 0, 0) +
            (-1 * (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
                (x, v x, smthGrad v x) (0, 1, 0) * smthGrad v x m) +
              (if i = m then fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0) else 0)) :=
        ⟨_, fun _ _ => rfl⟩
      obtain ⟨A, hAdef⟩ : ∃ A : (Fin 2 → ℝ) → Fin 2 → Fin 2 → ℝ, ∀ x i j, A x i j =
          fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
            (0, 0, Pi.single j 1) :=
        ⟨_, fun _ _ _ => rfl⟩
      have hAreg : ∀ i j : Fin 2, smthHolC (k + 1) (fun x => A x i j) D := by
        intro i j
        have e : (fun x => A x i j) = fun x =>
            fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
              (0, 0, Pi.single j 1) := funext fun x => hAdef x i j
        rw [e]
        exact comp _ (happ2 _ _)
      have hFreg : ∀ i : Fin 2, smthHolC (k + 1) (fun x => F x i) D := by
        intro i
        have e : (fun x => F x i) = fun x =>
            -1 * fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1)) (x, v x, smthGrad v x)
                (Pi.single m 1, 0, 0) +
              (-1 * (fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, Pi.single i 1))
                  (x, v x, smthGrad v x) (0, 1, 0) * smthGrad v x m) +
                (if i = m then fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0) else 0)) :=
          funext fun x => hFdef x i
        rw [e]
        have hc := comp _ (happ2 (0, 0, Pi.single i 1) (Pi.single m 1, 0, 0))
        have hb := comp _ (happ2 (0, 0, Pi.single i 1) (0, 1, 0))
        have hq := comp _ (happ (0, 1, 0))
        have hif : smthHolC (k + 1)
            (fun x => if i = m then fderiv ℝ Λ (x, v x, smthGrad v x) (0, 1, 0) else 0) D := by
          by_cases him : i = m
          · simp only [if_pos him]; exact hq
          · simp only [if_neg him]; exact (smth_holC_algebra (k + 1) _ _ D hD 0 hq hq).1
        have hneg := (smth_holC_algebra (k + 1) _ _ D hD (-1) hq hq).1
        have t1 := (smth_holC_algebra (k + 1) _ _ D hD 0 hneg hc).2.2
        have t2 := (smth_holC_algebra (k + 1) _ _ D hD 0 hb (hkd m)).2.2
        have t3 := (smth_holC_algebra (k + 1) _ _ D hD 0 hneg t2).2.2
        have t4 := (smth_holC_algebra (k + 1) _ _ D hD 0 t3 hif).2.1
        exact (smth_holC_algebra (k + 1) _ _ D hD 0 t1 t4).2.1
      have hellA : ∀ x ∈ D, ∀ ξ : Fin 2 → ℝ, ξ ≠ 0 →
          0 < ∑ i : Fin 2, ∑ j : Fin 2, A x i j * ξ i * ξ j := by
        intro x hx ξ hξ
        have hX := hvO x hx
        have h := hell _ hX ξ hξ
        simp only [hAdef, hD2 _ hX] at h ⊢
        rw [hdec0 ξ] at h
        simp only [map_add, map_smul, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul] at h
        simp only [Fin.sum_univ_two]
        linarith
      have hlin : smthLinSol A F (fun x => smthGrad v x m) D := by
        intro φ hφ hφc hφD
        have h8 := hs8 m φ hφ hφc hφD
        have hg0 : ∀ x, x ∉ D → ∀ i, smthGrad φ x i = 0 :=
          fun x hx i => image_eq_zero_of_notMem_tsupport (f := fun y => smthGrad φ y i) (x := x)
            (fun h => hx (hφgrad φ i hφD h))
        refine abs_lem _ _ _ ?_ ?_ ?_ h8
        · refine integrable_finset_sum _ (fun i _ => ?_)
          exact hint _ φ i (cont0 _ (hFreg i)) hφ hφc hφD
        · refine integrable_finset_sum _ (fun i _ => ?_)
          refine hint _ φ i ?_ hφ hφc hφD
          refine ContinuousOn.sub ?_ ?_
          · exact (down k 0 _ ((comp _ (happ (0, 0, Pi.single i 1))).2 m)).1
          · by_cases him : i = m
            · simp only [if_pos him]; exact hQ
            · simp only [if_neg him]; exact continuousOn_const
        · intro x
          by_cases hx : x ∈ D
          · simp only [Fin.sum_univ_two, hFdef, hAdef]
            rw [hchain x hx 0 m, hchain x hx 1 m]
            ring
          · simp only [Fin.sum_univ_two, hg0 x hx 0, hg0 x hx 1, mul_zero, add_zero]
      exact smth_lin_higher D hD A k hAreg hellA F (fun x => smthGrad v x m) hFreg
        (down k 1 _ (hkd m)) hlin
    exact ⟨fun x _ => hvdiff x, hwm⟩
  
  
  
  have Hall : ∀ n : ℕ, smthHolC (n + 2) v D := by
    intro n
    induction n with
    | zero => simpa using H2
    | succ n ih => exact step n ih
  rw [contDiffOn_infty]
  intro n
  exact smth_holC_contDiffOn n v D hD (down 2 n v (by rw [Nat.add_comm]; exact Hall n))

theorem smth_strongEL_of_weak (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O)
    (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiffOn ℝ ∞ v D)
    (hvO : ∀ x ∈ D, (x, v x, smthGrad v x) ∈ O)
    (hEL : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D →
      ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0) :
    ∀ x ∈ D, smthELop Λ v x = 0 :=
by
  classical
  
  have hmul : ∀ (g ψ : (Fin 2 → ℝ) → ℝ) (K : Set (Fin 2 → ℝ)), IsCompact K → K ⊆ D →
      ContinuousOn g D → Continuous ψ → (∀ x ∉ K, ψ x = 0) →
      Continuous (fun x => g x * ψ x) ∧ Integrable (fun x => g x * ψ x) := by
    intro g ψ K hK hKD hg hψ hψK
    have hc : Continuous (fun x => g x * ψ x) := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ D
      · exact (hg.continuousAt (hD.mem_nhds hx)).mul hψ.continuousAt
      · have hxK : x ∉ K := fun h => hx (hKD h)
        have hev : (fun _ => (0:ℝ)) =ᶠ[𝓝 x] (fun x => g x * ψ x) := by
          filter_upwards [hK.isClosed.isOpen_compl.mem_nhds hxK] with y hy
          rw [hψK y hy, mul_zero]
        exact continuousAt_const.congr hev
    refine ⟨hc, hc.integrable_of_hasCompactSupport ?_⟩
    exact HasCompactSupport.intro hK (fun x hx => by simp [hψK x hx])
  
  have hZ0 : ∀ (φ : (Fin 2 → ℝ) → ℝ) (x : Fin 2 → ℝ), x ∉ tsupport φ → φ x = 0 :=
    fun φ x hx => image_eq_zero_of_notMem_tsupport hx
  have hZ1 : ∀ (φ : (Fin 2 → ℝ) → ℝ) (x : Fin 2 → ℝ), x ∉ tsupport φ → fderiv ℝ φ x = 0 := by
    intro φ x hx
    by_contra h
    exact hx (support_fderiv_subset ℝ (Function.mem_support.2 h))
  
  have hΛ' : ContDiffOn ℝ ∞ (fderiv ℝ Λ) O := ((contDiffOn_infty_iff_fderiv_of_isOpen hO).1 hΛ).2
  have hv' : ContDiffOn ℝ ∞ (fderiv ℝ v) D := ((contDiffOn_infty_iff_fderiv_of_isOpen hD).1 hv).2
  have hgrad : ContDiffOn ℝ ∞ (smthGrad v) D := by
    rw [contDiffOn_pi]
    intro k
    exact hv'.clm_apply contDiffOn_const
  have hΨ : ContDiffOn ℝ ∞ (fun y => (y, v y, smthGrad v y)) D :=
    contDiffOn_id.prodMk (hv.prodMk hgrad)
  have hcoef : ∀ w, ContDiffOn ℝ ∞ (fun y => fderiv ℝ Λ (y, v y, smthGrad v y) w) D := by
    intro w
    exact (hΛ'.comp hΨ (fun y hy => hvO y hy)).clm_apply contDiffOn_const
  obtain ⟨B, hBdef⟩ : ∃ B : (Fin 2 → ℝ) → ℝ,
      B = fun y => fderiv ℝ Λ (y, v y, smthGrad v y) (0, 1, 0) := ⟨_, rfl⟩
  obtain ⟨P, hPdef⟩ : ∃ P : Fin 2 → (Fin 2 → ℝ) → ℝ,
      P = fun k y => fderiv ℝ Λ (y, v y, smthGrad v y) (0, 0, Pi.single k 1) := ⟨_, rfl⟩
  obtain ⟨Q, hQdef⟩ : ∃ Q : Fin 2 → (Fin 2 → ℝ) → ℝ,
      Q = fun k y => fderiv ℝ (P k) y (Pi.single k 1) := ⟨_, rfl⟩
  have hE : ∀ y, smthELop Λ v y = B y - ∑ k, Q k y := by
    intro y
    rw [hQdef, hPdef, hBdef]
    rfl
  have hBc : ContinuousOn B D := by rw [hBdef]; exact (hcoef _).continuousOn
  have hPs : ∀ k, ContDiffOn ℝ ∞ (P k) D := by intro k; rw [hPdef]; exact hcoef _
  have hQc : ∀ k, ContinuousOn (Q k) D := by
    intro k
    rw [hQdef]
    exact ((hPs k).continuousOn_fderiv_of_isOpen hD (by simp)).clm_apply continuousOn_const
  have hEc : ContinuousOn (smthELop Λ v) D :=
    (hBc.sub (continuousOn_finset_sum _ fun k _ => hQc k)).congr (fun y _ => hE y)
  
  have hint0 : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D →
      ∫ x, smthELop Λ v x * φ x = 0 := by
    intro φ hφ hφc hφD
    have hK : IsCompact (tsupport φ) := hφc
    have hφ1 : ContDiff ℝ 1 φ := hφ.of_le (by simp)
    have hφd : Differentiable ℝ φ := hφ1.differentiable (by simp)
    have hdφ : ∀ w, Continuous (fun x => fderiv ℝ φ x w) := fun w =>
      (hφ1.continuous_fderiv (by simp)).clm_apply continuous_const
    have hlin : ∀ x, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) =
        B x * φ x + ∑ k, P k x * fderiv ℝ φ x (Pi.single k 1) := by
      intro x
      rw [hBdef, hPdef]
      simp only [Fin.sum_univ_two]
      have hvec : ((0 : Fin 2 → ℝ), φ x, smthGrad φ x) =
          φ x • ((0 : Fin 2 → ℝ), (1:ℝ), (0 : Fin 2 → ℝ)) +
          (fderiv ℝ φ x (Pi.single 0 1) • ((0 : Fin 2 → ℝ), (0:ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
           fderiv ℝ φ x (Pi.single 1 1) • ((0 : Fin 2 → ℝ), (0:ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
        refine Prod.ext ?_ (Prod.ext ?_ ?_)
        · simp
        · simp
        · funext i
          fin_cases i <;> simp [smthGrad]
      rw [hvec, map_add, map_add, map_smul, map_smul, map_smul, smul_eq_mul, smul_eq_mul,
        smul_eq_mul]
      ring
    have hoff : ∀ x, x ∉ D → fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0 := by
      intro x hx
      have hxK : x ∉ tsupport φ := fun h => hx (hφD h)
      rw [hlin, hZ0 φ x hxK, hZ1 φ x hxK]
      simp
    have h1 := hEL φ hφ hφc hφD
    rw [setIntegral_eq_integral_of_forall_compl_eq_zero hoff] at h1
    have h2 : ∫ x, (B x * φ x + ∑ k, P k x * fderiv ℝ φ x (Pi.single k 1)) = 0 := by
      rw [← h1]
      congr 1
      funext x
      exact (hlin x).symm
    have hiB : Integrable (fun x => B x * φ x) :=
      (hmul B φ _ hK hφD hBc hφ.continuous (hZ0 φ)).2
    have hiP : ∀ k, Integrable (fun x => P k x * fderiv ℝ φ x (Pi.single k 1)) := fun k =>
      (hmul (P k) _ _ hK hφD (hPs k).continuousOn (hdφ _)
        (fun x hx => by simp [hZ1 φ x hx])).2
    have hiQ : ∀ k, Integrable (fun x => Q k x * φ x) := fun k =>
      (hmul (Q k) φ _ hK hφD (hQc k) hφ.continuous (hZ0 φ)).2
    have hibp : ∀ k, ∫ x, P k x * fderiv ℝ φ x (Pi.single k 1) = -∫ x, Q k x * φ x := by
      intro k
      have hdiff : Differentiable ℝ (fun x => P k x * φ x) := by
        intro x
        by_cases hx : x ∈ D
        · exact (((hPs k).differentiableOn (by simp)).differentiableAt
            (hD.mem_nhds hx)).mul (hφd x)
        · have hxK : x ∉ tsupport φ := fun h => hx (hφD h)
          have hev : (fun _ => (0:ℝ)) =ᶠ[𝓝 x] (fun x => P k x * φ x) := by
            filter_upwards [(isClosed_tsupport φ).isOpen_compl.mem_nhds hxK] with y hy
            rw [hZ0 φ y hy, mul_zero]
          exact (differentiableAt_const _).congr_of_eventuallyEq hev.symm
      have hprod : ∀ x, fderiv ℝ (fun x => P k x * φ x) x (Pi.single k 1) =
          Q k x * φ x + P k x * fderiv ℝ φ x (Pi.single k 1) := by
        intro x
        by_cases hx : x ∈ D
        · have hPd := ((hPs k).differentiableOn (by simp)).differentiableAt (hD.mem_nhds hx)
          have hh : HasFDerivAt (fun y => P k y * φ y)
              (P k x • fderiv ℝ φ x + φ x • fderiv ℝ (P k) x) x :=
            hPd.hasFDerivAt.mul (hφd x).hasFDerivAt
          rw [hh.fderiv, hQdef]
          simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
          ring
        · have hxK : x ∉ tsupport φ := fun h => hx (hφD h)
          have hev : (fun x => P k x * φ x) =ᶠ[𝓝 x] (fun _ => (0:ℝ)) := by
            filter_upwards [(isClosed_tsupport φ).isOpen_compl.mem_nhds hxK] with y hy
            rw [hZ0 φ y hy, mul_zero]
          rw [hev.fderiv_eq, hZ0 φ x hxK, hZ1 φ x hxK]
          simp
      have hfun : (fun x => fderiv ℝ (fun x => P k x * φ x) x (Pi.single k 1)) =
          fun x => Q k x * φ x + P k x * fderiv ℝ φ x (Pi.single k 1) := funext hprod
      have hiH : Integrable (fun x => P k x * φ x) :=
        (hmul (P k) φ _ hK hφD (hPs k).continuousOn hφ.continuous (hZ0 φ)).2
      have hzero : ∫ x, fderiv ℝ (fun x => P k x * φ x) x (Pi.single k 1) = 0 := by
        have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
          (f := fun _ => (1:ℝ)) (g := fun x => P k x * φ x) (v := Pi.single k 1)
          (by simp) (by simp only [one_mul]; rw [hfun]; exact (hiQ k).add (hiP k))
          (by simp only [one_mul]; exact hiH) (differentiable_const _) hdiff
        simpa using h
      rw [hfun, integral_add (hiQ k) (hiP k)] at hzero
      linarith
    rw [integral_add hiB (integrable_finset_sum _ fun k _ => hiP k),
      integral_finset_sum _ fun k _ => hiP k] at h2
    calc ∫ x, smthELop Λ v x * φ x = ∫ x, (B x * φ x - ∑ k, Q k x * φ x) := by
          congr 1; funext x; rw [hE, sub_mul, Finset.sum_mul]
      _ = (∫ x, B x * φ x) - ∑ k, ∫ x, Q k x * φ x := by
          rw [integral_sub hiB (integrable_finset_sum _ fun k _ => hiQ k),
            integral_finset_sum _ fun k _ => hiQ k]
      _ = (∫ x, B x * φ x) + ∑ k, ∫ x, P k x * fderiv ℝ φ x (Pi.single k 1) := by
          rw [Finset.sum_congr rfl (fun k _ => hibp k), Finset.sum_neg_distrib, sub_eq_add_neg]
      _ = 0 := h2
  
  intro x₁ hx₁
  by_contra hne
  have hcont : ContinuousAt (fun y => smthELop Λ v x₁ * smthELop Λ v y) x₁ :=
    continuousAt_const.mul (hEc.continuousAt (hD.mem_nhds hx₁))
  have hpos : 0 < smthELop Λ v x₁ * smthELop Λ v x₁ := mul_self_pos.2 hne
  have hS : {y | 0 < smthELop Λ v x₁ * smthELop Λ v y} ∈ 𝓝 x₁ :=
    hcont.eventually (lt_mem_nhds hpos)
  obtain ⟨φ, hφs, hφc, hφd, hφr, hφ1⟩ :=
    exists_contDiff_tsupport_subset (n := ⊤) (Filter.inter_mem (hD.mem_nhds hx₁) hS)
  have hφD : tsupport φ ⊆ D := fun y hy => (hφs hy).1
  have h0 := hint0 φ hφd hφc hφD
  have hf_nonneg : ∀ y, 0 ≤ smthELop Λ v x₁ * smthELop Λ v y * φ y := by
    intro y
    by_cases hy : y ∈ tsupport φ
    · exact mul_nonneg (le_of_lt (hφs hy).2) (hφr ⟨y, rfl⟩).1
    · rw [hZ0 φ y hy, mul_zero]
  have hfc := hmul (fun y => smthELop Λ v x₁ * smthELop Λ v y) φ (tsupport φ) hφc hφD
    (continuousOn_const.mul hEc) hφd.continuous (hZ0 φ)
  have hint : ∫ y, smthELop Λ v x₁ * smthELop Λ v y * φ y = 0 := by
    simp_rw [mul_assoc]
    rw [integral_const_mul, h0, mul_zero]
  have hsupp : 0 < volume (Function.support fun y => smthELop Λ v x₁ * smthELop Λ v y * φ y) := by
    refine hfc.1.isOpen_support.measure_pos volume ⟨x₁, ?_⟩
    simp only [Function.mem_support, hφ1, mul_one]
    exact hpos.ne'
  have := (integral_pos_iff_support_of_nonneg hf_nonneg hfc.2).2 hsupp
  linarith

theorem smth_ELop_eq_meanCurv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (a : Fin 3) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ ∞ v) (x : Fin 2 → ℝ)
    (hx : smthLift a x (v x) ∈ U) :
    smthELop (smthLag G a) v x = Real.sqrt (G (smthLift a x (v x))).det *
      levelMeanCurvCoord G (fun w => w a - v (smthHoriz a w)) (smthLift a x (v x)) :=
by
  classical
  
  
  have inv_entry : ∀ (x : E3) (m : Fin 3),
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x) → (G x).det ≠ 0 →
      ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
        partialDeriv m (fun y => (G y)⁻¹ k l) x =
          -∑ a : Fin 3, ∑ b : Fin 3,
            (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := by
    intro x m hG hdet
    have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
        DifferentiableAt ℝ (fun y => (H y).det) x := by
      intro H hH
      have hfun : (fun y => (H y).det) = fun y =>
          H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
        funext y; exact Matrix.det_fin_three (H y)
      rw [hfun]
      have h00 := hH 0 0
      have h01 := hH 0 1
      have h02 := hH 0 2
      have h10 := hH 1 0
      have h11 := hH 1 1
      have h12 := hH 1 2
      have h20 := hH 2 0
      have h21 := hH 2 1
      have h22 := hH 2 2
      fun_prop
    have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
    have hP : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
      intro k l
      have hfun : (fun y => (G y)⁻¹ k l) =
          fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
        funext y
        rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
          smul_eq_mul]
      rw [hfun]
      refine (hD.inv hdet).mul (hdetD _ ?_)
      intro a b
      by_cases hal : a = l
      · subst hal
        simp only [Matrix.updateRow_self]
        exact differentiableAt_const _
      · simp only [Matrix.updateRow_ne hal]
        exact hG a b
    have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
        + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (∑ b : Fin 3, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
            + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b y => G y a b * (G y)⁻¹ b l)
          (fun b _ => (hG a b).hasFDerivAt.mul (hP b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) x := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
        filter_upwards [hev] with y hy
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    refine ⟨hP k l, ?_⟩
    let Xm : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun y => (G y)⁻¹ b l) x
    let Dm : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun y => G y a b) x
    have hM : G x * Xm = -(Dm * (G x)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [Xm, Dm, Matrix.of_apply]
      exact hE a l'
    have hX : Xm = -((G x)⁻¹ * (Dm * (G x)⁻¹)) := by
      calc Xm = ((G x)⁻¹ * G x) * Xm := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
        _ = (G x)⁻¹ * (G x * Xm) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [Xm, Dm, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  
  have hdivx : ∀ (f : E3 → ℝ) (T : Set E3), IsOpen T →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) → (∀ z ∈ T, (G z).PosDef) →
      ContDiffOn ℝ ∞ f T → ∀ (X : E3 → E3), (∀ z ∈ T, ∀ i : Fin 3, X z i = calUnitNormal G f z i) →
      ∀ (y : E3), y ∈ T →
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y →
      sepDensDiv G X y = Real.sqrt (G y).det * levelMeanCurvCoord G f y := by
    intro f T hT hG hpd hf X hX y hy hN
    
    have key : ∀ (Ginv : Matrix (Fin 3) (Fin 3) ℝ) (dS : Fin 3 → ℝ)
        (dGi : Fin 3 → Fin 3 → Fin 3 → ℝ) (Γp : Fin 3 → Fin 3 → ℝ) (p : Fin 3 → ℝ)
        (h : Fin 3 → Fin 3 → ℝ) (s N : ℝ), (∀ a b : Fin 3, Ginv a b = Ginv b a) →
        (∑ i : Fin 3, dS i * ∑ k : Fin 3, Ginv i k * p k +
            s * ∑ i : Fin 3, ∑ k : Fin 3, dGi i i k * p k =
          -(s * ∑ i : Fin 3, ∑ j : Fin 3, Ginv i j * Γp i j)) →
        (∑ i : Fin 3, (∑ k : Fin 3, Ginv i k * p k) * ∑ a : Fin 3, ∑ b : Fin 3,
            dGi i a b * p a * p b =
          -2 * ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
            Ginv i a * p a * (Ginv j b * p b) * Γp i j) →
        ∑ i : Fin 3, (dS i * (N⁻¹ * ∑ k : Fin 3, Ginv i k * p k) +
          s * (-((∑ a : Fin 3, ∑ b : Fin 3, (dGi i a b * p a * p b + Ginv a b * h i a * p b +
              Ginv a b * p a * h i b)) / (2 * N ^ 3)) * ∑ k : Fin 3, Ginv i k * p k +
            N⁻¹ * ∑ k : Fin 3, (dGi i i k * p k + Ginv i k * h i k))) =
        s * ((∑ i : Fin 3, ∑ j : Fin 3, Ginv i j * (h i j - Γp i j)) / N -
          (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
            Ginv i a * p a * (Ginv j b * p b) * (h i j - Γp i j)) / N ^ 3) := by
      intro Ginv dS dGi Γp p h s N hsym hA1 hA2
      have e10 := hsym 1 0
      have e20 := hsym 2 0
      have e21 := hsym 2 1
      simp only [Fin.sum_univ_three, e10, e20, e21] at hA1 hA2 ⊢
      linear_combination N⁻¹ * hA1 - (s * N⁻¹ ^ 3 / 2) * hA2
    
    have hTy : T ∈ 𝓝 y := hT.mem_nhds hy
    have hdet : 0 < (G y).det := (hpd y hy).det_pos
    have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y := fun a b =>
      ((hG a b).differentiableOn (by simp)).differentiableAt hTy
    have hpd' : ∀ a : Fin 3, DifferentiableAt ℝ (partialDeriv a f) y := by
      intro a
