    exact (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hwc : ∀ a b, ContinuousOn (w a b) (Metric.ball (A.c j) (A.r j)) := by
    intro a b
    refine ContinuousOn.congr ?_ (fun x _ => hw a b x)
    exact (((hcc j f f hf hf).2.2.2.1).mul ((hcc j f f hf hf).2.2.2.2 a b)).mul
      (hζd a).continuousOn
  have hwL2 : ∀ a b, MemLp (w a b) 2 (volume.restrict (ndsHalf (A.c j) (A.r j))) :=
    fun a b => ((hHb j).2.2 _ (hwc a b)).1
  have hint : ∀ n, Set.EqOn
      (fun x => g.gradInner φ (U n : M → ℝ) (A.κ j x) * Real.sqrt (g.coeff (A.κ j) x).det)
      (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
        partialDeriv b (fun z => (U n : M → ℝ) (A.κ j z)) x * w a b x)
      (ndsHalf (A.c j) (A.r j)) := by
    intro n x hx
