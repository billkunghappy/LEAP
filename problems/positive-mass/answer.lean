theorem pcgb_kato_identity (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef)
    (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w W) (hharm : ∀ x ∈ W, lap2 h w x = 0) (ε : ℝ) (hε : 0 < ε)
    (x : E2) (hx : x ∈ W) :
    lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
      gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
      ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
           (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
           (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
        (sgbGradSq2 h w x + ε) ^ 2 :=
by
  
  have hsymm : ∀ z ∈ W, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have h1 := (hpos z hz).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  have G := gs2_metric_calculus h W hW hh hsymm hpos
  have hω : ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a w) W := by
    intro a
    have h1 := hw.fderiv_of_isOpen hW (m := ∞) (by simp)
    exact h1.clm_apply contDiffOn_const
  
  have hGs : ContDiffOn ℝ ∞ (sgbGradSq2 h w) W := by
    show ContDiffOn ℝ ∞ (fun y => ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a w y * pd2 c w y) W
    refine ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ => ?_))
    exact ((G.1 a c).mul (hω a)).mul (hω c)
  have hGnn : ∀ y ∈ W, 0 ≤ sgbGradSq2 h w y := by
    intro y hy
    exact ((posDef_inv_quad_facts (h y) (hpos y hy)).1 (fun a => pd2 a w y)).1
  
  have chain : ∀ F : E2 → ℝ, ContDiffOn ℝ ∞ F W → (∀ y ∈ W, 0 < F y + ε) →
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) x =
        lap2 h F x / (2 * (F x + ε)) -
          (∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j * pd2 i F x * pd2 j F x) /
            (2 * (F x + ε) ^ 2) := by
    intro F hF hFε
    have hFd : ∀ y ∈ W, DifferentiableAt ℝ F y := fun y hy =>
      (hF.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
    have hstar : ∀ y ∈ W, ∀ j : Fin 2,
        pd2 j (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) y =
          (1 / 2 : ℝ) * ((F y + ε)⁻¹ * pd2 j F y) := by
      intro y hy j
      have h1 : HasFDerivAt (fun y => F y + ε) (fderiv ℝ F y) y :=
        (hFd y hy).hasFDerivAt.add_const ε
      have h2 := h1.log (hFε y hy).ne'
      have h3 := h2.const_mul (1 / 2 : ℝ)
      unfold pd2
      rw [h3.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hQ : F x + ε ≠ 0 := (hFε x hx).ne'
    have hDF : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j F) x := by
      intro j
      have h1 := hF.fderiv_of_isOpen hW (m := ∞) (by simp)
      exact ((h1.clm_apply contDiffOn_const).differentiableOn (by simp)).differentiableAt
        (hW.mem_nhds hx)
    have hinv : HasFDerivAt (fun y => (F y + ε)⁻¹) ((-((F x + ε) ^ 2)⁻¹) • fderiv ℝ F x) x := by
      have h1 : HasFDerivAt (fun y => F y + ε) (fderiv ℝ F x) x :=
        (hFd x hx).hasFDerivAt.add_const ε
      exact (hasDerivAt_inv hQ).comp_hasFDerivAt x h1
    have hstar2 : ∀ i j : Fin 2,
        pd2 i (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (F y + ε))) x =
          (1 / 2 : ℝ) * ((-((F x + ε) ^ 2)⁻¹) * pd2 i F x * pd2 j F x +
            (F x + ε)⁻¹ * pd2 i (pd2 j F) x) := by
      intro i j
      have hev : pd2 j (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) =ᶠ[𝓝 x]
          (fun y => (1 / 2 : ℝ) * ((F y + ε)⁻¹ * pd2 j F y)) :=
        Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => hstar y hy j)
      have hd : HasFDerivAt (fun y => (1 / 2 : ℝ) * ((F y + ε)⁻¹ * pd2 j F y)) _ x :=
        (hinv.mul (hDF j).hasFDerivAt).const_mul (1 / 2 : ℝ)
      show fderiv ℝ (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (F y + ε))) x (e2 i) = _
      rw [hev.fderiv_eq, hd.fderiv]
      rw [show pd2 i (pd2 j F) x = fderiv ℝ (pd2 j F) x (e2 i) from rfl,
        show pd2 i F x = fderiv ℝ F x (e2 i) from rfl]
      simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply, smul_eq_mul]
      ring
    have hstar1 : ∀ k : Fin 2, pd2 k (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) x =
        (1 / 2 : ℝ) * ((F x + ε)⁻¹ * pd2 k F x) := fun k => hstar x hx k
    unfold lap2
    simp only [hstar2, hstar1, Fin.sum_univ_two]
    field_simp
    ring
  
  have hlapw : ∀ b : Fin 2, pd2 b (lap2 h w) x = 0 := by
    intro b
    have hev : lap2 h w =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => hharm y hy)
    show fderiv ℝ (lap2 h w) x (e2 b) = 0
    rw [hev.fderiv_eq]
    simp
  have hA : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := G.2.1 x hx 1 0
  have hH : (fun i j => pd2 i (pd2 j w) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k w x) 1 0 =
      (fun i j => pd2 i (pd2 j w) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k w x) 0 1 := by
    show pd2 1 (pd2 0 w) x - ∑ k : Fin 2, christoffel2 h k 1 0 x * pd2 k w x =
      pd2 0 (pd2 1 w) x - ∑ k : Fin 2, christoffel2 h k 0 1 x * pd2 k w x
    rw [elr_cacc_pd2_comm W hW w hw x hx 1 0]
    congr 1
    exact Finset.sum_congr rfl (fun k _ => by rw [G.2.2.2.1 x hx k 1 0])
  have htr : ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
      (fun i j => pd2 i (pd2 j w) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k w x) i j = 0 :=
    hharm x hx
  
  have alg : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (H : Fin 2 → Fin 2 → ℝ) (v : Fin 2 → ℝ),
      A 1 0 = A 0 1 → H 1 0 = H 0 1 → ∑ i : Fin 2, ∑ j : Fin 2, A i j * H i j = 0 →
      ∑ i : Fin 2, ∑ j : Fin 2, A i j * (2 * ∑ a : Fin 2, ∑ b : Fin 2, A a b * H i a * v b) *
          (2 * ∑ a : Fin 2, ∑ b : Fin 2, A a b * H j a * v b) =
        2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, A a c * A b d * H a b * H c d) *
          (∑ a : Fin 2, ∑ c : Fin 2, A a c * v a * v c) := by
    intro A H v hA' hH' htr'
    simp only [Fin.sum_univ_two] at htr' ⊢
    rw [hA', hH'] at htr' ⊢
    linear_combination
      (4 * (H 0 0 * (A 0 0 * v 0 + A 0 1 * v 1) ^ 2 +
          2 * H 0 1 * (A 0 0 * v 0 + A 0 1 * v 1) * (A 0 1 * v 0 + A 1 1 * v 1) +
          H 1 1 * (A 0 1 * v 0 + A 1 1 * v 1) ^ 2) -
        2 * (A 0 0 * H 0 0 + 2 * A 0 1 * H 0 1 + A 1 1 * H 1 1) *
          (A 0 0 * v 0 ^ 2 + 2 * A 0 1 * v 0 * v 1 + A 1 1 * v 1 ^ 2)) * htr'
  have key := alg (h x)⁻¹
    (fun i j => pd2 i (pd2 j w) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k w x)
    (fun b => pd2 b w x) hA hH htr
  
  have hgrad : ∀ c : Fin 2, pd2 c (sgbGradSq2 h w) x =
      2 * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
        (pd2 c (pd2 a w) x - ∑ k : Fin 2, christoffel2 h k c a x * pd2 k w x) * pd2 b w x :=
    fun c => bl2_grad_Q W hW h hh hpos w hw x hx c
  have hgsq : ∑ i : Fin 2, ∑ j : Fin 2,
      (h x)⁻¹ i j * pd2 i (sgbGradSq2 h w) x * pd2 j (sgbGradSq2 h w) x =
      2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
           (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
           (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) *
        sgbGradSq2 h w x := by
    simp only [hgrad]
    exact key
  
  have hB : lap2 h (sgbGradSq2 h w) x =
      2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
           (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
           (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) +
        2 * gaussCurv2 h x * sgbGradSq2 h w x := by
    have := bochner_lap2_identity W hW h hh hpos w hw x hx
    simp only [hlapw, mul_zero, Finset.sum_const_zero, add_zero] at this
    exact this
  
  have hL := chain (sgbGradSq2 h w) hGs (fun y hy => by linarith [hGnn y hy])
  have hQ : sgbGradSq2 h w x + ε ≠ 0 := by linarith [hGnn x hx]
  rw [hL, hB, hgsq]
  have fin : ∀ HS K g : ℝ, g + ε ≠ 0 →
      (2 * HS + 2 * K * g) / (2 * (g + ε)) - 2 * HS * g / (2 * (g + ε) ^ 2) =
        K * g / (g + ε) + ε * HS / (g + ε) ^ 2 := by
    intro HS K g hg
    field_simp
    ring
  exact fin _ _ _ hQ

theorem pcgb_local_div_sum_zero {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (Aset : Fin P.n → Set E2) (hAo : ∀ j, IsOpen (Aset j)) (hAW : ∀ j, Aset j ⊆ P.W j)
    (hρ1 : ∀ j, ∀ y ∈ Aset j, ∑ i, ρ i (P.param j y) = 1)
    (Wv : Fin P.n → E2 → Fin 2 → ℝ)
    (hWc : ∀ j (e : Fin 2), ContinuousOn (fun x => Wv j x e) (P.W j))
    (hWz : ∀ j, ∀ x ∈ P.W j, x ∉ Aset j → ∀ e : Fin 2, Wv j x e = 0)
    (hWt : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, ∀ i : Fin 2,
      ∑ e : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 e) i * Wv j x e =
        Wv k (P.proj k (P.param j x)) i) :
    ∑ j, ∑ e : Fin 2, ∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
      (Real.sqrt (P.h j x).det * Wv j x e) = 0 :=
by
  classical
  
  have hmc : ∀ j, ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) := by
    intro j
    have hc : ∀ a b : Fin 2, ContinuousOn (fun x => P.h j x a b) (P.W j) :=
      fun a b => (P.h_smooth j a b).continuousOn
    have hdet : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
      have : (fun x => (P.h j x).det) =
          fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
        funext x
        exact Matrix.det_fin_two _
      rw [this]
      exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
    exact Real.continuous_sqrt.comp_continuousOn hdet
  have hcov : ∀ (j k : Fin P.n) (G : E2 → ℝ),
      (∫ x in P.W j ∩ P.param j ⁻¹' P.O k, G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) =
        ∫ y in P.W k ∩ P.param k ⁻¹' P.O j, G y * Real.sqrt (P.h k y).det :=
    fun j k G => (eig_chart_cov S P j k G).1
  
  have memS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at h
    exact h.2
  have memO : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j := by
    intro j x hx
    have h : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at h
    exact h.1
  have hH3 : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j k x hx
    have h2 : P.param j x ∈ P.param k '' P.W k := by
      rw [P.image_eq k]; exact ⟨hx.2, memS j x hx.1⟩
    obtain ⟨y, hy, hyx⟩ := h2
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hAopen : ∀ j k, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j k =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  
  have pd_zero : ∀ (u : E2 → ℝ) (y : E2) (V : Set E2), IsOpen V → y ∈ V →
      (∀ z ∈ V, u z = 0) → ∀ i, pd2 i u y = 0 := by
    intro u y V hV hy hu i
    have hev : u =ᶠ[𝓝 y] fun _ => (0 : ℝ) := Filter.eventually_of_mem (hV.mem_nhds hy) hu
    unfold pd2
    rw [hev.fderiv_eq]
    simp
  
  have pd_cont : ∀ (u : E2 → ℝ) (V : Set E2), IsOpen V → ContDiffOn ℝ ∞ u V → ∀ i,
      ContinuousOn (fun x => pd2 i u x) V := by
    intro u V hV hu i
    exact (hu.continuousOn_fderiv_of_isOpen hV (by simp)).clm_apply continuousOn_const
  
  have hint : ∀ j (f : E2 → ℝ), ContinuousOn f (P.W j) →
      (∀ x ∈ P.W j, x ∉ Kc j → f x = 0) → IntegrableOn f (P.W j) := by
    intro j f hf hf0
    have h1 : IntegrableOn f (Kc j) := (hf.mono (hK j).2).integrableOn_compact (hK j).1
    exact h1.of_forall_diff_eq_zero (P.W_open j).measurableSet (fun x hx => hf0 x hx.1 hx.2)
  
  have s5 : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ∀ e,
      pd2 e (fun x' => ρ j (P.param j x')) x = 0 := by
    intro j x hx hxK e
    exact pd_zero _ x (P.W j ∩ (Kc j)ᶜ) ((P.W_open j).inter (hK j).1.isClosed.isOpen_compl)
      ⟨hx, hxK⟩ (fun z hz => hρK j z hz.1 hz.2) e
  
  have s2 : ∀ j k, ∀ y ∈ P.W k, P.param k y ∉ P.O j → ∀ i,
      pd2 i (fun y' => ρ j (P.param k y')) y = 0 := by
    intro j k y hy hyO i
    have hCc : IsCompact (P.param j '' Kc j) :=
      (hK j).1.image_of_continuousOn ((P.param_cont j).mono (hK j).2)
    have hCO : P.param j '' Kc j ⊆ P.O j := by
      rintro _ ⟨x, hx, rfl⟩
      exact memO j x ((hK j).2 hx)
    refine pd_zero _ y (P.W k ∩ P.param k ⁻¹' (P.param j '' Kc j)ᶜ)
      ((P.param_cont k).isOpen_inter_preimage (P.W_open k) hCc.isClosed.isOpen_compl)
      ⟨hy, fun h => hyO (hCO h)⟩ ?_ i
    intro z hz
    by_cases hzO : P.param k z ∈ P.O j
    · have h2 : P.param k z ∈ P.param j '' P.W j := by
        rw [P.image_eq j]; exact ⟨hzO, memS k z hz.1⟩
      obtain ⟨x', hx', hx'z⟩ := h2
      have hx'K : x' ∉ Kc j := fun h => hz.2 ⟨x', h, hx'z⟩
      show ρ j (P.param k z) = 0
      rw [← hx'z]
      exact hρK j x' hx' hx'K
    · exact hρO j _ hzO
  
  have s3 : ∀ k, ∀ y ∈ Aset k, ∀ i, ∑ j, pd2 i (fun y' => ρ j (P.param k y')) y = 0 := by
    intro k y hyA i
    have hy : y ∈ P.W k := hAW k hyA
    have hd : ∀ j ∈ (Finset.univ : Finset (Fin P.n)),
        DifferentiableAt ℝ (fun y' => ρ j (P.param k y')) y :=
      fun j _ => ((hρs j k).differentiableOn (by simp)).differentiableAt
        ((P.W_open k).mem_nhds hy)
    have hsum := fderiv_fun_sum (u := Finset.univ) (A := fun j y' => ρ j (P.param k y')) hd
    have h0 : fderiv ℝ (fun y' => ∑ j, ρ j (P.param k y')) y = 0 := by
      have hev : (fun y' => ∑ j, ρ j (P.param k y')) =ᶠ[𝓝 y] fun _ => (1 : ℝ) :=
        Filter.eventually_of_mem ((hAo k).mem_nhds hyA) (fun z hz => hρ1 k z hz)
      rw [hev.fderiv_eq]
      simp
    have he : ∑ j, pd2 i (fun y' => ρ j (P.param k y')) y =
        (∑ j, fderiv ℝ (fun y' => ρ j (P.param k y')) y) (e2 i) := by
      rw [ContinuousLinearMap.sum_apply]
      rfl
    rw [he, ← hsum, h0]
    simp
  
  have hexp : ∀ (L : E2 →L[ℝ] ℝ) (v : E2), L v = ∑ i : Fin 2, v i * L (e2 i) := by
    intro L v
    have hv : v = ∑ i : Fin 2, v i • e2 i := by
      ext m
      fin_cases m <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    simp [map_smul, smul_eq_mul]
  
  have s1 : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      ∑ e : Fin 2, pd2 e (fun x' => ρ j (P.param j x')) x * Wv j x e =
        ∑ i : Fin 2, pd2 i (fun y => ρ j (P.param k y)) (P.proj k (P.param j x)) *
          Wv k (P.proj k (P.param j x)) i := by
    intro j k x hx
    obtain ⟨h1, -⟩ := hH3 j k x hx
    have hev : (fun x' => ρ j (P.param j x')) =ᶠ[𝓝 x]
        (fun y => ρ j (P.param k y)) ∘ (fun x' => P.proj k (P.param j x')) :=
      Filter.eventually_of_mem ((hAopen j k).mem_nhds hx) (fun z hz => by
        show ρ j (P.param j z) = ρ j (P.param k (P.proj k (P.param j z)))
        rw [(hH3 j k z hz).2])
    have hφd : DifferentiableAt ℝ (fun y => ρ j (P.param k y)) (P.proj k (P.param j x)) :=
      ((hρs j k).differentiableOn (by simp)).differentiableAt ((P.W_open k).mem_nhds h1)
    have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
      ((P.trans_smooth j k).differentiableOn (by simp)).differentiableAt
        ((hAopen j k).mem_nhds hx)
    have hfd : fderiv ℝ (fun x' => ρ j (P.param j x')) x =
        (fderiv ℝ (fun y => ρ j (P.param k y)) (P.proj k (P.param j x))).comp
          (fderiv ℝ (fun x' => P.proj k (P.param j x')) x) := by
      rw [hev.fderiv_eq]
      exact fderiv_comp x hφd hτd
    have hpd : ∀ e : Fin 2, pd2 e (fun x' => ρ j (P.param j x')) x =
        ∑ i : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 e) i *
          pd2 i (fun y => ρ j (P.param k y)) (P.proj k (P.param j x)) := by
      intro e
      show fderiv ℝ (fun x' => ρ j (P.param j x')) x (e2 e) = _
      rw [hfd, ContinuousLinearMap.comp_apply,
        hexp (fderiv ℝ (fun y => ρ j (P.param k y)) (P.proj k (P.param j x)))]
      rfl
    simp only [hpd, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← hWt j k x hx i, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun e _ => ?_)
    ring
  
  have s4 : ∀ j (g : E2 → ℝ), ContinuousOn g (P.W j) → (∀ x ∈ P.W j, x ∉ Kc j → g x = 0) →
      (∀ x ∈ P.W j, x ∉ Aset j → g x = 0) →
      ∫ x in P.W j, g x = ∑ k, ∫ x in P.W j ∩ P.param j ⁻¹' P.O k, ρ k (P.param j x) * g x := by
    intro j g hg hg0 hgA
    have hI : ∀ k ∈ (Finset.univ : Finset (Fin P.n)),
        Integrable (fun x => ρ k (P.param j x) * g x) (volume.restrict (P.W j)) := by
      intro k _
      refine hint j _ ((hρs k j).continuousOn.mul hg) ?_
      intro x hx hxK
      rw [hg0 x hx hxK, mul_zero]
    calc ∫ x in P.W j, g x = ∫ x in P.W j, ∑ k, ρ k (P.param j x) * g x := by
          refine setIntegral_congr_fun (P.W_open j).measurableSet (fun x hx => ?_)
          show g x = ∑ k, ρ k (P.param j x) * g x
          by_cases hxA : x ∈ Aset j
          · rw [← Finset.sum_mul, hρ1 j x hxA, one_mul]
          · rw [hgA x hx hxA]
            simp
      _ = ∑ k, ∫ x in P.W j, ρ k (P.param j x) * g x := integral_finset_sum _ hI
      _ = _ := by
          refine Finset.sum_congr rfl (fun k _ => ?_)
          refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (P.W_open j).measurableSet
            Set.inter_subset_left ?_
          intro x hx
          have hxO : P.param j x ∉ P.O k := fun h => hx.2 ⟨hx.1, h⟩
          show ρ k (P.param j x) * g x = 0
          rw [hρO k _ hxO, zero_mul]
  
  obtain ⟨G, hG⟩ : ∃ G : Fin P.n → Fin P.n → E2 → ℝ, ∀ j k y, G j k y =
      ρ k (P.param k y) * ∑ i : Fin 2, pd2 i (fun y' => ρ j (P.param k y')) y * Wv k y i :=
    ⟨fun j k y => ρ k (P.param k y) * ∑ i : Fin 2, pd2 i (fun y' => ρ j (P.param k y')) y *
      Wv k y i, fun _ _ _ => rfl⟩
  have hstep : ∀ j, ∑ e : Fin 2, ∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
      (Real.sqrt (P.h j x).det * Wv j x e) =
      ∑ k, ∫ y in P.W k, G j k y * Real.sqrt (P.h k y).det := by
    intro j
    have hfc : ∀ e, ContinuousOn (fun x => pd2 e (fun x' => ρ j (P.param j x')) x *
        (Real.sqrt (P.h j x).det * Wv j x e)) (P.W j) :=
      fun e => (pd_cont _ _ (P.W_open j) (hρs j j) e).mul ((hmc j).mul (hWc j e))
    have hf0 : ∀ e, ∀ x ∈ P.W j, x ∉ Kc j → pd2 e (fun x' => ρ j (P.param j x')) x *
        (Real.sqrt (P.h j x).det * Wv j x e) = 0 := by
      intro e x hx hxK
      rw [s5 j x hx hxK e, zero_mul]
    have hfA : ∀ e, ∀ x ∈ P.W j, x ∉ Aset j → pd2 e (fun x' => ρ j (P.param j x')) x *
        (Real.sqrt (P.h j x).det * Wv j x e) = 0 := by
      intro e x hx hxA
      rw [hWz j x hx hxA e, mul_zero, mul_zero]
    rw [← integral_finset_sum _ (fun e _ => hint j _ (hfc e) (hf0 e))]
    rw [s4 j _ (continuousOn_finset_sum _ (fun e _ => hfc e))
      (fun x hx hxK => Finset.sum_eq_zero (fun e _ => hf0 e x hx hxK))
      (fun x hx hxA => Finset.sum_eq_zero (fun e _ => hfA e x hx hxA))]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    have hpt : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        ρ k (P.param j x) * ∑ e : Fin 2, pd2 e (fun x' => ρ j (P.param j x')) x *
          (Real.sqrt (P.h j x).det * Wv j x e) =
        G j k (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det := by
      intro x hx
      have h3 := s1 j k x hx
      have h2 := (hH3 j k x hx).2
      rw [hG, h2]
      have hsplit : ∑ e : Fin 2, pd2 e (fun x' => ρ j (P.param j x')) x *
          (Real.sqrt (P.h j x).det * Wv j x e) =
          Real.sqrt (P.h j x).det * ∑ e : Fin 2, pd2 e (fun x' => ρ j (P.param j x')) x * Wv j x e := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun e _ => by ring)
      rw [hsplit, h3]
      ring
    rw [setIntegral_congr_fun (hAopen j k).measurableSet hpt, hcov j k (G j k)]
    refine (setIntegral_eq_of_subset_of_forall_diff_eq_zero (P.W_open k).measurableSet
      Set.inter_subset_left ?_).symm
    intro y hy
    have hyO : P.param k y ∉ P.O j := fun h => hy.2 ⟨hy.1, h⟩
    show G j k y * Real.sqrt (P.h k y).det = 0
    rw [hG, Finset.sum_eq_zero (fun i _ => by rw [s2 j k y hy.1 hyO i, zero_mul]), mul_zero,
      zero_mul]
  rw [Finset.sum_congr rfl (fun j _ => hstep j), Finset.sum_comm]
  refine Finset.sum_eq_zero (fun k _ => ?_)
  have hGc : ∀ j, IntegrableOn (fun y => G j k y * Real.sqrt (P.h k y).det) (P.W k) := by
    intro j
    have hfun : (fun y => G j k y * Real.sqrt (P.h k y).det) = fun y =>
        ρ k (P.param k y) * (∑ i : Fin 2, pd2 i (fun y' => ρ j (P.param k y')) y * Wv k y i) *
          Real.sqrt (P.h k y).det := by
      funext y
      rw [hG]
    rw [hfun]
    refine hint k _ (((hρs k k).continuousOn.mul (continuousOn_finset_sum _ (fun i _ =>
      (pd_cont _ _ (P.W_open k) (hρs j k) i).mul (hWc k i)))).mul (hmc k)) ?_
    intro y hy hyK
    rw [hρK k y hy hyK, zero_mul, zero_mul]
  rw [← integral_finset_sum _ (fun j _ => hGc j)]
  refine setIntegral_eq_zero_of_forall_eq_zero (fun y hy => ?_)
  show ∑ j, G j k y * Real.sqrt (P.h k y).det = 0
  simp only [hG]
  calc ∑ j, ρ k (P.param k y) * (∑ i : Fin 2, pd2 i (fun y' => ρ j (P.param k y')) y * Wv k y i) *
        Real.sqrt (P.h k y).det
      = ∑ i : Fin 2, (ρ k (P.param k y) * Real.sqrt (P.h k y).det * Wv k y i) *
          ∑ j, pd2 i (fun y' => ρ j (P.param k y')) y := by
        simp only [Finset.mul_sum, Finset.sum_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
    _ = 0 := by
        by_cases hyA : y ∈ Aset k
        · simp only [s3 k y hyA, mul_zero, Finset.sum_const_zero]
        · simp only [hWz k y hy hyA, mul_zero, zero_mul, Finset.sum_const_zero]

theorem pcgb_pf_eta_deriv : Continuous (deriv Real.smoothTransition) ∧
    (∀ t : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition t) t) ∧
    (∀ t : ℝ, t ≤ 0 → deriv Real.smoothTransition t = 0) ∧
    (∀ t : ℝ, 1 ≤ t → deriv Real.smoothTransition t = 0) ∧
    ∃ M₁ : ℝ, 0 ≤ M₁ ∧ ∀ t : ℝ, |deriv Real.smoothTransition t| ≤ M₁ :=
by
  have hcd : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff (n := 1)
  have hηc : Continuous (deriv Real.smoothTransition) := hcd.continuous_deriv le_rfl
  have hdiff : Differentiable ℝ Real.smoothTransition := hcd.differentiable (by norm_num)
  have h0 : ∀ t : ℝ, t ≤ 0 → deriv Real.smoothTransition t = 0 := by
    intro t ht
    apply IsLocalMin.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun x => ?_)
    rw [Real.smoothTransition.zero_of_nonpos ht]
    exact Real.smoothTransition.nonneg x
  have h1 : ∀ t : ℝ, 1 ≤ t → deriv Real.smoothTransition t = 0 := by
    intro t ht
    apply IsLocalMax.deriv_eq_zero
    refine Filter.Eventually.of_forall (fun x => ?_)
    rw [Real.smoothTransition.one_of_one_le ht]
    exact Real.smoothTransition.le_one x
  obtain ⟨C, hC⟩ := (isCompact_Icc (a := (0:ℝ)) (b := 1)).exists_bound_of_continuousOn
    hηc.continuousOn
  refine ⟨hηc, fun t => (hdiff t).hasDerivAt, h0, h1, max C 0, le_max_right _ _, ?_⟩
  intro t
  by_cases ht : t ∈ Set.Icc (0:ℝ) 1
  · have := hC t ht
    rw [Real.norm_eq_abs] at this
    exact le_trans this (le_max_left _ _)
  · rw [Set.mem_Icc, not_and_or, not_le, not_le] at ht
    rcases ht with ht | ht
    · rw [h0 t ht.le, abs_zero]; exact le_max_right _ _
    · rw [h1 t ht.le, abs_zero]; exact le_max_right _ _

theorem pcgb_pf_quad_facts (A : Matrix (Fin 2) (Fin 2) ℝ) (hA : A.PosDef) :
    (∀ a c : Fin 2, A a c = A c a) ∧ 0 < A.det ∧ 0 < A 0 0 ∧ 0 < A 0 0 + A 1 1 ∧
    ∀ z : E2,
      0 ≤ ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c ∧
      (z ≠ 0 → 0 < ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c) ∧
      ∑ a : Fin 2, (∑ c : Fin 2, A a c * z c) ^ 2 ≤
        (A 0 0 + A 1 1) * ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c ∧
      A.det * ‖z‖ ^ 2 ≤ (A 0 0 + A 1 1) * ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c ∧
      ∑ a : Fin 2, ∑ c : Fin 2, A⁻¹ a c * (∑ k : Fin 2, A a k * z k) * (∑ k : Fin 2, A c k * z k) =
        ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c :=
by
  have hsym : ∀ a c : Fin 2, A a c = A c a := by
    intro a c
    simpa using hA.isHermitian.apply c a
  have hD : 0 < A.det := hA.det_pos
  have h00 : 0 < A 0 0 := hA.diag_pos
  have h11 : 0 < A 1 1 := hA.diag_pos
  have hdet : A.det = A 0 0 * A 1 1 - A 0 1 * A 0 1 := by
    rw [Matrix.det_fin_two, hsym 1 0]
  have hD' : 0 < A 0 0 * A 1 1 - A 0 1 * A 0 1 := hdet ▸ hD
  have hinv : A⁻¹ = A.det⁻¹ • !![A 1 1, -A 0 1; -A 1 0, A 0 0] := by
    rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
  have i00 : A⁻¹ 0 0 = A.det⁻¹ * A 1 1 := by rw [hinv]; simp
  have i01 : A⁻¹ 0 1 = A.det⁻¹ * (-A 0 1) := by rw [hinv]; simp
  have i10 : A⁻¹ 1 0 = A.det⁻¹ * (-A 0 1) := by rw [hinv]; simp [hsym 1 0]
  have i11 : A⁻¹ 1 1 = A.det⁻¹ * A 0 0 := by rw [hinv]; simp
  have hDinv : (A 0 0 * A 1 1 - A 0 1 * A 0 1)⁻¹ * (A 0 0 * A 1 1 - A 0 1 * A 0 1) = 1 :=
    inv_mul_cancel₀ hD'.ne'
  refine ⟨hsym, hD, h00, by linarith, fun z => ?_⟩
  have hn : ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hzne : z ≠ 0 → z 0 ≠ 0 ∨ z 1 ≠ 0 := by
    intro hz
    by_contra h
    push_neg at h
    apply hz
    apply PiLp.ext
    intro i
    fin_cases i
    · simpa using h.1
    · simpa using h.2
  have hQ : ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c =
      A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2 := by
    simp only [Fin.sum_univ_two, hsym 1 0]
    ring
  have hv : ∑ a : Fin 2, (∑ c : Fin 2, A a c * z c) ^ 2 =
      (A 0 0 * z 0 + A 0 1 * z 1) ^ 2 + (A 0 1 * z 0 + A 1 1 * z 1) ^ 2 := by
    simp only [Fin.sum_univ_two, hsym 1 0]
  have h9 : ∑ a : Fin 2, ∑ c : Fin 2, A⁻¹ a c * (∑ k : Fin 2, A a k * z k) *
      (∑ k : Fin 2, A c k * z k) =
      (A 0 0 * A 1 1 - A 0 1 * A 0 1)⁻¹ *
        (A 1 1 * (A 0 0 * z 0 + A 0 1 * z 1) ^ 2
          - 2 * A 0 1 * (A 0 0 * z 0 + A 0 1 * z 1) * (A 0 1 * z 0 + A 1 1 * z 1)
          + A 0 0 * (A 0 1 * z 0 + A 1 1 * z 1) ^ 2) := by
    simp only [Fin.sum_univ_two, i00, i01, i10, i11, hsym 1 0, hdet]
    ring
  have hQa : A 0 0 * (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) =
      (A 0 0 * z 0 + A 0 1 * z 1) ^ 2 + (A 0 0 * A 1 1 - A 0 1 * A 0 1) * z 1 ^ 2 := by ring
  have hCH : (A 0 0 + A 1 1) * (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) =
      (A 0 0 * z 0 + A 0 1 * z 1) ^ 2 + (A 0 1 * z 0 + A 1 1 * z 1) ^ 2 +
        (A 0 0 * A 1 1 - A 0 1 * A 0 1) * (z 0 ^ 2 + z 1 ^ 2) := by ring
  have hQa0 : 0 ≤ A 0 0 * (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) := by
    rw [hQa]
    exact add_nonneg (sq_nonneg _) (mul_nonneg hD'.le (sq_nonneg _))
  rw [hQ, hv, h9, hn, hdet]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · exact (mul_nonneg_iff_of_pos_left h00).mp hQa0
  · intro hz
    have hpos : 0 < A 0 0 * (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) := by
      rw [hQa]
      by_cases hy : z 1 = 0
      · have hx : z 0 ≠ 0 := by
          rcases hzne hz with h | h
          · exact h
          · exact absurd hy h
        rw [hy]
        have : 0 < (A 0 0 * z 0) ^ 2 := by
          have : A 0 0 * z 0 ≠ 0 := mul_ne_zero h00.ne' hx
          positivity
        simpa using this
      · have : 0 < (A 0 0 * A 1 1 - A 0 1 * A 0 1) * z 1 ^ 2 := by
          have : 0 < z 1 ^ 2 := by positivity
          exact mul_pos hD' this
        linarith [sq_nonneg (A 0 0 * z 0 + A 0 1 * z 1)]
    exact (mul_pos_iff_of_pos_left h00).mp hpos
  · nlinarith [hCH, mul_nonneg hD'.le (add_nonneg (sq_nonneg (z 0)) (sq_nonneg (z 1)))]
  · nlinarith [hCH, sq_nonneg (A 0 0 * z 0 + A 0 1 * z 1), sq_nonneg (A 0 1 * z 0 + A 1 1 * z 1)]
  · linear_combination
      (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) * hDinv

theorem pcgb_pf_frozen_integral (A : Matrix (Fin 2) (Fin 2) ℝ) (hsymm : A 0 1 = A 1 0)
    (ha : 0 < A 0 0) (hD : 0 < A.det) (x₀ : E2) (δ : ℝ) (hδ : 0 < δ)
    (hηc : Continuous (deriv Real.smoothTransition))
    (hη0 : ∀ t : ℝ, t ≤ 0 → deriv Real.smoothTransition t = 0)
    (hη1 : ∀ t : ℝ, 1 ≤ t → deriv Real.smoothTransition t = 0) :
    ∫ y : E2, -(Real.sqrt A.det * (δ⁻¹ * deriv Real.smoothTransition
        ((Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c) - δ) / δ)) /
        Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c)) = -(2 * Real.pi) :=
by
  
  have hpolar : ∀ F : ℝ → ℝ,
      ∫ u : E2, F ‖u‖ = 2 * Real.pi * ∫ y in Set.Ioi (0 : ℝ), y * F y := by
    intro F
    rw [MeasureTheory.integral_fun_norm_addHaar volume F]
    have hb : volume.real (Metric.ball (0 : E2) 1) = Real.pi := by
      rw [Measure.real, EuclideanSpace.volume_ball_fin_two]
      simp [ENNReal.toReal_ofReal Real.pi_pos.le]
    rw [hb, finrank_euclideanSpace_fin]
    simp only [smul_eq_mul, nsmul_eq_mul]
    norm_num
    ring
  
  have hftc : ∫ y in Set.Ioi (0 : ℝ), δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ) = 1 := by
    have hsub : ∫ y in Set.Ioi (0 : ℝ), δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ) =
        ∫ y in Set.Ioc (0 : ℝ) (2 * δ), δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ) := by
      apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero measurableSet_Ioi
        Set.Ioc_subset_Ioi_self
      intro y hy
      have hy2 : 2 * δ < y := by
        rcases hy with ⟨hy1, hy2⟩
        simp only [Set.mem_Ioc, not_and, not_le] at hy2
        exact hy2 hy1
      rw [hη1 _ (by rw [le_div_iff₀ hδ]; linarith), mul_zero]
    rw [hsub, ← intervalIntegral.integral_of_le (by linarith)]
    have hd : ∀ t : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition t) t := by
      intro t
      exact ((Real.smoothTransition.contDiff (n := 1)).differentiable (by simp) t).hasDerivAt
    have hF : ∀ y ∈ Set.uIcc (0 : ℝ) (2 * δ), HasDerivAt
        (fun y => Real.smoothTransition ((y - δ) / δ))
        (δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ)) y := by
      intro y _
      have h1 : HasDerivAt (fun y : ℝ => (y - δ) / δ) (1 / δ) y :=
        ((hasDerivAt_id y).sub_const δ).div_const δ
      have h2 := (hd ((y - δ) / δ)).comp y h1
      convert h2 using 1
      field_simp
    have hint : IntervalIntegrable (fun y => δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ))
        volume 0 (2 * δ) := by
      apply Continuous.intervalIntegrable
      exact continuous_const.mul (hηc.comp ((continuous_id.sub continuous_const).div_const δ))
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint]
    have e1 : (2 * δ - δ) / δ = 1 := by field_simp; ring
    have e2 : (0 - δ) / δ = -1 := by rw [zero_sub, neg_div, div_self hδ.ne']
    simp only [e1, e2]
    rw [Real.smoothTransition.one_of_one_le le_rfl,
      Real.smoothTransition.zero_of_nonpos (by norm_num)]
    norm_num
  
  have hlin : ∀ g : ℝ → ℝ,
      ∫ y : E2, g (Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c)) =
        (Real.sqrt A.det)⁻¹ * ∫ u : E2, g ‖u‖ := by
    intro g
    obtain ⟨f, hf⟩ : ∃ f : E2 → ℝ, f = fun w => g (Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2,
        A a c * w a * w c)) := ⟨_, rfl⟩
    have htr : ∫ y : E2, f (y - x₀) = ∫ w : E2, f w :=
      MeasureTheory.integral_sub_right_eq_self f x₀
    have hL : ∫ y : E2, g (Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2,
        A a c * (y - x₀) a * (y - x₀) c)) = ∫ y : E2, f (y - x₀) := by rw [hf]
    rw [hL, htr]
    have hdet : A.det = A 0 0 * A 1 1 - A 0 1 * A 0 1 := by rw [Matrix.det_fin_two, hsymm]
    obtain ⟨sa, hsa_def⟩ : ∃ s, s = Real.sqrt (A 0 0) := ⟨_, rfl⟩
    obtain ⟨sD, hsD_def⟩ : ∃ s, s = Real.sqrt A.det := ⟨_, rfl⟩
    rw [← hsD_def]
    have hsa : 0 < sa := by rw [hsa_def]; exact Real.sqrt_pos.mpr ha
    have hsD : 0 < sD := by rw [hsD_def]; exact Real.sqrt_pos.mpr hD
    have hsa2 : sa ^ 2 = A 0 0 := by rw [hsa_def]; exact Real.sq_sqrt ha.le
    have hsD2 : sD ^ 2 = A.det := by rw [hsD_def]; exact Real.sq_sqrt hD.le
    set M : Matrix (Fin 2) (Fin 2) ℝ := !![sa⁻¹, -(A 0 1 / (sa * sD)); 0, sa / sD] with hM
    set Φ : E2 →ₗ[ℝ] E2 := Matrix.toEuclideanLin M with hΦ
    have hΦ0 : ∀ u : E2, Φ u 0 = sa⁻¹ * u 0 + -(A 0 1 / (sa * sD)) * u 1 := by
      intro u
      simp [Φ, M, Matrix.toEuclideanLin_apply, dotProduct, Fin.sum_univ_two]
    have hΦ1 : ∀ u : E2, Φ u 1 = sa / sD * u 1 := by
      intro u
      simp [Φ, M, Matrix.toEuclideanLin_apply, dotProduct, Fin.sum_univ_two]
    have hdetΦ : LinearMap.det Φ = sD⁻¹ := by
      rw [hΦ, Matrix.toEuclideanLin_eq_toLin, LinearMap.det_toLin, hM, Matrix.det_fin_two_of]
      field_simp
      ring
    have hdet0 : LinearMap.det Φ ≠ 0 := by rw [hdetΦ]; positivity
    have hmap := MeasureTheory.Measure.map_linearMap_addHaar_eq_smul_addHaar
      (μ := (volume : Measure E2)) hdet0
    have hemb : MeasurableEmbedding Φ :=
      (LinearMap.equivOfDetNeZero Φ hdet0).toContinuousLinearEquiv.toHomeomorph.measurableEmbedding
    have hkey : ∀ u : E2, f (Φ u) = g ‖u‖ := by
      intro u
      rw [hf]
      simp only
      congr 1
      have hn : ‖u‖ ^ 2 = u 0 ^ 2 + u 1 ^ 2 := by
        rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
          Fin.sum_univ_two]
        simp [Real.norm_eq_abs, sq_abs]
      have hq : ∑ a : Fin 2, ∑ c : Fin 2, A a c * Φ u a * Φ u c = ‖u‖ ^ 2 := by
        rw [hn]
        simp only [Fin.sum_univ_two, hΦ0, hΦ1, ← hsymm]
        have e1 : A 1 1 = (sD ^ 2 + A 0 1 ^ 2) / sa ^ 2 := by
          rw [hsD2, hsa2, hdet]; field_simp; ring
        rw [e1, ← hsa2]
        field_simp
        ring
      rw [hq, Real.sqrt_sq (norm_nonneg _)]
    have h1 : ∫ u : E2, g ‖u‖ = ∫ w, f w ∂(Measure.map Φ volume) := by
      rw [hemb.integral_map]
      simp only [hkey]
    rw [hmap, integral_smul_measure, hdetΦ, inv_inv, abs_of_pos hsD,
      ENNReal.toReal_ofReal hsD.le, smul_eq_mul] at h1
    rw [h1]
    field_simp
  
  have hsD : 0 < Real.sqrt A.det := Real.sqrt_pos.mpr hD
  refine (hlin (fun ρ => -(Real.sqrt A.det * (δ⁻¹ * deriv Real.smoothTransition
    ((ρ - δ) / δ)) / ρ))).trans ?_
  rw [hpolar (fun ρ => -(Real.sqrt A.det * (δ⁻¹ * deriv Real.smoothTransition
    ((ρ - δ) / δ)) / ρ))]
  have hI : ∫ y in Set.Ioi (0 : ℝ), y * -(Real.sqrt A.det * (δ⁻¹ * deriv Real.smoothTransition
      ((y - δ) / δ)) / y) = ∫ y in Set.Ioi (0 : ℝ), (-Real.sqrt A.det) *
      (δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ)) := by
    refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi ?_
    intro y hy
    have hy0 : y ≠ 0 := ne_of_gt hy
    calc y * -(Real.sqrt A.det * (δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ)) / y)
        = (-Real.sqrt A.det) * (δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ)) * (y / y) := by
          ring
      _ = (-Real.sqrt A.det) * (δ⁻¹ * deriv Real.smoothTransition ((y - δ) / δ)) := by
          rw [div_self hy0, mul_one]
  rw [hI, MeasureTheory.integral_const_mul, hftc]
  calc (Real.sqrt A.det)⁻¹ * (2 * Real.pi * (-Real.sqrt A.det * 1))
      = -(2 * Real.pi) * ((Real.sqrt A.det)⁻¹ * Real.sqrt A.det) := by ring
    _ = -(2 * Real.pi) := by rw [inv_mul_cancel₀ hsD.ne', mul_one]

theorem pcgb_pf_cutoff_derivs (A : Matrix (Fin 2) (Fin 2) ℝ) (hsymm : ∀ a c : Fin 2, A a c = A c a)
    (hQpos : ∀ z : E2, z ≠ 0 → 0 < ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c)
    (x₀ : E2) (δ : ℝ) (hδ : 0 < δ) :
    (∀ y : E2, y ≠ x₀ →
      DifferentiableAt ℝ (fun y' : E2 => Real.log (Real.sqrt
        (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y' - x₀) a' * (y' - x₀) c'))) y ∧
      ∀ a : Fin 2,
        pd2 a (fun y' : E2 => Real.smoothTransition ((Real.sqrt
            (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y' - x₀) a' * (y' - x₀) c') - δ) / δ)) y =
          δ⁻¹ * deriv Real.smoothTransition ((Real.sqrt
            (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y - x₀) a' * (y - x₀) c') - δ) / δ) *
            (∑ c : Fin 2, A a c * (y - x₀) c) /
            Real.sqrt (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y - x₀) a' * (y - x₀) c') ∧
        pd2 a (fun y' : E2 => Real.log (Real.sqrt
            (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y' - x₀) a' * (y' - x₀) c'))) y =
          (∑ c : Fin 2, A a c * (y - x₀) c) /
            (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y - x₀) a' * (y - x₀) c')) ∧
    ∀ a : Fin 2, pd2 a (fun y' : E2 => Real.smoothTransition ((Real.sqrt
        (∑ a' : Fin 2, ∑ c' : Fin 2, A a' c' * (y' - x₀) a' * (y' - x₀) c') - δ) / δ)) x₀ = 0 :=
by
  have hζ : ∀ (i : Fin 2) (y : E2), HasFDerivAt (fun y : E2 => (y - x₀) i)
      (PiLp.proj 2 (fun _ : Fin 2 => ℝ) i : E2 →L[ℝ] ℝ) y := by
    intro i y
    have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 y i).sub_const (x₀ i)
    convert h using 1
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ,
      Q = fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : Fin 2 → E2 → ℝ,
      N = fun a y => ∑ c : Fin 2, A a c * (y - x₀) c := ⟨_, rfl⟩
  have hposQ : ∀ y : E2, y ≠ x₀ → 0 < Q y := by
    intro y hy
    rw [hQ]
    exact hQpos (y - x₀) (sub_ne_zero.mpr hy)
  have hQd : ∀ y : E2, HasFDerivAt Q
      (∑ a : Fin 2, ∑ c : Fin 2, ((A a c * (y - x₀) a) •
        (PiLp.proj 2 (fun _ : Fin 2 => ℝ) c : E2 →L[ℝ] ℝ) +
        (y - x₀) c • (A a c • (PiLp.proj 2 (fun _ : Fin 2 => ℝ) a : E2 →L[ℝ] ℝ)))) y := by
    intro y
    rw [hQ]
    have h := HasFDerivAt.sum (u := Finset.univ) (fun a _ => HasFDerivAt.sum
      (u := Finset.univ) (fun c _ => ((hζ a y).const_mul (A a c)).mul (hζ c y)))
    convert h using 1
  have h10 := hsymm 1 0
  have hQpd : ∀ (y : E2) (k : Fin 2), fderiv ℝ Q y (e2 k) = 2 * N k y := by
    intro y k
    rw [(hQd y).fderiv, hN]
    fin_cases k <;>
      simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two, ContinuousLinearMap.sum_apply,
        h10] <;> ring
  have hQc : Continuous Q := continuous_iff_continuousAt.2 fun y => (hQd y).continuousAt
  have hQ0 : Q x₀ = 0 := by
    rw [hQ]
    simp
  have hη : ∀ t : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition t) t := by
    intro t
    have hd : Differentiable ℝ Real.smoothTransition :=
      (Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num)
    exact (hd t).hasDerivAt
  have alg1 : ∀ s q n : ℝ, s ≠ 0 → s * s = q → s⁻¹ * (1 / (2 * s) * (2 * n)) = n / q := by
    intro s q n hs hsq
    subst hsq
    field_simp
  have alg2 : ∀ s d e n : ℝ, s ≠ 0 → d ≠ 0 →
      e * (d⁻¹ * (1 / (2 * s) * (2 * n))) = d⁻¹ * e * n / s := by
    intro s d e n hs hd
    field_simp
  have hpart1 : ∀ y : E2, y ≠ x₀ →
      DifferentiableAt ℝ (fun y' : E2 => Real.log (Real.sqrt (Q y'))) y ∧
      ∀ a : Fin 2,
        pd2 a (fun y' : E2 => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) y =
          δ⁻¹ * deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ) * N a y /
            Real.sqrt (Q y) ∧
        pd2 a (fun y' : E2 => Real.log (Real.sqrt (Q y'))) y = N a y / Q y := by
    intro y hy
    have hq := hposQ y hy
    have hsq : 0 < Real.sqrt (Q y) := Real.sqrt_pos.mpr hq
    have hS : HasFDerivAt (fun y' => Real.sqrt (Q y'))
        ((1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y) y :=
      ((hQd y).differentiableAt.hasFDerivAt).sqrt hq.ne'
    have hL : HasFDerivAt (fun y' => Real.log (Real.sqrt (Q y')))
        ((Real.sqrt (Q y))⁻¹ • (1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y) y :=
      hS.log hsq.ne'
    have hin : HasFDerivAt (fun y' => (Real.sqrt (Q y') - δ) / δ)
        (δ⁻¹ • (1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y) y := by
      have := (hS.sub_const δ).mul_const δ⁻¹
      simpa only [div_eq_mul_inv] using this
    have hχ : HasFDerivAt (fun y' => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ))
        (deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ) •
          δ⁻¹ • (1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y) y := by
      have h := HasDerivAt.comp_hasFDerivAt (x := y) (hη ((Real.sqrt (Q y) - δ) / δ)) hin
      exact h
    refine ⟨hL.differentiableAt, fun a => ⟨?_, ?_⟩⟩
    · show fderiv ℝ _ y (e2 a) = _
      rw [hχ.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [hQpd y a]
      exact alg2 _ _ _ _ hsq.ne' hδ.ne'
    · show fderiv ℝ _ y (e2 a) = _
      rw [hL.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [hQpd y a]
      exact alg1 _ _ _ hsq.ne' (Real.mul_self_sqrt hq.le)
  have hpart2 : ∀ a : Fin 2,
      pd2 a (fun y' : E2 => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) x₀ = 0 := by
    intro a
    have hev : (fun y' : E2 => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) =ᶠ[nhds x₀]
        fun _ => (0 : ℝ) := by
      have hU : IsOpen {y' : E2 | Q y' < δ ^ 2} := isOpen_lt hQc continuous_const
      have hx : x₀ ∈ {y' : E2 | Q y' < δ ^ 2} := by
        show Q x₀ < δ ^ 2
        rw [hQ0]
        positivity
      filter_upwards [hU.mem_nhds hx] with y' hy'
      apply Real.smoothTransition.zero_of_nonpos
      have h1 : Real.sqrt (Q y') < δ := (Real.sqrt_lt' hδ).mpr hy'
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) hδ.le
    show fderiv ℝ _ x₀ (e2 a) = 0
    rw [hev.fderiv_eq]
    simp
  have key := And.intro hpart1 hpart2
  subst hQ hN
  exact key

theorem pcgb_pf_metric_bounds (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpd : ∀ x ∈ W, (h x).PosDef)
    (x₀ : E2) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall x₀ r ⊆ W) :
    ∃ K₁ K₂ : ℝ, 0 ≤ K₁ ∧ 0 ≤ K₂ ∧ ∀ y ∈ Metric.closedBall x₀ r, ∀ a c : Fin 2,
      |(h y)⁻¹ a c * Real.sqrt (h y).det| ≤ K₁ ∧
      |(h y)⁻¹ a c * Real.sqrt (h y).det - (h x₀)⁻¹ a c * Real.sqrt (h x₀).det| ≤ K₂ * ‖y - x₀‖ :=
by
  have hdet : ContDiffOn ℝ ∞ (fun y => (h y).det) W := by
    have hpoly : ContDiffOn ℝ ∞ (fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0) W :=
      ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
    exact hpoly.congr (fun y _ => Matrix.det_fin_two (h y))
  have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate a c) W := by
    intro a c
    fin_cases a <;> fin_cases c
    · exact (hh 1 1).congr (fun y _ => by simp [Matrix.adjugate_fin_two])
    · exact (hh 0 1).neg.congr (fun y _ => by simp [Matrix.adjugate_fin_two])
    · exact (hh 1 0).neg.congr (fun y _ => by simp [Matrix.adjugate_fin_two])
    · exact (hh 0 0).congr (fun y _ => by simp [Matrix.adjugate_fin_two])
  have hdinv : ContDiffOn ℝ ∞ (fun y => ((h y).det)⁻¹) W :=
    hdet.inv (fun y hy => (Matrix.PosDef.det_pos (hpd y hy)).ne')
  have hinv : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a c) W := by
    intro a c
    refine (hdinv.mul (hadj a c)).congr ?_
    intro y _
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hsq : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det) W :=
    hdet.sqrt (fun y hy => (Matrix.PosDef.det_pos (hpd y hy)).ne')
  have hH : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a c * Real.sqrt (h y).det) W :=
    fun a c => (hinv a c).mul hsq
  have hKc : IsCompact (Metric.closedBall x₀ r) := isCompact_closedBall x₀ r
  have hKv : Convex ℝ (Metric.closedBall x₀ r) := convex_closedBall x₀ r
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by
    exact_mod_cast (le_top : (1 : ℕ∞) ≤ ⊤)
  have hHc : ContinuousOn
      (fun y => fun a c : Fin 2 => (h y)⁻¹ a c * Real.sqrt (h y).det)
      (Metric.closedBall x₀ r) := by
    refine continuousOn_pi.2 fun a => continuousOn_pi.2 fun c => ?_
    exact (hH a c).continuousOn.mono hball
  obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn hHc
  have hGc : ContinuousOn
      (fun y => fun a c : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a c * Real.sqrt (h z).det) y)
      (Metric.closedBall x₀ r) := by
    refine continuousOn_pi.2 fun a => continuousOn_pi.2 fun c => ?_
    exact ((hH a c).continuousOn_fderiv_of_isOpen hW h1le).mono hball
  obtain ⟨κ', hκ'⟩ := hKc.exists_bound_of_continuousOn hGc
  refine ⟨max M 0, max κ' 0, le_max_right _ _, le_max_right _ _, ?_⟩
  intro y hy a c
  refine ⟨?_, ?_⟩
  · have h1 := hM y hy
    have h2 := norm_le_pi_norm (fun a c : Fin 2 => (h y)⁻¹ a c * Real.sqrt (h y).det) a
    have h3 := norm_le_pi_norm (fun c : Fin 2 => (h y)⁻¹ a c * Real.sqrt (h y).det) c
    rw [Real.norm_eq_abs] at h3
    exact le_trans h3 (le_trans h2 (le_trans h1 (le_max_left _ _)))
  · have hdiff : ∀ z ∈ Metric.closedBall x₀ r,
        DifferentiableAt ℝ (fun w => (h w)⁻¹ a c * Real.sqrt (h w).det) z := fun z hz =>
      ((hH a c).differentiableOn hne).differentiableAt (hW.mem_nhds (hball hz))
    have hbd : ∀ z ∈ Metric.closedBall x₀ r,
        ‖fderiv ℝ (fun w => (h w)⁻¹ a c * Real.sqrt (h w).det) z‖ ≤ max κ' 0 := by
      intro z hz
      have h1 := hκ' z hz
      have h2 := norm_le_pi_norm
        (fun c : Fin 2 => fderiv ℝ (fun w => (h w)⁻¹ a c * Real.sqrt (h w).det) z) c
      have h3 := norm_le_pi_norm
        (fun a c : Fin 2 => fderiv ℝ (fun w => (h w)⁻¹ a c * Real.sqrt (h w).det) z) a
      exact le_trans h2 (le_trans h3 (le_trans h1 (le_max_left _ _)))
    have hx₀ : x₀ ∈ Metric.closedBall x₀ r := Metric.mem_closedBall_self hr.le
    have := hKv.norm_image_sub_le_of_norm_fderiv_le hdiff hbd hx₀ hy
    rwa [Real.norm_eq_abs] at this

theorem pcgb_pf_pointwise_algebra (G Ainv : Fin 2 → Fin 2 → ℝ) (g ℓ p v : Fin 2 → ℝ)
    (s sD Q ρ δ e M₁ T K₁ K₂ κ C : ℝ)
    (hδ : 0 < δ) (hQ : 0 < Q) (hρ : ρ = Real.sqrt Q) (hρδ : δ ≤ ρ)
    (hM₁ : |e| ≤ M₁) (hT : 0 ≤ T) (hv : ∑ a : Fin 2, v a ^ 2 ≤ T * Q)
    (hκ : 0 ≤ κ) (hK₂ : 0 ≤ K₂)
    (hg : ∀ a : Fin 2, g a = δ⁻¹ * e * v a / ρ)
    (hℓ : ∀ c : Fin 2, ℓ c = p c - v c / Q)
    (hp : ∀ c : Fin 2, |p c| ≤ C)
    (hH : ∀ a c : Fin 2, |G a c * s| ≤ K₁)
    (hHH : ∀ a c : Fin 2, |G a c * s - Ainv a c * sD| ≤ K₂ * (2 * κ * δ))
    (hinv : ∑ a : Fin 2, ∑ c : Fin 2, Ainv a c * v a * v c = Q) :
    |(∑ a : Fin 2, ∑ c : Fin 2, G a c * g a * ℓ c) * s - -(sD * (δ⁻¹ * e) / ρ)| ≤
      (4 * M₁ * Real.sqrt T * K₁ * C + 8 * K₂ * κ * M₁ * T) / δ :=
by
  have hρpos : 0 < ρ := by rw [hρ]; exact Real.sqrt_pos.mpr hQ
  have hρsq : ρ * ρ = Q := by rw [hρ]; exact Real.mul_self_sqrt hQ.le
  have hC : 0 ≤ C := le_trans (abs_nonneg _) (hp 0)
  have hK₁ : 0 ≤ K₁ := le_trans (abs_nonneg _) (hH 0 0)
  have hM : 0 ≤ M₁ := le_trans (abs_nonneg _) hM₁
  have hr0 : 0 ≤ Real.sqrt T := Real.sqrt_nonneg T
  have hrr : Real.sqrt T * Real.sqrt T = T := Real.mul_self_sqrt hT
  have hrρ : 0 ≤ Real.sqrt T * ρ := mul_nonneg hr0 hρpos.le
  
  have hva : ∀ a : Fin 2, |v a| ≤ Real.sqrt T * ρ := by
    intro a
    have h1 : v a ^ 2 ≤ T * Q := by
      have : v a ^ 2 ≤ ∑ b : Fin 2, v b ^ 2 :=
        Finset.single_le_sum (f := fun b => v b ^ 2) (fun b _ => sq_nonneg (v b))
          (Finset.mem_univ a)
      linarith
    have h2 : |v a| ≤ Real.sqrt (T * Q) := Real.abs_le_sqrt h1
    rw [Real.sqrt_mul hT, ← hρ] at h2
    exact h2
  
  have hQQ : Q⁻¹ * Q = 1 := inv_mul_cancel₀ hQ.ne'
  have hid : (∑ a : Fin 2, ∑ c : Fin 2, G a c * g a * ℓ c) * s - -(sD * (δ⁻¹ * e) / ρ)
      = (δ⁻¹ * e / ρ) * ((∑ a : Fin 2, ∑ c : Fin 2, (G a c * s) * v a * p c) -
        (∑ a : Fin 2, ∑ c : Fin 2, (G a c * s - Ainv a c * sD) * v a * v c) / Q) := by
    simp only [hg, hℓ, Fin.sum_univ_two] at hinv ⊢
    linear_combination (-(δ⁻¹ * e / ρ * Q⁻¹ * sD)) * hinv - (δ⁻¹ * e / ρ * sD) * hQQ
  
  have ht1 : |∑ a : Fin 2, ∑ c : Fin 2, (G a c * s) * v a * p c| ≤
      4 * (K₁ * (Real.sqrt T * ρ) * C) := by
    have hterm : ∀ a c : Fin 2, |(G a c * s) * v a * p c| ≤ K₁ * (Real.sqrt T * ρ) * C := by
      intro a c
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul (hH a c) (hva a) (abs_nonneg _) hK₁) (hp c) (abs_nonneg _)
        (mul_nonneg hK₁ hrρ)
    simp only [Fin.sum_univ_two]
    have e00 := abs_le.mp (hterm 0 0)
    have e01 := abs_le.mp (hterm 0 1)
    have e10 := abs_le.mp (hterm 1 0)
    have e11 := abs_le.mp (hterm 1 1)
    rw [abs_le]
    constructor <;> linarith [e00.1, e00.2, e01.1, e01.2, e10.1, e10.2, e11.1, e11.2]
  
  have hK : 0 ≤ K₂ * (2 * κ * δ) := mul_nonneg hK₂ (by positivity)
  have ht2 : |∑ a : Fin 2, ∑ c : Fin 2, (G a c * s - Ainv a c * sD) * v a * v c| ≤
      4 * (K₂ * (2 * κ * δ) * (Real.sqrt T * ρ) * (Real.sqrt T * ρ)) := by
    have hterm : ∀ a c : Fin 2, |(G a c * s - Ainv a c * sD) * v a * v c| ≤
        K₂ * (2 * κ * δ) * (Real.sqrt T * ρ) * (Real.sqrt T * ρ) := by
      intro a c
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul (hHH a c) (hva a) (abs_nonneg _) hK) (hva c) (abs_nonneg _)
        (mul_nonneg hK hrρ)
    simp only [Fin.sum_univ_two]
    have e00 := abs_le.mp (hterm 0 0)
    have e01 := abs_le.mp (hterm 0 1)
    have e10 := abs_le.mp (hterm 1 0)
    have e11 := abs_le.mp (hterm 1 1)
    rw [abs_le]
    constructor <;> linarith [e00.1, e00.2, e01.1, e01.2, e10.1, e10.2, e11.1, e11.2]
  have ht2' : |(∑ a : Fin 2, ∑ c : Fin 2, (G a c * s - Ainv a c * sD) * v a * v c) / Q| ≤
      8 * K₂ * κ * δ * T := by
    rw [abs_div, abs_of_pos hQ, div_le_iff₀ hQ]
    have : 4 * (K₂ * (2 * κ * δ) * (Real.sqrt T * ρ) * (Real.sqrt T * ρ)) =
        8 * K₂ * κ * δ * (Real.sqrt T * Real.sqrt T) * (ρ * ρ) := by ring
    rw [hrr, hρsq] at this
    linarith
  
  rw [hid, abs_mul, abs_div, abs_mul, abs_inv, abs_of_pos hδ, abs_of_pos hρpos]
  set t₁ := ∑ a : Fin 2, ∑ c : Fin 2, (G a c * s) * v a * p c
  set t₂ := (∑ a : Fin 2, ∑ c : Fin 2, (G a c * s - Ainv a c * sD) * v a * v c) / Q
  have hY : |t₁ - t₂| ≤ 4 * (K₁ * (Real.sqrt T * ρ) * C) + 8 * K₂ * κ * δ * T :=
    le_trans (abs_sub _ _) (add_le_add ht1 ht2')
  have hY0 : 0 ≤ |t₁ - t₂| := abs_nonneg _
  have h8 : 0 ≤ 8 * K₂ * κ * M₁ * T := by positivity
  have hkey : |e| * |t₁ - t₂| ≤
      (4 * M₁ * Real.sqrt T * K₁ * C + 8 * K₂ * κ * M₁ * T) * ρ := by
    have h1 : |e| * |t₁ - t₂| ≤
        M₁ * (4 * (K₁ * (Real.sqrt T * ρ) * C) + 8 * K₂ * κ * δ * T) :=
      mul_le_mul hM₁ hY hY0 hM
    have h2 := mul_le_mul_of_nonneg_left hρδ h8
    nlinarith [h1, h2]
  rw [div_mul_eq_mul_div, div_le_div_iff₀ hρpos hδ]
  have hδδ : δ⁻¹ * |e| * |t₁ - t₂| * δ = (δ⁻¹ * δ) * (|e| * |t₁ - t₂|) := by ring
  rw [hδδ, inv_mul_cancel₀ hδ.ne', one_mul]
  exact hkey

theorem pcgb_pf_abstract_limit (W : Set E2) (hW : IsOpen W) (F J : ℝ → E2 → ℝ) (N : ℝ → Set E2)
    (δ₁ K V lim : ℝ) (hδ₁ : 0 < δ₁) (hK : 0 ≤ K) (hV : 0 ≤ V)
    (hN : ∀ δ : ℝ, 0 < δ → δ < δ₁ → IsCompact (N δ) ∧ N δ ⊆ W ∧
      MeasureTheory.volume (N δ) ≤ ENNReal.ofReal (V * δ ^ 2))
    (hFz : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ∀ y ∈ W, y ∉ N δ → F δ y = 0)
    (hJz : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ∀ y : E2, y ∉ N δ → J δ y = 0)
    (hFc : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ContinuousOn (F δ) (N δ))
    (hJc : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ContinuousOn (J δ) (N δ))
    (hJi : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ∫ y, J δ y = lim)
    (hFJ : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ∀ y ∈ N δ, |F δ y - J δ y| ≤ K / δ) :
    Tendsto (fun δ : ℝ => ∫ x in W, F δ x) (𝓝[>] (0 : ℝ)) (𝓝 lim) :=
by
  have hbound : ∀ δ : ℝ, 0 < δ → δ < δ₁ → ‖(∫ x in W, F δ x) - lim‖ ≤ K * V * δ := by
    intro δ hδ hδ'
    obtain ⟨hNc, hNW, hNv⟩ := hN δ hδ hδ'
    have h1 : ∫ x in W, F δ x = ∫ x in N δ, F δ x :=
      MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hW.measurableSet hNW
        (fun x hx => hFz δ hδ hδ' x hx.1 hx.2)
    have h2 : ∫ x in N δ, J δ x = lim := by
      rw [MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero
        (fun x hx => hJz δ hδ hδ' x hx)]
      exact hJi δ hδ hδ'
    have hFi : MeasureTheory.IntegrableOn (F δ) (N δ) :=
      (hFc δ hδ hδ').integrableOn_compact hNc
    have hJi' : MeasureTheory.IntegrableOn (J δ) (N δ) :=
      (hJc δ hδ hδ').integrableOn_compact hNc
    have h3 : (∫ x in W, F δ x) - lim = ∫ x in N δ, (F δ x - J δ x) := by
      rw [h1, ← h2, MeasureTheory.integral_sub hFi hJi']
    have h4 : ‖∫ x in N δ, (F δ x - J δ x)‖ ≤
        K / δ * (MeasureTheory.volume (N δ)).toReal :=
      MeasureTheory.norm_setIntegral_le_of_norm_le_const hNc.measure_lt_top
        (fun x hx => by rw [Real.norm_eq_abs]; exact hFJ δ hδ hδ' x hx)
    have h5 : (MeasureTheory.volume (N δ)).toReal ≤ V * δ ^ 2 :=
      ENNReal.toReal_le_of_le_ofReal (by positivity) hNv
    have h6 : K / δ * (MeasureTheory.volume (N δ)).toReal ≤ K / δ * (V * δ ^ 2) :=
      mul_le_mul_of_nonneg_left h5 (div_nonneg hK hδ.le)
    have h7 : K / δ * (V * δ ^ 2) = K * V * δ := by
      field_simp
    rw [h3]
    linarith
  rw [← tendsto_sub_nhds_zero_iff]
  have hlin : Tendsto (fun δ : ℝ => K * V * δ) (𝓝[>] (0 : ℝ)) (𝓝 0) := by
    have h : Tendsto (fun δ : ℝ => K * V * δ) (𝓝 (0 : ℝ)) (𝓝 (K * V * 0)) :=
      (continuous_const.mul continuous_id).tendsto 0
    rw [mul_zero] at h
    exact tendsto_nhdsWithin_of_tendsto_nhds h
  refine squeeze_zero_norm' ?_ hlin
  filter_upwards [Ioo_mem_nhdsGT hδ₁] with δ hδ
  exact hbound δ hδ.1 hδ.2

theorem pcgb_pf_integrand_cont (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpd : ∀ x ∈ W, (h x).PosDef)
    (x₀ : E2) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall x₀ r ⊆ W)
    (L : E2 → ℝ) (hL : ContDiffOn ℝ ∞ L (Metric.ball x₀ r \ {x₀})) (δ : ℝ) (hδ : 0 < δ) :
    ContinuousOn (fun x => (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c *
        pd2 a (fun y => Real.smoothTransition ((Real.sqrt (∑ a' : Fin 2, ∑ c' : Fin 2,
          h x₀ a' c' * (y - x₀) a' * (y - x₀) c') - δ) / δ)) x * pd2 c L x) *
        Real.sqrt (h x).det) (Metric.ball x₀ r \ {x₀}) :=
by
  have hUo : IsOpen (Metric.ball x₀ r \ {x₀}) := Metric.isOpen_ball.sdiff isClosed_singleton
  have hUW : Metric.ball x₀ r \ {x₀} ⊆ W := fun x hx => hball (Metric.ball_subset_closedBall hx.1)
  have hUc : Metric.ball x₀ r \ {x₀} ⊆ ({x₀}ᶜ : Set E2) := fun x hx => hx.2
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hr.le)
  have hA : (h x₀).PosDef := hpd x₀ hx₀W
  have hc : ∀ i j : Fin 2, ContinuousOn (fun x => h x i j) (Metric.ball x₀ r \ {x₀}) :=
    fun i j => (hh i j).continuousOn.mono hUW
  have hm : ContinuousOn h (Metric.ball x₀ r \ {x₀}) :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hc i j
  have hdetc : ContinuousOn (fun x => (h x).det) (Metric.ball x₀ r \ {x₀}) :=
    (continuous_id.matrix_det).comp_continuousOn hm
  have hdet0 : ∀ x ∈ Metric.ball x₀ r \ {x₀}, (h x).det ≠ 0 :=
    fun x hx => (hpd x (hUW hx)).det_pos.ne'
  have hadj : ContinuousOn (fun x => (h x).adjugate) (Metric.ball x₀ r \ {x₀}) :=
    (continuous_id.matrix_adjugate).comp_continuousOn hm
  have hinv : ∀ a c : Fin 2, ContinuousOn (fun x => (h x)⁻¹ a c) (Metric.ball x₀ r \ {x₀}) := by
    intro a c
    have e : (fun x => (h x)⁻¹ a c) = fun x => (h x).det⁻¹ * (h x).adjugate a c := by
      funext x
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [e]
    exact (hdetc.inv₀ hdet0).mul
      (continuousOn_pi.1 (continuousOn_pi.1 hadj a) c)
  have h1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast (le_top : (1 : ℕ∞) ≤ ⊤)
  have hLd : ∀ c : Fin 2, ContinuousOn (fun x => pd2 c L x) (Metric.ball x₀ r \ {x₀}) := by
    intro c
    exact (hL.continuousOn_fderiv_of_isOpen hUo h1).clm_apply continuousOn_const
  have hcoord : ∀ a' : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a') := by
    intro a'
    exact (contDiff_piLp_apply (p := 2) (i := a')).comp (contDiff_id.sub contDiff_const)
  have hQs : ContDiff ℝ ∞ (fun y : E2 => ∑ a' : Fin 2, ∑ c' : Fin 2,
      h x₀ a' c' * (y - x₀) a' * (y - x₀) c') := by
    refine ContDiff.sum (fun a' _ => ContDiff.sum (fun c' _ => ?_))
    exact (contDiff_const.mul (hcoord a')).mul (hcoord c')
  have hQpos : ∀ y ∈ ({x₀}ᶜ : Set E2),
      (∑ a' : Fin 2, ∑ c' : Fin 2, h x₀ a' c' * (y - x₀) a' * (y - x₀) c') ≠ 0 := by
    intro y hy
    have hzx : y ≠ x₀ := hy
    have hw0 : (fun a : Fin 2 => (y - x₀) a) ≠ 0 := by
      intro h'
      apply hzx
      have h'' : y - x₀ = 0 := by
        ext i
        have := congrFun h' i
        simpa using this
      exact sub_eq_zero.mp h''
    have e1 := hA.dotProduct_mulVec_pos hw0
    have e2 : star (fun a : Fin 2 => (y - x₀) a) ⬝ᵥ
        (h x₀).mulVec (fun a : Fin 2 => (y - x₀) a) =
        ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
      ring
    rw [← e2]
    exact e1.ne'
  have hsq : ContDiffOn ℝ ∞ (fun y : E2 => Real.sqrt (∑ a' : Fin 2, ∑ c' : Fin 2,
      h x₀ a' c' * (y - x₀) a' * (y - x₀) c')) ({x₀}ᶜ : Set E2) :=
    hQs.contDiffOn.sqrt hQpos
  have hχ : ContDiffOn ℝ ∞ (fun y : E2 => Real.smoothTransition ((Real.sqrt
      (∑ a' : Fin 2, ∑ c' : Fin 2, h x₀ a' c' * (y - x₀) a' * (y - x₀) c') - δ) / δ))
      ({x₀}ᶜ : Set E2) :=
    (Real.smoothTransition.contDiff (n := ⊤)).comp_contDiffOn
      ((hsq.sub contDiffOn_const).div_const δ)
  have hχd : ∀ a : Fin 2, ContinuousOn (fun x => pd2 a (fun y => Real.smoothTransition
      ((Real.sqrt (∑ a' : Fin 2, ∑ c' : Fin 2, h x₀ a' c' * (y - x₀) a' * (y - x₀) c') - δ)
        / δ)) x) (Metric.ball x₀ r \ {x₀}) := by
    intro a
    exact ((hχ.continuousOn_fderiv_of_isOpen isOpen_compl_singleton h1).clm_apply
      continuousOn_const).mono hUc
  have hdet : ContinuousOn (fun x => Real.sqrt (h x).det) (Metric.ball x₀ r \ {x₀}) :=
    hdetc.sqrt
  refine ContinuousOn.mul ?_ hdet
  refine continuousOn_finset_sum _ (fun a _ => continuousOn_finset_sum _ (fun c _ => ?_))
  exact ((hinv a c).mul (hχd a)).mul (hLd c)

theorem pcgb_pole_flux_limit (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpd : ∀ x ∈ W, (h x).PosDef)
    (x₀ : E2) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall x₀ r ⊆ W)
    (L : E2 → ℝ) (hL : ContDiffOn ℝ ∞ L (Metric.ball x₀ r \ {x₀})) (C : ℝ)
    (hgrad : ∀ x ∈ Metric.ball x₀ r, x ≠ x₀ →
      ‖fderiv ℝ (fun y => L y + Real.log (Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2,
         h x₀ a c * (y - x₀) a * (y - x₀) c))) x‖ ≤ C) :
    Tendsto (fun δ : ℝ => ∫ x in W, (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c *
        pd2 a (fun y => Real.smoothTransition ((Real.sqrt (∑ a' : Fin 2, ∑ c' : Fin 2,
           h x₀ a' c' * (y - x₀) a' * (y - x₀) c') - δ) / δ)) x * pd2 c L x) *
        Real.sqrt (h x).det)
      (𝓝[>] (0 : ℝ)) (𝓝 (-(2 * Real.pi))) :=
by
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hr.le)
  have hA : (h x₀).PosDef := hpd x₀ hx₀W
  obtain ⟨hsymm, hD, ha, hT, hz⟩ := pcgb_pf_quad_facts (h x₀) hA
  obtain ⟨hηc, _hηd, hη0, hη1, M₁, hM₁0, hM₁⟩ := pcgb_pf_eta_deriv
  obtain ⟨K₁, K₂, hK₁, hK₂, hKb⟩ := pcgb_pf_metric_bounds W hW h hh hpd x₀ r hr hball
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ,
      Q = fun y => ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c := ⟨_, rfl⟩
  have hQe : ∀ y, Q y = ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c :=
    fun y => by rw [hQ]
  have hQc : Continuous Q := by rw [hQ]; fun_prop
  have hρc : Continuous (fun y => Real.sqrt (Q y)) := hQc.sqrt
  have hQnn : ∀ y, 0 ≤ Q y := fun y => by rw [hQe]; exact (hz (y - x₀)).1
  have hQx₀ : Q x₀ = 0 := by rw [hQe]; simp
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = Real.sqrt ((h x₀ 0 0 + h x₀ 1 1) / (h x₀).det) := ⟨_, rfl⟩
  have hκpos : 0 < κ := by rw [hκ]; exact Real.sqrt_pos.mpr (div_pos hT hD)
  have hκsq : κ ^ 2 = (h x₀ 0 0 + h x₀ 1 1) / (h x₀).det := by
    rw [hκ]; exact Real.sq_sqrt (div_pos hT hD).le
  have hκdet : κ ^ 2 * (h x₀).det = h x₀ 0 0 + h x₀ 1 1 := by
    rw [hκsq, div_mul_cancel₀ _ hD.ne']
  have h3κ : (0 : ℝ) < 3 * κ := mul_pos (by norm_num) hκpos
  have hδ₁ : 0 < r / (3 * κ) := div_pos hr h3κ
  obtain ⟨N, hN⟩ : ∃ N : ℝ → Set E2,
      N = fun δ => {y | δ ≤ Real.sqrt (Q y) ∧ Real.sqrt (Q y) ≤ 2 * δ} := ⟨_, rfl⟩
  have hNmem : ∀ δ y, y ∈ N δ ↔ δ ≤ Real.sqrt (Q y) ∧ Real.sqrt (Q y) ≤ 2 * δ := by
    intro δ y; rw [hN]; exact Iff.rfl
  have hgeo : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ∀ y ∈ N δ,
      0 < Q y ∧ y ≠ x₀ ∧ ‖y - x₀‖ ≤ 2 * κ * δ ∧ ‖y - x₀‖ < 3 * κ * δ ∧ 3 * κ * δ < r := by
    intro δ hδ hδ₁' y hy
    rw [hNmem] at hy
    obtain ⟨hy1, hy2⟩ := hy
    have hρpos : 0 < Real.sqrt (Q y) := lt_of_lt_of_le hδ hy1
    have hQpos : 0 < Q y := Real.sqrt_pos.mp hρpos
    have hne : y ≠ x₀ := by
      rintro rfl
      rw [hQx₀] at hQpos
      exact lt_irrefl _ hQpos
    have hQle : Q y ≤ 4 * δ ^ 2 := by
      have h1 : Q y = Real.sqrt (Q y) ^ 2 := (Real.sq_sqrt (hQnn y)).symm
      rw [h1]
      nlinarith [Real.sqrt_nonneg (Q y)]
    have hDz : (h x₀).det * ‖y - x₀‖ ^ 2 ≤ (h x₀ 0 0 + h x₀ 1 1) * Q y := by
      rw [hQe]; exact (hz (y - x₀)).2.2.2.1
    have hnorm_sq : ‖y - x₀‖ ^ 2 ≤ (2 * κ * δ) ^ 2 := by
      have e1 : (2 * κ * δ) ^ 2 * (h x₀).det = 4 * (h x₀ 0 0 + h x₀ 1 1) * δ ^ 2 := by
        calc (2 * κ * δ) ^ 2 * (h x₀).det = 4 * δ ^ 2 * (κ ^ 2 * (h x₀).det) := by ring
          _ = 4 * (h x₀ 0 0 + h x₀ 1 1) * δ ^ 2 := by rw [hκdet]; ring
      have e2 : ‖y - x₀‖ ^ 2 * (h x₀).det ≤ (2 * κ * δ) ^ 2 * (h x₀).det := by
        rw [e1]
        have := mul_le_mul_of_nonneg_left hQle hT.le
        linarith
      exact le_of_mul_le_mul_right e2 hD
    have hnorm : ‖y - x₀‖ ≤ 2 * κ * δ :=
      (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hnorm_sq
    have h3 : 3 * κ * δ < r := by
      have := (lt_div_iff₀ h3κ).mp hδ₁'
      linarith
    have hκδ : 0 < κ * δ := mul_pos hκpos hδ
    exact ⟨hQpos, hne, hnorm, by linarith, h3⟩
  have hsubN : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → N δ ⊆ Metric.ball x₀ r \ {x₀} := by
    intro δ hδ hδ₁' y hy
    obtain ⟨_, hne, _, hlt, h3⟩ := hgeo δ hδ hδ₁' y hy
    refine ⟨?_, hne⟩
    rw [Metric.mem_ball, dist_eq_norm]
    linarith
  have hηout : ∀ δ : ℝ, 0 < δ → ∀ y, y ∉ N δ →
      deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ) = 0 := by
    intro δ hδ y hy
    rw [hNmem] at hy
    by_cases h1 : δ ≤ Real.sqrt (Q y)
    · have h2 : 2 * δ < Real.sqrt (Q y) := by
        by_contra h3
        exact hy ⟨h1, not_lt.mp h3⟩
      apply hη1
      rw [le_div_iff₀ hδ]
      linarith
    · apply hη0
      rw [div_le_iff₀ hδ]
      linarith [not_le.mp h1]
  have hs3 : ∀ δ : ℝ, 0 < δ →
      (∀ y : E2, y ≠ x₀ →
        DifferentiableAt ℝ (fun y' => Real.log (Real.sqrt (Q y'))) y ∧
        ∀ a : Fin 2,
          pd2 a (fun y' => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) y =
            δ⁻¹ * deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ) *
              (∑ c : Fin 2, h x₀ a c * (y - x₀) c) / Real.sqrt (Q y) ∧
          pd2 a (fun y' => Real.log (Real.sqrt (Q y'))) y =
            (∑ c : Fin 2, h x₀ a c * (y - x₀) c) / Q y) ∧
      ∀ a : Fin 2, pd2 a (fun y' => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) x₀ = 0 := by
    intro δ hδ
    subst hQ
    exact pcgb_pf_cutoff_derivs (h x₀) hsymm (fun z hz0 => (hz z).2.1 hz0) x₀ δ hδ
  have hχz : ∀ δ : ℝ, 0 < δ → ∀ y, y ∉ N δ → ∀ a : Fin 2,
      pd2 a (fun y' => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) y = 0 := by
    intro δ hδ y hy a
    by_cases hyx : y = x₀
    · rw [hyx]; exact (hs3 δ hδ).2 a
    · rw [(((hs3 δ hδ).1 y hyx).2 a).1, hηout δ hδ y hy]
      simp
  obtain ⟨F, hF⟩ : ∃ F : ℝ → E2 → ℝ, F = fun δ x => (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c *
      pd2 a (fun y => Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ)) x * pd2 c L x) *
      Real.sqrt (h x).det := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℝ → E2 → ℝ, J = fun δ y => -(Real.sqrt (h x₀).det *
      (δ⁻¹ * deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ)) / Real.sqrt (Q y)) :=
    ⟨_, rfl⟩
  have hK : 0 ≤ 4 * M₁ * Real.sqrt (h x₀ 0 0 + h x₀ 1 1) * K₁ * max C 0 +
      8 * K₂ * κ * M₁ * (h x₀ 0 0 + h x₀ 1 1) := by
    have h1 : 0 ≤ 4 * M₁ * Real.sqrt (h x₀ 0 0 + h x₀ 1 1) * K₁ * max C 0 :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hM₁0)
        (Real.sqrt_nonneg _)) hK₁) (le_max_right C 0)
    have h2 : 0 ≤ 8 * K₂ * κ * M₁ * (h x₀ 0 0 + h x₀ 1 1) :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hK₂) hκpos.le) hM₁0) hT.le
    linarith
  have hV : (0 : ℝ) ≤ 9 * κ ^ 2 * Real.pi := by positivity
  have hNprop : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → IsCompact (N δ) ∧ N δ ⊆ W ∧
      MeasureTheory.volume (N δ) ≤ ENNReal.ofReal (9 * κ ^ 2 * Real.pi * δ ^ 2) := by
    intro δ hδ hδ₁'
    have hclosed : IsClosed (N δ) := by
      have : N δ = {y | δ ≤ Real.sqrt (Q y)} ∩ {y | Real.sqrt (Q y) ≤ 2 * δ} := by
        ext y; rw [hNmem]; exact Iff.rfl
      rw [this]
      exact (isClosed_le continuous_const hρc).inter (isClosed_le hρc continuous_const)
    refine ⟨(isCompact_closedBall x₀ r).of_isClosed_subset hclosed
        (fun y hy => Metric.ball_subset_closedBall (hsubN δ hδ hδ₁' hy).1),
      fun y hy => hball (Metric.ball_subset_closedBall (hsubN δ hδ hδ₁' hy).1), ?_⟩
    calc MeasureTheory.volume (N δ) ≤ MeasureTheory.volume (Metric.ball x₀ (3 * κ * δ)) :=
          MeasureTheory.measure_mono (fun y hy => by
            rw [Metric.mem_ball, dist_eq_norm]; exact (hgeo δ hδ hδ₁' y hy).2.2.2.1)
      _ = ENNReal.ofReal (3 * κ * δ) ^ 2 * ENNReal.ofReal Real.pi :=
          EuclideanSpace.volume_ball_fin_two _ _
      _ = ENNReal.ofReal (9 * κ ^ 2 * Real.pi * δ ^ 2) := by
          rw [← ENNReal.ofReal_pow (p := 3 * κ * δ) (by positivity) 2,
            ← ENNReal.ofReal_mul (p := (3 * κ * δ) ^ 2) (by positivity)]
          congr 1; ring
  have hFz : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ∀ y ∈ W, y ∉ N δ → F δ y = 0 := by
    intro δ hδ _ y _ hy
    subst hF
    beta_reduce
    simp only [hχz δ hδ y hy, mul_zero, zero_mul, Finset.sum_const_zero]
  have hJz : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ∀ y : E2, y ∉ N δ → J δ y = 0 := by
    intro δ hδ _ y hy
    subst hJ
    beta_reduce
    rw [hηout δ hδ y hy]
    simp
  have hFc : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ContinuousOn (F δ) (N δ) := by
    intro δ hδ hδ₁'
    have hsub := hsubN δ hδ hδ₁'
    subst hF hQ
    exact (pcgb_pf_integrand_cont W hW h hh hpd x₀ r hr hball L hL δ hδ).mono hsub
  have hJc : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ContinuousOn (J δ) (N δ) := by
    intro δ hδ _
    subst hJ
    show ContinuousOn (fun y => -(Real.sqrt (h x₀).det *
      (δ⁻¹ * deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ)) / Real.sqrt (Q y))) (N δ)
    refine ContinuousOn.neg (ContinuousOn.div ?_ hρc.continuousOn ?_)
    · exact (continuous_const.mul (continuous_const.mul
        (hηc.comp ((hρc.sub continuous_const).div_const δ)))).continuousOn
    · intro y hy
      exact ne_of_gt (lt_of_lt_of_le hδ ((hNmem δ y).mp hy).1)
  have hJi : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ∫ y, J δ y = -(2 * Real.pi) := by
    intro δ hδ _
    subst hJ hQ
    exact pcgb_pf_frozen_integral (h x₀) (hsymm 0 1) ha hD x₀ δ hδ hηc hη0 hη1
  have hFJ : ∀ δ : ℝ, 0 < δ → δ < r / (3 * κ) → ∀ y ∈ N δ, |F δ y - J δ y| ≤
      (4 * M₁ * Real.sqrt (h x₀ 0 0 + h x₀ 1 1) * K₁ * max C 0 +
        8 * K₂ * κ * M₁ * (h x₀ 0 0 + h x₀ 1 1)) / δ := by
    intro δ hδ hδ₁' y hy
    obtain ⟨hQpos, hne, hnorm, _, _⟩ := hgeo δ hδ hδ₁' y hy
    have hyball : y ∈ Metric.ball x₀ r := (hsubN δ hδ hδ₁' hy).1
    have hyU : Metric.ball x₀ r \ {x₀} ∈ 𝓝 y :=
      (Metric.isOpen_ball.sdiff isClosed_singleton).mem_nhds ⟨hyball, hne⟩
    have hLd : DifferentiableAt ℝ L y := (hL.contDiffAt hyU).differentiableAt (by simp)
    obtain ⟨hlogd, hform⟩ := (hs3 δ hδ).1 y hne
    have hpφ : ∀ c : Fin 2, pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y =
        pd2 c L y + (∑ k : Fin 2, h x₀ c k * (y - x₀) k) / Q y := by
      intro c
      have e1 : pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y =
          pd2 c L y + pd2 c (fun y' => Real.log (Real.sqrt (Q y'))) y := by
        simp only [pd2]
        rw [fderiv_fun_add hLd hlogd, ContinuousLinearMap.add_apply]
      rw [e1, (hform c).2]
    have hgradQ : ‖fderiv ℝ (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y‖ ≤ C := by
      have hg := hgrad y hyball hne
      subst hQ
      exact hg
    have hp : ∀ c : Fin 2,
        |pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y| ≤ max C 0 := by
      intro c
      have h1 : |pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y| ≤
          ‖fderiv ℝ (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y‖ := by
        simp only [pd2]
        rw [← Real.norm_eq_abs]
        calc _ ≤ ‖fderiv ℝ (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y‖ * ‖e2 c‖ :=
              ContinuousLinearMap.le_opNorm _ _
          _ = _ := by simp
      linarith [le_max_left C 0]
    have hℓ : ∀ c : Fin 2, pd2 c L y =
        pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y -
          (∑ k : Fin 2, h x₀ c k * (y - x₀) k) / Q y := by
      intro c; rw [hpφ c]; ring
    have hv : ∑ a : Fin 2, (∑ c : Fin 2, h x₀ a c * (y - x₀) c) ^ 2 ≤
        (h x₀ 0 0 + h x₀ 1 1) * Q y := by
      rw [hQe]; exact (hz (y - x₀)).2.2.1
    have hinv : ∑ a : Fin 2, ∑ c : Fin 2, (h x₀)⁻¹ a c * (∑ k : Fin 2, h x₀ a k * (y - x₀) k) *
        (∑ k : Fin 2, h x₀ c k * (y - x₀) k) = Q y := by
      rw [hQe]; exact (hz (y - x₀)).2.2.2.2
    have hyc : y ∈ Metric.closedBall x₀ r := Metric.ball_subset_closedBall hyball
    have hfinal := pcgb_pf_pointwise_algebra (fun a c => (h y)⁻¹ a c) (fun a c => (h x₀)⁻¹ a c)
      (fun a => pd2 a (fun y' => Real.smoothTransition ((Real.sqrt (Q y') - δ) / δ)) y)
      (fun c => pd2 c L y)
      (fun c => pd2 c (fun y' => L y' + Real.log (Real.sqrt (Q y'))) y)
      (fun a => ∑ k : Fin 2, h x₀ a k * (y - x₀) k)
      (Real.sqrt (h y).det) (Real.sqrt (h x₀).det) (Q y) (Real.sqrt (Q y)) δ
      (deriv Real.smoothTransition ((Real.sqrt (Q y) - δ) / δ)) M₁ (h x₀ 0 0 + h x₀ 1 1)
      K₁ K₂ κ (max C 0)
      hδ hQpos rfl ((hNmem δ y).mp hy).1 (hM₁ _) hT.le hv hκpos.le hK₂
      (fun a => (hform a).1) hℓ hp
      (fun a c => (hKb y hyc a c).1)
      (fun a c => le_trans (hKb y hyc a c).2 (mul_le_mul_of_nonneg_left hnorm hK₂))
      hinv
    subst hF hJ
    exact hfinal
  have key := pcgb_pf_abstract_limit W hW F J N (r / (3 * κ))
    (4 * M₁ * Real.sqrt (h x₀ 0 0 + h x₀ 1 1) * K₁ * max C 0 +
      8 * K₂ * κ * M₁ * (h x₀ 0 0 + h x₀ 1 1))
    (9 * κ ^ 2 * Real.pi) (-(2 * Real.pi)) hδ₁ hK hV hNprop hFz hJz hFc hJc hJi hFJ
  subst hF hQ
  exact key

theorem pcgb_pd_integrable {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (j₀ : Fin P.n) (x₀ : E2) (p₀ : X) (r : ℝ) (hr : 0 < r) (hp₀ : P.param j₀ x₀ = p₀)
    (hball : Metric.closedBall x₀ r ⊆ P.W j₀)
    (hbpos : ∀ x ∈ Metric.closedBall x₀ r, 2 * r ≤ b (P.param j₀ x))
    (U : Set X) (hU : IsOpen U) (hRU : {q | q ∈ S ∧ 0 ≤ b q} ⊆ U)
    (L : Fin P.n → E2 → ℝ)
    (hLs : ∀ j, ContDiffOn ℝ ∞ (L j) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})))
    (hLc : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' (P.O k ∩ (U \ {p₀})),
      L j x = L k (P.proj k (P.param j x)))
    (C : ℝ) (hpole : ∀ x ∈ Metric.ball x₀ r, x ≠ x₀ →
      ‖fderiv ℝ (fun y => L j₀ y + Real.log (pcgbPoleRad P j₀ x₀ y)) x‖ ≤ C ∧
      |lap2 (P.h j₀) (L j₀) x| ≤ C)
    (hlap : ∀ (A B : Set E2), IsOpen A → IsOpen B → ∀ (τ : E2 → E2),
      ContDiffOn ℝ ∞ τ A → (∀ x ∈ A, τ x ∈ B) → ∀ (h h' : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h y c d) A) →
      (∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h' y c d) B) →
      (∀ y ∈ B, (h' y).PosDef) → (∀ x ∈ A, (h x).PosDef) →
      (∀ x ∈ A, ∀ c d : Fin 2, h x c d = ∑ c' : Fin 2, ∑ d' : Fin 2,
        fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d' * fderiv ℝ τ x (e2 d) d') →
      ∀ (g : E2 → ℝ), ContDiffOn ℝ ∞ g B → ∀ (f : E2 → ℝ), (∀ x ∈ A, f x = g (τ x)) →
      ∀ x ∈ A, lap2 h f x = lap2 h' g (τ x)) :
    ∀ s : ℝ, 0 < s → s ≤ r →
      (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) *
         Real.sqrt (P.h j x).det) (P.W j)) ∧
      (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
           ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
             pd2 c (L j) x) *
         Real.sqrt (P.h j x).det) (P.W j)) :=
by
  classical
  intro s hs hsr
  
  have hx₀W : x₀ ∈ P.W j₀ := hball (Metric.mem_closedBall_self hr.le)
  have hparamS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have h := Set.mem_image_of_mem (P.param j) hx
    rw [P.image_eq j] at h
    exact h.2
  have hbp₀ : 2 * r ≤ b p₀ := by
    rw [← hp₀]; exact hbpos x₀ (Metric.mem_closedBall_self hr.le)
  have hUo : IsOpen (U \ {p₀}) := hU.sdiff isClosed_singleton
  have hΩo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) hUo
  have hinfG : ∀ (W : Set E2), IsOpen W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ c : Fin 2,
      ContDiffOn ℝ ∞ (pd2 c f) W := by
    intro W hW f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) W :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdetS : ∀ j, ContDiffOn ℝ ∞ (fun y => (P.h j y).det) (P.W j) := by
    intro j
    have hh := P.h_smooth j
    have heq : (fun y => (P.h j y).det) =
        fun y => P.h j y 0 0 * P.h j y 1 1 - P.h j y 0 1 * P.h j y 1 0 := by
      funext y
      exact Matrix.det_fin_two (P.h j y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hinv : ∀ j (a c : Fin 2), ContDiffOn ℝ ∞ (fun y => (P.h j y)⁻¹ a c) (P.W j) := by
    intro j a c
    have hh := P.h_smooth j
    have hdet : ∀ y ∈ P.W j, (P.h j y).det ≠ 0 := fun y hy => (P.h_posDef j y hy).det_pos.ne'
    have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (P.h j y).adjugate a c) (P.W j) := by
      intro a c
      fin_cases a <;> fin_cases c <;> simp [Matrix.adjugate_fin_two] <;>
        first | exact hh _ _ | exact (hh _ _).neg
    have heq : (fun y => (P.h j y)⁻¹ a c) =
        fun y => ((P.h j y).det)⁻¹ * (P.h j y).adjugate a c := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetS j).inv hdet).mul (hadj a c)
  have hchr : ∀ j (k a c : Fin 2), ContDiffOn ℝ ∞ (christoffel2 (P.h j) k a c) (P.W j) := by
    intro j k a c
    have hh := P.h_smooth j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (P.h j x)⁻¹ k l *
      (pd2 a (fun z => P.h j z c l) x + pd2 c (fun z => P.h j z a l) x
        - pd2 l (fun z => P.h j z a c) x)) (P.W j)
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv j k l).mul
      (((hinfG _ (P.W_open j) _ (hh c l) a).add (hinfG _ (P.W_open j) _ (hh a l) c)).sub
        (hinfG _ (P.W_open j) _ (hh a c) l)))
  have hlapC : ∀ j, ContinuousOn (lap2 (P.h j) (L j)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := by
    intro j
    have hΩW : P.W j ∩ P.param j ⁻¹' (U \ {p₀}) ⊆ P.W j := Set.inter_subset_left
    have hL1 : ∀ k, ContDiffOn ℝ ∞ (pd2 k (L j)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) :=
      fun k => hinfG _ (hΩo j) _ (hLs j) k
    have hL2 : ∀ a c, ContDiffOn ℝ ∞ (pd2 a (pd2 c (L j))) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) :=
      fun a c => hinfG _ (hΩo j) _ (hL1 c) a
    show ContinuousOn (fun x => ∑ i : Fin 2, ∑ k : Fin 2, (P.h j x)⁻¹ i k *
      (pd2 i (pd2 k (L j)) x - ∑ m : Fin 2, christoffel2 (P.h j) m i k x * pd2 m (L j) x)) _
    exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun k _ =>
      ((hinv j i k).continuousOn.mono hΩW).mul ((hL2 i k).continuousOn.sub
        (continuousOn_finset_sum _ fun m _ =>
          ((hchr j m i k).continuousOn.mono hΩW).mul (hL1 m).continuousOn))
  have hdη : ∀ t : ℝ, (t < 0 ∨ 1 < t) → deriv Real.smoothTransition t = 0 := by
    intro t ht
    rcases ht with ht | ht
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] (fun _ => (0 : ℝ)) := by
        filter_upwards [Iio_mem_nhds ht] with y hy
        exact Real.smoothTransition.zero_of_nonpos (le_of_lt hy)
      rw [hev.deriv_eq]
      exact deriv_const t 0
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] (fun _ => (1 : ℝ)) := by
        filter_upwards [Ioi_mem_nhds ht] with y hy
        exact Real.smoothTransition.one_of_one_le (le_of_lt hy)
      rw [hev.deriv_eq]
      exact deriv_const t 1
  have hdηc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := ⊤)).continuous_deriv (by exact_mod_cast le_top)
  refine ⟨fun j => ?_, fun j => ?_⟩
  
  · have hΩW : P.W j ∩ P.param j ⁻¹' (U \ {p₀}) ⊆ P.W j := Set.inter_subset_left
    obtain ⟨F, hF⟩ : ∃ F : E2 → ℝ, F = fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) *
        Real.sqrt (P.h j x).det := ⟨_, rfl⟩
    rw [← hF]
    
    have hFΩ : ContinuousOn F (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := by
      rw [hF]
      have hρc := (hρs j j).continuousOn.mono hΩW
      have hηc : ContinuousOn (fun x => Real.smoothTransition (b (P.param j x) / s))
          (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) :=
        Real.smoothTransition.continuous.comp_continuousOn
          (((hb j).continuousOn.div_const s).mono hΩW)
      have hdA : ContinuousOn (fun x => Real.sqrt (P.h j x).det)
          (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := ((hdetS j).continuousOn.sqrt).mono hΩW
      exact (hρc.mul (hηc.mul (hlapC j))).mul hdA
    have hcont : ContinuousOn F {x | x ∈ P.W j ∧ P.param j x ≠ p₀} := by
      intro x hx
      apply ContinuousAt.continuousWithinAt
      by_cases hbx : b (P.param j x) < 0
      · have hNo : IsOpen (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Iio 0) :=
          (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Iio
        have hev : F =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          refine Filter.eventually_of_mem (hNo.mem_nhds ⟨hx.1, hbx⟩) (fun y hy => ?_)
          have hy2 : b (P.param j y) < 0 := hy.2
          rw [hF]
          simp only [Real.smoothTransition.zero_of_nonpos (div_neg_of_neg_of_pos hy2 hs).le,
            zero_mul, mul_zero]
        exact continuousAt_const.congr hev.symm
      · have hxΩ : x ∈ P.W j ∩ P.param j ⁻¹' (U \ {p₀}) :=
          ⟨hx.1, hRU ⟨hparamS j x hx.1, not_lt.mp hbx⟩, hx.2⟩
        exact hFΩ.continuousAt ((hΩo j).mem_nhds hxΩ)
    
    have hlift : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O j₀,
        P.proj j₀ (P.param j x) ∈ P.W j₀ ∧
          P.param j₀ (P.proj j₀ (P.param j x)) = P.param j x := by
      intro x hx
      have hq : P.param j x ∈ P.O j₀ ∩ S := ⟨hx.2, hparamS j x hx.1⟩
      rw [← P.image_eq j₀] at hq
      obtain ⟨z, hz, hzq⟩ := hq
      rw [← hzq, P.proj_param j₀ z hz]
      exact ⟨hz, rfl⟩
    have hinj0 : ∀ y ∈ P.W j₀, P.param j₀ y = p₀ → y = x₀ := by
      intro y hy h
      calc y = P.proj j₀ (P.param j₀ y) := (P.proj_param j₀ y hy).symm
        _ = P.proj j₀ (P.param j₀ x₀) := by rw [h, hp₀]
        _ = x₀ := P.proj_param j₀ x₀ hx₀W
    have hp₀O : p₀ ∈ P.O j₀ := by
      have h := Set.mem_image_of_mem (P.param j₀) hx₀W
      rw [P.image_eq j₀, hp₀] at h
      exact h.1
    have hproj₀ : P.proj j₀ p₀ = x₀ := by rw [← hp₀]; exact P.proj_param j₀ x₀ hx₀W
    have hD0o : IsOpen (P.W j ∩ P.param j ⁻¹' P.O j₀) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open j₀)
    have hτc : ContinuousOn (fun x' => P.proj j₀ (P.param j x')) (P.W j ∩ P.param j ⁻¹' P.O j₀) :=
      (P.trans_smooth j j₀).continuousOn
    have hBo : IsOpen (Metric.ball x₀ r \ {x₀}) := Metric.isOpen_ball.sdiff isClosed_singleton
    have hVo : IsOpen ((P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' Metric.ball x₀ r) :=
      hτc.isOpen_inter_preimage hD0o Metric.isOpen_ball
    have hAo : IsOpen ((P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' (Metric.ball x₀ r \ {x₀})) :=
      hτc.isOpen_inter_preimage hD0o hBo
    have hBsub : Metric.ball x₀ r \ {x₀} ⊆ P.W j₀ := fun y hy =>
      hball (Metric.ball_subset_closedBall hy.1)
    have hgood0 : ∀ y ∈ Metric.ball x₀ r \ {x₀}, P.param j₀ y ∈ U \ {p₀} := by
      intro y hy
      have hyW := hBsub hy
      have hb2 := hbpos y (Metric.ball_subset_closedBall hy.1)
      refine ⟨hRU ⟨hparamS j₀ y hyW, by linarith⟩, ?_⟩
      intro h
      exact hy.2 (hinj0 y hyW h)
    have hlapeq : ∀ x ∈ (P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' (Metric.ball x₀ r \ {x₀}),
        lap2 (P.h j) (L j) x =
          lap2 (P.h j₀) (L j₀) ((fun x' => P.proj j₀ (P.param j x')) x) := by
      refine hlap _ _ hAo hBo (fun x' => P.proj j₀ (P.param j x'))
        ((P.trans_smooth j j₀).mono Set.inter_subset_left) (fun x hx => hx.2) (P.h j) (P.h j₀)
        (fun c d => (P.h_smooth j c d).mono (fun x hx => hx.1.1))
        (fun c d => (P.h_smooth j₀ c d).mono hBsub)
        (fun y hy => P.h_posDef j₀ y (hBsub hy))
        (fun x hx => P.h_posDef j x hx.1.1)
        (fun x hx c d => P.h_compat j j₀ x hx.1 c d)
        (L j₀) ((hLs j₀).mono (fun y hy => ⟨hBsub hy, hgood0 y hy⟩))
        (L j) ?_
      intro x hx
      have hgx : P.param j x ∈ U \ {p₀} := by
        rw [← (hlift x hx.1).2]
        exact hgood0 _ hx.2
      exact hLc j j₀ x ⟨hx.1.1, hx.1.2, hgx⟩
    have hZV : ∀ x ∈ P.W j, P.param j x = p₀ → x ∈ (P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' Metric.ball x₀ r := by
      intro x hx h
      refine ⟨⟨hx, ?_⟩, ?_⟩
      · show P.param j x ∈ P.O j₀
        rw [h]; exact hp₀O
      · show P.proj j₀ (P.param j x) ∈ Metric.ball x₀ r
        rw [h, hproj₀]; exact Metric.mem_ball_self hr
    have hbdV : ∀ x ∈ (P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' Metric.ball x₀ r,
        P.param j x ≠ p₀ → |lap2 (P.h j) (L j) x| ≤ C := by
      intro x hx hne
      have hτB : P.proj j₀ (P.param j x) ∈ Metric.ball x₀ r \ {x₀} := by
        refine ⟨hx.2, ?_⟩
        intro h
        have h' : P.proj j₀ (P.param j x) = x₀ := h
        apply hne
        have he := (hlift x hx.1).2
        rw [h'] at he
        rw [← he, hp₀]
      rw [hlapeq x ⟨hx.1, hτB⟩]
      exact (hpole _ hτB.1 hτB.2).2
    
    have hZsub : ({x | x ∈ P.W j ∧ P.param j x = p₀} : Set E2).Subsingleton := by
      intro x hx y hy
      have h1 : P.param j x = p₀ := hx.2
      have h2 : P.param j y = p₀ := hy.2
      calc x = P.proj j (P.param j x) := (P.proj_param j x hx.1).symm
        _ = P.proj j (P.param j y) := by rw [h1, h2]
        _ = y := P.proj_param j y hy.1
    have hZ0 : (volume : Measure E2) {x | x ∈ P.W j ∧ P.param j x = p₀} = 0 :=
      hZsub.measure_zero _
    have hZm : MeasurableSet ({x | x ∈ P.W j ∧ P.param j x = p₀} : Set E2) :=
      hZsub.measurableSet
    
    have hKc := (hK j).1
    have hKW := (hK j).2
    obtain ⟨Mρ, hMρ⟩ := hKc.exists_bound_of_continuousOn ((hρs j j).continuousOn.mono hKW)
    obtain ⟨MA, hMA⟩ := hKc.exists_bound_of_continuousOn
      (((hdetS j).continuousOn.sqrt).mono hKW)
    have hKVsub : Kc j \ ((P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
        (fun x' => P.proj j₀ (P.param j x')) ⁻¹' Metric.ball x₀ r) ⊆
        {x | x ∈ P.W j ∧ P.param j x ≠ p₀} := by
      rintro x ⟨hxK, hxV⟩
      exact ⟨hKW hxK, fun h => hxV (hZV x (hKW hxK) h)⟩
    obtain ⟨M₁, hM₁⟩ := (hKc.diff hVo).exists_bound_of_continuousOn (hcont.mono hKVsub)
    have hbound : ∀ x ∈ Kc j, x ∉ {x | x ∈ P.W j ∧ P.param j x = p₀} →
        ‖F x‖ ≤ max M₁ (Mρ * C * MA) := by
      intro x hxK hxZ
      by_cases hxV : x ∈ (P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
          (fun x' => P.proj j₀ (P.param j x')) ⁻¹' Metric.ball x₀ r
      · have hne : P.param j x ≠ p₀ := fun h => hxZ ⟨hKW hxK, h⟩
        have h1 : |ρ j (P.param j x)| ≤ Mρ := by
          rw [← Real.norm_eq_abs]; exact hMρ x hxK
        have h2 : |Real.smoothTransition (b (P.param j x) / s)| ≤ 1 := by
          rw [abs_of_nonneg (Real.smoothTransition.nonneg _)]
          exact Real.smoothTransition.le_one _
        have h3 : |lap2 (P.h j) (L j) x| ≤ C := hbdV x hxV hne
        have h4 : |Real.sqrt (P.h j x).det| ≤ MA := by
          rw [← Real.norm_eq_abs]; exact hMA x hxK
        have hMρ0 : 0 ≤ Mρ := le_trans (abs_nonneg _) h1
        have hC0 : 0 ≤ C := le_trans (abs_nonneg _) h3
        have hab : |Real.smoothTransition (b (P.param j x) / s)| * |lap2 (P.h j) (L j) x| ≤ C := by
          calc |Real.smoothTransition (b (P.param j x) / s)| * |lap2 (P.h j) (L j) x|
              ≤ 1 * |lap2 (P.h j) (L j) x| := mul_le_mul_of_nonneg_right h2 (abs_nonneg _)
            _ ≤ C := by linarith
        have e1 : |ρ j (P.param j x)| *
            (|Real.smoothTransition (b (P.param j x) / s)| * |lap2 (P.h j) (L j) x|) ≤ Mρ * C :=
          mul_le_mul h1 hab (mul_nonneg (abs_nonneg _) (abs_nonneg _)) hMρ0
        have e2 : |ρ j (P.param j x)| *
            (|Real.smoothTransition (b (P.param j x) / s)| * |lap2 (P.h j) (L j) x|) *
            |Real.sqrt (P.h j x).det| ≤ Mρ * C * MA :=
          mul_le_mul e1 h4 (abs_nonneg _) (mul_nonneg hMρ0 hC0)
        have hFx : ‖F x‖ = |ρ j (P.param j x)| *
            (|Real.smoothTransition (b (P.param j x) / s)| * |lap2 (P.h j) (L j) x|) *
            |Real.sqrt (P.h j x).det| := by
          rw [hF, Real.norm_eq_abs, abs_mul, abs_mul, abs_mul]
        rw [hFx]
        exact le_trans e2 (le_max_right _ _)
      · exact le_trans (hM₁ x ⟨hxK, hxV⟩) (le_max_left _ _)
    
    have hKZm : MeasurableSet (Kc j \ {x | x ∈ P.W j ∧ P.param j x = p₀}) :=
      hKc.measurableSet.diff hZm
    have hKZsub : Kc j \ {x | x ∈ P.W j ∧ P.param j x = p₀} ⊆
        {x | x ∈ P.W j ∧ P.param j x ≠ p₀} := by
      rintro x ⟨hxK, hxZ⟩
      exact ⟨hKW hxK, fun h => hxZ ⟨hKW hxK, h⟩⟩
    have haesm : AEStronglyMeasurable F
        (volume.restrict (Kc j \ {x | x ∈ P.W j ∧ P.param j x = p₀})) :=
      (hcont.mono hKZsub).aestronglyMeasurable hKZm
    haveI : IsFiniteMeasure (volume.restrict (Kc j \ {x | x ∈ P.W j ∧ P.param j x = p₀})) :=
      isFiniteMeasure_restrict.mpr
        (ne_top_of_le_ne_top hKc.measure_lt_top.ne (measure_mono Set.diff_subset))
    have hint : Integrable F (volume.restrict (Kc j \ {x | x ∈ P.W j ∧ P.param j x = p₀})) := by
      refine Integrable.of_bound haesm (max M₁ (Mρ * C * MA)) ?_
      rw [ae_restrict_iff' hKZm]
      exact Filter.Eventually.of_forall (fun x hx => hbound x hx.1 hx.2)
    have hintK : IntegrableOn F (Kc j) :=
      IntegrableOn.congr_set_ae hint (diff_null_ae_eq_self hZ0).symm
    refine hintK.of_forall_diff_eq_zero (P.W_open j).measurableSet ?_
    intro x hx
    rw [hF]
    simp only [hρK j x hx.1 hx.2, zero_mul]
  
  · have hΩW : P.W j ∩ P.param j ⁻¹' (U \ {p₀}) ⊆ P.W j := Set.inter_subset_left
    have hTc : IsCompact (Kc j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Icc 0 s) := by
      refine (hK j).1.of_isClosed_subset ?_ Set.inter_subset_left
      exact ((hb j).continuousOn.mono (hK j).2).preimage_isClosed_of_isClosed
        (hK j).1.isClosed isClosed_Icc
    have hTΩ : Kc j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Icc 0 s ⊆
        P.W j ∩ P.param j ⁻¹' (U \ {p₀}) := by
      rintro x ⟨hxK, hx0, hxs⟩
      have hxW := (hK j).2 hxK
      refine ⟨hxW, hRU ⟨hparamS j x hxW, hx0⟩, ?_⟩
      intro hxp
      have hxp' : P.param j x = p₀ := hxp
      have hle : b (P.param j x) ≤ r := le_trans hxs hsr
      rw [hxp'] at hle
      linarith
    have hG : ContinuousOn (fun x => ρ j (P.param j x) *
         (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
           ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
             pd2 c (L j) x) *
         Real.sqrt (P.h j x).det) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := by
      have hρc := (hρs j j).continuousOn.mono hΩW
      have hdc : ContinuousOn (fun x => deriv Real.smoothTransition (b (P.param j x) / s))
          (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) :=
        hdηc.comp_continuousOn (((hb j).continuousOn.div_const s).mono hΩW)
      have hbd : ∀ a, ContinuousOn (pd2 a (fun y => b (P.param j y)))
          (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := fun a =>
        (hinfG _ (P.W_open j) _ (hb j) a).continuousOn.mono hΩW
      have hLd : ∀ c, ContinuousOn (pd2 c (L j)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := fun c =>
        (hinfG _ (hΩo j) _ (hLs j) c).continuousOn
      have hdA : ContinuousOn (fun x => Real.sqrt (P.h j x).det)
          (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := ((hdetS j).continuousOn.sqrt).mono hΩW
      exact (hρc.mul ((continuousOn_const.mul hdc).mul (continuousOn_finset_sum _ fun a _ =>
        continuousOn_finset_sum _ fun c _ =>
          (((hinv j a c).continuousOn.mono hΩW).mul (hbd a)).mul (hLd c)))).mul hdA
    have hGT := (hG.mono hTΩ).integrableOn_compact (μ := volume) hTc
    refine hGT.of_forall_diff_eq_zero (P.W_open j).measurableSet ?_
    rintro x ⟨hxW, hxT⟩
    by_cases hxK : x ∈ Kc j
    · have hbx : ¬ (0 ≤ b (P.param j x) ∧ b (P.param j x) ≤ s) := fun h => hxT ⟨hxK, h⟩
      have hd0 : deriv Real.smoothTransition (b (P.param j x) / s) = 0 := by
        apply hdη
        by_cases h0 : 0 ≤ b (P.param j x)
        · right
          have hlt : s < b (P.param j x) := by
            by_contra h
            exact hbx ⟨h0, not_lt.mp h⟩
          exact (one_lt_div hs).mpr hlt
        · left
          exact div_neg_of_neg_of_pos (not_le.mp h0) hs
      simp only [hd0, mul_zero, zero_mul]
    · simp only [hρK j x hxW hxK, zero_mul]

theorem pcgb_cut_bump_facts (A : Matrix (Fin 2) (Fin 2) ℝ) (hA : A.PosDef) (x₀ : E2) (r : ℝ)
    (hr : 0 < r) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ δ : ℝ, 0 < δ → δ < δ₀ →
      ContDiff ℝ ∞ (fun y : E2 => Real.smoothTransition
        ((Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c) - δ) / δ)) ∧
      (∀ y : E2, r / 8 ≤ ‖y - x₀‖ → Real.smoothTransition
        ((Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c) - δ) / δ) = 1) ∧
      (∀ᶠ y in 𝓝 x₀, Real.smoothTransition
        ((Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c) - δ) / δ) = 0) :=
by
  have hsym : ∀ a c : Fin 2, A a c = A c a := by
    intro a c
    simpa using hA.isHermitian.apply c a
  have hdet : 0 < A.det := hA.det_pos
  have h00 : 0 < A 0 0 := hA.diag_pos
  have h11 : 0 < A 1 1 := hA.diag_pos
  have htr : 0 < A 0 0 + A 1 1 := by linarith
  have hdetf : A.det = A 0 0 * A 1 1 - A 0 1 * A 0 1 := by
    rw [Matrix.det_fin_two, hsym 1 0]
  have hq : ∀ z : E2, A.det * ‖z‖ ^ 2 ≤
      (A 0 0 + A 1 1) * ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c := by
    intro z
    have hn : ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have hQ : ∑ a : Fin 2, ∑ c : Fin 2, A a c * z a * z c =
        A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2 := by
      simp only [Fin.sum_univ_two, hsym 1 0]
      ring
    have hCH : (A 0 0 + A 1 1) * (A 0 0 * z 0 ^ 2 + 2 * A 0 1 * z 0 * z 1 + A 1 1 * z 1 ^ 2) =
        (A 0 0 * z 0 + A 0 1 * z 1) ^ 2 + (A 0 1 * z 0 + A 1 1 * z 1) ^ 2 +
          (A 0 0 * A 1 1 - A 0 1 * A 0 1) * (z 0 ^ 2 + z 1 ^ 2) := by ring
    rw [hQ, hn, hdetf, hCH]
    nlinarith [sq_nonneg (A 0 0 * z 0 + A 0 1 * z 1), sq_nonneg (A 0 1 * z 0 + A 1 1 * z 1)]
  have hμpos : 0 < A.det / (A 0 0 + A 1 1) := div_pos hdet htr
  have hsμ : 0 < Real.sqrt (A.det / (A 0 0 + A 1 1)) := Real.sqrt_pos.mpr hμpos
  refine ⟨r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16, by positivity, ?_⟩
  intro δ hδ hδ₀
  obtain ⟨F, hFdef⟩ : ∃ F : E2 → ℝ, ∀ y : E2,
      F y = ∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c := ⟨_, fun y => rfl⟩
  simp only [← hFdef]
  have hFc : ContDiff ℝ ∞ F := by
    have hFe : F = fun y : E2 => ∑ a : Fin 2, ∑ c : Fin 2, A a c * (y - x₀) a * (y - x₀) c :=
      funext hFdef
    have hcoord : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := by
      intro a
      have h1 : ContDiff ℝ ∞ (fun y : E2 => EuclideanSpace.proj (𝕜 := ℝ) a (y - x₀)) :=
        (EuclideanSpace.proj (𝕜 := ℝ) a).contDiff.comp (contDiff_id.sub contDiff_const)
      exact h1
    rw [hFe]
    refine ContDiff.sum (fun a _ => ContDiff.sum (fun c _ => ?_))
    exact ((contDiff_const.mul (hcoord a)).mul (hcoord c))
  have hvan : ∀ y₁ : E2, F y₁ = 0 →
      ∀ᶠ y in 𝓝 y₁, Real.smoothTransition ((Real.sqrt (F y) - δ) / δ) = 0 := by
    intro y₁ hy₁
    have hgc : Continuous (fun y => (Real.sqrt (F y) - δ) / δ) :=
      ((hFc.continuous.sqrt).sub continuous_const).div_const δ
    have hlt : (fun y => (Real.sqrt (F y) - δ) / δ) y₁ < (fun _ : E2 => (0 : ℝ)) y₁ := by
      show (Real.sqrt (F y₁) - δ) / δ < 0
      rw [hy₁, Real.sqrt_zero]
      exact div_neg_of_neg_of_pos (by linarith) hδ
    filter_upwards [hgc.continuousAt.eventually_lt continuousAt_const hlt] with y hy
    exact Real.smoothTransition.zero_of_nonpos (le_of_lt hy)
  refine ⟨?_, ?_, ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro y₁
    by_cases h0 : F y₁ = 0
    · exact (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq (hvan y₁ h0)
    · have h1 : ContDiffAt ℝ ∞ (fun y => (Real.sqrt (F y) - δ) / δ) y₁ :=
        ((hFc.contDiffAt.sqrt h0).sub contDiffAt_const).div_const δ
      exact (Real.smoothTransition.contDiff (n := ⊤)).contDiffAt.comp y₁ h1
  · intro y hy
    apply Real.smoothTransition.one_of_one_le
    have hz := hq (y - x₀)
    rw [← hFdef] at hz
    have hn : (r / 8) ^ 2 ≤ ‖y - x₀‖ ^ 2 := pow_le_pow_left₀ (by positivity) hy 2
    have hQ1 : A.det / (A 0 0 + A 1 1) * ‖y - x₀‖ ^ 2 ≤ F y := by
      rw [div_mul_eq_mul_div, div_le_iff₀ htr]
      linarith
    have hQ : A.det / (A 0 0 + A 1 1) * (r / 8) ^ 2 ≤ F y := by
      have := mul_le_mul_of_nonneg_left hn hμpos.le
      linarith
    have hsq : (2 * (r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16)) ^ 2 =
        A.det / (A 0 0 + A 1 1) * (r / 8) ^ 2 := by
      rw [show 2 * (r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16) =
          r / 8 * Real.sqrt (A.det / (A 0 0 + A 1 1)) by ring, mul_pow,
        Real.sq_sqrt hμpos.le]
      ring
    have h2 : 2 * (r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16) ≤ Real.sqrt (F y) := by
      calc 2 * (r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16)
          = Real.sqrt ((2 * (r * Real.sqrt (A.det / (A 0 0 + A 1 1)) / 16)) ^ 2) :=
            (Real.sqrt_sq (by positivity)).symm
        _ ≤ Real.sqrt (F y) := Real.sqrt_le_sqrt (by rw [hsq]; exact hQ)
    rw [le_div_iff₀ hδ]
    linarith
  · apply hvan x₀
    rw [hFdef]
    simp

theorem pcgb_chart_pair_transport {X : Type*} [TopologicalSpace X] (S : Set X)
    (P : EigPatchedSurface X S)
    (j k : Fin P.n) (x : E2) (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) (u v u' v' : E2 → ℝ)
    (hu : u =ᶠ[𝓝 x] fun y => u' (P.proj k (P.param j y)))
    (hv : v =ᶠ[𝓝 x] fun y => v' (P.proj k (P.param j y)))
    (hu' : DifferentiableAt ℝ u' (P.proj k (P.param j x)))
    (hv' : DifferentiableAt ℝ v' (P.proj k (P.param j x))) :
    (∀ i : Fin 2, ∑ e : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 e) i *
        ∑ c : Fin 2, (P.h j x)⁻¹ e c * pd2 c v x =
      ∑ c : Fin 2, (P.h k (P.proj k (P.param j x)))⁻¹ i c * pd2 c v' (P.proj k (P.param j x))) ∧
    (∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a u x * pd2 c v x =
      ∑ a : Fin 2, ∑ c : Fin 2, (P.h k (P.proj k (P.param j x)))⁻¹ a c *
        pd2 a u' (P.proj k (P.param j x)) * pd2 c v' (P.proj k (P.param j x))) :=
by
  classical
  have hD : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
    ((P.trans_smooth j k).contDiffAt (hD.mem_nhds hx)).differentiableAt (by simp)
  have chain : ∀ (w w' : E2 → ℝ), (w =ᶠ[𝓝 x] fun y => w' (P.proj k (P.param j y))) →
      DifferentiableAt ℝ w' (P.proj k (P.param j x)) →
      ∀ b : Fin 2, pd2 b w x =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c *
          pd2 c w' (P.proj k (P.param j x)) := by
    intro w w' hw hfd b
    unfold pd2
    rw [hw.fderiv_eq, show (fun y => w' (P.proj k (P.param j y))) =
      w' ∘ (fun x' => P.proj k (P.param j x')) from rfl,
      fderiv_comp x hfd hτd, ContinuousLinearMap.comp_apply]
    have hw' : fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c • e2 c := by
      ext i
      fin_cases i <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
    conv_lhs => rw [hw']
    simp only [map_sum, map_smul, smul_eq_mul]
  set J : Matrix (Fin 2) (Fin 2) ℝ :=
    Matrix.of fun c a => fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c with hJ
  have hKJ : P.h j x = J.transpose * P.h k (P.proj k (P.param j x)) * J := by
    ext a b
    rw [P.h_compat j k x hx a b]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply, Fin.sum_univ_two]
    ring
  have hdetK : 0 < (P.h j x).det := (P.h_posDef j x hx.1).det_pos
  have hJdet : IsUnit J.det := by
    rw [isUnit_iff_ne_zero]
    intro h0
    have : (P.h j x).det = 0 := by
      rw [hKJ, Matrix.det_mul, Matrix.det_mul, h0]; simp
    linarith
  have hJTdet : IsUnit J.transpose.det := by rwa [Matrix.det_transpose]
  have hinv : J * (P.h j x)⁻¹ * J.transpose = (P.h k (P.proj k (P.param j x)))⁻¹ := by
    rw [hKJ, Matrix.mul_inv_rev, Matrix.mul_inv_rev, ← Matrix.mul_assoc J J⁻¹,
      Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul, Matrix.mul_assoc,
      Matrix.nonsing_inv_mul J.transpose hJTdet, Matrix.mul_one]
  have e : ∀ m n : Fin 2,
      fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 0) m *
          ((P.h j x)⁻¹ 0 0 * fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 0) n +
            (P.h j x)⁻¹ 0 1 * fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 1) n) +
        fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 1) m *
          ((P.h j x)⁻¹ 1 0 * fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 0) n +
            (P.h j x)⁻¹ 1 1 * fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 1) n) =
      (P.h k (P.proj k (P.param j x)))⁻¹ m n := by
    intro m n
    have h1 : (J * (P.h j x)⁻¹ * J.transpose) m n =
        (P.h k (P.proj k (P.param j x)))⁻¹ m n := by rw [hinv]
    rw [← h1]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply, Fin.sum_univ_two]
    ring
  have cu := chain u u' hu hu'
  have cv := chain v v' hv hv'
  refine ⟨fun i => ?_, ?_⟩
  · simp only [Fin.sum_univ_two]
    rw [cv 0, cv 1]
    simp only [Fin.sum_univ_two]
    linear_combination
      pd2 0 v' (P.proj k (P.param j x)) * e i 0 + pd2 1 v' (P.proj k (P.param j x)) * e i 1
  · simp only [Fin.sum_univ_two]
    rw [cu 0, cu 1, cv 0, cv 1]
    simp only [Fin.sum_univ_two]
    linear_combination
      (pd2 0 u' (P.proj k (P.param j x)) * pd2 0 v' (P.proj k (P.param j x))) * e 0 0 +
      (pd2 0 u' (P.proj k (P.param j x)) * pd2 1 v' (P.proj k (P.param j x))) * e 0 1 +
      (pd2 1 u' (P.proj k (P.param j x)) * pd2 0 v' (P.proj k (P.param j x))) * e 1 0 +
      (pd2 1 u' (P.proj k (P.param j x)) * pd2 1 v' (P.proj k (P.param j x))) * e 1 1

theorem pcgb_cut_chart_facts {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (P : EigPatchedSurface X S)
    (j₀ : Fin P.n) (x₀ : E2) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall x₀ r ⊆ P.W j₀)
    (ψ : E2 → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψ1 : ∀ y : E2, r / 8 ≤ ‖y - x₀‖ → ψ y = 1)
    (hψ0 : ∀ᶠ y in 𝓝 x₀, ψ y = 0) :
    (∀ j, ContDiffOn ℝ ∞
      (fun x => 1 - (P.O j₀).indicator (fun q => 1 - ψ (P.proj j₀ q)) (P.param j x)) (P.W j)) ∧
    (∀ j, ∀ x ∈ P.W j, (∀ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y ≠ P.param j x) →
       ∀ᶠ x' in 𝓝 x, 1 - (P.O j₀).indicator (fun q => 1 - ψ (P.proj j₀ q)) (P.param j x') = 1) ∧
    (∀ y ∈ P.W j₀, 1 - (P.O j₀).indicator (fun q => 1 - ψ (P.proj j₀ q)) (P.param j₀ y) = ψ y) ∧
    (∀ j, ∀ x ∈ P.W j, P.param j x = P.param j₀ x₀ →
       ∀ᶠ x' in 𝓝 x, 1 - (P.O j₀).indicator (fun q => 1 - ψ (P.proj j₀ q)) (P.param j x') = 0) ∧
    (∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
       P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x) :=
by
  set cut : X → ℝ := fun q => 1 - (P.O j₀).indicator (fun q => 1 - ψ (P.proj j₀ q)) q
    with hcut
  have f0 : ∀ q ∈ P.O j₀, cut q = ψ (P.proj j₀ q) := by
    intro q hq
    simp only [hcut, Set.indicator_of_mem hq]
    ring
  have f0' : ∀ q, q ∉ P.O j₀ → cut q = 1 := by
    intro q hq
    simp only [hcut, Set.indicator_of_notMem hq, sub_zero]
  have f1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro j x hx
    rw [← P.image_eq j]
    exact Set.mem_image_of_mem _ hx
  have f2 : ∀ k, ∀ q ∈ P.O k ∩ S, ∃ y ∈ P.W k, P.param k y = q ∧ P.proj k q = y := by
    intro k q hq
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, rfl⟩ := hq
    exact ⟨y, hy, rfl, P.proj_param k y hy⟩
  have hball8 : Metric.closedBall x₀ (r / 8) ⊆ P.W j₀ :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball
  have hKc : IsCompact (P.param j₀ '' Metric.closedBall x₀ (r / 8)) :=
    (isCompact_closedBall x₀ (r / 8)).image_of_continuousOn ((P.param_cont j₀).mono hball8)
  have hKcl : IsClosed (P.param j₀ '' Metric.closedBall x₀ (r / 8)) := hKc.isClosed
  have hKO : P.param j₀ '' Metric.closedBall x₀ (r / 8) ⊆ P.O j₀ := by
    rintro q ⟨y, hy, rfl⟩
    exact (f1 j₀ y (hball8 hy)).1
  have c1 : ∀ q ∈ S, q ∉ P.param j₀ '' Metric.closedBall x₀ (r / 8) → cut q = 1 := by
    intro q hqS hqK
    by_cases hqO : q ∈ P.O j₀
    · obtain ⟨y, hyW, hyq, hpy⟩ := f2 j₀ q ⟨hqO, hqS⟩
      have hyB : y ∉ Metric.closedBall x₀ (r / 8) := by
        intro hyB
        apply hqK
        rw [← hyq]
        exact Set.mem_image_of_mem _ hyB
      rw [Metric.mem_closedBall, dist_eq_norm, not_le] at hyB
      rw [f0 q hqO, hpy]
      exact hψ1 y hyB.le
    · exact f0' q hqO
  have hV1 : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ (r / 8))ᶜ) :=
    fun j => (P.param_cont j).isOpen_inter_preimage (P.W_open j) hKcl.isOpen_compl
  have hone : ∀ j, ∀ x' ∈ P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ (r / 8))ᶜ,
      cut (P.param j x') = 1 := fun j x' hx' => c1 _ (f1 j x' hx'.1).2 hx'.2
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro j
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    by_cases hxK : P.param j x ∈ P.param j₀ '' Metric.closedBall x₀ (r / 8)
    · refine ⟨P.W j ∩ P.param j ⁻¹' P.O j₀,
        (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open j₀), ⟨hx, hKO hxK⟩, ?_⟩
      have hs : ContDiffOn ℝ ∞ (fun x' => ψ (P.proj j₀ (P.param j x')))
          (P.W j ∩ P.param j ⁻¹' P.O j₀) :=
        hψ.comp_contDiffOn (P.trans_smooth j j₀)
      refine (hs.mono (fun z hz => hz.2)).congr ?_
      intro z hz
      exact f0 _ hz.2.2
    · refine ⟨P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ (r / 8))ᶜ, hV1 j,
        ⟨hx, hxK⟩, ?_⟩
      refine (contDiffOn_const (c := (1 : ℝ))).congr ?_
      intro z hz
      exact hone j z hz.2
  · intro j x hx hne
    have hxK : P.param j x ∉ P.param j₀ '' Metric.closedBall x₀ (r / 8) := by
      rintro ⟨y, hyB, hyeq⟩
      exact hne y hyB hyeq
    exact Filter.eventually_of_mem ((hV1 j).mem_nhds ⟨hx, hxK⟩) (hone j)
  · intro y hy
    exact (f0 _ (f1 j₀ y hy).1).trans (by rw [P.proj_param j₀ y hy])
  · intro j x hx hx0
    obtain ⟨Z, hZψ, hZo, hx₀Z⟩ := _root_.eventually_nhds_iff.mp hψ0
    have hx₀W : x₀ ∈ P.W j₀ := hball (Metric.mem_closedBall_self hr.le)
    have hN : IsOpen (P.O j₀ ∩ P.proj j₀ ⁻¹' Z) :=
      (P.proj_cont j₀).isOpen_inter_preimage (P.O_open j₀) hZo
    have hp₀N : P.param j₀ x₀ ∈ P.O j₀ ∩ P.proj j₀ ⁻¹' Z := by
      refine ⟨(f1 j₀ x₀ hx₀W).1, ?_⟩
      show P.proj j₀ (P.param j₀ x₀) ∈ Z
      rw [P.proj_param j₀ x₀ hx₀W]
      exact hx₀Z
    have hV : IsOpen (P.W j ∩ P.param j ⁻¹' (P.O j₀ ∩ P.proj j₀ ⁻¹' Z)) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) hN
    have hxV : x ∈ P.W j ∩ P.param j ⁻¹' (P.O j₀ ∩ P.proj j₀ ⁻¹' Z) := by
      refine ⟨hx, ?_⟩
      show P.param j x ∈ P.O j₀ ∩ P.proj j₀ ⁻¹' Z
      rw [hx0]
      exact hp₀N
    refine Filter.eventually_of_mem (hV.mem_nhds hxV) ?_
    intro z hz
    exact (f0 _ hz.2.1).trans (hZψ _ hz.2.2)
  · intro j k x hx
    obtain ⟨y, hyW, hyq, hpy⟩ := f2 k (P.param j x) ⟨hx.2, (f1 j x hx.1).2⟩
    rw [hpy]
    exact ⟨hyW, hyq⟩

theorem pcgb_cut_field_local (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a c) W) (hpd : ∀ y ∈ W, (h y).PosDef)
    (Ω : Set E2) (hΩ : IsOpen Ω) (hΩW : Ω ⊆ W) (bt χ L : E2 → ℝ) (hbt : ContDiffOn ℝ ∞ bt W)
    (hχ : ContDiffOn ℝ ∞ χ W) (hL : ContDiffOn ℝ ∞ L Ω) (s : ℝ) (hs : 0 < s)
    (htri : ∀ x ∈ W, x ∈ Ω ∨ (∀ᶠ y in 𝓝 x, bt y < 0) ∨ (∀ᶠ y in 𝓝 x, χ y = 0)) :
    (∀ e : Fin 2, ContDiffOn ℝ ∞ (fun z => χ z * (Real.smoothTransition (bt z / s) *
        ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z)) W) ∧
    (∀ x ∈ W, ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (h z).det * (χ z *
        (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) x =
      Real.sqrt (h x).det * (χ x * (Real.smoothTransition (bt x / s) * lap2 h L x) +
        χ x * (s⁻¹ * deriv Real.smoothTransition (bt x / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a bt x * pd2 c L x) +
        Real.smoothTransition (bt x / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a χ x * pd2 c L x)) ∧
    ContinuousOn (fun x => χ x * (Real.smoothTransition (bt x / s) * lap2 h L x)) W ∧
    ContinuousOn (fun x => χ x * (s⁻¹ * deriv Real.smoothTransition (bt x / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a bt x * pd2 c L x)) W ∧
    ContinuousOn (fun x => Real.smoothTransition (bt x / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a χ x * pd2 c L x) W :=
by
  
  have hsymm : ∀ z ∈ W, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have := (hpd z hz).isHermitian.apply j i
    simpa using this
  have hinvE : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    rfl
  have hadj00 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 0 = A 1 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj01 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 1 = -A 0 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj10 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 0 = -A 1 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj11 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 1 = A 0 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hdetE : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.det = A 0 0 * A 1 1 - A 0 1 * A 1 0 :=
    fun A => Matrix.det_fin_two A
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z; exact hdetE (h z)
  have hDc : ContDiffOn ℝ ∞ (fun z => (h z).det) W := by
    rw [hdetfun]; exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hDne : ∀ z ∈ W, (h z).det ≠ 0 := fun z hz => ((hpd z hz).det_pos).ne'
  have hSc : ContDiffOn ℝ ∞ (fun z => Real.sqrt (h z).det) W := hDc.sqrt hDne
  have hIc : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun z => (h z)⁻¹ i j) W := by
    intro i j
    have e : (fun z => (h z)⁻¹ i j) = fun z => ((h z).det)⁻¹ * (h z).adjugate i j :=
      funext fun z => hinvE (h z) i j
    rw [e]
    refine (hDc.inv hDne).mul ?_
    fin_cases i <;> fin_cases j
    · simp only [Fin.zero_eta, hadj00]; exact hh 1 1
    · simp only [Fin.zero_eta, Fin.mk_one, hadj01]; exact (hh 0 1).neg
    · simp only [Fin.zero_eta, Fin.mk_one, hadj10]; exact (hh 1 0).neg
    · simp only [Fin.mk_one, hadj11]; exact hh 0 0
  have hpdc : ∀ (U : Set E2), IsOpen U → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a f) U := by
    intro U hU f hf a
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) U := hf.fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  have hchr : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) W
    apply ContDiffOn.mul contDiffOn_const
    apply ContDiffOn.sum
    intro l _
    exact (hIc k l).mul (((hpdc W hW _ (hh j l) i).add (hpdc W hW _ (hh i l) j)).sub
      (hpdc W hW _ (hh i j) l))
  
  have hβc : ContDiffOn ℝ ∞ (fun z => Real.smoothTransition (bt z / s)) W :=
    Real.smoothTransition.contDiff.comp_contDiffOn (hbt.div_const s)
  have hηc : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by simp)
  have hηd : ∀ t : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition t) t :=
    fun t => ((Real.smoothTransition.contDiff (n := 1)).differentiable (by simp) t).hasDerivAt
  have hη0 : ∀ t : ℝ, t < 0 → deriv Real.smoothTransition t = 0 := by
    intro t ht
    have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (Iio_mem_nhds ht)
        (fun y hy => Real.smoothTransition.zero_of_nonpos (le_of_lt hy))
    rw [hev.deriv_eq]
    simp
  have hdβc : ContinuousOn (fun z => deriv Real.smoothTransition (bt z / s)) W :=
    hηc.comp_continuousOn (hbt.div_const s).continuousOn
  
  have hYc : ∀ e : Fin 2, ContDiffOn ℝ ∞
      (fun z => Real.sqrt (h z).det * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z) Ω := fun e =>
    (hSc.mono hΩW).mul (ContDiffOn.sum fun c _ => ((hIc e c).mono hΩW).mul (hpdc Ω hΩ L hL c))
  have hFΩ : ∀ e : Fin 2, ContDiffOn ℝ ∞ (fun z => χ z * (Real.smoothTransition (bt z / s) *
      ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z)) Ω := fun e =>
    (hχ.mono hΩW).mul ((hβc.mono hΩW).mul
      (ContDiffOn.sum fun c _ => ((hIc e c).mono hΩW).mul (hpdc Ω hΩ L hL c)))
  have hlapc : ContinuousOn (lap2 h L) Ω := by
    have H : ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
        (pd2 i (pd2 j L) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k L x)) Ω := by
      apply ContDiffOn.sum; intro i _
      apply ContDiffOn.sum; intro j _
      refine ((hIc i j).mono hΩW).mul ((hpdc Ω hΩ _ (hpdc Ω hΩ L hL j) i).sub ?_)
      apply ContDiffOn.sum; intro k _
      exact ((hchr k i j).mono hΩW).mul (hpdc Ω hΩ L hL k)
    exact H.continuousOn
  have hT1Ω : ContinuousOn (fun x => χ x * (Real.smoothTransition (bt x / s) * lap2 h L x)) Ω :=
    (hχ.mono hΩW).continuousOn.mul ((hβc.mono hΩW).continuousOn.mul hlapc)
  have hT2Ω : ContinuousOn (fun x => χ x * (s⁻¹ * deriv Real.smoothTransition (bt x / s) *
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a bt x * pd2 c L x)) Ω :=
    (hχ.mono hΩW).continuousOn.mul ((continuousOn_const.mul (hdβc.mono hΩW)).mul
      (continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun c _ =>
        (((hIc a c).mono hΩW).continuousOn.mul ((hpdc W hW bt hbt a).mono hΩW).continuousOn).mul
          (hpdc Ω hΩ L hL c).continuousOn))
  have hT3Ω : ContinuousOn (fun x => Real.smoothTransition (bt x / s) *
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a χ x * pd2 c L x) Ω :=
    (hβc.mono hΩW).continuousOn.mul
      (continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun c _ =>
        (((hIc a c).mono hΩW).continuousOn.mul ((hpdc W hW χ hχ a).mono hΩW).continuousOn).mul
          (hpdc Ω hΩ L hL c).continuousOn)
  
  have hvanish : ∀ x : E2, ((∀ᶠ y in 𝓝 x, bt y < 0) ∨ (∀ᶠ y in 𝓝 x, χ y = 0)) →
      ∃ t : Set E2, IsOpen t ∧ x ∈ t ∧ ∀ y ∈ t,
        (∀ e : Fin 2, χ y * (Real.smoothTransition (bt y / s) *
          ∑ c : Fin 2, (h y)⁻¹ e c * pd2 c L y) = 0) ∧
        χ y * (Real.smoothTransition (bt y / s) * lap2 h L y) = 0 ∧
        χ y * (s⁻¹ * deriv Real.smoothTransition (bt y / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a bt y * pd2 c L y) = 0 ∧
        Real.smoothTransition (bt y / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a χ y * pd2 c L y = 0 := by
    intro x hx
    rcases hx with hA | hB
    · obtain ⟨t, ht, hto, hxt⟩ := _root_.eventually_nhds_iff.mp hA
      refine ⟨t, hto, hxt, fun y hy => ?_⟩
      have hneg : bt y / s < 0 := div_neg_of_neg_of_pos (ht y hy) hs
      have h1 : Real.smoothTransition (bt y / s) = 0 :=
        Real.smoothTransition.zero_of_nonpos hneg.le
      have h2 : deriv Real.smoothTransition (bt y / s) = 0 := hη0 _ hneg
      simp [h1, h2]
    · obtain ⟨t, ht, hto, hxt⟩ := _root_.eventually_nhds_iff.mp hB
      refine ⟨t, hto, hxt, fun y hy => ?_⟩
      have h1 : χ y = 0 := ht y hy
      have h2 : ∀ a : Fin 2, pd2 a χ y = 0 := by
        intro a
        have hev : χ =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
          Filter.eventually_of_mem (hto.mem_nhds hy) (fun z hz => ht z hz)
        unfold pd2
        rw [hev.fderiv_eq]
        simp
      simp [h1, h2]
  
  have hdivform : ∀ x ∈ Ω,
      pd2 0 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j L z) x +
        pd2 1 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j L z) x =
      Real.sqrt (h x).det * lap2 h L x := by
    intro x hx
    have hxW : x ∈ W := hΩW hx
    have hxU : Ω ∈ 𝓝 x := hΩ.mem_nhds hx
    have hxWn : W ∈ 𝓝 x := hW.mem_nhds hxW
    have hdh : ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x := fun a b =>
      ((hh a b).contDiffAt hxWn).differentiableAt (by simp)
    have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
        pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
      intro f g k hf hg
      unfold pd2
      rw [fderiv_fun_mul hf hg]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have padd : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
        pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
      intro f g k hf hg
      unfold pd2
      rw [fderiv_fun_add hf hg]
      rfl
    have psub : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
        pd2 k (fun z => f z - g z) x = pd2 k f x - pd2 k g x := by
      intro f g k hf hg
      unfold pd2
      rw [fderiv_fun_sub hf hg]
      rfl
    have pneg : ∀ (f : E2 → ℝ) (k : Fin 2), pd2 k (fun z => -f z) x = -pd2 k f x := by
      intro f k
      unfold pd2
      rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
      rfl
    have pinv : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
        pd2 k (fun z => (f z)⁻¹) x = -pd2 k f x / (f x) ^ 2 := by
      intro f k hf hf0
      unfold pd2
      have H := (hasDerivAt_inv hf0).comp_hasFDerivAt x hf.hasFDerivAt
      rw [show (fun z => (f z)⁻¹) = (fun y : ℝ => y⁻¹) ∘ f from rfl, H.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      field_simp
    have psqrt : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
        pd2 k (fun z => Real.sqrt (f z)) x = pd2 k f x / (2 * Real.sqrt (f x)) := by
      intro f k hf hf0
      unfold pd2
      rw [fderiv_sqrt hf hf0]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hDpos : 0 < (h x).det := (hpd x hxW).det_pos
    have hD0 : (h x).det ≠ 0 := hDpos.ne'
    have hx10 : h x 1 0 = h x 0 1 := hsymm x hxW 1 0
    have hd10 : ∀ l : Fin 2, pd2 l (fun z => h z 1 0) x = pd2 l (fun z => h z 0 1) x := by
      intro l
      have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
        Filter.eventually_of_mem hxWn (fun z hz => hsymm z hz 1 0)
      unfold pd2
      rw [Filter.EventuallyEq.fderiv_eq hev]
    have hdD : DifferentiableAt ℝ (fun z => (h z).det) x := by
      rw [hdetfun]; exact ((hdh 0 0).mul (hdh 1 1)).sub ((hdh 0 1).mul (hdh 1 0))
    have hdS : DifferentiableAt ℝ (fun z => Real.sqrt (h z).det) x := hdD.sqrt hD0
    have hdw : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j L) x := fun j =>
      ((hpdc Ω hΩ L hL j).contDiffAt hxU).differentiableAt (by simp)
    have hdI : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x := fun i j =>
      ((hIc i j).contDiffAt hxWn).differentiableAt (by simp)
    have pD : ∀ k : Fin 2, pd2 k (fun z => (h z).det) x =
        pd2 k (fun z => h z 0 0) x * h x 1 1 + h x 0 0 * pd2 k (fun z => h z 1 1) x -
          (pd2 k (fun z => h z 0 1) x * h x 1 0 + h x 0 1 * pd2 k (fun z => h z 1 0) x) := by
      intro k
      rw [hdetfun, psub _ _ k ((hdh 0 0).fun_mul (hdh 1 1)) ((hdh 0 1).fun_mul (hdh 1 0)),
        pmul _ _ k (hdh 0 0) (hdh 1 1), pmul _ _ k (hdh 0 1) (hdh 1 0)]
    have pS : ∀ k : Fin 2, pd2 k (fun z => Real.sqrt (h z).det) x =
        Real.sqrt (h x).det * pd2 k (fun z => (h z).det) x / (2 * (h x).det) := by
      intro k
      rw [psqrt _ k hdD hD0]
      have hs0 : 0 < Real.sqrt (h x).det := Real.sqrt_pos.mpr hDpos
      have hss : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det :=
        Real.mul_self_sqrt hDpos.le
      generalize Real.sqrt (h x).det = sq at hs0 hss ⊢
      rw [← hss]
      field_simp
    have pI00 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 0) x =
        -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 1 1 +
          (h x).det⁻¹ * pd2 k (fun z => h z 1 1) x := by
      intro k
      simp only [hinvE, hadj00]
      rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 1), pinv _ k hdD hD0]
    have pI01 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 1) x =
        -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 0 1) +
          (h x).det⁻¹ * (-pd2 k (fun z => h z 0 1) x) := by
      intro k
      simp only [hinvE, hadj01]
      rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 1).fun_neg, pinv _ k hdD hD0, pneg]
    have pI10 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 0) x =
        -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 1 0) +
          (h x).det⁻¹ * (-pd2 k (fun z => h z 1 0) x) := by
      intro k
      simp only [hinvE, hadj10]
      rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 0).fun_neg, pinv _ k hdD hD0, pneg]
    have pI11 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 1) x =
        -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 0 0 +
          (h x).det⁻¹ * pd2 k (fun z => h z 0 0) x := by
      intro k
      simp only [hinvE, hadj11]
      rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 0), pinv _ k hdD hD0]
    simp only [Fin.sum_univ_two]
    have hdA : ∀ i : Fin 2, DifferentiableAt ℝ
        (fun z => (h z)⁻¹ i 0 * pd2 0 L z + (h z)⁻¹ i 1 * pd2 1 L z) x :=
      fun i => ((hdI i 0).fun_mul (hdw 0)).fun_add ((hdI i 1).fun_mul (hdw 1))
    rw [pmul _ _ 0 hdS (hdA 0), pmul _ _ 1 hdS (hdA 1),
      padd _ _ 0 ((hdI 0 0).fun_mul (hdw 0)) ((hdI 0 1).fun_mul (hdw 1)),
      padd _ _ 1 ((hdI 1 0).fun_mul (hdw 0)) ((hdI 1 1).fun_mul (hdw 1)),
      pmul _ _ 0 (hdI 0 0) (hdw 0), pmul _ _ 0 (hdI 0 1) (hdw 1),
      pmul _ _ 1 (hdI 1 0) (hdw 0), pmul _ _ 1 (hdI 1 1) (hdw 1),
      pS 0, pS 1, pI00 0, pI01 0, pI10 1, pI11 1, pD 0, pD 1]
    simp only [lap2, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10, hadj11]
    have hD1 : h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 ≠ 0 := by
      have e := hdetE (h x)
      rw [hx10] at e
      rw [← e]
      exact hD0
    generalize Real.sqrt (h x).det = sD
    simp only [hx10, hd10]
    field_simp
    simp only [hdetE (h x), hx10]
    ring
  
  have hidΩ : ∀ x ∈ Ω, ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (h z).det * (χ z *
        (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) x =
      Real.sqrt (h x).det * (χ x * (Real.smoothTransition (bt x / s) * lap2 h L x) +
        χ x * (s⁻¹ * deriv Real.smoothTransition (bt x / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a bt x * pd2 c L x) +
        Real.smoothTransition (bt x / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a χ x * pd2 c L x) := by
    intro x hx
    have hxW : x ∈ W := hΩW hx
    have hnW : W ∈ 𝓝 x := hW.mem_nhds hxW
    have hnΩ : Ω ∈ 𝓝 x := hΩ.mem_nhds hx
    have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
        pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
      intro f g k hf hg
      unfold pd2
      rw [fderiv_fun_mul hf hg]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hdχ : DifferentiableAt ℝ χ x := (hχ.contDiffAt hnW).differentiableAt (by simp)
    have hdbt : DifferentiableAt ℝ bt x := (hbt.contDiffAt hnW).differentiableAt (by simp)
    have hdβ : DifferentiableAt ℝ (fun z => Real.smoothTransition (bt z / s)) x :=
      (hβc.contDiffAt hnW).differentiableAt (by simp)
    have hdY : ∀ e : Fin 2, DifferentiableAt ℝ
        (fun z => Real.sqrt (h z).det * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z) x := fun e =>
      ((hYc e).contDiffAt hnΩ).differentiableAt (by simp)
    have hCR : ∀ e : Fin 2, pd2 e (fun z => Real.smoothTransition (bt z / s)) x =
        deriv Real.smoothTransition (bt x / s) * (s⁻¹ * pd2 e bt x) := by
      intro e
      have h1 : HasFDerivAt (fun z => bt z * s⁻¹) (s⁻¹ • fderiv ℝ bt x) x :=
        hdbt.hasFDerivAt.mul_const s⁻¹
      have h2 : HasDerivAt Real.smoothTransition (deriv Real.smoothTransition (bt x / s))
          (bt x * s⁻¹) := by
        rw [← div_eq_mul_inv]; exact hηd (bt x / s)
      have h3 := h2.comp_hasFDerivAt x h1
      have e1 : (fun z => Real.smoothTransition (bt z / s)) =
          Real.smoothTransition ∘ (fun z => bt z * s⁻¹) := by
        funext z; simp [div_eq_mul_inv]
      unfold pd2
      rw [e1, h3.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hre : ∀ e : Fin 2, (fun z => Real.sqrt (h z).det * (χ z *
        (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) =
        fun z => (χ z * Real.smoothTransition (bt z / s)) *
          (Real.sqrt (h z).det * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z) := by
      intro e; funext z; ring
    have hPR : ∀ e : Fin 2, pd2 e (fun z => Real.sqrt (h z).det * (χ z *
        (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) x =
        (pd2 e χ x * Real.smoothTransition (bt x / s) +
            χ x * pd2 e (fun z => Real.smoothTransition (bt z / s)) x) *
          (Real.sqrt (h x).det * ∑ c : Fin 2, (h x)⁻¹ e c * pd2 c L x) +
        (χ x * Real.smoothTransition (bt x / s)) *
          pd2 e (fun z => Real.sqrt (h z).det * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z) x := by
      intro e
      rw [hre e, pmul _ _ e (hdχ.fun_mul hdβ) (hdY e), pmul _ _ e hdχ hdβ]
    have hdiv := hdivform x hx
    rw [Fin.sum_univ_two, hPR 0, hPR 1, hCR 0, hCR 1]
    simp only [Fin.sum_univ_two] at hdiv ⊢
    linear_combination (χ x * Real.smoothTransition (bt x / s)) * hdiv
  
  refine ⟨fun e => ?_, fun x hx => ?_, ?_, ?_, ?_⟩
  · refine contDiffOn_of_locally_contDiffOn (fun x hx => ?_)
    rcases htri x hx with hxΩ | hv
    · exact ⟨Ω, hΩ, hxΩ, (hFΩ e).mono Set.inter_subset_right⟩
    · obtain ⟨t, hto, hxt, hvan⟩ := hvanish x hv
      exact ⟨t, hto, hxt, (contDiffOn_const (c := (0 : ℝ))).congr (fun y hy => (hvan y hy.2).1 e)⟩
  · rcases htri x hx with hxΩ | hv
    · exact hidΩ x hxΩ
    · obtain ⟨t, hto, hxt, hvan⟩ := hvanish x hv
      have hz : ∀ e : Fin 2, pd2 e (fun z => Real.sqrt (h z).det * (χ z *
          (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) x = 0 := by
        intro e
        have hev : (fun z => Real.sqrt (h z).det * (χ z *
            (Real.smoothTransition (bt z / s) * ∑ c : Fin 2, (h z)⁻¹ e c * pd2 c L z))) =ᶠ[𝓝 x]
            fun _ => (0 : ℝ) :=
          Filter.eventually_of_mem (hto.mem_nhds hxt)
            (fun z hz => by simp only [(hvan z hz).1 e, mul_zero])
        show fderiv ℝ _ x (e2 e) = 0
        rw [hev.fderiv_eq]
        simp
      obtain ⟨_, hT1, hT2, hT3⟩ := hvan x hxt
      rw [Finset.sum_eq_zero (fun e _ => hz e), hT1, hT2, hT3]
      ring
  · refine continuousOn_of_locally_continuousOn (fun x hx => ?_)
    rcases htri x hx with hxΩ | hv
    · exact ⟨Ω, hΩ, hxΩ, hT1Ω.mono Set.inter_subset_right⟩
    · obtain ⟨t, hto, hxt, hvan⟩ := hvanish x hv
      exact ⟨t, hto, hxt,
        (continuousOn_const (c := (0 : ℝ))).congr (fun y hy => (hvan y hy.2).2.1)⟩
  · refine continuousOn_of_locally_continuousOn (fun x hx => ?_)
    rcases htri x hx with hxΩ | hv
    · exact ⟨Ω, hΩ, hxΩ, hT2Ω.mono Set.inter_subset_right⟩
    · obtain ⟨t, hto, hxt, hvan⟩ := hvanish x hv
      exact ⟨t, hto, hxt,
        (continuousOn_const (c := (0 : ℝ))).congr (fun y hy => (hvan y hy.2).2.2.1)⟩
  · refine continuousOn_of_locally_continuousOn (fun x hx => ?_)
    rcases htri x hx with hxΩ | hv
    · exact ⟨Ω, hΩ, hxΩ, hT3Ω.mono Set.inter_subset_right⟩
    · obtain ⟨t, hto, hxt, hvan⟩ := hvanish x hv
      exact ⟨t, hto, hxt,
        (continuousOn_const (c := (0 : ℝ))).congr (fun y hy => (hvan y hy.2).2.2.2)⟩

theorem pcgb_flux_localize {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S)
    (ρ : Fin P.n → X → ℝ) (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0) (j₀ : Fin P.n)
    (F : Fin P.n → E2 → ℝ)
    (hFt : ∀ j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O j₀, F j x = F j₀ (P.proj j₀ (P.param j x)))
    (hFo : ∀ j, ∀ x ∈ P.W j, P.param j x ∉ P.O j₀ → F j x = 0)
    (hF1 : ∀ y ∈ P.W j₀, F j₀ y ≠ 0 → ∑ i, ρ i (P.param j₀ y) = 1)
    (hFi : ∀ i : Fin P.n, MeasureTheory.IntegrableOn
      (fun y => ρ i (P.param j₀ y) * F j₀ y * Real.sqrt (P.h j₀ y).det) (P.W j₀)
        MeasureTheory.volume) :
    ∑ j, ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det =
      ∫ y in P.W j₀, F j₀ y * Real.sqrt (P.h j₀ y).det :=
by
  classical
  have cov : ∀ (j k : Fin P.n) (G : E2 → ℝ),
      (∫ x in P.W j ∩ P.param j ⁻¹' P.O k, G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) =
        ∫ y in P.W k ∩ P.param k ⁻¹' P.O j, G y * Real.sqrt (P.h k y).det := by
    intro j k G
    have hF : ∀ i, ∀ x ∈ P.W i, P.param i x ∈ P.O i ∩ S := fun i x hx => by
      rw [← P.image_eq i]; exact ⟨x, hx, rfl⟩
    have hG : ∀ i, ∀ q ∈ P.O i ∩ S, P.proj i q ∈ P.W i ∧ P.param i (P.proj i q) = q := by
      intro i q hq
      rw [← P.image_eq i] at hq
      obtain ⟨y, hy, rfl⟩ := hq
      rw [P.proj_param i y hy]
      exact ⟨hy, rfl⟩
    have hAo : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
    have hAm : MeasurableSet (P.W j ∩ P.param j ⁻¹' P.O k) := hAo.measurableSet
    have hK : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, P.proj k (P.param j x) ∈ P.W k ∧
        P.param k (P.proj k (P.param j x)) = P.param j x :=
      fun x hx => hG k _ ⟨hx.2, (hF j x hx.1).2⟩
    have hinj : Set.InjOn (fun x => P.proj k (P.param j x)) (P.W j ∩ P.param j ⁻¹' P.O k) := by
      intro x hx x' hx' hxx
      have hxx' : P.proj k (P.param j x) = P.proj k (P.param j x') := hxx
      have h1 : P.param j x = P.param j x' := by
        rw [← (hK x hx).2, ← (hK x' hx').2, hxx']
      rw [← P.proj_param j x hx.1, ← P.proj_param j x' hx'.1, h1]
    have himg : (fun x => P.proj k (P.param j x)) '' (P.W j ∩ P.param j ⁻¹' P.O k) =
        P.W k ∩ P.param k ⁻¹' P.O j := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        refine ⟨(hK x hx).1, ?_⟩
        show P.param k (P.proj k (P.param j x)) ∈ P.O j
        rw [(hK x hx).2]
        exact (hF j x hx.1).1
      · rintro ⟨hy, hyO⟩
        obtain ⟨hxW, hxq⟩ := hG j (P.param k y) ⟨hyO, (hF k y hy).2⟩
        refine ⟨P.proj j (P.param k y), ⟨hxW, ?_⟩, ?_⟩
        · show P.param j (P.proj j (P.param k y)) ∈ P.O k
          rw [hxq]
          exact (hF k y hy).1
        · show P.proj k (P.param j (P.proj j (P.param k y))) = y
          rw [hxq, P.proj_param k y hy]
    have hdiff : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        HasFDerivWithinAt (fun x => P.proj k (P.param j x))
          (fderiv ℝ (fun x => P.proj k (P.param j x)) x) (P.W j ∩ P.param j ⁻¹' P.O k) x := by
      intro x hx
      have hd : DifferentiableOn ℝ (fun x => P.proj k (P.param j x))
          (P.W j ∩ P.param j ⁻¹' P.O k) :=
        (P.trans_smooth j k).differentiableOn (by simp)
      exact ((hd x hx).differentiableAt (hAo.mem_nhds hx)).hasFDerivAt.hasFDerivWithinAt
    have hjac : ∀ (f : E2 →L[ℝ] E2) (H H' : Matrix (Fin 2) (Fin 2) ℝ),
        (∀ a b : Fin 2, H' a b = ∑ c : Fin 2, ∑ d : Fin 2, f (e2 a) c * H c d * f (e2 b) d) →
        Real.sqrt H'.det = |f.det| * Real.sqrt H.det := by
      intro f H H' hc
      have hdet : f.det = f (e2 0) 0 * f (e2 1) 1 - f (e2 1) 0 * f (e2 0) 1 := by
        change LinearMap.det (f : E2 →ₗ[ℝ] E2) = _
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis,
          Matrix.det_fin_two]
        simp [LinearMap.toMatrix_apply, EuclideanSpace.basisFun_apply, e2]
      have hH' : H'.det = f.det ^ 2 * H.det := by
        rw [Matrix.det_fin_two, Matrix.det_fin_two, hc 0 0, hc 0 1, hc 1 0, hc 1 1, hdet]
        simp only [Fin.sum_univ_two]
        ring
      rw [hH', Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    have hpt : Set.EqOn (fun x => G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det)
        (fun x => |(fderiv ℝ (fun x => P.proj k (P.param j x)) x).det| •
          (fun y => G y * Real.sqrt (P.h k y).det) (P.proj k (P.param j x)))
        (P.W j ∩ P.param j ⁻¹' P.O k) := by
      intro x hx
      simp only [smul_eq_mul]
      rw [hjac _ _ _ (P.h_compat j k x hx)]
      ring
    have h1 := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hAm hdiff hinj
      (fun y => G y * Real.sqrt (P.h k y).det)
    rw [himg] at h1
    exact (MeasureTheory.setIntegral_congr_fun hAm hpt).trans h1.symm
  have key : ∀ j, (∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
      ∫ y in P.W j₀, ρ j (P.param j₀ y) * F j₀ y * Real.sqrt (P.h j₀ y).det := by
    intro j
    have hWm : MeasurableSet (P.W j) := (P.W_open j).measurableSet
    have hNo : IsOpen (P.W j ∩ P.param j ⁻¹' P.O j₀) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open j₀)
    have h1 : (∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
        ∫ x in P.W j ∩ P.param j ⁻¹' P.O j₀,
          ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := by
      refine MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hWm
        Set.inter_subset_left ?_
      intro x hx
      have hxO : P.param j x ∉ P.O j₀ := fun h => hx.2 ⟨hx.1, h⟩
      rw [hFo j x hx.1 hxO]
      ring
    have h2 : (∫ x in P.W j ∩ P.param j ⁻¹' P.O j₀,
          ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
        ∫ x in P.W j ∩ P.param j ⁻¹' P.O j₀,
          (fun y => ρ j (P.param j₀ y) * F j₀ y) (P.proj j₀ (P.param j x)) *
            Real.sqrt (P.h j x).det := by
      refine MeasureTheory.setIntegral_congr_fun hNo.measurableSet ?_
      intro x hx
      have hS : P.param j x ∈ P.O j₀ ∩ S := by
        refine ⟨hx.2, ?_⟩
        have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx.1, rfl⟩
        rw [P.image_eq j] at hmem
        exact hmem.2
      rw [← P.image_eq j₀] at hS
      obtain ⟨y, hy, hyx⟩ := hS
      have hpar : P.param j₀ (P.proj j₀ (P.param j x)) = P.param j x := by
        rw [← hyx, P.proj_param j₀ y hy]
      show ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det =
        ρ j (P.param j₀ (P.proj j₀ (P.param j x))) * F j₀ (P.proj j₀ (P.param j x)) *
          Real.sqrt (P.h j x).det
      rw [hFt j x hx, hpar]
    have h3 := cov j j₀ (fun y => ρ j (P.param j₀ y) * F j₀ y)
    have h4 : (∫ y in P.W j₀ ∩ P.param j₀ ⁻¹' P.O j,
          (fun y => ρ j (P.param j₀ y) * F j₀ y) y * Real.sqrt (P.h j₀ y).det) =
        ∫ y in P.W j₀, ρ j (P.param j₀ y) * F j₀ y * Real.sqrt (P.h j₀ y).det := by
      refine (MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
        (P.W_open j₀).measurableSet Set.inter_subset_left ?_).symm
      intro y hy
      have hyO : P.param j₀ y ∉ P.O j := fun h => hy.2 ⟨hy.1, h⟩
      show ρ j (P.param j₀ y) * F j₀ y * Real.sqrt (P.h j₀ y).det = 0
      rw [hρO j _ hyO]
      ring
    exact h1.trans (h2.trans (h3.trans h4))
  rw [Finset.sum_congr rfl (fun j _ => key j)]
  rw [← MeasureTheory.integral_finset_sum _ (fun i _ => hFi i)]
  refine MeasureTheory.setIntegral_congr_fun (P.W_open j₀).measurableSet ?_
  intro y hy
  show ∑ j, ρ j (P.param j₀ y) * F j₀ y * Real.sqrt (P.h j₀ y).det =
    F j₀ y * Real.sqrt (P.h j₀ y).det
  rw [← Finset.sum_mul, ← Finset.sum_mul]
  by_cases h : F j₀ y = 0
  · rw [h]
    ring
  · rw [hF1 y hy h, one_mul]

theorem pcgb_patched_ibp_sum {X : Type*} [TopologicalSpace X] (S : Set X)
    (P : EigPatchedSurface X S)
    (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (Wv : Fin P.n → E2 → Fin 2 → ℝ)
    (hWs : ∀ j (e : Fin 2), ContDiffOn ℝ ∞ (fun x => Wv j x e) (P.W j))
    (hsum : ∑ j, ∑ e : Fin 2, ∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
       (Real.sqrt (P.h j x).det * Wv j x e) = 0) :
    ∑ j, ∫ x in P.W j, ρ j (P.param j x) *
      ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x = 0 :=
by
  classical
  
  have ibp : ∀ (W : Set E2), IsOpen W → ∀ (u : E2 → ℝ), ContDiffOn ℝ ∞ u W →
      ∀ (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W → ∀ k : Fin 2,
      ∫ x, u x * pd2 k ζ x = -(∫ x, pd2 k u x * ζ x) := by
    intro W hW u hu ζ hζ hζc hζW k
    have hvan : ∀ x, x ∉ W → (ζ =ᶠ[𝓝 x] 0) := by
      intro x hx
      exact notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (hζW h))
    have hζ0 : ∀ x, x ∉ W → ζ x = 0 := by
      intro x hx
      exact image_eq_zero_of_notMem_tsupport (fun h => hx (hζW h))
    have hdζ0 : ∀ x, x ∉ W → pd2 k ζ x = 0 := by
      intro x hx
      have h1 : fderiv ℝ ζ x = fderiv ℝ (fun _ => (0:ℝ)) x :=
        Filter.EventuallyEq.fderiv_eq (hvan x hx)
      simp only [pd2, h1, fderiv_const_apply, ContinuousLinearMap.zero_apply]
    have hFder : ∀ x, HasFDerivAt (fun y => u y * ζ y)
        (fderiv ℝ (fun y => u y * ζ y) x) x ∧
        fderiv ℝ (fun y => u y * ζ y) x (e2 k) = pd2 k u x * ζ x + u x * pd2 k ζ x := by
      intro x
      by_cases hx : x ∈ W
      · have hu' : HasFDerivAt u (fderiv ℝ u x) x :=
          ((hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)).hasFDerivAt
        have hζ' : HasFDerivAt ζ (fderiv ℝ ζ x) x :=
          (hζ.differentiable (by simp) x).hasFDerivAt
        have hm : HasFDerivAt (fun y => u y * ζ y) (u x • fderiv ℝ ζ x + ζ x • fderiv ℝ u x) x :=
          hu'.mul hζ'
        refine ⟨hm.differentiableAt.hasFDerivAt, ?_⟩
        rw [hm.fderiv]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, pd2]
        ring
      · have hF0 : (fun y => u y * ζ y) =ᶠ[𝓝 x] (fun _ => (0:ℝ)) := by
          filter_upwards [hvan x hx] with y hy
          simp only [Pi.zero_apply] at hy
          simp [hy]
        have hd : HasFDerivAt (fun y => u y * ζ y) (0 : E2 →L[ℝ] ℝ) x :=
          (hasFDerivAt_const (0:ℝ) x).congr_of_eventuallyEq hF0
        refine ⟨hd.differentiableAt.hasFDerivAt, ?_⟩
        rw [hd.fderiv, hζ0 x hx, hdζ0 x hx]
        simp
    have hFd : Differentiable ℝ (fun y => u y * ζ y) :=
      fun x => (hFder x).1.differentiableAt
    have hprod : (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) =
        fun x => pd2 k u x * ζ x + u x * pd2 k ζ x := funext fun x => (hFder x).2
    have helper : ∀ (a φ : E2 → ℝ), ContinuousOn a W → Continuous φ → tsupport φ ⊆ W →
        HasCompactSupport φ → Integrable (fun x => a x * φ x) := by
      intro a φ ha hφ hφW hφc
      have hcont : Continuous (fun x => a x * φ x) := by
        refine continuous_iff_continuousAt.mpr fun x => ?_
        by_cases hx : x ∈ W
        · exact (ha.continuousAt (hW.mem_nhds hx)).mul hφ.continuousAt
        · have h0 : φ =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (hφW h))
          have h1 : (fun _ => (0:ℝ)) =ᶠ[𝓝 x] (fun y => a y * φ y) := by
            filter_upwards [h0] with y hy
            simp only [Pi.zero_apply] at hy
            simp [hy]
          exact continuousAt_const.congr h1
      exact hcont.integrable_of_hasCompactSupport (hφc.mul_left)
    have hdu : ContinuousOn (pd2 k u) W :=
      (hu.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
    have hdζc : Continuous (pd2 k ζ) :=
      (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdζs : tsupport (pd2 k ζ) ⊆ tsupport ζ := by
      refine closure_minimal (fun x hx => ?_) (isClosed_tsupport ζ)
      refine support_fderiv_subset ℝ ?_
      rw [Function.mem_support] at hx ⊢
      intro h0
      apply hx
      simp [pd2, h0]
    have hg₁ : Integrable (fun x => pd2 k u x * ζ x) :=
      helper _ _ hdu hζ.continuous hζW hζc
    have hg₂ : Integrable (fun x => u x * pd2 k ζ x) :=
      helper _ _ hu.continuousOn hdζc (hdζs.trans hζW) (hζc.fderiv_apply (𝕜 := ℝ) (e2 k))
    have hF : Integrable (fun x => u x * ζ x) :=
      helper _ _ hu.continuousOn hζ.continuous hζW hζc
    have hF' : Integrable (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) := by
      rw [hprod]; exact hg₁.add hg₂
    have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun y => u y * ζ y) (g := fun _ => (1:ℝ)) (v := e2 k)
      (by simpa using hF') (by simp) (by simpa using hF) hFd (differentiable_const 1)
    have hzero : ∫ x, fderiv ℝ (fun y => u y * ζ y) x (e2 k) = 0 := by
      simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, mul_zero, integral_zero,
        mul_one] at h
      linarith
    rw [hprod, integral_add hg₁ hg₂] at hzero
    linarith
  
  have chart : ∀ j (e : Fin 2),
      (∫ x in P.W j, ρ j (P.param j x) * pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x) =
        -(∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
          (Real.sqrt (P.h j x).det * Wv j x e)) ∧
      MeasureTheory.IntegrableOn
        (fun x => ρ j (P.param j x) * pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x)
        (P.W j) := by
    intro j e
    have hW : IsOpen (P.W j) := P.W_open j
    have hmeas : MeasurableSet (P.W j) := hW.measurableSet
    have hρ' : ContDiffOn ℝ ∞ (fun x => ρ j (P.param j x)) (P.W j) := hρs j j
    have hdet : ContDiffOn ℝ ∞ (fun z => (P.h j z).det) (P.W j) := by
      have hfun : (fun z => (P.h j z).det) =
          fun z => P.h j z 0 0 * P.h j z 1 1 - P.h j z 0 1 * P.h j z 1 0 := by
        funext z; exact Matrix.det_fin_two _
      rw [hfun]
      exact ((P.h_smooth j 0 0).mul (P.h_smooth j 1 1)).sub
        ((P.h_smooth j 0 1).mul (P.h_smooth j 1 0))
    have hD : ContDiffOn ℝ ∞ (fun z => Real.sqrt (P.h j z).det) (P.W j) :=
      hdet.sqrt (fun x hx => (Matrix.PosDef.det_pos (P.h_posDef j x hx)).ne')
    have hu : ContDiffOn ℝ ∞ (fun z => Real.sqrt (P.h j z).det * Wv j z e) (P.W j) :=
      hD.mul (hWs j e)
    obtain ⟨hKc, hKW⟩ := hK j
    have hKcl : IsClosed (Kc j) := hKc.isClosed
    obtain ⟨ζ, hζdef⟩ : ∃ ζ : E2 → ℝ, ζ = (P.W j).indicator (fun x => ρ j (P.param j x)) :=
      ⟨_, rfl⟩
    have hz0 : ∀ y, y ∉ Kc j → ζ y = 0 := by
      intro y hy
      by_cases hyW : y ∈ P.W j
      · rw [hζdef, Set.indicator_of_mem hyW]; exact hρK j y hyW hy
      · rw [hζdef, Set.indicator_of_notMem hyW]
    have hzev : ∀ y, y ∉ Kc j → ζ =ᶠ[𝓝 y] fun _ => (0:ℝ) :=
      fun y hy => Filter.eventually_of_mem (hKcl.isOpen_compl.mem_nhds hy) (fun z hz => hz0 z hz)
    have hζW : ∀ x ∈ P.W j, ζ x = ρ j (P.param j x) := fun x hx => by
      rw [hζdef, Set.indicator_of_mem hx]
    have hζnW : ∀ x, x ∉ P.W j → ζ x = 0 := fun x hx => by
      rw [hζdef, Set.indicator_of_notMem hx]
    have hWev : ∀ x ∈ P.W j, ζ =ᶠ[𝓝 x] (fun x => ρ j (P.param j x)) :=
      fun x hx => Filter.eventually_of_mem (hW.mem_nhds hx) (fun z hz => hζW z hz)
    have hζs : ContDiff ℝ ∞ ζ := by
      rw [contDiff_iff_contDiffAt]
      intro x
      by_cases hx : x ∈ P.W j
      · exact (hρ'.contDiffAt (hW.mem_nhds hx)).congr_of_eventuallyEq (hWev x hx)
      · exact contDiffAt_const.congr_of_eventuallyEq (hzev x (fun h => hx (hKW h)))
    have hsupp : Function.support ζ ⊆ Kc j := fun y hy => by
      by_contra h; exact hy (hz0 y h)
    have hts : tsupport ζ ⊆ Kc j := closure_minimal hsupp hKcl
    have hζc : HasCompactSupport ζ := HasCompactSupport.intro hKc hz0
    have hI := ibp (P.W j) hW _ hu ζ hζs hζc (hts.trans hKW) e
    have hpdW : ∀ x ∈ P.W j, pd2 e ζ x = pd2 e (fun x' => ρ j (P.param j x')) x := fun x hx => by
      unfold pd2; rw [(hWev x hx).fderiv_eq]
    have hpd0 : ∀ x, x ∉ P.W j → pd2 e ζ x = 0 := fun x hx => by
      unfold pd2; rw [(hzev x (fun h => hx (hKW h))).fderiv_eq]; simp
    have h2 : (∫ x in P.W j, ρ j (P.param j x) *
          pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x) =
        ∫ x, pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x * ζ x := by
      rw [MeasureTheory.setIntegral_congr_fun hmeas
        (g := fun x => pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x * ζ x)
        (fun x hx => by simp only [hζW x hx]; ring)]
      exact MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by
        simp [hζnW x hx])
    have h3 : (∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
          (Real.sqrt (P.h j x).det * Wv j x e)) =
        ∫ x, (Real.sqrt (P.h j x).det * Wv j x e) * pd2 e ζ x := by
      rw [MeasureTheory.setIntegral_congr_fun hmeas
        (g := fun x => (Real.sqrt (P.h j x).det * Wv j x e) * pd2 e ζ x)
        (fun x hx => by simp only [hpdW x hx]; ring)]
      exact MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero (fun x hx => by
        simp [hpd0 x hx])
    refine ⟨?_, ?_⟩
    · rw [h2, h3]
      have hI' : (∫ x, (Real.sqrt (P.h j x).det * Wv j x e) * pd2 e ζ x) =
          -(∫ x, pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x * ζ x) := hI
      rw [hI', neg_neg]
    · have hcont : ContinuousOn
          (fun x => ρ j (P.param j x) * pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x)
          (P.W j) :=
        hρ'.continuousOn.mul
          ((hu.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const)
      exact ((hcont.mono hKW).integrableOn_compact hKc).of_forall_diff_eq_zero hmeas
        (fun x hx => by simp only [hρK j x hx.1 hx.2, zero_mul])
  
  have hj : ∀ j, (∫ x in P.W j, ρ j (P.param j x) *
      ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (P.h j z).det * Wv j z e) x) =
      -(∑ e : Fin 2, ∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
        (Real.sqrt (P.h j x).det * Wv j x e)) := by
    intro j
    simp only [Finset.mul_sum]
    rw [MeasureTheory.integral_finset_sum _ (fun e _ => (chart j e).2)]
    rw [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun e _ => (chart j e).1)
  
  rw [Finset.sum_congr rfl (fun j _ => hj j), Finset.sum_neg_distrib, hsum, neg_zero]

theorem pcgb_pd_cutoff_identity {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (j₀ : Fin P.n) (x₀ : E2) (p₀ : X) (r : ℝ) (hr : 0 < r) (hp₀ : P.param j₀ x₀ = p₀)
    (hball : Metric.closedBall x₀ r ⊆ P.W j₀)
    (hbpos : ∀ x ∈ Metric.closedBall x₀ r, 2 * r ≤ b (P.param j₀ x))
    (U : Set X) (hU : IsOpen U) (hRU : {q | q ∈ S ∧ 0 ≤ b q} ⊆ U)
    (L : Fin P.n → E2 → ℝ)
    (hLs : ∀ j, ContDiffOn ℝ ∞ (L j) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})))
    (hLc : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' (P.O k ∩ (U \ {p₀})),
      L j x = L k (P.proj k (P.param j x)))
    (hdiv : ∀ (Aset : Fin P.n → Set E2), (∀ j, IsOpen (Aset j)) → (∀ j, Aset j ⊆ P.W j) →
      (∀ j, ∀ y ∈ Aset j, ∑ i, ρ i (P.param j y) = 1) →
      ∀ (Wv : Fin P.n → E2 → Fin 2 → ℝ),
      (∀ j (e : Fin 2), ContinuousOn (fun x => Wv j x e) (P.W j)) →
      (∀ j, ∀ x ∈ P.W j, x ∉ Aset j → ∀ e : Fin 2, Wv j x e = 0) →
      (∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, ∀ i : Fin 2,
        ∑ e : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 e) i * Wv j x e =
          Wv k (P.proj k (P.param j x)) i) →
      ∑ j, ∑ e : Fin 2, ∫ x in P.W j, pd2 e (fun x' => ρ j (P.param j x')) x *
        (Real.sqrt (P.h j x).det * Wv j x e) = 0) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ δ : ℝ, 0 < δ → δ < δ₀ → ∀ s : ℝ, 0 < s → s ≤ r →
      (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         ((1 - (P.O j₀).indicator (fun q => 1 - Real.smoothTransition
             ((pcgbPoleRad P j₀ x₀ (P.proj j₀ q) - δ) / δ)) (P.param j x)) *
           (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x)) *
         Real.sqrt (P.h j x).det) (P.W j)) ∧
      eigWInt P ρ (fun j x => (1 - (P.O j₀).indicator (fun q => 1 - Real.smoothTransition
             ((pcgbPoleRad P j₀ x₀ (P.proj j₀ q) - δ) / δ)) (P.param j x)) *
           (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x)) +
        eigWInt P ρ (fun j x => s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
           ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
             pd2 c (L j) x) +
        (∫ x in P.W j₀, (∑ a : Fin 2, ∑ c : Fin 2, (P.h j₀ x)⁻¹ a c *
           pd2 a (fun y => Real.smoothTransition ((pcgbPoleRad P j₀ x₀ y - δ) / δ)) x *
             pd2 c (L j₀) x) *
           Real.sqrt (P.h j₀ x).det) = 0 :=
by
  classical
  have hx₀W : x₀ ∈ P.W j₀ := hball (Metric.mem_closedBall_self hr.le)
  obtain ⟨δ₀, hδ₀, hbump⟩ := pcgb_cut_bump_facts (P.h j₀ x₀) (P.h_posDef j₀ x₀ hx₀W) x₀ r hr
  refine ⟨δ₀, hδ₀, fun δ hδ hδ' s hs hsr => ?_⟩
  obtain ⟨hψs, hψ1, hψ0⟩ := hbump δ hδ hδ'
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : E2 → ℝ,
      ψ = fun y => Real.smoothTransition ((pcgbPoleRad P j₀ x₀ y - δ) / δ) := ⟨_, rfl⟩
  have hψs' : ContDiff ℝ ∞ ψ := by rw [hψdef]; exact hψs
  have hψ1' : ∀ y : E2, r / 8 ≤ ‖y - x₀‖ → ψ y = 1 := by rw [hψdef]; exact hψ1
  have hψ0' : ∀ᶠ y in 𝓝 x₀, ψ y = 0 := by rw [hψdef]; exact hψ0
  obtain ⟨cut, hcut⟩ : ∃ cut : X → ℝ,
      cut = fun q => 1 - (P.O j₀).indicator (fun q' => 1 - ψ (P.proj j₀ q')) q := ⟨_, rfl⟩
  suffices H : (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         (cut (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x)) *
         Real.sqrt (P.h j x).det) (P.W j)) ∧
      eigWInt P ρ (fun j x => cut (P.param j x) *
          (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x)) +
        eigWInt P ρ (fun j x => s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
           ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
             pd2 c (L j) x) +
        (∫ x in P.W j₀, (∑ a : Fin 2, ∑ c : Fin 2, (P.h j₀ x)⁻¹ a c * pd2 a ψ x *
             pd2 c (L j₀) x) * Real.sqrt (P.h j₀ x).det) = 0 by
    subst hcut; subst hψdef; exact H
  
  obtain ⟨c2a, c2b, c2c, c2d, c2e⟩ :=
    pcgb_cut_chart_facts S P j₀ x₀ r hr hball ψ hψs' hψ1' hψ0'
  have hχs : ∀ j, ContDiffOn ℝ ∞ (fun x => cut (P.param j x)) (P.W j) := by
    rw [hcut]; exact c2a
  have hχ1 : ∀ j, ∀ x ∈ P.W j, (∀ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y ≠ P.param j x) →
      ∀ᶠ x' in 𝓝 x, cut (P.param j x') = 1 := by
    rw [hcut]; exact c2b
  have hχψ : ∀ y ∈ P.W j₀, cut (P.param j₀ y) = ψ y := by
    rw [hcut]; exact c2c
  have hχ0 : ∀ j, ∀ x ∈ P.W j, P.param j x = p₀ → ∀ᶠ x' in 𝓝 x, cut (P.param j x') = 0 := by
    rw [hcut, ← hp₀]; exact c2d
  
  have hball8 : Metric.closedBall x₀ (r / 8) ⊆ P.W j₀ :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball
  have hSO : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro j x hx
    rw [← P.image_eq j]
    exact Set.mem_image_of_mem _ hx
  have hPU : ∀ j, ∀ x ∈ P.W j, P.param j x ∉ U → b (P.param j x) < 0 := by
    intro j x hx hqU
    by_contra h
    push_neg at h
    exact hqU (hRU ⟨(hSO j x hx).2, h⟩)
  have hpd0 : ∀ (f : E2 → ℝ) (x : E2) (c : ℝ), (∀ᶠ x' in 𝓝 x, f x' = c) →
      ∀ a : Fin 2, pd2 a f x = 0 := by
    intro f x c hev a
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq (f := fun _ => c) hev]
    simp
  have hder1 : ∀ t : ℝ, 1 < t → deriv Real.smoothTransition t = 0 := by
    intro t ht
    have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (1 : ℝ) := by
      filter_upwards [Ioi_mem_nhds ht] with u hu
      exact Real.smoothTransition.one_of_one_le (le_of_lt hu)
    rw [hev.deriv_eq]
    exact deriv_const t 1
  have hdich : ∀ j, ∀ x ∈ P.W j, (cut (P.param j x) = 1 ∧
      ∀ a, pd2 a (fun y => cut (P.param j y)) x = 0) ∨
      ∃ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y = P.param j x := by
    intro j x hx
    by_cases h : ∃ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y = P.param j x
    · exact Or.inr h
    · left
      push_neg at h
      have hev := hχ1 j x hx h
      exact ⟨hev.self_of_nhds, fun a => hpd0 _ x 1 hev a⟩
  have hbig : ∀ j, ∀ x ∈ P.W j,
      (∃ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y = P.param j x) →
      Real.smoothTransition (b (P.param j x) / s) = 1 ∧
        deriv Real.smoothTransition (b (P.param j x) / s) = 0 ∧ 2 * r ≤ b (P.param j x) := by
    rintro j x hx ⟨y, hy, hyx⟩
    have h1 : 2 * r ≤ b (P.param j x) := by
      rw [← hyx]
      exact hbpos y (Metric.closedBall_subset_closedBall (by linarith) hy)
    have h2 : 2 ≤ b (P.param j x) / s := by
      rw [le_div_iff₀ hs]; linarith
    exact ⟨Real.smoothTransition.one_of_one_le (by linarith), hder1 _ (by linarith), h1⟩
  have hΩo : ∀ k, IsOpen (P.W k ∩ P.param k ⁻¹' (U \ {p₀})) := fun k =>
    (P.param_cont k).isOpen_inter_preimage (P.W_open k) (hU.sdiff isClosed_singleton)
  have hNo : ∀ j k, IsOpen (P.W j ∩ P.param j ⁻¹' (P.O k ∩ (U \ {p₀}))) := fun j k =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j)
      ((P.O_open k).inter (hU.sdiff isClosed_singleton))
  have hLtr : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, P.param j x ∈ U → P.param j x ≠ p₀ →
      (L j =ᶠ[𝓝 x] fun y => L k (P.proj k (P.param j y))) ∧
        DifferentiableAt ℝ (L k) (P.proj k (P.param j x)) := by
    intro j k x hx hqU hq0
    obtain ⟨hyW, hpar⟩ := c2e j k x hx
    have hxN : x ∈ P.W j ∩ P.param j ⁻¹' (P.O k ∩ (U \ {p₀})) := ⟨hx.1, hx.2, hqU, hq0⟩
    refine ⟨Filter.eventually_of_mem ((hNo j k).mem_nhds hxN) (fun z hz => hLc j k z hz), ?_⟩
    have hyΩ : P.proj k (P.param j x) ∈ P.W k ∩ P.param k ⁻¹' (U \ {p₀}) := by
      refine ⟨hyW, ?_⟩
      show P.param k (P.proj k (P.param j x)) ∈ U \ {p₀}
      rw [hpar]
      exact ⟨hqU, hq0⟩
    exact ((hLs k).contDiffAt ((hΩo k).mem_nhds hyΩ)).differentiableAt (by simp)
  have hdetc : ∀ j, ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) := by
    intro j
    have h : ∀ a c : Fin 2, ContinuousOn (fun x => P.h j x a c) (P.W j) :=
      fun a c => (P.h_smooth j a c).continuousOn
    have hd : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
      simp only [Matrix.det_fin_two]
      exact ((h 0 0).mul (h 1 1)).sub ((h 0 1).mul (h 1 0))
    exact hd.sqrt
  have hintK : ∀ j (f : E2 → ℝ) (K : Set E2), IsCompact K → K ⊆ P.W j →
      ContinuousOn f (P.W j) → (∀ x ∈ P.W j, x ∉ K → f x = 0) →
      MeasureTheory.IntegrableOn f (P.W j) := by
    intro j f K hKc hKW hf hz
    exact ((hf.mono hKW).integrableOn_compact hKc).of_forall_diff_eq_zero
      (P.W_open j).measurableSet (fun x hx => hz x hx.1 hx.2)
  have hIT : ∀ j (f : E2 → ℝ), ContinuousOn f (P.W j) →
      MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) * f x * Real.sqrt (P.h j x).det)
        (P.W j) := by
    intro j f hf
    refine hintK j _ (Kc j) (hK j).1 (hK j).2 (((hρs j j).continuousOn.mul hf).mul (hdetc j)) ?_
    intro x hx hxK
    simp only [hρK j x hx hxK, zero_mul]
  
  have htri : ∀ j, ∀ x ∈ P.W j, x ∈ P.W j ∩ P.param j ⁻¹' (U \ {p₀}) ∨
      (∀ᶠ y in 𝓝 x, b (P.param j y) < 0) ∨ (∀ᶠ y in 𝓝 x, cut (P.param j y) = 0) := by
    intro j x hx
    by_cases hq0 : P.param j x = p₀
    · exact Or.inr (Or.inr (hχ0 j x hx hq0))
    by_cases hqU : P.param j x ∈ U
    · exact Or.inl ⟨hx, hqU, hq0⟩
    · refine Or.inr (Or.inl ?_)
      have hcont : ContinuousAt (fun y => b (P.param j y)) x :=
        (hb j).continuousOn.continuousAt ((P.W_open j).mem_nhds hx)
      exact Filter.Tendsto.eventually_lt_const (hPU j x hx hqU) hcont
  have hc3 := fun j => pcgb_cut_field_local (P.W j) (P.W_open j) (P.h j) (P.h_smooth j)
    (P.h_posDef j) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) (hΩo j) Set.inter_subset_left
    (fun y => b (P.param j y)) (fun y => cut (P.param j y)) (L j) (hb j) (hχs j) (hLs j) s hs
    (htri j)
  obtain ⟨V, hV⟩ : ∃ V : Fin P.n → E2 → Fin 2 → ℝ, V = fun j z e =>
      cut (P.param j z) * (Real.smoothTransition (b (P.param j z) / s) *
        ∑ c : Fin 2, (P.h j z)⁻¹ e c * pd2 c (L j) z) := ⟨_, rfl⟩
  obtain ⟨T1, hT1⟩ : ∃ T1 : Fin P.n → E2 → ℝ, T1 = fun j x => cut (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) := ⟨_, rfl⟩
  obtain ⟨T2, hT2⟩ : ∃ T2 : Fin P.n → E2 → ℝ, T2 = fun j x => cut (P.param j x) *
      (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
          pd2 c (L j) x) := ⟨_, rfl⟩
  obtain ⟨T3, hT3⟩ : ∃ T3 : Fin P.n → E2 → ℝ, T3 = fun j x =>
      Real.smoothTransition (b (P.param j x) / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => cut (P.param j y)) x *
          pd2 c (L j) x := ⟨_, rfl⟩
  have hVs : ∀ j (e : Fin 2), ContDiffOn ℝ ∞ (fun x => V j x e) (P.W j) := by
    intro j e; rw [hV]; exact (hc3 j).1 e
  have hid : ∀ j, ∀ x ∈ P.W j, ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (P.h j z).det * V j z e) x =
      Real.sqrt (P.h j x).det * (T1 j x + T2 j x + T3 j x) := by
    intro j x hx; rw [hV, hT1, hT2, hT3]; exact (hc3 j).2.1 x hx
  have hT1c : ∀ j, ContinuousOn (T1 j) (P.W j) := by
    intro j; rw [hT1]; exact (hc3 j).2.2.1
  have hT2c : ∀ j, ContinuousOn (T2 j) (P.W j) := by
    intro j; rw [hT2]; exact (hc3 j).2.2.2.1
  have hT3c : ∀ j, ContinuousOn (T3 j) (P.W j) := by
    intro j; rw [hT3]; exact (hc3 j).2.2.2.2
  have hT3z : ∀ j x, (∀ a, pd2 a (fun y => cut (P.param j y)) x = 0) → T3 j x = 0 := by
    intro j x h0; rw [hT3]; beta_reduce
    simp only [h0, mul_zero, zero_mul, Finset.sum_const_zero]
  
  have hAo : ∀ j, IsOpen (P.W j ∩ {y | 0 < b (P.param j y)}) := fun j =>
    (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi
  have hAW : ∀ j, P.W j ∩ {y | 0 < b (P.param j y)} ⊆ P.W j := fun j => Set.inter_subset_left
  have hρ1' : ∀ j, ∀ y ∈ P.W j ∩ {y | 0 < b (P.param j y)}, ∑ i, ρ i (P.param j y) = 1 :=
    fun j y hy => hρ1 _ (hSO j y hy.1).2 (le_of_lt hy.2)
  have hWc : ∀ j (e : Fin 2), ContinuousOn (fun x => V j x e) (P.W j) :=
    fun j e => (hVs j e).continuousOn
  have hWz : ∀ j, ∀ x ∈ P.W j, x ∉ P.W j ∩ {y | 0 < b (P.param j y)} →
      ∀ e : Fin 2, V j x e = 0 := by
    intro j x hx hxA e
    have hb0 : b (P.param j x) ≤ 0 := by
      by_contra h; push_neg at h; exact hxA ⟨hx, h⟩
    have hz := Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg hb0 hs.le)
    rw [hV]; beta_reduce; rw [hz]; simp
  have hWt : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, ∀ i : Fin 2,
      ∑ e : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 e) i * V j x e =
        V k (P.proj k (P.param j x)) i := by
    intro j k x hx i
    obtain ⟨hyW, hpar⟩ := c2e j k x hx
    rw [hV]; beta_reduce
    rw [hpar]
    by_cases hq0 : P.param j x = p₀
    · have h0 := (hχ0 j x hx.1 hq0).self_of_nhds
      rw [h0]; simp
    by_cases hqU : P.param j x ∈ U
    · obtain ⟨hv, hv'⟩ := hLtr j k x hx hqU hq0
      have ht := (pcgb_chart_pair_transport S P j k x hx (L j) (L j) (L k) (L k)
        hv hv hv' hv').1 i
      simp only [Fin.sum_univ_two] at ht ⊢
      linear_combination (cut (P.param j x) * Real.smoothTransition (b (P.param j x) / s)) * ht
    · have hz : Real.smoothTransition (b (P.param j x) / s) = 0 :=
        Real.smoothTransition.zero_of_nonpos
          (div_nonpos_of_nonpos_of_nonneg (hPU j x hx.1 hqU).le hs.le)
      rw [hz]; simp
  have hsum0 := hdiv (fun j => P.W j ∩ {y | 0 < b (P.param j y)}) hAo hAW hρ1' V hWc hWz hWt
  
  have hibp := pcgb_patched_ibp_sum S P ρ Kc hρs hK hρK V hVs hsum0
  have hsplit : ∀ j, (∫ x in P.W j, ρ j (P.param j x) *
        ∑ e : Fin 2, pd2 e (fun z => Real.sqrt (P.h j z).det * V j z e) x) =
      (∫ x in P.W j, ρ j (P.param j x) * T1 j x * Real.sqrt (P.h j x).det) +
      (∫ x in P.W j, ρ j (P.param j x) * T2 j x * Real.sqrt (P.h j x).det) +
      (∫ x in P.W j, ρ j (P.param j x) * T3 j x * Real.sqrt (P.h j x).det) := by
    intro j
    have i1 := hIT j (T1 j) (hT1c j)
    have i2 := hIT j (T2 j) (hT2c j)
    have i3 := hIT j (T3 j) (hT3c j)
    have e1 := MeasureTheory.integral_add i1 i2
    have i12 : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) * T1 j x *
        Real.sqrt (P.h j x).det + ρ j (P.param j x) * T2 j x * Real.sqrt (P.h j x).det)
        (P.W j) := i1.add i2
    have e2 := MeasureTheory.integral_add i12 i3
    rw [← e1, ← e2]
    refine MeasureTheory.setIntegral_congr_fun (P.W_open j).measurableSet (fun x hx => ?_)
    beta_reduce
    rw [hid j x hx]
    ring
  have hfin : eigWInt P ρ T1 + eigWInt P ρ T2 + eigWInt P ρ T3 = 0 := by
    unfold eigWInt
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← hibp]
    exact Finset.sum_congr rfl (fun j _ => (hsplit j).symm)
  
  have hT2eq : eigWInt P ρ T2 = eigWInt P ρ (fun j x =>
      s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
          pd2 c (L j) x) := by
    unfold eigWInt
    refine Finset.sum_congr rfl (fun j _ =>
      MeasureTheory.setIntegral_congr_fun (P.W_open j).measurableSet (fun x hx => ?_))
    rw [hT2]; beta_reduce
    rcases hdich j x hx with ⟨h1, _⟩ | hy
    · rw [h1, one_mul]
    · rw [(hbig j x hx hy).2.1]; simp
  
  have hFt : ∀ j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O j₀,
      T3 j x = T3 j₀ (P.proj j₀ (P.param j x)) := by
    intro j x hx
    obtain ⟨hyW, hpar⟩ := c2e j j₀ x hx
    rw [hT3]; beta_reduce
    rw [hpar]
    by_cases hq0 : P.param j x = p₀
    · have h1 : ∀ a, pd2 a (fun y => cut (P.param j y)) x = 0 :=
        fun a => hpd0 _ x 0 (hχ0 j x hx.1 hq0) a
      have h2 : ∀ a, pd2 a (fun y => cut (P.param j₀ y)) (P.proj j₀ (P.param j x)) = 0 :=
        fun a => hpd0 _ _ 0 (hχ0 j₀ _ hyW (hpar.trans hq0)) a
      simp only [h1, h2, mul_zero, zero_mul, Finset.sum_const_zero]
    by_cases hqU : P.param j x ∈ U
    · obtain ⟨hv, hv'⟩ := hLtr j j₀ x hx hqU hq0
      have hN'o : IsOpen (P.W j ∩ P.param j ⁻¹' P.O j₀) :=
        (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open j₀)
      have hu : (fun y => cut (P.param j y)) =ᶠ[𝓝 x]
          fun y => (fun z => cut (P.param j₀ z)) (P.proj j₀ (P.param j y)) :=
        Filter.eventually_of_mem (hN'o.mem_nhds hx) (fun z hz => by
          show cut (P.param j z) = cut (P.param j₀ (P.proj j₀ (P.param j z)))
          rw [(c2e j j₀ z hz).2])
      have hu' : DifferentiableAt ℝ (fun z => cut (P.param j₀ z)) (P.proj j₀ (P.param j x)) :=
        ((hχs j₀).contDiffAt ((P.W_open j₀).mem_nhds hyW)).differentiableAt (by simp)
      have ht := (pcgb_chart_pair_transport S P j j₀ x hx (fun y => cut (P.param j y)) (L j)
        (fun z => cut (P.param j₀ z)) (L j₀) hu hv hu' hv').2
      rw [ht]
    · have hz : Real.smoothTransition (b (P.param j x) / s) = 0 :=
        Real.smoothTransition.zero_of_nonpos
          (div_nonpos_of_nonpos_of_nonneg (hPU j x hx.1 hqU).le hs.le)
      rw [hz]; simp
  have hFo : ∀ j, ∀ x ∈ P.W j, P.param j x ∉ P.O j₀ → T3 j x = 0 := by
    intro j x hx hxO
    have hne : ∀ y ∈ Metric.closedBall x₀ (r / 8), P.param j₀ y ≠ P.param j x := by
      intro y hy heq
      apply hxO
      rw [← heq]
      exact (hSO j₀ y (hball8 hy)).1
    exact hT3z j x (fun a => hpd0 _ x 1 (hχ1 j x hx hne) a)
  have hF1 : ∀ y ∈ P.W j₀, T3 j₀ y ≠ 0 → ∑ i, ρ i (P.param j₀ y) = 1 := by
    intro y hy hne
    rcases hdich j₀ y hy with ⟨_, h0⟩ | hy'
    · exact absurd (hT3z j₀ y h0) hne
    · exact hρ1 _ (hSO j₀ y hy).2 (by linarith [(hbig j₀ y hy hy').2.2])
  have hFi : ∀ i, MeasureTheory.IntegrableOn
      (fun y => ρ i (P.param j₀ y) * T3 j₀ y * Real.sqrt (P.h j₀ y).det) (P.W j₀) := by
    intro i
    refine hintK j₀ _ (Metric.closedBall x₀ (r / 8)) (isCompact_closedBall _ _) hball8
      (((hρs i j₀).continuousOn.mul (hT3c j₀)).mul (hdetc j₀)) ?_
    intro y hy hyB
    rcases hdich j₀ y hy with ⟨_, h0⟩ | ⟨y', hy'B, hy'eq⟩
    · simp only [hT3z j₀ y h0, mul_zero, zero_mul]
    · exfalso
      apply hyB
      have hyy : y' = y := by
        rw [← P.proj_param j₀ y' (hball8 hy'B), hy'eq, P.proj_param j₀ y hy]
      rw [← hyy]
      exact hy'B
  have hT3eq : eigWInt P ρ T3 = ∫ x in P.W j₀, (∑ a : Fin 2, ∑ c : Fin 2,
      (P.h j₀ x)⁻¹ a c * pd2 a ψ x * pd2 c (L j₀) x) * Real.sqrt (P.h j₀ x).det := by
    have hloc := pcgb_flux_localize S P ρ hρO j₀ T3 hFt hFo hF1 hFi
    unfold eigWInt
    rw [hloc]
    refine MeasureTheory.setIntegral_congr_fun (P.W_open j₀).measurableSet (fun y hy => ?_)
    beta_reduce
    have hpsi : ∀ a, pd2 a (fun z => cut (P.param j₀ z)) y = pd2 a ψ y := by
      intro a
      unfold pd2
      have hev : (fun z => cut (P.param j₀ z)) =ᶠ[𝓝 y] ψ :=
        Filter.eventually_of_mem ((P.W_open j₀).mem_nhds hy) hχψ
      rw [hev.fderiv_eq]
    rcases hdich j₀ y hy with ⟨_, h0⟩ | hy'
    · have h0' : ∀ a, pd2 a ψ y = 0 := fun a => (hpsi a) ▸ h0 a
      rw [hT3z j₀ y h0]
      simp only [h0', mul_zero, zero_mul, Finset.sum_const_zero]
    · rw [hT3]; beta_reduce
      rw [(hbig j₀ y hy hy').1, one_mul]
      simp only [hpsi]
  
  subst hT1
  exact ⟨fun j => hIT j _ (hT1c j), by rw [← hT2eq, ← hT3eq]; exact hfin⟩

theorem pcgb_pole_divergence {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (j₀ : Fin P.n) (x₀ : E2) (p₀ : X) (r : ℝ) (hr : 0 < r) (hp₀ : P.param j₀ x₀ = p₀)
    (hball : Metric.closedBall x₀ r ⊆ P.W j₀)
    (hbpos : ∀ x ∈ Metric.closedBall x₀ r, 2 * r ≤ b (P.param j₀ x))
    (U : Set X) (hU : IsOpen U) (hRU : {q | q ∈ S ∧ 0 ≤ b q} ⊆ U)
    (L : Fin P.n → E2 → ℝ)
    (hLs : ∀ j, ContDiffOn ℝ ∞ (L j) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})))
    (hLc : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' (P.O k ∩ (U \ {p₀})),
      L j x = L k (P.proj k (P.param j x)))
    (C : ℝ) (hpole : ∀ x ∈ Metric.ball x₀ r, x ≠ x₀ →
      ‖fderiv ℝ (fun y => L j₀ y + Real.log (pcgbPoleRad P j₀ x₀ y)) x‖ ≤ C ∧
      |lap2 (P.h j₀) (L j₀) x| ≤ C) :
    ∀ s : ℝ, 0 < s → s ≤ r →
      (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) *
         Real.sqrt (P.h j x).det) (P.W j)) ∧
      (∀ j, MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
         (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
           ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
             pd2 c (L j) x) *
         Real.sqrt (P.h j x).det) (P.W j)) ∧
      eigWInt P ρ (fun j x => Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) +
        eigWInt P ρ (fun j x => s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (L j) x)
        = 2 * Real.pi :=
by
  classical
  intro s hs hsr
  obtain ⟨hI1, hI2⟩ := pcgb_pd_integrable S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1 j₀ x₀ p₀ r hr hp₀
    hball hbpos U hU hRU L hLs hLc C hpole
    (fun A B hA hB τ hτ hτAB h h' hh hh' hpd' hpd hcomp g hg f hf x hx =>
      lap2_chart_invariant A B hA hB τ hτ hτAB h h' hh hh' hpd' hpd hcomp g hg f hf x hx)
    s hs hsr
  refine ⟨hI1, hI2, ?_⟩
  obtain ⟨δ₀, hδ₀, hcut⟩ := pcgb_pd_cutoff_identity S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1 j₀ x₀
    p₀ r hr hp₀ hball hbpos U hU hRU L hLs hLc
    (fun Aset hAo hAW hρ1' Wv hWc hWz hWt =>
      pcgb_local_div_sum_zero S P ρ Kc hρs hK hρK hρO Aset hAo hAW hρ1' Wv hWc hWz hWt)
  obtain ⟨cut, hcutdef⟩ : ∃ cut : ℝ → X → ℝ, cut = fun δ q =>
      1 - (P.O j₀).indicator (fun q' => 1 - Real.smoothTransition
        ((pcgbPoleRad P j₀ x₀ (P.proj j₀ q') - δ) / δ)) q := ⟨_, rfl⟩
  obtain ⟨I2, hI2def⟩ : ∃ I2 : ℝ, I2 =
      eigWInt P ρ (fun j x => s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
          pd2 c (L j) x) := ⟨_, rfl⟩
  
  have hcut01 : ∀ (δ : ℝ) (q : X), 0 ≤ cut δ q ∧ cut δ q ≤ 1 := by
    intro δ q
    rw [hcutdef]
    beta_reduce
    by_cases hq : q ∈ P.O j₀
    · rw [Set.indicator_apply, if_pos hq]
      beta_reduce
      have h1 := Real.smoothTransition.nonneg ((pcgbPoleRad P j₀ x₀ (P.proj j₀ q) - δ) / δ)
      have h2 := Real.smoothTransition.le_one ((pcgbPoleRad P j₀ x₀ (P.proj j₀ q) - δ) / δ)
      constructor <;> linarith
    · rw [Set.indicator_apply, if_neg hq]
      constructor <;> norm_num
  
  have hcut1 : ∀ q ∈ S, q ≠ p₀ → ∀ᶠ δ in 𝓝[>] (0 : ℝ), cut δ q = 1 := by
    intro q hqS hq
    by_cases hqO : q ∈ P.O j₀
    · have hmem : q ∈ P.param j₀ '' P.W j₀ := by
        rw [P.image_eq j₀]
        exact ⟨hqO, hqS⟩
      obtain ⟨z, hzW, rfl⟩ := hmem
      have hzx : z ≠ x₀ := by
        intro h
        apply hq
        rw [h, hp₀]
      have hA0 : (P.h j₀ x₀).PosDef :=
        P.h_posDef j₀ x₀ (hball (Metric.mem_closedBall_self hr.le))
      have hw0 : (fun a : Fin 2 => (z - x₀) a) ≠ 0 := by
        intro h
        apply hzx
        have h' : z - x₀ = 0 := by
          ext i
          have := congrFun h i
          simpa using this
        exact sub_eq_zero.mp h'
      have hQ : 0 < ∑ a : Fin 2, ∑ c : Fin 2, P.h j₀ x₀ a c * (z - x₀) a * (z - x₀) c := by
        have h1 := hA0.dotProduct_mulVec_pos hw0
        have h2 : star (fun a : Fin 2 => (z - x₀) a) ⬝ᵥ
            (P.h j₀ x₀).mulVec (fun a : Fin 2 => (z - x₀) a) =
            ∑ a : Fin 2, ∑ c : Fin 2, P.h j₀ x₀ a c * (z - x₀) a * (z - x₀) c := by
          simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
          ring
        rw [← h2]
        exact h1
      have hr0 : 0 < pcgbPoleRad P j₀ x₀ z := Real.sqrt_pos.mpr hQ
      filter_upwards [Ioo_mem_nhdsGT (half_pos hr0)] with δ hδ
      rw [hcutdef]
      beta_reduce
      rw [Set.indicator_apply, if_pos hqO]
      beta_reduce
      rw [P.proj_param j₀ z hzW]
      have hge : 1 ≤ (pcgbPoleRad P j₀ x₀ z - δ) / δ := by
        rw [le_div_iff₀ hδ.1]
        linarith [hδ.2]
      rw [Real.smoothTransition.one_of_one_le hge]
      ring
    · refine Filter.Eventually.of_forall (fun δ => ?_)
      rw [hcutdef]
      beta_reduce
      rw [Set.indicator_apply, if_neg hqO]
      ring
  
  have hae : ∀ j, ∀ᵐ x ∂(volume : Measure E2), x ∈ P.W j → P.param j x ≠ p₀ := by
    intro j
    have hZ : (volume : Measure E2) (P.W j ∩ P.param j ⁻¹' {p₀}) = 0 := by
      apply Set.Subsingleton.measure_zero
      intro x hx y hy
      have h1 : P.param j x = p₀ := hx.2
      have h2 : P.param j y = p₀ := hy.2
      calc x = P.proj j (P.param j x) := (P.proj_param j x hx.1).symm
        _ = P.proj j (P.param j y) := by rw [h1, h2]
        _ = y := P.proj_param j y hy.1
    rw [ae_iff]
    refine measure_mono_null (fun x hx => ?_) hZ
    have hx' : ¬ (x ∈ P.W j → P.param j x ≠ p₀) := hx
    push_neg at hx'
    exact ⟨hx'.1, hx'.2⟩
  have key : ∀ a c e d : ℝ, 0 ≤ c → c ≤ 1 → |a * (c * e) * d| ≤ |a * e * d| := by
    intro a c e d hc hc1
    rw [show a * (c * e) * d = c * (a * e * d) by ring, abs_mul, abs_of_nonneg hc]
    exact mul_le_of_le_one_left (abs_nonneg _) hc1
  
  have hA : ∀ j, Tendsto (fun δ => ∫ x in P.W j, ρ j (P.param j x) *
      (cut δ (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
        lap2 (P.h j) (L j) x)) * Real.sqrt (P.h j x).det) (𝓝[>] (0 : ℝ))
      (𝓝 (∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) *
        Real.sqrt (P.h j x).det)) := by
    intro j
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun x => ‖ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x) *
        Real.sqrt (P.h j x).det‖) ?_ ?_ ?_ ?_
    · filter_upwards [Ioo_mem_nhdsGT hδ₀] with δ hδ
      have h := MeasureTheory.Integrable.aestronglyMeasurable
        ((hcut δ hδ.1 hδ.2 s hs hsr).1 j)
      rw [hcutdef]
      exact h
    · refine Filter.Eventually.of_forall (fun δ => Filter.Eventually.of_forall (fun x => ?_))
      obtain ⟨h0, h1⟩ := hcut01 δ (P.param j x)
      simp only [Real.norm_eq_abs]
      exact key _ _ _ _ h0 h1
    · exact MeasureTheory.Integrable.norm (hI1 j)
    · rw [MeasureTheory.ae_restrict_iff' (P.W_open j).measurableSet]
      filter_upwards [hae j] with x hx hxW
      have hq := hx hxW
      have hqS : P.param j x ∈ S := by
        have h := Set.mem_image_of_mem (P.param j) hxW
        rw [P.image_eq j] at h
        exact h.2
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [hcut1 _ hqS hq] with δ hδ
      rw [hδ, one_mul]
  have hAsum : Tendsto (fun δ => eigWInt P ρ (fun j x => cut δ (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x))) (𝓝[>] (0 : ℝ))
      (𝓝 (eigWInt P ρ (fun j x =>
        Real.smoothTransition (b (P.param j x) / s) * lap2 (P.h j) (L j) x))) := by
    unfold eigWInt
    exact tendsto_finset_sum Finset.univ (fun j _ => hA j)
  
  have hLball : ContDiffOn ℝ ∞ (L j₀) (Metric.ball x₀ r \ {x₀}) := by
    refine (hLs j₀).mono (fun x hx => ?_)
    have hxW : x ∈ P.W j₀ := hball (Metric.ball_subset_closedBall hx.1)
    have hxne : x ≠ x₀ := hx.2
    have hS : P.param j₀ x ∈ S := by
      have h := Set.mem_image_of_mem (P.param j₀) hxW
      rw [P.image_eq j₀] at h
      exact h.2
    have hb0 : 0 ≤ b (P.param j₀ x) := by
      have := hbpos x (Metric.ball_subset_closedBall hx.1)
      linarith
    refine ⟨hxW, hRU ⟨hS, hb0⟩, ?_⟩
    intro hpx
    have hpx' : P.param j₀ x = p₀ := hpx
    apply hxne
    calc x = P.proj j₀ (P.param j₀ x) := (P.proj_param j₀ x hxW).symm
      _ = P.proj j₀ (P.param j₀ x₀) := by rw [hpx', hp₀]
      _ = x₀ := P.proj_param j₀ x₀ (hball (Metric.mem_closedBall_self hr.le))
  have hF := pcgb_pole_flux_limit (P.W j₀) (P.W_open j₀) (P.h j₀) (P.h_smooth j₀)
    (P.h_posDef j₀) x₀ r hr hball (L j₀) hLball C (fun x hx hne => (hpole x hx hne).1)
  have hlim := (hAsum.add (tendsto_const_nhds (x := I2))).add hF
  have hzero : Tendsto (fun _ : ℝ => (0 : ℝ)) (𝓝[>] (0 : ℝ)) (𝓝 0) := tendsto_const_nhds
  have huniq := tendsto_nhds_unique hlim (hzero.congr' (by
    filter_upwards [Ioo_mem_nhdsGT hδ₀] with δ hδ
    have h := (hcut δ hδ.1 hδ.2 s hs hsr).2
    rw [hcutdef, hI2def]
    exact h.symm))
  rw [hI2def] at huniq
  linarith

theorem pcgb_log_potential_props {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ) (Gd : PcgbGreenData P b) (ε : ℝ)
    (hε : 0 < ε) :
    (∀ j, ContDiffOn ℝ ∞ (fun y => (1 / 2 : ℝ) * Real.log
        (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε))
      (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀}))) ∧
    (∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' (P.O k ∩ (Gd.U \ {Gd.p₀})),
      (1 / 2 : ℝ) * Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) x + ε) =
      (1 / 2 : ℝ) * Real.log (sgbGradSq2 (P.h k) (fun z => Gd.w (P.param k z))
        (P.proj k (P.param j x)) + ε)) :=
by
  classical
  have hUo : IsOpen (Gd.U \ {Gd.p₀}) := Gd.U_open.sdiff isClosed_singleton
  have hVo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) hUo
  
  have hnn : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ), A.PosDef → ∀ ξ : Fin 2 → ℝ,
      0 ≤ ∑ a : Fin 2, ∑ c : Fin 2, A⁻¹ a c * ξ a * ξ c := by
    intro A hA ξ
    have hB : A⁻¹.PosDef := hA.inv
    have hsym : A⁻¹ 1 0 = A⁻¹ 0 1 := by
      have h := hB.isHermitian.apply 0 1
      simpa using h
    have hp : 0 < A⁻¹ 0 0 := hB.diag_pos
    have hdet : 0 < A⁻¹.det := hB.det_pos
    rw [Matrix.det_fin_two, hsym] at hdet
    have hδ : 0 ≤ A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2 := by nlinarith
    have key1 : A⁻¹ 0 0 * (∑ a : Fin 2, ∑ c : Fin 2, A⁻¹ a c * ξ a * ξ c) =
        (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1) ^ 2 +
          (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * ξ 1 ^ 2 := by
      simp only [Fin.sum_univ_two, hsym]
      ring
    have h2 : 0 ≤ A⁻¹ 0 0 * (∑ a : Fin 2, ∑ c : Fin 2, A⁻¹ a c * ξ a * ξ c) := by
      rw [key1]
      exact add_nonneg (sq_nonneg _) (mul_nonneg hδ (sq_nonneg _))
    exact nonneg_of_mul_nonneg_right h2 hp
  
  have hgen : ∀ (V : Set E2), IsOpen V → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V) → (∀ y ∈ V, (h y).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w V →
      ContDiffOn ℝ ∞ (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) V := by
    intro V hs h hh hpos w hw
    have hdetpos : ∀ y ∈ V, 0 < (h y).det := fun y hy => (hpos y hy).det_pos
    have hinv : ∀ i l : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i l) V := by
      have hdet : ContDiffOn ℝ ∞ (fun y => (h y).det) V := by
        have e : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
          funext y
          exact Matrix.det_fin_two _
        rw [e]
        exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
      have hdi : ContDiffOn ℝ ∞ (fun y => ((h y).det)⁻¹) V :=
        hdet.inv (fun y hy => (hdetpos y hy).ne')
      intro i l
      have e : (fun y => (h y)⁻¹ i l) = fun y => ((h y).det)⁻¹ * (h y).adjugate i l := by
        funext y
        rw [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
      rw [e]
      refine hdi.mul ?_
      simp only [Matrix.adjugate_fin_two]
      fin_cases i <;> fin_cases l <;> simp <;>
        first
        | exact hh _ _
        | exact (hh _ _).neg
    have hDr : ∀ a : Fin 2, ContDiffOn ℝ ∞ (fun y => pd2 a w y) V :=
      fun a => ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hw).2.clm_apply contDiffOn_const
    have hG : ContDiffOn ℝ ∞ (fun y => sgbGradSq2 h w y + ε) V := by
      unfold sgbGradSq2
      refine ContDiffOn.add ?_ contDiffOn_const
      exact ContDiffOn.sum fun a _ => ContDiffOn.sum fun c _ =>
        ((hinv a c).mul (hDr a)).mul (hDr c)
    refine contDiffOn_const.mul (hG.log fun y hy => ?_)
    have h0 : 0 ≤ sgbGradSq2 h w y := hnn (h y) (hpos y hy) (fun a => pd2 a w y)
    exact ne_of_gt (by linarith)
  refine ⟨fun j => ?_, fun j k x hx => ?_⟩
  · exact hgen _ (hVo j) (P.h j) (fun a b => (P.h_smooth j a b).mono Set.inter_subset_left)
      (fun y hy => P.h_posDef j y hy.1) _ (Gd.smooth j)
  · obtain ⟨hxW, hxO, hxU⟩ := hx
    have hx' : x ∈ P.W j ∩ P.param j ⁻¹' P.O k := ⟨hxW, hxO⟩
    have hD : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
    have hP3 : ∀ x' ∈ P.W j ∩ P.param j ⁻¹' P.O k,
        P.proj k (P.param j x') ∈ P.W k ∧ P.param k (P.proj k (P.param j x')) = P.param j x' := by
      intro x' hx''
      have h1 : P.param j x' ∈ P.O j ∩ S := by
        rw [← P.image_eq j]; exact ⟨x', hx''.1, rfl⟩
      have h2 : P.param j x' ∈ P.param k '' P.W k := by
        rw [P.image_eq k]; exact ⟨hx''.2, h1.2⟩
      obtain ⟨y', hy', hyeq⟩ := h2
      rw [← hyeq, P.proj_param k y' hy']
      exact ⟨hy', rfl⟩
    have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
      ((P.trans_smooth j k).contDiffAt (hD.mem_nhds hx')).differentiableAt (by simp)
    have hyV : P.proj k (P.param j x) ∈ P.W k ∩ P.param k ⁻¹' (Gd.U \ {Gd.p₀}) := by
      refine ⟨(hP3 x hx').1, ?_⟩
      show P.param k (P.proj k (P.param j x)) ∈ Gd.U \ {Gd.p₀}
      rw [(hP3 x hx').2]
      exact hxU
    have hfd : DifferentiableAt ℝ (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) :=
      ((Gd.smooth k).contDiffAt ((hVo k).mem_nhds hyV)).differentiableAt (by simp)
    have chain : ∀ b : Fin 2, pd2 b (fun x' => Gd.w (P.param j x')) x =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c *
          pd2 c (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) := by
      intro b
      have hev : (fun x' => Gd.w (P.param j x')) =ᶠ[𝓝 x]
          ((fun y => Gd.w (P.param k y)) ∘ (fun x' => P.proj k (P.param j x'))) :=
        Filter.eventually_of_mem (hD.mem_nhds hx')
          (fun x' hx'' => by simp only [Function.comp, (hP3 x' hx'').2])
      unfold pd2
      rw [hev.fderiv_eq, fderiv_comp x hfd hτd, ContinuousLinearMap.comp_apply]
      have hw' : fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) =
          ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c • e2 c := by
        ext i
        fin_cases i <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
      conv_lhs => rw [hw']
      simp only [map_sum, map_smul, smul_eq_mul]
    set J : Matrix (Fin 2) (Fin 2) ℝ :=
      Matrix.of fun c a => fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c with hJ
    have hKJ : P.h j x = J.transpose * P.h k (P.proj k (P.param j x)) * J := by
      ext a b
      rw [P.h_compat j k x hx' a b]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply, Fin.sum_univ_two]
      ring
    have hdetK : 0 < (P.h j x).det := (P.h_posDef j x hxW).det_pos
    have hJdet : IsUnit J.det := by
      rw [isUnit_iff_ne_zero]
      intro h0
      have : (P.h j x).det = 0 := by
        rw [hKJ, Matrix.det_mul, Matrix.det_mul, h0]; simp
      linarith
    have hJTdet : IsUnit J.transpose.det := by rwa [Matrix.det_transpose]
    have hinv : J * (P.h j x)⁻¹ * J.transpose = (P.h k (P.proj k (P.param j x)))⁻¹ := by
      rw [hKJ, Matrix.mul_inv_rev, Matrix.mul_inv_rev, ← Matrix.mul_assoc J J⁻¹,
        Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul, Matrix.mul_assoc,
        Matrix.nonsing_inv_mul J.transpose hJTdet, Matrix.mul_one]
    have e : ∀ d c : Fin 2, (J * (P.h j x)⁻¹ * J.transpose) d c =
        (P.h k (P.proj k (P.param j x)))⁻¹ d c := fun d c => by rw [hinv]
    have e00 := e 0 0
    have e01 := e 0 1
    have e10 := e 1 0
    have e11 := e 1 1
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
      Fin.sum_univ_two] at e00 e01 e10 e11
    have key : sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) x =
        sgbGradSq2 (P.h k) (fun z => Gd.w (P.param k z)) (P.proj k (P.param j x)) := by
      simp only [sgbGradSq2, Fin.sum_univ_two]
      rw [chain 0, chain 1]
      simp only [Fin.sum_univ_two]
      linear_combination
        (pd2 0 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) *
          pd2 0 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x))) * e00 +
        (pd2 0 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) *
          pd2 1 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x))) * e01 +
        (pd2 1 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) *
          pd2 0 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x))) * e10 +
        (pd2 1 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x)) *
          pd2 1 (fun y => Gd.w (P.param k y)) (P.proj k (P.param j x))) * e11
    rw [key]

theorem pcgb_pole_algebra (A₀ : Matrix (Fin 2) (Fin 2) ℝ) (hA : A₀.PosDef) (κ C₀ : ℝ)
    (hκ : 0 ≤ κ) (hC₀ : 0 ≤ C₀) :
    ∃ δ K : ℝ, 0 < δ ∧ 0 ≤ K ∧
      ∀ (z : Fin 2 → ℝ) (s : ℝ), 0 < s → s ≤ δ → z 0 ^ 2 + z 1 ^ 2 = s ^ 2 →
      ∀ (B : Matrix (Fin 2) (Fin 2) ℝ) (u p : Fin 2 → ℝ) (H : Fin 2 → Fin 2 → ℝ)
        (Γ : Fin 2 → Fin 2 → Fin 2 → ℝ),
      (∀ a b : Fin 2, |B a b - A₀⁻¹ a b| ≤ κ * s) →
      (∀ c : Fin 2, u c = (∑ b : Fin 2, A₀ c b * z b) /
        (∑ i : Fin 2, ∑ j : Fin 2, A₀ i j * z i * z j)) →
      (∀ a : Fin 2, |p a - u a| ≤ C₀) →
      (∀ c a : Fin 2, |H c a + ∑ m : Fin 2, Γ m c a * p m -
        (A₀ c a / (∑ i : Fin 2, ∑ j : Fin 2, A₀ i j * z i * z j) - 2 * u c * u a)| ≤
          C₀ / Real.sqrt (∑ i : Fin 2, ∑ j : Fin 2, A₀ i j * z i * z j)) →
      (∀ m c a : Fin 2, |Γ m c a| ≤ C₀) →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j ∧
      (∀ c : Fin 2, |(∑ a : Fin 2, ∑ b : Fin 2, B a b * H c a * p b) +
          u c * ∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j| ≤
        K * ∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j) ∧
      |∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, B a c * B b d * H a b * H c d| ≤
        K * (∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j) ^ 2 ∧
      (∀ c : Fin 2, |u c| ≤ K * ∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j) :=
by
  
  have prod2 : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x * y| ≤ X * Y := by
    intro x y X Y hx hy
    rw [abs_mul]
    exact mul_le_mul hx hy (abs_nonneg _) (le_trans (abs_nonneg _) hx)
  have prod3 : ∀ x y w X Y W : ℝ, |x| ≤ X → |y| ≤ Y → |w| ≤ W → |x * y * w| ≤ X * Y * W :=
    fun x y w X Y W hx hy hw => prod2 _ _ _ _ (prod2 _ _ _ _ hx hy) hw
  have prod4 : ∀ x y w v X Y W V : ℝ, |x| ≤ X → |y| ≤ Y → |w| ≤ W → |v| ≤ V →
      |x * y * w * v| ≤ X * Y * W * V :=
    fun x y w v X Y W V hx hy hw hv => prod2 _ _ _ _ (prod3 _ _ _ _ _ _ hx hy hw) hv
  have abs2 : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x + y| ≤ X + Y := by
    intro x y X Y hx hy
    have h1 := abs_le.mp hx
    have h2 := abs_le.mp hy
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  have abs3 : ∀ x y w X Y W : ℝ, |x| ≤ X → |y| ≤ Y → |w| ≤ W → |x + y + w| ≤ X + Y + W :=
    fun x y w X Y W hx hy hw => abs2 _ _ _ _ (abs2 _ _ _ _ hx hy) hw
  have sub2 : ∀ x y X Y : ℝ, |x| ≤ X → |y| ≤ Y → |x - y| ≤ X + Y := by
    intro x y X Y hx hy
    have h1 := abs_le.mp hx
    have h2 := abs_le.mp hy
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  have tri : ∀ x y X Y : ℝ, |x - y| ≤ X → |y| ≤ Y → |x| ≤ X + Y := by
    intro x y X Y hx hy
    have h1 := abs_le.mp hx
    have h2 := abs_le.mp hy
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
  have sum2 : ∀ (f : Fin 2 → ℝ) (X : ℝ), (∀ i, |f i| ≤ X) → |∑ i, f i| ≤ 2 * X := by
    intro f X hf
    rw [Fin.sum_univ_two]
    have := abs2 _ _ _ _ (hf 0) (hf 1)
    linarith
  
  have hsym : A₀ 1 0 = A₀ 0 1 := by simpa using hA.1.apply 0 1
  have ha : 0 < A₀ 0 0 := hA.diag_pos
  have hc : 0 < A₀ 1 1 := hA.diag_pos
  have hD : 0 < A₀ 0 0 * A₀ 1 1 - A₀ 0 1 * A₀ 0 1 := by
    have h := hA.det_pos
    rw [Matrix.det_fin_two, hsym] at h
    exact h
  have hBA := Matrix.nonsing_inv_mul A₀ (isUnit_iff_ne_zero.mpr hA.det_pos.ne')
  have e00 : A₀⁻¹ 0 0 * A₀ 0 0 + A₀⁻¹ 0 1 * A₀ 1 0 = 1 := by
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using congrFun (congrFun hBA 0) 0
  have e01 : A₀⁻¹ 0 0 * A₀ 0 1 + A₀⁻¹ 0 1 * A₀ 1 1 = 0 := by
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using congrFun (congrFun hBA 0) 1
  have e10 : A₀⁻¹ 1 0 * A₀ 0 0 + A₀⁻¹ 1 1 * A₀ 1 0 = 0 := by
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using congrFun (congrFun hBA 1) 0
  have e11 : A₀⁻¹ 1 0 * A₀ 0 1 + A₀⁻¹ 1 1 * A₀ 1 1 = 1 := by
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using congrFun (congrFun hBA 1) 1
  
  obtain ⟨μ, hμ_def⟩ : ∃ μ : ℝ, μ = min ((A₀ 0 0 * A₀ 1 1 - A₀ 0 1 * A₀ 0 1) /
      (A₀ 0 0 + A₀ 1 1)) 1 := ⟨_, rfl⟩
  have hac : 0 < A₀ 0 0 + A₀ 1 1 := by linarith
  have hμ0 : 0 < μ := by rw [hμ_def]; exact lt_min (div_pos hD hac) one_pos
  have hμ1 : μ ≤ 1 := by rw [hμ_def]; exact min_le_right _ _
  have hμq : ∀ x y : ℝ, μ * (x ^ 2 + y ^ 2) ≤
      A₀ 0 0 * x * x + A₀ 0 1 * x * y + (A₀ 0 1 * y * x + A₀ 1 1 * y * y) := by
    intro x y
    have hS : 0 ≤ x ^ 2 + y ^ 2 := by positivity
    have h1 : (A₀ 0 0 * A₀ 1 1 - A₀ 0 1 * A₀ 0 1) / (A₀ 0 0 + A₀ 1 1) * (x ^ 2 + y ^ 2) ≤
