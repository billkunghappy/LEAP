    exact hx (Set.mem_iUnion.2 ⟨k, hYfC k x h⟩)
  · intro n q φ hφ hφ1 E hE
    choose ζ hζs hζc hζsub hζ1 using fun k => chart_bump_eq_one (p k) (C k) (hCc k) (hCs k)
    have divsum : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) {ι : Type} (s : Finset ι)
        (P : ι → E3 → E3) (y : E3),
        (∀ j ∈ s, ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * P j z i) y) →
        sepDensDiv G (fun z => ∑ j ∈ s, P j z) y = ∑ j ∈ s, sepDensDiv G (P j) y := by
      intro G ι s P y hP
      have hsum : ∀ (z : E3) (i : Fin 3), (∑ j ∈ s, P j z) i = ∑ j ∈ s, P j z i := by
        intro z i
        simp [WithLp.ofLp_sum, Finset.sum_apply]
      have h1 : ∀ i : Fin 3, (fun z => Real.sqrt (G z).det * (∑ j ∈ s, P j z) i) =
