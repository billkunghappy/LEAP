theorem pcgb_px_T_bounds (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x₀ x : E2) (V : Set E2)
    (hV : IsOpen V) (hxV : x ∈ V) (ψ : E2 → ℝ) (hψ : ContDiffOn ℝ ∞ ψ V) (B a₁ a₂ a₃ : ℝ)
    (hGd : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x)
    (hγd : ∀ k : Fin 2, DifferentiableAt ℝ
      (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x)
    (hB : ∀ i j k : Fin 2,
      |(h x)⁻¹ i j - (h x₀)⁻¹ i j| ≤ B * dist x x₀ ∧
      ‖fderiv ℝ (fun z => (h z)⁻¹ i j) x‖ ≤ B ∧
      |∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x| ≤ B ∧
      ‖fderiv ℝ (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x‖ ≤ B)
    (h1 : ‖fderiv ℝ ψ x‖ ≤ a₁) (h2 : ‖fderiv ℝ (fderiv ℝ ψ) x‖ ≤ a₂)
    (h3 : ‖iteratedFDeriv ℝ 3 ψ x‖ ≤ a₃) :
    DifferentiableAt ℝ (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) x ∧
    |lap2 h ψ x - ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) x| ≤
      4 * B * dist x x₀ * a₂ + 2 * B * a₁ ∧
    ‖fderiv ℝ (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) x‖ ≤
      4 * B * (a₂ + dist x x₀ * a₃) + 2 * B * (a₁ + a₂) :=
by
  
  have hid : (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) =
      fun y => ∑ i : Fin 2, ∑ j : Fin 2, ((h y)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) y -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) *
          pd2 k ψ y := by
    funext y
    simp only [lap2, Fin.sum_univ_two]
    ring
  have hidx : lap2 h ψ x - ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) x =
      ∑ i : Fin 2, ∑ j : Fin 2, ((h x)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) x -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) *
          pd2 k ψ x := congrFun hid x
  
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0 0 0).2.1
  have hs0 : 0 ≤ dist x x₀ := dist_nonneg
  have he : ∀ k : Fin 2, ‖e2 k‖ = 1 := fun k => by simp [e2, EuclideanSpace.norm_single]
  
  have hψ1 : ContDiffOn ℝ ∞ (fderiv ℝ ψ) V := hψ.fderiv_of_isOpen hV le_rfl
  have d1 : ∀ y ∈ V, DifferentiableAt ℝ (fderiv ℝ ψ) y := fun y hy =>
    (hψ1.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
  have d2 : DifferentiableAt ℝ (iteratedFDeriv ℝ 2 ψ) x :=
    (hψ.contDiffAt (hV.mem_nhds hxV)).differentiableAt_iteratedFDeriv
      (WithTop.coe_lt_coe.mpr (ENat.coe_lt_top 2))
  have hQf : ∀ k : Fin 2, ∀ y ∈ V,
      HasFDerivAt (pd2 k ψ) ((fderiv ℝ (fderiv ℝ ψ) y).flip (e2 k)) y := by
    intro k y hy
    have h0 := (d1 y hy).hasFDerivAt.clm_apply (hasFDerivAt_const (e2 k) y)
    convert h0 using 1
    ext v
    simp
  have hp_eq : ∀ i j : Fin 2, pd2 i (pd2 j ψ) =ᶠ[𝓝 x]
      fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j] := by
    intro i j
    filter_upwards [hV.mem_nhds hxV] with y hy
    show fderiv ℝ (pd2 j ψ) y (e2 i) = _
    rw [(hQf j y hy).fderiv, ContinuousLinearMap.flip_apply, iteratedFDeriv_two_apply]
    simp
  have hPf : ∀ i j : Fin 2, HasFDerivAt (pd2 i (pd2 j ψ))
      (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) x :=
    fun i j => ((d2.continuousMultilinear_apply_const ![e2 i, e2 j]).hasFDerivAt).congr_of_eventuallyEq
      (hp_eq i j)
  have h3' : ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x‖ = ‖iteratedFDeriv ℝ 3 ψ x‖ :=
    norm_fderiv_iteratedFDeriv
  have hPn : ∀ i j : Fin 2,
      ‖fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x‖ ≤ a₃ := by
    intro i j
    refine ContinuousLinearMap.opNorm_le_bound _ ((norm_nonneg _).trans h3) (fun v => ?_)
    rw [fderiv_continuousMultilinear_apply_const_apply d2]
    calc ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v ![e2 i, e2 j]‖
        ≤ ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v‖ * ∏ k : Fin 2, ‖(![e2 i, e2 j] : Fin 2 → E2) k‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v‖ := by
          simp [Fin.prod_univ_two, he]
      _ ≤ ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x‖ * ‖v‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ a₃ * ‖v‖ := mul_le_mul_of_nonneg_right (h3'.le.trans h3) (norm_nonneg _)
  have hPv : ∀ i j : Fin 2, |pd2 i (pd2 j ψ) x| ≤ a₂ := by
    intro i j
    have hx : pd2 i (pd2 j ψ) x = fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j) := by
      show fderiv ℝ (pd2 j ψ) x (e2 i) = _
      rw [(hQf j x hxV).fderiv, ContinuousLinearMap.flip_apply]
    rw [hx]
    calc |fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j)|
        = ‖fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ (fderiv ℝ ψ) x‖ * ‖e2 i‖ * ‖e2 j‖ :=
          ContinuousLinearMap.le_opNorm₂ _ _ _
      _ = ‖fderiv ℝ (fderiv ℝ ψ) x‖ := by rw [he, he, mul_one, mul_one]
      _ ≤ a₂ := h2
  have hQv : ∀ k : Fin 2, |pd2 k ψ x| ≤ a₁ := by
    intro k
    calc |pd2 k ψ x| = ‖fderiv ℝ ψ x (e2 k)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ ψ x‖ * ‖e2 k‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ ψ x‖ := by rw [he, mul_one]
      _ ≤ a₁ := h1
  have hQn : ∀ k : Fin 2, ‖(fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k)‖ ≤ a₂ := by
    intro k
    have e1 := (fderiv ℝ (fderiv ℝ ψ) x).flip.le_opNorm (e2 k)
    rw [ContinuousLinearMap.opNorm_flip, he, mul_one] at e1
    linarith
  
  have hGf : ∀ i j : Fin 2, HasFDerivAt (fun z => (h z)⁻¹ i j - (h x₀)⁻¹ i j)
      (fderiv ℝ (fun z => (h z)⁻¹ i j) x) x :=
    fun i j => (hGd i j).hasFDerivAt.sub_const _
  have hT : HasFDerivAt (fun y => ∑ i : Fin 2, ∑ j : Fin 2,
        ((h y)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) y -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) *
          pd2 k ψ y)
      (∑ i : Fin 2, ∑ j : Fin 2,
        (((h x)⁻¹ i j - (h x₀)⁻¹ i j) •
            (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) +
          pd2 i (pd2 j ψ) x • fderiv ℝ (fun z => (h z)⁻¹ i j) x) -
        ∑ k : Fin 2, ((∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) •
            (fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k) +
          pd2 k ψ x • fderiv ℝ
            (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x)) x := by
    have hsum : ∀ (F : Fin 2 → E2 → ℝ) (F' : Fin 2 → E2 →L[ℝ] ℝ),
        (∀ k, HasFDerivAt (F k) (F' k) x) →
        HasFDerivAt (fun y => ∑ k : Fin 2, F k y) (∑ k : Fin 2, F' k) x := by
      intro F F' hF
      have h0 := HasFDerivAt.sum (u := Finset.univ) (fun k _ => hF k)
      convert h0 using 1
    apply HasFDerivAt.sub
    · refine hsum _ _ (fun i => ?_)
      refine hsum _ _ (fun j => ?_)
      exact (hGf i j).mul (hPf i j)
    · refine hsum _ _ (fun k => ?_)
      exact (hγd k).hasFDerivAt.mul (hQf k x hxV)
  
  have key : ∀ (a b : ℝ) (u w : E2 →L[ℝ] ℝ) (A1 A2 A3 A4 : ℝ), |a| ≤ A1 → ‖u‖ ≤ A2 →
      |b| ≤ A3 → ‖w‖ ≤ A4 → ‖a • u + b • w‖ ≤ A1 * A2 + A3 * A4 := by
    intro a b u w A1 A2 A3 A4 ha hu hb hw
    calc ‖a • u + b • w‖ ≤ ‖a • u‖ + ‖b • w‖ := norm_add_le _ _
      _ = |a| * ‖u‖ + |b| * ‖w‖ := by rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
      _ ≤ A1 * A2 + A3 * A4 :=
          add_le_add (mul_le_mul ha hu (norm_nonneg _) ((abs_nonneg _).trans ha))
            (mul_le_mul hb hw (norm_nonneg _) ((abs_nonneg _).trans hb))
  have sum4 : ∀ (F : Fin 2 → Fin 2 → ℝ) (C : ℝ), (∀ i j, |F i j| ≤ C) →
      |∑ i : Fin 2, ∑ j : Fin 2, F i j| ≤ 4 * C := by
    intro F C hF
    calc |∑ i : Fin 2, ∑ j : Fin 2, F i j| ≤ ∑ i : Fin 2, |∑ j : Fin 2, F i j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 2, ∑ j : Fin 2, C := Finset.sum_le_sum fun i _ =>
          (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => hF i j)
      _ = 4 * C := by simp only [Fin.sum_univ_two]; ring
  have sum2 : ∀ (F : Fin 2 → ℝ) (C : ℝ), (∀ k, |F k| ≤ C) →
      |∑ k : Fin 2, F k| ≤ 2 * C := by
    intro F C hF
    calc |∑ k : Fin 2, F k| ≤ ∑ k : Fin 2, |F k| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ k : Fin 2, C := Finset.sum_le_sum fun k _ => hF k
      _ = 2 * C := by simp only [Fin.sum_univ_two]; ring
  have nsum4 : ∀ (F : Fin 2 → Fin 2 → (E2 →L[ℝ] ℝ)) (C : ℝ), (∀ i j, ‖F i j‖ ≤ C) →
      ‖∑ i : Fin 2, ∑ j : Fin 2, F i j‖ ≤ 4 * C := by
    intro F C hF
    calc ‖∑ i : Fin 2, ∑ j : Fin 2, F i j‖ ≤ ∑ i : Fin 2, ‖∑ j : Fin 2, F i j‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i : Fin 2, ∑ j : Fin 2, C := Finset.sum_le_sum fun i _ =>
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hF i j)
      _ = 4 * C := by simp only [Fin.sum_univ_two]; ring
  have nsum2 : ∀ (F : Fin 2 → (E2 →L[ℝ] ℝ)) (C : ℝ), (∀ k, ‖F k‖ ≤ C) →
      ‖∑ k : Fin 2, F k‖ ≤ 2 * C := by
    intro F C hF
    calc ‖∑ k : Fin 2, F k‖ ≤ ∑ k : Fin 2, ‖F k‖ := norm_sum_le _ _
      _ ≤ ∑ k : Fin 2, C := Finset.sum_le_sum fun k _ => hF k
      _ = 2 * C := by simp only [Fin.sum_univ_two]; ring
  
  have hgp : ∀ i j : Fin 2, |((h x)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) x| ≤
      B * dist x x₀ * a₂ := by
    intro i j
    rw [abs_mul]
    exact mul_le_mul (hB i j 0).1 (hPv i j) (abs_nonneg _) (mul_nonneg hB0 hs0)
  have hcq : ∀ k : Fin 2,
      |(∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) * pd2 k ψ x| ≤
        B * a₁ := by
    intro k
    rw [abs_mul]
    exact mul_le_mul (hB 0 0 k).2.2.1 (hQv k) (abs_nonneg _) hB0
  have hX : ∀ i j : Fin 2,
      ‖((h x)⁻¹ i j - (h x₀)⁻¹ i j) •
          (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) +
        pd2 i (pd2 j ψ) x • fderiv ℝ (fun z => (h z)⁻¹ i j) x‖ ≤
      B * dist x x₀ * a₃ + a₂ * B :=
    fun i j => key _ _ _ _ _ _ _ _ (hB i j 0).1 (hPn i j) (hPv i j) (hB i j 0).2.1
  have hY : ∀ k : Fin 2,
      ‖(∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) •
            (fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k) +
          pd2 k ψ x • fderiv ℝ
            (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x‖ ≤
      B * a₂ + a₁ * B :=
    fun k => key _ _ _ _ _ _ _ _ (hB 0 0 k).2.2.1 (hQn k) (hQv k) (hB 0 0 k).2.2.2
  refine ⟨?_, ?_, ?_⟩
  · rw [hid]
    exact hT.differentiableAt
  · rw [hidx]
    refine (abs_sub _ _).trans ?_
    have t1 := sum4 _ _ hgp
    have t2 := sum2 _ _ hcq
    linarith
  · rw [hid, hT.fderiv]
    refine (norm_sub_le _ _).trans ?_
    have t1 := nsum4 _ _ hX
    have t2 := nsum2 _ _ hY
    linarith

theorem pcgb_px_quotient_bounds (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1)
    (D Q m f ε : E2 → ℝ) (c₀ l Λ K : ℝ) (hc₀ : 0 < c₀) (hl : 0 < l) (hΛ : 0 ≤ Λ) (hK : 0 ≤ K)
    (hyp : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      DifferentiableAt ℝ D x ∧ DifferentiableAt ℝ Q x ∧ DifferentiableAt ℝ m x ∧
      DifferentiableAt ℝ f x ∧ DifferentiableAt ℝ ε x ∧
      c₀ * dist x x₀ ^ 2 ≤ D x ∧ l * dist x x₀ ^ 2 ≤ Q x ∧ Q x ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ Q x‖ ≤ Λ * dist x x₀ ∧ |m x| ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ m x‖ ≤ Λ * dist x x₀ ∧
      |D x - Q x| ≤ K * dist x x₀ ^ 3 ∧ ‖fderiv ℝ (fun y => D y - Q y) x‖ ≤ K * dist x x₀ ^ 2 ∧
      |ε x| ≤ K * dist x x₀ ^ 5 ∧ ‖fderiv ℝ ε x‖ ≤ K * dist x x₀ ^ 4 ∧
      |f x| ≤ K * dist x x₀ ^ 3 ∧ ‖fderiv ℝ f x‖ ≤ K * dist x x₀ ^ 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      DifferentiableAt ℝ (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
        ε y / (2 * D y ^ 2)) x ∧
      |f x / (2 * D x) - m x * (D x - Q x) / (2 * D x * Q x) - ε x / (2 * D x ^ 2)| ≤
        C * dist x x₀ ∧
      ‖fderiv ℝ (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
        ε y / (2 * D y ^ 2)) x‖ ≤ C :=
by
  have hquot : ∀ (u v : E2 → ℝ) (u' v' : E2 →L[ℝ] ℝ) (x : E2) (s t a b c : ℝ),
      0 < s → 0 < t → 0 < b → HasFDerivAt u u' x → HasFDerivAt v v' x →
      |u x| ≤ a * s * t → ‖u'‖ ≤ a * t → b * t ≤ |v x| → s * ‖v'‖ ≤ c * t →
      ∃ w : E2 →L[ℝ] ℝ, HasFDerivAt (fun y => u y / v y) w x ∧
        |u x / v x| ≤ a / b * s ∧ ‖w‖ ≤ a / b + a * c / b ^ 2 := by
    intro u v u' v' x s t a b c hs ht hb hu hv hu0 hu1 hv0 hv1
    have ha : 0 ≤ a := by
      by_contra h
      push_neg at h
      have := mul_neg_of_neg_of_pos h ht
      linarith [norm_nonneg u']
    have hc : 0 ≤ c := by
      by_contra h
      push_neg at h
      have := mul_neg_of_neg_of_pos h ht
      have := mul_nonneg hs.le (norm_nonneg v')
      linarith
    have hbt : 0 < b * t := mul_pos hb ht
    have hvpos : 0 < |v x| := lt_of_lt_of_le hbt hv0
    have hvx : v x ≠ 0 := abs_pos.mp hvpos
    have hinv : HasFDerivAt (fun y => (v y)⁻¹) (-(v x ^ 2)⁻¹ • v') x :=
      (hasDerivAt_inv hvx).comp_hasFDerivAt x hv
    have hmul := hu.mul hinv
    refine ⟨u x • (-(v x ^ 2)⁻¹ • v') + (v x)⁻¹ • u', ?_, ?_, ?_⟩
    · have e : (fun y => u y / v y) = fun y => u y * (v y)⁻¹ := by
        funext y; rw [div_eq_mul_inv]
      rw [e]; exact hmul
    · rw [abs_div, div_le_iff₀ hvpos]
      have e : a / b * s * (b * t) = a * s * t := by field_simp
      calc |u x| ≤ a * s * t := hu0
        _ = a / b * s * (b * t) := e.symm
        _ ≤ a / b * s * |v x| :=
          mul_le_mul_of_nonneg_left hv0 (mul_nonneg (div_nonneg ha hb.le) hs.le)
    · have e1 : ‖u x • (-(v x ^ 2)⁻¹ • v')‖ = |u x| * ‖v'‖ / |v x| ^ 2 := by
        rw [norm_smul, norm_smul, norm_neg, norm_inv, norm_pow, Real.norm_eq_abs,
          Real.norm_eq_abs]
        ring
      have e2 : ‖(v x)⁻¹ • u'‖ = ‖u'‖ / |v x| := by
        rw [norm_smul, norm_inv, Real.norm_eq_abs]
        ring
      have b1 : |u x| * ‖v'‖ / |v x| ^ 2 ≤ a * c / b ^ 2 := by
        rw [div_le_iff₀ (pow_pos hvpos 2)]
        have hsq : (b * t) ^ 2 ≤ |v x| ^ 2 := pow_le_pow_left₀ hbt.le hv0 2
        have eq : a * t * (c * t) = a * c / b ^ 2 * (b * t) ^ 2 := by field_simp
        calc |u x| * ‖v'‖ ≤ a * s * t * ‖v'‖ := mul_le_mul_of_nonneg_right hu0 (norm_nonneg _)
          _ = a * t * (s * ‖v'‖) := by ring
          _ ≤ a * t * (c * t) := mul_le_mul_of_nonneg_left hv1 (mul_nonneg ha ht.le)
          _ = a * c / b ^ 2 * (b * t) ^ 2 := eq
          _ ≤ a * c / b ^ 2 * |v x| ^ 2 :=
            mul_le_mul_of_nonneg_left hsq (div_nonneg (mul_nonneg ha hc) (sq_nonneg b))
      have b2 : ‖u'‖ / |v x| ≤ a / b := by
        rw [div_le_iff₀ hvpos]
        have eq : a * t = a / b * (b * t) := by field_simp
        calc ‖u'‖ ≤ a * t := hu1
          _ = a / b * (b * t) := eq
          _ ≤ a / b * |v x| := mul_le_mul_of_nonneg_left hv0 (div_nonneg ha hb.le)
      calc ‖u x • (-(v x ^ 2)⁻¹ • v') + (v x)⁻¹ • u'‖
          ≤ ‖u x • (-(v x ^ 2)⁻¹ • v')‖ + ‖(v x)⁻¹ • u'‖ := norm_add_le _ _
        _ ≤ a * c / b ^ 2 + a / b := by rw [e1, e2]; exact add_le_add b1 b2
        _ = a / b + a * c / b ^ 2 := by ring
  have hP0 : 0 ≤ Λ + K := add_nonneg hΛ hK
  have hn2 : ∀ w : E2 →L[ℝ] ℝ, ‖(2 : ℝ) • w‖ = 2 * ‖w‖ := by
    intro w; rw [norm_smul, Real.norm_eq_abs, abs_two]
  refine ⟨(K / (2 * c₀) + K * (2 * (Λ + K)) / (2 * c₀) ^ 2) +
      (2 * Λ * K / (2 * c₀ * l) + 2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2) +
      (K / (2 * c₀ ^ 2) + K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2), ?_, ?_⟩
  · have hc1 : 0 < 2 * c₀ := by positivity
    have hc2 : 0 < 2 * c₀ * l := by positivity
    have hc3 : 0 < 2 * c₀ ^ 2 := by positivity
    have hΛK : 0 ≤ 2 * Λ * K := by positivity
    refine add_nonneg (add_nonneg (add_nonneg ?_ ?_) (add_nonneg ?_ ?_)) (add_nonneg ?_ ?_)
    · exact div_nonneg hK hc1.le
    · exact div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
    · exact div_nonneg hΛK hc2.le
    · exact div_nonneg (mul_nonneg hΛK (by positivity)) (sq_nonneg _)
    · exact div_nonneg hK hc3.le
    · exact div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  intro x hx0 hxσ
  obtain ⟨hD, hQ, hm, hf, hε, hDlo, hQlo, hQhi, hDQ, hmv, hDm, hE, hDE, hεv, hDε, hfv, hDf⟩ :=
    hyp x hx0 hxσ
  set s := dist x x₀ with hs
  have hs1 : s ≤ 1 := by linarith
  have hs2 : 0 < s ^ 2 := by positivity
  have hDpos : 0 < D x := lt_of_lt_of_le (by positivity) hDlo
  have hQpos : 0 < Q x := lt_of_lt_of_le (by positivity) hQlo
  have hss2 : s ^ 2 ≤ s := by nlinarith
  have hss3 : s ^ 3 ≤ s ^ 2 := by nlinarith
  have hDhi : D x ≤ (Λ + K) * s ^ 2 := by
    have := (abs_le.mp hE).2
    nlinarith [mul_le_mul_of_nonneg_left hss3 hK]
  have hdsub : fderiv ℝ (fun y => D y - Q y) x = fderiv ℝ D x - fderiv ℝ Q x :=
    fderiv_fun_sub hD hQ
  have hDD : ‖fderiv ℝ D x‖ ≤ (Λ + K) * s := by
    have e : fderiv ℝ D x = fderiv ℝ (fun y => D y - Q y) x + fderiv ℝ Q x := by
      rw [hdsub]; abel
    rw [e]
    calc _ ≤ ‖fderiv ℝ (fun y => D y - Q y) x‖ + ‖fderiv ℝ Q x‖ := norm_add_le _ _
      _ ≤ K * s ^ 2 + Λ * s := add_le_add hDE hDQ
      _ ≤ (Λ + K) * s := by nlinarith [mul_le_mul_of_nonneg_left hss2 hK]
  have hDDn : 0 ≤ ‖fderiv ℝ D x‖ := norm_nonneg _
  
  have hv1 : HasFDerivAt (fun y => 2 * D y) ((2 : ℝ) • fderiv ℝ D x) x :=
    hD.hasFDerivAt.const_mul 2
  obtain ⟨w1, h1, hT1v, hT1n⟩ := hquot f (fun y => 2 * D y) (fderiv ℝ f x)
    ((2 : ℝ) • fderiv ℝ D x) x s (s ^ 2) K (2 * c₀) (2 * (Λ + K)) hx0 hs2 (by positivity)
    hf.hasFDerivAt hv1
    (by rw [show K * s * s ^ 2 = K * s ^ 3 by ring]; exact hfv) hDf
    (by
      show 2 * c₀ * s ^ 2 ≤ |2 * D x|
      rw [abs_of_pos (by positivity)]; linarith)
    (by rw [hn2]; nlinarith [mul_le_mul_of_nonneg_left hDD hx0.le])
  
  have hEd : HasFDerivAt (fun y => D y - Q y) (fderiv ℝ (fun y => D y - Q y) x) x :=
    (hD.sub hQ).hasFDerivAt
  have hu2 := hm.hasFDerivAt.mul hEd
  have hv2 := hv1.mul hQ.hasFDerivAt
  have hmv0 : 0 ≤ Λ * s ^ 2 := mul_nonneg hΛ hs2.le
  have hEv0 : 0 ≤ K * s ^ 3 := mul_nonneg hK (by positivity)
  obtain ⟨w2, h2, hT2v, hT2n⟩ := hquot (fun y => m y * (D y - Q y)) (fun y => 2 * D y * Q y)
    (m x • fderiv ℝ (fun y => D y - Q y) x + (D x - Q x) • fderiv ℝ m x)
    ((2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)) x s (s ^ 4)
    (2 * Λ * K) (2 * c₀ * l) (4 * Λ * (Λ + K)) hx0 (by positivity) (by positivity) hu2 hv2
    (by
      show |m x * (D x - Q x)| ≤ 2 * Λ * K * s * s ^ 4
      rw [abs_mul]
      have := mul_le_mul hmv hE (abs_nonneg _) hmv0
      have h5 : 0 ≤ Λ * K * s ^ 5 := by positivity
      nlinarith)
    (by
      calc _ ≤ ‖m x • fderiv ℝ (fun y => D y - Q y) x‖ + ‖(D x - Q x) • fderiv ℝ m x‖ :=
            norm_add_le _ _
        _ = |m x| * ‖fderiv ℝ (fun y => D y - Q y) x‖ + |D x - Q x| * ‖fderiv ℝ m x‖ := by
            rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ Λ * s ^ 2 * (K * s ^ 2) + K * s ^ 3 * (Λ * s) :=
            add_le_add (mul_le_mul hmv hDE (norm_nonneg _) hmv0)
              (mul_le_mul hE hDm (norm_nonneg _) hEv0)
        _ = 2 * Λ * K * s ^ 4 := by ring)
    (by
      show 2 * c₀ * l * s ^ 4 ≤ |2 * D x * Q x|
      rw [abs_of_pos (by positivity)]
      have := mul_le_mul (mul_le_mul_of_nonneg_left hDlo (by norm_num : (0 : ℝ) ≤ 2)) hQlo
        (by positivity) (by positivity)
      nlinarith)
    (by
      have hb : ‖(2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)‖ ≤
          2 * D x * ‖fderiv ℝ Q x‖ + Q x * (2 * ‖fderiv ℝ D x‖) := by
        calc _ ≤ ‖(2 * D x) • fderiv ℝ Q x‖ + ‖Q x • ((2 : ℝ) • fderiv ℝ D x)‖ :=
              norm_add_le _ _
          _ = 2 * D x * ‖fderiv ℝ Q x‖ + Q x * (2 * ‖fderiv ℝ D x‖) := by
              rw [norm_smul, norm_smul, hn2, Real.norm_eq_abs, Real.norm_eq_abs,
                abs_of_pos (by positivity : (0 : ℝ) < 2 * D x), abs_of_pos hQpos]
      have k1 : 2 * D x * ‖fderiv ℝ Q x‖ ≤ 2 * ((Λ + K) * s ^ 2) * (Λ * s) :=
        mul_le_mul (by linarith) hDQ (norm_nonneg _) (by positivity)
      have k2 : Q x * (2 * ‖fderiv ℝ D x‖) ≤ Λ * s ^ 2 * (2 * ((Λ + K) * s)) :=
        mul_le_mul hQhi (by linarith) (by positivity) hmv0
      have e : s * (2 * ((Λ + K) * s ^ 2) * (Λ * s) + Λ * s ^ 2 * (2 * ((Λ + K) * s))) =
          4 * Λ * (Λ + K) * s ^ 4 := by ring
      calc s * ‖(2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)‖
          ≤ s * (2 * ((Λ + K) * s ^ 2) * (Λ * s) + Λ * s ^ 2 * (2 * ((Λ + K) * s))) :=
            mul_le_mul_of_nonneg_left (hb.trans (add_le_add k1 k2)) hx0.le
        _ = 4 * Λ * (Λ + K) * s ^ 4 := e)
  
  have hv3 : HasFDerivAt (fun y => 2 * D y ^ 2)
      ((2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)) x := by
    have h := (hD.hasFDerivAt.mul hD.hasFDerivAt).const_mul (2 : ℝ)
    have e : (fun y => 2 * D y ^ 2) = fun y => 2 * (D y * D y) := by funext y; ring
    rw [e]; exact h
  obtain ⟨w3, h3, hT3v, hT3n⟩ := hquot ε (fun y => 2 * D y ^ 2) (fderiv ℝ ε x)
    ((2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)) x s (s ^ 4) K (2 * c₀ ^ 2)
    (4 * (Λ + K) ^ 2) hx0 (by positivity) (by positivity) hε.hasFDerivAt hv3
    (by rw [show K * s * s ^ 4 = K * s ^ 5 by ring]; exact hεv) hDε
    (by
      show 2 * c₀ ^ 2 * s ^ 4 ≤ |2 * D x ^ 2|
      rw [abs_of_pos (by positivity)]
      have := pow_le_pow_left₀ (by positivity) hDlo 2
      nlinarith)
    (by
      have hb : ‖(2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)‖ =
          4 * (D x * ‖fderiv ℝ D x‖) := by
        rw [hn2, ← two_smul ℝ (D x • fderiv ℝ D x), hn2, norm_smul, Real.norm_eq_abs,
          abs_of_pos hDpos]
        ring
      rw [hb]
      have k : D x * ‖fderiv ℝ D x‖ ≤ (Λ + K) * s ^ 2 * ((Λ + K) * s) :=
        mul_le_mul hDhi hDD hDDn (by positivity)
      have e : s * (4 * ((Λ + K) * s ^ 2 * ((Λ + K) * s))) = 4 * (Λ + K) ^ 2 * s ^ 4 := by
        ring
      calc s * (4 * (D x * ‖fderiv ℝ D x‖))
          ≤ s * (4 * ((Λ + K) * s ^ 2 * ((Λ + K) * s))) := by gcongr
        _ = _ := e)
  
  have h1' : HasFDerivAt (fun y => f y / (2 * D y)) w1 x := h1
  have h2' : HasFDerivAt (fun y => m y * (D y - Q y) / (2 * D y * Q y)) w2 x := h2
  have h3' : HasFDerivAt (fun y => ε y / (2 * D y ^ 2)) w3 x := h3
  have hR : HasFDerivAt (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
      ε y / (2 * D y ^ 2)) (w1 - w2 - w3) x := (h1'.sub h2').sub h3'
  have hT1v' : |f x / (2 * D x)| ≤ K / (2 * c₀) * s := hT1v
  have hT2v' : |m x * (D x - Q x) / (2 * D x * Q x)| ≤ 2 * Λ * K / (2 * c₀ * l) * s := hT2v
  have hT3v' : |ε x / (2 * D x ^ 2)| ≤ K / (2 * c₀ ^ 2) * s := hT3v
  have hc1 : 0 < 2 * c₀ := by positivity
  have hc2 : 0 < 2 * c₀ * l := by positivity
  have hc3 : 0 < 2 * c₀ ^ 2 := by positivity
  have hΛK : 0 ≤ 2 * Λ * K := by positivity
  have x1 : 0 ≤ K * (2 * (Λ + K)) / (2 * c₀) ^ 2 :=
    div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  have x2 : 0 ≤ 2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2 :=
    div_nonneg (mul_nonneg hΛK (by positivity)) (sq_nonneg _)
  have x3 : 0 ≤ K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2 :=
    div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  refine ⟨hR.differentiableAt, ?_, ?_⟩
  · have habs1 := abs_sub (f x / (2 * D x) - m x * (D x - Q x) / (2 * D x * Q x))
        (ε x / (2 * D x ^ 2))
    have habs2 := abs_sub (f x / (2 * D x)) (m x * (D x - Q x) / (2 * D x * Q x))
    have hextra : 0 ≤ (K * (2 * (Λ + K)) / (2 * c₀) ^ 2 +
        2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2 +
        K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2) * s :=
      mul_nonneg (by linarith) hx0.le
    nlinarith
  · rw [hR.fderiv]
    calc ‖w1 - w2 - w3‖ ≤ ‖w1 - w2‖ + ‖w3‖ := norm_sub_le _ _
      _ ≤ ‖w1‖ + ‖w2‖ + ‖w3‖ := by linarith [norm_sub_le w1 w2]
      _ ≤ _ := by linarith

theorem pcgb_parametrix_estimate_core (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1)
    (hball : Metric.closedBall x₀ σ ⊆ W) (D : E2 → ℝ) (M : Matrix (Fin 2) (Fin 2) ℝ)
    (hM : ∀ a c : Fin 2, M a c = M c a) (c₀ K Kψ : ℝ) (hc₀ : 0 < c₀) (hK : 0 ≤ K)
    (hKψ : 0 ≤ Kψ)
    (hlap : ∀ (u : E2 → ℝ) (V : Set E2), IsOpen V → V ⊆ W → ContDiffOn ℝ ∞ u V →
      ContDiffOn ℝ ∞ (lap2 h u) V)
    (hD : ContDiff ℝ ∞ D)
    (hψs : ContDiffOn ℝ ∞ (pcgbPxPsi (h x₀) M x₀) {x | x ≠ x₀})
    (hjet : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → pcgbPxJet h D M x₀ c₀ K x)
    (hψ : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < 1 → pcgbPxPsiEst (h x₀) M x₀ Kψ x)
    (hid : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (D y)) x =
        lap2 h D x / (2 * D x) -
          (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a D x * pd2 c D x) / (2 * D x ^ 2))
    (Λ₀ : E2 → ℝ)
    (hΛ₀ : ∀ y : E2, Λ₀ y = (1 / 2 : ℝ) * Real.log (D y) - pcgbPxPsi (h x₀) M x₀ y) :
    ∃ c K' : ℝ, 0 ≤ K' ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      |lap2 h Λ₀ x - c| ≤ K' * Real.sqrt (dist x x₀) ∧
      ‖fderiv ℝ (lap2 h Λ₀) x‖ ≤ K' / Real.sqrt (dist x x₀) ∧
      |Λ₀ x - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))| ≤ K' ∧
      ‖fderiv ℝ (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) x‖ ≤ K' ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)))) x‖ ≤
        K' / Real.sqrt (pcgbPxQuad (h x₀) x₀ x) :=
by
  classical
  
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hσ.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  obtain ⟨hQs, hQb⟩ := pcgb_px_quad_bounds (h x₀) x₀
  obtain ⟨hms, hmb⟩ := pcgb_px_quad_bounds M x₀
  obtain ⟨SH, hSH⟩ : ∃ S : ℝ, S = ∑ a : Fin 2, ∑ c : Fin 2, |h x₀ a c| := ⟨_, rfl⟩
  obtain ⟨SM, hSM⟩ : ∃ S : ℝ, S = ∑ a : Fin 2, ∑ c : Fin 2, |M a c| := ⟨_, rfl⟩
  rw [← hSH] at hQb
  rw [← hSM] at hmb
  have hSH0 : 0 ≤ SH := by
    rw [hSH]; exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun c _ => abs_nonneg _))
  have hSM0 : 0 ≤ SM := by
    rw [hSM]; exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun c _ => abs_nonneg _))
  obtain ⟨Lam, hLam⟩ : ∃ L : ℝ, L = 2 * (SH + SM) := ⟨_, rfl⟩
  have hLam0 : 0 ≤ Lam := by rw [hLam]; linarith
  have hSHL : SH ≤ Lam := by rw [hLam]; linarith
  have hSML : SM ≤ Lam := by rw [hLam]; linarith
  have h2SHL : 2 * SH ≤ Lam := by rw [hLam]; linarith
  have h2SML : 2 * SM ≤ Lam := by rw [hLam]; linarith
  have hQle : ∀ y : E2, pcgbPxQuad (h x₀) x₀ y ≤ Lam * dist y x₀ ^ 2 := fun y =>
    (le_abs_self _).trans ((hQb y).1.trans (mul_le_mul_of_nonneg_right hSHL (sq_nonneg _)))
  have hDQ : ∀ y : E2, ‖fderiv ℝ (pcgbPxQuad (h x₀) x₀) y‖ ≤ Lam * dist y x₀ := fun y =>
    (hQb y).2.1.trans (mul_le_mul_of_nonneg_right h2SHL dist_nonneg)
  have hD2Q : ∀ y : E2, ‖fderiv ℝ (fderiv ℝ (pcgbPxQuad (h x₀) x₀)) y‖ ≤ Lam := fun y =>
    (hQb y).2.2.trans h2SHL
  have hmle : ∀ y : E2, |pcgbPxQuad M x₀ y| ≤ Lam * dist y x₀ ^ 2 := fun y =>
    (hmb y).1.trans (mul_le_mul_of_nonneg_right hSML (sq_nonneg _))
  have hDm : ∀ y : E2, ‖fderiv ℝ (pcgbPxQuad M x₀) y‖ ≤ Lam * dist y x₀ := fun y =>
    (hmb y).2.1.trans (mul_le_mul_of_nonneg_right h2SML dist_nonneg)
  
  obtain ⟨l, hldef⟩ : ∃ l : ℝ, l = (h x₀).det / (h x₀ 0 0 + h x₀ 1 1) := ⟨_, rfl⟩
  have hsym : h x₀ 1 0 = h x₀ 0 1 := by
    have := hH.isHermitian.apply 0 1
    simpa using this
  have ha0 : 0 < h x₀ 0 0 := hH.diag_pos
  have hc0 : 0 < h x₀ 1 1 := hH.diag_pos
  have hdet : 0 < (h x₀).det := hH.det_pos
  rw [Matrix.det_fin_two, hsym] at hdet
  have hl0 : 0 < l := by
    rw [hldef, Matrix.det_fin_two, hsym]
    exact div_pos hdet (by linarith)
  have hlQ : ∀ y : E2, l * dist y x₀ ^ 2 ≤ pcgbPxQuad (h x₀) x₀ y := by
    intro y
    have hdist : dist y x₀ ^ 2 = (y - x₀) 0 ^ 2 + (y - x₀) 1 ^ 2 := by
      rw [dist_eq_norm, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)), Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have hQ : pcgbPxQuad (h x₀) x₀ y = h x₀ 0 0 * (y - x₀) 0 ^ 2 +
        2 * h x₀ 0 1 * (y - x₀) 0 * (y - x₀) 1 + h x₀ 1 1 * (y - x₀) 1 ^ 2 := by
      simp only [pcgbPxQuad, Fin.sum_univ_two, hsym]
      ring
    rw [hldef, Matrix.det_fin_two, hsym, hdist, hQ, div_mul_eq_mul_div,
      div_le_iff₀ (by linarith)]
    nlinarith [sq_nonneg (h x₀ 0 0 * (y - x₀) 0 + h x₀ 0 1 * (y - x₀) 1),
      sq_nonneg (h x₀ 0 1 * (y - x₀) 0 + h x₀ 1 1 * (y - x₀) 1)]
  
  have hlw : ∀ s : ℝ, 0 < s → s ≤ 1 →
      s * (1 + |Real.log s|) ≤ 1 ∧ Real.sqrt s * (1 + |Real.log s|) ≤ 2 := by
    intro s hs hs1
    have hlog : Real.log s ≤ 0 := Real.log_nonpos hs.le hs1
    have habs : |Real.log s| = -Real.log s := abs_of_nonpos hlog
    have hinv : ∀ u : ℝ, 0 < u → -Real.log u ≤ 1 / u - 1 := by
      intro u hu
      have := Real.log_le_sub_one_of_pos (inv_pos.mpr hu)
      rw [Real.log_inv] at this
      rw [one_div]
      linarith
    have htpos : 0 < Real.sqrt s := Real.sqrt_pos.mpr hs
    have hlt : Real.log s = 2 * Real.log (Real.sqrt s) := by
      rw [Real.log_sqrt hs.le]; ring
    rw [habs]
    constructor
    · have e1 : s * (1 / s) = 1 := by field_simp
      have e2 := mul_le_mul_of_nonneg_left (hinv s hs) hs.le
      nlinarith
    · rw [hlt]
      have e1 : Real.sqrt s * (1 / Real.sqrt s) = 1 := by field_simp
      have e2 := mul_le_mul_of_nonneg_left (hinv _ htpos) htpos.le
      nlinarith
  
  have hsub : ∀ (f g : E2 → ℝ) (V : Set E2), IsOpen V →
      ContDiffOn ℝ 2 f V → ContDiffOn ℝ 2 g V → ∀ x ∈ V,
      lap2 h (fun y => f y - g y) x = lap2 h f x - lap2 h g x := by
    intro f g V hV hf hg x hx
    have hdf : ∀ y ∈ V, DifferentiableAt ℝ f y := fun y hy =>
      (hf.contDiffAt (hV.mem_nhds hy)).differentiableAt two_ne_zero
    have hdg : ∀ y ∈ V, DifferentiableAt ℝ g y := fun y hy =>
      (hg.contDiffAt (hV.mem_nhds hy)).differentiableAt two_ne_zero
    have hf1 : ContDiffOn ℝ 1 (fderiv ℝ f) V := hf.fderiv_of_isOpen hV (by norm_num)
    have hg1 : ContDiffOn ℝ 1 (fderiv ℝ g) V := hg.fderiv_of_isOpen hV (by norm_num)
    have hdf' : DifferentiableAt ℝ (fderiv ℝ f) x :=
      (hf1.contDiffAt (hV.mem_nhds hx)).differentiableAt one_ne_zero
    have hdg' : DifferentiableAt ℝ (fderiv ℝ g) x :=
      (hg1.contDiffAt (hV.mem_nhds hx)).differentiableAt one_ne_zero
    have hp1 : ∀ y ∈ V, ∀ k : Fin 2, pd2 k (fun y => f y - g y) y = pd2 k f y - pd2 k g y := by
      intro y hy k
      unfold pd2
      rw [fderiv_fun_sub (hdf y hy) (hdg y hy)]
      rfl
    have hp2 : ∀ i k : Fin 2, pd2 i (pd2 k (fun y => f y - g y)) x =
        pd2 i (pd2 k f) x - pd2 i (pd2 k g) x := by
      intro i k
      have hev : pd2 k (fun y => f y - g y) =ᶠ[𝓝 x] fun y => pd2 k f y - pd2 k g y :=
        Filter.eventually_of_mem (hV.mem_nhds hx) (fun y hy => hp1 y hy k)
      have hA : DifferentiableAt ℝ (pd2 k f) x := hdf'.clm_apply (differentiableAt_const _)
      have hB : DifferentiableAt ℝ (pd2 k g) x := hdg'.clm_apply (differentiableAt_const _)
      show fderiv ℝ (pd2 k (fun y => f y - g y)) x (e2 i) =
        fderiv ℝ (pd2 k f) x (e2 i) - fderiv ℝ (pd2 k g) x (e2 i)
      rw [hev.fderiv_eq, fderiv_fun_sub hA hB]
      rfl
    unfold lap2
    simp only [Fin.sum_univ_two, hp2, hp1 x hx]
    ring
  
  have hΩo : IsOpen (Metric.ball x₀ σ \ {x₀}) := Metric.isOpen_ball.sdiff isClosed_singleton
  have hΩmem : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → x ∈ Metric.ball x₀ σ \ {x₀} := by
    intro x h1 h2
    refine ⟨Metric.mem_ball.mpr h2, ?_⟩
    intro he
    rw [Set.mem_singleton_iff] at he
    rw [he, dist_self] at h1
    exact lt_irrefl _ h1
  have hΩW : Metric.ball x₀ σ \ {x₀} ⊆ W := fun y hy =>
    hball (Metric.ball_subset_closedBall hy.1)
  have hΩd : ∀ y ∈ Metric.ball x₀ σ \ {x₀}, 0 < dist y x₀ ∧ dist y x₀ < σ := fun y hy =>
    ⟨dist_pos.mpr hy.2, Metric.mem_ball.mp hy.1⟩
  have hDpos : ∀ y ∈ Metric.ball x₀ σ \ {x₀}, 0 < D y := by
    intro y hy
    obtain ⟨h1, h2⟩ := hΩd y hy
    obtain ⟨J1, -⟩ := hjet y h1 h2
    have : 0 < c₀ * dist y x₀ ^ 2 := by positivity
    linarith
  have hQpos : ∀ y ∈ Metric.ball x₀ σ \ {x₀}, 0 < pcgbPxQuad (h x₀) x₀ y := by
    intro y hy
    obtain ⟨h1, -⟩ := hΩd y hy
    have : 0 < l * dist y x₀ ^ 2 := by positivity
    linarith [hlQ y]
  
  obtain ⟨hGs, hγs, B, hB0, hBb⟩ := pcgb_px_coeff_bounds W hW h hh hpd x₀ σ hσ hball
  have hGd : ∀ y ∈ W, ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) y :=
    fun y hy i j => ((hGs i j).contDiffAt (hW.mem_nhds hy)).differentiableAt (by simp)
  have hγd : ∀ y ∈ W, ∀ k : Fin 2, DifferentiableAt ℝ
      (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) y :=
    fun y hy k => ((hγs k).contDiffAt (hW.mem_nhds hy)).differentiableAt (by simp)
  
  have hDd : ∀ y : E2, DifferentiableAt ℝ D y := fun y =>
    hD.contDiffAt.differentiableAt (by simp)
  have hQd : ∀ y : E2, DifferentiableAt ℝ (pcgbPxQuad (h x₀) x₀) y := fun y =>
    hQs.contDiffAt.differentiableAt (by simp)
  have hmd : ∀ y : E2, DifferentiableAt ℝ (pcgbPxQuad M x₀) y := fun y =>
    hms.contDiffAt.differentiableAt (by simp)
  have hLD : ContDiffOn ℝ ∞ (lap2 h D) (Metric.ball x₀ σ \ {x₀}) :=
    hlap D _ hΩo hΩW hD.contDiffOn
  have hf₁d : ∀ y ∈ Metric.ball x₀ σ \ {x₀},
      DifferentiableAt ℝ (fun y => lap2 h D y - 4 - pcgbPxQuad M x₀ y) y := fun y hy =>
    ((((hLD.contDiffAt (hΩo.mem_nhds hy)).differentiableAt (by simp)).sub_const 4)).fun_sub
      (hmd y)
  have hpdD : ∀ (a : Fin 2) (y : E2), DifferentiableAt ℝ (pd2 a D) y := fun a y =>
    ((hD.fderiv_right (m := ∞) le_rfl).contDiffAt.differentiableAt (by simp)).clm_apply
      (differentiableAt_const _)
  have hεd : ∀ y ∈ W, DifferentiableAt ℝ (pcgbPxEik h D) y := by
    intro y hy
    unfold pcgbPxEik
    refine DifferentiableAt.fun_sub ?_ ((hDd y).const_mul 4)
    refine DifferentiableAt.fun_sum (fun a _ => DifferentiableAt.fun_sum (fun c _ => ?_))
    exact ((hGd y hy a c).fun_mul (hpdD a y)).fun_mul (hpdD c y)
  
  obtain ⟨CP, hCP0, hCP⟩ := pcgb_px_pole_bounds x₀ σ hσ hσ1 D (pcgbPxQuad (h x₀) x₀) hD hQs
    c₀ l Lam K hc₀ hl0 hLam0 hK (fun x h1 h2 => by
      obtain ⟨J1, J2a, J2b, J2c, -, -, -, -⟩ := hjet x h1 h2
      exact ⟨J1, hlQ x, hQle x, hDQ x, hD2Q x, J2a, J2b, J2c⟩)
  
  obtain ⟨CR, hCR0, hCR⟩ := pcgb_px_quotient_bounds x₀ σ hσ hσ1 D (pcgbPxQuad (h x₀) x₀)
    (pcgbPxQuad M x₀) (fun y => lap2 h D y - 4 - pcgbPxQuad M x₀ y) (pcgbPxEik h D)
    c₀ l Lam K hc₀ hl0 hLam0 hK (fun x h1 h2 => by
      obtain ⟨J1, J2a, J2b, -, J3a, J3b, J4a, J4b⟩ := hjet x h1 h2
      have hxΩ := hΩmem x h1 h2
      exact ⟨hDd x, hQd x, hmd x, hf₁d x hxΩ, hεd x (hΩW hxΩ), J1, hlQ x, hQle x, hDQ x,
        hmle x, hDm x, J2a, J2b, J3a, J3b, J4a, J4b⟩)
  
  obtain ⟨Rf, hRf⟩ : ∃ R : E2 → ℝ, R = fun y =>
      (lap2 h D y - 4 - pcgbPxQuad M x₀ y) / (2 * D y) -
        pcgbPxQuad M x₀ y * (D y - pcgbPxQuad (h x₀) x₀ y) / (2 * D y * pcgbPxQuad (h x₀) x₀ y) -
        pcgbPxEik h D y / (2 * D y ^ 2) := ⟨_, rfl⟩
  obtain ⟨Tf, hTf⟩ : ∃ T : E2 → ℝ, T = fun y => lap2 h (pcgbPxPsi (h x₀) M x₀) y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j (pcgbPxPsi (h x₀) M x₀)) y :=
    ⟨_, rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ F : E2 → ℝ, F = fun y =>
      (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)) := ⟨_, rfl⟩
  
  have alg : ∀ LD S Lψ P mm q d μ : ℝ, d ≠ 0 → q ≠ 0 → P = (mm - μ * q) / (2 * q) →
      LD / (2 * d) - S / (2 * d ^ 2) - Lψ = μ / 2 + ((LD - 4 - mm) / (2 * d) -
        mm * (d - q) / (2 * d * q) - (S - 4 * d) / (2 * d ^ 2) - (Lψ - P)) := by
    intro LD S Lψ P mm q d μ hd hq hP
    subst hP
    field_simp
    ring
  have hΛfun : Λ₀ = fun z => (1 / 2 : ℝ) * Real.log (D z) - pcgbPxPsi (h x₀) M x₀ z :=
    funext hΛ₀
  have hf2 : ContDiffOn ℝ 2 (fun y => (1 / 2 : ℝ) * Real.log (D y)) (Metric.ball x₀ σ \ {x₀}) :=
    (contDiffOn_const.mul (hD.contDiffOn.log (fun y hy => (hDpos y hy).ne'))).of_le
      (WithTop.coe_le_coe.mpr le_top)
  have hg2 : ContDiffOn ℝ 2 (pcgbPxPsi (h x₀) M x₀) (Metric.ball x₀ σ \ {x₀}) :=
    (hψs.mono (fun y hy => hy.2)).of_le (WithTop.coe_le_coe.mpr le_top)
  have hstar : ∀ y ∈ Metric.ball x₀ σ \ {x₀},
      lap2 h Λ₀ y = pcgbPxMu (h x₀) M / 2 + (Rf y - Tf y) := by
    intro y hy
    obtain ⟨hy1, hy2⟩ := hΩd y hy
    obtain ⟨ψ1, -⟩ := hψ y hy1 (lt_of_lt_of_le hy2 hσ1)
    rw [hΛfun, hsub _ _ _ hΩo hf2 hg2 y hy, hid y hy1 hy2, hRf, hTf]
    exact alg (lap2 h D y) (∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a D y * pd2 c D y)
      (lap2 h (pcgbPxPsi (h x₀) M x₀) y) _ (pcgbPxQuad M x₀ y) (pcgbPxQuad (h x₀) x₀ y) (D y)
      (pcgbPxMu (h x₀) M) (hDpos y hy).ne' (hQpos y hy).ne' ψ1
  
  have hΦs : ContDiffOn ℝ ∞ Φ (Metric.ball x₀ σ \ {x₀}) := by
    rw [hΦ]
    exact (contDiffOn_const.mul (hD.contDiffOn.log (fun y hy => (hDpos y hy).ne'))).sub
      ((hQs.contDiffOn.sqrt (fun y hy => (hQpos y hy).ne')).log
        (fun y hy => (Real.sqrt_pos.mpr (hQpos y hy)).ne'))
  have hΦ1 : ContDiffOn ℝ ∞ (fderiv ℝ Φ) (Metric.ball x₀ σ \ {x₀}) :=
    hΦs.fderiv_of_isOpen hΩo le_rfl
  have hψ1s : ContDiffOn ℝ ∞ (fderiv ℝ (pcgbPxPsi (h x₀) M x₀)) {x | x ≠ x₀} :=
    hψs.fderiv_of_isOpen isOpen_ne le_rfl
  have hΦd : ∀ y ∈ Metric.ball x₀ σ \ {x₀}, DifferentiableAt ℝ Φ y := fun y hy =>
    (hΦs.contDiffAt (hΩo.mem_nhds hy)).differentiableAt (by simp)
  have hψd : ∀ y : E2, y ≠ x₀ → DifferentiableAt ℝ (pcgbPxPsi (h x₀) M x₀) y := fun y hy =>
    (hψs.contDiffAt (isOpen_ne.mem_nhds hy)).differentiableAt (by simp)
  have hpole_fun : (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) =
      fun y => Φ y - pcgbPxPsi (h x₀) M x₀ y := by
    funext y
    simp only [hΦ, hΛ₀]
    ring
  
  have hBK : 0 ≤ B * Kψ := mul_nonneg hB0 hKψ
  have hsSH := Real.sqrt_nonneg SH
  have hPK : 0 ≤ (CP + Kψ) * Real.sqrt SH := mul_nonneg (add_nonneg hCP0 hKψ) hsSH
  refine ⟨pcgbPxMu (h x₀) M / 2, CP + Kψ + (CP + Kψ) * Real.sqrt SH + CR + 24 * B * Kψ,
    by nlinarith, ?_⟩
  intro x h1 h2
  have hxne : x ≠ x₀ := dist_pos.mp h1
  have hdne : dist x x₀ ≠ 0 := h1.ne'
  have hxΩ := hΩmem x h1 h2
  have hxW := hΩW hxΩ
  have hxcb : x ∈ Metric.closedBall x₀ σ := Metric.mem_closedBall.mpr h2.le
  have hs1 : dist x x₀ < 1 := lt_of_lt_of_le h2 hσ1
  obtain ⟨-, ψ2, ψ3, ψ4, ψ5⟩ := hψ x h1 hs1
  obtain ⟨hw1, hw2⟩ := hlw (dist x x₀) h1 hs1.le
  have hL0 : 0 ≤ 1 + |Real.log (dist x x₀)| := by positivity
  have hsq0 : 0 < Real.sqrt (dist x x₀) := Real.sqrt_pos.mpr h1
  have hsq1 : Real.sqrt (dist x x₀) ≤ 1 := by
    have := Real.sqrt_le_sqrt hs1.le
    rwa [Real.sqrt_one] at this
  have hmss := Real.mul_self_sqrt h1.le
  have hss : dist x x₀ ≤ Real.sqrt (dist x x₀) := by nlinarith
  have hsL : dist x x₀ * (1 + |Real.log (dist x x₀)|) ≤ 2 * Real.sqrt (dist x x₀) := by
    have e : dist x x₀ * (1 + |Real.log (dist x x₀)|) =
        Real.sqrt (dist x x₀) * (Real.sqrt (dist x x₀) * (1 + |Real.log (dist x x₀)|)) := by
      rw [← mul_assoc, hmss]
    rw [e]
    nlinarith [mul_le_mul_of_nonneg_left hw2 hsq0.le]
  have hsL0 : 0 ≤ dist x x₀ * (1 + |Real.log (dist x x₀)|) := mul_nonneg h1.le hL0
  
  have hRx : DifferentiableAt ℝ Rf x ∧ |Rf x| ≤ CR * dist x x₀ ∧ ‖fderiv ℝ Rf x‖ ≤ CR := by
    rw [hRf]; exact hCR x h1 h2
  have hTx : DifferentiableAt ℝ Tf x ∧
      |Tf x| ≤ 4 * B * dist x x₀ * (Kψ * (1 + |Real.log (dist x x₀)|)) +
        2 * B * (Kψ * dist x x₀ * (1 + |Real.log (dist x x₀)|)) ∧
      ‖fderiv ℝ Tf x‖ ≤ 4 * B * (Kψ * (1 + |Real.log (dist x x₀)|) +
        dist x x₀ * (Kψ / dist x x₀)) +
        2 * B * (Kψ * dist x x₀ * (1 + |Real.log (dist x x₀)|) +
          Kψ * (1 + |Real.log (dist x x₀)|)) := by
    rw [hTf]
    exact pcgb_px_T_bounds h x₀ x {y | y ≠ x₀} isOpen_ne hxne (pcgbPxPsi (h x₀) M x₀) hψs B
      _ _ _ (fun i j => hGd x hxW i j) (fun k => hγd x hxW k) (hBb x hxcb) ψ3 ψ4 ψ5
  obtain ⟨hRd, hRv, hRg⟩ := hRx
  obtain ⟨hTd, hTv, hTg⟩ := hTx
  have hPx : |Φ x| ≤ CP ∧ ‖fderiv ℝ Φ x‖ ≤ CP ∧ ‖fderiv ℝ (fderiv ℝ Φ) x‖ ≤ CP / dist x x₀ := by
    rw [hΦ]; exact hCP x h1 h2
  obtain ⟨hP1, hP2, hP3⟩ := hPx
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · 
    rw [hstar x hxΩ]
    have e : pcgbPxMu (h x₀) M / 2 + (Rf x - Tf x) - pcgbPxMu (h x₀) M / 2 = Rf x - Tf x := by
      ring
    rw [e]
    calc |Rf x - Tf x| ≤ |Rf x| + |Tf x| := abs_sub _ _
      _ ≤ CR * dist x x₀ + (4 * B * dist x x₀ * (Kψ * (1 + |Real.log (dist x x₀)|)) +
          2 * B * (Kψ * dist x x₀ * (1 + |Real.log (dist x x₀)|))) := add_le_add hRv hTv
      _ ≤ (CP + Kψ + (CP + Kψ) * Real.sqrt SH + CR + 24 * B * Kψ) * Real.sqrt (dist x x₀) := by
        nlinarith [mul_le_mul_of_nonneg_left hss hCR0, mul_le_mul_of_nonneg_left hsL hBK,
          mul_nonneg (add_nonneg (add_nonneg (add_nonneg hCP0 hKψ) hPK) hBK) hsq0.le]
  · 
    have hev : lap2 h Λ₀ =ᶠ[𝓝 x] fun y => pcgbPxMu (h x₀) M / 2 + (Rf y - Tf y) :=
      Filter.eventually_of_mem (hΩo.mem_nhds hxΩ) hstar
    rw [hev.fderiv_eq, fderiv_const_add, fderiv_fun_sub hRd hTd, le_div_iff₀ hsq0]
    have hda : dist x x₀ * (Kψ / dist x x₀) = Kψ := by field_simp
    rw [hda] at hTg
    have hq1 : Real.sqrt (dist x x₀) * (dist x x₀ * (1 + |Real.log (dist x x₀)|)) ≤ 1 := by
      nlinarith [mul_le_mul_of_nonneg_right hsq1 hsL0]
    calc ‖fderiv ℝ Rf x - fderiv ℝ Tf x‖ * Real.sqrt (dist x x₀)
        ≤ (CR + (4 * B * (Kψ * (1 + |Real.log (dist x x₀)|) + Kψ) +
          2 * B * (Kψ * dist x x₀ * (1 + |Real.log (dist x x₀)|) +
            Kψ * (1 + |Real.log (dist x x₀)|)))) * Real.sqrt (dist x x₀) :=
          mul_le_mul_of_nonneg_right ((norm_sub_le _ _).trans (add_le_add hRg hTg)) hsq0.le
      _ ≤ CP + Kψ + (CP + Kψ) * Real.sqrt SH + CR + 24 * B * Kψ := by
        nlinarith [mul_le_mul_of_nonneg_left hsq1 hCR0, mul_le_mul_of_nonneg_left hw2 hBK,
          mul_le_mul_of_nonneg_left hsq1 hBK, mul_le_mul_of_nonneg_left hq1 hBK]
  · 
    rw [hΛ₀]
    have hP1' : |(1 / 2 : ℝ) * Real.log (D x) - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))|
        ≤ CP := by
      have := hP1; rw [hΦ] at this; exact this
    have e : (1 / 2 : ℝ) * Real.log (D x) - pcgbPxPsi (h x₀) M x₀ x -
        Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x)) =
        ((1 / 2 : ℝ) * Real.log (D x) - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))) -
          pcgbPxPsi (h x₀) M x₀ x := by ring
    rw [e]
    have hd2 : dist x x₀ ^ 2 * (1 + |Real.log (dist x x₀)|) ≤ 1 := by
      nlinarith [mul_le_mul_of_nonneg_left hw1 h1.le]
    have hk := mul_le_mul_of_nonneg_left hd2 hKψ
    calc _ ≤ |(1 / 2 : ℝ) * Real.log (D x) - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))| +
          |pcgbPxPsi (h x₀) M x₀ x| := abs_sub _ _
      _ ≤ CP + Kψ * dist x x₀ ^ 2 * (1 + |Real.log (dist x x₀)|) := add_le_add hP1' ψ2
      _ ≤ _ := by nlinarith
  · 
    rw [hpole_fun, fderiv_fun_sub (hΦd x hxΩ) (hψd x hxne)]
    have hk := mul_le_mul_of_nonneg_left hw1 hKψ
    calc _ ≤ ‖fderiv ℝ Φ x‖ + ‖fderiv ℝ (pcgbPxPsi (h x₀) M x₀) x‖ := norm_sub_le _ _
      _ ≤ CP + Kψ * dist x x₀ * (1 + |Real.log (dist x x₀)|) := add_le_add hP2 ψ3
      _ ≤ _ := by nlinarith
  · 
    have hev2 : fderiv ℝ (fun y => Φ y - pcgbPxPsi (h x₀) M x₀ y) =ᶠ[𝓝 x]
        fun y => fderiv ℝ Φ y - fderiv ℝ (pcgbPxPsi (h x₀) M x₀) y :=
      Filter.eventually_of_mem (hΩo.mem_nhds hxΩ)
        (fun y hy => fderiv_fun_sub (hΦd y hy) (hψd y hy.2))
    have hΦ2d : DifferentiableAt ℝ (fderiv ℝ Φ) x :=
      (hΦ1.contDiffAt (hΩo.mem_nhds hxΩ)).differentiableAt (by simp)
    have hψ2d : DifferentiableAt ℝ (fderiv ℝ (pcgbPxPsi (h x₀) M x₀)) x :=
      (hψ1s.contDiffAt (isOpen_ne.mem_nhds hxne)).differentiableAt (by simp)
    have hQx : 0 < Real.sqrt (pcgbPxQuad (h x₀) x₀ x) := Real.sqrt_pos.mpr (hQpos x hxΩ)
    rw [hpole_fun, hev2.fderiv_eq, fderiv_fun_sub hΦ2d hψ2d, le_div_iff₀ hQx]
    have hsqQ : Real.sqrt (pcgbPxQuad (h x₀) x₀ x) ≤ Real.sqrt SH * dist x x₀ := by
      calc Real.sqrt (pcgbPxQuad (h x₀) x₀ x) ≤ Real.sqrt (SH * dist x x₀ ^ 2) :=
            Real.sqrt_le_sqrt ((le_abs_self _).trans (hQb x).1)
        _ = Real.sqrt SH * dist x x₀ := by rw [Real.sqrt_mul hSH0, Real.sqrt_sq h1.le]
    have hk := mul_le_mul_of_nonneg_left hw1 hKψ
    have hn : ‖fderiv ℝ (fderiv ℝ Φ) x - fderiv ℝ (fderiv ℝ (pcgbPxPsi (h x₀) M x₀)) x‖ ≤
        CP / dist x x₀ + Kψ * (1 + |Real.log (dist x x₀)|) :=
      (norm_sub_le (fderiv ℝ (fderiv ℝ Φ) x)
        (fderiv ℝ (fderiv ℝ (pcgbPxPsi (h x₀) M x₀)) x)).trans (add_le_add hP3 ψ4)
    calc ‖fderiv ℝ (fderiv ℝ Φ) x - fderiv ℝ (fderiv ℝ (pcgbPxPsi (h x₀) M x₀)) x‖ *
          Real.sqrt (pcgbPxQuad (h x₀) x₀ x)
        ≤ (CP / dist x x₀ + Kψ * (1 + |Real.log (dist x x₀)|)) *
          (Real.sqrt SH * dist x x₀) :=
          mul_le_mul hn hsqQ (Real.sqrt_nonneg _)
            (add_nonneg (div_nonneg hCP0 h1.le) (mul_nonneg hKψ hL0))
      _ = Real.sqrt SH * (CP + Kψ * (dist x x₀ * (1 + |Real.log (dist x x₀)|))) := by
          field_simp
      _ ≤ Real.sqrt SH * (CP + Kψ) :=
          mul_le_mul_of_nonneg_left (by nlinarith) hsSH
      _ ≤ _ := by nlinarith

theorem pcgb_chart_parametrix (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ (Λ F : E2 → ℝ) (ρ C K : ℝ), 0 < ρ ∧ ρ ≤ R₀ ∧ 0 ≤ C ∧ 0 ≤ K ∧
      ContDiffOn ℝ ∞ Λ (W \ {x₀}) ∧ ContDiffOn ℝ ∞ F (W \ {x₀}) ∧
      (∀ x : E2, ρ ≤ dist x x₀ → Λ x = 0 ∧ F x = 0) ∧
      (∀ x ∈ W, x ≠ x₀ → lap2 h Λ x = -F x) ∧
      (∀ x y : E2, |F x - F y| ≤ K * dist x y ^ (1 / 2 : ℝ)) ∧
      ContDiffOn ℝ ∞ (fun y => Λ y - Real.log (Real.sqrt
        (∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c)))
        (Metric.ball x₀ ρ \ {x₀}) ∧
      ∀ x ∈ Metric.ball x₀ ρ, x ≠ x₀ →
        |Λ x - Real.log (Real.sqrt
          (∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (x - x₀) a * (x - x₀) c))| ≤ C ∧
        ‖fderiv ℝ (fun y => Λ y - Real.log (Real.sqrt
          (∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c))) x‖ ≤ C ∧
        ‖fderiv ℝ (fderiv ℝ (fun y => Λ y - Real.log (Real.sqrt
          (∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c)))) x‖ ≤
          C / Real.sqrt (∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (x - x₀) a * (x - x₀) c) :=
by
  classical
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  obtain ⟨D, M, σ, c₀, K₁, hσ, hσR, hσ1, hc₀, hK₁, hMs, hDs, hjet⟩ :=
    pcgb_parametrix_jet W hW h hh hpd x₀ R₀ hR₀ hball
  obtain ⟨hψs, Kψ, hKψ, hψ⟩ := pcgb_log_quad_correction (h x₀) M hH hMs x₀
  have hballσ : Metric.closedBall x₀ σ ⊆ W :=
    (Metric.closedBall_subset_closedBall hσR).trans hball
  have hΩo : IsOpen (Metric.ball x₀ σ \ {x₀}) := Metric.isOpen_ball.sdiff isClosed_singleton
  have hΩmem : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → x ∈ Metric.ball x₀ σ \ {x₀} := by
    intro x h1 h2
    refine ⟨Metric.mem_ball.mpr h2, ?_⟩
    intro he
    rw [Set.mem_singleton_iff] at he
    rw [he, dist_self] at h1
    exact lt_irrefl _ h1
  have hDpos : ∀ x ∈ Metric.ball x₀ σ \ {x₀}, 0 < D x := by
    intro x hx
    have h2 : dist x x₀ < σ := Metric.mem_ball.mp hx.1
    have hne : x ≠ x₀ := hx.2
    have h1 : 0 < dist x x₀ := dist_pos.mpr hne
    have h3 := (hjet x h1 h2).1
    have h4 : 0 < c₀ * dist x x₀ ^ 2 := by positivity
    linarith
  have hD2 : ContDiffOn ℝ 2 D (Metric.ball x₀ σ \ {x₀}) :=
    hDs.contDiffOn.of_le (WithTop.coe_le_coe.mpr le_top)
  have hid : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (D y)) x =
        lap2 h D x / (2 * D x) -
          (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a D x * pd2 c D x) / (2 * D x ^ 2) :=
    fun x h1 h2 => pcgb_lap2_half_log _ hΩo h D hD2 hDpos x (hΩmem x h1 h2)
  have hlap : ∀ (u : E2 → ℝ) (V : Set E2), IsOpen V → V ⊆ W → ContDiffOn ℝ ∞ u V →
      ContDiffOn ℝ ∞ (lap2 h u) V :=
    fun u V hV hVW hu => pcgb_lap2_contDiffOn V hV h (fun a c => (hh a c).mono hVW)
      (fun x hx => hpd x (hVW hx)) u hu
  obtain ⟨Λ₀, hΛ₀⟩ : ∃ f : E2 → ℝ,
      f = fun y => (1 / 2 : ℝ) * Real.log (D y) - pcgbPxPsi (h x₀) M x₀ y := ⟨_, rfl⟩
  obtain ⟨cst, K', hK', hcore⟩ := pcgb_parametrix_estimate_core W hW h hh hpd x₀ σ hσ hσ1
    hballσ D M hMs c₀ K₁ Kψ hc₀ hK₁ hKψ hlap hDs hψs hjet hψ hid Λ₀ (fun y => by rw [hΛ₀])
  have hΛ₀s : ContDiffOn ℝ ∞ Λ₀ (Metric.ball x₀ σ \ {x₀}) := by
    rw [hΛ₀]
    exact (contDiffOn_const.mul (hDs.contDiffOn.log (fun x hx => (hDpos x hx).ne'))).sub
      (hψs.mono (fun x hx => hx.2))
  
  obtain ⟨ρ, hρdef⟩ : ∃ ρ : ℝ, ρ = min R₀ σ / 2 := ⟨_, rfl⟩
  have hmin0 : 0 < min R₀ σ := lt_min hR₀ hσ
  have hρ0 : 0 < ρ := by rw [hρdef]; exact half_pos hmin0
  have hρR : ρ ≤ R₀ := by have := min_le_left R₀ σ; rw [hρdef]; linarith
  have hρσ : ρ < σ := by have := min_le_right R₀ σ; rw [hρdef]; linarith
  have hdc : Continuous fun y : E2 => dist y x₀ := continuous_id.dist continuous_const
  obtain ⟨χ, hχdef⟩ : ∃ χ : E2 → ℝ, χ = fun x =>
      Real.smoothTransition ((9 * ρ ^ 2 - 16 * ‖x - x₀‖ ^ 2) / (5 * ρ ^ 2)) := ⟨_, rfl⟩
  have hχs : ContDiff ℝ ∞ χ := by
    rw [hχdef]
    exact (Real.smoothTransition.contDiff (n := ⊤)).comp
      ((contDiff_const.sub (contDiff_const.mul
        ((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)))).div_const _)
  have hχ0 : ∀ x : E2, 3 * ρ / 4 ≤ dist x x₀ → χ x = 0 := by
    intro x hx
    rw [hχdef]
    show Real.smoothTransition ((9 * ρ ^ 2 - 16 * ‖x - x₀‖ ^ 2) / (5 * ρ ^ 2)) = 0
    apply Real.smoothTransition.zero_of_nonpos
    refine div_nonpos_of_nonpos_of_nonneg ?_ (by positivity)
    rw [← dist_eq_norm]
    have h4 : 3 * ρ ≤ 4 * dist x x₀ := by linarith
    nlinarith [mul_self_le_mul_self (by positivity : (0:ℝ) ≤ 3 * ρ) h4]
  have hχ1 : ∀ x : E2, dist x x₀ ≤ ρ / 2 → χ x = 1 := by
    intro x hx
    rw [hχdef]
    show Real.smoothTransition ((9 * ρ ^ 2 - 16 * ‖x - x₀‖ ^ 2) / (5 * ρ ^ 2)) = 1
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ (by positivity), ← dist_eq_norm]
    have h0 : 0 ≤ dist x x₀ := dist_nonneg
    nlinarith [mul_self_le_mul_self h0 hx]
  
  obtain ⟨Λ, hΛdef⟩ : ∃ Λ : E2 → ℝ, Λ = fun x => χ x * Λ₀ x := ⟨_, rfl⟩
  have hΛ0 : ∀ x : E2, 3 * ρ / 4 ≤ dist x x₀ → Λ x = 0 := by
    intro x hx
    rw [hΛdef]
    simp only [hχ0 x hx, zero_mul]
  have hfar_open : IsOpen {y : E2 | 3 * ρ / 4 < dist y x₀} := isOpen_lt continuous_const hdc
  have hΛs : ContDiffOn ℝ ∞ Λ {x₀}ᶜ := by
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    rcases lt_or_ge (dist x x₀) σ with hxs | hxs
    · refine ⟨Metric.ball x₀ σ \ {x₀}, hΩo, ⟨Metric.mem_ball.mpr hxs, hx⟩, ?_⟩
      rw [hΛdef]
      exact ((hχs.contDiffOn).mul hΛ₀s).mono Set.inter_subset_right
    · refine ⟨{y : E2 | 3 * ρ / 4 < dist y x₀}, hfar_open, ?_, ?_⟩
      · show 3 * ρ / 4 < dist x x₀
        linarith
      · refine (contDiffOn_const (c := (0:ℝ))).congr ?_
        intro y hy
        exact hΛ0 y hy.2.le
  
  have hgerm : ∀ (u v : E2 → ℝ) (x : E2), u =ᶠ[𝓝 x] v → lap2 h u x = lap2 h v x := by
    intro u v x huv
    have h1 : ∀ k : Fin 2, pd2 k u x = pd2 k v x := by
      intro k
      show fderiv ℝ u x (e2 k) = fderiv ℝ v x (e2 k)
      rw [huv.fderiv_eq]
    have h2 : ∀ i j : Fin 2, pd2 i (pd2 j u) x = pd2 i (pd2 j v) x := by
      intro i j
      have hev : pd2 j u =ᶠ[𝓝 x] pd2 j v := by
        filter_upwards [huv.eventuallyEq_nhds] with y hy
        show fderiv ℝ u y (e2 j) = fderiv ℝ v y (e2 j)
        rw [hy.fderiv_eq]
      show fderiv ℝ (pd2 j u) x (e2 i) = fderiv ℝ (pd2 j v) x (e2 i)
      rw [hev.fderiv_eq]
    unfold lap2
    simp only [h1, h2]
  have hz : ∀ j : Fin 2, pd2 j (fun _ : E2 => (0:ℝ)) = fun _ => 0 := by
    intro j
    funext y
    simp [pd2]
  have hlap0 : ∀ x : E2, lap2 h (fun _ => (0:ℝ)) x = 0 := fun x => by
    simp only [lap2, hz]
    simp [pd2]
  have hlapfar : ∀ x : E2, 3 * ρ / 4 < dist x x₀ → lap2 h Λ x = 0 := by
    intro x hx
    rw [hgerm Λ (fun _ => (0:ℝ)) x ?_, hlap0]
    filter_upwards [hfar_open.mem_nhds hx] with y hy
    exact hΛ0 y (le_of_lt hy)
  have hWo : IsOpen (W \ {x₀}) := hW.sdiff isClosed_singleton
  have hLs : ContDiffOn ℝ ∞ (lap2 h Λ) {x₀}ᶜ := by
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    by_cases hxW : x ∈ W
    · refine ⟨W \ {x₀}, hWo, ⟨hxW, hx⟩, ?_⟩
      exact (hlap Λ (W \ {x₀}) hWo Set.diff_subset
        (hΛs.mono (fun y hy => hy.2))).mono Set.inter_subset_right
    · have hxR : R₀ < dist x x₀ := by
        by_contra hc
        push_neg at hc
        exact hxW (hball (Metric.mem_closedBall.mpr hc))
      refine ⟨{y : E2 | 3 * ρ / 4 < dist y x₀}, hfar_open, ?_, ?_⟩
      · show 3 * ρ / 4 < dist x x₀
        linarith
      · exact (contDiffOn_const (c := (0:ℝ))).congr (fun y hy => hlapfar y hy.2)
  
  obtain ⟨F, hFdef⟩ : ∃ F : E2 → ℝ, F = fun x => if x = x₀ then -cst else -lap2 h Λ x :=
    ⟨_, rfl⟩
  have hFx : ∀ x : E2, x ≠ x₀ → F x = -lap2 h Λ x := by
    intro x hx
    rw [hFdef]
    simp only [if_neg hx]
  have hFx₀ : F x₀ = -cst := by
    rw [hFdef]
    simp
  have hFeqO : ∀ x : E2, x ≠ x₀ → F =ᶠ[𝓝 x] fun y => -lap2 h Λ y := by
    intro x hx
    filter_upwards [isOpen_compl_singleton.mem_nhds hx] with y hy
    exact hFx y hy
  have hFs : ContDiffOn ℝ ∞ F {x₀}ᶜ := hLs.neg.congr (fun y hy => hFx y hy)
  have hnear : ∀ x : E2, dist x x₀ < ρ / 2 → Λ =ᶠ[𝓝 x] Λ₀ := by
    intro x hx
    filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball.mpr hx)] with y hy
    rw [hΛdef]
    simp only [hχ1 y (Metric.mem_ball.mp hy).le, one_mul]
  have hnearL : ∀ x : E2, dist x x₀ < ρ / 2 → lap2 h Λ =ᶠ[𝓝 x] lap2 h Λ₀ := by
    intro x hx
    filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball.mpr hx)] with y hy
    exact hgerm Λ Λ₀ y (hnear y (Metric.mem_ball.mp hy))
  
  have hA : IsCompact {y : E2 | ρ / 2 ≤ dist y x₀ ∧ dist y x₀ ≤ ρ} := by
    refine (isCompact_closedBall x₀ ρ).of_isClosed_subset ?_ ?_
    · exact (isClosed_le continuous_const hdc).inter (isClosed_le hdc continuous_const)
    · intro y hy
      exact Metric.mem_closedBall.mpr hy.2
  have hAO : {y : E2 | ρ / 2 ≤ dist y x₀ ∧ dist y x₀ ≤ ρ} ⊆ {x₀}ᶜ := by
    intro y hy he
    rw [Set.mem_singleton_iff] at he
    have h1 := hy.1
    rw [he, dist_self] at h1
    linarith
  obtain ⟨B₀, hB₀⟩ := hA.exists_bound_of_continuousOn (hFs.continuousOn.mono hAO)
  obtain ⟨B₁, hB₁⟩ := hA.exists_bound_of_continuousOn
    ((hFs.continuousOn_fderiv_of_isOpen isOpen_compl_singleton (by simp)).mono hAO)
  obtain ⟨KF, hKFdef⟩ : ∃ KF : ℝ,
      KF = K' + |B₁| * Real.sqrt ρ + (|B₀| + |cst|) / Real.sqrt (ρ / 2) := ⟨_, rfl⟩
  have hsρ2 : 0 < Real.sqrt (ρ / 2) := Real.sqrt_pos.mpr (by linarith)
  have hT1 : 0 ≤ |B₁| * Real.sqrt ρ := by positivity
  have hT2 : 0 ≤ (|B₀| + |cst|) / Real.sqrt (ρ / 2) := by positivity
  have hKF0 : 0 ≤ KF := by rw [hKFdef]; linarith
  have hK'KF : K' ≤ KF := by rw [hKFdef]; linarith
  have hB₁KF : |B₁| * Real.sqrt ρ ≤ KF := by rw [hKFdef]; linarith
  have hB₀KF : (|B₀| + |cst|) / Real.sqrt (ρ / 2) ≤ KF := by rw [hKFdef]; linarith
  
  have hgrad : ∀ x : E2, x ≠ x₀ → ‖fderiv ℝ F x‖ ≤ KF / Real.sqrt (dist x x₀) := by
    intro x hne
    have hd0 : 0 < dist x x₀ := dist_pos.mpr hne
    have hsd : 0 < Real.sqrt (dist x x₀) := Real.sqrt_pos.mpr hd0
    rcases lt_or_ge (dist x x₀) (ρ / 2) with hd | hd
    · have e1 : fderiv ℝ F x = -fderiv ℝ (lap2 h Λ₀) x := by
        rw [(hFeqO x hne).fderiv_eq, fderiv_fun_neg, (hnearL x hd).fderiv_eq]
      rw [e1, norm_neg]
      have hdσ : dist x x₀ < σ := by linarith
      exact ((hcore x hd0 hdσ).2.1).trans (div_le_div_of_nonneg_right hK'KF hsd.le)
    · rcases le_or_gt (dist x x₀) ρ with hd' | hd'
      · have hb := hB₁ x ⟨hd, hd'⟩
        rw [le_div_iff₀ hsd]
        calc ‖fderiv ℝ F x‖ * Real.sqrt (dist x x₀) ≤ |B₁| * Real.sqrt ρ :=
              mul_le_mul (hb.trans (le_abs_self _)) (Real.sqrt_le_sqrt hd') hsd.le
                (abs_nonneg _)
          _ ≤ KF := hB₁KF
      · have hev : F =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          filter_upwards [hfar_open.mem_nhds (show 3 * ρ / 4 < dist x x₀ by linarith)]
            with y hy
          have hy' : 3 * ρ / 4 < dist y x₀ := hy
          have hyne : y ≠ x₀ := by
            intro he
            rw [he, dist_self] at hy'
            linarith
          rw [hFx y hyne, hlapfar y hy', neg_zero]
        rw [hev.fderiv_eq, fderiv_const_apply, norm_zero]
        exact div_nonneg hKF0 hsd.le
  
  have hval : ∀ x : E2, |F x - F x₀| ≤ KF * Real.sqrt (dist x x₀) := by
    intro x
    by_cases hne : x = x₀
    · rw [hne, sub_self, abs_zero]
      exact mul_nonneg hKF0 (Real.sqrt_nonneg _)
    have hd0 : 0 < dist x x₀ := dist_pos.mpr hne
    rw [hFx₀]
    rcases lt_or_ge (dist x x₀) (ρ / 2) with hd | hd
    · have hdσ : dist x x₀ < σ := by linarith
      rw [hFx x hne, (hnearL x hd).eq_of_nhds]
      have hc := (hcore x hd0 hdσ).1
      calc |-lap2 h Λ₀ x - -cst| = |lap2 h Λ₀ x - cst| := by
            rw [show -lap2 h Λ₀ x - -cst = -(lap2 h Λ₀ x - cst) by ring, abs_neg]
        _ ≤ K' * Real.sqrt (dist x x₀) := hc
        _ ≤ KF * Real.sqrt (dist x x₀) :=
            mul_le_mul_of_nonneg_right hK'KF (Real.sqrt_nonneg _)
    · have hFb : |F x| ≤ |B₀| := by
        rcases le_or_gt (dist x x₀) ρ with hd' | hd'
        · have hb := hB₀ x ⟨hd, hd'⟩
          rw [Real.norm_eq_abs] at hb
          exact hb.trans (le_abs_self _)
        · rw [hFx x hne, hlapfar x (by linarith), neg_zero, abs_zero]
          exact abs_nonneg _
      have hs2 : Real.sqrt (ρ / 2) ≤ Real.sqrt (dist x x₀) := Real.sqrt_le_sqrt hd
      calc |F x - -cst| ≤ |F x| + |cst| := by
            rw [sub_neg_eq_add]
            exact abs_add_le _ _
        _ ≤ |B₀| + |cst| := by linarith
        _ = (|B₀| + |cst|) / Real.sqrt (ρ / 2) * Real.sqrt (ρ / 2) := by
            rw [div_mul_cancel₀ _ hsρ2.ne']
        _ ≤ (|B₀| + |cst|) / Real.sqrt (ρ / 2) * Real.sqrt (dist x x₀) :=
            mul_le_mul_of_nonneg_left hs2 hT2
        _ ≤ KF * Real.sqrt (dist x x₀) :=
            mul_le_mul_of_nonneg_right hB₀KF (Real.sqrt_nonneg _)
  have hhold := pcgb_holder_half_of_grad F x₀ KF hKF0
    (fun x hx => (hFs.contDiffAt (isOpen_compl_singleton.mem_nhds hx)).differentiableAt
      (by simp))
    hgrad hval
  
  have hcoord : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := fun a =>
    (EuclideanSpace.proj a : E2 →L[ℝ] ℝ).contDiff.comp (contDiff_id.sub contDiff_const)
  have hQs : ContDiff ℝ ∞ (pcgbPxQuad (h x₀) x₀) := by
    show ContDiff ℝ ∞ (fun y : E2 => ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c)
    exact ContDiff.sum fun a _ => ContDiff.sum fun c _ =>
      (contDiff_const.mul (hcoord a)).mul (hcoord c)
  have hQpos : ∀ y : E2, y ≠ x₀ → 0 < pcgbPxQuad (h x₀) x₀ y := by
    intro y hy
    show 0 < ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c
    have hv0 : (fun a => (y - x₀) a : Fin 2 → ℝ) ≠ 0 := by
      intro h0
      apply hy
      rw [← sub_eq_zero]
      ext a
      simpa using congrFun h0 a
    have hpd' := hH.dotProduct_mulVec_pos hv0
    have hform : star (fun a => (y - x₀) a : Fin 2 → ℝ) ⬝ᵥ
        (h x₀).mulVec (fun a => (y - x₀) a) =
        ∑ a : Fin 2, ∑ c : Fin 2, h x₀ a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
      ring
    rw [← hform]
    exact hpd'
  have hlogs : ContDiffOn ℝ ∞ (fun y => Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)))
      {x₀}ᶜ :=
    (hQs.contDiffOn.sqrt (fun y hy => (hQpos y hy).ne')).log
      (fun y hy => (Real.sqrt_pos.mpr (hQpos y hy)).ne')
  have hΦs : ContDiffOn ℝ ∞
      (fun y => Λ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) {x₀}ᶜ :=
    hΛs.sub hlogs
  have hΦ1 : ContDiffOn ℝ ∞
      (fderiv ℝ (fun y => Λ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)))) {x₀}ᶜ :=
    hΦs.fderiv_of_isOpen isOpen_compl_singleton le_rfl
  obtain ⟨B₂, hB₂⟩ := hA.exists_bound_of_continuousOn (hΦs.continuousOn.mono hAO)
  obtain ⟨B₃, hB₃⟩ := hA.exists_bound_of_continuousOn (hΦ1.continuousOn.mono hAO)
  obtain ⟨B₄, hB₄⟩ := hA.exists_bound_of_continuousOn
    ((hΦ1.continuousOn_fderiv_of_isOpen isOpen_compl_singleton (by simp)).mono hAO)
  obtain ⟨mQ, hmQ⟩ := hA.exists_bound_of_continuousOn hQs.continuous.continuousOn
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = K' + |B₂| + |B₃| + |B₄| * Real.sqrt |mQ| := ⟨_, rfl⟩
  have hT3 : 0 ≤ |B₄| * Real.sqrt |mQ| := by positivity
  have hT4 := abs_nonneg B₂
  have hT5 := abs_nonneg B₃
  have hC0 : 0 ≤ C := by rw [hCdef]; linarith
  have hCK : K' ≤ C := by rw [hCdef]; linarith
  have hCB₂ : |B₂| ≤ C := by rw [hCdef]; linarith
  have hCB₃ : |B₃| ≤ C := by rw [hCdef]; linarith
  have hCB₄ : |B₄| * Real.sqrt |mQ| ≤ C := by rw [hCdef]; linarith
  have hpole : ∀ x ∈ Metric.ball x₀ ρ, x ≠ x₀ →
      |Λ x - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))| ≤ C ∧
      ‖fderiv ℝ (fun y => Λ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) x‖ ≤ C ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => Λ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)))) x‖ ≤
        C / Real.sqrt (pcgbPxQuad (h x₀) x₀ x) := by
    intro x hx hne
    have hd0 : 0 < dist x x₀ := dist_pos.mpr hne
    have hdρ : dist x x₀ < ρ := Metric.mem_ball.mp hx
    have hQx : 0 < Real.sqrt (pcgbPxQuad (h x₀) x₀ x) := Real.sqrt_pos.mpr (hQpos x hne)
    rcases lt_or_ge (dist x x₀) (ρ / 2) with hd | hd
    · have hdσ : dist x x₀ < σ := by linarith
      obtain ⟨-, -, e0, e1, e2⟩ := hcore x hd0 hdσ
      have hev : (fun y => Λ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) =ᶠ[𝓝 x]
          (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) := by
        filter_upwards [hnear x hd] with y hy
        rw [hy]
      refine ⟨?_, ?_, ?_⟩
      · rw [show Λ x = Λ₀ x from (hnear x hd).eq_of_nhds]
        exact e0.trans hCK
      · rw [hev.fderiv_eq]
        exact e1.trans hCK
      · rw [hev.fderiv.fderiv_eq]
        exact e2.trans (div_le_div_of_nonneg_right hCK hQx.le)
    · have hxA : x ∈ {y : E2 | ρ / 2 ≤ dist y x₀ ∧ dist y x₀ ≤ ρ} := ⟨hd, hdρ.le⟩
      have hb2 := hB₂ x hxA
      have hb3 := hB₃ x hxA
      have hb4 := hB₄ x hxA
      have hq := hmQ x hxA
      rw [Real.norm_eq_abs] at hb2 hq
      refine ⟨?_, ?_, ?_⟩
      · exact hb2.trans ((le_abs_self _).trans hCB₂)
      · exact hb3.trans ((le_abs_self _).trans hCB₃)
      · rw [le_div_iff₀ hQx]
        have hsq : Real.sqrt (pcgbPxQuad (h x₀) x₀ x) ≤ Real.sqrt |mQ| :=
          Real.sqrt_le_sqrt ((le_abs_self _).trans (hq.trans (le_abs_self _)))
        calc _ ≤ |B₄| * Real.sqrt |mQ| :=
              mul_le_mul (hb4.trans (le_abs_self _)) hsq hQx.le (abs_nonneg _)
          _ ≤ C := hCB₄
  refine ⟨Λ, F, ρ, C, 3 * KF, hρ0, hρR, hC0, by linarith, hΛs.mono (fun y hy => hy.2),
    hFs.mono (fun y hy => hy.2), ?_, ?_, hhold, hΦs.mono (fun y hy => hy.2), hpole⟩
  · intro x hx
    have hx' : 3 * ρ / 4 < dist x x₀ := by linarith
    have hne : x ≠ x₀ := by
      intro he
      rw [he, dist_self] at hx
      linarith
    exact ⟨hΛ0 x hx'.le, by rw [hFx x hne, hlapfar x hx', neg_zero]⟩
  · intro x _ hne
    rw [hFx x hne, neg_neg]

theorem pcgb_chart_transport {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (P : EigPatchedSurface X S) (j₀ : Fin P.n) (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ)
    (hball : Metric.closedBall x₀ ρ ⊆ P.W j₀) (G : E2 → ℝ)
    (hG0 : ∀ x : E2, ρ ≤ dist x x₀ → G x = 0)
    (hGs : ContDiffOn ℝ ∞ G (P.W j₀ \ {x₀})) :
    (∀ x ∈ P.W j₀, pcgbTransport P j₀ G (P.param j₀ x) = G x) ∧
    (∀ j, ContDiffOn ℝ ∞ (fun x => pcgbTransport P j₀ G (P.param j x))
      (P.W j ∩ P.param j ⁻¹' {P.param j₀ x₀}ᶜ)) ∧
    (∀ K : ℝ, (∀ x y : E2, |G x - G y| ≤ K * dist x y ^ (1 / 2 : ℝ)) → ∀ j, ∀ x ∈ P.W j,
      ∃ δ K' : ℝ, 0 < δ ∧ Metric.ball x δ ⊆ P.W j ∧
        ∀ y ∈ Metric.ball x δ, ∀ z ∈ Metric.ball x δ,
          |pcgbTransport P j₀ G (P.param j y) - pcgbTransport P j₀ G (P.param j z)| ≤
            K' * dist y z ^ (1 / 2 : ℝ)) ∧
    (∀ j, ∀ x ∈ P.W j, P.param j x ≠ P.param j₀ x₀ →
      lap2 (P.h j) (fun y => pcgbTransport P j₀ G (P.param j y)) x =
        pcgbTransport P j₀ (lap2 (P.h j₀) G) (P.param j x)) ∧
    (∀ q, q ∉ P.param j₀ '' Metric.closedBall x₀ ρ → pcgbTransport P j₀ G q = 0) :=
by
  classical
  
  
  
  
  have chr : ∀ (A B : Set E2) (hA : IsOpen A) (hB : IsOpen B) (τ : E2 → E2)
      (hτ : ContDiffOn ℝ ∞ τ A) (hτAB : ∀ x ∈ A, τ x ∈ B)
      (h h' : E2 → Matrix (Fin 2) (Fin 2) ℝ)
      (hh' : ∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h' y c d) B)
      (hpd' : ∀ y ∈ B, (h' y).PosDef) (hpd : ∀ x ∈ A, (h x).PosDef)
      (hcomp : ∀ x ∈ A, ∀ c d : Fin 2, h x c d = ∑ c' : Fin 2, ∑ d' : Fin 2,
        fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d' * fderiv ℝ τ x (e2 d) d')
      (x : E2) (hx : x ∈ A) (m b c : Fin 2),
      ∑ e : Fin 2, fderiv ℝ τ x (e2 e) m * christoffel2 h e b c x =
        ∑ p : Fin 2, ∑ q : Fin 2,
            christoffel2 h' m p q (τ x) * fderiv ℝ τ x (e2 b) p * fderiv ℝ τ x (e2 c) q +
          fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 b) m := by
    intro A B hA hB τ hτ hτAB h h' hh' hpd' hpd hcomp x hx m b c
    have alg : ∀ (J : Fin 2 → Fin 2 → ℝ) (g hm : Matrix (Fin 2) (Fin 2) ℝ)
        (D T dH : Fin 2 → Fin 2 → Fin 2 → ℝ),
        (∀ p q : Fin 2, g p q = g q p) →
        (∀ m b c : Fin 2, T m b c = T m c b) →
        (∀ c d : Fin 2, hm c d = ∑ c' : Fin 2, ∑ d' : Fin 2, J c' c * g c' d' * J d' d) →
        hm.det ≠ 0 →
        (∀ i c d : Fin 2, dH i c d = ∑ c' : Fin 2, ∑ d' : Fin 2,
          (T c' i c * g c' d' * J d' d + J c' c * (∑ r : Fin 2, D r c' d' * J r i) * J d' d +
            J c' c * g c' d' * T d' i d)) →
        ∀ m b c : Fin 2,
        ∑ e : Fin 2, J m e * ((1 / 2 : ℝ) * ∑ l : Fin 2, hm⁻¹ e l * (dH b c l + dH c b l - dH l b c)) =
          ∑ p : Fin 2, ∑ q : Fin 2,
              ((1 / 2 : ℝ) * ∑ l : Fin 2, g⁻¹ m l * (D p q l + D q p l - D l p q)) * J p b * J q c +
            T m b c := by
      intro J g hm D T dH hg hT hhm hdet hdH m b c
      have hA : ∀ l : Fin 2, dH b c l + dH c b l - dH l b c = ∑ q : Fin 2, J q l *
          (2 * ∑ p : Fin 2, g q p * T p b c +
            ∑ p : Fin 2, ∑ r : Fin 2, (D p r q + D r p q - D q p r) * J p b * J r c) := by
        intro l
        have hT1 : ∀ x, T x c b = T x b c := fun x => hT x c b
        have hT2 : ∀ x, T x l b = T x b l := fun x => hT x l b
        have hT3 : ∀ x, T x l c = T x c l := fun x => hT x l c
        have hg10 : g 1 0 = g 0 1 := hg 1 0
        simp only [hdH, Fin.sum_univ_two, hT1, hT2, hT3, hg10]
        ring
      set Jm : Matrix (Fin 2) (Fin 2) ℝ := Matrix.of J with hJm
      have hhm' : hm = Jm.transpose * g * Jm := by
        ext i j
        rw [hhm i j]
        simp only [hJm, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_two]
        ring
      have hdet' : hm.det = Jm.det * g.det * Jm.det := by
        rw [hhm', Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      have hJdet : Jm.det ≠ 0 := by
        intro h0; apply hdet; rw [hdet', h0]; ring
      have hgdet : g.det ≠ 0 := by
        intro h0; apply hdet; rw [hdet', h0]; ring
      have hJu : IsUnit Jm.det := isUnit_iff_ne_zero.mpr hJdet
      have hJtu : IsUnit Jm.transpose.det := by rw [Matrix.det_transpose]; exact hJu
      have hgu : IsUnit g.det := isUnit_iff_ne_zero.mpr hgdet
      have hraiseM : Jm * hm⁻¹ * Jm.transpose = g⁻¹ := by
        rw [hhm', Matrix.mul_inv_rev, Matrix.mul_inv_rev]
        calc Jm * (Jm⁻¹ * (g⁻¹ * Jm.transpose⁻¹)) * Jm.transpose
            = (Jm * Jm⁻¹) * g⁻¹ * (Jm.transpose⁻¹ * Jm.transpose) := by simp only [Matrix.mul_assoc]
          _ = g⁻¹ := by
            rw [Matrix.mul_nonsing_inv _ hJu, Matrix.nonsing_inv_mul _ hJtu, Matrix.one_mul,
              Matrix.mul_one]
      have hB : ∀ q : Fin 2, ∑ e : Fin 2, ∑ l : Fin 2, J m e * hm⁻¹ e l * J q l = g⁻¹ m q := by
        intro q
        have := congrFun (congrFun hraiseM m) q
        rw [← this]
        simp only [hJm, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_two]
        ring
      have hC : ∑ p : Fin 2, (∑ q : Fin 2, g⁻¹ m q * g q p) * T p b c = T m b c := by
        have h1 : ∀ p : Fin 2, ∑ q : Fin 2, g⁻¹ m q * g q p = (1 : Matrix (Fin 2) (Fin 2) ℝ) m p := by
          intro p
          rw [← Matrix.nonsing_inv_mul g hgu, Matrix.mul_apply]
        simp only [h1, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq,
          Finset.mem_univ, if_true]
      have key : ∀ U : Fin 2 → ℝ, (∀ l : Fin 2, dH b c l + dH c b l - dH l b c =
          ∑ q : Fin 2, J q l * U q) → ∑ e : Fin 2, J m e * ((1 / 2 : ℝ) * ∑ l : Fin 2, hm⁻¹ e l *
          (dH b c l + dH c b l - dH l b c)) = (1 / 2 : ℝ) * ∑ q : Fin 2, g⁻¹ m q * U q := by
        intro U hU
        simp only [hU]
        have hB0 := hB 0
        have hB1 := hB 1
        simp only [Fin.sum_univ_two] at hB0 hB1 ⊢
        linear_combination (1 / 2 * U 0) * hB0 + (1 / 2 * U 1) * hB1
      rw [key (fun q => 2 * ∑ p : Fin 2, g q p * T p b c +
            ∑ p : Fin 2, ∑ r : Fin 2, (D p r q + D r p q - D q p r) * J p b * J r c) hA, ← hC]
      simp only [Fin.sum_univ_two]
      ring
    have schwarz : ∀ m b c : Fin 2,
        fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 b) m =
          fderiv ℝ (fun y => fderiv ℝ τ y (e2 b)) x (e2 c) m := by
      intro m b c
      have hτx : ContDiffAt ℝ ∞ τ x := hτ.contDiffAt (hA.mem_nhds hx)
      have hD : DifferentiableAt ℝ (fderiv ℝ τ) x :=
        (hτx.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)
      have hrw : ∀ u : E2, fderiv ℝ (fun y => fderiv ℝ τ y u) x =
          (fderiv ℝ (fderiv ℝ τ) x).flip u := by
        intro u
        rw [fderiv_clm_apply hD (differentiableAt_const u)]
        simp
      have hsym := hτx.isSymmSndFDerivAt (by
        rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
      rw [hrw, hrw]
      simp only [ContinuousLinearMap.flip_apply]
      rw [hsym.eq]
    have pull : ∀ i c d : Fin 2,
        pd2 i (fun y => h y c d) x = ∑ c' : Fin 2, ∑ d' : Fin 2,
          (fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 i) c' * h' (τ x) c' d' *
              fderiv ℝ τ x (e2 d) d' +
            fderiv ℝ τ x (e2 c) c' *
              (∑ r : Fin 2, pd2 r (fun y => h' y c' d') (τ x) * fderiv ℝ τ x (e2 i) r) *
              fderiv ℝ τ x (e2 d) d' +
            fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d' *
              fderiv ℝ (fun y => fderiv ℝ τ y (e2 d)) x (e2 i) d') := by
      intro i c d
      have hτx : ContDiffAt ℝ ∞ τ x := hτ.contDiffAt (hA.mem_nhds hx)
      have hτd : DifferentiableAt ℝ τ x := hτx.differentiableAt (by simp)
      have hD : DifferentiableAt ℝ (fderiv ℝ τ) x :=
        (hτx.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)
      have ha : ∀ (u : E2) (k : Fin 2), HasFDerivAt (fun y => fderiv ℝ τ y u k)
          ((EuclideanSpace.proj k : E2 →L[ℝ] ℝ).comp (fderiv ℝ (fun y => fderiv ℝ τ y u) x)) x := by
        intro u k
        have h1 : DifferentiableAt ℝ (fun y => fderiv ℝ τ y u) x :=
          hD.clm_apply (differentiableAt_const u)
        exact (EuclideanSpace.proj k : E2 →L[ℝ] ℝ).hasFDerivAt.comp x h1.hasFDerivAt
      have hb : ∀ p q : Fin 2, HasFDerivAt (fun y => h' (τ y) p q)
          ((fderiv ℝ (fun z => h' z p q) (τ x)).comp (fderiv ℝ τ x)) x := by
        intro p q
        have h1 : DifferentiableAt ℝ (fun z => h' z p q) (τ x) :=
          ((hh' p q).contDiffAt (hB.mem_nhds (hτAB x hx))).differentiableAt (by simp)
        exact h1.hasFDerivAt.comp x hτd.hasFDerivAt
      have hΦ : HasFDerivAt (fun y => ∑ c' : Fin 2, ∑ d' : Fin 2,
          fderiv ℝ τ y (e2 c) c' * h' (τ y) c' d' * fderiv ℝ τ y (e2 d) d')
          (∑ c' : Fin 2, ∑ d' : Fin 2,
            ((fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d') •
                (EuclideanSpace.proj d' : E2 →L[ℝ] ℝ).comp
                  (fderiv ℝ (fun y => fderiv ℝ τ y (e2 d)) x) +
              fderiv ℝ τ x (e2 d) d' •
                (fderiv ℝ τ x (e2 c) c' •
                    (fderiv ℝ (fun z => h' z c' d') (τ x)).comp (fderiv ℝ τ x) +
                  h' (τ x) c' d' •
                    (EuclideanSpace.proj c' : E2 →L[ℝ] ℝ).comp
                      (fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x)))) x := by
        apply HasFDerivAt.fun_sum
        intro c' _
        apply HasFDerivAt.fun_sum
        intro d' _
        exact ((ha (e2 c) c').mul (hb c' d')).mul (ha (e2 d) d')
      have hev : (fun y => h y c d) =ᶠ[𝓝 x] (fun y => ∑ c' : Fin 2, ∑ d' : Fin 2,
          fderiv ℝ τ y (e2 c) c' * h' (τ y) c' d' * fderiv ℝ τ y (e2 d) d') :=
        Filter.eventually_of_mem (hA.mem_nhds hx) (fun y hy => hcomp y hy c d)
      have hexp : ∀ v : E2, v = v 0 • e2 0 + v 1 • e2 1 := by
        intro v
        ext k
        fin_cases k <;> simp [EuclideanSpace.single_apply]
      have hp : ∀ (k : Fin 2) (v : E2), (EuclideanSpace.proj k : E2 →L[ℝ] ℝ) v = v k :=
        fun _ _ => rfl
      unfold pd2
      rw [hev.fderiv_eq, hΦ.fderiv]
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply, smul_eq_mul]
      have hv := hexp (fderiv ℝ τ x (e2 i))
      have hlin : ∀ p q : Fin 2, fderiv ℝ (fun z => h' z p q) (τ x) (fderiv ℝ τ x (e2 i)) =
          ∑ r : Fin 2, fderiv ℝ (fun z => h' z p q) (τ x) (e2 r) * fderiv ℝ τ x (e2 i) r := by
        intro p q
        conv_lhs => rw [hv]
        rw [map_add, map_smul, map_smul, Fin.sum_univ_two, smul_eq_mul, smul_eq_mul]
        ring
      simp only [hlin]
      refine Finset.sum_congr rfl (fun c' _ => Finset.sum_congr rfl (fun d' _ => ?_))
      simp only [hp]
      ring
    have hg : ∀ p q : Fin 2, h' (τ x) p q = h' (τ x) q p := by
      intro p q
      have h1 := (hpd' (τ x) (hτAB x hx)).isHermitian.apply p q
      simp only [star_trivial] at h1
      exact h1.symm
    have key := alg (fun p b => fderiv ℝ τ x (e2 b) p) (h' (τ x)) (h x)
      (fun r p q => pd2 r (fun y => h' y p q) (τ x))
      (fun m b c => fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 b) m)
      (fun i c d => pd2 i (fun y => h y c d) x)
      hg schwarz (hcomp x hx) (hpd x hx).det_pos.ne' pull m b c
    unfold christoffel2
    exact key
  
  
  
  have lapcongr : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (f g : E2 → ℝ) (x : E2),
      f =ᶠ[𝓝 x] g → lap2 h f x = lap2 h g x := by
    intro h f g x hfg
    have h1 : ∀ k, pd2 k f x = pd2 k g x := fun k => by
      unfold pd2; rw [hfg.fderiv_eq]
    have h2 : ∀ j, pd2 j f =ᶠ[𝓝 x] pd2 j g := fun j =>
      hfg.fderiv.mono (fun y hy => by unfold pd2; rw [hy])
    have h3 : ∀ i j, pd2 i (pd2 j f) x = pd2 i (pd2 j g) x := fun i j => by
      show fderiv ℝ (pd2 j f) x (e2 i) = fderiv ℝ (pd2 j g) x (e2 i)
      rw [(h2 j).fderiv_eq]
    unfold lap2
    simp only [h1, h3]
  have lapzero : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2),
      lap2 h (fun _ => (0 : ℝ)) x = 0 := by
    intro h x
    have hz : ∀ k, pd2 k (fun _ : E2 => (0 : ℝ)) = fun _ => 0 := by
      intro k; funext y; simp [pd2]
    unfold lap2
    simp [hz]
  
  
  
  have chain : ∀ (A B : Set E2), IsOpen A → IsOpen B → ∀ (τ : E2 → E2), ContDiffOn ℝ ∞ τ A →
      (∀ x ∈ A, τ x ∈ B) → ∀ (F : E2 → ℝ), ContDiffOn ℝ ∞ F B → ∀ x ∈ A,
      (∀ b : Fin 2, pd2 b (fun y => F (τ y)) x =
        ∑ p : Fin 2, pd2 p F (τ x) * fderiv ℝ τ x (e2 b) p) ∧
      ∀ a b : Fin 2, pd2 a (pd2 b (fun y => F (τ y))) x =
        ∑ p : Fin 2, ∑ q : Fin 2,
            pd2 p (pd2 q F) (τ x) * fderiv ℝ τ x (e2 a) p * fderiv ℝ τ x (e2 b) q +
          ∑ m : Fin 2, pd2 m F (τ x) * fderiv ℝ (fun y => fderiv ℝ τ y (e2 b)) x (e2 a) m := by
    intro A B hA hB τ hτ hτAB F hF x hx
    have hexp : ∀ (ℓ : E2 →L[ℝ] ℝ) (v : E2), ℓ v = ∑ c : Fin 2, v c * ℓ (e2 c) := by
      intro ℓ v
      have hv : v = ∑ c : Fin 2, v c • e2 c := by
        ext k
        fin_cases k <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply]
      conv_lhs => rw [hv]
      rw [map_sum]
      simp only [map_smul, smul_eq_mul]
    have hfirst : ∀ (w' : E2 → ℝ) (x0 : E2), DifferentiableAt ℝ w' (τ x0) →
        DifferentiableAt ℝ τ x0 → ∀ j : Fin 2,
        pd2 j (fun x' => w' (τ x')) x0 =
          ∑ c : Fin 2, pd2 c w' (τ x0) * (fderiv ℝ τ x0 (e2 j)) c := by
      intro w' x0 hw' hF' j
      show fderiv ℝ (fun x' => w' (τ x')) x0 (e2 j) = _
      rw [fderiv_comp' x0 hw' hF', ContinuousLinearMap.comp_apply, hexp]
      refine Finset.sum_congr rfl (fun c _ => ?_)
      rw [mul_comm]
      rfl
    have hFd : ∀ x' ∈ A, DifferentiableAt ℝ τ x' := fun x' hx' =>
      (hτ.differentiableOn (by simp)).differentiableAt (hA.mem_nhds hx')
    have hwd : ∀ x' ∈ A, DifferentiableAt ℝ F (τ x') := fun x' hx' =>
      (hF.differentiableOn (by simp)).differentiableAt (hB.mem_nhds (hτAB x' hx'))
    have hwfd : ContDiffOn ℝ ∞ (fderiv ℝ F) B :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hB).1 hF).2
    have hFfd : ContDiffOn ℝ ∞ (fderiv ℝ τ) A :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hA).1 hτ).2
    have hPd : ∀ c : Fin 2, DifferentiableAt ℝ (pd2 c F) (τ x) := by
      intro c
      have h : ContDiffOn ℝ ∞ (fun z => fderiv ℝ F z (e2 c)) B := hwfd.clm_apply contDiffOn_const
      exact (h.differentiableOn (by simp)).differentiableAt (hB.mem_nhds (hτAB x hx))
    have hDx : DifferentiableAt ℝ (fderiv ℝ τ) x :=
      (hFfd.differentiableOn (by simp)).differentiableAt (hA.mem_nhds hx)
    have hDd : ∀ (j : Fin 2) (c : Fin 2),
        DifferentiableAt ℝ (fun x' => (fderiv ℝ τ x' (e2 j)) c) x := by
      intro j c
      let Λ : (E2 →L[ℝ] E2) →L[ℝ] ℝ :=
        (EuclideanSpace.proj c).comp (ContinuousLinearMap.apply ℝ E2 (e2 j))
      have hfun : (fun x' => (fderiv ℝ τ x' (e2 j)) c) = Λ ∘ fderiv ℝ τ := rfl
      rw [hfun]
      exact Λ.differentiableAt.comp x hDx
    have hcol : ∀ (i : Fin 2) (u : E2) (k : Fin 2), pd2 i (fun y => fderiv ℝ τ y u k) x =
        fderiv ℝ (fun y => fderiv ℝ τ y u) x (e2 i) k := by
      intro i u k
      have h1 : DifferentiableAt ℝ (fun y => fderiv ℝ τ y u) x :=
        hDx.clm_apply (differentiableAt_const u)
      have h2 : HasFDerivAt (fun y => fderiv ℝ τ y u k)
          ((EuclideanSpace.proj k : E2 →L[ℝ] ℝ).comp (fderiv ℝ (fun y => fderiv ℝ τ y u) x)) x :=
        (EuclideanSpace.proj k : E2 →L[ℝ] ℝ).hasFDerivAt.comp x h1.hasFDerivAt
      unfold pd2
      rw [h2.fderiv]
      rfl
    refine ⟨fun j => hfirst F x (hwd x hx) (hFd x hx) j, ?_⟩
    intro i j
    have hev : pd2 j (fun x'' => F (τ x'')) =ᶠ[𝓝 x]
        fun x' => ∑ c : Fin 2, pd2 c F (τ x') * (fderiv ℝ τ x' (e2 j)) c :=
      Filter.eventually_of_mem (hA.mem_nhds hx)
        (fun x' hx' => hfirst F x' (hwd x' hx') (hFd x' hx') j)
    show fderiv ℝ (pd2 j (fun x'' => F (τ x''))) x (e2 i) = _
    rw [hev.fderiv_eq]
    have hPx : ∀ c : Fin 2, DifferentiableAt ℝ (fun x' => pd2 c F (τ x')) x :=
      fun c => (hPd c).comp x (hFd x hx)
    rw [fderiv_fun_sum (u := Finset.univ)
      (A := fun c x' => pd2 c F (τ x') * (fderiv ℝ τ x' (e2 j)) c)
      (fun c _ => (hPx c).fun_mul (hDd j c))]
    simp only [ContinuousLinearMap.sum_apply]
    have hterm : ∀ c : Fin 2,
        fderiv ℝ (fun x' => pd2 c F (τ x') * (fderiv ℝ τ x' (e2 j)) c) x (e2 i)
          = pd2 c F (τ x) * pd2 i (fun x' => (fderiv ℝ τ x' (e2 j)) c) x
            + (fderiv ℝ τ x (e2 j)) c *
              ∑ a : Fin 2, pd2 a (pd2 c F) (τ x) * (fderiv ℝ τ x (e2 i)) a := by
      intro c
      rw [fderiv_fun_mul (hPx c) (hDd j c)]
      rw [← hfirst (pd2 c F) x (hPd c) (hFd x hx) i]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rfl
    simp only [hterm, hcol]
    simp only [Fin.sum_univ_two]
    ring
  
  
  
  have alg2 : ∀ (D : Fin 2 → Fin 2 → ℝ) (hm hm' : Matrix (Fin 2) (Fin 2) ℝ)
      (H' : Fin 2 → Fin 2 → ℝ) (Γ Γ' S' : Fin 2 → Fin 2 → Fin 2 → ℝ) (g : Fin 2 → ℝ),
      hm.det ≠ 0 →
      (∀ a b : Fin 2, hm a b = ∑ c : Fin 2, ∑ d : Fin 2, D a c * hm' c d * D b d) →
      (∀ m b c : Fin 2, ∑ e : Fin 2, D e m * Γ e b c =
        ∑ p : Fin 2, ∑ q : Fin 2, Γ' m p q * D b p * D c q + S' m b c) →
      ∑ a : Fin 2, ∑ b : Fin 2, hm⁻¹ a b *
        ((∑ p : Fin 2, ∑ q : Fin 2, H' p q * D a p * D b q + ∑ m : Fin 2, g m * S' m a b) -
          ∑ k : Fin 2, Γ k a b * ∑ p : Fin 2, g p * D k p) =
      ∑ i : Fin 2, ∑ j : Fin 2, hm'⁻¹ i j * (H' i j - ∑ k : Fin 2, Γ' k i j * g k) := by
    intro D hm hm' H' Γ Γ' S' g hdet hcomp hchr
    set Dm : Matrix (Fin 2) (Fin 2) ℝ := Matrix.of D with hDm
    have hm_eq : hm = Dm * hm' * Dm.transpose := by
      ext a b
      rw [hcomp a b]
      simp only [hDm, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_two]
      ring
    have hdet' : hm.det = Dm.det * hm'.det * Dm.det := by
      rw [hm_eq, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    have hDdet : Dm.det ≠ 0 := by
      intro h0; apply hdet; rw [hdet', h0]; ring
    have hDu : IsUnit Dm.det := isUnit_iff_ne_zero.mpr hDdet
    have hDtu : IsUnit Dm.transpose.det := by rw [Matrix.det_transpose]; exact hDu
    have hK : Dm.transpose * hm⁻¹ * Dm = hm'⁻¹ := by
      rw [hm_eq, Matrix.mul_inv_rev, Matrix.mul_inv_rev]
      calc Dm.transpose * (Dm.transpose⁻¹ * (hm'⁻¹ * Dm⁻¹)) * Dm
          = (Dm.transpose * Dm.transpose⁻¹) * hm'⁻¹ * (Dm⁻¹ * Dm) := by
            simp only [Matrix.mul_assoc]
        _ = hm'⁻¹ := by
          rw [Matrix.mul_nonsing_inv _ hDtu, Matrix.nonsing_inv_mul _ hDu, Matrix.one_mul,
            Matrix.mul_one]
    have hKe : ∀ q r : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, D a q * hm⁻¹ a b * D b r = hm'⁻¹ q r := by
      intro q r
      rw [← hK]
      simp only [hDm, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_two]
      ring
    have hbr : ∀ a b : Fin 2,
        (∑ p : Fin 2, ∑ q : Fin 2, H' p q * D a p * D b q + ∑ m : Fin 2, g m * S' m a b) -
          ∑ k : Fin 2, Γ k a b * ∑ p : Fin 2, g p * D k p =
        ∑ q : Fin 2, ∑ r : Fin 2, (H' q r - ∑ k : Fin 2, Γ' k q r * g k) * D a q * D b r := by
      intro a b
      have e0 := hchr 0 a b
      have e1 := hchr 1 a b
      simp only [Fin.sum_univ_two] at e0 e1 ⊢
      linear_combination (-g 0) * e0 + (-g 1) * e1
    simp only [hbr]
    have k00 := hKe 0 0
    have k01 := hKe 0 1
    have k10 := hKe 1 0
    have k11 := hKe 1 1
    simp only [Fin.sum_univ_two] at k00 k01 k10 k11 ⊢
    linear_combination (H' 0 0 - (Γ' 0 0 0 * g 0 + Γ' 1 0 0 * g 1)) * k00 +
      (H' 0 1 - (Γ' 0 0 1 * g 0 + Γ' 1 0 1 * g 1)) * k01 +
      (H' 1 0 - (Γ' 0 1 0 * g 0 + Γ' 1 1 0 * g 1)) * k10 +
      (H' 1 1 - (Γ' 0 1 1 * g 0 + Γ' 1 1 1 * g 1)) * k11
  
  
  
  have lapInv : ∀ (A B : Set E2), IsOpen A → IsOpen B → ∀ (τ : E2 → E2), ContDiffOn ℝ ∞ τ A →
      (∀ x ∈ A, τ x ∈ B) → ∀ (h h' : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h' y c d) B) →
      (∀ y ∈ B, (h' y).PosDef) → (∀ x ∈ A, (h x).PosDef) →
      (∀ x ∈ A, ∀ c d : Fin 2, h x c d = ∑ c' : Fin 2, ∑ d' : Fin 2,
        fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d' * fderiv ℝ τ x (e2 d) d') →
      ∀ (F : E2 → ℝ), ContDiffOn ℝ ∞ F B → ∀ x ∈ A,
      lap2 h (fun y => F (τ y)) x = lap2 h' F (τ x) := by
    intro A B hA hB τ hτ hτAB h h' hh' hpd' hpd hcomp F hF x hx
    obtain ⟨c1, c2⟩ := chain A B hA hB τ hτ hτAB F hF x hx
    have key := alg2 (fun a p => fderiv ℝ τ x (e2 a) p) (h x) (h' (τ x))
      (fun p q => pd2 p (pd2 q F) (τ x)) (fun k a b => christoffel2 h k a b x)
      (fun k i j => christoffel2 h' k i j (τ x))
      (fun m b c => fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 b) m)
      (fun p => pd2 p F (τ x)) (hpd x hx).det_pos.ne' (hcomp x hx)
      (fun m b c => chr A B hA hB τ hτ hτAB h h' hh' hpd' hpd hcomp x hx m b c)
    unfold lap2
    simp only [c1, c2]
    exact key
  
  
  
  have hBc : IsCompact (P.param j₀ '' Metric.closedBall x₀ ρ) :=
    (isCompact_closedBall x₀ ρ).image_of_continuousOn ((P.param_cont j₀).mono hball)
  have hBcl : IsClosed (P.param j₀ '' Metric.closedBall x₀ ρ) := hBc.isClosed
  have hBO : P.param j₀ '' Metric.closedBall x₀ ρ ⊆ P.O j₀ := by
    rintro q ⟨y, hy, rfl⟩
    have hm : P.param j₀ y ∈ P.param j₀ '' P.W j₀ := ⟨y, hball hy, rfl⟩
    rw [P.image_eq j₀] at hm
    exact hm.1
  have hinS : ∀ j, ∀ y ∈ P.W j, P.param j y ∈ S := by
    intro j y hy
    have hm : P.param j y ∈ P.param j '' P.W j := ⟨y, hy, rfl⟩
    rw [P.image_eq j] at hm
    exact hm.2
  have hGt : ∀ (F : E2 → ℝ) (q : X), q ∈ P.O j₀ ∩ S →
      pcgbTransport P j₀ F q = F (P.proj j₀ q) := fun F q hq => Set.indicator_of_mem hq _
  have hGt0 : ∀ (F : E2 → ℝ) (q : X), q ∉ P.O j₀ ∩ S →
      pcgbTransport P j₀ F q = 0 := fun F q hq => Set.indicator_of_notMem hq _
  have hN : ∀ j, ∀ y ∈ P.W j, P.param j y ∈ P.O j₀ →
      P.proj j₀ (P.param j y) ∈ P.W j₀ ∧
        P.param j₀ (P.proj j₀ (P.param j y)) = P.param j y := by
    intro j y hy hyO
    have hm : P.param j y ∈ P.param j₀ '' P.W j₀ := by
      rw [P.image_eq j₀]; exact ⟨hyO, hinS j y hy⟩
    obtain ⟨y', hy', hyy⟩ := hm
    rw [← hyy, P.proj_param j₀ y' hy']
    exact ⟨hy', rfl⟩
  have hNne : ∀ j, ∀ y ∈ P.W j, P.param j y ∈ P.O j₀ → P.param j y ≠ P.param j₀ x₀ →
      P.proj j₀ (P.param j y) ≠ x₀ := by
    intro j y hy hyO hne heq
    apply hne
    rw [← (hN j y hy hyO).2, heq]
  have hNopen : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' P.O j₀) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open j₀)
  have hMopen : ∀ j,
      IsOpen (P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ ρ)ᶜ) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) hBcl.isOpen_compl
  
  
  
  have T4 : ∀ q, q ∉ P.param j₀ '' Metric.closedBall x₀ ρ → pcgbTransport P j₀ G q = 0 := by
    intro q hq
    by_cases hqO : q ∈ P.O j₀ ∩ S
    · rw [hGt G q hqO]
      have hm : q ∈ P.param j₀ '' P.W j₀ := by rw [P.image_eq j₀]; exact hqO
      obtain ⟨y, hy, rfl⟩ := hm
      rw [P.proj_param j₀ y hy]
      apply hG0
      by_contra hlt
      push_neg at hlt
      exact hq ⟨y, Metric.mem_closedBall.mpr hlt.le, rfl⟩
    · exact hGt0 G q hqO
  have T0 : ∀ x ∈ P.W j₀, pcgbTransport P j₀ G (P.param j₀ x) = G x := by
    intro x hx
    have hm : P.param j₀ x ∈ P.O j₀ ∩ S := by
      rw [← P.image_eq j₀]; exact ⟨x, hx, rfl⟩
    rw [hGt G _ hm, P.proj_param j₀ x hx]
  
  
  
  have T1 : ∀ j, ContDiffOn ℝ ∞ (fun x => pcgbTransport P j₀ G (P.param j x))
      (P.W j ∩ P.param j ⁻¹' {P.param j₀ x₀}ᶜ) := by
    intro j
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    by_cases hxO : P.param j x ∈ P.O j₀
    · refine ⟨P.W j ∩ P.param j ⁻¹' P.O j₀, hNopen j, ⟨hx.1, hxO⟩, ?_⟩
      have hsm : ContDiffOn ℝ ∞ (fun y => G (P.proj j₀ (P.param j y)))
          ((P.W j ∩ P.param j ⁻¹' {P.param j₀ x₀}ᶜ) ∩ (P.W j ∩ P.param j ⁻¹' P.O j₀)) := by
        refine hGs.comp ((P.trans_smooth j j₀).mono Set.inter_subset_right) ?_
        intro y hy
        exact ⟨(hN j y hy.2.1 hy.2.2).1, hNne j y hy.2.1 hy.2.2 hy.1.2⟩
      refine hsm.congr ?_
      intro y hy
      exact hGt G _ ⟨hy.2.2, hinS j y hy.2.1⟩
    · refine ⟨P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ ρ)ᶜ, hMopen j,
        ⟨hx.1, fun hB => hxO (hBO hB)⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
      intro y hy
      exact T4 _ hy.2.2
  
  
  
  have T2 : ∀ K : ℝ, (∀ x y : E2, |G x - G y| ≤ K * dist x y ^ (1 / 2 : ℝ)) → ∀ j, ∀ x ∈ P.W j,
      ∃ δ K' : ℝ, 0 < δ ∧ Metric.ball x δ ⊆ P.W j ∧
        ∀ y ∈ Metric.ball x δ, ∀ z ∈ Metric.ball x δ,
          |pcgbTransport P j₀ G (P.param j y) - pcgbTransport P j₀ G (P.param j z)| ≤
            K' * dist y z ^ (1 / 2 : ℝ) := by
    intro K hK j x hx
    by_cases hxO : P.param j x ∈ P.O j₀
    · have hxN : x ∈ P.W j ∩ P.param j ⁻¹' P.O j₀ := ⟨hx, hxO⟩
      have hτx : ContDiffAt ℝ 1 (fun y => P.proj j₀ (P.param j y)) x :=
        ((P.trans_smooth j j₀).contDiffAt ((hNopen j).mem_nhds hxN)).of_le (by simp)
      obtain ⟨L, t, ht, hL⟩ := hτx.exists_lipschitzOnWith
      obtain ⟨δ, hδ, hδsub⟩ :=
        Metric.mem_nhds_iff.mp (Filter.inter_mem ht ((hNopen j).mem_nhds hxN))
      refine ⟨δ, |K| * (L : ℝ) ^ (1 / 2 : ℝ), hδ, fun y hy => (hδsub hy).2.1, ?_⟩
      intro y hy z hz
      have hyN := (hδsub hy).2
      have hzN := (hδsub hz).2
      rw [hGt G _ ⟨hyN.2, hinS j y hyN.1⟩, hGt G _ ⟨hzN.2, hinS j z hzN.1⟩]
      have hd : dist (P.proj j₀ (P.param j y)) (P.proj j₀ (P.param j z)) ≤ L * dist y z :=
        hL.dist_le_mul y (hδsub hy).1 z (hδsub hz).1
      have h1 := hK (P.proj j₀ (P.param j y)) (P.proj j₀ (P.param j z))
      have h2 : K * dist (P.proj j₀ (P.param j y)) (P.proj j₀ (P.param j z)) ^ (1 / 2 : ℝ) ≤
          |K| * dist (P.proj j₀ (P.param j y)) (P.proj j₀ (P.param j z)) ^ (1 / 2 : ℝ) :=
        mul_le_mul_of_nonneg_right (le_abs_self K) (Real.rpow_nonneg dist_nonneg _)
      have h3 : dist (P.proj j₀ (P.param j y)) (P.proj j₀ (P.param j z)) ^ (1 / 2 : ℝ) ≤
          ((L : ℝ) * dist y z) ^ (1 / 2 : ℝ) :=
        Real.rpow_le_rpow dist_nonneg hd (by norm_num)
      have h4 : ((L : ℝ) * dist y z) ^ (1 / 2 : ℝ) =
          (L : ℝ) ^ (1 / 2 : ℝ) * dist y z ^ (1 / 2 : ℝ) :=
        Real.mul_rpow L.coe_nonneg dist_nonneg
      calc _ ≤ _ := h1
        _ ≤ _ := h2
        _ ≤ |K| * (((L : ℝ) * dist y z) ^ (1 / 2 : ℝ)) :=
          mul_le_mul_of_nonneg_left h3 (abs_nonneg K)
        _ = |K| * (L : ℝ) ^ (1 / 2 : ℝ) * dist y z ^ (1 / 2 : ℝ) := by rw [h4]; ring
    · have hxM : x ∈ P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ ρ)ᶜ :=
        ⟨hx, fun hB => hxO (hBO hB)⟩
      obtain ⟨δ, hδ, hδsub⟩ := Metric.isOpen_iff.mp (hMopen j) x hxM
      refine ⟨δ, 0, hδ, fun y hy => (hδsub hy).1, ?_⟩
      intro y hy z hz
      rw [T4 _ (hδsub hy).2, T4 _ (hδsub hz).2]
      simp
  
  
  
  have T3 : ∀ j, ∀ x ∈ P.W j, P.param j x ≠ P.param j₀ x₀ →
      lap2 (P.h j) (fun y => pcgbTransport P j₀ G (P.param j y)) x =
        pcgbTransport P j₀ (lap2 (P.h j₀) G) (P.param j x) := by
    intro j x hx hne
    by_cases hxO : P.param j x ∈ P.O j₀
    · have hxN : x ∈ P.W j ∩ P.param j ⁻¹' P.O j₀ := ⟨hx, hxO⟩
      have hB'o : IsOpen (P.W j₀ \ {x₀}) := (P.W_open j₀).sdiff isClosed_singleton
      have hAo : IsOpen ((P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
          (fun y => P.proj j₀ (P.param j y)) ⁻¹' (P.W j₀ \ {x₀})) :=
        (P.trans_smooth j j₀).continuousOn.isOpen_inter_preimage (hNopen j) hB'o
      have hxA : x ∈ (P.W j ∩ P.param j ⁻¹' P.O j₀) ∩
          (fun y => P.proj j₀ (P.param j y)) ⁻¹' (P.W j₀ \ {x₀}) :=
        ⟨hxN, (hN j x hx hxO).1, hNne j x hx hxO hne⟩
      have hinv := lapInv _ _ hAo hB'o (fun y => P.proj j₀ (P.param j y))
        ((P.trans_smooth j j₀).mono Set.inter_subset_left)
        (fun y hy => hy.2) (P.h j) (P.h j₀)
        (fun c d => (P.h_smooth j₀ c d).mono Set.diff_subset)
        (fun y hy => P.h_posDef j₀ y hy.1) (fun y hy => P.h_posDef j y hy.1.1)
        (fun y hy c d => P.h_compat j j₀ y hy.1 c d) G hGs x hxA
      have hev : (fun y => pcgbTransport P j₀ G (P.param j y)) =ᶠ[𝓝 x]
          (fun y => G (P.proj j₀ (P.param j y))) :=
        Filter.eventually_of_mem ((hNopen j).mem_nhds hxN)
          (fun y hy => hGt G _ ⟨hy.2, hinS j y hy.1⟩)
      rw [lapcongr _ _ _ x hev, hGt _ _ ⟨hxO, hinS j x hx⟩]
      exact hinv
    · have hxM : x ∈ P.W j ∩ P.param j ⁻¹' (P.param j₀ '' Metric.closedBall x₀ ρ)ᶜ :=
        ⟨hx, fun hB => hxO (hBO hB)⟩
      have hev : (fun y => pcgbTransport P j₀ G (P.param j y)) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
        Filter.eventually_of_mem ((hMopen j).mem_nhds hxM) (fun y hy => T4 _ hy.2)
      rw [lapcongr _ _ _ x hev, lapzero, hGt0 _ _ (fun hm => hxO hm.1)]
  exact ⟨T0, T1, T2, T3, T4⟩

theorem pcgb_dp_localize {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (F : Fin P.n → E2 → ℝ) (hF : ∀ j, ContinuousOn (F j) (P.W j))
    (hFnn : ∀ j, ∀ x ∈ P.W j, 0 ≤ F j x)
    (hcompat : ∀ j i, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O i, F j x = F i (P.proj i (P.param j x)))
    (k : Fin P.n) (hFb : ∀ x ∈ P.W k, b (P.param k x) < 0 → F k x = 0)
    (L : Set E2) (hL : IsCompact L) (hLW : L ⊆ P.W k) :
    ∫ x in L, F k x * Real.sqrt (P.h k x).det ≤ eigWInt P ρ F :=
by
  classical
  have hρc : ∀ j i, ContinuousOn (fun x => ρ j (P.param i x)) (P.W i) :=
    fun j i => (hρs j i).continuousOn
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  
  have hP3 : ∀ j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j x hx
    have hq : P.param j x ∈ P.O k ∩ S := ⟨hx.2, (hP1 j x hx.1).2⟩
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, hyx⟩ := hq
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  
  have s1 : ∀ (W L : Set E2), IsOpen W → IsCompact L → L ⊆ W →
      ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
        (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) →
      ∀ (r G : E2 → ℝ), ContinuousOn r W → ContinuousOn G W →
        (∀ x ∈ W, x ∉ L → r x * G x = 0) →
      MeasureTheory.IntegrableOn (fun x => r x * G x * Real.sqrt (h x).det) W
        MeasureTheory.volume := by
    intro W L hW hL hLW h hh r G hr hG h0
    have hdet : ContinuousOn (fun x => (h x).det) W := by
      have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
        funext x
        exact Matrix.det_fin_two (h x)
      rw [e]
      exact ((hh 0 0).continuousOn.mul (hh 1 1).continuousOn).sub
        ((hh 0 1).continuousOn.mul (hh 1 0).continuousOn)
    have hc : ContinuousOn (fun x => r x * G x * Real.sqrt (h x).det) W :=
      (hr.mul hG).mul hdet.sqrt
    have hiL : MeasureTheory.IntegrableOn (fun x => r x * G x * Real.sqrt (h x).det) L
        MeasureTheory.volume :=
      (hc.mono hLW).integrableOn_compact hL
    refine hiL.of_forall_diff_eq_zero hW.measurableSet ?_
    intro x hx
    show r x * G x * Real.sqrt (h x).det = 0
    rw [h0 x hx.1 hx.2, zero_mul]
  
  have hAo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  
  have s2 : ∀ j,
      (∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
          ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
        (∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) ∧
      (MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
          (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume →
        MeasureTheory.IntegrableOn
          (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) (P.W k)
          MeasureTheory.volume) := by
    intro j
    obtain ⟨hc1, hc2⟩ := eig_chart_cov S P j k (fun y => ρ j (P.param k y) * F k y)
    have hEq : Set.EqOn (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
        (fun x => ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
          Real.sqrt (P.h j x).det)
        (P.W j ∩ P.param j ⁻¹' P.O k) := by
      intro x hx
      show ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det =
        ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
          Real.sqrt (P.h j x).det
      rw [(hP3 j x hx).2, hcompat j k x hx]
    have hzero : ∀ y ∈ P.W k \ (P.W k ∩ P.param k ⁻¹' P.O j),
        ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det = 0 := by
      intro y hy
      have hy' : P.param k y ∉ P.O j := fun h => hy.2 ⟨hy.1, h⟩
      rw [hρO j _ hy', zero_mul, zero_mul]
    refine ⟨?_, fun hi => ?_⟩
    · calc (∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
            ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
          = ∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
              ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
                Real.sqrt (P.h j x).det :=
            MeasureTheory.setIntegral_congr_fun (hAo j).measurableSet hEq
        _ = ∫ y in P.W k ∩ P.param k ⁻¹' P.O j,
              ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det := hc1
        _ = ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
            (MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
              (P.W_open k).measurableSet Set.inter_subset_left hzero).symm
    · have hi' : MeasureTheory.IntegrableOn
          (fun x => ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
            Real.sqrt (P.h j x).det) (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume :=
        hi.congr_fun hEq (hAo j).measurableSet
      have h1 : MeasureTheory.IntegrableOn
          (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det)
          (P.W k ∩ P.param k ⁻¹' P.O j) MeasureTheory.volume := hc2.mp hi'
      exact h1.of_forall_diff_eq_zero (P.W_open k).measurableSet hzero
  
  have hP7L : ∀ y ∈ L,
      (∑ j, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) =
        F k y * Real.sqrt (P.h k y).det := by
    intro y hyL
    have hy : y ∈ P.W k := hLW hyL
    by_cases hF0 : F k y = 0
    · simp [hF0]
    · have hb : 0 ≤ b (P.param k y) := by
        by_contra hlt
        exact hF0 (hFb y hy (lt_of_not_ge hlt))
      rw [← Finset.sum_mul, ← Finset.sum_mul, hρ1 _ (hP1 k y hy).2 hb, one_mul]
  have hfnn : ∀ j, ∀ x ∈ P.W j, 0 ≤ ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
    fun j x hx => mul_nonneg (mul_nonneg (hρnn _ _) (hFnn j x hx)) (Real.sqrt_nonneg _)
  have hgnn : ∀ j, ∀ y ∈ P.W k, 0 ≤ ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
    fun j y hy => mul_nonneg (mul_nonneg (hρnn _ _) (hFnn k y hy)) (Real.sqrt_nonneg _)
  have hfi : ∀ j, MeasureTheory.IntegrableOn
      (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) (P.W j)
      MeasureTheory.volume := by
    intro j
    exact s1 (P.W j) (Kc j) (P.W_open j) (hK j).1 (hK j).2 (P.h j) (P.h_smooth j)
      (fun x => ρ j (P.param j x)) (F j) (hρc j j) (hF j)
      (fun x hx hxK => by
        show ρ j (P.param j x) * F j x = 0
        rw [hρK j x hx hxK, zero_mul])
  have hgi : ∀ j, MeasureTheory.IntegrableOn
      (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) (P.W k)
      MeasureTheory.volume := fun j => (s2 j).2 ((hfi j).mono_set Set.inter_subset_left)
  have hle : ∀ j,
      (∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) ≤
        ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := by
    intro j
    calc (∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det)
        ≤ ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
          MeasureTheory.setIntegral_mono_set (hgi j)
            (MeasureTheory.ae_restrict_of_forall_mem (P.W_open k).measurableSet (hgnn j))
            (Filter.Eventually.of_forall (fun x (hx : x ∈ L) => hLW hx))
      _ = ∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
            ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := (s2 j).1.symm
      _ ≤ ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
          MeasureTheory.setIntegral_mono_set (hfi j)
            (MeasureTheory.ae_restrict_of_forall_mem (P.W_open j).measurableSet (hfnn j))
            (Filter.Eventually.of_forall
              (fun x (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) => hx.1))
  have hswap := MeasureTheory.integral_finset_sum (μ := MeasureTheory.volume.restrict L)
    Finset.univ (fun j _ => (hgi j).mono_set hLW)
  calc (∫ x in L, F k x * Real.sqrt (P.h k x).det)
      = ∫ y in L, ∑ j, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
        MeasureTheory.setIntegral_congr_fun hL.measurableSet
          (fun y hy => (hP7L y hy).symm)
    _ = ∑ j, ∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det := hswap
    _ ≤ ∑ j, ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
        Finset.sum_le_sum (fun j _ => hle j)
    _ = eigWInt P ρ F := rfl

theorem pcgb_dp_square_chart (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ i k : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i k) W) (hpd : ∀ x ∈ W, (h x).PosDef)
    (a b s : ℝ) (hs : 0 < s)
    (hsub : {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} ⊆ W) :
    IsCompact {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} ∧
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : E2 → ℝ, ContDiffOn ℝ ∞ v W →
      ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
          (v x - (∫ y in {y : E2 | a ≤ y 0 ∧ y 0 < a + s ∧ b ≤ y 1 ∧ y 1 < b + s}, v y) / s ^ 2) ^ 2 ≤
        C * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
          (∑ i : Fin 2, ∑ k : Fin 2, (h x)⁻¹ i k * pd2 k v x * pd2 i v x) * Real.sqrt (h x).det :=
by
  classical
  
  have hc0 : Continuous (fun x : E2 => x 0) := by fun_prop
  have hc1 : Continuous (fun x : E2 => x 1) := by fun_prop
  have hQcClosed : IsClosed {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} :=
    (isClosed_le continuous_const hc0).inter ((isClosed_le hc0 continuous_const).inter
      ((isClosed_le continuous_const hc1).inter (isClosed_le hc1 continuous_const)))
  have hQcBdd : Bornology.IsBounded {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} := by
    refine (Metric.isBounded_closedBall (x := (0 : E2)) (r := |a| + |b| + 2 * s)).subset ?_
    intro x hx
    obtain ⟨h1, h2, h3, h4⟩ := hx
    rw [Metric.mem_closedBall, dist_zero_right]
    have hn : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
        sq_abs, sq_abs]
    have e0 : x 0 ^ 2 ≤ (|a| + s) ^ 2 :=
      sq_le_sq' (by linarith [neg_abs_le a]) (by linarith [le_abs_self a])
    have e1 : x 1 ^ 2 ≤ (|b| + s) ^ 2 :=
      sq_le_sq' (by linarith [neg_abs_le b]) (by linarith [le_abs_self b])
    have ha := abs_nonneg a
    have hb := abs_nonneg b
    have hR : ‖x‖ ^ 2 ≤ (|a| + |b| + 2 * s) ^ 2 := by nlinarith
    nlinarith [norm_nonneg x]
  have hQc : IsCompact {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} :=
    Metric.isCompact_of_isClosed_isBounded hQcClosed hQcBdd
  have hQQc : {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s} ⊆
      {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} :=
    fun x hx => ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
  
  obtain ⟨CL, hCL0, hCL⟩ := (chart_dirichlet_form_facts W hW h hh hpd).2.2.2 _ hQc hsub
  refine ⟨hQc, s ^ 2 * CL, mul_nonneg (sq_nonneg s) hCL0, fun v hv => ?_⟩
  obtain ⟨m, hm⟩ : ∃ m : ℝ, m = (∫ y in {y : E2 | a ≤ y 0 ∧ y 0 < a + s ∧ b ≤ y 1 ∧ y 1 < b + s},
      v y) / s ^ 2 := ⟨_, rfl⟩
  rw [← hm]
  
  have hvQc : ContinuousOn v
      {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} := hv.continuousOn.mono hsub
  obtain ⟨hIv, -, -⟩ := square_iterated_integral v a b s hs hvQc
  obtain ⟨hIm, hm2, -⟩ := square_iterated_integral (fun _ => m) a b s hs continuousOn_const
  simp only [intervalIntegral.integral_const, smul_eq_mul] at hm2
  have hmean : ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
      (v x - m) = 0 := by
    rw [integral_sub hIv hIm, hm2, hm]
    have hs0 : s ≠ 0 := hs.ne'
    field_simp
    ring
  
  have hw : ContDiffOn ℝ ∞ (fun x => v x - m) W := hv.sub contDiffOn_const
  have hP := poincare_halfopen_square W hW (fun x => v x - m) hw a b s hs hsub
  beta_reduce at hP
  have hgrad : ∀ x, ∑ k : Fin 2, (pd2 k (fun x => v x - m) x) ^ 2 =
      ∑ k : Fin 2, (pd2 k v x) ^ 2 := by
    intro x
    simp only [pd2, fderiv_sub_const]
  simp only [hgrad, hmean] at hP
  have hstep1 : ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
      (v x - m) ^ 2 ≤ s ^ 2 * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
        ∑ k : Fin 2, (pd2 k v x) ^ 2 := by
    have hz : (0 : ℝ) ^ 2 / s ^ 2 = 0 := by simp
    linarith [hP]
  
  have hGc : ContinuousOn (fun x => ∑ k : Fin 2, (pd2 k v x) ^ 2) W := by
    have hfd := hv.continuousOn_fderiv_of_isOpen hW (by simp)
    refine continuousOn_finset_sum _ (fun k _ => ?_)
    exact (hfd.clm_apply continuousOn_const).pow 2
  have hstep2 : ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
        ∑ k : Fin 2, (pd2 k v x) ^ 2 ≤
      ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
        ∑ k : Fin 2, (pd2 k v x) ^ 2 :=
    setIntegral_mono_set (ContinuousOn.integrableOn_compact hQc (hGc.mono hsub))
      (Filter.Eventually.of_forall (fun x => Finset.sum_nonneg (fun k _ => sq_nonneg _)))
      hQQc.eventuallyLE
  
  have hstep3 := hCL _ hv
  have hint_eq : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
      (∑ i : Fin 2, ∑ k : Fin 2, (h x)⁻¹ i k * pd2 i v x * pd2 k v x) * Real.sqrt (h x).det) =
      ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
        (∑ i : Fin 2, ∑ k : Fin 2, (h x)⁻¹ i k * pd2 k v x * pd2 i v x) *
          Real.sqrt (h x).det := by
    congr 1
    funext x
    congr 1
    refine Finset.sum_congr rfl (fun i' _ => Finset.sum_congr rfl (fun k' _ => ?_))
    ring
  rw [hint_eq] at hstep3
  
  have hs2 : 0 ≤ s ^ 2 := sq_nonneg s
  calc _ ≤ _ := hstep1
    _ ≤ s ^ 2 * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
        ∑ k : Fin 2, (pd2 k v x) ^ 2 :=
        mul_le_mul_of_nonneg_left hstep2 hs2
    _ ≤ s ^ 2 * (CL * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
        (∑ i : Fin 2, ∑ k : Fin 2, (h x)⁻¹ i k * pd2 k v x * pd2 i v x) *
          Real.sqrt (h x).det) :=
        mul_le_mul_of_nonneg_left hstep3 hs2
    _ = s ^ 2 * CL * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s},
        (∑ i : Fin 2, ∑ k : Fin 2, (h x)⁻¹ i k * pd2 k v x * pd2 i v x) *
          Real.sqrt (h x).det := by ring

theorem pcgb_dp_anchor_mean (a b s : ℝ) (hs : 0 < s) (U : Set E2) (hU : IsOpen U) (hUne : U.Nonempty)
    (hUQ : U ⊆ {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}) :
    0 < (MeasureTheory.volume U).toReal ∧ ∀ v : E2 → ℝ,
      ContinuousOn v {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} → (∀ x ∈ U, v x = 0) →
      (MeasureTheory.volume U).toReal *
          ((∫ y in {y : E2 | a ≤ y 0 ∧ y 0 < a + s ∧ b ≤ y 1 ∧ y 1 < b + s}, v y) / s ^ 2) ^ 2 ≤
        ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
          (v x - (∫ y in {y : E2 | a ≤ y 0 ∧ y 0 < a + s ∧ b ≤ y 1 ∧ y 1 < b + s}, v y) / s ^ 2) ^ 2 :=
by
  have hK : IsCompact {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} := by
    have heq : {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} =
        (EuclideanSpace.equiv (Fin 2) ℝ) ⁻¹' Set.Icc ![a, b] ![a + s, b + s] := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
      simp [EuclideanSpace.equiv]
      tauto
    rw [heq]
    exact (EuclideanSpace.equiv (Fin 2) ℝ).toHomeomorph.isCompact_preimage.mpr isCompact_Icc
  have hsq : ∀ G : E2 → ℝ,
      ContinuousOn G {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} →
      MeasureTheory.IntegrableOn G {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}
        MeasureTheory.volume := by
    intro G hG
    refine (hG.integrableOn_compact hK).mono_set ?_
    intro x hx
    exact ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
  have hQint1 : MeasureTheory.IntegrableOn (fun _ : E2 => (1 : ℝ))
      {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s} MeasureTheory.volume :=
    hsq (fun _ => (1 : ℝ)) continuousOn_const
  have hQfin : MeasureTheory.volume {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s} < ⊤ := by
    rcases (MeasureTheory.integrableOn_const_iff).mp hQint1 with h | h
    · simp at h
    · exact h
  have hUfin : MeasureTheory.volume U ≠ ⊤ :=
    ne_top_of_le_ne_top hQfin.ne (MeasureTheory.measure_mono hUQ)
  have hUpos : MeasureTheory.volume U ≠ 0 := (hU.measure_pos MeasureTheory.volume hUne).ne'
  refine ⟨ENNReal.toReal_pos hUpos hUfin, fun v hv hv0 => ?_⟩
  set m := (∫ y in {y : E2 | a ≤ y 0 ∧ y 0 < a + s ∧ b ≤ y 1 ∧ y 1 < b + s}, v y) / s ^ 2 with hm
  have hcont : ContinuousOn (fun x => (v x - m) ^ 2)
      {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} :=
    (hv.sub continuousOn_const).pow 2
  have hint := hsq (fun x => (v x - m) ^ 2) hcont
  have hU_eq : ∫ x in U, (v x - m) ^ 2 = (MeasureTheory.volume U).toReal * m ^ 2 := by
    have h1 : ∫ x in U, (v x - m) ^ 2 = ∫ x in U, m ^ 2 := by
      refine MeasureTheory.setIntegral_congr_fun hU.measurableSet ?_
      intro x hx
      simp only
      rw [hv0 x hx]
      ring
    rw [h1, MeasureTheory.setIntegral_const, smul_eq_mul, MeasureTheory.measureReal_def]
  have hmono : ∫ x in U, (v x - m) ^ 2 ≤
      ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, (v x - m) ^ 2 :=
    MeasureTheory.setIntegral_mono_set hint
      (Filter.Eventually.of_forall (fun x => sq_nonneg _)) hUQ.eventuallyLE
  rw [← hU_eq]
  exact hmono

theorem pcgb_dp_negative_point (W : Set E2) (hW : IsOpen W) (β : E2 → ℝ) (hβ : ContDiffOn ℝ ∞ β W)
    (x₀ : E2) (hx₀ : x₀ ∈ W) (hβ0 : β x₀ = 0) (hdβ : fderiv ℝ β x₀ ≠ 0)
    (N : Set E2) (hN : IsOpen N) (hxN : x₀ ∈ N) :
    ∃ y ∈ N ∩ W, β y < 0 :=
by
  obtain ⟨v, hv⟩ := ContinuousLinearMap.exists_ne_zero hdβ
  set L := fderiv ℝ β x₀ with hL
  set w : E2 := (-(L v)) • v with hw
  have hLw : L w < 0 := by
    have h1 : L w = -(L v * L v) := by
      rw [hw, map_smul, smul_eq_mul, neg_mul]
    rw [h1]
    have h2 := mul_self_pos.mpr hv
    linarith
  have hdiff : DifferentiableAt ℝ β x₀ :=
    (hβ.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx₀)
  have hγ : HasDerivAt (fun t : ℝ => x₀ + t • w) w 0 := by
    have h := ((hasDerivAt_id (0:ℝ)).smul_const w).const_add x₀
    simpa using h
  have hx0' : x₀ + (0:ℝ) • w = x₀ := by rw [zero_smul, add_zero]
  have hφ : HasDerivAt (fun t : ℝ => β (x₀ + t • w)) (L w) 0 := by
    have h1 : HasFDerivAt β L (x₀ + (0:ℝ) • w) := by
      rw [hx0']
      exact hdiff.hasFDerivAt
    exact h1.comp_hasDerivAt (0:ℝ) hγ
  have hslope := hφ.tendsto_slope_zero_right
  have E1 := hslope.eventually_lt_const hLw
  have hmem : x₀ + (0:ℝ) • w ∈ N ∩ W := by
    rw [hx0']
    exact ⟨hxN, hx₀⟩
  have E2 : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), x₀ + t • w ∈ N ∩ W :=
    nhdsWithin_le_nhds (hγ.continuousAt.tendsto.eventually_mem ((hN.inter hW).mem_nhds hmem))
  have E3 : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), t ∈ Set.Ioi (0:ℝ) := self_mem_nhdsWithin
  obtain ⟨t, h1, h2, h3⟩ := (E1.and (E2.and E3)).exists
  have ht : (0:ℝ) < t := h3
  simp only [zero_add, hx0', hβ0, sub_zero, smul_eq_mul] at h1
  refine ⟨x₀ + t • w, h2, ?_⟩
  by_contra hc
  push_neg at hc
  have := mul_nonneg (inv_nonneg.mpr ht.le) hc
  linarith

theorem pcgb_ds_dirichlet_poincare {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      eigWInt P ρ (fun j x => u (P.param j x) ^ 2) ≤ C * eigWInt P ρ (eigGam P u u) :=
by
  classical
  
  have hρc' : ∀ j, ContinuousOn (fun x => ρ j (P.param j x)) (P.W j) :=
    fun j => (hρs j j).continuousOn
  obtain ⟨-, -, -, -, hnn, ⟨A, hA0, hAb⟩, -⟩ := eig_wint_facts S P ρ Kc hρnn hρc' hK hρK
  have hQ : ∀ j, ∀ q ∈ S, q ∈ P.O j → P.proj j q ∈ P.W j ∧ P.param j (P.proj j q) = q := by
    intro j q hqS hqO
    have hq : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hqO, hqS⟩
    obtain ⟨x, hx, rfl⟩ := hq
    rw [P.proj_param j x hx]
    exact ⟨hx, rfl⟩
  have hparS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro j x hx
    rw [← P.image_eq j]
    exact ⟨x, hx, rfl⟩
  have hsome : ∀ q ∈ S, 0 ≤ b q → ∃ j, ρ j q ≠ 0 := by
    intro q hq hbq
    have h1 : ∑ j, ρ j q ≠ 0 := by rw [hρ1 q hq hbq]; exact one_ne_zero
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero h1
    exact ⟨j, hj⟩
  have hinO : ∀ j q, ρ j q ≠ 0 → q ∈ P.O j := by
    intro j q h
    by_contra hc
    exact h (hρO j q hc)
  
  have hV : ∀ (u : X → ℝ) (c : ℝ), (∀ q ∈ S, b q < c → u q = 0) →
      ∀ k, ∀ x ∈ P.W k, b (P.param k x) < c →
        u (P.param k x) = 0 ∧ eigGam P u u k x = 0 := by
    intro u c hcu k x hx hbx
    have hVo : IsOpen (P.W k ∩ (fun y => b (P.param k y)) ⁻¹' Set.Iio c) :=
      (hb k).continuousOn.isOpen_inter_preimage (P.W_open k) isOpen_Iio
    have hzero : ∀ y ∈ P.W k ∩ (fun y => b (P.param k y)) ⁻¹' Set.Iio c, u (P.param k y) = 0 :=
      fun y hy => hcu _ (hparS k y hy.1).2 hy.2
    have hev : (fun y => u (P.param k y)) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
      Filter.eventually_of_mem (hVo.mem_nhds ⟨hx, hbx⟩) hzero
    have hfd : fderiv ℝ (fun y => u (P.param k y)) x = 0 := by
      rw [hev.fderiv_eq]
      simp
    refine ⟨hzero x ⟨hx, hbx⟩, ?_⟩
    simp [eigGam, pd2, hfd]
  
  obtain ⟨R, hR⟩ : ∃ R : Set X, R = {q | q ∈ S ∧ 0 ≤ b q} := ⟨_, rfl⟩
  have hmemR : ∀ q, q ∈ R ↔ q ∈ S ∧ 0 ≤ b q := fun q => by rw [hR]; exact Iff.rfl
  have hRpc : IsPreconnected R := by rw [hR]; exact hRconn.isPreconnected
  
  obtain ⟨m, jr, a, b', s, hs, hsub, hcovK⟩ := pcr_poinc_square_cover P.n P.W P.W_open Kc hK
  have hc0 : Continuous (fun x : E2 => x 0) := by fun_prop
  have hc1 : Continuous (fun x : E2 => x 1) := by fun_prop
  have hQoOpen : ∀ r, IsOpen {x : E2 | a r < x 0 ∧ x 0 < a r + s r ∧ b' r < x 1 ∧ x 1 < b' r + s r} := by
    intro r
    exact (isOpen_lt continuous_const hc0).inter ((isOpen_lt hc0 continuous_const).inter
      ((isOpen_lt continuous_const hc1).inter (isOpen_lt hc1 continuous_const)))
  obtain ⟨Gs, hGs⟩ : ∃ Gs : Fin m → Set X, Gs = fun r => P.O (jr r) ∩ P.proj (jr r) ⁻¹'
      {x : E2 | a r < x 0 ∧ x 0 < a r + s r ∧ b' r < x 1 ∧ x 1 < b' r + s r} := ⟨_, rfl⟩
  have hmemG : ∀ r q, q ∈ Gs r ↔ q ∈ P.O (jr r) ∧
      P.proj (jr r) q ∈ {x : E2 | a r < x 0 ∧ x 0 < a r + s r ∧ b' r < x 1 ∧ x 1 < b' r + s r} := by
    intro r q
    rw [hGs]
    exact Iff.rfl
  have hGopen : ∀ r, IsOpen (Gs r) := by
    intro r
    rw [hGs]
    exact (P.proj_cont (jr r)).isOpen_inter_preimage (P.O_open _) (hQoOpen r)
  
  have hM : ∀ r, ∀ x ∈ P.W (jr r), 0 ≤ b (P.param (jr r) x) →
      x ∈ {y : E2 | a r < y 0 ∧ y 0 < a r + s r ∧ b' r < y 1 ∧ y 1 < b' r + s r} →
      P.param (jr r) x ∈ R ∩ Gs r := by
    intro r x hx hbx hxQ
    obtain ⟨hO, hS⟩ := hparS (jr r) x hx
    refine ⟨(hmemR _).2 ⟨hS, hbx⟩, (hmemG r _).2 ⟨hO, ?_⟩⟩
    rw [P.proj_param _ x hx]
    exact hxQ
  
  have hRpt : ∀ q ∈ S, 0 ≤ b q → ∃ r, P.proj (jr r) q ∈ P.W (jr r) ∧
      P.param (jr r) (P.proj (jr r) q) = q ∧
      P.proj (jr r) q ∈ {y : E2 | a r < y 0 ∧ y 0 < a r + s r ∧ b' r < y 1 ∧ y 1 < b' r + s r} ∧
      q ∈ R ∩ Gs r := by
    intro q hq hbq
    obtain ⟨j, hj⟩ := hsome q hq hbq
    have hqO := hinO j q hj
    obtain ⟨hxW, hpx⟩ := hQ j q hq hqO
    have hxK : P.proj j q ∈ Kc j := by
      by_contra hc
      have h0 := hρK j _ hxW hc
      rw [hpx] at h0
      exact hj h0
    obtain ⟨r, hr, hxr⟩ := hcovK j _ hxK
    subst hr
    refine ⟨r, hxW, hpx, hxr, ?_⟩
    have := hM r _ hxW (by rw [hpx]; exact hbq) hxr
    rwa [hpx] at this
  have hcovι : R ⊆ ⋃ i : {r : Fin m // (R ∩ Gs r).Nonempty}, Gs i.1 := by
    intro q hqR
    obtain ⟨hq, hbq⟩ := (hmemR q).1 hqR
    obtain ⟨r, -, -, -, hqRG⟩ := hRpt q hq hbq
    exact Set.mem_iUnion.2 ⟨⟨r, ⟨q, hqRG⟩⟩, hqRG.2⟩
  
  obtain ⟨mean, hmean⟩ : ∃ mean : Fin m → (X → ℝ) → ℝ, mean = fun r u =>
      (∫ x in {x : E2 | a r ≤ x 0 ∧ x 0 < a r + s r ∧ b' r ≤ x 1 ∧ x 1 < b' r + s r},
        u (P.param (jr r) x)) / s r ^ 2 := ⟨_, rfl⟩
  obtain ⟨osc, hosc⟩ : ∃ osc : Fin m → (X → ℝ) → ℝ, osc = fun r u =>
      ∫ x in {x : E2 | a r ≤ x 0 ∧ x 0 < a r + s r ∧ b' r ≤ x 1 ∧ x 1 < b' r + s r},
        (u (P.param (jr r) x) - (∫ y in {y : E2 | a r ≤ y 0 ∧ y 0 < a r + s r ∧ b' r ≤ y 1 ∧
          y 1 < b' r + s r}, u (P.param (jr r) y)) / s r ^ 2) ^ 2 := ⟨_, rfl⟩
  
  have hC : ∀ r, ∃ C : ℝ, 0 ≤ C ∧ ∀ u : X → ℝ,
      (∀ i, ContDiffOn ℝ ∞ (fun x => u (P.param i x)) (P.W i)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      osc r u ≤ C * eigWInt P ρ (eigGam P u u) := by
    intro r
    obtain ⟨hQc, C, hC0, hCv⟩ := pcgb_dp_square_chart (P.W (jr r)) (P.W_open _) (P.h (jr r))
      (fun i k => P.h_smooth (jr r) i k) (P.h_posDef (jr r)) (a r) (b' r) (s r) (hs r) (hsub r)
    refine ⟨C, hC0, fun u hu hadm => ?_⟩
    obtain ⟨c, hc, hcu⟩ := hadm
    have h1 := hCv (fun x => u (P.param (jr r) x)) (hu (jr r))
    have h2 := pcgb_dp_localize S P ρ Kc hρnn hρs hK hρK hρO b hρ1 (eigGam P u u)
      (fun j => (eig_gam_facts S P u u hu hu j).1) (fun j => (eig_gam_facts S P u u hu hu j).2.1)
      (fun j i x hx => eig_grad_pair_compat S P u u hu hu j i x hx) (jr r)
      (fun x hx hbx => (hV u c hcu (jr r) x hx (by linarith)).2)
      _ hQc (hsub r)
    simp only [hosc]
    exact le_trans h1 (mul_le_mul_of_nonneg_left h2 hC0)
  choose C hC0 hCb using hC
  
  obtain ⟨q₀, hq₀S, hbq₀⟩ := hbd
  obtain ⟨r₀, hx₀W, hpx₀, hx₀Q, hq₀RG⟩ := hRpt q₀ hq₀S (le_of_eq hbq₀.symm)
  have hb0 : b (P.param (jr r₀) (P.proj (jr r₀) q₀)) = 0 := by rw [hpx₀]; exact hbq₀
  obtain ⟨y, ⟨hyQ, hyW⟩, hby⟩ := pcgb_dp_negative_point (P.W (jr r₀)) (P.W_open _)
    (fun x => b (P.param (jr r₀) x)) (hb _) _ hx₀W hb0 (hreg _ _ hx₀W hb0) _ (hQoOpen r₀) hx₀Q
  obtain ⟨U₀, hU₀⟩ : ∃ U₀ : Set E2, U₀ =
      {x : E2 | a r₀ < x 0 ∧ x 0 < a r₀ + s r₀ ∧ b' r₀ < x 1 ∧ x 1 < b' r₀ + s r₀} ∩
        (P.W (jr r₀) ∩ (fun x => b (P.param (jr r₀) x)) ⁻¹' Set.Iio 0) := ⟨_, rfl⟩
  have hU₀o : IsOpen U₀ := by
    rw [hU₀]
    exact (hQoOpen r₀).inter
      ((hb _).continuousOn.isOpen_inter_preimage (P.W_open _) isOpen_Iio)
  have hU₀ne : U₀.Nonempty := ⟨y, by rw [hU₀]; exact ⟨hyQ, hyW, hby⟩⟩
  have hU₀Q : U₀ ⊆ {x : E2 | a r₀ ≤ x 0 ∧ x 0 < a r₀ + s r₀ ∧ b' r₀ ≤ x 1 ∧ x 1 < b' r₀ + s r₀} := by
    rw [hU₀]
    rintro x ⟨⟨h1, h2, h3, h4⟩, -⟩
    exact ⟨h1.le, h2, h3.le, h4⟩
  obtain ⟨hμ, hanc⟩ := pcgb_dp_anchor_mean (a r₀) (b' r₀) (s r₀) (hs r₀) U₀ hU₀o hU₀ne hU₀Q
  have hD₀ : ∃ D : ℝ, 0 ≤ D ∧ ∀ u : X → ℝ,
      (∀ i, ContDiffOn ℝ ∞ (fun x => u (P.param i x)) (P.W i)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      (mean r₀ u) ^ 2 ≤ D * eigWInt P ρ (eigGam P u u) := by
    refine ⟨C r₀ / (MeasureTheory.volume U₀).toReal, div_nonneg (hC0 r₀) hμ.le,
      fun u hu hadm => ?_⟩
    obtain ⟨c, hc, hcu⟩ := hadm
    have hvan : ∀ x ∈ U₀, u (P.param (jr r₀) x) = 0 := by
      intro x hx
      rw [hU₀] at hx
      have hbx : b (P.param (jr r₀) x) < 0 := hx.2.2
      exact (hV u c hcu _ x hx.2.1 (by linarith)).1
    have h1 := hanc (fun x => u (P.param (jr r₀) x)) ((hu (jr r₀)).continuousOn.mono (hsub r₀))
      hvan
    have h2 := hCb r₀ u hu ⟨c, hc, hcu⟩
    simp only [hosc] at h2
    rw [div_mul_eq_mul_div, le_div_iff₀ hμ]
    simp only [hmean]
    linarith [h1, h2]
  
  have hedge : ∀ r r', (R ∩ Gs r ∩ Gs r').Nonempty → ∃ D : ℝ, 0 ≤ D ∧ ∀ u : X → ℝ,
      (∀ i, ContDiffOn ℝ ∞ (fun x => u (P.param i x)) (P.W i)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      (mean r u - mean r' u) ^ 2 ≤ D * eigWInt P ρ (eigGam P u u) := by
    rintro r r' ⟨q, ⟨hqR, hq1⟩, hq2⟩
    rw [hmemG] at hq1 hq2
    have hqS := ((hmemR q).1 hqR).1
    obtain ⟨D, hD0, hD⟩ := pcr_poinc_overlap_means S P (jr r) (jr r') (a r) (b' r) (s r)
      (a r') (b' r') (s r') (hs r) (hs r') (hsub r) (hsub r') q hqS hq1.1 hq2.1 hq1.2 hq2.2
    refine ⟨D * (C r + C r'), mul_nonneg hD0 (add_nonneg (hC0 r) (hC0 r')),
      fun u hu hadm => ?_⟩
    have h1 := hD u (fun i => (hu i).continuousOn)
    have h2 := hCb r u hu hadm
    have h3 := hCb r' u hu hadm
    simp only [hosc] at h2 h3
    simp only [hmean]
    calc _ ≤ _ := h1
      _ ≤ D * (C r * eigWInt P ρ (eigGam P u u) + C r' * eigWInt P ρ (eigGam P u u)) :=
          mul_le_mul_of_nonneg_left (add_le_add h2 h3) hD0
      _ = _ := by ring
  
  have hchain : ∀ r, ∃ D : ℝ, 0 ≤ D ∧ ∀ u : X → ℝ,
      (∀ i, ContDiffOn ℝ ∞ (fun x => u (P.param i x)) (P.W i)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      (R ∩ Gs r).Nonempty → (mean r u) ^ 2 ≤ D * eigWInt P ρ (eigGam P u u) := by
    intro r
    by_cases hr : (R ∩ Gs r).Nonempty
    · have hreach := pcr_poinc_reach R hRpc
        (fun i : {r : Fin m // (R ∩ Gs r).Nonempty} => Gs i.1) (fun i => hGopen i.1) hcovι
        (fun i => i.2) ⟨r₀, ⟨q₀, hq₀RG⟩⟩ ⟨r, hr⟩
      suffices H : ∀ i : {r : Fin m // (R ∩ Gs r).Nonempty},
          Relation.ReflTransGen (fun a b => (R ∩ Gs a.1 ∩ Gs b.1).Nonempty)
            ⟨r₀, ⟨q₀, hq₀RG⟩⟩ i →
          ∃ D : ℝ, 0 ≤ D ∧ ∀ u : X → ℝ,
            (∀ i, ContDiffOn ℝ ∞ (fun x => u (P.param i x)) (P.W i)) →
            (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
            (mean i.1 u) ^ 2 ≤ D * eigWInt P ρ (eigGam P u u) by
        obtain ⟨D, hD0, hD⟩ := H _ hreach
        exact ⟨D, hD0, fun u hu hadm _ => hD u hu hadm⟩
      intro i hi
      induction hi with
      | refl => exact hD₀
      | @tail i₁ i₂ _ hbc ih =>
        obtain ⟨D₁, hD₁, h₁⟩ := ih
        obtain ⟨D₂, hD₂, h₂⟩ := hedge i₁.1 i₂.1 hbc
        refine ⟨2 * D₂ + 2 * D₁, by positivity, fun u hu hadm => ?_⟩
        have e1 := h₁ u hu hadm
        have e2 := h₂ u hu hadm
        nlinarith [sq_nonneg (2 * mean i₁.1 u - mean i₂.1 u)]
    · exact ⟨0, le_rfl, fun u _ _ h => absurd h hr⟩
  choose Dm hDm0 hDmb using hchain
  
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = ∑ j, ∑ r ∈ Finset.univ.filter
      (fun r => jr r = j ∧ (R ∩ Gs r).Nonempty), (2 * C r + 2 * s r ^ 2 * Dm r) := ⟨_, rfl⟩
  have hT0 : 0 ≤ T := by
    rw [hT]
    refine Finset.sum_nonneg (fun j _ => Finset.sum_nonneg (fun r _ => ?_))
    have h1 := hC0 r
    have h2 := hDm0 r
    positivity
  refine ⟨A * T, mul_nonneg hA0.le hT0, fun u hu hadm => ?_⟩
  obtain ⟨c, hc, hcu⟩ := hadm
  have hcont : ∀ j, ContinuousOn (fun x => u (P.param j x)) (P.W j) :=
    fun j => (hu j).continuousOn
  have hN := hAb (fun j x => u (P.param j x) ^ 2) (fun j => (hcont j).pow 2)
    (fun j x _ => sq_nonneg _)
  have hKj : ∀ j, ∫ x in Kc j, u (P.param j x) ^ 2 ≤
      (∑ r ∈ Finset.univ.filter (fun r => jr r = j ∧ (R ∩ Gs r).Nonempty),
        (2 * C r + 2 * s r ^ 2 * Dm r)) * eigWInt P ρ (eigGam P u u) := by
    intro j
    have hdiff : ∀ x ∈ Kc j \ (Kc j ∩ {x | 0 ≤ b (P.param j x)}), u (P.param j x) ^ 2 = 0 := by
      rintro x ⟨hxK, hxL⟩
      have hbx : b (P.param j x) < 0 := by
        by_contra hcon
        exact hxL ⟨hxK, not_lt.mp hcon⟩
      rw [(hV u c hcu j x ((hK j).2 hxK) (by linarith)).1]
      ring
    have hL : ∫ x in Kc j, u (P.param j x) ^ 2 =
        ∫ x in Kc j ∩ {x | 0 ≤ b (P.param j x)}, (u (P.param j x) - 0) ^ 2 := by
      rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero (hK j).1.isClosed.measurableSet
        Set.inter_subset_left hdiff]
      simp only [sub_zero]
    have hcs := pcr_poinc_cover_sum (Finset.univ.filter (fun r => jr r = j ∧ (R ∩ Gs r).Nonempty))
      (P.W j) (fun x => u (P.param j x)) (hcont j) a b' s (fun r _ => hs r)
      (fun r hr => by rw [← (Finset.mem_filter.1 hr).2.1]; exact hsub r)
      (Kc j ∩ {x | 0 ≤ b (P.param j x)}) (fun x hx => by
        obtain ⟨r, hr, hxr⟩ := hcovK j x hx.1
        have hgood : (R ∩ Gs r).Nonempty := by
          subst hr
          exact ⟨_, hM r x ((hK _).2 hx.1) hx.2 hxr⟩
        exact Set.mem_biUnion (Finset.mem_filter.2 ⟨Finset.mem_univ _, hr, hgood⟩) hxr) 0
    rw [hL]
    refine hcs.trans ?_
    rw [Finset.sum_mul]
    refine Finset.sum_le_sum (fun r hr => ?_)
    obtain ⟨hrj, hrg⟩ := (Finset.mem_filter.1 hr).2
    subst hrj
    have h1 := hCb r u hu ⟨c, hc, hcu⟩
    have h2 := hDmb r u hu ⟨c, hc, hcu⟩ hrg
    simp only [hosc] at h1
    simp only [hmean] at h2
    have hs2 : 0 ≤ s r ^ 2 := sq_nonneg _
    have h3 := mul_le_mul_of_nonneg_left h2 hs2
    simp only [sub_zero]
    nlinarith [h1, h3]
  have hsumK : ∑ j, ∫ x in Kc j, u (P.param j x) ^ 2 ≤ T * eigWInt P ρ (eigGam P u u) := by
    rw [hT, Finset.sum_mul]
    exact Finset.sum_le_sum (fun j _ => hKj j)
  calc eigWInt P ρ (fun j x => u (P.param j x) ^ 2)
      ≤ A * ∑ j, ∫ x in Kc j, u (P.param j x) ^ 2 := hN
    _ ≤ A * (T * eigWInt P ρ (eigGam P u u)) := mul_le_mul_of_nonneg_left hsumK hA0.le
    _ = A * T * eigWInt P ρ (eigGam P u u) := by ring

theorem pcgb_ws_var_seq {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (f : X → ℝ) (hfc : ∀ j, ContinuousOn (fun x => f (P.param j x)) (P.W j))
    (hpoinc : ∃ C : ℝ, 0 ≤ C ∧ ∀ u : X → ℝ,
      (∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      eigWInt P ρ (fun j x => u (P.param j x) ^ 2) ≤ C * eigWInt P ρ (eigGam P u u)) :
    ∃ u : ℕ → X → ℝ,
      (∀ m j, ContDiffOn ℝ ∞ (fun x => u m (P.param j x)) (P.W j)) ∧
      (∀ m, ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u m q = 0) ∧
      (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m n, N ≤ m → N ≤ n →
        eigWInt P ρ (eigGam P (u m - u n) (u m - u n)) < ε) ∧
      (∀ φ : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => φ (P.param j x)) (P.W j)) →
        (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → φ q = 0) →
        Tendsto (fun n => eigWInt P ρ (eigGam P (u n) φ) +
          eigWInt P ρ (fun j x => f (P.param j x) * φ (P.param j x))) atTop (𝓝 0)) :=
by
  obtain ⟨C, hC0, hC⟩ := hpoinc
  have hρc : ∀ j, ContinuousOn (fun x => ρ j (P.param j x)) (P.W j) :=
    fun j => (hρs j j).continuousOn
  obtain ⟨W1, -, W3, -, W5, -, -⟩ := eig_wint_facts S P ρ Kc hρnn hρc hK hρK
  have hdiff : ∀ (v : X → ℝ) j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j) →
      ∀ x ∈ P.W j, DifferentiableAt ℝ (fun y => v (P.param j y)) x :=
    fun v j hv x hx => (hv.contDiffAt ((P.W_open j).mem_nhds hx)).differentiableAt (by simp)
  have hsymmH : ∀ j, ∀ x ∈ P.W j, ∀ a c : Fin 2, (P.h j x)⁻¹ c a = (P.h j x)⁻¹ a c := by
    intro j x hx a c
    have hH : ((P.h j x)⁻¹).IsHermitian := (P.h_posDef j x hx).isHermitian.inv
    have h1 := hH.apply a c
    rwa [star_trivial] at h1
  have hgsymm : ∀ (u w : X → ℝ) j, ∀ x ∈ P.W j, eigGam P u w j x = eigGam P w u j x := by
    intro u w j x hx
    simp only [eigGam, Fin.sum_univ_two]
    rw [hsymmH j x hx 1 0]
    ring
  have hglin : ∀ (u v w : X → ℝ) j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j) →
      ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j) → ∀ x ∈ P.W j, ∀ s t : ℝ,
      eigGam P (s • u + t • v) w j x = s * eigGam P u w j x + t * eigGam P v w j x := by
    intro u v w j hu hv x hx s t
    have hd : ∀ i : Fin 2, pd2 i (fun x' => (s • u + t • v) (P.param j x')) x =
        s * pd2 i (fun x' => u (P.param j x')) x + t * pd2 i (fun x' => v (P.param j x')) x := by
      intro i
      show fderiv ℝ (fun x' => s * u (P.param j x') + t * v (P.param j x')) x (e2 i) =
        s * fderiv ℝ (fun x' => u (P.param j x')) x (e2 i) +
          t * fderiv ℝ (fun x' => v (P.param j x')) x (e2 i)
      rw [fderiv_fun_add ((hdiff u j hu x hx).const_mul s) ((hdiff v j hv x hx).const_mul t),
        fderiv_const_mul (hdiff u j hu x hx), fderiv_const_mul (hdiff v j hv x hx)]
      rfl
    simp only [eigGam, hd, Fin.sum_univ_two]
    ring
  have hmem : ∀ u : ↥(pcgbWsAdm P b),
      (∀ j, ContDiffOn ℝ ∞ (fun x => (u : X → ℝ) (P.param j x)) (P.W j)) ∧
      ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → (u : X → ℝ) q = 0 := fun u => u.2
  have hmk : ∀ φ : X → ℝ, ((∀ j, ContDiffOn ℝ ∞ (fun x => φ (P.param j x)) (P.W j)) ∧
      ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → φ q = 0) → φ ∈ pcgbWsAdm P b := fun φ h => h
  have hBsymm : ∀ u w : ↥(pcgbWsAdm P b),
      eigWInt P ρ (eigGam P (u : X → ℝ) (w : X → ℝ)) =
        eigWInt P ρ (eigGam P (w : X → ℝ) (u : X → ℝ)) :=
    fun u w => W3 _ _ (fun j x hx => hgsymm _ _ j x hx)
  have hBlin : ∀ (a c : ℝ) (u v w : ↥(pcgbWsAdm P b)),
      eigWInt P ρ (eigGam P ((a • u + c • v : ↥(pcgbWsAdm P b)) : X → ℝ) (w : X → ℝ)) =
        a * eigWInt P ρ (eigGam P (u : X → ℝ) (w : X → ℝ)) +
          c * eigWInt P ρ (eigGam P (v : X → ℝ) (w : X → ℝ)) := by
    intro a c u v w
    have hcu : ∀ j, ContinuousOn (eigGam P (u : X → ℝ) (w : X → ℝ) j) (P.W j) :=
      fun j => (eig_gam_facts S P _ _ (hmem u).1 (hmem w).1 j).1
    have hcv : ∀ j, ContinuousOn (eigGam P (v : X → ℝ) (w : X → ℝ) j) (P.W j) :=
      fun j => (eig_gam_facts S P _ _ (hmem v).1 (hmem w).1 j).1
    have e1 : eigWInt P ρ (eigGam P ((a • u + c • v : ↥(pcgbWsAdm P b)) : X → ℝ) (w : X → ℝ)) =
        eigWInt P ρ (fun j x => a * eigGam P (u : X → ℝ) (w : X → ℝ) j x +
          c * eigGam P (v : X → ℝ) (w : X → ℝ) j x +
          0 * eigGam P (u : X → ℝ) (w : X → ℝ) j x) :=
      W3 _ _ (fun j x hx => by
        have h := hglin (u : X → ℝ) (v : X → ℝ) (w : X → ℝ) j ((hmem u).1 j) ((hmem v).1 j)
          x hx a c
        rw [zero_mul, add_zero]
        exact h)
    have e2 : eigWInt P ρ (fun j x => a * eigGam P (u : X → ℝ) (w : X → ℝ) j x +
          c * eigGam P (v : X → ℝ) (w : X → ℝ) j x +
          0 * eigGam P (u : X → ℝ) (w : X → ℝ) j x) =
        a * eigWInt P ρ (eigGam P (u : X → ℝ) (w : X → ℝ)) +
          c * eigWInt P ρ (eigGam P (v : X → ℝ) (w : X → ℝ)) +
          0 * eigWInt P ρ (eigGam P (u : X → ℝ) (w : X → ℝ)) :=
      W1 _ _ _ hcu hcv hcu a c 0
    rw [e1, e2, zero_mul, add_zero]
  have hBnn : ∀ u : ↥(pcgbWsAdm P b), 0 ≤ eigWInt P ρ (eigGam P (u : X → ℝ) (u : X → ℝ)) :=
    fun u => W5 _ (fun j x hx =>
      (eig_gam_facts S P _ _ (hmem u).1 (hmem u).1 j).2.1 x ((hK j).2 hx))
  have hLlin : ∀ (a c : ℝ) (u v : ↥(pcgbWsAdm P b)),
      eigWInt P ρ (fun j x => f (P.param j x) *
          ((a • u + c • v : ↥(pcgbWsAdm P b)) : X → ℝ) (P.param j x)) =
        a * eigWInt P ρ (fun j x => f (P.param j x) * (u : X → ℝ) (P.param j x)) +
          c * eigWInt P ρ (fun j x => f (P.param j x) * (v : X → ℝ) (P.param j x)) := by
    intro a c u v
    have hcu : ∀ j, ContinuousOn (fun x => f (P.param j x) * (u : X → ℝ) (P.param j x)) (P.W j) :=
      fun j => (hfc j).mul ((hmem u).1 j).continuousOn
    have hcv : ∀ j, ContinuousOn (fun x => f (P.param j x) * (v : X → ℝ) (P.param j x)) (P.W j) :=
      fun j => (hfc j).mul ((hmem v).1 j).continuousOn
    have e1 : eigWInt P ρ (fun j x => f (P.param j x) *
          ((a • u + c • v : ↥(pcgbWsAdm P b)) : X → ℝ) (P.param j x)) =
        eigWInt P ρ (fun j x => a * (f (P.param j x) * (u : X → ℝ) (P.param j x)) +
          c * (f (P.param j x) * (v : X → ℝ) (P.param j x)) +
          0 * (f (P.param j x) * (u : X → ℝ) (P.param j x))) :=
      W3 _ _ (fun j x _ => by
        show f (P.param j x) * (a * (u : X → ℝ) (P.param j x) + c * (v : X → ℝ) (P.param j x)) = _
        ring)
    have e2 : eigWInt P ρ (fun j x => a * (f (P.param j x) * (u : X → ℝ) (P.param j x)) +
          c * (f (P.param j x) * (v : X → ℝ) (P.param j x)) +
          0 * (f (P.param j x) * (u : X → ℝ) (P.param j x))) =
        a * eigWInt P ρ (fun j x => f (P.param j x) * (u : X → ℝ) (P.param j x)) +
          c * eigWInt P ρ (fun j x => f (P.param j x) * (v : X → ℝ) (P.param j x)) +
          0 * eigWInt P ρ (fun j x => f (P.param j x) * (u : X → ℝ) (P.param j x)) :=
      W1 _ _ _ hcu hcv hcu a c 0
    rw [e1, e2, zero_mul, add_zero]
  have hQ : ∀ u : ↥(pcgbWsAdm P b),
      0 ≤ eigWInt P ρ (fun j x => (u : X → ℝ) (P.param j x) ^ 2) ∧
        eigWInt P ρ (fun j x => (u : X → ℝ) (P.param j x) ^ 2) ≤
          C * eigWInt P ρ (eigGam P (u : X → ℝ) (u : X → ℝ)) :=
    fun u => ⟨W5 _ (fun j x _ => sq_nonneg _), hC (u : X → ℝ) (hmem u).1 (hmem u).2⟩
  have hCS : ∀ (F G : Fin P.n → E2 → ℝ), (∀ j, ContinuousOn (F j) (P.W j)) →
      (∀ j, ContinuousOn (G j) (P.W j)) →
      eigWInt P ρ (fun j x => F j x * G j x) ^ 2 ≤
        eigWInt P ρ (fun j x => F j x ^ 2) * eigWInt P ρ (fun j x => G j x ^ 2) := by
    intro F G hF hG
    have hFF : ∀ j, ContinuousOn (fun x => F j x ^ 2) (P.W j) := fun j => (hF j).pow 2
    have hFG : ∀ j, ContinuousOn (fun x => F j x * G j x) (P.W j) := fun j => (hF j).mul (hG j)
    have hGG : ∀ j, ContinuousOn (fun x => G j x ^ 2) (P.W j) := fun j => (hG j).pow 2
    have hquad : ∀ t : ℝ, 0 ≤ eigWInt P ρ (fun j x => G j x ^ 2) * (t * t) +
        (2 * eigWInt P ρ (fun j x => F j x * G j x)) * t +
          eigWInt P ρ (fun j x => F j x ^ 2) := by
      intro t
      have h0 : 0 ≤ eigWInt P ρ (fun j x => (F j x + t * G j x) ^ 2) :=
        W5 _ (fun j x _ => sq_nonneg _)
      have h1 : eigWInt P ρ (fun j x => (F j x + t * G j x) ^ 2) =
          eigWInt P ρ (fun j x => 1 * (F j x ^ 2) + (2 * t) * (F j x * G j x) +
            t ^ 2 * (G j x ^ 2)) :=
        W3 _ _ (fun j x _ => by ring)
      have h2 : eigWInt P ρ (fun j x => 1 * (F j x ^ 2) + (2 * t) * (F j x * G j x) +
            t ^ 2 * (G j x ^ 2)) =
          1 * eigWInt P ρ (fun j x => F j x ^ 2) +
            (2 * t) * eigWInt P ρ (fun j x => F j x * G j x) +
            t ^ 2 * eigWInt P ρ (fun j x => G j x ^ 2) :=
        W1 _ _ _ hFF hFG hGG 1 (2 * t) (t ^ 2)
      rw [h1, h2] at h0
      nlinarith [h0]
    have hd := discrim_le_zero hquad
    unfold discrim at hd
    nlinarith [hd]
  have hL : ∀ u : ↥(pcgbWsAdm P b),
      eigWInt P ρ (fun j x => f (P.param j x) * (u : X → ℝ) (P.param j x)) ^ 2 ≤
        eigWInt P ρ (fun j x => f (P.param j x) ^ 2) *
          eigWInt P ρ (fun j x => (u : X → ℝ) (P.param j x) ^ 2) :=
    fun u => hCS (fun j x => f (P.param j x)) (fun j x => (u : X → ℝ) (P.param j x)) hfc
      (fun j => ((hmem u).1 j).continuousOn)
  obtain ⟨u', hcau, hEL⟩ := nds_direct_method (V := ↥(pcgbWsAdm P b))
    (fun u w => eigWInt P ρ (eigGam P (u : X → ℝ) (w : X → ℝ)))
    (fun w => eigWInt P ρ (fun j x => f (P.param j x) * (w : X → ℝ) (P.param j x)))
    (fun w => eigWInt P ρ (fun j x => (w : X → ℝ) (P.param j x) ^ 2)) C
    (eigWInt P ρ (fun j x => f (P.param j x) ^ 2)) hBsymm hBlin hBnn hLlin hQ hL
  refine ⟨fun m => ((u' m : ↥(pcgbWsAdm P b)) : X → ℝ), fun m => (hmem (u' m)).1,
    fun m => (hmem (u' m)).2, ?_, ?_⟩
  · intro ε hε
    obtain ⟨N, hN⟩ := hcau ε hε
    exact ⟨N, fun m n hm hn => hN m n hm hn⟩
  · intro φ hφ1 hφ2
    exact hEL ⟨φ, hmk φ ⟨hφ1, hφ2⟩⟩

theorem pcgb_ws_local_control {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hpoinc : ∃ C : ℝ, 0 ≤ C ∧ ∀ u : X → ℝ,
      (∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      eigWInt P ρ (fun j x => u (P.param j x) ^ 2) ≤ C * eigWInt P ρ (eigGam P u u))
    (j : Fin P.n) (L : Set E2) (hL : IsCompact L) (hLW : L ⊆ P.W j) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ v : X → ℝ,
      (∀ i, ContDiffOn ℝ ∞ (fun x => v (P.param i x)) (P.W i)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → v q = 0) →
      ∫ x in L, ((v (P.param j x)) ^ 2 +
          ∑ k : Fin 2, (pd2 k (fun y => v (P.param j y)) x) ^ 2) ≤
        C * eigWInt P ρ (eigGam P v v) :=
by
  obtain ⟨CP, hCP, hP⟩ := hpoinc
  obtain ⟨C₁, hC₁, hE⟩ := eig_local_energy (P.W j) (P.W_open j) (P.h j) (P.h_smooth j)
    (P.h_posDef j) L hL hLW
  refine ⟨C₁ * (CP + 1), mul_nonneg hC₁ (by linarith), ?_⟩
  intro v hv hadm
  obtain ⟨c, hc0, hcz⟩ := hadm
  have hparamS : ∀ i, ∀ x ∈ P.W i, P.param i x ∈ S := by
    intro i x hx
    have h := Set.mem_image_of_mem (P.param i) hx
    rw [P.image_eq i] at h
    exact h.2
  have hT : ∀ i' i, ∀ x ∈ P.W i' ∩ P.param i' ⁻¹' P.O i,
      P.param i (P.proj i (P.param i' x)) = P.param i' x := by
    intro i' i x hx
    have hmem : P.param i' x ∈ P.param i '' P.W i := by
      rw [P.image_eq i]
      exact ⟨hx.2, hparamS i' x hx.1⟩
    obtain ⟨y, hy, hyx⟩ := hmem
    rw [← hyx, P.proj_param i y hy]
  
  have hV1 : ∀ x ∈ P.W j, b (P.param j x) < 0 → v (P.param j x) = 0 := by
    intro x hx hbx
    exact hcz _ (hparamS j x hx) (by linarith)
  have hV2 : ∀ x ∈ P.W j, b (P.param j x) < 0 →
      fderiv ℝ (fun y => v (P.param j y)) x = 0 := by
    intro x hx hbx
    have hUo : IsOpen (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Iio c) :=
      (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Iio
    have hxU : x ∈ P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Iio c :=
      ⟨hx, show b (P.param j x) < c by linarith⟩
    have hev : (fun y => v (P.param j y)) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
      Filter.eventually_of_mem (hUo.mem_nhds hxU) (fun y hy => hcz _ (hparamS j y hy.1) hy.2)
    rw [hev.fderiv_eq]
    exact fderiv_const_apply 0
  have hV3 : ∀ x ∈ P.W j, b (P.param j x) < 0 → eigGam P v v j x = 0 := by
    intro x hx hbx
    have h0 := hV2 x hx hbx
    simp [eigGam, pd2, h0]
  
  have h1 := hE (fun y => v (P.param j y)) (hv j)
  
  have hA : ∫ x in L, v (P.param j x) * v (P.param j x) * Real.sqrt (P.h j x).det ≤
      eigWInt P ρ (fun i x => v (P.param i x) * v (P.param i x)) :=
    pcgb_dp_localize S P ρ Kc hρnn hρs hK hρK hρO b hρ1
      (fun i x => v (P.param i x) * v (P.param i x))
      (fun i => (hv i).continuousOn.mul (hv i).continuousOn)
      (fun i x _ => mul_self_nonneg _)
      (fun i' i x hx => by simp only [hT i' i x hx])
      j (fun x hx hbx => by simp only [hV1 x hx hbx, mul_zero]) L hL hLW
  have hAeq : eigWInt P ρ (fun i x => v (P.param i x) * v (P.param i x)) =
      eigWInt P ρ (fun i x => v (P.param i x) ^ 2) := by
    congr 1
    funext i x
    ring
  have hPv := hP v hv ⟨c, hc0, hcz⟩
  
  have hB : ∫ x in L, eigGam P v v j x * Real.sqrt (P.h j x).det ≤
      eigWInt P ρ (eigGam P v v) :=
    pcgb_dp_localize S P ρ Kc hρnn hρs hK hρK hρO b hρ1 (eigGam P v v)
      (fun i => (eig_gam_facts S P v v hv hv i).1)
      (fun i => (eig_gam_facts S P v v hv hv i).2.1)
      (fun i' i x hx => eig_grad_pair_compat S P v v hv hv i' i x hx)
      j hV3 L hL hLW
  have hBeq : (∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (P.h j x)⁻¹ a b *
        pd2 b (fun y => v (P.param j y)) x * pd2 a (fun y => v (P.param j y)) x) *
        Real.sqrt (P.h j x).det) =
      ∫ x in L, eigGam P v v j x * Real.sqrt (P.h j x).det := rfl
  rw [hBeq] at h1
  set E := eigWInt P ρ (eigGam P v v) with hEdef
  have hsum : (∫ x in L, v (P.param j x) * v (P.param j x) * Real.sqrt (P.h j x).det) +
      (∫ x in L, eigGam P v v j x * Real.sqrt (P.h j x).det) ≤ (CP + 1) * E := by
    rw [hAeq] at hA
    nlinarith
  have h2 := mul_le_mul_of_nonneg_left hsum hC₁
  calc _ ≤ _ := h1
    _ ≤ C₁ * ((CP + 1) * E) := h2
    _ = C₁ * (CP + 1) * E := by ring

theorem pcgb_ws_l2loc_limit (W : Set E2) (hW : IsOpen W) (v : ℕ → E2 → ℝ)
    (hv : ∀ m, ContinuousOn (v m) W)
    (hcauchy : ∀ L : Set E2, IsCompact L → L ⊆ W → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ,
      ∀ m l, N ≤ m → N ≤ l → ∫ x in L, (v m x - v l x) ^ 2 < ε) :
    ∃ w : E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ W → MemLp w 2 (volume.restrict L)) ∧
      ∀ L : Set E2, IsCompact L → L ⊆ W →
        Tendsto (fun m => ∫ x in L, (v m x - w x) ^ 2) atTop (𝓝 0) :=
by
  
  have s1 : ∃ K : ℕ → Set E2, (∀ j, IsCompact (K j)) ∧ (∀ j, K j ⊆ W) ∧
      (∀ i j, i ≤ j → K i ⊆ K j) ∧ ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ j, L ⊆ K j := by
    refine ⟨fun j => Metric.closedBall (0 : E2) j ∩
      {x | ∀ y, y ∉ W → 1 / ((j : ℝ) + 1) ≤ dist x y}, ?_, ?_, ?_, ?_⟩
    · intro j
      apply Metric.isCompact_of_isClosed_isBounded
      · apply Metric.isClosed_closedBall.inter
        have : {x : E2 | ∀ y, y ∉ W → 1 / ((j : ℝ) + 1) ≤ dist x y} =
            ⋂ y ∈ Wᶜ, {x | 1 / ((j : ℝ) + 1) ≤ dist x y} := by
          ext x; simp
        rw [this]
        exact isClosed_biInter fun y _ =>
          isClosed_le continuous_const (continuous_id.dist continuous_const)
      · exact Metric.isBounded_closedBall.subset Set.inter_subset_left
    · intro j x hx
      by_contra h
      have h1 := hx.2 x h
      rw [dist_self] at h1
      have : (0:ℝ) < 1 / ((j : ℝ) + 1) := by positivity
      linarith
    · intro i j hij x hx
      have hij' : (i : ℝ) ≤ j := by exact_mod_cast hij
      refine ⟨Metric.closedBall_subset_closedBall hij' hx.1, fun y hy => ?_⟩
      have h1 : 1 / ((j:ℝ) + 1) ≤ 1 / ((i:ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      exact h1.trans (hx.2 y hy)
    · intro L hL hLW
      obtain ⟨δ, hδ, hδW⟩ := hL.exists_thickening_subset_open hW hLW
      obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_closedBall (0:E2)).1 hL.isBounded
      obtain ⟨j, hj⟩ := exists_nat_gt (max R (1/δ))
      refine ⟨j, fun x hx => ⟨Metric.closedBall_subset_closedBall
        (le_of_lt (lt_of_le_of_lt (le_max_left _ _) hj)) (hR hx), fun y hy => ?_⟩⟩
      have h1 : 1/δ < (j:ℝ) + 1 := by linarith [le_max_right R (1/δ)]
      have h2 : 1 / ((j:ℝ)+1) < δ := by
        rw [div_lt_iff₀ (by positivity)]
        rw [div_lt_iff₀ hδ] at h1
        linarith
      have h3 : δ ≤ dist x y := by
        by_contra h
        push_neg at h
        apply hy
        apply hδW
        rw [Metric.mem_thickening_iff]
        exact ⟨x, hx, by rw [dist_comm]; exact h⟩
      linarith
  
  have s2 : ∀ (μ : Measure E2) (f : E2 → ℝ), MemLp f 2 μ →
      (∀ ε : ℝ, 0 < ε → ∫ x, f x ^ 2 ∂μ < ε ^ 2 → eLpNorm f 2 μ < ENNReal.ofReal ε) ∧
      (∀ ε : ℝ, 0 ≤ ε → eLpNorm f 2 μ ≤ ENNReal.ofReal ε → ∫ x, f x ^ 2 ∂μ ≤ ε ^ 2) := by
    intro μ f hf
    have h := hf.eLpNorm_eq_integral_rpow_norm two_ne_zero ENNReal.ofNat_ne_top
    have hI : 0 ≤ ∫ x, f x ^ 2 ∂μ := integral_nonneg fun x => sq_nonneg _
    have e1 : (fun a => ‖f a‖ ^ (2:ENNReal).toReal) = fun a => f a ^ 2 := by
      funext a
      rw [ENNReal.toReal_ofNat, Real.rpow_two, Real.norm_eq_abs, sq_abs]
    have hid : ∫ x, f x ^ 2 ∂μ = ((eLpNorm f 2 μ).toReal) ^ 2 := by
      rw [h, e1, ENNReal.toReal_ofReal (Real.rpow_nonneg hI _), ENNReal.toReal_ofNat, ← one_div,
        ← Real.sqrt_eq_rpow, Real.sq_sqrt hI]
    have ha : 0 ≤ (eLpNorm f 2 μ).toReal := ENNReal.toReal_nonneg
    have he : eLpNorm f 2 μ = ENNReal.ofReal (eLpNorm f 2 μ).toReal :=
      (ENNReal.ofReal_toReal hf.eLpNorm_lt_top.ne).symm
    refine ⟨fun ε hε hlt => ?_, fun ε hε hle => ?_⟩
    · rw [hid] at hlt
      have : (eLpNorm f 2 μ).toReal < ε := by nlinarith
      rw [he]
      exact (ENNReal.ofReal_lt_ofReal_iff hε).2 this
    · have h2 : (eLpNorm f 2 μ).toReal ≤ ε := ENNReal.toReal_le_of_le_ofReal hε hle
      rw [hid]
      nlinarith
  
  obtain ⟨K, hKc, hKW, hKmono, hKabs⟩ := s1
  have hmem : ∀ (φ : E2 → ℝ) (L : Set E2), IsCompact L → L ⊆ W → ContinuousOn φ W →
      MemLp φ 2 (volume.restrict L) := by
    intro φ L hL hLW hφ
    exact (memLp_two_iff_integrable_sq ((hφ.mono hLW).aestronglyMeasurable hL.measurableSet)).2
      (((hφ.mono hLW).pow 2).integrableOn_compact hL)
  have hvK : ∀ m i, MemLp (v m) 2 (volume.restrict (K i)) :=
    fun m i => hmem _ _ (hKc i) (hKW i) (hv m)
  have hcauK : ∀ i (ε : ℝ), 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l →
      eLpNorm (v m - v l) 2 (volume.restrict (K i)) < ENNReal.ofReal ε := by
    intro i ε hε
    obtain ⟨N, hN⟩ := hcauchy (K i) (hKc i) (hKW i) (ε ^ 2) (by positivity)
    refine ⟨N, fun m l hm hl => ?_⟩
    exact (s2 _ _ ((hvK m i).sub (hvK l i))).1 ε hε (hN m l hm hl)
  
  choose N hN using fun j => hcauK j ((1/2:ℝ) ^ j) (by positivity)
  set n : ℕ → ℕ := fun j => j + ∑ k ∈ Finset.range (j+1), N k with hn_def
  have hn_ge : ∀ j, j ≤ n j := fun j => Nat.le_add_right _ _
  have hNn : ∀ j, N j ≤ n j := fun j =>
    le_add_left (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.self_mem_range_succ j))
  have hn_mono : Monotone n := by
    intro a b hab
    exact Nat.add_le_add hab (Finset.sum_le_sum_of_subset (Finset.range_mono (by omega)))
  set w : E2 → ℝ := fun x => limUnder atTop (fun t => v (n t) x) with hw_def
  have hae : ∀ i, ∀ᵐ x ∂(volume.restrict (K i)),
      Tendsto (fun t => v (n t) x) atTop (𝓝 (w x)) := by
    intro i
    have hclaim : ∀ T a b : ℕ, T ≤ a → T ≤ b →
        eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K i)) <
          ENNReal.ofReal ((1/2:ℝ) ^ T) := by
      intro T a b ha hb
      have hM1 : N (T + i) ≤ n (a + i) := (hNn _).trans (hn_mono (by omega))
      have hM2 : N (T + i) ≤ n (b + i) := (hNn _).trans (hn_mono (by omega))
      calc eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K i))
          ≤ eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K (T + i))) :=
            eLpNorm_mono_measure _ (Measure.restrict_mono (hKmono i (T+i) (by omega)) le_rfl)
        _ < ENNReal.ofReal ((1/2:ℝ) ^ (T + i)) := hN (T + i) _ _ hM1 hM2
        _ ≤ ENNReal.ofReal ((1/2:ℝ) ^ T) :=
            ENNReal.ofReal_le_ofReal (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega))
    have hBsum : ∑' T : ℕ, ENNReal.ofReal ((1/2:ℝ) ^ T) ≠ ⊤ := by
      rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) summable_geometric_two]
      exact ENNReal.ofReal_ne_top
    have hc := MeasureTheory.Lp.ae_tendsto_of_cauchy_eLpNorm (f := fun t => v (n (t + i)))
      (fun t => (hvK (n (t + i)) i).aestronglyMeasurable) (by norm_num : (1:ENNReal) ≤ 2)
      hBsum hclaim
    filter_upwards [hc] with x hx
    obtain ⟨l, hl⟩ := hx
    have hl' : Tendsto (fun t => v (n t) x) atTop (𝓝 l) :=
      (Filter.tendsto_add_atTop_iff_nat (f := fun t => v (n t) x) i).1 hl
    exact tendsto_nhds_limUnder ⟨l, hl'⟩
  
  have hlim : ∀ i, MemLp w 2 (volume.restrict (K i)) ∧ ∀ ε : ℝ, 0 < ε → ∃ N' : ℕ, ∀ m, N' ≤ m →
      eLpNorm (v m - w) 2 (volume.restrict (K i)) ≤ ENNReal.ofReal ε := by
    intro i
    have hw : AEStronglyMeasurable w (volume.restrict (K i)) :=
      aestronglyMeasurable_of_tendsto_ae atTop (fun t => (hvK (n t) i).aestronglyMeasurable) (hae i)
    have hbound : ∀ ε : ℝ, 0 < ε → ∃ N' : ℕ, ∀ m, N' ≤ m →
        eLpNorm (v m - w) 2 (volume.restrict (K i)) ≤ ENNReal.ofReal ε := by
      intro ε hε
      obtain ⟨N', hN'⟩ := hcauK i ε hε
      refine ⟨N', fun m hm => ?_⟩
      have hF := MeasureTheory.Lp.eLpNorm_lim_le_liminf_eLpNorm (p := 2)
        (fun t => (hvK m i).aestronglyMeasurable.sub (hvK (n t) i).aestronglyMeasurable) (v m - w) (by
          filter_upwards [hae i] with x hx
          simp only [Pi.sub_apply]
          exact tendsto_const_nhds.sub hx)
      refine hF.trans ?_
      refine Filter.liminf_le_of_frequently_le' ?_
      refine Filter.Eventually.frequently ?_
      filter_upwards [eventually_ge_atTop N'] with t ht
      exact (hN' m (n t) hm (ht.trans (hn_ge t))).le
    refine ⟨?_, hbound⟩
    obtain ⟨N₁, hN₁⟩ := hbound 1 one_pos
    have h1 : MemLp (v N₁ - w) 2 (volume.restrict (K i)) :=
      ⟨(hvK N₁ i).aestronglyMeasurable.sub hw,
        lt_of_le_of_lt (hN₁ N₁ le_rfl) ENNReal.ofReal_lt_top⟩
    have : w = v N₁ - (v N₁ - w) := by funext x; simp
    rw [this]
    exact (hvK N₁ i).sub h1
  
  refine ⟨w, fun L hL hLW => ?_, fun L hL hLW => ?_⟩
  · obtain ⟨j, hLj⟩ := hKabs L hL hLW
    exact (hlim j).1.mono_measure (Measure.restrict_mono hLj le_rfl)
  · obtain ⟨j, hLj⟩ := hKabs L hL hLW
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hη : 0 < Real.sqrt (ε / 2) := Real.sqrt_pos.2 (by positivity)
    obtain ⟨N', hN'⟩ := (hlim j).2 _ hη
    refine ⟨N', fun m hm => ?_⟩
    have hD : MemLp (v m - w) 2 (volume.restrict (K j)) := (hvK m j).sub (hlim j).1
    have h1 : ∫ x in K j, (v m x - w x) ^ 2 ≤ Real.sqrt (ε / 2) ^ 2 :=
      (s2 _ _ hD).2 _ hη.le (hN' m hm)
    rw [Real.sq_sqrt (by positivity)] at h1
    have h2 : ∫ x in L, (v m x - w x) ^ 2 ≤ ∫ x in K j, (v m x - w x) ^ 2 :=
      setIntegral_mono_set hD.integrable_sq (Eventually.of_forall fun x => sq_nonneg _)
        hLj.eventuallyLE
    have h3 : 0 ≤ ∫ x in L, (v m x - w x) ^ 2 :=
      setIntegral_nonneg hL.measurableSet (fun x _ => sq_nonneg _)
    rw [Real.dist_eq, sub_zero, abs_of_nonneg h3]
    linarith

theorem pcgb_ws_weak_deriv (W : Set E2) (hW : IsOpen W) (v : ℕ → E2 → ℝ)
    (hv : ∀ m, ContDiffOn ℝ ∞ (v m) W) (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W →
      MemLp w 2 (volume.restrict L) ∧ (∀ k, MemLp (G k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ x in L, (v m x - w x) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ x in L, (pd2 k (v m) x - G k x) ^ 2) atTop (𝓝 0)) :
    ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W →
      ∀ k : Fin 2, ∫ x, w x * pd2 k ζ x = -(∫ x, G k x * ζ x) :=
by
  intro ζ hζ hζc hζW k
  have hL : IsCompact (tsupport ζ) := hζc.isCompact
  obtain ⟨hwL, hGL, hvconv, hdconv⟩ := hL2 (tsupport ζ) hL hζW
  have hP := l2_compact_pairing (tsupport ζ) hL
  have hibp : ∀ m, ∫ x, v m x * pd2 k ζ x = -(∫ x, pd2 k (v m) x * ζ x) :=
    fun m => ibp_open_test W hW (v m) (hv m) ζ hζ hζc hζW k
  
  have hφc : Continuous (pd2 k ζ) := by
    have h1 : Continuous (fderiv ℝ ζ) := hζ.continuous_fderiv (by simp)
    exact h1.clm_apply continuous_const
  have hφs : tsupport (pd2 k ζ) ⊆ tsupport ζ := by
    refine subset_trans ?_ (tsupport_fderiv_subset ℝ (f := ζ))
    apply closure_mono
    intro x hx
    simp only [Function.mem_support] at hx ⊢
    intro h0
    apply hx
    show fderiv ℝ ζ x (e2 k) = 0
    rw [h0]
    rfl
  have hvm : ∀ m, MemLp (v m) 2 (volume.restrict (tsupport ζ)) :=
    fun m => hP.1 (v m) ((hv m).continuousOn.mono hζW)
  have hdm : ∀ m, MemLp (pd2 k (v m)) 2 (volume.restrict (tsupport ζ)) := by
    intro m
    refine hP.1 _ ?_
    have h1 : ContinuousOn (fun x => fderiv ℝ (v m) x (e2 k)) W :=
      ((hv m).continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
    exact h1.mono hζW
  have hA : Tendsto (fun m => ∫ x, v m x * pd2 k ζ x) atTop (𝓝 (∫ x, w x * pd2 k ζ x)) :=
    hP.2.2 v w (pd2 k ζ) hvm hwL hφc hφs hvconv
  have hB : Tendsto (fun m => ∫ x, pd2 k (v m) x * ζ x) atTop (𝓝 (∫ x, G k x * ζ x)) :=
    hP.2.2 (fun m => pd2 k (v m)) (G k) ζ hdm (hGL k) hζ.continuous subset_rfl (hdconv k)
  have hA' : Tendsto (fun m => -(∫ x, pd2 k (v m) x * ζ x)) atTop
      (𝓝 (∫ x, w x * pd2 k ζ x)) := by
    have hfun : (fun m => ∫ x, v m x * pd2 k ζ x) = (fun m => -(∫ x, pd2 k (v m) x * ζ x)) :=
      funext hibp
    rw [← hfun]
    exact hA
  exact tendsto_nhds_unique hA' hB.neg

theorem pcgb_ws_test_pairing {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (f : X → ℝ) (hfc : ∀ j, ContinuousOn (fun x => f (P.param j x)) (P.W j))
    (j : Fin P.n) (ζ : E2 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ)
    (hζs : tsupport ζ ⊆ P.W j ∩ {x | 0 < b (P.param j x)}) :
    ∃ Z : X → ℝ, (∀ i, ContDiffOn ℝ ∞ (fun x => Z (P.param i x)) (P.W i)) ∧
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → Z q = 0) ∧
      (∀ c : Fin 2,
        Continuous (fun x => ∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) ∧
        tsupport (fun x => ∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) ⊆
          tsupport ζ) ∧
      Integrable (fun x => Real.sqrt (P.h j x).det * f (P.param j x) * ζ x) ∧
      (∀ v : X → ℝ, (∀ i, ContDiffOn ℝ ∞ (fun x => v (P.param i x)) (P.W i)) →
        eigWInt P ρ (eigGam P v Z) = ∑ c : Fin 2, ∫ x, pd2 c (fun y => v (P.param j y)) x *
          (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) ∧
      eigWInt P ρ (fun i x => f (P.param i x) * Z (P.param i x)) =
        ∫ x, Real.sqrt (P.h j x).det * f (P.param j x) * ζ x :=
by
  classical
  have hT : IsCompact (tsupport ζ) := hζc.isCompact
  have hTW : tsupport ζ ⊆ P.W j := fun x hx => (hζs hx).1
  have hTb : ∀ x ∈ tsupport ζ, 0 < b (P.param j x) := fun x hx => (hζs hx).2
  have hζ0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
  have hP1 : ∀ i, ∀ x ∈ P.W i, P.param i x ∈ P.O i ∧ P.param i x ∈ S := by
    intro i x hx
    have hmem : P.param i x ∈ P.param i '' P.W i := ⟨x, hx, rfl⟩
    rw [P.image_eq i] at hmem
    exact hmem
  have hP3 : ∀ i k, ∀ x ∈ P.W i ∩ P.param i ⁻¹' P.O k,
      P.proj k (P.param i x) ∈ P.W k ∧ P.param k (P.proj k (P.param i x)) = P.param i x := by
    intro i k x hx
    have hq : P.param i x ∈ P.O k ∩ S := ⟨hx.2, (hP1 i x hx.1).2⟩
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, hyx⟩ := hq
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  have hd : ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) :=
    (elr_coeff_smooth (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)).2.1.continuousOn
  
  obtain ⟨Z, hZ1, hZ2, hZ3, hZ4⟩ := eig_lift_smooth S P j ζ hζ hζc hTW
  have hZj : ∀ x ∈ P.W j, Z (P.param j x) = ζ x := by
    intro x hx
    rw [hZ3 _ (hP1 j x hx).1, P.proj_param j x hx]
  have hZjd : ∀ x ∈ P.W j, ∀ a : Fin 2, pd2 a (fun y => Z (P.param j y)) x = pd2 a ζ x := by
    intro x hx a
    have hev : (fun y => Z (P.param j y)) =ᶠ[𝓝 x] ζ :=
      Filter.eventuallyEq_of_mem ((P.W_open j).mem_nhds hx) (fun y hy => hZj y hy)
    unfold pd2
    rw [hev.fderiv_eq]
  have hZoff : ∀ i, ∀ x ∈ P.W i, P.param i x ∉ P.param j '' tsupport ζ →
      Z (P.param i x) = 0 ∧ ∀ a : Fin 2, pd2 a (fun y => Z (P.param i y)) x = 0 := by
    intro i x hx hnot
    have hev : (fun y => Z (P.param i y)) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) := hZ4 i x hx hnot
    refine ⟨hev.self_of_nhds, fun a => ?_⟩
    unfold pd2
    rw [hev.fderiv_eq]
    simp
  
  have hadm : ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → Z q = 0 := by
    have key : ∀ c : ℝ, (∀ y ∈ tsupport ζ, c ≤ b (P.param j y)) →
        ∀ q ∈ S, b q < c → Z q = 0 := by
      intro c hc q hqS hbq
      by_cases hqO : q ∈ P.O j
      · have hq : q ∈ P.O j ∩ S := ⟨hqO, hqS⟩
        rw [← P.image_eq j] at hq
        obtain ⟨y, hy, hyq⟩ := hq
        rw [← hyq, hZj y hy]
        apply hζ0
        intro hyT
        have h1 := hc y hyT
        rw [hyq] at h1
        linarith
      · exact hZ2 q hqO
    rcases Set.eq_empty_or_nonempty (tsupport ζ) with hE | hne
    · refine ⟨1, one_pos, key 1 ?_⟩
      intro y hy
      simp [hE] at hy
    · obtain ⟨x₁, hx₁, hmin⟩ := hT.exists_isMinOn hne ((hb j).continuousOn.mono hTW)
      refine ⟨b (P.param j x₁), hTb x₁ hx₁, key _ ?_⟩
      intro y hy
      exact isMinOn_iff.mp hmin y hy
  
  have hPL : ∀ y ∈ P.W j, y ∉ tsupport ζ → P.param j y ∉ P.param j '' tsupport ζ := by
    rintro y hy hyL ⟨y', hy', heq⟩
    apply hyL
    have e := congrArg (P.proj j) heq
    rw [P.proj_param j y' (hTW hy'), P.proj_param j y hy] at e
    rw [← e]
    exact hy'
  have hAo : ∀ i, IsOpen (P.W i ∩ P.param i ⁻¹' P.O j) := fun i =>
    (P.param_cont i).isOpen_inter_preimage (P.W_open i) (P.O_open j)
  have hloc : ∀ F : Fin P.n → E2 → ℝ, (∀ i, ContinuousOn (F i) (P.W i)) →
      (∀ i, ∀ x ∈ P.W i ∩ P.param i ⁻¹' P.O j, F i x = F j (P.proj j (P.param i x))) →
      (∀ i, ∀ x ∈ P.W i, P.param i x ∉ P.param j '' tsupport ζ → F i x = 0) →
      eigWInt P ρ F = ∫ x in P.W j, F j x * Real.sqrt (P.h j x).det := by
    intro F hF hcompat hL0
    have s2 : ∀ i,
        (∫ x in P.W i ∩ P.param i ⁻¹' P.O j,
            ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det) =
          (∫ y in P.W j, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det) := by
      intro i
      obtain ⟨hc1, -⟩ := eig_chart_cov S P i j (fun y => ρ i (P.param j y) * F j y)
      have hEq : Set.EqOn (fun x => ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det)
          (fun x => ρ i (P.param j (P.proj j (P.param i x))) * F j (P.proj j (P.param i x)) *
            Real.sqrt (P.h i x).det)
          (P.W i ∩ P.param i ⁻¹' P.O j) := by
        intro x hx
        show ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det =
          ρ i (P.param j (P.proj j (P.param i x))) * F j (P.proj j (P.param i x)) *
            Real.sqrt (P.h i x).det
        rw [(hP3 i j x hx).2, hcompat i x hx]
      have hzero : ∀ y ∈ P.W j \ (P.W j ∩ P.param j ⁻¹' P.O i),
          ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det = 0 := by
        intro y hy
        have hy' : P.param j y ∉ P.O i := fun h => hy.2 ⟨hy.1, h⟩
        rw [hρO i _ hy', zero_mul, zero_mul]
      calc (∫ x in P.W i ∩ P.param i ⁻¹' P.O j,
            ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det)
          = ∫ x in P.W i ∩ P.param i ⁻¹' P.O j,
              ρ i (P.param j (P.proj j (P.param i x))) * F j (P.proj j (P.param i x)) *
                Real.sqrt (P.h i x).det :=
            MeasureTheory.setIntegral_congr_fun (hAo i).measurableSet hEq
        _ = ∫ y in P.W j ∩ P.param j ⁻¹' P.O i,
              ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det := hc1
        _ = ∫ y in P.W j, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det :=
            (MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
              (P.W_open j).measurableSet Set.inter_subset_left hzero).symm
    have hgi : ∀ i, MeasureTheory.IntegrableOn
        (fun y => ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det) (P.W j)
        MeasureTheory.volume := by
      intro i
      have hc : ContinuousOn
          (fun y => ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det) (P.W j) :=
        (((hρs i j).continuousOn).mul (hF j)).mul hd
      have hiL := (hc.mono hTW).integrableOn_compact (μ := MeasureTheory.volume) hT
      refine hiL.of_forall_diff_eq_zero (P.W_open j).measurableSet ?_
      intro y hy
      show ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det = 0
      rw [hL0 j y hy.1 (hPL y hy.1 hy.2), mul_zero, zero_mul]
    have hWj : ∀ i, (∫ x in P.W i, ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det) =
        ∫ y in P.W j, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det := by
      intro i
      rw [← s2 i]
      apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
        (P.W_open i).measurableSet Set.inter_subset_left
      intro x hx
      have hxO : P.param i x ∉ P.O j := fun h => hx.2 ⟨hx.1, h⟩
      have hxL : P.param i x ∉ P.param j '' tsupport ζ := by
        rintro ⟨y', hy', heq⟩
        apply hxO
        rw [← heq]
        exact (hP1 j y' (hTW hy')).1
      rw [hL0 i x hx.1 hxL, mul_zero, zero_mul]
    have hP7 : ∀ y ∈ P.W j,
        (∑ i, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det) =
          F j y * Real.sqrt (P.h j y).det := by
      intro y hy
      by_cases hyL : y ∈ tsupport ζ
      · rw [← Finset.sum_mul, ← Finset.sum_mul,
          hρ1 _ (hP1 j y hy).2 (hTb y hyL).le, one_mul]
      · rw [hL0 j y hy (hPL y hy hyL)]
        simp
    have hswap := MeasureTheory.integral_finset_sum
      (μ := MeasureTheory.volume.restrict (P.W j)) Finset.univ (fun i _ => hgi i)
    calc eigWInt P ρ F
        = ∑ i, ∫ x in P.W i, ρ i (P.param i x) * F i x * Real.sqrt (P.h i x).det := rfl
      _ = ∑ i, ∫ y in P.W j, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det :=
          Finset.sum_congr rfl (fun i _ => hWj i)
      _ = ∫ y in P.W j, ∑ i, ρ i (P.param j y) * F j y * Real.sqrt (P.h j y).det :=
          hswap.symm
      _ = ∫ x in P.W j, F j x * Real.sqrt (P.h j x).det :=
          MeasureTheory.setIntegral_congr_fun (P.W_open j).measurableSet hP7
  
  have hcpt : ∀ g : E2 → ℝ, ContinuousOn g (P.W j) → (∀ x, x ∉ tsupport ζ → g x = 0) →
      Continuous g ∧ Integrable g := by
    intro g hg h0
    have hsupp : Function.support g ⊆ tsupport ζ := by
      intro x hx
      by_contra hxT
      exact hx (h0 x hxT)
    have hts : tsupport g ⊆ tsupport ζ := closure_minimal hsupp (isClosed_tsupport ζ)
    have hcont : Continuous g := hg.continuous_of_tsupport_subset (P.W_open j) (hts.trans hTW)
    have hcs : HasCompactSupport g := hT.of_isClosed_subset (isClosed_tsupport g) hts
    exact ⟨hcont, hcont.integrable_of_hasCompactSupport hcs⟩
  
  have hel := (el_coeff_continuous (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j)
    (fun _ => 0) contDiffOn_const ζ hζ hζc hTW).1
  have hφ : ∀ c : Fin 2,
      Continuous (fun x => ∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) ∧
      tsupport (fun x => ∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) ⊆
        tsupport ζ := by
    intro c
    refine ⟨continuous_finset_sum _ (fun a _ => (hel a c).1), ?_⟩
    apply closure_minimal _ (isClosed_tsupport ζ)
    intro x hx
    by_contra hxT
    apply hx
    apply Finset.sum_eq_zero
    intro a _
    exact image_eq_zero_of_notMem_tsupport
      (f := fun x => Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)
      (fun h => hxT ((hel a c).2 h))
  have hφz : ∀ (c : Fin 2) (x : E2), x ∉ tsupport ζ →
      (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) = 0 := by
    intro c x hx
    exact image_eq_zero_of_notMem_tsupport
      (f := fun x => ∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)
      (fun h => hx ((hφ c).2 h))
  
  have hint : Integrable (fun x => Real.sqrt (P.h j x).det * f (P.param j x) * ζ x) :=
    (hcpt _ ((hd.mul (hfc j)).mul hζ.continuous.continuousOn)
      (fun x hx => by simp [hζ0 x hx])).2
  
  have hB : ∀ v : X → ℝ, (∀ i, ContDiffOn ℝ ∞ (fun x => v (P.param i x)) (P.W i)) →
      eigWInt P ρ (eigGam P v Z) = ∑ c : Fin 2, ∫ x, pd2 c (fun y => v (P.param j y)) x *
        (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) := by
    intro v hv
    have h1 := hloc (eigGam P v Z) (fun i => (eig_gam_facts S P v Z hv hZ1 i).1)
      (fun i x hx => eig_grad_pair_compat S P v Z hv hZ1 i j x hx)
      (fun i x hx hnot => by
        unfold eigGam
        apply Finset.sum_eq_zero
        intro a _
        apply Finset.sum_eq_zero
        intro b _
        rw [(hZoff i x hx hnot).2 a, mul_zero])
    rw [h1]
    have hgc : ∀ c : Fin 2,
        ContinuousOn (fun x => pd2 c (fun y => v (P.param j y)) x) (P.W j) := fun c =>
      ((hv j).continuousOn_fderiv_of_isOpen (P.W_open j) (by simp)).clm_apply continuousOn_const
    have hgi : ∀ c : Fin 2, Integrable (fun x => pd2 c (fun y => v (P.param j y)) x *
        (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) :=
      fun c => (hcpt _ ((hgc c).mul (hφ c).1.continuousOn)
        (fun x hx => by simp only [hφz c x hx, mul_zero])).2
    calc (∫ x in P.W j, eigGam P v Z j x * Real.sqrt (P.h j x).det)
        = ∫ x in P.W j, ∑ c : Fin 2, pd2 c (fun y => v (P.param j y)) x *
            (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) := by
          apply MeasureTheory.setIntegral_congr_fun (P.W_open j).measurableSet
          intro x hx
          simp only [eigGam, hZjd x hx, Fin.sum_univ_two]
          ring
      _ = ∫ x, ∑ c : Fin 2, pd2 c (fun y => v (P.param j y)) x *
            (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x) := by
          apply MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero
          intro x hx
          have hxT : x ∉ tsupport ζ := fun h => hx (hTW h)
          simp only [hφz _ x hxT, mul_zero, Finset.sum_const_zero]
      _ = _ := MeasureTheory.integral_finset_sum _ (fun c _ => hgi c)
  
  have hΛ : eigWInt P ρ (fun i x => f (P.param i x) * Z (P.param i x)) =
      ∫ x, Real.sqrt (P.h j x).det * f (P.param j x) * ζ x := by
    rw [hloc (fun i x => f (P.param i x) * Z (P.param i x))
      (fun i => (hfc i).mul (hZ1 i).continuousOn)
      (fun i x hx => by
        show f (P.param i x) * Z (P.param i x) =
          f (P.param j (P.proj j (P.param i x))) * Z (P.param j (P.proj j (P.param i x)))
        rw [(hP3 i j x hx).2])
      (fun i x hx hnot => by
        show f (P.param i x) * Z (P.param i x) = 0
        rw [(hZoff i x hx hnot).1, mul_zero])]
    calc (∫ x in P.W j, f (P.param j x) * Z (P.param j x) * Real.sqrt (P.h j x).det)
        = ∫ x in P.W j, Real.sqrt (P.h j x).det * f (P.param j x) * ζ x := by
          apply MeasureTheory.setIntegral_congr_fun (P.W_open j).measurableSet
          intro x hx
          simp only [hZj x hx]
          ring
      _ = _ := by
          apply MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero
          intro x hx
          simp [hζ0 x (fun h => hx (hTW h))]
  exact ⟨Z, hZ1, hadm, hφ, hint, hB, hΛ⟩

theorem pcgb_ds_weak_solution {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0)
    (f : X → ℝ) (hfc : ∀ j, ContinuousOn (fun x => f (P.param j x)) (P.W j))
    (hpoinc : ∃ C : ℝ, 0 ≤ C ∧ ∀ u : X → ℝ,
      (∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) →
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u q = 0) →
      eigWInt P ρ (fun j x => u (P.param j x) ^ 2) ≤ C * eigWInt P ρ (eigGam P u u)) :
    ∃ (u : ℕ → X → ℝ) (w : Fin P.n → E2 → ℝ) (G : Fin P.n → Fin 2 → E2 → ℝ),
      (∀ m j, ContDiffOn ℝ ∞ (fun x => u m (P.param j x)) (P.W j)) ∧
      (∀ m, ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → u m q = 0) ∧
      (∀ j (L : Set E2), IsCompact L → L ⊆ P.W j →
        MemLp (w j) 2 (volume.restrict L) ∧ (∀ k, MemLp (G j k) 2 (volume.restrict L)) ∧
        Tendsto (fun m => ∫ x in L, (u m (P.param j x) - w j x) ^ 2) atTop (𝓝 0) ∧
        ∀ k, Tendsto (fun m => ∫ x in L,
          (pd2 k (fun y => u m (P.param j y)) x - G j k x) ^ 2) atTop (𝓝 0)) ∧
      (∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j →
        ∀ k : Fin 2, ∫ x, w j x * pd2 k ζ x = -(∫ x, G j k x * ζ x)) ∧
      (∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
        tsupport ζ ⊆ P.W j ∩ {x | 0 < b (P.param j x)} →
        ∫ x, ((∑ a : Fin 2, ∑ c : Fin 2,
            Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * G j c x * pd2 a ζ x) +
          Real.sqrt (P.h j x).det * f (P.param j x) * ζ x) = 0) ∧
      (∀ j k, ∀ᵐ x ∂(volume.restrict (P.W j ∩ P.param j ⁻¹' P.O k)),
        w j x = w k (P.proj k (P.param j x))) :=
by
  
  obtain ⟨u, hua, hub, hcau, hEL⟩ :=
    pcgb_ws_var_seq S P ρ Kc hρnn hρs hK hρK b f hfc hpoinc
  
  have hdiff : ∀ (v : X → ℝ) j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j) →
      ∀ x ∈ P.W j, DifferentiableAt ℝ (fun y => v (P.param j y)) x :=
    fun v j hv x hx => (hv.contDiffAt ((P.W_open j).mem_nhds hx)).differentiableAt (by simp)
  have hpdcG : ∀ (v : X → ℝ) j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j) →
      ∀ k : Fin 2, ContinuousOn (fun x => pd2 k (fun y => v (P.param j y)) x) (P.W j) := by
    intro v j hv k
    exact (hv.continuousOn_fderiv_of_isOpen (P.W_open j) (by simp)).clm_apply continuousOn_const
  have hEc : ∀ (v : X → ℝ) j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j) →
      ContinuousOn (fun x => v (P.param j x) ^ 2 +
        ∑ k : Fin 2, (pd2 k (fun y => v (P.param j y)) x) ^ 2) (P.W j) := by
    intro v j hv
    exact (hv.continuousOn.pow 2).add
      (continuousOn_finset_sum _ fun k _ => (hpdcG v j hv k).pow 2)
  have hsub_adm : ∀ m l,
      (∀ i, ContDiffOn ℝ ∞ (fun x => (u m - u l) (P.param i x)) (P.W i)) ∧
      (∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → (u m - u l) q = 0) := by
    intro m l
    refine ⟨fun i => (hua m i).sub (hua l i), ?_⟩
    obtain ⟨c₁, hc₁, h₁⟩ := hub m
    obtain ⟨c₂, hc₂, h₂⟩ := hub l
    refine ⟨min c₁ c₂, lt_min hc₁ hc₂, fun q hq hbq => ?_⟩
    simp only [Pi.sub_apply, h₁ q hq (lt_of_lt_of_le hbq (min_le_left _ _)),
      h₂ q hq (lt_of_lt_of_le hbq (min_le_right _ _)), sub_zero]
  have hpdsub : ∀ m l j (k : Fin 2), ∀ x ∈ P.W j,
      pd2 k (fun y => (u m - u l) (P.param j y)) x =
        pd2 k (fun y => u m (P.param j y)) x - pd2 k (fun y => u l (P.param j y)) x := by
    intro m l j k x hx
    show fderiv ℝ (fun y => u m (P.param j y) - u l (P.param j y)) x (e2 k) = _
    rw [fderiv_fun_sub (hdiff (u m) j (hua m j) x hx) (hdiff (u l) j (hua l j) x hx),
      ContinuousLinearMap.sub_apply]
    rfl
  
  have hcauchyV : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ,
      ∀ m l, N ≤ m → N ≤ l →
        ∫ x in L, ((u m - u l) (P.param j x) ^ 2 +
          ∑ k : Fin 2, (pd2 k (fun y => (u m - u l) (P.param j y)) x) ^ 2) < ε := by
    intro j L hL hLW ε hε
    obtain ⟨C, hC0, hC⟩ :=
      pcgb_ws_local_control S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1 hpoinc j L hL hLW
    have hC1 : (0 : ℝ) < C + 1 := by linarith
    obtain ⟨N, hN⟩ := hcau (ε / (C + 1)) (div_pos hε hC1)
    refine ⟨N, fun m l hm hl => ?_⟩
    have h1 := hC (u m - u l) (hsub_adm m l).1 (hsub_adm m l).2
    have h2 := hN m l hm hl
    have h3 : C * eigWInt P ρ (eigGam P (u m - u l) (u m - u l)) ≤ C * (ε / (C + 1)) :=
      mul_le_mul_of_nonneg_left h2.le hC0
    have h4 : C * (ε / (C + 1)) < ε := by
      rw [mul_div_assoc', div_lt_iff₀ hC1]
      nlinarith
    linarith
  have hvalC : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ,
      ∀ m l, N ≤ m → N ≤ l →
        ∫ x in L, ((fun m x => u m (P.param j x)) m x - (fun m x => u m (P.param j x)) l x) ^ 2
          < ε := by
    intro j L hL hLW ε hε
    obtain ⟨N, hN⟩ := hcauchyV j L hL hLW ε hε
    refine ⟨N, fun m l hm hl => lt_of_le_of_lt ?_ (hN m l hm hl)⟩
    apply setIntegral_mono_on
    · exact ((((hua m j).continuousOn.sub (hua l j).continuousOn).pow 2).mono hLW).integrableOn_compact hL
    · exact ((hEc (u m - u l) j ((hsub_adm m l).1 j)).mono hLW).integrableOn_compact hL
    · exact hL.measurableSet
    · intro x _
      have e : (u m - u l) (P.param j x) = u m (P.param j x) - u l (P.param j x) := rfl
      have h0 : 0 ≤ ∑ k : Fin 2, (pd2 k (fun y => (u m - u l) (P.param j y)) x) ^ 2 :=
        Finset.sum_nonneg (fun k _ => sq_nonneg _)
      rw [e]
      show (u m (P.param j x) - u l (P.param j x)) ^ 2 ≤ _
      linarith
  have hderC : ∀ j (k : Fin 2) (L : Set E2), IsCompact L → L ⊆ P.W j → ∀ ε : ℝ, 0 < ε →
      ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l →
        ∫ x in L, ((fun m x => pd2 k (fun y => u m (P.param j y)) x) m x -
          (fun m x => pd2 k (fun y => u m (P.param j y)) x) l x) ^ 2 < ε := by
    intro j k L hL hLW ε hε
    obtain ⟨N, hN⟩ := hcauchyV j L hL hLW ε hε
    refine ⟨N, fun m l hm hl => lt_of_le_of_lt ?_ (hN m l hm hl)⟩
    apply setIntegral_mono_on
    · exact ((((hpdcG (u m) j (hua m j) k).sub (hpdcG (u l) j (hua l j) k)).pow 2).mono
        hLW).integrableOn_compact hL
    · exact ((hEc (u m - u l) j ((hsub_adm m l).1 j)).mono hLW).integrableOn_compact hL
    · exact hL.measurableSet
    · intro x hx
      show (pd2 k (fun y => u m (P.param j y)) x - pd2 k (fun y => u l (P.param j y)) x) ^ 2 ≤ _
      rw [← hpdsub m l j k x (hLW hx)]
      have h0 : 0 ≤ (u m - u l) (P.param j x) ^ 2 := sq_nonneg _
      have h1 : (pd2 k (fun y => (u m - u l) (P.param j y)) x) ^ 2 ≤
          ∑ k' : Fin 2, (pd2 k' (fun y => (u m - u l) (P.param j y)) x) ^ 2 :=
        Finset.single_le_sum (f := fun k' => (pd2 k' (fun y => (u m - u l) (P.param j y)) x) ^ 2)
          (fun i _ => sq_nonneg _) (Finset.mem_univ k)
      linarith
  
  have hW : ∀ j, ∃ wj : E2 → ℝ,
      (∀ L : Set E2, IsCompact L → L ⊆ P.W j → MemLp wj 2 (volume.restrict L)) ∧
      ∀ L : Set E2, IsCompact L → L ⊆ P.W j →
        Tendsto (fun m => ∫ x in L, (u m (P.param j x) - wj x) ^ 2) atTop (𝓝 0) :=
    fun j => pcgb_ws_l2loc_limit (P.W j) (P.W_open j) (fun m x => u m (P.param j x))
      (fun m => (hua m j).continuousOn) (hvalC j)
  have hG : ∀ j (k : Fin 2), ∃ Gjk : E2 → ℝ,
      (∀ L : Set E2, IsCompact L → L ⊆ P.W j → MemLp Gjk 2 (volume.restrict L)) ∧
      ∀ L : Set E2, IsCompact L → L ⊆ P.W j →
        Tendsto (fun m => ∫ x in L, (pd2 k (fun y => u m (P.param j y)) x - Gjk x) ^ 2)
          atTop (𝓝 0) :=
    fun j k => pcgb_ws_l2loc_limit (P.W j) (P.W_open j)
      (fun m x => pd2 k (fun y => u m (P.param j y)) x)
      (fun m => hpdcG (u m) j (hua m j) k) (hderC j k)
  choose w hwL2 hwconv using hW
  choose G hGL2 hGconv using hG
  have hc : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j →
      MemLp (w j) 2 (volume.restrict L) ∧ (∀ k, MemLp (G j k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ x in L, (u m (P.param j x) - w j x) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ x in L,
        (pd2 k (fun y => u m (P.param j y)) x - G j k x) ^ 2) atTop (𝓝 0) :=
    fun j L hL hLW => ⟨hwL2 j L hL hLW, fun k => hGL2 j k L hL hLW, hwconv j L hL hLW,
      fun k => hGconv j k L hL hLW⟩
  
  have hd : ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j →
      ∀ k : Fin 2, ∫ x, w j x * pd2 k ζ x = -(∫ x, G j k x * ζ x) :=
    fun j => pcgb_ws_weak_deriv (P.W j) (P.W_open j) (fun m y => u m (P.param j y))
      (fun m => hua m j) (w j) (G j) (hc j)
  
  have he : ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ P.W j ∩ {x | 0 < b (P.param j x)} →
      ∫ x, ((∑ a : Fin 2, ∑ c : Fin 2,
          Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * G j c x * pd2 a ζ x) +
        Real.sqrt (P.h j x).det * f (P.param j x) * ζ x) = 0 := by
    intro j ζ hζ hζc hζs
    obtain ⟨Z, hZ1, hZ2, hφ, hint, hB, hΛ⟩ :=
      pcgb_ws_test_pairing S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1 f hfc j ζ hζ hζc hζs
    have hT : IsCompact (tsupport ζ) := hζc.isCompact
    have hTW : tsupport ζ ⊆ P.W j := fun x hx => (hζs hx).1
    have hP := l2_compact_pairing (tsupport ζ) hT
    have hrw : ∀ n, eigWInt P ρ (eigGam P (u n) Z) +
        eigWInt P ρ (fun i x => f (P.param i x) * Z (P.param i x)) =
        (∑ c : Fin 2, ∫ x, pd2 c (fun y => u n (P.param j y)) x *
          (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) +
        ∫ x, Real.sqrt (P.h j x).det * f (P.param j x) * ζ x := by
      intro n
      rw [hB (u n) (hua n), hΛ]
    have hlim2 := (tendsto_congr hrw).mp (hEL Z hZ1 hZ2)
    have hpair : ∀ c : Fin 2, Tendsto (fun n => ∫ x, pd2 c (fun y => u n (P.param j y)) x *
        (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) atTop
        (𝓝 (∫ x, G j c x *
          (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x))) := by
      intro c
      exact hP.2.2 (fun n x => pd2 c (fun y => u n (P.param j y)) x) (G j c) _
        (fun n => hP.1 _ ((hpdcG (u n) j (hua n j) c).mono hTW)) (hGL2 j c _ hT hTW)
        (hφ c).1 (hφ c).2 (hGconv j c _ hT hTW)
    have hsum := (tendsto_finset_sum (Finset.univ : Finset (Fin 2))
      (fun c _ => hpair c)).add_const (∫ x, Real.sqrt (P.h j x).det * f (P.param j x) * ζ x)
    have heq := tendsto_nhds_unique hsum hlim2
    have hpt : ∀ x, ((∑ a : Fin 2, ∑ c : Fin 2,
          Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * G j c x * pd2 a ζ x) +
        Real.sqrt (P.h j x).det * f (P.param j x) * ζ x) =
        (∑ c : Fin 2, G j c x *
          (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) +
        Real.sqrt (P.h j x).det * f (P.param j x) * ζ x := by
      intro x
      simp only [Fin.sum_univ_two]
      ring
    have hintc : ∀ c : Fin 2, Integrable (fun x => G j c x *
        (∑ a : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a c * pd2 a ζ x)) :=
      fun c => hP.2.1 (G j c) _ (hGL2 j c _ hT hTW) (hφ c).1 (hφ c).2
    rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
      integral_add (integrable_finset_sum _ fun c _ => hintc c) hint,
      integral_finset_sum _ fun c _ => hintc c]
    exact heq
  
  have hg := pcr_dw_limit_compat S P u (fun m j => (hua m j).continuousOn) w hwL2 hwconv
  exact ⟨u, w, G, hua, hub, hc, hd, he, hg⟩

theorem pcgb_ds_interior_regularity (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (F : E2 → ℝ)
    (hF : ∀ x ∈ W, ∃ δ K : ℝ, 0 < δ ∧ Metric.ball x δ ⊆ W ∧
      ∀ y ∈ Metric.ball x δ, ∀ z ∈ Metric.ball x δ, |F y - F z| ≤ K * dist y z ^ (1 / 2 : ℝ))
    (Ws : Set E2) (hWs : IsOpen Ws) (hFs : ContDiffOn ℝ ∞ F (W ∩ Ws))
    (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W →
      MemLp w 2 (volume.restrict L) ∧ ∀ k, MemLp (G k) 2 (volume.restrict L))
    (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W →
      ∀ k : Fin 2, ∫ x, w x * pd2 k ζ x = -(∫ x, G k x * ζ x))
    (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W →
      ∫ x, ((∑ a : Fin 2, ∑ c : Fin 2,
          Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x) +
        Real.sqrt (h x).det * F x * ζ x) = 0) :
    ∃ w' : E2 → ℝ, ContDiffOn ℝ 2 w' W ∧ ContDiffOn ℝ ∞ w' (W ∩ Ws) ∧
      (∀ᵐ x ∂(volume.restrict W), w x = w' x) ∧ ∀ x ∈ W, lap2 h w' x = F x :=
by
  classical
  obtain ⟨hsqpos, hsqs, hinvs, hApos⟩ := elr_coeff_smooth W hW h hh hpd
  have hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (Real.sqrt (h x).det • (h x)⁻¹) a b) W := by
    intro a b
    simp only [Matrix.smul_apply, smul_eq_mul]
    exact hsqs.mul (hinvs a b)
  
  have hFc : ContinuousOn F W := by
    intro x hx
    obtain ⟨δ, K, hδ, -, hH⟩ := hF x hx
    apply ContinuousAt.continuousWithinAt
    have hcont : Continuous fun y : E2 => max K 0 * dist y x ^ (1 / 2 : ℝ) :=
      continuous_const.mul ((continuous_id.dist continuous_const).rpow_const
        (fun _ => Or.inr (by norm_num)))
    have hlim : Tendsto (fun y : E2 => max K 0 * dist y x ^ (1 / 2 : ℝ)) (𝓝 x) (𝓝 0) := by
      have := hcont.tendsto x
      simpa [Real.zero_rpow (by norm_num : (1 / 2 : ℝ) ≠ 0)] using this
    rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero' (Eventually.of_forall fun y => norm_nonneg _) ?_ hlim
    filter_upwards [Metric.ball_mem_nhds x hδ] with y hy
    rw [Real.norm_eq_abs]
    calc |F y - F x| ≤ K * dist y x ^ (1 / 2 : ℝ) := hH y hy x (Metric.mem_ball_self hδ)
      _ ≤ max K 0 * dist y x ^ (1 / 2 : ℝ) :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg dist_nonneg _)
  
  have hFhol0 : pcrHolLoc (1 / 2) 0 F W := by
    refine ⟨?_, ?_⟩
    · have : ContDiffOn ℝ 0 F W := contDiffOn_zero.mpr hFc
      exact_mod_cast this
    · intro x hx
      obtain ⟨δ, K, hδ, hball, hH⟩ := hF x hx
      refine ⟨δ, hδ, hball, K, fun y hy z hz => ?_⟩
      have e1 : iteratedFDeriv ℝ 0 F y - iteratedFDeriv ℝ 0 F z =
          (continuousMultilinearCurryFin0 ℝ E2 ℝ).symm (F y - F z) := by
        rw [iteratedFDeriv_zero_eq_comp, map_sub]
        rfl
      rw [e1, LinearIsometryEquiv.norm_map, Real.norm_eq_abs]
      exact hH y hy z hz
  obtain ⟨hTk1, -, hTk3⟩ := pcr_div_holLoc_toolkit (1 / 2) (by norm_num) (by norm_num) W hW
  have hFhol : pcrHolLoc (1 / 2) 0 (fun x => -(Real.sqrt (h x).det * F x)) W := by
    have h3 := hTk3 F (fun x => -Real.sqrt (h x).det) 0 hFhol0
      (hsqs.neg.of_le (WithTop.coe_le_coe.mpr le_top))
    refine hTk1 0 _ _ h3 (fun x _ => ?_)
    show (F x + 0) * -Real.sqrt (h x).det = -(Real.sqrt (h x).det * F x)
    ring
  
  have hweak' : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W →
      ∫ x, ∑ a : Fin 2, ∑ b : Fin 2, (Real.sqrt (h x).det • (h x)⁻¹) a b * G b x * pd2 a ζ x =
        ∫ x, -(Real.sqrt (h x).det * F x) * ζ x := by
    intro ζ hζ hζc hζW
    have hKc : IsCompact (tsupport ζ) := hζc.isCompact
    haveI : IsFiniteMeasure (volume.restrict (tsupport ζ)) :=
      isFiniteMeasure_restrict.mpr hKc.measure_lt_top.ne
    have hz : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
    have hdz : ∀ x, x ∉ tsupport ζ → ∀ a, pd2 a ζ x = 0 := by
      intro x hx a
      have : fderiv ℝ ζ x = 0 := by
        by_contra hne
        exact hx (support_fderiv_subset ℝ (Function.mem_support.mpr hne))
      simp [pd2, this]
    have hpdc : ∀ a, Continuous (pd2 a ζ) := fun a =>
      (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hGint : ∀ c, IntegrableOn (G c) (tsupport ζ) := fun c =>
      ((hL2 (tsupport ζ) hKc hζW).2 c).integrable (by norm_num)
    have hterm : ∀ a c : Fin 2,
        Integrable (fun x => Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x) := by
      intro a c
      have hco : ContinuousOn (fun x => Real.sqrt (h x).det * (h x)⁻¹ a c * pd2 a ζ x)
          (tsupport ζ) :=
        ((hsqs.continuousOn.mono hζW).mul ((hinvs a c).continuousOn.mono hζW)).mul
          (hpdc a).continuousOn
      have h1 : IntegrableOn
          (fun x => G c x * (Real.sqrt (h x).det * (h x)⁻¹ a c * pd2 a ζ x)) (tsupport ζ) :=
        (hGint c).mul_continuousOn hco hKc
      have heqf : (fun x => Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x) =
          (fun x => G c x * (Real.sqrt (h x).det * (h x)⁻¹ a c * pd2 a ζ x)) := by
        funext x
        ring
      rw [heqf]
      exact h1.integrable_of_forall_notMem_eq_zero (fun x hx => by simp [hdz x hx a])
    have hFt : Integrable (fun x => Real.sqrt (h x).det * F x * ζ x) := by
      have h1 : IntegrableOn (fun x => Real.sqrt (h x).det * F x * ζ x) (tsupport ζ) :=
        (((hsqs.continuousOn.mono hζW).mul (hFc.mono hζW)).mul
          hζ.continuous.continuousOn).integrableOn_compact hKc
      exact h1.integrable_of_forall_notMem_eq_zero (fun x hx => by simp [hz x hx])
    have hS : Integrable (fun x => ∑ a : Fin 2, ∑ c : Fin 2,
        Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x) := by
      refine integrable_finset_sum _ (fun a _ => ?_)
      exact integrable_finset_sum _ (fun c _ => hterm a c)
    have hw := hweak ζ hζ hζc hζW
    rw [integral_add hS hFt] at hw
    have e1 : (∫ x, ∑ a : Fin 2, ∑ b : Fin 2,
        (Real.sqrt (h x).det • (h x)⁻¹) a b * G b x * pd2 a ζ x) =
        ∫ x, ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x := by
      congr 1
    have e2 : (∫ x, -(Real.sqrt (h x).det * F x) * ζ x) =
        -∫ x, Real.sqrt (h x).det * F x * ζ x := by
      rw [← integral_neg]
      congr 1
      funext x
      ring
    rw [e1, e2]
    linarith
  
  obtain ⟨w₁, hw₁hol, hae, hdiv⟩ := pcr_div_local_schauder W hW
    (fun x => Real.sqrt (h x).det • (h x)⁻¹) hA hApos (1 / 2) (by norm_num) (by norm_num)
    (fun x => -(Real.sqrt (h x).det * F x)) hFhol w G hL2 hgrad hweak'
  have hw₁2 : ContDiffOn ℝ 2 w₁ W := by exact_mod_cast hw₁hol.1
  
  have hflux : ∀ a : Fin 2,
      (fun x' => ∑ b : Fin 2, (Real.sqrt (h x').det • (h x')⁻¹) a b * pd2 b w₁ x') =
        (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ a j * pd2 j w₁ z) := by
    intro a
    funext z
    simp only [Matrix.smul_apply, smul_eq_mul, Finset.mul_sum, mul_assoc]
  have hlap : ∀ x ∈ W, lap2 h w₁ x = F x := by
    intro x hx
    have e : (∑ a : Fin 2, pd2 a
        (fun x' => ∑ b : Fin 2, (Real.sqrt (h x').det • (h x')⁻¹) a b * pd2 b w₁ x') x) =
        Real.sqrt (h x).det * lap2 h w₁ x := by
      rw [← lap2_divergence_form W hW h w₁ hh hpd hw₁2 x hx, Fin.sum_univ_two]
      exact congrArg₂ (· + ·) (congrArg (fun f => pd2 0 f x) (hflux 0))
        (congrArg (fun f => pd2 1 f x) (hflux 1))
    have h2 : -(Real.sqrt (h x).det * lap2 h w₁ x) = -(Real.sqrt (h x).det * F x) := by
      rw [← e]
      exact hdiv x hx
    exact mul_left_cancel₀ (hsqpos x hx).ne' (neg_injective h2)
  
  have hU : IsOpen (W ∩ Ws) := hW.inter hWs
  have hL2s : ∀ f : E2 → ℝ, ContinuousOn f (W ∩ Ws) → ∀ L : Set E2, IsCompact L →
      L ⊆ W ∩ Ws → MemLp f 2 (volume.restrict L) := by
    intro f hf L hL hLU
    haveI : IsFiniteMeasure (volume.restrict L) :=
      isFiniteMeasure_restrict.mpr hL.measure_lt_top.ne
    obtain ⟨C, hC⟩ := hL.exists_bound_of_continuousOn (hf.mono hLU)
    refine MemLp.of_bound ((hf.mono hLU).aestronglyMeasurable hL.isClosed.measurableSet) C ?_
    exact (ae_restrict_iff' hL.isClosed.measurableSet).mpr (Eventually.of_forall hC)
  have hsob : ∀ (k : ℕ) (f : E2 → ℝ), ContDiffOn ℝ ∞ f (W ∩ Ws) → elrSob k (W ∩ Ws) f := by
    intro k
    induction k with
    | zero =>
      intro f hf
      simp only [elrSob]
      exact hL2s f hf.continuousOn
    | succ k ih =>
      intro f hf
      simp only [elrSob]
      refine ⟨hL2s f hf.continuousOn, fun m x => pd2 m f x, ?_, ?_⟩
      · intro ζ hζ hζc hζU m
        exact ibp_open_test (W ∩ Ws) hU f hf ζ hζ hζc hζU m
      · intro m
        apply ih
        have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) (W ∩ Ws) :=
          ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hf).2
        exact h1.clm_apply contDiffOn_const
  have hzero : ∀ k, elrSob k (W ∩ Ws) (fun _ => (0 : ℝ)) := fun k => hsob k _ contDiffOn_const
  have hf₀ : ContDiffOn ℝ ∞ (fun x => -(Real.sqrt (h x).det * F x)) (W ∩ Ws) :=
    ((hsqs.mono Set.inter_subset_left).mul hFs).neg
  have hSob : ∀ k : ℕ, elrSob (k + 2) (W ∩ Ws) w := by
    intro k
    refine elr_sob_bootstrap (W ∩ Ws) hU (fun x => Real.sqrt (h x).det • (h x)⁻¹)
      (fun a b => (hA a b).mono Set.inter_subset_left) (fun x hx => hApos x hx.1)
      (fun _ => 0) contDiffOn_const k w G (fun _ _ => 0) (fun x => -(Real.sqrt (h x).det * F x))
      (fun L hL hLU => hL2 L hL (hLU.trans Set.inter_subset_left))
      (fun ζ h1 h2 h3 => hgrad ζ h1 h2 (h3.trans Set.inter_subset_left))
      (fun _ => hzero (k + 1)) (hsob k _ hf₀) ?_
    intro ζ h1 h2 h3
    have := hweak' ζ h1 h2 (h3.trans Set.inter_subset_left)
    simp only [zero_mul, sub_zero, Finset.sum_const_zero, zero_add]
    exact this
  have hloc := elr_sob_smooth (W ∩ Ws) hU w hSob
  have hsm : ContDiffOn ℝ ∞ w₁ (W ∩ Ws) := by
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    obtain ⟨r, hr, hball, u, hu, hwu⟩ := hloc x hx
    refine ⟨Metric.ball x r, Metric.isOpen_ball, Metric.mem_ball_self hr, ?_⟩
    have hae1 : ∀ᵐ y ∂(volume.restrict (Metric.ball x r)), w y = w₁ y :=
      ae_restrict_of_ae_restrict_of_subset (hball.trans Set.inter_subset_left) hae
    have hae2 : w₁ =ᵐ[volume.restrict (Metric.ball x r)] u := by
      filter_upwards [hae1, hwu] with y h1 h2
      rw [← h1, h2]
    have heqon : Set.EqOn w₁ u (Metric.ball x r) :=
      Measure.eqOn_open_of_ae_eq hae2 Metric.isOpen_ball
        (hw₁2.continuousOn.mono (hball.trans Set.inter_subset_left)) hu.continuousOn
    exact (hu.congr heqon).mono Set.inter_subset_right
  exact ⟨w₁, hw₁2, hsm, hae, hlap⟩

theorem pcgb_bdr_flat_chart (W : Set E2) (hW : IsOpen W) (β : E2 → ℝ) (hβ : ContDiffOn ℝ ∞ β W)
    (x₀ : E2) (hx₀ : x₀ ∈ W) (hβ0 : β x₀ = 0) (hdβ : fderiv ℝ β x₀ ≠ 0) :
    ∃ (ρ : ℝ) (N : Set E2) (Φ Ψ : E2 → E2), 0 < ρ ∧ IsOpen N ∧ x₀ ∈ N ∧ N ⊆ W ∧ Φ x₀ = 0 ∧
      ContDiffOn ℝ ∞ Φ N ∧ ContDiffOn ℝ ∞ Ψ (Metric.ball (0 : E2) ρ) ∧
      (∀ x ∈ N, Φ x ∈ Metric.ball (0 : E2) ρ ∧ Ψ (Φ x) = x) ∧
      (∀ z ∈ Metric.ball (0 : E2) ρ, Ψ z ∈ N ∧ Φ (Ψ z) = z) ∧
      (∀ z ∈ Metric.ball (0 : E2) ρ, β (Ψ z) = z 0) ∧
      (∀ z ∈ Metric.ball (0 : E2) ρ, (fderiv ℝ Ψ z).det ≠ 0) :=
by
  classical
  
  obtain ⟨Φ, hΦs, hΦx₀, hΦc, hdet0⟩ : ∃ Φ : E2 → E2, ContDiffOn ℝ ∞ Φ W ∧ Φ x₀ = 0 ∧
      (∀ x, Φ x 0 = β x) ∧ (fderiv ℝ Φ x₀).det ≠ 0 := by
    obtain ⟨D, hD⟩ : ∃ D, fderiv ℝ β x₀ = D := ⟨_, rfl⟩
    rw [hD] at hdβ
    have hβd : HasFDerivAt β D x₀ := by
      rw [← hD]
      exact ((hβ.contDiffAt (hW.mem_nhds hx₀)).differentiableAt (by simp)).hasFDerivAt
    obtain ⟨d0, hd0⟩ : ∃ d0, D (e2 0) = d0 := ⟨_, rfl⟩
    obtain ⟨d1, hd1⟩ : ∃ d1, D (e2 1) = d1 := ⟨_, rfl⟩
    have hdec : ∀ y : E2, y = y 0 • e2 0 + y 1 • e2 1 := by
      intro y
      ext i
      fin_cases i <;> simp
    have hDy : ∀ y : E2, D y = y 0 * d0 + y 1 * d1 := by
      intro y
      calc D y = D (y 0 • e2 0 + y 1 • e2 1) := by rw [← hdec y]
        _ = y 0 * d0 + y 1 * d1 := by
          rw [map_add, map_smul, map_smul, hd0, hd1, smul_eq_mul, smul_eq_mul]
    have hcoord : ∀ c d : ℝ, (c • e2 0 + d • e2 1 : E2) 0 = c ∧
        (c • e2 0 + d • e2 1 : E2) 1 = d := by
      intro c d
      constructor <;> simp
    let ℓ : E2 →L[ℝ] ℝ :=
      (-d1) • EuclideanSpace.proj (0 : Fin 2) + d0 • EuclideanSpace.proj (1 : Fin 2)
    have hℓ : ∀ y : E2, ℓ y = -d1 * y 0 + d0 * y 1 := fun y => by simp [ℓ]
    let A : E2 →L[ℝ] E2 := D.smulRight (e2 0) + ℓ.smulRight (e2 1)
    have hAy : ∀ y, A y = D y • e2 0 + ℓ y • e2 1 := fun y => rfl
    have hA : HasFDerivAt (fun x => β x • e2 0 + (ℓ x - ℓ x₀) • e2 1) A x₀ :=
      (hβd.smul_const (e2 0)).add ((ℓ.hasFDerivAt.sub_const (ℓ x₀)).smul_const (e2 1))
    have hsq : d0 ^ 2 + d1 ^ 2 ≠ 0 := by
      intro h
      have h0' : d0 ^ 2 = 0 := by nlinarith [sq_nonneg d0, sq_nonneg d1]
      have h1' : d1 ^ 2 = 0 := by nlinarith [sq_nonneg d0, sq_nonneg d1]
      have h0 : d0 = 0 := (pow_eq_zero_iff two_ne_zero).mp h0'
      have h1 : d1 = 0 := (pow_eq_zero_iff two_ne_zero).mp h1'
      apply hdβ
      refine ContinuousLinearMap.ext fun y => ?_
      rw [hDy y, h0, h1]
      simp
    have hAinj : Function.Injective A := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      rw [hAy] at hy
      have e1 : D y = 0 := by
        have := (hcoord (D y) (ℓ y)).1
        rw [hy] at this
        simpa using this.symm
      have e2' : ℓ y = 0 := by
        have := (hcoord (D y) (ℓ y)).2
        rw [hy] at this
        simpa using this.symm
      rw [hDy] at e1
      rw [hℓ] at e2'
      have hy0 : (d0 ^ 2 + d1 ^ 2) * y 0 = 0 := by linear_combination d0 * e1 - d1 * e2'
      have hy1 : (d0 ^ 2 + d1 ^ 2) * y 1 = 0 := by linear_combination d1 * e1 + d0 * e2'
      rw [hdec y, (mul_eq_zero.mp hy0).resolve_left hsq, (mul_eq_zero.mp hy1).resolve_left hsq]
      simp
    have hdetA : A.det ≠ 0 := by
      have hu : IsUnit (A : E2 →ₗ[ℝ] E2) := by
        rw [LinearMap.isUnit_iff_ker_eq_bot]
        exact LinearMap.ker_eq_bot.mpr hAinj
      exact ((LinearMap.isUnit_iff_isUnit_det _).mp hu).ne_zero
    refine ⟨fun x => β x • e2 0 + (ℓ x - ℓ x₀) • e2 1, ?_, ?_, ?_, ?_⟩
    · exact (hβ.smul contDiffOn_const).add
        (((ℓ.contDiff.sub contDiff_const).smul contDiff_const).contDiffOn)
    · simp [hβ0]
    · intro x
      exact (hcoord _ _).1
    · rw [hA.fderiv]
      exact hdetA
  
  have hΦd : ∀ y ∈ W, HasFDerivAt Φ (fderiv ℝ Φ y) y := fun y hy =>
    ((hΦs.contDiffAt (hW.mem_nhds hy)).differentiableAt (by simp)).hasFDerivAt
  have hequiv : ∀ y, (fderiv ℝ Φ y).det ≠ 0 →
      ∃ f' : E2 ≃L[ℝ] E2, (f' : E2 →L[ℝ] E2) = fderiv ℝ Φ y :=
    fun y h => ⟨(LinearMap.equivOfDetNeZero (fderiv ℝ Φ y : E2 →ₗ[ℝ] E2) h).toContinuousLinearEquiv,
      ContinuousLinearMap.ext (fun _ => rfl)⟩
  obtain ⟨S, hSo, hSW, hx₀S, hSdet⟩ : ∃ S : Set E2, IsOpen S ∧ S ⊆ W ∧ x₀ ∈ S ∧
      ∀ y ∈ S, (fderiv ℝ Φ y).det ≠ 0 := by
    refine ⟨W ∩ ((fun f : E2 →L[ℝ] E2 => f.det) ∘ fderiv ℝ Φ) ⁻¹' {0}ᶜ, ?_,
      Set.inter_subset_left, ⟨hx₀, hdet0⟩, fun y hy => hy.2⟩
    exact (ContinuousLinearMap.continuous_det.comp_continuousOn
      (hΦs.continuousOn_fderiv_of_isOpen hW (by simp))).isOpen_inter_preimage hW
      isOpen_compl_singleton
  
  obtain ⟨f₀, hf₀⟩ := hequiv x₀ hdet0
  have hcd0 : ContDiffAt ℝ ∞ Φ x₀ := hΦs.contDiffAt (hW.mem_nhds hx₀)
  have hfd0 : HasFDerivAt Φ (f₀ : E2 →L[ℝ] E2) x₀ := by
    rw [hf₀]
    exact hΦd x₀ hx₀
  obtain ⟨eΦ, hecoe, hx₀e⟩ : ∃ eΦ : OpenPartialHomeomorph E2 E2, ⇑eΦ = Φ ∧ x₀ ∈ eΦ.source :=
    ⟨_, ContDiffAt.toOpenPartialHomeomorph_coe hcd0 hfd0 (by simp),
      ContDiffAt.mem_toOpenPartialHomeomorph_source hcd0 hfd0 (by simp)⟩
  have hT₀ : IsOpen (eΦ '' (eΦ.source ∩ S)) := eΦ.isOpen_image_source_inter hSo
  have h0T : (0 : E2) ∈ eΦ '' (eΦ.source ∩ S) := ⟨x₀, ⟨hx₀e, hx₀S⟩, by rw [hecoe]; exact hΦx₀⟩
  obtain ⟨ρ, hρ, hball⟩ := Metric.isOpen_iff.mp hT₀ 0 h0T
  have hB : ∀ z ∈ Metric.ball (0 : E2) ρ,
      z ∈ eΦ.target ∧ eΦ.symm z ∈ eΦ.source ∩ S ∧ Φ (eΦ.symm z) = z := by
    intro z hz
    obtain ⟨y, hy, hyz⟩ := hball hz
    have hΨz : eΦ.symm z = y := by
      rw [← hyz]
      exact eΦ.left_inv hy.1
    refine ⟨?_, ?_, ?_⟩
    · rw [← hyz]
      exact eΦ.map_source hy.1
    · rw [hΨz]
      exact hy
    · rw [hΨz, ← hyz, hecoe]
  have hΨs : ContDiffOn ℝ ∞ (⇑eΦ.symm) (Metric.ball (0 : E2) ρ) := by
    intro z hz
    obtain ⟨hzt, ⟨_, hyS⟩, _⟩ := hB z hz
    obtain ⟨f', hf'⟩ := hequiv (eΦ.symm z) (hSdet _ hyS)
    have h1 : HasFDerivAt (⇑eΦ) (f' : E2 →L[ℝ] E2) (eΦ.symm z) := by
      rw [hf', hecoe]
      exact hΦd _ (hSW hyS)
    have h2 : ContDiffAt ℝ ∞ (⇑eΦ) (eΦ.symm z) := by
      rw [hecoe]
      exact hΦs.contDiffAt (hW.mem_nhds (hSW hyS))
    exact (eΦ.contDiffAt_symm hzt h1 h2).contDiffWithinAt
  refine ⟨ρ, (eΦ.source ∩ S) ∩ Φ ⁻¹' Metric.ball (0 : E2) ρ, Φ, ⇑eΦ.symm, hρ, ?_, ?_, ?_, hΦx₀,
    ?_, hΨs, ?_, ?_, ?_, ?_⟩
  · exact (hΦs.continuousOn.mono (fun x hx => hSW hx.2)).isOpen_inter_preimage
      (eΦ.open_source.inter hSo) Metric.isOpen_ball
  · refine ⟨⟨hx₀e, hx₀S⟩, ?_⟩
    show Φ x₀ ∈ Metric.ball (0 : E2) ρ
    rw [hΦx₀]
    exact Metric.mem_ball_self hρ
  · exact fun x hx => hSW hx.1.2
  · exact hΦs.mono (fun x hx => hSW hx.1.2)
  · intro x hx
    refine ⟨hx.2, ?_⟩
    rw [← hecoe]
    exact eΦ.left_inv hx.1.1
  · intro z hz
    refine ⟨⟨(hB z hz).2.1, ?_⟩, (hB z hz).2.2⟩
    show Φ (eΦ.symm z) ∈ Metric.ball (0 : E2) ρ
    rw [(hB z hz).2.2]
    exact hz
  · intro z hz
    have := hΦc (eΦ.symm z)
    rw [(hB z hz).2.2] at this
    exact this.symm
  · intro z hz
    obtain ⟨_, ⟨_, hyS⟩, _⟩ := hB z hz
    have hdΦ : DifferentiableAt ℝ Φ (eΦ.symm z) := (hΦd _ (hSW hyS)).differentiableAt
    have hdΨ : DifferentiableAt ℝ (⇑eΦ.symm) z :=
      (hΨs.contDiffAt (Metric.isOpen_ball.mem_nhds hz)).differentiableAt (by simp)
    have hev : (Φ ∘ ⇑eΦ.symm) =ᶠ[𝓝 z] id :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz) (fun w hw => (hB w hw).2.2)
    have hcomp := fderiv_comp z hdΦ hdΨ
    rw [hev.fderiv_eq, fderiv_id] at hcomp
    intro h0
    have h1 : (ContinuousLinearMap.id ℝ E2).det =
        ((fderiv ℝ Φ (eΦ.symm z)).comp (fderiv ℝ (⇑eΦ.symm) z)).det := congrArg _ hcomp
    have h2 : ((fderiv ℝ Φ (eΦ.symm z)).comp (fderiv ℝ (⇑eΦ.symm) z)).det =
        (fderiv ℝ Φ (eΦ.symm z)).det * (fderiv ℝ (⇑eΦ.symm) z).det := LinearMap.det_comp _ _
    have h3 : (ContinuousLinearMap.id ℝ E2).det = 1 := LinearMap.det_id
    rw [h2, h3, h0, mul_zero] at h1
    exact one_ne_zero h1

theorem pcgb_bdr_pull_metric (B N : Set E2) (hB : IsOpen B) (hN : IsOpen N) (Ψ : E2 → E2)
    (hΨ : ContDiffOn ℝ ∞ Ψ B) (hΨBN : ∀ z ∈ B, Ψ z ∈ N)
    (hdet : ∀ z ∈ B, (fderiv ℝ Ψ z).det ≠ 0) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) N) (hpd : ∀ x ∈ N, (h x).PosDef) :
    (∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun z => pcgbBdrPull h Ψ z a c) B) ∧
    (∀ z ∈ B, (pcgbBdrPull h Ψ z).PosDef) ∧
    ∀ z ∈ B, ∀ g q : Fin 2 → ℝ,
      ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt (pcgbBdrPull h Ψ z).det * (pcgbBdrPull h Ψ z)⁻¹ a c *
          (∑ c' : Fin 2, fderiv ℝ Ψ z (e2 c) c' * g c') *
          (∑ a' : Fin 2, fderiv ℝ Ψ z (e2 a) a' * q a') =
        |(fderiv ℝ Ψ z).det| *
          ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt (h (Ψ z)).det * (h (Ψ z))⁻¹ a c * g c * q a :=
by
  classical
  
  have hD : ContDiffOn ℝ ∞ (fderiv ℝ Ψ) B :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hB).mp hΨ).2
  have hJs : ∀ c c' : Fin 2, ContDiffOn ℝ ∞ (fun z => fderiv ℝ Ψ z (e2 c) c') B := by
    intro c c'
    have h1 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ Ψ z (e2 c)) B :=
      hD.clm_apply contDiffOn_const
    exact (EuclideanSpace.proj c' : E2 →L[ℝ] ℝ).contDiff.comp_contDiffOn h1
  have hHs : ∀ c' d' : Fin 2, ContDiffOn ℝ ∞ (fun z => h (Ψ z) c' d') B :=
    fun c' d' => (hh c' d').comp hΨ (fun z hz => hΨBN z hz)
  have hS : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun z => pcgbBdrPull h Ψ z a c) B := by
    intro a c
    simp only [pcgbBdrPull, Matrix.of_apply]
    apply ContDiffOn.sum
    intro c' _
    apply ContDiffOn.sum
    intro d' _
    exact ((hJs a c').mul (hHs c' d')).mul (hJs c d')
  
  have hjac : ∀ f : E2 →L[ℝ] E2, (Matrix.of fun i j : Fin 2 => f (e2 j) i).det = f.det := by
    intro f
    let b := (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis
    have hm : LinearMap.toMatrix b b (f : E2 →ₗ[ℝ] E2) =
        Matrix.of fun i j : Fin 2 => f (e2 j) i := by
      ext i j
      rw [LinearMap.toMatrix_apply]
      simp [b, e2, OrthonormalBasis.coe_toBasis_repr_apply, EuclideanSpace.basisFun_repr]
    rw [← hm, LinearMap.det_toMatrix]
  
  have hPeq : ∀ z, pcgbBdrPull h Ψ z =
      (Matrix.of fun i j : Fin 2 => fderiv ℝ Ψ z (e2 j) i).transpose * h (Ψ z) *
        (Matrix.of fun i j : Fin 2 => fderiv ℝ Ψ z (e2 j) i) := by
    intro z
    ext c d
    simp only [pcgbBdrPull, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
      Fin.sum_univ_two]
    ring
  
  have hid : ∀ (J H P : Matrix (Fin 2) (Fin 2) ℝ), J.det ≠ 0 → 0 < H.det →
      P = J.transpose * H * J → ∀ g q : Fin 2 → ℝ,
      ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt P.det * P⁻¹ a c *
          (∑ c' : Fin 2, J c' c * g c') * (∑ a' : Fin 2, J a' a * q a') =
        |J.det| * ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt H.det * H⁻¹ a c * g c * q a := by
    intro J H P hJ hH hP g q
    have hdetP : P.det = J.det ^ 2 * H.det := by
      rw [hP, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      ring
    have hsqrt : Real.sqrt P.det = |J.det| * Real.sqrt H.det := by
      rw [hdetP, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    have eL : ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt P.det * P⁻¹ a c *
          (∑ c' : Fin 2, J c' c * g c') * (∑ a' : Fin 2, J a' a * q a') =
        Real.sqrt P.det * (P.det)⁻¹ * ∑ a : Fin 2, ∑ c : Fin 2, P.adjugate a c *
          (∑ c' : Fin 2, J c' c * g c') * (∑ a' : Fin 2, J a' a * q a') := by
      rw [Matrix.inv_def]
      simp only [Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul, Fin.sum_univ_two]
      ring
    have eR : ∑ a : Fin 2, ∑ c : Fin 2, Real.sqrt H.det * H⁻¹ a c * g c * q a =
        Real.sqrt H.det * (H.det)⁻¹ * ∑ a : Fin 2, ∑ c : Fin 2, H.adjugate a c * g c * q a := by
      rw [Matrix.inv_def]
      simp only [Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul, Fin.sum_univ_two]
      ring
    have hpoly : ∑ a : Fin 2, ∑ c : Fin 2, P.adjugate a c *
          (∑ c' : Fin 2, J c' c * g c') * (∑ a' : Fin 2, J a' a * q a') =
        J.det ^ 2 * ∑ a : Fin 2, ∑ c : Fin 2, H.adjugate a c * g c * q a := by
      rw [hP, Matrix.det_fin_two J]
      simp [Matrix.adjugate_fin_two, Fin.sum_univ_two, Matrix.mul_apply]
      ring
    rw [eL, eR, hpoly, hsqrt, hdetP]
    have hJ2 : J.det ^ 2 ≠ 0 := pow_ne_zero 2 hJ
    have hH0 : H.det ≠ 0 := hH.ne'
    field_simp
  refine ⟨hS, ?_, ?_⟩
  · intro z hz
    have hJdet : (Matrix.of fun i j : Fin 2 => fderiv ℝ Ψ z (e2 j) i).det ≠ 0 := by
      rw [hjac]; exact hdet z hz
    have hHpd : (h (Ψ z)).PosDef := hpd (Ψ z) (hΨBN z hz)
    have hJu : IsUnit (Matrix.of fun i j : Fin 2 => fderiv ℝ Ψ z (e2 j) i) :=
      (Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hJdet)
    have key := Matrix.PosDef.conjTranspose_mul_mul_same hHpd
      (Matrix.mulVec_injective_iff_isUnit.mpr hJu)
    rw [Matrix.conjTranspose_eq_transpose_of_trivial] at key
    rw [hPeq z]
    exact key
  · intro z hz g q
    have hJdet : (Matrix.of fun i j : Fin 2 => fderiv ℝ Ψ z (e2 j) i).det ≠ 0 := by
      rw [hjac]; exact hdet z hz
    have hHpd : (h (Ψ z)).PosDef := hpd (Ψ z) (hΨBN z hz)
    have key := hid _ (h (Ψ z)) (pcgbBdrPull h Ψ z) hJdet hHpd.det_pos (hPeq z) g q
    rw [hjac] at key
    simpa only [Matrix.of_apply] using key

theorem pcgb_bdr_l2_transport (W B : Set E2) (hW : IsOpen W) (hB : IsOpen B) (Ψ : E2 → E2)
    (hΨ : ContDiffOn ℝ ∞ Ψ B) (hΨBW : ∀ z ∈ B, Ψ z ∈ W) (hinj : Set.InjOn Ψ B)
    (hdet : ∀ z ∈ B, (fderiv ℝ Ψ z).det ≠ 0) (u : ℕ → E2 → ℝ)
    (hu : ∀ m, ContDiffOn ℝ ∞ (u m) W) (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W →
      MemLp w 2 (volume.restrict L) ∧ (∀ k, MemLp (G k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ x in L, (u m x - w x) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ x in L, (pd2 k (u m) x - G k x) ^ 2) atTop (𝓝 0)) :
    ∀ L : Set E2, IsCompact L → L ⊆ B →
      MemLp (fun z => w (Ψ z)) 2 (volume.restrict L) ∧
      (∀ k, MemLp (pcgbBdrVec G Ψ k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ z in L, (u m (Ψ z) - w (Ψ z)) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ z in L,
        (pd2 k (fun y => u m (Ψ y)) z - pcgbBdrVec G Ψ k z) ^ 2) atTop (𝓝 0) :=
by
  intro L hL hLB
  have hLm : MeasurableSet L := hL.isClosed.measurableSet
  have hΨc : ContinuousOn Ψ L := hΨ.continuousOn.mono hLB
  have hL'c : IsCompact (Ψ '' L) := hL.image_of_continuousOn hΨc
  have hL'W : Ψ '' L ⊆ W := by
    rintro _ ⟨z, hz, rfl⟩
    exact hΨBW z (hLB hz)
  haveI : IsFiniteMeasure (volume.restrict (Ψ '' L)) :=
    isFiniteMeasure_restrict.mpr hL'c.measure_lt_top.ne
  haveI : IsFiniteMeasure (volume.restrict L) :=
    isFiniteMeasure_restrict.mpr hL.measure_lt_top.ne
  obtain ⟨hw, hG, hval, hgrad⟩ := hL2 (Ψ '' L) hL'c hL'W
  
  have hcontL2 : ∀ S : Set E2, IsCompact S → ∀ f : E2 → ℝ, ContinuousOn f S →
      MemLp f 2 (volume.restrict S) := by
    intro S hS f hf
    haveI : IsFiniteMeasure (volume.restrict S) :=
      isFiniteMeasure_restrict.mpr hS.measure_lt_top.ne
    obtain ⟨M, hM⟩ := hS.exists_bound_of_continuousOn hf
    exact MemLp.of_bound (hf.aestronglyMeasurable hS.isClosed.measurableSet) M
      (ae_restrict_of_forall_mem hS.isClosed.measurableSet hM)
  
  have hDΨ : ContinuousOn (fderiv ℝ Ψ) B := hΨ.continuousOn_fderiv_of_isOpen hB (by simp)
  have hdiffΨ : ∀ z ∈ L, DifferentiableAt ℝ Ψ z := fun z hz =>
    (hΨ.differentiableOn (by simp)).differentiableAt (hB.mem_nhds (hLB hz))
  have hderiv : ∀ x ∈ L, HasFDerivWithinAt Ψ (fderiv ℝ Ψ x) L x := fun x hx =>
    (hdiffΨ x hx).hasFDerivAt.hasFDerivWithinAt
  have hinjL : Set.InjOn Ψ L := hinj.mono hLB
  have hdetc : ContinuousOn (fun z => (fderiv ℝ Ψ z).det) B :=
    ContinuousLinearMap.continuous_det.comp_continuousOn hDΨ
  have hδc : ContinuousOn (fun z => |(fderiv ℝ Ψ z).det|) L := (hdetc.mono hLB).abs
  have hδne : ∀ z ∈ L, |(fderiv ℝ Ψ z).det| ≠ 0 := fun z hz =>
    abs_ne_zero.mpr (hdet z (hLB hz))
  have hqc : ContinuousOn (fun z => |(fderiv ℝ Ψ z).det|⁻¹) L := hδc.inv₀ hδne
  obtain ⟨K, hK⟩ := hL.exists_bound_of_continuousOn hqc
  obtain ⟨C, hC0, hqC⟩ : ∃ C : ℝ, 0 ≤ C ∧ ∀ z ∈ L, |(fderiv ℝ Ψ z).det|⁻¹ ≤ C := by
    refine ⟨max K 0, le_max_right _ _, fun z hz => ?_⟩
    have h := hK z hz
    rw [Real.norm_eq_abs] at h
    exact (le_abs_self _).trans (h.trans (le_max_left _ _))
  
  have hcov : ∀ φ : E2 → ℝ, MemLp φ 2 (volume.restrict (Ψ '' L)) →
      MemLp (fun z => φ (Ψ z)) 2 (volume.restrict L) ∧
      ∫ z in L, φ (Ψ z) ^ 2 ≤ C * ∫ x in Ψ '' L, φ x ^ 2 := by
    intro φ hφ
    have hφi : IntegrableOn φ (Ψ '' L) := hφ.integrable (by norm_num)
    have h1 : IntegrableOn (fun z => |(fderiv ℝ Ψ z).det| • φ (Ψ z)) L :=
      (integrableOn_image_iff_integrableOn_abs_det_fderiv_smul volume hLm hderiv hinjL φ).mp hφi
    have hmeas : AEStronglyMeasurable (fun z => φ (Ψ z)) (volume.restrict L) := by
      have h2 : AEStronglyMeasurable (fun z => |(fderiv ℝ Ψ z).det|⁻¹ *
          (|(fderiv ℝ Ψ z).det| • φ (Ψ z))) (volume.restrict L) :=
        (hqc.aestronglyMeasurable hLm).mul h1.aestronglyMeasurable
      refine h2.congr ?_
      refine ae_restrict_of_forall_mem hLm (fun z hz => ?_)
      simp only [smul_eq_mul]
      exact inv_mul_cancel_left₀ (hδne z hz) _
    have hφ2 : IntegrableOn (fun x => φ x ^ 2) (Ψ '' L) := hφ.integrable_sq
    have h3 : IntegrableOn (fun z => |(fderiv ℝ Ψ z).det| • φ (Ψ z) ^ 2) L :=
      (integrableOn_image_iff_integrableOn_abs_det_fderiv_smul volume hLm hderiv hinjL
        (fun x => φ x ^ 2)).mp hφ2
    have heq : ∫ x in Ψ '' L, φ x ^ 2 = ∫ z in L, |(fderiv ℝ Ψ z).det| • φ (Ψ z) ^ 2 :=
      integral_image_eq_integral_abs_det_fderiv_smul volume hLm hderiv hinjL (fun x => φ x ^ 2)
    have hpt : ∀ z ∈ L, φ (Ψ z) ^ 2 ≤ C * (|(fderiv ℝ Ψ z).det| • φ (Ψ z) ^ 2) := by
      intro z hz
      rw [smul_eq_mul]
      calc φ (Ψ z) ^ 2 = |(fderiv ℝ Ψ z).det|⁻¹ * (|(fderiv ℝ Ψ z).det| * φ (Ψ z) ^ 2) :=
            (inv_mul_cancel_left₀ (hδne z hz) _).symm
        _ ≤ C * (|(fderiv ℝ Ψ z).det| * φ (Ψ z) ^ 2) :=
            mul_le_mul_of_nonneg_right (hqC z hz) (mul_nonneg (abs_nonneg _) (sq_nonneg _))
    have h4 : IntegrableOn (fun z => C * (|(fderiv ℝ Ψ z).det| • φ (Ψ z) ^ 2)) L :=
      h3.const_mul C
    have hint : Integrable (fun z => φ (Ψ z) ^ 2) (volume.restrict L) := by
      refine h4.mono' (hmeas.pow 2) ?_
      refine ae_restrict_of_forall_mem hLm (fun z hz => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact hpt z hz
    refine ⟨(memLp_two_iff_integrable_sq hmeas).mpr hint, ?_⟩
    calc ∫ z in L, φ (Ψ z) ^ 2 ≤ ∫ z in L, C * (|(fderiv ℝ Ψ z).det| • φ (Ψ z) ^ 2) :=
          setIntegral_mono_on hint h4 hLm hpt
      _ = C * ∫ x in Ψ '' L, φ x ^ 2 := by rw [integral_const_mul, heq]
  
  have ha : ∀ k c : Fin 2, ContinuousOn (fun z => fderiv ℝ Ψ z (e2 k) c) L := fun k c =>
    ((EuclideanSpace.proj c : E2 →L[ℝ] ℝ).continuous.comp_continuousOn
      (hDΨ.clm_apply continuousOn_const)).mono hLB
  
  have hws : ∀ k : Fin 2, ∃ M : ℝ, 0 ≤ M ∧ ∀ φ : Fin 2 → E2 → ℝ,
      (∀ c, MemLp (φ c) 2 (volume.restrict L)) →
      MemLp (fun z => ∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z) 2 (volume.restrict L) ∧
      ∫ z in L, (∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z) ^ 2 ≤
        M * ∑ c : Fin 2, ∫ z in L, φ c z ^ 2 := by
    intro k
    obtain ⟨A0, hA0⟩ := hL.exists_bound_of_continuousOn (ha k 0)
    obtain ⟨A1, hA1⟩ := hL.exists_bound_of_continuousOn (ha k 1)
    refine ⟨2 * (|A0| + |A1|) ^ 2, by positivity, fun φ hφ => ?_⟩
    have hb : ∀ c : Fin 2, ∀ z ∈ L, |fderiv ℝ Ψ z (e2 k) c| ≤ |A0| + |A1| := by
      refine Fin.forall_fin_two.mpr ⟨fun z hz => ?_, fun z hz => ?_⟩
      · have h := hA0 z hz
        rw [Real.norm_eq_abs] at h
        exact h.trans ((le_abs_self _).trans (le_add_of_nonneg_right (abs_nonneg _)))
      · have h := hA1 z hz
        rw [Real.norm_eq_abs] at h
        exact h.trans ((le_abs_self _).trans (le_add_of_nonneg_left (abs_nonneg _)))
    have hmeas : AEStronglyMeasurable (fun z => ∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z)
        (volume.restrict L) := by
      simp only [Fin.sum_univ_two]
      exact (((ha k 0).aestronglyMeasurable hLm).mul (hφ 0).aestronglyMeasurable).add
        (((ha k 1).aestronglyMeasurable hLm).mul (hφ 1).aestronglyMeasurable)
    have hdom : Integrable (fun z => 2 * (|A0| + |A1|) ^ 2 * (φ 0 z ^ 2 + φ 1 z ^ 2))
        (volume.restrict L) :=
      ((hφ 0).integrable_sq.add (hφ 1).integrable_sq).const_mul (2 * (|A0| + |A1|) ^ 2)
    have hpt : ∀ z ∈ L, (∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z) ^ 2 ≤
        2 * (|A0| + |A1|) ^ 2 * (φ 0 z ^ 2 + φ 1 z ^ 2) := by
      intro z hz
      rw [Fin.sum_univ_two]
      have h0 := hb 0 z hz
      have h1 := hb 1 z hz
      have s0 : (fderiv ℝ Ψ z (e2 k) 0) ^ 2 ≤ (|A0| + |A1|) ^ 2 :=
        sq_le_sq' (abs_le.mp h0).1 (abs_le.mp h0).2
      have s1 : (fderiv ℝ Ψ z (e2 k) 1) ^ 2 ≤ (|A0| + |A1|) ^ 2 :=
        sq_le_sq' (abs_le.mp h1).1 (abs_le.mp h1).2
      nlinarith [sq_nonneg (fderiv ℝ Ψ z (e2 k) 0 * φ 0 z - fderiv ℝ Ψ z (e2 k) 1 * φ 1 z),
        mul_le_mul_of_nonneg_right s0 (sq_nonneg (φ 0 z)),
        mul_le_mul_of_nonneg_right s1 (sq_nonneg (φ 1 z))]
    have hint : Integrable (fun z => (∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z) ^ 2)
        (volume.restrict L) := by
      refine hdom.mono' (hmeas.pow 2) (ae_restrict_of_forall_mem hLm fun z hz => ?_)
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      exact hpt z hz
    refine ⟨(memLp_two_iff_integrable_sq hmeas).mpr hint, ?_⟩
    calc ∫ z in L, (∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * φ c z) ^ 2
        ≤ ∫ z in L, 2 * (|A0| + |A1|) ^ 2 * (φ 0 z ^ 2 + φ 1 z ^ 2) :=
          setIntegral_mono_on hint hdom hLm hpt
      _ = 2 * (|A0| + |A1|) ^ 2 * ∑ c : Fin 2, ∫ z in L, φ c z ^ 2 := by
        rw [integral_const_mul, integral_add (hφ 0).integrable_sq (hφ 1).integrable_sq,
          Fin.sum_univ_two]
  
  have hchain : ∀ (f : E2 → ℝ) (z : E2), DifferentiableAt ℝ Ψ z →
      DifferentiableAt ℝ f (Ψ z) → ∀ k : Fin 2,
      pd2 k (fun y => f (Ψ y)) z = ∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c * pd2 c f (Ψ z) := by
    intro f z hΨz hfz k
    have hcomp : fderiv ℝ (fun y => f (Ψ y)) z = (fderiv ℝ f (Ψ z)).comp (fderiv ℝ Ψ z) :=
      fderiv_comp z hfz hΨz
    unfold pd2
    rw [hcomp, ContinuousLinearMap.comp_apply]
    set v := fderiv ℝ Ψ z (e2 k) with hvdef
    have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_add, map_smul, map_smul, Fin.sum_univ_two, smul_eq_mul, smul_eq_mul]
  refine ⟨(hcov w hw).1, fun k => ?_, ?_, fun k => ?_⟩
  · obtain ⟨M, -, hM⟩ := hws k
    exact (hM (fun c z => G c (Ψ z)) (fun c => (hcov (G c) (hG c)).1)).1
  · have hum : ∀ m, MemLp (fun x => u m x - w x) 2 (volume.restrict (Ψ '' L)) := fun m =>
      (hcontL2 _ hL'c (u m) ((hu m).continuousOn.mono hL'W)).sub hw
    refine squeeze_zero (fun m => integral_nonneg (fun _ => sq_nonneg _))
      (fun m => (hcov _ (hum m)).2) ?_
    have h := hval.const_mul C
    simp only [mul_zero] at h
    exact h
  · obtain ⟨M, hM0, hM⟩ := hws k
    have hpdc : ∀ m (c : Fin 2), ContinuousOn (pd2 c (u m)) W := fun m c =>
      ((hu m).continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
    have hψ : ∀ m (c : Fin 2), MemLp (fun x => pd2 c (u m) x - G c x) 2
        (volume.restrict (Ψ '' L)) :=
      fun m c => (hcontL2 _ hL'c _ ((hpdc m c).mono hL'W)).sub (hG c)
    have hbound : ∀ m, ∫ z in L, (pd2 k (fun y => u m (Ψ y)) z - pcgbBdrVec G Ψ k z) ^ 2 ≤
        M * ((C * ∫ x in Ψ '' L, (pd2 0 (u m) x - G 0 x) ^ 2) +
          C * ∫ x in Ψ '' L, (pd2 1 (u m) x - G 1 x) ^ 2) := by
      intro m
      have hφ : ∀ c, MemLp (fun z => pd2 c (u m) (Ψ z) - G c (Ψ z)) 2 (volume.restrict L) :=
        fun c => (hcov _ (hψ m c)).1
      have hEq : ∫ z in L, (pd2 k (fun y => u m (Ψ y)) z - pcgbBdrVec G Ψ k z) ^ 2 =
          ∫ z in L, (∑ c : Fin 2, fderiv ℝ Ψ z (e2 k) c *
            (pd2 c (u m) (Ψ z) - G c (Ψ z))) ^ 2 := by
        refine setIntegral_congr_fun hLm (fun z hz => ?_)
        have huz : DifferentiableAt ℝ (u m) (Ψ z) :=
          ((hu m).differentiableOn (by simp)).differentiableAt (hW.mem_nhds (hΨBW z (hLB hz)))
        beta_reduce
        rw [hchain (u m) z (hdiffΨ z hz) huz k]
        unfold pcgbBdrVec
        simp only [Fin.sum_univ_two]
        ring
      rw [hEq]
      refine (hM (fun c z => pd2 c (u m) (Ψ z) - G c (Ψ z)) hφ).2.trans ?_
      rw [Fin.sum_univ_two]
      exact mul_le_mul_of_nonneg_left (add_le_add (hcov _ (hψ m 0)).2 (hcov _ (hψ m 1)).2) hM0
    refine squeeze_zero (fun m => integral_nonneg (fun _ => sq_nonneg _)) hbound ?_
    have h := (((hgrad 0).const_mul C).add ((hgrad 1).const_mul C)).const_mul M
    simp only [mul_zero, add_zero] at h
    exact h

theorem pcgb_bdr_weak_transport (W N B : Set E2) (hN : IsOpen N) (hB : IsOpen B) (hNW : N ⊆ W)
    (Φ Ψ : E2 → E2) (hΦ : ContDiffOn ℝ ∞ Φ N) (hΨ : ContDiffOn ℝ ∞ Ψ B)
    (hΦN : ∀ x ∈ N, Φ x ∈ B ∧ Ψ (Φ x) = x) (hΨB : ∀ z ∈ B, Ψ z ∈ N ∧ Φ (Ψ z) = z)
    (β : E2 → ℝ) (hβΨ : ∀ z ∈ B, β (Ψ z) = z 0)
    (A At : E2 → Matrix (Fin 2) (Fin 2) ℝ) (G Gt : Fin 2 → E2 → ℝ)
    (hid : ∀ z ∈ B, ∀ q : Fin 2 → ℝ,
      ∑ a : Fin 2, ∑ c : Fin 2, At z a c * Gt c z * (∑ a' : Fin 2, fderiv ℝ Ψ z (e2 a) a' * q a') =
        |(fderiv ℝ Ψ z).det| * ∑ a : Fin 2, ∑ c : Fin 2, A (Ψ z) a c * G c (Ψ z) * q a)
    (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ W ∩ {x | 0 < β x} →
      ∫ x, ∑ a : Fin 2, ∑ c : Fin 2, A x a c * G c x * pd2 a ζ x = 0) :
    ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ B ∩ {z | 0 < z 0} →
      ∫ z, ∑ a : Fin 2, ∑ c : Fin 2, At z a c * Gt c z * pd2 a ζ z = 0 :=
by
  intro ξ hξ hξc hξs
  classical
  have hKc : IsCompact (tsupport ξ) := hξc.isCompact
  have hKB : tsupport ξ ⊆ B := hξs.trans Set.inter_subset_left
  have hΨc : ContinuousOn Ψ B := hΨ.continuousOn
  have hK'c : IsCompact (Ψ '' tsupport ξ) := hKc.image_of_continuousOn (hΨc.mono hKB)
  have hK'cl : IsClosed (Ψ '' tsupport ξ) := hK'c.isClosed
  have hK'N : Ψ '' tsupport ξ ⊆ N := by
    rintro _ ⟨z, hz, rfl⟩
    exact (hΨB z (hKB hz)).1
  obtain ⟨ζ, hζdef⟩ : ∃ ζ : E2 → ℝ, ζ = N.indicator (fun x => ξ (Φ x)) := ⟨_, rfl⟩
  have hζN : ∀ x ∈ N, ζ x = ξ (Φ x) := fun x hx => by
    rw [hζdef]; exact Set.indicator_of_mem hx _
  have hζoff : ∀ y, y ∉ Ψ '' tsupport ξ → ζ y = 0 := by
    intro y hy
    by_cases hyN : y ∈ N
    · rw [hζN y hyN]
      apply image_eq_zero_of_notMem_tsupport
      intro hΦK
      apply hy
      exact ⟨Φ y, hΦK, (hΦN y hyN).2⟩
    · rw [hζdef]; exact Set.indicator_of_notMem hyN _
  have hζs : ContDiff ℝ ∞ ζ := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hyN : y ∈ N
    · have hev : ζ =ᶠ[𝓝 y] (ξ ∘ Φ) :=
        Filter.eventually_of_mem (hN.mem_nhds hyN) (fun x hx => hζN x hx)
      exact (ContDiffAt.comp y hξ.contDiffAt
        (hΦ.contDiffAt (hN.mem_nhds hyN))).congr_of_eventuallyEq hev
    · have hyK : y ∉ Ψ '' tsupport ξ := fun h => hyN (hK'N h)
      have hev : ζ =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) :=
        Filter.eventually_of_mem (hK'cl.isOpen_compl.mem_nhds hyK) (fun x hx => hζoff x hx)
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hζc : HasCompactSupport ζ := HasCompactSupport.intro hK'c hζoff
  have hζt : tsupport ζ ⊆ Ψ '' tsupport ξ := by
    apply closure_minimal _ hK'cl
    intro y hy
    by_contra h
    exact hy (hζoff y h)
  have hζΨ : ∀ z ∈ B, ζ (Ψ z) = ξ z := by
    intro z hz
    rw [hζN _ (hΨB z hz).1, (hΨB z hz).2]
  have hζW : tsupport ζ ⊆ W ∩ {x | 0 < β x} := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := hζt hx
    have hzB := hKB hz
    refine ⟨hNW (hΨB z hzB).1, ?_⟩
    show 0 < β (Ψ z)
    rw [hβΨ z hzB]
    exact (hξs hz).2
  have h0 := hweak ζ hζs hζc hζW
  have hloc : ∫ x in Ψ '' B, (∑ a : Fin 2, ∑ c : Fin 2, A x a c * G c x * pd2 a ζ x) =
      ∫ x, ∑ a : Fin 2, ∑ c : Fin 2, A x a c * G c x * pd2 a ζ x := by
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have hxt : x ∉ tsupport ζ := fun h => hx (Set.image_mono hKB (hζt h))
    have hfd : fderiv ℝ ζ x = 0 := fderiv_of_notMem_tsupport ℝ hxt
    simp [pd2, hfd]
  have hdiff : ∀ z ∈ B, DifferentiableAt ℝ Ψ z := fun z hz =>
    (hΨ.contDiffAt (hB.mem_nhds hz)).differentiableAt (by simp)
  have hinj : Set.InjOn Ψ B := by
    intro a ha b hb hab
    rw [← (hΨB a ha).2, ← (hΨB b hb).2, hab]
  have hcov := integral_image_eq_integral_abs_det_fderiv_smul volume hB.measurableSet
    (fun z hz => (hdiff z hz).hasFDerivAt.hasFDerivWithinAt) hinj
    (fun x => ∑ a : Fin 2, ∑ c : Fin 2, A x a c * G c x * pd2 a ζ x)
  have hpt : ∀ z ∈ B, |(fderiv ℝ Ψ z).det| •
      (∑ a : Fin 2, ∑ c : Fin 2, A (Ψ z) a c * G c (Ψ z) * pd2 a ζ (Ψ z)) =
      ∑ a : Fin 2, ∑ c : Fin 2, At z a c * Gt c z * pd2 a ξ z := by
    intro z hz
    have hchain : ∀ a : Fin 2, pd2 a ξ z =
        ∑ a' : Fin 2, fderiv ℝ Ψ z (e2 a) a' * pd2 a' ζ (Ψ z) := by
      intro a
      have hev : ξ =ᶠ[𝓝 z] (ζ ∘ Ψ) :=
        Filter.eventually_of_mem (hB.mem_nhds hz) (fun y hy => (hζΨ y hy).symm)
      have hζd : DifferentiableAt ℝ ζ (Ψ z) := hζs.differentiable (by simp) _
      unfold pd2
      rw [hev.fderiv_eq, fderiv_comp z hζd (hdiff z hz), ContinuousLinearMap.comp_apply]
      have hv : fderiv ℝ Ψ z (e2 a) =
          ∑ a' : Fin 2, fderiv ℝ Ψ z (e2 a) a' • e2 a' := by
        ext i
        fin_cases i <;> simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two]
      conv_lhs => rw [hv]
      rw [map_sum]
      simp [map_smul, smul_eq_mul]
    simp only [hchain]
    rw [hid z hz (fun a' => pd2 a' ζ (Ψ z)), smul_eq_mul]
  have hzloc : ∫ z in B, (∑ a : Fin 2, ∑ c : Fin 2, At z a c * Gt c z * pd2 a ξ z) =
      ∫ z, ∑ a : Fin 2, ∑ c : Fin 2, At z a c * Gt c z * pd2 a ξ z := by
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro z hz
    have hzt : z ∉ tsupport ξ := fun h => hz (hKB h)
    have hfd : fderiv ℝ ξ z = 0 := fderiv_of_notMem_tsupport ℝ hzt
    simp [pd2, hfd]
  rw [← hzloc, ← setIntegral_congr_fun hB.measurableSet (fun z hz => hpt z hz), ← hcov, hloc, h0]

theorem pcgb_flat2_split : ∃ T : E3 ≃ᵐ (E2 × ℝ),
    MeasureTheory.MeasurePreserving T MeasureTheory.volume MeasureTheory.volume ∧
    ∀ x : E3, T x = (pcgbF2P x, x 2) :=
by
  refine ⟨(MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm.trans
    ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 2).trans
    (MeasurableEquiv.prodComm.trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)) (MeasurableEquiv.refl ℝ)))),
    ?_, ?_⟩
  · exact (MeasureTheory.MeasurePreserving.prod (PiLp.volume_preserving_toLp (Fin 2))
      (MeasureTheory.MeasurePreserving.id (MeasureTheory.volume : MeasureTheory.Measure ℝ))).comp
      ((MeasureTheory.Measure.measurePreserving_swap).comp
      ((MeasureTheory.measurePreserving_piFinSuccAbove
        (fun _ : Fin 3 => (MeasureTheory.volume : MeasureTheory.Measure ℝ)) 2).comp
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3))))
  · intro x
    have hx : ((MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm.trans
        ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 2).trans
        (MeasurableEquiv.prodComm.trans
        (MeasurableEquiv.prodCongr (MeasurableEquiv.toLp 2 (Fin 2 → ℝ))
          (MeasurableEquiv.refl ℝ))))) x
        = (WithLp.toLp 2 (fun j : Fin 2 => x.ofLp (Fin.succAbove (2 : Fin 3) j)), x.ofLp 2) := rfl
    rw [hx]
    refine Prod.ext ?_ rfl
    show WithLp.toLp 2 (fun j : Fin 2 => x.ofLp (Fin.succAbove (2 : Fin 3) j)) = pcgbF2P x
    ext j
    fin_cases j
    · show x 0 = pcgbF2P x 0
      simp [pcgbF2P, e2, EuclideanSpace.single_apply]
    · show x 1 = pcgbF2P x 1
      simp [pcgbF2P, e2, EuclideanSpace.single_apply]

theorem pcgb_flat2_coeff_lift (ρ : ℝ) (hρ : 0 < ρ) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun z => A z a b) (Metric.ball (0 : E2) ρ))
    (hAs : ∀ z ∈ Metric.ball (0 : E2) ρ, ∀ a b : Fin 2, A z a b = A z b a)
    (hApos : ∀ z ∈ Metric.ball (0 : E2) ρ, (A z).PosDef) :
    (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => pcgbF2A A x a b) (Metric.ball (0 : E3) ρ)) ∧
    (∀ x ∈ Metric.ball (0 : E3) ρ, ∀ a b : Fin 3, pcgbF2A A x a b = pcgbF2A A x b a) ∧
    (∀ x ∈ Metric.ball (0 : E3) ρ, (pcgbF2A A x).PosDef) :=
by
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x; simp [pcgbF2P, e2, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x; simp [pcgbF2P, e2, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hPn : ∀ x : E3, ‖pcgbF2P x‖ ≤ ‖x‖ := by
    intro x
    have h1 := hnsq2 (pcgbF2P x)
    rw [hP0, hP1] at h1
    have h2 := hnsq3 x
    nlinarith [sq_nonneg (x 2), norm_nonneg (pcgbF2P x), norm_nonneg x]
  have hPball : ∀ x ∈ Metric.ball (0 : E3) ρ, pcgbF2P x ∈ Metric.ball (0 : E2) ρ := by
    intro x hx
    rw [mem_ball_zero_iff] at hx ⊢
    exact lt_of_le_of_lt (hPn x) hx
  have hmaps : Set.MapsTo (⇑pcgbF2P) (Metric.ball (0 : E3) ρ) (Metric.ball (0 : E2) ρ) :=
    fun x hx => hPball x hx
  have hcomp : ∀ i j : Fin 2,
      ContDiffOn ℝ ∞ (fun x => A (pcgbF2P x) i j) (Metric.ball (0 : E3) ρ) :=
    fun i j => (hA i j).comp pcgbF2P.contDiff.contDiffOn hmaps
  have hsym : ∀ x ∈ Metric.ball (0 : E3) ρ, ∀ a b : Fin 3,
      pcgbF2A A x a b = pcgbF2A A x b a := by
    intro x hx a b
    fin_cases a <;> fin_cases b <;> simp [pcgbF2A]
    · exact hAs (pcgbF2P x) (hPball x hx) 0 1
    · exact hAs (pcgbF2P x) (hPball x hx) 1 0
  refine ⟨?_, hsym, ?_⟩
  · intro a b
    fin_cases a <;> fin_cases b
    · exact hcomp 0 0
    · exact hcomp 0 1
    · exact contDiffOn_const
    · exact hcomp 1 0
    · exact hcomp 1 1
    · exact contDiffOn_const
    · exact contDiffOn_const
    · exact contDiffOn_const
    · exact contDiffOn_const
  · intro x hx
    have hA' := hApos (pcgbF2P x) (hPball x hx)
    refine Matrix.PosDef.of_dotProduct_mulVec_pos ?_ ?_
    · exact Matrix.IsHermitian.ext (fun i j => by rw [star_trivial]; exact hsym x hx j i)
    · intro ξ hξ
      have hexp : dotProduct (star ξ) (Matrix.mulVec (pcgbF2A A x) ξ) =
          dotProduct (star (![ξ 0, ξ 1] : Fin 2 → ℝ))
            (Matrix.mulVec (A (pcgbF2P x)) ![ξ 0, ξ 1]) + ξ 2 * ξ 2 := by
        simp [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Fin.sum_univ_two, pcgbF2A] <;> ring
      show 0 < dotProduct (star ξ) (Matrix.mulVec (pcgbF2A A x) ξ)
      rw [hexp]
      by_cases hη : (![ξ 0, ξ 1] : Fin 2 → ℝ) = 0
      · have h0 : ξ 0 = 0 := by simpa using congrFun hη 0
        have h1 : ξ 1 = 0 := by simpa using congrFun hη 1
        have h2 : ξ 2 ≠ 0 := by
          intro h2
          apply hξ
          funext i
          fin_cases i <;> simp [h0, h1, h2]
        rw [hη, Matrix.mulVec_zero, dotProduct_zero, zero_add]
        exact mul_self_pos.mpr h2
      · exact add_pos_of_pos_of_nonneg (hA'.dotProduct_mulVec_pos hη) (mul_self_nonneg _)

theorem pcgb_flat2_lift_sq (ρ : ℝ) (hρ : 0 < ρ) (T : E3 ≃ᵐ (E2 × ℝ))
    (hT : MeasureTheory.MeasurePreserving T MeasureTheory.volume MeasureTheory.volume)
    (hTx : ∀ x : E3, T x = (pcgbF2P x, x 2)) (φ : E2 → ℝ)
    (hφ : MemLp φ 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2)))) :
    MemLp (fun x => φ (pcgbF2P x)) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) ∧
    ∫ x in ndsHalf (0 : E3) ρ, φ (pcgbF2P x) ^ 2 ≤
      ρ * ∫ z in Metric.closedBall (0 : E2) (ρ / 2), φ z ^ 2 :=
by
  classical
  set K : Set E2 := Metric.closedBall (0 : E2) (ρ / 2) with hKdef
  set J : Set ℝ := Set.Icc (-(ρ / 2)) (ρ / 2) with hJdef
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hPn : ∀ x : E3, ‖pcgbF2P x‖ ≤ ‖x‖ := by
    intro x
    have h1 := hnsq2 (pcgbF2P x)
    have h2 := hnsq3 x
    rw [hP0, hP1] at h1
    have h3 := norm_nonneg (pcgbF2P x)
    have h4 := norm_nonneg x
    nlinarith [sq_nonneg (x 2)]
  
  have hHS : ndsHalf (0 : E3) ρ ⊆ T ⁻¹' (K ×ˢ J) := by
    intro x hx
    have hx' : x ∈ Metric.ball (0 : E3) (ρ / 2) := by
      unfold ndsHalf at hx
      exact hx.1
    rw [mem_ball_zero_iff] at hx'
    rw [Set.mem_preimage, hTx, Set.mem_prod]
    have h2 := hnsq3 x
    have h4 := norm_nonneg x
    refine ⟨?_, ?_⟩
    · show pcgbF2P x ∈ Metric.closedBall (0 : E2) (ρ / 2)
      rw [mem_closedBall_zero_iff]
      exact le_trans (hPn x) hx'.le
    · show x 2 ∈ Set.Icc (-(ρ / 2)) (ρ / 2)
      rw [Set.mem_Icc]
      have h5 : x 2 ^ 2 < (ρ / 2) ^ 2 := by
        nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)]
      constructor <;> nlinarith
  
  have hKJ : MeasurableSet (K ×ˢ J) :=
    (Metric.isClosed_closedBall.prod isClosed_Icc).measurableSet
  have hJfin : volume J ≠ ⊤ := by
    rw [hJdef, Real.volume_Icc]
    exact ENNReal.ofReal_ne_top
  have hJreal : volume.real J = ρ := by
    rw [hJdef, Real.volume_real_Icc, max_eq_left (by linarith)]
    ring
  
  have hTS : MeasureTheory.MeasurePreserving T (volume.restrict (T ⁻¹' (K ×ˢ J)))
      (volume.restrict (K ×ˢ J)) := hT.restrict_preimage hKJ
  have hprod : (volume.restrict K).prod (volume.restrict J) =
      (volume : MeasureTheory.Measure (E2 × ℝ)).restrict (K ×ˢ J) :=
    MeasureTheory.Measure.prod_restrict K J
  
  have hφt : MemLp (fun p : E2 × ℝ => φ p.1) 2 (volume.restrict (K ×ˢ J)) := by
    rw [← hprod]
    have hae : MeasureTheory.AEStronglyMeasurable (fun p : E2 × ℝ => φ p.1)
        ((volume.restrict K).prod (volume.restrict J)) :=
      hφ.aestronglyMeasurable.comp_fst
    rw [MeasureTheory.memLp_two_iff_integrable_sq hae]
    have h1 : MeasureTheory.Integrable (fun _ : ℝ => (1 : ℝ)) (volume.restrict J) :=
      MeasureTheory.integrableOn_const hJfin
    have h2 := hφ.integrable_sq.mul_prod h1
    simpa only [mul_one] using h2
  
  have hfS : MemLp (fun x => φ (pcgbF2P x)) 2 (volume.restrict (T ⁻¹' (K ×ˢ J))) := by
    have h1 := hφt.comp_measurePreserving hTS
    have heq : (fun p : E2 × ℝ => φ p.1) ∘ T = fun x => φ (pcgbF2P x) := by
      funext x
      simp only [Function.comp, hTx]
    rw [heq] at h1
    exact h1
  refine ⟨hfS.mono_measure (MeasureTheory.Measure.restrict_mono_set volume hHS), ?_⟩
  
  have h8 : ∫ x in ndsHalf (0 : E3) ρ, φ (pcgbF2P x) ^ 2 ≤
      ∫ x in T ⁻¹' (K ×ˢ J), φ (pcgbF2P x) ^ 2 :=
    MeasureTheory.setIntegral_mono_set hfS.integrable_sq
      (MeasureTheory.ae_of_all _ (fun x => sq_nonneg _)) hHS.eventuallyLE
  
  have h9 : ∫ x in T ⁻¹' (K ×ˢ J), φ (pcgbF2P x) ^ 2 = ∫ p in K ×ˢ J, φ p.1 ^ 2 := by
    have h := hT.setIntegral_preimage_emb T.measurableEmbedding
      (fun p : E2 × ℝ => φ p.1 ^ 2) (K ×ˢ J)
    simp only [hTx] at h
    exact h
  
  have h10 : ∫ p in K ×ˢ J, φ p.1 ^ 2 = (∫ z in K, φ z ^ 2) * ρ := by
    have h := MeasureTheory.setIntegral_prod_mul (μ := (volume : MeasureTheory.Measure E2))
      (ν := (volume : MeasureTheory.Measure ℝ)) (fun z : E2 => φ z ^ 2) (fun _ : ℝ => (1 : ℝ)) K J
    simp only [mul_one] at h
    rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one, hJreal] at h
    exact h
  
  calc ∫ x in ndsHalf (0 : E3) ρ, φ (pcgbF2P x) ^ 2
      ≤ ∫ x in T ⁻¹' (K ×ˢ J), φ (pcgbF2P x) ^ 2 := h8
    _ = ∫ p in K ×ˢ J, φ p.1 ^ 2 := h9
    _ = (∫ z in K, φ z ^ 2) * ρ := h10
    _ = ρ * ∫ z in Metric.closedBall (0 : E2) (ρ / 2), φ z ^ 2 := mul_comm _ _

theorem pcgb_flat2_l2_data (ρ : ℝ) (hρ : 0 < ρ) (u : ℕ → E2 → ℝ)
    (hu : ∀ m, ContDiffOn ℝ ∞ (u m) (Metric.ball (0 : E2) ρ)) (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ Metric.ball (0 : E2) ρ →
      MemLp w 2 (volume.restrict L) ∧ (∀ k, MemLp (G k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ z in L, (u m z - w z) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ z in L, (pd2 k (u m) z - G k z) ^ 2) atTop (𝓝 0))
    (hcore : ∀ φ : E2 → ℝ, MemLp φ 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))) →
      MemLp (fun x => φ (pcgbF2P x)) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) ∧
      ∫ x in ndsHalf (0 : E3) ρ, φ (pcgbF2P x) ^ 2 ≤
        ρ * ∫ z in Metric.closedBall (0 : E2) (ρ / 2), φ z ^ 2) :
    MemLp (fun x => w (pcgbF2P x)) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) ∧
    (∀ a, MemLp (pcgbF2G G a) 2 (volume.restrict (ndsHalf (0 : E3) ρ))) ∧
    Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ, (u m (pcgbF2P x) - w (pcgbF2P x)) ^ 2)
      atTop (𝓝 0) ∧
    ∀ a, Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
      (partialDeriv a (fun y => u m (pcgbF2P y)) x - pcgbF2G G a x) ^ 2) atTop (𝓝 0) :=
by
  
  have hK : IsCompact (Metric.closedBall (0 : E2) (ρ / 2)) := isCompact_closedBall 0 (ρ / 2)
  have hKsub : Metric.closedBall (0 : E2) (ρ / 2) ⊆ Metric.ball (0 : E2) ρ :=
    Metric.closedBall_subset_ball (by linarith)
  obtain ⟨hw, hG, hc0, hc1⟩ := hL2 _ hK hKsub
  have hHo : IsOpen (ndsHalf (0 : E3) ρ) := by
    unfold ndsHalf
    exact Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hHm : MeasurableSet (ndsHalf (0 : E3) ρ) := hHo.measurableSet
  
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hHB : ∀ x ∈ ndsHalf (0 : E3) ρ, pcgbF2P x ∈ Metric.ball (0 : E2) ρ := by
    intro x hx
    have hx' : x ∈ Metric.ball (0 : E3) (ρ / 2) := hx.1
    rw [mem_ball_zero_iff] at hx' ⊢
    have h1 := hnsq2 (pcgbF2P x)
    have h2 := hnsq3 x
    rw [hP0, hP1] at h1
    have h3 := norm_nonneg (pcgbF2P x)
    have h4 := norm_nonneg x
    have hPn : ‖pcgbF2P x‖ ≤ ‖x‖ := by nlinarith [sq_nonneg (x 2)]
    linarith
  
  have hL2K : ∀ f : E2 → ℝ, ContinuousOn f (Metric.closedBall (0 : E2) (ρ / 2)) →
      MemLp f 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))) := by
    intro f hf
    haveI : IsFiniteMeasure (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))) :=
      isFiniteMeasure_restrict.mpr hK.measure_lt_top.ne
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hf
    exact MemLp.of_bound (hf.aestronglyMeasurable_of_isCompact hK hK.isClosed.measurableSet) C
      (ae_restrict_of_forall_mem hK.isClosed.measurableSet hC)
  have hcu : ∀ m, ContinuousOn (u m) (Metric.closedBall (0 : E2) (ρ / 2)) :=
    fun m => (hu m).continuousOn.mono hKsub
  have hcd : ∀ m k, ContinuousOn (pd2 k (u m)) (Metric.closedBall (0 : E2) (ρ / 2)) := by
    intro m k
    have h := ((hu m).continuousOn_fderiv_of_isOpen Metric.isOpen_ball (by simp)).clm_apply
      (continuousOn_const (c := e2 k))
    exact h.mono hKsub
  
  have hsq : ∀ φ : ℕ → E2 → ℝ,
      (∀ m, MemLp (φ m) 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2)))) →
      Tendsto (fun m => ∫ z in Metric.closedBall (0 : E2) (ρ / 2), φ m z ^ 2) atTop (𝓝 0) →
      Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ, φ m (pcgbF2P x) ^ 2) atTop (𝓝 0) := by
    intro φ hφ h
    have h' : Tendsto (fun m => ρ * ∫ z in Metric.closedBall (0 : E2) (ρ / 2), φ m z ^ 2)
        atTop (𝓝 0) := by
      simpa using h.const_mul ρ
    exact squeeze_zero (fun m => setIntegral_nonneg hHm (fun x _ => sq_nonneg _))
      (fun m => (hcore (φ m) (hφ m)).2) h'
  
  have hPe0 : pcgbF2P (e 0) = e2 0 := by
    ext j
    fin_cases j <;> simp [pcgbF2P, e, e2, EuclideanSpace.single_apply]
  have hPe1 : pcgbF2P (e 1) = e2 1 := by
    ext j
    fin_cases j <;> simp [pcgbF2P, e, e2, EuclideanSpace.single_apply]
  have hPe2 : pcgbF2P (e 2) = 0 := by
    ext j
    fin_cases j <;> simp [pcgbF2P, e, e2, EuclideanSpace.single_apply]
  have hchain : ∀ m, ∀ x ∈ ndsHalf (0 : E3) ρ, ∀ a : Fin 3,
      partialDeriv a (fun y => u m (pcgbF2P y)) x =
        fderiv ℝ (u m) (pcgbF2P x) (pcgbF2P (e a)) := by
    intro m x hx a
    have hd : DifferentiableAt ℝ (u m) (pcgbF2P x) :=
      ((hu m).differentiableOn (by simp)).differentiableAt
        (Metric.isOpen_ball.mem_nhds (hHB x hx))
    have hcomp : HasFDerivAt (fun y => u m (pcgbF2P y))
        ((fderiv ℝ (u m) (pcgbF2P x)).comp pcgbF2P) x :=
      hd.hasFDerivAt.comp x pcgbF2P.hasFDerivAt
    unfold partialDeriv
    rw [hcomp.fderiv]
    rfl
  
  have hC1 : MemLp (fun x => w (pcgbF2P x)) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) :=
    (hcore w hw).1
  
  have hC2 : ∀ a, MemLp (pcgbF2G G a) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) := by
    have h0 : MemLp (pcgbF2G G 0) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) :=
      (hcore (G 0) (hG 0)).1
    have h1 : MemLp (pcgbF2G G 1) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) :=
      (hcore (G 1) (hG 1)).1
    have h2 : MemLp (pcgbF2G G 2) 2 (volume.restrict (ndsHalf (0 : E3) ρ)) := by
      have : pcgbF2G G 2 = fun _ => (0 : ℝ) := rfl
      rw [this]
      exact MemLp.zero
    intro a
    fin_cases a
    · exact h0
    · exact h1
    · exact h2
  
  have hC3 : Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
      (u m (pcgbF2P x) - w (pcgbF2P x)) ^ 2) atTop (𝓝 0) :=
    hsq (fun m z => u m z - w z) (fun m => (hL2K _ (hcu m)).sub hw) hc0
  
  have hC4 : ∀ a, Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
      (partialDeriv a (fun y => u m (pcgbF2P y)) x - pcgbF2G G a x) ^ 2) atTop (𝓝 0) := by
    have h0 : Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
        (partialDeriv 0 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 0 x) ^ 2) atTop (𝓝 0) := by
      have h := hsq (fun m z => pd2 0 (u m) z - G 0 z)
        (fun m => (hL2K _ (hcd m 0)).sub (hG 0)) (hc1 0)
      refine h.congr (fun m => ?_)
      refine setIntegral_congr_fun hHm (fun x hx => ?_)
      show (pd2 0 (u m) (pcgbF2P x) - G 0 (pcgbF2P x)) ^ 2 =
        (partialDeriv 0 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 0 x) ^ 2
      rw [hchain m x hx 0, hPe0]
      rfl
    have h1 : Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
        (partialDeriv 1 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 1 x) ^ 2) atTop (𝓝 0) := by
      have h := hsq (fun m z => pd2 1 (u m) z - G 1 z)
        (fun m => (hL2K _ (hcd m 1)).sub (hG 1)) (hc1 1)
      refine h.congr (fun m => ?_)
      refine setIntegral_congr_fun hHm (fun x hx => ?_)
      show (pd2 1 (u m) (pcgbF2P x) - G 1 (pcgbF2P x)) ^ 2 =
        (partialDeriv 1 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 1 x) ^ 2
      rw [hchain m x hx 1, hPe1]
      rfl
    have h2 : Tendsto (fun m => ∫ x in ndsHalf (0 : E3) ρ,
        (partialDeriv 2 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 2 x) ^ 2) atTop (𝓝 0) := by
      have hz : ∀ m, ∫ x in ndsHalf (0 : E3) ρ,
          (partialDeriv 2 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 2 x) ^ 2 = 0 := by
        intro m
        have hfun : Set.EqOn
            (fun x => (partialDeriv 2 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 2 x) ^ 2)
            (fun _ => (0 : ℝ)) (ndsHalf (0 : E3) ρ) := by
          intro x hx
          have hG2 : pcgbF2G G 2 x = 0 := rfl
          show (partialDeriv 2 (fun y => u m (pcgbF2P y)) x - pcgbF2G G 2 x) ^ 2 = 0
          rw [hchain m x hx 2, hPe2, map_zero, hG2]
          norm_num
        rw [setIntegral_congr_fun hHm hfun]
        simp
      exact tendsto_const_nhds.congr (fun m => (hz m).symm)
    intro a
    fin_cases a
    · exact h0
    · exact h1
    · exact h2
  exact ⟨hC1, hC2, hC3, hC4⟩

theorem pcgb_flat2_slice_weak (ρ : ℝ) (hρ : 0 < ρ) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (G : Fin 2 → E2 → ℝ)
    (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball (0 : E2) ρ ∩ {z | 0 < z 0} →
      ∫ z, ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z * pd2 a ζ z = 0)
    (ζ : E3 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ)
    (hζs : tsupport ζ ⊆ Metric.ball (0 : E3) (ρ / 2))
    (hζO : ∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball (0 : E3) ρ | x 0 = 0} ⊆ O ∧
      ∀ x ∈ O, ζ x = 0)
    (t : ℝ) :
    ∫ z, ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z *
      (if 0 < z 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (z 0) (z 1) t) else 0) = 0 :=
by
  obtain ⟨O, hOo, hOface, hOzero⟩ := hζO
  obtain ⟨Et, hEt⟩ : ∃ Et : E2 → E3, ∀ y, Et y = cylPt (y 0) (y 1) t := ⟨_, fun _ => rfl⟩
  set Lm : E2 →L[ℝ] E3 := (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 0) +
      (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1) with hLm
  have hEtL : Et = fun y => Lm y + t • e 2 := by
    funext y
    rw [hEt, hLm]
    simp [cylPt]
  have hEfd : ∀ z, HasFDerivAt Et Lm z := by
    intro z
    rw [hEtL]
    exact Lm.hasFDerivAt.add_const _
  have hE : ContDiff ℝ ∞ Et := by
    rw [hEtL]
    exact Lm.contDiff.add contDiff_const
  have hEc : Continuous Et := hE.continuous
  have hLe : ∀ a : Fin 2, Lm (e2 a) = e (Fin.castSucc a) := by
    intro a
    fin_cases a <;> ext i <;> fin_cases i <;> simp [hLm, EuclideanSpace.single_apply]
  have hE0 : ∀ z : E2, Et z 0 = z 0 := by
    intro z
    rw [hEt]
    simp [cylPt, EuclideanSpace.single_apply]
  have hE1 : ∀ z : E2, Et z 1 = z 1 := by
    intro z
    rw [hEt]
    simp [cylPt, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hnorm : ∀ z : E2, ‖z‖ ≤ ‖Et z‖ := by
    intro z
    have h1 := hnsq3 (Et z)
    have h2 := hnsq2 z
    rw [hE0, hE1] at h1
    nlinarith [norm_nonneg z, norm_nonneg (Et z), sq_nonneg (Et z 2)]
  
  have hface : ∀ z : E2, z 0 = 0 → ∀ᶠ y in 𝓝 z, ζ (Et y) = 0 := by
    intro z hz
    by_cases hx : Et z ∈ tsupport ζ
    · have hxb : Et z ∈ Metric.ball (0 : E3) ρ := by
        have h := hζs hx
        rw [mem_ball_zero_iff] at h ⊢
        linarith
      have hxO : Et z ∈ O := hOface ⟨hxb, by rw [hE0]; exact hz⟩
      exact Filter.eventually_of_mem (hEc.continuousAt.preimage_mem_nhds (hOo.mem_nhds hxO))
        (fun y hy => hOzero _ hy)
    · exact Filter.eventually_of_mem
        (hEc.continuousAt.preimage_mem_nhds ((isClosed_tsupport ζ).isOpen_compl.mem_nhds hx))
        (fun y hy => image_eq_zero_of_notMem_tsupport hy)
  
  obtain ⟨η, hη⟩ : ∃ η : E2 → ℝ, ∀ z, η z = if 0 < z 0 then ζ (Et z) else 0 :=
    ⟨_, fun _ => rfl⟩
  have hc0 : Continuous (fun y : E2 => y 0) :=
    (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).continuous
  have hpos : ∀ z : E2, 0 < z 0 → η =ᶠ[𝓝 z] fun y => ζ (Et y) := by
    intro z hz
    filter_upwards [(isOpen_lt continuous_const hc0).mem_nhds hz] with y hy
    rw [hη, if_pos hy]
  have hnpos : ∀ z : E2, ¬ 0 < z 0 → η =ᶠ[𝓝 z] fun _ => (0 : ℝ) := by
    intro z hz
    rcases lt_or_eq_of_le (not_lt.mp hz) with h | h
    · filter_upwards [(isOpen_lt hc0 continuous_const).mem_nhds h] with y hy
      rw [hη, if_neg (not_lt.mpr (le_of_lt hy))]
    · filter_upwards [hface z h] with y hy
      rw [hη]
      split_ifs
      · exact hy
      · rfl
  have hζE : ContDiff ℝ ∞ (fun y => ζ (Et y)) := hζ.comp hE
  have hηs : ContDiff ℝ ∞ η := by
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : 0 < z 0
    · exact hζE.contDiffAt.congr_of_eventuallyEq (hpos z hz)
    · exact contDiffAt_const.congr_of_eventuallyEq (hnpos z hz)
  have hder : ∀ (z : E2) (a : Fin 2),
      pd2 a η z = if 0 < z 0 then partialDeriv (Fin.castSucc a) ζ (Et z) else 0 := by
    intro z a
    unfold pd2
    by_cases hz : 0 < z 0
    · rw [if_pos hz, (hpos z hz).fderiv_eq]
      have h1 : HasFDerivAt (fun y => ζ (Et y)) ((fderiv ℝ ζ (Et z)).comp Lm) z :=
        ((hζ.differentiable (by simp)) (Et z)).hasFDerivAt.comp z (hEfd z)
      rw [h1.fderiv, ContinuousLinearMap.comp_apply, hLe]
      rfl
    · rw [if_neg hz, (hnpos z hz).fderiv_eq]
      simp
  
  have hsupp : Function.support η ⊆ {z : E2 | 0 ≤ z 0} ∩ Et ⁻¹' tsupport ζ := by
    intro z hz
    rw [Function.mem_support, hη] at hz
    by_cases h : 0 < z 0
    · rw [if_pos h] at hz
      exact ⟨le_of_lt h, subset_tsupport ζ hz⟩
    · rw [if_neg h] at hz
      exact absurd rfl hz
  have hC : IsClosed ({z : E2 | 0 ≤ z 0} ∩ Et ⁻¹' tsupport ζ) :=
    (isClosed_le continuous_const hc0).inter ((isClosed_tsupport ζ).preimage hEc)
  have hts : tsupport η ⊆ {z : E2 | 0 ≤ z 0} ∩ Et ⁻¹' tsupport ζ := closure_minimal hsupp hC
  have hηt : tsupport η ⊆ Metric.ball (0 : E2) ρ ∩ {z | 0 < z 0} := by
    intro z hz
    obtain ⟨h0, h1⟩ := hts hz
    refine ⟨?_, ?_⟩
    · have h2 := hζs h1
      rw [mem_ball_zero_iff] at h2 ⊢
      have h3 := hnorm z
      linarith
    · show 0 < z 0
      by_contra hneg
      exact (notMem_tsupport_iff_eventuallyEq.mpr (hnpos z hneg)) hz
  have hηc : HasCompactSupport η :=
    IsCompact.of_isClosed_subset (isCompact_closedBall (0 : E2) ρ) (isClosed_tsupport η)
      (hηt.trans (Set.inter_subset_left.trans Metric.ball_subset_closedBall))
  have hint := hweak η hηs hηc hηt
  have hfun : (fun z : E2 => ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z *
      (if 0 < z 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (z 0) (z 1) t) else 0)) =
      fun z : E2 => ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z * pd2 a η z := by
    funext z
    simp only [hder, hEt]
  rw [hfun]
  exact hint

theorem pcgb_flat2_fubini_lift (ρ : ℝ) (hρ : 0 < ρ) (T : E3 ≃ᵐ (E2 × ℝ))
    (hT : MeasureTheory.MeasurePreserving T MeasureTheory.volume MeasureTheory.volume)
    (hTx : ∀ x : E3, T x = (pcgbF2P x, x 2)) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun z => A z a b) (Metric.ball (0 : E2) ρ))
    (G : Fin 2 → E2 → ℝ)
    (hG : ∀ k, MemLp (G k) 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))))
    (ζ : E3 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ)
    (hζs : tsupport ζ ⊆ Metric.ball (0 : E3) (ρ / 2))
    (hslice : ∀ t : ℝ, ∫ z, ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z *
      (if 0 < z 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (z 0) (z 1) t) else 0) = 0) :
    ∫ x in ndsHalf (0 : E3) ρ, ∑ a : Fin 3, ∑ b : Fin 3,
      pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x = 0 :=
by
  classical
  
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hP0 : ∀ x : E3, (pcgbF2P x) 0 = x 0 := by
    intro x; simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, (pcgbF2P x) 1 = x 1 := by
    intro x; simp [pcgbF2P, EuclideanSpace.single_apply]
  have hcylx : ∀ x : E3, cylPt (x 0) (x 1) (x 2) = x := by
    intro x
    ext i
    fin_cases i
    · exact (hcyl _ _ _).1
    · exact (hcyl _ _ _).2.1
    · exact (hcyl _ _ _).2.2
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hpd0 : ∀ (i : Fin 3) (y : E3), y ∉ Metric.ball (0 : E3) (ρ / 2) →
      partialDeriv i ζ y = 0 := by
    intro i y hy
    have hy' : y ∉ tsupport ζ := fun h => hy (hζs h)
    simp [partialDeriv, fderiv_of_notMem_tsupport ℝ hy']
  
  have hblock : ∀ x : E3, ∑ a : Fin 3, ∑ b : Fin 3,
      pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x
      = ∑ a : Fin 2, ∑ b : Fin 2, A (pcgbF2P x) a b * G b (pcgbF2P x) *
          partialDeriv (Fin.castSucc a) ζ x := by
    intro x
    simp only [Fin.sum_univ_three, Fin.sum_univ_two]
    simp [pcgbF2A, pcgbF2G, Fin.castSucc_zero, Fin.castSucc_one]
  
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : E2 × ℝ → ℝ, Ψ = fun p => ∑ a : Fin 2, ∑ b : Fin 2,
      A p.1 a b * G b p.1 *
        (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0) :=
    ⟨_, rfl⟩
  
  have hpt : ∀ x : E3, Ψ (T x) = (ndsHalf (0 : E3) ρ).indicator (fun x =>
      ∑ a : Fin 3, ∑ b : Fin 3, pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x) x := by
    intro x
    rw [hΨ, hTx]
    simp only [hP0, hP1, hcylx]
    by_cases hx0 : 0 < x 0
    · by_cases hxb : x ∈ Metric.ball (0 : E3) (ρ / 2)
      · have hxH : x ∈ ndsHalf (0 : E3) ρ := ⟨hxb, hx0⟩
        rw [Set.indicator_of_mem hxH, hblock]
        simp only [if_pos hx0]
      · have hxH : x ∉ ndsHalf (0 : E3) ρ := fun h => hxb h.1
        rw [Set.indicator_of_notMem hxH]
        have hz := fun i => hpd0 i x hxb
        simp [hz]
    · have hxH : x ∉ ndsHalf (0 : E3) ρ := fun h => hx0 h.2
      rw [Set.indicator_of_notMem hxH]
      simp [hx0]
  have hH : MeasurableSet (ndsHalf (0 : E3) ρ) := by
    unfold ndsHalf
    exact (Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)).measurableSet
  have hmain : ∫ x in ndsHalf (0 : E3) ρ, ∑ a : Fin 3, ∑ b : Fin 3,
      pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x
      = ∫ p, Ψ p ∂((volume : Measure E2).prod (volume : Measure ℝ)) := by
    calc ∫ x in ndsHalf (0 : E3) ρ, ∑ a : Fin 3, ∑ b : Fin 3,
          pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x
        = ∫ x, (ndsHalf (0 : E3) ρ).indicator (fun x =>
            ∑ a : Fin 3, ∑ b : Fin 3, pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x) x :=
          (integral_indicator hH).symm
      _ = ∫ x, Ψ (T x) := integral_congr_ae (Filter.Eventually.of_forall fun x => (hpt x).symm)
      _ = ∫ p, Ψ p := hT.integral_comp' Ψ
      _ = ∫ p, Ψ p ∂((volume : Measure E2).prod (volume : Measure ℝ)) := by
          first
          | rfl
          | rw [Measure.volume_eq_prod]
  
  have hsupp : ∀ (a : Fin 2) (p : E2 × ℝ),
      (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0) ≠ 0 →
      p.1 ∈ Metric.closedBall (0 : E2) (ρ / 2) ∧ p.2 ∈ Set.Icc (-(ρ / 2)) (ρ / 2) := by
    intro a p hne
    have hy : cylPt (p.1 0) (p.1 1) p.2 ∈ Metric.ball (0 : E3) (ρ / 2) := by
      by_contra hy
      apply hne
      split_ifs
      · exact hpd0 _ _ hy
      · rfl
    rw [mem_ball_zero_iff] at hy
    have h1 := hnsq3 (cylPt (p.1 0) (p.1 1) p.2)
    obtain ⟨c0, c1, c2⟩ := hcyl (p.1 0) (p.1 1) p.2
    rw [c0, c1, c2] at h1
    have hn0 := norm_nonneg (cylPt (p.1 0) (p.1 1) p.2)
    have hsq : ‖cylPt (p.1 0) (p.1 1) p.2‖ ^ 2 < (ρ / 2) ^ 2 :=
      pow_lt_pow_left₀ hy hn0 (by norm_num)
    have h2 := hnsq2 p.1
    have hρ2 : (0 : ℝ) ≤ ρ / 2 := by linarith
    constructor
    · rw [mem_closedBall_zero_iff]
      have hz : ‖p.1‖ ^ 2 < (ρ / 2) ^ 2 := by nlinarith [sq_nonneg p.2]
      exact le_of_lt (lt_of_pow_lt_pow_left₀ 2 hρ2 hz)
    · have ht : p.2 ^ 2 < (ρ / 2) ^ 2 := by nlinarith [sq_nonneg (p.1 0), sq_nonneg (p.1 1)]
      have hab := abs_lt.mp (abs_lt_of_sq_lt_sq ht hρ2)
      exact ⟨le_of_lt hab.1, le_of_lt hab.2⟩
  
  obtain ⟨Mζ, hMζ⟩ :=
    (hζ.continuous_fderiv (by simp)).bounded_above_of_compact_support (hζc.fderiv ℝ)
  have hDb : ∀ (a : Fin 2) (p : E2 × ℝ),
      ‖(if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0)‖
        ≤ max Mζ 0 := by
    intro a p
    split_ifs
    · calc ‖partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2)‖
          ≤ ‖fderiv ℝ ζ (cylPt (p.1 0) (p.1 1) p.2)‖ * ‖e (Fin.castSucc a)‖ :=
            ContinuousLinearMap.le_opNorm _ _
        _ = ‖fderiv ℝ ζ (cylPt (p.1 0) (p.1 1) p.2)‖ := by simp [EuclideanSpace.norm_single]
        _ ≤ max Mζ 0 := (hMζ _).trans (le_max_left _ _)
    · simp
  
  have hc0 : Continuous fun p : E2 × ℝ => p.1 0 :=
    (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).continuous.comp continuous_fst
  have hc1 : Continuous fun p : E2 × ℝ => p.1 1 :=
    (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).continuous.comp continuous_fst
  have hDm : ∀ a : Fin 2, Measurable (fun p : E2 × ℝ =>
      if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0) := by
    intro a
    refine Measurable.ite ?_ ?_ measurable_const
    · exact measurableSet_lt measurable_const hc0.measurable
    · apply Continuous.measurable
      unfold partialDeriv
      refine Continuous.clm_apply ((hζ.continuous_fderiv (by simp)).comp ?_) continuous_const
      unfold cylPt
      exact ((hc0.smul continuous_const).add (hc1.smul continuous_const)).add
        (continuous_snd.smul continuous_const)
  
  have hKc : IsCompact (Metric.closedBall (0 : E2) (ρ / 2)) := isCompact_closedBall _ _
  have hKsub : Metric.closedBall (0 : E2) (ρ / 2) ⊆ Metric.ball (0 : E2) ρ :=
    Metric.closedBall_subset_ball (by linarith)
  have hGi : ∀ b, IntegrableOn (G b) (Metric.closedBall (0 : E2) (ρ / 2)) := by
    intro b
    haveI : IsFiniteMeasure (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))) :=
      isFiniteMeasure_restrict.mpr hKc.measure_lt_top.ne
    exact (hG b).integrable one_le_two
  have hKab : ∀ a b : Fin 2, Integrable ((Metric.closedBall (0 : E2) (ρ / 2)).indicator
      (fun z => A z a b * G b z)) (volume : Measure E2) := by
    intro a b
    exact (IntegrableOn.continuousOn_mul (g := fun z => A z a b)
      ((hA a b).continuousOn.mono hKsub) (hGi b) hKc).integrable_indicator measurableSet_closedBall
  have hJ : Integrable ((Set.Icc (-(ρ / 2)) (ρ / 2)).indicator (fun _ : ℝ => (1 : ℝ)))
      (volume : Measure ℝ) := by
    refine IntegrableOn.integrable_indicator ?_ measurableSet_Icc
    exact integrableOn_const (by rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)
  have hΨi : Integrable Ψ ((volume : Measure E2).prod (volume : Measure ℝ)) := by
    have hterm : ∀ a b : Fin 2, Integrable (fun p : E2 × ℝ => A p.1 a b * G b p.1 *
        (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0))
        ((volume : Measure E2).prod (volume : Measure ℝ)) := by
      intro a b
      have h1 := ((hKab a b).mul_prod hJ).bdd_mul (hDm a).aestronglyMeasurable
        (Filter.Eventually.of_forall (hDb a))
      refine h1.congr (Filter.Eventually.of_forall fun p => ?_)
      show (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0) *
          ((Metric.closedBall (0 : E2) (ρ / 2)).indicator (fun z => A z a b * G b z) p.1 *
            (Set.Icc (-(ρ / 2)) (ρ / 2)).indicator (fun _ : ℝ => (1 : ℝ)) p.2)
        = A p.1 a b * G b p.1 *
          (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ (cylPt (p.1 0) (p.1 1) p.2) else 0)
      by_cases hD : (if 0 < p.1 0 then partialDeriv (Fin.castSucc a) ζ
          (cylPt (p.1 0) (p.1 1) p.2) else 0) = 0
      · rw [hD]; ring
      · obtain ⟨hK, hJ'⟩ := hsupp a p hD
        rw [Set.indicator_of_mem hK, Set.indicator_of_mem hJ']
        ring
    rw [hΨ]
    exact integrable_finset_sum _ fun a _ => integrable_finset_sum _ fun b _ => hterm a b
  
  rw [hmain, integral_prod_symm Ψ hΨi]
  have hsl : ∀ t : ℝ, ∫ z, Ψ (z, t) = 0 := by
    intro t
    rw [hΨ]
    exact hslice t
  simp only [hsl, integral_zero]

theorem pcgb_flat2_x2_invariant (R : ℝ) (v' : E3 → ℝ) (w : E2 → ℝ)
    (hv' : ContinuousOn v' (Metric.ball (0 : E3) R))
    (hae : ∀ᵐ x ∂(volume.restrict (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0})),
      w (pcgbF2P x) = v' x) :
    ∀ (x : E3) (τ : ℝ), x ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} →
      x + τ • e 2 ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} → v' (x + τ • e 2) = v' x :=
by
  intro x τ hx hxτ
  have hΩo : IsOpen (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0}) := Metric.isOpen_ball.inter
    (isOpen_lt continuous_const (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hs : Continuous (fun y : E3 => y + τ • e 2) := continuous_id.add continuous_const
  have hUo : IsOpen (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} ∩
      (fun y : E3 => y + τ • e 2) ⁻¹' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0})) :=
    hΩo.inter (hΩo.preimage hs)
  have hxU : x ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} ∩
      (fun y : E3 => y + τ • e 2) ⁻¹' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0}) :=
    ⟨hx, hxτ⟩
  have h0 : pcgbF2P (e 2) = 0 := by
    ext j
    fin_cases j <;> simp [pcgbF2P, e, e2, EuclideanSpace.single_apply]
  have hPe : ∀ y : E3, pcgbF2P (y + τ • e 2) = pcgbF2P y := by
    intro y
    rw [map_add, map_smul, h0, smul_zero, add_zero]
  have h1 : ∀ᵐ y ∂volume, y ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} →
      w (pcgbF2P y) = v' y :=
    (ae_restrict_iff' hΩo.measurableSet).mp hae
  have h2 : ∀ᵐ y ∂volume, (y + τ • e 2) ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} →
      w (pcgbF2P (y + τ • e 2)) = v' (y + τ • e 2) :=
    (measurePreserving_add_right volume (τ • e 2)).quasiMeasurePreserving.ae
      (p := fun y => y ∈ Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} → w (pcgbF2P y) = v' y) h1
  have h3 : (fun y => v' (y + τ • e 2)) =ᵐ[volume.restrict (Metric.ball (0 : E3) R ∩
      {x : E3 | 0 < x 0} ∩
      (fun y : E3 => y + τ • e 2) ⁻¹' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0}))] v' := by
    rw [Filter.EventuallyEq, ae_restrict_iff' hUo.measurableSet]
    filter_upwards [h1, h2] with y hy1 hy2 hyU
    rw [← hy2 hyU.2, hPe, hy1 hyU.1]
  have hΩball : Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} ⊆ Metric.ball (0 : E3) R :=
    Set.inter_subset_left
  have hc1 : ContinuousOn (fun y => v' (y + τ • e 2)) (Metric.ball (0 : E3) R ∩
      {x : E3 | 0 < x 0} ∩
      (fun y : E3 => y + τ • e 2) ⁻¹' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0})) :=
    hv'.comp hs.continuousOn (fun y hy => hΩball hy.2)
  have hc2 : ContinuousOn v' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0} ∩
      (fun y : E3 => y + τ • e 2) ⁻¹' (Metric.ball (0 : E3) R ∩ {x : E3 | 0 < x 0})) :=
    hv'.mono (fun y hy => hΩball hy.1)
  exact Measure.eqOn_open_of_ae_eq h3 hUo hc1 hc2 hxU

theorem pcgb_flat2_eq_slice (ρ : ℝ) (hρ : 0 < ρ) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun z => A z a b) (Metric.ball (0 : E2) ρ))
    (v' : E3 → ℝ) (hv' : ContDiffOn ℝ ∞ v' (Metric.ball (0 : E3) (ρ / 4)))
    (hinv : ∀ (x : E3) (τ : ℝ), x ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} →
      x + τ • e 2 ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} → v' (x + τ • e 2) = v' x)
    (heq : ∀ x ∈ Metric.ball (0 : E3) (ρ / 4), 0 ≤ x 0 →
      ∑ a : Fin 3, partialDeriv a (fun y => ∑ b : Fin 3, pcgbF2A A y a b * partialDeriv b v' y) x
        = 0) :
    ∀ z ∈ Metric.ball (0 : E2) (ρ / 8), 0 ≤ z 0 →
      ∑ a : Fin 2, pd2 a (fun y => ∑ b : Fin 2, A y a b *
        pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) z = 0 :=
by
  
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hPn : ∀ x : E3, ‖pcgbF2P x‖ ≤ ‖x‖ := by
    intro x
    have h1 := hnsq2 (pcgbF2P x)
    have h2 := hnsq3 x
    rw [hP0, hP1] at h1
    have h3 := norm_nonneg (pcgbF2P x)
    have h4 := norm_nonneg x
    nlinarith [sq_nonneg (x 2)]
  have hE0ball : ∀ z ∈ Metric.ball (0 : E2) (ρ / 8),
      cylPt (z 0) (z 1) 0 ∈ Metric.ball (0 : E3) (ρ / 4) := by
    intro z hz
    rw [mem_ball_zero_iff] at hz ⊢
    have h1 := hnsq3 (cylPt (z 0) (z 1) 0)
    obtain ⟨c0, c1, c2⟩ := hcyl (z 0) (z 1) 0
    rw [c0, c1, c2] at h1
    have h2 := hnsq2 z
    have h3 := norm_nonneg (cylPt (z 0) (z 1) 0)
    have h4 := norm_nonneg z
    nlinarith
  have hPE : ∀ y : E2, pcgbF2P (cylPt (y 0) (y 1) 0) = y := by
    intro y
    ext i
    fin_cases i
    · show pcgbF2P (cylPt (y 0) (y 1) 0) 0 = y 0
      rw [hP0, (hcyl _ _ _).1]
    · show pcgbF2P (cylPt (y 0) (y 1) 0) 1 = y 1
      rw [hP1, (hcyl _ _ _).2.1]
  have hF : ∀ x : E3, pcgbF2A A x 0 0 = A (pcgbF2P x) 0 0 ∧
      pcgbF2A A x 0 1 = A (pcgbF2P x) 0 1 ∧ pcgbF2A A x 0 2 = 0 ∧
      pcgbF2A A x 1 0 = A (pcgbF2P x) 1 0 ∧ pcgbF2A A x 1 1 = A (pcgbF2P x) 1 1 ∧
      pcgbF2A A x 1 2 = 0 ∧ pcgbF2A A x 2 0 = 0 ∧ pcgbF2A A x 2 1 = 0 ∧
      pcgbF2A A x 2 2 = 1 := fun x =>
    ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
  
  have hΩo : IsOpen (Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0}) :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  have hdiff : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f (Metric.ball (0 : E3) (ρ / 4)) →
      ∀ x ∈ Metric.ball (0 : E3) (ρ / 4), DifferentiableAt ℝ f x := fun f hf x hx =>
    (hf.differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hx)
  have hpd_smooth : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f (Metric.ball (0 : E3) (ρ / 4)) →
      ∀ i : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i f) (Metric.ball (0 : E3) (ρ / 4)) := by
    intro f hf i
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y (e i)) (Metric.ball (0 : E3) (ρ / 4))
    exact (hf.fderiv_of_isOpen Metric.isOpen_ball (by simp)).clm_apply contDiffOn_const
  
  have hd2 : ∀ x ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0},
      partialDeriv 2 v' x = 0 := by
    intro x hx
    obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.mp hΩo x hx
    have hγ : HasDerivAt (fun s : ℝ => x + s • e 2) (e 2) 0 := by
      have := ((hasDerivAt_id (0 : ℝ)).smul_const (e 2)).const_add x
      simpa using this
    have h1 : HasDerivAt (fun s : ℝ => v' (x + s • e 2)) (fderiv ℝ v' x (e 2)) 0 := by
      have hf : HasFDerivAt v' (fderiv ℝ v' x) (x + (0 : ℝ) • e 2) := by
        simpa using (hdiff v' hv' x hx.1).hasFDerivAt
      exact hf.comp_hasDerivAt (0 : ℝ) hγ
    have h2 : HasDerivAt (fun s : ℝ => v' (x + s • e 2)) 0 0 := by
      refine (hasDerivAt_const (0 : ℝ) (v' x)).congr_of_eventuallyEq ?_
      filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδ] with s hs
      apply hinv x s hx
      apply hball
      have hd : dist (x + s • e 2) x = |s| := by
        rw [dist_eq_norm, add_sub_cancel_left, norm_smul, EuclideanSpace.norm_single, norm_one,
          mul_one, Real.norm_eq_abs]
      rw [Metric.mem_ball, hd]
      rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hs
      exact hs
    exact h1.unique h2
  
  have hD : ContinuousOn (partialDeriv 2 (partialDeriv 2 v')) (Metric.ball (0 : E3) (ρ / 4)) :=
    (hpd_smooth _ (hpd_smooth v' hv' 2) 2).continuousOn
  have hDΩ : ∀ y ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0},
      partialDeriv 2 (partialDeriv 2 v') y = 0 := by
    intro y hy
    have hev : partialDeriv 2 v' =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hΩo.mem_nhds hy) (fun w hw => hd2 w hw)
    show fderiv ℝ (partialDeriv 2 v') y (e 2) = 0
    rw [hev.fderiv_eq]
    simp
  have hd22 : ∀ x ∈ Metric.ball (0 : E3) (ρ / 4), 0 ≤ x 0 →
      partialDeriv 2 (partialDeriv 2 v') x = 0 := by
    intro x hx hx0
    have hxn : ‖x‖ < ρ / 4 := mem_ball_zero_iff.mp hx
    have hc : Tendsto (fun ε : ℝ => x + ε • e 0) (𝓝[>] 0) (𝓝 x) := by
      have hcont : Continuous (fun ε : ℝ => x + ε • e 0) := by fun_prop
      have h := hcont.tendsto 0
      simp only [zero_smul, add_zero] at h
      exact h.mono_left nhdsWithin_le_nhds
    have h1 : Tendsto (fun ε : ℝ => partialDeriv 2 (partialDeriv 2 v') (x + ε • e 0))
        (𝓝[>] 0) (𝓝 (partialDeriv 2 (partialDeriv 2 v') x)) :=
      (hD.continuousAt (Metric.isOpen_ball.mem_nhds hx)).tendsto.comp hc
    have h2 : Tendsto (fun ε : ℝ => partialDeriv 2 (partialDeriv 2 v') (x + ε • e 0))
        (𝓝[>] 0) (𝓝 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT (show (0 : ℝ) < ρ / 4 - ‖x‖ by linarith)] with ε hε
      symm
      apply hDΩ
      refine ⟨?_, ?_⟩
      · rw [mem_ball_zero_iff]
        calc ‖x + ε • e 0‖ ≤ ‖x‖ + ‖ε • e 0‖ := norm_add_le _ _
          _ = ‖x‖ + ε := by
            rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
              abs_of_pos hε.1]
          _ < ρ / 4 := by linarith [hε.2]
      · have hcoord : (x + ε • e 0) 0 = x 0 + ε := by
          simp [EuclideanSpace.single_apply]
        show 0 < (x + ε • e 0) 0
        rw [hcoord]
        linarith [hε.1]
    exact tendsto_nhds_unique h1 h2
  
  obtain ⟨L, hLz⟩ : ∃ L : E2 →L[ℝ] E3, ∀ z : E2, L z = cylPt (z 0) (z 1) 0 :=
    ⟨(EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 0) +
      (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1), fun z => by simp [cylPt]⟩
  have hLe0 : L (e2 0) = e 0 := by
    rw [hLz]
    simp [cylPt, EuclideanSpace.single_apply]
  have hLe1 : L (e2 1) = e 1 := by
    rw [hLz]
    simp [cylPt, EuclideanSpace.single_apply]
  have hslice : ∀ (f : E3 → ℝ) (z : E2), DifferentiableAt ℝ f (cylPt (z 0) (z 1) 0) →
      pd2 0 (fun z' => f (cylPt (z' 0) (z' 1) 0)) z = partialDeriv 0 f (cylPt (z 0) (z 1) 0) ∧
      pd2 1 (fun z' => f (cylPt (z' 0) (z' 1) 0)) z = partialDeriv 1 f (cylPt (z 0) (z 1) 0) := by
    intro f z hf
    have hf' : DifferentiableAt ℝ f (L z) := by rw [hLz]; exact hf
    have hfun : (fun z' => f (cylPt (z' 0) (z' 1) 0)) = f ∘ L := by
      funext z'
      simp only [Function.comp, hLz]
    have hcomp : fderiv ℝ (fun z' => f (cylPt (z' 0) (z' 1) 0)) z = (fderiv ℝ f (L z)).comp L := by
      rw [hfun, fderiv_comp z hf' L.differentiableAt, ContinuousLinearMap.fderiv]
    unfold pd2 partialDeriv
    rw [hcomp, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply, hLe0, hLe1, hLz]
    exact ⟨rfl, rfl⟩
  
  have hPmaps : ∀ x ∈ Metric.ball (0 : E3) (ρ / 4), pcgbF2P x ∈ Metric.ball (0 : E2) ρ := by
    intro x hx
    rw [mem_ball_zero_iff] at hx ⊢
    linarith [hPn x]
  have hAP : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => A (pcgbF2P x) i j)
      (Metric.ball (0 : E3) (ρ / 4)) := fun i j =>
    (hA i j).comp pcgbF2P.contDiff.contDiffOn (fun x hx => hPmaps x hx)
  have hA3 : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => pcgbF2A A x a b)
      (Metric.ball (0 : E3) (ρ / 4)) := by
    intro a b
    fin_cases a <;> fin_cases b <;>
      first
        | exact (hAP 0 0).congr (fun x _ => rfl)
        | exact (hAP 0 1).congr (fun x _ => rfl)
        | exact (hAP 1 0).congr (fun x _ => rfl)
        | exact (hAP 1 1).congr (fun x _ => rfl)
        | exact (contDiffOn_const (c := (0 : ℝ))).congr (fun x _ => rfl)
        | exact (contDiffOn_const (c := (1 : ℝ))).congr (fun x _ => rfl)
  have hH : ∀ a : Fin 3, ContDiffOn ℝ ∞
      (fun y => ∑ b : Fin 3, pcgbF2A A y a b * partialDeriv b v' y)
      (Metric.ball (0 : E3) (ρ / 4)) := fun a =>
    ContDiffOn.sum (fun b _ => (hA3 a b).mul (hpd_smooth v' hv' b))
  
  have hrow0 : ∀ y ∈ Metric.ball (0 : E2) (ρ / 8),
      (∑ b : Fin 2, A y 0 b * pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) =
        (fun x => ∑ b : Fin 3, pcgbF2A A x 0 b * partialDeriv b v' x) (cylPt (y 0) (y 1) 0) := by
    intro y hy
    obtain ⟨hs0, hs1⟩ := hslice v' y (hdiff v' hv' _ (hE0ball y hy))
    obtain ⟨f00, f01, f02, -, -, -, -, -, -⟩ := hF (cylPt (y 0) (y 1) 0)
    simp only [Fin.sum_univ_two, Fin.sum_univ_three, hs0, hs1, f00, f01, f02, hPE y]
    ring
  have hrow1 : ∀ y ∈ Metric.ball (0 : E2) (ρ / 8),
      (∑ b : Fin 2, A y 1 b * pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) =
        (fun x => ∑ b : Fin 3, pcgbF2A A x 1 b * partialDeriv b v' x) (cylPt (y 0) (y 1) 0) := by
    intro y hy
    obtain ⟨hs0, hs1⟩ := hslice v' y (hdiff v' hv' _ (hE0ball y hy))
    obtain ⟨-, -, -, f10, f11, f12, -, -, -⟩ := hF (cylPt (y 0) (y 1) 0)
    simp only [Fin.sum_univ_two, Fin.sum_univ_three, hs0, hs1, f10, f11, f12, hPE y]
    ring
  
  have hrow2 : (fun y => ∑ b : Fin 3, pcgbF2A A y 2 b * partialDeriv b v' y) =
      partialDeriv 2 v' := by
    funext y
    obtain ⟨-, -, -, -, -, -, f20, f21, f22⟩ := hF y
    rw [Fin.sum_univ_three, f20, f21, f22]
    ring
  
  intro z hz hz0
  have hx : cylPt (z 0) (z 1) 0 ∈ Metric.ball (0 : E3) (ρ / 4) := hE0ball z hz
  have hx0 : 0 ≤ (cylPt (z 0) (z 1) 0) 0 := by rw [(hcyl _ _ _).1]; exact hz0
  have hzn : Metric.ball (0 : E2) (ρ / 8) ∈ 𝓝 z := Metric.isOpen_ball.mem_nhds hz
  have hT0 : pd2 0 (fun y => ∑ b : Fin 2, A y 0 b *
        pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) z =
      partialDeriv 0 (fun x => ∑ b : Fin 3, pcgbF2A A x 0 b * partialDeriv b v' x)
        (cylPt (z 0) (z 1) 0) := by
    have hev : (fun y => ∑ b : Fin 2, A y 0 b *
          pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) =ᶠ[𝓝 z]
        (fun y => (fun x => ∑ b : Fin 3, pcgbF2A A x 0 b * partialDeriv b v' x)
          (cylPt (y 0) (y 1) 0)) :=
      Filter.eventually_of_mem hzn hrow0
    show fderiv ℝ (fun y => ∑ b : Fin 2, A y 0 b *
        pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) z (e2 0) = _
    rw [hev.fderiv_eq]
    exact (hslice _ z (hdiff _ (hH 0) _ hx)).1
  have hT1 : pd2 1 (fun y => ∑ b : Fin 2, A y 1 b *
        pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) z =
      partialDeriv 1 (fun x => ∑ b : Fin 3, pcgbF2A A x 1 b * partialDeriv b v' x)
        (cylPt (z 0) (z 1) 0) := by
    have hev : (fun y => ∑ b : Fin 2, A y 1 b *
          pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) =ᶠ[𝓝 z]
        (fun y => (fun x => ∑ b : Fin 3, pcgbF2A A x 1 b * partialDeriv b v' x)
          (cylPt (y 0) (y 1) 0)) :=
      Filter.eventually_of_mem hzn hrow1
    show fderiv ℝ (fun y => ∑ b : Fin 2, A y 1 b *
        pd2 b (fun z' => v' (cylPt (z' 0) (z' 1) 0)) y) z (e2 1) = _
    rw [hev.fderiv_eq]
    exact (hslice _ z (hdiff _ (hH 1) _ hx)).2
  have h3 := heq _ hx hx0
  rw [Fin.sum_univ_three, hrow2, hd22 _ hx hx0] at h3
  rw [Fin.sum_univ_two, hT0, hT1]
  linarith

theorem pcgb_flat2_ae_slice (ρ : ℝ) (hρ : 0 < ρ) (T : E3 ≃ᵐ (E2 × ℝ))
    (hT : MeasureTheory.MeasurePreserving T MeasureTheory.volume MeasureTheory.volume)
    (hTx : ∀ x : E3, T x = (pcgbF2P x, x 2)) (v' : E3 → ℝ) (w : E2 → ℝ)
    (hinv : ∀ (x : E3) (τ : ℝ), x ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} →
      x + τ • e 2 ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} → v' (x + τ • e 2) = v' x)
    (hae : ∀ᵐ x ∂(volume.restrict (Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0})),
      w (pcgbF2P x) = v' x) :
    ∀ᵐ z ∂(volume.restrict (Metric.ball (0 : E2) (ρ / 8) ∩ {z | 0 < z 0})),
      w z = v' (cylPt (z 0) (z 1) 0) :=
by
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hR : ∀ x : E3, cylPt (x 0) (x 1) 0 + x 2 • e 2 = x := by
    intro x
    ext i
    fin_cases i <;> simp [cylPt, EuclideanSpace.single_apply]
  have hD : IsOpen (Metric.ball (0 : E2) (ρ / 8) ∩ {z : E2 | 0 < z 0}) :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).continuous)
  have hΩ : IsOpen (Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0}) :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const
      (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous)
  rw [ae_restrict_iff' hD.measurableSet, ae_iff]
  rw [ae_restrict_iff' hΩ.measurableSet, ae_iff] at hae
  have hsub : T ⁻¹' ({z : E2 | ¬(z ∈ Metric.ball (0 : E2) (ρ / 8) ∩ {z | 0 < z 0} →
        w z = v' (cylPt (z 0) (z 1) 0))} ×ˢ Set.Ioo (-(ρ / 8)) (ρ / 8)) ⊆
      {x : E3 | ¬(x ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} →
        w (pcgbF2P x) = v' x)} := by
    intro x hx
    simp only [Set.mem_preimage, hTx, Set.mem_prod] at hx
    obtain ⟨hxB, hxI⟩ := hx
    simp only [Set.mem_setOf_eq, _root_.not_imp, Set.mem_inter_iff, mem_ball_zero_iff] at hxB
    obtain ⟨⟨hpn, hp0⟩, hne⟩ := hxB
    rw [hP0, hP1] at hne
    rw [hP0] at hp0
    have h2 := hnsq2 (pcgbF2P x)
    rw [hP0, hP1] at h2
    have h3 := hnsq3 x
    obtain ⟨hI1, hI2⟩ := hxI
    have hpnn := norm_nonneg (pcgbF2P x)
    have hpsq : ‖pcgbF2P x‖ ^ 2 < (ρ / 8) ^ 2 := by nlinarith
    have hx2sq : x 2 ^ 2 < (ρ / 8) ^ 2 := by nlinarith
    have hxΩ : x ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} := by
      refine ⟨?_, hp0⟩
      rw [mem_ball_zero_iff]
      have hxsq : ‖x‖ ^ 2 < (ρ / 4) ^ 2 := by nlinarith
      have hxn := norm_nonneg x
      by_contra hcon
      push_neg at hcon
      nlinarith
    have hyΩ : cylPt (x 0) (x 1) 0 ∈ Metric.ball (0 : E3) (ρ / 4) ∩ {x : E3 | 0 < x 0} := by
      obtain ⟨c0, c1, c2⟩ := hcyl (x 0) (x 1) 0
      refine ⟨?_, ?_⟩
      · rw [mem_ball_zero_iff]
        have h4 := hnsq3 (cylPt (x 0) (x 1) 0)
        rw [c0, c1, c2] at h4
        have hysq : ‖cylPt (x 0) (x 1) 0‖ ^ 2 < (ρ / 4) ^ 2 := by nlinarith
        have hyn := norm_nonneg (cylPt (x 0) (x 1) 0)
        by_contra hcon
        push_neg at hcon
        nlinarith
      · show 0 < (cylPt (x 0) (x 1) 0) 0
        rw [c0]
        exact hp0
    have hv := hinv _ (x 2) hyΩ (by rw [hR]; exact hxΩ)
    rw [hR] at hv
    simp only [Set.mem_setOf_eq, _root_.not_imp]
    refine ⟨hxΩ, ?_⟩
    rw [hv]
    exact hne
  have hprod : volume {z : E2 | ¬(z ∈ Metric.ball (0 : E2) (ρ / 8) ∩ {z | 0 < z 0} →
        w z = v' (cylPt (z 0) (z 1) 0))} * volume (Set.Ioo (-(ρ / 8)) (ρ / 8)) = 0 := by
    have h1 : volume (T ⁻¹' ({z : E2 | ¬(z ∈ Metric.ball (0 : E2) (ρ / 8) ∩ {z | 0 < z 0} →
          w z = v' (cylPt (z 0) (z 1) 0))} ×ˢ Set.Ioo (-(ρ / 8)) (ρ / 8))) =
        volume {z : E2 | ¬(z ∈ Metric.ball (0 : E2) (ρ / 8) ∩ {z | 0 < z 0} →
          w z = v' (cylPt (z 0) (z 1) 0))} * volume (Set.Ioo (-(ρ / 8)) (ρ / 8)) := by
      rw [hT.measure_preimage_equiv]
      exact Measure.prod_prod _ _
    rw [← h1]
    exact measure_mono_null hsub hae
  have hI : volume (Set.Ioo (-(ρ / 8)) (ρ / 8)) ≠ 0 := by
    rw [Real.volume_Ioo, Ne, ENNReal.ofReal_eq_zero, not_le]
    linarith
  rcases mul_eq_zero.mp hprod with h | h
  · exact h
  · exact absurd h hI

theorem pcgb_bdr_flat2_regularity (ρ : ℝ) (hρ : 0 < ρ) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun z => A z a b) (Metric.ball (0 : E2) ρ))
    (hAs : ∀ z ∈ Metric.ball (0 : E2) ρ, ∀ a b : Fin 2, A z a b = A z b a)
    (hApos : ∀ z ∈ Metric.ball (0 : E2) ρ, (A z).PosDef)
    (u : ℕ → E2 → ℝ) (hu : ∀ m, ContDiffOn ℝ ∞ (u m) (Metric.ball (0 : E2) ρ))
    (huz : ∀ m, ∃ c : ℝ, 0 < c ∧ ∀ z ∈ Metric.ball (0 : E2) ρ, z 0 < c → u m z = 0)
    (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ Metric.ball (0 : E2) ρ →
      MemLp w 2 (volume.restrict L) ∧ (∀ k, MemLp (G k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ z in L, (u m z - w z) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ z in L, (pd2 k (u m) z - G k z) ^ 2) atTop (𝓝 0))
    (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball (0 : E2) ρ ∩ {z | 0 < z 0} →
      ∫ z, ∑ a : Fin 2, ∑ b : Fin 2, A z a b * G b z * pd2 a ζ z = 0) :
    ∃ s : ℝ, 0 < s ∧ s ≤ ρ ∧ ∃ V : E2 → ℝ,
      ContDiffOn ℝ ∞ V (Metric.ball (0 : E2) s) ∧
      (∀ᵐ z ∂(volume.restrict (Metric.ball (0 : E2) s ∩ {z | 0 < z 0})), w z = V z) ∧
      (∀ z ∈ Metric.ball (0 : E2) s, 0 ≤ z 0 →
        ∑ a : Fin 2, pd2 a (fun y => ∑ b : Fin 2, A y a b * pd2 b V y) z = 0) ∧
      (∀ z ∈ Metric.ball (0 : E2) s, z 0 = 0 → V z = 0) :=
by
  
  have hP0 : ∀ x : E3, pcgbF2P x 0 = x 0 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hP1 : ∀ x : E3, pcgbF2P x 1 = x 1 := by
    intro x
    simp [pcgbF2P, EuclideanSpace.single_apply]
  have hnsq3 : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hnsq2 : ∀ z : E2, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hPn : ∀ x : E3, ‖pcgbF2P x‖ ≤ ‖x‖ := by
    intro x
    have h1 := hnsq2 (pcgbF2P x)
    have h2 := hnsq3 x
    rw [hP0, hP1] at h1
    have h3 := norm_nonneg (pcgbF2P x)
    have h4 := norm_nonneg x
    nlinarith [sq_nonneg (x 2)]
  have hPball : ∀ R : ℝ, ∀ x ∈ Metric.ball (0 : E3) R, pcgbF2P x ∈ Metric.ball (0 : E2) R := by
    intro R x hx
    rw [mem_ball_zero_iff] at hx ⊢
    exact lt_of_le_of_lt (hPn x) hx
  have hE0 : ContDiff ℝ ∞ (fun z : E2 => cylPt (z 0) (z 1) 0) := by
    have h0 : ContDiff ℝ ∞ (fun z : E2 => z 0) :=
      (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).contDiff
    have h1 : ContDiff ℝ ∞ (fun z : E2 => z 1) :=
      (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).contDiff
    unfold cylPt
    exact ((h0.smul contDiff_const).add (h1.smul contDiff_const)).add contDiff_const
  have hE0ball : ∀ z ∈ Metric.ball (0 : E2) (ρ / 8),
      cylPt (z 0) (z 1) 0 ∈ Metric.ball (0 : E3) (ρ / 4) := by
    intro z hz
    rw [mem_ball_zero_iff] at hz ⊢
    have h1 := hnsq3 (cylPt (z 0) (z 1) 0)
    obtain ⟨c0, c1, c2⟩ := hcyl (z 0) (z 1) 0
    rw [c0, c1, c2] at h1
    have h2 := hnsq2 z
    have h3 := norm_nonneg (cylPt (z 0) (z 1) 0)
    have h4 := norm_nonneg z
    nlinarith
  
  obtain ⟨T, hT, hTx⟩ := pcgb_flat2_split
  
  obtain ⟨hA3, hAs3, hApos3⟩ := pcgb_flat2_coeff_lift ρ hρ A hA hAs hApos
  
  have hvn : ∀ m, ContDiffOn ℝ ∞ (fun x => u m (pcgbF2P x)) (Metric.ball (0 : E3) ρ) :=
    fun m => (hu m).comp pcgbF2P.contDiff.contDiffOn (fun x hx => hPball ρ x hx)
  have hvz : ∀ m, ∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball (0 : E3) ρ | x 0 = 0} ⊆ O ∧
      ∀ x ∈ O, (fun m x => u m (pcgbF2P x)) m x = 0 := by
    intro m
    obtain ⟨c, hc, hcz⟩ := huz m
    refine ⟨Metric.ball (0 : E3) ρ ∩ {x : E3 | x 0 < c},
      Metric.isOpen_ball.inter (isOpen_lt
        (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).continuous continuous_const), ?_, ?_⟩
    · intro x hx
      refine ⟨hx.1, ?_⟩
      show x 0 < c
      rw [hx.2]
      exact hc
    · intro x hx
      show u m (pcgbF2P x) = 0
      refine hcz _ (hPball ρ x hx.1) ?_
      rw [hP0]
      exact hx.2
  
  have hcore := fun φ hφ => pcgb_flat2_lift_sq ρ hρ T hT hTx φ hφ
  obtain ⟨hvL, hGL, hv0, hv1⟩ := pcgb_flat2_l2_data ρ hρ u hu w G hL2 hcore
  
  have hKsub : Metric.closedBall (0 : E2) (ρ / 2) ⊆ Metric.ball (0 : E2) ρ :=
    Metric.closedBall_subset_ball (by linarith)
  have hG : ∀ k, MemLp (G k) 2 (volume.restrict (Metric.closedBall (0 : E2) (ρ / 2))) :=
    (hL2 _ (isCompact_closedBall _ _) hKsub).2.1
  have hweak3 : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball (0 : E3) (ρ / 2) →
      (∃ O : Set E3, IsOpen O ∧ {x ∈ Metric.ball (0 : E3) ρ | x 0 = 0} ⊆ O ∧
        ∀ x ∈ O, ζ x = 0) →
      ∫ x in ndsHalf (0 : E3) ρ,
        (∑ a : Fin 3, ∑ b : Fin 3, pcgbF2A A x a b * pcgbF2G G b x * partialDeriv a ζ x +
          (fun _ : E3 => (0 : ℝ)) x * ζ x) = 0 := by
    intro ζ hζ hζc hζs hO
    have hslice := fun t => pcgb_flat2_slice_weak ρ hρ A G hweak ζ hζ hζc hζs hO t
    have hfl := pcgb_flat2_fubini_lift ρ hρ T hT hTx A hA G hG ζ hζ hζc hζs hslice
    simp only [zero_mul, add_zero]
    exact hfl
  
  obtain ⟨v', hv's, hae, heq3, hface⟩ := flat_dirichlet_regularity (0 : E3) ρ hρ (by simp)
    (pcgbF2A A) hA3 hAs3 hApos3 (fun _ => 0) contDiffOn_const (fun x => w (pcgbF2P x))
    (pcgbF2G G) (fun m x => u m (pcgbF2P x)) hvn hvz hvL hGL hv0 hv1 hweak3
  
  have hinv := pcgb_flat2_x2_invariant (ρ / 4) v' w hv's.continuousOn hae
  
  have heq2 := pcgb_flat2_eq_slice ρ hρ A hA v' hv's hinv heq3
  
  have hae2 := pcgb_flat2_ae_slice ρ hρ T hT hTx v' w hinv hae
  
  refine ⟨ρ / 8, by positivity, by linarith, fun z => v' (cylPt (z 0) (z 1) 0), ?_, hae2,
    heq2, ?_⟩
  · exact hv's.comp hE0.contDiffOn (fun z hz => hE0ball z hz)
  · intro z hz hz0
    refine hface _ (hE0ball z hz) ?_
    rw [(hcyl (z 0) (z 1) 0).1]
    exact hz0

theorem lap2_chart_invariant (A B : Set E2) (hA : IsOpen A) (hB : IsOpen B) (τ : E2 → E2)
    (hτ : ContDiffOn ℝ ∞ τ A) (hτAB : ∀ x ∈ A, τ x ∈ B)
    (h h' : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h y c d) A)
    (hh' : ∀ c d : Fin 2, ContDiffOn ℝ ∞ (fun y => h' y c d) B)
    (hpd' : ∀ y ∈ B, (h' y).PosDef) (hpd : ∀ x ∈ A, (h x).PosDef)
    (hcomp : ∀ x ∈ A, ∀ c d : Fin 2, h x c d = ∑ c' : Fin 2, ∑ d' : Fin 2,
      fderiv ℝ τ x (e2 c) c' * h' (τ x) c' d' * fderiv ℝ τ x (e2 d) d')
    (g : E2 → ℝ) (hg : ContDiffOn ℝ ∞ g B) (f : E2 → ℝ) (hf : ∀ x ∈ A, f x = g (τ x))
    (x : E2) (hx : x ∈ A) :
    lap2 h f x = lap2 h' g (τ x) :=
by
  
  
  have ctrans : ∀ m b c : Fin 2,
      ∑ e : Fin 2, fderiv ℝ τ x (e2 e) m * christoffel2 h e b c x =
        ∑ p : Fin 2, ∑ q : Fin 2,
            christoffel2 h' m p q (τ x) * fderiv ℝ τ x (e2 b) p * fderiv ℝ τ x (e2 c) q +
          fderiv ℝ (fun y => fderiv ℝ τ y (e2 c)) x (e2 b) m := by
    intro m b c
