      have h1 : Yf k ((chartAt E3 (p k)).symm y) =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)).symm y (Y k y) : E3) := by
        rw [hYf]
        simp only [Set.indicator_of_mem hs]
        exact congrArg (fun z => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)).symm z
          (Y k z) : E3)) ((chartAt E3 (p k)).right_inv hy)
      rw [h1]
      have h2 := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) (p k)).comp_symm_deriv hy
      exact congrArg (fun L => L (Y k y)) h2
    have halpha : ∀ k, Y k = fun y => ∑ j, calPiece (p k) (fun x => ζ k x * φ j x) (Yf k) y := by
      intro k
      funext y
      unfold calPiece
      by_cases hy : y ∈ (chartAt E3 (p k)).target
      · simp only [Set.indicator_of_mem hy, hcomp k y hy]
        rw [← Finset.sum_smul, ← Finset.mul_sum]
        by_cases hY0 : Y k y = 0
        · rw [hY0, smul_zero]
        · have hx : (chartAt E3 (p k)).symm y ∈ C k := by
            rw [hC]
            exact ⟨y, subset_tsupport _ hY0, rfl⟩
          rw [hζ1 k _ hx, hφ1 _ (Set.mem_iUnion.2 ⟨k, hx⟩), one_mul, one_smul]
      · simp only [Set.indicator_of_notMem hy, Finset.sum_const_zero]
        exact image_eq_zero_of_notMem_tsupport (fun h => hy (hta k h))
    have hbeta : ∀ k, ∫ y in chartAt E3 (p k) '' (E ∩ (chartAt E3 (p k)).source),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Y k) y =
        ∑ j, ∫ y in chartAt E3 (p k) '' (E ∩ (chartAt E3 (p k)).source),
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm)
            (calPiece (p k) (fun x => ζ k x * φ j x) (Yf k)) y := by
      intro k
      have hreg := fun j => calPiece_regular g (p k) (fun x => ζ k x * φ j x) (hψ k j).1
        (hψ k j).2.1 (fun x hx => ((hψ k j).2.2 hx).1) (Yf k) (hYfs k)
      rw [← MeasureTheory.integral_finset_sum _ (fun j _ => (hreg j).2.integrableOn)]
      congr 1
      funext y
      conv_lhs => rw [halpha k]
      exact divsum _ Finset.univ _ y (fun j _ i => ((hreg j).1 i).differentiable (by simp) y)
    have hdelta : ∀ k j, calPiece (q j) (fun x => ζ k x * φ j x) (Yf k) =
        calPiece (q j) (φ j) (Yf k) := by
      intro k j
      funext y
      unfold calPiece
      by_cases hy : y ∈ (chartAt E3 (q j)).target
      · simp only [Set.indicator_of_mem hy]
        by_cases h0 : Yf k ((chartAt E3 (q j)).symm y) = 0
        · simp only [h0, map_zero, smul_zero]
        · rw [hζ1 k _ (hYfC k _ h0), one_mul]
      · simp only [Set.indicator_of_notMem hy]
    have hgamma : ∀ k j, ∫ y in chartAt E3 (p k) '' (E ∩ (chartAt E3 (p k)).source),
