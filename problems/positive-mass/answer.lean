    have hξT : ξ ∈ Metric.ball (0 : Fin 2 → ℝ) T := by
      rw [Metric.mem_ball, dist_zero_right, hξn]; linarith
    have h0T : (0 : Fin 2 → ℝ) ∈ Metric.ball (0 : Fin 2 → ℝ) T := Metric.mem_ball_self hT
    have hgW0 : smthGrad W 0 = 0 := by
      funext j; rw [hWg 0 h0T j]; simp
    have hW0 : W 0 = 0 := by rw [hW]; simp
    have h7 : 1 / 2 ≤ ‖smthGrad W ξ‖ := by
      have e1 : smthGrad W ξ = smthGrad W ξ - smthGrad W 0 := by rw [hgW0, sub_zero]
      rw [e1, hgW ξ hξT 0 h0T, hAξ, smul_zero, add_zero, norm_smul, norm_inv,
        Real.norm_of_nonneg hκ.le, norm_sub_rev, hDdef, inv_mul_eq_div, le_div_iff₀ hκ]
      have : κ * (1 / 2) < D := by
        rw [hκ_def, div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
