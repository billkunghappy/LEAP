  obtain ⟨U, hUc, hUel⟩ := nds_direct_method B L Q CP _ hBsymm hBlin hBnn hLlin hQb hLb
  
  have hsubU : ∀ m l, ((U m - U l : ↥(ndsV0 S₀)) : M → ℝ) =
