  have hball' : ∀ i, Metric.ball y₀ (εs i₀) ⊆ Metric.ball y₀ (εs i) :=
    fun i => Metric.ball_subset_ball (hi₀ i (Finset.mem_univ _))
  have hball'ε : Metric.ball y₀ (εs i₀) ⊆ Metric.ball y₀ ε := (hball' i₀).trans (hεsb i₀)
  have hτ : ∀ b : Bool, (if b then (1 : ℝ) else -1) = 1 ∨ (if b then (1 : ℝ) else -1) = -1 := by
    intro b; cases b <;> simp
  have hτne : ∀ b : Bool, (if b then (1 : ℝ) else -1) ≠ 0 := by
    intro b; cases b <;> norm_num
  have hτneg : ∀ b : Bool, (if !b then (1 : ℝ) else -1) = -(if b then (1 : ℝ) else -1) := by
    intro b; cases b <;> simp
  have hDopen : ∀ (s : Fin k → Bool) (ρ : ℝ), ρ ≤ εs i₀ →
      IsOpen {z | z ∈ Metric.ball y₀ ρ ∧ ∀ i, 0 < φ i (s i) z} := by
    intro s ρ hρ
    have e : {z | z ∈ Metric.ball y₀ ρ ∧ ∀ i, 0 < φ i (s i) z} =
        Metric.ball y₀ ρ ∩ ⋂ i, (Metric.ball y₀ ρ ∩ φ i (s i) ⁻¹' Set.Ioi 0) := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter, Set.mem_preimage,
        Set.mem_Ioi]
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => ⟨h1, h2 i⟩⟩
      · rintro ⟨h1, h2⟩; exact ⟨h1, fun i => (h2 i).2⟩
    rw [e]
    refine Metric.isOpen_ball.inter (isOpen_iInter_of_finite fun i => ?_)
    exact ((hφ i (s i)).1.continuousOn.mono
      ((Metric.ball_subset_ball hρ).trans (hball' i))).isOpen_inter_preimage
      Metric.isOpen_ball isOpen_Ioi
  
  have R : ∀ (s : Fin k → Bool) (ρ : ℝ), 0 < ρ → ρ ≤ εs i₀ →
      (∀ N ∈ 𝓝 y₀, volume (N ∩ (Fκ ∩ {z | z ∈ Metric.ball y₀ ρ ∧ ∀ i, 0 < φ i (s i) z})) ≠ 0) →
      ∃ (a : Fin 3) (u : E3 → ℝ) (r δ σ : ℝ), 0 < r ∧ 0 < δ ∧ ContDiff ℝ ∞ u ∧
        u (sepPlaneProj a y₀) = y₀ a ∧ sepCyl a y₀ r δ ⊆ Metric.ball y₀ ρ ∧
        (∀ z ∈ sepCyl a y₀ r δ, z a = u (sepPlaneProj a z) →
          levelMeanCurvCoord G (fun w => w a - u (sepPlaneProj a w)) z = 0) ∧
        (σ = 1 ∨ σ = -1) ∧
        (∀ i, ∀ z ∈ sepCyl a y₀ r δ, (f i z = 0 ↔ z a = u (sepPlaneProj a z)) ∧
