            |partialDeriv l' (fun z => partialDeriv i' (fun y => partialDeriv j' w y) z) x| :=
          Finset.single_le_sum
            (f := fun l' => ∑ i' : Fin 3, ∑ j' : Fin 3,
              |partialDeriv l' (fun z => partialDeriv i' (fun y => partialDeriv j' w y) z) x|)
            (fun _ _ => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)))
            (Finset.mem_univ l)
  have hL0 : 0 ≤ L := le_trans (abs_nonneg _) (hterm 0 (Metric.mem_ball_self one_pos) 0 0 0)
  have hinit : ∀ x ∈ Metric.ball (0 : E3) 1, ∀ y ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
      |partialDeriv i (fun z => partialDeriv j w z) x - partialDeriv i (fun z => partialDeriv j w z) y|
