      have h3 : 0 ≤ 2000 * (1 + A) ^ 2 * t * τ := by positivity
      rw [abs_div, abs_of_pos hs3pos, div_le_iff₀ hs3pos]
      nlinarith
    have g4 := abs_add_le ((a1 + 2 * τ * T) / s) (2 * τ * T * (s - 1) / s)
    have g5 := hsub ((a1 + 2 * τ * T) / s + 2 * τ * T * (s - 1) / s) (a2 / s ^ 3)
    nlinarith
  
  have s1 : ∀ (ν b x : E3) (M : Matrix (Fin 3) (Fin 3) ℝ) (ρ τ c : ℝ), ρ ≠ 0 →
      (∀ (y : E3) (k : Fin 3),
      partialDeriv k (fun y => @inner ℝ E3 _ ν (y - x) -
           τ * ρ * (@inner ℝ E3 _ b (ρ⁻¹ • (y - x)) +
             ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - x)) i * (ρ⁻¹ • (y - x)) j + c)) y
