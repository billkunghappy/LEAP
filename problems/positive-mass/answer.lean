    simp [hc]
  have hfinal : ∀ z ∈ sepCyl a y₀ s s,
      (f z = 0 ↔ F₁ z = 0) ∧
      (0 < τ * f z ↔ 0 < τ * (partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z)))) ∧
      (0 < σ * F₁ z ↔
        0 < σ * (κ * partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z)))) := by
    intro z hz
    obtain ⟨-, -, hz1, hz2, hz2ρ⟩ := hzfacts z hz
    have hv := hEQ z hz2ρ
    have i1 := hiff₁ z hz1
    have i2 := hiff₂ z hz2
    rw [← hv] at i2
    rw [hd₁] at i1
    refine ⟨i2.1.trans i1.1.symm, hsg _ _ τ (i2.1.trans (hX _ _ _ hd₂)) i2.2,
      hsg _ _ σ (i1.1.trans (hX _ _ _ (mul_ne_zero hκ hd₂))) i1.2⟩
  
  have hSG : 0 < τ * κ * σ := by
    obtain ⟨zs, hzs⟩ : ∃ zs : E3, zs = y₀ + (s / 2 * σ) • e a := ⟨_, rfl⟩
    have hPe : sepPlaneProj a ((s / 2 * σ) • e a) = 0 := by
      have := hPadd a 0 (s / 2 * σ)
      rwa [zero_add, hP0] at this
    have habsσ : |σ| = 1 := by rcases hσ with h | h <;> rw [h] <;> norm_num
    have hzsa : zs a - y₀ a = s / 2 * σ := by rw [hzs]; simp
    have hzsmem : zs ∈ sepCyl a y₀ s s := by
      refine ⟨?_, ?_⟩
      · rw [hzs, add_sub_cancel_left, hPe, norm_zero]; exact hs
      · rw [hzsa, abs_mul, habsσ, mul_one, abs_of_pos (by positivity)]; linarith
    have hPzs : sepPlaneProj a zs = sepPlaneProj a y₀ := by rw [hzs, hPadd]
    have hF₁zs : F₁ zs = s / 2 * σ := by
      show zs a - u (sepPlaneProj a zs) = s / 2 * σ
      rw [hPzs, hu0]; exact hzsa
    obtain ⟨hzsC, hzsB, -, -, -⟩ := hzfacts zs hzsmem
    have hσF : 0 < σ * F₁ zs := by
      rw [hF₁zs]
      have : σ * (s / 2 * σ) = s / 2 * (σ * σ) := by ring
      rw [this, hσ2]; linarith
    have hτf0 := hOS1 zs hzsC hzsB hσF
    obtain ⟨h0, hτ', hσ'⟩ := hfinal zs hzsmem
    have hfne : f zs ≠ 0 := by
      intro h
      have := h0.mp h
      rw [hF₁zs] at this
      rcases mul_eq_zero.mp this with h' | h'
      · linarith
      · exact hσ0 h'
    have hτf : 0 < τ * f zs := lt_of_le_of_ne hτf0 (Ne.symm (mul_ne_zero hτ0 hfne))
    have hA := hτ'.mp hτf
    have hB := hσ'.mp hσF
    by_contra hcon
    push_neg at hcon
    nlinarith [mul_pos hA hB, sq_nonneg (partialDeriv b f y₀ * (zs b - V₁ (sepPlaneProj b zs)))]
  
  
  
  refine ⟨s, s, hs, hsr, hs, hsδ, fun z hz => (hzfacts z hz).2.1, ?_⟩
  intro z hz
  obtain ⟨h0, hτf, hσF⟩ := hfinal z hz
  refine ⟨h0.trans (show F₁ z = 0 ↔ z a = u (sepPlaneProj a z) from sub_eq_zero), ?_⟩
  have hmul : σ * (κ * partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z))) =
      (τ * κ * σ) * (τ * (partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z)))) := by
    linear_combination (-(σ * κ * partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z)))) * hτ2
  have key : 0 < τ * (partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z))) ↔
      0 < σ * (κ * partialDeriv b f y₀ * (z b - V₁ (sepPlaneProj b z))) := by
    rw [hmul, mul_pos_iff_of_pos_left hSG]
  exact hτf.trans (key.trans hσF.symm)

theorem hull_contact_regular [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (S : ℕ → Set M) (hS : ∀ n, IsCompact (S n) ∧ IsMinimalSurfaceSet g (S n)) (m : ℕ)
    (K Ω Kv Kin A₀ F E : Set M) (hKdef : K = ⋃ n ∈ Finset.range m, S n) (hΩ : IsOpen Ω)
    (hKv : IsCompact Kv) (hKvΩ : Kv ⊆ Ω) (hKin : IsClosed Kin) (hKinKv : Kin ⊆ interior Kv)
    (hKKin : K ⊆ Kin) (hA₀ : IsOpen A₀) (hA₀fr : frontier A₀ ⊆ Kin) (hF : sepChartMeas F)
    (hFA : symmDiff F A₀ ⊆ Kv) (hfin : hullRiemPer g F Ω K < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ Kv →
      hullRiemPer g F Ω K ≤ hullRiemPer g F' Ω K)
    (hcoll : sepChartNull (symmDiff F A₀ \ Kin))
    (hE : E = {x | x ∉ K ∧ ∃ N ∈ 𝓝 x, sepChartNull (N \ F)}) :
    ∀ p ∈ frontier E, p ∈ K → (∃ V ∈ 𝓝 p, V ∩ K ⊆ frontier E) ∧
      ∃ (a : Fin 3) (u : E3 → ℝ) (r δ : ℝ), 0 < r ∧ 0 < δ ∧
      ContDiff ℝ ∞ u ∧ u (sepPlaneProj a (chartAt E3 p p)) = chartAt E3 p p a ∧
      sepCyl a (chartAt E3 p p) r δ ⊆ (chartAt E3 p).target ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ,
        ((chartAt E3 p).symm z ∈ frontier E ↔ z a = u (sepPlaneProj a z))) ∧
      (∀ z ∈ sepCyl a (chartAt E3 p p) r δ, z a = u (sepPlaneProj a z) →
        levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
          (fun w => w a - u (sepPlaneProj a w)) z = 0) :=
by
  intro p hpE hpK
  have hKc : IsClosed K := by
    rw [hKdef]; exact ((Finset.range m).isCompact_biUnion (fun n _ => (hS n).1)).isClosed
  obtain ⟨hEo, -, -, -, -⟩ :=
    hull_normalization K Kin A₀ F E hKc hKin hKKin hA₀ hA₀fr hcoll hE
  set y₀ : E3 := chartAt E3 p p with hy₀def
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 p).symm with hGdef
  set Fκ : Set E3 := chartAt E3 p '' (F ∩ (chartAt E3 p).source) with hFκdef
  have hpsrc : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hpKv : p ∈ interior Kv := hKinKv (hKKin hpK)
  have hWo : IsOpen (chartAt E3 p '' (interior Kv ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source (isOpen_interior.inter (chartAt E3 p).open_source)
      Set.inter_subset_right
  have hWy : y₀ ∈ chartAt E3 p '' (interior Kv ∩ (chartAt E3 p).source) := ⟨p, ⟨hpKv, hpsrc⟩, rfl⟩
  have hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i := fun y i j => g.symm _ _ _
  
  have hcylmono : ∀ (b : Fin 3) (r δ r' δ' : ℝ), r' ≤ r → δ' ≤ δ →
