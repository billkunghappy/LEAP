      simp only [RiemannianMetric3.levelMeanCurv, RiemannianMetric3.gradInner, lapLoc, hgradB]
      exact levelMeanCurv_alg_combination J (g.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ hP ν
        cc (fun m => φ m p)
        (fun m i => partialDeriv i (fun y => φ m ((chartAt E3 p).symm y)) (chartAt E3 p p))
        (fun m i j => hessLoc (g.coeff (chartAt E3 p).symm)
          (fun y => f (c m) ((chartAt E3 p).symm y)) i j (chartAt E3 p p)) Λ
        (fun i j => hessLoc (g.coeff (chartAt E3 p).symm) (fun y => β ((chartAt E3 p).symm y))
          i j (chartAt E3 p p))
        hccpos hΛdef hΛpos hHβ
        (fun m hm => by
          have h := hH m hm
          simp only [RiemannianMetric3.levelMeanCurv, RiemannianMetric3.gradInner, lapLoc,
            hgradF m hm] at h
          exact h)
  exact ⟨β, hβs, hpos, hzero, fun p hp => (key p hp).1, fun p hp => (key p hp).2⟩

theorem level_chart [IsManifold 𝓘(ℝ, E3) ∞ M] (w β : M → ℝ)
    (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (p : M)
    (hξ : ∃ ξ : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w p ξ ≠ 0 ∧
      (β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ξ = 0))
    (hreg : β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0) (U : Set M) (hU : U ∈ 𝓝 p) :
    ∃ (κ : OpenPartialHomeomorph M E3) (ε : ℝ), 0 < ε ∧ p ∈ κ.source ∧ κ.source ⊆ U ∧
      κ p = 0 ∧ κ.target = Metric.ball 0 ε ∧
      (∀ x ∈ κ.source, w x - w p = κ x 0) ∧
      (β p = 0 → ∀ x ∈ κ.source, β x = κ x 1) :=
by
  have hproj : ∀ (i : Fin 3) (v : E3), EuclideanSpace.proj i v = v i := fun i v => rfl
  have hpc : p ∈ (chartAt E3 p).source := mem_chart_source E3 p
  have hcp : (chartAt E3 p).symm (chartAt E3 p p) = p := (chartAt E3 p).left_inv hpc
  
  have CH : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      ContDiffAt ℝ ∞ (f ∘ (chartAt E3 p).symm) (chartAt E3 p p) ∧
      fderiv ℝ (f ∘ (chartAt E3 p).symm) (chartAt E3 p p) =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p : E3 →L[ℝ] ℝ) := by
    intro f hf
    have h1 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 p).symm (chartAt E3 p p) :=
      (contMDiffOn_chart_symm (x := p)).contMDiffAt
        ((chartAt E3 p).open_target.mem_nhds (mem_chart_target E3 p))
    have h2 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ((chartAt E3 p).symm (chartAt E3 p p)) := by
      rw [hcp]; exact hf.contMDiffAt
    have h3 := h2.comp _ h1
    refine ⟨contMDiffAt_iff_contDiffAt.mp h3, ?_⟩
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f p :=
      hf.contMDiffAt.mdifferentiableAt (by simp)
    rw [hmd.mfderiv]
    simp [writtenInExtChartAt]
  
  have LA : ∀ (a b : E3 →L[ℝ] ℝ) (ξ : E3), a ξ ≠ 0 → b ξ = 0 → b ≠ 0 →
      ∃ c : E3 →L[ℝ] ℝ, ∀ v : E3, a v = 0 → b v = 0 → c v = 0 → v = 0 := by
    intro a b ξ haξ hbξ hb
    have hdec : ∀ v : E3, v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      intro v; ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    have hlin : ∀ (f : E3 →L[ℝ] ℝ) (v : E3),
        f v = v 0 * f (e 0) + v 1 * f (e 1) + v 2 * f (e 2) := by
      intro f v
      conv_lhs => rw [hdec v]
      simp [map_add, map_smul, smul_eq_mul]
    set α0 := a (e 0) with hα0
    set α1 := a (e 1) with hα1
    set α2 := a (e 2) with hα2
    set γ0 := b (e 0) with hγ0
    set γ1 := b (e 1) with hγ1
    set γ2 := b (e 2) with hγ2
    set z0 := α1 * γ2 - α2 * γ1 with hz0
    set z1 := α2 * γ0 - α0 * γ2 with hz1
    set z2 := α0 * γ1 - α1 * γ0 with hz2
    refine ⟨z0 • EuclideanSpace.proj (0 : Fin 3) + z1 • EuclideanSpace.proj (1 : Fin 3)
      + z2 • EuclideanSpace.proj (2 : Fin 3), ?_⟩
    have hS : z0 ^ 2 + z1 ^ 2 + z2 ^ 2 ≠ 0 := by
      intro hS0
      have hz0 : z0 = 0 := by nlinarith [sq_nonneg z0, sq_nonneg z1, sq_nonneg z2]
      have hz1 : z1 = 0 := by nlinarith [sq_nonneg z0, sq_nonneg z1, sq_nonneg z2]
      have hz2 : z2 = 0 := by nlinarith [sq_nonneg z0, sq_nonneg z1, sq_nonneg z2]
      have ha := hlin a ξ
      have hbb := hlin b ξ
      rw [hbξ] at hbb
      apply hb
      have hg0 : γ0 = 0 := by
        have : γ0 * a ξ = 0 := by
          rw [ha]
          linear_combination -(ξ 1) * hz2 + (ξ 2) * hz1 - α0 * hbb
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd h haξ
      have hg1 : γ1 = 0 := by
        have : γ1 * a ξ = 0 := by
          rw [ha]
          linear_combination -(ξ 2) * hz0 + (ξ 0) * hz2 - α1 * hbb
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd h haξ
      have hg2 : γ2 = 0 := by
        have : γ2 * a ξ = 0 := by
          rw [ha]
          linear_combination -(ξ 0) * hz1 + (ξ 1) * hz0 - α2 * hbb
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd h haξ
      ext v
      rw [hlin b v, show b (e 0) = 0 from hg0, show b (e 1) = 0 from hg1,
        show b (e 2) = 0 from hg2]
      simp
    intro v hav hbv hcv
    rw [hlin a v] at hav
    rw [hlin b v] at hbv
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      hproj, smul_eq_mul] at hcv
    have e0 : (z0 ^ 2 + z1 ^ 2 + z2 ^ 2) * v 0 = 0 := by
      linear_combination (γ1 * z2 - γ2 * z1) * hav + (z1 * α2 - z2 * α1) * hbv + z0 * hcv
    have e1 : (z0 ^ 2 + z1 ^ 2 + z2 ^ 2) * v 1 = 0 := by
      linear_combination (γ2 * z0 - γ0 * z2) * hav + (z2 * α0 - z0 * α2) * hbv + z1 * hcv
    have e2 : (z0 ^ 2 + z1 ^ 2 + z2 ^ 2) * v 2 = 0 := by
      linear_combination (γ0 * z1 - γ1 * z0) * hav + (z0 * α1 - z1 * α0) * hbv + z2 * hcv
    have h0 := (mul_eq_zero.mp e0).resolve_left hS
    have h1 := (mul_eq_zero.mp e1).resolve_left hS
    have h2 := (mul_eq_zero.mp e2).resolve_left hS
    ext i; fin_cases i <;> simp [h0, h1, h2]
  
  obtain ⟨ξ, haξ, hbξ'⟩ := hξ
  obtain ⟨hfw, hfw'⟩ := CH w hw
  obtain ⟨a, ha⟩ : ∃ a : E3 →L[ℝ] ℝ,
      a = fderiv ℝ (w ∘ (chartAt E3 p).symm) (chartAt E3 p p) := ⟨_, rfl⟩
  have hA : HasFDerivAt (w ∘ (chartAt E3 p).symm) a (chartAt E3 p p) := by
    rw [ha]; exact (hfw.differentiableAt (by simp)).hasFDerivAt
  have haξ' : a ξ ≠ 0 := by rw [ha, hfw']; exact haξ
  
  obtain ⟨b, g₂, hb0, hbξ, hg₂c, hg₂d, hg₂0, hg₂β⟩ : ∃ (b : E3 →L[ℝ] ℝ) (g₂ : E3 → ℝ),
      b ≠ 0 ∧ b ξ = 0 ∧ ContDiffAt ℝ ∞ g₂ (chartAt E3 p p) ∧
      HasFDerivAt g₂ b (chartAt E3 p p) ∧ g₂ (chartAt E3 p p) = 0 ∧
      (β p = 0 → ∀ x ∈ (chartAt E3 p).source, β x = g₂ (chartAt E3 p x)) := by
    by_cases hβp : β p = 0
    · obtain ⟨hfβ, hfβ'⟩ := CH β hβ
      refine ⟨fderiv ℝ (β ∘ (chartAt E3 p).symm) (chartAt E3 p p), β ∘ (chartAt E3 p).symm,
        ?_, ?_, hfβ, (hfβ.differentiableAt (by simp)).hasFDerivAt, ?_, ?_⟩
      · rw [hfβ']; exact hreg hβp
      · rw [hfβ']; exact hbξ' hβp
      · simp [hcp, hβp]
      · intro _ x hx
        simp [(chartAt E3 p).left_inv hx]
    · obtain ⟨b, hb, hbξ⟩ : ∃ b : E3 →L[ℝ] ℝ, b ≠ 0 ∧ b ξ = 0 := by
        by_cases h0 : ξ 0 = 0
        · refine ⟨EuclideanSpace.proj (0 : Fin 3), ?_, ?_⟩
          · intro h
            have := congrArg (fun f : E3 →L[ℝ] ℝ => f (e 0)) h
            simp [hproj] at this
          · rw [hproj]; exact h0
        · refine ⟨ξ 0 • EuclideanSpace.proj (1 : Fin 3) - ξ 1 • EuclideanSpace.proj (0 : Fin 3),
            ?_, ?_⟩
          · intro h
            have := congrArg (fun f : E3 →L[ℝ] ℝ => f (e 1)) h
            simp [hproj] at this
            exact h0 this
          · simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply, hproj,
              smul_eq_mul]
            ring
      refine ⟨b, fun x => b (x - chartAt E3 p p), hb, hbξ, ?_, ?_, ?_, fun h => absurd h hβp⟩
      · exact (b.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffAt
      · have := b.hasFDerivAt.comp (chartAt E3 p p)
          ((hasFDerivAt_id (chartAt E3 p p)).sub_const (chartAt E3 p p))
        simpa [Function.comp_def] using this
      · simp
  
  obtain ⟨cf, hcf⟩ := LA a b ξ haξ' hbξ hb0
  let T₀ : E3 →L[ℝ] E3 := a.smulRight (e 0) + b.smulRight (e 1) + cf.smulRight (e 2)
  have hT₀ : ∀ v, T₀ v = a v • e 0 + b v • e 1 + cf v • e 2 := fun v => rfl
  have hinj : Function.Injective (T₀ : E3 →ₗ[ℝ] E3) := by
    refine (injective_iff_map_eq_zero (T₀ : E3 →ₗ[ℝ] E3)).mpr fun v hv => ?_
    change T₀ v = 0 at hv
    have h0 := congrArg (fun u : E3 => u 0) hv
    have h1 := congrArg (fun u : E3 => u 1) hv
    have h2 := congrArg (fun u : E3 => u 2) hv
    simp [hT₀, EuclideanSpace.single_apply] at h0 h1 h2
    exact hcf v h0 h1 h2
  let T : E3 ≃L[ℝ] E3 :=
    (LinearEquiv.ofInjectiveEndo (T₀ : E3 →ₗ[ℝ] E3) hinj).toContinuousLinearEquiv
  have hTT : (T : E3 →L[ℝ] E3) = T₀ := by
    refine ContinuousLinearMap.ext fun v => ?_
    show (LinearEquiv.ofInjectiveEndo (T₀ : E3 →ₗ[ℝ] E3) hinj) v = T₀ v
    rw [LinearEquiv.coe_ofInjectiveEndo]
    rfl
  
  let F : E3 → E3 := fun x => (w ((chartAt E3 p).symm x) - w p) • e 0 + g₂ x • e 1 +
    cf (x - chartAt E3 p p) • e 2
  have hF' : HasFDerivAt F (T : E3 →L[ℝ] E3) (chartAt E3 p p) := by
    rw [hTT]
    have h1 : HasFDerivAt (fun x => w ((chartAt E3 p).symm x) - w p) a (chartAt E3 p p) :=
      hA.sub_const (w p)
    have h3 : HasFDerivAt (fun x => cf (x - chartAt E3 p p)) cf (chartAt E3 p p) := by
      simpa [Function.comp_def] using cf.hasFDerivAt.comp (chartAt E3 p p)
        ((hasFDerivAt_id (chartAt E3 p p)).sub_const (chartAt E3 p p))
    exact ((h1.smul_const (e 0)).add (hg₂d.smul_const (e 1))).add (h3.smul_const (e 2))
  have hF : ContDiffAt ℝ ∞ F (chartAt E3 p p) := by
    have h1 : ContDiffAt ℝ ∞ (fun x => w ((chartAt E3 p).symm x) - w p) (chartAt E3 p p) :=
      hfw.sub contDiffAt_const
    have h3 : ContDiffAt ℝ ∞ (fun x => cf (x - chartAt E3 p p)) (chartAt E3 p p) :=
      (cf.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffAt
    exact ((h1.smul contDiffAt_const).add (hg₂c.smul contDiffAt_const)).add
      (h3.smul contDiffAt_const)
  have hF0 : ∀ x, F x 0 = w ((chartAt E3 p).symm x) - w p := by
    intro x; simp [F, EuclideanSpace.single_apply]
  have hF1 : ∀ x, F x 1 = g₂ x := by
    intro x; simp [F, EuclideanSpace.single_apply]
  have hFx₀ : F (chartAt E3 p p) = 0 := by
    simp [F, hcp, hg₂0]
  
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  let ψ := ContDiffAt.toOpenPartialHomeomorph F hF hF' hn
  have hψ : (ψ : E3 → E3) = F := ContDiffAt.toOpenPartialHomeomorph_coe hF hF' hn
  have hx₀ψ : chartAt E3 p p ∈ ψ.source := ContDiffAt.mem_toOpenPartialHomeomorph_source hF hF' hn
  
  let κ₀ : OpenPartialHomeomorph M E3 := (chartAt E3 p).trans ψ
  have hκ₀ : ∀ x, κ₀ x = F (chartAt E3 p x) := by
    intro x
    show ψ (chartAt E3 p x) = F (chartAt E3 p x)
    rw [hψ]
  have hκ₀src : κ₀.source = (chartAt E3 p).source ∩ chartAt E3 p ⁻¹' ψ.source :=
    OpenPartialHomeomorph.trans_source _ _
  have hpκ₀ : p ∈ κ₀.source := by rw [hκ₀src]; exact ⟨hpc, hx₀ψ⟩
  have hκ₀p : κ₀ p = 0 := by rw [hκ₀]; exact hFx₀
  
  have hW : κ₀.source ∩ interior U ∈ 𝓝 p :=
    Filter.inter_mem (κ₀.open_source.mem_nhds hpκ₀) (interior_mem_nhds.mpr hU)
  have hsymm0 : κ₀.symm 0 = p := by rw [← hκ₀p]; exact κ₀.left_inv hpκ₀
  have h0t : (0 : E3) ∈ κ₀.target := by
    have := κ₀.map_source hpκ₀
    rwa [hκ₀p] at this
  have hN : κ₀.target ∩ κ₀.symm ⁻¹' (κ₀.source ∩ interior U) ∈ 𝓝 (0 : E3) := by
    refine Filter.inter_mem (κ₀.open_target.mem_nhds h0t) ?_
    have hca := κ₀.continuousAt_symm h0t
    rw [← hsymm0] at hW
    exact hca.preimage_mem_nhds hW
  obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp hN
  have hSo : IsOpen (κ₀.source ∩ κ₀ ⁻¹' Metric.ball 0 ε) :=
    κ₀.isOpen_inter_preimage Metric.isOpen_ball
  let κ := κ₀.restrOpen _ hSo
  have hκsrc : κ.source = κ₀.source ∩ (κ₀.source ∩ κ₀ ⁻¹' Metric.ball 0 ε) :=
    OpenPartialHomeomorph.restrOpen_source _ _ _
  have hκcoe : ∀ x, κ x = κ₀ x := fun x => rfl
  have hκtgt : κ.target = κ₀.target ∩ κ₀.symm ⁻¹' (κ₀.source ∩ κ₀ ⁻¹' Metric.ball 0 ε) := by
    show (κ₀.restrOpen _ hSo).toPartialEquiv.target = _
    rw [OpenPartialHomeomorph.restrOpen_toPartialEquiv, PartialEquiv.restr_target]
    rfl
  have hxc : ∀ x ∈ κ.source, x ∈ (chartAt E3 p).source := by
    intro x hx
    rw [hκsrc] at hx
    have := hx.1
    rw [hκ₀src] at this
    exact this.1
  refine ⟨κ, ε, hε, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hκsrc]
    refine ⟨hpκ₀, hpκ₀, ?_⟩
    show κ₀ p ∈ Metric.ball (0 : E3) ε
    rw [hκ₀p]; exact Metric.mem_ball_self hε
  · intro x hx
    rw [hκsrc] at hx
    obtain ⟨hx1, -, hx2⟩ := hx
    have := (hball hx2).2
    rw [Set.mem_preimage, κ₀.left_inv hx1] at this
    exact interior_subset this.2
  · rw [hκcoe]; exact hκ₀p
  · rw [hκtgt]
    ext y
    constructor
    · rintro ⟨hy1, -, hy2⟩
      have : κ₀ (κ₀.symm y) ∈ Metric.ball (0 : E3) ε := hy2
      rwa [κ₀.right_inv hy1] at this
    · intro hy
      have hyN := hball hy
      refine ⟨hyN.1, κ₀.map_target hyN.1, ?_⟩
      show κ₀ (κ₀.symm y) ∈ Metric.ball (0 : E3) ε
      rw [κ₀.right_inv hyN.1]; exact hy
  · intro x hx
    rw [hκcoe, hκ₀, hF0, (chartAt E3 p).left_inv (hxc x hx)]
  · intro hβp x hx
    rw [hκcoe, hκ₀, hF1]
    exact hg₂β hβp x (hxc x hx)

theorem chart_level_sides (w β : M → ℝ) (p : M) (κ : OpenPartialHomeomorph M E3) (ε : ℝ)
    (hε : 0 < ε) (hp : p ∈ κ.source) (hκp : κ p = 0) (htgt : κ.target = Metric.ball 0 ε)
    (hwκ : ∀ x ∈ κ.source, w x - w p = κ x 0)
    (hcase : κ.source ⊆ {x | 0 < β x} ∨ ∀ x ∈ κ.source, β x = κ x 1) :
    IsPreconnected (κ.source ∩ ({x | 0 ≤ β x} ∩ w ⁻¹' {w p})) ∧
    IsPreconnected (κ.source ∩ {x | 0 < β x}) ∧
    IsConnected (κ.source ∩ {x | 0 < β x} ∩ {x | w p < w x}) ∧
    IsConnected (κ.source ∩ {x | 0 < β x} ∩ {x | w x < w p}) ∧
    p ∈ closure (κ.source ∩ {x | 0 < β x} ∩ {x | w p < w x}) ∧
    p ∈ closure (κ.source ∩ {x | 0 < β x} ∩ {x | w x < w p}) :=
by
  have h0T : (0 : E3) ∈ κ.target := by rw [htgt]; exact Metric.mem_ball_self hε
  have hsp : κ.symm 0 = p := by rw [← hκp]; exact κ.left_inv hp
  
  have hP : ∀ C : Set E3, Convex ℝ (κ.target ∩ C) →
      IsPreconnected (κ.source ∩ κ ⁻¹' C) ∧
      ((κ.target ∩ C).Nonempty → (κ.source ∩ κ ⁻¹' C).Nonempty) ∧
      ((0 : E3) ∈ closure (κ.target ∩ C) → p ∈ closure (κ.source ∩ κ ⁻¹' C)) := by
    intro C hC
    have hI : κ.symm '' (κ.target ∩ C) = κ.source ∩ κ ⁻¹' C :=
      κ.toPartialEquiv.symm_image_target_inter_eq' C
    have hcont : ContinuousOn κ.symm (κ.target ∩ C) :=
      κ.continuousOn_symm.mono Set.inter_subset_left
    refine ⟨hI ▸ hC.isPreconnected.image _ hcont, fun hne => hI ▸ hne.image _, fun hcl => ?_⟩
    have h := ((κ.continuousOn_symm.continuousWithinAt h0T).mono
      Set.inter_subset_left).mem_closure_image hcl
    rw [hI, hsp] at h
    exact h
  have key : ∀ (S : Set M) (C : Set E3), (∀ x ∈ κ.source, (x ∈ S ↔ κ x ∈ C)) →
      κ.source ∩ S = κ.source ∩ κ ⁻¹' C := by
    intro S C h
    ext x
    exact ⟨fun hx => ⟨hx.1, (h x hx.1).1 hx.2⟩, fun hx => ⟨hx.1, (h x hx.1).2 hx.2⟩⟩
  have hiff : ∀ x ∈ κ.source, (w p < w x ↔ 0 < κ x 0) ∧ (w x < w p ↔ κ x 0 < 0) ∧
      (w x = w p ↔ κ x 0 = 0) := by
    intro x hx
    have h1 := hwκ x hx
    refine ⟨⟨fun h => by linarith, fun h => by linarith⟩, ⟨fun h => by linarith,
      fun h => by linarith⟩, ⟨fun h => by linarith, fun h => by linarith⟩⟩
  have hlin : ∀ i : Fin 3, IsLinearMap ℝ (fun y : E3 => y i) := fun i =>
    (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).toLinearMap.isLinear
  have hT : Convex ℝ κ.target := by rw [htgt]; exact convex_ball 0 ε
  
  have hnorm : ∀ a b : ℝ, ‖(!₂[a, b, 0] : E3)‖ ^ 2 = a ^ 2 + b ^ 2 := by
    intro a b
    rw [EuclideanSpace.norm_sq_eq]
    simp [Fin.sum_univ_three]
  have hQ : (0 : E3) ∈ closure (κ.target ∩ ({y : E3 | 0 < y 1} ∩ {y : E3 | 0 < y 0})) ∧
      (0 : E3) ∈ closure (κ.target ∩ ({y : E3 | 0 < y 1} ∩ {y : E3 | y 0 < 0})) := by
    rw [htgt]
    constructor
    · rw [Metric.mem_closure_iff]
      intro r hr
      have hm : 0 < min ε r := lt_min hε hr
      set c := min ε r / 4 with hc
      have hc0 : 0 < c := by positivity
      have hn := hnorm c c
      have hlt : ‖(!₂[c, c, 0] : E3)‖ < min ε r := by
        nlinarith [norm_nonneg (!₂[c, c, 0] : E3)]
      refine ⟨!₂[c, c, 0], ⟨?_, ?_, ?_⟩, ?_⟩
      · rw [mem_ball_zero_iff]; exact lt_of_lt_of_le hlt (min_le_left _ _)
      · simp [hc0]
      · simp [hc0]
      · rw [dist_zero_left]; exact lt_of_lt_of_le hlt (min_le_right _ _)
    · rw [Metric.mem_closure_iff]
      intro r hr
      have hm : 0 < min ε r := lt_min hε hr
      set c := min ε r / 4 with hc
      have hc0 : 0 < c := by positivity
      have hn := hnorm (-c) c
      have hlt : ‖(!₂[-c, c, 0] : E3)‖ < min ε r := by
        nlinarith [norm_nonneg (!₂[-c, c, 0] : E3)]
      refine ⟨!₂[-c, c, 0], ⟨?_, ?_, ?_⟩, ?_⟩
      · rw [mem_ball_zero_iff]; exact lt_of_lt_of_le hlt (min_le_left _ _)
      · simp [hc0]
      · simp [hc0]
      · rw [dist_zero_left]; exact lt_of_lt_of_le hlt (min_le_right _ _)
  rcases hcase with hA | hB
  · have e1 : κ.source ∩ ({x | 0 ≤ β x} ∩ w ⁻¹' {w p}) =
        κ.source ∩ κ ⁻¹' {y : E3 | y 0 = 0} := by
      apply key
      intro x hx
      have hb : 0 < β x := hA hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_singleton_iff,
        (hiff x hx).2.2, hb.le, true_and]
    have e2 : κ.source ∩ {x | 0 < β x} = κ.source ∩ κ ⁻¹' Set.univ := by
      apply key
      intro x hx
      have hb : 0 < β x := hA hx
      simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_univ, hb]
    have e3 : κ.source ∩ {x | 0 < β x} ∩ {x | w p < w x} =
        κ.source ∩ κ ⁻¹' {y : E3 | 0 < y 0} := by
      rw [Set.inter_assoc]
      apply key
      intro x hx
      have hb : 0 < β x := hA hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage,
        (hiff x hx).1, hb, true_and]
    have e4 : κ.source ∩ {x | 0 < β x} ∩ {x | w x < w p} =
        κ.source ∩ κ ⁻¹' {y : E3 | y 0 < 0} := by
      rw [Set.inter_assoc]
      apply key
      intro x hx
      have hb : 0 < β x := hA hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage,
        (hiff x hx).2.1, hb, true_and]
    have P1 := hP _ (hT.inter (convex_hyperplane (hlin 0) 0))
    have P2 := hP Set.univ (by rw [Set.inter_univ]; exact hT)
    have P3 := hP _ (hT.inter (convex_halfSpace_gt (hlin 0) 0))
    have P4 := hP _ (hT.inter (convex_halfSpace_lt (hlin 0) 0))
    have cl3 : (0 : E3) ∈ closure (κ.target ∩ {y : E3 | 0 < y 0}) :=
      closure_mono (Set.inter_subset_inter_right _ (fun y hy => hy.2)) hQ.1
    have cl4 : (0 : E3) ∈ closure (κ.target ∩ {y : E3 | y 0 < 0}) :=
      closure_mono (Set.inter_subset_inter_right _ (fun y hy => hy.2)) hQ.2
    rw [e1, e3, e4, e2]
    exact ⟨P1.1, P2.1, ⟨P3.2.1 (closure_nonempty_iff.mp ⟨0, cl3⟩), P3.1⟩,
      ⟨P4.2.1 (closure_nonempty_iff.mp ⟨0, cl4⟩), P4.1⟩, P3.2.2 cl3, P4.2.2 cl4⟩
  · have e1 : κ.source ∩ ({x | 0 ≤ β x} ∩ w ⁻¹' {w p}) =
        κ.source ∩ κ ⁻¹' ({y : E3 | 0 ≤ y 1} ∩ {y : E3 | y 0 = 0}) := by
      apply key
      intro x hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_singleton_iff,
        (hiff x hx).2.2, hB x hx]
    have e2 : κ.source ∩ {x | 0 < β x} = κ.source ∩ κ ⁻¹' {y : E3 | 0 < y 1} := by
      apply key
      intro x hx
      simp only [Set.mem_setOf_eq, Set.mem_preimage, hB x hx]
    have e3 : κ.source ∩ {x | 0 < β x} ∩ {x | w p < w x} =
        κ.source ∩ κ ⁻¹' ({y : E3 | 0 < y 1} ∩ {y : E3 | 0 < y 0}) := by
      rw [Set.inter_assoc]
      apply key
      intro x hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage,
        (hiff x hx).1, hB x hx]
    have e4 : κ.source ∩ {x | 0 < β x} ∩ {x | w x < w p} =
        κ.source ∩ κ ⁻¹' ({y : E3 | 0 < y 1} ∩ {y : E3 | y 0 < 0}) := by
      rw [Set.inter_assoc]
      apply key
      intro x hx
      simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Set.mem_preimage,
        (hiff x hx).2.1, hB x hx]
    have P1 := hP _ (hT.inter ((convex_halfSpace_ge (hlin 1) 0).inter
      (convex_hyperplane (hlin 0) 0)))
    have P2 := hP _ (hT.inter (convex_halfSpace_gt (hlin 1) 0))
    have P3 := hP _ (hT.inter ((convex_halfSpace_gt (hlin 1) 0).inter
      (convex_halfSpace_gt (hlin 0) 0)))
    have P4 := hP _ (hT.inter ((convex_halfSpace_gt (hlin 1) 0).inter
      (convex_halfSpace_lt (hlin 0) 0)))
    rw [e1, e3, e4, e2]
    exact ⟨P1.1, P2.1, ⟨P3.2.1 (closure_nonempty_iff.mp ⟨0, hQ.1⟩), P3.1⟩,
      ⟨P4.2.1 (closure_nonempty_iff.mp ⟨0, hQ.2⟩), P4.1⟩, P3.2.2 hQ.1, P4.2.2 hQ.2⟩

theorem collar_nbhd {X : Type*} [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X]
    (S E : Set X) (w : X → ℝ) (t : ℝ) (hw : Continuous w) (hE : IsClosed E)
    (hS : IsCompact S) (hSL : S ⊆ E ∩ w ⁻¹' {t})
    (hloc : ∀ p ∈ S, ∃ V ∈ 𝓝 p, V ∩ (E ∩ w ⁻¹' {t}) ⊆ S) :
    ∃ O : Set X, IsOpen O ∧ S ⊆ O ∧ IsCompact (closure O) ∧
      closure O ∩ (E ∩ w ⁻¹' {t}) ⊆ S ∧
      ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ frontier O, x ∈ E → δ < |w x - t| :=
by
  set L : Set X := E ∩ w ⁻¹' {t} with hLdef
  have hSU : S ⊆ interior (S ∪ Lᶜ) := by
    intro p hp
    obtain ⟨V, hV, hVL⟩ := hloc p hp
    refine mem_interior_iff_mem_nhds.mpr (Filter.mem_of_superset hV ?_)
    intro x hx
    by_cases hxL : x ∈ L
    · exact Or.inl (hVL ⟨hx, hxL⟩)
    · exact Or.inr hxL
  have hUL : ∀ x ∈ interior (S ∪ Lᶜ), x ∈ L → x ∈ S := by
    intro x hx hxL
    rcases interior_subset hx with h | h
    · exact h
    · exact absurd hxL h
  obtain ⟨O, hOo, hSO, hOU, hOc⟩ :=
    exists_open_between_and_isCompact_closure hS isOpen_interior hSU
  have hcl : closure O ∩ L ⊆ S := fun x hx => hUL x (hOU hx.1) hx.2
  have hK : IsCompact (frontier O ∩ E) :=
    (hOc.of_isClosed_subset isClosed_frontier frontier_subset_closure).inter_right hE
  have hpos : ∀ b ∈ frontier O ∩ E, (0 : ℝ) < |w b - t| := by
    intro b hb
    refine abs_pos.mpr (sub_ne_zero.mpr ?_)
    intro hwb
    have hbS : b ∈ S := hcl ⟨frontier_subset_closure hb.1, hb.2, hwb⟩
    have hfr := hb.1
    rw [hOo.frontier_eq] at hfr
    exact hfr.2 (hSO hbS)
  obtain ⟨a', ha', hbound⟩ :=
    hK.exists_forall_le' ((hw.sub continuous_const).abs.continuousOn) hpos
  refine ⟨O, hOo, hSO, hOc, hcl, a' / 2, half_pos ha', ?_⟩
  intro x hx hxE
  exact lt_of_lt_of_le (half_lt_self ha') (hbound x ⟨hx, hxE⟩)

theorem circle_jump_functions {X : Type*} [TopologicalSpace X]
    (Ω S O : Set X) (w : X → ℝ) (t δ : ℝ)
    (hw : Continuous w) (hO : IsOpen O) (hδ : 0 < δ)
    (hS : ∀ x ∈ O ∩ Ω, w x = t → x ∈ S)
    (hfr : ∀ x ∈ frontier O, x ∈ Ω → δ < |w x - t|)
    (hlift : ∀ θ : C(Ω, Circle), ∃ φ : C(Ω, ℝ), ∀ x : Ω, θ x = Circle.exp (φ x)) :
    ∃ f g : X → ℤ, ContinuousOn f (Ω \ S) ∧ ContinuousOn g (O ∩ Ω) ∧
      (∀ x ∈ O ∩ Ω, w x < t → f x = g x) ∧ (∀ x ∈ O ∩ Ω, t < w x → f x = g x + 1) :=
by
  classical
  
  have glue : ∀ {Y : Type} [TopologicalSpace Y] (s : Set X) (F : X → Y) (c : Y),
      (∀ x ∈ s, x ∈ O → ContinuousAt F x) →
      (∀ x ∈ s, x ∈ frontier O → ∀ᶠ y in 𝓝 x, y ∈ O → F y = c) →
      ContinuousOn (fun x => if x ∈ O then F x else c) s := by
    intro Y _ s F c hin hfr' x hx
    apply ContinuousAt.continuousWithinAt
    by_cases hxO : x ∈ O
    · refine (hin x hx hxO).congr ?_
      filter_upwards [hO.mem_nhds hxO] with y hy
      simp [hy]
    · by_cases hxc : x ∈ closure O
      · have hxf : x ∈ frontier O := by rw [hO.frontier_eq]; exact ⟨hxc, hxO⟩
        refine (continuousAt_const : ContinuousAt (fun _ : X => c) x).congr ?_
        filter_upwards [hfr' x hx hxf] with y hy
        by_cases hyO : y ∈ O
        · simp [hyO, hy hyO]
        · simp [hyO]
      · refine (continuousAt_const : ContinuousAt (fun _ : X => c) x).congr ?_
        filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hxc] with y hy
        have hyO : y ∉ O := fun h => hy (subset_closure h)
        simp [hyO]
  
  have rnd : ∀ (h : X → ℝ) (s : Set X), ContinuousOn h s → (∀ x ∈ s, ∃ n : ℤ, h x = n) →
      ContinuousOn (fun x => round (h x)) s := by
    intro h s hh hint x hx
    obtain ⟨n, hn⟩ := hint x hx
    have h1 : ∀ᶠ y in 𝓝[s] x, |h y - h x| < 1 / 2 := by
      have := Metric.tendsto_nhds.mp (hh x hx) (1 / 2) (by norm_num)
      filter_upwards [this] with y hy
      rwa [Real.dist_eq] at hy
    have h2 : ∀ᶠ y in 𝓝[s] x, round (h y) = round (h x) := by
      filter_upwards [h1, self_mem_nhdsWithin] with y hy hys
      obtain ⟨m, hm⟩ := hint y hys
      rw [hm, hn] at hy ⊢
      have hmn : m = n := by
        have h3 : |((m - n : ℤ) : ℝ)| < 1 := by push_cast; linarith
        have h4 : |m - n| < 1 := by exact_mod_cast h3
        have := Int.abs_lt_one_iff.mp h4
        omega
      rw [hmn]
    exact (continuousWithinAt_const).congr_of_eventuallyEq h2 rfl
  have hτpos : 0 < 2 * Real.pi := by positivity
  have hτne : 2 * Real.pi ≠ 0 := hτpos.ne'
  
  let lam : ℝ → ℝ := fun s => max 0 (min 1 ((s + δ) / (2 * δ)))
  let ℓ : X → ℝ := fun x => lam (w x - t)
  have hℓc : Continuous ℓ := by
    show Continuous fun x => max 0 (min 1 ((w x - t + δ) / (2 * δ)))
    exact continuous_const.max (continuous_const.min
      (((hw.sub continuous_const).add continuous_const).div_const _))
  have hΛ1 : ∀ s, s < -δ → lam s = 0 := by
    intro s hs
    have h : (s + δ) / (2 * δ) < 0 := div_neg_of_neg_of_pos (by linarith) (by linarith)
    show max 0 (min 1 ((s + δ) / (2 * δ))) = 0
    rw [min_eq_right (by linarith), max_eq_left h.le]
  have hΛ2 : ∀ s, δ < s → lam s = 1 := by
    intro s hs
    have h : 1 < (s + δ) / (2 * δ) := by rw [one_lt_div (by linarith)]; linarith
    show max 0 (min 1 ((s + δ) / (2 * δ))) = 1
    rw [min_eq_left h.le, max_eq_right zero_le_one]
  have FR : ∀ x ∈ frontier O, x ∈ Ω → ∀ᶠ y in 𝓝 x,
      (ℓ y = 1 ∧ t < w y) ∨ (ℓ y = 0 ∧ w y < t) := by
    intro x hx hxΩ
    have hN : IsOpen {y | δ < |w y - t|} :=
      isOpen_lt continuous_const ((hw.sub continuous_const).abs)
    filter_upwards [hN.mem_nhds (hfr x hx hxΩ)] with y hy
    rcases lt_abs.mp hy with h | h
    · left; exact ⟨hΛ2 _ h, by linarith⟩
    · right; exact ⟨hΛ1 _ (by linarith), by linarith⟩
  
  let F : X → Circle := fun x => Circle.exp (2 * Real.pi * ℓ x)
  let θ : X → Circle := fun x => if x ∈ O then F x else 1
  have hθc : ContinuousOn θ Ω := by
    apply glue Ω F 1
    · intro x _ _
      exact (Circle.exp.continuous.comp (continuous_const.mul hℓc)).continuousAt
    · intro x hxΩ hxf
      filter_upwards [FR x hxf hxΩ] with y hy _
      rcases hy with ⟨h1, _⟩ | ⟨h1, _⟩
      · show Circle.exp (2 * Real.pi * ℓ y) = 1
        rw [h1, mul_one, Circle.exp_two_pi]
      · show Circle.exp (2 * Real.pi * ℓ y) = 1
        rw [h1, mul_zero, Circle.exp_zero]
  
  obtain ⟨φ, hφ⟩ := hlift ⟨Ω.restrict θ, hθc.restrict⟩
  let φh : X → ℝ := fun x => if h : x ∈ Ω then φ ⟨x, h⟩ else 0
  have hφc : ContinuousOn φh Ω := by
    rw [continuousOn_iff_continuous_restrict]
    have hr : Ω.restrict φh = ⇑φ := by
      funext ⟨x, hx⟩
      show (if h : x ∈ Ω then φ ⟨x, h⟩ else 0) = φ ⟨x, hx⟩
      rw [dif_pos hx]
    rw [hr]; exact φ.continuous
  have hφeq : ∀ x ∈ Ω, Circle.exp (φh x) = θ x := by
    intro x hx
    have h := hφ ⟨x, hx⟩
    show Circle.exp (if h : x ∈ Ω then φ ⟨x, h⟩ else 0) = θ x
    rw [dif_pos hx]
    exact h.symm
  
  let Fψ : X → ℝ := fun x => if w x < t then ℓ x else ℓ x - 1
  let ψ : X → ℝ := fun x => if x ∈ O then Fψ x else 0
  have hψc : ContinuousOn ψ (Ω \ S) := by
    apply glue (Ω \ S) Fψ 0
    · intro x hx hxO
      have hne : w x ≠ t := fun h => hx.2 (hS x ⟨hxO, hx.1⟩ h)
      rcases lt_or_gt_of_ne hne with h | h
      · refine hℓc.continuousAt.congr ?_
        filter_upwards [(isOpen_lt hw continuous_const).mem_nhds h] with y hy
        show ℓ y = (if w y < t then ℓ y else ℓ y - 1)
        rw [if_pos (show w y < t from hy)]
      · refine (hℓc.sub (continuous_const : Continuous fun _ : X => (1 : ℝ))).continuousAt.congr ?_
        filter_upwards [(isOpen_lt continuous_const hw).mem_nhds h] with y hy
        show ℓ y - 1 = (if w y < t then ℓ y else ℓ y - 1)
        rw [if_neg (not_lt.mpr (le_of_lt (show t < w y from hy)))]
    · intro x hx hxf
      filter_upwards [FR x hxf hx.1] with y hy _
      rcases hy with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · show (if w y < t then ℓ y else ℓ y - 1) = 0
        rw [if_neg (not_lt.mpr h2.le), h1]; norm_num
      · show (if w y < t then ℓ y else ℓ y - 1) = 0
        rw [if_pos h2, h1]
  
  have hθψ : ∀ x, θ x = Circle.exp (2 * Real.pi * ψ x) := by
    intro x
    show (if x ∈ O then F x else 1) = Circle.exp (2 * Real.pi * (if x ∈ O then Fψ x else 0))
    by_cases hxO : x ∈ O
    · rw [if_pos hxO, if_pos hxO]
      show Circle.exp (2 * Real.pi * ℓ x) =
        Circle.exp (2 * Real.pi * (if w x < t then ℓ x else ℓ x - 1))
      by_cases hwt : w x < t
      · rw [if_pos hwt]
      · rw [if_neg hwt, mul_sub, mul_one, Circle.exp_sub, Circle.exp_two_pi, div_one]
    · rw [if_neg hxO, if_neg hxO, mul_zero, Circle.exp_zero]
  
  have key : ∀ x ∈ Ω, ∀ b : ℝ, θ x = Circle.exp (2 * Real.pi * b) →
      ∃ m : ℤ, (φh x - 2 * Real.pi * b) / (2 * Real.pi) = m := by
    intro x hx b hb
    have h1 : Circle.exp (φh x) = Circle.exp (2 * Real.pi * b) := (hφeq x hx).trans hb
    obtain ⟨m, hm⟩ := Circle.exp_eq_exp.mp h1
    refine ⟨m, ?_⟩
    rw [hm, add_sub_cancel_left, mul_div_cancel_right₀ _ hτne]
  refine ⟨fun x => round ((φh x - 2 * Real.pi * ψ x) / (2 * Real.pi)),
    fun x => round ((φh x - 2 * Real.pi * ℓ x) / (2 * Real.pi)), ?_, ?_, ?_, ?_⟩
  · refine rnd (fun x => (φh x - 2 * Real.pi * ψ x) / (2 * Real.pi)) (Ω \ S) ?_ ?_
    · exact ((hφc.mono Set.diff_subset).sub (continuousOn_const.mul hψc)).div_const _
    · intro x hx
      exact key x hx.1 _ (hθψ x)
  · refine rnd (fun x => (φh x - 2 * Real.pi * ℓ x) / (2 * Real.pi)) (O ∩ Ω) ?_ ?_
    · exact ((hφc.mono Set.inter_subset_right).sub
        ((continuous_const.mul hℓc).continuousOn)).div_const _
    · intro x hx
      refine key x hx.2 _ ?_
      show (if x ∈ O then F x else 1) = Circle.exp (2 * Real.pi * ℓ x)
      rw [if_pos hx.1]
  · intro x hx hwt
    have hψx : ψ x = ℓ x := by
      show (if x ∈ O then Fψ x else 0) = ℓ x
      rw [if_pos hx.1]
      show (if w x < t then ℓ x else ℓ x - 1) = ℓ x
      rw [if_pos hwt]
    show round ((φh x - 2 * Real.pi * ψ x) / (2 * Real.pi)) =
      round ((φh x - 2 * Real.pi * ℓ x) / (2 * Real.pi))
    rw [hψx]
  · intro x hx hwt
    have hψx : ψ x = ℓ x - 1 := by
      show (if x ∈ O then Fψ x else 0) = ℓ x - 1
      rw [if_pos hx.1]
      show (if w x < t then ℓ x else ℓ x - 1) = ℓ x - 1
      rw [if_neg (not_lt.mpr hwt.le)]
    show round ((φh x - 2 * Real.pi * ψ x) / (2 * Real.pi)) =
      round ((φh x - 2 * Real.pi * ℓ x) / (2 * Real.pi)) + 1
    rw [hψx, ← round_add_one]
    congr 1
    rw [div_add_one hτne]
    ring

theorem two_sides_of_jump {X : Type*} [TopologicalSpace X] [LocallyConnectedSpace X]
    (Ω S O : Set X) (w : X → ℝ) (t : ℝ) (f g : X → ℤ)
    (hΩo : IsOpen Ω) (hΩc : IsConnected Ω) (hSc : IsClosed S) (hSconn : IsPreconnected S)
    (p₀ : X) (hp₀ : p₀ ∈ S) (hSt : ∀ x ∈ S, w x = t)
    (hf : ContinuousOn f (Ω \ S)) (hg : ContinuousOn g (O ∩ Ω))
    (hfg₁ : ∀ x ∈ O ∩ Ω, w x < t → f x = g x)
    (hfg₂ : ∀ x ∈ O ∩ Ω, t < w x → f x = g x + 1)
    (hloc : ∀ p ∈ S, ∃ V : Set X, IsOpen V ∧ p ∈ V ∧ V ⊆ O ∧
      IsPreconnected (V ∩ Ω) ∧
      IsConnected (V ∩ Ω ∩ {x | t < w x}) ∧ IsConnected (V ∩ Ω ∩ {x | w x < t}) ∧
      p ∈ closure (V ∩ Ω ∩ {x | t < w x}) ∧ p ∈ closure (V ∩ Ω ∩ {x | w x < t}) ∧
      (∀ x ∈ V ∩ Ω, w x = t → x ∈ S)) :
    ∃ A B : Set X, IsOpen A ∧ IsOpen B ∧ Disjoint A B ∧ A ∪ B = Ω \ S ∧
      IsConnected A ∧ IsConnected B ∧ S ⊆ closure A ∧ S ⊆ closure B :=
by
  classical
  choose! V hVo hpV hVO hVΩ hVp hVm hclp hclm hVS using hloc
  have hD : IsOpen (Ω \ S) := hΩo.sdiff hSc
  have hCo : ∀ z, IsOpen (connectedComponentIn (Ω \ S) z) := fun z => hD.connectedComponentIn
  
  have chain : ∀ (P : Set X) (a : X),
      (∀ p ∈ S, IsPreconnected (V p ∩ P) ∧ V p ∩ P ⊆ Ω \ S ∧ p ∈ closure (V p ∩ P)) →
      (V p₀ ∩ P ∩ connectedComponentIn (Ω \ S) a).Nonempty →
      ∀ p ∈ S, V p ∩ P ⊆ connectedComponentIn (Ω \ S) a := by
    intro P a hP hstart
    have absorb : ∀ q ∈ S, (V q ∩ P ∩ connectedComponentIn (Ω \ S) a).Nonempty →
        V q ∩ P ⊆ connectedComponentIn (Ω \ S) a := by
      rintro q hq ⟨z, hzW, hzC⟩
      have h1 := (hP q hq).1.subset_connectedComponentIn hzW (hP q hq).2.1
      rwa [← connectedComponentIn_eq hzC] at h1
    have overlap : ∀ p ∈ S, ∀ q ∈ S, q ∈ V p → (V p ∩ P ∩ (V q ∩ P)).Nonempty := by
      intro p hp q hq hqV
      obtain ⟨z, hzV, hzW⟩ := mem_closure_iff.mp (hP q hq).2.2 (V p) (hVo p hp) hqV
      exact ⟨z, ⟨hzV, hzW.2⟩, hzW⟩
    have prop : ∀ q ∈ S, ∀ p₁ ∈ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a},
        ∀ p₂ ∈ S, q ∈ V p₁ → q ∈ V p₂ →
        p₂ ∈ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a} := by
      intro q hq p₁ hp₁ p₂ hp₂ h1 h2
      obtain ⟨z, hz1, hzq⟩ := overlap p₁ hp₁.1 q hq h1
      have hWq := absorb q hq ⟨z, hzq, hp₁.2 hz1⟩
      obtain ⟨z', hz2, hzq'⟩ := overlap p₂ hp₂ q hq h2
      exact ⟨hp₂, absorb p₂ hp₂ ⟨z', hz2, hWq hzq'⟩⟩
    have hp₀T : p₀ ∈ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a} :=
      ⟨hp₀, absorb p₀ hp₀ hstart⟩
    have key := isPreconnected_iff_subset_of_disjoint.mp hSconn
      (⋃ p ∈ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a}, V p)
      (⋃ p ∈ S \ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a}, V p)
      (isOpen_biUnion fun p hp => hVo p hp.1) (isOpen_biUnion fun p hp => hVo p hp.1)
      (fun p hp => by
        by_cases hpT : p ∈ {p | p ∈ S ∧ V p ∩ P ⊆ connectedComponentIn (Ω \ S) a}
        · exact Or.inl (Set.mem_biUnion hpT (hpV p hp))
        · exact Or.inr (Set.mem_biUnion ⟨hp, hpT⟩ (hpV p hp)))
      (by
        ext q
        refine ⟨fun ⟨hq, h1, h2⟩ => ?_, fun h => h.elim⟩
        obtain ⟨p₁, hp₁, hq1⟩ := Set.mem_iUnion₂.mp h1
        obtain ⟨p₂, hp₂, hq2⟩ := Set.mem_iUnion₂.mp h2
        exact absurd (prop q hq p₁ hp₁ p₂ hp₂.1 hq1 hq2) hp₂.2)
    intro p hp
    rcases key with hS1 | hS2
    · obtain ⟨p₁, hp₁, hq1⟩ := Set.mem_iUnion₂.mp (hS1 hp)
      exact (prop p hp p₁ hp₁ p hp hq1 (hpV p hp)).2
    · exfalso
      obtain ⟨p₂, hp₂, hq2⟩ := Set.mem_iUnion₂.mp (hS2 hp₀)
      exact hp₂.2 (prop p₀ hp₀ p₀ hp₀T p₂ hp₂.1 (hpV p₀ hp₀) hq2)
  
  have fills : ∀ x ∈ Ω \ S, Disjoint (closure (connectedComponentIn (Ω \ S) x)) S →
      Ω ⊆ connectedComponentIn (Ω \ S) x := by
    intro x hx hdisj
    have hcl : ∀ y ∈ Ω, y ∈ closure (connectedComponentIn (Ω \ S) x) →
        y ∈ connectedComponentIn (Ω \ S) x := by
      intro y hyΩ hycl
      have hyS : y ∉ S := fun hyS => Set.disjoint_left.mp hdisj hycl hyS
      have hyD : y ∈ Ω \ S := ⟨hyΩ, hyS⟩
      obtain ⟨z, hzy, hzx⟩ := mem_closure_iff.mp hycl _ (hCo y) (mem_connectedComponentIn hyD)
      rw [connectedComponentIn_eq hzx, ← connectedComponentIn_eq hzy]
      exact mem_connectedComponentIn hyD
    refine hΩc.isPreconnected.subset_left_of_subset_union (hCo x) isClosed_closure.isOpen_compl
      (Set.disjoint_compl_right_iff_subset.mpr subset_closure) ?_
      ⟨x, hx.1, mem_connectedComponentIn hx⟩
    intro y hy
    by_cases h : y ∈ closure (connectedComponentIn (Ω \ S) x)
    · exact Or.inl (hcl y hy h)
    · exact Or.inr h
  
  have hsubp : ∀ p, V p ∩ (Ω ∩ {x | t < w x}) ⊆ Ω \ S := by
    rintro p x ⟨-, hxΩ, hxw⟩
    exact ⟨hxΩ, fun hxS => (show t < w x from hxw).ne' (hSt x hxS)⟩
  have hsubm : ∀ p, V p ∩ (Ω ∩ {x | w x < t}) ⊆ Ω \ S := by
    rintro p x ⟨-, hxΩ, hxw⟩
    exact ⟨hxΩ, fun hxS => (show w x < t from hxw).ne (hSt x hxS)⟩
  
  obtain ⟨a₀, ha₀⟩ := (hVp p₀ hp₀).nonempty
  obtain ⟨b₀, hb₀⟩ := (hVm p₀ hp₀).nonempty
  have ha₀D : a₀ ∈ Ω \ S := hsubp p₀ ⟨ha₀.1.1, ha₀.1.2, ha₀.2⟩
  have hb₀D : b₀ ∈ Ω \ S := hsubm p₀ ⟨hb₀.1.1, hb₀.1.2, hb₀.2⟩
  have ha₀A : a₀ ∈ connectedComponentIn (Ω \ S) a₀ := mem_connectedComponentIn ha₀D
  have hb₀B : b₀ ∈ connectedComponentIn (Ω \ S) b₀ := mem_connectedComponentIn hb₀D
  
  have hAB : Disjoint (connectedComponentIn (Ω \ S) a₀) (connectedComponentIn (Ω \ S) b₀) := by
    rw [Set.disjoint_left]
    intro z hzA hzB
    have hAeq : connectedComponentIn (Ω \ S) a₀ = connectedComponentIn (Ω \ S) b₀ :=
      (connectedComponentIn_eq hzA).trans (connectedComponentIn_eq hzB).symm
    have hb₀A : b₀ ∈ connectedComponentIn (Ω \ S) a₀ := hAeq ▸ hb₀B
    have hf1 : f a₀ = f b₀ := isPreconnected_connectedComponentIn.constant
      (hf.mono (connectedComponentIn_subset _ _)) ha₀A hb₀A
    have hg1 : g a₀ = g b₀ := (hVΩ p₀ hp₀).constant
      (hg.mono (Set.inter_subset_inter_left _ (hVO p₀ hp₀))) ⟨ha₀.1.1, ha₀.1.2⟩
      ⟨hb₀.1.1, hb₀.1.2⟩
    have h1 := hfg₂ a₀ ⟨hVO p₀ hp₀ ha₀.1.1, ha₀.1.2⟩ ha₀.2
    have h2 := hfg₁ b₀ ⟨hVO p₀ hp₀ hb₀.1.1, hb₀.1.2⟩ hb₀.2
    omega
  
  have hAp : ∀ p ∈ S, V p ∩ (Ω ∩ {x | t < w x}) ⊆ connectedComponentIn (Ω \ S) a₀ :=
    chain (Ω ∩ {x | t < w x}) a₀
      (fun p hp => ⟨by rw [← Set.inter_assoc]; exact (hVp p hp).isPreconnected, hsubp p,
        by rw [← Set.inter_assoc]; exact hclp p hp⟩)
      ⟨a₀, ⟨ha₀.1.1, ha₀.1.2, ha₀.2⟩, ha₀A⟩
  have hBm : ∀ p ∈ S, V p ∩ (Ω ∩ {x | w x < t}) ⊆ connectedComponentIn (Ω \ S) b₀ :=
    chain (Ω ∩ {x | w x < t}) b₀
      (fun p hp => ⟨by rw [← Set.inter_assoc]; exact (hVm p hp).isPreconnected, hsubm p,
        by rw [← Set.inter_assoc]; exact hclm p hp⟩)
      ⟨b₀, ⟨hb₀.1.1, hb₀.1.2, hb₀.2⟩, hb₀B⟩
  
  have hcov : connectedComponentIn (Ω \ S) a₀ ∪ connectedComponentIn (Ω \ S) b₀ = Ω \ S := by
    apply Set.Subset.antisymm
    · exact Set.union_subset (connectedComponentIn_subset _ _) (connectedComponentIn_subset _ _)
    · intro x hx
      have hxC := mem_connectedComponentIn hx
      by_cases h : Disjoint (closure (connectedComponentIn (Ω \ S) x)) S
      · exfalso
        have hΩC := fills x hx h
        have e1 := connectedComponentIn_eq (hΩC ha₀D.1)
        have e2 := connectedComponentIn_eq (hΩC hb₀D.1)
        have : a₀ ∈ connectedComponentIn (Ω \ S) b₀ := by
          rw [← e2, e1]; exact ha₀A
        exact Set.disjoint_left.mp hAB ha₀A this
      · obtain ⟨p, hpcl, hpS⟩ := Set.not_disjoint_iff.mp h
        obtain ⟨z, hzV, hzC⟩ := mem_closure_iff.mp hpcl (V p) (hVo p hpS) (hpV p hpS)
        have hzD : z ∈ Ω \ S := connectedComponentIn_subset _ _ hzC
        have hwz : w z ≠ t := fun hw => hzD.2 (hVS p hpS z ⟨hzV, hzD.1⟩ hw)
        have e0 := connectedComponentIn_eq hzC
        rcases lt_or_gt_of_ne hwz with hlt | hgt
        · right
          have hzB := hBm p hpS ⟨hzV, hzD.1, hlt⟩
          have e1 := connectedComponentIn_eq hzB
          rw [e1, ← e0]; exact hxC
        · left
          have hzA := hAp p hpS ⟨hzV, hzD.1, hgt⟩
          have e1 := connectedComponentIn_eq hzA
          rw [e1, ← e0]; exact hxC
  refine ⟨connectedComponentIn (Ω \ S) a₀, connectedComponentIn (Ω \ S) b₀, hCo a₀, hCo b₀, hAB,
    hcov, isConnected_connectedComponentIn_iff.mpr ha₀D,
    isConnected_connectedComponentIn_iff.mpr hb₀D, ?_, ?_⟩
  · intro p hp
    exact closure_mono (hAp p hp) (by rw [← Set.inter_assoc]; exact hclp p hp)
  · intro p hp
    exact closure_mono (hBm p hp) (by rw [← Set.inter_assoc]; exact hclm p hp)

theorem separates_of_circle_liftable [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (Φ : EndChart M) (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain Φ β Re)
    (hconn : IsConnected {p : M | 0 < β p}) (hlift : CircleLiftable {p : M | 0 < β p})
    (hesc : ∀ p : M, ∃ ρ : ℝ, ∃ V ∈ 𝓝 p, ∀ y : E3, ρ < ‖y‖ → Φ.Φ y ∉ V) :
    SeparatesLevelComponents β :=
by
  obtain ⟨hβs, hreg, hRe, hfar, hcpt⟩ := hβ
  haveI : LocallyCompactSpace M := ChartedSpace.locallyCompactSpace E3 M
  haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
  intro w t p₀ hw hp₀ hScpt hT
  
  have hβc : Continuous β := hβs.continuous
  have hwc : Continuous w := hw.continuous
  have hΩo : IsOpen {p : M | 0 < β p} := isOpen_lt continuous_const hβc
  have hEc : IsClosed {p : M | 0 ≤ β p} := isClosed_le continuous_const hβc
  have hSL : connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ ⊆
      {p : M | 0 ≤ β p} ∩ w ⁻¹' {t} := connectedComponentIn_subset _ _
  have hp₀S : p₀ ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ :=
    mem_connectedComponentIn hp₀
  have hSpc : IsPreconnected (connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) :=
    isPreconnected_connectedComponentIn
  have hScl : IsClosed (connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) :=
    hScpt.isClosed
  have hΩE : {p : M | 0 < β p} ⊆ {p : M | 0 ≤ β p} := fun x (hx : 0 < β x) =>
    (le_of_lt hx : 0 ≤ β x)
  have hSw : ∀ x ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀, w x = t :=
    fun x hx => (hSL hx).2
  have hSE : ∀ x ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀, 0 ≤ β x :=
    fun x hx => (hSL hx).1
  
  have GOOD : ∀ p ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀, ∀ U ∈ 𝓝 p,
      ∃ V : Set M, IsOpen V ∧ p ∈ V ∧ V ⊆ U ∧
      IsPreconnected (V ∩ ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t})) ∧
      IsPreconnected (V ∩ {p : M | 0 < β p}) ∧
      IsConnected (V ∩ {p : M | 0 < β p} ∩ {x | t < w x}) ∧
      IsConnected (V ∩ {p : M | 0 < β p} ∩ {x | w x < t}) ∧
      p ∈ closure (V ∩ {p : M | 0 < β p} ∩ {x | t < w x}) ∧
      p ∈ closure (V ∩ {p : M | 0 < β p} ∩ {x | w x < t}) := by
    intro p hp U hU
    have hwp : w p = t := hSw p hp
    rcases (hSE p hp).lt_or_eq with hβp | hβp
    · have hU' : U ∩ {p : M | 0 < β p} ∈ 𝓝 p := Filter.inter_mem hU (hΩo.mem_nhds hβp)
      obtain ⟨κ, ε, hε, hpκ, hsrc, hκp, htgt, hwκ, -⟩ :=
        level_chart w β hw hβs p (hT p hp) (hreg p) (U ∩ {p : M | 0 < β p}) hU'
      obtain ⟨h1, h2, h3, h4, h5, h6⟩ := chart_level_sides w β p κ ε hε hpκ hκp htgt hwκ
        (Or.inl (fun x hx => (hsrc hx).2))
      rw [hwp] at h1 h3 h4 h5 h6
      exact ⟨κ.source, κ.open_source, hpκ, fun x hx => (hsrc hx).1, h1, h2, h3, h4, h5, h6⟩
    · obtain ⟨κ, ε, hε, hpκ, hsrc, hκp, htgt, hwκ, hβκ⟩ :=
        level_chart w β hw hβs p (hT p hp) (hreg p) U hU
      obtain ⟨h1, h2, h3, h4, h5, h6⟩ := chart_level_sides w β p κ ε hε hpκ hκp htgt hwκ
        (Or.inr (hβκ hβp.symm))
      rw [hwp] at h1 h3 h4 h5 h6
      exact ⟨κ.source, κ.open_source, hpκ, hsrc, h1, h2, h3, h4, h5, h6⟩
  
  have hloc5 : ∀ p ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀,
      ∃ V ∈ 𝓝 p, V ∩ ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) ⊆
        connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ := by
    intro p hp
    obtain ⟨V, hVo, hpV, -, hVL, -⟩ := GOOD p hp Set.univ Filter.univ_mem
    refine ⟨V, hVo.mem_nhds hpV, ?_⟩
    have h1 : V ∩ ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) ⊆
        connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p :=
      hVL.subset_connectedComponentIn ⟨hpV, hSL hp⟩ Set.inter_subset_right
    rw [← connectedComponentIn_eq hp] at h1
    exact h1
  
  obtain ⟨O, hOo, hSO, hOc, hOL, δ, hδ, hδfr⟩ :=
    collar_nbhd (connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) {p : M | 0 ≤ β p}
      w t hwc hEc hScpt hSL hloc5
  have K1 : ∀ x ∈ O ∩ {p : M | 0 < β p}, w x = t →
      x ∈ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ := fun x hx hwx =>
    hOL ⟨subset_closure hx.1, hΩE hx.2, hwx⟩
  
  obtain ⟨f, g, hf, hg, hfg₁, hfg₂⟩ :=
    circle_jump_functions {p : M | 0 < β p}
      (connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) O w t δ hwc hOo hδ K1
      (fun x hx hxΩ => hδfr x hx (hΩE hxΩ)) hlift
  
  obtain ⟨A, B, hAo, hBo, hAB, hcov, hAc, hBc, hSA, hSB⟩ :=
    two_sides_of_jump {p : M | 0 < β p}
      (connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) O w t f g hΩo hconn hScl hSpc
      p₀ hp₀S hSw hf hg hfg₁ hfg₂
      (fun p hp => by
        obtain ⟨V, hVo, hpV, hVO, -, hVΩ, h3, h4, h5, h6⟩ :=
          GOOD p hp O (hOo.mem_nhds (hSO hp))
        exact ⟨V, hVo, hpV, hVO, hVΩ, h3, h4, h5, h6,
          fun x hx hwx => K1 x ⟨hVO hx.1, hx.2⟩ hwx⟩)
  
  have hfarK : ∃ R : ℝ, ∀ y : E3, R < ‖y‖ → Φ.Φ y ∉ closure O := by
    choose ρ V hV hρV using hesc
    obtain ⟨T, -, hcover⟩ := hOc.elim_nhds_subcover V (fun x _ => hV x)
    refine ⟨∑ p ∈ T, |ρ p|, fun y hy hyK => ?_⟩
    obtain ⟨p, hpT, hpV⟩ := Set.mem_iUnion₂.mp (hcover hyK)
    have hle : ρ p ≤ ∑ p ∈ T, |ρ p| :=
      (le_abs_self _).trans (Finset.single_le_sum (fun i _ => abs_nonneg (ρ i)) hpT)
    exact hρV p y (lt_of_le_of_lt hle hy) hpV
  obtain ⟨R₀, hR₀⟩ := hfarK
  
  have hΦcont : ContinuousOn Φ.Φ Φ.Φ.source := Φ.Φ.contMDiffOn.continuousOn
  have hsubR : ∀ r : ℝ, 1 ≤ r → {y : E3 | r < ‖y‖} ⊆ Φ.Φ.source := by
    intro r hr y hy
    rw [Φ.source_eq]
    exact lt_of_le_of_lt hr (show r < ‖y‖ from hy)
  obtain ⟨R, hR0R, hReR⟩ : ∃ R : ℝ, R₀ ≤ R ∧ Re ≤ R :=
    ⟨max R₀ Re, le_max_left _ _, le_max_right _ _⟩
  have hR1 : 1 ≤ R := by linarith
  have hFo : IsOpen (Φ.Φ '' {y : E3 | R < ‖y‖}) := by
    have := Φ.Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
      (isOpen_lt continuous_const continuous_norm) (hsubR R hR1)
    exact this
  have hSRconn : IsConnected {y : E3 | R < ‖y‖} := by
    have hsph : IsConnected (sphere (0 : E3) 1) :=
      isConnected_sphere (by rw [← Module.finrank_eq_rank, finrank_euclideanSpace]; simp) 0
        zero_le_one
    have hprod := hsph.prod (isConnected_Ioi (a := R))
    have himg := hprod.image (fun q : E3 × ℝ => q.2 • q.1)
      (by fun_prop : Continuous (fun q : E3 × ℝ => q.2 • q.1)).continuousOn
    convert himg using 1
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_image, Set.mem_prod, mem_sphere_iff_norm, sub_zero,
      Set.mem_Ioi, Prod.exists]
    constructor
    · intro hy
      have hy0 : ‖y‖ ≠ 0 := ne_of_gt (by linarith)
      refine ⟨‖y‖⁻¹ • y, ‖y‖, ⟨?_, hy⟩, ?_⟩
      · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hy0]
      · rw [smul_smul, mul_inv_cancel₀ hy0, one_smul]
    · rintro ⟨u, r, ⟨hu, hr⟩, rfl⟩
      rw [norm_smul, hu, mul_one, Real.norm_eq_abs, abs_of_pos (by linarith)]
      exact hr
  have hFc : IsConnected (Φ.Φ '' {y : E3 | R < ‖y‖}) :=
    hSRconn.image Φ.Φ (hΦcont.mono (hsubR R hR1))
  have hann : IsCompact (Φ.Φ '' {y : E3 | Re ≤ ‖y‖ ∧ ‖y‖ ≤ R}) := by
    refine IsCompact.image_of_continuousOn ?_ (hΦcont.mono ?_)
    · refine Metric.isCompact_of_isClosed_isBounded ?_ ?_
      · exact (isClosed_le continuous_const continuous_norm).inter
          (isClosed_le continuous_norm continuous_const)
      · exact (Metric.isBounded_closedBall (x := (0 : E3)) (r := R)).subset
          (fun y hy => by simpa using hy.2)
    · intro y hy
      rw [Φ.source_eq]
      show (1 : ℝ) < ‖y‖
      linarith [hy.1]
  
  have hFΩS : Φ.Φ '' {y : E3 | R < ‖y‖} ⊆
      {p : M | 0 < β p} \ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ := by
    rintro x ⟨y, hy, rfl⟩
    have hy' : R < ‖y‖ := hy
    exact ⟨hfar y (by linarith),
      fun hS => hR₀ y (by linarith) (subset_closure (hSO hS))⟩
  have hFAB : Φ.Φ '' {y : E3 | R < ‖y‖} ⊆ A ∨ Φ.Φ '' {y : E3 | R < ‖y‖} ⊆ B :=
    IsPreconnected.subset_or_subset hAo hBo hAB (by rw [hcov]; exact hFΩS) hFc.isPreconnected
  
  have hEC : {p : M | 0 ≤ β p} \ Φ.Φ '' {y : E3 | R < ‖y‖} ⊆
      ({p : M | 0 ≤ β p} \ Φ.Φ '' {y : E3 | Re < ‖y‖}) ∪
        Φ.Φ '' {y : E3 | Re ≤ ‖y‖ ∧ ‖y‖ ≤ R} := by
    rintro x ⟨hxE, hxF⟩
    by_cases hx : x ∈ Φ.Φ '' {y : E3 | Re < ‖y‖}
    · obtain ⟨y, hy, rfl⟩ := hx
      have hy' : Re < ‖y‖ := hy
      right
      refine ⟨y, ⟨le_of_lt hy', ?_⟩, rfl⟩
      by_contra hyR
      exact hxF ⟨y, (not_le.mp hyR : R < ‖y‖), rfl⟩
    · left
      exact ⟨hxE, hx⟩
  have hCc : IsCompact (({p : M | 0 ≤ β p} \ Φ.Φ '' {y : E3 | Re < ‖y‖}) ∪
      Φ.Φ '' {y : E3 | Re ≤ ‖y‖ ∧ ‖y‖ ≤ R}) := hcpt.union hann
  
  have s10 : ∀ A' B' : Set M, IsOpen A' → IsOpen B' → Disjoint A' B' →
      A' ∪ B' = {p : M | 0 < β p} \ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ →
      IsConnected A' → connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ ⊆ closure A' →
      Φ.Φ '' {y : E3 | R < ‖y‖} ⊆ B' →
      ∃ K : Set M, IsCompact K ∧
        connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ ⊆ K ∧
        K ⊆ {p : M | 0 ≤ β p} ∧
        frontier K ⊆ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ ∪
          {p : M | β p = 0} ∧
        IsConnected (K \ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀) ∧
        K ⊆ closure (interior K) := by
    intro A' B' hA'o hB'o hA'B' hcov' hA'c hSA' hFB'
    have hA'Ω : A' ⊆
        {p : M | 0 < β p} \ connectedComponentIn ({p : M | 0 ≤ β p} ∩ w ⁻¹' {t}) p₀ := by
      rw [← hcov']; exact Set.subset_union_left
    have hclE : closure A' ⊆ {p : M | 0 ≤ β p} :=
      closure_minimal (fun x hx => hΩE (hA'Ω hx).1) hEc
    have hFcl : Disjoint (Φ.Φ '' {y : E3 | R < ‖y‖}) (closure A') :=
      (Disjoint.mono_left hFB' hA'B'.symm).closure_right hFo
    have hB'cl : Disjoint B' (closure A') := hA'B'.symm.closure_right hB'o
    have hint : A' ⊆ interior (closure A') := interior_maximal subset_closure hA'o
    refine ⟨closure A', ?_, hSA', hclE, ?_, ?_, closure_mono hint⟩
    · refine hCc.of_isClosed_subset isClosed_closure (fun x hx => hEC ⟨hclE hx, fun hxF => ?_⟩)
      exact Set.disjoint_left.mp hFcl hxF hx
    · intro x hx
      rw [frontier, closure_closure] at hx
      by_contra hcon
      simp only [Set.mem_union, not_or, Set.mem_setOf_eq] at hcon
      have hβx : 0 < β x := lt_of_le_of_ne (show 0 ≤ β x from hclE hx.1) (Ne.symm hcon.2)
      have hxD : x ∈ A' ∪ B' := by rw [hcov']; exact ⟨hβx, hcon.1⟩
      rcases hxD with h | h
      · exact hx.2 (hint h)
      · exact Set.disjoint_left.mp hB'cl h hx.1
    · exact hA'c.subset_closure (fun x hx => ⟨subset_closure hx, (hA'Ω hx).2⟩) Set.diff_subset
  
  rcases hFAB with hFA | hFB
  · exact s10 B A hBo hAo hAB.symm (by rw [Set.union_comm]; exact hcov) hBc hSB hFA
  · exact s10 A B hAo hBo hAB hcov hAc hSA hFB

theorem exterior_cover_exists [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds) :
    Nonempty (ExteriorCover g hAF k) :=
by
  obtain ⟨U, ρ, hUo, hUc, hρ, hfar, hcpt, hfront, hlift⟩ :=
    hi_exterior_region g hComplete hAF hR k
  obtain ⟨R⟩ := region_double_cover g hAF hR k U ρ hUo hUc hρ hfar hcpt hfront
  have hfc : IsCompact (frontier R.W) := by
    refine R.compact.of_isClosed_subset isClosed_frontier ?_
    rw [R.W_open.frontier_eq]
    intro x hx
    refine ⟨hx.1, ?_⟩
    rintro ⟨y, hy, rfl⟩
    exact hx.2 (R.far_sub y hy)
  obtain ⟨β, hβs, hpos, hzero, hreg, hmin⟩ :=
    minimal_defining_function R.metric R.W R.W_open hfc R.frontier_min
  have hset : {p | 0 < β p} = R.W := Set.ext hpos
  have hE : {p | 0 ≤ β p} = closure R.W := by
    rw [closure_eq_self_union_frontier]
    ext p
    simp only [Set.mem_setOf_eq, Set.mem_union]
    rw [← hpos p, ← hzero p]
    constructor
    · intro h
      rcases h.lt_or_eq with h | h
      · exact Or.inl h
      · exact Or.inr h.symm
    · rintro (h | h)
      · exact h.le
      · exact h.ge
  have hext : IsExteriorDomain (R.af.ends R.endIdx) β R.ρ :=
    ⟨hβs, hreg, R.ρ_ge, fun y hy => (hpos _).2 (R.far_sub y hy), by rw [hE]; exact R.compact⟩
  have hlift' : CircleLiftable {p | 0 < β p} := by
    rw [hset]
    obtain ⟨e⟩ := R.homeo
    intro θ
    obtain ⟨φU, hφU⟩ := hlift (θ.comp ⟨e.symm, e.symm.continuous⟩)
    refine ⟨φU.comp ⟨e, e.continuous⟩, fun x => ?_⟩
    have h := hφU (e x)
    simpa using h
  have hconn : IsConnected {p | 0 < β p} := by
    rw [hset]; exact R.W_conn
  have hesc := end_chart_escape R.metric R.af R.endIdx
  have hsep := separates_of_circle_liftable (R.af.ends R.endIdx) β R.ρ hext hconn hlift' hesc
  exact ⟨ExteriorCover.mk R.carrier R.metric R.af R.endIdx R.q_eq R.coeff_eq R.scal_nonneg
    β R.ρ hext hmin hsep⟩

theorem coord_lap_bounds (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2)) :
    ∃ C₀ : ℝ, 0 ≤ C₀ ∧ ContDiffOn ℝ ∞ (lapLoc G (fun z : E3 => z 0)) {x : E3 | R < ‖x‖} ∧
      ∀ x : E3, R < ‖x‖ →
        |lapLoc G (fun z : E3 => z 0) x| ≤ C₀ * ‖x‖ ^ (-q - 1) ∧
        ‖fderiv ℝ (lapLoc G (fun z : E3 => z 0)) x‖ ≤ C₀ * ‖x‖ ^ (-q - 2) :=
by
  classical
  
  
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hU1 : ∀ y ∈ {x : E3 | R < ‖x‖}, y ∈ {x : E3 | 1 < ‖x‖} := by
    intro y hy
    show (1 : ℝ) < ‖y‖
    exact lt_of_le_of_lt hR hy
  have hGU : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) {x : E3 | R < ‖x‖} :=
    fun a b => (hsmooth a b).mono hU1
  have hdetU : ∀ y ∈ {x : E3 | R < ‖x‖}, (G y).det ≠ 0 := by
    intro y hy
    have := (hb y hy).1
    exact ne_of_gt (by linarith)
  
  
  have hdGU : ∀ c a b : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) {x : E3 | R < ‖x‖} := by
    intro c a b
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => G z a b) y) {x : E3 | R < ‖x‖} :=
      (hGU a b).fderiv_of_isOpen hU (by simp)
    exact h1.clm_apply contDiffOn_const
  
  
  have hdetC : ContDiffOn ℝ ∞ (fun y => (G y).det) {x : E3 | R < ‖x‖} := by
    have h : (fun y => (G y).det) = fun y =>
        G y 0 0 * G y 1 1 * G y 2 2 - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [h]
    have h00 := hGU 0 0
    have h01 := hGU 0 1
    have h02 := hGU 0 2
    have h10 := hGU 1 0
    have h11 := hGU 1 1
    have h12 := hGU 1 2
    have h20 := hGU 2 0
    have h21 := hGU 2 1
    have h22 := hGU 2 2
    fun_prop
  have hadj : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate k l) {x : E3 | R < ‖x‖} := by
    have h00 := hGU 0 0
    have h01 := hGU 0 1
    have h02 := hGU 0 2
    have h10 := hGU 1 0
    have h11 := hGU 1 1
    have h12 := hGU 1 2
    have h20 := hGU 2 0
    have h21 := hGU 2 1
    have h22 := hGU 2 2
    intro k l
    simp only [Matrix.adjugate_fin_three]
    fin_cases k <;> fin_cases l <;> simp <;> fun_prop
  have hPU : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) {x : E3 | R < ‖x‖} := by
    intro k l
    have h : (fun y => (G y)⁻¹ k l) = fun y => ((G y).det)⁻¹ * (G y).adjugate k l := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [h]
    exact (hdetC.inv hdetU).mul (hadj k l)
  
  
  have hΓU : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) {x : E3 | R < ‖x‖} := by
    intro k i j
    have h : christoffel G k i j = fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y) := by
      funext y; rfl
    rw [h]
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hPU k l).mul (((hdGU i j l).add (hdGU j i l)).sub (hdGU l i j)))
  
  
  have hπ1 : ∀ (j : Fin 3) (z : E3),
      partialDeriv j (fun z : E3 => z 0) z = if j = 0 then (1 : ℝ) else 0 := by
    intro j z
    show fderiv ℝ (⇑(EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ)) z (e j) = _
    rw [ContinuousLinearMap.fderiv]
    show (e j) 0 = _
    simp [EuclideanSpace.single_apply, eq_comm]
  have hπ2 : ∀ (i j : Fin 3) (z : E3),
      partialDeriv i (partialDeriv j (fun z : E3 => z 0)) z = 0 := by
    intro i j z
    have hc : partialDeriv j (fun z : E3 => z 0) = fun _ => if j = 0 then (1 : ℝ) else 0 :=
      funext (hπ1 j)
    rw [hc]
    show fderiv ℝ (fun _ : E3 => if j = 0 then (1 : ℝ) else 0) z (e i) = 0
    rw [fderiv_const_apply]
    rfl
  have hF : lapLoc G (fun z : E3 => z 0) =
      fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y := by
    funext y
    simp only [lapLoc, hessLoc, hπ1, hπ2, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, zero_sub, mul_neg, Finset.sum_neg_distrib]
  rw [hF]
  
  
  have hnorm : ∀ L : E3 →L[ℝ] ℝ, ‖L‖ ≤ ∑ m : Fin 3, |L (e m)| := by
    intro L
    refine L.opNorm_le_bound (Finset.sum_nonneg fun m _ => abs_nonneg _) ?_
    intro w
    have hw : w = ∑ m : Fin 3, w m • e m := by
      have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr w
      simpa [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using this.symm
    have hLw : L w = ∑ m : Fin 3, w m * L (e m) := by
      conv_lhs => rw [hw]
      simp only [map_sum, map_smul, smul_eq_mul]
    rw [hLw, Real.norm_eq_abs, Finset.sum_mul]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [abs_mul, mul_comm]
    have hwm : |w m| ≤ ‖w‖ := by
      have := PiLp.norm_apply_le w m
      simpa [Real.norm_eq_abs] using this
    exact mul_le_mul_of_nonneg_left hwm (abs_nonneg _)
  
  have hsum9 : ∀ (f : Fin 3 → Fin 3 → ℝ) (M : ℝ), (∀ i j, |f i j| ≤ M) →
      |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ 9 * M := by
    intro f M hf
    calc |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ ∑ i : Fin 3, |∑ j : Fin 3, f i j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, |f i j| :=
          Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, M :=
          Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hf i j
      _ = 9 * M := by simp only [Fin.sum_univ_three]; ring
  
  
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 1 + C := ⟨_, rfl⟩
  obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = 4 * B ^ 2 := ⟨_, rfl⟩
  obtain ⟨Kg, hKgdef⟩ : ∃ Kg : ℝ,
      Kg = 9 / 2 * (9 * b ^ 2 * C ^ 2 + 12 * B ^ 2 * C ^ 2) + 3 / 2 * C := ⟨_, rfl⟩
  obtain ⟨Kv, hKvdef⟩ : ∃ Kv : ℝ, Kv = 81 / 2 * b ^ 2 * C := ⟨_, rfl⟩
  obtain ⟨Kd, hKddef⟩ : ∃ Kd : ℝ, Kd = 27 * (b * Kg + 81 / 2 * b ^ 3 * C ^ 2) := ⟨_, rfl⟩
  have hB1 : 1 ≤ B := by rw [hBdef]; linarith
  have hb0 : 0 ≤ b := by rw [hbdef]; positivity
  have hKg0 : 0 ≤ Kg := by rw [hKgdef]; positivity
  have hKv0 : 0 ≤ Kv := by rw [hKvdef]; positivity
  have hKd0 : 0 ≤ Kd := by rw [hKddef]; positivity
  refine ⟨Kv + Kd, by linarith, ?_, ?_⟩
  · exact (ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hPU i j).mul (hΓU 0 i j)).neg
  
  
  intro x hx
  have hr1 : 1 < ‖x‖ := lt_of_le_of_lt hR hx
  have hr0 : 0 < ‖x‖ := by linarith
  obtain ⟨hdet, hbx⟩ := hb x hx
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = ‖x‖ ^ (-q) := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : ℝ, u = ‖x‖ ^ (-q - 1) := ⟨_, rfl⟩
  obtain ⟨v, hv⟩ : ∃ v : ℝ, v = ‖x‖ ^ (-q - 2) := ⟨_, rfl⟩
  have hρ0 : 0 ≤ ρ := by rw [hρ]; exact Real.rpow_nonneg hr0.le _
  have hu0 : 0 ≤ u := by rw [hu]; exact Real.rpow_nonneg hr0.le _
  have hv0 : 0 ≤ v := by rw [hv]; exact Real.rpow_nonneg hr0.le _
  have hρ1 : ρ ≤ 1 := by
    rw [hρ]; exact Real.rpow_le_one_of_one_le_of_nonpos hr1.le (by linarith)
  have huu : u * u ≤ v := by
    rw [hu, hv, ← Real.rpow_add hr0]
    exact Real.rpow_le_rpow_of_exponent_le hr1.le (by linarith)
  have hρv : ρ * v ≤ v := by nlinarith
  rw [← hu, ← hv]
  
  have hPD : ∀ (c : Fin 3) (f : E3 → ℝ), |partialDeriv c f x| ≤ ‖fderiv ℝ f x‖ := by
    intro c f
    have hn : ‖e c‖ = 1 := by simp [e]
    calc |partialDeriv c f x| = ‖fderiv ℝ f x (e c)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ f x‖ * ‖e c‖ := (fderiv ℝ f x).le_opNorm _
      _ = ‖fderiv ℝ f x‖ := by rw [hn, mul_one]
  have hd1 : ∀ c a b' : Fin 3, |partialDeriv c (fun z => G z a b') x| ≤ C * u := by
    intro c a b'
    rw [hu]; exact (hPD c _).trans (hbx a b' 0).2.1
  have hd2 : ∀ m c a b' : Fin 3,
      |partialDeriv m (fun y => partialDeriv c (fun z => G z a b') y) x| ≤ C * v := by
    intro m c a b'
    rw [hv]; exact (hPD m _).trans (hbx a b' c).2.2
  have hGε : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ρ := by
    intro i j; rw [hρ]; exact (hbx i j 0).1
  have hGB : ∀ i j : Fin 3, |G x i j| ≤ B := by
    intro i j
    have h1 := hGε i j
    have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    have h3 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
    have h4 : C * ρ ≤ C := by nlinarith
    rw [hBdef]; linarith
  
  obtain ⟨ee, heedef⟩ : ∃ ee : ℝ, ee = 12 * B ^ 2 * (C * ρ) := ⟨_, rfl⟩
  have h1 := inv3_entry_bounds (G x) B (C * ρ) hdet hGB hGε
  have hPb : ∀ k l : Fin 3, |(G x)⁻¹ k l| ≤ b := by
    intro k l; rw [hbdef]; exact (h1 k l).1
  have hPe : ∀ k l : Fin 3, |(G x)⁻¹ k l - (if k = l then (1 : ℝ) else 0)| ≤ ee := by
    intro k l; rw [heedef]; exact (h1 k l).2
  
  have hxU : {x : E3 | R < ‖x‖} ∈ 𝓝 x := hU.mem_nhds hx
  have hGd : ∀ a b' : Fin 3, DifferentiableAt ℝ (fun y => G y a b') x := fun a b' =>
    ((hGU a b').differentiableOn (by simp)).differentiableAt hxU
  have hdGd : ∀ c a b' : Fin 3,
      DifferentiableAt ℝ (fun y => partialDeriv c (fun z => G z a b') y) x := fun c a b' =>
    ((hdGU c a b').differentiableOn (by simp)).differentiableAt hxU
  have hPd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := fun k l =>
    ((hPU k l).differentiableOn (by simp)).differentiableAt hxU
  have hΓd : ∀ i j : Fin 3, DifferentiableAt ℝ (christoffel G 0 i j) x := fun i j =>
    ((hΓU 0 i j).differentiableOn (by simp)).differentiableAt hxU
  
  have hdet' : (G x).det ≠ 0 := ne_of_gt (by linarith)
  have h2 := fun m => inv_entry_partialDeriv G x hGd hdet' m
  obtain ⟨p, hpdef⟩ : ∃ p : ℝ, p = 9 * b ^ 2 * (C * u) := ⟨_, rfl⟩
  have hα0 : 0 ≤ C * u := mul_nonneg hC hu0
  have hdP : ∀ m k l : Fin 3, |partialDeriv m (fun y => (G y)⁻¹ k l) x| ≤ p := by
    intro m k l
    rw [((h2 m) k l).2, abs_neg, hpdef]
    calc |∑ a : Fin 3, ∑ b' : Fin 3,
            (G x)⁻¹ k a * partialDeriv m (fun y => G y a b') x * (G x)⁻¹ b' l|
        ≤ 9 * (b * (C * u) * b) := by
          apply hsum9
          intro a b'
          rw [abs_mul, abs_mul]
          exact mul_le_mul (mul_le_mul (hPb k a) (hd1 m a b') (abs_nonneg _) hb0) (hPb b' l)
            (abs_nonneg _) (mul_nonneg hb0 hα0)
      _ = 9 * b ^ 2 * (C * u) := by ring
  
  have h5 := fun m k i j => christoffel_value_bounds (G x)⁻¹
    (fun m k l => partialDeriv m (fun y => (G y)⁻¹ k l) x)
    (fun c a b' => partialDeriv c (fun z => G z a b') x)
    (fun m c a b' => partialDeriv m (fun y => partialDeriv c (fun z => G z a b') y) x)
    b ee p (C * u) (C * v) hPb hPe hdP hd1 hd2 m k i j
  have hΓ : ∀ i j : Fin 3, |christoffel G 0 i j x| ≤ 9 / 2 * b * (C * u) :=
    fun i j => (h5 0 0 i j).1
  have hdΓ0 : ∀ m i j : Fin 3,
      |partialDeriv m (christoffel G 0 i j) x - (1 / 2 : ℝ) *
        (partialDeriv m (fun y => partialDeriv i (fun z => G z j 0) y) x
          + partialDeriv m (fun y => partialDeriv j (fun z => G z i 0) y) x
          - partialDeriv m (fun y => partialDeriv 0 (fun z => G z i j) y) x)|
        ≤ 9 / 2 * (p * (C * u) + ee * (C * v)) := by
    intro m i j
    rw [christoffel_partialDeriv_formula G x hPd hdGd m 0 i j]
    exact (h5 m 0 i j).2
  have hpu : p * (C * u) ≤ 9 * b ^ 2 * C ^ 2 * v := by
    calc p * (C * u) = 9 * b ^ 2 * C ^ 2 * (u * u) := by rw [hpdef]; ring
      _ ≤ 9 * b ^ 2 * C ^ 2 * v := mul_le_mul_of_nonneg_left huu (by positivity)
  have hev : ee * (C * v) ≤ 12 * B ^ 2 * C ^ 2 * v := by
    calc ee * (C * v) = 12 * B ^ 2 * C ^ 2 * (ρ * v) := by rw [heedef]; ring
      _ ≤ 12 * B ^ 2 * C ^ 2 * v := mul_le_mul_of_nonneg_left hρv (by positivity)
  have hdΓ : ∀ m i j : Fin 3, |partialDeriv m (christoffel G 0 i j) x| ≤ Kg * v := by
    intro m i j
    have t0 := abs_le.mp (hdΓ0 m i j)
    have a1 := abs_le.mp (hd2 m i j 0)
    have a2 := abs_le.mp (hd2 m j i 0)
    have a3 := abs_le.mp (hd2 m 0 i j)
    have hKv : Kg * v = 9 / 2 * (9 * b ^ 2 * C ^ 2 * v + 12 * B ^ 2 * C ^ 2 * v)
        + 3 / 2 * (C * v) := by rw [hKgdef]; ring
    rw [abs_le]
    constructor <;> nlinarith
  
  
  constructor
  · 
    rw [abs_neg]
    have hval := hsum9 (fun i j => (G x)⁻¹ i j * christoffel G 0 i j x)
      (b * (9 / 2 * b * (C * u))) (fun i j => by
        show |(G x)⁻¹ i j * christoffel G 0 i j x| ≤ _
        rw [abs_mul]; exact mul_le_mul (hPb i j) (hΓ i j) (abs_nonneg _) hb0)
    have he : 9 * (b * (9 / 2 * b * (C * u))) = Kv * u := by rw [hKvdef]; ring
    rw [he] at hval
    rw [add_mul]
    nlinarith [mul_nonneg hKd0 hu0]
  · 
    have hHas : HasFDerivAt
        (fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y)
        (-∑ i : Fin 3, ∑ j : Fin 3, ((G x)⁻¹ i j • fderiv ℝ (christoffel G 0 i j) x
          + christoffel G 0 i j x • fderiv ℝ (fun y => (G y)⁻¹ i j) x)) x := by
      have hin : ∀ i : Fin 3, HasFDerivAt
          (fun y => ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y)
          (∑ j : Fin 3, ((G x)⁻¹ i j • fderiv ℝ (christoffel G 0 i j) x
            + christoffel G 0 i j x • fderiv ℝ (fun y => (G y)⁻¹ i j) x)) x := fun i =>
        HasFDerivAt.sum (u := Finset.univ)
          (A := fun j y => (G y)⁻¹ i j * christoffel G 0 i j y)
          (fun j _ => (hPd i j).hasFDerivAt.mul (hΓd i j).hasFDerivAt)
      exact (HasFDerivAt.sum (u := Finset.univ)
        (A := fun i y => ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y)
        (fun i _ => hin i)).neg
    have hpart : ∀ m : Fin 3,
        fderiv ℝ (fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y) x
          (e m) =
        -∑ i : Fin 3, ∑ j : Fin 3, ((G x)⁻¹ i j * partialDeriv m (christoffel G 0 i j) x
          + christoffel G 0 i j x * partialDeriv m (fun y => (G y)⁻¹ i j) x) := by
      intro m
      rw [hHas.fderiv]
      simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.sum_apply,
        ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, partialDeriv]
    have hpb : ∀ m : Fin 3,
        |fderiv ℝ (fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y) x
          (e m)| ≤ 9 * (b * (Kg * v) + 81 / 2 * b ^ 3 * C ^ 2 * v) := by
      intro m
      rw [hpart m, abs_neg]
      apply hsum9
      intro i j
      have t1 : |(G x)⁻¹ i j * partialDeriv m (christoffel G 0 i j) x| ≤ b * (Kg * v) := by
        rw [abs_mul]; exact mul_le_mul (hPb i j) (hdΓ m i j) (abs_nonneg _) hb0
      have t2 : |christoffel G 0 i j x * partialDeriv m (fun y => (G y)⁻¹ i j) x|
          ≤ 81 / 2 * b ^ 3 * C ^ 2 * v := by
        rw [abs_mul]
        calc _ ≤ (9 / 2 * b * (C * u)) * p :=
              mul_le_mul (hΓ i j) (hdP m i j) (abs_nonneg _) (by positivity)
          _ = 81 / 2 * b ^ 3 * C ^ 2 * (u * u) := by rw [hpdef]; ring
          _ ≤ 81 / 2 * b ^ 3 * C ^ 2 * v := mul_le_mul_of_nonneg_left huu (by positivity)
      exact (abs_add_le _ _).trans (add_le_add t1 t2)
    calc ‖fderiv ℝ (fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y) x‖
        ≤ ∑ m : Fin 3, |fderiv ℝ
            (fun y => -∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G 0 i j y) x (e m)| :=
          hnorm _
      _ ≤ ∑ m : Fin 3, 9 * (b * (Kg * v) + 81 / 2 * b ^ 3 * C ^ 2 * v) :=
          Finset.sum_le_sum fun m _ => hpb m
      _ = Kd * v := by rw [hKddef]; simp only [Fin.sum_univ_three]; ring
      _ ≤ (Kv + Kd) * v := by rw [add_mul]; nlinarith [mul_nonneg hKv0 hv0]

theorem lapLoc_flat_perturbation (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2)) :
    ∃ K₂ : ℝ, 0 ≤ K₂ ∧ ∀ (w : E3 → ℝ) (x : E3), R < ‖x‖ →
      |lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x| ≤
        K₂ * (‖x‖ ^ (-q) * ∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x|
          + ‖x‖ ^ (-q - 1) * ∑ k : Fin 3, |partialDeriv k w x|) :=
by
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 1 + C := ⟨_, rfl⟩
  obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = 4 * B ^ 2 := ⟨_, rfl⟩
  have hB1 : 1 ≤ B := by rw [hBdef]; linarith
  have hB0 : 0 ≤ B := by linarith
  have hb0 : 0 ≤ b := by rw [hbdef]; positivity
  have hK0 : 0 ≤ 3 * b * C + 81 / 2 * b ^ 2 * C := by
    have h1 : 0 ≤ 3 * b * C := by positivity
    have h2 : 0 ≤ 81 / 2 * b ^ 2 * C := by positivity
    linarith
  refine ⟨3 * b * C + 81 / 2 * b ^ 2 * C, hK0, ?_⟩
  intro w x hx
  have hr1 : 1 < ‖x‖ := lt_of_le_of_lt hR hx
  have hr0 : 0 < ‖x‖ := by linarith
  obtain ⟨hdet, hbx⟩ := hb x hx
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = ‖x‖ ^ (-q) := ⟨_, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : ℝ, u = ‖x‖ ^ (-q - 1) := ⟨_, rfl⟩
  have hρ0 : 0 ≤ ρ := by rw [hρ]; exact Real.rpow_nonneg hr0.le _
  have hu0 : 0 ≤ u := by rw [hu]; exact Real.rpow_nonneg hr0.le _
  have hρ1 : ρ ≤ 1 := by
    rw [hρ]; exact Real.rpow_le_one_of_one_le_of_nonpos hr1.le (by linarith)
  rw [← hρ, ← hu]
  
  have hPD : ∀ (c : Fin 3) (f : E3 → ℝ), |partialDeriv c f x| ≤ ‖fderiv ℝ f x‖ := by
    intro c f
    have hn : ‖e c‖ = 1 := by simp [e]
    calc |partialDeriv c f x| = ‖fderiv ℝ f x (e c)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ f x‖ * ‖e c‖ := (fderiv ℝ f x).le_opNorm _
      _ = ‖fderiv ℝ f x‖ := by rw [hn, mul_one]
  have hd1 : ∀ c a b' : Fin 3, |partialDeriv c (fun z => G z a b') x| ≤ C * u := by
    intro c a b'
    rw [hu]; exact (hPD c _).trans (hbx a b' 0).2.1
  have hGε : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ρ := by
    intro i j; rw [hρ]; exact (hbx i j 0).1
  have hGB : ∀ i j : Fin 3, |G x i j| ≤ B := by
    intro i j
    have h1 := hGε i j
    have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    have h3 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
    have h4 : C * ρ ≤ C := by nlinarith
    rw [hBdef]; linarith
  
  
  have hdetpos : 0 < (G x).det := by linarith
  have hm : ∀ a1 a2 a3 a4 : ℝ, |a1| ≤ B → |a2| ≤ B → |a3| ≤ B → |a4| ≤ B →
      |a1 * a2 - a3 * a4| ≤ 2 * B ^ 2 ∧ |-(a1 * a2) + a3 * a4| ≤ 2 * B ^ 2 := by
    intro a1 a2 a3 a4 h1 h2 h3 h4
    have e1 : |a1 * a2| ≤ B ^ 2 := by
      rw [abs_mul, sq]; exact mul_le_mul h1 h2 (abs_nonneg _) hB0
    have e2 : |a3 * a4| ≤ B ^ 2 := by
      rw [abs_mul, sq]; exact mul_le_mul h3 h4 (abs_nonneg _) hB0
    have f1 := abs_le.mp e1
    have f2 := abs_le.mp e2
    constructor
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith
  have hadj : ∀ k l : Fin 3, |(G x).adjugate k l| ≤ 2 * B ^ 2 := by
    intro k l
    rw [Matrix.adjugate_fin_three]
    fin_cases k <;> fin_cases l <;> simp <;>
      first
      | exact (hm _ _ _ _ (hGB _ _) (hGB _ _) (hGB _ _) (hGB _ _)).1
      | exact (hm _ _ _ _ (hGB _ _) (hGB _ _) (hGB _ _) (hGB _ _)).2
  have hinv2 : (G x).det⁻¹ ≤ 2 := by
    calc (G x).det⁻¹ ≤ (1 / 2 : ℝ)⁻¹ := inv_anti₀ (by norm_num) hdet
      _ = 2 := by norm_num
  have hPb : ∀ k l : Fin 3, |(G x)⁻¹ k l| ≤ b := by
    intro k l
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv', abs_mul,
      abs_inv, abs_of_pos hdetpos, hbdef]
    calc (G x).det⁻¹ * |(G x).adjugate k l| ≤ 2 * (2 * B ^ 2) :=
          mul_le_mul hinv2 (hadj k l) (abs_nonneg _) (by norm_num)
      _ = 4 * B ^ 2 := by ring
  have hPA : (G x)⁻¹ * G x = 1 :=
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdetpos.ne')
  have hPe : ∀ k l : Fin 3,
      |(G x)⁻¹ k l - (if k = l then (1 : ℝ) else 0)| ≤ 3 * (b * (C * ρ)) := by
    intro k l
    have heq : (G x)⁻¹ k l - (if k = l then (1 : ℝ) else 0) =
        ∑ m : Fin 3, (G x)⁻¹ k m * ((if m = l then (1 : ℝ) else 0) - G x m l) := by
      have h1 : (G x)⁻¹ * (1 - G x) = (G x)⁻¹ - 1 := by
        rw [Matrix.mul_sub, hPA, Matrix.mul_one]
      have h2 := congrFun (congrFun h1 k) l
      rw [Matrix.mul_apply] at h2
      simp only [Matrix.sub_apply, Matrix.one_apply] at h2
      exact h2.symm
    rw [heq]
    calc |∑ m : Fin 3, (G x)⁻¹ k m * ((if m = l then (1 : ℝ) else 0) - G x m l)|
        ≤ ∑ m : Fin 3, |(G x)⁻¹ k m * ((if m = l then (1 : ℝ) else 0) - G x m l)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ m : Fin 3, b * (C * ρ) := Finset.sum_le_sum fun m _ => by
          rw [abs_mul, abs_sub_comm]
          exact mul_le_mul (hPb k m) (hGε m l) (abs_nonneg _) hb0
      _ = 3 * (b * (C * ρ)) := by rw [Fin.sum_univ_three]; ring
  
  
  have hΓ : ∀ k i j : Fin 3, |christoffel G k i j x| ≤ 9 / 2 * b * (C * u) := by
    intro k i j
    show |(1 / 2 : ℝ) * ∑ l : Fin 3, (G x)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) x + partialDeriv j (fun z => G z i l) x
        - partialDeriv l (fun z => G z i j) x)| ≤ _
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    have hs : |∑ l : Fin 3, (G x)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) x + partialDeriv j (fun z => G z i l) x
          - partialDeriv l (fun z => G z i j) x)| ≤ ∑ l : Fin 3, b * (3 * (C * u)) :=
      (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun l _ => by
        rw [abs_mul]
        refine mul_le_mul (hPb k l) ?_ (abs_nonneg _) hb0
        have h1 := abs_le.mp (hd1 i j l)
        have h2 := abs_le.mp (hd1 j i l)
        have h3 := abs_le.mp (hd1 l i j)
        rw [abs_le]; constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2])
    have hc : ∑ l : Fin 3, b * (3 * (C * u)) = 9 * b * (C * u) := by
      rw [Fin.sum_univ_three]; ring
    rw [hc] at hs
    linarith
  
  
  have hdiag : ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x =
      ∑ i : Fin 3, ∑ j : Fin 3,
        (if i = j then (1 : ℝ) else 0) * partialDeriv i (partialDeriv j w) x := by
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [ite_mul]
  have hid : lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x =
      ∑ i : Fin 3, ∑ j : Fin 3,
          ((G x)⁻¹ i j - (if i = j then (1 : ℝ) else 0)) * partialDeriv i (partialDeriv j w) x
        - ∑ i : Fin 3, ∑ j : Fin 3,
          (G x)⁻¹ i j * ∑ k : Fin 3, christoffel G k i j x * partialDeriv k w x := by
    rw [hdiag]
    simp only [lapLoc, hessLoc, Fin.sum_univ_three]
    ring
  rw [hid]
  
  
  obtain ⟨S2, hS2⟩ : ∃ S : ℝ,
      S = ∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x| := ⟨_, rfl⟩
  obtain ⟨S1, hS1⟩ : ∃ S : ℝ, S = ∑ k : Fin 3, |partialDeriv k w x| := ⟨_, rfl⟩
  have hS20 : 0 ≤ S2 := by
    rw [hS2]; exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _
  have hS10 : 0 ≤ S1 := by
    rw [hS1]; exact Finset.sum_nonneg fun k _ => abs_nonneg _
  rw [← hS2, ← hS1]
  have hT1 : |∑ i : Fin 3, ∑ j : Fin 3,
      ((G x)⁻¹ i j - (if i = j then (1 : ℝ) else 0)) * partialDeriv i (partialDeriv j w) x|
        ≤ 3 * (b * (C * ρ)) * S2 := by
    rw [hS2, Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hPe i j) (abs_nonneg _)
  have hinner : ∀ i j : Fin 3,
      |∑ k : Fin 3, christoffel G k i j x * partialDeriv k w x| ≤ 9 / 2 * b * (C * u) * S1 := by
    intro i j
    rw [hS1, Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun k _ => ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hΓ k i j) (abs_nonneg _)
  have hT2 : |∑ i : Fin 3, ∑ j : Fin 3,
      (G x)⁻¹ i j * ∑ k : Fin 3, christoffel G k i j x * partialDeriv k w x|
        ≤ ∑ i : Fin 3, ∑ j : Fin 3, b * (9 / 2 * b * (C * u) * S1) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    rw [abs_mul]
    exact mul_le_mul (hPb i j) (hinner i j) (abs_nonneg _) hb0
  have hT2' : ∑ i : Fin 3, ∑ j : Fin 3, b * (9 / 2 * b * (C * u) * S1)
      = 9 * (b * (9 / 2 * b * (C * u) * S1)) := by
    simp only [Fin.sum_univ_three]; ring
  rw [hT2'] at hT2
  have a1 := abs_le.mp hT1
  have a2 := abs_le.mp hT2
  have k1 : 0 ≤ 3 * b * C * (u * S1) :=
    mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hb0) hC) (mul_nonneg hu0 hS10)
  have k2 : 0 ≤ 81 / 2 * b ^ 2 * C * (ρ * S2) :=
    mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg b)) hC) (mul_nonneg hρ0 hS20)
  have hexp : (3 * b * C + 81 / 2 * b ^ 2 * C) * (ρ * S2 + u * S1) =
      3 * (b * (C * ρ)) * S2 + 9 * (b * (9 / 2 * b * (C * u) * S1))
        + 3 * b * C * (u * S1) + 81 / 2 * b ^ 2 * C * (ρ * S2) := by ring
  rw [abs_le]
  constructor <;> linarith

theorem cutoff_source_bounds (F : E3 → ℝ) (R a A : ℝ) (hR : 1 ≤ R) (ha : 0 ≤ a) (hA : 0 ≤ A)
    (hF : ContDiffOn ℝ ∞ F {x : E3 | R < ‖x‖})
    (hF0 : ∀ x : E3, R < ‖x‖ → |F x| ≤ A * ‖x‖ ^ (-a))
    (hF1 : ∀ x : E3, R < ‖x‖ → ‖fderiv ℝ F x‖ ≤ A * ‖x‖ ^ (-a - 1)) :
    ∃ (f : E3 → ℝ) (A' : ℝ), 0 ≤ A' ∧ Differentiable ℝ f ∧
      (∀ x : E3, R + 2 ≤ ‖x‖ → f x = F x) ∧
      ∀ x : E3, |f x| ≤ A' * (1 + ‖x‖) ^ (-a) ∧ ‖fderiv ℝ f x‖ ≤ A' * (1 + ‖x‖) ^ (-a - 1) :=
by
  
  have s1 : ∀ ρ s : ℝ, 1 ≤ ρ → 0 ≤ s → ρ ^ (-s) ≤ (2 : ℝ) ^ s * (1 + ρ) ^ (-s) := by
    intro ρ s hρ hs
    have h1 : (2 * ρ) ^ (-s) ≤ (1 + ρ) ^ (-s) :=
      Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)
    have h2 : (2 * ρ) ^ (-s) = (2 : ℝ) ^ (-s) * ρ ^ (-s) :=
      Real.mul_rpow (by norm_num) (by linarith)
    have h3 : (2 : ℝ) ^ s * (2 : ℝ) ^ (-s) = 1 := by
      rw [← Real.rpow_add (by norm_num)]
      simp
    have h4 : 0 ≤ (2 : ℝ) ^ s := Real.rpow_nonneg (by norm_num) _
    calc ρ ^ (-s) = (2 : ℝ) ^ s * ((2 : ℝ) ^ (-s) * ρ ^ (-s)) := by
          rw [← mul_assoc, h3, one_mul]
      _ = (2 : ℝ) ^ s * (2 * ρ) ^ (-s) := by rw [h2]
      _ ≤ (2 : ℝ) ^ s * (1 + ρ) ^ (-s) := mul_le_mul_of_nonneg_left h1 h4
  
  obtain ⟨χ, hχ, hχ01, hχ0, hχ1⟩ : ∃ χ : E3 → ℝ, ContDiff ℝ ∞ χ ∧
      (∀ x : E3, 0 ≤ χ x ∧ χ x ≤ 1) ∧
      (∀ x : E3, ‖x‖ ≤ R + 1 → χ x = 0) ∧ (∀ x : E3, R + 2 ≤ ‖x‖ → χ x = 1) := by
    let b : ContDiffBump (0 : E3) := ⟨R + 1, R + 2, by linarith, by linarith⟩
    refine ⟨fun x => 1 - b x, contDiff_const.sub b.contDiff, fun x => ⟨?_, ?_⟩, ?_, ?_⟩
    · have := b.le_one (x := x); linarith
    · have := b.nonneg (x := x); linarith
    · intro x hx
      have : b x = 1 := b.one_of_mem_closedBall (by rw [mem_closedBall_zero_iff]; exact hx)
      show 1 - b x = 0
      rw [this]; norm_num
    · intro x hx
      have : b x = 0 := b.zero_of_le_dist (by rw [dist_zero_right]; exact hx)
      show 1 - b x = 1
      rw [this]; norm_num
  set f : E3 → ℝ := fun x => χ x * F x with hfdef
  have fa : ∀ x : E3, ‖x‖ ≤ R + 1 → f x = 0 := fun x hx => by
    show χ x * F x = 0
    rw [hχ0 x hx, zero_mul]
  have fb : ∀ x : E3, R + 2 ≤ ‖x‖ → f x = F x := fun x hx => by
    show χ x * F x = F x
    rw [hχ1 x hx, one_mul]
  have hU₀ : IsOpen {x : E3 | ‖x‖ < R + 1} := isOpen_lt continuous_norm continuous_const
  have hU₁ : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hU₂ : IsOpen {x : E3 | R + 2 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hfU₁ : ContDiffOn ℝ ∞ f {x : E3 | R < ‖x‖} := hχ.contDiffOn.mul hF
  have fd : ∀ x : E3, ‖x‖ < R + 1 → f =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
    intro x hx
    filter_upwards [hU₀.mem_nhds hx] with y hy
    exact fa y (le_of_lt hy)
  have fe : ∀ x : E3, R + 2 < ‖x‖ → f =ᶠ[𝓝 x] F := by
    intro x hx
    filter_upwards [hU₂.mem_nhds hx] with y hy
    exact fb y (le_of_lt hy)
  have ff : ∀ x : E3, R < ‖x‖ → DifferentiableAt ℝ f x := fun x hx =>
    ((hfU₁.differentiableOn (by simp)) x hx).differentiableAt (hU₁.mem_nhds hx)
  have hdiff : Differentiable ℝ f := by
    intro x
    rcases lt_or_ge ‖x‖ (R + 1) with h | h
    · exact (differentiableAt_const (0 : ℝ)).congr_of_eventuallyEq (fd x h)
    · exact ff x (by linarith)
  
  obtain ⟨M, hM0, hM⟩ : ∃ M : ℝ, 0 ≤ M ∧
      ∀ x : E3, R + 1 ≤ ‖x‖ → ‖x‖ ≤ R + 2 → ‖fderiv ℝ f x‖ ≤ M := by
    have hcl : IsClosed ({x : E3 | R + 1 ≤ ‖x‖} ∩ closedBall 0 (R + 2)) :=
      (isClosed_le continuous_const continuous_norm).inter isClosed_closedBall
    have hcpt : IsCompact ({x : E3 | R + 1 ≤ ‖x‖} ∩ closedBall 0 (R + 2)) :=
      (isCompact_closedBall 0 (R + 2)).of_isClosed_subset hcl Set.inter_subset_right
    have hcont : ContinuousOn (fderiv ℝ f) {x : E3 | R < ‖x‖} :=
      hfU₁.continuousOn_fderiv_of_isOpen hU₁ (by simp)
    obtain ⟨C, hC⟩ := hcpt.exists_bound_of_continuousOn (hcont.mono (by
      intro x hx
      have h1 : R + 1 ≤ ‖x‖ := hx.1
      show R < ‖x‖
      linarith))
    refine ⟨max C 0, le_max_right _ _, fun x h1 h2 => ?_⟩
    have := hC x ⟨h1, by rw [mem_closedBall_zero_iff]; exact h2⟩
    exact this.trans (le_max_left _ _)
  
  have h2a : (0 : ℝ) ≤ (2 : ℝ) ^ (a + 1) := Real.rpow_nonneg (by norm_num) _
  have hR3 : (0 : ℝ) ≤ (R + 3) ^ (a + 1) := Real.rpow_nonneg (by linarith) _
  have hA'0 : 0 ≤ A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1) :=
    add_nonneg (mul_nonneg hA h2a) (mul_nonneg hM0 hR3)
  have h2le : (2 : ℝ) ^ a ≤ (2 : ℝ) ^ (a + 1) :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  have hP1 : A * (2 : ℝ) ^ (a + 1) ≤ A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1) :=
    le_add_of_nonneg_right (mul_nonneg hM0 hR3)
  have hP2 : M * (R + 3) ^ (a + 1) ≤ A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1) :=
    le_add_of_nonneg_left (mul_nonneg hA h2a)
  refine ⟨f, A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1), hA'0, hdiff, fb,
    fun x => ⟨?_, ?_⟩⟩
  · have hpx : 0 ≤ (1 + ‖x‖) ^ (-a) := Real.rpow_nonneg (by positivity) _
    rcases le_or_gt ‖x‖ (R + 1) with h | h
    · rw [fa x h, abs_zero]
      exact mul_nonneg hA'0 hpx
    · have hxR : R < ‖x‖ := by linarith
      have hx1 : 1 ≤ ‖x‖ := by linarith
      have e1 : |f x| ≤ |F x| := by
        show |χ x * F x| ≤ |F x|
        rw [abs_mul, abs_of_nonneg (hχ01 x).1]
        exact mul_le_of_le_one_left (abs_nonneg _) (hχ01 x).2
      have e2 := s1 ‖x‖ a hx1 ha
      calc |f x| ≤ A * ‖x‖ ^ (-a) := e1.trans (hF0 x hxR)
        _ ≤ A * ((2 : ℝ) ^ a * (1 + ‖x‖) ^ (-a)) := mul_le_mul_of_nonneg_left e2 hA
        _ = (A * (2 : ℝ) ^ a) * (1 + ‖x‖) ^ (-a) := by ring
        _ ≤ (A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1)) * (1 + ‖x‖) ^ (-a) := by
          apply mul_le_mul_of_nonneg_right _ hpx
          exact (mul_le_mul_of_nonneg_left h2le hA).trans hP1
  · have hpx : 0 ≤ (1 + ‖x‖) ^ (-a - 1) := Real.rpow_nonneg (by positivity) _
    rcases lt_or_ge ‖x‖ (R + 1) with h | h
    · rw [(fd x h).fderiv_eq, fderiv_const_apply, norm_zero]
      exact mul_nonneg hA'0 hpx
    rcases le_or_gt ‖x‖ (R + 2) with h' | h'
    · have hb := hM x h h'
      have hm1 : (R + 3) ^ (-a - 1) ≤ (1 + ‖x‖) ^ (-a - 1) :=
        Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by linarith)
      have hm2 : (R + 3) ^ (a + 1) * (R + 3) ^ (-a - 1) = 1 := by
        rw [← Real.rpow_add (by linarith)]
        have : a + 1 + (-a - 1) = 0 := by ring
        rw [this, Real.rpow_zero]
      calc ‖fderiv ℝ f x‖ ≤ M := hb
        _ = M * (R + 3) ^ (a + 1) * (R + 3) ^ (-a - 1) := by rw [mul_assoc, hm2, mul_one]
        _ ≤ M * (R + 3) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1) :=
          mul_le_mul_of_nonneg_left hm1 (mul_nonneg hM0 hR3)
        _ ≤ (A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1)) * (1 + ‖x‖) ^ (-a - 1) :=
          mul_le_mul_of_nonneg_right hP2 hpx
    · have hxR : R < ‖x‖ := by linarith
      have hx1 : 1 ≤ ‖x‖ := by linarith
      have e2 := s1 ‖x‖ (a + 1) hx1 (by linarith)
      have ee : -(a + 1) = -a - 1 := by ring
      rw [ee] at e2
      rw [(fe x h').fderiv_eq]
      calc ‖fderiv ℝ F x‖ ≤ A * ‖x‖ ^ (-a - 1) := hF1 x hxR
        _ ≤ A * ((2 : ℝ) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1)) :=
          mul_le_mul_of_nonneg_left e2 hA
        _ = (A * (2 : ℝ) ^ (a + 1)) * (1 + ‖x‖) ^ (-a - 1) := by ring
        _ ≤ (A * (2 : ℝ) ^ (a + 1) + M * (R + 3) ^ (a + 1)) * (1 + ‖x‖) ^ (-a - 1) :=
          mul_le_mul_of_nonneg_right hP1 hpx

theorem spc2_kernel_facts (K : E3 → ℝ)
    (hK : ∀ z : E3, K z = (1 + ‖z‖ ^ 2) ^ (-(1 / 2 : ℝ)) + 1 / 2 * (1 + ‖z‖ ^ 2) ^ (-(3 / 2 : ℝ))) :
    Differentiable ℝ K ∧ (∀ i : Fin 3, Differentiable ℝ (partialDeriv i K)) ∧
      (∀ z : E3, ‖fderiv ℝ K z‖ ≤ 10 * (1 + ‖z‖) ^ (-2 : ℝ)) ∧
      (∀ (i : Fin 3) (z : E3), ‖fderiv ℝ (partialDeriv i K) z‖ ≤ 60 * (1 + ‖z‖) ^ (-3 : ℝ)) ∧
      (∀ z : E3, ∑ i : Fin 3, partialDeriv i (partialDeriv i K) z =
        -(15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)))) :=
by
  
  have hsub : ∀ ρ : ℝ, 0 ≤ ρ → ∃ u : ℝ, 0 < u ∧ u ^ 2 * (1 + ρ ^ 2) = 1 ∧
      (1 + ρ ^ 2) ^ (-(3 / 2 : ℝ)) = u ^ 3 ∧ (1 + ρ ^ 2) ^ (-(5 / 2 : ℝ)) = u ^ 5 ∧
      (1 + ρ ^ 2) ^ (-(7 / 2 : ℝ)) = u ^ 7 := by
    intro ρ _
    have hσ : 0 < 1 + ρ ^ 2 := by positivity
    have hpow : ∀ k : ℕ, (1 + ρ ^ 2) ^ (-((k : ℝ) / 2)) = ((1 + ρ ^ 2) ^ (-(1 / 2 : ℝ))) ^ k := by
      intro k
      rw [← Real.rpow_mul_natCast hσ.le]
      congr 1; ring
    refine ⟨(1 + ρ ^ 2) ^ (-(1 / 2 : ℝ)), Real.rpow_pos_of_pos hσ _, ?_, ?_, ?_, ?_⟩
    · rw [← hpow 2]
      have : (-(((2 : ℕ) : ℝ) / 2)) = -1 := by norm_num
      rw [this, Real.rpow_neg_one, inv_mul_cancel₀ hσ.ne']
    · rw [← hpow 3]; norm_num
    · rw [← hpow 5]; norm_num
    · rw [← hpow 7]; norm_num
  have hfacts : ∀ ρ u : ℝ, 0 ≤ ρ → 0 < u → u ^ 2 * (1 + ρ ^ 2) = 1 →
      u ^ 2 ≤ 1 ∧ 0 ≤ u * ρ ∧ u * ρ ≤ 1 ∧ (u * (1 + ρ)) ^ 2 ≤ 2 := by
    intro ρ u hρ hu h1
    have hu2 : u ^ 2 ≤ 1 := by nlinarith [sq_nonneg (u * ρ)]
    have huρ0 : 0 ≤ u * ρ := mul_nonneg hu.le hρ
    have huρ : u * ρ ≤ 1 := by nlinarith [sq_nonneg u]
    have hw : (u * (1 + ρ)) ^ 2 ≤ 2 := by nlinarith [mul_nonneg (sq_nonneg u) (sq_nonneg (ρ - 1))]
    exact ⟨hu2, huρ0, huρ, hw⟩
  have hrp2 : ∀ ρ : ℝ, 0 ≤ ρ → (1 + ρ) ^ (-2 : ℝ) = ((1 + ρ) ^ 2)⁻¹ := by
    intro ρ hρ
    rw [Real.rpow_neg (by linarith), Real.rpow_two]
  have hrp3 : ∀ ρ : ℝ, 0 ≤ ρ → (1 + ρ) ^ (-3 : ℝ) = ((1 + ρ) ^ 3)⁻¹ := by
    intro ρ hρ
    rw [Real.rpow_neg (by linarith)]
    have : (3 : ℝ) = ((3 : ℕ) : ℝ) := by norm_num
    rw [this, Real.rpow_natCast]
  
  have hgrad : ∀ ρ : ℝ, 0 ≤ ρ →
      ((1 + ρ ^ 2) ^ (-(3 / 2 : ℝ)) + 3 / 2 * (1 + ρ ^ 2) ^ (-(5 / 2 : ℝ))) * ρ
        ≤ 10 * (1 + ρ) ^ (-2 : ℝ) := by
    intro ρ hρ
    obtain ⟨u, hu, h1, h3, h5, -⟩ := hsub ρ hρ
    obtain ⟨hu2, huρ0, huρ, hw⟩ := hfacts ρ u hρ hu h1
    rw [h3, h5, hrp2 ρ hρ, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]
    have key : (u ^ 3 + 3 / 2 * u ^ 5) * ρ * (1 + ρ) ^ 2
        = (1 + 3 / 2 * u ^ 2) * (u * ρ) * (u * (1 + ρ)) ^ 2 := by ring
    rw [key]
    have hA : 1 + 3 / 2 * u ^ 2 ≤ 5 / 2 := by linarith
    have hA0 : 0 ≤ 1 + 3 / 2 * u ^ 2 := by positivity
    have := mul_le_mul (mul_le_mul hA huρ huρ0 (by norm_num)) hw (sq_nonneg _)
      (by norm_num : (0 : ℝ) ≤ 5 / 2 * 1)
    linarith
  
  have hhess : ∀ ρ : ℝ, 0 ≤ ρ →
      ((1 + ρ ^ 2) ^ (-(3 / 2 : ℝ)) + 3 / 2 * (1 + ρ ^ 2) ^ (-(5 / 2 : ℝ)))
        + (3 * (1 + ρ ^ 2) ^ (-(5 / 2 : ℝ)) + 15 / 2 * (1 + ρ ^ 2) ^ (-(7 / 2 : ℝ))) * ρ ^ 2
        ≤ 60 * (1 + ρ) ^ (-3 : ℝ) := by
    intro ρ hρ
    obtain ⟨u, hu, h1, h3, h5, h7⟩ := hsub ρ hρ
    obtain ⟨hu2, huρ0, huρ, hw⟩ := hfacts ρ u hρ hu h1
    rw [h3, h5, h7, hrp3 ρ hρ, ← div_eq_mul_inv, le_div_iff₀ (by positivity)]
    have key : (u ^ 3 + 3 / 2 * u ^ 5 + (3 * u ^ 5 + 15 / 2 * u ^ 7) * ρ ^ 2) * (1 + ρ) ^ 3
        = (1 + 3 / 2 * u ^ 2 + 3 * (u * ρ) ^ 2 + 15 / 2 * u ^ 2 * (u * ρ) ^ 2)
          * ((u * (1 + ρ)) * (u * (1 + ρ)) ^ 2) := by ring
    rw [key]
    have hw0 : 0 ≤ u * (1 + ρ) := mul_nonneg hu.le (by linarith)
    have hw1 : u * (1 + ρ) ≤ 3 / 2 := by nlinarith
    have hw3 : (u * (1 + ρ)) * (u * (1 + ρ)) ^ 2 ≤ 3 / 2 * 2 :=
      mul_le_mul hw1 hw (sq_nonneg _) (by norm_num)
    have hp : (u * ρ) ^ 2 ≤ 1 := by nlinarith
    have hB : 1 + 3 / 2 * u ^ 2 + 3 * (u * ρ) ^ 2 + 15 / 2 * u ^ 2 * (u * ρ) ^ 2 ≤ 13 := by
      nlinarith [mul_le_mul hu2 hp (sq_nonneg _) (by norm_num : (0 : ℝ) ≤ 1)]
    have hB0 : 0 ≤ 1 + 3 / 2 * u ^ 2 + 3 * (u * ρ) ^ 2 + 15 / 2 * u ^ 2 * (u * ρ) ^ 2 := by
      positivity
    have := mul_le_mul hB hw3 (mul_nonneg hw0 (sq_nonneg _)) (by norm_num)
    linarith
  
  have hP : ∀ (α : ℝ) (z : E3), HasFDerivAt (fun y : E3 => (1 + ‖y‖ ^ 2) ^ α)
      ((2 * α * (1 + ‖z‖ ^ 2) ^ (α - 1)) • innerSL ℝ z) z := by
    intro α z
    have h1 := ((hasFDerivAt_id z).norm_sq).const_add 1
    have hne : (1 + ‖id z‖ ^ 2) ≠ 0 := by positivity
    have h3 := h1.rpow_const (p := α) (Or.inl hne)
    convert h3 using 1
    refine ContinuousLinearMap.ext fun k => ?_
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply, id,
      smul_eq_mul, ContinuousLinearMap.id_apply, two_smul, ContinuousLinearMap.add_apply]
    ring
  
  obtain ⟨H, hH⟩ : ∃ H : E3 → ℝ, ∀ z : E3,
      H z = (1 + ‖z‖ ^ 2) ^ (-(3 / 2 : ℝ)) + 3 / 2 * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : E3 → ℝ, ∀ z : E3,
      G z = 3 * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) + 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  have hH0 : ∀ z, 0 ≤ H z := fun z => by rw [hH z]; positivity
  have hG0 : ∀ z, 0 ≤ G z := fun z => by rw [hG z]; positivity
  have e1 : (-(1 / 2 : ℝ)) - 1 = -(3 / 2) := by norm_num
  have e2 : (-(3 / 2 : ℝ)) - 1 = -(5 / 2) := by norm_num
  have e3 : (-(5 / 2 : ℝ)) - 1 = -(7 / 2) := by norm_num
  
  have hKfun : K = fun y => (1 + ‖y‖ ^ 2) ^ (-(1 / 2 : ℝ)) + 1 / 2 * (1 + ‖y‖ ^ 2) ^ (-(3 / 2 : ℝ)) :=
    funext hK
  have hKd : ∀ z, HasFDerivAt K ((-H z) • innerSL ℝ z) z := by
    intro z
    rw [hKfun]
    have h := (hP (-(1 / 2)) z).add ((hP (-(3 / 2)) z).const_mul (1 / 2))
    convert h using 1
    refine ContinuousLinearMap.ext fun k => ?_
    rw [hH z]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, e1, e2]
    ring
  have hHfun : H = fun y => (1 + ‖y‖ ^ 2) ^ (-(3 / 2 : ℝ)) + 3 / 2 * (1 + ‖y‖ ^ 2) ^ (-(5 / 2 : ℝ)) :=
    funext hH
  have hHd : ∀ z, HasFDerivAt H ((-G z) • innerSL ℝ z) z := by
    intro z
    rw [hHfun]
    have h := (hP (-(3 / 2)) z).add ((hP (-(5 / 2)) z).const_mul (3 / 2))
    convert h using 1
    refine ContinuousLinearMap.ext fun k => ?_
    rw [hG z]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, e2, e3]
    ring
  have hinner_e : ∀ (z : E3) (i : Fin 3), innerSL ℝ z (e i) = z i := by
    intro z i
    simp [e, innerSL_apply_apply, EuclideanSpace.inner_single_right]
  
  have hpK : ∀ i : Fin 3, partialDeriv i K = fun z => -(H z * z i) := by
    intro i; funext z
    unfold partialDeriv
    rw [(hKd z).fderiv, ContinuousLinearMap.smul_apply, hinner_e, smul_eq_mul]
    ring
  
  have hproj : ∀ (i : Fin 3) (z : E3),
      HasFDerivAt (fun y : E3 => y i) (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) z :=
    fun i z => (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt
  have hLd : ∀ (i : Fin 3) (z : E3), HasFDerivAt (partialDeriv i K)
      (-(H z • (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) + z i • ((-G z) • innerSL ℝ z))) z := by
    intro i z
    rw [hpK i]
    exact ((hHd z).mul (hproj i z)).neg
  have hLapp : ∀ (i : Fin 3) (z k : E3),
      (-(H z • (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) + z i • ((-G z) • innerSL ℝ z))) k
        = -(H z * k i) + G z * z i * innerSL ℝ z k := by
    intro i z k
    have hpa : (EuclideanSpace.proj i : E3 →L[ℝ] ℝ) k = k i := rfl
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, hpa]
    ring
  have hcoord : ∀ (x : E3) (i : Fin 3), |x i| ≤ ‖x‖ := by
    intro x i
    have := PiLp.norm_apply_le x i
    rwa [Real.norm_eq_abs] at this
  refine ⟨fun z => (hKd z).differentiableAt, fun i z => (hLd i z).differentiableAt, ?_, ?_, ?_⟩
  · 
    intro z
    rw [(hKd z).fderiv, norm_smul, innerSL_apply_norm, Real.norm_eq_abs, abs_neg,
      abs_of_nonneg (hH0 z), hH z]
    exact hgrad ‖z‖ (norm_nonneg z)
  · 
    intro i z
    rw [(hLd i z).fderiv]
    have hM : 0 ≤ H z + G z * ‖z‖ ^ 2 := add_nonneg (hH0 z) (mul_nonneg (hG0 z) (sq_nonneg _))
    refine (ContinuousLinearMap.opNorm_le_bound _ hM fun k => ?_).trans ?_
    · rw [Real.norm_eq_abs, hLapp]
      have hin : |innerSL ℝ z k| ≤ ‖z‖ * ‖k‖ := abs_real_inner_le_norm z k
      calc |-(H z * k i) + G z * z i * innerSL ℝ z k|
          ≤ |-(H z * k i)| + |G z * z i * innerSL ℝ z k| := abs_add_le _ _
        _ = H z * |k i| + G z * (|z i| * |innerSL ℝ z k|) := by
          rw [abs_neg, abs_mul, abs_mul, abs_mul, abs_of_nonneg (hH0 z), abs_of_nonneg (hG0 z)]
          ring
        _ ≤ H z * ‖k‖ + G z * (‖z‖ * (‖z‖ * ‖k‖)) :=
          add_le_add (mul_le_mul_of_nonneg_left (hcoord k i) (hH0 z))
            (mul_le_mul_of_nonneg_left
              (mul_le_mul (hcoord z i) hin (abs_nonneg _) (norm_nonneg _)) (hG0 z))
        _ = (H z + G z * ‖z‖ ^ 2) * ‖k‖ := by ring
    · rw [hH z, hG z]
      exact hhess ‖z‖ (norm_nonneg z)
  · 
    intro z
    have hdiag : ∀ i : Fin 3, partialDeriv i (partialDeriv i K) z = -H z + G z * (z i) ^ 2 := by
      intro i
      show fderiv ℝ (partialDeriv i K) z (e i) = _
      rw [(hLd i z).fderiv, hLapp, hinner_e]
      simp [e, EuclideanSpace.single_apply]
      ring
    simp only [hdiag, Fin.sum_univ_three]
    have hnrm : ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
      simp only [Real.norm_eq_abs, sq_abs]
    have hs : 0 < 1 + ‖z‖ ^ 2 := by positivity
    have r5 : (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) = (1 + ‖z‖ ^ 2) * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)) := by
      rw [show (-(5 / 2 : ℝ)) = 1 + (-(7 / 2)) by norm_num, Real.rpow_add hs, Real.rpow_one]
    have r3 : (1 + ‖z‖ ^ 2) ^ (-(3 / 2 : ℝ)) = (1 + ‖z‖ ^ 2) * (1 + ‖z‖ ^ 2) ^ (-(5 / 2 : ℝ)) := by
      rw [show (-(3 / 2 : ℝ)) = 1 + (-(5 / 2)) by norm_num, Real.rpow_add hs, Real.rpow_one]
    rw [hH z, hG z, r3, r5]
    
    linear_combination
      (-(3 * (1 + ‖z‖ ^ 2) * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ))
        + 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)))) * hnrm

theorem spc2_density_facts (η : E3 → ℝ)
    (hη : ∀ z : E3, η z = 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ))) :
    Continuous η ∧ (∀ z : E3, 0 ≤ η z) ∧ (∀ z : E3, η z ≤ 100 * (1 + ‖z‖) ^ (-7 : ℝ)) ∧
      Integrable η ∧ 0 < ∫ z, η z :=
by
  have hX : ∀ z : E3, 0 < 1 + ‖z‖ ^ 2 := fun z => by positivity
  have hpos : ∀ z : E3, 0 < η z := by
    intro z
    rw [hη z]
    exact mul_pos (by norm_num) (Real.rpow_pos_of_pos (hX z) _)
  have hηfun : η = fun z => 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)) := funext hη
  
  have hcont : Continuous η := by
    rw [hηfun]
    exact continuous_const.mul
      ((continuous_const.add (continuous_norm.pow 2)).rpow_const
        (fun z => Or.inl (ne_of_gt (hX z))))
  
  have ht : (2 : ℝ) ^ (7 / 2 : ℝ) ≤ 12 := by
    have h0 : 0 ≤ (2 : ℝ) ^ (7 / 2 : ℝ) := Real.rpow_nonneg (by norm_num) _
    have h1 : (2 : ℝ) ^ (7 / 2 : ℝ) * (2 : ℝ) ^ (7 / 2 : ℝ) = 128 := by
      rw [← Real.rpow_add (by norm_num)]
      have : (7 / 2 + 7 / 2 : ℝ) = ((7 : ℕ) : ℝ) := by norm_num
      rw [this, Real.rpow_natCast]
      norm_num
    nlinarith
  
  have hbd : ∀ z : E3, η z ≤ 100 * (1 + ‖z‖) ^ (-7 : ℝ) := by
    intro z
    have hρ : 0 ≤ ‖z‖ := norm_nonneg z
    have hY : 0 < 1 + ‖z‖ := by linarith
    have hYX : (1 + ‖z‖) ^ 2 ≤ 2 * (1 + ‖z‖ ^ 2) := by nlinarith [sq_nonneg (1 - ‖z‖)]
    have hY2 : 0 < (1 + ‖z‖) ^ 2 := by positivity
    set a := (1 + ‖z‖ ^ 2) ^ (7 / 2 : ℝ) with ha_def
    set b := ((1 + ‖z‖) ^ 2) ^ (7 / 2 : ℝ) with hb_def
    have ha : 0 < a := Real.rpow_pos_of_pos (hX z) _
    have hb : 0 < b := Real.rpow_pos_of_pos hY2 _
    have hba : b ≤ 12 * a := by
      have h1 : b ≤ (2 * (1 + ‖z‖ ^ 2)) ^ (7 / 2 : ℝ) :=
        Real.rpow_le_rpow hY2.le hYX (by norm_num)
      rw [Real.mul_rpow (by norm_num) (hX z).le] at h1
      calc b ≤ (2 : ℝ) ^ (7 / 2 : ℝ) * a := h1
        _ ≤ 12 * a := mul_le_mul_of_nonneg_right ht ha.le
    have hL : η z = 15 / 2 * a⁻¹ := by
      rw [hη z, Real.rpow_neg (hX z).le]
    have hR : (1 + ‖z‖) ^ (-7 : ℝ) = b⁻¹ := by
      have e : (-7 : ℝ) = ((2 : ℕ) : ℝ) * (-(7 / 2 : ℝ)) := by norm_num
      rw [e, Real.rpow_natCast_mul hY.le, Real.rpow_neg hY2.le]
    rw [hL, hR, inv_eq_one_div, inv_eq_one_div, mul_one_div, mul_one_div,
      div_le_div_iff₀ ha hb]
    nlinarith
  
  have hint : Integrable η := by
    have hfin : (Module.finrank ℝ E3 : ℝ) < 7 := by
      rw [finrank_euclideanSpace_fin]; norm_num
    have h1 := integrable_rpow_neg_one_add_norm_sq (μ := (volume : Measure E3)) hfin
    have e : (-(7 : ℝ) / 2) = -(7 / 2 : ℝ) := by ring
    rw [e] at h1
    rw [hηfun]
    exact h1.const_mul (15 / 2)
  
  have hipos : 0 < ∫ z, η z := by
    rw [integral_pos_iff_support_of_nonneg (fun z => (hpos z).le) hint]
    have hsupp : Function.support η = Set.univ :=
      Set.eq_univ_iff_forall.mpr fun z => Function.mem_support.mpr (hpos z).ne'
    rw [hsupp]
    exact Measure.measure_univ_pos.mpr (NeZero.ne volume)
  exact ⟨hcont, fun z => (hpos z).le, hbd, hint, hipos⟩

theorem weight_conv_bound (p q : ℝ) (hp0 : 0 ≤ p) (hp3 : p < 3) (hq0 : 0 ≤ q) (hq3 : q < 3)
    (hpq : 3 < p + q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E3,
      ∫ y, (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) ≤ C * (1 + ‖x‖) ^ (3 - p - q) :=
by
  
  have polar_aux : ∀ F : ℝ → ℝ, ∫ y : E3, F ‖y‖ =
      3 * ((volume : Measure E3).real (ball 0 1) * ∫ t in Set.Ioi (0:ℝ), t ^ 2 * F t) := by
    intro F
    rw [integral_fun_norm_addHaar (volume : Measure E3) F]
    simp only [finrank_euclideanSpace, Fintype.card_fin, smul_eq_mul, nsmul_eq_mul]
    norm_num
  
  have s1 : ∀ σ : ℝ, σ < 3 →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ ρ : ℝ, 0 ≤ ρ →
        Integrable ({w : E3 | ‖w‖ ≤ ρ}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ))) ∧
        ∫ y, {w : E3 | ‖w‖ ≤ ρ}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ)) y
          ≤ C * (1 + ρ) ^ (3 - σ) := by
    intro σ hσ
    have hV0 : 0 ≤ (volume : Measure E3).real (ball 0 1) := measureReal_nonneg
    have h3σ : 0 < 3 - σ := by linarith
    refine ⟨3 * (volume : Measure E3).real (ball 0 1) / (3 - σ),
      div_nonneg (by positivity) h3σ.le, fun ρ hρ => ?_⟩
    have hcont : Continuous (fun w : E3 => (1 + ‖w‖) ^ (-σ)) :=
      (continuous_const.add continuous_norm).rpow_const (fun w => Or.inl (by positivity))
    have hset : {w : E3 | ‖w‖ ≤ ρ} = closedBall 0 ρ := by ext w; simp
    refine ⟨?_, ?_⟩
    · rw [hset]
      exact (hcont.continuousOn.integrableOn_compact (isCompact_closedBall 0 ρ)).integrable_indicator
        measurableSet_closedBall
    · have hfun : (fun y : E3 => {w : E3 | ‖w‖ ≤ ρ}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ)) y)
          = fun y => (Set.Iic ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) ‖y‖ := by
        funext y; simp [Set.indicator_apply]
      rw [hfun, polar_aux]
      have hJ : ∫ t in Set.Ioi (0:ℝ), t ^ 2 * (Set.Iic ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) t
          = ∫ t in Set.Ioc 0 ρ, t ^ 2 * (1 + t) ^ (-σ) := by
        have : (fun t : ℝ => t ^ 2 * (Set.Iic ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) t)
            = (Set.Iic ρ).indicator (fun t => t ^ 2 * (1 + t) ^ (-σ)) := by
          funext t; simp [Set.indicator_apply]
        rw [this, setIntegral_indicator measurableSet_Iic, Set.Ioi_inter_Iic]
      rw [hJ]
      have hhint : IntegrableOn (fun t : ℝ => (1 + t) ^ (2 - σ)) (Set.Ioc 0 ρ) := by
        refine (ContinuousOn.integrableOn_Icc ?_).mono_set Set.Ioc_subset_Icc_self
        exact (continuousOn_const.add continuousOn_id).rpow_const
          (fun t ht => Or.inl (by simp only [id]; linarith [ht.1]))
      have hbound : ∫ t in Set.Ioc 0 ρ, t ^ 2 * (1 + t) ^ (-σ)
          ≤ ∫ t in Set.Ioc 0 ρ, (1 + t) ^ (2 - σ) := by
        refine integral_mono_of_nonneg ?_ hhint ?_
        · filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
          have : 0 < 1 + t := by linarith [ht.1]
          show (0:ℝ) ≤ _
          positivity
        · filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
          have h1 : 0 < 1 + t := by linarith [ht.1]
          have h2 : t ^ 2 ≤ (1 + t) ^ 2 := pow_le_pow_left₀ ht.1.le (by linarith) 2
          have h3 : (1 + t) ^ (2 - σ) = (1 + t) ^ 2 * (1 + t) ^ (-σ) := by
            rw [sub_eq_add_neg, Real.rpow_add h1, Real.rpow_two]
          rw [h3]
          exact mul_le_mul_of_nonneg_right h2 (Real.rpow_nonneg h1.le _)
      have heval : ∫ t in Set.Ioc 0 ρ, (1 + t) ^ (2 - σ) = ((1 + ρ) ^ (3 - σ) - 1) / (3 - σ) := by
        rw [← intervalIntegral.integral_of_le hρ]
        have hc := intervalIntegral.integral_comp_add_left (fun u : ℝ => u ^ (2 - σ)) (1:ℝ)
          (a := 0) (b := ρ)
        simp only at hc
        rw [hc, integral_rpow (Or.inl (by linarith))]
        have e1 : 2 - σ + 1 = 3 - σ := by ring
        rw [e1, add_zero, Real.one_rpow]
      rw [heval] at hbound
      have hP : 0 ≤ (1 + ρ) ^ (3 - σ) := by positivity
      have hK : 0 ≤ 3 * (volume : Measure E3).real (ball 0 1) / (3 - σ) :=
        div_nonneg (by positivity) h3σ.le
      calc 3 * ((volume : Measure E3).real (ball 0 1) * ∫ t in Set.Ioc 0 ρ, t ^ 2 * (1 + t) ^ (-σ))
          ≤ 3 * ((volume : Measure E3).real (ball 0 1) * (((1 + ρ) ^ (3 - σ) - 1) / (3 - σ))) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hbound hV0) (by norm_num)
        _ = 3 * (volume : Measure E3).real (ball 0 1) / (3 - σ) * (1 + ρ) ^ (3 - σ)
              - 3 * (volume : Measure E3).real (ball 0 1) / (3 - σ) := by ring
        _ ≤ 3 * (volume : Measure E3).real (ball 0 1) / (3 - σ) * (1 + ρ) ^ (3 - σ) := by linarith
  
  have s2 : ∀ σ : ℝ, 3 < σ →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ ρ : ℝ, 0 ≤ ρ →
        Integrable ({w : E3 | ρ < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ))) ∧
        ∫ y, {w : E3 | ρ < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ)) y
          ≤ C * (1 + ρ) ^ (3 - σ) := by
    intro σ hσ
    have hV0 : 0 ≤ (volume : Measure E3).real (ball 0 1) := measureReal_nonneg
    have hσ3 : 0 < σ - 3 := by linarith
    refine ⟨3 * (volume : Measure E3).real (ball 0 1) / (σ - 3),
      div_nonneg (by positivity) hσ3.le, fun ρ hρ => ?_⟩
    refine ⟨?_, ?_⟩
    · have hint : Integrable (fun w : E3 => (1 + ‖w‖) ^ (-σ)) :=
        integrable_one_add_norm (by
          simp only [finrank_euclideanSpace, Fintype.card_fin, Nat.cast_ofNat]; exact hσ)
      exact hint.indicator (measurableSet_lt measurable_const measurable_norm)
    · have hfun : (fun y : E3 => {w : E3 | ρ < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-σ)) y)
          = fun y => (Set.Ioi ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) ‖y‖ := by
        funext y; simp [Set.indicator_apply]
      rw [hfun, polar_aux]
      have hJ : ∫ t in Set.Ioi (0:ℝ), t ^ 2 * (Set.Ioi ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) t
          = ∫ t in Set.Ioi ρ, t ^ 2 * (1 + t) ^ (-σ) := by
        have : (fun t : ℝ => t ^ 2 * (Set.Ioi ρ).indicator (fun t : ℝ => (1 + t) ^ (-σ)) t)
            = (Set.Ioi ρ).indicator (fun t => t ^ 2 * (1 + t) ^ (-σ)) := by
          funext t; simp [Set.indicator_apply]
        rw [this, setIntegral_indicator measurableSet_Ioi,
          Set.inter_eq_right.mpr (Set.Ioi_subset_Ioi hρ)]
      rw [hJ]
      have hderiv : ∀ t ∈ Set.Ici ρ, HasDerivAt (fun t : ℝ => (1 + t) ^ (3 - σ) / (3 - σ))
          ((1 + t) ^ (2 - σ)) t := by
        intro t ht
        have h1 : 0 < 1 + t := by linarith [Set.mem_Ici.mp ht]
        have hd := (((hasDerivAt_id t).const_add 1).rpow_const (p := 3 - σ)
          (Or.inl (by simp only [id]; exact h1.ne'))).div_const (3 - σ)
        convert hd using 1
        have hne : (3:ℝ) - σ ≠ 0 := by linarith
        simp only [id]
        rw [show (3:ℝ) - σ - 1 = 2 - σ by ring]
        field_simp
      have htend : Tendsto (fun t : ℝ => (1 + t) ^ (3 - σ) / (3 - σ)) atTop (𝓝 0) := by
        have h1 : Tendsto (fun t : ℝ => 1 + t) atTop atTop :=
          tendsto_atTop_add_const_left atTop 1 tendsto_id
        have h2 : Tendsto (fun t : ℝ => (1 + t) ^ (3 - σ)) atTop (𝓝 0) := by
          have := (tendsto_rpow_neg_atTop hσ3).comp h1
          simpa [Function.comp, neg_sub] using this
        have h3 := h2.div_const (3 - σ)
        rwa [zero_div] at h3
      have hhint : IntegrableOn (fun t : ℝ => (1 + t) ^ (2 - σ)) (Set.Ioi ρ) :=
        integrableOn_Ioi_deriv_of_nonneg' hderiv
          (fun t ht => by
            have : 0 < 1 + t := by linarith [Set.mem_Ioi.mp ht]
            positivity) htend
      have hbound : ∫ t in Set.Ioi ρ, t ^ 2 * (1 + t) ^ (-σ)
          ≤ ∫ t in Set.Ioi ρ, (1 + t) ^ (2 - σ) := by
        refine integral_mono_of_nonneg ?_ hhint ?_
        · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          have : 0 < 1 + t := by linarith [Set.mem_Ioi.mp ht]
          show (0:ℝ) ≤ _
          positivity
        · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
          have ht0 : 0 < t := by linarith [Set.mem_Ioi.mp ht]
          have h1 : 0 < 1 + t := by linarith
          have h2 : t ^ 2 ≤ (1 + t) ^ 2 := pow_le_pow_left₀ ht0.le (by linarith) 2
          have h3 : (1 + t) ^ (2 - σ) = (1 + t) ^ 2 * (1 + t) ^ (-σ) := by
            rw [sub_eq_add_neg, Real.rpow_add h1, Real.rpow_two]
          rw [h3]
          exact mul_le_mul_of_nonneg_right h2 (Real.rpow_nonneg h1.le _)
      have heval : ∫ t in Set.Ioi ρ, (1 + t) ^ (2 - σ) = 0 - (1 + ρ) ^ (3 - σ) / (3 - σ) :=
        integral_Ioi_of_hasDerivAt_of_tendsto' hderiv hhint htend
      rw [heval] at hbound
      calc 3 * ((volume : Measure E3).real (ball 0 1) * ∫ t in Set.Ioi ρ, t ^ 2 * (1 + t) ^ (-σ))
          ≤ 3 * ((volume : Measure E3).real (ball 0 1) * (0 - (1 + ρ) ^ (3 - σ) / (3 - σ))) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hbound hV0) (by norm_num)
        _ = 3 * (volume : Measure E3).real (ball 0 1) / (σ - 3) * (1 + ρ) ^ (3 - σ) := by
          rw [show (3:ℝ) - σ = -(σ - 3) by ring, div_neg]
          ring
  
  have s3 : ∀ (p q : ℝ), 0 ≤ p → 0 ≤ q → ∀ (x y : E3),
      (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) ≤
        2 ^ p * (1 + ‖x‖) ^ (-p) *
            {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y
          + 2 ^ q * (1 + ‖x‖) ^ (-q) *
            {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y)
          + 3 ^ p * {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator
              (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y := by
    intro p q hp hq x y
    have hX : 0 < 1 + ‖x‖ := by positivity
    have ha : 0 < 1 + ‖x - y‖ := by positivity
    have hb : 0 < 1 + ‖y‖ := by positivity
    have hT1 : 0 ≤ 2 ^ p * (1 + ‖x‖) ^ (-p) *
        {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y :=
      mul_nonneg (by positivity) (Set.indicator_nonneg (fun w _ => by positivity) _)
    have hT2 : 0 ≤ 2 ^ q * (1 + ‖x‖) ^ (-q) *
        {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y) :=
      mul_nonneg (by positivity) (Set.indicator_nonneg (fun w _ => by positivity) _)
    have hT3 : 0 ≤ 3 ^ p *
        {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y :=
      mul_nonneg (by positivity) (Set.indicator_nonneg (fun w _ => by positivity) _)
    have key : ∀ (c B s : ℝ), 0 < c → 0 ≤ B → (B / c) ^ (-s) = c ^ s * B ^ (-s) := by
      intro c B s hc hB
      rw [Real.div_rpow hB hc.le, Real.rpow_neg hc.le, div_inv_eq_mul, mul_comm]
    by_cases hA : ‖y‖ ≤ ‖x‖ / 2
    · rw [Set.indicator_of_mem (show y ∈ {w : E3 | ‖w‖ ≤ ‖x‖ / 2} from hA)]
      have h1 : ‖x‖ - ‖y‖ ≤ ‖x - y‖ := norm_sub_norm_le x y
      have h2 : (1 + ‖x‖) / 2 ≤ 1 + ‖x - y‖ := by linarith
      have h3 : (1 + ‖x - y‖) ^ (-p) ≤ ((1 + ‖x‖) / 2) ^ (-p) :=
        Real.rpow_le_rpow_of_nonpos (by positivity) h2 (by linarith)
      rw [key 2 _ p (by norm_num) hX.le] at h3
      have h4 := mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg hb.le (-q))
      linarith
    · by_cases hB : ‖x - y‖ ≤ ‖x‖ / 2
      · rw [Set.indicator_of_mem (show x - y ∈ {w : E3 | ‖w‖ ≤ ‖x‖ / 2} from hB)]
        have h1 : ‖x‖ - ‖x - y‖ ≤ ‖x - (x - y)‖ := norm_sub_norm_le x (x - y)
        rw [sub_sub_cancel] at h1
        have h2 : (1 + ‖x‖) / 2 ≤ 1 + ‖y‖ := by linarith
        have h3 : (1 + ‖y‖) ^ (-q) ≤ ((1 + ‖x‖) / 2) ^ (-q) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) h2 (by linarith)
        rw [key 2 _ q (by norm_num) hX.le] at h3
        have h4 := mul_le_mul_of_nonneg_left h3 (Real.rpow_nonneg ha.le (-p))
        linarith
      · have hA' : ‖x‖ / 2 < ‖y‖ := not_le.mp hA
        have hB' : ‖x‖ / 2 < ‖x - y‖ := not_le.mp hB
        rw [Set.indicator_of_mem (show y ∈ {w : E3 | ‖x‖ / 2 < ‖w‖} from hA')]
        have h1 : ‖y‖ - ‖x‖ ≤ ‖y - x‖ := norm_sub_norm_le y x
        rw [norm_sub_rev] at h1
        have h2 : (1 + ‖y‖) / 3 ≤ 1 + ‖x - y‖ := by linarith
        have h3 : (1 + ‖x - y‖) ^ (-p) ≤ ((1 + ‖y‖) / 3) ^ (-p) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) h2 (by linarith)
        rw [key 3 _ p (by norm_num) hb.le] at h3
        have h4 := mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg hb.le (-q))
        have h5 : (1 + ‖y‖) ^ (-(p + q)) = (1 + ‖y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) := by
          rw [← Real.rpow_add hb]; ring_nf
        rw [h5]
        linarith
  
  obtain ⟨Cq, hCq0, hCq⟩ := s1 q hq3
  obtain ⟨Cp, hCp0, hCp⟩ := s1 p hp3
  obtain ⟨Ct, hCt0, hCt⟩ := s2 (p + q) hpq
  have h2p : (0:ℝ) ≤ 2 ^ p := by positivity
  have h2q : (0:ℝ) ≤ 2 ^ q := by positivity
  have h3p : (0:ℝ) ≤ 3 ^ p := by positivity
  have h2pq : (0:ℝ) ≤ 2 ^ (p + q - 3) := by positivity
  refine ⟨2 ^ p * Cq + 2 ^ q * Cp + 3 ^ p * (2 ^ (p + q - 3) * Ct),
    add_nonneg (add_nonneg (mul_nonneg h2p hCq0) (mul_nonneg h2q hCp0))
      (mul_nonneg h3p (mul_nonneg h2pq hCt0)), fun x => ?_⟩
  have hX : 0 < 1 + ‖x‖ := by positivity
  have hnx : 0 ≤ ‖x‖ := norm_nonneg x
  have hρ : 0 ≤ ‖x‖ / 2 := by positivity
  obtain ⟨hI1, hJ1⟩ := hCq (‖x‖ / 2) hρ
  obtain ⟨hI2, hJ2⟩ := hCp (‖x‖ / 2) hρ
  obtain ⟨hI3, hJ3⟩ := hCt (‖x‖ / 2) hρ
  have hint1 : Integrable (fun y : E3 => 2 ^ p * (1 + ‖x‖) ^ (-p) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y) :=
    hI1.const_mul _
  have hint2 : Integrable (fun y : E3 => 2 ^ q * (1 + ‖x‖) ^ (-q) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y)) :=
    (hI2.comp_sub_left x).const_mul _
  have hint3 : Integrable (fun y : E3 => 3 ^ p *
      {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y) :=
    hI3.const_mul _
  have hint12 : Integrable (fun y : E3 => 2 ^ p * (1 + ‖x‖) ^ (-p) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y
      + 2 ^ q * (1 + ‖x‖) ^ (-q) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y)) :=
    hint1.add hint2
  have hMint : Integrable (fun y : E3 => 2 ^ p * (1 + ‖x‖) ^ (-p) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y
      + 2 ^ q * (1 + ‖x‖) ^ (-q) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y)
      + 3 ^ p * {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y) :=
    hint12.add hint3
  have hle : ∫ y, (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) ≤ ∫ y, (2 ^ p * (1 + ‖x‖) ^ (-p) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y
      + 2 ^ q * (1 + ‖x‖) ^ (-q) *
      {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) (x - y)
      + 3 ^ p * {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y) :=
    integral_mono_of_nonneg
      (Filter.Eventually.of_forall (fun y : E3 =>
        show (0:ℝ) ≤ (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) by positivity))
      hMint
      (Filter.Eventually.of_forall (fun y => s3 p q hp0 hq0 x y))
  rw [integral_add hint12 hint3, integral_add hint1 hint2, integral_const_mul,
    integral_const_mul, integral_const_mul,
    integral_sub_left_eq_self
      ({w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)))] at hle
  have hA1 : 0 ≤ 2 ^ p * (1 + ‖x‖) ^ (-p) := by positivity
  have hA2 : 0 ≤ 2 ^ q * (1 + ‖x‖) ^ (-q) := by positivity
  have f1 : (1 + ‖x‖ / 2) ^ (3 - q) ≤ (1 + ‖x‖) ^ (3 - q) :=
    Real.rpow_le_rpow (by positivity) (by linarith) (by linarith)
  have f2 : (1 + ‖x‖ / 2) ^ (3 - p) ≤ (1 + ‖x‖) ^ (3 - p) :=
    Real.rpow_le_rpow (by positivity) (by linarith) (by linarith)
  have f3 : (1 + ‖x‖ / 2) ^ (3 - (p + q)) ≤ 2 ^ (p + q - 3) * (1 + ‖x‖) ^ (3 - p - q) := by
    have h := Real.rpow_le_rpow_of_nonpos (by positivity : (0:ℝ) < (1 + ‖x‖) / 2)
      (by linarith : (1 + ‖x‖) / 2 ≤ 1 + ‖x‖ / 2) (by linarith : 3 - (p + q) ≤ 0)
    have e1 : ((1 + ‖x‖) / 2) ^ (3 - (p + q)) = 2 ^ (p + q - 3) * (1 + ‖x‖) ^ (3 - p - q) := by
      rw [Real.div_rpow hX.le (by norm_num), show p + q - 3 = -(3 - (p + q)) by ring,
        Real.rpow_neg (by norm_num), show 3 - p - q = 3 - (p + q) by ring]
      ring
    linarith
  have f4a : (1 + ‖x‖) ^ (-p) * (1 + ‖x‖) ^ (3 - q) = (1 + ‖x‖) ^ (3 - p - q) := by
    rw [← Real.rpow_add hX]; congr 1; ring
  have f4b : (1 + ‖x‖) ^ (-q) * (1 + ‖x‖) ^ (3 - p) = (1 + ‖x‖) ^ (3 - p - q) := by
    rw [← Real.rpow_add hX]; congr 1; ring
  have t1 : 2 ^ p * (1 + ‖x‖) ^ (-p) *
      ∫ y, {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-q)) y
        ≤ 2 ^ p * Cq * (1 + ‖x‖) ^ (3 - p - q) := by
    calc _ ≤ 2 ^ p * (1 + ‖x‖) ^ (-p) * (Cq * (1 + ‖x‖) ^ (3 - q)) :=
          mul_le_mul_of_nonneg_left (hJ1.trans (mul_le_mul_of_nonneg_left f1 hCq0)) hA1
      _ = 2 ^ p * Cq * ((1 + ‖x‖) ^ (-p) * (1 + ‖x‖) ^ (3 - q)) := by ring
      _ = _ := by rw [f4a]
  have t2 : 2 ^ q * (1 + ‖x‖) ^ (-q) *
      ∫ y, {w : E3 | ‖w‖ ≤ ‖x‖ / 2}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-p)) y
        ≤ 2 ^ q * Cp * (1 + ‖x‖) ^ (3 - p - q) := by
    calc _ ≤ 2 ^ q * (1 + ‖x‖) ^ (-q) * (Cp * (1 + ‖x‖) ^ (3 - p)) :=
          mul_le_mul_of_nonneg_left (hJ2.trans (mul_le_mul_of_nonneg_left f2 hCp0)) hA2
      _ = 2 ^ q * Cp * ((1 + ‖x‖) ^ (-q) * (1 + ‖x‖) ^ (3 - p)) := by ring
      _ = _ := by rw [f4b]
  have t3 : 3 ^ p *
      ∫ y, {w : E3 | ‖x‖ / 2 < ‖w‖}.indicator (fun w : E3 => (1 + ‖w‖) ^ (-(p + q))) y
        ≤ 3 ^ p * (Ct * (2 ^ (p + q - 3) * (1 + ‖x‖) ^ (3 - p - q))) :=
    mul_le_mul_of_nonneg_left (hJ3.trans (mul_le_mul_of_nonneg_left f3 hCt0)) h3p
  nlinarith [hle, t1, t2, t3]

theorem weight_peetre_integrable (p q : ℝ) (hp0 : 0 ≤ p) (hpq : 3 < p + q) (x : E3) :
    Integrable (fun y : E3 => (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) :=
by
  have hfin : ((Module.finrank ℝ E3 : ℕ) : ℝ) < p + q := by
    rw [finrank_euclideanSpace, Fintype.card_fin]
    exact_mod_cast hpq
  have hmaj : Integrable (fun y : E3 => (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-(p + q))) :=
    (integrable_one_add_norm (μ := (volume : Measure E3)) hfin).const_mul _
  have hcont : Continuous (fun y : E3 => (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
    refine Continuous.mul ?_ ?_
    · exact (continuous_const.add (continuous_const.sub continuous_id).norm).rpow_const
        (fun y => Or.inl (by positivity))
    · exact (continuous_const.add continuous_norm).rpow_const
        (fun y => Or.inl (by positivity))
  refine hmaj.mono' hcont.aestronglyMeasurable (Filter.Eventually.of_forall (fun y => ?_))
  have ha : (0 : ℝ) < 1 + ‖x‖ := by positivity
  have hb : (0 : ℝ) < 1 + ‖y‖ := by positivity
  have hc : (0 : ℝ) < 1 + ‖x - y‖ := by positivity
  have hpeetre : 1 + ‖y‖ ≤ (1 + ‖x‖) * (1 + ‖x - y‖) := by
    have h1 : ‖y‖ ≤ ‖x‖ + ‖y - x‖ := norm_le_norm_add_norm_sub' y x
    rw [norm_sub_rev y x] at h1
    have h2 : 0 ≤ ‖x‖ * ‖x - y‖ := mul_nonneg (norm_nonneg _) (norm_nonneg _)
    nlinarith
  have hs2 : (1 + ‖x - y‖) ^ (-p) ≤ (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
    have h1 : ((1 + ‖x‖) * (1 + ‖x - y‖)) ^ (-p) ≤ (1 + ‖y‖) ^ (-p) :=
      Real.rpow_le_rpow_of_nonpos hb hpeetre (by linarith)
    rw [Real.mul_rpow ha.le hc.le] at h1
    have hap : 0 < (1 + ‖x‖) ^ p := Real.rpow_pos_of_pos ha p
    have h2 : (1 + ‖x‖) ^ p * (1 + ‖x‖) ^ (-p) = 1 := by
      rw [Real.rpow_neg ha.le, mul_inv_cancel₀ hap.ne']
    calc (1 + ‖x - y‖) ^ (-p)
        = (1 + ‖x‖) ^ p * ((1 + ‖x‖) ^ (-p) * (1 + ‖x - y‖) ^ (-p)) := by
          rw [← mul_assoc, h2, one_mul]
      _ ≤ (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := mul_le_mul_of_nonneg_left h1 hap.le
  have hF0 : 0 ≤ (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) :=
    mul_nonneg (Real.rpow_nonneg hc.le _) (Real.rpow_nonneg hb.le _)
  rw [Real.norm_of_nonneg hF0]
  calc (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)
      ≤ ((1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p)) * (1 + ‖y‖) ^ (-q) :=
        mul_le_mul_of_nonneg_right hs2 (Real.rpow_nonneg hb.le _)
    _ = (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-(p + q)) := by
        rw [mul_assoc, ← Real.rpow_add hb, neg_add]

theorem renorm_conv_hasFDerivAt (k f : E3 → ℝ) (p q M A : ℝ) (hp : 0 ≤ p) (hpq : 3 < p + q)
    (hM : 0 ≤ M) (hA : 0 ≤ A) (hk : Differentiable ℝ k)
    (hk1 : ∀ z : E3, ‖fderiv ℝ k z‖ ≤ M * (1 + ‖z‖) ^ (-p))
    (hf : Continuous f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-q)) (x : E3) :
    HasFDerivAt (fun x' : E3 => ∫ y, (k (x' - y) - k (-y)) * f y)
        (∫ y, f y • fderiv ℝ k (x - y)) x ∧
      ∀ i : Fin 3, partialDeriv i (fun x' : E3 => ∫ y, (k (x' - y) - k (-y)) * f y) x =
        ∫ y, partialDeriv i k (x - y) * f y :=
by
  have hkc : Continuous k := hk.continuous
  
  have hshift : ∀ x' y : E3, ‖x' - x‖ ≤ 1 →
      (1 + ‖x' - y‖) ^ (-p) ≤ 2 ^ p * (1 + ‖x - y‖) ^ (-p) := by
    intro x' y hx'
    have h1 : ‖x - y‖ ≤ ‖x - x'‖ + ‖x' - y‖ := norm_sub_le_norm_sub_add_norm_sub x x' y
    have h2 : ‖x - x'‖ ≤ 1 := by rw [norm_sub_rev]; exact hx'
    have ha : 0 < (1 + ‖x - y‖) / 2 := by positivity
    have hab : (1 + ‖x - y‖) / 2 ≤ 1 + ‖x' - y‖ := by
      have := norm_nonneg (x' - y); linarith
    calc (1 + ‖x' - y‖) ^ (-p) ≤ ((1 + ‖x - y‖) / 2) ^ (-p) :=
          Real.rpow_le_rpow_of_nonpos ha hab (by linarith)
      _ = 2 ^ p * (1 + ‖x - y‖) ^ (-p) := by
          rw [Real.div_rpow (by positivity) (by norm_num),
            Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), div_inv_eq_mul, mul_comm]
  
  have hdiff : ∀ y : E3,
      |k (x - y) - k (-y)| ≤ M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) * ‖x‖ := by
    intro y
    have hbd : ∀ w ∈ segment ℝ (-y) (x - y),
        ‖fderiv ℝ k w‖ ≤ M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
      intro w hw
      obtain ⟨a, b, ha, hb, hab, rfl⟩ := hw
      have hw' : a • (-y) + b • (x - y) = b • x - y := by
        calc a • (-y) + b • (x - y) = b • x - (a + b) • y := by
              simp only [smul_neg, smul_sub, add_smul]; abel
          _ = b • x - y := by rw [hab, one_smul]
      rw [hw']
      have hb1 : b ≤ 1 := by linarith
      have hny : ‖y‖ ≤ ‖x‖ + ‖b • x - y‖ := by
        have e : y = b • x - (b • x - y) := by abel
        calc ‖y‖ = ‖b • x - (b • x - y)‖ := by rw [← e]
          _ ≤ ‖b • x‖ + ‖b • x - y‖ := norm_sub_le _ _
          _ ≤ ‖x‖ + ‖b • x - y‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hb]
            have := norm_nonneg x
            nlinarith
      have hX : 0 < 1 + ‖x‖ := by positivity
      have hY : 0 < 1 + ‖y‖ := by positivity
      have hYW : (1 + ‖y‖) / (1 + ‖x‖) ≤ 1 + ‖b • x - y‖ := by
        rw [div_le_iff₀ hX]
        have := norm_nonneg x
        have := norm_nonneg (b • x - y)
        nlinarith
      have h1 : (1 + ‖b • x - y‖) ^ (-p) ≤ ((1 + ‖y‖) / (1 + ‖x‖)) ^ (-p) :=
        Real.rpow_le_rpow_of_nonpos (div_pos hY hX) hYW (by linarith)
      have h2 : ((1 + ‖y‖) / (1 + ‖x‖)) ^ (-p) = (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
        rw [Real.div_rpow hY.le hX.le, Real.rpow_neg hX.le, div_inv_eq_mul, mul_comm]
      calc ‖fderiv ℝ k (b • x - y)‖ ≤ M * (1 + ‖b • x - y‖) ^ (-p) := hk1 _
        _ ≤ M * ((1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p)) :=
            mul_le_mul_of_nonneg_left (h1.trans h2.le) hM
        _ = M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by ring
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hk z) hbd
      (convex_segment _ _) (left_mem_segment ℝ (-y) (x - y)) (right_mem_segment ℝ (-y) (x - y))
    rw [← Real.norm_eq_abs]
    have e : x - y - -y = x := by abel
    rw [e] at hmvt
    exact hmvt
  have I0 := weight_peetre_integrable p q hp hpq 0
  have Ix := weight_peetre_integrable p q hp hpq x
  have hFcont : ∀ x' : E3, Continuous (fun y : E3 => (k (x' - y) - k (-y)) * f y) := fun x' =>
    ((hkc.comp (continuous_const.sub continuous_id)).sub (hkc.comp continuous_neg)).mul hf
  have hF'meas : ∀ x' : E3,
      AEStronglyMeasurable (fun y : E3 => f y • fderiv ℝ k (x' - y)) volume := by
    intro x'
    have hm : Measurable (fun y : E3 => fderiv ℝ k (x' - y)) :=
      (measurable_fderiv ℝ k).comp (continuous_const.sub continuous_id).measurable
    exact hf.aestronglyMeasurable.smul hm.aestronglyMeasurable
  have hbound : ∀ x' ∈ Metric.ball x 1, ∀ y : E3,
      ‖f y • fderiv ℝ k (x' - y)‖ ≤
        M * A * 2 ^ p * ((1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
    intro x' hx' y
    have hx'1 : ‖x' - x‖ ≤ 1 := by
      rw [Metric.mem_ball, dist_eq_norm] at hx'; exact hx'.le
    have H : ‖fderiv ℝ k (x' - y)‖ ≤ M * (2 ^ p * (1 + ‖x - y‖) ^ (-p)) :=
      (hk1 _).trans (mul_le_mul_of_nonneg_left (hshift x' y hx'1) hM)
    have hfy : 0 ≤ A * (1 + ‖y‖) ^ (-q) := mul_nonneg hA (Real.rpow_nonneg (by positivity) _)
    rw [norm_smul, Real.norm_eq_abs]
    calc |f y| * ‖fderiv ℝ k (x' - y)‖
        ≤ (A * (1 + ‖y‖) ^ (-q)) * (M * (2 ^ p * (1 + ‖x - y‖) ^ (-p))) :=
          mul_le_mul (hf0 y) H (norm_nonneg _) hfy
      _ = M * A * 2 ^ p * ((1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by ring
  have hderiv : ∀ x' y : E3, HasFDerivAt (fun x' : E3 => (k (x' - y) - k (-y)) * f y)
      (f y • fderiv ℝ k (x' - y)) x' := by
    intro x' y
    have h1 : HasFDerivAt (fun z : E3 => k (z - y)) (fderiv ℝ k (x' - y)) x' := by
      have := (hk (x' - y)).hasFDerivAt.comp x' ((hasFDerivAt_id x').sub_const y)
      simpa using this
    exact (h1.sub_const (k (-y))).mul_const (f y)
  have hFint : Integrable (fun y : E3 => (k (x - y) - k (-y)) * f y) := by
    refine Integrable.mono' (I0.const_mul (M * (1 + ‖x‖) ^ p * ‖x‖ * A))
      (hFcont x).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul]
    have h1 := hdiff y
    calc |k (x - y) - k (-y)| * |f y|
        ≤ (M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) * ‖x‖) * (A * (1 + ‖y‖) ^ (-q)) :=
          mul_le_mul h1 (hf0 y) (abs_nonneg _) ((abs_nonneg _).trans h1)
      _ = M * (1 + ‖x‖) ^ p * ‖x‖ * A * ((1 + ‖0 - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
          rw [zero_sub, norm_neg]; ring
  have hmain := hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume)
    (F := fun x' y => (k (x' - y) - k (-y)) * f y)
    (F' := fun x' y => f y • fderiv ℝ k (x' - y))
    (Metric.ball_mem_nhds x one_pos)
    (Filter.Eventually.of_forall (fun x' => (hFcont x').aestronglyMeasurable))
    hFint (hF'meas x)
    (Filter.Eventually.of_forall (fun y x' hx' => hbound x' hx' y))
    (Ix.const_mul (M * A * 2 ^ p))
    (Filter.Eventually.of_forall (fun y x' _ => hderiv x' y))
  refine ⟨hmain, fun i => ?_⟩
  have hF'int : Integrable (fun y : E3 => f y • fderiv ℝ k (x - y)) :=
    Integrable.mono' (Ix.const_mul (M * A * 2 ^ p)) (hF'meas x)
      (Filter.Eventually.of_forall (fun y => hbound x (Metric.mem_ball_self one_pos) y))
  unfold partialDeriv
  rw [hmain.fderiv, ContinuousLinearMap.integral_apply hF'int]
  congr 1
  funext y
  rw [ContinuousLinearMap.smul_apply, smul_eq_mul, mul_comm]

theorem conv_fderiv_lip_bound (k f : E3 → ℝ) (a A M : ℝ) (ha : 1 < a) (ha2 : a < 2)
    (hA : 0 ≤ A) (hM : 0 ≤ M) (hk : Continuous k)
    (hk0 : ∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-2 : ℝ))
    (hf : Differentiable ℝ f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-a))
    (hf1 : ∀ y : E3, ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖) ^ (-a - 1))
    (hW : Differentiable ℝ (fun x : E3 => ∫ y, k (x - y) * f y)) (x : E3) :
    ‖fderiv ℝ (fun x : E3 => ∫ y, k (x - y) * f y) x‖ ≤
      8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) :=
by
  
  have hwt_nn : ∀ y : E3, 0 ≤ (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := fun y =>
    mul_nonneg (Real.rpow_nonneg (by positivity) _) (Real.rpow_nonneg (by positivity) _)
  have hI : 0 ≤ ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := integral_nonneg hwt_nn
  have hC : 0 ≤ 8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := by
    positivity
  
  have hweight : ∀ c w : E3, ‖w - c‖ ≤ 1 / 2 →
      (1 + ‖w‖) ^ (-a - 1) ≤ 8 * (1 + ‖c‖) ^ (-(a + 1)) := by
    intro c w hw
    have hu : 1 ≤ 1 + ‖w‖ := by linarith [norm_nonneg w]
    have hv : 0 < 1 + ‖c‖ := by linarith [norm_nonneg c]
    have hcw : ‖c‖ - ‖w‖ ≤ ‖c - w‖ := norm_sub_norm_le c w
    rw [norm_sub_rev] at hcw
    have hvu : 1 + ‖c‖ ≤ 2 * (1 + ‖w‖) := by linarith
    have e1 : (-a - 1 : ℝ) = -(a + 1) := by ring
    rw [e1]
    have h2 : (2 * (1 + ‖w‖)) ^ (-(a + 1)) ≤ (1 + ‖c‖) ^ (-(a + 1)) :=
      Real.rpow_le_rpow_of_nonpos hv hvu (by linarith)
    have h3 : (2 * (1 + ‖w‖)) ^ (-(a + 1)) = (2 : ℝ) ^ (-(a + 1)) * (1 + ‖w‖) ^ (-(a + 1)) :=
      Real.mul_rpow (by norm_num) (by linarith)
    have h4 : (2 : ℝ) ^ (a + 1) * (2 : ℝ) ^ (-(a + 1)) = 1 := by
      rw [← Real.rpow_add (by norm_num), add_neg_cancel, Real.rpow_zero]
    have h5 : (2 : ℝ) ^ (a + 1) ≤ 8 := by
      have h6 : (2 : ℝ) ^ (a + 1) ≤ (2 : ℝ) ^ (3 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have h8 : (2 : ℝ) ^ (3 : ℝ) = 8 := by
        rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
        norm_num
      linarith
    have hq : 0 ≤ (1 + ‖c‖) ^ (-(a + 1)) := Real.rpow_nonneg hv.le _
    have h2p : 0 ≤ (2 : ℝ) ^ (a + 1) := Real.rpow_nonneg (by norm_num) _
    calc (1 + ‖w‖) ^ (-(a + 1)) = (2 : ℝ) ^ (a + 1) * (2 * (1 + ‖w‖)) ^ (-(a + 1)) := by
          rw [h3, ← mul_assoc, h4, one_mul]
      _ ≤ (2 : ℝ) ^ (a + 1) * (1 + ‖c‖) ^ (-(a + 1)) := mul_le_mul_of_nonneg_left h2 h2p
      _ ≤ 8 * (1 + ‖c‖) ^ (-(a + 1)) := mul_le_mul_of_nonneg_right h5 hq
  
  have hinc : ∀ c h : E3, ‖h‖ ≤ 1 / 2 →
      |f (c + h) - f c| ≤ 8 * A * (1 + ‖c‖) ^ (-(a + 1)) * ‖h‖ := by
    intro c h hh
    have hbd : ∀ w ∈ Metric.closedBall c (1 / 2),
        ‖fderiv ℝ f w‖ ≤ 8 * A * (1 + ‖c‖) ^ (-(a + 1)) := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw
      calc ‖fderiv ℝ f w‖ ≤ A * (1 + ‖w‖) ^ (-a - 1) := hf1 w
        _ ≤ A * (8 * (1 + ‖c‖) ^ (-(a + 1))) := mul_le_mul_of_nonneg_left (hweight c w hw) hA
        _ = 8 * A * (1 + ‖c‖) ^ (-(a + 1)) := by ring
    have hmem1 : c ∈ Metric.closedBall c (1 / 2) := Metric.mem_closedBall_self (by norm_num)
    have hmem2 : c + h ∈ Metric.closedBall c (1 / 2) := by
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
      exact hh
    have hmvt := (convex_closedBall c (1 / 2)).norm_image_sub_le_of_norm_fderiv_le
      (fun w _ => hf w) hbd hmem1 hmem2
    rw [add_sub_cancel_left, Real.norm_eq_abs] at hmvt
    exact hmvt
  
  have hrep : ∀ w : E3, ∫ y, k (w - y) * f y = ∫ z, k z * f (w - z) := by
    intro w
    have h := integral_sub_left_eq_self (fun z => k z * f (w - z)) (volume : Measure E3) w
    simp only [sub_sub_cancel] at h
    exact h
  
  have hpeetre : ∀ (p : ℝ) (w : E3), 0 ≤ p → 3 < p + 2 →
      Integrable (fun y : E3 => (1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-(2 : ℝ))) := by
    intro p w hp hp3
    have hr : ((Module.finrank ℝ E3 : ℕ) : ℝ) < p + 2 := by
      rw [finrank_euclideanSpace_fin]; push_cast; linarith
    have hbase : Integrable (fun y : E3 => (1 + ‖y‖) ^ (-(p + 2))) := integrable_one_add_norm hr
    have hsh : Integrable (fun y : E3 => (1 + ‖w - y‖) ^ (-(p + 2))) :=
      hbase.comp_sub_left w
    refine Integrable.mono' (hsh.const_mul ((1 + ‖w‖) ^ (2 : ℝ))) ?_ ?_
    · refine Continuous.aestronglyMeasurable (Continuous.mul ?_ ?_)
      · exact (continuous_const.add (continuous_const.sub continuous_id).norm).rpow_const
          (fun y => Or.inl (ne_of_gt (by positivity)))
      · exact (continuous_const.add continuous_norm).rpow_const
          (fun y => Or.inl (ne_of_gt (by positivity)))
    · refine Filter.Eventually.of_forall (fun y => ?_)
      have hu : 0 < 1 + ‖w - y‖ := by positivity
      have ht : 0 < 1 + ‖y‖ := by positivity
      have hs : 0 < 1 + ‖w‖ := by positivity
      have hus : 1 + ‖w - y‖ ≤ (1 + ‖w‖) * (1 + ‖y‖) := by
        have := norm_sub_le w y
        nlinarith [norm_nonneg w, norm_nonneg y, mul_nonneg (norm_nonneg w) (norm_nonneg y)]
      have key : (1 + ‖y‖) ^ (-(2 : ℝ)) ≤ (1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(2 : ℝ)) := by
        rw [Real.rpow_neg ht.le, Real.rpow_neg hu.le]
        simp only [Real.rpow_two]
        have hsq : (1 + ‖w - y‖) ^ 2 ≤ (1 + ‖y‖) ^ 2 * (1 + ‖w‖) ^ 2 := by
          have := mul_le_mul hus hus hu.le (by positivity)
          nlinarith
        calc ((1 + ‖y‖) ^ 2)⁻¹ ≤ ((1 + ‖w - y‖) ^ 2 / (1 + ‖w‖) ^ 2)⁻¹ :=
              inv_anti₀ (by positivity) (by rw [div_le_iff₀ (by positivity)]; exact hsq)
          _ = (1 + ‖w‖) ^ 2 * ((1 + ‖w - y‖) ^ 2)⁻¹ := by rw [inv_div, div_eq_mul_inv]
      rw [Real.norm_of_nonneg (by positivity)]
      calc (1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-(2 : ℝ))
          ≤ (1 + ‖w - y‖) ^ (-p) * ((1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(2 : ℝ))) :=
            mul_le_mul_of_nonneg_left key (by positivity)
        _ = (1 + ‖w‖) ^ (2 : ℝ) * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖w - y‖) ^ (-(2 : ℝ))) := by ring
        _ = (1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(p + 2)) := by
            rw [← Real.rpow_add hu, show -p + -(2 : ℝ) = -(p + 2) by ring]
  
  have hFint : ∀ w : E3, Integrable (fun z : E3 => k z * f (w - z)) := by
    intro w
    refine Integrable.mono'
      ((hpeetre a w (by linarith) (by linarith)).const_mul (M * A)) ?_ ?_
    · exact (hk.mul (hf.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun z => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      have h1 := hk0 z
      have h2 := hf0 (w - z)
      calc |k z| * |f (w - z)| ≤ (M * (1 + ‖z‖) ^ (-2 : ℝ)) * (A * (1 + ‖w - z‖) ^ (-a)) :=
            mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
        _ = M * A * ((1 + ‖w - z‖) ^ (-a) * (1 + ‖z‖) ^ (-(2 : ℝ))) := by ring
  
  have hlip : ∀ x' : E3, ‖x' - x‖ ≤ 1 / 2 →
      |(∫ z, k z * f (x' - z)) - ∫ z, k z * f (x - z)| ≤
        (8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ)) * ‖x' - x‖ := by
    intro x' hxx
    rw [← integral_sub (hFint x') (hFint x)]
    have hdom : Integrable (fun z : E3 => (8 * A * M * ‖x' - x‖) *
        ((1 + ‖x - z‖) ^ (-(a + 1)) * (1 + ‖z‖) ^ (-2 : ℝ))) :=
      (hpeetre (a + 1) x (by linarith) (by linarith)).const_mul _
    have hpt : ∀ z : E3, ‖k z * f (x' - z) - k z * f (x - z)‖ ≤
        (8 * A * M * ‖x' - x‖) * ((1 + ‖x - z‖) ^ (-(a + 1)) * (1 + ‖z‖) ^ (-2 : ℝ)) := by
      intro z
      rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
      have e : (x - z) + (x' - x) = x' - z := by abel
      have h1 := hk0 z
      have h2 := hinc (x - z) (x' - x) hxx
      rw [e] at h2
      calc |k z| * |f (x' - z) - f (x - z)| ≤ (M * (1 + ‖z‖) ^ (-2 : ℝ)) *
            (8 * A * (1 + ‖x - z‖) ^ (-(a + 1)) * ‖x' - x‖) :=
            mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
        _ = _ := by ring
    have hn := norm_integral_le_of_norm_le hdom (Filter.Eventually.of_forall hpt)
    rw [integral_const_mul, Real.norm_eq_abs] at hn
    calc _ ≤ _ := hn
      _ = _ := by ring
  
  have hev : ∀ᶠ x' in 𝓝 x,
      ‖(fun x : E3 => ∫ y, k (x - y) * f y) x' - (fun x : E3 => ∫ y, k (x - y) * f y) x‖ ≤
        (8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ)) * ‖x' - x‖ := by
    filter_upwards [Metric.closedBall_mem_nhds x (by norm_num : (0 : ℝ) < 1 / 2)] with x' hx'
    rw [Metric.mem_closedBall, dist_eq_norm] at hx'
    show ‖(∫ y, k (x' - y) * f y) - ∫ y, k (x - y) * f y‖ ≤ _
    rw [hrep x', hrep x, Real.norm_eq_abs]
    exact hlip x' hx'
  exact norm_fderiv_le_of_lip' ℝ hC hev

theorem approx_identity_residual (η f : E3 → ℝ) (a A M : ℝ) (ha : 1 < a) (ha2 : a < 2)
    (hA : 0 ≤ A) (hM : 0 ≤ M) (hηc : Continuous η) (hη0 : ∀ z : E3, 0 ≤ η z)
    (hηb : ∀ z : E3, η z ≤ M * (1 + ‖z‖) ^ (-7 : ℝ))
    (hf : Differentiable ℝ f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-a))
    (hf1 : ∀ y : E3, ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖) ^ (-a - 1)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E3,
      |(∫ z, η z) * f x - ∫ y, η (x - y) * f y| ≤ C * (1 + ‖x‖) ^ (-a - 1) :=
by
  
  have hinc : ∀ x z : E3,
      |f x - f (x - z)| ≤ A * (1 + ‖z‖) ^ (a + 2) * (1 + ‖x‖) ^ (-a - 1) := by
    intro x z
    have hQ : 0 < 1 + ‖z‖ := by positivity
    have hX : 0 < 1 + ‖x‖ := by positivity
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = A * (1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1) := ⟨_, rfl⟩
    have hK0 : 0 ≤ K := by
      rw [hK]
      exact mul_nonneg (mul_nonneg hA (Real.rpow_nonneg hQ.le _)) (Real.rpow_nonneg hX.le _)
    have hbd : ∀ w ∈ Metric.closedBall x ‖z‖, ‖fderiv ℝ f w‖ ≤ K := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw
      have hP : 0 < 1 + ‖w‖ := by positivity
      have h1 : ‖x‖ ≤ ‖w‖ + ‖z‖ := by
        have := norm_le_insert' x w
        rw [norm_sub_rev] at this
        linarith
      have hpeet : 1 + ‖x‖ ≤ (1 + ‖w‖) * (1 + ‖z‖) := by
        nlinarith [norm_nonneg w, norm_nonneg z, mul_nonneg (norm_nonneg w) (norm_nonneg z)]
      have h2 : (1 + ‖w‖) ^ (-a - 1) ≤ (1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1) := by
        have h3 : ((1 + ‖w‖) * (1 + ‖z‖)) ^ (-a - 1) ≤ (1 + ‖x‖) ^ (-a - 1) :=
          Real.rpow_le_rpow_of_nonpos hX hpeet (by linarith)
        rw [Real.mul_rpow hP.le hQ.le] at h3
        have h4 : (1 + ‖z‖) ^ (a + 1) * (1 + ‖z‖) ^ (-a - 1) = 1 := by
          rw [← Real.rpow_add hQ, show a + 1 + (-a - 1) = 0 by ring, Real.rpow_zero]
        have h5 : 0 ≤ (1 + ‖z‖) ^ (a + 1) := Real.rpow_nonneg hQ.le _
        calc (1 + ‖w‖) ^ (-a - 1)
            = (1 + ‖z‖) ^ (a + 1) * ((1 + ‖w‖) ^ (-a - 1) * (1 + ‖z‖) ^ (-a - 1)) := by
              rw [mul_comm ((1 + ‖w‖) ^ (-a - 1)), ← mul_assoc, h4, one_mul]
          _ ≤ _ := mul_le_mul_of_nonneg_left h3 h5
      calc ‖fderiv ℝ f w‖ ≤ A * (1 + ‖w‖) ^ (-a - 1) := hf1 w
        _ ≤ A * ((1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1)) :=
            mul_le_mul_of_nonneg_left h2 hA
        _ = K := by rw [hK]; ring
    have hmem1 : x - z ∈ Metric.closedBall x ‖z‖ := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      simp
    have hmem2 : x ∈ Metric.closedBall x ‖z‖ := Metric.mem_closedBall_self (norm_nonneg z)
    have hmvt := (convex_closedBall x ‖z‖).norm_image_sub_le_of_norm_fderiv_le
      (fun w _ => (hf w)) hbd hmem1 hmem2
    rw [Real.norm_eq_abs, sub_sub_cancel] at hmvt
    have h6 : K * ‖z‖ ≤ K * (1 + ‖z‖) := mul_le_mul_of_nonneg_left (by linarith) hK0
    have h7 : (1 + ‖z‖) ^ (a + 2) = (1 + ‖z‖) ^ (a + 1) * (1 + ‖z‖) := by
      rw [← Real.rpow_add_one hQ.ne', show a + 1 + 1 = a + 2 by ring]
    calc |f x - f (x - z)| ≤ K * ‖z‖ := hmvt
      _ ≤ K * (1 + ‖z‖) := h6
      _ = _ := by rw [hK, h7]; ring
  
  have hfr : (Module.finrank ℝ E3 : ℝ) = 3 := by simp [E3, finrank_euclideanSpace]
  have hW7 : Integrable (fun z : E3 => (1 + ‖z‖) ^ (-(7 : ℝ))) :=
    integrable_one_add_norm (by rw [hfr]; norm_num)
  have hηi : Integrable η := by
    refine (hW7.const_mul M).mono' hηc.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hη0 z)]
    exact hηb z
  have hWa : Integrable (fun z : E3 => (1 + ‖z‖) ^ (a - 5)) := by
    have h := integrable_one_add_norm (E := E3) (μ := volume) (r := 5 - a)
      (by rw [hfr]; linarith)
    rw [show a - 5 = -(5 - a) by ring]
    exact h
  have hfB : ∀ y : E3, |f y| ≤ A := by
    intro y
    have h1 : (1 + ‖y‖) ^ (-a) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith [norm_nonneg y]) (by linarith)
    calc |f y| ≤ A * (1 + ‖y‖) ^ (-a) := hf0 y
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left h1 hA
      _ = A := mul_one A
  
  have hident : ∀ x : E3, (∫ z, η z) * f x - ∫ y, η (x - y) * f y =
      ∫ z, η z * (f x - f (x - z)) := by
    intro x
    have htr : ∫ y, η (x - y) * f y = ∫ z, η z * f (x - z) := by
      have h := integral_sub_left_eq_self (fun y => η (x - y) * f y) (volume : Measure E3) x
      simp only [sub_sub_cancel] at h
      exact h.symm
    have I₁ : Integrable (fun z => η z * f x) := hηi.mul_const (f x)
    have I₂ : Integrable (fun z => η z * f (x - z)) := by
      refine (hηi.norm.mul_const A).mono'
        ((hηc.mul (hf.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable)
        (Filter.Eventually.of_forall fun z => ?_)
      rw [norm_mul, Real.norm_eq_abs (f (x - z))]
      exact mul_le_mul_of_nonneg_left (hfB _) (norm_nonneg _)
    rw [htr, ← integral_mul_const, ← integral_sub I₁ I₂]
    congr 1
    funext z
    ring
  
  have hJ0 : 0 ≤ ∫ z : E3, (1 + ‖z‖) ^ (a - 5) :=
    integral_nonneg (fun z => Real.rpow_nonneg (by positivity) _)
  refine ⟨M * A * ∫ z : E3, (1 + ‖z‖) ^ (a - 5), mul_nonneg (mul_nonneg hM hA) hJ0,
    fun x => ?_⟩
  rw [hident x, ← Real.norm_eq_abs]
  have hmaj : ∀ z : E3, ‖η z * (f x - f (x - z))‖ ≤
      M * A * (1 + ‖z‖) ^ (a - 5) * (1 + ‖x‖) ^ (-a - 1) := by
    intro z
    have hQ : 0 < 1 + ‖z‖ := by positivity
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hη0 z)]
    have h1 := mul_le_mul (hηb z) (hinc x z) (abs_nonneg _)
      (mul_nonneg hM (Real.rpow_nonneg hQ.le _))
    have h2 : (1 + ‖z‖) ^ (-7 : ℝ) * (1 + ‖z‖) ^ (a + 2) = (1 + ‖z‖) ^ (a - 5) := by
      rw [← Real.rpow_add hQ]
      congr 1
      ring
    calc η z * |f x - f (x - z)|
        ≤ M * (1 + ‖z‖) ^ (-7 : ℝ) * (A * (1 + ‖z‖) ^ (a + 2) * (1 + ‖x‖) ^ (-a - 1)) := h1
      _ = M * A * ((1 + ‖z‖) ^ (-7 : ℝ) * (1 + ‖z‖) ^ (a + 2)) * (1 + ‖x‖) ^ (-a - 1) := by
          ring
      _ = _ := by rw [h2]
  have hg : Integrable (fun z : E3 => M * A * (1 + ‖z‖) ^ (a - 5) * (1 + ‖x‖) ^ (-a - 1)) :=
    (hWa.const_mul (M * A)).mul_const _
  refine (norm_integral_le_of_norm_le hg (Filter.Eventually.of_forall hmaj)).trans ?_
  rw [integral_mul_const, integral_const_mul]

theorem ray_growth_bound (v : E3 → ℝ) (a B : ℝ) (ha2 : a < 2) (hB : 0 ≤ B)
    (hv : Differentiable ℝ v) (hv0 : v 0 = 0)
    (hdv : ∀ (w : E3) (i : Fin 3), |partialDeriv i v w| ≤ B * (1 + ‖w‖) ^ (1 - a)) (x : E3) :
    |v x| ≤ 3 * B / (2 - a) * (1 + ‖x‖) ^ (2 - a) :=
by
  have h2a : 0 < 2 - a := by linarith
  set r := ‖x‖ with hr
  have hr0 : 0 ≤ r := norm_nonneg x
  set c := 3 * B / (2 - a) with hc
  have hc0 : 0 ≤ c := div_nonneg (by linarith) h2a.le
  
  have hcoord : ∀ w : E3, |fderiv ℝ v w x| ≤ 3 * (r * (B * (1 + ‖w‖) ^ (1 - a))) := by
    intro w
    have hx : x = ∑ i : Fin 3, x i • e i := by
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr x]
      simp [EuclideanSpace.basisFun_apply]
    have hL : fderiv ℝ v w x = ∑ i : Fin 3, x i * partialDeriv i v w := by
      conv_lhs => rw [hx]
      rw [map_sum]
      simp only [map_smul, smul_eq_mul]
      rfl
    rw [hL, Fin.sum_univ_three]
    have hb : ∀ i : Fin 3, |x i * partialDeriv i v w| ≤ r * (B * (1 + ‖w‖) ^ (1 - a)) := by
      intro i
      rw [abs_mul]
      have h1 : |x i| ≤ r := by
        have := PiLp.norm_apply_le x i
        rwa [Real.norm_eq_abs] at this
      exact mul_le_mul h1 (hdv w i) (abs_nonneg _) hr0
    have t := abs_add_three (x 0 * partialDeriv 0 v w) (x 1 * partialDeriv 1 v w)
      (x 2 * partialDeriv 2 v w)
    linarith [hb 0, hb 1, hb 2]
  
  have hφ : ∀ t : ℝ, HasDerivAt (fun s : ℝ => v (s • x)) (fderiv ℝ v (t • x) x) t := by
    intro t
    have h1 : HasDerivAt (fun s : ℝ => s • x) ((1 : ℝ) • x) t := (hasDerivAt_id t).smul_const x
    have h2 := (hv (t • x)).hasFDerivAt.comp_hasDerivAt t h1
    rw [one_smul] at h2
    exact h2
  
  have hψ : ∀ t : ℝ, 0 ≤ t → HasDerivAt (fun s : ℝ => c * (1 + s * r) ^ (2 - a))
      (c * (r * (2 - a) * (1 + t * r) ^ (2 - a - 1))) t := by
    intro t ht
    have hg : HasDerivAt (fun s : ℝ => 1 + s * r) r t := by
      simpa using ((hasDerivAt_id t).mul_const r).const_add 1
    have hpos : (1 + t * r) ≠ 0 := by
      have := mul_nonneg ht hr0
      exact ne_of_gt (by linarith)
    exact (hg.rpow_const (p := 2 - a) (Or.inl hpos)).const_mul c
  
  have hbound : ∀ t ∈ Set.Ico (0 : ℝ) 1,
      ‖fderiv ℝ v (t • x) x‖ ≤ c * (r * (2 - a) * (1 + t * r) ^ (2 - a - 1)) := by
    intro t ht
    have h1 := hcoord (t • x)
    have hn : ‖t • x‖ = t * r := by rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
    rw [hn] at h1
    rw [Real.norm_eq_abs]
    have he : (2 - a - 1 : ℝ) = 1 - a := by ring
    rw [he]
    have hc2 : c * (2 - a) = 3 * B := by rw [hc]; field_simp
    calc |fderiv ℝ v (t • x) x| ≤ 3 * (r * (B * (1 + t * r) ^ (1 - a))) := h1
      _ = c * (r * (2 - a) * (1 + t * r) ^ (1 - a)) := by
        linear_combination (-(r * (1 + t * r) ^ (1 - a))) * hc2
  
  have key : ‖(fun s : ℝ => v (s • x)) 1‖ ≤ (fun s : ℝ => c * (1 + s * r) ^ (2 - a)) 1 :=
    image_norm_le_of_norm_deriv_right_le_deriv_boundary'
      (fun t _ => (hφ t).continuousAt.continuousWithinAt)
      (fun t _ => (hφ t).hasDerivWithinAt)
      (by simp [hv0, hc0])
      (fun t ht => (hψ t ht.1).continuousAt.continuousWithinAt)
      (fun t ht => (hψ t ht.1).hasDerivWithinAt)
      hbound
      (show (1 : ℝ) ∈ Set.Icc 0 1 from ⟨zero_le_one, le_rfl⟩)
  
  simp only [one_smul, one_mul, Real.norm_eq_abs] at key
  exact key

theorem smoothed_potential_C2 (f : E3 → ℝ) (a A : ℝ) (ha : 1 < a) (ha2 : a < 2) (hA : 0 ≤ A)
    (hf : Differentiable ℝ f)
    (hf0 : ∀ x : E3, |f x| ≤ A * (1 + ‖x‖) ^ (-a))
    (hf1 : ∀ x : E3, ‖fderiv ℝ f x‖ ≤ A * (1 + ‖x‖) ^ (-a - 1)) :
    ∃ (v : E3 → ℝ) (B : ℝ), 0 ≤ B ∧ Differentiable ℝ v ∧
      (∀ i : Fin 3, Differentiable ℝ (partialDeriv i v)) ∧
      ∀ x : E3, |v x| ≤ B * (1 + ‖x‖) ^ (2 - a) ∧
        (∀ i : Fin 3, |partialDeriv i v x| ≤ B * (1 + ‖x‖) ^ (1 - a)) ∧
        (∀ i j : Fin 3, |partialDeriv i (partialDeriv j v) x| ≤ B * (1 + ‖x‖) ^ (-a)) ∧
        |∑ i : Fin 3, partialDeriv i (partialDeriv i v) x + f x| ≤ B * (1 + ‖x‖) ^ (-a - 1) :=
by
  classical
  
  obtain ⟨K, hK⟩ : ∃ K : E3 → ℝ, ∀ z : E3,
      K z = (1 + ‖z‖ ^ 2) ^ (-(1 / 2 : ℝ)) + 1 / 2 * (1 + ‖z‖ ^ 2) ^ (-(3 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  obtain ⟨η, hη⟩ : ∃ η : E3 → ℝ, ∀ z : E3, η z = 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  obtain ⟨hKd, hKid, hK1, hK2, htr⟩ := spc2_kernel_facts K hK
  obtain ⟨hηc, hη0, hηb, hηi, hcpos⟩ := spc2_density_facts η hη
  have htr' : ∀ z : E3, ∑ i : Fin 3, partialDeriv i (partialDeriv i K) z = -η z := by
    intro z; rw [htr z, hη z]
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = ∫ z, η z := ⟨_, rfl⟩
  rw [← hc] at hcpos
  have hc0 : c ≠ 0 := ne_of_gt hcpos
  have hcinv : 0 ≤ c⁻¹ := inv_nonneg.mpr hcpos.le
  have hfc : Continuous f := hf.continuous
  have hKic : ∀ i : Fin 3, Continuous (partialDeriv i K) := fun i => (hKid i).continuous
  
  have hpd_le : ∀ (g : E3 → ℝ) (i : Fin 3) (z : E3), |partialDeriv i g z| ≤ ‖fderiv ℝ g z‖ := by
    intro g i z
    calc |partialDeriv i g z| = ‖fderiv ℝ g z (e i)‖ := by rw [Real.norm_eq_abs]; rfl
      _ ≤ ‖fderiv ℝ g z‖ * ‖e i‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ g z‖ := by simp [EuclideanSpace.norm_single]
  have hpd_add_const : ∀ (g : E3 → ℝ) (b : ℝ) (j : Fin 3) (x : E3),
      partialDeriv j (fun x => g x + b) x = partialDeriv j g x := by
    intro g b j x
    unfold partialDeriv
    rw [fderiv_add_const]
  have hpd_const_mul : ∀ (g : E3 → ℝ) (b : ℝ) (j : Fin 3) (x : E3), DifferentiableAt ℝ g x →
      partialDeriv j (fun x => b * g x) x = b * partialDeriv j g x := by
    intro g b j x hg
    unfold partialDeriv
    rw [fderiv_const_mul hg]
    rfl
  
  have hKi0 : ∀ (i : Fin 3) (z : E3), |partialDeriv i K z| ≤ 10 * (1 + ‖z‖) ^ (-2 : ℝ) :=
    fun i z => (hpd_le K i z).trans (hK1 z)
  have hKij0 : ∀ (i j : Fin 3) (z : E3),
      |partialDeriv j (partialDeriv i K) z| ≤ 60 * (1 + ‖z‖) ^ (-3 : ℝ) :=
    fun i j z => (hpd_le _ j z).trans (hK2 i z)
  
  have hpt : ∀ (k : E3 → ℝ) (p M : ℝ), (∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-p)) →
      ∀ w y : E3, ‖k (w - y) * f y‖ ≤ M * A * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-a)) := by
    intro k p M hkb w y
    rw [Real.norm_eq_abs, abs_mul]
    have h1 := hkb (w - y)
    calc |k (w - y)| * |f y| ≤ (M * (1 + ‖w - y‖) ^ (-p)) * (A * (1 + ‖y‖) ^ (-a)) :=
          mul_le_mul h1 (hf0 y) (abs_nonneg _) ((abs_nonneg _).trans h1)
      _ = M * A * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-a)) := by ring
  have hint : ∀ (k : E3 → ℝ) (p M : ℝ), 0 ≤ p → 3 < p + a → Measurable k →
      (∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-p)) → ∀ w : E3,
      Integrable (fun y => k (w - y) * f y) := by
    intro k p M hp hpa hk hkb w
    refine Integrable.mono' ((weight_peetre_integrable p a hp hpa w).const_mul (M * A)) ?_ ?_
    · exact ((hk.comp (measurable_const.sub measurable_id)).mul
        hfc.measurable).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun y => hpt k p M hkb w y)
  
  obtain ⟨C₂, hC₂, hconv2⟩ :=
    weight_conv_bound 2 a (by norm_num) (by norm_num) (by linarith) (by linarith) (by linarith)
  obtain ⟨C₃, hC₃, hconv3⟩ :=
    weight_conv_bound (a + 1) 2 (by linarith) (by linarith) (by norm_num) (by norm_num)
      (by linarith)
  obtain ⟨C₇, hC₇, hres⟩ :=
