    have hC' : sepCyl a y₀ r' δ ⊆ sepCyl a y₀ r δ := hcylmono a r δ r' δ hr'r le_rfl
    have hagree' : ∀ z ∈ sepCyl a y₀ r' δ, u' (sepPlaneProj a z) = u (sepPlaneProj a z) :=
      fun z hz => hagree z hz.1
    have sub1 : sepCyl a y₀ r' δ ∩ {z | z a < u' (sepPlaneProj a z)} ⊆
        sepCyl a y₀ r δ ∩ {z | z a < u (sepPlaneProj a z)} := by
      rintro z ⟨hz, hz'⟩
      refine ⟨hC' hz, ?_⟩
      show z a < u (sepPlaneProj a z)
