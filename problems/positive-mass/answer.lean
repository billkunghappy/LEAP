theorem eig_lift_smooth {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X) (P : EigPatchedSurface X S) (k : Fin P.n) (ζ : E2 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hc : HasCompactSupport ζ) (hs : tsupport ζ ⊆ P.W k) : ∃ Z : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => Z (P.param j x)) (P.W j)) ∧ (∀ q, q ∉ P.O k → Z q = 0) ∧ (∀ q ∈ P.O k, Z q = ζ (P.proj k q)) ∧ ∀ j, ∀ x ∈ P.W j, P.param j x ∉ P.param k '' tsupport ζ → ∀ᶠ x' in 𝓝 x, Z (P.param j x') = 0 :=
by
  classical
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  set F : Set X := P.param k '' tsupport ζ with hFdef
  have hFO : F ⊆ P.O k := by
    rintro _ ⟨y, hy, rfl⟩
    exact (hP1 k y (hs hy)).1
  have hFc : IsClosed F :=
    (hc.isCompact.image_of_continuousOn ((P.param_cont k).mono hs)).isClosed
  set Z : X → ℝ := fun q => if q ∈ P.O k then ζ (P.proj k q) else 0 with hZdef
  have hZ0 : ∀ q, q ∉ P.O k → Z q = 0 := fun q hq => by simp only [hZdef, if_neg hq]
  have hZf : ∀ q ∈ P.O k, Z q = ζ (P.proj k q) := fun q hq => by simp only [hZdef, if_pos hq]
  
  have hstar : ∀ q ∈ S, q ∉ F → Z q = 0 := by
    intro q hqS hqF
    by_cases hqO : q ∈ P.O k
    · have hq : q ∈ P.O k ∩ S := ⟨hqO, hqS⟩
      rw [← P.image_eq k] at hq
      obtain ⟨y, hy, hyq⟩ := hq
      rw [hZf q hqO, ← hyq, P.proj_param k y hy]
      by_contra hne
      exact hqF ⟨y, subset_tsupport ζ (Function.mem_support.mpr hne), hyq⟩
    · exact hZ0 q hqO
  
  have hNopen : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' Fᶜ) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) hFc.isOpen_compl
  have hNzero : ∀ j, ∀ x' ∈ P.W j ∩ P.param j ⁻¹' Fᶜ, Z (P.param j x') = 0 := by
    intro j x' hx'
    exact hstar _ (hP1 j x' hx'.1).2 hx'.2
  refine ⟨Z, ?_, hZ0, hZf, ?_⟩
  · intro j
    refine contDiffOn_of_locally_contDiffOn (fun x hx => ?_)
    by_cases hxO : P.param j x ∈ P.O k
    · refine ⟨P.W j ∩ P.param j ⁻¹' P.O k,
        (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k), ⟨hx, hxO⟩, ?_⟩
      have h1 : ContDiffOn ℝ ∞ (fun x' => ζ (P.proj k (P.param j x')))
          (P.W j ∩ P.param j ⁻¹' P.O k) := hζ.comp_contDiffOn (P.trans_smooth j k)
      refine (h1.mono Set.inter_subset_right).congr ?_
      intro y hy
      exact hZf _ hy.2.2
    · have hxF : P.param j x ∉ F := fun h => hxO (hFO h)
      refine ⟨P.W j ∩ P.param j ⁻¹' Fᶜ, hNopen j, ⟨hx, hxF⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
      intro y hy
      exact hNzero j y hy.2
  · intro j x hx hxF
    exact Filter.eventually_of_mem ((hNopen j).mem_nhds ⟨hx, hxF⟩) (hNzero j)

theorem eig_partition_unity {X : Type*} [TopologicalSpace X] (S : Set X) (hS : IsCompact S) (P : EigPatchedSurface X S) (hlift : ∀ (k : Fin P.n) (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W k → ∃ Z : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => Z (P.param j x)) (P.W j)) ∧ (∀ q, q ∉ P.O k → Z q = 0) ∧ (∀ q ∈ P.O k, Z q = ζ (P.proj k q)) ∧ ∀ j, ∀ x ∈ P.W j, P.param j x ∉ P.param k '' tsupport ζ → ∀ᶠ x' in 𝓝 x, Z (P.param j x') = 0) : ∃ (ρ : Fin P.n → X → ℝ) (K : Fin P.n → Set E2), (∀ j q, 0 ≤ ρ j q) ∧ (∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k)) ∧ (∀ q ∈ S, ∑ j, ρ j q = 1) ∧ (∀ j, IsCompact (K j) ∧ K j ⊆ P.W j) ∧ (∀ j, ∀ x ∈ P.W j, x ∉ K j → ρ j (P.param j x) = 0) ∧ (∀ j q, q ∉ P.O j → ρ j q = 0) :=
by
  classical
  have hF1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  
  have hpt : ∀ q : S, ∃ (j : Fin P.n) (f : E2 → ℝ), (q : X) ∈ P.O j ∧ ContDiff ℝ ∞ f ∧
      HasCompactSupport f ∧ tsupport f ⊆ P.W j ∧ (∀ x, 0 ≤ f x) ∧ f (P.proj j q) = 1 := by
    rintro ⟨q, hq⟩
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hq)
    have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hj, hq⟩
    obtain ⟨x, hx, hxq⟩ := hq'
    obtain ⟨f, hfs, hfc, hfd, hfr, hf1⟩ :=
      exists_contDiff_tsupport_subset (n := (⊤ : ℕ∞)) ((P.W_open j).mem_nhds hx)
    refine ⟨j, f, hj, hfd, hfc, hfs, fun y => (hfr ⟨y, rfl⟩).1, ?_⟩
    show f (P.proj j q) = 1
    rw [← hxq, P.proj_param j x hx]
    exact hf1
  choose J F hJO hFs hFc hFW hFnn hF1' using hpt
  obtain ⟨U, hU⟩ : ∃ U : S → Set X, ∀ q, U q = P.O (J q) ∩ P.proj (J q) ⁻¹' {y | 0 < F q y} :=
    ⟨fun q => P.O (J q) ∩ P.proj (J q) ⁻¹' {y | 0 < F q y}, fun _ => rfl⟩
  have hUo : ∀ q, IsOpen (U q) := by
    intro q
    rw [hU]
    exact (P.proj_cont (J q)).isOpen_inter_preimage (P.O_open (J q))
      (isOpen_lt continuous_const (hFs q).continuous)
  have hcov : S ⊆ ⋃ q, U q := by
    intro q hq
    refine Set.mem_iUnion.2 ⟨⟨q, hq⟩, ?_⟩
    rw [hU]
    refine ⟨hJO ⟨q, hq⟩, ?_⟩
    show 0 < F ⟨q, hq⟩ (P.proj (J ⟨q, hq⟩) q)
    rw [hF1' ⟨q, hq⟩]
    exact one_pos
  obtain ⟨t, ht⟩ := hS.elim_finite_subcover U hUo hcov
  obtain ⟨ζ, hζ⟩ : ∃ ζ : Fin P.n → E2 → ℝ, ∀ j y,
      ζ j y = ∑ q ∈ t.filter (fun q => J q = j), F q y :=
    ⟨fun j y => ∑ q ∈ t.filter (fun q => J q = j), F q y, fun _ _ => rfl⟩
  have hζfun : ∀ j, ζ j = fun y => ∑ q ∈ t.filter (fun q => J q = j), F q y :=
    fun j => funext (hζ j)
  have hζs : ∀ j, ContDiff ℝ ∞ (ζ j) := by
    intro j
    rw [hζfun j]
    exact ContDiff.sum (fun q _ => hFs q)
  have hζT : ∀ j, tsupport (ζ j) ⊆ ⋃ q ∈ t.filter (fun q => J q = j), tsupport (F q) := by
    intro j
    refine closure_minimal ?_ (isClosed_biUnion_finset (fun q _ => isClosed_tsupport _))
    intro y hy
    rw [Function.mem_support, hζ] at hy
    obtain ⟨q, hq, hqy⟩ := Finset.exists_ne_zero_of_sum_ne_zero hy
    exact Set.mem_biUnion hq (subset_tsupport _ hqy)
  have hζW : ∀ j, tsupport (ζ j) ⊆ P.W j := by
    intro j
    refine (hζT j).trans ?_
    intro y hy
    simp only [Set.mem_iUnion] at hy
    obtain ⟨q, hq, hyq⟩ := hy
    have hJ : J q = j := (Finset.mem_filter.1 hq).2
    rw [← hJ]
    exact hFW q hyq
  have hζc : ∀ j, HasCompactSupport (ζ j) := by
    intro j
    exact ((t.filter (fun q => J q = j)).isCompact_biUnion (fun q _ => hFc q)).of_isClosed_subset
      (isClosed_tsupport _) (hζT j)
  have hζnn : ∀ j x, 0 ≤ ζ j x := by
    intro j x
    rw [hζ]
    exact Finset.sum_nonneg (fun q _ => hFnn q x)
  have hζcov : ∀ q ∈ S, ∃ j, q ∈ P.O j ∧ 0 < ζ j (P.proj j q) := by
    intro q hq
    have hq2 := ht hq
    simp only [Set.mem_iUnion] at hq2
    obtain ⟨q₀, hq₀t, hqU⟩ := hq2
    rw [hU] at hqU
    refine ⟨J q₀, hqU.1, ?_⟩
    have hmem : q₀ ∈ t.filter (fun q => J q = J q₀) := Finset.mem_filter.2 ⟨hq₀t, rfl⟩
    have hlt : 0 < F q₀ (P.proj (J q₀) q) := hqU.2
    calc (0 : ℝ) < F q₀ (P.proj (J q₀) q) := hlt
      _ ≤ ∑ q' ∈ t.filter (fun q => J q = J q₀), F q' (P.proj (J q₀) q) :=
          Finset.single_le_sum (f := fun q' => F q' (P.proj (J q₀) q))
            (fun q' _ => hFnn q' _) hmem
      _ = ζ (J q₀) (P.proj (J q₀) q) := (hζ _ _).symm
  
  have hL := fun j => hlift j (ζ j) (hζs j) (hζc j) (hζW j)
  choose Z hZs hZ0 hZf _ using hL
  have hZnn : ∀ j q, 0 ≤ Z j q := by
    intro j q
    by_cases hq : q ∈ P.O j
    · rw [hZf j q hq]
      exact hζnn _ _
    · rw [hZ0 j q hq]
  have hσpos : ∀ q ∈ S, 0 < ∑ i, Z i q := by
    intro q hq
    obtain ⟨j, hjO, hlt⟩ := hζcov q hq
    have h1 : 0 < Z j q := by
      rw [hZf j q hjO]
      exact hlt
    exact lt_of_lt_of_le h1 (Finset.single_le_sum (f := fun i => Z i q)
      (fun i _ => hZnn i q) (Finset.mem_univ j))
  refine ⟨fun j q => Z j q / ∑ i, Z i q, fun j => tsupport (ζ j), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro j q
    exact div_nonneg (hZnn j q) (Finset.sum_nonneg (fun i _ => hZnn i q))
  · intro j k
    refine (hZs j k).div (ContDiffOn.sum (fun i _ => hZs i k)) ?_
    intro x hx
    exact (hσpos _ (hF1 k x hx).2).ne'
  · intro q hq
    rw [← Finset.sum_div]
    exact div_self (hσpos q hq).ne'
  · intro j
    exact ⟨hζc j, hζW j⟩
  · intro j x hx hxK
    show Z j (P.param j x) / _ = 0
    rw [hZf j _ (hF1 j x hx).1, P.proj_param j x hx, image_eq_zero_of_notMem_tsupport hxK,
      zero_div]
  · intro j q hq
    show Z j q / _ = 0
    rw [hZ0 j q hq, zero_div]

theorem eig_chart_cov {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (j k : Fin P.n) (G : E2 → ℝ) : (∫ x in P.W j ∩ P.param j ⁻¹' P.O k, G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) = (∫ y in P.W k ∩ P.param k ⁻¹' P.O j, G y * Real.sqrt (P.h k y).det) ∧ (MeasureTheory.IntegrableOn (fun x => G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume ↔ MeasureTheory.IntegrableOn (fun y => G y * Real.sqrt (P.h k y).det) (P.W k ∩ P.param k ⁻¹' P.O j) MeasureTheory.volume) :=
by
  classical
  
  have hF : ∀ i, ∀ x ∈ P.W i, P.param i x ∈ P.O i ∩ S := fun i x hx => by
    rw [← P.image_eq i]; exact ⟨x, hx, rfl⟩
  
  have hG : ∀ i, ∀ q ∈ P.O i ∩ S, P.proj i q ∈ P.W i ∧ P.param i (P.proj i q) = q := by
    intro i q hq
    rw [← P.image_eq i] at hq
    obtain ⟨y, hy, rfl⟩ := hq
    rw [P.proj_param i y hy]
    exact ⟨hy, rfl⟩
  have hAo : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  have hAm : MeasurableSet (P.W j ∩ P.param j ⁻¹' P.O k) := hAo.measurableSet
  have hK : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, P.proj k (P.param j x) ∈ P.W k ∧
      P.param k (P.proj k (P.param j x)) = P.param j x :=
    fun x hx => hG k _ ⟨hx.2, (hF j x hx.1).2⟩
  
  have hinj : Set.InjOn (fun x => P.proj k (P.param j x)) (P.W j ∩ P.param j ⁻¹' P.O k) := by
    intro x hx x' hx' hxx
    have hxx' : P.proj k (P.param j x) = P.proj k (P.param j x') := hxx
    have h1 : P.param j x = P.param j x' := by
      rw [← (hK x hx).2, ← (hK x' hx').2, hxx']
    rw [← P.proj_param j x hx.1, ← P.proj_param j x' hx'.1, h1]
  
  have himg : (fun x => P.proj k (P.param j x)) '' (P.W j ∩ P.param j ⁻¹' P.O k) =
      P.W k ∩ P.param k ⁻¹' P.O j := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      refine ⟨(hK x hx).1, ?_⟩
      show P.param k (P.proj k (P.param j x)) ∈ P.O j
      rw [(hK x hx).2]
      exact (hF j x hx.1).1
    · rintro ⟨hy, hyO⟩
      obtain ⟨hxW, hxq⟩ := hG j (P.param k y) ⟨hyO, (hF k y hy).2⟩
      refine ⟨P.proj j (P.param k y), ⟨hxW, ?_⟩, ?_⟩
      · show P.param j (P.proj j (P.param k y)) ∈ P.O k
        rw [hxq]
        exact (hF k y hy).1
      · show P.proj k (P.param j (P.proj j (P.param k y))) = y
        rw [hxq, P.proj_param k y hy]
  
  have hdiff : ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      HasFDerivWithinAt (fun x => P.proj k (P.param j x))
        (fderiv ℝ (fun x => P.proj k (P.param j x)) x) (P.W j ∩ P.param j ⁻¹' P.O k) x := by
    intro x hx
    have hd : DifferentiableOn ℝ (fun x => P.proj k (P.param j x))
        (P.W j ∩ P.param j ⁻¹' P.O k) :=
      (P.trans_smooth j k).differentiableOn (by simp)
    exact ((hd x hx).differentiableAt (hAo.mem_nhds hx)).hasFDerivAt.hasFDerivWithinAt
  
  have hjac : ∀ (f : E2 →L[ℝ] E2) (H H' : Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, H' a b = ∑ c : Fin 2, ∑ d : Fin 2, f (e2 a) c * H c d * f (e2 b) d) →
      Real.sqrt H'.det = |f.det| * Real.sqrt H.det := by
    intro f H H' hc
    have hdet : f.det = f (e2 0) 0 * f (e2 1) 1 - f (e2 1) 0 * f (e2 0) 1 := by
      change LinearMap.det (f : E2 →ₗ[ℝ] E2) = _
      rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis, Matrix.det_fin_two]
      simp [LinearMap.toMatrix_apply, EuclideanSpace.basisFun_apply, e2]
    have hH' : H'.det = f.det ^ 2 * H.det := by
      rw [Matrix.det_fin_two, Matrix.det_fin_two, hc 0 0, hc 0 1, hc 1 0, hc 1 1, hdet]
      simp only [Fin.sum_univ_two]
      ring
    rw [hH', Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  have hpt : Set.EqOn (fun x => G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det)
      (fun x => |(fderiv ℝ (fun x => P.proj k (P.param j x)) x).det| •
        (fun y => G y * Real.sqrt (P.h k y).det) (P.proj k (P.param j x)))
      (P.W j ∩ P.param j ⁻¹' P.O k) := by
    intro x hx
    simp only [smul_eq_mul]
    rw [hjac _ _ _ (P.h_compat j k x hx)]
    ring
  constructor
  · have h1 := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hAm hdiff hinj
      (fun y => G y * Real.sqrt (P.h k y).det)
    rw [himg] at h1
    exact (setIntegral_congr_fun hAm hpt).trans h1.symm
  · have h2 := MeasureTheory.integrableOn_image_iff_integrableOn_abs_det_fderiv_smul volume hAm
      hdiff hinj (fun y => G y * Real.sqrt (P.h k y).det)
    rw [himg] at h2
    exact (integrableOn_congr_fun hpt hAm).trans h2.symm

theorem eig_grad_pair_compat {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (u v : X → ℝ) (hu : ∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) (hv : ∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j)) (j k : Fin P.n) (x : E2) (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) : eigGam P u v j x = eigGam P u v k (P.proj k (P.param j x)) :=
by
  classical
  
  have hD : IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) :=
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  
  have hP3 : ∀ x' ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x') ∈ P.W k ∧ P.param k (P.proj k (P.param j x')) = P.param j x' := by
    intro x' hx'
    have h1 : P.param j x' ∈ P.O j ∩ S := by
      rw [← P.image_eq j]; exact ⟨x', hx'.1, rfl⟩
    have h2 : P.param j x' ∈ P.param k '' P.W k := by
      rw [P.image_eq k]; exact ⟨hx'.2, h1.2⟩
    obtain ⟨y', hy', hyeq⟩ := h2
    rw [← hyeq, P.proj_param k y' hy']
    exact ⟨hy', rfl⟩
  have hτd : DifferentiableAt ℝ (fun x' => P.proj k (P.param j x')) x :=
    ((P.trans_smooth j k).contDiffAt (hD.mem_nhds hx)).differentiableAt (by simp)
  have hyW : P.proj k (P.param j x) ∈ P.W k := (hP3 x hx).1
  
  have chain : ∀ (w : X → ℝ), (∀ i, ContDiffOn ℝ ∞ (fun x => w (P.param i x)) (P.W i)) →
      ∀ b : Fin 2, pd2 b (fun x' => w (P.param j x')) x =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c *
          pd2 c (fun y => w (P.param k y)) (P.proj k (P.param j x)) := by
    intro w hw b
    have hfd : DifferentiableAt ℝ (fun y => w (P.param k y)) (P.proj k (P.param j x)) :=
      ((hw k).contDiffAt ((P.W_open k).mem_nhds hyW)).differentiableAt (by simp)
    have hev : (fun x' => w (P.param j x')) =ᶠ[𝓝 x]
        ((fun y => w (P.param k y)) ∘ (fun x' => P.proj k (P.param j x'))) :=
      Filter.eventually_of_mem (hD.mem_nhds hx)
        (fun x' hx' => by simp only [Function.comp, (hP3 x' hx').2])
    unfold pd2
    rw [hev.fderiv_eq, fderiv_comp x hfd hτd, ContinuousLinearMap.comp_apply]
    have hw' : fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) =
        ∑ c : Fin 2, fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 b) c • e2 c := by
      ext i
      fin_cases i <;> simp [e2, Fin.sum_univ_two, EuclideanSpace.single_apply]
    conv_lhs => rw [hw']
    simp only [map_sum, map_smul, smul_eq_mul]
  
  set J : Matrix (Fin 2) (Fin 2) ℝ :=
    Matrix.of fun c a => fderiv ℝ (fun x' => P.proj k (P.param j x')) x (e2 a) c with hJ
  have hKJ : P.h j x = J.transpose * P.h k (P.proj k (P.param j x)) * J := by
    ext a b
    rw [P.h_compat j k x hx a b]
    simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply, Fin.sum_univ_two]
    ring
  have hdetK : 0 < (P.h j x).det := (P.h_posDef j x hx.1).det_pos
  have hJdet : IsUnit J.det := by
    rw [isUnit_iff_ne_zero]
    intro h0
    have : (P.h j x).det = 0 := by
      rw [hKJ, Matrix.det_mul, Matrix.det_mul, h0]; simp
    linarith
  have hJTdet : IsUnit J.transpose.det := by rwa [Matrix.det_transpose]
  have hinv : J * (P.h j x)⁻¹ * J.transpose = (P.h k (P.proj k (P.param j x)))⁻¹ := by
    rw [hKJ, Matrix.mul_inv_rev, Matrix.mul_inv_rev, ← Matrix.mul_assoc J J⁻¹,
      Matrix.mul_nonsing_inv J hJdet, Matrix.one_mul, Matrix.mul_assoc,
      Matrix.nonsing_inv_mul J.transpose hJTdet, Matrix.mul_one]
  have e : ∀ d c : Fin 2, (J * (P.h j x)⁻¹ * J.transpose) d c =
      (P.h k (P.proj k (P.param j x)))⁻¹ d c := fun d c => by rw [hinv]
  have e00 := e 0 0
  have e01 := e 0 1
  have e10 := e 1 0
  have e11 := e 1 1
  simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
    Fin.sum_univ_two] at e00 e01 e10 e11
  simp only [eigGam, Fin.sum_univ_two]
  rw [chain u hu 0, chain u hu 1, chain v hv 0, chain v hv 1]
  simp only [Fin.sum_univ_two]
  linear_combination
    (pd2 0 (fun y => u (P.param k y)) (P.proj k (P.param j x)) *
      pd2 0 (fun y => v (P.param k y)) (P.proj k (P.param j x))) * e00 +
    (pd2 1 (fun y => u (P.param k y)) (P.proj k (P.param j x)) *
      pd2 0 (fun y => v (P.param k y)) (P.proj k (P.param j x))) * e01 +
    (pd2 0 (fun y => u (P.param k y)) (P.proj k (P.param j x)) *
      pd2 1 (fun y => v (P.param k y)) (P.proj k (P.param j x))) * e10 +
    (pd2 1 (fun y => u (P.param k y)) (P.proj k (P.param j x)) *
      pd2 1 (fun y => v (P.param k y)) (P.proj k (P.param j x))) * e11

theorem eig_integral_localize {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (K : Fin P.n → Set E2) (hρnn : ∀ j q, 0 ≤ ρ j q) (hρc : ∀ j k, ContinuousOn (fun x => ρ j (P.param k x)) (P.W k)) (hρ1 : ∀ q ∈ S, ∑ j, ρ j q = 1) (hK : ∀ j, IsCompact (K j) ∧ K j ⊆ P.W j) (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ K j → ρ j (P.param j x) = 0) (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0) (k : Fin P.n) (hcov : ∀ (j : Fin P.n) (G : E2 → ℝ), (∫ x in P.W j ∩ P.param j ⁻¹' P.O k, G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) = (∫ y in P.W k ∩ P.param k ⁻¹' P.O j, G y * Real.sqrt (P.h k y).det) ∧ (MeasureTheory.IntegrableOn (fun x => G (P.proj k (P.param j x)) * Real.sqrt (P.h j x).det) (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume ↔ MeasureTheory.IntegrableOn (fun y => G y * Real.sqrt (P.h k y).det) (P.W k ∩ P.param k ⁻¹' P.O j) MeasureTheory.volume)) (F : Fin P.n → E2 → ℝ) (hF : ∀ j, ContinuousOn (F j) (P.W j)) (hcompat : ∀ j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k, F j x = F k (P.proj k (P.param j x))) : (∀ L : Set E2, IsCompact L → L ⊆ P.W k → (∀ j, ∀ x ∈ P.W j, P.param j x ∉ P.param k '' L → F j x = 0) → eigWInt P ρ F = ∫ x in P.W k, F k x * Real.sqrt (P.h k x).det) ∧ ((∀ j, ∀ x ∈ P.W j, 0 ≤ F j x) → ∀ L : Set E2, IsCompact L → L ⊆ P.W k → ∫ x in L, F k x * Real.sqrt (P.h k x).det ≤ eigWInt P ρ F) :=
by
  classical
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  
  have hP3 : ∀ j, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j x hx
    have hq : P.param j x ∈ P.O k ∩ S := ⟨hx.2, (hP1 j x hx.1).2⟩
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, hyx⟩ := hq
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  
  have s1 : ∀ (W L : Set E2), IsOpen W → IsCompact L → L ⊆ W →
      ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
        (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) →
      ∀ (r G : E2 → ℝ), ContinuousOn r W → ContinuousOn G W →
        (∀ x ∈ W, x ∉ L → r x * G x = 0) →
      MeasureTheory.IntegrableOn (fun x => r x * G x * Real.sqrt (h x).det) W
        MeasureTheory.volume := by
    intro W L hW hL hLW h hh r G hr hG h0
    have hdet : ContinuousOn (fun x => (h x).det) W := by
      have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
        funext x
        exact Matrix.det_fin_two (h x)
      rw [e]
      exact ((hh 0 0).continuousOn.mul (hh 1 1).continuousOn).sub
        ((hh 0 1).continuousOn.mul (hh 1 0).continuousOn)
    have hc : ContinuousOn (fun x => r x * G x * Real.sqrt (h x).det) W :=
      (hr.mul hG).mul hdet.sqrt
    have hiL : MeasureTheory.IntegrableOn (fun x => r x * G x * Real.sqrt (h x).det) L
        MeasureTheory.volume :=
      (hc.mono hLW).integrableOn_compact hL
    refine hiL.of_forall_diff_eq_zero hW.measurableSet ?_
    intro x hx
    show r x * G x * Real.sqrt (h x).det = 0
    rw [h0 x hx.1 hx.2, zero_mul]
  
  have hAo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' P.O k) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (P.O_open k)
  
  have s2 : ∀ j,
      (∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
          ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
        (∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) ∧
      (MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
          (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume →
        MeasureTheory.IntegrableOn
          (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) (P.W k)
          MeasureTheory.volume) := by
    intro j
    obtain ⟨hc1, hc2⟩ := hcov j (fun y => ρ j (P.param k y) * F k y)
    have hEq : Set.EqOn (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
        (fun x => ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
          Real.sqrt (P.h j x).det)
        (P.W j ∩ P.param j ⁻¹' P.O k) := by
      intro x hx
      show ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det =
        ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
          Real.sqrt (P.h j x).det
      rw [(hP3 j x hx).2, hcompat j x hx]
    have hzero : ∀ y ∈ P.W k \ (P.W k ∩ P.param k ⁻¹' P.O j),
        ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det = 0 := by
      intro y hy
      have hy' : P.param k y ∉ P.O j := fun h => hy.2 ⟨hy.1, h⟩
      rw [hρO j _ hy', zero_mul, zero_mul]
    refine ⟨?_, fun hi => ?_⟩
    · calc (∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
            ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
          = ∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
              ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
                Real.sqrt (P.h j x).det :=
            MeasureTheory.setIntegral_congr_fun (hAo j).measurableSet hEq
        _ = ∫ y in P.W k ∩ P.param k ⁻¹' P.O j,
              ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det := hc1
        _ = ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
            (MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
              (P.W_open k).measurableSet Set.inter_subset_left hzero).symm
    · have hi' : MeasureTheory.IntegrableOn
          (fun x => ρ j (P.param k (P.proj k (P.param j x))) * F k (P.proj k (P.param j x)) *
            Real.sqrt (P.h j x).det) (P.W j ∩ P.param j ⁻¹' P.O k) MeasureTheory.volume :=
        hi.congr_fun hEq (hAo j).measurableSet
      have h1 : MeasureTheory.IntegrableOn
          (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det)
          (P.W k ∩ P.param k ⁻¹' P.O j) MeasureTheory.volume := hc2.mp hi'
      exact h1.of_forall_diff_eq_zero (P.W_open k).measurableSet hzero
  
  have hP7 : ∀ y ∈ P.W k,
      (∑ j, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) =
        F k y * Real.sqrt (P.h k y).det := by
    intro y hy
    rw [← Finset.sum_mul, ← Finset.sum_mul, hρ1 _ (hP1 k y hy).2, one_mul]
  refine ⟨fun L hL hLW hL0 => ?_, fun hF0 L hL hLW => ?_⟩
  · 
    have hPL : ∀ y ∈ P.W k, y ∉ L → P.param k y ∉ P.param k '' L := by
      rintro y hy hyL ⟨y', hy', heq⟩
      apply hyL
      have e := congrArg (P.proj k) heq
      rw [P.proj_param k y' (hLW hy'), P.proj_param k y hy] at e
      rw [← e]
      exact hy'
    have hgi : ∀ j, MeasureTheory.IntegrableOn
        (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) (P.W k)
        MeasureTheory.volume := by
      intro j
      exact s1 (P.W k) L (P.W_open k) hL hLW (P.h k) (P.h_smooth k)
        (fun y => ρ j (P.param k y)) (F k) (hρc j k) (hF k)
        (fun y hy hyL => by
          show ρ j (P.param k y) * F k y = 0
          rw [hL0 k y hy (hPL y hy hyL), mul_zero])
    have hWj : ∀ j, (∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) =
        ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det := by
      intro j
      rw [← (s2 j).1]
      apply MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero
        (P.W_open j).measurableSet Set.inter_subset_left
      intro x hx
      have hxO : P.param j x ∉ P.O k := fun h => hx.2 ⟨hx.1, h⟩
      have hxL : P.param j x ∉ P.param k '' L := by
        rintro ⟨y', hy', heq⟩
        apply hxO
        rw [← heq]
        exact (hP1 k y' (hLW hy')).1
      rw [hL0 j x hx.1 hxL, mul_zero, zero_mul]
    have hswap := MeasureTheory.integral_finset_sum (μ := MeasureTheory.volume.restrict (P.W k))
      Finset.univ (fun j _ => hgi j)
    calc eigWInt P ρ F
        = ∑ j, ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := rfl
      _ = ∑ j, ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
          Finset.sum_congr rfl (fun j _ => hWj j)
      _ = ∫ y in P.W k, ∑ j, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
          hswap.symm
      _ = ∫ x in P.W k, F k x * Real.sqrt (P.h k x).det :=
          MeasureTheory.setIntegral_congr_fun (P.W_open k).measurableSet hP7
  · 
    have hfnn : ∀ j, ∀ x ∈ P.W j, 0 ≤ ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
      fun j x hx => mul_nonneg (mul_nonneg (hρnn _ _) (hF0 j x hx)) (Real.sqrt_nonneg _)
    have hgnn : ∀ j, ∀ y ∈ P.W k, 0 ≤ ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
      fun j y hy => mul_nonneg (mul_nonneg (hρnn _ _) (hF0 k y hy)) (Real.sqrt_nonneg _)
    have hfi : ∀ j, MeasureTheory.IntegrableOn
        (fun x => ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det) (P.W j)
        MeasureTheory.volume := by
      intro j
      exact s1 (P.W j) (K j) (P.W_open j) (hK j).1 (hK j).2 (P.h j) (P.h_smooth j)
        (fun x => ρ j (P.param j x)) (F j) (hρc j j) (hF j)
        (fun x hx hxK => by
          show ρ j (P.param j x) * F j x = 0
          rw [hρK j x hx hxK, zero_mul])
    have hgi : ∀ j, MeasureTheory.IntegrableOn
        (fun y => ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) (P.W k)
        MeasureTheory.volume := fun j => (s2 j).2 ((hfi j).mono_set Set.inter_subset_left)
    have hle : ∀ j,
        (∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det) ≤
          ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := by
      intro j
      calc (∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det)
          ≤ ∫ y in P.W k, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
            MeasureTheory.setIntegral_mono_set (hgi j)
              (MeasureTheory.ae_restrict_of_forall_mem (P.W_open k).measurableSet (hgnn j))
              (Filter.Eventually.of_forall (fun x (hx : x ∈ L) => hLW hx))
        _ = ∫ x in P.W j ∩ P.param j ⁻¹' P.O k,
              ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det := (s2 j).1.symm
        _ ≤ ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
            MeasureTheory.setIntegral_mono_set (hfi j)
              (MeasureTheory.ae_restrict_of_forall_mem (P.W_open j).measurableSet (hfnn j))
              (Filter.Eventually.of_forall
                (fun x (hx : x ∈ P.W j ∩ P.param j ⁻¹' P.O k) => hx.1))
    have hswap := MeasureTheory.integral_finset_sum (μ := MeasureTheory.volume.restrict L)
      Finset.univ (fun j _ => (hgi j).mono_set hLW)
    calc (∫ x in L, F k x * Real.sqrt (P.h k x).det)
        = ∫ y in L, ∑ j, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det :=
          MeasureTheory.setIntegral_congr_fun hL.measurableSet
            (fun y hy => (hP7 y (hLW hy)).symm)
      _ = ∑ j, ∫ y in L, ρ j (P.param k y) * F k y * Real.sqrt (P.h k y).det := hswap
      _ ≤ ∑ j, ∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det :=
          Finset.sum_le_sum (fun j _ => hle j)
      _ = eigWInt P ρ F := rfl

theorem eig_wint_facts {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (K : Fin P.n → Set E2) (hρnn : ∀ j q, 0 ≤ ρ j q) (hρc : ∀ j, ContinuousOn (fun x => ρ j (P.param j x)) (P.W j)) (hK : ∀ j, IsCompact (K j) ∧ K j ⊆ P.W j) (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ K j → ρ j (P.param j x) = 0) : (∀ (F G H : Fin P.n → E2 → ℝ), (∀ j, ContinuousOn (F j) (P.W j)) → (∀ j, ContinuousOn (G j) (P.W j)) → (∀ j, ContinuousOn (H j) (P.W j)) → ∀ a b c : ℝ, eigWInt P ρ (fun j x => a * F j x + b * G j x + c * H j x) = a * eigWInt P ρ F + b * eigWInt P ρ G + c * eigWInt P ρ H) ∧ (∀ (F : Fin P.n → E2 → ℝ) (a : ℝ), eigWInt P ρ (fun j x => a * F j x) = a * eigWInt P ρ F) ∧ (∀ F G : Fin P.n → E2 → ℝ, (∀ j, ∀ x ∈ P.W j, F j x = G j x) → eigWInt P ρ F = eigWInt P ρ G) ∧ (∀ F G : Fin P.n → E2 → ℝ, (∀ j, ContinuousOn (F j) (P.W j)) → (∀ j, ContinuousOn (G j) (P.W j)) → (∀ j, ∀ x ∈ K j, F j x ≤ G j x) → eigWInt P ρ F ≤ eigWInt P ρ G) ∧ (∀ F : Fin P.n → E2 → ℝ, (∀ j, ∀ x ∈ K j, 0 ≤ F j x) → 0 ≤ eigWInt P ρ F) ∧ (∃ A : ℝ, 0 < A ∧ ∀ F : Fin P.n → E2 → ℝ, (∀ j, ContinuousOn (F j) (P.W j)) → (∀ j, ∀ x ∈ K j, 0 ≤ F j x) → eigWInt P ρ F ≤ A * ∑ j, ∫ x in K j, F j x) ∧ (∀ F : Fin P.n → E2 → ℝ, (∀ j, ContinuousOn (F j) (P.W j)) → (∃ j, ∃ x ∈ P.W j, 0 < ρ j (P.param j x)) → (∀ j, ∀ x ∈ P.W j, 0 < F j x) → 0 < eigWInt P ρ F) :=
by
  classical
  have hd : ∀ j, ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) := by
    intro j
    have hc : ∀ a b : Fin 2, ContinuousOn (fun x => P.h j x a b) (P.W j) :=
      fun a b => (P.h_smooth j a b).continuousOn
    have e : (fun x => (P.h j x).det) =
        fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
      funext x
      exact Matrix.det_fin_two _
    have hdet : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
      rw [e]
      exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
    exact hdet.sqrt
  have hdpos : ∀ j, ∀ x ∈ P.W j, 0 < Real.sqrt (P.h j x).det :=
    fun j x hx => Real.sqrt_pos.2 (P.h_posDef j x hx).det_pos
  have hvan : ∀ j (F : E2 → ℝ), ∀ x ∈ P.W j \ K j,
      ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det = 0 := by
    intro j F x hx
    rw [hρK j x hx.1 hx.2]
    ring
  have hint : ∀ j (F : E2 → ℝ), ContinuousOn F (P.W j) →
      Integrable (fun x => ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det)
        (volume.restrict (P.W j)) := by
    intro j F hF
    have hcK : ContinuousOn (fun x => ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det) (K j) :=
      (((hρc j).mul hF).mul (hd j)).mono (hK j).2
    exact (hcK.integrableOn_compact (hK j).1).of_forall_diff_eq_zero
      (P.W_open j).measurableSet (hvan j F)
  have hres : ∀ j (F : E2 → ℝ),
      ∫ x in P.W j, ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det
        = ∫ x in K j, ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det :=
    fun j F => setIntegral_eq_of_subset_of_forall_diff_eq_zero (P.W_open j).measurableSet
      (hK j).2 (hvan j F)
  have hpt : ∀ j (F : E2 → ℝ), (∀ x ∈ K j, 0 ≤ F x) →
      ∀ x ∈ P.W j, 0 ≤ ρ j (P.param j x) * F x * Real.sqrt (P.h j x).det := by
    intro j F hF x hx
    by_cases hxK : x ∈ K j
    · exact mul_nonneg (mul_nonneg (hρnn _ _) (hF x hxK)) (Real.sqrt_nonneg _)
    · rw [hρK j x hx hxK]
      simp
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro F G H hF hG hH a b c
    have key : ∀ j, ∫ x in P.W j, ρ j (P.param j x) * (a * F j x + b * G j x + c * H j x) *
          Real.sqrt (P.h j x).det
        = a * (∫ x in P.W j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
          + b * (∫ x in P.W j, ρ j (P.param j x) * G j x * Real.sqrt (P.h j x).det)
          + c * (∫ x in P.W j, ρ j (P.param j x) * H j x * Real.sqrt (P.h j x).det) := by
      intro j
      have e : (fun x => ρ j (P.param j x) * (a * F j x + b * G j x + c * H j x) *
            Real.sqrt (P.h j x).det)
          = fun x => (a * (ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det)
            + b * (ρ j (P.param j x) * G j x * Real.sqrt (P.h j x).det))
            + c * (ρ j (P.param j x) * H j x * Real.sqrt (P.h j x).det) := by
        funext x
        ring
      have iF := (hint j _ (hF j)).const_mul a
      have iG := (hint j _ (hG j)).const_mul b
      have iH := (hint j _ (hH j)).const_mul c
      rw [e, integral_add ?_ iH, integral_add iF iG,
        integral_const_mul, integral_const_mul, integral_const_mul]
      exact iF.add iG
    simp only [eigWInt]
    rw [Finset.sum_congr rfl (fun j _ => key j), Finset.sum_add_distrib, Finset.sum_add_distrib,
      Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
  · intro F a
    simp only [eigWInt, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← integral_const_mul]
    congr 1
    funext x
    ring
  · intro F G hFG
    simp only [eigWInt]
    exact Finset.sum_congr rfl fun j _ =>
      setIntegral_congr_fun (P.W_open j).measurableSet (fun x hx => by simp only [hFG j x hx])
  · intro F G hF hG hFG
    simp only [eigWInt]
    refine Finset.sum_le_sum fun j _ => setIntegral_mono_on (hint j _ (hF j)) (hint j _ (hG j))
      (P.W_open j).measurableSet ?_
    intro x hx
    by_cases hxK : x ∈ K j
    · exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hFG j x hxK) (hρnn _ _)) (Real.sqrt_nonneg _)
    · rw [hρK j x hx hxK]
      simp
  · intro F hF
    simp only [eigWInt]
    exact Finset.sum_nonneg fun j _ =>
      setIntegral_nonneg (P.W_open j).measurableSet (hpt j (F j) (hF j))
  · have hb : ∀ j, ∃ C : ℝ, ∀ x ∈ K j,
        ‖ρ j (P.param j x) * Real.sqrt (P.h j x).det‖ ≤ C := fun j =>
      (hK j).1.exists_bound_of_continuousOn (((hρc j).mul (hd j)).mono (hK j).2)
    choose C hC using hb
    have hsum0 : 0 ≤ ∑ i, |C i| := Finset.sum_nonneg (fun i _ => abs_nonneg (C i))
    refine ⟨1 + ∑ i, |C i|, by linarith, fun F hF hF0 => ?_⟩
    simp only [eigWInt]
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    rw [hres j (F j)]
    have hFK : IntegrableOn (F j) (K j) := ((hF j).mono (hK j).2).integrableOn_compact (hK j).1
    have h1 : ∫ x in K j, ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det
        ≤ ∫ x in K j, (1 + ∑ i, |C i|) * F j x := by
      refine setIntegral_mono_on ?_ (Integrable.const_mul hFK _) (hK j).1.measurableSet ?_
      · exact ((((hρc j).mul (hF j)).mul (hd j)).mono (hK j).2).integrableOn_compact (hK j).1
      · intro x hx
        have h2 : ρ j (P.param j x) * Real.sqrt (P.h j x).det ≤ 1 + ∑ i, |C i| := by
          have h4 := hC j x hx
          rw [Real.norm_eq_abs] at h4
          have h3 : |C j| ≤ ∑ i, |C i| :=
            Finset.single_le_sum (f := fun i => |C i|) (fun i _ => abs_nonneg _)
              (Finset.mem_univ j)
          linarith [le_abs_self (ρ j (P.param j x) * Real.sqrt (P.h j x).det), le_abs_self (C j)]
        calc ρ j (P.param j x) * F j x * Real.sqrt (P.h j x).det
            = (ρ j (P.param j x) * Real.sqrt (P.h j x).det) * F j x := by ring
          _ ≤ (1 + ∑ i, |C i|) * F j x := mul_le_mul_of_nonneg_right h2 (hF0 j x hx)
    rw [integral_const_mul] at h1
    exact h1
  · rintro F hF ⟨j₀, x₀, hx₀, hρx₀⟩ hFpos
    simp only [eigWInt]
    refine Finset.sum_pos' (fun j _ => setIntegral_nonneg (P.W_open j).measurableSet
      (hpt j (F j) (fun x hx => (hFpos j x ((hK j).2 hx)).le))) ⟨j₀, Finset.mem_univ _, ?_⟩
    have hg : ContinuousOn (fun x => ρ j₀ (P.param j₀ x) * F j₀ x * Real.sqrt (P.h j₀ x).det)
        (P.W j₀) := ((hρc j₀).mul (hF j₀)).mul (hd j₀)
    have hnn := ae_restrict_of_forall_mem (μ := volume) (P.W_open j₀).measurableSet
      (hpt j₀ (F j₀) (fun x hx => (hFpos j₀ x ((hK j₀).2 hx)).le))
    rw [setIntegral_pos_iff_support_of_nonneg_ae hnn (hint j₀ _ (hF j₀))]
    have hU : IsOpen (P.W j₀ ∩ (fun x => ρ j₀ (P.param j₀ x) * F j₀ x *
        Real.sqrt (P.h j₀ x).det) ⁻¹' Set.Ioi 0) :=
      hg.isOpen_inter_preimage (P.W_open j₀) isOpen_Ioi
    have hx₀U : x₀ ∈ P.W j₀ ∩ (fun x => ρ j₀ (P.param j₀ x) * F j₀ x *
        Real.sqrt (P.h j₀ x).det) ⁻¹' Set.Ioi 0 :=
      ⟨hx₀, mul_pos (mul_pos hρx₀ (hFpos j₀ x₀ hx₀)) (hdpos j₀ x₀ hx₀)⟩
    refine lt_of_lt_of_le (hU.measure_pos volume ⟨x₀, hx₀U⟩) (measure_mono ?_)
    intro x hx
    exact ⟨(show (0 : ℝ) < _ from hx.2).ne', hx.1⟩

theorem eig_rayleigh_min_seq {α : Type*} [AddCommGroup α] [Module ℝ α] (C : Set α) (B N : α → α → ℝ) (Pos : α → Prop) (hC : ∀ u ∈ C, ∀ z ∈ C, ∀ t : ℝ, u + t • z ∈ C) (hBq : ∀ u ∈ C, ∀ z ∈ C, ∀ t : ℝ, B (u + t • z) (u + t • z) = B u u + 2 * t * B u z + t ^ 2 * B z z) (hNq : ∀ u ∈ C, ∀ z ∈ C, ∀ t : ℝ, N (u + t • z) (u + t • z) = N u u + 2 * t * N u z + t ^ 2 * N z z) (hN0 : ∀ u ∈ C, 0 ≤ N u u) (hlow : ∃ c₁ : ℝ, ∀ u ∈ C, -c₁ * N u u ≤ B u u) (hex : ∃ u ∈ C, 0 < N u u) (hPos : ∀ u (c : ℝ), Pos u → 0 < c → Pos (c • u)) (hreg : ∀ v ∈ C, 0 < N v v → ∀ η : ℝ, 0 < η → ∃ w ∈ C, Pos w ∧ 0 < N w w ∧ B w w ≤ (B v v / N v v + η) * N w w) : ∃ (lam : ℝ) (u : ℕ → α) (δ : ℕ → ℝ), (∀ n, u n ∈ C) ∧ (∀ n, Pos (u n)) ∧ (∀ n, N (u n) (u n) = 1) ∧ (∀ n, B (u n) (u n) = lam + δ n) ∧ Filter.Tendsto δ Filter.atTop (nhds 0) ∧ ∀ z ∈ C, ∀ n (t : ℝ), 0 ≤ δ n + 2 * t * (B (u n) z - lam * N (u n) z) + t ^ 2 * (B z z - lam * N z z) :=
by
  obtain ⟨c₁, hc₁⟩ := hlow
  obtain ⟨u₀, hu₀C, hu₀N⟩ := hex
  set R : Set ℝ := {r : ℝ | ∃ v ∈ C, 0 < N v v ∧ B v v / N v v = r} with hRdef
  have hRne : R.Nonempty := ⟨_, u₀, hu₀C, hu₀N, rfl⟩
  have hRbdd : BddBelow R := by
    refine ⟨-c₁, ?_⟩
    rintro r ⟨v, hv, hNv, rfl⟩
    rw [le_div_iff₀ hNv]
    exact hc₁ v hv
  set lam := sInf R with hlam
  have hlamQ : ∀ v ∈ C, lam * N v v ≤ B v v := by
    intro v hv
    rcases (hN0 v hv).lt_or_eq with hNv | hNv
    · have h := csInf_le hRbdd ⟨v, hv, hNv, rfl⟩
      exact (le_div_iff₀ hNv).mp h
    · have h := hc₁ v hv
      rw [← hNv, mul_zero] at h ⊢
      exact h
  have happrox : ∀ ε : ℝ, 0 < ε → ∃ v ∈ C, 0 < N v v ∧ B v v / N v v < lam + ε := by
    intro ε hε
    obtain ⟨r, ⟨v, hv, hNv, rfl⟩, hr⟩ :=
      exists_lt_of_csInf_lt hRne (show sInf R < lam + ε by linarith)
    exact ⟨v, hv, hNv, hr⟩
  have hnorm : ∀ w ∈ C, Pos w → 0 < N w w →
      ∃ u ∈ C, Pos u ∧ N u u = 1 ∧ B u u = B w w / N w w := by
    intro w hw hPw hNw
    set s : ℝ := (Real.sqrt (N w w))⁻¹ with hsdef
    have hs : 0 < s := inv_pos.mpr (Real.sqrt_pos.mpr hNw)
    have hs2 : s ^ 2 * N w w = 1 := by
      rw [hsdef, inv_pow, Real.sq_sqrt hNw.le, inv_mul_cancel₀ hNw.ne']
    have hid : s • w = w + (s - 1) • w := by rw [sub_smul, one_smul]; abel
    refine ⟨s • w, ?_, hPos w s hPw hs, ?_, ?_⟩
    · rw [hid]; exact hC w hw w hw (s - 1)
    · rw [hid, hNq w hw w hw (s - 1)]
      calc N w w + 2 * (s - 1) * N w w + (s - 1) ^ 2 * N w w = s ^ 2 * N w w := by ring
        _ = 1 := hs2
    · rw [hid, hBq w hw w hw (s - 1), eq_div_iff hNw.ne']
      calc (B w w + 2 * (s - 1) * B w w + (s - 1) ^ 2 * B w w) * N w w
          = B w w * (s ^ 2 * N w w) := by ring
        _ = B w w := by rw [hs2, mul_one]
  have hseq : ∀ n : ℕ, ∃ u ∈ C, Pos u ∧ N u u = 1 ∧ lam ≤ B u u ∧
      B u u ≤ lam + 2 * (1 / ((n : ℝ) + 1)) := by
    intro n
    have hε : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨v, hv, hNv, hr⟩ := happrox _ hε
    obtain ⟨w, hw, hPw, hNw, hBw⟩ := hreg v hv hNv _ hε
    obtain ⟨u, hu, hPu, hNu, hBu⟩ := hnorm w hw hPw hNw
    refine ⟨u, hu, hPu, hNu, ?_, ?_⟩
    · have h := hlamQ u hu
      rw [hNu, mul_one] at h
      exact h
    · rw [hBu, div_le_iff₀ hNw]
      have h1 : B v v / N v v + 1 / ((n : ℝ) + 1) ≤ lam + 2 * (1 / ((n : ℝ) + 1)) := by
        linarith
      exact hBw.trans (mul_le_mul_of_nonneg_right h1 hNw.le)
  choose u huC huP huN huL huU using hseq
  refine ⟨lam, u, fun n => B (u n) (u n) - lam, huC, huP, huN, fun n => by ring, ?_, ?_⟩
  · have hg : Filter.Tendsto (fun n : ℕ => 2 * (1 / ((n : ℝ) + 1))) Filter.atTop (nhds 0) := by
      have h := tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (2 : ℝ)
      rwa [mul_zero] at h
    exact squeeze_zero (fun n => sub_nonneg.mpr (huL n)) (fun n => by linarith [huU n]) hg
  · intro z hz n t
    have hy := hlamQ _ (hC (u n) (huC n) z hz t)
    rw [hBq (u n) (huC n) z hz t, hNq (u n) (huC n) z hz t, huN n] at hy
    linarith [hy]

theorem eig_sqrt_reg (W : Set E2) (hW : IsOpen W) (v : E2 → ℝ) (hv : ContDiffOn ℝ ∞ v W) (ε : ℝ) (hε : 0 < ε) (H : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hH : ∀ x ∈ W, (H x).PosSemidef) : ContDiffOn ℝ ∞ (fun x => Real.sqrt (v x ^ 2 + ε ^ 2)) W ∧ ∀ x ∈ W, ∑ a : Fin 2, ∑ b : Fin 2, H x a b * pd2 b (fun x' => Real.sqrt (v x' ^ 2 + ε ^ 2)) x * pd2 a (fun x' => Real.sqrt (v x' ^ 2 + ε ^ 2)) x ≤ ∑ a : Fin 2, ∑ b : Fin 2, H x a b * pd2 b v x * pd2 a v x :=
by
  have htpos : ∀ y, 0 < v y ^ 2 + ε ^ 2 := fun y =>
    add_pos_of_nonneg_of_pos (sq_nonneg _) (pow_pos hε 2)
  refine ⟨?_, ?_⟩
  · exact ((hv.pow 2).add contDiffOn_const).sqrt (fun y _ => (htpos y).ne')
  · intro x hx
    have hdv : DifferentiableAt ℝ v x :=
      (hv.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have h1 : HasFDerivAt v (fderiv ℝ v x) x := hdv.hasFDerivAt
    have h2 := (h1.pow 2).add_const (ε ^ 2)
    have h3 := h2.sqrt (htpos x).ne'
    have hs : 0 < Real.sqrt (v x ^ 2 + ε ^ 2) := Real.sqrt_pos.2 (htpos x)
    set c : ℝ := v x / Real.sqrt (v x ^ 2 + ε ^ 2) with hc
    have hpd : ∀ b : Fin 2, pd2 b (fun x' => Real.sqrt (v x' ^ 2 + ε ^ 2)) x = c * pd2 b v x := by
      intro b
      unfold pd2
      rw [h3.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul, nsmul_eq_mul]
      rw [hc]
      field_simp
      ring
    have hc2 : c ^ 2 ≤ 1 := by
      rw [hc, div_pow, Real.sq_sqrt (htpos x).le, div_le_one (htpos x)]
      nlinarith [sq_nonneg ε]
    have hQ : 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, H x a b * pd2 b v x * pd2 a v x := by
      have h := (hH x hx).dotProduct_mulVec_nonneg (fun b => pd2 b v x)
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial] at h
      simp only [Fin.sum_univ_two]
      nlinarith [h]
    simp only [hpd]
    have hL : ∑ a : Fin 2, ∑ b : Fin 2, H x a b * (c * pd2 b v x) * (c * pd2 a v x) =
        c ^ 2 * ∑ a : Fin 2, ∑ b : Fin 2, H x a b * pd2 b v x * pd2 a v x := by
      simp only [Fin.sum_univ_two]
      ring
    rw [hL]
    exact mul_le_of_le_one_left hQ hc2

theorem eig_local_energy (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) (L : Set E2) (hL : IsCompact L) (hLW : L ⊆ W) : ∃ C : ℝ, 0 ≤ C ∧ ∀ w : E2 → ℝ, ContDiffOn ℝ ∞ w W → ∫ x in L, (w x ^ 2 + ∑ k : Fin 2, (pd2 k w x) ^ 2) ≤ C * ((∫ x in L, w x * w x * Real.sqrt (h x).det) + ∫ x in L, (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det) :=
by
  classical
  
  have alg : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef → ∀ v : Fin 2 → ℝ,
      0 < A 0 0 + A 1 1 ∧
        (∑ k : Fin 2, v k ^ 2) ≤ (A 0 0 + A 1 1) * ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * v b * v a := by
    intro A hA v
    have hsym : A 1 0 = A 0 1 := by
      have := hA.isHermitian.apply 0 1
      simpa using this
    have hD : 0 < A.det := hA.det_pos
    have hdet : A.det = A 0 0 * A 1 1 - A 0 1 * A 0 1 := by
      rw [Matrix.det_fin_two, hsym]
    have hE : 0 < A 0 0 := hA.diag_pos
    have hG : 0 < A 1 1 := hA.diag_pos
    have hinv : ∀ a b, A⁻¹ a b = A.det⁻¹ * A.adjugate a b := by
      intro a b
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    have i00 : A⁻¹ 0 0 = A.det⁻¹ * A 1 1 := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    have i01 : A⁻¹ 0 1 = A.det⁻¹ * (-A 0 1) := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    have i10 : A⁻¹ 1 0 = A.det⁻¹ * (-A 0 1) := by
      rw [hinv]; simp [Matrix.adjugate_fin_two, hsym]
    have i11 : A⁻¹ 1 1 = A.det⁻¹ * A 0 0 := by rw [hinv]; simp [Matrix.adjugate_fin_two]
    refine ⟨by linarith, ?_⟩
    simp only [Fin.sum_univ_two, i00, i01, i10, i11]
    have ht : A.det⁻¹ * (A 0 0 * A 1 1 - A 0 1 * A 0 1) = 1 := by
      rw [← hdet]; exact inv_mul_cancel₀ hD.ne'
    have key : (A 0 0 + A 1 1) * (A.det⁻¹ * A 1 1 * v 0 * v 0 + A.det⁻¹ * (-A 0 1) * v 1 * v 0 +
        (A.det⁻¹ * (-A 0 1) * v 0 * v 1 + A.det⁻¹ * A 0 0 * v 1 * v 1)) - (v 0 ^ 2 + v 1 ^ 2) =
        A.det⁻¹ * ((A 1 1 * v 0 - A 0 1 * v 1) ^ 2 + (A 0 1 * v 0 - A 0 0 * v 1) ^ 2) := by
      linear_combination (v 0 ^ 2 + v 1 ^ 2) * ht
    have hnn : 0 ≤ A.det⁻¹ * ((A 1 1 * v 0 - A 0 1 * v 1) ^ 2 + (A 0 1 * v 0 - A 0 0 * v 1) ^ 2) :=
      mul_nonneg (inv_nonneg.2 hD.le) (add_nonneg (sq_nonneg _) (sq_nonneg _))
    linarith
  
  have hc : ∀ a b : Fin 2, ContinuousOn (fun x => h x a b) W := fun a b => (hh a b).continuousOn
  have hdetc : ContinuousOn (fun x => (h x).det) W := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    rw [e]
    exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
  have hsc : ContinuousOn (fun x => Real.sqrt (h x).det) W := hdetc.sqrt
  have htc : ContinuousOn (fun x => h x 0 0 + h x 1 1) W := (hc 0 0).add (hc 1 1)
  have hdetinv : ContinuousOn (fun x => ((h x).det)⁻¹) W :=
    hdetc.inv₀ (fun x hx => (hpos x hx).det_pos.ne')
  have hadjc : ∀ a b : Fin 2, ContinuousOn (fun x => (h x).adjugate a b) W := by
    intro a b
    fin_cases a <;> fin_cases b <;> simp [Matrix.adjugate_fin_two] <;>
      first
        | exact hc _ _
        | exact (hc _ _).neg
        | fun_prop
  have hinvc : ∀ a b : Fin 2, ContinuousOn (fun x => (h x)⁻¹ a b) W := by
    intro a b
    have e : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b := by
      funext x
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [e]
    exact hdetinv.mul (hadjc a b)
  
  have hspos : ∀ x ∈ L, 0 < Real.sqrt (h x).det :=
    fun x hx => Real.sqrt_pos.2 (hpos x (hLW hx)).det_pos
  obtain ⟨m, hm0, hm⟩ := hL.exists_forall_le' (hsc.mono hLW) hspos
  obtain ⟨B, hB⟩ := hL.exists_bound_of_continuousOn (htc.mono hLW)
  set T : ℝ := max B 0 with hTdef
  have hT0 : 0 ≤ T := le_max_right _ _
  have hTb : ∀ x ∈ L, h x 0 0 + h x 1 1 ≤ T := by
    intro x hx
    have h1 := hB x hx
    rw [Real.norm_eq_abs] at h1
    exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
  refine ⟨(1 + T) / m, div_nonneg (by linarith) hm0.le, ?_⟩
  intro w hw
  
  have hwc : ContinuousOn w W := hw.continuousOn
  have hpdc : ∀ k : Fin 2, ContinuousOn (fun x => pd2 k w x) W := by
    intro k
    unfold pd2
    exact (hw.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
  
  have hpt : ∀ x ∈ L, (w x ^ 2 + ∑ k : Fin 2, (pd2 k w x) ^ 2) ≤
      (1 + T) / m * (w x * w x * Real.sqrt (h x).det +
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det) := by
    intro x hx
    obtain ⟨hτ, hPQ⟩ := alg (h x) (hpos x (hLW hx)) (fun k => pd2 k w x)
    have hPQ' : (∑ k : Fin 2, (pd2 k w x) ^ 2) ≤ (h x 0 0 + h x 1 1) *
        ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x := hPQ
    set P := ∑ k : Fin 2, (pd2 k w x) ^ 2 with hPdef
    set Q := ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x with hQdef
    set σ := Real.sqrt (h x).det with hσdef
    set τ := h x 0 0 + h x 1 1 with hτdef
    have hP0 : 0 ≤ P := Finset.sum_nonneg (fun k _ => sq_nonneg _)
    have hQ0 : 0 ≤ Q := by
      by_contra hneg
      push_neg at hneg
      have := mul_neg_of_pos_of_neg hτ hneg
      linarith
    have hτT : τ ≤ T := hTb x hx
    have hPT : P ≤ T * Q := hPQ'.trans (mul_le_mul_of_nonneg_right hτT hQ0)
    have hmσ : m ≤ σ := hm x hx
    have hX : w x ^ 2 + P ≤ (1 + T) * (w x * w x + Q) := by
      nlinarith [mul_nonneg hT0 (sq_nonneg (w x)), sq_nonneg (w x)]
    have hY : 0 ≤ (1 + T) * (w x * w x + Q) * (σ - m) :=
      mul_nonneg (mul_nonneg (by linarith) (add_nonneg (mul_self_nonneg _) hQ0))
        (sub_nonneg.2 hmσ)
    have hZ : (w x ^ 2 + P) * m ≤ (1 + T) * (w x * w x + Q) * m :=
      mul_le_mul_of_nonneg_right hX hm0.le
    rw [div_mul_eq_mul_div, le_div_iff₀ hm0]
    nlinarith [hY, hZ]
  
  have hfc : ContinuousOn (fun x => w x ^ 2 + ∑ k : Fin 2, (pd2 k w x) ^ 2) W :=
    (hwc.pow 2).add (continuousOn_finset_sum _ (fun k _ => (hpdc k).pow 2))
  have hg1c : ContinuousOn (fun x => w x * w x * Real.sqrt (h x).det) W :=
    (hwc.mul hwc).mul hsc
  have hg2c : ContinuousOn (fun x => (∑ a : Fin 2, ∑ b : Fin 2,
      (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det) W :=
    (continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
      ((hinvc a b).mul (hpdc b)).mul (hpdc a)).mul hsc
  have hf_int := (hfc.mono hLW).integrableOn_compact (μ := MeasureTheory.volume) hL
  have hg1_int := (hg1c.mono hLW).integrableOn_compact (μ := MeasureTheory.volume) hL
  have hg2_int := (hg2c.mono hLW).integrableOn_compact (μ := MeasureTheory.volume) hL
  have hg_int : MeasureTheory.IntegrableOn (fun x => (1 + T) / m * (w x * w x * Real.sqrt (h x).det +
      (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det))
      L MeasureTheory.volume :=
    (hg1_int.add hg2_int).const_mul _
  calc ∫ x in L, (w x ^ 2 + ∑ k : Fin 2, (pd2 k w x) ^ 2)
      ≤ ∫ x in L, (1 + T) / m * (w x * w x * Real.sqrt (h x).det +
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det) :=
        MeasureTheory.setIntegral_mono_on hf_int hg_int hL.measurableSet hpt
    _ = (1 + T) / m * ((∫ x in L, w x * w x * Real.sqrt (h x).det) + ∫ x in L,
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 b w x * pd2 a w x) * Real.sqrt (h x).det) := by
        rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_add hg1_int hg2_int]

theorem eig_gam_facts {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S) (u v : X → ℝ) (hu : ∀ j, ContDiffOn ℝ ∞ (fun x => u (P.param j x)) (P.W j)) (hv : ∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j)) (j : Fin P.n) : ContinuousOn (eigGam P u v j) (P.W j) ∧ (∀ x ∈ P.W j, 0 ≤ eigGam P u u j x) ∧ ∀ x ∈ P.W j, ∀ t : ℝ, eigGam P (u + t • v) (u + t • v) j x = eigGam P u u j x + 2 * t * eigGam P u v j x + t ^ 2 * eigGam P v v j x :=
by
  have hW := P.W_open j
  have hU := hu j
  have hV := hv j
  have hc : ∀ a b : Fin 2, ContinuousOn (fun x => P.h j x a b) (P.W j) :=
    fun a b => (P.h_smooth j a b).continuousOn
  have hdet : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
    have e : (fun x => (P.h j x).det) =
        fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    rw [e]
    exact ((hc 0 0).mul (hc 1 1)).sub ((hc 0 1).mul (hc 1 0))
  have hdinv : ContinuousOn (fun x => ((P.h j x).det)⁻¹) (P.W j) :=
    hdet.inv₀ (fun x hx => (P.h_posDef j x hx).det_pos.ne')
  have hH : ∀ a b : Fin 2, ContinuousOn (fun x => (P.h j x)⁻¹ a b) (P.W j) := by
    intro a b
    have hform : ∀ x, (P.h j x)⁻¹ a b = ((P.h j x).det)⁻¹ * (P.h j x).adjugate a b := by
      intro x
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    have hadj : ContinuousOn (fun x => (P.h j x).adjugate a b) (P.W j) := by
      fin_cases a <;> fin_cases b <;> simp [Matrix.adjugate_fin_two] <;>
        first | exact hc _ _ | exact (hc _ _).neg
    exact (hdinv.mul hadj).congr (fun x _ => hform x)
  have hdF : ∀ (F : E2 → ℝ), ContDiffOn ℝ ∞ F (P.W j) → ∀ b : Fin 2,
      ContinuousOn (fun x => pd2 b F x) (P.W j) := by
    intro F hF b
    have h1 := hF.continuousOn_fderiv_of_isOpen hW (by simp)
    exact h1.clm_apply continuousOn_const
  have hsym : ∀ x ∈ P.W j, ∀ a b : Fin 2, (P.h j x)⁻¹ b a = (P.h j x)⁻¹ a b := by
    intro x hx a b
    have := (P.h_posDef j x hx).inv.isHermitian.apply a b
    rw [star_trivial] at this
    exact this
  have hlin : ∀ x ∈ P.W j, ∀ t : ℝ, ∀ b : Fin 2,
      pd2 b (fun x' => (u + t • v) (P.param j x')) x =
        pd2 b (fun x' => u (P.param j x')) x + t * pd2 b (fun x' => v (P.param j x')) x := by
    intro x hx t b
    have hdu : DifferentiableAt ℝ (fun x' => u (P.param j x')) x :=
      (hU.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hdv : DifferentiableAt ℝ (fun x' => v (P.param j x')) x :=
      (hV.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hF : HasFDerivAt (fun x' => (u + t • v) (P.param j x'))
        (fderiv ℝ (fun x' => u (P.param j x')) x + t • fderiv ℝ (fun x' => v (P.param j x')) x) x :=
      hdu.hasFDerivAt.add (hdv.hasFDerivAt.const_smul t)
    unfold pd2
    rw [hF.fderiv]
    simp
  refine ⟨?_, ?_, ?_⟩
  · unfold eigGam
    exact continuousOn_finset_sum _ (fun a _ => continuousOn_finset_sum _ (fun b _ =>
      ((hH a b).mul (hdF _ hU b)).mul (hdF _ hV a)))
  · intro x hx
    have h0 := (P.h_posDef j x hx).inv.posSemidef.dotProduct_mulVec_nonneg
      (fun b => pd2 b (fun x' => u (P.param j x')) x)
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial] at h0
    simp only [eigGam, Fin.sum_univ_two]
    nlinarith [h0]
  · intro x hx t
    simp only [eigGam, hlin x hx t, Fin.sum_univ_two]
    rw [hsym x hx 0 1]
    ring

theorem eig_variational_sequence {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X) (hS : IsCompact S) (hne : S.Nonempty) (P : EigPatchedSurface X S) (V : X → ℝ) (hV : ∀ j, ContDiffOn ℝ ∞ (fun x => V (P.param j x)) (P.W j)) : ∃ (lam : ℝ) (u : ℕ → X → ℝ) (δ : ℕ → ℝ) (K : Fin P.n → Set E2) (c₀ : ℝ), (∀ n j, ContDiffOn ℝ ∞ (fun x => u n (P.param j x)) (P.W j)) ∧ (∀ n, ∀ q ∈ S, 0 ≤ u n q) ∧ Tendsto δ atTop (𝓝 0) ∧ (∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∃ C : ℝ, ∀ n, ∫ x in L, ((u n (P.param j x)) ^ 2 + ∑ k : Fin 2, (pd2 k (fun x' => u n (P.param j x')) x) ^ 2) ≤ C) ∧ (∀ j, IsCompact (K j) ∧ K j ⊆ P.W j) ∧ 0 < c₀ ∧ (∀ n, c₀ ≤ ∑ j, ∫ x in K j, (u n (P.param j x)) ^ 2) ∧ ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j → ∃ M : ℝ, ∀ n (t : ℝ), 0 ≤ δ n + 2 * t * (∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a b * pd2 b (fun x' => u n (P.param j x')) x * pd2 a ζ x - (V (P.param j x) + lam) * Real.sqrt (P.h j x).det * u n (P.param j x) * ζ x)) + t ^ 2 * M :=
by
  classical
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∧ P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem
  have hP3 : ∀ j k, ∀ x ∈ P.W j ∩ P.param j ⁻¹' P.O k,
      P.proj k (P.param j x) ∈ P.W k ∧ P.param k (P.proj k (P.param j x)) = P.param j x := by
    intro j k x hx
    have hq : P.param j x ∈ P.O k ∩ S := ⟨hx.2, (hP1 j x hx.1).2⟩
    rw [← P.image_eq k] at hq
    obtain ⟨y, hy, hyx⟩ := hq
    rw [← hyx, P.proj_param k y hy]
    exact ⟨hy, rfl⟩
  
  obtain ⟨ρ, K, hρnn, hρs, hρ1, hK, hρK, hρO⟩ :=
    eig_partition_unity S hS P (fun k ζ h1 h2 h3 => eig_lift_smooth S P k ζ h1 h2 h3)
  have hρc : ∀ j k, ContinuousOn (fun x => ρ j (P.param k x)) (P.W k) :=
    fun j k => (hρs j k).continuousOn
  obtain ⟨hlin, hsmul, hcongr, hmono, hnn, ⟨A, hA0, hAb⟩, hposI⟩ :=
    eig_wint_facts S P ρ K hρnn (fun j => hρc j j) hK hρK
  
  obtain ⟨Cl, hCl⟩ : ∃ Cl : Set (X → ℝ), ∀ w, w ∈ Cl ↔
      ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j) :=
    ⟨{w | ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)}, fun w => Iff.rfl⟩
  obtain ⟨NF, hNF⟩ : ∃ NF : (X → ℝ) → (X → ℝ) → Fin P.n → E2 → ℝ,
      ∀ w v j x, NF w v j x = w (P.param j x) * v (P.param j x) :=
    ⟨fun w v j x => w (P.param j x) * v (P.param j x), fun _ _ _ _ => rfl⟩
  obtain ⟨BF, hBF⟩ : ∃ BF : (X → ℝ) → (X → ℝ) → Fin P.n → E2 → ℝ,
      ∀ w v j x, BF w v j x =
        eigGam P w v j x - V (P.param j x) * w (P.param j x) * v (P.param j x) :=
    ⟨fun w v j x => eigGam P w v j x - V (P.param j x) * w (P.param j x) * v (P.param j x),
      fun _ _ _ _ => rfl⟩
  obtain ⟨ONE, hONE⟩ : ∃ ONE : Fin P.n → E2 → ℝ, ∀ j x, ONE j x = 1 :=
    ⟨fun _ _ => 1, fun _ _ => rfl⟩
  obtain ⟨Nf, hNf⟩ : ∃ Nf : (X → ℝ) → (X → ℝ) → ℝ, ∀ w v, Nf w v = eigWInt P ρ (NF w v) :=
    ⟨fun w v => eigWInt P ρ (NF w v), fun _ _ => rfl⟩
  obtain ⟨Bf, hBf⟩ : ∃ Bf : (X → ℝ) → (X → ℝ) → ℝ, ∀ w v, Bf w v = eigWInt P ρ (BF w v) :=
    ⟨fun w v => eigWInt P ρ (BF w v), fun _ _ => rfl⟩
  have hNFc : ∀ w v : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      (∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j)) →
      ∀ j, ContinuousOn (NF w v j) (P.W j) := by
    intro w v hw hv j
    exact ((hw j).continuousOn.mul (hv j).continuousOn).congr (fun x _ => hNF w v j x)
  have hBFc : ∀ w v : X → ℝ, (∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j)) →
      (∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j)) →
      ∀ j, ContinuousOn (BF w v j) (P.W j) := by
    intro w v hw hv j
    exact ((eig_gam_facts S P w v hw hv j).1.sub
      (((hV j).continuousOn.mul (hw j).continuousOn).mul (hv j).continuousOn)).congr
      (fun x _ => hBF w v j x)
  have hONEc : ∀ j, ContinuousOn (ONE j) (P.W j) :=
    fun j => continuousOn_const.congr (fun x _ => hONE j x)
  
  obtain ⟨CV, hCV0, hCV⟩ : ∃ CV : ℝ, 0 ≤ CV ∧ ∀ j, ∀ x ∈ K j, |V (P.param j x)| ≤ CV := by
    have hVb : ∀ j, ∃ C : ℝ, ∀ x ∈ K j, ‖V (P.param j x)‖ ≤ C := fun j =>
      (hK j).1.exists_bound_of_continuousOn ((hV j).continuousOn.mono (hK j).2)
    choose C hC using hVb
    refine ⟨∑ j, |C j|, Finset.sum_nonneg (fun j _ => abs_nonneg _), fun j x hx => ?_⟩
    have h1 := hC j x hx
    rw [Real.norm_eq_abs] at h1
    calc |V (P.param j x)| ≤ C j := h1
      _ ≤ |C j| := le_abs_self _
      _ ≤ ∑ j, |C j| :=
          Finset.single_le_sum (f := fun j => |C j|) (fun j _ => abs_nonneg _)
            (Finset.mem_univ j)
  have hVle : ∀ j, ∀ x ∈ K j, ∀ y : ℝ, V (P.param j x) * (y * y) ≤ CV * (y * y) := by
    intro j x hx y
    have h1 := hCV j x hx
    have h2 := le_abs_self (V (P.param j x))
    exact mul_le_mul_of_nonneg_right (by linarith) (mul_self_nonneg y)
  
  have hC : ∀ w ∈ Cl, ∀ z ∈ Cl, ∀ t : ℝ, w + t • z ∈ Cl := by
    intro w hw z hz t
    rw [hCl] at hw hz ⊢
    intro j
    exact (hw j).add ((hz j).const_smul t)
  have hBq : ∀ w ∈ Cl, ∀ z ∈ Cl, ∀ t : ℝ,
      Bf (w + t • z) (w + t • z) = Bf w w + 2 * t * Bf w z + t ^ 2 * Bf z z := by
    intro w hw z hz t
    rw [hCl] at hw hz
    have e := hlin (BF w w) (BF w z) (BF z z) (hBFc w w hw hw) (hBFc w z hw hz)
      (hBFc z z hz hz) 1 (2 * t) (t ^ 2)
    have hc : eigWInt P ρ (BF (w + t • z) (w + t • z)) = eigWInt P ρ
        (fun j x => 1 * BF w w j x + 2 * t * BF w z j x + t ^ 2 * BF z z j x) := by
      apply hcongr
      intro j x hx
      simp only [hBF]
      rw [(eig_gam_facts S P w z hw hz j).2.2 x hx t]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      ring
    simp only [hBf]
    rw [hc.trans e]
    ring
  have hNq : ∀ w ∈ Cl, ∀ z ∈ Cl, ∀ t : ℝ,
      Nf (w + t • z) (w + t • z) = Nf w w + 2 * t * Nf w z + t ^ 2 * Nf z z := by
    intro w hw z hz t
    rw [hCl] at hw hz
    have e := hlin (NF w w) (NF w z) (NF z z) (hNFc w w hw hw) (hNFc w z hw hz)
      (hNFc z z hz hz) 1 (2 * t) (t ^ 2)
    have hc : eigWInt P ρ (NF (w + t • z) (w + t • z)) = eigWInt P ρ
        (fun j x => 1 * NF w w j x + 2 * t * NF w z j x + t ^ 2 * NF z z j x) := by
      apply hcongr
      intro j x _
      simp only [hNF, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      ring
    simp only [hNf]
    rw [hc.trans e]
    ring
  have hN0 : ∀ w ∈ Cl, 0 ≤ Nf w w := by
    intro w _
    rw [hNf]
    exact hnn _ (fun j x _ => by rw [hNF]; exact mul_self_nonneg _)
  have hlow : ∃ c₁ : ℝ, ∀ w ∈ Cl, -c₁ * Nf w w ≤ Bf w w := by
    refine ⟨CV, fun w hw => ?_⟩
    rw [hCl] at hw
    rw [hNf, hBf, ← hsmul]
    refine hmono _ _ (fun j => continuousOn_const.mul (hNFc w w hw hw j)) (hBFc w w hw hw) ?_
    intro j x hx
    simp only [hNF, hBF]
    have h1 := (eig_gam_facts S P w w hw hw j).2.1 x ((hK j).2 hx)
    have h2 := hVle j x hx (w (P.param j x))
    linarith
  have hρpos : ∃ j, ∃ x ∈ P.W j, 0 < ρ j (P.param j x) := by
    obtain ⟨p, hp⟩ := hne
    have hsum := hρ1 p hp
    have hj : ∃ j, 0 < ρ j p := by
      by_contra hcon
      push_neg at hcon
      have : ∑ j, ρ j p ≤ 0 := Finset.sum_nonpos (fun j _ => hcon j)
      linarith
    obtain ⟨j, hj⟩ := hj
    have hpO : p ∈ P.O j := by
      by_contra hno
      rw [hρO j p hno] at hj
      exact lt_irrefl _ hj
    have hq : p ∈ P.O j ∩ S := ⟨hpO, hp⟩
    rw [← P.image_eq j] at hq
    obtain ⟨x, hx, hxp⟩ := hq
    exact ⟨j, x, hx, by rw [hxp]; exact hj⟩
  have hex : ∃ w ∈ Cl, 0 < Nf w w := by
    refine ⟨fun _ => 1, (hCl _).2 (fun j => contDiffOn_const), ?_⟩
    rw [hNf]
    refine hposI _ (hNFc _ _ (fun j => contDiffOn_const) (fun j => contDiffOn_const)) hρpos ?_
    intro j x _
    rw [hNF]
    norm_num
  have hPosc : ∀ (w : X → ℝ) (c : ℝ), (∀ q ∈ S, 0 ≤ w q) → 0 < c →
      ∀ q ∈ S, 0 ≤ (c • w) q := by
    intro w c hw hc q hq
    simp only [Pi.smul_apply, smul_eq_mul]
    exact mul_nonneg hc.le (hw q hq)
  have hd0 : 0 ≤ eigWInt P ρ ONE := hnn _ (fun j x _ => by rw [hONE]; exact zero_le_one)
  have halg : ∀ a c d b η e : ℝ, 0 < c → 0 ≤ d → 0 ≤ η → 0 ≤ e →
      e * (1 + b + |a / c| * d) = η * c → a + e * b ≤ (a / c + η) * (c + e * d) := by
    intro a c d b η e hc hd hη he key
    have hr : a / c * c = a := div_mul_cancel₀ a hc.ne'
    have habs : 0 ≤ |a / c| + a / c := by linarith [neg_abs_le (a / c)]
    have h1 : 0 ≤ e * ((|a / c| + a / c) * d + η * d + 1) :=
      mul_nonneg he (by nlinarith [mul_nonneg habs hd, mul_nonneg hη hd])
    nlinarith [h1, hr, key]
  have hreg : ∀ v ∈ Cl, 0 < Nf v v → ∀ η : ℝ, 0 < η → ∃ w ∈ Cl,
      (∀ q ∈ S, 0 ≤ w q) ∧ 0 < Nf w w ∧ Bf w w ≤ (Bf v v / Nf v v + η) * Nf w w := by
    intro v hv hcpos η hη
    rw [hCl] at hv
    have hD : 0 < 1 + CV * eigWInt P ρ ONE + |Bf v v / Nf v v| * eigWInt P ρ ONE := by
      have := mul_nonneg hCV0 hd0
      have := mul_nonneg (abs_nonneg (Bf v v / Nf v v)) hd0
      linarith
    obtain ⟨ε, hε, hε2⟩ : ∃ ε : ℝ, 0 < ε ∧ ε ^ 2 = η * Nf v v /
        (1 + CV * eigWInt P ρ ONE + |Bf v v / Nf v v| * eigWInt P ρ ONE) :=
      ⟨Real.sqrt _, Real.sqrt_pos.2 (div_pos (mul_pos hη hcpos) hD),
        Real.sq_sqrt (div_pos (mul_pos hη hcpos) hD).le⟩
    have hsr := fun j => eig_sqrt_reg (P.W j) (P.W_open j) (fun x => v (P.param j x)) (hv j) ε hε
      (fun x => (P.h j x)⁻¹) (fun x hx => (P.h_posDef j x hx).inv.posSemidef)
    set w : X → ℝ := fun q => Real.sqrt (v q ^ 2 + ε ^ 2) with hwdef
    have hwC : ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j) := fun j => (hsr j).1
    have hww : ∀ q, w q * w q = v q * v q + ε ^ 2 * 1 := by
      intro q
      simp only [hwdef]
      rw [Real.mul_self_sqrt (by positivity)]
      ring
    have hNw : Nf w w = Nf v v + ε ^ 2 * eigWInt P ρ ONE := by
      have e := hlin (NF v v) ONE ONE (hNFc v v hv hv) hONEc hONEc 1 (ε ^ 2) 0
      have hc : eigWInt P ρ (NF w w) = eigWInt P ρ
          (fun j x => 1 * NF v v j x + ε ^ 2 * ONE j x + 0 * ONE j x) := by
        apply hcongr
        intro j x _
        simp only [hNF, hONE]
        rw [hww]
        ring
      rw [hNf, hNf, hc.trans e]
      ring
    have hBw : Bf w w ≤ Bf v v + ε ^ 2 * (CV * eigWInt P ρ ONE) := by
      have e := hlin (BF v v) ONE ONE (hBFc v v hv hv) hONEc hONEc 1 (ε ^ 2 * CV) 0
      have hm := hmono (BF w w) (fun j x => 1 * BF v v j x + ε ^ 2 * CV * ONE j x + 0 * ONE j x)
        (hBFc w w hwC hwC)
        (fun j => ((continuousOn_const.mul (hBFc v v hv hv j)).add
          (continuousOn_const.mul (hONEc j))).add (continuousOn_const.mul (hONEc j))) ?_
      · rw [hBf, hBf]
        have h2 := hm.trans_eq e
        linarith
      · intro j x hx
        simp only [hBF, hONE]
        have hg : eigGam P w w j x ≤ eigGam P v v j x := (hsr j).2 x ((hK j).2 hx)
        have hVe : -V (P.param j x) * ε ^ 2 ≤ CV * ε ^ 2 :=
          mul_le_mul_of_nonneg_right
            (by linarith [neg_abs_le (V (P.param j x)), hCV j x hx]) (sq_nonneg ε)
        rw [mul_assoc (V (P.param j x)) (w (P.param j x)), hww]
        linarith
    have hNw' : 0 < Nf w w := by
      rw [hNw]
      have := mul_nonneg (sq_nonneg ε) hd0
      linarith
    refine ⟨w, (hCl w).2 hwC, fun q _ => Real.sqrt_nonneg _, hNw', ?_⟩
    rw [hNw]
    refine hBw.trans (halg (Bf v v) (Nf v v) (eigWInt P ρ ONE) (CV * eigWInt P ρ ONE) η (ε ^ 2)
      hcpos hd0 hη.le (sq_nonneg ε) ?_)
    rw [hε2, div_mul_cancel₀ _ hD.ne']
  
  obtain ⟨lam, u, δ, huC, hPos, hN1, hB, hδ, hEL0⟩ :=
    eig_rayleigh_min_seq Cl Bf Nf (fun w : X → ℝ => ∀ q ∈ S, 0 ≤ w q) hC hBq hNq hN0 hlow hex
      hPosc hreg
  have hu : ∀ n j, ContDiffOn ℝ ∞ (fun x => u n (P.param j x)) (P.W j) :=
    fun n => (hCl _).1 (huC n)
  obtain ⟨Cδ, hCδ⟩ : ∃ Cδ, ∀ n, δ n ≤ Cδ := by
    obtain ⟨Cδ, hCδ⟩ := hδ.bddAbove_range
    exact ⟨Cδ, fun n => hCδ ⟨n, rfl⟩⟩
  
  have hDir : ∀ n, eigWInt P ρ (fun j x => eigGam P (u n) (u n) j x) ≤ lam + Cδ + CV := by
    intro n
    have e := hlin (BF (u n) (u n)) (NF (u n) (u n)) ONE (hBFc _ _ (hu n) (hu n))
      (hNFc _ _ (hu n) (hu n)) hONEc 1 CV 0
    have hm := hmono (fun j x => eigGam P (u n) (u n) j x)
      (fun j x => 1 * BF (u n) (u n) j x + CV * NF (u n) (u n) j x + 0 * ONE j x)
      (fun j => (eig_gam_facts S P (u n) (u n) (hu n) (hu n) j).1)
      (fun j => ((continuousOn_const.mul (hBFc _ _ (hu n) (hu n) j)).add
        (continuousOn_const.mul (hNFc _ _ (hu n) (hu n) j))).add
        (continuousOn_const.mul (hONEc j))) ?_
    · have h2 := hm.trans_eq e
      rw [← hBf, ← hNf, hB n, hN1 n] at h2
      linarith [hCδ n]
    · intro j x hx
      simp only [hBF, hNF, hONE]
      have h2 := hVle j x hx (u n (P.param j x))
      linarith
  
  have hH1 : ∀ j (L : Set E2), IsCompact L → L ⊆ P.W j → ∃ C : ℝ, ∀ n,
      ∫ x in L, ((u n (P.param j x)) ^ 2 +
        ∑ k : Fin 2, (pd2 k (fun x' => u n (P.param j x')) x) ^ 2) ≤ C := by
    intro j L hL hLW
    obtain ⟨CL, hCL0, hCL⟩ :=
      eig_local_energy (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j) L hL hLW
    refine ⟨CL * (1 + (lam + Cδ + CV)), fun n => ?_⟩
    have hloc := eig_integral_localize S P ρ K hρnn hρc hρ1 hK hρK hρO j
      (fun j' G => eig_chart_cov S P j' j G)
    have h1 := (hloc (NF (u n) (u n)) (hNFc _ _ (hu n) (hu n))
      (fun j' x hx => by rw [hNF, hNF, (hP3 j' j x hx).2])).2
      (fun j' x _ => by rw [hNF]; exact mul_self_nonneg _) L hL hLW
    have h2 := (hloc (fun j' x => eigGam P (u n) (u n) j' x)
      (fun j' => (eig_gam_facts S P (u n) (u n) (hu n) (hu n) j').1)
      (fun j' x hx => eig_grad_pair_compat S P (u n) (u n) (hu n) (hu n) j' j x hx)).2
      (fun j' x hx => (eig_gam_facts S P (u n) (u n) (hu n) (hu n) j').2.1 x hx) L hL hLW
    simp only [hNF] at h1
    rw [← hNf, hN1 n] at h1
    calc ∫ x in L, ((u n (P.param j x)) ^ 2 +
          ∑ k : Fin 2, (pd2 k (fun x' => u n (P.param j x')) x) ^ 2)
        ≤ CL * ((∫ x in L, u n (P.param j x) * u n (P.param j x) * Real.sqrt (P.h j x).det) +
            ∫ x in L, eigGam P (u n) (u n) j x * Real.sqrt (P.h j x).det) :=
          hCL (fun x' => u n (P.param j x')) (hu n j)
      _ ≤ CL * (1 + (lam + Cδ + CV)) := by
          apply mul_le_mul_of_nonneg_left _ hCL0
          exact add_le_add h1 (h2.trans (hDir n))
  
  have hnd : ∀ n, 1 / A ≤ ∑ j, ∫ x in K j, (u n (P.param j x)) ^ 2 := by
    intro n
    have h := hAb (NF (u n) (u n)) (hNFc _ _ (hu n) (hu n))
      (fun j x _ => by rw [hNF]; exact mul_self_nonneg _)
    rw [← hNf, hN1 n] at h
    simp only [hNF] at h
    rw [div_le_iff₀ hA0]
    have hs : ∑ j, ∫ x in K j, (u n (P.param j x)) ^ 2 =
        ∑ j, ∫ x in K j, u n (P.param j x) * u n (P.param j x) := by
      simp only [sq]
    rw [hs]
    linarith
  
  have hEL : ∀ j (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ P.W j →
      ∃ M : ℝ, ∀ n (t : ℝ), 0 ≤ δ n + 2 * t * (∫ x, (∑ a : Fin 2, ∑ b : Fin 2,
        Real.sqrt (P.h j x).det * (P.h j x)⁻¹ a b * pd2 b (fun x' => u n (P.param j x')) x *
          pd2 a ζ x - (V (P.param j x) + lam) * Real.sqrt (P.h j x).det * u n (P.param j x) *
          ζ x)) + t ^ 2 * M := by
    intro k ζ hζ hc hs
    obtain ⟨Z, hZs, hZ0, hZf, hZev⟩ := eig_lift_smooth S P k ζ hζ hc hs
    refine ⟨Bf Z Z - lam * Nf Z Z, fun n t => ?_⟩
    have h0 := hEL0 Z ((hCl Z).2 hZs) n t
    convert h0 using 4
    have hun := hu n
    obtain ⟨FEL, hFEL⟩ : ∃ F : Fin P.n → E2 → ℝ, ∀ j x, F j x = eigGam P (u n) Z j x -
        (V (P.param j x) + lam) * u n (P.param j x) * Z (P.param j x) :=
      ⟨fun j x => eigGam P (u n) Z j x - (V (P.param j x) + lam) * u n (P.param j x) *
        Z (P.param j x), fun _ _ => rfl⟩
    have hFELc : ∀ j, ContinuousOn (FEL j) (P.W j) := fun j =>
      ((eig_gam_facts S P (u n) Z hun hZs j).1.sub ((((hV j).continuousOn.add
        continuousOn_const).mul (hun j).continuousOn).mul (hZs j).continuousOn)).congr
        (fun x _ => hFEL j x)
    have hA : Bf (u n) Z - lam * Nf (u n) Z = eigWInt P ρ FEL := by
      have e := hlin (BF (u n) Z) (NF (u n) Z) ONE (hBFc _ _ hun hZs) (hNFc _ _ hun hZs) hONEc
        1 (-lam) 0
      have hc : eigWInt P ρ FEL = eigWInt P ρ
          (fun j x => 1 * BF (u n) Z j x + -lam * NF (u n) Z j x + 0 * ONE j x) :=
        hcongr _ _ (fun j x _ => by simp only [hFEL, hBF, hNF, hONE]; ring)
      rw [hc.trans e, hBf, hNf]
      ring
    have hloc := eig_integral_localize S P ρ K hρnn hρc hρ1 hK hρK hρO k
      (fun j' G => eig_chart_cov S P j' k G) FEL hFELc (by
        intro j x hx
        rw [hFEL, hFEL, eig_grad_pair_compat S P (u n) Z hun hZs j k x hx, (hP3 j k x hx).2])
    have hB1 := hloc.1 (tsupport ζ) hc.isCompact hs (by
      intro j x hx hnot
      have hev : (fun x' => Z (P.param j x')) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := hZev j x hx hnot
      have hZx : Z (P.param j x) = 0 := hev.eq_of_nhds
      have hpd : ∀ a, pd2 a (fun x' => Z (P.param j x')) x = 0 := by
        intro a
        unfold pd2
        rw [hev.fderiv_eq]
        simp
      rw [hFEL]
      simp [eigGam, hpd, hZx])
    have hZk : ∀ x ∈ P.W k, Z (P.param k x) = ζ x := fun x hx => by
      rw [hZf _ (hP1 k x hx).1, P.proj_param k x hx]
    have hZkd : ∀ x ∈ P.W k, ∀ a, pd2 a (fun x' => Z (P.param k x')) x = pd2 a ζ x := by
      intro x hx a
      have hev : (fun x' => Z (P.param k x')) =ᶠ[𝓝 x] ζ :=
        Filter.eventually_of_mem ((P.W_open k).mem_nhds hx) hZk
      unfold pd2
      rw [hev.fderiv_eq]
    rw [hA, hB1]
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero (s := P.W k) ?_).symm.trans ?_
    · intro x hx
      have hxs : x ∉ tsupport ζ := fun h => hx (hs h)
      have hev : ζ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := notMem_tsupport_iff_eventuallyEq.1 hxs
      have hζx : ζ x = 0 := hev.eq_of_nhds
      have hpd : ∀ a, pd2 a ζ x = 0 := by
        intro a
        unfold pd2
        rw [hev.fderiv_eq]
        simp
      simp [hpd, hζx]
    · refine setIntegral_congr_fun (P.W_open k).measurableSet (fun x hx => ?_)
      simp only [hFEL, eigGam, hZkd x hx, hZk x hx, Fin.sum_univ_two]
      ring
  exact ⟨lam, u, δ, K, 1 / A, hu, hPos, hδ, hH1, hK, one_div_pos.2 hA0, hnd, hEL⟩

theorem bounded_seq_countable_diag {ι : Type} [Countable ι] (a : ℕ → ι → ℝ) (hb : ∀ d : ι, ∃ R : ℝ, ∀ n, |a n d| ≤ R) : ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ d : ι, ∀ η : ℝ, 0 < η → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l → |a (ψ m) d - a (ψ l) d| < η :=
by
  choose R hR using hb
  have hK : IsCompact (Set.univ.pi (fun d : ι => Set.Icc (-R d) (R d))) :=
    isCompact_univ_pi (fun d => isCompact_Icc)
  have hx : ∀ n, a n ∈ Set.univ.pi (fun d : ι => Set.Icc (-R d) (R d)) := by
    intro n
    rw [Set.mem_univ_pi]
    intro d
    exact abs_le.mp (hR d n)
  obtain ⟨c, _, ψ, hψ, hlim⟩ := hK.tendsto_subseq hx
  refine ⟨ψ, hψ, fun d η hη => ?_⟩
  have hd : Filter.Tendsto (fun n => a (ψ n) d) Filter.atTop (nhds (c d)) :=
    tendsto_pi_nhds.mp hlim d
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hd (η / 2) (by linarith)
  refine ⟨N, fun m l hm hl => ?_⟩
  have h1 := hN m hm
  have h2 := hN l hl
  rw [Real.dist_eq] at h1 h2
  have h3 := abs_lt.mp h1
  have h4 := abs_lt.mp h2
  rw [abs_lt]
  constructor <;> linarith [h3.1, h3.2, h4.1, h4.2]

theorem square_iterated_integral (G : E2 → ℝ) (a b s : ℝ) (hs : 0 < s) (hG : ContinuousOn G {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s}) : MeasureTheory.IntegrableOn G {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s} MeasureTheory.volume ∧ (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, G x) = (∫ y in b..b + s, ∫ x in a..a + s, G !₂[x, y]) ∧ (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, G x) = (∫ x in a..a + s, ∫ y in b..b + s, G !₂[x, y]) :=
by
  have h₁ : a ≤ a + s := by linarith
  have h₂ : b ≤ b + s := by linarith
  
  obtain ⟨ee, hee⟩ : ∃ ee : E2 ≃ᵐ ℝ × ℝ,
      ee = (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow :=
    ⟨_, rfl⟩
  have he : MeasureTheory.MeasurePreserving ee MeasureTheory.volume MeasureTheory.volume := by
    rw [hee]
    exact (MeasureTheory.volume_preserving_finTwoArrow ℝ).comp
      (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2))
  have hemb : MeasurableEmbedding ee := ee.measurableEmbedding
  have hee_apply : ∀ x : E2, ee x = (x 0, x 1) := by
    intro x; rw [hee]; rfl
  have hee_symm : ∀ p : ℝ × ℝ, ee.symm p = (!₂[p.1, p.2] : E2) := by
    intro p; rw [hee]; rfl
  have hQ : {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s} =
      ee ⁻¹' (Set.Ico a (a + s) ×ˢ Set.Ico b (b + s)) := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_preimage, hee_apply, Set.mem_prod, Set.mem_Ico]
    tauto
  have hpt : ∀ x : E2, G !₂[(ee x).1, (ee x).2] = G x := by
    intro x
    rw [← hee_symm, ee.symm_apply_apply]
  
  have hP : Continuous (fun p : ℝ × ℝ => (!₂[p.1, p.2] : E2)) := by
    have h : (fun p : ℝ × ℝ => (!₂[p.1, p.2] : E2)) =
        fun p => p.1 • EuclideanSpace.single (0 : Fin 2) (1 : ℝ) +
          p.2 • EuclideanSpace.single (1 : Fin 2) (1 : ℝ) := by
      funext p
      ext i
      fin_cases i <;> simp [EuclideanSpace.single_apply]
    rw [h]
    fun_prop
  have hmaps : Set.MapsTo (fun p : ℝ × ℝ => (!₂[p.1, p.2] : E2))
      (Set.Icc a (a + s) ×ˢ Set.Icc b (b + s))
      {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} :=
    fun p hp => ⟨hp.1.1, hp.1.2, hp.2.1, hp.2.2⟩
  have hg : ContinuousOn (fun p : ℝ × ℝ => G !₂[p.1, p.2])
      (Set.Icc a (a + s) ×ˢ Set.Icc b (b + s)) :=
    hG.comp hP.continuousOn hmaps
  have hR : MeasureTheory.IntegrableOn (fun p : ℝ × ℝ => G !₂[p.1, p.2])
      (Set.Ico a (a + s) ×ˢ Set.Ico b (b + s)) MeasureTheory.volume :=
    (hg.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ico_subset_Icc_self Set.Ico_subset_Icc_self)
  have hswapmaps : Set.MapsTo Prod.swap (Set.Icc b (b + s) ×ˢ Set.Icc a (a + s))
      (Set.Icc a (a + s) ×ˢ Set.Icc b (b + s)) := fun z hz => ⟨hz.2, hz.1⟩
  have hR' : MeasureTheory.IntegrableOn (fun z : ℝ × ℝ => G !₂[z.swap.1, z.swap.2])
      (Set.Ico b (b + s) ×ˢ Set.Ico a (a + s)) MeasureTheory.volume :=
    ((hg.comp continuous_swap.continuousOn hswapmaps).integrableOn_compact
      (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ico_subset_Icc_self Set.Ico_subset_Icc_self)
  
  have hIco : ∀ (f : ℝ → ℝ) (c d : ℝ), c ≤ d → ∫ t in Set.Ico c d, f t = ∫ t in c..d, f t := by
    intro f c d hcd
    rw [MeasureTheory.integral_Ico_eq_integral_Ioo, ← MeasureTheory.integral_Ioc_eq_integral_Ioo,
      intervalIntegral.integral_of_le hcd]
  
  have hint : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, G x) =
      ∫ p in Set.Ico a (a + s) ×ˢ Set.Ico b (b + s), G !₂[p.1, p.2] := by
    have h := he.setIntegral_preimage_emb hemb (fun p : ℝ × ℝ => G !₂[p.1, p.2])
      (Set.Ico a (a + s) ×ˢ Set.Ico b (b + s))
    simp only [hpt] at h
    rw [hQ]
    exact h
  
  have hX : (∫ p in Set.Ico a (a + s) ×ˢ Set.Ico b (b + s), G !₂[p.1, p.2]) =
      ∫ x in a..a + s, ∫ y in b..b + s, G !₂[x, y] := by
    rw [MeasureTheory.Measure.volume_eq_prod] at hR
    rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.setIntegral_prod _ hR]
    simp only [hIco _ b (b + s) h₂]
    exact hIco _ a (a + s) h₁
  
  have hY : (∫ p in Set.Ico a (a + s) ×ˢ Set.Ico b (b + s), G !₂[p.1, p.2]) =
      ∫ y in b..b + s, ∫ x in a..a + s, G !₂[x, y] := by
    rw [MeasureTheory.Measure.volume_eq_prod] at hR'
    rw [MeasureTheory.Measure.volume_eq_prod,
      ← MeasureTheory.setIntegral_prod_swap (Set.Ico a (a + s)) (Set.Ico b (b + s)),
      MeasureTheory.setIntegral_prod _ hR']
    simp only [Prod.swap_prod_mk]
    simp only [hIco _ a (a + s) h₁]
    exact hIco _ b (b + s) h₂
  refine ⟨?_, hint.trans hY, hint.trans hX⟩
  have h := (he.integrableOn_comp_preimage hemb (f := fun p : ℝ × ℝ => G !₂[p.1, p.2])
    (s := Set.Ico a (a + s) ×ˢ Set.Ico b (b + s))).mpr hR
  rw [hQ]
  refine h.congr_fun (fun x _ => ?_) (ee.measurable (measurableSet_Ico.prod measurableSet_Ico))
  exact hpt x

theorem poincare_interval (c s : ℝ) (hs : 0 < s) (f f' : ℝ → ℝ) (hf : ContinuousOn f (Set.Icc c (c + s))) (hf' : ContinuousOn f' (Set.Icc c (c + s))) (hd : ∀ x ∈ Set.Ioo c (c + s), HasDerivAt f (f' x) x) : ∫ x in c..c + s, f x ^ 2 ≤ (∫ x in c..c + s, f x) ^ 2 / s + s ^ 2 * ∫ x in c..c + s, f' x ^ 2 :=
by
  have hcs : c ≤ c + s := by linarith
  
  have hCS : ∀ p q : ℝ, p ≤ q → ∀ h : ℝ → ℝ, ContinuousOn h (Set.Icc p q) →
      (∫ x in p..q, h x) ^ 2 ≤ (q - p) * ∫ x in p..q, h x ^ 2 := by
    intro p q hpq h hh
    obtain ⟨J, hJ⟩ : ∃ J : ℝ, J = ∫ x in p..q, h x := ⟨_, rfl⟩
    have hi1 : IntervalIntegrable h MeasureTheory.volume p q := hh.intervalIntegrable_of_Icc hpq
    have hi2 : IntervalIntegrable (fun x => h x ^ 2) MeasureTheory.volume p q :=
      (hh.pow 2).intervalIntegrable_of_Icc hpq
    have hnn : 0 ≤ ∫ x in p..q, ((q - p) * h x - J) ^ 2 :=
      intervalIntegral.integral_nonneg hpq (fun _ _ => sq_nonneg _)
    have hexp : (∫ x in p..q, ((q - p) * h x - J) ^ 2) =
        (q - p) ^ 2 * (∫ x in p..q, h x ^ 2) - 2 * (q - p) * J * J + (q - p) * J ^ 2 := by
      have e : (fun x => ((q - p) * h x - J) ^ 2) =
          fun x => ((q - p) ^ 2 * h x ^ 2 - (2 * (q - p) * J) * h x) + J ^ 2 := by
        funext x; ring
      rw [e, intervalIntegral.integral_add ((hi2.const_mul _).sub (hi1.const_mul _))
          intervalIntegrable_const,
        intervalIntegral.integral_sub (hi2.const_mul _) (hi1.const_mul _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const, smul_eq_mul, ← hJ]
    rw [hexp] at hnn
    rw [← hJ]
    rcases eq_or_lt_of_le hpq with hpq' | hpq'
    · subst hpq'
      have hJ0 : J = 0 := by rw [hJ]; exact intervalIntegral.integral_same
      rw [hJ0]; simp
    · have hL : 0 < q - p := by linarith
      nlinarith
  have hII : ∀ g : ℝ → ℝ, ContinuousOn g (Set.Icc c (c + s)) →
      IntervalIntegrable g MeasureTheory.volume c (c + s) :=
    fun g hg => hg.intervalIntegrable_of_Icc hcs
  
  have hvar : (∫ x in c..c + s, f x ^ 2) =
      (∫ x in c..c + s, (f x - f c) ^ 2) + 2 * f c * (∫ x in c..c + s, f x) - s * f c ^ 2 := by
    have e : (fun x => (f x - f c) ^ 2) = fun x => (f x ^ 2 - (2 * f c) * f x) + f c ^ 2 := by
      funext x; ring
    rw [e, intervalIntegral.integral_add ((hII _ (hf.pow 2)).sub ((hII _ hf).const_mul _))
        intervalIntegrable_const,
      intervalIntegral.integral_sub (hII _ (hf.pow 2)) ((hII _ hf).const_mul _),
      intervalIntegral.integral_const_mul, intervalIntegral.integral_const, smul_eq_mul]
    ring
  
  have hpt : ∀ x ∈ Set.Icc c (c + s), (f x - f c) ^ 2 ≤ s * ∫ t in c..c + s, f' t ^ 2 := by
    intro x hx
    have hsub : Set.Icc c x ⊆ Set.Icc c (c + s) := Set.Icc_subset_Icc le_rfl hx.2
    have hftc : (∫ t in c..x, f' t) = f x - f c :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hx.1 (hf.mono hsub)
        (fun t ht => hd t ⟨ht.1, ht.2.trans_le hx.2⟩)
        ((hf'.mono hsub).intervalIntegrable_of_Icc hx.1)
    have h1 := hCS c x hx.1 f' (hf'.mono hsub)
    rw [hftc] at h1
    have h2 : 0 ≤ ∫ t in c..x, f' t ^ 2 :=
      intervalIntegral.integral_nonneg hx.1 (fun _ _ => sq_nonneg _)
    have h3 : (∫ t in c..x, f' t ^ 2) ≤ ∫ t in c..c + s, f' t ^ 2 :=
      intervalIntegral.integral_mono_interval le_rfl hx.1 hx.2
        (Filter.Eventually.of_forall (fun t => sq_nonneg (f' t))) (hII _ (hf'.pow 2))
    have h4 : x - c ≤ s := by linarith [hx.2]
    have h5 : 0 ≤ x - c := by linarith [hx.1]
    have h6 : (x - c) * (∫ t in c..x, f' t ^ 2) ≤ s * ∫ t in c..c + s, f' t ^ 2 :=
      mul_le_mul h4 h3 h2 hs.le
    linarith
  have hmono : (∫ x in c..c + s, (f x - f c) ^ 2) ≤
      ∫ x in c..c + s, s * ∫ t in c..c + s, f' t ^ 2 :=
    intervalIntegral.integral_mono_on hcs (hII _ ((hf.sub continuousOn_const).pow 2))
      intervalIntegrable_const hpt
  rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
  have hcc : c + s - c = s := by ring
  rw [hcc] at hmono
  have hs0 : s ≠ 0 := hs.ne'
  have hId : (∫ x in c..c + s, f x) ^ 2 / s - 2 * f c * (∫ x in c..c + s, f x) + s * f c ^ 2 =
      ((∫ x in c..c + s, f x) - f c * s) ^ 2 / s := by
    field_simp; ring
  have hnn : 0 ≤ ((∫ x in c..c + s, f x) - f c * s) ^ 2 / s := div_nonneg (sq_nonneg _) hs.le
  rw [hvar]
  nlinarith [hmono, hId, hnn]

theorem mean_slice_bound (a b s : ℝ) (hs : 0 < s) (F F2 : ℝ × ℝ → ℝ) (hF : Continuous F) (hF2 : Continuous F2) (hd : ∀ x ∈ Set.Icc a (a + s), ∀ y ∈ Set.Ioo b (b + s), HasDerivAt (fun t => F (x, t)) (F2 (x, y)) y) : ∫ y in b..b + s, (∫ x in a..a + s, F (x, y)) ^ 2 ≤ (∫ y in b..b + s, ∫ x in a..a + s, F (x, y)) ^ 2 / s + s ^ 3 * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2 :=
by
  have h₁ : a ≤ a + s := by linarith
  have h₂ : b ≤ b + s := by linarith
  
  have CS : ∀ p q : ℝ, p ≤ q → ∀ h : ℝ → ℝ, ContinuousOn h (Set.Icc p q) →
      (∫ x in p..q, h x) ^ 2 ≤ (q - p) * ∫ x in p..q, h x ^ 2 := by
    intro p q hpq h hh
    have hi : IntervalIntegrable h volume p q := hh.intervalIntegrable_of_Icc hpq
    have hi2 : IntervalIntegrable (fun x => h x ^ 2) volume p q :=
      (hh.pow 2).intervalIntegrable_of_Icc hpq
    obtain ⟨J, hJ⟩ : ∃ J : ℝ, J = ∫ x in p..q, h x := ⟨_, rfl⟩
    obtain ⟨H0, hH0⟩ : ∃ H0 : ℝ, H0 = ∫ x in p..q, h x ^ 2 := ⟨_, rfl⟩
    rw [← hJ, ← hH0]
    have hnn : 0 ≤ ∫ x in p..q, ((q - p) * h x - J) ^ 2 :=
      intervalIntegral.integral_nonneg hpq (fun _ _ => sq_nonneg _)
    have hexp : ∫ x in p..q, ((q - p) * h x - J) ^ 2 = (q - p) * ((q - p) * H0 - J ^ 2) := by
      have e1 : ∀ x, ((q - p) * h x - J) ^ 2 =
          ((q - p) ^ 2 * h x ^ 2 - (2 * (q - p) * J) * h x) + J ^ 2 := fun x => by ring
      simp_rw [e1]
      rw [intervalIntegral.integral_add ((hi2.const_mul _).sub (hi.const_mul _))
          intervalIntegrable_const,
        intervalIntegral.integral_sub (hi2.const_mul _) (hi.const_mul _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const, smul_eq_mul, ← hJ, ← hH0]
      ring
    rw [hexp] at hnn
    rcases eq_or_lt_of_le hpq with hpq' | hpq'
    · subst hpq'
      have : J = 0 := by rw [hJ, intervalIntegral.integral_same]
      rw [this]; simp
    · have hL : 0 < q - p := by linarith
      have := (mul_nonneg_iff_of_pos_left hL).mp hnn
      linarith
  
  have hGc : Continuous (fun y => ∫ x in a..a + s, F (x, y)) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun y x => F (x, y)) (by exact hF.comp continuous_swap) a (a + s)
  have hHc : Continuous (fun x => ∫ y in b..b + s, F2 (x, y) ^ 2) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun x y => F2 (x, y) ^ 2) (by exact hF2.pow 2) b (b + s)
  have hFx : ∀ y : ℝ, Continuous (fun x => F (x, y)) := fun y =>
    hF.comp (continuous_id.prodMk continuous_const)
  have hFy : ∀ x : ℝ, Continuous (fun t => F (x, t)) := fun x =>
    hF.comp (continuous_const.prodMk continuous_id)
  have hF2y : ∀ x : ℝ, Continuous (fun t => F2 (x, t)) := fun x =>
    hF2.comp (continuous_const.prodMk continuous_id)
  
  have VAR : ∀ g : ℝ → ℝ, Continuous g → ∀ lam : ℝ,
      ∫ y in b..b + s, g y ^ 2 ≤ (∫ y in b..b + s, g y) ^ 2 / s + ∫ y in b..b + s, (g y - lam) ^ 2 := by
    intro g hg lam
    have hi : IntervalIntegrable g volume b (b + s) := hg.intervalIntegrable _ _
    have hi2 : IntervalIntegrable (fun x => g x ^ 2) volume b (b + s) :=
      (hg.pow 2).intervalIntegrable _ _
    obtain ⟨I, hI⟩ : ∃ I : ℝ, I = ∫ y in b..b + s, g y := ⟨_, rfl⟩
    obtain ⟨A, hA⟩ : ∃ A : ℝ, A = ∫ y in b..b + s, g y ^ 2 := ⟨_, rfl⟩
    have hexp : ∫ y in b..b + s, (g y - lam) ^ 2 = A - 2 * lam * I + s * lam ^ 2 := by
      have e1 : ∀ y, (g y - lam) ^ 2 = (g y ^ 2 - (2 * lam) * g y) + lam ^ 2 := fun y => by ring
      simp_rw [e1]
      rw [intervalIntegral.integral_add (hi2.sub (hi.const_mul _)) intervalIntegrable_const,
        intervalIntegral.integral_sub hi2 (hi.const_mul _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const, smul_eq_mul,
        ← hI, ← hA]
      ring
    rw [hexp, ← hI, ← hA]
    have hsq : (I - lam * s) ^ 2 / s = I ^ 2 / s - 2 * lam * I + s * lam ^ 2 := by
      field_simp
      ring
    have hnn : 0 ≤ (I - lam * s) ^ 2 / s := div_nonneg (sq_nonneg _) hs.le
    linarith
  
  have SEG : ∀ x ∈ Set.Icc a (a + s), ∀ y ∈ Set.Icc b (b + s),
      (F (x, y) - F (x, b)) ^ 2 ≤ s * ∫ t in b..b + s, F2 (x, t) ^ 2 := by
    intro x hx y hy
    have hftc : ∫ t in b..y, F2 (x, t) = F (x, y) - F (x, b) :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hy.1 (hFy x).continuousOn
        (fun t ht => hd x hx t ⟨ht.1, ht.2.trans_le hy.2⟩)
        ((hF2y x).intervalIntegrable _ _)
    have hcs := CS b y hy.1 (fun t => F2 (x, t)) (hF2y x).continuousOn
    rw [hftc] at hcs
    have hmono : ∫ t in b..y, F2 (x, t) ^ 2 ≤ ∫ t in b..b + s, F2 (x, t) ^ 2 :=
      intervalIntegral.integral_mono_interval le_rfl hy.1 hy.2
        (Filter.Eventually.of_forall fun t => sq_nonneg (F2 (x, t)))
        (((hF2y x).pow 2).intervalIntegrable _ _)
    have hnn : 0 ≤ ∫ t in b..y, F2 (x, t) ^ 2 :=
      intervalIntegral.integral_nonneg hy.1 (fun _ _ => sq_nonneg _)
    have hyb : y - b ≤ s := by linarith [hy.2]
    calc (F (x, y) - F (x, b)) ^ 2 ≤ (y - b) * ∫ t in b..y, F2 (x, t) ^ 2 := hcs
      _ ≤ s * ∫ t in b..b + s, F2 (x, t) ^ 2 := mul_le_mul hyb hmono hnn hs.le
  
  have PT : ∀ y ∈ Set.Icc b (b + s),
      ((∫ x in a..a + s, F (x, y)) - ∫ x in a..a + s, F (x, b)) ^ 2 ≤
        s * (s * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2) := by
    intro y hy
    have e1 : (∫ x in a..a + s, F (x, y)) - (∫ x in a..a + s, F (x, b)) =
        ∫ x in a..a + s, (F (x, y) - F (x, b)) :=
      (intervalIntegral.integral_sub ((hFx y).intervalIntegrable _ _)
        ((hFx b).intervalIntegrable _ _)).symm
    have hcs := CS a (a + s) h₁ (fun x => F (x, y) - F (x, b))
      ((hFx y).sub (hFx b)).continuousOn
    rw [add_sub_cancel_left] at hcs
    have hint : ∫ x in a..a + s, (F (x, y) - F (x, b)) ^ 2 ≤
        ∫ x in a..a + s, s * ∫ t in b..b + s, F2 (x, t) ^ 2 :=
      intervalIntegral.integral_mono_on h₁ ((((hFx y).sub (hFx b)).pow 2).intervalIntegrable _ _)
        ((continuous_const.mul hHc).intervalIntegrable _ _) (fun x hx => SEG x hx y hy)
    rw [intervalIntegral.integral_const_mul] at hint
    rw [e1]
    calc (∫ x in a..a + s, (F (x, y) - F (x, b))) ^ 2
        ≤ s * ∫ x in a..a + s, (F (x, y) - F (x, b)) ^ 2 := hcs
      _ ≤ s * (s * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2) :=
          mul_le_mul_of_nonneg_left hint hs.le
  
  have hB : ∫ y in b..b + s, ((∫ x in a..a + s, F (x, y)) - ∫ x in a..a + s, F (x, b)) ^ 2 ≤
      s ^ 3 * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2 := by
    have hm := intervalIntegral.integral_mono_on (μ := volume) h₂
      (((hGc.sub continuous_const).pow 2).intervalIntegrable b (b + s))
      (intervalIntegrable_const (c := s * (s * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2)))
      PT
    rw [intervalIntegral.integral_const, smul_eq_mul, add_sub_cancel_left] at hm
    calc _ ≤ _ := hm
      _ = _ := by ring
  have hA := VAR (fun y => ∫ x in a..a + s, F (x, y)) hGc (∫ x in a..a + s, F (x, b))
  simp only at hA
  linarith

theorem poincare_halfopen_square (W : Set E2) (hW : IsOpen W) (v : E2 → ℝ) (hv : ContDiffOn ℝ ∞ v W) (a b s : ℝ) (hs : 0 < s) (hsub : {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} ⊆ W) : ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, v x ^ 2 ≤ (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, v x) ^ 2 / s ^ 2 + s ^ 2 * ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, ∑ k : Fin 2, (pd2 k v x) ^ 2 :=
by
  have h₁ : a ≤ a + s := by linarith
  have h₂ : b ≤ b + s := by linarith
  
  have hvc : ContinuousOn v W := hv.continuousOn
  have hdc : ∀ k : Fin 2, ContinuousOn (pd2 k v) W := by
    intro k
    have h1 := hv.continuousOn_fderiv_of_isOpen hW (by simp)
    exact h1.clm_apply continuousOn_const
  have hdiff : ∀ p ∈ W, DifferentiableAt ℝ v p := fun p hp =>
    (hv.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hp)
  
  have hPcont : Continuous (fun z : ℝ × ℝ => (!₂[z.1, z.2] : E2)) := by
    have h : (fun z : ℝ × ℝ => (!₂[z.1, z.2] : E2)) = fun z => z.1 • e2 0 + z.2 • e2 1 := by
      funext z
      ext i
      fin_cases i <;> simp [EuclideanSpace.single_apply]
    rw [h]
    fun_prop
  have hS_mem : ∀ x y : ℝ, x ∈ Set.Icc a (a + s) → y ∈ Set.Icc b (b + s) →
      (!₂[x, y] : E2) ∈ {x : E2 | a ≤ x 0 ∧ x 0 ≤ a + s ∧ b ≤ x 1 ∧ x 1 ≤ b + s} := by
    intro x y hx hy
    exact ⟨hx.1, hx.2, hy.1, hy.2⟩
  
  have hline0 : ∀ x y : ℝ, HasDerivAt (fun t : ℝ => (!₂[t, y] : E2)) (e2 0) x := by
    intro x y
    have h : (fun t : ℝ => (!₂[t, y] : E2)) = fun t => (!₂[x, y] : E2) + (t - x) • e2 0 := by
      funext t
      ext i
      fin_cases i <;> simp [EuclideanSpace.single_apply]
    rw [h]
    have := (((hasDerivAt_id x).sub_const x).smul_const (e2 0)).const_add (!₂[x, y] : E2)
    simpa using this
  have hline1 : ∀ x y : ℝ, HasDerivAt (fun t : ℝ => (!₂[x, t] : E2)) (e2 1) y := by
    intro x y
    have h : (fun t : ℝ => (!₂[x, t] : E2)) = fun t => (!₂[x, y] : E2) + (t - y) • e2 1 := by
      funext t
      ext i
      fin_cases i <;> simp [EuclideanSpace.single_apply]
    rw [h]
    have := (((hasDerivAt_id y).sub_const y).smul_const (e2 1)).const_add (!₂[x, y] : E2)
    simpa using this
  have hsl0 : ∀ x y : ℝ, (!₂[x, y] : E2) ∈ W →
      HasDerivAt (fun t : ℝ => v !₂[t, y]) (pd2 0 v !₂[x, y]) x := by
    intro x y hxy
    exact (hdiff _ hxy).hasFDerivAt.comp_hasDerivAt x (hline0 x y)
  have hsl1 : ∀ x y : ℝ, (!₂[x, y] : E2) ∈ W →
      HasDerivAt (fun t : ℝ => v !₂[x, t]) (pd2 1 v !₂[x, y]) y := by
    intro x y hxy
    exact (hdiff _ hxy).hasFDerivAt.comp_hasDerivAt y (hline1 x y)
  
  obtain ⟨pa, hpadef⟩ : ∃ pa : ℝ → ℝ, pa = fun t => (Set.projIcc a (a + s) h₁ t : ℝ) :=
    ⟨_, rfl⟩
  obtain ⟨pb, hpbdef⟩ : ∃ pb : ℝ → ℝ, pb = fun t => (Set.projIcc b (b + s) h₂ t : ℝ) :=
    ⟨_, rfl⟩
  have hpa : Continuous pa := by rw [hpadef]; exact continuous_subtype_val.comp continuous_projIcc
  have hpb : Continuous pb := by rw [hpbdef]; exact continuous_subtype_val.comp continuous_projIcc
  have hpa_mem : ∀ t, pa t ∈ Set.Icc a (a + s) := fun t => by
    rw [hpadef]; exact (Set.projIcc a (a + s) h₁ t).2
  have hpb_mem : ∀ t, pb t ∈ Set.Icc b (b + s) := fun t => by
    rw [hpbdef]; exact (Set.projIcc b (b + s) h₂ t).2
  have hpa_eq : ∀ t ∈ Set.Icc a (a + s), pa t = t := fun t ht => by
    simp only [hpadef, Set.projIcc_of_mem h₁ ht]
  have hpb_eq : ∀ t ∈ Set.Icc b (b + s), pb t = t := fun t ht => by
    simp only [hpbdef, Set.projIcc_of_mem h₂ ht]
  obtain ⟨Pc, hPcdef⟩ : ∃ Pc : ℝ × ℝ → E2, ∀ z, Pc z = !₂[pa z.1, pb z.2] := ⟨_, fun _ => rfl⟩
  have hPc : Continuous Pc := by
    have e : Pc = (fun z : ℝ × ℝ => (!₂[z.1, z.2] : E2)) ∘ (fun z => (pa z.1, pb z.2)) :=
      funext fun z => hPcdef z
    rw [e]
    exact hPcont.comp ((hpa.comp continuous_fst).prodMk (hpb.comp continuous_snd))
  have hPc_W : ∀ z, Pc z ∈ W := fun z => by
    rw [hPcdef]; exact hsub (hS_mem _ _ (hpa_mem _) (hpb_mem _))
  have hPc_eq : ∀ x ∈ Set.Icc a (a + s), ∀ y ∈ Set.Icc b (b + s), Pc (x, y) = !₂[x, y] := by
    intro x hx y hy
    rw [hPcdef, hpa_eq x hx, hpb_eq y hy]
  obtain ⟨F, hFdef⟩ : ∃ F : ℝ × ℝ → ℝ, ∀ z, F z = v (Pc z) := ⟨_, fun _ => rfl⟩
  obtain ⟨F1, hF1def⟩ : ∃ F1 : ℝ × ℝ → ℝ, ∀ z, F1 z = pd2 0 v (Pc z) := ⟨_, fun _ => rfl⟩
  obtain ⟨F2, hF2def⟩ : ∃ F2 : ℝ × ℝ → ℝ, ∀ z, F2 z = pd2 1 v (Pc z) := ⟨_, fun _ => rfl⟩
  have hF : Continuous F := by
    have e : F = v ∘ Pc := funext fun z => hFdef z
    rw [e]; exact hvc.comp_continuous hPc hPc_W
  have hF1 : Continuous F1 := by
    have e : F1 = pd2 0 v ∘ Pc := funext fun z => hF1def z
    rw [e]; exact (hdc 0).comp_continuous hPc hPc_W
  have hF2 : Continuous F2 := by
    have e : F2 = pd2 1 v ∘ Pc := funext fun z => hF2def z
    rw [e]; exact (hdc 1).comp_continuous hPc hPc_W
  
  have hD1 : ∀ y ∈ Set.Icc b (b + s), ∀ x ∈ Set.Ioo a (a + s),
      HasDerivAt (fun t => F (t, y)) (F1 (x, y)) x := by
    intro y hy x hx
    have hxI : x ∈ Set.Icc a (a + s) := Set.Ioo_subset_Icc_self hx
    have h1 := hsl0 x y (hsub (hS_mem x y hxI hy))
    have hev : (fun t => F (t, y)) =ᶠ[𝓝 x] (fun t => v !₂[t, y]) := by
      filter_upwards [Ioo_mem_nhds hx.1 hx.2] with t ht
      rw [hFdef, hPc_eq t (Set.Ioo_subset_Icc_self ht) y hy]
    rw [hF1def, hPc_eq x hxI y hy]
    exact h1.congr_of_eventuallyEq hev
  have hD2 : ∀ x ∈ Set.Icc a (a + s), ∀ y ∈ Set.Ioo b (b + s),
      HasDerivAt (fun t => F (x, t)) (F2 (x, y)) y := by
    intro x hx y hy
    have hyI : y ∈ Set.Icc b (b + s) := Set.Ioo_subset_Icc_self hy
    have h1 := hsl1 x y (hsub (hS_mem x y hx hyI))
    have hev : (fun t => F (x, t)) =ᶠ[𝓝 y] (fun t => v !₂[x, t]) := by
      filter_upwards [Ioo_mem_nhds hy.1 hy.2] with t ht
      rw [hFdef, hPc_eq x hx t (Set.Ioo_subset_Icc_self ht)]
    rw [hF2def, hPc_eq x hx y hyI]
    exact h1.congr_of_eventuallyEq hev
  
  have hGc : Continuous (fun y => ∫ x in a..a + s, F (x, y)) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun y x => F (x, y)) (by exact hF.comp continuous_swap) a (a + s)
  have hAc : Continuous (fun y => ∫ x in a..a + s, F (x, y) ^ 2) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun y x => F (x, y) ^ 2) (by exact (hF.comp continuous_swap).pow 2) a (a + s)
  have hBc : Continuous (fun y => ∫ x in a..a + s, F1 (x, y) ^ 2) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun y x => F1 (x, y) ^ 2) (by exact (hF1.comp continuous_swap).pow 2) a (a + s)
  have hi : ∀ y ∈ Set.Icc b (b + s), (∫ x in a..a + s, F (x, y) ^ 2) ≤
      (∫ x in a..a + s, F (x, y)) ^ 2 / s + s ^ 2 * ∫ x in a..a + s, F1 (x, y) ^ 2 := by
    intro y hy
    have hc0 : Continuous (fun t => F (t, y)) := by fun_prop
    have hc1 : Continuous (fun t => F1 (t, y)) := by fun_prop
    exact poincare_interval a s hs (fun t => F (t, y)) (fun t => F1 (t, y)) hc0.continuousOn
      hc1.continuousOn (hD1 y hy)
  have hG2i : IntervalIntegrable (fun y => (∫ x in a..a + s, F (x, y)) ^ 2 / s) volume b (b + s) :=
    ((hGc.pow 2).div_const s).intervalIntegrable b (b + s)
  have hBi : IntervalIntegrable (fun y => s ^ 2 * ∫ x in a..a + s, F1 (x, y) ^ 2) volume b (b + s) :=
    (continuous_const.mul hBc).intervalIntegrable b (b + s)
  have hii : (∫ y in b..b + s, ∫ x in a..a + s, F (x, y) ^ 2) ≤
      (∫ y in b..b + s, (∫ x in a..a + s, F (x, y)) ^ 2) / s +
        s ^ 2 * ∫ y in b..b + s, ∫ x in a..a + s, F1 (x, y) ^ 2 := by
    have hmono := intervalIntegral.integral_mono_on
      (f := fun y => ∫ x in a..a + s, F (x, y) ^ 2)
      (g := fun y => (∫ x in a..a + s, F (x, y)) ^ 2 / s + s ^ 2 * ∫ x in a..a + s, F1 (x, y) ^ 2)
      h₂ (hAc.intervalIntegrable b (b + s)) (hG2i.add hBi) hi
    have hsplit : (∫ y in b..b + s,
        ((∫ x in a..a + s, F (x, y)) ^ 2 / s + s ^ 2 * ∫ x in a..a + s, F1 (x, y) ^ 2)) =
        (∫ y in b..b + s, (∫ x in a..a + s, F (x, y)) ^ 2) / s +
          s ^ 2 * ∫ y in b..b + s, ∫ x in a..a + s, F1 (x, y) ^ 2 := by
      rw [intervalIntegral.integral_add hG2i hBi, intervalIntegral.integral_div,
        intervalIntegral.integral_const_mul]
    rw [← hsplit]
    exact hmono
  have hiii := mean_slice_bound a b s hs F F2 hF hF2 hD2
  have hstar : (∫ y in b..b + s, ∫ x in a..a + s, F (x, y) ^ 2) ≤
      (∫ y in b..b + s, ∫ x in a..a + s, F (x, y)) ^ 2 / s ^ 2 +
        s ^ 2 * ((∫ y in b..b + s, ∫ x in a..a + s, F1 (x, y) ^ 2) +
          ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2) := by
    have hdiv := div_le_div_of_nonneg_right hiii hs.le
    have e : ((∫ y in b..b + s, ∫ x in a..a + s, F (x, y)) ^ 2 / s +
        s ^ 3 * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2) / s =
        (∫ y in b..b + s, ∫ x in a..a + s, F (x, y)) ^ 2 / s ^ 2 +
          s ^ 2 * ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2 := by
      field_simp
    rw [e] at hdiv
    nlinarith [hii, hdiv]
  
  have hcongrY : ∀ (H : E2 → ℝ) (Hc : ℝ × ℝ → ℝ), (∀ z, Hc z = H (Pc z)) →
      (∫ y in b..b + s, ∫ x in a..a + s, H !₂[x, y]) =
        ∫ y in b..b + s, ∫ x in a..a + s, Hc (x, y) := by
    intro H Hc hH
    refine intervalIntegral.integral_congr (fun y hy => ?_)
    dsimp only
    refine intervalIntegral.integral_congr (fun x hx => ?_)
    dsimp only
    rw [Set.uIcc_of_le h₂] at hy
    rw [Set.uIcc_of_le h₁] at hx
    rw [hH, hPc_eq x hx y hy]
  have hcongrX : ∀ (H : E2 → ℝ) (Hc : ℝ × ℝ → ℝ), (∀ z, Hc z = H (Pc z)) →
      (∫ x in a..a + s, ∫ y in b..b + s, H !₂[x, y]) =
        ∫ x in a..a + s, ∫ y in b..b + s, Hc (x, y) := by
    intro H Hc hH
    refine intervalIntegral.integral_congr (fun x hx => ?_)
    dsimp only
    refine intervalIntegral.integral_congr (fun y hy => ?_)
    dsimp only
    rw [Set.uIcc_of_le h₂] at hy
    rw [Set.uIcc_of_le h₁] at hx
    rw [hH, hPc_eq x hx y hy]
  have hT1 := square_iterated_integral (fun x => v x ^ 2) a b s hs ((hvc.mono hsub).pow 2)
  have hT2 := square_iterated_integral v a b s hs (hvc.mono hsub)
  have hT3 := square_iterated_integral (fun x => pd2 0 v x ^ 2) a b s hs
    (((hdc 0).mono hsub).pow 2)
  have hT4 := square_iterated_integral (fun x => pd2 1 v x ^ 2) a b s hs
    (((hdc 1).mono hsub).pow 2)
  have eA : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, v x ^ 2) =
      ∫ y in b..b + s, ∫ x in a..a + s, F (x, y) ^ 2 :=
    hT1.2.1.trans (hcongrY (fun x => v x ^ 2) (fun z => F z ^ 2) (fun z => by simp only [hFdef]))
  have eX : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, v x) =
      ∫ y in b..b + s, ∫ x in a..a + s, F (x, y) :=
    hT2.2.1.trans (hcongrY v F hFdef)
  have eB : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, pd2 0 v x ^ 2) =
      ∫ y in b..b + s, ∫ x in a..a + s, F1 (x, y) ^ 2 :=
    hT3.2.1.trans (hcongrY (fun x => pd2 0 v x ^ 2) (fun z => F1 z ^ 2)
      (fun z => by simp only [hF1def]))
  have eK : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, pd2 1 v x ^ 2) =
      ∫ x in a..a + s, ∫ y in b..b + s, F2 (x, y) ^ 2 :=
    hT4.2.2.trans (hcongrX (fun x => pd2 1 v x ^ 2) (fun z => F2 z ^ 2)
      (fun z => by simp only [hF2def]))
  have hsum : (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s},
      ∑ k : Fin 2, (pd2 k v x) ^ 2) =
      (∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, pd2 0 v x ^ 2) +
        ∫ x in {x : E2 | a ≤ x 0 ∧ x 0 < a + s ∧ b ≤ x 1 ∧ x 1 < b + s}, pd2 1 v x ^ 2 := by
    simp only [Fin.sum_univ_two]
    exact integral_add hT3.1 hT4.1
  rw [hsum, eA, eX, eB, eK]
  exact hstar

theorem grid_square_facts (s : ℝ) (hs : 0 < s) : (∀ z : ℤ × ℤ, IsCompact {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧ x 0 ≤ (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 ≤ (z.2 : ℝ) * s + s}) ∧ (∀ z : ℤ × ℤ, MeasurableSet {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧ x 0 < (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 < (z.2 : ℝ) * s + s}) ∧ ∀ z z' : ℤ × ℤ, z ≠ z' → Disjoint {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧ x 0 < (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 < (z.2 : ℝ) * s + s} {x : E2 | (z'.1 : ℝ) * s ≤ x 0 ∧ x 0 < (z'.1 : ℝ) * s + s ∧ (z'.2 : ℝ) * s ≤ x 1 ∧ x 1 < (z'.2 : ℝ) * s + s} :=
by
  have h0 : Continuous (fun x : E2 => x 0) := (EuclideanSpace.proj (0 : Fin 2)).continuous
  have h1 : Continuous (fun x : E2 => x 1) := (EuclideanSpace.proj (1 : Fin 2)).continuous
  have key : ∀ (k k' : ℤ) (t : ℝ), (k : ℝ) * s ≤ t → t < (k' : ℝ) * s + s → k ≤ k' := by
    intro k k' t hk hk'
    have hlt : ((k : ℝ) - k' - 1) * s < 0 := by nlinarith
    have hr : (k : ℝ) - k' - 1 < 0 := by
      by_contra hc
      push_neg at hc
      nlinarith
    have hr' : (k : ℝ) < (k' : ℝ) + 1 := by linarith
    have : k < k' + 1 := by exact_mod_cast hr'
    omega
  refine ⟨fun z => ?_, fun z => ?_, fun z z' hne => ?_⟩
  · have hcl : IsClosed {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧ x 0 ≤ (z.1 : ℝ) * s + s ∧
        (z.2 : ℝ) * s ≤ x 1 ∧ x 1 ≤ (z.2 : ℝ) * s + s} :=
      (isClosed_le continuous_const h0).inter ((isClosed_le h0 continuous_const).inter
        ((isClosed_le continuous_const h1).inter (isClosed_le h1 continuous_const)))
    refine Metric.isCompact_of_isClosed_isBounded hcl ?_
    rw [Metric.isBounded_iff_subset_closedBall (0 : E2)]
    refine ⟨2 * (|(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s), ?_⟩
    intro x hx
    obtain ⟨ha1, ha2, hb1, hb2⟩ := hx
    have hA := abs_nonneg ((z.1 : ℝ) * s)
    have hB := abs_nonneg ((z.2 : ℝ) * s)
    have hA1 := neg_abs_le ((z.1 : ℝ) * s)
    have hA2 := le_abs_self ((z.1 : ℝ) * s)
    have hB1 := neg_abs_le ((z.2 : ℝ) * s)
    have hB2 := le_abs_self ((z.2 : ℝ) * s)
    have hx0l : -(|(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s) ≤ x 0 := by linarith
    have hx0u : x 0 ≤ |(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s := by linarith
    have hx1l : -(|(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s) ≤ x 1 := by linarith
    have hx1u : x 1 ≤ |(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s := by linarith
    have hs0 : x 0 ^ 2 ≤ (|(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s) ^ 2 := by nlinarith
    have hs1 : x 1 ^ 2 ≤ (|(z.1 : ℝ) * s| + |(z.2 : ℝ) * s| + s) ^ 2 := by nlinarith
    rw [mem_closedBall_zero_iff, EuclideanSpace.norm_eq, Fin.sum_univ_two, Real.norm_eq_abs,
      Real.norm_eq_abs, sq_abs, sq_abs, Real.sqrt_le_iff]
    constructor
    · linarith
    · nlinarith
  · exact (measurableSet_le measurable_const h0.measurable).inter
      ((measurableSet_lt h0.measurable measurable_const).inter
        ((measurableSet_le measurable_const h1.measurable).inter
          (measurableSet_lt h1.measurable measurable_const)))
  · rw [Set.disjoint_left]
    rintro x ⟨a1, a2, b1, b2⟩ ⟨c1, c2, d1, d2⟩
    apply hne
    have e1 : z.1 = z'.1 := le_antisymm (key _ _ _ a1 c2) (key _ _ _ c1 a2)
    have e2 : z.2 = z'.2 := le_antisymm (key _ _ _ b1 d2) (key _ _ _ d1 b2)
    exact Prod.ext e1 e2

theorem grid_cover_compact (L : Set E2) (hL : IsCompact L) (s : ℝ) (hs : 0 < s) : ∃ Z : Finset (ℤ × ℤ), (∀ x ∈ L, ∃ z ∈ Z, (z.1 : ℝ) * s ≤ x 0 ∧ x 0 < (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 < (z.2 : ℝ) * s + s) ∧ ∀ z ∈ Z, ∃ y ∈ L, ∀ x : E2, (z.1 : ℝ) * s ≤ x 0 → x 0 ≤ (z.1 : ℝ) * s + s → (z.2 : ℝ) * s ≤ x 1 → x 1 ≤ (z.2 : ℝ) * s + s → dist x y ≤ 2 * s :=
by
  classical
  obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_closedBall (0 : E2)).mp hL.isBounded
  have hcoord : ∀ x ∈ L, ∀ i : Fin 2, -R ≤ x i ∧ x i ≤ R := by
    intro x hx i
    have h1 : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp (hR hx)
    have h2 : ‖x.ofLp i‖ ≤ ‖x‖ := PiLp.norm_apply_le x i
    rw [Real.norm_eq_abs] at h2
    exact abs_le.mp (h2.trans h1)
  have hfl1 : ∀ t : ℝ, ((⌊t / s⌋ : ℤ) : ℝ) * s ≤ t := by
    intro t
    have h := Int.floor_le (t / s)
    rwa [le_div_iff₀ hs] at h
  have hfl2 : ∀ t : ℝ, t < ((⌊t / s⌋ : ℤ) : ℝ) * s + s := by
    intro t
    have h := Int.lt_floor_add_one (t / s)
    rw [div_lt_iff₀ hs] at h
    linarith
  have hbox : ∀ t : ℝ, -R ≤ t → t ≤ R → ⌊-R / s⌋ ≤ ⌊t / s⌋ ∧ ⌊t / s⌋ ≤ ⌊R / s⌋ := by
    intro t h1 h2
    exact ⟨Int.floor_le_floor (div_le_div_of_nonneg_right h1 hs.le),
      Int.floor_le_floor (div_le_div_of_nonneg_right h2 hs.le)⟩
  refine ⟨(Finset.Icc ⌊-R / s⌋ ⌊R / s⌋ ×ˢ Finset.Icc ⌊-R / s⌋ ⌊R / s⌋).filter
      (fun z : ℤ × ℤ => ∃ y ∈ L, ⌊y 0 / s⌋ = z.1 ∧ ⌊y 1 / s⌋ = z.2), ?_, ?_⟩
  · intro x hx
    refine ⟨(⌊x 0 / s⌋, ⌊x 1 / s⌋), ?_, hfl1 _, hfl2 _, hfl1 _, hfl2 _⟩
    rw [Finset.mem_filter, Finset.mem_product, Finset.mem_Icc, Finset.mem_Icc]
    obtain ⟨a0, b0⟩ := hcoord x hx 0
    obtain ⟨a1, b1⟩ := hcoord x hx 1
    exact ⟨⟨hbox _ a0 b0, hbox _ a1 b1⟩, x, hx, rfl, rfl⟩
  · rintro ⟨z1, z2⟩ hz
    rw [Finset.mem_filter] at hz
    obtain ⟨-, y, hy, h1, h2⟩ := hz
    have e1 : z1 = ⌊y 0 / s⌋ := h1.symm
    have e2 : z2 = ⌊y 1 / s⌋ := h2.symm
    subst e1 e2
    refine ⟨y, hy, fun x hx0 hx0' hx1 hx1' => ?_⟩
    have hx0a : ((⌊y 0 / s⌋ : ℤ) : ℝ) * s ≤ x 0 := hx0
    have hx0b : x 0 ≤ ((⌊y 0 / s⌋ : ℤ) : ℝ) * s + s := hx0'
    have hx1a : ((⌊y 1 / s⌋ : ℤ) : ℝ) * s ≤ x 1 := hx1
    have hx1b : x 1 ≤ ((⌊y 1 / s⌋ : ℤ) : ℝ) * s + s := hx1'
    have hy0 := hfl1 (y 0)
    have hy0' := hfl2 (y 0)
    have hy1 := hfl1 (y 1)
    have hy1' := hfl2 (y 1)
    have hd0 : (x 0 - y 0) ^ 2 ≤ s ^ 2 := sq_le_sq' (by linarith) (by linarith)
    have hd1 : (x 1 - y 1) ^ 2 ≤ s ^ 2 := sq_le_sq' (by linarith) (by linarith)
    rw [EuclideanSpace.dist_eq, Fin.sum_univ_two, Real.dist_eq, Real.dist_eq, sq_abs, sq_abs]
    rw [Real.sqrt_le_iff]
    refine ⟨by linarith, ?_⟩
    nlinarith [sq_nonneg s]

theorem cell_sum_bound (K L : Set E2) (hK : IsCompact K) (Z : Finset (ℤ × ℤ)) (Q : ℤ × ℤ → Set E2) (hQm : ∀ z ∈ Z, MeasurableSet (Q z)) (hQd : ∀ z ∈ Z, ∀ z' ∈ Z, z ≠ z' → Disjoint (Q z) (Q z')) (hQK : ∀ z ∈ Z, Q z ⊆ K) (hLQ : L ⊆ ⋃ z ∈ Z, Q z) (F G : E2 → ℝ) (hF : ContinuousOn F K) (hG : ContinuousOn G K) (hF0 : ∀ x, 0 ≤ F x) (hG0 : ∀ x, 0 ≤ G x) (c : ℤ × ℤ → ℝ) (t : ℝ) (ht : 0 ≤ t) (hcell : ∀ z ∈ Z, ∫ x in Q z, F x ≤ c z + t * ∫ x in Q z, G x) : ∫ x in L, F x ≤ (∑ z ∈ Z, c z) + t * ∫ x in K, G x :=
by
  have hFK : MeasureTheory.IntegrableOn F K := hF.integrableOn_compact hK
  have hGK : MeasureTheory.IntegrableOn G K := hG.integrableOn_compact hK
  have hUK : (⋃ z ∈ Z, Q z) ⊆ K := Set.iUnion₂_subset (fun z hz => hQK z hz)
  have hFU : MeasureTheory.IntegrableOn F (⋃ z ∈ Z, Q z) := hFK.mono_set hUK
  have hpw : (↑Z : Set (ℤ × ℤ)).Pairwise (Function.onFun Disjoint Q) :=
    fun z hz z' hz' hne => hQd z (Finset.mem_coe.1 hz) z' (Finset.mem_coe.1 hz') hne
  have hA : ∫ x in L, F x ≤ ∫ x in ⋃ z ∈ Z, Q z, F x :=
    MeasureTheory.setIntegral_mono_set hFU (Filter.Eventually.of_forall hF0) hLQ.eventuallyLE
  have hB : ∫ x in ⋃ z ∈ Z, Q z, F x = ∑ z ∈ Z, ∫ x in Q z, F x :=
    MeasureTheory.integral_biUnion_finset Z hQm hpw (fun z hz => hFK.mono_set (hQK z hz))
  have hB' : ∫ x in ⋃ z ∈ Z, Q z, G x = ∑ z ∈ Z, ∫ x in Q z, G x :=
    MeasureTheory.integral_biUnion_finset Z hQm hpw (fun z hz => hGK.mono_set (hQK z hz))
  have hC : ∑ z ∈ Z, ∫ x in Q z, F x ≤ ∑ z ∈ Z, (c z + t * ∫ x in Q z, G x) :=
    Finset.sum_le_sum (fun z hz => hcell z hz)
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← hB'] at hC
  have hD0 : ∫ x in ⋃ z ∈ Z, Q z, G x ≤ ∫ x in K, G x :=
    MeasureTheory.setIntegral_mono_set hGK (Filter.Eventually.of_forall hG0) hUK.eventuallyLE
  have hD : t * ∫ x in ⋃ z ∈ Z, Q z, G x ≤ t * ∫ x in K, G x :=
    mul_le_mul_of_nonneg_left hD0 ht
  linarith

theorem cell_integral_abs_bound (K Q : Set E2) (hK : IsCompact K) (hQ : MeasurableSet Q) (hQK : Q ⊆ K) (f : E2 → ℝ) (hf : ContinuousOn f K) : |∫ x in Q, f x| ≤ (volume.real K + ∫ x in K, f x ^ 2) / 2 :=
by
  have hKm : MeasurableSet K := hK.measurableSet
  have habsK : MeasureTheory.IntegrableOn (fun x => |f x|) K MeasureTheory.volume :=
    hf.abs.integrableOn_compact hK
  have hsqK : MeasureTheory.IntegrableOn (fun x => f x ^ 2) K MeasureTheory.volume :=
    (hf.pow 2).integrableOn_compact hK
  have honeK : MeasureTheory.IntegrableOn (fun _ : E2 => (1 : ℝ)) K MeasureTheory.volume :=
    continuousOn_const.integrableOn_compact hK
  have h1 : |∫ x in Q, f x| ≤ ∫ x in Q, |f x| :=
    MeasureTheory.abs_integral_le_integral_abs
  have h2 : ∫ x in Q, |f x| ≤ ∫ x in K, |f x| :=
    MeasureTheory.setIntegral_mono_set habsK
      (Filter.Eventually.of_forall (fun x => abs_nonneg (f x))) hQK.eventuallyLE
  have h3 : ∫ x in K, |f x| ≤ ∫ x in K, (1 + f x ^ 2) / 2 :=
    MeasureTheory.setIntegral_mono_on habsK ((honeK.add hsqK).div_const 2) hKm
      (fun x _ => by nlinarith [sq_nonneg (|f x| - 1), sq_abs (f x)])
  have h4 : ∫ x in K, (1 + f x ^ 2) / 2 = (volume.real K + ∫ x in K, f x ^ 2) / 2 := by
    rw [MeasureTheory.integral_div, MeasureTheory.integral_add honeK hsqK,
      MeasureTheory.setIntegral_const, smul_eq_mul, mul_one]
  linarith

theorem rellich_local_cauchy (W : Set E2) (hW : IsOpen W) (u : ℕ → E2 → ℝ) (hu : ∀ n, ContDiffOn ℝ ∞ (u n) W) (hbd : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, ∀ n, ∫ x in L, ((u n x) ^ 2 + ∑ k : Fin 2, (pd2 k (u n) x) ^ 2) ≤ C) : ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ L : Set E2, IsCompact L → L ⊆ W → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l → ∫ x in L, (u (ψ m) x - u (ψ l) x) ^ 2 < ε :=
by
  classical
  
  have hUc : ∀ n, ContinuousOn (u n) W := fun n => (hu n).continuousOn
  have hdc : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ k : Fin 2, ContinuousOn (pd2 k f) W := by
    intro f hf k
    have h1 := hf.continuousOn_fderiv_of_isOpen hW (by simp)
    exact h1.clm_apply continuousOn_const
  have hGc : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      ContinuousOn (fun x => ∑ k : Fin 2, (pd2 k f x) ^ 2) W := by
    intro f hf
    exact continuousOn_finset_sum _ (fun k _ => (hdc f hf k).pow 2)
  have hHc : ∀ n, ContinuousOn (fun x => (u n x) ^ 2 + ∑ k : Fin 2, (pd2 k (u n) x) ^ 2) W :=
    fun n => ((hUc n).pow 2).add (hGc _ (hu n))
  have hsq_le : ∀ K : Set E2, IsCompact K → K ⊆ W → ∀ n,
      ∫ x in K, (u n x) ^ 2 ≤ ∫ x in K, ((u n x) ^ 2 + ∑ k : Fin 2, (pd2 k (u n) x) ^ 2) := by
    intro K hK hKW n
    refine setIntegral_mono_on (((hUc n).pow 2).mono hKW |>.integrableOn_compact hK)
      ((hHc n).mono hKW |>.integrableOn_compact hK) hK.measurableSet (fun x _ => ?_)
    have : 0 ≤ ∑ k : Fin 2, (pd2 k (u n) x) ^ 2 := Finset.sum_nonneg (fun k _ => sq_nonneg _)
    linarith
  
  obtain ⟨Qo, hQo⟩ : ∃ Qo : ℝ → ℤ × ℤ → Set E2, ∀ s z, Qo s z = {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧
      x 0 < (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 < (z.2 : ℝ) * s + s} :=
    ⟨_, fun _ _ => rfl⟩
  obtain ⟨Qc, hQc⟩ : ∃ Qc : ℝ → ℤ × ℤ → Set E2, ∀ s z, Qc s z = {x : E2 | (z.1 : ℝ) * s ≤ x 0 ∧
      x 0 ≤ (z.1 : ℝ) * s + s ∧ (z.2 : ℝ) * s ≤ x 1 ∧ x 1 ≤ (z.2 : ℝ) * s + s} :=
    ⟨_, fun _ _ => rfl⟩
  have hQcpt : ∀ s, 0 < s → ∀ z, IsCompact (Qc s z) := by
    intro s hs z; rw [hQc]; exact (grid_square_facts s hs).1 z
  have hQmeas : ∀ s, 0 < s → ∀ z, MeasurableSet (Qo s z) := by
    intro s hs z; rw [hQo]; exact (grid_square_facts s hs).2.1 z
  have hQdisj : ∀ s, 0 < s → ∀ z z', z ≠ z' → Disjoint (Qo s z) (Qo s z') := by
    intro s hs z z' hzz; rw [hQo, hQo]; exact (grid_square_facts s hs).2.2 z z' hzz
  have hQoc : ∀ s z, Qo s z ⊆ Qc s z := by
    intro s z x hx
    rw [hQo] at hx
    rw [hQc]
    exact ⟨hx.1, hx.2.1.le, hx.2.2.1, hx.2.2.2.le⟩
  have hpoin : ∀ v : E2 → ℝ, ContDiffOn ℝ ∞ v W → ∀ s, 0 < s → ∀ z, Qc s z ⊆ W →
      ∫ x in Qo s z, v x ^ 2 ≤ (∫ x in Qo s z, v x) ^ 2 / s ^ 2 +
        s ^ 2 * ∫ x in Qo s z, ∑ k : Fin 2, (pd2 k v x) ^ 2 := by
    intro v hv s hs z hsub
    rw [hQc] at hsub
    rw [hQo]
    exact poincare_halfopen_square W hW v hv _ _ s hs hsub
  have hcover : ∀ L : Set E2, IsCompact L → ∀ s, 0 < s → ∃ Z : Finset (ℤ × ℤ),
      (∀ x ∈ L, ∃ z ∈ Z, x ∈ Qo s z) ∧ ∀ z ∈ Z, ∃ y ∈ L, ∀ x ∈ Qc s z, dist x y ≤ 2 * s := by
    intro L hL s hs
    obtain ⟨Z, h1, h2⟩ := grid_cover_compact L hL s hs
    refine ⟨Z, fun x hx => ?_, fun z hz => ?_⟩
    · obtain ⟨z, hz, h⟩ := h1 x hx
      exact ⟨z, hz, by rw [hQo]; exact h⟩
    · obtain ⟨y, hy, h⟩ := h2 z hz
      refine ⟨y, hy, fun x hx => ?_⟩
      rw [hQc] at hx
      exact h x hx.1 hx.2.1 hx.2.2.1 hx.2.2.2
  
  obtain ⟨a, ha⟩ : ∃ a : ℕ → ℕ × ℤ × ℤ → ℝ, ∀ n j z, a n (j, z) =
      if Qc (1 / ((j : ℝ) + 1)) z ⊆ W then ∫ x in Qo (1 / ((j : ℝ) + 1)) z, u n x else 0 :=
    ⟨fun n d => if Qc (1 / ((d.1 : ℝ) + 1)) d.2 ⊆ W then
      ∫ x in Qo (1 / ((d.1 : ℝ) + 1)) d.2, u n x else 0, fun _ _ _ => rfl⟩
  have hb : ∀ d : ℕ × ℤ × ℤ, ∃ R : ℝ, ∀ n, |a n d| ≤ R := by
    rintro ⟨j, z⟩
    have hs : (0 : ℝ) < 1 / ((j : ℝ) + 1) := by positivity
    by_cases hsub : Qc (1 / ((j : ℝ) + 1)) z ⊆ W
    · obtain ⟨C, hC⟩ := hbd _ (hQcpt _ hs z) hsub
      refine ⟨(volume.real (Qc (1 / ((j : ℝ) + 1)) z) + C) / 2, fun n => ?_⟩
      rw [ha, if_pos hsub]
      have h1 := cell_integral_abs_bound _ _ (hQcpt _ hs z) (hQmeas _ hs z) (hQoc _ z) (u n)
        ((hUc n).mono hsub)
      have h2 := hsq_le _ (hQcpt _ hs z) hsub n
      have h3 := hC n
      linarith
    · refine ⟨0, fun n => ?_⟩
      rw [ha, if_neg hsub]
      simp
  obtain ⟨ψ, hψ, hcau⟩ := bounded_seq_countable_diag a hb
  refine ⟨ψ, hψ, fun L hL hLW ε hε => ?_⟩
  
  obtain ⟨δ, hδ, hK'W⟩ := hL.exists_cthickening_subset_open hW hLW
  have hK' : IsCompact (cthickening δ L) := hL.cthickening
  obtain ⟨C', hC'⟩ := hbd _ hK' hK'W
  have hCp : 0 < |C'| + 1 := by positivity
  have hτ : 0 < min (δ / 2) (ε / (8 * (|C'| + 1))) := lt_min (by linarith) (by positivity)
  obtain ⟨j, hj⟩ := exists_nat_one_div_lt hτ
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = 1 / ((j : ℝ) + 1) := ⟨_, rfl⟩
  rw [← hsdef] at hj
  have hs : 0 < s := by rw [hsdef]; positivity
  have hs1 : s ≤ 1 := by
    rw [hsdef]
    have : (1 : ℝ) ≤ (j : ℝ) + 1 := by have := (Nat.cast_nonneg j : (0 : ℝ) ≤ j); linarith
    exact (div_le_one (by positivity)).mpr this
  have hs2δ : 2 * s < δ := by
    have := lt_of_lt_of_le hj (min_le_left _ _)
    linarith
  have hsε : 8 * s * (|C'| + 1) < ε := by
    have h := lt_of_lt_of_le hj (min_le_right _ _)
    rw [lt_div_iff₀ (by positivity)] at h
    linarith
  have ha' : ∀ n z, a n (j, z) = if Qc s z ⊆ W then ∫ x in Qo s z, u n x else 0 := by
    intro n z; rw [ha, hsdef]
  obtain ⟨Z, hZcov, hZnear⟩ := hcover L hL s hs
  have hQcK : ∀ z ∈ Z, Qc s z ⊆ cthickening δ L := by
    intro z hz x hx
    obtain ⟨y, hy, hd⟩ := hZnear z hz
    exact Metric.mem_cthickening_of_dist_le x y δ L hy (by linarith [hd x hx])
  have hQcW : ∀ z ∈ Z, Qc s z ⊆ W := fun z hz => (hQcK z hz).trans hK'W
  have hcard : (0 : ℝ) < 2 * ((Z.card : ℝ) + 1) := by positivity
  have hη : 0 < min 1 (ε * s ^ 2 / (2 * ((Z.card : ℝ) + 1))) := lt_min one_pos (by positivity)
  have hc := fun z : ℤ × ℤ => hcau (j, z) _ hη
  choose Nf hNf using hc
  refine ⟨Z.sup Nf, fun m l hm hl => ?_⟩
  
  have hf : ContDiffOn ℝ ∞ (fun x => u (ψ m) x - u (ψ l) x) W := (hu _).sub (hu _)
  have hint : ∀ n z, z ∈ Z → IntegrableOn (u n) (Qo s z) := fun n z hz =>
    (((hUc n).mono (hQcW z hz)).integrableOn_compact (hQcpt s hs z)).mono_set (hQoc s z)
  have hD : ∀ z ∈ Z, (∫ x in Qo s z, (u (ψ m) x - u (ψ l) x)) ^ 2 / s ^ 2 ≤
      ε / (2 * ((Z.card : ℝ) + 1)) := by
    intro z hz
    have heq : ∫ x in Qo s z, (u (ψ m) x - u (ψ l) x) = a (ψ m) (j, z) - a (ψ l) (j, z) := by
      rw [ha', ha', if_pos (hQcW z hz), if_pos (hQcW z hz)]
      exact integral_sub (hint _ z hz) (hint _ z hz)
    have hlt := hNf z m l (le_trans (Finset.le_sup hz) hm) (le_trans (Finset.le_sup hz) hl)
    rw [heq]
    set D := a (ψ m) (j, z) - a (ψ l) (j, z)
    set η := min 1 (ε * s ^ 2 / (2 * ((Z.card : ℝ) + 1))) with hηdef
    have hη1 : η ≤ 1 := min_le_left _ _
    have hη2 : η ≤ ε * s ^ 2 / (2 * ((Z.card : ℝ) + 1)) := min_le_right _ _
    have habs : 0 ≤ |D| := abs_nonneg D
    have hDsq : D ^ 2 = |D| ^ 2 := (sq_abs D).symm
    have hmul : |D| * |D| ≤ η * η := mul_le_mul hlt.le hlt.le habs hη.le
    have hD2 : D ^ 2 ≤ η := by nlinarith
    rw [div_le_iff₀ (by positivity)]
    calc D ^ 2 ≤ ε * s ^ 2 / (2 * ((Z.card : ℝ) + 1)) := le_trans hD2 hη2
      _ = ε / (2 * ((Z.card : ℝ) + 1)) * s ^ 2 := by ring
  have hsumD : ∑ z ∈ Z, (∫ x in Qo s z, (u (ψ m) x - u (ψ l) x)) ^ 2 / s ^ 2 ≤ ε / 2 := by
    have h1 := Finset.sum_le_card_nsmul Z
      (fun z => (∫ x in Qo s z, (u (ψ m) x - u (ψ l) x)) ^ 2 / s ^ 2)
      (ε / (2 * ((Z.card : ℝ) + 1))) hD
    rw [nsmul_eq_mul] at h1
    have h2 : (Z.card : ℝ) * (ε / (2 * ((Z.card : ℝ) + 1))) ≤ ε / 2 := by
      rw [mul_div_assoc', div_le_div_iff₀ hcard (by norm_num)]
      nlinarith
    linarith
  
  have hstar : ∀ x ∈ W, ∑ k : Fin 2, (pd2 k (fun x => u (ψ m) x - u (ψ l) x) x) ^ 2 ≤
      2 * ((u (ψ m) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ m)) x) ^ 2) +
      2 * ((u (ψ l) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ l)) x) ^ 2) := by
    intro x hx
    have hdm : DifferentiableAt ℝ (u (ψ m)) x :=
      ((hu _).differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hdl : DifferentiableAt ℝ (u (ψ l)) x :=
      ((hu _).differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hpd : ∀ k : Fin 2, pd2 k (fun x => u (ψ m) x - u (ψ l) x) x =
        pd2 k (u (ψ m)) x - pd2 k (u (ψ l)) x := by
      intro k
      simp only [pd2]
      have hfd : HasFDerivAt (fun x => u (ψ m) x - u (ψ l) x)
          (fderiv ℝ (u (ψ m)) x - fderiv ℝ (u (ψ l)) x) x :=
        hdm.hasFDerivAt.sub hdl.hasFDerivAt
      rw [hfd.fderiv]
      rfl
    simp only [hpd, Fin.sum_univ_two]
    nlinarith [sq_nonneg (pd2 0 (u (ψ m)) x + pd2 0 (u (ψ l)) x),
      sq_nonneg (pd2 1 (u (ψ m)) x + pd2 1 (u (ψ l)) x), sq_nonneg (u (ψ m) x),
      sq_nonneg (u (ψ l) x)]
  have hgrad : ∫ x in cthickening δ L, ∑ k : Fin 2, (pd2 k (fun x => u (ψ m) x - u (ψ l) x) x) ^ 2
      ≤ 4 * (|C'| + 1) := by
    have hI1 : IntegrableOn (fun x => (u (ψ m) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ m)) x) ^ 2)
        (cthickening δ L) volume := ((hHc (ψ m)).mono hK'W).integrableOn_compact hK'
    have hI2 : IntegrableOn (fun x => (u (ψ l) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ l)) x) ^ 2)
        (cthickening δ L) volume := ((hHc (ψ l)).mono hK'W).integrableOn_compact hK'
    have h1 : ∫ x in cthickening δ L,
        ∑ k : Fin 2, (pd2 k (fun x => u (ψ m) x - u (ψ l) x) x) ^ 2 ≤
        ∫ x in cthickening δ L, (2 * ((u (ψ m) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ m)) x) ^ 2) +
          2 * ((u (ψ l) x) ^ 2 + ∑ k : Fin 2, (pd2 k (u (ψ l)) x) ^ 2)) :=
      setIntegral_mono_on ((hGc _ hf).mono hK'W |>.integrableOn_compact hK')
        ((hI1.const_mul 2).add (hI2.const_mul 2)) hK'.measurableSet
        (fun x hx => hstar x (hK'W hx))
    rw [integral_add (hI1.const_mul 2) (hI2.const_mul 2), integral_const_mul,
      integral_const_mul] at h1
    have h2 := hC' (ψ m)
    have h3 := hC' (ψ l)
    have h4 := le_abs_self C'
    linarith
  
  have hsum := cell_sum_bound (cthickening δ L) L hK' Z (Qo s) (fun z _ => hQmeas s hs z)
    (fun z _ z' _ h => hQdisj s hs z z' h) (fun z hz => (hQoc s z).trans (hQcK z hz))
    (fun x hx => by
      obtain ⟨z, hz, h⟩ := hZcov x hx
      exact Set.mem_biUnion hz h)
    (fun x => (u (ψ m) x - u (ψ l) x) ^ 2)
    (fun x => ∑ k : Fin 2, (pd2 k (fun x => u (ψ m) x - u (ψ l) x) x) ^ 2)
    ((((hUc _).sub (hUc _)).pow 2).mono hK'W) ((hGc _ hf).mono hK'W)
    (fun x => sq_nonneg _) (fun x => Finset.sum_nonneg (fun k _ => sq_nonneg _))
    (fun z => (∫ x in Qo s z, (u (ψ m) x - u (ψ l) x)) ^ 2 / s ^ 2) (s ^ 2) (sq_nonneg s)
    (fun z hz => hpoin _ hf s hs z (hQcW z hz))
  have hfin1 : s ^ 2 * ∫ x in cthickening δ L,
      ∑ k : Fin 2, (pd2 k (fun x => u (ψ m) x - u (ψ l) x) x) ^ 2 ≤ s ^ 2 * (4 * (|C'| + 1)) :=
    mul_le_mul_of_nonneg_left hgrad (sq_nonneg s)
  have hfin2 : s ^ 2 * (4 * (|C'| + 1)) ≤ s * (4 * (|C'| + 1)) :=
    mul_le_mul_of_nonneg_right (by nlinarith) (by positivity)
  linarith

theorem l2loc_limit_of_cauchy (W : Set E2) (hW : IsOpen W) (v : ℕ → E2 → ℝ) (hv : ∀ m, ContinuousOn (v m) W) (hbd : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, ∀ m, ∫ x in L, (v m x) ^ 2 ≤ C) (hcauchy : ∀ L : Set E2, IsCompact L → L ⊆ W → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l → ∫ x in L, (v m x - v l x) ^ 2 < ε) : ∃ w : E2 → ℝ, (∀ L : Set E2, IsCompact L → L ⊆ W → MemLp w 2 (volume.restrict L)) ∧ ∀ L : Set E2, IsCompact L → L ⊆ W → Tendsto (fun m => ∫ x in L, (v m x - w x) ^ 2) atTop (𝓝 0) :=
by
  
  have s1 : ∃ K : ℕ → Set E2, (∀ j, IsCompact (K j)) ∧ (∀ j, K j ⊆ W) ∧
      (∀ i j, i ≤ j → K i ⊆ K j) ∧ ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ j, L ⊆ K j := by
    refine ⟨fun j => Metric.closedBall (0 : E2) j ∩
      {x | ∀ y, y ∉ W → 1 / ((j : ℝ) + 1) ≤ dist x y}, ?_, ?_, ?_, ?_⟩
    · intro j
      apply Metric.isCompact_of_isClosed_isBounded
      · apply Metric.isClosed_closedBall.inter
        have : {x : E2 | ∀ y, y ∉ W → 1 / ((j : ℝ) + 1) ≤ dist x y} =
            ⋂ y ∈ Wᶜ, {x | 1 / ((j : ℝ) + 1) ≤ dist x y} := by
          ext x; simp
        rw [this]
        exact isClosed_biInter fun y _ =>
          isClosed_le continuous_const (continuous_id.dist continuous_const)
      · exact Metric.isBounded_closedBall.subset Set.inter_subset_left
    · intro j x hx
      by_contra h
      have h1 := hx.2 x h
      rw [dist_self] at h1
      have : (0:ℝ) < 1 / ((j : ℝ) + 1) := by positivity
      linarith
    · intro i j hij x hx
      have hij' : (i : ℝ) ≤ j := by exact_mod_cast hij
      refine ⟨Metric.closedBall_subset_closedBall hij' hx.1, fun y hy => ?_⟩
      have h1 : 1 / ((j:ℝ) + 1) ≤ 1 / ((i:ℝ) + 1) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      exact h1.trans (hx.2 y hy)
    · intro L hL hLW
      obtain ⟨δ, hδ, hδW⟩ := hL.exists_thickening_subset_open hW hLW
      obtain ⟨R, hR⟩ := (Metric.isBounded_iff_subset_closedBall (0:E2)).1 hL.isBounded
      obtain ⟨j, hj⟩ := exists_nat_gt (max R (1/δ))
      refine ⟨j, fun x hx => ⟨Metric.closedBall_subset_closedBall
        (le_of_lt (lt_of_le_of_lt (le_max_left _ _) hj)) (hR hx), fun y hy => ?_⟩⟩
      have h1 : 1/δ < (j:ℝ) + 1 := by linarith [le_max_right R (1/δ)]
      have h2 : 1 / ((j:ℝ)+1) < δ := by
        rw [div_lt_iff₀ (by positivity)]
        rw [div_lt_iff₀ hδ] at h1
        linarith
      have h3 : δ ≤ dist x y := by
        by_contra h
        push_neg at h
        apply hy
        apply hδW
        rw [Metric.mem_thickening_iff]
        exact ⟨x, hx, by rw [dist_comm]; exact h⟩
      linarith
  
  have s2 : ∀ (μ : Measure E2) (f : E2 → ℝ), MemLp f 2 μ →
      (∀ ε : ℝ, 0 < ε → ∫ x, f x ^ 2 ∂μ < ε ^ 2 → eLpNorm f 2 μ < ENNReal.ofReal ε) ∧
      (∀ ε : ℝ, 0 ≤ ε → eLpNorm f 2 μ ≤ ENNReal.ofReal ε → ∫ x, f x ^ 2 ∂μ ≤ ε ^ 2) := by
    intro μ f hf
    have h := hf.eLpNorm_eq_integral_rpow_norm two_ne_zero ENNReal.ofNat_ne_top
    have hI : 0 ≤ ∫ x, f x ^ 2 ∂μ := integral_nonneg fun x => sq_nonneg _
    have e1 : (fun a => ‖f a‖ ^ (2:ENNReal).toReal) = fun a => f a ^ 2 := by
      funext a
      rw [ENNReal.toReal_ofNat, Real.rpow_two, Real.norm_eq_abs, sq_abs]
    have hid : ∫ x, f x ^ 2 ∂μ = ((eLpNorm f 2 μ).toReal) ^ 2 := by
      rw [h, e1, ENNReal.toReal_ofReal (Real.rpow_nonneg hI _), ENNReal.toReal_ofNat, ← one_div,
        ← Real.sqrt_eq_rpow, Real.sq_sqrt hI]
    have ha : 0 ≤ (eLpNorm f 2 μ).toReal := ENNReal.toReal_nonneg
    have he : eLpNorm f 2 μ = ENNReal.ofReal (eLpNorm f 2 μ).toReal :=
      (ENNReal.ofReal_toReal hf.eLpNorm_lt_top.ne).symm
    refine ⟨fun ε hε hlt => ?_, fun ε hε hle => ?_⟩
    · rw [hid] at hlt
      have : (eLpNorm f 2 μ).toReal < ε := by nlinarith
      rw [he]
      exact (ENNReal.ofReal_lt_ofReal_iff hε).2 this
    · have h2 : (eLpNorm f 2 μ).toReal ≤ ε := ENNReal.toReal_le_of_le_ofReal hε hle
      rw [hid]
      nlinarith
  
  obtain ⟨K, hKc, hKW, hKmono, hKabs⟩ := s1
  have hmem : ∀ (φ : E2 → ℝ) (L : Set E2), IsCompact L → L ⊆ W → ContinuousOn φ W →
      MemLp φ 2 (volume.restrict L) := by
    intro φ L hL hLW hφ
    exact (memLp_two_iff_integrable_sq ((hφ.mono hLW).aestronglyMeasurable hL.measurableSet)).2
      (((hφ.mono hLW).pow 2).integrableOn_compact hL)
  have hvK : ∀ m i, MemLp (v m) 2 (volume.restrict (K i)) :=
    fun m i => hmem _ _ (hKc i) (hKW i) (hv m)
  have hcauK : ∀ i (ε : ℝ), 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l →
      eLpNorm (v m - v l) 2 (volume.restrict (K i)) < ENNReal.ofReal ε := by
    intro i ε hε
    obtain ⟨N, hN⟩ := hcauchy (K i) (hKc i) (hKW i) (ε ^ 2) (by positivity)
    refine ⟨N, fun m l hm hl => ?_⟩
    exact (s2 _ _ ((hvK m i).sub (hvK l i))).1 ε hε (hN m l hm hl)
  
  choose N hN using fun j => hcauK j ((1/2:ℝ) ^ j) (by positivity)
  set n : ℕ → ℕ := fun j => j + ∑ k ∈ Finset.range (j+1), N k with hn_def
  have hn_ge : ∀ j, j ≤ n j := fun j => Nat.le_add_right _ _
  have hNn : ∀ j, N j ≤ n j := fun j =>
    le_add_left (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.self_mem_range_succ j))
  have hn_mono : Monotone n := by
    intro a b hab
    exact Nat.add_le_add hab (Finset.sum_le_sum_of_subset (Finset.range_mono (by omega)))
  set w : E2 → ℝ := fun x => limUnder atTop (fun t => v (n t) x) with hw_def
  have hae : ∀ i, ∀ᵐ x ∂(volume.restrict (K i)),
      Tendsto (fun t => v (n t) x) atTop (𝓝 (w x)) := by
    intro i
    have hclaim : ∀ T a b : ℕ, T ≤ a → T ≤ b →
        eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K i)) <
          ENNReal.ofReal ((1/2:ℝ) ^ T) := by
      intro T a b ha hb
      have hM1 : N (T + i) ≤ n (a + i) := (hNn _).trans (hn_mono (by omega))
      have hM2 : N (T + i) ≤ n (b + i) := (hNn _).trans (hn_mono (by omega))
      calc eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K i))
          ≤ eLpNorm (v (n (a + i)) - v (n (b + i))) 2 (volume.restrict (K (T + i))) :=
            eLpNorm_mono_measure _ (Measure.restrict_mono (hKmono i (T+i) (by omega)) le_rfl)
        _ < ENNReal.ofReal ((1/2:ℝ) ^ (T + i)) := hN (T + i) _ _ hM1 hM2
        _ ≤ ENNReal.ofReal ((1/2:ℝ) ^ T) :=
            ENNReal.ofReal_le_ofReal (pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega))
    have hBsum : ∑' T : ℕ, ENNReal.ofReal ((1/2:ℝ) ^ T) ≠ ⊤ := by
      rw [← ENNReal.ofReal_tsum_of_nonneg (fun _ => by positivity) summable_geometric_two]
      exact ENNReal.ofReal_ne_top
    have hc := MeasureTheory.Lp.ae_tendsto_of_cauchy_eLpNorm (f := fun t => v (n (t + i)))
      (fun t => (hvK (n (t + i)) i).aestronglyMeasurable) (by norm_num : (1:ENNReal) ≤ 2)
      hBsum hclaim
    filter_upwards [hc] with x hx
    obtain ⟨l, hl⟩ := hx
    have hl' : Tendsto (fun t => v (n t) x) atTop (𝓝 l) :=
      (Filter.tendsto_add_atTop_iff_nat (f := fun t => v (n t) x) i).1 hl
    exact tendsto_nhds_limUnder ⟨l, hl'⟩
  
  have hlim : ∀ i, MemLp w 2 (volume.restrict (K i)) ∧ ∀ ε : ℝ, 0 < ε → ∃ N' : ℕ, ∀ m, N' ≤ m →
      eLpNorm (v m - w) 2 (volume.restrict (K i)) ≤ ENNReal.ofReal ε := by
    intro i
    have hw : AEStronglyMeasurable w (volume.restrict (K i)) :=
      aestronglyMeasurable_of_tendsto_ae atTop (fun t => (hvK (n t) i).aestronglyMeasurable) (hae i)
    have hbound : ∀ ε : ℝ, 0 < ε → ∃ N' : ℕ, ∀ m, N' ≤ m →
        eLpNorm (v m - w) 2 (volume.restrict (K i)) ≤ ENNReal.ofReal ε := by
      intro ε hε
      obtain ⟨N', hN'⟩ := hcauK i ε hε
      refine ⟨N', fun m hm => ?_⟩
      have hF := MeasureTheory.Lp.eLpNorm_lim_le_liminf_eLpNorm (p := 2)
        (fun t => (hvK m i).aestronglyMeasurable.sub (hvK (n t) i).aestronglyMeasurable) (v m - w) (by
          filter_upwards [hae i] with x hx
          simp only [Pi.sub_apply]
          exact tendsto_const_nhds.sub hx)
      refine hF.trans ?_
      refine Filter.liminf_le_of_frequently_le' ?_
      refine Filter.Eventually.frequently ?_
      filter_upwards [eventually_ge_atTop N'] with t ht
      exact (hN' m (n t) hm (ht.trans (hn_ge t))).le
    refine ⟨?_, hbound⟩
    obtain ⟨N₁, hN₁⟩ := hbound 1 one_pos
    have h1 : MemLp (v N₁ - w) 2 (volume.restrict (K i)) :=
      ⟨(hvK N₁ i).aestronglyMeasurable.sub hw,
        lt_of_le_of_lt (hN₁ N₁ le_rfl) ENNReal.ofReal_lt_top⟩
    have : w = v N₁ - (v N₁ - w) := by funext x; simp
    rw [this]
    exact (hvK N₁ i).sub h1
  
  refine ⟨w, fun L hL hLW => ?_, fun L hL hLW => ?_⟩
  · obtain ⟨j, hLj⟩ := hKabs L hL hLW
    exact (hlim j).1.mono_measure (Measure.restrict_mono hLj le_rfl)
  · obtain ⟨j, hLj⟩ := hKabs L hL hLW
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hη : 0 < Real.sqrt (ε / 2) := Real.sqrt_pos.2 (by positivity)
    obtain ⟨N', hN'⟩ := (hlim j).2 _ hη
    refine ⟨N', fun m hm => ?_⟩
    have hD : MemLp (v m - w) 2 (volume.restrict (K j)) := (hvK m j).sub (hlim j).1
    have h1 : ∫ x in K j, (v m x - w x) ^ 2 ≤ Real.sqrt (ε / 2) ^ 2 :=
      (s2 _ _ hD).2 _ hη.le (hN' m hm)
    rw [Real.sq_sqrt (by positivity)] at h1
    have h2 : ∫ x in L, (v m x - w x) ^ 2 ≤ ∫ x in K j, (v m x - w x) ^ 2 :=
      setIntegral_mono_set hD.integrable_sq (Eventually.of_forall fun x => sq_nonneg _)
        hLj.eventuallyLE
    have h3 : 0 ≤ ∫ x in L, (v m x - w x) ^ 2 :=
      setIntegral_nonneg hL.measurableSet (fun x _ => sq_nonneg _)
    rw [Real.dist_eq, sub_zero, abs_of_nonneg h3]
    linarith

theorem l2loc_exhaustion_weight (W : Set E2) (hW : IsOpen W) (F : ℕ → E2 → ℝ) (hF0 : ∀ n x, 0 ≤ F n x) (hFc : ∀ n, ContinuousOn (F n) W) (hFb : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, ∀ n, ∫ x in L, F n x ≤ C) : ∃ ρ : E2 → ℝ, Measurable ρ ∧ (∀ x, 0 ≤ ρ x) ∧ (∀ x, x ∉ W → ρ x = 0) ∧ (∀ L : Set E2, IsCompact L → L ⊆ W → ∃ c : ℝ, 0 < c ∧ ∀ x ∈ L, c ≤ ρ x) ∧ ∀ n, Integrable (fun x => ρ x * F n x) ∧ ∫ x, ρ x * F n x ≤ 1 :=
by
  classical
  
  obtain ⟨K, hKc, hKW, hKcov⟩ : ∃ K : ℕ → Set E2, (∀ j, IsCompact (K j)) ∧ (∀ j, K j ⊆ W) ∧
      ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ j, L ⊆ K j := by
    refine ⟨fun j => Metric.closedBall (0 : E2) (j : ℝ) \ Metric.thickening (1 / ((j : ℝ) + 1)) Wᶜ,
      ?_, ?_, ?_⟩
    · intro j
      exact (isCompact_closedBall (0 : E2) (j : ℝ)).diff Metric.isOpen_thickening
    · intro j x hx
      by_contra hxW
      have hδ : (0 : ℝ) < 1 / ((j : ℝ) + 1) := by positivity
      exact hx.2 (Metric.self_subset_thickening hδ Wᶜ hxW)
    · intro L hL hLW
      obtain ⟨δ, hδ, hδW⟩ := hL.exists_thickening_subset_open hW hLW
      obtain ⟨R, hR⟩ := hL.isBounded.subset_closedBall (0 : E2)
      obtain ⟨j₁, hj₁⟩ := exists_nat_one_div_lt hδ
      obtain ⟨j₂, hj₂⟩ := exists_nat_ge R
      refine ⟨max j₁ j₂, fun x hx => ⟨?_, ?_⟩⟩
      · rw [mem_closedBall_zero_iff]
        have h1 : ‖x‖ ≤ R := mem_closedBall_zero_iff.1 (hR hx)
        have h2 : (j₂ : ℝ) ≤ ((max j₁ j₂ : ℕ) : ℝ) := Nat.cast_le.2 (le_max_right _ _)
        linarith
      · intro hth
        obtain ⟨z, hz, hxz⟩ := Metric.mem_thickening_iff.1 hth
        have h3 : 1 / (((max j₁ j₂ : ℕ) : ℝ) + 1) ≤ 1 / ((j₁ : ℝ) + 1) := by
          apply one_div_le_one_div_of_le (by positivity)
          have : (j₁ : ℝ) ≤ ((max j₁ j₂ : ℕ) : ℝ) := Nat.cast_le.2 (le_max_left _ _)
          linarith
        have hzL : z ∈ Metric.thickening δ L :=
          Metric.mem_thickening_iff.2 ⟨x, hx, by rw [dist_comm]; linarith⟩
        exact hz (hδW hzL)
  have hKm : ∀ j, MeasurableSet (K j) := fun j => (hKc j).measurableSet
  
  obtain ⟨a, hapos, hasum, hbound⟩ : ∃ a : ℕ → ℝ, (∀ j, 0 < a j) ∧ Summable a ∧
      ∀ j n, a j * ∫ x in K j, F n x ≤ 1 / 2 / 2 ^ j := by
    choose C hC using fun j => hFb (K j) (hKc j) (hKW j)
    have hC'1 : ∀ j, (1 : ℝ) ≤ max (C j) 1 := fun j => le_max_right _ _
    have hC'pos : ∀ j, (0 : ℝ) < max (C j) 1 := fun j => lt_of_lt_of_le one_pos (hC'1 j)
    have hapos : ∀ j, (0 : ℝ) < 1 / 2 / 2 ^ j / max (C j) 1 :=
      fun j => div_pos (by positivity) (hC'pos j)
    refine ⟨fun j => 1 / 2 / 2 ^ j / max (C j) 1, hapos, ?_, ?_⟩
    · exact Summable.of_nonneg_of_le (fun j => (hapos j).le)
        (fun j => div_le_self (by positivity) (hC'1 j)) (summable_geometric_two' 1)
    · intro j n
      calc 1 / 2 / 2 ^ j / max (C j) 1 * ∫ x in K j, F n x
          ≤ 1 / 2 / 2 ^ j / max (C j) 1 * max (C j) 1 :=
            mul_le_mul_of_nonneg_left ((hC j n).trans (le_max_left _ _)) (hapos j).le
        _ = 1 / 2 / 2 ^ j := div_mul_cancel₀ _ (hC'pos j).ne'
  
  obtain ⟨S, hSx⟩ : ∃ S : E2 → ENNReal, ∀ x,
      S x = ∑' j, ENNReal.ofReal (a j) * (K j).indicator (fun _ => (1 : ENNReal)) x :=
    ⟨_, fun x => rfl⟩
  have hSle : ∀ x, S x ≤ ENNReal.ofReal (∑' j, a j) := by
    intro x
    rw [hSx x, ENNReal.ofReal_tsum_of_nonneg (fun j => (hapos j).le) hasum]
    refine ENNReal.tsum_le_tsum fun j => ?_
    by_cases hx : x ∈ K j
    · simp [hx]
    · simp [hx]
  have hSne : ∀ x, S x ≠ ⊤ := fun x => ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hSle x)
  have hSm : Measurable S := by
    have hS : S = fun x => ∑' j, ENNReal.ofReal (a j) * (K j).indicator (fun _ => (1 : ENNReal)) x :=
      funext hSx
    rw [hS]
    exact Measurable.ennreal_tsum fun j => (measurable_const.indicator (hKm j)).const_mul _
  have hρW : ∀ x, x ∉ W → (S x).toReal = 0 := by
    intro x hx
    have h0 : S x = 0 := by
      rw [hSx x]
      refine ENNReal.tsum_eq_zero.2 fun j => ?_
      have : x ∉ K j := fun h => hx (hKW j h)
      simp [this]
    simp [h0]
  refine ⟨fun x => (S x).toReal, hSm.ennreal_toReal, fun x => ENNReal.toReal_nonneg, hρW, ?_, ?_⟩
  · intro L hL hLW
    obtain ⟨j, hj⟩ := hKcov L hL hLW
    refine ⟨a j, hapos j, fun x hx => ?_⟩
    have hxK : x ∈ K j := hj hx
    have h1 : ENNReal.ofReal (a j) ≤ S x := by
      rw [hSx x]
      calc ENNReal.ofReal (a j)
          = ENNReal.ofReal (a j) * (K j).indicator (fun _ => (1 : ENNReal)) x := by simp [hxK]
        _ ≤ ∑' i, ENNReal.ofReal (a i) * (K i).indicator (fun _ => (1 : ENNReal)) x :=
            ENNReal.le_tsum (f := fun i => ENNReal.ofReal (a i) *
              (K i).indicator (fun _ => (1 : ENNReal)) x) j
    have h2 := ENNReal.toReal_mono (hSne x) h1
    rwa [ENNReal.toReal_ofReal (hapos j).le] at h2
  · intro n
    have hmeasW : AEStronglyMeasurable (fun x => (S x).toReal * F n x) (volume.restrict W) :=
      hSm.ennreal_toReal.aestronglyMeasurable.mul ((hFc n).aestronglyMeasurable hW.measurableSet)
    have hind : (W.indicator fun x => (S x).toReal * F n x) = fun x => (S x).toReal * F n x := by
      funext x
      by_cases hx : x ∈ W
      · simp [hx]
      · simp [hx, hρW x hx]
    have hmeas : AEStronglyMeasurable (fun x => (S x).toReal * F n x) volume := by
      rw [← hind]; exact (aestronglyMeasurable_indicator_iff hW.measurableSet).2 hmeasW
    have hnn : ∀ x, 0 ≤ (S x).toReal * F n x := fun x => mul_nonneg ENNReal.toReal_nonneg (hF0 n x)
    obtain ⟨T, hTx⟩ : ∃ T : ℕ → E2 → ENNReal, ∀ j,
        T j = (K j).indicator (fun x => ENNReal.ofReal (a j) * ENNReal.ofReal (F n x)) :=
      ⟨_, fun j => rfl⟩
    have hpt : ∀ x, ENNReal.ofReal ((S x).toReal * F n x) = ∑' j, T j x := by
      intro x
      rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hSne x), hSx x,
        ← ENNReal.tsum_mul_right]
      refine tsum_congr fun j => ?_
      rw [hTx j]
      by_cases hx : x ∈ K j
      · simp [hx]
      · simp [hx]
    have hTm : ∀ j, AEMeasurable (T j) volume := by
      intro j
      rw [hTx j]
      refine (aemeasurable_indicator_iff (hKm j)).2 ?_
      exact (((hFc n).mono (hKW j)).aemeasurable (hKm j)).ennreal_ofReal.const_mul _
    have hTint : ∀ j, ∫⁻ x, T j x ≤ ENNReal.ofReal (1 / 2 / 2 ^ j) := by
      intro j
      have hI : IntegrableOn (F n) (K j) := ((hFc n).mono (hKW j)).integrableOn_compact (hKc j)
      rw [hTx j, lintegral_indicator (hKm j), lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
        ← ofReal_integral_eq_lintegral_ofReal hI (ae_of_all _ (hF0 n)),
        ← ENNReal.ofReal_mul (hapos j).le]
      exact ENNReal.ofReal_le_ofReal (hbound j n)
    have hlin : ∫⁻ x, ENNReal.ofReal ((S x).toReal * F n x) ≤ ENNReal.ofReal 1 := by
      calc ∫⁻ x, ENNReal.ofReal ((S x).toReal * F n x) = ∫⁻ x, ∑' j, T j x :=
            lintegral_congr fun x => hpt x
        _ = ∑' j, ∫⁻ x, T j x := lintegral_tsum hTm
        _ ≤ ∑' j : ℕ, ENNReal.ofReal (1 / 2 / 2 ^ j) := ENNReal.tsum_le_tsum hTint
        _ = ENNReal.ofReal (∑' j : ℕ, (1 : ℝ) / 2 / 2 ^ j) :=
            (ENNReal.ofReal_tsum_of_nonneg (fun j => by positivity) (summable_geometric_two' 1)).symm
        _ = ENNReal.ofReal 1 := by rw [tsum_geometric_two' 1]
    have hInt : Integrable (fun x => (S x).toReal * F n x) volume := by
      refine ⟨hmeas, ?_⟩
      rw [hasFiniteIntegral_iff_ofReal (ae_of_all _ hnn)]
      exact lt_of_le_of_lt hlin ENNReal.ofReal_lt_top
    refine ⟨hInt, ?_⟩
    rw [integral_eq_lintegral_of_nonneg_ae (ae_of_all _ hnn) hmeas]
    exact ENNReal.toReal_le_of_le_ofReal zero_le_one hlin

theorem hilbert_bdd_weak_subseq {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] (x : ℕ → H) (B : ℝ) (hx : ∀ n, ‖x n‖ ≤ B) : ∃ (φ : ℕ → ℕ) (g : H), StrictMono φ ∧ ∀ y : H, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 (inner ℝ g y)) :=
by
  classical
  have hB0 : 0 ≤ B := le_trans (norm_nonneg _) (hx 0)
  
  have hs : IsCompact (Set.univ.pi (fun k : ℕ => Set.Icc (-(B * ‖x k‖)) (B * ‖x k‖))) :=
    isCompact_univ_pi (fun k => isCompact_Icc)
  have hv : ∀ n, (fun k : ℕ => inner ℝ (x n) (x k)) ∈
      Set.univ.pi (fun k : ℕ => Set.Icc (-(B * ‖x k‖)) (B * ‖x k‖)) := by
    intro n
    simp only [Set.mem_pi, Set.mem_univ, true_implies, Set.mem_Icc]
    intro k
    have h1 : |inner ℝ (x n) (x k)| ≤ ‖x n‖ * ‖x k‖ := abs_real_inner_le_norm _ _
    have h2 : ‖x n‖ * ‖x k‖ ≤ B * ‖x k‖ := mul_le_mul_of_nonneg_right (hx n) (norm_nonneg _)
    exact abs_le.mp (h1.trans h2)
  obtain ⟨c, -, φ, hφ, hc⟩ := hs.tendsto_subseq hv
  have hφk : ∀ k, Tendsto (fun m => inner ℝ (x (φ m)) (x k)) atTop (𝓝 (c k)) := by
    intro k
    exact (tendsto_pi_nhds.1 hc) k
  have hz : ∀ m, ‖x (φ m)‖ ≤ B := fun m => hx (φ m)
  
  let S : Submodule ℝ H :=
    { carrier := {y | ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L)}
      add_mem' := by
        rintro a b ⟨La, ha⟩ ⟨Lb, hb⟩
        refine ⟨La + Lb, ?_⟩
        simpa only [inner_add_right] using ha.add hb
      zero_mem' := ⟨0, by simp⟩
      smul_mem' := by
        rintro r a ⟨La, ha⟩
        refine ⟨r * La, ?_⟩
        simpa only [real_inner_smul_right] using ha.const_mul r }
  have hSmem : ∀ y, y ∈ S ↔ ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L) :=
    fun y => Iff.rfl
  have hScl : IsClosed (S : Set H) := by
    refine isClosed_of_closure_subset ?_
    intro y hy
    have hcs : CauchySeq (fun m => inner ℝ (x (φ m)) y) := by
      rw [Metric.cauchySeq_iff']
      intro ε hε
      have hδ : 0 < ε / (4 * (B + 1)) := by positivity
      obtain ⟨y', hy'S, hyy'⟩ := Metric.mem_closure_iff.1 hy _ hδ
      obtain ⟨L', hL'⟩ := (hSmem y').1 hy'S
      obtain ⟨N, hN⟩ := Metric.cauchySeq_iff'.1 hL'.cauchySeq (ε / 2) (by positivity)
      refine ⟨N, fun n hn => ?_⟩
      have hkey : B * (ε / (4 * (B + 1))) ≤ ε / 4 := by
        rw [← mul_div_assoc, div_le_div_iff₀ (by positivity) (by norm_num)]
        nlinarith
      have hb : ∀ j, |inner ℝ (x (φ j)) (y - y')| ≤ ε / 4 := by
        intro j
        calc |inner ℝ (x (φ j)) (y - y')| ≤ ‖x (φ j)‖ * ‖y - y'‖ := abs_real_inner_le_norm _ _
          _ ≤ B * (ε / (4 * (B + 1))) := by
            apply mul_le_mul (hz j) _ (norm_nonneg _) hB0
            rw [← dist_eq_norm]; exact hyy'.le
          _ ≤ ε / 4 := hkey
      have hsplit : inner ℝ (x (φ n)) y - inner ℝ (x (φ N)) y =
          inner ℝ (x (φ n)) (y - y') + (inner ℝ (x (φ n)) y' - inner ℝ (x (φ N)) y')
            - inner ℝ (x (φ N)) (y - y') := by
        rw [inner_sub_right, inner_sub_right]; ring
      have h1 := hN n hn
      rw [Real.dist_eq] at h1 ⊢
      rw [hsplit]
      have e1 := abs_le.mp (hb n)
      have e2 := abs_le.mp (hb N)
      have e3 := abs_lt.mp h1
      rw [abs_lt]
      constructor <;> linarith [e1.1, e1.2, e2.1, e2.2, e3.1, e3.2]
    obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcs
    exact (hSmem y).2 ⟨L, hL⟩
  
  let K : Submodule ℝ H := (Submodule.span ℝ (Set.range x)).topologicalClosure
  have hspan : Submodule.span ℝ (Set.range x) ≤ S := by
    rw [Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    exact (hSmem _).2 ⟨c k, hφk k⟩
  have hKS : K ≤ S := Submodule.topologicalClosure_minimal _ hspan hScl
  have hxK : ∀ n, x n ∈ K := fun n =>
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨n, rfl⟩)
  have hKoS : Kᗮ ≤ S := by
    intro y hy
    refine (hSmem y).2 ⟨0, ?_⟩
    have h0 : (fun m => inner ℝ (x (φ m)) y) = fun _ => (0 : ℝ) := by
      funext m
      exact Submodule.inner_right_of_mem_orthogonal (hxK (φ m)) hy
    rw [h0]
    exact tendsto_const_nhds
  haveI : CompleteSpace K := (Submodule.isClosed_topologicalClosure _).completeSpace_coe
  have hsup : K ⊔ Kᗮ = ⊤ := Submodule.sup_orthogonal_of_completeSpace
  have hall : ∀ y, ∃ L : ℝ, Tendsto (fun m => inner ℝ (x (φ m)) y) atTop (𝓝 L) := by
    intro y
    have hy : y ∈ K ⊔ Kᗮ := by rw [hsup]; exact Submodule.mem_top
    exact (hSmem y).1 (sup_le hKS hKoS hy)
  
  choose f hf using hall
  let T : ℕ → H →L[ℝ] ℝ := fun m => innerSL ℝ (x (φ m))
  have hT : Tendsto (fun m y => T m y) atTop (𝓝 f) := by
    rw [tendsto_pi_nhds]
    intro y
    simpa [T, innerSL_apply] using hf y
  have hTb : Bornology.IsBounded (Set.range T) := by
    rw [isBounded_iff_forall_norm_le]
    refine ⟨B, ?_⟩
    rintro _ ⟨m, rfl⟩
    simp only [T, innerSL_apply_norm]
    exact hz m
  let ℓ : H →L[ℝ] ℝ := ContinuousLinearMap.ofTendstoOfBoundedRange f T hT hTb
  refine ⟨φ, (InnerProductSpace.toDual ℝ H).symm ℓ, hφ, fun y => ?_⟩
  rw [InnerProductSpace.toDual_symm_apply]
  have hℓ : ℓ y = f y := by
    simp [ℓ, ContinuousLinearMap.ofTendstoOfBoundedRange_apply]
  rw [hℓ]
  exact hf y

theorem l2loc_weak_subseq (W : Set E2) (hW : IsOpen W) (f : ℕ → Fin 2 → E2 → ℝ) (hf : ∀ n k, ContinuousOn (f n k) W) (hbd : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, ∀ n k, ∫ x in L, (f n k x) ^ 2 ≤ C) : ∃ (ψ : ℕ → ℕ) (G : Fin 2 → E2 → ℝ), StrictMono ψ ∧ (∀ L : Set E2, IsCompact L → L ⊆ W → ∀ k, MemLp (G k) 2 (volume.restrict L)) ∧ ∀ k (φ : E2 → ℝ), Continuous φ → HasCompactSupport φ → tsupport φ ⊆ W → Tendsto (fun m => ∫ x, f (ψ m) k x * φ x) atTop (𝓝 (∫ x, G k x * φ x)) :=
by
  classical
  
  have hF0 : ∀ n x, 0 ≤ ∑ k : Fin 2, (f n k x) ^ 2 :=
    fun n x => Finset.sum_nonneg fun k _ => sq_nonneg _
  have hFc : ∀ n, ContinuousOn (fun x => ∑ k : Fin 2, (f n k x) ^ 2) W :=
    fun n => continuousOn_finset_sum _ fun k _ => (hf n k).pow 2
  have hFb : ∀ L : Set E2, IsCompact L → L ⊆ W → ∃ C : ℝ, ∀ n,
      ∫ x in L, ∑ k : Fin 2, (f n k x) ^ 2 ≤ C := by
    intro L hL hLW
    obtain ⟨C, hC⟩ := hbd L hL hLW
    refine ⟨2 * C, fun n => ?_⟩
    have hI : ∀ k, IntegrableOn (fun x => (f n k x) ^ 2) L := fun k =>
      (((hf n k).mono hLW).pow 2).integrableOn_compact hL
    calc ∫ x in L, ∑ k : Fin 2, (f n k x) ^ 2 = ∑ k : Fin 2, ∫ x in L, (f n k x) ^ 2 :=
          integral_finset_sum _ fun k _ => hI k
      _ ≤ ∑ k : Fin 2, C := Finset.sum_le_sum fun k _ => hC n k
      _ = 2 * C := by rw [Fin.sum_univ_two]; ring
  
  obtain ⟨ρ, hρm, hρ0, hρW, hρpos, hρint⟩ := l2loc_exhaustion_weight W hW
    (fun n x => ∑ k : Fin 2, (f n k x) ^ 2) hF0 hFc hFb
  have hsq : ∀ x, Real.sqrt (ρ x) ^ 2 = ρ x := fun x => Real.sq_sqrt (hρ0 x)
  
  have hg : ∀ n k, MemLp (fun x => Real.sqrt (ρ x) * f n k x) 2 volume ∧
      ∫ x, (Real.sqrt (ρ x) * f n k x) ^ 2 ≤ 1 := by
    intro n k
    have hmeasW : AEStronglyMeasurable (fun x => Real.sqrt (ρ x) * f n k x)
        (volume.restrict W) :=
      hρm.sqrt.aestronglyMeasurable.mul ((hf n k).aestronglyMeasurable hW.measurableSet)
    have hind : (W.indicator fun x => Real.sqrt (ρ x) * f n k x) =
        fun x => Real.sqrt (ρ x) * f n k x := by
      funext x
      by_cases hx : x ∈ W
      · simp [hx]
      · simp [hx, hρW x hx]
    have hmeas : AEStronglyMeasurable (fun x => Real.sqrt (ρ x) * f n k x) volume := by
      rw [← hind]; exact (aestronglyMeasurable_indicator_iff hW.measurableSet).2 hmeasW
    have hpt : ∀ x, (Real.sqrt (ρ x) * f n k x) ^ 2 ≤ ρ x * ∑ k' : Fin 2, (f n k' x) ^ 2 := by
      intro x
      rw [mul_pow, hsq]
      apply mul_le_mul_of_nonneg_left _ (hρ0 x)
      exact Finset.single_le_sum (f := fun k' => (f n k' x) ^ 2) (fun k' _ => sq_nonneg _)
        (Finset.mem_univ k)
    have hI : Integrable (fun x => (Real.sqrt (ρ x) * f n k x) ^ 2) volume := by
      refine Integrable.mono' (hρint n).1 (hmeas.pow 2) ?_
      exact Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]; exact hpt x
    refine ⟨(memLp_two_iff_integrable_sq hmeas).2 hI, ?_⟩
    exact le_trans (integral_mono hI (hρint n).1 hpt) (hρint n).2
  
  let X : ℕ → Fin 2 → Lp ℝ 2 (volume : Measure E2) := fun n k => (hg n k).1.toLp _
  have hinner : ∀ A B : Lp ℝ 2 (volume : Measure E2), inner ℝ A B = ∫ x, A x * B x := by
    intro A B
    rw [L2.inner_def]
    congr 1
    funext x
    simp [mul_comm]
  have htoLp : ∀ (u w : E2 → ℝ) (hu : MemLp u 2 volume) (hw : MemLp w 2 volume),
      inner ℝ (hu.toLp u) (hw.toLp w) = ∫ x, u x * w x := by
    intro u w hu hw
    rw [hinner]
    refine integral_congr_ae ?_
    filter_upwards [hu.coeFn_toLp, hw.coeFn_toLp] with x h1 h2
    rw [h1, h2]
  have hXn : ∀ n k, ‖X n k‖ ≤ 1 := by
    intro n k
    have h1 : ‖X n k‖ ^ 2 ≤ 1 := by
      rw [← real_inner_self_eq_norm_sq]
      show inner ℝ ((hg n k).1.toLp _) ((hg n k).1.toLp _) ≤ 1
      rw [htoLp]
      calc ∫ x, Real.sqrt (ρ x) * f n k x * (Real.sqrt (ρ x) * f n k x)
          = ∫ x, (Real.sqrt (ρ x) * f n k x) ^ 2 := by
            congr 1; funext x; ring
        _ ≤ 1 := (hg n k).2
    nlinarith [norm_nonneg (X n k)]
  
  obtain ⟨φ₀, Γ₀, hφ₀, h₀⟩ := hilbert_bdd_weak_subseq (fun n => X n 0) 1 (fun n => hXn n 0)
  obtain ⟨φ₁, Γ₁, hφ₁, h₁⟩ :=
    hilbert_bdd_weak_subseq (fun m => X (φ₀ m) 1) 1 (fun m => hXn _ 1)
  let Γ : Fin 2 → Lp ℝ 2 (volume : Measure E2) := ![Γ₀, Γ₁]
  have hΓ : ∀ k y, Tendsto (fun m => inner ℝ (X ((φ₀ ∘ φ₁) m) k) y) atTop
      (𝓝 (inner ℝ (Γ k) y)) := by
    intro k y
    fin_cases k
    · exact (h₀ y).comp hφ₁.tendsto_atTop
    · exact h₁ y
  
  have hdiv : ∀ (γ : E2 → ℝ), MemLp γ 2 volume → ∀ (L : Set E2), MeasurableSet L →
      ∀ c : ℝ, 0 < c → (∀ x ∈ L, c ≤ ρ x) →
      MemLp (fun x => γ x / Real.sqrt (ρ x)) 2 (volume.restrict L) := by
    intro γ hγ L hL c hc hcL
    have hm : AEStronglyMeasurable (fun x => γ x / Real.sqrt (ρ x)) (volume.restrict L) :=
      (hγ.1.aemeasurable.div hρm.sqrt.aemeasurable).aestronglyMeasurable.restrict
    refine MemLp.of_le ((hγ.restrict L).const_mul (Real.sqrt c)⁻¹) hm ?_
    refine (ae_restrict_iff' hL).2 (Filter.Eventually.of_forall fun x hx => ?_)
    have hsc : 0 < Real.sqrt c := Real.sqrt_pos.2 hc
    have hle : Real.sqrt c ≤ Real.sqrt (ρ x) := Real.sqrt_le_sqrt (hcL x hx)
    have hsr : 0 < Real.sqrt (ρ x) := lt_of_lt_of_le hsc hle
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_div, abs_mul, abs_inv, abs_of_pos hsc,
      abs_of_pos hsr, inv_mul_eq_div]
    exact div_le_div_of_nonneg_left (abs_nonneg _) hsc hle
  refine ⟨φ₀ ∘ φ₁, fun k x => Γ k x / Real.sqrt (ρ x), hφ₀.comp hφ₁, ?_, ?_⟩
  
  · intro L hL hLW k
    obtain ⟨c, hc, hcL⟩ := hρpos L hL hLW
    exact hdiv _ (Lp.memLp (Γ k)) L hL.measurableSet c hc hcL
  
  · intro k φ hφ hφc hφW
    show Tendsto (fun m => ∫ x, f ((φ₀ ∘ φ₁) m) k x * φ x) atTop
      (𝓝 (∫ x, Γ k x / Real.sqrt (ρ x) * φ x))
    obtain ⟨c, hc, hcL⟩ := hρpos (tsupport φ) hφc hφW
    have hφL : MemLp φ 2 volume := hφ.memLp_of_hasCompactSupport hφc
    have hzS := hdiv φ hφL (tsupport φ) (isClosed_tsupport φ).measurableSet c hc hcL
    have hzind : (tsupport φ).indicator (fun x => φ x / Real.sqrt (ρ x)) =
        fun x => φ x / Real.sqrt (ρ x) := by
      funext x
      by_cases hx : x ∈ tsupport φ
      · simp [hx]
      · simp [hx, image_eq_zero_of_notMem_tsupport hx]
    have hz : MemLp (fun x => φ x / Real.sqrt (ρ x)) 2 volume := by
      rw [← hzind]
      exact (memLp_indicator_iff_restrict (isClosed_tsupport φ).measurableSet).2 hzS
    have ha : ∀ n x, Real.sqrt (ρ x) * f n k x * (φ x / Real.sqrt (ρ x)) = f n k x * φ x := by
      intro n x
      by_cases h0 : φ x = 0
      · simp [h0]
      · have hx : x ∈ tsupport φ := subset_tsupport φ (Function.mem_support.2 h0)
        have hsr : 0 < Real.sqrt (ρ x) := Real.sqrt_pos.2 (lt_of_lt_of_le hc (hcL x hx))
        field_simp
    have hL : ∀ m, ∫ x, f ((φ₀ ∘ φ₁) m) k x * φ x =
        inner ℝ (X ((φ₀ ∘ φ₁) m) k) (hz.toLp _) := by
      intro m
      show _ = inner ℝ ((hg _ k).1.toLp _) (hz.toLp _)
      rw [htoLp]
      exact integral_congr_ae (Filter.Eventually.of_forall fun x => (ha _ x).symm)
    have hR : ∫ x, Γ k x / Real.sqrt (ρ x) * φ x = inner ℝ (Γ k) (hz.toLp _) := by
      rw [hinner]
      refine integral_congr_ae ?_
      filter_upwards [hz.coeFn_toLp] with x hx
      rw [hx]
      ring
    rw [hR]
    exact Tendsto.congr (fun m => (hL m).symm) (hΓ k _)

theorem ibp_open_test (W : Set E2) (hW : IsOpen W) (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u W) (ζ : E2 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ) (hζW : tsupport ζ ⊆ W) (k : Fin 2) : ∫ x, u x * pd2 k ζ x = -(∫ x, pd2 k u x * ζ x) :=
by
  
  have hvan : ∀ x, x ∉ W → (ζ =ᶠ[𝓝 x] 0) := by
    intro x hx
    exact notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (hζW h))
  have hζ0 : ∀ x, x ∉ W → ζ x = 0 := by
    intro x hx
    exact image_eq_zero_of_notMem_tsupport (fun h => hx (hζW h))
  have hdζ0 : ∀ x, x ∉ W → pd2 k ζ x = 0 := by
    intro x hx
    have h1 : fderiv ℝ ζ x = fderiv ℝ (fun _ => (0:ℝ)) x :=
      Filter.EventuallyEq.fderiv_eq (hvan x hx)
    simp only [pd2, h1, fderiv_const_apply, ContinuousLinearMap.zero_apply]
  
  have hFder : ∀ x, HasFDerivAt (fun y => u y * ζ y)
      (fderiv ℝ (fun y => u y * ζ y) x) x ∧
      fderiv ℝ (fun y => u y * ζ y) x (e2 k) = pd2 k u x * ζ x + u x * pd2 k ζ x := by
    intro x
    by_cases hx : x ∈ W
    · have hu' : HasFDerivAt u (fderiv ℝ u x) x :=
        ((hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)).hasFDerivAt
      have hζ' : HasFDerivAt ζ (fderiv ℝ ζ x) x :=
        (hζ.differentiable (by simp) x).hasFDerivAt
      have hm : HasFDerivAt (fun y => u y * ζ y) (u x • fderiv ℝ ζ x + ζ x • fderiv ℝ u x) x :=
        hu'.mul hζ'
      refine ⟨hm.differentiableAt.hasFDerivAt, ?_⟩
      rw [hm.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, pd2]
      ring
    · have hF0 : (fun y => u y * ζ y) =ᶠ[𝓝 x] (fun _ => (0:ℝ)) := by
        filter_upwards [hvan x hx] with y hy
        simp only [Pi.zero_apply] at hy
        simp [hy]
      have hd : HasFDerivAt (fun y => u y * ζ y) (0 : E2 →L[ℝ] ℝ) x :=
        (hasFDerivAt_const (0:ℝ) x).congr_of_eventuallyEq hF0
      refine ⟨hd.differentiableAt.hasFDerivAt, ?_⟩
      rw [hd.fderiv, hζ0 x hx, hdζ0 x hx]
      simp
  have hFd : Differentiable ℝ (fun y => u y * ζ y) :=
    fun x => (hFder x).1.differentiableAt
  have hprod : (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) =
      fun x => pd2 k u x * ζ x + u x * pd2 k ζ x := funext fun x => (hFder x).2
  
  have helper : ∀ (a φ : E2 → ℝ), ContinuousOn a W → Continuous φ → tsupport φ ⊆ W →
      HasCompactSupport φ → Integrable (fun x => a x * φ x) := by
    intro a φ ha hφ hφW hφc
    have hcont : Continuous (fun x => a x * φ x) := by
      refine continuous_iff_continuousAt.mpr fun x => ?_
      by_cases hx : x ∈ W
      · exact (ha.continuousAt (hW.mem_nhds hx)).mul hφ.continuousAt
      · have h0 : φ =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.mp (fun h => hx (hφW h))
        have h1 : (fun _ => (0:ℝ)) =ᶠ[𝓝 x] (fun y => a y * φ y) := by
          filter_upwards [h0] with y hy
          simp only [Pi.zero_apply] at hy
          simp [hy]
        exact continuousAt_const.congr h1
    exact hcont.integrable_of_hasCompactSupport (hφc.mul_left)
  
  have hdu : ContinuousOn (pd2 k u) W :=
    (hu.continuousOn_fderiv_of_isOpen hW (by simp)).clm_apply continuousOn_const
  have hdζc : Continuous (pd2 k ζ) :=
    (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hdζs : tsupport (pd2 k ζ) ⊆ tsupport ζ := by
    refine closure_minimal (fun x hx => ?_) (isClosed_tsupport ζ)
    refine support_fderiv_subset ℝ ?_
    rw [Function.mem_support] at hx ⊢
    intro h0
    apply hx
    simp [pd2, h0]
  have hg₁ : Integrable (fun x => pd2 k u x * ζ x) :=
    helper _ _ hdu hζ.continuous hζW hζc
  have hg₂ : Integrable (fun x => u x * pd2 k ζ x) :=
    helper _ _ hu.continuousOn hdζc (hdζs.trans hζW) (hζc.fderiv_apply (𝕜 := ℝ) (e2 k))
  have hF : Integrable (fun x => u x * ζ x) :=
    helper _ _ hu.continuousOn hζ.continuous hζW hζc
  have hF' : Integrable (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) := by
    rw [hprod]; exact hg₁.add hg₂
  
  have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
    (f := fun y => u y * ζ y) (g := fun _ => (1:ℝ)) (v := e2 k)
    (by simpa using hF') (by simp) (by simpa using hF) hFd (differentiable_const 1)
  have hzero : ∫ x, fderiv ℝ (fun y => u y * ζ y) x (e2 k) = 0 := by
    simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, mul_zero, integral_zero,
      mul_one] at h
    linarith
  
  rw [hprod, integral_add hg₁ hg₂] at hzero
  linarith

theorem l2_compact_pairing (L : Set E2) (hL : IsCompact L) : (∀ f : E2 → ℝ, ContinuousOn f L → MemLp f 2 (volume.restrict L)) ∧ (∀ f φ : E2 → ℝ, MemLp f 2 (volume.restrict L) → Continuous φ → tsupport φ ⊆ L → Integrable (fun x => f x * φ x)) ∧ ∀ (v : ℕ → E2 → ℝ) (w φ : E2 → ℝ), (∀ m, MemLp (v m) 2 (volume.restrict L)) → MemLp w 2 (volume.restrict L) → Continuous φ → tsupport φ ⊆ L → Tendsto (fun m => ∫ x in L, (v m x - w x) ^ 2) atTop (𝓝 0) → Tendsto (fun m => ∫ x, v m x * φ x) atTop (𝓝 (∫ x, w x * φ x)) :=
by
  have hLm : MeasurableSet L := hL.measurableSet
  haveI : IsFiniteMeasure (volume.restrict L) :=
    isFiniteMeasure_restrict.mpr hL.measure_lt_top.ne
  have hZ : ∀ (g φ : E2 → ℝ), tsupport φ ⊆ L → ∀ x, x ∉ L → g x * φ x = 0 := by
    intro g φ hφL x hx
    rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hφL h)), mul_zero]
  have hQ : ∀ φ : E2 → ℝ, Continuous φ → IntegrableOn (fun x => φ x ^ 2) L := fun φ hφ =>
    (hφ.pow 2).continuousOn.integrableOn_compact hL
  have hAM : ∀ a b t : ℝ, 0 < t → |a * b| ≤ t / 2 * a ^ 2 + 1 / (2 * t) * b ^ 2 := by
    intro a b t ht
    rw [abs_mul]
    have h1 : 0 ≤ (t * |a| - |b|) ^ 2 := sq_nonneg _
    have h2 : |a| ^ 2 = a ^ 2 := sq_abs a
    have h3 : |b| ^ 2 = b ^ 2 := sq_abs b
    have key : 2 * t * (|a| * |b|) ≤ t ^ 2 * a ^ 2 + b ^ 2 := by nlinarith
    have e : t / 2 * a ^ 2 + 1 / (2 * t) * b ^ 2 = (t ^ 2 * a ^ 2 + b ^ 2) / (2 * t) := by
      field_simp
    rw [e, le_div_iff₀ (by positivity)]
    linarith
  have hAM1 : ∀ a b : ℝ, |a * b| ≤ 1 / 2 * a ^ 2 + 1 / 2 * b ^ 2 := by
    intro a b
    rw [abs_mul]
    nlinarith [sq_nonneg (|a| - |b|), sq_abs a, sq_abs b]
  have part1 : ∀ f : E2 → ℝ, ContinuousOn f L → MemLp f 2 (volume.restrict L) := by
    intro f hf
    obtain ⟨C, hC⟩ := hL.exists_bound_of_continuousOn hf
    exact MemLp.of_bound (hf.aestronglyMeasurable hLm) C (ae_restrict_of_forall_mem hLm hC)
  have part2 : ∀ f φ : E2 → ℝ, MemLp f 2 (volume.restrict L) → Continuous φ → tsupport φ ⊆ L →
      Integrable (fun x => f x * φ x) := by
    intro f φ hf hφ hφL
    have hg : Integrable (fun x => 1 / 2 * f x ^ 2 + 1 / 2 * φ x ^ 2) (volume.restrict L) :=
      (hf.integrable_sq.const_mul _).add ((hQ φ hφ).const_mul _)
    have hOn : IntegrableOn (fun x => f x * φ x) L := by
      refine Integrable.mono' hg (hf.aestronglyMeasurable.mul hφ.aestronglyMeasurable) ?_
      refine Filter.Eventually.of_forall (fun x => ?_)
      rw [Real.norm_eq_abs]
      exact hAM1 (f x) (φ x)
    exact hOn.integrable_of_forall_notMem_eq_zero (hZ f φ hφL)
  have part3 : ∀ (v : ℕ → E2 → ℝ) (w φ : E2 → ℝ), (∀ m, MemLp (v m) 2 (volume.restrict L)) →
      MemLp w 2 (volume.restrict L) → Continuous φ → tsupport φ ⊆ L →
      Tendsto (fun m => ∫ x in L, (v m x - w x) ^ 2) atTop (𝓝 0) →
      Tendsto (fun m => ∫ x, v m x * φ x) atTop (𝓝 (∫ x, w x * φ x)) := by
    intro v w φ hv hw hφ hφL hconv
    obtain ⟨P, hP⟩ : ∃ P : ℝ, P = ∫ x in L, φ x ^ 2 := ⟨_, rfl⟩
    have hP0 : 0 ≤ P := by
      rw [hP]
      exact setIntegral_nonneg hLm (fun x _ => sq_nonneg _)
    have hD : ∀ m, Integrable (fun x => (v m x - w x) ^ 2) (volume.restrict L) := fun m =>
      ((hv m).sub hw).integrable_sq
    have hbound : ∀ m (t : ℝ), 0 < t →
        |(∫ x, v m x * φ x) - ∫ x, w x * φ x| ≤
          t / 2 * (∫ x in L, (v m x - w x) ^ 2) + 1 / (2 * t) * P := by
      intro m t ht
      have e1 : (∫ x, v m x * φ x) - ∫ x, w x * φ x = ∫ x in L, (v m x - w x) * φ x := by
        rw [← integral_sub (part2 _ _ (hv m) hφ hφL) (part2 _ _ hw hφ hφL)]
        rw [setIntegral_eq_integral_of_forall_compl_eq_zero
          (fun x hx => hZ (fun y => v m y - w y) φ hφL x hx)]
        congr 1
        funext x
        ring
      rw [e1, ← Real.norm_eq_abs]
      have hH1 : Integrable (fun x => t / 2 * (v m x - w x) ^ 2) (volume.restrict L) :=
        (hD m).const_mul _
      have hH2 : Integrable (fun x => 1 / (2 * t) * φ x ^ 2) (volume.restrict L) :=
        (hQ φ hφ).const_mul _
      have hpt : ∀ᵐ x ∂(volume.restrict L), ‖(v m x - w x) * φ x‖ ≤
          t / 2 * (v m x - w x) ^ 2 + 1 / (2 * t) * φ x ^ 2 := by
        refine Filter.Eventually.of_forall (fun x => ?_)
        rw [Real.norm_eq_abs]
        exact hAM _ _ t ht
      have hle : ‖∫ x in L, (v m x - w x) * φ x‖ ≤
          ∫ x in L, (t / 2 * (v m x - w x) ^ 2 + 1 / (2 * t) * φ x ^ 2) :=
        norm_integral_le_of_norm_le (hH1.add hH2) hpt
      rw [integral_add hH1 hH2, integral_const_mul, integral_const_mul, ← hP] at hle
      exact hle
    rw [Metric.tendsto_atTop]
    intro ε hε
    have ht : 0 < (P + 1) / ε := by positivity
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hconv (ε / ((P + 1) / ε)) (by positivity)
    refine ⟨N, fun m hm => ?_⟩
    have h1 := hN m hm
    rw [Real.dist_eq, sub_zero] at h1
    have h2 := hbound m _ ht
    rw [Real.dist_eq]
    have hDlt : (∫ x in L, (v m x - w x) ^ 2) < ε / ((P + 1) / ε) :=
      lt_of_le_of_lt (le_abs_self _) h1
    have h3 : (P + 1) / ε / 2 * (∫ x in L, (v m x - w x) ^ 2) < ε / 2 := by
      have hm' := mul_lt_mul_of_pos_left hDlt (by positivity : 0 < (P + 1) / ε / 2)
      have e : (P + 1) / ε / 2 * (ε / ((P + 1) / ε)) = ε / 2 := by
        field_simp
      linarith
    have h4 : 1 / (2 * ((P + 1) / ε)) * P < ε / 2 := by
      have e : 1 / (2 * ((P + 1) / ε)) * P = ε * P / (2 * (P + 1)) := by
        field_simp
      rw [e, div_lt_div_iff₀ (by positivity) (by norm_num)]
      nlinarith
    linarith
  exact ⟨part1, part2, part3⟩

theorem el_coeff_continuous (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) (c : E2 → ℝ) (hc : ContDiffOn ℝ ∞ c W) (ζ : E2 → ℝ) (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ) (hζW : tsupport ζ ⊆ W) : (∀ a b : Fin 2, Continuous (fun x => Real.sqrt (h x).det * (h x)⁻¹ a b * pd2 a ζ x) ∧ tsupport (fun x => Real.sqrt (h x).det * (h x)⁻¹ a b * pd2 a ζ x) ⊆ tsupport ζ) ∧ Continuous (fun x => c x * Real.sqrt (h x).det * ζ x) ∧ tsupport (fun x => c x * Real.sqrt (h x).det * ζ x) ⊆ tsupport ζ :=
by
  
  have hd : ∀ a : Fin 2, Continuous (pd2 a ζ) ∧ tsupport (pd2 a ζ) ⊆ tsupport ζ := by
    intro a
    constructor
    · have h1 : Continuous (fderiv ℝ ζ) := hζ.continuous_fderiv (by simp)
      have h2 : Continuous (fun x => fderiv ℝ ζ x (e2 a)) := h1.clm_apply continuous_const
      exact h2
    · refine closure_minimal ?_ (isClosed_tsupport ζ)
      intro x hx
      have hne : fderiv ℝ ζ x ≠ 0 := by
        intro h0
        apply hx
        simp [pd2, h0]
      exact tsupport_fderiv_subset ℝ (subset_tsupport _ hne)
  
  have glue : ∀ F g : E2 → ℝ, (∀ x ∈ W, ContinuousAt F x) → Continuous g → tsupport g ⊆ W →
      Continuous (fun x => F x * g x) ∧ tsupport (fun x => F x * g x) ⊆ tsupport g := by
    intro F g hF hg hgW
    refine ⟨continuous_iff_continuousAt.2 fun x => ?_, tsupport_mul_subset_right⟩
    by_cases hx : x ∈ W
    · exact (hF x hx).mul hg.continuousAt
    · have hxg : x ∉ tsupport g := fun h' => hx (hgW h')
      have hev : g =ᶠ[nhds x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxg
      have hev2 : (fun y => F y * g y) =ᶠ[nhds x] (fun _ => (0:ℝ)) := by
        filter_upwards [hev] with y hy
        simp [hy]
      exact continuousAt_const.congr hev2.symm
  
  have hent : ∀ x ∈ W, ∀ i j : Fin 2, ContinuousAt (fun y => h y i j) x := fun x hx i j =>
    (hh i j).continuousOn.continuousAt (hW.mem_nhds hx)
  have hcx : ∀ x ∈ W, ContinuousAt c x := fun x hx =>
    hc.continuousOn.continuousAt (hW.mem_nhds hx)
  
  have hdet : ∀ x ∈ W, ContinuousAt (fun y => (h y).det) x := by
    intro x hx
    have e : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y; exact Matrix.det_fin_two (h y)
    rw [e]
    exact ((hent x hx 0 0).mul (hent x hx 1 1)).sub ((hent x hx 0 1).mul (hent x hx 1 0))
  
  have hsq : ∀ x ∈ W, ContinuousAt (fun y => Real.sqrt (h y).det) x := fun x hx =>
    (hdet x hx).sqrt
  
  have hinv : ∀ x ∈ W, ∀ a b : Fin 2, ContinuousAt (fun y => (h y)⁻¹ a b) x := by
    intro x hx a b
    have hrepr : (fun y => (h y)⁻¹ a b) = fun y => ((h y).det)⁻¹ * (h y).adjugate a b := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    rw [hrepr]
    have hadj : ContinuousAt (fun y => (h y).adjugate a b) x := by
      fin_cases a <;> fin_cases b <;> simp [Matrix.adjugate_fin_two] <;>
        first
        | exact hent x hx _ _
        | exact (hent x hx _ _).neg
    exact ((hdet x hx).inv₀ (hpos x hx).det_pos.ne').mul hadj
  
  refine ⟨fun a b => ?_, ?_⟩
  · have hF : ∀ x ∈ W, ContinuousAt (fun y => Real.sqrt (h y).det * (h y)⁻¹ a b) x :=
      fun x hx => (hsq x hx).mul (hinv x hx a b)
    obtain ⟨h1, h2⟩ := glue _ _ hF (hd a).1 ((hd a).2.trans hζW)
    exact ⟨h1, h2.trans (hd a).2⟩
  · have hF : ∀ x ∈ W, ContinuousAt (fun y => c y * Real.sqrt (h y).det) x :=
      fun x hx => (hcx x hx).mul (hsq x hx)
    exact glue _ _ hF hζ.continuous hζW

theorem eig_local_weak_limit (N : ℕ) (W : Fin N → Set E2) (hW : ∀ i, IsOpen (W i)) (h : Fin N → E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ i (a b : Fin 2), ContDiffOn ℝ ∞ (fun x => h i x a b) (W i)) (hpos : ∀ i, ∀ x ∈ W i, (h i x).PosDef) (c : Fin N → E2 → ℝ) (hc : ∀ i, ContDiffOn ℝ ∞ (c i) (W i)) (u : ℕ → Fin N → E2 → ℝ) (hu : ∀ n i, ContDiffOn ℝ ∞ (u n i) (W i)) (hbd : ∀ i (L : Set E2), IsCompact L → L ⊆ W i → ∃ C : ℝ, ∀ n, ∫ x in L, ((u n i x) ^ 2 + ∑ k : Fin 2, (pd2 k (u n i) x) ^ 2) ≤ C) (δ : ℕ → ℝ) (hδ : Tendsto δ atTop (𝓝 0)) (hEL : ∀ i (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W i → ∃ M : ℝ, ∀ n (t : ℝ), 0 ≤ δ n + 2 * t * (∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 b (u n i) x * pd2 a ζ x - c i x * Real.sqrt (h i x).det * u n i x * ζ x)) + t ^ 2 * M) : ∃ (ψ : ℕ → ℕ) (w : Fin N → E2 → ℝ) (G : Fin N → Fin 2 → E2 → ℝ), StrictMono ψ ∧ (∀ i (L : Set E2), IsCompact L → L ⊆ W i → MemLp (w i) 2 (volume.restrict L) ∧ ∀ k, MemLp (G i k) 2 (volume.restrict L)) ∧ (∀ i (L : Set E2), IsCompact L → L ⊆ W i → Tendsto (fun m => ∫ x in L, (u (ψ m) i x - w i x) ^ 2) atTop (𝓝 0)) ∧ (∀ i (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W i → ∀ k : Fin 2, ∫ x, w i x * pd2 k ζ x = -(∫ x, G i k x * ζ x)) ∧ ∀ i (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W i → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det * (h i x)⁻¹ a b * G i b x * pd2 a ζ x - c i x * Real.sqrt (h i x).det * w i x * ζ x) = 0 :=
by
  classical
  
  have diag : ∀ (Q : Fin N → (ℕ → ℕ) → Prop),
      (∀ i (ψ φ : ℕ → ℕ), Q i ψ → StrictMono φ → Q i (ψ ∘ φ)) →
      (∀ i (ψ : ℕ → ℕ), StrictMono ψ → ∃ φ : ℕ → ℕ, StrictMono φ ∧ Q i (ψ ∘ φ)) →
      ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ i, Q i ψ := by
    intro Q hmono hext
    have key : ∀ k : ℕ, ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ i : Fin N, i.val < k → Q i ψ := by
      intro k
      induction k with
      | zero => exact ⟨id, strictMono_id, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
      | succ k ih =>
        obtain ⟨ψ, hψ, hQ⟩ := ih
        by_cases hk : k < N
        · obtain ⟨φ, hφ, hQk⟩ := hext ⟨k, hk⟩ ψ hψ
          refine ⟨ψ ∘ φ, hψ.comp hφ, fun i hi => ?_⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
          · exact hmono i ψ φ (hQ i hlt) hφ
          · have hik : i = ⟨k, hk⟩ := Fin.ext heq
            rw [hik]
            exact hQk
        · exact ⟨ψ, hψ, fun i _ => hQ i (lt_of_lt_of_le i.isLt (not_lt.mp hk))⟩
    obtain ⟨ψ, hψ, hQ⟩ := key N
    exact ⟨ψ, hψ, fun i => hQ i i.isLt⟩
  
  have quad : ∀ (B δ' : ℕ → ℝ) (M : ℝ), Tendsto δ' atTop (𝓝 0) →
      (∀ n (t : ℝ), 0 ≤ δ' n + 2 * t * B n + t ^ 2 * M) → Tendsto B atTop (𝓝 0) := by
    intro B δ' M hδ' hq
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hM1 : 0 < |M| + 1 := by positivity
    have hs0 : 0 < ε / (|M| + 1) := div_pos hε hM1
    obtain ⟨n0, hn0⟩ := Metric.tendsto_atTop.mp hδ' (ε / (|M| + 1) * ε) (mul_pos hs0 hε)
    refine ⟨n0, fun n hn => ?_⟩
    have h1 := hq n (ε / (|M| + 1))
    have h2 := hq n (-(ε / (|M| + 1)))
    have hd := hn0 n hn
    rw [Real.dist_eq, sub_zero] at hd ⊢
    have hd' : δ' n < ε / (|M| + 1) * ε := (abs_lt.mp hd).2
    have hsM : ε / (|M| + 1) * |M| < ε := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ hM1]
      nlinarith [abs_nonneg M]
    have k1 : (ε / (|M| + 1)) ^ 2 * M ≤ ε / (|M| + 1) * (ε / (|M| + 1) * |M|) := by
      have := mul_le_mul_of_nonneg_left (le_abs_self M) (sq_nonneg (ε / (|M| + 1)))
      nlinarith
    have k2 : ε / (|M| + 1) * (ε / (|M| + 1) * |M|) < ε / (|M| + 1) * ε :=
      mul_lt_mul_of_pos_left hsM hs0
    rw [abs_lt]
    constructor
    · nlinarith
    · nlinarith
  have hmain : ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ i, ∃ (wi : E2 → ℝ) (Gi : Fin 2 → E2 → ℝ),
      (∀ (L : Set E2), IsCompact L → L ⊆ W i → MemLp wi 2 (volume.restrict L) ∧
        ∀ k, MemLp (Gi k) 2 (volume.restrict L)) ∧
      (∀ (L : Set E2), IsCompact L → L ⊆ W i →
        Tendsto (fun m => ∫ x in L, (u (ψ m) i x - wi x) ^ 2) atTop (𝓝 0)) ∧
      (∀ (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W i →
        ∀ k : Fin 2, ∫ x, wi x * pd2 k ζ x = -(∫ x, Gi k x * ζ x)) ∧
      ∀ (ζ : E2 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W i →
        ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det * (h i x)⁻¹ a b * Gi b x * pd2 a ζ x
          - c i x * Real.sqrt (h i x).det * wi x * ζ x) = 0 := by
    apply diag
    · intro i ψ φ hQ hφ
      obtain ⟨wi, Gi, h1, h2, h3, h4⟩ := hQ
      exact ⟨wi, Gi, h1, fun L hL hLW => (h2 L hL hLW).comp hφ.tendsto_atTop, h3, h4⟩
    · intro i σ hσ
      have hUc : ∀ n, ContinuousOn (u n i) (W i) := fun n => (hu n i).continuousOn
      have hUdc : ∀ n (k : Fin 2), ContinuousOn (pd2 k (u n i)) (W i) := by
        intro n k
        have h1 := (hu n i).continuousOn_fderiv_of_isOpen (hW i) (by simp)
        exact h1.clm_apply continuousOn_const
      have hint : ∀ (f : E2 → ℝ) (L : Set E2), IsCompact L → L ⊆ W i → ContinuousOn f (W i) →
          IntegrableOn (fun x => f x ^ 2) L := by
        intro f L hL hLW hf
        exact ((hf.mono hLW).pow 2).integrableOn_compact hL
      have hbd2 : ∀ (L : Set E2), IsCompact L → L ⊆ W i → ∃ C : ℝ, ∀ n,
          (∫ x in L, (u n i x) ^ 2 ≤ C) ∧ ∀ k : Fin 2, ∫ x in L, (pd2 k (u n i) x) ^ 2 ≤ C := by
        intro L hL hLW
        obtain ⟨C, hC⟩ := hbd i L hL hLW
        have hsum : ∀ n, IntegrableOn
            (fun x => (u n i x) ^ 2 + ∑ k : Fin 2, (pd2 k (u n i) x) ^ 2) L := by
          intro n
          exact (hint _ L hL hLW (hUc n)).add
            (integrable_finset_sum _ fun k _ => hint _ L hL hLW (hUdc n k))
        refine ⟨C, fun n => ⟨?_, fun k => ?_⟩⟩
        · refine le_trans (setIntegral_mono_on (hint _ L hL hLW (hUc n)) (hsum n)
            hL.measurableSet ?_) (hC n)
          intro x _
          have : 0 ≤ ∑ k : Fin 2, (pd2 k (u n i) x) ^ 2 :=
            Finset.sum_nonneg fun k _ => sq_nonneg _
          linarith
        · refine le_trans (setIntegral_mono_on (hint _ L hL hLW (hUdc n k)) (hsum n)
            hL.measurableSet ?_) (hC n)
          intro x _
          have h1 : (pd2 k (u n i) x) ^ 2 ≤ ∑ k' : Fin 2, (pd2 k' (u n i) x) ^ 2 :=
            Finset.single_le_sum (f := fun k' => (pd2 k' (u n i) x) ^ 2)
              (fun k' _ => sq_nonneg _) (Finset.mem_univ k)
          nlinarith [sq_nonneg (u n i x)]
      
      obtain ⟨ψ₁, hψ₁, hcau⟩ := rellich_local_cauchy (W i) (hW i) (fun n => u (σ n) i)
        (fun n => hu (σ n) i)
        (fun L hL hLW => by
          obtain ⟨C, hC⟩ := hbd i L hL hLW
          exact ⟨C, fun n => hC (σ n)⟩)
      
      obtain ⟨w, hwL2, hwconv⟩ := l2loc_limit_of_cauchy (W i) (hW i)
        (fun m => u (σ (ψ₁ m)) i) (fun m => hUc _)
        (fun L hL hLW => by
          obtain ⟨C, hC⟩ := hbd2 L hL hLW
          exact ⟨C, fun m => (hC (σ (ψ₁ m))).1⟩) hcau
      
      obtain ⟨ψ₂, G, hψ₂, hGL2, hGw⟩ := l2loc_weak_subseq (W i) (hW i)
        (fun m k => pd2 k (u (σ (ψ₁ m)) i)) (fun m k => hUdc _ k)
        (fun L hL hLW => by
          obtain ⟨C, hC⟩ := hbd2 L hL hLW
          exact ⟨C, fun m k => (hC (σ (ψ₁ m))).2 k⟩)
      have hφ : StrictMono (ψ₁ ∘ ψ₂) := hψ₁.comp hψ₂
      have hconv : ∀ L : Set E2, IsCompact L → L ⊆ W i →
          Tendsto (fun m => ∫ x in L, (u (σ (ψ₁ (ψ₂ m))) i x - w x) ^ 2) atTop (𝓝 0) :=
        fun L hL hLW => (hwconv L hL hLW).comp hψ₂.tendsto_atTop
      refine ⟨ψ₁ ∘ ψ₂, hφ, w, G, fun L hL hLW => ⟨hwL2 L hL hLW, fun k => hGL2 L hL hLW k⟩,
        hconv, ?_, ?_⟩
      · 
        intro ζ hζ hζc hζW k
        have hLc : IsCompact (tsupport ζ) := hζc
        obtain ⟨hs7i, -, hs7iii⟩ := l2_compact_pairing (tsupport ζ) hLc
        have hdζc : Continuous (pd2 k ζ) :=
          (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
        have hdζs : tsupport (pd2 k ζ) ⊆ tsupport ζ := by
          refine closure_minimal (fun x hx => ?_) (isClosed_tsupport ζ)
          refine tsupport_fderiv_subset ℝ (subset_tsupport _ ?_)
          rw [Function.mem_support] at hx ⊢
          intro h0
          apply hx
          simp [pd2, h0]
        have hUL : ∀ m, MemLp (u (σ (ψ₁ (ψ₂ m))) i) 2 (volume.restrict (tsupport ζ)) :=
          fun m => hs7i _ ((hUc _).mono hζW)
        have hlim1 : Tendsto (fun m => ∫ x, u (σ (ψ₁ (ψ₂ m))) i x * pd2 k ζ x) atTop
            (𝓝 (∫ x, w x * pd2 k ζ x)) :=
          hs7iii (fun m => u (σ (ψ₁ (ψ₂ m))) i) w (pd2 k ζ) hUL (hwL2 _ hLc hζW) hdζc hdζs
            (hconv _ hLc hζW)
        have hlim2 : Tendsto (fun m => -(∫ x, pd2 k (u (σ (ψ₁ (ψ₂ m))) i) x * ζ x)) atTop
            (𝓝 (-(∫ x, G k x * ζ x))) :=
          (hGw k ζ hζ.continuous hζc hζW).neg
        have heq : (fun m => ∫ x, u (σ (ψ₁ (ψ₂ m))) i x * pd2 k ζ x) =
            fun m => -(∫ x, pd2 k (u (σ (ψ₁ (ψ₂ m))) i) x * ζ x) := by
          funext m
          exact ibp_open_test (W i) (hW i) _ (hu _ i) ζ hζ hζc hζW k
        rw [heq] at hlim1
        exact tendsto_nhds_unique hlim1 hlim2
      · 
        intro ζ hζ hζc hζW
        have hLc : IsCompact (tsupport ζ) := hζc
        obtain ⟨hs7i, hs7ii, hs7iii⟩ := l2_compact_pairing (tsupport ζ) hLc
        obtain ⟨hα, hΨc, hΨs⟩ := el_coeff_continuous (W i) (hW i) (h i) (hh i) (hpos i) (c i)
          (hc i) ζ hζ hζc hζW
        obtain ⟨M, hM⟩ := hEL i ζ hζ hζc hζW
        have hsplit : ∀ (V : E2 → ℝ) (P : Fin 2 → E2 → ℝ),
            MemLp V 2 (volume.restrict (tsupport ζ)) →
            (∀ b, MemLp (P b) 2 (volume.restrict (tsupport ζ))) →
            ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det * (h i x)⁻¹ a b * P b x *
              pd2 a ζ x - c i x * Real.sqrt (h i x).det * V x * ζ x)
            = (∑ a : Fin 2, ∑ b : Fin 2,
                ∫ x, P b x * (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x))
              - ∫ x, V x * (c i x * Real.sqrt (h i x).det * ζ x) := by
          intro V P hV hP
          have hI : ∀ a b : Fin 2, Integrable
              (fun x => P b x * (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x)) :=
            fun a b => hs7ii _ _ (hP b) (hα a b).1 (hα a b).2
          have hJ : Integrable (fun x => V x * (c i x * Real.sqrt (h i x).det * ζ x)) :=
            hs7ii _ _ hV hΨc hΨs
          have hpt : (fun x => (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det *
                (h i x)⁻¹ a b * P b x * pd2 a ζ x - c i x * Real.sqrt (h i x).det * V x * ζ x))
              = fun x => (∑ a : Fin 2, ∑ b : Fin 2,
                  P b x * (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x))
                - V x * (c i x * Real.sqrt (h i x).det * ζ x) := by
            funext x
            congr 1
            · exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
            · ring
          have hA : Integrable (fun x => ∑ a : Fin 2, ∑ b : Fin 2,
              P b x * (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x)) :=
            integrable_finset_sum _ fun a _ => integrable_finset_sum _ fun b _ => hI a b
          rw [hpt, integral_sub hA hJ]
          congr 1
          exact (integral_finset_sum _ fun a _ =>
              integrable_finset_sum _ fun b _ => hI a b).trans
            (Finset.sum_congr rfl fun a _ => integral_finset_sum _ fun b _ => hI a b)
        have hB0 : Tendsto (fun m => ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det *
              (h i x)⁻¹ a b * pd2 b (u (σ (ψ₁ (ψ₂ m))) i) x * pd2 a ζ x
              - c i x * Real.sqrt (h i x).det * u (σ (ψ₁ (ψ₂ m))) i x * ζ x)) atTop (𝓝 0) :=
          quad _ (fun m => δ (σ (ψ₁ (ψ₂ m)))) M (hδ.comp (hσ.comp hφ).tendsto_atTop)
            (fun m t => hM (σ (ψ₁ (ψ₂ m))) t)
        have hUL : ∀ m, MemLp (u (σ (ψ₁ (ψ₂ m))) i) 2 (volume.restrict (tsupport ζ)) :=
          fun m => hs7i _ ((hUc _).mono hζW)
        have hdUL : ∀ m (b : Fin 2),
            MemLp (pd2 b (u (σ (ψ₁ (ψ₂ m))) i)) 2 (volume.restrict (tsupport ζ)) :=
          fun m b => hs7i _ ((hUdc _ b).mono hζW)
        have hαcs : ∀ a b : Fin 2, HasCompactSupport
            (fun x => Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x) :=
          fun a b => hLc.of_isClosed_subset (isClosed_tsupport _) (hα a b).2
        have hBE : Tendsto (fun m => ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det *
              (h i x)⁻¹ a b * pd2 b (u (σ (ψ₁ (ψ₂ m))) i) x * pd2 a ζ x
              - c i x * Real.sqrt (h i x).det * u (σ (ψ₁ (ψ₂ m))) i x * ζ x)) atTop
            (𝓝 ((∑ a : Fin 2, ∑ b : Fin 2,
                ∫ x, G b x * (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x))
              - ∫ x, w x * (c i x * Real.sqrt (h i x).det * ζ x))) := by
          have e1 : (fun m => ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h i x).det *
                (h i x)⁻¹ a b * pd2 b (u (σ (ψ₁ (ψ₂ m))) i) x * pd2 a ζ x
                - c i x * Real.sqrt (h i x).det * u (σ (ψ₁ (ψ₂ m))) i x * ζ x)) =
              fun m => (∑ a : Fin 2, ∑ b : Fin 2, ∫ x, pd2 b (u (σ (ψ₁ (ψ₂ m))) i) x *
                  (Real.sqrt (h i x).det * (h i x)⁻¹ a b * pd2 a ζ x))
                - ∫ x, u (σ (ψ₁ (ψ₂ m))) i x * (c i x * Real.sqrt (h i x).det * ζ x) := by
            funext m
            exact hsplit (u (σ (ψ₁ (ψ₂ m))) i) (fun b => pd2 b (u (σ (ψ₁ (ψ₂ m))) i))
              (hUL m) (hdUL m)
          rw [e1]
          refine Tendsto.sub (tendsto_finset_sum _ fun a _ => tendsto_finset_sum _ fun b _ => ?_) ?_
          · exact hGw b _ (hα a b).1 (hαcs a b) ((hα a b).2.trans hζW)
          · exact hs7iii (fun m => u (σ (ψ₁ (ψ₂ m))) i) w _ hUL (hwL2 _ hLc hζW) hΨc hΨs
              (hconv _ hLc hζW)
        have hE0 := tendsto_nhds_unique hBE hB0
        rw [hsplit w G (hwL2 _ hLc hζW) (fun b => hGL2 _ hLc hζW b)]
        exact hE0
  obtain ⟨ψ, hψ, hQ⟩ := hmain
  choose w G hw using hQ
  exact ⟨ψ, w, G, hψ, fun i L hL hLW => (hw i).1 L hL hLW, fun i => (hw i).2.1,
    fun i => (hw i).2.2.1, fun i => (hw i).2.2.2⟩

theorem elr_coeff_smooth (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) : (∀ x ∈ W, 0 < Real.sqrt (h x).det) ∧ ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) W ∧ (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ a b) W) ∧ ∀ x ∈ W, (Real.sqrt (h x).det • (h x)⁻¹).PosDef :=
by
  have hdet : ∀ x ∈ W, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
  have hdetS : ContDiffOn ℝ ∞ (fun x => (h x).det) W := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two (h x)
    rw [e]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hD : ContDiffOn ℝ ∞ (fun x => ((h x).det)⁻¹) W :=
    hdetS.inv (fun x hx => (hdet x hx).ne')
  have hentry : ∀ (x : E2) (a b : Fin 2),
      (h x)⁻¹ a b = ((h x).det)⁻¹ * (h x).adjugate a b := by
    intro x a b
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv]
  refine ⟨fun x hx => Real.sqrt_pos.mpr (hdet x hx),
    hdetS.sqrt (fun x hx => (hdet x hx).ne'), ?_,
    fun x hx => ((hpos x hx).inv).smul (Real.sqrt_pos.mpr (hdet x hx))⟩
  intro a b
  have e : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b := by
    funext x; exact hentry x a b
  rw [e]
  refine hD.mul ?_
  fin_cases a <;> fin_cases b
  · refine (hh 1 1).congr (fun x _ => ?_)
    rw [Matrix.adjugate_fin_two]; simp
  · refine (hh 0 1).neg.congr (fun x _ => ?_)
    rw [Matrix.adjugate_fin_two]; simp
  · refine (hh 1 0).neg.congr (fun x _ => ?_)
    rw [Matrix.adjugate_fin_two]; simp
  · refine (hh 0 0).congr (fun x _ => ?_)
    rw [Matrix.adjugate_fin_two]; simp

theorem elr_div_identity (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u W) (x : E2) (hx : x ∈ W) : ∑ a : Fin 2, pd2 a (fun y => ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b u y) x = Real.sqrt (h x).det * lap2 h u x :=
by
  classical
  have hWx : W ∈ 𝓝 x := hW.mem_nhds hx
  have hE : ∀ i j : Fin 2, DifferentiableAt ℝ (fun y => h y i j) x := fun i j =>
    ((hh i j).contDiffAt hWx).differentiableAt (by simp)
  have hsy : ∀ y ∈ W, h y 1 0 = h y 0 1 := by
    intro y hy
    have h1 := (hpos y hy).isHermitian.apply 0 1
    simpa using h1
  have hsyD : ∀ c : Fin 2, pd2 c (fun y => h y 1 0) x = pd2 c (fun y => h y 0 1) x := by
    intro c
    have hev : (fun y => h y 1 0) =ᶠ[𝓝 x] (fun y => h y 0 1) := by
      filter_upwards [hWx] with y hy using hsy y hy
    simp only [pd2]
    rw [hev.fderiv_eq]
  have hV : ∀ b : Fin 2, DifferentiableAt ℝ (pd2 b u) x := by
    intro b
    have h2le : (1 : WithTop ℕ∞) + 1 ≤ ∞ := WithTop.coe_le_coe.mpr le_top
    have h1 : ContDiffAt ℝ 1 (fderiv ℝ u) x :=
      (hu.contDiffAt hWx).fderiv_right h2le
    have h2 : ContDiffAt ℝ 1 (fun y => fderiv ℝ u y (e2 b)) x := h1.clm_apply contDiffAt_const
    exact h2.differentiableAt (by simp)
  
  have pd_add : ∀ (c : Fin 2) (f g : E2 → ℝ), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 c (fun y => f y + g y) x = pd2 c f x + pd2 c g x := by
    intro c f g hf hg
    simp only [pd2]
    rw [fderiv_fun_add hf hg]
    rfl
  have pd_sub : ∀ (c : Fin 2) (f g : E2 → ℝ), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 c (fun y => f y - g y) x = pd2 c f x - pd2 c g x := by
    intro c f g hf hg
    simp only [pd2]
    rw [show (fun y => f y - g y) = f - g from rfl, (hf.hasFDerivAt.sub hg.hasFDerivAt).fderiv]
    rfl
  have pd_neg : ∀ (c : Fin 2) (f : E2 → ℝ), pd2 c (fun y => -f y) x = -pd2 c f x := by
    intro c f
    simp only [pd2]
    rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
    rfl
  have pd_mul : ∀ (c : Fin 2) (f g : E2 → ℝ), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 c (fun y => f y * g y) x = pd2 c f x * g x + f x * pd2 c g x := by
    intro c f g hf hg
    simp only [pd2]
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pd_inv : ∀ (c : Fin 2) (f : E2 → ℝ), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 c (fun y => (f y)⁻¹) x = -pd2 c f x / (f x) ^ 2 := by
    intro c f hf h0
    have h1 := ((hasDerivAt_inv h0).comp_hasFDerivAt x hf.hasFDerivAt).fderiv
    simp only [pd2]
    rw [show (fun y => (f y)⁻¹) = (fun t : ℝ => t⁻¹) ∘ f from rfl, h1]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pd_sqrt : ∀ (c : Fin 2) (f : E2 → ℝ), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 c (fun y => Real.sqrt (f y)) x = pd2 c f x / (2 * Real.sqrt (f x)) := by
    intro c f hf h0
    have h1 := (hf.hasFDerivAt.sqrt h0).fderiv
    simp only [pd2]
    rw [h1]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hdetfun : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
    funext y; exact Matrix.det_fin_two _
  have hdetD : DifferentiableAt ℝ (fun y => (h y).det) x := by
    rw [hdetfun]; exact ((hE 0 0).mul (hE 1 1)).sub ((hE 0 1).mul (hE 1 0))
  have hdetd : ∀ c : Fin 2, pd2 c (fun y => (h y).det) x =
      pd2 c (fun y => h y 0 0) x * h x 1 1 + h x 0 0 * pd2 c (fun y => h y 1 1) x
        - (pd2 c (fun y => h y 0 1) x * h x 1 0 + h x 0 1 * pd2 c (fun y => h y 1 0) x) := by
    intro c
    rw [hdetfun, pd_sub c (fun y => h y 0 0 * h y 1 1) (fun y => h y 0 1 * h y 1 0)
        ((hE 0 0).fun_mul (hE 1 1)) ((hE 0 1).fun_mul (hE 1 0)),
      pd_mul c (fun y => h y 0 0) (fun y => h y 1 1) (hE 0 0) (hE 1 1),
      pd_mul c (fun y => h y 0 1) (fun y => h y 1 0) (hE 0 1) (hE 1 0)]
  have hdpos : 0 < (h x).det := (hpos x hx).det_pos
  have hd0 : (h x).det ≠ 0 := hdpos.ne'
  have hSD : DifferentiableAt ℝ (fun y => Real.sqrt (h y).det) x := hdetD.sqrt hd0
  have hσσ : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det := Real.mul_self_sqrt hdpos.le
  have hσ0 : Real.sqrt (h x).det ≠ 0 := (Real.sqrt_pos.mpr hdpos).ne'
  have hSd : ∀ c : Fin 2, pd2 c (fun y => Real.sqrt (h y).det) x =
      Real.sqrt (h x).det / (2 * (h x).det) * pd2 c (fun y => (h y).det) x := by
    intro c
    rw [pd_sqrt c (fun y => (h y).det) hdetD hd0]
    calc pd2 c (fun y => (h y).det) x / (2 * Real.sqrt (h x).det)
        = Real.sqrt (h x).det / (2 * (Real.sqrt (h x).det * Real.sqrt (h x).det))
            * pd2 c (fun y => (h y).det) x := by
          field_simp
      _ = _ := by rw [hσσ]
  
  have hinvpt : ∀ y (a b : Fin 2), (h y)⁻¹ a b = ((h y).det)⁻¹ * (h y).adjugate a b := by
    intro y a b
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hinvfun : ∀ a b : Fin 2,
      (fun y => (h y)⁻¹ a b) = fun y => ((h y).det)⁻¹ * (h y).adjugate a b := by
    intro a b; funext y; exact hinvpt y a b
  have hA00 : ∀ y, (h y).adjugate 0 0 = h y 1 1 := fun y => by simp [Matrix.adjugate_fin_two]
  have hA01 : ∀ y, (h y).adjugate 0 1 = -h y 0 1 := fun y => by simp [Matrix.adjugate_fin_two]
  have hA10 : ∀ y, (h y).adjugate 1 0 = -h y 1 0 := fun y => by simp [Matrix.adjugate_fin_two]
  have hA11 : ∀ y, (h y).adjugate 1 1 = h y 0 0 := fun y => by simp [Matrix.adjugate_fin_two]
  have hadjD : ∀ a b : Fin 2, DifferentiableAt ℝ (fun y => (h y).adjugate a b) x := by
    simp only [Fin.forall_fin_two, hA00, hA01, hA10, hA11]
    exact ⟨⟨hE 1 1, (hE 0 1).neg⟩, ⟨(hE 1 0).neg, hE 0 0⟩⟩
  have hinvD : ∀ a b : Fin 2, DifferentiableAt ℝ (fun y => (h y)⁻¹ a b) x := by
    intro a b
    rw [hinvfun a b]
    exact (hdetD.inv hd0).mul (hadjD a b)
  have hinvd : ∀ c a b : Fin 2, pd2 c (fun y => (h y)⁻¹ a b) x =
      -pd2 c (fun y => (h y).det) x / ((h x).det) ^ 2 * (h x).adjugate a b
        + ((h x).det)⁻¹ * pd2 c (fun y => (h y).adjugate a b) x := by
    intro c a b
    have hdi : DifferentiableAt ℝ (fun y => ((h y).det)⁻¹) x := hdetD.inv hd0
    rw [hinvfun a b, pd_mul c (fun y => ((h y).det)⁻¹) (fun y => (h y).adjugate a b) hdi (hadjD a b),
      pd_inv c (fun y => (h y).det) hdetD hd0]
  
  have hL : ∀ a : Fin 2,
      pd2 a (fun y => ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b u y) x =
        ∑ b : Fin 2, (pd2 a (fun y => Real.sqrt (h y).det) x * (h x)⁻¹ a b * pd2 b u x
          + Real.sqrt (h x).det * pd2 a (fun y => (h y)⁻¹ a b) x * pd2 b u x
          + Real.sqrt (h x).det * (h x)⁻¹ a b * pd2 a (pd2 b u) x) := by
    intro a
    have hsum : (fun y => ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b u y) =
        fun y => Real.sqrt (h y).det * (h y)⁻¹ a 0 * pd2 0 u y
          + Real.sqrt (h y).det * (h y)⁻¹ a 1 * pd2 1 u y := by
      funext y; exact Fin.sum_univ_two _
    have d2 : ∀ b : Fin 2,
        DifferentiableAt ℝ (fun y => Real.sqrt (h y).det * (h y)⁻¹ a b) x :=
      fun b => hSD.fun_mul (hinvD a b)
    have d3 : ∀ b : Fin 2,
        DifferentiableAt ℝ (fun y => Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b u y) x :=
      fun b => (d2 b).fun_mul (hV b)
    rw [hsum, pd_add a (fun y => Real.sqrt (h y).det * (h y)⁻¹ a 0 * pd2 0 u y)
        (fun y => Real.sqrt (h y).det * (h y)⁻¹ a 1 * pd2 1 u y) (d3 0) (d3 1),
      pd_mul a (fun y => Real.sqrt (h y).det * (h y)⁻¹ a 0) (pd2 0 u) (d2 0) (hV 0),
      pd_mul a (fun y => Real.sqrt (h y).det * (h y)⁻¹ a 1) (pd2 1 u) (d2 1) (hV 1),
      pd_mul a (fun y => Real.sqrt (h y).det) (fun y => (h y)⁻¹ a 0) hSD (hinvD a 0),
      pd_mul a (fun y => Real.sqrt (h y).det) (fun y => (h y)⁻¹ a 1) hSD (hinvD a 1),
      Fin.sum_univ_two]
    ring
  
  rw [Fin.sum_univ_two, hL 0, hL 1]
  simp only [lap2, christoffel2, Fin.sum_univ_two]
  simp only [hSd, hinvd, hdetd]
  simp only [hinvpt x, hA00, hA01, hA10, hA11, pd_neg]
  simp only [hsyD, hsy x hx]
  generalize Real.sqrt (h x).det = σ
  have hdeq : (h x).det = h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 := by
    rw [Matrix.det_fin_two, hsy x hx]
  generalize (h x).det = d at hdeq hd0 ⊢
  field_simp
  subst hdeq
  ring

theorem elr_weak_to_strong (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) (hpos : ∀ x ∈ W, (h x).PosDef) (c : E2 → ℝ) (hc : ContDiffOn ℝ ∞ c W) (w w' : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W → MemLp w 2 (volume.restrict L) ∧ ∀ k, MemLp (G k) 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W → ∀ k : Fin 2, ∫ x, w x * pd2 k ζ x = -(∫ x, G k x * ζ x)) (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h x).det * (h x)⁻¹ a b * G b x * pd2 a ζ x - c x * Real.sqrt (h x).det * w x * ζ x) = 0) (hw' : ContDiffOn ℝ ∞ w' W) (hae : ∀ᵐ x ∂(volume.restrict W), w x = w' x) : ∀ x ∈ W, ∑ a : Fin 2, pd2 a (fun y => ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b w' y) x + c x * Real.sqrt (h x).det * w' x = 0 :=
by
  have hWm : MeasurableSet W := hW.measurableSet
  
  have hfdz : ∀ ζ : E2 → ℝ, tsupport ζ ⊆ W → ∀ x, x ∉ W → ζ x = 0 ∧ ∀ a : Fin 2, pd2 a ζ x = 0 := by
    intro ζ hζW x hx
    have hx' : x ∉ tsupport ζ := fun hm => hx (hζW hm)
    refine ⟨image_eq_zero_of_notMem_tsupport hx', fun a => ?_⟩
    have hx'' : x ∉ tsupport (fderiv ℝ ζ) := fun hm => hx' (tsupport_fderiv_subset ℝ hm)
    have h0 : fderiv ℝ ζ x = 0 := image_eq_zero_of_notMem_tsupport hx''
    show fderiv ℝ ζ x (e2 a) = 0
    rw [h0, ContinuousLinearMap.zero_apply]
  
  have hpdtest : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ W →
      ∀ a : Fin 2, Continuous (pd2 a ζ) ∧ HasCompactSupport (pd2 a ζ) ∧ tsupport (pd2 a ζ) ⊆ W := by
    intro ζ hζ hζc hζW a
    have hcont : Continuous (pd2 a ζ) := by
      show Continuous (fun x => fderiv ℝ ζ x (e2 a))
      exact (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hsupp : Function.support (pd2 a ζ) ⊆ tsupport ζ := by
      intro x hx
      by_contra hxn
      apply hx
      have h0 : fderiv ℝ ζ x = 0 :=
        image_eq_zero_of_notMem_tsupport (fun hm => hxn (tsupport_fderiv_subset ℝ hm))
      show fderiv ℝ ζ x (e2 a) = 0
      rw [h0, ContinuousLinearMap.zero_apply]
    exact ⟨hcont, hζc.mono' hsupp, (closure_minimal hsupp (isClosed_tsupport ζ)).trans hζW⟩
  
  have hpd_smooth : ∀ u : E2 → ℝ, ContDiffOn ℝ ∞ u W → ∀ i : Fin 2, ContDiffOn ℝ ∞ (pd2 i u) W := by
    intro u hu i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ u) W := ContDiffOn.fderiv_of_isOpen (m := ∞) hu hW (by simp)
    show ContDiffOn ℝ ∞ (fun x => fderiv ℝ u x (e2 i)) W
    exact h1.clm_apply contDiffOn_const
  
  have s1 : ∀ u φ : E2 → ℝ, ContinuousOn u W → Continuous φ → HasCompactSupport φ →
      tsupport φ ⊆ W → Integrable (fun x => u x * φ x) := by
    intro u φ hu hφ hφc hφW
    have hcont : Continuous (fun x => u x * φ x) := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ W
      · exact (hu.continuousAt (hW.mem_nhds hx)).mul hφ.continuousAt
      · have hO : (tsupport φ)ᶜ ∈ 𝓝 x :=
          (isClosed_tsupport φ).isOpen_compl.mem_nhds (fun hm => hx (hφW hm))
        have hev : (fun _ => (0 : ℝ)) =ᶠ[𝓝 x] (fun y => u y * φ y) := by
          filter_upwards [hO] with y hy
          rw [image_eq_zero_of_notMem_tsupport hy, mul_zero]
        exact continuousAt_const.congr hev
    exact hcont.integrable_of_hasCompactSupport (HasCompactSupport.mul_left (f := u) hφc)
  have hpdw'cont : ∀ k : Fin 2, ContinuousOn (pd2 k w') W := fun k =>
    (hpd_smooth w' hw' k).continuousOn
  
  have ibpL : ∀ u : E2 → ℝ, ContDiffOn ℝ ∞ u W → ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ →
      HasCompactSupport ζ → tsupport ζ ⊆ W → ∀ k : Fin 2,
      ∫ x, u x * pd2 k ζ x = -(∫ x, pd2 k u x * ζ x) := by
    intro u hu ζ hζ hζc hζW k
    have hvan : ∀ x, x ∉ W → (ζ =ᶠ[𝓝 x] 0) := fun x hx =>
      notMem_tsupport_iff_eventuallyEq.mp (fun hm => hx (hζW hm))
    have hFder : ∀ x, HasFDerivAt (fun y => u y * ζ y)
        (fderiv ℝ (fun y => u y * ζ y) x) x ∧
        fderiv ℝ (fun y => u y * ζ y) x (e2 k) = pd2 k u x * ζ x + u x * pd2 k ζ x := by
      intro x
      by_cases hx : x ∈ W
      · have hu' : HasFDerivAt u (fderiv ℝ u x) x :=
          ((hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)).hasFDerivAt
        have hζ' : HasFDerivAt ζ (fderiv ℝ ζ x) x :=
          (hζ.differentiable (by simp) x).hasFDerivAt
        have hm : HasFDerivAt (fun y => u y * ζ y)
            (u x • fderiv ℝ ζ x + ζ x • fderiv ℝ u x) x := hu'.mul hζ'
        refine ⟨hm.differentiableAt.hasFDerivAt, ?_⟩
        rw [hm.fderiv]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, pd2]
        ring
      · have hF0 : (fun y => u y * ζ y) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) := by
          filter_upwards [hvan x hx] with y hy
          simp only [Pi.zero_apply] at hy
          simp [hy]
        have hd : HasFDerivAt (fun y => u y * ζ y) (0 : E2 →L[ℝ] ℝ) x :=
          (hasFDerivAt_const (0 : ℝ) x).congr_of_eventuallyEq hF0
        refine ⟨hd.differentiableAt.hasFDerivAt, ?_⟩
        rw [hd.fderiv, (hfdz ζ hζW x hx).1, (hfdz ζ hζW x hx).2 k]
        simp
    have hFd : Differentiable ℝ (fun y => u y * ζ y) :=
      fun x => (hFder x).1.differentiableAt
    have hprod : (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) =
        fun x => pd2 k u x * ζ x + u x * pd2 k ζ x := funext fun x => (hFder x).2
    have hpz := hpdtest ζ hζ hζc hζW k
    have hg₁ : Integrable (fun x => pd2 k u x * ζ x) :=
      s1 _ ζ (hpd_smooth u hu k).continuousOn hζ.continuous hζc hζW
    have hg₂ : Integrable (fun x => u x * pd2 k ζ x) :=
      s1 u (pd2 k ζ) hu.continuousOn hpz.1 hpz.2.1 hpz.2.2
    have hF : Integrable (fun x => u x * ζ x) := s1 u ζ hu.continuousOn hζ.continuous hζc hζW
    have hF' : Integrable (fun x => fderiv ℝ (fun y => u y * ζ y) x (e2 k)) := by
      rw [hprod]; exact hg₁.add hg₂
    have hI := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun y => u y * ζ y) (g := fun _ => (1 : ℝ)) (v := e2 k)
      (by simpa using hF') (by simp) (by simpa using hF) hFd (differentiable_const 1)
    have hzero : ∫ x, fderiv ℝ (fun y => u y * ζ y) x (e2 k) = 0 := by
      simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply, mul_zero, integral_zero,
        mul_one] at hI
      linarith
    rw [hprod, integral_add hg₁ hg₂] at hzero
    linarith
  have haeW : ∀ᵐ x ∂volume, x ∈ W → w x = w' x := (ae_restrict_iff' hWm).1 hae
  
  have s2 : ∀ k : Fin 2, ∀ᵐ x ∂volume, x ∈ W → G k x = pd2 k w' x := by
    intro k
    have hloc : LocallyIntegrableOn (fun x => G k x - pd2 k w' x) W volume := by
      rw [locallyIntegrableOn_iff hW.isLocallyClosed]
      intro L hLW hL
      haveI : IsFiniteMeasure (volume.restrict L) :=
        isFiniteMeasure_restrict.2 hL.measure_lt_top.ne
      have h1 : IntegrableOn (G k) L volume := ((hL2 L hL hLW).2 k).integrable (by norm_num)
      have h2 : IntegrableOn (pd2 k w') L volume :=
        ((hpdw'cont k).mono hLW).integrableOn_compact hL
      exact h1.sub h2
    have htest : ∀ g : E2 → ℝ, ContDiff ℝ ∞ g → HasCompactSupport g → tsupport g ⊆ W →
        ∫ x, g x • (G k x - pd2 k w' x) = 0 := by
      intro ζ hζ hζc hζW
      have e1 : ∫ x, w x * pd2 k ζ x = ∫ x, w' x * pd2 k ζ x := by
        apply integral_congr_ae
        filter_upwards [haeW] with x hx
        by_cases hxW : x ∈ W
        · rw [hx hxW]
        · rw [(hfdz ζ hζW x hxW).2 k, mul_zero, mul_zero]
      have e2 := ibpL w' hw' ζ hζ hζc hζW k
      have e3 := hgrad ζ hζ hζc hζW k
      have iG : Integrable (fun x => G k x * ζ x) := by
        haveI : IsFiniteMeasure (volume.restrict (tsupport ζ)) :=
          isFiniteMeasure_restrict.2 (IsCompact.measure_lt_top hζc).ne
        have hGi : IntegrableOn (G k) (tsupport ζ) volume :=
          ((hL2 _ hζc hζW).2 k).integrable (by norm_num)
        have h1 : IntegrableOn (fun x => G k x * ζ x) (tsupport ζ) volume :=
          hGi.mul_continuousOn hζ.continuous.continuousOn hζc
        refine (integrableOn_iff_integrable_of_support_subset ?_).1 h1
        intro x hx
        by_contra hxn
        exact hx (show G k x * ζ x = 0 by rw [image_eq_zero_of_notMem_tsupport hxn, mul_zero])
      have iP : Integrable (fun x => pd2 k w' x * ζ x) :=
        s1 _ ζ (hpdw'cont k) hζ.continuous hζc hζW
      have e4 : ∫ x, ζ x • (G k x - pd2 k w' x) = ∫ x, (G k x * ζ x - pd2 k w' x * ζ x) := by
        congr 1; funext x; rw [smul_eq_mul]; ring
      have e5 : ∫ x, (G k x * ζ x - pd2 k w' x * ζ x)
          = (∫ x, G k x * ζ x) - ∫ x, pd2 k w' x * ζ x := integral_sub iG iP
      rw [e4, e5]
      linarith
    have := hW.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc htest
    filter_upwards [this] with x hx hxW
    exact sub_eq_zero.1 (hx hxW)
  
  have s3 : ∀ F : E2 → ℝ, ContinuousOn F W → (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ W → ∫ x, F x * ζ x = 0) → ∀ x ∈ W, F x = 0 := by
    intro F hF h0
    have hloc : LocallyIntegrableOn F W volume := hF.locallyIntegrableOn hWm
    have h1 := hW.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc (fun g hg hgc hgW => by
      have hfun : (fun x => g x • F x) = fun x => F x * g x :=
        funext fun x => by rw [smul_eq_mul, mul_comm]
      rw [hfun]
      exact h0 g hg hgc hgW)
    have h2 : F =ᵐ[volume.restrict W] (fun _ => (0 : ℝ)) := (ae_restrict_iff' hWm).2 h1
    intro x hx
    exact Measure.eqOn_open_of_ae_eq h2 hW hF continuousOn_const hx
  
  have hdet : ∀ x ∈ W, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
  have hdetS : ContDiffOn ℝ ∞ (fun x => (h x).det) W := by
    have he : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two (h x)
    rw [he]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hsq : ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) W :=
    hdetS.sqrt (fun x hx => (hdet x hx).ne')
  have hinv : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ a b) W := by
    have hD : ContDiffOn ℝ ∞ (fun x => ((h x).det)⁻¹) W :=
      hdetS.inv (fun x hx => (hdet x hx).ne')
    have hentry : ∀ (x : E2) (a b : Fin 2),
        (h x)⁻¹ a b = ((h x).det)⁻¹ * (h x).adjugate a b := by
      intro x a b
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv]
    intro a b
    have he : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b := by
      funext x; exact hentry x a b
    rw [he]
    refine hD.mul ?_
    fin_cases a <;> fin_cases b
    · refine (hh 1 1).congr (fun x _ => ?_)
      rw [Matrix.adjugate_fin_two]; simp
    · refine (hh 0 1).neg.congr (fun x _ => ?_)
      rw [Matrix.adjugate_fin_two]; simp
    · refine (hh 1 0).neg.congr (fun x _ => ?_)
      rw [Matrix.adjugate_fin_two]; simp
    · refine (hh 0 0).congr (fun x _ => ?_)
      rw [Matrix.adjugate_fin_two]; simp
  obtain ⟨V, hVdef⟩ : ∃ V : Fin 2 → E2 → ℝ,
      V = fun a y => ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b w' y := ⟨_, rfl⟩
  obtain ⟨Q, hQdef⟩ : ∃ Q : E2 → ℝ, Q = fun x => c x * Real.sqrt (h x).det * w' x := ⟨_, rfl⟩
  have hVa : ∀ a y, V a y = ∑ b : Fin 2, Real.sqrt (h y).det * (h y)⁻¹ a b * pd2 b w' y := by
    intro a y; rw [hVdef]
  have hV : ∀ a : Fin 2, ContDiffOn ℝ ∞ (V a) W := by
    intro a
    rw [hVdef]
    exact ContDiffOn.sum (fun b _ => (hsq.mul (hinv a b)).mul (hpd_smooth w' hw' b))
  have hdV : ∀ a : Fin 2, ContinuousOn (pd2 a (V a)) W := fun a =>
    (hpd_smooth _ (hV a) a).continuousOn
  have hQ : ContinuousOn Q W := by
    rw [hQdef]
    exact ((hc.mul hsq).mul hw').continuousOn
  
  have hall : ∀ᵐ x ∂volume, x ∈ W → (∀ b : Fin 2, G b x = pd2 b w' x) ∧ w x = w' x := by
    have hG' : ∀ᵐ x ∂volume, ∀ b : Fin 2, x ∈ W → G b x = pd2 b w' x := ae_all_iff.2 s2
    filter_upwards [hG', haeW] with x h1 h2 hx
    exact ⟨fun b => h1 b hx, h2 hx⟩
  
  have hgoal : ∀ x ∈ W, ∑ a : Fin 2, pd2 a (V a) x + Q x = 0 := by
    refine s3 (fun x => ∑ a : Fin 2, pd2 a (V a) x + Q x)
      ((continuousOn_finset_sum _ (fun a _ => hdV a)).add hQ) ?_
    intro ζ hζ hζc hζW
    have hIJ : ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, Real.sqrt (h x).det * (h x)⁻¹ a b * G b x * pd2 a ζ x
          - c x * Real.sqrt (h x).det * w x * ζ x)
        = ∫ x, (V 0 x * pd2 0 ζ x + V 1 x * pd2 1 ζ x - Q x * ζ x) := by
      apply integral_congr_ae
      filter_upwards [hall] with x hx
      by_cases hxW : x ∈ W
      · obtain ⟨hGx, hwx⟩ := hx hxW
        simp only [Fin.sum_univ_two, hGx, hwx, hVa, hQdef]
        ring
      · obtain ⟨hz, hpz⟩ := hfdz ζ hζW x hxW
        simp [hz, hpz]
    have hJ : ∫ x, (V 0 x * pd2 0 ζ x + V 1 x * pd2 1 ζ x - Q x * ζ x) = 0 :=
      hIJ.symm.trans (hweak ζ hζ hζc hζW)
    have hpz := hpdtest ζ hζ hζc hζW
    have iV : ∀ a : Fin 2, Integrable (fun x => V a x * pd2 a ζ x) := fun a =>
      s1 (V a) (pd2 a ζ) (hV a).continuousOn (hpz a).1 (hpz a).2.1 (hpz a).2.2
    have iD : ∀ a : Fin 2, Integrable (fun x => pd2 a (V a) x * ζ x) := fun a =>
      s1 _ ζ (hdV a) hζ.continuous hζc hζW
    have iQ : Integrable (fun x => Q x * ζ x) := s1 Q ζ hQ hζ.continuous hζc hζW
    have ibp : ∀ a : Fin 2, ∫ x, V a x * pd2 a ζ x = -(∫ x, pd2 a (V a) x * ζ x) := fun a =>
      ibpL (V a) (hV a) ζ hζ hζc hζW a
    have e1 : ∫ x, (V 0 x * pd2 0 ζ x + V 1 x * pd2 1 ζ x - Q x * ζ x)
        = (∫ x, (V 0 x * pd2 0 ζ x + V 1 x * pd2 1 ζ x)) - ∫ x, Q x * ζ x :=
      integral_sub ((iV 0).add (iV 1)) iQ
    have e2 : ∫ x, (V 0 x * pd2 0 ζ x + V 1 x * pd2 1 ζ x)
        = (∫ x, V 0 x * pd2 0 ζ x) + ∫ x, V 1 x * pd2 1 ζ x := integral_add (iV 0) (iV 1)
    have e3 : ∫ x, (∑ a : Fin 2, pd2 a (V a) x + Q x) * ζ x
        = ∫ x, ((pd2 0 (V 0) x * ζ x + pd2 1 (V 1) x * ζ x) + Q x * ζ x) := by
      congr 1; funext x; simp only [Fin.sum_univ_two]; ring
    have e4 : ∫ x, ((pd2 0 (V 0) x * ζ x + pd2 1 (V 1) x * ζ x) + Q x * ζ x)
        = (∫ x, (pd2 0 (V 0) x * ζ x + pd2 1 (V 1) x * ζ x)) + ∫ x, Q x * ζ x :=
      integral_add ((iD 0).add (iD 1)) iQ
    have e5 : ∫ x, (pd2 0 (V 0) x * ζ x + pd2 1 (V 1) x * ζ x)
        = (∫ x, pd2 0 (V 0) x * ζ x) + ∫ x, pd2 1 (V 1) x * ζ x := integral_add (iD 0) (iD 1)
    show ∫ x, (∑ a : Fin 2, pd2 a (V a) x + Q x) * ζ x = 0
    rw [e3, e4, e5]
    have i0 := ibp 0
    have i1 := ibp 1
    linarith
  intro x hx
  have hx' := hgoal x hx
  rw [hVdef, hQdef] at hx'
  exact hx'

theorem elr_glue_local (W : Set E2) (hW : IsOpen W) (w : E2 → ℝ) (hloc : ∀ x ∈ W, ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ W ∧ ∃ v : E2 → ℝ, ContDiffOn ℝ ∞ v (Metric.ball x r) ∧ ∀ᵐ y ∂(volume.restrict (Metric.ball x r)), w y = v y) : ∃ w' : E2 → ℝ, ContDiffOn ℝ ∞ w' W ∧ ∀ᵐ x ∂(volume.restrict W), w x = w' x :=
by
  choose! r hr hrW v hv hvae using hloc
  
  have hover : ∀ x ∈ W, ∀ z ∈ W,
      Set.EqOn (v x) (v z) (Metric.ball x (r x) ∩ Metric.ball z (r z)) := by
    intro x hx z hz
    have h1 : ∀ᵐ y ∂(MeasureTheory.volume.restrict
        (Metric.ball x (r x) ∩ Metric.ball z (r z))), w y = v x y :=
      MeasureTheory.ae_restrict_of_ae_restrict_of_subset Set.inter_subset_left (hvae x hx)
    have h2 : ∀ᵐ y ∂(MeasureTheory.volume.restrict
        (Metric.ball x (r x) ∩ Metric.ball z (r z))), w y = v z y :=
      MeasureTheory.ae_restrict_of_ae_restrict_of_subset Set.inter_subset_right (hvae z hz)
    have h12 : v x =ᵐ[MeasureTheory.volume.restrict
        (Metric.ball x (r x) ∩ Metric.ball z (r z))] v z := by
      filter_upwards [h1, h2] with y hy1 hy2
      rw [← hy1, hy2]
    exact MeasureTheory.Measure.eqOn_open_of_ae_eq h12
      (Metric.isOpen_ball.inter Metric.isOpen_ball)
      ((hv x hx).continuousOn.mono Set.inter_subset_left)
      ((hv z hz).continuousOn.mono Set.inter_subset_right)
  
  have hloc' : ∀ x ∈ W, ∀ y ∈ Metric.ball x (r x), v y y = v x y := by
    intro x hx y hy
    have hyW : y ∈ W := hrW x hx hy
    have hyy : y ∈ Metric.ball y (r y) := Metric.mem_ball_self (hr y hyW)
    exact (hover x hx y hyW ⟨hy, hyy⟩).symm
  refine ⟨fun y => v y y, ?_, ?_⟩
  · refine contDiffOn_of_locally_contDiffOn (fun x hx => ?_)
    refine ⟨Metric.ball x (r x), Metric.isOpen_ball, Metric.mem_ball_self (hr x hx), ?_⟩
    exact ((hv x hx).mono Set.inter_subset_right).congr (fun y hy => hloc' x hx y hy.2)
  · have hball : ∀ x ∈ W, ∀ᵐ y ∂(MeasureTheory.volume.restrict (Metric.ball x (r x))),
        w y = v y y := by
      intro x hx
      filter_upwards [hvae x hx, MeasureTheory.ae_restrict_mem measurableSet_ball] with y h1 h2
      rw [h1, hloc' x hx y h2]
    obtain ⟨T, hT, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun i : W => Metric.ball i.1 (r i.1)) (fun i => Metric.isOpen_ball)
    have hcovW : (⋃ i : W, Metric.ball i.1 (r i.1)) = W := by
      apply Set.Subset.antisymm
      · exact Set.iUnion_subset fun i => hrW i.1 i.2
      · intro x hx
        exact Set.mem_iUnion.2 ⟨⟨x, hx⟩, Metric.mem_ball_self (hr x hx)⟩
    have hcov : (⋃ i ∈ T, Metric.ball (i : E2) (r i)) = W := hTU.trans hcovW
    rw [← hcov]
    exact (MeasureTheory.ae_restrict_biUnion_iff _ hT _).2 (fun i _ => hball i.1 i.2)

theorem elr_sob_grad_any (j : ℕ) (U : Set E2) (hU : IsOpen U) (φ : E2 → ℝ) (hφ : elrSob (j + 1) U φ) (G' : Fin 2 → E2 → ℝ) (hG'L2 : ∀ L : Set E2, IsCompact L → L ⊆ U → ∀ m, MemLp (G' m) 2 (volume.restrict L)) (hG' : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, G' m x * ζ x)) : ∀ m : Fin 2, elrSob j U (G' m) :=
by
  
  have s1 : ∀ φ₁ φ₂ : E2 → ℝ,
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ₁ 2 (volume.restrict L)) →
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ₂ 2 (volume.restrict L)) →
      (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U →
        ∫ x, φ₁ x * ζ x = ∫ x, φ₂ x * ζ x) →
      ∀ᵐ x ∂(volume.restrict U), φ₁ x = φ₂ x := by
    intro φ₁ φ₂ h₁ h₂ h
    have hloc : MeasureTheory.LocallyIntegrableOn (fun x => φ₁ x - φ₂ x) U volume := by
      rw [MeasureTheory.locallyIntegrableOn_iff hU.isLocallyClosed]
      intro k hkU hk
      haveI : IsFiniteMeasure (volume.restrict k) :=
        isFiniteMeasure_restrict.2 hk.measure_lt_top.ne
      exact ((h₁ k hk hkU).sub (h₂ k hk hkU)).integrable (by norm_num)
    have h0 := hU.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc (by
      intro g hg hgc hgU
      have hK : IsCompact (tsupport g) := hgc
      have hint : ∀ ψ : E2 → ℝ, MemLp ψ 2 (volume.restrict (tsupport g)) →
          Integrable (fun x => ψ x * g x) := by
        intro ψ hψ
        haveI : IsFiniteMeasure (volume.restrict (tsupport g)) :=
          isFiniteMeasure_restrict.2 hK.measure_lt_top.ne
        have hi1 : IntegrableOn ψ (tsupport g) volume := hψ.integrable (by norm_num)
        have hi2 := hi1.mul_continuousOn hg.continuous.continuousOn hK
        refine (integrableOn_iff_integrable_of_support_subset ?_).1 hi2
        intro x hx
        exact subset_tsupport g (fun h0 => hx (by simp [h0]))
      have i1 := hint φ₁ (h₁ _ hK hgU)
      have i2 := hint φ₂ (h₂ _ hK hgU)
      have e : (fun x => g x • (φ₁ x - φ₂ x)) = fun x => φ₁ x * g x - φ₂ x * g x := by
        funext x; simp only [smul_eq_mul]; ring
      rw [e, integral_sub i1 i2, h g hg hgc hgU, sub_self])
    rw [ae_restrict_iff' hU.measurableSet]
    filter_upwards [h0] with x hx hxU
    exact sub_eq_zero.1 (hx hxU)
  
  have s2 : ∀ (i : ℕ) (ψ ψ' : E2 → ℝ), elrSob i U ψ →
      (∀ᵐ x ∂(volume.restrict U), ψ x = ψ' x) → elrSob i U ψ' := by
    intro i ψ ψ' hψ hae
    have hL2 : (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp ψ 2 (volume.restrict L)) →
        ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp ψ' 2 (volume.restrict L) := by
      intro h L hL hLU
      exact (h L hL hLU).ae_eq (ae_restrict_of_ae_restrict_of_subset hLU hae)
    cases i with
    | zero => exact hL2 hψ
    | succ i =>
      obtain ⟨hψL2, Γ, hΓw, hΓ⟩ := hψ
      refine ⟨hL2 hψL2, Γ, ?_, hΓ⟩
      intro ζ hζ hζc hζU n
      refine (integral_congr_ae ?_).trans (hΓw ζ hζ hζc hζU n)
      have h1 := (ae_restrict_iff' hU.measurableSet).1 hae
      filter_upwards [h1] with x hx
      by_cases hxU : x ∈ U
      · rw [hx hxU]
      · have hxt : x ∉ tsupport ζ := fun h => hxU (hζU h)
        have h0 : fderiv ℝ ζ x = 0 := by
          by_contra hne
          exact hxt (support_fderiv_subset ℝ hne)
        simp [pd2, h0]
  
  intro m
  obtain ⟨_, G, hw, hG⟩ := hφ
  have hGL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp (G m) 2 (volume.restrict L) := by
    cases j with
    | zero => exact hG m
    | succ i => exact (hG m).1
  have hae := s1 (G m) (G' m) hGL2 (fun L hL hLU => hG'L2 L hL hLU m)
    (fun ζ hζ hζc hζU => neg_inj.1 ((hw ζ hζ hζc hζU m).symm.trans (hG' ζ hζ hζc hζU m)))
  exact s2 j (G m) (G' m) (hG m) hae

theorem elr_sob_mul_smooth (j : ℕ) (U : Set E2) (hU : IsOpen U) (ψ : E2 → ℝ) (hψ : ContDiffOn ℝ ∞ ψ U) (φ : E2 → ℝ) (hφ : elrSob j U φ) : elrSob j U (fun x => ψ x * φ x) :=
by
  
  have hP : ∀ K : Set E2, IsCompact K → ∀ f g : E2 → ℝ, MemLp f 2 (volume.restrict K) →
      Continuous g → tsupport g ⊆ K → Integrable (fun x => f x * g x) := by
    intro K hK f g hf hg hgK
    haveI : IsFiniteMeasure (volume.restrict K) :=
      isFiniteMeasure_restrict.2 hK.measure_lt_top.ne
    have hf1 : Integrable f (volume.restrict K) := hf.integrable (by norm_num)
    have hgc : HasCompactSupport g := hK.of_isClosed_subset (isClosed_tsupport g) hgK
    obtain ⟨C, hC⟩ := hg.bounded_above_of_compact_support hgc
    have hon : IntegrableOn (fun x => f x * g x) K := by
      refine (hf1.norm.const_mul C).mono' (hf1.aestronglyMeasurable.mul hg.aestronglyMeasurable) ?_
      refine Filter.Eventually.of_forall fun x => ?_
      rw [norm_mul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hC x) (norm_nonneg _)
    refine hon.integrable_of_forall_notMem_eq_zero ?_
    intro x hx
    simp [image_eq_zero_of_notMem_tsupport (fun h => hx (hgK h))]
  
  have hL2mul : ∀ g f : E2 → ℝ, ContinuousOn g U →
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp f 2 (volume.restrict L)) →
      ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp (fun x => g x * f x) 2 (volume.restrict L) := by
    intro g f hg hf L hL hLU
    have hgL : ContinuousOn g L := hg.mono hLU
    obtain ⟨C, hC⟩ := hL.exists_bound_of_continuousOn hgL
    have hmeas : AEStronglyMeasurable (fun x => g x * f x) (volume.restrict L) :=
      (hgL.aestronglyMeasurable hL.measurableSet).mul (hf L hL hLU).aestronglyMeasurable
    refine MemLp.of_le_mul (c := C) (hf L hL hLU) hmeas ?_
    refine ae_restrict_of_forall_mem hL.measurableSet ?_
    intro x hx
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hC x hx) (norm_nonneg _)
  
  have hcm : ∀ g : E2 → ℝ, ContinuousOn g U → ∀ ζ : E2 → ℝ, Continuous ζ → tsupport ζ ⊆ U →
      Continuous (fun x => g x * ζ x) := by
    intro g hg ζ hζ hζU
    refine continuous_iff_continuousAt.2 fun x => ?_
    by_cases hx : x ∈ U
    · exact (hg.continuousAt (hU.mem_nhds hx)).mul hζ.continuousAt
    · have hev : (fun y => g y * ζ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [notMem_tsupport_iff_eventuallyEq.1 (fun h => hx (hζU h))] with y hy
        simp [hy]
      exact continuousAt_const.congr hev.symm
  
  have htest : ∀ ψ : E2 → ℝ, ContDiffOn ℝ ∞ ψ U → ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ →
      tsupport ζ ⊆ U →
      ContDiff ℝ ∞ (fun x => ψ x * ζ x) ∧
        ∀ (m : Fin 2) (x : E2), pd2 m (fun y => ψ y * ζ y) x = pd2 m ψ x * ζ x + ψ x * pd2 m ζ x := by
    intro ψ hψ ζ hζ hζU
    have hev : ∀ x, x ∉ U → ζ =ᶠ[𝓝 x] 0 := fun x hx =>
      notMem_tsupport_iff_eventuallyEq.1 (fun h => hx (hζU h))
    have hev2 : ∀ x, x ∉ U → (fun y => ψ y * ζ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
      intro x hx
      filter_upwards [hev x hx] with y hy
      simp [hy]
    refine ⟨contDiff_iff_contDiffAt.2 fun x => ?_, fun m x => ?_⟩
    · by_cases hx : x ∈ U
      · exact (hψ.contDiffAt (hU.mem_nhds hx)).mul hζ.contDiffAt
      · exact contDiffAt_const.congr_of_eventuallyEq (hev2 x hx)
    · by_cases hx : x ∈ U
      · have h1 : DifferentiableAt ℝ ψ x :=
          (hψ.contDiffAt (hU.mem_nhds hx)).differentiableAt (by simp)
        have h2 : DifferentiableAt ℝ ζ x := hζ.contDiffAt.differentiableAt (by simp)
        simp only [pd2]
        change (fderiv ℝ (ψ * ζ) x) (e2 m) = _
        rw [fderiv_mul h1 h2]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have hζx : ζ x = 0 := (hev x hx).self_of_nhds
        have hdζ : fderiv ℝ ζ x = 0 := by
          rw [(hev x hx).fderiv_eq]
          exact fderiv_const_apply _
        simp only [pd2]
        rw [(hev2 x hx).fderiv_eq, hdζ, hζx]
        simp
  
  have hpd : ∀ ψ : E2 → ℝ, ContDiffOn ℝ ∞ ψ U → ∀ m : Fin 2, ContDiffOn ℝ ∞ (pd2 m ψ) U := by
    intro ψ hψ m
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hψ).2
    exact h1.clm_apply contDiffOn_const
  
  have hunf : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob (j + 1) U φ ↔
      ((∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L)) ∧
        ∃ Gφ : Fin 2 → E2 → ℝ, (∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
          tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, φ x * pd2 m ζ x = -(∫ x, Gφ m x * ζ x)) ∧
          ∀ m : Fin 2, elrSob j U (Gφ m)) := fun _ _ => Iff.rfl
  have hmono : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob (j + 1) U φ → elrSob j U φ := by
    intro j
    induction j with
    | zero =>
      intro φ h
      exact ((hunf 0 φ).1 h).1
    | succ j ih =>
      intro φ h
      obtain ⟨hL2, Gφ, hw, hG⟩ := (hunf (j + 1) φ).1 h
      exact (hunf j φ).2 ⟨hL2, Gφ, hw, fun m => ih (Gφ m) (hG m)⟩
  have hL2of : ∀ (j : ℕ) (φ : E2 → ℝ), elrSob j U φ →
      ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L) := by
    intro j φ h
    cases j with
    | zero => exact h
    | succ j => exact ((hunf j φ).1 h).1
  have hdζ : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → ∀ m : Fin 2,
      Continuous (pd2 m ζ) ∧ tsupport (pd2 m ζ) ⊆ tsupport ζ := by
    intro ζ hζ m
    refine ⟨(hζ.continuous_fderiv (by simp)).clm_apply continuous_const, ?_⟩
    refine closure_minimal ?_ (isClosed_tsupport ζ)
    intro x hx
    apply support_fderiv_subset ℝ
    rw [Function.mem_support]
    intro h0
    exact (Function.mem_support.mp hx) (by show fderiv ℝ ζ x (e2 m) = 0; rw [h0]; rfl)
  have hlin : ∀ (j : ℕ) (φ₁ φ₂ : E2 → ℝ) (c₁ c₂ : ℝ), elrSob j U φ₁ → elrSob j U φ₂ →
      elrSob j U (fun x => c₁ * φ₁ x + c₂ * φ₂ x) := by
    intro j
    induction j with
    | zero =>
      intro φ₁ φ₂ c₁ c₂ h₁ h₂ L hL hLU
      exact ((h₁ L hL hLU).const_mul c₁).add ((h₂ L hL hLU).const_mul c₂)
    | succ j ih =>
      intro φ₁ φ₂ c₁ c₂ h₁ h₂
      obtain ⟨hL₁, G₁, hw₁, hG₁⟩ := (hunf j φ₁).1 h₁
      obtain ⟨hL₂, G₂, hw₂, hG₂⟩ := (hunf j φ₂).1 h₂
      refine (hunf j _).2 ⟨fun L hL hLU =>
        ((hL₁ L hL hLU).const_mul c₁).add ((hL₂ L hL hLU).const_mul c₂),
        fun m x => c₁ * G₁ m x + c₂ * G₂ m x, ?_, fun m => ih _ _ _ _ (hG₁ m) (hG₂ m)⟩
      intro ζ hζ hζc hζU m
      have hK : IsCompact (tsupport ζ) := hζc
      have hζcont : Continuous ζ := hζ.continuous
      obtain ⟨hdc, hds⟩ := hdζ ζ hζ m
      have i1 := hP _ hK φ₁ (pd2 m ζ) (hL₁ _ hK hζU) hdc hds
      have i2 := hP _ hK φ₂ (pd2 m ζ) (hL₂ _ hK hζU) hdc hds
      have j1 := hP _ hK (G₁ m) ζ (hL2of j _ (hG₁ m) _ hK hζU) hζcont subset_rfl
      have j2 := hP _ hK (G₂ m) ζ (hL2of j _ (hG₂ m) _ hK hζU) hζcont subset_rfl
      have ee1 := hw₁ ζ hζ hζc hζU m
      have ee2 := hw₂ ζ hζ hζc hζU m
      calc ∫ x, (c₁ * φ₁ x + c₂ * φ₂ x) * pd2 m ζ x
          = ∫ x, (c₁ * (φ₁ x * pd2 m ζ x) + c₂ * (φ₂ x * pd2 m ζ x)) := by
            congr 1; funext x; ring
        _ = c₁ * (∫ x, φ₁ x * pd2 m ζ x) + c₂ * (∫ x, φ₂ x * pd2 m ζ x) := by
            rw [integral_add (i1.const_mul c₁) (i2.const_mul c₂), integral_const_mul,
              integral_const_mul]
        _ = -(c₁ * (∫ x, G₁ m x * ζ x) + c₂ * (∫ x, G₂ m x * ζ x)) := by
            rw [ee1, ee2]; ring
        _ = -(∫ x, (c₁ * (G₁ m x * ζ x) + c₂ * (G₂ m x * ζ x))) := by
            rw [integral_add (j1.const_mul c₁) (j2.const_mul c₂), integral_const_mul,
              integral_const_mul]
        _ = -(∫ x, (c₁ * G₁ m x + c₂ * G₂ m x) * ζ x) := by
            congr 2; funext x; ring
  
  induction j generalizing ψ φ with
  | zero =>
    exact hL2mul ψ φ hψ.continuousOn hφ
  | succ j ih =>
    obtain ⟨hL2, Gφ, hw, hG⟩ := (hunf j φ).1 hφ
    have hGL2 : ∀ m, ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp (Gφ m) 2 (volume.restrict L) :=
      fun m => hL2of j _ (hG m)
    have hψφ := hL2mul ψ φ hψ.continuousOn hL2
    refine (hunf j _).2 ⟨hψφ, fun m x => pd2 m ψ x * φ x + ψ x * Gφ m x, ?_, fun m => ?_⟩
    · intro ζ hζ hζc hζU m
      have hK : IsCompact (tsupport ζ) := hζc
      obtain ⟨hχs, hprod⟩ := htest ψ hψ ζ hζ hζU
      have hχc : HasCompactSupport (fun x => ψ x * ζ x) := hζc.mul_left
      have hχsupp : tsupport (fun x => ψ x * ζ x) ⊆ tsupport ζ := tsupport_mul_subset_right
      have hχU : tsupport (fun x => ψ x * ζ x) ⊆ U := hχsupp.trans hζU
      have hid := hw (fun x => ψ x * ζ x) hχs hχc hχU m
      beta_reduce at hid
      obtain ⟨hdc, hds⟩ := hdζ ζ hζ m
      have ia : Integrable (fun x => φ x * (pd2 m ψ x * ζ x)) :=
        hP _ hK φ (fun x => pd2 m ψ x * ζ x) (hL2 _ hK hζU)
          (hcm _ (hpd ψ hψ m).continuousOn ζ hζ.continuous hζU) tsupport_mul_subset_right
      have ib : Integrable (fun x => ψ x * φ x * pd2 m ζ x) :=
        hP _ hK (fun x => ψ x * φ x) (pd2 m ζ) (hψφ _ hK hζU) hdc hds
      have ic : Integrable (fun x => Gφ m x * (ψ x * ζ x)) :=
        hP _ hK (Gφ m) (fun x => ψ x * ζ x) (hGL2 m _ hK hζU) hχs.continuous hχsupp
      have hL : ∫ x, φ x * pd2 m (fun y => ψ y * ζ y) x =
          (∫ x, φ x * (pd2 m ψ x * ζ x)) + ∫ x, ψ x * φ x * pd2 m ζ x := by
        rw [← integral_add ia ib]
        congr 1; funext x; rw [hprod m x]; ring
      have hR : ∫ x, (pd2 m ψ x * φ x + ψ x * Gφ m x) * ζ x =
          (∫ x, φ x * (pd2 m ψ x * ζ x)) + ∫ x, Gφ m x * (ψ x * ζ x) := by
        rw [← integral_add ia ic]
        congr 1; funext x; ring
      show ∫ x, ψ x * φ x * pd2 m ζ x = -(∫ x, (pd2 m ψ x * φ x + ψ x * Gφ m x) * ζ x)
      rw [hL] at hid
      rw [hR]
      linarith
    · have h1 := ih (pd2 m ψ) (hpd ψ hψ m) φ (hmono j φ hφ)
      have h2 := ih ψ hψ (Gφ m) (hG m)
      have h3 := hlin j _ _ 1 1 h1 h2
      convert h3 using 1
      funext x
      ring

theorem elr_rhs_reduce (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (q : E2 → ℝ) (hq : ContDiffOn ℝ ∞ q U) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (F : Fin 2 → E2 → ℝ) (DF : Fin 2 → Fin 2 → E2 → ℝ) (f : E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧ (∀ m, MemLp (G m) 2 (volume.restrict L)) ∧ (∀ a, MemLp (F a) 2 (volume.restrict L)) ∧ (∀ a m, MemLp (DF a m) 2 (volume.restrict L)) ∧ MemLp f 2 (volume.restrict L)) (hgradF : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ a m : Fin 2, ∫ x, F a x * pd2 m ζ x = -(∫ x, DF a m x * ζ x)) (heq : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) = ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x)) : (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp (fun x => q x * v x + f x - ∑ a : Fin 2, DF a a x) 2 (volume.restrict L)) ∧ ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, ∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x = ∫ x, (q x * v x + f x - ∑ a : Fin 2, DF a a x) * ζ x :=
by
  
  have hpair : ∀ K : Set E2, IsCompact K → ∀ g φ : E2 → ℝ, MemLp g 2 (volume.restrict K) →
      ContinuousOn φ K → (∀ x, x ∉ K → φ x = 0) → Integrable (fun x => g x * φ x) := by
    intro K hK g φ hg hφ h0
    haveI : IsFiniteMeasure (volume.restrict K) :=
      isFiniteMeasure_restrict.mpr hK.measure_lt_top.ne
    have hg1 : Integrable g (volume.restrict K) := hg.integrable (by norm_num)
    obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hφ
    have hon : IntegrableOn (fun x => g x * φ x) K :=
      hg1.mul_bdd (hφ.aestronglyMeasurable hK.measurableSet)
        (ae_restrict_of_forall_mem hK.measurableSet hC)
    refine (integrableOn_iff_integrable_of_support_subset ?_).mp hon
    intro x hx
    by_contra hxK
    exact hx (by simp [h0 x hxK])
  
  have hbmul : ∀ L : Set E2, IsCompact L → ∀ c φ : E2 → ℝ, ContinuousOn c L →
      MemLp φ 2 (volume.restrict L) → MemLp (fun x => c x * φ x) 2 (volume.restrict L) := by
    intro L hL c φ hc hφ
    obtain ⟨C, hC⟩ := hL.exists_bound_of_continuousOn hc
    refine hφ.of_le_mul (c := C)
      ((hc.aestronglyMeasurable hL.measurableSet).mul hφ.aestronglyMeasurable)
      (ae_restrict_of_forall_mem hL.measurableSet ?_)
    intro x hx
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hC x hx) (norm_nonneg _)
  refine ⟨?_, ?_⟩
  · intro L hL hLU
    obtain ⟨hv, -, -, hDF, hf⟩ := hL2 L hL hLU
    have hqv := hbmul L hL q v (hq.continuousOn.mono hLU) hv
    have hS : MemLp (fun x => ∑ a : Fin 2, DF a a x) 2 (volume.restrict L) :=
      memLp_finset_sum _ (fun a _ => hDF a a)
    exact (hqv.add hf).sub hS
  · intro ζ hζ hζc hζU
    have hK : IsCompact (tsupport ζ) := hζc
    obtain ⟨hv, hG, hF, hDF, hf⟩ := hL2 (tsupport ζ) hK hζU
    have hζ0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
    have hdζc : ∀ a : Fin 2, Continuous (pd2 a ζ) := fun a =>
      (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdζ0 : ∀ a : Fin 2, ∀ x, x ∉ tsupport ζ → pd2 a ζ x = 0 := by
      intro a x hx
      have h1 : x ∉ Function.support (fderiv ℝ ζ) := fun h => hx (support_fderiv_subset ℝ h)
      have h2 : fderiv ℝ ζ x = 0 := by
        by_contra h; exact h1 h
      show fderiv ℝ ζ x (e2 a) = 0
      rw [h2]; rfl
    
    have hX : ∀ a b : Fin 2, Integrable (fun x => A x a b * G b x * pd2 a ζ x) := by
      intro a b
      have h := hpair (tsupport ζ) hK (G b) (fun x => A x a b * pd2 a ζ x) (hG b)
        (((hA a b).continuousOn.mono hζU).mul (hdζc a).continuousOn)
        (fun x hx => by simp [hdζ0 a x hx])
      refine h.congr (Filter.Eventually.of_forall (fun x => ?_))
      simp only; ring
    have hY : Integrable (fun x => q x * v x * ζ x) := by
      have h := hpair (tsupport ζ) hK v (fun x => q x * ζ x) hv
        ((hq.continuousOn.mono hζU).mul hζ.continuous.continuousOn)
        (fun x hx => by simp [hζ0 x hx])
      refine h.congr (Filter.Eventually.of_forall (fun x => ?_))
      simp only; ring
    have hZ : ∀ a : Fin 2, Integrable (fun x => F a x * pd2 a ζ x) := fun a =>
      hpair (tsupport ζ) hK (F a) (pd2 a ζ) (hF a) (hdζc a).continuousOn (hdζ0 a)
    have hW : Integrable (fun x => f x * ζ x) :=
      hpair (tsupport ζ) hK f ζ hf hζ.continuous.continuousOn hζ0
    have hD : ∀ a : Fin 2, Integrable (fun x => DF a a x * ζ x) := fun a =>
      hpair (tsupport ζ) hK (DF a a) ζ (hDF a a) hζ.continuous.continuousOn hζ0
    have hS : Integrable (fun x => ∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x) :=
      integrable_finset_sum _ (fun a _ => integrable_finset_sum _ (fun b _ => hX a b))
    have hZs : Integrable (fun x => ∑ a : Fin 2, F a x * pd2 a ζ x) :=
      integrable_finset_sum _ (fun a _ => hZ a)
    have hDs : Integrable (fun x => ∑ a : Fin 2, DF a a x * ζ x) :=
      integrable_finset_sum _ (fun a _ => hD a)
    
    have e0 := heq ζ hζ hζc hζU
    have h1 : ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) =
        (∫ x, ∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x) -
          ∫ x, q x * v x * ζ x := integral_sub hS hY
    have h2 : ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x) =
        (∫ x, ∑ a : Fin 2, F a x * pd2 a ζ x) + ∫ x, f x * ζ x := integral_add hZs hW
    have h3 : ∫ x, ∑ a : Fin 2, F a x * pd2 a ζ x = ∑ a : Fin 2, ∫ x, F a x * pd2 a ζ x :=
      integral_finset_sum _ (fun a _ => hZ a)
    have h4 : ∫ x, (q x * v x + f x - ∑ a : Fin 2, DF a a x) * ζ x =
        ∫ x, (q x * v x * ζ x + f x * ζ x - ∑ a : Fin 2, DF a a x * ζ x) := by
      congr 1; funext x; rw [sub_mul, Finset.sum_mul]; ring
    have h5a : ∫ x, (q x * v x * ζ x + f x * ζ x - ∑ a : Fin 2, DF a a x * ζ x) =
        (∫ x, (q x * v x * ζ x + f x * ζ x)) - ∫ x, ∑ a : Fin 2, DF a a x * ζ x :=
      integral_sub (hY.add hW) hDs
    have h5b : ∫ x, (q x * v x * ζ x + f x * ζ x) =
        (∫ x, q x * v x * ζ x) + ∫ x, f x * ζ x := integral_add hY hW
    have h5 : ∫ x, (q x * v x * ζ x + f x * ζ x - ∑ a : Fin 2, DF a a x * ζ x) =
        ((∫ x, q x * v x * ζ x) + ∫ x, f x * ζ x) - ∫ x, ∑ a : Fin 2, DF a a x * ζ x := by
      rw [h5a, h5b]
    have h6 : ∫ x, ∑ a : Fin 2, DF a a x * ζ x = ∑ a : Fin 2, ∫ x, DF a a x * ζ x :=
      integral_finset_sum _ (fun a _ => hD a)
    have g0 := hgradF ζ hζ hζc hζU 0 0
    have g1 := hgradF ζ hζ hζc hζU 1 1
    rw [Fin.sum_univ_two] at h3 h6
    rw [h4, h5, h6]
    rw [h1, h2, h3] at e0
    linarith

theorem elr_deriv_eq (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (q : E2 → ℝ) (hq : ContDiffOn ℝ ∞ q U) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (H : Fin 2 → Fin 2 → E2 → ℝ) (F : Fin 2 → E2 → ℝ) (DF : Fin 2 → Fin 2 → E2 → ℝ) (f : E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧ (∀ m, MemLp (G m) 2 (volume.restrict L)) ∧ (∀ n m, MemLp (H n m) 2 (volume.restrict L)) ∧ (∀ a, MemLp (F a) 2 (volume.restrict L)) ∧ (∀ a m, MemLp (DF a m) 2 (volume.restrict L)) ∧ MemLp f 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) (hgradG : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ n m : Fin 2, ∫ x, G n x * pd2 m ζ x = -(∫ x, H n m x * ζ x)) (hgradF : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ a m : Fin 2, ∫ x, F a x * pd2 m ζ x = -(∫ x, DF a m x * ζ x)) (heq : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x - q x * v x * ζ x) = ∫ x, (∑ a : Fin 2, F a x * pd2 a ζ x + f x * ζ x)) (m : Fin 2) : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, A x a b * H m b x * pd2 a ζ x - q x * G m x * ζ x) = ∫ x, (∑ a : Fin 2, (DF a m x - ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x - (if a = m then f x else 0)) * pd2 a ζ x + pd2 m q x * v x * ζ x) :=
by
  intro ζ hζ hζc hζU
  
  have L2P : ∀ (K : Set E2), IsCompact K → ∀ g φ : E2 → ℝ, MemLp g 2 (volume.restrict K) →
      Continuous φ → tsupport φ ⊆ K → Integrable (fun x => g x * φ x) := by
    intro K hK g φ hg hφ hs
    haveI : IsFiniteMeasure (volume.restrict K) := isFiniteMeasure_restrict.2 hK.measure_lt_top.ne
    have hg1 : IntegrableOn g K := hg.integrable (by norm_num)
    have h2 : IntegrableOn (fun x => g x * φ x) K := hg1.mul_continuousOn hφ.continuousOn hK
    refine (integrableOn_iff_integrable_of_support_subset ?_).1 h2
    exact (Function.support_mul_subset_right g φ).trans ((subset_tsupport φ).trans hs)
  
  have T1 : ∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ → HasCompactSupport χ → ∀ i : Fin 2,
      ContDiff ℝ ∞ (pd2 i χ) ∧ HasCompactSupport (pd2 i χ) ∧ tsupport (pd2 i χ) ⊆ tsupport χ := by
    intro χ hχ hχc i
    refine ⟨?_, ?_, ?_⟩
    · exact ((contDiff_infty_iff_fderiv.1 hχ).2).clm_apply contDiff_const
    · exact HasCompactSupport.fderiv_apply ℝ hχc (e2 i)
    · refine closure_minimal ?_ (isClosed_tsupport χ)
      intro x hx
      apply support_fderiv_subset ℝ
      rw [Function.mem_support]
      intro h0
      exact (Function.mem_support.mp hx) (by show fderiv ℝ χ x (e2 i) = 0; rw [h0]; rfl)
  
  have Tcomm : ∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ → ∀ i j : Fin 2,
      pd2 i (pd2 j χ) = pd2 j (pd2 i χ) := by
    intro χ hχ i j
    have hd : Differentiable ℝ (fderiv ℝ χ) :=
      ((contDiff_infty_iff_fderiv.1 hχ).2).differentiable (by simp)
    have key : ∀ k l : Fin 2, ∀ x, pd2 k (pd2 l χ) x = fderiv ℝ (fderiv ℝ χ) x (e2 k) (e2 l) := by
      intro k l x
      show fderiv ℝ (fun y => fderiv ℝ χ y (e2 l)) x (e2 k) = _
      rw [fderiv_clm_apply (hd x) (differentiableAt_const _)]
      simp
    funext x
    rw [key, key]
    exact (hχ.contDiffAt.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.2 le_top
        | norm_num)).eq _ _
  
  have T2 : ∀ φ : E2 → ℝ, ContDiffOn ℝ ∞ φ U → ∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ →
      HasCompactSupport χ → tsupport χ ⊆ U →
      ContDiff ℝ ∞ (fun x => φ x * χ x) ∧ HasCompactSupport (fun x => φ x * χ x) ∧
        tsupport (fun x => φ x * χ x) ⊆ tsupport χ := by
    intro φ hφ χ hχ hχc hχU
    refine ⟨?_, HasCompactSupport.mul_left hχc, tsupport_mul_subset_right⟩
    rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hx : x ∈ U
    · exact (hφ.contDiffAt (hU.mem_nhds hx)).mul hχ.contDiffAt
    · have hx' : x ∉ tsupport χ := fun h => hx (hχU h)
      have hev : χ =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.1 hx'
      have hev2 : (fun y => φ y * χ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
        filter_upwards [hev] with y hy
        simp [hy]
      exact contDiffAt_const.congr_of_eventuallyEq hev2
  
  have hpdU : ∀ φ : E2 → ℝ, ContDiffOn ℝ ∞ φ U → ∀ l : Fin 2, ContDiffOn ℝ ∞ (pd2 l φ) U := by
    intro φ hφ l
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hφ).2
    exact h1.clm_apply contDiffOn_const
  
  have WL : ∀ ψ : E2 → ℝ, ContDiffOn ℝ ∞ ψ U → ∀ (φ : E2 → ℝ) (Gφ : Fin 2 → E2 → ℝ),
      (∀ L : Set E2, IsCompact L → L ⊆ U → MemLp φ 2 (volume.restrict L) ∧
        ∀ l, MemLp (Gφ l) 2 (volume.restrict L)) →
      (∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ → HasCompactSupport χ → tsupport χ ⊆ U →
        ∀ l : Fin 2, ∫ x, φ x * pd2 l χ x = -(∫ x, Gφ l x * χ x)) →
      ∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ → HasCompactSupport χ → tsupport χ ⊆ U → ∀ l : Fin 2,
        ∫ x, ψ x * φ x * pd2 l χ x = -(∫ x, pd2 l ψ x * φ x * χ x) - ∫ x, ψ x * Gφ l x * χ x := by
    intro ψ hψ φ Gφ hφL hφg χ hχ hχc hχU l
    have hKχ : IsCompact (tsupport χ) := hχc
    have P' := L2P (tsupport χ) hKχ
    have hφK := (hφL (tsupport χ) hKχ hχU).1
    have tχ := T2 ψ hψ χ hχ hχc hχU
    have tdl := T1 χ hχ hχc l
    have t1 := T2 (pd2 l ψ) (hpdU ψ hψ l) χ hχ hχc hχU
    have t2 := T2 ψ hψ (pd2 l χ) tdl.1 tdl.2.1 (tdl.2.2.trans hχU)
    have i1 : Integrable (fun x => φ x * (pd2 l ψ x * χ x)) :=
      P' φ _ hφK t1.1.continuous t1.2.2
    have i2 : Integrable (fun x => φ x * (ψ x * pd2 l χ x)) :=
      P' φ _ hφK t2.1.continuous (t2.2.2.trans tdl.2.2)
    have hprod : ∀ x, pd2 l (fun y => ψ y * χ y) x = pd2 l ψ x * χ x + ψ x * pd2 l χ x := by
      intro x
      show fderiv ℝ (fun y => ψ y * χ y) x (e2 l) =
        fderiv ℝ ψ x (e2 l) * χ x + ψ x * fderiv ℝ χ x (e2 l)
      by_cases hx : x ∈ U
      · have hψd : DifferentiableAt ℝ ψ x :=
          (hψ.contDiffAt (hU.mem_nhds hx)).differentiableAt (by simp)
        have hχd : DifferentiableAt ℝ χ x := hχ.contDiffAt.differentiableAt (by simp)
        first
          | rw [fderiv_fun_mul hψd hχd]
          | rw [show (fun y => ψ y * χ y) = ψ * χ from rfl, fderiv_mul hψd hχd]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have hx' : x ∉ tsupport χ := fun h => hx (hχU h)
        have hev : χ =ᶠ[𝓝 x] fun _ => (0 : ℝ) := notMem_tsupport_iff_eventuallyEq.1 hx'
        have hev2 : (fun y => ψ y * χ y) =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
          filter_upwards [hev] with y hy
          simp [hy]
        have hχx : χ x = 0 := hev.eq_of_nhds
        rw [hev2.fderiv_eq, hev.fderiv_eq, hχx]
        simp
    have h5 : ∫ x, φ x * pd2 l (fun y => ψ y * χ y) x = -(∫ x, Gφ l x * (ψ x * χ x)) :=
      hφg _ tχ.1 tχ.2.1 (tχ.2.2.trans hχU) l
    have h4 : ∫ x, φ x * pd2 l (fun y => ψ y * χ y) x =
        (∫ x, φ x * (pd2 l ψ x * χ x)) + ∫ x, φ x * (ψ x * pd2 l χ x) := by
      rw [← integral_add i1 i2]
      congr 1
      funext x
      rw [hprod x]
      ring
    have e1 : ∫ x, ψ x * φ x * pd2 l χ x = ∫ x, φ x * (ψ x * pd2 l χ x) := by
      congr 1; funext x; ring
    have e2' : ∫ x, pd2 l ψ x * φ x * χ x = ∫ x, φ x * (pd2 l ψ x * χ x) := by
      congr 1; funext x; ring
    have e3 : ∫ x, ψ x * Gφ l x * χ x = ∫ x, Gφ l x * (ψ x * χ x) := by
      congr 1; funext x; ring
    rw [e1, e2', e3]
    linarith
  
  have HS : ∀ χ : E2 → ℝ, ContDiff ℝ ∞ χ → HasCompactSupport χ → tsupport χ ⊆ U →
      ∀ n l : Fin 2, ∫ x, H n l x * χ x = ∫ x, H l n x * χ x := by
    intro χ hχ hχc hχU n l
    have t1 := T1 χ hχ hχc l
    have t2 := T1 χ hχ hχc n
    have h1 := hgradG χ hχ hχc hχU n l
    have h2 := hgradG χ hχ hχc hχU l n
    have h3 := hgrad (pd2 l χ) t1.1 t1.2.1 (t1.2.2.trans hχU) n
    have h4 := hgrad (pd2 n χ) t2.1 t2.2.1 (t2.2.2.trans hχU) l
    rw [Tcomm χ hχ n l] at h3
    linarith
  
  have hK : IsCompact (tsupport ζ) := hζc
  have P := L2P (tsupport ζ) hK
  obtain ⟨hLv, hLG, hLH, hLF, hLDF, hLf⟩ := hL2 (tsupport ζ) hK hζU
  have hIc : ∀ (g φ h : E2 → ℝ), MemLp g 2 (volume.restrict (tsupport ζ)) → Continuous φ →
      tsupport φ ⊆ tsupport ζ → (∀ x, g x * φ x = h x) → Integrable h := by
    intro g φ h hg hφ hs he
    exact (P g φ hg hφ hs).congr (Filter.Eventually.of_forall he)
  
  have tz : ∀ a : Fin 2, ContDiff ℝ ∞ (pd2 a ζ) ∧ HasCompactSupport (pd2 a ζ) ∧
      tsupport (pd2 a ζ) ⊆ tsupport ζ := T1 ζ hζ hζc
  have tψ := tz m
  have tψa : ∀ a : Fin 2, ContDiff ℝ ∞ (pd2 a (pd2 m ζ)) ∧ HasCompactSupport (pd2 a (pd2 m ζ)) ∧
      tsupport (pd2 a (pd2 m ζ)) ⊆ tsupport ζ := by
    intro a
    have h := T1 (pd2 m ζ) tψ.1 tψ.2.1 a
    exact ⟨h.1, h.2.1, h.2.2.trans tψ.2.2⟩
  have hcomm : ∀ a : Fin 2, pd2 a (pd2 m ζ) = pd2 m (pd2 a ζ) := fun a => Tcomm ζ hζ a m
  have hzU : ∀ a : Fin 2, tsupport (pd2 a ζ) ⊆ U := fun a => (tz a).2.2.trans hζU
  
  have termA : ∀ a b : Fin 2, ∫ x, A x a b * G b x * pd2 a (pd2 m ζ) x =
      -(∫ x, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) -
        ∫ x, A x a b * H m b x * pd2 a ζ x := by
    intro a b
    have h : ∫ x, A x a b * G b x * pd2 m (pd2 a ζ) x =
        -(∫ x, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) -
          ∫ x, A x a b * H b m x * pd2 a ζ x :=
      WL (fun y => A y a b) (hA a b) (G b) (H b)
        (fun L hL hLU => ⟨(hL2 L hL hLU).2.1 b, fun l => (hL2 L hL hLU).2.2.1 b l⟩)
        (fun χ h1 h2 h3 l => hgradG χ h1 h2 h3 b l) (pd2 a ζ) (tz a).1 (tz a).2.1 (hzU a) m
    have tA := T2 (fun y => A y a b) (hA a b) (pd2 a ζ) (tz a).1 (tz a).2.1 (hzU a)
    have hs : ∫ x, H b m x * (A x a b * pd2 a ζ x) = ∫ x, H m b x * (A x a b * pd2 a ζ x) :=
      HS (fun x => A x a b * pd2 a ζ x) tA.1 tA.2.1 (tA.2.2.trans (hzU a)) b m
    have e1 : ∫ x, A x a b * H b m x * pd2 a ζ x = ∫ x, H b m x * (A x a b * pd2 a ζ x) := by
      congr 1; funext x; ring
    have e2 : ∫ x, A x a b * H m b x * pd2 a ζ x = ∫ x, H m b x * (A x a b * pd2 a ζ x) := by
      congr 1; funext x; ring
    rw [hcomm a, h, e1, e2, hs]
  have termQ : ∫ x, q x * v x * pd2 m ζ x =
      -(∫ x, pd2 m q x * v x * ζ x) - ∫ x, q x * G m x * ζ x :=
    WL q hq v G (fun L hL hLU => ⟨(hL2 L hL hLU).1, (hL2 L hL hLU).2.1⟩) hgrad ζ hζ hζc hζU m
  have termF : ∀ a : Fin 2, ∫ x, F a x * pd2 a (pd2 m ζ) x = -(∫ x, DF a m x * pd2 a ζ x) := by
    intro a
    rw [hcomm a]
    exact hgradF (pd2 a ζ) (tz a).1 (tz a).2.1 (hzU a) a m
  have hI : ∀ a : Fin 2, (∫ x, (if a = m then f x else 0) * pd2 a ζ x) =
      if a = m then ∫ x, f x * pd2 m ζ x else 0 := by
    intro a
    by_cases h : a = m <;> simp [h]
  have hIsum : ∑ a : Fin 2, (∫ x, (if a = m then f x else 0) * pd2 a ζ x) =
      ∫ x, f x * pd2 m ζ x := by
    rw [Finset.sum_congr rfl (fun a _ => hI a)]
    simp
  
  have S2 : ∀ (g : Fin 2 → Fin 2 → E2 → ℝ) (h : E2 → ℝ), (∀ a b, Integrable (g a b)) →
      Integrable h →
      ∫ x, (∑ a : Fin 2, ∑ b : Fin 2, g a b x - h x) =
        ∑ a : Fin 2, ∑ b : Fin 2, (∫ x, g a b x) - ∫ x, h x := by
    intro g h hg hh
    have hg' : ∀ a, Integrable (fun x => ∑ b : Fin 2, g a b x) :=
      fun a => integrable_finset_sum _ (fun b _ => hg a b)
    rw [integral_sub (integrable_finset_sum _ (fun a _ => hg' a)) hh,
      integral_finset_sum _ (fun a _ => hg' a)]
    congr 1
    refine Finset.sum_congr rfl (fun a _ => ?_)
    exact integral_finset_sum _ (fun b _ => hg a b)
  have S1 : ∀ (g : Fin 2 → E2 → ℝ) (h : E2 → ℝ), (∀ a, Integrable (g a)) → Integrable h →
      ∫ x, (∑ a : Fin 2, g a x + h x) = ∑ a : Fin 2, (∫ x, g a x) + ∫ x, h x := by
    intro g h hg hh
    rw [integral_add (integrable_finset_sum _ (fun a _ => hg a)) hh,
      integral_finset_sum _ (fun a _ => hg a)]
  
  have iEA : ∀ a b : Fin 2, Integrable (fun x => A x a b * G b x * pd2 a (pd2 m ζ) x) := by
    intro a b
    have t := T2 (fun y => A y a b) (hA a b) (pd2 a (pd2 m ζ)) (tψa a).1 (tψa a).2.1
      ((tψa a).2.2.trans hζU)
    exact hIc (G b) (fun x => A x a b * pd2 a (pd2 m ζ) x) _ (hLG b) t.1.continuous
      (t.2.2.trans (tψa a).2.2) (fun x => by beta_reduce; ring)
  have iEq : Integrable (fun x => q x * v x * pd2 m ζ x) := by
    have t := T2 q hq (pd2 m ζ) tψ.1 tψ.2.1 (tψ.2.2.trans hζU)
    exact hIc v (fun x => q x * pd2 m ζ x) _ hLv t.1.continuous (t.2.2.trans tψ.2.2)
      (fun x => by beta_reduce; ring)
  have iEF : ∀ a : Fin 2, Integrable (fun x => F a x * pd2 a (pd2 m ζ) x) := fun a =>
    P _ _ (hLF a) (tψa a).1.continuous (tψa a).2.2
  have iEf : Integrable (fun x => f x * pd2 m ζ x) := P _ _ hLf tψ.1.continuous tψ.2.2
  have iTA : ∀ a b : Fin 2, Integrable (fun x => A x a b * H m b x * pd2 a ζ x) := by
    intro a b
    have t := T2 (fun y => A y a b) (hA a b) (pd2 a ζ) (tz a).1 (tz a).2.1 (hzU a)
    exact hIc (H m b) (fun x => A x a b * pd2 a ζ x) _ (hLH m b) t.1.continuous
      (t.2.2.trans (tz a).2.2) (fun x => by beta_reduce; ring)
  have iTq : Integrable (fun x => q x * G m x * ζ x) := by
    have t := T2 q hq ζ hζ hζc hζU
    exact hIc (G m) (fun x => q x * ζ x) _ (hLG m) t.1.continuous t.2.2
      (fun x => by beta_reduce; ring)
  have iTq2 : Integrable (fun x => pd2 m q x * v x * ζ x) := by
    have t := T2 (pd2 m q) (hpdU q hq m) ζ hζ hζc hζU
    exact hIc v (fun x => pd2 m q x * ζ x) _ hLv t.1.continuous t.2.2
      (fun x => by beta_reduce; ring)
  have splitR : ∀ a : Fin 2,
      Integrable (fun x => (DF a m x - ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x -
        (if a = m then f x else 0)) * pd2 a ζ x) ∧
      ∫ x, (DF a m x - ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x -
        (if a = m then f x else 0)) * pd2 a ζ x =
        (∫ x, DF a m x * pd2 a ζ x) -
          ∑ b : Fin 2, (∫ x, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) -
          ∫ x, (if a = m then f x else 0) * pd2 a ζ x := by
    intro a
    have hite : MemLp (fun x => if a = m then f x else 0) 2 (volume.restrict (tsupport ζ)) := by
      by_cases h : a = m
      · simp only [if_pos h]; exact hLf
      · simp only [if_neg h]; exact MemLp.zero
    have i1 : Integrable (fun x => DF a m x * pd2 a ζ x) :=
      P _ _ (hLDF a m) (tz a).1.continuous (tz a).2.2
    have i2 : ∀ b : Fin 2, Integrable (fun x => pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) := by
      intro b
      have t := T2 (pd2 m (fun y => A y a b)) (hpdU _ (hA a b) m) (pd2 a ζ) (tz a).1 (tz a).2.1
        (hzU a)
      exact hIc (G b) (fun x => pd2 m (fun y => A y a b) x * pd2 a ζ x) _ (hLG b) t.1.continuous
        (t.2.2.trans (tz a).2.2) (fun x => by beta_reduce; ring)
    have i3 : Integrable (fun x => (if a = m then f x else 0) * pd2 a ζ x) :=
      P _ _ hite (tz a).1.continuous (tz a).2.2
    have i2s : Integrable (fun x => ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) :=
      integrable_finset_sum _ (fun b _ => i2 b)
    have heqf : (fun x => (DF a m x - ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x -
        (if a = m then f x else 0)) * pd2 a ζ x) =
        fun x => DF a m x * pd2 a ζ x -
          ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x -
          (if a = m then f x else 0) * pd2 a ζ x := by
      funext x
      rw [sub_mul, sub_mul, Finset.sum_mul]
    rw [heqf]
    have i12 : Integrable (fun x => DF a m x * pd2 a ζ x -
        ∑ b : Fin 2, pd2 m (fun y => A y a b) x * G b x * pd2 a ζ x) := i1.sub i2s
    refine ⟨i12.sub i3, ?_⟩
    rw [integral_sub i12 i3, integral_sub i1 i2s,
      integral_finset_sum _ (fun b _ => i2 b)]
  
  have E := heq (pd2 m ζ) tψ.1 tψ.2.1 (tψ.2.2.trans hζU)
  rw [S2 _ _ iEA iEq, S1 _ _ iEF iEf] at E
  rw [S2 _ _ iTA iTq, S1 _ _ (fun a => (splitR a).1) iTq2]
  have r0 := (splitR 0).2
  have r1 := (splitR 1).2
  have a00 := termA 0 0
  have a01 := termA 0 1
  have a10 := termA 1 0
  have a11 := termA 1 1
  have f0 := termF 0
  have f1 := termF 1
  simp only [Fin.sum_univ_two] at E hIsum r0 r1 ⊢
  linarith

theorem elr_moll_kernel : ∃ Cη : ℝ, 0 ≤ Cη ∧ ∀ δ : ℝ, 0 < δ → ∃ η : E2 → ℝ, ContDiff ℝ ∞ η ∧ HasCompactSupport η ∧ (∀ z, 0 ≤ η z) ∧ (∀ z, δ ≤ ‖z‖ → η z = 0) ∧ (∫ z, η z) = 1 ∧ ∀ m : Fin 2, (∫ z, ‖z‖ * |pd2 m η z|) ≤ Cη :=
by
  let β : ContDiffBump (0 : E2) := ⟨1 / 2, 1, by norm_num, by norm_num⟩
  set η₁ : E2 → ℝ := β.normed MeasureTheory.volume with hη₁def
  have hη₁s : ContDiff ℝ ∞ η₁ := β.contDiff_normed
  have hη₁d : Differentiable ℝ η₁ := hη₁s.differentiable (by simp)
  have hη₁0 : ∀ x, 0 ≤ η₁ x := fun x => β.nonneg_normed x
  have hη₁int : ∫ x, η₁ x = 1 := β.integral_normed
  have hη₁supp : Function.support η₁ = Metric.ball 0 1 := β.support_normed_eq
  
  have hpd : ∀ (c s : ℝ) (m : Fin 2) (z : E2),
      pd2 m (fun y => c * η₁ (s • y)) z = c * (s * pd2 m η₁ (s • z)) := by
    intro c s m z
    have hψ : DifferentiableAt ℝ (fun y : E2 => η₁ (s • y)) z :=
      (hη₁d (s • z)).comp z ((differentiableAt_id).const_smul s)
    unfold pd2
    rw [fderiv_const_mul hψ c, fderiv_comp_smul]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have hint : ∀ (f : E2 → ℝ) (δ : ℝ), 0 < δ →
      (∫ z, (δ ^ 2)⁻¹ * f (δ⁻¹ • z)) = ∫ z, f z := by
    intro f δ hδ
    rw [MeasureTheory.integral_const_mul,
      MeasureTheory.Measure.integral_comp_inv_smul_of_nonneg MeasureTheory.volume f hδ.le,
      finrank_euclideanSpace_fin, smul_eq_mul]
    field_simp
  have hI : ∀ m : Fin 2, 0 ≤ ∫ w, ‖w‖ * |pd2 m η₁ w| := fun m =>
    MeasureTheory.integral_nonneg (fun w => mul_nonneg (norm_nonneg _) (abs_nonneg _))
  refine ⟨(∫ w, ‖w‖ * |pd2 0 η₁ w|) + (∫ w, ‖w‖ * |pd2 1 η₁ w|),
    add_nonneg (hI 0) (hI 1), ?_⟩
  intro δ hδ
  have hδi : 0 < δ⁻¹ := inv_pos.2 hδ
  have hδ2 : 0 < δ ^ 2 := pow_pos hδ 2
  have hnorm : ∀ z : E2, ‖δ⁻¹ • z‖ = δ⁻¹ * ‖z‖ := by
    intro z
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hδi]
  have hvan : ∀ z : E2, δ ≤ ‖z‖ → (δ ^ 2)⁻¹ * η₁ (δ⁻¹ • z) = 0 := by
    intro z hz
    have h1 : 1 ≤ ‖δ⁻¹ • z‖ := by
      rw [hnorm]
      calc (1 : ℝ) = δ⁻¹ * δ := (inv_mul_cancel₀ hδ.ne').symm
        _ ≤ δ⁻¹ * ‖z‖ := mul_le_mul_of_nonneg_left hz hδi.le
    have h2 : δ⁻¹ • z ∉ Function.support η₁ := by
      rw [hη₁supp, mem_ball_zero_iff]
      exact not_lt.2 h1
    rw [Function.notMem_support.mp h2, mul_zero]
  refine ⟨fun z => (δ ^ 2)⁻¹ * η₁ (δ⁻¹ • z), ?_, ?_, ?_, hvan, ?_, ?_⟩
  · exact contDiff_const.mul (hη₁s.comp (contDiff_const_smul δ⁻¹))
  · refine HasCompactSupport.intro (isCompact_closedBall (0 : E2) δ) ?_
    intro z hz
    rw [mem_closedBall_zero_iff, not_le] at hz
    exact hvan z hz.le
  · intro z
    exact mul_nonneg (inv_nonneg.2 hδ2.le) (hη₁0 _)
  · rw [hint η₁ δ hδ, hη₁int]
  · intro m
    have hpt : ∀ z : E2, ‖z‖ * |pd2 m (fun y => (δ ^ 2)⁻¹ * η₁ (δ⁻¹ • y)) z| =
        (δ ^ 2)⁻¹ * (‖δ⁻¹ • z‖ * |pd2 m η₁ (δ⁻¹ • z)|) := by
      intro z
      rw [hpd, hnorm, abs_mul, abs_mul, abs_of_pos (inv_pos.2 hδ2), abs_of_pos hδi]
      have : ‖z‖ = δ * (δ⁻¹ * ‖z‖) := by field_simp
      calc ‖z‖ * ((δ ^ 2)⁻¹ * (δ⁻¹ * |pd2 m η₁ (δ⁻¹ • z)|))
          = (δ * (δ⁻¹ * ‖z‖)) * ((δ ^ 2)⁻¹ * (δ⁻¹ * |pd2 m η₁ (δ⁻¹ • z)|)) := by
            rw [← this]
        _ = (δ * δ⁻¹) * ((δ ^ 2)⁻¹ * (δ⁻¹ * ‖z‖ * |pd2 m η₁ (δ⁻¹ • z)|)) := by ring
        _ = (δ ^ 2)⁻¹ * (δ⁻¹ * ‖z‖ * |pd2 m η₁ (δ⁻¹ • z)|) := by
            rw [mul_inv_cancel₀ hδ.ne', one_mul]
    have heq : (∫ z, ‖z‖ * |pd2 m (fun y => (δ ^ 2)⁻¹ * η₁ (δ⁻¹ • y)) z|) =
        ∫ w, ‖w‖ * |pd2 m η₁ w| := by
      simp_rw [hpt]
      exact hint (fun w => ‖w‖ * |pd2 m η₁ w|) δ hδ
    rw [heq]
    fin_cases m
    · exact le_add_of_nonneg_right (hI 1)
    · exact le_add_of_nonneg_left (hI 0)

theorem elr_ellip_consts (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (hApos : ∀ x ∈ U, (A x).PosDef) (K : Set E2) (hK : IsCompact K) (hKc : Convex ℝ K) (hKU : K ⊆ U) : ∃ θ Λ Λ' : ℝ, 0 < θ ∧ 0 ≤ Λ ∧ 0 ≤ Λ' ∧ (∀ x ∈ K, ∀ ξ : Fin 2 → ℝ, θ * ∑ a : Fin 2, ξ a ^ 2 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A x a b * ξ a * ξ b) ∧ (∀ x ∈ K, ∀ a b : Fin 2, |A x a b| ≤ Λ) ∧ (∀ x ∈ K, ∀ a b c : Fin 2, |pd2 c (fun y => A y a b) x| ≤ Λ') ∧ ∀ x ∈ K, ∀ y ∈ K, ∀ a b : Fin 2, |A y a b - A x a b| ≤ Λ' * ‖y - x‖ :=
by
  classical
  
  have hdiff : ∀ a b : Fin 2, DifferentiableOn ℝ (fun x => A x a b) U := fun a b =>
    ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 (hA a b)).1
  have hDcont : ∀ a b : Fin 2, ContinuousOn (fderiv ℝ (fun x => A x a b)) U := fun a b =>
    ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 (hA a b)).2.continuousOn
  have hcont : ∀ a b : Fin 2, ContinuousOn (fun x => A x a b) U := fun a b =>
    (hA a b).continuousOn
  
  have hsym : ∀ x ∈ U, A x 1 0 = A x 0 1 := by
    intro x hx
    have h := (hApos x hx).isHermitian.apply 1 0
    rw [star_trivial] at h
    exact h.symm
  have hdet : ∀ x ∈ U, 0 < A x 0 0 * A x 1 1 - A x 0 1 * A x 1 0 := by
    intro x hx
    have h := (hApos x hx).det_pos
    rwa [Matrix.det_fin_two] at h
  have htr : ∀ x ∈ U, 0 < A x 0 0 + A x 1 1 := by
    intro x hx
    have h := (hApos x hx).trace_pos
    rwa [Matrix.trace_fin_two] at h
  have hkey : ∀ x ∈ U, ∀ ξ : Fin 2 → ℝ,
      (A x 0 0 * A x 1 1 - A x 0 1 * A x 1 0) * ∑ a : Fin 2, ξ a ^ 2 ≤
        (A x 0 0 + A x 1 1) * ∑ a : Fin 2, ∑ b : Fin 2, A x a b * ξ a * ξ b := by
    intro x hx ξ
    have hs := hsym x hx
    simp only [Fin.sum_univ_two]
    rw [hs]
    nlinarith [sq_nonneg (A x 0 0 * ξ 0 + A x 0 1 * ξ 1),
      sq_nonneg (A x 0 1 * ξ 0 + A x 1 1 * ξ 1)]
  
  have hmcont : ContinuousOn (fun x => (A x 0 0 * A x 1 1 - A x 0 1 * A x 1 0) /
      (A x 0 0 + A x 1 1)) U := by
    apply ContinuousOn.div
    · exact ((hcont 0 0).mul (hcont 1 1)).sub ((hcont 0 1).mul (hcont 1 0))
    · exact (hcont 0 0).add (hcont 1 1)
    · intro x hx
      exact (htr x hx).ne'
  
  obtain ⟨θ, hθ, hθm⟩ := hK.exists_forall_le' (hmcont.mono hKU) (a := 0)
    (fun x hx => div_pos (hdet x (hKU hx)) (htr x (hKU hx)))
  have hell : ∀ x ∈ K, ∀ ξ : Fin 2 → ℝ,
      θ * ∑ a : Fin 2, ξ a ^ 2 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A x a b * ξ a * ξ b := by
    intro x hx ξ
    have hxU := hKU hx
    have h1 : θ ≤ (A x 0 0 * A x 1 1 - A x 0 1 * A x 1 0) / (A x 0 0 + A x 1 1) := hθm x hx
    have ht := htr x hxU
    have hk := hkey x hxU ξ
    have hS : 0 ≤ ∑ a : Fin 2, ξ a ^ 2 := Finset.sum_nonneg (fun a _ => sq_nonneg _)
    rw [le_div_iff₀ ht] at h1
    have h2 := mul_le_mul_of_nonneg_right h1 hS
    have h3 : (A x 0 0 + A x 1 1) * (θ * ∑ a : Fin 2, ξ a ^ 2) ≤
        (A x 0 0 + A x 1 1) * ∑ a : Fin 2, ∑ b : Fin 2, A x a b * ξ a * ξ b := by
      nlinarith
    exact le_of_mul_le_mul_left h3 ht
  
  have hle : ∀ (F : Fin 2 → Fin 2 → ℝ) (a b : Fin 2),
      F a b ≤ ∑ a : Fin 2, ∑ b : Fin 2, |F a b| := by
    intro F a b
    exact (le_abs_self _).trans
      ((Finset.single_le_sum (f := fun b => |F a b|) (fun b _ => abs_nonneg _)
        (Finset.mem_univ b)).trans
      (Finset.single_le_sum (f := fun a => ∑ b : Fin 2, |F a b|)
        (fun a _ => Finset.sum_nonneg (fun b _ => abs_nonneg _)) (Finset.mem_univ a)))
  have hnn : ∀ (F : Fin 2 → Fin 2 → ℝ), 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, |F a b| := fun F =>
    Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun b _ => abs_nonneg _))
  choose C hC using fun a b => hK.exists_bound_of_continuousOn ((hcont a b).mono hKU)
  choose D hD using fun a b => hK.exists_bound_of_continuousOn ((hDcont a b).mono hKU)
  have hDB : ∀ x ∈ K, ∀ a b : Fin 2,
      ‖fderiv ℝ (fun y => A y a b) x‖ ≤ ∑ a : Fin 2, ∑ b : Fin 2, |D a b| :=
    fun x hx a b => (hD a b x hx).trans (hle D a b)
  refine ⟨θ, ∑ a : Fin 2, ∑ b : Fin 2, |C a b|, ∑ a : Fin 2, ∑ b : Fin 2, |D a b|, hθ,
    hnn C, hnn D, hell, ?_, ?_, ?_⟩
  · intro x hx a b
    have h := hC a b x hx
    rw [Real.norm_eq_abs] at h
    exact h.trans (hle C a b)
  · intro x hx a b c
    have h1 : ‖fderiv ℝ (fun y => A y a b) x (e2 c)‖ ≤
        ‖fderiv ℝ (fun y => A y a b) x‖ * ‖e2 c‖ := ContinuousLinearMap.le_opNorm _ _
    have h2 : ‖e2 c‖ = 1 := by simp [e2, EuclideanSpace.norm_single]
    rw [h2, mul_one, Real.norm_eq_abs] at h1
    exact h1.trans (hDB x hx a b)
  · intro x hx y hy a b
    have h := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (f := fun z => A z a b)
      (fun z hz => (hdiff a b).differentiableAt (hU.mem_nhds (hKU hz)))
      (fun z hz => hDB z hz a b) hKc hx hy
    rw [Real.norm_eq_abs] at h
    exact h

theorem elr_moll_deriv (η φ : E2 → ℝ) (hη : ContDiff ℝ ∞ η) (hηc : HasCompactSupport η) (hφ : Integrable φ) : ContDiff ℝ ∞ (fun x => ∫ y, η (x - y) * φ y) ∧ ∀ (m : Fin 2) (x : E2), pd2 m (fun x => ∫ y, η (x - y) * φ y) x = ∫ y, pd2 m η (x - y) * φ y :=
by
  have hloc : LocallyIntegrable φ volume := hφ.locallyIntegrable
  have hsw : ∀ (k : E2 → ℝ) (x : E2), ∫ y, k (x - y) * φ y = ∫ t, k t * φ (x - t) := by
    intro k x
    have h := MeasureTheory.integral_sub_left_eq_self
      (fun t => k t * φ (x - t)) volume x
    simp only [sub_sub_cancel] at h
    exact h
  have hconv : (fun x => ∫ y, η (x - y) * φ y) =
      MeasureTheory.convolution η φ (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext x
    rw [hsw η x, MeasureTheory.convolution_def]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
  refine ⟨?_, ?_⟩
  · rw [hconv]
    exact hηc.contDiff_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ) hη hloc
  · intro m x
    have hD := hηc.hasFDerivAt_convolution_left (ContinuousLinearMap.lsmul ℝ ℝ)
      (hη.of_le (by simp)) hloc x
    have hE := HasCompactSupport.convolutionExists_left
      (ContinuousLinearMap.precompL E2 (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ))
      (hηc.fderiv ℝ) (hη.continuous_fderiv (by simp)) hloc
    have hI := hE x
    unfold MeasureTheory.ConvolutionExistsAt at hI
    have hpd : pd2 m (fun x => ∫ y, η (x - y) * φ y) x =
        ∫ t, pd2 m η t * φ (x - t) := by
      unfold pd2
      rw [hconv, hD.fderiv, MeasureTheory.convolution_def,
        ContinuousLinearMap.integral_apply hI]
      simp only [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    rw [hpd, hsw (pd2 m η) x]

theorem elr_young_L2 (k φ : E2 → ℝ) (hk : Continuous k) (hkc : HasCompactSupport k) (hk0 : ∀ z, 0 ≤ k z) (C : ℝ) (hC : (∫ z, k z) ≤ C) (hφ : MemLp φ 2 volume) (S : Set E2) : (∫ x in S, (∫ y, k (x - y) * |φ y|) ^ 2) ≤ C ^ 2 * (∫ y, φ y ^ 2) ∧ (∫ x in S, (∫ y, k (x - y) * φ y) ^ 2) ≤ C ^ 2 * (∫ y, φ y ^ 2) :=
by
  
  have wcs : ∀ (w ψ : E2 → ℝ), (∀ y, 0 ≤ w y) → Integrable w →
      Integrable (fun y => w y * ψ y) → Integrable (fun y => w y * ψ y ^ 2) →
      (∫ y, w y * ψ y) ^ 2 ≤ (∫ y, w y) * (∫ y, w y * ψ y ^ 2) := by
    intro w ψ hw0 hw hwψ hwψ2
    have key : ∀ c : ℝ, 0 ≤ (∫ y, w y) * (c * c) + (-2 * (∫ y, w y * ψ y)) * c +
        (∫ y, w y * ψ y ^ 2) := by
      intro c
      have h1 : (fun y => w y * (ψ y - c) ^ 2) =
          fun y => (w y * ψ y ^ 2 - (2 * c) * (w y * ψ y)) + (c * c) * w y := by
        funext y; ring
      have h2 : 0 ≤ ∫ y, w y * (ψ y - c) ^ 2 :=
        integral_nonneg (fun y => mul_nonneg (hw0 y) (sq_nonneg _))
      have hA : Integrable (fun y => w y * ψ y ^ 2 - 2 * c * (w y * ψ y)) :=
        hwψ2.sub (hwψ.const_mul (2 * c))
      have e1 : ∫ y, (w y * ψ y ^ 2 - 2 * c * (w y * ψ y) + c * c * w y) =
          (∫ y, (w y * ψ y ^ 2 - 2 * c * (w y * ψ y))) + ∫ y, c * c * w y :=
        integral_add hA (hw.const_mul (c * c))
      have e2 : ∫ y, (w y * ψ y ^ 2 - 2 * c * (w y * ψ y)) =
          (∫ y, w y * ψ y ^ 2) - ∫ y, 2 * c * (w y * ψ y) :=
        integral_sub hwψ2 (hwψ.const_mul (2 * c))
      have e3 : ∫ y, 2 * c * (w y * ψ y) = 2 * c * ∫ y, w y * ψ y := integral_const_mul _ _
      have e4 : ∫ y, c * c * w y = c * c * ∫ y, w y := integral_const_mul _ _
      rw [h1, e1, e2, e3, e4] at h2
      nlinarith [h2]
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith [hd]
  have hkI : Integrable k := hk.integrable_of_hasCompactSupport hkc
  obtain ⟨B, hB⟩ := hk.bounded_above_of_compact_support hkc
  have hφ2 : Integrable (fun y => φ y ^ 2) := hφ.integrable_sq
  have slice : ∀ x : E2, Integrable (fun y => k (x - y)) ∧ Integrable (fun y => k (x - y) * φ y) ∧
      Integrable (fun y => k (x - y) * |φ y|) ∧ Integrable (fun y => k (x - y) * φ y ^ 2) ∧
      (∫ y, k (x - y)) = ∫ z, k z := by
    intro x
    have ha : Integrable (fun y => k (x - y)) := hkI.comp_sub_left x
    have hm : AEStronglyMeasurable (fun y => k (x - y)) volume :=
      (hk.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    have hd : Integrable (fun y => k (x - y) * φ y ^ 2) :=
      hφ2.bdd_mul hm (ae_of_all _ (fun y => hB (x - y)))
    have hdom : Integrable (fun y => (k (x - y) + k (x - y) * φ y ^ 2) / 2) :=
      (ha.add hd).div_const 2
    have hb : Integrable (fun y => k (x - y) * φ y) := by
      refine hdom.mono' (hm.mul hφ.1) (ae_of_all _ (fun y => ?_))
      show ‖k (x - y) * φ y‖ ≤ (k (x - y) + k (x - y) * φ y ^ 2) / 2
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hk0 _), ← sq_abs (φ y)]
      nlinarith [mul_nonneg (hk0 (x - y)) (sq_nonneg (|φ y| - 1))]
    have hc : Integrable (fun y => k (x - y) * |φ y|) := by
      refine hb.abs.congr (ae_of_all _ (fun y => ?_))
      simp only [abs_mul, abs_of_nonneg (hk0 (x - y))]
    exact ⟨ha, hb, hc, hd, integral_sub_left_eq_self k volume x⟩
  
  have hQeq : (fun x => ∫ y, k (x - y) * φ y ^ 2) =
      MeasureTheory.convolution (fun y => φ y ^ 2) k (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
    funext x
    rw [MeasureTheory.convolution_def]
    congr 1
    funext t
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    ring
  have hQi : Integrable (fun x => ∫ y, k (x - y) * φ y ^ 2) := by
    rw [hQeq]
    exact hφ2.integrable_convolution _ hkI
  have hQint : (∫ x, ∫ y, k (x - y) * φ y ^ 2) = (∫ z, k z) * (∫ y, φ y ^ 2) := by
    rw [hQeq, MeasureTheory.integral_convolution _ hφ2 hkI]
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    ring
  have hs0 : 0 ≤ ∫ z, k z := integral_nonneg hk0
  have hI0 : 0 ≤ ∫ y, φ y ^ 2 := integral_nonneg (fun y => sq_nonneg _)
  have hQ0 : ∀ x, 0 ≤ ∫ y, k (x - y) * φ y ^ 2 :=
    fun x => integral_nonneg (fun y => mul_nonneg (hk0 _) (sq_nonneg _))
  have hsC : (∫ z, k z) ^ 2 ≤ C ^ 2 := pow_le_pow_left₀ hs0 hC 2
  have hfin : (∫ z, k z) * ((∫ z, k z) * (∫ y, φ y ^ 2)) ≤ C ^ 2 * (∫ y, φ y ^ 2) := by
    nlinarith
  have main : ∀ F : E2 → ℝ, (∀ x, F x ^ 2 ≤ (∫ z, k z) * ∫ y, k (x - y) * φ y ^ 2) →
      (∫ x in S, F x ^ 2) ≤ C ^ 2 * (∫ y, φ y ^ 2) := by
    intro F hF
    calc (∫ x in S, F x ^ 2) ≤ ∫ x in S, (∫ z, k z) * ∫ y, k (x - y) * φ y ^ 2 :=
          integral_mono_of_nonneg (ae_of_all _ (fun x => sq_nonneg _))
            (hQi.const_mul (∫ z, k z)).restrict (ae_of_all _ hF)
      _ ≤ ∫ x, (∫ z, k z) * ∫ y, k (x - y) * φ y ^ 2 :=
          setIntegral_le_integral (hQi.const_mul (∫ z, k z))
            (ae_of_all _ (fun x => mul_nonneg hs0 (hQ0 x)))
      _ = (∫ z, k z) * ((∫ z, k z) * (∫ y, φ y ^ 2)) := by rw [integral_const_mul, hQint]
      _ ≤ C ^ 2 * (∫ y, φ y ^ 2) := hfin
  refine ⟨main _ (fun x => ?_), main _ (fun x => ?_)⟩
  · obtain ⟨ha, hb, hc, hd, he⟩ := slice x
    have h := wcs (fun y => k (x - y)) (fun y => |φ y|) (fun y => hk0 _) ha hc
      (by simpa only [sq_abs] using hd)
    simp only [sq_abs] at h
    rw [he] at h
    exact h
  · obtain ⟨ha, hb, hc, hd, he⟩ := slice x
    have h := wcs (fun y => k (x - y)) φ (fun y => hk0 _) ha hb hd
    beta_reduce at h
    rw [he] at h
    exact h

theorem elr_mollified_system (U : Set E2) (hU : IsOpen U) (A : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hA : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => A x a b) U) (v : E2 → ℝ) (G : Fin 2 → E2 → ℝ) (g : E2 → ℝ) (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ U → MemLp v 2 (volume.restrict L) ∧ (∀ m, MemLp (G m) 2 (volume.restrict L)) ∧ MemLp g 2 (volume.restrict L)) (hgrad : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∀ m : Fin 2, ∫ x, v x * pd2 m ζ x = -(∫ x, G m x * ζ x)) (heq : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ U → ∫ x, ∑ a : Fin 2, ∑ b : Fin 2, A x a b * G b x * pd2 a ζ x = ∫ x, g x * ζ x) (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ) (hKU : Metric.closedBall x₀ (4 * ρ) ⊆ U) (δ : ℝ) (hδ : 0 < δ) (hδρ : δ ≤ ρ) (η : E2 → ℝ) (hη : ContDiff ℝ ∞ η) (hηc : HasCompactSupport η) (hη0 : ∀ z, 0 ≤ η z) (hηs : ∀ z, δ ≤ ‖z‖ → η z = 0) (hη1 : (∫ z, η z) = 1) : ContDiff ℝ ∞ (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator v y) ∧ ContDiff ℝ ∞ (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator g y) ∧ (∀ x ∈ Metric.ball x₀ (3 * ρ), ∀ b : Fin 2, pd2 b (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator v y) x = ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator (G b) y) ∧ (∀ x ∈ Metric.ball x₀ (3 * ρ), ∑ a : Fin 2, pd2 a (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y) x = -(∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator g y)) ∧ (∫ x in Metric.ball x₀ (2 * ρ), ∑ k : Fin 2, (pd2 k (fun x => ∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator v y) x) ^ 2) ≤ (∑ k : Fin 2, ∫ y in Metric.closedBall x₀ (4 * ρ), G k y ^ 2) ∧ (∫ x in Metric.ball x₀ (2 * ρ), (∫ y, η (x - y) * (Metric.closedBall x₀ (4 * ρ)).indicator g y) ^ 2) ≤ ∫ y in Metric.closedBall x₀ (4 * ρ), g y ^ 2 :=
by
  set K := Metric.closedBall x₀ (4 * ρ) with hKdef
  have hKc : IsCompact K := isCompact_closedBall _ _
  have hKm : MeasurableSet K := measurableSet_closedBall
  obtain ⟨hvK, hGK, hgK⟩ := hL2 K hKc hKU
  haveI : IsFiniteMeasure (volume.restrict K) :=
    isFiniteMeasure_restrict.2 (ne_of_lt hKc.measure_lt_top)
  
  have htr : ∀ φ : E2 → ℝ, MemLp φ 2 (volume.restrict K) →
      Integrable (K.indicator φ) ∧ MemLp (K.indicator φ) 2 volume ∧
      (∫ y, K.indicator φ y ^ 2) = ∫ y in K, φ y ^ 2 := by
    intro φ hφ
    refine ⟨(integrable_indicator_iff hKm).2 (hφ.integrable (by norm_num)),
      (memLp_indicator_iff_restrict hKm).2 hφ, ?_⟩
    have hsq : (fun y => K.indicator φ y ^ 2) = K.indicator (fun y => φ y ^ 2) := by
      funext y
      by_cases hy : y ∈ K
      · simp [Set.indicator_of_mem hy]
      · simp [Set.indicator_of_notMem hy]
    rw [hsq, integral_indicator hKm]
  have hvon : IntegrableOn v K volume := hvK.integrable (by norm_num)
  have hGon : ∀ b, IntegrableOn (G b) K volume := fun b => (hGK b).integrable (by norm_num)
  have hgon : IntegrableOn g K volume := hgK.integrable (by norm_num)
  have hvI : Integrable (K.indicator v) := (integrable_indicator_iff hKm).2 hvon
  have hgI : Integrable (K.indicator g) := (integrable_indicator_iff hKm).2 hgon
  have hGI : ∀ b, Integrable (K.indicator (G b)) := fun b => (integrable_indicator_iff hKm).2 (hGon b)
  have hVon : ∀ a : Fin 2, IntegrableOn (fun y => ∑ b : Fin 2, A y a b * G b y) K volume := by
    intro a
    refine integrable_finset_sum _ (fun b _ => ?_)
    exact IntegrableOn.continuousOn_mul ((hA a b).continuousOn.mono hKU) (hGon b) hKc
  have hVI : ∀ a : Fin 2, Integrable (K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y)) :=
    fun a => (integrable_indicator_iff hKm).2 (hVon a)
  
  have hgeo : ∀ x ∈ Metric.ball x₀ (3 * ρ), Metric.closedBall x δ ⊆ K := by
    intro x hx z hz
    rw [Metric.mem_ball] at hx
    rw [Metric.mem_closedBall] at hz
    show dist z x₀ ≤ 4 * ρ
    have := dist_triangle z x x₀
    linarith
  
  have hηt : tsupport η ⊆ Metric.closedBall 0 δ := by
    refine closure_minimal (Function.support_subset_iff'.2 fun y hy => ?_)
      Metric.isClosed_closedBall
    rw [Metric.mem_closedBall, dist_zero_right, not_le] at hy
    exact hηs _ hy.le
  have hηd : ∀ (a : Fin 2) t, δ < ‖t‖ → pd2 a η t = 0 := by
    intro a t ht
    have hnt : t ∉ tsupport (fderiv ℝ η) := by
      intro h
      have h' := hηt (tsupport_fderiv_subset ℝ h)
      rw [Metric.mem_closedBall, dist_zero_right] at h'
      linarith
    unfold pd2
    rw [image_eq_zero_of_notMem_tsupport hnt]
    rfl
  
  have hC34 : ∀ x ∈ Metric.ball x₀ (3 * ρ), (∀ b : Fin 2,
      pd2 b (fun x => ∫ y, η (x - y) * K.indicator v y) x =
        ∫ y, η (x - y) * K.indicator (G b) y) ∧
      ∑ a : Fin 2, pd2 a (fun x => ∫ y, η (x - y) *
        K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y) x =
          -(∫ y, η (x - y) * K.indicator g y) := by
    intro x hx
    have hxK := hgeo x hx
    obtain ⟨ζ, hζ⟩ : ∃ ζ : E2 → ℝ, ζ = fun y => η (x - y) := ⟨_, rfl⟩
    have hout : ∀ y, y ∉ K → δ < ‖x - y‖ := by
      intro y hy
      have h' : y ∉ Metric.closedBall x δ := fun h => hy (hxK h)
      rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at h'
      exact h'
    have hvan : ∀ y, y ∉ Metric.closedBall x δ → ζ y = 0 := by
      intro y hy
      rw [Metric.mem_closedBall, not_le, dist_eq_norm, norm_sub_rev] at hy
      rw [hζ]
      exact hηs _ hy.le
    have hζs : ContDiff ℝ ∞ ζ := by
      rw [hζ]
      exact hη.comp (contDiff_const.sub contDiff_id)
    have hζc : HasCompactSupport ζ := HasCompactSupport.intro (isCompact_closedBall x δ) hvan
    have hζt : tsupport ζ ⊆ Metric.closedBall x δ :=
      closure_minimal (Function.support_subset_iff'.2 hvan) Metric.isClosed_closedBall
    have hζU : tsupport ζ ⊆ U := hζt.trans (hxK.trans hKU)
    have hζd : ∀ (a : Fin 2) y, pd2 a ζ y = -pd2 a η (x - y) := by
      intro a y
      have h1 : HasFDerivAt η (fderiv ℝ η (x - y)) (x - y) :=
        ((hη.differentiable (by simp)) (x - y)).hasFDerivAt
      have h2 : HasFDerivAt (fun y' : E2 => x - y') (-ContinuousLinearMap.id ℝ E2) y := by
        simpa using (hasFDerivAt_id y).const_sub x
      have h3 := h1.comp y h2
      unfold pd2
      rw [show ζ = η ∘ (fun y' => x - y') from hζ, h3.fderiv]
      simp
    have hmul : ∀ φ : E2 → ℝ, (fun y => φ y * ζ y) = fun y => η (x - y) * K.indicator φ y := by
      intro φ
      funext y
      by_cases hy : y ∈ K
      · rw [Set.indicator_of_mem hy, hζ]; ring
      · simp only [Set.indicator_of_notMem hy, hζ, hηs _ (hout y hy).le, mul_zero]
    refine ⟨fun b => ?_, ?_⟩
    · 
      have hW := hgrad ζ hζs hζc hζU b
      have e1 : (fun y => v y * pd2 b ζ y) = fun y => -(pd2 b η (x - y) * K.indicator v y) := by
        funext y
        by_cases hy : y ∈ K
        · rw [Set.indicator_of_mem hy, hζd]; ring
        · rw [Set.indicator_of_notMem hy, hζd, hηd _ _ (hout y hy)]; ring
      rw [e1, hmul, MeasureTheory.integral_neg] at hW
      rw [(elr_moll_deriv η _ hη hηc hvI).2 b x]
      linarith
    · 
      have hW := heq ζ hζs hζc hζU
      have e1 : (fun y => ∑ a : Fin 2, ∑ b : Fin 2, A y a b * G b y * pd2 a ζ y) =
          fun y => -(∑ a : Fin 2, pd2 a η (x - y) *
            K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y) := by
        funext y
        by_cases hy : y ∈ K
        · simp only [Fin.sum_univ_two, Set.indicator_of_mem hy, hζd]
          ring
        · simp only [Fin.sum_univ_two, Set.indicator_of_notMem hy, hζd, hηd _ _ (hout y hy)]
          ring
      rw [e1, hmul, MeasureTheory.integral_neg] at hW
      have hint : ∀ a : Fin 2, Integrable (fun y => pd2 a η (x - y) *
          K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y) := by
        intro a
        have hc : Continuous (pd2 a η) :=
          (hη.continuous_fderiv (by simp)).clm_apply continuous_const
        have hcs : HasCompactSupport (pd2 a η) := HasCompactSupport.fderiv_apply ℝ hηc (e2 a)
        obtain ⟨c, hcb⟩ := hc.bounded_above_of_compact_support hcs
        exact (hVI a).bdd_mul (hc.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
          (Filter.Eventually.of_forall (fun y => hcb (x - y)))
      rw [integral_finset_sum _ (fun a _ => hint a)] at hW
      have hder : ∀ a : Fin 2, pd2 a (fun x => ∫ y, η (x - y) *
          K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y) x =
            ∫ y, pd2 a η (x - y) * K.indicator (fun y => ∑ b : Fin 2, A y a b * G b y) y :=
        fun a => (elr_moll_deriv η _ hη hηc (hVI a)).2 a x
      rw [Finset.sum_congr rfl (fun a _ => hder a)]
      linarith
  have hC3 := fun x hx => (hC34 x hx).1
  have hC4 := fun x hx => (hC34 x hx).2
  
  have hY : ∀ φ : E2 → ℝ, MemLp φ 2 (volume.restrict K) →
      (∫ x in Metric.ball x₀ (2 * ρ), (∫ y, η (x - y) * K.indicator φ y) ^ 2) ≤
