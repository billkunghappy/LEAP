          (chartAt E3 q).isOpen_inter_preimage_symm hBo, ⟨hz, hzB⟩, fun z' hz' => ?_⟩
        rw [hσB _ hz'.2.2, hσB _ hzB]
    have h5 := cal_blend_local_smooth (chartAt E3 q).target hT
      (fun z => ρ ((chartAt E3 q).symm z)) hf
      (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (Y ((chartAt E3 q).symm y)) : E3)) _ (hY q) hn5
      (fun z => calSigma ρ r₁ A ((chartAt E3 q).symm z)) hs
    constructor
    · refine h5.1.congr (fun y hy => ?_)
      refine PiLp.ext (fun i => ?_)
      beta_reduce
      rw [(hrep q y hy _ _ _ rfl rfl rfl i).1, PiLp.add_apply, PiLp.smul_apply, PiLp.smul_apply,
        smul_eq_mul, smul_eq_mul]
    · refine h5.2.congr (fun y hy => ?_)
      refine PiLp.ext (fun i => ?_)
      beta_reduce
      rw [(hrep q y hy _ _ _ rfl rfl rfl i).2, PiLp.smul_apply, smul_eq_mul]
  exact ⟨V, Z, fun q => (hsm q).1, hnorm, fun q => (hsm q).2, hrep⟩

theorem ccs_flux_zero (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (P : E3 → E3) (Q₀ : Set E3) (hQ₀ : IsOpen Q₀) (hP : ∀ i : Fin 3, ContDiff ℝ 1 (fun z => Real.sqrt (G z).det * P z i)) (hPc : ∀ i : Fin 3, HasCompactSupport (fun z => Real.sqrt (G z).det * P z i)) (hfr : ∀ y ∈ frontier Q₀, ∀ᶠ z in 𝓝 y, P z = 0) : ∫ z in Q₀, sepDensDiv G P z = 0 :=
by
  
  have hibp : ∀ (w : E3 → ℝ), ContDiff ℝ 1 w → HasCompactSupport w → ∀ v : E3,
      Integrable (fun x => fderiv ℝ w x v) ∧ ∫ x, fderiv ℝ w x v = 0 := by
    intro w hw hwc v
    have hI : Integrable (fun x => fderiv ℝ w x v) :=
      ((hw.continuous_fderiv one_ne_zero).clm_apply continuous_const).integrable_of_hasCompactSupport
        (hwc.fderiv_apply ℝ v)
    have hJ : Integrable w := hw.continuous.integrable_of_hasCompactSupport hwc
    refine ⟨hI, ?_⟩
    have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
      (f := fun _ : E3 => (1 : ℝ)) (g := w) (v := v)
      (by simp) (by simpa using hI) (by simpa using hJ) (differentiable_const _)
      (hw.differentiable one_ne_zero)
    simpa using h
  
  have hind : ∀ k : E3 → ℝ, ContDiff ℝ 1 k → HasCompactSupport k →
      (∀ y ∈ frontier Q₀, ∀ᶠ z in 𝓝 y, k z = 0) →
      ContDiff ℝ 1 (Q₀.indicator k) ∧ HasCompactSupport (Q₀.indicator k) ∧
      ∀ y v : E3, fderiv ℝ (Q₀.indicator k) y v = Q₀.indicator (fun z => fderiv ℝ k z v) y := by
    intro k hk hkc hkfr
    have hloc : ∀ y, (y ∈ Q₀ ∧ Q₀.indicator k =ᶠ[𝓝 y] k) ∨
        (y ∉ Q₀ ∧ Q₀.indicator k =ᶠ[𝓝 y] (fun _ => (0 : ℝ))) := by
      intro y
      by_cases hy : y ∈ Q₀
      · left
        exact ⟨hy, Filter.eventually_of_mem (hQ₀.mem_nhds hy)
          (fun z hz => Set.indicator_of_mem hz k)⟩
      · right
        refine ⟨hy, ?_⟩
        by_cases hc : y ∈ closure Q₀
        · have hyf : y ∈ frontier Q₀ := by rw [hQ₀.frontier_eq]; exact ⟨hc, hy⟩
          filter_upwards [hkfr y hyf] with z hz
          exact Set.indicator_apply_eq_zero.mpr (fun _ => hz)
        · filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hc] with z hz
          exact Set.indicator_of_notMem (fun h => hz (subset_closure h)) k
    refine ⟨contDiff_iff_contDiffAt.mpr (fun y => ?_),
      hkc.mono' (fun x hx => subset_tsupport k (fun h0 => hx (by simp [Set.indicator_apply, h0]))),
      fun y v => ?_⟩
    · rcases hloc y with ⟨_, h⟩ | ⟨_, h⟩
      · exact hk.contDiffAt.congr_of_eventuallyEq h
      · exact contDiffAt_const.congr_of_eventuallyEq h
    · rcases hloc y with ⟨hy, h⟩ | ⟨hy, h⟩
      · rw [h.fderiv_eq, Set.indicator_of_mem hy]
      · rw [h.fderiv_eq, Set.indicator_of_notMem hy]
        simp
  
  have hk0 : ∀ i : Fin 3, ∀ y ∈ frontier Q₀, ∀ᶠ z in 𝓝 y, Real.sqrt (G z).det * P z i = 0 := by
    intro i y hy
    filter_upwards [hfr y hy] with z hz
    rw [hz]
    simp
  have hzero : ∀ i : Fin 3,
      ∫ z in Q₀, fderiv ℝ (fun z => Real.sqrt (G z).det * P z i) z (e i) = 0 := by
    intro i
    obtain ⟨h1, h2, h3⟩ := hind _ (hP i) (hPc i) (hk0 i)
    rw [← integral_indicator hQ₀.measurableSet]
    have hfun : (Q₀.indicator fun z => fderiv ℝ (fun z => Real.sqrt (G z).det * P z i) z (e i)) =
        fun z => fderiv ℝ (Q₀.indicator fun z => Real.sqrt (G z).det * P z i) z (e i) := by
      funext z
      rw [h3]
    rw [hfun]
    exact (hibp _ h1 h2 (e i)).2
  have hint : ∀ i ∈ (Finset.univ : Finset (Fin 3)),
      Integrable (fun z => fderiv ℝ (fun z => Real.sqrt (G z).det * P z i) z (e i))
        (volume.restrict Q₀) :=
    fun i _ => (hibp _ (hP i) (hPc i) (e i)).1.integrableOn
  unfold sepDensDiv partialDeriv
  rw [integral_finset_sum _ hint]
  exact Finset.sum_eq_zero (fun i _ => hzero i)

theorem ccs_div_local (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V W₁ W₂ : E3 → E3) (h₁ h₂ : E3 → ℝ) (y : E3) (hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, V z i = h₁ z * W₁ z i + h₂ z * W₂ z i) (hh₁ : DifferentiableAt ℝ h₁ y) (hh₂ : DifferentiableAt ℝ h₂ y) (hW₁ : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * W₁ z i) y) (hW₂ : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * W₂ z i) y) : sepDensDiv G V y = h₁ y * sepDensDiv G W₁ y + Real.sqrt (G y).det * fderiv ℝ h₁ y (W₁ y) + (h₂ y * sepDensDiv G W₂ y + Real.sqrt (G y).det * fderiv ℝ h₂ y (W₂ y)) :=
by
  have hev : ∀ i : Fin 3, (fun z => Real.sqrt (G z).det * V z i) =ᶠ[𝓝 y]
      (fun z => h₁ z * (Real.sqrt (G z).det * W₁ z i) +
        h₂ z * (Real.sqrt (G z).det * W₂ z i)) := by
    intro i
    filter_upwards [hloc] with z hz
    rw [hz i]; ring
  have hpd : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * V z i) y =
      h₁ y * partialDeriv i (fun z => Real.sqrt (G z).det * W₁ z i) y
        + (Real.sqrt (G y).det * W₁ y i) * fderiv ℝ h₁ y (e i)
        + (h₂ y * partialDeriv i (fun z => Real.sqrt (G z).det * W₂ z i) y
        + (Real.sqrt (G y).det * W₂ y i) * fderiv ℝ h₂ y (e i)) := by
    intro i
    have d₁ : DifferentiableAt ℝ (fun z => h₁ z * (Real.sqrt (G z).det * W₁ z i)) y :=
      hh₁.mul (hW₁ i)
    have d₂ : DifferentiableAt ℝ (fun z => h₂ z * (Real.sqrt (G z).det * W₂ z i)) y :=
      hh₂.mul (hW₂ i)
    unfold partialDeriv
    rw [(hev i).fderiv_eq, fderiv_fun_add d₁ d₂,
      fderiv_fun_mul hh₁ (hW₁ i), fderiv_fun_mul hh₂ (hW₂ i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    try ring
  have hbasis : ∀ (L : E3 →L[ℝ] ℝ) (w : E3),
      L w = w 0 * L (e 0) + w 1 * L (e 1) + w 2 * L (e 2) := by
    intro L w
    have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
      ext j
      fin_cases j <;> simp [e, EuclideanSpace.single_apply]
    conv_lhs => rw [hw]
    simp only [map_add, map_smul, smul_eq_mul]
  unfold sepDensDiv
  simp only [Fin.sum_univ_three, hpd]
  rw [hbasis (fderiv ℝ h₁ y) (W₁ y), hbasis (fderiv ℝ h₂ y) (W₂ y)]
  ring

theorem ccs_int_identity (Ft At U' : Set E3) (a b c D₀ D₁ σ : E3 → ℝ) (hFm : MeasurableSet Ft) (hAm : MeasurableSet At) (hUm : MeasurableSet U') (hAU : At ⊆ U') (ha : Integrable a) (hb : Integrable b) (hc : Integrable c) (hσ : ∀ z, σ z = (U' \ At).indicator (fun _ => (1 : ℝ)) z - At.indicator (fun _ => (1 : ℝ)) z) (hD₀ : ∀ z, D₀ z = a z + b z) (hD₁ : ∀ z, D₁ z = a z + σ z * c z) (hb0 : ∀ z, z ∉ U' → b z = 0) (hbA : ∫ z in At, b z = 0) (hcA : ∫ z in At, c z = 0) : (∫ z in Ft, D₁ z) - ∫ z in (Ft \ U') ∪ At, D₀ z = ∫ z in symmDiff Ft At ∩ U', (σ z * a z + c z) :=
by
  classical
  have hBm : MeasurableSet (U' \ At) := hUm.diff hAm
  have hS0m : MeasurableSet ((Ft \ U') ∪ At) := (hFm.diff hUm).union hAm
  have hSm : MeasurableSet (symmDiff Ft At ∩ U') := (hFm.symmDiff hAm).inter hUm
  have hσu : ∀ (u : E3 → ℝ) (z : E3),
      σ z * u z = (U' \ At).indicator u z - At.indicator u z := by
    intro u z
    rw [hσ z]
    simp only [Set.indicator_apply]
    split_ifs <;> ring
  have hσc : Integrable (fun z => σ z * c z) :=
    ((hc.indicator hBm).sub (hc.indicator hAm)).congr
      (Filter.Eventually.of_forall fun z => by
        simp only [Pi.sub_apply]
        exact (hσu c z).symm)
  have hσa : Integrable (fun z => σ z * a z) :=
    ((ha.indicator hBm).sub (ha.indicator hAm)).congr
      (Filter.Eventually.of_forall fun z => by
        simp only [Pi.sub_apply]
        exact (hσu a z).symm)
  have hD1i : Integrable D₁ :=
    (ha.add hσc).congr (Filter.Eventually.of_forall fun z => by
      simp only [Pi.add_apply]
      exact (hD₁ z).symm)
  have hD0i : Integrable D₀ :=
    (ha.add hb).congr (Filter.Eventually.of_forall fun z => by
      simp only [Pi.add_apply]
      exact (hD₀ z).symm)
  have hEi : Integrable (fun z => σ z * a z + c z) := hσa.add hc
  have hpt : ∀ z, Ft.indicator D₁ z - ((Ft \ U') ∪ At).indicator D₀ z
      - (symmDiff Ft At ∩ U').indicator (fun z => σ z * a z + c z) z
      = -(At.indicator b z + At.indicator c z) := by
    intro z
    simp only [Set.indicator_apply, hD₁ z, hD₀ z, hσ z, Set.mem_union, Set.mem_diff,
      Set.mem_inter_iff, Set.mem_symmDiff]
    by_cases hF : z ∈ Ft <;> by_cases hA : z ∈ At <;> by_cases hU : z ∈ U'
    all_goals first
      | exact absurd (hAU hA) hU
      | (simp only [hF, hA, hU, if_true, if_false, true_and, and_true, not_true, not_false_eq_true,
          and_false, false_and, or_false, false_or, true_or, or_true]
         (try rw [hb0 z hU])
         ring)
  have key : ∫ z, (Ft.indicator D₁ z - ((Ft \ U') ∪ At).indicator D₀ z
      - (symmDiff Ft At ∩ U').indicator (fun z => σ z * a z + c z) z) = 0 := by
    simp only [hpt]
    rw [integral_neg, integral_add (hb.indicator hAm) (hc.indicator hAm),
      integral_indicator hAm, integral_indicator hAm, hbA, hcA]
    simp
  rw [integral_sub (f := fun z => Ft.indicator D₁ z - ((Ft \ U') ∪ At).indicator D₀ z)
      ((hD1i.indicator hFm).sub (hD0i.indicator hS0m)) (hEi.indicator hSm),
    integral_sub (hD1i.indicator hFm) (hD0i.indicator hS0m), integral_indicator hFm,
    integral_indicator hS0m, integral_indicator hSm] at key
  linarith

theorem ccs_theta_props (r₁ η : ℝ) (hη : 0 < η) : ContDiff ℝ ∞ (calTheta r₁ η) ∧ (∀ t, 0 ≤ calTheta r₁ η t) ∧ (∀ t, calTheta r₁ η t ≤ 1) ∧ (∀ t, t ≤ r₁ + η / 2 → calTheta r₁ η t = 0) ∧ Monotone (calTheta r₁ η) ∧ (∀ t, 0 ≤ deriv (calTheta r₁ η) t) :=
by
  have hdef : calTheta r₁ η = fun t => Real.smoothTransition (2 * ((t - r₁) / η) - 1) := by
    funext t; rfl
  have ha : ContDiff ℝ ∞ (fun t : ℝ => 2 * ((t - r₁) / η) - 1) := by fun_prop
  have hmono : Monotone (calTheta r₁ η) := by
    intro s t hst
    rw [hdef]
    apply Real.smoothTransition.monotone
    have : (s - r₁) / η ≤ (t - r₁) / η :=
      div_le_div_of_nonneg_right (by linarith) hη.le
    linarith
  refine ⟨?_, ?_, ?_, ?_, hmono, fun t => hmono.deriv_nonneg⟩
  · rw [hdef]
    exact Real.smoothTransition.contDiff.comp ha
  · intro t; rw [hdef]; exact Real.smoothTransition.nonneg _
  · intro t; rw [hdef]; exact Real.smoothTransition.le_one _
  · intro t ht
    rw [hdef]
    apply Real.smoothTransition.zero_of_nonpos
    have h1 : (t - r₁) / η ≤ 1 / 2 := by
      rw [div_le_iff₀ hη]; linarith
    linarith

theorem ccs_thetaX_smooth (T T' : Set E3) (f : E3 → ℝ) (Xt : E3 → E3) (r₁ η : ℝ) (hT : IsOpen T) (hf : ContDiffOn ℝ ∞ f T) (hη : 0 < η) (hT'o : IsOpen T') (hT'f : ∀ z ∈ T, r₁ ≤ f z → z ∈ T') (hXt : ContDiffOn ℝ ∞ Xt T') : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => calTheta r₁ η (f z) * Xt z i) T :=
by
  intro i
  have hAff : ContDiff ℝ ∞ (fun t : ℝ => 2 * ((t - r₁) / η) - 1) :=
    (contDiff_const.mul ((contDiff_id.sub contDiff_const).div_const η)).sub contDiff_const
  have hθ : ContDiff ℝ ∞ (calTheta r₁ η) := by
    show ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition (2 * ((t - r₁) / η) - 1))
    exact Real.smoothTransition.contDiff.comp hAff
  have hθf : ContDiffOn ℝ ∞ (fun z => calTheta r₁ η (f z)) T := hθ.comp_contDiffOn hf
  have hzero : ∀ t : ℝ, t < r₁ + η / 2 → calTheta r₁ η t = 0 := by
    intro t ht
    show Real.smoothTransition (2 * ((t - r₁) / η) - 1) = 0
    apply Real.smoothTransition.zero_of_nonpos
    have h1 : (t - r₁) / η ≤ 1 / 2 := by
      rw [div_le_iff₀ hη]
      linarith
    linarith
  have hXi : ContDiffOn ℝ ∞ (fun z => Xt z i) T' := (contDiffOn_piLp 2).1 hXt i
  apply contDiffOn_of_locally_contDiffOn
  intro z hz
  rcases lt_or_ge r₁ (f z) with h | h
  · refine ⟨T', hT'o, hT'f z hz h.le, ?_⟩
    exact (hθf.mono Set.inter_subset_left).mul (hXi.mono Set.inter_subset_right)
  · refine ⟨T ∩ f ⁻¹' Set.Iio (r₁ + η / 2), hf.continuousOn.isOpen_inter_preimage hT isOpen_Iio,
      ⟨hz, show f z < r₁ + η / 2 by linarith⟩, ?_⟩
    refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
    intro w hw
    have hw' : f w < r₁ + η / 2 := hw.2.2
    simp only [hzero (f w) hw', zero_mul]

theorem ccs_field_regular (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T C : Set E3) (V : E3 → E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hdet : ∀ z ∈ T, 0 < (G z).det) (hC : IsCompact C) (hCT : C ⊆ T) (hV0 : ∀ z, z ∉ T → V z = 0) (hVC : ∀ z ∈ T, z ∉ C → V z = 0) (hV : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => V z i) T) : (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * V z i) ∧ HasCompactSupport (fun z => Real.sqrt (G z).det * V z i)) ∧ Integrable (sepDensDiv G V) :=
by
  
  have hdetS : ContDiffOn ℝ ∞ (fun z => (G z).det) T := by
    have h := ((((((hG 0 0).mul ((hG 1 1).mul (hG 2 2))).sub ((hG 0 0).mul ((hG 1 2).mul (hG 2 1)))).sub
      ((hG 0 1).mul ((hG 1 0).mul (hG 2 2)))).add ((hG 0 1).mul ((hG 1 2).mul (hG 2 0)))).add
      ((hG 0 2).mul ((hG 1 0).mul (hG 2 1)))).sub ((hG 0 2).mul ((hG 1 1).mul (hG 2 0)))
    refine h.congr (fun z _ => ?_)
    rw [Matrix.det_fin_three]; ring
  have hs : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) T :=
    hdetS.sqrt (fun z hz => (hdet z hz).ne')
  
  have hvan : ∀ i : Fin 3, ∀ z, z ∉ C → Real.sqrt (G z).det * V z i = 0 := by
    intro i z hz
    by_cases hzT : z ∈ T
    · rw [hVC z hzT hz]; simp
    · rw [hV0 z hzT]; simp
  
  have hk : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * V z i) := by
    intro i
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hzT : z ∈ T
    · exact (hs.mul (hV i)).contDiffAt (hT.mem_nhds hzT)
    · have hzC : z ∉ C := fun h => hzT (hCT h)
      have hev : (fun z => Real.sqrt (G z).det * V z i) =ᶠ[𝓝 z] fun _ => (0 : ℝ) :=
        Filter.eventually_of_mem (hC.isClosed.isOpen_compl.mem_nhds hzC) (fun w hw => hvan i w hw)
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hks : ∀ i : Fin 3, HasCompactSupport (fun z => Real.sqrt (G z).det * V z i) :=
    fun i => HasCompactSupport.intro hC (fun z hz => hvan i z hz)
  refine ⟨fun i => ⟨hk i, hks i⟩, ?_⟩
  have hterm : ∀ i : Fin 3, Integrable
      (fun y => partialDeriv i (fun z => Real.sqrt (G z).det * V z i) y) := by
    intro i
    have hc : Continuous (fun y => fderiv ℝ (fun z => Real.sqrt (G z).det * V z i) y (e i)) :=
      ((hk i).continuous_fderiv (by simp)).clm_apply continuous_const
    have hcs : HasCompactSupport
        (fun y => fderiv ℝ (fun z => Real.sqrt (G z).det * V z i) y (e i)) :=
      (hks i).fderiv_apply ℝ (e i)
    exact hc.integrable_of_hasCompactSupport hcs
  unfold sepDensDiv
  exact integrable_finset_sum Finset.univ (fun i _ => hterm i)

theorem ccs_layer_pointwise (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T T' : Set E3) (f ψ sig d : E3 → ℝ) (Yt Xt Zt W₀ P₁ Q' : E3 → E3) (r₁ η : ℝ) (z : E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun w => G w i j) T) (hdet : ∀ w ∈ T, 0 < (G w).det) (hf : ContDiffOn ℝ ∞ f T) (hη : 0 < η) (hψ : ContDiffOn ℝ ∞ ψ T) (hψ0 : 0 ≤ ψ z) (hT'o : IsOpen T') (hT'T : T' ⊆ T) (hYt : ContDiffOn ℝ ∞ Yt T) (hXt : ContDiffOn ℝ ∞ Xt T') (hz : z ∈ T') (hsig : sig z = 1 ∨ sig z = -1) (hCS : |fderiv ℝ f z (Yt z)| ≤ fderiv ℝ f z (Xt z)) (hW₀ : ∀ w ∈ T, ∀ i : Fin 3, W₀ w i = ψ w * Yt w i) (hP₁ : ∀ w ∈ T, ∀ i : Fin 3, P₁ w i = ψ w * ((1 - calTheta r₁ η (f w)) * Yt w i)) (hQ' : ∀ w ∈ T', ∀ i : Fin 3, Q' w i = ψ w * (calTheta r₁ η (f w) * Xt w i)) (hZt : ∀ i : Fin 3, Zt z i = calTheta r₁ η (f z) * Xt z i) (hd : d z = ψ z * sepDensDiv G Xt z) : calTheta r₁ η (f z) * d z + Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z) + (sig z * sepDensDiv G W₀ z - calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) ≤ sig z * sepDensDiv G P₁ z + sepDensDiv G Q' z :=
by
  have hzT : z ∈ T := hT'T hz
  have hTz : T ∈ 𝓝 z := hT.mem_nhds hzT
  have hT'z : T' ∈ 𝓝 z := hT'o.mem_nhds hz
  
  have hdefθ : calTheta r₁ η = fun t => Real.smoothTransition (2 * ((t - r₁) / η) - 1) := by
    funext t; rfl
  have hθs : ContDiff ℝ ∞ (calTheta r₁ η) := by
    rw [hdefθ]
    have ha : ContDiff ℝ ∞ (fun t : ℝ => 2 * ((t - r₁) / η) - 1) := by fun_prop
    exact Real.smoothTransition.contDiff.comp ha
  have hθmono : Monotone (calTheta r₁ η) := by
    intro a b hab
    rw [hdefθ]
    apply Real.smoothTransition.monotone
    have : (a - r₁) / η ≤ (b - r₁) / η := div_le_div_of_nonneg_right (by linarith) hη.le
    linarith
  
  have hs : ContDiffOn ℝ ∞ (fun w => Real.sqrt (G w).det) T := by
    have h := hG
    have hP : ContDiffOn ℝ ∞ (fun z => G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
        - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
        + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0) T :=
      (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    have hdetS : ContDiffOn ℝ ∞ (fun z => (G z).det) T :=
      hP.congr (fun z _ => Matrix.det_fin_three (G z))
    exact hdetS.sqrt (fun z hz => (hdet z hz).ne')
  
  have ccs_div_local : ∀ (V W₁ W₂ : E3 → E3) (h₁ h₂ : E3 → ℝ),
      (∀ᶠ w in 𝓝 z, ∀ i : Fin 3, V w i = h₁ w * W₁ w i + h₂ w * W₂ w i) →
      DifferentiableAt ℝ h₁ z → DifferentiableAt ℝ h₂ z →
      (∀ i : Fin 3, DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * W₁ w i) z) →
      (∀ i : Fin 3, DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * W₂ w i) z) →
      sepDensDiv G V z = h₁ z * sepDensDiv G W₁ z + Real.sqrt (G z).det * fderiv ℝ h₁ z (W₁ z) +
        (h₂ z * sepDensDiv G W₂ z + Real.sqrt (G z).det * fderiv ℝ h₂ z (W₂ z)) := by
    intro V W₁ W₂ h₁ h₂ hloc hh₁ hh₂ hW₁ hW₂
    have hev : ∀ i : Fin 3, (fun w => Real.sqrt (G w).det * V w i) =ᶠ[𝓝 z]
        (fun w => h₁ w * (Real.sqrt (G w).det * W₁ w i) +
          h₂ w * (Real.sqrt (G w).det * W₂ w i)) := by
      intro i
      filter_upwards [hloc] with w hw
      rw [hw i]; ring
    have hpd : ∀ i : Fin 3, partialDeriv i (fun w => Real.sqrt (G w).det * V w i) z =
        h₁ z * partialDeriv i (fun w => Real.sqrt (G w).det * W₁ w i) z
          + (Real.sqrt (G z).det * W₁ z i) * fderiv ℝ h₁ z (e i)
          + (h₂ z * partialDeriv i (fun w => Real.sqrt (G w).det * W₂ w i) z
          + (Real.sqrt (G z).det * W₂ z i) * fderiv ℝ h₂ z (e i)) := by
      intro i
      have d₁ : DifferentiableAt ℝ (fun w => h₁ w * (Real.sqrt (G w).det * W₁ w i)) z :=
        hh₁.mul (hW₁ i)
      have d₂ : DifferentiableAt ℝ (fun w => h₂ w * (Real.sqrt (G w).det * W₂ w i)) z :=
        hh₂.mul (hW₂ i)
      unfold partialDeriv
      rw [(hev i).fderiv_eq, fderiv_fun_add d₁ d₂,
        fderiv_fun_mul hh₁ (hW₁ i), fderiv_fun_mul hh₂ (hW₂ i)]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      try ring
    have hbasis : ∀ (L : E3 →L[ℝ] ℝ) (w : E3),
        L w = w 0 * L (e 0) + w 1 * L (e 1) + w 2 * L (e 2) := by
      intro L w
      have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
        ext j
        fin_cases j <;> simp [e, EuclideanSpace.single_apply]
      conv_lhs => rw [hw]
      simp only [map_add, map_smul, smul_eq_mul]
    unfold sepDensDiv
    simp only [Fin.sum_univ_three, hpd]
    rw [hbasis (fderiv ℝ h₁ z) (W₁ z), hbasis (fderiv ℝ h₂ z) (W₂ z)]
    ring
  have hfd : DifferentiableAt ℝ f z := (hf.contDiffAt hTz).differentiableAt (by simp)
  have hψd : DifferentiableAt ℝ ψ z := (hψ.contDiffAt hTz).differentiableAt (by simp)
  have hθd : DifferentiableAt ℝ (calTheta r₁ η) (f z) := hθs.differentiable (by simp) (f z)
  have hθf : HasFDerivAt (fun w => calTheta r₁ η (f w))
      (deriv (calTheta r₁ η) (f z) • fderiv ℝ f z) z :=
    hθd.hasDerivAt.comp_hasFDerivAt z hfd.hasFDerivAt
  have hYi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun w => Yt w i) T := fun i => (contDiffOn_piLp 2).1 hYt i
  have hXi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun w => Xt w i) T' :=
    fun i => (contDiffOn_piLp 2).1 hXt i
  have hWd : ∀ i : Fin 3, DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * W₀ w i) z := by
    intro i
    have h1 : DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * (ψ w * Yt w i)) z :=
      ((hs.mul (hψ.mul (hYi i))).contDiffAt hTz).differentiableAt (by simp)
    refine h1.congr_of_eventuallyEq ?_
    filter_upwards [hTz] with w hw
    rw [hW₀ w hw i]
  have hXd : ∀ i : Fin 3, DifferentiableAt ℝ (fun w => Real.sqrt (G w).det * Xt w i) z := fun i =>
    (((hs.mono hT'T).mul (hXi i)).contDiffAt hT'z).differentiableAt (by simp)
  have hlocP : ∀ᶠ w in 𝓝 z, ∀ i : Fin 3, P₁ w i =
      (fun w => 1 - calTheta r₁ η (f w)) w * W₀ w i + (fun _ => (0:ℝ)) w * W₀ w i := by
    filter_upwards [hTz] with w hw
    intro i
    rw [hP₁ w hw i, hW₀ w hw i]; ring
  have hdP := ccs_div_local P₁ W₀ W₀ (fun w => 1 - calTheta r₁ η (f w)) (fun _ => 0) hlocP
    ((differentiableAt_const 1).sub hθf.differentiableAt) (differentiableAt_const 0) hWd hWd
  have hlocQ : ∀ᶠ w in 𝓝 z, ∀ i : Fin 3, Q' w i =
      (fun w => ψ w * calTheta r₁ η (f w)) w * Xt w i + (fun _ => (0:ℝ)) w * Xt w i := by
    filter_upwards [hT'z] with w hw
    intro i
    rw [hQ' w hw i]; ring
  have hdQ := ccs_div_local Q' Xt Xt (fun w => ψ w * calTheta r₁ η (f w)) (fun _ => 0) hlocQ
    (hψd.mul hθf.differentiableAt) (differentiableAt_const 0) hXd hXd
  have hF1 : fderiv ℝ (fun w => 1 - calTheta r₁ η (f w)) z =
      -(deriv (calTheta r₁ η) (f z) • fderiv ℝ f z) := by
    rw [fderiv_const_sub, hθf.fderiv]
  have hF2 : fderiv ℝ (fun w => ψ w * calTheta r₁ η (f w)) z =
      ψ z • (deriv (calTheta r₁ η) (f z) • fderiv ℝ f z) + calTheta r₁ η (f z) • fderiv ℝ ψ z := by
    rw [fderiv_fun_mul hψd hθf.differentiableAt, hθf.fderiv]
  have hF0 : fderiv ℝ (fun _ : E3 => (0:ℝ)) z = 0 := by simp
  have hW₀z : W₀ z = ψ z • Yt z := PiLp.ext (fun i => by rw [hW₀ z hzT i]; simp)
  have hZz : Zt z = calTheta r₁ η (f z) • Xt z := PiLp.ext (fun i => by rw [hZt i]; simp)
  rw [hdP, hdQ, hF1, hF2, hF0, hW₀z, hZz, hd]
  simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.coe_smul', Pi.smul_apply, ContinuousLinearMap.zero_apply, map_smul,
    smul_eq_mul]
  have ha : 0 ≤ Real.sqrt (G z).det := Real.sqrt_nonneg _
  have ht' : 0 ≤ deriv (calTheta r₁ η) (f z) := hθmono.deriv_nonneg
  have hp3 : 0 ≤ Real.sqrt (G z).det * ψ z * deriv (calTheta r₁ η) (f z) :=
    mul_nonneg (mul_nonneg ha hψ0) ht'
  rcases hsig with h | h
  · rw [h]
    have hg : 0 ≤ fderiv ℝ f z (Xt z) - fderiv ℝ f z (Yt z) := by
      have := le_abs_self (fderiv ℝ f z (Yt z)); linarith
    have key := mul_nonneg hp3 hg
    nlinarith [key]
  · rw [h]
    have hg : 0 ≤ fderiv ℝ f z (Xt z) + fderiv ℝ f z (Yt z) := by
      have := neg_abs_le (fderiv ℝ f z (Yt z)); linarith
    have key := mul_nonneg hp3 hg
    nlinarith [key]

theorem ccs_sqrtdet_smooth (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hdet : ∀ z ∈ T, 0 < (G z).det) : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) T :=
by
  have h := hG
  have hP : ContDiffOn ℝ ∞ (fun z => G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
      - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
      + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0) T :=
    (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
      (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
      (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
  have hdetS : ContDiffOn ℝ ∞ (fun z => (G z).det) T :=
    hP.congr (fun z _ => Matrix.det_fin_three (G z))
  exact hdetS.sqrt (fun z hz => (hdet z hz).ne')

theorem ccs_euclid_calib (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T T' C Ft At : Set E3) (f ψ d sig : E3 → ℝ) (Yt Xt Zt W₀ W₁ : E3 → E3) (r₁ η : ℝ) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hdet : ∀ z ∈ T, 0 < (G z).det) (hf : ContDiffOn ℝ ∞ f T) (hη : 0 < η) (hψ : ContDiffOn ℝ ∞ ψ T) (hψ0 : ∀ z ∈ T, 0 ≤ ψ z) (hC : IsCompact C) (hCT : C ⊆ T) (hψC : ∀ z ∈ T, z ∉ C → ψ z = 0) (hT'o : IsOpen T') (hT'T : T' ⊆ T) (hT'f : ∀ z ∈ T, r₁ ≤ f z → z ∈ T') (hYt : ContDiffOn ℝ ∞ Yt T) (hXt : ContDiffOn ℝ ∞ Xt T') (hCS : ∀ z ∈ T, r₁ < f z → |fderiv ℝ f z (Yt z)| ≤ fderiv ℝ f z (Xt z)) (hAo : IsOpen At) (hAsub : At ⊆ {z : E3 | z ∈ T ∧ r₁ < f z}) (hBo : IsOpen ({z : E3 | z ∈ T ∧ r₁ < f z} \ At)) (hFm : MeasurableSet Ft) (hFT : Ft ⊆ T) (hsig : ∀ z ∈ T, sig z = ({z : E3 | z ∈ T ∧ r₁ < f z} \ At).indicator (fun _ => (1 : ℝ)) z - At.indicator (fun _ => (1 : ℝ)) z) (hW₀o : ∀ z, z ∉ T → W₀ z = 0) (hW₀ : ∀ z ∈ T, ∀ i : Fin 3, W₀ z i = ψ z * Yt z i) (hW₁o : ∀ z, z ∉ T → W₁ z = 0) (hW₁ : ∀ z ∈ T, ∀ i : Fin 3, W₁ z i = ψ z * ((1 - calTheta r₁ η (f z)) * Yt z i + sig z * calTheta r₁ η (f z) * Xt z i)) (hZt : ∀ z ∈ T, ∀ i : Fin 3, Zt z i = calTheta r₁ η (f z) * Xt z i) (hd : ∀ z ∈ T, r₁ < f z → d z = ψ z * sepDensDiv G Xt z) : IntegrableOn d (symmDiff Ft At ∩ {z : E3 | r₁ < f z}) ∧ IntegrableOn (fun z => sig z * sepDensDiv G W₀ z) (symmDiff Ft At ∩ {z : E3 | r₁ < f z}) ∧ (∫ z in symmDiff Ft At ∩ {z : E3 | r₁ < f z}, calTheta r₁ η (f z) * d z) + (∫ z in symmDiff Ft At ∩ {z : E3 | r₁ < f z}, Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z)) + ((∫ z in symmDiff Ft At ∩ {z : E3 | r₁ < f z}, sig z * sepDensDiv G W₀ z) - ∫ z in symmDiff Ft At ∩ {z : E3 | r₁ < f z}, calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) ≤ (∫ z in Ft, sepDensDiv G W₁ z) - ∫ z in (Ft \ {z : E3 | r₁ < f z}) ∪ At, sepDensDiv G W₀ z :=
by
  
  obtain ⟨hθs, hθ0, hθ1, hθz, -, -⟩ := ccs_theta_props r₁ η hη
  have hs : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det) T := ccs_sqrtdet_smooth G T hG hdet
  have hθT : ContDiffOn ℝ ∞ (fun z => calTheta r₁ η (f z)) T := hθs.comp_contDiffOn hf
  have hθ' : ContDiffOn ℝ ∞ (fun z => 1 - calTheta r₁ η (f z)) T := contDiffOn_const.sub hθT
  obtain ⟨U', hU'⟩ : ∃ U : Set E3, U = {z : E3 | z ∈ T ∧ r₁ < f z} := ⟨_, rfl⟩
  rw [← hU'] at hAsub hBo hsig
  have hU'o : IsOpen U' := by
    rw [hU']; exact hf.continuousOn.isOpen_inter_preimage hT isOpen_Ioi
  have hU'T : ∀ z ∈ U', z ∈ T := fun z hz => by rw [hU'] at hz; exact hz.1
  have hU'f : ∀ z ∈ U', r₁ < f z := fun z hz => by rw [hU'] at hz; exact hz.2
  have hU'mk : ∀ z ∈ T, r₁ < f z → z ∈ U' := fun z hz h => by rw [hU']; exact ⟨hz, h⟩
  obtain ⟨Z', hZ'⟩ : ∃ Z : Set E3, Z = {z : E3 | z ∈ T ∧ f z < r₁ + η / 2} ∪ Cᶜ := ⟨_, rfl⟩
  have hZ'o : IsOpen Z' := by
    rw [hZ']
    exact (hf.continuousOn.isOpen_inter_preimage hT isOpen_Iio).union hC.isClosed.isOpen_compl
  have hvan : ∀ z ∈ Z', z ∈ T → ψ z * calTheta r₁ η (f z) = 0 := by
    intro z hz hzT
    rw [hZ'] at hz
    rcases hz with ⟨_, hlt⟩ | hzC
    · rw [hθz (f z) hlt.le, mul_zero]
    · rw [hψC z hzT hzC, zero_mul]
  have hUZ : ∀ z, z ∉ U' → z ∈ Z' := by
    intro z hz
    rw [hZ']
    by_cases hzT : z ∈ T
    · left
      refine ⟨hzT, ?_⟩
      have h1 : ¬ r₁ < f z := fun h => hz (hU'mk z hzT h)
      push_neg at h1
      show f z < r₁ + η / 2
      linarith
    · right
      exact fun hzC => hzT (hCT hzC)
  have hfrZ : ∀ y ∈ frontier At, y ∈ Z' := by
    intro y hy
    apply hUZ
    intro hyU
    have hyA : y ∉ At := by
      rw [hAo.frontier_eq] at hy; exact hy.2
    have hyB : y ∈ U' \ At := ⟨hyU, hyA⟩
    obtain ⟨x, hxB, hxA⟩ := mem_closure_iff.1 (frontier_subset_closure hy) _ hBo hyB
    exact hxB.2 hxA
  have hsigA : ∀ z ∈ At, sig z = -1 := by
    intro z hz
    rw [hsig z (hU'T z (hAsub hz)), Set.indicator_of_notMem (fun h => h.2 hz),
      Set.indicator_of_mem hz]
    norm_num
  have hsigB : ∀ z ∈ U' \ At, sig z = 1 := by
    intro z hz
    rw [hsig z (hU'T z hz.1), Set.indicator_of_mem hz, Set.indicator_of_notMem hz.2]
    norm_num
  obtain ⟨σ, hσ⟩ : ∃ σ : E3 → ℝ, σ = fun z =>
      (U' \ At).indicator (fun _ => (1 : ℝ)) z - At.indicator (fun _ => (1 : ℝ)) z := ⟨_, rfl⟩
  have hσapp : ∀ z, σ z =
      (U' \ At).indicator (fun _ => (1 : ℝ)) z - At.indicator (fun _ => (1 : ℝ)) z :=
    fun z => congrFun hσ z
  have hσsig : ∀ z ∈ T, σ z = sig z := fun z hz => by rw [hσapp z, hsig z hz]
  have hσA : ∀ z ∈ At, σ z = -1 := by
    intro z hz
    rw [hσapp z, Set.indicator_of_notMem (fun h => h.2 hz), Set.indicator_of_mem hz]
    norm_num
  have hσB : ∀ z ∈ U' \ At, σ z = 1 := by
    intro z hz
    rw [hσapp z, Set.indicator_of_mem hz, Set.indicator_of_notMem hz.2]
    norm_num
  have hσ0 : ∀ z, z ∉ U' → σ z = 0 := by
    intro z hz
    rw [hσapp z, Set.indicator_of_notMem (fun h => hz h.1),
      Set.indicator_of_notMem (fun h => hz (hAsub h))]
    norm_num
  have hσind : ∀ (g : E3 → ℝ) (z : E3),
      σ z * g z = (U' \ At).indicator g z - At.indicator g z := by
    intro g z
    rw [hσapp z]
    by_cases h1 : z ∈ U' \ At
    · have h2 : z ∉ At := h1.2
      simp [Set.indicator_of_mem h1, Set.indicator_of_notMem h2]
    · by_cases h2 : z ∈ At
      · simp [Set.indicator_of_notMem h1, Set.indicator_of_mem h2]
      · simp [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
  
  obtain ⟨P₁, hP₁⟩ : ∃ P : E3 → E3,
      P = T.indicator (fun z => (ψ z * (1 - calTheta r₁ η (f z))) • Yt z) := ⟨_, rfl⟩
  obtain ⟨P₂, hP₂⟩ : ∃ P : E3 → E3,
      P = T.indicator (fun z => (ψ z * calTheta r₁ η (f z)) • Yt z) := ⟨_, rfl⟩
  obtain ⟨Q', hQ'⟩ : ∃ P : E3 → E3,
      P = T.indicator (fun z => (ψ z * calTheta r₁ η (f z)) • Xt z) := ⟨_, rfl⟩
  have hP₁T : ∀ z ∈ T, ∀ i : Fin 3, P₁ z i = ψ z * (1 - calTheta r₁ η (f z)) * Yt z i := by
    intro z hz i; rw [hP₁, Set.indicator_of_mem hz]; simp
  have hP₂T : ∀ z ∈ T, ∀ i : Fin 3, P₂ z i = ψ z * calTheta r₁ η (f z) * Yt z i := by
    intro z hz i; rw [hP₂, Set.indicator_of_mem hz]; simp
  have hQ'T : ∀ z ∈ T, ∀ i : Fin 3, Q' z i = ψ z * calTheta r₁ η (f z) * Xt z i := by
    intro z hz i; rw [hQ', Set.indicator_of_mem hz]; simp
  have hP₁o : ∀ z, z ∉ T → P₁ z = 0 := fun z hz => by rw [hP₁, Set.indicator_of_notMem hz]
  have hP₂o : ∀ z, z ∉ T → P₂ z = 0 := fun z hz => by rw [hP₂, Set.indicator_of_notMem hz]
  have hQ'o : ∀ z, z ∉ T → Q' z = 0 := fun z hz => by rw [hQ', Set.indicator_of_notMem hz]
  have hP₁C : ∀ z ∈ T, z ∉ C → P₁ z = 0 := fun z hz hzC => by
    rw [hP₁, Set.indicator_of_mem hz, hψC z hz hzC, zero_mul, zero_smul]
  have hP₂C : ∀ z ∈ T, z ∉ C → P₂ z = 0 := fun z hz hzC => by
    rw [hP₂, Set.indicator_of_mem hz, hψC z hz hzC, zero_mul, zero_smul]
  have hQ'C : ∀ z ∈ T, z ∉ C → Q' z = 0 := fun z hz hzC => by
    rw [hQ', Set.indicator_of_mem hz, hψC z hz hzC, zero_mul, zero_smul]
  have hP₂Z : ∀ z ∈ Z', P₂ z = 0 := by
    intro z hz
    by_cases hzT : z ∈ T
    · rw [hP₂, Set.indicator_of_mem hzT, hvan z hz hzT, zero_smul]
    · exact hP₂o z hzT
  have hQ'Z : ∀ z ∈ Z', Q' z = 0 := by
    intro z hz
    by_cases hzT : z ∈ T
    · rw [hQ', Set.indicator_of_mem hzT, hvan z hz hzT, zero_smul]
    · exact hQ'o z hzT
  have hYi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => Yt z i) T := fun i => (contDiffOn_piLp 2).1 hYt i
  have hθX := ccs_thetaX_smooth T T' f Xt r₁ η hT hf hη hT'o hT'f hXt
  have hP₁s : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => P₁ z i) T := fun i =>
    ((hψ.mul hθ').mul (hYi i)).congr (fun z hz => hP₁T z hz i)
  have hP₂s : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => P₂ z i) T := fun i =>
    ((hψ.mul hθT).mul (hYi i)).congr (fun z hz => hP₂T z hz i)
  have hQ's : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => Q' z i) T := fun i =>
    (hψ.mul (hθX i)).congr (fun z hz => by rw [hQ'T z hz i]; ring)
  obtain ⟨hP₁r, hP₁i⟩ := ccs_field_regular G T C P₁ hT hG hdet hC hCT hP₁o hP₁C hP₁s
  obtain ⟨hP₂r, hP₂i⟩ := ccs_field_regular G T C P₂ hT hG hdet hC hCT hP₂o hP₂C hP₂s
  obtain ⟨hQ'r, hQ'i⟩ := ccs_field_regular G T C Q' hT hG hdet hC hCT hQ'o hQ'C hQ's
  have hdiff : ∀ V : E3 → E3, (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * V z i) ∧
      HasCompactSupport (fun z => Real.sqrt (G z).det * V z i)) →
      ∀ (y : E3) (i : Fin 3), DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * V z i) y :=
    fun V hV y i => ((hV i).1.differentiable (by simp)) y
  
  have hdivlin : ∀ (V V₁ V₂ : E3 → E3) (α β : ℝ) (y : E3),
      (∀ᶠ z in 𝓝 y, ∀ i : Fin 3, V z i = α * V₁ z i + β * V₂ z i) →
      (∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * V₁ z i) y) →
      (∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * V₂ z i) y) →
      sepDensDiv G V y = α * sepDensDiv G V₁ y + β * sepDensDiv G V₂ y := by
    intro V V₁ V₂ α β y hloc h1 h2
    have h := ccs_div_local G V V₁ V₂ (fun _ => α) (fun _ => β) y hloc
      (differentiableAt_const _) (differentiableAt_const _) h1 h2
    simpa using h
  have hD₀ : ∀ y, sepDensDiv G W₀ y = sepDensDiv G P₁ y + sepDensDiv G P₂ y := by
    intro y
    have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, W₀ z i = 1 * P₁ z i + 1 * P₂ z i := by
      refine Filter.Eventually.of_forall (fun z i => ?_)
      by_cases hz : z ∈ T
      · rw [hW₀ z hz i, hP₁T z hz i, hP₂T z hz i]; ring
      · rw [hW₀o z hz, hP₁o z hz, hP₂o z hz]; simp
    rw [hdivlin W₀ P₁ P₂ 1 1 y hloc (hdiff P₁ hP₁r y) (hdiff P₂ hP₂r y)]; ring
  have hD₁ : ∀ y, sepDensDiv G W₁ y = sepDensDiv G P₁ y + σ y * sepDensDiv G Q' y := by
    intro y
    by_cases hyA : y ∈ At
    · have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, W₁ z i = 1 * P₁ z i + (-1) * Q' z i := by
        filter_upwards [hAo.mem_nhds hyA] with z hz
        intro i
        have hzT := hU'T z (hAsub hz)
        rw [hW₁ z hzT i, hP₁T z hzT i, hQ'T z hzT i, hsigA z hz]; ring
      rw [hdivlin W₁ P₁ Q' 1 (-1) y hloc (hdiff P₁ hP₁r y) (hdiff Q' hQ'r y), hσA y hyA]
      ring
    by_cases hyB : y ∈ U' \ At
    · have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, W₁ z i = 1 * P₁ z i + 1 * Q' z i := by
        filter_upwards [hBo.mem_nhds hyB] with z hz
        intro i
        have hzT := hU'T z hz.1
        rw [hW₁ z hzT i, hP₁T z hzT i, hQ'T z hzT i, hsigB z hz]; ring
      rw [hdivlin W₁ P₁ Q' 1 1 y hloc (hdiff P₁ hP₁r y) (hdiff Q' hQ'r y), hσB y hyB]
      ring
    · have hyU : y ∉ U' := fun h => hyB ⟨h, hyA⟩
      have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, W₁ z i = 1 * P₁ z i + 0 * Q' z i := by
        filter_upwards [hZ'o.mem_nhds (hUZ y hyU)] with z hz
        intro i
        by_cases hzT : z ∈ T
        · rw [hW₁ z hzT i, hP₁T z hzT i]
          have h0 := hvan z hz hzT
          linear_combination (sig z * Xt z i) * h0
        · rw [hW₁o z hzT, hP₁o z hzT]; simp
      rw [hdivlin W₁ P₁ Q' 1 0 y hloc (hdiff P₁ hP₁r y) (hdiff Q' hQ'r y), hσ0 y hyU]
      ring
  have hb0 : ∀ y, y ∉ U' → sepDensDiv G P₂ y = 0 := by
    intro y hyU
    have hloc : ∀ᶠ z in 𝓝 y, ∀ i : Fin 3, P₂ z i = 0 * P₁ z i + 0 * P₁ z i := by
      filter_upwards [hZ'o.mem_nhds (hUZ y hyU)] with z hz
      intro i; rw [hP₂Z z hz]; simp
    rw [hdivlin P₂ P₁ P₁ 0 0 y hloc (hdiff P₁ hP₁r y) (hdiff P₁ hP₁r y)]; ring
  
  have hbA : ∫ z in At, sepDensDiv G P₂ z = 0 :=
    ccs_flux_zero G P₂ At hAo (fun i => (hP₂r i).1.of_le (by simp)) (fun i => (hP₂r i).2)
      (fun y hy => Filter.mem_of_superset (hZ'o.mem_nhds (hfrZ y hy)) (fun z hz => hP₂Z z hz))
  have hcA : ∫ z in At, sepDensDiv G Q' z = 0 :=
    ccs_flux_zero G Q' At hAo (fun i => (hQ'r i).1.of_le (by simp)) (fun i => (hQ'r i).2)
      (fun y hy => Filter.mem_of_superset (hZ'o.mem_nhds (hfrZ y hy)) (fun z hz => hQ'Z z hz))
  
  have hid := ccs_int_identity Ft At U' (sepDensDiv G P₁) (sepDensDiv G P₂) (sepDensDiv G Q')
    (sepDensDiv G W₀) (sepDensDiv G W₁) σ hFm hAo.measurableSet hU'o.measurableSet hAsub
    hP₁i hP₂i hQ'i hσapp hD₀ hD₁ hb0 hbA hcA
  
  have hSeq : symmDiff Ft At ∩ {z : E3 | r₁ < f z} = symmDiff Ft At ∩ U' := by
    ext z
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨h1, hU'mk z ?_ h2⟩
      rcases Set.mem_symmDiff.1 h1 with ⟨h, _⟩ | ⟨h, _⟩
      · exact hFT h
      · exact hU'T z (hAsub h)
    · rintro ⟨h1, h2⟩
      exact ⟨h1, hU'f z h2⟩
  have hTFeq : (Ft \ {z : E3 | r₁ < f z}) ∪ At = (Ft \ U') ∪ At := by
    ext z
    simp only [Set.mem_union, Set.mem_diff, Set.mem_setOf_eq]
    constructor
    · rintro (⟨h1, h2⟩ | h)
      · exact Or.inl ⟨h1, fun h => h2 (hU'f z h)⟩
      · exact Or.inr h
    · rintro (⟨h1, h2⟩ | h)
      · exact Or.inl ⟨h1, fun h => h2 (hU'mk z (hFT h1) h)⟩
      · exact Or.inr h
  rw [hSeq, hTFeq]
  obtain ⟨S', hS'⟩ : ∃ S : Set E3, S = symmDiff Ft At ∩ U' := ⟨_, rfl⟩
  rw [← hS'] at hid ⊢
  have hS'm : MeasurableSet S' := by
    rw [hS']; exact (hFm.symmDiff hAo.measurableSet).inter hU'o.measurableSet
  have hS'U : ∀ z ∈ S', z ∈ U' := fun z hz => by rw [hS'] at hz; exact hz.2
  
  have hKcl : IsClosed (C ∩ f ⁻¹' Set.Ici r₁) :=
    (hf.continuousOn.mono hCT).preimage_isClosed_of_isClosed hC.isClosed isClosed_Ici
  have hKc : IsCompact (C ∩ f ⁻¹' Set.Ici r₁) := hC.of_isClosed_subset hKcl Set.inter_subset_left
  have hKT' : C ∩ f ⁻¹' Set.Ici r₁ ⊆ T' := fun z hz => hT'f z (hCT hz.1) hz.2
  have hKT : C ∩ f ⁻¹' Set.Ici r₁ ⊆ T := fun z hz => hCT hz.1
  have htool : ∀ u : E3 → ℝ, ContinuousOn u (C ∩ f ⁻¹' Set.Ici r₁) →
      (∀ z ∈ S', z ∉ C → u z = 0) → IntegrableOn u S' := by
    intro u hu h0
    refine (hu.integrableOn_compact hKc).of_forall_diff_eq_zero hS'm ?_
    intro z hz
    apply h0 z hz.1
    intro hzC
    exact hz.2 ⟨hzC, (hU'f z (hS'U z hz.1)).le⟩
  have hdivX : ContinuousOn (sepDensDiv G Xt) T' := by
    have hcomp : ∀ i : Fin 3, ContinuousOn
        (fun y => partialDeriv i (fun z => Real.sqrt (G z).det * Xt z i) y) T' := by
      intro i
      have hk : ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det * Xt z i) T' :=
        (hs.mono hT'T).mul ((contDiffOn_piLp 2).1 hXt i)
      exact (hk.continuousOn_fderiv_of_isOpen hT'o (by simp)).clm_apply continuousOn_const
    unfold sepDensDiv
    exact continuousOn_finset_sum _ (fun i _ => hcomp i)
  have hu₁ : ContinuousOn (fun z => ψ z * sepDensDiv G Xt z) (C ∩ f ⁻¹' Set.Ici r₁) :=
    (hψ.continuousOn.mono hKT).mul (hdivX.mono hKT')
  have hdS : ∀ z ∈ S', d z = ψ z * sepDensDiv G Xt z :=
    fun z hz => hd z (hU'T z (hS'U z hz)) (hU'f z (hS'U z hz))
  have hψS : ∀ z ∈ S', z ∉ C → ψ z = 0 := fun z hz hzC => hψC z (hU'T z (hS'U z hz)) hzC
  have hI1 : IntegrableOn d S' :=
    (htool _ hu₁ (fun z hz hzC => by simp only [hψS z hz hzC, zero_mul])).congr_fun
      (fun z hz => (hdS z hz).symm) hS'm
  have hI2 : IntegrableOn (fun z => calTheta r₁ η (f z) * d z) S' :=
    (htool (fun z => calTheta r₁ η (f z) * (ψ z * sepDensDiv G Xt z))
      ((hθT.continuousOn.mono hKT).mul hu₁)
      (fun z hz hzC => by simp only [hψS z hz hzC, zero_mul, mul_zero])).congr_fun
      (fun z hz => by simp only [hdS z hz]) hS'm
  have hdψ0 : ∀ z ∈ T, z ∉ C → fderiv ℝ ψ z = 0 := by
    intro z hz hzC
    have hev : ψ =ᶠ[𝓝 z] (fun _ => (0 : ℝ)) := by
      filter_upwards [(hT.inter hC.isClosed.isOpen_compl).mem_nhds ⟨hz, hzC⟩] with w hw
      exact hψC w hw.1 hw.2
    rw [hev.fderiv_eq]; simp
  have hZtv : ∀ z ∈ T, Zt z = calTheta r₁ η (f z) • Xt z :=
    fun z hz => PiLp.ext (fun i => by rw [hZt z hz i]; simp)
  have hI3 : IntegrableOn (fun z => Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z)) S' := by
    have hcont : ContinuousOn (fun z => Real.sqrt (G z).det *
        (calTheta r₁ η (f z) * fderiv ℝ ψ z (Xt z))) (C ∩ f ⁻¹' Set.Ici r₁) :=
      (hs.continuousOn.mono hKT).mul ((hθT.continuousOn.mono hKT).mul
        (((hψ.continuousOn_fderiv_of_isOpen hT (by simp)).mono hKT).clm_apply
          (hXt.continuousOn.mono hKT')))
    refine (htool _ hcont (fun z hz hzC => ?_)).congr_fun (fun z hz => ?_) hS'm
    · simp only [hdψ0 z (hU'T z (hS'U z hz)) hzC, ContinuousLinearMap.zero_apply, mul_zero]
    · simp only [hZtv z (hU'T z (hS'U z hz)), map_smul, smul_eq_mul]
  have hW₀int : Integrable (sepDensDiv G W₀) :=
    (hP₁i.add hP₂i).congr (Filter.Eventually.of_forall (fun y => (hD₀ y).symm))
  have hI4 : IntegrableOn (fun z => sig z * sepDensDiv G W₀ z) S' := by
    have h : IntegrableOn (fun z => (U' \ At).indicator (sepDensDiv G W₀) z -
        At.indicator (sepDensDiv G W₀) z) S' :=
      ((hW₀int.indicator hBo.measurableSet).sub (hW₀int.indicator hAo.measurableSet)).integrableOn
    refine h.congr_fun (fun z hz => ?_) hS'm
    rw [← hσsig z (hU'T z (hS'U z hz)), hσind]
  have hθm : AEStronglyMeasurable (fun z => calTheta r₁ η (f z)) (volume.restrict S') :=
    (hθT.continuousOn.aestronglyMeasurable hT.measurableSet).mono_set
      (fun z hz => hU'T z (hS'U z hz))
  have hθb : ∀ᵐ z ∂(volume.restrict S'), ‖calTheta r₁ η (f z)‖ ≤ 1 :=
    Filter.Eventually.of_forall (fun z => by
      rw [Real.norm_eq_abs, abs_of_nonneg (hθ0 _)]; exact hθ1 _)
  have hI5 : IntegrableOn (fun z => calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) S' :=
    hI4.bdd_mul hθm hθb
  have hI6 : IntegrableOn (fun z => σ z * sepDensDiv G P₁ z + sepDensDiv G Q' z) S' := by
    have h : IntegrableOn (fun z => ((U' \ At).indicator (sepDensDiv G P₁) z -
        At.indicator (sepDensDiv G P₁) z) + sepDensDiv G Q' z) S' :=
      (((hP₁i.indicator hBo.measurableSet).sub (hP₁i.indicator hAo.measurableSet)).add
        hQ'i).integrableOn
    refine h.congr_fun (fun z _ => ?_) hS'm
    rw [hσind]
  
  have hpt : ∀ z ∈ S', calTheta r₁ η (f z) * d z + Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z) +
      (sig z * sepDensDiv G W₀ z - calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) ≤
      σ z * sepDensDiv G P₁ z + sepDensDiv G Q' z := by
    intro z hz
    have hzU := hS'U z hz
    have hzT := hU'T z hzU
    have hfz := hU'f z hzU
    have hzT' := hT'f z hzT hfz.le
    have hsz : sig z = 1 ∨ sig z = -1 := by
      by_cases hA : z ∈ At
      · exact Or.inr (hsigA z hA)
      · exact Or.inl (hsigB z ⟨hzU, hA⟩)
    rw [hσsig z hzT]
    exact ccs_layer_pointwise G T T' f ψ sig d Yt Xt Zt W₀ P₁ Q' r₁ η z hT hG hdet hf hη hψ
      (hψ0 z hzT) hT'o hT'T hYt hXt hzT' hsz (hCS z hzT hfz) hW₀
      (fun w hw i => by rw [hP₁T w hw i]; ring)
      (fun w hw i => by rw [hQ'T w (hT'T hw) i]; ring) (hZt z hzT) (hd z hzT hfz)
  
  have hI23 : IntegrableOn (fun z => calTheta r₁ η (f z) * d z +
      Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z)) S' := hI2.add hI3
  have hI45 : IntegrableOn (fun z => sig z * sepDensDiv G W₀ z -
      calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) S' := hI4.sub hI5
  have hsplit : ∫ z in S', (calTheta r₁ η (f z) * d z + Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z) +
      (sig z * sepDensDiv G W₀ z - calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z))) =
      (∫ z in S', calTheta r₁ η (f z) * d z) +
        (∫ z in S', Real.sqrt (G z).det * fderiv ℝ ψ z (Zt z)) +
        ((∫ z in S', sig z * sepDensDiv G W₀ z) -
          ∫ z in S', calTheta r₁ η (f z) * (sig z * sepDensDiv G W₀ z)) := by
    rw [integral_add hI23 hI45, integral_add hI2 hI3, integral_sub hI4 hI5]
  refine ⟨hI1, hI4, ?_⟩
  rw [← hsplit, hid]
  exact setIntegral_mono_on (hI23.add hI45) hI6 hS'm hpt

theorem ccs_divx (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (T : Set E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i) (hpd : ∀ z ∈ T, (G z).PosDef) (hf : ContDiffOn ℝ ∞ f T) (X : E3 → E3) (hX : ∀ z ∈ T, ∀ i : Fin 3, X z i = calUnitNormal G f z i) (y : E3) (hy : y ∈ T) (hN : 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y) : sepDensDiv G X y = Real.sqrt (G y).det * levelMeanCurvCoord G f y :=
by
  classical
  
  have key : ∀ (Ginv : Matrix (Fin 3) (Fin 3) ℝ) (dS : Fin 3 → ℝ)
      (dGi : Fin 3 → Fin 3 → Fin 3 → ℝ) (Γp : Fin 3 → Fin 3 → ℝ) (p : Fin 3 → ℝ)
      (h : Fin 3 → Fin 3 → ℝ) (s N : ℝ), (∀ a b : Fin 3, Ginv a b = Ginv b a) →
      (∑ i : Fin 3, dS i * ∑ k : Fin 3, Ginv i k * p k +
          s * ∑ i : Fin 3, ∑ k : Fin 3, dGi i i k * p k =
        -(s * ∑ i : Fin 3, ∑ j : Fin 3, Ginv i j * Γp i j)) →
      (∑ i : Fin 3, (∑ k : Fin 3, Ginv i k * p k) * ∑ a : Fin 3, ∑ b : Fin 3,
          dGi i a b * p a * p b =
        -2 * ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          Ginv i a * p a * (Ginv j b * p b) * Γp i j) →
      ∑ i : Fin 3, (dS i * (N⁻¹ * ∑ k : Fin 3, Ginv i k * p k) +
        s * (-((∑ a : Fin 3, ∑ b : Fin 3, (dGi i a b * p a * p b + Ginv a b * h i a * p b +
            Ginv a b * p a * h i b)) / (2 * N ^ 3)) * ∑ k : Fin 3, Ginv i k * p k +
          N⁻¹ * ∑ k : Fin 3, (dGi i i k * p k + Ginv i k * h i k))) =
      s * ((∑ i : Fin 3, ∑ j : Fin 3, Ginv i j * (h i j - Γp i j)) / N -
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
          Ginv i a * p a * (Ginv j b * p b) * (h i j - Γp i j)) / N ^ 3) := by
    intro Ginv dS dGi Γp p h s N hsym hA1 hA2
    have e10 := hsym 1 0
    have e20 := hsym 2 0
    have e21 := hsym 2 1
    simp only [Fin.sum_univ_three, e10, e20, e21] at hA1 hA2 ⊢
    linear_combination N⁻¹ * hA1 - (s * N⁻¹ ^ 3 / 2) * hA2
  
  have hTy : T ∈ 𝓝 y := hT.mem_nhds hy
  have hdet : 0 < (G y).det := (hpd y hy).det_pos
  have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y := fun a b =>
    ((hG a b).differentiableOn (by simp)).differentiableAt hTy
  have hpd' : ∀ a : Fin 3, DifferentiableAt ℝ (partialDeriv a f) y := by
    intro a
    have h1 : ContDiffAt ℝ ∞ f y := hf.contDiffAt hTy
    have h2 : ContDiffAt ℝ 1 (fderiv ℝ f) y :=
      ((contDiffAt_infty.1 h1) 2).fderiv_right (m := 1) (by norm_num)
    have h3 : DifferentiableAt ℝ (fderiv ℝ f) y := h2.differentiableAt one_ne_zero
    exact h3.clm_apply (differentiableAt_const (e a))
  have hsymI : ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a := by
    have hS : (G y).IsSymm := Matrix.IsSymm.ext (fun i j => hsymm y j i)
    have hSi := hS.inv
    intro a b
    exact hSi.apply b a
  
  
  have inv_entry : ∀ (x : E3) (m : Fin 3),
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x) → (G x).det ≠ 0 →
      ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
        partialDeriv m (fun y => (G y)⁻¹ k l) x =
          -∑ a : Fin 3, ∑ b : Fin 3,
            (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := by
    intro x m hG hdet
    have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
        DifferentiableAt ℝ (fun y => (H y).det) x := by
      intro H hH
      have hfun : (fun y => (H y).det) = fun y =>
          H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
        funext y; exact Matrix.det_fin_three (H y)
      rw [hfun]
      have h00 := hH 0 0
      have h01 := hH 0 1
      have h02 := hH 0 2
      have h10 := hH 1 0
      have h11 := hH 1 1
      have h12 := hH 1 2
      have h20 := hH 2 0
      have h21 := hH 2 1
      have h22 := hH 2 2
      fun_prop
    have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
    have hP : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
      intro k l
      have hfun : (fun y => (G y)⁻¹ k l) =
          fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
        funext y
        rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
          smul_eq_mul]
      rw [hfun]
      refine (hD.inv hdet).mul (hdetD _ ?_)
      intro a b
      by_cases hal : a = l
      · subst hal
        simp only [Matrix.updateRow_self]
        exact differentiableAt_const _
      · simp only [Matrix.updateRow_ne hal]
        exact hG a b
    have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
        + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (∑ b : Fin 3, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
            + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b y => G y a b * (G y)⁻¹ b l)
          (fun b _ => (hG a b).hasFDerivAt.mul (hP b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) x := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
        filter_upwards [hev] with y hy
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    refine ⟨hP k l, ?_⟩
    let Xm : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun y => (G y)⁻¹ b l) x
    let Dm : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun y => G y a b) x
    have hM : G x * Xm = -(Dm * (G x)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [Xm, Dm, Matrix.of_apply]
      exact hE a l'
    have hX : Xm = -((G x)⁻¹ * (Dm * (G x)⁻¹)) := by
      calc Xm = ((G x)⁻¹ * G x) * Xm := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
        _ = (G x)⁻¹ * (G x * Xm) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [Xm, Dm, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  have hs1 : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det) y ∧
      partialDeriv i (fun z => Real.sqrt (G z).det) y = Real.sqrt (G y).det / 2 *
        ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv i (fun z => G z a b) y := by
    intro i
    have hfun : (fun z => (G z).det) = fun z =>
        G z 0 0 * G z 1 1 * G z 2 2 - G z 0 0 * G z 1 2 * G z 2 1
          - G z 0 1 * G z 1 0 * G z 2 2 + G z 0 1 * G z 1 2 * G z 2 0
          + G z 0 2 * G z 1 0 * G z 2 1 - G z 0 2 * G z 1 1 * G z 2 0 := by
      funext z; exact Matrix.det_fin_three (G z)
    have h00 := (hGd 0 0).hasFDerivAt
    have h01 := (hGd 0 1).hasFDerivAt
    have h02 := (hGd 0 2).hasFDerivAt
    have h10 := (hGd 1 0).hasFDerivAt
    have h11 := (hGd 1 1).hasFDerivAt
    have h12 := (hGd 1 2).hasFDerivAt
    have h20 := (hGd 2 0).hasFDerivAt
    have h21 := (hGd 2 1).hasFDerivAt
    have h22 := (hGd 2 2).hasFDerivAt
    have hD := (((((((h00.mul h11).mul h22).sub ((h00.mul h12).mul h21)).sub
      ((h01.mul h10).mul h22)).add ((h01.mul h12).mul h20)).add
      ((h02.mul h10).mul h21)).sub ((h02.mul h11).mul h20))
    have hD' : HasFDerivAt (fun z => (G z).det) _ y :=
      hD.congr_of_eventuallyEq (Filter.Eventually.of_forall fun z => congrFun hfun z)
    have hS := hD'.sqrt hdet.ne'
    refine ⟨hS.differentiableAt, ?_⟩
    unfold partialDeriv
    rw [hS.fderiv]
    have hinv : ∀ a b, (G y)⁻¹ a b = ((G y).det)⁻¹ * (G y).adjugate a b := by
      intro a b
      rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv', smul_eq_mul]
    simp only [hinv]
    have hs2 : Real.sqrt (G y).det * Real.sqrt (G y).det = (G y).det :=
      Real.mul_self_sqrt hdet.le
    have hspos : 0 < Real.sqrt (G y).det := Real.sqrt_pos.2 hdet
    have hfac : 1 / (2 * Real.sqrt (G y).det) = Real.sqrt (G y).det / 2 * ((G y).det)⁻¹ := by
      have aux : ∀ s d : ℝ, 0 < s → s * s = d → 1 / (2 * s) = s / 2 * d⁻¹ := by
        intro s d hs h
        subst h
        field_simp
      exact aux _ _ hspos hs2
    rw [hfac]
    set d := (G y).det with hd
    have f10 : fderiv ℝ (fun z => G z 1 0) y = fderiv ℝ (fun z => G z 0 1) y := by
      congr 1; funext z; exact hsymm z 1 0
    have f20 : fderiv ℝ (fun z => G z 2 0) y = fderiv ℝ (fun z => G z 0 2) y := by
      congr 1; funext z; exact hsymm z 2 0
    have f21 : fderiv ℝ (fun z => G z 2 1) y = fderiv ℝ (fun z => G z 1 2) y := by
      congr 1; funext z; exact hsymm z 2 1
    have e10 := hsymm y 1 0
    have e20 := hsymm y 2 0
    have e21 := hsymm y 2 1
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, Pi.mul_apply, Fin.sum_univ_three,
      Matrix.adjugate_fin_three, Matrix.of_apply, Matrix.cons_val', Matrix.empty_val',
      Matrix.cons_val_fin_one, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Matrix.head_fin_const, f10, f20, f21, e10, e20, e21]
    ring
  have hs2 := fun m => inv_entry y m hGd hdet.ne'
  have hdS : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det) y =
      Real.sqrt (G y).det / 2 * ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ a b * partialDeriv i (fun z => G z a b) y := fun i => (hs1 i).2
  have hdGi : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ k a * partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l :=
    fun m k l => (hs2 m k l).2
  
  have hloc : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y =
      partialDeriv i (fun z => Real.sqrt (G z).det * calUnitNormal G f z i) y := by
    intro i
    have hev : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y]
        (fun z => Real.sqrt (G z).det * calUnitNormal G f z i) :=
      Filter.eventually_of_mem hTy (fun z hz => by simp only [hX z hz i])
    unfold partialDeriv
    rw [Filter.EventuallyEq.fderiv_eq hev]
  
  have hs : DifferentiableAt ℝ (fun z => Real.sqrt (G z).det) y := (hs1 0).1
  have hGi : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ a b) y :=
    fun a b => (hs2 0 a b).1
  have hp := hpd'
  have hs3 : ∀ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * calUnitNormal G f z i) y = partialDeriv i (fun z => Real.sqrt (G z).det) y * ((Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y))⁻¹ * ∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y) + Real.sqrt (G y).det * (-((∑ a : Fin 3, ∑ b : Fin 3, (partialDeriv i (fun z => (G z)⁻¹ a b) y * partialDeriv a f y * partialDeriv b f y + (G y)⁻¹ a b * partialDeriv i (partialDeriv a f) y * partialDeriv b f y + (G y)⁻¹ a b * partialDeriv a f y * partialDeriv i (partialDeriv b f) y)) / (2 * Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y) ^ 3)) * ∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y + (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y))⁻¹ * ∑ k : Fin 3, (partialDeriv i (fun z => (G z)⁻¹ i k) y * partialDeriv k f y + (G y)⁻¹ i k * partialDeriv i (partialDeriv k f) y)) := by
    intro i
    have pd_mul : ∀ (u v : E3 → ℝ), DifferentiableAt ℝ u y → DifferentiableAt ℝ v y →
        partialDeriv i (fun z => u z * v z) y =
          partialDeriv i u y * v y + u y * partialDeriv i v y := by
      intro u v hu hv
      unfold partialDeriv
      rw [fderiv_fun_mul hu hv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have pd_sum : ∀ (u : Fin 3 → E3 → ℝ), (∀ k, DifferentiableAt ℝ (u k) y) →
        partialDeriv i (fun z => ∑ k : Fin 3, u k z) y = ∑ k : Fin 3, partialDeriv i (u k) y := by
      intro u hu
      unfold partialDeriv
      rw [fderiv_fun_sum (fun k _ => hu k)]
      simp only [ContinuousLinearMap.sum_apply]
    have pd_inv_sqrt : ∀ (Q : E3 → ℝ), DifferentiableAt ℝ Q y → 0 < Q y →
        DifferentiableAt ℝ (fun z => (Real.sqrt (Q z))⁻¹) y ∧
        partialDeriv i (fun z => (Real.sqrt (Q z))⁻¹) y =
          -(partialDeriv i Q y) / (2 * Real.sqrt (Q y) ^ 3) := by
      intro Q hQ hpos
      have hr : Real.sqrt (Q y) ≠ 0 := (Real.sqrt_pos.2 hpos).ne'
      have h1 : HasFDerivAt (fun z => Real.sqrt (Q z))
          ((1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y) y := hQ.hasFDerivAt.sqrt hpos.ne'
      have h2 : HasFDerivAt (fun z => (Real.sqrt (Q z))⁻¹)
          ((-(Real.sqrt (Q y) ^ 2)⁻¹) • ((1 / (2 * Real.sqrt (Q y))) • fderiv ℝ Q y)) y :=
        (hasDerivAt_inv hr).comp_hasFDerivAt y h1
      refine ⟨h2.differentiableAt, ?_⟩
      unfold partialDeriv
      rw [h2.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      field_simp
    have h2d : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ a b * partialDeriv a f z) y :=
      fun a b => (hGi a b).mul (hp a)
    have h3d : ∀ a b : Fin 3, DifferentiableAt ℝ
        (fun z => (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) y :=
      fun a b => (h2d a b).mul (hp b)
    have hQb : ∀ a : Fin 3, DifferentiableAt ℝ
        (fun z => ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) y :=
      fun a => DifferentiableAt.fun_sum (fun b _ => h3d a b)
    have hQd : DifferentiableAt ℝ
        (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
          (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) y :=
      DifferentiableAt.fun_sum (fun a _ => hQb a)
    have hUk : ∀ k : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ i k * partialDeriv k f z) y :=
      fun k => (hGi i k).mul (hp k)
    have hUd : DifferentiableAt ℝ (fun z => ∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) y :=
      DifferentiableAt.fun_sum (fun k _ => hUk k)
    obtain ⟨hRd, hRpd⟩ := pd_inv_sqrt _ hQd hN
    have hcald : DifferentiableAt ℝ (fun z => calUnitNormal G f z i) y := hRd.mul hUd
    have hQpd : partialDeriv i
        (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
          (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) y =
        ∑ a : Fin 3, ∑ b : Fin 3, (partialDeriv i (fun z => (G z)⁻¹ a b) y * partialDeriv a f y *
          partialDeriv b f y + (G y)⁻¹ a b * partialDeriv i (partialDeriv a f) y *
            partialDeriv b f y +
          (G y)⁻¹ a b * partialDeriv a f y * partialDeriv i (partialDeriv b f) y) := by
      rw [pd_sum _ hQb]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [pd_sum _ (h3d a)]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [pd_mul _ (partialDeriv b f) (h2d a b) (hp b),
        pd_mul _ (partialDeriv a f) (hGi a b) (hp a)]
      ring
    have hUpd : partialDeriv i (fun z => ∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) y =
        ∑ k : Fin 3, (partialDeriv i (fun z => (G z)⁻¹ i k) y * partialDeriv k f y +
          (G y)⁻¹ i k * partialDeriv i (partialDeriv k f) y) := by
      rw [pd_sum _ hUk]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [pd_mul _ (partialDeriv k f) (hGi i k) (hp k)]
    have hcalpd : partialDeriv i (fun z => calUnitNormal G f z i) y =
        partialDeriv i (fun z => (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3,
            (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z))⁻¹) y *
          ∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y +
        (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3,
            (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y))⁻¹ *
          partialDeriv i (fun z => ∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) y :=
      pd_mul _ _ hRd hUd
    rw [pd_mul _ _ hs hcald, hcalpd, hRpd, hQpd, hUpd]
    simp only [calUnitNormal]
    all_goals ring
  
  have e10 := hsymI 1 0
  have e20 := hsymI 2 0
  have e21 := hsymI 2 1
  have hA1 : ∑ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det) y *
        ∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y +
      Real.sqrt (G y).det * ∑ i : Fin 3, ∑ k : Fin 3,
        partialDeriv i (fun z => (G z)⁻¹ i k) y * partialDeriv k f y =
      -(Real.sqrt (G y).det * ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f y) := by
    simp only [hdS, hdGi, christoffel, Fin.sum_univ_three, e10, e20, e21]
    ring
  have hA2 : ∑ i : Fin 3, (∑ k : Fin 3, (G y)⁻¹ i k * partialDeriv k f y) *
        ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun z => (G z)⁻¹ a b) y * partialDeriv a f y * partialDeriv b f y =
      -2 * ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ i a * partialDeriv a f y * ((G y)⁻¹ j b * partialDeriv b f y) *
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f y := by
    simp only [hdGi, christoffel, Fin.sum_univ_three, e10, e20, e21]
    ring
  
  unfold sepDensDiv
  rw [Finset.sum_congr rfl (fun i _ => (hloc i).trans (hs3 i))]
  exact key (G y)⁻¹ (fun i => partialDeriv i (fun z => Real.sqrt (G z).det) y)
    (fun i a b => partialDeriv i (fun z => (G z)⁻¹ a b) y)
    (fun i j => ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f y)
    (fun a => partialDeriv a f y) (fun i a => partialDeriv i (partialDeriv a f) y)
    (Real.sqrt (G y).det)
    (Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a f y * partialDeriv b f y))
    hsymI hA1 hA2

theorem ccs_normal_props (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (T : Set E3) (hT : IsOpen T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) T) (hpd : ∀ z ∈ T, (G z).PosDef) (hf : ContDiffOn ℝ ∞ f T) (X : E3 → E3) (hX : ∀ z ∈ T, ∀ i : Fin 3, X z i = calUnitNormal G f z i) : IsOpen {z : E3 | z ∈ T ∧ 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} ∧ ContDiffOn ℝ ∞ X {z : E3 | z ∈ T ∧ 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} ∧ ∀ z ∈ T, 0 < ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z → ∀ w : E3, ∑ a : Fin 3, ∑ b : Fin 3, G z a b * w a * w b ≤ 1 → |fderiv ℝ f z w| ≤ fderiv ℝ f z (X z) :=
by
  
  have hdet : ∀ z ∈ T, (G z).det ≠ 0 := fun z hz => (hpd z hz).det_pos.ne'
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) T := by
    intro i j
    have hd : ContDiffOn ℝ ∞ (fun z => (G z).det) T := by
      simp only [Matrix.det_fin_three]
      have := hG
      fun_prop
    have hadj : ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) T := by
      simp only [Matrix.adjugate_fin_three]
      fin_cases i <;> fin_cases j <;> simp <;> fun_prop
    have heq : (fun z => (G z)⁻¹ i j) = fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hd.inv hdet).mul hadj
  
  have hpf : ∀ k : Fin 3, ContDiffOn ℝ ∞ (fun z => partialDeriv k f z) T := by
    intro k
    have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hT).mp hf).2
    exact h1.clm_apply contDiffOn_const
  have hN : ContDiffOn ℝ ∞ (fun z => ∑ a : Fin 3, ∑ b : Fin 3,
      (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) T := by
    refine ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun b _ => ?_))
    exact ((hinv a b).mul (hpf a)).mul (hpf b)
  
  have key : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → ∀ (ξ w : Fin 3 → ℝ),
      0 < ∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ a b * ξ a * ξ b →
      ∑ a : Fin 3, ∑ b : Fin 3, A a b * w a * w b ≤ 1 →
      |∑ a : Fin 3, ξ a * w a| ≤ Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ a b * ξ a * ξ b) := by
    intro A hA ξ w hNA hw
    set N := ∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ a b * ξ a * ξ b with hNdef
    set s := Real.sqrt N with hs
    have hs0 : 0 < s := Real.sqrt_pos.mpr hNA
    have hss : s * s = N := Real.mul_self_sqrt hNA.le
    set u := Matrix.mulVec A⁻¹ ξ with hu
    have hAu : Matrix.mulVec A u = ξ := by
      rw [hu, Matrix.mulVec_mulVec,
        Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hA.det_pos.ne'), Matrix.one_mulVec]
    have hsym : Matrix.transpose A = A := by
      have h := hA.isHermitian
      rw [Matrix.IsHermitian, Matrix.conjTranspose_eq_transpose_of_trivial] at h
      exact h
    have huA : Matrix.vecMul u A = ξ := by
      rw [← Matrix.mulVec_transpose, hsym, hAu]
    have e2 : dotProduct u (Matrix.mulVec A w) = dotProduct ξ w := by
      rw [Matrix.dotProduct_mulVec, huA]
    have huξ : dotProduct u ξ = N := by
      simp only [hu, hNdef, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
      ring
    have hQ : dotProduct w (Matrix.mulVec A w) = ∑ a : Fin 3, ∑ b : Fin 3, A a b * w a * w b := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
      ring
    have hD : dotProduct ξ w = ∑ a : Fin 3, ξ a * w a := rfl
    have hquad : ∀ t : ℝ,
        0 ≤ N - 2 * t * (dotProduct ξ w) + t ^ 2 * (dotProduct w (Matrix.mulVec A w)) := by
      intro t
      have h0 := hA.posSemidef.dotProduct_mulVec_nonneg (u - t • w)
      rw [star_trivial] at h0
      have e1 : dotProduct (u - t • w) (Matrix.mulVec A (u - t • w)) =
          N - 2 * t * (dotProduct ξ w) + t ^ 2 * (dotProduct w (Matrix.mulVec A w)) := by
        simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, hAu, sub_dotProduct, dotProduct_sub,
          smul_dotProduct, dotProduct_smul, smul_eq_mul, e2, dotProduct_comm w ξ, huξ]
        ring
      rw [← e1]
      exact h0
    rw [← hD]
    have h1 := hquad s
    have h2 := hquad (-s)
    rw [hQ] at h1 h2
    have h3 := mul_nonneg (sq_nonneg s) (sub_nonneg.mpr hw)
    rw [abs_le]
    constructor <;> nlinarith
  
  have hexp : ∀ (z v : E3), fderiv ℝ f z v = ∑ a : Fin 3, partialDeriv a f z * v a := by
    intro z v
    have hv : v = ∑ a : Fin 3, v a • e a := by
      ext i
      fin_cases i <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul, partialDeriv]
    exact Finset.sum_congr rfl (fun a _ => mul_comm _ _)
  refine ⟨?_, ?_, ?_⟩
  · exact hN.continuousOn.isOpen_inter_preimage hT isOpen_Ioi
  · have hS : {z : E3 | z ∈ T ∧ 0 < ∑ a : Fin 3, ∑ b : Fin 3,
        (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} ⊆ T := fun z hz => hz.1
    rw [contDiffOn_piLp]
    intro i
    have h1 : ContDiffOn ℝ ∞ (fun z => calUnitNormal G f z i) {z : E3 | z ∈ T ∧ 0 <
        ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z} := by
      unfold calUnitNormal
      refine ContDiffOn.mul ?_ ?_
      · refine ContDiffOn.inv ?_ ?_
        · exact (hN.mono hS).sqrt (fun z hz => hz.2.ne')
        · intro z hz
          exact (Real.sqrt_pos.mpr hz.2).ne'
      · exact (ContDiffOn.sum (fun k _ => (hinv i k).mul (hpf k))).mono hS
    exact h1.congr (fun z hz => hX z hz.1 i)
  · intro z hz hNz w hw
    have hRHS : fderiv ℝ f z (X z) = Real.sqrt (∑ a : Fin 3, ∑ b : Fin 3,
        (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z) := by
      rw [hexp]
      have hXz : ∀ i, X z i = calUnitNormal G f z i := hX z hz
      simp only [hXz, calUnitNormal]
      set N := ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ a b * partialDeriv a f z * partialDeriv b f z
        with hNdef
      have hss : Real.sqrt N * Real.sqrt N = N := Real.mul_self_sqrt hNz.le
      have hs0 : Real.sqrt N ≠ 0 := (Real.sqrt_pos.mpr hNz).ne'
      have hsum : ∑ i : Fin 3, partialDeriv i f z * ((Real.sqrt N)⁻¹ *
          ∑ k : Fin 3, (G z)⁻¹ i k * partialDeriv k f z) = (Real.sqrt N)⁻¹ * N := by
        rw [hNdef]
        simp only [Fin.sum_univ_three]
        ring
      rw [hsum]
      calc (Real.sqrt N)⁻¹ * N = (Real.sqrt N)⁻¹ * (Real.sqrt N * Real.sqrt N) := by rw [hss]
        _ = Real.sqrt N := inv_mul_cancel_left₀ hs0 _
    rw [hRHS, hexp z w]
    exact key (G z) (hpd z hz) (fun a => partialDeriv a f z) (fun a => w a) hNz hw

theorem ccs_rep_norm [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (V : M → E3) (p : M) (y : E3) (hy : y ∈ (chartAt E3 p).target) (w : E3) (hw : w = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y))) : ∑ a : Fin 3, ∑ b : Fin 3, g.coeff (chartAt E3 p).symm y a b * w a * w b = g.g ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) (V ((chartAt E3 p).symm y)) :=
by
  have hx : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
  have hxy : (chartAt E3 p) ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hy
  have h0 := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) p).symm_comp_deriv hx
  rw [hxy] at h0
  have hDL : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) v) = v := by
    intro v
    have := congrArg (fun T => T v) h0
    simpa using this
  have hR : g.g ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) (V ((chartAt E3 p).symm y))
      = g.g ((chartAt E3 p).symm y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) := by
    rw [hw, hDL]
  have hwexp : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
    ext j
    fin_cases j <;> simp [e, EuclideanSpace.single_apply]
  rw [hR]
  conv_rhs => rw [hwexp]
  simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    smul_eq_mul, Fin.sum_univ_three, RiemannianMetric3.coeff, coeffMatrix]
  ring

theorem cal_chart_step [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (ρ : M → ℝ) (r₁ η : ℝ) (A F : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ)
    (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) (hF : sepChartMeas F) (hη : 0 < η)
    (p : M) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ) (hφ0 : ∀ x, 0 ≤ φ x)
    (hφc : IsCompact (tsupport φ)) (hφp : tsupport φ ⊆ (chartAt E3 p).source)
    (Y V Z : M → E3) (hY : calSmoothField Y) (hY1 : ∀ x, g.g x (Y x) (Y x) ≤ 1)
    (hVZ : ∀ y ∈ (chartAt E3 p).target, ∀ wV wY wZ : E3,
        wV = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
          (V ((chartAt E3 p).symm y)) →
        wY = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
          (Y ((chartAt E3 p).symm y)) →
        wZ = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
          (Z ((chartAt E3 p).symm y)) →
        ∀ i : Fin 3,
          wV i = (1 - calTheta r₁ η (ρ ((chartAt E3 p).symm y))) * wY i +
            calSigma ρ r₁ A ((chartAt E3 p).symm y) * calTheta r₁ η (ρ ((chartAt E3 p).symm y)) *
              calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) y i ∧
          wZ i = calTheta r₁ η (ρ ((chartAt E3 p).symm y)) *
              calUnitNormal (g.coeff (chartAt E3 p).symm) (fun z => ρ ((chartAt E3 p).symm z)) y i) :
    IntegrableOn (fun y => φ ((chartAt E3 p).symm y) * g.levelMeanCurv ρ ((chartAt E3 p).symm y) *
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
      (chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source)) ∧
    IntegrableOn (fun y => calSigma ρ r₁ A ((chartAt E3 p).symm y) *
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y)
      (chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source)) ∧
    (∫ y in chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source),
        calTheta r₁ η (ρ ((chartAt E3 p).symm y)) *
          (φ ((chartAt E3 p).symm y) * g.levelMeanCurv ρ ((chartAt E3 p).symm y) *
            Real.sqrt (g.coeff (chartAt E3 p).symm y).det)) +
      (∫ y in chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source),
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
          fderiv ℝ (fun z => φ ((chartAt E3 p).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
              (Z ((chartAt E3 p).symm y)) : E3)) +
      ((∫ y in chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source),
          calSigma ρ r₁ A ((chartAt E3 p).symm y) *
            sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y) -
        ∫ y in chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source),
          calTheta r₁ η (ρ ((chartAt E3 p).symm y)) *
            (calSigma ρ r₁ A ((chartAt E3 p).symm y) *
              sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y)) ≤
    (∫ y in chartAt E3 p '' (F ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y) -
      ∫ y in chartAt E3 p '' (((F \ {x : M | r₁ < ρ x}) ∪ A) ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ Y) y :=
by
  classical
  
  have hT : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 p).symm z i j)
      (chartAt E3 p).target := fun i j => g.smooth p i j
  have hpd : ∀ z ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm z).PosDef :=
    fun z hz => coeff_chart_symm_posDef g p z hz
  have hdet : ∀ z ∈ (chartAt E3 p).target, 0 < (g.coeff (chartAt E3 p).symm z).det :=
    fun z hz => (hpd z hz).det_pos
  have hsymm : ∀ (z : E3) (i j : Fin 3),
      g.coeff (chartAt E3 p).symm z i j = g.coeff (chartAt E3 p).symm z j i :=
    fun z i j => g.symm _ _ _
  have hcomp : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
    intro u hu
    exact contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hf : ContDiffOn ℝ ∞ (fun y => ρ ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    hcomp ρ hρ
  have hψ : ContDiffOn ℝ ∞ (fun y => φ ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    hcomp φ hφ
  have hψ0 : ∀ z ∈ (chartAt E3 p).target, 0 ≤ (fun y => φ ((chartAt E3 p).symm y)) z :=
    fun z _ => hφ0 _
  have hC : IsCompact (chartAt E3 p '' tsupport φ) :=
    hφc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hφp)
  have hCT : chartAt E3 p '' tsupport φ ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source (hφp hx)
  have hψC : ∀ z ∈ (chartAt E3 p).target, z ∉ chartAt E3 p '' tsupport φ →
      (fun y => φ ((chartAt E3 p).symm y)) z = 0 := by
    intro z hz hzC
    by_contra hne
    exact hzC ⟨(chartAt E3 p).symm z, subset_tsupport _ (Function.mem_support.mpr hne),
      (chartAt E3 p).right_inv hz⟩
  
  have hlmc : ∀ z ∈ (chartAt E3 p).target,
      levelMeanCurvCoord (g.coeff (chartAt E3 p).symm) (fun y => ρ ((chartAt E3 p).symm y)) z =
        g.levelMeanCurv ρ ((chartAt E3 p).symm z) := by
    intro z hz
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have h := levelMeanCurv_eq_coord g Φ ρ (fun y => ρ ((chartAt E3 p).symm y)) hρ z hz
      (Filter.Eventually.of_forall fun _ => rfl)
    exact h.symm
  have hN : ∀ z ∈ (chartAt E3 p).target, r₁ ≤ ρ ((chartAt E3 p).symm z) →
      0 < ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (chartAt E3 p).symm z)⁻¹ a b *
        partialDeriv a (fun y => ρ ((chartAt E3 p).symm y)) z *
        partialDeriv b (fun y => ρ ((chartAt E3 p).symm y)) z := by
    intro z hz hfz
    have hH := hmc ((chartAt E3 p).symm z) hfz
    by_contra hle
    push_neg at hle
    have hs := Real.sqrt_eq_zero'.mpr hle
    have h0 : levelMeanCurvCoord (g.coeff (chartAt E3 p).symm)
        (fun y => ρ ((chartAt E3 p).symm y)) z = 0 := by
      rw [levelMeanCurvCoord, hs]
      simp
    rw [hlmc z hz] at h0
    linarith
  
  have hnp := ccs_normal_props (g.coeff (chartAt E3 p).symm) (fun y => ρ ((chartAt E3 p).symm y))
    (chartAt E3 p).target hT hG hpd hf
    (fun y => WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
      (fun z => ρ ((chartAt E3 p).symm z)) y i)) (fun _ _ _ => rfl)
  have hT'f : ∀ z ∈ (chartAt E3 p).target, r₁ ≤ ρ ((chartAt E3 p).symm z) →
      z ∈ {z : E3 | z ∈ (chartAt E3 p).target ∧ 0 < ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 p).symm z)⁻¹ a b *
        partialDeriv a (fun y => ρ ((chartAt E3 p).symm y)) z *
        partialDeriv b (fun y => ρ ((chartAt E3 p).symm y)) z} :=
    fun z hz h => ⟨hz, hN z hz h⟩
  
  have hCS : ∀ z ∈ (chartAt E3 p).target, r₁ < ρ ((chartAt E3 p).symm z) →
      |fderiv ℝ (fun y => ρ ((chartAt E3 p).symm y)) z
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z)
          (Y ((chartAt E3 p).symm z)) : E3)| ≤
      fderiv ℝ (fun y => ρ ((chartAt E3 p).symm y)) z
        (WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
          (fun z => ρ ((chartAt E3 p).symm z)) z i)) := by
    intro z hz hfz
    refine hnp.2.2 z hz (hN z hz hfz.le) _ ?_
    rw [ccs_rep_norm g Y p z hz _ rfl]
    exact hY1 _
  
  have himg : ∀ S : Set M, chartAt E3 p '' (S ∩ (chartAt E3 p).source) =
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' S := by
    intro S
    rw [Set.inter_comm]
    exact (chartAt E3 p).image_source_inter_eq' S
  have hAo' : IsOpen (chartAt E3 p '' (A ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source (hAo.inter (chartAt E3 p).open_source)
      Set.inter_subset_right
  have hAsub' : chartAt E3 p '' (A ∩ (chartAt E3 p).source) ⊆
      {z : E3 | z ∈ (chartAt E3 p).target ∧ r₁ < ρ ((chartAt E3 p).symm z)} := by
    rintro _ ⟨x, ⟨hxA, hxs⟩, rfl⟩
    refine ⟨(chartAt E3 p).map_source hxs, ?_⟩
    show r₁ < ρ ((chartAt E3 p).symm (chartAt E3 p x))
    rw [(chartAt E3 p).left_inv hxs]
    exact hAsub hxA
  have hBe : {z : E3 | z ∈ (chartAt E3 p).target ∧ r₁ < ρ ((chartAt E3 p).symm z)} \
      chartAt E3 p '' (A ∩ (chartAt E3 p).source) =
      (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' ({x : M | r₁ < ρ x} \ A) := by
    rw [himg A]
    ext z
    simp only [Set.mem_diff, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage]
    tauto
  have hBo' : IsOpen ({z : E3 | z ∈ (chartAt E3 p).target ∧ r₁ < ρ ((chartAt E3 p).symm z)} \
      chartAt E3 p '' (A ∩ (chartAt E3 p).source)) := by
    rw [hBe]
    exact (chartAt E3 p).isOpen_inter_preimage_symm hBo
  have hFT : chartAt E3 p '' (F ∩ (chartAt E3 p).source) ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, ⟨_, hxs⟩, rfl⟩
    exact (chartAt E3 p).map_source hxs
  have hsig : ∀ z ∈ (chartAt E3 p).target, calSigma ρ r₁ A ((chartAt E3 p).symm z) =
      ({z : E3 | z ∈ (chartAt E3 p).target ∧ r₁ < ρ ((chartAt E3 p).symm z)} \
        chartAt E3 p '' (A ∩ (chartAt E3 p).source)).indicator (fun _ => (1 : ℝ)) z -
      (chartAt E3 p '' (A ∩ (chartAt E3 p).source)).indicator (fun _ => (1 : ℝ)) z := by
    intro z hz
    have hA : z ∈ chartAt E3 p '' (A ∩ (chartAt E3 p).source) ↔ (chartAt E3 p).symm z ∈ A := by
      rw [himg A]
      exact ⟨fun h => h.2, fun h => ⟨hz, h⟩⟩
    have hB : z ∈ {z : E3 | z ∈ (chartAt E3 p).target ∧ r₁ < ρ ((chartAt E3 p).symm z)} \
        chartAt E3 p '' (A ∩ (chartAt E3 p).source) ↔
        (chartAt E3 p).symm z ∈ {x : M | r₁ < ρ x} \ A := by
      rw [hBe]
      exact ⟨fun h => h.2, fun h => ⟨hz, h⟩⟩
    unfold calSigma
    by_cases h1 : (chartAt E3 p).symm z ∈ A
    · have h2 : (chartAt E3 p).symm z ∉ {x : M | r₁ < ρ x} \ A := fun h => h.2 h1
      rw [Set.indicator_of_mem h1, Set.indicator_of_notMem h2, Set.indicator_of_mem (hA.2 h1),
        Set.indicator_of_notMem (fun h => h2 (hB.1 h))]
    · rw [Set.indicator_of_notMem h1, Set.indicator_of_notMem (fun h => h1 (hA.1 h))]
      by_cases h3 : (chartAt E3 p).symm z ∈ {x : M | r₁ < ρ x} \ A
      · rw [Set.indicator_of_mem h3, Set.indicator_of_mem (hB.2 h3)]
      · rw [Set.indicator_of_notMem h3, Set.indicator_of_notMem (fun h => h3 (hB.1 h))]
  
  have hW₀o : ∀ z, z ∉ (chartAt E3 p).target → calPiece p φ Y z = 0 :=
    fun z hz => Set.indicator_of_notMem hz _
  have hW₁o : ∀ z, z ∉ (chartAt E3 p).target → calPiece p φ V z = 0 :=
    fun z hz => Set.indicator_of_notMem hz _
  have hW₀ : ∀ z ∈ (chartAt E3 p).target, ∀ i : Fin 3, calPiece p φ Y z i =
      (fun y => φ ((chartAt E3 p).symm y)) z *
        (id (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z)
          (Y ((chartAt E3 p).symm z))) : E3) i := by
    intro z hz i
    rw [calPiece, Set.indicator_of_mem hz, PiLp.smul_apply, smul_eq_mul] <;> rfl
  have hW₁ : ∀ z ∈ (chartAt E3 p).target, ∀ i : Fin 3, calPiece p φ V z i =
      (fun y => φ ((chartAt E3 p).symm y)) z *
        ((1 - calTheta r₁ η (ρ ((chartAt E3 p).symm z))) *
          (id (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z)
            (Y ((chartAt E3 p).symm z))) : E3) i +
          calSigma ρ r₁ A ((chartAt E3 p).symm z) * calTheta r₁ η (ρ ((chartAt E3 p).symm z)) *
            (WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
              (fun z => ρ ((chartAt E3 p).symm z)) z i) : E3) i) := by
    intro z hz i
    rw [calPiece, Set.indicator_of_mem hz, PiLp.smul_apply, smul_eq_mul,
      (hVZ z hz _ _ _ rfl rfl rfl i).1] <;> rfl
  have hZt : ∀ z ∈ (chartAt E3 p).target, ∀ i : Fin 3,
      (id (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm z)
          (Z ((chartAt E3 p).symm z))) : E3) i =
        calTheta r₁ η (ρ ((chartAt E3 p).symm z)) *
          (WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
            (fun z => ρ ((chartAt E3 p).symm z)) z i) : E3) i :=
    fun z hz i => (hVZ z hz _ _ _ rfl rfl rfl i).2
  
  have hd : ∀ z ∈ (chartAt E3 p).target, r₁ < ρ ((chartAt E3 p).symm z) →
      φ ((chartAt E3 p).symm z) * g.levelMeanCurv ρ ((chartAt E3 p).symm z) *
          Real.sqrt (g.coeff (chartAt E3 p).symm z).det =
        φ ((chartAt E3 p).symm z) * sepDensDiv (g.coeff (chartAt E3 p).symm)
          (fun y => WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
            (fun z => ρ ((chartAt E3 p).symm z)) y i)) z := by
    intro z hz hfz
    rw [ccs_divx (g.coeff (chartAt E3 p).symm) (fun y => ρ ((chartAt E3 p).symm y))
      (chartAt E3 p).target hT hG hsymm hpd hf _ (fun _ _ _ => rfl) z hz (hN z hz hfz.le),
      hlmc z hz]
    ring
  
  have hS : chartAt E3 p '' ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 p).source) =
      symmDiff (chartAt E3 p '' (F ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (A ∩ (chartAt E3 p).source)) ∩
        {z : E3 | r₁ < ρ ((chartAt E3 p).symm z)} := by
    rw [himg (symmDiff F A ∩ {x : M | r₁ < ρ x}), himg F, himg A]
    ext z
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff, Set.mem_setOf_eq]
    tauto
  have hTF : chartAt E3 p '' (((F \ {x : M | r₁ < ρ x}) ∪ A) ∩ (chartAt E3 p).source) =
      (chartAt E3 p '' (F ∩ (chartAt E3 p).source) \ {z : E3 | r₁ < ρ ((chartAt E3 p).symm z)}) ∪
        chartAt E3 p '' (A ∩ (chartAt E3 p).source) := by
    rw [himg ((F \ {x : M | r₁ < ρ x}) ∪ A), himg F, himg A]
    ext z
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff,
      Set.mem_setOf_eq]
    tauto
  
  have key := ccs_euclid_calib (g.coeff (chartAt E3 p).symm) (chartAt E3 p).target
    {z : E3 | z ∈ (chartAt E3 p).target ∧ 0 < ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 p).symm z)⁻¹ a b *
        partialDeriv a (fun y => ρ ((chartAt E3 p).symm y)) z *
        partialDeriv b (fun y => ρ ((chartAt E3 p).symm y)) z}
    (chartAt E3 p '' tsupport φ) (chartAt E3 p '' (F ∩ (chartAt E3 p).source))
    (chartAt E3 p '' (A ∩ (chartAt E3 p).source))
    (fun y => ρ ((chartAt E3 p).symm y)) (fun y => φ ((chartAt E3 p).symm y))
    (fun y => φ ((chartAt E3 p).symm y) * g.levelMeanCurv ρ ((chartAt E3 p).symm y) *
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
    (fun y => calSigma ρ r₁ A ((chartAt E3 p).symm y))
    (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
      (Y ((chartAt E3 p).symm y)) : E3))
    (fun y => WithLp.toLp 2 (fun i => calUnitNormal (g.coeff (chartAt E3 p).symm)
      (fun z => ρ ((chartAt E3 p).symm z)) y i))
    (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
      (Z ((chartAt E3 p).symm y)) : E3))
    (calPiece p φ Y) (calPiece p φ V) r₁ η hT hG hdet hf hη hψ hψ0 hC hCT hψC hnp.1
    (fun z hz => hz.1) hT'f (hY p) hnp.2.1 hCS hAo' hAsub' hBo' (hF p) hFT hsig hW₀o hW₀ hW₁o
    hW₁ hZt hd
  rw [hS, hTF]
  exact key

theorem cal_partition_div_cancel [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω : Set M) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (O : Set M) (hO : IsOpen O) (hφ1 : ∀ x ∈ O, ∑ j, φ j x = 1) (Z : M → E3) (hZ : calSmoothField Z) (E : Set M) (hE : sepChartMeas E) (hEO : E ⊆ O) : ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det * fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y) (Z ((chartAt E3 (q j)).symm y)) : E3) = 0 :=
by
  classical
  
  have hφs : ∀ j, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (φ j) := hφ.1
  have hφc : ∀ j, IsCompact (tsupport (φ j)) := fun j => (hφ.2.2.2 j).1
  have hφt : ∀ j, tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
    fun j => (hφ.2.2.2 j).2.trans Set.inter_subset_right
  
  obtain ⟨D, hD⟩ : ∃ D : Fin n → M → ℝ,
      D = fun j x => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (φ j) x (Z x) := ⟨_, rfl⟩
  
  have hrep : ∀ (p : M) (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
    fun p u hu => contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hrepd : ∀ (p : M) (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ∀ y ∈ (chartAt E3 p).target, DifferentiableAt ℝ (fun z => u ((chartAt E3 p).symm z)) y :=
    fun p u hu y hy => ((hrep p u hu).differentiableOn (by simp)).differentiableAt
      ((chartAt E3 p).open_target.mem_nhds hy)
  
  have hdir : ∀ (p : M) (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ∀ y ∈ (chartAt E3 p).target, ∀ v : E3,
      fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) v : E3) =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm y) v : ℝ) := by
    intro p u hu y hy v
    have hxp : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hcpx : chartAt E3 p ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hy
    have hcp : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hxp
    have hψm : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => u ((chartAt E3 p).symm z))
        (chartAt E3 p ((chartAt E3 p).symm y)) := by
      rw [hcpx]
      exact (hrepd p u hu y hy).mdifferentiableAt
    have hev : u =ᶠ[𝓝 ((chartAt E3 p).symm y)]
        (fun z => u ((chartAt E3 p).symm z)) ∘ chartAt E3 p := by
      filter_upwards [(chartAt E3 p).open_source.mem_nhds hxp] with w hw
      simp only [Function.comp_apply, (chartAt E3 p).left_inv hw]
    have h1 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 p).symm y) =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ((fun z => u ((chartAt E3 p).symm z)) ∘ chartAt E3 p)
          ((chartAt E3 p).symm y) := hev.mfderiv_eq
    have h2 := mfderiv_comp ((chartAt E3 p).symm y) hψm hcp
    have h3 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (fun z => u ((chartAt E3 p).symm z))
        (chartAt E3 p ((chartAt E3 p).symm y)) =
        fderiv ℝ (fun z => u ((chartAt E3 p).symm z)) y := by
      rw [hcpx, mfderiv_eq_fderiv]
    rw [h1, h2, h3]
    rfl
  have hF5 : ∀ (j : Fin n) (p : M), ∀ y ∈ (chartAt E3 p).target,
      fderiv ℝ (fun z => φ j ((chartAt E3 p).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
            (Z ((chartAt E3 p).symm y)) : E3) = D j ((chartAt E3 p).symm y) := by
    intro j p y hy
    rw [hD]
    exact hdir p (φ j) (hφs j) y hy _
  
  have hF4 : ∀ j x, x ∉ tsupport (φ j) → D j x = 0 := by
    intro j x hx
    have h := notMem_tsupport_iff_eventuallyEq.mp hx
    have h0 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (φ j) x = 0 := by
      rw [h.mfderiv_eq]
      exact mfderiv_const
    rw [hD]
    show mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (φ j) x (Z x) = 0
    rw [h0]
    rfl
  
  have hsum0 : ∀ (p : M) (z : E3), z ∈ (chartAt E3 p).target → (chartAt E3 p).symm z ∈ O →
      ∑ j, fderiv ℝ (fun w => φ j ((chartAt E3 p).symm w)) z = 0 := by
    intro p z hz hzO
    rw [← fderiv_sum (fun j _ => hrepd p (φ j) (hφs j) z hz)]
    have hfs : (∑ j, fun w => φ j ((chartAt E3 p).symm w)) =
        fun w => ∑ j, φ j ((chartAt E3 p).symm w) := by
      ext w
      simp [Finset.sum_apply]
    have hev : (fun w => ∑ j, φ j ((chartAt E3 p).symm w)) =ᶠ[𝓝 z] fun _ => (1 : ℝ) := by
      filter_upwards [((chartAt E3 p).isOpen_inter_preimage_symm hO).mem_nhds ⟨hz, hzO⟩]
        with w hw
      exact hφ1 _ hw.2
    rw [hfs, hev.fderiv_eq]
    simp
  
  have hcont : ∀ (p : M) (a b : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ a →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ b →
      ContinuousOn (fun y => b ((chartAt E3 p).symm y) *
        fderiv ℝ (fun z => a ((chartAt E3 p).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
            (Z ((chartAt E3 p).symm y)) : E3) *
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det) (chartAt E3 p).target := by
    intro p a b ha hb
    have h1 : ContinuousOn (fun y => b ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
      hb.continuous.comp_continuousOn (chartAt E3 p).continuousOn_symm
    have h2 : ContinuousOn (fun y => fderiv ℝ (fun z => a ((chartAt E3 p).symm z)) y)
        (chartAt E3 p).target :=
      (hrep p a ha).continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)
    have h3 := (hZ p).continuousOn
    have h4 : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
        (chartAt E3 p).target := by
      have hm : ContinuousOn (fun y => g.coeff (chartAt E3 p).symm y) (chartAt E3 p).target :=
        continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => (g.smooth p i j).continuousOn
      exact Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hm)
    exact (h1.mul (h2.clm_apply h3)).mul h4
  
  have hint : ∀ (p : M) (F : E3 → ℝ) (K : Set M), IsCompact K → K ⊆ (chartAt E3 p).source →
      ContinuousOn F (chartAt E3 p).target →
      (∀ y ∈ (chartAt E3 p).target, (chartAt E3 p).symm y ∉ K → F y = 0) →
      IntegrableOn F (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) := by
    intro p F K hK hKs hF hF0
    have hKc : IsCompact (chartAt E3 p '' K) :=
      hK.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hKs)
    have hKt : chartAt E3 p '' K ⊆ (chartAt E3 p).target := by
      rintro _ ⟨x, hx, rfl⟩
      exact (chartAt E3 p).map_source (hKs hx)
    refine ((hF.mono hKt).integrableOn_compact hKc).of_forall_diff_eq_zero (hE p) ?_
    rintro y ⟨⟨x, ⟨-, hxs⟩, rfl⟩, hy⟩
    refine hF0 _ ((chartAt E3 p).map_source hxs) ?_
    intro hK'
    exact hy ⟨_, hK', (chartAt E3 p).right_inv ((chartAt E3 p).map_source hxs)⟩
  
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    ext k
    simp [EuclideanSpace.single_apply, Pi.single_apply]
  have cca : ∀ (Φ : E3 → M) (τ : E3 → E3) (y : E3), DifferentiableAt ℝ τ y →
      MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y) → ∀ i j : Fin 3,
      g.coeff (Φ ∘ τ) y i j = ∑ a : Fin 3, ∑ b : Fin 3,
        fderiv ℝ τ y (e i) a * g.coeff Φ (τ y) a b * fderiv ℝ τ y (e j) b := by
    intro Φ τ y hτ hΦ i j
    set L : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y) with hLdef
    set B : E3 →L[ℝ] E3 →L[ℝ] ℝ := g.g (Φ (τ y)) with hBdef
    have hL : ∀ v : E3, L v = ∑ a : Fin 3, v a • L (e a) := by
      intro v
      conv_lhs => rw [hexp v]
      rw [map_sum]
      simp only [map_smul]
    have hchain : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y v = L (fderiv ℝ τ y v) := by
      intro v
      rw [mfderiv_comp_apply y hΦ hτ.mdifferentiableAt, mfderiv_eq_fderiv]
      rfl
    have hlhs : g.coeff (Φ ∘ τ) y i j = B (L (fderiv ℝ τ y (e i))) (L (fderiv ℝ τ y (e j))) := by
      show g.g (Φ (τ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e j)) = _
      rw [hchain, hchain]
    have hc : ∀ a b : Fin 3, g.coeff Φ (τ y) a b = B (L (e a)) (L (e b)) := fun a b => rfl
    rw [hlhs, hL (fderiv ℝ τ y (e i)), hL (fderiv ℝ τ y (e j))]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Finset.mul_sum, hc]
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    ring
  have hlaw : ∀ (p₁ p₂ : M) (y : E3), y ∈ (chartAt E3 p₁).target →
      (chartAt E3 p₁).symm y ∈ (chartAt E3 p₂).source →
      DifferentiableAt ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y ∧
      (∀ i j : Fin 3, g.coeff (chartAt E3 p₁).symm y i j = ∑ a : Fin 3, ∑ b : Fin 3,
        fderiv ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y (e i) a *
          g.coeff (chartAt E3 p₂).symm (chartAt E3 p₂ ((chartAt E3 p₁).symm y)) a b *
          fderiv ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y (e j) b) := by
    intro p₁ p₂ y hy hy₂
    have hA : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₁).symm y :=
      mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₁) hy
    have hB : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₂) ((chartAt E3 p₁).symm y) :=
      mdifferentiableAt_atlas (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₂) hy₂
    have hτ : DifferentiableAt ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y :=
      mdifferentiableAt_iff_differentiableAt.mp (hB.comp y hA)
    have hΦ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₂).symm
        (chartAt E3 p₂ ((chartAt E3 p₁).symm y)) :=
      mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₂)
        ((chartAt E3 p₂).map_source hy₂)
    have hev : ∀ᶠ z in 𝓝 y, (chartAt E3 p₂).symm (chartAt E3 p₂ ((chartAt E3 p₁).symm z)) =
        (chartAt E3 p₁).symm z := by
      have hO' := (chartAt E3 p₁).isOpen_inter_preimage_symm (chartAt E3 p₂).open_source
      exact Filter.eventually_of_mem (hO'.mem_nhds ⟨hy, hy₂⟩)
        (fun z hz => (chartAt E3 p₂).left_inv hz.2)
    refine ⟨hτ, ?_⟩
    intro i j
    have hfun : (⇑(chartAt E3 p₂).symm ∘ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)))
        =ᶠ[𝓝 y] ⇑(chartAt E3 p₁).symm := hev
    have hmf := hfun.mfderiv_eq (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, E3))
    have hpt : (⇑(chartAt E3 p₂).symm ∘ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y =
        (chartAt E3 p₁).symm y := (chartAt E3 p₂).left_inv hy₂
    have key : g.coeff (chartAt E3 p₁).symm y i j =
        g.coeff (⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y i j := by
      show _ = g.g ((⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y (e j))
      rw [hmf, hpt]
      rfl
    rw [key]
    exact cca _ _ y hτ hΦ i j
  
  have hsqrt : ∀ (A : E3 →L[ℝ] E3) (G₁ G₂ : Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, G₁ i j = ∑ a : Fin 3, ∑ b : Fin 3, A (e i) a * G₂ a b * A (e j) b) →
      Real.sqrt G₁.det = |A.det| * Real.sqrt G₂.det := by
    intro A G₁ G₂ hl
    have h1 : G₁ = (Matrix.of fun a i => A (e i) a).transpose * G₂ *
        (Matrix.of fun a i => A (e i) a) := by
      ext i j
      rw [hl i j]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have h3 : (Matrix.of fun a i => A (e i) a).det = A.det := by
      have hdt := LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
        (A : E3 →ₗ[ℝ] E3)
      show _ = LinearMap.det (A : E3 →ₗ[ℝ] E3)
      rw [← hdt]
      congr 1
    rw [h1, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, h3,
      show A.det * G₂.det * A.det = A.det ^ 2 * G₂.det by ring,
      Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  
  have hvolEq : ∀ (p p' : M) (h : M → ℝ),
      (∀ x, h x ≠ 0 → x ∈ (chartAt E3 p).source ∩ (chartAt E3 p').source) →
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
          h ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det =
        ∫ z in chartAt E3 p' '' (E ∩ (chartAt E3 p').source),
          h ((chartAt E3 p').symm z) * Real.sqrt (g.coeff (chartAt E3 p').symm z).det := by
    intro p p' h hh
    have hsub : chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)) ⊆
        chartAt E3 p '' (E ∩ (chartAt E3 p).source) :=
      Set.image_mono (fun x hx => ⟨hx.1, hx.2.1⟩)
    have hsub' : chartAt E3 p' '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)) ⊆
        chartAt E3 p' '' (E ∩ (chartAt E3 p').source) :=
      Set.image_mono (fun x hx => ⟨hx.1, hx.2.2⟩)
    have hmeas : MeasurableSet
        (chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source))) := by
      have he : chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)) =
          chartAt E3 p '' (E ∩ (chartAt E3 p).source) ∩
            ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 p').source) := by
        ext y
        constructor
        · rintro ⟨x, ⟨hxE, hxs, hxs'⟩, rfl⟩
          refine ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, (chartAt E3 p).map_source hxs, ?_⟩
          show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 p').source
          rw [(chartAt E3 p).left_inv hxs]
          exact hxs'
        · rintro ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, -, hy⟩
          have hy' : (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 p').source := hy
          rw [(chartAt E3 p).left_inv hxs] at hy'
          exact ⟨x, ⟨hxE, hxs, hy'⟩, rfl⟩
      rw [he]
      exact (hE p).inter
        ((chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 p').open_source).measurableSet
    have hL : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
          h ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det =
        ∫ y in chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)),
          h ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hE p) hsub ?_
      rintro _ ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, hy⟩
      rw [(chartAt E3 p).left_inv hxs]
      have hx0 : h x = 0 := by
        by_contra hne
        exact hy ⟨x, ⟨hxE, hxs, (hh x hne).2⟩, rfl⟩
      rw [hx0, zero_mul]
    have hR : ∫ z in chartAt E3 p' '' (E ∩ (chartAt E3 p').source),
          h ((chartAt E3 p').symm z) * Real.sqrt (g.coeff (chartAt E3 p').symm z).det =
        ∫ z in chartAt E3 p' '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)),
          h ((chartAt E3 p').symm z) * Real.sqrt (g.coeff (chartAt E3 p').symm z).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (hE p') hsub' ?_
      rintro _ ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, hy⟩
      rw [(chartAt E3 p').left_inv hxs]
      have hx0 : h x = 0 := by
        by_contra hne
        exact hy ⟨x, ⟨hxE, (hh x hne).1, hxs⟩, rfl⟩
      rw [hx0, zero_mul]
    have himg : (fun z => chartAt E3 p' ((chartAt E3 p).symm z)) ''
        (chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source))) =
        chartAt E3 p' '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)) := by
      rw [Set.image_image]
      refine Set.image_congr ?_
      intro x hx
      simp only [(chartAt E3 p).left_inv hx.2.1]
    have hinj : Set.InjOn (fun z => chartAt E3 p' ((chartAt E3 p).symm z))
        (chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source))) := by
      rintro _ ⟨x₁, hx₁, rfl⟩ _ ⟨x₂, hx₂, rfl⟩ hτe
      simp only [(chartAt E3 p).left_inv hx₁.2.1, (chartAt E3 p).left_inv hx₂.2.1] at hτe
      rw [(chartAt E3 p').injOn hx₁.2.2 hx₂.2.2 hτe]
    have hmem : ∀ y ∈ chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)),
        y ∈ (chartAt E3 p).target ∧ (chartAt E3 p).symm y ∈ (chartAt E3 p').source := by
      rintro _ ⟨x, hx, rfl⟩
      refine ⟨(chartAt E3 p).map_source hx.2.1, ?_⟩
      rw [(chartAt E3 p).left_inv hx.2.1]
      exact hx.2.2
    have hderiv : ∀ y ∈ chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source)),
        HasFDerivWithinAt (fun z => chartAt E3 p' ((chartAt E3 p).symm z))
          (fderiv ℝ (fun z => chartAt E3 p' ((chartAt E3 p).symm z)) y)
          (chartAt E3 p '' (E ∩ ((chartAt E3 p).source ∩ (chartAt E3 p').source))) y :=
      fun y hy => (hlaw p p' y (hmem y hy).1 (hmem y hy).2).1.hasFDerivAt.hasFDerivWithinAt
    have hcov := integral_image_eq_integral_abs_det_fderiv_smul volume hmeas hderiv hinj
      (fun z => h ((chartAt E3 p').symm z) * Real.sqrt (g.coeff (chartAt E3 p').symm z).det)
    rw [hL, hR, ← himg, hcov]
    refine setIntegral_congr_fun hmeas (fun y hy => ?_)
    obtain ⟨hyt, hys⟩ := hmem y hy
    have hback : (chartAt E3 p').symm (chartAt E3 p' ((chartAt E3 p).symm y)) =
        (chartAt E3 p).symm y := (chartAt E3 p').left_inv hys
    have hv := hsqrt _ _ _ (hlaw p p' y hyt hys).2
    show h ((chartAt E3 p).symm y) * Real.sqrt (g.coeff (chartAt E3 p).symm y).det =
      |(fderiv ℝ (fun z => chartAt E3 p' ((chartAt E3 p).symm z)) y).det| *
        (h ((chartAt E3 p').symm (chartAt E3 p' ((chartAt E3 p).symm y))) *
          Real.sqrt (g.coeff (chartAt E3 p').symm (chartAt E3 p' ((chartAt E3 p).symm y))).det)
    rw [hv, hback]
    ring
  
  have hA_t : ∀ (p : M) (y : E3), y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source) →
      y ∈ (chartAt E3 p).target := by
    rintro p _ ⟨x, ⟨-, hx⟩, rfl⟩
    exact (chartAt E3 p).map_source hx
  have hA_E : ∀ (p : M) (y : E3), y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source) →
      (chartAt E3 p).symm y ∈ E := by
    rintro p _ ⟨x, ⟨hxE, hx⟩, rfl⟩
    rw [(chartAt E3 p).left_inv hx]
    exact hxE
  
  have hTint : ∀ (j k : Fin n) (p : M) (K : Set M), IsCompact K → K ⊆ (chartAt E3 p).source →
      (∀ x, x ∉ K → φ k x * D j x = 0) →
      IntegrableOn (fun y => φ k ((chartAt E3 p).symm y) * D j ((chartAt E3 p).symm y) *
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
        (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) := by
    intro j k p K hK hKs h0
    refine hint p _ K hK hKs ?_ ?_
    · refine (hcont p (φ j) (φ k) (hφs j) (hφs k)).congr (fun y hy => ?_)
      simp only
      rw [hF5 j p y hy]
    · intro y _ hy
      rw [h0 _ hy, zero_mul]
  
  have stepA : ∀ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
      Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (Z ((chartAt E3 (q j)).symm y)) : E3) =
      ∑ k, ∫ z in chartAt E3 (q k) '' (E ∩ (chartAt E3 (q k)).source),
        φ k ((chartAt E3 (q k)).symm z) * D j ((chartAt E3 (q k)).symm z) *
          Real.sqrt (g.coeff (chartAt E3 (q k)).symm z).det := by
    intro j
    have e1 : ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
          fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
              (Z ((chartAt E3 (q j)).symm y)) : E3) =
        ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          ∑ k, φ k ((chartAt E3 (q j)).symm y) * D j ((chartAt E3 (q j)).symm y) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := by
      refine setIntegral_congr_fun (hE (q j)) (fun y hy => ?_)
      have hs := hφ1 _ (hEO (hA_E _ y hy))
      simp only
      rw [hF5 j (q j) y (hA_t _ y hy), ← Finset.sum_mul, ← Finset.sum_mul, hs]
      ring
    rw [e1, integral_finset_sum _ (fun k _ => hTint j k (q j) (tsupport (φ j)) (hφc j) (hφt j)
      (fun x hx => by rw [hF4 j x hx, mul_zero]))]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    refine hvolEq (q j) (q k) (fun x => φ k x * D j x) (fun x hx => ⟨?_, ?_⟩)
    · by_contra hxs
      exact hx (by
        show φ k x * D j x = 0
        rw [hF4 j x (fun ht => hxs (hφt j ht)), mul_zero])
    · by_contra hxs
      exact hx (by
        show φ k x * D j x = 0
        rw [image_eq_zero_of_notMem_tsupport (fun ht => hxs (hφt k ht)), zero_mul])
  
  rw [Finset.sum_congr rfl (fun j _ => stepA j), Finset.sum_comm]
  refine Finset.sum_eq_zero (fun k _ => ?_)
  rw [← integral_finset_sum _ (fun j _ => hTint j k (q k) (tsupport (φ k)) (hφc k) (hφt k)
    (fun x hx => by rw [image_eq_zero_of_notMem_tsupport hx, zero_mul]))]
  have hz0 : ∫ z in chartAt E3 (q k) '' (E ∩ (chartAt E3 (q k)).source),
      ∑ j, φ k ((chartAt E3 (q k)).symm z) * D j ((chartAt E3 (q k)).symm z) *
        Real.sqrt (g.coeff (chartAt E3 (q k)).symm z).det =
      ∫ z in chartAt E3 (q k) '' (E ∩ (chartAt E3 (q k)).source), (0 : ℝ) := by
    refine setIntegral_congr_fun (hE (q k)) (fun z hz => ?_)
    have hzt := hA_t _ z hz
    have hDs : ∑ j, D j ((chartAt E3 (q k)).symm z) =
        ∑ j, fderiv ℝ (fun w => φ j ((chartAt E3 (q k)).symm w)) z
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q k)) ((chartAt E3 (q k)).symm z)
            (Z ((chartAt E3 (q k)).symm z)) : E3) :=
      Finset.sum_congr rfl (fun j _ => (hF5 j (q k) z hzt).symm)
    have h0 : ∑ j, D j ((chartAt E3 (q k)).symm z) = 0 := by
      rw [hDs, ← ContinuousLinearMap.sum_apply, hsum0 (q k) z hzt (hEO (hA_E _ z hz))]
      rfl
    rw [← Finset.sum_mul, ← Finset.mul_sum, h0]
    ring
  rw [hz0]
  simp

theorem calibration_step [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (r₁ r₂ s : ℝ) (A F : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hcpt : ∀ t : ℝ, IsCompact {p : M | ρ p ≤ t}) (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p) (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A) (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) (hr₁₂ : r₁ < r₂) (hr₂s : r₂ < s) (hF : sepChartMeas F) (hFA : symmDiff F A ⊆ {p : M | ρ p ≤ r₂}) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ {p : M | ρ p < s}) (O : Set M) (hO : IsOpen O) (hKO : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ O) (hφ1 : ∀ x ∈ O, ∑ j, φ j x = 1) (Y : M → E3) (hY : calSmoothField Y) (hY1 : ∀ x, g.g x (Y x) (Y x) ≤ 1) (ε : ℝ) (hε : 0 < ε) : ∃ V : M → E3, calSmoothField V ∧ (∀ x, g.g x (V x) (V x) ≤ 1) ∧ calDivSum g q φ ((F \ {p : M | r₁ < ρ p}) ∪ A) Y + calVolSum g q φ (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) - ε ≤ calDivSum g q φ F V :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have himg : ∀ (x : M) (S : Set M), chartAt E3 x '' (S ∩ (chartAt E3 x).source) =
      (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S := by
    intro x S
    rw [Set.inter_comm]
    exact (chartAt E3 x).image_source_inter_eq' S
  have hopenimg : ∀ (x : M) (S : Set M), IsOpen S →
      MeasurableSet ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S) := by
    intro x S hS
    exact ((chartAt E3 x).isOpen_inter_preimage_symm hS).measurableSet
  have hUo : IsOpen {p : M | r₁ < ρ p} := isOpen_lt continuous_const hρc
  have hDm : sepChartMeas (symmDiff F A ∩ {p : M | r₁ < ρ p}) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' (symmDiff F A ∩ {p : M | r₁ < ρ p}) =
        symmDiff ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F)
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) ∩
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p}) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff]
      tauto
    rw [e]
    exact (hFp.symmDiff (hopenimg x _ hAo)).inter (hopenimg x _ hUo)
  have hDO : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ O := fun x hx => hKO ⟨le_of_lt hx.2, hFA hx.1⟩
  
  obtain ⟨S, hSdef⟩ : ∃ S : Fin n → Set E3, S = fun j => chartAt E3 (q j) ''
      ((symmDiff F A ∩ {x : M | r₁ < ρ x}) ∩ (chartAt E3 (q j)).source) := ⟨_, rfl⟩
  obtain ⟨f, hfdef⟩ : ∃ f : Fin n → E3 → ℝ, f = fun j y => ρ ((chartAt E3 (q j)).symm y) :=
    ⟨_, rfl⟩
  obtain ⟨d, hddef⟩ : ∃ d : Fin n → E3 → ℝ, d = fun j y => φ j ((chartAt E3 (q j)).symm y) *
      g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  obtain ⟨ee, heedef⟩ : ∃ ee : Fin n → E3 → ℝ, ee = fun j y =>
      calSigma ρ r₁ A ((chartAt E3 (q j)).symm y) *
        sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) Y) y := ⟨_, rfl⟩
  have hSm : ∀ j, MeasurableSet (S j) := by
    intro j
    rw [hSdef]
    exact hDm (q j)
  have hSt : ∀ j, S j ⊆ (chartAt E3 (q j)).target := by
    intro j
    rw [hSdef]
    rintro _ ⟨x, ⟨_, hxs⟩, rfl⟩
    exact (chartAt E3 (q j)).map_source hxs
  have hfc : ∀ j, ContinuousOn (f j) (S j) := by
    intro j
    have h : ContinuousOn (fun y => ρ ((chartAt E3 (q j)).symm y)) (S j) :=
      hρc.comp_continuousOn ((chartAt E3 (q j)).continuousOn_symm.mono (hSt j))
    rw [hfdef]
    exact h
  have hfS : ∀ j, ∀ y ∈ S j, r₁ < f j y := by
    intro j y hy
    rw [hSdef] at hy
    obtain ⟨x, ⟨hxD, hxs⟩, rfl⟩ := hy
    rw [hfdef]
    show r₁ < ρ ((chartAt E3 (q j)).symm (chartAt E3 (q j) x))
    rw [(chartAt E3 (q j)).left_inv hxs]
    exact hxD.2
  
  obtain ⟨V₁, Z₁, -, -, -, hVZ₁⟩ :=
    cal_blend_field g ρ r₁ 1 A hρ hmc hAsub hAo hBo one_pos Y hY hY1
  have hint : ∀ j, IntegrableOn (d j) (S j) ∧ IntegrableOn (ee j) (S j) := by
    intro j
    have h := cal_chart_step g ρ r₁ 1 A F hρ hmc hAsub hAo hBo hF one_pos (q j) (φ j) (hφ.1 j)
      (hφ.2.1 j) (hφ.2.2.2 j).1 ((hφ.2.2.2 j).2.trans Set.inter_subset_right) Y V₁ Z₁ hY hY1
      (hVZ₁ (q j))
    rw [hSdef, hddef, heedef]
    exact ⟨h.1, h.2.1⟩
  
  have hlim : ∀ (T : Set E3), MeasurableSet T → ∀ (u w : E3 → ℝ), ContinuousOn u T →
      (∀ y ∈ T, r₁ < u y) → IntegrableOn w T →
      Tendsto (fun η : ℝ => ∫ y in T, calTheta r₁ η (u y) * w y) (𝓝[>] 0)
        (𝓝 (∫ y in T, w y)) := by
    intro T hT u w hu huT hw
    refine tendsto_integral_filter_of_dominated_convergence (fun y => ‖w y‖) ?_ ?_ hw.norm ?_
    · refine Filter.Eventually.of_forall (fun η => ?_)
      have hθ : Continuous (fun t : ℝ => calTheta r₁ η t) := by
        unfold calTheta
        exact Real.smoothTransition.continuous.comp (by fun_prop)
      exact ((hθ.comp_continuousOn hu).aestronglyMeasurable hT).mul hw.aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun η => Filter.Eventually.of_forall (fun y => ?_))
      have h0 := Real.smoothTransition.nonneg (2 * ((u y - r₁) / η) - 1)
      have h1 := Real.smoothTransition.le_one (2 * ((u y - r₁) / η) - 1)
      have hle : ‖calTheta r₁ η (u y)‖ ≤ 1 := by
        unfold calTheta
        rw [Real.norm_eq_abs, abs_of_nonneg h0]
        exact h1
      rw [norm_mul]
      calc ‖calTheta r₁ η (u y)‖ * ‖w y‖ ≤ 1 * ‖w y‖ :=
            mul_le_mul_of_nonneg_right hle (norm_nonneg _)
        _ = ‖w y‖ := one_mul _
    · refine ae_restrict_of_forall_mem hT (fun y hy => ?_)
      have hδ : 0 < u y - r₁ := sub_pos.2 (huT y hy)
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Ioo_mem_nhdsGT hδ] with η hη
      have hη0 : 0 < η := hη.1
      have h1 : 1 ≤ 2 * ((u y - r₁) / η) - 1 := by
        have h2 : 1 < (u y - r₁) / η := by
          rw [lt_div_iff₀ hη0]
          linarith [hη.2]
        linarith
      unfold calTheta
      rw [Real.smoothTransition.one_of_one_le h1, one_mul]
  
  have hΦ : Tendsto (fun η : ℝ => ∑ j, ((∫ y in S j, calTheta r₁ η (f j y) * d j y) +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r₁ η (f j y) * ee j y))) (𝓝[>] 0)
      (𝓝 (∑ j, ((∫ y in S j, d j y) + ((∫ y in S j, ee j y) - ∫ y in S j, ee j y)))) :=
    tendsto_finset_sum _ (fun j _ => (hlim _ (hSm j) _ _ (hfc j) (hfS j) (hint j).1).add
      (tendsto_const_nhds.sub (hlim _ (hSm j) _ _ (hfc j) (hfS j) (hint j).2)))
  have hL : (∑ j, ((∫ y in S j, d j y) + ((∫ y in S j, ee j y) - ∫ y in S j, ee j y))) =
      calVolSum g q φ (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) := by
    simp only [sub_self, add_zero]
    rw [hSdef, hddef]
    rfl
  rw [hL] at hΦ
  obtain ⟨η, hηΦ, hη⟩ := ((hΦ.eventually (lt_mem_nhds (sub_lt_self _ hε))).and
    eventually_mem_nhdsWithin).exists
  have hη0 : 0 < η := hη
  
  obtain ⟨V, Z, hV, hV1, hZ, hVZ⟩ :=
    cal_blend_field g ρ r₁ η A hρ hmc hAsub hAo hBo hη0 Y hY hY1
  refine ⟨V, hV, hV1, ?_⟩
  obtain ⟨Mt, hMdef⟩ : ∃ Mt : Fin n → ℝ, Mt = fun j => ∫ y in S j,
      Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
        fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
            (Z ((chartAt E3 (q j)).symm y)) : E3) := ⟨_, rfl⟩
  
  have hcancel : ∑ j, Mt j = 0 := by
    rw [hMdef, hSdef]
    exact cal_partition_div_cancel g {p : M | ρ p < s} q φ hφ O hO hφ1 Z hZ _ hDm hDO
  
  have hineq : ∀ j, ((∫ y in S j, calTheta r₁ η (f j y) * d j y) + Mt j +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r₁ η (f j y) * ee j y)) ≤
      (∫ y in chartAt E3 (q j) '' (F ∩ (chartAt E3 (q j)).source),
          sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) V) y) -
        ∫ y in chartAt E3 (q j) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (q j)).source),
          sepDensDiv (g.coeff (chartAt E3 (q j)).symm) (calPiece (q j) (φ j) Y) y := by
    intro j
    have h := cal_chart_step g ρ r₁ η A F hρ hmc hAsub hAo hBo hF hη0 (q j) (φ j) (hφ.1 j)
      (hφ.2.1 j) (hφ.2.2.2 j).1 ((hφ.2.2.2 j).2.trans Set.inter_subset_right) Y V Z hY hY1
      (hVZ (q j))
    rw [hMdef, hSdef, hfdef, hddef, heedef]
    exact h.2.2
  have hsum := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => hineq j)
  have e1 : ∑ j, ((∫ y in S j, calTheta r₁ η (f j y) * d j y) + Mt j +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r₁ η (f j y) * ee j y)) =
      ∑ j, ((∫ y in S j, calTheta r₁ η (f j y) * d j y) +
      ((∫ y in S j, ee j y) - ∫ y in S j, calTheta r₁ η (f j y) * ee j y)) + ∑ j, Mt j := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  rw [e1, hcancel, add_zero, Finset.sum_sub_distrib] at hsum
  unfold calDivSum
  linarith

theorem sepRiemPer_disjoint_sum_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E Ω : Set M) {N : ℕ} (U : Fin N → Set M) (hU : ∀ i, U i ⊆ Ω) (hUd : Pairwise (fun i j => Disjoint (U i) (U j))) : ∑ i, sepRiemPer g E (U i) ≤ sepRiemPer g E Ω :=
by
  classical
  let val : (Σ n : ℕ, (Fin n → M) × (Fin n → Set M)) → ENNReal := fun x =>
    ∑ k, sepPerG (g.coeff (chartAt E3 (x.2.1 k)).symm)
      (chartAt E3 (x.2.1 k) '' (E ∩ (chartAt E3 (x.2.1 k)).source))
      (chartAt E3 (x.2.1 k) '' x.2.2 k)
  let fam : Set M → (Σ n : ℕ, (Fin n → M) × (Fin n → Set M)) → Prop := fun V x =>
    (∀ k, IsOpen (x.2.2 k) ∧ x.2.2 k ⊆ V ∩ (chartAt E3 (x.2.1 k)).source) ∧
      Pairwise (fun k l => Disjoint (x.2.2 k) (x.2.2 l))
  have hle : ∀ V : Set M, sepRiemPer g E V ≤ ⨆ x : {x // fam V x}, val x.1 := by
    intro V
    unfold sepRiemPer
    refine iSup_le fun n => iSup_le fun p => iSup_le fun W => iSup_le fun h => ?_
    exact le_iSup_of_le (⟨⟨n, (p, W)⟩, h⟩ : {x // fam V x}) le_rfl
  have hne : ∀ V : Set M, Nonempty {x // fam V x} := fun V =>
    ⟨⟨⟨0, (Fin.elim0, Fin.elim0)⟩, ⟨fun k => k.elim0, fun k => k.elim0⟩⟩⟩
  have hfam : ∀ A B Ω' : Set M, A ⊆ Ω' → B ⊆ Ω' → Disjoint A B →
      ∀ x y, fam A x → fam B y → val x + val y ≤ sepRiemPer g E Ω' := by
    intro A B Ω' hA hB hAB x y hx hy
    obtain ⟨n, p, W⟩ := x
    obtain ⟨m, p', W'⟩ := y
    obtain ⟨hx1, hx2⟩ := hx
    obtain ⟨hy1, hy2⟩ := hy
    dsimp only at hx1 hx2 hy1 hy2
    have hc1 : ∀ k, IsOpen (Fin.append W W' k) ∧
        Fin.append W W' k ⊆ Ω' ∩ (chartAt E3 (Fin.append p p' k)).source := by
      intro k
      induction k using Fin.addCases with
      | left i =>
        simp only [Fin.append_left]
        exact ⟨(hx1 i).1, (hx1 i).2.trans (Set.inter_subset_inter_left _ hA)⟩
      | right j =>
        simp only [Fin.append_right]
        exact ⟨(hy1 j).1, (hy1 j).2.trans (Set.inter_subset_inter_left _ hB)⟩
    have hc2 : Pairwise (fun k l => Disjoint (Fin.append W W' k) (Fin.append W W' l)) := by
      intro k l hkl
      induction k using Fin.addCases with
      | left i =>
        induction l using Fin.addCases with
        | left j =>
          simp only [Fin.append_left]
          exact hx2 (fun h => hkl (by rw [h]))
        | right j =>
          simp only [Fin.append_left, Fin.append_right]
          exact Disjoint.mono ((hx1 i).2.trans Set.inter_subset_left)
            ((hy1 j).2.trans Set.inter_subset_left) hAB
      | right i =>
        induction l using Fin.addCases with
        | left j =>
          simp only [Fin.append_left, Fin.append_right]
          exact Disjoint.mono ((hy1 i).2.trans Set.inter_subset_left)
            ((hx1 j).2.trans Set.inter_subset_left) hAB.symm
        | right j =>
          simp only [Fin.append_right]
          exact hy2 (fun h => hkl (by rw [h]))
    have hval : val ⟨n + m, (Fin.append p p', Fin.append W W')⟩ =
        val ⟨n, (p, W)⟩ + val ⟨m, (p', W')⟩ := by
      simp only [val, Fin.sum_univ_add, Fin.append_left, Fin.append_right]
    rw [← hval]
    unfold sepRiemPer
    exact le_iSup_of_le (n + m) (le_iSup_of_le (Fin.append p p')
      (le_iSup_of_le (Fin.append W W') (le_iSup_of_le ⟨hc1, hc2⟩ le_rfl)))
  have hbin : ∀ A B Ω' : Set M, A ⊆ Ω' → B ⊆ Ω' → Disjoint A B →
      sepRiemPer g E A + sepRiemPer g E B ≤ sepRiemPer g E Ω' := by
    intro A B Ω' hA hB hAB
    haveI := hne A
    haveI := hne B
    refine (add_le_add (hle A) (hle B)).trans ?_
    exact ENNReal.iSup_add_iSup_le fun x y => hfam A B Ω' hA hB hAB x.1 y.1 x.2 y.2
  clear hle hne hfam
  clear_value val fam
  induction N generalizing Ω with
  | zero => simp
  | succ N ih =>
    rw [Fin.sum_univ_succ]
    have h1 := ih (⋃ i : Fin N, U i.succ) (fun i => U i.succ)
      (fun i => Set.subset_iUnion (fun i => U i.succ) i)
      (fun i j hij => hUd ((Fin.succ_injective N).ne hij))
    have h2 := hbin (U 0) (⋃ i : Fin N, U i.succ) Ω (hU 0)
      (Set.iUnion_subset fun i => hU i.succ)
      (Set.disjoint_iUnion_right.2 fun i => hUd (Fin.succ_ne_zero i).symm)
    exact (add_le_add le_rfl h1).trans h2

theorem calPiece_div_le_sepRiemPer [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E U : Set M) (hU : IsOpen U) (p : M) (ψ : M → ℝ) (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hψc : IsCompact (tsupport ψ)) (hψs : tsupport ψ ⊆ U ∩ (chartAt E3 p).source) (c : ℝ) (hc : 0 < c) (hψb : ∀ x, |ψ x| ≤ c) (V : M → E3) (hV : calSmoothField V) (hV1 : ∀ x, g.g x (V x) (V x) ≤ 1) : ENNReal.ofReal (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y) ≤ ENNReal.ofReal c * sepRiemPer g E U :=
by
  classical
  
  have hψs' : tsupport ψ ⊆ (chartAt E3 p).source := hψs.trans Set.inter_subset_right
  have hKc : IsCompact ((chartAt E3 p) '' tsupport ψ) :=
    hψc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hψs')
  have hKcl : IsClosed ((chartAt E3 p) '' tsupport ψ) := hKc.isClosed
  have hKt : (chartAt E3 p) '' tsupport ψ ⊆ (chartAt E3 p).target := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source (hψs' hx)
  have hval : ∀ y ∈ (chartAt E3 p).target, calPiece p ψ V y =
      (ψ ((chartAt E3 p).symm y) • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
        ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3) := by
    intro y hy
    unfold calPiece
    rw [Set.indicator_of_mem hy]
  have hval0 : ∀ y ∉ (chartAt E3 p).target, calPiece p ψ V y = 0 := by
    intro y hy
    unfold calPiece
    rw [Set.indicator_of_notMem hy]
  have hZ : ∀ y ∉ (chartAt E3 p) '' tsupport ψ, calPiece p ψ V y = 0 := by
    intro y hy
    by_cases hyt : y ∈ (chartAt E3 p).target
    · have hx : (chartAt E3 p).symm y ∉ tsupport ψ := fun hx =>
        hy ⟨_, hx, (chartAt E3 p).right_inv hyt⟩
      rw [hval y hyt, image_eq_zero_of_notMem_tsupport hx, zero_smul]
    · exact hval0 y hyt
  have hCon : ContDiffOn ℝ ∞ (calPiece p ψ V) (chartAt E3 p).target := by
    have h1 : ContDiffOn ℝ ∞ (fun y => ψ ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
      contMDiffOn_iff_contDiffOn.mp (hψ.comp_contMDiffOn contMDiffOn_chart_symm)
    exact (h1.smul (hV p)).congr hval
  have hC : ContDiff ℝ ∞ (calPiece p ψ V) := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ (chartAt E3 p) '' tsupport ψ
    · exact hCon.contDiffAt ((chartAt E3 p).open_target.mem_nhds (hKt hy))
    · have hev : calPiece p ψ V =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        filter_upwards [hKcl.isOpen_compl.mem_nhds hy] with z hz using hZ z hz
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hHC : HasCompactSupport (calPiece p ψ V) := HasCompactSupport.intro hKc hZ
  have hT : tsupport (calPiece p ψ V) ⊆ (chartAt E3 p) '' tsupport ψ :=
    closure_minimal (fun y hy => by_contra fun h => hy (hZ y h)) hKcl
  
  set X : E3 → E3 := fun z => c⁻¹ • calPiece p ψ V z with hXdef
  have hXC : ContDiff ℝ ∞ X := hC.const_smul c⁻¹
  have hXK : HasCompactSupport X := hHC.mono (fun y hy h => hy (by simp [hXdef, h]))
  have hXT : tsupport X ⊆ (chartAt E3 p) '' (U ∩ (chartAt E3 p).source) :=
    (tsupport_smul_subset_right (fun _ => c⁻¹) (calPiece p ψ V)).trans
      (hT.trans (Set.image_mono hψs))
  
  have hexp : ∀ (L : E3 →L[ℝ] E3) (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (a : E3),
      ∑ i : Fin 3, ∑ j : Fin 3, B (L (e i)) (L (e j)) * a i * a j = B (L a) (L a) := by
    intro L B a
    have ha : a = a 0 • e 0 + a 1 • e 1 + a 2 • e 2 := by
      ext i; fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    conv_rhs => rw [ha]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Fin.sum_univ_three]
    ring
  have hXN : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
      g.coeff (chartAt E3 p).symm y i j * X y i * X y j ≤ 1 := by
    intro y
    by_cases hy : y ∈ (chartAt E3 p).target
    · have hxs : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
      have hchain : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) w) = w := by
        intro w
        have h := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) p).symm_comp_deriv hxs
        rw [(chartAt E3 p).right_inv hy] at h
        exact DFunLike.congr_fun h w
      have hXy : X y = (c⁻¹ * ψ ((chartAt E3 p).symm y)) • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3)
          (chartAt E3 p) ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) := by
        simp only [hXdef, hval y hy, smul_smul]
      have hsum : ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 p).symm y i j * X y i * X y j =
          g.g ((chartAt E3 p).symm y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (X y))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (X y)) :=
        hexp _ _ _
      rw [hsum, hXy]
      simp only [map_smul, hchain, ContinuousLinearMap.smul_apply, smul_eq_mul]
      have h1 : |c⁻¹ * ψ ((chartAt E3 p).symm y)| ≤ 1 := by
        rw [abs_mul, abs_of_pos (inv_pos.mpr hc), inv_mul_le_iff₀ hc, mul_one]
        exact hψb _
      have h2 : (c⁻¹ * ψ ((chartAt E3 p).symm y)) ^ 2 ≤ 1 := by
        rw [← sq_abs]; nlinarith [abs_nonneg (c⁻¹ * ψ ((chartAt E3 p).symm y))]
      have h3 := hV1 ((chartAt E3 p).symm y)
      have h4 : 0 ≤ (c⁻¹ * ψ ((chartAt E3 p).symm y)) ^ 2 := sq_nonneg _
      nlinarith [mul_le_mul_of_nonneg_left h3 h4]
    · have hX0 : X y = 0 := by simp [hXdef, hval0 y hy]
      simp [hX0]
  
  have hS4 : ENNReal.ofReal (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) X y) ≤
      sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (U ∩ (chartAt E3 p).source)) := by
    unfold sepPerG
    exact le_iSup₂_of_le X ⟨hXC, hXK, hXT, hXN⟩ le_rfl
  
  have hS5 : sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (E ∩ (chartAt E3 p).source))
        (chartAt E3 p '' (U ∩ (chartAt E3 p).source)) ≤ sepRiemPer g E U := by
    unfold sepRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le
      (fun _ => U ∩ (chartAt E3 p).source) (le_iSup_of_le
      ⟨fun _ => ⟨hU.inter (chartAt E3 p).open_source, subset_rfl⟩,
        fun k l hkl => absurd (Subsingleton.elim k l) hkl⟩ ?_)))
    rw [Fin.sum_univ_one]
  
  have hcal : calPiece p ψ V = fun z => c • X z := by
    funext z
    simp only [hXdef, smul_smul, mul_inv_cancel₀ hc.ne', one_smul]
  have hdiv : ∀ y, sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
      c * sepDensDiv (g.coeff (chartAt E3 p).symm) X y := by
    intro y
    rw [hcal]
    unfold sepDensDiv partialDeriv
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hf : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * (c • X z) i) =
        c • (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) := by
      funext z; simp only [Pi.smul_apply, PiLp.smul_apply, smul_eq_mul]; ring
    rw [hf, fderiv_const_smul_of_field]
    simp
  have hint : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y =
      c * ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) X y := by
    rw [← MeasureTheory.integral_const_mul]
    exact MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hdiv)
  
  rw [hint, ENNReal.ofReal_mul hc.le]
  exact mul_le_mul_left' (hS4.trans hS5) _

theorem calPiece_div_integral_sum [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p : M) {m : ℕ} (ψ : Fin m → M → ℝ) (hψ : ∀ k, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ k)) (hψc : ∀ k, IsCompact (tsupport (ψ k))) (hψs : ∀ k, tsupport (ψ k) ⊆ (chartAt E3 p).source) (V : M → E3) (hV : calSmoothField V) (S : Set E3) : ∫ y in S, sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p (fun x => ∑ k, ψ k x) V) y = ∑ k, ∫ y in S, sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p (ψ k) V) y :=
by
  classical
  
  
  have hposdef : ∀ y ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  set T : Set E3 := (chartAt E3 p).target with hTdef
  set w : E3 → E3 := fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p)
      ((chartAt E3 p).symm y) (V ((chartAt E3 p).symm y)) : E3) with hwdef
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 p).symm with hGdef
  have hTo : IsOpen T := (chartAt E3 p).open_target
  have hwT : ContDiffOn ℝ ∞ w T := hV p
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T := fun i j => g.smooth p i j
  have hdetpos : ∀ y ∈ T, 0 < (G y).det := fun y hy =>
    (hposdef y hy).det_pos
  have hdetT : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
    have e : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1
        - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
        + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y; exact Matrix.det_fin_three _
    rw [e]
    have h := hGs
    exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
      (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
      (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
  have hsqT : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T :=
    hdetT.sqrt (fun y hy => (hdetpos y hy).ne')
  have hwi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun y => w y i) T := by
    intro i
    exact (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hwT
  have hψT : ∀ k, ContDiffOn ℝ ∞ (fun y => ψ k ((chartAt E3 p).symm y)) T := by
    intro k
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ k ∘ (chartAt E3 p).symm)
        (chartAt E3 p).target :=
      (hψ k).comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp h1
  
  have hcp : ∀ (φ : M → ℝ) (z : E3) (i : Fin 3),
      calPiece p φ V z i = T.indicator (fun y => φ ((chartAt E3 p).symm y) * w y i) z := by
    intro φ z i
    by_cases hz : z ∈ T
    · rw [Set.indicator_of_mem hz]
      simp only [calPiece]
      rw [Set.indicator_of_mem hz]
      rw [WithLp.ofLp_smul]
      rfl
    · rw [Set.indicator_of_notMem hz]
      simp only [calPiece]
      rw [Set.indicator_of_notMem hz]
      simp
  
  have hKc : ∀ k, IsCompact ((chartAt E3 p) '' tsupport (ψ k)) := fun k =>
    (hψc k).image_of_continuousOn ((chartAt E3 p).continuousOn.mono (hψs k))
  have hKT : ∀ k, (chartAt E3 p) '' tsupport (ψ k) ⊆ T := by
    rintro k _ ⟨x, hx, rfl⟩
    exact (chartAt E3 p).map_source (hψs k hx)
  have hvan : ∀ k (y : E3) (i : Fin 3), y ∉ (chartAt E3 p) '' tsupport (ψ k) →
      T.indicator (fun y => ψ k ((chartAt E3 p).symm y) * w y i) y = 0 := by
    intro k y i hy
    by_cases hyT : y ∈ T
    · rw [Set.indicator_of_mem hyT]
      have h0 : ψ k ((chartAt E3 p).symm y) = 0 := by
        apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hy ⟨_, hmem, (chartAt E3 p).right_inv hyT⟩
      rw [h0, zero_mul]
    · exact Set.indicator_of_notMem hyT _
  
  obtain ⟨F, hFdef⟩ : ∃ F : Fin m → Fin 3 → E3 → ℝ, ∀ k i z, F k i z =
      Real.sqrt (G z).det * T.indicator (fun y => ψ k ((chartAt E3 p).symm y) * w y i) z :=
    ⟨_, fun _ _ _ => rfl⟩
  have hF : ∀ k (i : Fin 3), ContDiff ℝ ∞ (F k i) := by
    intro k i
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ T
    · have hH : ContDiffOn ℝ ∞
          (fun y => Real.sqrt (G y).det * (ψ k ((chartAt E3 p).symm y) * w y i)) T :=
        hsqT.mul ((hψT k).mul (hwi i))
      refine (hH.contDiffAt (hTo.mem_nhds hz)).congr_of_eventuallyEq ?_
      filter_upwards [hTo.mem_nhds hz] with y hy
      rw [hFdef, Set.indicator_of_mem hy]
    · have hzK : z ∉ (chartAt E3 p) '' tsupport (ψ k) := fun h => hz (hKT k h)
      refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [(hKc k).isClosed.isOpen_compl.mem_nhds hzK] with y hy
      rw [hFdef, hvan k y i hy, mul_zero]
  have hFc : ∀ k (i : Fin 3), HasCompactSupport (F k i) := by
    intro k i
    exact HasCompactSupport.intro (hKc k) (fun y hy => by rw [hFdef, hvan k y i hy, mul_zero])
  have hk_pt : ∀ k (i : Fin 3),
      (fun z => Real.sqrt (G z).det * calPiece p (ψ k) V z i) = F k i := by
    intro k i; funext z; rw [hFdef, hcp]
  have hsum_pt : ∀ i : Fin 3,
      (fun z => Real.sqrt (G z).det * calPiece p (fun x => ∑ k, ψ k x) V z i)
        = fun z => ∑ k, F k i z := by
    intro i; funext z
    simp only [hFdef]
    rw [hcp, ← Finset.mul_sum]
    congr 1
    by_cases hz : z ∈ T
    · simp only [Set.indicator_of_mem hz, Finset.sum_mul]
    · simp only [Set.indicator_of_notMem hz, Finset.sum_const_zero]
  have hdiv_k : ∀ k, sepDensDiv G (calPiece p (ψ k) V) =
      fun y => ∑ i : Fin 3, partialDeriv i (F k i) y := by
    intro k; funext y
    unfold sepDensDiv
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hk_pt k i]
  have hdiv : ∀ y, sepDensDiv G (calPiece p (fun x => ∑ k, ψ k x) V) y =
      ∑ k, sepDensDiv G (calPiece p (ψ k) V) y := by
    intro y
    simp only [hdiv_k]
    unfold sepDensDiv
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hsum_pt i]
    unfold partialDeriv
    have hfs : (fun z => ∑ k, F k i z) = ∑ k, F k i := by
      funext z; rw [Finset.sum_apply]
    rw [hfs, fderiv_sum (fun k _ => ((hF k i).differentiable (by simp)) y)]
    rw [ContinuousLinearMap.sum_apply]
  have hint : ∀ k, Integrable (sepDensDiv G (calPiece p (ψ k) V)) (volume.restrict S) := by
    intro k
    rw [hdiv_k k]
    refine integrable_finset_sum _ (fun i _ => ?_)
    have hc : Continuous (partialDeriv i (F k i)) :=
      ((hF k i).continuous_fderiv (by simp)).clm_apply continuous_const
    have hs : HasCompactSupport (partialDeriv i (F k i)) :=
      (hFc k i).fderiv_apply (𝕜 := ℝ) (e i)
    exact (hc.integrable_of_hasCompactSupport hs).integrableOn
  simp_rw [hdiv]
  exact integral_finset_sum _ (fun k _ => hint k)

theorem calCut_functions [IsManifold 𝓘(ℝ, E3) ∞ M] (f : M → ℝ) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) (t δ : ℝ) (hδ : 0 < δ) : ∃ a b γ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ a ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ b ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ γ ∧ (∀ x, 0 ≤ a x ∧ a x ≤ 1 ∧ 0 ≤ b x ∧ b x ≤ 1 ∧ 0 ≤ γ x ∧ γ x ≤ 1 ∧ a x + γ x + b x = 1) ∧ tsupport a ⊆ {x | t < f x} ∧ tsupport b ⊆ {x | f x < t} ∧ tsupport γ ⊆ {x | t - 2 * δ < f x ∧ f x < t + 2 * δ} :=
by
  have hTc : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hA : ContDiff ℝ ∞ (fun r : ℝ => Real.smoothTransition (2 * (r - t) / δ - 1)) :=
    hTc.comp (((contDiff_const.mul (contDiff_id.sub contDiff_const)).div_const δ).sub
      contDiff_const)
  have hB : ContDiff ℝ ∞ (fun r : ℝ => Real.smoothTransition (2 * (t - r) / δ - 1)) :=
    hTc.comp (((contDiff_const.mul (contDiff_const.sub contDiff_id)).div_const δ).sub
      contDiff_const)
  have ha : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (fun x => Real.smoothTransition (2 * (f x - t) / δ - 1)) := hA.comp_contMDiff hf
  have hb : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (fun x => Real.smoothTransition (2 * (t - f x) / δ - 1)) := hB.comp_contMDiff hf
  have A0 : ∀ x, f x ≤ t + δ / 2 → Real.smoothTransition (2 * (f x - t) / δ - 1) = 0 := by
    intro x hx
    apply Real.smoothTransition.zero_of_nonpos
    have : 2 * (f x - t) / δ ≤ 1 := by rw [div_le_one hδ]; linarith
    linarith
  have A1 : ∀ x, t + δ ≤ f x → Real.smoothTransition (2 * (f x - t) / δ - 1) = 1 := by
    intro x hx
    apply Real.smoothTransition.one_of_one_le
    have : 2 ≤ 2 * (f x - t) / δ := by rw [le_div_iff₀ hδ]; linarith
    linarith
  have B0 : ∀ x, t - δ / 2 ≤ f x → Real.smoothTransition (2 * (t - f x) / δ - 1) = 0 := by
    intro x hx
    apply Real.smoothTransition.zero_of_nonpos
    have : 2 * (t - f x) / δ ≤ 1 := by rw [div_le_one hδ]; linarith
    linarith
  have B1 : ∀ x, f x ≤ t - δ → Real.smoothTransition (2 * (t - f x) / δ - 1) = 1 := by
    intro x hx
    apply Real.smoothTransition.one_of_one_le
    have : 2 ≤ 2 * (t - f x) / δ := by rw [le_div_iff₀ hδ]; linarith
    linarith
  refine ⟨fun x => Real.smoothTransition (2 * (f x - t) / δ - 1),
    fun x => Real.smoothTransition (2 * (t - f x) / δ - 1),
    fun x => 1 - Real.smoothTransition (2 * (f x - t) / δ - 1)
      - Real.smoothTransition (2 * (t - f x) / δ - 1),
    ha, hb, (contMDiff_const.sub ha).sub hb, ?_, ?_, ?_, ?_⟩
  · intro x
    have h1 := Real.smoothTransition.nonneg (2 * (f x - t) / δ - 1)
    have h2 := Real.smoothTransition.le_one (2 * (f x - t) / δ - 1)
    have h3 := Real.smoothTransition.nonneg (2 * (t - f x) / δ - 1)
    have h4 := Real.smoothTransition.le_one (2 * (t - f x) / δ - 1)
    have hab : Real.smoothTransition (2 * (f x - t) / δ - 1)
        + Real.smoothTransition (2 * (t - f x) / δ - 1) ≤ 1 := by
      rcases le_or_gt (f x) (t + δ / 2) with h | h
      · rw [A0 x h]; linarith
      · rw [B0 x (by linarith)]; linarith
    refine ⟨h1, h2, h3, h4, by linarith, by linarith, by ring⟩
  · show closure _ ⊆ _
    refine subset_trans (closure_minimal (t := {x | t + δ / 2 ≤ f x}) ?_
      (isClosed_le continuous_const hf.continuous)) ?_
    · intro x hx
      rw [Function.mem_support] at hx
      show t + δ / 2 ≤ f x
      by_contra h
      push_neg at h
      exact hx (A0 x h.le)
    · intro x hx
      have hx' : t + δ / 2 ≤ f x := hx
      show t < f x
      linarith
  · show closure _ ⊆ _
    refine subset_trans (closure_minimal (t := {x | f x ≤ t - δ / 2}) ?_
      (isClosed_le hf.continuous continuous_const)) ?_
    · intro x hx
      rw [Function.mem_support] at hx
      show f x ≤ t - δ / 2
      by_contra h
      push_neg at h
      exact hx (B0 x h.le)
    · intro x hx
      have hx' : f x ≤ t - δ / 2 := hx
      show f x < t
      linarith
  · show closure _ ⊆ _
    refine subset_trans (closure_minimal (t := {x | t - δ ≤ f x} ∩ {x | f x ≤ t + δ}) ?_
      ((isClosed_le continuous_const hf.continuous).inter
        (isClosed_le hf.continuous continuous_const))) ?_
    · intro x hx
      rw [Function.mem_support] at hx
      refine ⟨?_, ?_⟩
      · show t - δ ≤ f x
        by_contra h
        push_neg at h
        apply hx
        rw [A0 x (by linarith), B1 x h.le]
        ring
      · show f x ≤ t + δ
        by_contra h
        push_neg at h
        apply hx
        rw [A1 x h.le, B0 x (by linarith)]
        ring
    · intro x hx
      have h1 : t - δ ≤ f x := hx.1
      have h2 : f x ≤ t + δ := hx.2
      show t - 2 * δ < f x ∧ f x < t + 2 * δ
      constructor <;> linarith

theorem sepRiemPer_ge_calDivSum [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E Ω : Set M) (hE : sepChartMeas E) (hΩ : IsOpen Ω) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (V : M → E3) (hV : calSmoothField V) (hV1 : ∀ x, g.g x (V x) (V x) ≤ 1) : ENNReal.ofReal (calDivSum g q φ E V) ≤ sepRiemPer g E Ω :=
by
  classical
  obtain ⟨I, hI⟩ : ∃ I : M → (M → ℝ) → ℝ, I = fun p ψ =>
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p ψ V) y := ⟨_, rfl⟩
  suffices H : ∀ (n : ℕ) (Ω : Set M), IsOpen Ω → ∀ (q : Fin n → M) (φ : Fin n → M → ℝ),
      calPartition q φ Ω → ENNReal.ofReal (calDivSum g q φ E V) ≤ sepRiemPer g E Ω from
    H n Ω hΩ q φ hφ
  intro n
  induction n with
  | zero =>
    intro Ω _ q φ _
    simp [calDivSum]
  | succ n ih =>
    intro Ω hΩ q φ hφ
    obtain ⟨hsm, hnn, hsum, hsupp⟩ := hφ
    by_cases hPtop : sepRiemPer g E Ω = ⊤
    · rw [hPtop]; exact le_top
    
    have hmono : ∀ U : Set M, U ⊆ Ω → sepRiemPer g E U ≤ sepRiemPer g E Ω := by
      intro U hU
      have h := sepRiemPer_disjoint_sum_le g E Ω (fun _ : Fin 1 => U) (fun _ => hU)
        (fun i j hij => absurd (Subsingleton.elim i j) hij)
      simpa using h
    have hfin : ∀ U : Set M, U ⊆ Ω → sepRiemPer g E U ≠ ⊤ := fun U hU =>
      ne_top_of_le_ne_top hPtop (hmono U hU)
    have hconv : ∀ (U : Set M), U ⊆ Ω → ∀ (x c : ℝ), 0 ≤ c →
        ENNReal.ofReal x ≤ ENNReal.ofReal c * sepRiemPer g E U →
        x ≤ c * (sepRiemPer g E U).toReal := by
      intro U hU x c hc h
      have h2 := (ENNReal.ofReal_le_iff_le_toReal
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hfin U hU))).1 h
      rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hc] at h2
    have hpv0 : 0 ≤ (sepRiemPer g E Ω).toReal := ENNReal.toReal_nonneg
    
    have hφ1 : ∀ j x, φ j x ≤ 1 := fun j x =>
      le_trans (Finset.single_le_sum (fun k _ => hnn k x) (Finset.mem_univ j)) (hsum x)
    have hφ0src : ∀ x, φ 0 x ≠ 0 → x ∈ Ω ∩ (chartAt E3 (q 0)).source := fun x hx =>
      (hsupp 0).2 (subset_tsupport _ hx)
    have hprod : ∀ (w : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
        (∀ x, 0 ≤ w x ∧ w x ≤ 1) → ∀ j,
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => w x * φ j x) ∧
        IsCompact (tsupport (fun x => w x * φ j x)) ∧
        tsupport (fun x => w x * φ j x) ⊆ tsupport w ∩ (Ω ∩ (chartAt E3 (q j)).source) ∧
        (∀ x, |w x * φ j x| ≤ 1) ∧ (∀ x, 0 ≤ w x * φ j x) := by
      intro w hw hw01 j
      refine ⟨hw.mul (hsm j),
        (hsupp j).1.of_isClosed_subset (isClosed_tsupport _) (tsupport_mul_subset_right),
        fun x hx => ⟨tsupport_mul_subset_left hx, (hsupp j).2 (tsupport_mul_subset_right hx)⟩,
        fun x => ?_, fun x => mul_nonneg (hw01 x).1 (hnn j x)⟩
      rw [abs_of_nonneg (mul_nonneg (hw01 x).1 (hnn j x))]
      exact mul_le_one₀ (hw01 x).2 (hnn j x) (hφ1 j x)
    have hΛeq : calDivSum g q φ E V = ∑ j, I (q j) (φ j) := by subst hI; rfl
    
    have hstar : ∀ N : ℕ, 0 < N → ∀ u : ℝ, 0 < u →
        calDivSum g q φ E V ≤ (sepRiemPer g E Ω).toReal + 8 * N * u * (sepRiemPer g E Ω).toReal
          + (n + 1) * (sepRiemPer g E Ω).toReal / N := by
      intro N hN u hu
      have hNpos : (0 : ℝ) < N := by exact_mod_cast hN
      
      have hBsub : ∀ i : Fin N, Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
          φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u} ⊆ Ω := fun i => Set.inter_subset_left
      have hBdisj : Pairwise (fun i j : Fin N =>
          Disjoint (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u})
          (Ω ∩ {x | u * (8 * ((j : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((j : ℕ) : ℝ) + 4) + 2 * u})) := by
        intro i j hij
        rw [Set.disjoint_left]
        rintro x ⟨-, h1, h2⟩ ⟨-, h3, h4⟩
        have hne : (i : ℕ) ≠ (j : ℕ) := fun h => hij (Fin.ext h)
        rcases Nat.lt_or_gt_of_ne hne with h | h
        · have h' : ((i : ℕ) : ℝ) + 1 ≤ ((j : ℕ) : ℝ) := by exact_mod_cast h
          nlinarith [mul_le_mul_of_nonneg_left h' hu.le]
        · have h' : ((j : ℕ) : ℝ) + 1 ≤ ((i : ℕ) : ℝ) := by exact_mod_cast h
          nlinarith [mul_le_mul_of_nonneg_left h' hu.le]
      have hBsum := sepRiemPer_disjoint_sum_le g E Ω _ hBsub hBdisj
      have hBreal : ∑ i : Fin N, (sepRiemPer g E (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
          φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u})).toReal ≤ (sepRiemPer g E Ω).toReal := by
        rw [← ENNReal.toReal_sum (fun i _ => hfin _ (hBsub i))]
        exact ENNReal.toReal_mono hPtop hBsum
      obtain ⟨i, -, hi⟩ : ∃ i ∈ (Finset.univ : Finset (Fin N)),
          (sepRiemPer g E (Ω ∩ {x | u * (8 * ((i : ℕ) : ℝ) + 4) - 2 * u < φ 0 x ∧
            φ 0 x < u * (8 * ((i : ℕ) : ℝ) + 4) + 2 * u})).toReal
            ≤ (sepRiemPer g E Ω).toReal / N := by
        refine Finset.exists_le_of_sum_le ⟨⟨0, hN⟩, Finset.mem_univ _⟩ ?_
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          mul_div_cancel₀ _ hNpos.ne']
        exact hBreal
      set t : ℝ := u * (8 * ((i : ℕ) : ℝ) + 4) with ht
      set B : Set M := Ω ∩ {x | t - 2 * u < φ 0 x ∧ φ 0 x < t + 2 * u} with hB
      have hi' : (sepRiemPer g E B).toReal ≤ (sepRiemPer g E Ω).toReal / N := hi
      have hBsub' : B ⊆ Ω := Set.inter_subset_left
      have hBopen : IsOpen B := hΩ.inter
        ((isOpen_lt continuous_const (hsm 0).continuous).inter
          (isOpen_lt (hsm 0).continuous continuous_const))
      have ht0 : 0 < t := by positivity
      have htle : t ≤ 8 * N * u := by
        have hiN : ((i : ℕ) : ℝ) + 1 ≤ (N : ℝ) := by exact_mod_cast i.isLt
        nlinarith [mul_le_mul_of_nonneg_left hiN hu.le]
      
      obtain ⟨a, b, γ, ha, hb, hγ, h01, hsa, hsb, hsγ⟩ := calCut_functions (φ 0) (hsm 0) t u hu
      have h01a : ∀ x, 0 ≤ a x ∧ a x ≤ 1 := fun x => ⟨(h01 x).1, (h01 x).2.1⟩
      have h01b : ∀ x, 0 ≤ b x ∧ b x ≤ 1 := fun x => ⟨(h01 x).2.2.1, (h01 x).2.2.2.1⟩
      have h01γ : ∀ x, 0 ≤ γ x ∧ γ x ≤ 1 := fun x => ⟨(h01 x).2.2.2.2.1, (h01 x).2.2.2.2.2.1⟩
      have hsum3 : ∀ x, a x + γ x + b x = 1 := fun x => (h01 x).2.2.2.2.2.2
      have hPa := hprod a ha h01a
      have hPb := hprod b hb h01b
      have hPγ := hprod γ hγ h01γ
      have hta' : tsupport a ⊆ tsupport (φ 0) := fun x hx =>
        subset_tsupport _ (ht0.trans (hsa hx)).ne'
      have hta : tsupport a ⊆ Ω ∩ (chartAt E3 (q 0)).source := fun x hx =>
        hφ0src x (ht0.trans (hsa hx)).ne'
      set Ωa : Set M := Ω ∩ {x | t < φ 0 x} with hΩadef
      set Ωb : Set M := Ω ∩ {x | φ 0 x < t} with hΩbdef
      have hΩa : IsOpen Ωa := hΩ.inter (isOpen_lt continuous_const (hsm 0).continuous)
      have hΩb : IsOpen Ωb := hΩ.inter (isOpen_lt (hsm 0).continuous continuous_const)
      have hΩasub : Ωa ⊆ Ω := Set.inter_subset_left
      have hΩbsub : Ωb ⊆ Ω := Set.inter_subset_left
      have hdab : Disjoint Ωa Ωb := Set.disjoint_left.2 fun x h1 h2 =>
        lt_asymm (show t < φ 0 x from h1.2) (show φ 0 x < t from h2.2)
      
      have hsplit : ∀ j, I (q j) (φ j) = I (q j) (fun x => a x * φ j x) +
          I (q j) (fun x => γ x * φ j x) + I (q j) (fun x => b x * φ j x) := by
        intro j
        have hw : ∀ k : Fin 3, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (![a, γ, b] k) ∧
            ∀ x, 0 ≤ ![a, γ, b] k x ∧ ![a, γ, b] k x ≤ 1 := by
          intro k
          fin_cases k
          · exact ⟨ha, h01a⟩
          · exact ⟨hγ, h01γ⟩
          · exact ⟨hb, h01b⟩
        have h : I (q j) (fun x => ∑ k : Fin 3, ![a, γ, b] k x * φ j x) =
            ∑ k : Fin 3, I (q j) (fun x => ![a, γ, b] k x * φ j x) := by
          subst hI
          exact calPiece_div_integral_sum g (q j) (fun k x => ![a, γ, b] k x * φ j x)
            (fun k => (hprod _ (hw k).1 (hw k).2 j).1)
            (fun k => (hprod _ (hw k).1 (hw k).2 j).2.1)
            (fun k x hx => ((hprod _ (hw k).1 (hw k).2 j).2.2.1 hx).2.2) V hV _
        have hfun : (fun x => ∑ k : Fin 3, ![a, γ, b] k x * φ j x) = φ j := by
          funext x
          simp only [Fin.sum_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one,
            Matrix.head_cons, Matrix.cons_val_two, Matrix.tail_cons]
          linear_combination (φ j x) * hsum3 x
        rw [hfun, Fin.sum_univ_three] at h
        simpa only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
          Matrix.cons_val_two, Matrix.tail_cons] using h
      
      have hAj : ∀ j, I (q j) (fun x => a x * φ j x) = I (q 0) (fun x => a x * φ j x) := by
        intro j
        subst hI
        exact calPiece_div_integral_chart_eq g (q j) (q 0) _ (hPa j).1 (hPa j).2.1
          (fun x hx => ⟨((hPa j).2.2.1 hx).2.2, (hta ((hPa j).2.2.1 hx).1).2⟩) V hV E hE
      have hAsum : I (q 0) (fun x => ∑ j, a x * φ j x) =
          ∑ j, I (q 0) (fun x => a x * φ j x) := by
        subst hI
        exact calPiece_div_integral_sum g (q 0) (fun j x => a x * φ j x) (fun j => (hPa j).1)
          (fun j => (hPa j).2.1) (fun j x hx => (hta ((hPa j).2.2.1 hx).1).2) V hV _
      have hψa_eq : (fun x => ∑ j, a x * φ j x) = fun x => a x * ∑ j, φ j x := by
        funext x; rw [Finset.mul_sum]
      have hψa_sm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => ∑ j, a x * φ j x) := by
        rw [hψa_eq]; exact ha.mul (contMDiff_finset_sum fun j _ => hsm j)
      have hψa_ts : tsupport (fun x => ∑ j, a x * φ j x) ⊆ tsupport a := by
        rw [hψa_eq]; exact tsupport_mul_subset_left
      have hψa_b : ∀ x, |∑ j, a x * φ j x| ≤ 1 := by
        intro x
        have e := congrFun hψa_eq x
        simp only at e
        have hs0 : 0 ≤ ∑ j, φ j x := Finset.sum_nonneg fun j _ => hnn j x
        rw [e, abs_of_nonneg (mul_nonneg (h01a x).1 hs0)]
        exact mul_le_one₀ (h01a x).2 hs0 (hsum x)
      have hA := calPiece_div_le_sepRiemPer g E Ωa hΩa (q 0) (fun x => ∑ j, a x * φ j x) hψa_sm
        ((hsupp 0).1.of_isClosed_subset (isClosed_tsupport _) (hψa_ts.trans hta'))
        (fun x hx => ⟨⟨(hta (hψa_ts hx)).1, hsa (hψa_ts hx)⟩, (hta (hψa_ts hx)).2⟩) 1 one_pos
        hψa_b V hV hV1
      have hAR : I (q 0) (fun x => ∑ j, a x * φ j x) ≤ 1 * (sepRiemPer g E Ωa).toReal :=
        hconv Ωa hΩasub _ 1 zero_le_one (by subst hI; exact hA)
      
      have hΓj : ∀ j, I (q j) (fun x => γ x * φ j x) ≤ (sepRiemPer g E B).toReal := by
        intro j
        have h := calPiece_div_le_sepRiemPer g E B hBopen (q j) (fun x => γ x * φ j x)
          (hPγ j).1 (hPγ j).2.1
          (fun x hx => ⟨⟨((hPγ j).2.2.1 hx).2.1, hsγ ((hPγ j).2.2.1 hx).1⟩,
            ((hPγ j).2.2.1 hx).2.2⟩) 1 one_pos (hPγ j).2.2.2.1 V hV hV1
        have h2 : I (q j) (fun x => γ x * φ j x) ≤ 1 * (sepRiemPer g E B).toReal :=
          hconv B hBsub' _ 1 zero_le_one (by subst hI; exact h)
        linarith
      have hγsum : ∑ j, I (q j) (fun x => γ x * φ j x) ≤
          (n + 1) * (sepRiemPer g E B).toReal := by
        calc _ ≤ ∑ _j : Fin (n + 1), (sepRiemPer g E B).toReal :=
              Finset.sum_le_sum fun j _ => hΓj j
          _ = _ := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
              push_cast; ring
      
      have hbφ0 : ∀ x, |b x * φ 0 x| ≤ t := by
        intro x
        rw [abs_of_nonneg (mul_nonneg (h01b x).1 (hnn 0 x))]
        by_cases hbx : b x = 0
        · rw [hbx, zero_mul]; exact ht0.le
        · have h1 : φ 0 x < t := hsb (subset_tsupport _ hbx)
          have h2 : b x * φ 0 x ≤ φ 0 x := mul_le_of_le_one_left (hnn 0 x) (h01b x).2
          linarith
      have hHead := calPiece_div_le_sepRiemPer g E Ωb hΩb (q 0) (fun x => b x * φ 0 x)
        (hPb 0).1 (hPb 0).2.1
        (fun x hx => ⟨⟨((hPb 0).2.2.1 hx).2.1, hsb ((hPb 0).2.2.1 hx).1⟩,
          ((hPb 0).2.2.1 hx).2.2⟩) t ht0 hbφ0 V hV hV1
      have hHeadR : I (q 0) (fun x => b x * φ 0 x) ≤ t * (sepRiemPer g E Ωb).toReal :=
        hconv Ωb hΩbsub _ t ht0.le (by subst hI; exact hHead)
      have hpart' : calPartition (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) Ωb := by
        refine ⟨fun j => (hPb j.succ).1, fun j x => (hPb j.succ).2.2.2.2 x, fun x => ?_,
          fun j => ⟨(hPb j.succ).2.1, fun y hy => ⟨⟨((hPb j.succ).2.2.1 hy).2.1,
            hsb ((hPb j.succ).2.2.1 hy).1⟩, ((hPb j.succ).2.2.1 hy).2.2⟩⟩⟩
        have e : ∑ j : Fin n, b x * φ j.succ x = b x * ∑ j : Fin n, φ j.succ x := by
          rw [Finset.mul_sum]
        have hs := hsum x
        rw [Fin.sum_univ_succ] at hs
        have hnn' : 0 ≤ ∑ j : Fin n, φ j.succ x := Finset.sum_nonneg fun j _ => hnn _ x
        have h2 : b x * ∑ j : Fin n, φ j.succ x ≤ ∑ j : Fin n, φ j.succ x :=
          mul_le_of_le_one_left hnn' (h01b x).2
        rw [e]
        linarith [hnn 0 x]
      have hTail := ih Ωb hΩb _ _ hpart'
      have hTailR : calDivSum g (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) E V ≤
          (sepRiemPer g E Ωb).toReal :=
        (ENNReal.ofReal_le_iff_le_toReal (hfin Ωb hΩbsub)).1 hTail
      have hbsplit : ∑ j, I (q j) (fun x => b x * φ j x) = I (q 0) (fun x => b x * φ 0 x) +
          calDivSum g (fun j : Fin n => q j.succ) (fun j x => b x * φ j.succ x) E V := by
        rw [Fin.sum_univ_succ]
        congr 1
        subst hI
        rfl
      have hasum : ∑ j, I (q j) (fun x => a x * φ j x) = I (q 0) (fun x => ∑ j, a x * φ j x) := by
        rw [hAsum]; exact Finset.sum_congr rfl fun j _ => hAj j
      
      have hab := sepRiemPer_disjoint_sum_le g E Ω ![Ωa, Ωb]
        (by
          intro k
          fin_cases k
          · exact hΩasub
          · exact hΩbsub)
        (by
          intro k l hkl
          fin_cases k <;> fin_cases l
          · exact absurd rfl hkl
          · exact hdab
          · exact hdab.symm
          · exact absurd rfl hkl)
      rw [Fin.sum_univ_two] at hab
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hab
      have habR := ENNReal.toReal_mono hPtop hab
      rw [ENNReal.toReal_add (hfin _ hΩasub) (hfin _ hΩbsub)] at habR
      have hpa0 : 0 ≤ (sepRiemPer g E Ωa).toReal := ENNReal.toReal_nonneg
      have hpb0 : 0 ≤ (sepRiemPer g E Ωb).toReal := ENNReal.toReal_nonneg
      have hpB0 : 0 ≤ (sepRiemPer g E B).toReal := ENNReal.toReal_nonneg
      have hT1 : t * (sepRiemPer g E Ωb).toReal ≤ 8 * N * u * (sepRiemPer g E Ω).toReal :=
        mul_le_mul htle (by linarith) hpb0 (by positivity)
      have hT2 : (n + 1) * (sepRiemPer g E B).toReal ≤
          (n + 1) * (sepRiemPer g E Ω).toReal / N := by
        rw [mul_div_assoc]
        exact mul_le_mul_of_nonneg_left hi' (by positivity)
      rw [hΛeq, Finset.sum_congr rfl fun j _ => hsplit j, Finset.sum_add_distrib,
        Finset.sum_add_distrib, hasum, hbsplit]
      linarith
    
    have hΛ : calDivSum g q φ E V ≤ (sepRiemPer g E Ω).toReal := by
      refine le_of_forall_pos_le_add fun ε hε => ?_
      obtain ⟨N, hN⟩ := exists_nat_gt (2 * (n + 1) * (sepRiemPer g E Ω).toReal / ε)
      have hNpos' : (0 : ℝ) < N := lt_of_le_of_lt (by positivity) hN
      have hNpos : 0 < N := by exact_mod_cast hNpos'
      have h1 := hstar N hNpos (ε / (16 * N * ((sepRiemPer g E Ω).toReal + 1))) (by positivity)
      have e1 : 8 * (N : ℝ) * (ε / (16 * N * ((sepRiemPer g E Ω).toReal + 1))) *
          (sepRiemPer g E Ω).toReal =
          ε / 2 * ((sepRiemPer g E Ω).toReal / ((sepRiemPer g E Ω).toReal + 1)) := by
        field_simp
        ring
      have e2 : (sepRiemPer g E Ω).toReal / ((sepRiemPer g E Ω).toReal + 1) ≤ 1 := by
        rw [div_le_one (by positivity)]; linarith
      have e4 : ε / 2 * ((sepRiemPer g E Ω).toReal / ((sepRiemPer g E Ω).toReal + 1)) ≤ ε / 2 :=
        mul_le_of_le_one_right (by positivity) e2
      have e3 : (n + 1) * (sepRiemPer g E Ω).toReal / N ≤ ε / 2 := by
        rw [div_le_iff₀ hNpos']
        rw [div_lt_iff₀ hε] at hN
        linarith
      rw [e1] at h1
      linarith
    exact (ENNReal.ofReal_le_ofReal hΛ).trans (ENNReal.ofReal_toReal hPtop).le

theorem sep_far_witness_gain_bound [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (r₁ r₂ s : ℝ) (A F : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hcpt : ∀ t : ℝ, IsCompact {p : M | ρ p ≤ t}) (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p) (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A) (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) (hr₁₂ : r₁ < r₂) (hr₂s : r₂ < s) (hF : sepChartMeas F) (hFA : symmDiff F A ⊆ {p : M | ρ p ≤ r₂}) (Ω' : Set M) (hΩ' : IsOpen Ω') (hΩ's : Ω' ⊆ {p : M | ρ p < s}) {n₀ : ℕ} (q₀ : Fin n₀ → M) (φ₀ : Fin n₀ → M → ℝ) (hφ₀ : calPartition q₀ φ₀ Ω') (O₀ : Set M) (hO₀ : IsOpen O₀) (hKO₀ : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ O₀) (hφ₀1 : ∀ x ∈ O₀, ∑ j, φ₀ j x = 1) (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M) (hW : ∀ k, IsOpen (W k) ∧ W k ⊆ Ω' ∩ (chartAt E3 (pp k)).source) (hWd : Pairwise (fun k l => Disjoint (W k) (W l))) (Y : Fin m → E3 → E3) (hY : ∀ k, ContDiff ℝ ∞ (Y k) ∧ HasCompactSupport (Y k) ∧ tsupport (Y k) ⊆ chartAt E3 (pp k) '' W k ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 (pp k)).symm y i j * Y k y i * Y k y j ≤ 1) : ENNReal.ofReal ((∑ k, ∫ y in chartAt E3 (pp k) '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 (pp k)).source), sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y) + calVolSum g q₀ φ₀ (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x)) ≤ sepRiemPer g F Ω' :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  have himg : ∀ (x : M) (S : Set M), chartAt E3 x '' (S ∩ (chartAt E3 x).source) =
      (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S := by
    intro x S
    rw [Set.inter_comm]
    exact (chartAt E3 x).image_source_inter_eq' S
  have hopenimg : ∀ (x : M) (S : Set M), IsOpen S →
      MeasurableSet ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S) := by
    intro x S hS
    exact ((chartAt E3 x).isOpen_inter_preimage_symm hS).measurableSet
  have hUo : IsOpen {p : M | r₁ < ρ p} := isOpen_lt continuous_const hρc
  
  have hTFm : sepChartMeas ((F \ {p : M | r₁ < ρ p}) ∪ A) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' ((F \ {p : M | r₁ < ρ p}) ∪ A) =
        (((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F) \
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p})) ∪
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    rw [e]
    exact (hFp.diff (hopenimg x _ hUo)).union (hopenimg x _ hAo)
  
  have hDO₀ : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ O₀ :=
    fun x hx => hKO₀ ⟨le_of_lt hx.2, hFA hx.1⟩
  
  have hmono : ∀ {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ), calPartition q φ Ω' →
      calPartition q φ {p : M | ρ p < s} := by
    intro n q φ hφ
    exact ⟨hφ.1, hφ.2.1, hφ.2.2.1, fun j => ⟨(hφ.2.2.2 j).1,
      (hφ.2.2.2 j).2.trans (Set.inter_subset_inter_left _ hΩ's)⟩⟩
  
  obtain ⟨V, K, hV, hV1, hKc, hKΩ, -, hid⟩ :=
    sepRiemPer_witness_field g Ω' hΩ' m pp W hW hWd Y hY
  
  obtain ⟨n, q, φ, O', hφ, hO'o, hKO', hφ1, hvol⟩ :=
    calPartition_extend g Ω' hΩ' q₀ φ₀ hφ₀ O₀ hO₀ hφ₀1 K hKc hKΩ
  have hsum := hid n q φ hφ (fun x hx => hφ1 x (hKO' (Or.inl hx))) _ hTFm
  have hgain := hvol (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) hDO₀
  rw [hsum, ← hgain]
  
  by_cases hT : sepRiemPer g F Ω' = ⊤
  · rw [hT]; exact le_top
  · have key : calDivSum g q φ ((F \ {p : M | r₁ < ρ p}) ∪ A) V +
        calVolSum g q φ (symmDiff F A ∩ {p : M | r₁ < ρ p}) (fun x => g.levelMeanCurv ρ x) ≤
        (sepRiemPer g F Ω').toReal := by
      refine le_of_forall_pos_le_add fun ε hε => ?_
      
      obtain ⟨V', hV', hV'1, hcal⟩ := calibration_step g ρ r₁ r₂ s A F hρ hcpt hmc hAsub hAo hBo
        hr₁₂ hr₂s hF hFA q φ (hmono q φ hφ) O' hO'o (fun x hx => hKO' (Or.inr (hKO₀ hx))) hφ1
        V hV hV1 ε hε
      
      have h3 := sepRiemPer_ge_calDivSum g F Ω' hF hΩ' q φ hφ V' hV' hV'1
      have h4 := (ENNReal.ofReal_le_iff_le_toReal hT).1 h3
      linarith
    calc _ ≤ ENNReal.ofReal (sepRiemPer g F Ω').toReal := ENNReal.ofReal_le_ofReal key
      _ = _ := ENNReal.ofReal_toReal hT

theorem hullMinimizer_eq_far_ae [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (ρ : M → ℝ) (r₁ r₂ s : ℝ) (A F Kc : Set M)
    (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hcpt : ∀ t : ℝ, IsCompact {p : M | ρ p ≤ t})
    (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) (hKc : IsClosed Kc)
    (hKcρ : ∀ p ∈ Kc, ρ p < r₁) (hr₁₂ : r₁ < r₂) (hr₂s : r₂ < s) (hF : sepChartMeas F)
    (hFA : symmDiff F A ⊆ {p : M | ρ p ≤ r₂})
    (hfin : hullRiemPer g F {p : M | ρ p < s} Kc < ⊤)
    (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A ⊆ {p : M | ρ p ≤ r₂} →
      hullRiemPer g F {p : M | ρ p < s} Kc ≤ hullRiemPer g F' {p : M | ρ p < s} Kc) :
    sepChartNull (symmDiff F A ∩ {p : M | r₁ < ρ p}) :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have himg : ∀ (x : M) (S : Set M), chartAt E3 x '' (S ∩ (chartAt E3 x).source) =
      (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S := by
    intro x S
    rw [Set.inter_comm]
    exact (chartAt E3 x).image_source_inter_eq' S
  have hopenimg : ∀ (x : M) (S : Set M), IsOpen S →
      MeasurableSet ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' S) := by
    intro x S hS
    exact ((chartAt E3 x).isOpen_inter_preimage_symm hS).measurableSet
  have hUo : IsOpen {p : M | r₁ < ρ p} := isOpen_lt continuous_const hρc
  have hΩo : IsOpen {p : M | ρ p < s} := isOpen_lt hρc continuous_const
  have hTFm : sepChartMeas ((F \ {p : M | r₁ < ρ p}) ∪ A) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' ((F \ {p : M | r₁ < ρ p}) ∪ A) =
        (((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F) \
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p})) ∪
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    rw [e]
    exact (hFp.diff (hopenimg x _ hUo)).union (hopenimg x _ hAo)
  have hTFA : symmDiff ((F \ {p : M | r₁ < ρ p}) ∪ A) A ⊆ {p : M | ρ p ≤ r₂} := by
    intro x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hx1, hx2⟩ | ⟨hx1, hx2⟩
    · rcases hx1 with ⟨hxF, -⟩ | hxA
      · exact hFA (Set.mem_symmDiff.2 (Or.inl ⟨hxF, hx2⟩))
      · exact absurd hxA hx2
    · exact absurd (Or.inr hx1) hx2
  have hDm : sepChartMeas (symmDiff F A ∩ {p : M | r₁ < ρ p}) := by
    intro x
    have hFp := hF x
    rw [himg] at hFp ⊢
    have e : (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' (symmDiff F A ∩ {p : M | r₁ < ρ p}) =
        symmDiff ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' F)
          ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' A) ∩
        ((chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' {p : M | r₁ < ρ p}) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_symmDiff]
      tauto
    rw [e]
    exact (hFp.symmDiff (hopenimg x _ hAo)).inter (hopenimg x _ hUo)
  have hDK : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} :=
    fun x hx => ⟨le_of_lt hx.2, hFA hx.1⟩
  have hK0c : IsCompact {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} := by
    refine (hcpt r₂).of_isClosed_subset ?_ (fun x hx => hx.2)
    exact (isClosed_le continuous_const hρc).inter (isClosed_le hρc continuous_const)
  
  obtain ⟨rK, hrK1, hrKc⟩ : ∃ rK : ℝ, rK < r₁ ∧ ∀ p ∈ Kc, ρ p < rK := by
    by_cases hKe : Kc.Nonempty
    · have hKcc : IsCompact Kc :=
        (hcpt r₁).of_isClosed_subset hKc (fun p hp => (hKcρ p hp).le)
      obtain ⟨x0, hx0, hmax⟩ := hKcc.exists_isMaxOn hKe hρc.continuousOn
      have h0 := hKcρ x0 hx0
      refine ⟨(ρ x0 + r₁) / 2, by linarith, fun p hp => ?_⟩
      have h1 : ρ p ≤ ρ x0 := isMaxOn_iff.1 hmax p hp
      linarith
    · exact ⟨r₁ - 1, by linarith, fun p hp => absurd ⟨p, hp⟩ hKe⟩
  obtain ⟨rs, hrs⟩ : ∃ rs : ℝ, rs = (rK + r₁) / 2 := ⟨_, rfl⟩
  have hrKs : rK < rs := by rw [hrs]; linarith
  have hrs1 : rs < r₁ := by rw [hrs]; linarith
  have hΩso : IsOpen {p : M | rs < ρ p ∧ ρ p < s} :=
    (isOpen_lt continuous_const hρc).inter (isOpen_lt hρc continuous_const)
  have hK0Ωs : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ {p : M | rs < ρ p ∧ ρ p < s} :=
    fun x hx => ⟨lt_of_lt_of_le hrs1 hx.1, lt_of_le_of_lt hx.2 hr₂s⟩
  
  have hagree : ∀ (z : M) (f : E3 → ℝ),
      (∀ y, f y ≠ 0 → ∃ x, x ∈ (chartAt E3 z).source ∧ ρ x < r₁ ∧ chartAt E3 z x = y) →
      ∫ y in chartAt E3 z '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 z).source), f y =
        ∫ y in chartAt E3 z '' (F ∩ (chartAt E3 z).source), f y := by
    intro z f hf
    rw [← integral_indicator (hTFm z), ← integral_indicator (hF z)]
    congr 1
    funext y
    by_cases hy : f y = 0
    · simp [Set.indicator_apply, hy]
    · obtain ⟨x, hxs, hρx, rfl⟩ := hf y hy
      have hiff : x ∈ (F \ {p : M | r₁ < ρ p}) ∪ A ↔ x ∈ F := by
        constructor
        · rintro (⟨hxF, -⟩ | hxA)
          · exact hxF
          · exact absurd (show r₁ < ρ x from hAsub hxA) (not_lt.2 hρx.le)
        · intro hxF
          exact Or.inl ⟨hxF, fun h => absurd (show r₁ < ρ x from h) (not_lt.2 hρx.le)⟩
      have e1 : chartAt E3 z x ∈
            chartAt E3 z '' (((F \ {p : M | r₁ < ρ p}) ∪ A) ∩ (chartAt E3 z).source) ↔
          chartAt E3 z x ∈ chartAt E3 z '' (F ∩ (chartAt E3 z).source) := by
        rw [(chartAt E3 z).injOn.mem_image_iff Set.inter_subset_right hxs,
          (chartAt E3 z).injOn.mem_image_iff Set.inter_subset_right hxs]
        simp only [Set.mem_inter_iff, hiff]
      simp only [Set.indicator_apply, e1]
  
  have hP0 : calPartition (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) {p : M | rs < ρ p ∧ ρ p < s} :=
    ⟨fun j => j.elim0, fun j => j.elim0, fun x => by simp, fun j => j.elim0⟩
  obtain ⟨n0, q0, φ0, O0, hφ0, hO0o, hKO0, hφ01, -⟩ :=
    calPartition_extend g {p : M | rs < ρ p ∧ ρ p < s} hΩso (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) hP0 ∅ isOpen_empty (fun x hx => hx.elim)
      {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} hK0c hK0Ωs
  have hDO0 : symmDiff F A ∩ {p : M | r₁ < ρ p} ⊆ O0 := fun x hx => hKO0 (Or.inl (hDK hx))
  have hKO0' : {p : M | r₁ ≤ ρ p ∧ ρ p ≤ r₂} ⊆ O0 := fun x hx => hKO0 (Or.inl hx)
  
  refine calVolSum_levelMeanCurv_null g ρ r₁ {p : M | rs < ρ p ∧ ρ p < s} hρ hmc q0 φ0 hφ0 _
    hDm (fun x hx => hx.2) (fun x hx => hφ01 x (hDO0 hx)) ?_
