      intro x hx
      have hU : {y : E2 | r < ‖y‖} ∈ 𝓝 x :=
        (isOpen_lt continuous_const continuous_norm).mem_nhds hx
      filter_upwards [hU] with y hy
      have hy' : r < ‖y‖ := hy
      split_ifs
      · rw [hΨr y hy'.le, zero_mul]
      · rfl
    refine ⟨fun y => if ‖y‖ < ρ then Ψ y * G y else 0, ?_, ?_, ?_, ?_⟩
    · refine contDiff_iff_contDiffAt.2 fun x => ?_
      by_cases hx : ‖x‖ < ρ
      · have hxb : Metric.ball (0 : E2) ρ ∈ 𝓝 x :=
          Metric.isOpen_ball.mem_nhds (mem_ball_zero_iff.2 hx)
        exact (hΨ.contDiffAt.mul (hG.contDiffAt hxb)).congr_of_eventuallyEq (hin x hx)
      · exact contDiffAt_const.congr_of_eventuallyEq (hout x (by push_neg at hx; linarith))
    · intro x hx
      show (if ‖x‖ < ρ then Ψ x * G x else 0) = 0
