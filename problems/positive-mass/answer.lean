          (fun y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p)
          (hdiffw _ (hFs j₀)) (hdiffw _ (hκf m)) hF0j (hF0 m hm) hnej (hne m hm) ?_
        filter_upwards [htend.eventually (hκ m hm).2] with y hy
        have hr : f (c j₀) ((chartAt E3 p).symm y) * (κ m * f (c m) ((chartAt E3 p).symm y)) =
            κ m * (f (c m) ((chartAt E3 p).symm y) * f (c j₀) ((chartAt E3 p).symm y)) := by ring
        rw [hr]; exact hy
      choose! cc hccpos hcc using hprop
      have hL3a := hSOP J (fun m y => φ m ((chartAt E3 p).symm y))
        (fun m y => κ m * f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p)
        (fun m _ => hdiffw _ (hφs m)) (fun m _ => hdiffw _ (hκf m)) hF0
      beta_reduce at hL3a
      have hfd : fderiv ℝ (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
            f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) =
          (∑ m ∈ J, φ m p * cc m) •
            fderiv ℝ (fun y => f (c j₀) ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
        have hfun : (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
              f (c m) ((chartAt E3 p).symm y)) =
            fun z => ∑ m ∈ J, φ m ((chartAt E3 p).symm z) *
              (κ m * f (c m) ((chartAt E3 p).symm z)) := by
          funext z; exact Finset.sum_congr rfl (fun m _ => by ring)
        rw [hfun, hL3a, Finset.sum_smul]
        refine Finset.sum_congr rfl (fun m hm => ?_)
        rw [hcc m hm, hpy, smul_smul]
      rw [hbr _ hβs]
      show fderiv ℝ (fun y => ∑ m ∈ J, κ m * φ m ((chartAt E3 p).symm y) *
            f (c m) ((chartAt E3 p).symm y)) (chartAt E3 p p) ≠ 0
      rw [hfd]
      refine smul_ne_zero (ne_of_gt ?_) hnej
      refine Finset.sum_pos' (fun m hm => mul_nonneg (hφnn m p) (hccpos m hm).le)
        ⟨j₀, hj₀J, ?_⟩
      rw [hj₀, one_mul]; exact hccpos j₀ hj₀J
    have hev2 := hs1 _ hβs p hdβ'
    refine ⟨_, hβs, ?_⟩
    filter_upwards [hid', hev1, hev2] with x hx1 hx2 hx3
    refine ⟨?_, hx3⟩
    rw [← hx1]
    show ∑ i, φ i x * |f (c i) x| = ∑ m ∈ J, φ m x * |f (c m) x|
    exact (Finset.sum_subset (Finset.subset_univ J)
      (fun i _ hi => by rw [hx2 i hi, zero_mul])).symm
  
  set W₂ : Set M := {x | ∃ β : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β ∧
      ∀ᶠ y in 𝓝 x, τ y = |β y| ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β y ≠ 0} with hW₂def
  have hW₂o : IsOpen W₂ := by
    rw [isOpen_iff_mem_nhds]
    rintro x ⟨β, hβ, hev⟩
    filter_upwards [hev.eventually_nhds] with z hz
    exact ⟨β, hβ, hz⟩
  have hreg : ∀ x ∈ W₂, 0 < τ x → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0 := by
    rintro x ⟨β, hβ, hev⟩ hpos
    have hx := hev.self_of_nhds
    have hβne : β x ≠ 0 := by
      intro h; rw [hx.1, h, abs_zero] at hpos; exact lt_irrefl 0 hpos
    rcases lt_or_gt_of_ne hβne with h | h
    · have hev' : τ =ᶠ[𝓝 x] fun y => -β y := by
        filter_upwards [hev, hβ.continuous.continuousAt.eventually_lt continuousAt_const h]
          with y hy1 hy2
        rw [hy1.1, abs_of_neg hy2]
      rw [hev'.mfderiv_eq, show (fun y => -β y) = -β from rfl, mfderiv_neg]
      exact neg_ne_zero.mpr hx.2
    · have hev' : τ =ᶠ[𝓝 x] β := by
        filter_upwards [hev, continuousAt_const.eventually_lt hβ.continuous.continuousAt h]
          with y hy1 hy2
        rw [hy1.1, abs_of_pos hy2]
      rw [hev'.mfderiv_eq]
      exact hx.2
  
  have hUF : ∀ x ∈ U, x ∉ frontier U := fun x hx h => by
    rw [hUo.frontier_eq] at h; exact h.2 hx
  have hWo : IsOpen (N₁ ∩ W₂) := hN₁o.inter hW₂o
  have hFW : frontier U ⊆ N₁ ∩ W₂ := fun x hx => ⟨hKN₁ hx, hgood x hx⟩
  obtain ⟨K, hKc, hFK, hKW⟩ := exists_compact_between hFc hWo hFW
  have hKcl : IsClosed K := hKc.isClosed
  have hbdc : IsCompact (frontier K) :=
    hKc.of_isClosed_subset isClosed_frontier (frontier_subset_closure.trans hKcl.closure_subset)
  have hbdpos : ∀ x ∈ frontier K, 0 < τ x := by
    intro x hx
    have hxK : x ∈ K := hKcl.frontier_subset hx
    have hxF : x ∉ frontier U := fun h => hx.2 (hFK h)
    exact hτpos x (hKW hxK).1 hxF
  obtain ⟨ε, hε, hεK⟩ : ∃ ε : ℝ, 0 < ε ∧ ∀ x ∈ frontier K, ε < τ x := by
    rcases (frontier K).eq_empty_or_nonempty with h | h
    · exact ⟨1, one_pos, fun x hx => by simp [h] at hx⟩
    · obtain ⟨x₀, hx₀, hmin⟩ := hbdc.exists_isMinOn h hτc.continuousOn
      refine ⟨τ x₀ / 2, half_pos (hbdpos x₀ hx₀), fun x hx => ?_⟩
      have h1 := isMinOn_iff.1 hmin x hx
      have h2 := hbdpos x₀ hx₀
      linarith
  have hdia : ∀ x ∈ K, τ x < ε → x ∈ interior K := by
    intro x hxK hτx
    by_contra h
    have hxb : x ∈ frontier K := ⟨subset_closure hxK, h⟩
    linarith [hεK x hxb]
  set N : Set M := interior K ∩ τ ⁻¹' Set.Iio ε with hNdef
  have hNo : IsOpen N := isOpen_interior.inter (hτc.isOpen_preimage _ isOpen_Iio)
  have hNK : N ⊆ K := fun x hx => interior_subset hx.1
  have hFN : frontier U ⊆ N := fun x hx => ⟨hFK hx, by
    show τ x < ε
    rw [hτF x hx]; exact hε⟩
  have hNc : IsCompact (closure N) :=
    hKc.of_isClosed_subset isClosed_closure (closure_minimal hNK hKcl)
  have hτb : ∀ x ∈ U ∩ N, 0 < τ x ∧ τ x < ε := fun x hx =>
    ⟨hτpos x (hKW (hNK hx.2)).1 (hUF x hx.1), hx.2.2⟩
  have hcl : closure U = U ∪ frontier U := closure_eq_self_union_frontier U
  have hτp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ τ ⁻¹' Set.Icc c d) := by
    intro c' d hc hd
    have heq : U ∩ N ∩ τ ⁻¹' Set.Icc c' d = K ∩ closure U ∩ τ ⁻¹' Set.Icc c' d := by
      ext x
      constructor
      · rintro ⟨⟨hxU, hxN⟩, hxI⟩
        exact ⟨⟨hNK hxN, subset_closure hxU⟩, hxI⟩
      · rintro ⟨⟨hxK, hxc⟩, hxI⟩
        have hτx : τ x < ε := lt_of_le_of_lt hxI.2 hd
        have hxU : x ∈ U := by
          rw [hcl] at hxc
          rcases hxc with h | h
          · exact h
          · exfalso
            have h3 : c' ≤ τ x := hxI.1
            rw [hτF x h] at h3
            linarith
        exact ⟨⟨hxU, hdia x hxK hτx, hτx⟩, hxI⟩
    rw [heq]
    exact hKc.of_isClosed_subset
      ((hKcl.inter isClosed_closure).inter (IsClosed.preimage hτc isClosed_Icc))
      (fun x hx => hx.1.1)
  have hτi : ∀ δ : ℝ, 0 < δ → δ < ε →
      IsClosed (frontier U ∪ (U ∩ N ∩ τ ⁻¹' Set.Iic δ)) := by
    intro δ hδ hδε
    have heq : frontier U ∪ (U ∩ N ∩ τ ⁻¹' Set.Iic δ) = K ∩ closure U ∩ τ ⁻¹' Set.Iic δ := by
      ext x
      constructor
      · rintro (hxF | ⟨⟨hxU, hxN⟩, hxI⟩)
        · refine ⟨⟨interior_subset (hFK hxF), frontier_subset_closure hxF⟩, ?_⟩
          show τ x ≤ δ
          rw [hτF x hxF]; exact hδ.le
        · exact ⟨⟨hNK hxN, subset_closure hxU⟩, hxI⟩
      · rintro ⟨⟨hxK, hxc⟩, hxI⟩
        rw [hcl] at hxc
        rcases hxc with h | h
        · have hτx : τ x < ε := lt_of_le_of_lt hxI hδε
          exact Or.inr ⟨⟨h, hdia x hxK hτx, hτx⟩, hxI⟩
        · exact Or.inl h
    rw [heq]
    exact (hKcl.inter isClosed_closure).inter (IsClosed.preimage hτc isClosed_Iic)
  have hτ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ τ ⁻¹' Set.Iio δ := by
    intro δ hδ
    refine ⟨interior K ∩ τ ⁻¹' Set.Iio (min δ ε),
      isOpen_interior.inter (hτc.isOpen_preimage _ isOpen_Iio), fun x hx => ⟨hFK hx, ?_⟩, ?_⟩
    · show τ x < min δ ε
      rw [hτF x hx]; exact lt_min hδ hε
    · rintro x ⟨hxU, hxK, hxτ⟩
      have h1 : τ x < min δ ε := hxτ
      exact ⟨⟨hxK, lt_of_lt_of_le h1 (min_le_right _ _)⟩, lt_of_lt_of_le h1 (min_le_left _ _)⟩
  
  have hgoodOut : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, τ x = |f x| := by
    intro p hp
    obtain ⟨β, hβ, hev⟩ := hgood p hp
    obtain ⟨t, ht, hto, hpt⟩ := eventually_nhds_iff.1 hev
    refine ⟨t ∩ N₁, β, hto.inter hN₁o, ⟨hpt, hKN₁ hp⟩, hβ, fun x hx => (ht x hx.1).2, ?_, ?_⟩
    · ext x
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · rintro ⟨hxV, hxF⟩
        refine ⟨hxV, ?_⟩
        have h1 : τ x = 0 := hτF x hxF
        rw [(ht x hxV.1).1] at h1
        exact abs_eq_zero.mp h1
      · rintro ⟨hxV, hx0⟩
        refine ⟨hxV, ?_⟩
        by_contra hxF
        have h1 : 0 < τ x := hτpos x hxV.2 hxF
        rw [(ht x hxV.1).1, hx0, abs_zero] at h1
        exact lt_irrefl 0 h1
    · intro x hx
      exact (ht x hx.1.1.1).1
  
  exact ⟨N, ε, τ, hNo, hFN, hNc, hε, hτsm.mono (fun x hx => hUF x hx.1),
    fun x hx => hreg x (hKW (hNK hx.2)).2 (hτb x hx).1, hτb, hτp, hτi, hτ0, hgoodOut⟩

theorem tau_flow_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (X : Set M) (hX : IsOpen X) (τ : M → ℝ) (a b : ℝ)
    (hτs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X)
    (hτr : ∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0)
    (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b)
    (hτp : ∀ c d : ℝ, a < c → d < b → IsCompact (X ∩ τ ⁻¹' Set.Icc c d)) :
    ∃ Θ : M → ℝ → M,
      (∀ x ∈ X, ∀ s : ℝ, a < τ x + s → τ x + s < b → Θ x s ∈ X ∧ τ (Θ x s) = τ x + s) ∧
      (∀ x ∈ X, Θ x 0 = x) ∧
      ContinuousOn (fun p : M × ℝ => Θ p.1 p.2)
        {p : M × ℝ | p.1 ∈ X ∧ a < τ p.1 + p.2 ∧ τ p.1 + p.2 < b} :=
by
  obtain ⟨V, hVs, hVτ⟩ := tau_gradient_field g X hX τ hτs hτr
  have hloc : ∀ x₀ ∈ X, ∃ (N : Set M) (ε : ℝ) (ψ : M → ℝ → M), IsOpen N ∧ x₀ ∈ N ∧ N ⊆ X ∧
      0 < ε ∧ ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, ψ x s ∈ X :=
    fun x₀ hx₀ => local_flow_of_contMDiffAt X hX V x₀ hx₀ (hVs x₀ hx₀)
  have huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β) :=
    fun γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀ =>
      integral_curve_eqOn_of_mem X V hVs γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀
  have hτlin : ∀ (γ : ℝ → M) (α β s₀ : ℝ), s₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀) :=
    fun γ α β s₀ hs₀ hγ hγX =>
      tau_affine_along_integral_curve X hX τ hτs V hVτ γ α β s₀ hs₀ hγ hγX
  have hunif : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      IsOpen O ∧ X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Ψ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X :=
    fun c d hc hd => uniform_flow_on_compact X (X ∩ τ ⁻¹' Set.Icc c d) Set.inter_subset_left
      (hτp c d hc hd) V hloc huniq
  have hunif' : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X := by
    intro c d hc hd
    obtain ⟨O, ε, Ψ, _, h1, h2, h3, _, h5⟩ := hunif c d hc hd
    exact ⟨O, ε, Ψ, h1, h2, h3, h5⟩
  have hlong : ∀ x ∈ X, ∀ T₁ T₂ : ℝ, T₁ ≤ 0 → 0 ≤ T₂ → a < τ x + T₁ → τ x + T₂ < b →
      ∃ (γ : ℝ → M) (α β : ℝ), α < T₁ ∧ T₂ < β ∧ γ 0 = x ∧
        IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X :=
    fun x hx T₁ T₂ h1 h2 h3 h4 =>
      long_integral_curve_exists X τ a b V hτb huniq hτlin hunif' x hx T₁ T₂ h1 h2 h3 h4
  obtain ⟨Θ, hF1, hF2, -, hF4⟩ :=
    global_flow_assembly X hX τ a b hτs.continuousOn hτb V huniq hτlin hunif hlong
  exact ⟨Θ, hF1, hF2, hF4⟩

theorem collar_cutoff_contradiction [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U)
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc c d))
    (hWO : ∀ (x₀ : M) (a b : ℝ) (w : M → ℝ), x₀ ∈ U ∩ N → 0 < a → a < b → b < ε →
      ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (connectedComponentIn (U ∩ N) x₀) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, σ x ≤ a → w x < 0) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, b ≤ σ x → 0 < w x) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, w x = 0 →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) →
      ∃ x ∈ connectedComponentIn (U ∩ N) x₀, w x = 0 ∧ 0 ≤ g.levelMeanCurv w x)
    (x₀ : M) (hx₀ : x₀ ∈ U ∩ N)
    (hthin : ∀ O : Set M, IsOpen O →
      closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ O →
      ∃ δ : ℝ, 0 < δ ∧ δ < ε ∧ connectedComponentIn (U ∩ N) x₀ ∩ σ ⁻¹' Set.Iic δ ⊆ O)
    (O : Set M) (w : M → ℝ) (hO : IsOpen O) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ frontier U → w x = 0)
    (hwpos : ∀ x ∈ O, x ∉ frontier U → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ frontier U))
    (hdw : ∀ x ∈ O \ frontier U, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ O \ frontier U, g.levelMeanCurv w x < 0)
    (hFCO : closure (connectedComponentIn (U ∩ N) x₀) ∩ frontier U ⊆ O) :
    False :=
by
  classical
  haveI : LocallyConnectedSpace M := ChartedSpace.locallyConnectedSpace E3 M
  
  have s1 : ∀ (W v : M → ℝ) (t : ℝ) (x : M), W =ᶠ[𝓝 x] (fun z => v z - t) →
      g.levelMeanCurv W x = g.levelMeanCurv v x := by
    intro W v t x h
    have hT : Tendsto (chartAt E3 x).symm (𝓝 (chartAt E3 x x)) (𝓝 x) := by
      have h1 := (chartAt E3 x).continuousAt_symm (mem_chart_target E3 x)
      rw [ContinuousAt, (chartAt E3 x).left_inv (mem_chart_source E3 x)] at h1
      exact h1
    have ha : (fun y => W ((chartAt E3 x).symm y)) =ᶠ[𝓝 (chartAt E3 x x)]
        (fun y => v ((chartAt E3 x).symm y) - t) := hT.eventually h
    have hb : ∀ j : Fin 3,
        partialDeriv j (fun y => W ((chartAt E3 x).symm y)) (chartAt E3 x x) =
          partialDeriv j (fun y => v ((chartAt E3 x).symm y)) (chartAt E3 x x) := by
      intro j
      unfold partialDeriv
      rw [ha.fderiv_eq, fderiv_sub_const]
    have hc : ∀ j : Fin 3, partialDeriv j (fun y => W ((chartAt E3 x).symm y)) =ᶠ[𝓝 (chartAt E3 x x)]
        partialDeriv j (fun y => v ((chartAt E3 x).symm y)) := by
      intro j
      filter_upwards [ha.fderiv (𝕜 := ℝ)] with y hy
      unfold partialDeriv
      rw [hy, fderiv_sub_const]
    have hd : ∀ i j : Fin 3,
        partialDeriv i (partialDeriv j (fun y => W ((chartAt E3 x).symm y))) (chartAt E3 x x) =
          partialDeriv i (partialDeriv j (fun y => v ((chartAt E3 x).symm y))) (chartAt E3 x x) := by
      intro i j
      show fderiv ℝ _ _ (e i) = fderiv ℝ _ _ (e i)
      rw [(hc j).fderiv_eq]
    simp only [RiemannianMetric3.levelMeanCurv, RiemannianMetric3.gradInner, lapLoc, hessLoc,
      hb, hd]
  
  have s2 : ∀ (W v : M → ℝ) (t : ℝ) (x : M), W =ᶠ[𝓝 x] (fun z => v z - t) →
      MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) v x →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) W x = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) v x := by
    intro W v t x h hv
    rw [h.mfderiv_eq]
    have h2 := hv.hasMFDerivAt.sub (hasMFDerivAt_const (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, ℝ)) t x)
    rw [sub_zero] at h2
    exact h2.mfderiv
  
  have s3 : ∀ (X K : Set M), IsOpen X → IsCompact K → K ⊆ X → ∀ y₀ : M,
      IsCompact (connectedComponentIn X y₀ ∩ K) := by
    intro X K hX hK hKX y₀
    have hcl : closure (connectedComponentIn X y₀) ∩ X ⊆ connectedComponentIn X y₀ := by
      rintro y ⟨hy, hyX⟩
      obtain ⟨z, hzy, hzD⟩ := _root_.mem_closure_iff.1 hy _ hX.connectedComponentIn
        (mem_connectedComponentIn hyX)
      rw [connectedComponentIn_eq hzD, ← connectedComponentIn_eq hzy]
      exact mem_connectedComponentIn hyX
    have heq : connectedComponentIn X y₀ ∩ K = closure (connectedComponentIn X y₀) ∩ K := by
      apply Set.Subset.antisymm
      · exact Set.inter_subset_inter_left _ subset_closure
      · rintro y ⟨hy, hyK⟩
        exact ⟨hcl ⟨hy, hKX hyK⟩, hyK⟩
    rw [heq]
    exact hK.inter_left isClosed_closure
  
  have s4 : ∀ m : ℝ, 0 < m → ∃ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ ∧
      (∀ s : ℝ, s ≤ m / 2 → ψ s = s - m / 4) ∧
      (∀ s : ℝ, 3 * m / 4 ≤ s → ψ s = 1) ∧ (∀ s : ℝ, m / 2 < s → 0 < ψ s) := by
    intro m hm
    refine ⟨fun s => (1 - Real.smoothTransition ((s - m / 2) / (m / 4))) * (s - m / 4) +
      Real.smoothTransition ((s - m / 2) / (m / 4)), ?_, ?_, ?_, ?_⟩
    · have hρ : ContDiff ℝ ∞ (fun s : ℝ => Real.smoothTransition ((s - m / 2) / (m / 4))) :=
        Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const _)
      exact ((contDiff_const.sub hρ).mul (contDiff_id.sub contDiff_const)).add hρ
    · intro s hs
      have h0 : (s - m / 2) / (m / 4) ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
      simp only [Real.smoothTransition.zero_of_nonpos h0]
      ring
    · intro s hs
      have h1 : 1 ≤ (s - m / 2) / (m / 4) := by
        rw [le_div_iff₀ (by linarith)]
        linarith
      simp only [Real.smoothTransition.one_of_one_le h1]
      ring
    · intro s hs
      have hn := Real.smoothTransition.nonneg ((s - m / 2) / (m / 4))
      have hl := Real.smoothTransition.le_one ((s - m / 2) / (m / 4))
      have hA : 0 < s - m / 4 := by linarith
      dsimp only
      rcases lt_or_eq_of_le hl with h | h
      · have := mul_pos (sub_pos.2 h) hA
        linarith
      · rw [h]
        linarith
  
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  have hCX : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hCF : ∀ x ∈ C, x ∉ frontier U := by
    intro x hx hxF
    rw [hUo.frontier_eq] at hxF
    exact hxF.2 (hCX hx).1
  have hX : IsOpen (U ∩ N) := hUo.inter hNo
  have hσc : ContinuousOn σ (U ∩ N) := hσs.continuousOn
  
  obtain ⟨δ, hδ0, hδε, hδ⟩ := hthin O hO hFCO
  have hCO : ∀ x ∈ C, σ x < δ → x ∈ O \ frontier U := fun x hx hσx =>
    ⟨hδ ⟨hx, (le_of_lt hσx : σ x ≤ δ)⟩, hCF x hx⟩
  
  obtain ⟨m, hm0, hm⟩ : ∃ m : ℝ, 0 < m ∧ ∀ x ∈ C, δ / 2 ≤ σ x → σ x ≤ δ → m ≤ w x := by
    have hK : IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc (δ / 2) δ) := hσp (δ / 2) δ (by linarith) hδε
    have hB := s3 (U ∩ N) _ hX hK Set.inter_subset_left x₀
    rcases (C ∩ (U ∩ N ∩ σ ⁻¹' Set.Icc (δ / 2) δ)).eq_empty_or_nonempty with hE | hne
    · refine ⟨1, one_pos, fun x hx h1 h2 => ?_⟩
      exfalso
      have hxB : x ∈ C ∩ (U ∩ N ∩ σ ⁻¹' Set.Icc (δ / 2) δ) := ⟨hx, hCX hx, h1, h2⟩
      rw [hE] at hxB
      exact hxB
    · have hBO : C ∩ (U ∩ N ∩ σ ⁻¹' Set.Icc (δ / 2) δ) ⊆ O := fun x hx =>
        hδ ⟨hx.1, (hx.2.2.2 : σ x ≤ δ)⟩
      obtain ⟨x₁, hx₁, hmin⟩ := hB.exists_isMinOn hne (hwc.mono hBO)
      refine ⟨w x₁, hwpos x₁ (hBO hx₁) (hCF x₁ hx₁.1), fun x hx h1 h2 => ?_⟩
      exact (isMinOn_iff.1 hmin) x ⟨hx, hCX hx, h1, h2⟩
  
  have hO₂ : IsOpen (O ∩ w ⁻¹' Set.Iio (m / 4)) := hwc.isOpen_inter_preimage hO isOpen_Iio
  obtain ⟨a₀, ha₀0, ha₀ε, ha₀⟩ := hthin (O ∩ w ⁻¹' Set.Iio (m / 4)) hO₂ (by
    intro x hx
    refine ⟨hFCO hx, ?_⟩
    show w x < m / 4
    rw [hw0 x (hFCO hx) hx.2]
    linarith)
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = min a₀ (δ / 2) := ⟨_, rfl⟩
  have ha0 : 0 < a := by rw [ha_def]; exact lt_min ha₀0 (by linarith)
  have haa₀ : a ≤ a₀ := by rw [ha_def]; exact min_le_left _ _
  have haδ : a ≤ δ / 2 := by rw [ha_def]; exact min_le_right _ _
  
  obtain ⟨ψ, hψs, hψlin, hψone, hψpos⟩ := s4 m hm0
  obtain ⟨W, hW⟩ : ∃ W : M → ℝ, W = fun x => if σ x < δ then ψ (w x) else 1 := ⟨_, rfl⟩
  have hW1 : ∀ x, σ x < δ → W x = ψ (w x) := fun x h => by rw [hW]; exact if_pos h
  have hW2 : ∀ x, ¬ σ x < δ → W x = 1 := fun x h => by rw [hW]; exact if_neg h
  have hR2 : ∀ x ∈ C, δ / 2 < σ x → W x = 1 := by
    intro x hx h
    by_cases hlt : σ x < δ
    · rw [hW1 x hlt]
      apply hψone
      have := hm x hx h.le hlt.le
      linarith
    · exact hW2 x hlt
  
  have hWs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ W C := by
    apply contMDiffOn_of_locally_contMDiffOn
    intro x hx
    by_cases hlt : σ x < δ
    · refine ⟨U ∩ N ∩ σ ⁻¹' Set.Iio δ, hσc.isOpen_inter_preimage hX isOpen_Iio,
        ⟨hCX hx, hlt⟩, ?_⟩
      have hsub : C ∩ (U ∩ N ∩ σ ⁻¹' Set.Iio δ) ⊆ O \ frontier U := fun z hz =>
        hCO z hz.1 hz.2.2
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun z => ψ (w z))
          (C ∩ (U ∩ N ∩ σ ⁻¹' Set.Iio δ)) :=
        hψs.contMDiff.comp_contMDiffOn (hws.mono hsub)
      exact h1.congr (fun z hz => hW1 z hz.2.2)
    · refine ⟨U ∩ N ∩ σ ⁻¹' Set.Ioi (δ / 2), hσc.isOpen_inter_preimage hX isOpen_Ioi,
        ⟨hCX hx, ?_⟩, ?_⟩
      · show δ / 2 < σ x
        push_neg at hlt
        linarith
      · exact contMDiffOn_const.congr (fun z hz => hR2 z hz.1 hz.2.2)
  
  have hneg : ∀ x ∈ C, σ x ≤ a → W x < 0 := by
    intro x hx h
    have h1 := ha₀ ⟨hx, (le_trans h haa₀ : σ x ≤ a₀)⟩
    have h1' : w x < m / 4 := h1.2
    have hlt : σ x < δ := by linarith
    rw [hW1 x hlt, hψlin (w x) (by linarith)]
    linarith
  have hpos : ∀ x ∈ C, δ ≤ σ x → 0 < W x := by
    intro x hx h
    rw [hW2 x (not_lt.2 h)]
    exact one_pos
  
  have hzero : ∀ x ∈ C, W x = 0 → W =ᶠ[𝓝 x] (fun z => w z - m / 4) ∧ x ∈ O \ frontier U := by
    intro x hx h0
    have hlt : σ x < δ := by
      by_contra hc
      rw [hW2 x hc] at h0
      exact one_ne_zero h0
    have hxO := hCO x hx hlt
    rw [hW1 x hlt] at h0
    have hle : w x ≤ m / 2 := by
      by_contra hc
      push_neg at hc
      have := hψpos (w x) hc
      linarith
    have hwx : w x = m / 4 := by
      rw [hψlin _ hle] at h0
      linarith
    refine ⟨?_, hxO⟩
    have hVo : IsOpen ((U ∩ N ∩ σ ⁻¹' Set.Iio δ) ∩ (O ∩ w ⁻¹' Set.Iio (m / 2))) :=
      (hσc.isOpen_inter_preimage hX isOpen_Iio).inter (hwc.isOpen_inter_preimage hO isOpen_Iio)
    have hxV : x ∈ (U ∩ N ∩ σ ⁻¹' Set.Iio δ) ∩ (O ∩ w ⁻¹' Set.Iio (m / 2)) :=
      ⟨⟨hCX hx, hlt⟩, hxO.1, show w x < m / 2 by linarith⟩
    filter_upwards [hVo.mem_nhds hxV] with z hz
    rw [hW1 z hz.1.2, hψlin _ (le_of_lt hz.2.2)]
  
  obtain ⟨x, hx, hWx, hHx⟩ := hWO x₀ a δ W hx₀ ha0 (by linarith) hδε hWs hneg hpos (by
    intro x hx h0
    obtain ⟨hev, hxO⟩ := hzero x hx h0
    have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x :=
      (hws.contMDiffAt ((hO.sdiff isClosed_frontier).mem_nhds hxO)).mdifferentiableAt (by simp)
    rw [s2 W w (m / 4) x hev hmd]
    exact hdw x hxO)
  obtain ⟨hev, hxO⟩ := hzero x hx hWx
  rw [s1 W w (m / 4) x hev] at hHx
  have := hH x hxO
  linarith

theorem collar_jacobi_nonneg [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (U : Set M) (hUo : IsOpen U) (hFc : IsCompact (frontier U))
    (hfront : IsMinimalSurfaceSet g (frontier U))
    (N : Set M) (ε : ℝ) (σ : M → ℝ) (hNo : IsOpen N) (hFN : frontier U ⊆ N)
    (hNc : IsCompact (closure N)) (hε : 0 < ε)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσb : ∀ x ∈ U ∩ N, 0 < σ x ∧ σ x < ε)
    (hσp : ∀ c d : ℝ, 0 < c → d < ε → IsCompact (U ∩ N ∩ σ ⁻¹' Set.Icc c d))
    (hσi : ∀ δ : ℝ, 0 < δ → δ < ε → IsClosed (frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic δ)))
    (hσ0 : ∀ δ : ℝ, 0 < δ → ∃ O : Set M, IsOpen O ∧ frontier U ⊆ O ∧
      U ∩ O ⊆ N ∩ σ ⁻¹' Set.Iio δ)
    (hWO : ∀ (x₀ : M) (a b : ℝ) (w : M → ℝ), x₀ ∈ U ∩ N → 0 < a → a < b → b < ε →
      ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (connectedComponentIn (U ∩ N) x₀) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, σ x ≤ a → w x < 0) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, b ≤ σ x → 0 < w x) →
      (∀ x ∈ connectedComponentIn (U ∩ N) x₀, w x = 0 →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0) →
      ∃ x ∈ connectedComponentIn (U ∩ N) x₀, w x = 0 ∧ 0 ≤ g.levelMeanCurv w x)
    (φ lam : M → ℝ)
    (hlam : ∀ p ∈ frontier U, ∃ V ∈ 𝓝 p, ∀ q ∈ V, q ∈ frontier U → lam q = lam p)
    (hdata : ∀ p ∈ frontier U, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ frontier U, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧
          g.jacobiDeriv f x = lam x / φ x) :
    ∀ p ∈ frontier U, 0 ≤ lam p :=
by
  intro p₀ hp₀
  by_contra hneg
  push_neg at hneg
  have hX : IsOpen (U ∩ N) := hUo.inter hNo
  have hFU : ∀ x ∈ frontier U, x ∉ U := by
    intro x hx
    rw [hUo.frontier_eq] at hx
    exact hx.2
  
  obtain ⟨O, w, t₀, hO, -, hp₀O, ht₀, hK₀, hwc, hw0, hwpos, hws, hdw, hH, -⟩ :=
    unstable_collar_function g (frontier U) N hFc hfront hNo hFN φ lam hlam hdata p₀ hp₀ hneg
  
  obtain ⟨V, f, hVN, hVo, hp₀V, -, -, hVS, -, hP, hNg⟩ :=
    hfront.2 p₀ hp₀ N (hNo.mem_nhds (hFN hp₀))
  have hf0 : ∀ x ∈ V, x ∈ U → f x ≠ 0 := by
    intro x hxV hxU hfx
    have h : x ∈ V ∩ frontier U := by
      rw [hVS]
      exact ⟨hxV, hfx⟩
    exact hFU x h.2 hxU
  have hside : ∀ S : Set M, S ⊆ V → (∀ x ∈ S, f x ≠ 0) → IsPreconnected S →
      ∀ x₁ ∈ S, x₁ ∈ U → S ⊆ connectedComponentIn (U ∩ N) x₁ := by
    intro S hSV hSf hSc x₁ hx₁S hx₁U
    have hcov : S ⊆ U ∪ (closure U)ᶜ := by
      intro x hx
      by_cases hxU : x ∈ U
      · exact Or.inl hxU
      · right
        intro hxc
        have hxF : x ∈ frontier U := by
          rw [hUo.frontier_eq]
          exact ⟨hxc, hxU⟩
        have h : x ∈ V ∩ f ⁻¹' {0} := by
          rw [← hVS]
          exact ⟨hSV hx, hxF⟩
        exact hSf x hx h.2
    have hdisj : Disjoint U (closure U)ᶜ :=
      Disjoint.mono_left subset_closure disjoint_compl_right
    have hSU : S ⊆ U :=
      IsPreconnected.subset_left_of_subset_union hUo isClosed_closure.isOpen_compl hdisj hcov
        ⟨x₁, hx₁S, hx₁U⟩ hSc
    exact hSc.subset_connectedComponentIn hx₁S (fun x hx => ⟨hSU hx, hVN (hSV hx)⟩)
  have hp₀cl : p₀ ∈ closure (V ∩ U) := by
    rw [_root_.mem_closure_iff]
    intro W hW hp₀W
    have h1 : p₀ ∈ closure U := frontier_subset_closure hp₀
    obtain ⟨y, hyWV, hyU⟩ := _root_.mem_closure_iff.1 h1 (W ∩ V) (hW.inter hVo) ⟨hp₀W, hp₀V⟩
    exact ⟨y, hyWV.1, hyWV.2, hyU⟩
  have hVU : V ∩ U = (V ∩ U ∩ {x | 0 < f x}) ∪ (V ∩ U ∩ {x | f x < 0}) := by
    ext x
    simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_setOf_eq]
    constructor
    · rintro ⟨hxV, hxU⟩
      rcases lt_or_gt_of_ne (hf0 x hxV hxU) with h | h
      · exact Or.inr ⟨⟨hxV, hxU⟩, h⟩
      · exact Or.inl ⟨⟨hxV, hxU⟩, h⟩
    · rintro (⟨h, -⟩ | ⟨h, -⟩) <;> exact h
  obtain ⟨x₀, hx₀, hp₀C⟩ :
      ∃ x₀ ∈ U ∩ N, p₀ ∈ closure (connectedComponentIn (U ∩ N) x₀) := by
    rw [hVU, closure_union] at hp₀cl
    rcases hp₀cl with h | h
    · obtain ⟨x₀, hx₀⟩ : (V ∩ U ∩ {x | 0 < f x}).Nonempty := by
        by_contra hne
        rw [Set.not_nonempty_iff_eq_empty] at hne
        rw [hne, closure_empty] at h
        exact h
      refine ⟨x₀, ⟨hx₀.1.2, hVN hx₀.1.1⟩, closure_mono ?_ h⟩
      intro y hy
      exact hside (V ∩ {x | 0 < f x}) Set.inter_subset_left (fun x hx => ne_of_gt hx.2) hP
        x₀ ⟨hx₀.1.1, hx₀.2⟩ hx₀.1.2 ⟨hy.1.1, hy.2⟩
    · obtain ⟨x₀, hx₀⟩ : (V ∩ U ∩ {x | f x < 0}).Nonempty := by
        by_contra hne
        rw [Set.not_nonempty_iff_eq_empty] at hne
        rw [hne, closure_empty] at h
        exact h
      refine ⟨x₀, ⟨hx₀.1.2, hVN hx₀.1.1⟩, closure_mono ?_ h⟩
      intro y hy
      exact hside (V ∩ {x | f x < 0}) Set.inter_subset_left (fun x hx => ne_of_lt hx.2) hNg
        x₀ ⟨hx₀.1.1, hx₀.2⟩ hx₀.1.2 ⟨hy.1.1, hy.2⟩
  set C := connectedComponentIn (U ∩ N) x₀ with hCdef
  have hCX : C ⊆ U ∩ N := connectedComponentIn_subset _ _
  have hCN : C ⊆ N := fun x hx => (hCX hx).2
  have hσc : ContinuousOn σ (U ∩ N) := hσs.continuousOn
  
  obtain ⟨Θ, hΘX, hΘ0, hΘc⟩ := tau_flow_exists g (U ∩ N) hX σ 0 ε hσs hσr hσb hσp
  
  have hpc : ∀ δ : ℝ, 0 < δ → δ < ε → IsPreconnected (C ∩ σ ⁻¹' Set.Iio δ) := by
    intro δ _ hδ
    rcases (C ∩ σ ⁻¹' Set.Iio δ).eq_empty_or_nonempty with hS | ⟨y₀, hy₀C, hy₀δ⟩
    · rw [hS]
      exact isPreconnected_empty
    have hD : IsPreconnected (C ×ˢ Set.Ioo (0 : ℝ) δ) :=
      isPreconnected_connectedComponentIn.prod isPreconnected_Ioo
    have hιc : ContinuousOn (fun p : M × ℝ => (p.1, p.2 - σ p.1)) (C ×ˢ Set.Ioo (0 : ℝ) δ) := by
      refine continuousOn_fst.prodMk (continuousOn_snd.sub ?_)
      exact hσc.comp continuousOn_fst (fun p hp => hCX hp.1)
    have hmaps : Set.MapsTo (fun p : M × ℝ => (p.1, p.2 - σ p.1)) (C ×ˢ Set.Ioo (0 : ℝ) δ)
        {p : M × ℝ | p.1 ∈ U ∩ N ∧ 0 < σ p.1 + p.2 ∧ σ p.1 + p.2 < ε} := by
      intro p hp
      refine ⟨hCX hp.1, ?_, ?_⟩
      · show 0 < σ p.1 + (p.2 - σ p.1)
        linarith [hp.2.1]
      · show σ p.1 + (p.2 - σ p.1) < ε
        linarith [hp.2.2]
    have hψc : ContinuousOn (fun p : M × ℝ => Θ p.1 (p.2 - σ p.1)) (C ×ˢ Set.Ioo (0 : ℝ) δ) :=
      hΘc.comp hιc hmaps
    have himg := hD.image _ hψc
    have hψX : ∀ p ∈ C ×ˢ Set.Ioo (0 : ℝ) δ,
        Θ p.1 (p.2 - σ p.1) ∈ U ∩ N ∧ σ (Θ p.1 (p.2 - σ p.1)) = p.2 := by
      intro p hp
      have h := hΘX p.1 (hCX hp.1) (p.2 - σ p.1) (by linarith [hp.2.1]) (by linarith [hp.2.2])
      refine ⟨h.1, ?_⟩
      rw [h.2]
      ring
    have hback : ∀ y ∈ C, Θ y (σ y - σ y) = y := by
      intro y hy
      rw [sub_self]
      exact hΘ0 y (hCX hy)
    have hy₀img : y₀ ∈ (fun p : M × ℝ => Θ p.1 (p.2 - σ p.1)) '' (C ×ˢ Set.Ioo (0 : ℝ) δ) :=
      ⟨(y₀, σ y₀), ⟨hy₀C, (hσb y₀ (hCX hy₀C)).1, hy₀δ⟩, hback y₀ hy₀C⟩
    have himgC : (fun p : M × ℝ => Θ p.1 (p.2 - σ p.1)) '' (C ×ˢ Set.Ioo (0 : ℝ) δ) ⊆ C := by
      have h1 := himg.subset_connectedComponentIn hy₀img
        (by
          rintro _ ⟨p, hp, rfl⟩
          exact (hψX p hp).1)
      rw [← connectedComponentIn_eq hy₀C] at h1
      exact h1
    have heq : (fun p : M × ℝ => Θ p.1 (p.2 - σ p.1)) '' (C ×ˢ Set.Ioo (0 : ℝ) δ) =
        C ∩ σ ⁻¹' Set.Iio δ := by
      apply Set.Subset.antisymm
      · rintro _ ⟨p, hp, rfl⟩
        refine ⟨himgC ⟨p, hp, rfl⟩, ?_⟩
        show σ (Θ p.1 (p.2 - σ p.1)) < δ
        rw [(hψX p hp).2]
        exact hp.2.2
      · rintro y ⟨hyC, hyδ⟩
        exact ⟨(y, σ y), ⟨hyC, (hσb y (hCX hyC)).1, hyδ⟩, hback y hyC⟩
    rw [← heq]
    exact himg
  
  have hthin : ∀ O' : Set M, IsOpen O' → closure C ∩ frontier U ⊆ O' →
      ∃ δ : ℝ, 0 < δ ∧ δ < ε ∧ C ∩ σ ⁻¹' Set.Iic δ ⊆ O' := by
    intro O' hO' hFO'
    have hδpos : ∀ n : ℕ, 0 < ε / ((n : ℝ) + 2) := fun n => div_pos hε (by positivity)
    have hδlt : ∀ n : ℕ, ε / ((n : ℝ) + 2) < ε := by
      intro n
      rw [div_lt_iff₀ (by positivity)]
      have : (0 : ℝ) ≤ n := n.cast_nonneg
      nlinarith
    have hδanti : ∀ m n : ℕ, m ≤ n → ε / ((n : ℝ) + 2) ≤ ε / ((m : ℝ) + 2) := by
      intro m n hmn
      apply div_le_div_of_nonneg_left hε.le (by positivity)
      have : (m : ℝ) ≤ n := Nat.cast_le.mpr hmn
      linarith
    let T : ℕ → Set M := fun n => closure (C ∩ σ ⁻¹' Set.Iic (ε / ((n : ℝ) + 2))) \ O'
    have hTc : ∀ n, IsClosed (T n) := fun n => isClosed_closure.sdiff hO'
    have hTanti : Antitone T := by
      intro m n hmn
      apply Set.diff_subset_diff_left
      apply closure_mono
      intro x hx
      exact ⟨hx.1, le_trans hx.2 (hδanti m n hmn)⟩
    have hdir : Directed (· ⊇ ·) T := hTanti.directed_ge
    have hcl : ∀ n : ℕ, closure (C ∩ σ ⁻¹' Set.Iic (ε / ((n : ℝ) + 2))) ⊆
        frontier U ∪ (U ∩ N ∩ σ ⁻¹' Set.Iic (ε / ((n : ℝ) + 2))) := by
      intro n
      apply (hσi _ (hδpos n) (hδlt n)).closure_subset_iff.2
      intro x hx
      exact Or.inr ⟨hCX hx.1, hx.2⟩
    have hempty : closure N ∩ ⋂ n, T n = ∅ := by
      rw [Set.eq_empty_iff_forall_notMem]
      rintro x ⟨-, hx⟩
      rw [Set.mem_iInter] at hx
      have hxO : x ∉ O' := (hx 0).2
      have hxC : x ∈ closure C := closure_mono Set.inter_subset_left (hx 0).1
      by_cases hxF : x ∈ frontier U
      · exact hxO (hFO' ⟨hxC, hxF⟩)
      · have hall : ∀ n : ℕ, x ∈ U ∩ N ∧ σ x ≤ ε / ((n : ℝ) + 2) := by
          intro n
          rcases hcl n (hx n).1 with h | h
          · exact absurd h hxF
          · exact ⟨h.1, h.2⟩
        have hpos := (hσb x (hall 0).1).1
        obtain ⟨n, hn⟩ := exists_nat_gt (ε / σ x)
        have h1 := (hall n).2
        have h2 : ε / ((n : ℝ) + 2) < σ x := by
          rw [div_lt_iff₀ (by positivity)]
          rw [div_lt_iff₀ hpos] at hn
          nlinarith
        exact absurd h1 (not_le.2 h2)
    obtain ⟨n, hn⟩ := hNc.elim_directed_family_closed T hTc hempty hdir
    refine ⟨ε / ((n : ℝ) + 2), hδpos n, hδlt n, ?_⟩
    intro x hx
    by_contra hxO
    have hxT : x ∈ T n := ⟨subset_closure hx, hxO⟩
    have hxN : x ∈ closure N := subset_closure (hCN hx.1)
    have h : x ∈ closure N ∩ T n := ⟨hxN, hxT⟩
    rw [hn] at h
    exact h
  
  have hFCpc : IsPreconnected (closure C ∩ frontier U) := by
    intro u v hu hv hKuv hKu hKv
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    have hKc : IsCompact (closure C ∩ frontier U) := hFc.inter_left isClosed_closure
    have hnot : ∀ x ∈ closure C ∩ frontier U, x ∈ u → x ∈ v → False := by
      intro x hxK hxu hxv
      have h : x ∈ closure C ∩ frontier U ∩ (u ∩ v) := ⟨hxK, hxu, hxv⟩
      rw [hne] at h
      exact h
    have hdisj : Disjoint ((closure C ∩ frontier U) \ v) ((closure C ∩ frontier U) \ u) := by
      rw [Set.disjoint_left]
      rintro x ⟨hxK, hxv⟩ ⟨-, hxu⟩
      rcases hKuv hxK with h | h
      · exact hxu h
      · exact hxv h
    obtain ⟨A, B, hA, hB, hK1A, hK2B, hAB⟩ :=
      SeparatedNhds.of_isCompact_isCompact (hKc.diff hv) (hKc.diff hu) hdisj
    have hKAB : closure C ∩ frontier U ⊆ A ∪ B := by
      intro x hxK
      by_cases hxv : x ∈ v
      · by_cases hxu : x ∈ u
        · exact (hnot x hxK hxu hxv).elim
        · exact Or.inr (hK2B ⟨hxK, hxu⟩)
      · exact Or.inl (hK1A ⟨hxK, hxv⟩)
    obtain ⟨δ, hδ0, hδε, hδsub⟩ := hthin (A ∪ B) (hA.union hB) hKAB
    have hSsub : C ∩ σ ⁻¹' Set.Iio δ ⊆ A ∪ B := fun x hx =>
      hδsub ⟨hx.1, show σ x ≤ δ from le_of_lt hx.2⟩
    have hmeet : ∀ W : Set M, IsOpen W → (closure C ∩ frontier U ∩ W).Nonempty →
        (C ∩ σ ⁻¹' Set.Iio δ ∩ W).Nonempty := by
      rintro W hW ⟨p, hpK, hpW⟩
      obtain ⟨O', hO'o, hFO', hCO'⟩ := hσ0 δ hδ0
      obtain ⟨y, hyWO, hyC⟩ :=
        _root_.mem_closure_iff.1 hpK.1 (W ∩ O') (hW.inter hO'o) ⟨hpW, hFO' hpK.2⟩
      exact ⟨y, ⟨hyC, (hCO' ⟨(hCX hyC).1, hyWO.2⟩).2⟩, hyWO.1⟩
    obtain ⟨p, hpK, hpu⟩ := hKu
    have hpA : p ∈ A := hK1A ⟨hpK, fun hpv => hnot p hpK hpu hpv⟩
    obtain ⟨q, hqK, hqv⟩ := hKv
    have hqB : q ∈ B := hK2B ⟨hqK, fun hqu => hnot q hqK hqu hqv⟩
    obtain ⟨z, -, hzA, hzB⟩ :=
      hpc δ hδ0 hδε A B hA hB hSsub (hmeet A hA ⟨p, hpK, hpA⟩) (hmeet B hB ⟨q, hqK, hqB⟩)
    exact Set.disjoint_left.1 hAB hzA hzB
  
  have hFCO : closure C ∩ frontier U ⊆ O := by
    intro x₁ hx₁
    by_contra hx₁O
    have hZc : IsClosed ({x | x ∈ O ∧ w x ≤ t₀} ∩ frontier U) :=
      (hK₀.inter_right isClosed_frontier).isClosed
    have hcov : closure C ∩ frontier U ⊆ O ∪ ({x | x ∈ O ∧ w x ≤ t₀} ∩ frontier U)ᶜ := by
      intro x _
      by_cases hxO : x ∈ O
      · exact Or.inl hxO
      · exact Or.inr (fun hxZ => hxO hxZ.1.1)
    obtain ⟨y, hyK, hyO, hyZ⟩ := hFCpc O _ hO hZc.isOpen_compl hcov
      ⟨p₀, ⟨hp₀C, hp₀⟩, hp₀O⟩ ⟨x₁, hx₁, fun hxZ => hx₁O hxZ.1.1⟩
    apply hyZ
    refine ⟨⟨hyO, ?_⟩, hyK.2⟩
    rw [hw0 y hyO hyK.2]
    exact ht₀.le
  
  exact collar_cutoff_contradiction g U hUo N ε σ hNo hε hσs hσb hσp hWO x₀ hx₀ hthin
    O w hO hwc hw0 hwpos hws hdw hH hFCO

theorem jcc_scalar_trace (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i)
    (hGpos : ∀ y ∈ U, (G y).PosDef) (Φ : E3 → ℝ) (F : E2 → E3) (x : E2) (hFx : F x ∈ U)
    (hinj : Function.Injective (fderiv ℝ F x)) (hdΦ : fderiv ℝ Φ (F x) ≠ 0)
    (htan : ∀ i : Fin 2, fderiv ℝ Φ (F x) (fderiv ℝ F x (e2 i)) = 0) :
    scalarCurvatureLocal G (F x) =
      2 * ejpRic G Φ (F x) + 2 * gsAmbPlane G F x / (pullMetric2 G F x).det :=
by
  
  have cross : ∀ (Rm : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (P Gi : Fin 3 → Fin 3 → ℝ)
      (N : Fin 3 → ℝ) (S : ℝ),
      (∀ i j k m : Fin 3, Rm i j k m = -Rm j i k m) →
      (∀ i j k m : Fin 3, Rm i j k m = -Rm i j m k) →
      (∀ a b : Fin 3, Gi a b = P a b + N a * N b / S) →
      ∑ j : Fin 3, ∑ k : Fin 3, Gi j k * ∑ i : Fin 3, ∑ m : Fin 3, Gi i m * Rm i j k m =
        ∑ j : Fin 3, ∑ k : Fin 3, P j k * ∑ i : Fin 3, ∑ m : Fin 3, P i m * Rm i j k m +
          2 * ((∑ j : Fin 3, ∑ k : Fin 3,
            (∑ i : Fin 3, ∑ m : Fin 3, Gi i m * Rm i j k m) * N j * N k) / S) := by
    intro Rm P Gi N S h1 h2 hGi
    have z1 : ∀ i k m : Fin 3, Rm i i k m = 0 := fun i k m => by linarith [h1 i i k m]
    have z2 : ∀ i j k : Fin 3, Rm i j k k = 0 := fun i j k => by linarith [h2 i j k k]
    have a10 : ∀ k m : Fin 3, Rm 1 0 k m = -Rm 0 1 k m := fun k m => h1 1 0 k m
    have a20 : ∀ k m : Fin 3, Rm 2 0 k m = -Rm 0 2 k m := fun k m => h1 2 0 k m
    have a21 : ∀ k m : Fin 3, Rm 2 1 k m = -Rm 1 2 k m := fun k m => h1 2 1 k m
    have b10 : ∀ i j : Fin 3, Rm i j 1 0 = -Rm i j 0 1 := fun i j => h2 i j 1 0
    have b20 : ∀ i j : Fin 3, Rm i j 2 0 = -Rm i j 0 2 := fun i j => h2 i j 2 0
    have b21 : ∀ i j : Fin 3, Rm i j 2 1 = -Rm i j 1 2 := fun i j => h2 i j 2 1
    simp only [hGi, Fin.sum_univ_three, z1, z2, a10, a20, a21, b10, b20, b21, neg_neg,
      mul_neg, neg_mul, mul_zero, zero_mul, add_zero, zero_add, neg_zero]
    ring
  
  have tang : ∀ (Rm : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ)
      (hm : Matrix (Fin 2) (Fin 2) ℝ) (T : Fin 2 → Fin 3 → ℝ),
      (∀ i j k m : Fin 3, Rm i j k m = -Rm j i k m) →
      (∀ i j k m : Fin 3, Rm i j k m = -Rm i j m k) →
      ∑ j : Fin 3, ∑ k : Fin 3, (∑ c : Fin 2, ∑ d : Fin 2, hm⁻¹ c d * T c j * T d k) *
          ∑ i : Fin 3, ∑ m : Fin 3, (∑ c : Fin 2, ∑ d : Fin 2, hm⁻¹ c d * T c i * T d m) *
            Rm i j k m =
        2 * (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
          Rm i j k m * T 0 i * T 1 j * T 1 k * T 0 m) / hm.det := by
    intro Rm hm T h1 h2
    have z1 : ∀ i k m : Fin 3, Rm i i k m = 0 := fun i k m => by linarith [h1 i i k m]
    have z2 : ∀ i j k : Fin 3, Rm i j k k = 0 := fun i j k => by linarith [h2 i j k k]
    have a10 : ∀ k m : Fin 3, Rm 1 0 k m = -Rm 0 1 k m := fun k m => h1 1 0 k m
    have a20 : ∀ k m : Fin 3, Rm 2 0 k m = -Rm 0 2 k m := fun k m => h1 2 0 k m
    have a21 : ∀ k m : Fin 3, Rm 2 1 k m = -Rm 1 2 k m := fun k m => h1 2 1 k m
    have b10 : ∀ i j : Fin 3, Rm i j 1 0 = -Rm i j 0 1 := fun i j => h2 i j 1 0
    have b20 : ∀ i j : Fin 3, Rm i j 2 0 = -Rm i j 0 2 := fun i j => h2 i j 2 0
    have b21 : ∀ i j : Fin 3, Rm i j 2 1 = -Rm i j 1 2 := fun i j => h2 i j 2 1
    have hdi : hm.det⁻¹ = hm⁻¹ 0 0 * hm⁻¹ 1 1 - hm⁻¹ 0 1 * hm⁻¹ 1 0 := by
      rw [← Matrix.det_fin_two, Matrix.det_nonsing_inv, Ring.inverse_eq_inv']
    rw [div_eq_mul_inv, hdi]
    simp only [Fin.sum_univ_three, Fin.sum_univ_two, z1, z2, a10, a20, a21, b10, b20, b21,
      neg_neg, mul_neg, neg_mul, mul_zero, zero_mul, add_zero, zero_add, neg_zero]
    ring
  
  have hpos : (G (F x)).PosDef := hGpos (F x) hFx
  have hdet : (G (F x)).det ≠ 0 := hpos.det_pos.ne'
  
  have hrl : ∀ (l i j k : Fin 3) (y : E3),
      riemannLocal G l i j k y = -riemannLocal G l j i k y := by
    intro l i j k y
    simp only [riemannLocal, Finset.sum_sub_distrib]
    ring
  
  have hvec3 : ∀ v : E3, v = ∑ c : Fin 3, v c • e c := by
    intro v
    rw [Fin.sum_univ_three]
    apply PiLp.ext
    intro i
    fin_cases i <;> simp [e, EuclideanSpace.single_apply]
  have htan' : ∀ i : Fin 2,
      ∑ c : Fin 3, partialDeriv c Φ (F x) * (fderiv ℝ F x (e2 i)) c = 0 := by
    intro i
    have h0 := htan i
    rw [hvec3 (fderiv ℝ F x (e2 i)), map_sum] at h0
    rw [← h0]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [map_smul, smul_eq_mul, partialDeriv, mul_comm]
  
  obtain ⟨-, -, hP, -⟩ := ejpl_proj_linalg G Φ F x hpos hdΦ hinj htan'
  have hGi : ∀ a b : Fin 3, (G (F x))⁻¹ a b =
      (∑ c : Fin 2, ∑ d : Fin 2, (pullMetric2 G F x)⁻¹ c d * (fderiv ℝ F x (e2 c)) a *
        (fderiv ℝ F x (e2 d)) b) + ejpN G Φ (F x) a * ejpN G Φ (F x) b / ejpS G Φ (F x) := by
    intro a b
    have h := hP a b
    unfold ejpP at h
    linarith
  
  have hΓ := (ejp_coord_smooth G (fun _ => (0 : ℝ)) U hU hG hGpos contDiffOn_const).2.2.1
  have h2 : ∀ i j k m : Fin 3,
      ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x) =
        -∑ l : Fin 3, G (F x) k l * riemannLocal G l i j m (F x) :=
    amb_rm_antisymm G U hU hG hGsymm hGpos hΓ (F x) hFx
  
  have h1 : ∀ i j k m : Fin 3,
      ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x) =
        -∑ l : Fin 3, G (F x) m l * riemannLocal G l j i k (F x) := by
    intro i j k m
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [hrl l i j k (F x)]
    ring
  
  have hδ : ∀ i l : Fin 3, ∑ m : Fin 3, (G (F x))⁻¹ i m * G (F x) m l = if i = l then 1 else 0 := by
    intro i l
    have hGG : (G (F x))⁻¹ * G (F x) = 1 :=
      Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet)
    have := congrFun (congrFun hGG i) l
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  have hraise : ∀ j k : Fin 3, ricci G j k (F x) =
      ∑ i : Fin 3, ∑ m : Fin 3, (G (F x))⁻¹ i m *
        ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x) := by
    intro j k
    have ha1 : ricci G j k (F x) = ∑ i : Fin 3, riemannLocal G i i j k (F x) := by
      simp only [ricci, riemannLocal, Finset.sum_add_distrib]
    rw [ha1]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    symm
    calc ∑ m : Fin 3, (G (F x))⁻¹ i m * ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x)
        = ∑ l : Fin 3, (∑ m : Fin 3, (G (F x))⁻¹ i m * G (F x) m l) *
            riemannLocal G l i j k (F x) := by
          simp only [Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun m _ => ?_))
          ring
      _ = riemannLocal G i i j k (F x) := by
          simp only [hδ, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ,
            if_true]
  
  have hR : scalarCurvatureLocal G (F x) =
      ∑ j : Fin 3, ∑ k : Fin 3, (G (F x))⁻¹ j k * ∑ i : Fin 3, ∑ m : Fin 3, (G (F x))⁻¹ i m *
        ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x) := by
    unfold scalarCurvatureLocal
    simp only [hraise]
  have hRic : ejpRic G Φ (F x) =
      (∑ j : Fin 3, ∑ k : Fin 3, (∑ i : Fin 3, ∑ m : Fin 3, (G (F x))⁻¹ i m *
        ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x)) *
          ejpN G Φ (F x) j * ejpN G Φ (F x) k) / ejpS G Φ (F x) := by
    unfold ejpRic
    simp only [hraise]
  
  have hamb : gsAmbPlane G F x =
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ m : Fin 3,
        (∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x)) *
          (fderiv ℝ F x (e2 0)) i * (fderiv ℝ F x (e2 1)) j * (fderiv ℝ F x (e2 1)) k *
            (fderiv ℝ F x (e2 0)) m := by
    unfold gsAmbPlane gsTan
    simp only [Fin.sum_univ_three]
    ring
  
  have hX := cross (fun i j k m => ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x))
    (fun a b => ∑ c : Fin 2, ∑ d : Fin 2, (pullMetric2 G F x)⁻¹ c d * (fderiv ℝ F x (e2 c)) a *
        (fderiv ℝ F x (e2 d)) b)
    (fun a b => (G (F x))⁻¹ a b) (fun a => ejpN G Φ (F x) a) (ejpS G Φ (F x)) h1 h2 hGi
  have hY := tang (fun i j k m => ∑ l : Fin 3, G (F x) m l * riemannLocal G l i j k (F x))
    (pullMetric2 G F x) (fun c a => (fderiv ℝ F x (e2 c)) a) h1 h2
  beta_reduce at hX hY
  linear_combination hR + hX + hY - 2 * hRic - (2 / (pullMetric2 G F x).det) * hamb

theorem gaussCurv2_conformal_mul (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (u : E2 → ℝ) (s : Set E2)
    (hs : IsOpen s) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => h y i j) s)
    (hsymm : ∀ y ∈ s, ∀ i j : Fin 2, h y i j = h y j i) (hpos : ∀ y ∈ s, (h y).PosDef)
    (hu : ContDiffOn ℝ ∞ u s) (hupos : ∀ y ∈ s, 0 < u y) (x : E2) (hx : x ∈ s) :
    gaussCurv2 (fun y => (u y) ^ 2 • h y) x * (u x) ^ 2 =
      gaussCurv2 h x - lap2 h u x / u x +
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a u x * pd2 b u x) / (u x) ^ 2 :=
by
  
  have inv_entry_pd2 : ∀ (G : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2)
      (hG : ∀ a b : Fin 2, DifferentiableAt ℝ (fun y => G y a b) x)
      (hdet : (G x).det ≠ 0) (m : Fin 2),
      ∀ k l : Fin 2, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
        pd2 m (fun y => (G y)⁻¹ k l) x =
          -∑ a : Fin 2, ∑ b : Fin 2,
            (G x)⁻¹ k a * pd2 m (fun y => G y a b) x * (G x)⁻¹ b l := (by
    intro G x hG hdet m
    have hdetD : ∀ H : E2 → Matrix (Fin 2) (Fin 2) ℝ,
        (∀ a b : Fin 2, DifferentiableAt ℝ (fun y => H y a b) x) →
        DifferentiableAt ℝ (fun y => (H y).det) x := by
      intro H hH
      have hfun : (fun y => (H y).det) = fun y =>
          H y 0 0 * H y 1 1 - H y 0 1 * H y 1 0 := by
        funext y; exact Matrix.det_fin_two (H y)
      rw [hfun]
      have h00 := hH 0 0
      have h01 := hH 0 1
      have h10 := hH 1 0
      have h11 := hH 1 1
      fun_prop
    have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
    have hP : ∀ k l : Fin 2, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
      intro k l
      have hfun : (fun y => (G y)⁻¹ k l) =
          fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
        funext y
        rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
          smul_eq_mul]
      rw [hfun]
      refine (hD.inv hdet).mul (hdetD _ ?_)
      intro a b
      by_cases hal : a = l
      · subst hal
        simp only [Matrix.updateRow_self]
        exact differentiableAt_const _
      · simp only [Matrix.updateRow_ne hal]
        exact hG a b
    have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
    have hE : ∀ a l : Fin 2, ∑ b : Fin 2, G x a b * pd2 m (fun y => (G y)⁻¹ b l) x
        + ∑ b : Fin 2, pd2 m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun y => ∑ b : Fin 2, G y a b * (G y)⁻¹ b l)
          (∑ b : Fin 2, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
            + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b y => G y a b * (G y)⁻¹ b l)
          (fun b _ => (hG a b).hasFDerivAt.mul (hP b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun y => ∑ b : Fin 2, G y a b * (G y)⁻¹ b l)
          (0 : E2 →L[ℝ] ℝ) x := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
        filter_upwards [hev] with y hy
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold pd2
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    refine ⟨hP k l, ?_⟩
    let X : Matrix (Fin 2) (Fin 2) ℝ :=
      Matrix.of fun b l => pd2 m (fun y => (G y)⁻¹ b l) x
    let D : Matrix (Fin 2) (Fin 2) ℝ :=
      Matrix.of fun a b => pd2 m (fun y => G y a b) x
    have hM : G x * X = -(D * (G x)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, D, Matrix.of_apply]
      exact hE a l'
    have hX : X = -((G x)⁻¹ * (D * (G x)⁻¹)) := by
      calc X = ((G x)⁻¹ * G x) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
        _ = (G x)⁻¹ * (G x * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [X, D, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring)

  
  have conf_chr : ∀ (G : E2 → Matrix (Fin 2) (Fin 2) ℝ) (u : E2 → ℝ) (z : E2)
      (hG : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x => G x a b) z) (hu : DifferentiableAt ℝ u z)
      (hsymm : ∀ a b : Fin 2, G z a b = G z b a) (hdet : (G z).det ≠ 0) (hu0 : u z ≠ 0)
      (k i j : Fin 2),
      christoffel2 (fun x => (u x ^ 2) • G x) k i j z = christoffel2 G k i j z +
        ((if k = i then (u z)⁻¹ * pd2 j u z else 0) +
          (if k = j then (u z)⁻¹ * pd2 i u z else 0) -
          G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) := (by
    intro G u z hG hu hsymm hdet hu0 k i j
    have hu2 : u z ^ 2 ≠ 0 := pow_ne_zero 2 hu0
    have hinvz : (u z ^ 2 • G z)⁻¹ = (u z ^ 2)⁻¹ • (G z)⁻¹ := by
      apply Matrix.inv_eq_right_inv
      rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet),
        smul_smul, mul_inv_cancel₀ hu2, one_smul]
    have hprod : ∀ c a b, pd2 c (fun x => u x ^ 2 * G x a b) z =
        u z ^ 2 * pd2 c (fun x => G x a b) z + G z a b * (2 * u z * pd2 c u z) := by
      intro c a b
      have h4 : HasFDerivAt (fun x => u x ^ 2) (((2 : ℕ) * u z ^ (2 - 1) : ℝ) • fderiv ℝ u z) z :=
        (hasDerivAt_pow 2 (u z)).comp_hasFDerivAt z hu.hasFDerivAt
      have h : HasFDerivAt (fun x => u x ^ 2 * G x a b) (u z ^ 2 • fderiv ℝ (fun x => G x a b) z
          + G z a b • (((2 : ℕ) * u z ^ (2 - 1) : ℝ) • fderiv ℝ u z)) z :=
        h4.mul (hG a b).hasFDerivAt
      unfold pd2
      rw [h.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      norm_num
    have hPG : ∀ a b, ∑ l, (G z)⁻¹ a l * G z b l = if a = b then 1 else 0 := by
      intro a b
      have h := congrFun (congrFun (Matrix.nonsing_inv_mul (G z) (isUnit_iff_ne_zero.mpr hdet)) a) b
      rw [Matrix.mul_apply, Matrix.one_apply] at h
      rw [← h]
      exact Finset.sum_congr rfl fun l _ => by rw [hsymm b l]
    have hite : ∀ a b (X : ℝ), (if a = b then X else 0) = (∑ l, (G z)⁻¹ a l * G z b l) * X := by
      intro a b X
      rw [hPG]
      split_ifs <;> ring
    rw [hite k i, hite k j]
    simp only [christoffel2, hinvz, Matrix.smul_apply, smul_eq_mul, hprod]
    simp only [Fin.sum_univ_two]
    field_simp
    ring)

  have christoffel2_differentiableAt : ∀ (G : E2 → Matrix (Fin 2) (Fin 2) ℝ) (U : Set E2)
      (hU : IsOpen U) (hG : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => G x i j) U) (y : E2)
      (hy : y ∈ U) (hdet : (G y).det ≠ 0) (k i j : Fin 2),
      DifferentiableAt ℝ (christoffel2 G k i j) y := (by
    intro G U hU hG y hy hdet k i j
    have hGd : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x => G x a b) y := fun a b =>
      ((hG a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
    have hPd : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x => (G x)⁻¹ a b) y := fun a b =>
      (inv_entry_pd2 G y hGd hdet 0 a b).1
    have hdGd : ∀ c a b : Fin 2, DifferentiableAt ℝ (fun x => pd2 c (fun z => G z a b) x) y := by
      intro c a b
      have h1 : ContDiffOn ℝ ∞ (fun x => pd2 c (fun z => G z a b) x) U :=
        ((hG a b).fderiv_of_isOpen hU (le_of_eq rfl)).clm_apply contDiffOn_const
      exact (h1.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
    show DifferentiableAt ℝ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (G x)⁻¹ k l *
      (pd2 i (fun z => G z j l) x + pd2 j (fun z => G z i l) x
        - pd2 l (fun z => G z i j) x)) y
    refine DifferentiableAt.const_mul (DifferentiableAt.sum (u := Finset.univ)
      (A := fun l x => (G x)⁻¹ k l * (pd2 i (fun z => G z j l) x
        + pd2 j (fun z => G z i l) x - pd2 l (fun z => G z i j) x))
      fun l _ => ?_) _
    exact (hPd k l).mul (((hdGd i j l).add (hdGd j i l)).sub (hdGd l i j)))

  have conf_C_pd : ∀ (G : E2 → Matrix (Fin 2) (Fin 2) ℝ) (u : E2 → ℝ)
    (U : Set E2)
    (hU : IsOpen U) (hG : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => G x i j) U)
    (hu : ContDiffOn ℝ ∞ u U) (y : E2) (hy : y ∈ U) (hdet : (G y).det ≠ 0) (hu0 : u y ≠ 0)
    (k i j m : Fin 2),
    DifferentiableAt ℝ (fun z => (if k = i then (u z)⁻¹ * pd2 j u z else 0) +
        (if k = j then (u z)⁻¹ * pd2 i u z else 0) -
        G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) y ∧
    pd2 m (fun z => (if k = i then (u z)⁻¹ * pd2 j u z else 0) +
        (if k = j then (u z)⁻¹ * pd2 i u z else 0) -
        G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) y =
      (if k = i then (u y)⁻¹ * pd2 m (pd2 j u) y -
          ((u y)⁻¹) ^ 2 * pd2 m u y * pd2 j u y else 0) +
        (if k = j then (u y)⁻¹ * pd2 m (pd2 i u) y -
          ((u y)⁻¹) ^ 2 * pd2 m u y * pd2 i u y else 0) -
        pd2 m (fun z => G z i j) y *
          ∑ l : Fin 2, (G y)⁻¹ k l * ((u y)⁻¹ * pd2 l u y) -
        G y i j * ∑ l : Fin 2,
          ((-∑ a : Fin 2, ∑ b : Fin 2,
              (G y)⁻¹ k a * pd2 m (fun z => G z a b) y * (G y)⁻¹ b l) *
              ((u y)⁻¹ * pd2 l u y) +
            (G y)⁻¹ k l * ((u y)⁻¹ * pd2 m (pd2 l u) y -
              ((u y)⁻¹) ^ 2 * pd2 m u y * pd2 l u y)) := (by
    intro G u U hU hG hu y hy hdet hu0 k i j m
    have hGd : ∀ a b : Fin 2, DifferentiableAt ℝ (fun x => G x a b) y := fun a b =>
      ((hG a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
    have hud : DifferentiableAt ℝ u y :=
      (hu.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
    have hdud : ∀ a : Fin 2, DifferentiableAt ℝ (pd2 a u) y := by
      intro a
      have h1 : ContDiffOn ℝ ∞ (pd2 a u) U :=
        (hu.fderiv_of_isOpen hU (le_of_eq rfl)).clm_apply contDiffOn_const
      exact (h1.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy)
    have hinvE := inv_entry_pd2 G y hGd hdet m
    have hr : HasFDerivAt (fun z => (u z)⁻¹) ((-(u y ^ 2)⁻¹) • fderiv ℝ u y) y :=
      (hasDerivAt_inv hu0).comp_hasFDerivAt y hud.hasFDerivAt
    have hψ : ∀ a : Fin 2, HasFDerivAt (fun z => (u z)⁻¹ * pd2 a u z)
        ((u y)⁻¹ • fderiv ℝ (pd2 a u) y + pd2 a u y • ((-(u y ^ 2)⁻¹) • fderiv ℝ u y)) y := by
      intro a
      exact hr.mul (hdud a).hasFDerivAt
    have hS : HasFDerivAt (fun z => ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z))
        (∑ l : Fin 2, ((G y)⁻¹ k l • ((u y)⁻¹ • fderiv ℝ (pd2 l u) y
          + pd2 l u y • ((-(u y ^ 2)⁻¹) • fderiv ℝ u y))
          + ((u y)⁻¹ * pd2 l u y) • fderiv ℝ (fun z => (G z)⁻¹ k l) y)) y :=
      HasFDerivAt.sum (u := Finset.univ)
        (A := fun l z => (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z))
        fun l _ => (hinvE k l).1.hasFDerivAt.mul (hψ l)
    have hfun : (fun z => (if k = i then (u z)⁻¹ * pd2 j u z else 0) +
          (if k = j then (u z)⁻¹ * pd2 i u z else 0) -
          G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) =
        (fun z => (if k = i then (1 : ℝ) else 0) * ((u z)⁻¹ * pd2 j u z) +
          (if k = j then (1 : ℝ) else 0) * ((u z)⁻¹ * pd2 i u z) -
          G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) := by
      funext z
      split_ifs <;> ring
    have hF : HasFDerivAt (fun z => (if k = i then (1 : ℝ) else 0) * ((u z)⁻¹ * pd2 j u z) +
          (if k = j then (1 : ℝ) else 0) * ((u z)⁻¹ * pd2 i u z) -
          G z i j * ∑ l : Fin 2, (G z)⁻¹ k l * ((u z)⁻¹ * pd2 l u z)) _ y :=
      (((hψ j).const_mul _).add ((hψ i).const_mul _)).sub ((hGd i j).hasFDerivAt.mul hS)
    rw [hfun]
    refine ⟨hF.differentiableAt, ?_⟩
    have hP' : ∀ l, (fderiv ℝ (fun z => (G z)⁻¹ k l) y) (e2 m) =
        -∑ a : Fin 2, ∑ b : Fin 2, (G y)⁻¹ k a * pd2 m (fun z => G z a b) y * (G y)⁻¹ b l :=
      fun l => (hinvE k l).2
    show (fderiv ℝ _ y) (e2 m) = _
    rw [hF.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.sum_apply, smul_eq_mul, hP']
    simp only [pd2, Fin.sum_univ_two]
    split_ifs <;> ring)

  have alg_D : ∀ (G P : Fin 2 → Fin 2 → ℝ) (dG : Fin 2 → Fin 2 → Fin 2 → ℝ)
    (psi Q : Fin 2 → ℝ) (dpsi : Fin 2 → Fin 2 → ℝ) (dP : Fin 2 → Fin 2 → Fin 2 → ℝ)
    (dC : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ)
    (hG : ∀ a b, G a b = G b a) (hP : ∀ a b, P a b = P b a)
    (hdG : ∀ c a b, dG c a b = dG c b a)
    (hPG : ∀ a b, ∑ l, P a l * G l b = if a = b then 1 else 0)
    (hQ : ∀ k, Q k = ∑ l, P k l * psi l)
    (hdP : ∀ m k l, dP m k l = -∑ a, ∑ b, P k a * dG m a b * P b l)
    (hdC : ∀ m k i j, dC m k i j = (if k = i then dpsi m j else 0) + (if k = j then dpsi m i else 0)
      - dG m i j * Q k - G i j * ∑ l, (dP m k l * psi l + P k l * dpsi m l)),
    ∑ j, ∑ k, P j k * ∑ i, (dC i i j k - dC j i i k) =
      -2 * ∑ j, ∑ k, P j k * dpsi j k - ∑ i, (∑ j, ∑ k, P j k * dG i j k) * Q i
        + 2 * ∑ j, ∑ k, ∑ l, P j k * dG j k l * Q l := (by
    intro G P dG psi Q dpsi dP dC hG hP hdG hPG hQ hdP hdC
    have hGP : ∀ a b, ∑ l, G a l * P l b = if a = b then 1 else 0 := by
      intro a b
      have e : (if a = b then (1:ℝ) else 0) = if b = a then 1 else 0 := by
        rcases eq_or_ne a b with h | h
        · subst h; rfl
        · rw [if_neg h, if_neg h.symm]
      rw [e, ← hPG b a]
      exact Finset.sum_congr rfl fun l _ => by rw [hG a l, hP l b, mul_comm]
    have hK1 : ∀ k a, ∑ i, G i k * P i a = if k = a then 1 else 0 := by
      intro k a; rw [← hGP k a]; exact Finset.sum_congr rfl fun i _ => by rw [hG i k]
    have hcon : ∀ k (f : Fin 2 → ℝ), ∑ i, G i k * ∑ a, P i a * f a = f k := by
      intro k f
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      have e2 : ∀ a, ∑ i, G i k * (P i a * f a) = (if k = a then 1 else 0) * f a := by
        intro a; rw [← hK1 k a, Finset.sum_mul]; exact Finset.sum_congr rfl fun i _ => by ring
      simp only [e2, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hK2 : ∑ j, ∑ k, P j k * G j k = 2 := by
      have h : ∀ j, ∑ k, P j k * G j k = 1 := by
        intro j
        have h1 := hPG j j
        rw [if_pos rfl] at h1
        rw [← h1]
        exact Finset.sum_congr rfl fun k _ => by rw [hG j k]
      simp only [h, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      norm_num
    have hdPpsi : ∀ m i, ∑ l, dP m i l * psi l = ∑ a, P i a * (-∑ b, dG m a b * Q b) := by
      intro m i; simp only [hdP, hQ, Fin.sum_univ_two]; ring
    have hD2 : ∀ j k, ∑ i, dC j i i k = 2 * dpsi j k := by
      intro j k
      have e : ∀ i, dC j i i k = (if i = i then dpsi j k else 0) + (if i = k then dpsi j i else 0)
          - dG j i k * Q i - (G i k * ∑ a, P i a * (-∑ b, dG j a b * Q b)
            + G i k * ∑ l, P i l * dpsi j l) := by
        intro i; rw [hdC, Finset.sum_add_distrib, hdPpsi]; ring
      simp only [e, Finset.sum_add_distrib, Finset.sum_sub_distrib, if_true, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat, Finset.sum_ite_eq',
        Finset.mem_univ, hcon]
      have h3 : ∑ i, dG j i k * Q i = ∑ b, dG j k b * Q b :=
        Finset.sum_congr rfl fun i _ => by rw [hdG j i k]
      rw [h3]; ring
    have e1 : ∀ j k, ∑ i, (dC i i j k - dC j i i k) = ∑ i, dC i i j k - 2 * dpsi j k := by
      intro j k; rw [Finset.sum_sub_distrib, hD2]
    simp only [e1]
    simp only [hdC, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    linear_combination (norm := skip)
      (∑ j, ∑ k, ∑ l, P j k * dG j k l * Q l - ∑ j, ∑ k, P j k * dpsi j k) * hK2
    simp only [Fin.sum_univ_two, hdP, hQ, hP]
    ring1)

  have alg_X : ∀ (G P : Fin 2 → Fin 2 → ℝ) (dG : Fin 2 → Fin 2 → Fin 2 → ℝ)
    (psi Q : Fin 2 → ℝ) (Γ C : Fin 2 → Fin 2 → Fin 2 → ℝ)
    (hG : ∀ a b, G a b = G b a) (hP : ∀ a b, P a b = P b a)
    (hdG : ∀ c a b, dG c a b = dG c b a)
    (hPG : ∀ a b, ∑ l, P a l * G l b = if a = b then 1 else 0)
    (hQ : ∀ k, Q k = ∑ l, P k l * psi l)
    (hΓ : ∀ k i j, Γ k i j = (1 / 2 : ℝ) * ∑ l, P k l * (dG i j l + dG j i l - dG l i j))
    (hC : ∀ k i j, C k i j = (if k = i then psi j else 0) + (if k = j then psi i else 0)
      - G i j * Q k),
    (∑ j, ∑ k, P j k * ∑ i, ∑ p, (Γ i i p * C p j k + C i i p * Γ p j k
        - Γ i j p * C p i k - C i j p * Γ p i k) = 0) ∧
    (∑ p, psi p * ∑ j, ∑ k, P j k * Γ p j k =
      ∑ j, ∑ k, ∑ l, P j k * dG j k l * Q l - (1 / 2 : ℝ) * ∑ l, (∑ j, ∑ k, P j k * dG l j k) * Q l) := (by
    intro G P dG psi Q Γ C hG hP hdG hPG hQ hΓ hC
    have hGP : ∀ a b, ∑ l, G a l * P l b = if a = b then 1 else 0 := by
      intro a b
      have e : (if a = b then (1:ℝ) else 0) = if b = a then 1 else 0 := by
        rcases eq_or_ne a b with h | h
        · subst h; rfl
        · rw [if_neg h, if_neg h.symm]
      rw [e, ← hPG b a]
      exact Finset.sum_congr rfl fun l _ => by rw [hG a l, hP l b, mul_comm]
    have hK3 : ∀ a, ∑ i, G a i * Q i = psi a := by
      intro a
      have e : ∀ i, G a i * Q i = ∑ l, G a i * P i l * psi l := by
        intro i; rw [hQ, Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by ring
      simp only [e]
      rw [Finset.sum_comm]
      have e2 : ∀ l, ∑ i, G a i * P i l * psi l = (if a = l then 1 else 0) * psi l := by
        intro l; rw [← hGP a l, Finset.sum_mul]
      simp only [e2, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hK3' : ∀ a, ∑ i, G i a * Q i = psi a := by
      intro a; rw [← hK3 a]; exact Finset.sum_congr rfl fun i _ => by rw [hG i a]
    have hK2 : ∑ j, ∑ k, P j k * G j k = 2 := by
      have h : ∀ j, ∑ k, P j k * G j k = 1 := by
        intro j
        have h1 := hPG j j
        rw [if_pos rfl] at h1
        rw [← h1]
        exact Finset.sum_congr rfl fun k _ => by rw [hG j k]
      simp only [h, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      norm_num
    have hX2 : ∀ p, ∑ i, C i i p = 2 * psi p := by
      intro p
      simp only [hC, Finset.sum_add_distrib, Finset.sum_sub_distrib, if_true, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat, Finset.sum_ite_eq',
        Finset.mem_univ, hK3']
      ring
    have hX1 : ∀ p, ∑ j, ∑ k, P j k * C p j k = 0 := by
      intro p
      have e : ∀ j k, P j k * C p j k = (if p = j then (1:ℝ) else 0) * (P j k * psi k)
          + (if p = k then (1:ℝ) else 0) * (P j k * psi j) - P j k * G j k * Q p := by
        intro j k; rw [hC]; split_ifs <;> ring
      simp only [e, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
        ← Finset.sum_mul]
      simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true, hK2]
      rw [hQ p]
      have h2 : ∑ j, P j p * psi j = ∑ l, P p l * psi l :=
        Finset.sum_congr rfl fun j _ => by rw [hP j p]
      rw [h2]; ring
    have hX0 : ∀ k i j, Γ k i j = Γ k j i := by
      intro k i j
      simp only [hΓ, Fin.sum_univ_two, hdG]
      ring
    have hX4 : ∑ p, psi p * ∑ j, ∑ k, P j k * Γ p j k =
        ∑ j, ∑ k, ∑ l, P j k * dG j k l * Q l - (1 / 2 : ℝ) * ∑ l, (∑ j, ∑ k, P j k * dG l j k) * Q l := by
      simp only [hΓ, hQ, Fin.sum_univ_two, hP]
      ring
    have hT3c : ∑ j, ∑ i, (∑ p, Γ i j p * Q p) * (∑ k, P j k * G k i) = ∑ i, ∑ p, Γ i i p * Q p := by
      simp only [hPG, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
    have hT4c : ∑ k, ∑ p, (∑ i, Q i * Γ p i k) * (∑ j, P k j * G j p) = ∑ p, ∑ i, Q i * Γ p i p := by
      simp only [hPG, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
    refine ⟨?_, hX4⟩
    have e1 : ∑ j, ∑ k, P j k * ∑ i, ∑ p, (Γ i i p * C p j k + C i i p * Γ p j k
          - Γ i j p * C p i k - C i j p * Γ p i k) =
        ∑ p, (∑ i, Γ i i p) * (∑ j, ∑ k, P j k * C p j k)
          + ∑ p, (∑ i, C i i p) * (∑ j, ∑ k, P j k * Γ p j k)
          - ∑ j, ∑ k, P j k * ∑ i, ∑ p, Γ i j p * C p i k
          - ∑ j, ∑ k, P j k * ∑ i, ∑ p, C i j p * Γ p i k := by
      simp only [Fin.sum_univ_two]
      ring
    rw [e1]
    simp only [hX1, hX2]
    simp only [hC, add_mul, mul_add, sub_mul, mul_sub, ite_mul, mul_ite, zero_mul, mul_zero,
      Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_irrel, Finset.sum_ite_eq,
      Finset.sum_ite_eq', Finset.mem_univ, if_true, Finset.sum_const_zero, Finset.sum_const,
      Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat]
    linear_combination (norm := skip) hT3c + hT4c
    simp only [Fin.sum_univ_two, hQ, hP, hG, hX0]
    ring1)

  have alg_Y : ∀ (G P : Fin 2 → Fin 2 → ℝ) (psi Q : Fin 2 → ℝ)
    (C : Fin 2 → Fin 2 → Fin 2 → ℝ)
    (hG : ∀ a b, G a b = G b a) (hP : ∀ a b, P a b = P b a)
    (hPG : ∀ a b, ∑ l, P a l * G l b = if a = b then 1 else 0)
    (hQ : ∀ k, Q k = ∑ l, P k l * psi l)
    (hC : ∀ k i j, C k i j = (if k = i then psi j else 0) + (if k = j then psi i else 0)
      - G i j * Q k),
    ∑ j, ∑ k, P j k * ∑ i, ∑ p, (C i i p * C p j k - C i j p * C p i k) = 0 := (by
    intro G P psi Q C hG hP hPG hQ hC
    have hGP : ∀ a b, ∑ l, G a l * P l b = if a = b then 1 else 0 := by
      intro a b
      have e : (if a = b then (1:ℝ) else 0) = if b = a then 1 else 0 := by
        rcases eq_or_ne a b with h | h
        · subst h; rfl
        · rw [if_neg h, if_neg h.symm]
      rw [e, ← hPG b a]
      exact Finset.sum_congr rfl fun l _ => by rw [hG a l, hP l b, mul_comm]
    have hK3 : ∀ a, ∑ i, G a i * Q i = psi a := by
      intro a
      have e : ∀ i, G a i * Q i = ∑ l, G a i * P i l * psi l := by
        intro i; rw [hQ, Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by ring
      simp only [e]
      rw [Finset.sum_comm]
      have e2 : ∀ l, ∑ i, G a i * P i l * psi l = (if a = l then 1 else 0) * psi l := by
        intro l; rw [← hGP a l, Finset.sum_mul]
      simp only [e2, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hK3' : ∀ a, ∑ i, G i a * Q i = psi a := by
      intro a; rw [← hK3 a]; exact Finset.sum_congr rfl fun i _ => by rw [hG i a]
    have hK2 : ∑ j, ∑ k, P j k * G j k = 2 := by
      have h : ∀ j, ∑ k, P j k * G j k = 1 := by
        intro j
        have h1 := hPG j j
        rw [if_pos rfl] at h1
        rw [← h1]
        exact Finset.sum_congr rfl fun k _ => by rw [hG j k]
      simp only [h, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      norm_num
    have hX2 : ∀ p, ∑ i, C i i p = 2 * psi p := by
      intro p
      simp only [hC, Finset.sum_add_distrib, Finset.sum_sub_distrib, if_true, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat, Finset.sum_ite_eq',
        Finset.mem_univ, hK3']
      ring
    have hX1 : ∀ p, ∑ j, ∑ k, P j k * C p j k = 0 := by
      intro p
      have e : ∀ j k, P j k * C p j k = (if p = j then (1:ℝ) else 0) * (P j k * psi k)
          + (if p = k then (1:ℝ) else 0) * (P j k * psi j) - P j k * G j k * Q p := by
        intro j k; rw [hC]; split_ifs <;> ring
      simp only [e, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
        ← Finset.sum_mul]
      simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true, hK2]
      rw [hQ p]
      have h2 : ∑ j, P j p * psi j = ∑ l, P p l * psi l :=
        Finset.sum_congr rfl fun j _ => by rw [hP j p]
      rw [h2]; ring
    have hS : ∑ p, psi p * Q p = ∑ a, ∑ b, P a b * psi a * psi b := by
      simp only [hQ, Finset.mul_sum]
      exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
    have hIn : ∀ j k, ∑ i, ∑ p, C i j p * C p i k
        = 4 * psi j * psi k - 2 * G j k * ∑ p, psi p * Q p := by
      intro j k
      simp only [hC, add_mul, mul_add, sub_mul, mul_sub, ite_mul, mul_ite, zero_mul, mul_zero,
        Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_irrel, Finset.sum_ite_eq,
        Finset.sum_ite_eq', Finset.mem_univ, if_true, Finset.sum_const_zero, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat]
      linear_combination (norm := skip) (∑ i, G k i * Q i - psi k) * hK3 j
      simp only [Fin.sum_univ_two, hG]
      ring1
    have e1 : ∑ j, ∑ k, P j k * ∑ i, ∑ p, (C i i p * C p j k - C i j p * C p i k) =
        ∑ p, (∑ i, C i i p) * (∑ j, ∑ k, P j k * C p j k)
          - ∑ j, ∑ k, P j k * ∑ i, ∑ p, C i j p * C p i k := by
      simp only [Fin.sum_univ_two]
      ring
    rw [e1]
    simp only [hX2, hX1, hIn]
    linear_combination (norm := skip) (2 * ∑ p, psi p * Q p) * hK2 + 4 * hS
    simp only [Fin.sum_univ_two]
    ring1)

  
  have hu0 : u x ≠ 0 := (hupos x hx).ne'
  have hdet : ∀ z ∈ s, (h z).det ≠ 0 := fun z hz => (hpos z hz).det_pos.ne'
  have hdy : (h x).det ≠ 0 := hdet x hx
  have hGd : ∀ z ∈ s, ∀ a b : Fin 2, DifferentiableAt ℝ (fun y => h y a b) z := fun z hz a b =>
    ((hh a b).differentiableOn (by simp)).differentiableAt (hs.mem_nhds hz)
  have hud : ∀ z ∈ s, DifferentiableAt ℝ u z := fun z hz =>
    (hu.differentiableOn (by simp)).differentiableAt (hs.mem_nhds hz)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Fin 2 → ℝ, ψ = fun l => (u x)⁻¹ * pd2 l u x := ⟨_, rfl⟩
  obtain ⟨dψ, hdψ⟩ : ∃ dψ : Fin 2 → Fin 2 → ℝ, dψ = fun m a =>
      (u x)⁻¹ * pd2 m (pd2 a u) x - ((u x)⁻¹) ^ 2 * pd2 m u x * pd2 a u x := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : Fin 2 → Fin 2 → ℝ, P = fun a b => (h x)⁻¹ a b := ⟨_, rfl⟩
  obtain ⟨Gy, hGy⟩ : ∃ Gy : Fin 2 → Fin 2 → ℝ, Gy = fun a b => h x a b := ⟨_, rfl⟩
  obtain ⟨dG, hdG⟩ : ∃ dG : Fin 2 → Fin 2 → Fin 2 → ℝ,
      dG = fun c a b => pd2 c (fun z => h z a b) x := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : Fin 2 → ℝ, Q = fun k => ∑ l, P k l * ψ l := ⟨_, rfl⟩
  obtain ⟨dP, hdP⟩ : ∃ dP : Fin 2 → Fin 2 → Fin 2 → ℝ,
      dP = fun m k l => -∑ a, ∑ b, P k a * dG m a b * P b l := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C : Fin 2 → Fin 2 → Fin 2 → ℝ, C = fun k i j =>
      (if k = i then ψ j else 0) + (if k = j then ψ i else 0) - Gy i j * Q k := ⟨_, rfl⟩
  obtain ⟨dC, hdC⟩ : ∃ dC : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ, dC = fun m k i j =>
      (if k = i then dψ m j else 0) + (if k = j then dψ m i else 0)
        - dG m i j * Q k - Gy i j * ∑ l, (dP m k l * ψ l + P k l * dψ m l) := ⟨_, rfl⟩
  obtain ⟨Γ, hΓ⟩ : ∃ Γ : Fin 2 → Fin 2 → Fin 2 → ℝ, Γ = fun k i j => christoffel2 h k i j x :=
    ⟨_, rfl⟩
  
  have hPe : ∀ a b, (h x)⁻¹ a b = P a b := fun a b => by rw [hP]
  have hGT : (h x).transpose = h x := by
    ext a b
    rw [Matrix.transpose_apply]
    exact hsymm x hx b a
  have hPs : ∀ a b, (h x)⁻¹ a b = (h x)⁻¹ b a := by
    intro a b
    have h' := congrFun (congrFun (Matrix.transpose_nonsing_inv (h x)) b) a
    rw [hGT, Matrix.transpose_apply] at h'
    exact h'
  have hG1 : ∀ a b, Gy a b = Gy b a := by
    intro a b; simp only [hGy]; exact hsymm x hx a b
  have hP1 : ∀ a b, P a b = P b a := by
    intro a b; simp only [hP]; exact hPs a b
  have hdG1 : ∀ c a b, dG c a b = dG c b a := by
    intro c a b
    simp only [hdG]
    have hev : (fun z => h z a b) =ᶠ[𝓝 x] (fun z => h z b a) :=
      Filter.eventually_of_mem (hs.mem_nhds hx) (fun z hz => hsymm z hz a b)
    unfold pd2
    rw [hev.fderiv_eq]
  have hPG1 : ∀ a b, ∑ l, P a l * Gy l b = if a = b then 1 else 0 := by
    intro a b
    simp only [hP, hGy]
    have h' := congrFun (congrFun (Matrix.nonsing_inv_mul (h x) (isUnit_iff_ne_zero.mpr hdy)) a) b
    rw [Matrix.mul_apply, Matrix.one_apply] at h'
    exact h'
  have hQ1 : ∀ k, Q k = ∑ l, P k l * ψ l := fun k => by rw [hQ]
  have hdP1 : ∀ m k l, dP m k l = -∑ a, ∑ b, P k a * dG m a b * P b l := fun m k l => by rw [hdP]
  have hC1 : ∀ k i j, C k i j = (if k = i then ψ j else 0) + (if k = j then ψ i else 0)
      - Gy i j * Q k := fun k i j => by rw [hC]
  have hdC1 : ∀ m k i j, dC m k i j = (if k = i then dψ m j else 0) + (if k = j then dψ m i else 0)
      - dG m i j * Q k - Gy i j * ∑ l, (dP m k l * ψ l + P k l * dψ m l) :=
    fun m k i j => by rw [hdC]
  have hΓ1 : ∀ k i j, Γ k i j = (1 / 2 : ℝ) * ∑ l, P k l * (dG i j l + dG j i l - dG l i j) := by
    intro k i j
    simp only [hΓ, hP, hdG]
    rfl
  
  have hinv : ∀ j k, (u x ^ 2 • h x)⁻¹ j k = (u x ^ 2)⁻¹ * P j k := by
    intro j k
    have h2 : u x ^ 2 ≠ 0 := pow_ne_zero 2 hu0
    have hm : (u x ^ 2 • h x)⁻¹ = (u x ^ 2)⁻¹ • (h x)⁻¹ := by
      apply Matrix.inv_eq_right_inv
      rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdy),
        smul_smul, mul_inv_cancel₀ h2, one_smul]
    rw [hm, Matrix.smul_apply, smul_eq_mul, hPe]
  
  have hΓ' : ∀ a b c, christoffel2 (fun y => (u y) ^ 2 • h y) a b c x = Γ a b c + C a b c := by
    intro a b c
    rw [conf_chr h u x (hGd x hx) (hud x hx) (hsymm x hx) hdy hu0 a b c]
    simp only [hΓ, hC, hQ, hψ, hGy, hP]
  
  have hDΓ' : ∀ m a b c, pd2 m (christoffel2 (fun y => (u y) ^ 2 • h y) a b c) x =
      pd2 m (christoffel2 h a b c) x + dC m a b c := by
    intro m a b c
    have hev : christoffel2 (fun y => (u y) ^ 2 • h y) a b c =ᶠ[𝓝 x] fun z =>
        christoffel2 h a b c z + ((if a = b then (u z)⁻¹ * pd2 c u z else 0) +
          (if a = c then (u z)⁻¹ * pd2 b u z else 0) -
          h z b c * ∑ l : Fin 2, (h z)⁻¹ a l * ((u z)⁻¹ * pd2 l u z)) := by
      filter_upwards [hs.mem_nhds hx] with z hz
      exact conf_chr h u z (hGd z hz) (hud z hz) (hsymm z hz) (hdet z hz)
        (hupos z hz).ne' a b c
    obtain ⟨h3d, h3e⟩ := conf_C_pd h u s hs hh hu x hx hdy hu0 a b c m
    have h2 := christoffel2_differentiableAt h s hs hh x hx hdy a b c
    show fderiv ℝ (christoffel2 (fun y => (u y) ^ 2 • h y) a b c) x (e2 m) =
      fderiv ℝ (christoffel2 h a b c) x (e2 m) + dC m a b c
    rw [hev.fderiv_eq, fderiv_fun_add h2 h3d, ContinuousLinearMap.add_apply]
    congr 1
    refine h3e.trans ?_
    simp only [hdC, hdψ, hdG, hQ, hdP, hψ, hGy, hP]
  
  have hRic : ∀ j k, ricci2 (fun y => (u y) ^ 2 • h y) j k x = ricci2 h j k x
      + ∑ i, (dC i i j k - dC j i i k)
      + ∑ i, ∑ p, (Γ i i p * C p j k + C i i p * Γ p j k - Γ i j p * C p i k - C i j p * Γ p i k)
      + ∑ i, ∑ p, (C i i p * C p j k - C i j p * C p i k) := by
    intro j k
    simp only [ricci2, hΓ', hDΓ', hΓ, Fin.sum_univ_two]
    ring
  have hL : gaussCurv2 (fun y => (u y) ^ 2 • h y) x = (1 / 2 : ℝ) * ((u x ^ 2)⁻¹ *
      (∑ j, ∑ k, P j k * ricci2 h j k x +
        (∑ j, ∑ k, P j k * ∑ i, (dC i i j k - dC j i i k)
        + ∑ j, ∑ k, P j k * ∑ i, ∑ p, (Γ i i p * C p j k + C i i p * Γ p j k
            - Γ i j p * C p i k - C i j p * Γ p i k)
        + ∑ j, ∑ k, P j k * ∑ i, ∑ p, (C i i p * C p j k - C i j p * C p i k)))) := by
    unfold gaussCurv2
    simp only [hinv, hRic, Fin.sum_univ_two]
    ring
  have hG2 : gaussCurv2 h x = (1 / 2 : ℝ) * ∑ j, ∑ k, P j k * ricci2 h j k x := by
    unfold gaussCurv2
    simp only [hPe]
  
  have hD4 := alg_D Gy P dG ψ Q dψ dP dC hG1 hP1 hdG1 hPG1 hQ1 hdP1 hdC1
  have hX5 := alg_X Gy P dG ψ Q Γ C hG1 hP1 hdG1 hPG1 hQ1 hΓ1 hC1
  have hY6 := alg_Y Gy P ψ Q C hG1 hP1 hPG1 hQ1 hC1
  
  have hA : ∑ j, ∑ k, P j k * ∑ i, (dC i i j k - dC j i i k)
        + ∑ j, ∑ k, P j k * ∑ i, ∑ p, (Γ i i p * C p j k + C i i p * Γ p j k
            - Γ i j p * C p i k - C i j p * Γ p i k)
        + ∑ j, ∑ k, P j k * ∑ i, ∑ p, (C i i p * C p j k - C i j p * C p i k)
      = 2 * (-lap2 h u x / u x +
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b * pd2 a u x * pd2 b u x) / u x ^ 2) := by
    rw [hD4, hX5.1, hY6]
    have h5 := hX5.2
    unfold lap2
    simp only [hPe, hdψ, hψ, hΓ] at h5 ⊢
    simp only [Fin.sum_univ_two] at h5 ⊢
    linear_combination (-2 : ℝ) * h5
  
  have hfin : ∀ (K R S c : ℝ), c ≠ 0 → K = (1 / 2 : ℝ) * (c⁻¹ * (R + S)) →
      K * c = (1 / 2 : ℝ) * R + (1 / 2 : ℝ) * S := by
    intro K R S c hc hK
    rw [hK]
    have h1 := mul_inv_cancel₀ hc
    linear_combination (1 / 2 : ℝ) * (R + S) * h1
  rw [hfin _ _ _ _ (pow_ne_zero 2 hu0) hL, hG2, hA]
  ring

theorem jacobi_conformal_curvature [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig)
    (φ lam : M → ℝ)
    (hdata : ∀ p ∈ Sig, 0 < φ p ∧ ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
        ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
        V ∩ Sig = V ∩ f ⁻¹' {0} ∧
        ∀ x ∈ V ∩ Sig, Real.sqrt (g.gradInner f f x) * φ x = 1 ∧ g.jacobiDeriv f x = lam x / φ x)
    (z : M) (W : Set E2) (F : E2 → E3) (hF : eigSurfParam Sig z W F) (x : E2) (hx : x ∈ W) :
    ContDiffOn ℝ ∞ (fun y => φ ((chartAt E3 z).symm (F y))) W ∧
    0 < φ ((chartAt E3 z).symm (F x)) ∧
    0 ≤ gsSffSq (g.coeff (chartAt E3 z).symm) F x ∧
    ∃ T : ℝ, 0 ≤ T ∧ (T = 0 → fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x = 0) ∧
      gaussCurv2 (fun y => (φ ((chartAt E3 z).symm (F y))) ^ 2 •
          pullMetric2 (g.coeff (chartAt E3 z).symm) F y) x *
          (φ ((chartAt E3 z).symm (F x))) ^ 2 =
        lam ((chartAt E3 z).symm (F x)) + g.scalarCurvature ((chartAt E3 z).symm (F x)) / 2 +
          gsSffSq (g.coeff (chartAt E3 z).symm) F x / 2 + T :=
by
  classical
  obtain ⟨hWo, hFs, hFW⟩ := hF
  have hFU : ∀ y ∈ W, F y ∈ (chartAt E3 z).target := fun y hy => (hFW y hy).1
  have hinj : ∀ y ∈ W, Function.Injective (fderiv ℝ F y) := fun y hy => (hFW y hy).2.2
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j)
      (chartAt E3 z).target := fun i j => g.smooth z i j
  have hGsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  have hGpos : ∀ y ∈ (chartAt E3 z).target, (g.coeff (chartAt E3 z).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y hy
  obtain ⟨hh, hhsymm, hhpos, -, -, -, hA2⟩ :=
    gs_regularity (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target (chartAt E3 z).open_target
      hGs hGsymm hGpos F W hWo hFs hFU hinj
  have hupos : ∀ y ∈ W, 0 < φ ((chartAt E3 z).symm (F y)) :=
    fun y hy => (hdata _ (hFW y hy).2.1).1
  
  have hframe : ∀ x₀ ∈ W, ∃ (U : Set E3) (Φ : E3 → ℝ) (s : Set E2), IsOpen U ∧
      U ⊆ (chartAt E3 z).target ∧
      ContDiffOn ℝ ∞ Φ U ∧ (∀ y ∈ U, fderiv ℝ Φ y ≠ 0) ∧
      IsOpen s ∧ x₀ ∈ s ∧ s ⊆ W ∧
      ∀ y ∈ s, F y ∈ U ∧ Φ (F y) = 0 ∧
        φ ((chartAt E3 z).symm (F y)) = ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F y) ∧
        ejpJac (g.coeff (chartAt E3 z).symm) Φ (F y) =
          lam ((chartAt E3 z).symm (F y)) / φ ((chartAt E3 z).symm (F y)) := by
    intro x₀ hx₀
    obtain ⟨hFt₀, hS₀, -⟩ := hFW x₀ hx₀
    obtain ⟨-, V, f, hVo, hq₀V, hf, hdf, hVS, hnorm⟩ := hdata _ hS₀
    obtain ⟨hfs, htr⟩ := ejp_chart_transfer g z f hf
    have hUo : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V) :=
      (chartAt E3 z).continuousOn_symm.isOpen_inter_preimage (chartAt E3 z).open_target hVo
    refine ⟨(chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V, fun y => f ((chartAt E3 z).symm y),
      W ∩ F ⁻¹' ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' V), hUo, Set.inter_subset_left,
      hfs.mono Set.inter_subset_left, ?_, hFs.continuousOn.isOpen_inter_preimage hWo hUo,
      ⟨hx₀, hFt₀, hq₀V⟩, Set.inter_subset_left, ?_⟩
    · rintro y ⟨hyt, hyV⟩
      have hp : (chartAt E3 z).symm y ∈ (chartAt E3 z).source := (chartAt E3 z).map_target hyt
      have h1 := (htr _ hp (hdf _ hyV)).1
      rwa [(chartAt E3 z).right_inv hyt] at h1
    · rintro y ⟨hyW, hyt, hyV⟩
      have hS : (chartAt E3 z).symm (F y) ∈ Sig := (hFW y hyW).2.1
      have hp : (chartAt E3 z).symm (F y) ∈ (chartAt E3 z).source :=
        (chartAt E3 z).map_target hyt
      obtain ⟨-, hS', hJ'⟩ := htr _ hp (hdf _ hyV)
      rw [(chartAt E3 z).right_inv hyt] at hS' hJ'
      have hf0 : f ((chartAt E3 z).symm (F y)) = 0 := by
        have h' : (chartAt E3 z).symm (F y) ∈ V ∩ Sig := ⟨hyV, hS⟩
        rw [hVS] at h'
        exact h'.2
      obtain ⟨hn1, hn2⟩ := hnorm _ ⟨hyV, hS⟩
      refine ⟨⟨hyt, hyV⟩, hf0, ?_, ?_⟩
      · rw [hS'] at hn1
        unfold ejpPsi
        exact eq_inv_of_mul_eq_one_right hn1
      · rw [← hJ']
        exact hn2
  
  have hu : ContDiffOn ℝ ∞ (fun y => φ ((chartAt E3 z).symm (F y))) W := by
    refine contDiffOn_of_locally_contDiffOn ?_
    intro x₀ hx₀
    obtain ⟨U₀, Φ₀, s₀, hU₀, hU₀t, hΦ₀, hdΦ₀, hs₀, hx₀s, hs₀W, hloc₀⟩ := hframe x₀ hx₀
    have hψ₀ := (ejp_level_regularity (g.coeff (chartAt E3 z).symm) Φ₀ U₀ hU₀
      (fun i j => (hGs i j).mono hU₀t) (fun y hy => hGpos y (hU₀t hy)) hΦ₀ hdΦ₀).2.2.1
    refine ⟨s₀, hs₀, hx₀s, ?_⟩
    have hc : ContDiffOn ℝ ∞ (fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ₀ (F y)) s₀ :=
      hψ₀.comp (hFs.mono hs₀W) (fun y hy => (hloc₀ y hy).1)
    exact (hc.congr (fun y hy => (hloc₀ y hy).2.2.1)).mono Set.inter_subset_right
  
  obtain ⟨U, Φ, s, hU, hUt, hΦ, hdΦ, hs, hxs, hsW, hloc⟩ := hframe x hx
  have hGU : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j) U :=
    fun i j => (hGs i j).mono hUt
  have hGposU : ∀ y ∈ U, (g.coeff (chartAt E3 z).symm y).PosDef := fun y hy => hGpos y (hUt hy)
  obtain ⟨-, -, hψ, -⟩ :=
    ejp_level_regularity (g.coeff (chartAt E3 z).symm) Φ U hU hGU hGposU hΦ hdΦ
  obtain ⟨hFxU, -, hux, hjac⟩ := hloc x hxs
  have hzero : ∀ᶠ y in 𝓝 x, Φ (F y) = 0 :=
    Filter.eventually_of_mem (hs.mem_nhds hxs) (fun y hy => (hloc y hy).2.1)
  have hev : (fun y => φ ((chartAt E3 z).symm (F y))) =ᶠ[𝓝 x]
      (fun y => ejpPsi (g.coeff (chartAt E3 z).symm) Φ (F y)) :=
    Filter.eventually_of_mem (hs.mem_nhds hxs) (fun y hy => (hloc y hy).2.2.1)
  have hu0 : 0 < φ ((chartAt E3 z).symm (F x)) := hupos x hx
  
  have hlapc : ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w₁ w₂ : E2 → ℝ), w₁ =ᶠ[𝓝 x] w₂ →
      lap2 h w₁ x = lap2 h w₂ x := by
    intro h w₁ w₂ hw
    have h1 : ∀ i j : Fin 2, pd2 i (pd2 j w₁) x = pd2 i (pd2 j w₂) x := by
      intro i j
      have hj : pd2 j w₁ =ᶠ[𝓝 x] pd2 j w₂ := by
        filter_upwards [hw.eventuallyEq_nhds] with y hy
        show fderiv ℝ w₁ y (e2 j) = fderiv ℝ w₂ y (e2 j)
        rw [hy.fderiv_eq]
      show fderiv ℝ (pd2 j w₁) x (e2 i) = fderiv ℝ (pd2 j w₂) x (e2 i)
      rw [hj.fderiv_eq]
    have h2 : ∀ k : Fin 2, pd2 k w₁ x = pd2 k w₂ x := by
      intro k
      show fderiv ℝ w₁ x (e2 k) = fderiv ℝ w₂ x (e2 k)
      rw [hw.fderiv_eq]
    simp only [lap2, h1, h2]
  
  have hlapψ := ejp_immersion_lap2 (g.coeff (chartAt E3 z).symm) Φ
    (ejpPsi (g.coeff (chartAt E3 z).symm) Φ) U hU hGU hGsymm hGposU hΦ hdΦ hψ F s hs
    (hFs.mono hsW) (fun y hy => ⟨(hloc y hy).1, (hloc y hy).2.1, hinj y (hsW hy)⟩) x hxs
  have hamb := ejp_ambient_identity (g.coeff (chartAt E3 z).symm) Φ U hU hGU hGsymm hGposU
    hΦ hdΦ (F x) hFxU
  rw [← hux, hjac] at hamb
  have hL : lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun y => φ ((chartAt E3 z).symm (F y))) x =
      -(ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x)) * φ ((chartAt E3 z).symm (F x)) -
        φ ((chartAt E3 z).symm (F x)) * lam ((chartAt E3 z).symm (F x)) := by
    rw [hlapc _ _ _ hev, hlapψ]
    have e1 : φ ((chartAt E3 z).symm (F x)) ^ 2 *
        (lam ((chartAt E3 z).symm (F x)) / φ ((chartAt E3 z).symm (F x))) =
        φ ((chartAt E3 z).symm (F x)) * lam ((chartAt E3 z).symm (F x)) := by
      field_simp <;> ring
    linear_combination hamb - e1
  have hLdiv : lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
      (fun y => φ ((chartAt E3 z).symm (F y))) x / φ ((chartAt E3 z).symm (F x)) =
      -(ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x)) - lam ((chartAt E3 z).symm (F x)) := by
    rw [hL, div_eq_iff hu0.ne']
    ring
  
  have hconf := gaussCurv2_conformal_mul (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
    (fun y => φ ((chartAt E3 z).symm (F y))) W hWo hh hhsymm hhpos hu hupos x hx
  beta_reduce at hconf
  
  have hgauss := gs_gauss_equation (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target
    (chartAt E3 z).open_target hGs hGsymm hGpos F W hWo hFs hFU hinj x hx
  
  have hΦ2 : ContDiffAt ℝ 2 Φ (F x) :=
    (hΦ.contDiffAt (hU.mem_nhds hFxU)).of_le (WithTop.coe_le_coe.mpr le_top)
  have hsff := (gs_levelset_param (g.coeff (chartAt E3 z).symm) F Φ s hs x hxs (hFs.mono hsW)
    (hinj x hx) hGsymm (hGpos _ (hFU x hx)) hΦ2 (hdΦ _ hFxU) hzero).1
  have hpot : ejpPot (g.coeff (chartAt E3 z).symm) Φ (F x) =
      gsSffSq (g.coeff (chartAt E3 z).symm) F x + ejpRic (g.coeff (chartAt E3 z).symm) Φ (F x) := by
    rw [← hsff]
    rfl
  
  have htan : ∀ i : Fin 2, fderiv ℝ Φ (F x) (fderiv ℝ F x (e2 i)) = 0 := by
    intro i
    have hΦd : DifferentiableAt ℝ Φ (F x) :=
      (hΦ.contDiffAt (hU.mem_nhds hFxU)).differentiableAt (by simp)
    have hFd : DifferentiableAt ℝ F x :=
      (hFs.contDiffAt (hWo.mem_nhds hx)).differentiableAt (by simp)
    have hc : fderiv ℝ (fun y => Φ (F y)) x = (fderiv ℝ Φ (F x)).comp (fderiv ℝ F x) :=
      fderiv_comp x hΦd hFd
    have h0 : fderiv ℝ (fun y => Φ (F y)) x = 0 := by
      rw [(show (fun y => Φ (F y)) =ᶠ[𝓝 x] fun _ => (0 : ℝ) from hzero).fderiv_eq]
      exact fderiv_const_apply _
    have h3 := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) (hc.symm.trans h0)
    simpa using h3
  
  have htrace := jcc_scalar_trace (g.coeff (chartAt E3 z).symm) (chartAt E3 z).target
    (chartAt E3 z).open_target hGs hGsymm hGpos Φ F x (hFU x hx) (hinj x hx) (hdΦ _ hFxU) htan
  
  let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    { toPartialEquiv := (chartAt E3 z).symm.toPartialEquiv
      open_source := (chartAt E3 z).open_target
      open_target := (chartAt E3 z).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  have hR : g.scalarCurvature ((chartAt E3 z).symm (F x)) =
      scalarCurvatureLocal (g.coeff (chartAt E3 z).symm) (F x) :=
    scalarCurvature_eq_scalarCurvatureLocal_coeff g Φc (F x) (hFU x hx)
  
  have hhinv : ((pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹).PosDef := (hhpos x hx).inv
  have hQv : (∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
      pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
      pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) =
      dotProduct (star (fun a : Fin 2 => pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x))
        (Matrix.mulVec (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹
          (fun a : Fin 2 => pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x)) := by
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two]
    ring
  have hQnn : 0 ≤ (∑ a : Fin 2, ∑ b : Fin 2,
      (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
      pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
      pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) := by
    by_cases hv0 : (fun a : Fin 2 => pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x) = 0
    · have h0 : ∀ a : Fin 2, pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x = 0 :=
        fun a => congrFun hv0 a
      simp [h0]
    · rw [hQv]
      exact (hhinv.dotProduct_mulVec_pos hv0).le
  refine ⟨hu, hu0, hA2 x hx,
    gsMeanCurv (g.coeff (chartAt E3 z).symm) F x ^ 2 / 2 +
      (∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
        pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
        pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) / φ ((chartAt E3 z).symm (F x)) ^ 2,
    ?_, ?_, ?_⟩
  · exact add_nonneg (by positivity) (div_nonneg hQnn (sq_nonneg _))
  · intro hT0
    have hH2 : 0 ≤ gsMeanCurv (g.coeff (chartAt E3 z).symm) F x ^ 2 / 2 := by positivity
    have hQu : 0 ≤ (∑ a : Fin 2, ∑ b : Fin 2,
        (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
        pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
        pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) / φ ((chartAt E3 z).symm (F x)) ^ 2 :=
      div_nonneg hQnn (sq_nonneg _)
    have hQu0 : (∑ a : Fin 2, ∑ b : Fin 2,
        (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
        pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
        pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) / φ ((chartAt E3 z).symm (F x)) ^ 2
        = 0 := by linarith
    have hQ0 : (∑ a : Fin 2, ∑ b : Fin 2,
        (pullMetric2 (g.coeff (chartAt E3 z).symm) F x)⁻¹ a b *
        pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x *
        pd2 b (fun y => φ ((chartAt E3 z).symm (F y))) x) = 0 := by
      rcases div_eq_zero_iff.mp hQu0 with h | h
      · exact h
      · exact absurd h (pow_ne_zero 2 hu0.ne')
    have hpd : ∀ k : Fin 2, fderiv ℝ (fun y => φ ((chartAt E3 z).symm (F y))) x (e2 k) = 0 := by
      intro k
      by_contra hne
      have hv0 : (fun a : Fin 2 => pd2 a (fun y => φ ((chartAt E3 z).symm (F y))) x) ≠ 0 :=
        fun h => hne (congrFun h k)
      have hp := hhinv.dotProduct_mulVec_pos hv0
      rw [← hQv, hQ0] at hp
      exact lt_irrefl _ hp
    have hvec : ∀ w : E2, w = ∑ k : Fin 2, w k • e2 k := by
      intro w
      rw [Fin.sum_univ_two]
      apply PiLp.ext
      intro i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
    refine ContinuousLinearMap.ext fun w => ?_
    rw [hvec w]
    simp [map_sum, map_smul, hpd]
  · linear_combination hconf - hLdiv + hgauss + hpot - (1 / 2 : ℝ) * hR - (1 / 2 : ℝ) * htrace

theorem normalized_gradient_operator [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) :
    ∃ Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x,
      (∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), Ng x (-ℓ) = -Ng x ℓ) ∧
      (∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → ℓ (Ng x ℓ) = 1) ∧
      ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
        (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
        ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
          (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x :=
by
  classical
  
  have vec_expand : ∀ v : E3, v = ∑ i : Fin 3, v i • e i := by
    intro v
    ext j
    simp [Pi.single_apply]
  have bil_expand : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (z c : Fin 3 → ℝ),
      B (∑ a, z a • e a) (∑ b, c b • e b) =
        dotProduct z (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b)) c) := by
    intro B z c
    simp [map_sum, map_smul, ContinuousLinearMap.sum_apply, Matrix.mulVec, dotProduct,
      Finset.mul_sum, mul_comm, mul_left_comm]
    rw [Finset.sum_comm]
  have lin_expand : ∀ (ℓ : E3 →L[ℝ] ℝ) (c : Fin 3 → ℝ),
      ℓ (∑ b, c b • e b) = ∑ b, c b * ℓ (e b) := by
    intro ℓ c
    simp [map_sum, map_smul]
  have bil_detpos : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) →
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 := by
    intro B hB hdet
    obtain ⟨z, hz0, hz⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hv : (∑ a, z a • e a) ≠ 0 := by
      intro h0; apply hz0; funext j
      have := congrArg (fun v : E3 => v j) h0
      simpa [EuclideanSpace.single_apply, Pi.single_apply] using this
    have := hB _ hv
    rw [bil_expand, hz] at this
    simp at this
  have bil_riesz : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (ξ : Fin 3 → ℝ),
      (Matrix.of fun a b => B (e a) (e b)).det ≠ 0 → ∀ v : E3,
      B v (∑ i, (Matrix.mulVec (Matrix.of fun a b => B (e a) (e b))⁻¹ ξ) i • e i) =
        ∑ j, v j * ξ j := by
    intro B ξ hdet v
    conv_lhs => rw [vec_expand v]
    rw [bil_expand, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hdet),
      Matrix.one_mulVec]
    simp [dotProduct]
  have bil_unique : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ), (∀ v, v ≠ 0 → 0 < B v v) → ∀ w₁ w₂ : E3,
      (∀ v, B v w₁ = B v w₂) → w₁ = w₂ := by
    intro B hB w₁ w₂ h
    by_contra hne
    have := hB (w₁ - w₂) (sub_ne_zero.mpr hne)
    rw [(B (w₁ - w₂)).map_sub w₁ w₂, h (w₁ - w₂), sub_self] at this
    exact lt_irrefl _ this
  
  have det_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ 1 (fun y => H y i j) y₀) →
      ContDiffAt ℝ 1 (fun y => (H y).det) y₀ := by
    intro H y₀ hH
    have : (fun y => (H y).det) = fun y => ∑ σ : Equiv.Perm (Fin 3),
        ((Equiv.Perm.sign σ : ℤ) : ℝ) * ∏ i, H y (σ i) i := by
      funext y; exact Matrix.det_apply' _
    rw [this]
    refine ContDiffAt.sum fun σ _ => contDiffAt_const.mul ?_
    exact contDiffAt_prod fun i _ => hH _ _
  have inv_contDiffAt : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y₀ : E3),
      (∀ i j, ContDiffAt ℝ 1 (fun y => H y i j) y₀) → (H y₀).det ≠ 0 → ∀ i k : Fin 3,
      ContDiffAt ℝ 1 (fun y => (H y)⁻¹ i k) y₀ := by
    intro H y₀ hH hd i k
    have hinv : ∀ y, (H y)⁻¹ i k = ((H y).det)⁻¹ * (H y).adjugate i k := by
      intro y
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
      simp [Matrix.smul_apply]
    simp only [hinv]
    refine ((det_contDiffAt H y₀ hH).inv hd).mul ?_
    simp only [Matrix.adjugate_apply]
    refine det_contDiffAt _ y₀ fun a b => ?_
    by_cases h : a = k
    · subst h; simp [Matrix.updateRow_apply, contDiffAt_const]
    · simp only [Matrix.updateRow_apply, h, if_false]; exact hH a b
  
  have chart_inv : ∀ (x₀ x : M), x ∈ (chartAt E3 x₀).source →
      (∀ u, tangentCoordChange 𝓘(ℝ, E3) x x₀ x
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) u) = u) ∧
      (∀ v, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
        (tangentCoordChange 𝓘(ℝ, E3) x x₀ x v) = v) := by
    intro x₀ x hx
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hx
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hx
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x) :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hd2 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 x₀) hx
    have hT : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀) x =
        tangentCoordChange 𝓘(ℝ, E3) x x₀ x :=
      mfderiv_chartAt_eq_tangentCoordChange hx
    constructor
    · intro u
      have hd2' : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀)
          ((chartAt E3 x₀).symm (chartAt E3 x₀ x)) := by rw [hxy]; exact hd2
      have hc := mfderiv_comp (chartAt E3 x₀ x) hd2' hd1
      have hid : ((chartAt E3 x₀) ∘ (chartAt E3 x₀).symm) =ᶠ[𝓝 (chartAt E3 x₀ x)] id := by
        filter_upwards [(chartAt E3 x₀).eventually_right_inverse hy] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hxy, hT] at hc
      have := congrArg (fun L => L u) hc
      simpa using this.symm
    · intro v
      have hc := mfderiv_comp x hd1 hd2
      have hid : ((chartAt E3 x₀).symm ∘ (chartAt E3 x₀)) =ᶠ[𝓝 x] id := by
        filter_upwards [(chartAt E3 x₀).eventually_left_inverse hx] with z hz using hz
      rw [hid.mfderiv_eq, mfderiv_id, hT] at hc
      have := congrArg (fun L => L v) hc
      simpa using this.symm
  
  have section_cmd : ∀ (V : (x : M) → TangentSpace 𝓘(ℝ, E3) x) (x₀ : M) (W : E3 → E3),
      ContDiffAt ℝ 1 W (chartAt E3 x₀ x₀) →
      (∀ᶠ x in 𝓝 x₀, tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x)) →
      ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
        (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀ := by
    intro V x₀ W hW hV
    rw [Bundle.contMDiffAt_section]
    have hc : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 (chartAt E3 x₀) x₀ := by
      have := contMDiffAt_extChartAt (I := 𝓘(ℝ, E3)) (n := 1) (x := x₀)
      simpa [extChartAt_coe] using this
    have h1 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 (fun x => W (chartAt E3 x₀ x)) x₀ :=
      hW.contMDiffAt.comp x₀ hc
    refine h1.congr_of_eventuallyEq ?_
    filter_upwards [hV] with x hx
    rw [← hx, tangentCoordChange_def, TangentBundle.trivializationAt_apply]
    rfl
  
  let wf : (x : M) → (E3 →L[ℝ] ℝ) → E3 := fun x ℓ =>
    ∑ i, (Matrix.mulVec (Matrix.of fun a b => g.g x (e a) (e b))⁻¹ (fun j => ℓ (e j))) i • e i
  have hwR : ∀ x (ℓ : E3 →L[ℝ] ℝ) v, g.g x v (wf x ℓ) = ℓ v := by
    intro x ℓ v
    have h1 := bil_riesz (g.g x) (fun j => ℓ (e j)) (bil_detpos _ (g.posDef x)) v
    calc g.g x v (wf x ℓ) = ∑ j, v j * ℓ (e j) := h1
      _ = ℓ (∑ i, v i • e i) := (lin_expand ℓ (fun i => v i)).symm
      _ = ℓ v := by rw [← vec_expand v]
  have hposℓ : ∀ x (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → 0 < ℓ (wf x ℓ) := by
    intro x ℓ hℓ
    have hw0 : wf x ℓ ≠ 0 := by
      intro h0
      apply hℓ
      ext v
      have := hwR x ℓ v
      rw [h0, map_zero] at this
      simpa using this.symm
    have := g.posDef x (wf x ℓ) hw0
    rwa [hwR] at this
  refine ⟨fun x ℓ => (ℓ (wf x ℓ))⁻¹ • wf x ℓ, ?_, ?_, ?_⟩
  · 
    intro x ℓ
    have hneg : wf x (-ℓ) = -wf x ℓ := by
      refine bil_unique (g.g x) (g.posDef x) _ _ (fun v => ?_)
      rw [hwR, map_neg, hwR]
      rfl
    show ((-ℓ) (wf x (-ℓ)))⁻¹ • wf x (-ℓ) = -((ℓ (wf x ℓ))⁻¹ • wf x ℓ)
    rw [hneg, ContinuousLinearMap.neg_apply, map_neg, neg_neg, smul_neg]
  · 
    intro x ℓ hℓ
    show ℓ ((ℓ (wf x ℓ))⁻¹ • wf x ℓ) = 1
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ (hposℓ x ℓ hℓ).ne']
  
  intro X τ hX hτs hτr x₀ hx₀
  have chain_tau : ∀ (x₀ : M) (y : E3), y ∈ (chartAt E3 x₀).target →
      (chartAt E3 x₀).symm y ∈ X → ∀ v : E3,
      fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y v =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y)
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y v) := by
    intro x₀ y hy hyX v
    have hd1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 x₀) hy
    have hτd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ ((chartAt E3 x₀).symm y) :=
      (hτs.contMDiffAt (hX.mem_nhds hyX)).mdifferentiableAt (by simp)
    have hc := mfderiv_comp y hτd hd1
    rw [mfderiv_eq_fderiv] at hc
    exact congrArg (fun L => L v) hc
  have xi_smooth : ∀ (x₀ : M), x₀ ∈ X → ∀ j : Fin 3,
      ContDiffAt ℝ 1 (fun y => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j))
        (chartAt E3 x₀ x₀) := by
    intro x₀ hx₀ j
    have hO : IsOpen ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      (chartAt E3 x₀).isOpen_inter_preimage_symm hX
    have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X :=
      ⟨mem_chart_target E3 x₀, by
        show (chartAt E3 x₀).symm (chartAt E3 x₀ x₀) ∈ X
        rw [(chartAt E3 x₀).left_inv (mem_chart_source E3 x₀)]; exact hx₀⟩
    have hf : ContDiffOn ℝ ∞ (fun z => τ ((chartAt E3 x₀).symm z))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) := by
      have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (τ ∘ (chartAt E3 x₀).symm)
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
        hτs.comp (contMDiffOn_chart_symm.mono Set.inter_subset_left) (fun y hy => hy.2)
      exact contMDiffOn_iff_contDiffOn.mp this
    have hfd : ContDiffOn ℝ 1 (fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)))
        ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' X) :=
      hf.fderiv_of_isOpen hO (WithTop.coe_le_coe.mpr le_top)
    exact (hfd.clm_apply contDiffOn_const).contDiffAt (hO.mem_nhds hy₀)
  let ℓ : M → E3 →L[ℝ] ℝ := fun x => mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x
  let w : M → E3 := fun x => wf x (ℓ x)
  let V : (x : M) → TangentSpace 𝓘(ℝ, E3) x := fun x => (ℓ x (w x))⁻¹ • w x
  show ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
    (fun y => (⟨y, V y⟩ : TangentBundle 𝓘(ℝ, E3) M)) x₀
  have hwR' : ∀ x v, g.g x v (w x) = ℓ x v := fun x v => hwR x (ℓ x) v
  have hpos : ∀ x ∈ X, 0 < ℓ x (w x) := fun x hx => hposℓ x (ℓ x) (hτr x hx)
  let G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 x₀).symm
  let ξ : E3 → Fin 3 → ℝ := fun y j => fderiv ℝ (fun z => τ ((chartAt E3 x₀).symm z)) y (e j)
  let c : E3 → Fin 3 → ℝ := fun y => Matrix.mulVec (G y)⁻¹ (ξ y)
  let W : E3 → E3 := fun y => (∑ i, c y i * ξ y i)⁻¹ • ∑ i, c y i • e i
  
  have hK : ∀ x ∈ (chartAt E3 x₀).source ∩ X,
      tangentCoordChange 𝓘(ℝ, E3) x x₀ x (V x) = W (chartAt E3 x₀ x) ∧
      ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
    rintro x ⟨hxs, hxX⟩
    obtain ⟨hTA0, hAT0⟩ := chart_inv x₀ x hxs
    let A : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x₀).symm (chartAt E3 x₀ x)
    let T : E3 →L[ℝ] E3 := tangentCoordChange 𝓘(ℝ, E3) x x₀ x
    have hTA : ∀ u, T (A u) = u := hTA0
    have hAT : ∀ v, A (T v) = v := hAT0
    have hy : chartAt E3 x₀ x ∈ (chartAt E3 x₀).target := (chartAt E3 x₀).map_source hxs
    have hxy : (chartAt E3 x₀).symm (chartAt E3 x₀ x) = x := (chartAt E3 x₀).left_inv hxs
    have hG : G (chartAt E3 x₀ x) =
        Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b) := by
      ext a b
      simp only [G, RiemannianMetric3.coeff, coeffMatrix, Matrix.of_apply,
        ContinuousLinearMap.bilinearComp_apply]
      rw [hxy]
      rfl
    have hξ : ξ (chartAt E3 x₀ x) = fun j => ℓ x (A (e j)) := by
      funext j
      simp only [ξ]
      rw [chain_tau x₀ _ hy (by rw [hxy]; exact hxX), hxy]
      rfl
    have hdetB : (Matrix.of fun a b => (g.g x).bilinearComp A A (e a) (e b)).det ≠ 0 := by
      refine bil_detpos _ (fun v hv => ?_)
      rw [ContinuousLinearMap.bilinearComp_apply]
      apply g.posDef
      intro h0
      apply hv
      rw [← hTA v]
      exact (congrArg T h0).trans (map_zero T)
    let u : E3 := ∑ i, c (chartAt E3 x₀ x) i • e i
    have hRu : ∀ v, (g.g x).bilinearComp A A v u = ∑ j, v j * ℓ x (A (e j)) := by
      intro v
      have := bil_riesz ((g.g x).bilinearComp A A) (fun j => ℓ x (A (e j))) hdetB v
      simp only [u, c, hG, hξ]
      exact this
    have hAu : ∀ v, g.g x v (A u) = ℓ x v := by
      intro v
      have h1 := hRu (T v)
      rw [ContinuousLinearMap.bilinearComp_apply, hAT v] at h1
      rw [h1]
      calc ∑ j, (T v) j * ℓ x (A (e j)) = ((ℓ x).comp A) (∑ i, (T v) i • e i) :=
            (lin_expand ((ℓ x).comp A) (fun i => (T v) i)).symm
        _ = ℓ x v := by
            rw [← vec_expand (T v), ContinuousLinearMap.comp_apply, hAT v]
    have hwAu : w x = A u :=
      bil_unique (g.g x) (g.posDef x) _ _ (fun v => (hwR' x v).trans (hAu v).symm)
    have hlw : ℓ x (w x) = ∑ i, c (chartAt E3 x₀ x) i * ξ (chartAt E3 x₀ x) i := by
      rw [hwAu, hξ]
      exact lin_expand ((ℓ x).comp A) (c (chartAt E3 x₀ x))
    refine ⟨?_, hlw⟩
    show T ((ℓ x (w x))⁻¹ • w x) = W (chartAt E3 x₀ x)
    rw [hlw, hwAu, map_smul, hTA]
  
  have hy₀ : chartAt E3 x₀ x₀ ∈ (chartAt E3 x₀).target := mem_chart_target E3 x₀
  have hGs : ∀ i j, ContDiffAt ℝ 1 (fun y => G y i j) (chartAt E3 x₀ x₀) := fun i j =>
    ((g.smooth x₀ i j).contDiffAt ((chartAt E3 x₀).open_target.mem_nhds hy₀)).of_le
      (by exact_mod_cast le_top)
  have hK₀ := hK x₀ ⟨mem_chart_source E3 x₀, hx₀⟩
  have hdetG : (G (chartAt E3 x₀ x₀)).det ≠ 0 := by
    intro h0
    have hc0 : c (chartAt E3 x₀ x₀) = 0 := by
      simp only [c, Matrix.inv_def, h0, Ring.inverse_zero, zero_smul, Matrix.zero_mulVec]
    have := hpos x₀ hx₀
    rw [hK₀.2, hc0] at this
    simp at this
  have hξs : ∀ j, ContDiffAt ℝ 1 (fun y => ξ y j) (chartAt E3 x₀ x₀) := fun j =>
    xi_smooth x₀ hx₀ j
  have hcs : ∀ i, ContDiffAt ℝ 1 (fun y => c y i) (chartAt E3 x₀ x₀) := by
    intro i
    simp only [c, Matrix.mulVec, dotProduct]
    exact ContDiffAt.sum fun k _ => (inv_contDiffAt G _ hGs hdetG i k).mul (hξs k)
  have hden : ContDiffAt ℝ 1 (fun y => ∑ i, c y i * ξ y i) (chartAt E3 x₀ x₀) :=
    ContDiffAt.sum fun i _ => (hcs i).mul (hξs i)
  have hden0 : ∑ i, c (chartAt E3 x₀ x₀) i * ξ (chartAt E3 x₀ x₀) i ≠ 0 := by
    rw [← hK₀.2]; exact (hpos x₀ hx₀).ne'
  have hWs : ContDiffAt ℝ 1 W (chartAt E3 x₀ x₀) :=
    (hden.inv hden0).smul (ContDiffAt.sum fun i _ => (hcs i).smul contDiffAt_const)
  refine section_cmd V x₀ W hWs ?_
  filter_upwards [((chartAt E3 x₀).open_source.inter hX).mem_nhds
    ⟨mem_chart_source E3 x₀, hx₀⟩] with x hx using (hK x hx).1

theorem collar_global_flow [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (X : Set M) (hX : IsOpen X) (τ : M → ℝ) (a b : ℝ)
    (hτs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X)
    (hτr : ∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0)
    (hτb : ∀ x ∈ X, a < τ x ∧ τ x < b)
    (hτp : ∀ c d : ℝ, a < c → d < b → IsCompact (X ∩ τ ⁻¹' Set.Icc c d)) :
    ∃ Θ : M → ℝ → M,
      (∀ x ∈ X, ∀ s : ℝ, a < τ x + s → τ x + s < b → Θ x s ∈ X ∧ τ (Θ x s) = τ x + s) ∧
      (∀ x ∈ X, Θ x 0 = x) ∧
      (∀ x ∈ X, ∀ s s' : ℝ, a < τ x + s → τ x + s < b → a < τ x + s + s' →
        τ x + s + s' < b → Θ (Θ x s) s' = Θ x (s + s')) ∧
      ContinuousOn (fun p : M × ℝ => Θ p.1 p.2)
        {p : M × ℝ | p.1 ∈ X ∧ a < τ p.1 + p.2 ∧ τ p.1 + p.2 < b} :=
by
  obtain ⟨V, hVs, hVτ⟩ := tau_gradient_field g X hX τ hτs hτr
  have hloc : ∀ x₀ ∈ X, ∃ (N : Set M) (ε : ℝ) (ψ : M → ℝ → M), IsOpen N ∧ x₀ ∈ N ∧ N ⊆ X ∧
      0 < ε ∧ ContinuousOn (fun p : M × ℝ => ψ p.1 p.2) (N ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ N, ψ x 0 = x ∧ IsMIntegralCurveOn (ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, ψ x s ∈ X :=
    fun x₀ hx₀ => local_flow_of_contMDiffAt X hX V x₀ hx₀ (hVs x₀ hx₀)
  have huniq : ∀ (γ γ' : ℝ → M) (α β t₀ : ℝ), t₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → IsMIntegralCurveOn γ' V (Set.Ioo α β) →
      (∀ t ∈ Set.Ioo α β, γ t ∈ X) → (∀ t ∈ Set.Ioo α β, γ' t ∈ X) → γ t₀ = γ' t₀ →
      Set.EqOn γ γ' (Set.Ioo α β) :=
    fun γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀ =>
      integral_curve_eqOn_of_mem X V hVs γ γ' α β t₀ ht₀ hγ hγ' hγX hγ'X h₀
  have hτlin : ∀ (γ : ℝ → M) (α β s₀ : ℝ), s₀ ∈ Set.Ioo α β →
      IsMIntegralCurveOn γ V (Set.Ioo α β) → (∀ t ∈ Set.Ioo α β, γ t ∈ X) →
      ∀ s ∈ Set.Ioo α β, τ (γ s) = τ (γ s₀) + (s - s₀) :=
    fun γ α β s₀ hs₀ hγ hγX =>
      tau_affine_along_integral_curve X hX τ hτs V hVτ γ α β s₀ hs₀ hγ hγX
  have hunif : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      IsOpen O ∧ X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ContinuousOn (fun p : M × ℝ => Ψ p.1 p.2) (O ×ˢ Set.Ioo (-ε) ε) ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X :=
    fun c d hc hd => uniform_flow_on_compact X (X ∩ τ ⁻¹' Set.Icc c d) Set.inter_subset_left
      (hτp c d hc hd) V hloc huniq
  have hunif' : ∀ c d : ℝ, a < c → d < b → ∃ (O : Set M) (ε : ℝ) (Ψ : M → ℝ → M),
      X ∩ τ ⁻¹' Set.Icc c d ⊆ O ∧ O ⊆ X ∧ 0 < ε ∧
      ∀ x ∈ O, Ψ x 0 = x ∧ IsMIntegralCurveOn (Ψ x) V (Set.Ioo (-ε) ε) ∧
        ∀ s ∈ Set.Ioo (-ε) ε, Ψ x s ∈ X := by
    intro c d hc hd
    obtain ⟨O, ε, Ψ, _, h1, h2, h3, _, h5⟩ := hunif c d hc hd
    exact ⟨O, ε, Ψ, h1, h2, h3, h5⟩
  have hlong : ∀ x ∈ X, ∀ T₁ T₂ : ℝ, T₁ ≤ 0 → 0 ≤ T₂ → a < τ x + T₁ → τ x + T₂ < b →
      ∃ (γ : ℝ → M) (α β : ℝ), α < T₁ ∧ T₂ < β ∧ γ 0 = x ∧
        IsMIntegralCurveOn γ V (Set.Ioo α β) ∧ ∀ t ∈ Set.Ioo α β, γ t ∈ X :=
    fun x hx T₁ T₂ h1 h2 h3 h4 =>
      long_integral_curve_exists X τ a b V hτb huniq hτlin hunif' x hx T₁ T₂ h1 h2 h3 h4
  exact global_flow_assembly X hX τ a b hτs.continuousOn hτb V huniq hτlin hunif hlong

theorem near_frontier_projection [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (U : Set M) (hUo : IsOpen U) (N : Set M) (σ : M → ℝ) (hNo : IsOpen N)
    (hFN : frontier U ⊆ N)
    (hσs : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ σ (U ∩ N))
    (hσr : ∀ x ∈ U ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ x ≠ 0)
    (hσpos : ∀ x ∈ U ∩ N, 0 < σ x)
    (hgood : ∀ p ∈ frontier U, ∃ (V : Set M) (f : M → ℝ), IsOpen V ∧ p ∈ V ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) ∧
      V ∩ frontier U = V ∩ f ⁻¹' {0} ∧ ∀ x ∈ V ∩ U ∩ N, σ x = |f x|)
    (Ng : (x : M) → (E3 →L[ℝ] ℝ) → TangentSpace 𝓘(ℝ, E3) x)
    (hNg1 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), Ng x (-ℓ) = -Ng x ℓ)
    (hNg2 : ∀ (x : M) (ℓ : E3 →L[ℝ] ℝ), ℓ ≠ 0 → ℓ (Ng x ℓ) = 1)
    (hNg3 : ∀ (X : Set M) (τ : M → ℝ), IsOpen X → ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ τ X →
        (∀ x ∈ X, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ x ≠ 0) →
        ∀ x ∈ X, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
          (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) τ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x) :
    ∃ (A : Set M) (prn : M → M), IsOpen A ∧ frontier U ⊆ A ∧
      ContinuousOn prn (A ∩ U ∩ N) ∧ (∀ y ∈ A ∩ U ∩ N, prn y ∈ frontier U) ∧
      ∀ y ∈ A ∩ U ∩ N, ∃ (B Ω : Set M) (sec : M → M), IsOpen B ∧ y ∈ B ∧ IsOpen Ω ∧
        ContinuousOn sec (Ω ∩ frontier U) ∧
        (∀ y' ∈ Ω ∩ frontier U, sec y' ∈ B ∩ A ∩ U ∩ N ∧ σ (sec y') = σ y ∧ prn (sec y') = y') ∧
        (∀ w ∈ B ∩ A ∩ U ∩ N, σ w = σ y → prn w ∈ Ω ∧ sec (prn w) = w) :=
by
  classical
  
  have hV : ∀ x ∈ U ∩ N, ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, E3).tangent 1
      (fun y => (⟨y, Ng y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) σ y)⟩ : TangentBundle 𝓘(ℝ, E3) M)) x :=
    hNg3 (U ∩ N) σ (hUo.inter hNo) hσs hσr
  have hFU : ∀ x, x ∈ frontier U → x ∉ U := by
    intro x hx hxU
    rw [hUo.frontier_eq] at hx
    exact hx.2 hxU
  
  have hdata : ∀ p, p ∈ frontier U → ∃ (V : Set M) (f : M → ℝ) (W W' : Set M) (ε η : ℝ)
      (ψ : M → ℝ → M),
      IsOpen V ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ V ∩ frontier U = V ∩ f ⁻¹' {0} ∧
      (∀ x ∈ V ∩ U ∩ N, σ x = |f x|) ∧
      IsOpen W ∧ IsOpen W' ∧ p ∈ W' ∧ W' ⊆ W ∧ W ⊆ V ∩ N ∧ 0 < ε ∧ 0 < η ∧ η ≤ ε / 2 ∧
      ContinuousOn (fun q : M × ℝ => ψ q.1 q.2) (W ×ˢ Set.Ioo (-ε) ε) ∧
      (∀ x ∈ W, ψ x 0 = x ∧
        IsMIntegralCurveOn (ψ x) (fun z => Ng z (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f z))
          (Set.Ioo (-ε) ε) ∧
        ∀ t ∈ Set.Ioo (-ε) ε, ψ x t ∈ V ∩ N ∧ f (ψ x t) = f x + t) ∧
      (∀ x ∈ W, ∀ t : ℝ, |t| < ε / 2 → ψ x t ∈ W → ψ (ψ x t) (-t) = x) ∧
      (∀ x ∈ W', |f x| < η) ∧
      (∀ x ∈ W', ∀ t : ℝ, |t| < η → ψ x t ∈ W) := by
    intro p hp
    obtain ⟨V, f, hVo, hpV, hf, hdf, hVF, hσf⟩ := hgood p hp
    have hQo : IsOpen (V ∩ N) := hVo.inter hNo
    have hpQ : p ∈ V ∩ N := ⟨hpV, hFN hp⟩
    have hdfQ : ∀ x ∈ V ∩ N, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 := fun x hx => hdf x hx.1
    have hY := hNg3 (V ∩ N) f hQo hf.contMDiffOn hdfQ
    have hfY : ∀ x ∈ V ∩ N,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x (Ng x (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x)) = 1 :=
      fun x hx => hNg2 x _ (hdfQ x hx)
    have hfp : f p = 0 := by
      have h : p ∈ V ∩ frontier U := ⟨hpV, hp⟩
      rw [hVF] at h
      exact h.2
