theorem pcgb_ds_boundary_regularity (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (β : E2 → ℝ) (hβ : ContDiffOn ℝ ∞ β W)
    (x₀ : E2) (hx₀ : x₀ ∈ W) (hβ0 : β x₀ = 0) (hdβ : fderiv ℝ β x₀ ≠ 0)
    (u : ℕ → E2 → ℝ) (hu : ∀ m, ContDiffOn ℝ ∞ (u m) W)
    (huz : ∀ m, ∃ c : ℝ, 0 < c ∧ ∀ x ∈ W, β x < c → u m x = 0)
    (w : E2 → ℝ) (G : Fin 2 → E2 → ℝ)
    (hL2 : ∀ L : Set E2, IsCompact L → L ⊆ W →
      MemLp w 2 (volume.restrict L) ∧ (∀ k, MemLp (G k) 2 (volume.restrict L)) ∧
      Tendsto (fun m => ∫ x in L, (u m x - w x) ^ 2) atTop (𝓝 0) ∧
      ∀ k, Tendsto (fun m => ∫ x in L, (pd2 k (u m) x - G k x) ^ 2) atTop (𝓝 0))
    (hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ W ∩ {x | 0 < β x} →
      ∫ x, ∑ a : Fin 2, ∑ c : Fin 2,
        Real.sqrt (h x).det * (h x)⁻¹ a c * G c x * pd2 a ζ x = 0) :
    ∃ r : ℝ, 0 < r ∧ Metric.ball x₀ r ⊆ W ∧ ∃ V : E2 → ℝ,
      ContDiffOn ℝ ∞ V (Metric.ball x₀ r) ∧
      (∀ᵐ x ∂(volume.restrict (Metric.ball x₀ r ∩ {x | 0 < β x})), w x = V x) ∧
      (∀ x ∈ Metric.ball x₀ r, 0 ≤ β x → lap2 h V x = 0) ∧
      (∀ x ∈ Metric.ball x₀ r, β x = 0 → V x = 0) :=
by
  obtain ⟨ρ, N, Φ, Ψ, hρ, hNo, hx₀N, hNW, hΦ0, hΦs, hΨs, hΦN, hΨB, hβΨ, hdet⟩ :=
    pcgb_bdr_flat_chart W hW β hβ x₀ hx₀ hβ0 hdβ
  have hBo : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
  have hinj : Set.InjOn Ψ (Metric.ball (0 : E2) ρ) := by
    intro a ha b hb hab
    rw [← (hΨB a ha).2, ← (hΨB b hb).2, hab]
  have hΨW : ∀ z ∈ Metric.ball (0 : E2) ρ, Ψ z ∈ W := fun z hz => hNW (hΨB z hz).1
  obtain ⟨hts, htpd, hid⟩ := pcgb_bdr_pull_metric (Metric.ball (0 : E2) ρ) N hBo hNo Ψ hΨs
    (fun z hz => (hΨB z hz).1) hdet h (fun a c => (hh a c).mono hNW)
    (fun x hx => hpd x (hNW hx))
  obtain ⟨hsqpos, hsqs, hinvs, hApd⟩ :=
    elr_coeff_smooth (Metric.ball (0 : E2) ρ) hBo (pcgbBdrPull h Ψ) hts htpd
  obtain ⟨At, hAt⟩ : ∃ At : E2 → Matrix (Fin 2) (Fin 2) ℝ, ∀ z a c,
      At z a c = Real.sqrt (pcgbBdrPull h Ψ z).det * (pcgbBdrPull h Ψ z)⁻¹ a c :=
    ⟨fun z => Real.sqrt (pcgbBdrPull h Ψ z).det • (pcgbBdrPull h Ψ z)⁻¹, fun _ _ _ => rfl⟩
  have hAteq : ∀ z, At z = Real.sqrt (pcgbBdrPull h Ψ z).det • (pcgbBdrPull h Ψ z)⁻¹ := by
    intro z
    ext a c
    rw [hAt, Matrix.smul_apply, smul_eq_mul]
  have hApd' : ∀ z ∈ Metric.ball (0 : E2) ρ, (At z).PosDef := fun z hz => by
    rw [hAteq]
    exact hApd z hz
  have hAs : ∀ z ∈ Metric.ball (0 : E2) ρ, ∀ a b : Fin 2, At z a b = At z b a :=
    fun z hz a b => ((hApd' z hz).isHermitian.apply a b).symm.trans (star_trivial _)
  have hAsm : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun z => At z a b) (Metric.ball (0 : E2) ρ) :=
    fun a b => (hsqs.mul (hinvs a b)).congr (fun z _ => hAt z a b)
  have hu' : ∀ m, ContDiffOn ℝ ∞ (fun y => u m (Ψ y)) (Metric.ball (0 : E2) ρ) :=
    fun m => (hu m).comp hΨs (fun z hz => hΨW z hz)
  have huz' : ∀ m, ∃ c : ℝ, 0 < c ∧ ∀ z ∈ Metric.ball (0 : E2) ρ, z 0 < c → u m (Ψ z) = 0 := by
    intro m
    obtain ⟨c, hc, hcz⟩ := huz m
    refine ⟨c, hc, fun z hz hz0 => hcz _ (hΨW z hz) ?_⟩
    rw [hβΨ z hz]
    exact hz0
  have hL2' := pcgb_bdr_l2_transport W (Metric.ball (0 : E2) ρ) hW hBo Ψ hΨs hΨW hinj hdet
    u hu w G hL2
  have hid' : ∀ z ∈ Metric.ball (0 : E2) ρ, ∀ q : Fin 2 → ℝ,
      ∑ a : Fin 2, ∑ c : Fin 2, At z a c * pcgbBdrVec G Ψ c z *
          (∑ a' : Fin 2, fderiv ℝ Ψ z (e2 a) a' * q a') =
        |(fderiv ℝ Ψ z).det| * ∑ a : Fin 2, ∑ c : Fin 2,
          (fun x => Real.sqrt (h x).det • (h x)⁻¹) (Ψ z) a c * G c (Ψ z) * q a := by
    intro z hz q
    have := hid z hz (fun c' => G c' (Ψ z)) q
    simp only [hAt, Matrix.smul_apply, smul_eq_mul]
    exact this
  have hweak' := pcgb_bdr_weak_transport W N (Metric.ball (0 : E2) ρ) hNo hBo hNW Φ Ψ hΦs hΨs
    hΦN hΨB β hβΨ (fun x => Real.sqrt (h x).det • (h x)⁻¹) At G (pcgbBdrVec G Ψ) hid' hweak
  obtain ⟨s, hs, hsρ, Vt, hVs, hVae, hVeq, hVd⟩ :=
    pcgb_bdr_flat2_regularity ρ hρ At hAsm hAs hApd' (fun m y => u m (Ψ y)) hu' huz'
      (fun z => w (Ψ z)) (pcgbBdrVec G Ψ) hL2' hweak'
  have hsB : Metric.ball (0 : E2) s ⊆ Metric.ball (0 : E2) ρ := Metric.ball_subset_ball hsρ
  have hN'o : IsOpen (N ∩ Φ ⁻¹' Metric.ball (0 : E2) s) :=
    hΦs.continuousOn.isOpen_inter_preimage hNo Metric.isOpen_ball
  have hx₀N' : x₀ ∈ N ∩ Φ ⁻¹' Metric.ball (0 : E2) s := by
    refine ⟨hx₀N, ?_⟩
    show Φ x₀ ∈ Metric.ball (0 : E2) s
    rw [hΦ0]
    exact Metric.mem_ball_self hs
  obtain ⟨r, hr, hrsub⟩ := Metric.isOpen_iff.mp hN'o x₀ hx₀N'
  have hballW : Metric.ball x₀ r ⊆ W := fun x hx => hNW (hrsub hx).1
  have hVsm : ContDiffOn ℝ ∞ (fun x => Vt (Φ x)) (Metric.ball x₀ r) :=
    hVs.comp (hΦs.mono (fun x hx => (hrsub hx).1)) (fun x hx => (hrsub hx).2)
  refine ⟨r, hr, hballW, fun x => Vt (Φ x), hVsm, ?_, ?_, ?_⟩
  · have hΩo : IsOpen (Metric.ball x₀ r ∩ {x | 0 < β x}) :=
      (hβ.continuousOn.mono hballW).isOpen_inter_preimage Metric.isOpen_ball isOpen_Ioi
    have hΩ'o : IsOpen (Metric.ball (0 : E2) s ∩ {z : E2 | 0 < z 0}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const
        (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).continuous)
    rw [ae_restrict_iff' hΩo.measurableSet]
    rw [ae_restrict_iff' hΩ'o.measurableSet] at hVae
    rw [ae_iff] at hVae ⊢
    have hsub : {x : E2 | ¬(x ∈ Metric.ball x₀ r ∩ {x | 0 < β x} → w x = Vt (Φ x))} ⊆
        Ψ '' {z : E2 | ¬(z ∈ Metric.ball (0 : E2) s ∩ {z | 0 < z 0} → w (Ψ z) = Vt z)} := by
      intro x hx
      simp only [Set.mem_setOf_eq, _root_.not_imp] at hx
      obtain ⟨⟨hxb, hxβ⟩, hne⟩ := hx
      obtain ⟨hxN, hΦxs⟩ := hrsub hxb
      have hΨΦ := (hΦN x hxN).2
      have h1 := hβΨ (Φ x) (hsB hΦxs)
      rw [hΨΦ] at h1
      refine ⟨Φ x, ?_, hΨΦ⟩
      simp only [Set.mem_setOf_eq, _root_.not_imp]
      refine ⟨⟨hΦxs, ?_⟩, ?_⟩
      · show 0 < Φ x 0
        rw [← h1]
        exact hxβ
      · rw [hΨΦ]
        exact hne
    refine measure_mono_null hsub ?_
    refine addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume ?_ hVae
    refine (hΨs.differentiableOn (by simp)).mono ?_
    intro z hz
    simp only [Set.mem_setOf_eq, _root_.not_imp] at hz
    exact hsB hz.1.1
  · intro x hx hβx
    obtain ⟨hxN, hΦxs⟩ := hrsub hx
    have hΨΦ := (hΦN x hxN).2
    have h1 := hβΨ (Φ x) (hsB hΦxs)
    rw [hΨΦ] at h1
    have hA'B : Metric.ball (0 : E2) s ∩ Ψ ⁻¹' Metric.ball x₀ r ⊆ Metric.ball (0 : E2) ρ :=
      fun z hz => hsB hz.1
    have hA'o : IsOpen (Metric.ball (0 : E2) s ∩ Ψ ⁻¹' Metric.ball x₀ r) :=
      (hΨs.continuousOn.mono hsB).isOpen_inter_preimage Metric.isOpen_ball Metric.isOpen_ball
    have hzA : Φ x ∈ Metric.ball (0 : E2) s ∩ Ψ ⁻¹' Metric.ball x₀ r := by
      refine ⟨hΦxs, ?_⟩
      show Ψ (Φ x) ∈ Metric.ball x₀ r
      rw [hΨΦ]
      exact hx
    have hchart := lap2_chart_invariant (Metric.ball (0 : E2) s ∩ Ψ ⁻¹' Metric.ball x₀ r)
      (Metric.ball x₀ r) hA'o Metric.isOpen_ball Ψ (hΨs.mono hA'B) (fun z hz => hz.2)
      (pcgbBdrPull h Ψ) h (fun c d => (hts c d).mono hA'B) (fun c d => (hh c d).mono hballW)
      (fun y hy => hpd y (hballW hy)) (fun z hz => htpd z (hA'B hz))
      (fun _ _ _ _ => rfl) (fun x => Vt (Φ x)) hVsm Vt
      (fun z hz => by
        show Vt z = Vt (Φ (Ψ z))
        rw [(hΨB z (hA'B hz)).2]) (Φ x) hzA
    rw [hΨΦ] at hchart
    have hdiv := lap2_divergence_form (Metric.ball (0 : E2) s) Metric.isOpen_ball
      (pcgbBdrPull h Ψ) Vt (fun i j => (hts i j).mono hsB) (fun y hy => htpd y (hsB hy))
      (hVs.of_le (WithTop.coe_le_coe.mpr le_top)) (Φ x) hΦxs
    have hE := hVeq (Φ x) hΦxs (by rw [← h1]; exact hβx)
    have hfun : ∀ a : Fin 2, (fun y => ∑ b : Fin 2, At y a b * pd2 b Vt y) =
        (fun y => Real.sqrt (pcgbBdrPull h Ψ y).det *
          ∑ j : Fin 2, (pcgbBdrPull h Ψ y)⁻¹ a j * pd2 j Vt y) := by
      intro a
      funext y
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [hAt]
      ring
    rw [Fin.sum_univ_two, hfun 0, hfun 1, hdiv] at hE
    have hpos := hsqpos (Φ x) (hsB hΦxs)
    have hlap : lap2 (pcgbBdrPull h Ψ) Vt (Φ x) = 0 := by
      rcases mul_eq_zero.mp hE with h0 | h0
      · exact absurd h0 hpos.ne'
      · exact h0
    rw [hchart] at hlap
    exact hlap
  · intro x hx hβx
    obtain ⟨hxN, hΦxs⟩ := hrsub hx
    have h1 := hβΨ (Φ x) (hsB hΦxs)
    rw [(hΦN x hxN).2] at h1
    exact hVd (Φ x) hΦxs (h1.symm.trans hβx)

theorem pcgb_patch_chart_glue (W : Set E2) (hW : IsOpen W) (K : Set E2) (hK : IsCompact K)
    (hKW : K ⊆ W) (β : E2 → ℝ) (hβ : ContinuousOn β W) (Ws : Set E2) (w : E2 → ℝ)
    (hloc : ∀ x ∈ K, 0 ≤ β x → ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ W ∧ ∃ V : E2 → ℝ,
      ContDiffOn ℝ 2 V (Metric.ball x r) ∧ ContDiffOn ℝ ∞ V (Metric.ball x r ∩ Ws) ∧
      (∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ {y | 0 < β y})), w y = V y) ∧
      (∀ y ∈ Metric.ball x r, β y = 0 → V y = 0)) :
    ∃ vt : E2 → ℝ, ContDiff ℝ 2 vt ∧ ContDiffOn ℝ ∞ vt Ws ∧ (∀ y ∈ K, β y = 0 → vt y = 0) ∧
      volume {y | y ∈ K ∧ 0 < β y ∧ vt y ≠ w y} = 0 :=
by
  classical
  have hK'closed : IsClosed (K ∩ β ⁻¹' Set.Ici 0) :=
    ContinuousOn.preimage_isClosed_of_isClosed (hβ.mono hKW) hK.isClosed isClosed_Ici
  have hK'compact : IsCompact (K ∩ β ⁻¹' Set.Ici 0) :=
    hK.of_isClosed_subset hK'closed Set.inter_subset_left
  have hloc' : ∀ x ∈ K ∩ β ⁻¹' Set.Ici 0, ∃ r : ℝ, 0 < r ∧ ∃ V : E2 → ℝ,
      ContDiffOn ℝ 2 V (Metric.ball x r) ∧ ContDiffOn ℝ ∞ V (Metric.ball x r ∩ Ws) ∧
      (∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ {y | 0 < β y})), w y = V y) ∧
      (∀ y ∈ Metric.ball x r, β y = 0 → V y = 0) := by
    intro x hx
    obtain ⟨r, hr, -, V, h1, h2, h3, h4⟩ := hloc x hx.1 hx.2
    exact ⟨r, hr, V, h1, h2, h3, h4⟩
  choose! r hr V hV2 hVs hVae hV0 using hloc'
  obtain ⟨t, htK, hcovt⟩ := hK'compact.elim_nhds_subcover (fun x => Metric.ball x (r x))
    (fun x hx => Metric.ball_mem_nhds x (hr x hx))
  have hcov : K ∩ β ⁻¹' Set.Ici 0 ⊆ ⋃ i : ↥t, Metric.ball (i : E2) (r (i : E2)) := by
    intro y hy
    have h := hcovt hy
    rw [Set.mem_iUnion₂] at h
    obtain ⟨x, hx, hyx⟩ := h
    exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hyx⟩
  obtain ⟨f, hf⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ, E2) hK'closed
    (fun i : ↥t => Metric.ball (i : E2) (r (i : E2))) (fun _ => Metric.isOpen_ball) hcov
  obtain ⟨χ, hP1, hP2, hP3⟩ : ∃ χ : ↥t → E2 → ℝ, (∀ i, ContDiff ℝ ∞ (χ i)) ∧
      (∀ i, tsupport (χ i) ⊆ Metric.ball (i : E2) (r (i : E2))) ∧
      (∀ y ∈ K ∩ β ⁻¹' Set.Ici 0, ∑ i, χ i y = 1) := by
    refine ⟨fun i => ⇑(f i), fun i => contMDiff_iff_contDiff.mp (f i).contMDiff,
      fun i => hf i, ?_⟩
    intro y hy
    have h := f.sum_eq_one hy
    rwa [finsum_eq_sum_of_fintype] at h
  have hP2' : ∀ i y, χ i y ≠ 0 → y ∈ Metric.ball (i : E2) (r (i : E2)) :=
    fun i y h => hP2 i (subset_tsupport _ (Function.mem_support.mpr h))
  have hmul : ∀ (n : WithTop ℕ∞) (i : ↥t) (s : Set E2),
      ContDiffOn ℝ n (V (i : E2)) (Metric.ball (i : E2) (r (i : E2)) ∩ s) →
      ContDiff ℝ n (χ i) →
      ContDiffOn ℝ n (fun y => χ i y * V (i : E2) y) s := by
    intro n i s hV hχ
    apply contDiffOn_of_locally_contDiffOn
    intro y _
    by_cases hyB : y ∈ Metric.ball (i : E2) (r (i : E2))
    · refine ⟨Metric.ball (i : E2) (r (i : E2)), Metric.isOpen_ball, hyB, ?_⟩
      exact hχ.contDiffOn.mul (hV.mono (fun z hz => ⟨hz.2, hz.1⟩))
    · refine ⟨(tsupport (χ i))ᶜ, (isClosed_tsupport _).isOpen_compl,
        fun h => hyB (hP2 i h), ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
      intro z hz
      simp [image_eq_zero_of_notMem_tsupport hz.2]
  refine ⟨fun y => ∑ i : ↥t, χ i y * V (i : E2) y, ?_, ?_, ?_, ?_⟩
  · apply ContDiff.sum
    intro i _
    have h := hmul 2 i Set.univ ((hV2 (i : E2) (htK (i : E2) i.2)).mono Set.inter_subset_left)
      ((hP1 i).of_le (by first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | simp))
    exact contDiffOn_univ.mp h
  · apply ContDiffOn.sum
    intro i _
    exact hmul ∞ i Ws (hVs (i : E2) (htK (i : E2) i.2)) (hP1 i)
  · intro y _ hβy
    apply Finset.sum_eq_zero
    intro i _
    by_cases h : χ i y = 0
    · rw [h, zero_mul]
    · rw [hV0 (i : E2) (htK (i : E2) i.2) y (hP2' i y h) hβy, mul_zero]
  · have hN : ∀ i : ↥t, volume {y | y ∈ Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y} ∧
        w y ≠ V (i : E2) y} = 0 := by
      intro i
      have h := hVae (i : E2) (htK (i : E2) i.2)
      have h1 : (volume.restrict (Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y}))
          {y | ¬ (w y = V (i : E2) y)} = 0 := MeasureTheory.ae_iff.mp h
      have h2 : volume ({y | ¬ (w y = V (i : E2) y)} ∩
          (Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y})) ≤
          (volume.restrict (Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y}))
            {y | ¬ (w y = V (i : E2) y)} :=
        MeasureTheory.Measure.le_restrict_apply _ _
      rw [h1] at h2
      have hsub : {y | y ∈ Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y} ∧
          w y ≠ V (i : E2) y} ⊆ {y | ¬ (w y = V (i : E2) y)} ∩
          (Metric.ball (i : E2) (r (i : E2)) ∩ {y | 0 < β y}) :=
        fun y hy => ⟨hy.2, hy.1⟩
      exact MeasureTheory.measure_mono_null hsub (le_antisymm h2 (zero_le _))
    refine MeasureTheory.measure_mono_null ?_ (MeasureTheory.measure_iUnion_null hN)
    intro y hy
    obtain ⟨hyK, hβy, hne⟩ := hy
    by_contra hnot
    rw [Set.mem_iUnion] at hnot
    push_neg at hnot
    apply hne
    have hyK' : y ∈ K ∩ β ⁻¹' Set.Ici 0 := ⟨hyK, le_of_lt hβy⟩
    have hterm : ∀ i ∈ (Finset.univ : Finset ↥t),
        χ i y * V (i : E2) y = χ i y * w y := by
      intro i _
      by_cases h : χ i y = 0
      · rw [h, zero_mul, zero_mul]
      · have hyB := hP2' i y h
        have hni := hnot i
        have heq : w y = V (i : E2) y := by
          by_contra hc
          exact hni ⟨⟨hyB, hβy⟩, hc⟩
        rw [heq]
    show ∑ i : ↥t, χ i y * V (i : E2) y = w y
    rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, hP3 y hyK', one_mul]

theorem pcgb_patch_regularity {X : Type*} [TopologicalSpace X] [T2Space X] (S : Set X)
    (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0) (p₀ : X) (vt : Fin P.n → E2 → ℝ)
    (hvt2 : ∀ j, ContDiff ℝ 2 (vt j))
    (hvtS : ∀ j, ContDiffOn ℝ ∞ (vt j) (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ)) :
    (∀ k, ContDiffOn ℝ ∞ (fun x => ∑ j, ρ j (P.param k x) * vt j (P.proj j (P.param k x)))
      (P.W k ∩ P.param k ⁻¹' {p₀}ᶜ)) ∧
    (∀ k, ContDiffOn ℝ 2 (fun x => ∑ j, ρ j (P.param k x) * vt j (P.proj j (P.param k x)))
      (P.W k)) :=
by
  classical
  have hparamS : ∀ i, ∀ x ∈ P.W i, P.param i x ∈ P.O i ∩ S := by
    intro i x hx
    have h := Set.mem_image_of_mem (P.param i) hx
    rw [P.image_eq i] at h
    exact h
  have htr : ∀ k j, ∀ x ∈ P.W k, P.param k x ∈ P.O j →
      P.proj j (P.param k x) ∈ P.W j ∧ P.param j (P.proj j (P.param k x)) = P.param k x := by
    intro k j x hx hO
    have hmem : P.param k x ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hO, (hparamS k x hx).2⟩
    obtain ⟨z, hz, hzx⟩ := hmem
    rw [← hzx, P.proj_param j z hz]
    exact ⟨hz, rfl⟩
  have hCc : ∀ j, IsClosed (P.param j '' Kc j) := fun j =>
    ((hK j).1.image_of_continuousOn ((P.param_cont j).mono (hK j).2)).isClosed
  have hCO : ∀ j, P.param j '' Kc j ⊆ P.O j := by
    rintro j _ ⟨z, hz, rfl⟩
    exact (hparamS j z ((hK j).2 hz)).1
  have hρ0 : ∀ j q, q ∈ S → q ∉ P.param j '' Kc j → ρ j q = 0 := by
    intro j q hqS hqC
    by_contra hne
    have hO : q ∈ P.O j := by
      by_contra hn
      exact hne (hρO j q hn)
    have hmem : q ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hO, hqS⟩
    obtain ⟨z, hz, rfl⟩ := hmem
    by_cases hzK : z ∈ Kc j
    · exact hqC ⟨z, hzK, rfl⟩
    · exact hne (hρK j z hz hzK)
  have key : ∀ (n : WithTop ℕ∞) (k j : Fin P.n) (s : Set E2), n ≤ ∞ → s ⊆ P.W k →
      ContDiffOn ℝ n (fun x => vt j (P.proj j (P.param k x)))
        (s ∩ (P.W k ∩ P.param k ⁻¹' P.O j)) →
      ContDiffOn ℝ n (fun x => ρ j (P.param k x) * vt j (P.proj j (P.param k x))) s := by
    intro n k j s hn hs hv
    apply contDiffOn_of_locally_contDiffOn
    intro x hx
    by_cases hxO : P.param k x ∈ P.O j
    · refine ⟨P.W k ∩ P.param k ⁻¹' P.O j,
        (P.param_cont k).isOpen_inter_preimage (P.W_open k) (P.O_open j), ⟨hs hx, hxO⟩, ?_⟩
      exact (((hρs j k).of_le hn).mono (fun y hy => hs hy.1)).mul hv
    · refine ⟨P.W k ∩ P.param k ⁻¹' (P.param j '' Kc j)ᶜ,
        (P.param_cont k).isOpen_inter_preimage (P.W_open k) (hCc j).isOpen_compl,
        ⟨hs hx, fun h => hxO (hCO j h)⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr ?_
      intro y hy
      rw [hρ0 j _ (hparamS k y hy.2.1).2 hy.2.2, zero_mul]
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  refine ⟨fun k => ?_, fun k => ?_⟩
  · apply ContDiffOn.sum
    intro j _
    refine key ∞ k j _ le_rfl (fun y hy => hy.1) ?_
    have hm : Set.MapsTo (fun x => P.proj j (P.param k x))
        ((P.W k ∩ P.param k ⁻¹' {p₀}ᶜ) ∩ (P.W k ∩ P.param k ⁻¹' P.O j))
        (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) := by
      intro y hy
      obtain ⟨h1, h2⟩ := htr k j y hy.2.1 hy.2.2
      refine ⟨h1, ?_⟩
      show P.param j (P.proj j (P.param k y)) ∈ ({p₀}ᶜ : Set X)
      rw [h2]
      exact hy.1.2
    exact (hvtS j).comp ((P.trans_smooth k j).mono Set.inter_subset_right) hm
  · apply ContDiffOn.sum
    intro j _
    refine key 2 k j _ h2inf subset_rfl ?_
    exact (hvt2 j).comp_contDiffOn
      (((P.trans_smooth k j).of_le h2inf).mono Set.inter_subset_right)

theorem pcgb_patch_ae_eq {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S)
    (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0) (b : X → ℝ)
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1) (w : Fin P.n → E2 → ℝ)
    (hwc : ∀ j k, ∀ᵐ x ∂(volume.restrict (P.W j ∩ P.param j ⁻¹' P.O k)),
      w j x = w k (P.proj k (P.param j x)))
    (vt : Fin P.n → E2 → ℝ)
    (hnull : ∀ j, volume {y | y ∈ Kc j ∧ 0 < b (P.param j y) ∧ vt j y ≠ w j y} = 0) :
    ∀ k, volume {y | y ∈ P.W k ∧ 0 < b (P.param k y) ∧
      ∑ j, ρ j (P.param k y) * vt j (P.proj j (P.param k y)) ≠ w k y} = 0 :=
by
  intro k
  classical
  set A : Fin P.n → Set E2 := fun j =>
    {y | ¬(y ∈ P.W k ∩ P.param k ⁻¹' P.O j → w k y = w j (P.proj j (P.param k y)))} with hAdef
  have hA : ∀ j, volume (A j) = 0 := by
    intro j
    have hopen : IsOpen (P.W k ∩ P.param k ⁻¹' P.O j) :=
      (P.param_cont k).isOpen_inter_preimage (P.W_open k) (P.O_open j)
    have h1 := (ae_restrict_iff' hopen.measurableSet).mp (hwc k j)
    exact ae_iff.mp h1
  set B : Fin P.n → Set E2 := fun j =>
    (fun x => P.proj k (P.param j x)) ''
      ({y | y ∈ Kc j ∧ 0 < b (P.param j y) ∧ vt j y ≠ w j y} ∩
        (P.W j ∩ P.param j ⁻¹' P.O k)) with hBdef
  have hB : ∀ j, volume (B j) = 0 := by
    intro j
    have hd : DifferentiableOn ℝ (fun x => P.proj k (P.param j x))
        ({y | y ∈ Kc j ∧ 0 < b (P.param j y) ∧ vt j y ≠ w j y} ∩
          (P.W j ∩ P.param j ⁻¹' P.O k)) :=
      ((P.trans_smooth j k).differentiableOn (by simp)).mono Set.inter_subset_right
    exact MeasureTheory.addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume hd
      (measure_mono_null Set.inter_subset_left (hnull j))
  have hU : volume (⋃ j, (A j ∪ B j)) = 0 :=
    measure_iUnion_null (fun j => measure_union_null (hA j) (hB j))
  refine measure_mono_null ?_ hU
  rintro y ⟨hyW, hby, hne⟩
  by_contra hn
  simp only [Set.mem_iUnion, not_exists, Set.mem_union, not_or] at hn
  have hqS : P.param k y ∈ P.O k ∩ S := by
    have h := Set.mem_image_of_mem (P.param k) hyW
    rw [P.image_eq k] at h
    exact h
  apply hne
  have hterm : ∀ j, ρ j (P.param k y) * vt j (P.proj j (P.param k y)) =
      ρ j (P.param k y) * w k y := by
    intro j
    by_cases hρ0 : ρ j (P.param k y) = 0
    · rw [hρ0, zero_mul, zero_mul]
    · have hO : P.param k y ∈ P.O j := by
        by_contra hc
        exact hρ0 (hρO j _ hc)
      have hmem : P.param k y ∈ P.param j '' P.W j := by
        rw [P.image_eq j]; exact ⟨hO, hqS.2⟩
      obtain ⟨z, hz, hzq⟩ := hmem
      have hτ : P.proj j (P.param k y) = z := by rw [← hzq, P.proj_param j z hz]
      have hzK : z ∈ Kc j := by
        by_contra hc
        apply hρ0
        rw [← hzq]
        exact hρK j z hz hc
      have hbz : 0 < b (P.param j z) := by rw [hzq]; exact hby
      have hzD : z ∈ P.W j ∩ P.param j ⁻¹' P.O k := by
        refine ⟨hz, ?_⟩
        show P.param j z ∈ P.O k
        rw [hzq]; exact hqS.1
      have hback : P.proj k (P.param j z) = y := by rw [hzq, P.proj_param k y hyW]
      have hvt : vt j z = w j z := by
        by_contra hc
        exact (hn j).2 ⟨z, ⟨⟨hzK, hbz, hc⟩, hzD⟩, hback⟩
      have hwk : w k y = w j (P.proj j (P.param k y)) := by
        have h : ¬¬(y ∈ P.W k ∩ P.param k ⁻¹' P.O j →
            w k y = w j (P.proj j (P.param k y))) := (hn j).1
        exact not_not.mp h ⟨hyW, hO⟩
      rw [hτ] at hwk ⊢
      rw [hvt, hwk]
  rw [Finset.sum_congr rfl (fun j _ => hterm j), ← Finset.sum_mul, hρ1 _ hqS.2 hby.le, one_mul]

theorem pcgb_ds_patch {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0)
    (p₀ : X) (f : X → ℝ) (w : Fin P.n → E2 → ℝ)
    (hwc : ∀ j k, ∀ᵐ x ∂(volume.restrict (P.W j ∩ P.param j ⁻¹' P.O k)),
      w j x = w k (P.proj k (P.param j x)))
    (hloc : ∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) →
      ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ P.W j ∧ ∃ V : E2 → ℝ,
        ContDiffOn ℝ 2 V (Metric.ball x r) ∧
        ContDiffOn ℝ ∞ V (Metric.ball x r ∩ P.param j ⁻¹' {p₀}ᶜ) ∧
        (∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ {y | 0 < b (P.param j y)})), w j y = V y) ∧
        (∀ y ∈ Metric.ball x r, 0 ≤ b (P.param j y) → lap2 (P.h j) V y = f (P.param j y)) ∧
        (∀ y ∈ Metric.ball x r, b (P.param j y) = 0 → V y = 0)) :
    ∃ (v : X → ℝ) (U : Set X), IsOpen U ∧ {q | q ∈ S ∧ 0 ≤ b q} ⊆ U ∧
      (∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀}))) ∧
      (∀ j, ContDiffOn ℝ 2 (fun x => v (P.param j x)) (P.W j ∩ P.param j ⁻¹' U)) ∧
      (∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) →
        lap2 (P.h j) (fun y => v (P.param j y)) x = f (P.param j x)) ∧
      (∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 → v (P.param j x) = 0) :=
by
  classical
  have hparamS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro j x hx
    have h := Set.mem_image_of_mem (P.param j) hx
    rw [P.image_eq j] at h
    exact h
  
  have hglue : ∀ j, ∃ vt : E2 → ℝ, ContDiff ℝ 2 vt ∧
      ContDiffOn ℝ ∞ vt (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) ∧
      (∀ y ∈ Kc j, b (P.param j y) = 0 → vt y = 0) ∧
      volume {y | y ∈ Kc j ∧ 0 < b (P.param j y) ∧ vt y ≠ w j y} = 0 := by
    intro j
    refine pcgb_patch_chart_glue (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
      (fun y => b (P.param j y)) (hb j).continuousOn (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) (w j) ?_
    intro x hx hbx
    obtain ⟨r, hr, hball, V, h2, hinf, hae, -, hd⟩ := hloc j x ((hK j).2 hx) hbx
    exact ⟨r, hr, hball, V, h2, hinf.mono (fun y hy => ⟨hy.1, hy.2.2⟩), hae, hd⟩
  choose vt hvt2 hvtS hvt0 hvtN using hglue
  
  obtain ⟨hreg1, hreg2⟩ := pcgb_patch_regularity S P ρ Kc hρs hK hρK hρO p₀ vt hvt2 hvtS
  have hae := pcgb_patch_ae_eq S P ρ Kc hρK hρO b hρ1 w hwc vt hvtN
  refine ⟨fun q => ∑ j, ρ j q * vt j (P.proj j q), Set.univ, isOpen_univ,
    Set.subset_univ _, ?_, ?_, ?_, ?_⟩
  · 
    intro k
    rw [← Set.compl_eq_univ_diff]
    exact hreg1 k
  · 
    intro k
    rw [Set.preimage_univ, Set.inter_univ]
    exact hreg2 k
  · 
    intro k x hx hbx
    obtain ⟨r, hr, hball, V, hV2, -, hVae, hVlap, -⟩ := hloc k x hx hbx
    have hΩo : IsOpen (P.W k ∩ {y | 0 < b (P.param k y)}) :=
      (hb k).continuousOn.isOpen_inter_preimage (P.W_open k) isOpen_Ioi
    have hBo : IsOpen (Metric.ball x r) := Metric.isOpen_ball
    have hxB : x ∈ Metric.ball x r := Metric.mem_ball_self hr
    have hEo : IsOpen (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) := hBo.inter hΩo
    have hEB : Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}) ⊆ Metric.ball x r :=
      Set.inter_subset_left
    
    have hxcl : x ∈ closure (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) := by
      rcases hbx.lt_or_eq with hpos | hzero
      · exact subset_closure ⟨hxB, hx, hpos⟩
      · have hb0 : b (P.param k x) = 0 := hzero.symm
        have hdb := hreg k x hx hb0
        obtain ⟨d, hd⟩ : ∃ d, fderiv ℝ (fun y => b (P.param k y)) x d ≠ 0 := by
          by_contra hcon
          push_neg at hcon
          exact hdb (ContinuousLinearMap.ext hcon)
        obtain ⟨d', hLd'⟩ : ∃ d' : E2, fderiv ℝ (fun y => b (P.param k y)) x d' = 1 :=
          ⟨(fderiv ℝ (fun y => b (P.param k y)) x d)⁻¹ • d, by
            rw [ContinuousLinearMap.map_smul, smul_eq_mul, inv_mul_cancel₀ hd]⟩
        have hdiff : DifferentiableAt ℝ (fun y => b (P.param k y)) x :=
          ((hb k).contDiffAt ((P.W_open k).mem_nhds hx)).differentiableAt (by simp)
        have hγ : HasDerivAt (fun t : ℝ => x + t • d') d' 0 := by
          simpa using ((hasDerivAt_id (0 : ℝ)).smul_const d').const_add x
        have hf : HasFDerivAt (fun y => b (P.param k y))
            (fderiv ℝ (fun y => b (P.param k y)) x) (x + (0 : ℝ) • d') := by
          rw [zero_smul, add_zero]
          exact hdiff.hasFDerivAt
        have hcomp := HasFDerivAt.comp_hasDerivAt (f := fun t : ℝ => x + t • d') 0 hf hγ
        rw [hLd'] at hcomp
        have hev1 := hcomp.tendsto_slope_zero_right.eventually_const_lt one_pos
        have hev2 : ∀ᶠ t in 𝓝[>] (0 : ℝ), (0 : ℝ) < t := self_mem_nhdsWithin
        have hcont : Tendsto (fun t : ℝ => x + t • d') (𝓝[>] 0) (𝓝 x) := by
          have hc : Continuous (fun t : ℝ => x + t • d') := by fun_prop
          have h := hc.tendsto 0
          simp only [zero_smul, add_zero] at h
          exact h.mono_left nhdsWithin_le_nhds
        have hBW : Metric.ball x r ∩ P.W k ∈ 𝓝 x :=
          (hBo.inter (P.W_open k)).mem_nhds ⟨hxB, hx⟩
        haveI : (𝓝[>] (0 : ℝ)).NeBot := nhdsGT_neBot 0
        refine mem_closure_of_tendsto hcont ?_
        filter_upwards [hev1, hev2, hcont hBW] with t h1 h2 h3
        refine ⟨h3.1, h3.2, ?_⟩
        simp only [Function.comp_apply, zero_add, zero_smul, add_zero, hb0, sub_zero,
          smul_eq_mul] at h1
        show 0 < b (P.param k (x + t • d'))
        by_contra hn
        push_neg at hn
        have := mul_nonpos_of_nonneg_of_nonpos (inv_pos.mpr h2).le hn
        linarith
    
    have hjet : ∀ G : E2 → ℝ, ContDiffOn ℝ 2 G (Metric.ball x r) → ∀ i j : Fin 2,
        ContinuousOn (pd2 j G) (Metric.ball x r) ∧
        ContinuousOn (pd2 i (pd2 j G)) (Metric.ball x r) := by
      intro G hG i j
      have h1 : ContDiffOn ℝ 1 (fderiv ℝ G) (Metric.ball x r) :=
        hG.fderiv_of_isOpen hBo (by norm_num)
      have h2 : ContDiffOn ℝ 1 (pd2 j G) (Metric.ball x r) :=
        h1.clm_apply (contDiffOn_const (c := e2 j))
      refine ⟨h2.continuousOn, ?_⟩
      have h3 : ContinuousOn (fderiv ℝ (pd2 j G)) (Metric.ball x r) :=
        h2.continuousOn_fderiv_of_isOpen hBo le_rfl
      exact (ContinuousLinearMap.apply ℝ ℝ (e2 i)).continuous.comp_continuousOn h3
    
    have key : ∀ F : E2 → ℝ, ContDiffOn ℝ 2 F (Metric.ball x r) →
        (∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}))),
          F y = w k y) →
        lap2 (P.h k) F x = f (P.param k x) := by
      intro F hFB hFw
      have hwV : ∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}))),
          w k y = V y :=
        ae_restrict_of_ae_restrict_of_subset
          (show Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}) ⊆
            Metric.ball x r ∩ {y | 0 < b (P.param k y)} from fun y hy => ⟨hy.1, hy.2.2⟩) hVae
      have hFV : F =ᵐ[volume.restrict (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}))] V := by
        filter_upwards [hFw, hwV] with y h1 h2
        rw [h1, h2]
      have hEq : Set.EqOn F V (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) :=
        Measure.eqOn_open_of_ae_eq hFV hEo (hFB.continuousOn.mono hEB)
          (hV2.continuousOn.mono hEB)
      have hE1 : ∀ j : Fin 2, Set.EqOn (pd2 j F) (pd2 j V)
          (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) := by
        intro j y hy
        have hev : F =ᶠ[𝓝 y] V := Filter.eventually_of_mem (hEo.mem_nhds hy) hEq
        show fderiv ℝ F y (e2 j) = fderiv ℝ V y (e2 j)
        rw [hev.fderiv_eq]
      have hE2 : ∀ i j : Fin 2, Set.EqOn (pd2 i (pd2 j F)) (pd2 i (pd2 j V))
          (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) := by
        intro i j y hy
        have hev : pd2 j F =ᶠ[𝓝 y] pd2 j V := Filter.eventually_of_mem (hEo.mem_nhds hy) (hE1 j)
        show fderiv ℝ (pd2 j F) y (e2 i) = fderiv ℝ (pd2 j V) y (e2 i)
        rw [hev.fderiv_eq]
      have hxt : x ∈ Metric.ball x r ∩
          closure (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) := ⟨hxB, hxcl⟩
      have hsub : Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}) ⊆ Metric.ball x r ∩
          closure (Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)})) :=
        fun y hy => ⟨hEB hy, subset_closure hy⟩
      have hJ1 : ∀ j : Fin 2, pd2 j F x = pd2 j V x := fun j =>
        Set.EqOn.of_subset_closure (hE1 j) ((hjet F hFB 0 j).1.mono Set.inter_subset_left)
          ((hjet V hV2 0 j).1.mono Set.inter_subset_left) hsub Set.inter_subset_right hxt
      have hJ2 : ∀ i j : Fin 2, pd2 i (pd2 j F) x = pd2 i (pd2 j V) x := fun i j =>
        Set.EqOn.of_subset_closure (hE2 i j) ((hjet F hFB i j).2.mono Set.inter_subset_left)
          ((hjet V hV2 i j).2.mono Set.inter_subset_left) hsub Set.inter_subset_right hxt
      have hlapeq : lap2 (P.h k) F x = lap2 (P.h k) V x := by
        simp only [lap2, hJ1, hJ2]
      rw [hlapeq]
      exact hVlap x hxB hbx
    apply key
    · exact (hreg2 k).mono hball
    · rw [ae_restrict_iff' hEo.measurableSet, ae_iff]
      refine measure_mono_null ?_ (hae k)
      intro y hy
      have hy' : ¬(y ∈ Metric.ball x r ∩ (P.W k ∩ {y | 0 < b (P.param k y)}) →
          (fun y => ∑ j, ρ j (P.param k y) * vt j (P.proj j (P.param k y))) y = w k y) := hy
      obtain ⟨hyE, hne⟩ := _root_.not_imp.mp hy'
      exact ⟨hyE.2.1, hyE.2.2, hne⟩
  · 
    intro k x hx hb0
    show ∑ j, ρ j (P.param k x) * vt j (P.proj j (P.param k x)) = 0
    apply Finset.sum_eq_zero
    intro j _
    by_cases hρ0 : ρ j (P.param k x) = 0
    · rw [hρ0, zero_mul]
    · have hO : P.param k x ∈ P.O j := by
        by_contra hn
        exact hρ0 (hρO j _ hn)
      have hmem : P.param k x ∈ P.param j '' P.W j := by
        rw [P.image_eq j]
        exact ⟨hO, (hparamS k x hx).2⟩
      obtain ⟨z, hz, hzx⟩ := hmem
      have hzK : z ∈ Kc j := by
        by_contra hn
        apply hρ0
        rw [← hzx]
        exact hρK j z hz hn
      rw [← hzx, P.proj_param j z hz, hvt0 j z hzK (by rw [hzx]; exact hb0), mul_zero]

theorem pcgb_dirichlet_solve {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0)
    (p₀ : X) (f : X → ℝ)
    (hf1 : ∀ j, ContDiffOn ℝ ∞ (fun x => f (P.param j x)) (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ))
    (hf2 : ∀ j, ∀ x ∈ P.W j, ∃ δ K : ℝ, 0 < δ ∧ Metric.ball x δ ⊆ P.W j ∧
      ∀ y ∈ Metric.ball x δ, ∀ z ∈ Metric.ball x δ,
        |f (P.param j y) - f (P.param j z)| ≤ K * dist y z ^ (1 / 2 : ℝ))
    (hf3 : ∃ c : ℝ, 0 < c ∧ ∀ q ∈ S, b q < c → f q = 0) :
    ∃ (v : X → ℝ) (U : Set X), IsOpen U ∧ {q | q ∈ S ∧ 0 ≤ b q} ⊆ U ∧
      (∀ j, ContDiffOn ℝ ∞ (fun x => v (P.param j x)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀}))) ∧
      (∀ j, ContDiffOn ℝ 2 (fun x => v (P.param j x)) (P.W j ∩ P.param j ⁻¹' U)) ∧
      (∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) →
        lap2 (P.h j) (fun y => v (P.param j y)) x = f (P.param j x)) ∧
      (∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 → v (P.param j x) = 0) :=
by
  obtain ⟨c₀, hc₀, hf3'⟩ := hf3
  have hparamS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have h := Set.mem_image_of_mem (P.param j) hx
    rw [P.image_eq j] at h
    exact h.2
  have hpoinc := pcgb_ds_dirichlet_poincare S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1
    hreg hbd
  have hfc : ∀ j, ContinuousOn (fun x => f (P.param j x)) (P.W j) := by
    intro j x hx
    obtain ⟨δ, K, hδ, -, hH⟩ := hf2 j x hx
    apply ContinuousAt.continuousWithinAt
    have hcont : Continuous fun y : E2 => max K 0 * dist y x ^ (1 / 2 : ℝ) :=
      continuous_const.mul ((continuous_id.dist continuous_const).rpow_const
        (fun _ => Or.inr (by norm_num)))
    have hlim : Tendsto (fun y : E2 => max K 0 * dist y x ^ (1 / 2 : ℝ)) (𝓝 x) (𝓝 0) := by
      have := hcont.tendsto x
      simpa [Real.zero_rpow (by norm_num : (1 / 2 : ℝ) ≠ 0)] using this
    rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero' (Eventually.of_forall fun y => norm_nonneg _) ?_ hlim
    filter_upwards [Metric.ball_mem_nhds x hδ] with y hy
    rw [Real.norm_eq_abs]
    calc |f (P.param j y) - f (P.param j x)| ≤ K * dist y x ^ (1 / 2 : ℝ) :=
          hH y hy x (Metric.mem_ball_self hδ)
      _ ≤ max K 0 * dist y x ^ (1 / 2 : ℝ) :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg dist_nonneg _)
  obtain ⟨u, w, G, hua, hub, huc, hud, hue, hug⟩ :=
    pcgb_ds_weak_solution S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1 hreg hbd f hfc hpoinc
  have hloc : ∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) →
      ∃ r : ℝ, 0 < r ∧ Metric.ball x r ⊆ P.W j ∧ ∃ V : E2 → ℝ,
        ContDiffOn ℝ 2 V (Metric.ball x r) ∧
        ContDiffOn ℝ ∞ V (Metric.ball x r ∩ P.param j ⁻¹' {p₀}ᶜ) ∧
        (∀ᵐ y ∂(volume.restrict (Metric.ball x r ∩ {y | 0 < b (P.param j y)})), w j y = V y) ∧
        (∀ y ∈ Metric.ball x r, 0 ≤ b (P.param j y) → lap2 (P.h j) V y = f (P.param j y)) ∧
        (∀ y ∈ Metric.ball x r, b (P.param j y) = 0 → V y = 0) := by
    intro j x hx hbx
    rcases hbx.lt_or_eq with hpos | hzero
    · 
      have hΩo : IsOpen (P.W j ∩ {y | 0 < b (P.param j y)}) :=
        (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi
      have hΩW : P.W j ∩ {y | 0 < b (P.param j y)} ⊆ P.W j := Set.inter_subset_left
      have hxΩ : x ∈ P.W j ∩ {y | 0 < b (P.param j y)} := ⟨hx, hpos⟩
      have hWso : IsOpen (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) :=
        (P.param_cont j).isOpen_inter_preimage (P.W_open j) isOpen_compl_singleton
      have hF : ∀ y ∈ P.W j ∩ {y | 0 < b (P.param j y)}, ∃ δ K : ℝ, 0 < δ ∧
          Metric.ball y δ ⊆ P.W j ∩ {y | 0 < b (P.param j y)} ∧
          ∀ y' ∈ Metric.ball y δ, ∀ z ∈ Metric.ball y δ,
            |(fun y => f (P.param j y)) y' - (fun y => f (P.param j y)) z| ≤
              K * dist y' z ^ (1 / 2 : ℝ) := by
        intro y hy
        obtain ⟨δ, K, hδ, -, hH⟩ := hf2 j y (hΩW hy)
        obtain ⟨δ₂, hδ₂, hball⟩ := Metric.isOpen_iff.mp hΩo y hy
        refine ⟨min δ δ₂, K, lt_min hδ hδ₂,
          (Metric.ball_subset_ball (min_le_right _ _)).trans hball, ?_⟩
        intro y' hy' z hz
        exact hH y' (Metric.ball_subset_ball (min_le_left _ _) hy') z
          (Metric.ball_subset_ball (min_le_left _ _) hz)
      obtain ⟨w', hw'2, hw'S, hw'ae, hw'lap⟩ := pcgb_ds_interior_regularity
        (P.W j ∩ {y | 0 < b (P.param j y)}) hΩo (P.h j)
        (fun a c => (P.h_smooth j a c).mono hΩW) (fun y hy => P.h_posDef j y (hΩW hy))
        (fun y => f (P.param j y)) hF (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) hWso
        ((hf1 j).mono fun y hy => hy.2) (w j) (G j)
        (fun L hL hLΩ => ⟨(huc j L hL (hLΩ.trans hΩW)).1, (huc j L hL (hLΩ.trans hΩW)).2.1⟩)
        (fun ζ hζ hζc hζs => hud j ζ hζ hζc (hζs.trans hΩW))
        (fun ζ hζ hζc hζs => hue j ζ hζ hζc hζs)
      obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hΩo x hxΩ
      refine ⟨r, hr, hball.trans hΩW, w', hw'2.mono hball,
        hw'S.mono fun y hy => ⟨hball hy.1, hΩW (hball hy.1), hy.2⟩,
        ae_restrict_of_ae_restrict_of_subset (fun y hy => hball hy.1) hw'ae,
        fun y hy _ => hw'lap y (hball hy), ?_⟩
      intro y hy hb0
      exact absurd hb0 (hball hy).2.ne'
    · 
      have hW'o : IsOpen (P.W j ∩ {y | b (P.param j y) < c₀}) :=
        (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Iio
      have hW'W : P.W j ∩ {y | b (P.param j y) < c₀} ⊆ P.W j := Set.inter_subset_left
      have hxW' : x ∈ P.W j ∩ {y | b (P.param j y) < c₀} := by
        refine ⟨hx, ?_⟩
        show b (P.param j x) < c₀
        rw [← hzero]
        exact hc₀
      have hfz : ∀ y ∈ P.W j ∩ {y | b (P.param j y) < c₀}, f (P.param j y) = 0 :=
        fun y hy => hf3' _ (hparamS j y hy.1) hy.2
      have hweak : ∀ ζ : E2 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
          tsupport ζ ⊆ (P.W j ∩ {y | b (P.param j y) < c₀}) ∩
            {y | 0 < (fun y => b (P.param j y)) y} →
          ∫ y, ∑ a : Fin 2, ∑ c : Fin 2,
            Real.sqrt (P.h j y).det * (P.h j y)⁻¹ a c * G j c y * pd2 a ζ y = 0 := by
        intro ζ hζ hζc hζs
        have h1 := hue j ζ hζ hζc (fun y hy => ⟨hW'W (hζs hy).1, (hζs hy).2⟩)
        rw [← h1]
        congr 1
        funext y
        by_cases hy : ζ y = 0
        · simp [hy]
        · have hyW : y ∈ P.W j ∩ {y | b (P.param j y) < c₀} := (hζs (subset_tsupport ζ hy)).1
          simp [hfz y hyW]
      obtain ⟨r, hr, hball, V, hV, hVae, hVlap, hVd⟩ := pcgb_ds_boundary_regularity
        (P.W j ∩ {y | b (P.param j y) < c₀}) hW'o (P.h j)
        (fun a c => (P.h_smooth j a c).mono hW'W) (fun y hy => P.h_posDef j y (hW'W hy))
        (fun y => b (P.param j y)) ((hb j).mono hW'W) x hxW' hzero.symm
        (hreg j x hx hzero.symm)
        (fun m y => u m (P.param j y)) (fun m => (hua m j).mono hW'W)
        (fun m => by
          obtain ⟨c, hc, hcz⟩ := hub m
          exact ⟨c, hc, fun y hy hby => hcz _ (hparamS j y (hW'W hy)) hby⟩)
        (w j) (G j) (fun L hL hLW => huc j L hL (hLW.trans hW'W)) hweak
      refine ⟨r, hr, hball.trans hW'W, V, hV.of_le (WithTop.coe_le_coe.mpr le_top),
        hV.mono Set.inter_subset_left, hVae, ?_, hVd⟩
      intro y hy hby
      rw [hVlap y hy hby, hfz y (hball hy)]
  exact pcgb_ds_patch S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1 hreg hbd p₀ f w hug hloc

theorem pcgb_punctured_interior_connected {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ)
    (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (p₀ : X) (hp₀ : p₀ ∈ S) (hbp₀ : 0 < b p₀) :
    IsPreconnected ({q | q ∈ S ∧ 0 < b q} \ {p₀}) :=
by
  classical
  
  have glue : ∀ (R' A' : Set X), A' ⊆ R' → IsPreconnected R' → R' ⊆ closure A' →
      (∀ q ∈ R', ∃ N : Set X, IsOpen N ∧ q ∈ N ∧ IsPreconnected (N ∩ A')) →
      IsPreconnected A' := by
    intro R' A' hAR hR hcl hloc
    choose! N hNo hqN hNp using hloc
    intro U₁ U₂ hU₁ hU₂ hAU ⟨a₁, ha₁A, ha₁U⟩ ⟨a₂, ha₂A, ha₂U⟩
    by_contra hne
    have H : ∀ a ∈ A', a ∈ U₁ → a ∈ U₂ → False := fun a ha h1 h2 => hne ⟨a, ha, h1, h2⟩
    have dich : ∀ q ∈ R', N q ∩ A' ⊆ U₁ ∨ N q ∩ A' ⊆ U₂ := by
      intro q hq
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨h1, h2⟩ := hcon
      obtain ⟨c₁, hc₁, hc₁U⟩ := Set.not_subset.mp h1
      obtain ⟨c₂, hc₂, hc₂U⟩ := Set.not_subset.mp h2
      have hc₁2 : c₁ ∈ U₂ := (hAU hc₁.2).resolve_left hc₁U
      have hc₂1 : c₂ ∈ U₁ := (hAU hc₂.2).resolve_right hc₂U
      obtain ⟨d, hd, hd1, hd2⟩ := hNp q hq U₁ U₂ hU₁ hU₂ (fun y hy => hAU hy.2)
        ⟨c₂, hc₂, hc₂1⟩ ⟨c₁, hc₁, hc₁2⟩
      exact H d hd.2 hd1 hd2
    have hV₁ : IsOpen (⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₁}, N q) :=
      isOpen_biUnion (fun q hq => hNo q hq.1)
    have hV₂ : IsOpen (⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₂}, N q) :=
      isOpen_biUnion (fun q hq => hNo q hq.1)
    have hRV : R' ⊆ (⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₁}, N q) ∪
        (⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₂}, N q) := by
      intro q hq
      rcases dich q hq with h | h
      · exact Set.mem_union_left _ (Set.mem_biUnion ⟨hq, h⟩ (hqN q hq))
      · exact Set.mem_union_right _ (Set.mem_biUnion ⟨hq, h⟩ (hqN q hq))
    have ha₁V : a₁ ∈ ⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₁}, N q := by
      have hq := hAR ha₁A
      rcases dich a₁ hq with h | h
      · exact Set.mem_biUnion ⟨hq, h⟩ (hqN a₁ hq)
      · exact (H a₁ ha₁A ha₁U (h ⟨hqN a₁ hq, ha₁A⟩)).elim
    have ha₂V : a₂ ∈ ⋃ q ∈ {q | q ∈ R' ∧ N q ∩ A' ⊆ U₂}, N q := by
      have hq := hAR ha₂A
      rcases dich a₂ hq with h | h
      · exact (H a₂ ha₂A (h ⟨hqN a₂ hq, ha₂A⟩) ha₂U).elim
      · exact Set.mem_biUnion ⟨hq, h⟩ (hqN a₂ hq)
    obtain ⟨y, hyR, hy1, hy2⟩ := hR _ _ hV₁ hV₂ hRV ⟨a₁, hAR ha₁A, ha₁V⟩ ⟨a₂, hAR ha₂A, ha₂V⟩
    obtain ⟨q₁, hq₁m, hyq₁⟩ := Set.mem_iUnion₂.mp hy1
    obtain ⟨q₂, hq₂m, hyq₂⟩ := Set.mem_iUnion₂.mp hy2
    obtain ⟨hq₁R, hq₁⟩ := hq₁m
    obtain ⟨hq₂R, hq₂⟩ := hq₂m
    obtain ⟨a, ⟨haN1, haN2⟩, haA⟩ := mem_closure_iff.mp (hcl hyR) (N q₁ ∩ N q₂)
      ((hNo q₁ hq₁R).inter (hNo q₂ hq₂R)) ⟨hyq₁, hyq₂⟩
    exact H a haA (hq₁ ⟨haN1, haA⟩) (hq₂ ⟨haN2, haA⟩)
  
  have transfer : ∀ (j : Fin P.n) (x : E2) (V : Set E2), IsOpen V → V ⊆ P.W j → x ∈ V →
      IsPreconnected {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} →
      x ∈ closure {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} →
      P.param j x ∈ closure ({q | q ∈ S ∧ 0 < b q} \ {p₀}) ∧
        ∃ N : Set X, IsOpen N ∧ P.param j x ∈ N ∧
          IsPreconnected (N ∩ ({q | q ∈ S ∧ 0 < b q} \ {p₀})) := by
    intro j x V hV hVW hxV hD hcl
    have hOS : ∀ y ∈ P.W j, P.param j y ∈ P.O j ∩ S := fun y hy => by
      rw [← P.image_eq j]; exact ⟨y, hy, rfl⟩
    have himg : P.param j '' {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} ⊆
        {q | q ∈ S ∧ 0 < b q} \ {p₀} := by
      rintro _ ⟨y, ⟨hyV, hyb, hyp⟩, rfl⟩
      exact ⟨⟨(hOS y (hVW hyV)).2, hyb⟩, hyp⟩
    have hcont : ContinuousOn (P.param j)
        {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} :=
      (P.param_cont j).mono (fun y hy => hVW hy.1)
    refine ⟨?_, P.O j ∩ P.proj j ⁻¹' V,
      (P.proj_cont j).isOpen_inter_preimage (P.O_open j) hV,
      ⟨(hOS x (hVW hxV)).1, show P.proj j (P.param j x) ∈ V by
        rw [P.proj_param j x (hVW hxV)]; exact hxV⟩, ?_⟩
    · have hca : ContinuousWithinAt (P.param j)
          {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} x :=
        ((P.param_cont j).continuousAt ((P.W_open j).mem_nhds (hVW hxV))).continuousWithinAt
      exact closure_mono himg (hca.mem_closure_image hcl)
    · have heq : P.O j ∩ P.proj j ⁻¹' V ∩ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) =
          P.param j '' {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} := by
        ext q
        constructor
        · rintro ⟨⟨hqO, hqV⟩, ⟨hqS, hqb⟩, hqp⟩
          have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hqO, hqS⟩
          obtain ⟨y, hy, rfl⟩ := hq'
          have hyV : y ∈ V := by
            have h' : P.proj j (P.param j y) ∈ V := hqV
            rwa [P.proj_param j y hy] at h'
          exact ⟨y, ⟨hyV, hqb, hqp⟩, rfl⟩
        · rintro ⟨y, ⟨hyV, hyb, hyp⟩, rfl⟩
          refine ⟨⟨(hOS y (hVW hyV)).1, ?_⟩, ⟨(hOS y (hVW hyV)).2, hyb⟩, hyp⟩
          show P.proj j (P.param j y) ∈ V
          rw [P.proj_param j y (hVW hyV)]; exact hyV
      rw [heq]
      exact hD.image _ hcont
  
  have hrank : 1 < Module.rank ℝ E2 := by
    rw [← Module.finrank_eq_rank, finrank_euclideanSpace, Fintype.card_fin]; norm_num
  have punct : ∀ (x : E2) (δ : ℝ), 0 < δ →
      IsPreconnected (ball x δ \ {x}) ∧ x ∈ closure (ball x δ \ {x}) := by
    intro x δ hδ
    have hsph := isConnected_sphere hrank (0 : E2) zero_le_one
    have himg : (fun p : E2 × ℝ => x + p.2 • p.1) '' (sphere (0 : E2) 1 ×ˢ Set.Ioo 0 δ) =
        ball x δ \ {x} := by
      ext y
      constructor
      · rintro ⟨⟨v, r⟩, ⟨hv, hr⟩, rfl⟩
        have hv' : ‖v‖ = 1 := mem_sphere_zero_iff_norm.mp hv
        have hr0 : 0 < r := hr.1
        have hrδ : r < δ := hr.2
        show x + r • v ∈ ball x δ \ {x}
        refine ⟨?_, ?_⟩
        · rw [mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, hv', mul_one,
            Real.norm_eq_abs, abs_of_pos hr0]
          exact hrδ
        · intro h
          have h2 : x + r • v = x := h
          have h3 : r • v = 0 := by
            have h4 := congrArg (fun z => z - x) h2
            simpa using h4
          rcases smul_eq_zero.mp h3 with h4 | h4
          · exact absurd h4 hr0.ne'
          · rw [h4, norm_zero] at hv'; exact zero_ne_one hv'
      · rintro ⟨hy, hyx⟩
        have hne : y - x ≠ 0 := sub_ne_zero.mpr hyx
        have hpos : 0 < ‖y - x‖ := norm_pos_iff.mpr hne
        refine ⟨(‖y - x‖⁻¹ • (y - x), ‖y - x‖), ⟨?_, hpos, ?_⟩, ?_⟩
        · rw [mem_sphere_zero_iff_norm]; exact norm_smul_inv_norm hne
        · rw [← dist_eq_norm]; exact hy
        · show x + ‖y - x‖ • (‖y - x‖⁻¹ • (y - x)) = y
          rw [smul_smul, mul_inv_cancel₀ hpos.ne', one_smul, add_sub_cancel]
    refine ⟨?_, ?_⟩
    · rw [← himg]
      exact (hsph.isPreconnected.prod isPreconnected_Ioo).image _
        (by fun_prop : Continuous fun p : E2 × ℝ => x + p.2 • p.1).continuousOn
    · obtain ⟨v, hv⟩ := hsph.nonempty
      have hv' : ‖v‖ = 1 := mem_sphere_zero_iff_norm.mp hv
      rw [Metric.mem_closure_iff]
      intro ε hε
      have hm : 0 < min ε δ / 2 := half_pos (lt_min hε hδ)
      refine ⟨x + (min ε δ / 2) • v, ?_, ?_⟩
      · rw [← himg]
        exact ⟨(v, min ε δ / 2), ⟨hv, hm, by linarith [min_le_right ε δ]⟩, rfl⟩
      · rw [dist_comm, dist_eq_norm, add_sub_cancel_left, norm_smul, hv', mul_one,
          Real.norm_eq_abs, abs_of_pos hm]
        linarith [min_le_left ε δ]
  
  have halfball : ∀ (W : Set E2), IsOpen W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      ∀ x ∈ W, f x = 0 → fderiv ℝ f x ≠ 0 →
      ∃ V : Set E2, IsOpen V ∧ x ∈ V ∧ V ⊆ W ∧ IsPreconnected {y | y ∈ V ∧ 0 < f y} ∧
        x ∈ closure {y | y ∈ V ∧ 0 < f y} := by
    intro W hW f hf x hx hfx hdf
    have hfd : DifferentiableOn ℝ f W := hf.differentiableOn (by simp)
    have hfc : ContinuousOn f W := hfd.continuousOn
    have hdc : ContinuousOn (fderiv ℝ f) W := hf.continuousOn_fderiv_of_isOpen hW (by simp)
    obtain ⟨w, hw⟩ : ∃ w : E2, 0 < fderiv ℝ f x w := by
      by_contra hcon
      push_neg at hcon
      apply hdf
      refine ContinuousLinearMap.ext (fun v => ?_)
      have h1 := hcon v
      have h2 := hcon (-v)
      rw [map_neg] at h2
      rw [ContinuousLinearMap.zero_apply]
      linarith
    have hw0 : w ≠ 0 := by rintro rfl; simp at hw
    have hu1 : ‖‖w‖⁻¹ • w‖ = 1 := norm_smul_inv_norm hw0
    have hu : 0 < fderiv ℝ f x (‖w‖⁻¹ • w) := by
      rw [map_smul, smul_eq_mul]
      exact mul_pos (inv_pos.mpr (norm_pos_iff.mpr hw0)) hw
    generalize ‖w‖⁻¹ • w = u at hu1 hu
    have hcu : ContinuousOn (fun y => fderiv ℝ f y u) W :=
      (ContinuousLinearMap.apply ℝ ℝ u).continuous.comp_continuousOn hdc
    obtain ⟨δ0, hδ0, hball0⟩ :=
      Metric.isOpen_iff.mp (hcu.isOpen_inter_preimage hW isOpen_Ioi) x ⟨hx, hu⟩
    obtain ⟨η, hηdef⟩ : ∃ η : ℝ, η = δ0 / 4 := ⟨_, rfl⟩
    have hη : 0 < η := by rw [hηdef]; positivity
    have hstep : ∀ z : E2, dist z x < δ0 / 2 → ∀ τ : ℝ, |τ| < η →
        z + τ • u ∈ W ∧ 0 < fderiv ℝ f (z + τ • u) u := by
      intro z hz τ hτ
      have hmem : z + τ • u ∈ ball x δ0 := by
        rw [mem_ball]
        calc dist (z + τ • u) x ≤ dist (z + τ • u) z + dist z x := dist_triangle _ _ _
          _ = |τ| + dist z x := by
            rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hu1, mul_one, Real.norm_eq_abs]
          _ < δ0 := by linarith
      exact hball0 hmem
    have hmono : ∀ z : E2, dist z x < δ0 / 2 →
        StrictMonoOn (fun τ : ℝ => f (z + τ • u)) (Set.Ioo (-η) η) := by
      intro z hz
      have hder : ∀ τ ∈ Set.Ioo (-η) η,
          HasDerivAt (fun τ : ℝ => f (z + τ • u)) (fderiv ℝ f (z + τ • u) u) τ := by
        intro τ hτ
        have hτ' : |τ| < η := abs_lt.mpr ⟨hτ.1, hτ.2⟩
        obtain ⟨hW', _⟩ := hstep z hz τ hτ'
        have hcurve : HasDerivAt (fun τ : ℝ => z + τ • u) u τ := by
          simpa using ((hasDerivAt_id' τ).smul_const u).const_add z
        exact ((hfd.differentiableAt (hW.mem_nhds hW')).hasFDerivAt).comp_hasDerivAt τ hcurve
      refine strictMonoOn_of_deriv_pos (convex_Ioo _ _)
        (fun τ hτ => (hder τ hτ).continuousAt.continuousWithinAt) ?_
      intro τ hτ
      rw [interior_Ioo] at hτ
      rw [(hder τ hτ).deriv]
      exact (hstep z hz τ (abs_lt.mpr ⟨hτ.1, hτ.2⟩)).2
    have hxx : dist x x < δ0 / 2 := by rw [dist_self]; exact half_pos hδ0
    have h0I : (0 : ℝ) ∈ Set.Ioo (-η) η := ⟨by linarith, hη⟩
    have hη2 : η / 2 ∈ Set.Ioo (-η) η := ⟨by linarith, by linarith⟩
    have hfm : 0 < f (x + (η / 2) • u) := by
      have h := hmono x hxx h0I hη2 (by linarith)
      change f (x + (0 : ℝ) • u) < f (x + (η / 2) • u) at h
      rw [zero_smul, add_zero, hfx] at h
      exact h
    have hmW : x + (η / 2) • u ∈ W :=
      (hstep x hxx (η / 2) (by rw [abs_of_pos (half_pos hη)]; linarith)).1
    obtain ⟨a1, ha1, hball1⟩ :=
      Metric.isOpen_iff.mp (hfc.isOpen_inter_preimage hW isOpen_Ioi) _ ⟨hmW, hfm⟩
    obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = min a1 (δ0 / 2) := ⟨_, rfl⟩
    have ha : 0 < a := by rw [hadef]; exact lt_min ha1 (half_pos hδ0)
    have ha1' : a ≤ a1 := by rw [hadef]; exact min_le_left _ _
    have ha2 : a ≤ δ0 / 2 := by rw [hadef]; exact min_le_right _ _
    have hmemV : ∀ (y : E2) (s : ℝ), s ∈ Set.Ioo (-η) η → dist y (x + s • u) < a →
        y ∈ ⋃ s ∈ Set.Ioo (-η) η, ball (x + s • u) a :=
      fun y s hs hy => Set.mem_biUnion hs hy
    have hz_of : ∀ (y : E2) (s : ℝ), dist (y - s • u) x = dist y (x + s • u) := by
      intro y s
      rw [dist_eq_norm, dist_eq_norm, sub_sub, add_comm (s • u) x]
    have hVW : (⋃ s ∈ Set.Ioo (-η) η, ball (x + s • u) a) ⊆ W := by
      intro y hy
      obtain ⟨s, hs, hys⟩ := Set.mem_iUnion₂.mp hy
      have hz : dist (y - s • u) x < δ0 / 2 := by
        rw [hz_of]; exact lt_of_lt_of_le (mem_ball.mp hys) ha2
      have h' := (hstep (y - s • u) hz s (abs_lt.mpr ⟨hs.1, hs.2⟩)).1
      rwa [sub_add_cancel] at h'
    refine ⟨⋃ s ∈ Set.Ioo (-η) η, ball (x + s • u) a, isOpen_biUnion (fun _ _ => isOpen_ball),
      hmemV x 0 h0I (by simp [ha]), hVW, ?_, ?_⟩
    · refine isPreconnected_of_forall (x + (η / 2) • u) ?_
      rintro y ⟨hyV, hy⟩
      obtain ⟨s, hs, hys⟩ := Set.mem_iUnion₂.mp hyV
      have hzx : dist (y - s • u) x < a := by rw [hz_of]; exact mem_ball.mp hys
      have hzx2 : dist (y - s • u) x < δ0 / 2 := lt_of_lt_of_le hzx ha2
      have hyz : y - s • u + s • u = y := sub_add_cancel y (s • u)
      have hs' : s ∈ Set.Ioo (-η) η := hs
      have hball_sub : ball (x + (η / 2) • u) a ⊆
          {y | y ∈ ⋃ s ∈ Set.Ioo (-η) η, ball (x + s • u) a ∧ 0 < f y} := by
        intro p hp
        refine ⟨hmemV p (η / 2) hη2 hp, ?_⟩
        exact (hball1 (ball_subset_ball ha1' hp)).2
      have hzm : y - s • u + (η / 2) • u ∈ ball (x + (η / 2) • u) a := by
        rw [mem_ball, dist_add_right]; exact hzx
      have hzmpos : 0 < f (y - s • u + (η / 2) • u) := (hball_sub hzm).2
      refine ⟨(fun τ : ℝ => y - s • u + τ • u) '' Set.uIcc s (η / 2) ∪
          ball (x + (η / 2) • u) a, ?_, Set.mem_union_right _ (mem_ball_self ha),
          Set.mem_union_left _ ⟨s, Set.left_mem_uIcc, hyz⟩, ?_⟩
      · rintro p (⟨τ, hτ, rfl⟩ | hp)
        · show y - s • u + τ • u ∈
            {y | y ∈ ⋃ s ∈ Set.Ioo (-η) η, ball (x + s • u) a ∧ 0 < f y}
          have hτI : τ ∈ Set.Ioo (-η) η := by
            have h1 := Set.mem_uIcc.mp hτ
            constructor <;> rcases h1 with h | h <;> linarith [hs'.1, hs'.2]
          refine ⟨hmemV _ τ hτI (by rw [dist_add_right]; exact hzx), ?_⟩
          rcases Set.mem_uIcc.mp hτ with h | h
          · rcases h.1.lt_or_eq with hlt | heq
            · have h2 := hmono (y - s • u) hzx2 hs' hτI hlt
              change f (y - s • u + s • u) < f (y - s • u + τ • u) at h2
              rw [hyz] at h2
              linarith
            · rw [← heq, hyz]; exact hy
          · rcases h.1.lt_or_eq with hlt | heq
            · have h2 := hmono (y - s • u) hzx2 hη2 hτI hlt
              change f (y - s • u + (η / 2) • u) < f (y - s • u + τ • u) at h2
              linarith
            · rw [← heq]; exact hzmpos
        · exact hball_sub hp
      · exact (isPreconnected_uIcc.image _
          (by fun_prop : Continuous fun τ : ℝ => y - s • u + τ • u).continuousOn).union
          (y - s • u + (η / 2) • u) ⟨η / 2, Set.right_mem_uIcc, rfl⟩ hzm
          (convex_ball _ _).isPreconnected
    · rw [Metric.mem_closure_iff]
      intro ε hε
      obtain ⟨σ, hσdef⟩ : ∃ σ : ℝ, σ = min (η / 2) (ε / 2) := ⟨_, rfl⟩
      have hσ : 0 < σ := by rw [hσdef]; exact lt_min (by linarith) (by linarith)
      have hσ1 : σ ≤ η / 2 := by rw [hσdef]; exact min_le_left _ _
      have hσ2 : σ ≤ ε / 2 := by rw [hσdef]; exact min_le_right _ _
      have hσI : σ ∈ Set.Ioo (-η) η := ⟨by linarith, by linarith⟩
      refine ⟨x + σ • u, ⟨hmemV _ σ hσI (by simp [ha]), ?_⟩, ?_⟩
      · have h := hmono x hxx h0I hσI hσ
        change f (x + (0 : ℝ) • u) < f (x + σ • u) at h
        rw [zero_smul, add_zero, hfx] at h
        exact h
      · rw [dist_comm, dist_eq_norm, add_sub_cancel_left, norm_smul, hu1, mul_one,
          Real.norm_eq_abs, abs_of_pos hσ]
        linarith
  
  have key : ∀ q ∈ {q | q ∈ S ∧ 0 ≤ b q}, q ∈ closure ({q | q ∈ S ∧ 0 < b q} \ {p₀}) ∧
      ∃ N : Set X, IsOpen N ∧ q ∈ N ∧ IsPreconnected (N ∩ ({q | q ∈ S ∧ 0 < b q} \ {p₀})) := by
    rintro q ⟨hqS, hqb⟩
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (P.cover hqS)
    have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq j]; exact ⟨hj, hqS⟩
    obtain ⟨x, hx, rfl⟩ := hq'
    have hfc : ContinuousOn (fun y => b (P.param j y)) (P.W j) := (hb j).continuousOn
    have hinj : ∀ y ∈ P.W j, P.param j y = P.param j x → y = x := by
      intro y hy h
      rw [← P.proj_param j y hy, ← P.proj_param j x hx, h]
    have hWo : IsOpen (P.W j ∩ P.param j ⁻¹' {p₀}ᶜ) :=
      (P.param_cont j).isOpen_inter_preimage (P.W_open j) isOpen_compl_singleton
    rcases hqb.lt_or_eq with hpos | hzero
    · by_cases hp : P.param j x = p₀
      · obtain ⟨δ, hδ, hδb⟩ := Metric.isOpen_iff.mp
          (hfc.isOpen_inter_preimage (P.W_open j) isOpen_Ioi) x ⟨hx, hpos⟩
        have hDeq : {y | y ∈ ball x δ ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} =
            ball x δ \ {x} := by
          ext y
          constructor
          · rintro ⟨hy, -, hyp⟩
            refine ⟨hy, fun h => hyp ?_⟩
            rw [Set.mem_singleton_iff.mp h, hp]
          · rintro ⟨hy, hyx⟩
            refine ⟨hy, (hδb hy).2, fun h => hyx ?_⟩
            exact Set.mem_singleton_iff.mpr (hinj y (hδb hy).1 (h.trans hp.symm))
        obtain ⟨h1, h2⟩ := punct x δ hδ
        exact transfer j x (ball x δ) isOpen_ball (fun y hy => (hδb hy).1) (mem_ball_self hδ)
          (by rw [hDeq]; exact h1) (by rw [hDeq]; exact h2)
      · obtain ⟨δ, hδ, hδb⟩ := Metric.isOpen_iff.mp
          ((hfc.mono Set.inter_subset_left).isOpen_inter_preimage hWo isOpen_Ioi) x
          ⟨⟨hx, hp⟩, hpos⟩
        have hDeq : {y | y ∈ ball x δ ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} =
            ball x δ := by
          ext y
          exact ⟨fun h => h.1, fun hy => ⟨hy, (hδb hy).2, (hδb hy).1.2⟩⟩
        exact transfer j x (ball x δ) isOpen_ball (fun y hy => (hδb hy).1.1) (mem_ball_self hδ)
          (by rw [hDeq]; exact (convex_ball x δ).isPreconnected)
          (by rw [hDeq]; exact subset_closure (mem_ball_self hδ))
    · have hb0 : b (P.param j x) = 0 := hzero.symm
      have hp : P.param j x ≠ p₀ := by
        intro h; rw [h] at hb0; linarith
      obtain ⟨V, hVo, hxV, hVW, hD, hcl⟩ := halfball _ hWo _ ((hb j).mono Set.inter_subset_left)
        x ⟨hx, hp⟩ hb0 (hreg j x hx hb0)
      have hDeq : {y | y ∈ V ∧ 0 < b (P.param j y) ∧ P.param j y ≠ p₀} =
          {y | y ∈ V ∧ 0 < b (P.param j y)} := by
        ext y
        exact ⟨fun h => ⟨h.1, h.2.1⟩, fun h => ⟨h.1, h.2, (hVW h.1).2⟩⟩
      exact transfer j x V hVo (fun y hy => (hVW hy).1) hxV (by rw [hDeq]; exact hD)
        (by rw [hDeq]; exact hcl)
  refine glue {q | q ∈ S ∧ 0 ≤ b q} _ ?_ hRconn.isPreconnected
    (fun q hq => (key q hq).1) (fun q hq => (key q hq).2)
  rintro q ⟨⟨hqS, hqb⟩, -⟩
  exact ⟨hqS, hqb.le⟩

theorem pcgb_green_negative {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ)
    (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (p₀ : X) (U : Set X) (hU : IsOpen U) (hRU : {q | q ∈ S ∧ 0 ≤ b q} ⊆ U) (w : X → ℝ)
    (hw1 : ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})))
    (hw2 : ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ p₀ →
      lap2 (P.h j) (fun y => w (P.param j y)) x = 0)
    (hw3 : ∀ q ∈ S, b q = 0 → w q = 0)
    (hw4 : ∃ N : Set X, IsOpen N ∧ p₀ ∈ N ∧ (∀ q ∈ N ∩ S, q ≠ p₀ → w q < -1) ∧
      ∃ q ∈ N ∩ S, 0 < b q ∧ q ≠ p₀)
    (hw5 : IsPreconnected ({q | q ∈ S ∧ 0 < b q} \ {p₀})) :
    ∀ q ∈ S, 0 < b q → q ≠ p₀ → w q < 0 :=
by
  
  have hP1 : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ S := by
    intro j x hx
    have hmem : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
    rw [P.image_eq j] at hmem
    exact hmem.2
  
  have hP2 : ∀ j, ∀ q ∈ P.O j, q ∈ S → P.proj j q ∈ P.W j ∧ P.param j (P.proj j q) = q := by
    intro j q hqO hqS
    have hmem : q ∈ P.param j '' P.W j := by
      rw [P.image_eq j]
      exact ⟨hqO, hqS⟩
    obtain ⟨x, hx, rfl⟩ := hmem
    rw [P.proj_param j x hx]
    exact ⟨hx, rfl⟩
  have hVo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (hU.sdiff isClosed_singleton)
  have hwc : ∀ j, ContinuousOn (fun x => w (P.param j x)) (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) :=
    fun j => (hw1 j).continuousOn
  have hAV : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) →
      x ∈ P.W j ∩ P.param j ⁻¹' (U \ {p₀}) := by
    intro j x hx hA
    exact ⟨hx, hRU ⟨hA.1.1, hA.1.2.le⟩, hA.2⟩
  
  have hloc : ∀ c : ℝ, (∀ q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q ≤ c) →
      ∀ j, ∀ x ∈ P.W j, P.param j x ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) →
        w (P.param j x) = c → ∀ᶠ y in 𝓝 x, w (P.param j y) = c := by
    intro c hle j x₀ hx₀ hA₀ hc₀
    have hΩo : IsOpen ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩
        (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) :=
      ((hb j).continuousOn.mono Set.inter_subset_left).isOpen_inter_preimage (hVo j) isOpen_Ioi
    obtain ⟨Ω, hΩdef⟩ : ∃ Ω : Set E2, Ω = (P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩
        (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0 := ⟨_, rfl⟩
    rw [← hΩdef] at hΩo
    have hΩW : Ω ⊆ P.W j := by
      intro y hy
      rw [hΩdef] at hy
      exact hy.1.1
    have hΩV : Ω ⊆ P.W j ∩ P.param j ⁻¹' (U \ {p₀}) := by
      intro y hy
      rw [hΩdef] at hy
      exact hy.1
    have hΩA : ∀ y ∈ Ω, P.param j y ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) := by
      intro y hy
      rw [hΩdef] at hy
      exact ⟨⟨hP1 j y hy.1.1, hy.2⟩, hy.1.2.2⟩
    have hx₀Ω : x₀ ∈ Ω := by
      rw [hΩdef]
      exact ⟨hAV j x₀ hx₀ hA₀, hA₀.1.2⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : E2 → ℝ, φ = fun y => c - w (P.param j y) := ⟨_, rfl⟩
    have hφx : ∀ y, φ y = c - w (P.param j y) := fun y => by rw [hφ]
    have hφs : ContDiffOn ℝ ∞ φ Ω := by
      rw [hφ]
      exact contDiffOn_const.sub ((hw1 j).mono hΩV)
    have hnn : ∀ y ∈ Ω, 0 ≤ φ y := by
      intro y hy
      have := hle _ (hΩA y hy)
      rw [hφx]
      linarith
    have hd1 : ∀ k : Fin 2, ∀ y, pd2 k φ y = -(pd2 k (fun y => w (P.param j y)) y) := by
      intro k y
      show fderiv ℝ φ y (e2 k) = -(fderiv ℝ (fun y => w (P.param j y)) y (e2 k))
      rw [hφ, fderiv_const_sub, ContinuousLinearMap.neg_apply]
    have hd1f : ∀ k : Fin 2, pd2 k φ = fun y => -(pd2 k (fun y => w (P.param j y)) y) := by
      intro k
      funext y
      exact hd1 k y
    have hd2 : ∀ i k : Fin 2, ∀ y,
        pd2 i (pd2 k φ) y = -(pd2 i (pd2 k (fun y => w (P.param j y))) y) := by
      intro i k y
      rw [hd1f k]
      show fderiv ℝ (fun y => -(pd2 k (fun y => w (P.param j y)) y)) y (e2 i) =
        -(fderiv ℝ (pd2 k (fun y => w (P.param j y))) y (e2 i))
      rw [fderiv_fun_neg, ContinuousLinearMap.neg_apply]
    obtain ⟨A, B, hA, hB, hAs, hApos, hid⟩ := esm_lap2_coeff_form Ω hΩo (P.h j)
      (fun a b => (P.h_smooth j a b).mono hΩW) (fun y hy => P.h_posDef j y (hΩW hy))
    have heq : ∀ y ∈ Ω, ∑ i : Fin 2, ∑ k : Fin 2, A y i k * pd2 i (pd2 k φ) y
        + ∑ k : Fin 2, B y k * pd2 k φ y + (fun _ => (0 : ℝ)) y * φ y = 0 := by
      intro y hy
      have hyA := hΩA y hy
      have h1 := hw2 j y (hΩW hy) hyA.1.2 hyA.2
      rw [hid] at h1
      simp only [Fin.sum_univ_two] at h1 ⊢
      rw [hd2 0 0, hd2 0 1, hd2 1 0, hd2 1 1, hd1 0, hd1 1]
      linear_combination -h1
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hΩo x₀ hx₀Ω
    have hρ : 0 < ε / 3 := by positivity
    have hcb : Metric.closedBall x₀ (2 * (ε / 3)) ⊆ Ω :=
      (Metric.closedBall_subset_ball (by linarith)).trans hball
    have hφ0 : φ x₀ = 0 := by
      rw [hφx, hc₀]
      ring
    refine Filter.eventually_of_mem (Metric.ball_mem_nhds x₀ hρ) ?_
    intro z hz
    by_contra hwz
    have hwz' : φ z ≠ 0 := by
      rw [hφx]
      intro h
      apply hwz
      linarith
    have hDc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3))) := isCompact_closedBall _ _
    have hZcl : IsClosed (Metric.closedBall x₀ (2 * (ε / 3)) ∩ φ ⁻¹' {0}) :=
      (hφs.continuousOn.mono hcb).preimage_isClosed_of_isClosed Metric.isClosed_closedBall
        isClosed_singleton
    have hZc : IsCompact (Metric.closedBall x₀ (2 * (ε / 3)) ∩ φ ⁻¹' {0}) :=
      hDc.of_isClosed_subset hZcl Set.inter_subset_left
    have hx₀Z : x₀ ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩ φ ⁻¹' {0} :=
      ⟨Metric.mem_closedBall_self (by linarith), hφ0⟩
    obtain ⟨x₁, hx₁Z, hmin⟩ := hZc.exists_isMinOn ⟨x₀, hx₀Z⟩
      (continuous_id.dist continuous_const).continuousOn
    have hmin' := isMinOn_iff.1 hmin
    have hRle : dist x₁ z ≤ dist x₀ z := hmin' x₀ hx₀Z
    have hz' : dist z x₀ < ε / 3 := hz
    have hR : 0 < dist x₁ z := by
      rcases (dist_nonneg (x := x₁) (y := z)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hx1z : x₁ = z := dist_eq_zero.1 h.symm
        apply hwz'
        rw [← hx1z]
        exact hx₁Z.2
    have hsub : Metric.closedBall z (dist x₁ z) ⊆ Metric.closedBall x₀ (2 * (ε / 3)) := by
      intro x hx
      rw [Metric.mem_closedBall] at hx ⊢
      have h1 := dist_triangle x z x₀
      rw [dist_comm x₀ z] at hRle
      linarith
    have hpos : ∀ x ∈ Metric.ball z (dist x₁ z), 0 < φ x := by
      intro x hx
      have hxD : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) := hsub (Metric.ball_subset_closedBall hx)
      rcases (hnn x (hcb hxD)).lt_or_eq with h | h
      · exact h
      · exfalso
        have hxZ : x ∈ Metric.closedBall x₀ (2 * (ε / 3)) ∩ φ ⁻¹' {0} := ⟨hxD, h.symm⟩
        have h2 : dist x₁ z ≤ dist x z := hmin' x hxZ
        rw [Metric.mem_ball] at hx
        linarith
    exact esm_hopf_touching Ω hΩo A B φ (fun _ => (0 : ℝ)) hA hB hAs hApos hφs
      continuousOn_const hnn heq z x₁ (dist x₁ z) hR (hsub.trans hcb) hpos rfl hx₁Z.2
  
  have hprop : ∀ c : ℝ, (∀ q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q ≤ c) →
      ∀ q₀ ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q₀ = c →
      ∀ q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q = c := by
    intro c hle q₀ hq₀ hq₀c
    have hASub : ({q | q ∈ S ∧ 0 < b q} \ {p₀}) ⊆ S := fun q hq => hq.1.1
    have hA'o : ∀ j, IsOpen ({x | ∀ᶠ y in 𝓝 x, w (P.param j y) = c} ∩ P.W j) :=
      fun j => isOpen_setOf_eventually_nhds.inter (P.W_open j)
    have hB'o : ∀ j, IsOpen ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩
        (fun x => w (P.param j x)) ⁻¹' {c}ᶜ) :=
      fun j => (hwc j).isOpen_inter_preimage (hVo j) isOpen_compl_singleton
    have hU₁o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, w (P.param j y) = c} ∩ P.W j))) :=
      isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hA'o j)
    have hU₂o : IsOpen (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩ (fun x => w (P.param j x)) ⁻¹' {c}ᶜ))) :=
      isOpen_iUnion fun j => (P.proj_cont j).isOpen_inter_preimage (P.O_open j) (hB'o j)
    have hcov : ({q | q ∈ S ∧ 0 < b q} \ {p₀}) ⊆ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, w (P.param j y) = c} ∩ P.W j))) ∪
        (⋃ j, (P.O j ∩ P.proj j ⁻¹'
          ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩ (fun x => w (P.param j x)) ⁻¹' {c}ᶜ))) := by
      intro r hr
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover (hASub hr))
      obtain ⟨hxW, hxr⟩ := hP2 j r hj (hASub hr)
      have hrA : P.param j (P.proj j r) ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) := by
        rw [hxr]
        exact hr
      by_cases hrc : w r = c
      · left
        refine Set.mem_iUnion.2 ⟨j, hj, ?_, hxW⟩
        exact hloc c hle j _ hxW hrA (by rw [hxr]; exact hrc)
      · right
        refine Set.mem_iUnion.2 ⟨j, hj, hAV j _ hxW hrA, ?_⟩
        show w (P.param j (P.proj j r)) ∈ ({c}ᶜ : Set ℝ)
        rw [hxr]
        exact hrc
    have hU₁z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, w (P.param j y) = c} ∩ P.W j))) → w r = c := by
      intro r hrS hr1
      obtain ⟨j, hj, hA, -⟩ := Set.mem_iUnion.1 hr1
      have hA' : ∀ᶠ y in 𝓝 (P.proj j r), w (P.param j y) = c := hA
      have h1 := hA'.self_of_nhds
      rwa [(hP2 j r hj hrS).2] at h1
    have hU₂z : ∀ r ∈ S, r ∈ (⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩ (fun x => w (P.param j x)) ⁻¹' {c}ᶜ))) →
        w r ≠ c := by
      intro r hrS hr2
      obtain ⟨j, hj, -, hB⟩ := Set.mem_iUnion.1 hr2
      have h1 : w (P.param j (P.proj j r)) ≠ c := hB
      rwa [(hP2 j r hj hrS).2] at h1
    have hdisj : ({q | q ∈ S ∧ 0 < b q} \ {p₀}) ∩ ((⋃ j, (P.O j ∩ P.proj j ⁻¹'
        ({x | ∀ᶠ y in 𝓝 x, w (P.param j y) = c} ∩ P.W j))) ∩
        (⋃ j, (P.O j ∩ P.proj j ⁻¹'
          ((P.W j ∩ P.param j ⁻¹' (U \ {p₀})) ∩ (fun x => w (P.param j x)) ⁻¹' {c}ᶜ)))) = ∅ := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false]
      rintro ⟨hxA, hx1, hx2⟩
      exact hU₂z x (hASub hxA) hx2 (hU₁z x (hASub hxA) hx1)
    rcases (isPreconnected_iff_subset_of_disjoint.1 hw5) _ _ hU₁o hU₂o hcov hdisj with h | h
    · intro q hq
      exact hU₁z q (hASub hq) (h hq)
    · exact absurd hq₀c (hU₂z q₀ (hASub hq₀) (h hq₀))
  
  obtain ⟨N, hNo, hp₀N, hNneg, qN, ⟨hqNN, hqNS⟩, hbqN, hqNp⟩ := hw4
  have hqNA : qN ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) := ⟨⟨hqNS, hbqN⟩, hqNp⟩
  have hqNneg : w qN < -1 := hNneg qN ⟨hqNN, hqNS⟩ hqNp
  
  have hle0 : ∀ q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q ≤ 0 := by
    intro q₁ hq₁A
    by_contra hq₁pos'
    have hq₁pos : 0 < w q₁ := lt_of_not_ge hq₁pos'
    have hKc : IsCompact ({q | q ∈ S ∧ 0 ≤ b q} \ N) := hRc.diff hNo
    have hq₁N : q₁ ∉ N := by
      intro h
      have := hNneg q₁ ⟨h, hq₁A.1.1⟩ hq₁A.2
      linarith
    have hq₁K : q₁ ∈ ({q | q ∈ S ∧ 0 ≤ b q} \ N) := ⟨⟨hq₁A.1.1, hq₁A.1.2.le⟩, hq₁N⟩
    have hcontK : ContinuousOn w ({q | q ∈ S ∧ 0 ≤ b q} \ N) := by
      intro q hq
      have hqS : q ∈ S := hq.1.1
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (P.cover hqS)
      obtain ⟨hxW, hxq⟩ := hP2 j q hj hqS
      have hqp : q ≠ p₀ := by
        intro h
        apply hq.2
        rw [h]
        exact hp₀N
      have hxV : P.proj j q ∈ P.W j ∩ P.param j ⁻¹' (U \ {p₀}) := by
        refine ⟨hxW, ?_⟩
        rw [Set.mem_preimage, hxq]
        exact ⟨hRU hq.1, hqp⟩
      have hg : ContinuousAt (fun x => w (P.param j x)) (P.proj j q) :=
        (hwc j).continuousAt ((hVo j).mem_nhds hxV)
      have hpr : ContinuousAt (P.proj j) q :=
        (P.proj_cont j).continuousAt ((P.O_open j).mem_nhds hj)
      have hcomp : ContinuousAt ((fun x => w (P.param j x)) ∘ P.proj j) q := hg.comp hpr
      refine hcomp.continuousWithinAt.congr_of_eventuallyEq ?_ ?_
      · refine Filter.eventually_of_mem (inter_mem_nhdsWithin _ ((P.O_open j).mem_nhds hj)) ?_
        intro r hr
        have hrS : r ∈ S := hr.1.1.1
        show w r = w (P.param j (P.proj j r))
        rw [(hP2 j r hr.2 hrS).2]
      · show w q = w (P.param j (P.proj j q))
        rw [hxq]
    obtain ⟨qs, hqsK, hmax⟩ := hKc.exists_isMaxOn ⟨q₁, hq₁K⟩ hcontK
    have hmax' := isMaxOn_iff.1 hmax
    have hMpos : 0 < w qs := lt_of_lt_of_le hq₁pos (hmax' q₁ hq₁K)
    have hqsA : qs ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) := by
      refine ⟨⟨hqsK.1.1, ?_⟩, ?_⟩
      · rcases hqsK.1.2.lt_or_eq with h | h
        · exact h
        · exfalso
          have := hw3 qs hqsK.1.1 h.symm
          linarith
      · intro h
        apply hqsK.2
        rw [Set.mem_singleton_iff.1 h]
        exact hp₀N
    have hleM : ∀ q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}), w q ≤ w qs := by
      intro q hq
      by_cases hqN : q ∈ N
      · have := hNneg q ⟨hqN, hq.1.1⟩ hq.2
        linarith
      · exact hmax' q ⟨⟨hq.1.1, hq.1.2.le⟩, hqN⟩
    have := hprop (w qs) hleM qs hqsA rfl qN hqNA
    linarith
  
  intro q hqS hbq hqp
  have hqA : q ∈ ({q | q ∈ S ∧ 0 < b q} \ {p₀}) := ⟨⟨hqS, hbq⟩, hqp⟩
  rcases (hle0 q hqA).lt_or_eq with h | h
  · exact h
  · exfalso
    have := hprop 0 hle0 q hqA h qN hqNA
    linarith

theorem pcgb_hopf_boundary (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (b w : E2 → ℝ)
    (hb : ContDiffOn ℝ ∞ b W) (hw : ContDiffOn ℝ ∞ w W) (x₁ : E2) (hx₁ : x₁ ∈ W)
    (hb0 : b x₁ = 0) (hdb : fderiv ℝ b x₁ ≠ 0) (hw0 : w x₁ = 0)
    (hneg : ∀ y ∈ W, 0 < b y → w y < 0)
    (hharm : ∀ y ∈ W, 0 < b y → lap2 h w y = 0) :
    fderiv ℝ w x₁ ≠ 0 :=
by
  
  obtain ⟨z, R, hR, hball, hx₁z, hbpos⟩ : ∃ (z : E2) (R : ℝ), 0 < R ∧
      Metric.closedBall z R ⊆ W ∧ dist x₁ z = R ∧ ∀ y ∈ Metric.ball z R, 0 < b y := by
    obtain ⟨ε, hε, hεW⟩ := Metric.isOpen_iff.mp hW x₁ hx₁
    obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = ε / 2 := ⟨_, rfl⟩
    have hρ0 : 0 < ρ := by rw [hρ]; positivity
    have hcbW : Metric.closedBall x₁ ρ ⊆ W := fun y hy =>
      hεW (Metric.closedBall_subset_ball (by rw [hρ]; linarith) hy)
    have hdb1 : ContDiffOn ℝ ∞ (fderiv ℝ b) W := hb.fderiv_of_isOpen hW (by simp)
    have hdb2 := hdb1.continuousOn_fderiv_of_isOpen hW (by simp)
    obtain ⟨M', hM'⟩ :=
      (isCompact_closedBall x₁ ρ).exists_bound_of_continuousOn (hdb2.mono hcbW)
    obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = max M' 0 := ⟨_, rfl⟩
    have hM0 : 0 ≤ M := by rw [hMdef]; exact le_max_right _ _
    have hMb : ∀ p ∈ Metric.closedBall x₁ ρ, ‖fderiv ℝ (fderiv ℝ b) p‖ ≤ M := fun p hp =>
      (hM' p hp).trans (by rw [hMdef]; exact le_max_left _ _)
    have hbd : ∀ p ∈ W, DifferentiableAt ℝ b p := fun p hp =>
      (hb.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hp)
    have hdbd : ∀ p ∈ W, DifferentiableAt ℝ (fderiv ℝ b) p := fun p hp =>
      (hdb1.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hp)
    obtain ⟨D, hD⟩ : ∃ D : E2 →L[ℝ] ℝ, D = fderiv ℝ b x₁ := ⟨_, rfl⟩
    
    have htay : ∀ y ∈ Metric.closedBall x₁ ρ, D (y - x₁) - M * ‖y - x₁‖ ^ 2 ≤ b y := by
      intro y hy
      obtain ⟨r, hr⟩ : ∃ r : ℝ, r = ‖y - x₁‖ := ⟨_, rfl⟩
      have hrρ : r ≤ ρ := by rw [hr, ← dist_eq_norm]; exact hy
      have hsub : Metric.closedBall x₁ r ⊆ Metric.closedBall x₁ ρ :=
        Metric.closedBall_subset_closedBall hrρ
      have hr0 : 0 ≤ r := by rw [hr]; exact norm_nonneg _
      have hx₁s : x₁ ∈ Metric.closedBall x₁ r := Metric.mem_closedBall_self hr0
      have hys : y ∈ Metric.closedBall x₁ r := by
        rw [Metric.mem_closedBall, dist_eq_norm, hr]
      have h1 : ∀ p ∈ Metric.closedBall x₁ r, ‖fderiv ℝ b p - D‖ ≤ M * r := by
        intro p hp
        have h0 := Convex.norm_image_sub_le_of_norm_fderiv_le (f := fderiv ℝ b) (C := M)
          (s := Metric.closedBall x₁ r) (fun q hq => hdbd q (hcbW (hsub hq)))
          (fun q hq => hMb q (hsub hq)) (convex_closedBall x₁ r) hx₁s hp
        rw [← hD] at h0
        calc ‖fderiv ℝ b p - D‖ ≤ M * ‖p - x₁‖ := h0
          _ ≤ M * r := mul_le_mul_of_nonneg_left (by rw [← dist_eq_norm]; exact hp) hM0
      have hφd : ∀ p ∈ W, HasFDerivAt (fun q => b q - D (q - x₁)) (fderiv ℝ b p - D) p := by
        intro p hp
        have h2 : HasFDerivAt (fun q => D (q - x₁)) D p := by
          have hD' : HasFDerivAt (⇑D) D p := D.hasFDerivAt
          refine (hD'.sub_const (D x₁)).congr_of_eventuallyEq
            (Filter.Eventually.of_forall fun q => ?_)
          show D (q - x₁) = D q - D x₁
          exact map_sub D q x₁
        exact (hbd p hp).hasFDerivAt.sub h2
      have h3 := Convex.norm_image_sub_le_of_norm_fderiv_le
        (f := fun q => b q - D (q - x₁)) (C := M * r) (s := Metric.closedBall x₁ r)
        (fun q hq => (hφd q (hcbW (hsub hq))).differentiableAt)
        (fun q hq => by rw [(hφd q (hcbW (hsub hq))).fderiv]; exact h1 q hq)
        (convex_closedBall x₁ r) hx₁s hys
      simp only [sub_self, map_zero, hb0, sub_zero, Real.norm_eq_abs] at h3
      rw [← hr] at h3
      have h4 := neg_abs_le (b y - D (y - x₁))
      rw [← hr]
      have h5 : M * r * r = M * r ^ 2 := by ring
      linarith
    
    obtain ⟨ν, hν⟩ : ∃ ν : E2, ν = (InnerProductSpace.toDual ℝ E2).symm D := ⟨_, rfl⟩
    have hνD : ∀ p : E2, inner ℝ ν p = D p := by
      intro p
      rw [hν]
      exact InnerProductSpace.toDual_symm_apply
    obtain ⟨g, hg⟩ : ∃ g : ℝ, g = ‖ν‖ := ⟨_, rfl⟩
    have hg0 : 0 < g := by
      rw [hg, norm_pos_iff]
      intro h0
      apply hdb
      rw [← hD]
      ext p
      rw [ContinuousLinearMap.zero_apply, ← hνD p, h0, inner_zero_left]
    obtain ⟨n, hn⟩ : ∃ n : E2, n = g⁻¹ • ν := ⟨_, rfl⟩
    have hn1 : ‖n‖ = 1 := by
      rw [hn, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hg0, ← hg,
        inv_mul_cancel₀ hg0.ne']
    have hDn : ∀ p : E2, D p = g * inner ℝ n p := by
      intro p
      rw [hn, real_inner_smul_left, ← mul_assoc, mul_inv_cancel₀ hg0.ne', one_mul, hνD p]
    have hnn : inner ℝ n n = (1 : ℝ) := by
      rw [real_inner_self_eq_norm_sq, hn1]; norm_num
    obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = min (ρ / 2) (g / (4 * M + 1)) := ⟨_, rfl⟩
    have hR0 : 0 < R := by
      rw [hRdef]
      exact lt_min (by positivity) (div_pos hg0 (by linarith))
    have hRρ : R ≤ ρ / 2 := by rw [hRdef]; exact min_le_left _ _
    have hRg : R * (4 * M + 1) ≤ g := by
      have : R ≤ g / (4 * M + 1) := by rw [hRdef]; exact min_le_right _ _
      exact (le_div_iff₀ (by linarith)).mp this
    obtain ⟨z, hz⟩ : ∃ z : E2, z = x₁ + R • n := ⟨_, rfl⟩
    have hRn : ‖R • n‖ = R := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hR0, hn1, mul_one]
    refine ⟨z, R, hR0, ?_, ?_, ?_⟩
    · intro y hy
      apply hcbW
      rw [Metric.mem_closedBall] at hy ⊢
      have hzx : dist z x₁ = R := by
        rw [dist_eq_norm, hz, add_sub_cancel_left, hRn]
      have := dist_triangle y z x₁
      linarith
    · rw [dist_eq_norm, hz, sub_add_cancel_left, norm_neg, hRn]
    · intro y hy
      have hu : ‖y - z‖ < R := by rw [← dist_eq_norm]; exact Metric.mem_ball.mp hy
      have hd : y - x₁ = R • n + (y - z) := by rw [hz]; abel
      obtain ⟨s₀, hs₀⟩ : ∃ s₀ : ℝ, s₀ = R + inner ℝ n (y - z) := ⟨_, rfl⟩
      have hip : |inner ℝ n (y - z)| ≤ ‖y - z‖ := by
        have := abs_real_inner_le_norm n (y - z)
        rw [hn1, one_mul] at this
        exact this
      have hs0 : 0 < s₀ := by
        rw [hs₀]
        have := neg_abs_le (inner ℝ n (y - z))
        linarith
      have hDd : D (y - x₁) = g * s₀ := by
        rw [hDn, hd, inner_add_right, real_inner_smul_right, hnn, hs₀, mul_one]
      have hdsq : ‖y - x₁‖ ^ 2 ≤ 2 * R * s₀ := by
        rw [hd, norm_add_sq_real, hRn, real_inner_smul_left, hs₀]
        have hu0 := norm_nonneg (y - z)
        nlinarith
      have hdρ : y ∈ Metric.closedBall x₁ ρ := by
        rw [Metric.mem_closedBall, dist_eq_norm, hd]
        have := norm_add_le (R • n) (y - z)
        rw [hRn] at this
        linarith
      have ht := htay y hdρ
      rw [hDd] at ht
      have e1 := mul_le_mul_of_nonneg_right hRg hs0.le
      have e2 := mul_le_mul_of_nonneg_left hdsq hM0
      have e3 := mul_pos (mul_pos hR0 (by linarith : (0 : ℝ) < 2 * M + 1)) hs0
      nlinarith
  have hbW : Metric.ball z R ⊆ W := Metric.ball_subset_closedBall.trans hball
  have hx₁W : x₁ ∈ W := hx₁
  
  obtain ⟨A, B, hA, hB, hAs, hApos, hL⟩ := esm_lap2_coeff_form W hW h hh hpd
  have hH0 : ∀ x ∈ Metric.ball z R, ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j w) x
      + ∑ k : Fin 2, B x k * pd2 k w x = 0 := by
    intro x hx
    rw [← hL w x]
    exact hharm x (hbW hx) (hbpos x hx)
  
  obtain ⟨m₀, Λ, β, Γ, m, hm₀, hΛ, hβ, hΓ, hm, hK, hSin⟩ :=
    esm_hopf_constants W A B (fun x => -w x) (fun _ => 0) hA hB hApos hw.continuousOn.neg
      continuousOn_const z R hR hball (fun x hx => by
        show 0 < -w x
        linarith [hneg x (hbW hx) (hbpos x hx)])
  obtain ⟨α, hα⟩ : ∃ α : ℝ, α = 1 + (4 * Λ + 4 * β * R) / (4 * m₀) := ⟨_, rfl⟩
  have hα1 : 1 ≤ α := by
    have : 0 ≤ (4 * Λ + 4 * β * R) / (4 * m₀) := by positivity
    linarith
  have hα0 : 0 < α := by linarith
  
  have hbar : ∀ (a : Matrix (Fin 2) (Fin 2) ℝ) (bb : Fin 2 → ℝ) (y : E2),
      m₀ ≤ ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j → (∀ i : Fin 2, |a i i| ≤ Λ) →
      (∀ k : Fin 2, |bb k| ≤ β) → ‖y‖ ≤ R →
      0 < ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, bb k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2)) := by
    intro a bb y hq ha hbb hy
    have hE := Real.exp_pos (-α * ‖y‖ ^ 2)
    have hy0 : |y 0| ≤ R := by
      have := PiLp.norm_apply_le y 0
      rw [Real.norm_eq_abs] at this
      linarith
    have hy1 : |y 1| ≤ R := by
      have := PiLp.norm_apply_le y 1
      rw [Real.norm_eq_abs] at this
      linarith
    have htr : a 0 0 + a 1 1 ≤ 2 * Λ := by
      have h0 := le_abs_self (a 0 0)
      have h1 := le_abs_self (a 1 1)
      linarith [ha 0, ha 1]
    have hbb0 : bb 0 * y 0 ≤ β * R := by
      calc bb 0 * y 0 ≤ |bb 0 * y 0| := le_abs_self _
        _ = |bb 0| * |y 0| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hbb 0) hy0 (abs_nonneg _) hβ
    have hbb1 : bb 1 * y 1 ≤ β * R := by
      calc bb 1 * y 1 ≤ |bb 1 * y 1| := le_abs_self _
        _ = |bb 1| * |y 1| := abs_mul _ _
        _ ≤ β * R := mul_le_mul (hbb 1) hy1 (abs_nonneg _) hβ
    have h4 : 4 * α * m₀ = 4 * m₀ + 4 * Λ + 4 * β * R := by
      rw [hα]
      field_simp
      ring
    set q := ∑ i : Fin 2, ∑ j : Fin 2, y i * a i j * y j with hqdef
    have hP : 0 < 4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1) - 2 * α * (bb 0 * y 0 + bb 1 * y 1) := by
      have e1 : 4 * α ^ 2 * m₀ ≤ 4 * α ^ 2 * q := by
        have : 0 ≤ 4 * α ^ 2 := by positivity
        exact mul_le_mul_of_nonneg_left hq this
      have e2 : 2 * α * (a 0 0 + a 1 1) ≤ 2 * α * (2 * Λ) :=
        mul_le_mul_of_nonneg_left htr (by positivity)
      have e3 : 2 * α * (bb 0 * y 0 + bb 1 * y 1) ≤ 2 * α * (2 * β * R) :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have e4 : 4 * α ^ 2 * m₀ - 4 * α * Λ - 4 * α * β * R = 4 * α * m₀ := by
        linear_combination α * h4
      have e5 : 0 < 4 * α * m₀ := by positivity
      nlinarith
    have hkey : ∑ i : Fin 2, ∑ j : Fin 2, a i j * ((4 * α ^ 2 * y i * y j
          - 2 * α * (if i = j then 1 else 0)) * Real.exp (-α * ‖y‖ ^ 2))
        + ∑ k : Fin 2, bb k * (-2 * α * y k * Real.exp (-α * ‖y‖ ^ 2))
        = Real.exp (-α * ‖y‖ ^ 2) * (4 * α ^ 2 * q - 2 * α * (a 0 0 + a 1 1)
          - 2 * α * (bb 0 * y 0 + bb 1 * y 1)) := by
      rw [hqdef]
      simp only [Fin.sum_univ_two, if_pos (rfl : (0 : Fin 2) = 0), if_pos (rfl : (1 : Fin 2) = 1),
        if_neg (show ¬((0 : Fin 2) = 1) by decide), if_neg (show ¬((1 : Fin 2) = 0) by decide),
        if_true]
      ring
    rw [hkey]
    exact mul_pos hE hP
  
  obtain ⟨v, hv⟩ : ∃ v : E2 → ℝ, ∀ x, v x = Real.exp (-α * ‖x - z‖ ^ 2) - Real.exp (-α * R ^ 2) :=
    ⟨_, fun x => rfl⟩
  obtain ⟨hvs, hvD, hv1, hv2⟩ := esm_barrier_derivs z α R v hv
  have hV1 : ∀ x, dist x z = R → v x = 0 := by
    intro x hx
    rw [hv, ← dist_eq_norm, hx, sub_self]
  have hV2 : ∀ x, v x ≤ 1 := by
    intro x
    have h1 : Real.exp (-α * ‖x - z‖ ^ 2) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have := sq_nonneg ‖x - z‖
      nlinarith
    have h2 := Real.exp_pos (-α * R ^ 2)
    rw [hv]
    linarith
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : E2, y₀ = (1 / 2 : ℝ) • (z - x₁) := ⟨_, rfl⟩
  have hV3 : 0 < fderiv ℝ v x₁ y₀ := by
    rw [hvD x₁ y₀]
    have hs : ∑ k : Fin 2, (x₁ - z) k * y₀ k = -(1 / 2) * ‖x₁ - z‖ ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [hy₀, Fin.sum_univ_two, Real.norm_eq_abs, sq_abs]
      ring
    rw [hs, ← dist_eq_norm, hx₁z]
    rw [show -2 * α * (-(1 / 2) * R ^ 2) = α * R ^ 2 by ring]
    positivity
  
  have hu : ContDiffOn ℝ ∞ (fun x => -w x - m * v x) W :=
    hw.neg.sub (contDiffOn_const.mul hvs.contDiffOn)
  
  have hlin : ∀ x ∈ W, fderiv ℝ (fun y => -w y - m * v y) x = -fderiv ℝ w x - m • fderiv ℝ v x ∧
      (∀ k : Fin 2, pd2 k (fun y => -w y - m * v y) x = -pd2 k w x - m * pd2 k v x) ∧
      ∀ i j : Fin 2, pd2 i (pd2 j (fun y => -w y - m * v y)) x
        = -pd2 i (pd2 j w) x - m * pd2 i (pd2 j v) x := by
    intro x hx
    have hdf : ∀ y ∈ W, DifferentiableAt ℝ w y := fun y hy =>
      (hw.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hy)
    have hdg : ∀ y, DifferentiableAt ℝ v y := fun y => hvs.differentiable (by simp) y
    have h1 : ∀ y ∈ W, fderiv ℝ (fun y => -w y - m * v y) y = -fderiv ℝ w y - m • fderiv ℝ v y := by
      intro y hy
      exact ((hdf y hy).hasFDerivAt.neg.sub ((hdg y).hasFDerivAt.const_mul m)).fderiv
    have h2 : ∀ y ∈ W, ∀ k : Fin 2,
        pd2 k (fun y => -w y - m * v y) y = -pd2 k w y - m * pd2 k v y := by
      intro y hy k
      show fderiv ℝ (fun y => -w y - m * v y) y (e2 k)
        = -fderiv ℝ w y (e2 k) - m * fderiv ℝ v y (e2 k)
      rw [h1 y hy]
      simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.neg_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hdpf : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ w y (e2 j)) x := by
      intro j
      have hc : ContDiffOn ℝ ∞ (fun y => fderiv ℝ w y (e2 j)) W :=
        (hw.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
      exact (hc.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
    have hdpg : ∀ j : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ v y (e2 j)) x := by
      intro j
      have hc : ContDiff ℝ ∞ (fun y => fderiv ℝ v y (e2 j)) :=
        (hvs.fderiv_right (m := ∞) (by simp)).clm_apply contDiff_const
      exact hc.differentiable (by simp) x
    refine ⟨h1 x hx, h2 x hx, fun i j => ?_⟩
    have hev : pd2 j (fun y => -w y - m * v y) =ᶠ[𝓝 x]
        fun y => -fderiv ℝ w y (e2 j) - m * fderiv ℝ v y (e2 j) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => h2 y hy j)
    show fderiv ℝ (pd2 j (fun y => -w y - m * v y)) x (e2 i)
      = -fderiv ℝ (fun y => fderiv ℝ w y (e2 j)) x (e2 i)
        - m * fderiv ℝ (fun y => fderiv ℝ v y (e2 j)) x (e2 i)
    rw [hev.fderiv_eq]
    have hD : HasFDerivAt (fun y => -fderiv ℝ w y (e2 j) - m * fderiv ℝ v y (e2 j))
        (-(fderiv ℝ (fun y => fderiv ℝ w y (e2 j)) x)
          - m • fderiv ℝ (fun y => fderiv ℝ v y (e2 j)) x) x :=
      (hdpf j).hasFDerivAt.neg.sub ((hdpg j).hasFDerivAt.const_mul m)
    rw [hD.fderiv]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.neg_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have hstrict : ∀ x : E2, R / 2 < dist x z → dist x z < R →
      ∑ i : Fin 2, ∑ j : Fin 2, A x i j * pd2 i (pd2 j (fun x => -w x - m * v x)) x
        + ∑ k : Fin 2, B x k * pd2 k (fun x => -w x - m * v x) x
        - (0 : ℝ) * (fun x => -w x - m * v x) x < 0 := by
    intro x h1 h2
    have hxb : x ∈ Metric.ball z R := Metric.mem_ball.mpr h2
    have hxW : x ∈ W := hbW hxb
    obtain ⟨-, hp1, hp2⟩ := hlin x hxW
    obtain ⟨hq, ha, hbx, -⟩ := hK x h1.le h2.le
    have hineq := hbar (A x) (B x) (x - z) hq ha hbx
      (by rw [← dist_eq_norm]; exact h2.le)
    have he := hH0 x hxb
    have hTv := mul_pos hm hineq
    simp only [hp1, hp2, hv1, hv2, zero_mul] at hTv ⊢
    simp only [Fin.sum_univ_two] at hTv he ⊢
    linarith
  have hout : ∀ x : E2, dist x z = R → 0 ≤ (fun x => -w x - m * v x) x := by
    intro x hx
    have hxW : x ∈ W := hball (by rw [Metric.mem_closedBall, hx])
    have hxcl : x ∈ closure (Metric.ball z R) := by
      rw [closure_ball z hR.ne']
      rw [Metric.mem_closedBall, hx]
    have hwc : ContinuousWithinAt w (Metric.ball z R) x :=
      (hw.continuousOn.continuousAt (hW.mem_nhds hxW)).continuousWithinAt
    have hwx : w x ≤ (fun _ => (0 : ℝ)) x :=
      ContinuousWithinAt.closure_le hxcl hwc continuousWithinAt_const
        (fun y hy => (hneg y (hbW hy) (hbpos y hy)).le)
    show 0 ≤ -w x - m * v x
    rw [hV1 x hx, mul_zero, sub_zero]
    simp only at hwx
    linarith
  have hin : ∀ x : E2, dist x z = R / 2 → 0 ≤ (fun x => -w x - m * v x) x := by
    intro x hx
    have h1 : m ≤ -w x := hSin x hx
    have h2 := hV2 x
    show 0 ≤ -w x - m * v x
    nlinarith
  have hApsd : ∀ x ∈ W, ∀ ξ : E2, 0 ≤ ∑ i : Fin 2, ∑ j : Fin 2, ξ i * A x i j * ξ j := by
    intro x hx ξ
    by_cases hξ : ξ = 0
    · subst hξ
      simp
    · exact (hApos x hx ξ hξ).le
  have hmp := esm_annulus_min_principle W hW A B (fun x => -w x - m * v x) 0 z R hR hball hu hAs
    hApsd le_rfl hstrict hin hout
  
  have hu1 : -w x₁ - m * v x₁ = 0 := by
    rw [hw0, hV1 x₁ hx₁z]
    ring
  have hseg : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
      (fun x => -w x - m * v x) x₁ ≤ (fun x => -w x - m * v x) (x₁ + t • y₀) := by
    intro t ht0 ht1
    have hd : dist (x₁ + t • y₀) z = (1 - t / 2) * R := by
      have e1 : x₁ + t • y₀ - z = (1 - t / 2) • (x₁ - z) := by
        rw [hy₀]
        module
      rw [dist_eq_norm, e1, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by linarith),
        ← dist_eq_norm, hx₁z]
    show -w x₁ - m * v x₁ ≤ -w (x₁ + t • y₀) - m * v (x₁ + t • y₀)
    rw [hu1]
    exact hmp _ (by rw [hd]; nlinarith) (by rw [hd]; nlinarith)
  have hdu : DifferentiableAt ℝ (fun x => -w x - m * v x) x₁ :=
    (hu.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx₁W)
  have h11 : 0 ≤ fderiv ℝ (fun x => -w x - m * v x) x₁ y₀ := by
    have hminOn : IsLocalMinOn (fun x => -w x - m * v x) (segment ℝ x₁ (x₁ + y₀)) x₁ := by
      apply Filter.eventually_of_mem self_mem_nhdsWithin
      intro p hp
      rw [segment_eq_image'] at hp
      obtain ⟨θ, ⟨h0, h1⟩, rfl⟩ := hp
      have := hseg θ h0 h1
      simpa only [add_sub_cancel_left] using this
    exact hminOn.hasFDerivWithinAt_nonneg hdu.hasFDerivAt.hasFDerivWithinAt
      (mem_posTangentConeAt_of_segment_subset subset_rfl)
  
  intro hdw0
  obtain ⟨hf1, -, -⟩ := hlin x₁ hx₁W
  rw [hf1, hdw0] at h11
  simp only [neg_zero, zero_sub, ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.zero_apply, smul_eq_mul] at h11
  nlinarith [mul_pos hm hV3]

theorem pcgb_green_function {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) :
    Nonempty (PcgbGreenData P b) :=
by
  classical
  
  have hadd : ∀ (hm : E2 → Matrix (Fin 2) (Fin 2) ℝ) (f g : E2 → ℝ) (V : Set E2), IsOpen V →
      ContDiffOn ℝ 2 f V → ContDiffOn ℝ 2 g V → ∀ x ∈ V,
      lap2 hm (fun y => f y + g y) x = lap2 hm f x + lap2 hm g x := by
    intro hm f g V hV hf hg x hx
    have hdf : ∀ y ∈ V, DifferentiableAt ℝ f y := fun y hy =>
      (hf.contDiffAt (hV.mem_nhds hy)).differentiableAt two_ne_zero
    have hdg : ∀ y ∈ V, DifferentiableAt ℝ g y := fun y hy =>
      (hg.contDiffAt (hV.mem_nhds hy)).differentiableAt two_ne_zero
    have hf1 : ContDiffOn ℝ 1 (fderiv ℝ f) V := hf.fderiv_of_isOpen hV (by norm_num)
    have hg1 : ContDiffOn ℝ 1 (fderiv ℝ g) V := hg.fderiv_of_isOpen hV (by norm_num)
    have hdf' : DifferentiableAt ℝ (fderiv ℝ f) x :=
      (hf1.contDiffAt (hV.mem_nhds hx)).differentiableAt one_ne_zero
    have hdg' : DifferentiableAt ℝ (fderiv ℝ g) x :=
      (hg1.contDiffAt (hV.mem_nhds hx)).differentiableAt one_ne_zero
    have hp1 : ∀ y ∈ V, ∀ k : Fin 2, pd2 k (fun y => f y + g y) y = pd2 k f y + pd2 k g y := by
      intro y hy k
      unfold pd2
      rw [fderiv_fun_add (hdf y hy) (hdg y hy)]
      rfl
    have hp2 : ∀ i k : Fin 2, pd2 i (pd2 k (fun y => f y + g y)) x =
        pd2 i (pd2 k f) x + pd2 i (pd2 k g) x := by
      intro i k
      have hev : pd2 k (fun y => f y + g y) =ᶠ[𝓝 x] fun y => pd2 k f y + pd2 k g y :=
        Filter.eventually_of_mem (hV.mem_nhds hx) (fun y hy => hp1 y hy k)
      have hA : DifferentiableAt ℝ (pd2 k f) x := hdf'.clm_apply (differentiableAt_const _)
      have hB : DifferentiableAt ℝ (pd2 k g) x := hdg'.clm_apply (differentiableAt_const _)
      show fderiv ℝ (pd2 k (fun y => f y + g y)) x (e2 i) =
        fderiv ℝ (pd2 k f) x (e2 i) + fderiv ℝ (pd2 k g) x (e2 i)
      rw [hev.fderiv_eq, fderiv_fun_add hA hB]
      rfl
    unfold lap2
    simp only [Fin.sum_univ_two, hp2, hp1 x hx]
    ring
  
  have hparamOS : ∀ j, ∀ x ∈ P.W j, P.param j x ∈ P.O j ∩ S := by
    intro j x hx
    rw [← P.image_eq]
    exact ⟨x, hx, rfl⟩
  have hchart : ∀ q ∈ S, ∃ j, ∃ x ∈ P.W j, P.param j x = q := by
    intro q hq
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (P.cover hq)
    have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq]; exact ⟨hj, hq⟩
    obtain ⟨x, hx, hxq⟩ := hq'
    exact ⟨j, x, hx, hxq⟩
  
  obtain ⟨j₀, x₀, r₁, hr₁, hball₁, hpos₁⟩ := pcgb_interior_ball S P b hb hreg hbd
  have hx₀W : x₀ ∈ P.W j₀ := hball₁ (Metric.mem_closedBall_self hr₁.le)
  have hp₀S : P.param j₀ x₀ ∈ S := (hparamOS j₀ x₀ hx₀W).2
  have hbp₀ : 2 * r₁ ≤ b (P.param j₀ x₀) := hpos₁ x₀ (Metric.mem_closedBall_self hr₁.le)
  have hbp₀' : 0 < b (P.param j₀ x₀) := by linarith
  
  obtain ⟨Λ, F, ρ₂, C₂, K, hρ₂, hρ₂r, hC₂, hK0, hΛs, hFs, hzero, hlapΛ, hhold, hP6, hpole⟩ :=
    pcgb_chart_parametrix (P.W j₀) (P.W_open j₀) (P.h j₀) (P.h_smooth j₀) (P.h_posDef j₀) x₀ r₁
      hr₁ hball₁
  have hball₂ : Metric.closedBall x₀ ρ₂ ⊆ P.W j₀ :=
    (Metric.closedBall_subset_closedBall hρ₂r).trans hball₁
  
  obtain ⟨TΛ0, TΛ1, -, TΛ3, TΛ4⟩ := pcgb_chart_transport S P j₀ x₀ ρ₂ hρ₂ hball₂ Λ
    (fun x hx => (hzero x hx).1) hΛs
  obtain ⟨-, TF1, TF2, -, TF4⟩ := pcgb_chart_transport S P j₀ x₀ ρ₂ hρ₂ hball₂ F
    (fun x hx => (hzero x hx).2) hFs
  have hout : ∀ q, b q < 2 * r₁ → q ∉ P.param j₀ '' Metric.closedBall x₀ ρ₂ := by
    rintro q hq ⟨y, hy, rfl⟩
    have := hpos₁ y (Metric.closedBall_subset_closedBall hρ₂r hy)
    linarith
  
  obtain ⟨v, U, hUo, hRU, hv1, hv2, hv3, hv4⟩ :=
    pcgb_dirichlet_solve S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1 hreg hbd
      (P.param j₀ x₀) (pcgbTransport P j₀ F) TF1 (TF2 K hhold)
      ⟨2 * r₁, by linarith, fun q _ hq => TF4 q (hout q hq)⟩
  
  obtain ⟨w, hw⟩ : ∃ w : X → ℝ, w = fun q => pcgbTransport P j₀ Λ q + v q := ⟨_, rfl⟩
  have hwq : ∀ q, w q = pcgbTransport P j₀ Λ q + v q := fun q => by rw [hw]
  have hwj : ∀ j, (fun y => w (P.param j y)) =
      fun y => pcgbTransport P j₀ Λ (P.param j y) + v (P.param j y) := by
    intro j; funext y; exact hwq _
  have hVo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (hUo.sdiff isClosed_singleton)
  have hΛinf : ∀ j, ContDiffOn ℝ ∞ (fun x => pcgbTransport P j₀ Λ (P.param j x))
      (P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀})) := fun j =>
    (TΛ1 j).mono (fun x hx => ⟨hx.1, hx.2.2⟩)
  have hΛ2 : ∀ j, ContDiffOn ℝ 2 (fun x => pcgbTransport P j₀ Λ (P.param j x))
      (P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀})) := fun j =>
    (hΛinf j).of_le (WithTop.coe_le_coe.mpr le_top)
  have hv2' : ∀ j, ContDiffOn ℝ 2 (fun x => v (P.param j x))
      (P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀})) := fun j =>
    (hv2 j).mono (fun x hx => ⟨hx.1, hx.2.1⟩)
  have hsmoothW : ∀ j, ContDiffOn ℝ ∞ (fun x => w (P.param j x))
      (P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀})) := by
    intro j
    rw [hwj j]
    exact (hΛinf j).add (hv1 j)
  
  have harm : ∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) → P.param j x ≠ P.param j₀ x₀ →
      lap2 (P.h j) (fun y => w (P.param j y)) x = 0 := by
    intro j x hx hb0 hne
    have hxV : x ∈ P.W j ∩ P.param j ⁻¹' (U \ {P.param j₀ x₀}) :=
      ⟨hx, hRU ⟨(hparamOS j x hx).2, hb0⟩, hne⟩
    have key := hadd (P.h j) (fun y => pcgbTransport P j₀ Λ (P.param j y))
      (fun y => v (P.param j y)) _ (hVo j) (hΛ2 j) (hv2' j) x hxV
    beta_reduce at key
    rw [hwj j, key, TΛ3 j x hx hne, hv3 j x hx hb0]
    unfold pcgbTransport
    by_cases hq : P.param j x ∈ P.O j₀ ∩ S
    · simp only [Set.indicator_of_mem hq]
      have hq' : P.param j x ∈ P.param j₀ '' P.W j₀ := by rw [P.image_eq]; exact hq
      obtain ⟨y, hy, hyq⟩ := hq'
      rw [← hyq, P.proj_param j₀ y hy]
