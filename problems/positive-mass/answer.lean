      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e j)) = _
    rw [hΦD, hΦD, hJ i, hJ j]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    simp only [Fin.sum_univ_three]
    ring
  
  have s3 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z).det
        ≠ 0 := by
    intro z hz hdet
    obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ hz.1
    have hinj : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u = 0 → u = 0 := by
      intro u hu0
      rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hu0
      exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hu0
    have hw : fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (∑ i : Fin 3, v i • e i) = 0 := by
      ext a
      rw [map_sum]
      simp only [map_smul]
      have := congrFun hJv a
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        hcompo _ z (hψd z hz)] at this
      simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        WithLp.ofLp_zero, Pi.zero_apply]
      rw [← this]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
      apply hinj
      rw [hM1' z hz, hw]
      exact ContinuousLinearMap.map_zero _
    apply hv0
    funext a
    rw [← hcomp_e v a, h0]
    rfl
  
  have s4 : ∀ y ∈ (chartAt E3 (Φ x)).target,
      (g.coeff (chartAt E3 (Φ x)).symm y).det ≠ 0 := by
    intro y hy hdet
    obtain ⟨v, hv0, hGv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm y := ⟨_, rfl⟩
    have hid := (mdifferentiable_chart (I := 𝓘(ℝ, E3)) (Φ x)).comp_symm_deriv hy
    have hinj : ∀ u : E3, D u = 0 → u = 0 := by
      intro u hu0
      have h1 := DFunLike.congr_fun hid u
      have h' : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)) ((chartAt E3 (Φ x)).symm y) (D u)
          = u := by
        rw [hD]
        exact h1
      rw [hu0] at h'
      rw [← h']
      exact ContinuousLinearMap.map_zero _
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (Φ x)).symm y a b
        = g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) := by
      intro a b
      rw [hD]
      rfl
    have hw0 : (∑ i : Fin 3, v i • e i) ≠ 0 := by
      intro h
      apply hv0
      funext a
      rw [← hcomp_e v a, h]
      rfl
    have hpos := g.posDef ((chartAt E3 (Φ x)).symm y) (D (∑ i : Fin 3, v i • e i))
      (fun h => hw0 (hinj _ h))
    have hG : ∀ a, ∑ b : Fin 3, g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) * v b = 0 := by
      intro a
      have := congrFun hGv a
      simp only [Matrix.mulVec, dotProduct, Pi.zero_apply, hcD] at this
      exact this
    have hzero : g.g ((chartAt E3 (Φ x)).symm y) (D (∑ i : Fin 3, v i • e i))
        (D (∑ i : Fin 3, v i • e i)) = 0 := by
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul]
      calc _ = ∑ a : Fin 3, v a * ∑ b : Fin 3,
            g.g ((chartAt E3 (Φ x)).symm y) (D (e a)) (D (e b)) * v b := by
            simp only [Fin.sum_univ_three]; ring
        _ = 0 := by simp [hG]
    rw [hzero] at hpos
    exact lt_irrefl _ hpos
  
  have huW : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x)).target := by
    have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 (Φ x)).symm)
        (chartAt E3 (Φ x)).target :=
      hf.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp this
  have hmapsW : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
      chartAt E3 (Φ x) (Φ z) ∈ (chartAt E3 (Φ x)).target :=
    fun z hz => (chartAt E3 (Φ x)).map_source hz.2
  have hkey := key (fun w => chartAt E3 (Φ x) (Φ w)) (g.coeff (chartAt E3 (Φ x)).symm)
    (fun y => f ((chartAt E3 (Φ x)).symm y))
    (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) (chartAt E3 (Φ x)).target
    h2.1 (chartAt E3 (Φ x)).open_target h2.2 hmapsW
    (fun a b => g.smooth (Φ x) a b)
    (fun y a b => g.symm _ _ _) huW hxU
    (s4 _ ((chartAt E3 (Φ x)).map_source (mem_chart_source E3 (Φ x)))) (s3 x hxU)
  have heqG : g.coeff Φ =ᶠ[𝓝 x] (fun w => Matrix.of fun i j : Fin 3 => ∑ a : Fin 3, ∑ b : Fin 3,
      partialDeriv i (fun v => chartAt E3 (Φ x) (Φ v) a) w *
        g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)) a b *
          partialDeriv j (fun v => chartAt E3 (Φ x) (Φ v) b) w) := by
    filter_upwards [h2.1.mem_nhds hxU] with z hz
    ext i j
    exact s1 z hz i j
  have hequ : h =ᶠ[𝓝 x]
      (fun w => f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ w)))) := by
    filter_upwards [hfh, h2.1.mem_nhds hxU] with z hz1 hz2
    show h z = f ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)))
    rw [(chartAt E3 (Φ x)).left_inv hz2.2]
    exact hz1.symm
  have hL : g.levelMeanCurv f (Φ x) = levelMeanCurvCoord (g.coeff (chartAt E3 (Φ x)).symm)
      (fun y => f ((chartAt E3 (Φ x)).symm y)) (chartAt E3 (Φ x) (Φ x)) := rfl
  rw [hL, lmc_congr _ _ _ _ x heqG hequ]
  exact hkey.symm

theorem end_cutoff_extension [IsManifold 𝓘(ℝ, E3) ∞ M] (Φ : EndChart M) (h : E3 → ℝ)
    (R₁ a : ℝ) (hR₁ : 1 ≤ R₁) (ha : R₁ < a)
    (hh : ContDiffOn ℝ ∞ h {y : E3 | R₁ < ‖y‖})
    (hclosed : IsClosed (Φ.Φ '' {y : E3 | a ≤ ‖y‖})) :
    ∃ u₀ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u₀ ∧
      (∀ p : M, p ∉ Φ.Φ '' {y : E3 | a < ‖y‖} → u₀ p = 0) ∧
      (∀ y : E3, a + 1 ≤ ‖y‖ → u₀ (Φ.Φ y) = h y) :=
by
  have hsrc : Φ.Φ.source = {x : E3 | 1 < ‖x‖} := Φ.source_eq
  obtain ⟨F, hF⟩ : ∃ F : E3 → ℝ, F = fun y => Real.smoothTransition (‖y‖ - a) * h y :=
    ⟨_, rfl⟩
  have hF0 : ∀ y : E3, ‖y‖ ≤ a → F y = 0 := by
    intro y hy
    rw [hF]
    show Real.smoothTransition (‖y‖ - a) * h y = 0
    rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
  have hF1 : ∀ y : E3, a + 1 ≤ ‖y‖ → F y = h y := by
    intro y hy
    rw [hF]
    show Real.smoothTransition (‖y‖ - a) * h y = h y
    rw [Real.smoothTransition.one_of_one_le (by linarith), one_mul]
  have hFsmooth : ContDiff ℝ ∞ F := by
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : R₁ < ‖y‖
    · have hy0 : y ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hy
        linarith
      have hU : {z : E3 | R₁ < ‖z‖} ∈ 𝓝 y :=
        (isOpen_lt continuous_const continuous_norm).mem_nhds hy
      have h1 : ContDiffAt ℝ ∞ h y := hh.contDiffAt hU
      have h2 : ContDiffAt ℝ ∞ (fun z : E3 => ‖z‖ - a) y :=
        (contDiffAt_norm ℝ hy0).sub contDiffAt_const
      have h3 : ContDiffAt ℝ ∞ (fun z : E3 => Real.smoothTransition (‖z‖ - a)) y :=
        Real.smoothTransition.contDiff.contDiffAt.comp y h2
      rw [hF]
      exact h3.mul h1
    · have hy' : ‖y‖ < a := by
        push_neg at hy
        linarith
      have hV : {z : E3 | ‖z‖ < a} ∈ 𝓝 y :=
        (isOpen_lt continuous_norm continuous_const).mem_nhds hy'
      have hev : F =ᶠ[𝓝 y] fun _ : E3 => (0 : ℝ) :=
        Filter.eventually_of_mem hV (fun z hz => hF0 z (le_of_lt hz))
      exact contDiffAt_const.congr_of_eventuallyEq hev
  have hzero : ∀ p : M, p ∉ Φ.Φ '' {y : E3 | a < ‖y‖} →
      Φ.Φ.target.indicator (fun p => F (Φ.Φ.symm p)) p = 0 := by
    intro p hp
    by_cases hpt : p ∈ Φ.Φ.target
    · rw [Set.indicator_of_mem hpt]
      have hy : Φ.Φ (Φ.Φ.symm p) = p := Φ.Φ.toPartialEquiv.right_inv hpt
      have hle : ‖Φ.Φ.symm p‖ ≤ a := by
        by_contra hlt
        push_neg at hlt
        exact hp ⟨Φ.Φ.symm p, hlt, hy⟩
      exact hF0 _ hle
    · exact Set.indicator_of_notMem hpt _
  refine ⟨Φ.Φ.target.indicator (fun p => F (Φ.Φ.symm p)), ?_, hzero, ?_⟩
  · intro p
    by_cases hpt : p ∈ Φ.Φ.target
    · have hT : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => F (Φ.Φ.symm p)) Φ.Φ.target :=
        hFsmooth.contMDiff.comp_contMDiffOn Φ.Φ.symm.contMDiffOn
      have hN : Φ.Φ.target ∈ 𝓝 p := Φ.Φ.open_target.mem_nhds hpt
      have hev : Φ.Φ.target.indicator (fun p => F (Φ.Φ.symm p)) =ᶠ[𝓝 p]
          fun p => F (Φ.Φ.symm p) :=
        Filter.eventually_of_mem hN (fun q hq => Set.indicator_of_mem hq _)
      exact (hT.contMDiffAt hN).congr_of_eventuallyEq hev
    · have hpK : p ∈ (Φ.Φ '' {y : E3 | a ≤ ‖y‖})ᶜ := by
        rintro ⟨y, hyK, rfl⟩
        apply hpt
        have hys : y ∈ Φ.Φ.source := by
          rw [hsrc]
          show (1 : ℝ) < ‖y‖
          have : a ≤ ‖y‖ := hyK
          linarith
        exact Φ.Φ.toPartialEquiv.map_source hys
      have hev : Φ.Φ.target.indicator (fun p => F (Φ.Φ.symm p)) =ᶠ[𝓝 p]
          fun _ => (0 : ℝ) :=
        Filter.eventually_of_mem (hclosed.isOpen_compl.mem_nhds hpK) (fun q hq =>
          hzero q (fun hq' => hq (Set.image_subset _
            (fun y (hy : a < ‖y‖) => (le_of_lt hy : a ≤ ‖y‖)) hq')))
      exact contMDiffAt_const.congr_of_eventuallyEq hev
  · intro y hy
    have hys : y ∈ Φ.Φ.source := by
      rw [hsrc]
      show (1 : ℝ) < ‖y‖
      linarith
    have hyt : Φ.Φ y ∈ Φ.Φ.target := Φ.Φ.toPartialEquiv.map_source hys
    rw [Set.indicator_of_mem hyt]
    have hl : Φ.Φ.symm (Φ.Φ y) = y := Φ.Φ.toPartialEquiv.left_inv hys
    show F (Φ.Φ.symm (Φ.Φ y)) = h y
    rw [hl]
    exact hF1 y hy

theorem radial_exhaustion_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) :
    ∃ (ρ : M → ℝ) (a c : ℝ), 2 ≤ a ∧ ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ ∧
      (∀ (m : Fin hAF.numEnds) (y : E3), a < ‖y‖ → ρ ((hAF.ends m).Φ y) = ‖y‖) ∧
      (∀ p : M, (∀ (m : Fin hAF.numEnds) (y : E3), a < ‖y‖ → (hAF.ends m).Φ y ≠ p) → ρ p ≤ c) ∧
      (∀ s : ℝ, IsCompact {p : M | ρ p ≤ s}) :=
by
  
  have hsub : ∀ (m : Fin hAF.numEnds) (r : ℝ), 1 ≤ r →
      {y : E3 | r < ‖y‖} ⊆ (hAF.ends m).Φ.source := by
    intro m r hr y hy
    rw [(hAF.ends m).source_eq]
    show (1 : ℝ) < ‖y‖
    have : r < ‖y‖ := hy
    linarith
  have hopen : ∀ (m : Fin hAF.numEnds) (r : ℝ), 1 ≤ r →
      IsOpen ((hAF.ends m).Φ '' {y : E3 | r < ‖y‖}) := by
    intro m r hr
    exact (hAF.ends m).Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
      (isOpen_lt continuous_const continuous_norm) (hsub m r hr)
  have hZ : ∀ r : ℝ, 2 ≤ r → IsCompact (⋃ l, (hAF.ends l).Φ '' {y : E3 | r < ‖y‖})ᶜ := by
    intro r hr
    have hclosed : IsClosed (⋃ l, (hAF.ends l).Φ '' {y : E3 | r < ‖y‖})ᶜ := by
      rw [isClosed_compl_iff]
      exact isOpen_iUnion (fun l => hopen l r (by linarith))
    have hK : IsCompact ((⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 < ‖y‖})ᶜ ∪
        ⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r}) := by
      refine hAF.isCompact_core.union (isCompact_iUnion fun l => ?_)
      have hc : IsCompact {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r} := by
        refine (isCompact_closedBall (0 : E3) r).of_isClosed_subset ?_ ?_
        · exact (isClosed_le continuous_const continuous_norm).inter
            (isClosed_le continuous_norm continuous_const)
        · intro y hy
          rw [mem_closedBall_zero_iff]
          exact hy.2
      have hsub' : {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ r} ⊆ (hAF.ends l).Φ.source := by
        intro y hy
        rw [(hAF.ends l).source_eq]
        show (1 : ℝ) < ‖y‖
        linarith [hy.1]
      have hcont : ContinuousOn ((hAF.ends l).Φ : E3 → M) (hAF.ends l).Φ.source :=
        (hAF.ends l).Φ.contMDiffOn_toFun.continuousOn
      exact hc.image_of_continuousOn (hcont.mono hsub')
    refine hK.of_isClosed_subset hclosed ?_
    intro x hx
    by_cases h2 : x ∈ ⋃ l, (hAF.ends l).Φ '' {y : E3 | 2 < ‖y‖}
    · right
      obtain ⟨l, y, hy, rfl⟩ := Set.mem_iUnion.1 h2
      have hy' : (2 : ℝ) < ‖y‖ := hy
      refine Set.mem_iUnion.2 ⟨l, y, ⟨le_of_lt hy', ?_⟩, rfl⟩
      by_contra hc
      push_neg at hc
      exact hx (Set.mem_iUnion.2 ⟨l, y, hc, rfl⟩)
    · left
      exact h2
  
  have hcl := fun m => endChart_far_isClosed g hAF m
  choose ρ₀ hρ₀2 hρ₀cl using hcl
  obtain ⟨a₁, ha₁⟩ := Finite.exists_le ρ₀
  set a₀ : ℝ := max a₁ 2 with ha₀def
  have ha₀2 : (2 : ℝ) ≤ a₀ := le_max_right _ _
  have hh : ContDiffOn ℝ ∞ (fun y : E3 => ‖y‖) {y : E3 | 1 < ‖y‖} := by
    intro y hy
    have hy' : (1 : ℝ) < ‖y‖ := hy
    have hy0 : y ≠ 0 := norm_pos_iff.1 (lt_trans one_pos hy')
    exact (contDiffAt_norm ℝ hy0).contDiffWithinAt
  have hcut := fun m : Fin hAF.numEnds =>
    end_cutoff_extension (hAF.ends m) (fun y : E3 => ‖y‖) 1 a₀ le_rfl (by linarith) hh
      (hρ₀cl m a₀ (le_trans (ha₁ m) (le_max_left _ _)))
  choose u hus hu0 hueq using hcut
  
  set ρ : M → ℝ := fun p => ∑ m : Fin hAF.numEnds, u m p with hρdef
  have hρs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ :=
    contMDiff_finset_sum (fun m _ => hus m)
  have hρc : Continuous ρ := hρs.continuous
  set a : ℝ := a₀ + 1 with hadef
  have ha2 : (2 : ℝ) ≤ a := by linarith
  have htgt : ∀ (m : Fin hAF.numEnds) (y : E3), 1 < ‖y‖ →
      (hAF.ends m).Φ y ∈ (hAF.ends m).Φ.target := by
    intro m y hy
    have hy' : y ∈ (hAF.ends m).Φ.source := by
      rw [(hAF.ends m).source_eq]; exact hy
    exact (hAF.ends m).Φ.toOpenPartialHomeomorph.map_source hy'
  have hform : ∀ (m : Fin hAF.numEnds) (y : E3), a < ‖y‖ → ρ ((hAF.ends m).Φ y) = ‖y‖ := by
    intro m y hy
    have hy1 : (1 : ℝ) < ‖y‖ := by linarith
    show ∑ b : Fin hAF.numEnds, u b ((hAF.ends m).Φ y) = ‖y‖
    rw [Finset.sum_eq_single m]
    · exact hueq m y (by linarith)
    · intro b _ hbm
      apply hu0 b
      rintro ⟨z, hz, heq⟩
      have hz' : a₀ < ‖z‖ := hz
      have h1 := htgt b z (by linarith)
      have h2 := htgt m y hy1
      rw [heq] at h1
      exact Set.disjoint_left.1 (hAF.disjoint hbm) h1 h2
    · intro hm
      exact absurd (Finset.mem_univ m) hm
  
  obtain ⟨c, hc⟩ := (hZ a ha2).bddAbove_image hρc.continuousOn
  refine ⟨ρ, a, c, ha2, hρs, hform, ?_, ?_⟩
  · intro p hp
    have hpZ : p ∈ (⋃ l, (hAF.ends l).Φ '' {y : E3 | a < ‖y‖})ᶜ := by
      intro hx
      obtain ⟨m, y, hy, hyp⟩ := Set.mem_iUnion.1 hx
      exact hp m y hy hyp
    exact hc ⟨p, hpZ, rfl⟩
  · intro s
    have hr2 : (2 : ℝ) ≤ max s a := le_trans ha2 (le_max_right _ _)
    refine (hZ (max s a) hr2).of_isClosed_subset (isClosed_le hρc continuous_const) ?_
    intro p hp hx
    have hp' : ρ p ≤ s := hp
    obtain ⟨m, y, hy, rfl⟩ := Set.mem_iUnion.1 hx
    have hy' : max s a < ‖y‖ := hy
    have hya : a < ‖y‖ := lt_of_le_of_lt (le_max_right _ _) hy'
    have hys : s < ‖y‖ := lt_of_le_of_lt (le_max_left _ _) hy'
    rw [hform m y hya] at hp'
    linarith

theorem sep_h_props : ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ∧
    (∀ t : ℝ, 0 ≤ Real.smoothTransition (2 * t - 1) ∧ Real.smoothTransition (2 * t - 1) ≤ 1) ∧
    (∀ t : ℝ, t ≤ 1 / 2 → Real.smoothTransition (2 * t - 1) = 0) ∧
    (∀ t : ℝ, 1 ≤ t → Real.smoothTransition (2 * t - 1) = 1) ∧
    (∀ t : ℝ, 0 ≤ deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) t) ∧
    (∀ t : ℝ, (t ≤ 1 / 2 ∨ 1 ≤ t) → deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) t = 0) :=
by
  have hc : ∀ t : ℝ, t ≤ 1 / 2 → Real.smoothTransition (2 * t - 1) = 0 := fun t ht =>
    Real.smoothTransition.zero_of_nonpos (by linarith)
  have hd : ∀ t : ℝ, 1 ≤ t → Real.smoothTransition (2 * t - 1) = 1 := fun t ht =>
    Real.smoothTransition.one_of_one_le (by linarith)
  have hmono : Monotone (fun t : ℝ => Real.smoothTransition (2 * t - 1)) :=
    fun a b hab => Real.smoothTransition.monotone (by linarith)
  refine ⟨?_, fun t => ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩, hc, hd,
    fun t => hmono.deriv_nonneg, ?_⟩
  · exact (Real.smoothTransition.contDiff (n := ⊤)).comp
      ((contDiff_const.mul contDiff_id).sub contDiff_const)
  · rintro t (ht | ht)
    · apply IsLocalMin.deriv_eq_zero
      refine Filter.Eventually.of_forall (fun y => ?_)
      show Real.smoothTransition (2 * t - 1) ≤ Real.smoothTransition (2 * y - 1)
      rw [hc t ht]
      exact Real.smoothTransition.nonneg _
    · apply IsLocalMax.deriv_eq_zero
      refine Filter.Eventually.of_forall (fun y => ?_)
      show Real.smoothTransition (2 * y - 1) ≤ Real.smoothTransition (2 * t - 1)
      rw [hd t ht]
      exact Real.smoothTransition.le_one _

theorem sep_div_test_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T U : Set E3) (hT : IsOpen T)
    (hUT : U ⊆ T) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T)
    (hpd : ∀ y ∈ T, (G y).PosDef) (X : E3 → E3) (hX : ContDiff ℝ ∞ X)
    (hXc : HasCompactSupport X) (hXU : tsupport X ⊆ U)
    (hXn : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1)
    (v : E3 → ℝ) (hv : ContDiffOn ℝ ∞ v T) :
    Continuous (sepDensDiv G X) ∧ tsupport (sepDensDiv G X) ⊆ tsupport X ∧
    ENNReal.ofReal (∫ y, v y * sepDensDiv G X y) ≤
      ∫⁻ y in U, ENNReal.ofReal (Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i v y * partialDeriv j v y) * Real.sqrt (G y).det) :=
by
  
  have tA : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T) →
      (∀ y ∈ T, (G y).PosDef) →
      ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T := by
    intro G T hG hpd
    have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
      have : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
          - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three (G y)
      rw [this]
      have h := hG
      exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    exact hdet.sqrt (fun y hy => (hpd y hy).det_pos.ne')
  
  have tB : ∀ (T K : Set E3), IsOpen T → IsClosed K → K ⊆ T →
      ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f T → (∀ y, y ∉ K → f y = 0) →
      ContDiff ℝ ∞ f ∧ ∀ y, y ∉ K → ∀ i : Fin 3, partialDeriv i f y = 0 := by
    intro T K hT hK hKT f hf hfK
    have hloc : ∀ y, y ∉ K → f =ᶠ[𝓝 y] fun _ => (0:ℝ) :=
      fun y hy => Filter.eventually_of_mem (hK.isOpen_compl.mem_nhds hy) (fun z hz => hfK z hz)
    refine ⟨contDiff_iff_contDiffAt.2 fun y => ?_, fun y hy i => ?_⟩
    · by_cases hy : y ∈ T
      · exact hf.contDiffAt (hT.mem_nhds hy)
      · exact contDiffAt_const.congr_of_eventuallyEq (hloc y (fun h => hy (hKT h)))
    · unfold partialDeriv
      rw [(hloc y hy).fderiv_eq]
      simp
  
  have tE : ∀ (h φ : E3 → ℝ) (K U : Set E3), Integrable h → IsClosed K → K ⊆ U →
      (∀ y ∈ K, h y ≤ φ y) → (∀ y, y ∉ K → h y = 0) →
      ENNReal.ofReal (∫ y, h y) ≤ ∫⁻ y in U, ENNReal.ofReal (φ y) := by
    intro h φ K U hh hK hKU hle h0
    rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hh]
    calc ENNReal.ofReal ((∫⁻ y, ENNReal.ofReal (h y)).toReal
          - (∫⁻ y, ENNReal.ofReal (-h y)).toReal)
        ≤ ENNReal.ofReal ((∫⁻ y, ENNReal.ofReal (h y)).toReal) :=
          ENNReal.ofReal_le_ofReal (sub_le_self _ ENNReal.toReal_nonneg)
      _ ≤ ∫⁻ y, ENNReal.ofReal (h y) := ENNReal.ofReal_toReal_le
      _ ≤ ∫⁻ y, K.indicator (fun y => ENNReal.ofReal (φ y)) y := by
          refine lintegral_mono fun y => ?_
          by_cases hy : y ∈ K
          · rw [Set.indicator_of_mem hy]; exact ENNReal.ofReal_le_ofReal (hle y hy)
          · rw [h0 y hy, ENNReal.ofReal_zero]; exact zero_le _
      _ = ∫⁻ y in K, ENNReal.ofReal (φ y) := lintegral_indicator hK.measurableSet _
      _ ≤ ∫⁻ y in U, ENNReal.ofReal (φ y) := lintegral_mono_set hKU
  
  have tD : ∀ (Gm : Matrix (Fin 3) (Fin 3) ℝ), Gm.PosDef → ∀ (a Z : Fin 3 → ℝ),
      |∑ i : Fin 3, a i * Z i| ≤
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * a i * a j) *
          Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, Gm i j * Z i * Z j) := by
    intro Gm hGm a Z
    have hsym : ∀ i j, Gm i j = Gm j i := by
      intro i j
      have := hGm.isHermitian.apply i j
      simpa using this.symm
    have hQ : ∀ u : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * u i * u j := by
      intro u
      have h := hGm.posSemidef.dotProduct_mulVec_nonneg u
      have e1 : star u ⬝ᵥ (Matrix.mulVec Gm u) =
          ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * u i * u j := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        ring
      rw [← e1]; exact h
    set w : Fin 3 → ℝ := Matrix.mulVec Gm⁻¹ a with hw
    have hunit : IsUnit Gm.det := hGm.det_pos.ne'.isUnit
    have hGw : Matrix.mulVec Gm w = a := by
      rw [hw, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hunit, Matrix.one_mulVec]
    have ha : ∀ i, a i = ∑ j : Fin 3, Gm i j * w j := by
      intro i
      rw [← hGw]
      simp [Matrix.mulVec, dotProduct]
    have hwi : ∀ i, w i = ∑ j : Fin 3, Gm⁻¹ i j * a j := by
      intro i
      simp [hw, Matrix.mulVec, dotProduct]
    set B := ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * Z i * w j with hB
    have e1 : ∑ i : Fin 3, a i * Z i = B := by
      simp only [hB, ha, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    have e2 : ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * a i * a j =
        ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * w i * w j := by
      have s1 : ∑ i : Fin 3, ∑ j : Fin 3, Gm⁻¹ i j * a i * a j = ∑ i : Fin 3, a i * w i := by
        simp only [hwi, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        ring
      rw [s1]
      simp only [ha, Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    set Qw := ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * w i * w j with hQw
    set QZ := ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * Z i * Z j with hQZ
    have hquad : ∀ t : ℝ, 0 ≤ Qw * (t * t) + (2 * B) * t + QZ := by
      intro t
      have h := hQ (fun i => Z i + t * w i)
      have hexp : ∑ i : Fin 3, ∑ j : Fin 3, Gm i j * (Z i + t * w i) * (Z j + t * w j) =
          Qw * (t * t) + (2 * B) * t + QZ := by
        simp only [hQw, hQZ, hB, Fin.sum_univ_three]
        rw [hsym 1 0, hsym 2 0, hsym 2 1]
        ring
      rw [← hexp]; exact h
    have hdisc := discrim_le_zero hquad
    unfold discrim at hdisc
    have hB2 : B ^ 2 ≤ Qw * QZ := by nlinarith
    rw [e1, e2, ← Real.sqrt_mul (hQ w)]
    exact Real.abs_le_sqrt hB2
  
  have tC : ∀ (T : Set E3), IsOpen T → ∀ (v w : E3 → ℝ), ContDiffOn ℝ ∞ v T →
      ContDiffOn ℝ ∞ w T → ∀ (K : Set E3), IsCompact K → K ⊆ T →
      (∀ y, y ∉ K → w y = 0) → ∀ (i : Fin 3),
      Integrable (fun y => v y * partialDeriv i w y) ∧
      Integrable (fun y => partialDeriv i v y * w y) ∧
      ∫ y, v y * partialDeriv i w y = -∫ y, partialDeriv i v y * w y := by
    intro T hT v w hv hw K hK hKT hwK i
    have hKc : IsClosed K := hK.isClosed
    obtain ⟨hwd, hw0⟩ := tB T K hT hKc hKT w hw hwK
    have hPT : ContDiffOn ℝ ∞ (fun y => v y * w y) T := hv.mul hw
    have hP0 : ∀ y, y ∉ K → v y * w y = 0 := fun y hy => by rw [hwK y hy, mul_zero]
    obtain ⟨hPd, hP0'⟩ := tB T K hT hKc hKT _ hPT hP0
    have hprod : ∀ y, partialDeriv i (fun y => v y * w y) y =
        partialDeriv i v y * w y + v y * partialDeriv i w y := by
      intro y
      by_cases hy : y ∈ T
      · have hvd : DifferentiableAt ℝ v y :=
          (hv.contDiffAt (hT.mem_nhds hy)).differentiableAt (by simp)
        have hwd' : DifferentiableAt ℝ w y := (hwd.differentiable (by simp)) y
        unfold partialDeriv
        rw [show (fun y => v y * w y) = v * w from rfl, fderiv_mul hvd hwd']
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have hyK : y ∉ K := fun h => hy (hKT h)
        rw [hP0' y hyK i, hwK y hyK, hw0 y hyK i]
        ring
    have hloc : ∀ y, y ∉ K → ∀ g : E3 → ℝ, (∀ z, z ∉ K → g z = 0) →
        g =ᶠ[𝓝 y] fun _ => (0:ℝ) :=
      fun y hy g hg => Filter.eventually_of_mem (hKc.isOpen_compl.mem_nhds hy)
        (fun z hz => hg z hz)
    have hdw : Continuous (fun y => partialDeriv i w y) :=
      (hwd.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdvT : ContinuousOn (fderiv ℝ v) T := hv.continuousOn_fderiv_of_isOpen hT (by simp)
    have hc1 : Continuous (fun y => v y * partialDeriv i w y) := by
      refine continuous_iff_continuousAt.2 fun y => ?_
      by_cases hy : y ∈ T
      · exact (hv.continuousOn.continuousAt (hT.mem_nhds hy)).mul hdw.continuousAt
      · have hyK : y ∉ K := fun h => hy (hKT h)
        exact continuousAt_const.congr
          (hloc y hyK _ (fun z hz => by rw [hw0 z hz i, mul_zero])).symm
    have hc2 : Continuous (fun y => partialDeriv i v y * w y) := by
      refine continuous_iff_continuousAt.2 fun y => ?_
      by_cases hy : y ∈ T
      · exact ((hdvT.continuousAt (hT.mem_nhds hy)).clm_apply continuousAt_const).mul
          hwd.continuous.continuousAt
      · have hyK : y ∉ K := fun h => hy (hKT h)
        exact continuousAt_const.congr
          (hloc y hyK _ (fun z hz => by rw [hwK z hz, mul_zero])).symm
    have hi1 : Integrable (fun y => v y * partialDeriv i w y) :=
      hc1.integrable_of_hasCompactSupport
        (HasCompactSupport.intro hK fun z hz => by rw [hw0 z hz i, mul_zero])
    have hi2 : Integrable (fun y => partialDeriv i v y * w y) :=
      hc2.integrable_of_hasCompactSupport
        (HasCompactSupport.intro hK fun z hz => by rw [hwK z hz, mul_zero])
    have hzero : ∫ y, partialDeriv i (fun y => v y * w y) y = 0 := by
      have hcP : Continuous (fun y => partialDeriv i (fun y => v y * w y) y) :=
        (hPd.continuous_fderiv (by simp)).clm_apply continuous_const
      have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
        (f := fun _ : E3 => (1:ℝ)) (g := fun y => v y * w y) (v := e i) ?_ ?_ ?_
        (differentiable_const _) (hPd.differentiable (by simp))
      · simpa [partialDeriv] using h
      · simp
      · simp only [one_mul]
        exact hcP.integrable_of_hasCompactSupport
          (HasCompactSupport.intro hK fun z hz => hP0' z hz i)
      · simp only [one_mul]
        exact hPd.continuous.integrable_of_hasCompactSupport (HasCompactSupport.intro hK hP0)
    refine ⟨hi1, hi2, ?_⟩
    have hsum : ∫ y, partialDeriv i (fun y => v y * w y) y =
        (∫ y, partialDeriv i v y * w y) + ∫ y, v y * partialDeriv i w y :=
      (integral_congr_ae (Filter.Eventually.of_forall hprod)).trans (integral_add hi2 hi1)
    linarith
  
  have hKc : IsClosed (tsupport X) := isClosed_tsupport X
  have hKcpt : IsCompact (tsupport X) := hXc.isCompact
  have hKT : tsupport X ⊆ T := hXU.trans hUT
  have hX0 : ∀ y, y ∉ tsupport X → ∀ i : Fin 3, X y i = 0 := by
    intro y hy i
    rw [image_eq_zero_of_notMem_tsupport hy]
    simp
  have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := contDiff_euclidean.mp hX
  
  have hsd := tA G T hG hpd
  have hFT : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun z => Real.sqrt (G z).det * X z i) T :=
    fun i => hsd.mul (hXi i).contDiffOn
  have hF0 : ∀ i : Fin 3, ∀ y, y ∉ tsupport X → Real.sqrt (G y).det * X y i = 0 :=
    fun i y hy => by rw [hX0 y hy i, mul_zero]
  have hFg := fun i => tB T (tsupport X) hT hKc hKT _ (hFT i) (hF0 i)
  
  have hcont : Continuous (sepDensDiv G X) := by
    show Continuous (fun y => ∑ i : Fin 3,
      partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y)
    exact continuous_finset_sum _ fun i _ =>
      ((hFg i).1.continuous_fderiv (by simp)).clm_apply continuous_const
  have hsupp : tsupport (sepDensDiv G X) ⊆ tsupport X := by
    refine closure_minimal (fun y hy => ?_) hKc
    by_contra hyK
    apply hy
    show ∑ i : Fin 3, partialDeriv i (fun z => Real.sqrt (G z).det * X z i) y = 0
    exact Finset.sum_eq_zero fun i _ => (hFg i).2 y hyK i
  refine ⟨hcont, hsupp, ?_⟩
  
  have hI := fun i => tC T hT v _ hv (hFT i) (tsupport X) hKcpt hKT (hF0 i) i
  have hint : ∫ y, v y * sepDensDiv G X y =
      ∫ y, -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i)) := by
    calc ∫ y, v y * sepDensDiv G X y
        = ∫ y, ∑ i : Fin 3, v y * partialDeriv i
            (fun z => Real.sqrt (G z).det * X z i) y := by
          congr 1; funext y; simp only [sepDensDiv, Finset.mul_sum]
      _ = ∑ i : Fin 3, ∫ y, v y * partialDeriv i
            (fun z => Real.sqrt (G z).det * X z i) y :=
          integral_finset_sum _ fun i _ => (hI i).1
      _ = ∑ i : Fin 3, -∫ y, partialDeriv i v y * (Real.sqrt (G y).det * X y i) :=
          Finset.sum_congr rfl fun i _ => (hI i).2.2
      _ = -∑ i : Fin 3, ∫ y, partialDeriv i v y * (Real.sqrt (G y).det * X y i) :=
          Finset.sum_neg_distrib _
      _ = -∫ y, ∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i) := by
          rw [integral_finset_sum _ fun i _ => (hI i).2.1]
      _ = ∫ y, -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i)) :=
          (integral_neg _).symm
  have hhint : Integrable
      (fun y => -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i))) :=
    (integrable_finset_sum _ fun i _ => (hI i).2.1).neg
  
  have hle : ∀ y ∈ tsupport X,
      -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i)) ≤
      Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i v y * partialDeriv j v y) * Real.sqrt (G y).det := by
    intro y hy
    have hyT := hKT hy
    have hcs := tD (G y) (hpd y hyT) (fun i => partialDeriv i v y) (fun i => X y i)
    beta_reduce at hcs
    have hq : Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j) ≤ 1 := by
      rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt (hXn y)
    have hd : 0 ≤ Real.sqrt (G y).det := Real.sqrt_nonneg _
    have hhy : -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i)) =
        Real.sqrt (G y).det * -(∑ i : Fin 3, partialDeriv i v y * X y i) := by
      simp only [Fin.sum_univ_three]; ring
    rw [hhy]
    calc Real.sqrt (G y).det * -(∑ i : Fin 3, partialDeriv i v y * X y i)
        ≤ Real.sqrt (G y).det * (Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
            (G y)⁻¹ i j * partialDeriv i v y * partialDeriv j v y) *
            Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j)) :=
          mul_le_mul_of_nonneg_left ((neg_le_abs _).trans hcs) hd
      _ ≤ Real.sqrt (G y).det * (Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
            (G y)⁻¹ i j * partialDeriv i v y * partialDeriv j v y) * 1) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hq (Real.sqrt_nonneg _)) hd
      _ = _ := by ring
  have h0 : ∀ y, y ∉ tsupport X →
      -(∑ i : Fin 3, partialDeriv i v y * (Real.sqrt (G y).det * X y i)) = 0 := by
    intro y hy
    simp only [hX0 y hy, mul_zero, Finset.sum_const_zero, neg_zero]
  
  rw [hint]
  exact tE _ _ (tsupport X) U hhint hKc hXU hle h0

theorem sep_dominated_limit (T F : Set E3) (hT : IsOpen T) (hF : MeasurableSet F) (d : E3 → ℝ)
    (hdc : Continuous d) (hdcs : HasCompactSupport d) (hdT : tsupport d ⊆ T)
    (v : ℕ → E3 → ℝ) (hvc : ∀ m, ContinuousOn (v m) T) (hv1 : ∀ m y, |v m y| ≤ 1)
    (hlim : ∀ y ∈ T, Tendsto (fun m => v m y) atTop (𝓝 (F.indicator (fun _ => (1 : ℝ)) y))) :
    Tendsto (fun m => ∫ y, v m y * d y) atTop (𝓝 (∫ y in F, d y)) :=
by
  have hzero : ∀ y, y ∉ T → d y = 0 := fun y hy =>
    image_eq_zero_of_notMem_tsupport (fun h => hy (hdT h))
  have hcont : ∀ m, Continuous (fun y => v m y * d y) := by
    intro m
    rw [continuous_iff_continuousAt]
    intro x
    by_cases hx : x ∈ T
    · exact ((hvc m).continuousAt (hT.mem_nhds hx)).mul hdc.continuousAt
    · have hxs : x ∉ tsupport d := fun h => hx (hdT h)
      have hev : d =ᶠ[𝓝 x] 0 := (notMem_tsupport_iff_eventuallyEq).1 hxs
      refine (continuousAt_const (y := (0 : ℝ))).congr ?_
      filter_upwards [hev] with y hy
      simp only [Pi.zero_apply] at hy
      simp [hy]
  have hdint : Integrable d := hdc.integrable_of_hasCompactSupport hdcs
  have hDCT : Tendsto (fun m => ∫ y, v m y * d y) atTop (𝓝 (∫ y, F.indicator d y)) := by
    refine tendsto_integral_of_dominated_convergence (fun y => |d y|)
      (fun m => (hcont m).aestronglyMeasurable) hdint.abs ?_ ?_
    · intro m
      refine ae_of_all _ (fun y => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg (d y)) (hv1 m y)
    · refine ae_of_all _ (fun y => ?_)
      by_cases hy : y ∈ T
      · have h := (hlim y hy).mul_const (d y)
        have heq : F.indicator (fun _ => (1 : ℝ)) y * d y = F.indicator d y := by
          by_cases hyF : y ∈ F
          · simp [Set.indicator_of_mem hyF]
          · simp [Set.indicator_of_notMem hyF]
        rwa [heq] at h
      · have hd0 : d y = 0 := hzero y hy
        have hi : F.indicator d y = 0 := by
          by_cases hyF : y ∈ F
          · simp [Set.indicator_of_mem hyF, hd0]
          · simp [Set.indicator_of_notMem hyF]
        rw [hi]
        simp only [hd0, mul_zero]
        exact tendsto_const_nhds
  rwa [integral_indicator hF] at hDCT

theorem sep_chart_transition [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p₁ p₂ : M)
    (y : E3) (hy : y ∈ (chartAt E3 p₁).target)
    (hy₂ : (chartAt E3 p₁).symm y ∈ (chartAt E3 p₂).source) :
    DifferentiableAt ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y ∧
    (∀ i j : Fin 3, g.coeff (chartAt E3 p₁).symm y i j = ∑ a : Fin 3, ∑ b : Fin 3,
      fderiv ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y (e i) a *
        g.coeff (chartAt E3 p₂).symm (chartAt E3 p₂ ((chartAt E3 p₁).symm y)) a b *
        fderiv ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y (e j) b) ∧
    (∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ i : Fin 3,
      partialDeriv i (fun z => u ((chartAt E3 p₁).symm z)) y = ∑ a : Fin 3,
        fderiv ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y (e i) a *
          partialDeriv a (fun z => u ((chartAt E3 p₂).symm z))
            (chartAt E3 p₂ ((chartAt E3 p₁).symm y))) :=
by
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    ext k
    simp [EuclideanSpace.single_apply, Pi.single_apply]
  
  have cca : ∀ (Φ : E3 → M) (τ : E3 → E3) (y : E3), DifferentiableAt ℝ τ y →
      MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y) → ∀ i j : Fin 3,
      g.coeff (Φ ∘ τ) y i j = ∑ a : Fin 3, ∑ b : Fin 3,
        fderiv ℝ τ y (e i) a * g.coeff Φ (τ y) a b * fderiv ℝ τ y (e j) b := by
    intro Φ τ y hτ hΦ i j
    set L : E3 →L[ℝ] E3 := mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ (τ y) with hLdef
    set B : E3 →L[ℝ] E3 →L[ℝ] ℝ := g.g (Φ (τ y)) with hBdef
    have hL : ∀ v : E3, L v = ∑ a : Fin 3, v a • L (e a) := by
      intro v
      conv_lhs => rw [hexp v]
      rw [map_sum]
      simp only [map_smul]
    have hchain : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y v = L (fderiv ℝ τ y v) := by
      intro v
      rw [mfderiv_comp_apply y hΦ hτ.mdifferentiableAt, mfderiv_eq_fderiv]
      rfl
    have hlhs : g.coeff (Φ ∘ τ) y i j = B (L (fderiv ℝ τ y (e i))) (L (fderiv ℝ τ y (e j))) := by
      show g.g (Φ (τ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (Φ ∘ τ) y (e j)) = _
      rw [hchain, hchain]
    have hc : ∀ a b : Fin 3, g.coeff Φ (τ y) a b = B (L (e a)) (L (e b)) := fun a b => rfl
    rw [hlhs, hL (fderiv ℝ τ y (e i)), hL (fderiv ℝ τ y (e j))]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Finset.mul_sum, hc]
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    ring
  
  have hA : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₁).symm y :=
    mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₁) hy
  have hB : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₂) ((chartAt E3 p₁).symm y) :=
    mdifferentiableAt_atlas (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₂) hy₂
  have hτ : DifferentiableAt ℝ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) y :=
    mdifferentiableAt_iff_differentiableAt.mp (hB.comp y hA)
  have hΦ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p₂).symm
      (chartAt E3 p₂ ((chartAt E3 p₁).symm y)) :=
    mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 p₂)
      ((chartAt E3 p₂).map_source hy₂)
  have hev : ∀ᶠ z in 𝓝 y, (chartAt E3 p₂).symm (chartAt E3 p₂ ((chartAt E3 p₁).symm z)) =
      (chartAt E3 p₁).symm z := by
    have hO := (chartAt E3 p₁).isOpen_inter_preimage_symm (chartAt E3 p₂).open_source
    exact Filter.eventually_of_mem (hO.mem_nhds ⟨hy, hy₂⟩)
      (fun z hz => (chartAt E3 p₂).left_inv hz.2)
  refine ⟨hτ, ?_, ?_⟩
  · intro i j
    have hfun : (⇑(chartAt E3 p₂).symm ∘ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)))
        =ᶠ[𝓝 y] ⇑(chartAt E3 p₁).symm := hev
    have hmf := hfun.mfderiv_eq (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, E3))
    have hpt : (⇑(chartAt E3 p₂).symm ∘ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y =
        (chartAt E3 p₁).symm y := (chartAt E3 p₂).left_inv hy₂
    have key : g.coeff (chartAt E3 p₁).symm y i j =
        g.coeff (⇑(chartAt E3 p₂).symm ∘ (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y i j := by
      show _ = g.g ((⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑(chartAt E3 p₂).symm ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) y (e j))
      rw [hmf, hpt]
      rfl
    rw [key]
    exact cca _ _ y hτ hΦ i j
  · intro u hu i
    have hc : ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 p₂).symm z)) (chartAt E3 p₂).target :=
      contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
    have hd₂ : DifferentiableAt ℝ (fun z => u ((chartAt E3 p₂).symm z))
        (chartAt E3 p₂ ((chartAt E3 p₁).symm y)) :=
      (hc.differentiableOn (by simp)).differentiableAt
        ((chartAt E3 p₂).open_target.mem_nhds ((chartAt E3 p₂).map_source hy₂))
    have hU : (fun z => u ((chartAt E3 p₁).symm z)) =ᶠ[𝓝 y]
        ((fun z => u ((chartAt E3 p₂).symm z)) ∘
          (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))) := by
      filter_upwards [hev] with z hz
      simp only [Function.comp_apply]
      rw [hz]
    have hL : ∀ (L : E3 →L[ℝ] ℝ) (v : E3), L v = ∑ a : Fin 3, v a * L (e a) := by
      intro L v
      conv_lhs => rw [hexp v]
      simp [map_sum, map_smul, smul_eq_mul]
    have hcomp := fderiv_comp y hd₂ hτ
    unfold partialDeriv
    rw [hU.fderiv_eq, hcomp, ContinuousLinearMap.comp_apply]
    exact hL _ _

theorem sep_quadform_congr (J G₂ : Matrix (Fin 3) (Fin 3) ℝ) (hJ : J.det ≠ 0) (b : Fin 3 → ℝ) :
    ∑ i : Fin 3, ∑ j : Fin 3, (J.transpose * G₂ * J)⁻¹ i j * (∑ a : Fin 3, J a i * b a) *
        (∑ a : Fin 3, J a j * b a) =
      ∑ a : Fin 3, ∑ c : Fin 3, G₂⁻¹ a c * b a * b c :=
by
  have key : ∀ (M : Matrix (Fin 3) (Fin 3) ℝ) (v : Fin 3 → ℝ),
      ∑ i : Fin 3, ∑ j : Fin 3, M i j * v i * v j = dotProduct v (M.mulVec v) := by
    intro M v
    simp only [dotProduct, Matrix.mulVec, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
  have hv : ∀ i : Fin 3, ∑ a : Fin 3, J a i * b a = J.transpose.mulVec b i := by
    intro i
    simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply]
  have hdet : IsUnit J.det := isUnit_iff_ne_zero.mpr hJ
  have hdetT : IsUnit J.transpose.det := by
    rw [Matrix.det_transpose]; exact hdet
  have hinv : (J.transpose * G₂ * J)⁻¹ = J⁻¹ * G₂⁻¹ * (J.transpose)⁻¹ := by
    rw [Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.mul_assoc]
  simp only [hv]
  rw [key, key, hinv, Matrix.mulVec_mulVec, Matrix.mul_assoc (J⁻¹ * G₂⁻¹),
    Matrix.nonsing_inv_mul _ hdetT, Matrix.mul_one, ← Matrix.mulVec_mulVec,
    Matrix.dotProduct_mulVec, Matrix.mulVec_transpose, Matrix.vecMul_vecMul,
    Matrix.mul_nonsing_inv _ hdet, Matrix.vecMul_one]

theorem sep_density_change (s : Set E3) (hs : MeasurableSet s) (τ : E3 → E3)
    (hτ : ∀ y ∈ s, DifferentiableAt ℝ τ y) (hinj : Set.InjOn τ s)
    (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hlaw : ∀ y ∈ s, ∀ i j : Fin 3, G₁ y i j = ∑ a : Fin 3, ∑ b : Fin 3,
      fderiv ℝ τ y (e i) a * G₂ (τ y) a b * fderiv ℝ τ y (e j) b)
    (hpos : ∀ y ∈ s, 0 ≤ (G₂ (τ y)).det) (ψ : E3 → ENNReal) :
    ∫⁻ z in τ '' s, ψ z * ENNReal.ofReal (Real.sqrt (G₂ z).det) =
      ∫⁻ y in s, ψ (τ y) * ENNReal.ofReal (Real.sqrt (G₁ y).det) :=
by
  have hdet : ∀ f : E3 →L[ℝ] E3, f.det = (Matrix.of fun a i : Fin 3 => f (e i) a).det := by
    intro f
    rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
    congr 1
  have hsq : ∀ (J A B : Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, A i j = ∑ a : Fin 3, ∑ b : Fin 3, J a i * B a b * J b j) →
      Real.sqrt A.det = |J.det| * Real.sqrt B.det := by
    intro J A B h
    have hA : A = J.transpose * B * J := by
      ext i j
      rw [h i j]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      exact Finset.sum_comm
    rw [hA, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose,
      show J.det * B.det * J.det = J.det ^ 2 * B.det by ring,
      Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  have hcov := MeasureTheory.lintegral_image_eq_lintegral_abs_det_fderiv_mul volume hs
    (fun y hy => (hτ y hy).hasFDerivAt.hasFDerivWithinAt) hinj
    (fun z => ψ z * ENNReal.ofReal (Real.sqrt (G₂ z).det))
  rw [hcov]
  refine MeasureTheory.setLIntegral_congr_fun hs ?_
  intro y hy
  have h1 := hsq (Matrix.of fun a i : Fin 3 => fderiv ℝ τ y (e i) a) (G₁ y) (G₂ (τ y))
    (fun i j => by simp only [Matrix.of_apply]; exact hlaw y hy i j)
  simp only
  rw [h1, ← hdet, ENNReal.ofReal_mul (abs_nonneg _)]
  ring

theorem sep_cover_sum (w : M → E3 → ENNReal) (φ : M → ENNReal)
    (htrans : ∀ (p₁ p₂ : M) (S : Set M),
      S ⊆ (chartAt E3 p₁).source ∩ (chartAt E3 p₂).source →
      MeasurableSet (chartAt E3 p₁ '' S) → MeasurableSet (chartAt E3 p₂ '' S) →
      ∫⁻ y in chartAt E3 p₁ '' S, φ ((chartAt E3 p₁).symm y) * w p₁ y =
        ∫⁻ y in chartAt E3 p₂ '' S, φ ((chartAt E3 p₂).symm y) * w p₂ y)
    (m : ℕ) (q : Fin m → M) (V : Fin m → Set M)
    (hV : ∀ j, IsOpen (V j) ∧ V j ⊆ (chartAt E3 (q j)).source)
    (hφ : ∀ x, x ∉ ⋃ j, V j → φ x = 0)
    (n : ℕ) (p : Fin n → M) (W : Fin n → Set M)
    (hW : ∀ k, IsOpen (W k) ∧ W k ⊆ (chartAt E3 (p k)).source)
    (hdisj : Pairwise fun k l => Disjoint (W k) (W l)) :
    ∑ k, ∫⁻ y in chartAt E3 (p k) '' W k, φ ((chartAt E3 (p k)).symm y) * w (p k) y ≤
      ∑ j, ∫⁻ y in chartAt E3 (q j) '' V j, φ ((chartAt E3 (q j)).symm y) * w (q j) y :=
by
  
  have s1 : ∀ (p₀ : M) (F : E3 → ENNReal) (W₀ : Set M), IsOpen W₀ →
      W₀ ⊆ (chartAt E3 p₀).source →
      (∀ x ∈ W₀, x ∉ ⋃ j, V j → F (chartAt E3 p₀ x) = 0) →
      ∫⁻ y in chartAt E3 p₀ '' W₀, F y ≤
        ∑ j, ∫⁻ y in chartAt E3 p₀ '' (W₀ ∩ V j), F y := by
    intro p₀ F W₀ hWo hWs hF
    have hUo : IsOpen (⋃ j, V j) := isOpen_iUnion fun j => (hV j).1
    have hZ : MeasurableSet (chartAt E3 p₀ '' (W₀ \ ⋃ j, V j)) := by
      rw [((chartAt E3 p₀).injOn.mono hWs).image_diff]
      exact ((chartAt E3 p₀).isOpen_image_of_subset_source hWo hWs).measurableSet.diff
        ((chartAt E3 p₀).isOpen_image_of_subset_source (hWo.inter hUo)
          (Set.inter_subset_left.trans hWs)).measurableSet
    have hsub : chartAt E3 p₀ '' W₀ ⊆
        (⋃ j, chartAt E3 p₀ '' (W₀ ∩ V j)) ∪ chartAt E3 p₀ '' (W₀ \ ⋃ j, V j) := by
      rintro _ ⟨x, hx, rfl⟩
      by_cases hxU : x ∈ ⋃ j, V j
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 hxU
        exact Or.inl (Set.mem_iUnion.2 ⟨j, x, ⟨hx, hj⟩, rfl⟩)
      · exact Or.inr ⟨x, ⟨hx, hxU⟩, rfl⟩
    have hZ0 : ∫⁻ y in chartAt E3 p₀ '' (W₀ \ ⋃ j, V j), F y = 0 := by
      have h : ∫⁻ y in chartAt E3 p₀ '' (W₀ \ ⋃ j, V j), F y =
          ∫⁻ y in chartAt E3 p₀ '' (W₀ \ ⋃ j, V j), (0 : ENNReal) := by
        apply setLIntegral_congr_fun hZ
        rintro _ ⟨x, ⟨hx, hxU⟩, rfl⟩
        exact hF x hx hxU
      rw [h, lintegral_zero]
    calc ∫⁻ y in chartAt E3 p₀ '' W₀, F y
        ≤ ∫⁻ y in (⋃ j, chartAt E3 p₀ '' (W₀ ∩ V j)) ∪ chartAt E3 p₀ '' (W₀ \ ⋃ j, V j), F y :=
          lintegral_mono_set hsub
      _ ≤ (∫⁻ y in ⋃ j, chartAt E3 p₀ '' (W₀ ∩ V j), F y) +
            (∫⁻ y in chartAt E3 p₀ '' (W₀ \ ⋃ j, V j), F y) :=
          lintegral_union_le _ _ _
      _ ≤ (∑' j, ∫⁻ y in chartAt E3 p₀ '' (W₀ ∩ V j), F y) + 0 := by
          rw [hZ0, add_zero, add_zero]
          exact lintegral_iUnion_le (fun j : Fin m => chartAt E3 p₀ '' (W₀ ∩ V j)) F
      _ = ∑ j, ∫⁻ y in chartAt E3 p₀ '' (W₀ ∩ V j), F y := by
          rw [add_zero, tsum_fintype]
  
  have s2 : ∀ (q₀ : M) (F : E3 → ENNReal) (V₀ : Set M), V₀ ⊆ (chartAt E3 q₀).source →
      ∀ S : Fin n → Set M, (∀ k, IsOpen (S k)) → (∀ k, S k ⊆ V₀) →
      Pairwise (fun k l => Disjoint (S k) (S l)) →
      ∑ k, ∫⁻ y in chartAt E3 q₀ '' S k, F y ≤ ∫⁻ y in chartAt E3 q₀ '' V₀, F y := by
    intro q₀ F V₀ hVs S hSo hSV hSd
    have hmeas : ∀ k, MeasurableSet (chartAt E3 q₀ '' S k) := fun k =>
      ((chartAt E3 q₀).isOpen_image_of_subset_source (hSo k) ((hSV k).trans hVs)).measurableSet
    have hd : Pairwise (Function.onFun Disjoint fun k => chartAt E3 q₀ '' S k) := by
      intro k l hkl
      rw [Function.onFun, Set.disjoint_left]
      rintro _ ⟨x, hx, rfl⟩ ⟨x', hx', hxx'⟩
      have hx'x : x' = x :=
        (chartAt E3 q₀).injOn ((hSV l).trans hVs hx') ((hSV k).trans hVs hx) hxx'
      subst hx'x
      exact Set.disjoint_left.1 (hSd hkl) hx hx'
    calc ∑ k, ∫⁻ y in chartAt E3 q₀ '' S k, F y
        = ∑' k, ∫⁻ y in chartAt E3 q₀ '' S k, F y := (tsum_fintype _).symm
      _ = ∫⁻ y in ⋃ k, chartAt E3 q₀ '' S k, F y := (lintegral_iUnion hmeas hd F).symm
      _ ≤ ∫⁻ y in chartAt E3 q₀ '' V₀, F y :=
          lintegral_mono_set (Set.iUnion_subset fun k => Set.image_mono (hSV k))
  calc ∑ k, ∫⁻ y in chartAt E3 (p k) '' W k, φ ((chartAt E3 (p k)).symm y) * w (p k) y
      ≤ ∑ k, ∑ j, ∫⁻ y in chartAt E3 (p k) '' (W k ∩ V j),
          φ ((chartAt E3 (p k)).symm y) * w (p k) y := by
        refine Finset.sum_le_sum fun k _ => ?_
        refine s1 (p k) (fun y => φ ((chartAt E3 (p k)).symm y) * w (p k) y) (W k) (hW k).1
          (hW k).2 ?_
        intro x hx hxU
        simp only [(chartAt E3 (p k)).left_inv ((hW k).2 hx), hφ x hxU, zero_mul]
    _ = ∑ k, ∑ j, ∫⁻ y in chartAt E3 (q j) '' (W k ∩ V j),
          φ ((chartAt E3 (q j)).symm y) * w (q j) y := by
        refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
        exact htrans (p k) (q j) (W k ∩ V j)
          (Set.subset_inter (Set.inter_subset_left.trans (hW k).2)
            (Set.inter_subset_right.trans (hV j).2))
          ((chartAt E3 (p k)).isOpen_image_of_subset_source ((hW k).1.inter (hV j).1)
            (Set.inter_subset_left.trans (hW k).2)).measurableSet
          ((chartAt E3 (q j)).isOpen_image_of_subset_source ((hW k).1.inter (hV j).1)
            (Set.inter_subset_right.trans (hV j).2)).measurableSet
    _ = ∑ j, ∑ k, ∫⁻ y in chartAt E3 (q j) '' (W k ∩ V j),
          φ ((chartAt E3 (q j)).symm y) * w (q j) y := Finset.sum_comm
    _ ≤ ∑ j, ∫⁻ y in chartAt E3 (q j) '' V j, φ ((chartAt E3 (q j)).symm y) * w (q j) y :=
        Finset.sum_le_sum fun j _ =>
          s2 (q j) (fun y => φ ((chartAt E3 (q j)).symm y) * w (q j) y) (V j) (hV j).2
            (fun k => W k ∩ V j) (fun k => (hW k).1.inter (hV j).1)
            (fun k => Set.inter_subset_right)
            (fun k l hkl => (hdisj hkl).mono Set.inter_subset_left Set.inter_subset_left)

theorem sep_shell_bound (T Q : Set E3) (hT : IsOpen T) (hQ : IsCompact Q) (hQT : Q ⊆ T)
    (f : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f T) (r₁ : ℝ)
    (hgrad : ∀ y ∈ T, r₁ ≤ f y → ∃ i : Fin 3, partialDeriv i f y ≠ 0) :
    ∃ C : ℝ, ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
      ∫⁻ y in Q, ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
        ((f y - r₁) / ε)) ≤ ENNReal.ofReal C :=
by
  
  have hh_smooth : ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition (2 * t - 1)) :=
    Real.smoothTransition.contDiff.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)
  have hh01 : ∀ t : ℝ, 0 ≤ Real.smoothTransition (2 * t - 1) ∧
      Real.smoothTransition (2 * t - 1) ≤ 1 :=
    fun t => ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hhd0 : ∀ t : ℝ, 0 ≤ deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) t := by
    intro t
    apply Monotone.deriv_nonneg
    intro a b hab
    exact Real.smoothTransition.monotone (by linarith)
  have hhdz : ∀ t : ℝ, t ≤ 0 → deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) t = 0 := by
    intro t ht
    have hev : (fun t : ℝ => Real.smoothTransition (2 * t - 1)) =ᶠ[𝓝 t] fun _ => (0 : ℝ) := by
      filter_upwards [Iio_mem_nhds (show t < 1 / 2 by linarith)] with s hs
      have hs' : s < 1 / 2 := hs
      exact Real.smoothTransition.zero_of_nonpos (by linarith)
    rw [hev.deriv_eq]
    simp
  
  have hloc : ∀ u w : E3 → ℝ, ContDiffOn ℝ ∞ u T → ContDiff ℝ ∞ w → tsupport w ⊆ T →
      ContDiff ℝ ∞ (fun y => u y * w y) := by
    intro u w hu hw hwT
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ T
    · exact (hu.contDiffAt (hT.mem_nhds hy)).mul hw.contDiffAt
    · have hy' : y ∉ tsupport w := fun h => hy (hwT h)
      have hev : w =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 hy'
      have hev2 : (fun y => u y * w y) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [hev] with z hz
        simp [hz]
      exact contDiffAt_const.congr_of_eventuallyEq hev2
  have hpd0 : ∀ (w : E3 → ℝ) (y : E3), y ∉ tsupport w → ∀ i, partialDeriv i w y = 0 := by
    intro w y hy i
    have hev : w =ᶠ[𝓝 y] fun _ => (0 : ℝ) := notMem_tsupport_iff_eventuallyEq.1 hy
    have hd : HasFDerivAt w (0 : E3 →L[ℝ] ℝ) y :=
      (hasFDerivAt_const (0 : ℝ) y).congr_of_eventuallyEq hev
    simp [partialDeriv, hd.fderiv]
  
  have hibp : ∀ v w : E3 → ℝ, ContDiffOn ℝ ∞ v T → ContDiff ℝ ∞ w → HasCompactSupport w →
      tsupport w ⊆ T → ∀ i : Fin 3,
      Integrable (fun y => partialDeriv i v y * w y) ∧
      Integrable (fun y => v y * partialDeriv i w y) ∧
      ∫ y, partialDeriv i v y * w y = -∫ y, v y * partialDeriv i w y := by
    intro v w hv hw hwc hwT i
    have hP : ContDiff ℝ ∞ (fun y => v y * w y) := hloc v w hv hw hwT
    have hPc : HasCompactSupport (fun y => v y * w y) := hwc.mul_left
    have hprod : ∀ y, partialDeriv i (fun y => v y * w y) y =
        partialDeriv i v y * w y + v y * partialDeriv i w y := by
      intro y
      by_cases hy : y ∈ T
      · have hvd : DifferentiableAt ℝ v y :=
          (hv.contDiffAt (hT.mem_nhds hy)).differentiableAt (by simp)
        have hwd : DifferentiableAt ℝ w y := hw.contDiffAt.differentiableAt (by simp)
        simp only [partialDeriv]
        change fderiv ℝ (v * w) y (e i) = _
        rw [(hvd.hasFDerivAt.mul hwd.hasFDerivAt).fderiv]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      · have hy' : y ∉ tsupport w := fun h => hy (hwT h)
        have hy'' : y ∉ tsupport (fun y => v y * w y) :=
          fun h => hy' (tsupport_mul_subset_right h)
        rw [hpd0 _ y hy'' i, hpd0 w y hy' i, image_eq_zero_of_notMem_tsupport hy']
        ring
    have hcont1 : Continuous (fun y => partialDeriv i v y * w y) := by
      rw [continuous_iff_continuousAt]
      intro y
      by_cases hy : y ∈ T
      · have h1 : ContinuousAt (fderiv ℝ v) y :=
          (hv.continuousOn_fderiv_of_isOpen hT (by simp)).continuousAt (hT.mem_nhds hy)
        have h2 : ContinuousAt (fun y => partialDeriv i v y) y := by
          show ContinuousAt (fun y => fderiv ℝ v y (e i)) y
          exact h1.clm_apply continuousAt_const
        exact h2.mul hw.continuous.continuousAt
      · have hy' : y ∉ tsupport w := fun h => hy (hwT h)
        have hev : (fun y => partialDeriv i v y * w y) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [notMem_tsupport_iff_eventuallyEq.1 hy'] with z hz
          simp [hz]
        exact continuousAt_const.congr hev.symm
    have hint1 : Integrable (fun y => partialDeriv i v y * w y) :=
      hcont1.integrable_of_hasCompactSupport hwc.mul_left
    have hdPc : Continuous (fun y => partialDeriv i (fun y => v y * w y) y) := by
      show Continuous (fun y => fderiv ℝ (fun y => v y * w y) y (e i))
      exact (hP.continuous_fderiv (by simp)).clm_apply continuous_const
    have hdP_int : Integrable (fun y => partialDeriv i (fun y => v y * w y) y) :=
      hdPc.integrable_of_hasCompactSupport (hPc.fderiv_apply ℝ (e i))
    have hint2 : Integrable (fun y => v y * partialDeriv i w y) := by
      refine (hdP_int.sub hint1).congr (Eventually.of_forall fun y => ?_)
      simp only [Pi.sub_apply, hprod y]
      ring
    have hzero : ∫ y, partialDeriv i (fun y => v y * w y) y = 0 := by
      have h1 : Integrable
          (fun x => fderiv ℝ (fun y => v y * w y) x (e i) * (fun _ => (1 : ℝ)) x) := by
        simpa [partialDeriv] using hdP_int
      have h2 : Integrable
          (fun x => (fun y => v y * w y) x * fderiv ℝ (fun _ => (1 : ℝ)) x (e i)) := by
        simp
      have h3 : Integrable (fun x => (fun y => v y * w y) x * (fun _ => (1 : ℝ)) x) := by
        simpa using hP.continuous.integrable_of_hasCompactSupport hPc
      have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume) h1 h2 h3
        (hP.differentiable (by simp)) (differentiable_const _)
      have hl : ∫ x, (fun y => v y * w y) x * fderiv ℝ (fun _ => (1 : ℝ)) x (e i) = 0 := by
        simp
      have hr : ∫ x, fderiv ℝ (fun y => v y * w y) x (e i) * (fun _ => (1 : ℝ)) x =
          ∫ y, partialDeriv i (fun y => v y * w y) y := by simp [partialDeriv]
      rw [hl, hr] at key
      linarith
    have hsum : ∫ y, partialDeriv i (fun y => v y * w y) y =
        (∫ y, partialDeriv i v y * w y) + ∫ y, v y * partialDeriv i w y :=
      (integral_congr_ae (Eventually.of_forall fun y => hprod y)).trans
        (integral_add hint1 hint2)
    refine ⟨hint1, hint2, ?_⟩
    exact eq_neg_of_add_eq_zero_left (hsum.symm.trans hzero)
  
  have hfd : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun y => partialDeriv i f y) T := by
    intro i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) T :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hT).1 hf).2
    exact h1.clm_apply contDiffOn_const
  
  obtain ⟨c₀, hc₀, hc₀le⟩ : ∃ c₀ : ℝ, 0 < c₀ ∧
      ∀ y ∈ Q, r₁ ≤ f y → c₀ ≤ ∑ i : Fin 3, (partialDeriv i f y) ^ 2 := by
    have hcont : ContinuousOn
        (fun y => ∑ i : Fin 3, (partialDeriv i f y) ^ 2 + max 0 (r₁ - f y)) Q := by
      refine ContinuousOn.mono ?_ hQT
      refine ContinuousOn.add ?_ ?_
      · exact continuousOn_finset_sum _ fun i _ => ((hfd i).continuousOn).pow 2
      · exact (continuous_const.max continuous_id).comp_continuousOn
          (continuousOn_const.sub hf.continuousOn)
    obtain ⟨a', ha', hle⟩ := hQ.exists_forall_le' hcont (a := 0) (by
      intro y hy
      by_cases hr : r₁ ≤ f y
      · obtain ⟨i, hi⟩ := hgrad y (hQT hy) hr
        have h1 : 0 < (partialDeriv i f y) ^ 2 :=
          lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hi))
        have h2 : (partialDeriv i f y) ^ 2 ≤ ∑ j : Fin 3, (partialDeriv j f y) ^ 2 :=
          Finset.single_le_sum (f := fun j => (partialDeriv j f y) ^ 2)
            (fun j _ => sq_nonneg _) (Finset.mem_univ i)
        have h3 : 0 ≤ max 0 (r₁ - f y) := le_max_left _ _
        show 0 < ∑ i : Fin 3, (partialDeriv i f y) ^ 2 + max 0 (r₁ - f y)
        linarith
      · have h1 : 0 ≤ ∑ j : Fin 3, (partialDeriv j f y) ^ 2 :=
          Finset.sum_nonneg fun j _ => sq_nonneg _
        have h2 : r₁ - f y ≤ max 0 (r₁ - f y) := le_max_right _ _
        push_neg at hr
        show 0 < ∑ i : Fin 3, (partialDeriv i f y) ^ 2 + max 0 (r₁ - f y)
        linarith)
    refine ⟨a', ha', fun y hy hr => ?_⟩
    have h := hle y hy
    have h0 : max 0 (r₁ - f y) = 0 := max_eq_left (by linarith)
    simp only [h0, add_zero] at h
    exact h
  
  obtain ⟨δ, hδ, hδT⟩ := hQ.exists_cthickening_subset_open hT hQT
  obtain ⟨F, hF1, hF0, hF01⟩ := exists_contMDiffMap_one_nhds_of_subset_interior 𝓘(ℝ, E3)
    (n := (⊤ : ℕ∞)) (s := Q) (t := Metric.thickening δ Q) hQ.isClosed
    (by rw [Metric.isOpen_thickening.interior_eq]; exact Metric.self_subset_thickening hδ Q)
  obtain ⟨χ, hχdef⟩ : ∃ χ : E3 → ℝ, χ = ⇑F := ⟨_, rfl⟩
  have hχs : ContDiff ℝ ∞ χ := by
    rw [hχdef]
    exact contMDiff_iff_contDiff.mp F.contMDiff
  have hχ01 : ∀ y, 0 ≤ χ y ∧ χ y ≤ 1 := fun y => by rw [hχdef]; exact hF01 y
  have hχQ : ∀ y ∈ Q, χ y = 1 := fun y hy => by rw [hχdef]; exact hF1.self_of_nhdsSet y hy
  have hχsupp : tsupport χ ⊆ Metric.cthickening δ Q := by
    refine closure_minimal ?_ Metric.isClosed_cthickening
    intro y hy
    by_contra hy'
    apply hy
    rw [hχdef]
    exact hF0 y (fun h => hy' (Metric.thickening_subset_cthickening δ Q h))
  have hχT : tsupport χ ⊆ T := hχsupp.trans hδT
  have hχc : HasCompactSupport χ :=
    (hQ.cthickening).of_isClosed_subset (isClosed_tsupport _) hχsupp
  
  have hw : ∀ i : Fin 3, ContDiff ℝ ∞ (fun y => partialDeriv i f y * χ y) :=
    fun i => hloc _ _ (hfd i) hχs hχT
  have hwc : ∀ i : Fin 3, HasCompactSupport (fun y => partialDeriv i f y * χ y) :=
    fun i => hχc.mul_left
  have hwT : ∀ i : Fin 3, tsupport (fun y => partialDeriv i f y * χ y) ⊆ T :=
    fun i => tsupport_mul_subset_right.trans hχT
  have hwi_int : ∀ i : Fin 3,
      Integrable (fun y => partialDeriv i (fun y => partialDeriv i f y * χ y) y) := by
    intro i
    have hc : Continuous (fun y => partialDeriv i (fun y => partialDeriv i f y * χ y) y) := by
      show Continuous (fun y => fderiv ℝ (fun y => partialDeriv i f y * χ y) y (e i))
      exact ((hw i).continuous_fderiv (by simp)).clm_apply continuous_const
    exact hc.integrable_of_hasCompactSupport ((hwc i).fderiv_apply ℝ (e i))
  
  have hchain : ∀ ε : ℝ, ∀ y ∈ T, ∀ i : Fin 3,
      partialDeriv i (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y =
        ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((f y - r₁) / ε) *
          partialDeriv i f y := by
    intro ε y hy i
    have hfd' : HasFDerivAt f (fderiv ℝ f y) y :=
      ((hf.contDiffAt (hT.mem_nhds hy)).differentiableAt (by simp)).hasFDerivAt
    have hg : HasFDerivAt (fun z => (f z - r₁) / ε) (ε⁻¹ • fderiv ℝ f y) y := by
      have h1 := (hfd'.sub_const r₁).const_mul ε⁻¹
      convert h1 using 1
      funext z
      rw [div_eq_inv_mul]
    have hh : HasDerivAt (fun t : ℝ => Real.smoothTransition (2 * t - 1))
        (deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((f y - r₁) / ε))
        ((f y - r₁) / ε) :=
      ((hh_smooth.differentiable (by simp)) _).hasDerivAt
    have hcomp := hh.comp_hasFDerivAt y hg
    show fderiv ℝ ((fun t : ℝ => Real.smoothTransition (2 * t - 1)) ∘
      (fun z => (f z - r₁) / ε)) y (e i) = _
    rw [hcomp.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul, partialDeriv]
    ring
  
  refine ⟨c₀⁻¹ * ∑ i : Fin 3, ∫ y, |partialDeriv i (fun y => partialDeriv i f y * χ y) y|, ?_⟩
  intro ε hε _hε1
  have hHs : ContDiffOn ℝ ∞ (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) T :=
    hh_smooth.comp_contDiffOn ((hf.sub contDiffOn_const).div_const ε)
  have hI : ∀ i : Fin 3,
      Integrable (fun y => partialDeriv i
        (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y *
          (partialDeriv i f y * χ y)) ∧
      Integrable (fun y => Real.smoothTransition (2 * ((f y - r₁) / ε) - 1) *
          partialDeriv i (fun y => partialDeriv i f y * χ y) y) ∧
      ∫ y, partialDeriv i (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y *
          (partialDeriv i f y * χ y) =
        -∫ y, Real.smoothTransition (2 * ((f y - r₁) / ε) - 1) *
          partialDeriv i (fun y => partialDeriv i f y * χ y) y :=
    fun i => hibp _ _ hHs (hw i) (hwc i) (hwT i) i
  obtain ⟨Fε, hFε⟩ : ∃ Fε : E3 → ℝ, Fε = fun y => ∑ i : Fin 3,
      partialDeriv i (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y *
        (partialDeriv i f y * χ y) := ⟨_, rfl⟩
  have hform : ∀ y ∈ T, Fε y = ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
      ((f y - r₁) / ε) * χ y * ∑ i : Fin 3, (partialDeriv i f y) ^ 2 := by
    intro y hy
    rw [hFε]
    simp only [hchain ε y hy]
    rw [Fin.sum_univ_three, Fin.sum_univ_three]
    ring
  have hFnn : ∀ y, 0 ≤ Fε y := by
    intro y
    by_cases hy : y ∈ T
    · rw [hform y hy]
      exact mul_nonneg (mul_nonneg (mul_nonneg (inv_nonneg.2 hε.le) (hhd0 _)) (hχ01 y).1)
        (Finset.sum_nonneg fun j _ => sq_nonneg _)
    · have h0 : χ y = 0 := image_eq_zero_of_notMem_tsupport (fun h => hy (hχT h))
      rw [hFε]
      simp [h0]
  have hcmp : ∀ y ∈ Q, ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
      ((f y - r₁) / ε) ≤ c₀⁻¹ * Fε y := by
    intro y hy
    have hyT := hQT hy
    by_cases hd : deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((f y - r₁) / ε) = 0
    · rw [hd, mul_zero]
      exact mul_nonneg (inv_nonneg.2 hc₀.le) (hFnn y)
    · have ht : 0 < (f y - r₁) / ε := by
        by_contra hneg
        exact hd (hhdz _ (not_lt.1 hneg))
      have hr : r₁ ≤ f y := by
        have h1 := mul_pos ht hε
        rw [div_mul_cancel₀ _ hε.ne'] at h1
        linarith
      have hS := hc₀le y hy hr
      rw [hform y hyT, hχQ y hy, mul_one]
      have ha : 0 ≤ ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
          ((f y - r₁) / ε) := mul_nonneg (inv_nonneg.2 hε.le) (hhd0 _)
      rw [le_inv_mul_iff₀ hc₀]
      nlinarith [mul_le_mul_of_nonneg_left hS ha]
  have hFint : Integrable Fε := by
    rw [hFε]
    exact integrable_finset_sum _ (fun i _ => (hI i).1)
  have hdir : ∀ i : Fin 3,
      ∫ y, partialDeriv i (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y *
          (partialDeriv i f y * χ y) ≤
        ∫ y, |partialDeriv i (fun y => partialDeriv i f y * χ y) y| := by
    intro i
    rw [(hI i).2.2, ← integral_neg]
    apply integral_mono (hI i).2.1.neg (hwi_int i).abs
    intro y
    have hH1 : |Real.smoothTransition (2 * ((f y - r₁) / ε) - 1)| ≤ 1 :=
      abs_le.2 ⟨by linarith [(hh01 ((f y - r₁) / ε)).1], (hh01 ((f y - r₁) / ε)).2⟩
    calc -(Real.smoothTransition (2 * ((f y - r₁) / ε) - 1) *
          partialDeriv i (fun y => partialDeriv i f y * χ y) y)
        ≤ |Real.smoothTransition (2 * ((f y - r₁) / ε) - 1) *
          partialDeriv i (fun y => partialDeriv i f y * χ y) y| := neg_le_abs _
      _ = |Real.smoothTransition (2 * ((f y - r₁) / ε) - 1)| *
          |partialDeriv i (fun y => partialDeriv i f y * χ y) y| := abs_mul _ _
      _ ≤ |partialDeriv i (fun y => partialDeriv i f y * χ y) y| :=
          mul_le_of_le_one_left (abs_nonneg _) hH1
  calc ∫⁻ y in Q, ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
        ((f y - r₁) / ε))
      ≤ ∫⁻ y in Q, ENNReal.ofReal (c₀⁻¹ * Fε y) :=
        setLIntegral_mono' hQ.measurableSet fun y hy => ENNReal.ofReal_le_ofReal (hcmp y hy)
    _ ≤ ∫⁻ y, ENNReal.ofReal (c₀⁻¹ * Fε y) := setLIntegral_le_lintegral _ _
    _ = ENNReal.ofReal (∫ y, c₀⁻¹ * Fε y) :=
        (ofReal_integral_eq_lintegral_ofReal (hFint.const_mul c₀⁻¹)
          (Eventually.of_forall fun y => mul_nonneg (inv_nonneg.2 hc₀.le) (hFnn y))).symm
    _ ≤ ENNReal.ofReal (c₀⁻¹ * ∑ i : Fin 3,
          ∫ y, |partialDeriv i (fun y => partialDeriv i f y * χ y) y|) := by
        apply ENNReal.ofReal_le_ofReal
        rw [integral_const_mul]
        apply mul_le_mul_of_nonneg_left _ (inv_nonneg.2 hc₀.le)
        rw [hFε, integral_finset_sum _ (fun i _ => (hI i).1)]
        exact Finset.sum_le_sum fun i _ => hdir i

theorem sep_cutoff_props [IsManifold 𝓘(ℝ, E3) ∞ M] (ρ : M → ℝ)
    (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (r₁ ε : ℝ) (hε : 0 < ε) (A : Set M)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) :
    ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => A.indicator (fun _ => (1 : ℝ)) x *
      Real.smoothTransition (2 * ((ρ x - r₁) / ε) - 1)) ∧
    ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ i : Fin 3,
      partialDeriv i (fun z => A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 q).symm z) *
          Real.smoothTransition (2 * ((ρ ((chartAt E3 q).symm z) - r₁) / ε) - 1)) y =
        A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 q).symm y) *
          (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 q).symm y) - r₁) / ε)) *
          partialDeriv i (fun z => ρ ((chartAt E3 q).symm z)) y :=
by
  have hρc : Continuous ρ := hρ.continuous
  
  have hloc : ∀ x : M,
      (x ∈ A → ∀ᶠ p in 𝓝 x, A.indicator (fun _ => (1 : ℝ)) p *
          Real.smoothTransition (2 * ((ρ p - r₁) / ε) - 1) =
        Real.smoothTransition (2 * ((ρ p - r₁) / ε) - 1)) ∧
      (x ∉ A → ∀ᶠ p in 𝓝 x, A.indicator (fun _ => (1 : ℝ)) p *
          Real.smoothTransition (2 * ((ρ p - r₁) / ε) - 1) = 0) := by
    intro x
    refine ⟨fun hx => ?_, fun hx => ?_⟩
    · filter_upwards [hAo.mem_nhds hx] with p hp
      rw [Set.indicator_of_mem hp, one_mul]
    · by_cases hlt : r₁ < ρ x
      · filter_upwards [hBo.mem_nhds ⟨hlt, hx⟩] with p hp
        rw [Set.indicator_of_notMem hp.2, zero_mul]
      · have hN : IsOpen {p : M | ρ p < r₁ + ε / 2} := isOpen_lt hρc continuous_const
        have hxN : x ∈ {p : M | ρ p < r₁ + ε / 2} := by
          show ρ x < r₁ + ε / 2
          push_neg at hlt
          linarith
        filter_upwards [hN.mem_nhds hxN] with p hp
        have hp' : ρ p < r₁ + ε / 2 := hp
        have h1 : (ρ p - r₁) / ε < 1 / 2 := by
          rw [div_lt_iff₀ hε]
          linarith
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), mul_zero]
  
  have hkd : Differentiable ℝ (fun t : ℝ => Real.smoothTransition (2 * t - 1)) :=
    ((Real.smoothTransition.contDiff (n := 1)).comp
      ((contDiff_const.mul contDiff_id).sub contDiff_const)).differentiable (by simp)
  have hchain : ∀ (f : E3 → ℝ) (y : E3), DifferentiableAt ℝ f y → ∀ i : Fin 3,
      partialDeriv i (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) y =
        ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((f y - r₁) / ε) *
          partialDeriv i f y := by
    intro f y hf i
    have hk : HasDerivAt (fun t : ℝ => Real.smoothTransition (2 * t - 1))
        (deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((f y - r₁) / ε))
        ((f y - r₁) / ε) := (hkd _).hasDerivAt
    have ha : HasDerivAt (fun s : ℝ => (s - r₁) / ε) (1 / ε) (f y) :=
      ((hasDerivAt_id' (f y)).sub_const r₁).div_const ε
    have hc := hk.comp (f y) ha
    have hF := hc.comp_hasFDerivAt y hf.hasFDerivAt
    unfold partialDeriv
    rw [show (fun z => Real.smoothTransition (2 * ((f z - r₁) / ε) - 1)) =
      ((fun t : ℝ => Real.smoothTransition (2 * t - 1)) ∘ (fun s : ℝ => (s - r₁) / ε)) ∘ f
      from rfl, hF.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have houter : ContDiff ℝ ∞
      (fun s : ℝ => Real.smoothTransition (2 * ((s - r₁) / ε) - 1)) :=
    Real.smoothTransition.contDiff.comp
      ((contDiff_const.mul ((contDiff_id.sub contDiff_const).div_const ε)).sub contDiff_const)
  have hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (fun x => Real.smoothTransition (2 * ((ρ x - r₁) / ε) - 1)) :=
    houter.comp_contMDiff hρ
  refine ⟨fun x => ?_, fun q y hy i => ?_⟩
  · by_cases hx : x ∈ A
    · exact (hφ x).congr_of_eventuallyEq ((hloc x).1 hx)
    · exact contMDiffAt_const.congr_of_eventuallyEq ((hloc x).2 hx)
  · have hc : Tendsto (chartAt E3 q).symm (𝓝 y) (𝓝 ((chartAt E3 q).symm y)) :=
      (chartAt E3 q).continuousAt_symm hy
    have hfd : DifferentiableAt ℝ (fun z => ρ ((chartAt E3 q).symm z)) y := by
      have h1 := hρ.comp_contMDiffOn (contMDiffOn_chart_symm (x := q))
      have h2 := contMDiffOn_iff_contDiffOn.mp h1
      exact (h2.differentiableOn (by simp)).differentiableAt
        ((chartAt E3 q).open_target.mem_nhds hy)
    by_cases hx : (chartAt E3 q).symm y ∈ A
    · have hev' : (fun z => A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 q).symm z) *
            Real.smoothTransition (2 * ((ρ ((chartAt E3 q).symm z) - r₁) / ε) - 1)) =ᶠ[𝓝 y]
          (fun z => Real.smoothTransition (2 * ((ρ ((chartAt E3 q).symm z) - r₁) / ε) - 1)) :=
        hc.eventually ((hloc _).1 hx)
      show fderiv ℝ _ y (e i) = _
      rw [hev'.fderiv_eq, Set.indicator_of_mem hx, one_mul]
      exact hchain _ y hfd i
    · have hev' : (fun z => A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 q).symm z) *
            Real.smoothTransition (2 * ((ρ ((chartAt E3 q).symm z) - r₁) / ε) - 1)) =ᶠ[𝓝 y]
          (fun _ => (0 : ℝ)) :=
        hc.eventually ((hloc _).2 hx)
      show fderiv ℝ _ y (e i) = _
      rw [hev'.fderiv_eq, Set.indicator_of_notMem hx]
      simp

theorem sepRiemPer_far_lt_top [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (ρ : M → ℝ) (r₁ s : ℝ) (A : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ)
    (hcpt : ∀ t : ℝ, IsCompact {p : M | ρ p ≤ t})
    (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p)
    (hAsub : A ⊆ {p : M | r₁ < ρ p}) (hAo : IsOpen A)
    (hBo : IsOpen ({p : M | r₁ < ρ p} \ A)) :
    sepRiemPer g A {p : M | ρ p < s} < ⊤ :=
by
  classical
  obtain ⟨-, -, -, hh1, hhd0, hhdz⟩ := sep_h_props
  have hρc : Continuous ρ := hρ.continuous
  have hρchart : ∀ q : M, ContDiffOn ℝ ∞ (fun z => ρ ((chartAt E3 q).symm z))
      (chartAt E3 q).target := fun q =>
    contMDiffOn_iff_contDiffOn.mp (hρ.comp_contMDiffOn contMDiffOn_chart_symm)
  
  have s15 : ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → r₁ ≤ ρ ((chartAt E3 q).symm y) →
      ∃ i : Fin 3, partialDeriv i (fun z => ρ ((chartAt E3 q).symm z)) y ≠ 0 := by
    intro q y hy hr
    by_contra hall
    push_neg at hall
    have h1 := levelMeanCurv_eq_coord g
      (PartialDiffeomorph.mk (chartAt E3 q).symm.toPartialEquiv (chartAt E3 q).open_target
        (chartAt E3 q).open_source contMDiffOn_chart_symm contMDiffOn_chart)
      ρ (fun z => ρ ((chartAt E3 q).symm z)) hρ y hy (Filter.Eventually.of_forall (fun z => rfl))
    have h3 : g.levelMeanCurv ρ ((chartAt E3 q).symm y) =
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun z => ρ ((chartAt E3 q).symm z)) y :=
      h1
    have h2 := hmc _ hr
    rw [h3] at h2
    simp only [levelMeanCurvCoord, hall, mul_zero, zero_mul, Finset.sum_const_zero,
      Real.sqrt_zero, div_zero] at h2
    norm_num at h2
  
  have s16 : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ (q : M) (y : E3),
      y ∈ (chartAt E3 q).target →
      ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
          partialDeriv i (fun z => u ((chartAt E3 q).symm z)) y *
          partialDeriv j (fun z => u ((chartAt E3 q).symm z)) y =
        g.gradInner u u ((chartAt E3 q).symm y) := by
    intro u hu q y hy
    obtain ⟨-, hlaw, hgr⟩ := sep_chart_transition g q ((chartAt E3 q).symm y) y hy
      (mem_chart_source E3 _)
    set x := (chartAt E3 q).symm y with hx
    set J : Matrix (Fin 3) (Fin 3) ℝ := Matrix.of fun a i =>
      fderiv ℝ (fun z => chartAt E3 x ((chartAt E3 q).symm z)) y (e i) a with hJ
    have hG : g.coeff (chartAt E3 q).symm y =
        J.transpose * g.coeff (chartAt E3 x).symm (chartAt E3 x x) * J := by
      ext i j
      rw [hlaw i j]
      simp only [hJ, Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hdetJ : J.det ≠ 0 := by
      intro h0
      have hpos := (coeff_chart_symm_posDef g q y hy).det_pos
      rw [hG, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, h0] at hpos
      simp at hpos
    have hq := sep_quadform_congr J (g.coeff (chartAt E3 x).symm (chartAt E3 x x)) hdetJ
      (fun a => partialDeriv a (fun z => u ((chartAt E3 x).symm z)) (chartAt E3 x x))
    rw [hG]
    simp only [hgr u hu]
    simp only [hJ, Matrix.of_apply] at hq ⊢
    rw [hq]
    rfl
  
  have s17 : ∀ (φ : M → ENNReal) (p₁ p₂ : M) (S : Set M),
      S ⊆ (chartAt E3 p₁).source ∩ (chartAt E3 p₂).source →
      MeasurableSet (chartAt E3 p₁ '' S) → MeasurableSet (chartAt E3 p₂ '' S) →
      ∫⁻ y in chartAt E3 p₁ '' S, φ ((chartAt E3 p₁).symm y) *
          ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₁).symm y).det) =
        ∫⁻ y in chartAt E3 p₂ '' S, φ ((chartAt E3 p₂).symm y) *
          ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₂).symm y).det) := by
    intro φ p₁ p₂ S hS hm₁ _
    have hmem : ∀ y ∈ chartAt E3 p₁ '' S, y ∈ (chartAt E3 p₁).target ∧
        (chartAt E3 p₁).symm y ∈ (chartAt E3 p₂).source := by
      rintro _ ⟨x, hx, rfl⟩
      rw [(chartAt E3 p₁).left_inv (hS hx).1]
      exact ⟨(chartAt E3 p₁).map_source (hS hx).1, (hS hx).2⟩
    have himg : (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) '' (chartAt E3 p₁ '' S) =
        chartAt E3 p₂ '' S := by
      rw [Set.image_image]
      apply Set.image_congr
      intro x hx
      rw [(chartAt E3 p₁).left_inv (hS hx).1]
    have hinj : Set.InjOn (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z)) (chartAt E3 p₁ '' S) := by
      intro y hy y' hy' heq
      have h1 : (chartAt E3 p₁).symm y = (chartAt E3 p₁).symm y' :=
        (chartAt E3 p₂).injOn (hmem y hy).2 (hmem y' hy').2 heq
      rw [← (chartAt E3 p₁).right_inv (hmem y hy).1, ← (chartAt E3 p₁).right_inv (hmem y' hy').1, h1]
    have key := sep_density_change (chartAt E3 p₁ '' S) hm₁
      (fun z => chartAt E3 p₂ ((chartAt E3 p₁).symm z))
      (fun y hy => (sep_chart_transition g p₁ p₂ y (hmem y hy).1 (hmem y hy).2).1) hinj
      (g.coeff (chartAt E3 p₁).symm) (g.coeff (chartAt E3 p₂).symm)
      (fun y hy i j => (sep_chart_transition g p₁ p₂ y (hmem y hy).1 (hmem y hy).2).2.1 i j)
      (fun y hy => (coeff_chart_symm_posDef g p₂ _
        ((chartAt E3 p₂).map_source (hmem y hy).2)).det_pos.le)
      (fun z => φ ((chartAt E3 p₂).symm z))
    rw [himg] at key
    rw [key]
    apply setLIntegral_congr_fun hm₁
    intro y hy
    simp only
    rw [(chartAt E3 p₂).left_inv (hmem y hy).2]
  
  have hcontD : ∀ (q : M) (v : E3 → ℝ), ContDiffOn ℝ ∞ v (chartAt E3 q).target →
      ContinuousOn (fun y => Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 q).symm y)⁻¹ i j * partialDeriv i v y * partialDeriv j v y) *
          Real.sqrt (g.coeff (chartAt E3 q).symm y).det) (chartAt E3 q).target := by
    intro q v hv
    have hGc : ContinuousOn (g.coeff (chartAt E3 q).symm) (chartAt E3 q).target := by
      refine continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => ?_
      exact (g.smooth q i j).continuousOn
    have hdetc : ContinuousOn (fun y => (g.coeff (chartAt E3 q).symm y).det)
        (chartAt E3 q).target :=
      (continuous_id.matrix_det).comp_continuousOn hGc
    have hadjc : ContinuousOn (fun y => (g.coeff (chartAt E3 q).symm y).adjugate)
        (chartAt E3 q).target :=
      (continuous_id.matrix_adjugate).comp_continuousOn hGc
    have hdet0 : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).det ≠ 0 :=
      fun y hy => (coeff_chart_symm_posDef g q y hy).det_pos.ne'
    have hinvc : ∀ i j : Fin 3, ContinuousOn (fun y => (g.coeff (chartAt E3 q).symm y)⁻¹ i j)
        (chartAt E3 q).target := by
      intro i j
      have hadj' : ContinuousOn (fun y => (g.coeff (chartAt E3 q).symm y).adjugate i j)
          (chartAt E3 q).target :=
        (continuous_apply j).comp_continuousOn ((continuous_apply i).comp_continuousOn hadjc)
      refine ((hdetc.inv₀ hdet0).mul hadj').congr fun y _ => ?_
      simp [Matrix.inv_def, Ring.inverse_eq_inv']
    have hdc : ∀ i : Fin 3, ContinuousOn (fun y => partialDeriv i v y) (chartAt E3 q).target := by
      intro i
      have h := hv.continuousOn_fderiv_of_isOpen (chartAt E3 q).open_target (by simp)
      exact (ContinuousLinearMap.apply ℝ ℝ (e i)).continuous.comp_continuousOn h
    refine ContinuousOn.mul ?_ hdetc.sqrt
    refine ContinuousOn.sqrt ?_
    refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
    exact ((hinvc i j).mul (hdc i)).mul (hdc j)
  
  have hK : IsCompact {x : M | r₁ ≤ ρ x ∧ ρ x ≤ r₁ + 1} := by
    have he : {x : M | r₁ ≤ ρ x ∧ ρ x ≤ r₁ + 1} = {x | ρ x ≤ r₁ + 1} ∩ {x | r₁ ≤ ρ x} := by
      ext x; simp only [Set.mem_setOf_eq, Set.mem_inter_iff]; exact and_comm
    rw [he]
    exact (hcpt (r₁ + 1)).inter_right (isClosed_le continuous_const hρc)
  have hball : ∀ x : M, ∃ r : ℝ, 0 < r ∧
      Metric.closedBall (chartAt E3 x x) r ⊆ (chartAt E3 x).target := by
    intro x
    obtain ⟨r, hr, hsub⟩ :=
      Metric.isOpen_iff.1 (chartAt E3 x).open_target _ (mem_chart_target E3 x)
    exact ⟨r / 2, by positivity, (Metric.closedBall_subset_ball (by linarith)).trans hsub⟩
  choose rr hrr hrsub using hball
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover
    (fun x : M => (chartAt E3 x).source ∩ chartAt E3 x ⁻¹' Metric.ball (chartAt E3 x x) (rr x))
    (fun x => (chartAt E3 x).isOpen_inter_preimage Metric.isOpen_ball)
    (fun x _ => Set.mem_iUnion.2 ⟨x, mem_chart_source E3 x, Metric.mem_ball_self (hrr x)⟩)
  obtain ⟨m, q, hq⟩ : ∃ (m : ℕ) (q : Fin m → M), ∀ x ∈ t, ∃ j, q j = x :=
    ⟨t.card, fun j => (t.equivFin.symm j : M), fun x hx => ⟨t.equivFin ⟨x, hx⟩, by simp⟩⟩
  obtain ⟨V, hVdef⟩ : ∃ V : Fin m → Set M, V = fun j => (chartAt E3 (q j)).source ∩
      chartAt E3 (q j) ⁻¹' Metric.ball (chartAt E3 (q j) (q j)) (rr (q j)) := ⟨_, rfl⟩
  have hV : ∀ j, IsOpen (V j) ∧ V j ⊆ (chartAt E3 (q j)).source := by
    intro j
    rw [hVdef]
    exact ⟨(chartAt E3 (q j)).isOpen_inter_preimage Metric.isOpen_ball, Set.inter_subset_left⟩
  have hKV : {x : M | r₁ ≤ ρ x ∧ ρ x ≤ r₁ + 1} ⊆ ⋃ j, V j := by
    intro x hx
    obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.1 (ht hx)
    obtain ⟨j, rfl⟩ := hq i hi
    rw [hVdef]
    exact Set.mem_iUnion.2 ⟨j, hxi⟩
  have hVQ : ∀ j, chartAt E3 (q j) '' V j ⊆
      Metric.closedBall (chartAt E3 (q j) (q j)) (rr (q j)) := by
    intro j
    rw [hVdef]
    rintro _ ⟨x, hx, rfl⟩
    exact Metric.ball_subset_closedBall hx.2
  have hBC : ∀ j : Fin m, ∃ B C : ℝ,
      (∀ y ∈ Metric.closedBall (chartAt E3 (q j) (q j)) (rr (q j)),
        Real.sqrt (∑ i : Fin 3, ∑ i' : Fin 3, (g.coeff (chartAt E3 (q j)).symm y)⁻¹ i i' *
          partialDeriv i (fun z => ρ ((chartAt E3 (q j)).symm z)) y *
          partialDeriv i' (fun z => ρ ((chartAt E3 (q j)).symm z)) y) *
          Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det ≤ B) ∧
      (∀ ε : ℝ, 0 < ε → ε ≤ 1 →
        ∫⁻ y in Metric.closedBall (chartAt E3 (q j) (q j)) (rr (q j)),
          ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε)) ≤ ENNReal.ofReal C) := by
    intro j
    obtain ⟨B, hB⟩ := (isCompact_closedBall (chartAt E3 (q j) (q j)) (rr (q j))).exists_bound_of_continuousOn
      ((hcontD (q j) _ (hρchart (q j))).mono (hrsub (q j)))
    obtain ⟨C, hC⟩ := sep_shell_bound _ _ (chartAt E3 (q j)).open_target
      (isCompact_closedBall (chartAt E3 (q j) (q j)) (rr (q j))) (hrsub (q j)) _ (hρchart (q j)) r₁
      (fun y hy hr => s15 (q j) y hy hr)
    refine ⟨B, C, fun y hy => ?_, hC⟩
    have := hB y hy
    rw [Real.norm_eq_abs] at this
    exact (le_abs_self _).trans this
  choose B C hB hC using hBC
  
  obtain ⟨u, hu⟩ : ∃ u : ℝ → M → ℝ, u = fun ε x => A.indicator (fun _ => (1 : ℝ)) x *
      Real.smoothTransition (2 * ((ρ x - r₁) / ε) - 1) := ⟨_, rfl⟩
  have hus : ∀ ε : ℝ, 0 < ε → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u ε) := by
    intro ε hε
    rw [hu]
    exact (sep_cutoff_props ρ hρ r₁ ε hε A hAsub hAo hBo).1
  have hgu : ∀ ε : ℝ, 0 < ε → ∀ (q : M) (y : E3), y ∈ (chartAt E3 q).target → ∀ i : Fin 3,
      partialDeriv i (fun z => u ε ((chartAt E3 q).symm z)) y =
        A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 q).symm y) *
          (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 q).symm y) - r₁) / ε)) *
          partialDeriv i (fun z => ρ ((chartAt E3 q).symm z)) y := by
    intro ε hε
    rw [hu]
    exact (sep_cutoff_props ρ hρ r₁ ε hε A hAsub hAo hBo).2
  have hvk : ∀ ε : ℝ, 0 < ε → ∀ q : M,
      ContDiffOn ℝ ∞ (fun z => u ε ((chartAt E3 q).symm z)) (chartAt E3 q).target :=
    fun ε hε q => contMDiffOn_iff_contDiffOn.mp ((hus ε hε).comp_contMDiffOn contMDiffOn_chart_symm)
  have hu1 : ∀ ε : ℝ, ∀ x : M, |u ε x| ≤ 1 := by
    intro ε x
    rw [hu]
    by_cases hA : x ∈ A
    · simp only [Set.indicator_of_mem hA, one_mul]
      rw [abs_of_nonneg (Real.smoothTransition.nonneg _)]
      exact Real.smoothTransition.le_one _
    · simp [Set.indicator_of_notMem hA]
  
  have hgz : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∀ x : M, ¬ (r₁ ≤ ρ x ∧ ρ x ≤ r₁ + 1) →
      g.gradInner (u ε) (u ε) x = 0 := by
    intro ε hε hε1 x hx
    have hd0 : deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1)) ((ρ x - r₁) / ε) = 0 := by
      apply hhdz
      by_cases h1 : r₁ ≤ ρ x
      · right
        have h2 : r₁ + 1 < ρ x := by
          by_contra h3
          exact hx ⟨h1, not_lt.1 h3⟩
        rw [le_div_iff₀ hε]
        linarith
      · left
        push_neg at h1
        have : (ρ x - r₁) / ε < 0 := div_neg_of_neg_of_pos (by linarith) hε
        linarith
    have hpd : ∀ i : Fin 3,
        partialDeriv i (fun z => u ε ((chartAt E3 x).symm z)) (chartAt E3 x x) = 0 := by
      intro i
      rw [hgu ε hε x (chartAt E3 x x) (mem_chart_target E3 x) i,
        (chartAt E3 x).left_inv (mem_chart_source E3 x), hd0]
      ring
    simp only [RiemannianMetric3.gradInner, hpd, mul_zero, Finset.sum_const_zero]
  have hφ : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∀ x : M, x ∉ ⋃ j, V j →
      ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) x)) = 0 := by
    intro ε hε hε1 x hx
    rw [hgz ε hε hε1 x (fun hK' => hx (hKV hK')), Real.sqrt_zero, ENNReal.ofReal_zero]
  
  have hjbound : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∀ j : Fin m,
      ∫⁻ y in chartAt E3 (q j) '' V j,
        ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) ((chartAt E3 (q j)).symm y))) *
          ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) ≤
        ENNReal.ofReal (C j) * ENNReal.ofReal (B j) := by
    intro ε hε hε1 j
    have hVo : IsOpen (chartAt E3 (q j) '' V j) :=
      (chartAt E3 (q j)).isOpen_image_of_subset_source (hV j).1 (hV j).2
    have hpt : ∀ y ∈ chartAt E3 (q j) '' V j,
        ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) ((chartAt E3 (q j)).symm y))) *
          ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) ≤
        ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε)) * ENNReal.ofReal (B j) := by
      intro y hy
      have hyQ := hVQ j hy
      have hyt := hrsub (q j) hyQ
      rw [← s16 (u ε) (hus ε hε) (q j) y hyt]
      simp only [hgu ε hε (q j) y hyt]
      have hsum : ∀ (c : ℝ) (a : Fin 3 → ℝ) (Mx : Matrix (Fin 3) (Fin 3) ℝ),
          ∑ i : Fin 3, ∑ i' : Fin 3, Mx i i' * (c * a i) * (c * a i') =
            c ^ 2 * ∑ i : Fin 3, ∑ i' : Fin 3, Mx i i' * a i * a i' := by
        intro c a Mx
        simp only [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun i' _ => ?_
        ring
      have hs := hsum (A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 (q j)).symm y) *
          (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε)))
        (fun i => partialDeriv i (fun z => ρ ((chartAt E3 (q j)).symm z)) y)
        (g.coeff (chartAt E3 (q j)).symm y)⁻¹
      simp only at hs
      have he : 0 ≤ ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
          ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε) :=
        mul_nonneg (inv_nonneg.2 hε.le) (hhd0 _)
      rw [hs, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs,
        ← ENNReal.ofReal_mul (mul_nonneg (abs_nonneg _) (Real.sqrt_nonneg _)),
        ← ENNReal.ofReal_mul he]
      apply ENNReal.ofReal_le_ofReal
      have hc0 : |A.indicator (fun _ => (1 : ℝ)) ((chartAt E3 (q j)).symm y) *
          (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε))| ≤
          ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε) := by
        by_cases hA : (chartAt E3 (q j)).symm y ∈ A
        · rw [Set.indicator_of_mem hA, one_mul, abs_of_nonneg he]
        · rw [Set.indicator_of_notMem hA, zero_mul, abs_zero]
          exact he
      have hBj := hB j y hyQ
      rw [mul_assoc]
      exact mul_le_mul hc0 hBj (by positivity) he
    calc _ ≤ ∫⁻ y in chartAt E3 (q j) '' V j,
          ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε)) * ENNReal.ofReal (B j) :=
          setLIntegral_mono' hVo.measurableSet hpt
      _ ≤ ∫⁻ y in Metric.closedBall (chartAt E3 (q j) (q j)) (rr (q j)),
          ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε)) * ENNReal.ofReal (B j) :=
          lintegral_mono_set (hVQ j)
      _ = (∫⁻ y in Metric.closedBall (chartAt E3 (q j) (q j)) (rr (q j)),
          ENNReal.ofReal (ε⁻¹ * deriv (fun t : ℝ => Real.smoothTransition (2 * t - 1))
            ((ρ ((chartAt E3 (q j)).symm y) - r₁) / ε))) * ENNReal.ofReal (B j) :=
          lintegral_mul_const' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal (C j) * ENNReal.ofReal (B j) := mul_le_mul_right' (hC j ε hε hε1) _
  
  have s19 : ∀ ε : ℝ, 0 < ε → ε ≤ 1 → ∀ (n : ℕ) (p : Fin n → M) (W : Fin n → Set M),
      (∀ k, IsOpen (W k) ∧ W k ⊆ (chartAt E3 (p k)).source) →
      Pairwise (fun k l => Disjoint (W k) (W l)) →
      ∀ X : Fin n → E3 → E3, (∀ k, ContDiff ℝ ∞ (X k) ∧ HasCompactSupport (X k) ∧
        tsupport (X k) ⊆ chartAt E3 (p k) '' W k ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (p k)).symm y i j * X k y i * X k y j ≤ 1) →
      ∑ k, ENNReal.ofReal (∫ y, u ε ((chartAt E3 (p k)).symm y) *
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y) ≤
        ∑ j, ENNReal.ofReal (C j) * ENNReal.ofReal (B j) := by
    intro ε hε hε1 n p W hW hdisj X hX
    have hUt : ∀ k, chartAt E3 (p k) '' W k ⊆ (chartAt E3 (p k)).target := by
      intro k
      rintro _ ⟨x, hx, rfl⟩
      exact (chartAt E3 (p k)).map_source ((hW k).2 hx)
    have hUo : ∀ k, IsOpen (chartAt E3 (p k) '' W k) := fun k =>
      (chartAt E3 (p k)).isOpen_image_of_subset_source (hW k).1 (hW k).2
    have hstep : ∀ k, ENNReal.ofReal (∫ y, u ε ((chartAt E3 (p k)).symm y) *
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y) ≤
        ∫⁻ y in chartAt E3 (p k) '' W k,
          ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) ((chartAt E3 (p k)).symm y))) *
            ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det) := by
      intro k
      obtain ⟨-, -, hb⟩ := sep_div_test_bound (g.coeff (chartAt E3 (p k)).symm)
        (chartAt E3 (p k)).target (chartAt E3 (p k) '' W k) (chartAt E3 (p k)).open_target
        (hUt k) (fun i j => g.smooth (p k) i j)
        (fun y hy => coeff_chart_symm_posDef g (p k) y hy) (X k) (hX k).1 (hX k).2.1
        (hX k).2.2.1 (hX k).2.2.2 _ (hvk ε hε (p k))
      refine hb.trans (le_of_eq ?_)
      apply setLIntegral_congr_fun (hUo k).measurableSet
      intro y hy
      simp only
      rw [s16 (u ε) (hus ε hε) (p k) y (hUt k hy), ENNReal.ofReal_mul (Real.sqrt_nonneg _)]
    calc _ ≤ ∑ k, ∫⁻ y in chartAt E3 (p k) '' W k,
          ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) ((chartAt E3 (p k)).symm y))) *
            ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det) :=
          Finset.sum_le_sum fun k _ => hstep k
      _ ≤ ∑ j, ∫⁻ y in chartAt E3 (q j) '' V j,
          ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) ((chartAt E3 (q j)).symm y))) *
            ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) :=
          sep_cover_sum (fun p y => ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p).symm y).det))
            (fun x => ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) x)))
            (s17 (fun x => ENNReal.ofReal (Real.sqrt (g.gradInner (u ε) (u ε) x))))
            m q V hV (hφ ε hε hε1) n p W hW hdisj
      _ ≤ ∑ j, ENNReal.ofReal (C j) * ENNReal.ofReal (B j) :=
          Finset.sum_le_sum fun j _ => hjbound ε hε hε1 j
  
  have sumsup : ∀ (n : ℕ) (P : Fin n → (E3 → E3) → Prop) (val : Fin n → (E3 → E3) → ENNReal)
      (c : ENNReal), (∀ k, P k 0) → (∀ X : Fin n → E3 → E3, (∀ k, P k (X k)) →
        ∑ k, val k (X k) ≤ c) →
      ∑ k, ⨆ (X : E3 → E3) (_ : P k X), val k X ≤ c := by
    intro n P val c h0 hX
    have hb : ∀ k, (⨆ (X : E3 → E3) (_ : P k X), val k X) =
        ⨆ (Xs : Fin n → E3 → E3), ⨆ (_ : P k (Xs k)), val k (Xs k) := by
      intro k
      apply le_antisymm
      · exact iSup_le fun X => le_iSup_of_le (fun _ => X) le_rfl
      · exact iSup_le fun Xs => le_iSup_of_le (Xs k) le_rfl
    rw [Finset.sum_congr rfl fun k _ => hb k]
    rw [ENNReal.finsetSum_iSup (f := fun (k : Fin n) (Xs : Fin n → E3 → E3) =>
      ⨆ (_ : P k (Xs k)), val k (Xs k))]
    · refine iSup_le fun Xs => ?_
      calc ∑ k, ⨆ (_ : P k (Xs k)), val k (Xs k) ≤
            ∑ k, val k (if P k (Xs k) then Xs k else 0) := by
            refine Finset.sum_le_sum fun k _ => iSup_le fun hk => ?_
            rw [if_pos hk]
        _ ≤ c := hX _ fun k => by
            by_cases hk : P k (Xs k)
            · rw [if_pos hk]; exact hk
            · rw [if_neg hk]; exact h0 k
    · intro Xs Ys
      refine ⟨fun k => if (⨆ (_ : P k (Xs k)), val k (Xs k)) ≤ (⨆ (_ : P k (Ys k)), val k (Ys k))
        then Ys k else Xs k, fun k => ?_⟩
      by_cases hk : (⨆ (_ : P k (Xs k)), val k (Xs k)) ≤ (⨆ (_ : P k (Ys k)), val k (Ys k))
      · simp only [if_pos hk]
        exact ⟨hk, le_rfl⟩
      · simp only [if_neg hk]
        exact ⟨le_rfl, (not_le.1 hk).le⟩
  
  have s20 : ∀ (n : ℕ) (p : Fin n → M) (W : Fin n → Set M),
      (∀ k, IsOpen (W k) ∧ W k ⊆ {x : M | ρ x < s} ∩ (chartAt E3 (p k)).source) →
      Pairwise (fun k l => Disjoint (W k) (W l)) →
      ∑ k, sepPerG (g.coeff (chartAt E3 (p k)).symm)
        (chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source)) (chartAt E3 (p k) '' W k) ≤
        ∑ j, ENNReal.ofReal (C j) * ENNReal.ofReal (B j) := by
    intro n p W hW hdisj
    have hW' : ∀ k, IsOpen (W k) ∧ W k ⊆ (chartAt E3 (p k)).source :=
      fun k => ⟨(hW k).1, (hW k).2.trans Set.inter_subset_right⟩
    have hUt : ∀ k, chartAt E3 (p k) '' W k ⊆ (chartAt E3 (p k)).target := by
      intro k
      rintro _ ⟨x, hx, rfl⟩
      exact (chartAt E3 (p k)).map_source ((hW' k).2 hx)
    have hfam : ∀ X : Fin n → E3 → E3, (∀ k, ContDiff ℝ ∞ (X k) ∧ HasCompactSupport (X k) ∧
        tsupport (X k) ⊆ chartAt E3 (p k) '' W k ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (p k)).symm y i j * X k y i * X k y j ≤ 1) →
        ∑ k, ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source),
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y) ≤
          ∑ j, ENNReal.ofReal (C j) * ENNReal.ofReal (B j) := by
      intro X hX
      have hlimk : ∀ k, Tendsto (fun m : ℕ => ∫ y, u (1 / ((m : ℝ) + 1))
          ((chartAt E3 (p k)).symm y) * sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y)
          atTop (𝓝 (∫ y in chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source),
            sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y)) := by
        intro k
        obtain ⟨hdc, hdts, -⟩ := sep_div_test_bound (g.coeff (chartAt E3 (p k)).symm)
          (chartAt E3 (p k)).target (chartAt E3 (p k) '' W k) (chartAt E3 (p k)).open_target
          (hUt k) (fun i j => g.smooth (p k) i j)
          (fun y hy => coeff_chart_symm_posDef g (p k) y hy) (X k) (hX k).1 (hX k).2.1
          (hX k).2.2.1 (hX k).2.2.2 (fun _ => 0) contDiffOn_const
        refine sep_dominated_limit (chartAt E3 (p k)).target _ (chartAt E3 (p k)).open_target
          ((chartAt E3 (p k)).isOpen_image_of_subset_source
            (hAo.inter (chartAt E3 (p k)).open_source) Set.inter_subset_right).measurableSet
          _ hdc ((hX k).2.1.mono' ((subset_tsupport _).trans hdts))
          (hdts.trans ((hX k).2.2.1.trans (hUt k)))
          (fun m z => u (1 / ((m : ℝ) + 1)) ((chartAt E3 (p k)).symm z))
          (fun m => (hvk _ (by positivity) (p k)).continuousOn)
          (fun m z => hu1 _ _) ?_
        intro y hy
        by_cases hxA : (chartAt E3 (p k)).symm y ∈ A
        · have hyF : y ∈ chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source) :=
            ⟨_, ⟨hxA, (chartAt E3 (p k)).map_target hy⟩, (chartAt E3 (p k)).right_inv hy⟩
          rw [Set.indicator_of_mem hyF]
          have hδ : 0 < ρ ((chartAt E3 (p k)).symm y) - r₁ := by
            have h1 : r₁ < ρ ((chartAt E3 (p k)).symm y) := hAsub hxA
            linarith
          apply tendsto_const_nhds.congr'
          filter_upwards [Filter.eventually_ge_atTop ⌈(ρ ((chartAt E3 (p k)).symm y) - r₁)⁻¹⌉₊]
            with m hm
          have hm' : (ρ ((chartAt E3 (p k)).symm y) - r₁)⁻¹ ≤ (m : ℝ) :=
            (Nat.le_ceil _).trans (by exact_mod_cast hm)
          have h1 : 1 ≤ (ρ ((chartAt E3 (p k)).symm y) - r₁) * (m : ℝ) := by
            have := mul_le_mul_of_nonneg_left hm' hδ.le
            rwa [mul_inv_cancel₀ hδ.ne'] at this
          have h2 : 1 ≤ (ρ ((chartAt E3 (p k)).symm y) - r₁) / (1 / ((m : ℝ) + 1)) := by
            rw [div_div_eq_mul_div, div_one]
            nlinarith
          rw [hu]
          simp only [Set.indicator_of_mem hxA, one_mul]
          rw [hh1 _ h2]
        · have hyF : y ∉ chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source) := by
            rintro ⟨x', ⟨hx'A, hx's⟩, hxy⟩
            apply hxA
            rw [← hxy, (chartAt E3 (p k)).left_inv hx's]
            exact hx'A
          rw [Set.indicator_of_notMem hyF]
          apply tendsto_const_nhds.congr'
          filter_upwards with m
          rw [hu]
          simp only [Set.indicator_of_notMem hxA, zero_mul]
      have hT : Tendsto (fun m : ℕ => ∑ k, ENNReal.ofReal (∫ y, u (1 / ((m : ℝ) + 1))
          ((chartAt E3 (p k)).symm y) * sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y))
          atTop (𝓝 (∑ k, ENNReal.ofReal
            (∫ y in chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source),
              sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (X k) y))) :=
        tendsto_finset_sum _ fun k _ => ENNReal.tendsto_ofReal (hlimk k)
      refine le_of_tendsto' hT fun m => ?_
      have hm1 : 1 / ((m : ℝ) + 1) ≤ 1 := by
        rw [div_le_one (by positivity)]
        linarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]
      exact s19 (1 / ((m : ℝ) + 1)) (by positivity) hm1 n p W hW' hdisj X hX
    have hadm0 : ∀ k, ContDiff ℝ ∞ (0 : E3 → E3) ∧ HasCompactSupport (0 : E3 → E3) ∧
        tsupport (0 : E3 → E3) ⊆ chartAt E3 (p k) '' W k ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (p k)).symm y i j * (0 : E3 → E3) y i * (0 : E3 → E3) y j ≤ 1 := by
      intro k
      refine ⟨contDiff_const, HasCompactSupport.zero, ?_, fun y => ?_⟩
      · rw [tsupport_zero]
        exact Set.empty_subset _
      · simp
    exact sumsup n (fun k X => ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
        tsupport X ⊆ chartAt E3 (p k) '' W k ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (p k)).symm y i j * X y i * X y j ≤ 1)
      (fun k X => ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (A ∩ (chartAt E3 (p k)).source),
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y))
      _ hadm0 hfam
  unfold sepRiemPer
  refine lt_of_le_of_lt (iSup_le fun n => iSup_le fun p => iSup_le fun W => iSup_le fun hc =>
    s20 n p W hc.1 hc.2) ?_
  exact ENNReal.sum_lt_top.2 fun j _ =>
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top

theorem hullRiemPer_le_sepRiemPer [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (F U K : Set M) (hK : IsClosed K)
    (hFK : Disjoint (closure F) K) :
    hullRiemPer g F U K ≤ sepRiemPer g F U :=
by
  
  have s1 : ∀ (A B : Set E3), IsClosed A → IsClosed B → Disjoint A B →
      ∃ χ : E3 → ℝ, ContDiff ℝ ∞ χ ∧ (∀ y, 0 ≤ χ y ∧ χ y ≤ 1) ∧
        (∀ y ∈ A, ∀ᶠ z in 𝓝 y, χ z = 1) ∧ (∀ y ∈ B, ∀ᶠ z in 𝓝 y, χ z = 0) := by
    intro A B hA hB hAB
    obtain ⟨f, hf0, hf1, hf01⟩ :=
      exists_contMDiffMap_zero_one_nhds_of_isClosed 𝓘(ℝ, E3) (n := ⊤) hB hA hAB.symm
    refine ⟨f, ?_, fun y => ⟨(hf01 y).1, (hf01 y).2⟩, ?_, ?_⟩
    · exact contMDiff_iff_contDiff.mp f.contMDiff
    · exact eventually_nhdsSet_iff_forall.mp hf1
    · exact eventually_nhdsSet_iff_forall.mp hf0
  
  have s2a : ∀ (Kc : Set E3) (X : E3 → E3), (∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X y) →
      ∀ (χ : E3 → ℝ), ContDiff ℝ ∞ χ → (∀ y ∈ Kc ∩ tsupport X, ∀ᶠ z in 𝓝 y, χ z = 0) →
      ∀ (X' : E3 → E3), (∀ y, X' y = χ y • X y) → ContDiff ℝ ∞ X' := by
    intro Kc X hXs χ hχ hχK X' hX'
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hyT : y ∈ tsupport X
    · by_cases hyK : y ∈ Kc
      · have h0 := hχK y ⟨hyK, hyT⟩
        have hev : X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
          filter_upwards [h0] with z hz
          rw [hX' z, hz, zero_smul]
        exact contDiffAt_const.congr_of_eventuallyEq hev
      · have h1 : ContDiffAt ℝ ∞ (fun z => χ z • X z) y := hχ.contDiffAt.smul (hXs y hyK)
        have hfun : X' = fun z => χ z • X z := funext hX'
        rw [hfun]
        exact h1
    · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyT
      have hev : X' =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        filter_upwards [h0] with z hz
        rw [hX' z, hz, Pi.zero_apply, smul_zero]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  
  have s2b : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) (χ : E3 → ℝ),
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      (∀ y, 0 ≤ χ y ∧ χ y ≤ 1) →
      ∀ (X' : E3 → E3), (∀ y, X' y = χ y • X y) →
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j ≤ 1 := by
    intro G X χ hXn hχb X' hX' y
    have hs := hXn y
    have hc : ∀ i, X' y i = χ y * X y i := by
      intro i
      rw [hX' y]
      rfl
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X' y i * X' y j =
        (χ y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
      simp only [hc, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [e1]
    obtain ⟨h0, h1⟩ := hχb y
    have h2 := mul_le_mul_of_nonneg_left hs (sq_nonneg (χ y))
    nlinarith
  
  have s2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F' U' Kc : Set E3) (X : E3 → E3),
      (∀ y, y ∉ Kc → ContDiffAt ℝ ∞ X y) → HasCompactSupport X → tsupport X ⊆ U' →
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      ∀ χ : E3 → ℝ, ContDiff ℝ ∞ χ → (∀ y, 0 ≤ χ y ∧ χ y ≤ 1) →
      (∀ y ∈ F' ∩ tsupport X, ∀ᶠ z in 𝓝 y, χ z = 1) →
      (∀ y ∈ Kc ∩ tsupport X, ∀ᶠ z in 𝓝 y, χ z = 0) →
      ENNReal.ofReal (∫ y in F', sepDensDiv G X y) ≤ sepPerG G F' U' := by
    intro G F' U' Kc X hXs hXc hXU hXn χ hχ hχb hχF hχK
    obtain ⟨X', hX'⟩ : ∃ X' : E3 → E3, ∀ y, X' y = χ y • X y := ⟨fun y => χ y • X y, fun _ => rfl⟩
    have ha : ContDiff ℝ ∞ X' := s2a Kc X hXs χ hχ hχK X' hX'
    have hsupp : Function.support X' ⊆ Function.support X := by
      intro y hy h0
      apply hy
      rw [hX' y, h0, smul_zero]
    have hb : HasCompactSupport X' := hXc.mono hsupp
    have hc : tsupport X' ⊆ U' := (closure_mono hsupp).trans hXU
    have hd := s2b G X χ hXn hχb X' hX'
    have hFO : F' ⊆ {y | ∀ᶠ z in 𝓝 y, X' z = X z} := by
      intro y hy
      show ∀ᶠ z in 𝓝 y, X' z = X z
      by_cases hyT : y ∈ tsupport X
      · filter_upwards [hχF y ⟨hy, hyT⟩] with z hz
        rw [hX' z, hz, one_smul]
      · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyT
        filter_upwards [h0] with z hz
        rw [hX' z, hz, Pi.zero_apply, smul_zero]
    have hOo : IsOpen {y | ∀ᶠ z in 𝓝 y, X' z = X z} := isOpen_setOf_eventually_nhds
    have hf : ∀ y ∈ {y | ∀ᶠ z in 𝓝 y, X' z = X z}, sepDensDiv G X' y = sepDensDiv G X y := by
      intro y hy
      have hy' : ∀ᶠ z in 𝓝 y, X' z = X z := hy
      unfold sepDensDiv
      refine Finset.sum_congr rfl fun i _ => ?_
      unfold partialDeriv
      have hev : (fun z => Real.sqrt (G z).det * X' z i) =ᶠ[𝓝 y]
          (fun z => Real.sqrt (G z).det * X z i) := by
        filter_upwards [hy'] with z hz
        rw [hz]
      rw [hev.fderiv_eq]
    have hint : ∫ y in F', sepDensDiv G X' y = ∫ y in F', sepDensDiv G X y := by
      apply integral_congr_ae
      have h1 : ∀ᵐ y ∂(volume.restrict {y | ∀ᶠ z in 𝓝 y, X' z = X z}),
          sepDensDiv G X' y = sepDensDiv G X y :=
        ae_restrict_of_forall_mem hOo.measurableSet hf
      exact ae_restrict_of_ae_restrict_of_subset hFO h1
    unfold sepPerG
    rw [← hint]
    exact le_iSup₂_of_le (f := fun (Y : E3 → E3) (_ : ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧
        tsupport Y ⊆ U' ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * Y y i * Y y j ≤ 1) =>
        ENNReal.ofReal (∫ y in F', sepDensDiv G Y y)) X' ⟨ha, hb, hc, hd⟩ le_rfl
  
  have s3 : ∀ (p : M) (T : Set E3), IsCompact T → T ⊆ (chartAt E3 p).target →
      Disjoint (closure ((chartAt E3 p) '' (F ∩ (chartAt E3 p).source) ∩ T))
        (closure ((chartAt E3 p) '' (K ∩ (chartAt E3 p).source) ∩ T)) := by
    intro p T hT hTt
    have hS : IsCompact ((chartAt E3 p).symm '' T) :=
      hT.image_of_continuousOn ((chartAt E3 p).continuousOn_symm.mono hTt)
    have hSs : (chartAt E3 p).symm '' T ⊆ (chartAt E3 p).source := by
      rintro _ ⟨y, hy, rfl⟩
      exact (chartAt E3 p).map_target (hTt hy)
    have hA : IsCompact ((chartAt E3 p) '' (closure F ∩ (chartAt E3 p).symm '' T)) :=
      (hS.inter_left isClosed_closure).image_of_continuousOn
        ((chartAt E3 p).continuousOn.mono (Set.inter_subset_right.trans hSs))
    have hB : IsCompact ((chartAt E3 p) '' (K ∩ (chartAt E3 p).symm '' T)) :=
      (hS.inter_left hK).image_of_continuousOn
        ((chartAt E3 p).continuousOn.mono (Set.inter_subset_right.trans hSs))
    have hA' : closure ((chartAt E3 p) '' (F ∩ (chartAt E3 p).source) ∩ T) ⊆
        (chartAt E3 p) '' (closure F ∩ (chartAt E3 p).symm '' T) := by
      refine closure_minimal ?_ hA.isClosed
      rintro _ ⟨⟨x, ⟨hxF, hxs⟩, rfl⟩, hyT⟩
      exact ⟨x, ⟨subset_closure hxF, (chartAt E3 p) x, hyT, (chartAt E3 p).left_inv hxs⟩, rfl⟩
    have hB' : closure ((chartAt E3 p) '' (K ∩ (chartAt E3 p).source) ∩ T) ⊆
        (chartAt E3 p) '' (K ∩ (chartAt E3 p).symm '' T) := by
      refine closure_minimal ?_ hB.isClosed
      rintro _ ⟨⟨x, ⟨hxK, hxs⟩, rfl⟩, hyT⟩
      exact ⟨x, ⟨hxK, (chartAt E3 p) x, hyT, (chartAt E3 p).left_inv hxs⟩, rfl⟩
    refine Disjoint.mono hA' hB' ?_
    rw [Set.disjoint_left]
    rintro _ ⟨x₁, ⟨hx₁F, hx₁S⟩, rfl⟩ ⟨x₂, ⟨hx₂K, hx₂S⟩, hx⟩
    have hx12 : x₂ = x₁ := (chartAt E3 p).injOn (hSs hx₂S) (hSs hx₁S) hx
    subst hx12
    exact Set.disjoint_left.mp hFK hx₁F hx₂K
  
  unfold hullRiemPer sepRiemPer
  refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun h =>
    Finset.sum_le_sum fun k _ => ?_
  unfold hullPerG
  refine iSup₂_le fun X hX => ?_
  obtain ⟨hXs, hXc, hXU, hXn, -⟩ := hX
  have hTt : tsupport X ⊆ (chartAt E3 (p k)).target := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hXU hy
    exact (chartAt E3 (p k)).map_source ((h.1 k).2 hx).2
  have hsep := s3 (p k) (tsupport X) hXc hTt
  obtain ⟨χ, hχ, hχb, hχA, hχB⟩ := s1 _ _ isClosed_closure isClosed_closure hsep
  exact s2 _ _ _ _ X hXs hXc hXU hXn χ hχ hχb (fun y hy => hχA y (subset_closure hy))
    (fun y hy => hχB y (subset_closure hy))

theorem sepPerG_one_le_mul (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (y : E3) (R : ℝ)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U)
    (hpd : ∀ z ∈ U, (G z).PosDef) (hR : 0 < R) (hB : closedBall y R ⊆ U) :
    ∃ c : ℝ, 0 ≤ c ∧ ∀ S : Set E3,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (ball y R) ≤
        ENNReal.ofReal c * sepPerG G S (ball y R) :=
by
  
  have hdet : ∀ z ∈ U, 0 < (G z).det := fun z hz => (hpd z hz).det_pos
  have hdetfun : (fun w => (G w).det) = fun w =>
      G w 0 0 * G w 1 1 * G w 2 2 - G w 0 0 * G w 1 2 * G w 2 1
        - G w 0 1 * G w 1 0 * G w 2 2 + G w 0 1 * G w 1 2 * G w 2 0
        + G w 0 2 * G w 1 0 * G w 2 1 - G w 0 2 * G w 1 1 * G w 2 0 := by
    funext w; exact Matrix.det_fin_three _
  
  obtain ⟨K, hK0, hKb⟩ : ∃ K : ℝ, 0 ≤ K ∧ ∀ z ∈ closedBall y R,
      ∑ i : Fin 3, ∑ j : Fin 3, |G z i j| ≤ K * (G z).det := by
    have hc : ∀ i j, ContinuousOn (fun z => G z i j) (closedBall y R) :=
      fun i j => ((hG i j).continuousOn).mono hB
    have hdc : ContinuousOn (fun z => (G z).det) (closedBall y R) := by
      rw [hdetfun]
      have t1 := ((hc 0 0).mul (hc 1 1)).mul (hc 2 2)
      have t2 := ((hc 0 0).mul (hc 1 2)).mul (hc 2 1)
      have t3 := ((hc 0 1).mul (hc 1 0)).mul (hc 2 2)
      have t4 := ((hc 0 1).mul (hc 1 2)).mul (hc 2 0)
      have t5 := ((hc 0 2).mul (hc 1 0)).mul (hc 2 1)
      have t6 := ((hc 0 2).mul (hc 1 1)).mul (hc 2 0)
      exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
    have hnum : ContinuousOn (fun z => ∑ i : Fin 3, ∑ j : Fin 3, |G z i j|) (closedBall y R) :=
      continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ => (hc i j).abs))
    have hf := hnum.div hdc (fun z hz => (hdet z (hB hz)).ne')
    obtain ⟨C, hC⟩ := (isCompact_closedBall y R).exists_bound_of_continuousOn hf
    refine ⟨max C 0, le_max_right _ _, fun z hz => ?_⟩
    have hd := hdet z (hB hz)
    have h1 := hC z hz
    rw [Real.norm_eq_abs] at h1
    have h2 : (∑ i : Fin 3, ∑ j : Fin 3, |G z i j|) / (G z).det ≤ max C 0 :=
      (le_abs_self _).trans (h1.trans (le_max_left _ _))
    exact (div_le_iff₀ hd).mp h2
  refine ⟨K + 1, by linarith, fun S => ?_⟩
  have hK1 : 0 < K + 1 := by linarith
  unfold sepPerG
  apply iSup₂_le
  rintro X ⟨hXs, hXc, hXt, hXn⟩
  set lam : ℝ := 1 / (K + 1) with hlam
  set X' : E3 → E3 := fun z => (lam / Real.sqrt (G z).det) • X z with hX'
  have hXU : tsupport X ⊆ U := hXt.trans (ball_subset_closedBall.trans hB)
  
  have hsm : ContDiff ℝ ∞ X' := by
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ U
    · have hn := hU.mem_nhds hz
      have hc : ∀ i j, ContDiffAt ℝ ∞ (fun w => G w i j) z := fun i j => (hG i j).contDiffAt hn
      have hd : ContDiffAt ℝ ∞ (fun w => (G w).det) z := by
        rw [hdetfun]
        have t1 := ((hc 0 0).mul (hc 1 1)).mul (hc 2 2)
        have t2 := ((hc 0 0).mul (hc 1 2)).mul (hc 2 1)
        have t3 := ((hc 0 1).mul (hc 1 0)).mul (hc 2 2)
        have t4 := ((hc 0 1).mul (hc 1 2)).mul (hc 2 0)
        have t5 := ((hc 0 2).mul (hc 1 0)).mul (hc 2 1)
        have t6 := ((hc 0 2).mul (hc 1 1)).mul (hc 2 0)
        exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
      have hs : ContDiffAt ℝ ∞ (fun w => Real.sqrt (G w).det) z := hd.sqrt (hdet z hz).ne'
      have hq : ContDiffAt ℝ ∞ (fun w => lam / Real.sqrt (G w).det) z :=
        contDiffAt_const.div hs (Real.sqrt_pos.2 (hdet z hz)).ne'
      exact hq.smul hXs.contDiffAt
    · have hzt : z ∉ tsupport X := fun h => hz (hXU h)
      rw [notMem_tsupport_iff_eventuallyEq] at hzt
      have hev : X' =ᶠ[𝓝 z] fun _ => 0 := by
        filter_upwards [hzt] with w hw
        simp [hX', hw]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  
  have hcs : HasCompactSupport X' := by
    show HasCompactSupport ((fun z => lam / Real.sqrt (G z).det) • X)
    exact hXc.smul_left
  have hts : tsupport X' ⊆ ball y R :=
    (tsupport_smul_subset_right (fun z => lam / Real.sqrt (G z).det) X).trans hXt
  
  have hquad : ∀ z, ∑ i : Fin 3, ∑ j : Fin 3, G z i j * X' z i * X' z j ≤ 1 := by
    intro z
    by_cases hz : z ∈ closedBall y R
    · have hd := hdet z (hB hz)
      have hA := hKb z hz
      have hv := hXn z
      set v := X z with hv_def
      set d := (G z).det with hd_def
      have hv' : v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 ≤ 1 := by
        simp [Fin.sum_univ_three, Matrix.one_apply] at hv
        nlinarith [hv]
      have hvi : ∀ i, |v i| ≤ 1 := by
        have h0 : v 0 ^ 2 ≤ 1 := by nlinarith [sq_nonneg (v 1), sq_nonneg (v 2)]
        have h1 : v 1 ^ 2 ≤ 1 := by nlinarith [sq_nonneg (v 0), sq_nonneg (v 2)]
        have h2 : v 2 ^ 2 ≤ 1 := by nlinarith [sq_nonneg (v 0), sq_nonneg (v 1)]
        intro i
        fin_cases i
        · exact (sq_le_one_iff_abs_le_one _).1 h0
        · exact (sq_le_one_iff_abs_le_one _).1 h1
        · exact (sq_le_one_iff_abs_le_one _).1 h2
      set a : ℝ := lam / Real.sqrt d with ha
      have hX'z : ∀ i, X' z i = a * v i := by
        intro i
        simp [hX', ha, hv_def, hd_def]
      have hQ : ∑ i : Fin 3, ∑ j : Fin 3, G z i j * v i * v j ≤ K * d := by
        refine le_trans ?_ hA
        refine Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun j _ => ?_))
        calc G z i j * v i * v j ≤ |G z i j * v i * v j| := le_abs_self _
          _ = |G z i j| * |v i| * |v j| := by rw [abs_mul, abs_mul]
          _ ≤ |G z i j| * 1 * 1 := by gcongr <;> exact hvi _
          _ = |G z i j| := by ring
      have hsum : ∑ i : Fin 3, ∑ j : Fin 3, G z i j * X' z i * X' z j =
          a ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G z i j * v i * v j := by
        simp only [hX'z, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
        ring
      have ha2 : a ^ 2 * d = lam ^ 2 := by
        rw [ha, div_pow, Real.sq_sqrt hd.le]
        field_simp
      rw [hsum]
      calc a ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G z i j * v i * v j ≤ a ^ 2 * (K * d) := by
            gcongr
        _ = K * lam ^ 2 := by rw [← ha2]; ring
        _ ≤ 1 := by
            rw [hlam, div_pow, one_pow, mul_one_div, div_le_one (by positivity)]
            nlinarith
    · have hXz : X z = 0 := by
        by_contra h
        exact hz (ball_subset_closedBall (hXt (subset_tsupport _ (Function.mem_support.2 h))))
      simp [hX', hXz]
  
  have hXd : Differentiable ℝ X := hXs.differentiable (by simp)
  have hdiv : ∀ w, sepDensDiv G X' w =
      lam * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X w := by
    intro w
    have hfun : ∀ i : Fin 3, (fun z => Real.sqrt (G z).det * X' z i) = fun z => lam * X z i := by
      intro i
      funext z
      by_cases hXz : X z = 0
      · simp [hX', hXz]
      · have hzU : z ∈ U := hXU (subset_tsupport _ (Function.mem_support.2 hXz))
        have hs := Real.sqrt_pos.2 (hdet z hzU)
        simp only [hX', PiLp.smul_apply, smul_eq_mul]
        field_simp
    have hone : ∀ i : Fin 3, (fun z => Real.sqrt ((fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) z).det
        * X z i) = fun z => X z i := by
      intro i
      funext z
      simp
    have hdi : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => X z i) w := by
      intro i
      exact ((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).differentiableAt).comp w (hXd w)
    unfold sepDensDiv
    simp only [hfun, hone, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    unfold partialDeriv
    rw [fderiv_const_mul (hdi i)]
    rfl
  have hint : ∫ z in S, sepDensDiv G X' z =
      lam * ∫ z in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z := by
    rw [← integral_const_mul]
    congr 1
    funext z
    exact hdiv z
  calc ENNReal.ofReal (∫ z in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z)
      = ENNReal.ofReal ((K + 1) *
          (lam * ∫ z in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z)) := by
        congr 1
        rw [hlam]
        field_simp
    _ = ENNReal.ofReal (K + 1) * ENNReal.ofReal
          (lam * ∫ z in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z) :=
        ENNReal.ofReal_mul hK1.le
    _ ≤ _ := by
        gcongr
        rw [← hint]
        exact le_iSup₂_of_le (f := fun (X : E3 → E3) (_ : ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
          tsupport X ⊆ ball y R ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) =>
          ENNReal.ofReal (∫ y in S, sepDensDiv G X y)) X' ⟨hsm, hcs, hts, hquad⟩ le_rfl

theorem sepPerG_one_translate_le (S : Set E3) (y h : E3) (r : ℝ) (hS : MeasurableSet S)
    (hr : 0 < r) (hh : ‖h‖ ≤ r) :
    volume (symmDiff S ((fun x => x + h) ⁻¹' S) ∩ ball y r) ≤
      ENNReal.ofReal (2 * ‖h‖) *
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (ball y (3 * r)) :=
by
  classical
  
  have sepTransAvg_contDiff : ∀ (φ : E3 → ℝ) (h : E3) (hφ : ContDiff ℝ ∞ φ)
      (hφc : HasCompactSupport φ),
      ContDiff ℝ ∞ (fun z : E3 => ∫ t in (0:ℝ)..1, φ (z - t • h)) := by
    intro φ h hφ hφc
    set ν : Measure ℝ := (volume : Measure ℝ).restrict (Set.Icc 0 1) with hν
    set μ : Measure E3 := Measure.map (fun t : ℝ => t • h) ν with hμ
    have hc := hφc.contDiff_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) (μ := μ)
      (f := fun _ : E3 => (1:ℝ)) (n := ⊤) (locallyIntegrable_const 1) hφ
    have heq : convolution (fun _ : E3 => (1:ℝ)) φ (ContinuousLinearMap.lsmul ℝ ℝ) μ =
        fun z => ∫ t in (0:ℝ)..1, φ (z - t • h) := by
      funext z
      rw [convolution_def]
      simp only [ContinuousLinearMap.lsmul_apply, one_smul]
      have hcz : Continuous (fun t : E3 => φ (z - t)) :=
        hφ.continuous.comp (continuous_const.sub continuous_id)
      rw [hμ, integral_map (f := fun t : E3 => φ (z - t))
        (by fun_prop : AEMeasurable (fun t : ℝ => t • h) ν) hcz.aestronglyMeasurable]
      rw [intervalIntegral.integral_of_le zero_le_one, hν, integral_Icc_eq_integral_Ioc]
    rw [← heq]
    exact hc
  
  have sepTransAvg_fderiv_apply : ∀ (φ : E3 → ℝ) (h z : E3) (hφ : Continuous φ)
      (hd : DifferentiableAt ℝ (fun w : E3 => ∫ t in (0:ℝ)..1, φ (w - t • h)) z),
      fderiv ℝ (fun w : E3 => ∫ t in (0:ℝ)..1, φ (w - t • h)) z h = φ z - φ (z - h) := by
    intro φ h z hφ hd
    set Ψ := fun w : E3 => ∫ t in (0:ℝ)..1, φ (w - t • h) with hΨ
    set F : ℝ → ℝ := fun u => φ (z - u • h) with hF
    have hFc : Continuous F := hφ.comp (continuous_const.sub (continuous_id.smul continuous_const))
    set G : ℝ → ℝ := fun v => ∫ u in (0:ℝ)..v, F u with hG
    have hGd : ∀ v, HasDerivAt G (F v) v := fun v =>
      (hFc.integral_hasStrictDerivAt 0 v).hasDerivAt
    have hγ : HasDerivAt (fun s : ℝ => z + s • h) ((1:ℝ) • h) 0 :=
      ((hasDerivAt_id (0:ℝ)).smul_const h).const_add z
    have h1 : HasDerivAt (Ψ ∘ fun s : ℝ => z + s • h) (fderiv ℝ Ψ z ((1:ℝ) • h)) 0 :=
      hd.hasFDerivAt.comp_hasDerivAt_of_eq 0 hγ (by simp)
    have hid : (Ψ ∘ fun s : ℝ => z + s • h) = fun s => G (1 - s) - G (0 - s) := by
      funext s
      have e1 : (fun t : ℝ => φ (z + s • h - t • h)) = fun t => F (t - s) := by
        funext t
        show φ (z + s • h - t • h) = φ (z - (t - s) • h)
        congr 1
        rw [sub_smul]
        abel
      show (∫ t in (0:ℝ)..1, φ (z + s • h - t • h)) =
        (∫ u in (0:ℝ)..(1 - s), F u) - ∫ u in (0:ℝ)..(0 - s), F u
      rw [e1, intervalIntegral.integral_comp_sub_right (fun t => F t) s,
        intervalIntegral.integral_interval_sub_left (hFc.intervalIntegrable _ _)
          (hFc.intervalIntegrable _ _)]
    have h2 : HasDerivAt (fun s => G (1 - s) - G (0 - s)) (-F (1 - 0) - -F (0 - 0)) 0 :=
      ((hGd (1 - 0)).comp_const_sub 1 0).sub ((hGd (0 - 0)).comp_const_sub 0 0)
    rw [hid] at h1
    have h3 := h1.unique h2
    rw [one_smul] at h3
    rw [h3]
    simp only [F, sub_zero, one_smul, zero_smul]
    ring
  
  have sepTransAvg_support : ∀ (φ : E3 → ℝ) (h y : E3) (r : ℝ) (hφc : HasCompactSupport φ)
      (hsupp : tsupport φ ⊆ ball y r) (hb : ∀ x, |φ x| ≤ 1) (hh : ‖h‖ ≤ r),
      HasCompactSupport (fun z : E3 => ∫ t in (0:ℝ)..1, φ (z - t • h)) ∧
        tsupport (fun z : E3 => ∫ t in (0:ℝ)..1, φ (z - t • h)) ⊆ ball y (2 * r) ∧
        ∀ z : E3, |∫ t in (0:ℝ)..1, φ (z - t • h)| ≤ 1 := by
    intro φ h y r hφc hsupp hb hh
    set C : Set E3 := (fun p : E3 × ℝ => p.1 + p.2 • h) '' (tsupport φ ×ˢ Set.Icc (0:ℝ) 1)
      with hC
    have hCc : IsCompact C := (hφc.prod isCompact_Icc).image (by fun_prop)
    have hvan : ∀ z, z ∉ C → (∫ t in (0:ℝ)..1, φ (z - t • h)) = 0 := by
      intro z hz
      rw [intervalIntegral.integral_congr (g := fun _ => (0:ℝ)) ?_, intervalIntegral.integral_zero]
      intro t ht
      rw [Set.uIcc_of_le zero_le_one] at ht
      by_contra hne
      exact hz ⟨(z - t • h, t), ⟨subset_tsupport _ hne, ht⟩, by simp⟩
    have hsuppC : Function.support (fun z => ∫ t in (0:ℝ)..1, φ (z - t • h)) ⊆ C := by
      intro z hz
      by_contra h'
      exact hz (hvan z h')
    refine ⟨HasCompactSupport.intro hCc hvan, ?_, ?_⟩
    · refine (closure_minimal hsuppC hCc.isClosed).trans ?_
      rintro _ ⟨⟨k, t⟩, ⟨hk, ht⟩, rfl⟩
      have hk' := hsupp hk
      rw [mem_ball] at hk' ⊢
      have htn : ‖t • h‖ ≤ r := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
        nlinarith [ht.2, ht.1, norm_nonneg h]
      calc dist (k + t • h) y = ‖(k - y) + t • h‖ := by
            rw [dist_eq_norm]; congr 1; abel
        _ ≤ ‖k - y‖ + ‖t • h‖ := norm_add_le _ _
        _ < r + r := by rw [← dist_eq_norm]; linarith
        _ = 2 * r := by ring
    · intro z
      have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1) (C := 1)
        (f := fun t => φ (z - t • h)) (fun t _ => by rw [Real.norm_eq_abs]; exact hb _)
      simpa [Real.norm_eq_abs] using this
  
  have sepPerG_one_pairing_of_potential : ∀ (S U : Set E3) (h : E3) (φ Ψ : E3 → ℝ)
      (hΨ : ContDiff ℝ ∞ Ψ) (hΨc : HasCompactSupport Ψ) (hΨs : tsupport Ψ ⊆ U)
      (hΨb : ∀ z, |Ψ z| ≤ 1) (hΨd : ∀ z, fderiv ℝ Ψ z h = φ z - φ (z - h)),
      ENNReal.ofReal (∫ x in S, (φ (x - h) - φ x)) ≤
        ENNReal.ofReal ‖h‖ * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S U := by
    intro S U h φ Ψ hΨ hΨc hΨs hΨb hΨd
    by_cases h0 : h = 0
    · subst h0
      simp
    have hn : ‖h‖ ≠ 0 := norm_ne_zero_iff.mpr h0
    set c : ℝ := -‖h‖⁻¹ with hc
    set X : E3 → E3 := fun z => (c * Ψ z) • h with hX
    have hXs : Function.support X ⊆ Function.support Ψ := by
      intro z hz
      rw [Function.mem_support] at hz ⊢
      intro h0'
      apply hz
      simp [X, h0']
    have hXadm : ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ U ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j *
          X y i * X y j ≤ 1 := by
      refine ⟨(contDiff_const.mul hΨ).smul contDiff_const,
        hΨc.mono' (hXs.trans (subset_tsupport _)), (closure_mono hXs).trans hΨs, ?_⟩
      intro z
      have hnsq : ‖h‖ ^ 2 = h 0 ^ 2 + h 1 ^ 2 + h 2 ^ 2 := by
        rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
        simp [sq_abs]
      have hcc : c ^ 2 * ‖h‖ ^ 2 = 1 := by
        rw [hc]
        field_simp
      have hsum : ∑ i : Fin 3, ∑ j : Fin 3, (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) z i j *
          X z i * X z j = (Ψ z) ^ 2 := by
        simp only [Fin.sum_univ_three, Matrix.one_apply, X, PiLp.smul_apply, smul_eq_mul]
        simp
        linear_combination (Ψ z) ^ 2 * hcc - c ^ 2 * (Ψ z) ^ 2 * hnsq
      rw [hsum]
      exact (sq_le_one_iff_abs_le_one _).2 (hΨb z)
    have hle : ENNReal.ofReal (∫ x in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X x)
        ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S U := by
      unfold sepPerG
      exact le_iSup_of_le X (le_iSup_of_le hXadm le_rfl)
    have hdiv : ∀ z, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X z =
        ‖h‖⁻¹ * (φ (z - h) - φ z) := by
      intro z
      have hfun : ∀ i : Fin 3, (fun w => Real.sqrt ((fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) w).det
          * X w i) = fun w => (c * h i) * Ψ w := by
        intro i
        funext w
        simp [X]
        ring
      have hdiff : DifferentiableAt ℝ Ψ z := hΨ.differentiable (by simp) z
      have hhe : h = h 0 • e 0 + h 1 • e 1 + h 2 • e 2 := by
        ext j
        fin_cases j <;> simp [e]
      unfold sepDensDiv partialDeriv
      simp only [hfun, fderiv_const_mul hdiff, ContinuousLinearMap.smul_apply, smul_eq_mul,
        Fin.sum_univ_three]
      have hfd : fderiv ℝ Ψ z h = h 0 * fderiv ℝ Ψ z (e 0) + h 1 * fderiv ℝ Ψ z (e 1) +
          h 2 * fderiv ℝ Ψ z (e 2) := by
        conv_lhs => rw [hhe]
        simp only [map_add, map_smul, smul_eq_mul]
      rw [hΨd z] at hfd
      rw [hc]
      linear_combination ‖h‖⁻¹ * hfd
    have hI : ∫ x in S, (φ (x - h) - φ x) =
        ‖h‖ * ∫ x in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X x := by
      simp_rw [hdiv]
      rw [integral_const_mul]
      field_simp
    rw [hI, ENNReal.ofReal_mul (norm_nonneg _)]
    exact mul_le_mul_left' hle _
  
  have sepSmooth_indicator_approx : ∀ (A : Set E3) (y : E3) (r ε : ℝ) (hA : MeasurableSet A)
      (hAB : A ⊆ ball y r) (hε : 0 < ε),
      ∃ φ : E3 → ℝ, ContDiff ℝ ∞ φ ∧ HasCompactSupport φ ∧ tsupport φ ⊆ ball y r ∧
        (∀ x, 0 ≤ φ x ∧ φ x ≤ 1) ∧
        ∀ w : E3 → ℝ, Measurable w → (∀ x, |w x| ≤ 1) → (∀ x ∈ A, w x = 1) →
          (volume A).toReal - ε ≤ ∫ x, φ x * w x := by
    intro A y r ε hA hAB hε
    have hAfin : volume A ≠ ⊤ := ((measure_mono hAB).trans_lt measure_ball_lt_top).ne
    have hδ : ENNReal.ofReal (ε / 4) ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero, not_le]
      linarith
    obtain ⟨K, hKA, hKc, hKd⟩ := hA.exists_isCompact_diff_lt hAfin hδ
    obtain ⟨O', hAO', hO'o, -, hO'd⟩ := hA.exists_isOpen_diff_lt hAfin hδ
    set O : Set E3 := O' ∩ ball y r with hOdef
    have hOo : IsOpen O := hO'o.inter isOpen_ball
    have hAO : A ⊆ O := Set.subset_inter hAO' hAB
    have hKO : K ⊆ O := hKA.trans hAO
    obtain ⟨V, hVo, hKV, hVO, hVc⟩ := exists_open_between_and_isCompact_closure hKc hOo hKO
    obtain ⟨f, hf, hfr, hfs, hf1⟩ :=
      exists_contMDiff_support_eq_eq_one_iff 𝓘(ℝ, E3) (n := ⊤) hVo hKc.isClosed hKV
    have hfc : ContDiff ℝ ∞ f := contMDiff_iff_contDiff.mp hf
    have hts : tsupport f = closure V := by
      show closure (Function.support f) = closure V
      rw [hfs]
    have hfcs : HasCompactSupport f := by
      show IsCompact (tsupport f)
      rw [hts]
      exact hVc
    have hf01 : ∀ x, f x ∈ Set.Icc (0:ℝ) 1 := fun x => hfr ⟨x, rfl⟩
    refine ⟨f, hfc, hfcs, ?_, fun x => hf01 x, ?_⟩
    · rw [hts]
      exact hVO.trans Set.inter_subset_right
    intro w hw hwb hwA
    have hOfin : volume O ≠ ⊤ :=
      ((measure_mono (Set.inter_subset_right : O ⊆ ball y r)).trans_lt measure_ball_lt_top).ne
    have hKm : MeasurableSet K := hKc.isClosed.measurableSet
    have hOKm : MeasurableSet (O \ K) := hOo.measurableSet.diff hKm
    have hOK : volume (O \ K) < ENNReal.ofReal (ε / 2) := by
      calc volume (O \ K) ≤ volume ((O' \ A) ∪ (A \ K)) := by
            apply measure_mono
            rintro x ⟨⟨hxO', -⟩, hxK⟩
            by_cases hxA : x ∈ A
            · exact Or.inr ⟨hxA, hxK⟩
            · exact Or.inl ⟨hxO', hxA⟩
        _ ≤ volume (O' \ A) + volume (A \ K) := measure_union_le _ _
        _ < ENNReal.ofReal (ε / 4) + ENNReal.ofReal (ε / 4) := ENNReal.add_lt_add hO'd hKd
        _ = ENNReal.ofReal (ε / 2) := by
            rw [← ENNReal.ofReal_add (by linarith) (by linarith)]
            congr 1
            ring
    have hOKr : volume.real (O \ K) < ε / 2 := ENNReal.toReal_lt_of_lt_ofReal hOK
    have hAOr : volume.real A ≤ volume.real O := measureReal_mono hAO hOfin
    have hOsplit : volume.real (O \ K) = volume.real O - volume.real K :=
      measureReal_diff hKO hKm hOfin
    have hfw_int : Integrable (fun x => f x * w x) := by
      have hfi : Integrable f := hfc.continuous.integrable_of_hasCompactSupport hfcs
      have h2 := hfi.bdd_mul (c := 1) hw.aestronglyMeasurable
        (Filter.Eventually.of_forall (fun x => by rw [Real.norm_eq_abs]; exact hwb x))
      simpa only [mul_comm] using h2
    have hKfin : volume K ≠ ⊤ := hKc.measure_lt_top.ne
    have hOKfin : volume (O \ K) ≠ ⊤ :=
      ((measure_mono (Set.diff_subset : O \ K ⊆ O)).trans_lt hOfin.lt_top).ne
    have hKi : Integrable (K.indicator (1 : E3 → ℝ)) :=
      (integrableOn_const hKfin).integrable_indicator hKm
    have hOKi : Integrable ((O \ K).indicator (1 : E3 → ℝ)) :=
      (integrableOn_const hOKfin).integrable_indicator hOKm
    have hpt : ∀ x, K.indicator (1 : E3 → ℝ) x - (O \ K).indicator (1 : E3 → ℝ) x ≤
        f x * w x := by
      intro x
      by_cases hxK : x ∈ K
      · have h1 : f x = 1 := (hf1 x).1 hxK
        have h2 : w x = 1 := hwA x (hKA hxK)
        simp [hxK, h1, h2]
      · by_cases hxO : x ∈ O
        · have hb1 := hf01 x
          have hb2 := abs_le.mp (hwb x)
          have hm : -1 ≤ f x * w x := by nlinarith [hb1.1, hb1.2, hb2.1, hb2.2]
          simp [hxK, hxO] <;> linarith
        · have h0 : f x = 0 := by
            by_contra hne
            have hx : x ∈ Function.support f := hne
            rw [hfs] at hx
            exact hxO (hVO (subset_closure hx))
          simp [hxK, hxO, h0]
    have hint : ∫ x, (K.indicator (1 : E3 → ℝ) x - (O \ K).indicator (1 : E3 → ℝ) x) ≤
        ∫ x, f x * w x := integral_mono (hKi.sub hOKi) hfw_int hpt
    rw [integral_sub hKi hOKi, integral_indicator_one hKm, integral_indicator_one hOKm] at hint
    have hAr : (volume A).toReal = volume.real A := rfl
    rw [hAr]
    rw [hOsplit] at hOKr hint
    linarith
  
  have sepTranslate_pairing_eq : ∀ (S : Set E3) (h : E3) (φ : E3 → ℝ) (hS : MeasurableSet S)
      (hφ : Continuous φ) (hφc : HasCompactSupport φ),
      ∫ x, φ x * (Set.indicator ((fun x => x + h) ⁻¹' S) (fun _ => (1:ℝ)) x -
        Set.indicator S (fun _ => (1:ℝ)) x) = ∫ x in S, (φ (x - h) - φ x) := by
    intro S h φ hS hφ hφc
    have hTm : MeasurableSet ((fun x => x + h) ⁻¹' S) := hS.preimage (measurable_add_const h)
    have hφi : Integrable φ := hφ.integrable_of_hasCompactSupport hφc
    have e1 : (fun x => φ x * (Set.indicator ((fun x => x + h) ⁻¹' S) (fun _ => (1:ℝ)) x -
        Set.indicator S (fun _ => (1:ℝ)) x)) =
        fun x => ((fun x => x + h) ⁻¹' S).indicator φ x - S.indicator φ x := by
      funext x
      by_cases h1 : x + h ∈ S <;> by_cases h2 : x ∈ S <;> simp [h1, h2]
    rw [e1, integral_sub (hφi.indicator hTm) (hφi.indicator hS), integral_indicator hS]
    have hφh : Integrable (fun x => φ (x - h)) := hφi.comp_sub_right h
    have e2 : ∫ x, ((fun x => x + h) ⁻¹' S).indicator φ x = ∫ x in S, φ (x - h) := by
      rw [← integral_indicator hS]
      refine Eq.trans ?_ (integral_add_right_eq_self
        (fun x => S.indicator (fun x => φ (x - h)) x) h)
      congr 1
      funext x
      by_cases h1 : x + h ∈ S <;> simp [h1]
    rw [e2, integral_sub hφh.integrableOn hφi.integrableOn]
  
  set P := sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (ball y (3 * r)) with hP
  set T := (fun x => x + h) ⁻¹' S with hT
  have hTm : MeasurableSet T := hS.preimage (measurable_add_const h)
  have key : ∀ E : Set E3, MeasurableSet E → E ⊆ ball y r → ∀ σ : ℝ, |σ| = 1 →
      (∀ x ∈ E, σ * (T.indicator (fun _ => (1:ℝ)) x - S.indicator (fun _ => (1:ℝ)) x) = 1) →
      volume E ≤ ENNReal.ofReal ‖h‖ * P := by
    intro E hE hEB σ hσ hEσ
    have hEfin : volume E ≠ ⊤ := ((measure_mono hEB).trans_lt measure_ball_lt_top).ne
    refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
    have hε' : (0 : ℝ) < ε := hε
    obtain ⟨φ, hφ, hφc, hφs, hφb, hφw⟩ := sepSmooth_indicator_approx E y r ε hE hEB hε'
    set w : E3 → ℝ := fun x =>
      σ * (T.indicator (fun _ => (1:ℝ)) x - S.indicator (fun _ => (1:ℝ)) x) with hw
    have hwm : Measurable w :=
      ((measurable_const.indicator hTm).sub (measurable_const.indicator hS)).const_mul σ
    have hwb : ∀ x, |w x| ≤ 1 := by
      intro x
      simp only [w, abs_mul, hσ, one_mul]
      by_cases h1 : x ∈ T <;> by_cases h2 : x ∈ S <;> simp [h1, h2]
    have h1 := hφw w hwm hwb hEσ
    set ψ : E3 → ℝ := fun x => σ * φ x with hψdef
    have hψ : ContDiff ℝ ∞ ψ := contDiff_const.mul hφ
    have hψc : HasCompactSupport ψ := hφc.mul_left
    have hψs : tsupport ψ ⊆ ball y r :=
      (closure_mono (Function.support_mul_subset_right _ _)).trans hφs
    have hψb : ∀ x, |ψ x| ≤ 1 := by
      intro x
      simp only [ψ, abs_mul, hσ, one_mul]
      rw [abs_of_nonneg (hφb x).1]
      exact (hφb x).2
    have hint : ∫ x, φ x * w x = ∫ x in S, (ψ (x - h) - ψ x) := by
      have e1 : (fun x => φ x * w x) = fun x => σ * (φ x *
          (T.indicator (fun _ => (1:ℝ)) x - S.indicator (fun _ => (1:ℝ)) x)) := by
        funext x; simp only [w]; ring
      rw [e1, integral_const_mul, sepTranslate_pairing_eq S h φ hS hφ.continuous hφc,
        ← integral_const_mul]
      congr 1
      funext x
      simp only [ψ]
      ring
    set Ψ : E3 → ℝ := fun z => ∫ t in (0:ℝ)..1, ψ (z - t • h) with hΨdef
    have hΨ : ContDiff ℝ ∞ Ψ := sepTransAvg_contDiff ψ h hψ hψc
    obtain ⟨hΨc, hΨs, hΨb⟩ := sepTransAvg_support ψ h y r hψc hψs hψb hh
    have hΨd : ∀ z, fderiv ℝ Ψ z h = ψ z - ψ (z - h) := fun z =>
      sepTransAvg_fderiv_apply ψ h z hψ.continuous (hΨ.differentiable (by simp) z)
    have hB := sepPerG_one_pairing_of_potential S (ball y (3 * r)) h ψ Ψ hΨ hΨc
      (hΨs.trans (ball_subset_ball (by linarith))) hΨb hΨd
    have h2 : ENNReal.ofReal ((volume E).toReal - ε) ≤ ENNReal.ofReal ‖h‖ * P := by
      refine le_trans (ENNReal.ofReal_le_ofReal h1) ?_
      rw [hint]
      exact hB
    calc volume E = ENNReal.ofReal ((volume E).toReal - ε + ε) := by
          rw [sub_add_cancel, ENNReal.ofReal_toReal hEfin]
      _ ≤ ENNReal.ofReal ((volume E).toReal - ε) + ENNReal.ofReal ε := ENNReal.ofReal_add_le
      _ ≤ ENNReal.ofReal ‖h‖ * P + ε := by
          rw [ENNReal.ofReal_coe_nnreal]
          gcongr
  have hsub : symmDiff S T ∩ ball y r ⊆ ((S \ T) ∩ ball y r) ∪ ((T \ S) ∩ ball y r) := by
    rw [Set.symmDiff_def, Set.union_inter_distrib_right]
  have hA := key ((S \ T) ∩ ball y r) ((hS.diff hTm).inter measurableSet_ball)
    Set.inter_subset_right (-1) (by simp) (by
      rintro x ⟨⟨hxS, hxT⟩, -⟩
      simp [hxS, hxT])
  have hB := key ((T \ S) ∩ ball y r) ((hTm.diff hS).inter measurableSet_ball)
    Set.inter_subset_right 1 (by simp) (by
      rintro x ⟨⟨hxT, hxS⟩, -⟩
      simp [hxS, hxT])
  calc volume (symmDiff S T ∩ ball y r)
      ≤ volume (((S \ T) ∩ ball y r) ∪ ((T \ S) ∩ ball y r)) := measure_mono hsub
    _ ≤ volume ((S \ T) ∩ ball y r) + volume ((T \ S) ∩ ball y r) := measure_union_le _ _
    _ ≤ ENNReal.ofReal ‖h‖ * P + ENNReal.ofReal ‖h‖ * P := add_le_add hA hB
    _ = ENNReal.ofReal (2 * ‖h‖) * P := by
        rw [ENNReal.ofReal_mul (by norm_num : (0:ℝ) ≤ 2), ENNReal.ofReal_ofNat, mul_assoc,
          two_mul]

theorem sepSets_cauchy_subseq (y : E3) (r C : ℝ) (hr : 0 < r) (S : ℕ → Set E3)
    (hS : ∀ n, MeasurableSet (S n))
    (hmod : ∀ (n : ℕ) (h : E3), ‖h‖ ≤ r →
      volume (symmDiff (S n) ((fun x => x + h) ⁻¹' S n) ∩ ball y r) ≤ ENNReal.ofReal (C * ‖h‖)) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n m : ℕ, N ≤ n → N ≤ m →
      volume (symmDiff (S (φ n)) (S (φ m)) ∩ ball y (r / 2)) < ENNReal.ofReal ε :=
by
  classical
  
  
  
  have sepSets_extract_cauchy : ∀ (D : ℕ → ℕ → ENNReal), (∀ ε : ℝ, 0 < ε → ∃ (K : ℕ)
      (v : ℕ → Fin K → ℝ) (c : ℝ), (∀ n j, 0 ≤ v n j ∧ v n j ≤ 1) ∧
        ∀ n m, D n m ≤ ENNReal.ofReal (ε + c * ∑ j, |v n j - v m j|)) →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n m : ℕ, N ≤ n → N ≤ m →
        D (φ n) (φ m) < ENNReal.ofReal ε := by
    intro D happrox
    choose K v c hv hD using fun k : ℕ => happrox (1 / ((k : ℝ) + 1)) (by positivity)
    let a : ℕ → (ℕ × ℕ → ℝ) := fun n p => if h : p.2 < K p.1 then v p.1 n ⟨p.2, h⟩ else 0
    have ha : ∀ n, a n ∈ Set.univ.pi (fun _ : ℕ × ℕ => Set.Icc (0:ℝ) 1) := by
      intro n p _
      simp only [a]
      split_ifs with h
      · exact ⟨(hv p.1 n ⟨p.2, h⟩).1, (hv p.1 n ⟨p.2, h⟩).2⟩
      · exact ⟨le_rfl, zero_le_one⟩
    obtain ⟨alim, -, φ, hφ, hlim⟩ :=
      (isCompact_univ_pi (fun _ : ℕ × ℕ => isCompact_Icc (a := (0:ℝ)) (b := 1))).tendsto_subseq ha
    refine ⟨φ, hφ, fun ε hε => ?_⟩
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt (half_pos hε)
    set δ := ε / (2 * (|c k| + 1) * ((K k : ℝ) + 1)) with hδ
    have hδpos : 0 < δ := by positivity
    have hcoord : ∀ j : Fin (K k), ∃ N : ℕ, ∀ n m : ℕ, N ≤ n → N ≤ m →
        |v k (φ n) j - v k (φ m) j| < δ := by
      intro j
      have h1 : Tendsto (fun n => a (φ n) (k, j.val)) atTop (𝓝 (alim (k, j.val))) :=
        (tendsto_pi_nhds.1 hlim) (k, j.val)
      have h2 := h1.cauchySeq
      rw [Metric.cauchySeq_iff] at h2
      obtain ⟨N, hN⟩ := h2 δ hδpos
      refine ⟨N, fun n m hn hm => ?_⟩
      have := hN n hn m hm
      simpa [a, j.isLt, Real.dist_eq] using this
    choose Nj hNj using hcoord
    refine ⟨Finset.univ.sup Nj, fun n m hn hm => ?_⟩
    have hb : ∀ j, |v k (φ n) j - v k (φ m) j| < δ := fun j =>
      hNj j n m ((Finset.le_sup (Finset.mem_univ j)).trans hn)
        ((Finset.le_sup (Finset.mem_univ j)).trans hm)
    have hsum : ∑ j, |v k (φ n) j - v k (φ m) j| ≤ (K k : ℝ) * δ := by
      calc _ ≤ ∑ j : Fin (K k), δ := Finset.sum_le_sum fun j _ => (hb j).le
        _ = K k * δ := by simp
    have hS0 : 0 ≤ ∑ j, |v k (φ n) j - v k (φ m) j| :=
      Finset.sum_nonneg fun j _ => abs_nonneg _
    have hK : (0:ℝ) ≤ K k := Nat.cast_nonneg _
    have hc : 0 ≤ |c k| := abs_nonneg _
    have hfrac : |c k| * K k / ((|c k| + 1) * (K k + 1)) < 1 := by
      rw [div_lt_one (by positivity)]; nlinarith
    have heq : |c k| * (↑(K k) * δ) = ε / 2 * (|c k| * K k / ((|c k| + 1) * (K k + 1))) := by
      rw [hδ]; field_simp
    have hcs : c k * ∑ j, |v k (φ n) j - v k (φ m) j| < ε / 2 := by
      calc c k * ∑ j, |v k (φ n) j - v k (φ m) j|
          ≤ |c k| * ∑ j, |v k (φ n) j - v k (φ m) j| :=
            mul_le_mul_of_nonneg_right (le_abs_self _) hS0
        _ ≤ |c k| * (K k * δ) := mul_le_mul_of_nonneg_left hsum hc
        _ < ε / 2 := by rw [heq]; nlinarith
    calc D (φ n) (φ m)
        ≤ ENNReal.ofReal (1 / ((k:ℝ) + 1) + c k * ∑ j, |v k (φ n) j - v k (φ m) j|) :=
          hD k (φ n) (φ m)
      _ < ENNReal.ofReal ε := (ENNReal.ofReal_lt_ofReal_iff hε).2 (by linarith)
  
  
  
  have sepSets_cube_deficiency : ∀ (T Q H : Set E3), MeasurableSet T → MeasurableSet Q →
      MeasurableSet H → (∀ x ∈ Q, ∀ x' ∈ Q, x' - x ∈ H) →
      volume (T ∩ Q) * volume (Q \ T) ≤
        ∫⁻ h in H, volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ Q) := by
    intro T Q H hT hQ hH hQH
    have hA : MeasurableSet (T ∩ Q) := hT.inter hQ
    have hP : MeasurableSet (Q \ T) := hQ.diff hT
    set E : Set (E3 × E3) := {p | p.2 ∈ H ∧ p.1 ∈ Q ∧ p.1 ∈ T ∧ p.1 + p.2 ∉ T} with hE
    have hEm : MeasurableSet E := by
      have h1 : Measurable (fun p : E3 × E3 => p.1 + p.2) := measurable_fst.add measurable_snd
      exact (measurable_snd hH).inter ((measurable_fst hQ).inter
        ((measurable_fst hT).inter (h1 hT).compl))
    have hpres := measurePreserving_prod_add (volume : Measure E3) (volume : Measure E3)
    calc volume (T ∩ Q) * volume (Q \ T)
        = ((volume : Measure E3).prod (volume : Measure E3)) ((T ∩ Q) ×ˢ (Q \ T)) :=
          (Measure.prod_prod _ _).symm
      _ = ((volume : Measure E3).prod (volume : Measure E3))
            ((fun z : E3 × E3 => (z.1, z.1 + z.2)) ⁻¹' ((T ∩ Q) ×ˢ (Q \ T))) :=
          (hpres.measure_preimage (hA.prod hP).nullMeasurableSet).symm
      _ ≤ ((volume : Measure E3).prod (volume : Measure E3)) E := by
          apply measure_mono
          rintro ⟨x, h⟩ ⟨⟨hxT, hxQ⟩, hxhQ, hxhT⟩
          refine ⟨?_, hxQ, hxT, hxhT⟩
          have := hQH x hxQ (x + h) hxhQ
          simpa using this
      _ = ∫⁻ h, volume ((fun x => (x, h)) ⁻¹' E) := Measure.prod_apply_symm hEm
      _ = ∫⁻ h in H, volume (Q ∩ T ∩ ((fun x => x + h) ⁻¹' T)ᶜ) := by
          rw [← lintegral_indicator hH]
          congr 1
          funext h
          by_cases hh : h ∈ H
          · rw [Set.indicator_apply, if_pos hh]
            congr 1
            ext x
            simp only [hE, Set.mem_preimage, Set.mem_setOf_eq, Set.mem_inter_iff,
              Set.mem_compl_iff]
            tauto
          · rw [Set.indicator_apply, if_neg hh]
            have : (fun x => (x, h)) ⁻¹' E = ∅ := by
              ext x
              simp [hE, hh]
            rw [this, measure_empty]
      _ ≤ ∫⁻ h in H, volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ Q) := by
          refine lintegral_mono fun h => measure_mono ?_
          rintro x ⟨⟨hxQ, hxT⟩, hxn⟩
          exact ⟨Set.mem_symmDiff.2 (Or.inl ⟨hxT, hxn⟩), hxQ⟩
  
  
  
  have sepSets_symmDiff_le_cubes : ∀ (A B V : Set E3) (K : ℕ) (Q : Fin K → Set E3) (q : ℝ),
      MeasurableSet A → MeasurableSet B → (∀ j, MeasurableSet (Q j)) → 0 < q →
      (∀ j, volume (Q j) = ENNReal.ofReal q) → V ⊆ ⋃ j, Q j →
      (volume (symmDiff A B ∩ V)).toReal ≤
        2 / q * ∑ j, (volume (A ∩ Q j)).toReal * (volume (Q j \ A)).toReal +
        2 / q * ∑ j, (volume (B ∩ Q j)).toReal * (volume (Q j \ B)).toReal +
        ∑ j, |(volume (A ∩ Q j)).toReal - (volume (B ∩ Q j)).toReal| := by
    intro A B V K Q q hA hB hQ hq hvol hV
    have split : ∀ X Y : Set E3, MeasurableSet Y → volume X ≠ ⊤ →
        (volume X).toReal = (volume (X ∩ Y)).toReal + (volume (X \ Y)).toReal := by
      intro X Y hY hX
      rw [← measure_inter_add_diff X hY, ENNReal.toReal_add
        (ne_top_of_le_ne_top hX (measure_mono Set.inter_subset_left))
        (ne_top_of_le_ne_top hX (measure_mono Set.diff_subset))]
    have hcube : ∀ j, (volume (symmDiff A B ∩ Q j)).toReal ≤
        2 / q * ((volume (A ∩ Q j)).toReal * (volume (Q j \ A)).toReal) +
        2 / q * ((volume (B ∩ Q j)).toReal * (volume (Q j \ B)).toReal) +
        |(volume (A ∩ Q j)).toReal - (volume (B ∩ Q j)).toReal| := by
      intro j
      have hQf : volume (Q j) ≠ ⊤ := by rw [hvol j]; exact ENNReal.ofReal_ne_top
      have fin : ∀ X, X ⊆ Q j → volume X ≠ ⊤ := fun X hX =>
        ne_top_of_le_ne_top hQf (measure_mono hX)
      have e1 : B ∩ Q j ∩ A = A ∩ Q j ∩ B := by
        ext x; simp only [Set.mem_inter_iff]; tauto
      have e2 : (Q j \ A) ∩ B = (B ∩ Q j) \ A := by
        ext x; simp only [Set.mem_inter_iff, Set.mem_diff]; tauto
      have e3 : (Q j \ B) ∩ A = (A ∩ Q j) \ B := by
        ext x; simp only [Set.mem_inter_iff, Set.mem_diff]; tauto
      have e4 : (Q j \ B) \ A = (Q j \ A) \ B := by
        ext x; simp only [Set.mem_diff]; tauto
      have e5 : Q j ∩ A = A ∩ Q j := Set.inter_comm _ _
      have hα := split (A ∩ Q j) B hB (fin _ Set.inter_subset_right)
      have hβ := split (B ∩ Q j) A hA (fin _ Set.inter_subset_right)
      have hα' := split (Q j \ A) B hB (fin _ Set.diff_subset)
      have hβ' := split (Q j \ B) A hA (fin _ Set.diff_subset)
      have hqq := split (Q j) A hA hQf
      rw [e1] at hβ
      rw [e2] at hα'
      rw [e3, e4] at hβ'
      rw [e5] at hqq
      have hqr : (volume (Q j)).toReal = q := by rw [hvol j]; exact ENNReal.toReal_ofReal hq.le
      have hsd : (volume (symmDiff A B ∩ Q j)).toReal =
          (volume ((A ∩ Q j) \ B)).toReal + (volume ((B ∩ Q j) \ A)).toReal := by
        have hset : symmDiff A B ∩ Q j = ((A ∩ Q j) \ B) ∪ ((B ∩ Q j) \ A) := by
          ext x
          simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_union, Set.mem_symmDiff]
          tauto
        have hdis : Disjoint ((A ∩ Q j) \ B) ((B ∩ Q j) \ A) := by
          rw [Set.disjoint_left]
          intro x hx1 hx2
          exact hx1.2 hx2.1.1
        rw [hset, measure_union hdis (((hB.inter (hQ j))).diff hA), ENNReal.toReal_add
          (fin _ (fun x hx => hx.1.2)) (fin _ (fun x hx => hx.1.2))]
      set a := (volume (A ∩ Q j ∩ B)).toReal with ha
      set b := (volume ((A ∩ Q j) \ B)).toReal with hb
      set c := (volume ((B ∩ Q j) \ A)).toReal with hc
      set d := (volume ((Q j \ A) \ B)).toReal with hd
      have ha0 : 0 ≤ a := ENNReal.toReal_nonneg
      have hb0 : 0 ≤ b := ENNReal.toReal_nonneg
      have hc0 : 0 ≤ c := ENNReal.toReal_nonneg
      have hd0 : 0 ≤ d := ENNReal.toReal_nonneg
      rw [hsd, hα, hβ, hα', hβ']
      have hqs : q = a + b + c + d := by rw [← hqr, hqq, hα, hα']; ring
      have habs : |a + b - (a + c)| = |b - c| := by congr 1; ring
      rw [habs]
      have hpoly : q * (b + c) ≤
          2 * ((a + b) * (c + d)) + 2 * ((a + c) * (b + d)) + q * |b - c| := by
        rw [hqs]
        rcases le_total c b with hcb | hbc
        · rw [abs_of_nonneg (sub_nonneg.2 hcb)]
          nlinarith [mul_nonneg ha0 hb0, mul_nonneg ha0 hd0, mul_nonneg hb0 hd0,
            mul_nonneg hc0 (sub_nonneg.2 hcb)]
        · rw [abs_of_nonpos (sub_nonpos.2 hbc)]
          nlinarith [mul_nonneg ha0 hc0, mul_nonneg ha0 hd0, mul_nonneg hc0 hd0,
            mul_nonneg hb0 (sub_nonneg.2 hbc)]
      rw [← sub_nonneg]
      have hrw : 2 / q * ((a + b) * (c + d)) + 2 / q * ((a + c) * (b + d)) + |b - c| - (b + c) =
          (2 * ((a + b) * (c + d)) + 2 * ((a + c) * (b + d)) + q * |b - c| - q * (b + c)) / q := by
        field_simp
      rw [hrw]
      exact div_nonneg (by linarith) hq.le
    have hU : volume (symmDiff A B ∩ V) ≤ ∑ j, volume (symmDiff A B ∩ Q j) := by
      calc volume (symmDiff A B ∩ V) ≤ volume (⋃ j, symmDiff A B ∩ Q j) := by
            apply measure_mono
            intro x hx
            obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hV hx.2)
            exact Set.mem_iUnion.2 ⟨j, hx.1, hj⟩
        _ ≤ ∑ j, volume (symmDiff A B ∩ Q j) := measure_iUnion_fintype_le _ _
    have hfin : ∀ j, volume (symmDiff A B ∩ Q j) ≠ ⊤ := fun j =>
      ne_top_of_le_ne_top (by rw [hvol j]; exact ENNReal.ofReal_ne_top)
        (measure_mono Set.inter_subset_right)
    have hR : (volume (symmDiff A B ∩ V)).toReal ≤
        ∑ j, (volume (symmDiff A B ∩ Q j)).toReal := by
      rw [← ENNReal.toReal_sum (fun j _ => hfin j)]
      exact ENNReal.toReal_mono (ENNReal.sum_ne_top.2 (fun j _ => hfin j)) hU
    refine hR.trans ((Finset.sum_le_sum fun j _ => hcube j).trans (le_of_eq ?_))
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  
  
  
  have sepSets_cube_cover : ∀ (y : E3) (r s : ℝ), 0 < r → 0 < s → s ≤ r / 4 →
      ∃ (K : ℕ) (Q : Fin K → Set E3) (H : Set E3), (∀ j, MeasurableSet (Q j)) ∧
        (∀ j, volume (Q j) = ENNReal.ofReal (s ^ 3)) ∧
        Pairwise (fun i j => Disjoint (Q i) (Q j)) ∧ (∀ j, Q j ⊆ ball y r) ∧
        ball y (r / 2) ⊆ ⋃ j, Q j ∧ MeasurableSet H ∧ volume H ≤ ENNReal.ofReal (8 * s ^ 3) ∧
        (∀ h ∈ H, ‖h‖ ≤ 2 * s) ∧ (∀ j, ∀ x ∈ Q j, ∀ x' ∈ Q j, x' - x ∈ H) := by
    intro y r s _hr hs hsr
    have hLp := EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3)
    let cube : (Fin 3 → ℤ) → Set E3 := fun z =>
      (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm ⁻¹'
        (Set.univ.pi fun i => Set.Ico ((z i : ℝ) * s) (((z i : ℝ) + 1) * s))
    have mem_cube : ∀ z x, x ∈ cube z ↔
        ∀ i, (z i : ℝ) * s ≤ x i ∧ x i < ((z i : ℝ) + 1) * s := by
      intro z x
      simp only [cube, Set.mem_preimage, Set.mem_univ_pi, Set.mem_Ico]
      exact Iff.rfl
    have cube_meas : ∀ z, MeasurableSet (cube z) := fun z =>
      MeasurableEquiv.measurable _ (MeasurableSet.univ_pi fun i => measurableSet_Ico)
    have cube_vol : ∀ z, volume (cube z) = ENNReal.ofReal (s ^ 3) := by
      intro z
      show volume ((MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm ⁻¹'
        (Set.univ.pi fun i => Set.Ico ((z i : ℝ) * s) (((z i : ℝ) + 1) * s))) = _
      rw [hLp.measure_preimage
          (MeasurableSet.univ_pi fun i => measurableSet_Ico).nullMeasurableSet,
        Real.volume_pi_Ico]
      simp only [show ∀ i, ((z i : ℝ) + 1) * s - (z i : ℝ) * s = s from fun i => by ring]
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ENNReal.ofReal_pow hs.le]
    let H : Set E3 := (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm ⁻¹'
      (Set.univ.pi fun _ : Fin 3 => Set.Ioo (-s) s)
    have mem_H : ∀ h, h ∈ H ↔ ∀ i, -s < h i ∧ h i < s := by
      intro h
      simp only [H, Set.mem_preimage, Set.mem_univ_pi, Set.mem_Ioo]
      exact Iff.rfl
    have H_meas : MeasurableSet H :=
      MeasurableEquiv.measurable _ (MeasurableSet.univ_pi fun i => measurableSet_Ioo)
    have H_vol : volume H ≤ ENNReal.ofReal (8 * s ^ 3) := by
      apply le_of_eq
      show volume ((MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm ⁻¹'
        (Set.univ.pi fun _ : Fin 3 => Set.Ioo (-s) s)) = _
      rw [hLp.measure_preimage
          (MeasurableSet.univ_pi fun i => measurableSet_Ioo).nullMeasurableSet,
        Real.volume_pi_Ioo]
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin,
        ← ENNReal.ofReal_pow (by linarith)]
      congr 1
      ring
    have H_norm : ∀ h ∈ H, ‖h‖ ≤ 2 * s := by
      intro h hh
      rw [mem_H] at hh
      rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
      have hsq : ∀ i, ‖h i‖ ^ 2 ≤ s ^ 2 := by
        intro i
        rw [Real.norm_eq_abs, sq_abs]
        nlinarith [(hh i).1, (hh i).2]
      rw [show 2 * s = √((2 * s) ^ 2) from (Real.sqrt_sq (by linarith)).symm]
      apply Real.sqrt_le_sqrt
      nlinarith [hsq 0, hsq 1, hsq 2]
    have diff_H : ∀ z, ∀ x ∈ cube z, ∀ x' ∈ cube z, x' - x ∈ H := by
      intro z x hx x' hx'
      rw [mem_cube] at hx hx'
      rw [mem_H]
      intro i
      have h1 := hx i
      have h2 := hx' i
      have e : (x' - x) i = x' i - x i := by simp
      have e2 : ((z i : ℝ) + 1) * s = (z i : ℝ) * s + s := by ring
      rw [e]
      constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]
    have floor_eq : ∀ z x i, x ∈ cube z → ⌊x i / s⌋ = z i := by
      intro z x i hx
      rw [mem_cube] at hx
      rw [Int.floor_eq_iff]
      constructor
      · rw [le_div_iff₀ hs]; exact (hx i).1
      · rw [div_lt_iff₀ hs]; exact (hx i).2
    have cube_disj : ∀ z w, z ≠ w → Disjoint (cube z) (cube w) := by
      intro z w hzw
      rw [Set.disjoint_left]
      intro x hxz hxw
      apply hzw
      funext i
      exact (floor_eq z x i hxz).symm.trans (floor_eq w x i hxw)
    obtain ⟨M, hM⟩ : ∃ M : ℤ, M = ⌈(‖y‖ + r) / s⌉ + 1 := ⟨_, rfl⟩
    let Zall : Finset (Fin 3 → ℤ) := Fintype.piFinset fun _ => Finset.Icc (-M) M
    let Z : Finset (Fin 3 → ℤ) := Zall.filter (fun z => cube z ⊆ ball y r)
    let e := Z.equivFin
    refine ⟨Z.card, fun j => cube (e.symm j : Fin 3 → ℤ), H, fun j => cube_meas _,
      fun j => cube_vol _, ?_, ?_, ?_, H_meas, H_vol, H_norm, fun j => diff_H _⟩
    · intro i j hij
      apply cube_disj
      intro h
      exact hij (e.symm.injective (Subtype.ext h))
    · intro j
      exact (Finset.mem_filter.1 (e.symm j).2).2
    · intro x hx
      rw [mem_ball] at hx
      obtain ⟨z, hz⟩ : ∃ z : Fin 3 → ℤ, ∀ i, z i = ⌊x i / s⌋ := ⟨_, fun _ => rfl⟩
      have hxz : x ∈ cube z := by
        rw [mem_cube]
        intro i
        rw [hz i]
        constructor
        · rw [← le_div_iff₀ hs]; exact Int.floor_le _
        · rw [← div_lt_iff₀ hs]; exact Int.lt_floor_add_one _
      have hsub : cube z ⊆ ball y r := by
        intro x' hx'
        rw [mem_ball]
        have h1 : ‖x' - x‖ ≤ 2 * s := H_norm _ (diff_H z x hxz x' hx')
        calc dist x' y ≤ dist x' x + dist x y := dist_triangle _ _ _
          _ < 2 * s + r / 2 := by rw [dist_eq_norm x' x]; linarith
          _ ≤ r := by linarith
      have hzall : z ∈ Zall := by
        rw [Fintype.mem_piFinset]
        intro i
        rw [Finset.mem_Icc]
        have hxi : |x i| < ‖y‖ + r := by
          have h1 : ‖x i‖ ≤ ‖x‖ := PiLp.norm_apply_le x i
          have h2 : ‖x‖ ≤ ‖y‖ + dist x y := by
            rw [dist_eq_norm]
            calc ‖x‖ = ‖y + (x - y)‖ := by rw [add_sub_cancel]
              _ ≤ ‖y‖ + ‖x - y‖ := norm_add_le _ _
          rw [Real.norm_eq_abs] at h1
          linarith
        have hq : |x i / s| < (‖y‖ + r) / s := by
          rw [abs_div, abs_of_pos hs]
          exact div_lt_div_of_pos_right hxi hs
        obtain ⟨hlo, hhi⟩ := abs_lt.1 hq
        have hc := Int.le_ceil ((‖y‖ + r) / s)
        have hfl := Int.floor_le (x i / s)
        have hfl2 := Int.sub_one_lt_floor (x i / s)
        rw [← hz i] at hfl hfl2
        have h1 : (z i : ℝ) < ((⌈(‖y‖ + r) / s⌉ : ℤ) : ℝ) := by linarith
        have h1' : z i < ⌈(‖y‖ + r) / s⌉ := by exact_mod_cast h1
        have h2 : ((-⌈(‖y‖ + r) / s⌉ - 1 : ℤ) : ℝ) < (z i : ℝ) := by push_cast; linarith
        have h2' : -⌈(‖y‖ + r) / s⌉ - 1 < z i := by exact_mod_cast h2
        constructor <;> omega
      have hzZ : z ∈ Z := Finset.mem_filter.2 ⟨hzall, hsub⟩
      refine Set.mem_iUnion.2 ⟨e ⟨z, hzZ⟩, ?_⟩
      show x ∈ cube ((e.symm (e ⟨z, hzZ⟩)) : Fin 3 → ℤ)
      rw [Equiv.symm_apply_apply]
      exact hxz
  
  
  
  have sepSets_deficiency_sum_le : ∀ (T U H : Set E3) (K : ℕ) (Q : Fin K → Set E3)
      (b : ENNReal), MeasurableSet T → MeasurableSet H → (∀ j, MeasurableSet (Q j)) →
      Pairwise (fun i j => Disjoint (Q i) (Q j)) → (∀ j, Q j ⊆ U) →
      (∀ j, volume (T ∩ Q j) * volume (Q j \ T) ≤
        ∫⁻ h in H, volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ Q j)) →
      (∀ h ∈ H, volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ U) ≤ b) →
      ∑ j, volume (T ∩ Q j) * volume (Q j \ T) ≤ volume H * b := by
    intro T U H K Q b hT hH hQ hdisj hQU hcube hb
    set f : Fin K → E3 → ENNReal :=
      fun j h => volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ Q j) with hf
    have hsw : ∀ s : Finset (Fin K), ∑ j ∈ s, ∫⁻ h in H, f j h ≤ ∫⁻ h in H, ∑ j ∈ s, f j h := by
      intro s
      induction s using Finset.induction_on with
      | empty => simp
      | insert a s ha ih =>
        simp only [Finset.sum_insert ha]
        calc (∫⁻ h in H, f a h) + ∑ j ∈ s, ∫⁻ h in H, f j h
            ≤ (∫⁻ h in H, f a h) + ∫⁻ h in H, ∑ j ∈ s, f j h := add_le_add le_rfl ih
          _ ≤ ∫⁻ h in H, (f a h + ∑ j ∈ s, f j h) := le_lintegral_add _ _
    have hpt : ∀ h ∈ H, ∑ j, f j h ≤ b := by
      intro h hh
      have hX : MeasurableSet (symmDiff T ((fun x => x + h) ⁻¹' T)) :=
        hT.symmDiff (measurable_add_const h hT)
      calc ∑ j, f j h = volume (⋃ j, symmDiff T ((fun x => x + h) ⁻¹' T) ∩ Q j) := by
            rw [measure_iUnion (fun i j hij => (hdisj hij).mono Set.inter_subset_right
              Set.inter_subset_right) (fun j => hX.inter (hQ j)), tsum_fintype]
        _ ≤ volume (symmDiff T ((fun x => x + h) ⁻¹' T) ∩ U) :=
            measure_mono (Set.iUnion_subset fun j => Set.inter_subset_inter_right _ (hQU j))
        _ ≤ b := hb h hh
    calc ∑ j, volume (T ∩ Q j) * volume (Q j \ T) ≤ ∑ j, ∫⁻ h in H, f j h :=
          Finset.sum_le_sum fun j _ => hcube j
      _ ≤ ∫⁻ h in H, ∑ j, f j h := hsw _
      _ ≤ ∫⁻ h in H, b := setLIntegral_mono' hH hpt
      _ = volume H * b := by rw [setLIntegral_const, mul_comm]
  
  
  
  refine sepSets_extract_cauchy (fun n m => volume (symmDiff (S n) (S m) ∩ ball y (r / 2))) ?_
  intro ε hε
  set C' : ℝ := |C| with hC'
  have hC'0 : 0 ≤ C' := abs_nonneg C
  set s : ℝ := min (r / 4) (ε / (64 * (C' + 1))) with hs_def
  have hs : 0 < s := lt_min (by linarith) (div_pos hε (by positivity))
  have hsr : s ≤ r / 4 := min_le_left _ _
  have hsε : 64 * C' * s ≤ ε := by
    have h1 : s ≤ ε / (64 * (C' + 1)) := min_le_right _ _
    have h2 : 64 * C' * s ≤ 64 * C' * (ε / (64 * (C' + 1))) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    have h3 : 64 * C' * (ε / (64 * (C' + 1))) = ε * (C' / (C' + 1)) := by
      field_simp
    have h4 : C' / (C' + 1) ≤ 1 := (div_le_one (by linarith)).2 (by linarith)
    have h5 : ε * (C' / (C' + 1)) ≤ ε * 1 := mul_le_mul_of_nonneg_left h4 hε.le
    linarith
  obtain ⟨K, Q, H, hQm, hQvol, hQdisj, hQU, hcover, hHm, hHvol, hHnorm, hQH⟩ :=
    sepSets_cube_cover y r s hr hs hsr
  have hs3 : 0 < s ^ 3 := pow_pos hs 3
  have hQfin : ∀ j, volume (Q j) ≠ ⊤ := fun j => by rw [hQvol j]; exact ENNReal.ofReal_ne_top
  have hQreal : ∀ j, (volume (Q j)).toReal = s ^ 3 := fun j => by
    rw [hQvol j]; exact ENNReal.toReal_ofReal hs3.le
  have hle_Q : ∀ n j, (volume (S n ∩ Q j)).toReal ≤ s ^ 3 := fun n j => by
    rw [← hQreal j]; exact ENNReal.toReal_mono (hQfin j) (measure_mono Set.inter_subset_right)
  
  have hdef : ∀ n, ∑ j, (volume (S n ∩ Q j)).toReal * (volume (Q j \ S n)).toReal
      ≤ 16 * C' * s ^ 4 := by
    intro n
    have hcube : ∀ j, volume (S n ∩ Q j) * volume (Q j \ S n) ≤
        ∫⁻ h in H, volume (symmDiff (S n) ((fun x => x + h) ⁻¹' S n) ∩ Q j) :=
      fun j => sepSets_cube_deficiency (S n) (Q j) H (hS n) (hQm j) hHm (hQH j)
    have hb : ∀ h ∈ H, volume (symmDiff (S n) ((fun x => x + h) ⁻¹' S n) ∩ ball y r) ≤
        ENNReal.ofReal (2 * C' * s) := by
      intro h hh
      have hn : ‖h‖ ≤ 2 * s := hHnorm h hh
      refine (hmod n h (by linarith)).trans (ENNReal.ofReal_le_ofReal ?_)
      calc C * ‖h‖ ≤ C' * ‖h‖ := mul_le_mul_of_nonneg_right (le_abs_self C) (norm_nonneg _)
        _ ≤ C' * (2 * s) := mul_le_mul_of_nonneg_left hn hC'0
        _ = 2 * C' * s := by ring
    have hsum := sepSets_deficiency_sum_le (S n) (ball y r) H K Q (ENNReal.ofReal (2 * C' * s))
      (hS n) hHm hQm hQdisj hQU hcube hb
    have hsum' : ∑ j, volume (S n ∩ Q j) * volume (Q j \ S n) ≤
        ENNReal.ofReal (16 * C' * s ^ 4) := by
      refine hsum.trans ?_
      calc volume H * ENNReal.ofReal (2 * C' * s)
          ≤ ENNReal.ofReal (8 * s ^ 3) * ENNReal.ofReal (2 * C' * s) := by gcongr
        _ = ENNReal.ofReal (16 * C' * s ^ 4) := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          ring
    have hfin : ∀ j, volume (S n ∩ Q j) * volume (Q j \ S n) ≠ ⊤ := fun j =>
      ENNReal.mul_ne_top (ne_top_of_le_ne_top (hQfin j) (measure_mono Set.inter_subset_right))
        (ne_top_of_le_ne_top (hQfin j) (measure_mono Set.diff_subset))
    have key := ENNReal.toReal_le_of_le_ofReal (by positivity) hsum'
    rw [ENNReal.toReal_sum (fun j _ => hfin j)] at key
    simpa only [ENNReal.toReal_mul] using key
  refine ⟨K, fun n j => (volume (S n ∩ Q j)).toReal / s ^ 3, s ^ 3, ?_, ?_⟩
  · intro n j
    exact ⟨div_nonneg ENNReal.toReal_nonneg hs3.le, (div_le_one hs3).2 (hle_Q n j)⟩
  intro n m
  show volume (symmDiff (S n) (S m) ∩ ball y (r / 2)) ≤ ENNReal.ofReal (ε + s ^ 3 *
    ∑ j, |(volume (S n ∩ Q j)).toReal / s ^ 3 - (volume (S m ∩ Q j)).toReal / s ^ 3|)
  have hc3 := sepSets_symmDiff_le_cubes (S n) (S m) (ball y (r / 2)) K Q (s ^ 3) (hS n) (hS m)
    hQm hs3 hQvol hcover
  have hD_fin : volume (symmDiff (S n) (S m) ∩ ball y (r / 2)) ≠ ⊤ :=
    ne_top_of_le_ne_top measure_ball_lt_top.ne (measure_mono Set.inter_subset_right)
  rw [← ENNReal.ofReal_toReal hD_fin]
  apply ENNReal.ofReal_le_ofReal
  have e1 : ∀ k, 2 / s ^ 3 * ∑ j, (volume (S k ∩ Q j)).toReal * (volume (Q j \ S k)).toReal
      ≤ 32 * C' * s := by
    intro k
    calc _ ≤ 2 / s ^ 3 * (16 * C' * s ^ 4) := mul_le_mul_of_nonneg_left (hdef k) (by positivity)
      _ = 32 * C' * s := by field_simp; ring
  have e3 : ∑ j, |(volume (S n ∩ Q j)).toReal - (volume (S m ∩ Q j)).toReal| =
      s ^ 3 * ∑ j, |(volume (S n ∩ Q j)).toReal / s ^ 3 - (volume (S m ∩ Q j)).toReal / s ^ 3| := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← sub_div, abs_div, abs_of_pos hs3, mul_div_cancel₀ _ hs3.ne']
  have e1n := e1 n
  have e1m := e1 m
  rw [← e3]
  linarith

theorem sepSets_limit_of_cauchy (B : Set E3) (T : ℕ → Set E3) (hT : ∀ n, MeasurableSet (T n))
    (hcau : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n m : ℕ, N ≤ n → N ≤ m →
      volume (symmDiff (T n) (T m) ∩ B) < ENNReal.ofReal ε) :
    ∃ L : Set E3, MeasurableSet L ∧
      Tendsto (fun n => volume (symmDiff (T n) L ∩ B)) atTop (𝓝 0) :=
by
  classical
  
  have hpos : ∀ k : ℕ, (0 : ℝ) < (2⁻¹ : ℝ) ^ (k + 1) := fun k => by positivity
  choose N hN using fun k : ℕ => hcau _ (hpos k)
  let φ : ℕ → ℕ := fun k => ∑ i ∈ Finset.range (k + 1), N i
  have hφm : Monotone φ := by
    apply monotone_nat_of_le_succ
    intro k
    show ∑ i ∈ Finset.range (k + 1), N i ≤ ∑ i ∈ Finset.range (k + 1 + 1), N i
    rw [Finset.sum_range_succ (n := k + 1)]
    exact Nat.le_add_right _ _
  have hNφ : ∀ k, N k ≤ φ k := fun k =>
    Finset.single_le_sum (f := N) (fun i _ => Nat.zero_le _) (Finset.self_mem_range_succ k)
  have hconv : ∀ k : ℕ, ENNReal.ofReal ((2⁻¹ : ℝ) ^ (k + 1)) = (2⁻¹ : ENNReal) ^ (k + 1) := by
    intro k
    rw [ENNReal.ofReal_pow (by norm_num), ENNReal.ofReal_inv_of_pos (by norm_num)]
    simp
  have hφ : ∀ k n, φ k ≤ n →
      volume (symmDiff (T (φ k)) (T n) ∩ B) < (2⁻¹ : ENNReal) ^ (k + 1) := by
    intro k n hn
    rw [← hconv k]
    exact hN k (φ k) n (hNφ k) ((hNφ k).trans hn)
  
  let S : ℕ → Set E3 := fun k => T (φ k)
  let L : Set E3 := ⋂ m : ℕ, ⋃ k : ℕ, S (k + m)
  have hLm : MeasurableSet L :=
    MeasurableSet.iInter fun m => MeasurableSet.iUnion fun k => hT _
  have hS : ∀ i, volume (symmDiff (S i) (S (i + 1)) ∩ B) ≤ (2⁻¹ : ENNReal) ^ (i + 1) :=
    fun i => (hφ i (φ (i + 1)) (hφm (Nat.le_succ i))).le
  
  have htele : ∀ j d, symmDiff (S j) (S (d + j)) ⊆
      ⋃ i : ℕ, symmDiff (S (i + j)) (S (i + j + 1)) := by
    intro j d
    induction d with
    | zero => simp
    | succ d ih =>
      intro x hx
      rcases symmDiff_triangle (S j) (S (d + j)) (S (d + 1 + j)) hx with h | h
      · exact ih h
      · have e : d + 1 + j = d + j + 1 := by omega
        rw [e] at h
        exact Set.mem_iUnion.2 ⟨d, h⟩
  have hsub : ∀ j, symmDiff (S j) L ⊆ ⋃ i : ℕ, symmDiff (S (i + j)) (S (i + j + 1)) := by
    intro j x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hxS, hxL⟩ | ⟨hxL, hxS⟩
    · have hxL' : ¬ ∀ m : ℕ, x ∈ ⋃ k : ℕ, S (k + m) := fun h => hxL (Set.mem_iInter.2 h)
      push_neg at hxL'
      obtain ⟨m, hm⟩ := hxL'
      apply htele j m
      rw [Set.mem_symmDiff]
      left
      refine ⟨hxS, fun hx' => hm (Set.mem_iUnion.2 ⟨j, ?_⟩)⟩
      rwa [Nat.add_comm] at hx'
    · have hx1 : x ∈ ⋃ k : ℕ, S (k + j) := Set.mem_iInter.1 hxL j
      obtain ⟨k, hk⟩ := Set.mem_iUnion.1 hx1
      apply htele j k
      rw [Set.mem_symmDiff]
      right
      exact ⟨hk, hxS⟩
  
  have htail_sum : ∀ j, volume ((⋃ i : ℕ, symmDiff (S (i + j)) (S (i + j + 1))) ∩ B) ≤
      (2⁻¹ : ENNReal) ^ j := by
    intro j
    rw [Set.iUnion_inter]
    refine (measure_iUnion_le _).trans ?_
    calc ∑' i, volume (symmDiff (S (i + j)) (S (i + j + 1)) ∩ B)
        ≤ ∑' i : ℕ, (2⁻¹ : ENNReal) ^ (j + 1) * 2⁻¹ ^ i := by
          refine ENNReal.tsum_le_tsum fun i => ?_
          refine (hS (i + j)).trans (le_of_eq ?_)
          rw [← pow_add]
          congr 1
          omega
      _ = (2⁻¹ : ENNReal) ^ (j + 1) * 2 := by
          rw [ENNReal.tsum_mul_left, ENNReal.tsum_geometric_two]
      _ = (2⁻¹ : ENNReal) ^ j := by
          rw [pow_succ, mul_assoc, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), mul_one]
  have htail : ∀ j, volume (symmDiff (S j) L ∩ B) ≤ (2⁻¹ : ENNReal) ^ j := fun j =>
    (measure_mono (Set.inter_subset_inter_left B (hsub j))).trans (htail_sum j)
  
  have hfar : ∀ j n, φ j ≤ n →
      volume (symmDiff (T n) L ∩ B) ≤ (2⁻¹ : ENNReal) ^ (j + 1) + 2⁻¹ ^ j := by
    intro j n hn
    have hincl : symmDiff (T n) L ∩ B ⊆
        (symmDiff (S j) (T n) ∩ B) ∪ (symmDiff (S j) L ∩ B) := by
      rintro x ⟨hx, hxB⟩
      rcases symmDiff_triangle (T n) (S j) L hx with h | h
      · left
        rw [symmDiff_comm] at h
        exact ⟨h, hxB⟩
      · right
        exact ⟨h, hxB⟩
    refine (measure_mono hincl).trans ((measure_union_le _ _).trans ?_)
    exact add_le_add (hφ j n hn).le (htail j)
  
  have hr : Tendsto (fun j : ℕ => (2⁻¹ : ENNReal) ^ j) atTop (𝓝 0) :=
    ENNReal.tendsto_pow_atTop_nhds_zero_of_lt_one (ENNReal.inv_lt_one.2 ENNReal.one_lt_two)
  have hb : Tendsto (fun j : ℕ => (2⁻¹ : ENNReal) ^ (j + 1) + 2⁻¹ ^ j) atTop (𝓝 0) := by
    have h := ((Filter.tendsto_add_atTop_iff_nat 1).2 hr).add hr
    rw [add_zero] at h
    exact h
  refine ⟨L, hLm, ?_⟩
  rw [ENNReal.tendsto_nhds_zero]
  intro ε hε
  obtain ⟨j, hj⟩ := (ENNReal.tendsto_nhds_zero.1 hb ε hε).exists
  filter_upwards [Filter.eventually_ge_atTop (φ j)] with n hn
  exact (hfar j n hn).trans hj

theorem sepGlue_chart_limits [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (K A₀ : Set M)
    (hK : IsCompact K) (hA₀ : sepChartMeas A₀) (N : ℕ) (x : Fin N → M) (c : Fin N → E3)
    (r : Fin N → ℝ) (L : Fin N → Set E3) (Fs : ℕ → Set M) (hr : ∀ j, 0 < r j)
    (hball : ∀ j, closedBall (c j) (r j) ⊆ (chartAt E3 (x j)).target)
    (hcover : K ⊆ ⋃ j, (chartAt E3 (x j)).symm '' ball (c j) (r j / 2))
    (hL : ∀ j, MeasurableSet (L j)) (hFs : ∀ n, sepChartMeas (Fs n))
    (hFsK : ∀ n, symmDiff (Fs n) A₀ ⊆ K)
    (hconv : ∀ j, Tendsto (fun n => volume (symmDiff (chartAt E3 (x j) '' (Fs n ∩
      (chartAt E3 (x j)).source)) (L j) ∩ ball (c j) (r j))) atTop (𝓝 0)) :
    ∃ F : Set M, sepChartMeas F ∧ symmDiff F A₀ ⊆ K ∧
      ∀ (p : M) (C : Set E3), IsCompact C → C ⊆ (chartAt E3 p).target →
        Tendsto (fun n => volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ (chartAt E3 p).source) ∩ C))
          atTop (𝓝 0) :=
by
  classical
  
  have hOpen : ∀ U : Set M, IsOpen U → sepChartMeas U := fun U hU p =>
    ((chartAt E3 p).isOpen_image_of_subset_source (hU.inter (chartAt E3 p).open_source)
      Set.inter_subset_right).measurableSet
  have hCompl : ∀ S : Set M, sepChartMeas S → sepChartMeas Sᶜ := by
    intro S hS p
    have h : chartAt E3 p '' (Sᶜ ∩ (chartAt E3 p).source) =
        (chartAt E3 p).target \ chartAt E3 p '' (S ∩ (chartAt E3 p).source) := by
      ext y
      constructor
      · rintro ⟨z, ⟨hzS, hzs⟩, rfl⟩
        refine ⟨(chartAt E3 p).map_source hzs, ?_⟩
        rintro ⟨z', ⟨hz'S, hz's⟩, heq⟩
        exact hzS ((chartAt E3 p).injOn hz's hzs heq ▸ hz'S)
      · rintro ⟨hyt, hyn⟩
        refine ⟨(chartAt E3 p).symm y, ⟨fun hS' => hyn ⟨_, ⟨hS', (chartAt E3 p).map_target hyt⟩,
          (chartAt E3 p).right_inv hyt⟩, (chartAt E3 p).map_target hyt⟩,
          (chartAt E3 p).right_inv hyt⟩
    rw [h]
    exact (chartAt E3 p).open_target.measurableSet.diff (hS p)
  have hUnion : ∀ S T : Set M, sepChartMeas S → sepChartMeas T → sepChartMeas (S ∪ T) := by
    intro S T hS hT p
    rw [Set.union_inter_distrib_right, Set.image_union]
    exact (hS p).union (hT p)
  have hIUnion : ∀ (n : ℕ) (S : Fin n → Set M), (∀ i, sepChartMeas (S i)) →
      sepChartMeas (⋃ i, S i) := by
    intro n S hS p
    rw [Set.iUnion_inter, Set.image_iUnion]
    exact MeasurableSet.iUnion (fun i => hS i p)
  have hInter : ∀ S T : Set M, sepChartMeas S → sepChartMeas T → sepChartMeas (S ∩ T) := by
    intro S T hS hT
    have h := hCompl _ (hUnion _ _ (hCompl S hS) (hCompl T hT))
    rwa [Set.compl_union, compl_compl, compl_compl] at h
  have hDiff : ∀ S T : Set M, sepChartMeas S → sepChartMeas T → sepChartMeas (S \ T) :=
    fun S T hS hT => hInter S Tᶜ hS (hCompl T hT)
  
  have hOne : ∀ (p : M) (N : Set M), N ⊆ (chartAt E3 p).source →
      MeasurableSet (chartAt E3 p '' N) → sepChartMeas N := by
    intro p N hN hm q
    set O := (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source with hOdef
    have hO : IsOpen O := (chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 q).open_source
    have hs : chartAt E3 p '' (N ∩ (chartAt E3 q).source) = chartAt E3 p '' N ∩ O := by
      ext y
      constructor
      · rintro ⟨z, ⟨hzN, hzq⟩, rfl⟩
        refine ⟨⟨z, hzN, rfl⟩, (chartAt E3 p).map_source (hN hzN), ?_⟩
        show (chartAt E3 p).symm (chartAt E3 p z) ∈ (chartAt E3 q).source
        rw [(chartAt E3 p).left_inv (hN hzN)]
        exact hzq
      · rintro ⟨⟨z, hzN, rfl⟩, -, hzq⟩
        have hzq' : (chartAt E3 p).symm (chartAt E3 p z) ∈ (chartAt E3 q).source := hzq
        rw [(chartAt E3 p).left_inv (hN hzN)] at hzq'
        exact ⟨z, ⟨hzN, hzq'⟩, rfl⟩
    have hsm : MeasurableSet (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) := by
      rw [hs]; exact hm.inter hO.measurableSet
    have hcont : ContinuousOn (fun y => chartAt E3 q ((chartAt E3 p).symm y)) O :=
      (chartAt E3 q).continuousOn.comp ((chartAt E3 p).continuousOn_symm.mono Set.inter_subset_left)
        (fun y hy => hy.2)
    have hinj : Set.InjOn (fun y => chartAt E3 q ((chartAt E3 p).symm y)) O := by
      intro y₁ h₁ y₂ h₂ heq
      have h' : (chartAt E3 p).symm y₁ = (chartAt E3 p).symm y₂ :=
        (chartAt E3 q).injOn h₁.2 h₂.2 heq
      rw [← (chartAt E3 p).right_inv h₁.1, ← (chartAt E3 p).right_inv h₂.1, h']
    have hsO : chartAt E3 p '' (N ∩ (chartAt E3 q).source) ⊆ O := by
      rw [hs]; exact Set.inter_subset_right
    have himg := hsm.image_of_continuousOn_injOn (hcont.mono hsO) (hinj.mono hsO)
    have heq : (fun y => chartAt E3 q ((chartAt E3 p).symm y)) ''
        (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) =
          chartAt E3 q '' (N ∩ (chartAt E3 q).source) := by
      rw [Set.image_image]
      refine Set.EqOn.image_eq ?_
      intro z hz
      simp only
      rw [(chartAt E3 p).left_inv (hN hz.1)]
    rwa [heq] at himg
  
  have hL2 : ∀ (p q : M) (D : Set M), IsCompact D → D ⊆ (chartAt E3 p).source →
      D ⊆ (chartAt E3 q).source → ∃ k : ENNReal, k ≠ ⊤ ∧ ∀ N : Set M, N ⊆ D →
        MeasurableSet (chartAt E3 p '' N) →
          volume (chartAt E3 q '' N) ≤ k * volume (chartAt E3 p '' N) := by
    intro p q D hD hDp hDq
    set O := (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source with hOdef
    have hO : IsOpen O := (chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 q).open_source
    have hsm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm) O :=
      (contMDiffOn_chart (x := q)).comp ((contMDiffOn_chart_symm (x := p)).mono Set.inter_subset_left)
        Set.inter_subset_right
    have hcd : ContDiffOn ℝ ∞ (chartAt E3 q ∘ (chartAt E3 p).symm) O :=
      contMDiffOn_iff_contDiffOn.mp hsm
    have hdiff : ∀ y ∈ O, DifferentiableAt ℝ (chartAt E3 q ∘ (chartAt E3 p).symm) y :=
      fun y hy => (hcd.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hy)
    have hfd : ContinuousOn (fderiv ℝ (chartAt E3 q ∘ (chartAt E3 p).symm)) O :=
      hcd.continuousOn_fderiv_of_isOpen hO (by simp)
    have hdet : ContinuousOn (fun y => (fderiv ℝ (chartAt E3 q ∘ (chartAt E3 p).symm) y).det) O :=
      ContinuousLinearMap.continuous_det.comp_continuousOn hfd
    have hDpc : IsCompact (chartAt E3 p '' D) :=
      hD.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hDp)
    have hDpO : chartAt E3 p '' D ⊆ O := by
      rintro _ ⟨z, hz, rfl⟩
      refine ⟨(chartAt E3 p).map_source (hDp hz), ?_⟩
      show (chartAt E3 p).symm (chartAt E3 p z) ∈ (chartAt E3 q).source
      rw [(chartAt E3 p).left_inv (hDp hz)]
      exact hDq hz
    obtain ⟨b, hb⟩ := hDpc.exists_bound_of_continuousOn (hdet.mono hDpO)
    refine ⟨ENNReal.ofReal b, ENNReal.ofReal_ne_top, fun N hND hNm => ?_⟩
    have hsD : chartAt E3 p '' N ⊆ chartAt E3 p '' D := Set.image_mono hND
    have hle := addHaar_image_le_lintegral_abs_det_fderiv volume hNm
      (f := chartAt E3 q ∘ (chartAt E3 p).symm)
      (fun y hy => (hdiff y (hDpO (hsD hy))).hasFDerivAt.hasFDerivWithinAt)
    have himg : (chartAt E3 q ∘ (chartAt E3 p).symm) '' (chartAt E3 p '' N) =
        chartAt E3 q '' N := by
      rw [Set.image_image]
      refine Set.EqOn.image_eq ?_
      intro z hz
      simp only [Function.comp_apply]
      rw [(chartAt E3 p).left_inv (hDp (hND hz))]
    rw [himg] at hle
    refine hle.trans ?_
    calc ∫⁻ y in chartAt E3 p '' N,
          ENNReal.ofReal |(fderiv ℝ (chartAt E3 q ∘ (chartAt E3 p).symm) y).det|
        ≤ ∫⁻ _ in chartAt E3 p '' N, ENNReal.ofReal b := by
          refine setLIntegral_mono' hNm (fun y hy => ENNReal.ofReal_le_ofReal ?_)
          have := hb y (hsD hy)
          rwa [Real.norm_eq_abs] at this
      _ = ENNReal.ofReal b * volume (chartAt E3 p '' N) := setLIntegral_const _ _
  
  set B : Fin N → Set M := fun j => (chartAt E3 (x j)).symm '' ball (c j) (r j / 2) with hBdef
  have hBt : ∀ j, ball (c j) (r j / 2) ⊆ (chartAt E3 (x j)).target := fun j =>
    ball_subset_closedBall.trans
      ((closedBall_subset_closedBall (by linarith [hr j])).trans (hball j))
  have hBo : ∀ j, IsOpen (B j) := fun j =>
    (chartAt E3 (x j)).symm.isOpen_image_of_subset_source isOpen_ball
      (by rw [OpenPartialHomeomorph.symm_source]; exact hBt j)
  have hBs : ∀ j, B j ⊆ (chartAt E3 (x j)).source := by
    rintro j _ ⟨w, hw, rfl⟩
    exact (chartAt E3 (x j)).map_target (hBt j hw)
  have hBball : ∀ j, ∀ z ∈ B j, chartAt E3 (x j) z ∈ ball (c j) (r j / 2) := by
    rintro j _ ⟨w, hw, rfl⟩
    rw [(chartAt E3 (x j)).right_inv (hBt j hw)]
    exact hw
  have hBcb : ∀ j, B j ⊆ (chartAt E3 (x j)).symm '' closedBall (c j) (r j) := fun j =>
    Set.image_mono (ball_subset_closedBall.trans
      (closedBall_subset_closedBall (by linarith [hr j])))
  
  have hKc : IsClosed K := hK.isClosed
  have hKm : sepChartMeas K := by
    have h := hCompl _ (hOpen _ hKc.isOpen_compl)
    rwa [compl_compl] at h
  
  set W : Fin N → Set M := fun j => ⋃ (i : Fin N) (_ : i < j), B i with hWdef
  have hWo : ∀ j, IsOpen (W j) := fun j => isOpen_iUnion fun i => isOpen_iUnion fun _ => hBo i
  set P : Fin N → Set M := fun j => (K ∩ B j) \ W j with hPdef
  have hPm : ∀ j, sepChartMeas (P j) := fun j =>
    hDiff _ _ (hInter _ _ hKm (hOpen _ (hBo j))) (hOpen _ (hWo j))
  have hPK : ∀ j, P j ⊆ K := fun j z hz => hz.1.1
  have hPB : ∀ j, P j ⊆ B j := fun j z hz => hz.1.2
  have hPdisj : ∀ i j, ∀ z, z ∈ P i → z ∈ P j → i = j := by
    intro i j z hi hj
    by_contra hne
    rcases lt_or_gt_of_ne hne with h | h
    · exact hj.2 (Set.mem_iUnion₂.2 ⟨i, h, hi.1.2⟩)
    · exact hi.2 (Set.mem_iUnion₂.2 ⟨j, h, hj.1.2⟩)
  have hPcov : K ⊆ ⋃ j, P j := by
    intro z hz
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hcover hz)
    obtain ⟨j₀, hj₀, hmin⟩ := (wellFounded_lt (α := Fin N)).has_min {i | z ∈ B i} ⟨j, hj⟩
    refine Set.mem_iUnion.2 ⟨j₀, ⟨hz, hj₀⟩, ?_⟩
    intro hW
    obtain ⟨i, hi, hiB⟩ := Set.mem_iUnion₂.1 hW
    exact hmin i hiB hi
  
  set G : Fin N → Set M := fun j => P j ∩ chartAt E3 (x j) ⁻¹' L j with hGdef
  have hGm : ∀ j, sepChartMeas (G j) := by
    intro j
    refine hOne (x j) _ (fun z hz => hBs j (hPB j hz.1)) ?_
    have h1 : chartAt E3 (x j) '' G j = chartAt E3 (x j) '' P j ∩ L j :=
      Set.image_inter_preimage _ _ _
    have h2 : chartAt E3 (x j) '' P j = chartAt E3 (x j) '' (P j ∩ (chartAt E3 (x j)).source) := by
      rw [Set.inter_eq_left.2 (fun z hz => hBs j (hPB j hz))]
    rw [h1, h2]
    exact (hPm j (x j)).inter (hL j)
  set F : Set M := (A₀ ∩ Kᶜ) ∪ ⋃ j, G j with hFdef
  have hFm : sepChartMeas F :=
    hUnion _ _ (hInter _ _ hA₀ (hOpen _ hKc.isOpen_compl)) (hIUnion N G hGm)
  have hFout : ∀ z, z ∉ K → (z ∈ F ↔ z ∈ A₀) := by
    intro z hz
    constructor
    · rintro (h | h)
      · exact h.1
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.1 h
        exact absurd (hPK j hj.1) hz
    · intro h
      exact Or.inl ⟨h, hz⟩
  have hFA : symmDiff F A₀ ⊆ K := by
    intro z hz
    by_contra hzK
    have h := hFout z hzK
    rcases Set.mem_symmDiff.1 hz with h' | h'
    · exact h'.2 (h.1 h'.1)
    · exact h'.2 (h.2 h'.1)
  have hFin : ∀ j, ∀ z ∈ P j, (z ∈ F ↔ chartAt E3 (x j) z ∈ L j) := by
    intro j z hz
    constructor
    · rintro (h | h)
      · exact absurd (hPK j hz) h.2
      · obtain ⟨i, hi⟩ := Set.mem_iUnion.1 h
        have hij := hPdisj i j z hi.1 hz
        subst hij
        exact hi.2
    · intro h
      exact Or.inr (Set.mem_iUnion.2 ⟨j, hz, h⟩)
  have hFsin : ∀ j n, ∀ z ∈ P j, (z ∈ Fs n ↔
      chartAt E3 (x j) z ∈ chartAt E3 (x j) '' (Fs n ∩ (chartAt E3 (x j)).source)) := by
    intro j n z hz
    have hzs := hBs j (hPB j hz)
    constructor
    · intro h
      exact ⟨z, ⟨h, hzs⟩, rfl⟩
    · rintro ⟨z', ⟨hz'F, hz's⟩, heq⟩
      exact (chartAt E3 (x j)).injOn hz's hzs heq ▸ hz'F
  
  set T : Fin N → ℕ → Set E3 := fun j n =>
    symmDiff (chartAt E3 (x j) '' (Fs n ∩ (chartAt E3 (x j)).source)) (L j) ∩ ball (c j) (r j)
    with hTdef
  have hTm : ∀ j n, MeasurableSet (T j n) := fun j n =>
    ((hFs n (x j)).symmDiff (hL j)).inter measurableSet_ball
  have hET : ∀ j n, ∀ z ∈ P j, z ∈ symmDiff (Fs n) F → chartAt E3 (x j) z ∈ T j n := by
    intro j n z hz hE
    refine ⟨?_, ball_subset_ball (by linarith [hr j]) (hBball j z (hPB j hz))⟩
    have h1 := hFin j z hz
    have h2 := hFsin j n z hz
    rcases Set.mem_symmDiff.1 hE with h | h
    · exact Set.mem_symmDiff.2 (Or.inl ⟨h2.1 h.1, fun h' => h.2 (h1.2 h')⟩)
    · exact Set.mem_symmDiff.2 (Or.inr ⟨h1.1 h.1, fun h' => h.2 (h2.2 h')⟩)
  have hEK : ∀ n, symmDiff (Fs n) F ⊆ K := by
    intro n z hz
    have h : z ∈ symmDiff (Fs n) A₀ ∪ symmDiff A₀ F := symmDiff_triangle (Fs n) A₀ F hz
    rcases h with h | h
    · exact hFsK n h
    · exact hFA (by rwa [symmDiff_comm] at h)
  
  refine ⟨F, hFm, hFA, fun p C hC hCt => ?_⟩
  set Q := (chartAt E3 p).symm '' C with hQdef
  have hQc : IsCompact Q := hC.image_of_continuousOn ((chartAt E3 p).continuousOn_symm.mono hCt)
  have hQs : Q ⊆ (chartAt E3 p).source := by
    rintro _ ⟨y, hy, rfl⟩
    exact (chartAt E3 p).map_target (hCt hy)
  set D : Fin N → Set M := fun j => (chartAt E3 (x j)).symm '' closedBall (c j) (r j) ∩ Q
    with hDdef
  have hDc : ∀ j, IsCompact (D j) := fun j =>
    ((isCompact_closedBall _ _).image_of_continuousOn
      ((chartAt E3 (x j)).continuousOn_symm.mono (hball j))).inter hQc
  have hDs : ∀ j, D j ⊆ (chartAt E3 (x j)).source := by
    rintro j _ ⟨⟨w, hw, rfl⟩, -⟩
    exact (chartAt E3 (x j)).map_target (hball j hw)
  have hDp : ∀ j, D j ⊆ (chartAt E3 p).source := fun j z hz => hQs hz.2
  have hk : ∀ j, ∃ k : ENNReal, k ≠ ⊤ ∧ ∀ N' : Set M, N' ⊆ D j →
      MeasurableSet (chartAt E3 (x j) '' N') →
        volume (chartAt E3 p '' N') ≤ k * volume (chartAt E3 (x j) '' N') :=
    fun j => hL2 (x j) p (D j) (hDc j) (hDs j) (hDp j)
  choose k hktop hkle using hk
  have hpiece : ∀ j n, volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ P j ∩ Q)) ≤
      k j * volume (T j n) := by
    intro j n
    have hsubt : T j n ∩ chartAt E3 (x j) '' D j ⊆ (chartAt E3 (x j)).target := by
      rintro _ ⟨-, ⟨z, hz, rfl⟩⟩
      exact (chartAt E3 (x j)).map_source (hDs j hz)
    have hN'D : (chartAt E3 (x j)).symm '' (T j n ∩ chartAt E3 (x j) '' D j) ⊆ D j := by
      rintro _ ⟨_, ⟨-, ⟨z, hz, rfl⟩⟩, rfl⟩
      rw [(chartAt E3 (x j)).left_inv (hDs j hz)]
      exact hz
    have hN'img : chartAt E3 (x j) '' ((chartAt E3 (x j)).symm ''
        (T j n ∩ chartAt E3 (x j) '' D j)) = T j n ∩ chartAt E3 (x j) '' D j :=
      (chartAt E3 (x j)).toPartialEquiv.image_symm_image_of_subset_target hsubt
    have hDjc : IsCompact (chartAt E3 (x j) '' D j) :=
      (hDc j).image_of_continuousOn ((chartAt E3 (x j)).continuousOn.mono (hDs j))
    have hN'm : MeasurableSet (chartAt E3 (x j) '' ((chartAt E3 (x j)).symm ''
        (T j n ∩ chartAt E3 (x j) '' D j))) := by
      rw [hN'img]
      exact (hTm j n).inter hDjc.isClosed.measurableSet
    have hsub : symmDiff (Fs n) F ∩ P j ∩ Q ⊆
        (chartAt E3 (x j)).symm '' (T j n ∩ chartAt E3 (x j) '' D j) := by
      rintro z ⟨⟨hzE, hzP⟩, hzQ⟩
      have hzD : z ∈ D j := ⟨hBcb j (hPB j hzP), hzQ⟩
      refine ⟨chartAt E3 (x j) z, ⟨hET j n z hzP hzE, ⟨z, hzD, rfl⟩⟩, ?_⟩
      exact (chartAt E3 (x j)).left_inv (hDs j hzD)
    calc volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ P j ∩ Q))
        ≤ volume (chartAt E3 p '' ((chartAt E3 (x j)).symm ''
            (T j n ∩ chartAt E3 (x j) '' D j))) := measure_mono (Set.image_mono hsub)
      _ ≤ k j * volume (chartAt E3 (x j) '' ((chartAt E3 (x j)).symm ''
            (T j n ∩ chartAt E3 (x j) '' D j))) := hkle j _ hN'D hN'm
      _ ≤ k j * volume (T j n) := by
          gcongr
          rw [hN'img]
          exact Set.inter_subset_left
  have hbound : ∀ n, volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ (chartAt E3 p).source) ∩ C) ≤
      ∑ j, k j * volume (T j n) := by
    intro n
    have hsub : chartAt E3 p '' (symmDiff (Fs n) F ∩ (chartAt E3 p).source) ∩ C ⊆
        ⋃ j, chartAt E3 p '' (symmDiff (Fs n) F ∩ P j ∩ Q) := by
      rintro _ ⟨⟨z, ⟨hzE, hzs⟩, rfl⟩, hzC⟩
      obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hPcov (hEK n hzE))
      refine Set.mem_iUnion.2 ⟨j, z, ⟨⟨hzE, hj⟩, ?_⟩, rfl⟩
      exact ⟨chartAt E3 p z, hzC, (chartAt E3 p).left_inv hzs⟩
    calc _ ≤ volume (⋃ j, chartAt E3 p '' (symmDiff (Fs n) F ∩ P j ∩ Q)) := measure_mono hsub
      _ ≤ ∑ j, volume (chartAt E3 p '' (symmDiff (Fs n) F ∩ P j ∩ Q)) :=
          measure_iUnion_fintype_le _ _
      _ ≤ ∑ j, k j * volume (T j n) := Finset.sum_le_sum (fun j _ => hpiece j n)
  have hlim : Tendsto (fun n => ∑ j, k j * volume (T j n)) atTop (𝓝 0) := by
    have h := tendsto_finset_sum (Finset.univ : Finset (Fin N))
      (fun j _ => ENNReal.Tendsto.const_mul (hconv j) (Or.inr (hktop j)))
    simpa using h
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim (fun _ => zero_le _)
    hbound

theorem hullRiemPer_minimizer_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Kc Ω A₀ Kv : Set M) (hKv : IsCompact Kv) (hΩ : IsOpen Ω)
    (hKvΩ : Kv ⊆ Ω) (hA₀ : sepChartMeas A₀) (hfin : hullRiemPer g A₀ Ω Kc < ⊤) :
    ∃ F : Set M, sepChartMeas F ∧ symmDiff F A₀ ⊆ Kv ∧
      ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ Kv →
        hullRiemPer g F Ω Kc ≤ hullRiemPer g F' Ω Kc :=
by
  classical
  
  have hsqrt : ∀ p : M, ContDiffOn ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det)
      (chartAt E3 p).target := by
    intro p
    have hent : ∀ i j : Fin 3, ContDiffOn ℝ ∞
        (fun z => g.coeff (chartAt E3 p).symm z i j) (chartAt E3 p).target :=
      fun i j => g.smooth p i j
    have hdet : ContDiffOn ℝ ∞ (fun z => (g.coeff (chartAt E3 p).symm z).det)
        (chartAt E3 p).target := by
      have hfun : (fun z => (g.coeff (chartAt E3 p).symm z).det) = fun z =>
          g.coeff (chartAt E3 p).symm z 0 0 * g.coeff (chartAt E3 p).symm z 1 1 *
              g.coeff (chartAt E3 p).symm z 2 2
            - g.coeff (chartAt E3 p).symm z 0 0 * g.coeff (chartAt E3 p).symm z 1 2 *
              g.coeff (chartAt E3 p).symm z 2 1
            - g.coeff (chartAt E3 p).symm z 0 1 * g.coeff (chartAt E3 p).symm z 1 0 *
              g.coeff (chartAt E3 p).symm z 2 2
            + g.coeff (chartAt E3 p).symm z 0 1 * g.coeff (chartAt E3 p).symm z 1 2 *
              g.coeff (chartAt E3 p).symm z 2 0
            + g.coeff (chartAt E3 p).symm z 0 2 * g.coeff (chartAt E3 p).symm z 1 0 *
              g.coeff (chartAt E3 p).symm z 2 1
            - g.coeff (chartAt E3 p).symm z 0 2 * g.coeff (chartAt E3 p).symm z 1 1 *
              g.coeff (chartAt E3 p).symm z 2 0 := by
        funext z
        exact Matrix.det_fin_three _
      rw [hfun]
      exact (((((((hent 0 0).mul (hent 1 1)).mul (hent 2 2)).sub
        (((hent 0 0).mul (hent 1 2)).mul (hent 2 1))).sub
        (((hent 0 1).mul (hent 1 0)).mul (hent 2 2))).add
        (((hent 0 1).mul (hent 1 2)).mul (hent 2 0))).add
        (((hent 0 2).mul (hent 1 0)).mul (hent 2 1))).sub
        (((hent 0 2).mul (hent 1 1)).mul (hent 2 0))
    exact hdet.sqrt (fun z hz => ne_of_gt (coeff_chart_symm_posDef g p z hz).det_pos)
  
  have hzero : ∀ (p : M) (X : E3 → E3) (y : E3), y ∉ tsupport X →
      sepDensDiv (g.coeff (chartAt E3 p).symm) X y = 0 := by
    intro p X y hy
    have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 hy
    show ∑ i : Fin 3,
      fderiv ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) y (e i) = 0
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have h2 : (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) =ᶠ[𝓝 y]
        (fun _ => (0 : ℝ)) := by
      filter_upwards [hev] with w hw
      simp [hw]
    rw [h2.fderiv_eq]
    simp
  
  have hmeas : ∀ (p : M) (X : E3 → E3),
      Measurable (sepDensDiv (g.coeff (chartAt E3 p).symm) X) := by
    intro p X
    show Measurable (fun y => ∑ i : Fin 3,
      fderiv ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) y (e i))
    exact Finset.measurable_sum _ (fun i _ => measurable_fderiv_apply_const ℝ _ _)
  
  have hbdd : ∀ (p : M) (X : E3 → E3), ContDiff ℝ ∞ X → HasCompactSupport X →
      tsupport X ⊆ (chartAt E3 p).target →
      ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 p).symm) X y| ≤ C := by
    intro p X hX hXc hXt
    have hTo : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
    have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := fun i =>
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hX
    have hφ : ∀ i : Fin 3, ContDiff ℝ ∞
        (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) := by
      intro i
      rw [contDiff_iff_contDiffAt]
      intro z
      by_cases hz : z ∈ (chartAt E3 p).target
      · exact ((hsqrt p).mul (hXi i).contDiffOn).contDiffAt (hTo.mem_nhds hz)
      · have hz' : z ∉ tsupport X := fun h => hz (hXt h)
        have hev : X =ᶠ[𝓝 z] 0 := notMem_tsupport_iff_eventuallyEq.1 hz'
        refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
        filter_upwards [hev] with w hw
        simp [hw]
    have hc : Continuous (sepDensDiv (g.coeff (chartAt E3 p).symm) X) := by
      show Continuous (fun y => ∑ i : Fin 3,
        fderiv ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * X z i) y (e i))
      refine continuous_finset_sum _ (fun i _ => ?_)
      exact ((hφ i).continuous_fderiv (by simp)).clm_apply continuous_const
    obtain ⟨B, hB⟩ := IsCompact.exists_bound_of_continuousOn hXc hc.continuousOn
    refine ⟨max B 0, fun y => ?_⟩
    by_cases hy : y ∈ tsupport X
    · have := hB y hy
      rw [Real.norm_eq_abs] at this
      exact this.trans (le_max_left _ _)
    · rw [hzero p X y hy, abs_zero]
      exact le_max_right _ _
  
  have hcmp : ∀ F : Set M, sepRiemPer g F Ω ≤ hullRiemPer g F Ω Kc := by
    intro F
    unfold sepRiemPer hullRiemPer
    refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun hW =>
      Finset.sum_le_sum fun k _ => ?_
    have hVt : chartAt E3 (p k) '' W k ⊆ (chartAt E3 (p k)).target := by
      rintro _ ⟨w, hw, rfl⟩
      exact (chartAt E3 (p k)).map_source ((hW.1 k).2 hw).2
    unfold sepPerG hullPerG
    exact iSup₂_le fun X hX => le_iSup₂_of_le X ⟨fun y _ => hX.1.contDiffAt, hX.2.1, hX.2.2.1,
      hX.2.2.2, hbdd (p k) X hX.1 hX.2.1 (hX.2.2.1.trans hVt)⟩ le_rfl
  
  have hint : ∀ (f : E3 → ℝ) (C S : Set E3) (Ss : ℕ → Set E3) (B : ℝ), IsCompact C →
      Measurable f → (∀ y : E3, y ∉ C → f y = 0) → (∀ y : E3, |f y| ≤ B) → MeasurableSet S →
      (∀ n, MeasurableSet (Ss n)) →
      Tendsto (fun n => volume (symmDiff (Ss n) S ∩ C)) atTop (𝓝 0) →
      Tendsto (fun n => ∫ y in Ss n, f y) atTop (𝓝 (∫ y in S, f y)) := by
    intro f C S Ss B hC hf hfC hB hS hSs hc
    have hCm : MeasurableSet C := hC.isClosed.measurableSet
    have hCfin : volume C < ⊤ := hC.measure_lt_top
    have hfi : Integrable f := by
      have hg : Integrable (C.indicator (fun _ => B)) :=
        (integrable_indicator_iff hCm).2 (integrableOn_const hCfin.ne)
      refine hg.mono' hf.aestronglyMeasurable (Filter.Eventually.of_forall fun y => ?_)
      by_cases hy : y ∈ C
      · rw [Set.indicator_of_mem hy, Real.norm_eq_abs]
        exact hB y
      · rw [Set.indicator_of_notMem hy, hfC y hy, norm_zero]
    have key : ∀ A : Set E3, ‖∫ y in A, f y‖ ≤ B * (volume (A ∩ C)).toReal := by
      intro A
      have h1 : ∫ y in A, f y = ∫ y in A ∩ C, f y := by
        have e := integral_inter_add_diff (s := A) (f := f) (μ := volume) hCm hfi.integrableOn
        have z : ∫ y in A \ C, f y = 0 :=
          setIntegral_eq_zero_of_forall_eq_zero (fun y hy => hfC y hy.2)
        rw [z, add_zero] at e
        exact e.symm
      rw [h1]
      have h2 := norm_setIntegral_le_of_norm_le_const
        (lt_of_le_of_lt (measure_mono Set.inter_subset_right) hCfin)
        (fun y _ => by rw [Real.norm_eq_abs]; exact hB y) (f := f) (s := A ∩ C) (μ := volume)
      simpa [Measure.real] using h2
    have hbound : ∀ n, ‖(∫ y in Ss n, f y) - ∫ y in S, f y‖ ≤
        2 * B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by
      intro n
      have e1 := integral_inter_add_diff hS (hfi.integrableOn (s := Ss n))
      have e2 := integral_inter_add_diff (hSs n) (hfi.integrableOn (s := S))
      have e3 : Ss n ∩ S = S ∩ Ss n := Set.inter_comm _ _
      have hd : (∫ y in Ss n, f y) - ∫ y in S, f y =
          (∫ y in Ss n \ S, f y) - ∫ y in S \ Ss n, f y := by
        rw [← e1, ← e2, e3]; ring
      rw [hd]
      have hfin : volume (symmDiff (Ss n) S ∩ C) ≠ ⊤ :=
        ne_top_of_le_ne_top hCfin.ne (measure_mono Set.inter_subset_right)
      have m1 : (volume ((Ss n \ S) ∩ C)).toReal ≤ (volume (symmDiff (Ss n) S ∩ C)).toReal :=
        ENNReal.toReal_mono hfin (measure_mono (Set.inter_subset_inter_left _
          (by rw [Set.symmDiff_def]; exact Set.subset_union_left)))
      have m2 : (volume ((S \ Ss n) ∩ C)).toReal ≤ (volume (symmDiff (Ss n) S ∩ C)).toReal :=
        ENNReal.toReal_mono hfin (measure_mono (Set.inter_subset_inter_left _
          (by rw [Set.symmDiff_def]; exact Set.subset_union_right)))
      have hB0 : 0 ≤ B := le_trans (abs_nonneg _) (hB 0)
      calc ‖(∫ y in Ss n \ S, f y) - ∫ y in S \ Ss n, f y‖
          ≤ ‖∫ y in Ss n \ S, f y‖ + ‖∫ y in S \ Ss n, f y‖ := norm_sub_le _ _
        _ ≤ B * (volume ((Ss n \ S) ∩ C)).toReal + B * (volume ((S \ Ss n) ∩ C)).toReal :=
            add_le_add (key _) (key _)
        _ ≤ B * (volume (symmDiff (Ss n) S ∩ C)).toReal +
              B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by gcongr
        _ = 2 * B * (volume (symmDiff (Ss n) S ∩ C)).toReal := by ring
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) hbound ?_
    have h0 : Tendsto (fun n => (volume (symmDiff (Ss n) S ∩ C)).toReal) atTop (𝓝 0) := by
      have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp hc
      simpa using this
    simpa using h0.const_mul (2 * B)
  
  have hsups : ∀ (α : Type) (N : ℕ) (P : Fin N → α → Prop) (a : Fin N → α → ENNReal)
      (m : ENNReal), (∀ k, ∃ x, P k x) → (∀ X : Fin N → α, (∀ k, P k (X k)) → ∑ k, a k (X k) ≤ m) →
      ∑ k, ⨆ (x : α) (_ : P k x), a k x ≤ m := by
    intro α N P a m hne h
    choose X₀ hX₀ using hne
    have heq : ∀ k, (⨆ (x : α) (_ : P k x), a k x) =
        ⨆ X : {X : Fin N → α // ∀ k, P k (X k)}, a k (X.1 k) := by
      intro k
      apply le_antisymm
      · refine iSup₂_le fun x hx => ?_
        refine le_iSup_of_le ⟨Function.update X₀ k x, fun j => ?_⟩ ?_
        · by_cases hj : j = k
          · subst hj; simp [hx]
          · simp [Function.update_of_ne hj, hX₀ j]
        · simp
      · exact iSup_le fun X => le_iSup₂_of_le (X.1 k) (X.2 k) le_rfl
    rw [Finset.sum_congr rfl (fun k _ => heq k)]
    rw [ENNReal.finsetSum_iSup]
    · exact iSup_le fun X => h X.1 X.2
    · intro X Y
      refine ⟨⟨fun k => if a k (X.1 k) ≤ a k (Y.1 k) then Y.1 k else X.1 k,
        fun k => by dsimp only; split_ifs; exacts [Y.2 k, X.2 k]⟩, fun k => ?_⟩
      dsimp only
      split_ifs with hk
      · exact ⟨hk, le_rfl⟩
      · exact ⟨le_rfl, (not_le.1 hk).le⟩
  
  have hlsc : ∀ (F : Set M) (Gs : ℕ → Set M) (m' : ENNReal), sepChartMeas F →
      (∀ n, sepChartMeas (Gs n)) →
      (∀ (p : M) (C : Set E3), IsCompact C → C ⊆ (chartAt E3 p).target →
        Tendsto (fun n => volume (chartAt E3 p '' (symmDiff (Gs n) F ∩ (chartAt E3 p).source) ∩ C))
          atTop (𝓝 0)) →
      Tendsto (fun n => hullRiemPer g (Gs n) Ω Kc) atTop (𝓝 m') →
      hullRiemPer g F Ω Kc ≤ m' := by
    intro F Gs m' hF hGs hconv hlim'
    unfold hullRiemPer
    refine iSup_le fun N => iSup_le fun p => iSup_le fun W => iSup_le fun hW => ?_
    have hVt : ∀ k, chartAt E3 (p k) '' W k ⊆ (chartAt E3 (p k)).target := by
      intro k
      rintro _ ⟨w, hw, rfl⟩
      exact (chartAt E3 (p k)).map_source ((hW.1 k).2 hw).2
    unfold hullPerG
    refine hsups (E3 → E3) N (fun k X =>
        (∀ y, y ∉ chartAt E3 (p k) '' (Kc ∩ (chartAt E3 (p k)).source) → ContDiffAt ℝ ∞ X y) ∧
        HasCompactSupport X ∧ tsupport X ⊆ chartAt E3 (p k) '' W k ∧
        (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 (p k)).symm y i j * X y i * X y j ≤ 1) ∧
        ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y| ≤ C)
      (fun k X => ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source),
        sepDensDiv (g.coeff (chartAt E3 (p k)).symm) X y)) m' ?_ ?_
    · intro k
      refine ⟨0, fun y _ => contDiffAt_const, HasCompactSupport.zero, ?_, fun y => by simp,
        0, fun y => by simp [sepDensDiv, partialDeriv]⟩
      rw [tsupport_zero]
      exact Set.empty_subset _
    intro Xs hXs
    have hterm : ∀ k, Tendsto (fun n => ENNReal.ofReal
        (∫ y in chartAt E3 (p k) '' (Gs n ∩ (chartAt E3 (p k)).source),
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Xs k) y)) atTop
        (𝓝 (ENNReal.ofReal (∫ y in chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source),
          sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Xs k) y))) := by
      intro k
      obtain ⟨-, hXc, hXV, -, B, hB⟩ := hXs k
      have hCt : tsupport (Xs k) ⊆ (chartAt E3 (p k)).target := hXV.trans (hVt k)
      refine ENNReal.tendsto_ofReal (hint _ (tsupport (Xs k)) _ _ B hXc (hmeas (p k) (Xs k))
        (hzero (p k) (Xs k)) hB (hF (p k)) (fun n => hGs n (p k)) ?_)
      have hsub : ∀ n, symmDiff (chartAt E3 (p k) '' (Gs n ∩ (chartAt E3 (p k)).source))
          (chartAt E3 (p k) '' (F ∩ (chartAt E3 (p k)).source)) ∩ tsupport (Xs k) ⊆
          chartAt E3 (p k) '' (symmDiff (Gs n) F ∩ (chartAt E3 (p k)).source) ∩
            tsupport (Xs k) := by
        intro n
        refine Set.inter_subset_inter_left _ ?_
        exact Set.subset_image_symmDiff.trans
          (Set.image_mono (Set.inter_symmDiff_distrib_right _ _ _).symm.subset)
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
        (hconv (p k) _ hXc hCt) (fun n => zero_le _) (fun n => measure_mono (hsub n))
    have hsum := tendsto_finset_sum Finset.univ (fun k _ => hterm k)
    refine le_of_tendsto_of_tendsto' hsum hlim' (fun n => ?_)
    refine le_trans (Finset.sum_le_sum fun k _ => ?_)
      (?_ : ∑ k, hullPerG (g.coeff (chartAt E3 (p k)).symm)
        (chartAt E3 (p k) '' (Gs n ∩ (chartAt E3 (p k)).source)) (chartAt E3 (p k) '' W k)
        (chartAt E3 (p k) '' (Kc ∩ (chartAt E3 (p k)).source)) ≤ hullRiemPer g (Gs n) Ω Kc)
    · unfold hullPerG
      exact le_iSup₂_of_le (Xs k) (hXs k) le_rfl
    · unfold hullRiemPer
      exact le_iSup_of_le N (le_iSup_of_le p (le_iSup_of_le W (le_iSup_of_le hW le_rfl)))
  
  set m : ENNReal := ⨅ (F' : Set M) (_ : sepChartMeas F' ∧ symmDiff F' A₀ ⊆ Kv),
    hullRiemPer g F' Ω Kc with hm_def
  have hA₀C : sepChartMeas A₀ ∧ symmDiff A₀ A₀ ⊆ Kv :=
    ⟨hA₀, by rw [symmDiff_self]; exact Set.empty_subset _⟩
  have hmA : m ≤ hullRiemPer g A₀ Ω Kc := iInf₂_le A₀ hA₀C
  have hmtop : m ≠ ⊤ := ne_top_of_le_ne_top hfin.ne hmA
  have hseq : ∀ n : ℕ, ∃ F : Set M, (sepChartMeas F ∧ symmDiff F A₀ ⊆ Kv) ∧
      hullRiemPer g F Ω Kc < m + ((n + 1 : ℕ) : ENNReal)⁻¹ := by
    intro n
    have hpos : ((n + 1 : ℕ) : ENNReal)⁻¹ ≠ 0 :=
      ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _)
    have hlt : m < m + ((n + 1 : ℕ) : ENNReal)⁻¹ := ENNReal.lt_add_right hmtop hpos
    obtain ⟨F, hF⟩ := iInf_lt_iff.1 hlt
    obtain ⟨hFC, hFlt⟩ := iInf_lt_iff.1 hF
    exact ⟨F, hFC, hFlt⟩
  choose Fs hFsC hFslt using hseq
  have hFsm : ∀ n, sepChartMeas (Fs n) := fun n => (hFsC n).1
  have hFsK : ∀ n, symmDiff (Fs n) A₀ ⊆ Kv := fun n => (hFsC n).2
  have hmle : ∀ n, m ≤ hullRiemPer g (Fs n) Ω Kc := fun n => iInf₂_le (Fs n) (hFsC n)
  have hinv : Tendsto (fun n : ℕ => ((n + 1 : ℕ) : ENNReal)⁻¹) atTop (𝓝 0) :=
    ENNReal.tendsto_inv_nat_nhds_zero.comp (tendsto_add_atTop_nat 1)
  have hlim : Tendsto (fun n => hullRiemPer g (Fs n) Ω Kc) atTop (𝓝 m) := by
    have hup : Tendsto (fun n : ℕ => m + ((n + 1 : ℕ) : ENNReal)⁻¹) atTop (𝓝 (m + 0)) :=
      tendsto_const_nhds.add hinv
    rw [add_zero] at hup
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hup hmle
      (fun n => (hFslt n).le)
  obtain ⟨Lr, hLr0, hFsΛ⟩ : ∃ Lr : ℝ, 0 ≤ Lr ∧
      ∀ n, hullRiemPer g (Fs n) Ω Kc ≤ ENNReal.ofReal Lr := by
    refine ⟨(m + 1).toReal, ENNReal.toReal_nonneg, fun n => ?_⟩
    rw [ENNReal.ofReal_toReal (ENNReal.add_ne_top.2 ⟨hmtop, ENNReal.one_ne_top⟩)]
    refine (hFslt n).le.trans (add_le_add le_rfl ?_)
    rw [ENNReal.inv_le_one]
    exact_mod_cast Nat.le_add_left 1 n
  
  have hballex : ∀ x ∈ Kv, ∃ ε : ℝ, 0 < ε ∧
      ball (chartAt E3 x x) ε ⊆ chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) := by
    intro x hx
    have hO : IsOpen (chartAt E3 x '' (Ω ∩ (chartAt E3 x).source)) :=
      (chartAt E3 x).isOpen_image_of_subset_source (hΩ.inter (chartAt E3 x).open_source)
        Set.inter_subset_right
    have hmem : chartAt E3 x x ∈ chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) :=
      ⟨x, ⟨hKvΩ hx, mem_chart_source E3 x⟩, rfl⟩
    exact Metric.isOpen_iff.1 hO _ hmem
  choose! ε hεpos hεsub using hballex
  have hcb : ∀ x ∈ Kv, closedBall (chartAt E3 x x) (3 * (ε x / 4)) ⊆
      chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) := fun x hx =>
    (closedBall_subset_ball (by linarith [hεpos x hx])).trans (hεsub x hx)
  have himt : ∀ x : M, chartAt E3 x '' (Ω ∩ (chartAt E3 x).source) ⊆ (chartAt E3 x).target := by
    intro x
    rintro _ ⟨y, hy, rfl⟩
    exact (chartAt E3 x).map_source hy.2
  have hnhds : ∀ x ∈ Kv,
      (chartAt E3 x).symm '' ball (chartAt E3 x x) (ε x / 4 / 2 / 2) ∈ 𝓝 x := by
    intro x hx
    have hpos := hεpos x hx
    have hsub : ball (chartAt E3 x x) (ε x / 4 / 2 / 2) ⊆ (chartAt E3 x).target := by
      intro z hz
      apply himt x
      apply hcb x hx
      exact (ball_subset_closedBall.trans (closedBall_subset_closedBall (by linarith))) hz
    have hopen : IsOpen ((chartAt E3 x).symm '' ball (chartAt E3 x x) (ε x / 4 / 2 / 2)) :=
      (chartAt E3 x).symm.isOpen_image_of_subset_source isOpen_ball
        (by rw [OpenPartialHomeomorph.symm_source]; exact hsub)
    refine hopen.mem_nhds ⟨chartAt E3 x x, mem_ball_self (by linarith), ?_⟩
    exact (chartAt E3 x).left_inv (mem_chart_source E3 x)
  obtain ⟨t, htK, hcov⟩ := hKv.elim_nhds_subcover _ hnhds
  obtain ⟨xs, hxs_mem, hxs_surj⟩ : ∃ xs : Fin t.card → M, (∀ j, xs j ∈ t) ∧
      ∀ x ∈ t, ∃ j, xs j = x :=
    ⟨fun j => (t.equivFin.symm j : M), fun j => (t.equivFin.symm j).2,
      fun x hx => ⟨t.equivFin ⟨x, hx⟩, by simp⟩⟩
  have hxsK : ∀ j, xs j ∈ Kv := fun j => htK _ (hxs_mem j)
  obtain ⟨cs, rs, hrs, hcbs, hcovs⟩ : ∃ (cs : Fin t.card → E3) (rs : Fin t.card → ℝ),
      (∀ j, 0 < rs j) ∧
      (∀ j, closedBall (cs j) (3 * rs j) ⊆ chartAt E3 (xs j) '' (Ω ∩ (chartAt E3 (xs j)).source)) ∧
      Kv ⊆ ⋃ j, (chartAt E3 (xs j)).symm '' ball (cs j) (rs j / 2 / 2) := by
    refine ⟨fun j => chartAt E3 (xs j) (xs j), fun j => ε (xs j) / 4, fun j => ?_,
      fun j => hcb _ (hxsK j), ?_⟩
    · have := hεpos _ (hxsK j)
      show 0 < ε (xs j) / 4
      linarith
    · intro z hz
      obtain ⟨x, hxt, hzx⟩ := Set.mem_iUnion₂.1 (hcov hz)
      obtain ⟨j, rfl⟩ := hxs_surj x hxt
      exact Set.mem_iUnion.2 ⟨j, hzx⟩
  
  have hW : ∀ (j : Fin t.card) (n : ℕ), sepPerG (g.coeff (chartAt E3 (xs j)).symm)
      (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source)) (ball (cs j) (3 * rs j)) ≤
        sepRiemPer g (Fs n) Ω := by
    intro j n
    have hbt : ball (cs j) (3 * rs j) ⊆ (chartAt E3 (xs j)).target :=
      ball_subset_closedBall.trans ((hcbs j).trans (himt _))
    have hWo : IsOpen ((chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) :=
      (chartAt E3 (xs j)).symm.isOpen_image_of_subset_source isOpen_ball
        (by rw [OpenPartialHomeomorph.symm_source]; exact hbt)
    have hWsub : (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j) ⊆
        Ω ∩ (chartAt E3 (xs j)).source := by
      rintro _ ⟨w, hw, rfl⟩
      obtain ⟨x', hx', rfl⟩ := hcbs j (ball_subset_closedBall hw)
      rw [(chartAt E3 (xs j)).left_inv hx'.2]
      exact hx'
    have himg : chartAt E3 (xs j) '' ((chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) =
        ball (cs j) (3 * rs j) :=
      (chartAt E3 (xs j)).toPartialEquiv.image_symm_image_of_subset_target hbt
    have key : (∑ k : Fin 1, sepPerG (g.coeff (chartAt E3 ((fun _ : Fin 1 => xs j) k)).symm)
        (chartAt E3 ((fun _ : Fin 1 => xs j) k) '' (Fs n ∩
          (chartAt E3 ((fun _ : Fin 1 => xs j) k)).source))
        (chartAt E3 ((fun _ : Fin 1 => xs j) k) ''
          ((fun _ : Fin 1 => (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j)) k))) ≤
        sepRiemPer g (Fs n) Ω := by
      unfold sepRiemPer
      exact le_iSup_of_le 1 (le_iSup_of_le (fun _ : Fin 1 => xs j)
        (le_iSup_of_le (fun _ : Fin 1 => (chartAt E3 (xs j)).symm '' ball (cs j) (3 * rs j))
          (le_iSup_of_le ⟨fun _ => ⟨hWo, hWsub⟩,
            fun k l hkl => (hkl (Subsingleton.elim k l)).elim⟩ le_rfl)))
    rw [Fin.sum_univ_one] at key
    dsimp only at key
    rw [himg] at key
    exact key
  have hL4 : ∀ j : Fin t.card, ∃ a : ℝ, 0 ≤ a ∧ ∀ S : Set E3,
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S (ball (cs j) (3 * rs j)) ≤
        ENNReal.ofReal a * sepPerG (g.coeff (chartAt E3 (xs j)).symm) S (ball (cs j) (3 * rs j)) := by
    intro j
    have h3 : 0 < 3 * rs j := by linarith [hrs j]
    exact sepPerG_one_le_mul (g.coeff (chartAt E3 (xs j)).symm) (chartAt E3 (xs j)).target
      (cs j) (3 * rs j) (chartAt E3 (xs j)).open_target (fun i k => g.smooth (xs j) i k)
      (fun z hz => coeff_chart_symm_posDef g (xs j) z hz) h3 ((hcbs j).trans (himt _))
  choose a ha0 ha using hL4
  
  have hmod : ∀ (j : Fin t.card) (n : ℕ) (h : E3), ‖h‖ ≤ rs j →
      volume (symmDiff (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))
        ((fun x => x + h) ⁻¹' (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))) ∩
          ball (cs j) (rs j)) ≤ ENNReal.ofReal ((2 * a j * Lr) * ‖h‖) := by
    intro j n h hh
    have h5 := sepPerG_one_translate_le (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source))
      (cs j) h (rs j) (hFsm n (xs j)) (hrs j) hh
    have h4 : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
        (chartAt E3 (xs j) '' (Fs n ∩ (chartAt E3 (xs j)).source)) (ball (cs j) (3 * rs j)) ≤
          ENNReal.ofReal (a j) * ENNReal.ofReal Lr := by
      refine (ha j _).trans ?_
      gcongr
      exact (hW j n).trans ((hcmp (Fs n)).trans (hFsΛ n))
    calc _ ≤ _ := h5
      _ ≤ ENNReal.ofReal (2 * ‖h‖) * (ENNReal.ofReal (a j) * ENNReal.ofReal Lr) := by
          gcongr
      _ = ENNReal.ofReal ((2 * a j * Lr) * ‖h‖) := by
          rw [← ENNReal.ofReal_mul (ha0 j),
            ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * ‖h‖)]
          congr 1
          ring
  
  have hdiag : ∀ k : ℕ, ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ j : Fin t.card, j.val < k →
      ∃ L : Set E3, MeasurableSet L ∧ Tendsto (fun n => volume (symmDiff
        (chartAt E3 (xs j) '' (Fs (φ n) ∩ (chartAt E3 (xs j)).source)) L ∩
          ball (cs j) (rs j / 2))) atTop (𝓝 0) := by
    intro k
    induction k with
    | zero => exact ⟨id, strictMono_id, fun j hj => absurd hj (Nat.not_lt_zero _)⟩
    | succ k ih =>
      obtain ⟨φ, hφ, hφL⟩ := ih
      by_cases hk : k < t.card
      · obtain ⟨ψ, hψ, hcau⟩ := sepSets_cauchy_subseq (cs ⟨k, hk⟩) (rs ⟨k, hk⟩)
          (2 * a ⟨k, hk⟩ * Lr) (hrs _)
          (fun n => chartAt E3 (xs ⟨k, hk⟩) '' (Fs (φ n) ∩ (chartAt E3 (xs ⟨k, hk⟩)).source))
          (fun n => hFsm (φ n) (xs ⟨k, hk⟩)) (fun n h hh => hmod ⟨k, hk⟩ (φ n) h hh)
        obtain ⟨L₀, hL₀m, hL₀⟩ := sepSets_limit_of_cauchy (ball (cs ⟨k, hk⟩) (rs ⟨k, hk⟩ / 2))
          (fun n => chartAt E3 (xs ⟨k, hk⟩) '' (Fs (φ (ψ n)) ∩ (chartAt E3 (xs ⟨k, hk⟩)).source))
          (fun n => hFsm (φ (ψ n)) (xs ⟨k, hk⟩)) hcau
        refine ⟨φ ∘ ψ, hφ.comp hψ, fun j hj => ?_⟩
        rcases Nat.lt_succ_iff_lt_or_eq.1 hj with hj' | hj'
        · obtain ⟨L, hLm, hL⟩ := hφL j hj'
          exact ⟨L, hLm, hL.comp hψ.tendsto_atTop⟩
        · have hjk : j = ⟨k, hk⟩ := Fin.ext hj'
          subst hjk
          exact ⟨L₀, hL₀m, hL₀⟩
      · refine ⟨φ, hφ, fun j hj => hφL j ?_⟩
        have := j.isLt
        omega
  obtain ⟨φ, hφ, hφL⟩ := hdiag t.card
  choose L hLm hL using fun j : Fin t.card => hφL j j.isLt
  
  obtain ⟨F, hFm, hFK, hconv⟩ := sepGlue_chart_limits Kv A₀ hKv hA₀ t.card xs cs
    (fun j => rs j / 2) L (fun n => Fs (φ n))
    (fun j => by show 0 < rs j / 2; linarith [hrs j])
    (fun j => by
      show closedBall (cs j) (rs j / 2) ⊆ (chartAt E3 (xs j)).target
      exact (closedBall_subset_closedBall (by linarith [hrs j])).trans ((hcbs j).trans (himt _)))
    hcovs hLm (fun n => hFsm (φ n)) (fun n => hFsK (φ n)) hL
  
  have hle : hullRiemPer g F Ω Kc ≤ m :=
    hlsc F (fun n => Fs (φ n)) m hFm (fun n => hFsm (φ n)) hconv (hlim.comp hφ.tendsto_atTop)
  
  exact ⟨F, hFm, hFK, fun F' hF'm hF'K => hle.trans (iInf₂_le F' ⟨hF'm, hF'K⟩)⟩

theorem calPartition_extend [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω : Set M) (hΩ : IsOpen Ω) {n₀ : ℕ} (q₀ : Fin n₀ → M) (φ₀ : Fin n₀ → M → ℝ) (hφ₀ : calPartition q₀ φ₀ Ω) (O : Set M) (hO : IsOpen O) (hO1 : ∀ x ∈ O, ∑ j, φ₀ j x = 1) (K : Set M) (hK : IsCompact K) (hKΩ : K ⊆ Ω) : ∃ (n : ℕ) (q : Fin n → M) (φ : Fin n → M → ℝ) (O' : Set M), calPartition q φ Ω ∧ IsOpen O' ∧ K ∪ O ⊆ O' ∧ (∀ x ∈ O', ∑ j, φ j x = 1) ∧ ∀ (E : Set M) (h : M → ℝ), E ⊆ O → calVolSum g q φ E h = calVolSum g q₀ φ₀ E h :=
by
  classical
  obtain ⟨hsm, hnn, hle, hsupp⟩ := hφ₀
  
  have hbump : ∀ x : K, ∃ b : SmoothBumpFunction 𝓘(ℝ, E3) (x : M), tsupport b ⊆ Ω := by
    intro x
    obtain ⟨b, -, hb⟩ :=
      (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓘(ℝ, E3)) (x : M)).mem_iff.1
        (hΩ.mem_nhds (hKΩ x.2))
    exact ⟨b, hb⟩
  choose b hb using hbump
  have hcovK : K ⊆ ⋃ x : K, interior {y | b x y = 1} := by
    intro z hz
    refine Set.mem_iUnion.2 ⟨⟨z, hz⟩, ?_⟩
    rw [mem_interior_iff_mem_nhds]
    exact (b ⟨z, hz⟩).eventuallyEq_one
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun x : K => interior {y | b x y = 1})
    (fun _ => isOpen_interior) hcovK
  obtain ⟨m, c, f, hf_sm, hf01, hf_supp, hKcov⟩ : ∃ (m : ℕ) (c : Fin m → M) (f : Fin m → M → ℝ),
      (∀ i, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i)) ∧ (∀ i x, 0 ≤ f i x ∧ f i x ≤ 1) ∧
      (∀ i, IsCompact (tsupport (f i)) ∧ tsupport (f i) ⊆ Ω ∩ (chartAt E3 (c i)).source) ∧
      K ⊆ ⋃ i, interior {x | f i x = 1} := by
    refine ⟨t.card, fun i => ((t.equivFin.symm i : K) : M), fun i => ⇑(b (t.equivFin.symm i)),
      fun i => (b _).contMDiff, fun i x => ⟨(b _).nonneg, (b _).le_one⟩,
      fun i => ⟨(b _).hasCompactSupport,
        Set.subset_inter (hb _) (b _).tsupport_subset_chartAt_source⟩, ?_⟩
    intro z hz
    have hz' := ht hz
    simp only [Set.mem_iUnion] at hz'
    obtain ⟨x, hxt, hzx⟩ := hz'
    refine Set.mem_iUnion.2 ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    have he : t.equivFin.symm (t.equivFin ⟨x, hxt⟩) = ⟨x, hxt⟩ := Equiv.symm_apply_apply _ _
    show z ∈ interior {y | b (t.equivFin.symm (t.equivFin ⟨x, hxt⟩) : K) y = 1}
    rw [he]
    exact hzx
  
  have hSsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => ∑ j, φ₀ j x) :=
    contMDiff_finset_sum fun j _ => hsm j
  
  have htel : ∀ x, ∑ k, f k x * ∏ j ∈ Finset.univ.filter (fun j => j < k), (1 - f j x) =
      1 - ∏ i, (1 - f i x) := by
    intro x
    have := Finset.prod_one_sub_ordered Finset.univ (fun i => f i x)
    rw [this]
    ring
  have hP0 : ∀ x, 0 ≤ ∏ i, (1 - f i x) :=
    fun x => Finset.prod_nonneg fun i _ => sub_nonneg.2 (hf01 i x).2
  have hχ0 : ∀ k x, 0 ≤ f k x * ∏ j ∈ Finset.univ.filter (fun j => j < k), (1 - f j x) :=
    fun k x => mul_nonneg (hf01 k x).1 (Finset.prod_nonneg fun j _ => sub_nonneg.2 (hf01 j x).2)
  
  obtain ⟨ψ, hψdef⟩ : ∃ ψ : Fin m → M → ℝ, ψ = fun k x => (1 - ∑ j, φ₀ j x) *
      (f k x * ∏ j ∈ Finset.univ.filter (fun j => j < k), (1 - f j x)) := ⟨_, rfl⟩
  have htot : ∀ x, ∑ j, Fin.append φ₀ ψ j x = 1 - (1 - ∑ j, φ₀ j x) * ∏ i, (1 - f i x) := by
    intro x
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right, hψdef]
    rw [← Finset.mul_sum, htel x]
    ring
  refine ⟨n₀ + m, Fin.append q₀ c, Fin.append φ₀ ψ, O ∪ ⋃ i, interior {x | f i x = 1},
    ⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · intro j
    induction j using Fin.addCases with
    | left i =>
      simp only [Fin.append_left]
      exact hsm i
    | right k =>
      simp only [Fin.append_right, hψdef]
      exact (contMDiff_const.sub hSsm).mul ((hf_sm k).mul
        (contMDiff_finset_prod fun j _ => contMDiff_const.sub (hf_sm j)))
  · intro j x
    induction j using Fin.addCases with
    | left i =>
      simp only [Fin.append_left]
      exact hnn i x
    | right k =>
      simp only [Fin.append_right, hψdef]
      exact mul_nonneg (sub_nonneg.2 (hle x)) (hχ0 k x)
  · intro x
    rw [htot x]
    have := mul_nonneg (sub_nonneg.2 (hle x)) (hP0 x)
    linarith
  · intro j
    induction j using Fin.addCases with
    | left i =>
      simp only [Fin.append_left]
      exact hsupp i
    | right k =>
      simp only [Fin.append_right]
      have hsub : tsupport (ψ k) ⊆ tsupport (f k) := by
        rw [hψdef]
        exact tsupport_mul_subset_right.trans tsupport_mul_subset_left
      exact ⟨(hf_supp k).1.of_isClosed_subset (isClosed_tsupport _) hsub,
        hsub.trans (hf_supp k).2⟩
  · exact hO.union (isOpen_iUnion fun i => isOpen_interior)
  · rintro x (hx | hx)
    · exact Or.inr (hKcov hx)
    · exact Or.inl hx
  · rintro x (hx | hx)
    · rw [htot x, hO1 x hx]
      ring
    · obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hx
      have hfi' : x ∈ {x | f i x = 1} := interior_subset hi
      have hfi : f i x = 1 := hfi'
      rw [htot x, Finset.prod_eq_zero (Finset.mem_univ i) (by rw [hfi]; norm_num)]
      ring
  · intro E h hE
    unfold calVolSum
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
    refine (add_eq_left).2 ?_
    refine Finset.sum_eq_zero fun k _ => ?_
    refine MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero fun y hy => ?_
    obtain ⟨x, ⟨hxE, hxs⟩, rfl⟩ := hy
    rw [OpenPartialHomeomorph.left_inv _ hxs, hψdef]
    simp [hO1 x (hE hxE)]

theorem sepChartNull_of_image_null [IsManifold 𝓘(ℝ, E3) ∞ M] (p : M) (N : Set M)
    (hN : N ⊆ (chartAt E3 p).source) (h0 : volume (chartAt E3 p '' N) = 0) :
    sepChartNull N :=
by
  intro q
  have hs0 : volume (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) = 0 :=
    measure_mono_null (Set.image_mono Set.inter_subset_left) h0
  have himg : (chartAt E3 q ∘ (chartAt E3 p).symm) '' (chartAt E3 p '' (N ∩ (chartAt E3 q).source))
      = chartAt E3 q '' (N ∩ (chartAt E3 q).source) := by
    rw [Set.image_image]
    refine Set.EqOn.image_eq ?_
    intro x hx
    simp only [Function.comp_apply]
    rw [(chartAt E3 p).left_inv (hN hx.1)]
  have hsm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
    (contMDiffOn_chart (x := q)).comp ((contMDiffOn_chart_symm (x := p)).mono Set.inter_subset_left)
      Set.inter_subset_right
  have hcd : ContDiffOn ℝ ∞ (chartAt E3 q ∘ (chartAt E3 p).symm)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
    contMDiffOn_iff_contDiffOn.mp hsm
  have hsub : chartAt E3 p '' (N ∩ (chartAt E3 q).source) ⊆
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨(chartAt E3 p).map_source (hN hx.1), ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 q).source
    rw [(chartAt E3 p).left_inv (hN hx.1)]
    exact hx.2
  have hdiff : DifferentiableOn ℝ (chartAt E3 q ∘ (chartAt E3 p).symm)
      (chartAt E3 p '' (N ∩ (chartAt E3 q).source)) :=
    (hcd.differentiableOn (by simp)).mono hsub
  rw [← himg]
  exact MeasureTheory.addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume hdiff hs0

theorem calVolSum_levelMeanCurv_null [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (r₁ : ℝ) (Ω : Set M) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (hmc : ∀ p : M, r₁ ≤ ρ p → 0 < g.levelMeanCurv ρ p) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (D : Set M) (hD : sepChartMeas D) (hDρ : D ⊆ {p : M | r₁ < ρ p}) (hD1 : ∀ x ∈ D, ∑ j, φ j x = 1) (h0 : calVolSum g q φ D (fun x => g.levelMeanCurv ρ x) ≤ 0) : sepChartNull D :=
by
  classical
  have hρc : Continuous ρ := hρ.continuous
  
  have hpd1 : ∀ (U : Set E3) (h : E3 → ℝ), IsOpen U → ContDiffOn ℝ ∞ h U → ∀ k : Fin 3,
      ContinuousOn (partialDeriv k h) U := by
    intro U h hU hh k
    have h1 : ContinuousOn (fderiv ℝ h) U := hh.continuousOn_fderiv_of_isOpen hU (by simp)
    show ContinuousOn (fun y => fderiv ℝ h y (e k)) U
    exact h1.clm_apply continuousOn_const
  have hpds : ∀ (U : Set E3) (h : E3 → ℝ), IsOpen U → ContDiffOn ℝ ∞ h U → ∀ k : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv k h) U := by
    intro U h hU hh k
    have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y) U := hh.fderiv_of_isOpen hU (by simp)
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y (e k)) U
    exact h1.clm_apply contDiffOn_const
  
  have hmat : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3),
      (∀ i j : Fin 3, ContinuousOn (fun y => G y i j) U) → ContinuousOn G U := by
    intro G U hG
    exact continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hG i j
  have hdetc : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3),
      (∀ i j : Fin 3, ContinuousOn (fun y => G y i j) U) →
      ContinuousOn (fun y => (G y).det) U := by
    intro G U hG
    exact (continuous_id.matrix_det).comp_continuousOn (hmat G U hG)
  have hinv : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3),
      (∀ i j : Fin 3, ContinuousOn (fun y => G y i j) U) → (∀ y ∈ U, (G y).det ≠ 0) →
      ∀ i j : Fin 3, ContinuousOn (fun y => (G y)⁻¹ i j) U := by
    intro G U hG hdet i j
    have hd := hdetc G U hG
    have ha : ContinuousOn (fun y => (G y).adjugate i j) U :=
      ((continuous_id.matrix_adjugate).matrix_elem i j).comp_continuousOn (hmat G U hG)
    have heq : (fun y => (G y)⁻¹ i j) = fun y => ((G y).det)⁻¹ * (G y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv', smul_eq_mul]
    rw [heq]
    exact (hd.inv₀ hdet).mul ha
  
  have hLMCC : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (U : Set E3), IsOpen U →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → (∀ y ∈ U, (G y).det ≠ 0) →
      ContDiffOn ℝ ∞ f U →
      ContinuousOn (levelMeanCurvCoord G f) {y : E3 | y ∈ U ∧
        0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y} := by
    intro G f U hU hG hdet hf
    have hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) U := fun i j => (hG i j).continuousOn
    have hGi := hinv G U hGc hdet
    have hdG : ∀ a b k : Fin 3, ContinuousOn (partialDeriv k (fun z => G z a b)) U :=
      fun a b k => hpd1 U _ hU (hG a b) k
    have hdf : ∀ k : Fin 3, ContinuousOn (partialDeriv k f) U := fun k => hpd1 U f hU hf k
    have hddf : ∀ i j : Fin 3, ContinuousOn (partialDeriv i (partialDeriv j f)) U :=
      fun i j => hpd1 U _ hU (hpds U f hU hf j) i
    have hchr : ∀ k i j : Fin 3, ContinuousOn (christoffel G k i j) U := by
      intro k i j
      show ContinuousOn (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
        (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
          - partialDeriv l (fun z => G z i j) y)) U
      exact continuousOn_const.mul (continuousOn_finset_sum _ fun l _ =>
        (hGi k l).mul (((hdG j l i).add (hdG i l j)).sub (hdG i j l)))
    have hhess : ∀ i j : Fin 3, ContinuousOn (hessLoc G f i j) U := by
      intro i j
      show ContinuousOn (fun y => partialDeriv i (partialDeriv j f) y -
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f y) U
      exact (hddf i j).sub (continuousOn_finset_sum _ fun k _ => (hchr k i j).mul (hdf k))
    have hlap : ContinuousOn (lapLoc G f) U := by
      show ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * hessLoc G f i j y) U
      exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        (hGi i j).mul (hhess i j)
    have hQ : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ i a * partialDeriv a f y * ((G y)⁻¹ j b * partialDeriv b f y) *
          hessLoc G f i j y) U :=
      continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
          (((hGi i a).mul (hdf a)).mul ((hGi j b).mul (hdf b))).mul (hhess i j)
    have hS : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
        (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y) U :=
      continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        ((hGi i j).mul (hdf i)).mul (hdf j)
    have hsub : {y : E3 | y ∈ U ∧
        0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y} ⊆ U :=
      fun y hy => hy.1
    have hsq := hS.sqrt.mono hsub
    have hne : ∀ y ∈ {y : E3 | y ∈ U ∧
        0 < ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y},
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3,
          (G y)⁻¹ i j * partialDeriv i f y * partialDeriv j f y) ≠ 0 :=
      fun y hy => (Real.sqrt_pos.2 hy.2).ne'
    exact ((hlap.mono hsub).div hsq hne).sub
      ((hQ.mono hsub).div (hsq.pow 3) fun y hy => pow_ne_zero 3 (hne y hy))
  
  have hHc : ∀ q0 : M, ContinuousOn (fun y => g.levelMeanCurv ρ ((chartAt E3 q0).symm y))
      ((chartAt E3 q0).target ∩ {y : E3 | r₁ ≤ ρ ((chartAt E3 q0).symm y)}) := by
    intro q0
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 q0).symm.toPartialEquiv
        open_source := (chartAt E3 q0).open_target
        open_target := (chartAt E3 q0).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hΦeq : ∀ y ∈ (chartAt E3 q0).target, g.levelMeanCurv ρ ((chartAt E3 q0).symm y) =
        levelMeanCurvCoord (g.coeff (chartAt E3 q0).symm)
          (fun z => ρ ((chartAt E3 q0).symm z)) y := by
      intro y hy
      exact levelMeanCurv_eq_coord g Φ ρ (fun z => ρ ((chartAt E3 q0).symm z)) hρ y hy
        (Filter.Eventually.of_forall fun z => rfl)
    have hfs : ContDiffOn ℝ ∞ (fun z => ρ ((chartAt E3 q0).symm z)) (chartAt E3 q0).target := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ρ ∘ (chartAt E3 q0).symm)
          (chartAt E3 q0).target :=
        hρ.comp_contMDiffOn contMDiffOn_chart_symm
      exact contMDiffOn_iff_contDiffOn.mp h1
    have hcont := hLMCC (g.coeff (chartAt E3 q0).symm) (fun z => ρ ((chartAt E3 q0).symm z)) _
      (chartAt E3 q0).open_target (fun i j => g.smooth q0 i j)
      (fun y hy => (Matrix.PosDef.det_pos (coeff_chart_symm_posDef g q0 y hy)).ne') hfs
    refine (hcont.mono ?_).congr fun y hy => hΦeq y hy.1
    rintro y ⟨hy, hr⟩
    refine ⟨hy, ?_⟩
    by_contra hS
    push_neg at hS
    have hpos := hmc _ hr
    rw [hΦeq y hy] at hpos
    unfold levelMeanCurvCoord at hpos
    rw [Real.sqrt_eq_zero'.2 hS] at hpos
    simp at hpos
  
  have hnn : ∀ j, ∀ y ∈ chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      0 ≤ φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := by
    rintro j _ ⟨x, ⟨hxD, hxs⟩, rfl⟩
    rw [(chartAt E3 (q j)).left_inv hxs]
    exact mul_nonneg (mul_nonneg (hφ.2.1 j x) (hmc x (le_of_lt (hDρ hxD))).le)
      (Real.sqrt_nonneg _)
  have hint0 : ∀ j, 0 ≤ ∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det :=
    fun j => setIntegral_nonneg (hD (q j)) (hnn j)
  have hzero : ∀ j, ∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
      φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det = 0 := by
    have h0' : ∑ j, ∫ y in chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source),
        φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
          Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det ≤ 0 := h0
    have hsum := le_antisymm h0' (Finset.sum_nonneg fun j _ => hint0 j)
    intro j
    exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hint0 j)).1 hsum j (Finset.mem_univ j)
  
  have hinteg : ∀ j, IntegrableOn (fun y =>
      φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)
      (chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have hsrc : tsupport (φ j) ∩ {x | r₁ ≤ ρ x} ⊆ (chartAt E3 (q j)).source :=
      fun x hx => ((hφ.2.2.2 j).2 hx.1).2
    have hK : IsCompact (chartAt E3 (q j) '' (tsupport (φ j) ∩ {x | r₁ ≤ ρ x})) :=
      ((hφ.2.2.2 j).1.inter_right (isClosed_le continuous_const hρc)).image_of_continuousOn
        ((chartAt E3 (q j)).continuousOn.mono hsrc)
    have hKT : chartAt E3 (q j) '' (tsupport (φ j) ∩ {x | r₁ ≤ ρ x}) ⊆
        (chartAt E3 (q j)).target ∩ {y : E3 | r₁ ≤ ρ ((chartAt E3 (q j)).symm y)} := by
      rintro _ ⟨x, hx, rfl⟩
      have hxs : x ∈ (chartAt E3 (q j)).source := hsrc hx
      refine ⟨(chartAt E3 (q j)).map_source hxs, ?_⟩
      show r₁ ≤ ρ ((chartAt E3 (q j)).symm (chartAt E3 (q j) x))
      rw [(chartAt E3 (q j)).left_inv hxs]
      exact hx.2
    have hT : chartAt E3 (q j) '' (tsupport (φ j) ∩ {x | r₁ ≤ ρ x}) ⊆
        (chartAt E3 (q j)).target := fun y hy => (hKT hy).1
    have c1 : ContinuousOn (fun y => φ j ((chartAt E3 (q j)).symm y)) (chartAt E3 (q j)).target :=
      (hφ.1 j).continuous.comp_continuousOn (chartAt E3 (q j)).continuousOn_symm
    have c3 : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)
        (chartAt E3 (q j)).target :=
      (hdetc _ _ fun a b => (g.smooth (q j) a b).continuousOn).sqrt
    have hFc := ((c1.mono hT).mul ((hHc (q j)).mono hKT)).mul (c3.mono hT)
    refine IntegrableOn.of_forall_diff_eq_zero (hFc.integrableOn_compact hK) (hD (q j)) ?_
    rintro _ ⟨⟨x, ⟨hxD, hxs⟩, rfl⟩, hnK⟩
    have hφx : φ j x = 0 := by
      by_contra hne
      exact hnK ⟨x, ⟨subset_tsupport _ (Function.mem_support.2 hne),
        (show r₁ ≤ ρ x from le_of_lt (hDρ hxD))⟩, rfl⟩
    simp only [(chartAt E3 (q j)).left_inv hxs, hφx, zero_mul]
  
  have hnull : ∀ j, volume (chartAt E3 (q j) '' (D ∩ (chartAt E3 (q j)).source) ∩
      {y | φ j ((chartAt E3 (q j)).symm y) * g.levelMeanCurv ρ ((chartAt E3 (q j)).symm y) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det ≠ 0}) = 0 := by
    intro j
    have hae := (setIntegral_eq_zero_iff_of_nonneg_ae
      ((ae_restrict_iff' (hD (q j))).2 (ae_of_all _ (hnn j))) (hinteg j)).1 (hzero j)
    rw [Filter.EventuallyEq, ae_restrict_iff' (hD (q j)), ae_iff] at hae
    refine measure_mono_null ?_ hae
    rintro y ⟨hyS, hy⟩
    exact fun h => hy (h hyS)
  
  have hNnull : ∀ j, sepChartNull
      {x | x ∈ D ∧ x ∈ (chartAt E3 (q j)).source ∧ φ j x ≠ 0} := by
    intro j
    refine sepChartNull_of_image_null (q j) _ (fun x hx => hx.2.1) ?_
    refine measure_mono_null ?_ (hnull j)
    rintro _ ⟨x, ⟨hxD, hxs, hφx⟩, rfl⟩
    refine ⟨⟨x, ⟨hxD, hxs⟩, rfl⟩, ?_⟩
    simp only [Set.mem_setOf_eq, (chartAt E3 (q j)).left_inv hxs]
    have h1 : 0 < φ j x := lt_of_le_of_ne (hφ.2.1 j x) (Ne.symm hφx)
    have h2 : 0 < g.levelMeanCurv ρ x := hmc x (le_of_lt (hDρ hxD))
    have h3 : 0 < Real.sqrt (g.coeff (chartAt E3 (q j)).symm (chartAt E3 (q j) x)).det :=
      Real.sqrt_pos.2 (Matrix.PosDef.det_pos
        (coeff_chart_symm_posDef g (q j) _ ((chartAt E3 (q j)).map_source hxs)))
    exact (mul_pos (mul_pos h1 h2) h3).ne'
  
  have hcov : D ⊆ ⋃ j, {x | x ∈ D ∧ x ∈ (chartAt E3 (q j)).source ∧ φ j x ≠ 0} := by
    intro x hx
    have hs : ∑ j, φ j x ≠ 0 := by rw [hD1 x hx]; exact one_ne_zero
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hs
    exact Set.mem_iUnion.2 ⟨j, hx,
      ((hφ.2.2.2 j).2 (subset_tsupport _ (Function.mem_support.2 hj))).2, hj⟩
  intro p
  have h1 : chartAt E3 p '' (D ∩ (chartAt E3 p).source) ⊆ ⋃ j, chartAt E3 p ''
      ({x | x ∈ D ∧ x ∈ (chartAt E3 (q j)).source ∧ φ j x ≠ 0} ∩ (chartAt E3 p).source) := by
    rintro _ ⟨x, ⟨hxD, hxs⟩, rfl⟩
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hcov hxD)
    exact Set.mem_iUnion.2 ⟨j, x, ⟨hj, hxs⟩, rfl⟩
  exact measure_mono_null h1 (measure_iUnion_null fun j => hNnull j p)

theorem hullRiemPer_disjoint_sum_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E Ω K : Set M) {N : ℕ} (U : Fin N → Set M) (hU : ∀ i, U i ⊆ Ω) (hUd : Pairwise (fun i j => Disjoint (U i) (U j))) : ∑ i, hullRiemPer g E (U i) K ≤ hullRiemPer g E Ω K :=
by
  classical
  let val : (Σ n : ℕ, (Fin n → M) × (Fin n → Set M)) → ENNReal := fun x =>
    ∑ k, hullPerG (g.coeff (chartAt E3 (x.2.1 k)).symm)
      (chartAt E3 (x.2.1 k) '' (E ∩ (chartAt E3 (x.2.1 k)).source))
      (chartAt E3 (x.2.1 k) '' x.2.2 k)
      (chartAt E3 (x.2.1 k) '' (K ∩ (chartAt E3 (x.2.1 k)).source))
  let fam : Set M → (Σ n : ℕ, (Fin n → M) × (Fin n → Set M)) → Prop := fun V x =>
    (∀ k, IsOpen (x.2.2 k) ∧ x.2.2 k ⊆ V ∩ (chartAt E3 (x.2.1 k)).source) ∧
      Pairwise (fun k l => Disjoint (x.2.2 k) (x.2.2 l))
  have hle : ∀ V : Set M, hullRiemPer g E V K ≤ ⨆ x : {x // fam V x}, val x.1 := by
    intro V
    unfold hullRiemPer
    refine iSup_le fun n => iSup_le fun p => iSup_le fun W => iSup_le fun h => ?_
    exact le_iSup_of_le (⟨⟨n, (p, W)⟩, h⟩ : {x // fam V x}) le_rfl
  have hne : ∀ V : Set M, Nonempty {x // fam V x} := fun V =>
    ⟨⟨⟨0, (Fin.elim0, Fin.elim0)⟩, ⟨fun k => k.elim0, fun k => k.elim0⟩⟩⟩
  have hfam : ∀ A B Ω' : Set M, A ⊆ Ω' → B ⊆ Ω' → Disjoint A B →
      ∀ x y, fam A x → fam B y → val x + val y ≤ hullRiemPer g E Ω' K := by
    intro A B Ω' hA hB hAB x y hx hy
    obtain ⟨n, p, W⟩ := x
    obtain ⟨m, p', W'⟩ := y
    obtain ⟨hx1, hx2⟩ := hx
    obtain ⟨hy1, hy2⟩ := hy
    dsimp only at hx1 hx2 hy1 hy2
    have hc1 : ∀ k, IsOpen (Fin.append W W' k) ∧
        Fin.append W W' k ⊆ Ω' ∩ (chartAt E3 (Fin.append p p' k)).source := by
      intro k
      induction k using Fin.addCases with
      | left i =>
        simp only [Fin.append_left]
        exact ⟨(hx1 i).1, (hx1 i).2.trans (Set.inter_subset_inter_left _ hA)⟩
      | right j =>
        simp only [Fin.append_right]
        exact ⟨(hy1 j).1, (hy1 j).2.trans (Set.inter_subset_inter_left _ hB)⟩
    have hc2 : Pairwise (fun k l => Disjoint (Fin.append W W' k) (Fin.append W W' l)) := by
      intro k l hkl
      induction k using Fin.addCases with
      | left i =>
        induction l using Fin.addCases with
        | left j =>
          simp only [Fin.append_left]
          exact hx2 (fun h => hkl (by rw [h]))
        | right j =>
          simp only [Fin.append_left, Fin.append_right]
          exact Disjoint.mono ((hx1 i).2.trans Set.inter_subset_left)
            ((hy1 j).2.trans Set.inter_subset_left) hAB
      | right i =>
        induction l using Fin.addCases with
        | left j =>
          simp only [Fin.append_left, Fin.append_right]
          exact Disjoint.mono ((hy1 i).2.trans Set.inter_subset_left)
            ((hx1 j).2.trans Set.inter_subset_left) hAB.symm
        | right j =>
          simp only [Fin.append_right]
          exact hy2 (fun h => hkl (by rw [h]))
    have hval : val ⟨n + m, (Fin.append p p', Fin.append W W')⟩ =
        val ⟨n, (p, W)⟩ + val ⟨m, (p', W')⟩ := by
      simp only [val, Fin.sum_univ_add, Fin.append_left, Fin.append_right]
    rw [← hval]
    unfold hullRiemPer
    exact le_iSup_of_le (n + m) (le_iSup_of_le (Fin.append p p')
      (le_iSup_of_le (Fin.append W W') (le_iSup_of_le ⟨hc1, hc2⟩ le_rfl)))
  have hbin : ∀ A B Ω' : Set M, A ⊆ Ω' → B ⊆ Ω' → Disjoint A B →
      hullRiemPer g E A K + hullRiemPer g E B K ≤ hullRiemPer g E Ω' K := by
    intro A B Ω' hA hB hAB
    haveI := hne A
    haveI := hne B
    refine (add_le_add (hle A) (hle B)).trans ?_
    exact ENNReal.iSup_add_iSup_le fun x y => hfam A B Ω' hA hB hAB x.1 y.1 x.2 y.2
  clear hle hne hfam
  clear_value val fam
  induction N generalizing Ω with
  | zero => simp
  | succ N ih =>
    rw [Fin.sum_univ_succ]
    have h1 := ih (⋃ i : Fin N, U i.succ) (fun i => U i.succ)
      (fun i => Set.subset_iUnion (fun i => U i.succ) i)
      (fun i j hij => hUd ((Fin.succ_injective N).ne hij))
    have h2 := hbin (U 0) (⋃ i : Fin N, U i.succ) Ω (hU 0)
      (Set.iUnion_subset fun i => hU i.succ)
      (Set.disjoint_iUnion_right.2 fun i => hUd (Fin.succ_ne_zero i).symm)
    exact (add_le_add le_rfl h1).trans h2

theorem sepRiemPer_le_hullRiemPer [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (F U K : Set M) : sepRiemPer g F U ≤ hullRiemPer g F U K :=
by
  classical
  
  have hpd : ∀ (p : M) (y : E3), y ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y).PosDef := by
    intro p y hy
    have hq : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 p) ∘ (chartAt E3 p).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 p).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 p).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 p).symm y).mulVec x =
          g.g ((chartAt E3 p).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have tA : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (T : Set E3),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T) →
      (∀ y ∈ T, (G y).PosDef) →
      ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T := by
    intro G T hG hpd'
    have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
      have : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
          - G y 0 0 * G y 1 2 * G y 2 1
          - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
          + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three (G y)
      rw [this]
      have h := hG
      exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
        (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
        (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
    exact hdet.sqrt (fun y hy => (hpd' y hy).det_pos.ne')
  
  have tB : ∀ (T : Set E3), IsOpen T → ∀ (a : E3 → ℝ), ContDiffOn ℝ ∞ a T →
      ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ T →
      ∃ C : ℝ, ∀ y, |∑ i : Fin 3, partialDeriv i (fun z => a z * X z i) y| ≤ C := by
    intro T hT a ha X hX hXc hXT
    have hKc : IsClosed (tsupport X) := isClosed_tsupport X
    have hX0 : ∀ y, y ∉ tsupport X → ∀ i : Fin 3, X y i = 0 := by
      intro y hy i
      rw [image_eq_zero_of_notMem_tsupport hy]
      simp
    have hXi : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => X z i) := contDiff_euclidean.mp hX
    have hloc : ∀ i : Fin 3, ∀ y, y ∉ tsupport X →
        (fun z => a z * X z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) :=
      fun i y hy => Filter.eventually_of_mem (hKc.isOpen_compl.mem_nhds hy)
        (fun z hz => by simp only [hX0 z hz i, mul_zero])
    have hd : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => a z * X z i) := by
      intro i
      refine contDiff_iff_contDiffAt.2 fun y => ?_
      by_cases hy : y ∈ T
      · exact (ha.mul (hXi i).contDiffOn).contDiffAt (hT.mem_nhds hy)
      · exact contDiffAt_const.congr_of_eventuallyEq (hloc i y (fun h => hy (hXT h)))
    have hcont : Continuous (fun y => ∑ i : Fin 3, partialDeriv i (fun z => a z * X z i) y) :=
      continuous_finset_sum _ fun i _ =>
        ((hd i).continuous_fderiv (by simp)).clm_apply continuous_const
    have hsupp : HasCompactSupport
        (fun y => ∑ i : Fin 3, partialDeriv i (fun z => a z * X z i) y) := by
      refine HasCompactSupport.intro hXc.isCompact fun y hy => ?_
      refine Finset.sum_eq_zero fun i _ => ?_
      unfold partialDeriv
      rw [(hloc i y hy).fderiv_eq]
      simp
    obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hsupp
    refine ⟨C, fun y => ?_⟩
    have h := hC y
    rwa [Real.norm_eq_abs] at h
  
  unfold sepRiemPer hullRiemPer
  refine iSup_mono fun n => iSup_mono fun p => iSup_mono fun W => iSup_mono fun hW => ?_
  refine Finset.sum_le_sum fun k _ => ?_
  have hWsrc : W k ⊆ (chartAt E3 (p k)).source := (hW.1 k).2.trans Set.inter_subset_right
  have hsd : ContDiffOn ℝ ∞ (fun y => Real.sqrt (g.coeff (chartAt E3 (p k)).symm y).det)
      (chartAt E3 (p k)).target :=
    tA _ _ (fun i j => g.smooth (p k) i j) (hpd (p k))
  unfold sepPerG hullPerG
  refine iSup₂_le fun X hX => ?_
  have htT : tsupport X ⊆ (chartAt E3 (p k)).target := by
    refine hX.2.2.1.trans ?_
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 (p k)).map_source (hWsrc hx)
  obtain ⟨C, hC⟩ := tB _ (chartAt E3 (p k)).open_target _ hsd X hX.1 hX.2.1 htT
  refine le_iSup_of_le X (le_iSup_of_le ⟨fun y _ => hX.1.contDiffAt, hX.2.1, hX.2.2.1, hX.2.2.2,
    C, fun y => hC y⟩ le_rfl)

theorem hull_field_level_split [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (ρ : M → ℝ) (hρ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ρ) (Kc W : Set M) (q : M) (t δ : ℝ) (hδ : 0 < δ) (hKc : ∀ p ∈ Kc, ρ p < t - δ) (hW : W ⊆ (chartAt E3 q).source) (X : E3 → E3) (hX : (∀ y, y ∉ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ X y) ∧ HasCompactSupport X ∧ tsupport X ⊆ chartAt E3 q '' W ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * X y i * X y j ≤ 1) ∧ ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 q).symm) X y| ≤ C) : ∃ XL XB XR : E3 → E3, (∀ y, sepDensDiv (g.coeff (chartAt E3 q).symm) X y = sepDensDiv (g.coeff (chartAt E3 q).symm) XL y + sepDensDiv (g.coeff (chartAt E3 q).symm) XB y + sepDensDiv (g.coeff (chartAt E3 q).symm) XR y) ∧ MeasureTheory.Integrable (sepDensDiv (g.coeff (chartAt E3 q).symm) XL) ∧ MeasureTheory.Integrable (sepDensDiv (g.coeff (chartAt E3 q).symm) XB) ∧ MeasureTheory.Integrable (sepDensDiv (g.coeff (chartAt E3 q).symm) XR) ∧ ((∀ y, y ∉ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source) → ContDiffAt ℝ ∞ XL y) ∧ HasCompactSupport XL ∧ tsupport XL ⊆ chartAt E3 q '' (W ∩ {p : M | ρ p < t - δ / 8}) ∧ (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * XL y i * XL y j ≤ 1) ∧ ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 q).symm) XL y| ≤ C) ∧ (ContDiff ℝ ∞ XB ∧ HasCompactSupport XB ∧ tsupport XB ⊆ chartAt E3 q '' (W ∩ {p : M | t - δ < ρ p ∧ ρ p < t + δ}) ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * XB y i * XB y j ≤ 1) ∧ (ContDiff ℝ ∞ XR ∧ HasCompactSupport XR ∧ tsupport XR ⊆ chartAt E3 q '' (W ∩ {p : M | t + δ / 8 < ρ p}) ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 q).symm y i j * XR y i * XR y j ≤ 1) ∧ (∀ y, sepDensDiv (g.coeff (chartAt E3 q).symm) XL y ≠ 0 → y ∈ chartAt E3 q '' (W ∩ {p : M | ρ p < t - δ / 8})) ∧ (∀ y, sepDensDiv (g.coeff (chartAt E3 q).symm) XB y ≠ 0 → y ∈ chartAt E3 q '' (W ∩ {p : M | t - δ < ρ p ∧ ρ p < t + δ})) :=
by
  classical
  obtain ⟨hXs, hXc, hXt, hXn, C0, hC0⟩ := hX
  
  have hpd : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have hJ : ContDiffOn ℝ ∞ (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det)
      (chartAt E3 q).target := by
    have hent : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y i j)
        (chartAt E3 q).target := fun i j => g.smooth q i j
    have hdet : ContDiffOn ℝ ∞ (fun y => (g.coeff (chartAt E3 q).symm y).det)
        (chartAt E3 q).target := by
      simp only [Matrix.det_fin_three]
      have e3 := fun a b c d a' b' => ((hent a b).mul (hent c d)).mul (hent a' b')
      exact (((((e3 0 0 1 1 2 2).sub (e3 0 0 1 2 2 1)).sub (e3 0 1 1 0 2 2)).add
        (e3 0 1 1 2 2 0)).add (e3 0 2 1 0 2 1)).sub (e3 0 2 1 1 2 0)
    exact hdet.sqrt (fun y hy => (hpd y hy).det_pos.ne')
  have hTo : IsOpen (chartAt E3 q).target := (chartAt E3 q).open_target
  generalize hG : g.coeff (chartAt E3 q).symm = G at hJ hXn hC0 ⊢
  
  have hloc : ∀ (Z₁ Z₂ : E3 → E3) (y : E3), Z₁ =ᶠ[𝓝 y] Z₂ →
      sepDensDiv G Z₁ y = sepDensDiv G Z₂ y := by
    intro Z₁ Z₂ y h
    unfold sepDensDiv partialDeriv
    refine Finset.sum_congr rfl fun i _ => ?_
    have h' : (fun z => Real.sqrt (G z).det * Z₁ z i) =ᶠ[𝓝 y]
        (fun z => Real.sqrt (G z).det * Z₂ z i) :=
      h.mono fun z hz => by simp only [hz]
    rw [h'.fderiv_eq]
  have hzero : ∀ (Z : E3 → E3) (y : E3), y ∉ tsupport Z → sepDensDiv G Z y = 0 := by
    intro Z y hy
    rw [hloc Z 0 y (notMem_tsupport_iff_eventuallyEq.1 hy)]
    simp [sepDensDiv, partialDeriv]
  have hcoord : ∀ (Z : E3 → E3) (y : E3), ContDiffAt ℝ ∞ Z y → ∀ i : Fin 3,
      ContDiffAt ℝ ∞ (fun z => Z z i) y := by
    intro Z y hZ i
    exact (contDiffAt_piLp _).1 hZ i
  
  have hbdd : ∀ Z : E3 → E3, ContDiff ℝ ∞ Z → HasCompactSupport Z →
      tsupport Z ⊆ (chartAt E3 q).target → ∃ C, ∀ y, |sepDensDiv G Z y| ≤ C := by
    intro Z hZ hZc hZT
    have hh : ∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (G z).det * Z z i) := by
      intro i
      rw [contDiff_iff_contDiffAt]
      intro y
      by_cases hy : y ∈ (chartAt E3 q).target
      · exact (hJ.contDiffAt (hTo.mem_nhds hy)).mul (hcoord Z y hZ.contDiffAt i)
      · have h0 : Z =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 (fun h => hy (hZT h))
        have h1 : (fun z => Real.sqrt (G z).det * Z z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [h0] with z hz
          simp [hz]
        exact contDiffAt_const.congr_of_eventuallyEq h1
    have hcont : Continuous (sepDensDiv G Z) := by
      unfold sepDensDiv partialDeriv
      exact continuous_finset_sum _ fun i _ =>
        ((hh i).continuous_fderiv (by simp)).clm_apply continuous_const
    have hsupp : HasCompactSupport (sepDensDiv G Z) :=
      HasCompactSupport.intro hZc (fun y hy => hzero Z y hy)
    obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hsupp
    exact ⟨C, fun y => by simpa [Real.norm_eq_abs] using hC y⟩
  
  have hint : ∀ Z : E3 → E3, HasCompactSupport Z → (∃ C, ∀ y, |sepDensDiv G Z y| ≤ C) →
      Integrable (sepDensDiv G Z) := by
    rintro Z hZc ⟨C, hC⟩
    have hmeas : Measurable (sepDensDiv G Z) := by
      unfold sepDensDiv partialDeriv
      exact Finset.measurable_sum _ fun i _ => measurable_fderiv_apply_const ℝ _ _
    have hon : IntegrableOn (sepDensDiv G Z) (tsupport Z) :=
      Measure.integrableOn_of_bounded (M := C) hZc.measure_lt_top.ne hmeas.aestronglyMeasurable
        (ae_of_all _ fun y => by simpa [Real.norm_eq_abs] using hC y)
    exact hon.integrable_of_forall_notMem_eq_zero fun y hy => hzero Z y hy
  
  obtain ⟨ψL, hψL⟩ : ∃ ψ : ℝ → ℝ, ψ = fun s => Real.smoothTransition ((t - δ / 4 - s) / (δ / 4)) :=
    ⟨_, rfl⟩
  obtain ⟨ψR, hψR⟩ : ∃ ψ : ℝ → ℝ, ψ = fun s => Real.smoothTransition ((s - t - δ / 4) / (δ / 4)) :=
    ⟨_, rfl⟩
  have hδ4 : (0 : ℝ) < δ / 4 := by linarith
  have hψLs : ContDiff ℝ ∞ ψL := by
    rw [hψL]
    exact Real.smoothTransition.contDiff.comp ((contDiff_const.sub contDiff_id).div_const _)
  have hψRs : ContDiff ℝ ∞ ψR := by
    rw [hψR]
    exact Real.smoothTransition.contDiff.comp
      (((contDiff_id.sub contDiff_const).sub contDiff_const).div_const _)
  have hψL01 : ∀ s, 0 ≤ ψL s ∧ ψL s ≤ 1 := fun s => by
    simp only [hψL]; exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hψR01 : ∀ s, 0 ≤ ψR s ∧ ψR s ≤ 1 := fun s => by
    simp only [hψR]; exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hψLsupp : ∀ s, ψL s ≠ 0 → s < t - δ / 4 := by
    intro s hs
    by_contra hc
    push_neg at hc
    apply hs
    simp only [hψL]
    apply Real.smoothTransition.zero_of_nonpos
    exact div_nonpos_iff.2 (Or.inr ⟨by linarith, hδ4.le⟩)
  have hψRsupp : ∀ s, ψR s ≠ 0 → t + δ / 4 < s := by
    intro s hs
    by_contra hc
    push_neg at hc
    apply hs
    simp only [hψR]
    apply Real.smoothTransition.zero_of_nonpos
    exact div_nonpos_iff.2 (Or.inr ⟨by linarith, hδ4.le⟩)
  have hψL1 : ∀ s, s ≤ t - δ / 2 → ψL s = 1 := by
    intro s hs
    simp only [hψL]
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ hδ4]
    linarith
  have hψR1 : ∀ s, t + δ / 2 ≤ s → ψR s = 1 := by
    intro s hs
    simp only [hψR]
    apply Real.smoothTransition.one_of_one_le
    rw [le_div_iff₀ hδ4]
    linarith
  obtain ⟨ψB, hψB⟩ : ∃ ψ : ℝ → ℝ, ψ = fun s => 1 - ψL s - ψR s := ⟨_, rfl⟩
  have hψBs : ContDiff ℝ ∞ ψB := by
    rw [hψB]; exact (contDiff_const.sub hψLs).sub hψRs
  have hψLR : ∀ s, ψL s = 0 ∨ ψR s = 0 := by
    intro s
    by_contra h
    push_neg at h
    have h1 := hψLsupp s h.1
    have h2 := hψRsupp s h.2
    linarith
  have hψB01 : ∀ s, 0 ≤ ψB s ∧ ψB s ≤ 1 := by
    intro s
    simp only [hψB]
    have h1 := hψL01 s
    have h2 := hψR01 s
    rcases hψLR s with h | h <;> constructor <;> linarith
  have hψBsupp : ∀ s, ψB s ≠ 0 → t - δ / 2 < s ∧ s < t + δ / 2 := by
    intro s hs
    simp only [hψB] at hs
    constructor
    · by_contra hc
      push_neg at hc
      have h1 := hψL1 s hc
      have h2 : ψR s = 0 := by
        by_contra h; have := hψRsupp s h; linarith
      apply hs; rw [h1, h2]; ring
    · by_contra hc
      push_neg at hc
      have h1 := hψR1 s hc
      have h2 : ψL s = 0 := by
        by_contra h; have := hψLsupp s h; linarith
      apply hs; rw [h1, h2]; ring
  have hψsum : ∀ s, ψL s + ψB s + ψR s = 1 := by
    intro s; simp only [hψB]; ring
  
  obtain ⟨f, hfdef⟩ : ∃ f : E3 → ℝ, f = fun y => ρ ((chartAt E3 q).symm y) := ⟨_, rfl⟩
  have hfat : ∀ y ∈ (chartAt E3 q).target, ContDiffAt ℝ ∞ f y := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ρ ∘ (chartAt E3 q).symm) (chartAt E3 q).target :=
      hρ.comp_contMDiffOn contMDiffOn_chart_symm
    have h2 : ContDiffOn ℝ ∞ f (chartAt E3 q).target := by
      rw [hfdef]; exact contMDiffOn_iff_contDiffOn.mp h1
    intro y hy
    exact h2.contDiffAt (hTo.mem_nhds hy)
  have hf2 : ∀ x ∈ (chartAt E3 q).source, f (chartAt E3 q x) = ρ x := by
    intro x hx
    rw [hfdef]
    simp only
    rw [(chartAt E3 q).left_inv hx]
  have hTX : tsupport X ⊆ (chartAt E3 q).target := by
    intro y hy
    obtain ⟨x, hx, rfl⟩ := hXt hy
    exact (chartAt E3 q).map_source (hW hx)
  have hvan : ∀ (ψ : ℝ → ℝ) (S : Set ℝ), IsClosed S → (∀ s, ψ s ≠ 0 → s ∈ S) →
      ∀ y ∈ (chartAt E3 q).target, f y ∉ S →
        (fun z => ψ (f z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
    intro ψ S hS hψS y hy hfy
    have hc : ContinuousAt f y := (hfat y hy).continuousAt
    have h1 : ∀ᶠ z in 𝓝 y, f z ∈ Sᶜ := hc.preimage_mem_nhds (hS.isOpen_compl.mem_nhds hfy)
    filter_upwards [h1] with z hz
    have h2 : ψ (f z) = 0 := by
      by_contra h
      exact hz (hψS _ h)
    simp [h2]
  
  have hcut : ∀ (ψ : ℝ → ℝ), ContDiff ℝ ∞ ψ → (∀ s, 0 ≤ ψ s ∧ ψ s ≤ 1) →
      ∀ (S : Set ℝ), IsClosed S → (∀ s, ψ s ≠ 0 → s ∈ S) →
      (∀ y, y ∉ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source) →
          ContDiffAt ℝ ∞ (fun z => ψ (f z) • X z) y) ∧
        HasCompactSupport (fun z => ψ (f z) • X z) ∧
        tsupport (fun z => ψ (f z) • X z) ⊆ chartAt E3 q '' (W ∩ {p : M | ρ p ∈ S}) ∧
        (∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          G y i j * (ψ (f y) • X y) i * (ψ (f y) • X y) j ≤ 1) ∧
        ((∀ p ∈ Kc, ρ p ∉ S) → ContDiff ℝ ∞ (fun z => ψ (f z) • X z) ∧
          ∀ y ∈ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source),
            (fun z => ψ (f z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3)) := by
    intro ψ hψ hψ01 S hS hψS
    have ha : ∀ y, y ∉ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source) →
        ContDiffAt ℝ ∞ (fun z => ψ (f z) • X z) y := by
      intro y hyK
      by_cases hy : y ∈ (chartAt E3 q).target
      · exact (hψ.contDiffAt.comp y (hfat y hy)).smul (hXs y hyK)
      · have h0 : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.1 (fun h => hy (hTX h))
        have h1 : (fun z => ψ (f z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
          filter_upwards [h0] with z hz
          simp [hz]
        exact contDiffAt_const.congr_of_eventuallyEq h1
    refine ⟨ha, ?_, ?_, ?_, ?_⟩
    · exact HasCompactSupport.intro hXc (fun y hy => by
        simp [image_eq_zero_of_notMem_tsupport hy])
    · intro y hy
      have hyX : y ∈ tsupport X := tsupport_smul_subset_right (fun z => ψ (f z)) X hy
      obtain ⟨x, hxW, rfl⟩ := hXt hyX
      refine ⟨x, ⟨hxW, ?_⟩, rfl⟩
      by_contra hxS
      have hT := (chartAt E3 q).map_source (hW hxW)
      have hfy : f (chartAt E3 q x) ∉ S := by
        rw [hf2 x (hW hxW)]
        exact hxS
      exact (notMem_tsupport_iff_eventuallyEq.2 (hvan ψ S hS hψS _ hT hfy)) hy
    · intro y
      have hQ := hXn y
      obtain ⟨h0, h1⟩ := hψ01 (f y)
      have e1 : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (ψ (f y) • X y) i * (ψ (f y) • X y) j
          = ψ (f y) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
        simp only [PiLp.smul_apply, WithLp.ofLp_smul, Pi.smul_apply, smul_eq_mul,
          Fin.sum_univ_three]
        ring
      rw [e1]
      have h2 : ψ (f y) ^ 2 ≤ 1 := pow_le_one₀ h0 h1
      have h3 := mul_le_mul_of_nonneg_left hQ (sq_nonneg (ψ (f y)))
      linarith
    · intro hKS
      have hK0 : ∀ y ∈ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source),
          (fun z => ψ (f z) • X z) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        rintro y ⟨p, ⟨hpK, hps⟩, rfl⟩
        exact hvan ψ S hS hψS _ ((chartAt E3 q).map_source hps)
          (by rw [hf2 p hps]; exact hKS p hpK)
      refine ⟨contDiff_iff_contDiffAt.2 fun y => ?_, hK0⟩
      by_cases hy : y ∈ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source)
      · exact contDiffAt_const.congr_of_eventuallyEq (hK0 y hy)
      · exact ha y hy
  
  obtain ⟨aL, bL, cL, dL, -⟩ := hcut ψL hψLs hψL01 (Set.Iic (t - δ / 4)) isClosed_Iic
    (fun s hs => le_of_lt (hψLsupp s hs))
  obtain ⟨-, bB, cB, dB, eB⟩ := hcut ψB hψBs hψB01 (Set.Icc (t - δ / 2) (t + δ / 2)) isClosed_Icc
    (fun s hs => ⟨(hψBsupp s hs).1.le, (hψBsupp s hs).2.le⟩)
  obtain ⟨-, bR, cR, dR, eR⟩ := hcut ψR hψRs hψR01 (Set.Ici (t + δ / 4)) isClosed_Ici
    (fun s hs => le_of_lt (hψRsupp s hs))
  have eB' := eB (fun p hp hS => by
    have h1 := hKc p hp
    have h2 : t - δ / 2 ≤ ρ p := hS.1
    linarith)
  have eR' := eR (fun p hp hS => by
    have h1 := hKc p hp
    have h2 : t + δ / 4 ≤ ρ p := hS
    linarith)
  have cL' : tsupport (fun z => ψL (f z) • X z) ⊆
      chartAt E3 q '' (W ∩ {p : M | ρ p < t - δ / 8}) := by
    refine cL.trans (Set.image_mono (Set.inter_subset_inter_right _ fun p hp => ?_))
    have h1 : ρ p ≤ t - δ / 4 := hp
    show ρ p < t - δ / 8
    linarith
  have cB' : tsupport (fun z => ψB (f z) • X z) ⊆
      chartAt E3 q '' (W ∩ {p : M | t - δ < ρ p ∧ ρ p < t + δ}) := by
    refine cB.trans (Set.image_mono (Set.inter_subset_inter_right _ fun p hp => ?_))
    have h1 : t - δ / 2 ≤ ρ p := hp.1
    have h2 : ρ p ≤ t + δ / 2 := hp.2
    show t - δ < ρ p ∧ ρ p < t + δ
    constructor <;> linarith
  have cR' : tsupport (fun z => ψR (f z) • X z) ⊆
      chartAt E3 q '' (W ∩ {p : M | t + δ / 8 < ρ p}) := by
    refine cR.trans (Set.image_mono (Set.inter_subset_inter_right _ fun p hp => ?_))
    have h1 : t + δ / 4 ≤ ρ p := hp
    show t + δ / 8 < ρ p
    linarith
  have hWT : chartAt E3 q '' W ⊆ (chartAt E3 q).target := by
    rintro y ⟨x, hx, rfl⟩
    exact (chartAt E3 q).map_source (hW hx)
  have hBT : tsupport (fun z => ψB (f z) • X z) ⊆ (chartAt E3 q).target :=
    cB'.trans ((Set.image_mono Set.inter_subset_left).trans hWT)
  have hRT : tsupport (fun z => ψR (f z) • X z) ⊆ (chartAt E3 q).target :=
    cR'.trans ((Set.image_mono Set.inter_subset_left).trans hWT)
  
  have hsum : ∀ y, X y = ψL (f y) • X y + ψB (f y) • X y + ψR (f y) • X y := by
    intro y
    rw [← add_smul, ← add_smul, hψsum, one_smul]
  have hid : ∀ y, sepDensDiv G X y = sepDensDiv G (fun z => ψL (f z) • X z) y +
      sepDensDiv G (fun z => ψB (f z) • X z) y + sepDensDiv G (fun z => ψR (f z) • X z) y := by
    intro y
    by_cases hyK : y ∈ chartAt E3 q '' (Kc ∩ (chartAt E3 q).source)
    · have hB0 := eB'.2 y hyK
      have hR0 := eR'.2 y hyK
      have hXL : X =ᶠ[𝓝 y] (fun z => ψL (f z) • X z) := by
        filter_upwards [hB0, hR0] with z hz1 hz2
        conv_lhs => rw [hsum z]
        rw [hz1, hz2, add_zero, add_zero]
      rw [hloc _ _ y hXL, hloc _ _ y hB0, hloc _ _ y hR0]
      simp [sepDensDiv, partialDeriv]
    · by_cases hyT : y ∈ (chartAt E3 q).target
      · have hJy := hJ.contDiffAt (hTo.mem_nhds hyT)
        have hd : ∀ (Z : E3 → E3), ContDiffAt ℝ ∞ Z y → ∀ i : Fin 3,
            DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * Z z i) y :=
          fun Z hZ i => (hJy.mul (hcoord Z y hZ i)).differentiableAt (by simp)
        have hL := hd _ (aL y hyK)
        have hB := hd _ eB'.1.contDiffAt
        have hR := hd _ eR'.1.contDiffAt
        unfold sepDensDiv partialDeriv
        rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        have e1 : (fun z => Real.sqrt (G z).det * X z i) = fun z =>
            (Real.sqrt (G z).det * (ψL (f z) • X z) i + Real.sqrt (G z).det * (ψB (f z) • X z) i)
              + Real.sqrt (G z).det * (ψR (f z) • X z) i := by
          funext z
          conv_lhs => rw [hsum z]
          simp only [PiLp.add_apply, WithLp.ofLp_add, Pi.add_apply]
          ring
        have h3 : fderiv ℝ (fun z =>
            Real.sqrt (G z).det * (ψL (f z) • X z) i + Real.sqrt (G z).det * (ψB (f z) • X z) i
              + Real.sqrt (G z).det * (ψR (f z) • X z) i) y =
            fderiv ℝ (fun z => Real.sqrt (G z).det * (ψL (f z) • X z) i) y +
              fderiv ℝ (fun z => Real.sqrt (G z).det * (ψB (f z) • X z) i) y +
              fderiv ℝ (fun z => Real.sqrt (G z).det * (ψR (f z) • X z) i) y :=
          (((hL i).hasFDerivAt.add (hB i).hasFDerivAt).add (hR i).hasFDerivAt).fderiv
        rw [e1, h3]
        beta_reduce
        simp only [ContinuousLinearMap.add_apply]
      · have h1 : y ∉ tsupport X := fun h => hyT (hTX h)
        rw [hzero _ y h1, hzero _ y (fun h => h1 (tsupport_smul_subset_right _ _ h)),
          hzero _ y (fun h => h1 (tsupport_smul_subset_right _ _ h)),
          hzero _ y (fun h => h1 (tsupport_smul_subset_right _ _ h))]
        ring
  
  obtain ⟨CB, hCB⟩ := hbdd _ eB'.1 bB hBT
  obtain ⟨CR, hCR⟩ := hbdd _ eR'.1 bR hRT
  have hCL : ∀ y, |sepDensDiv G (fun z => ψL (f z) • X z) y| ≤ C0 + CB + CR := by
    intro y
    have e1 := hid y
    have h1 := abs_le.1 (hC0 y)
    have h2 := abs_le.1 (hCB y)
    have h3 := abs_le.1 (hCR y)
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]
  have hsuppDiv : ∀ (Z : E3 → E3) (A : Set E3), tsupport Z ⊆ A →
      ∀ y, sepDensDiv G Z y ≠ 0 → y ∈ A := by
    intro Z A hZA y hy
    by_contra hyA
    exact hy (hzero Z y (fun h => hyA (hZA h)))
  exact ⟨fun z => ψL (f z) • X z, fun z => ψB (f z) • X z, fun z => ψR (f z) • X z, hid,
    hint _ bL ⟨_, hCL⟩, hint _ bB ⟨CB, hCB⟩, hint _ bR ⟨CR, hCR⟩,
    ⟨aL, bL, cL', dL, ⟨_, hCL⟩⟩, ⟨eB'.1, bB, cB', dB⟩, ⟨eR'.1, bR, cR', dR⟩,
    hsuppDiv _ _ cL', hsuppDiv _ _ cB'⟩

theorem calChartField_smooth [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (p : M) (Y : E3 → E3) (hY : ContDiff ℝ ∞ Y) (hYc : HasCompactSupport Y) (hYt : tsupport Y ⊆ (chartAt E3 p).target) : calSmoothField (Set.indicator (chartAt E3 p).source (fun x : M => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p x) (Y (chartAt E3 p x)) : E3))) :=
by
  classical
  intro q
  
  have chain : ∀ y ∈ (chartAt E3 q).target, (chartAt E3 q).symm y ∈ (chartAt E3 p).source →
      ∀ v : E3,
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm
          (chartAt E3 p ((chartAt E3 q).symm y)) v) : E3) =
      fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 p).symm w))
        (chartAt E3 p ((chartAt E3 q).symm y)) v := by
    intro y hy hyp v
    have hz : chartAt E3 p ((chartAt E3 q).symm y) ∈ (chartAt E3 p).target :=
      (chartAt E3 p).map_source hyp
    have hli : (chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm y)) = (chartAt E3 q).symm y :=
      (chartAt E3 p).left_inv hyp
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
        ((chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm y))) := by
      rw [hli]
      exact (mdifferentiable_chart (I := 𝓘(ℝ, E3)) q).mdifferentiableAt
        ((chartAt E3 q).map_target hy)
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm
        (chartAt E3 p ((chartAt E3 q).symm y)) :=
      (mdifferentiable_chart (I := 𝓘(ℝ, E3)) p).symm.mdifferentiableAt hz
    have hc := mfderiv_comp (chartAt E3 p ((chartAt E3 q).symm y)) hg hf
    rw [mfderiv_eq_fderiv] at hc
    have h1 := congrArg (fun L => L v) hc
    simp only [ContinuousLinearMap.comp_apply] at h1
    have key : ∀ x₁ : M, x₁ = (chartAt E3 q).symm y → ∀ w : E3,
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) x₁ w : E3) =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) w := by
      rintro _ rfl w; rfl
    exact (key _ hli _).symm.trans h1.symm
  
  have hO' : IsOpen ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
    (chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 q).open_source
  have hO₁ : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source) :=
    (chartAt E3 q).isOpen_inter_preimage_symm (chartAt E3 p).open_source
  have hτ : ContDiffOn ℝ ∞ (fun w => chartAt E3 q ((chartAt E3 p).symm w))
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q) (chartAt E3 q).source :=
      contMDiffOn_chart
    have h2 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 p).symm (chartAt E3 p).target :=
      contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp (h1.comp (h2.mono Set.inter_subset_left) (fun w hw => hw.2))
  have hσ : ContDiffOn ℝ ∞ (fun y => chartAt E3 p ((chartAt E3 q).symm y))
      ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source) := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 p) (chartAt E3 p).source :=
      contMDiffOn_chart
    have h2 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q).symm (chartAt E3 q).target :=
      contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp (h1.comp (h2.mono Set.inter_subset_left) (fun w hw => hw.2))
  have hmaps : Set.MapsTo (fun y => chartAt E3 p ((chartAt E3 q).symm y))
      ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) := by
    intro y hy
    refine ⟨(chartAt E3 p).map_source hy.2, ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p ((chartAt E3 q).symm y)) ∈ (chartAt E3 q).source
    rw [(chartAt E3 p).left_inv hy.2]
    exact (chartAt E3 q).map_target hy.1
  have hdτ : ContDiffOn ℝ ∞ (fun w => fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 p).symm w)) w)
      ((chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source) :=
    hτ.fderiv_of_isOpen hO' (by simp)
  have hF : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 p).symm w))
      (chartAt E3 p ((chartAt E3 q).symm y)) (Y (chartAt E3 p ((chartAt E3 q).symm y))))
      ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source) :=
    (hdτ.comp hσ hmaps).clm_apply (hY.comp_contDiffOn hσ)
  
  have hR₁ : ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
      ((chartAt E3 q).symm y) (Set.indicator (chartAt E3 p).source (fun x : M =>
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p x)
          (Y (chartAt E3 p x)) : E3)) ((chartAt E3 q).symm y)) : E3))
      ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 p).source) := by
    refine hF.congr (fun y hy => ?_)
    have hm : (chartAt E3 q).symm y ∈ (chartAt E3 p).source := hy.2
    rw [Set.indicator_of_mem hm]
    exact chain y hy.1 hm _
  
  have hCc : IsCompact ((chartAt E3 p).symm '' tsupport Y) :=
    hYc.isCompact.image_of_continuousOn ((chartAt E3 p).continuousOn_symm.mono hYt)
  have hCcl : IsClosed ((chartAt E3 p).symm '' tsupport Y) := hCc.isClosed
  have hCs : (chartAt E3 p).symm '' tsupport Y ⊆ (chartAt E3 p).source := by
    rintro _ ⟨y, hy, rfl⟩
    exact (chartAt E3 p).map_target (hYt hy)
  have hZ0 : ∀ x : M, x ∉ (chartAt E3 p).symm '' tsupport Y →
      Set.indicator (chartAt E3 p).source (fun x : M =>
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p x)
          (Y (chartAt E3 p x)) : E3)) x = 0 := by
    intro x hx
    by_cases hs : x ∈ (chartAt E3 p).source
    · rw [Set.indicator_of_mem hs]
      have hY0 : Y (chartAt E3 p x) = 0 := by
        refine image_eq_zero_of_notMem_tsupport (fun h => hx ?_)
        exact ⟨_, h, (chartAt E3 p).left_inv hs⟩
      simp only [hY0, map_zero]
    · exact Set.indicator_of_notMem hs _
  have hO₂ : IsOpen ((chartAt E3 q).target ∩
      (chartAt E3 q).symm ⁻¹' ((chartAt E3 p).symm '' tsupport Y)ᶜ) :=
    (chartAt E3 q).isOpen_inter_preimage_symm hCcl.isOpen_compl
  have hR₂ : ContDiffOn ℝ ∞ (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
      ((chartAt E3 q).symm y) (Set.indicator (chartAt E3 p).source (fun x : M =>
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p x)
          (Y (chartAt E3 p x)) : E3)) ((chartAt E3 q).symm y)) : E3))
      ((chartAt E3 q).target ∩
        (chartAt E3 q).symm ⁻¹' ((chartAt E3 p).symm '' tsupport Y)ᶜ) := by
    refine (contDiffOn_const (c := (0 : E3))).congr (fun y hy => ?_)
    rw [hZ0 _ hy.2, map_zero]
  
  refine contDiffOn_of_locally_contDiffOn (fun y hy => ?_)
  by_cases h : (chartAt E3 q).symm y ∈ (chartAt E3 p).symm '' tsupport Y
  · exact ⟨_, hO₁, ⟨hy, hCs h⟩, hR₁.mono Set.inter_subset_right⟩
  · exact ⟨_, hO₂, ⟨hy, h⟩, hR₂.mono Set.inter_subset_right⟩

theorem chart_bump_eq_one [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (p : M) (C : Set M) (hC : IsCompact C) (hCs : C ⊆ (chartAt E3 p).source) : ∃ ζ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ζ ∧ IsCompact (tsupport ζ) ∧ tsupport ζ ⊆ (chartAt E3 p).source ∧ ∀ x ∈ C, ζ x = 1 :=
by
  classical
  set κ := chartAt E3 p with hκ
  
  have hC'c : IsCompact (κ '' C) := hC.image_of_continuousOn (κ.continuousOn.mono hCs)
  have hC'cl : IsClosed (κ '' C) := hC'c.isClosed
  have hC't : κ '' C ⊆ κ.target := by
    rintro _ ⟨x, hx, rfl⟩
    exact κ.map_source (hCs hx)
  
  obtain ⟨N, hNo, hC'N, hNt, hNc⟩ :=
    exists_open_between_and_isCompact_closure hC'c κ.open_target hC't
  
  obtain ⟨χ, hχ0, hχ1, -⟩ := exists_contMDiffMap_zero_one_of_isClosed 𝓘(ℝ, E3) (n := ⊤)
    hNo.isClosed_compl hC'cl (Set.disjoint_compl_left_iff_subset.mpr hC'N)
  have hχs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ χ := χ.contMDiff
  have hχN : ∀ y, χ y ≠ 0 → y ∈ N := by
    intro y hy
    by_contra h
    exact hy (hχ0 h)
  
  set ζ : M → ℝ := Set.indicator κ.source (fun x => χ (κ x)) with hζ
  have hSs : κ.symm '' closure N ⊆ κ.source := by
    rintro _ ⟨y, hy, rfl⟩
    exact κ.map_target (hNt hy)
  have hSc : IsCompact (κ.symm '' closure N) :=
    hNc.image_of_continuousOn (κ.continuousOn_symm.mono hNt)
  have hScl : IsClosed (κ.symm '' closure N) := hSc.isClosed
  
  have hsupp : Function.support ζ ⊆ κ.symm '' closure N := by
    intro x hx
    have hx' : ζ x ≠ 0 := hx
    by_cases hxs : x ∈ κ.source
    · have h1 : ζ x = χ (κ x) := Set.indicator_of_mem hxs _
      rw [h1] at hx'
      exact ⟨κ x, subset_closure (hχN _ hx'), κ.left_inv hxs⟩
    · exact absurd (Set.indicator_of_notMem hxs _) hx'
  have htsupp : tsupport ζ ⊆ κ.symm '' closure N := closure_minimal hsupp hScl
  have htsrc : tsupport ζ ⊆ κ.source := htsupp.trans hSs
  
  have hsmooth : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ζ := by
    apply contMDiff_of_tsupport
    intro x hx
    have hxs : x ∈ κ.source := htsrc hx
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => χ (κ y)) κ.source :=
      hχs.comp_contMDiffOn contMDiffOn_chart
    have h2 : ContMDiffAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => χ (κ y)) x :=
      h1.contMDiffAt (κ.open_source.mem_nhds hxs)
    refine h2.congr_of_eventuallyEq ?_
    exact Filter.eventuallyEq_of_mem (κ.open_source.mem_nhds hxs)
      (fun y hy => Set.indicator_of_mem hy _)
  refine ⟨ζ, hsmooth, hSc.of_isClosed_subset (isClosed_tsupport ζ) htsupp, htsrc, ?_⟩
  
  intro x hx
  have h1 : ζ x = χ (κ x) := Set.indicator_of_mem (hCs hx) _
  rw [h1]
  exact hχ1 ⟨x, hx, rfl⟩

theorem calPiece_regular [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (q : M) (ψ : M → ℝ) (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hψc : IsCompact (tsupport ψ)) (hψs : tsupport ψ ⊆ (chartAt E3 q).source) (W : M → E3) (hW : calSmoothField W) : (∀ i : Fin 3, ContDiff ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det * calPiece q ψ W z i)) ∧ Integrable (sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q ψ W)) :=
by
  classical
  have hposdef : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).PosDef := by
    intro y hy
    have hq : (chartAt E3 q).symm y ∈ (chartAt E3 q).source := (chartAt E3 q).map_target hy
    have hf : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y :=
      mdifferentiableAt_atlas_symm (chart_mem_atlas E3 q) hy
    have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 q) hq
    have hcomp : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)).comp
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y) := mfderiv_comp y hg hf
    have hid : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ((chartAt E3 q) ∘ (chartAt E3 q).symm) y =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) id y := by
      apply Filter.EventuallyEq.mfderiv_eq
      filter_upwards [(chartAt E3 q).eventually_right_inverse hy] with z hz
      exact hz
    rw [mfderiv_id] at hid
    have hinv : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w) = w := by
      intro w
      have h1 := congrArg (fun L => L w) (hcomp.symm.trans hid)
      simpa using h1
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y w = 0 → w = 0 := by
      intro w hw
      rw [← hinv w, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact g.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := g.posDef ((chartAt E3 q).symm y) _ hDv
      have key : star x ⬝ᵥ (g.coeff (chartAt E3 q).symm y).mulVec x =
          g.g ((chartAt E3 q).symm y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  set T : Set E3 := (chartAt E3 q).target with hTdef
  set w : E3 → E3 := fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q)
      ((chartAt E3 q).symm y) (W ((chartAt E3 q).symm y)) : E3) with hwdef
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 q).symm with hGdef
  have hTo : IsOpen T := (chartAt E3 q).open_target
  have hwT : ContDiffOn ℝ ∞ w T := hW q
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) T := fun i j => g.smooth q i j
  have hdetpos : ∀ y ∈ T, 0 < (G y).det := fun y hy =>
    (hposdef y hy).det_pos
  have hdetT : ContDiffOn ℝ ∞ (fun y => (G y).det) T := by
    have e : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1
        - G y 0 1 * G y 1 0 * G y 2 2 + G y 0 1 * G y 1 2 * G y 2 0
        + G y 0 2 * G y 1 0 * G y 2 1 - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y; exact Matrix.det_fin_three _
    rw [e]
    have h := hGs
    exact (((((((h 0 0).mul (h 1 1)).mul (h 2 2)).sub (((h 0 0).mul (h 1 2)).mul (h 2 1))).sub
      (((h 0 1).mul (h 1 0)).mul (h 2 2))).add (((h 0 1).mul (h 1 2)).mul (h 2 0))).add
      (((h 0 2).mul (h 1 0)).mul (h 2 1))).sub (((h 0 2).mul (h 1 1)).mul (h 2 0))
  have hsqT : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) T :=
    hdetT.sqrt (fun y hy => (hdetpos y hy).ne')
  have hwi : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fun y => w y i) T := by
    intro i
    exact (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hwT
  have hψT : ContDiffOn ℝ ∞ (fun y => ψ ((chartAt E3 q).symm y)) T := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ ∘ (chartAt E3 q).symm)
        (chartAt E3 q).target :=
      hψ.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp h1
  have hcp : ∀ (z : E3) (i : Fin 3),
      calPiece q ψ W z i = T.indicator (fun y => ψ ((chartAt E3 q).symm y) * w y i) z := by
    intro z i
    by_cases hz : z ∈ T
    · rw [Set.indicator_of_mem hz]
      simp only [calPiece]
      rw [Set.indicator_of_mem hz]
      rw [WithLp.ofLp_smul]
      rfl
    · rw [Set.indicator_of_notMem hz]
      simp only [calPiece]
      rw [Set.indicator_of_notMem hz]
      simp
  have hKc : IsCompact ((chartAt E3 q) '' tsupport ψ) :=
    hψc.image_of_continuousOn ((chartAt E3 q).continuousOn.mono hψs)
  have hKT : (chartAt E3 q) '' tsupport ψ ⊆ T := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 q).map_source (hψs hx)
  have hvan : ∀ (y : E3) (i : Fin 3), y ∉ (chartAt E3 q) '' tsupport ψ →
      T.indicator (fun y => ψ ((chartAt E3 q).symm y) * w y i) y = 0 := by
    intro y i hy
    by_cases hyT : y ∈ T
    · rw [Set.indicator_of_mem hyT]
      have h0 : ψ ((chartAt E3 q).symm y) = 0 := by
        apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hy ⟨_, hmem, (chartAt E3 q).right_inv hyT⟩
      rw [h0, zero_mul]
    · exact Set.indicator_of_notMem hyT _
  obtain ⟨F, hFdef⟩ : ∃ F : Fin 3 → E3 → ℝ, ∀ i z, F i z =
      Real.sqrt (G z).det * T.indicator (fun y => ψ ((chartAt E3 q).symm y) * w y i) z :=
    ⟨_, fun _ _ => rfl⟩
  have hF : ∀ i : Fin 3, ContDiff ℝ ∞ (F i) := by
    intro i
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ T
    · have hH : ContDiffOn ℝ ∞
          (fun y => Real.sqrt (G y).det * (ψ ((chartAt E3 q).symm y) * w y i)) T :=
        hsqT.mul (hψT.mul (hwi i))
      refine (hH.contDiffAt (hTo.mem_nhds hz)).congr_of_eventuallyEq ?_
      filter_upwards [hTo.mem_nhds hz] with y hy
      rw [hFdef, Set.indicator_of_mem hy]
    · have hzK : z ∉ (chartAt E3 q) '' tsupport ψ := fun h => hz (hKT h)
      refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [hKc.isClosed.isOpen_compl.mem_nhds hzK] with y hy
      rw [hFdef, hvan y i hy, mul_zero]
  have hFc : ∀ i : Fin 3, HasCompactSupport (F i) := by
    intro i
    exact HasCompactSupport.intro hKc (fun y hy => by rw [hFdef, hvan y i hy, mul_zero])
  have hk_pt : ∀ i : Fin 3,
      (fun z => Real.sqrt (G z).det * calPiece q ψ W z i) = F i := by
    intro i; funext z; rw [hFdef, hcp]
  have hdiv : sepDensDiv G (calPiece q ψ W) =
      fun y => ∑ i : Fin 3, partialDeriv i (F i) y := by
    funext y
    unfold sepDensDiv
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hk_pt i]
  refine ⟨fun i => by rw [hk_pt i]; exact hF i, ?_⟩
  rw [hdiv]
  refine integrable_finset_sum _ (fun i _ => ?_)
  have hc : Continuous (partialDeriv i (F i)) :=
    ((hF i).continuous_fderiv (by simp)).clm_apply continuous_const
  have hs : HasCompactSupport (partialDeriv i (F i)) :=
    (hFc i).fderiv_apply (𝕜 := ℝ) (e i)
  exact hc.integrable_of_hasCompactSupport hs

theorem sepDensDiv_transition_pointwise (O : Set E3) (hO : IsOpen O) (τ : E3 → E3)
    (hτ : ContDiffOn ℝ ∞ τ O) (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (P₁ P₂ : E3 → E3)
    (hlaw : ∀ z ∈ O, ∀ i j : Fin 3, G₁ z i j = ∑ a : Fin 3, ∑ b : Fin 3,
      fderiv ℝ τ z (e i) a * G₂ (τ z) a b * fderiv ℝ τ z (e j) b)
    (hpos : ∀ z ∈ O, 0 ≤ (G₂ (τ z)).det)
    (hvec : ∀ z ∈ O, fderiv ℝ τ z (P₁ z) = P₂ (τ z))
    (y : E3) (hy : y ∈ O) (hdet : (fderiv ℝ τ y).det ≠ 0)
    (hW : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G₂ z).det * P₂ z i) (τ y)) :
    sepDensDiv G₁ P₁ y = |(fderiv ℝ τ y).det| * sepDensDiv G₂ P₂ (τ y) :=
by
  classical
  
  have hexpf : ∀ (ℓ : E3 →L[ℝ] ℝ) (v : E3), ℓ v = ∑ b : Fin 3, ℓ (e b) * v b := by
    intro ℓ v
    have hv : v = ∑ b : Fin 3, v b • e b := by
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, e, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [map_smul, smul_eq_mul, mul_comm]
  have hexpv : ∀ (L : E3 →L[ℝ] E3) (v : E3) (k : Fin 3),
      L v k = ∑ b : Fin 3, L (e b) k * v b := by
    intro L v k
    have := hexpf ((EuclideanSpace.proj k).comp L) v
    simpa using this
  
  have hdetJ : ∀ z, (jacMat τ z).det = (fderiv ℝ τ z).det := by
    intro z
    rw [ContinuousLinearMap.det, ← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
    congr 1
  
  have hcof : ∀ (J : Matrix (Fin 3) (Fin 3) ℝ) (p : Fin 3 → ℝ) (a : Fin 3),
      ∑ i : Fin 3, (J (i+1) (a+1) * J (i+2) (a+2) - J (i+1) (a+2) * J (i+2) (a+1)) *
        ∑ b : Fin 3, J i b * p b = J.det * p a := by
    intro J p a
    fin_cases a <;> simp [Fin.sum_univ_three, Matrix.det_fin_three] <;> ring
  
  have hsqrt : ∀ z ∈ O, Real.sqrt (G₁ z).det =
      |(jacMat τ z).det| * Real.sqrt (G₂ (τ z)).det := by
    intro z hz
    have hG : G₁ z = (jacMat τ z).transpose * G₂ (τ z) * jacMat τ z := by
      ext i j
      rw [hlaw z hz i j]
      simp [Matrix.mul_apply, Fin.sum_univ_three, jacMat]
      ring
    rw [hG, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    rw [show (jacMat τ z).det * (G₂ (τ z)).det * (jacMat τ z).det =
      (jacMat τ z).det ^ 2 * (G₂ (τ z)).det by ring]
    rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
  
  obtain ⟨W, hWdef⟩ : ∃ W : Fin 3 → E3 → ℝ, ∀ i w, W i w = Real.sqrt (G₂ w).det * P₂ w i :=
    ⟨_, fun _ _ => rfl⟩
  have hWfun : ∀ i, W i = fun w => Real.sqrt (G₂ w).det * P₂ w i := fun i => funext (hWdef i)
  obtain ⟨F, hFdef⟩ : ∃ F : Fin 3 → E3 → ℝ, ∀ a z, F a z = ∑ i : Fin 3,
      (jacMat τ z (i+1) (a+1) * jacMat τ z (i+2) (a+2) -
        jacMat τ z (i+1) (a+2) * jacMat τ z (i+2) (a+1)) * W i (τ z) :=
    ⟨_, fun _ _ => rfl⟩
  have hFz : ∀ z ∈ O, ∀ a : Fin 3,
      F a z = (jacMat τ z).det * Real.sqrt (G₂ (τ z)).det * P₁ z a := by
    intro z hz a
    have hP : ∀ i, P₂ (τ z) i = ∑ b : Fin 3, jacMat τ z i b * P₁ z b := by
      intro i
      rw [← hvec z hz, hexpv]
      rfl
    have h := hcof (jacMat τ z) (fun b => P₁ z b) a
    rw [hFdef]
    simp only [hWdef, hP]
    simp only [Fin.sum_univ_three] at h ⊢
    linear_combination (Real.sqrt (G₂ (τ z)).det) * h
  
  have hyN : O ∈ 𝓝 y := hO.mem_nhds hy
  have hτc : ContDiffAt ℝ ∞ τ y := hτ.contDiffAt hyN
  have hτd : DifferentiableAt ℝ τ y := hτc.differentiableAt (by simp)
  have hD1 : ContDiffAt ℝ 1 (fderiv ℝ τ) y := hτc.fderiv_right (m := 1)
    (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
  have hDd : DifferentiableAt ℝ (fderiv ℝ τ) y := hD1.differentiableAt one_ne_zero
  have hsymm : IsSymmSndFDerivAt ℝ τ y :=
    hτc.isSymmSndFDerivAt (by simpa using (WithTop.coe_le_coe.mpr le_top : (2 : WithTop ℕ∞) ≤ ∞))
  obtain ⟨L, hB, hLsym⟩ : ∃ L : Fin 3 → Fin 3 → E3 →L[ℝ] ℝ,
      (∀ k a, HasFDerivAt (fun z => jacMat τ z k a) (L k a) y) ∧
      ∀ k a b, L k a (e b) = L k b (e a) := by
    refine ⟨fun k a => ((EuclideanSpace.proj k).comp
      (ContinuousLinearMap.apply ℝ E3 (e a))).comp (fderiv ℝ (fderiv ℝ τ) y), ?_, ?_⟩
    · intro k a
      have h := ((EuclideanSpace.proj k).comp
        (ContinuousLinearMap.apply ℝ E3 (e a))).hasFDerivAt.comp y hDd.hasFDerivAt
      convert h using 1
    · intro k a b
      simp only [ContinuousLinearMap.coe_comp', Function.comp_apply,
        ContinuousLinearMap.apply_apply]
      rw [hsymm (e b) (e a)]
  have hV : ∀ i, HasFDerivAt (fun z => W i (τ z))
      ((fderiv ℝ (W i) (τ y)).comp (fderiv ℝ τ y)) y := by
    intro i
    have hWi : DifferentiableAt ℝ (W i) (τ y) := by
      rw [hWfun i]; exact hW i
    exact hWi.hasFDerivAt.comp y hτd.hasFDerivAt
  have hF : ∀ a, HasFDerivAt (F a) (∑ i : Fin 3,
      ((jacMat τ y (i+1) (a+1) * jacMat τ y (i+2) (a+2) -
        jacMat τ y (i+1) (a+2) * jacMat τ y (i+2) (a+1)) •
          (fderiv ℝ (W i) (τ y)).comp (fderiv ℝ τ y) +
        W i (τ y) • ((jacMat τ y (i+1) (a+1) • L (i+2) (a+2) +
            jacMat τ y (i+2) (a+2) • L (i+1) (a+1)) -
          (jacMat τ y (i+1) (a+2) • L (i+2) (a+1) +
            jacMat τ y (i+2) (a+1) • L (i+1) (a+2))))) y := by
    intro a
    have hFa : F a = fun z => ∑ i ∈ Finset.univ,
        (jacMat τ z (i+1) (a+1) * jacMat τ z (i+2) (a+2) -
          jacMat τ z (i+1) (a+2) * jacMat τ z (i+2) (a+1)) * W i (τ z) :=
      funext (hFdef a)
    rw [hFa]
    exact HasFDerivAt.fun_sum fun i _ =>
      (((hB (i+1) (a+1)).fun_mul (hB (i+2) (a+2))).fun_sub
        ((hB (i+1) (a+2)).fun_mul (hB (i+2) (a+1)))).fun_mul (hV i)
  
  have hDV : ∀ i a, fderiv ℝ (W i) (τ y) (fderiv ℝ τ y (e a)) =
      ∑ b : Fin 3, fderiv ℝ (W i) (τ y) (e b) * jacMat τ y b a := by
    intro i a
    rw [hexpf]
    rfl
  have h01 : ∀ k, L k 0 (e 1) = L k 1 (e 0) := fun k => hLsym k 0 1
  have h02 : ∀ k, L k 0 (e 2) = L k 2 (e 0) := fun k => hLsym k 0 2
  have h12 : ∀ k, L k 1 (e 2) = L k 2 (e 1) := fun k => hLsym k 1 2
  have hdiv : ∑ a : Fin 3, fderiv ℝ (F a) y (e a) =
      (jacMat τ y).det * ∑ i : Fin 3, fderiv ℝ (W i) (τ y) (e i) := by
    simp only [fun a => (hF a).fderiv]
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_comp', Function.comp_apply, smul_eq_mul, hDV]
    simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceAdd, Matrix.det_fin_three]
    simp only [h01, h02, h12]
    ring
  
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = if 0 < (fderiv ℝ τ y).det then 1 else -1 := ⟨_, rfl⟩
  have hs : 0 < s * (fderiv ℝ τ y).det := by
    rw [hsdef]
    split_ifs with h
    · linarith
    · have h' : (fderiv ℝ τ y).det < 0 := lt_of_le_of_ne (not_lt.mp h) hdet
      linarith
  have habs : ∀ t : ℝ, 0 < s * t → |t| = s * t := by
    intro t ht
    rw [hsdef] at ht ⊢
    split_ifs at ht ⊢ with h
    · rw [abs_of_pos (by linarith)]; ring
    · rw [abs_of_neg (by linarith)]; ring
  have hδc : ContinuousAt (fun z => (fderiv ℝ τ z).det) y :=
    ContinuousLinearMap.continuous_det.continuousAt.comp hDd.continuousAt
  have hev : ∀ᶠ z in 𝓝 y, 0 < s * (fderiv ℝ τ z).det :=
    (continuousAt_const.mul hδc).eventually (lt_mem_nhds hs)
  have hgerm : ∀ a : Fin 3, (fun z => Real.sqrt (G₁ z).det * P₁ z a) =ᶠ[𝓝 y]
      fun z => s * F a z := by
    intro a
    filter_upwards [hyN, hev] with z hz hz'
    rw [hFz z hz a, hsqrt z hz, hdetJ z, habs _ hz']
    ring
  have hpart : ∀ a : Fin 3, partialDeriv a (fun z => Real.sqrt (G₁ z).det * P₁ z a) y =
      s * fderiv ℝ (F a) y (e a) := by
    intro a
    unfold partialDeriv
    rw [(((hF a).const_mul s).congr_of_eventuallyEq (hgerm a)).fderiv, (hF a).fderiv]
    rfl
  unfold sepDensDiv
  rw [Finset.sum_congr rfl (fun a _ => hpart a), ← Finset.mul_sum, hdiv, hdetJ,
    habs _ hs]
  simp only [partialDeriv, hWfun]
  ring

theorem calPiece_div_integral_chart_eq [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p q : M) (φ : M → ℝ) (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ) (hφc : IsCompact (tsupport φ)) (hφs : tsupport φ ⊆ (chartAt E3 p).source ∩ (chartAt E3 q).source) (V : M → E3) (hV : calSmoothField V) (E : Set M) (hE : sepChartMeas E) : ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source), sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y = ∫ y in chartAt E3 q '' (E ∩ (chartAt E3 q).source), sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V) y :=
by
  classical
  have hKp : tsupport φ ⊆ (chartAt E3 p).source := fun x hx => (hφs hx).1
  have hKq : tsupport φ ⊆ (chartAt E3 q).source := fun x hx => (hφs hx).2
  
  have zeroOff : ∀ r : M, tsupport φ ⊆ (chartAt E3 r).source →
      ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3), y ∉ chartAt E3 r '' tsupport φ →
        sepDensDiv G (calPiece r φ V) y = 0 := by
    intro r hKr G y hy
    have hKrc : IsCompact (chartAt E3 r '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 r).continuousOn.mono hKr)
    have hz : ∀ z, z ∉ chartAt E3 r '' tsupport φ → calPiece r φ V z = 0 := by
      intro z hz
      unfold calPiece
      by_cases hzt : z ∈ (chartAt E3 r).target
      · rw [Set.indicator_of_mem hzt]
        have h0 : φ ((chartAt E3 r).symm z) = 0 := by
          by_contra h0
          exact hz ⟨_, subset_tsupport _ h0, (chartAt E3 r).right_inv hzt⟩
        simp [h0]
      · exact Set.indicator_of_notMem hzt _
    unfold sepDensDiv
    refine Finset.sum_eq_zero fun i _ => ?_
    have hev : (fun z => Real.sqrt (G z).det * calPiece r φ V z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [hKrc.isClosed.isOpen_compl.mem_nhds hy] with z hz'
      rw [hz z hz']
      simp
    unfold partialDeriv
    rw [hev.fderiv_eq]
    simp
  
  have restrict : ∀ r : M, tsupport φ ⊆ (chartAt E3 r).source →
      ∫ y in chartAt E3 r '' (E ∩ (chartAt E3 r).source),
          sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) y =
        ∫ y in chartAt E3 r '' (E ∩ tsupport φ),
          sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) y := by
    intro r hKr
    have hKrc : IsCompact (chartAt E3 r '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 r).continuousOn.mono hKr)
    have hfun : sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V) =
        (chartAt E3 r '' tsupport φ).indicator
          (sepDensDiv (g.coeff (chartAt E3 r).symm) (calPiece r φ V)) := by
      funext y
      by_cases hy : y ∈ chartAt E3 r '' tsupport φ
      · rw [Set.indicator_of_mem hy]
      · rw [Set.indicator_of_notMem hy, zeroOff r hKr _ y hy]
    have hset : chartAt E3 r '' (E ∩ (chartAt E3 r).source) ∩ chartAt E3 r '' tsupport φ =
        chartAt E3 r '' (E ∩ tsupport φ) := by
      rw [← Set.InjOn.image_inter (chartAt E3 r).injOn Set.inter_subset_right hKr]
      congr 1
      ext x
      constructor
      · rintro ⟨⟨hxE, -⟩, hxK⟩
        exact ⟨hxE, hxK⟩
      · rintro ⟨hxE, hxK⟩
        exact ⟨⟨hxE, hKr hxK⟩, hxK⟩
    conv_lhs => rw [hfun]
    rw [MeasureTheory.setIntegral_indicator hKrc.measurableSet, hset]
  
  have hAp_meas : MeasurableSet (chartAt E3 p '' (E ∩ tsupport φ)) := by
    have hKpc : IsCompact (chartAt E3 p '' tsupport φ) :=
      hφc.image_of_continuousOn ((chartAt E3 p).continuousOn.mono hKp)
    have h := (hE p).inter hKpc.measurableSet
    rwa [← Set.InjOn.image_inter (chartAt E3 p).injOn Set.inter_subset_right hKp,
      show E ∩ (chartAt E3 p).source ∩ tsupport φ = E ∩ tsupport φ from by
        ext x
        constructor
        · rintro ⟨⟨hxE, -⟩, hxK⟩
          exact ⟨hxE, hxK⟩
        · rintro ⟨hxE, hxK⟩
          exact ⟨⟨hxE, hKp hxK⟩, hxK⟩] at h
  
  set τ : E3 → E3 := fun z => chartAt E3 q ((chartAt E3 p).symm z) with hτdef
  set O : Set E3 := (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' (chartAt E3 q).source
    with hOdef
  have hOopen : IsOpen O :=
    (chartAt E3 p).isOpen_inter_preimage_symm (chartAt E3 q).open_source
  have hApO : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ), y ∈ O := by
    rintro _ ⟨x, hx, rfl⟩
    refine ⟨(chartAt E3 p).map_source (hKp hx.2), ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p x) ∈ (chartAt E3 q).source
    rw [(chartAt E3 p).left_inv (hKp hx.2)]
    exact hKq hx.2
  have himg : τ '' (chartAt E3 p '' (E ∩ tsupport φ)) = chartAt E3 q '' (E ∩ tsupport φ) := by
    rw [Set.image_image]
    refine Set.image_congr ?_
    intro x hx
    simp only [τ, (chartAt E3 p).left_inv (hKp hx.2)]
  have hinj : Set.InjOn τ (chartAt E3 p '' (E ∩ tsupport φ)) := by
    rintro _ ⟨x₁, hx₁, rfl⟩ _ ⟨x₂, hx₂, rfl⟩ h
    simp only [τ, (chartAt E3 p).left_inv (hKp hx₁.2),
      (chartAt E3 p).left_inv (hKp hx₂.2)] at h
    rw [(chartAt E3 q).injOn (hKq hx₁.2) (hKq hx₂.2) h]
  have hderiv : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ),
      HasFDerivWithinAt τ (fderiv ℝ τ y) (chartAt E3 p '' (E ∩ tsupport φ)) y := by
    intro y hy
    exact (sep_chart_transition g p q y (hApO y hy).1 (hApO y hy).2).1.hasFDerivAt.hasFDerivWithinAt
  have hcov := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hAp_meas
    hderiv hinj (sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V))
  
  have hτsmooth : ContDiffOn ℝ ∞ τ O := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 q ∘ (chartAt E3 p).symm) O :=
      (contMDiffOn_chart (x := q)).comp (contMDiffOn_chart_symm.mono Set.inter_subset_left)
        (fun z hz => hz.2)
    exact contMDiffOn_iff_contDiffOn.mp h1
  have detne : ∀ y ∈ O, (fderiv ℝ τ y).det ≠ 0 := by
    intro y hy
    have hτt : τ y ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hy.2
    have hback : (chartAt E3 q).symm (τ y) = (chartAt E3 p).symm y := (chartAt E3 q).left_inv hy.2
    have hσsrc : (chartAt E3 q).symm (τ y) ∈ (chartAt E3 p).source := by
      rw [hback]
      exact (chartAt E3 p).map_target hy.1
    have hσ := (sep_chart_transition g q p (τ y) hτt hσsrc).1
    have hτd : DifferentiableAt ℝ τ y := (sep_chart_transition g p q y hy.1 hy.2).1
    have hev : (fun w => chartAt E3 p ((chartAt E3 q).symm w)) ∘ τ =ᶠ[𝓝 y] id := by
      filter_upwards [hOopen.mem_nhds hy] with z hz
      simp only [Function.comp_apply, id, τ, (chartAt E3 q).left_inv hz.2,
        (chartAt E3 p).right_inv hz.1]
    have hcomp : (fderiv ℝ (fun w => chartAt E3 p ((chartAt E3 q).symm w)) (τ y)).comp
        (fderiv ℝ τ y) = ContinuousLinearMap.id ℝ E3 := by
      rw [← fderiv_comp y hσ hτd, hev.fderiv_eq, fderiv_id]
    have hdet := congrArg (fun L : E3 →L[ℝ] E3 => LinearMap.det (L : E3 →ₗ[ℝ] E3)) hcomp
    simp only [ContinuousLinearMap.coe_comp, LinearMap.det_comp, ContinuousLinearMap.coe_id,
      LinearMap.det_id] at hdet
    exact right_ne_zero_of_mul_eq_one hdet
  
  have vecLaw : ∀ y ∈ O, fderiv ℝ τ y (calPiece p φ V y) = calPiece q φ V (τ y) := by
    intro y hy
    have hxp : (chartAt E3 p).symm y ∈ (chartAt E3 p).source := (chartAt E3 p).map_target hy.1
    have hxq : (chartAt E3 p).symm y ∈ (chartAt E3 q).source := hy.2
    have hτt : τ y ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hy.2
    have hback : (chartAt E3 q).symm (τ y) = (chartAt E3 p).symm y := (chartAt E3 q).left_inv hy.2
    have hcpx : chartAt E3 p ((chartAt E3 p).symm y) = y := (chartAt E3 p).right_inv hy.1
    unfold calPiece
    rw [Set.indicator_of_mem hy.1, Set.indicator_of_mem hτt]
    show _ = (fun z => (φ z • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) z (V z) : E3))
      ((chartAt E3 q).symm (τ y))
    rw [hback]
    simp only [map_smul]
    congr 1
    have hcp : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y) :=
      mdifferentiableAt_atlas (chart_mem_atlas E3 p) hxp
    have hτm : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ
        (chartAt E3 p ((chartAt E3 p).symm y)) := by
      rw [hcpx]
      exact (mdifferentiableAt_atlas (chart_mem_atlas E3 q) hxq).comp y
        (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 p) hy.1)
    have hev : (chartAt E3 q : M → E3) =ᶠ[𝓝 ((chartAt E3 p).symm y)] τ ∘ chartAt E3 p := by
      filter_upwards [(chartAt E3 p).open_source.mem_nhds hxp] with w hw
      simp only [Function.comp_apply, τ, (chartAt E3 p).left_inv hw]
    have h1 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 p).symm y) =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (τ ∘ chartAt E3 p) ((chartAt E3 p).symm y) :=
      hev.mfderiv_eq
    have h2 := mfderiv_comp ((chartAt E3 p).symm y) hτm hcp
    have h3 : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ (chartAt E3 p ((chartAt E3 p).symm y)) =
        fderiv ℝ τ y := by
      rw [hcpx, mfderiv_eq_fderiv]
    rw [h1, h2]
    show (fderiv ℝ τ y) _ = (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ (chartAt E3 p ((chartAt E3 p).symm y)))
      ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p) ((chartAt E3 p).symm y))
        (V ((chartAt E3 p).symm y)))
    rw [h3]
    rfl
  
  have pw : ∀ y ∈ chartAt E3 p '' (E ∩ tsupport φ),
      sepDensDiv (g.coeff (chartAt E3 p).symm) (calPiece p φ V) y =
        |(fderiv ℝ τ y).det| • sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q φ V) (τ y) := by
    intro y hy
    rw [smul_eq_mul]
    exact sepDensDiv_transition_pointwise O hOopen τ hτsmooth (g.coeff (chartAt E3 p).symm)
      (g.coeff (chartAt E3 q).symm) (calPiece p φ V) (calPiece q φ V)
      (fun z hz i j => (sep_chart_transition g p q z hz.1 hz.2).2.1 i j)
      (fun z hz => (coeff_chart_symm_posDef g q (τ z)
        ((chartAt E3 q).map_source hz.2)).det_pos.le)
      vecLaw y (hApO y hy) (detne y (hApO y hy))
      (fun i => ((calPiece_regular g q φ hφ hφc hKq V hV).1 i).differentiable (by simp) (τ y))
  
  rw [restrict p hKp, restrict q hKq, ← himg, hcov]
  exact MeasureTheory.setIntegral_congr_fun hAp_meas pw

theorem sepRiemPer_witness_field [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Ω : Set M) (hΩ : IsOpen Ω) (m : ℕ) (p : Fin m → M) (W : Fin m → Set M) (hW : ∀ k, IsOpen (W k) ∧ W k ⊆ Ω ∩ (chartAt E3 (p k)).source) (hWd : Pairwise (fun k l => Disjoint (W k) (W l))) (Y : Fin m → E3 → E3) (hY : ∀ k, ContDiff ℝ ∞ (Y k) ∧ HasCompactSupport (Y k) ∧ tsupport (Y k) ⊆ chartAt E3 (p k) '' W k ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 (p k)).symm y i j * Y k y i * Y k y j ≤ 1) : ∃ (V : M → E3) (K : Set M), calSmoothField V ∧ (∀ x, g.g x (V x) (V x) ≤ 1) ∧ IsCompact K ∧ K ⊆ Ω ∧ (∀ x, x ∉ K → V x = 0) ∧ ∀ (n : ℕ) (q : Fin n → M) (φ : Fin n → M → ℝ), calPartition q φ Ω → (∀ x ∈ K, ∑ j, φ j x = 1) → ∀ E : Set M, sepChartMeas E → ∑ k, ∫ y in chartAt E3 (p k) '' (E ∩ (chartAt E3 (p k)).source), sepDensDiv (g.coeff (chartAt E3 (p k)).symm) (Y k) y = calDivSum g q φ E V :=
by
  classical
  have hta : ∀ k, tsupport (Y k) ⊆ (chartAt E3 (p k)).target := by
    intro k y hy
    obtain ⟨w, hw, rfl⟩ := (hY k).2.2.1 hy
    exact (chartAt E3 (p k)).map_source ((hW k).2 hw).2
  obtain ⟨Yf, hYf⟩ : ∃ Yf : Fin m → M → E3, Yf = fun k => Set.indicator (chartAt E3 (p k)).source
      (fun x : M => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (p k)).symm (chartAt E3 (p k) x)
        (Y k (chartAt E3 (p k) x)) : E3)) := ⟨_, rfl⟩
  obtain ⟨C, hC⟩ : ∃ C : Fin m → Set M,
      C = fun k => (chartAt E3 (p k)).symm '' tsupport (Y k) := ⟨_, rfl⟩
  have hCW : ∀ k, C k ⊆ W k := by
    intro k
    rw [hC]
    rintro _ ⟨y, hy, rfl⟩
    obtain ⟨w, hw, rfl⟩ := (hY k).2.2.1 hy
    rw [(chartAt E3 (p k)).left_inv ((hW k).2 hw).2]
    exact hw
  have hCs : ∀ k, C k ⊆ (chartAt E3 (p k)).source := fun k x hx => ((hW k).2 (hCW k hx)).2
  have hCc : ∀ k, IsCompact (C k) := by
    intro k
    rw [hC]
    exact (hY k).2.1.isCompact.image_of_continuousOn
      ((chartAt E3 (p k)).continuousOn_symm.mono (hta k))
  have hYfC : ∀ k x, Yf k x ≠ 0 → x ∈ C k := by
    intro k x hx
    by_cases hs : x ∈ (chartAt E3 (p k)).source
    · by_cases hy : Y k (chartAt E3 (p k) x) = 0
      · exfalso
        apply hx
        rw [hYf]
        simp only [Set.indicator_of_mem hs, hy, map_zero]
      · rw [hC]
        exact ⟨_, subset_tsupport _ hy, (chartAt E3 (p k)).left_inv hs⟩
    · exfalso
      apply hx
      rw [hYf]
      simp only [Set.indicator_of_notMem hs]
  have hYfs : ∀ k, calSmoothField (Yf k) := by
    intro k
    rw [hYf]
    exact calChartField_smooth (p k) (Y k) (hY k).1 (hY k).2.1 (hta k)
  obtain ⟨V, hV⟩ : ∃ V : M → E3, V = fun x => ∑ k, Yf k x := ⟨_, rfl⟩
  have quad : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (L : E3 →L[ℝ] E3) (w : E3),
      B (L w) (L w) = ∑ i : Fin 3, ∑ j : Fin 3, B (L (e i)) (L (e j)) * w i * w j := by
    intro B L w
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr w]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, e]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  refine ⟨V, ⋃ k, C k, ?_, ?_, isCompact_iUnion hCc, ?_, ?_, ?_⟩
  · intro q
    have hfun : (fun y => (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
        (V ((chartAt E3 q).symm y)) : E3)) = fun y => ∑ k, (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3)
          (chartAt E3 q) ((chartAt E3 q).symm y) (Yf k ((chartAt E3 q).symm y)) : E3) := by
      funext y
      rw [hV]
      exact map_sum _ _ _
