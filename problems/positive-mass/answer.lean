      · have ht1 : dist (t - (4 * bm.rOut) • e 0) c < s₂ := ht.1
        have ht2 : (0 : ℝ) < (t - (4 * bm.rOut) • e 0) 0 := ht.2
        have hu0 : (t - (4 * bm.rOut) • e 0) 0 = t 0 - 4 * bm.rOut := by simp
        have hn : bm.normed volume (x + (2 * bm.rOut) • e 0 - t) = 0 := by
