    fun z x hx hz hmax => cfd_max_lapLoc_nonpos G U hUo z hz x hx (hpd x (lt_trans hR₂ρ hx)) hmax
  have hlin : ∀ (s a c : ℝ) (x : E3), ρ < ‖x‖ →
      lapLoc G (fun y => s * u y - a * w y - c) x = s * lapLoc G u x - a * lapLoc G w x :=
    fun s a c x hx => cfd_lapLoc_affine G U hUo u w (hu2.mono hUsub) hw.contDiffOn x hx s a c
  
  have hucont : ContinuousOn u {x : E3 | R₀ < ‖x‖} := hu2.continuousOn
  have hwcont : Continuous w := hw.continuous
  have hsph_sub : sphere (0 : E3) ρ ⊆ {x : E3 | R₀ < ‖x‖} := by
    intro y hy
    have hy' : ‖y‖ = ρ := mem_sphere_zero_iff_norm.mp hy
    show R₀ < ‖y‖
    rw [hy']; exact hR₀ρ
  obtain ⟨M, hM⟩ :=
    (isCompact_sphere (0 : E3) ρ).exists_bound_of_continuousOn (hucont.mono hsph_sub)
  have hsne : (sphere (0 : E3) ρ).Nonempty := NormedSpace.sphere_nonempty.mpr hρpos.le
  obtain ⟨ym, hym, hymin⟩ :=
    (isCompact_sphere (0 : E3) ρ).exists_isMinOn hsne hwcont.continuousOn
  obtain ⟨m, hmdef⟩ : ∃ m : ℝ, m = w ym := ⟨_, rfl⟩
  have hm : 0 < m := by rw [hmdef]; exact hwpos ym
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = (max M 0 + 1) / m := ⟨_, rfl⟩
  have hM0 : 0 ≤ max M 0 := le_max_right _ _
  have hApos : 0 < A := by rw [hAdef]; positivity
  have hA : 0 ≤ A := hApos.le
  have hAm : A * m = max M 0 + 1 := by rw [hAdef]; field_simp
  have hAsph : ∀ y ∈ sphere (0 : E3) ρ, |u y| < A * w y := by
    intro y hy
