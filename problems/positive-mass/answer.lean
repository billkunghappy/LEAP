    have hGC : ContinuousOn G (Metric.ball 0 T) := by
      have hGeq : G = fun ζ i => (F (x₀ + ρ • ζ) i - F x₀ i -
          ∑ j : Fin 2, (a (x₀ + ρ • ζ) i j - a x₀ i j) * smthGrad w x₀ j) / κ :=
        funext fun ζ => funext fun i => hG ζ i
      rw [hGeq]
      refine continuousOn_pi.2 (fun i => ?_)
      have h1 : ContinuousOn (fun ζ => F (x₀ + ρ • ζ) i) (Metric.ball 0 T) :=
        (continuous_apply i).comp_continuousOn hFC'
      have h2 : ∀ j, ContinuousOn (fun ζ => a (x₀ + ρ • ζ) i j) (Metric.ball 0 T) := fun j =>
        (continuous_apply j).comp_continuousOn ((continuous_apply i).comp_continuousOn hbC)
      refine ContinuousOn.div_const ?_ _
      refine (h1.sub continuousOn_const).sub ?_
      exact continuousOn_finset_sum _
        (fun j _ => ((h2 j).sub continuousOn_const).mul continuousOn_const)
    exact hrig T (fun ζ => a (x₀ + ρ • ζ)) G W ξ hTε hξn.le hWC hW0 hgW0 h6 h7
      (fun ζ hζ η => hE _ (hAS ζ hζ) η) (fun ζ hζ i j => hBa _ (hAS ζ hζ) i j) hbC hGC h12 h13
      hWsol
  
  have hwt₀ : ∀ x ∈ Metric.ball y R, ∀ z ∈ Metric.ball y R,
      (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖ ≤
        L₀ * dist x z ^ (α : ℝ) := fun x hx z hz =>
    le_trans (hwt x hx z hz) (mul_le_mul_of_nonneg_right key (by positivity))
  obtain ⟨-, hII₀⟩ := smth_sch_weighted_interp α y R K L₀ w hR (by linarith) hC1 hBw hwt₀
  have hR2 : Metric.ball y (R / 2) ⊆ Metric.ball y R := Metric.ball_subset_ball (by linarith)
  refine ⟨?_, ?_⟩
  · intro x hx z hz
    have hxd : R / 2 < R - dist x y := by have := Metric.mem_ball.1 hx; linarith
    have hzd : R / 2 < R - dist z y := by have := Metric.mem_ball.1 hz; linarith
    have hm : R / 2 ≤ min (R - dist x y) (R - dist z y) := le_min hxd.le hzd.le
    have hmα : (R / 2) ^ (1 + (α : ℝ)) ≤ (min (R - dist x y) (R - dist z y)) ^ (1 + (α : ℝ)) :=
      Real.rpow_le_rpow (by positivity) hm (by positivity)
    have h2 : (R / 2) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖ ≤ L₀ * dist x z ^ (α : ℝ) :=
      le_trans (mul_le_mul_of_nonneg_right hmα (norm_nonneg _)) (hwt₀ x (hR2 hx) z (hR2 hz))
    have e1 : (2 / R) ^ (1 + (α : ℝ)) * (R / 2) ^ (1 + (α : ℝ)) = 1 := by
      rw [← Real.mul_rpow (by positivity) (by positivity)]
      rw [show 2 / R * (R / 2) = 1 by field_simp, Real.one_rpow]
    have h3 : ‖smthGrad w x - smthGrad w z‖ ≤ L₀ * (2 / R) ^ (1 + (α : ℝ)) * dist x z ^ (α : ℝ) := by
      calc ‖smthGrad w x - smthGrad w z‖
          = (2 / R) ^ (1 + (α : ℝ)) * ((R / 2) ^ (1 + (α : ℝ)) * ‖smthGrad w x - smthGrad w z‖) := by
            rw [← mul_assoc, e1, one_mul]
