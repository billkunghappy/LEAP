      x hF₁ hT hF₂ hτ hgram hgerm i₁ i₂
  
  let P : EigPatchedSurface M Sig :=
    { n := t.card
      W := fun j => Wf (pts j)
      param := fun j x => (chartAt E3 (pts j)).symm (Ff (pts j) x)
      proj := fun j y => Cf (pts j) (chartAt E3 (pts j) y)
      O := fun j => Of (pts j)
      h := fun j => pullMetric2 (g.coeff (chartAt E3 (pts j)).symm) (Ff (pts j))
      W_open := fun j => (S2 _ (hpts j)).2.2.1.1
      O_open := fun j => (S2 _ (hpts j)).2.2.2.1
      param_cont := fun j => (S2 _ (hpts j)).2.2.2.2.2.1
      proj_cont := fun j => (S2 _ (hpts j)).2.2.2.2.2.2.1
      image_eq := fun j => (S2 _ (hpts j)).2.2.2.2.2.2.2.1
      proj_param := fun j => (S2 _ (hpts j)).2.2.2.2.2.2.2.2.1
      cover := by
        intro y hy
        obtain ⟨p, hpt, hyp⟩ := Set.mem_iUnion₂.1 (hcov hy)
        obtain ⟨j, rfl⟩ := hsurj p hpt
        exact Set.mem_iUnion.2 ⟨j, hyp⟩
      trans_smooth := hτs
      h_smooth := fun j => (s5 (pts j) _ _ (S2 _ (hpts j)).2.2.1).1
      h_posDef := fun j => (s5 (pts j) _ _ (S2 _ (hpts j)).2.2.1).2
      h_compat := hcompat }
  refine ⟨P, fun j => ⟨pts j, Ff (pts j), (S2 _ (hpts j)).2.2.1, rfl, rfl⟩, ?_⟩
  
  refine s4 P ?_
  intro j z W F _ hF hFt
  refine (s1 z (pts j) W F (Cf (pts j)) hF hFt (S2 _ (hpts j)).2.1).mono ?_
  intro x hx
  exact ⟨hx.1, hOfsub (pts j) hx.2⟩

theorem ejp_level_regularity (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) : (∀ y ∈ U, 0 < ejpS G Φ y) ∧ ContDiffOn ℝ ∞ (ejpS G Φ) U ∧ ContDiffOn ℝ ∞ (ejpPsi G Φ) U ∧ ContDiffOn ℝ ∞ (ejpPot G Φ) U :=
by
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hpos y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  
  have hSpos : ∀ y ∈ U, 0 < ∑ i : Fin 3, ∑ j : Fin 3,
      (G y)⁻¹ i j * partialDeriv i Φ y * partialDeriv j Φ y := by
    intro y hy
    have hx0 : (fun k : Fin 3 => partialDeriv k Φ y) ≠ 0 := by
      intro h0
      apply hdΦ y hy
      have hlin : (fderiv ℝ Φ y : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
          have := congrFun h0 i
          simpa [partialDeriv] using this)
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := LinearMap.congr_fun hlin v
      simpa using this
    have hpd' := (hpos y hy).inv.dotProduct_mulVec_pos hx0
    refine lt_of_lt_of_eq hpd' ?_
    simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  have hSpos' : ∀ y ∈ U, 0 < ejpS G Φ y := hSpos
  have hSne : ∀ y ∈ U, (∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y) ≠ 0 :=
    fun y hy => (hSpos y hy).ne'
  have hSne' : ∀ y ∈ U, ejpS G Φ y ≠ 0 := fun y hy => (hSpos' y hy).ne'
  
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hp : ∀ k : Fin 3, ContDiffOn ℝ ∞ (partialDeriv k Φ) U := hpdv Φ hΦ
  have hpp : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i (partialDeriv j Φ)) U :=
    fun i j => hpdv _ (hp j) i
  
  have hS : ContDiffOn ℝ ∞ (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ((hGi i j).mul (hp i)).mul (hp j)
  have hS' : ContDiffOn ℝ ∞ (ejpS G Φ) U := hS.congr (fun y _ => rfl)
  
  have hPsi : ContDiffOn ℝ ∞ (ejpPsi G Φ) U :=
    ((hS'.sqrt hSne').inv (fun y hy => Real.sqrt_ne_zero'.2 (hSpos' y hy))).congr
      (fun y _ => rfl)
  
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  have hdΓ : ∀ m k i j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (christoffel G k i j)) U :=
    fun m k i j => hpdv _ (hΓ k i j) m
  have hH : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G Φ i j) U := by
    intro i j
    unfold hessLoc
    exact (hpp i j).sub (ContDiffOn.sum fun k _ => (hΓ k i j).mul (hp k))
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) U := by
    intro j k
    have h : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3,
        (partialDeriv i (christoffel G i j k) y - partialDeriv j (christoffel G i i k) y)
        + ∑ i : Fin 3, ∑ p : Fin 3,
          (christoffel G i i p y * christoffel G p j k y
            - christoffel G i j p y * christoffel G p i k y)) U :=
      (ContDiffOn.sum fun i _ => (hdΓ i i j k).sub (hdΓ j i i k)).add
        (ContDiffOn.sum fun i _ => ContDiffOn.sum fun p _ =>
          ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k)))
    exact h.congr (fun y _ => rfl)
  have hN : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun y => ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv b Φ y) U :=
    fun a => ContDiffOn.sum fun b _ => (hGi a b).mul (hp b)
  have hNe : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun y => ejpN G Φ y a) U :=
    fun a => (hN a).congr (fun y _ => rfl)
  
  have hQ : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j -
      (∑ a : Fin 3, (G y)⁻¹ i a * partialDeriv a Φ y) *
        (∑ b : Fin 3, (G y)⁻¹ j b * partialDeriv b Φ y) /
        (∑ a : Fin 3, ∑ b : Fin 3,
          (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y)) U := by
    intro i j
    exact ((hGi i j).sub (((hN i).mul (hN j)).div hS hSne)).congr (fun y _ => rfl)
  have hNum : ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
      ((G y)⁻¹ i j - (∑ a : Fin 3, (G y)⁻¹ i a * partialDeriv a Φ y) *
          (∑ b : Fin 3, (G y)⁻¹ j b * partialDeriv b Φ y) /
          (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y)) *
        hessLoc G Φ j k y *
        ((G y)⁻¹ k l - (∑ a : Fin 3, (G y)⁻¹ k a * partialDeriv a Φ y) *
          (∑ b : Fin 3, (G y)⁻¹ l b * partialDeriv b Φ y) /
          (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * partialDeriv a Φ y * partialDeriv b Φ y)) *
        hessLoc G Φ l i y) U :=
    ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ =>
      ContDiffOn.sum fun l _ => (((hQ i j).mul (hH j k)).mul (hQ k l)).mul (hH l i)
  have hSF : ContDiffOn ℝ ∞ (secondFundSq G Φ) U :=
    (hNum.div hS hSne).congr (fun y _ => rfl)
  
  have hNumR : ContDiffOn ℝ ∞ (fun y => ∑ j : Fin 3, ∑ k : Fin 3,
      ricci G j k y * ejpN G Φ y j * ejpN G Φ y k) U :=
    ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ => ((hRic j k).mul (hNe j)).mul (hNe k)
  have hRT : ContDiffOn ℝ ∞ (ejpRic G Φ) U :=
    (hNumR.div hS' hSne').congr (fun y _ => rfl)
  
  have hPot : ContDiffOn ℝ ∞ (ejpPot G Φ) U := (hSF.add hRT).congr (fun y _ => rfl)
  exact ⟨hSpos', hS', hPsi, hPot⟩

theorem ejp_coord_smooth (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) : (∀ (w : E3 → ℝ), ContDiffOn ℝ ∞ w U → ∀ i : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i w) U) ∧ (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U) ∧ (∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) ∧ (∀ a b : Fin 3, ContDiffOn ℝ ∞ (hessLoc G Φ a b) U) ∧ (∀ d : Fin 3, ContDiffOn ℝ ∞ (fun y => ejpN G Φ y d) U) :=
by
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hpos y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  have hdG : ∀ m a b : Fin 3, ContDiffOn ℝ ∞ (partialDeriv m (fun z => G z a b)) U :=
    fun m a b => hpdv _ (hG a b) m
  have hp : ∀ k : Fin 3, ContDiffOn ℝ ∞ (partialDeriv k Φ) U := hpdv Φ hΦ
  have hpp : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv i (partialDeriv j Φ)) U :=
    fun i j => hpdv _ (hp j) i
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
      (hGi k l).mul (((hdG i j l).add (hdG j i l)).sub (hdG l i j)))
  have hH : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G Φ i j) U := by
    intro i j
    unfold hessLoc
    exact (hpp i j).sub (ContDiffOn.sum fun k _ => (hΓ k i j).mul (hp k))
  have hN : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun y => ∑ b : Fin 3,
      (G y)⁻¹ a b * partialDeriv b Φ y) U :=
    fun a => ContDiffOn.sum fun b _ => (hGi a b).mul (hp b)
  have hNe : ∀ a : Fin 3, ContDiffOn ℝ ∞ (fun y => ejpN G Φ y a) U :=
    fun a => (hN a).congr (fun y _ => rfl)
  exact ⟨hpdv, hGi, hΓ, hH, hNe⟩

theorem ejp_sym_facts (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hΦ : ContDiffOn ℝ ∞ Φ U) (y : E3) (hy : y ∈ U) : (∀ i j : Fin 3, (G y)⁻¹ i j = (G y)⁻¹ j i) ∧ (∀ k i j : Fin 3, christoffel G k i j y = christoffel G k j i y) ∧ (∀ a b : Fin 3, hessLoc G Φ a b y = hessLoc G Φ b a y) ∧ (∀ a b c : Fin 3, ejpHess3 G Φ y a b c = ejpHess3 G Φ y b a c) :=
by
  
  have hA : ∀ i j : Fin 3, (G y)⁻¹ i j = (G y)⁻¹ j i := by
    have hT : Matrix.transpose (G y) = G y := Matrix.ext fun i j => hsymm y j i
    have h1 : Matrix.transpose ((G y)⁻¹) = (G y)⁻¹ := by rw [Matrix.transpose_nonsing_inv, hT]
    intro i j
    have h2 := congrFun (congrFun h1 j) i
    rw [Matrix.transpose_apply] at h2
    exact h2
  
  have hB : ∀ (z : E3) (k i j : Fin 3), christoffel G k i j z = christoffel G k j i z := by
    intro z k i j
    have hf : (fun w => G w j i) = (fun w => G w i j) := funext fun w => hsymm w j i
    unfold christoffel
    rw [hf]
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  
  have hS : ∀ z ∈ U, ∀ a b : Fin 3,
      partialDeriv a (partialDeriv b Φ) z = partialDeriv b (partialDeriv a Φ) z := by
    intro z hz
    have hc : ContDiffAt ℝ ∞ Φ z := hΦ.contDiffAt (hU.mem_nhds hz)
    have h2' : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
    have h2 : minSmoothness ℝ 2 ≤ ∞ := by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact h2'
    have hsym : IsSymmSndFDerivAt ℝ Φ z := hc.isSymmSndFDerivAt h2
    have h12 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
      rw [one_add_one_eq_two]
      exact h2'
    have hd : DifferentiableAt ℝ (fderiv ℝ Φ) z :=
      (hc.fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have key : ∀ a b : Fin 3,
        partialDeriv a (partialDeriv b Φ) z = fderiv ℝ (fderiv ℝ Φ) z (e a) (e b) := by
      intro a b
      have hpd : partialDeriv b Φ = fun w => (fderiv ℝ Φ w) ((fun _ : E3 => e b) w) := rfl
      have h3 := fderiv_clm_apply (c := fderiv ℝ Φ) (u := fun _ : E3 => e b) hd
        (differentiableAt_const (e b))
      unfold partialDeriv at hpd ⊢
      rw [hpd, h3]
      simp
    intro a b
    rw [key a b, key b a]
    exact hsym.eq (e a) (e b)
  
  have hC : ∀ z ∈ U, ∀ a b : Fin 3, hessLoc G Φ a b z = hessLoc G Φ b a z := by
    intro z hz a b
    simp only [hessLoc]
    rw [hS z hz a b]
    congr 1
    exact Finset.sum_congr rfl fun k _ => by rw [hB z k a b]
  refine ⟨hA, fun k i j => hB y k i j, fun a b => hC y hy a b, ?_⟩
  
  intro a b c
  have hev : hessLoc G Φ a b =ᶠ[𝓝 y] hessLoc G Φ b a :=
    Filter.eventually_of_mem (hU.mem_nhds hy) (fun z hz => hC z hz a b)
  have hpd : partialDeriv c (hessLoc G Φ a b) y = partialDeriv c (hessLoc G Φ b a) y := by
    unfold partialDeriv
    rw [hev.fderiv_eq]
  have h1 : ∑ k : Fin 3, christoffel G k c a y * hessLoc G Φ k b y =
      ∑ k : Fin 3, christoffel G k c a y * hessLoc G Φ b k y :=
    Finset.sum_congr rfl (fun k _ => by rw [hC y hy k b])
  have h2 : ∑ k : Fin 3, christoffel G k c b y * hessLoc G Φ a k y =
      ∑ k : Fin 3, christoffel G k c b y * hessLoc G Φ k a y :=
    Finset.sum_congr rfl (fun k _ => by rw [hC y hy a k])
  simp only [ejpHess3]
  rw [hpd, h1, h2]
  ring

theorem ejp_first_derivs (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (y : E3) (hy : y ∈ U) : (∀ a c : Fin 3, partialDeriv a (fun z => ejpN G Φ z c) y = ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y - ∑ e : Fin 3, christoffel G c a e y * ejpN G Φ y e) ∧ (∀ a : Fin 3, partialDeriv a (ejpS G Φ) y = 2 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) ∧ (∀ a : Fin 3, partialDeriv a (ejpPsi G Φ) y = -(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) :=
by
  have hUy : U ∈ 𝓝 y := hU.mem_nhds hy
  
  have hpdv : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i f) U := by
    intro f hf i
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hf).2
    exact hD.clm_apply contDiffOn_const
  
  have hdet3 : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) U := by
    intro H hH
    have hfun : (fun y => (H y).det) = fun y =>
        H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
      funext y
      exact Matrix.det_fin_three (H y)
    rw [hfun]
    have t1 := ((hH 0 0).mul (hH 1 1)).mul (hH 2 2)
    have t2 := ((hH 0 0).mul (hH 1 2)).mul (hH 2 1)
    have t3 := ((hH 0 1).mul (hH 1 0)).mul (hH 2 2)
    have t4 := ((hH 0 1).mul (hH 1 2)).mul (hH 2 0)
    have t5 := ((hH 0 2).mul (hH 1 0)).mul (hH 2 1)
    have t6 := ((hH 0 2).mul (hH 1 1)).mul (hH 2 0)
    exact ((((t1.sub t2).sub t3).add t4).add t5).sub t6
  
  have hdetU : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hpos y hy).det_pos.ne'
  have hGi : ∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ k l) U := by
    intro k l
    have h1 : ContDiffOn ℝ ∞ (fun y => (G y).det) U := hdet3 G hG
    have h2 : ContDiffOn ℝ ∞ (fun y => ((G y).updateRow l (Pi.single k 1)).det) U := by
      apply hdet3
      intro a b
      by_cases hab : a = l
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hG a b
    refine ((h1.inv hdetU).mul h2).congr ?_
    intro y _
    rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
      smul_eq_mul]
  
  have hs0 : 0 < ejpS G Φ y := by
    have hx0 : (fun k : Fin 3 => partialDeriv k Φ y) ≠ 0 := by
      intro h0
      apply hdΦ y hy
      have hlin : (fderiv ℝ Φ y : E3 →ₗ[ℝ] ℝ) = 0 :=
        (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => by
          have := congrFun h0 i
          simpa [partialDeriv] using this)
      refine ContinuousLinearMap.ext (fun v => ?_)
      have := LinearMap.congr_fun hlin v
      simpa using this
    have hpd' := (hpos y hy).inv.dotProduct_mulVec_pos hx0
    refine lt_of_lt_of_eq hpd' ?_
    simp only [ejpS, star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  
  have hp : ∀ k : Fin 3, ContDiffOn ℝ ∞ (partialDeriv k Φ) U := hpdv Φ hΦ
  have hS' : ContDiffOn ℝ ∞ (ejpS G Φ) U :=
    (ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ =>
      ((hGi i j).mul (hp i)).mul (hp j)).congr (fun z _ => rfl)
  have hN : ∀ d : Fin 3, ContDiffOn ℝ ∞ (fun z => ejpN G Φ z d) U :=
    fun d => (ContDiffOn.sum fun b _ => (hGi d b).mul (hp b)).congr (fun z _ => rfl)
  have hdiff : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f U → DifferentiableAt ℝ f y :=
    fun f hf => (hf.differentiableOn (by simp)).differentiableAt hUy
  have hAd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => G z i j) y :=
    fun i j => hdiff _ (hG i j)
  have hBd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ i j) y :=
    fun i j => hdiff _ (hGi i j)
  have hφd : ∀ b : Fin 3, DifferentiableAt ℝ (partialDeriv b Φ) y := fun b => hdiff _ (hp b)
  have hNd : ∀ d : Fin 3, DifferentiableAt ℝ (fun z => ejpN G Φ z d) y :=
    fun d => hdiff _ (hN d)
  have hSd : DifferentiableAt ℝ (ejpS G Φ) y := hdiff _ hS'
  
  have hR1 : ∀ (f g : Fin 3 → E3 → ℝ) (a : Fin 3), (∀ b, DifferentiableAt ℝ (f b) y) →
      (∀ b, DifferentiableAt ℝ (g b) y) →
      partialDeriv a (fun z => ∑ b : Fin 3, f b z * g b z) y =
        ∑ b : Fin 3, (partialDeriv a (f b) y * g b y + f b y * partialDeriv a (g b) y) := by
    intro f g a hf hg
    unfold partialDeriv
    have hsum := fderiv_fun_sum (u := Finset.univ) (A := fun b z => f b z * g b z) (x := y)
      (fun b _ => ((hf b).mul (hg b) : DifferentiableAt ℝ (fun z => f b z * g b z) y))
    beta_reduce at hsum
    rw [hsum, ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    rw [fderiv_fun_mul (hf b) (hg b)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hinvsym : ∀ i j : Fin 3, (G y)⁻¹ i j = (G y)⁻¹ j i := by
    intro i j
    have hT : Matrix.transpose (G y) = G y := Matrix.ext (fun i j => hsymm y j i)
    have h := Matrix.transpose_nonsing_inv (G y)
    rw [hT] at h
    have h' := congrFun (congrFun h j) i
    rw [Matrix.transpose_apply] at h'
    exact h'
  have hdAsym : ∀ m i j : Fin 3, partialDeriv m (fun z => G z i j) y =
      partialDeriv m (fun z => G z j i) y := by
    intro m i j
    have hf : (fun z => G z i j) = (fun z => G z j i) := funext fun z => hsymm z i j
    rw [hf]
  
  have hE : ∀ m k l : Fin 3, ∑ c : Fin 3, (partialDeriv m (fun z => (G z)⁻¹ k c) y * G y c l
      + (G y)⁻¹ k c * partialDeriv m (fun z => G z c l) y) = 0 := by
    intro m k l
    have h1 := hR1 (fun c z => (G z)⁻¹ k c) (fun c z => G z c l) m (fun c => hBd k c)
      (fun c => hAd c l)
    beta_reduce at h1
    have hev : (fun z => ∑ c : Fin 3, (G z)⁻¹ k c * G z c l) =ᶠ[𝓝 y]
        fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ) k l := by
      filter_upwards [hUy] with z hz
      rw [← Matrix.mul_apply, Matrix.nonsing_inv_mul _ ((isUnit_iff_ne_zero).2 (hdetU z hz))]
    have h0 : partialDeriv m (fun z => ∑ c : Fin 3, (G z)⁻¹ k c * G z c l) y = 0 := by
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    rw [h1] at h0
    exact h0
  
  have hinvd : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ k a * partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l := by
    intro m k l
    obtain ⟨D, hD⟩ : ∃ D : Matrix (Fin 3) (Fin 3) ℝ,
        D = Matrix.of fun k l => partialDeriv m (fun z => (G z)⁻¹ k l) y := ⟨_, rfl⟩
    obtain ⟨dA, hdA⟩ : ∃ dA : Matrix (Fin 3) (Fin 3) ℝ,
        dA = Matrix.of fun i j => partialDeriv m (fun z => G z i j) y := ⟨_, rfl⟩
    have hM : D * G y + (G y)⁻¹ * dA = 0 := by
      ext k' l'
      simp only [Matrix.add_apply, Matrix.mul_apply, hD, hdA, Matrix.of_apply,
        Matrix.zero_apply]
      rw [← Finset.sum_add_distrib]
      exact hE m k' l'
    have hAB : G y * (G y)⁻¹ = 1 :=
      Matrix.mul_nonsing_inv _ ((isUnit_iff_ne_zero).2 (hdetU y hy))
    have hDe : D = -((G y)⁻¹ * dA * (G y)⁻¹) := by
      calc D = D * (G y * (G y)⁻¹) := by rw [hAB, Matrix.mul_one]
        _ = (D * G y) * (G y)⁻¹ := by rw [Matrix.mul_assoc]
        _ = (-((G y)⁻¹ * dA)) * (G y)⁻¹ := by rw [eq_neg_of_add_eq_zero_left hM]
        _ = -((G y)⁻¹ * dA * (G y)⁻¹) := by rw [Matrix.neg_mul]
    have h' := congrFun (congrFun hDe k) l
    simp only [hD, hdA, Matrix.neg_apply, Matrix.mul_apply, Matrix.of_apply] at h'
    rw [h']
    simp only [Fin.sum_univ_three]
    ring
  
  have hcomp : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, (christoffel G k m a y * (G y)⁻¹ a l
        + christoffel G l m a y * (G y)⁻¹ k a) := by
    intro m k l
    rw [hinvd m k l]
    simp only [christoffel, Fin.sum_univ_three]
    simp only [hinvsym l 0, hinvsym l 1, hinvsym l 2, hdAsym m 1 0, hdAsym m 2 0,
      hdAsym m 2 1]
    ring
  
  have hi : ∀ a c : Fin 3, partialDeriv a (fun z => ejpN G Φ z c) y =
      ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y
        - ∑ e : Fin 3, christoffel G c a e y * ejpN G Φ y e := by
    intro a c
    have h1 := hR1 (fun b z => (G z)⁻¹ c b) (fun b => partialDeriv b Φ) a (fun b => hBd c b) hφd
    beta_reduce at h1
    have hNfun : (fun z => ejpN G Φ z c) =
        fun z => ∑ b : Fin 3, (G z)⁻¹ c b * partialDeriv b Φ z := rfl
    rw [hNfun, h1]
    simp only [hcomp]
    simp only [hessLoc, ejpN, Fin.sum_univ_three]
    ring
  
  have hSfun : ejpS G Φ = fun z => ∑ i : Fin 3, partialDeriv i Φ z * ejpN G Φ z i := by
    funext z
    simp only [ejpS, ejpN, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  have hii : ∀ a : Fin 3, partialDeriv a (ejpS G Φ) y =
      2 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y := by
    intro a
    have h1 := hR1 (fun i => partialDeriv i Φ) (fun i z => ejpN G Φ z i) a hφd hNd
    beta_reduce at h1
    rw [hSfun, h1]
    simp only [hi]
    simp only [hessLoc, ejpN, Fin.sum_univ_three]
    simp only [hinvsym 1 0, hinvsym 2 0, hinvsym 2 1]
    ring
  
  have hiii : ∀ a : Fin 3, partialDeriv a (ejpPsi G Φ) y =
      -(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y := by
    intro a
    have hr : 0 < Real.sqrt (ejpS G Φ y) := Real.sqrt_pos.2 hs0
    have hd1 : HasDerivAt (fun x => (Real.sqrt x)⁻¹)
        (-(1 / (2 * Real.sqrt (ejpS G Φ y))) / Real.sqrt (ejpS G Φ y) ^ 2) (ejpS G Φ y) :=
      (Real.hasDerivAt_sqrt hs0.ne').fun_inv hr.ne'
    have hd2 := hd1.comp_hasFDerivAt y hSd.hasFDerivAt
    have hpsi : ejpPsi G Φ = (fun x => (Real.sqrt x)⁻¹) ∘ ejpS G Φ := rfl
    have h3 : partialDeriv a (ejpPsi G Φ) y =
        (-(1 / (2 * Real.sqrt (ejpS G Φ y))) / Real.sqrt (ejpS G Φ y) ^ 2) *
          partialDeriv a (ejpS G Φ) y := by
      unfold partialDeriv
      rw [hpsi, hd2.fderiv]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [h3, hii a]
    simp only [ejpPsi]
    ring
  exact ⟨hi, hii, hiii⟩

theorem ejp_hess_psi (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (y : E3) (hy : y ∈ U) (a b : Fin 3) : hessLoc G (ejpPsi G Φ) a b y = 3 * ejpPsi G Φ y ^ 5 * (∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) * (∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ b c y) - ejpPsi G Φ y ^ 3 * ((∑ c : Fin 3, ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y * hessLoc G Φ b c y) + ∑ c : Fin 3, ejpN G Φ y c * ejpHess3 G Φ y b c a) :=
by
  have h1 := ejp_first_derivs G Φ U hU hG hsymm hpos hΦ hdΦ y hy
  have hreg := ejp_level_regularity G Φ U hU hG hpos hΦ hdΦ
  have hsm := ejp_coord_smooth G Φ U hU hG hpos hΦ
  have hUy : U ∈ 𝓝 y := hU.mem_nhds hy
  have hψd : DifferentiableAt ℝ (ejpPsi G Φ) y :=
    (hreg.2.2.1.contDiffAt hUy).differentiableAt (by simp)
  have hNd : ∀ c : Fin 3, DifferentiableAt ℝ (fun z => ejpN G Φ z c) y :=
    fun c => ((hsm.2.2.2.2 c).contDiffAt hUy).differentiableAt (by simp)
  have hHd : ∀ c : Fin 3, DifferentiableAt ℝ (hessLoc G Φ b c) y :=
    fun c => ((hsm.2.2.2.1 b c).contDiffAt hUy).differentiableAt (by simp)
  have hev : partialDeriv b (ejpPsi G Φ) =ᶠ[𝓝 y]
      (fun z => -(ejpPsi G Φ z) ^ 3 * ∑ c : Fin 3, ejpN G Φ z c * hessLoc G Φ b c z) :=
    Filter.eventually_of_mem hUy
      (fun z hz => (ejp_first_derivs G Φ U hU hG hsymm hpos hΦ hdΦ z hz).2.2 b)
  have hfun : (fun z => -(ejpPsi G Φ z) ^ 3 * ∑ c : Fin 3, ejpN G Φ z c * hessLoc G Φ b c z) =
      (fun z => -(ejpPsi G Φ z * ejpPsi G Φ z * ejpPsi G Φ z) *
        (ejpN G Φ z 0 * hessLoc G Φ b 0 z + ejpN G Φ z 1 * hessLoc G Φ b 1 z
          + ejpN G Φ z 2 * hessLoc G Φ b 2 z)) := by
    funext z
    simp only [Fin.sum_univ_three]
    ring
  have hfull := ((hψd.hasFDerivAt.fun_mul hψd.hasFDerivAt).fun_mul hψd.hasFDerivAt).fun_neg.fun_mul
    ((((hNd 0).hasFDerivAt.fun_mul (hHd 0).hasFDerivAt).fun_add
      ((hNd 1).hasFDerivAt.fun_mul (hHd 1).hasFDerivAt)).fun_add
      ((hNd 2).hasFDerivAt.fun_mul (hHd 2).hasFDerivAt))
  have hd2 : partialDeriv a (partialDeriv b (ejpPsi G Φ)) y =
      fderiv ℝ (fun z => -(ejpPsi G Φ z * ejpPsi G Φ z * ejpPsi G Φ z) *
        (ejpN G Φ z 0 * hessLoc G Φ b 0 z + ejpN G Φ z 1 * hessLoc G Φ b 1 z
          + ejpN G Φ z 2 * hessLoc G Φ b 2 z)) y (e a) := by
    show fderiv ℝ (partialDeriv b (ejpPsi G Φ)) y (e a) = _
    rw [hev.fderiv_eq, hfun]
  have hψ' : ∀ k : Fin 3, fderiv ℝ (ejpPsi G Φ) y (e k) =
      -(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ k c y := fun k => h1.2.2 k
  have hN' : ∀ c : Fin 3, fderiv ℝ (fun z => ejpN G Φ z c) y (e a) =
      ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y
        - ∑ e : Fin 3, christoffel G c a e y * ejpN G Φ y e := fun c => h1.1 a c
  have hT' : ∀ c : Fin 3, fderiv ℝ (hessLoc G Φ b c) y (e a) = ejpHess3 G Φ y b c a
      + ∑ k : Fin 3, christoffel G k a b y * hessLoc G Φ k c y
      + ∑ k : Fin 3, christoffel G k a c y * hessLoc G Φ b k y := by
    intro c
    show partialDeriv a (hessLoc G Φ b c) y = _
    simp only [ejpHess3]
    ring
  have hdef : hessLoc G (ejpPsi G Φ) a b y = partialDeriv a (partialDeriv b (ejpPsi G Φ)) y
      - ∑ k : Fin 3, christoffel G k a b y * partialDeriv k (ejpPsi G Φ) y := rfl
  rw [hdef, hd2, hfull.fderiv]
  simp only [h1.2.2, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.neg_apply, smul_eq_mul, hψ', hN', hT']
  simp only [Fin.sum_univ_three]
  ring

theorem ejp_lmc_deriv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (y : E3) (hy : y ∈ U) (a : Fin 3) : partialDeriv a (levelMeanCurvCoord G Φ) y = (-(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * hessLoc G Φ i j y) + ejpPsi G Φ y * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * ejpHess3 G Φ y i j a) - 3 * ejpPsi G Φ y ^ 2 * (-(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) * (∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ y i * ejpN G Φ y j * hessLoc G Φ i j y) - ejpPsi G Φ y ^ 3 * ((∑ i : Fin 3, ∑ j : Fin 3, (∑ e : Fin 3, (G y)⁻¹ i e * hessLoc G Φ a e y) * ejpN G Φ y j * hessLoc G Φ i j y) + (∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ y i * (∑ e : Fin 3, (G y)⁻¹ j e * hessLoc G Φ a e y) * hessLoc G Φ i j y) + ∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ y i * ejpN G Φ y j * ejpHess3 G Φ y i j a) :=
by
  have hinf : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hD : ∀ w : E3 → ℝ, ContDiffOn ℝ ∞ w U → DifferentiableAt ℝ w y :=
    fun w hw => (hw.contDiffAt (hU.mem_nhds hy)).differentiableAt hinf
  obtain ⟨hpd, hinvs, -, hhess, hNs⟩ := ejp_coord_smooth G Φ U hU hG hpos hΦ
  obtain ⟨hSpos, hSs, hψs, -⟩ := ejp_level_regularity G Φ U hU hG hpos hΦ hdΦ
  obtain ⟨hgis, -, -, -⟩ := ejp_sym_facts G Φ U hU hsymm hΦ y hy
  have dGi : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ i j) y :=
    fun i j => hD _ (hinvs i j)
  have dG : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => G z i j) y := fun i j => hD _ (hG i j)
  have dH : ∀ i j : Fin 3, DifferentiableAt ℝ (hessLoc G Φ i j) y := fun i j => hD _ (hhess i j)
  have dN : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => ejpN G Φ z i) y := fun i => hD _ (hNs i)
  have d1 : ∀ i : Fin 3, DifferentiableAt ℝ (partialDeriv i Φ) y := fun i => hD _ (hpd Φ hΦ i)
  
  have pm : ∀ f g : E3 → ℝ, DifferentiableAt ℝ f y → DifferentiableAt ℝ g y →
      partialDeriv a (fun z => f z * g z) y =
        partialDeriv a f y * g y + f y * partialDeriv a g y := by
    intro f g hf hg
    unfold partialDeriv
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have ps : ∀ F : Fin 3 → E3 → ℝ, (∀ i, DifferentiableAt ℝ (F i) y) →
      partialDeriv a (fun z => ∑ i, F i z) y = ∑ i, partialDeriv a (F i) y := by
    intro F hF
    unfold partialDeriv
    rw [fderiv_fun_sum (fun i _ => hF i)]
    simp only [ContinuousLinearMap.sum_apply]
  have pS1 : ∀ f g : Fin 3 → E3 → ℝ, (∀ i, DifferentiableAt ℝ (f i) y) →
      (∀ i, DifferentiableAt ℝ (g i) y) →
      partialDeriv a (fun z => ∑ i, f i z * g i z) y =
        ∑ i, (partialDeriv a (f i) y * g i y + f i y * partialDeriv a (g i) y) := by
    intro f g hf hg
    rw [ps (fun i z => f i z * g i z) (fun i => (hf i).fun_mul (hg i))]
    exact Finset.sum_congr rfl (fun i _ => pm _ _ (hf i) (hg i))
  have pS2 : ∀ f g : Fin 3 → Fin 3 → E3 → ℝ, (∀ i j, DifferentiableAt ℝ (f i j) y) →
      (∀ i j, DifferentiableAt ℝ (g i j) y) →
      partialDeriv a (fun z => ∑ i, ∑ j, f i j z * g i j z) y =
        ∑ i, ∑ j, (partialDeriv a (f i j) y * g i j y + f i j y * partialDeriv a (g i j) y) := by
    intro f g hf hg
    rw [ps (fun i z => ∑ j, f i j z * g i j z)
      (fun i => DifferentiableAt.fun_sum (fun j _ => (hf i j).fun_mul (hg i j)))]
    exact Finset.sum_congr rfl (fun i _ => pS1 (f i) (g i) (hf i) (hg i))
  have pS3 : ∀ f g h : Fin 3 → Fin 3 → E3 → ℝ, (∀ i j, DifferentiableAt ℝ (f i j) y) →
      (∀ i j, DifferentiableAt ℝ (g i j) y) → (∀ i j, DifferentiableAt ℝ (h i j) y) →
      partialDeriv a (fun z => ∑ i, ∑ j, f i j z * g i j z * h i j z) y =
        ∑ i, ∑ j, (partialDeriv a (f i j) y * g i j y * h i j y
          + f i j y * partialDeriv a (g i j) y * h i j y
          + f i j y * g i j y * partialDeriv a (h i j) y) := by
    intro f g h hf hg hh
    rw [pS2 (fun i j z => f i j z * g i j z) h (fun i j => (hf i j).fun_mul (hg i j)) hh]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    beta_reduce
    rw [pm _ _ (hf i j) (hg i j)]
    ring
  
  have hdet : ∀ z ∈ U, (G z).det ≠ 0 := fun z hz => (hpos z hz).det_pos.ne'
  have hE : ∀ p l : Fin 3, ∑ b, G y p b * partialDeriv a (fun z => (G z)⁻¹ b l) y
      + ∑ b, partialDeriv a (fun z => G z p b) y * (G y)⁻¹ b l = 0 := by
    intro p l
    have h1 := pS1 (fun b z => G z p b) (fun b z => (G z)⁻¹ b l) (fun b => dG p b)
      (fun b => dGi b l)
    have h2 : partialDeriv a (fun z => ∑ b, G z p b * (G z)⁻¹ b l) y = 0 := by
      have hev : (fun z => ∑ b, G z p b * (G z)⁻¹ b l) =ᶠ[𝓝 y]
          fun _ => if p = l then (1 : ℝ) else 0 := by
        filter_upwards [hU.mem_nhds hy] with z hz
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G z)
          (isUnit_iff_ne_zero.mpr (hdet z hz))) p) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    beta_reduce at h1
    rw [h1, Finset.sum_add_distrib] at h2
    linarith
  have hinvD : ∀ k l : Fin 3, partialDeriv a (fun z => (G z)⁻¹ k l) y =
      -∑ p : Fin 3, ∑ q : Fin 3,
        (G y)⁻¹ k p * partialDeriv a (fun z => G z p q) y * (G y)⁻¹ q l := by
    let X : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv a (fun z => (G z)⁻¹ b l) y
    let D : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun p b => partialDeriv a (fun z => G z p b) y
    have hM : G y * X = -(D * (G y)⁻¹) := by
      ext p l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, D, Matrix.of_apply]
      exact hE p l'
    have hX : X = -((G y)⁻¹ * (D * (G y)⁻¹)) := by
      calc X = ((G y)⁻¹ * G y) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr (hdet y hy)), Matrix.one_mul]
        _ = (G y)⁻¹ * (G y * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    intro k l
    have hkl := congrFun (congrFun hX k) l
    simp only [X, D, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro p _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro q _
    ring
  
  have hdGs : ∀ c p q : Fin 3, partialDeriv c (fun z => G z p q) y =
      partialDeriv c (fun z => G z q p) y := by
    intro c p q
    have : (fun z => G z p q) = (fun z => G z q p) := funext fun z => hsymm z p q
    rw [this]
  have s10 : ∀ c, partialDeriv c (fun z => G z 1 0) y = partialDeriv c (fun z => G z 0 1) y :=
    fun c => hdGs c 1 0
  have s20 : ∀ c, partialDeriv c (fun z => G z 2 0) y = partialDeriv c (fun z => G z 0 2) y :=
    fun c => hdGs c 2 0
  have s21 : ∀ c, partialDeriv c (fun z => G z 2 1) y = partialDeriv c (fun z => G z 1 2) y :=
    fun c => hdGs c 2 1
  have compat : ∀ k l : Fin 3, partialDeriv a (fun z => (G z)⁻¹ k l) y =
      -∑ e : Fin 3, (christoffel G k a e y * (G y)⁻¹ e l
        + christoffel G l a e y * (G y)⁻¹ k e) := by
    intro k l
    rw [hinvD k l]
    simp only [christoffel, Fin.sum_univ_three, hgis l 0, hgis l 1, hgis l 2, s10, s20, s21]
    ring
  
  have hdN : ∀ c : Fin 3, partialDeriv a (fun z => ejpN G Φ z c) y =
      ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y
        - ∑ e : Fin 3, christoffel G c a e y * ejpN G Φ y e := by
    intro c
    have h1 := pS1 (fun b z => (G z)⁻¹ c b) (fun b => partialDeriv b Φ) (fun b => dGi c b) d1
    beta_reduce at h1
    simp only [ejpN]
    rw [h1]
    simp only [compat, hessLoc, Fin.sum_univ_three]
    ring
  
  have hdS : partialDeriv a (ejpS G Φ) y =
      2 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y := by
    have h1 := pS3 (fun i j z => (G z)⁻¹ i j) (fun i j => partialDeriv i Φ)
      (fun i j => partialDeriv j Φ) (fun i j => dGi i j) (fun i j => d1 i) (fun i j => d1 j)
    beta_reduce at h1
    have e1 : ejpS G Φ = fun z => ∑ i : Fin 3, ∑ j : Fin 3,
        (G z)⁻¹ i j * partialDeriv i Φ z * partialDeriv j Φ z := rfl
    rw [e1, h1]
    simp only [compat, ejpN, hessLoc, Fin.sum_univ_three, hgis 1 0, hgis 2 0, hgis 2 1]
    ring
  
  have hdψ : partialDeriv a (ejpPsi G Φ) y =
      -(ejpPsi G Φ y) ^ 3 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y := by
    have hS0 : ejpS G Φ y ≠ 0 := (hSpos y hy).ne'
    have hr0 : Real.sqrt (ejpS G Φ y) ≠ 0 := (Real.sqrt_pos.mpr (hSpos y hy)).ne'
    have hSd : HasFDerivAt (ejpS G Φ) (fderiv ℝ (ejpS G Φ) y) y := (hD _ hSs).hasFDerivAt
    have hsq := hSd.sqrt hS0
    have hinv := (hasDerivAt_inv hr0).comp_hasFDerivAt y hsq
    have key : fderiv ℝ (ejpPsi G Φ) y = (-(Real.sqrt (ejpS G Φ y) ^ 2)⁻¹) •
        ((1 / (2 * Real.sqrt (ejpS G Φ y))) • fderiv ℝ (ejpS G Φ) y) := hinv.fderiv
    have h2 : fderiv ℝ (ejpS G Φ) y (e a) =
        2 * ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y := hdS
    show fderiv ℝ (ejpPsi G Φ) y (e a) = _
    rw [key]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [h2]
    simp only [ejpPsi]
    field_simp
  
  have hdL : partialDeriv a (lapLoc G Φ) y =
      ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * ejpHess3 G Φ y i j a := by
    have h1 := pS2 (fun i j z => (G z)⁻¹ i j) (fun i j => hessLoc G Φ i j) dGi dH
    beta_reduce at h1
    have e1 : lapLoc G Φ = fun z => ∑ i : Fin 3, ∑ j : Fin 3,
        (G z)⁻¹ i j * hessLoc G Φ i j z := rfl
    rw [e1, h1]
    simp only [compat, ejpHess3, Fin.sum_univ_three]
    ring
  
  have hdQ : partialDeriv a (fun z => ∑ i : Fin 3, ∑ j : Fin 3,
      ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z) y =
      (∑ i : Fin 3, ∑ j : Fin 3, (∑ e : Fin 3, (G y)⁻¹ i e * hessLoc G Φ a e y) *
        ejpN G Φ y j * hessLoc G Φ i j y) +
      (∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ y i *
        (∑ e : Fin 3, (G y)⁻¹ j e * hessLoc G Φ a e y) * hessLoc G Φ i j y) +
      ∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ y i * ejpN G Φ y j * ejpHess3 G Φ y i j a := by
    have h1 := pS3 (fun i j z => ejpN G Φ z i) (fun i j z => ejpN G Φ z j)
      (fun i j => hessLoc G Φ i j) (fun i j => dN i) (fun i j => dN j) dH
    beta_reduce at h1
    rw [h1]
    simp only [hdN, ejpHess3, Fin.sum_univ_three]
    ring
  
  have hform : levelMeanCurvCoord G Φ = fun z => ejpPsi G Φ z * lapLoc G Φ z -
      ejpPsi G Φ z ^ 3 * ∑ i : Fin 3, ∑ j : Fin 3,
        ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z := by
    funext z
    have hQ : (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3,
        (G z)⁻¹ i a * partialDeriv a Φ z * ((G z)⁻¹ j b * partialDeriv b Φ z) *
          hessLoc G Φ i j z) =
        ∑ i : Fin 3, ∑ j : Fin 3, ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z := by
      simp only [ejpN, Fin.sum_univ_three]
      ring
    simp only [levelMeanCurvCoord, ejpPsi, ejpS]
    rw [hQ, div_eq_mul_inv, div_eq_mul_inv, inv_pow]
    ring
  
  have dψ : DifferentiableAt ℝ (ejpPsi G Φ) y := hD _ hψs
  have dL : DifferentiableAt ℝ (lapLoc G Φ) y := by
    have e1 : lapLoc G Φ = fun z => ∑ i : Fin 3, ∑ j : Fin 3,
        (G z)⁻¹ i j * hessLoc G Φ i j z := rfl
    rw [e1]
    exact DifferentiableAt.fun_sum (fun i _ =>
      DifferentiableAt.fun_sum (fun j _ => (dGi i j).fun_mul (dH i j)))
  have dQ : DifferentiableAt ℝ (fun z => ∑ i : Fin 3, ∑ j : Fin 3,
      ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z) y :=
    DifferentiableAt.fun_sum (fun i _ => DifferentiableAt.fun_sum (fun j _ =>
      ((dN i).fun_mul (dN j)).fun_mul (dH i j)))
  have dψ3 : DifferentiableAt ℝ (fun z => ejpPsi G Φ z ^ 3) y := dψ.fun_pow 3
  have hp3 : partialDeriv a (fun z => ejpPsi G Φ z ^ 3) y =
      3 * ejpPsi G Φ y ^ 2 * partialDeriv a (ejpPsi G Φ) y := by
    unfold partialDeriv
    rw [fderiv_fun_pow 3 dψ]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul, nsmul_eq_mul]
    norm_num
  have hsub : partialDeriv a (fun z => ejpPsi G Φ z * lapLoc G Φ z -
      ejpPsi G Φ z ^ 3 * ∑ i : Fin 3, ∑ j : Fin 3,
        ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z) y =
      partialDeriv a (fun z => ejpPsi G Φ z * lapLoc G Φ z) y -
      partialDeriv a (fun z => ejpPsi G Φ z ^ 3 * ∑ i : Fin 3, ∑ j : Fin 3,
        ejpN G Φ z i * ejpN G Φ z j * hessLoc G Φ i j z) y := by
    unfold partialDeriv
    rw [fderiv_fun_sub (dψ.fun_mul dL) (dψ3.fun_mul dQ)]
    simp only [ContinuousLinearMap.sub_apply]
  rw [hform, hsub, pm _ _ dψ dL, pm _ _ dψ3 dQ, hp3, hdψ, hdL, hdQ]
  simp only [lapLoc]
  ring

theorem ejp_div_commutator (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (V : Fin 3 → E3 → ℝ) (hV : ∀ d : Fin 3, ContDiffOn ℝ ∞ (V d) U) (y : E3) (hy : y ∈ U) (b : Fin 3) : ∑ a : Fin 3, (partialDeriv a (fun z => partialDeriv b (V a) z + ∑ d : Fin 3, christoffel G a b d z * V d z) y + ∑ e : Fin 3, christoffel G a a e y * (partialDeriv b (V e) y + ∑ d : Fin 3, christoffel G e b d y * V d y) - ∑ e : Fin 3, christoffel G e a b y * (partialDeriv e (V a) y + ∑ d : Fin 3, christoffel G a e d y * V d y)) - partialDeriv b (fun z => ∑ a : Fin 3, (partialDeriv a (V a) z + ∑ d : Fin 3, christoffel G a a d z * V d z)) y = ∑ d : Fin 3, ricci G b d y * V d y :=
by
  
  have alg : ∀ (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (dΓ : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ)
      (v : Fin 3 → ℝ) (dv : Fin 3 → Fin 3 → ℝ) (ddv : Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ k i j : Fin 3, Γ k i j = Γ k j i) → (∀ m n d : Fin 3, ddv m n d = ddv n m d) →
      ∀ b : Fin 3,
      ∑ a : Fin 3, ((ddv a b a + ∑ d : Fin 3, (dΓ a a b d * v d + Γ a b d * dv a d))
        + ∑ e : Fin 3, Γ a a e * (dv b e + ∑ d : Fin 3, Γ e b d * v d)
        - ∑ e : Fin 3, Γ e a b * (dv e a + ∑ d : Fin 3, Γ a e d * v d))
      - ∑ a : Fin 3, (ddv b a a + ∑ d : Fin 3, (dΓ b a a d * v d + Γ a a d * dv b d))
      = ∑ d : Fin 3, ((∑ i : Fin 3, (dΓ i i b d - dΓ b i i d)
          + ∑ i : Fin 3, ∑ p : Fin 3, (Γ i i p * Γ p b d - Γ i b p * Γ p i d)) * v d) := by
    intro Γ dΓ v dv ddv hΓ hdd b
    fin_cases b <;>
      simp only [Fin.sum_univ_three, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;>
      simp only [hΓ 0 1 0, hΓ 0 2 0, hΓ 0 2 1, hΓ 1 1 0, hΓ 1 2 0, hΓ 1 2 1, hΓ 2 1 0, hΓ 2 2 0,
        hΓ 2 2 1, hdd 1 0 0, hdd 1 0 1, hdd 1 0 2, hdd 2 0 0, hdd 2 0 1, hdd 2 0 2, hdd 2 1 0,
        hdd 2 1 1, hdd 2 1 2] <;>
      ring
  
  have hN : U ∈ 𝓝 y := hU.mem_nhds hy
  have hinf : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hpd : ∀ (w : E3 → ℝ), ContDiffOn ℝ ∞ w U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c w) U := by
    intro w hw c
    have h := hw.fderiv_of_isOpen hU (m := ∞) (by exact_mod_cast le_top)
    exact h.clm_apply contDiffOn_const
  have hDV : ∀ d, DifferentiableAt ℝ (V d) y :=
    fun d => ((hV d).contDiffAt hN).differentiableAt hinf
  have hDpV : ∀ c d, DifferentiableAt ℝ (partialDeriv c (V d)) y :=
    fun c d => ((hpd (V d) (hV d) c).contDiffAt hN).differentiableAt hinf
  have hGd : ∀ i j, DifferentiableAt ℝ (fun z => G z i j) y :=
    fun i j => ((hG i j).contDiffAt hN).differentiableAt hinf
  have hdet : (G y).det ≠ 0 := (hpos y hy).det_pos.ne'
  have hinv : ∀ k l : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ k l) y := by
    intro k l
    have hd : DifferentiableAt ℝ (fun z => (G z).det) y := by
      simp only [Matrix.det_fin_three]
      fun_prop
    have ha : ∀ k l, DifferentiableAt ℝ (fun z => (G z).adjugate k l) y := by
      intro k l
      fin_cases k <;> fin_cases l <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
    have : (fun z => (G z)⁻¹ k l) = fun z => ((G z).det)⁻¹ * (G z).adjugate k l := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [this]
    exact (hd.inv hdet).mul (ha k l)
  have hP : ∀ p q r : Fin 3, DifferentiableAt ℝ (partialDeriv p (fun z => G z q r)) y :=
    fun p q r => ((hpd _ (hG q r) p).contDiffAt hN).differentiableAt hinf
  have hDΓ : ∀ k i j, DifferentiableAt ℝ (christoffel G k i j) y := by
    intro k i j
    show DifferentiableAt ℝ (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
        - partialDeriv l (fun z => G z i j) y)) y
    exact (DifferentiableAt.fun_sum (fun l _ =>
      (hinv k l).mul (((hP i j l).add (hP j i l)).sub (hP l i j)))).const_mul _
  
  have hΓ : ∀ k i j : Fin 3, christoffel G k i j y = christoffel G k j i y := by
    intro k i j
    simp only [christoffel]
    rw [show (fun z => G z j i) = (fun z => G z i j) from funext (fun z => hsymm z j i)]
    congr 1
    refine Finset.sum_congr rfl (fun l _ => ?_)
    ring
  have h2 : minSmoothness ℝ 2 ≤ ∞ := by
    rw [minSmoothness_of_isRCLikeNormedField]
    first
    | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
    | exact WithTop.coe_le_coe.mpr (le_top : (2 : ℕ∞) ≤ ⊤)
  have hdd : ∀ m n d : Fin 3, partialDeriv m (partialDeriv n (V d)) y =
      partialDeriv n (partialDeriv m (V d)) y := by
    intro m n d
    have hc : ContDiffAt ℝ ∞ (V d) y := (hV d).contDiffAt hN
    have hsym := hc.isSymmSndFDerivAt h2
    have hD2 : DifferentiableAt ℝ (fderiv ℝ (V d)) y :=
      (hc.fderiv_right (m := ∞) (by exact_mod_cast le_top)).differentiableAt hinf
    have key : ∀ p q : Fin 3, partialDeriv p (partialDeriv q (V d)) y =
        fderiv ℝ (fderiv ℝ (V d)) y (e p) (e q) := by
      intro p q
      unfold partialDeriv
      rw [fderiv_clm_apply hD2 (differentiableAt_const _)]
      simp
    rw [key, key, hsym]
  
  have hexp : ∀ (f : E3 → ℝ) (g h : Fin 3 → E3 → ℝ) (a : Fin 3), DifferentiableAt ℝ f y →
      (∀ d, DifferentiableAt ℝ (g d) y) → (∀ d, DifferentiableAt ℝ (h d) y) →
      partialDeriv a (fun z => f z + ∑ d : Fin 3, g d z * h d z) y =
        partialDeriv a f y + ∑ d : Fin 3,
          (partialDeriv a (g d) y * h d y + g d y * partialDeriv a (h d) y) := by
    intro f g h a hf hg hh
    have hp : ∀ d, DifferentiableAt ℝ (fun z => g d z * h d z) y := fun d => (hg d).mul (hh d)
    have hs : DifferentiableAt ℝ (fun z => ∑ d : Fin 3, g d z * h d z) y :=
      DifferentiableAt.fun_sum (fun d _ => hp d)
    unfold partialDeriv
    rw [fderiv_fun_add hf hs, fderiv_fun_sum (fun d _ => hp d), ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sum_apply]
    congr 1
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [fderiv_fun_mul (hg d) (hh d)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hsum : ∀ (F : Fin 3 → E3 → ℝ) (c : Fin 3), (∀ d, DifferentiableAt ℝ (F d) y) →
      partialDeriv c (fun z => ∑ d : Fin 3, F d z) y = ∑ d : Fin 3, partialDeriv c (F d) y := by
    intro F c hF
    unfold partialDeriv
    rw [fderiv_fun_sum (fun d _ => hF d), ContinuousLinearMap.sum_apply]
  
  have hX : ∀ a : Fin 3, partialDeriv a (fun z => partialDeriv b (V a) z
      + ∑ d : Fin 3, christoffel G a b d z * V d z) y =
      partialDeriv a (partialDeriv b (V a)) y + ∑ d : Fin 3,
        (partialDeriv a (christoffel G a b d) y * V d y
          + christoffel G a b d y * partialDeriv a (V d) y) :=
    fun a => hexp (partialDeriv b (V a)) (christoffel G a b) V a (hDpV b a)
      (fun d => hDΓ a b d) hDV
  have hDF : ∀ a : Fin 3, DifferentiableAt ℝ (fun z => partialDeriv a (V a) z
      + ∑ d : Fin 3, christoffel G a a d z * V d z) y :=
    fun a => (hDpV a a).add (DifferentiableAt.fun_sum (fun d _ => (hDΓ a a d).mul (hDV d)))
  have hY : partialDeriv b (fun z => ∑ a : Fin 3, (partialDeriv a (V a) z
      + ∑ d : Fin 3, christoffel G a a d z * V d z)) y =
      ∑ a : Fin 3, (partialDeriv b (partialDeriv a (V a)) y + ∑ d : Fin 3,
        (partialDeriv b (christoffel G a a d) y * V d y
          + christoffel G a a d y * partialDeriv b (V d) y)) := by
    refine (hsum (fun a z => partialDeriv a (V a) z
      + ∑ d : Fin 3, christoffel G a a d z * V d z) b hDF).trans ?_
    exact Finset.sum_congr rfl (fun a _ => hexp (partialDeriv a (V a)) (christoffel G a a) V b
      (hDpV a a) (fun d => hDΓ a a d) hDV)
  rw [hY]
  simp only [hX]
  simp only [ricci]
  exact alg (fun k i j => christoffel G k i j y)
    (fun m k i j => partialDeriv m (christoffel G k i j) y) (fun d => V d y)
    (fun m d => partialDeriv m (V d) y) (fun m n d => partialDeriv m (partialDeriv n (V d)) y)
    hΓ hdd b

theorem ejp_inv_compat (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3) (hG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y) (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i) (hdet : (G y).det ≠ 0) (m k l : Fin 3) : partialDeriv m (fun z => (G z)⁻¹ k l) y = -∑ a : Fin 3, (christoffel G k m a y * (G y)⁻¹ a l + christoffel G l m a y * (G y)⁻¹ k a) :=
by
  
  have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => H z a b) y) →
      DifferentiableAt ℝ (fun z => (H z).det) y := by
    intro H hH
    have hfun : (fun z => (H z).det) = fun z =>
        H z 0 0 * H z 1 1 * H z 2 2 - H z 0 0 * H z 1 2 * H z 2 1
        - H z 0 1 * H z 1 0 * H z 2 2 + H z 0 1 * H z 1 2 * H z 2 0
        + H z 0 2 * H z 1 0 * H z 2 1 - H z 0 2 * H z 1 1 * H z 2 0 := by
      funext z; exact Matrix.det_fin_three (H z)
    rw [hfun]
    have h00 := hH 0 0
    have h01 := hH 0 1
    have h02 := hH 0 2
    have h10 := hH 1 0
    have h11 := hH 1 1
    have h12 := hH 1 2
    have h20 := hH 2 0
    have h21 := hH 2 1
    have h22 := hH 2 2
    fun_prop
  have hDd : DifferentiableAt ℝ (fun z => (G z).det) y := hdetD G hG
  have hPd : ∀ k' l' : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ k' l') y := by
    intro k' l'
    have hfun : (fun z => (G z)⁻¹ k' l') =
        fun z => ((G z).det)⁻¹ * ((G z).updateRow l' (Pi.single k' 1)).det := by
      funext z
      rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
        smul_eq_mul]
    rw [hfun]
    refine (hDd.inv hdet).mul (hdetD _ ?_)
    intro a b
    by_cases hal : a = l'
    · subst hal
      simp only [Matrix.updateRow_self]
      exact differentiableAt_const _
    · simp only [Matrix.updateRow_ne hal]
      exact hG a b
  have hev : ∀ᶠ z in 𝓝 y, (G z).det ≠ 0 := hDd.continuousAt.eventually_ne hdet
  have hE : ∀ a l' : Fin 3, ∑ b : Fin 3, G y a b * partialDeriv m (fun z => (G z)⁻¹ b l') y
      + ∑ b : Fin 3, partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l' = 0 := by
    intro a l'
    have h1 : HasFDerivAt (fun z => ∑ b : Fin 3, G z a b * (G z)⁻¹ b l')
        (∑ b : Fin 3, (G y a b • fderiv ℝ (fun z => (G z)⁻¹ b l') y
          + (G y)⁻¹ b l' • fderiv ℝ (fun z => G z a b) y)) y := by
      have hs := HasFDerivAt.sum (u := Finset.univ)
        (A := fun b z => G z a b * (G z)⁻¹ b l')
        (fun b _ => (hG a b).hasFDerivAt.mul (hPd b l').hasFDerivAt)
      convert hs using 1
    have h2 : HasFDerivAt (fun z => ∑ b : Fin 3, G z a b * (G z)⁻¹ b l')
        (0 : E3 →L[ℝ] ℝ) y := by
      apply (hasFDerivAt_const (if a = l' then (1 : ℝ) else 0) y).congr_of_eventuallyEq
      filter_upwards [hev] with z hz
      have := congrFun (congrFun (Matrix.mul_nonsing_inv (G z) (isUnit_iff_ne_zero.mpr hz)) a) l'
      rw [Matrix.mul_apply, Matrix.one_apply] at this
      exact this
    have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
    unfold partialDeriv
    rw [← h3, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro b _
    ring
  have hU : IsUnit (G y).det := isUnit_iff_ne_zero.mpr hdet
  have hGP : G y * (G y)⁻¹ = 1 := Matrix.mul_nonsing_inv (G y) hU
  have hPG : (G y)⁻¹ * G y = 1 := Matrix.nonsing_inv_mul (G y) hU
  let X : Matrix (Fin 3) (Fin 3) ℝ :=
    Matrix.of fun b l' => partialDeriv m (fun z => (G z)⁻¹ b l') y
  let D : Matrix (Fin 3) (Fin 3) ℝ :=
    Matrix.of fun a b => partialDeriv m (fun z => G z a b) y
  let Γm : Matrix (Fin 3) (Fin 3) ℝ :=
    Matrix.of fun p a => christoffel G p m a y
  have hM : G y * X = -(D * (G y)⁻¹) := by
    ext a l'
    rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
    simp only [X, D, Matrix.of_apply]
    exact hE a l'
  have hX : X = -((G y)⁻¹ * (D * (G y)⁻¹)) := by
    calc X = ((G y)⁻¹ * G y) * X := by rw [hPG, Matrix.one_mul]
      _ = (G y)⁻¹ * (G y * X) := Matrix.mul_assoc _ _ _
      _ = _ := by rw [hM, Matrix.mul_neg]
  
  have hlow : ∀ (c : Fin 3) (V : Fin 3 → ℝ),
      ∑ p : Fin 3, G y c p * ((1 / 2 : ℝ) * ∑ l' : Fin 3, (G y)⁻¹ p l' * V l') =
        (1 / 2) * V c := by
    intro c V
    have h1 : ∑ p : Fin 3, G y c p * ((1 / 2 : ℝ) * ∑ l' : Fin 3, (G y)⁻¹ p l' * V l')
        = (1 / 2) * Matrix.mulVec (G y) (Matrix.mulVec (G y)⁻¹ V) c := by
      simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro p _
      apply Finset.sum_congr rfl
      intro l' _
      ring
    rw [h1, Matrix.mulVec_mulVec, hGP, Matrix.one_mulVec]
  have hlowΓ : ∀ c i j : Fin 3, ∑ p : Fin 3, G y c p * christoffel G p i j y =
      (1 / 2) * (partialDeriv i (fun z => G z j c) y + partialDeriv j (fun z => G z i c) y
        - partialDeriv c (fun z => G z i j) y) := by
    intro c i j
    simp only [christoffel]
    exact hlow c (fun l' => partialDeriv i (fun z => G z j l') y
      + partialDeriv j (fun z => G z i l') y - partialDeriv l' (fun z => G z i j) y)
  have hDmat : D = Matrix.transpose Γm * G y + G y * Γm := by
    ext a b
    simp only [D, Γm, Matrix.of_apply, Matrix.add_apply, Matrix.mul_apply,
      Matrix.transpose_apply]
    have e1 : ∑ p : Fin 3, christoffel G p m a y * G y p b =
        ∑ p : Fin 3, G y b p * christoffel G p m a y := by
      apply Finset.sum_congr rfl
      intro p _
      rw [hsymm y p b]
      ring
    have hsd : partialDeriv m (fun z => G z b a) y = partialDeriv m (fun z => G z a b) y := by
      have hf : (fun z => G z b a) = (fun z => G z a b) := funext (fun z => hsymm z b a)
      rw [hf]
    rw [e1, hlowΓ b m a, hlowΓ a m b, hsd]
    ring
  
  have hfin : X = -((G y)⁻¹ * Matrix.transpose Γm + Γm * (G y)⁻¹) := by
    rw [hX, hDmat]
    have h4 : (G y)⁻¹ * ((Matrix.transpose Γm * G y + G y * Γm) * (G y)⁻¹) =
        (G y)⁻¹ * Matrix.transpose Γm * (G y * (G y)⁻¹) + ((G y)⁻¹ * G y) * Γm * (G y)⁻¹ := by
      simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_assoc]
    rw [h4, hGP, hPG, Matrix.mul_one, Matrix.one_mul]
  have hkl := congrFun (congrFun hfin k) l
  simp only [X, Γm, Matrix.of_apply, Matrix.neg_apply, Matrix.add_apply, Matrix.mul_apply,
    Matrix.transpose_apply] at hkl
  rw [hkl, Finset.sum_add_distrib]
  have hA : ∑ a : Fin 3, (G y)⁻¹ k a * christoffel G l m a y =
      ∑ a : Fin 3, christoffel G l m a y * (G y)⁻¹ k a :=
    Finset.sum_congr rfl (fun a _ => mul_comm _ _)
  rw [hA]
  ring

theorem ejp_divN_covariant (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (y : E3) (hy : y ∈ U) (b : Fin 3) : ∑ a : Fin 3, (partialDeriv a (fun z => partialDeriv b (fun w => ejpN G Φ w a) z + ∑ d : Fin 3, christoffel G a b d z * ejpN G Φ z d) y + ∑ e : Fin 3, christoffel G a a e y * (partialDeriv b (fun w => ejpN G Φ w e) y + ∑ d : Fin 3, christoffel G e b d y * ejpN G Φ y d) - ∑ e : Fin 3, christoffel G e a b y * (partialDeriv e (fun w => ejpN G Φ w a) y + ∑ d : Fin 3, christoffel G a e d y * ejpN G Φ y d)) - partialDeriv b (fun z => ∑ a : Fin 3, (partialDeriv a (fun w => ejpN G Φ w a) z + ∑ d : Fin 3, christoffel G a a d z * ejpN G Φ z d)) y = ∑ a : Fin 3, ∑ c : Fin 3, (G y)⁻¹ a c * (ejpHess3 G Φ y b c a - ejpHess3 G Φ y a c b) :=
by
  have hcs := ejp_coord_smooth G Φ U hU hG hpos hΦ
  have hnhds : U ∈ 𝓝 y := hU.mem_nhds hy
  have hdGi : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ i j) y := fun i j =>
    ((hcs.2.1 i j).contDiffAt hnhds).differentiableAt (by simp)
  have hdH : ∀ i j : Fin 3, DifferentiableAt ℝ (hessLoc G Φ i j) y := fun i j =>
    ((hcs.2.2.2.1 i j).contDiffAt hnhds).differentiableAt (by simp)
  have hdG : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => G z i j) y := fun i j =>
    ((hG i j).contDiffAt hnhds).differentiableAt (by simp)
  have hdet : (G y).det ≠ 0 := ((hpos y hy).det_pos).ne'
  have hcomp : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, (christoffel G k m a y * (G y)⁻¹ a l + christoffel G l m a y * (G y)⁻¹ k a) :=
    fun m k l => ejp_inv_compat G y hdG hsymm hdet m k l
  
  have hprod : ∀ (f g : Fin 3 → E3 → ℝ) (m : Fin 3), (∀ c, DifferentiableAt ℝ (f c) y) →
      (∀ c, DifferentiableAt ℝ (g c) y) →
      partialDeriv m (fun z => ∑ c : Fin 3, f c z * g c z) y =
        ∑ c : Fin 3, (partialDeriv m (f c) y * g c y + f c y * partialDeriv m (g c) y) := by
    intro f g m hf hg
    unfold partialDeriv
    rw [fderiv_fun_sum (u := Finset.univ) (A := fun c z => f c z * g c z)
      (fun c _ => DifferentiableAt.fun_mul (hf c) (hg c)), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [fderiv_fun_mul (hf c) (hg c)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hmix : ∀ a b m : Fin 3,
      partialDeriv m (fun z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ b c z) y =
        ∑ c : Fin 3, (G y)⁻¹ a c * ejpHess3 G Φ y b c m
          - ∑ p : Fin 3, christoffel G a m p y * (∑ c : Fin 3, (G y)⁻¹ p c * hessLoc G Φ b c y)
          + ∑ p : Fin 3, christoffel G p m b y * (∑ c : Fin 3, (G y)⁻¹ a c * hessLoc G Φ p c y) := by
    intro a b m
    have h := hprod (fun c z => (G z)⁻¹ a c) (fun c => hessLoc G Φ b c) m
      (fun c => hdGi a c) (fun c => hdH b c)
    beta_reduce at h
    rw [h]
    simp only [hcomp, ejpHess3, Fin.sum_univ_three]
    ring
  
  have hlap : partialDeriv b (lapLoc G Φ) y =
      ∑ a : Fin 3, ∑ c : Fin 3, (G y)⁻¹ a c * ejpHess3 G Φ y a c b := by
    have hd : ∀ a : Fin 3, DifferentiableAt ℝ
        (fun z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ a c z) y := fun a =>
      DifferentiableAt.fun_sum (u := Finset.univ) (A := fun c z => (G z)⁻¹ a c * hessLoc G Φ a c z)
        (fun c _ => DifferentiableAt.fun_mul (hdGi a c) (hdH a c))
    have e1 : partialDeriv b (lapLoc G Φ) y =
        ∑ a : Fin 3, partialDeriv b (fun z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ a c z) y := by
      show fderiv ℝ (fun z => ∑ a : Fin 3, ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ a c z) y (e b) = _
      rw [fderiv_fun_sum (u := Finset.univ)
        (A := fun a z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ a c z) (fun a _ => hd a),
        ContinuousLinearMap.sum_apply]
      rfl
    rw [e1]
    simp only [hmix]
    simp only [Fin.sum_univ_three]
    ring
  
  have hF : ∀ z ∈ U, ∀ a b' : Fin 3,
      partialDeriv b' (fun w => ejpN G Φ w a) z + ∑ d : Fin 3, christoffel G a b' d z * ejpN G Φ z d =
        ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ b' c z := by
    intro z hz a b'
    rw [(ejp_first_derivs G Φ U hU hG hsymm hpos hΦ hdΦ z hz).1 b' a]
    ring
  
  have hT1 : ∀ a : Fin 3, partialDeriv a (fun z => partialDeriv b (fun w => ejpN G Φ w a) z +
      ∑ d : Fin 3, christoffel G a b d z * ejpN G Φ z d) y =
      partialDeriv a (fun z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ b c z) y := by
    intro a
    have hev : (fun z => partialDeriv b (fun w => ejpN G Φ w a) z +
        ∑ d : Fin 3, christoffel G a b d z * ejpN G Φ z d) =ᶠ[𝓝 y]
        (fun z => ∑ c : Fin 3, (G z)⁻¹ a c * hessLoc G Φ b c z) :=
      Filter.eventually_of_mem hnhds (fun z hz => hF z hz a b)
    show fderiv ℝ _ y (e a) = fderiv ℝ _ y (e a)
    rw [hev.fderiv_eq]
  have hT2 : partialDeriv b (fun z => ∑ a : Fin 3, (partialDeriv a (fun w => ejpN G Φ w a) z +
      ∑ d : Fin 3, christoffel G a a d z * ejpN G Φ z d)) y = partialDeriv b (lapLoc G Φ) y := by
    have hev : (fun z => ∑ a : Fin 3, (partialDeriv a (fun w => ejpN G Φ w a) z +
        ∑ d : Fin 3, christoffel G a a d z * ejpN G Φ z d)) =ᶠ[𝓝 y] lapLoc G Φ :=
      Filter.eventually_of_mem hnhds (fun z hz => by
        show _ = ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * hessLoc G Φ i j z
        exact Finset.sum_congr rfl (fun a _ => hF z hz a a))
    show fderiv ℝ _ y (e b) = fderiv ℝ _ y (e b)
    rw [hev.fderiv_eq]
  rw [hT2, hlap]
  simp only [hT1]
  simp only [hmix]
  simp only [hF y hy]
  simp only [Fin.sum_univ_three]
  ring

theorem ejp_ambient_identity (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (y : E3) (hy : y ∈ U) : (∑ a : Fin 3, ∑ b : Fin 3, ejpP G Φ y a b * hessLoc G (ejpPsi G Φ) a b y) - (∑ c : Fin 3, ∑ d : Fin 3, ejpP G Φ y c d * hessLoc G Φ c d y) * (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a (ejpPsi G Φ) y) / ejpS G Φ y + ejpPot G Φ y * ejpPsi G Φ y = -(ejpPsi G Φ y) ^ 2 * ejpJac G Φ y :=
by
  
  have alg : ∀ (g Hs Ric : Fin 3 → Fin 3 → ℝ) (N X φ : Fin 3 → ℝ) (T : Fin 3 → Fin 3 → Fin 3 → ℝ) (ψ s : ℝ), (∀ i j : Fin 3, Hs i j = Hs j i) → (∀ a b c : Fin 3, T a b c = T b a c) → 0 < s → ψ ^ 2 * s = 1 → (∀ a : Fin 3, X a = ∑ c : Fin 3, N c * Hs a c) → (∀ i : Fin 3, N i = ∑ j : Fin 3, g i j * φ j) → (∀ b : Fin 3, ∑ a : Fin 3, ∑ c : Fin 3, g a c * (T b c a - T a c b) = ∑ d : Fin 3, Ric b d * N d) → (∑ a : Fin 3, ∑ b : Fin 3, (g a b - N a * N b / s) * (3 * ψ ^ 5 * X a * X b - ψ ^ 3 * ((∑ c : Fin 3, ∑ e : Fin 3, g c e * Hs a e * Hs b c) + ∑ c : Fin 3, N c * T b c a))) - (∑ c : Fin 3, ∑ d : Fin 3, (g c d - N c * N d / s) * Hs c d) * (∑ a : Fin 3, N a * (-ψ ^ 3 * X a)) / s + ((∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3, (g i j - N i * N j / s) * Hs j k * (g k l - N k * N l / s) * Hs l i) / s + (∑ j : Fin 3, ∑ k : Fin 3, Ric j k * N j * N k) / s) * ψ = -ψ ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, g i j * ((-ψ ^ 3 * X i) * (∑ a : Fin 3, ∑ b : Fin 3, g a b * Hs a b) + ψ * (∑ a : Fin 3, ∑ b : Fin 3, g a b * T a b i) - 3 * ψ ^ 2 * (-ψ ^ 3 * X i) * (∑ a : Fin 3, ∑ b : Fin 3, N a * N b * Hs a b) - ψ ^ 3 * ((∑ a : Fin 3, ∑ b : Fin 3, (∑ e : Fin 3, g a e * Hs i e) * N b * Hs a b) + (∑ a : Fin 3, ∑ b : Fin 3, N a * (∑ e : Fin 3, g b e * Hs i e) * Hs a b) + ∑ a : Fin 3, ∑ b : Fin 3, N a * N b * T a b i)) * φ j := by
    intro g Hs Ric N X φ T ψ s hHs hT hs hψ hX hN hRic
    have hinv : s⁻¹ = ψ ^ 2 := by
      field_simp
      linarith
    have key : ∀ D : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, g i j * D i * φ j =
        ∑ i : Fin 3, D i * N i := by
      intro D
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hN i, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    have hRc : ∑ j : Fin 3, ∑ k : Fin 3, Ric j k * N j * N k =
        ∑ j : Fin 3, N j * ∑ a : Fin 3, ∑ c : Fin 3, g a c * (T j c a - T a c j) := by
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hRic j, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [key, hRc]
    simp only [div_eq_mul_inv, hinv]
    simp only [Fin.sum_univ_three, hX]
    simp only [hHs 1 0, hHs 2 0, hHs 2 1, hT 1 0, hT 2 0, hT 2 1]
    ring
  
  have hs : 0 < ejpS G Φ y := (ejp_level_regularity G Φ U hU hG hpos hΦ hdΦ).1 y hy
  have hψ : ejpPsi G Φ y ^ 2 * ejpS G Φ y = 1 := by
    simp only [ejpPsi]
    rw [inv_pow, Real.sq_sqrt hs.le, inv_mul_cancel₀ hs.ne']
  
  obtain ⟨-, -, hHs, hT⟩ := ejp_sym_facts G Φ U hU hsymm hΦ y hy
  
  have hV : ∀ d : Fin 3, ContDiffOn ℝ ∞ ((fun (d : Fin 3) (w : E3) => ejpN G Φ w d) d) U :=
    fun d => (ejp_coord_smooth G Φ U hU hG hpos hΦ).2.2.2.2 d
  have hRic : ∀ b : Fin 3, ∑ a : Fin 3, ∑ c : Fin 3,
      (G y)⁻¹ a c * (ejpHess3 G Φ y b c a - ejpHess3 G Φ y a c b) =
        ∑ d : Fin 3, ricci G b d y * ejpN G Φ y d := by
    intro b
    have h7 := ejp_div_commutator G U hU hG hsymm hpos (fun (d : Fin 3) (w : E3) => ejpN G Φ w d)
      hV y hy b
    have h8 := ejp_divN_covariant G Φ U hU hG hsymm hpos hΦ hdΦ y hy b
    rw [← h8]
    exact h7
  
  have h5 : ∀ a b : Fin 3, hessLoc G (ejpPsi G Φ) a b y =
      3 * ejpPsi G Φ y ^ 5 * (∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y) *
        (∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ b c y) -
      ejpPsi G Φ y ^ 3 * ((∑ c : Fin 3, ∑ e : Fin 3, (G y)⁻¹ c e * hessLoc G Φ a e y *
        hessLoc G Φ b c y) + ∑ c : Fin 3, ejpN G Φ y c * ejpHess3 G Φ y b c a) :=
    fun a b => ejp_hess_psi G Φ U hU hG hsymm hpos hΦ hdΦ y hy a b
  have h4 := (ejp_first_derivs G Φ U hU hG hsymm hpos hΦ hdΦ y hy).2.2
  have h6 := ejp_lmc_deriv G Φ U hU hG hsymm hpos hΦ hdΦ y hy
  simp only [h5]
  simp only [h4]
  simp only [ejpJac, h6]
  
  exact alg (fun i j => (G y)⁻¹ i j) (fun i j => hessLoc G Φ i j y)
    (fun i j => ricci G i j y) (ejpN G Φ y) (fun a => ∑ c : Fin 3, ejpN G Φ y c * hessLoc G Φ a c y)
    (fun j => partialDeriv j Φ y) (ejpHess3 G Φ y) (ejpPsi G Φ y) (ejpS G Φ y) hHs hT hs hψ
    (fun _ => rfl) (fun _ => rfl) hRic

theorem ejpl_chain2 (w : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hw : ContDiffOn ℝ ∞ w U) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFU : ∀ x ∈ W, F x ∈ U) (x : E2) (hx : x ∈ W) : (∀ j : Fin 2, pd2 j (fun x' => w (F x')) x = ∑ c : Fin 3, partialDeriv c w (F x) * (fderiv ℝ F x (e2 j)) c) ∧ ∀ i j : Fin 2, pd2 i (pd2 j (fun x' => w (F x'))) x = (∑ a : Fin 3, ∑ b : Fin 3, partialDeriv a (partialDeriv b w) (F x) * (fderiv ℝ F x (e2 i)) a * (fderiv ℝ F x (e2 j)) b) + ∑ c : Fin 3, partialDeriv c w (F x) * pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x :=
by
  have hexp : ∀ (ℓ : E3 →L[ℝ] ℝ) (v : E3), ℓ v = ∑ c : Fin 3, v c * ℓ (e c) := by
    intro ℓ v
    have hv : v = ∑ c : Fin 3, v c • e c := by
      ext k
      fin_cases k <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul]
  have hfirst : ∀ (w' : E3 → ℝ) (x0 : E2), DifferentiableAt ℝ w' (F x0) →
      DifferentiableAt ℝ F x0 → ∀ j : Fin 2,
      pd2 j (fun x' => w' (F x')) x0 =
        ∑ c : Fin 3, partialDeriv c w' (F x0) * (fderiv ℝ F x0 (e2 j)) c := by
    intro w' x0 hw' hF' j
    show fderiv ℝ (fun x' => w' (F x')) x0 (e2 j) = _
    rw [fderiv_comp' x0 hw' hF', ContinuousLinearMap.comp_apply, hexp]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [mul_comm]
    rfl
  have hFd : ∀ x' ∈ W, DifferentiableAt ℝ F x' := fun x' hx' =>
    (hF.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx')
  have hwd : ∀ x' ∈ W, DifferentiableAt ℝ w (F x') := fun x' hx' =>
    (hw.differentiableOn (by simp)).differentiableAt (hU.mem_nhds (hFU x' hx'))
  have hwfd : ContDiffOn ℝ ∞ (fderiv ℝ w) U :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 hw).2
  have hFfd : ContDiffOn ℝ ∞ (fderiv ℝ F) W :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hF).2
  have hPd : ∀ c : Fin 3, DifferentiableAt ℝ (partialDeriv c w) (F x) := by
    intro c
    have h : ContDiffOn ℝ ∞ (fun z => fderiv ℝ w z (e c)) U := hwfd.clm_apply contDiffOn_const
    exact (h.differentiableOn (by simp)).differentiableAt (hU.mem_nhds (hFU x hx))
  have hDd : ∀ (j : Fin 2) (c : Fin 3),
      DifferentiableAt ℝ (fun x' => (fderiv ℝ F x' (e2 j)) c) x := by
    intro j c
    let Λ : (E2 →L[ℝ] E3) →L[ℝ] ℝ :=
      (EuclideanSpace.proj c).comp (ContinuousLinearMap.apply ℝ E3 (e2 j))
    have hfun : (fun x' => (fderiv ℝ F x' (e2 j)) c) = Λ ∘ fderiv ℝ F := rfl
    rw [hfun]
    exact Λ.differentiableAt.comp x
      ((hFfd.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx))
  refine ⟨fun j => hfirst w x (hwd x hx) (hFd x hx) j, ?_⟩
  intro i j
  have hev : pd2 j (fun x'' => w (F x'')) =ᶠ[𝓝 x]
      fun x' => ∑ c : Fin 3, partialDeriv c w (F x') * (fderiv ℝ F x' (e2 j)) c :=
    Filter.eventually_of_mem (hW.mem_nhds hx)
      (fun x' hx' => hfirst w x' (hwd x' hx') (hFd x' hx') j)
  show fderiv ℝ (pd2 j (fun x'' => w (F x''))) x (e2 i) = _
  rw [hev.fderiv_eq]
  have hPx : ∀ c : Fin 3, DifferentiableAt ℝ (fun x' => partialDeriv c w (F x')) x :=
    fun c => (hPd c).comp x (hFd x hx)
  rw [fderiv_fun_sum (u := Finset.univ)
    (A := fun c x' => partialDeriv c w (F x') * (fderiv ℝ F x' (e2 j)) c)
    (fun c _ => (hPx c).fun_mul (hDd j c))]
  simp only [ContinuousLinearMap.sum_apply]
  have hterm : ∀ c : Fin 3,
      fderiv ℝ (fun x' => partialDeriv c w (F x') * (fderiv ℝ F x' (e2 j)) c) x (e2 i)
        = partialDeriv c w (F x) * pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x
          + (fderiv ℝ F x (e2 j)) c *
            ∑ a : Fin 3, partialDeriv a (partialDeriv c w) (F x) * (fderiv ℝ F x (e2 i)) a := by
    intro c
    rw [fderiv_fun_mul (hPx c) (hDd j c)]
    rw [← hfirst (partialDeriv c w) x (hPd c) (hFd x hx) i]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rfl
  simp only [hterm]
  simp only [Fin.sum_univ_three]
  ring

theorem ejpl_pull_deriv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFU : ∀ x ∈ W, F x ∈ U) (x : E2) (hx : x ∈ W) (m i j : Fin 2) : pd2 m (fun z => pullMetric2 G F z i j) x = ∑ k : Fin 3, ∑ l : Fin 3, (pd2 m (fun x' => (fderiv ℝ F x' (e2 i)) k) x * G (F x) k l * (fderiv ℝ F x (e2 j)) l + (fderiv ℝ F x (e2 i)) k * G (F x) k l * pd2 m (fun x' => (fderiv ℝ F x' (e2 j)) l) x + (fderiv ℝ F x (e2 i)) k * (∑ r : Fin 3, partialDeriv r (fun y => G y k l) (F x) * (fderiv ℝ F x (e2 m)) r) * (fderiv ℝ F x (e2 j)) l) :=
by
  have hWx : W ∈ 𝓝 x := hW.mem_nhds hx
  have hUy : U ∈ 𝓝 (F x) := hU.mem_nhds (hFU x hx)
  have h1 : (1 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have hFdx : DifferentiableAt ℝ F x :=
    ((hF.contDiffAt hWx).of_le h1).differentiableAt one_ne_zero
  have hFd : DifferentiableAt ℝ (fderiv ℝ F) x :=
    ((hF.fderiv_of_isOpen hW (m := 1) (WithTop.coe_le_coe.mpr le_top)).contDiffAt
      hWx).differentiableAt one_ne_zero
  have hGd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => G y k l) (F x) :=
    fun k l => (((hG k l).contDiffAt hUy).of_le h1).differentiableAt one_ne_zero
  have hcol : ∀ (w : E2) (k : Fin 3), DifferentiableAt ℝ (fun z => (fderiv ℝ F z w) k) x := by
    intro w k
    let Λ : (E2 →L[ℝ] E3) →L[ℝ] ℝ :=
      (EuclideanSpace.proj k).comp (ContinuousLinearMap.apply ℝ E3 w)
    have hfun : (fun z => (fderiv ℝ F z w) k) = Λ ∘ fderiv ℝ F := rfl
    rw [hfun]
    exact Λ.differentiableAt.comp x hFd
  have hBd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun z => G (F z) k l) x :=
    fun k l => (hGd k l).comp x hFdx
  have hexp : ∀ (ℓ : E3 →L[ℝ] ℝ) (u : E3), ℓ u = ∑ r : Fin 3, ℓ (e r) * u r := by
    intro ℓ u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp only [map_sum, map_smul, smul_eq_mul, EuclideanSpace.basisFun_repr,
      EuclideanSpace.basisFun_apply]
    exact Finset.sum_congr rfl (fun r _ => mul_comm _ _)
  have hB' : ∀ k l : Fin 3, fderiv ℝ (fun z => G (F z) k l) x (e2 m) =
      ∑ r : Fin 3, partialDeriv r (fun y => G y k l) (F x) * (fderiv ℝ F x (e2 m)) r := by
    intro k l
    have hc : (fun z => G (F z) k l) = (fun y => G y k l) ∘ F := rfl
    rw [hc, fderiv_comp x (hGd k l) hFdx, ContinuousLinearMap.comp_apply,
      hexp (fderiv ℝ (fun y => G y k l) (F x))]
    rfl
  have hT : ∀ k l : Fin 3, HasFDerivAt
      (fun z => (fderiv ℝ F z (e2 i)) k * G (F z) k l * (fderiv ℝ F z (e2 j)) l)
      (((fderiv ℝ F x (e2 i)) k * G (F x) k l) • fderiv ℝ (fun z => (fderiv ℝ F z (e2 j)) l) x
        + (fderiv ℝ F x (e2 j)) l • ((fderiv ℝ F x (e2 i)) k • fderiv ℝ (fun z => G (F z) k l) x
          + G (F x) k l • fderiv ℝ (fun z => (fderiv ℝ F z (e2 i)) k) x)) x := by
    intro k l
    exact ((hcol (e2 i) k).hasFDerivAt.fun_mul (hBd k l).hasFDerivAt).fun_mul
      (hcol (e2 j) l).hasFDerivAt
  have hsum := HasFDerivAt.fun_sum (u := Finset.univ)
    (fun k _ => HasFDerivAt.fun_sum (u := Finset.univ) (fun l _ => hT k l))
  show fderiv ℝ (fun z => ∑ k : Fin 3, ∑ l : Fin 3,
    (fderiv ℝ F z (e2 i)) k * G (F z) k l * (fderiv ℝ F z (e2 j)) l) x (e2 m) = _
  rw [hsum.fderiv]
  simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul]
  refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => ?_))
  rw [hB' k l]
  simp only [pd2]
  ring

theorem ejpl_proj_linalg (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ : E3 → ℝ) (F : E2 → E3) (x : E2) (hpos : (G (F x)).PosDef) (hdΦ : fderiv ℝ Φ (F x) ≠ 0) (hinj : Function.Injective (fderiv ℝ F x)) (htan : ∀ i : Fin 2, ∑ c : Fin 3, partialDeriv c Φ (F x) * (fderiv ℝ F x (e2 i)) c = 0) : 0 < ejpS G Φ (F x) ∧ pullMetric2 G F x * (pullMetric2 G F x)⁻¹ = 1 ∧ (∀ a b : Fin 3, ∑ i : Fin 2, ∑ j : Fin 2, (pullMetric2 G F x)⁻¹ i j * (fderiv ℝ F x (e2 i)) a * (fderiv ℝ F x (e2 j)) b = ejpP G Φ (F x) a b) ∧ ∀ T : Fin 3 → ℝ, (∀ m : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, G (F x) c d * T c * (fderiv ℝ F x (e2 m)) d = 0) → ∀ c : Fin 3, ejpS G Φ (F x) * T c = (∑ d : Fin 3, partialDeriv d Φ (F x) * T d) * ejpN G Φ (F x) c :=
by
  
  open Matrix in
  have alg : ∀ (Gm Gi : Matrix (Fin 3) (Fin 3) ℝ), Gm * Gi = 1 →
      (∀ a b : Fin 3, Gm a b = Gm b a) → ∀ (ξ : Fin 3 → ℝ) (D : Fin 3 → Fin 2 → ℝ),
      (∀ i : Fin 2, ∑ c : Fin 3, ξ c * D c i = 0) → ∀ (hm hi : Matrix (Fin 2) (Fin 2) ℝ),
      (∀ i j : Fin 2, hm i j = ∑ k : Fin 3, ∑ l : Fin 3, D k i * Gm k l * D l j) →
      hm * hi = 1 → (∑ i : Fin 3, ∑ j : Fin 3, Gi i j * ξ i * ξ j ≠ 0) →
      (∀ a b : Fin 3, ∑ i : Fin 2, ∑ j : Fin 2, hi i j * D a i * D b j =
        Gi a b - (∑ r : Fin 3, Gi a r * ξ r) * (∑ r : Fin 3, Gi b r * ξ r) /
          (∑ i : Fin 3, ∑ j : Fin 3, Gi i j * ξ i * ξ j)) ∧
      (∀ T : Fin 3 → ℝ, (∀ m : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * T c * D d m = 0) →
        ∀ c : Fin 3, (∑ i : Fin 3, ∑ j : Fin 3, Gi i j * ξ i * ξ j) * T c =
          (∑ d : Fin 3, ξ d * T d) * (∑ b : Fin 3, Gi c b * ξ b)) := by
    intro Gm Gi hGi hGs ξ D htan hm hi hh hhi hs
    set s : ℝ := ∑ i : Fin 3, ∑ j : Fin 3, Gi i j * ξ i * ξ j with hsdef
    set ν : Fin 3 → ℝ := fun a => ∑ r : Fin 3, Gi a r * ξ r with hνdef
    have hGiGm : Gi * Gm = 1 := mul_eq_one_comm.mp hGi
    have hGν : ∀ a, ∑ b, Gm a b * ν b = ξ a := by
      intro a
      have h1 : Gm *ᵥ (Gi *ᵥ ξ) = ξ := by rw [Matrix.mulVec_mulVec, hGi, Matrix.one_mulVec]
      exact congrFun h1 a
    have hνξ : ∑ c, ξ c * ν c = s := by
      simp only [hνdef, hsdef, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    have hDν : ∀ i : Fin 2, ∑ c, ∑ d, D c i * Gm c d * ν d = 0 := by
      intro i
      have h : ∀ c, ∑ d, D c i * Gm c d * ν d = ξ c * D c i := by
        intro c
        rw [← hGν c, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun d _ => by ring)
      rw [Finset.sum_congr rfl (fun c _ => h c)]
      exact htan i
    have hνD : ∀ j : Fin 2, ∑ c, ∑ d, ν c * Gm c d * D d j = 0 := by
      intro j
      rw [Finset.sum_comm]
      have h : ∀ d, ∑ c, ν c * Gm c d * D d j = ξ d * D d j := by
        intro d
        rw [← hGν d, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun c _ => by rw [hGs c d]; ring)
      rw [Finset.sum_congr rfl (fun d _ => h d)]
      exact htan j
    have hνν : ∑ c, ∑ d, ν c * Gm c d * ν d = s := by
      have h : ∀ c, ∑ d, ν c * Gm c d * ν d = ξ c * ν c := by
        intro c
        rw [← hGν c, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun d _ => by ring)
      rw [Finset.sum_congr rfl (fun c _ => h c)]
      exact hνξ
    set B : Matrix (Fin 3) (Fin 3) ℝ := Matrix.of fun c k => ![D c 0, D c 1, ν c] k with hB
    set K : Matrix (Fin 3) (Fin 3) ℝ := !![hi 0 0, hi 0 1, 0; hi 1 0, hi 1 1, 0; 0, 0, s⁻¹]
      with hK
    have hGent : ∀ k l, (Bᵀ * Gm * B) k l = ∑ c, ∑ d, B c k * Gm c d * B d l := by
      intro k l
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hGhat : Bᵀ * Gm * B = !![hm 0 0, hm 0 1, 0; hm 1 0, hm 1 1, 0; 0, 0, s] := by
      ext k l
      rw [hGent]
      fin_cases k <;> fin_cases l <;> simp [hB, hh, hDν, hνD, hνν]
    have hhi' : ∀ i j, hm i 0 * hi 0 j + hm i 1 * hi 1 j =
        (1 : Matrix (Fin 2) (Fin 2) ℝ) i j := by
      intro i j
      rw [← hhi, Matrix.mul_apply, Fin.sum_univ_two]
    have h00 := hhi' 0 0
    have h01 := hhi' 0 1
    have h10 := hhi' 1 0
    have h11 := hhi' 1 1
    simp only [Matrix.one_apply_eq, Matrix.one_apply_ne, ne_eq, zero_ne_one, one_ne_zero,
      not_false_eq_true] at h00 h01 h10 h11
    have hGK : Bᵀ * Gm * B * K = 1 := by
      rw [hGhat]
      ext k l
      fin_cases k <;> fin_cases l <;> simp [hK, Matrix.mul_apply, Fin.sum_univ_three, hs] <;>
        linarith
    have hcomm : (B * K) * (Bᵀ * Gm) = 1 := by
      rw [mul_eq_one_comm, ← Matrix.mul_assoc]
      exact hGK
    have hBKB : B * (K * Bᵀ) = Gi := by
      have h := congrArg (· * Gi) hcomm
      simp only [Matrix.mul_assoc, hGi, Matrix.mul_one, Matrix.one_mul] at h
      exact h
    refine ⟨?_, ?_⟩
    · intro a b
      have h := congrFun (congrFun hBKB a) b
      simp only [hB, hK, Matrix.mul_apply, Fin.sum_univ_three, Matrix.transpose_apply,
        Matrix.of_apply] at h
      simp at h
      show ∑ i : Fin 2, ∑ j : Fin 2, hi i j * D a i * D b j = Gi a b - ν a * ν b / s
      rw [Fin.sum_univ_two, Fin.sum_univ_two, Fin.sum_univ_two]
      rw [← h]
      field_simp
      ring
    · intro T hT c
      show s * T c = (∑ d : Fin 3, ξ d * T d) * ν c
      have hT2 : T = B *ᵥ (K *ᵥ (Bᵀ *ᵥ (Gm *ᵥ T))) := by
        rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
          Matrix.mul_assoc B K Bᵀ, hBKB, hGiGm, Matrix.one_mulVec]
      have hw : ∀ k, (Bᵀ *ᵥ (Gm *ᵥ T)) k = ∑ c, B c k * ∑ d, Gm c d * T d := fun k => rfl
      have hw01 : ∀ m : Fin 2, ∑ c, D c m * ∑ d, Gm c d * T d = 0 := by
        intro m
        rw [← hT m, Finset.sum_comm]
        refine Finset.sum_congr rfl (fun c _ => ?_)
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun d _ => by rw [hGs d c]; ring)
      have hw2 : ∑ c, ν c * ∑ d, Gm c d * T d = ∑ d, ξ d * T d := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [← hGν d, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun c _ => by rw [hGs d c]; ring)
      have hw0' : (Bᵀ *ᵥ (Gm *ᵥ T)) 0 = 0 := by
        rw [hw]; simpa [hB] using hw01 0
      have hw1' : (Bᵀ *ᵥ (Gm *ᵥ T)) 1 = 0 := by
        rw [hw]; simpa [hB] using hw01 1
      have hw2' : (Bᵀ *ᵥ (Gm *ᵥ T)) 2 = ∑ d, ξ d * T d := by
        rw [hw]; simpa [hB] using hw2
      have hKw : K *ᵥ (Bᵀ *ᵥ (Gm *ᵥ T)) = ![0, 0, s⁻¹ * ∑ d, ξ d * T d] := by
        generalize Bᵀ *ᵥ (Gm *ᵥ T) = w at hw0' hw1' hw2' ⊢
        ext k
        fin_cases k <;> simp [hK, Matrix.mulVec, dotProduct, Fin.sum_univ_three, hw0', hw1', hw2']
      have hc : T c = ν c * (s⁻¹ * ∑ d, ξ d * T d) := by
        have h := congrFun hT2 c
        rw [hKw] at h
        rw [h]
        simp [hB, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      rw [hc]
      field_simp
  
  have hGs : ∀ a b : Fin 3, G (F x) a b = G (F x) b a := by
    intro a b
    have h := hpos.isHermitian.apply a b
    simp only [star_trivial] at h
    exact h.symm
  have hGi : G (F x) * (G (F x))⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hpos.det_pos.ne')
  
  have hξ : (fun c : Fin 3 => partialDeriv c Φ (F x)) ≠ 0 := by
    intro h
    apply hdΦ
    apply ContinuousLinearMap.coe_injective
    refine (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis.ext (fun i => ?_)
    have hi := congrFun h i
    simp only [partialDeriv, Pi.zero_apply] at hi
    simpa [EuclideanSpace.basisFun_apply] using hi
  
  have hS : 0 < ejpS G Φ (F x) := by
    have h := (hpos.inv).dotProduct_mulVec_pos hξ
    have heq : star (fun c : Fin 3 => partialDeriv c Φ (F x)) ⬝ᵥ
        ((G (F x))⁻¹.mulVec (fun c : Fin 3 => partialDeriv c Φ (F x))) = ejpS G Φ (F x) := by
      simp only [ejpS, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    rw [heq] at h
    exact h
  
  have hker : ∀ w : Fin 2 → ℝ,
      (Matrix.of fun c i => (fderiv ℝ F x (e2 i)) c : Matrix (Fin 3) (Fin 2) ℝ).mulVec w = 0 →
      w = 0 := by
    intro w hw
    have hv : fderiv ℝ F x (∑ i, w i • e2 i) = 0 := by
      apply PiLp.ext
      intro c
      have hc := congrFun hw c
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply] at hc
      simp only [map_sum, map_smul, WithLp.ofLp_sum, PiLp.zero_apply]
      rw [← hc]
      simp [Finset.sum_apply, mul_comm]
    have hv0 : (∑ i, w i • e2 i) = 0 := hinj (by rw [hv, map_zero])
    funext i
    have h := congrArg (fun v : E2 => v i) hv0
    simp [EuclideanSpace.single_apply] at h
    fin_cases i <;> simpa using h
  have hinjD : Function.Injective
      (Matrix.of fun c i => (fderiv ℝ F x (e2 i)) c : Matrix (Fin 3) (Fin 2) ℝ).mulVec := by
    intro w₁ w₂ h
    exact sub_eq_zero.mp (hker _ (by rw [Matrix.mulVec_sub, h, sub_self]))
  have hmpd := hpos.conjTranspose_mul_mul_same hinjD
  have hmeq : pullMetric2 G F x =
      (Matrix.of fun c i => (fderiv ℝ F x (e2 i)) c : Matrix (Fin 3) (Fin 2) ℝ).conjTranspose *
        G (F x) * (Matrix.of fun c i => (fderiv ℝ F x (e2 i)) c : Matrix (Fin 3) (Fin 2) ℝ) := by
    ext i j
    simp only [pullMetric2, Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.of_apply,
      star_trivial, Finset.sum_mul]
    rw [Finset.sum_comm]
  have hhi : pullMetric2 G F x * (pullMetric2 G F x)⁻¹ = 1 := by
    rw [hmeq]
    exact Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr hmpd.det_pos.ne')
  have hs : ∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * partialDeriv i Φ (F x) *
      partialDeriv j Φ (F x) ≠ 0 := hS.ne'
  obtain ⟨h3, h4⟩ := alg (G (F x)) (G (F x))⁻¹ hGi hGs (fun c => partialDeriv c Φ (F x))
    (fun c i => (fderiv ℝ F x (e2 i)) c) htan (pullMetric2 G F x) (pullMetric2 G F x)⁻¹
    (fun i j => rfl) hhi hs
  exact ⟨hS, hhi, fun a b => h3 a b, fun T hT c => h4 T hT c⟩

theorem ejpl_tension_normal (Gm Gi : Matrix (Fin 3) (Fin 3) ℝ) (hGi : Gm * Gi = 1) (hGs : ∀ a b : Fin 3, Gm a b = Gm b a) (dG : Fin 3 → Fin 3 → Fin 3 → ℝ) (D : Fin 3 → Fin 2 → ℝ) (A : Fin 3 → Fin 2 → Fin 2 → ℝ) (hA : ∀ (c : Fin 3) (i j : Fin 2), A c i j = A c j i) (hm hi : Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ i j : Fin 2, hm i j = ∑ k : Fin 3, ∑ l : Fin 3, D k i * Gm k l * D l j) (hhi : hm * hi = 1) (dh : Fin 2 → Fin 2 → Fin 2 → ℝ) (hdh : ∀ m i j : Fin 2, dh m i j = ∑ k : Fin 3, ∑ l : Fin 3, (A k m i * Gm k l * D l j + D k i * Gm k l * A l m j + D k i * (∑ r : Fin 3, dG r k l * D r m) * D l j)) (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (hΓ : ∀ k a b : Fin 3, Γ k a b = 1 / 2 * ∑ l : Fin 3, Gi k l * (dG a b l + dG b a l - dG l a b)) (Γ2 : Fin 2 → Fin 2 → Fin 2 → ℝ) (hΓ2 : ∀ k i j : Fin 2, Γ2 k i j = 1 / 2 * ∑ l : Fin 2, hi k l * (dh i j l + dh j i l - dh l i j)) (i j m : Fin 2) : ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * D a i * D b j) - ∑ k : Fin 2, Γ2 k i j * D c k) * D d m = 0 :=
by
  have lower : ∀ {n : ℕ} (M Mi : Matrix (Fin n) (Fin n) ℝ), M * Mi = 1 →
      (∀ a b : Fin n, M a b = M b a) →
      ∀ (X : Fin n → ℝ) (d : Fin n), ∑ c : Fin n, M c d * (∑ l : Fin n, Mi c l * X l) = X d := by
    intro n M Mi hMi hMs X d
    have key : ∀ l : Fin n, ∑ c : Fin n, M c d * Mi c l = if d = l then 1 else 0 := by
      intro l
      rw [← Matrix.one_apply, ← hMi, Matrix.mul_apply]
      exact Finset.sum_congr rfl (fun c _ => by rw [hMs])
    calc ∑ c : Fin n, M c d * (∑ l : Fin n, Mi c l * X l)
        = ∑ c : Fin n, ∑ l : Fin n, M c d * Mi c l * X l := by
          simp only [Finset.mul_sum, mul_assoc]
      _ = ∑ l : Fin n, (∑ c : Fin n, M c d * Mi c l) * X l := by
          rw [Finset.sum_comm]; simp only [Finset.sum_mul]
      _ = X d := by
          simp only [key, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  have hL : ∀ d a b : Fin 3, ∑ c : Fin 3, Gm c d * Γ c a b
      = 1 / 2 * (dG a b d + dG b a d - dG d a b) := by
    intro d a b
    have h := lower Gm Gi hGi hGs (fun l => 1 / 2 * (dG a b l + dG b a l - dG l a b)) d
    beta_reduce at h
    rw [← h]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [hΓ c a b]
    simp only [Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    ring
  have hms : ∀ p q : Fin 2, hm p q = hm q p := by
    intro p q
    rw [hh p q, hh q p]
    simp only [Fin.sum_univ_three]
    rw [hGs 1 0, hGs 2 0, hGs 2 1]
    ring
  have hQ : ∑ k : Fin 2, Γ2 k i j * hm k m = 1 / 2 * (dh i j m + dh j i m - dh m i j) := by
    have h := lower hm hi hhi hms (fun l => 1 / 2 * (dh i j l + dh j i l - dh l i j)) m
    beta_reduce at h
    rw [← h]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [hΓ2 k i j]
    simp only [Finset.mul_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    ring
  have e1 : ∑ c : Fin 3, ∑ d : Fin 3, Gm c d * (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, Γ c a b * D a i * D b j) - ∑ k : Fin 2, Γ2 k i j * D c k) * D d m
      = (∑ c : Fin 3, ∑ d : Fin 3, Gm c d * A c i j * D d m)
        + (∑ a : Fin 3, ∑ b : Fin 3, ∑ d : Fin 3, (∑ c : Fin 3, Gm c d * Γ c a b) * D a i * D b j * D d m)
        - ∑ k : Fin 2, Γ2 k i j * hm k m := by
    simp only [hh, Fin.sum_univ_three, Fin.sum_univ_two]
    ring
  rw [e1, hQ]
  simp only [hL]
  rw [hdh i j m, hdh j i m, hdh m i j]
  simp only [hA _ j i, hA _ m i, hA _ m j]
  simp only [Fin.sum_univ_three]
  rw [hGs 1 0, hGs 2 0, hGs 2 1]
  ring

theorem ejpl_assembly (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ u : E3 → ℝ) (y : E3) (D : Fin 3 → Fin 2 → ℝ) (A : Fin 3 → Fin 2 → Fin 2 → ℝ) (hi : Matrix (Fin 2) (Fin 2) ℝ) (Γ2 : Fin 2 → Fin 2 → Fin 2 → ℝ) (hS : ejpS G Φ y ≠ 0) (hM : ∀ a b : Fin 3, ∑ i : Fin 2, ∑ j : Fin 2, hi i j * D a i * D b j = ejpP G Φ y a b) (htan : ∀ k : Fin 2, ∑ c : Fin 3, partialDeriv c Φ y * D c k = 0) (hΦ2 : ∀ i j : Fin 2, (∑ a : Fin 3, ∑ b : Fin 3, partialDeriv a (partialDeriv b Φ) y * D a i * D b j) + ∑ c : Fin 3, partialDeriv c Φ y * A c i j = 0) (hnorm : ∀ (i j : Fin 2) (c : Fin 3), ejpS G Φ y * (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b y * D a i * D b j) - ∑ k : Fin 2, Γ2 k i j * D c k) = (∑ d : Fin 3, partialDeriv d Φ y * (A d i j + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G d a b y * D a i * D b j) - ∑ k : Fin 2, Γ2 k i j * D d k)) * ejpN G Φ y c) : (∑ i : Fin 2, ∑ j : Fin 2, hi i j * (((∑ a : Fin 3, ∑ b : Fin 3, partialDeriv a (partialDeriv b u) y * D a i * D b j) + ∑ c : Fin 3, partialDeriv c u y * A c i j) - ∑ k : Fin 2, Γ2 k i j * ∑ c : Fin 3, partialDeriv c u y * D c k)) = (∑ a : Fin 3, ∑ b : Fin 3, ejpP G Φ y a b * hessLoc G u a b y) - (∑ c : Fin 3, ∑ d : Fin 3, ejpP G Φ y c d * hessLoc G Φ c d y) * (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a u y) / ejpS G Φ y :=
by
  
  have hC : ∀ H : Fin 3 → Fin 3 → ℝ, (∑ i : Fin 2, ∑ j : Fin 2,
      hi i j * (∑ a : Fin 3, ∑ b : Fin 3, H a b * D a i * D b j)) =
      ∑ a : Fin 3, ∑ b : Fin 3, ejpP G Φ y a b * H a b := by
    intro H
    have hM' := hM
    simp only [Fin.sum_univ_two, Fin.sum_univ_three] at hM' ⊢
    linear_combination H 0 0 * hM' 0 0 + H 0 1 * hM' 0 1 + H 0 2 * hM' 0 2
      + H 1 0 * hM' 1 0 + H 1 1 * hM' 1 1 + H 1 2 * hM' 1 2
      + H 2 0 * hM' 2 0 + H 2 1 * hM' 2 1 + H 2 2 * hM' 2 2
  
  have hN : ∀ i j : Fin 2, ejpS G Φ y * (∑ c : Fin 3, partialDeriv c u y *
      (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b y * D a i * D b j)
        - ∑ k : Fin 2, Γ2 k i j * D c k)) =
      -(∑ a : Fin 3, ∑ b : Fin 3, hessLoc G Φ a b y * D a i * D b j) *
        (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a u y) := by
    intro i j
    have h0 := hnorm i j 0
    have h1 := hnorm i j 1
    have h2 := hnorm i j 2
    have hq := hΦ2 i j
    have t0 := htan 0
    have t1 := htan 1
    simp only [hessLoc, Fin.sum_univ_two, Fin.sum_univ_three] at h0 h1 h2 hq t0 t1 ⊢
    linear_combination partialDeriv 0 u y * h0 + partialDeriv 1 u y * h1
      + partialDeriv 2 u y * h2
      + (ejpN G Φ y 0 * partialDeriv 0 u y + ejpN G Φ y 1 * partialDeriv 1 u y
          + ejpN G Φ y 2 * partialDeriv 2 u y) * hq
      - (ejpN G Φ y 0 * partialDeriv 0 u y + ejpN G Φ y 1 * partialDeriv 1 u y
          + ejpN G Φ y 2 * partialDeriv 2 u y) * Γ2 0 i j * t0
      - (ejpN G Φ y 0 * partialDeriv 0 u y + ejpN G Φ y 1 * partialDeriv 1 u y
          + ejpN G Φ y 2 * partialDeriv 2 u y) * Γ2 1 i j * t1
  
  have hNd : ∀ i j : Fin 2, (∑ c : Fin 3, partialDeriv c u y *
      (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b y * D a i * D b j)
        - ∑ k : Fin 2, Γ2 k i j * D c k)) =
      -(∑ a : Fin 3, ∑ b : Fin 3, hessLoc G Φ a b y * D a i * D b j) *
        (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a u y) / ejpS G Φ y := by
    intro i j
    rw [eq_div_iff hS]
    linear_combination hN i j
  
  have hK : ∀ i j : Fin 2, (((∑ a : Fin 3, ∑ b : Fin 3,
      partialDeriv a (partialDeriv b u) y * D a i * D b j)
        + ∑ c : Fin 3, partialDeriv c u y * A c i j)
        - ∑ k : Fin 2, Γ2 k i j * ∑ c : Fin 3, partialDeriv c u y * D c k) =
      (∑ a : Fin 3, ∑ b : Fin 3, hessLoc G u a b y * D a i * D b j)
        + ∑ c : Fin 3, partialDeriv c u y *
          (A c i j + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b y * D a i * D b j)
            - ∑ k : Fin 2, Γ2 k i j * D c k) := by
    intro i j
    simp only [hessLoc, Fin.sum_univ_two, Fin.sum_univ_three]
    ring
  
  have hB : ∀ i j : Fin 2, (((∑ a : Fin 3, ∑ b : Fin 3,
      partialDeriv a (partialDeriv b u) y * D a i * D b j)
        + ∑ c : Fin 3, partialDeriv c u y * A c i j)
        - ∑ k : Fin 2, Γ2 k i j * ∑ c : Fin 3, partialDeriv c u y * D c k) =
      ∑ a : Fin 3, ∑ b : Fin 3, (hessLoc G u a b y - hessLoc G Φ a b y *
        (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a u y) / ejpS G Φ y) * D a i * D b j := by
    intro i j
    have k1 := hK i j
    have k2 := hNd i j
    simp only [Fin.sum_univ_two, Fin.sum_univ_three] at k1 k2 ⊢
    linear_combination k1 + k2
  
  simp only [hB]
  have hC' := hC (fun a b => hessLoc G u a b y - hessLoc G Φ a b y *
        (∑ a : Fin 3, ejpN G Φ y a * partialDeriv a u y) / ejpS G Φ y)
  simp only at hC'
  rw [hC']
  
  simp only [Fin.sum_univ_three]
  ring

theorem ejp_immersion_lap2 (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ u : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (hu : ContDiffOn ℝ ∞ u U) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFW : ∀ x ∈ W, F x ∈ U ∧ Φ (F x) = 0 ∧ Function.Injective (fderiv ℝ F x)) (x : E2) (hx : x ∈ W) : lap2 (pullMetric2 G F) (fun x' => u (F x')) x = (∑ a : Fin 3, ∑ b : Fin 3, ejpP G Φ (F x) a b * hessLoc G u a b (F x)) - (∑ c : Fin 3, ∑ d : Fin 3, ejpP G Φ (F x) c d * hessLoc G Φ c d (F x)) * (∑ a : Fin 3, ejpN G Φ (F x) a * partialDeriv a u (F x)) / ejpS G Φ (F x) :=
by
  have hFx := hFW x hx
  have hFU : ∀ x' ∈ W, F x' ∈ U := fun x' h => (hFW x' h).1
  
  have hlev1 : ∀ x' ∈ W, ∀ j : Fin 2, pd2 j (fun x'' => Φ (F x'')) x' = 0 := by
    intro x' hx' j
    have hev : (fun x'' => Φ (F x'')) =ᶠ[𝓝 x'] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hW.mem_nhds hx') (fun x'' h => (hFW x'' h).2.1)
    show fderiv ℝ (fun x'' => Φ (F x'')) x' (e2 j) = 0
    rw [hev.fderiv_eq]
    simp
  
  have hlev2 : ∀ i j : Fin 2, pd2 i (pd2 j (fun x'' => Φ (F x''))) x = 0 := by
    intro i j
    have hev : pd2 j (fun x'' => Φ (F x'')) =ᶠ[𝓝 x] fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun x'' h => hlev1 x'' h j)
    show fderiv ℝ (pd2 j (fun x'' => Φ (F x''))) x (e2 i) = 0
    rw [hev.fderiv_eq]
    simp
  obtain ⟨hΦ1, hΦ2'⟩ := ejpl_chain2 Φ U hU hΦ F W hW hF hFU x hx
  
  have htan : ∀ i : Fin 2, ∑ c : Fin 3, partialDeriv c Φ (F x) * (fderiv ℝ F x (e2 i)) c = 0 := by
    intro i
    rw [← hΦ1 i]
    exact hlev1 x hx i
  have hΦ2 : ∀ i j : Fin 2, (∑ a : Fin 3, ∑ b : Fin 3,
      partialDeriv a (partialDeriv b Φ) (F x) * (fderiv ℝ F x (e2 i)) a * (fderiv ℝ F x (e2 j)) b)
      + ∑ c : Fin 3, partialDeriv c Φ (F x) * pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x = 0 := by
    intro i j
    rw [← hΦ2' i j]
    exact hlev2 i j
  
  have hA : ∀ (c : Fin 3) (i j : Fin 2), pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x =
      pd2 j (fun x' => (fderiv ℝ F x' (e2 i)) c) x := by
    intro c i j
    have hFd : DifferentiableAt ℝ (fderiv ℝ F) x :=
      ((hF.fderiv_of_isOpen hW (m := 1) (WithTop.coe_le_coe.mpr le_top)).contDiffAt
        (hW.mem_nhds hx)).differentiableAt one_ne_zero
    have hsym := (hF.contDiffAt (hW.mem_nhds hx)).isSymmSndFDerivAt
      (by simp only [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
    have h2 : ∀ i' j' : Fin 2, pd2 i' (fun x' => (fderiv ℝ F x' (e2 j')) c) x =
        (fderiv ℝ (fderiv ℝ F) x (e2 i') (e2 j')) c := by
      intro i' j'
      let Λ : (E2 →L[ℝ] E3) →L[ℝ] ℝ :=
        (EuclideanSpace.proj c).comp (ContinuousLinearMap.apply ℝ E3 (e2 j'))
      have hfun : (fun x' => (fderiv ℝ F x' (e2 j')) c) = Λ ∘ fderiv ℝ F := rfl
      show fderiv ℝ (fun x' => (fderiv ℝ F x' (e2 j')) c) x (e2 i') = _
      rw [hfun, fderiv_comp x Λ.differentiableAt hFd, ContinuousLinearMap.fderiv]
      rfl
    rw [h2, h2, hsym]
  
  obtain ⟨hSpos, hhi, hM, hdec⟩ :=
    ejpl_proj_linalg G Φ F x (hpos (F x) hFx.1) (hdΦ (F x) hFx.1) hFx.2.2 htan
  have hGi : G (F x) * (G (F x))⁻¹ = 1 :=
    Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (hpos (F x) hFx.1).det_pos.ne')
  
  have hnormal := ejpl_tension_normal (G (F x)) (G (F x))⁻¹ hGi (fun a b => hsymm (F x) a b)
    (fun r p q => partialDeriv r (fun z => G z p q) (F x))
    (fun c i => (fderiv ℝ F x (e2 i)) c)
    (fun c i j => pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x)
    hA (pullMetric2 G F x) (pullMetric2 G F x)⁻¹ (fun i j => rfl) hhi
    (fun m p q => pd2 m (fun z => pullMetric2 G F z p q) x)
    (fun m i j => ejpl_pull_deriv G U hU hG F W hW hF hFU x hx m i j)
    (fun k a b => christoffel G k a b (F x)) (fun k a b => rfl)
    (fun k i j => christoffel2 (pullMetric2 G F) k i j x) (fun k i j => rfl)
  
  have hnorm : ∀ (i j : Fin 2) (c : Fin 3), ejpS G Φ (F x) *
      (pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x
        + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b (F x) * (fderiv ℝ F x (e2 i)) a
            * (fderiv ℝ F x (e2 j)) b)
        - ∑ k : Fin 2, christoffel2 (pullMetric2 G F) k i j x * (fderiv ℝ F x (e2 k)) c) =
      (∑ d : Fin 3, partialDeriv d Φ (F x) *
        (pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) d) x
          + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G d a b (F x) * (fderiv ℝ F x (e2 i)) a
              * (fderiv ℝ F x (e2 j)) b)
          - ∑ k : Fin 2, christoffel2 (pullMetric2 G F) k i j x * (fderiv ℝ F x (e2 k)) d))
        * ejpN G Φ (F x) c := by
    intro i j c
    exact hdec (fun c => pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x
        + (∑ a : Fin 3, ∑ b : Fin 3, christoffel G c a b (F x) * (fderiv ℝ F x (e2 i)) a
            * (fderiv ℝ F x (e2 j)) b)
        - ∑ k : Fin 2, christoffel2 (pullMetric2 G F) k i j x * (fderiv ℝ F x (e2 k)) c)
      (fun m => hnormal i j m) c
  
  obtain ⟨hu1, hu2⟩ := ejpl_chain2 u U hU hu F W hW hF hFU x hx
  
  unfold lap2
  simp only [hu1, hu2]
  exact ejpl_assembly G Φ u (F x) (fun c i => (fderiv ℝ F x (e2 i)) c)
    (fun c i j => pd2 i (fun x' => (fderiv ℝ F x' (e2 j)) c) x) (pullMetric2 G F x)⁻¹
    (fun k i j => christoffel2 (pullMetric2 G F) k i j x) hSpos.ne' hM htan hΦ2 hnorm

theorem secondFundSq_congr_scale (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F₁ F₂ : E3 → ℝ) (y : E3)
    (μ : ℝ) (hPD : (G y).PosDef) (hξ : (fun k : Fin 3 => partialDeriv k F₁ y) ≠ 0)
    (hμ0 : μ ≠ 0) (hgrad : ∀ k : Fin 3, partialDeriv k F₂ y = μ * partialDeriv k F₁ y)
    (hDsymm : ∀ i j : Fin 3, hessLoc G F₂ i j y - μ * hessLoc G F₁ i j y =
      hessLoc G F₂ j i y - μ * hessLoc G F₁ j i y)
    (hD : ∀ v : Fin 3 → ℝ, ∑ k : Fin 3, partialDeriv k F₁ y * v k = 0 →
      ∑ i : Fin 3, ∑ j : Fin 3, v i * v j * (hessLoc G F₂ i j y - μ * hessLoc G F₁ i j y) = 0) :
    secondFundSq G F₂ y = secondFundSq G F₁ y :=
by
  
  have trace_core : ∀ (P H H2 : Fin 3 → Fin 3 → ℝ) (μ : ℝ),
      (∀ a b : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, P a j * (H2 j k - μ * H j k) * P k b = 0) →
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3, P i j * H2 j k * P k l * H2 l i =
        μ ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
          P i j * H j k * P k l * H l i := by
    intro P H H2 μ hQ
    have h00 := hQ 0 0
    have h01 := hQ 0 1
    have h02 := hQ 0 2
    have h10 := hQ 1 0
    have h11 := hQ 1 1
    have h12 := hQ 1 2
    have h20 := hQ 2 0
    have h21 := hQ 2 1
    have h22 := hQ 2 2
    simp only [Fin.sum_univ_three] at h00 h01 h02 h10 h11 h12 h20 h21 h22 ⊢
    linear_combination (μ * H 0 0 + H2 0 0) * h00 + (μ * H 1 0 + H2 1 0) * h01 +
      (μ * H 2 0 + H2 2 0) * h02 + (μ * H 0 1 + H2 0 1) * h10 + (μ * H 1 1 + H2 1 1) * h11 +
      (μ * H 2 1 + H2 2 1) * h12 + (μ * H 0 2 + H2 0 2) * h20 + (μ * H 1 2 + H2 1 2) * h21 +
      (μ * H 2 2 + H2 2 2) * h22
  
  have core : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (H H2 : Fin 3 → Fin 3 → ℝ) (ξ : Fin 3 → ℝ)
      (μ : ℝ), μ ≠ 0 → (∀ i j : Fin 3, A i j = A j i) →
      (∀ i j : Fin 3, H2 i j - μ * H i j = H2 j i - μ * H j i) →
      (∀ v : Fin 3 → ℝ, ∑ k : Fin 3, ξ k * v k = 0 →
        ∑ i : Fin 3, ∑ j : Fin 3, v i * v j * (H2 i j - μ * H i j) = 0) →
      (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
          (A i j - (∑ a : Fin 3, A i a * (μ * ξ a)) * (∑ b : Fin 3, A j b * (μ * ξ b)) /
              (∑ a : Fin 3, ∑ b : Fin 3, A a b * (μ * ξ a) * (μ * ξ b))) * H2 j k *
            (A k l - (∑ a : Fin 3, A k a * (μ * ξ a)) * (∑ b : Fin 3, A l b * (μ * ξ b)) /
              (∑ a : Fin 3, ∑ b : Fin 3, A a b * (μ * ξ a) * (μ * ξ b))) * H2 l i) /
          (∑ a : Fin 3, ∑ b : Fin 3, A a b * (μ * ξ a) * (μ * ξ b)) =
        (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
          (A i j - (∑ a : Fin 3, A i a * ξ a) * (∑ b : Fin 3, A j b * ξ b) /
              (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b)) * H j k *
            (A k l - (∑ a : Fin 3, A k a * ξ a) * (∑ b : Fin 3, A l b * ξ b) /
              (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b)) * H l i) /
          (∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b) := by
    intro A H H2 ξ μ hμ hA hDs hD
    have hcμ : ∀ i : Fin 3, ∑ a : Fin 3, A i a * (μ * ξ a) = μ * ∑ a : Fin 3, A i a * ξ a := by
      intro i
      simp only [Fin.sum_univ_three]
      ring
    have hSμ : ∑ a : Fin 3, ∑ b : Fin 3, A a b * (μ * ξ a) * (μ * ξ b) =
        μ ^ 2 * ∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b := by
      simp only [Fin.sum_univ_three]
      ring
    simp only [hcμ, hSμ]
    obtain ⟨c, hc⟩ : ∃ c : Fin 3 → ℝ, ∀ i : Fin 3, ∑ a : Fin 3, A i a * ξ a = c i :=
      ⟨fun i => ∑ a : Fin 3, A i a * ξ a, fun i => rfl⟩
    obtain ⟨S, hS⟩ : ∃ S : ℝ, ∑ a : Fin 3, ∑ b : Fin 3, A a b * ξ a * ξ b = S := ⟨_, rfl⟩
    
    have polar : ∀ u w : Fin 3 → ℝ, ∑ k : Fin 3, ξ k * u k = 0 → ∑ k : Fin 3, ξ k * w k = 0 →
        ∑ i : Fin 3, ∑ j : Fin 3, u i * w j * (H2 i j - μ * H i j) = 0 := by
      intro u w hu hw
      have h1 := hD (fun k => u k + w k) (by
        simp only [Fin.sum_univ_three] at hu hw ⊢
        linarith)
      have h2 := hD (fun k => u k - w k) (by
        simp only [Fin.sum_univ_three] at hu hw ⊢
        linarith)
      have s01 := hDs 0 1
      have s02 := hDs 0 2
      have s12 := hDs 1 2
      simp only [Fin.sum_univ_three] at h1 h2 ⊢
      linear_combination (h1 - h2) / 4 + (u 0 * w 1 - w 0 * u 1) / 2 * s01 +
        (u 0 * w 2 - w 0 * u 2) / 2 * s02 + (u 1 * w 2 - w 1 * u 2) / 2 * s12
    have e1 : ∀ i : Fin 3, ∑ j : Fin 3, ξ j * A i j = c i := by
      intro i
      rw [← hc]
      simp only [Fin.sum_univ_three]
      ring
    have e1' : ∀ l : Fin 3, ∑ k : Fin 3, ξ k * A k l = c l := by
      intro l
      rw [← hc]
      simp only [Fin.sum_univ_three]
      rw [hA 0 l, hA 1 l, hA 2 l]
      ring
    have e2 : ∑ j : Fin 3, ξ j * c j = S := by
      rw [← hS]
      simp only [← hc, Fin.sum_univ_three]
      ring
    simp only [hc, hS]
    by_cases hS0 : S = 0
    · simp [hS0]
    have hPμ : ∀ i j : Fin 3,
        A i j - μ * c i * (μ * c j) / (μ ^ 2 * S) = A i j - c i * c j / S := by
      intro i j
      rw [show μ * c i * (μ * c j) = μ ^ 2 * (c i * c j) by ring,
        mul_div_mul_left _ _ (pow_ne_zero 2 hμ)]
    simp only [hPμ]
    have row : ∀ i : Fin 3, ∑ j : Fin 3, ξ j * (A i j - c i * c j / S) = 0 := by
      intro i
      have h : ∑ j : Fin 3, ξ j * (A i j - c i * c j / S) =
          (∑ j : Fin 3, ξ j * A i j) - c i * (∑ j : Fin 3, ξ j * c j) / S := by
        simp only [Fin.sum_univ_three]
        ring
      rw [h, e1, e2, mul_div_assoc, div_self hS0, mul_one, sub_self]
    have col : ∀ l : Fin 3, ∑ k : Fin 3, ξ k * (A k l - c k * c l / S) = 0 := by
      intro l
      have h : ∑ k : Fin 3, ξ k * (A k l - c k * c l / S) =
          (∑ k : Fin 3, ξ k * A k l) - c l * (∑ k : Fin 3, ξ k * c k) / S := by
        simp only [Fin.sum_univ_three]
        ring
      rw [h, e1', e2, mul_div_assoc, div_self hS0, mul_one, sub_self]
    have hQ : ∀ a b : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
        (A a j - c a * c j / S) * (H2 j k - μ * H j k) * (A k b - c k * c b / S) = 0 := by
      intro a b
      have h := polar (fun j => A a j - c a * c j / S) (fun k => A k b - c k * c b / S)
        (row a) (col b)
      beta_reduce at h
      rw [← h]
      refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
      ring
    have key := trace_core (fun i j => A i j - c i * c j / S) H H2 μ hQ
    beta_reduce at key
    rw [key, mul_div_mul_left _ _ (pow_ne_zero 2 hμ)]
  have hA : ∀ i j : Fin 3, (G y)⁻¹ i j = (G y)⁻¹ j i := by
    intro i j
    have h := hPD.isHermitian.inv.apply j i
    simp only [star_trivial] at h
    exact h
  unfold secondFundSq
  simp only [hgrad]
  exact core (G y)⁻¹ (fun j k => hessLoc G F₁ j k y) (fun j k => hessLoc G F₂ j k y)
    (fun k => partialDeriv k F₁ y) μ hμ0 hA hDsymm hD

theorem ejp_pot_congr (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (Φ Φ' : E3 → ℝ) (U : Set E3) (hU : IsOpen U) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpos : ∀ y ∈ U, (G y).PosDef) (hΦ : ContDiffOn ℝ ∞ Φ U) (hΦ' : ContDiffOn ℝ ∞ Φ' U) (hdΦ : ∀ y ∈ U, fderiv ℝ Φ y ≠ 0) (hdΦ' : ∀ y ∈ U, fderiv ℝ Φ' y ≠ 0) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFW : ∀ x ∈ W, F x ∈ U ∧ Φ (F x) = 0 ∧ Φ' (F x) = 0 ∧ Function.Injective (fderiv ℝ F x)) (x : E2) (hx : x ∈ W) : ejpPot G Φ' (F x) = ejpPot G Φ (F x) :=
by
  obtain ⟨hyU, -, -, hinj⟩ := hFW x hx
  have h12 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
    exact WithTop.coe_le_coe.mpr (le_top : ((1 + 1 : ℕ∞)) ≤ ⊤)
  
  have hexp : ∀ w : E3, ∑ k : Fin 3, w k • e k = w := by
    intro w
    have h := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr w
    simpa [EuclideanSpace.basisFun_apply, EuclideanSpace.basisFun_repr] using h
  have hL : ∀ (L : E3 →L[ℝ] ℝ) (v : E3), L v = ∑ k : Fin 3, v k * L (e k) := by
    intro L v
    conv_lhs => rw [← hexp v]
    simp [map_sum, map_smul, smul_eq_mul]
  have hB : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (u v : E3),
      B u v = ∑ a : Fin 3, ∑ b : Fin 3, u a * v b * B (e a) (e b) := by
    intro B u v
    rw [hL (B u) v]
    have hcol : ∀ b : Fin 3, B u (e b) = ∑ a : Fin 3, u a * B (e a) (e b) := by
      intro b
      have h := hL (B.flip (e b)) u
      simpa using h
    simp only [hcol, Fin.sum_univ_three]
    ring
  
  have hsecond : ∀ Ψ : E3 → ℝ, ContDiffOn ℝ ∞ Ψ U → ∀ a b : Fin 3,
      partialDeriv a (partialDeriv b Ψ) (F x) = fderiv ℝ (fderiv ℝ Ψ) (F x) (e a) (e b) ∧
      partialDeriv a (partialDeriv b Ψ) (F x) = partialDeriv b (partialDeriv a Ψ) (F x) := by
    intro Ψ hΨ a b
    have hΨa : ContDiffAt ℝ ∞ Ψ (F x) := hΨ.contDiffAt (hU.mem_nhds hyU)
    have hd : DifferentiableAt ℝ (fderiv ℝ Ψ) (F x) :=
      (hΨa.fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have hconv : ∀ a b : Fin 3,
        partialDeriv a (partialDeriv b Ψ) (F x) = fderiv ℝ (fderiv ℝ Ψ) (F x) (e a) (e b) := by
      intro a b
      have h1 : partialDeriv b Ψ = fun z => fderiv ℝ Ψ z (e b) := rfl
      rw [h1]
      show fderiv ℝ (fun z => fderiv ℝ Ψ z (e b)) (F x) (e a) = _
      rw [fderiv_clm_apply hd (differentiableAt_const _)]
      simp
    have hsym := hΨa.isSymmSndFDerivAt (by
      simp only [minSmoothness_of_isRCLikeNormedField]
      exact WithTop.coe_le_coe.mpr le_top)
    refine ⟨hconv a b, ?_⟩
    rw [hconv, hconv, hsym]
  
  have hjet : ∀ Ψ : E3 → ℝ, ContDiffOn ℝ ∞ Ψ U → (∀ x' ∈ W, Ψ (F x') = 0) →
      (∀ i : Fin 2, fderiv ℝ Ψ (F x) (fderiv ℝ F x (e2 i)) = 0) ∧
      ∀ i j : Fin 2, fderiv ℝ (fderiv ℝ Ψ) (F x) (fderiv ℝ F x (e2 i)) (fderiv ℝ F x (e2 j)) +
        fderiv ℝ Ψ (F x) (fderiv ℝ (fun x' => fderiv ℝ F x' (e2 j)) x (e2 i)) = 0 := by
    intro Ψ hΨ hΨ0
    have hFd : ∀ x' ∈ W, DifferentiableAt ℝ F x' := fun x' hx' =>
      (hF.contDiffAt (hW.mem_nhds hx')).differentiableAt (by simp)
    have hΨd : ∀ x' ∈ W, DifferentiableAt ℝ Ψ (F x') := fun x' hx' =>
      (hΨ.contDiffAt (hU.mem_nhds (hFW x' hx').1)).differentiableAt (by simp)
    have hkey : ∀ x' ∈ W, (fderiv ℝ Ψ (F x')).comp (fderiv ℝ F x') = 0 := by
      intro x' hx'
      have hev : (Ψ ∘ F) =ᶠ[𝓝 x'] (fun _ => (0 : ℝ)) :=
        Filter.eventually_of_mem (hW.mem_nhds hx') (fun z hz => hΨ0 z hz)
      have h1 := hev.fderiv_eq (𝕜 := ℝ)
      rw [fderiv_comp x' (hΨd x' hx') (hFd x' hx')] at h1
      simpa using h1
    have hkey' : ∀ x' ∈ W, ∀ v : E2, fderiv ℝ Ψ (F x') (fderiv ℝ F x' v) = 0 := by
      intro x' hx' v
      have h := congrArg (fun L : E2 →L[ℝ] ℝ => L v) (hkey x' hx')
      simpa using h
    refine ⟨fun i => hkey' x hx (e2 i), fun i j => ?_⟩
    have hΨ2 : DifferentiableAt ℝ (fderiv ℝ Ψ) (F x) :=
      ((hΨ.contDiffAt (hU.mem_nhds hyU)).fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have hF2 : DifferentiableAt ℝ (fderiv ℝ F) x :=
      ((hF.contDiffAt (hW.mem_nhds hx)).fderiv_right (m := 1) h12).differentiableAt one_ne_zero
    have hc : HasFDerivAt (fun x' => fderiv ℝ Ψ (F x'))
        ((fderiv ℝ (fderiv ℝ Ψ) (F x)).comp (fderiv ℝ F x)) x :=
      hΨ2.hasFDerivAt.comp x (hFd x hx).hasFDerivAt
    have hu : DifferentiableAt ℝ (fun x' => fderiv ℝ F x' (e2 j)) x :=
      hF2.clm_apply (differentiableAt_const _)
    have hg := hc.clm_apply hu.hasFDerivAt
    have hg0 : (fun x' => fderiv ℝ Ψ (F x') (fderiv ℝ F x' (e2 j))) =ᶠ[𝓝 x]
        fun _ => (0 : ℝ) :=
      Filter.eventually_of_mem (hW.mem_nhds hx) (fun z hz => hkey' z hz (e2 j))
    have h2 := hg.fderiv
    rw [hg0.fderiv_eq (𝕜 := ℝ)] at h2
    have h3 := congrArg (fun L : E2 →L[ℝ] ℝ => L (e2 i)) h2
    simp only [fderiv_const_apply, ContinuousLinearMap.zero_apply,
      ContinuousLinearMap.add_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.flip_apply] at h3
    linarith
  
  have hlin : ∀ (a0 a1 a2 b0 b1 b2 x0 x1 x2 y0 y1 y2 : ℝ),
      (∀ w0 w1 : ℝ, w0 * a0 + w1 * b0 = 0 → w0 * a1 + w1 * b1 = 0 → w0 * a2 + w1 * b2 = 0 →
        w0 = 0 ∧ w1 = 0) →
      ¬ (x0 = 0 ∧ x1 = 0 ∧ x2 = 0) → ¬ (y0 = 0 ∧ y1 = 0 ∧ y2 = 0) →
      x0 * a0 + x1 * a1 + x2 * a2 = 0 → x0 * b0 + x1 * b1 + x2 * b2 = 0 →
      y0 * a0 + y1 * a1 + y2 * a2 = 0 → y0 * b0 + y1 * b1 + y2 * b2 = 0 →
      (∃ μ : ℝ, μ ≠ 0 ∧ y0 = μ * x0 ∧ y1 = μ * x1 ∧ y2 = μ * x2) ∧
      ∀ v0 v1 v2 : ℝ, x0 * v0 + x1 * v1 + x2 * v2 = 0 → ∃ w0 w1 : ℝ,
        v0 = w0 * a0 + w1 * b0 ∧ v1 = w0 * a1 + w1 * b1 ∧ v2 = w0 * a2 + w1 * b2 := by
    intro a0 a1 a2 b0 b1 b2 x0 x1 x2 y0 y1 y2 hind hx hy hxa hxb hya hyb
    obtain ⟨n0, hn0⟩ : ∃ t : ℝ, t = a1 * b2 - a2 * b1 := ⟨_, rfl⟩
    obtain ⟨n1, hn1⟩ : ∃ t : ℝ, t = a2 * b0 - a0 * b2 := ⟨_, rfl⟩
    obtain ⟨n2, hn2⟩ : ∃ t : ℝ, t = a0 * b1 - a1 * b0 := ⟨_, rfl⟩
    have hnn : n0 ^ 2 + n1 ^ 2 + n2 ^ 2 ≠ 0 := by
      intro h0
      have e0 : n0 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg n0, sq_nonneg n1, sq_nonneg n2])
      have e1 : n1 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg n0, sq_nonneg n1, sq_nonneg n2])
      have e2 : n2 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg n0, sq_nonneg n1, sq_nonneg n2])
      rw [hn0] at e0
      rw [hn1] at e1
      rw [hn2] at e2
      have k := hind (a0 * b0 + a1 * b1 + a2 * b2) (-(a0 ^ 2 + a1 ^ 2 + a2 ^ 2))
        (by linear_combination a1 * e2 - a2 * e1)
        (by linear_combination a2 * e0 - a0 * e2)
        (by linear_combination a0 * e1 - a1 * e0)
      have ha0 : a0 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg a0, sq_nonneg a1, sq_nonneg a2, k.2])
      have ha1 : a1 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg a0, sq_nonneg a1, sq_nonneg a2, k.2])
      have ha2 : a2 = 0 := (pow_eq_zero_iff two_ne_zero).mp
        (by nlinarith [sq_nonneg a0, sq_nonneg a1, sq_nonneg a2, k.2])
      have k2 := hind 1 0 (by rw [ha0]; ring) (by rw [ha1]; ring) (by rw [ha2]; ring)
      exact one_ne_zero k2.1
    have hBp : ∀ z0 z1 z2 : ℝ, z0 * a0 + z1 * a1 + z2 * a2 = 0 →
        z0 * b0 + z1 * b1 + z2 * b2 = 0 →
        (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z0 = (z0 * n0 + z1 * n1 + z2 * n2) * n0 ∧
        (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z1 = (z0 * n0 + z1 * n1 + z2 * n2) * n1 ∧
        (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z2 = (z0 * n0 + z1 * n1 + z2 * n2) * n2 := by
      intro z0 z1 z2 hza hzb
      refine ⟨?_, ?_, ?_⟩
      · have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z0 - (z0 * n0 + z1 * n1 + z2 * n2) * n0 =
            (b1 * n2 - b2 * n1) * (z0 * a0 + z1 * a1 + z2 * a2) -
              (a1 * n2 - a2 * n1) * (z0 * b0 + z1 * b1 + z2 * b2) := by
          subst hn0 hn1 hn2; ring
        rw [hza, hzb] at key; linarith
      · have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z1 - (z0 * n0 + z1 * n1 + z2 * n2) * n1 =
            (b2 * n0 - b0 * n2) * (z0 * a0 + z1 * a1 + z2 * a2) -
              (a2 * n0 - a0 * n2) * (z0 * b0 + z1 * b1 + z2 * b2) := by
          subst hn0 hn1 hn2; ring
        rw [hza, hzb] at key; linarith
      · have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * z2 - (z0 * n0 + z1 * n1 + z2 * n2) * n2 =
            (b0 * n1 - b1 * n0) * (z0 * a0 + z1 * a1 + z2 * a2) -
              (a0 * n1 - a1 * n0) * (z0 * b0 + z1 * b1 + z2 * b2) := by
          subst hn0 hn1 hn2; ring
        rw [hza, hzb] at key; linarith
    obtain ⟨hx0, hx1, hx2⟩ := hBp x0 x1 x2 hxa hxb
    obtain ⟨hy0, hy1, hy2⟩ := hBp y0 y1 y2 hya hyb
    have hxn : x0 * n0 + x1 * n1 + x2 * n2 ≠ 0 := by
      intro h
      rw [h, zero_mul] at hx0 hx1 hx2
      exact hx ⟨(mul_eq_zero.mp hx0).resolve_left hnn, (mul_eq_zero.mp hx1).resolve_left hnn,
        (mul_eq_zero.mp hx2).resolve_left hnn⟩
    have hyn : y0 * n0 + y1 * n1 + y2 * n2 ≠ 0 := by
      intro h
      rw [h, zero_mul] at hy0 hy1 hy2
      exact hy ⟨(mul_eq_zero.mp hy0).resolve_left hnn, (mul_eq_zero.mp hy1).resolve_left hnn,
        (mul_eq_zero.mp hy2).resolve_left hnn⟩
    refine ⟨⟨(y0 * n0 + y1 * n1 + y2 * n2) / (x0 * n0 + x1 * n1 + x2 * n2),
      div_ne_zero hyn hxn, ?_, ?_, ?_⟩, ?_⟩
    · rw [div_mul_eq_mul_div, eq_div_iff hxn]
      apply mul_left_cancel₀ hnn
      linear_combination (x0 * n0 + x1 * n1 + x2 * n2) * hy0 -
        (y0 * n0 + y1 * n1 + y2 * n2) * hx0
    · rw [div_mul_eq_mul_div, eq_div_iff hxn]
      apply mul_left_cancel₀ hnn
      linear_combination (x0 * n0 + x1 * n1 + x2 * n2) * hy1 -
        (y0 * n0 + y1 * n1 + y2 * n2) * hx1
    · rw [div_mul_eq_mul_div, eq_div_iff hxn]
      apply mul_left_cancel₀ hnn
      linear_combination (x0 * n0 + x1 * n1 + x2 * n2) * hy2 -
        (y0 * n0 + y1 * n1 + y2 * n2) * hx2
    · intro v0 v1 v2 hv
      have hnv : v0 * n0 + v1 * n1 + v2 * n2 = 0 := by
        have h : (x0 * n0 + x1 * n1 + x2 * n2) * (v0 * n0 + v1 * n1 + v2 * n2) = 0 := by
          linear_combination (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * hv - v0 * hx0 - v1 * hx1 - v2 * hx2
        exact (mul_eq_zero.mp h).resolve_left hxn
      refine ⟨((v1 * b2 - v2 * b1) * n0 + (v2 * b0 - v0 * b2) * n1 + (v0 * b1 - v1 * b0) * n2) /
          (n0 ^ 2 + n1 ^ 2 + n2 ^ 2),
        ((a1 * v2 - a2 * v1) * n0 + (a2 * v0 - a0 * v2) * n1 + (a0 * v1 - a1 * v0) * n2) /
          (n0 ^ 2 + n1 ^ 2 + n2 ^ 2), ?_, ?_, ?_⟩
      · rw [div_mul_eq_mul_div, div_mul_eq_mul_div, div_add_div_same, eq_div_iff hnn]
        have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * v0 =
            ((v1 * b2 - v2 * b1) * n0 + (v2 * b0 - v0 * b2) * n1 + (v0 * b1 - v1 * b0) * n2) * a0 +
            ((a1 * v2 - a2 * v1) * n0 + (a2 * v0 - a0 * v2) * n1 + (a0 * v1 - a1 * v0) * n2) * b0 +
            (v0 * n0 + v1 * n1 + v2 * n2) * n0 := by
          subst hn0 hn1 hn2; ring
        rw [hnv] at key; linarith
      · rw [div_mul_eq_mul_div, div_mul_eq_mul_div, div_add_div_same, eq_div_iff hnn]
        have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * v1 =
            ((v1 * b2 - v2 * b1) * n0 + (v2 * b0 - v0 * b2) * n1 + (v0 * b1 - v1 * b0) * n2) * a1 +
            ((a1 * v2 - a2 * v1) * n0 + (a2 * v0 - a0 * v2) * n1 + (a0 * v1 - a1 * v0) * n2) * b1 +
            (v0 * n0 + v1 * n1 + v2 * n2) * n1 := by
          subst hn0 hn1 hn2; ring
        rw [hnv] at key; linarith
      · rw [div_mul_eq_mul_div, div_mul_eq_mul_div, div_add_div_same, eq_div_iff hnn]
        have key : (n0 ^ 2 + n1 ^ 2 + n2 ^ 2) * v2 =
            ((v1 * b2 - v2 * b1) * n0 + (v2 * b0 - v0 * b2) * n1 + (v0 * b1 - v1 * b0) * n2) * a2 +
            ((a1 * v2 - a2 * v1) * n0 + (a2 * v0 - a0 * v2) * n1 + (a0 * v1 - a1 * v0) * n2) * b2 +
            (v0 * n0 + v1 * n1 + v2 * n2) * n2 := by
          subst hn0 hn1 hn2; ring
        rw [hnv] at key; linarith
  
  have hfo : ∀ (Ψ : E3 → ℝ) (u : E3), fderiv ℝ Ψ (F x) u =
      u 0 * partialDeriv 0 Ψ (F x) + u 1 * partialDeriv 1 Ψ (F x) +
        u 2 * partialDeriv 2 Ψ (F x) := by
    intro Ψ u
    rw [hL (fderiv ℝ Ψ (F x)) u, Fin.sum_univ_three]
    rfl
  have hso : ∀ Ψ : E3 → ℝ, ContDiffOn ℝ ∞ Ψ U → ∀ u v : E3,
      fderiv ℝ (fderiv ℝ Ψ) (F x) u v =
        ∑ a : Fin 3, ∑ b : Fin 3, u a * v b * partialDeriv a (partialDeriv b Ψ) (F x) := by
    intro Ψ hΨ u v
    rw [hB]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    rw [(hsecond Ψ hΨ a b).1]
  have hjΦ := hjet Φ hΦ (fun x' h => (hFW x' h).2.1)
  have hjΦ' := hjet Φ' hΦ' (fun x' h => (hFW x' h).2.2.1)
  
  have hxa : partialDeriv 0 Φ (F x) * fderiv ℝ F x (e2 0) 0 +
      partialDeriv 1 Φ (F x) * fderiv ℝ F x (e2 0) 1 +
      partialDeriv 2 Φ (F x) * fderiv ℝ F x (e2 0) 2 = 0 := by
    have h := hjΦ.1 0; rw [hfo] at h; linear_combination h
  have hxb : partialDeriv 0 Φ (F x) * fderiv ℝ F x (e2 1) 0 +
      partialDeriv 1 Φ (F x) * fderiv ℝ F x (e2 1) 1 +
      partialDeriv 2 Φ (F x) * fderiv ℝ F x (e2 1) 2 = 0 := by
    have h := hjΦ.1 1; rw [hfo] at h; linear_combination h
  have hya : partialDeriv 0 Φ' (F x) * fderiv ℝ F x (e2 0) 0 +
      partialDeriv 1 Φ' (F x) * fderiv ℝ F x (e2 0) 1 +
      partialDeriv 2 Φ' (F x) * fderiv ℝ F x (e2 0) 2 = 0 := by
    have h := hjΦ'.1 0; rw [hfo] at h; linear_combination h
  have hyb : partialDeriv 0 Φ' (F x) * fderiv ℝ F x (e2 1) 0 +
      partialDeriv 1 Φ' (F x) * fderiv ℝ F x (e2 1) 1 +
      partialDeriv 2 Φ' (F x) * fderiv ℝ F x (e2 1) 2 = 0 := by
    have h := hjΦ'.1 1; rw [hfo] at h; linear_combination h
  
  have hgne : ∀ Ψ : E3 → ℝ, fderiv ℝ Ψ (F x) ≠ 0 →
      ¬ (partialDeriv 0 Ψ (F x) = 0 ∧ partialDeriv 1 Ψ (F x) = 0 ∧
        partialDeriv 2 Ψ (F x) = 0) := by
    rintro Ψ hne ⟨h0, h1, h2⟩
    apply hne
    refine ContinuousLinearMap.ext fun u => ?_
    rw [hfo, h0, h1, h2]
    simp
  
  have hind : ∀ w0 w1 : ℝ, w0 * fderiv ℝ F x (e2 0) 0 + w1 * fderiv ℝ F x (e2 1) 0 = 0 →
      w0 * fderiv ℝ F x (e2 0) 1 + w1 * fderiv ℝ F x (e2 1) 1 = 0 →
      w0 * fderiv ℝ F x (e2 0) 2 + w1 * fderiv ℝ F x (e2 1) 2 = 0 → w0 = 0 ∧ w1 = 0 := by
    intro w0 w1 h0 h1 h2
    have hzero : fderiv ℝ F x (w0 • e2 0 + w1 • e2 1) = fderiv ℝ F x 0 := by
      rw [map_zero, map_add, map_smul, map_smul]
      ext k
      fin_cases k
      · simpa using h0
      · simpa using h1
      · simpa using h2
    have ht := hinj hzero
    have ht0 := congrArg (fun t : E2 => t 0) ht
    have ht1 := congrArg (fun t : E2 => t 1) ht
    simp at ht0 ht1
    exact ⟨ht0, ht1⟩
  obtain ⟨⟨μ, hμ0, hg0, hg1, hg2⟩, hker⟩ := hlin _ _ _ _ _ _ _ _ _ _ _ _ hind
    (hgne Φ (hdΦ _ hyU)) (hgne Φ' (hdΦ' _ hyU)) hxa hxb hya hyb
  have hgrad : ∀ k : Fin 3, partialDeriv k Φ' (F x) = μ * partialDeriv k Φ (F x) := by
    intro k
    fin_cases k
    exacts [hg0, hg1, hg2]
  have hξ : (fun k : Fin 3 => partialDeriv k Φ (F x)) ≠ 0 := by
    intro h
    exact hgne Φ (hdΦ _ hyU) ⟨congrFun h 0, congrFun h 1, congrFun h 2⟩
  
  have hC : ∀ a b : Fin 3, hessLoc G Φ' a b (F x) - μ * hessLoc G Φ a b (F x) =
      partialDeriv a (partialDeriv b Φ') (F x) - μ * partialDeriv a (partialDeriv b Φ) (F x) := by
    intro a b
    simp only [hessLoc, Fin.sum_univ_three, hgrad]
    ring
  have hDsymm : ∀ i j : Fin 3, hessLoc G Φ' i j (F x) - μ * hessLoc G Φ i j (F x) =
      hessLoc G Φ' j i (F x) - μ * hessLoc G Φ j i (F x) := by
    intro i j
    rw [hC, hC, (hsecond Φ' hΦ' i j).2, (hsecond Φ hΦ i j).2]
  
  have hT : ∀ p q : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3,
      fderiv ℝ F x (e2 p) a * fderiv ℝ F x (e2 q) b *
        (partialDeriv a (partialDeriv b Φ') (F x) - μ * partialDeriv a (partialDeriv b Φ) (F x))
        = 0 := by
    intro p q
    have h1 := hjΦ.2 p q
    have h2 := hjΦ'.2 p q
    rw [hso Φ hΦ, hfo Φ] at h1
    rw [hso Φ' hΦ', hfo Φ', hg0, hg1, hg2] at h2
    simp only [Fin.sum_univ_three] at h1 h2 ⊢
    linear_combination h2 - μ * h1
  have hD : ∀ v : Fin 3 → ℝ, ∑ k : Fin 3, partialDeriv k Φ (F x) * v k = 0 →
      ∑ i : Fin 3, ∑ j : Fin 3, v i * v j *
        (hessLoc G Φ' i j (F x) - μ * hessLoc G Φ i j (F x)) = 0 := by
    intro v hv
    simp only [Fin.sum_univ_three] at hv
    obtain ⟨w0, w1, hv0, hv1, hv2⟩ := hker (v 0) (v 1) (v 2) hv
    have T00 := hT 0 0
    have T01 := hT 0 1
    have T10 := hT 1 0
    have T11 := hT 1 1
    simp only [Fin.sum_univ_three] at T00 T01 T10 T11
    simp only [hC, Fin.sum_univ_three]
    rw [hv0, hv1, hv2]
    linear_combination (w0 * w0) * T00 + (w0 * w1) * T01 + (w1 * w0) * T10 + (w1 * w1) * T11
  
  have hN : ∀ a : Fin 3, ejpN G Φ' (F x) a = μ * ejpN G Φ (F x) a := by
    intro a
    simp only [ejpN, Fin.sum_univ_three, hgrad]
    ring
  have hS : ejpS G Φ' (F x) = μ ^ 2 * ejpS G Φ (F x) := by
    simp only [ejpS, Fin.sum_univ_three, hgrad]
    ring
  have hRic : ejpRic G Φ' (F x) = ejpRic G Φ (F x) := by
    unfold ejpRic
    rw [hS]
    simp only [hN]
    rw [show (∑ j : Fin 3, ∑ k : Fin 3, ricci G j k (F x) * (μ * ejpN G Φ (F x) j) *
        (μ * ejpN G Φ (F x) k)) = μ ^ 2 * ∑ j : Fin 3, ∑ k : Fin 3,
          ricci G j k (F x) * ejpN G Φ (F x) j * ejpN G Φ (F x) k by
      simp only [Fin.sum_univ_three]; ring]
    exact mul_div_mul_left _ _ (pow_ne_zero 2 hμ0)
  unfold ejpPot
  rw [secondFundSq_congr_scale G Φ Φ' (F x) μ (hpos _ hyU) hξ hμ0 hgrad hDsymm hD, hRic]

theorem ejp_chart_transfer [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (f : M → ℝ) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z).target ∧ ∀ x ∈ (chartAt E3 z).source, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0 → fderiv ℝ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z x) ≠ 0 ∧ g.gradInner f f x = ejpS (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z x) ∧ g.jacobiDeriv f x = ejpJac (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z x) :=
by
  
  have hu : ∀ u : E3, u = ∑ d : Fin 3, u d • e d := by
    intro u
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr u]
    simp [EuclideanSpace.basisFun_apply]
  have hcomp_e : ∀ v : Fin 3 → ℝ, ∀ a : Fin 3, (∑ i : Fin 3, v i • e i) a = v a := by
    intro v a
    simp [Pi.single_apply]
  have hcompo : ∀ (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z → ∀ l d : Fin 3,
      partialDeriv l (fun v => ψ v d) z = (fderiv ℝ ψ z (e l)) d := by
    intro ψ z hψ l d
    have hfun : (fun v => ψ v d) = (EuclideanSpace.proj d : E3 →L[ℝ] ℝ) ∘ ψ := by
      funext v; simp
    rw [partialDeriv, hfun, fderiv_comp z (EuclideanSpace.proj d).differentiableAt hψ,
      ContinuousLinearMap.fderiv]
    simp
  have pd_comp : ∀ (F : E3 → ℝ) (ψ : E3 → E3) (z : E3), DifferentiableAt ℝ ψ z →
      DifferentiableAt ℝ F (ψ z) → ∀ l : Fin 3,
      partialDeriv l (fun w => F (ψ w)) z
        = ∑ d : Fin 3, partialDeriv d F (ψ z) * partialDeriv l (fun v => ψ v d) z := by
    intro F ψ z hψ hF l
    have h1 : partialDeriv l (fun w => F (ψ w)) z = fderiv ℝ F (ψ z) (fderiv ℝ ψ z (e l)) := by
      show fderiv ℝ (F ∘ ψ) z (e l) = _
      rw [fderiv_comp z hF hψ]
      rfl
    rw [h1, hu (fderiv ℝ ψ z (e l)), map_sum]
    simp only [map_smul, smul_eq_mul, hcompo ψ z hψ]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  
  have bil_alg : ∀ (A Gm Gt : Matrix (Fin 3) (Fin 3) ℝ) (P Q Pt Qt : Fin 3 → ℝ), A.det ≠ 0 →
      (∀ i j, Gt i j = ∑ a : Fin 3, ∑ b : Fin 3, A a i * Gm a b * A b j) →
      (∀ i, Pt i = ∑ a : Fin 3, P a * A a i) → (∀ j, Qt j = ∑ b : Fin 3, Q b * A b j) →
      ∑ i : Fin 3, ∑ j : Fin 3, Gt⁻¹ i j * Pt i * Qt j =
        ∑ a : Fin 3, ∑ b : Fin 3, Gm⁻¹ a b * P a * Q b := by
    intro A Gm Gt P Q Pt Qt hA hGt hPt hQt
    have hAu : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
    have hGt' : Gt = Matrix.transpose A * Gm * A := by
      ext i j
      rw [hGt]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
    have hGtinv : Gt⁻¹ = A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹ := by
      rw [hGt', Matrix.mul_inv_rev, Matrix.mul_inv_rev, Matrix.transpose_nonsing_inv]
      exact (mul_assoc _ _ _).symm
    have hM : A * Gt⁻¹ * Matrix.transpose A = Gm⁻¹ := by
      rw [hGtinv]
      calc A * (A⁻¹ * Gm⁻¹ * Matrix.transpose A⁻¹) * Matrix.transpose A
          = (A * A⁻¹) * Gm⁻¹ * (Matrix.transpose A⁻¹ * Matrix.transpose A) := by
            simp only [Matrix.mul_assoc]
        _ = Gm⁻¹ := by
            rw [hAB, ← Matrix.transpose_mul, hAB, Matrix.transpose_one, Matrix.one_mul,
              Matrix.mul_one]
    have hM' : ∀ a b, ∑ i : Fin 3, ∑ j : Fin 3, A a i * Gt⁻¹ i j * A b j = Gm⁻¹ a b := by
      intro a b
      rw [← hM]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
      rw [Finset.sum_comm]
    simp only [hPt, hQt, ← hM']
    simp only [Fin.sum_univ_three]
    ring
  
  have pair : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (u w : M → ℝ) (x : E3),
      x ∈ Φ.source → g.gradInner u w (Φ x) = ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff Φ x)⁻¹ i j * partialDeriv i (fun y => u (Φ y)) x *
          partialDeriv j (fun y => w (Φ y)) x := by
    intro Φ u w x hx
    have h2 : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) ∧
        ContDiffOn ℝ ∞ (fun w => chartAt E3 (Φ x) (Φ w))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source) := by
      have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
      refine ⟨hΦ.continuousOn.isOpen_inter_preimage Φ.open_source
        (chartAt E3 (Φ x)).open_source, ?_⟩
      have hc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (Φ x))
          (chartAt E3 (Φ x)).source := contMDiffOn_chart
      have hcomp := hc.comp (hΦ.mono Set.inter_subset_left) (fun w hw => hw.2)
      exact contMDiffOn_iff_contDiffOn.mp hcomp
    have hxU : x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source :=
      ⟨hx, mem_chart_source E3 (Φ x)⟩
    have hψd : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
        DifferentiableAt ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z := fun z hz =>
      (h2.2.contDiffAt (h2.1.mem_nhds hz)).differentiableAt (by simp)
    have hM1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))).comp
            (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z) := by
      intro z hz
      have hev : (Φ : E3 → M) =ᶠ[𝓝 z]
          ((chartAt E3 (Φ x)).symm ∘ (fun w => chartAt E3 (Φ x) (Φ w))) := by
        filter_upwards [h2.1.mem_nhds hz] with w hw
        exact ((chartAt E3 (Φ x)).left_inv hw.2).symm
      rw [hev.mfderiv_eq, mfderiv_comp z
        (mdifferentiableAt_atlas_symm (chart_mem_atlas E3 (Φ x))
          ((chartAt E3 (Φ x)).map_source hz.2)) (hψd z hz).mdifferentiableAt, mfderiv_eq_fderiv]
    have hM1' : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ u : E3,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))
            (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
      intro z hz u
      rw [hM1 z hz]
      rfl
    
    have s1 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source, ∀ i j : Fin 3,
        g.coeff Φ z i j = ∑ a : Fin 3, ∑ b : Fin 3,
          partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z *
            g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b *
              partialDeriv j (fun w => chartAt E3 (Φ x) (Φ w) b) z := by
      intro z hz i j
      have hq : (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) = Φ z :=
        (chartAt E3 (Φ x)).left_inv hz.2
      have hgq : g.g ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z))) = g.g (Φ z) :=
        congrArg g.g hq
      obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
          D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) :=
        ⟨_, rfl⟩
      have hΦD : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u =
          D (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z u) := by
        intro u
        rw [hM1' z hz u, hD]
        rfl
      have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ z)) a b
          = g.g (Φ z) (D (e a)) (D (e b)) := by
        intro a b
        rw [← hgq, hD]
        rfl
      have hJ : ∀ k : Fin 3, fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k)
          = ∑ d : Fin 3, partialDeriv k (fun w => chartAt E3 (Φ x) (Φ w) d) z • e d := by
        intro k
        rw [hu (fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (e k))]
        simp only [hcompo _ z (hψd z hz)]
      simp only [hcD]
      show g.g (Φ z) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z (e j)) = _
      rw [hΦD, hΦD, hJ i, hJ j]
      simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul]
      simp only [Fin.sum_univ_three]
      ring
    
    have s3 : ∀ z ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x)).source,
        (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w => chartAt E3 (Φ x) (Φ w) a) z).det
          ≠ 0 := by
      intro z hz hdet
      obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
      have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ hz.1
      have hinj : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ z u = 0 → u = 0 := by
        intro u hu0
        rw [← hloc.mfderivToContinuousLinearEquiv_coe (by simp)] at hu0
        exact (hloc.mfderivToContinuousLinearEquiv (by simp)).map_eq_zero_iff.mp hu0
      have hw : fderiv ℝ (fun w => chartAt E3 (Φ x) (Φ w)) z (∑ i : Fin 3, v i • e i) = 0 := by
        ext a
        rw [map_sum]
        simp only [map_smul]
        have := congrFun hJv a
        simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
          hcompo _ z (hψd z hz)] at this
        simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
          WithLp.ofLp_zero, Pi.zero_apply]
        rw [← this]
        apply Finset.sum_congr rfl
        intro i _
        ring
      have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
        apply hinj
        rw [hM1' z hz, hw]
        exact ContinuousLinearMap.map_zero _
      apply hv0
      funext a
      rw [← hcomp_e v a, h0]
      rfl
    
    have hVo : IsOpen ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target) :=
      (chartAt E3 (Φ x)).continuousOn_symm.isOpen_inter_preimage (chartAt E3 (Φ x)).open_target
        Φ.open_target
    have hσ : ContDiffOn ℝ ∞ (fun v => Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v))
        ((chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target) := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ.toPartialEquiv.symm Φ.target :=
        Φ.contMDiffOn_invFun
      have h3 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (chartAt E3 (Φ x)).symm
          (chartAt E3 (Φ x)).target := contMDiffOn_chart_symm
      have hcomp := h1.comp (h3.mono Set.inter_subset_left) (fun v hv => hv.2)
      exact contMDiffOn_iff_contDiffOn.mp hcomp
    have hyV : chartAt E3 (Φ x) (Φ x) ∈
        (chartAt E3 (Φ x)).target ∩ (chartAt E3 (Φ x)).symm ⁻¹' Φ.target := by
      refine ⟨(chartAt E3 (Φ x)).map_source (mem_chart_source E3 (Φ x)), ?_⟩
      show (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)) ∈ Φ.target
      rw [(chartAt E3 (Φ x)).left_inv (mem_chart_source E3 (Φ x))]
      exact Φ.toPartialEquiv.map_source hx
    have hσy : Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x))) = x := by
      rw [(chartAt E3 (Φ x)).left_inv (mem_chart_source E3 (Φ x))]
      exact Φ.toPartialEquiv.left_inv hx
    have hσd : DifferentiableAt ℝ (fun v => Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v))
        (chartAt E3 (Φ x) (Φ x)) :=
      (hσ.contDiffAt (hVo.mem_nhds hyV)).differentiableAt (by simp)
    
    have chain : ∀ (u0 : M → ℝ) (j : Fin 3), partialDeriv j (fun y => u0 (Φ y)) x =
        ∑ a : Fin 3, partialDeriv a (fun v => u0 ((chartAt E3 (Φ x)).symm v))
            (chartAt E3 (Φ x) (Φ x)) *
          partialDeriv j (fun w' => chartAt E3 (Φ x) (Φ w') a) x := by
      intro u0 j
      by_cases hd : DifferentiableAt ℝ (fun v => u0 ((chartAt E3 (Φ x)).symm v))
          (chartAt E3 (Φ x) (Φ x))
      · have hev : (fun y => u0 (Φ y)) =ᶠ[𝓝 x]
            (fun y => (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ y))) := by
          filter_upwards [h2.1.mem_nhds hxU] with y hy
          show u0 (Φ y) = u0 ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ y)))
          rw [(chartAt E3 (Φ x)).left_inv hy.2]
        have e1 : partialDeriv j (fun y => u0 (Φ y)) x = partialDeriv j
            (fun y => (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ y))) x := by
          unfold partialDeriv
          rw [hev.fderiv_eq]
        rw [e1]
        exact pd_comp _ (fun w' => chartAt E3 (Φ x) (Φ w')) x (hψd x hxU) hd j
      · have hnd : ¬ DifferentiableAt ℝ (fun y => u0 (Φ y)) x := by
          intro hdx
          apply hd
          have hdx' : DifferentiableAt ℝ (fun y => u0 (Φ y))
              (Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)))) := by
            rw [hσy]; exact hdx
          have hc := hdx'.comp (chartAt E3 (Φ x) (Φ x)) hσd
          refine hc.congr_of_eventuallyEq ?_
          filter_upwards [hVo.mem_nhds hyV] with v hv
          have hr := Φ.toPartialEquiv.right_inv hv.2
          show u0 ((chartAt E3 (Φ x)).symm v) =
            u0 (Φ (Φ.toPartialEquiv.symm ((chartAt E3 (Φ x)).symm v)))
          exact congrArg u0 hr.symm
        have e1 : fderiv ℝ (fun y => u0 (Φ y)) x = 0 := fderiv_zero_of_not_differentiableAt hnd
        have e2 : fderiv ℝ (fun v => u0 ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) = 0 :=
          fderiv_zero_of_not_differentiableAt hd
        simp only [partialDeriv, e1, e2, ContinuousLinearMap.zero_apply, zero_mul,
          Finset.sum_const_zero]
    have halg := bil_alg
      (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w' => chartAt E3 (Φ x) (Φ w') a) x)
      (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x))) (g.coeff Φ x)
      (fun a => partialDeriv a (fun v => u ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)))
      (fun b => partialDeriv b (fun v => w ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)))
      (fun i => partialDeriv i (fun y => u (Φ y)) x)
      (fun j => partialDeriv j (fun y => w (Φ y)) x)
      (s3 x hxU) (fun i j => s1 x hxU i j) (fun i => chain u i) (fun j => chain w j)
    have hL : g.gradInner u w (Φ x) = ∑ a : Fin 3, ∑ b : Fin 3,
        (g.coeff (chartAt E3 (Φ x)).symm (chartAt E3 (Φ x) (Φ x)))⁻¹ a b *
          partialDeriv a (fun v => u ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) *
          partialDeriv b (fun v => w ((chartAt E3 (Φ x)).symm v)) (chartAt E3 (Φ x) (Φ x)) := rfl
    rw [hL]
    exact halg.symm
  
  have hchart : ∀ q : M, ∃ Ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      Ψ.source = (chartAt E3 q).target ∧ ∀ y : E3, Ψ y = (chartAt E3 q).symm y := by
    intro q
    exact ⟨⟨(chartAt E3 q).symm.toPartialEquiv, (chartAt E3 q).open_target,
      (chartAt E3 q).open_source, contMDiffOn_chart_symm, contMDiffOn_chart⟩, rfl, fun y => rfl⟩
  
  have transfer : ∀ x ∈ (chartAt E3 z).source, ∀ u w : M → ℝ,
      g.gradInner u w x = ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 z).symm (chartAt E3 z x))⁻¹ i j *
          partialDeriv i (fun v => u ((chartAt E3 z).symm v)) (chartAt E3 z x) *
          partialDeriv j (fun v => w ((chartAt E3 z).symm v)) (chartAt E3 z x) := by
    intro x hx u w
    obtain ⟨Ψ, hsrc, hΨ⟩ := hchart z
    have hfun : (⇑Ψ : E3 → M) = (chartAt E3 z).symm := funext hΨ
    have hy : chartAt E3 z x ∈ Ψ.source := by
      rw [hsrc]; exact (chartAt E3 z).map_source hx
    have h1 := pair Ψ u w _ hy
    rw [hfun, (chartAt E3 z).left_inv hx] at h1
    exact h1
  
  have hlmc : ∀ q : M, ∀ v ∈ (chartAt E3 q).target,
      g.levelMeanCurv f ((chartAt E3 q).symm v) =
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun y => f ((chartAt E3 q).symm y)) v := by
    intro q v hv
    obtain ⟨Ψ, hsrc, hΨ⟩ := hchart q
    have hfun : (⇑Ψ : E3 → M) = (chartAt E3 q).symm := funext hΨ
    have hvs : v ∈ Ψ.source := by rw [hsrc]; exact hv
    have h1 := levelMeanCurv_eq_coord g Ψ f (fun y => f ((chartAt E3 q).symm y)) hf v hvs
      (Filter.Eventually.of_forall (fun z' => by rw [hΨ]))
    rw [hfun] at h1
    exact h1
  have hpdH : ∀ q : M, ∀ v ∈ (chartAt E3 q).target, ∀ i : Fin 3,
      partialDeriv i (levelMeanCurvCoord (g.coeff (chartAt E3 q).symm)
          (fun y => f ((chartAt E3 q).symm y))) v =
        partialDeriv i (fun y => g.levelMeanCurv f ((chartAt E3 q).symm y)) v := by
    intro q v hv i
    have hev : (fun y => g.levelMeanCurv f ((chartAt E3 q).symm y)) =ᶠ[𝓝 v]
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun y => f ((chartAt E3 q).symm y)) := by
      filter_upwards [(chartAt E3 q).open_target.mem_nhds hv] with y hy
      exact hlmc q y hy
    unfold partialDeriv
    rw [hev.fderiv_eq]
  
  have hA : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z).target := by
    have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 z).symm) (chartAt E3 z).target :=
      hf.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp this
  refine ⟨hA, ?_⟩
  intro x hx hdf
  
  have hB2 := transfer x hx f f
  
  have hB1 : fderiv ℝ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z x) ≠ 0 := by
    intro h0
    have hzero : g.gradInner f f x = 0 := by
      rw [hB2]
      simp only [partialDeriv, h0, ContinuousLinearMap.zero_apply, mul_zero,
        Finset.sum_const_zero]
    have hL : fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) =
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x : E3 →L[ℝ] ℝ) := by
      have hmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x :=
        hf.contMDiffAt.mdifferentiableAt (by simp)
      rw [hmd.mfderiv]
      simp [writtenInExtChartAt]
      rfl
    have hLne : fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) ≠ 0 := by
      rw [hL]; exact hdf
    have hPD := coeff_chart_symm_posDef g x (chartAt E3 x x)
      ((chartAt E3 x).map_source (mem_chart_source E3 x))
    have hv : (fun i : Fin 3 =>
        fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) (e i)) ≠ 0 := by
      intro hv0
      apply hLne
      ext1 u
      rw [hu u, map_sum]
      have h0' : ∀ i : Fin 3,
          fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) (e i) = 0 :=
        fun i => congrFun hv0 i
      simp [map_smul, h0']
    have h1 := hPD.inv.dotProduct_mulVec_pos hv
    have h3 : g.gradInner f f x =
        dotProduct (star (fun i : Fin 3 =>
          fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) (e i)))
        (Matrix.mulVec (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ (fun i : Fin 3 =>
          fderiv ℝ (fun y => f ((chartAt E3 x).symm y)) (chartAt E3 x x) (e i))) := by
      show ∑ i : Fin 3, ∑ j : Fin 3, _ = _
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      simp only [partialDeriv]
      ring
    rw [← h3, hzero] at h1
    exact lt_irrefl _ h1
  
  have hB3 : g.jacobiDeriv f x = ejpJac (g.coeff (chartAt E3 z).symm)
      (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z x) := by
    have hJ : g.jacobiDeriv f x = g.gradInner (g.levelMeanCurv f) f x := by
      simp only [RiemannianMetric3.jacobiDeriv, RiemannianMetric3.gradInner,
        hpdH x (chartAt E3 x x) ((chartAt E3 x).map_source (mem_chart_source E3 x))]
    rw [hJ, transfer x hx]
    simp only [ejpJac, hpdH z (chartAt E3 z x) ((chartAt E3 z).map_source hx)]
  exact ⟨hB1, hB2, hB3⟩

theorem ejp_chart_reparam [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z q : M) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFW : ∀ x ∈ W, F x ∈ (chartAt E3 z).target ∧ (chartAt E3 z).symm (F x) ∈ (chartAt E3 q).source ∧ Function.Injective (fderiv ℝ F x)) : ContDiffOn ℝ ∞ (fun x => chartAt E3 q ((chartAt E3 z).symm (F x))) W ∧ (∀ x ∈ W, Function.Injective (fderiv ℝ (fun x' => chartAt E3 q ((chartAt E3 z).symm (F x'))) x)) ∧ ∀ x ∈ W, pullMetric2 (g.coeff (chartAt E3 z).symm) F x = pullMetric2 (g.coeff (chartAt E3 q).symm) (fun x' => chartAt E3 q ((chartAt E3 z).symm (F x'))) x :=
by
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    ext k
    simp [EuclideanSpace.single_apply, Pi.single_apply]
  
  have hquad : ∀ (φ : E3 → M) (y v w : E3),
      ∑ k : Fin 3, ∑ l : Fin 3, v k * g.coeff φ y k l * w l =
        g.g (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y v) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y w) := by
    intro φ y v w
    conv_rhs => rw [hexp v, hexp w]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, Finset.mul_sum]
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    ring
  
  have htrans : ∀ a b : M, ContDiffOn ℝ ∞ (fun w => chartAt E3 b ((chartAt E3 a).symm w))
      ((chartAt E3 a).target ∩ (chartAt E3 a).symm ⁻¹' (chartAt E3 b).source) := by
    intro a b
    have h₃ := (contMDiffOn_chart (x := b) (I := 𝓘(ℝ, E3)) (n := ∞)).comp
      ((contMDiffOn_chart_symm (x := a) (I := 𝓘(ℝ, E3)) (n := ∞)).mono Set.inter_subset_left)
      (fun w hw => hw.2)
    exact contMDiffOn_iff_contDiffOn.mp h₃
  have hΩo : IsOpen ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' (chartAt E3 q).source) :=
    (chartAt E3 z).isOpen_inter_preimage_symm (chartAt E3 q).open_source
  have hΩ'o : IsOpen ((chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 z).source) :=
    (chartAt E3 q).isOpen_inter_preimage_symm (chartAt E3 z).open_source
  have hmaps : Set.MapsTo F W
      ((chartAt E3 z).target ∩ (chartAt E3 z).symm ⁻¹' (chartAt E3 q).source) :=
    fun x hx => ⟨(hFW x hx).1, (hFW x hx).2.1⟩
  have hτd : ∀ x ∈ W, DifferentiableAt ℝ (fun w => chartAt E3 q ((chartAt E3 z).symm w)) (F x) :=
    fun x hx => ((htrans z q).differentiableOn (by simp)).differentiableAt
      (hΩo.mem_nhds (hmaps hx))
  have hFd : ∀ x ∈ W, DifferentiableAt ℝ F x :=
    fun x hx => (hF.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hx)
  have hchain : ∀ x ∈ W, fderiv ℝ (fun x' => chartAt E3 q ((chartAt E3 z).symm (F x'))) x =
      (fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 z).symm w)) (F x)).comp (fderiv ℝ F x) :=
    fun x hx => fderiv_comp' x (hτd x hx) (hFd x hx)
  refine ⟨(htrans z q).comp hF hmaps, ?_, ?_⟩
  · intro x hx
    have hy := hmaps hx
    have hτy : chartAt E3 q ((chartAt E3 z).symm (F x)) ∈
        (chartAt E3 q).target ∩ (chartAt E3 q).symm ⁻¹' (chartAt E3 z).source := by
      refine ⟨(chartAt E3 q).map_source hy.2, ?_⟩
      show (chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm (F x))) ∈ (chartAt E3 z).source
      rw [(chartAt E3 q).left_inv hy.2]
      exact (chartAt E3 z).map_target hy.1
    have hσd : DifferentiableAt ℝ (fun v => chartAt E3 z ((chartAt E3 q).symm v))
        (chartAt E3 q ((chartAt E3 z).symm (F x))) :=
      ((htrans q z).differentiableOn (by simp)).differentiableAt (hΩ'o.mem_nhds hτy)
    have hev : (fun w => chartAt E3 z ((chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm w))))
        =ᶠ[𝓝 (F x)] id := by
      filter_upwards [hΩo.mem_nhds hy] with w hw
      show chartAt E3 z ((chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm w))) = w
      rw [(chartAt E3 q).left_inv hw.2, (chartAt E3 z).right_inv hw.1]
    have hcomp : fderiv ℝ
        (fun w => chartAt E3 z ((chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm w)))) (F x) =
        (fderiv ℝ (fun v => chartAt E3 z ((chartAt E3 q).symm v))
          (chartAt E3 q ((chartAt E3 z).symm (F x)))).comp
          (fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 z).symm w)) (F x)) :=
      fderiv_comp' (F x) hσd (hτd x hx)
    have hid := hcomp.symm.trans (hev.fderiv_eq.trans fderiv_id)
    have hleft : Function.LeftInverse
        (fderiv ℝ (fun v => chartAt E3 z ((chartAt E3 q).symm v))
          (chartAt E3 q ((chartAt E3 z).symm (F x))))
        (fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 z).symm w)) (F x)) := by
      intro a
      have := congrArg (fun L : E3 →L[ℝ] E3 => L a) hid
      simpa using this
    rw [hchain x hx, ContinuousLinearMap.coe_comp']
    exact hleft.injective.comp (hFW x hx).2.2
  · intro x hx
    have hy := hmaps hx
    have hfun : (⇑(chartAt E3 q).symm ∘ (fun w => chartAt E3 q ((chartAt E3 z).symm w)))
        =ᶠ[𝓝 (F x)] ⇑(chartAt E3 z).symm := by
      filter_upwards [hΩo.mem_nhds hy] with w hw
      exact (chartAt E3 q).left_inv hw.2
    have hmf := hfun.mfderiv_eq (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, E3))
    have hΦ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm
        (chartAt E3 q ((chartAt E3 z).symm (F x))) :=
      mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 q)
        ((chartAt E3 q).map_source hy.2)
    have hmchain : ∀ u : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm (F x) u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm (F x)))
          (fderiv ℝ (fun w => chartAt E3 q ((chartAt E3 z).symm w)) (F x) u) := by
      intro u
      rw [← hmf]
      have h1 := mfderiv_comp_apply (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, E3)) (I'' := 𝓘(ℝ, E3))
        (F x) hΦ (hτd x hx).mdifferentiableAt u
      rw [mfderiv_eq_fderiv] at h1
      exact h1
    have hpt : (chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm (F x))) =
        (chartAt E3 z).symm (F x) := (chartAt E3 q).left_inv hy.2
    funext i j
    show ∑ k : Fin 3, ∑ l : Fin 3, (fderiv ℝ F x (e2 i)) k *
        g.coeff (chartAt E3 z).symm (F x) k l * (fderiv ℝ F x (e2 j)) l =
      ∑ k : Fin 3, ∑ l : Fin 3,
        (fderiv ℝ (fun x' => chartAt E3 q ((chartAt E3 z).symm (F x'))) x (e2 i)) k *
        g.coeff (chartAt E3 q).symm (chartAt E3 q ((chartAt E3 z).symm (F x))) k l *
        (fderiv ℝ (fun x' => chartAt E3 q ((chartAt E3 z).symm (F x'))) x (e2 j)) l
    rw [hquad, hquad, hchain x hx, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
      hpt, hmchain, hmchain]
    rfl

theorem eig_jacobi_potential [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (Sig : Set M) (hSm : IsMinimalSurfaceSet g Sig) : ∃ V : M → ℝ, eigSmoothAlong Sig V ∧ ∀ (O : Set M) (f : M → ℝ), IsOpen O → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ x ∈ O, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f x ≠ 0) → O ∩ Sig = O ∩ f ⁻¹' {0} → ∀ (z : M) (W : Set E2) (F : E2 → E3) (x₀ : E2), eigSurfParam Sig z W F → x₀ ∈ W → (∀ x ∈ W, (chartAt E3 z).symm (F x) ∈ O) → lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) (fun x => (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x))))⁻¹) x₀ + (V ((chartAt E3 z).symm (F x₀)) + (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x₀))))⁻¹ * g.jacobiDeriv f ((chartAt E3 z).symm (F x₀))) * (Real.sqrt (g.gradInner f f ((chartAt E3 z).symm (F x₀))))⁻¹ = 0 :=
by
  
  have hlapc : ∀ (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (w₁ w₂ : E2 → ℝ) (U : Set E2) (x : E2),
      IsOpen U → x ∈ U → Set.EqOn h₁ h₂ U → Set.EqOn w₁ w₂ U → lap2 h₁ w₁ x = lap2 h₂ w₂ x := by
    intro h₁ h₂ w₁ w₂ U x hU hx hh hw
    have hUx : U ∈ 𝓝 x := hU.mem_nhds hx
    have hhx : h₁ x = h₂ x := hh hx
    have hent : ∀ (a b k : Fin 2),
        pd2 k (fun z => h₁ z a b) x = pd2 k (fun z => h₂ z a b) x := by
      intro a b k
      have hev : (fun z => h₁ z a b) =ᶠ[𝓝 x] (fun z => h₂ z a b) :=
        Filter.eventually_of_mem hUx (fun y hy => by simp only [hh hy])
      show fderiv ℝ (fun z => h₁ z a b) x (e2 k) = fderiv ℝ (fun z => h₂ z a b) x (e2 k)
      rw [hev.fderiv_eq]
    have hchr : ∀ k i j : Fin 2, christoffel2 h₁ k i j x = christoffel2 h₂ k i j x := by
      intro k i j
      simp only [christoffel2, hhx, hent]
    have hw1 : ∀ k : Fin 2, pd2 k w₁ =ᶠ[𝓝 x] pd2 k w₂ := by
      intro k
      filter_upwards [hUx] with y hy
      have hev : w₁ =ᶠ[𝓝 y] w₂ := Filter.eventually_of_mem (hU.mem_nhds hy) (fun t ht => hw ht)
      show fderiv ℝ w₁ y (e2 k) = fderiv ℝ w₂ y (e2 k)
      rw [hev.fderiv_eq]
    have hw0 : ∀ k : Fin 2, pd2 k w₁ x = pd2 k w₂ x := fun k => (hw1 k).eq_of_nhds
    have hw2 : ∀ i k : Fin 2, pd2 i (pd2 k w₁) x = pd2 i (pd2 k w₂) x := by
      intro i k
      show fderiv ℝ (pd2 k w₁) x (e2 i) = fderiv ℝ (pd2 k w₂) x (e2 i)
      rw [(hw1 k).fderiv_eq]
    simp only [lap2, hhx, hchr, hw0, hw2]
  
  have hdat : ∀ y : M, ∃ (Vy : Set M) (fy : M → ℝ), y ∈ Sig → (IsOpen Vy ∧ y ∈ Vy ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ fy ∧ (∀ x ∈ Vy, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) fy x ≠ 0) ∧
      Vy ∩ Sig = Vy ∩ fy ⁻¹' {0}) := by
    intro y
    by_cases hy : y ∈ Sig
    · obtain ⟨V, f, -, hVo, hyV, hf, hdf, hVS, -⟩ := hSm.2 y hy Set.univ Filter.univ_mem
      exact ⟨V, f, fun _ => ⟨hVo, hyV, hf, hdf, hVS⟩⟩
    · exact ⟨∅, fun _ => 0, fun h => absurd h hy⟩
