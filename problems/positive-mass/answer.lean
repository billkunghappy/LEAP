  have hFnV : ∀ x, x ∉ V → F x = f x := by
    intro x hx; rw [hF]; simp only [Set.indicator_of_notMem hx, add_zero]
  have hzero : ∀ x, w (c x) - f x ≤ -ε → ε * smax1 ((w (c x) - f x) / ε) = 0 := by
    intro x h
    rw [hsm0 _ (by rw [div_le_iff₀ hε0]; linarith), mul_zero]
  have hF1 : ∀ x, x ∉ K' → F x = f x := by
    intro x hx
    by_cases hxV : x ∈ V
    · rw [hFV x hxV, hzero x ?_, add_zero]
      have := hw3 (c x) (hnotK' x hxV hx).le
      have := hf0 x
      linarith
    · exact hFnV x hxV
  have hF2 : ∀ x ∈ Vs, F x = f x := by
    intro x hx
    rw [hVs] at hx
    obtain ⟨hxs, hxb⟩ := hx
    have hxb' : dist (c x) yt < s := hxb
    have hxV : x ∈ V := by
      rw [hV]; refine ⟨hxs, ?_⟩
      show dist (c x) yt < 3 * S; linarith
    rw [hFV x hxV, hzero x ?_, add_zero]
    have h1 := hfnear (c x) (by linarith)
    rw [c.left_inv hxs] at h1
    have := hw1 (c x)
    linarith
  have hwc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w ∘ c) V :=
    hwcd.contMDiff.comp_contMDiffOn (contMDiffOn_chart.mono hVsrc)
  have hGlue : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (fun x => f x + ε * smax1 ((w (c x) - f x) / ε)) V :=
    hfs.contMDiffOn.add (contMDiffOn_const.mul
      (hsm_cd.contMDiff.comp_contMDiffOn ((hwc.sub hfs.contMDiffOn).div_const ε)))
  have hFs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    apply contMDiff_of_locally_contMDiffOn
    intro x
    by_cases hx : x ∈ K'
    · exact ⟨V, hVo, hK'V hx, hGlue.congr (fun y hy => hFV y hy)⟩
    · exact ⟨K'ᶜ, hK'cl.isOpen_compl, hx, hfs.contMDiffOn.congr (fun y hy => hF1 y hy)⟩
  have hF0 : ∀ x, 0 ≤ F x := by
    intro x
    by_cases hxV : x ∈ V
    · rw [hFV x hxV]
      have h1 := hsmlo ((w (c x) - f x) / ε)
      have h2 : 0 ≤ max ((w (c x) - f x) / ε) 0 := le_max_right _ _
      have := mul_nonneg hε0.le (h2.trans h1)
      linarith [hf0 x]
    · rw [hFnV x hxV]; exact hf0 x
  have hFK : ∀ x, x ∉ Kf ∪ K' → F x = 0 := by
    intro x hx
    rw [Set.mem_union, not_or] at hx
    rw [hF1 x hx.2, hfK x hx.1]
  have hpV : p ∈ V := by
    rw [hV]; refine ⟨hps, ?_⟩
    show dist (c p) yt < 3 * S; linarith
  have hFp : 0 < F p := by
    rw [hFV p hpV]
    have h1 := hsmlo ((w (c p) - f p) / ε)
    have h2 : (w (c p) - f p) / ε ≤ max ((w (c p) - f p) / ε) 0 := le_max_left _ _
    have h3 : ε * ((w (c p) - f p) / ε) ≤ ε * smax1 ((w (c p) - f p) / ε) :=
      mul_le_mul_of_nonneg_left (h2.trans h1) hε0.le
    have h4 : ε * ((w (c p) - f p) / ε) = w (c p) - f p := by field_simp
    linarith
  
  obtain ⟨Φc, hΦc, hΦs⟩ : ∃ Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      (Φc : E3 → M) = c.symm ∧ Φc.source = c.target :=
    ⟨⟨c.symm.toPartialEquiv, c.symm.open_source, c.symm.open_target, contMDiffOn_chart_symm,
      contMDiffOn_chart⟩, rfl, rfl⟩
  have hLw : ∀ x ∈ V, lapM g (fun x => w (c x)) x = lapLocal (g.coeff c.symm) w (c x) := by
    intro x hxV
    have hxs := hVsrc hxV
    have hct : c x ∈ c.target := c.map_source hxs
    have hu : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => w (c x)) c.source :=
      hwcd.contMDiff.comp_contMDiffOn contMDiffOn_chart
    have h := lapLocal_chart_invariant g Φc (fun x => w (c x)) c.source c.open_source hu (c x)
      (by rw [hΦs]; exact hct) (by rw [hΦc, c.left_inv hxs]; exact hxs)
    rw [hΦc, c.left_inv hxs] at h
    rw [← h]
    apply H1
    filter_upwards [c.open_target.mem_nhds hct] with z hz
    simp only [Function.comp_apply, c.right_inv hz]
  
  have hsup : ∀ x, 0 ≤ 16 * lapM g F x + g.scalarCurvature x := by
    intro x
    by_cases hxK : x ∈ K'
    swap
    · have hev : F =ᶠ[𝓝 x] f :=
        Filter.eventuallyEq_of_mem (hK'cl.isOpen_compl.mem_nhds hxK) (fun y hy => hF1 y hy)
      rw [lapM_congr _ _ x hev]; exact hfl x
    by_cases hxs : x ∈ Vs
    · have hev : F =ᶠ[𝓝 x] f :=
        Filter.eventuallyEq_of_mem (hVso.mem_nhds hxs) (fun y hy => hF2 y hy)
      rw [lapM_congr _ _ x hev]; exact hfl x
    have hxV := hK'V hxK
    obtain ⟨hxsrc, hx52⟩ := hK'mem x hxK
    have hxs' : s ≤ ‖c x - yt‖ := by
      by_contra hcon; push_neg at hcon
      apply hxs; rw [hVs]; refine ⟨hxsrc, ?_⟩
      show dist (c x) yt < s; rw [dist_eq_norm]; exact hcon
    have hwx : 0 ≤ lapM g (fun x => w (c x)) x := by
      rw [hLw x hxV]; exact hw4 (c x) hxs' (by linarith)
    have hy : chartAt E3 x x ∈ (chartAt E3 x).target := mem_chart_target E3 x
    obtain ⟨U, hU⟩ : ∃ U : Set E3, U = (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' V :=
      ⟨_, rfl⟩
    have hUopen : IsOpen U := by rw [hU]; exact (chartAt E3 x).isOpen_inter_preimage_symm hVo
    have hUsub : U ⊆ (chartAt E3 x).target := by rw [hU]; exact Set.inter_subset_left
    have hyU : chartAt E3 x x ∈ U := by
      rw [hU]; refine ⟨hy, ?_⟩
      show (chartAt E3 x).symm (chartAt E3 x x) ∈ V
      rw [(chartAt E3 x).left_inv (mem_chart_source E3 x)]; exact hxV
    have hu₁ : ContDiffOn ℝ ∞ (fun z => f ((chartAt E3 x).symm z)) U := by
      have h0 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun z => f ((chartAt E3 x).symm z))
          (chartAt E3 x).target := hfs.comp_contMDiffOn contMDiffOn_chart_symm
      exact (contMDiffOn_iff_contDiffOn.mp h0).mono hUsub
    have hu₂ : ContDiffOn ℝ ∞ (fun z => w (c ((chartAt E3 x).symm z))) U := by
      have h0 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ((w ∘ c) ∘ (chartAt E3 x).symm) U :=
        hwc.comp (contMDiffOn_chart_symm.mono hUsub) (by rw [hU]; exact fun z hz => hz.2)
      exact contMDiffOn_iff_contDiffOn.mp h0
    have hGcd : ∀ i l : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 x).symm z i l) U :=
      fun i l => (g.smooth x i l).mono hUsub
    have hpsd := hpsd_of _ (coeff_chart_symm_posDef g x _ hy).inv
    obtain ⟨s', hs0', hs1', hineq⟩ := smax1_lap_ge (g.coeff (chartAt E3 x).symm)
      (fun z => f ((chartAt E3 x).symm z)) (fun z => w (c ((chartAt E3 x).symm z))) U hUopen
      (chartAt E3 x x) hyU hGcd hu₁ hu₂ hpsd ε hε0
    have hFeq : (F ∘ (chartAt E3 x).symm) =ᶠ[𝓝 (chartAt E3 x x)]
        (fun z => f ((chartAt E3 x).symm z) + ε * smax1 ((w (c ((chartAt E3 x).symm z)) -
          f ((chartAt E3 x).symm z)) / ε)) := by
      filter_upwards [hUopen.mem_nhds hyU] with z hz
      have hzV : (chartAt E3 x).symm z ∈ V := by rw [hU] at hz; exact hz.2
      exact hFV _ hzV
    have hLF : lapM g F x = lapLocal (g.coeff (chartAt E3 x).symm)
        (fun z => f ((chartAt E3 x).symm z) + ε * smax1 ((w (c ((chartAt E3 x).symm z)) -
          f ((chartAt E3 x).symm z)) / ε)) (chartAt E3 x x) :=
      H1 _ _ _ _ hFeq
    have hL1 : lapLocal (g.coeff (chartAt E3 x).symm) (fun z => f ((chartAt E3 x).symm z))
        (chartAt E3 x x) = lapM g f x := rfl
    have hL2 : lapLocal (g.coeff (chartAt E3 x).symm) (fun z => w (c ((chartAt E3 x).symm z)))
        (chartAt E3 x x) = lapM g (fun x => w (c x)) x := rfl
    rw [hL1, hL2] at hineq
    rw [hLF]
    have hRx := hR x
    have hfx := hfl x
    nlinarith [mul_nonneg (sub_nonneg.2 hs1') hfx, mul_nonneg hs0' hwx, mul_nonneg hs0' hRx]
  exact ⟨F, hFs, hF0, hsup, ⟨Kf ∪ K', hKf.union hK'c, hFK⟩, hFp⟩

theorem cs_bump_at_positive_scalar [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀) :
    ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x, 0 ≤ f x) ∧
      (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f p₀ :=
by
  classical
  
  have H1 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro G u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have lapM_congr : ∀ (u v : M → ℝ) (p : M), u =ᶠ[𝓝 p] v → lapM g u p = lapM g v p := by
    intro u v p huv
    have hc : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
      have := ((chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)).tendsto
      rwa [(chartAt E3 p).left_inv (mem_chart_source E3 p)] at this
    exact H1 _ _ _ _ (huv.comp_tendsto hc)
  have lap0 : ∀ x : M, lapM g (fun _ => (0 : ℝ)) x = 0 := by
    intro x
    have e1 : ((fun _ : M => (0 : ℝ)) ∘ (chartAt E3 x).symm) =
        fun z : E3 => 0 * (fun _ : E3 => (0 : ℝ)) z + 0 := by
      funext z; simp
    show lapLocal (g.coeff (chartAt E3 x).symm) ((fun _ : M => (0 : ℝ)) ∘ (chartAt E3 x).symm)
      (chartAt E3 x x) = 0
    rw [e1, H2, zero_mul]
  
  set c := chartAt E3 p₀ with hc
  have hU : IsOpen c.target := c.open_target
  have hy₀ : c p₀ ∈ c.target := mem_chart_target E3 p₀
  have hp₀s : p₀ ∈ c.source := mem_chart_source E3 p₀
  set G := g.coeff c.symm with hG
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) c.target := g.smooth p₀
  have hpd : ∀ y ∈ c.target, (G y).PosDef := fun y hy => coeff_chart_symm_posDef g p₀ y hy
  
  have hdetgen : ∀ N : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => N y k l) c.target) →
      ContDiffOn ℝ ∞ (fun y => (N y).det) c.target := by
    intro N hN
    have t1 := ((hN 0 0).mul (hN 1 1)).mul (hN 2 2)
    have t2 := ((hN 0 0).mul (hN 1 2)).mul (hN 2 1)
    have t3 := ((hN 0 1).mul (hN 1 0)).mul (hN 2 2)
    have t4 := ((hN 0 1).mul (hN 1 2)).mul (hN 2 0)
    have t5 := ((hN 0 2).mul (hN 1 0)).mul (hN 2 1)
    have t6 := ((hN 0 2).mul (hN 1 1)).mul (hN 2 0)
    have hpoly := ((((t1.sub t2).sub t3).add t4).add t5).sub t6
    exact hpoly.congr (fun y _ => Matrix.det_fin_three (N y))
  have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) c.target := hdetgen G hGs
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) c.target := by
    intro i j
    have h := hdetgen (fun y => (G y).updateRow j (Pi.single i 1)) (by
      intro k l
      by_cases hk : k = j
      · subst hk
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hk]
        exact hGs k l)
    exact h.congr (fun y _ => Matrix.adjugate_apply (G y) i j)
  have hinvformula : ∀ (y : E3) (i j : Fin 3),
      (G y)⁻¹ i j = ((G y).det)⁻¹ * (G y).adjugate i j := by
    intro y i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hGinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) c.target := by
    intro i j
    have h := (hdet.inv (fun y hy => (hpd y hy).det_pos.ne')).mul (hadj i j)
    exact h.congr (fun y _ => hinvformula y i j)
  
  have hP : ∀ (u : E3 → ℝ), ContDiffOn ℝ ∞ u c.target → ∀ k : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv k u y) c.target := by
    intro u hu k
    exact (hu.fderiv_of_isOpen hU (by simp)).clm_apply contDiffOn_const
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) c.target := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
        - partialDeriv l (fun z => G z i j) y)) c.target
    apply contDiffOn_const.mul
    apply ContDiffOn.sum
    intro l _
    exact (hGinv k l).mul (((hP _ (hGs j l) i).add (hP _ (hGs i l) j)).sub (hP _ (hGs i j) l))
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) c.target := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, (partialDeriv i (christoffel G i j k) y
        - partialDeriv j (christoffel G i i k) y)
      + ∑ i : Fin 3, ∑ p : Fin 3,
        (christoffel G i i p y * christoffel G p j k y
          - christoffel G i j p y * christoffel G p i k y)) c.target
    apply ContDiffOn.add
    · apply ContDiffOn.sum
      intro i _
      exact (hP _ (hΓ i j k) i).sub (hP _ (hΓ i i k) j)
    · apply ContDiffOn.sum
      intro i _
      apply ContDiffOn.sum
      intro p _
      exact ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k))
  have hρ : ContDiffOn ℝ ∞ (scalarCurvatureLocal G) c.target := by
    show ContDiffOn ℝ ∞ (fun y => ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ j k * ricci G j k y) c.target
    apply ContDiffOn.sum
    intro j _
    apply ContDiffOn.sum
    intro k _
    exact (hGinv j k).mul (hRic j k)
  
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = g.scalarCurvature p₀ / 2 := ⟨_, rfl⟩
  have hκ0 : 0 < κ := by rw [hκ]; linarith
  have hρ0 : scalarCurvatureLocal G (c p₀) = g.scalarCurvature p₀ := rfl
  have hρcont : ContinuousAt (scalarCurvatureLocal G) (c p₀) :=
    hρ.continuousOn.continuousAt (hU.mem_nhds hy₀)
  have hev1 : ∀ᶠ y in 𝓝 (c p₀), y ∈ c.target := hU.mem_nhds hy₀
  have hev2 : ∀ᶠ y in 𝓝 (c p₀), κ < scalarCurvatureLocal G y :=
    Filter.Tendsto.eventually hρcont (lt_mem_nhds (by rw [hρ0, hκ]; linarith))
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 (hev1.and hev2)
  have hs : 0 < ε / 3 := by linarith
  have hK₀good : ∀ y ∈ Metric.closedBall (c p₀) (2 * (ε / 3)),
      y ∈ c.target ∧ κ < scalarCurvatureLocal G y := by
    intro y hy
    apply hball
    have := Metric.mem_closedBall.1 hy
    linarith
  have hK₀sub : Metric.closedBall (c p₀) (2 * (ε / 3)) ⊆ c.target := fun y hy => (hK₀good y hy).1
  
  obtain ⟨β, hβin, hβout⟩ : ∃ β : ContDiffBump (c p₀), β.rIn = ε / 3 ∧ β.rOut = 2 * (ε / 3) :=
    ⟨⟨ε / 3, 2 * (ε / 3), hs, by linarith⟩, rfl, rfl⟩
  have hβcd : ContDiff ℝ ∞ (β : E3 → ℝ) := β.contDiff
  have hLβ : ContDiffOn ℝ ∞ (lapLocal G β) c.target := by
    have hβ : ContDiffOn ℝ ∞ (β : E3 → ℝ) c.target := hβcd.contDiffOn
    show ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
      (partialDeriv i (fun z => partialDeriv j β z) y -
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k β y)) c.target
    apply ContDiffOn.sum
    intro i _
    apply ContDiffOn.sum
    intro j _
    apply (hGinv i j).mul
    apply (hP _ (hP _ hβ j) i).sub
    apply ContDiffOn.sum
    intro k _
    exact (hΓ k i j).mul (hP _ hβ k)
  obtain ⟨L, hL⟩ := (isCompact_closedBall (c p₀) (2 * (ε / 3))).exists_bound_of_continuousOn
    (hLβ.continuousOn.mono hK₀sub)
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = κ / (16 * (|L| + 1)) := ⟨_, rfl⟩
  have hden : (0 : ℝ) < 16 * (|L| + 1) := by positivity
  have hη0 : 0 < η := by rw [hη]; exact div_pos hκ0 hden
  have hEta : 16 * η * (|L| + 1) = κ := by
    calc 16 * η * (|L| + 1) = κ / (16 * (|L| + 1)) * (16 * (|L| + 1)) := by rw [hη]; ring
      _ = κ := div_mul_cancel₀ κ hden.ne'
  have hEta' : 16 * (η * |L|) + 16 * η = κ := by rw [← hEta]; ring
  have hw : ContDiff ℝ ∞ (fun z : E3 => η * β z) := contDiff_const.mul hβcd
  
  obtain ⟨f, hf⟩ : ∃ f : M → ℝ, f = c.source.indicator (fun x => η * β (c x)) := ⟨_, rfl⟩
  have hfsrc : ∀ x ∈ c.source, f x = η * β (c x) := by
    intro x hx; rw [hf]; exact Set.indicator_of_mem hx _
  have hfout : ∀ x, x ∉ c.source → f x = 0 := by
    intro x hx; rw [hf]; exact Set.indicator_of_notMem hx _
  obtain ⟨K, hK⟩ : ∃ K : Set M, K = c.symm '' Metric.closedBall (c p₀) (2 * (ε / 3)) := ⟨_, rfl⟩
  have hKc : IsCompact K := by
    rw [hK]
    exact (isCompact_closedBall _ _).image_of_continuousOn (c.continuousOn_symm.mono hK₀sub)
  have hKcl : IsClosed K := hKc.isClosed
  have hKsub : K ⊆ c.source := by
    rw [hK]
    rintro x ⟨y, hy, rfl⟩
    exact c.map_target (hK₀sub hy)
  have hfzero : ∀ x, x ∉ K → f x = 0 := by
    intro x hxK
    by_cases hxs : x ∈ c.source
    · rw [hfsrc x hxs]
      have hd : 2 * (ε / 3) ≤ dist (c x) (c p₀) := by
        by_contra hcon
        push_neg at hcon
        apply hxK
        rw [hK]
        exact ⟨c x, Metric.mem_closedBall.2 hcon.le, c.left_inv hxs⟩
      rw [β.zero_of_le_dist (by rw [hβout]; exact hd), mul_zero]
    · exact hfout x hxs
  have hfnn : ∀ x, 0 ≤ f x := by
    intro x
    rw [hf]
    exact Set.indicator_nonneg (fun y _ => mul_nonneg hη0.le β.nonneg) x
  have hfpos : 0 < f p₀ := by
    rw [hfsrc p₀ hp₀s, β.one_of_mem_closedBall (by rw [hβin]; exact Metric.mem_closedBall_self hs.le),
      mul_one]
    exact hη0
  have hfsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
    apply contMDiff_of_locally_contMDiffOn
    intro x
    by_cases hxs : x ∈ c.source
    · refine ⟨c.source, c.open_source, hxs, ?_⟩
      exact (hw.contMDiff.comp_contMDiffOn contMDiffOn_chart).congr (fun z hz => hfsrc z hz)
    · refine ⟨Kᶜ, hKcl.isOpen_compl, fun h => hxs (hKsub h), ?_⟩
      exact (contMDiffOn_const (c := (0 : ℝ))).congr (fun z hz => hfzero z hz)
  
  let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    ⟨c.symm.toPartialEquiv, c.symm.open_source, c.symm.open_target, contMDiffOn_chart_symm,
      contMDiffOn_chart⟩
  
  have hsup : ∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x := by
    intro x
    by_cases hxK : x ∈ K
    · rw [hK] at hxK
      obtain ⟨y, hyK₀, rfl⟩ := hxK
      have hyt : y ∈ c.target := hK₀sub hyK₀
      have hRx : g.scalarCurvature (c.symm y) = scalarCurvatureLocal G y :=
        scalarCurvature_eq_scalarCurvatureLocal_coeff g Φc y hyt
      have hlap1 : lapM g f (c.symm y) = lapLocal G (f ∘ c.symm) y :=
        (lapLocal_chart_invariant g Φc f Set.univ isOpen_univ hfsm.contMDiffOn y hyt
          (Set.mem_univ _)).symm
      have hev3 : (f ∘ c.symm) =ᶠ[𝓝 y] (fun z => η * β z + 0) := by
        filter_upwards [hU.mem_nhds hyt] with z hz
        simp only [Function.comp_apply, add_zero]
        rw [hfsrc _ (c.map_target hz), c.right_inv hz]
      have hlap2 : lapM g f (c.symm y) = η * lapLocal G β y := by
        rw [hlap1, H1 _ _ _ _ hev3, H2]
      have hLy := hL y hyK₀
      rw [Real.norm_eq_abs] at hLy
      have hlow : -|L| ≤ lapLocal G β y := by
        have h1 := (abs_le.1 hLy).1
        have h2 := le_abs_self L
        linarith
      have hm : -(η * |L|) ≤ η * lapLocal G β y := by
        rw [← mul_neg]; exact mul_le_mul_of_nonneg_left hlow hη0.le
      have hκρ := (hK₀good y hyK₀).2
      rw [hlap2, hRx]
      linarith
    · have hev : f =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
        Filter.eventuallyEq_of_mem (hKcl.isOpen_compl.mem_nhds hxK) (fun z hz => hfzero z hz)
      rw [lapM_congr _ _ x hev, lap0]
      linarith [hR x]
  exact ⟨f, hfsm, hfnn, hsup, ⟨K, hKc, hfzero⟩, hfpos⟩

theorem cs_average_supersolution [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) {ι : Type*}
    (t : Finset ι) (ht : t.Nonempty) (f : ι → M → ℝ)
    (hf : ∀ i ∈ t, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i))
    (hsup : ∀ i ∈ t, ∀ x, 0 ≤ 16 * lapM g (f i) x + g.scalarCurvature x) (x : M) :
    0 ≤ 16 * lapM g (fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, f i y) x + g.scalarCurvature x :=
by
  classical
  have hn0 : (0 : ℝ) < (t.card : ℝ) := by exact_mod_cast Finset.card_pos.2 ht
  have hU : IsOpen (chartAt E3 x).target := (chartAt E3 x).open_target
  have hy0 : chartAt E3 x x ∈ (chartAt E3 x).target := mem_chart_target E3 x
  have hu : ∀ i ∈ t, ContDiffOn ℝ ∞ (f i ∘ (chartAt E3 x).symm) (chartAt E3 x).target :=
    fun i hi => contMDiffOn_iff_contDiffOn.mp ((hf i hi).comp_contMDiffOn contMDiffOn_chart_symm)
  
  have hA : ∀ (w : ι → E3 → ℝ) (z : E3) (k : Fin 3), (∀ i ∈ t, DifferentiableAt ℝ (w i) z) →
      partialDeriv k (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, w i z') z
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv k (w i) z := by
    intro w z k hw
    have hS : DifferentiableAt ℝ (fun z' => ∑ i ∈ t, w i z') z := DifferentiableAt.fun_sum hw
    show fderiv ℝ (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, w i z') z (e k)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fderiv ℝ (w i) z (e k)
    rw [fderiv_const_mul hS, fderiv_fun_sum hw]
    simp [ContinuousLinearMap.sum_apply]
  
  have hdiff : ∀ i ∈ t, ∀ z ∈ (chartAt E3 x).target,
      DifferentiableAt ℝ (f i ∘ (chartAt E3 x).symm) z := fun i hi z hz =>
    ((hu i hi).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hz)
  have hpd : ∀ i ∈ t, ∀ j : Fin 3,
      DifferentiableAt ℝ (fun z => partialDeriv j (f i ∘ (chartAt E3 x).symm) z)
        (chartAt E3 x x) := by
    intro i hi j
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (f i ∘ (chartAt E3 x).symm)) (chartAt E3 x).target :=
      (hu i hi).fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun z => partialDeriv j (f i ∘ (chartAt E3 x).symm) z)
        (chartAt E3 x).target :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy0)
  
  have hfirst : ∀ j : Fin 3, ∀ z ∈ (chartAt E3 x).target,
      partialDeriv j (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv j (f i ∘ (chartAt E3 x).symm) z :=
    fun j z hz => hA _ z j (fun i hi => hdiff i hi z hz)
  have hfirst0 : ∀ j : Fin 3,
      partialDeriv j (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z')
          (chartAt E3 x x)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv j (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x) :=
    fun j => hfirst j _ hy0
  
  have hsecond : ∀ a b : Fin 3,
      partialDeriv a (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z) (chartAt E3 x x)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
            partialDeriv a (fun z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
              (chartAt E3 x x) := by
    intro a b
    have hev : (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z)
        =ᶠ[𝓝 (chartAt E3 x x)]
        (fun z => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv b (f i ∘ (chartAt E3 x).symm) z) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hy0) (fun z hz => hfirst b z hz)
    have h1 : partialDeriv a (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z) (chartAt E3 x x)
        = partialDeriv a
          (fun z => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
          (chartAt E3 x x) :=
      congrArg (fun L : E3 →L[ℝ] ℝ => L (e a)) hev.fderiv_eq
    rw [h1]
    exact hA (fun i z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z) _ a (fun i hi => hpd i hi b)
  
  have key : ∀ (N : ℝ) (Γ : Fin 3 → ℝ) (A : ι → ℝ) (B : ι → Fin 3 → ℝ),
      N * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, A i
          - ∑ k : Fin 3, Γ k * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, B i k)) =
        ((t.card : ℝ))⁻¹ * ∑ i ∈ t, N * (A i - ∑ k : Fin 3, Γ k * B i k) := by
    intro N Γ A B
    have e1 : ∀ i ∈ t, N * (A i - ∑ k : Fin 3, Γ k * B i k) =
        N * A i - (N * Γ 0) * B i 0 - (N * Γ 1) * B i 1 - (N * Γ 2) * B i 2 := by
      intro i _
      simp only [Fin.sum_univ_three]
      ring
    rw [Finset.sum_congr rfl e1]
    simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, Fin.sum_univ_three]
    ring
  have hlap : lapM g (fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, f i y) x
      = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, lapM g (f i) x := by
    show lapLocal (g.coeff (chartAt E3 x).symm)
        (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') (chartAt E3 x x)
      = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
          lapLocal (g.coeff (chartAt E3 x).symm) (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x)
    unfold lapLocal
    have hab : ∀ a b : Fin 3,
        (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ a b *
          (partialDeriv a (fun z => partialDeriv b
              (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z)
              (chartAt E3 x x) -
            ∑ k : Fin 3, christoffel (g.coeff (chartAt E3 x).symm) k a b (chartAt E3 x x) *
              partialDeriv k
                (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z')
                (chartAt E3 x x))
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
            (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ a b *
              (partialDeriv a (fun z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
                  (chartAt E3 x x) -
                ∑ k : Fin 3, christoffel (g.coeff (chartAt E3 x).symm) k a b (chartAt E3 x x) *
                  partialDeriv k (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x)) := by
      intro a b
      rw [hsecond a b]
      simp only [hfirst0]
      exact key _ _ _ _
    rw [Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => hab a b))]
    simp only [Finset.mul_sum]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    exact Finset.sum_comm
  rw [hlap]
  have hsum : 0 ≤ ∑ i ∈ t, (16 * lapM g (f i) x + g.scalarCurvature x) :=
    Finset.sum_nonneg (fun i hi => hsup i hi x)
  rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, ← Finset.mul_sum] at hsum
  have hre : 16 * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, lapM g (f i) x) + g.scalarCurvature x
      = ((t.card : ℝ))⁻¹ *
        (16 * ∑ i ∈ t, lapM g (f i) x + (t.card : ℝ) * g.scalarCurvature x) := by
    rw [mul_add, inv_mul_cancel_left₀ hn0.ne']
    ring
  rw [hre]
  exact mul_nonneg (inv_nonneg.2 hn0.le) hsum

theorem core_supersolution [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (hR : ∀ p : M, 0 ≤ g.scalarCurvature p)
    (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀) (r : ℝ) (hr : 2 ≤ r) :
    ∃ (f : M → ℝ) (ρ₁ ρ₂ c₀ : ℝ), r < ρ₁ ∧ ρ₁ < ρ₂ ∧ 0 < c₀ ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ p, 0 ≤ f p ∧ f p ≤ 1 / 4) ∧
      (∀ p, 0 ≤ 16 * lapM g f p + g.scalarCurvature p) ∧
      (∀ (j : Fin hAF.numEnds) (x : E3), ρ₂ < ‖x‖ → f ((hAF.ends j).Φ x) = 0) ∧
      (∀ (j : Fin hAF.numEnds) (x : E3), r ≤ ‖x‖ → ‖x‖ ≤ ρ₁ → c₀ ≤ f ((hAF.ends j).Φ x)) :=
by
  classical
  
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have hsrc : ∀ j : Fin hAF.numEnds, (hAF.ends j).Φ.source = {x : E3 | 1 < ‖x‖} :=
    fun j => (hAF.ends j).source_eq
  
  obtain ⟨P, hP⟩ : ∃ P : Set M, P = {q | ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x, 0 ≤ f x) ∧ (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f q} := ⟨_, rfl⟩
  have hPopen : IsOpen P := by
    rw [isOpen_iff_forall_mem_open]
    intro q hq
    rw [hP, Set.mem_setOf_eq] at hq
    obtain ⟨f, hfs, hf0, hfl, hfK, hfq⟩ := hq
    refine ⟨{x | 0 < f x}, ?_, isOpen_lt continuous_const hfs.continuous, hfq⟩
    intro x hx
    rw [hP, Set.mem_setOf_eq]
    exact ⟨f, hfs, hf0, hfl, hfK, hx⟩
  have hPclosed : IsClosed P := by
    apply isClosed_of_closure_subset
    intro p hp
    have key := cs_good_propagate g hR p (fun U hU hpU => by
      obtain ⟨q, hqU, hqP⟩ := mem_closure_iff.1 hp U hU hpU
      rw [hP, Set.mem_setOf_eq] at hqP
      exact ⟨q, hqU, hqP⟩)
    rw [hP, Set.mem_setOf_eq]
    exact key
  have hP0 : p₀ ∈ P := by
    rw [hP, Set.mem_setOf_eq]
    exact cs_bump_at_positive_scalar g hR p₀ hp₀
  have hPuniv : P = Set.univ := IsClopen.eq_univ ⟨hPclosed, hPopen⟩ ⟨p₀, hP0⟩
  have hgood : ∀ q : M, ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x, 0 ≤ f x) ∧ (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f q := by
    intro q
    have hq : q ∈ P := by rw [hPuniv]; exact Set.mem_univ q
    rw [hP, Set.mem_setOf_eq] at hq
    exact hq
  choose fp hfps hfp0 hfpl hfpK hfpq using hgood
  choose Kp hKpc hKp using hfpK
  
  obtain ⟨ρ₁, hρ₁⟩ : ∃ ρ₁ : ℝ, ρ₁ = r + 1 := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : Set M,
      A = ⋃ j, (hAF.ends j).Φ '' {x : E3 | r ≤ ‖x‖ ∧ ‖x‖ ≤ ρ₁} := ⟨_, rfl⟩
  have hAc : IsCompact A := by
    rw [hA]
    apply isCompact_iUnion
    intro j
    have hK : IsCompact {x : E3 | r ≤ ‖x‖ ∧ ‖x‖ ≤ ρ₁} := by
      apply (isCompact_closedBall (0 : E3) ρ₁).of_isClosed_subset
      · exact (isClosed_le continuous_const continuous_norm).inter
          (isClosed_le continuous_norm continuous_const)
      · intro x hx
        rw [Metric.mem_closedBall, dist_zero_right]
        exact hx.2
    apply hK.image_of_continuousOn
    apply (hAF.ends j).Φ.contMDiffOn_toFun.continuousOn.mono
    intro x hx
    rw [hsrc j]
    show (1 : ℝ) < ‖x‖
    have := hx.1
    linarith
  
  have hAcov : A ⊆ ⋃ q : M, {x | 0 < fp q x} := fun x _ => Set.mem_iUnion.2 ⟨x, hfpq x⟩
  obtain ⟨t₀, ht₀⟩ := hAc.elim_finite_subcover (fun q => {x | 0 < fp q x})
    (fun q => isOpen_lt continuous_const (hfps q).continuous) hAcov
  obtain ⟨t, ht⟩ : ∃ t : Finset M, t = insert p₀ t₀ := ⟨_, rfl⟩
  have htne : t.Nonempty := by rw [ht]; exact Finset.insert_nonempty _ _
  have hcard : 0 < (t.card : ℝ) := by exact_mod_cast Finset.card_pos.2 htne
  obtain ⟨favg, hfavg⟩ : ∃ favg : M → ℝ,
      favg = fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y := ⟨_, rfl⟩
  have hfavgs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ favg := by
    rw [hfavg]
    exact contMDiff_const.mul (contMDiff_finset_sum (fun i _ => hfps i))
  have hfavg0 : ∀ y, 0 ≤ favg y := by
    intro y
    rw [hfavg]
    exact mul_nonneg (inv_nonneg.2 hcard.le) (Finset.sum_nonneg fun i _ => hfp0 i y)
  have hfavgl : ∀ x, 0 ≤ 16 * lapM g favg x + g.scalarCurvature x := by
    intro x
    rw [hfavg]
    exact cs_average_supersolution g t htne fp (fun i _ => hfps i) (fun i _ => hfpl i) x
  obtain ⟨Kt, hKt⟩ : ∃ Kt : Set M, Kt = ⋃ i ∈ t, Kp i := ⟨_, rfl⟩
  have hKtc : IsCompact Kt := by
    rw [hKt]
    exact t.isCompact_biUnion (fun i _ => hKpc i)
  have hfavgK : ∀ y, y ∉ Kt → favg y = 0 := by
    intro y hy
    have hy' : ∀ i ∈ t, y ∉ Kp i := fun i hi hyi =>
      hy (by rw [hKt]; exact Set.mem_biUnion hi hyi)
    rw [hfavg]
    show ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y = 0
    rw [Finset.sum_eq_zero (fun i hi => hKp i y (hy' i hi)), mul_zero]
  have hfavgpos : ∀ y ∈ A, 0 < favg y := by
    intro y hy
    obtain ⟨i, hi, hpos⟩ := Set.mem_iUnion₂.1 (ht₀ hy)
    rw [hfavg]
    show 0 < ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y
    refine mul_pos (inv_pos.2 hcard) (Finset.sum_pos' (fun i _ => hfp0 i y) ⟨i, ?_, hpos⟩)
    rw [ht]
    exact Finset.mem_insert_of_mem hi
  
  have hfavgc : Continuous favg := hfavgs.continuous
  obtain ⟨m₀, hm₀, hm₀A⟩ : ∃ m₀ : ℝ, 0 < m₀ ∧ ∀ y ∈ A, m₀ ≤ favg y := by
    rcases A.eq_empty_or_nonempty with hAe | hAne
    · refine ⟨1, one_pos, fun y hy => ?_⟩
      rw [hAe] at hy
      simp at hy
    · obtain ⟨x, hxA, hxmin⟩ := hAc.exists_isMinOn hAne hfavgc.continuousOn
      exact ⟨favg x, hfavgpos x hxA, fun y hy => isMinOn_iff.1 hxmin y hy⟩
  
  obtain ⟨C₁, hC₁⟩ := hfavgc.bounded_above_of_compact_support (HasCompactSupport.intro hKtc hfavgK)
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ, lam = 1 / (4 * (|C₁| + 1)) := ⟨_, rfl⟩
  have hlam0 : 0 < lam := by rw [hlam]; positivity
  have hlamC : lam * (|C₁| + 1) = 1 / 4 := by
    rw [hlam]
    have : (0 : ℝ) < |C₁| + 1 := by positivity
    field_simp
  have hlam1 : lam ≤ 1 := by
    have := abs_nonneg C₁
    nlinarith
  obtain ⟨f, hf⟩ : ∃ f : M → ℝ, f = fun y => lam * favg y := ⟨_, rfl⟩
  have hfs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
    rw [hf]
    exact contMDiff_const.mul hfavgs
  have hfb : ∀ p, 0 ≤ f p ∧ f p ≤ 1 / 4 := by
    intro p
    rw [hf]
    show 0 ≤ lam * favg p ∧ lam * favg p ≤ 1 / 4
    have h1 := hfavg0 p
    have h2 : favg p ≤ |C₁| := by
      have := hC₁ p
      rw [Real.norm_eq_abs] at this
      exact le_trans (le_abs_self _) (le_trans this (le_abs_self _))
    refine ⟨mul_nonneg hlam0.le h1, ?_⟩
    nlinarith
  have hlapf : ∀ p, lapM g f p = lam * lapM g favg p := by
    intro p
    have e1 : f ∘ (chartAt E3 p).symm = fun z => lam * (favg ∘ (chartAt E3 p).symm) z + 0 := by
      funext z
      rw [hf]
      simp
    show lapLocal (g.coeff (chartAt E3 p).symm) (f ∘ (chartAt E3 p).symm) (chartAt E3 p p) =
      lam * lapLocal (g.coeff (chartAt E3 p).symm) (favg ∘ (chartAt E3 p).symm) (chartAt E3 p p)
    rw [e1, H2]
  have hfsup : ∀ p, 0 ≤ 16 * lapM g f p + g.scalarCurvature p := by
    intro p
    rw [hlapf p]
    have h1 := hfavgl p
    have h2 := hR p
    nlinarith [mul_nonneg hlam0.le h1, mul_nonneg (sub_nonneg.2 hlam1) h2]
  
  have hfar : ∀ j : Fin hAF.numEnds, ∃ ρ : ℝ, 2 ≤ ρ ∧
      ∀ x : E3, ρ < ‖x‖ → (hAF.ends j).Φ x ∉ Kt := by
    intro j
    obtain ⟨ρ₀, hρ₀2, hρ₀c⟩ := endChart_far_isClosed g hAF j
    obtain ⟨C, hC⟩ : ∃ C : ℕ → Set M,
        C = fun n : ℕ => (hAF.ends j).Φ '' {x : E3 | ρ₀ + (n : ℝ) ≤ ‖x‖} := ⟨_, rfl⟩
    have hCmem : ∀ (n : ℕ) (p : M), p ∈ C n ↔
        ∃ x : E3, ρ₀ + (n : ℝ) ≤ ‖x‖ ∧ (hAF.ends j).Φ x = p := by
      intro n p; rw [hC]; exact Iff.rfl
    have hCc : ∀ n : ℕ, IsClosed (C n) := by
      intro n
      rw [hC]
      exact hρ₀c _ (by have := n.cast_nonneg (α := ℝ); linarith)
    have hmono : Monotone (fun n : ℕ => (C n)ᶜ) := by
      intro n m hnm
      apply Set.compl_subset_compl.2
      intro p hp
      obtain ⟨x, hx, hxp⟩ := (hCmem m p).1 hp
      refine (hCmem n p).2 ⟨x, ?_, hxp⟩
      have : (n : ℝ) ≤ m := Nat.cast_le.2 hnm
      linarith
    have hcov : Kt ⊆ ⋃ n : ℕ, (C n)ᶜ := by
      intro p _
      rw [Set.mem_iUnion]
      by_cases hpt : p ∈ C 0
      · obtain ⟨x₀, hx₀, hx₀p⟩ := (hCmem 0 p).1 hpt
        obtain ⟨n, hn⟩ := exists_nat_gt ‖x₀‖
        refine ⟨n, fun hpn => ?_⟩
        obtain ⟨x, hx, hxp⟩ := (hCmem n p).1 hpn
        have hn0 : (0 : ℝ) ≤ n := n.cast_nonneg
        have hx₀' : ρ₀ ≤ ‖x₀‖ := by simpa using hx₀
        have hx1 : x ∈ (hAF.ends j).Φ.source := by
          rw [hsrc j]; show (1 : ℝ) < ‖x‖; linarith
        have hx01 : x₀ ∈ (hAF.ends j).Φ.source := by
          rw [hsrc j]; show (1 : ℝ) < ‖x₀‖; linarith
        have e1 : (hAF.ends j).Φ.symm ((hAF.ends j).Φ x) = x :=
          (hAF.ends j).Φ.toPartialEquiv.left_inv hx1
        have e2 : (hAF.ends j).Φ.symm ((hAF.ends j).Φ x₀) = x₀ :=
          (hAF.ends j).Φ.toPartialEquiv.left_inv hx01
        have hxx : x = x₀ := by
          calc x = (hAF.ends j).Φ.symm ((hAF.ends j).Φ x) := e1.symm
            _ = (hAF.ends j).Φ.symm ((hAF.ends j).Φ x₀) := by rw [hxp, hx₀p]
            _ = x₀ := e2
        rw [hxx] at hx
        linarith
      · exact ⟨0, hpt⟩
    obtain ⟨n, hn⟩ := hKtc.elim_directed_cover (fun n => (C n)ᶜ)
      (fun n => (hCc n).isOpen_compl) hcov hmono.directed_le
    refine ⟨ρ₀ + n, by have := n.cast_nonneg (α := ℝ); linarith, fun x hx hxK => ?_⟩
    exact hn hxK ((hCmem n _).2 ⟨x, hx.le, rfl⟩)
  choose ρj hρj2 hρj using hfar
  obtain ⟨ρ₂, hρ₂⟩ : ∃ ρ₂ : ℝ, ρ₂ = ρ₁ + 1 + ∑ j, |ρj j| := ⟨_, rfl⟩
  have hsum0 : 0 ≤ ∑ j, |ρj j| := Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hρjle : ∀ j, ρj j ≤ ρ₂ := by
    intro j
    have h1 : |ρj j| ≤ ∑ i, |ρj i| :=
      Finset.single_le_sum (f := fun i => |ρj i|) (fun i _ => abs_nonneg _) (Finset.mem_univ j)
    have h2 := le_abs_self (ρj j)
    have h3 : 0 ≤ ρ₁ := by rw [hρ₁]; linarith
    rw [hρ₂]
    linarith
  refine ⟨f, ρ₁, ρ₂, lam * m₀, by rw [hρ₁]; linarith, by rw [hρ₂]; linarith,
    mul_pos hlam0 hm₀, hfs, hfb, hfsup, ?_, ?_⟩
  · intro j x hx
    have hxK : (hAF.ends j).Φ x ∉ Kt := hρj j x (by linarith [hρjle j])
    rw [hf]
    show lam * favg ((hAF.ends j).Φ x) = 0
    rw [hfavgK _ hxK, mul_zero]
  · intro j x hx1 hx2
    have hxA : (hAF.ends j).Φ x ∈ A := by
      rw [hA]
      exact Set.mem_iUnion.2 ⟨j, x, ⟨hx1, hx2⟩, rfl⟩
    rw [hf]
    show lam * m₀ ≤ lam * favg ((hAF.ends j).Φ x)
    exact mul_le_mul_of_nonneg_left (hm₀A _ hxA) hlam0.le

theorem conformal_mass_drop_of_scalar_pos [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀)
    (k : Fin hAF.numEnds) (m : ℝ)
    (hm : Tendsto (fun r : ℝ => admFlux g (hAF.ends k) r) atTop (𝓝 m)) :
    ∃ (g' : RiemannianMetric3 M) (_ : g'.IsCompleteRiemannian) (hAF' : AsymptoticallyFlat g')
      (k' : Fin hAF'.numEnds) (m' : ℝ),
      (∀ p : M, 0 ≤ g'.scalarCurvature p) ∧
      Tendsto (fun r : ℝ => admFlux g' (hAF'.ends k') r) atTop (𝓝 m') ∧ m' < m :=
by
  classical
  
  have H1 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro G u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have H2' : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (γ : ℝ) (y : E3),
      lapLocal G (fun z => u z - γ) y = lapLocal G u y := by
    intro G u γ y
    have e1 : (fun z => u z - γ) = fun z => 1 * u z + -γ := by funext z; ring
    rw [e1, H2, one_mul]
  have lapM_congr : ∀ (u v : M → ℝ) (p : M), u =ᶠ[𝓝 p] v → lapM g u p = lapM g v p := by
    intro u v p huv
    have hc : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
      have := ((chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)).tendsto
      rwa [(chartAt E3 p).left_inv (mem_chart_source E3 p)] at this
    exact H1 _ _ _ _ (huv.comp_tendsto hc)
  have lapM_sub_const : ∀ (u : M → ℝ) (γ : ℝ) (p : M),
      lapM g (fun q => u q - γ) p = lapM g u p := fun u γ p =>
    H2' _ (u ∘ (chartAt E3 p).symm) γ _
  
  have hsrc : ∀ j : Fin hAF.numEnds, (hAF.ends j).Φ.source = {x : E3 | 1 < ‖x‖} :=
    fun j => (hAF.ends j).source_eq
  have hleft : ∀ (j : Fin hAF.numEnds) (x : E3), 1 < ‖x‖ →
      (hAF.ends j).Φ.symm ((hAF.ends j).Φ x) = x := fun j x hx =>
    (hAF.ends j).Φ.toPartialEquiv.left_inv (by rw [hsrc j]; exact hx)
  have hmaps : ∀ (j : Fin hAF.numEnds) (x : E3), 1 < ‖x‖ →
      (hAF.ends j).Φ x ∈ (hAF.ends j).Φ.target := fun j x hx =>
    (hAF.ends j).Φ.toPartialEquiv.map_source (by rw [hsrc j]; exact hx)
  have hsmooth : ∀ (j : Fin hAF.numEnds) (i l : Fin 3),
      ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends j).Φ x i l) {x : E3 | 1 < ‖x‖} := by
    intro j i l
    rw [← hsrc j]
    exact coeff_contDiffOn_source g (hAF.ends j).Φ i l
  have hsymmG : ∀ (φ : E3 → M) (x : E3) (i l : Fin 3), g.coeff φ x i l = g.coeff φ x l i :=
    fun φ x i l => g.symm _ _ _
  have hPD1 : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (x : E3), x ∈ Φ.source →
      (g.coeff Φ x).PosDef := fun Φ x hx => coeff_posDef g Φ x hx
  have hPD2 : ∀ (p : M) (y : E3), y ∈ (chartAt E3 p).target →
      (g.coeff (chartAt E3 p).symm y).PosDef := fun p y hy => coeff_chart_symm_posDef g p y hy
  have hdetpos : ∀ (j : Fin hAF.numEnds) (x : E3), 1 < ‖x‖ →
      0 < (g.coeff (hAF.ends j).Φ x).det := fun j x hx =>
    (hPD1 _ x (by rw [hsrc j]; exact hx)).det_pos
  have hpsd_of : ∀ A : Matrix (Fin 3) (Fin 3) ℝ, A.PosDef →
      ∀ v : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ l : Fin 3, A i l * v i * v l := by
    intro A hA v
    have := hA.posSemidef.dotProduct_mulVec_nonneg v
    simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
      at this ⊢
    nlinarith [this]
  
  have hq0 : 0 < hAF.q := by have := hAF.q_gt; linarith
  have hq'gt : 1 / 2 < min hAF.q 1 := lt_min hAF.q_gt (by norm_num)
  obtain ⟨δ, hδ0, hδq⟩ : ∃ δ : ℝ, 0 < δ ∧ δ < hAF.q := ⟨hAF.q / 2, by linarith, by linarith⟩
  have hφ : ∀ x : E3, 1 ≤ ‖x‖ → 0 ≤ farPot δ x ∧ farPot δ x ≤ 2 := by
    intro x hx
    have h1 : ‖x‖⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hx
    have h2 : ‖x‖ ^ (-1 - δ) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx (by linarith)
    have h3 : 0 ≤ ‖x‖⁻¹ := inv_nonneg.mpr (norm_nonneg _)
    have h4 : 0 ≤ ‖x‖ ^ (-1 - δ) := Real.rpow_nonneg (norm_nonneg _) _
    unfold farPot
    constructor <;> linarith
  have hφcd : ContDiffOn ℝ ∞ (farPot δ) {x : E3 | 1 < ‖x‖} := by
    intro x hx
    have hx1 : (1 : ℝ) < ‖x‖ := hx
    have hx0 : x ≠ 0 := by
      intro h; rw [h, norm_zero] at hx1; linarith
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx0
    have h1 : ContDiffAt ℝ ∞ (fun y : E3 => ‖y‖) x := contDiffAt_norm ℝ hx0
    exact ((h1.inv hn).add (h1.rpow_const_of_ne hn)).contDiffWithinAt
  
  have h6 : ∀ j : Fin hAF.numEnds, ∃ R₀ C : ℝ, 2 ≤ R₀ ∧ ∀ x : E3, R₀ < ‖x‖ →
      δ * (1 + δ) / 2 * ‖x‖ ^ (-3 - δ) ≤ lapLocal (g.coeff (hAF.ends j).Φ) (farPot δ) x ∧
      |lapLocal (g.coeff (hAF.ends j).Φ) (farPot δ) x| ≤ C * ‖x‖ ^ (-3 - δ) := fun j =>
    farPot_lap_bounds (g.coeff (hAF.ends j).Φ) hAF.q δ hδ0 hδq (hsmooth j) (hsymmG _)
      (hAF.decay j)
  choose R0 C0 hR0 using h6
  choose ρ0 hρ0 using fun j : Fin hAF.numEnds => endChart_far_isClosed g hAF j
  obtain ⟨r, hr2, hrR0, hrρ0⟩ : ∃ r : ℝ, 2 ≤ r ∧ (∀ j, R0 j ≤ r) ∧ (∀ j, ρ0 j ≤ r) := by
    refine ⟨2 + ∑ j, (|R0 j| + |ρ0 j|), ?_, ?_, ?_⟩
    · have := Finset.sum_nonneg
        (fun i (_ : i ∈ Finset.univ) => (by positivity : (0 : ℝ) ≤ |R0 i| + |ρ0 i|))
      linarith
    · intro j
      have h1 : |R0 j| + |ρ0 j| ≤ ∑ i, (|R0 i| + |ρ0 i|) :=
        Finset.single_le_sum (f := fun i => |R0 i| + |ρ0 i|) (fun i _ => by positivity)
          (Finset.mem_univ j)
      have := le_abs_self (R0 j); have := abs_nonneg (ρ0 j)
      linarith
    · intro j
      have h1 : |R0 j| + |ρ0 j| ≤ ∑ i, (|R0 i| + |ρ0 i|) :=
        Finset.single_le_sum (f := fun i => |R0 i| + |ρ0 i|) (fun i _ => by positivity)
          (Finset.mem_univ j)
      have := le_abs_self (ρ0 j); have := abs_nonneg (R0 j)
      linarith
  
  obtain ⟨f, ρ₁, ρ₂, c₀, hrρ₁, hρ₁₂, hc₀, hfsm, hfb, hfsup, hffar, hfann⟩ :=
    core_supersolution g hAF hR p₀ hp₀ r hr2
  obtain ⟨c, hc0, hcc₀, hc14⟩ : ∃ c : ℝ, 0 < c ∧ c ≤ c₀ ∧ c ≤ 1 / 4 :=
    ⟨min c₀ (1 / 4), lt_min hc₀ (by norm_num), min_le_left _ _, min_le_right _ _⟩
  obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = c / 2 := ⟨_, rfl⟩
  obtain ⟨ε, hε⟩ : ∃ ε : ℝ, ε = c / 8 := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = c / 16 := ⟨_, rfl⟩
  have hε0 : 0 < ε := by rw [hε]; positivity
  have hεne : ε ≠ 0 := hε0.ne'
  have ha0 : 0 < a := by rw [ha]; positivity
  have ha14 : a ≤ 1 / 4 := by rw [ha]; linarith
  obtain ⟨hsm_cd, -, -, hsm0, hsmid, hsmlo, hsmhi⟩ := smax1_props
  
  obtain ⟨T, hT⟩ : ∃ T : Fin hAF.numEnds → Set M,
      T = fun j => (hAF.ends j).Φ '' {x : E3 | r < ‖x‖} := ⟨_, rfl⟩
  have hTmem : ∀ j p, p ∈ T j ↔ ∃ x : E3, r < ‖x‖ ∧ (hAF.ends j).Φ x = p := by
    intro j p; rw [hT]; exact Iff.rfl
  have hTopen : ∀ j, IsOpen (T j) := by
    intro j; rw [hT]
    exact (hAF.ends j).Φ.toOpenPartialHomeomorph.isOpen_image_of_subset_source
      (isOpen_lt continuous_const continuous_norm)
      (fun x hx => by
        show x ∈ (hAF.ends j).Φ.source
        rw [hsrc j]; show (1 : ℝ) < ‖x‖; have : r < ‖x‖ := hx; linarith)
  have hTtarget : ∀ j, T j ⊆ (hAF.ends j).Φ.target := by
    intro j q hq
    obtain ⟨x, hx, rfl⟩ := (hTmem j q).1 hq
    exact hmaps j x (by linarith)
  have hTdisj : ∀ i l : Fin hAF.numEnds, i ≠ l → ∀ q, q ∈ T i → q ∉ T l :=
    fun i l hil q hqi hql =>
      Set.disjoint_left.mp (hAF.disjoint hil) (hTtarget i hqi) (hTtarget l hql)
  obtain ⟨O, hO⟩ : ∃ O : Set M, O = (⋃ j, (hAF.ends j).Φ '' {x : E3 | ρ₁ ≤ ‖x‖})ᶜ :=
    ⟨_, rfl⟩
  have hOopen : IsOpen O := by
    rw [hO]
    exact (isClosed_iUnion_of_finite fun j =>
      (hρ0 j).2 ρ₁ (by linarith [hrρ0 j])).isOpen_compl
  have hcover : ∀ q, q ∈ O ∨ ∃ j, q ∈ T j := by
    intro q
    by_cases hqO : q ∈ O
    · exact Or.inl hqO
    · right
      rw [hO, Set.mem_compl_iff, not_not] at hqO
      obtain ⟨j, x, hx, hxq⟩ := Set.mem_iUnion.1 hqO
      exact ⟨j, (hTmem j q).2 ⟨x, by have : ρ₁ ≤ ‖x‖ := hx; linarith, hxq⟩⟩
  
  obtain ⟨f₂, hf₂⟩ : ∃ f₂ : Fin hAF.numEnds → M → ℝ,
      f₂ = fun j p => a * farPot δ ((hAF.ends j).Φ.symm p) := ⟨_, rfl⟩
  obtain ⟨F, hF⟩ : ∃ F : M → ℝ, F = fun p => (f p - β) +
      ∑ j, (T j).indicator (fun p => ε * smax1 ((f₂ j p - (f p - β)) / ε)) p := ⟨_, rfl⟩
  have hf₂at : ∀ (j : Fin hAF.numEnds) (x : E3), 1 < ‖x‖ →
      f₂ j ((hAF.ends j).Φ x) = a * farPot δ x := by
    intro j x hx
    rw [hf₂]
    show a * farPot δ ((hAF.ends j).Φ.symm ((hAF.ends j).Φ x)) = a * farPot δ x
    rw [hleft j x hx]
  have hFT : ∀ j, ∀ q ∈ T j, F q = (f q - β) + ε * smax1 ((f₂ j q - (f q - β)) / ε) := by
    intro j q hq
    rw [hF]
    show (f q - β) + ∑ i, (T i).indicator (fun p => ε * smax1 ((f₂ i p - (f p - β)) / ε)) q = _
    rw [Finset.sum_eq_single j]
    · rw [Set.indicator_of_mem hq]
    · intro i _ hij; exact Set.indicator_of_notMem (hTdisj j i (Ne.symm hij) q hq) _
    · intro h; exact absurd (Finset.mem_univ j) h
  have hFoff : ∀ q, (∀ j, q ∉ T j) → F q = f q - β := by
    intro q hq
    rw [hF]
    show (f q - β) + ∑ i, (T i).indicator (fun p => ε * smax1 ((f₂ i p - (f p - β)) / ε)) q = _
    rw [Finset.sum_eq_zero (fun i _ => Set.indicator_of_notMem (hq i) _), add_zero]
  have hFO : ∀ q ∈ O, F q = f q - β := by
    intro q hqO
    by_cases hq : ∃ j, q ∈ T j
    · obtain ⟨j, hj⟩ := hq
      obtain ⟨x, hx, hxq⟩ := (hTmem j q).1 hj
      have hxρ : ‖x‖ < ρ₁ := by
        by_contra hcon
        push_neg at hcon
        rw [hO] at hqO
        exact (Set.mem_compl_iff _ _).1 hqO (Set.mem_iUnion.2 ⟨j, x, hcon, hxq⟩)
      rw [hFT j q hj]
      have hx1 : 1 < ‖x‖ := by linarith
      have hfx : c₀ ≤ f q := by rw [← hxq]; exact hfann j x hx.le hxρ.le
      have hf₂x : f₂ j q = a * farPot δ x := by rw [← hxq]; exact hf₂at j x hx1
      have hφx := hφ x hx1.le
      have h2a : a * farPot δ x ≤ a * 2 := mul_le_mul_of_nonneg_left hφx.2 ha0.le
      have harg : (f₂ j q - (f q - β)) / ε ≤ -1 := by
        rw [div_le_iff₀ hε0, hf₂x]
        linarith
      rw [hsm0 _ harg]; ring
    · push_neg at hq
      exact hFoff q hq
  have hFfar : ∀ (j : Fin hAF.numEnds) (x : E3), ρ₂ < ‖x‖ →
      F ((hAF.ends j).Φ x) = a * farPot δ x := by
    intro j x hx
    have hxr : r < ‖x‖ := by linarith
    have hj : (hAF.ends j).Φ x ∈ T j := (hTmem j _).2 ⟨x, hxr, rfl⟩
    rw [hFT j _ hj, hffar j x hx, hf₂at j x (by linarith)]
    have hφx := hφ x (by linarith)
    have hnn : 0 ≤ a * farPot δ x := mul_nonneg ha0.le hφx.1
    have harg : 1 ≤ (a * farPot δ x - (0 - β)) / ε := by
      rw [le_div_iff₀ hε0]
      linarith
    rw [hsmid _ harg]
    have hdiv : ε * ((a * farPot δ x - (0 - β)) / ε) = a * farPot δ x - (0 - β) := by
      field_simp
    rw [hdiv]; ring
  have hFb : ∀ q, -1 / 8 ≤ F q ∧ F q ≤ 1 / 2 := by
    intro q
    have hf0 := (hfb q).1
    have hf1 := (hfb q).2
    rcases hcover q with hqO | ⟨j, hj⟩
    · rw [hFO q hqO]; constructor <;> linarith
    · obtain ⟨x, hx, hxq⟩ := (hTmem j q).1 hj
      rw [hFT j q hj]
      have hf₂x : f₂ j q = a * farPot δ x := by rw [← hxq]; exact hf₂at j x (by linarith)
      have hφx := hφ x (by linarith)
      have h2a : a * farPot δ x ≤ a * 2 := mul_le_mul_of_nonneg_left hφx.2 ha0.le
      obtain ⟨H, hH⟩ : ∃ H : ℝ, H = (f₂ j q - (f q - β)) / ε := ⟨_, rfl⟩
      rw [← hH]
      have hHε : ε * H = f₂ j q - (f q - β) := by rw [hH]; field_simp
      have hlo := hsmlo H
      have hhi := hsmhi H
      have hmax0 : 0 ≤ max H 0 := le_max_right _ _
      have hnn : 0 ≤ ε * smax1 H := mul_nonneg hε0.le (le_trans hmax0 hlo)
      have hup : ε * smax1 H ≤ ε * (max H 0 + 1) := mul_le_mul_of_nonneg_left hhi hε0.le
      rcases le_total H 0 with hH0 | hH0
      · rw [max_eq_right hH0, zero_add, mul_one] at hup
        constructor <;> linarith
      · rw [max_eq_left hH0, mul_add, mul_one] at hup
        constructor <;> linarith
  
  have hf₂T : ∀ j, ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f₂ j) (T j) := by
    intro j
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (farPot δ) {x : E3 | 1 < ‖x‖} :=
      contMDiffOn_iff_contDiffOn.mpr hφcd
    have h2 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (hAF.ends j).Φ.symm (T j) :=
      (hAF.ends j).Φ.contMDiffOn_invFun.mono (hTtarget j)
    have h3 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (farPot δ ∘ (hAF.ends j).Φ.symm) (T j) := by
      refine h1.comp h2 ?_
      intro q hq
      obtain ⟨x, hx, hxq⟩ := (hTmem j q).1 hq
      show 1 < ‖(hAF.ends j).Φ.symm q‖
      rw [← hxq, hleft j x (by linarith)]; linarith
    refine ((contMDiffOn_const (c := a)).mul h3).congr (fun q _ => ?_)
    rw [hf₂]; rfl
  have hFsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    apply contMDiff_of_locally_contMDiffOn
    intro p
    rcases hcover p with hpO | ⟨j, hj⟩
    · refine ⟨O, hOopen, hpO, ?_⟩
      exact (hfsm.contMDiffOn.sub contMDiffOn_const).congr (fun q hq => hFO q hq)
    · refine ⟨T j, hTopen j, hj, ?_⟩
      have hf' : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun q => f q - β) (T j) :=
        hfsm.contMDiffOn.sub contMDiffOn_const
      have hh : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun q => (f₂ j q - (f q - β)) / ε) (T j) :=
        ((hf₂T j).sub hf').div_const ε
      exact (hf'.add (contMDiffOn_const.mul (hsm_cd.contMDiff.comp_contMDiffOn hh))).congr
        (fun q hq => hFT j q hq)
  
  have hsup : ∀ p, 0 ≤ 16 * lapM g F p + g.scalarCurvature p := by
    intro p
    rcases hcover p with hpO | ⟨j, hj⟩
    · have hev : F =ᶠ[𝓝 p] (fun q => f q - β) :=
        Filter.eventuallyEq_of_mem (hOopen.mem_nhds hpO) (fun q hq => hFO q hq)
      rw [lapM_congr _ _ p hev, lapM_sub_const]
      exact hfsup p
    · obtain ⟨x, hx, hxp⟩ := (hTmem j p).1 hj
      have hx1 : 1 < ‖x‖ := by linarith
      have hxs : x ∈ (hAF.ends j).Φ.source := by rw [hsrc j]; exact hx1
      have hy : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
      obtain ⟨U, hU⟩ : ∃ U : Set E3,
          U = (chartAt E3 p).target ∩ (chartAt E3 p).symm ⁻¹' T j := ⟨_, rfl⟩
      have hUopen : IsOpen U := by
        rw [hU]; exact (chartAt E3 p).isOpen_inter_preimage_symm (hTopen j)
      have hUsub : U ⊆ (chartAt E3 p).target := by rw [hU]; exact Set.inter_subset_left
      have hyU : chartAt E3 p p ∈ U := by
        rw [hU]
        refine ⟨hy, ?_⟩
        show (chartAt E3 p).symm (chartAt E3 p p) ∈ T j
        rw [(chartAt E3 p).left_inv (mem_chart_source E3 p)]
        exact hj
      obtain ⟨u₁, hu₁⟩ : ∃ u₁ : E3 → ℝ, u₁ = fun z => f ((chartAt E3 p).symm z) - β :=
        ⟨_, rfl⟩
      obtain ⟨u₂, hu₂⟩ : ∃ u₂ : E3 → ℝ, u₂ = fun z => f₂ j ((chartAt E3 p).symm z) :=
        ⟨_, rfl⟩
      have hu₁cd : ContDiffOn ℝ ∞ u₁ U := by
        have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun z => f ((chartAt E3 p).symm z) - β)
            (chartAt E3 p).target :=
          (hfsm.comp_contMDiffOn contMDiffOn_chart_symm).sub contMDiffOn_const
        rw [hu₁]
        exact (contMDiffOn_iff_contDiffOn.mp this).mono hUsub
      have hu₂cd : ContDiffOn ℝ ∞ u₂ U := by
        have : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f₂ j ∘ (chartAt E3 p).symm) U :=
          (hf₂T j).comp (contMDiffOn_chart_symm.mono hUsub)
            (by rw [hU]; exact fun z hz => hz.2)
        rw [hu₂]
        exact contMDiffOn_iff_contDiffOn.mp this
      have hGcd : ∀ i l : Fin 3,
          ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 p).symm z i l) U :=
        fun i l => (g.smooth p i l).mono hUsub
      have hpsd := hpsd_of _ (hPD2 p _ hy).inv
      obtain ⟨s, hs0, hs1, hineq⟩ := smax1_lap_ge (g.coeff (chartAt E3 p).symm) u₁ u₂ U hUopen
        (chartAt E3 p p) hyU hGcd hu₁cd hu₂cd hpsd ε hε0
      have hFeq : (F ∘ (chartAt E3 p).symm) =ᶠ[𝓝 (chartAt E3 p p)]
          (fun z => u₁ z + ε * smax1 ((u₂ z - u₁ z) / ε)) := by
        filter_upwards [hUopen.mem_nhds hyU] with z hz
        have hzT : (chartAt E3 p).symm z ∈ T j := by rw [hU] at hz; exact hz.2
        rw [hu₁, hu₂]
        exact hFT j _ hzT
      have hLF : lapM g F p = lapLocal (g.coeff (chartAt E3 p).symm)
          (fun z => u₁ z + ε * smax1 ((u₂ z - u₁ z) / ε)) (chartAt E3 p p) :=
        H1 _ _ _ _ hFeq
      have hL1 : lapLocal (g.coeff (chartAt E3 p).symm) u₁ (chartAt E3 p p) = lapM g f p := by
        rw [hu₁]
        exact H2' _ (f ∘ (chartAt E3 p).symm) β _
      have hL2 : lapLocal (g.coeff (chartAt E3 p).symm) u₂ (chartAt E3 p p) =
          lapM g (f₂ j) p := by
        rw [hu₂]; rfl
      have h2 := lapLocal_chart_invariant g (hAF.ends j).Φ (f₂ j) (T j) (hTopen j) (hf₂T j) x
        hxs (by rw [hxp]; exact hj)
      rw [hxp] at h2
      have h3 : lapLocal (g.coeff (hAF.ends j).Φ) (f₂ j ∘ (hAF.ends j).Φ) x =
          lapLocal (g.coeff (hAF.ends j).Φ) (fun y => a * farPot δ y + 0) x := by
        apply H1
        filter_upwards [(hAF.ends j).Φ.open_source.mem_nhds hxs] with y hy
        have hy1 : 1 < ‖y‖ := by rw [hsrc j] at hy; exact hy
        show f₂ j ((hAF.ends j).Φ y) = a * farPot δ y + 0
        rw [hf₂at j y hy1, add_zero]
      have h4 := H2 (g.coeff (hAF.ends j).Φ) (farPot δ) a 0 x
      have hpos : 0 ≤ lapLocal (g.coeff (hAF.ends j).Φ) (farPot δ) x := by
        refine le_trans ?_ ((hR0 j).2 x (by linarith [hrR0 j])).1
        exact mul_nonneg (div_nonneg (mul_nonneg hδ0.le (by linarith)) (by norm_num))
          (Real.rpow_nonneg (norm_nonneg _) _)
      have hL2pos : 0 ≤ lapM g (f₂ j) p := by
        rw [← h2, h3, h4]; exact mul_nonneg ha0.le hpos
      have hRp := hR p
      have hsupf := hfsup p
      rw [hLF]
      rw [hL1, hL2] at hineq
      nlinarith [mul_nonneg (sub_nonneg.2 hs1) hsupf, mul_nonneg hs0 hL2pos,
        mul_nonneg hs0 hRp]
  
  obtain ⟨w, hw⟩ : ∃ w : M → ℝ, w = fun q => 1 - F q := ⟨_, rfl⟩
  have hwq : ∀ q, w q = 1 - F q := fun q => by rw [hw]
  have hwsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w := by
    rw [hw]; exact contMDiff_const.sub hFsm
  have hwlo : ∀ q, 1 / 2 ≤ w q := fun q => by rw [hwq]; have := (hFb q).2; linarith
  have hwhi : ∀ q, w q ≤ 9 / 8 := fun q => by rw [hwq]; have := (hFb q).1; linarith
  have hwpos : ∀ q, 0 < w q := fun q => by have := hwlo q; linarith
  obtain ⟨g', hg'⟩ := conformal_metric_exists g w hwsm hwpos
  have hcoeff : ∀ (φ : E3 → M) (y : E3), g'.coeff φ y = (w (φ y) ^ 4) • g.coeff φ y := by
    intro φ y
    ext i l
    simp only [RiemannianMetric3.coeff, coeffMatrix, hg', ContinuousLinearMap.smul_apply,
      Matrix.smul_apply, smul_eq_mul]
  have hC' : g'.IsCompleteRiemannian :=
    isCompleteRiemannian_of_conformal g g' w hwsm.continuous (1 / 2) (9 / 8) (by norm_num)
      hwlo hwhi hg' hComplete
  have hR' : ∀ q : M, 0 ≤ g'.scalarCurvature q := by
    intro q
    have hy : chartAt E3 q q ∈ (chartAt E3 q).target := mem_chart_target E3 q
    have hu : ContDiffOn ℝ ∞ (w ∘ (chartAt E3 q).symm) (chartAt E3 q).target :=
      contMDiffOn_iff_contDiffOn.mp (hwsm.comp_contMDiffOn contMDiffOn_chart_symm)
    have key := conformal_scalarCurvatureLocal (g.coeff (chartAt E3 q).symm)
      (w ∘ (chartAt E3 q).symm) (chartAt E3 q).target (chartAt E3 q).open_target (g.smooth q)
      (hsymmG _) (fun z hz => (hPD2 q z hz).det_pos.ne') hu (fun z _ => hwpos _)
      (chartAt E3 q q) hy
    have e1 : g'.scalarCurvature q = scalarCurvatureLocal
        (fun z => ((w ∘ (chartAt E3 q).symm) z ^ 4) • g.coeff (chartAt E3 q).symm z)
        (chartAt E3 q q) := by
      show scalarCurvatureLocal (g'.coeff (chartAt E3 q).symm) (chartAt E3 q q) = _
      congr 1
      funext z
      exact hcoeff _ z
    have e2 : (w ∘ (chartAt E3 q).symm) (chartAt E3 q q) = w q := by
      show w ((chartAt E3 q).symm (chartAt E3 q q)) = w q
      rw [(chartAt E3 q).left_inv (mem_chart_source E3 q)]
    have e3 : lapLocal (g.coeff (chartAt E3 q).symm) (w ∘ (chartAt E3 q).symm)
        (chartAt E3 q q) = -lapM g F q := by
      have : (w ∘ (chartAt E3 q).symm) = fun z => -1 * (F ∘ (chartAt E3 q).symm) z + 1 := by
        funext z; simp only [Function.comp_apply, hwq]; ring
      rw [this, H2]
      show -1 * lapM g F q = -lapM g F q
      ring
    have e4 : scalarCurvatureLocal (g.coeff (chartAt E3 q).symm) (chartAt E3 q q) =
        g.scalarCurvature q := rfl
    rw [e1, key, e2, e3, e4]
    have h1 := hsup q
    have h2 := hR q
    have h3 := (hFb q).2
    have h4 := hwpos q
    have h5 : 0 ≤ -8 * -lapM g F q + g.scalarCurvature q * w q := by
      rw [hwq]
      nlinarith [mul_nonneg h2 (by linarith : (0 : ℝ) ≤ 1 / 2 - F q)]
    exact mul_nonneg (inv_nonneg.mpr (pow_nonneg h4.le 5)) h5
  
  have hρ₂1 : 1 ≤ ρ₂ := by linarith
  have hρ₂2 : 2 ≤ ρ₂ := by linarith
  have hfar_coeff : ∀ (j : Fin hAF.numEnds) (x : E3), ρ₂ < ‖x‖ →
      g'.coeff (hAF.ends j).Φ x = ((1 - a * farPot δ x) ^ 4) • g.coeff (hAF.ends j).Φ x := by
    intro j x hx
    rw [hcoeff, hwq, hFfar j x hx]
  have hmeas : MeasurableSet {x : E3 | 2 < ‖x‖} :=
    measurableSet_lt measurable_const measurable_norm
  have hint' : ∀ j : Fin hAF.numEnds, IntegrableOn
      (fun x : E3 => g'.scalarCurvature ((hAF.ends j).Φ x) *
        Real.sqrt (g'.coeff (hAF.ends j).Φ x).det) {x : E3 | 2 < ‖x‖} := by
    intro j
    have hintG : IntegrableOn (fun x : E3 => scalarCurvatureLocal (g.coeff (hAF.ends j).Φ) x *
        Real.sqrt (g.coeff (hAF.ends j).Φ x).det) {x : E3 | 2 < ‖x‖} := by
      refine (hAF.integrable_scalarCurvature j).congr_fun ?_ hmeas
      intro x hx
      have hxs : x ∈ (hAF.ends j).Φ.source := by
        rw [hsrc j]; show (1 : ℝ) < ‖x‖; have : (2 : ℝ) < ‖x‖ := hx; linarith
      simp only
      rw [scalarCurvature_eq_scalarCurvatureLocal_coeff g _ x hxs]
    have hu : ContDiffOn ℝ ∞ (w ∘ (hAF.ends j).Φ) {x : E3 | 1 < ‖x‖} := by
      rw [← hsrc j]
      exact contMDiffOn_iff_contDiffOn.mp
        (hwsm.comp_contMDiffOn (hAF.ends j).Φ.contMDiffOn_toFun)
    have h9 := conformal_scalar_integrable (g.coeff (hAF.ends j).Φ) (w ∘ (hAF.ends j).Φ)
      hAF.q a δ ρ₂ hδ0 hδq ha0.le ha14 hρ₂2 (hsmooth j) (hsymmG _) (hdetpos j) (hAF.decay j)
      hintG hu (fun x _ => hwpos _)
      (fun x hx => by
        show w ((hAF.ends j).Φ x) = _
        rw [hwq, hFfar j x hx])
    refine h9.congr_fun ?_ hmeas
    intro x hx
    have hxs : x ∈ (hAF.ends j).Φ.source := by
      rw [hsrc j]; show (1 : ℝ) < ‖x‖; have : (2 : ℝ) < ‖x‖ := hx; linarith
    have e : g'.coeff (hAF.ends j).Φ =
        fun y => ((w ∘ (hAF.ends j).Φ) y ^ 4) • g.coeff (hAF.ends j).Φ y :=
      funext fun y => hcoeff _ y
    simp only
    rw [scalarCurvature_eq_scalarCurvatureLocal_coeff g' _ x hxs, e]
  let hAF' : AsymptoticallyFlat g' :=
    { numEnds := hAF.numEnds
      ends := hAF.ends
      q := min hAF.q 1
      q_gt := hq'gt
      disjoint := hAF.disjoint
      isCompact_core := hAF.isCompact_core
      decay := fun j => conformal_decay (g.coeff (hAF.ends j).Φ) (g'.coeff (hAF.ends j).Φ)
        hAF.q a δ ρ₂ hq0 ha0.le ha14 hδ0 hρ₂1 (hsmooth j) (hAF.decay j) (hfar_coeff j)
      integrable_scalarCurvature := hint' }
  
  have hflux := conformal_flux_tendsto (g.coeff (hAF.ends k).Φ) (g'.coeff (hAF.ends k).Φ)
    hAF.q a δ m ρ₂ hq0 ha0.le ha14 hδ0 hρ₂1 (hsmooth k) (hAF.decay k) (hfar_coeff k) hm
  exact ⟨g', hC', hAF', k, m - 2 * a, hR', hflux, by linarith⟩

theorem ricci_symm_local (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (y : E3)
    (hU : IsOpen U) (hy : y ∈ U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U)
    (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i) (hdet : ∀ z ∈ U, (G z).det ≠ 0)
    (j k : Fin 3) : ricci G j k y = ricci G k j y :=
by
  classical
  
  have hyU : U ∈ 𝓝 y := hU.mem_nhds hy
  have hdetx : (G y).det ≠ 0 := hdet y hy
  have hCa : ∀ a b : Fin 3, ContDiffAt ℝ ∞ (fun z => G z a b) y :=
    fun a b => (hG a b).contDiffAt hyU
  have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y :=
    fun a b => (hCa a b).differentiableAt (by simp)
  have hfd : ∀ a b : Fin 3, DifferentiableAt ℝ (fderiv ℝ (fun z => G z a b)) y := fun a b =>
    ((hCa a b).fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)
  have hdG : ∀ c a b : Fin 3,
      DifferentiableAt ℝ (fun w => partialDeriv c (fun z => G z a b) w) y := by
    intro c a b
    show DifferentiableAt ℝ (fun w => fderiv ℝ (fun z => G z a b) w (e c)) y
    exact (hfd a b).clm_apply (differentiableAt_const (e c))
  
  have hkey : ∀ a b c d : Fin 3, partialDeriv c (fun w => partialDeriv d (fun z => G z a b) w) y
      = fderiv ℝ (fderiv ℝ (fun z => G z a b)) y (e c) (e d) := by
    intro a b c d
    show fderiv ℝ (fun w => fderiv ℝ (fun z => G z a b) w (e d)) y (e c) = _
    rw [fderiv_clm_apply (hfd a b) (differentiableAt_const (e d))]
    simp
  have hSchw : ∀ a b c d : Fin 3,
      partialDeriv c (fun w => partialDeriv d (fun z => G z a b) w) y
        = partialDeriv d (fun w => partialDeriv c (fun z => G z a b) w) y := by
    intro a b c d
    rw [hkey, hkey]
    have h2 : minSmoothness ℝ 2 ≤ (∞ : WithTop ℕ∞) := by
      rw [minSmoothness_of_isRCLikeNormedField]
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | decide
    exact (hCa a b).isSymmSndFDerivAt h2 (e c) (e d)
  
  have hfs : ∀ a b : Fin 3, (fun z => G z a b) = (fun z => G z b a) :=
    fun a b => funext fun z => hsymm z a b
  have s1 : ∀ c i' j' : Fin 3, christoffel G c i' j' = christoffel G c j' i' := by
    intro c i' j'
    funext w
    unfold christoffel
    rw [hfs j' i']
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  
  have hdetD : ∀ K : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun w => K w a b) y) →
      DifferentiableAt ℝ (fun w => (K w).det) y := by
    intro K hK
    have hfun : (fun w => (K w).det) = fun w =>
        K w 0 0 * K w 1 1 * K w 2 2 - K w 0 0 * K w 1 2 * K w 2 1
        - K w 0 1 * K w 1 0 * K w 2 2 + K w 0 1 * K w 1 2 * K w 2 0
        + K w 0 2 * K w 1 0 * K w 2 1 - K w 0 2 * K w 1 1 * K w 2 0 := by
      funext w; exact Matrix.det_fin_three (K w)
    rw [hfun]
    have h00 := hK 0 0
    have h01 := hK 0 1
    have h02 := hK 0 2
    have h10 := hK 1 0
    have h11 := hK 1 1
    have h12 := hK 1 2
    have h20 := hK 2 0
    have h21 := hK 2 1
    have h22 := hK 2 2
    fun_prop
  have hD : DifferentiableAt ℝ (fun w => (G w).det) y := hdetD G hGd
  have hP : ∀ c l : Fin 3, DifferentiableAt ℝ (fun w => (G w)⁻¹ c l) y := by
    intro c l
    have hfun : (fun w => (G w)⁻¹ c l) =
        fun w => ((G w).det)⁻¹ * ((G w).updateRow l (Pi.single c 1)).det := by
      funext w
      rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
        smul_eq_mul]
    rw [hfun]
    refine (hD.inv hdetx).mul (hdetD _ ?_)
    intro a b
    by_cases hal : a = l
    · subst hal
      simp only [Matrix.updateRow_self]
      exact differentiableAt_const _
    · simp only [Matrix.updateRow_ne hal]
      exact hGd a b
  have hev : ∀ᶠ w in 𝓝 y, (G w).det ≠ 0 := hD.continuousAt.eventually_ne hdetx
  have hinv : ∀ m c l : Fin 3, partialDeriv m (fun w => (G w)⁻¹ c l) y =
      -∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ c a * partialDeriv m (fun w => G w a b) y * (G y)⁻¹ b l := by
    intro m
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G y a b * partialDeriv m (fun w => (G w)⁻¹ b l) y
        + ∑ b : Fin 3, partialDeriv m (fun w => G w a b) y * (G y)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun w => ∑ b : Fin 3, G w a b * (G w)⁻¹ b l)
          (∑ b : Fin 3, (G y a b • fderiv ℝ (fun w => (G w)⁻¹ b l) y
            + (G y)⁻¹ b l • fderiv ℝ (fun w => G w a b) y)) y := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b w => G w a b * (G w)⁻¹ b l)
          (fun b _ => (hGd a b).hasFDerivAt.mul (hP b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun w => ∑ b : Fin 3, G w a b * (G w)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) y := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) y).congr_of_eventuallyEq
        filter_upwards [hev] with w hw
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G w) (isUnit_iff_ne_zero.mpr hw)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro c l
    let X : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun w => (G w)⁻¹ b l) y
    let DD : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun w => G w a b) y
    have hM : G y * X = -(DD * (G y)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, DD, Matrix.of_apply]
      exact hE a l'
    have hX : X = -((G y)⁻¹ * (DD * (G y)⁻¹)) := by
      calc X = ((G y)⁻¹ * G y) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdetx), Matrix.one_mul]
        _ = (G y)⁻¹ * (G y * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX c) l
    simp only [X, DD, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  have hcf : ∀ m c i' j' : Fin 3, partialDeriv m (christoffel G c i' j') y =
      (1 / 2 : ℝ) * ∑ l : Fin 3,
        (partialDeriv m (fun w => (G w)⁻¹ c l) y *
            (partialDeriv i' (fun z => G z j' l) y + partialDeriv j' (fun z => G z i' l) y
              - partialDeriv l (fun z => G z i' j') y)
          + (G y)⁻¹ c l *
            (partialDeriv m (fun w => partialDeriv i' (fun z => G z j' l) w) y
              + partialDeriv m (fun w => partialDeriv j' (fun z => G z i' l) w) y
              - partialDeriv m (fun w => partialDeriv l (fun z => G z i' j') w) y)) := by
    intro m c i' j'
    have hT : ∀ l ∈ (Finset.univ : Finset (Fin 3)), HasFDerivAt (fun w => (G w)⁻¹ c l *
        (partialDeriv i' (fun z => G z j' l) w + partialDeriv j' (fun z => G z i' l) w
          - partialDeriv l (fun z => G z i' j') w))
        ((G y)⁻¹ c l • (fderiv ℝ (fun w => partialDeriv i' (fun z => G z j' l) w) y
            + fderiv ℝ (fun w => partialDeriv j' (fun z => G z i' l) w) y
            - fderiv ℝ (fun w => partialDeriv l (fun z => G z i' j') w) y)
          + (partialDeriv i' (fun z => G z j' l) y + partialDeriv j' (fun z => G z i' l) y
            - partialDeriv l (fun z => G z i' j') y) • fderiv ℝ (fun w => (G w)⁻¹ c l) y) y := by
      intro l _
      exact (hP c l).hasFDerivAt.fun_mul
        (((hdG i' j' l).hasFDerivAt.fun_add (hdG j' i' l).hasFDerivAt).fun_sub
          (hdG l i' j').hasFDerivAt)
    have hS := (HasFDerivAt.fun_sum hT).const_mul (1 / 2 : ℝ)
    have hDc : HasFDerivAt (christoffel G c i' j') _ y := hS
    show fderiv ℝ (christoffel G c i' j') y (e m) = _
    rw [hDc.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.sum_apply,
      ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply, smul_eq_mul]
    unfold partialDeriv
    congr 1
    refine Finset.sum_congr rfl (fun l _ => ?_)
    ring
  
  have htr : ∀ j' k' : Fin 3, ∑ i : Fin 3, partialDeriv j' (christoffel G i i k') y =
      ∑ i : Fin 3, (1 / 2 : ℝ) * ∑ l : Fin 3,
        ((-∑ a : Fin 3, ∑ b : Fin 3,
            (G y)⁻¹ i a * partialDeriv j' (fun z => G z a b) y * (G y)⁻¹ b l) *
          (partialDeriv i (fun z => G z k' l) y + partialDeriv k' (fun z => G z i l) y
            - partialDeriv l (fun z => G z i k') y)
        + (G y)⁻¹ i l *
          (partialDeriv j' (fun w => partialDeriv i (fun z => G z k' l) w) y
            + partialDeriv j' (fun w => partialDeriv k' (fun z => G z i l) w) y
            - partialDeriv j' (fun w => partialDeriv l (fun z => G z i k') w) y)) := by
    intro j' k'
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hcf j' i i k']
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [hinv j' i l]
  
  have alg : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (D : Fin 3 → Fin 3 → Fin 3 → ℝ)
      (H : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ a b : Fin 3, A a b = A b a) → (∀ c a b : Fin 3, D c a b = D c b a) →
      (∀ m c a b : Fin 3, H m c a b = H c m a b) → (∀ m c a b : Fin 3, H m c a b = H m c b a) →
      ∀ j' k' : Fin 3,
        ∑ i : Fin 3, (1 / 2 : ℝ) * ∑ l : Fin 3,
          ((-∑ a : Fin 3, ∑ b : Fin 3, A i a * D j' a b * A b l) *
              (D i k' l + D k' i l - D l i k')
            + A i l * (H j' i k' l + H j' k' i l - H j' l i k'))
        = ∑ i : Fin 3, (1 / 2 : ℝ) * ∑ l : Fin 3,
          ((-∑ a : Fin 3, ∑ b : Fin 3, A i a * D k' a b * A b l) *
              (D i j' l + D j' i l - D l i j')
            + A i l * (H k' i j' l + H k' j' i l - H k' l i j')) := by
    intro A D H hA hD hH1 hH2 j' k'
    have a10 := hA 1 0
    have a20 := hA 2 0
    have a21 := hA 2 1
    have d10 : ∀ c, D c 1 0 = D c 0 1 := fun c => hD c 1 0
    have d20 : ∀ c, D c 2 0 = D c 0 2 := fun c => hD c 2 0
    have d21 : ∀ c, D c 2 1 = D c 1 2 := fun c => hD c 2 1
    have h10 : ∀ m c, H m c 1 0 = H m c 0 1 := fun m c => hH2 m c 1 0
    have h20 : ∀ m c, H m c 2 0 = H m c 0 2 := fun m c => hH2 m c 2 0
    have h21 : ∀ m c, H m c 2 1 = H m c 1 2 := fun m c => hH2 m c 2 1
    have g10 : ∀ a b, H 1 0 a b = H 0 1 a b := fun a b => hH1 1 0 a b
    have g20 : ∀ a b, H 2 0 a b = H 0 2 a b := fun a b => hH1 2 0 a b
    have g21 : ∀ a b, H 2 1 a b = H 1 2 a b := fun a b => hH1 2 1 a b
    fin_cases j' <;> fin_cases k' <;>
      simp only [Fin.sum_univ_three, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk] <;>
      (try simp only [a10, a20, a21, d10, d20, d21, h10, h20, h21, g10, g20, g21]) <;>
      ring
  
  have hGT : (G y).transpose = G y := by
    ext a b; exact hsymm y b a
  have hA : ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a := by
    intro a b
    have h := congrFun (congrFun (Matrix.transpose_nonsing_inv (G y)) b) a
    rw [hGT, Matrix.transpose_apply] at h
    exact h
  have e3 := alg (G y)⁻¹ (fun c a b => partialDeriv c (fun z => G z a b) y)
    (fun m c a b => partialDeriv m (fun w => partialDeriv c (fun z => G z a b) w) y) hA
    (fun c a b => by
      show partialDeriv c (fun z => G z a b) y = partialDeriv c (fun z => G z b a) y
      rw [hfs a b])
    (fun m c a b => hSchw a b m c)
    (fun m c a b => by
      show partialDeriv m (fun w => partialDeriv c (fun z => G z a b) w) y
        = partialDeriv m (fun w => partialDeriv c (fun z => G z b a) w) y
      rw [hfs a b])
    j k
  beta_reduce at e3
  
  have hd1 : ∑ i : Fin 3, partialDeriv i (christoffel G i j k) y
      = ∑ i : Fin 3, partialDeriv i (christoffel G i k j) y :=
    Finset.sum_congr rfl fun i _ => by rw [s1 i j k]
  have hq : ∑ i : Fin 3, ∑ p : Fin 3,
        (christoffel G i i p y * christoffel G p j k y - christoffel G i j p y * christoffel G p i k y)
      = ∑ i : Fin 3, ∑ p : Fin 3,
        (christoffel G i i p y * christoffel G p k j y - christoffel G i k p y * christoffel G p i j y) := by
    simp only [Finset.sum_sub_distrib]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ => ?_
      rw [s1 p j k]
    · conv_lhs => rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ => ?_
      rw [s1 p j i, s1 i p k]
      ring
  have e1 : ∀ a b : Fin 3, ∑ i : Fin 3, (partialDeriv i (christoffel G i a b) y
        - partialDeriv a (christoffel G i i b) y)
      = ∑ i : Fin 3, partialDeriv i (christoffel G i a b) y
        - ∑ i : Fin 3, partialDeriv a (christoffel G i i b) y := fun a b => Finset.sum_sub_distrib _ _
  have h2 := htr j k
  have h3 := htr k j
  unfold ricci
  linarith [e1 j k, e1 k j, hd1, h2, h3, e3, hq]

theorem static_hessian_identity (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (U : Set E3)
    (y : E3) (hU : IsOpen U) (hy : y ∈ U) (hf : ContDiffOn ℝ ∞ f U)
    (hsymm : ∀ (z : E3) (i j : Fin 3), G z i j = G z j i) (hdet : (G y).det ≠ 0)
    (hR : scalarCurvatureLocal G y = 0) (hS : ∀ i j : Fin 3, staticSymLoc G f i j y = 0) :
    ∀ i j : Fin 3, partialDeriv i (partialDeriv j f) y =
      ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f y +
        f y * ((ricci G i j y + ricci G j i y) / 2) :=
by
  classical
  
  have hfa : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hU.mem_nhds hy)
  have hd : DifferentiableAt ℝ (fderiv ℝ f) y :=
    (hfa.fderiv_right (m := 1) (by
      first
      | exact_mod_cast (le_top : ((1 + 1 : ℕ) : ℕ∞) ≤ ⊤)
      | exact WithTop.coe_le_coe.2 le_top
      | simp
      | norm_num)).differentiableAt one_ne_zero
  have hD2 : ∀ a b : Fin 3,
      partialDeriv a (partialDeriv b f) y = fderiv ℝ (fderiv ℝ f) y (e a) (e b) := by
    intro a b
    have h1 : partialDeriv b f = fun z => fderiv ℝ f z (e b) := rfl
    rw [h1]
    show fderiv ℝ (fun z => fderiv ℝ f z (e b)) y (e a) = _
    rw [fderiv_clm_apply hd (differentiableAt_const _)]
    simp
  have hsymD : IsSymmSndFDerivAt ℝ f y :=
    hfa.isSymmSndFDerivAt (by
      simp only [minSmoothness_of_isRCLikeNormedField]
      first
      | exact_mod_cast (le_top : ((2 : ℕ) : ℕ∞) ≤ ⊤)
      | exact WithTop.coe_le_coe.2 le_top
      | simp
      | norm_num)
  have hcomm : ∀ a b : Fin 3,
      partialDeriv a (partialDeriv b f) y = partialDeriv b (partialDeriv a f) y := by
    intro a b
    rw [hD2, hD2]
    exact hsymD.eq _ _
  
  have hΓ : ∀ k a b : Fin 3, christoffel G k a b y = christoffel G k b a y := by
    intro k a b
    unfold christoffel
    rw [show (fun z => G z b a) = (fun z => G z a b) from funext fun z => hsymm z b a]
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  
  have hH : ∀ a b : Fin 3, hessLoc G f a b y = hessLoc G f b a y := by
    intro a b
    unfold hessLoc
    rw [hcomm a b]
    congr 1
    exact Finset.sum_congr rfl fun k _ => by rw [hΓ k a b]
  
  have hAT : (G y).transpose = G y := by
    ext a b
    exact hsymm y b a
  have hBT : ((G y)⁻¹).transpose = (G y)⁻¹ := by
    rw [Matrix.transpose_nonsing_inv, hAT]
  have hB : ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a := by
    intro a b
    calc (G y)⁻¹ a b = ((G y)⁻¹).transpose a b := by rw [hBT]
      _ = (G y)⁻¹ b a := rfl
  
  have hunit : IsUnit (G y).det := isUnit_iff_ne_zero.2 hdet
  have hinv := Matrix.nonsing_inv_mul (G y) hunit
  have hdiag : ∀ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * G y a b = 1 := by
    intro a
    have h1 := congrFun (congrFun hinv a) a
    rw [Matrix.mul_apply, Matrix.one_apply_eq] at h1
    calc ∑ b : Fin 3, (G y)⁻¹ a b * G y a b = ∑ b : Fin 3, (G y)⁻¹ a b * G y b a :=
          Finset.sum_congr rfl fun b _ => by rw [hsymm y a b]
      _ = 1 := h1
  have hdiagSum : ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * G y a b = 3 := by
    rw [Finset.sum_congr rfl fun a _ => hdiag a]
    norm_num
  
  have hR1 : ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * ricci G a b y = 0 := hR
  have hR2 : ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * ricci G b a y = 0 := by
    rw [Finset.sum_comm, ← hR1]
    exact Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => by rw [hB a b]
  
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = lapLoc G f y := ⟨_, rfl⟩
  have hLsum : L = ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * hessLoc G f a b y := by
    rw [hLdef]; rfl
  have hHE : ∀ a b : Fin 3, hessLoc G f a b y =
      f y * ((ricci G a b y + ricci G b a y) / 2) + L * G y a b := by
    intro a b
    have h1 := hS a b
    simp only [staticSymLoc, staticLoc] at h1
    rw [← hLdef, hH b a, hsymm y b a] at h1
    linarith
  
  have h3 : ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * hessLoc G f a b y =
      f y / 2 * (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * ricci G a b y) +
      f y / 2 * (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * ricci G b a y) +
      L * (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * G y a b) := by
    simp only [Fin.sum_univ_three, hHE]
    ring
  rw [hR1, hR2, hdiagSum, ← hLsum] at h3
  have hL0 : L = 0 := by linarith
  intro i j
  have h1 := hHE i j
  rw [hL0] at h1
  unfold hessLoc at h1
  linarith

theorem christoffel_ricci_decay (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ))) :
    ∃ R' C' : ℝ, 1 ≤ R' ∧ 0 ≤ C' ∧ ∀ x : E3, R' < ‖x‖ → 0 < (G x).det ∧
      (∀ k i j : Fin 3, |christoffel G k i j x| ≤ C' * ‖x‖ ^ (-q - 1)) ∧
      (∀ i j : Fin 3, |ricci G i j x| ≤ C' * ‖x‖ ^ (-q - 2)) :=
by
  obtain ⟨R, C, hR1, hC0, hb⟩ := metric_coeff_bounds G q hq hsmooth hdecay
  
  have hpd : ∀ (f : E3 → ℝ) (y : E3) (i : Fin 3), |partialDeriv i f y| ≤ ‖fderiv ℝ f y‖ := by
    intro f y i
    have h1 := (fderiv ℝ f y).le_opNorm (e i)
    have h2 : ‖e i‖ = 1 := by
      rw [show e i = EuclideanSpace.single i (1 : ℝ) from rfl, EuclideanSpace.norm_single,
        norm_one]
    rw [h2, mul_one, Real.norm_eq_abs] at h1
    exact h1
  
  have hU : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hdiff : ∀ x : E3, 1 < ‖x‖ → ∀ a b c : Fin 3,
      DifferentiableAt ℝ (fun y => G y a b) x ∧
      DifferentiableAt ℝ (fun y => partialDeriv c (fun z => G z a b) y) x := by
    intro x hx a b c
    have hxU : {x : E3 | 1 < ‖x‖} ∈ 𝓝 x := hU.mem_nhds hx
    constructor
    · exact ((hsmooth a b).contDiffAt hxU).differentiableAt (by simp)
    · have h1 := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).1 (hsmooth a b)).2
      have h2 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ (fun z => G z a b) y (e c))
          {x : E3 | 1 < ‖x‖} := h1.clm_apply contDiffOn_const
      exact (h2.contDiffAt hxU).differentiableAt (by simp)
  
  have tri : ∀ X Y : ℝ, |X - Y| ≤ |X| + |Y| := by
    intro X Y
    rw [abs_le]
    constructor <;> linarith [le_abs_self X, neg_abs_le X, le_abs_self Y, neg_abs_le Y]
  have tri2 : ∀ X Y : ℝ, |X| ≤ |X - Y| + |Y| := by
    intro X Y
    have := abs_sub_abs_le_abs_sub X Y
    linarith
  
  have hric : ∀ (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (dΓ : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ)
      (A D : ℝ), (∀ k i j, |Γ k i j| ≤ A) → (∀ m k i j, |dΓ m k i j| ≤ D) → ∀ j k : Fin 3,
      |∑ i : Fin 3, (dΓ i i j k - dΓ j i i k) + ∑ i : Fin 3, ∑ p : Fin 3,
        (Γ i i p * Γ p j k - Γ i j p * Γ p i k)| ≤ 6 * D + 18 * A ^ 2 := by
    intro Γ dΓ A D hΓ hdΓ j k
    have hA : 0 ≤ A := (abs_nonneg _).trans (hΓ 0 0 0)
    have t1 : ∀ i, |dΓ i i j k - dΓ j i i k| ≤ 2 * D := fun i =>
      (tri _ _).trans (by linarith [hdΓ i i j k, hdΓ j i i k])
    have t2 : ∀ i p, |Γ i i p * Γ p j k - Γ i j p * Γ p i k| ≤ 2 * A ^ 2 := by
      intro i p
      have e1 : |Γ i i p * Γ p j k| ≤ A * A := by
        rw [abs_mul]; exact mul_le_mul (hΓ _ _ _) (hΓ _ _ _) (abs_nonneg _) hA
      have e2 : |Γ i j p * Γ p i k| ≤ A * A := by
        rw [abs_mul]; exact mul_le_mul (hΓ _ _ _) (hΓ _ _ _) (abs_nonneg _) hA
      calc _ ≤ |Γ i i p * Γ p j k| + |Γ i j p * Γ p i k| := tri _ _
        _ ≤ 2 * A ^ 2 := by nlinarith
    calc _ ≤ |∑ i : Fin 3, (dΓ i i j k - dΓ j i i k)| + |∑ i : Fin 3, ∑ p : Fin 3,
          (Γ i i p * Γ p j k - Γ i j p * Γ p i k)| := abs_add_le _ _
      _ ≤ ∑ i : Fin 3, |dΓ i i j k - dΓ j i i k| + ∑ i : Fin 3, ∑ p : Fin 3,
          |Γ i i p * Γ p j k - Γ i j p * Γ p i k| := by
          gcongr
          · exact Finset.abs_sum_le_sum_abs _ _
          · exact (Finset.abs_sum_le_sum_abs _ _).trans
              (Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ 6 * D + 18 * A ^ 2 := by
          simp only [Fin.sum_univ_three]
          linarith [t1 0, t1 1, t1 2, t2 0 0, t2 0 1, t2 0 2, t2 1 0, t2 1 1, t2 1 2,
            t2 2 0, t2 2 1, t2 2 2]
  
  set B : ℝ := 1 + C with hBdef
  have hB0 : 0 ≤ B := by rw [hBdef]; linarith
  have hCp : 0 ≤ 9720 * B ^ 4 * C ^ 2 + 324 * B ^ 2 * C ^ 2 + 9 * C :=
    add_nonneg (by positivity) (by linarith)
  have hC'0 : 0 ≤ 18 * B ^ 2 * C + 9720 * B ^ 4 * C ^ 2 + 324 * B ^ 2 * C ^ 2 + 9 * C := by
    have : 0 ≤ 18 * B ^ 2 * C := mul_nonneg (by positivity) hC0
    linarith
  refine ⟨R, 18 * B ^ 2 * C + 9720 * B ^ 4 * C ^ 2 + 324 * B ^ 2 * C ^ 2 + 9 * C, hR1,
    hC'0, ?_⟩
  intro x hx
  have hx1 : 1 < ‖x‖ := lt_of_le_of_lt hR1 hx
  have hr0 : 0 < ‖x‖ := by linarith
  obtain ⟨hdet, hb'⟩ := hb x hx
  have hu0n : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hr0.le _
  have hu1n : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hr0.le _
  have hu2n : 0 ≤ ‖x‖ ^ (-q - 2) := Real.rpow_nonneg hr0.le _
  have hu0 : ‖x‖ ^ (-q) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx1.le (by linarith)
  have hu11 : ‖x‖ ^ (-q - 1) * ‖x‖ ^ (-q - 1) ≤ ‖x‖ ^ (-q - 2) := by
    have e1 : ‖x‖ ^ (-q - 1) * ‖x‖ ^ (-q - 1) = ‖x‖ ^ (-q - 2) * ‖x‖ ^ (-q) := by
      rw [← Real.rpow_add hr0, ← Real.rpow_add hr0]
      congr 1
      ring
    rw [e1]
    nlinarith
  set u0 := ‖x‖ ^ (-q) with hu0def
  set u1 := ‖x‖ ^ (-q - 1) with hu1def
  set u2 := ‖x‖ ^ (-q - 2) with hu2def
  have hαn : 0 ≤ C * u1 := mul_nonneg hC0 hu1n
  have hGB : ∀ a b : Fin 3, |G x a b| ≤ B := by
    intro a b
    have h1 := (hb' a b 0).1
    have h2 : |(if a = b then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    have h3 : C * u0 ≤ C := mul_le_of_le_one_right hC0 hu0
    calc |G x a b| = |(G x a b - (if a = b then (1 : ℝ) else 0)) +
          (if a = b then (1 : ℝ) else 0)| := by rw [sub_add_cancel]
      _ ≤ _ := abs_add_le _ _
      _ ≤ B := by rw [hBdef]; linarith
  have hε : ∀ a b : Fin 3, |G x a b - (if a = b then (1 : ℝ) else 0)| ≤ C * u0 :=
    fun a b => (hb' a b 0).1
  have hα : ∀ c a b : Fin 3, |partialDeriv c (fun z => G z a b) x| ≤ C * u1 :=
    fun c a b => (hpd _ x c).trans (hb' a b 0).2.1
  have hβ : ∀ m c a b : Fin 3,
      |partialDeriv m (fun y => partialDeriv c (fun z => G z a b) y) x| ≤ C * u2 :=
    fun m c a b => (hpd _ x m).trans (hb' a b c).2.2
  have hinv := inv3_entry_bounds (G x) B (C * u0) hdet hGB hε
  have hdet0 : (G x).det ≠ 0 := (lt_of_lt_of_le (by norm_num) hdet).ne'
  have hPd : ∀ m k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
      partialDeriv m (fun y => (G y)⁻¹ k l) x = -∑ a : Fin 3, ∑ b : Fin 3,
        (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l :=
    fun m => inv_entry_partialDeriv G x (fun a b => (hdiff x hx1 a b 0).1) hdet0 m
  have hdPb : ∀ m k l : Fin 3,
      |partialDeriv m (fun y => (G y)⁻¹ k l) x| ≤ 144 * B ^ 4 * (C * u1) := by
    intro m k l
    rw [(hPd m k l).2, abs_neg]
    have hterm : ∀ a b : Fin 3,
        |(G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l| ≤
          4 * B ^ 2 * (C * u1) * (4 * B ^ 2) := by
      intro a b
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul (hinv k a).1 (hα m a b) (abs_nonneg _) (by positivity))
        (hinv b l).1 (abs_nonneg _) (mul_nonneg (by positivity) hαn)
    calc _ ≤ ∑ a : Fin 3, ∑ b : Fin 3,
          |(G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l| :=
          (Finset.abs_sum_le_sum_abs _ _).trans
            (Finset.sum_le_sum fun a _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ ∑ a : Fin 3, ∑ b : Fin 3, 4 * B ^ 2 * (C * u1) * (4 * B ^ 2) :=
          Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun b _ => hterm a b
      _ = 144 * B ^ 4 * (C * u1) := by simp only [Fin.sum_univ_three]; ring
  have hcv := fun m k i j => christoffel_value_bounds (G x)⁻¹
    (fun m k l => partialDeriv m (fun y => (G y)⁻¹ k l) x)
    (fun c a b => partialDeriv c (fun z => G z a b) x)
    (fun m c a b => partialDeriv m (fun y => partialDeriv c (fun z => G z a b) y) x)
    (4 * B ^ 2) (12 * B ^ 2 * (C * u0)) (144 * B ^ 4 * (C * u1)) (C * u1) (C * u2)
    (fun k l => (hinv k l).1) (fun k l => (hinv k l).2) hdPb hα hβ m k i j
  have hΓ : ∀ k i j : Fin 3, |christoffel G k i j x| ≤ 18 * B ^ 2 * (C * u1) := by
    intro k i j
    have h := (hcv 0 k i j).1
    have h' : |christoffel G k i j x| ≤ 9 / 2 * (4 * B ^ 2) * (C * u1) := h
    linarith
  have hdΓ : ∀ m k i j : Fin 3, |partialDeriv m (christoffel G k i j) x| ≤
      648 * B ^ 4 * (C * u1) ^ 2 + 54 * B ^ 2 * (C * u0) * (C * u2) + 3 / 2 * (C * u2) := by
    intro m k i j
    have h := (hcv m k i j).2
    rw [christoffel_partialDeriv_formula G x (fun k l => (hPd 0 k l).1)
      (fun c a b => (hdiff x hx1 a b c).2) m k i j]
    refine (tri2 _ ((1 / 2 : ℝ) *
      (partialDeriv m (fun y => partialDeriv i (fun z => G z j k) y) x
        + partialDeriv m (fun y => partialDeriv j (fun z => G z i k) y) x
        - partialDeriv m (fun y => partialDeriv k (fun z => G z i j) y) x))).trans ?_
    have h1 := abs_le.1 (hβ m i j k)
    have h2 := abs_le.1 (hβ m j i k)
    have h3 := abs_le.1 (hβ m k i j)
    have hY : |(1 / 2 : ℝ) *
        (partialDeriv m (fun y => partialDeriv i (fun z => G z j k) y) x
          + partialDeriv m (fun y => partialDeriv j (fun z => G z i k) y) x
          - partialDeriv m (fun y => partialDeriv k (fun z => G z i j) y) x)| ≤ 3 / 2 * (C * u2) :=
      abs_le.2 ⟨by linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2],
        by linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]⟩
    have h' := add_le_add h hY
    refine h'.trans (le_of_eq ?_)
    ring
  have hRic : ∀ i j : Fin 3, |ricci G i j x| ≤
      9720 * B ^ 4 * (C * u1) ^ 2 + 324 * B ^ 2 * (C * u0) * (C * u2) + 9 * (C * u2) := by
    intro i j
    have h := hric (fun k i j => christoffel G k i j x)
      (fun m k i j => partialDeriv m (christoffel G k i j) x) _ _ hΓ hdΓ i j
    have h' : |ricci G i j x| ≤ 6 * (648 * B ^ 4 * (C * u1) ^ 2 +
        54 * B ^ 2 * (C * u0) * (C * u2) + 3 / 2 * (C * u2)) +
        18 * (18 * B ^ 2 * (C * u1)) ^ 2 := h
    refine h'.trans (le_of_eq ?_)
    ring
  refine ⟨by linarith, fun k i j => ?_, fun i j => ?_⟩
  · calc |christoffel G k i j x| ≤ 18 * B ^ 2 * (C * u1) := hΓ k i j
      _ ≤ (18 * B ^ 2 * C + 9720 * B ^ 4 * C ^ 2 + 324 * B ^ 2 * C ^ 2 + 9 * C) * u1 := by
          nlinarith [mul_nonneg hCp hu1n]
  · have f1 : B ^ 4 * (C ^ 2 * (u1 * u1)) ≤ B ^ 4 * (C ^ 2 * u2) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hu11 (sq_nonneg C)) (by positivity)
    have f2 : B ^ 2 * (C ^ 2 * (u0 * u2)) ≤ B ^ 2 * (C ^ 2 * u2) := by
      have : u0 * u2 ≤ u2 := by nlinarith
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left this (sq_nonneg C))
        (by positivity)
    have f3 : 0 ≤ 18 * B ^ 2 * C * u2 := mul_nonneg (mul_nonneg (by positivity) hC0) hu2n
    calc |ricci G i j x| ≤ 9720 * B ^ 4 * (C * u1) ^ 2 + 324 * B ^ 2 * (C * u0) * (C * u2) +
          9 * (C * u2) := hRic i j
      _ ≤ (18 * B ^ 2 * C + 9720 * B ^ 4 * C ^ 2 + 324 * B ^ 2 * C ^ 2 + 9 * C) * u2 := by
          nlinarith [f1, f2, f3]

theorem decaying_hessian_rigidity (f : E3 → ℝ) (A : Fin 3 → Fin 3 → Fin 3 → E3 → ℝ)
    (B : Fin 3 → Fin 3 → E3 → ℝ) (q β R C : ℝ) (hq : 0 < q) (hβ : 1 < β) (hR : 1 ≤ R)
    (hf : ContDiffOn ℝ ∞ f {x : E3 | R < ‖x‖})
    (hA : ∀ x : E3, R < ‖x‖ → ∀ k i j : Fin 3, |A k i j x| ≤ C * ‖x‖ ^ (-q - 1))
    (hB : ∀ x : E3, R < ‖x‖ → ∀ i j : Fin 3, |B i j x| ≤ C * ‖x‖ ^ (-q - 2))
    (hf0 : ∀ x : E3, R < ‖x‖ → |f x| ≤ C * ‖x‖ ^ (1 - β))
    (hdf : ∀ x : E3, R < ‖x‖ → ‖fderiv ℝ f x‖ ≤ C * ‖x‖ ^ (-β))
    (heq : ∀ x : E3, R < ‖x‖ → ∀ i j : Fin 3, partialDeriv i (partialDeriv j f) x =
      ∑ k : Fin 3, A k i j x * partialDeriv k f x + B i j x * f x) :
    ∃ ρ : ℝ, ∀ x : E3, ρ < ‖x‖ → f x = 0 :=
by
  
  have tail : ∀ (F F' : ℝ → ℝ) (a M γ : ℝ), 0 ≤ a → 1 < γ →
      (∀ τ, a < τ → HasDerivAt F (F' τ) τ) → (∀ τ, a < τ → |F' τ| ≤ M * τ ^ (-γ)) →
      Tendsto F atTop (𝓝 0) → ∀ s, a < s → |F s| ≤ M * s ^ (1 - γ) / (γ - 1) := by
    intro F F' a M γ ha hγ hd hb hF s hs
    have hγ1 : (0:ℝ) < γ - 1 := by linarith
    set Φ : ℝ → ℝ := fun τ => M * τ ^ (1 - γ) / (γ - 1) with hΦdef
    have hΦ : ∀ τ, 0 < τ → HasDerivAt Φ (-(M * τ ^ (-γ))) τ := by
      intro τ hτ
      have h1 := ((Real.hasDerivAt_rpow_const (p := 1 - γ) (Or.inl hτ.ne')).const_mul M).div_const
        (γ - 1)
      convert h1 using 1
      rw [show 1 - γ - 1 = -γ by ring]
      field_simp
      ring
    have hΦlim : Tendsto Φ atTop (𝓝 0) := by
      have h1 : Tendsto (fun τ : ℝ => τ ^ (-(γ - 1))) atTop (𝓝 0) := tendsto_rpow_neg_atTop hγ1
      have h2 := (h1.const_mul M).div_const (γ - 1)
      rw [mul_zero, zero_div] at h2
      refine h2.congr' ?_
      filter_upwards with τ
      simp only [hΦdef]
      rw [show 1 - γ = -(γ - 1) by ring]
    have hint : interior (Set.Ici s) = Set.Ioi s := interior_Ici
    have hcont : ∀ τ ∈ Set.Ici s, ContinuousAt F τ ∧ ContinuousAt Φ τ := by
      intro τ hτ
      have hτ' : a < τ := lt_of_lt_of_le hs hτ
      exact ⟨(hd τ hτ').continuousAt, (hΦ τ (by linarith)).continuousAt⟩
    have hanti : AntitoneOn (fun τ => F τ + Φ τ) (Set.Ici s) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos (f' := fun τ => F' τ + -(M * τ ^ (-γ)))
        (convex_Ici s)
      · intro τ hτ
        exact ((hcont τ hτ).1.add (hcont τ hτ).2).continuousWithinAt
      · intro τ hτ
        rw [hint] at hτ
        have hτ' : a < τ := lt_trans hs hτ
        exact ((hd τ hτ').add (hΦ τ (by linarith))).hasDerivWithinAt
      · intro τ hτ
        rw [hint] at hτ
        have hτ' : a < τ := lt_trans hs hτ
        have := (abs_le.1 (hb τ hτ')).2
        linarith
    have hmono : MonotoneOn (fun τ => F τ - Φ τ) (Set.Ici s) := by
      apply monotoneOn_of_hasDerivWithinAt_nonneg (f' := fun τ => F' τ - -(M * τ ^ (-γ)))
        (convex_Ici s)
      · intro τ hτ
        exact ((hcont τ hτ).1.sub (hcont τ hτ).2).continuousWithinAt
      · intro τ hτ
        rw [hint] at hτ
        have hτ' : a < τ := lt_trans hs hτ
        exact ((hd τ hτ').sub (hΦ τ (by linarith))).hasDerivWithinAt
      · intro τ hτ
        rw [hint] at hτ
        have hτ' : a < τ := lt_trans hs hτ
        have := (abs_le.1 (hb τ hτ')).1
        linarith
    have hss : s ∈ Set.Ici s := Set.self_mem_Ici
    have h1 : 0 ≤ F s + Φ s := by
      have hl : Tendsto (fun τ => F τ + Φ τ) atTop (𝓝 0) := by
        simpa using hF.add hΦlim
      refine le_of_tendsto hl ?_
      filter_upwards [eventually_ge_atTop s] with T hT
      exact hanti hss hT hT
    have h2 : F s - Φ s ≤ 0 := by
      have hl : Tendsto (fun τ => F τ - Φ τ) atTop (𝓝 0) := by
        simpa using hF.sub hΦlim
      refine ge_of_tendsto hl ?_
      filter_upwards [eventually_ge_atTop s] with T hT
      exact hmono hss hT hT
    rw [abs_le]
    constructor <;> simp only [hΦdef] at h1 h2 <;> linarith
  
  have ray : ∀ (g : E3 → ℝ) (R₀ γ M D ε : ℝ), 0 ≤ R₀ → 1 < γ → 0 < ε →
      DifferentiableOn ℝ g {x : E3 | R₀ < ‖x‖} →
      (∀ x : E3, R₀ < ‖x‖ → ‖fderiv ℝ g x‖ ≤ M * ‖x‖ ^ (-γ)) →
      (∀ x : E3, R₀ < ‖x‖ → |g x| ≤ D * ‖x‖ ^ (-ε)) →
      ∀ x : E3, R₀ < ‖x‖ → |g x| ≤ M * ‖x‖ ^ (1 - γ) / (γ - 1) := by
    intro g R₀ γ M D ε hR₀ hγ hε hg hgrad hdec x hx
    have hxpos : 0 < ‖x‖ := lt_of_le_of_lt hR₀ hx
    set θ : E3 := ‖x‖⁻¹ • x with hθdef
    have hθ : ‖θ‖ = 1 := by
      rw [hθdef, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hxpos.ne']
    have hxθ : ‖x‖ • θ = x := by rw [hθdef, smul_inv_smul₀ hxpos.ne']
    have hnorm : ∀ τ : ℝ, 0 ≤ τ → ‖τ • θ‖ = τ := by
      intro τ hτ
      rw [norm_smul, hθ, mul_one, Real.norm_eq_abs, abs_of_nonneg hτ]
    have hU : IsOpen {x : E3 | R₀ < ‖x‖} := isOpen_lt continuous_const continuous_norm
    have hmem : ∀ τ : ℝ, R₀ < τ → τ • θ ∈ {x : E3 | R₀ < ‖x‖} := by
      intro τ hτ
      show R₀ < ‖τ • θ‖
      rw [hnorm τ (by linarith)]
      exact hτ
    have key := tail (fun τ => g (τ • θ)) (fun τ => fderiv ℝ g (τ • θ) θ) R₀ M γ hR₀ hγ
      (by
        intro τ hτ
        have hdiff : DifferentiableAt ℝ g (τ • θ) :=
          (hg _ (hmem τ hτ)).differentiableAt (hU.mem_nhds (hmem τ hτ))
        have h1 := hdiff.hasFDerivAt.comp_hasDerivAt τ ((hasDerivAt_id τ).smul_const θ)
        simpa using h1)
      (by
        intro τ hτ
        have h1 := (fderiv ℝ g (τ • θ)).le_opNorm θ
        rw [hθ, mul_one, Real.norm_eq_abs] at h1
        refine h1.trans ?_
        have h2 := hgrad _ (hmem τ hτ)
        rwa [hnorm τ (by linarith)] at h2)
      (by
        have h1 : Tendsto (fun τ : ℝ => D * τ ^ (-ε)) atTop (𝓝 0) := by
          simpa using (tendsto_rpow_neg_atTop hε).const_mul D
        refine squeeze_zero_norm' ?_ h1
        filter_upwards [eventually_gt_atTop R₀] with τ hτ
        have h2 := hdec _ (hmem τ hτ)
        rw [hnorm τ (by linarith)] at h2
        simpa [Real.norm_eq_abs] using h2)
      ‖x‖ hx
    simpa [hxθ] using key
  
  have clm : ∀ L : E3 →L[ℝ] ℝ, ‖L‖ ≤ ∑ i : Fin 3, |L (e i)| := by
    intro L
    refine ContinuousLinearMap.opNorm_le_bound L (Finset.sum_nonneg fun i _ => abs_nonneg _)
      fun v => ?_
    have hv : v = ∑ i : Fin 3, v i • e i := by
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    have hvi : ∀ i : Fin 3, |v i| ≤ ‖v‖ := by
      intro i
      have := PiLp.norm_apply_le v i
      simpa [Real.norm_eq_abs] using this
    calc ‖L v‖ = |∑ i : Fin 3, v i * L (e i)| := by
          rw [Real.norm_eq_abs]
          conv_lhs => rw [hv]
          simp [map_sum, map_smul]
      _ ≤ ∑ i : Fin 3, |v i * L (e i)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 3, ‖v‖ * |L (e i)| := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right (hvi i) (abs_nonneg _)
      _ = (∑ i : Fin 3, |L (e i)|) * ‖v‖ := by
          rw [Finset.sum_mul]
          exact Finset.sum_congr rfl fun i _ => mul_comm _ _
  have clm2 : ∀ (L : E3 →L[ℝ] ℝ) (i : Fin 3), |L (e i)| ≤ ‖L‖ := by
    intro L i
    have h1 := L.le_opNorm (e i)
    rw [EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs] at h1
    exact h1
  
  obtain ⟨Cp, hCp0, hCCp⟩ : ∃ Cp : ℝ, 0 ≤ Cp ∧ C ≤ Cp := ⟨max C 0, le_max_right _ _, le_max_left _ _⟩
  have hβ1 : 0 < β - 1 := by linarith
  have hβ1' : β - 1 ≠ 0 := hβ1.ne'
  have hqβ : 0 < q + β := by linarith
  have hqβ' : q + β ≠ 0 := hqβ.ne'
  obtain ⟨K₁, hK₁⟩ : ∃ K₁ : ℝ, K₁ = Cp * (3 + 1 / (β - 1)) := ⟨_, rfl⟩
  have hK₁0 : 0 ≤ K₁ := by
    rw [hK₁]; exact mul_nonneg hCp0 (by have := one_div_pos.2 hβ1; linarith)
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = 9 * K₁ / (q + β) := ⟨_, rfl⟩
  obtain ⟨s₁, hs₁⟩ : ∃ s₁ : ℝ, ∀ r ≥ s₁, K * r ^ (-q) ≤ 1 / 2 := by
    have h := (tendsto_rpow_neg_atTop hq).const_mul K
    rw [mul_zero] at h
    have h2 := h.eventually (Iic_mem_nhds (show (0:ℝ) < 1 / 2 by norm_num))
    obtain ⟨s₁, hs₁⟩ := eventually_atTop.1 h2
    exact ⟨s₁, fun r hr => hs₁ r hr⟩
  obtain ⟨s₀, hs₀⟩ : ∃ s₀ : ℝ, s₀ = max (R + 1) s₁ := ⟨_, rfl⟩
  have hs₀R : R + 1 ≤ s₀ := by rw [hs₀]; exact le_max_left _ _
  have hs₀s₁ : s₁ ≤ s₀ := by rw [hs₀]; exact le_max_right _ _
  have hs₀pos : 0 ≤ s₀ := by linarith
  have hU : ∀ x : E3, s₀ < ‖x‖ → R < ‖x‖ := fun x hx => by linarith
  have hUR : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hmonoR : ∀ (t : ℝ) (x : E3), C * ‖x‖ ^ t ≤ Cp * ‖x‖ ^ t :=
    fun t x => mul_le_mul_of_nonneg_right hCCp (Real.rpow_nonneg (norm_nonneg _) _)
  
  have hfd : DifferentiableOn ℝ f {x : E3 | s₀ < ‖x‖} :=
    (hf.differentiableOn (by simp)).mono fun x hx => hU x hx
  have hpd : ∀ j : Fin 3, DifferentiableOn ℝ (partialDeriv j f) {x : E3 | s₀ < ‖x‖} := by
    intro j
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ f y) {x : E3 | R < ‖x‖} :=
      hf.fderiv_of_isOpen hUR
        (by exact WithTop.coe_le_coe.2 le_top)
    have h2 : ContDiffOn ℝ 1 (fun y => fderiv ℝ f y (e j)) {x : E3 | R < ‖x‖} :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by simp)).mono fun x hx => hU x hx
  
  have hval : ∀ N : ℝ, 0 ≤ N → (∀ x : E3, s₀ < ‖x‖ → ‖fderiv ℝ f x‖ ≤ N * ‖x‖ ^ (-β)) →
      ∀ x : E3, s₀ < ‖x‖ → |f x| ≤ N * ‖x‖ ^ (1 - β) / (β - 1) := by
    intro N hN hP
    refine ray f s₀ β N Cp (β - 1) hs₀pos hβ hβ1 hfd hP ?_
    intro x hx
    have h1 := hf0 x (hU x hx)
    rw [show -(β - 1) = 1 - β by ring]
    exact h1.trans (hmonoR _ x)
  
  have hstep : ∀ N : ℝ, 0 ≤ N → (∀ x : E3, s₀ < ‖x‖ → ‖fderiv ℝ f x‖ ≤ N * ‖x‖ ^ (-β)) →
      (∀ x : E3, s₀ < ‖x‖ → ‖fderiv ℝ f x‖ ≤ N / 2 * ‖x‖ ^ (-β)) := by
    intro N hN hP
    have hv := hval N hN hP
    have hhess : ∀ y : E3, s₀ < ‖y‖ → ∀ i j : Fin 3,
        |partialDeriv i (partialDeriv j f) y| ≤ K₁ * N * ‖y‖ ^ (-(q + 1 + β)) := by
      intro y hy i j
      have hyR := hU y hy
      have hypos : 0 < ‖y‖ := by linarith
      have e1 : ‖y‖ ^ (-q - 1) * ‖y‖ ^ (-β) = ‖y‖ ^ (-(q + 1 + β)) := by
        rw [← Real.rpow_add hypos]; ring_nf
      have e2 : ‖y‖ ^ (-q - 2) * ‖y‖ ^ (1 - β) = ‖y‖ ^ (-(q + 1 + β)) := by
        rw [← Real.rpow_add hypos]; ring_nf
      rw [heq y hyR i j]
      have hAk : ∀ k : Fin 3,
          |A k i j y * partialDeriv k f y| ≤ Cp * N * ‖y‖ ^ (-(q + 1 + β)) := by
        intro k
        rw [abs_mul, ← e1]
        have ha : |A k i j y| ≤ Cp * ‖y‖ ^ (-q - 1) := (hA y hyR k i j).trans (hmonoR _ y)
        have hd : |partialDeriv k f y| ≤ N * ‖y‖ ^ (-β) := (clm2 _ k).trans (hP y hy)
        calc |A k i j y| * |partialDeriv k f y|
            ≤ (Cp * ‖y‖ ^ (-q - 1)) * (N * ‖y‖ ^ (-β)) :=
              mul_le_mul ha hd (abs_nonneg _) (mul_nonneg hCp0 (Real.rpow_nonneg (norm_nonneg _) _))
          _ = Cp * N * (‖y‖ ^ (-q - 1) * ‖y‖ ^ (-β)) := by ring
      have hBf : |B i j y * f y| ≤ Cp * N / (β - 1) * ‖y‖ ^ (-(q + 1 + β)) := by
        rw [abs_mul, ← e2]
        have hb : |B i j y| ≤ Cp * ‖y‖ ^ (-q - 2) := (hB y hyR i j).trans (hmonoR _ y)
        have hff := hv y hy
        calc |B i j y| * |f y| ≤ (Cp * ‖y‖ ^ (-q - 2)) * (N * ‖y‖ ^ (1 - β) / (β - 1)) :=
              mul_le_mul hb hff (abs_nonneg _) (mul_nonneg hCp0 (Real.rpow_nonneg (norm_nonneg _) _))
          _ = Cp * N / (β - 1) * (‖y‖ ^ (-q - 2) * ‖y‖ ^ (1 - β)) := by ring
      calc |∑ k : Fin 3, A k i j y * partialDeriv k f y + B i j y * f y|
          ≤ |∑ k : Fin 3, A k i j y * partialDeriv k f y| + |B i j y * f y| := abs_add_le _ _
        _ ≤ ∑ k : Fin 3, |A k i j y * partialDeriv k f y| + |B i j y * f y| :=
            add_le_add (Finset.abs_sum_le_sum_abs _ _) le_rfl
        _ ≤ ∑ k : Fin 3, Cp * N * ‖y‖ ^ (-(q + 1 + β)) +
              Cp * N / (β - 1) * ‖y‖ ^ (-(q + 1 + β)) :=
            add_le_add (Finset.sum_le_sum fun k _ => hAk k) hBf
        _ = K₁ * N * ‖y‖ ^ (-(q + 1 + β)) := by
            rw [hK₁]
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            field_simp
            ring
    have hgradj : ∀ j : Fin 3, ∀ y : E3, s₀ < ‖y‖ →
        ‖fderiv ℝ (partialDeriv j f) y‖ ≤ (3 * K₁ * N) * ‖y‖ ^ (-(q + 1 + β)) := by
      intro j y hy
      refine (clm _).trans ?_
      calc ∑ i : Fin 3, |fderiv ℝ (partialDeriv j f) y (e i)|
          ≤ ∑ i : Fin 3, K₁ * N * ‖y‖ ^ (-(q + 1 + β)) :=
            Finset.sum_le_sum fun i _ => hhess y hy i j
        _ = 3 * K₁ * N * ‖y‖ ^ (-(q + 1 + β)) := by
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            ring
    have hpj : ∀ j : Fin 3, ∀ x : E3, s₀ < ‖x‖ →
        |partialDeriv j f x| ≤ 3 * K₁ * N * ‖x‖ ^ (1 - (q + 1 + β)) / (q + 1 + β - 1) := by
      intro j
      refine ray (partialDeriv j f) s₀ (q + 1 + β) (3 * K₁ * N) Cp β hs₀pos (by linarith)
        (by linarith) (hpd j) (hgradj j) ?_
      intro x hx
      exact (clm2 _ j).trans ((hdf x (hU x hx)).trans (hmonoR _ x))
    intro x hx
    have hxpos : 0 < ‖x‖ := by linarith
    have hr : ‖x‖ ^ (1 - (q + 1 + β)) = ‖x‖ ^ (-q) * ‖x‖ ^ (-β) := by
      rw [← Real.rpow_add hxpos]; ring_nf
    have hsmall : K * ‖x‖ ^ (-q) ≤ 1 / 2 := hs₁ _ (by linarith)
    calc ‖fderiv ℝ f x‖ ≤ ∑ j : Fin 3, |partialDeriv j f x| := clm _
      _ ≤ ∑ j : Fin 3, 3 * K₁ * N * ‖x‖ ^ (1 - (q + 1 + β)) / (q + 1 + β - 1) :=
          Finset.sum_le_sum fun j _ => hpj j x hx
      _ = (K * ‖x‖ ^ (-q)) * N * ‖x‖ ^ (-β) := by
          rw [hr, hK, show q + 1 + β - 1 = q + β by ring]
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          field_simp
          ring
      _ ≤ (1 / 2) * N * ‖x‖ ^ (-β) :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hsmall hN)
            (Real.rpow_nonneg (norm_nonneg _) _)
      _ = N / 2 * ‖x‖ ^ (-β) := by ring
  
  have hall : ∀ n : ℕ, ∀ x : E3, s₀ < ‖x‖ →
      ‖fderiv ℝ f x‖ ≤ Cp * (1 / 2) ^ n * ‖x‖ ^ (-β) := by
    intro n
    induction n with
    | zero =>
      intro x hx
      rw [pow_zero, mul_one]
      exact (hdf x (hU x hx)).trans (hmonoR _ x)
    | succ n ih =>
      intro x hx
      have h1 := hstep (Cp * (1 / 2) ^ n) (mul_nonneg hCp0 (by positivity)) ih x hx
      calc ‖fderiv ℝ f x‖ ≤ Cp * (1 / 2) ^ n / 2 * ‖x‖ ^ (-β) := h1
        _ = Cp * (1 / 2) ^ (n + 1) * ‖x‖ ^ (-β) := by rw [pow_succ]; ring
  
  refine ⟨s₀, fun x hx => ?_⟩
  have hb : ∀ n : ℕ, |f x| ≤ (Cp * ‖x‖ ^ (1 - β) / (β - 1)) * (1 / 2) ^ n := by
    intro n
    have h1 := hval (Cp * (1 / 2) ^ n) (mul_nonneg hCp0 (by positivity)) (hall n) x hx
    calc |f x| ≤ Cp * (1 / 2) ^ n * ‖x‖ ^ (1 - β) / (β - 1) := h1
      _ = (Cp * ‖x‖ ^ (1 - β) / (β - 1)) * (1 / 2) ^ n := by ring
  have hlim : Tendsto (fun n : ℕ => (Cp * ‖x‖ ^ (1 - β) / (β - 1)) * (1 / 2 : ℝ) ^ n)
      atTop (𝓝 0) := by
    have h1 := (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0:ℝ) ≤ 1 / 2)
      (by norm_num)).const_mul (Cp * ‖x‖ ^ (1 - β) / (β - 1))
    rw [mul_zero] at h1
    exact h1
  have h0 : |f x| ≤ 0 := ge_of_tendsto' hlim hb
  exact abs_nonpos_iff.1 h0

theorem cls_atlas_exists [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) :
    ∃ (ρA : ℝ) (n : ℕ) (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
      (χ : Fin n → M → ℝ), IsCLSAtlas g hAF ρA κ χ :=
by
  classical
  
  have hbump : ∀ (Φ : EndChart M) (a b : ℝ), 1 < a → a < b →
      IsClosed (Φ.Φ '' {y : E3 | a ≤ ‖y‖}) →
      ∃ θ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ θ ∧ (∀ p, 0 ≤ θ p) ∧
        tsupport θ ⊆ Φ.Φ.target ∧ (∀ p, p ∉ Φ.Φ.target → θ p = 0) ∧
        (∀ y : E3, 1 < ‖y‖ → ‖y‖ ≤ a → θ (Φ.Φ y) = 0) ∧
        (∀ y : E3, b ≤ ‖y‖ → θ (Φ.Φ y) = 1) := by
    intro Φ a b ha hab hcl
    obtain ⟨σ, hσ⟩ : ∃ σ : E3 → ℝ,
        σ = fun y => Real.smoothTransition ((‖y‖ ^ 2 - a ^ 2) / (b ^ 2 - a ^ 2)) := ⟨_, rfl⟩
    have hden : 0 < b ^ 2 - a ^ 2 := by nlinarith
    have hσsm : ContDiff ℝ ∞ σ := by
      rw [hσ]
      exact Real.smoothTransition.contDiff.comp
        (((contDiff_norm_sq ℝ).sub contDiff_const).div_const _)
    have hσ0 : ∀ y : E3, ‖y‖ ≤ a → σ y = 0 := by
      intro y hy
      rw [hσ]
      apply Real.smoothTransition.zero_of_nonpos
      have h1 : ‖y‖ ^ 2 ≤ a ^ 2 := pow_le_pow_left₀ (norm_nonneg y) hy 2
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) hden.le
    have hσ1 : ∀ y : E3, b ≤ ‖y‖ → σ y = 1 := by
      intro y hy
      rw [hσ]
      apply Real.smoothTransition.one_of_one_le
      have h1 : b ^ 2 ≤ ‖y‖ ^ 2 := pow_le_pow_left₀ (by linarith) hy 2
      rw [le_div_iff₀ hden]
      linarith
    have hσnn : ∀ y, 0 ≤ σ y := fun y => by rw [hσ]; exact Real.smoothTransition.nonneg _
    obtain ⟨θ, hθ⟩ : ∃ θ : M → ℝ,
        θ = fun p => if p ∈ Φ.Φ.target then σ (Φ.Φ.toPartialEquiv.symm p) else 0 := ⟨_, rfl⟩
    have hθp : ∀ p, θ p = if p ∈ Φ.Φ.target then σ (Φ.Φ.toPartialEquiv.symm p) else 0 :=
      fun p => by rw [hθ]
    have hcoe : ∀ y, Φ.Φ y = Φ.Φ.toPartialEquiv y := fun y => rfl
    have hval : ∀ y : E3, 1 < ‖y‖ → θ (Φ.Φ y) = σ y := by
      intro y hy
      have hs : y ∈ Φ.Φ.source := by rw [Φ.source_eq]; exact hy
      have h1 : Φ.Φ.toPartialEquiv y ∈ Φ.Φ.target := Φ.Φ.toPartialEquiv.map_source hs
      have h2 : Φ.Φ.toPartialEquiv.symm (Φ.Φ.toPartialEquiv y) = y :=
        Φ.Φ.toPartialEquiv.left_inv hs
      rw [hθp, hcoe, if_pos h1, h2]
    have hsupp : ∀ p, θ p ≠ 0 → p ∈ Φ.Φ '' {y : E3 | a ≤ ‖y‖} := by
      intro p hp
      rw [hθp] at hp
      by_cases ht : p ∈ Φ.Φ.target
      · rw [if_pos ht] at hp
        refine ⟨Φ.Φ.toPartialEquiv.symm p, ?_, Φ.Φ.toPartialEquiv.right_inv ht⟩
        by_contra hlt
        exact hp (hσ0 _ (le_of_lt (not_le.1 hlt)))
      · rw [if_neg ht] at hp
        exact absurd rfl hp
    have hFt : Φ.Φ '' {y : E3 | a ≤ ‖y‖} ⊆ Φ.Φ.target := by
      rintro _ ⟨y, hy, rfl⟩
      have hs : y ∈ Φ.Φ.source := by
        rw [Φ.source_eq]
        show 1 < ‖y‖
        exact lt_of_lt_of_le ha hy
      exact Φ.Φ.toPartialEquiv.map_source hs
    have hsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ θ := by
      intro p
      by_cases hp : p ∈ Φ.Φ.target
      · have hon : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (σ ∘ Φ.Φ.invFun) Φ.Φ.target :=
          hσsm.contMDiff.comp_contMDiffOn Φ.Φ.contMDiffOn_invFun
        refine (hon.contMDiffAt (Φ.Φ.open_target.mem_nhds hp)).congr_of_eventuallyEq ?_
        filter_upwards [Φ.Φ.open_target.mem_nhds hp] with q hq
        rw [hθp, if_pos hq]
        rfl
      · have hpF : p ∉ Φ.Φ '' {y : E3 | a ≤ ‖y‖} := fun h => hp (hFt h)
        refine (contMDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
        filter_upwards [hcl.isOpen_compl.mem_nhds hpF] with q hq
        by_contra hne
        exact hq (hsupp q hne)
    have hts : tsupport θ ⊆ Φ.Φ '' {y : E3 | a ≤ ‖y‖} :=
      closure_minimal (fun p hp => hsupp p hp) hcl
    refine ⟨θ, hsm, ?_, hts.trans hFt, ?_, ?_, ?_⟩
    · intro p
      rw [hθp]
      split_ifs
      · exact hσnn _
      · exact le_rfl
    · intro p hp
      rw [hθp, if_neg hp]
    · intro y h1 h2
      rw [hval y h1, hσ0 y h2]
    · intro y hy
      rw [hval y (by linarith), hσ1 y hy]
  
  have hopen : ∀ (j : Fin hAF.numEnds) (r : ℝ), 1 ≤ r →
      IsOpen ((hAF.ends j).Φ '' {y : E3 | r < ‖y‖}) := by
    intro j r hr
    have hsub : {y : E3 | r < ‖y‖} ⊆ (hAF.ends j).Φ.toPartialEquiv.source := by
      intro y hy
      show y ∈ (hAF.ends j).Φ.source
      rw [(hAF.ends j).source_eq]
      show 1 < ‖y‖
      exact lt_of_le_of_lt hr hy
    have himg : (hAF.ends j).Φ '' {y : E3 | r < ‖y‖} =
        (hAF.ends j).Φ.toPartialEquiv.target ∩
          (hAF.ends j).Φ.toPartialEquiv.symm ⁻¹' {y : E3 | r < ‖y‖} :=
      (hAF.ends j).Φ.toPartialEquiv.image_eq_target_inter_inv_preimage hsub
    rw [himg]
    exact ((hAF.ends j).Φ.contMDiffOn_invFun.continuousOn).isOpen_inter_preimage
      (hAF.ends j).Φ.open_target (isOpen_lt continuous_const continuous_norm)
  have hTc : ∀ b : ℝ, 1 ≤ b → IsCompact (⋃ j, (hAF.ends j).Φ '' {y : E3 | b < ‖y‖})ᶜ := by
    intro b hb
    have hclosed : IsClosed (⋃ j, (hAF.ends j).Φ '' {y : E3 | b < ‖y‖})ᶜ :=
      (isOpen_iUnion fun j => hopen j b hb).isClosed_compl
    have hA : ∀ j, IsCompact ((hAF.ends j).Φ '' {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ b}) := by
      intro j
      have hK : IsCompact {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ b} := by
        have hKeq : {y : E3 | 2 ≤ ‖y‖ ∧ ‖y‖ ≤ b} = Metric.closedBall 0 b ∩ {y | 2 ≤ ‖y‖} := by
          ext y
          simp only [Set.mem_setOf_eq, Set.mem_inter_iff, Metric.mem_closedBall, dist_zero_right]
          tauto
        rw [hKeq]
        exact (isCompact_closedBall 0 b).inter_right (isClosed_le continuous_const continuous_norm)
      refine hK.image_of_continuousOn ((hAF.ends j).Φ.contMDiffOn_toFun.continuousOn.mono ?_)
      intro y hy
      show y ∈ (hAF.ends j).Φ.source
      rw [(hAF.ends j).source_eq]
      show 1 < ‖y‖
      linarith [hy.1]
    refine (hAF.isCompact_core.union (isCompact_iUnion hA)).of_isClosed_subset hclosed ?_
    intro x hx
    by_cases hc : x ∈ (⋃ k, (hAF.ends k).Φ '' {x : E3 | 2 < ‖x‖})ᶜ
    · exact Or.inl hc
    · refine Or.inr ?_
      simp only [Set.mem_compl_iff, not_not, Set.mem_iUnion, Set.mem_image,
        Set.mem_setOf_eq] at hc
      obtain ⟨j, y, hy, rfl⟩ := hc
      refine Set.mem_iUnion.2 ⟨j, y, ⟨le_of_lt hy, ?_⟩, rfl⟩
      by_contra hyb
      exact hx (Set.mem_iUnion.2 ⟨j, y, not_le.1 hyb, rfl⟩)
  
  choose ρ₀ hρ₀2 hρ₀cl using fun j => endChart_far_isClosed g hAF j
  obtain ⟨ρA, hρA⟩ : ∃ r : ℝ, r = 2 + ∑ j, ρ₀ j := ⟨_, rfl⟩
  have hsum0 : 0 ≤ ∑ j, ρ₀ j := Finset.sum_nonneg fun j _ => by linarith [hρ₀2 j]
  have hρle : ∀ j, ρ₀ j ≤ ρA := fun j => by
    have := Finset.single_le_sum (f := ρ₀) (fun i _ => by linarith [hρ₀2 i]) (Finset.mem_univ j)
    linarith
  have hρA2 : 2 ≤ ρA := by linarith
  
  have hθex : ∀ j, ∃ θ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ θ ∧ (∀ p, 0 ≤ θ p) ∧
      tsupport θ ⊆ (hAF.ends j).Φ.target ∧ (∀ p, p ∉ (hAF.ends j).Φ.target → θ p = 0) ∧
      (∀ y : E3, 1 < ‖y‖ → ‖y‖ ≤ ρA + 1 / 4 → θ ((hAF.ends j).Φ y) = 0) ∧
      (∀ y : E3, ρA + 1 / 2 ≤ ‖y‖ → θ ((hAF.ends j).Φ y) = 1) := fun j =>
    hbump (hAF.ends j) (ρA + 1 / 4) (ρA + 1 / 2) (by linarith) (by linarith)
      (hρ₀cl j _ (by linarith [hρle j]))
  choose θ θsm θnn θts θoff θ0 θ1 using hθex
  
  obtain ⟨T, hT⟩ : ∃ T : Set M, T = (⋃ j, (hAF.ends j).Φ '' {y : E3 | ρA + 1 / 2 < ‖y‖})ᶜ :=
    ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : Set M, W = (⋃ j, (hAF.ends j).Φ '' {y : E3 | ρA + 1 ≤ ‖y‖})ᶜ :=
    ⟨_, rfl⟩
  have hTcpt : IsCompact T := by rw [hT]; exact hTc _ (by linarith)
  have hWo : IsOpen W := by
    rw [hW]
    exact (isClosed_iUnion_of_finite fun j => hρ₀cl j _ (by linarith [hρle j])).isOpen_compl
  have hTW : T ⊆ W := by
    rw [hT, hW]
    intro x hx hxW
    obtain ⟨j, y, hy, rfl⟩ := Set.mem_iUnion.1 hxW
    have hy' : ρA + 1 ≤ ‖y‖ := hy
    exact hx (Set.mem_iUnion.2 ⟨j, y, (show ρA + 1 / 2 < ‖y‖ by linarith), rfl⟩)
  
  have hbx : ∀ x ∈ T, ∃ f : SmoothBumpFunction 𝓘(ℝ, E3) x, tsupport f ⊆ W := fun x hx =>
    ((SmoothBumpFunction.nhds_basis_tsupport x).mem_iff.1 (hWo.mem_nhds (hTW hx))).imp
      fun f hf => hf.2
  have hcb : ∃ (m : ℕ) (p : Fin m → M) (w : Fin m → M → ℝ),
      (∀ l, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w l)) ∧ (∀ l x, 0 ≤ w l x) ∧
      (∀ l, IsCompact (tsupport (w l))) ∧ (∀ l, tsupport (w l) ⊆ (chartAt E3 (p l)).source) ∧
      (∀ l, tsupport (w l) ⊆ W) ∧ (∀ x ∈ T, ∃ l, 0 < w l x) := by
    choose f hf using hbx
    obtain ⟨t, ht, hcov⟩ := hTcpt.elim_nhds_subcover
      (fun x => if hx : x ∈ T then Function.support (f x hx) else Set.univ) (by
        intro x hx
        simp only [dif_pos hx]
        exact (f x hx).isOpen_support.mem_nhds
          (Function.mem_support.2 (by rw [(f x hx).eq_one]; exact one_ne_zero)))
    obtain ⟨F, hF⟩ : ∃ F : {x // x ∈ t} → M → ℝ,
        F = fun s : {x // x ∈ t} => ⇑(f s.1 (ht s.1 s.2)) := ⟨_, rfl⟩
    refine ⟨t.card, fun l => (t.equivFin.symm l).1, fun l => F (t.equivFin.symm l),
      ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro l; rw [hF]; exact (f _ _).contMDiff
    · intro l x; rw [hF]; exact (f _ _).nonneg
    · intro l; rw [hF]; exact (f _ _).hasCompactSupport
    · intro l; rw [hF]; exact (f _ _).tsupport_subset_chartAt_source
    · intro l; rw [hF]; exact hf _ _
    · intro x hx
      have hx' := hcov hx
      simp only [Set.mem_iUnion] at hx'
      obtain ⟨y, hy, hxy⟩ := hx'
      rw [dif_pos (ht y hy)] at hxy
      refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      rw [hF]
      exact lt_of_le_of_ne (f _ _).nonneg (Ne.symm hxy)
  obtain ⟨m, p, w, wsm, wnn, wcpt, wch, wW, wcov⟩ := hcb
  
  obtain ⟨S, hS⟩ : ∃ S : M → ℝ, S = fun x => ∑ l, w l x + ∑ j, θ j x := ⟨_, rfl⟩
  have hSx : ∀ x, S x = ∑ l, w l x + ∑ j, θ j x := fun x => by rw [hS]
  have Ssm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ S := by
    rw [hS]
    exact (contMDiff_finset_sum fun l _ => wsm l).add (contMDiff_finset_sum fun j _ => θsm j)
  have Spos : ∀ x, 0 < S x := by
    intro x
    rw [hSx]
    have h1 : 0 ≤ ∑ l, w l x := Finset.sum_nonneg fun l _ => wnn l x
    have h2 : 0 ≤ ∑ j, θ j x := Finset.sum_nonneg fun j _ => θnn j x
    by_cases hx : x ∈ T
    · obtain ⟨l, hl⟩ := wcov x hx
      have h3 : w l x ≤ ∑ l, w l x :=
        Finset.single_le_sum (f := fun l => w l x) (fun l _ => wnn l x) (Finset.mem_univ l)
      linarith
    · rw [hT] at hx
      simp only [Set.mem_compl_iff, not_not, Set.mem_iUnion, Set.mem_image,
        Set.mem_setOf_eq] at hx
      obtain ⟨j, y, hy, rfl⟩ := hx
      have h3 := θ1 j y hy.le
      have h4 : θ j ((hAF.ends j).Φ y) ≤ ∑ k, θ k ((hAF.ends j).Φ y) :=
        Finset.single_le_sum (f := fun k => θ k ((hAF.ends j).Φ y)) (fun k _ => θnn k _)
          (Finset.mem_univ j)
      linarith
  have htsdiv : ∀ F : M → ℝ, tsupport (fun x => F x / S x) ⊆ tsupport F := by
    intro F
    apply closure_mono
    intro x hx
    rw [Function.mem_support] at hx ⊢
    intro h0
    apply hx
    simp [h0]
  
  let Φc : M → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ := fun q =>
    { toPartialEquiv := (chartAt E3 q).symm.toPartialEquiv
      open_source := (chartAt E3 q).open_target
      open_target := (chartAt E3 q).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  have hΦct : ∀ q, (Φc q).target = (chartAt E3 q).source := fun q => rfl
  
  refine ⟨ρA, m + hAF.numEnds, Fin.append (fun l => Φc (p l)) (fun j => (hAF.ends j).Φ),
    Fin.append (fun l x => w l x / S x) (fun j x => θ j x / S x), ?_⟩
  unfold IsCLSAtlas
  refine ⟨hρA2, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    induction i using Fin.addCases with
    | left l =>
      simp only [Fin.append_left]
      exact (wsm l).div₀ Ssm (fun x => (Spos x).ne')
    | right j =>
      simp only [Fin.append_right]
      exact (θsm j).div₀ Ssm (fun x => (Spos x).ne')
  · intro i x
    induction i using Fin.addCases with
    | left l =>
      simp only [Fin.append_left]
      exact div_nonneg (wnn l x) (Spos x).le
    | right j =>
      simp only [Fin.append_right]
      exact div_nonneg (θnn j x) (Spos x).le
  · intro x
    rw [Fin.sum_univ_add]
    simp only [Fin.append_left, Fin.append_right]
    rw [← Finset.sum_div, ← Finset.sum_div, ← add_div, ← hSx x, div_self (Spos x).ne']
  · intro i
    induction i using Fin.addCases with
    | left l =>
      simp only [Fin.append_left]
      rw [hΦct]
      exact (htsdiv (w l)).trans (wch l)
    | right j =>
      simp only [Fin.append_right]
      exact (htsdiv (θ j)).trans (θts j)
  · intro i
    induction i using Fin.addCases with
    | left l =>
      left
      simp only [Fin.append_left]
      exact (wcpt l).of_isClosed_subset (isClosed_tsupport _) (htsdiv (w l))
    | right j =>
      right
      refine ⟨j, by simp only [Fin.append_right], ?_, ?_⟩
      · intro y hy
        simp only [Fin.append_right]
        have hxW : (hAF.ends j).Φ y ∉ W := by
          rw [hW]
          intro h
          exact h (Set.mem_iUnion.2 ⟨j, y, hy, rfl⟩)
        have hw0 : ∀ l, w l ((hAF.ends j).Φ y) = 0 := fun l =>
          image_eq_zero_of_notMem_tsupport (fun h => hxW (wW l h))
        have hs : y ∈ (hAF.ends j).Φ.source := by
          rw [(hAF.ends j).source_eq]
          show 1 < ‖y‖
          linarith
        have hxt : (hAF.ends j).Φ y ∈ (hAF.ends j).Φ.target :=
          (hAF.ends j).Φ.toPartialEquiv.map_source hs
        have hθk : ∀ k, k ≠ j → θ k ((hAF.ends j).Φ y) = 0 := fun k hkj =>
          θoff k _ (Set.disjoint_left.1 (hAF.disjoint (Ne.symm hkj)) hxt)
        have hθj : θ j ((hAF.ends j).Φ y) = 1 := θ1 j y (by linarith)
        have hSj : S ((hAF.ends j).Φ y) = 1 := by
          rw [hSx, Finset.sum_eq_zero (fun l _ => hw0 l),
            Finset.sum_eq_single j (fun k _ hkj => hθk k hkj)
              (fun h => absurd (Finset.mem_univ j) h), hθj, zero_add]
        rw [hSj, hθj, div_one]
      · intro y hy1 hy2
        simp only [Fin.append_right]
        rw [θ0 j y hy1 (by linarith), zero_div]

theorem cps_atlas_cover_subadd [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (G : M → ℝ)
    (hG : ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => G (ψ y)) ψ.source)
    (hG0 : ∀ p, 0 ≤ G p) (K : Set M) (hK : IsCompact K) (hGK : ∀ p, p ∉ K → G p = 0)
    (T : Set M) (hT : IsClosed T) {ι : Type*} (t : Finset ι) (Tr : ι → Set M)
    (hTr : ∀ r, IsClosed (Tr r)) (hcov : T ⊆ ⋃ r ∈ t, Tr r) :
    atlasInt g κ χ (T.indicator G) ≤ ∑ r ∈ t, atlasInt g κ χ ((Tr r).indicator G) :=
by
  classical
  obtain ⟨hρA, hχs, hχ0, -, hχt, hcase⟩ := hA
  
  have hfar : ∀ j : Fin hAF.numEnds, ∃ R : ℝ, ∀ y : E3, R < ‖y‖ → (hAF.ends j).Φ y ∉ K := by
    intro j
    obtain ⟨ρ₀, hρ₀, hcl⟩ := endChart_far_isClosed g hAF j
    let O : ℕ → Set M := fun m => ((hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖})ᶜ
    have hOo : ∀ m, IsOpen (O m) := fun m =>
      (hcl _ (le_add_of_nonneg_right (Nat.cast_nonneg m))).isOpen_compl
    have hOmono : Monotone O := by
      intro m m' hmm' p hp
      simp only [O, Set.mem_compl_iff] at hp ⊢
      intro hp'
      apply hp
      obtain ⟨z, hz, hzp⟩ := hp'
      refine ⟨z, ?_, hzp⟩
      have h1 : (m : ℝ) ≤ m' := Nat.cast_le.2 hmm'
      have h2 : ρ₀ + (m' : ℝ) ≤ ‖z‖ := hz
      show ρ₀ + (m : ℝ) ≤ ‖z‖
      linarith
    have hcovK : K ⊆ ⋃ m, O m := by
      intro p _
      by_contra hne
      have hmem : ∀ m : ℕ, p ∈ (hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖} := fun m =>
        Classical.byContradiction fun h => hne (Set.mem_iUnion.2 ⟨m, h⟩)
      obtain ⟨z₀, hz₀, hpz₀⟩ := hmem 0
      obtain ⟨m, hm⟩ := exists_nat_gt (‖z₀‖ - ρ₀)
      obtain ⟨z₁, hz₁, hpz₁⟩ := hmem m
      have h0 : ρ₀ + ((0 : ℕ) : ℝ) ≤ ‖z₀‖ := hz₀
      have h1 : ρ₀ + (m : ℝ) ≤ ‖z₁‖ := hz₁
      simp only [Nat.cast_zero, add_zero] at h0
      have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
      have hz₀s : z₀ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₀‖; linarith
      have hz₁s : z₁ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₁‖; linarith
      have heq : z₀ = z₁ :=
        (hAF.ends j).Φ.toPartialEquiv.injOn hz₀s hz₁s (hpz₀.trans hpz₁.symm)
      rw [← heq] at h1
      linarith
    obtain ⟨N, hN⟩ := hK.elim_directed_cover O hOo hcovK hOmono.directed_le
    refine ⟨ρ₀ + N, fun y hy hyK => hN hyK ⟨y, ?_, rfl⟩⟩
    show ρ₀ + (N : ℝ) ≤ ‖y‖
    linarith
  
  have hD : ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source := by
    intro ψ
    have hGc : ContinuousOn (g.coeff ψ) ψ.source :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c =>
        (coeff_contDiffOn_source g ψ a c).continuousOn
    exact Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hGc)
  have hH : ∀ i, ContinuousOn
      (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det) (κ i).source := by
    intro i
    exact (((hχs i).continuous.comp_continuousOn
      (κ i).contMDiffOn_toFun.continuousOn).mul (hG (κ i))).mul (hD (κ i))
  
  have hZ : ∀ i, ∃ Z : Set E3, IsCompact Z ∧ Z ⊆ (κ i).source ∧
      ∀ y ∈ (κ i).source, y ∉ Z →
        χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det = 0 := by
    intro i
    rcases hcase i with hc | ⟨j, hκ, -, h0⟩
    · refine ⟨(κ i).toPartialEquiv.symm '' tsupport (χ i), ?_, ?_, ?_⟩
      · exact hc.image_of_continuousOn
          ((κ i).toOpenPartialHomeomorph.continuousOn_symm.mono (hχt i))
      · rintro _ ⟨x, hx, rfl⟩
        exact (κ i).toPartialEquiv.map_target (hχt i hx)
      · intro y hy hyZ
        have hns : κ i y ∉ tsupport (χ i) := by
          intro hmem
          exact hyZ ⟨κ i y, hmem, (κ i).toPartialEquiv.left_inv hy⟩
        rw [image_eq_zero_of_notMem_tsupport hns, zero_mul, zero_mul]
    · obtain ⟨R, hR⟩ := hfar j
      refine ⟨{y : E3 | ρA ≤ ‖y‖} ∩ {y : E3 | ‖y‖ ≤ max R ρA}, ?_, ?_, ?_⟩
      · refine (isCompact_closedBall (0 : E3) (max R ρA)).of_isClosed_subset
          ((isClosed_le continuous_const continuous_norm).inter
            (isClosed_le continuous_norm continuous_const)) ?_
        intro y hy
        rw [mem_closedBall_zero_iff]
        exact hy.2
      · intro y hy
        have h1 : ρA ≤ ‖y‖ := hy.1
        rw [hκ, (hAF.ends j).source_eq]
        show (1 : ℝ) < ‖y‖
        linarith
      · intro y hy hyZ
        rw [hκ] at hy ⊢
        have hy1 : (1 : ℝ) < ‖y‖ := by
          have h2 := hy
          rw [(hAF.ends j).source_eq] at h2
          exact h2
        by_cases hle : ‖y‖ ≤ ρA
        · rw [h0 y hy1 hle, zero_mul, zero_mul]
        · have hgt : max R ρA < ‖y‖ := by
            by_contra hc'
            exact hyZ ⟨le_of_lt (not_le.1 hle), not_lt.1 hc'⟩
          rw [hGK _ (hR y (lt_of_le_of_lt (le_max_left _ _) hgt)), mul_zero, zero_mul]
  
  have hInt : ∀ C : Set M, IsClosed C → ∀ i, IntegrableOn
      (fun y => χ i (κ i y) * C.indicator G (κ i y) * Real.sqrt (g.coeff (κ i) y).det)
      (κ i).source := by
    intro C hC i
    obtain ⟨Z, hZc, hZS, hZ0⟩ := hZ i
    have h1 : IntegrableOn
        (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det) (κ i).source :=
      (((hH i).mono hZS).integrableOn_compact hZc).of_forall_diff_eq_zero
        (κ i).open_source.measurableSet (fun y hy => hZ0 y hy.1 hy.2)
    have hmeas : MeasurableSet ((κ i).source ∩ κ i ⁻¹' C) := by
      have hopen : IsOpen ((κ i).source ∩ κ i ⁻¹' Cᶜ) :=
        (κ i).contMDiffOn_toFun.continuousOn.isOpen_inter_preimage (κ i).open_source
          hC.isOpen_compl
      have heq : (κ i).source ∩ κ i ⁻¹' C = (κ i).source \ ((κ i).source ∩ κ i ⁻¹' Cᶜ) := by
        ext y
        simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_preimage, Set.mem_compl_iff]
        tauto
      rw [heq]
      exact (κ i).open_source.measurableSet.diff hopen.measurableSet
    refine (h1.indicator hmeas).congr_fun ?_ (κ i).open_source.measurableSet
    intro y hy
    by_cases hc : κ i y ∈ C
    · simp [Set.indicator_apply, hy, hc]
    · simp [Set.indicator_apply, hy, hc]
  
  have hpt : ∀ p, T.indicator G p ≤ ∑ r ∈ t, (Tr r).indicator G p := by
    intro p
    by_cases hp : p ∈ T
    · obtain ⟨r, hr, hpr⟩ := Set.mem_iUnion₂.1 (hcov hp)
      rw [Set.indicator_of_mem hp]
      calc G p = (Tr r).indicator G p := (Set.indicator_of_mem hpr G).symm
        _ ≤ ∑ r ∈ t, (Tr r).indicator G p :=
          Finset.single_le_sum (f := fun r => (Tr r).indicator G p)
            (fun r _ => Set.indicator_nonneg (fun q _ => hG0 q) p) hr
    · rw [Set.indicator_of_notMem hp]
      exact Finset.sum_nonneg fun r _ => Set.indicator_nonneg (fun q _ => hG0 q) p
  
  unfold atlasInt
  rw [Finset.sum_comm]
  refine Finset.sum_le_sum fun i _ => ?_
  have hmono : ∫ y in (κ i).source,
        χ i (κ i y) * T.indicator G (κ i y) * Real.sqrt (g.coeff (κ i) y).det ≤
      ∫ y in (κ i).source, ∑ r ∈ t,
        χ i (κ i y) * (Tr r).indicator G (κ i y) * Real.sqrt (g.coeff (κ i) y).det := by
    refine setIntegral_mono_on (hInt T hT i)
      (integrable_finset_sum t fun r _ => hInt (Tr r) (hTr r) i)
      (κ i).open_source.measurableSet ?_
    intro y _
    rw [← Finset.sum_mul, ← Finset.mul_sum]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hpt _) (hχ0 i _))
      (Real.sqrt_nonneg _)
  exact hmono.trans_eq (integral_finset_sum t fun r _ => hInt (Tr r) (hTr r) i)

theorem cps_localize_upper [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ)
    (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L : Set E3) (hL : IsCompact L)
    (hLψ : L ⊆ ψ.source) (G : M → ℝ)
    (hG : ∀ ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => G (ψ' y)) ψ'.source)
    (hG0 : ∀ p, 0 ≤ G p) (C : Set M) (hC : IsClosed C) (hCL : C ⊆ ψ '' L) :
    atlasInt g κ χ (C.indicator G) ≤ ∫ y in L, G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
by
  classical
  obtain ⟨_, hχs, hχ0, hχ1, _, _⟩ := hA
  have h1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
    simpa using this.symm
  have hexpB : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hexp w1, ← hexp w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  
  have hcsm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => g.coeff ψ x i j) ψ.source := by
    intro i j
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ ψ ψ.source := ψ.contMDiffOn_toFun
    apply contDiffOn_of_locally_contDiffOn
    intro x0 hx0
    have hu : IsOpen (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) :=
      hΦ.continuousOn.isOpen_inter_preimage ψ.open_source (chartAt E3 (ψ x0)).open_source
    have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (ψ x0) (ψ y))
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) := by
      have h1 := (contMDiffOn_iff_target.mp hΦ).2 (ψ x0)
      rw [extChartAt_source] at h1
      have h2 := contMDiffOn_iff_contDiffOn.mp h1
      simpa [extChartAt_coe, Function.comp_def] using h2
    have hmaps : Set.MapsTo (fun y => chartAt E3 (ψ x0) (ψ y))
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) (chartAt E3 (ψ x0)).target :=
      fun y hy => (chartAt E3 (ψ x0)).map_source hy.2
    have hD : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)))
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hu).mp hF).2
    have hcoord : ∀ k a : Fin 3, ContDiffOn ℝ ∞
        (fun x => (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e k)) a)
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) := by
      intro k a
      have h2 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e k))
          (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) := hD.clm_apply contDiffOn_const
      exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
    have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞
        (fun x => g.coeff (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) a b)
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) :=
      fun a b => (g.smooth (ψ x0) a b).comp hF hmaps
    have hR : ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e j)) b *
        g.coeff (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) a b)
        (ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source) := by
      apply ContDiffOn.sum
      intro a _
      apply ContDiffOn.sum
      intro b _
      exact ((hcoord i a).mul (hcoord j b)).mul (hGs a b)
    have keyc : ∀ x ∈ ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source,
        g.coeff ψ x i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x (e j)) b *
        g.coeff (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) a b := by
      intro x hx
      have hcont : ContinuousAt ψ x :=
        hΦ.continuousOn.continuousAt (ψ.open_source.mem_nhds hx.1)
      have hFdiff : DifferentiableAt ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x :=
        (hF.contDiffAt (hu.mem_nhds hx)).differentiableAt (by simp)
      have hFx : chartAt E3 (ψ x0) (ψ x) ∈ (chartAt E3 (ψ x0)).target := hmaps hx
      have hev : (ψ : E3 → M) =ᶠ[𝓝 x]
          ((chartAt E3 (ψ x0)).symm ∘ fun y => chartAt E3 (ψ x0) (ψ y)) := by
        have hmem : (ψ : E3 → M) ⁻¹' (chartAt E3 (ψ x0)).source ∈ 𝓝 x :=
          hcont.preimage_mem_nhds ((chartAt E3 (ψ x0)).open_source.mem_nhds hx.2)
        filter_upwards [hmem] with y hy
        simp only [Function.comp_apply]
        exact ((chartAt E3 (ψ x0)).left_inv hy).symm
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (ψ x0)).symm
          (chartAt E3 (ψ x0) (ψ x)) :=
        ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
          ((chartAt E3 (ψ x0)).open_target.mem_nhds hFx)).mdifferentiableAt (by simp)
      have hfac : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ x v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x))
            (fderiv ℝ (fun y => chartAt E3 (ψ x0) (ψ y)) x v) := by
        intro v
        rw [hev.mfderiv_eq, mfderiv_comp x hg hFdiff.mdifferentiableAt, mfderiv_eq_fderiv]
        rfl
      have hpt : (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) = ψ x :=
        (chartAt E3 (ψ x0)).left_inv hx.2
      have h1 : g.coeff ψ x i j = g.g (ψ x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ x (e i))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ x (e j)) := rfl
      have h2 : ∀ a b : Fin 3,
          g.coeff (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) a b =
          g.g (ψ x)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)) (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x))
              (e b)) := by
        intro a b
        show g.g ((chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x))) _ _ = _
        rw [show g.g ((chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x))) = g.g (ψ x) from
          congrArg g.g hpt]
      rw [h1, hfac, hfac]
      simp only [h2]
      exact hexpB (g.g (ψ x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (ψ x0)).symm (chartAt E3 (ψ x0) (ψ x)))
        _ _
    refine ⟨ψ.source ∩ ψ ⁻¹' (chartAt E3 (ψ x0)).source, hu,
      ⟨hx0, mem_chart_source E3 (ψ x0)⟩, ?_⟩
    rw [Set.inter_eq_right.mpr Set.inter_subset_left]
    exact hR.congr keyc
  have hdetc : ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source := by
    have hGc : ContinuousOn (g.coeff ψ) ψ.source :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c => (hcsm a c).continuousOn
    exact Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hGc)
  have hgL : ∀ i, IntegrableOn (fun y => χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det) L :=
    fun i => (((((hχs i).continuous.comp_continuousOn ψ.contMDiffOn_toFun.continuousOn).mul
      (hG ψ)).mul hdetc).mono hLψ).integrableOn_compact hL
  
  have key : ∀ i, ∫ z in (κ i).source,
      χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det ≤
      ∫ y in L, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
    intro i
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set E3, Ω = ψ.source ∩ ψ ⁻¹' (κ i).target := ⟨_, rfl⟩
    have hΩmem : ∀ y, y ∈ Ω ↔ y ∈ ψ.source ∧ ψ y ∈ (κ i).target := by
      intro y; rw [hΩ]; rfl
    have hΩo : IsOpen Ω := by
      rw [hΩ]
      exact ψ.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψ.open_source
        (κ i).open_target
    obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun y => (κ i).toPartialEquiv.symm (ψ y) := ⟨_, rfl⟩
    have hτsm : ContDiffOn ℝ ∞ τ Ω := by
      rw [hτ, hΩ]
      exact contMDiffOn_iff_contDiffOn.mp (ContMDiffOn.comp (κ i).contMDiffOn_invFun
        (ψ.contMDiffOn_toFun.mono Set.inter_subset_left) (fun y hy => hy.2))
    have hτd : ∀ y ∈ Ω, DifferentiableAt ℝ τ y := fun y hy =>
      (hτsm.differentiableOn (by simp)).differentiableAt (hΩo.mem_nhds hy)
    have hκτ : ∀ y ∈ Ω, κ i (τ y) = ψ y := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.right_inv ((hΩmem y).1 hy).2
    have hτmem : ∀ y ∈ Ω, τ y ∈ (κ i).source := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.map_target ((hΩmem y).1 hy).2
    
    have hjac : ∀ y ∈ Ω, Real.sqrt (g.coeff ψ y).det =
        |(fderiv ℝ τ y).det| * Real.sqrt (g.coeff (κ i) (τ y)).det := by
      intro y hy
      have hmdκ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) :=
        ((κ i).contMDiffOn_toFun.contMDiffAt
          ((κ i).open_source.mem_nhds (hτmem y hy))).mdifferentiableAt (by simp)
      have hmdτ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ y := (hτd y hy).mdifferentiableAt
      have heq : (ψ : E3 → M) =ᶠ[𝓝 y] (κ i) ∘ τ := by
        filter_upwards [hΩo.mem_nhds hy] with z hz
        exact (hκτ z hz).symm
      have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)).comp (fderiv ℝ τ y) := by
        rw [heq.mfderiv_eq, mfderiv_comp y hmdκ hmdτ, mfderiv_eq_fderiv]
      obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin 3) (Fin 3) ℝ,
          J = Matrix.of fun a b => fderiv ℝ τ y (e b) a := ⟨_, rfl⟩
      have hcoeff : g.coeff ψ y = J.transpose * g.coeff (κ i) (τ y) * J := by
        ext a b
        have hl : g.coeff ψ y a b = g.g (ψ y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e a)))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e b))) := by
          show g.g (ψ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e b)) = _
          rw [hmf]
          rfl
        have hr : ∀ a' b' : Fin 3, g.coeff (κ i) (τ y) a' b' =
            (g.g (ψ y) : E3 →L[ℝ] E3 →L[ℝ] ℝ)
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e a'))
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e b')) := by
          intro a' b'
          show g.g (κ i (τ y)) _ _ = _
          rw [hκτ y hy]
          try rfl
        have hl2 : g.coeff ψ y a b = ∑ a' : Fin 3, ∑ b' : Fin 3,
            fderiv ℝ τ y (e a) a' * fderiv ℝ τ y (e b) b' * g.coeff (κ i) (τ y) a' b' := by
          rw [hl]
          refine (hexpB (g.g (ψ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)) _ _).trans ?_
          refine Finset.sum_congr rfl fun a' _ => Finset.sum_congr rfl fun b' _ => ?_
          exact congrArg _ (hr a' b').symm
        rw [hl2]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
          Fin.sum_univ_three]
        ring
      have hdetJ : J.det = (fderiv ℝ τ y).det := by
        show J.det = LinearMap.det ((fderiv ℝ τ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
        congr 1
        try (ext a b; rw [hJ, LinearMap.toMatrix_apply]; simp)
      rw [hcoeff, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hdetJ]
      rw [show (fderiv ℝ τ y).det * (g.coeff (κ i) (τ y)).det * (fderiv ℝ τ y).det =
          (fderiv ℝ τ y).det ^ 2 * (g.coeff (κ i) (τ y)).det by ring]
      rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    
    have hEm : MeasurableSet (L ∩ Ω) := hL.isClosed.measurableSet.inter hΩo.measurableSet
    have hEΩ : L ∩ Ω ⊆ Ω := Set.inter_subset_right
    have hτinj : Set.InjOn τ (L ∩ Ω) := by
      intro y₁ hy₁ y₂ hy₂ h
      have h' : ψ y₁ = ψ y₂ := by
        rw [← hκτ y₁ (hEΩ hy₁), ← hκτ y₂ (hEΩ hy₂), h]
      exact ψ.toPartialEquiv.injOn ((hΩmem y₁).1 (hEΩ hy₁)).1 ((hΩmem y₂).1 (hEΩ hy₂)).1 h'
    
    have hs3 : ∫ z in (κ i).source,
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det =
        ∫ z in τ '' (L ∩ Ω),
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero (κ i).open_source.measurableSet
        ?_ ?_
      · rintro _ ⟨y, hy, rfl⟩
        exact hτmem y (hEΩ hy)
      · rintro z ⟨hzS, hzn⟩
        by_cases hzC : κ i z ∈ C
        · exfalso
          obtain ⟨y, hyL, hyz⟩ := hCL hzC
          have hyt : ψ y ∈ (κ i).target := by
            rw [hyz]; exact (κ i).toPartialEquiv.map_source hzS
          have hyΩ : y ∈ Ω := (hΩmem y).2 ⟨hLψ hyL, hyt⟩
          apply hzn
          refine ⟨y, ⟨hyL, hyΩ⟩, ?_⟩
          rw [hτ]
          show (κ i).toPartialEquiv.symm (ψ y) = z
          rw [hyz]
          exact (κ i).toPartialEquiv.left_inv hzS
        · rw [Set.indicator_of_notMem hzC]
          ring
    
    have hs4 : ∫ z in τ '' (L ∩ Ω),
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det =
        ∫ y in L ∩ Ω, χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      rw [integral_image_eq_integral_abs_det_fderiv_smul volume hEm
        (fun y hy => (hτd y (hEΩ hy)).hasFDerivAt.hasFDerivWithinAt) hτinj]
      refine setIntegral_congr_fun hEm (fun y hy => ?_)
      simp only [smul_eq_mul]
      rw [hκτ y (hEΩ hy), hjac y (hEΩ hy)]
      ring
    
    have hpt : ∀ y, 0 ≤ χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det ∧
        χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
          χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det ∧
        0 ≤ χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      intro y
      refine ⟨mul_nonneg (mul_nonneg (hχ0 i _) (Set.indicator_nonneg (fun q _ => hG0 q) _))
          (Real.sqrt_nonneg _), ?_,
        mul_nonneg (mul_nonneg (hχ0 i _) (hG0 _)) (Real.sqrt_nonneg _)⟩
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (Set.indicator_le_self' (fun q _ => hG0 q) _) (hχ0 i _))
        (Real.sqrt_nonneg _)
    have h5a : ∫ y in L ∩ Ω, χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
        ∫ y in L ∩ Ω, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
      integral_mono_of_nonneg (Filter.Eventually.of_forall fun y => (hpt y).1)
        ((hgL i).mono_set Set.inter_subset_left)
        (Filter.Eventually.of_forall fun y => (hpt y).2.1)
    have h5b : ∫ y in L ∩ Ω, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
        ∫ y in L, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
      setIntegral_mono_set (hgL i) (Filter.Eventually.of_forall fun y => (hpt y).2.2)
        (Set.inter_subset_left : L ∩ Ω ⊆ L).eventuallyLE
    rw [hs3, hs4]
    exact h5a.trans h5b
  
  unfold atlasInt
  calc ∑ i, ∫ z in (κ i).source,
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det
      ≤ ∑ i, ∫ y in L, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
        Finset.sum_le_sum fun i _ => key i
    _ = ∫ y in L, ∑ i, χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
        (integral_finset_sum Finset.univ fun i _ => hgL i).symm
    _ = ∫ y in L, G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
        congr 1
        funext y
        rw [← Finset.sum_mul, ← Finset.sum_mul, hχ1, one_mul]

theorem cps_cross_chart_l2 [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (ψa ψb : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (E La : Set E3) (hE : IsCompact E)
    (hEs : E ⊆ ψb.source) (hEt : ∀ y ∈ E, ψb y ∈ ψa.target) (hLa : IsCompact La)
    (hLas : La ⊆ ψa.source) (hEL : ∀ y ∈ E, ψa.symm (ψb y) ∈ La) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ∫ y in E, (u (ψb y)) ^ 2 ≤ K * ∫ z in La, (u (ψa z)) ^ 2 :=
by
  classical
  obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun x => ψa.symm (ψb x) := ⟨_, rfl⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : E3 → E3, σ = fun z => ψb.symm (ψa z) := ⟨_, rfl⟩
  have hτx : ∀ x, τ x = ψa.symm (ψb x) := fun x => by rw [hτ]
  have hσx : ∀ z, σ z = ψb.symm (ψa z) := fun z => by rw [hσ]
  have hΩo : IsOpen (ψb.source ∩ ψb ⁻¹' ψa.target) :=
    ψb.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψb.open_source ψa.open_target
  have hΩ'o : IsOpen (ψa.source ∩ ψa ⁻¹' ψb.target) :=
    ψa.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψa.open_source ψb.open_target
  have hEΩ : E ⊆ ψb.source ∩ ψb ⁻¹' ψa.target := fun y hy => ⟨hEs hy, hEt y hy⟩
  have hτsm : ContDiffOn ℝ ∞ τ (ψb.source ∩ ψb ⁻¹' ψa.target) := by
    have h : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun x => ψa.symm (ψb x))
        (ψb.source ∩ ψb ⁻¹' ψa.target) :=
      ψa.contMDiffOn_invFun.comp (ψb.contMDiffOn_toFun.mono Set.inter_subset_left)
        (fun x hx => hx.2)
    rw [hτ]
    exact contMDiffOn_iff_contDiffOn.mp h
  have hσsm : ContDiffOn ℝ ∞ σ (ψa.source ∩ ψa ⁻¹' ψb.target) := by
    have h : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun z => ψb.symm (ψa z))
        (ψa.source ∩ ψa ⁻¹' ψb.target) :=
      ψb.contMDiffOn_invFun.comp (ψa.contMDiffOn_toFun.mono Set.inter_subset_left)
        (fun x hx => hx.2)
    rw [hσ]
    exact contMDiffOn_iff_contDiffOn.mp h
  have hleft : ∀ x ∈ ψb.source ∩ ψb ⁻¹' ψa.target,
      τ x ∈ ψa.source ∩ ψa ⁻¹' ψb.target ∧ σ (τ x) = x := by
    intro x hx
    have h1 : ψa (ψa.symm (ψb x)) = ψb x := ψa.toPartialEquiv.right_inv hx.2
    have h2 : ψa.symm (ψb x) ∈ ψa.source := ψa.toPartialEquiv.map_target hx.2
    have h3 : ψb x ∈ ψb.target := ψb.toPartialEquiv.map_source hx.1
    have h4 : ψb.symm (ψb x) = x := ψb.toPartialEquiv.left_inv hx.1
    rw [hτx, hσx]
    refine ⟨⟨h2, ?_⟩, ?_⟩
    · show ψa (ψa.symm (ψb x)) ∈ ψb.target
      rw [h1]; exact h3
    · rw [h1, h4]
  have hn1 : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hn0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hτd : ∀ y ∈ E, DifferentiableAt ℝ τ y := fun y hy =>
    (hτsm.contDiffAt (hΩo.mem_nhds (hEΩ hy))).differentiableAt hn0
  have hdet : ∀ y ∈ E, (fderiv ℝ σ (τ y)).det * (fderiv ℝ τ y).det = 1 := by
    intro y hy
    have hyΩ := hEΩ hy
    have hσd : DifferentiableAt ℝ σ (τ y) :=
      (hσsm.contDiffAt (hΩ'o.mem_nhds (hleft y hyΩ).1)).differentiableAt hn0
    have heq : σ ∘ τ =ᶠ[𝓝 y] id :=
      Filter.mem_of_superset (hΩo.mem_nhds hyΩ) (fun x hx => (hleft x hx).2)
    have hcomp : fderiv ℝ (σ ∘ τ) y = (fderiv ℝ σ (τ y)).comp (fderiv ℝ τ y) :=
      fderiv_comp y hσd (hτd y hy)
    have hid : fderiv ℝ (σ ∘ τ) y = ContinuousLinearMap.id ℝ E3 := by
      rw [heq.fderiv_eq]; exact fderiv_id
    have hc : (fderiv ℝ σ (τ y)).comp (fderiv ℝ τ y) = ContinuousLinearMap.id ℝ E3 :=
      hcomp.symm.trans hid
    show LinearMap.det _ * LinearMap.det _ = 1
    rw [← LinearMap.det_comp, ← ContinuousLinearMap.coe_comp, hc, ContinuousLinearMap.coe_id,
      LinearMap.det_id]
  have hinj : Set.InjOn τ E := by
    intro y₁ h₁ y₂ h₂ h12
    have e1 := (hleft y₁ (hEΩ h₁)).2
    have e2 := (hleft y₂ (hEΩ h₂)).2
    rw [← e1, ← e2, h12]
  have hfdc : ContinuousOn (fderiv ℝ τ) (ψb.source ∩ ψb ⁻¹' ψa.target) :=
    hτsm.continuousOn_fderiv_of_isOpen hΩo hn1
  have hdetc : ContinuousOn (fun y => |(fderiv ℝ τ y).det|) E :=
    ((ContinuousLinearMap.continuous_det.comp_continuousOn hfdc).abs).mono hEΩ
  obtain ⟨c, hc, hcE⟩ : ∃ c : ℝ, 0 < c ∧ ∀ y ∈ E, c ≤ |(fderiv ℝ τ y).det| := by
    rcases E.eq_empty_or_nonempty with h | h
    · exact ⟨1, one_pos, fun y hy => by simp [h] at hy⟩
    · obtain ⟨y₀, hy₀, hmin⟩ := hE.exists_isMinOn h hdetc
      refine ⟨|(fderiv ℝ τ y₀).det|, ?_, fun y hy => isMinOn_iff.mp hmin y hy⟩
      have h1 := hdet y₀ hy₀
      refine abs_pos.2 (fun h0 => ?_)
      rw [h0, mul_zero] at h1
      exact zero_ne_one h1
  refine ⟨c⁻¹, inv_nonneg.2 hc.le, fun u hu => ?_⟩
  have hEm : MeasurableSet E := hE.measurableSet
  have hψac : ContinuousOn (fun z => (u (ψa z)) ^ 2) ψa.source :=
    (hu.continuous.comp_continuousOn ψa.contMDiffOn_toFun.continuousOn).pow 2
  have hfLa : ContinuousOn (fun z => (u (ψa z)) ^ 2) La := hψac.mono hLas
  have hτc : ContinuousOn τ E := hτsm.continuousOn.mono hEΩ
  have hEL' : ∀ y ∈ E, τ y ∈ La := fun y hy => by rw [hτx]; exact hEL y hy
  have hfτ : ContinuousOn (fun y => (u (ψa (τ y))) ^ 2) E :=
    hψac.comp hτc (fun y hy => hLas (hEL' y hy))
  have hI1 : MeasureTheory.IntegrableOn (fun y => (u (ψa (τ y))) ^ 2) E :=
    hfτ.integrableOn_compact hE
  have hI2 : MeasureTheory.IntegrableOn
      (fun y => c⁻¹ * (|(fderiv ℝ τ y).det| * (u (ψa (τ y))) ^ 2)) E :=
    (continuousOn_const.mul (hdetc.mul hfτ)).integrableOn_compact hE
  have hCoV := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul MeasureTheory.volume
    hEm (fun y hy => (hτd y hy).hasFDerivAt.hasFDerivWithinAt) hinj
    (fun z => (u (ψa z)) ^ 2)
  simp only [smul_eq_mul] at hCoV
  have hpt : ∀ y ∈ E, (u (ψa (τ y))) ^ 2 ≤
      c⁻¹ * (|(fderiv ℝ τ y).det| * (u (ψa (τ y))) ^ 2) := by
    intro y hy
    have h1 : 1 ≤ c⁻¹ * |(fderiv ℝ τ y).det| := by
      rw [← inv_mul_cancel₀ hc.ne']
      exact mul_le_mul_of_nonneg_left (hcE y hy) (inv_nonneg.2 hc.le)
    have h2 := sq_nonneg (u (ψa (τ y)))
    nlinarith
  have himg : τ '' E ⊆ La := Set.image_subset_iff.2 (fun y hy => hEL' y hy)
  have hstep2 : ∫ z in τ '' E, (u (ψa z)) ^ 2 ≤ ∫ z in La, (u (ψa z)) ^ 2 :=
    MeasureTheory.setIntegral_mono_set (hfLa.integrableOn_compact hLa)
      (MeasureTheory.ae_restrict_of_forall_mem hLa.measurableSet (fun z _ => sq_nonneg _))
      himg.eventuallyLE
  have hstep0 : ∫ y in E, (u (ψb y)) ^ 2 = ∫ y in E, (u (ψa (τ y))) ^ 2 := by
    refine MeasureTheory.setIntegral_congr_fun hEm (fun y hy => ?_)
    have h1 : ψa (ψa.symm (ψb y)) = ψb y := ψa.toPartialEquiv.right_inv (hEt y hy)
    show (u (ψb y)) ^ 2 = (u (ψa (τ y))) ^ 2
    rw [hτx, h1]
  calc ∫ y in E, (u (ψb y)) ^ 2 = ∫ y in E, (u (ψa (τ y))) ^ 2 := hstep0
    _ ≤ ∫ y in E, c⁻¹ * (|(fderiv ℝ τ y).det| * (u (ψa (τ y))) ^ 2) :=
        MeasureTheory.setIntegral_mono_on hI1 hI2 hEm hpt
    _ = c⁻¹ * ∫ z in τ '' E, (u (ψa z)) ^ 2 := by rw [MeasureTheory.integral_const_mul, hCoV]
    _ ≤ c⁻¹ * ∫ z in La, (u (ψa z)) ^ 2 :=
        mul_le_mul_of_nonneg_left hstep2 (inv_nonneg.2 hc.le)

theorem cps_box_propagation (U : E3 → ℝ) (c y₀ : E3) (s t : ℝ) (hs : 0 < s) (ht : 0 < t)
    (W : Set E3) (hW : IsOpen W) (hU : ContDiffOn ℝ 1 U W)
    (hQW : {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s} ⊆ W)
    (hE : {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t} ⊆
      {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s}) :
    ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s}, U y ^ 2 ≤
      ((2 * s / t) ^ 3 + 8 * s ^ 2 * (1 + 2 * s / t + (2 * s / t) ^ 2)) *
        ((∫ y in {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t}, U y ^ 2) +
          ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
            ∑ i : Fin 3, (partialDeriv i U y) ^ 2) :=
by
  
  have hs1 : ∀ (f f' : ℝ → ℝ) (a b α β : ℝ), a ≤ α → α < β → β ≤ b →
      (∀ x ∈ Set.Icc a b, HasDerivAt f (f' x) x) → ContinuousOn f' (Set.Icc a b) →
      ∫ x in Set.Icc a b, f x ^ 2 ≤ 2 * (b - a) / (β - α) * (∫ x in Set.Icc α β, f x ^ 2) +
        2 * (b - a) ^ 2 * ∫ x in Set.Icc a b, f' x ^ 2 := by
    intro f f' a b α β haα hαβ hβb hf hf'
    have hab : a ≤ b := by linarith
    have hl : 0 < β - α := by linarith
    have hL : 0 < b - a := by linarith
    have hsub : Set.Icc α β ⊆ Set.Icc a b := Set.Icc_subset_Icc haα hβb
    have hfc : ContinuousOn f (Set.Icc a b) :=
      fun x hx => (hf x hx).continuousAt.continuousWithinAt
    have iF : IntegrableOn (fun x => f x ^ 2) (Set.Icc a b) := (hfc.pow 2).integrableOn_Icc
    have iFs : IntegrableOn (fun x => f x ^ 2) (Set.Icc α β) := iF.mono_set hsub
    have iD : IntegrableOn (fun x => f' x ^ 2) (Set.Icc a b) := (hf'.pow 2).integrableOn_Icc
    have iA : IntegrableOn (fun x => |f' x|) (Set.Icc a b) := hf'.abs.integrableOn_Icc
    have hV0 : 0 ≤ ∫ x in Set.Icc a b, |f' x| :=
      setIntegral_nonneg measurableSet_Icc (fun x _ => abs_nonneg _)
    have hR0 : 0 ≤ ∫ x in Set.Icc a b, f' x ^ 2 :=
      setIntegral_nonneg measurableSet_Icc (fun x _ => sq_nonneg _)
    have hvolab : volume.real (Set.Icc a b) = b - a := Real.volume_real_Icc_of_le hab
    have hvolαβ : volume.real (Set.Icc α β) = β - α := Real.volume_real_Icc_of_le hαβ.le
    have hinc : ∀ x ∈ Set.Icc a b, ∀ τ ∈ Set.Icc a b,
        |f x - f τ| ≤ ∫ x in Set.Icc a b, |f' x| := by
      intro x hx τ hτ
      have hsubu : Set.uIcc τ x ⊆ Set.Icc a b := Set.uIcc_subset_Icc hτ hx
      have hftc : ∫ y in τ..x, f' y = f x - f τ :=
        intervalIntegral.integral_eq_sub_of_hasDerivAt (fun y hy => hf y (hsubu hy))
          (ContinuousOn.intervalIntegrable (hf'.mono hsubu))
      rw [← hftc, intervalIntegral.abs_integral_eq_abs_integral_uIoc]
      calc |∫ y in Set.uIoc τ x, f' y| ≤ ∫ y in Set.uIoc τ x, |f' y| :=
            abs_integral_le_integral_abs
        _ ≤ ∫ x in Set.Icc a b, |f' x| :=
          setIntegral_mono_set iA (Filter.Eventually.of_forall (fun y => abs_nonneg _))
            (Set.uIoc_subset_uIcc.trans hsubu).eventuallyLE
    have hCS : (∫ x in Set.Icc a b, |f' x|) ^ 2 ≤ (b - a) * ∫ x in Set.Icc a b, f' x ^ 2 := by
      have hpt : ∀ y ∈ Set.Icc a b, 2 * ((∫ x in Set.Icc a b, |f' x|) * (b - a)) * |f' y| ≤
          (b - a) ^ 2 * f' y ^ 2 + (∫ x in Set.Icc a b, |f' x|) ^ 2 := by
        intro y _
        nlinarith [sq_nonneg ((b - a) * |f' y| - ∫ x in Set.Icc a b, |f' x|), sq_abs (f' y)]
      have h1 := setIntegral_mono_on (Integrable.const_mul iA _)
        ((Integrable.const_mul iD ((b - a) ^ 2)).add continuousOn_const.integrableOn_Icc)
        measurableSet_Icc hpt
      simp only [Pi.add_apply] at h1
      rw [integral_const_mul, integral_add (Integrable.const_mul iD _)
        continuousOn_const.integrableOn_Icc, integral_const_mul, setIntegral_const, hvolab,
        smul_eq_mul] at h1
      nlinarith
    have hpt2 : ∀ x ∈ Set.Icc a b, f x ^ 2 ≤
        2 * (∫ x in Set.Icc α β, f x ^ 2) / (β - α) +
          2 * (b - a) * ∫ x in Set.Icc a b, f' x ^ 2 := by
      intro x hx
      have hτ : ∀ τ ∈ Set.Icc α β, f x ^ 2 ≤
          2 * f τ ^ 2 + 2 * (b - a) * ∫ x in Set.Icc a b, f' x ^ 2 := by
        intro τ hτ
        have h1 := hinc x hx τ (hsub hτ)
        have h2 : (f x - f τ) ^ 2 ≤ (∫ x in Set.Icc a b, |f' x|) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
        nlinarith [sq_nonneg (f x - 2 * f τ)]
      have h3 := setIntegral_mono_on (continuousOn_const.integrableOn_Icc)
        ((Integrable.const_mul iFs 2).add continuousOn_const.integrableOn_Icc)
        measurableSet_Icc hτ
      simp only [Pi.add_apply] at h3
      rw [setIntegral_const, integral_add (Integrable.const_mul iFs _)
        continuousOn_const.integrableOn_Icc, integral_const_mul, setIntegral_const, hvolαβ,
        smul_eq_mul, smul_eq_mul] at h3
      rw [div_add' _ _ _ hl.ne', le_div_iff₀ hl]
      nlinarith
    have h4 := setIntegral_mono_on iF (continuousOn_const.integrableOn_Icc) measurableSet_Icc hpt2
    rw [setIntegral_const, hvolab, smul_eq_mul] at h4
    have hfin : (b - a) * (2 * (∫ x in Set.Icc α β, f x ^ 2) / (β - α) +
          2 * (b - a) * ∫ x in Set.Icc a b, f' x ^ 2) =
        2 * (b - a) / (β - α) * (∫ x in Set.Icc α β, f x ^ 2) +
          2 * (b - a) ^ 2 * ∫ x in Set.Icc a b, f' x ^ 2 := by
      field_simp
    rw [← hfin]
    exact h4
  
  have hs2 : ∀ (k : Fin 3) (z : Fin 2 → ℝ) (x : ℝ), (WithLp.toLp 2 (Fin.insertNth k x z) : E3) ∈ W →
      HasDerivAt (fun x' : ℝ => U (WithLp.toLp 2 (Fin.insertNth k x' z)))
        (partialDeriv k U (WithLp.toLp 2 (Fin.insertNth k x z))) x := by
    intro k z x hx
    set p : E3 := WithLp.toLp 2 (Fin.insertNth k x z) with hp
    have hline : ∀ x' : ℝ, (WithLp.toLp 2 (Fin.insertNth k x' z) : E3) = p + (x' - x) • e k := by
      intro x'
      ext j
      rcases Fin.eq_self_or_eq_succAbove k j with rfl | ⟨j', rfl⟩
      · simp [hp, e]
      · simp [hp, e, Fin.succAbove_ne]
    have hfun : (fun x' : ℝ => U (WithLp.toLp 2 (Fin.insertNth k x' z))) =
        U ∘ (fun x' : ℝ => p + (x' - x) • e k) := by
      funext x'; simp only [Function.comp, hline]
    rw [hfun]
    have hγ : HasDerivAt (fun x' : ℝ => p + (x' - x) • e k) (e k) x := by
      have := (((hasDerivAt_id' x).sub_const x).smul_const (e k)).const_add p
      rw [one_smul] at this
      exact this
    have hUd : HasFDerivAt U (fderiv ℝ U p) ((fun x' : ℝ => p + (x' - x) • e k) x) := by
      simp only [sub_self, zero_smul, add_zero]
      exact ((hU.differentiableOn one_ne_zero).differentiableAt (hW.mem_nhds hx)).hasFDerivAt
    exact hUd.comp_hasDerivAt x hγ
  
  have hfub : ∀ (k : Fin 3) (lo hi : Fin 3 → ℝ) (Ψ : E3 → ℝ),
      IntegrableOn Ψ {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} →
      IntegrableOn (fun z : Fin 2 → ℝ =>
          ∫ x in Set.Icc (lo k) (hi k), Ψ (WithLp.toLp 2 (Fin.insertNth k x z)))
        (Set.univ.pi fun j : Fin 2 => Set.Icc (lo (k.succAbove j)) (hi (k.succAbove j))) ∧
      ∫ y in {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i}, Ψ y =
        ∫ z in Set.univ.pi (fun j : Fin 2 => Set.Icc (lo (k.succAbove j)) (hi (k.succAbove j))),
          ∫ x in Set.Icc (lo k) (hi k), Ψ (WithLp.toLp 2 (Fin.insertNth k x z)) := by
    intro k lo hi Ψ hΨ
    obtain ⟨Φ, hΦ, hΦw⟩ : ∃ Φ : (Fin 2 → ℝ) × ℝ ≃ᵐ E3, MeasurePreserving Φ volume volume ∧
        ∀ w, Φ w = (WithLp.toLp 2 (Fin.insertNth k w.2 w.1) : E3) := by
      refine ⟨MeasurableEquiv.prodComm.trans
        ((MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) k).symm.trans
          (MeasurableEquiv.toLp 2 (Fin 3 → ℝ))), ?_, ?_⟩
      · refine MeasurePreserving.trans ?_ (MeasurePreserving.trans
          (MeasurePreserving.symm _ (volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) k)) ?_)
        · exact Measure.measurePreserving_swap
        · exact MeasurePreserving.symm _
            (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3))
      · intro w; rfl
    have hpre : Φ ⁻¹' {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} =
        (Set.univ.pi fun j : Fin 2 => Set.Icc (lo (k.succAbove j)) (hi (k.succAbove j))) ×ˢ
          Set.Icc (lo k) (hi k) := by
      ext ⟨z, x⟩
      simp only [Set.mem_preimage, hΦw, Set.mem_prod, Set.mem_univ_pi, Set.mem_Icc,
        Set.mem_setOf_eq, Fin.forall_iff_succAbove k, Fin.insertNth_apply_same,
        Fin.insertNth_apply_succAbove]
      tauto
    have hint : IntegrableOn (fun w => Ψ (Φ w)) (Φ ⁻¹' {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i}) :=
      (hΦ.integrableOn_comp_preimage Φ.measurableEmbedding).2 hΨ
    rw [hpre] at hint
    have hint2 : Integrable (fun w => Ψ (Φ w))
        ((volume.restrict (Set.univ.pi fun j : Fin 2 =>
          Set.Icc (lo (k.succAbove j)) (hi (k.succAbove j)))).prod
          (volume.restrict (Set.Icc (lo k) (hi k)))) := by
      rw [Measure.prod_restrict]; exact hint
    constructor
    · have := hint2.integral_prod_left
      simpa only [hΦw] using this
    · rw [← hΦ.setIntegral_preimage_emb Φ.measurableEmbedding, hpre, Measure.volume_eq_prod,
        setIntegral_prod _ hint]
      simp only [hΦw]
  
  have hBoxCpt : ∀ lo hi : Fin 3 → ℝ, IsCompact {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} := by
    intro lo hi
    have heq : {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} =
        (WithLp.toLp 2) '' (Set.univ.pi fun i : Fin 3 => Set.Icc (lo i) (hi i)) := by
      ext y
      constructor
      · intro hy
        exact ⟨y.ofLp, fun i _ => hy i, rfl⟩
      · rintro ⟨x, hx, rfl⟩ i
        exact hx i (Set.mem_univ _)
    rw [heq]
    exact (isCompact_univ_pi fun i => isCompact_Icc).image (PiLp.continuous_toLp 2 _)
  have hUc : ContinuousOn U W := hU.continuousOn
  have hDc : ∀ k : Fin 3, ContinuousOn (fun y => partialDeriv k U y) W := fun k =>
    (hU.continuousOn_fderiv_of_isOpen hW le_rfl).clm_apply continuousOn_const
  have hpass : ∀ (lo hi lo' hi' : Fin 3 → ℝ) (k : Fin 3),
      (∀ j : Fin 3, j ≠ k → lo' j = lo j ∧ hi' j = hi j) → lo k ≤ lo' k → lo' k < hi' k →
      hi' k ≤ hi k → {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} ⊆ W →
      ∫ y in {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i}, U y ^ 2 ≤
        2 * (hi k - lo k) / (hi' k - lo' k) *
          (∫ y in {y : E3 | ∀ i : Fin 3, lo' i ≤ y i ∧ y i ≤ hi' i}, U y ^ 2) +
        2 * (hi k - lo k) ^ 2 *
          ∫ y in {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i}, partialDeriv k U y ^ 2 := by
    intro lo hi lo' hi' k hoff hlo hlt hhi hBW
    have hsub' : {y : E3 | ∀ i : Fin 3, lo' i ≤ y i ∧ y i ≤ hi' i} ⊆
        {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} := by
      intro y hy i
      by_cases hik : i = k
      · subst hik
        exact ⟨hlo.trans (hy i).1, (hy i).2.trans hhi⟩
      · rw [← (hoff i hik).1, ← (hoff i hik).2]
        exact hy i
    have hbase : (Set.univ.pi fun j : Fin 2 => Set.Icc (lo' (k.succAbove j)) (hi' (k.succAbove j)))
        = Set.univ.pi fun j : Fin 2 => Set.Icc (lo (k.succAbove j)) (hi (k.succAbove j)) := by
      congr 1
      funext j
      rw [(hoff _ (Fin.succAbove_ne k j)).1, (hoff _ (Fin.succAbove_ne k j)).2]
    have iF : IntegrableOn (fun y => U y ^ 2) {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} :=
      ((hUc.mono hBW).pow 2).integrableOn_compact (hBoxCpt lo hi)
    have iG : IntegrableOn (fun y => U y ^ 2) {y : E3 | ∀ i : Fin 3, lo' i ≤ y i ∧ y i ≤ hi' i} :=
      ((hUc.mono (hsub'.trans hBW)).pow 2).integrableOn_compact (hBoxCpt lo' hi')
    have iH : IntegrableOn (fun y => partialDeriv k U y ^ 2)
        {y : E3 | ∀ i : Fin 3, lo i ≤ y i ∧ y i ≤ hi i} :=
      (((hDc k).mono hBW).pow 2).integrableOn_compact (hBoxCpt lo hi)
    obtain ⟨jF, eF⟩ := hfub k lo hi (fun y => U y ^ 2) iF
    obtain ⟨jG, eG⟩ := hfub k lo' hi' (fun y => U y ^ 2) iG
    obtain ⟨jH, eH⟩ := hfub k lo hi (fun y => partialDeriv k U y ^ 2) iH
    rw [hbase] at jG eG
    rw [eF, eG, eH, ← integral_const_mul, ← integral_const_mul,
      ← integral_add (jG.const_mul _) (jH.const_mul _)]
    refine setIntegral_mono_on jF ((jG.const_mul _).add (jH.const_mul _))
      (MeasurableSet.univ_pi fun j => measurableSet_Icc) ?_
    intro z hz
    rw [Set.mem_univ_pi] at hz
    have hmem : ∀ x ∈ Set.Icc (lo k) (hi k),
        (WithLp.toLp 2 (Fin.insertNth k x z) : E3) ∈ W := by
      intro x hx
      apply hBW
      intro i
      rcases Fin.eq_self_or_eq_succAbove k i with rfl | ⟨j, rfl⟩
      · show lo i ≤ (Fin.insertNth i x z : Fin 3 → ℝ) i ∧ (Fin.insertNth i x z : Fin 3 → ℝ) i ≤ hi i
        rw [Fin.insertNth_apply_same]
        exact hx
      · show lo (k.succAbove j) ≤ (Fin.insertNth k x z : Fin 3 → ℝ) (k.succAbove j) ∧
          (Fin.insertNth k x z : Fin 3 → ℝ) (k.succAbove j) ≤ hi (k.succAbove j)
        rw [Fin.insertNth_apply_succAbove]
        exact hz j
    have hTc : Continuous (fun x : ℝ => (WithLp.toLp 2 (Fin.insertNth k x z) : E3)) :=
      (PiLp.continuous_toLp 2 _).comp (Continuous.finInsertNth k continuous_id continuous_const)
    exact hs1 (fun x => U (WithLp.toLp 2 (Fin.insertNth k x z)))
      (fun x => partialDeriv k U (WithLp.toLp 2 (Fin.insertNth k x z))) (lo k) (hi k) (lo' k)
      (hi' k) hlo hlt hhi (fun x hx => hs2 k z x (hmem x hx))
      ((hDc k).comp hTc.continuousOn (fun x hx => hmem x hx))
  
  have hcorner : ∀ j : Fin 3, c j - s ≤ y₀ j - t ∧ y₀ j + t ≤ c j + s := by
    intro j
    have hp := hE (show (WithLp.toLp 2 (fun i => y₀ i + t) : E3) ∈
        {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t} from
      fun i => ⟨show y₀ i - t ≤ y₀ i + t by linarith, le_refl (y₀ i + t)⟩) j
    have hq := hE (show (WithLp.toLp 2 (fun i => y₀ i - t) : E3) ∈
        {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t} from
      fun i => ⟨le_refl (y₀ i - t), show y₀ i - t ≤ y₀ i + t by linarith⟩) j
    exact ⟨hq.1, hp.2⟩
  obtain ⟨L, hL⟩ : ∃ L : ℕ → Fin 3 → ℝ,
      L = fun m (i : Fin 3) => if i.val < m then y₀ i - t else c i - s := ⟨_, rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : ℕ → Fin 3 → ℝ,
      H = fun m (i : Fin 3) => if i.val < m then y₀ i + t else c i + s := ⟨_, rfl⟩
  have hBQ : ∀ m : ℕ, {y : E3 | ∀ i : Fin 3, L m i ≤ y i ∧ y i ≤ H m i} ⊆
      {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s} := by
    intro m y hy i
    have h := hy i
    have hc := hcorner i
    rw [hL, hH] at h
    simp only at h
    split_ifs at h
    · exact ⟨by linarith [h.1], by linarith [h.2]⟩
    · exact h
  have hB0 : {y : E3 | ∀ i : Fin 3, L 0 i ≤ y i ∧ y i ≤ H 0 i} =
      {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s} := by
    rw [hL, hH]; simp
  have hB3 : {y : E3 | ∀ i : Fin 3, L 3 i ≤ y i ∧ y i ≤ H 3 i} =
      {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t} := by
    rw [hL, hH]; simp [Fin.is_lt]
  have hQcpt := hBoxCpt (fun i => c i - s) (fun i => c i + s)
  have hstage : ∀ k : Fin 3,
      ∫ y in {y : E3 | ∀ i : Fin 3, L k.val i ≤ y i ∧ y i ≤ H k.val i}, U y ^ 2 ≤
        2 * s / t * (∫ y in {y : E3 | ∀ i : Fin 3, L (k.val + 1) i ≤ y i ∧ y i ≤ H (k.val + 1) i},
          U y ^ 2) +
        8 * s ^ 2 * ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
          partialDeriv k U y ^ 2 := by
    intro k
    have hoff : ∀ j : Fin 3, j ≠ k → L (k.val + 1) j = L k.val j ∧ H (k.val + 1) j = H k.val j := by
      intro j hj
      have hjk : (j : ℕ) ≠ k.val := fun h => hj (Fin.ext h)
      rw [hL, hH]
      simp only
      constructor <;> split_ifs <;> first | rfl | omega
    have e1 : L k.val k = c k - s := by rw [hL]; simp
    have e2 : H k.val k = c k + s := by rw [hH]; simp
    have e3 : L (k.val + 1) k = y₀ k - t := by rw [hL]; simp
    have e4 : H (k.val + 1) k = y₀ k + t := by rw [hH]; simp
    have hp := hpass (L k.val) (H k.val) (L (k.val + 1)) (H (k.val + 1)) k hoff
      (by rw [e1, e3]; exact (hcorner k).1) (by rw [e3, e4]; linarith)
      (by rw [e2, e4]; exact (hcorner k).2) ((hBQ _).trans hQW)
    rw [e1, e2, e3, e4] at hp
    have hc1 : 2 * (c k + s - (c k - s)) / (y₀ k + t - (y₀ k - t)) = 2 * s / t := by
      rw [div_eq_div_iff (by linarith) ht.ne']; ring
    have hc2 : 2 * (c k + s - (c k - s)) ^ 2 = 8 * s ^ 2 := by ring
    rw [hc1, hc2] at hp
    have hmono : ∫ y in {y : E3 | ∀ i : Fin 3, L k.val i ≤ y i ∧ y i ≤ H k.val i},
          partialDeriv k U y ^ 2 ≤
        ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s}, partialDeriv k U y ^ 2 :=
      setIntegral_mono_set ((((hDc k).mono hQW).pow 2).integrableOn_compact hQcpt)
        (Filter.Eventually.of_forall (fun y => sq_nonneg _)) (hBQ _).eventuallyLE
    have h8 : (0 : ℝ) ≤ 8 * s ^ 2 := by positivity
    linarith [mul_le_mul_of_nonneg_left hmono h8]
  have h0 : ∫ y in {y : E3 | ∀ i : Fin 3, L 0 i ≤ y i ∧ y i ≤ H 0 i}, U y ^ 2 ≤
      2 * s / t * (∫ y in {y : E3 | ∀ i : Fin 3, L 1 i ≤ y i ∧ y i ≤ H 1 i}, U y ^ 2) +
        8 * s ^ 2 * ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
          partialDeriv 0 U y ^ 2 := hstage 0
  have h1 : ∫ y in {y : E3 | ∀ i : Fin 3, L 1 i ≤ y i ∧ y i ≤ H 1 i}, U y ^ 2 ≤
      2 * s / t * (∫ y in {y : E3 | ∀ i : Fin 3, L 2 i ≤ y i ∧ y i ≤ H 2 i}, U y ^ 2) +
        8 * s ^ 2 * ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
          partialDeriv 1 U y ^ 2 := hstage 1
  have h2 : ∫ y in {y : E3 | ∀ i : Fin 3, L 2 i ≤ y i ∧ y i ≤ H 2 i}, U y ^ 2 ≤
      2 * s / t * (∫ y in {y : E3 | ∀ i : Fin 3, L 3 i ≤ y i ∧ y i ≤ H 3 i}, U y ^ 2) +
        8 * s ^ 2 * ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
          partialDeriv 2 U y ^ 2 := hstage 2
  rw [hB0] at h0
  rw [hB3] at h2
  have hsum : ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
        ∑ i : Fin 3, (partialDeriv i U y) ^ 2 =
      ∑ i : Fin 3, ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
        (partialDeriv i U y) ^ 2 :=
    integral_finset_sum Finset.univ (fun i _ =>
      (((hDc i).mono hQW).pow 2).integrableOn_compact hQcpt)
  rw [hsum, Fin.sum_univ_three]
  have hQm : MeasurableSet {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s} :=
    hQcpt.isClosed.measurableSet
  have hEm : MeasurableSet {y : E3 | ∀ i : Fin 3, y₀ i - t ≤ y i ∧ y i ≤ y₀ i + t} :=
    (hBoxCpt (fun i => y₀ i - t) (fun i => y₀ i + t)).isClosed.measurableSet
  have alg : ∀ a b P0 P1 P2 P3 D0 D1 D2 : ℝ, 0 ≤ a → 0 ≤ b → 0 ≤ P3 → 0 ≤ D0 → 0 ≤ D1 →
      0 ≤ D2 → P0 ≤ a * P1 + b * D0 → P1 ≤ a * P2 + b * D1 → P2 ≤ a * P3 + b * D2 →
      P0 ≤ (a ^ 3 + b * (1 + a + a ^ 2)) * (P3 + (D0 + D1 + D2)) := by
    intro a b P0 P1 P2 P3 D0 D1 D2 ha hb hP3 hD0 hD1 hD2 g0 g1 g2
    have k1 := mul_le_mul_of_nonneg_left g1 ha
    have k2 := mul_le_mul_of_nonneg_left g2 (mul_nonneg ha ha)
    have key : (a ^ 3 + b * (1 + a + a ^ 2)) * (P3 + (D0 + D1 + D2)) -
        (a ^ 3 * P3 + a ^ 2 * b * D2 + a * b * D1 + b * D0) =
        a ^ 3 * (D0 + D1 + D2) + b * (1 + a + a ^ 2) * P3 + b * (a + a ^ 2) * D0 +
          b * (1 + a ^ 2) * D1 + b * (1 + a) * D2 := by ring
    have t1 : 0 ≤ a ^ 3 * (D0 + D1 + D2) := by positivity
    have t2 : 0 ≤ b * (1 + a + a ^ 2) * P3 := by positivity
    have t3 : 0 ≤ b * (a + a ^ 2) * D0 := by positivity
    have t4 : 0 ≤ b * (1 + a ^ 2) * D1 := by positivity
    have t5 : 0 ≤ b * (1 + a) * D2 := by positivity
    nlinarith
  exact alg (2 * s / t) (8 * s ^ 2) _ _ _ _ _ _ _ (by positivity) (by positivity)
    (setIntegral_nonneg hEm (fun y _ => sq_nonneg _))
    (setIntegral_nonneg hQm (fun y _ => sq_nonneg _))
    (setIntegral_nonneg hQm (fun y _ => sq_nonneg _))
    (setIntegral_nonneg hQm (fun y _ => sq_nonneg _)) h0 h1 h2

theorem cps_cube_energy [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (c : E3) (s : ℝ) (hs : 0 < s) (hB : Metric.closedBall c (2 * s) ⊆ ψ.source) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
        ∑ i : Fin 3, (partialDeriv i (fun z => u (ψ z)) y) ^ 2 ≤
          C * atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  obtain ⟨_, hχs, hχ0, hχ1, hχt, hcase⟩ := hA
  
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => by fun_prop
  obtain ⟨Q, hQ⟩ : ∃ Q : Set E3, Q = {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s} :=
    ⟨_, rfl⟩
  rw [← hQ]
  have hF1 : Q ⊆ Metric.closedBall c (2 * s) := by
    rw [hQ]
    intro y hy
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq]
    have h : ∀ i, dist (y i) (c i) ^ 2 ≤ s ^ 2 := by
      intro i
      have h1 := hy i
      rw [Real.dist_eq]
      have h2 : |y i - c i| ≤ s := abs_le.2 ⟨by linarith [h1.1], by linarith [h1.2]⟩
      have h3 : |y i - c i| ^ 2 ≤ s ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2 2
      exact h3
    have h4 : ∑ i : Fin 3, dist (y i) (c i) ^ 2 ≤ (2 * s) ^ 2 := by
      rw [Fin.sum_univ_three]
      nlinarith [h 0, h 1, h 2, sq_nonneg s]
    calc Real.sqrt (∑ i : Fin 3, dist (y i) (c i) ^ 2) ≤ Real.sqrt ((2 * s) ^ 2) :=
          Real.sqrt_le_sqrt h4
      _ = 2 * s := Real.sqrt_sq (by linarith)
  have hQclosed : IsClosed Q := by
    have : Q = ⋂ i : Fin 3, {y : E3 | c i - s ≤ y i ∧ y i ≤ c i + s} := by
      rw [hQ]; ext y; simp
    rw [this]
    exact isClosed_iInter fun i =>
      (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
  have hQc : IsCompact Q := (isCompact_closedBall c (2 * s)).of_isClosed_subset hQclosed hF1
  have hQψ : Q ⊆ ψ.source := hF1.trans hB
  have hQm : MeasurableSet Q := hQclosed.measurableSet
  
  have hell : ∀ (ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (z : E3) (R : ℝ),
      Metric.closedBall z R ⊆ ψ'.source → ∃ m : ℝ, 0 < m ∧ ∀ y ∈ Metric.closedBall z R,
        ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
          m * ∑ i : Fin 3, (partialDeriv i (fun w => u (ψ' w)) y) ^ 2 ≤
            g.gradInner u u (ψ' y) := by
    intro ψ' z R hzR
    obtain ⟨m, Mx, Γ, hm, -, -, hb⟩ := coeff_compact_bounds (fun y => (g.coeff ψ' y)⁻¹)
      ψ'.source z R ψ'.open_source hzR (flat_coeff_regular g ψ').1
      (flat_coeff_regular g ψ').2.2.1
    refine ⟨m, hm, fun y hy u hu => ?_⟩
    have h1 : m * ∑ i : Fin 3, (partialDeriv i (fun w => u (ψ' w)) y) ^ 2 ≤
        ∑ i : Fin 3, ∑ j : Fin 3, partialDeriv i (fun w => u (ψ' w)) y *
          (g.coeff ψ' y)⁻¹ i j * partialDeriv j (fun w => u (ψ' w)) y :=
      ((hb y hy).1 (fun i => partialDeriv i (fun w => u (ψ' w)) y))
    rw [gradInner_pdiffeo_formula g ψ' u u hu hu y (hzR hy)]
    refine h1.trans (le_of_eq ?_)
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    ring
  
  have hnn : ∀ (ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (u : M → ℝ),
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ z ∈ ψ'.source, 0 ≤ g.gradInner u u (ψ' z) := by
    intro ψ' u hu z hz
    have hzB : Metric.closedBall z 0 ⊆ ψ'.source := by
      rw [Metric.closedBall_zero]; exact Set.singleton_subset_iff.2 hz
    obtain ⟨m, hm, hb⟩ := hell ψ' z 0 hzB
    have h1 := hb z (Metric.mem_closedBall_self le_rfl) u hu
    have h2 : 0 ≤ m * ∑ i : Fin 3, (partialDeriv i (fun w => u (ψ' w)) z) ^ 2 :=
      mul_nonneg hm.le (Finset.sum_nonneg fun i _ => sq_nonneg _)
    linarith
  
  have hdetc : ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source :=
    (nds_chart_cont g ψ (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ)) contMDiff_const
      contMDiff_const).2.2.2.1
  obtain ⟨y₀, hy₀, hmin⟩ := (isCompact_closedBall c (2 * s)).exists_isMinOn
    ⟨c, Metric.mem_closedBall_self (by linarith)⟩ (hdetc.mono hB)
  have hm₀ : 0 < Real.sqrt (g.coeff ψ y₀).det :=
    Real.sqrt_pos.2 (coeff_posDef g ψ y₀ (hB hy₀)).det_pos
  obtain ⟨m, hm, hbd⟩ := hell ψ c (2 * s) hB
  have hCpos : 0 < m * Real.sqrt (g.coeff ψ y₀).det := mul_pos hm hm₀
  refine ⟨(m * Real.sqrt (g.coeff ψ y₀).det)⁻¹, (inv_pos.2 hCpos).le, ?_⟩
  intro u hu hus
  
  have hpt : ∀ y ∈ Q, ∑ i : Fin 3, (partialDeriv i (fun z => u (ψ z)) y) ^ 2 ≤
      (m * Real.sqrt (g.coeff ψ y₀).det)⁻¹ *
        (g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det) := by
    intro y hy
    have hyB := hF1 hy
    have h1 := hbd y hyB u hu
    have h2 : Real.sqrt (g.coeff ψ y₀).det ≤ Real.sqrt (g.coeff ψ y).det :=
      isMinOn_iff.1 hmin y hyB
    have h3 := hnn ψ u hu y (hB hyB)
    rw [inv_mul_eq_div, le_div_iff₀ hCpos]
    have h4 := mul_le_mul_of_nonneg_left h2 h3
    have h5 := mul_le_mul_of_nonneg_right h1 hm₀.le
    nlinarith [h4, h5]
  
  have hGc : ∀ ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => g.gradInner u u (ψ' y)) ψ'.source :=
    fun ψ' => (nds_chart_cont g ψ' u u hu hu).2.2.1
  have hDc : ∀ ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => Real.sqrt (g.coeff ψ' y).det) ψ'.source :=
    fun ψ' => (nds_chart_cont g ψ' u u hu hu).2.2.2.1
  
  have hGK : ∀ p, p ∉ tsupport u → g.gradInner u u p = 0 := by
    intro p hp
    have h1 := ((lapM_gradInner_linear_local g u (fun _ => (0 : ℝ)) u p).2 (tsupport u)ᶜ
      (isClosed_tsupport u).isOpen_compl hp
      (fun q hq => image_eq_zero_of_notMem_tsupport hq)).2
    rw [h1]
    simp [RiemannianMetric3.gradInner, partialDeriv]
  have hK : IsCompact (tsupport u) := hus
  
  have hfar : ∀ j : Fin hAF.numEnds, ∃ R : ℝ, ∀ y : E3, R < ‖y‖ →
      (hAF.ends j).Φ y ∉ tsupport u := by
    intro j
    obtain ⟨ρ₀, hρ₀, hcl⟩ := endChart_far_isClosed g hAF j
    let O : ℕ → Set M := fun m => ((hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖})ᶜ
    have hOo : ∀ m, IsOpen (O m) := fun m =>
      (hcl _ (le_add_of_nonneg_right (Nat.cast_nonneg m))).isOpen_compl
    have hOmono : Monotone O := by
      intro m m' hmm' p hp
      simp only [O, Set.mem_compl_iff] at hp ⊢
      intro hp'
      apply hp
      obtain ⟨z, hz, hzp⟩ := hp'
      refine ⟨z, ?_, hzp⟩
      have h1 : (m : ℝ) ≤ m' := Nat.cast_le.2 hmm'
      have h2 : ρ₀ + (m' : ℝ) ≤ ‖z‖ := hz
      show ρ₀ + (m : ℝ) ≤ ‖z‖
      linarith
    have hcovK : tsupport u ⊆ ⋃ m, O m := by
      intro p _
      by_contra hne
      have hmem : ∀ m : ℕ, p ∈ (hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖} := fun m =>
        Classical.byContradiction fun h => hne (Set.mem_iUnion.2 ⟨m, h⟩)
      obtain ⟨z₀, hz₀, hpz₀⟩ := hmem 0
      obtain ⟨m, hm⟩ := exists_nat_gt (‖z₀‖ - ρ₀)
      obtain ⟨z₁, hz₁, hpz₁⟩ := hmem m
      have h0 : ρ₀ + ((0 : ℕ) : ℝ) ≤ ‖z₀‖ := hz₀
      have h1 : ρ₀ + (m : ℝ) ≤ ‖z₁‖ := hz₁
      simp only [Nat.cast_zero, add_zero] at h0
      have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
      have hz₀s : z₀ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₀‖; linarith
      have hz₁s : z₁ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₁‖; linarith
      have heq : z₀ = z₁ :=
        (hAF.ends j).Φ.toPartialEquiv.injOn hz₀s hz₁s (hpz₀.trans hpz₁.symm)
      rw [← heq] at h1
      linarith
    obtain ⟨N, hN⟩ := hK.elim_directed_cover O hOo hcovK hOmono.directed_le
    refine ⟨ρ₀ + N, fun y hy hyK => hN hyK ⟨y, ?_, rfl⟩⟩
    show ρ₀ + (N : ℝ) ≤ ‖y‖
    linarith
  
  have hH : ∀ i, ContinuousOn
      (fun y => χ i (κ i y) * g.gradInner u u (κ i y) * Real.sqrt (g.coeff (κ i) y).det)
      (κ i).source := fun i =>
    (((hχs i).continuous.comp_continuousOn
      (κ i).contMDiffOn_toFun.continuousOn).mul (hGc (κ i))).mul (hDc (κ i))
  have hZ : ∀ i, ∃ Z : Set E3, IsCompact Z ∧ Z ⊆ (κ i).source ∧
      ∀ y ∈ (κ i).source, y ∉ Z →
        χ i (κ i y) * g.gradInner u u (κ i y) * Real.sqrt (g.coeff (κ i) y).det = 0 := by
    intro i
    rcases hcase i with hc | ⟨j, hκ, -, h0⟩
    · refine ⟨(κ i).toPartialEquiv.symm '' tsupport (χ i), ?_, ?_, ?_⟩
      · exact hc.image_of_continuousOn
          ((κ i).toOpenPartialHomeomorph.continuousOn_symm.mono (hχt i))
      · rintro _ ⟨x, hx, rfl⟩
        exact (κ i).toPartialEquiv.map_target (hχt i hx)
      · intro y hy hyZ
        have hns : κ i y ∉ tsupport (χ i) := by
          intro hmem
          exact hyZ ⟨κ i y, hmem, (κ i).toPartialEquiv.left_inv hy⟩
        rw [image_eq_zero_of_notMem_tsupport hns, zero_mul, zero_mul]
    · obtain ⟨R, hR⟩ := hfar j
      refine ⟨{y : E3 | ρA ≤ ‖y‖} ∩ {y : E3 | ‖y‖ ≤ max R ρA}, ?_, ?_, ?_⟩
      · refine (isCompact_closedBall (0 : E3) (max R ρA)).of_isClosed_subset
          ((isClosed_le continuous_const continuous_norm).inter
            (isClosed_le continuous_norm continuous_const)) ?_
        intro y hy
        rw [mem_closedBall_zero_iff]
        exact hy.2
      · intro y hy
        have h1 : ρA ≤ ‖y‖ := hy.1
        rw [hκ, (hAF.ends j).source_eq]
        show (1 : ℝ) < ‖y‖
        linarith
      · intro y hy hyZ
        rw [hκ] at hy ⊢
        have hy1 : (1 : ℝ) < ‖y‖ := by
          have h2 := hy
          rw [(hAF.ends j).source_eq] at h2
          exact h2
        by_cases hle : ‖y‖ ≤ ρA
        · rw [h0 y hy1 hle, zero_mul, zero_mul]
        · have hgt : max R ρA < ‖y‖ := by
            by_contra hc'
            exact hyZ ⟨le_of_lt (not_le.1 hle), not_lt.1 hc'⟩
          rw [hGK _ (hR y (lt_of_le_of_lt (le_max_left _ _) hgt)), mul_zero, zero_mul]
  have hHint : ∀ i, IntegrableOn
      (fun y => χ i (κ i y) * g.gradInner u u (κ i y) * Real.sqrt (g.coeff (κ i) y).det)
      (κ i).source := by
    intro i
    obtain ⟨Z, hZc, hZS, hZ0⟩ := hZ i
    exact (((hH i).mono hZS).integrableOn_compact hZc).of_forall_diff_eq_zero
      (κ i).open_source.measurableSet (fun y hy => hZ0 y hy.1 hy.2)
  
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
    simpa using this.symm
  have hexpB : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hexp w1, ← hexp w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  have hgL : ∀ i, IntegrableOn
      (fun y => χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det) Q :=
    fun i => (((((hχs i).continuous.comp_continuousOn ψ.contMDiffOn_toFun.continuousOn).mul
      (hGc ψ)).mul (hDc ψ)).mono hQψ).integrableOn_compact hQc
  
  have key : ∀ i, ∫ y in Q, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
      ∫ z in (κ i).source,
        χ i (κ i z) * g.gradInner u u (κ i z) * Real.sqrt (g.coeff (κ i) z).det := by
    intro i
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set E3, Ω = ψ.source ∩ ψ ⁻¹' (κ i).target := ⟨_, rfl⟩
    have hΩmem : ∀ y, y ∈ Ω ↔ y ∈ ψ.source ∧ ψ y ∈ (κ i).target := by
      intro y; rw [hΩ]; rfl
    have hΩo : IsOpen Ω := by
      rw [hΩ]
      exact ψ.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψ.open_source
        (κ i).open_target
    obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun y => (κ i).toPartialEquiv.symm (ψ y) := ⟨_, rfl⟩
    have hτsm : ContDiffOn ℝ ∞ τ Ω := by
      rw [hτ, hΩ]
      exact contMDiffOn_iff_contDiffOn.mp (ContMDiffOn.comp (κ i).contMDiffOn_invFun
        (ψ.contMDiffOn_toFun.mono Set.inter_subset_left) (fun y hy => hy.2))
    have hτd : ∀ y ∈ Ω, DifferentiableAt ℝ τ y := fun y hy =>
      (hτsm.differentiableOn (by simp)).differentiableAt (hΩo.mem_nhds hy)
    have hκτ : ∀ y ∈ Ω, κ i (τ y) = ψ y := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.right_inv ((hΩmem y).1 hy).2
    have hτmem : ∀ y ∈ Ω, τ y ∈ (κ i).source := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.map_target ((hΩmem y).1 hy).2
    
    have hjac : ∀ y ∈ Ω, Real.sqrt (g.coeff ψ y).det =
        |(fderiv ℝ τ y).det| * Real.sqrt (g.coeff (κ i) (τ y)).det := by
      intro y hy
      have hmdκ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) :=
        ((κ i).contMDiffOn_toFun.contMDiffAt
          ((κ i).open_source.mem_nhds (hτmem y hy))).mdifferentiableAt (by simp)
      have hmdτ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ y := (hτd y hy).mdifferentiableAt
      have heq : (ψ : E3 → M) =ᶠ[𝓝 y] (κ i) ∘ τ := by
        filter_upwards [hΩo.mem_nhds hy] with z hz
        exact (hκτ z hz).symm
      have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)).comp (fderiv ℝ τ y) := by
        rw [heq.mfderiv_eq, mfderiv_comp y hmdκ hmdτ, mfderiv_eq_fderiv]
      obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin 3) (Fin 3) ℝ,
          J = Matrix.of fun a b => fderiv ℝ τ y (e b) a := ⟨_, rfl⟩
      have hcoeff : g.coeff ψ y = J.transpose * g.coeff (κ i) (τ y) * J := by
        ext a b
        have hl : g.coeff ψ y a b = g.g (ψ y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e a)))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e b))) := by
          show g.g (ψ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e b)) = _
          rw [hmf]
          rfl
        have hr : ∀ a' b' : Fin 3, g.coeff (κ i) (τ y) a' b' =
            (g.g (ψ y) : E3 →L[ℝ] E3 →L[ℝ] ℝ)
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e a'))
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e b')) := by
          intro a' b'
          show g.g (κ i (τ y)) _ _ = _
          rw [hκτ y hy]
          try rfl
        have hl2 : g.coeff ψ y a b = ∑ a' : Fin 3, ∑ b' : Fin 3,
            fderiv ℝ τ y (e a) a' * fderiv ℝ τ y (e b) b' * g.coeff (κ i) (τ y) a' b' := by
          rw [hl]
          refine (hexpB (g.g (ψ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)) _ _).trans ?_
          refine Finset.sum_congr rfl fun a' _ => Finset.sum_congr rfl fun b' _ => ?_
          exact congrArg _ (hr a' b').symm
        rw [hl2]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
          Fin.sum_univ_three]
        ring
      have hdetJ : J.det = (fderiv ℝ τ y).det := by
        show J.det = LinearMap.det ((fderiv ℝ τ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
        congr 1
        try (ext a b; rw [hJ, LinearMap.toMatrix_apply]; simp)
      rw [hcoeff, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hdetJ]
      rw [show (fderiv ℝ τ y).det * (g.coeff (κ i) (τ y)).det * (fderiv ℝ τ y).det =
          (fderiv ℝ τ y).det ^ 2 * (g.coeff (κ i) (τ y)).det by ring]
      rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    
    have hEm : MeasurableSet (Q ∩ Ω) := hQm.inter hΩo.measurableSet
    have hEΩ : Q ∩ Ω ⊆ Ω := Set.inter_subset_right
    have hτinj : Set.InjOn τ (Q ∩ Ω) := by
      intro y₁ hy₁ y₂ hy₂ h
      have h' : ψ y₁ = ψ y₂ := by
        rw [← hκτ y₁ (hEΩ hy₁), ← hκτ y₂ (hEΩ hy₂), h]
      exact ψ.toPartialEquiv.injOn ((hΩmem y₁).1 (hEΩ hy₁)).1 ((hΩmem y₂).1 (hEΩ hy₂)).1 h'
    
    have hs3 : ∫ y in Q, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det =
        ∫ y in Q ∩ Ω, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hQm Set.inter_subset_left ?_
      rintro y ⟨hyQ, hyn⟩
      have hyt : ψ y ∉ (κ i).target := by
        intro ht
        exact hyn ⟨hyQ, (hΩmem y).2 ⟨hQψ hyQ, ht⟩⟩
      have hns : ψ y ∉ tsupport (χ i) := fun h => hyt (hχt i h)
      rw [image_eq_zero_of_notMem_tsupport hns, zero_mul, zero_mul]
    
    have hs4 : ∫ z in τ '' (Q ∩ Ω),
        χ i (κ i z) * g.gradInner u u (κ i z) * Real.sqrt (g.coeff (κ i) z).det =
        ∫ y in Q ∩ Ω, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      rw [integral_image_eq_integral_abs_det_fderiv_smul volume hEm
        (fun y hy => (hτd y (hEΩ hy)).hasFDerivAt.hasFDerivWithinAt) hτinj]
      refine setIntegral_congr_fun hEm (fun y hy => ?_)
      simp only [smul_eq_mul]
      rw [hκτ y (hEΩ hy), hjac y (hEΩ hy)]
      ring
    
    have h5 : ∫ z in τ '' (Q ∩ Ω),
        χ i (κ i z) * g.gradInner u u (κ i z) * Real.sqrt (g.coeff (κ i) z).det ≤
        ∫ z in (κ i).source,
          χ i (κ i z) * g.gradInner u u (κ i z) * Real.sqrt (g.coeff (κ i) z).det := by
      refine setIntegral_mono_set (hHint i)
        (ae_restrict_of_forall_mem (κ i).open_source.measurableSet fun z hz =>
          mul_nonneg (mul_nonneg (hχ0 i _) (hnn (κ i) u hu z hz)) (Real.sqrt_nonneg _)) ?_
      refine HasSubset.Subset.eventuallyLE ?_
      rintro _ ⟨y, hy, rfl⟩
      exact hτmem y (hEΩ hy)
    rw [hs3, ← hs4]
    exact h5
  
  have hloc : ∫ y in Q, g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
      atlasInt g κ χ (g.gradInner u u) := by
    unfold atlasInt
    calc ∫ y in Q, g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det
        = ∫ y in Q, ∑ i, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det := by
          congr 1
          funext y
          rw [← Finset.sum_mul, ← Finset.sum_mul, hχ1, one_mul]
      _ = ∑ i, ∫ y in Q, χ i (ψ y) * g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det :=
          integral_finset_sum Finset.univ fun i _ => hgL i
      _ ≤ ∑ i, ∫ z in (κ i).source,
            χ i (κ i z) * g.gradInner u u (κ i z) * Real.sqrt (g.coeff (κ i) z).det :=
          Finset.sum_le_sum fun i _ => key i
  
  have hI1 : IntegrableOn (fun y => ∑ i : Fin 3, (partialDeriv i (fun z => u (ψ z)) y) ^ 2) Q :=
    ((continuousOn_finset_sum _ fun i _ =>
      ((nds_chart_cont g ψ u u hu hu).2.1 i).pow 2).mono hQψ).integrableOn_compact hQc
  have hI2 : IntegrableOn (fun y => (m * Real.sqrt (g.coeff ψ y₀).det)⁻¹ *
      (g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det)) Q :=
    ((continuousOn_const.mul ((hGc ψ).mul (hDc ψ))).mono hQψ).integrableOn_compact hQc
  calc ∫ y in Q, ∑ i : Fin 3, (partialDeriv i (fun z => u (ψ z)) y) ^ 2
      ≤ ∫ y in Q, (m * Real.sqrt (g.coeff ψ y₀).det)⁻¹ *
          (g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det) :=
        setIntegral_mono_on hI1 hI2 hQm hpt
    _ = (m * Real.sqrt (g.coeff ψ y₀).det)⁻¹ *
          ∫ y in Q, g.gradInner u u (ψ y) * Real.sqrt (g.coeff ψ y).det :=
        integral_const_mul _ _
    _ ≤ (m * Real.sqrt (g.coeff ψ y₀).det)⁻¹ * atlasInt g κ χ (g.gradInner u u) :=
        mul_le_mul_of_nonneg_left hloc (inv_pos.2 hCpos).le

theorem cps_good_propagate [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ)
    (ψa ψb : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ca cb : E3) (sa sb : ℝ)
    (hsa : 0 < sa) (hsb : 0 < sb) (hBa : Metric.closedBall ca (2 * sa) ⊆ ψa.source)
    (hBb : Metric.closedBall cb (2 * sb) ⊆ ψb.source)
    (hov : (ψa '' {y : E3 | ∀ i : Fin 3, ca i - sa < y i ∧ y i < ca i + sa} ∩
      ψb '' {y : E3 | ∀ i : Fin 3, cb i - sb < y i ∧ y i < cb i + sb}).Nonempty)
    (hgood : ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      HasCompactSupport u →
      ∫ y in {y : E3 | ∀ i : Fin 3, ca i - sa ≤ y i ∧ y i ≤ ca i + sa}, (u (ψa y)) ^ 2 ≤
        C * atlasInt g κ χ (g.gradInner u u)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      ∫ y in {y : E3 | ∀ i : Fin 3, cb i - sb ≤ y i ∧ y i ≤ cb i + sb}, (u (ψb y)) ^ 2 ≤
        C * atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => by fun_prop
  let Qc : E3 → ℝ → Set E3 := fun c s => {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s}
  let Qo : E3 → ℝ → Set E3 := fun c s => {y : E3 | ∀ i : Fin 3, c i - s < y i ∧ y i < c i + s}
  have hF1 : ∀ (c : E3) (s : ℝ), 0 ≤ s → Qc c s ⊆ Metric.closedBall c (2 * s) := by
    intro c s hs y hy
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq]
    have h : ∀ i, dist (y i) (c i) ^ 2 ≤ s ^ 2 := by
      intro i
      have h1 := hy i
      rw [Real.dist_eq]
      have h2 : |y i - c i| ≤ s := abs_le.2 ⟨by linarith [h1.1], by linarith [h1.2]⟩
      have h3 : |y i - c i| ^ 2 ≤ s ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2 2
      exact h3
    have h4 : ∑ i : Fin 3, dist (y i) (c i) ^ 2 ≤ (2 * s) ^ 2 := by
      rw [Fin.sum_univ_three]
      nlinarith [h 0, h 1, h 2, sq_nonneg s]
    calc Real.sqrt (∑ i : Fin 3, dist (y i) (c i) ^ 2) ≤ Real.sqrt ((2 * s) ^ 2) :=
          Real.sqrt_le_sqrt h4
      _ = 2 * s := Real.sqrt_sq (by linarith)
  have hQo_open : ∀ (c : E3) (s : ℝ), IsOpen (Qo c s) := by
    intro c s
    have : Qo c s = ⋂ i : Fin 3, {y : E3 | c i - s < y i ∧ y i < c i + s} := by
      ext y; simp [Qo]
    rw [this]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (hcont i)).inter (isOpen_lt (hcont i) continuous_const)
  have hQc_closed : ∀ (c : E3) (s : ℝ), IsClosed (Qc c s) := by
    intro c s
    have : Qc c s = ⋂ i : Fin 3, {y : E3 | c i - s ≤ y i ∧ y i ≤ c i + s} := by
      ext y; simp [Qc]
    rw [this]
    exact isClosed_iInter fun i =>
      (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
  have hQc_cpt : ∀ (c : E3) (s : ℝ), 0 ≤ s → IsCompact (Qc c s) := fun c s hs =>
    (isCompact_closedBall c (2 * s)).of_isClosed_subset (hQc_closed c s) (hF1 c s hs)
  have hQoQc : ∀ (c : E3) (s : ℝ), Qo c s ⊆ Qc c s :=
    fun c s y hy i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hQaSrc : Qc ca sa ⊆ ψa.source := (hF1 ca sa hsa.le).trans hBa
  have hQbSrc : Qc cb sb ⊆ ψb.source := (hF1 cb sb hsb.le).trans hBb
  
  obtain ⟨p, ⟨za, hza, hpa⟩, ⟨y', hy', hpb⟩⟩ := hov
  have hGa : IsOpen (ψa '' Qo ca sa) :=
    ψa.toOpenPartialHomeomorph.isOpen_image_of_subset_source (hQo_open _ _)
      ((hQoQc _ _).trans hQaSrc)
  have hWb : IsOpen (Qo cb sb ∩ (ψb.source ∩ ψb ⁻¹' (ψa '' Qo ca sa))) :=
    (hQo_open _ _).inter
      (ψb.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψb.open_source hGa)
  have hy'W : y' ∈ Qo cb sb ∩ (ψb.source ∩ ψb ⁻¹' (ψa '' Qo ca sa)) :=
    ⟨hy', hQbSrc (hQoQc _ _ hy'), ⟨za, hza, hpa.trans hpb.symm⟩⟩
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hWb y' hy'W
  have ht : 0 < ε / 4 := by positivity
  have hE'W : Qc y' (ε / 4) ⊆ Qo cb sb ∩ (ψb.source ∩ ψb ⁻¹' (ψa '' Qo ca sa)) :=
    (hF1 y' (ε / 4) ht.le).trans ((Metric.closedBall_subset_ball (by linarith)).trans hball)
  have hE'Qb : Qc y' (ε / 4) ⊆ Qc cb sb := fun y hy => hQoQc _ _ (hE'W hy).1
  have hE'cpt : IsCompact (Qc y' (ε / 4)) := hQc_cpt _ _ ht.le
  have hE's : Qc y' (ε / 4) ⊆ ψb.source := fun y hy => (hE'W hy).2.1
  have hδ : ∀ y ∈ Qc y' (ε / 4), ψb y ∈ ψa.target ∧ ψa.symm (ψb y) ∈ Qc ca sa := by
    intro y hy
    obtain ⟨z, hz, hzy⟩ := (hE'W hy).2.2
    have hzs : z ∈ ψa.source := hQaSrc (hQoQc _ _ hz)
    have h1 : ψa.symm (ψa z) = z := ψa.toPartialEquiv.left_inv hzs
    have h2 : ψa z ∈ ψa.target := ψa.toPartialEquiv.map_source hzs
    rw [← hzy]
    exact ⟨h2, by rw [h1]; exact hQoQc _ _ hz⟩
  
  obtain ⟨CE, hCE, hCEb⟩ := cps_cube_energy g hAF ρA κ χ hA ψb cb sb hsb hBb
  obtain ⟨K, hK, hKb⟩ := cps_cross_chart_l2 g ψa ψb (Qc y' (ε / 4)) (Qc ca sa) hE'cpt hE's
    (fun y hy => (hδ y hy).1) (hQc_cpt _ _ hsa.le) hQaSrc (fun y hy => (hδ y hy).2)
  obtain ⟨Ca, hCa, hCab⟩ := hgood
  have hAbox : 0 ≤ (2 * sb / (ε / 4)) ^ 3 +
      8 * sb ^ 2 * (1 + 2 * sb / (ε / 4) + (2 * sb / (ε / 4)) ^ 2) := by positivity
  refine ⟨((2 * sb / (ε / 4)) ^ 3 +
      8 * sb ^ 2 * (1 + 2 * sb / (ε / 4) + (2 * sb / (ε / 4)) ^ 2)) * (K * Ca + CE),
    mul_nonneg hAbox (add_nonneg (mul_nonneg hK hCa) hCE), ?_⟩
  
  intro u hu hus
  have hU : ContDiffOn ℝ 1 (fun z => u (ψb z)) ψb.source :=
    (contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn ψb.contMDiffOn_toFun)).of_le
      (by exact_mod_cast le_top)
  have h1 := cps_box_propagation (fun z => u (ψb z)) cb y' sb (ε / 4) hsb ht ψb.source
    ψb.open_source hU hQbSrc hE'Qb
  have h2 := hKb u hu
  have h3 := hCab u hu hus
  have h4 := hCEb u hu hus
  have h5 : (∫ y in Qc y' (ε / 4), (u (ψb y)) ^ 2) +
      ∫ y in Qc cb sb, ∑ i : Fin 3, (partialDeriv i (fun z => u (ψb z)) y) ^ 2 ≤
        (K * Ca + CE) * atlasInt g κ χ (g.gradInner u u) := by
    calc (∫ y in Qc y' (ε / 4), (u (ψb y)) ^ 2) +
          ∫ y in Qc cb sb, ∑ i : Fin 3, (partialDeriv i (fun z => u (ψb z)) y) ^ 2
        ≤ K * (Ca * atlasInt g κ χ (g.gradInner u u)) +
            CE * atlasInt g κ χ (g.gradInner u u) :=
          add_le_add (h2.trans (mul_le_mul_of_nonneg_left h3 hK)) h4
      _ = (K * Ca + CE) * atlasInt g κ χ (g.gradInner u u) := by ring
  calc ∫ y in Qc cb sb, (u (ψb y)) ^ 2
      ≤ ((2 * sb / (ε / 4)) ^ 3 +
          8 * sb ^ 2 * (1 + 2 * sb / (ε / 4) + (2 * sb / (ε / 4)) ^ 2)) *
        ((∫ y in Qc y' (ε / 4), (u (ψb y)) ^ 2) +
          ∫ y in Qc cb sb, ∑ i : Fin 3, (partialDeriv i (fun z => u (ψb z)) y) ^ 2) := h1
    _ ≤ ((2 * sb / (ε / 4)) ^ 3 +
          8 * sb ^ 2 * (1 + 2 * sb / (ε / 4) + (2 * sb / (ε / 4)) ^ 2)) *
        ((K * Ca + CE) * atlasInt g κ χ (g.gradInner u u)) :=
          mul_le_mul_of_nonneg_left h5 hAbox
    _ = ((2 * sb / (ε / 4)) ^ 3 +
          8 * sb ^ 2 * (1 + 2 * sb / (ε / 4) + (2 * sb / (ε / 4)) ^ 2)) * (K * Ca + CE) *
        atlasInt g κ χ (g.gradInner u u) := by ring

theorem ceh_end_atlas_lower [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (j : Fin hAF.numEnds) (u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (hus : HasCompactSupport u) :
    (∀ y : E3, 1 < ‖y‖ → 0 ≤ g.gradInner u u ((hAF.ends j).Φ y)) ∧
    MeasureTheory.IntegrableOn (fun y : E3 => g.gradInner u u ((hAF.ends j).Φ y) *
      Real.sqrt (g.coeff (hAF.ends j).Φ y).det) {y : E3 | ρA + 1 < ‖y‖} ∧
    ∫ y in {y : E3 | ρA + 1 < ‖y‖}, g.gradInner u u ((hAF.ends j).Φ y) *
      Real.sqrt (g.coeff (hAF.ends j).Φ y).det ≤ atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  obtain ⟨hρA, hsm, hnn, hsum, hsupp, hcase⟩ := hA
  
  have hsign : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3), y ∈ ψ.source →
      0 ≤ g.gradInner u u (ψ y) := by
    intro ψ y hy
    rw [gradInner_pdiffeo_formula g ψ u u hu hu y hy]
    have hPD := (flat_coeff_regular g ψ).2.2.1 y hy
    have h0 := hPD.posSemidef.dotProduct_mulVec_nonneg
      (fun i => partialDeriv i (fun z => u (ψ z)) y)
    simp only [Pi.star_apply, star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three] at h0
    simp only [Fin.sum_univ_three]
    nlinarith [h0]
  
  have hfar : ∀ T : Set M, IsCompact T → ∃ R : ℝ, ∀ y : E3, R < ‖y‖ →
      (hAF.ends j).Φ y ∉ T := by
    intro T hT
    choose ρf N hN hNy using end_chart_escape g hAF j
    obtain ⟨t, -, hcov⟩ := hT.elim_nhds_subcover N (fun x _ => hN x)
    refine ⟨∑ x ∈ t, |ρf x|, fun y hy hyT => ?_⟩
    obtain ⟨x, hxt, hxN⟩ := Set.mem_iUnion₂.1 (hcov hyT)
    have hle : ρf x ≤ ∑ x ∈ t, |ρf x| :=
      (le_abs_self _).trans (Finset.single_le_sum (f := fun x => |ρf x|)
        (fun x _ => abs_nonneg (ρf x)) hxt)
    exact hNy x y (lt_of_le_of_lt hle hy) hxN
  have hsrcEq := (hAF.ends j).source_eq
  
  obtain ⟨i₀, hκ, hone, hzero⟩ : ∃ i₀ : Fin n, κ i₀ = (hAF.ends j).Φ ∧
      (∀ y : E3, ρA + 1 ≤ ‖y‖ → χ i₀ ((hAF.ends j).Φ y) = 1) ∧
      (∀ y : E3, 1 < ‖y‖ → ‖y‖ ≤ ρA → χ i₀ ((hAF.ends j).Φ y) = 0) := by
    by_contra hno
    have hTc : IsCompact (⋃ i ∈ Finset.univ.filter (fun i => IsCompact (tsupport (χ i))),
        tsupport (χ i)) :=
      (Finset.univ.filter (fun i => IsCompact (tsupport (χ i)))).isCompact_biUnion
        (fun i hi => (Finset.mem_filter.1 hi).2)
    obtain ⟨Rc, hRc⟩ := hfar _ hTc
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = max Rc 1 + 1 := ⟨_, rfl⟩
    have hrpos : 0 < r := by have := le_max_right Rc 1; linarith
    have hnorm : ‖(EuclideanSpace.single 0 r : E3)‖ = r := by
      rw [EuclideanSpace.norm_single, Real.norm_eq_abs, abs_of_pos hrpos]
    have hRcy : Rc < ‖(EuclideanSpace.single 0 r : E3)‖ := by
      rw [hnorm]; have := le_max_left Rc 1; linarith
    have h1y : 1 < ‖(EuclideanSpace.single 0 r : E3)‖ := by
      rw [hnorm]; have := le_max_right Rc 1; linarith
    have hpT := hRc _ hRcy
    have hsrc : (EuclideanSpace.single 0 r : E3) ∈ (hAF.ends j).Φ.source := by
      rw [hsrcEq]; exact h1y
    have hptgt : (hAF.ends j).Φ (EuclideanSpace.single 0 r : E3) ∈ (hAF.ends j).Φ.target :=
      (hAF.ends j).Φ.toPartialEquiv.map_source hsrc
    have hall : ∀ i, χ i ((hAF.ends j).Φ (EuclideanSpace.single 0 r : E3)) = 0 := by
      intro i
      rcases hcase i with hc | ⟨j', hκj', hA1, hA0⟩
      · apply image_eq_zero_of_notMem_tsupport
        intro hmem
        exact hpT (Set.mem_iUnion₂.2 ⟨i, Finset.mem_filter.2 ⟨Finset.mem_univ i, hc⟩, hmem⟩)
      · by_cases hjj : j' = j
        · subst hjj
          exact absurd ⟨i, hκj', hA1, hA0⟩ hno
        · by_contra hne
          have h1 := hsupp i (subset_tsupport _ (Function.mem_support.2 hne))
          rw [hκj'] at h1
          exact Set.disjoint_left.1 (hAF.disjoint hjj) h1 hptgt
    have hs1 := hsum ((hAF.ends j).Φ (EuclideanSpace.single 0 r : E3))
    rw [Finset.sum_eq_zero (fun i _ => hall i)] at hs1
    exact zero_ne_one hs1
  
  obtain ⟨Ru, hRu⟩ := hfar (tsupport u) hus
  have hsrcOpen : IsOpen (hAF.ends j).Φ.source := (hAF.ends j).Φ.open_source
  have hcont := nds_chart_cont g (hAF.ends j).Φ u u hu hu
  obtain ⟨H, hH⟩ : ∃ H : E3 → ℝ, H = fun y => χ i₀ ((hAF.ends j).Φ y) *
      g.gradInner u u ((hAF.ends j).Φ y) * Real.sqrt (g.coeff (hAF.ends j).Φ y).det :=
    ⟨_, rfl⟩
  
  have hHc : ContinuousOn H (hAF.ends j).Φ.source := by
    rw [hH]
    exact (((hsm i₀).continuous.comp_continuousOn
      (hAF.ends j).Φ.contMDiffOn_toFun.continuousOn).mul hcont.2.2.1).mul hcont.2.2.2.1
  have hFzero : ∀ y : E3, max Ru ρA < ‖y‖ → g.gradInner u u ((hAF.ends j).Φ y) = 0 := by
    intro y hy
    have hy1 : y ∈ (hAF.ends j).Φ.source := by
      rw [hsrcEq]; show 1 < ‖y‖; linarith [le_max_right Ru ρA]
    have hyRu : Ru < ‖y‖ := lt_of_le_of_lt (le_max_left _ _) hy
    have hev : (fun z => u ((hAF.ends j).Φ z)) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) := by
      filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds hyRu] with z hz
      exact image_eq_zero_of_notMem_tsupport (hRu z hz)
    have hpd : ∀ i : Fin 3, partialDeriv i (fun z => u ((hAF.ends j).Φ z)) y = 0 := by
      intro i
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    rw [gradInner_pdiffeo_formula g (hAF.ends j).Φ u u hu hu y hy1]
    simp [hpd]
  have hint : MeasureTheory.IntegrableOn H (hAF.ends j).Φ.source := by
    have hZc : IsCompact (Metric.closedBall (0 : E3) (max Ru ρA) ∩ {y : E3 | ρA ≤ ‖y‖}) :=
      (isCompact_closedBall 0 _).inter_right (isClosed_le continuous_const continuous_norm)
    have hZs : Metric.closedBall (0 : E3) (max Ru ρA) ∩ {y : E3 | ρA ≤ ‖y‖} ⊆
        (hAF.ends j).Φ.source := by
      intro y hy
      rw [hsrcEq]
      show 1 < ‖y‖
      have : ρA ≤ ‖y‖ := hy.2
      linarith
    refine MeasureTheory.IntegrableOn.of_forall_diff_eq_zero
      ((hHc.mono hZs).integrableOn_compact hZc) hsrcOpen.measurableSet ?_
    intro y hy
    obtain ⟨hys, hyZ⟩ := hy
    have hy1 : 1 < ‖y‖ := by rw [hsrcEq] at hys; exact hys
    rw [hH]
    by_cases hle : ‖y‖ ≤ ρA
    · simp only [hzero y hy1 hle, zero_mul]
    · have hgt : max Ru ρA < ‖y‖ := by
        by_contra hcon
        push_neg at hcon hle
        exact hyZ ⟨mem_closedBall_zero_iff.2 hcon, hle.le⟩
      simp only [hFzero y hgt, mul_zero, zero_mul]
  
  have hS₁m : MeasurableSet {y : E3 | ρA + 1 < ‖y‖} :=
    measurableSet_lt measurable_const measurable_norm
  have hS₁ : {y : E3 | ρA + 1 < ‖y‖} ⊆ (hAF.ends j).Φ.source := by
    intro y hy
    rw [hsrcEq]
    show 1 < ‖y‖
    have : ρA + 1 < ‖y‖ := hy
    linarith
  have hEq : Set.EqOn H (fun y : E3 => g.gradInner u u ((hAF.ends j).Φ y) *
      Real.sqrt (g.coeff (hAF.ends j).Φ y).det) {y : E3 | ρA + 1 < ‖y‖} := by
    intro y hy
    have h1 : ρA + 1 < ‖y‖ := hy
    rw [hH]
    simp only [hone y h1.le, one_mul]
  have hH0 : ∀ y ∈ (hAF.ends j).Φ.source, 0 ≤ H y := by
    intro y hy
    rw [hH]
    exact mul_nonneg (mul_nonneg (hnn i₀ _) (hsign _ y hy)) (Real.sqrt_nonneg _)
  refine ⟨fun y hy => hsign (hAF.ends j).Φ y (by rw [hsrcEq]; exact hy),
    (hint.mono_set hS₁).congr_fun hEq hS₁m, ?_⟩
  
  have h6 : ∫ y in (κ i₀).source, χ i₀ (κ i₀ y) * g.gradInner u u (κ i₀ y) *
      Real.sqrt (g.coeff (κ i₀) y).det ≤ atlasInt g κ χ (g.gradInner u u) := by
    unfold atlasInt
    refine Finset.single_le_sum (f := fun i => ∫ y in (κ i).source,
      χ i (κ i y) * g.gradInner u u (κ i y) * Real.sqrt (g.coeff (κ i) y).det)
      (fun i _ => ?_) (Finset.mem_univ i₀)
    exact MeasureTheory.setIntegral_nonneg (κ i).open_source.measurableSet
      (fun y hy => mul_nonneg (mul_nonneg (hnn i _) (hsign (κ i) y hy)) (Real.sqrt_nonneg _))
  rw [hκ] at h6
  calc ∫ y in {y : E3 | ρA + 1 < ‖y‖}, g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det
      = ∫ y in {y : E3 | ρA + 1 < ‖y‖}, H y :=
        (MeasureTheory.setIntegral_congr_fun hS₁m hEq).symm
    _ ≤ ∫ y in (hAF.ends j).Φ.source, H y :=
        MeasureTheory.setIntegral_mono_set hint
          (MeasureTheory.ae_restrict_of_forall_mem hsrcOpen.measurableSet hH0)
          hS₁.eventuallyLE
    _ = ∫ y in (hAF.ends j).Φ.source, χ i₀ ((hAF.ends j).Φ y) *
          g.gradInner u u ((hAF.ends j).Φ y) * Real.sqrt (g.coeff (hAF.ends j).Φ y).det := by
        rw [hH]
    _ ≤ atlasInt g κ χ (g.gradInner u u) := h6

theorem ceh_euclid_hardy (ρ R : ℝ) (hρ : 0 < ρ) (U : E3 → ℝ)
    (hU : ContDiffOn ℝ 1 U {y : E3 | ρ < ‖y‖}) (hUR : ∀ y : E3, R ≤ ‖y‖ → U y = 0) (R₀ : ℝ) :
    ∫ y in {y : E3 | 2 * ρ < ‖y‖ ∧ ‖y‖ < R₀}, U y ^ 2 / ‖y‖ ^ 2 ≤
      4 * ∫ y in {y : E3 | 3 * ρ / 2 < ‖y‖}, ∑ k : Fin 3, (partialDeriv k U y) ^ 2 :=
by
  classical
  have ha0 : 0 < 3 * ρ / 2 := by linarith
  have hρa : ρ < 3 * ρ / 2 := by linarith
  have hab : 3 * ρ / 2 < 2 * ρ := by linarith
  
  have hsum_coord : ∀ (L : E3 →L[ℝ] ℝ) (y : E3), L y = ∑ k : Fin 3, L (e k) * y k := by
    intro L y
    have hy : y = ∑ k : Fin 3, y k • e k := by
      ext j
      fin_cases j <;> simp [Fin.sum_univ_three, EuclideanSpace.single_apply]
    conv_lhs => rw [hy]
    simp only [map_sum, map_smul, smul_eq_mul]
    exact Finset.sum_congr rfl (fun k _ => mul_comm _ _)
  have hnorm_sq : ∀ y : E3, ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  
  obtain ⟨η, hηC, hη01, hη0, hη1, hηrad⟩ : ∃ η : E3 → ℝ, ContDiff ℝ 1 η ∧
      (∀ y : E3, 0 ≤ η y ∧ η y ≤ 1) ∧
      (∀ y : E3, ‖y‖ ≤ 3 * ρ / 2 → η y = 0) ∧ (∀ y : E3, 2 * ρ ≤ ‖y‖ → η y = 1) ∧
      (∀ y : E3, 0 ≤ fderiv ℝ η y y) := by
    obtain ⟨c, hc_def⟩ : ∃ c : ℝ, c = (2 * ρ) ^ 2 - (3 * ρ / 2) ^ 2 := ⟨_, rfl⟩
    have hc : 0 < c := by rw [hc_def]; nlinarith
    have hsC : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff
    have hgC : ContDiff ℝ 1 (fun y : E3 => (‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹) :=
      ((contDiff_norm_sq ℝ).sub contDiff_const).mul contDiff_const
    refine ⟨fun y => Real.smoothTransition ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹), hsC.comp hgC,
      fun y => ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩, ?_, ?_, ?_⟩
    · intro y hy
      apply Real.smoothTransition.zero_of_nonpos
      have h1 : ‖y‖ ^ 2 ≤ (3 * ρ / 2) ^ 2 := pow_le_pow_left₀ (norm_nonneg y) hy 2
      exact mul_nonpos_of_nonpos_of_nonneg (by linarith) (inv_nonneg.2 hc.le)
    · intro y hy
      apply Real.smoothTransition.one_of_one_le
      have h1 : (2 * ρ) ^ 2 ≤ ‖y‖ ^ 2 := pow_le_pow_left₀ (by linarith) hy 2
      rw [← div_eq_mul_inv, le_div_iff₀ hc]
      linarith
    · intro y
      have hN : HasFDerivAt (fun z : E3 => ‖z‖ ^ 2) (2 • innerSL ℝ y) y :=
        (hasStrictFDerivAt_norm_sq y).hasFDerivAt
      have hg : HasFDerivAt (fun z : E3 => (‖z‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹)
          (c⁻¹ • (2 • innerSL ℝ y)) y := (hN.sub_const ((3 * ρ / 2) ^ 2)).mul_const c⁻¹
      have hs : HasDerivAt Real.smoothTransition
          (deriv Real.smoothTransition ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹))
          ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹) :=
        ((hsC.differentiable one_ne_zero) _).hasDerivAt
      have hcomp : HasFDerivAt (fun y => Real.smoothTransition ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹))
          (deriv Real.smoothTransition ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹) •
            (c⁻¹ • (2 • innerSL ℝ y))) y := by
        have h := HasDerivAt.comp_hasFDerivAt (h₂ := Real.smoothTransition) y hs hg
        exact h
      rw [hcomp.fderiv]
      have hd : 0 ≤ deriv Real.smoothTransition ((‖y‖ ^ 2 - (3 * ρ / 2) ^ 2) * c⁻¹) :=
        Real.smoothTransition.monotone.deriv_nonneg
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul, nsmul_eq_mul, innerSL_apply_apply,
        real_inner_self_eq_norm_sq]
      have hc' : 0 ≤ c⁻¹ := inv_nonneg.2 hc.le
      positivity
  
  have hΩo : IsOpen {y : E3 | ρ < ‖y‖} := isOpen_lt continuous_const continuous_norm
  have hBo : IsOpen {y : E3 | ‖y‖ < 3 * ρ / 2} := isOpen_lt continuous_norm continuous_const
  have hglueC : ∀ f : E3 → ℝ, ContDiffOn ℝ 1 f {y : E3 | ρ < ‖y‖} →
      (∀ y : E3, ‖y‖ < 3 * ρ / 2 → f y = 0) → ContDiff ℝ 1 f := by
    intro f hf h0
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : ρ < ‖y‖
    · exact hf.contDiffAt (hΩo.mem_nhds hy)
    · have hy' : ‖y‖ < 3 * ρ / 2 := by push_neg at hy; linarith
      refine (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [hBo.mem_nhds hy'] with z hz
      exact h0 z hz
  have hglue0 : ∀ f : E3 → ℝ, ContinuousOn f {y : E3 | ρ < ‖y‖} →
      (∀ y : E3, ‖y‖ < 3 * ρ / 2 → f y = 0) → Continuous f := by
    intro f hf h0
    rw [continuous_iff_continuousAt]
    intro y
    by_cases hy : ρ < ‖y‖
    · exact hf.continuousAt (hΩo.mem_nhds hy)
    · have hy' : ‖y‖ < 3 * ρ / 2 := by push_neg at hy; linarith
      refine (continuousAt_const (y := (0 : ℝ))).congr ?_
      filter_upwards [hBo.mem_nhds hy'] with z hz
      exact (h0 z hz).symm
  have hcs : ∀ f : E3 → ℝ, (∀ y : E3, R < ‖y‖ → f y = 0) → HasCompactSupport f := by
    intro f hf
    refine HasCompactSupport.intro (isCompact_closedBall (0 : E3) R) ?_
    intro x hx
    apply hf
    rw [mem_closedBall_zero_iff, not_le] at hx
    exact hx
  
  have hUd : ∀ y : E3, ρ < ‖y‖ → HasFDerivAt U (fderiv ℝ U y) y := fun y hy =>
    (((hU.differentiableOn one_ne_zero) y hy).differentiableAt (hΩo.mem_nhds hy)).hasFDerivAt
  have hUfar : ∀ y : E3, R < ‖y‖ → fderiv ℝ U y = 0 := by
    intro y hy
    have h : U =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds hy] with z hz
      exact hUR z (le_of_lt (show R < ‖z‖ from hz))
    rw [h.fderiv_eq]
    simp
  have hpdU : ∀ k : Fin 3, ContinuousOn (fun y => partialDeriv k U y) {y : E3 | ρ < ‖y‖} :=
    fun k => (hU.continuousOn_fderiv_of_isOpen hΩo le_rfl).clm_apply continuousOn_const
  have hcoordC : ∀ k : Fin 3, ContDiff ℝ 1 (fun z : E3 => z k) := by
    intro k
    fun_prop
  
  obtain ⟨F, hF⟩ : ∃ F : Fin 3 → E3 → ℝ,
      F = fun k z => η z * U z ^ 2 * (z k / ‖z‖ ^ 2) := ⟨_, rfl⟩
  have hFC : ∀ k, ContDiff ℝ 1 (F k) := by
    intro k
    rw [hF]
    apply hglueC
    · exact (hηC.contDiffOn.mul (hU.pow 2)).mul ((hcoordC k).contDiffOn.div
        (contDiff_norm_sq ℝ).contDiffOn
        (fun z hz => pow_ne_zero 2 (lt_trans hρ (show ρ < ‖z‖ from hz)).ne'))
    · intro y hy
      simp [hη0 y hy.le]
  have hFcs : ∀ k, HasCompactSupport (F k) := by
    intro k
    apply hcs
    intro y hy
    rw [hF]
    simp [hUR y hy.le]
  have hDint : ∀ k, Integrable (fun y => partialDeriv k (F k) y) := fun k =>
    (((hFC k).continuous_fderiv one_ne_zero).clm_apply continuous_const).integrable_of_hasCompactSupport
      ((hFcs k).fderiv_apply ℝ (e k))
  have hD0 : ∀ k, ∫ y, partialDeriv k (F k) y = 0 := by
    intro k
    have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := (volume : Measure E3))
      (f := fun _ : E3 => (1 : ℝ)) (g := F k) (v := e k) (by simp)
      (by simpa [partialDeriv] using hDint k)
      (by simpa using (hFC k).continuous.integrable_of_hasCompactSupport (hFcs k))
      (differentiable_const _) ((hFC k).differentiable one_ne_zero)
    simpa [partialDeriv] using h
  have hDI : Integrable (fun y => ∑ k : Fin 3, partialDeriv k (F k) y) :=
    integrable_finset_sum _ (fun k _ => hDint k)
  have hDZ : ∫ y, ∑ k : Fin 3, partialDeriv k (F k) y = 0 := by
    rw [integral_finset_sum _ (fun k _ => hDint k)]
    simp [hD0]
  
  have hpk : ∀ y : E3, 3 * ρ / 2 ≤ ‖y‖ → ∀ k : Fin 3, partialDeriv k (F k) y =
      η y * U y ^ 2 * ((‖y‖ ^ 2)⁻¹ - 2 * y k ^ 2 * ((‖y‖ ^ 2)⁻¹) ^ 2) +
        y k * (‖y‖ ^ 2)⁻¹ * (2 * η y * U y * partialDeriv k U y + U y ^ 2 * partialDeriv k η y) := by
    intro y hy k
    have hyρ : ρ < ‖y‖ := lt_of_lt_of_le hρa hy
    have hn0 : ‖y‖ ^ 2 ≠ 0 := pow_ne_zero 2 (lt_trans hρ hyρ).ne'
    have hη' : HasFDerivAt η (fderiv ℝ η y) y := ((hηC.differentiable one_ne_zero) y).hasFDerivAt
    have hU' := hUd y hyρ
    have hN : HasFDerivAt (fun z : E3 => ‖z‖ ^ 2) (2 • innerSL ℝ y) y :=
      (hasStrictFDerivAt_norm_sq y).hasFDerivAt
    have hinv : HasFDerivAt (fun z : E3 => (‖z‖ ^ 2)⁻¹)
        ((-((‖y‖ ^ 2) ^ 2)⁻¹) • (2 • innerSL ℝ y)) y := (hasDerivAt_inv hn0).comp_hasFDerivAt y hN
    have hc : HasFDerivAt (fun z : E3 => z k) (PiLp.proj 2 (fun _ : Fin 3 => ℝ) k) y :=
      PiLp.hasFDerivAt_apply (𝕜 := ℝ) (E := fun _ : Fin 3 => ℝ) 2 y k
    have hall := (hη'.mul (hU'.pow 2)).mul (hc.mul hinv)
    have hall' : HasFDerivAt (fun z => η z * U z ^ 2 * (z k * (‖z‖ ^ 2)⁻¹)) _ y := hall
    have hFk : F k = fun z => η z * U z ^ 2 * (z k * (‖z‖ ^ 2)⁻¹) := by
      rw [hF]
      funext z
      simp only [div_eq_mul_inv]
    simp only [partialDeriv]
    rw [hFk, hall'.fderiv]
    simp [EuclideanSpace.single_apply]
    rw [EuclideanSpace.inner_single_right]
    simp only [one_mul, conj_trivial]
    ring
  have hpt : ∀ y : E3, η y * U y ^ 2 / ‖y‖ ^ 2 / 2 -
      2 * (η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2) ≤ ∑ k : Fin 3, partialDeriv k (F k) y := by
    intro y
    by_cases hy : 3 * ρ / 2 ≤ ‖y‖
    · rw [Fin.sum_univ_three, Fin.sum_univ_three, hpk y hy 0, hpk y hy 1, hpk y hy 2,
        div_eq_mul_inv (η y * U y ^ 2) (‖y‖ ^ 2)]
      have hn : ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 := hnorm_sq y
      have hnpos : 0 < ‖y‖ ^ 2 := by
        have : 0 < ‖y‖ := by linarith
        positivity
      have hdη : 0 ≤ partialDeriv 0 η y * y 0 + partialDeriv 1 η y * y 1 +
          partialDeriv 2 η y * y 2 := by
        have h := hηrad y
        rw [hsum_coord (fderiv ℝ η y) y, Fin.sum_univ_three] at h
        exact h
      have hnt : (y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2) * (‖y‖ ^ 2)⁻¹ = 1 := by
        rw [← hn]; exact mul_inv_cancel₀ hnpos.ne'
      have ht0 : 0 ≤ (‖y‖ ^ 2)⁻¹ := inv_nonneg.2 hnpos.le
      have hw := (hη01 y).1
      generalize (‖y‖ ^ 2)⁻¹ = t at hnt ht0 ⊢
      generalize partialDeriv 0 η y = q0 at hdη ⊢
      generalize partialDeriv 1 η y = q1 at hdη ⊢
      generalize partialDeriv 2 η y = q2 at hdη ⊢
      generalize partialDeriv 0 U y = p0
      generalize partialDeriv 1 U y = p1
      generalize partialDeriv 2 U y = p2
      generalize η y = w at hw ⊢
      generalize U y = u
      generalize y 0 = y0 at hnt hdη ⊢
      generalize y 1 = y1 at hnt hdη ⊢
      generalize y 2 = y2 at hnt hdη ⊢
      have key : (w * u ^ 2 * (t - 2 * y0 ^ 2 * t ^ 2) + y0 * t * (2 * w * u * p0 + u ^ 2 * q0) +
          (w * u ^ 2 * (t - 2 * y1 ^ 2 * t ^ 2) + y1 * t * (2 * w * u * p1 + u ^ 2 * q1)) +
          (w * u ^ 2 * (t - 2 * y2 ^ 2 * t ^ 2) + y2 * t * (2 * w * u * p2 + u ^ 2 * q2))) -
          (w * u ^ 2 * t / 2 - 2 * (w * (p0 ^ 2 + p1 ^ 2 + p2 ^ 2))) =
          u ^ 2 * t * (q0 * y0 + q1 * y1 + q2 * y2) +
            w / 2 * ((2 * p0 + u * y0 * t) ^ 2 + (2 * p1 + u * y1 * t) ^ 2 +
              (2 * p2 + u * y2 * t) ^ 2) := by
        linear_combination (-(5 / 2) * w * u ^ 2 * t) * hnt
      have h1 : 0 ≤ u ^ 2 * t * (q0 * y0 + q1 * y1 + q2 * y2) :=
        mul_nonneg (mul_nonneg (sq_nonneg u) ht0) hdη
      have h2 : 0 ≤ w / 2 * ((2 * p0 + u * y0 * t) ^ 2 + (2 * p1 + u * y1 * t) ^ 2 +
              (2 * p2 + u * y2 * t) ^ 2) := by positivity
      linarith
    · push_neg at hy
      have hF0 : ∀ k, partialDeriv k (F k) y = 0 := by
        intro k
        have h : F k =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [hBo.mem_nhds hy] with z hz
          rw [hF]
          simp [hη0 z (show ‖z‖ < 3 * ρ / 2 from hz).le]
        rw [partialDeriv, h.fderiv_eq]
        simp
      simp [hF0, hη0 y hy.le]
  
  have hAc : Continuous (fun y : E3 => η y * U y ^ 2 / ‖y‖ ^ 2) := by
    apply hglue0
    · exact (hηC.continuous.continuousOn.mul (hU.continuousOn.pow 2)).div
        (continuous_norm.pow 2).continuousOn
        (fun z hz => pow_ne_zero 2 (lt_trans hρ (show ρ < ‖z‖ from hz)).ne')
    · intro y hy
      simp [hη0 y hy.le]
  have hAI : Integrable (fun y : E3 => η y * U y ^ 2 / ‖y‖ ^ 2) :=
    hAc.integrable_of_hasCompactSupport (hcs _ (fun y hy => by simp [hUR y hy.le]))
  have hPc : ContinuousOn (fun y => ∑ k : Fin 3, (partialDeriv k U y) ^ 2) {y : E3 | ρ < ‖y‖} :=
    continuousOn_finset_sum _ (fun k _ => (hpdU k).pow 2)
  have hP0 : ∀ y : E3, R < ‖y‖ → ∑ k : Fin 3, (partialDeriv k U y) ^ 2 = 0 := by
    intro y hy
    simp [partialDeriv, hUfar y hy]
  have hQc : Continuous (fun y => η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2) :=
    hglue0 _ (hηC.continuous.continuousOn.mul hPc) (fun y hy => by rw [hη0 y hy.le, zero_mul])
  have hQI : Integrable (fun y => η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2) :=
    hQc.integrable_of_hasCompactSupport (hcs _ (fun y hy => by rw [hP0 y hy, mul_zero]))
  have hPI : IntegrableOn (fun y => ∑ k : Fin 3, (partialDeriv k U y) ^ 2)
      {y : E3 | 3 * ρ / 2 < ‖y‖} := by
    have hK : IsCompact ({y : E3 | 3 * ρ / 2 ≤ ‖y‖} ∩ closedBall 0 (max R (3 * ρ / 2))) :=
      (isCompact_closedBall _ _).inter_left (isClosed_le continuous_const continuous_norm)
    have hKs : {y : E3 | 3 * ρ / 2 ≤ ‖y‖} ∩ closedBall 0 (max R (3 * ρ / 2)) ⊆
        {y : E3 | ρ < ‖y‖} := fun z hz => lt_of_lt_of_le hρa hz.1
    refine ((hPc.mono hKs).integrableOn_compact hK).of_forall_diff_eq_zero
      (measurableSet_lt measurable_const measurable_norm) ?_
    intro x hx
    apply hP0
    have h1 : x ∉ closedBall (0 : E3) (max R (3 * ρ / 2)) := fun h =>
      hx.2 ⟨le_of_lt (show 3 * ρ / 2 < ‖x‖ from hx.1), h⟩
    rw [mem_closedBall_zero_iff, not_le] at h1
    exact lt_of_le_of_lt (le_max_left _ _) h1
  
  have hS₁ : MeasurableSet {y : E3 | 2 * ρ < ‖y‖ ∧ ‖y‖ < R₀} :=
    (measurableSet_lt measurable_const measurable_norm).inter
      (measurableSet_lt measurable_norm measurable_const)
  have hstep1 : ∫ y in {y : E3 | 2 * ρ < ‖y‖ ∧ ‖y‖ < R₀}, U y ^ 2 / ‖y‖ ^ 2 =
      ∫ y in {y : E3 | 2 * ρ < ‖y‖ ∧ ‖y‖ < R₀}, η y * U y ^ 2 / ‖y‖ ^ 2 := by
    refine setIntegral_congr_fun hS₁ (fun y hy => ?_)
    simp only [hη1 y hy.1.le, one_mul]
  have hstep2 : ∫ y in {y : E3 | 2 * ρ < ‖y‖ ∧ ‖y‖ < R₀}, η y * U y ^ 2 / ‖y‖ ^ 2 ≤
      ∫ y, η y * U y ^ 2 / ‖y‖ ^ 2 :=
    setIntegral_le_integral hAI (Eventually.of_forall (fun y =>
      div_nonneg (mul_nonneg (hη01 y).1 (sq_nonneg _)) (sq_nonneg _)))
  have hIntL : Integrable (fun y => η y * U y ^ 2 / ‖y‖ ^ 2 / 2 -
      2 * (η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2)) :=
    (hAI.div_const 2).sub (hQI.const_mul 2)
  have hmono : ∫ y, (η y * U y ^ 2 / ‖y‖ ^ 2 / 2 -
      2 * (η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2)) ≤
      ∫ y, ∑ k : Fin 3, partialDeriv k (F k) y := integral_mono hIntL hDI (fun y => hpt y)
  rw [hDZ, integral_sub (hAI.div_const 2) (hQI.const_mul 2), integral_div,
    integral_const_mul] at hmono
  have hstep4 : ∫ y, η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2 =
      ∫ y in {y : E3 | 3 * ρ / 2 < ‖y‖}, η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2 := by
    refine (setIntegral_eq_integral_of_forall_compl_eq_zero (fun y hy => ?_)).symm
    simp only [Set.mem_setOf_eq, not_lt] at hy
    rw [hη0 y hy, zero_mul]
  have hstep5 : ∫ y in {y : E3 | 3 * ρ / 2 < ‖y‖}, η y * ∑ k : Fin 3, (partialDeriv k U y) ^ 2 ≤
      ∫ y in {y : E3 | 3 * ρ / 2 < ‖y‖}, ∑ k : Fin 3, (partialDeriv k U y) ^ 2 :=
    setIntegral_mono_on hQI.integrableOn hPI (measurableSet_lt measurable_const measurable_norm)
      (fun y _ => mul_le_of_le_one_left (Finset.sum_nonneg (fun k _ => sq_nonneg _)) (hη01 y).2)
  rw [hstep1]
  linarith

theorem cls_end_hardy [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (j : Fin hAF.numEnds) :
    ∃ ρ C : ℝ, 1 < ρ ∧ 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      HasCompactSupport u → ∀ R : ℝ,
        ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < R}, (u ((hAF.ends j).Φ y)) ^ 2 / ‖y‖ ^ 2 ≤
          C * atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  
  have hq : 0 < hAF.q := by linarith [hAF.q_gt]
  have hsmooth : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun x => g.coeff (hAF.ends j).Φ x a b) {x : E3 | 1 < ‖x‖} := by
    intro a b
    rw [← (hAF.ends j).source_eq]
    exact coeff_contDiffOn_source g (hAF.ends j).Φ a b
  obtain ⟨R₁, C₁, hR₁, hC₁, hb⟩ :=
    metric_coeff_bounds (g.coeff (hAF.ends j).Φ) hAF.q hq hsmooth (hAF.decay j)
  have hρA2 : 2 ≤ ρA := hA.1
  obtain ⟨ρ', hρ'def⟩ : ∃ r : ℝ, r = max (max R₁ (ρA + 1)) ((3 * C₁ + 1) ^ hAF.q⁻¹) :=
    ⟨_, rfl⟩
  have hρ'1 : ρA + 1 ≤ ρ' := by
    rw [hρ'def]; exact (le_max_right _ _).trans (le_max_left _ _)
  have hρ'R : R₁ ≤ ρ' := by
    rw [hρ'def]; exact (le_max_left _ _).trans (le_max_left _ _)
  have hρ'q : (3 * C₁ + 1) ^ hAF.q⁻¹ ≤ ρ' := by
    rw [hρ'def]; exact le_max_right _ _
  have hρ'pos : 0 < ρ' := by linarith
  have hsmall : ∀ y : E3, ρ' ≤ ‖y‖ → C₁ * ‖y‖ ^ (-hAF.q) ≤ 1 / 3 := by
    intro y hy
    have hy0 : 0 < ‖y‖ := by linarith
    have h1 : 3 * C₁ + 1 ≤ ‖y‖ ^ hAF.q := by
      have h2 : ((3 * C₁ + 1) ^ hAF.q⁻¹) ^ hAF.q = 3 * C₁ + 1 :=
        Real.rpow_inv_rpow (by linarith) hq.ne'
      rw [← h2]
      exact Real.rpow_le_rpow (Real.rpow_nonneg (by linarith) _) (hρ'q.trans hy) hq.le
    have hpos : 0 < ‖y‖ ^ hAF.q := Real.rpow_pos_of_pos hy0 _
    rw [Real.rpow_neg hy0.le, ← div_eq_mul_inv, div_le_iff₀ hpos]
    linarith
  
  have hquad : ∀ G : Matrix (Fin 3) (Fin 3) ℝ, G.det ≠ 0 →
      (∀ a b : Fin 3, |G a b - (if a = b then (1 : ℝ) else 0)| ≤ 1 / 3) →
      ∀ v : Fin 3 → ℝ,
        ∑ a : Fin 3, v a ^ 2 ≤ 2 * ∑ a : Fin 3, ∑ b : Fin 3, G⁻¹ a b * v a * v b := by
    intro G hdet hG v
    obtain ⟨w, hw⟩ : ∃ w : Fin 3 → ℝ, w = Matrix.mulVec G⁻¹ v := ⟨_, rfl⟩
    have hGw : Matrix.mulVec G w = v := by
      rw [hw, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv G (isUnit_iff_ne_zero.mpr hdet),
        Matrix.one_mulVec]
    obtain ⟨z, hz⟩ : ∃ z : Fin 3 → ℝ,
        ∀ a, z a = ∑ b : Fin 3, (G a b - if a = b then (1 : ℝ) else 0) * w b :=
      ⟨fun a => ∑ b : Fin 3, (G a b - if a = b then (1 : ℝ) else 0) * w b, fun a => rfl⟩
    have hv : ∀ a, v a = w a + z a := by
      intro a
      have h := congrFun hGw a
      rw [← h, hz a]
      simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      fin_cases a <;> simp <;> ring
    have hzb : ∀ a, z a ^ 2 ≤ (1 / 3) * ∑ b : Fin 3, w b ^ 2 := by
      intro a
      rw [hz a]
      refine (Finset.sum_mul_sq_le_sq_mul_sq _ _ _).trans ?_
      have hE1 : ∀ b, (G a b - if a = b then (1 : ℝ) else 0) ^ 2 ≤ 1 / 9 := by
        intro b
        have h' := abs_le.1 (hG a b)
        nlinarith [h'.1, h'.2]
      have hE : ∑ b : Fin 3, (G a b - if a = b then (1 : ℝ) else 0) ^ 2 ≤ 1 / 3 := by
        rw [Fin.sum_univ_three]
        linarith [hE1 0, hE1 1, hE1 2]
      exact mul_le_mul_of_nonneg_right hE (Finset.sum_nonneg fun b _ => sq_nonneg _)
    have hQ : ∑ a : Fin 3, ∑ b : Fin 3, G⁻¹ a b * v a * v b = ∑ a : Fin 3, v a * w a := by
      rw [hw]
      simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      ring
    rw [hQ]
    have h0 := hzb 0
    have h1 := hzb 1
    have h2 := hzb 2
    rw [Fin.sum_univ_three] at h0 h1 h2
    rw [Fin.sum_univ_three, Fin.sum_univ_three, hv 0, hv 1, hv 2]
    nlinarith [h0, h1, h2]
  
  have hpt : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ y : E3, ρ' < ‖y‖ →
      ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 ≤
        4 * (g.gradInner u u ((hAF.ends j).Φ y) *
          Real.sqrt (g.coeff (hAF.ends j).Φ y).det) := by
    intro u hu y hy
    have hyR : R₁ < ‖y‖ := lt_of_le_of_lt hρ'R hy
    have hdet : (1 / 2 : ℝ) ≤ (g.coeff (hAF.ends j).Φ y).det := (hb y hyR).1
    have hys : y ∈ (hAF.ends j).Φ.source := by
      rw [(hAF.ends j).source_eq]
      show 1 < ‖y‖
      linarith
    have hG : ∀ a b : Fin 3,
        |g.coeff (hAF.ends j).Φ y a b - (if a = b then (1 : ℝ) else 0)| ≤ 1 / 3 :=
      fun a b => (((hb y hyR).2 a b 0).1).trans (hsmall y hy.le)
    have hdet0 : (g.coeff (hAF.ends j).Φ y).det ≠ 0 := by
      intro h0; rw [h0] at hdet; linarith
    have h1 : ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 ≤
        2 * ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (hAF.ends j).Φ y)⁻¹ a b *
          partialDeriv a (fun z => u ((hAF.ends j).Φ z)) y *
          partialDeriv b (fun z => u ((hAF.ends j).Φ z)) y :=
      hquad _ hdet0 hG _
    have hS0 : 0 ≤ ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 :=
      Finset.sum_nonneg fun k _ => sq_nonneg _
    rw [gradInner_pdiffeo_formula g (hAF.ends j).Φ u u hu hu y hys]
    have hq4 : (1 / 2 : ℝ) ^ 2 = 1 / 4 := by norm_num
    have hsq : (1 / 2 : ℝ) ≤ Real.sqrt (g.coeff (hAF.ends j).Φ y).det := by
      rw [Real.le_sqrt' (by norm_num)]
      linarith
    generalize ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 = S
      at h1 hS0 ⊢
    generalize ∑ a : Fin 3, ∑ b : Fin 3, (g.coeff (hAF.ends j).Φ y)⁻¹ a b *
          partialDeriv a (fun z => u ((hAF.ends j).Φ z)) y *
          partialDeriv b (fun z => u ((hAF.ends j).Φ z)) y = Q at h1 ⊢
    generalize Real.sqrt (g.coeff (hAF.ends j).Φ y).det = s at hsq ⊢
    nlinarith [mul_nonneg (sub_nonneg.2 hsq) (show 0 ≤ Q by linarith)]
  
  refine ⟨2 * ρ', 16, by linarith, by norm_num, ?_⟩
  intro u hu hus R
  obtain ⟨hP1, hP2, hP3⟩ := ceh_end_atlas_lower g hAF ρA κ χ hA j u hu hus
  
  obtain ⟨Ru, hRu⟩ : ∃ Ru : ℝ, ∀ y : E3, Ru < ‖y‖ → (hAF.ends j).Φ y ∉ tsupport u := by
    choose ρf N hN hNy using end_chart_escape g hAF j
    obtain ⟨t, -, hcov⟩ := hus.isCompact.elim_nhds_subcover N (fun x _ => hN x)
    refine ⟨∑ x ∈ t, |ρf x|, fun y hy hyT => ?_⟩
    obtain ⟨x, hxt, hxN⟩ := Set.mem_iUnion₂.1 (hcov hyT)
    have hle : ρf x ≤ ∑ x ∈ t, |ρf x| :=
      (le_abs_self _).trans (Finset.single_le_sum (f := fun x => |ρf x|)
        (fun x _ => abs_nonneg (ρf x)) hxt)
    exact hNy x y (lt_of_le_of_lt hle hy) hxN
  have hUR : ∀ y : E3, Ru + 1 ≤ ‖y‖ → (fun z => u ((hAF.ends j).Φ z)) y = 0 := by
    intro y hy
    exact image_eq_zero_of_notMem_tsupport (hRu y (by linarith))
  
  have hU0 : ContDiffOn ℝ ∞ (fun y => u ((hAF.ends j).Φ y)) (hAF.ends j).Φ.source :=
    contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn (hAF.ends j).Φ.contMDiffOn_toFun)
  have hU1 : ContDiffOn ℝ 1 (fun y => u ((hAF.ends j).Φ y)) {y : E3 | ρ' < ‖y‖} := by
    refine (hU0.mono ?_).of_le (by exact_mod_cast le_top)
    intro y hy
    rw [(hAF.ends j).source_eq]
    show 1 < ‖y‖
    have : ρ' < ‖y‖ := hy
    linarith
  
  have hH := ceh_euclid_hardy ρ' (Ru + 1) hρ'pos (fun y => u ((hAF.ends j).Φ y)) hU1 hUR R
  
  have hS'S₁ : {y : E3 | 3 * ρ' / 2 < ‖y‖} ⊆ {y : E3 | ρA + 1 < ‖y‖} := by
    intro y hy
    show ρA + 1 < ‖y‖
    have : 3 * ρ' / 2 < ‖y‖ := hy
    linarith
  have hmeas' : MeasurableSet {y : E3 | 3 * ρ' / 2 < ‖y‖} :=
    measurableSet_lt measurable_const measurable_norm
  have hmeas₁ : MeasurableSet {y : E3 | ρA + 1 < ‖y‖} :=
    measurableSet_lt measurable_const measurable_norm
  have hFint' : IntegrableOn (fun y : E3 => g.gradInner u u ((hAF.ends j).Φ y) *
      Real.sqrt (g.coeff (hAF.ends j).Φ y).det) {y : E3 | 3 * ρ' / 2 < ‖y‖} :=
    hP2.mono_set hS'S₁
  have hstep1 : ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖},
        ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 ≤
      ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖}, 4 * (g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det) := by
    refine integral_mono_of_nonneg ?_ (hFint'.const_mul 4) ?_
    · exact Filter.Eventually.of_forall (fun y => Finset.sum_nonneg (fun k _ => sq_nonneg _))
    · refine ae_restrict_of_forall_mem hmeas' ?_
      intro y hy
      have : 3 * ρ' / 2 < ‖y‖ := hy
      exact hpt u hu y (by linarith)
  have hstep2 : ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖}, 4 * (g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det) =
      4 * ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖}, g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det :=
    integral_const_mul 4 _
  have hstep3 : ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖}, g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det ≤
      ∫ y in {y : E3 | ρA + 1 < ‖y‖}, g.gradInner u u ((hAF.ends j).Φ y) *
        Real.sqrt (g.coeff (hAF.ends j).Φ y).det := by
    refine setIntegral_mono_set hP2 ?_ hS'S₁.eventuallyLE
    refine ae_restrict_of_forall_mem hmeas₁ ?_
    intro y hy
    have : ρA + 1 < ‖y‖ := hy
    exact mul_nonneg (hP1 y (by linarith)) (Real.sqrt_nonneg _)
  have hchain : ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖},
        ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 ≤
      4 * atlasInt g κ χ (g.gradInner u u) :=
    hstep1.trans (hstep2.le.trans
      (mul_le_mul_of_nonneg_left (hstep3.trans hP3) (by norm_num)))
  calc ∫ y in {y : E3 | 2 * ρ' < ‖y‖ ∧ ‖y‖ < R}, (u ((hAF.ends j).Φ y)) ^ 2 / ‖y‖ ^ 2
      ≤ 4 * ∫ y in {y : E3 | 3 * ρ' / 2 < ‖y‖},
          ∑ k : Fin 3, (partialDeriv k (fun z => u ((hAF.ends j).Φ z)) y) ^ 2 := hH
    _ ≤ 4 * (4 * atlasInt g κ χ (g.gradInner u u)) :=
        mul_le_mul_of_nonneg_left hchain (by norm_num)
    _ = 16 * atlasInt g κ χ (g.gradInner u u) := by ring

theorem cps_anchor [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (k : Fin hAF.numEnds) :
    ∃ (c : E3) (s : ℝ), 0 < s ∧ Metric.closedBall c (2 * s) ⊆ (hAF.ends k).Φ.source ∧
      ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
        ∫ y in {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s},
          (u ((hAF.ends k).Φ y)) ^ 2 ≤ C * atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  obtain ⟨ρ, CH, hρ, hCH, hH⟩ := cls_end_hardy g hAF ρA κ χ hA k
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  obtain ⟨c, hc⟩ : ∃ c : E3, c = (ρ + 2) • EuclideanSpace.single 0 (1 : ℝ) := ⟨_, rfl⟩
  have hcn : ‖c‖ = ρ + 2 := by
    rw [hc, norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_pos (by linarith)]
  have hwin : ∀ y ∈ Metric.closedBall c 1, ρ + 1 ≤ ‖y‖ ∧ ‖y‖ ≤ ρ + 3 := by
    intro y hy
    rw [Metric.mem_closedBall, dist_eq_norm] at hy
    have h1 := abs_norm_sub_norm_le y c
    rw [hcn] at h1
    have h2 := abs_le.1 (h1.trans hy)
    constructor <;> linarith [h2.1, h2.2]
  have hball : Metric.closedBall c (2 * (1 / 2 : ℝ)) ⊆ (hAF.ends k).Φ.source := by
    intro y hy
    rw [show (2 * (1 / 2 : ℝ)) = 1 by norm_num] at hy
    rw [hsrc]
    show 1 < ‖y‖
    linarith [(hwin y hy).1]
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => by fun_prop
  obtain ⟨Q, hQdef⟩ : ∃ Q : Set E3,
      Q = {y : E3 | ∀ i : Fin 3, c i - 1 / 2 ≤ y i ∧ y i ≤ c i + 1 / 2} := ⟨_, rfl⟩
  have hQball : Q ⊆ Metric.closedBall c 1 := by
    intro y hy
    rw [hQdef] at hy
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq]
    have h : ∀ i, dist (y i) (c i) ^ 2 ≤ (1 / 2 : ℝ) ^ 2 := by
      intro i
      have h1 := hy i
      rw [Real.dist_eq]
      have h2 : |y i - c i| ≤ 1 / 2 := abs_le.2 ⟨by linarith [h1.1], by linarith [h1.2]⟩
      have h3 : |y i - c i| ^ 2 ≤ (1 / 2 : ℝ) ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2 2
      exact h3
    have h4 : ∑ i : Fin 3, dist (y i) (c i) ^ 2 ≤ 1 := by
      rw [Fin.sum_univ_three]
      nlinarith [h 0, h 1, h 2]
    calc Real.sqrt (∑ i : Fin 3, dist (y i) (c i) ^ 2) ≤ Real.sqrt 1 := Real.sqrt_le_sqrt h4
      _ = 1 := Real.sqrt_one
  have hQclosed : IsClosed Q := by
    have : Q = ⋂ i : Fin 3, {y : E3 | c i - 1 / 2 ≤ y i ∧ y i ≤ c i + 1 / 2} := by
      rw [hQdef]; ext y; simp
    rw [this]
    exact isClosed_iInter fun i =>
      (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
  have hQcpt : IsCompact Q := (isCompact_closedBall c 1).of_isClosed_subset hQclosed hQball
  have hQsrc : Q ⊆ (hAF.ends k).Φ.source := by
    intro y hy
    rw [hsrc]
    show 1 < ‖y‖
    linarith [(hwin y (hQball hy)).1]
  obtain ⟨Ann, hAnndef⟩ : ∃ Ann : Set E3, Ann = {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < ρ + 4} := ⟨_, rfl⟩
  have hQAnn : Q ⊆ Ann := by
    intro y hy
    rw [hAnndef]
    exact ⟨by linarith [(hwin y (hQball hy)).1], by linarith [(hwin y (hQball hy)).2]⟩
  obtain ⟨Ann', hAnn'def⟩ : ∃ Ann' : Set E3, Ann' = {y : E3 | ρ ≤ ‖y‖ ∧ ‖y‖ ≤ ρ + 4} :=
    ⟨_, rfl⟩
  have hAnn'cpt : IsCompact Ann' := by
    rw [hAnn'def]
    refine (isCompact_closedBall (0 : E3) (ρ + 4)).of_isClosed_subset ?_ ?_
    · exact (isClosed_le continuous_const continuous_norm).inter
        (isClosed_le continuous_norm continuous_const)
    · intro y hy
      rw [mem_closedBall_zero_iff]
      exact hy.2
  have hAnn'src : Ann' ⊆ (hAF.ends k).Φ.source := by
    intro y hy
    rw [hAnn'def] at hy
    rw [hsrc]
    show 1 < ‖y‖
    linarith [hy.1]
  have hAA : Ann ⊆ Ann' := by
    intro y hy
    rw [hAnndef] at hy
    rw [hAnn'def]
    exact ⟨hy.1.le, hy.2.le⟩
  refine ⟨c, 1 / 2, by norm_num, hball, (ρ + 3) ^ 2 * CH, mul_nonneg (sq_nonneg _) hCH, ?_⟩
  intro u hu hus
  have hQeq : {y : E3 | ∀ i : Fin 3, c i - 1 / 2 ≤ y i ∧ y i ≤ c i + 1 / 2} = Q := hQdef.symm
  rw [hQeq]
  have hU2 : ContinuousOn (fun y => (u ((hAF.ends k).Φ y)) ^ 2) (hAF.ends k).Φ.source :=
    (hu.continuous.pow 2).comp_continuousOn (hAF.ends k).Φ.contMDiffOn_toFun.continuousOn
  have hQ2 : ContinuousOn (fun y : E3 => (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2)
      (hAF.ends k).Φ.source := by
    refine hU2.div (continuous_norm.pow 2).continuousOn ?_
    intro y hy
    rw [hsrc] at hy
    have h1 : (1 : ℝ) < ‖y‖ := hy
    exact pow_ne_zero 2 (lt_trans one_pos h1).ne'
  have hpt : ∀ y ∈ Q, (u ((hAF.ends k).Φ y)) ^ 2 ≤
      (ρ + 3) ^ 2 * ((u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2) := by
    intro y hy
    obtain ⟨h1, h2⟩ := hwin y (hQball hy)
    have hN : 0 < ‖y‖ := by linarith
    have hN2 : ‖y‖ ^ 2 ≤ (ρ + 3) ^ 2 := pow_le_pow_left₀ hN.le h2 2
    have hq : 0 ≤ (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 :=
      div_nonneg (sq_nonneg _) (sq_nonneg _)
    calc (u ((hAF.ends k).Φ y)) ^ 2
        = ((u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2) * ‖y‖ ^ 2 := by
          rw [div_mul_cancel₀ _ (pow_ne_zero 2 hN.ne')]
      _ ≤ ((u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2) * (ρ + 3) ^ 2 :=
          mul_le_mul_of_nonneg_left hN2 hq
      _ = (ρ + 3) ^ 2 * ((u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2) := mul_comm _ _
  have hQm : MeasurableSet Q := hQclosed.measurableSet
  have hI1 : IntegrableOn (fun y => (u ((hAF.ends k).Φ y)) ^ 2) Q :=
    (hU2.mono hQsrc).integrableOn_compact hQcpt
  have hI2 : IntegrableOn
      (fun y => (ρ + 3) ^ 2 * ((u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2)) Q :=
    ((continuousOn_const.mul hQ2).mono hQsrc).integrableOn_compact hQcpt
  have hs8 : ∫ y in Q, (u ((hAF.ends k).Φ y)) ^ 2 ≤
      (ρ + 3) ^ 2 * ∫ y in Q, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 := by
    rw [← integral_const_mul]
    exact setIntegral_mono_on hI1 hI2 hQm hpt
  have hIA : IntegrableOn (fun y : E3 => (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2) Ann :=
    ((hQ2.mono hAnn'src).integrableOn_compact hAnn'cpt).mono_set hAA
  have hs9 : ∫ y in Q, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 ≤
      ∫ y in Ann, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 :=
    setIntegral_mono_set hIA
      (Filter.Eventually.of_forall fun y => div_nonneg (sq_nonneg _) (sq_nonneg _))
      hQAnn.eventuallyLE
  have hs10 : ∫ y in Ann, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 ≤
      CH * atlasInt g κ χ (g.gradInner u u) := by
    rw [hAnndef]
    exact hH u hu hus (ρ + 4)
  have hpos : (0 : ℝ) ≤ (ρ + 3) ^ 2 := sq_nonneg _
  calc ∫ y in Q, (u ((hAF.ends k).Φ y)) ^ 2
      ≤ (ρ + 3) ^ 2 * ∫ y in Q, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 := hs8
    _ ≤ (ρ + 3) ^ 2 * ∫ y in Ann, (u ((hAF.ends k).Φ y)) ^ 2 / ‖y‖ ^ 2 :=
        mul_le_mul_of_nonneg_left hs9 hpos
    _ ≤ (ρ + 3) ^ 2 * (CH * atlasInt g κ χ (g.gradInner u u)) :=
        mul_le_mul_of_nonneg_left hs10 hpos
    _ = (ρ + 3) ^ 2 * CH * atlasInt g κ χ (g.gradInner u u) := by ring

theorem cls_poincare_compact [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (T : Set M) (hT : IsCompact T) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      atlasInt g κ χ (T.indicator (fun p => u p ^ 2)) ≤ C * atlasInt g κ χ (g.gradInner u u) :=
by
  classical
  
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => by fun_prop
  let Qc : E3 → ℝ → Set E3 := fun c s => {y : E3 | ∀ i : Fin 3, c i - s ≤ y i ∧ y i ≤ c i + s}
  let Qo : E3 → ℝ → Set E3 := fun c s => {y : E3 | ∀ i : Fin 3, c i - s < y i ∧ y i < c i + s}
  have hF1 : ∀ (c : E3) (s : ℝ), 0 ≤ s → Qc c s ⊆ Metric.closedBall c (2 * s) := by
    intro c s hs y hy
    rw [Metric.mem_closedBall, EuclideanSpace.dist_eq]
    have h : ∀ i, dist (y i) (c i) ^ 2 ≤ s ^ 2 := by
      intro i
      have h1 := hy i
      rw [Real.dist_eq]
      have h2 : |y i - c i| ≤ s := abs_le.2 ⟨by linarith [h1.1], by linarith [h1.2]⟩
      have h3 : |y i - c i| ^ 2 ≤ s ^ 2 := pow_le_pow_left₀ (abs_nonneg _) h2 2
      exact h3
    have h4 : ∑ i : Fin 3, dist (y i) (c i) ^ 2 ≤ (2 * s) ^ 2 := by
      rw [Fin.sum_univ_three]
      nlinarith [h 0, h 1, h 2, sq_nonneg s]
    calc Real.sqrt (∑ i : Fin 3, dist (y i) (c i) ^ 2) ≤ Real.sqrt ((2 * s) ^ 2) :=
          Real.sqrt_le_sqrt h4
      _ = 2 * s := Real.sqrt_sq (by linarith)
  have hQo_open : ∀ (c : E3) (s : ℝ), IsOpen (Qo c s) := by
    intro c s
    have : Qo c s = ⋂ i : Fin 3, {y : E3 | c i - s < y i ∧ y i < c i + s} := by
      ext y; simp [Qo]
    rw [this]
    exact isOpen_iInter_of_finite fun i =>
      (isOpen_lt continuous_const (hcont i)).inter (isOpen_lt (hcont i) continuous_const)
  have hQc_closed : ∀ (c : E3) (s : ℝ), IsClosed (Qc c s) := by
    intro c s
    have : Qc c s = ⋂ i : Fin 3, {y : E3 | c i - s ≤ y i ∧ y i ≤ c i + s} := by
      ext y; simp [Qc]
    rw [this]
    exact isClosed_iInter fun i =>
      (isClosed_le continuous_const (hcont i)).inter (isClosed_le (hcont i) continuous_const)
  have hQc_cpt : ∀ (c : E3) (s : ℝ), 0 ≤ s → IsCompact (Qc c s) := fun c s hs =>
    (isCompact_closedBall c (2 * s)).of_isClosed_subset (hQc_closed c s) (hF1 c s hs)
  have hQoQc : ∀ (c : E3) (s : ℝ), Qo c s ⊆ Qc c s :=
    fun c s y hy i => ⟨(hy i).1.le, (hy i).2.le⟩
  have hcen : ∀ (c : E3) (s : ℝ), 0 < s → c ∈ Qo c s :=
    fun c s hs i => ⟨by linarith, by linarith⟩
  have hQcsrc : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (s : ℝ), 0 < s →
      Metric.closedBall c (2 * s) ⊆ ψ.source → Qc c s ⊆ ψ.source :=
    fun ψ c s hs hB => (hF1 c s hs.le).trans hB
  
  have hdetc : ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source := by
    intro ψ
    have hGc : ContinuousOn (g.coeff ψ) ψ.source :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c =>
        (coeff_contDiffOn_source g ψ a c).continuousOn
    exact Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hGc)
  
  let ι : Type _ := {b : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ × E3 × ℝ //
      0 < b.2.2 ∧ Metric.closedBall b.2.1 (2 * b.2.2) ⊆ b.1.source}
  let Gs : ι → Set M := fun b => b.1.1 '' Qo b.1.2.1 b.1.2.2
  have hGo : ∀ b, IsOpen (Gs b) := fun b =>
    b.1.1.toOpenPartialHomeomorph.isOpen_image_of_subset_source (hQo_open _ _)
      ((hQoQc _ _).trans (hQcsrc b.1.1 _ _ b.2.1 b.2.2))
  have hGne : ∀ b, (Set.univ ∩ Gs b).Nonempty := fun b =>
    ⟨b.1.1 b.1.2.1, Set.mem_univ _, b.1.2.1, hcen _ _ b.2.1, rfl⟩
  have hGcov : (Set.univ : Set M) ⊆ ⋃ b, Gs b := by
    intro p _
    let κp : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      PartialDiffeomorph.mk (chartAt E3 p).symm.toPartialEquiv (chartAt E3 p).open_target
        (chartAt E3 p).open_source contMDiffOn_chart_symm contMDiffOn_chart
    have hsrc : κp.source = (chartAt E3 p).target := rfl
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 (chartAt E3 p).open_target (chartAt E3 p p)
      (mem_chart_target E3 p)
    have hB : Metric.closedBall (chartAt E3 p p) (2 * (ε / 4)) ⊆ κp.source := by
      rw [hsrc]
      exact (Metric.closedBall_subset_ball (by linarith)).trans hball
    refine Set.mem_iUnion.2 ⟨⟨(κp, chartAt E3 p p, ε / 4), by positivity, hB⟩, chartAt E3 p p,
      hcen _ _ (by positivity), ?_⟩
    show (chartAt E3 p).symm (chartAt E3 p p) = p
    exact (chartAt E3 p).left_inv (mem_chart_source E3 p)
  
  obtain ⟨c0, s0, hs0, hB0, hgood0⟩ := cps_anchor g hAF ρA κ χ hA k
  have hgood : ∀ b : ι, ∃ C : ℝ, 0 ≤ C ∧ ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      HasCompactSupport u → ∫ y in Qc b.1.2.1 b.1.2.2, (u (b.1.1 y)) ^ 2 ≤
        C * atlasInt g κ χ (g.gradInner u u) := by
    intro b
    have hr := pcr_poinc_reach (Set.univ : Set M) isPreconnected_univ Gs hGo hGcov hGne
      (⟨((hAF.ends k).Φ, c0, s0), hs0, hB0⟩ : ι) b
    induction hr with
    | refl => exact hgood0
    | @tail a c _ hac ih =>
      obtain ⟨p, hp1, hp2⟩ := hac
      exact cps_good_propagate g hAF ρA κ χ hA a.1.1 c.1.1 a.1.2.1 c.1.2.1 a.1.2.2 c.1.2.2
        a.2.1 c.2.1 a.2.2 c.2.2 ⟨p, hp1.2, hp2⟩ ih
  choose Cg hCg0 hCg using hgood
  
  have hMb : ∀ b : ι, ∃ Mb : ℝ, 0 ≤ Mb ∧
      ∀ y ∈ Qc b.1.2.1 b.1.2.2, Real.sqrt (g.coeff b.1.1 y).det ≤ Mb := by
    intro b
    obtain ⟨C, hC⟩ := (hQc_cpt _ _ b.2.1.le).exists_bound_of_continuousOn
      ((hdetc b.1.1).mono (hQcsrc b.1.1 _ _ b.2.1 b.2.2))
    refine ⟨max C 0, le_max_right _ _, fun y hy => ?_⟩
    have h1 := hC y hy
    rw [Real.norm_eq_abs] at h1
    exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
  choose Mb hMb0 hMb using hMb
  
  obtain ⟨t, ht⟩ := hT.elim_finite_subcover Gs hGo (fun p _ => hGcov (Set.mem_univ p))
  refine ⟨∑ b ∈ t, Mb b * Cg b, Finset.sum_nonneg fun b _ => mul_nonneg (hMb0 b) (hCg0 b), ?_⟩
  intro u hu hus
  
  have hGc : ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => (fun p => u p ^ 2) (ψ y)) ψ.source :=
    fun ψ => (hu.continuous.pow 2).comp_continuousOn ψ.contMDiffOn_toFun.continuousOn
  have hG0 : ∀ p, 0 ≤ (fun p => u p ^ 2) p := fun p => sq_nonneg _
  have hGK : ∀ p, p ∉ tsupport u → (fun p => u p ^ 2) p = 0 := by
    intro p hp
    simp [image_eq_zero_of_notMem_tsupport hp]
  let Tb : ι → Set M := fun b => T ∩ b.1.1 '' Qc b.1.2.1 b.1.2.2
  have hTb_closed : ∀ b, IsClosed (Tb b) := fun b =>
    hT.isClosed.inter ((hQc_cpt _ _ b.2.1.le).image_of_continuousOn
      (b.1.1.contMDiffOn_toFun.continuousOn.mono (hQcsrc _ _ _ b.2.1 b.2.2))).isClosed
  have hcovT : T ⊆ ⋃ b ∈ t, Tb b := by
    intro p hp
    have h1 := ht hp
    simp only [Set.mem_iUnion] at h1 ⊢
    obtain ⟨b, hb, y, hy, hyp⟩ := h1
    exact ⟨b, hb, hp, y, hQoQc _ _ hy, hyp⟩
  have h1 := cps_atlas_cover_subadd g hAF ρA κ χ hA (fun p => u p ^ 2) hGc hG0 (tsupport u) hus
    hGK T hT.isClosed t Tb hTb_closed hcovT
  have h2 : ∀ b ∈ t, atlasInt g κ χ ((Tb b).indicator (fun p => u p ^ 2)) ≤
      Mb b * Cg b * atlasInt g κ χ (g.gradInner u u) := by
    intro b _
    have hQcs := hQcsrc b.1.1 b.1.2.1 b.1.2.2 b.2.1 b.2.2
    have hcpt := hQc_cpt b.1.2.1 b.1.2.2 b.2.1.le
    have h3 := cps_localize_upper g hAF ρA κ χ hA b.1.1 (Qc b.1.2.1 b.1.2.2) hcpt hQcs
      (fun p => u p ^ 2) hGc hG0 (Tb b) (hTb_closed b) Set.inter_subset_right
    have hUc : ContinuousOn (fun y => u (b.1.1 y) ^ 2) b.1.1.source := hGc b.1.1
    have hI1 : IntegrableOn (fun y => u (b.1.1 y) ^ 2 * Real.sqrt (g.coeff b.1.1 y).det)
        (Qc b.1.2.1 b.1.2.2) :=
      ((hUc.mul (hdetc b.1.1)).mono hQcs).integrableOn_compact hcpt
    have hI2 : IntegrableOn (fun y => Mb b * u (b.1.1 y) ^ 2) (Qc b.1.2.1 b.1.2.2) :=
      ((continuousOn_const.mul hUc).mono hQcs).integrableOn_compact hcpt
    have h4 : ∫ y in Qc b.1.2.1 b.1.2.2, u (b.1.1 y) ^ 2 * Real.sqrt (g.coeff b.1.1 y).det ≤
        ∫ y in Qc b.1.2.1 b.1.2.2, Mb b * u (b.1.1 y) ^ 2 :=
      setIntegral_mono_on hI1 hI2 (hQc_closed _ _).measurableSet fun y hy => by
        rw [mul_comm (Mb b)]
        exact mul_le_mul_of_nonneg_left (hMb b y hy) (sq_nonneg _)
    rw [integral_const_mul] at h4
    have h5 := hCg b u hu hus
    calc atlasInt g κ χ ((Tb b).indicator (fun p => u p ^ 2))
        ≤ ∫ y in Qc b.1.2.1 b.1.2.2, u (b.1.1 y) ^ 2 * Real.sqrt (g.coeff b.1.1 y).det := h3
      _ ≤ Mb b * ∫ y in Qc b.1.2.1 b.1.2.2, u (b.1.1 y) ^ 2 := h4
      _ ≤ Mb b * (Cg b * atlasInt g κ χ (g.gradInner u u)) :=
          mul_le_mul_of_nonneg_left h5 (hMb0 b)
      _ = Mb b * Cg b * atlasInt g κ χ (g.gradInner u u) := by ring
  calc atlasInt g κ χ (T.indicator fun p => u p ^ 2)
      ≤ ∑ b ∈ t, atlasInt g κ χ ((Tb b).indicator fun p => u p ^ 2) := h1
    _ ≤ ∑ b ∈ t, Mb b * Cg b * atlasInt g κ χ (g.gradInner u u) := Finset.sum_le_sum h2
    _ = (∑ b ∈ t, Mb b * Cg b) * atlasInt g κ χ (g.gradInner u u) := by rw [Finset.sum_mul]

theorem cls_direct_method {X : Type*} [AddCommGroup X] [Module ℝ X] (P : X → Prop)
    (hP0 : P 0) (hPa : ∀ u v, P u → P v → P (u + v)) (hPs : ∀ (t : ℝ) u, P u → P (t • u))
    (Q : X → X → ℝ) (L D : X → ℝ) (c β₀ : ℝ)
    (hQs : ∀ u w, P u → P w → Q u w = Q w u)
    (hQa : ∀ u v w, P u → P v → P w → Q (u + v) w = Q u w + Q v w)
    (hQh : ∀ (t : ℝ) u w, P u → P w → Q (t • u) w = t * Q u w)
    (hLa : ∀ u v, P u → P v → L (u + v) = L u + L v)
    (hLh : ∀ (t : ℝ) u, P u → L (t • u) = t * L u)
    (hD : ∀ u, P u → 0 ≤ D u) (hc : 0 < c) (hcoer : ∀ u, P u → c * D u ≤ Q u u)
    (hβ₀ : ∀ w, P w → |L w| ≤ β₀ * Real.sqrt (D w)) :
    ∃ u : ℕ → X, (∀ n, P (u n)) ∧
      (∀ β : ℝ, (∀ w, P w → |L w| ≤ β * Real.sqrt (D w)) → ∀ n, D (u n) ≤ 4 * β ^ 2 / c ^ 2) ∧
      (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ n, N ≤ n → Q (u n - u m) (u n - u m) < ε) ∧
      (∀ φ, P φ → Tendsto (fun n => Q (u n) φ - L φ) atTop (𝓝 0)) :=
by
  classical
  
  have quad : ∀ a b : X, P a → P b → ∀ s t : ℝ,
      Q (s • a + t • b) (s • a + t • b) = s ^ 2 * Q a a + 2 * s * t * Q a b + t ^ 2 * Q b b ∧
      L (s • a + t • b) = s * L a + t * L b := by
    intro a b ha hb s t
    have hA : P (s • a) := hPs s a ha
    have hB : P (t • b) := hPs t b hb
    have hC : P (s • a + t • b) := hPa _ _ hA hB
    have e1 := hQa (s • a) (t • b) (s • a + t • b) hA hB hC
    have e2 := hQh s a (s • a + t • b) ha hC
    have f2 := hQh t b (s • a + t • b) hb hC
    have e3 := hQs a (s • a + t • b) ha hC
    have f3 := hQs b (s • a + t • b) hb hC
    have e4 := hQa (s • a) (t • b) a hA hB ha
    have f4 := hQa (s • a) (t • b) b hA hB hb
    have e5 := hQh s a a ha ha
    have e6 := hQh t b a hb ha
    have f5 := hQh s a b ha hb
    have f6 := hQh t b b hb hb
    have e7 := hQs b a hb ha
    refine ⟨?_, ?_⟩
    · rw [e1, e2, f2, e3, f3, e4, f4, e5, e6, f5, f6, e7]; ring
    · rw [hLa _ _ hA hB, hLh s a ha, hLh t b hb]
  have hQ00 : Q 0 0 = 0 := by
    have h := hQh 0 0 0 hP0 hP0
    rw [zero_smul] at h
    rw [h]; ring
  have hL0 : L 0 = 0 := by
    have h := hLh 0 0 hP0
    rw [zero_smul] at h
    rw [h]; ring
  obtain ⟨J, hJ⟩ : ∃ J : X → ℝ, J = fun w => Q w w / 2 - L w := ⟨_, rfl⟩
  have hJw : ∀ w, J w = Q w w / 2 - L w := by intro w; rw [hJ]
  have hJ0 : J 0 = 0 := by rw [hJw, hQ00, hL0]; ring
  
  have hlow : ∀ w, P w → -(β₀ ^ 2 / (2 * c)) ≤ J w := by
    intro w hw
    rw [hJw]
    have h1 := hβ₀ w hw
    have h2 := hcoer w hw
    have h3 := hD w hw
    have hs := Real.sq_sqrt h3
    have hl := le_abs_self (L w)
    have hsq : 0 ≤ (c * Real.sqrt (D w) - β₀) ^ 2 / (2 * c) := by positivity
    have hexp : (c * Real.sqrt (D w) - β₀) ^ 2 / (2 * c)
        = c * Real.sqrt (D w) ^ 2 / 2 - β₀ * Real.sqrt (D w) + β₀ ^ 2 / (2 * c) := by
      field_simp; ring
    rw [hs] at hexp
    linarith
  
  have hne : (J '' {w | P w}).Nonempty := ⟨J 0, 0, hP0, rfl⟩
  have hbdd : BddBelow (J '' {w | P w}) := by
    refine ⟨-(β₀ ^ 2 / (2 * c)), ?_⟩
    rintro _ ⟨w, hw, rfl⟩
    exact hlow w hw
  obtain ⟨μ, hμdef⟩ : ∃ μ : ℝ, μ = sInf (J '' {w | P w}) := ⟨_, rfl⟩
  have hμ : ∀ w, P w → μ ≤ J w := by
    intro w hw
    rw [hμdef]
    exact csInf_le hbdd ⟨w, hw, rfl⟩
  have hex : ∀ n : ℕ, ∃ a, P a ∧ J a < μ + 1 / ((n : ℝ) + 1) := by
    intro n
    have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    have hlt : sInf (J '' {w | P w}) < μ + 1 / ((n : ℝ) + 1) := by
      rw [← hμdef]; linarith
    obtain ⟨_, ⟨a, ha, rfl⟩, h⟩ := exists_lt_of_csInf_lt hne hlt
    exact ⟨a, ha, h⟩
  choose a ha haJ using hex
  obtain ⟨u, hPu, hJle, hJlt⟩ : ∃ u : ℕ → X, (∀ n, P (u n)) ∧ (∀ n, J (u n) ≤ 0) ∧
      (∀ n, J (u n) < μ + 1 / ((n : ℝ) + 1)) := by
    refine ⟨fun n => if J (a n) ≤ 0 then a n else 0, fun n => ?_, fun n => ?_, fun n => ?_⟩
    · dsimp only
      split_ifs with h
      · exact ha n
      · exact hP0
    · dsimp only
      split_ifs with h
      · exact h
      · rw [hJ0]
    · dsimp only
      split_ifs with h
      · exact haJ n
      · rw [hJ0]
        push_neg at h
        linarith [haJ n]
  refine ⟨u, hPu, ?_, ?_, ?_⟩
  
  · intro β hβ n
    have h1 := hJle n
    rw [hJw] at h1
    have h2 := hβ (u n) (hPu n)
    have h3 := hcoer (u n) (hPu n)
    have h4 := hD (u n) (hPu n)
    have hl := le_abs_self (L (u n))
    have hs := Real.sq_sqrt h4
    have h5 : c * Real.sqrt (D (u n)) ^ 2 ≤ 2 * β * Real.sqrt (D (u n)) := by
      rw [hs]; linarith
    have h7 : c * (c * Real.sqrt (D (u n)) ^ 2) ≤ c * (2 * β * Real.sqrt (D (u n))) :=
      mul_le_mul_of_nonneg_left h5 hc.le
    have h6 : (c * Real.sqrt (D (u n))) ^ 2 ≤ 4 * β ^ 2 := by
      nlinarith [sq_nonneg (c * Real.sqrt (D (u n)) - 2 * β)]
    rw [le_div_iff₀ (by positivity)]
    have h8 : (c * Real.sqrt (D (u n))) ^ 2 = Real.sqrt (D (u n)) ^ 2 * c ^ 2 := by ring
    rw [h8, hs] at h6
    exact h6
  
  · intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (8 / ε)
    refine ⟨N, fun m hm n hn => ?_⟩
    have hdiff : u n - u m = (1 : ℝ) • u n + (-1 : ℝ) • u m := by
      rw [one_smul, neg_one_smul, sub_eq_add_neg]
    obtain ⟨q1, -⟩ := quad (u n) (u m) (hPu n) (hPu m) 1 (-1)
    have hmid : P ((1 / 2 : ℝ) • u n + (1 / 2 : ℝ) • u m) :=
      hPa _ _ (hPs _ _ (hPu n)) (hPs _ _ (hPu m))
    obtain ⟨q2, l2⟩ := quad (u n) (u m) (hPu n) (hPu m) (1 / 2) (1 / 2)
    have hm1 := hμ _ hmid
    rw [hJw, q2, l2] at hm1
    have hn1 := hJlt n
    have hm2 := hJlt m
    rw [hJw] at hn1 hm2
    rw [hdiff, q1]
    have hNpos : (0 : ℝ) < (N : ℝ) + 1 := by positivity
    have hNn : (N : ℝ) ≤ n := by exact_mod_cast hn
    have hNm : (N : ℝ) ≤ m := by exact_mod_cast hm
    have hn' : 1 / ((n : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
      one_div_le_one_div_of_le hNpos (by linarith)
    have hm' : 1 / ((m : ℝ) + 1) ≤ 1 / ((N : ℝ) + 1) :=
      one_div_le_one_div_of_le hNpos (by linarith)
    have h8 : 8 * (1 / ((N : ℝ) + 1)) < ε := by
      rw [mul_one_div, div_lt_iff₀ hNpos]
      rw [div_lt_iff₀ hε] at hN
      nlinarith
    nlinarith
  
  · intro φ hφ
    have hq : 0 ≤ Q φ φ := le_trans (mul_nonneg hc.le (hD φ hφ)) (hcoer φ hφ)
    have hbound : ∀ n, (Q (u n) φ - L φ) ^ 2 ≤ 2 * (Q φ φ + 1) * (J (u n) - μ) := by
      intro n
      obtain ⟨g, hg⟩ : ∃ g : ℝ, g = Q (u n) φ - L φ := ⟨_, rfl⟩
      obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Q φ φ + 1 := ⟨_, rfl⟩
      have hs : 0 < s := by rw [hsdef]; linarith
      obtain ⟨t, ht⟩ : ∃ t : ℝ, t = -g / s := ⟨_, rfl⟩
      have hP' : P ((1 : ℝ) • u n + t • φ) := hPa _ _ (hPs _ _ (hPu n)) (hPs _ _ hφ)
      obtain ⟨q1, l1⟩ := quad (u n) φ (hPu n) hφ 1 t
      have h1 := hμ _ hP'
      rw [hJw, q1, l1] at h1
      have hJn := hJw (u n)
      have key : 0 ≤ (J (u n) - μ) + t * g + t ^ 2 / 2 * Q φ φ := by
        rw [hg, hJn]; nlinarith
      have hgt : g = -(t * s) := by
        rw [ht]; field_simp
      rw [hgt] at key
      have h2 : t ^ 2 * Q φ φ ≤ t ^ 2 * s :=
        mul_le_mul_of_nonneg_left (by rw [hsdef]; linarith) (sq_nonneg t)
      have h3 : t ^ 2 * s ≤ 2 * (J (u n) - μ) := by nlinarith
      have h4 : s * (t ^ 2 * s) ≤ s * (2 * (J (u n) - μ)) :=
        mul_le_mul_of_nonneg_left h3 hs.le
      rw [← hg, ← hsdef, hgt]
      nlinarith
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_gt (2 * (Q φ φ + 1) / ε ^ 2)
    refine ⟨N, fun n hn => ?_⟩
    rw [Real.dist_eq, sub_zero]
    have hb := hbound n
    have hlt := hJlt n
    have hpos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have hNn : (N : ℝ) ≤ n := by exact_mod_cast hn
    have hδ : J (u n) - μ < 1 / ((n : ℝ) + 1) := by linarith
    have h1 : 2 * (Q φ φ + 1) * (J (u n) - μ) ≤ 2 * (Q φ φ + 1) * (1 / ((n : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left hδ.le (by linarith)
    have hε2 : 0 < ε ^ 2 := by positivity
    have h2 : 2 * (Q φ φ + 1) * (1 / ((n : ℝ) + 1)) < ε ^ 2 := by
      rw [mul_one_div, div_lt_iff₀ hpos]
      rw [div_lt_iff₀ hε2] at hN
      nlinarith [mul_le_mul_of_nonneg_right hNn hε2.le]
    have h3 : (Q (u n) φ - L φ) ^ 2 < ε ^ 2 := by linarith
    exact abs_lt_of_sq_lt_sq h3 hε.le

theorem cls_form_algebra [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (h : RiemannianMetric3 M) (V f : M → ℝ)
    (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f) :
    (∀ u w : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) →
      clsQ h κ χ V u w = clsQ h κ χ V w u) ∧
    (∀ u v w : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧ HasCompactSupport v) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) →
      clsQ h κ χ V (u + v) w = clsQ h κ χ V u w + clsQ h κ χ V v w) ∧
    (∀ (t : ℝ) (u w : M → ℝ), (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) →
      clsQ h κ χ V (t • u) w = t * clsQ h κ χ V u w) ∧
    (∀ u v : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧ HasCompactSupport v) →
      clsL h κ χ f (u + v) = clsL h κ χ f u + clsL h κ χ f v) ∧
    (∀ (t : ℝ) (u : M → ℝ), (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      clsL h κ χ f (t • u) = t * clsL h κ χ f u) ∧
    (∀ u : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      0 ≤ atlasInt h κ χ (h.gradInner u u)) :=
by
  classical
  obtain ⟨h2ρ, hχs, hχ0, hsum1, hsupp, hcase⟩ := hA
  
  
  
  have hAsymm : ∀ (p : M) (i j : Fin 3),
      (h.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ i j =
        (h.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ j i := by
    intro p i j
    have hT : (h.coeff (chartAt E3 p).symm (chartAt E3 p p)).transpose =
        h.coeff (chartAt E3 p).symm (chartAt E3 p p) := by
      ext a b
      rw [Matrix.transpose_apply]
      simp only [RiemannianMetric3.coeff, coeffMatrix]
      exact h.symm _ _ _
    rw [← Matrix.transpose_apply (h.coeff (chartAt E3 p).symm (chartAt E3 p p))⁻¹ j i,
      Matrix.transpose_nonsing_inv, hT]
  have hsym : ∀ (u w : M → ℝ) (p : M), h.gradInner u w p = h.gradInner w u p := by
    intro u w p
    unfold RiemannianMetric3.gradInner
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [hAsymm p i j]
    ring
  have hnonneg : ∀ (u : M → ℝ) (p : M), 0 ≤ h.gradInner u u p := by
    intro u p
    have hPSD : (h.coeff (chartAt E3 p).symm (chartAt E3 p p)).PosSemidef := by
      apply Matrix.PosSemidef.of_dotProduct_mulVec_nonneg
      · apply Matrix.IsHermitian.ext
        intro i j
        simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
        exact h.symm _ _ _
      · intro x
        have key : star x ⬝ᵥ (h.coeff (chartAt E3 p).symm (chartAt E3 p p)).mulVec x =
            h.g ((chartAt E3 p).symm (chartAt E3 p p))
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p)
                (∑ i, x i • e i : E3))
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p)
                (∑ i, x i • e i : E3)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
            ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
            RiemannianMetric3.coeff, coeffMatrix]
          ring
        rw [key]
        by_cases hD : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p)
            (∑ i, x i • e i : E3) = 0
        · rw [hD]; simp
        · exact (h.posDef _ _ hD).le
    have h2 := hPSD.inv.dotProduct_mulVec_nonneg
      (fun i => partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p))
    unfold RiemannianMetric3.gradInner
    convert h2 using 1
    simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
    ring
  
  
  
  have hdiff : ∀ (u : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ p : M,
      DifferentiableAt ℝ (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
    intro u hu p
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u ∘ (chartAt E3 p).symm) (chartAt E3 p).target :=
      hu.comp_contMDiffOn (contMDiffOn_chart_symm (x := p))
    have h2 := contMDiffOn_iff_contDiffOn.mp h1
    exact (h2.contDiffAt ((chartAt E3 p).open_target.mem_nhds
      (mem_chart_target E3 p))).differentiableAt (by simp)
  have hadd : ∀ (u v w : M → ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v →
      ∀ p, h.gradInner (u + v) w p = h.gradInner u w p + h.gradInner v w p := by
    intro u v w hu hv p
    have hpd : ∀ i : Fin 3,
        partialDeriv i (fun y => (u + v) ((chartAt E3 p).symm y)) (chartAt E3 p p) =
          partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p) +
          partialDeriv i (fun y => v ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
      intro i
      unfold partialDeriv
      show fderiv ℝ (fun y => u ((chartAt E3 p).symm y) + v ((chartAt E3 p).symm y))
        (chartAt E3 p p) (e i) = _
      rw [fderiv_fun_add (hdiff u hu p) (hdiff v hv p), ContinuousLinearMap.add_apply]
    unfold RiemannianMetric3.gradInner
    simp only [hpd]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  have hsmul : ∀ (t : ℝ) (u w : M → ℝ) (p : M),
      h.gradInner (t • u) w p = t * h.gradInner u w p := by
    intro t u w p
    have hpd : ∀ i : Fin 3,
        partialDeriv i (fun y => (t • u) ((chartAt E3 p).symm y)) (chartAt E3 p p) =
          t * partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
      intro i
      unfold partialDeriv
      have : (fun y => (t • u) ((chartAt E3 p).symm y)) =
          t • (fun y => u ((chartAt E3 p).symm y)) := rfl
      rw [this, fderiv_const_smul_of_field, Pi.smul_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul]
    unfold RiemannianMetric3.gradInner
    simp only [hpd, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    ring
  have hloc : ∀ (u w : M → ℝ) (p : M), p ∉ tsupport u → h.gradInner u w p = 0 := by
    intro u w p hp
    have hev : u =ᶠ[𝓝 p] 0 := notMem_tsupport_iff_eventuallyEq.mp hp
    have hcont : ContinuousAt (chartAt E3 p).symm (chartAt E3 p p) :=
      (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
    have htend : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
      have := hcont.tendsto
      rwa [(chartAt E3 p).left_inv (mem_chart_source E3 p)] at this
    have hev2 : (fun y => u ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        fun _ => (0 : ℝ) := htend.eventually hev
    have hpd : ∀ i : Fin 3,
        partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
      intro i
      unfold partialDeriv
      rw [hev2.fderiv_eq]
      simp
    unfold RiemannianMetric3.gradInner
    simp [hpd]
  
  
  
  have Ihom : ∀ (t : ℝ) (F : M → ℝ),
      atlasInt h κ χ (fun p => t * F p) = t * atlasInt h κ χ F := by
    intro t F
    unfold atlasInt
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← integral_const_mul]
    congr 1
    funext y
    try beta_reduce
    ring
  have Ipos : ∀ F : M → ℝ, (∀ p, 0 ≤ F p) → 0 ≤ atlasInt h κ χ F := by
    intro F hF
    unfold atlasInt
    refine Finset.sum_nonneg fun i _ => ?_
    refine integral_nonneg fun y => ?_
    exact mul_nonneg (mul_nonneg (hχ0 i _) (hF _)) (Real.sqrt_nonneg _)
  have Iadd : ∀ F₁ F₂ : M → ℝ,
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * F₁ (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det) (κ i).source) →
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * F₂ (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det) (κ i).source) →
      atlasInt h κ χ (fun p => F₁ p + F₂ p) = atlasInt h κ χ F₁ + atlasInt h κ χ F₂ := by
    intro F₁ F₂ h1 h2
    unfold atlasInt
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← integral_add (h1 i) (h2 i)]
    congr 1
    funext y
    try beta_reduce
    ring
  
  
  
  have hcc : ∀ φ : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ → ∀ i,
      ContinuousOn (fun y => φ (κ i y)) (κ i).source :=
    fun φ hφ i => hφ.continuous.comp_continuousOn (κ i).contMDiffOn_toFun.continuousOn
  have Iint : ∀ (F : M → ℝ) (T : Set M), IsCompact T → (∀ p, p ∉ T → F p = 0) →
      (∀ i, ContinuousOn (fun y => F (κ i y)) (κ i).source) → ∀ i,
      IntegrableOn (fun y => χ i (κ i y) * F (κ i y) * Real.sqrt (h.coeff (κ i) y).det)
        (κ i).source := by
    intro F T hT hFT hFc i
    have hSo : IsOpen (κ i).source := (κ i).open_source
    have hcont : ContinuousOn
        (fun y => χ i (κ i y) * F (κ i y) * Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
      ((hcc (χ i) (hχs i) i).mul (hFc i)).mul
        (nds_chart_cont h (κ i) (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ))
          contMDiff_const contMDiff_const).2.2.2.1
    suffices hZ : ∃ Z : Set E3, IsCompact Z ∧ Z ⊆ (κ i).source ∧
        ∀ y ∈ (κ i).source \ Z,
          χ i (κ i y) * F (κ i y) * Real.sqrt (h.coeff (κ i) y).det = 0 by
      obtain ⟨Z, hZc, hZs, hZ0⟩ := hZ
      exact ((hcont.mono hZs).integrableOn_compact hZc).of_forall_diff_eq_zero
        hSo.measurableSet hZ0
    rcases hcase i with hc | ⟨j, hκj, -, hχin⟩
    · refine ⟨(κ i).invFun '' tsupport (χ i),
        hc.image_of_continuousOn ((κ i).contMDiffOn_invFun.continuousOn.mono (hsupp i)), ?_, ?_⟩
      · rintro _ ⟨x, hx, rfl⟩
        exact (κ i).map_target' (hsupp i hx)
      · rintro y ⟨hy, hyZ⟩
        have h0 : χ i (κ i y) = 0 := by
          by_contra hne
          apply hyZ
          exact ⟨κ i y, subset_tsupport _ (Function.mem_support.2 hne), (κ i).left_inv' hy⟩
        rw [h0]; ring
    · have hsrc : (κ i).source = {x : E3 | 1 < ‖x‖} := by
        rw [hκj]; exact (hAF.ends j).source_eq
      have hesc := end_chart_escape g hAF j
      choose ρ N hN hρ using hesc
      obtain ⟨t, -, hcover⟩ := hT.elim_nhds_subcover N (fun p _ => hN p)
      have hsum : 0 ≤ ∑ p ∈ t, |ρ p| := Finset.sum_nonneg fun p _ => abs_nonneg _
      refine ⟨Metric.closedBall 0 (ρA + ∑ p ∈ t, |ρ p|) ∩ {y : E3 | ρA ≤ ‖y‖},
        (isCompact_closedBall 0 _).inter_right (isClosed_le continuous_const continuous_norm),
        ?_, ?_⟩
      · rintro y ⟨-, hy⟩
        rw [hsrc]
        show (1 : ℝ) < ‖y‖
        have hy' : ρA ≤ ‖y‖ := hy
        linarith
      · rintro y ⟨hyS, hyZ⟩
        have hy1 : 1 < ‖y‖ := by
          rw [hsrc] at hyS; exact hyS
        by_cases hyρ : ‖y‖ ≤ ρA
        · have h0 : χ i (κ i y) = 0 := by
            rw [hκj]; exact hχin y hy1 hyρ
          rw [h0]; ring
        · have hRy : ρA + ∑ p ∈ t, |ρ p| < ‖y‖ := by
            by_contra hle
            push_neg at hle
            apply hyZ
            refine Set.mem_inter ?_ ?_
            · rw [Metric.mem_closedBall, dist_zero_right]; exact hle
            · show ρA ≤ ‖y‖
              exact le_of_lt (not_le.1 hyρ)
          have hFz : F (κ i y) = 0 := by
            apply hFT
            intro hyT
            obtain ⟨q, hq, hxq⟩ := Set.mem_iUnion₂.1 (hcover hyT)
            have h1 : ρ q ≤ ∑ p ∈ t, |ρ p| :=
              (le_abs_self _).trans
                (Finset.single_le_sum (f := fun p => |ρ p|) (fun p _ => abs_nonneg _) hq)
            rw [hκj] at hxq
            exact hρ q y (by linarith) hxq
          rw [hFz]; ring
  
  
  
  have IG : ∀ u w : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w → ∀ i,
      IntegrableOn (fun y => χ i (κ i y) * h.gradInner u w (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
    fun u w hu hw => Iint (h.gradInner u w) (tsupport u) hu.2.isCompact
      (fun p hp => hloc u w p hp) (fun i => (nds_chart_cont h (κ i) u w hu.1 hw).2.2.1)
  have IV : ∀ u w : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w → ∀ i,
      IntegrableOn (fun y => χ i (κ i y) * (fun p => V p * u p * w p) (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
    fun u w hu hw => Iint (fun p => V p * u p * w p) (tsupport u) hu.2.isCompact
      (fun p hp => by simp [image_eq_zero_of_notMem_tsupport hp])
      (fun i => ((hcc V hV i).mul (hcc u hu.1 i)).mul (hcc w hw i))
  have IF : ∀ u : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) → ∀ i,
      IntegrableOn (fun y => χ i (κ i y) * (fun p => f p * u p) (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
    fun u hu => Iint (fun p => f p * u p) (tsupport u) hu.2.isCompact
      (fun p hp => by simp [image_eq_zero_of_notMem_tsupport hp])
      (fun i => (hcc f hf i).mul (hcc u hu.1 i))
  
  
  
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro u w _ _
    unfold clsQ
    have e1 : h.gradInner u w = h.gradInner w u := funext (hsym u w)
    have e2 : (fun p => V p * u p * w p) = (fun p => V p * w p * u p) := by
      funext p; ring
    rw [e1, e2]
  · intro u v w hu hv hw
    unfold clsQ
    have e1 : h.gradInner (u + v) w = fun p => h.gradInner u w p + h.gradInner v w p :=
      funext (hadd u v w hu.1 hv.1)
    have e2 : (fun p => V p * (u + v) p * w p) =
        fun p => V p * u p * w p + V p * v p * w p := by
      funext p; simp only [Pi.add_apply]; ring
    have a1 := Iadd (h.gradInner u w) (h.gradInner v w) (IG u w hu hw.1) (IG v w hv hw.1)
    have a2 := Iadd (fun p => V p * u p * w p) (fun p => V p * v p * w p)
      (IV u w hu hw.1) (IV v w hv hw.1)
    rw [e1, e2]
    linarith [a1, a2]
  · intro t u w _ _
    unfold clsQ
    have e1 : h.gradInner (t • u) w = fun p => t * h.gradInner u w p := funext (hsmul t u w)
    have e2 : (fun p => V p * (t • u) p * w p) = fun p => t * (V p * u p * w p) := by
      funext p; simp only [Pi.smul_apply, smul_eq_mul]; ring
    rw [e1, e2, Ihom, Ihom]
    ring
  · intro u v hu hv
    unfold clsL
    have e : (fun p => f p * (u + v) p) = fun p => f p * u p + f p * v p := by
      funext p; simp only [Pi.add_apply]; ring
    have a := Iadd (fun p => f p * u p) (fun p => f p * v p) (IF u hu) (IF v hv)
    rw [e]
    linarith [a]
  · intro t u _
    unfold clsL
    have e : (fun p => f p * (t • u) p) = fun p => t * (f p * u p) := by
      funext p; simp only [Pi.smul_apply, smul_eq_mul]; ring
    rw [e, Ihom]
  · intro u _
    exact Ipos _ (hnonneg u)

theorem cceb_gradInner_self_facts [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (w : M → ℝ) (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w) :
    (∀ p : M, 0 ≤ g.gradInner w w p) ∧
      (∀ p : M, p ∉ tsupport w → g.gradInner w w p = 0) :=
by
  classical
  refine ⟨fun p => ?_, fun p hp => ?_⟩
  · have hGpsd : (g.coeff (chartAt E3 p).symm (chartAt E3 p p)).PosSemidef := by
      refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ ?_
      · refine Matrix.IsHermitian.ext fun i j => ?_
        simp only [star_trivial, RiemannianMetric3.coeff, coeffMatrix]
        exact g.symm _ _ _
      · intro x
        have hv : 0 ≤ g.g ((chartAt E3 p).symm (chartAt E3 p p))
            (∑ i, x i • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p) (e i))
            (∑ i, x i • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm (chartAt E3 p p) (e i)) := by
          by_cases h : (∑ i, x i • mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 p).symm
              (chartAt E3 p p) (e i) : E3) = 0
          · rw [h]; simp
          · exact (g.posDef _ _ h).le
        refine le_of_le_of_eq hv ?_
        simp only [map_sum, map_smul, map_add, ContinuousLinearMap.add_apply,
          ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, dotProduct, Matrix.mulVec, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix, Fin.sum_univ_three]
        ring
    have h := hGpsd.inv.dotProduct_mulVec_nonneg
      (fun i => partialDeriv i (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p))
    refine le_of_le_of_eq h ?_
    simp only [RiemannianMetric3.gradInner, dotProduct, Matrix.mulVec, star_trivial,
      Fin.sum_univ_three]
    ring
  · have hw0 : w =ᶠ[𝓝 p] 0 := notMem_tsupport_iff_eventuallyEq.mp hp
    have hT : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
      have h1 := (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
      rw [ContinuousAt, (chartAt E3 p).left_inv (mem_chart_source E3 p)] at h1
      exact h1
    have hcomp : (fun y => w ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        fun _ => (0 : ℝ) :=
      hw0.comp_tendsto hT
    have hfd : fderiv ℝ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
      rw [hcomp.fderiv_eq]
      exact fderiv_const_apply _
    have hpd : ∀ i, partialDeriv i (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
      intro i
      unfold partialDeriv
      rw [hfd]
      rfl
    simp only [RiemannianMetric3.gradInner, hpd, mul_zero, Finset.sum_const_zero]

theorem cls_metric_pointwise [IsManifold 𝓘(ℝ, E3) ∞ M] (g h : RiemannianMetric3 M)
    (hgh : ∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) :
    (∀ (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3), y ∈ φ.source →
      Real.sqrt (h.coeff φ y).det ≤ 2 * Real.sqrt 2 * Real.sqrt (g.coeff φ y).det ∧
      Real.sqrt (g.coeff φ y).det ≤ 2 * Real.sqrt 2 * Real.sqrt (h.coeff φ y).det) ∧
    (∀ (u : M → ℝ) (p : M), g.gradInner u u p ≤ 2 * h.gradInner u u p) :=
by
  classical
  
  have bridge : ∀ (Mx : Matrix (Fin 3) (Fin 3) ℝ) (x : Fin 3 → ℝ),
      ∑ i : Fin 3, ∑ j : Fin 3, Mx i j * x i * x j = x ⬝ᵥ (Mx.mulVec x) := by
    intro Mx x
    simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
    ring
  have symmA : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → A.transpose = A := by
    intro A hA
    have h1 := hA.isHermitian
    unfold Matrix.IsHermitian at h1
    rw [Matrix.conjTranspose_eq_transpose_of_trivial] at h1
    exact h1
  have dot_symm : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.transpose = A →
      ∀ u w : Fin 3 → ℝ, u ⬝ᵥ (A.mulVec w) = w ⬝ᵥ (A.mulVec u) := by
    intro A hA u w
    rw [Matrix.dotProduct_mulVec, dotProduct_comm (Matrix.vecMul u A) w,
      ← Matrix.mulVec_transpose, hA]
  have psd : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef →
      ∀ w : Fin 3 → ℝ, 0 ≤ w ⬝ᵥ (A.mulVec w) := by
    intro A hA w
    have h1 := hA.posSemidef.dotProduct_mulVec_nonneg w
    simpa [Pi.star_def] using h1
  
  have inv_le : ∀ (A B : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → B.PosDef → ∀ c : ℝ, 0 < c →
      (∀ x : Fin 3 → ℝ, x ⬝ᵥ (A.mulVec x) ≤ c * (x ⬝ᵥ (B.mulVec x))) →
      ∀ x : Fin 3 → ℝ, x ⬝ᵥ (B⁻¹.mulVec x) ≤ c * (x ⬝ᵥ (A⁻¹.mulVec x)) := by
    intro A B hA hB c hc hAB x
    have hAu : IsUnit A.det := (Matrix.isUnit_iff_isUnit_det A).mp hA.isUnit
    have hBu : IsUnit B.det := (Matrix.isUnit_iff_isUnit_det B).mp hB.isUnit
    have hAT := symmA A hA
    obtain ⟨z, hz⟩ : ∃ z, z = B⁻¹.mulVec x := ⟨_, rfl⟩
    obtain ⟨v, hv⟩ : ∃ v, v = A⁻¹.mulVec x := ⟨_, rfl⟩
    rw [← hz, ← hv]
    have hBz : B.mulVec z = x := by
      rw [hz, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hBu, Matrix.one_mulVec]
    have hAv : A.mulVec v = x := by
      rw [hv, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hAu, Matrix.one_mulVec]
    have e1 : x ⬝ᵥ z = z ⬝ᵥ (B.mulVec z) := by rw [hBz, dotProduct_comm z x]
    have e2 : x ⬝ᵥ v = v ⬝ᵥ (A.mulVec v) := by rw [hAv, dotProduct_comm v x]
    have e3 : z ⬝ᵥ (A.mulVec v) = x ⬝ᵥ z := by rw [hAv, dotProduct_comm z x]
    have e4 : v ⬝ᵥ (A.mulVec z) = z ⬝ᵥ (A.mulVec v) := dot_symm A hAT v z
    have hpos := psd A hA (z - c • v)
    have hexp : (z - c • v) ⬝ᵥ (A.mulVec (z - c • v)) =
        z ⬝ᵥ (A.mulVec z) - c * (z ⬝ᵥ (A.mulVec v)) - c * (v ⬝ᵥ (A.mulVec z)) +
          c ^ 2 * (v ⬝ᵥ (A.mulVec v)) := by
      simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, sub_dotProduct, dotProduct_sub,
        smul_dotProduct, dotProduct_smul, smul_eq_mul]
      ring
    rw [hexp, e4, e3, ← e2] at hpos
    have hz' := hAB z
    rw [← e1] at hz'
    nlinarith
  
  have det_le : ∀ (A B : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → B.PosDef → ∀ c : ℝ,
      (∀ x : Fin 3 → ℝ, x ⬝ᵥ (A.mulVec x) ≤ c * (x ⬝ᵥ (B.mulVec x))) →
      A.det ≤ c ^ 3 * B.det := by
    intro A B hA hB c hAB
    obtain ⟨R, hRu, hBR⟩ := Matrix.posDef_iff_eq_conjTranspose_mul_self.mp hB
    rw [Matrix.conjTranspose_eq_transpose_of_trivial] at hBR
    have hRd : IsUnit R.det := (Matrix.isUnit_iff_isUnit_det R).mp hRu
    obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin 3) (Fin 3) ℝ, P = R⁻¹ := ⟨_, rfl⟩
    have hRP : R * P = 1 := by rw [hP]; exact Matrix.mul_nonsing_inv R hRd
    have hAT := symmA A hA
    obtain ⟨C, hC⟩ : ∃ C : Matrix (Fin 3) (Fin 3) ℝ, C = P.transpose * A * P := ⟨_, rfl⟩
    have hCT : C.transpose = C := by
      rw [hC, Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hAT,
        Matrix.mul_assoc]
    have hCH : C.IsHermitian := by
      unfold Matrix.IsHermitian
      rw [Matrix.conjTranspose_eq_transpose_of_trivial]
      exact hCT
    have hform : ∀ x : Fin 3 → ℝ,
        x ⬝ᵥ (C.mulVec x) = (P.mulVec x) ⬝ᵥ (A.mulVec (P.mulVec x)) := by
      intro x
      rw [hC, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        Matrix.dotProduct_mulVec x P.transpose, Matrix.vecMul_transpose]
    have hformB : ∀ x : Fin 3 → ℝ, (P.mulVec x) ⬝ᵥ (B.mulVec (P.mulVec x)) = x ⬝ᵥ x := by
      intro x
      rw [hBR, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec (P.mulVec x) R.transpose,
        Matrix.vecMul_transpose, Matrix.mulVec_mulVec, hRP, Matrix.one_mulVec]
    have hev : ∀ k, 0 ≤ hCH.eigenvalues k ∧ hCH.eigenvalues k ≤ c := by
      intro k
      have hww : (hCH.eigenvectorBasis k).ofLp ⬝ᵥ (hCH.eigenvectorBasis k).ofLp = 1 := by
        have h1 := EuclideanSpace.inner_eq_star_dotProduct (hCH.eigenvectorBasis k)
          (hCH.eigenvectorBasis k)
        rw [real_inner_self_eq_norm_sq, hCH.eigenvectorBasis.orthonormal.1 k] at h1
        simpa [Pi.star_def] using h1.symm
      have hq : (hCH.eigenvectorBasis k).ofLp ⬝ᵥ (C.mulVec (hCH.eigenvectorBasis k).ofLp) =
          hCH.eigenvalues k := by
        rw [hCH.mulVec_eigenvectorBasis k, dotProduct_smul, hww]
        simp [RCLike.ofReal_real_eq_id]
      have h0 := psd A hA (P.mulVec (hCH.eigenvectorBasis k).ofLp)
      have h1 := hAB (P.mulVec (hCH.eigenvectorBasis k).ofLp)
      rw [hformB, hww, ← hform, hq] at h1
      rw [← hform, hq] at h0
      exact ⟨h0, by linarith⟩
    have hdetC : C.det ≤ c ^ 3 := by
      have hprod : C.det = ∏ k, hCH.eigenvalues k := by
        rw [hCH.det_eq_prod_eigenvalues]
        simp [RCLike.ofReal_real_eq_id]
      rw [hprod]
      calc ∏ k, hCH.eigenvalues k ≤ ∏ _k : Fin 3, c :=
            Finset.prod_le_prod (fun k _ => (hev k).1) (fun k _ => (hev k).2)
        _ = c ^ 3 := by simp
    have hdC : C.det = P.det * A.det * P.det := by
      rw [hC, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    have hdB : B.det = R.det * R.det := by
      rw [hBR, Matrix.det_mul, Matrix.det_transpose]
    have hdRP : R.det * P.det = 1 := by rw [← Matrix.det_mul, hRP, Matrix.det_one]
    have hAeq : A.det = C.det * (R.det * R.det) := by
      rw [hdC]
      linear_combination (-(A.det) * (1 + R.det * P.det)) * hdRP
    rw [hAeq, hdB]
    exact mul_le_mul_of_nonneg_right hdetC (mul_self_nonneg _)
  
  have qform : ∀ (k : RiemannianMetric3 M) (φ : E3 → M) (y : E3) (x : Fin 3 → ℝ),
      x ⬝ᵥ ((k.coeff φ y).mulVec x) =
        k.g (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3)) := by
    intro k φ y x
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
      ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec,
      RiemannianMetric3.coeff, coeffMatrix]
    ring
  
  have coeffPD : ∀ (k : RiemannianMetric3 M)
      (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (y : E3), y ∈ φ.source →
      (k.coeff φ y).PosDef := by
    intro k φ y hy
    have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ φ hy
    have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y w = 0 → w = 0 := by
      intro w hw
      have hL : ∀ u : E3, (hloc.mfderivToContinuousLinearEquiv hn) u =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y u := by
        intro u
        rw [← hloc.mfderivToContinuousLinearEquiv_coe hn]
        rfl
      apply (hloc.mfderivToContinuousLinearEquiv hn).injective
      rw [hL, hw, map_zero]
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [RiemannianMetric3.coeff, coeffMatrix, star_trivial]
      exact k.symm _ _ _
    · intro x hx
      have hvx : (∑ i, x i • e i : E3) ≠ 0 := by
        intro h0
        apply hx
        funext j
        have h1 := congrArg (fun u : E3 => u j) h0
        fin_cases j <;> simpa [e, Fin.sum_univ_three, EuclideanSpace.single_apply] using h1
      have hDv := fun h => hvx (hDinj _ h)
      have hpos := k.posDef (φ y) _ hDv
      have key : star x ⬝ᵥ (k.coeff φ y).mulVec x =
          k.g (φ y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3)) := by
        simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
          ContinuousLinearMap.smul_apply, smul_eq_mul, Fin.sum_univ_three, map_add,
          ContinuousLinearMap.add_apply, dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial,
          RiemannianMetric3.coeff, coeffMatrix]
        ring
      rw [key]
      exact hpos
  
  have chartPD : ∀ (k : RiemannianMetric3 M) (p : M),
      (k.coeff (chartAt E3 p).symm (chartAt E3 p p)).PosDef := by
    intro k p
    let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      ⟨(chartAt E3 p).symm.toPartialEquiv, (chartAt E3 p).open_target,
        (chartAt E3 p).open_source, contMDiffOn_chart_symm, contMDiffOn_chart⟩
    exact coeffPD k Φc (chartAt E3 p p) (mem_chart_target E3 p)
  
  have sqstep : ∀ X Y : ℝ, 0 ≤ Y → X ≤ 2 ^ 3 * Y →
      Real.sqrt X ≤ 2 * Real.sqrt 2 * Real.sqrt Y := by
    intro X Y hY hXY
    have h2 : (2 * Real.sqrt 2 * Real.sqrt Y) ^ 2 = 2 ^ 3 * Y := by
      rw [mul_pow, mul_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), Real.sq_sqrt hY]
      ring
    calc Real.sqrt X ≤ Real.sqrt (2 ^ 3 * Y) := Real.sqrt_le_sqrt hXY
      _ = 2 * Real.sqrt 2 * Real.sqrt Y := by
          rw [← h2, Real.sqrt_sq (by positivity)]
  refine ⟨?_, ?_⟩
  · intro φ y hy
    have hG := coeffPD g φ y hy
    have hH := coeffPD h φ y hy
    have hHG : ∀ x : Fin 3 → ℝ, x ⬝ᵥ ((h.coeff φ y).mulVec x) ≤
        2 * (x ⬝ᵥ ((g.coeff φ y).mulVec x)) := by
      intro x
      rw [qform h, qform g]
      exact (hgh _ _).2
    have hGH : ∀ x : Fin 3 → ℝ, x ⬝ᵥ ((g.coeff φ y).mulVec x) ≤
        2 * (x ⬝ᵥ ((h.coeff φ y).mulVec x)) := by
      intro x
      rw [qform h, qform g]
      have h1 := (hgh (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (∑ i, x i • e i : E3))).1
      linarith
    exact ⟨sqstep _ _ hG.det_pos.le (det_le _ _ hH hG 2 hHG),
      sqstep _ _ hH.det_pos.le (det_le _ _ hG hH 2 hGH)⟩
  · intro u p
    have hG := chartPD g p
    have hH := chartPD h p
    have hHG : ∀ x : Fin 3 → ℝ,
        x ⬝ᵥ ((h.coeff (chartAt E3 p).symm (chartAt E3 p p)).mulVec x) ≤
        2 * (x ⬝ᵥ ((g.coeff (chartAt E3 p).symm (chartAt E3 p p)).mulVec x)) := by
      intro x
      rw [qform h, qform g]
      exact (hgh _ _).2
    have key := inv_le _ _ hH hG 2 two_pos hHG
      (fun i => partialDeriv i (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p p))
    rw [← bridge, ← bridge] at key
    exact key

theorem cls_chart_integrable [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (h : RiemannianMetric3 M)
    (κ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : M → ℝ)
    (hχ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ χ) (hχt : tsupport χ ⊆ κ.target) (C : Set M)
    (hC : IsClosed C) (f : M → ℝ) (hf : ContinuousOn (fun y => f (κ y)) κ.source) (T : Set M)
    (hT : IsCompact T) (hCT : ∀ p, p ∉ T → C.indicator f p = 0) :
    MeasureTheory.IntegrableOn
      (fun y => χ (κ y) * C.indicator f (κ y) * Real.sqrt (h.coeff κ y).det) κ.source :=
by
  classical
  set A : Set M := T ∩ (C ∩ tsupport χ) with hAdef
  have hA : IsCompact A := hT.inter_right (hC.inter (isClosed_tsupport χ))
  have hAt : A ⊆ κ.target := fun p hp => hχt hp.2.2
  set L : Set E3 := κ.toPartialEquiv.symm '' A with hLdef
  have hL : IsCompact L :=
    hA.image_of_continuousOn (κ.contMDiffOn_invFun.continuousOn.mono hAt)
  have hLs : L ⊆ κ.source := by
    rintro y ⟨p, hp, rfl⟩
    exact κ.toPartialEquiv.map_target (hAt hp)
  have hLm : MeasurableSet L := hL.isClosed.measurableSet
  have hLC : ∀ y ∈ L, κ y ∈ C := by
    rintro y ⟨p, hp, rfl⟩
    have : κ (κ.toPartialEquiv.symm p) = p := κ.toPartialEquiv.right_inv (hAt hp)
    rw [this]; exact hp.2.1
  have hχc : ContinuousOn (fun y => χ (κ y)) κ.source :=
    hχ.continuous.comp_continuousOn κ.contMDiffOn_toFun.continuousOn
  have hdc : ContinuousOn (fun y => Real.sqrt (h.coeff κ y).det) κ.source :=
    (nds_chart_cont h κ (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ)) contMDiff_const
      contMDiff_const).2.2.2.1
  have hGc : ContinuousOn (fun y => χ (κ y) * f (κ y) * Real.sqrt (h.coeff κ y).det)
      κ.source := (hχc.mul hf).mul hdc
  have hGL : IntegrableOn (fun y => χ (κ y) * f (κ y) * Real.sqrt (h.coeff κ y).det) L :=
    (hGc.mono hLs).integrableOn_compact hL
  have hFL : IntegrableOn
      (fun y => χ (κ y) * C.indicator f (κ y) * Real.sqrt (h.coeff κ y).det) L := by
    refine hGL.congr_fun (fun y hy => ?_) hLm
    simp only [Set.indicator_of_mem (hLC y hy)]
  refine hFL.of_forall_diff_eq_zero κ.open_source.measurableSet ?_
  rintro y ⟨hyU, hyL⟩
  by_cases hpT : κ y ∈ T
  · by_cases hpC : κ y ∈ C
    · by_cases hpχ : κ y ∈ tsupport χ
      · exfalso
        apply hyL
        refine ⟨κ y, ⟨hpT, hpC, hpχ⟩, ?_⟩
        exact κ.toPartialEquiv.left_inv hyU
      · simp only [image_eq_zero_of_notMem_tsupport hpχ, zero_mul]
    · simp only [Set.indicator_of_notMem hpC, mul_zero, zero_mul]
  · simp only [hCT _ hpT, mul_zero, zero_mul]

theorem cls_coercive [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (S : Set M) (hS : IsCompact S) (CS : ℝ) (hCS : 0 ≤ CS)
    (hP : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      atlasInt g κ χ (S.indicator (fun p => u p ^ 2)) ≤ CS * atlasInt g κ χ (g.gradInner u u)) :
    ∃ ε₀ cS : ℝ, 0 < ε₀ ∧ 0 ≤ cS ∧ ∀ h : RiemannianMetric3 M,
      (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) →
      ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
        (∀ V : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → (∀ p, p ∉ S → V p = 0) →
          (∀ p, |V p| ≤ ε₀) →
          |atlasInt h κ χ (fun p => V p * u p * u p)| ≤
            (1 / 2) * atlasInt h κ χ (h.gradInner u u)) ∧
        (∀ (F : M → ℝ) (B : ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F → (∀ p, p ∉ S → F p = 0) →
          (∀ p, |F p| ≤ B) →
          |atlasInt h κ χ (fun p => F p * u p)| ≤
            cS * B * Real.sqrt (atlasInt h κ χ (h.gradInner u u))) ∧
        atlasInt g κ χ (g.gradInner u u) ≤ 4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u) :=
by
  classical
  obtain ⟨_, hχs, hχ0, _, hχt, _⟩ := hA
  
  
  
  have hcomp : ∀ (h₁ h₂ : RiemannianMetric3 M) (c : ℝ) (F G : M → ℝ),
      (∀ i, ∀ y ∈ (κ i).source,
        Real.sqrt (h₁.coeff (κ i) y).det ≤ c * Real.sqrt (h₂.coeff (κ i) y).det) →
      (∀ p, |F p| ≤ G p) →
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (h₂.coeff (κ i) y).det)
        (κ i).source) →
      |atlasInt h₁ κ χ F| ≤ c * atlasInt h₂ κ χ G := by
    intro h₁ h₂ c F G hdet hFG hint
    simp only [atlasInt]
    rw [Finset.mul_sum]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    refine (abs_integral_le_integral_abs).trans ?_
    rw [← integral_const_mul]
    refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun y => abs_nonneg _)
      (Integrable.const_mul (hint i) c) ?_
    refine (ae_restrict_iff' (κ i).open_source.measurableSet).2
      (Filter.Eventually.of_forall fun y hy => ?_)
    have h1 := hdet i y hy
    have hG : 0 ≤ G (κ i y) := (abs_nonneg _).trans (hFG _)
    have hχ := hχ0 i (κ i y)
    have hd1 : 0 ≤ Real.sqrt (h₁.coeff (κ i) y).det := Real.sqrt_nonneg _
    dsimp only
    rw [abs_mul, abs_mul, abs_of_nonneg hχ, abs_of_nonneg hd1]
    calc χ i (κ i y) * |F (κ i y)| * Real.sqrt (h₁.coeff (κ i) y).det
        ≤ χ i (κ i y) * G (κ i y) * (c * Real.sqrt (h₂.coeff (κ i) y).det) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (hFG _) hχ) h1 hd1 (mul_nonneg hχ hG)
      _ = c * (χ i (κ i y) * G (κ i y) * Real.sqrt (h₂.coeff (κ i) y).det) := by ring
  have hlinEq : ∀ (h₁ : RiemannianMetric3 M) (a b : ℝ) (G₁ G₂ : M → ℝ),
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * G₁ (κ i y) * Real.sqrt (h₁.coeff (κ i) y).det)
        (κ i).source) →
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * G₂ (κ i y) * Real.sqrt (h₁.coeff (κ i) y).det)
        (κ i).source) →
      (∀ i, IntegrableOn (fun y => χ i (κ i y) * (a * G₁ (κ i y) + b * G₂ (κ i y)) *
        Real.sqrt (h₁.coeff (κ i) y).det) (κ i).source) ∧
      atlasInt h₁ κ χ (fun p => a * G₁ p + b * G₂ p) =
        a * atlasInt h₁ κ χ G₁ + b * atlasInt h₁ κ χ G₂ := by
    intro h₁ a b G₁ G₂ h1 h2
    have heq : ∀ i, (fun y => χ i (κ i y) * (a * G₁ (κ i y) + b * G₂ (κ i y)) *
        Real.sqrt (h₁.coeff (κ i) y).det) = fun y =>
        a * (χ i (κ i y) * G₁ (κ i y) * Real.sqrt (h₁.coeff (κ i) y).det) +
        b * (χ i (κ i y) * G₂ (κ i y) * Real.sqrt (h₁.coeff (κ i) y).det) := by
      intro i; funext y; ring
    refine ⟨fun i => ?_, ?_⟩
    · rw [heq i]
      exact (Integrable.const_mul (h1 i) a).add (Integrable.const_mul (h2 i) b)
    · simp only [atlasInt]
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← integral_const_mul, ← integral_const_mul,
        ← integral_add (Integrable.const_mul (h1 i) a) (Integrable.const_mul (h2 i) b)]
      congr 1
      funext y
      ring
  have hscal : ∀ (h₁ : RiemannianMetric3 M) (c : ℝ) (G : M → ℝ),
      atlasInt h₁ κ χ (fun p => c * G p) = c * atlasInt h₁ κ χ G := by
    intro h₁ c G
    simp only [atlasInt]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← integral_const_mul]
    congr 1
    funext y
    ring
  have hnn : ∀ (h₁ : RiemannianMetric3 M) (G : M → ℝ), (∀ p, 0 ≤ G p) →
      0 ≤ atlasInt h₁ κ χ G := by
    intro h₁ G hG
    simp only [atlasInt]
    refine Finset.sum_nonneg fun i _ =>
      setIntegral_nonneg (κ i).open_source.measurableSet fun y _ => ?_
    exact mul_nonneg (mul_nonneg (hχ0 _ _) (hG _)) (Real.sqrt_nonneg _)
  have hempty : IsEmpty M → ∀ (h₁ : RiemannianMetric3 M) (G : M → ℝ),
      atlasInt h₁ κ χ G = 0 := by
    intro hM h₁ G
    simp only [atlasInt]
    refine Finset.sum_eq_zero fun i _ => ?_
    have hsrc : (κ i).source = ∅ :=
      Set.eq_empty_iff_forall_notMem.2 fun y _ => hM.elim (κ i y)
    rw [hsrc, Measure.restrict_empty, integral_zero_measure]
  
  
  
  obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = atlasInt g κ χ (S.indicator (fun _ => (1 : ℝ))) :=
    ⟨_, rfl⟩
  have ha : 0 ≤ a := by
    rw [ha_def]
    exact hnn g _ (Set.indicator_nonneg fun _ _ => zero_le_one)
  have hCS1 : 0 < CS + 1 := by linarith
  obtain ⟨ε₀, hε₀def⟩ : ∃ ε₀ : ℝ, ε₀ = 1 / (32 * (CS + 1)) := ⟨_, rfl⟩
  have hε₀ : 0 < ε₀ := by rw [hε₀def]; exact div_pos one_pos (by linarith)
  have hK1 : 16 * ε₀ * CS ≤ 1 / 2 := by
    have hx : ε₀ * (32 * (CS + 1)) = 1 := by
      rw [hε₀def]; exact one_div_mul_cancel (by linarith)
    nlinarith
  have hs2 : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
  have h22 : (0 : ℝ) ≤ 2 * Real.sqrt 2 := by positivity
  refine ⟨ε₀, Real.sqrt 2 * a + 8 * CS, hε₀,
    add_nonneg (mul_nonneg (Real.sqrt_nonneg _) ha) (by linarith), ?_⟩
  
  
  
  intro h hgh u hu hus
  obtain ⟨Pdet, Pgrad⟩ := cls_metric_pointwise g h hgh
  have hgf := cceb_gradInner_self_facts g u hu
  have hhf := cceb_gradInner_self_facts h u hu
  have hSc : IsClosed S := hS.isClosed
  
  have hI1 : ∀ i, IntegrableOn (fun y => χ i (κ i y) * (2 * h.gradInner u u (κ i y)) *
      Real.sqrt (h.coeff (κ i) y).det) (κ i).source := by
    intro i
    have := cls_chart_integrable h (κ i) (χ i) (hχs i) (hχt i) Set.univ isClosed_univ
      (fun p => 2 * h.gradInner u u p)
      (continuousOn_const.mul (nds_chart_cont h (κ i) u u hu hu).2.2.1)
      (tsupport u) hus.isCompact (fun p hp => by
        rw [Set.indicator_univ]
        show 2 * h.gradInner u u p = 0
        rw [hhf.2 p hp, mul_zero])
    rw [Set.indicator_univ] at this
    exact this
  have hI2 : ∀ i, IntegrableOn (fun y => χ i (κ i y) * S.indicator (fun p => u p ^ 2) (κ i y) *
      Real.sqrt (g.coeff (κ i) y).det) (κ i).source := fun i =>
    cls_chart_integrable g (κ i) (χ i) (hχs i) (hχt i) S hSc (fun p => u p ^ 2)
      ((hu.continuous.comp_continuousOn (κ i).contMDiffOn_toFun.continuousOn).pow 2) S hS
      (fun p hp => Set.indicator_of_notMem hp _)
  have hI3 : ∀ i, IntegrableOn (fun y => χ i (κ i y) * S.indicator (fun _ => (1 : ℝ)) (κ i y) *
      Real.sqrt (g.coeff (κ i) y).det) (κ i).source := fun i =>
    cls_chart_integrable g (κ i) (χ i) (hχs i) (hχt i) S hSc (fun _ => (1 : ℝ))
      continuousOn_const S hS (fun p hp => Set.indicator_of_notMem hp _)
  have hDh : 0 ≤ atlasInt h κ χ (h.gradInner u u) := hnn h _ hhf.1
  
  
  
  have hiii : atlasInt g κ χ (g.gradInner u u) ≤
      4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u) := by
    have h1 := hcomp g h (2 * Real.sqrt 2) (g.gradInner u u) (fun p => 2 * h.gradInner u u p)
      (fun i y hy => (Pdet (κ i) y hy).2)
      (fun p => by rw [abs_of_nonneg (hgf.1 p)]; exact Pgrad u p) hI1
    rw [hscal h 2 (h.gradInner u u)] at h1
    have h2 := le_abs_self (atlasInt g κ χ (g.gradInner u u))
    linarith
  have h4 : atlasInt g κ χ (S.indicator (fun p => u p ^ 2)) ≤
      CS * (4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u)) :=
    (hP u hu hus).trans (mul_le_mul_of_nonneg_left hiii hCS)
  refine ⟨fun V _ hVS hVb => ?_, fun F B _ hFS hFB => ?_, hiii⟩
  
  
  
  · have hpt : ∀ p, |V p * u p * u p| ≤ ε₀ * S.indicator (fun p => u p ^ 2) p := by
      intro p
      by_cases hp : p ∈ S
      · simp only [Set.indicator_of_mem hp]
        rw [show V p * u p * u p = V p * u p ^ 2 by ring, abs_mul,
          abs_of_nonneg (sq_nonneg (u p))]
        exact mul_le_mul_of_nonneg_right (hVb p) (sq_nonneg _)
      · simp only [Set.indicator_of_notMem hp, hVS p hp, zero_mul, abs_zero, mul_zero, le_refl]
    have hI4 : ∀ i, IntegrableOn (fun y => χ i (κ i y) *
        (ε₀ * S.indicator (fun p => u p ^ 2) (κ i y)) * Real.sqrt (g.coeff (κ i) y).det)
        (κ i).source := by
      intro i
      have e : (fun y => χ i (κ i y) * (ε₀ * S.indicator (fun p => u p ^ 2) (κ i y)) *
          Real.sqrt (g.coeff (κ i) y).det) = fun y => ε₀ * (χ i (κ i y) *
          S.indicator (fun p => u p ^ 2) (κ i y) * Real.sqrt (g.coeff (κ i) y).det) := by
        funext y; ring
      rw [e]
      exact Integrable.const_mul (hI2 i) ε₀
    have h1 := hcomp h g (2 * Real.sqrt 2) (fun p => V p * u p * u p)
      (fun p => ε₀ * S.indicator (fun p => u p ^ 2) p)
      (fun i y hy => (Pdet (κ i) y hy).1) hpt hI4
    rw [hscal g ε₀ (S.indicator (fun p => u p ^ 2))] at h1
    calc |atlasInt h κ χ (fun p => V p * u p * u p)|
        ≤ 2 * Real.sqrt 2 * (ε₀ * atlasInt g κ χ (S.indicator (fun p => u p ^ 2))) := h1
      _ ≤ 2 * Real.sqrt 2 * (ε₀ * (CS * (4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u)))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h4 hε₀.le) h22
      _ = 16 * ε₀ * CS * atlasInt h κ χ (h.gradInner u u) := by
          linear_combination (8 * ε₀ * CS * atlasInt h κ χ (h.gradInner u u)) * hs2
      _ ≤ (1 / 2) * atlasInt h κ χ (h.gradInner u u) := mul_le_mul_of_nonneg_right hK1 hDh
  
  
  
  · by_cases hM : IsEmpty M
    · rw [hempty hM h (fun p => F p * u p), hempty hM h (h.gradInner u u)]
      simp
    rw [not_isEmpty_iff] at hM
    obtain ⟨p₀⟩ := hM
    have hB : 0 ≤ B := (abs_nonneg _).trans (hFB p₀)
    have hstar : ∀ t : ℝ, 0 < t → |atlasInt h κ χ (fun p => F p * u p)| ≤
        Real.sqrt 2 * a * B * t + 8 * B * CS * atlasInt h κ χ (h.gradInner u u) / t := by
      intro t ht
      have h2t : 0 < 2 * t := by linarith
      have hpt : ∀ p, |F p * u p| ≤ B * t / 2 * S.indicator (fun _ => (1 : ℝ)) p +
          B / (2 * t) * S.indicator (fun p => u p ^ 2) p := by
        intro p
        by_cases hp : p ∈ S
        · simp only [Set.indicator_of_mem hp, mul_one]
          rw [abs_mul]
          have hu2 : |u p| ≤ t / 2 + u p ^ 2 / (2 * t) := by
            have e : t / 2 + u p ^ 2 / (2 * t) = (t ^ 2 + u p ^ 2) / (2 * t) := by
              first
              | (field_simp; ring)
              | field_simp
            rw [e, le_div_iff₀ h2t]
            nlinarith [sq_nonneg (|u p| - t), sq_abs (u p)]
          calc |F p| * |u p| ≤ B * |u p| := mul_le_mul_of_nonneg_right (hFB p) (abs_nonneg _)
            _ ≤ B * (t / 2 + u p ^ 2 / (2 * t)) := mul_le_mul_of_nonneg_left hu2 hB
            _ = B * t / 2 + B / (2 * t) * u p ^ 2 := by ring
        · simp only [Set.indicator_of_notMem hp, hFS p hp, zero_mul, abs_zero, mul_zero,
            add_zero, le_refl]
      have hL := hlinEq g (B * t / 2) (B / (2 * t)) (S.indicator (fun _ => (1 : ℝ)))
        (S.indicator (fun p => u p ^ 2)) hI3 hI2
      have h1 := hcomp h g (2 * Real.sqrt 2) (fun p => F p * u p)
        (fun p => B * t / 2 * S.indicator (fun _ => (1 : ℝ)) p +
          B / (2 * t) * S.indicator (fun p => u p ^ 2) p)
        (fun i y hy => (Pdet (κ i) y hy).1) hpt hL.1
      rw [hL.2, ← ha_def] at h1
      have hb0 : 0 ≤ B / (2 * t) := div_nonneg hB h2t.le
      calc |atlasInt h κ χ (fun p => F p * u p)|
          ≤ 2 * Real.sqrt 2 * (B * t / 2 * a +
              B / (2 * t) * atlasInt g κ χ (S.indicator (fun p => u p ^ 2))) := h1
        _ ≤ 2 * Real.sqrt 2 * (B * t / 2 * a +
              B / (2 * t) * (CS * (4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u)))) :=
            mul_le_mul_of_nonneg_left
              (add_le_add le_rfl (mul_le_mul_of_nonneg_left h4 hb0)) h22
        _ = Real.sqrt 2 * a * B * t + 8 * B * CS * atlasInt h κ χ (h.gradInner u u) / t := by
            linear_combination (4 * B * CS * atlasInt h κ χ (h.gradInner u u) / t) * hs2
    by_cases hY : 0 < atlasInt h κ χ (h.gradInner u u)
    · have hYs : 0 < Real.sqrt (atlasInt h κ χ (h.gradInner u u)) := Real.sqrt_pos.2 hY
      have hsq : Real.sqrt (atlasInt h κ χ (h.gradInner u u)) *
          Real.sqrt (atlasInt h κ χ (h.gradInner u u)) = atlasInt h κ χ (h.gradInner u u) :=
        Real.mul_self_sqrt hDh
      have h1 := hstar _ hYs
      have e : 8 * B * CS * atlasInt h κ χ (h.gradInner u u) /
          Real.sqrt (atlasInt h κ χ (h.gradInner u u)) =
          8 * B * CS * Real.sqrt (atlasInt h κ χ (h.gradInner u u)) := by
        rw [div_eq_iff hYs.ne']
        linear_combination (-(8 * B * CS)) * hsq
      rw [e] at h1
      calc |atlasInt h κ χ (fun p => F p * u p)|
          ≤ Real.sqrt 2 * a * B * Real.sqrt (atlasInt h κ χ (h.gradInner u u)) +
            8 * B * CS * Real.sqrt (atlasInt h κ χ (h.gradInner u u)) := h1
        _ = (Real.sqrt 2 * a + 8 * CS) * B * Real.sqrt (atlasInt h κ χ (h.gradInner u u)) := by
            ring
    · have hD0 : atlasInt h κ χ (h.gradInner u u) = 0 := le_antisymm (not_lt.1 hY) hDh
      rw [hD0, Real.sqrt_zero, mul_zero]
      by_contra hX
      push_neg at hX
      have hk : 0 ≤ Real.sqrt 2 * a * B := mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) ha) hB
      have hne : 2 * (Real.sqrt 2 * a * B + 1) ≠ 0 := by linarith
      have htpos : 0 < |atlasInt h κ χ (fun p => F p * u p)| / (2 * (Real.sqrt 2 * a * B + 1)) :=
        div_pos hX (by linarith)
      have h1 := hstar _ htpos
      rw [hD0, mul_zero, zero_div, add_zero] at h1
      have ht2 := div_mul_cancel₀ (|atlasInt h κ χ (fun p => F p * u p)|) hne
      have hkt := mul_nonneg hk htpos.le
      nlinarith

theorem cceb_inv_quad_lower (G : Matrix (Fin 3) (Fin 3) ℝ) (hG : G.PosDef) (v : Fin 3 → ℝ) :
    ∑ i : Fin 3, v i ^ 2 ≤
      (∑ i : Fin 3, ∑ j : Fin 3, |G i j|) * ∑ i : Fin 3, ∑ j : Fin 3, G⁻¹ i j * v i * v j :=
by
  have hdet : IsUnit G.det := hG.det_pos.ne'.isUnit
  obtain ⟨w, hw⟩ : ∃ w : Fin 3 → ℝ, w = G⁻¹.mulVec v := ⟨_, rfl⟩
  have hGw : G.mulVec w = v := by
    rw [hw, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv G hdet, Matrix.one_mulVec]
  have hv : ∀ i, v i = ∑ j : Fin 3, G i j * w j := fun i => (congrFun hGw i).symm
  have hwi : ∀ i, w i = ∑ j : Fin 3, G⁻¹ i j * v j := fun i => by rw [hw]; rfl
  have hQ : ∑ i : Fin 3, ∑ j : Fin 3, G⁻¹ i j * v i * v j =
      ∑ k : Fin 3, ∑ l : Fin 3, G k l * w k * w l := by
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3, G⁻¹ i j * v i * v j = ∑ i : Fin 3, v i * w i := by
      simp only [hwi, Fin.sum_univ_three]; ring
    rw [e1]
    simp only [hv, Fin.sum_univ_three]; ring
  rw [hQ]
  have hsym : ∀ k l : Fin 3, G l k = G k l := fun k l => by
    simpa using hG.isHermitian.apply k l
  have s10 : G 1 0 = G 0 1 := hsym 0 1
  have s20 : G 2 0 = G 0 2 := hsym 0 2
  have s21 : G 2 1 = G 1 2 := hsym 1 2
  have hpsd : ∀ x y z : ℝ, 0 ≤ G 0 0 * x * x + G 0 1 * x * y + G 0 2 * x * z
      + G 0 1 * y * x + G 1 1 * y * y + G 1 2 * y * z
      + G 0 2 * z * x + G 1 2 * z * y + G 2 2 * z * z := by
    intro x y z
    have h := hG.posSemidef.dotProduct_mulVec_nonneg ![x, y, z]
    refine h.trans_eq ?_
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three, s10, s20, s21,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons]
    ring
  have hv0 : v 0 = G 0 0 * w 0 + G 0 1 * w 1 + G 0 2 * w 2 := by
    rw [hv 0]; simp only [Fin.sum_univ_three]
  have hv1 : v 1 = G 0 1 * w 0 + G 1 1 * w 1 + G 1 2 * w 2 := by
    rw [hv 1]; simp only [Fin.sum_univ_three, s10]
  have hv2 : v 2 = G 0 2 * w 0 + G 1 2 * w 1 + G 2 2 * w 2 := by
    rw [hv 2]; simp only [Fin.sum_univ_three, s20, s21]
  obtain ⟨Q, hQdef⟩ : ∃ Q : ℝ, Q = G 0 0 * w 0 * w 0 + G 0 1 * w 0 * w 1 + G 0 2 * w 0 * w 2
      + G 0 1 * w 1 * w 0 + G 1 1 * w 1 * w 1 + G 1 2 * w 1 * w 2
      + G 0 2 * w 2 * w 0 + G 1 2 * w 2 * w 1 + G 2 2 * w 2 * w 2 := ⟨_, rfl⟩
  have hQe : ∑ k : Fin 3, ∑ l : Fin 3, G k l * w k * w l = Q := by
    rw [hQdef]; simp only [Fin.sum_univ_three, s10, s20, s21]; ring
  rw [hQe]
  have hQ0 : 0 ≤ Q := by rw [hQdef]; exact hpsd (w 0) (w 1) (w 2)
  have ha0 : 0 < G 0 0 := hG.diag_pos
  have ha1 : 0 < G 1 1 := hG.diag_pos
  have ha2 : 0 < G 2 2 := hG.diag_pos
  have k0 : 0 ≤ G 0 0 * (G 0 0 * Q - v 0 ^ 2) := by
    have h0 := hpsd (G 0 0 * w 0 - v 0) (G 0 0 * w 1) (G 0 0 * w 2)
    rw [hv0] at h0 ⊢
    rw [hQdef]
    exact h0.trans_eq (by ring)
  have k1 : 0 ≤ G 1 1 * (G 1 1 * Q - v 1 ^ 2) := by
    have h1 := hpsd (G 1 1 * w 0) (G 1 1 * w 1 - v 1) (G 1 1 * w 2)
    rw [hv1] at h1 ⊢
    rw [hQdef]
    exact h1.trans_eq (by ring)
  have k2 : 0 ≤ G 2 2 * (G 2 2 * Q - v 2 ^ 2) := by
    have h2 := hpsd (G 2 2 * w 0) (G 2 2 * w 1) (G 2 2 * w 2 - v 2)
    rw [hv2] at h2 ⊢
    rw [hQdef]
    exact h2.trans_eq (by ring)
  have r0 : v 0 ^ 2 ≤ G 0 0 * Q := by
    have := (mul_nonneg_iff_of_pos_left ha0).1 k0
    linarith
  have r1 : v 1 ^ 2 ≤ G 1 1 * Q := by
    have := (mul_nonneg_iff_of_pos_left ha1).1 k1
    linarith
  have r2 : v 2 ^ 2 ≤ G 2 2 * Q := by
    have := (mul_nonneg_iff_of_pos_left ha2).1 k2
    linarith
  obtain ⟨S, hSdef⟩ : ∃ S : ℝ, S = ∑ i : Fin 3, ∑ j : Fin 3, |G i j| := ⟨_, rfl⟩
  rw [← hSdef]
  have htr : G 0 0 + G 1 1 + G 2 2 ≤ S := by
    rw [hSdef]
    simp only [Fin.sum_univ_three]
    linarith [le_abs_self (G 0 0), le_abs_self (G 1 1), le_abs_self (G 2 2),
      abs_nonneg (G 0 1), abs_nonneg (G 0 2), abs_nonneg (G 1 0), abs_nonneg (G 1 2),
      abs_nonneg (G 2 0), abs_nonneg (G 2 1)]
  have hm := mul_le_mul_of_nonneg_right htr hQ0
  simp only [Fin.sum_univ_three]
  nlinarith [hm, r0, r1, r2]

theorem cceb_localize_lower_ind [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hAF : AsymptoticallyFlat g) (ρA : ℝ) {n : ℕ}
    (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (L : Set E3) (hL : IsCompact L) (hLψ : L ⊆ ψ.source) (G : M → ℝ)
    (hG : ∀ ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => G (ψ' y)) ψ'.source)
    (hG0 : ∀ p, 0 ≤ G p) (K : Set M) (hK : IsCompact K) (hGK : ∀ p, p ∉ K → G p = 0)
    (C : Set M) (hC : IsClosed C) :
    ∫ y in L, C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
      atlasInt g κ χ (C.indicator G) :=
by
  classical
  obtain ⟨hρA, hχs, hχ0, hχ1, hχt, hcase⟩ := hA
  
  have hexp : ∀ v : E3, v = ∑ a : Fin 3, v a • e a := by
    intro v
    have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v
    simpa using this.symm
  have hexpB : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hexp w1, ← hexp w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  
  have hD : ∀ φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      ContinuousOn (fun y => Real.sqrt (g.coeff φ y).det) φ.source := by
    intro φ
    have hGc : ContinuousOn (g.coeff φ) φ.source :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c =>
        (coeff_contDiffOn_source g φ a c).continuousOn
    exact Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hGc)
  
  have hfar : ∀ j : Fin hAF.numEnds, ∃ R : ℝ, ∀ y : E3, R < ‖y‖ → (hAF.ends j).Φ y ∉ K := by
    intro j
    obtain ⟨ρ₀, hρ₀, hcl⟩ := endChart_far_isClosed g hAF j
    let O : ℕ → Set M := fun m => ((hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖})ᶜ
    have hOo : ∀ m, IsOpen (O m) := fun m =>
      (hcl _ (le_add_of_nonneg_right (Nat.cast_nonneg m))).isOpen_compl
    have hOmono : Monotone O := by
      intro m m' hmm' p hp
      simp only [O, Set.mem_compl_iff] at hp ⊢
      intro hp'
      apply hp
      obtain ⟨z, hz, hzp⟩ := hp'
      refine ⟨z, ?_, hzp⟩
      have h1 : (m : ℝ) ≤ m' := Nat.cast_le.2 hmm'
      have h2 : ρ₀ + (m' : ℝ) ≤ ‖z‖ := hz
      show ρ₀ + (m : ℝ) ≤ ‖z‖
      linarith
    have hcovK : K ⊆ ⋃ m, O m := by
      intro p _
      by_contra hne
      have hmem : ∀ m : ℕ, p ∈ (hAF.ends j).Φ '' {x : E3 | ρ₀ + (m : ℝ) ≤ ‖x‖} := fun m =>
        Classical.byContradiction fun h => hne (Set.mem_iUnion.2 ⟨m, h⟩)
      obtain ⟨z₀, hz₀, hpz₀⟩ := hmem 0
      obtain ⟨m, hm⟩ := exists_nat_gt (‖z₀‖ - ρ₀)
      obtain ⟨z₁, hz₁, hpz₁⟩ := hmem m
      have h0 : ρ₀ + ((0 : ℕ) : ℝ) ≤ ‖z₀‖ := hz₀
      have h1 : ρ₀ + (m : ℝ) ≤ ‖z₁‖ := hz₁
      simp only [Nat.cast_zero, add_zero] at h0
      have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
      have hz₀s : z₀ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₀‖; linarith
      have hz₁s : z₁ ∈ (hAF.ends j).Φ.source := by
        rw [(hAF.ends j).source_eq]; show (1 : ℝ) < ‖z₁‖; linarith
      have heq : z₀ = z₁ :=
        (hAF.ends j).Φ.toPartialEquiv.injOn hz₀s hz₁s (hpz₀.trans hpz₁.symm)
      rw [← heq] at h1
      linarith
    obtain ⟨N, hN⟩ := hK.elim_directed_cover O hOo hcovK hOmono.directed_le
    refine ⟨ρ₀ + N, fun y hy hyK => hN hyK ⟨y, ?_, rfl⟩⟩
    show ρ₀ + (N : ℝ) ≤ ‖y‖
    linarith
  have hH : ∀ i, ContinuousOn
      (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det) (κ i).source := by
    intro i
    exact (((hχs i).continuous.comp_continuousOn
      (κ i).contMDiffOn_toFun.continuousOn).mul (hG (κ i))).mul (hD (κ i))
  
  have hZ : ∀ i, ∃ Z : Set E3, IsCompact Z ∧ Z ⊆ (κ i).source ∧
      ∀ y ∈ (κ i).source, y ∉ Z →
        χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det = 0 := by
    intro i
    rcases hcase i with hc | ⟨j, hκ, -, h0⟩
    · refine ⟨(κ i).toPartialEquiv.symm '' tsupport (χ i), ?_, ?_, ?_⟩
      · exact hc.image_of_continuousOn
          ((κ i).toOpenPartialHomeomorph.continuousOn_symm.mono (hχt i))
      · rintro _ ⟨x, hx, rfl⟩
        exact (κ i).toPartialEquiv.map_target (hχt i hx)
      · intro y hy hyZ
        have hns : κ i y ∉ tsupport (χ i) := by
          intro hmem
          exact hyZ ⟨κ i y, hmem, (κ i).toPartialEquiv.left_inv hy⟩
        rw [image_eq_zero_of_notMem_tsupport hns, zero_mul, zero_mul]
    · obtain ⟨R, hR⟩ := hfar j
      refine ⟨{y : E3 | ρA ≤ ‖y‖} ∩ {y : E3 | ‖y‖ ≤ max R ρA}, ?_, ?_, ?_⟩
      · refine (isCompact_closedBall (0 : E3) (max R ρA)).of_isClosed_subset
          ((isClosed_le continuous_const continuous_norm).inter
            (isClosed_le continuous_norm continuous_const)) ?_
        intro y hy
        rw [mem_closedBall_zero_iff]
        exact hy.2
      · intro y hy
        have h1 : ρA ≤ ‖y‖ := hy.1
        rw [hκ, (hAF.ends j).source_eq]
        show (1 : ℝ) < ‖y‖
        linarith
      · intro y hy hyZ
        rw [hκ] at hy ⊢
        have hy1 : (1 : ℝ) < ‖y‖ := by
          have h2 := hy
          rw [(hAF.ends j).source_eq] at h2
          exact h2
        by_cases hle : ‖y‖ ≤ ρA
        · rw [h0 y hy1 hle, zero_mul, zero_mul]
        · have hgt : max R ρA < ‖y‖ := by
            by_contra hc'
            exact hyZ ⟨le_of_lt (not_le.1 hle), not_lt.1 hc'⟩
          rw [hGK _ (hR y (lt_of_le_of_lt (le_max_left _ _) hgt)), mul_zero, zero_mul]
  
  have hInt : ∀ i, IntegrableOn
      (fun y => χ i (κ i y) * C.indicator G (κ i y) * Real.sqrt (g.coeff (κ i) y).det)
      (κ i).source := by
    intro i
    obtain ⟨Z, hZc, hZS, hZ0⟩ := hZ i
    have h1 : IntegrableOn
        (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (g.coeff (κ i) y).det) (κ i).source :=
      (((hH i).mono hZS).integrableOn_compact hZc).of_forall_diff_eq_zero
        (κ i).open_source.measurableSet (fun y hy => hZ0 y hy.1 hy.2)
    have hmeas : MeasurableSet ((κ i).source ∩ κ i ⁻¹' C) := by
      have hopen : IsOpen ((κ i).source ∩ κ i ⁻¹' Cᶜ) :=
        (κ i).contMDiffOn_toFun.continuousOn.isOpen_inter_preimage (κ i).open_source
          hC.isOpen_compl
      have heq : (κ i).source ∩ κ i ⁻¹' C = (κ i).source \ ((κ i).source ∩ κ i ⁻¹' Cᶜ) := by
        ext y
        simp only [Set.mem_inter_iff, Set.mem_diff, Set.mem_preimage, Set.mem_compl_iff]
        tauto
      rw [heq]
      exact (κ i).open_source.measurableSet.diff hopen.measurableSet
    refine (h1.indicator hmeas).congr_fun ?_ (κ i).open_source.measurableSet
    intro y hy
    by_cases hc : κ i y ∈ C
    · simp [Set.indicator_apply, hy, hc]
    · simp [Set.indicator_apply, hy, hc]
  
  have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
  have hL'c : IsClosed (L ∩ ψ ⁻¹' C) :=
    (hψc.mono hLψ).preimage_isClosed_of_isClosed hL.isClosed hC
  have hL'k : IsCompact (L ∩ ψ ⁻¹' C) := hL.of_isClosed_subset hL'c Set.inter_subset_left
  have hL'm : MeasurableSet (L ∩ ψ ⁻¹' C) := hL'c.measurableSet
  have hL'ψ : L ∩ ψ ⁻¹' C ⊆ ψ.source := fun y hy => hLψ hy.1
  have hs1 : ∫ y in L, C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det =
      ∫ y in L ∩ ψ ⁻¹' C, C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hL.isClosed.measurableSet
      Set.inter_subset_left ?_
    rintro y ⟨hyL, hyn⟩
    have hyC : ψ y ∉ C := fun h => hyn ⟨hyL, h⟩
    simp only [Set.indicator_of_notMem hyC, zero_mul]
  
  have hfi : ∀ i, IntegrableOn
      (fun y => χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det)
      (L ∩ ψ ⁻¹' C) := by
    intro i
    have h : IntegrableOn
        (fun y => χ i (ψ y) * G (ψ y) * Real.sqrt (g.coeff ψ y).det) (L ∩ ψ ⁻¹' C) :=
      (((((hχs i).continuous.comp_continuousOn hψc).mul (hG ψ)).mul (hD ψ)).mono
        hL'ψ).integrableOn_compact hL'k
    refine h.congr_fun (fun y hy => ?_) hL'm
    simp only [Set.indicator_of_mem (show ψ y ∈ C from hy.2)]
  
  have key : ∀ i, ∫ y in L ∩ ψ ⁻¹' C,
      χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det ≤
      ∫ z in (κ i).source,
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det := by
    intro i
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set E3, Ω = ψ.source ∩ ψ ⁻¹' (κ i).target := ⟨_, rfl⟩
    have hΩmem : ∀ y, y ∈ Ω ↔ y ∈ ψ.source ∧ ψ y ∈ (κ i).target := by
      intro y; rw [hΩ]; rfl
    have hΩo : IsOpen Ω := by
      rw [hΩ]
      exact ψ.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage ψ.open_source
        (κ i).open_target
    obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun y => (κ i).toPartialEquiv.symm (ψ y) := ⟨_, rfl⟩
    have hτsm : ContDiffOn ℝ ∞ τ Ω := by
      rw [hτ, hΩ]
      exact contMDiffOn_iff_contDiffOn.mp (ContMDiffOn.comp (κ i).contMDiffOn_invFun
        (ψ.contMDiffOn_toFun.mono Set.inter_subset_left) (fun y hy => hy.2))
    have hτd : ∀ y ∈ Ω, DifferentiableAt ℝ τ y := fun y hy =>
      (hτsm.differentiableOn (by simp)).differentiableAt (hΩo.mem_nhds hy)
    have hκτ : ∀ y ∈ Ω, κ i (τ y) = ψ y := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.right_inv ((hΩmem y).1 hy).2
    have hτmem : ∀ y ∈ Ω, τ y ∈ (κ i).source := by
      intro y hy
      rw [hτ]
      exact (κ i).toPartialEquiv.map_target ((hΩmem y).1 hy).2
    
    have hjac : ∀ y ∈ Ω, Real.sqrt (g.coeff ψ y).det =
        |(fderiv ℝ τ y).det| * Real.sqrt (g.coeff (κ i) (τ y)).det := by
      intro y hy
      have hmdκ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) :=
        ((κ i).contMDiffOn_toFun.contMDiffAt
          ((κ i).open_source.mem_nhds (hτmem y hy))).mdifferentiableAt (by simp)
      have hmdτ : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) τ y := (hτd y hy).mdifferentiableAt
      have heq : (ψ : E3 → M) =ᶠ[𝓝 y] (κ i) ∘ τ := by
        filter_upwards [hΩo.mem_nhds hy] with z hz
        exact (hκτ z hz).symm
      have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y =
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)).comp (fderiv ℝ τ y) := by
        rw [heq.mfderiv_eq, mfderiv_comp y hmdκ hmdτ, mfderiv_eq_fderiv]
      obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin 3) (Fin 3) ℝ,
          J = Matrix.of fun a b => fderiv ℝ τ y (e b) a := ⟨_, rfl⟩
      have hcoeff : g.coeff ψ y = J.transpose * g.coeff (κ i) (τ y) * J := by
        ext a b
        have hl : g.coeff ψ y a b = g.g (ψ y)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e a)))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) (fderiv ℝ τ y (e b))) := by
          show g.g (ψ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y (e b)) = _
          rw [hmf]
          rfl
        have hr : ∀ a' b' : Fin 3, g.coeff (κ i) (τ y) a' b' =
            (g.g (ψ y) : E3 →L[ℝ] E3 →L[ℝ] ℝ)
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e a'))
              ((mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y) : E3 →L[ℝ] E3) (e b')) := by
          intro a' b'
          show g.g (κ i (τ y)) _ _ = _
          rw [hκτ y hy]
          try rfl
        have hl2 : g.coeff ψ y a b = ∑ a' : Fin 3, ∑ b' : Fin 3,
            fderiv ℝ τ y (e a) a' * fderiv ℝ τ y (e b) b' * g.coeff (κ i) (τ y) a' b' := by
          rw [hl]
          refine (hexpB (g.g (ψ y)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (κ i) (τ y)) _ _).trans ?_
          refine Finset.sum_congr rfl fun a' _ => Finset.sum_congr rfl fun b' _ => ?_
          exact congrArg _ (hr a' b').symm
        rw [hl2]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, hJ, Matrix.of_apply,
          Fin.sum_univ_three]
        ring
      have hdetJ : J.det = (fderiv ℝ τ y).det := by
        show J.det = LinearMap.det ((fderiv ℝ τ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
        congr 1
        try (ext a b; rw [hJ, LinearMap.toMatrix_apply]; simp)
      rw [hcoeff, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hdetJ]
      rw [show (fderiv ℝ τ y).det * (g.coeff (κ i) (τ y)).det * (fderiv ℝ τ y).det =
          (fderiv ℝ τ y).det ^ 2 * (g.coeff (κ i) (τ y)).det by ring]
      rw [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs]
    
    have hEm : MeasurableSet ((L ∩ ψ ⁻¹' C) ∩ Ω) := hL'm.inter hΩo.measurableSet
    have hEΩ : (L ∩ ψ ⁻¹' C) ∩ Ω ⊆ Ω := Set.inter_subset_right
    have hτinj : Set.InjOn τ ((L ∩ ψ ⁻¹' C) ∩ Ω) := by
      intro y₁ hy₁ y₂ hy₂ h
      have h' : ψ y₁ = ψ y₂ := by
        rw [← hκτ y₁ (hEΩ hy₁), ← hκτ y₂ (hEΩ hy₂), h]
      exact ψ.toPartialEquiv.injOn ((hΩmem y₁).1 (hEΩ hy₁)).1 ((hΩmem y₂).1 (hEΩ hy₂)).1 h'
    
    have hr1 : ∫ y in L ∩ ψ ⁻¹' C,
        χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det =
        ∫ y in (L ∩ ψ ⁻¹' C) ∩ Ω,
        χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hL'm Set.inter_subset_left ?_
      rintro y ⟨hyL', hyE⟩
      have hyΩ : y ∉ Ω := fun h => hyE ⟨hyL', h⟩
      have hns : ψ y ∉ tsupport (χ i) := fun h => hyΩ ((hΩmem y).2 ⟨hL'ψ hyL', hχt i h⟩)
      simp only [image_eq_zero_of_notMem_tsupport hns, zero_mul]
    
    have hs4 : ∫ z in τ '' ((L ∩ ψ ⁻¹' C) ∩ Ω),
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det =
        ∫ y in (L ∩ ψ ⁻¹' C) ∩ Ω,
        χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      rw [integral_image_eq_integral_abs_det_fderiv_smul volume hEm
        (fun y hy => (hτd y (hEΩ hy)).hasFDerivAt.hasFDerivWithinAt) hτinj]
      refine setIntegral_congr_fun hEm (fun y hy => ?_)
      simp only [smul_eq_mul]
      rw [hκτ y (hEΩ hy), hjac y (hEΩ hy)]
      ring
    
    have hsub : τ '' ((L ∩ ψ ⁻¹' C) ∩ Ω) ⊆ (κ i).source := by
      rintro _ ⟨y, hy, rfl⟩
      exact hτmem y (hEΩ hy)
    have hmono : ∫ z in τ '' ((L ∩ ψ ⁻¹' C) ∩ Ω),
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det ≤
        ∫ z in (κ i).source,
        χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det :=
      setIntegral_mono_set (hInt i)
        (Filter.Eventually.of_forall fun z => mul_nonneg (mul_nonneg (hχ0 i _)
          (Set.indicator_nonneg (fun q _ => hG0 q) _)) (Real.sqrt_nonneg _))
        hsub.eventuallyLE
    rw [hr1, ← hs4]
    exact hmono
  
  have hpt : ∀ y, ∑ i, χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det =
      C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
    intro y
    rw [← Finset.sum_mul, ← Finset.sum_mul, hχ1, one_mul]
  unfold atlasInt
  rw [hs1]
  calc ∫ y in L ∩ ψ ⁻¹' C, C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det
      = ∫ y in L ∩ ψ ⁻¹' C, ∑ i,
          χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
        setIntegral_congr_fun hL'm (fun y _ => (hpt y).symm)
    _ = ∑ i, ∫ y in L ∩ ψ ⁻¹' C,
          χ i (ψ y) * C.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det :=
        integral_finset_sum Finset.univ fun i _ => hfi i
    _ ≤ ∑ i, ∫ z in (κ i).source,
          χ i (κ i z) * C.indicator G (κ i z) * Real.sqrt (g.coeff (κ i) z).det :=
        Finset.sum_le_sum fun i _ => key i

theorem cls_chart_energy_bound [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (L : Set E3) (hL : IsCompact L) (hLψ : L ⊆ ψ.source) (CT : ℝ) (hCT : 0 ≤ CT)
    (hP : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      atlasInt g κ χ ((ψ '' L).indicator (fun p => u p ^ 2)) ≤
        CT * atlasInt g κ χ (g.gradInner u u)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v → HasCompactSupport v →
      ∫ y in L, ((u (ψ y) - v (ψ y)) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (fun z => u (ψ z)) y - partialDeriv i (fun z => v (ψ z)) y) ^ 2) ≤
        C * atlasInt g κ χ (g.gradInner (u - v) (u - v)) :=
by
  classical
  have hLm : MeasurableSet L := hL.measurableSet
  have hsrc : IsOpen ψ.source := ψ.open_source
  
  have hred : ∃ C : ℝ, 0 ≤ C ∧ ∀ w : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w →
      HasCompactSupport w →
      ∫ y in L, ((w (ψ y)) ^ 2 + ∑ i : Fin 3, (partialDeriv i (fun z => w (ψ z)) y) ^ 2) ≤
        C * atlasInt g κ χ (g.gradInner w w) := by
    rcases L.eq_empty_or_nonempty with hLe | hLne
    · refine ⟨0, le_refl 0, fun w _ _ => ?_⟩
      rw [hLe]
      simp
    
    have hδc : ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source :=
      (nds_chart_cont g ψ (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ)) contMDiff_const
        contMDiff_const).2.2.2.1
    obtain ⟨y₀, hy₀L, hy₀min⟩ := hL.exists_isMinOn hLne (hδc.mono hLψ)
    obtain ⟨m₀, hm₀def⟩ : ∃ m₀ : ℝ, m₀ = Real.sqrt (g.coeff ψ y₀).det := ⟨_, rfl⟩
    have hm₀ : 0 < m₀ := by
      rw [hm₀def]; exact Real.sqrt_pos.2 (coeff_posDef g ψ y₀ (hLψ hy₀L)).det_pos
    have hδm : ∀ y ∈ L, m₀ ≤ Real.sqrt (g.coeff ψ y).det := by
      intro y hy; rw [hm₀def]; exact isMinOn_iff.mp hy₀min y hy
    
    have hf₂c : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, |g.coeff ψ y i j|) ψ.source :=
      continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        (coeff_contDiffOn_source g ψ i j).continuousOn.abs
    obtain ⟨B, hB⟩ := hL.exists_bound_of_continuousOn (hf₂c.mono hLψ)
    obtain ⟨Mx, hMxdef⟩ : ∃ Mx : ℝ, Mx = max B 0 := ⟨_, rfl⟩
    have hMx : 0 ≤ Mx := by rw [hMxdef]; exact le_max_right _ _
    have hf₂le : ∀ y ∈ L, ∑ i : Fin 3, ∑ j : Fin 3, |g.coeff ψ y i j| ≤ Mx := by
      intro y hy
      have h1 := hB y hy
      rw [Real.norm_eq_abs] at h1
      rw [hMxdef]
      exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
    
    have hTc : IsClosed (ψ '' L) :=
      (hL.image_of_continuousOn (ψ.contMDiffOn_toFun.continuousOn.mono hLψ)).isClosed
    refine ⟨(CT + Mx) / m₀, div_nonneg (add_nonneg hCT hMx) hm₀.le, fun w hw hwc => ?_⟩
    obtain ⟨hW, hdW, hq, -, -⟩ := nds_chart_cont g ψ w w hw hw
    have hfacts := cceb_gradInner_self_facts g w hw
    
    have hI1 : IntegrableOn (fun y => (w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) L :=
      ContinuousOn.integrableOn_compact hL (((hW.continuousOn.pow 2).mul hδc).mono hLψ)
    have hI2 : IntegrableOn
        (fun y => g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det) L :=
      ContinuousOn.integrableOn_compact hL ((hq.mul hδc).mono hLψ)
    have hI0 : IntegrableOn (fun y => (w (ψ y)) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (fun z => w (ψ z)) y) ^ 2) L :=
      ContinuousOn.integrableOn_compact hL
        (((hW.continuousOn.pow 2).add (continuousOn_finset_sum _ fun i _ => (hdW i).pow 2)).mono
          hLψ)
    
    have hpt : ∀ y ∈ L, (w (ψ y)) ^ 2 + ∑ i : Fin 3, (partialDeriv i (fun z => w (ψ z)) y) ^ 2 ≤
        m₀⁻¹ * ((w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) +
          Mx / m₀ * (g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det) := by
      intro y hy
      have hyS := hLψ hy
      have hδy := hδm y hy
      have hratio : 1 ≤ m₀⁻¹ * Real.sqrt (g.coeff ψ y).det := by
        rw [← div_eq_inv_mul, le_div_iff₀ hm₀]; linarith
      have hq0 : 0 ≤ g.gradInner w w (ψ y) := hfacts.1 _
      have hform := gradInner_pdiffeo_formula g ψ w w hw hw y hyS
      have hs2 : ∑ i : Fin 3, (partialDeriv i (fun z => w (ψ z)) y) ^ 2 ≤
          (∑ i : Fin 3, ∑ j : Fin 3, |g.coeff ψ y i j|) * g.gradInner w w (ψ y) := by
        rw [hform]
        exact cceb_inv_quad_lower (g.coeff ψ y) (coeff_posDef g ψ y hyS)
          (fun i => partialDeriv i (fun z => w (ψ z)) y)
      have hA1 : (w (ψ y)) ^ 2 ≤ m₀⁻¹ * ((w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) := by
        calc (w (ψ y)) ^ 2 = (w (ψ y)) ^ 2 * 1 := by ring
          _ ≤ (w (ψ y)) ^ 2 * (m₀⁻¹ * Real.sqrt (g.coeff ψ y).det) :=
            mul_le_mul_of_nonneg_left hratio (sq_nonneg _)
          _ = m₀⁻¹ * ((w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) := by ring
      have hA2 : ∑ i : Fin 3, (partialDeriv i (fun z => w (ψ z)) y) ^ 2 ≤
          Mx / m₀ * (g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det) := by
        calc ∑ i : Fin 3, (partialDeriv i (fun z => w (ψ z)) y) ^ 2
            ≤ (∑ i : Fin 3, ∑ j : Fin 3, |g.coeff ψ y i j|) * g.gradInner w w (ψ y) := hs2
          _ ≤ Mx * g.gradInner w w (ψ y) := mul_le_mul_of_nonneg_right (hf₂le y hy) hq0
          _ = Mx * g.gradInner w w (ψ y) * 1 := by ring
          _ ≤ Mx * g.gradInner w w (ψ y) * (m₀⁻¹ * Real.sqrt (g.coeff ψ y).det) :=
            mul_le_mul_of_nonneg_left hratio (mul_nonneg hMx hq0)
          _ = Mx / m₀ * (g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det) := by ring
      linarith
    
    have hmono : ∫ y in L, ((w (ψ y)) ^ 2 + ∑ i : Fin 3,
          (partialDeriv i (fun z => w (ψ z)) y) ^ 2) ≤
        ∫ y in L, (m₀⁻¹ * ((w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) +
          Mx / m₀ * (g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det)) :=
      setIntegral_mono_on hI0
        ((Integrable.const_mul hI1 m₀⁻¹).add (Integrable.const_mul hI2 (Mx / m₀))) hLm hpt
    have hsplit : ∫ y in L, (m₀⁻¹ * ((w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) +
          Mx / m₀ * (g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det)) =
        m₀⁻¹ * (∫ y in L, (w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det) +
          Mx / m₀ * (∫ y in L, g.gradInner w w (ψ y) * Real.sqrt (g.coeff ψ y).det) := by
      rw [integral_add (Integrable.const_mul hI1 _) (Integrable.const_mul hI2 _),
        integral_const_mul, integral_const_mul]
    
    have hloc1 := cceb_localize_lower_ind g hAF ρA κ χ hA ψ L hL hLψ (fun p => w p ^ 2)
      (fun ψ' => (nds_chart_cont g ψ' w w hw hw).1.continuousOn.pow 2)
      (fun p => sq_nonneg _) (tsupport w) hwc.isCompact
      (fun p hp => by
        show w p ^ 2 = 0
        rw [image_eq_zero_of_notMem_tsupport hp]; ring) (ψ '' L) hTc
    have hE1 : ∫ y in L, (w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det =
        ∫ y in L, (ψ '' L).indicator (fun p => w p ^ 2) (ψ y) * Real.sqrt (g.coeff ψ y).det := by
      refine setIntegral_congr_fun hLm (fun y hy => ?_)
      have hmem : ψ y ∈ ψ '' L := ⟨y, hy, rfl⟩
      simp only [Set.indicator_of_mem hmem]
    have hL2 : ∫ y in L, (w (ψ y)) ^ 2 * Real.sqrt (g.coeff ψ y).det ≤
        CT * atlasInt g κ χ (g.gradInner w w) := by
      rw [hE1]; exact hloc1.trans (hP w hw hwc)
    
    have hloc2 := cceb_localize_lower_ind g hAF ρA κ χ hA ψ L hL hLψ (g.gradInner w w)
      (fun ψ' => (nds_chart_cont g ψ' w w hw hw).2.2.1) hfacts.1 (tsupport w) hwc.isCompact
      hfacts.2 Set.univ isClosed_univ
    simp only [Set.indicator_univ] at hloc2
    
    have hc1 : 0 ≤ m₀⁻¹ := inv_nonneg.2 hm₀.le
    have hc2 : 0 ≤ Mx / m₀ := div_nonneg hMx hm₀.le
    have k1 := mul_le_mul_of_nonneg_left hL2 hc1
    have k2 := mul_le_mul_of_nonneg_left hloc2 hc2
    have hfin : (CT + Mx) / m₀ * atlasInt g κ χ (g.gradInner w w) =
        m₀⁻¹ * (CT * atlasInt g κ χ (g.gradInner w w)) +
          Mx / m₀ * atlasInt g κ χ (g.gradInner w w) := by ring
    rw [hfin]
    linarith
  
  obtain ⟨C, hC, hCw⟩ := hred
  refine ⟨C, hC, fun u v hu hus hv hvs => ?_⟩
  have h1 := hCw (u - v) (hu.sub hv) (hus.sub hvs)
  refine le_trans (le_of_eq ?_) h1
  refine setIntegral_congr_fun hLm (fun y hy => ?_)
  have hyU : y ∈ ψ.source := hLψ hy
  have hU := (nds_chart_cont g ψ u u hu hu).1
  have hV := (nds_chart_cont g ψ v v hv hv).1
  have hdU : DifferentiableAt ℝ (fun z => u (ψ z)) y :=
    (hU.differentiableOn (by simp)).differentiableAt (hsrc.mem_nhds hyU)
  have hdV : DifferentiableAt ℝ (fun z => v (ψ z)) y :=
    (hV.differentiableOn (by simp)).differentiableAt (hsrc.mem_nhds hyU)
  have hpd : ∀ i : Fin 3, partialDeriv i (fun z => u (ψ z) - v (ψ z)) y =
      partialDeriv i (fun z => u (ψ z)) y - partialDeriv i (fun z => v (ψ z)) y := by
    intro i
    unfold partialDeriv
    have hfd : fderiv ℝ (fun z => u (ψ z) - v (ψ z)) y =
        fderiv ℝ (fun z => u (ψ z)) y - fderiv ℝ (fun z => v (ψ z)) y :=
      (hdU.hasFDerivAt.sub hdV.hasFDerivAt).fderiv
    rw [hfd]
    rfl
  simp only [Pi.sub_apply, hpd]

theorem cls_weak_form_chart [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (h : RiemannianMetric3 M) (V f : M → ℝ)
    (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ζ : E3 → ℝ)
    (hζ : ContDiff ℝ ∞ ζ) (hζc : HasCompactSupport ζ) (hζs : tsupport ζ ⊆ ψ.source) :
    ∃ φM : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φM ∧ HasCompactSupport φM ∧
      ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
        clsQ h κ χ V u φM - clsL h κ χ f φM =
          ∫ y, (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
                partialDeriv b (fun z => u (ψ z)) y * partialDeriv a ζ y
              + (V (ψ y) * u (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det :=
by
  classical
  
  have hKc : IsCompact (tsupport ζ) := hζc
  have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
  have hK'cpt : IsCompact (ψ '' tsupport ζ) := hKc.image_of_continuousOn (hψc.mono hζs)
  have hK'cl : IsClosed (ψ '' tsupport ζ) := hK'cpt.isClosed
  have hK'tgt : ψ '' tsupport ζ ⊆ ψ.target := by
    rintro _ ⟨y, hy, rfl⟩
    exact ψ.toPartialEquiv.map_source (hζs hy)
  
  obtain ⟨φM, hφMdef⟩ : ∃ φM : M → ℝ,
      φM = ψ.target.indicator (fun p => ζ (ψ.toPartialEquiv.symm p)) := ⟨_, rfl⟩
  have hφ0 : ∀ p, p ∉ ψ '' tsupport ζ → φM p = 0 := by
    intro p hp
    by_cases hpt : p ∈ ψ.target
    · rw [hφMdef, Set.indicator_of_mem hpt]
      apply image_eq_zero_of_notMem_tsupport
      intro hs
      exact hp ⟨_, hs, ψ.toPartialEquiv.right_inv hpt⟩
    · rw [hφMdef, Set.indicator_of_notMem hpt]
  have hφψ : ∀ y ∈ ψ.source, φM (ψ y) = ζ y := by
    intro y hy
    have hmem : ψ y ∈ ψ.target := ψ.toPartialEquiv.map_source hy
    rw [hφMdef, Set.indicator_of_mem hmem]
    exact congrArg ζ (ψ.toPartialEquiv.left_inv hy)
  have hφsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φM := by
    intro p
    by_cases hpt : p ∈ ψ.target
    · have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun q => ζ (ψ.toPartialEquiv.symm q))
          ψ.target :=
        hζ.contMDiff.comp_contMDiffOn ψ.contMDiffOn_invFun
      have h2 := h1.contMDiffAt (ψ.open_target.mem_nhds hpt)
      refine h2.congr_of_eventuallyEq ?_
      filter_upwards [ψ.open_target.mem_nhds hpt] with q hq
      rw [hφMdef, Set.indicator_of_mem hq]
    · have hpK : p ∉ ψ '' tsupport ζ := fun h' => hpt (hK'tgt h')
      refine (contMDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq ?_
      filter_upwards [hK'cl.isOpen_compl.mem_nhds hpK] with q hq
      exact hφ0 q hq
  
  have hgv : ∀ (w u : M → ℝ), (∀ p, p ∉ ψ '' tsupport ζ → w p = 0) →
      ∀ p, p ∉ ψ '' tsupport ζ → h.gradInner u w p = 0 := by
    intro w u hw p hp
    have hc : ContinuousAt (chartAt E3 p).symm (chartAt E3 p p) :=
      (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
    have hsymm : (chartAt E3 p).symm (chartAt E3 p p) = p :=
      (chartAt E3 p).left_inv (mem_chart_source E3 p)
    have hnhds : (chartAt E3 p).symm ⁻¹' (ψ '' tsupport ζ)ᶜ ∈ 𝓝 (chartAt E3 p p) := by
      apply hc.preimage_mem_nhds
      rw [hsymm]
      exact hK'cl.isOpen_compl.mem_nhds hp
    have hev : (fun y => w ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        fun _ => (0 : ℝ) := by
      filter_upwards [hnhds] with y hy
      exact hw _ hy
    have hpd : ∀ j : Fin 3,
        partialDeriv j (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
      intro j
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    simp [RiemannianMetric3.gradInner, hpd]
  
  have hsymInv : ∀ (P : E3 → M) (y : E3) (a b : Fin 3),
      (h.coeff P y)⁻¹ a b = (h.coeff P y)⁻¹ b a := by
    intro P y a b
    have hGT : Matrix.transpose (h.coeff P y) = h.coeff P y := by
      ext i j; rw [Matrix.transpose_apply]; exact h.symm _ _ _
    have hinvT : Matrix.transpose ((h.coeff P y)⁻¹) = (h.coeff P y)⁻¹ := by
      rw [Matrix.transpose_nonsing_inv, hGT]
    rw [← Matrix.transpose_apply ((h.coeff P y)⁻¹) a b, hinvT]
  
  have hgt : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ∀ y ∈ ψ.source,
      h.gradInner u φM (ψ y) = ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
        partialDeriv b (fun z => u (ψ z)) y * partialDeriv a ζ y := by
    intro u hu y hy
    rw [gradInner_pdiffeo_formula h ψ u φM hu hφsm y hy]
    have hev : (fun z => φM (ψ z)) =ᶠ[𝓝 y] ζ := by
      filter_upwards [ψ.open_source.mem_nhds hy] with z hz
      exact hφψ z hz
    have hpd : ∀ j : Fin 3, partialDeriv j (fun z => φM (ψ z)) y = partialDeriv j ζ y := by
      intro j
      unfold partialDeriv
      rw [hev.fderiv_eq]
    simp only [hpd]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    rw [hsymInv ψ y b a]
  
  have htransfer : ∀ (κ0 : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (G : M → ℝ),
      (∀ p, p ∉ κ0.target ∩ ψ.target → G p = 0) →
      ∫ z in κ0.source, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det =
        ∫ y in ψ.source, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
    intro κ0 G hG
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set E3, Ω = ψ.source ∩ ψ ⁻¹' κ0.target := ⟨_, rfl⟩
    have hmΩ : ∀ y, y ∈ Ω ↔ y ∈ ψ.source ∧ ψ y ∈ κ0.target := by
      intro y; rw [hΩ]; rfl
    have hΩo : IsOpen Ω := by
      rw [hΩ]; exact hψc.isOpen_inter_preimage ψ.open_source κ0.open_target
    obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun y => κ0.toPartialEquiv.symm (ψ y) := ⟨_, rfl⟩
    have hτa : ∀ y, τ y = κ0.toPartialEquiv.symm (ψ y) := by intro y; rw [hτ]
    have hτinv : ∀ y ∈ Ω, κ0 (τ y) = ψ y := by
      intro y hy; rw [hτa]; exact κ0.toPartialEquiv.right_inv ((hmΩ y).1 hy).2
    have hτsrc : ∀ y ∈ Ω, τ y ∈ κ0.source := by
      intro y hy; rw [hτa]; exact κ0.toPartialEquiv.map_target ((hmΩ y).1 hy).2
    have hτsm : ContDiffOn ℝ ∞ τ Ω := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => κ0.toPartialEquiv.symm (ψ y)) Ω :=
        κ0.contMDiffOn_invFun.comp (ψ.contMDiffOn_toFun.mono (fun y hy => ((hmΩ y).1 hy).1))
          (fun y hy => ((hmΩ y).1 hy).2)
      rw [hτ]; exact contMDiffOn_iff_contDiffOn.mp h1
    have hτd : ∀ y ∈ Ω, DifferentiableAt ℝ τ y := fun y hy =>
      ((hτsm.differentiableOn (by simp)) y hy).differentiableAt (hΩo.mem_nhds hy)
    have hτinj : Set.InjOn τ Ω := by
      intro y₁ h₁ y₂ h₂ heq
      have h3 : κ0 (τ y₁) = κ0 (τ y₂) := by rw [heq]
      rw [hτinv y₁ h₁, hτinv y₂ h₂] at h3
      exact ψ.toPartialEquiv.injOn ((hmΩ y₁).1 h₁).1 ((hmΩ y₂).1 h₂).1 h3
    
    have hcov := integral_image_eq_integral_abs_det_fderiv_smul volume hΩo.measurableSet
      (fun y hy => (hτd y hy).hasFDerivAt.hasFDerivWithinAt) hτinj
      (fun z => G (κ0 z) * Real.sqrt (h.coeff κ0 z).det)
    simp only [smul_eq_mul] at hcov
    
    have himg : τ '' Ω ⊆ κ0.source := by
      rintro _ ⟨y, hy, rfl⟩; exact hτsrc y hy
    have hcc : ∫ z in κ0.source, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det =
        ∫ z in τ '' Ω, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero κ0.open_source.measurableSet
        himg ?_
      intro z hz
      have hG0 : G (κ0 z) = 0 := by
        apply hG
        rintro ⟨hz1, hz2⟩
        apply hz.2
        have hr : ψ (ψ.toPartialEquiv.symm (κ0 z)) = κ0 z := ψ.toPartialEquiv.right_inv hz2
        refine ⟨ψ.toPartialEquiv.symm (κ0 z),
          (hmΩ _).2 ⟨ψ.toPartialEquiv.map_target hz2, ?_⟩, ?_⟩
        · rw [hr]; exact hz1
        · rw [hτa, hr]; exact κ0.toPartialEquiv.left_inv hz.1
      rw [hG0, zero_mul]
    
    have hdd : ∫ y in ψ.source, G (ψ y) * Real.sqrt (h.coeff ψ y).det =
        ∫ y in Ω, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero ψ.open_source.measurableSet
        (fun y hy => ((hmΩ y).1 hy).1) ?_
      intro y hy
      have hG0 : G (ψ y) = 0 := by
        apply hG
        rintro ⟨h1, -⟩
        exact hy.2 ((hmΩ y).2 ⟨hy.1, h1⟩)
      rw [hG0, zero_mul]
    
    have hvol : ∀ y ∈ Ω, Real.sqrt (h.coeff ψ y).det =
        |(fderiv ℝ τ y).det| * Real.sqrt (h.coeff κ0 (τ y)).det := by
      intro y hy
      have hev : (⇑κ0 ∘ τ) =ᶠ[𝓝 y] ⇑ψ := by
        filter_upwards [hΩo.mem_nhds hy] with z hz
        exact hτinv z hz
      have hcoeq : h.coeff ψ y = h.coeff (⇑κ0 ∘ τ) y := by
        have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑κ0 ∘ τ) y = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y :=
          hev.mfderiv_eq
        have hpt : (⇑κ0 ∘ τ) y = ψ y := hτinv y hy
        ext i j
        simp only [RiemannianMetric3.coeff, coeffMatrix]
        rw [hmf, hpt]
      have hκmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ0 (τ y) :=
        ((κ0.contMDiffOn_toFun (τ y) (hτsrc y hy)).contMDiffAt
          (κ0.open_source.mem_nhds (hτsrc y hy))).mdifferentiableAt (by simp)
      obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin 3) (Fin 3) ℝ,
          J = Matrix.of fun a i => fderiv ℝ τ y (e i) a := ⟨_, rfl⟩
      have hmat : h.coeff ψ y = J.transpose * h.coeff κ0 (τ y) * J := by
        rw [hcoeq]
        ext i j
        rw [coeff_comp_apply h κ0 τ y (hτd y hy) hκmd i j, hJ]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_three]
        ring
      have hdetJ : (fderiv ℝ τ y).det = J.det := by
        rw [hJ]
        show LinearMap.det ((fderiv ℝ τ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = _
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
        congr 1
      have hdet : (h.coeff ψ y).det = J.det ^ 2 * (h.coeff κ0 (τ y)).det := by
        rw [hmat, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]; ring
      rw [hdet, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs, hdetJ]
    
    have hff : ∫ y in Ω, |(fderiv ℝ τ y).det| *
          (G (κ0 (τ y)) * Real.sqrt (h.coeff κ0 (τ y)).det) =
        ∫ y in Ω, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_congr_fun hΩo.measurableSet fun y hy => ?_
      simp only
      rw [hτinv y hy, hvol y hy]; ring
    
    rw [hcc, hcov, hff, hdd]
  
  have hsq : ContinuousOn (fun y => Real.sqrt (h.coeff ψ y).det) ψ.source :=
    (nds_chart_cont h ψ 0 0 contMDiff_const contMDiff_const).2.2.2.1
  have hvanish_src : ∀ (F : M → ℝ), (∀ p, p ∉ ψ '' tsupport ζ → F p = 0) →
      ∀ y ∈ ψ.source, y ∉ tsupport ζ → F (ψ y) = 0 := by
    intro F hF y hy hyK
    apply hF
    rintro ⟨y', hy', hyy⟩
    have h1 := ψ.toPartialEquiv.injOn (hζs hy') hy hyy
    exact hyK (h1 ▸ hy')
  have hint : ∀ (c F : M → ℝ), Continuous c → (∀ p, p ∉ ψ '' tsupport ζ → F p = 0) →
      ContinuousOn (fun y => F (ψ y)) ψ.source →
      IntegrableOn (fun y => c (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source := by
    intro c F hc hF hFc
    have h1 : ContinuousOn (fun y => c (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det)
        ψ.source :=
      ((hc.comp_continuousOn hψc).mul hFc).mul hsq
    refine ((h1.mono hζs).integrableOn_compact hKc).of_forall_diff_eq_zero
      ψ.open_source.measurableSet ?_
    intro y hy
    rw [hvanish_src F hF y hy.1 hy.2]; ring
  have hloc : ∀ F : M → ℝ, (∀ p, p ∉ ψ '' tsupport ζ → F p = 0) →
      ContinuousOn (fun y => F (ψ y)) ψ.source →
      atlasInt h κ χ F = ∫ y in ψ.source, F (ψ y) * Real.sqrt (h.coeff ψ y).det := by
    intro F hF hFc
    unfold atlasInt
    have hi : ∀ i, ∫ y in (κ i).source, χ i (κ i y) * F (κ i y) *
          Real.sqrt (h.coeff (κ i) y).det =
        ∫ y in ψ.source, χ i (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      intro i
      have := htransfer (κ i) (fun p => χ i p * F p) (by
        intro p hp
        by_cases h1 : p ∈ (κ i).target
        · have h2 : p ∉ ψ.target := fun h2 => hp ⟨h1, h2⟩
          have h3 : p ∉ ψ '' tsupport ζ := fun h3 => h2 (hK'tgt h3)
          simp only [hF p h3, mul_zero]
        · have h2 : p ∉ tsupport (χ i) := fun h2 => h1 (hA.2.2.2.2.1 i h2)
          simp only [image_eq_zero_of_notMem_tsupport h2, zero_mul])
      exact this
    rw [Finset.sum_congr rfl (fun i _ => hi i)]
    rw [← integral_finset_sum _ (fun i _ => hint (χ i) F (hA.2.1 i).continuous hF hFc)]
    refine setIntegral_congr_fun ψ.open_source.measurableSet fun y hy => ?_
    show ∑ i, χ i (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det =
      F (ψ y) * Real.sqrt (h.coeff ψ y).det
    rw [← Finset.sum_mul, ← Finset.sum_mul, hA.2.2.2.1 (ψ y), one_mul]
  
  refine ⟨φM, hφsm, HasCompactSupport.intro hK'cpt hφ0, ?_⟩
  intro u hu _huc
  have hψcU : ContinuousOn (fun y => u (ψ y)) ψ.source := hu.continuous.comp_continuousOn hψc
  have hψcV : ContinuousOn (fun y => V (ψ y)) ψ.source := hV.continuous.comp_continuousOn hψc
  have hψcf : ContinuousOn (fun y => f (ψ y)) ψ.source := hf.continuous.comp_continuousOn hψc
  have hψcφ : ContinuousOn (fun y => φM (ψ y)) ψ.source :=
    hφsm.continuous.comp_continuousOn hψc
  have hA0 : ∀ p, p ∉ ψ '' tsupport ζ → h.gradInner u φM p = 0 := hgv φM u hφ0
  have hAc : ContinuousOn (fun y => h.gradInner u φM (ψ y)) ψ.source :=
    (nds_chart_cont h ψ u φM hu hφsm).2.2.1
  have hB0 : ∀ p, p ∉ ψ '' tsupport ζ → V p * u p * φM p = 0 := by
    intro p hp; rw [hφ0 p hp, mul_zero]
  have hBc : ContinuousOn (fun y => V (ψ y) * u (ψ y) * φM (ψ y)) ψ.source :=
    (hψcV.mul hψcU).mul hψcφ
  have hC0 : ∀ p, p ∉ ψ '' tsupport ζ → f p * φM p = 0 := by
    intro p hp; rw [hφ0 p hp, mul_zero]
  have hCc : ContinuousOn (fun y => f (ψ y) * φM (ψ y)) ψ.source := hψcf.mul hψcφ
  have hIA : IntegrableOn
      (fun y => h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source := by
    have := hint (fun _ => 1) (h.gradInner u φM) continuous_const hA0 hAc
    simpa only [one_mul] using this
  have hIB : IntegrableOn
      (fun y => V (ψ y) * u (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source := by
    have := hint (fun _ => 1) (fun p => V p * u p * φM p) continuous_const hB0 hBc
    simpa only [one_mul] using this
  have hIC : IntegrableOn
      (fun y => f (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source := by
    have := hint (fun _ => 1) (fun p => f p * φM p) continuous_const hC0 hCc
    simpa only [one_mul] using this
  have eA := hloc (h.gradInner u φM) hA0 hAc
  have eB := hloc (fun p => V p * u p * φM p) hB0 hBc
  have eC := hloc (fun p => f p * φM p) hC0 hCc
  unfold clsQ clsL
  rw [eA, eB, eC]
  have hcomb :
      8 * (∫ y in ψ.source, h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det) +
        (∫ y in ψ.source, V (ψ y) * u (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det) -
        (∫ y in ψ.source, f (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det) =
      ∫ y in ψ.source, (8 * (h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det) +
        V (ψ y) * u (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det -
        f (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det) := by
    have h8 : Integrable
        (fun y => 8 * (h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det))
        (volume.restrict ψ.source) := Integrable.const_mul hIA 8
    have h8B : Integrable
        (fun y => 8 * (h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det) +
          V (ψ y) * u (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det)
        (volume.restrict ψ.source) := by
      exact Integrable.add h8 hIB
    rw [integral_sub h8B hIC, integral_add h8 hIB, integral_const_mul]
  rw [hcomb]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero (μ := volume) (s := ψ.source)]
  · refine setIntegral_congr_fun ψ.open_source.measurableSet fun y hy => ?_
    show 8 * (h.gradInner u φM (ψ y) * Real.sqrt (h.coeff ψ y).det) +
        V (ψ y) * u (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det -
        f (ψ y) * φM (ψ y) * Real.sqrt (h.coeff ψ y).det =
      (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
            partialDeriv b (fun z => u (ψ z)) y * partialDeriv a ζ y
          + (V (ψ y) * u (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det
    rw [hgt u hu y hy, hφψ y hy]
    ring
  · intro y hy
    have hyK : y ∉ tsupport ζ := fun h' => hy (hζs h')
    have hz : ζ y = 0 := image_eq_zero_of_notMem_tsupport hyK
    have hfd : fderiv ℝ ζ y = 0 := by
      by_contra hne
      exact hyK (support_fderiv_subset ℝ (f := ζ) hne)
    have hpd : ∀ a : Fin 3, partialDeriv a ζ y = 0 := by
      intro a
      simp [partialDeriv, hfd]
    simp [hz, hpd]

theorem cls_approx_solutions [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k : Fin hAF.numEnds)
    (S : Set M) (hS : IsCompact S) (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) :
    ∃ (ε₀ Λ : ℝ) (ρ : Fin hAF.numEnds → ℝ), 0 < ε₀ ∧ 0 ≤ Λ ∧ (∀ j, 1 < ρ j) ∧
      ∀ h : RiemannianMetric3 M, (∀ p : M, p ∉ S → h.g p = g.g p) →
        (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) →
        ∀ V f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
          (∀ p : M, p ∉ S → V p = 0 ∧ f p = 0) → (∀ p : M, |V p| ≤ ε₀) →
          ∃ u : ℕ → M → ℝ,
            (∀ n, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n) ∧ HasCompactSupport (u n)) ∧
            (∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L : Set E3),
              IsCompact L → L ⊆ ψ.source → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ n, N ≤ n →
                ∫ y in L, ((u n (ψ y) - u m (ψ y)) ^ 2 + ∑ i : Fin 3,
                  (partialDeriv i (fun z => u n (ψ z)) y
                    - partialDeriv i (fun z => u m (ψ z)) y) ^ 2) < ε) ∧
            (∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ζ : E3 → ℝ),
              ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ψ.source →
              Tendsto (fun n => ∫ y, (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
                    partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y
                  + (V (ψ y) * u n (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det)
                atTop (𝓝 0)) ∧
            (∀ B : ℝ, (∀ p : M, |f p| ≤ B) → ∀ n,
              ∫ y in K, ((u n (φ y)) ^ 2 + ∑ i : Fin 3,
                (partialDeriv i (fun z => u n (φ z)) y) ^ 2) ≤ Λ * B ^ 2) ∧
            (∀ B : ℝ, (∀ p : M, |f p| ≤ B) → ∀ (j : Fin hAF.numEnds) (n : ℕ) (R : ℝ),
              ∫ y in {y : E3 | ρ j < ‖y‖ ∧ ‖y‖ < R},
                (u n ((hAF.ends j).Φ y)) ^ 2 / ‖y‖ ^ 2 ≤ Λ * B ^ 2) :=
by
  classical
  
  obtain ⟨ρA, nA, κ, χ, hA⟩ := cls_atlas_exists g hAF
  obtain ⟨CS, hCS, hPS⟩ := cls_poincare_compact g hAF k ρA κ χ hA S hS
  obtain ⟨ε₀, cS, hε₀, hcS, hcoer⟩ := cls_coercive g hAF ρA κ χ hA S hS CS hCS hPS
  have hT : IsCompact (φ '' K) :=
    hK.image_of_continuousOn (φ.contMDiffOn_toFun.continuousOn.mono hKφ)
  obtain ⟨CT, hCT, hPT⟩ := cls_poincare_compact g hAF k ρA κ χ hA (φ '' K) hT
  obtain ⟨CK, hCK0, hCK⟩ := cls_chart_energy_bound g hAF ρA κ χ hA φ K hK hKφ CT hCT hPT
  choose ρ CH hρ hCH hHb using fun j => cls_end_hardy g hAF ρA κ χ hA j
  obtain ⟨CHs, hCHsdef⟩ : ∃ CHs : ℝ, CHs = ∑ j, CH j := ⟨_, rfl⟩
  have hCHs0 : 0 ≤ CHs := by rw [hCHsdef]; exact Finset.sum_nonneg fun j _ => hCH j
  have hCHle : ∀ j, CH j ≤ CHs := by
    intro j; rw [hCHsdef]; exact Finset.single_le_sum (fun j _ => hCH j) (Finset.mem_univ j)
  obtain ⟨κ0, hκ0def⟩ : ∃ κ0 : ℝ, κ0 = 4 * Real.sqrt 2 * (4 * cS ^ 2 / (15 / 2 : ℝ) ^ 2) :=
    ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ0 := by rw [hκ0def]; positivity
  refine ⟨ε₀, (CK + CHs) * κ0, ρ, hε₀, mul_nonneg (add_nonneg hCK0 hCHs0) hκ0, hρ, ?_⟩
  
  intro h hh hequiv V f hV hf hVf hVb
  obtain ⟨B₀, hB₀⟩ : ∃ B₀ : ℝ, ∀ p : M, |f p| ≤ B₀ := by
    obtain ⟨C, hC'⟩ := hS.exists_bound_of_continuousOn hf.continuous.continuousOn
    refine ⟨max C 0, fun p => ?_⟩
    by_cases hp : p ∈ S
    · have h1 := hC' p hp
      rw [Real.norm_eq_abs] at h1
      exact h1.trans (le_max_left _ _)
    · rw [(hVf p hp).2, abs_zero]
      exact le_max_right _ _
  obtain ⟨hQs, hQa, hQh, hLa, hLh, hD⟩ := cls_form_algebra g hAF ρA κ χ hA h V f hV hf
  have hP0 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (0 : M → ℝ) ∧ HasCompactSupport (0 : M → ℝ) :=
    ⟨contMDiff_const, HasCompactSupport.zero⟩
  have hPa : ∀ u v : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧ HasCompactSupport v) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u + v) ∧ HasCompactSupport (u + v)) :=
    fun u v hu hv => ⟨hu.1.add hv.1, hu.2.add hv.2⟩
  have hPs : ∀ (t : ℝ) (u : M → ℝ), (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u ∧ HasCompactSupport u) →
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (t • u) ∧ HasCompactSupport (t • u)) :=
    fun t u hu => ⟨contMDiff_const.smul hu.1, hu.2.mono (Function.support_const_smul_subset t u)⟩
  have hcoer' : ∀ w : M → ℝ, (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) →
      (15 / 2 : ℝ) * atlasInt h κ χ (h.gradInner w w) ≤ clsQ h κ χ V w w := by
    intro w hw
    have h1 := (hcoer h hequiv w hw.1 hw.2).1 V hV (fun p hp => (hVf p hp).1) hVb
    have h2 := neg_abs_le (atlasInt h κ χ (fun p => V p * w p * w p))
    have h3 := hD w hw
    unfold clsQ
    linarith
  have hβ : ∀ B : ℝ, (∀ p : M, |f p| ≤ B) → ∀ w : M → ℝ,
      (ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) →
      |clsL h κ χ f w| ≤ (cS * B) * Real.sqrt (atlasInt h κ χ (h.gradInner w w)) :=
    fun B hB w hw => (hcoer h hequiv w hw.1 hw.2).2.1 f B hf (fun p hp => (hVf p hp).2) hB
  obtain ⟨u, hPu, hDb, hCa, hEL⟩ := cls_direct_method (X := M → ℝ)
    (fun w : M → ℝ => ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w ∧ HasCompactSupport w) hP0 hPa hPs
    (clsQ h κ χ V) (clsL h κ χ f) (fun w => atlasInt h κ χ (h.gradInner w w)) (15 / 2)
    (cS * B₀) hQs hQa hQh hLa hLh hD (by norm_num) hcoer' (hβ B₀ hB₀)
  
  have hDg : ∀ B : ℝ, (∀ p : M, |f p| ≤ B) → ∀ n,
      atlasInt g κ χ (g.gradInner (u n) (u n)) ≤ κ0 * B ^ 2 := by
    intro B hB n
    have h1 : atlasInt h κ χ (h.gradInner (u n) (u n)) ≤ 4 * (cS * B) ^ 2 / (15 / 2 : ℝ) ^ 2 :=
      hDb (cS * B) (hβ B hB) n
    have h2 := (hcoer h hequiv (u n) (hPu n).1 (hPu n).2).2.2
    have h3 : 4 * (cS * B) ^ 2 / (15 / 2 : ℝ) ^ 2 = (4 * cS ^ 2 / (15 / 2 : ℝ) ^ 2) * B ^ 2 := by
      ring
    have h4 : (0 : ℝ) ≤ 4 * Real.sqrt 2 := by positivity
    calc atlasInt g κ χ (g.gradInner (u n) (u n))
        ≤ 4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner (u n) (u n)) := h2
      _ ≤ 4 * Real.sqrt 2 * ((4 * cS ^ 2 / (15 / 2 : ℝ) ^ 2) * B ^ 2) := by
          rw [← h3]; exact mul_le_mul_of_nonneg_left h1 h4
      _ = κ0 * B ^ 2 := by rw [hκ0def]; ring
  refine ⟨u, hPu, ?_, ?_, ?_, ?_⟩
  
  · intro ψ L hL hLψ ε hε
    have hTψ : IsCompact (ψ '' L) :=
      hL.image_of_continuousOn (ψ.contMDiffOn_toFun.continuousOn.mono hLψ)
    obtain ⟨CTψ, hCTψ, hPψ⟩ := cls_poincare_compact g hAF k ρA κ χ hA (ψ '' L) hTψ
    obtain ⟨Cψ, hCψ, hCψb⟩ := cls_chart_energy_bound g hAF ρA κ χ hA ψ L hL hLψ CTψ hCTψ hPψ
    obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = Cψ * (4 * Real.sqrt 2) := ⟨_, rfl⟩
    have hA0 : 0 ≤ A := by rw [hAdef]; exact mul_nonneg hCψ (by positivity)
    have hA1 : 0 < A + 1 := by linarith
    obtain ⟨N, hN⟩ := hCa (ε / (A + 1) * (15 / 2)) (mul_pos (div_pos hε hA1) (by norm_num))
    refine ⟨N, fun m hm n hn => ?_⟩
    have hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n - u m) ∧ HasCompactSupport (u n - u m) :=
      ⟨(hPu n).1.sub (hPu m).1, (hPu n).2.sub (hPu m).2⟩
    have h1 := hCψb (u n) (u m) (hPu n).1 (hPu n).2 (hPu m).1 (hPu m).2
    have h2 := (hcoer h hequiv (u n - u m) hw.1 hw.2).2.2
    have h3 := hcoer' (u n - u m) hw
    have h4 := hN m hm n hn
    have h5 := hD (u n - u m) hw
    refine lt_of_le_of_lt h1 ?_
    have h6 : Cψ * atlasInt g κ χ (g.gradInner (u n - u m) (u n - u m)) ≤
        A * atlasInt h κ χ (h.gradInner (u n - u m) (u n - u m)) := by
      rw [hAdef, mul_assoc]; exact mul_le_mul_of_nonneg_left h2 hCψ
    have h7 : atlasInt h κ χ (h.gradInner (u n - u m) (u n - u m)) < ε / (A + 1) := by
      linarith
    have h8 := (lt_div_iff₀ hA1).1 h7
    have h9 : A * atlasInt h κ χ (h.gradInner (u n - u m) (u n - u m)) ≤
        (A + 1) * atlasInt h κ χ (h.gradInner (u n - u m) (u n - u m)) := by
      rw [add_mul, one_mul]; linarith
    linarith [mul_comm (atlasInt h κ χ (h.gradInner (u n - u m) (u n - u m))) (A + 1)]
  
  · intro ψ ζ hζ hζc hζs
    obtain ⟨φM, hφM, hφMc, hφeq⟩ :=
      cls_weak_form_chart g hAF ρA κ χ hA h V f hV hf ψ ζ hζ hζc hζs
    exact Tendsto.congr (fun n => hφeq (u n) (hPu n).1 (hPu n).2) (hEL φM ⟨hφM, hφMc⟩)
  
  · intro B hB n
    have hpd0 : ∀ (i : Fin 3) (y : E3), partialDeriv i (fun _ : E3 => (0 : ℝ)) y = 0 := by
      intro i y; simp [partialDeriv]
    have h1 := hCK (u n) 0 (hPu n).1 (hPu n).2 contMDiff_const HasCompactSupport.zero
    simp only [Pi.zero_apply, sub_zero, hpd0] at h1
    have h2 := hDg B hB n
    have hX : 0 ≤ κ0 * B ^ 2 := mul_nonneg hκ0 (sq_nonneg B)
    have h3 : CK * atlasInt g κ χ (g.gradInner (u n) (u n)) ≤ CK * (κ0 * B ^ 2) :=
      mul_le_mul_of_nonneg_left h2 hCK0
    have h4 : (CK + CHs) * κ0 * B ^ 2 = CK * (κ0 * B ^ 2) + CHs * (κ0 * B ^ 2) := by ring
    have h5 : 0 ≤ CHs * (κ0 * B ^ 2) := mul_nonneg hCHs0 hX
    linarith
  
  · intro B hB j n R
    have h1 := hHb j (u n) (hPu n).1 (hPu n).2 R
    have h2 := hDg B hB n
    have hX : 0 ≤ κ0 * B ^ 2 := mul_nonneg hκ0 (sq_nonneg B)
    have h3 : CH j * atlasInt g κ χ (g.gradInner (u n) (u n)) ≤ CH j * (κ0 * B ^ 2) :=
      mul_le_mul_of_nonneg_left h2 (hCH j)
    have h4 : CH j * (κ0 * B ^ 2) ≤ CHs * (κ0 * B ^ 2) :=
      mul_le_mul_of_nonneg_right (hCHle j) hX
    have h5 : (CK + CHs) * κ0 * B ^ 2 = CK * (κ0 * B ^ 2) + CHs * (κ0 * B ^ 2) := by ring
    have h6 : 0 ≤ CK * (κ0 * B ^ 2) := mul_nonneg hCK0 hX
    linarith

theorem cir_translate_basic : (∀ (c u x : E3) (ρ : ℝ), x ∈ Metric.ball (c - u) ρ ↔ x + u ∈ Metric.ball c ρ) ∧
    (∀ (c u : E3) (ρ : ℝ) (f : E3 → ℝ), ContDiffOn ℝ ∞ f (Metric.ball c ρ) →
      ContDiffOn ℝ ∞ (fun x => f (x + u)) (Metric.ball (c - u) ρ)) ∧
    (∀ (u x : E3) (a : Fin 3) (f : E3 → ℝ),
      partialDeriv a (fun y => f (y + u)) x = partialDeriv a f (x + u)) ∧
    (∀ (c u : E3) (ρ : ℝ) (ζ : E3 → ℝ), ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c ρ →
      ContDiff ℝ ∞ (fun x => ζ (x + u)) ∧ HasCompactSupport (fun x => ζ (x + u)) ∧
        tsupport (fun x => ζ (x + u)) ⊆ Metric.ball (c - u) ρ) ∧
    (∀ (c : E3) (r ρ : ℝ), r ≤ c 0 → ρ ≤ r →
      Metric.ball c ρ ∩ {x : E3 | 0 < x 0} = Metric.ball c ρ) ∧
    (∀ (c : E3) (r : ℝ), (c - (c 0 - r) • e 0) 0 = r) :=
by
  have s1 : ∀ (c u x : E3) (ρ : ℝ), x ∈ Metric.ball (c - u) ρ ↔ x + u ∈ Metric.ball c ρ := by
    intro c u x ρ
    rw [Metric.mem_ball, Metric.mem_ball, dist_sub_eq_dist_add_right]
  refine ⟨s1, ?_, ?_, ?_, ?_, ?_⟩
  · intro c u ρ f hf
    have hT : ContDiffOn ℝ ∞ (fun x : E3 => x + u) (Metric.ball (c - u) ρ) :=
      (contDiff_id.add contDiff_const).contDiffOn
    exact hf.comp hT (fun x hx => (s1 c u x ρ).1 hx)
  · intro u x a f
    show fderiv ℝ (fun y => f (y + u)) x (e a) = fderiv ℝ f (x + u) (e a)
    rw [fderiv_comp_add_right]
  · intro c u ρ ζ hζ hζc hs
    refine ⟨hζ.comp (contDiff_id.add contDiff_const), ?_, ?_⟩
    · exact hζc.comp_homeomorph (Homeomorph.addRight u)
    · intro x hx
      have hx' : x ∈ tsupport (ζ ∘ (Homeomorph.addRight u)) := hx
      rw [tsupport_comp_eq_preimage] at hx'
      exact (s1 c u x ρ).2 (hs hx')
  · intro c r ρ hr hρ
    ext x
    constructor
    · exact fun h => h.1
    · intro hx
      refine ⟨hx, ?_⟩
      show 0 < x 0
      have h1 := PiLp.norm_apply_le (x - c) 0
      have h2 : ‖x - c‖ < ρ := by rwa [Metric.mem_ball, dist_eq_norm] at hx
      rw [PiLp.sub_apply, Real.norm_eq_abs] at h1
      have := neg_abs_le (x 0 - c 0)
      linarith
  · intro c r
    simp [e, EuclideanSpace.single_apply]

theorem cir_translate_meas : (∀ (c u : E3) (ρ : ℝ) (f : E3 → ℝ), MemLp f 2 (volume.restrict (Metric.ball c ρ)) →
      MemLp (fun x => f (x + u)) 2 (volume.restrict (Metric.ball (c - u) ρ))) ∧
    (∀ (c u : E3) (ρ : ℝ) (g : E3 → ℝ),
      ∫ x in Metric.ball (c - u) ρ, g (x + u) = ∫ y in Metric.ball c ρ, g y) ∧
    (∀ (c u : E3) (ρ : ℝ) (p : E3 → Prop),
      (∀ᵐ y ∂(volume.restrict (Metric.ball c ρ)), p y) →
      ∀ᵐ x ∂(volume.restrict (Metric.ball (c - u) ρ)), p (x + u)) :=
by
  have hstar : ∀ (c u : E3) (ρ : ℝ), MeasurePreserving (fun x : E3 => x + u)
      (volume.restrict (Metric.ball (c - u) ρ)) (volume.restrict (Metric.ball c ρ)) := by
    intro c u ρ
    have h := (measurePreserving_add_right (volume : Measure E3) u).restrict_preimage_emb
      (measurableEmbedding_addRight u) (Metric.ball c ρ)
    rwa [Metric.preimage_add_right_ball] at h
  refine ⟨fun c u ρ f hf => ?_, fun c u ρ g => ?_, fun c u ρ p hp => ?_⟩
  · exact hf.comp_measurePreserving (hstar c u ρ)
  · have h := (measurePreserving_add_right (volume : Measure E3) u).setIntegral_preimage_emb
      (measurableEmbedding_addRight u) g (Metric.ball c ρ)
    rwa [Metric.preimage_add_right_ball] at h
  · exact (hstar c u ρ).quasiMeasurePreserving.ae hp

theorem fcr_prob_regularity (c : E3) (R : ℝ) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c R))
    (hAs : ∀ x ∈ Metric.ball c R, ∀ a b : Fin 3, A x a b = A x b a)
    (hApos : ∀ x ∈ Metric.ball c R, (A x).PosDef) :
    ∀ k : ℕ, ∀ (s' s : ℝ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (G : Fin 3 → E3 → ℝ) (Fs : E3 → ℝ), 0 < s' → s' < s → s < R →
      fcrProb c s A v D G Fs → (∀ d, ∃ DG, fcrSob c s (k + 1) (G d) DG) →
      (∃ DF, fcrSob c s k Fs DF) → ∀ b, ∃ D', fcrSob c s' (k + 1) (D [b]) D' :=
by
  
  have hmem : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ),
      fcrSob c s k φ D → MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    intro s k φ D h
    have h0 := h.2.1 [] (Nat.zero_le _)
    rwa [h.1] at h0
  have hmemH : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ), (∃ D, fcrSob c s k φ D) →
      MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    rintro s k φ ⟨D, h⟩
    exact hmem s k φ D h
  have hfirst : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ),
      fcrSob c s (k + 1) φ D → ∀ a, fcrWD c s φ a (D [a]) ∧
        MemLp (D [a]) 2 (volume.restrict (fcrHalf c s)) := by
    intro s k φ D h a
    refine ⟨fun ζ h1 h2 h3 => ?_, h.2.1 [a] (by simp)⟩
    have h0 := h.2.2 [] a (by simp) ζ h1 h2 h3
    rw [h.1] at h0
    exact h0
  have hL2 : ∀ (s : ℝ) (χ : E3 → ℝ), MemLp χ 2 (volume.restrict (fcrHalf c s)) →
      ∃ D, fcrSob c s 0 χ D := by
    intro s χ hχ
    exact ⟨fun _ => χ, rfl, fun _ _ => hχ, fun _ _ hL => absurd hL (Nat.not_lt_zero _)⟩
  have hHmono : ∀ (s s' : ℝ) (k k' : ℕ) (φ : E3 → ℝ), s' ≤ s → k' ≤ k →
      (∃ D, fcrSob c s k φ D) → ∃ D, fcrSob c s' k' φ D := by
    rintro s s' k k' φ hss hk ⟨D, hD⟩
    exact ⟨D, (fcr_sob_mono c s s' hss).1 k k' φ D hk hD⟩
  have hadd : ∀ (s : ℝ) (k : ℕ) (φ₁ φ₂ : E3 → ℝ), (∃ D, fcrSob c s k φ₁ D) →
      (∃ D, fcrSob c s k φ₂ D) → ∃ D, fcrSob c s k (fun x => φ₁ x + φ₂ x) D := by
    rintro s k φ₁ φ₂ ⟨D₁, h₁⟩ ⟨D₂, h₂⟩
    exact ⟨_, fcr_sob_add c s k φ₁ φ₂ D₁ D₂ h₁ h₂⟩
  have hsum3 : ∀ (s : ℝ) (k : ℕ) (φ : Fin 3 → E3 → ℝ), (∀ b, ∃ D, fcrSob c s k (φ b) D) →
      ∃ D, fcrSob c s k (fun x => ∑ b : Fin 3, φ b x) D := by
    intro s k φ h
    have h012 := hadd s k _ _ (hadd s k _ _ (h 0) (h 1)) (h 2)
    have he : (fun x => ∑ b : Fin 3, φ b x) = (fun x => (φ 0 x + φ 1 x) + φ 2 x) := by
      funext x
      simp [Fin.sum_univ_three]
    rw [he]
    exact h012
  have hpd : ∀ (m : E3 → ℝ) (a : Fin 3), ContDiffOn ℝ ∞ m (Metric.ball c R) →
      ContDiffOn ℝ ∞ (partialDeriv a m) (Metric.ball c R) := by
    intro m a hm
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ m y (e a)) (Metric.ball c R)
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen Metric.isOpen_ball).1 hm).2.clm_apply
      contDiffOn_const
  have hsmulH : ∀ (s : ℝ) (k : ℕ) (m φ : E3 → ℝ), s < R → ContDiffOn ℝ ∞ m (Metric.ball c R) →
      (∃ D, fcrSob c s k φ D) → ∃ D, fcrSob c s k (fun x => m x * φ x) D := by
    rintro s k m φ hs hm ⟨D, hD⟩
    exact fcr_sob_smul c R s hs m hm k φ D hD
  
  have hassemble : ∀ (s : ℝ) (j : ℕ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (E : Fin 3 → Fin 3 → E3 → ℝ) (Z : E3 → ℝ),
      (∀ b, fcrWD c s v b (D [b])) →
      (∀ b, MemLp (D [b]) 2 (volume.restrict (fcrHalf c s))) →
      (∀ a b, a ≠ 0 → fcrWD c s (D [b]) a (E a b) ∧ ∃ D', fcrSob c s j (E a b) D') →
      fcrWD c s (D [0]) 0 Z → (∃ D', fcrSob c s j Z D') →
      ∀ b, ∃ D', fcrSob c s (j + 1) (D [b]) D' := by
    intro s j v D E Z hv hDm hE hZ hZs b
    refine (fcr_sob_succ_iff c s j (D [b])).2 ⟨hDm b, fun a => ?_⟩
    by_cases ha : a = 0
    · subst ha
      by_cases hb : b = 0
      · subst hb
        exact ⟨Z, hZ, hZs⟩
      · exact ⟨E b 0, fcr_weak_symm c s b 0 v (D [b]) (D [0]) (E b 0) (hv b) (hv 0)
          (hE b 0 hb).1, (hE b 0 hb).2⟩
    · exact ⟨E a b, (hE a b ha).1, (hE a b ha).2⟩
  
  have hQ : ∀ k : ℕ, ∀ (s' s : ℝ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (G : Fin 3 → E3 → ℝ) (Fs : E3 → ℝ), 0 < s' → s' < s → s < R →
      fcrProb c s A v D G Fs → (∀ d, ∃ DG, fcrSob c s (k + 1) (G d) DG) →
      (∃ DF, fcrSob c s k Fs DF) → ∀ b, ∃ D', fcrSob c s' (k + 1) (D [b]) D' := by
    intro k
    induction k with
    | zero =>
      intro s' s v D G Fs hs' hss hsR hP hG hFs
      have hP' := fcr_prob_mono c s s' hss.le A v D G Fs hP
      have hs'R : s' < R := hss.trans hsR
      have hm := fcr_sob_mono c s s' hss.le
      have hT : ∀ a b : Fin 3, ∃ χ : E3 → ℝ, a ≠ 0 →
          (fcrWD c s' (D [b]) a χ ∧ MemLp χ 2 (volume.restrict (fcrHalf c s'))) := by
        intro a b
        by_cases ha : a = 0
        · exact ⟨0, fun h => absurd ha h⟩
        · obtain ⟨χ, h1, h2⟩ := fcr_tangential_energy c R s s' hs' hss hsR A hA hAs hApos
            v D G Fs hP hG a ha b
          exact ⟨χ, fun _ => ⟨h1, h2⟩⟩
      choose E hE using hT
      choose DG hDG using hG
      have hGD : ∀ a, fcrWD c s' (G a) a (DG a [a]) ∧
          MemLp (DG a [a]) 2 (volume.restrict (fcrHalf c s')) := by
        intro a
        obtain ⟨h1, h2⟩ := hfirst s 0 (G a) (DG a) (hDG a) a
        exact ⟨hm.2.1 _ _ _ h1, hm.2.2 _ h2⟩
      have hZ := fcr_normal_step c R s' hs'R A hA hApos v D G Fs hP' E (fun a => DG a [a])
        hE hGD
      have hZs := fcr_normalZ_sob c R s' hs'R A hA hApos 0 D E (fun a => DG a [a]) Fs
        (fun b => hL2 s' _ (hP'.1.2.1 [b] (by simp)))
        (fun a b ha => hL2 s' _ (hE a b ha).2)
        (fun a => hL2 s' _ (hGD a).2)
        (hL2 s' _ hP'.2.2.1)
      exact hassemble s' 0 v D E _ (fun b => (hfirst s' 0 v D hP'.1 b).1)
        (fun b => (hfirst s' 0 v D hP'.1 b).2)
        (fun a b ha => ⟨(hE a b ha).1, hL2 s' _ (hE a b ha).2⟩) hZ hZs
    | succ k ih =>
      intro s' s v D G Fs hs' hss hsR hP hG hFs
      obtain ⟨s₁, hs₁⟩ : ∃ s₁ : ℝ, s₁ = (s' + s) / 2 := ⟨_, rfl⟩
      have hs'1 : s' < s₁ := by rw [hs₁]; linarith
      have hs1s : s₁ < s := by rw [hs₁]; linarith
      have hs1R : s₁ < R := hs1s.trans hsR
      have hs'R : s' < R := hss.trans hsR
      have hs1pos : 0 < s₁ := hs'.trans hs'1
      have hP₁ := fcr_prob_mono c s s₁ hs1s.le A v D G Fs hP
      have hm1 := fcr_sob_mono c s s₁ hs1s.le
      have hm2 := fcr_sob_mono c s₁ s' hs'1.le
      have hm3 := fcr_sob_mono c s s' hss.le
      have hDb : ∀ b, ∃ D', fcrSob c s₁ (k + 1) (D [b]) D' :=
        ih s₁ s v D G Fs hs1pos hs1s hsR hP
          (fun d => hHmono s s (k + 1 + 1) (k + 1) (G d) le_rfl (by omega) (hG d))
          (hHmono s s (k + 1) k Fs le_rfl (by omega) hFs)
      choose Db hDbs using hDb
      have hE1 : ∀ a b, fcrWD c s₁ (D [b]) a (Db b [a]) ∧
          MemLp (Db b [a]) 2 (volume.restrict (fcrHalf c s₁)) :=
        fun a b => hfirst s₁ k (D [b]) (Db b) (hDbs b) a
      have hGd : ∀ d a, ∃ ψ, fcrWD c s (G d) a ψ ∧ ∃ D', fcrSob c s (k + 1) ψ D' :=
        fun d => ((fcr_sob_succ_iff c s (k + 1) (G d)).1 (hG d)).2
      choose Gd hGdw hGds using hGd
      have hFd : ∀ a, ∃ ψ, fcrWD c s Fs a ψ ∧ ∃ D', fcrSob c s k ψ D' :=
        ((fcr_sob_succ_iff c s k Fs).1 hFs).2
      choose Fd hFdw hFds using hFd
      have hEH : ∀ a b, a ≠ 0 → ∃ D', fcrSob c s' (k + 1) (Db b [a]) D' := by
        intro a b ha
        have hPa := fcr_diff_problem c R s₁ hs1R A hA v D G Fs hP₁ a ha (fun b => Db b [a])
          (fun b => hE1 a b) (fun d => Gd d a)
          (fun d => ⟨hm1.2.1 _ _ _ (hGdw d a), hm1.2.2 _ (hmemH s (k + 1) _ (hGds d a))⟩)
          (Fd a) ⟨hm1.2.1 _ _ _ (hFdw a), hm1.2.2 _ (hmemH s k _ (hFds a))⟩
        have hG' : ∀ d, ∃ DG, fcrSob c s₁ (k + 1)
            (fun x => (∑ b : Fin 3, partialDeriv a (fun y => A y d b) x * D [b] x) + Gd d a x)
            DG := by
          intro d
          exact hadd s₁ (k + 1) _ _
            (hsum3 s₁ (k + 1) (fun b x => partialDeriv a (fun y => A y d b) x * D [b] x)
              (fun b => hsmulH s₁ (k + 1) _ _ hs1R (hpd _ a (hA d b)) ⟨Db b, hDbs b⟩))
            (hHmono s s₁ (k + 1) (k + 1) _ hs1s.le le_rfl (hGds d a))
        exact ih s' s₁ (D [a]) _ _ (Fd a) hs' hs'1 hs1R hPa hG'
          (hHmono s s₁ k k _ hs1s.le le_rfl (hFds a)) b
      have hZ := fcr_normal_step c R s₁ hs1R A hA hApos v D G Fs hP₁ (fun a b => Db b [a])
        (fun a => Gd a a) (fun a b _ => hE1 a b)
        (fun a => ⟨hm1.2.1 _ _ _ (hGdw a a), hm1.2.2 _ (hmemH s (k + 1) _ (hGds a a))⟩)
      have hZs := fcr_normalZ_sob c R s' hs'R A hA hApos (k + 1) D (fun a b => Db b [a])
        (fun a => Gd a a) Fs
        (fun b => hHmono s₁ s' (k + 1) (k + 1) _ hs'1.le le_rfl ⟨Db b, hDbs b⟩)
        (fun a b ha => hEH a b ha)
        (fun a => hHmono s s' (k + 1) (k + 1) _ hss.le le_rfl (hGds a a))
        (hHmono s s' (k + 1) (k + 1) _ hss.le le_rfl hFs)
      exact hassemble s' (k + 1) v D (fun a b => Db b [a]) _
        (fun b => hm3.2.1 _ _ _ (hfirst s 0 v D hP.1 b).1)
        (fun b => hm3.2.2 _ (hfirst s 0 v D hP.1 b).2)
        (fun a b ha => ⟨hm2.2.1 _ _ _ (hE1 a b).1, hEH a b ha⟩)
        (hm2.2.1 _ _ _ hZ) hZs
  exact hQ

theorem cir_sobolev_bootstrap (c : E3) (R ρ ρ' : ℝ) (hρ' : 0 < ρ') (hρρ' : ρ' < ρ)
    (hρR : ρ < R) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ) (P F : E3 → ℝ)
    (hP : ContDiffOn ℝ ∞ P (Metric.ball c R)) (hF : ContDiffOn ℝ ∞ F (Metric.ball c R))
    (hQ : ∀ k : ℕ, ∀ (s' s : ℝ) (v : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ)
      (G : Fin 3 → E3 → ℝ) (Fs : E3 → ℝ), 0 < s' → s' < s → s < R →
      fcrProb c s A v D G Fs → (∀ d, ∃ DG, fcrSob c s (k + 1) (G d) DG) →
      (∃ DF, fcrSob c s k Fs DF) → ∀ b, ∃ D', fcrSob c s' (k + 1) (D [b]) D')
    (w : E3 → ℝ) (D1 : List (Fin 3) → E3 → ℝ) (hw : fcrSob c ρ 1 w D1)
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c ρ →
      ∫ x in fcrHalf c ρ,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * D1 [b] x * partialDeriv a ζ x)
          + (P x * w x + F x) * ζ x) = 0) :
    ∀ k : ℕ, ∃ D : List (Fin 3) → E3 → ℝ, fcrSob c ρ' k w D :=
by
  have hmem : ∀ (s : ℝ) (k : ℕ) (φ : E3 → ℝ) (D : List (Fin 3) → E3 → ℝ),
      fcrSob c s k φ D → MemLp φ 2 (volume.restrict (fcrHalf c s)) := by
    intro s k φ D h
    have h0 := h.2.1 [] (Nat.zero_le _)
    rwa [h.1] at h0
  have hFsH : ∀ (s : ℝ) (k : ℕ), s < R → (∃ D, fcrSob c s k w D) →
      ∃ D, fcrSob c s k (fun x => P x * w x + F x) D := by
    rintro s k hs ⟨Dw, hDw⟩
    obtain ⟨D', h1⟩ := fcr_sob_smul c R s hs P hP k w Dw hDw
    obtain ⟨DF, h2⟩ := fcr_smooth_sob c R s hs F hF k
    exact ⟨_, fcr_sob_add c s k (fun x => P x * w x) F D' DF h1 h2⟩
  have hwD : ∀ a : Fin 3, fcrWD c ρ w a (D1 [a]) := by
    intro a ζ h1 h2 h3
    have h0 := hw.2.2 [] a (by simp) ζ h1 h2 h3
    rw [hw.1] at h0
    exact h0
  have hwL : MemLp w 2 (volume.restrict (fcrHalf c ρ)) := hmem ρ 1 w D1 hw
  have hFsL : MemLp (fun x => P x * w x + F x) 2 (volume.restrict (fcrHalf c ρ)) := by
    obtain ⟨DF, hDF⟩ := hFsH ρ 1 hρR ⟨D1, hw⟩
    exact hmem ρ 1 _ DF hDF
  have hP0 : fcrProb c ρ A w D1 (fun _ _ => 0) (fun x => P x * w x + F x) := by
    refine ⟨hw, fun _ => MemLp.zero', hFsL, fun ζ h1 h2 h3 => ?_⟩
    refine Eq.trans ?_ (hweak ζ h1 h2 h3)
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    simp only [add_zero, Finset.sum_mul]
  have hind : ∀ k : ℕ, ∀ t : ℝ, ρ' ≤ t → t < ρ → ∃ D, fcrSob c t (k + 1) w D := by
    intro k
    induction k with
    | zero =>
      intro t _ htρ
      exact ⟨D1, (fcr_sob_mono c ρ t htρ.le).1 1 1 w D1 le_rfl hw⟩
    | succ k ih =>
      intro t hρ't htρ
      obtain ⟨s, hs⟩ : ∃ s : ℝ, s = (t + ρ) / 2 := ⟨_, rfl⟩
      have hts : t < s := by rw [hs]; linarith
      have hsρ : s < ρ := by rw [hs]; linarith
      have hρ's : ρ' ≤ s := by linarith
      have hsR : s < R := by linarith
      have ht0 : 0 < t := by linarith
      obtain ⟨Dk, hDk⟩ := ih s hρ's hsρ
      have hFk : ∃ DF, fcrSob c s k (fun x => P x * w x + F x) DF := by
        obtain ⟨DF, hDF⟩ := hFsH s (k + 1) hsR ⟨Dk, hDk⟩
        exact ⟨DF, (fcr_sob_mono c s s le_rfl).1 (k + 1) k _ DF (Nat.le_succ k) hDF⟩
      have hPs := fcr_prob_mono c ρ s hsρ.le A w D1 (fun _ _ => 0) _ hP0
      have hGs : ∀ d : Fin 3, ∃ DG, fcrSob c s (k + 1) ((fun _ _ => (0 : ℝ)) d) DG :=
        fun _ => fcr_smooth_sob c R s hsR (fun _ => 0) contDiffOn_const (k + 1)
      have hb := hQ k t s w D1 (fun _ _ => 0) _ ht0 hts hsR hPs hGs hFk
      have m := fcr_sob_mono c ρ t htρ.le
      exact (fcr_sob_succ_iff c t (k + 1) w).2
        ⟨m.2.2 w hwL, fun a => ⟨D1 [a], m.2.1 w (D1 [a]) a (hwD a), hb a⟩⟩
  intro k
  obtain ⟨D, hD⟩ := hind k ρ' le_rfl hρρ'
  exact ⟨D, (fcr_sob_mono c ρ' ρ' le_rfl).1 (k + 1) k w D (Nat.le_succ k) hD⟩

theorem cir_grad_identify (O : Set E3) (hO : IsOpen O) (w v' g : E3 → ℝ) (a : Fin 3)
    (hv' : ContDiff ℝ ∞ v') (hg : IntegrableOn g O)
    (hae : ∀ᵐ x ∂(volume.restrict O), w x = v' x)
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ O →
      ∫ x, w x * partialDeriv a ζ x = -∫ x, g x * ζ x) :
    ∀ᵐ x ∂(volume.restrict O), g x = partialDeriv a v' x :=
by
  have hcd : ∀ (f : E3 → ℝ), ContDiff ℝ ∞ f → Continuous (fun x => partialDeriv a f x) := by
    intro f hf
    exact (hf.continuous_fderiv (by simp)).clm_apply continuous_const
  have key : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ O →
      ∫ x, ζ x • (g - partialDeriv a v') x = 0 := by
    intro ζ hζ hζc hts
    have hpair : ∫ x, w x * partialDeriv a ζ x = ∫ x, v' x * partialDeriv a ζ x := by
      apply integral_congr_ae
      have h1 : ∀ᵐ x ∂volume, x ∈ O → w x = v' x := (ae_restrict_iff' hO.measurableSet).1 hae
      filter_upwards [h1] with x hx
      by_cases hxO : x ∈ O
      · simp only [hx hxO]
      · have hnt : x ∉ tsupport ζ := fun h => hxO (hts h)
        have hfd : fderiv ℝ ζ x = 0 := by
          by_contra hne
          exact hnt (support_fderiv_subset ℝ (Function.mem_support.2 hne))
        simp only [partialDeriv, hfd, ContinuousLinearMap.zero_apply, mul_zero]
    have hibp : ∫ x, v' x * partialDeriv a ζ x = -∫ x, partialDeriv a v' x * ζ x := by
      have hd1 : Continuous (fun x => partialDeriv a v' x) := hcd v' hv'
      have hd2 : Continuous (fun x => partialDeriv a ζ x) := hcd ζ hζ
      have i1 : Integrable (fun x => fderiv ℝ v' x (e a) * ζ x) :=
        (hd1.mul hζ.continuous).integrable_of_hasCompactSupport hζc.mul_left
      have i2 : Integrable (fun x => v' x * fderiv ℝ ζ x (e a)) :=
        (hv'.continuous.mul hd2).integrable_of_hasCompactSupport
          (hζc.fderiv_apply ℝ (e a)).mul_left
      have i3 : Integrable (fun x => v' x * ζ x) :=
        (hv'.continuous.mul hζ.continuous).integrable_of_hasCompactSupport hζc.mul_left
      exact integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable i1 i2 i3
        (hv'.differentiable (by simp)) (hζ.differentiable (by simp))
    have igz : Integrable (fun x => g x * ζ x) := by
      obtain ⟨C, hC⟩ := hζc.exists_bound_of_continuous hζ.continuous
      have hon : IntegrableOn (fun x => g x * ζ x) O :=
        Integrable.mul_bdd hg hζ.continuous.aestronglyMeasurable
          (Filter.Eventually.of_forall hC)
      refine hon.integrable_of_forall_notMem_eq_zero fun x hx => ?_
      have : ζ x = 0 := image_eq_zero_of_notMem_tsupport (fun h => hx (hts h))
      simp [this]
    have idz : Integrable (fun x => partialDeriv a v' x * ζ x) :=
      ((hcd v' hv').mul hζ.continuous).integrable_of_hasCompactSupport hζc.mul_left
    have hw := hweak ζ hζ hζc hts
    have hsplit : ∫ x, ζ x • (g - partialDeriv a v') x
        = (∫ x, g x * ζ x) - ∫ x, partialDeriv a v' x * ζ x := by
      rw [← integral_sub igz idz]
      congr 1
      funext x
      simp only [Pi.sub_apply, smul_eq_mul]
      ring
    rw [hsplit]
    linarith
  have hloc : LocallyIntegrableOn (g - partialDeriv a v') O volume :=
    hg.locallyIntegrableOn.sub ((hcd v' hv').continuousOn.locallyIntegrableOn hO.measurableSet)
  have h0 := hO.ae_eq_zero_of_integral_contDiff_smul_eq_zero hloc key
  filter_upwards [(ae_restrict_iff' hO.measurableSet).2 h0] with x hx
  exact sub_eq_zero.1 hx

theorem cir_weak_shrink (c : E3) (ρ₁ ρ₂ : ℝ) (h12 : ρ₂ ≤ ρ₁)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ) (P F v v' : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ)
    (hae : ∀ᵐ x ∂(volume.restrict (Metric.ball c ρ₂)), v x = v' x)
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c ρ₁ →
      ∫ x in Metric.ball c ρ₁,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x)
          + (P x * v x + F x) * ζ x) = 0) :
    ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c ρ₂ →
      ∫ x in Metric.ball c ρ₂,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x)
          + (P x * v' x + F x) * ζ x) = 0 :=
by
  intro ζ hζ hζc hζs
  have hsub : Metric.ball c ρ₂ ⊆ Metric.ball c ρ₁ := Metric.ball_subset_ball h12
  have h0 := hweak ζ hζ hζc (hζs.trans hsub)
  have hvan : ∀ x ∈ Metric.ball c ρ₁ \ Metric.ball c ρ₂,
      ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x)
        + (P x * v x + F x) * ζ x) = 0 := by
    intro x hx
    have hxt : x ∉ tsupport ζ := fun h => hx.2 (hζs h)
    have hz : ζ x = 0 := image_eq_zero_of_notMem_tsupport hxt
    have hd : fderiv ℝ ζ x = 0 := fderiv_of_notMem_tsupport ℝ hxt
    have hpd : ∀ a : Fin 3, partialDeriv a ζ x = 0 := by
      intro a
      show fderiv ℝ ζ x (e a) = 0
      rw [hd, ContinuousLinearMap.zero_apply]
    simp only [hz, hpd, mul_zero, Finset.sum_const_zero, add_zero]
  rw [setIntegral_eq_of_subset_of_forall_diff_eq_zero Metric.isOpen_ball.measurableSet hsub hvan]
    at h0
  rw [← h0]
  refine integral_congr_ae ?_
  filter_upwards [hae] with x hx
  rw [hx]

theorem cwl_interior_regularity (c : E3) (r : ℝ) (hr : 0 < r)
    (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (hA : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) (Metric.ball c r))
    (hAs : ∀ x ∈ Metric.ball c r, ∀ a b : Fin 3, A x a b = A x b a)
    (hApos : ∀ x ∈ Metric.ball c r, (A x).PosDef)
    (P F : E3 → ℝ) (hP : ContDiffOn ℝ ∞ P (Metric.ball c r))
    (hF : ContDiffOn ℝ ∞ F (Metric.ball c r))
    (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ) (vn : ℕ → E3 → ℝ)
    (hvn : ∀ m, ContDiffOn ℝ ∞ (vn m) (Metric.ball c r))
    (hvL : MemLp v 2 (volume.restrict (Metric.ball c (r / 2))))
    (hGL : ∀ a, MemLp (Gr a) 2 (volume.restrict (Metric.ball c (r / 2))))
    (hv0 : Tendsto (fun m => ∫ x in Metric.ball c (r / 2), (vn m x - v x) ^ 2) atTop (𝓝 0))
    (hv1 : ∀ a, Tendsto (fun m => ∫ x in Metric.ball c (r / 2),
      (partialDeriv a (vn m) x - Gr a x) ^ 2) atTop (𝓝 0))
    (hweak : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c (r / 2) →
      ∫ x in Metric.ball c (r / 2),
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x)
          + (P x * v x + F x) * ζ x) = 0) :
    ∃ v' : E3 → ℝ, ContDiffOn ℝ ∞ v' (Metric.ball c (r / 4)) ∧
      (∀ᵐ x ∂(volume.restrict (Metric.ball c (r / 4))), v x = v' x) ∧
      (∀ a : Fin 3, ∀ᵐ x ∂(volume.restrict (Metric.ball c (r / 4))),
        Gr a x = partialDeriv a v' x) ∧
      ∀ x ∈ Metric.ball c (r / 4),
        ∑ a : Fin 3, partialDeriv a (fun y => ∑ b : Fin 3, A y a b * partialDeriv b v' y) x
          = P x * v' x + F x :=
by
  obtain ⟨B1, B2, B3, B4, B5, B6⟩ := cir_translate_basic
  obtain ⟨M1, M2, M3⟩ := cir_translate_meas
  
  obtain ⟨u, hu⟩ : ∃ u : E3, u = (c 0 - r) • e 0 := ⟨_, rfl⟩
  have hc' : (c - u) 0 = r := by rw [hu]; exact B6 c r
  have hH : ∀ ρ : ℝ, ρ ≤ r → fcrHalf (c - u) ρ = Metric.ball (c - u) ρ := fun ρ hρ =>
    B5 (c - u) r ρ hc'.ge hρ
  have hN : ndsHalf (c - u) r = Metric.ball (c - u) (r / 2) :=
    B5 (c - u) r (r / 2) hc'.ge (by linarith)
  have hcc : c - u - -u = c := by rw [sub_neg_eq_add, sub_add_cancel]
  
  have hAt : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A (x + u) a b) (Metric.ball (c - u) r) :=
    fun a b => B2 c u r (fun y => A y a b) (hA a b)
  have hAts : ∀ x ∈ Metric.ball (c - u) r, ∀ a b : Fin 3, A (x + u) a b = A (x + u) b a :=
    fun x hx a b => hAs (x + u) ((B1 c u x r).1 hx) a b
  have hAtpos : ∀ x ∈ Metric.ball (c - u) r, (A (x + u)).PosDef :=
    fun x hx => hApos (x + u) ((B1 c u x r).1 hx)
  have hPt : ContDiffOn ℝ ∞ (fun x => P (x + u)) (Metric.ball (c - u) r) := B2 c u r P hP
  have hFt : ContDiffOn ℝ ∞ (fun x => F (x + u)) (Metric.ball (c - u) r) := B2 c u r F hF
  have hvnt : ∀ m, ContDiffOn ℝ ∞ (fun x => vn m (x + u)) (Metric.ball (c - u) r) :=
    fun m => B2 c u r (vn m) (hvn m)
  have hvLt : MemLp (fun x => v (x + u)) 2 (volume.restrict (Metric.ball (c - u) (r / 2))) :=
    M1 c u (r / 2) v hvL
  have hGLt : ∀ a, MemLp (fun x => Gr a (x + u)) 2
      (volume.restrict (Metric.ball (c - u) (r / 2))) :=
    fun a => M1 c u (r / 2) (Gr a) (hGL a)
  have hv0t : Tendsto (fun m => ∫ x in Metric.ball (c - u) (r / 2),
      (vn m (x + u) - v (x + u)) ^ 2) atTop (𝓝 0) := by
    refine hv0.congr fun m => ?_
    exact (M2 c u (r / 2) (fun y => (vn m y - v y) ^ 2)).symm
  have hv1t : ∀ a, Tendsto (fun m => ∫ x in Metric.ball (c - u) (r / 2),
      (partialDeriv a (fun y => vn m (y + u)) x - Gr a (x + u)) ^ 2) atTop (𝓝 0) := by
    intro a
    refine (hv1 a).congr fun m => ?_
    refine Eq.trans (M2 c u (r / 2) (fun y => (partialDeriv a (vn m) y - Gr a y) ^ 2)).symm ?_
    refine setIntegral_congr_fun measurableSet_ball fun x _ => ?_
    simp only [B3 u x a (vn m)]
  have hwt : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball (c - u) (r / 2) →
      ∫ x in Metric.ball (c - u) (r / 2),
        ((∑ a : Fin 3, ∑ b : Fin 3, A (x + u) a b * Gr b (x + u) * partialDeriv a ζ x)
          + (P (x + u) * v (x + u) + F (x + u)) * ζ x) = 0 := by
    intro ζ h1 h2 h3
    obtain ⟨k1, k2, k3⟩ := B4 (c - u) (-u) (r / 2) ζ h1 h2 h3
    rw [hcc] at k3
    have h0 := hweak (fun y => ζ (y + -u)) k1 k2 k3
    refine Eq.trans ?_ ((M2 c u (r / 2) _).trans h0)
    refine setIntegral_congr_fun measurableSet_ball fun x _ => ?_
    have hz' : ζ (x + u + -u) = ζ x := by rw [add_neg_cancel_right]
    have hpd' : ∀ a : Fin 3,
        partialDeriv a (fun y => ζ (y + -u)) (x + u) = partialDeriv a ζ x := by
      intro a
      rw [← B3 u x a (fun y => ζ (y + -u))]
      simp only [add_neg_cancel_right]
    simp only [hz', hpd']
  
  have hw1 := fcr_weak_grad (c - u) r hr (fun x => v (x + u)) (fun a x => Gr a (x + u))
    (fun m x => vn m (x + u)) hvnt (by rw [hN]; exact hvLt) (by rw [hN]; exact hGLt)
    (by rw [hN]; exact hv0t) (by rw [hN]; exact hv1t)
  
  have hQ := fcr_prob_regularity (c - u) r (fun x => A (x + u)) hAt hAts hAtpos
  have hk := cir_sobolev_bootstrap (c - u) r (r / 2) (7 * r / 16) (by linarith) (by linarith)
    (by linarith) (fun x => A (x + u)) (fun x => P (x + u)) (fun x => F (x + u)) hPt hFt hQ
    (fun x => v (x + u)) _ hw1
    (fun ζ h1 h2 h3 => by rw [hH (r / 2) (by linarith)]; exact hwt ζ h1 h2 h3)
  
  obtain ⟨v'', hv''sm, hae''⟩ := fcr_smooth_representative (c - u) (7 * r / 16) (3 * r / 8)
    (by linarith) (by linarith) (fun x => v (x + u)) hk
  rw [hH (3 * r / 8) (by linarith)] at hae''
  have hae3 : ∀ᵐ x ∂(volume.restrict (Metric.ball (c - u) (3 * r / 8))), v (x + u) = v'' x :=
    hae''
  have hae₄ : ∀ᵐ x ∂(volume.restrict (Metric.ball (c - u) (r / 4))), v (x + u) = v'' x :=
    ae_restrict_of_ae_restrict_of_subset (Metric.ball_subset_ball (by linarith)) hae3
  
  have hw3 := cir_weak_shrink (c - u) (r / 2) (3 * r / 8) (by linarith) (fun x => A (x + u))
    (fun x => P (x + u)) (fun x => F (x + u)) (fun x => v (x + u)) v''
    (fun a x => Gr a (x + u)) hae3 hwt
  
  have hsub : Metric.ball (c - u) (3 * r / 8) ⊆ Metric.ball (c - u) r :=
    Metric.ball_subset_ball (by linarith)
  have hs2 : Metric.ball (c - u) (3 * r / 8) ⊆ Metric.ball (c - u) (r / 2) :=
    Metric.ball_subset_ball (by linarith)
  have hF' : ContDiffOn ℝ ∞ (fun x => P (x + u) * v'' x + F (x + u))
      (Metric.ball (c - u) (3 * r / 8)) :=
    ((hPt.mono hsub).mul hv''sm.contDiffOn).add (hFt.mono hsub)
  obtain ⟨hstr, -⟩ := fcr_weak_to_strong (c - u) (3 * r / 8) (r / 4) (by linarith) (by linarith)
    (fun x => A (x + u)) (fun a b => (hAt a b).mono hsub) (fun x => P (x + u) * v'' x + F (x + u))
    hF' (fun x => v (x + u)) (fun a x => Gr a (x + u))
    (fun a => by
      rw [hH (3 * r / 8) (by linarith)]
      exact (hGLt a).mono_measure (Measure.restrict_mono hs2 le_rfl))
    (fun a ζ h1 h2 h3 => hw1.2.2 [] a (by simp) ζ h1 h2 (h3.trans (by
      rw [hH (3 * r / 8) (by linarith), hH (r / 2) (by linarith)]; exact hs2)))
    (fun ζ h1 h2 h3 => by rw [hH (3 * r / 8) (by linarith)]; exact hw3 ζ h1 h2 h3)
    v'' hv''sm (by rw [hH (r / 4) (by linarith)]; exact hae₄)
  
  have hgr : ∀ a : Fin 3, ∀ᵐ x ∂(volume.restrict (Metric.ball (c - u) (r / 4))),
      Gr a (x + u) = partialDeriv a v'' x := by
    intro a
    haveI : IsFiniteMeasure (volume.restrict (Metric.ball (c - u) (r / 2))) :=
      isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
    have hgI : IntegrableOn (fun x => Gr a (x + u)) (Metric.ball (c - u) (3 * r / 8)) :=
      IntegrableOn.mono_set ((hGLt a).integrable one_le_two) hs2
    have h := cir_grad_identify (Metric.ball (c - u) (3 * r / 8)) Metric.isOpen_ball
      (fun x => v (x + u)) v'' (fun x => Gr a (x + u)) a hv''sm hgI hae3
      (fun ζ h1 h2 h3 => hw1.2.2 [] a (by simp) ζ h1 h2 (h3.trans (by
        rw [hH (r / 2) (by linarith)]; exact hs2)))
    exact ae_restrict_of_ae_restrict_of_subset (Metric.ball_subset_ball (by linarith)) h
  
  refine ⟨fun y => v'' (y + -u), ?_, ?_, ?_, ?_⟩
  · have h := B2 (c - u) (-u) (r / 4) v'' hv''sm.contDiffOn
    rwa [hcc] at h
  · have h := M3 (c - u) (-u) (r / 4) _ hae₄
    rw [hcc] at h
    refine h.mono fun y hy => ?_
    simpa only [neg_add_cancel_right] using hy
  · intro a
    have h := M3 (c - u) (-u) (r / 4) _ (hgr a)
    rw [hcc] at h
    refine h.mono fun y hy => ?_
    rw [B3 (-u) y a v'']
    simpa only [neg_add_cancel_right] using hy
  · intro y hy
    have hx : y + -u ∈ Metric.ball (c - u) (r / 4) :=
      (B1 c u (y + -u) (r / 4)).2 (by rw [neg_add_cancel_right]; exact hy)
    have hx0 : 0 ≤ (y + -u) 0 := by
      have hm : y + -u ∈ Metric.ball (c - u) (r / 4) ∩ {x : E3 | 0 < x 0} := by
        rw [B5 (c - u) r (r / 4) hc'.ge (by linarith)]; exact hx
      exact le_of_lt hm.2
    have h : ∑ a : Fin 3, partialDeriv a
        (fun w => ∑ b : Fin 3, A (w + u) a b * partialDeriv b v'' w) (y + -u)
          = P (y + -u + u) * v'' (y + -u) + F (y + -u + u) := hstr (y + -u) hx hx0
    have hfun : ∀ a : Fin 3,
        (fun z => ∑ b : Fin 3, A z a b * partialDeriv b (fun y => v'' (y + -u)) z)
          = fun z => (fun w => ∑ b : Fin 3, A (w + u) a b * partialDeriv b v'' w) (z + -u) := by
      intro a
      funext z
      show _ = ∑ b : Fin 3, A (z + -u + u) a b * partialDeriv b v'' (z + -u)
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [B3 (-u) z b v'', neg_add_cancel_right]
    have hpa : ∀ a : Fin 3,
        partialDeriv a (fun z => ∑ b : Fin 3, A z a b * partialDeriv b (fun y => v'' (y + -u)) z) y
          = partialDeriv a (fun w => ∑ b : Fin 3, A (w + u) a b * partialDeriv b v'' w) (y + -u) := by
      intro a
      rw [hfun a]
      exact B3 (-u) y a (fun w => ∑ b : Fin 3, A (w + u) a b * partialDeriv b v'' w)
    rw [Finset.sum_congr rfl fun a _ => hpa a, h, neg_add_cancel_right]

theorem cwl_l2_limits (c : E3) (ρ : ℝ) (vn : ℕ → E3 → ℝ)
    (hvc : ∀ n, ContinuousOn (vn n) (Metric.closedBall c ρ))
    (hdc : ∀ n (i : Fin 3), ContinuousOn (partialDeriv i (vn n)) (Metric.closedBall c ρ))
    (hC : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ n, N ≤ n →
      ∫ y in Metric.closedBall c ρ, ((vn n y - vn m y) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (vn n) y - partialDeriv i (vn m) y) ^ 2) < ε) :
    (∀ n, MemLp (vn n) 2 (volume.restrict (Metric.ball c ρ))) ∧
    (∀ n (i : Fin 3), MemLp (partialDeriv i (vn n)) 2 (volume.restrict (Metric.ball c ρ))) ∧
    ∃ (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ),
      MemLp v 2 (volume.restrict (Metric.ball c ρ)) ∧
      (∀ i, MemLp (Gr i) 2 (volume.restrict (Metric.ball c ρ))) ∧
      Tendsto (fun n => ∫ x in Metric.ball c ρ, (vn n x - v x) ^ 2) atTop (𝓝 0) ∧
      ∀ i, Tendsto (fun n => ∫ x in Metric.ball c ρ,
        (partialDeriv i (vn n) x - Gr i x) ^ 2) atTop (𝓝 0) :=
by
  set μ : Measure E3 := volume.restrict (Metric.ball c ρ) with hμ
  haveI hfin : IsFiniteMeasure μ := isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  
  have hmem : ∀ φ : E3 → ℝ, ContinuousOn φ (Metric.closedBall c ρ) → MemLp φ 2 μ := by
    intro φ hφ
    obtain ⟨C, hCb⟩ := (isCompact_closedBall c ρ).exists_bound_of_continuousOn hφ
    have hmeas : AEStronglyMeasurable φ μ :=
      (hφ.mono Metric.ball_subset_closedBall).aestronglyMeasurable measurableSet_ball
    exact MemLp.of_bound hmeas C ((ae_restrict_mem measurableSet_ball).mono
      fun x hx => hCb x (Metric.ball_subset_closedBall hx))
  
  have hlim : ∀ h : ℕ → E3 → ℝ, (∀ m, MemLp (h m) 2 μ) →
      (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l → ∫ x, (h m x - h l x) ^ 2 ∂μ < ε) →
      ∃ H : E3 → ℝ, MemLp H 2 μ ∧
        Tendsto (fun m => ∫ x, (h m x - H x) ^ 2 ∂μ) atTop (𝓝 0) := by
    intro h hh hc
    have s2 : ∀ (f g : E3 → ℝ) (hf : MemLp f 2 μ) (hg : MemLp g 2 μ),
        ‖MemLp.toLp f hf - MemLp.toLp g hg‖ ^ 2 = ∫ x, (f x - g x) ^ 2 ∂μ := by
      intro f g hf hg
      rw [← real_inner_self_eq_norm_sq, MeasureTheory.L2.inner_def]
      refine integral_congr_ae ?_
      filter_upwards [Lp.coeFn_sub (MemLp.toLp f hf) (MemLp.toLp g hg),
        hf.coeFn_toLp, hg.coeFn_toLp] with a h0 h1 h2
      rw [h0, Pi.sub_apply, h1, h2]
      simp [sq]
    set F : ℕ → Lp ℝ 2 μ := fun m => MemLp.toLp (h m) (hh m) with hF
    have hcauchy : CauchySeq F := by
      rw [Metric.cauchySeq_iff]
      intro ε hε
      obtain ⟨N, hN⟩ := hc (ε ^ 2) (pow_pos hε 2)
      refine ⟨N, fun m hm l hl => ?_⟩
      rw [dist_eq_norm]
      have h1 : ‖F m - F l‖ ^ 2 < ε ^ 2 := by
        rw [hF, s2]
        exact hN m l hm hl
      exact lt_of_pow_lt_pow_left₀ 2 hε.le h1
    obtain ⟨G, hG⟩ := cauchySeq_tendsto_of_complete hcauchy
    have hGeq : MemLp.toLp (G : E3 → ℝ) (Lp.memLp G) = G := Lp.toLp_coeFn G (Lp.memLp G)
    refine ⟨(G : E3 → ℝ), Lp.memLp G, ?_⟩
    have h1 : Tendsto (fun m => ‖F m - G‖ ^ 2) atTop (𝓝 0) := by
      have := (tendsto_iff_norm_sub_tendsto_zero.mp hG).pow 2
      simpa using this
    refine h1.congr (fun m => ?_)
    have e := s2 (h m) (G : E3 → ℝ) (hh m) (Lp.memLp G)
    rw [hGeq] at e
    exact e
  
  have hcau : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m l, N ≤ m → N ≤ l →
      (∫ x, (vn m x - vn l x) ^ 2 ∂μ < ε) ∧
      ∀ i : Fin 3, ∫ x, (partialDeriv i (vn m) x - partialDeriv i (vn l) x) ^ 2 ∂μ < ε := by
    intro ε hε
    obtain ⟨N, hN⟩ := hC ε hε
    refine ⟨N, fun m l hm hl => ?_⟩
    obtain ⟨T, hTdef⟩ : ∃ T : E3 → ℝ, T = fun y => (vn m y - vn l y) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (vn m) y - partialDeriv i (vn l) y) ^ 2 := ⟨_, rfl⟩
    have hT : ∫ y in Metric.closedBall c ρ, T y < ε := by
      rw [hTdef]
      exact hN l hl m hm
    have hTc : ContinuousOn T (Metric.closedBall c ρ) := by
      rw [hTdef]
      exact (((hvc m).sub (hvc l)).pow 2).add
        (continuousOn_finset_sum _ fun i _ => ((hdc m i).sub (hdc l i)).pow 2)
    have hTi : IntegrableOn T (Metric.closedBall c ρ) :=
      hTc.integrableOn_compact (isCompact_closedBall c ρ)
    have hTB : Integrable T μ := hTi.mono_set Metric.ball_subset_closedBall
    have hT0 : ∀ y, 0 ≤ T y := by
      intro y
      rw [hTdef]
      exact add_nonneg (sq_nonneg _) (Finset.sum_nonneg fun i _ => sq_nonneg _)
    have hBB : ∫ x, T x ∂μ ≤ ∫ x in Metric.closedBall c ρ, T x :=
      setIntegral_mono_set hTi (Filter.Eventually.of_forall hT0)
        (Filter.Eventually.of_forall fun x hx => Metric.ball_subset_closedBall hx)
    have hlt : ∫ x, T x ∂μ < ε := lt_of_le_of_lt hBB hT
    refine ⟨lt_of_le_of_lt (integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun _ => sq_nonneg _) hTB
      (Filter.Eventually.of_forall fun y => ?_)) hlt, fun i => lt_of_le_of_lt
      (integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => sq_nonneg _) hTB
      (Filter.Eventually.of_forall fun y => ?_)) hlt⟩
    · rw [hTdef]
      exact le_add_of_nonneg_right (Finset.sum_nonneg fun i _ => sq_nonneg _)
    · rw [hTdef]
      exact (Finset.single_le_sum
        (f := fun j => (partialDeriv j (vn m) y - partialDeriv j (vn l) y) ^ 2)
        (fun j _ => sq_nonneg _) (Finset.mem_univ i)).trans (le_add_of_nonneg_left (sq_nonneg _))
  have hvL : ∀ n, MemLp (vn n) 2 μ := fun n => hmem _ (hvc n)
  have hdL : ∀ n (i : Fin 3), MemLp (partialDeriv i (vn n)) 2 μ := fun n i => hmem _ (hdc n i)
  obtain ⟨v, hv, hv0⟩ := hlim vn hvL (fun ε hε => by
    obtain ⟨N, hN⟩ := hcau ε hε
    exact ⟨N, fun m l hm hl => (hN m l hm hl).1⟩)
  have hG : ∀ i : Fin 3, ∃ H : E3 → ℝ, MemLp H 2 μ ∧
      Tendsto (fun n => ∫ x, (partialDeriv i (vn n) x - H x) ^ 2 ∂μ) atTop (𝓝 0) := fun i =>
    hlim (fun n => partialDeriv i (vn n)) (fun n => hdL n i) (fun ε hε => by
      obtain ⟨N, hN⟩ := hcau ε hε
      exact ⟨N, fun m l hm hl => (hN m l hm hl).2 i⟩)
  choose Gr hGL hG1 using hG
  exact ⟨hvL, hdL, v, Gr, hv, hGL, hv0, hG1⟩

theorem cwl_weak_limit_identity (c : E3) (ρ : ℝ) (A : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (P F : E3 → ℝ)
    (hA : ∀ a b : Fin 3, ContinuousOn (fun x => A x a b) (Metric.ball c ρ))
    (hP : ContinuousOn P (Metric.ball c ρ)) (hF : ContinuousOn F (Metric.ball c ρ))
    (vn : ℕ → E3 → ℝ) (v : E3 → ℝ) (Gr : Fin 3 → E3 → ℝ)
    (hvnL : ∀ n, MemLp (vn n) 2 (volume.restrict (Metric.ball c ρ)))
    (hdvnL : ∀ n (a : Fin 3), MemLp (partialDeriv a (vn n)) 2 (volume.restrict (Metric.ball c ρ)))
    (hvL : MemLp v 2 (volume.restrict (Metric.ball c ρ)))
    (hGL : ∀ a, MemLp (Gr a) 2 (volume.restrict (Metric.ball c ρ)))
    (hv0 : Tendsto (fun n => ∫ x in Metric.ball c ρ, (vn n x - v x) ^ 2) atTop (𝓝 0))
    (hv1 : ∀ a, Tendsto (fun n => ∫ x in Metric.ball c ρ,
      (partialDeriv a (vn n) x - Gr a x) ^ 2) atTop (𝓝 0))
    (hlim : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c ρ →
      Tendsto (fun n => ∫ x in Metric.ball c ρ,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * partialDeriv b (vn n) x * partialDeriv a ζ x)
          + (P x * vn n x + F x) * ζ x)) atTop (𝓝 0)) :
    ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ Metric.ball c ρ →
      ∫ x in Metric.ball c ρ,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * Gr b x * partialDeriv a ζ x)
          + (P x * v x + F x) * ζ x) = 0 :=
by
  intro ζ hζ hζc hζs
  have hBm : MeasurableSet (Metric.ball c ρ) := measurableSet_ball
  have hBf : volume (Metric.ball c ρ) < ⊤ := measure_ball_lt_top
  haveI : IsFiniteMeasure (volume.restrict (Metric.ball c ρ)) :=
    isFiniteMeasure_restrict.2 hBf.ne
  
  have key : ∀ (g : E3 → ℝ) (M : ℝ), AEStronglyMeasurable g (volume.restrict (Metric.ball c ρ)) →
      (∀ᵐ x ∂(volume.restrict (Metric.ball c ρ)), ‖g x‖ ≤ M) →
      ∀ (fn : ℕ → E3 → ℝ) (f : E3 → ℝ),
      (∀ n, MemLp (fn n) 2 (volume.restrict (Metric.ball c ρ))) →
      MemLp f 2 (volume.restrict (Metric.ball c ρ)) →
      Tendsto (fun n => ∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2) atTop (𝓝 0) →
      Tendsto (fun n => ∫ x in Metric.ball c ρ, g x * fn n x) atTop
        (𝓝 (∫ x in Metric.ball c ρ, g x * f x)) := by
    intro g M hg hgae0 fn f hfn hf ht
    obtain ⟨M', hM'⟩ : ∃ M', M' = max M 0 := ⟨_, rfl⟩
    have hM'0 : 0 ≤ M' := by rw [hM']; exact le_max_right _ _
    have hgae : ∀ᵐ x ∂(volume.restrict (Metric.ball c ρ)), ‖g x‖ ≤ M' :=
      hgae0.mono fun x hx => hx.trans (by rw [hM']; exact le_max_left _ _)
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨V, hV⟩ : ∃ V : ℝ, V = ∫ x in Metric.ball c ρ, (1 : ℝ) := ⟨_, rfl⟩
    have hV0 : 0 ≤ V := by rw [hV]; exact integral_nonneg fun _ => zero_le_one
    have hden : 0 < M' * V + 1 := by positivity
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = ε / (M' * V + 1) := ⟨_, rfl⟩
    have hδ0 : 0 < δ := by rw [hδ]; exact div_pos hε hden
    have hδeq : δ * (M' * V + 1) = ε := by rw [hδ]; exact div_mul_cancel₀ _ hden.ne'
    have hη : 0 < ε * δ / (M' + 1) := by positivity
    obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.1 ht) _ hη
    refine ⟨N, fun n hn => ?_⟩
    have han := hN n hn
    have ha0 : 0 ≤ ∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2 :=
      integral_nonneg fun _ => sq_nonneg _
    rw [Real.dist_eq, sub_zero, abs_of_nonneg ha0] at han
    have hdL : MemLp (fun x => fn n x - f x) 2 (volume.restrict (Metric.ball c ρ)) :=
      (hfn n).sub hf
    have hd2 : Integrable (fun x => (fn n x - f x) ^ 2) (volume.restrict (Metric.ball c ρ)) :=
      hdL.integrable_sq
    have hi1 : Integrable (fun x => g x * fn n x) (volume.restrict (Metric.ball c ρ)) :=
      ((hfn n).integrable one_le_two).bdd_mul hg hgae
    have hi2 : Integrable (fun x => g x * f x) (volume.restrict (Metric.ball c ρ)) :=
      (hf.integrable one_le_two).bdd_mul hg hgae
    have hdiff : (∫ x in Metric.ball c ρ, g x * fn n x) - ∫ x in Metric.ball c ρ, g x * f x
        = ∫ x in Metric.ball c ρ, g x * (fn n x - f x) := by
      rw [← integral_sub hi1 hi2]
      congr 1
      funext x
      ring
    have hone : Integrable (fun _ : E3 => (1 : ℝ)) (volume.restrict (Metric.ball c ρ)) :=
      integrable_const _
    have hbnd_int : Integrable (fun x => M' * (fn n x - f x) ^ 2 + M' * δ ^ 2 * 1)
        (volume.restrict (Metric.ball c ρ)) :=
      (hd2.const_mul M').add (hone.const_mul _)
    have hbnd_eq : ∫ x in Metric.ball c ρ, (M' * (fn n x - f x) ^ 2 + M' * δ ^ 2 * 1)
        = M' * (∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2) + M' * δ ^ 2 * V := by
      rw [integral_add (hd2.const_mul M') (hone.const_mul _), integral_const_mul,
        integral_const_mul, hV]
    have hpt : ∀ᵐ x ∂(volume.restrict (Metric.ball c ρ)),
        ‖(2 * δ) * (g x * (fn n x - f x))‖ ≤ M' * (fn n x - f x) ^ 2 + M' * δ ^ 2 * 1 := by
      filter_upwards [hgae] with x hx
      rw [Real.norm_eq_abs] at hx ⊢
      have h2δ : (0 : ℝ) < 2 * δ := by positivity
      rw [abs_mul, abs_of_pos h2δ, abs_mul]
      have h1 : |g x| * |fn n x - f x| ≤ M' * |fn n x - f x| :=
        mul_le_mul_of_nonneg_right hx (abs_nonneg _)
      have h2 : 2 * δ * |fn n x - f x| ≤ (fn n x - f x) ^ 2 + δ ^ 2 := by
        nlinarith [sq_nonneg (|fn n x - f x| - δ), sq_abs (fn n x - f x)]
      have h3 := mul_le_mul_of_nonneg_left h2 hM'0
      have h4 := mul_le_mul_of_nonneg_left h1 h2δ.le
      nlinarith
    have hI := norm_integral_le_of_norm_le hbnd_int hpt
    have h2δ : (0 : ℝ) < 2 * δ := by positivity
    rw [integral_const_mul, hbnd_eq, Real.norm_eq_abs, abs_mul, abs_of_pos h2δ] at hI
    rw [Real.dist_eq, hdiff]
    have h4 : (M' + 1) * (∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2) < ε * δ := by
      rw [lt_div_iff₀ (by positivity)] at han
      linarith
    have h3 : M' * (∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2)
        ≤ (M' + 1) * (∫ x in Metric.ball c ρ, (fn n x - f x) ^ 2) := by nlinarith
    have h6 : δ * (M' * V) < ε := by
      have : δ * (M' * V) = ε - δ := by rw [← hδeq]; ring
      linarith
    have h7 : M' * δ ^ 2 * V < δ * ε := by
      have := mul_lt_mul_of_pos_left h6 hδ0
      nlinarith
    have h8 : 2 * δ * |∫ x in Metric.ball c ρ, g x * (fn n x - f x)| < 2 * δ * ε := by
      linarith
    exact lt_of_mul_lt_mul_left h8 h2δ.le
  
  have hKc : IsCompact (tsupport ζ) := hζc
  have hζcont : Continuous ζ := hζ.continuous
  have hdζ : ∀ a : Fin 3, Continuous (partialDeriv a ζ) := fun a =>
    (hζ.continuous_fderiv (by simp)).clm_apply continuous_const
  have hdζ0 : ∀ a : Fin 3, ∀ x, x ∉ tsupport ζ → partialDeriv a ζ x = 0 := by
    intro a x hx
    have hd0 : fderiv ℝ ζ x = 0 := by
      by_contra hne
      exact hx (support_fderiv_subset ℝ hne)
    simp only [partialDeriv, hd0, ContinuousLinearMap.zero_apply]
  have hζ0 : ∀ x, x ∉ tsupport ζ → ζ x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
  
  have wbound : ∀ w : E3 → ℝ, ContinuousOn w (Metric.ball c ρ) →
      (∀ x, x ∉ tsupport ζ → w x = 0) →
      ∃ M : ℝ, AEStronglyMeasurable w (volume.restrict (Metric.ball c ρ)) ∧
        ∀ᵐ x ∂(volume.restrict (Metric.ball c ρ)), ‖w x‖ ≤ M := by
    intro w hw hw0
    obtain ⟨C, hC⟩ := hKc.exists_bound_of_continuousOn (hw.mono hζs)
    refine ⟨max C 0, hw.aestronglyMeasurable hBm, ?_⟩
    refine Filter.Eventually.of_forall fun x => ?_
    by_cases hxK : x ∈ tsupport ζ
    · exact (hC x hxK).trans (le_max_left _ _)
    · rw [hw0 x hxK, norm_zero]; exact le_max_right _ _
  have hwab : ∀ a b : Fin 3, ∃ M : ℝ,
      AEStronglyMeasurable (fun x => A x a b * partialDeriv a ζ x)
        (volume.restrict (Metric.ball c ρ)) ∧
      ∀ᵐ x ∂(volume.restrict (Metric.ball c ρ)), ‖A x a b * partialDeriv a ζ x‖ ≤ M :=
    fun a b => wbound _ ((hA a b).mul (hdζ a).continuousOn)
      (fun x hx => by simp only [hdζ0 a x hx, mul_zero])
  choose Mab hMab using hwab
  obtain ⟨MP, hPm, hPb⟩ := wbound (fun x => P x * ζ x) (hP.mul hζcont.continuousOn)
    (fun x hx => by simp only [hζ0 x hx, mul_zero])
  obtain ⟨MF, hFm, hFb⟩ := wbound (fun x => F x * ζ x) (hF.mul hζcont.continuousOn)
    (fun x hx => by simp only [hζ0 x hx, mul_zero])
  have hFi : Integrable (fun x => F x * ζ x) (volume.restrict (Metric.ball c ρ)) :=
    Integrable.of_bound hFm MF hFb
  
  have split : ∀ (D : Fin 3 → E3 → ℝ) (u : E3 → ℝ),
      (∀ b, Integrable (D b) (volume.restrict (Metric.ball c ρ))) →
      Integrable u (volume.restrict (Metric.ball c ρ)) →
      ∫ x in Metric.ball c ρ,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * D b x * partialDeriv a ζ x)
          + (P x * u x + F x) * ζ x)
      = (∑ a : Fin 3, ∑ b : Fin 3, ∫ x in Metric.ball c ρ,
            (A x a b * partialDeriv a ζ x) * D b x)
        + (∫ x in Metric.ball c ρ, (P x * ζ x) * u x)
        + ∫ x in Metric.ball c ρ, F x * ζ x := by
    intro D u hD hu
    have hiab : ∀ a b : Fin 3, Integrable (fun x => (A x a b * partialDeriv a ζ x) * D b x)
        (volume.restrict (Metric.ball c ρ)) :=
      fun a b => (hD b).bdd_mul (hMab a b).1 (hMab a b).2
    have hiP : Integrable (fun x => (P x * ζ x) * u x) (volume.restrict (Metric.ball c ρ)) :=
      hu.bdd_mul hPm hPb
    have hpt : (fun x => ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * D b x * partialDeriv a ζ x)
          + (P x * u x + F x) * ζ x))
        = fun x => (∑ a : Fin 3, ∑ b : Fin 3, (A x a b * partialDeriv a ζ x) * D b x)
          + (P x * ζ x) * u x + F x * ζ x := by
      funext x
      have : ∀ a b : Fin 3, A x a b * D b x * partialDeriv a ζ x
          = (A x a b * partialDeriv a ζ x) * D b x := fun a b => by ring
      simp only [this]
      ring
    rw [hpt, integral_add _ hFi, integral_add _ hiP, integral_finset_sum]
    · congr 2
      refine Finset.sum_congr rfl fun a _ => ?_
      exact integral_finset_sum _ fun b _ => hiab a b
    · exact fun a _ => integrable_finset_sum _ fun b _ => hiab a b
    · exact integrable_finset_sum _ fun a _ => integrable_finset_sum _ fun b _ => hiab a b
    · exact (integrable_finset_sum _ fun a _ => integrable_finset_sum _ fun b _ => hiab a b).add
        hiP
  have hIn : ∀ n, ∫ x in Metric.ball c ρ,
        ((∑ a : Fin 3, ∑ b : Fin 3, A x a b * partialDeriv b (vn n) x * partialDeriv a ζ x)
          + (P x * vn n x + F x) * ζ x)
      = (∑ a : Fin 3, ∑ b : Fin 3, ∫ x in Metric.ball c ρ,
            (A x a b * partialDeriv a ζ x) * partialDeriv b (vn n) x)
        + (∫ x in Metric.ball c ρ, (P x * ζ x) * vn n x)
        + ∫ x in Metric.ball c ρ, F x * ζ x := fun n =>
    split (fun b => partialDeriv b (vn n)) (vn n)
      (fun b => (hdvnL n b).integrable one_le_two) ((hvnL n).integrable one_le_two)
  have hJ := split Gr v (fun b => (hGL b).integrable one_le_two) (hvL.integrable one_le_two)
  have hT := ((tendsto_finset_sum Finset.univ fun a _ => tendsto_finset_sum Finset.univ
      fun b _ => key _ (Mab a b) (hMab a b).1 (hMab a b).2 (fun n => partialDeriv b (vn n))
        (Gr b) (fun n => hdvnL n b) (hGL b) (hv1 b)).add
    (key _ MP hPm hPb vn v hvnL hvL hv0)).add
    (tendsto_const_nhds (x := ∫ x in Metric.ball c ρ, F x * ζ x))
  rw [← hJ] at hT
  exact tendsto_nhds_unique (hT.congr fun n => (hIn n).symm) (hlim ζ hζ hζc hζs)

theorem cwl_chart_solution [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (h : RiemannianMetric3 M) (V f : M → ℝ)
    (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (u : ℕ → M → ℝ) (hu : ∀ n, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n))
    (hC : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L : Set E3),
      IsCompact L → L ⊆ ψ.source → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ n, N ≤ n →
        ∫ y in L, ((u n (ψ y) - u m (ψ y)) ^ 2 + ∑ i : Fin 3,
          (partialDeriv i (fun z => u n (ψ z)) y
            - partialDeriv i (fun z => u m (ψ z)) y) ^ 2) < ε)
    (hEL : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ζ : E3 → ℝ),
      ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ψ.source →
      Tendsto (fun n => ∫ y, (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
            partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y
          + (V (ψ y) * u n (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det)
        atTop (𝓝 0))
    (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (c : E3) (r : ℝ) (hr : 0 < r)
    (hB : Metric.closedBall c r ⊆ ψ.source) :
    ∃ w : E3 → ℝ, ContDiffOn ℝ ∞ w (Metric.ball c (r / 4)) ∧
      (∀ x ∈ Metric.ball c (r / 4),
        -8 * lapLoc (h.coeff ψ) w x + V (ψ x) * w x = f (ψ x)) ∧
      (∀ n, MemLp (fun x => u n (ψ x) - w x) 2 (volume.restrict (Metric.ball c (r / 4)))) ∧
      (∀ n (i : Fin 3), MemLp (fun x => partialDeriv i (fun z => u n (ψ z)) x
        - partialDeriv i w x) 2 (volume.restrict (Metric.ball c (r / 4)))) ∧
      Tendsto (fun n => ∫ x in Metric.ball c (r / 4), (u n (ψ x) - w x) ^ 2) atTop (𝓝 0) ∧
      ∀ i : Fin 3, Tendsto (fun n => ∫ x in Metric.ball c (r / 4),
        (partialDeriv i (fun z => u n (ψ z)) x - partialDeriv i w x) ^ 2) atTop (𝓝 0) :=
by
  classical
  
  have hr2 : r / 2 ≤ r := by linarith
  have hr4 : r / 4 ≤ r / 2 := by linarith
  have hK2S : Metric.closedBall c (r / 2) ⊆ ψ.source :=
    (Metric.closedBall_subset_closedBall hr2).trans hB
  have hB2S : Metric.ball c (r / 2) ⊆ ψ.source := Metric.ball_subset_closedBall.trans hK2S
  have hBrS : Metric.ball c r ⊆ ψ.source := Metric.ball_subset_closedBall.trans hB
  have hB42 : Metric.ball c (r / 4) ⊆ Metric.ball c (r / 2) := Metric.ball_subset_ball hr4
  have hB4S : Metric.ball c (r / 4) ⊆ ψ.source := hB42.trans hB2S
  have hvn_sm : ∀ n, ContDiffOn ℝ ∞ (fun z => u n (ψ z)) ψ.source := fun n =>
    contMDiffOn_iff_contDiffOn.mp ((hu n).comp_contMDiffOn ψ.contMDiffOn_toFun)
  have hvn_d : ∀ n (i : Fin 3), ContinuousOn (partialDeriv i (fun z => u n (ψ z))) ψ.source := by
    intro n i
    have h1 := (hvn_sm n).continuousOn_fderiv_of_isOpen ψ.open_source
      (by exact_mod_cast le_top)
    show ContinuousOn (fun y => fderiv ℝ (fun z => u n (ψ z)) y (e i)) ψ.source
    exact h1.clm_apply continuousOn_const
  have hFR := flat_coeff_regular h ψ
  have hsd : ContDiffOn ℝ ∞ (fun z => Real.sqrt (h.coeff ψ z).det) ψ.source :=
    ccs_sqrtdet_smooth (h.coeff ψ) ψ.source (coeff_contDiffOn_source h ψ)
      (fun z hz => (coeff_posDef h ψ z hz).det_pos)
  have hsdpos : ∀ z ∈ ψ.source, 0 < Real.sqrt (h.coeff ψ z).det := fun z hz =>
    Real.sqrt_pos.2 (coeff_posDef h ψ z hz).det_pos
  have hVψ : ContDiffOn ℝ ∞ (fun z => V (ψ z)) ψ.source :=
    contMDiffOn_iff_contDiffOn.mp (hV.comp_contMDiffOn ψ.contMDiffOn_toFun)
  have hfψ : ContDiffOn ℝ ∞ (fun z => f (ψ z)) ψ.source :=
    contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn ψ.contMDiffOn_toFun)
  
  let A : E3 → Matrix (Fin 3) (Fin 3) ℝ := fun y =>
    Matrix.of (fun a b => 8 * Real.sqrt (h.coeff ψ y).det * (h.coeff ψ y)⁻¹ a b)
  let P : E3 → ℝ := fun y => Real.sqrt (h.coeff ψ y).det * V (ψ y)
  let F : E3 → ℝ := fun y => -(Real.sqrt (h.coeff ψ y).det * f (ψ y))
  have hAsm : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => A x a b) ψ.source := by
    intro a b
    show ContDiffOn ℝ ∞ (fun x => 8 * Real.sqrt (h.coeff ψ x).det * (h.coeff ψ x)⁻¹ a b) ψ.source
    exact (contDiffOn_const.mul hsd).mul (hFR.1 a b)
  have hAs : ∀ x ∈ Metric.ball c r, ∀ a b : Fin 3, A x a b = A x b a := by
    intro x hx a b
    show 8 * Real.sqrt (h.coeff ψ x).det * (h.coeff ψ x)⁻¹ a b
      = 8 * Real.sqrt (h.coeff ψ x).det * (h.coeff ψ x)⁻¹ b a
    rw [hFR.2.1 x (hBrS hx) a b]
  have hApos : ∀ x ∈ Metric.ball c r, (A x).PosDef := by
    intro x hx
    have hAx : A x = (8 * Real.sqrt (h.coeff ψ x).det) • (h.coeff ψ x)⁻¹ := by
      ext a b
      simp only [A, Matrix.of_apply, Matrix.smul_apply, smul_eq_mul]
    rw [hAx]
    exact Matrix.PosDef.smul (hFR.2.2.1 x (hBrS hx)) (mul_pos (by norm_num) (hsdpos x (hBrS hx)))
  have hPsm : ContDiffOn ℝ ∞ P ψ.source := hsd.mul hVψ
  have hFsm : ContDiffOn ℝ ∞ F ψ.source := (hsd.mul hfψ).neg
  
  obtain ⟨hvnL, hdvnL, v, Gr, hvL, hGL, hv0, hv1⟩ :=
    cwl_l2_limits c (r / 2) (fun n z => u n (ψ z))
      (fun n => (hvn_sm n).continuousOn.mono hK2S)
      (fun n i => (hvn_d n i).mono hK2S)
      (hC ψ _ (isCompact_closedBall c (r / 2)) hK2S)
  
  have hlim : ∀ ζ : E3 → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ →
      tsupport ζ ⊆ Metric.ball c (r / 2) →
      Tendsto (fun n => ∫ x in Metric.ball c (r / 2),
        ((∑ a : Fin 3, ∑ b : Fin 3,
            A x a b * partialDeriv b (fun z => u n (ψ z)) x * partialDeriv a ζ x)
          + (P x * u n (ψ x) + F x) * ζ x)) atTop (𝓝 0) := by
    intro ζ hζ hζc hζs
    have h1 := hEL ψ ζ hζ hζc (hζs.trans hB2S)
    have hpt : ∀ (n : ℕ) (y : E3), (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
            partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y
          + (V (ψ y) * u n (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det
        = (∑ a : Fin 3, ∑ b : Fin 3,
            A y a b * partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y)
          + (P y * u n (ψ y) + F y) * ζ y := by
      intro n y
      simp only [A, P, F, Matrix.of_apply, Fin.sum_univ_three]
      ring
    have hzero : ∀ (n : ℕ), ∀ y ∉ Metric.ball c (r / 2),
        (∑ a : Fin 3, ∑ b : Fin 3,
            A y a b * partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y)
          + (P y * u n (ψ y) + F y) * ζ y = 0 := by
      intro n y hy
      have hyt : y ∉ tsupport ζ := fun h' => hy (hζs h')
      have hζ0 : ζ y = 0 := image_eq_zero_of_notMem_tsupport hyt
      have hd0 : fderiv ℝ ζ y = 0 := by
        by_contra hne
        exact hyt (support_fderiv_subset ℝ hne)
      have hpd : ∀ a : Fin 3, partialDeriv a ζ y = 0 := fun a => by
        simp only [partialDeriv, hd0, ContinuousLinearMap.zero_apply]
      simp only [hpd, hζ0, mul_zero, Finset.sum_const_zero, add_zero]
    refine h1.congr fun n => ?_
    calc _ = ∫ y, ((∑ a : Fin 3, ∑ b : Fin 3,
            A y a b * partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y)
          + (P y * u n (ψ y) + F y) * ζ y) :=
          integral_congr_ae (Filter.Eventually.of_forall (hpt n))
      _ = _ := (setIntegral_eq_integral_of_forall_compl_eq_zero (hzero n)).symm
  have hweak := cwl_weak_limit_identity c (r / 2) A P F
    (fun a b => (hAsm a b).continuousOn.mono hB2S) (hPsm.continuousOn.mono hB2S)
    (hFsm.continuousOn.mono hB2S) (fun n z => u n (ψ z)) v Gr hvnL hdvnL hvL hGL hv0 hv1 hlim
  
  obtain ⟨v', hv'sm, hae0, hae1, hdiv⟩ := cwl_interior_regularity c r hr A
    (fun a b => (hAsm a b).mono hBrS) hAs hApos P F (hPsm.mono hBrS) (hFsm.mono hBrS)
    v Gr (fun n z => u n (ψ z)) (fun m => (hvn_sm m).mono hBrS) hvL hGL hv0 hv1 hweak
  
  have heqn : ∀ x ∈ Metric.ball c (r / 4),
      -8 * lapLoc (h.coeff ψ) v' x + V (ψ x) * v' x = f (ψ x) := by
    intro x hx
    have hd := hdiv x hx
    have hfun : ∀ a : Fin 3, (fun y => ∑ b : Fin 3, A y a b * partialDeriv b v' y)
        = (8 : ℝ) • (fun y => ∑ b : Fin 3,
            Real.sqrt (h.coeff ψ y).det * (h.coeff ψ y)⁻¹ a b * partialDeriv b v' y) := by
      intro a
      funext y
      simp only [A, Matrix.of_apply, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      ring
    have hpd8 : ∀ a : Fin 3,
        partialDeriv a (fun y => ∑ b : Fin 3, A y a b * partialDeriv b v' y) x
          = 8 * partialDeriv a (fun y => ∑ b : Fin 3,
            Real.sqrt (h.coeff ψ y).det * (h.coeff ψ y)⁻¹ a b * partialDeriv b v' y) x := by
      intro a
      rw [hfun a]
      simp only [partialDeriv, fderiv_const_smul_of_field, Pi.smul_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hdf := lapLoc_div_form (Metric.ball c (r / 4)) Metric.isOpen_ball (h.coeff ψ)
      (fun i j => (coeff_contDiffOn_source h ψ i j).mono hB4S) (fun y i j => h.symm _ _ _)
      (fun y hy => coeff_posDef h ψ y (hB4S hy)) v' hv'sm x hx
    rw [Finset.sum_congr rfl (fun a _ => hpd8 a), ← Finset.mul_sum, hdf] at hd
    have hs := hsdpos x (hB4S hx)
    have key : Real.sqrt (h.coeff ψ x).det *
        (-8 * lapLoc (h.coeff ψ) v' x + V (ψ x) * v' x - f (ψ x)) = 0 := by
      simp only [P, F] at hd
      linear_combination (-1 : ℝ) * hd
    rcases mul_eq_zero.1 key with h0 | h0
    · linarith
    · linarith
  
  have hμ : volume.restrict (Metric.ball c (r / 4)) ≤ volume.restrict (Metric.ball c (r / 2)) :=
    Measure.restrict_mono hB42 le_rfl
  have restrict_lim : ∀ (g : ℕ → E3 → ℝ) (v₀ w₀ : E3 → ℝ),
      (∀ n, MemLp (fun x => g n x - v₀ x) 2 (volume.restrict (Metric.ball c (r / 2)))) →
      Tendsto (fun n => ∫ x in Metric.ball c (r / 2), (g n x - v₀ x) ^ 2) atTop (𝓝 0) →
      (∀ᵐ x ∂(volume.restrict (Metric.ball c (r / 4))), v₀ x = w₀ x) →
      (∀ n, MemLp (fun x => g n x - w₀ x) 2 (volume.restrict (Metric.ball c (r / 4)))) ∧
      Tendsto (fun n => ∫ x in Metric.ball c (r / 4), (g n x - w₀ x) ^ 2) atTop (𝓝 0) := by
    intro g v₀ w₀ hm ht hae
    have hae' : ∀ n, (fun x => g n x - v₀ x) =ᵐ[volume.restrict (Metric.ball c (r / 4))]
        (fun x => g n x - w₀ x) := fun n => hae.mono fun x hx => by simp only [hx]
    refine ⟨fun n => ((hm n).mono_measure hμ).ae_eq (hae' n), ?_⟩
    have heq : ∀ n, ∫ x in Metric.ball c (r / 4), (g n x - w₀ x) ^ 2
        = ∫ x in Metric.ball c (r / 4), (g n x - v₀ x) ^ 2 :=
      fun n => integral_congr_ae (hae.mono fun x hx => by simp only [hx])
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ht
      (fun n => ?_) (fun n => ?_)
    · show (0 : ℝ) ≤ ∫ x in Metric.ball c (r / 4), (g n x - w₀ x) ^ 2
      rw [heq n]
      exact integral_nonneg fun x => sq_nonneg _
    · show ∫ x in Metric.ball c (r / 4), (g n x - w₀ x) ^ 2
          ≤ ∫ x in Metric.ball c (r / 2), (g n x - v₀ x) ^ 2
      rw [heq n]
      exact setIntegral_mono_set (hm n).integrable_sq
        (Filter.Eventually.of_forall fun x => sq_nonneg _)
        (Filter.Eventually.of_forall fun x hx => hB42 hx)
  obtain ⟨hm0, ht0⟩ := restrict_lim (fun n x => u n (ψ x)) v v'
    (fun n => (hvnL n).sub hvL) hv0 hae0
  have hpar := fun i : Fin 3 => restrict_lim
    (fun n x => partialDeriv i (fun z => u n (ψ z)) x) (Gr i) (partialDeriv i v')
    (fun n => (hdvnL n i).sub (hGL i)) (hv1 i) (hae1 i)
  exact ⟨v', hv'sm, heqn, hm0, fun n i => (hpar i).1 n, ht0, fun i => (hpar i).2⟩

theorem cwl_chart_compat [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (u : ℕ → M → ℝ)
    (ψ₁ ψ₂ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (U₁ U₂ : Set E3)
    (hU₁ : IsOpen U₁) (hU₂ : IsOpen U₂) (hU₁s : U₁ ⊆ ψ₁.source) (hU₂s : U₂ ⊆ ψ₂.source)
    (w₁ w₂ : E3 → ℝ) (hw₁ : ContinuousOn w₁ U₁) (hw₂ : ContinuousOn w₂ U₂)
    (hm₁ : ∀ n, MemLp (fun x => u n (ψ₁ x) - w₁ x) 2 (volume.restrict U₁))
    (hm₂ : ∀ n, MemLp (fun x => u n (ψ₂ x) - w₂ x) 2 (volume.restrict U₂))
    (ht₁ : Tendsto (fun n => ∫ x in U₁, (u n (ψ₁ x) - w₁ x) ^ 2) atTop (𝓝 0))
    (ht₂ : Tendsto (fun n => ∫ x in U₂, (u n (ψ₂ x) - w₂ x) ^ 2) atTop (𝓝 0)) :
    ∀ y₁ ∈ U₁, ∀ y₂ ∈ U₂, ψ₁ y₁ = ψ₂ y₂ → w₁ y₁ = w₂ y₂ :=
by
  intro y₁ hy₁ y₂ hy₂ hψ
  
  have rinv : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (p : M),
      p ∈ ψ.target → ψ (ψ.symm p) = p := fun ψ p hp => ψ.toPartialEquiv.right_inv hp
  have linv : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (x : E3),
      x ∈ ψ.source → ψ.symm (ψ x) = x := fun ψ x hx => ψ.toPartialEquiv.left_inv hx
  have msrc : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (x : E3),
      x ∈ ψ.source → ψ x ∈ ψ.target := fun ψ x hx => ψ.toPartialEquiv.map_source hx
  have mtgt : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (p : M),
      p ∈ ψ.target → ψ.symm p ∈ ψ.source := fun ψ p hp => ψ.toPartialEquiv.map_target hp
  
  have s1 : ∀ (μ : Measure E3) (f : ℕ → E3 → ℝ), (∀ n, MemLp (f n) 2 μ) →
      Tendsto (fun n => ∫ x, (f n x) ^ 2 ∂μ) atTop (𝓝 0) →
      TendstoInMeasure μ f atTop (fun _ => (0 : ℝ)) := by
    intro μ f hf ht
    refine tendstoInMeasure_of_tendsto_eLpNorm (p := 2) (by norm_num)
      (fun n => (hf n).aestronglyMeasurable) aestronglyMeasurable_const ?_
    have heq : ∀ n, eLpNorm (f n - fun _ => (0 : ℝ)) 2 μ =
        ENNReal.ofReal ((∫ x, (f n x) ^ 2 ∂μ) ^ (2⁻¹ : ℝ)) := by
      intro n
      have h1 : (f n - fun _ => (0 : ℝ)) = f n := by funext x; simp
      rw [h1, MemLp.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num) (hf n)]
      simp only [ENNReal.toReal_ofNat, Real.rpow_two, Real.norm_eq_abs, sq_abs]
    simp_rw [heq]
    have h2 : Tendsto (fun n => (∫ x, (f n x) ^ 2 ∂μ) ^ (2⁻¹ : ℝ)) atTop (𝓝 0) := by
      have := ((Real.continuousAt_rpow_const 0 2⁻¹ (Or.inr (by norm_num))).tendsto).comp ht
      rwa [Real.zero_rpow (by norm_num)] at this
    have := (ENNReal.continuous_ofReal.tendsto 0).comp h2
    rwa [ENNReal.ofReal_zero] at this
  
  obtain ⟨ns, hns, hfa⟩ := (s1 _ _ hm₁ ht₁).exists_seq_tendsto_ae
  obtain ⟨ms, hms, hga⟩ := ((s1 _ _ hm₂ ht₂).comp hns.tendsto_atTop).exists_seq_tendsto_ae
  have hA₁ : ∀ᵐ x ∂(volume.restrict U₁),
      Tendsto (fun k => u (ns (ms k)) (ψ₁ x) - w₁ x) atTop (𝓝 0) :=
    hfa.mono fun x hx => hx.comp hms.tendsto_atTop
  have hA₂ : ∀ᵐ x ∂(volume.restrict U₂),
      Tendsto (fun k => u (ns (ms k)) (ψ₂ x) - w₂ x) atTop (𝓝 0) := hga
  rw [ae_restrict_iff' hU₁.measurableSet, ae_iff] at hA₁
  rw [ae_restrict_iff' hU₂.measurableSet, ae_iff] at hA₂
  
  have s3 : ∀ E : Set E3, volume E = 0 →
      volume {x : E3 | x ∈ ψ₁.source ∧ ψ₁ x ∈ ψ₂.target ∧ ψ₂.symm (ψ₁ x) ∈ E} = 0 := by
    intro E hE
    have hσ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => ψ₁.symm (ψ₂ y))
        (ψ₂.source ∩ ψ₂ ⁻¹' ψ₁.target) :=
      ψ₁.symm.contMDiffOn.comp (ψ₂.contMDiffOn.mono Set.inter_subset_left) (fun y hy => hy.2)
    have hσd : DifferentiableOn ℝ (fun y => ψ₁.symm (ψ₂ y))
        (E ∩ (ψ₂.source ∩ ψ₂ ⁻¹' ψ₁.target)) :=
      ((contMDiffOn_iff_contDiffOn.mp hσ).differentiableOn (by decide)).mono
        Set.inter_subset_right
    have h0 := addHaar_image_eq_zero_of_differentiableOn_of_addHaar_eq_zero volume hσd
      (measure_mono_null Set.inter_subset_left hE)
    refine measure_mono_null ?_ h0
    rintro x ⟨hx1, hx2, hx3⟩
    refine ⟨ψ₂.symm (ψ₁ x), ⟨hx3, mtgt ψ₂ _ hx2, ?_⟩, ?_⟩
    · show ψ₂ (ψ₂.symm (ψ₁ x)) ∈ ψ₁.target
      rw [rinv ψ₂ _ hx2]
      exact msrc ψ₁ x hx1
    · show ψ₁.symm (ψ₂ (ψ₂.symm (ψ₁ x))) = x
      rw [rinv ψ₂ _ hx2]
      exact linv ψ₁ x hx1
  
  have hc₁ : ContinuousOn ψ₁ ψ₁.source := ψ₁.contMDiffOn.continuousOn
  have hc₂ : ContinuousOn ψ₂.symm ψ₂.target := ψ₂.symm.contMDiffOn.continuousOn
  have hA : IsOpen (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target) :=
    hc₁.isOpen_inter_preimage ψ₁.open_source ψ₂.open_target
  have hτ : ContinuousOn (fun x => ψ₂.symm (ψ₁ x)) (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target) :=
    hc₂.comp (hc₁.mono Set.inter_subset_left) (fun x hx => hx.2)
  have hW : IsOpen ((U₁ ∩ (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target)) ∩
      (fun x => ψ₂.symm (ψ₁ x)) ⁻¹' U₂) :=
    (hτ.mono Set.inter_subset_right).isOpen_inter_preimage (hU₁.inter hA) hU₂
  have hwτ : ContinuousOn (fun x => w₂ (ψ₂.symm (ψ₁ x)))
      ((U₁ ∩ (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target)) ∩ (fun x => ψ₂.symm (ψ₁ x)) ⁻¹' U₂) :=
    hw₂.comp (hτ.mono fun x hx => hx.1.2) (fun x hx => hx.2)
  have hτy₁ : ψ₂.symm (ψ₁ y₁) = y₂ := by
    rw [hψ]; exact linv ψ₂ y₂ (hU₂s hy₂)
  have hy₁W : y₁ ∈ (U₁ ∩ (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target)) ∩
      (fun x => ψ₂.symm (ψ₁ x)) ⁻¹' U₂ := by
    refine ⟨⟨hy₁, hU₁s hy₁, ?_⟩, ?_⟩
    · show ψ₁ y₁ ∈ ψ₂.target
      rw [hψ]; exact msrc ψ₂ y₂ (hU₂s hy₂)
    · show ψ₂.symm (ψ₁ y₁) ∈ U₂
      rw [hτy₁]; exact hy₂
  
  have s5 : w₁ =ᵐ[volume.restrict ((U₁ ∩ (ψ₁.source ∩ ψ₁ ⁻¹' ψ₂.target)) ∩
      (fun x => ψ₂.symm (ψ₁ x)) ⁻¹' U₂)] (fun x => w₂ (ψ₂.symm (ψ₁ x))) := by
    rw [Filter.EventuallyEq, ae_restrict_iff' hW.measurableSet, ae_iff]
    refine measure_mono_null ?_ (measure_union_null hA₁ (s3 _ hA₂))
    intro x hx
    by_contra hcon
    apply hx
    intro hxW
    rw [Set.mem_union, not_or] at hcon
    obtain ⟨h1, h2⟩ := hcon
    have T1 : Tendsto (fun k => u (ns (ms k)) (ψ₁ x) - w₁ x) atTop (𝓝 0) := by
      by_contra hc
      exact h1 (fun h => hc (h hxW.1.1))
    have T2 : Tendsto (fun k => u (ns (ms k)) (ψ₂ (ψ₂.symm (ψ₁ x))) - w₂ (ψ₂.symm (ψ₁ x)))
        atTop (𝓝 0) := by
      by_contra hc
      exact h2 ⟨hxW.1.2.1, hxW.1.2.2, fun h => hc (h hxW.2)⟩
    rw [rinv ψ₂ _ hxW.1.2.2] at T2
    have L1 := T1.add_const (w₁ x)
    have L2 := T2.add_const (w₂ (ψ₂.symm (ψ₁ x)))
    simp only [sub_add_cancel, zero_add] at L1 L2
    exact tendsto_nhds_unique L1 L2
  
  have hfin := Measure.eqOn_open_of_ae_eq s5 hW (hw₁.mono fun x hx => hx.1.1) hwτ hy₁W
  exact hfin.trans (congrArg w₂ hτy₁)

theorem cwl_local_to_compact (S : Set E3) (hS : IsOpen S) (F : ℕ → E3 → ℝ)
    (hF0 : ∀ n x, 0 ≤ F n x) (hFc : ∀ n, ContinuousOn (F n) S)
    (hloc : ∀ y ∈ S, ∃ ρ : ℝ, 0 < ρ ∧ Metric.closedBall y ρ ⊆ S ∧
      Tendsto (fun n => ∫ x in Metric.ball y ρ, F n x) atTop (𝓝 0))
    (L : Set E3) (hL : IsCompact L) (hLS : L ⊆ S) :
    Tendsto (fun n => ∫ x in L, F n x) atTop (𝓝 0) :=
by
  classical
  choose! ρ hρpos hρsub hρlim using hloc
  obtain ⟨t, htL, hcov⟩ := hL.elim_nhds_subcover (fun y => Metric.ball y (ρ y))
    (fun y hy => Metric.ball_mem_nhds y (hρpos y (hLS hy)))
  have hLmeas : MeasurableSet L := hL.measurableSet
  have hint : ∀ n, ∀ y ∈ t,
      MeasureTheory.Integrable ((Metric.ball y (ρ y)).indicator (F n)) := by
    intro n y hy
    have h1 : MeasureTheory.IntegrableOn (F n) (Metric.closedBall y (ρ y)) :=
      ((hFc n).mono (hρsub y (hLS (htL y hy)))).integrableOn_compact
        (isCompact_closedBall y (ρ y))
    exact (MeasureTheory.integrable_indicator_iff measurableSet_ball).2
      (h1.mono_set Metric.ball_subset_closedBall)
  have hbound : ∀ n, ∫ x in L, F n x ≤ ∑ y ∈ t, ∫ x in Metric.ball y (ρ y), F n x := by
    intro n
    rw [← MeasureTheory.integral_indicator hLmeas]
    have hsum : ∑ y ∈ t, ∫ x in Metric.ball y (ρ y), F n x
        = ∫ x, ∑ y ∈ t, (Metric.ball y (ρ y)).indicator (F n) x := by
      rw [MeasureTheory.integral_finset_sum t (fun y hy => hint n y hy)]
      refine Finset.sum_congr rfl fun y _ => ?_
      rw [MeasureTheory.integral_indicator measurableSet_ball]
    rw [hsum]
    refine MeasureTheory.integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun x => Set.indicator_nonneg (fun x _ => hF0 n x) x)
      (MeasureTheory.integrable_finset_sum t fun y hy => hint n y hy)
      (Filter.Eventually.of_forall fun x => ?_)
    show L.indicator (F n) x ≤ ∑ y ∈ t, (Metric.ball y (ρ y)).indicator (F n) x
    have hnn : ∀ y ∈ t, 0 ≤ (Metric.ball y (ρ y)).indicator (F n) x :=
      fun y _ => Set.indicator_nonneg (fun x _ => hF0 n x) x
    by_cases hx : x ∈ L
    · obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.1 (hcov hx)
      rw [Set.indicator_of_mem hx]
      calc F n x = (Metric.ball y (ρ y)).indicator (F n) x :=
            (Set.indicator_of_mem hxy _).symm
        _ ≤ ∑ y ∈ t, (Metric.ball y (ρ y)).indicator (F n) x :=
          Finset.single_le_sum hnn hy
    · rw [Set.indicator_of_notMem hx]
      exact Finset.sum_nonneg hnn
  have hlim : Tendsto (fun n => ∑ y ∈ t, ∫ x in Metric.ball y (ρ y), F n x) atTop (𝓝 0) := by
    have := tendsto_finset_sum t fun y hy => hρlim y (hLS (htL y hy))
    simpa using this
  exact squeeze_zero (fun n => MeasureTheory.setIntegral_nonneg hLmeas fun x _ => hF0 n x)
    hbound hlim

theorem cls_weak_limit_regular [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (h : RiemannianMetric3 M) (V f : M → ℝ)
    (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hf : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f)
    (u : ℕ → M → ℝ) (hu : ∀ n, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n))
    (hC : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L : Set E3),
      IsCompact L → L ⊆ ψ.source → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m, N ≤ m → ∀ n, N ≤ n →
        ∫ y in L, ((u n (ψ y) - u m (ψ y)) ^ 2 + ∑ i : Fin 3,
          (partialDeriv i (fun z => u n (ψ z)) y
            - partialDeriv i (fun z => u m (ψ z)) y) ^ 2) < ε)
    (hEL : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (ζ : E3 → ℝ),
      ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ψ.source →
      Tendsto (fun n => ∫ y, (8 * ∑ a : Fin 3, ∑ b : Fin 3, (h.coeff ψ y)⁻¹ a b *
            partialDeriv b (fun z => u n (ψ z)) y * partialDeriv a ζ y
          + (V (ψ y) * u n (ψ y) - f (ψ y)) * ζ y) * Real.sqrt (h.coeff ψ y).det)
        atTop (𝓝 0)) :
    ∃ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧
      (∀ p : M, -8 * h.lapM v p + V p * v p = f p) ∧
      ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L : Set E3),
        IsCompact L → L ⊆ ψ.source →
        Tendsto (fun n => ∫ y in L, ((u n (ψ y) - v (ψ y)) ^ 2 + ∑ i : Fin 3,
          (partialDeriv i (fun z => u n (ψ z)) y
            - partialDeriv i (fun z => v (ψ z)) y) ^ 2)) atTop (𝓝 0) :=
by
  classical
  
  let ψc : M → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ := fun p =>
    PartialDiffeomorph.mk (chartAt E3 p).symm.toPartialEquiv (chartAt E3 p).open_target
      (chartAt E3 p).open_source contMDiffOn_chart_symm contMDiffOn_chart
  have hrad : ∀ p : M, ∃ r : ℝ, 0 < r ∧
      Metric.closedBall (chartAt E3 p p) r ⊆ (ψc p).source := by
    intro p
    obtain ⟨ε, hε, hball⟩ :=
      Metric.isOpen_iff.1 (chartAt E3 p).open_target (chartAt E3 p p) (mem_chart_target E3 p)
    exact ⟨ε / 2, half_pos hε, (Metric.closedBall_subset_ball (half_lt_self hε)).trans hball⟩
  choose r hr hrB using hrad
  have hsol := fun p => cwl_chart_solution h V f hV hf u hu hC hEL (ψc p) (chartAt E3 p p) (r p)
    (hr p) (hrB p)
  choose w hw_sm hw_eq hw_m0 hw_m1 hw_t0 hw_t1 using hsol
  let v : M → ℝ := fun q => w q (chartAt E3 q q)
  have hBs : ∀ p : M, Metric.ball (chartAt E3 p p) (r p / 4) ⊆ (ψc p).source := fun p =>
    (Metric.ball_subset_closedBall.trans
      (Metric.closedBall_subset_closedBall (by linarith [hr p]))).trans (hrB p)
  have hcen : ∀ p : M, chartAt E3 p p ∈ Metric.ball (chartAt E3 p p) (r p / 4) := fun p =>
    Metric.mem_ball_self (by linarith [hr p])
  
  have hrep : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (U : Set E3) (wU : E3 → ℝ),
      IsOpen U → U ⊆ ψ.source → ContinuousOn wU U →
      (∀ n, MemLp (fun x => u n (ψ x) - wU x) 2 (volume.restrict U)) →
      Tendsto (fun n => ∫ x in U, (u n (ψ x) - wU x) ^ 2) atTop (𝓝 0) →
      ∀ y ∈ U, v (ψ y) = wU y := by
    intro ψ U wU hUo hUs hwc hm ht y hy
    have heq : (ψc (ψ y)) (chartAt E3 (ψ y) (ψ y)) = ψ y :=
      (chartAt E3 (ψ y)).left_inv (mem_chart_source E3 (ψ y))
    exact cwl_chart_compat u (ψc (ψ y)) ψ _ U Metric.isOpen_ball hUo (hBs (ψ y)) hUs (w (ψ y)) wU
      (hw_sm (ψ y)).continuousOn hwc (hw_m0 (ψ y)) hm (hw_t0 (ψ y)) ht _ (hcen (ψ y)) y hy heq
  have hstar : ∀ p : M, ∀ y ∈ Metric.ball (chartAt E3 p p) (r p / 4),
      v ((chartAt E3 p).symm y) = w p y := fun p y hy =>
    hrep (ψc p) _ (w p) Metric.isOpen_ball (hBs p) (hw_sm p).continuousOn (hw_m0 p) (hw_t0 p) y hy
  
  have hv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v := by
    apply contMDiff_of_locally_contMDiffOn
    intro p
    refine ⟨(chartAt E3 p).source ∩ (chartAt E3 p) ⁻¹' Metric.ball (chartAt E3 p p) (r p / 4),
      (chartAt E3 p).continuousOn.isOpen_inter_preimage (chartAt E3 p).open_source
        Metric.isOpen_ball, ⟨mem_chart_source E3 p, hcen p⟩, ?_⟩
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w p) (Metric.ball (chartAt E3 p p) (r p / 4)) :=
      contMDiffOn_iff_contDiffOn.2 (hw_sm p)
    have hon : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun z => w p (chartAt E3 p z))
        ((chartAt E3 p).source ∩ (chartAt E3 p) ⁻¹' Metric.ball (chartAt E3 p p) (r p / 4)) :=
      h1.comp (contMDiffOn_chart.mono Set.inter_subset_left) (fun z hz => hz.2)
    refine hon.congr ?_
    intro z hz
    have h2 := hstar p (chartAt E3 p z) hz.2
    rw [(chartAt E3 p).left_inv hz.1] at h2
    exact h2
  
  have hloc : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (φ₁ φ₂ : E3 → ℝ) (x : E3),
      φ₁ =ᶠ[𝓝 x] φ₂ → lapLoc G φ₁ x = lapLoc G φ₂ x := by
    intro G φ₁ φ₂ x hφ
    have h1 : ∀ k, partialDeriv k φ₁ x = partialDeriv k φ₂ x := fun k => by
      show fderiv ℝ φ₁ x (e k) = fderiv ℝ φ₂ x (e k)
      rw [hφ.fderiv_eq]
    have h2 : ∀ j, partialDeriv j φ₁ =ᶠ[𝓝 x] partialDeriv j φ₂ := fun j =>
      hφ.eventuallyEq_nhds.mono fun y hy => by
        show fderiv ℝ φ₁ y (e j) = fderiv ℝ φ₂ y (e j)
        rw [hy.fderiv_eq]
    have h3 : ∀ i j, partialDeriv i (partialDeriv j φ₁) x = partialDeriv i (partialDeriv j φ₂) x :=
      fun i j => by
        show fderiv ℝ (partialDeriv j φ₁) x (e i) = fderiv ℝ (partialDeriv j φ₂) x (e i)
        rw [(h2 j).fderiv_eq]
    simp only [lapLoc, hessLoc, h1, h3]
  
  have heqn : ∀ p : M, -8 * h.lapM v p + V p * v p = f p := by
    intro p
    have hev : (fun y => v ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)] w p := by
      filter_upwards [Metric.isOpen_ball.mem_nhds (hcen p)] with y hy
      exact hstar p y hy
    have hlap : h.lapM v p = lapLoc (h.coeff (ψc p)) (w p) (chartAt E3 p p) := by
      show lapLoc (h.coeff (chartAt E3 p).symm) (fun y => v ((chartAt E3 p).symm y))
        (chartAt E3 p p) = _
      exact hloc _ _ _ _ hev
    have heq0 := hw_eq p (chartAt E3 p p) (hcen p)
    have hψc : (ψc p) (chartAt E3 p p) = p := (chartAt E3 p).left_inv (mem_chart_source E3 p)
    rw [hψc] at heq0
    rw [hlap]
    exact heq0
  
  refine ⟨v, hv, heqn, ?_⟩
  intro ψ L hL hLs
  have hcont_u := fun n => nds_chart_cont h ψ (u n) (u n) (hu n) (hu n)
  have hcont_v := nds_chart_cont h ψ v v hv hv
  refine cwl_local_to_compact ψ.source ψ.open_source
    (fun n y => (u n (ψ y) - v (ψ y)) ^ 2 + ∑ i : Fin 3,
      (partialDeriv i (fun z => u n (ψ z)) y - partialDeriv i (fun z => v (ψ z)) y) ^ 2)
    (fun n x => add_nonneg (sq_nonneg _) (Finset.sum_nonneg fun i _ => sq_nonneg _)) ?_ ?_
    L hL hLs
  · intro n
    refine ContinuousOn.add (((hcont_u n).1.continuousOn.sub hcont_v.1.continuousOn).pow 2) ?_
    exact continuousOn_finset_sum _ fun i _ => (((hcont_u n).2.1 i).sub (hcont_v.2.1 i)).pow 2
  · intro y hy
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 ψ.open_source y hy
    have hB : Metric.closedBall y (ε / 2) ⊆ ψ.source :=
      (Metric.closedBall_subset_ball (half_lt_self hε)).trans hball
    obtain ⟨w', hw'sm, -, hw'm0, hw'm1, hw't0, hw't1⟩ :=
      cwl_chart_solution h V f hV hf u hu hC hEL ψ y (ε / 2) (half_pos hε) hB
    have hsub : Metric.closedBall y (ε / 2 / 4) ⊆ ψ.source :=
      (Metric.closedBall_subset_closedBall (by linarith)).trans hB
    have hBs' : Metric.ball y (ε / 2 / 4) ⊆ ψ.source := Metric.ball_subset_closedBall.trans hsub
    have hrep' : ∀ x ∈ Metric.ball y (ε / 2 / 4), v (ψ x) = w' x :=
      hrep ψ _ w' Metric.isOpen_ball hBs' hw'sm.continuousOn hw'm0 hw't0
    have hpd : ∀ x ∈ Metric.ball y (ε / 2 / 4), ∀ i : Fin 3,
        partialDeriv i (fun z => v (ψ z)) x = partialDeriv i w' x := by
      intro x hx i
      have hev : (fun z => v (ψ z)) =ᶠ[𝓝 x] w' := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hx] with z hz
        exact hrep' z hz
      show fderiv ℝ _ x (e i) = fderiv ℝ _ x (e i)
      rw [hev.fderiv_eq]
    refine ⟨ε / 2 / 4, by positivity, hsub, ?_⟩
    show Tendsto (fun n => ∫ x in Metric.ball y (ε / 2 / 4), ((u n (ψ x) - v (ψ x)) ^ 2 +
      ∑ i : Fin 3, (partialDeriv i (fun z => u n (ψ z)) x
        - partialDeriv i (fun z => v (ψ z)) x) ^ 2)) atTop (𝓝 0)
    have hint : ∀ n, (∫ x in Metric.ball y (ε / 2 / 4), ((u n (ψ x) - v (ψ x)) ^ 2 +
        ∑ i : Fin 3, (partialDeriv i (fun z => u n (ψ z)) x
          - partialDeriv i (fun z => v (ψ z)) x) ^ 2)) =
        (∫ x in Metric.ball y (ε / 2 / 4), (u n (ψ x) - w' x) ^ 2) +
          ∑ i : Fin 3, ∫ x in Metric.ball y (ε / 2 / 4),
            (partialDeriv i (fun z => u n (ψ z)) x - partialDeriv i w' x) ^ 2 := by
      intro n
      have e1 : (∫ x in Metric.ball y (ε / 2 / 4), ((u n (ψ x) - v (ψ x)) ^ 2 +
          ∑ i : Fin 3, (partialDeriv i (fun z => u n (ψ z)) x
            - partialDeriv i (fun z => v (ψ z)) x) ^ 2)) =
          ∫ x in Metric.ball y (ε / 2 / 4), ((u n (ψ x) - w' x) ^ 2 +
            ∑ i : Fin 3, (partialDeriv i (fun z => u n (ψ z)) x - partialDeriv i w' x) ^ 2) := by
        refine setIntegral_congr_fun Metric.isOpen_ball.measurableSet fun x hx => ?_
        simp only [hrep' x hx, hpd x hx]
      rw [e1, integral_add (hw'm0 n).integrable_sq
        (integrable_finset_sum _ fun i _ => (hw'm1 n i).integrable_sq),
        integral_finset_sum _ fun i _ => (hw'm1 n i).integrable_sq]
    have hlim := hw't0.add (tendsto_finset_sum Finset.univ fun i _ => hw't1 i)
    have h0 : (0 : ℝ) + ∑ i : Fin 3, (0 : ℝ) = 0 := by simp
    rw [h0] at hlim
    exact hlim.congr fun n => (hint n).symm

theorem cls_limit_chart_bound [IsManifold 𝓘(ℝ, E3) ∞ M]
    (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : ℕ → M → ℝ) (v : M → ℝ) (a : ℝ),
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v → (∀ n, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n)) →
      (∀ n, ∫ y in K, ((u n (φ y)) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (fun z => u n (φ z)) y) ^ 2) ≤ a) →
      Tendsto (fun n => ∫ y in K, ((u n (φ y) - v (φ y)) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (fun z => u n (φ z)) y
          - partialDeriv i (fun z => v (φ z)) y) ^ 2)) atTop (𝓝 0) →
      ∫ y in K, (|v (φ y)| + ‖fderiv ℝ (fun z => v (φ z)) y‖) ≤ C * Real.sqrt a :=
by
  have hm0 : 0 ≤ (volume : Measure E3).real K := measureReal_nonneg
  refine ⟨2 * ((volume : Measure E3).real K + 1), by linarith, ?_⟩
  intro u v a hv hu hE hconv
  
  have hreg : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      ContinuousOn (fun z => f (φ z)) φ.source ∧
        ContinuousOn (fun y => fderiv ℝ (fun z => f (φ z)) y) φ.source := by
    intro f hf
    have h1 : ContDiffOn ℝ ∞ (fun z => f (φ z)) φ.source :=
      contMDiffOn_iff_contDiffOn.mp (hf.comp_contMDiffOn φ.contMDiffOn_toFun)
    exact ⟨h1.continuousOn,
      h1.continuousOn_fderiv_of_isOpen φ.open_source (by exact_mod_cast le_top)⟩
  
  have hop : ∀ L : E3 →L[ℝ] ℝ, ‖L‖ ≤ ∑ i : Fin 3, |L (e i)| := by
    intro L
    refine ContinuousLinearMap.opNorm_le_bound L
      (Finset.sum_nonneg fun i _ => abs_nonneg _) fun x => ?_
    have hx := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr x
    simp only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] at hx
    have hLx : L x = ∑ i : Fin 3, x.ofLp i * L (e i) := by
      conv_lhs => rw [← hx]
      rw [map_sum]
      simp only [map_smul, smul_eq_mul]
    rw [Real.norm_eq_abs, hLx, Finset.sum_mul]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [abs_mul, mul_comm (|x.ofLp i|)]
    have hxi : |x.ofLp i| ≤ ‖x‖ := by
      have := PiLp.norm_apply_le x i
      rwa [Real.norm_eq_abs] at this
    exact mul_le_mul_of_nonneg_left hxi (abs_nonneg _)
  
  have main : ∀ (w : E3 → ℝ) (W : ℕ → E3 → ℝ),
      ContinuousOn w φ.source → ContinuousOn (fun y => fderiv ℝ w y) φ.source →
      (∀ n, ContinuousOn (W n) φ.source) →
      (∀ n, ContinuousOn (fun y => fderiv ℝ (W n) y) φ.source) →
      (∀ n, ∫ y in K, ((W n y) ^ 2 + ∑ i : Fin 3, (partialDeriv i (W n) y) ^ 2) ≤ a) →
      Tendsto (fun n => ∫ y in K, ((W n y - w y) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (W n) y - partialDeriv i w y) ^ 2)) atTop (𝓝 0) →
      ∫ y in K, (|w y| + ‖fderiv ℝ w y‖) ≤
        2 * ((volume : Measure E3).real K + 1) * Real.sqrt a := by
    intro w W hwc hwd hWc hWd hE hconv
    have hKm : MeasurableSet K := hK.measurableSet
    have hint : ∀ f : E3 → ℝ, ContinuousOn f φ.source → IntegrableOn f K :=
      fun f hf => (hf.mono hKφ).integrableOn_compact hK
    have hpw : ∀ i, ContinuousOn (fun y => partialDeriv i w y) φ.source := by
      intro i; unfold partialDeriv; exact hwd.clm_apply continuousOn_const
    have hpW : ∀ n i, ContinuousOn (fun y => partialDeriv i (W n) y) φ.source := by
      intro n i; unfold partialDeriv; exact (hWd n).clm_apply continuousOn_const
    have hEwc : ContinuousOn
        (fun y => (w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2) φ.source :=
      (hwc.pow 2).add (continuousOn_finset_sum _ fun i _ => (hpw i).pow 2)
    have hEWc : ∀ n, ContinuousOn
        (fun y => (W n y) ^ 2 + ∑ i : Fin 3, (partialDeriv i (W n) y) ^ 2) φ.source :=
      fun n => ((hWc n).pow 2).add (continuousOn_finset_sum _ fun i _ => (hpW n i).pow 2)
    have hDc : ∀ n, ContinuousOn (fun y => (W n y - w y) ^ 2 + ∑ i : Fin 3,
        (partialDeriv i (W n) y - partialDeriv i w y) ^ 2) φ.source :=
      fun n => (((hWc n).sub hwc).pow 2).add
        (continuousOn_finset_sum _ fun i _ => ((hpW n i).sub (hpw i)).pow 2)
    have ha : 0 ≤ a := by
      refine le_trans ?_ (hE 0)
      exact setIntegral_nonneg hKm fun y _ =>
        add_nonneg (sq_nonneg _) (Finset.sum_nonneg fun i _ => sq_nonneg _)
    
    have hEw : ∫ y in K, ((w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2) ≤ 2 * a := by
      have hstep : ∀ n, ∫ y in K, ((w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2) ≤
          2 * a + 2 * ∫ y in K, ((W n y - w y) ^ 2 + ∑ i : Fin 3,
            (partialDeriv i (W n) y - partialDeriv i w y) ^ 2) := by
        intro n
        have h1 : ∫ y in K, ((w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2) ≤
            ∫ y in K, (2 * ((W n y) ^ 2 + ∑ i : Fin 3, (partialDeriv i (W n) y) ^ 2) +
              2 * ((W n y - w y) ^ 2 + ∑ i : Fin 3,
                (partialDeriv i (W n) y - partialDeriv i w y) ^ 2)) := by
          refine setIntegral_mono_on (hint _ hEwc)
            (hint _ ((continuousOn_const.mul (hEWc n)).add (continuousOn_const.mul (hDc n))))
            hKm ?_
          intro y _
          simp only [Fin.sum_univ_three]
          nlinarith [sq_nonneg (2 * W n y - w y),
            sq_nonneg (2 * partialDeriv 0 (W n) y - partialDeriv 0 w y),
            sq_nonneg (2 * partialDeriv 1 (W n) y - partialDeriv 1 w y),
            sq_nonneg (2 * partialDeriv 2 (W n) y - partialDeriv 2 w y)]
        rw [integral_add (hint _ (continuousOn_const.mul (hEWc n)))
          (hint _ (continuousOn_const.mul (hDc n))),
          integral_const_mul, integral_const_mul] at h1
        linarith [hE n]
      have hlim : Tendsto (fun n => 2 * a + 2 * ∫ y in K, ((W n y - w y) ^ 2 + ∑ i : Fin 3,
            (partialDeriv i (W n) y - partialDeriv i w y) ^ 2)) atTop (𝓝 (2 * a + 2 * 0)) :=
        (hconv.const_mul 2).const_add (2 * a)
      have := ge_of_tendsto' hlim hstep
      linarith
    
    have hH : ∀ t : ℝ, 0 < t → ∫ y in K, (|w y| + ‖fderiv ℝ w y‖) ≤
        (volume : Measure E3).real K * t + 2 * a / t := by
      intro t ht
      have h1 : ∫ y in K, (|w y| + ‖fderiv ℝ w y‖) ≤
          ∫ y in K, (t + ((w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2) / t) := by
        refine setIntegral_mono_on (hint _ (hwc.abs.add hwd.norm))
          (hint _ (continuousOn_const.add (hEwc.div_const t))) hKm ?_
        intro y _
        have hb' : ‖fderiv ℝ w y‖ ≤ ∑ i : Fin 3, |partialDeriv i w y| := hop (fderiv ℝ w y)
        simp only [Fin.sum_univ_three] at hb' ⊢
        rw [add_div' _ _ _ ht.ne', le_div_iff₀ ht]
        nlinarith [mul_le_mul_of_nonneg_right hb' ht.le,
          sq_nonneg (2 * |w y| - t), sq_nonneg (2 * |partialDeriv 0 w y| - t),
          sq_nonneg (2 * |partialDeriv 1 w y| - t), sq_nonneg (2 * |partialDeriv 2 w y| - t),
          sq_abs (w y), sq_abs (partialDeriv 0 w y), sq_abs (partialDeriv 1 w y),
          sq_abs (partialDeriv 2 w y)]
      rw [integral_add (hint _ continuousOn_const) (hint _ (hEwc.div_const t)),
        setIntegral_const, integral_div, smul_eq_mul] at h1
      have h2 : (∫ y in K, ((w y) ^ 2 + ∑ i : Fin 3, (partialDeriv i w y) ^ 2)) / t ≤
          2 * a / t := (div_le_div_iff_of_pos_right ht).2 hEw
      linarith
    
    refine le_of_forall_pos_le_add fun ε hε => ?_
    have hm : 0 ≤ (volume : Measure E3).real K := measureReal_nonneg
    have hs : 0 < ε / ((volume : Measure E3).real K + 1) := div_pos hε (by linarith)
    have hs1 : ε / ((volume : Measure E3).real K + 1) * ((volume : Measure E3).real K + 1)
        = ε := div_mul_cancel₀ ε (by linarith)
    have hsa : 0 ≤ Real.sqrt a := Real.sqrt_nonneg a
    have hsq : Real.sqrt a * Real.sqrt a = a := Real.mul_self_sqrt ha
    have ht : 0 < Real.sqrt a + ε / ((volume : Measure E3).real K + 1) := by linarith
    have h3 := hH _ ht
    have h4 : 2 * a / (Real.sqrt a + ε / ((volume : Measure E3).real K + 1)) ≤
        2 * Real.sqrt a := by
      rw [div_le_iff₀ ht]
      nlinarith [mul_nonneg hsa hs.le]
    nlinarith [mul_nonneg hm hsa, mul_nonneg hm hs.le]
  have hv' := hreg v hv
  have hu' := fun n => hreg (u n) (hu n)
  exact main (fun z => v (φ z)) (fun n z => u n (φ z)) hv'.1 hv'.2
    (fun n => (hu' n).1) (fun n => (hu' n).2) hE hconv

theorem cld_hardy_transfer (ρ : ℝ) (hρ : 1 < ρ) (I : ℝ) (U : ℕ → E3 → ℝ) (w : E3 → ℝ)
    (D : ℕ → E3 → ℝ)
    (hU : ∀ n, ContinuousOn (U n) {y : E3 | 1 < ‖y‖})
    (hw : ContinuousOn w {y : E3 | 1 < ‖y‖})
    (hD : ∀ n, ContinuousOn (D n) {y : E3 | 1 < ‖y‖}) (hD0 : ∀ n y, 0 ≤ D n y)
    (hH : ∀ (n : ℕ) (R : ℝ), ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < R}, (U n y) ^ 2 / ‖y‖ ^ 2 ≤ I)
    (hconv : ∀ L : Set E3, IsCompact L → L ⊆ {y : E3 | 1 < ‖y‖} →
      Tendsto (fun n => ∫ y in L, ((U n y - w y) ^ 2 + D n y)) atTop (𝓝 0)) :
    0 ≤ I ∧ ∀ R : ℝ, ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < R}, (w y) ^ 2 / ‖y‖ ^ 2 ≤ 2 * I :=
by
  have hρ0 : 0 < ρ := by linarith
  have alg : ∀ u v r d : ℝ, ρ < r → 0 ≤ d →
      v ^ 2 / r ^ 2 ≤ 2 * (u ^ 2 / r ^ 2) + 2 / ρ ^ 2 * ((u - v) ^ 2 + d) := by
    intro u v r d hr hd
    have hr0 : 0 < r := by linarith
    have hr2 : 0 < r ^ 2 := by positivity
    have hρ2 : 0 < ρ ^ 2 := by positivity
    have hρr : ρ ^ 2 ≤ r ^ 2 := by nlinarith
    have key : v ^ 2 ≤ 2 * u ^ 2 + 2 * (u - v) ^ 2 := by nlinarith [sq_nonneg (2 * u - v)]
    have h1 : v ^ 2 / r ^ 2 ≤ 2 * (u ^ 2 / r ^ 2) + 2 * ((u - v) ^ 2 / r ^ 2) := by
      calc v ^ 2 / r ^ 2 ≤ (2 * u ^ 2 + 2 * (u - v) ^ 2) / r ^ 2 :=
            div_le_div_of_nonneg_right key hr2.le
        _ = 2 * (u ^ 2 / r ^ 2) + 2 * ((u - v) ^ 2 / r ^ 2) := by ring
    have h2 : (u - v) ^ 2 / r ^ 2 ≤ ((u - v) ^ 2 + d) / ρ ^ 2 :=
      div_le_div₀ (by positivity) (by linarith) hρ2 hρr
    have h3 : 2 / ρ ^ 2 * ((u - v) ^ 2 + d) = 2 * (((u - v) ^ 2 + d) / ρ ^ 2) := by ring
    rw [h3]; linarith
  refine ⟨?_, ?_⟩
  · have h := hH 0 ρ
    have hemp : {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < ρ} = ∅ := by
      ext y
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false, not_and, not_lt]
      intro h1; exact h1.le
    rw [hemp, setIntegral_empty] at h
    exact h
  · intro R
    set A : Set E3 := {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < R} with hAdef
    set L : Set E3 := {y : E3 | ρ ≤ ‖y‖} ∩ Metric.closedBall 0 R with hLdef
    have hLc : IsCompact L :=
      (isCompact_closedBall 0 R).inter_left (isClosed_le continuous_const continuous_norm)
    have hLΩ : L ⊆ {y : E3 | 1 < ‖y‖} := fun y hy => lt_of_lt_of_le hρ hy.1
    have hAL : A ⊆ L := fun y hy => ⟨hy.1.le, mem_closedBall_zero_iff.mpr hy.2.le⟩
    have hAm : MeasurableSet A :=
      (measurableSet_lt measurable_const measurable_norm).inter
        (measurableSet_lt measurable_norm measurable_const)
    have hne : ∀ y ∈ L, ‖y‖ ^ 2 ≠ 0 := by
      intro y hy
      have h1 : ρ ≤ ‖y‖ := hy.1
      have h2 : (0 : ℝ) < ‖y‖ := by linarith
      exact pow_ne_zero 2 h2.ne'
    have hwc : ContinuousOn (fun y => w y ^ 2 / ‖y‖ ^ 2) L :=
      ((hw.mono hLΩ).pow 2).div (continuous_norm.pow 2).continuousOn hne
    have hUc : ∀ n, ContinuousOn (fun y => U n y ^ 2 / ‖y‖ ^ 2) L := fun n =>
      (((hU n).mono hLΩ).pow 2).div (continuous_norm.pow 2).continuousOn hne
    have hgc : ∀ n, ContinuousOn (fun y => (U n y - w y) ^ 2 + D n y) L := fun n =>
      ((((hU n).sub hw).pow 2).add (hD n)).mono hLΩ
    have hwi : IntegrableOn (fun y => w y ^ 2 / ‖y‖ ^ 2) A :=
      (hwc.integrableOn_compact hLc).mono_set hAL
    have hUi : ∀ n, IntegrableOn (fun y => U n y ^ 2 / ‖y‖ ^ 2) A := fun n =>
      ((hUc n).integrableOn_compact hLc).mono_set hAL
    have hgiL : ∀ n, IntegrableOn (fun y => (U n y - w y) ^ 2 + D n y) L := fun n =>
      (hgc n).integrableOn_compact hLc
    have hgi : ∀ n, IntegrableOn (fun y => (U n y - w y) ^ 2 + D n y) A := fun n =>
      (hgiL n).mono_set hAL
    have hbound : ∀ n : ℕ, ∫ y in A, w y ^ 2 / ‖y‖ ^ 2 ≤
        2 * I + 2 / ρ ^ 2 * ∫ y in L, ((U n y - w y) ^ 2 + D n y) := by
      intro n
      have hpt : ∀ y ∈ A, w y ^ 2 / ‖y‖ ^ 2 ≤
          2 * (U n y ^ 2 / ‖y‖ ^ 2) + 2 / ρ ^ 2 * ((U n y - w y) ^ 2 + D n y) :=
        fun y hy => alg (U n y) (w y) ‖y‖ (D n y) hy.1 (hD0 n y)
      have hi1 : IntegrableOn (fun y => 2 * (U n y ^ 2 / ‖y‖ ^ 2)) A :=
        Integrable.const_mul (hUi n) 2
      have hi2 : IntegrableOn (fun y => 2 / ρ ^ 2 * ((U n y - w y) ^ 2 + D n y)) A :=
        Integrable.const_mul (hgi n) (2 / ρ ^ 2)
      have hRi : IntegrableOn (fun y => 2 * (U n y ^ 2 / ‖y‖ ^ 2) +
          2 / ρ ^ 2 * ((U n y - w y) ^ 2 + D n y)) A := Integrable.add hi1 hi2
      have hm1 := setIntegral_mono_on hwi hRi hAm hpt
      rw [integral_add hi1 hi2, integral_const_mul, integral_const_mul] at hm1
      have hH' : ∫ y in A, U n y ^ 2 / ‖y‖ ^ 2 ≤ I := hH n R
      have hmono : ∫ y in A, ((U n y - w y) ^ 2 + D n y) ≤
          ∫ y in L, ((U n y - w y) ^ 2 + D n y) :=
        setIntegral_mono_set (hgiL n)
          (Filter.Eventually.of_forall fun y => add_nonneg (sq_nonneg _) (hD0 n y))
          hAL.eventuallyLE
      have hc : (0 : ℝ) ≤ 2 / ρ ^ 2 := by positivity
      have h4 := mul_le_mul_of_nonneg_left hmono hc
      linarith
    have ht : Tendsto (fun n : ℕ => 2 * I + 2 / ρ ^ 2 * ∫ y in L, ((U n y - w y) ^ 2 + D n y))
        atTop (𝓝 (2 * I)) := by
      have h := ((hconv L hLc hLΩ).const_mul (2 / ρ ^ 2)).const_add (2 * I)
      rw [mul_zero, add_zero] at h
      exact h
    exact ge_of_tendsto' ht hbound

theorem cld_scaled_gradient : ∃ ε₁ C₂ : ℝ, 0 < ε₁ ∧ 0 ≤ C₂ ∧
    ∀ (W : E3 → ℝ) (a : E3 → Matrix (Fin 3) (Fin 3) ℝ) (b : E3 → Fin 3 → ℝ),
      ContDiffOn ℝ ∞ W (Metric.ball 0 2) →
      (∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
        (∀ i j : Fin 3, |a z i j - (if i = j then (1 : ℝ) else 0)| ≤ ε₁ ∧
           |a z i j - a z' i j| ≤ ε₁ * ‖z - z'‖) ∧
        (∀ k : Fin 3, |b z k| ≤ ε₁ ∧ |b z k - b z' k| ≤ ε₁ * ‖z - z'‖)) →
      (∀ z ∈ Metric.ball (0 : E3) 1,
        ∑ i : Fin 3, ∑ j : Fin 3, a z i j * partialDeriv i (fun y => partialDeriv j W y) z
          - ∑ k : Fin 3, b z k * partialDeriv k W z = 0) →
      ∀ (x : E3) (d K : ℝ), 0 < d → ‖x‖ + d ≤ 1 → (∀ y ∈ Metric.ball x d, |W y| ≤ K) →
        ∀ i : Fin 3, d * |partialDeriv i W x| ≤ C₂ * K :=
by
  obtain ⟨C_G, hCG, hG⟩ := holder_schauder_global
  obtain ⟨ε₀, C₀, hε₀, hC₀, hPB⟩ := perturbed_ball_estimate C_G hCG hG
  refine ⟨ε₀, C₀, hε₀, hC₀, ?_⟩
  intro W a b hW hcoef heq x d K hd hxd hK i
  have hd1 : d ≤ 1 := by linarith [norm_nonneg x]
  have hK0 : 0 ≤ K := (abs_nonneg _).trans (hK x (Metric.mem_ball_self hd))
  have hTn : ∀ z : E3, ‖x + d • z‖ ≤ ‖x‖ + d * ‖z‖ := by
    intro z
    calc ‖x + d • z‖ ≤ ‖x‖ + ‖d • z‖ := norm_add_le _ _
      _ = ‖x‖ + d * ‖z‖ := by rw [norm_smul, Real.norm_of_nonneg hd.le]
  have hT2 : ∀ z : E3, ‖z‖ < 2 → x + d • z ∈ Metric.ball (0 : E3) 2 := by
    intro z hz
    rw [mem_ball_zero_iff]
    have h1 := hTn z
    have h2 : d * ‖z‖ < d * 2 := mul_lt_mul_of_pos_left hz hd
    linarith
  have hT1 : ∀ z : E3, ‖z‖ < 1 → x + d • z ∈ Metric.ball (0 : E3) 1 := by
    intro z hz
    rw [mem_ball_zero_iff]
    have h1 := hTn z
    have h2 : d * ‖z‖ < d * 1 := mul_lt_mul_of_pos_left hz hd
    linarith
  have hTx : ∀ z : E3, ‖z‖ < 1 → x + d • z ∈ Metric.ball x d := by
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hd.le]
    have h2 : d * ‖z‖ < d * 1 := mul_lt_mul_of_pos_left hz hd
    linarith
  have hdiff : ∀ z z' : E3, ‖(x + d • z) - (x + d • z')‖ = d * ‖z - z'‖ := by
    intro z z'
    rw [add_sub_add_left_eq_sub, ← smul_sub, norm_smul, Real.norm_of_nonneg hd.le]
  have hmaps : Set.MapsTo (fun z : E3 => x + d • z) (Metric.ball 0 2) (Metric.ball 0 2) := by
    intro z hz
    exact hT2 z (mem_ball_zero_iff.mp hz)
  have hWt : ContDiffOn ℝ ∞ (fun z => W (x + d • z)) (Metric.ball 0 2) :=
    hW.comp (contDiff_const.add (contDiff_id.const_smul d)).contDiffOn hmaps
  have hsup : ∀ z ∈ Metric.ball (0 : E3) 1, |W (x + d • z)| ≤ K := by
    intro z hz
    exact hK _ (hTx z (mem_ball_zero_iff.mp hz))
  have hcoef' : ∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
      (∀ i j : Fin 3, |a (x + d • z) i j - (if i = j then (1 : ℝ) else 0)| ≤ ε₀ ∧
         |a (x + d • z) i j - a (x + d • z') i j| ≤ ε₀ * ‖z - z'‖) ∧
      (∀ k : Fin 3, |d * b (x + d • z) k| ≤ ε₀ ∧
         |d * b (x + d • z) k - d * b (x + d • z') k| ≤ ε₀ * ‖z - z'‖) ∧
      |(0 : ℝ)| ≤ K ∧ |(0 : ℝ) - 0| ≤ K * ‖z - z'‖ := by
    intro z hz z' hz'
    have hp := hT1 z (mem_ball_zero_iff.mp hz)
    have hp' := hT1 z' (mem_ball_zero_iff.mp hz')
    obtain ⟨ha, hb⟩ := hcoef _ hp _ hp'
    have hn := hdiff z z'
    have hnn : 0 ≤ ‖z - z'‖ := norm_nonneg _
    have hstep : ε₀ * (d * ‖z - z'‖) ≤ ε₀ * ‖z - z'‖ :=
      mul_le_mul_of_nonneg_left (mul_le_of_le_one_left hnn hd1) hε₀.le
    refine ⟨fun i j => ⟨(ha i j).1, ?_⟩, fun k => ⟨?_, ?_⟩, ?_, ?_⟩
    · have h1 := (ha i j).2
      rw [hn] at h1
      exact h1.trans hstep
    · rw [abs_mul, abs_of_pos hd]
      exact (mul_le_of_le_one_left (abs_nonneg _) hd1).trans (hb k).1
    · rw [← mul_sub, abs_mul, abs_of_pos hd]
      have h1 := (hb k).2
      rw [hn] at h1
      exact (mul_le_of_le_one_left (abs_nonneg _) hd1).trans (h1.trans hstep)
    · rw [abs_zero]; exact hK0
    · rw [sub_self, abs_zero]; exact mul_nonneg hK0 hnn
  have heq' : ∀ z ∈ Metric.ball (0 : E3) 1,
      ∑ i : Fin 3, ∑ j : Fin 3, a (x + d • z) i j *
          partialDeriv i (fun y => partialDeriv j (fun y' => W (x + d • y')) y) z
        - ∑ k : Fin 3, d * b (x + d • z) k * partialDeriv k (fun y => W (x + d • y)) z = 0 := by
    intro z hz
    have hz1 : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
    have hp1 := hT1 z hz1
    have hp2 : x + d • z ∈ Metric.ball (0 : E3) 2 := hT2 z (by linarith)
    obtain ⟨h1, h2⟩ := rescale_partialDeriv W _ Metric.isOpen_ball hW x d z hp2
    have he := heq _ hp1
    simp only [h1, h2]
    simp only [Fin.sum_univ_three] at he ⊢
    linear_combination d ^ 2 * he
  have hfin := (hPB (fun z => W (x + d • z)) (fun z => a (x + d • z))
    (fun z k => d * b (x + d • z) k) (fun _ => (0 : ℝ)) ε₀ K hε₀.le le_rfl hK0 hWt hsup
    hcoef' heq').1 i
  have h0 := (rescale_partialDeriv W _ Metric.isOpen_ball hW x d 0 (hT2 0 (by simp))).1 i
  rw [smul_zero, add_zero] at h0
  rw [h0, abs_mul, abs_of_pos hd] at hfin
  exact hfin

theorem cld_sup_from_gradient (C₂ : ℝ) (hC₂ : 0 ≤ C₂) : ∃ C₃ : ℝ, 0 ≤ C₃ ∧
    ∀ W : E3 → ℝ, ContDiffOn ℝ ∞ W (Metric.ball 0 2) →
      (∀ (x : E3) (d K : ℝ), 0 < d → ‖x‖ + d ≤ 1 → (∀ y ∈ Metric.ball x d, |W y| ≤ K) →
        ∀ i : Fin 3, d * |partialDeriv i W x| ≤ C₂ * K) →
      W 0 ^ 2 ≤ C₃ * ∫ y in Metric.ball (0 : E3) 1, W y ^ 2 :=
by
  classical
  set vB : ℝ := (volume : Measure E3).real (Metric.ball (0 : E3) 1) with hvBdef
  have hvBpos : 0 < vB := by
    rw [hvBdef, measureReal_def]
    exact ENNReal.toReal_pos (Metric.measure_ball_pos volume 0 one_pos).ne'
      measure_ball_lt_top.ne
  have hvol : ∀ (x : E3) (r : ℝ), 0 < r →
      (volume : Measure E3).real (Metric.ball x r) = r ^ 3 * vB := by
    intro x r hr
    rw [hvBdef, measureReal_def, measureReal_def, Measure.addHaar_ball_of_pos volume x hr,
      finrank_euclideanSpace_fin, ENNReal.toReal_mul, ENNReal.toReal_ofReal (pow_nonneg hr.le 3)]
  set c : ℝ := 72 * C₂ + 4 with hcdef
  have hc4 : 4 ≤ c := by linarith
  have hcpos : 0 < c := by linarith
  have hc3 : 0 < c ^ 3 := pow_pos hcpos 3
  have hC3 : 0 ≤ 4 * c ^ 3 / vB := div_nonneg (by linarith) hvBpos.le
  refine ⟨4 * c ^ 3 / vB, hC3, ?_⟩
  intro W hW hgrad
  set E := ∫ y in Metric.ball (0 : E3) 1, W y ^ 2 with hEdef
  have hcl : ContinuousOn W (Metric.closedBall 0 1) :=
    hW.continuousOn.mono (Metric.closedBall_subset_ball (by norm_num))
  have hint1 : IntegrableOn (fun y => W y ^ 2) (Metric.ball (0 : E3) 1) :=
    ((hcl.pow 2).integrableOn_compact (isCompact_closedBall 0 1)).mono_set
      Metric.ball_subset_closedBall
  have hE : 0 ≤ E := setIntegral_nonneg measurableSet_ball (fun y _ => sq_nonneg _)
  have hdiff : ∀ y ∈ Metric.ball (0 : E3) 2, DifferentiableAt ℝ W y := fun y hy =>
    (hW.differentiableOn (by simp)).differentiableAt (Metric.isOpen_ball.mem_nhds hy)
  
  obtain ⟨x₀, hx₀, hmax⟩ := (isCompact_closedBall (0 : E3) 1).exists_isMaxOn
    (Metric.nonempty_closedBall.mpr zero_le_one)
    (f := fun x => (1 - ‖x‖) ^ 3 * W x ^ 2)
    (((continuous_const.sub continuous_norm).continuousOn.pow 3).mul (hcl.pow 2))
  have hm : ∀ y ∈ Metric.closedBall (0 : E3) 1,
      (1 - ‖y‖) ^ 3 * W y ^ 2 ≤ (1 - ‖x₀‖) ^ 3 * W x₀ ^ 2 :=
    isMaxOn_iff.mp hmax
  have hx₀n : ‖x₀‖ ≤ 1 := mem_closedBall_zero_iff.mp hx₀
  set d := 1 - ‖x₀‖ with hddef
  set a := |W x₀| with hadef
  have hd0 : 0 ≤ d := by linarith
  have ha0 : 0 ≤ a := abs_nonneg _
  have hWa : W x₀ ^ 2 = a ^ 2 := by rw [hadef, sq_abs]
  have h0 : W 0 ^ 2 ≤ d ^ 3 * a ^ 2 := by
    have := hm 0 (Metric.mem_closedBall_self zero_le_one)
    rw [← hWa]
    simpa using this
  refine h0.trans ?_
  have hEC : 0 ≤ 4 * c ^ 3 / vB * E := mul_nonneg hC3 hE
  rcases hd0.eq_or_lt with hd | hd
  · rw [← hd, zero_pow (by norm_num), zero_mul]; exact hEC
  rcases ha0.eq_or_lt with ha | ha
  · rw [← ha, zero_pow (by norm_num), mul_zero]; exact hEC
  have hd3 : 0 < d ^ 3 := pow_pos hd 3
  
  have hbd : ∀ y ∈ Metric.ball x₀ (d / 2), |W y| ≤ 3 * a := by
    intro y hy
    rw [Metric.mem_ball, dist_eq_norm] at hy
    have h1 := norm_sub_norm_le y x₀
    have hyc : y ∈ Metric.closedBall (0 : E3) 1 := mem_closedBall_zero_iff.mpr (by linarith)
    have h2 := hm y hyc
    have hdy : d / 2 ≤ 1 - ‖y‖ := by linarith
    have h3 : (d / 2) ^ 3 * W y ^ 2 ≤ d ^ 3 * a ^ 2 := by
      rw [← hWa]
      exact le_trans (mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ (by positivity) hdy 3) (sq_nonneg _)) h2
    have h5 : d ^ 3 * W y ^ 2 ≤ d ^ 3 * (8 * a ^ 2) := by
      have : (d / 2) ^ 3 = d ^ 3 / 8 := by ring
      rw [this] at h3
      linarith
    have h6 : W y ^ 2 ≤ 8 * a ^ 2 := le_of_mul_le_mul_left h5 hd3
    have h4 : W y ^ 2 ≤ (3 * a) ^ 2 := by nlinarith
    have := sq_le_sq.mp h4
    rwa [abs_of_nonneg (by linarith : (0 : ℝ) ≤ 3 * a)] at this
  
  have hpd : ∀ z ∈ Metric.ball x₀ (d / 4), ∀ k : Fin 3,
      |partialDeriv k W z| ≤ 12 * C₂ * a / d := by
    intro z hz k
    have hz' : dist z x₀ < d / 4 := hz
    have h1 := norm_sub_norm_le z x₀
    have hz'' : ‖z - x₀‖ < d / 4 := by rwa [dist_eq_norm] at hz'
    have hsub : ∀ y ∈ Metric.ball z (d / 4), |W y| ≤ 3 * a := by
      intro y hy
      apply hbd
      have hy' : dist y z < d / 4 := hy
      have := dist_triangle y z x₀
      show dist y x₀ < d / 2
      linarith
    have h2 := hgrad z (d / 4) (3 * a) (by positivity) (by linarith) hsub k
    rw [le_div_iff₀ hd]
    linarith
  
  set r := d / c with hrdef
  have hr : 0 < r := div_pos hd hcpos
  have hr4 : r ≤ d / 4 := div_le_div_of_nonneg_left hd.le (by norm_num) hc4
  have hL : 0 ≤ 12 * C₂ * a / d :=
    div_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₂) ha.le) hd.le
  have hnorm : ∀ z ∈ Metric.ball x₀ r, ‖fderiv ℝ W z‖ ≤ 3 * (12 * C₂ * a / d) := by
    intro z hz
    have hz4 : z ∈ Metric.ball x₀ (d / 4) := Metric.ball_subset_ball hr4 hz
    refine ContinuousLinearMap.opNorm_le_bound _ (by linarith) ?_
    intro v
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext i
      fin_cases i <;> simp [e, EuclideanSpace.single_apply]
    have hD : fderiv ℝ W z v = v 0 * partialDeriv 0 W z + v 1 * partialDeriv 1 W z
        + v 2 * partialDeriv 2 W z := by
      conv_lhs => rw [hv]
      simp only [map_add, map_smul, smul_eq_mul]
      rfl
    have h0 : |v 0| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 0
      rwa [Real.norm_eq_abs] at this
    have h1 : |v 1| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 1
      rwa [Real.norm_eq_abs] at this
    have h2 : |v 2| ≤ ‖v‖ := by
      have := PiLp.norm_apply_le v 2
      rwa [Real.norm_eq_abs] at this
    have b0 := hpd z hz4 0
    have b1 := hpd z hz4 1
    have b2 := hpd z hz4 2
    have m0 : |v 0 * partialDeriv 0 W z| ≤ ‖v‖ * (12 * C₂ * a / d) := by
      rw [abs_mul]; exact mul_le_mul h0 b0 (abs_nonneg _) (norm_nonneg _)
    have m1 : |v 1 * partialDeriv 1 W z| ≤ ‖v‖ * (12 * C₂ * a / d) := by
      rw [abs_mul]; exact mul_le_mul h1 b1 (abs_nonneg _) (norm_nonneg _)
    have m2 : |v 2 * partialDeriv 2 W z| ≤ ‖v‖ * (12 * C₂ * a / d) := by
      rw [abs_mul]; exact mul_le_mul h2 b2 (abs_nonneg _) (norm_nonneg _)
    rw [Real.norm_eq_abs, hD]
    calc |v 0 * partialDeriv 0 W z + v 1 * partialDeriv 1 W z + v 2 * partialDeriv 2 W z|
        ≤ |v 0 * partialDeriv 0 W z + v 1 * partialDeriv 1 W z| + |v 2 * partialDeriv 2 W z| :=
          abs_add_le _ _
      _ ≤ |v 0 * partialDeriv 0 W z| + |v 1 * partialDeriv 1 W z| + |v 2 * partialDeriv 2 W z| := by
          linarith [abs_add_le (v 0 * partialDeriv 0 W z) (v 1 * partialDeriv 1 W z)]
      _ ≤ 3 * (12 * C₂ * a / d) * ‖v‖ := by linarith
  have hSd : ∀ z ∈ Metric.ball x₀ r, DifferentiableAt ℝ W z := by
    intro z hz
    apply hdiff
    rw [Metric.mem_ball, dist_eq_norm] at hz
    rw [mem_ball_zero_iff]
    have := norm_sub_norm_le z x₀
    linarith
  have hkey : 3 * (12 * C₂ * a / d) * r ≤ a / 2 := by
    have hdne := hd.ne'
    have hcne := hcpos.ne'
    have : 3 * (12 * C₂ * a / d) * r = 36 * C₂ * a / c := by
      rw [hrdef]
      field_simp
      ring
    rw [this, div_le_iff₀ hcpos, hcdef]
    nlinarith
  have hlow : ∀ y ∈ Metric.ball x₀ r, a / 2 ≤ |W y| := by
    intro y hy
    have hlip := (convex_ball x₀ r).norm_image_sub_le_of_norm_fderiv_le hSd hnorm hy
      (Metric.mem_ball_self hr)
    rw [Real.norm_eq_abs] at hlip
    have hxy : ‖x₀ - y‖ < r := by
      rw [Metric.mem_ball, dist_eq_norm] at hy
      rwa [norm_sub_rev]
    have hb : 3 * (12 * C₂ * a / d) * ‖x₀ - y‖ ≤ 3 * (12 * C₂ * a / d) * r :=
      mul_le_mul_of_nonneg_left hxy.le (by linarith)
    have := abs_sub_abs_le_abs_sub (W x₀) (W y)
    rw [← hadef] at this
    linarith
  
  have hsubB : Metric.ball x₀ r ⊆ Metric.ball (0 : E3) 1 := by
    intro y hy
    rw [Metric.mem_ball, dist_eq_norm] at hy
    rw [mem_ball_zero_iff]
    have := norm_sub_norm_le y x₀
    linarith
  have hlowint : (a / 2) ^ 2 * (volume : Measure E3).real (Metric.ball x₀ r) ≤
      ∫ y in Metric.ball x₀ r, W y ^ 2 := by
    have hconst : ∫ y in Metric.ball x₀ r, (a / 2) ^ 2 =
        (volume : Measure E3).real (Metric.ball x₀ r) • (a / 2) ^ 2 := setIntegral_const _
    rw [smul_eq_mul, mul_comm] at hconst
    rw [← hconst]
    refine setIntegral_mono_on ?_ (hint1.mono_set hsubB) measurableSet_ball ?_
    · exact (continuousOn_const.integrableOn_compact (isCompact_closedBall x₀ r)).mono_set
        Metric.ball_subset_closedBall
    · intro y hy
      have := hlow y hy
      have h0 : 0 ≤ a / 2 := by linarith
      calc (a / 2) ^ 2 ≤ |W y| ^ 2 := pow_le_pow_left₀ h0 this 2
        _ = W y ^ 2 := sq_abs _
  have hmono : ∫ y in Metric.ball x₀ r, W y ^ 2 ≤ E :=
    setIntegral_mono_set hint1 (Filter.Eventually.of_forall fun y => sq_nonneg _)
      hsubB.eventuallyLE
  rw [hvol x₀ r hr] at hlowint
  have hfin : (a / 2) ^ 2 * (r ^ 3 * vB) ≤ E := hlowint.trans hmono
  have hr3 : r ^ 3 * c ^ 3 = d ^ 3 := by
    rw [hrdef, div_pow, div_mul_cancel₀ _ (pow_ne_zero 3 hcpos.ne')]
  rw [div_mul_eq_mul_div, le_div_iff₀ hvBpos]
  calc d ^ 3 * a ^ 2 * vB = 4 * c ^ 3 * ((a / 2) ^ 2 * (r ^ 3 * vB)) := by rw [← hr3]; ring
    _ ≤ 4 * c ^ 3 * E := mul_le_mul_of_nonneg_left hfin (by linarith)

theorem cld_rescaled_coeffs (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq : 0 < q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l
          (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ))) :
    ∀ ε : ℝ, 0 < ε → ∃ R₂ : ℝ, 1 ≤ R₂ ∧ ∀ x : E3, R₂ < ‖x‖ →
      ∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
        (∀ i j : Fin 3,
          |(G (x + (‖x‖ / 4) • z))⁻¹ i j - (if i = j then (1 : ℝ) else 0)| ≤ ε ∧
          |(G (x + (‖x‖ / 4) • z))⁻¹ i j - (G (x + (‖x‖ / 4) • z'))⁻¹ i j| ≤ ε * ‖z - z'‖) ∧
        (∀ k : Fin 3,
          |(‖x‖ / 4) * ∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + (‖x‖ / 4) • z))⁻¹ i j * christoffel G k i j (x + (‖x‖ / 4) • z)| ≤ ε ∧
          |(‖x‖ / 4) * ∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + (‖x‖ / 4) • z))⁻¹ i j * christoffel G k i j (x + (‖x‖ / 4) • z)
            - (‖x‖ / 4) * ∑ i : Fin 3, ∑ j : Fin 3,
              (G (x + (‖x‖ / 4) • z'))⁻¹ i j * christoffel G k i j (x + (‖x‖ / 4) • z')|
            ≤ ε * ‖z - z'‖) :=
by
  intro ε hε
  obtain ⟨R, C, hR, hC, hb⟩ := metric_coeff_bounds G q hq hsmooth hdecay
  obtain ⟨K, hK, hL⟩ := lapLoc_coeff_bounds G q hq hsmooth R C hR hC hb
  
  have hev : ∃ T₀ : ℝ, 0 < T₀ ∧ ∀ t : ℝ, T₀ ≤ t → K * t ^ (-q) ≤ ε := by
    have hδ : 0 < ε / (K + 1) := div_pos hε (by linarith)
    have h1 := (tendsto_rpow_neg_atTop hq).eventually_lt_const hδ
    obtain ⟨T₁, hT₁⟩ := Filter.eventually_atTop.1 h1
    refine ⟨max T₁ 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun t ht => ?_⟩
    have ht1 : T₁ ≤ t := le_trans (le_max_left _ _) ht
    have ht0 : 0 < t := lt_of_lt_of_le one_pos (le_trans (le_max_right _ _) ht)
    have hA : 0 ≤ t ^ (-q) := Real.rpow_nonneg ht0.le _
    have h2 := hT₁ t ht1
    have h3 : (K + 1) * t ^ (-q) ≤ (K + 1) * (ε / (K + 1)) :=
      mul_le_mul_of_nonneg_left h2.le (by linarith)
    rw [mul_div_cancel₀ _ (by linarith : (K + 1) ≠ 0)] at h3
    nlinarith
  obtain ⟨T₀, hT₀, hT⟩ := hev
  
  have hscale : ∀ s P : ℝ, 0 < s → 3 * s < P →
      K * P ^ (-q) ≤ K * (3 * s) ^ (-q) ∧
      s * (K * P ^ (-q - 1)) ≤ K * (3 * s) ^ (-q) ∧
      s * (s * (K * P ^ (-q - 2))) ≤ K * (3 * s) ^ (-q) := by
    intro s P hs hP
    have hP0 : 0 < P := by linarith
    have hA : 0 ≤ P ^ (-q) := Real.rpow_nonneg hP0.le _
    have hAB : P ^ (-q) ≤ (3 * s) ^ (-q) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hP.le (by linarith)
    have hKAB : K * P ^ (-q) ≤ K * (3 * s) ^ (-q) := mul_le_mul_of_nonneg_left hAB hK
    have hKA : 0 ≤ K * P ^ (-q) := mul_nonneg hK hA
    have h1 : P ^ (-q - 1) = P ^ (-q) / P := Real.rpow_sub_one hP0.ne' (-q)
    have h2 : P ^ (-q - 2) = P ^ (-q) / P / P := by
      rw [show -q - 2 = (-q - 1) - 1 by ring, Real.rpow_sub_one hP0.ne', h1]
    have hu0 : 0 ≤ s / P := div_nonneg hs.le hP0.le
    have hu1 : s / P ≤ 1 := (div_le_one hP0).2 (by linarith)
    have e1 : s * (K * P ^ (-q - 1)) = K * P ^ (-q) * (s / P) := by
      rw [h1]; field_simp
    have e2 : s * (s * (K * P ^ (-q - 2))) = K * P ^ (-q) * (s / P) * (s / P) := by
      rw [h2]; field_simp
    have i1 : K * P ^ (-q) * (s / P) ≤ K * P ^ (-q) := mul_le_of_le_one_right hKA hu1
    have i2 : K * P ^ (-q) * (s / P) * (s / P) ≤ K * P ^ (-q) * (s / P) :=
      mul_le_of_le_one_right (mul_nonneg hKA hu0) hu1
    refine ⟨hKAB, ?_, ?_⟩
    · rw [e1]; linarith
    · rw [e2]; linarith
  
  have hlip : ∀ (f : E3 → ℝ) (x : E3) (s m c : ℝ), 0 ≤ s → 0 ≤ m →
      (∀ z ∈ Metric.ball (0 : E3) 1, DifferentiableAt ℝ f (x + s • z)) →
      (∀ z ∈ Metric.ball (0 : E3) 1, m * (s * ‖fderiv ℝ f (x + s • z)‖) ≤ c) →
      ∀ z ∈ Metric.ball (0 : E3) 1, ∀ z' ∈ Metric.ball (0 : E3) 1,
        |m * f (x + s • z) - m * f (x + s • z')| ≤ c * ‖z - z'‖ := by
    intro f x s m c hs hm hd hbd z hz z' hz'
    have hA : ∀ w : E3, HasFDerivAt (fun y : E3 => x + s • y)
        (s • ContinuousLinearMap.id ℝ E3) w :=
      fun w => ((hasFDerivAt_id w).const_smul s).const_add x
    have hψ : ∀ w ∈ Metric.ball (0 : E3) 1, HasFDerivAt (fun y : E3 => m * f (x + s • y))
        (m • (fderiv ℝ f (x + s • w)).comp (s • ContinuousLinearMap.id ℝ E3)) w := by
      intro w hw
      exact ((hd w hw).hasFDerivAt.comp w (hA w)).const_mul m
    have hdiff : ∀ w ∈ Metric.ball (0 : E3) 1,
        DifferentiableAt ℝ (fun y : E3 => m * f (x + s • y)) w :=
      fun w hw => (hψ w hw).differentiableAt
    have hbd' : ∀ w ∈ Metric.ball (0 : E3) 1,
        ‖fderiv ℝ (fun y : E3 => m * f (x + s • y)) w‖ ≤ c := by
      intro w hw
      rw [(hψ w hw).fderiv]
      have hid : ‖s • ContinuousLinearMap.id ℝ E3‖ ≤ ‖s‖ * 1 :=
        (ContinuousLinearMap.opNorm_smul_le s _).trans
          (mul_le_mul_of_nonneg_left ContinuousLinearMap.norm_id_le (norm_nonneg _))
      calc ‖m • (fderiv ℝ f (x + s • w)).comp (s • ContinuousLinearMap.id ℝ E3)‖
          ≤ ‖m‖ * ‖(fderiv ℝ f (x + s • w)).comp (s • ContinuousLinearMap.id ℝ E3)‖ :=
            ContinuousLinearMap.opNorm_smul_le _ _
        _ ≤ ‖m‖ * (‖fderiv ℝ f (x + s • w)‖ * ‖s • ContinuousLinearMap.id ℝ E3‖) :=
            mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _) (norm_nonneg _)
        _ ≤ ‖m‖ * (‖fderiv ℝ f (x + s • w)‖ * (‖s‖ * 1)) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left hid (norm_nonneg _)) (norm_nonneg _)
        _ = m * (s * ‖fderiv ℝ f (x + s • w)‖) := by
            rw [Real.norm_of_nonneg hm, Real.norm_of_nonneg hs]; ring
        _ ≤ c := hbd w hw
    have h := (convex_ball (0 : E3) 1).norm_image_sub_le_of_norm_fderiv_le hdiff hbd' hz' hz
    rw [Real.norm_eq_abs] at h
    exact h
  
  refine ⟨max (max 1 (4 * R / 3)) (4 * T₀ / 3),
    le_trans (le_max_left _ _) (le_max_left _ _), ?_⟩
  intro x hx
  simp only [max_lt_iff] at hx
  obtain ⟨⟨hx1, hxR⟩, hxT⟩ := hx
  set s : ℝ := ‖x‖ / 4 with hs
  have hs0 : 0 < s := by rw [hs]; linarith
  have hsmall : K * (3 * s) ^ (-q) ≤ ε := hT _ (by rw [hs]; linarith)
  have key : ∀ w ∈ Metric.ball (0 : E3) 1, R < ‖x + s • w‖ ∧
      K * ‖x + s • w‖ ^ (-q) ≤ ε ∧ s * (K * ‖x + s • w‖ ^ (-q - 1)) ≤ ε ∧
      s * (s * (K * ‖x + s • w‖ ^ (-q - 2))) ≤ ε := by
    intro w hw
    have hw1 : ‖w‖ < 1 := mem_ball_zero_iff.mp hw
    have h1 := norm_sub_norm_le x (-(s • w))
    rw [norm_neg, sub_neg_eq_add, norm_smul, Real.norm_of_nonneg hs0.le] at h1
    have h2 : s * ‖w‖ < s * 1 := mul_lt_mul_of_pos_left hw1 hs0
    have h3 : 3 * s < ‖x + s • w‖ := by linarith
    obtain ⟨r0, r1, r2⟩ := hscale s _ hs0 h3
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  intro z hz z' hz'
  refine ⟨fun i j => ⟨?_, ?_⟩, fun k => ⟨?_, ?_⟩⟩
  · obtain ⟨hRp, r0, -, -⟩ := key z hz
    exact le_trans ((hL _ hRp).1 i j).1 r0
  · have h := hlip (fun y => (G y)⁻¹ i j) x s 1 ε hs0.le zero_le_one
      (fun w hw => ((hL _ (key w hw).1).1 i j).2.1)
      (fun w hw => by
        rw [one_mul]
        exact le_trans (mul_le_mul_of_nonneg_left ((hL _ (key w hw).1).1 i j).2.2 hs0.le)
          (key w hw).2.2.1)
      z hz z' hz'
    simpa only [one_mul] using h
  · obtain ⟨hRp, -, r1, -⟩ := key z hz
    rw [abs_mul, abs_of_pos hs0]
    exact le_trans (mul_le_mul_of_nonneg_left ((hL _ hRp).2 k).1 hs0.le) r1
  · exact hlip (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * christoffel G k i j y)
      x s s ε hs0.le hs0.le
      (fun w hw => ((hL _ (key w hw).1).2 k).2.1)
      (fun w hw => le_trans (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left ((hL _ (key w hw).1).2 k).2.2 hs0.le) hs0.le)
        (key w hw).2.2.2)
      z hz z' hz'

theorem cld_rescaled_equation (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (w : E3 → ℝ) (U : Set E3)
    (hU : IsOpen U) (hw : ContDiffOn ℝ ∞ w U) (x : E3) (s : ℝ) (z : E3) (hz : x + s • z ∈ U) :
    ∑ i : Fin 3, ∑ j : Fin 3, (G (x + s • z))⁻¹ i j *
        partialDeriv i (fun y => partialDeriv j (fun y' => w (x + s • y')) y) z
      - ∑ k : Fin 3, (s * ∑ i : Fin 3, ∑ j : Fin 3,
          (G (x + s • z))⁻¹ i j * christoffel G k i j (x + s • z)) *
          partialDeriv k (fun y => w (x + s • y)) z
    = s ^ 2 * lapLoc G w (x + s • z) :=
by
  
  have key : ∀ (f : E3 → ℝ) (y : E3), DifferentiableAt ℝ f (x + s • y) → ∀ k : Fin 3,
      partialDeriv k (fun y' => f (x + s • y')) y = s * partialDeriv k f (x + s • y) := by
    intro f y hf k
    have hA : HasFDerivAt (fun y' : E3 => x + s • y') (s • ContinuousLinearMap.id ℝ E3) y :=
      ((hasFDerivAt_id y).const_smul s).const_add x
    have hc : HasFDerivAt (fun y' => f (x + s • y'))
        ((fderiv ℝ f (x + s • y)).comp (s • ContinuousLinearMap.id ℝ E3)) y :=
      hf.hasFDerivAt.comp y hA
    show fderiv ℝ (fun y' => f (x + s • y')) y (e k) = s * fderiv ℝ f (x + s • y) (e k)
    rw [hc.fderiv]
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.id_apply, map_smul, smul_eq_mul]
  have hAc : Continuous (fun y : E3 => x + s • y) :=
    continuous_const.add (continuous_const.smul continuous_id)
  have hwd : ∀ y : E3, x + s • y ∈ U → DifferentiableAt ℝ w (x + s • y) := fun y hy =>
    (hw.contDiffAt (hU.mem_nhds hy)).differentiableAt (by simp)
  have h1 : ∀ k : Fin 3, partialDeriv k (fun y => w (x + s • y)) z
      = s * partialDeriv k w (x + s • z) := key w z (hwd z hz)
  have h2 : ∀ i j : Fin 3,
      partialDeriv i (fun y => partialDeriv j (fun y' => w (x + s • y')) y) z
        = s ^ 2 * partialDeriv i (partialDeriv j w) (x + s • z) := by
    intro i j
    have hV : IsOpen {y : E3 | x + s • y ∈ U} := hU.preimage hAc
    have heq : (fun y => partialDeriv j (fun y' => w (x + s • y')) y)
        =ᶠ[𝓝 z] (fun y => s * partialDeriv j w (x + s • y)) := by
      filter_upwards [hV.mem_nhds hz] with y hy
      exact key w y (hwd y hy) j
    have hwc : ContDiffAt ℝ ∞ w (x + s • z) := hw.contDiffAt (hU.mem_nhds hz)
    have hdj : DifferentiableAt ℝ (partialDeriv j w) (x + s • z) := by
      have h3 : ContDiffAt ℝ 1 (fderiv ℝ w) (x + s • z) :=
        hwc.fderiv_right (m := 1) (WithTop.coe_le_coe.mpr le_top)
      exact (h3.differentiableAt (by simp)).clm_apply (differentiableAt_const (e j))
    have hdj' : DifferentiableAt ℝ (fun q => s * partialDeriv j w q) (x + s • z) :=
      hdj.const_mul s
    have h4 := key (fun q => s * partialDeriv j w q) z hdj' i
    have h5 : partialDeriv i (fun q => s * partialDeriv j w q) (x + s • z)
        = s * partialDeriv i (partialDeriv j w) (x + s • z) := by
      show fderiv ℝ (fun q => s * partialDeriv j w q) (x + s • z) (e i)
        = s * fderiv ℝ (partialDeriv j w) (x + s • z) (e i)
      rw [fderiv_const_mul hdj]
      rfl
    have h6 : partialDeriv i (fun y => partialDeriv j (fun y' => w (x + s • y')) y) z
        = partialDeriv i (fun y => s * partialDeriv j w (x + s • y)) z := by
      show fderiv ℝ (fun y => partialDeriv j (fun y' => w (x + s • y')) y) z (e i)
        = fderiv ℝ (fun y => s * partialDeriv j w (x + s • y)) z (e i)
      rw [heq.fderiv_eq]
    rw [h6, h4, h5]
    ring
  simp only [h1, h2]
  unfold lapLoc hessLoc
  simp only [Fin.sum_univ_three]
  ring

theorem cld_ball_rescale_integral (f : E3 → ℝ) (x : E3) (s : ℝ) (hs : 0 < s) :
    ∫ z in Metric.ball (0 : E3) 1, f (x + s • z) = (s ^ 3)⁻¹ * ∫ y in Metric.ball x s, f y :=
by
  have h1 := MeasureTheory.Measure.setIntegral_comp_smul_of_pos
    (μ := (MeasureTheory.volume : MeasureTheory.Measure E3))
    (fun w : E3 => f (x + w)) (Metric.ball (0 : E3) 1) hs
  rw [finrank_euclideanSpace_fin, smul_unitBall_of_pos hs, smul_eq_mul] at h1
  have h2 := (MeasureTheory.measurePreserving_add_left
    (MeasureTheory.volume : MeasureTheory.Measure E3) x).setIntegral_preimage_emb
    (measurableEmbedding_addLeft x) f (Metric.ball x s)
  rw [preimage_add_ball, sub_self] at h2
  rw [h1, h2]

theorem cls_limit_decay [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (j : Fin hAF.numEnds)
    (ρ : ℝ) (hρ : 1 < ρ) (I : ℝ) (u : ℕ → M → ℝ) (v : M → ℝ)
    (hv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v) (hu : ∀ n, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u n))
    (hH : ∀ (n : ℕ) (R : ℝ), ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < R},
      (u n ((hAF.ends j).Φ y)) ^ 2 / ‖y‖ ^ 2 ≤ I)
    (hconv : ∀ L : Set E3, IsCompact L → L ⊆ (hAF.ends j).Φ.source →
      Tendsto (fun n => ∫ y in L, ((u n ((hAF.ends j).Φ y) - v ((hAF.ends j).Φ y)) ^ 2 +
        ∑ i : Fin 3, (partialDeriv i (fun z => u n ((hAF.ends j).Φ z)) y
          - partialDeriv i (fun z => v ((hAF.ends j).Φ z)) y) ^ 2)) atTop (𝓝 0))
    (R₀ : ℝ) (hR₀ : 1 ≤ R₀)
    (hlap : ∀ x : E3, R₀ < ‖x‖ →
      lapLoc (g.coeff (hAF.ends j).Φ) (fun y => v ((hAF.ends j).Φ y)) x = 0) :
    ∀ ε : ℝ, 0 < ε → ∃ R : ℝ, ∀ x : E3, R < ‖x‖ → |v ((hAF.ends j).Φ x)| ≤ ε :=
by
  intro ε hε
  set Φ := (hAF.ends j).Φ with hΦ
  have hsrc : Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends j).source_eq
  set G := g.coeff Φ with hG
  have hq0 : 0 < hAF.q := by linarith [hAF.q_gt]
  have hU1 : IsOpen {y : E3 | 1 < ‖y‖} := isOpen_lt continuous_const continuous_norm
  
  have hwsm : ContDiffOn ℝ ∞ (fun y => v (Φ y)) {y : E3 | 1 < ‖y‖} := by
    rw [← hsrc]; exact (nds_chart_cont g Φ v v hv hv).1
  have hwc : ContinuousOn (fun y => v (Φ y)) {y : E3 | 1 < ‖y‖} := hwsm.continuousOn
  have hS1 : ∀ n, ContinuousOn (fun y => u n (Φ y)) {y : E3 | 1 < ‖y‖} := by
    intro n; rw [← hsrc]; exact (nds_chart_cont g Φ (u n) v (hu n) hv).1.continuousOn
  have hDc : ∀ n, ContinuousOn (fun y => ∑ i : Fin 3, (partialDeriv i (fun z => u n (Φ z)) y
      - partialDeriv i (fun z => v (Φ z)) y) ^ 2) {y : E3 | 1 < ‖y‖} := by
    intro n; rw [← hsrc]
    exact continuousOn_finset_sum _ fun i _ =>
      (((nds_chart_cont g Φ (u n) v (hu n) hv).2.1 i).sub
        ((nds_chart_cont g Φ v v hv hv).2.1 i)).pow 2
  have hsm : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | 1 < ‖x‖} := by
    intro a b; rw [← hsrc]; exact coeff_contDiffOn_source g Φ a b
  
  obtain ⟨hI, hW2⟩ := cld_hardy_transfer ρ hρ I (fun n y => u n (Φ y)) (fun y => v (Φ y))
    (fun n y => ∑ i : Fin 3, (partialDeriv i (fun z => u n (Φ z)) y
      - partialDeriv i (fun z => v (Φ z)) y) ^ 2)
    hS1 hwc hDc (fun n y => Finset.sum_nonneg fun i _ => sq_nonneg _) hH
    (fun L hL hLs => hconv L hL (by rw [hsrc]; exact hLs))
  
  obtain ⟨ε₁, C₂, hε₁, hC₂, hSG⟩ := cld_scaled_gradient
  obtain ⟨C₃, hC₃, hSF⟩ := cld_sup_from_gradient C₂ hC₂
  obtain ⟨R₂, hR₂1, hR₂⟩ := cld_rescaled_coeffs G hAF.q hq0 hsm (hAF.decay j) ε₁ hε₁
  
  refine ⟨max (max R₂ 2) (max (max (4 * R₀ / 3) (4 * ρ / 3)) (200 * C₃ * I / ε ^ 2)), ?_⟩
  intro x hx
  simp only [max_lt_iff] at hx
  obtain ⟨⟨hxR₂, hx2⟩, ⟨hxR₀, hxρ⟩, hxC⟩ := hx
  have hco := hR₂ x hxR₂
  have hxpos : 0 < ‖x‖ := by linarith
  set s : ℝ := ‖x‖ / 4 with hs
  have hs0 : 0 < s := by rw [hs]; positivity
  have hnorm : ∀ z : E3, ‖x‖ - s * ‖z‖ ≤ ‖x + s • z‖ := by
    intro z
    have h1 := norm_sub_norm_le x (-(s • z))
    rw [norm_neg, sub_neg_eq_add, norm_smul, Real.norm_of_nonneg hs0.le] at h1
    exact h1
  
  have haff : ContDiff ℝ ∞ (fun z : E3 => x + s • z) :=
    contDiff_const.add (contDiff_id.const_smul s)
  have hmaps : Set.MapsTo (fun z : E3 => x + s • z) (Metric.ball 0 2) {y : E3 | 1 < ‖y‖} := by
    intro z hz
    have hz' : ‖z‖ < 2 := mem_ball_zero_iff.mp hz
    have h1 := hnorm z
    have h2 := mul_lt_mul_of_pos_left hz' hs0
    show 1 < ‖x + s • z‖
    linarith
  have hWsm : ContDiffOn ℝ ∞ (fun z => v (Φ (x + s • z))) (Metric.ball 0 2) :=
    hwsm.comp haff.contDiffOn hmaps
  have heqn : ∀ z ∈ Metric.ball (0 : E3) 1,
      ∑ i : Fin 3, ∑ j : Fin 3, (G (x + s • z))⁻¹ i j *
          partialDeriv i (fun y => partialDeriv j (fun y' => v (Φ (x + s • y'))) y) z
        - ∑ k : Fin 3, (s * ∑ i : Fin 3, ∑ j : Fin 3,
            (G (x + s • z))⁻¹ i j * christoffel G k i j (x + s • z)) *
            partialDeriv k (fun y => v (Φ (x + s • y))) z = 0 := by
    intro z hz
    have hz1 : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
    have hp : ‖x‖ - s * ‖z‖ ≤ ‖x + s • z‖ := hnorm z
    have hsz : s * ‖z‖ < s * 1 := mul_lt_mul_of_pos_left hz1 hs0
    have hpU : x + s • z ∈ {y : E3 | 1 < ‖y‖} := by show 1 < ‖x + s • z‖; linarith
    have hpR : R₀ < ‖x + s • z‖ := by linarith
    have h := cld_rescaled_equation G (fun y => v (Φ y)) _ hU1 hwsm x s z hpU
    rw [hlap _ hpR, mul_zero] at h
    exact h
  
  have hball : (v (Φ (x + s • (0 : E3)))) ^ 2 ≤
      C₃ * ∫ y in Metric.ball (0 : E3) 1, (v (Φ (x + s • y))) ^ 2 :=
    hSF (fun z => v (Φ (x + s • z))) hWsm
      (hSG (fun z => v (Φ (x + s • z))) (fun z => (G (x + s • z))⁻¹)
        (fun z k => s * ∑ i : Fin 3, ∑ j : Fin 3,
          (G (x + s • z))⁻¹ i j * christoffel G k i j (x + s • z)) hWsm hco heqn)
  rw [smul_zero, add_zero] at hball
  
  have hcv : ∫ y in Metric.ball (0 : E3) 1, (v (Φ (x + s • y))) ^ 2
      = (s ^ 3)⁻¹ * ∫ y in Metric.ball x s, (v (Φ y)) ^ 2 :=
    cld_ball_rescale_integral (fun y => v (Φ y) ^ 2) x s hs0
  
  have hcb : ∀ y ∈ Metric.closedBall x s, 3 * ‖x‖ / 4 ≤ ‖y‖ := by
    intro y hy
    rw [Metric.mem_closedBall, dist_eq_norm] at hy
    have h1 := norm_sub_norm_le x y
    rw [norm_sub_rev] at h1
    linarith
  have hcbU : Metric.closedBall x s ⊆ {y : E3 | 1 < ‖y‖} := fun y hy => by
    have := hcb y hy; show 1 < ‖y‖; linarith
  have hf2c : ContinuousOn (fun y => v (Φ y) ^ 2 / ‖y‖ ^ 2) {y : E3 | 1 < ‖y‖} :=
    (hwc.pow 2).div (continuous_norm.pow 2).continuousOn
      (fun y hy => pow_ne_zero 2 (lt_trans one_pos hy).ne')
  have hi1 : IntegrableOn (fun y => v (Φ y) ^ 2) (Metric.ball x s) :=
    (ContinuousOn.integrableOn_compact (isCompact_closedBall x s)
      ((hwc.pow 2).mono hcbU)).mono_set Metric.ball_subset_closedBall
  have hi2 : IntegrableOn (fun y => v (Φ y) ^ 2 / ‖y‖ ^ 2) (Metric.ball x s) :=
    (ContinuousOn.integrableOn_compact (isCompact_closedBall x s)
      (hf2c.mono hcbU)).mono_set Metric.ball_subset_closedBall
  have hpt : ∀ y ∈ Metric.ball x s,
      v (Φ y) ^ 2 ≤ 25 / 16 * ‖x‖ ^ 2 * (v (Φ y) ^ 2 / ‖y‖ ^ 2) := by
    intro y hy
    have hyl3 := hcb y (Metric.ball_subset_closedBall hy)
    rw [Metric.mem_ball, dist_eq_norm] at hy
    have h1 := norm_sub_norm_le y x
    have hy0 : 0 < ‖y‖ := by linarith
    have hy0' : ‖y‖ ≠ 0 := hy0.ne'
    have hyl : ‖y‖ < 5 * ‖x‖ / 4 := by linarith
    have hq : 0 ≤ v (Φ y) ^ 2 / ‖y‖ ^ 2 := by positivity
    have hm := mul_self_lt_mul_self hy0.le hyl
    have hsq : ‖y‖ ^ 2 ≤ 25 / 16 * ‖x‖ ^ 2 := by nlinarith
    calc v (Φ y) ^ 2 = ‖y‖ ^ 2 * (v (Φ y) ^ 2 / ‖y‖ ^ 2) := by field_simp
      _ ≤ 25 / 16 * ‖x‖ ^ 2 * (v (Φ y) ^ 2 / ‖y‖ ^ 2) := mul_le_mul_of_nonneg_right hsq hq
  have hstep1 : ∫ y in Metric.ball x s, v (Φ y) ^ 2 ≤
      ∫ y in Metric.ball x s, 25 / 16 * ‖x‖ ^ 2 * (v (Φ y) ^ 2 / ‖y‖ ^ 2) :=
    setIntegral_mono_on hi1 (Integrable.const_mul hi2 _) measurableSet_ball hpt
  rw [integral_const_mul] at hstep1
  have hLc : IsCompact ({y : E3 | ρ ≤ ‖y‖} ∩ Metric.closedBall 0 (2 * ‖x‖)) :=
    (isCompact_closedBall 0 _).inter_left (isClosed_le continuous_const continuous_norm)
  have hLsub : {y : E3 | ρ ≤ ‖y‖} ∩ Metric.closedBall 0 (2 * ‖x‖) ⊆ {y : E3 | 1 < ‖y‖} :=
    fun y hy => lt_of_lt_of_le hρ hy.1
  have hAsub : {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < 2 * ‖x‖} ⊆
      {y : E3 | ρ ≤ ‖y‖} ∩ Metric.closedBall 0 (2 * ‖x‖) :=
    fun y hy => ⟨hy.1.le, mem_closedBall_zero_iff.mpr hy.2.le⟩
  have hiA : IntegrableOn (fun y => v (Φ y) ^ 2 / ‖y‖ ^ 2)
      {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < 2 * ‖x‖} :=
    (ContinuousOn.integrableOn_compact hLc (hf2c.mono hLsub)).mono_set hAsub
  have hballA : Metric.ball x s ⊆ {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < 2 * ‖x‖} := by
    intro y hy
    have hyl3 := hcb y (Metric.ball_subset_closedBall hy)
    rw [Metric.mem_ball, dist_eq_norm] at hy
    have h1 := norm_sub_norm_le y x
    exact ⟨by linarith, by linarith⟩
  have hstep3 : ∫ y in Metric.ball x s, v (Φ y) ^ 2 / ‖y‖ ^ 2 ≤
      ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < 2 * ‖x‖}, v (Φ y) ^ 2 / ‖y‖ ^ 2 :=
    setIntegral_mono_set hiA
      (Filter.Eventually.of_forall fun y => div_nonneg (sq_nonneg _) (sq_nonneg _))
      hballA.eventuallyLE
  have hW2' : ∫ y in {y : E3 | ρ < ‖y‖ ∧ ‖y‖ < 2 * ‖x‖}, v (Φ y) ^ 2 / ‖y‖ ^ 2 ≤ 2 * I :=
    hW2 (2 * ‖x‖)
  have hJ : ∫ y in Metric.ball x s, v (Φ y) ^ 2 ≤ 25 / 16 * ‖x‖ ^ 2 * (2 * I) :=
    hstep1.trans (mul_le_mul_of_nonneg_left (hstep3.trans hW2') (by positivity))
  
  have hs3 : 0 ≤ (s ^ 3)⁻¹ := by positivity
  have hw2 : v (Φ x) ^ 2 ≤ 200 * C₃ * I / ‖x‖ := by
    calc v (Φ x) ^ 2 ≤ C₃ * ((s ^ 3)⁻¹ * ∫ y in Metric.ball x s, v (Φ y) ^ 2) := by
          rw [← hcv]; exact hball
      _ ≤ C₃ * ((s ^ 3)⁻¹ * (25 / 16 * ‖x‖ ^ 2 * (2 * I))) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hJ hs3) hC₃
      _ = 200 * C₃ * I / ‖x‖ := by
          rw [hs]; field_simp; ring
  have hε2 : 0 < ε ^ 2 := by positivity
  have hC : 200 * C₃ * I < ‖x‖ * ε ^ 2 := (div_lt_iff₀ hε2).mp hxC
  have hfin : v (Φ x) ^ 2 ≤ ε ^ 2 := by
    refine hw2.trans ?_
    rw [div_le_iff₀ hxpos]; linarith
  exact abs_le.mpr (abs_le_of_sq_le_sq' hfin hε.le)

theorem clsp_profile (δ : ℝ) (hδ : 0 < δ) :
    ContDiff ℝ ∞ (fun t : ℝ => δ * smax1 (-t / δ - 1)) ∧
    (∀ t : ℝ, 0 ≤ t → δ * smax1 (-t / δ - 1) = 0) ∧
    (∀ t : ℝ, 0 ≤ δ * smax1 (-t / δ - 1)) ∧
    (∀ t : ℝ, -t - δ ≤ δ * smax1 (-t / δ - 1)) ∧
    (∀ t : ℝ, δ * smax1 (-t / δ - 1) ≤ max (-t) 0 + δ) ∧
    (∀ t : ℝ, deriv (fun s : ℝ => δ * smax1 (-s / δ - 1)) t =
      -Real.smoothTransition (-t / (2 * δ))) ∧
    (∀ t : ℝ, -1 ≤ deriv (fun s : ℝ => δ * smax1 (-s / δ - 1)) t ∧
      deriv (fun s : ℝ => δ * smax1 (-s / δ - 1)) t ≤ 0) :=
by
  
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ → ℝ, σ = fun t => Real.smoothTransition ((t + 1) / 2) := ⟨_, rfl⟩
  have hσd : ContDiff ℝ ∞ σ := by
    rw [hσ]
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  have hσc : Continuous σ := hσd.continuous
  have hσ01 : ∀ u, 0 ≤ σ u ∧ σ u ≤ 1 := by
    intro u; rw [hσ]
    exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hσ0 : ∀ t, t ≤ -1 → σ t = 0 := by
    intro t ht; rw [hσ]
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hσ1 : ∀ t, 1 ≤ t → σ t = 1 := by
    intro t ht; rw [hσ]
    exact Real.smoothTransition.one_of_one_le (by linarith)
  have hS : ∀ x : ℝ, Real.smoothTransition x + Real.smoothTransition (1 - x) = 1 := by
    intro x
    have h1 := Real.smoothTransition.pos_denom x
    unfold Real.smoothTransition
    rw [sub_sub_cancel, add_comm (expNegInvGlue (1 - x)) (expNegInvGlue x), div_add_div_same,
      div_self h1.ne']
  have hσs : ∀ t, σ t + σ (-t) = 1 := by
    intro t
    have h := hS ((t + 1) / 2)
    have e : 1 - (t + 1) / 2 = (-t + 1) / 2 := by ring
    rw [e] at h
    rw [hσ]
    exact h
  have e1 : smax1 = fun u => ∫ t in (-1 : ℝ)..u, σ t := by
    funext v; rw [hσ]; rfl
  have hD : ∀ u, HasDerivAt smax1 (σ u) u := by
    intro u
    rw [e1]
    exact intervalIntegral.integral_hasDerivAt_right (hσc.intervalIntegrable (-1) u)
      (hσc.stronglyMeasurableAtFilter _ _) hσc.continuousAt
  have hderiv : deriv smax1 = σ := funext fun u => (hD u).deriv
  have hdiff : Differentiable ℝ smax1 := fun u => (hD u).differentiableAt
  have P1 : ContDiff ℝ ∞ smax1 := contDiff_infty_iff_deriv.mpr ⟨hdiff, hderiv ▸ hσd⟩
  have P4 : ∀ u, u ≤ -1 → smax1 u = 0 := by
    intro u hu
    rw [e1]
    show ∫ t in (-1 : ℝ)..u, σ t = 0
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_]
    · exact intervalIntegral.integral_zero
    · intro t ht
      rw [Set.uIcc_of_ge hu] at ht
      exact hσ0 t ht.2
  have hI : ∫ t in (-1 : ℝ)..1, σ t = 1 := by
    have h1 : ∫ x in (-1 : ℝ)..1, σ (-x) = ∫ x in (-1 : ℝ)..1, σ x := by
      rw [intervalIntegral.integral_comp_neg]
      norm_num
    have h2 : ∫ x in (-1 : ℝ)..1, (σ x + σ (-x)) =
        (∫ x in (-1 : ℝ)..1, σ x) + ∫ x in (-1 : ℝ)..1, σ (-x) :=
      intervalIntegral.integral_add (hσc.intervalIntegrable _ _)
        ((hσc.comp continuous_neg : Continuous fun x => σ (-x)).intervalIntegrable _ _)
    have h3 : ∫ x in (-1 : ℝ)..1, (σ x + σ (-x)) = 2 := by
      simp only [hσs]
      rw [intervalIntegral.integral_const, smul_eq_mul]
      norm_num
    linarith
  have P5 : ∀ u, 1 ≤ u → smax1 u = u := by
    intro u hu
    rw [e1]
    show ∫ t in (-1 : ℝ)..u, σ t = u
    rw [← intervalIntegral.integral_add_adjacent_intervals (b := 1)
      (hσc.intervalIntegrable _ _) (hσc.intervalIntegrable _ _), hI]
    rw [intervalIntegral.integral_congr (g := fun _ => (1 : ℝ)) ?_]
    · rw [intervalIntegral.integral_const, smul_eq_mul]
      ring
    · intro t ht
      rw [Set.uIcc_of_le hu] at ht
      exact hσ1 t ht.1
  have hmono : Monotone smax1 :=
    monotone_of_deriv_nonneg hdiff (fun u => by rw [hderiv]; exact (hσ01 u).1)
  have hDh : ∀ u, HasDerivAt (fun v => smax1 v - v) (σ u - 1) u :=
    fun u => (hD u).sub (hasDerivAt_id' u)
  have hanti : Antitone (fun v => smax1 v - v) :=
    antitone_of_deriv_nonpos (fun u => (hDh u).differentiableAt)
      (fun u => by rw [(hDh u).deriv]; linarith [(hσ01 u).2])
  have P6 : ∀ u, max u 0 ≤ smax1 u := by
    intro u
    apply max_le
    · have h := hanti (le_max_left u 1)
      simp only at h
      rw [P5 _ (le_max_right u 1)] at h
      linarith
    · have h := hmono (min_le_left u (-1))
      rw [P4 _ (min_le_right u (-1))] at h
      exact h
  have P7 : ∀ u, smax1 u ≤ max u 0 + 1 := by
    intro u
    have h := hmono (le_max_left u 1)
    rw [P5 _ (le_max_right u 1)] at h
    have h0 := le_max_left u 0
    have h1 := le_max_right u 0
    have h2 : max u 1 ≤ max u 0 + 1 := max_le (by linarith) (by linarith)
    linarith
  
  have hδne : δ ≠ 0 := hδ.ne'
  have I1 : ∀ t : ℝ, δ * (-t / δ - 1) = -t - δ := by
    intro t; field_simp
  have hderivm : ∀ t : ℝ, deriv (fun s : ℝ => δ * smax1 (-s / δ - 1)) t =
      -Real.smoothTransition (-t / (2 * δ)) := by
    intro t
    have hin : HasDerivAt (fun s : ℝ => -s / δ - 1) (-1 / δ) t := by
      have := ((hasDerivAt_id t).neg.div_const δ).sub_const 1
      simpa using this
    have hc := ((hD (-t / δ - 1)).comp t hin).const_mul δ
    have hc' : HasDerivAt (fun s : ℝ => δ * smax1 (-s / δ - 1))
        (δ * (σ (-t / δ - 1) * (-1 / δ))) t := hc
    rw [hc'.deriv, hσ]
    have e2 : (-t / δ - 1 + 1) / 2 = -t / (2 * δ) := by field_simp; ring
    simp only
    rw [e2]
    field_simp
  refine ⟨?_, ?_, ?_, ?_, ?_, hderivm, ?_⟩
  · exact contDiff_const.mul (P1.comp (by fun_prop))
  · intro t ht
    have : -t / δ - 1 ≤ -1 := by
      have : 0 ≤ t / δ := div_nonneg ht hδ.le
      rw [neg_div]; linarith
    rw [P4 _ this, mul_zero]
  · intro t
    exact mul_nonneg hδ.le ((le_max_right _ _).trans (P6 _))
  · intro t
    have h := mul_le_mul_of_nonneg_left ((le_max_left _ _).trans (P6 (-t / δ - 1))) hδ.le
    rw [I1] at h
    exact h
  · intro t
    have h7 := mul_le_mul_of_nonneg_left (P7 (-t / δ - 1)) hδ.le
    have hm1 := le_max_left (-t) 0
    have hm2 := le_max_right (-t) 0
    rcases le_or_gt (-t / δ - 1) 0 with hx | hx
    · rw [max_eq_right hx] at h7
      linarith
    · rw [max_eq_left hx.le, mul_add, I1] at h7
      linarith
  · intro t
    rw [hderivm]
    exact ⟨by linarith [Real.smoothTransition.le_one (-t / (2 * δ))],
      by linarith [Real.smoothTransition.nonneg (-t / (2 * δ))]⟩

theorem clsp_gradInner_comp [IsManifold 𝓘(ℝ, E3) ∞ M] (h : RiemannianMetric3 M) (w : M → ℝ)
    (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w) (G : ℝ → ℝ) (hG : ContDiff ℝ ∞ G) :
    ∀ p : M, h.gradInner (fun q => G (w q)) w p = deriv G (w p) * h.gradInner w w p ∧
      h.gradInner (fun q => G (w q)) (fun q => G (w q)) p =
        deriv G (w p) ^ 2 * h.gradInner w w p :=
by
  intro p
  have hf : ContDiffOn ℝ ∞ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hw.comp_contMDiffOn contMDiffOn_chart_symm)
  have hfd : DifferentiableAt ℝ (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) :=
    (hf.contDiffAt ((chartAt E3 p).open_target.mem_nhds (mem_chart_target E3 p))).differentiableAt
      (by simp)
  have hGd : HasDerivAt G (deriv G (w ((chartAt E3 p).symm (chartAt E3 p p))))
      (w ((chartAt E3 p).symm (chartAt E3 p p))) :=
    ((hG.differentiable (by simp)) _).hasDerivAt
  have hbase : w ((chartAt E3 p).symm (chartAt E3 p p)) = w p := by
    rw [(chartAt E3 p).left_inv (mem_chart_source E3 p)]
  have hcomp := hGd.comp_hasFDerivAt (chartAt E3 p p) hfd.hasFDerivAt
  have hpd : ∀ i : Fin 3,
      partialDeriv i (fun y => G (w ((chartAt E3 p).symm y))) (chartAt E3 p p) =
        deriv G (w p) * partialDeriv i (fun y => w ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
    intro i
    unfold partialDeriv
    have e : (fun y => G (w ((chartAt E3 p).symm y))) =
        G ∘ (fun y => w ((chartAt E3 p).symm y)) := rfl
    rw [e, hcomp.fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul, hbase]
  refine ⟨?_, ?_⟩
  · simp only [RiemannianMetric3.gradInner, hpd]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  · simp only [RiemannianMetric3.gradInner, hpd]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring

theorem clsp_atlasInt_algebra [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (h : RiemannianMetric3 M) (F G : M → ℝ)
    (hF : ∀ i, ContinuousOn (fun y => F (κ i y)) (κ i).source)
    (hG : ∀ i, ContinuousOn (fun y => G (κ i y)) (κ i).source)
    (KF KG : Set M) (hKF : IsCompact KF) (hKG : IsCompact KG)
    (hFK : ∀ p, p ∉ KF → F p = 0) (hGK : ∀ p, p ∉ KG → G p = 0) :
    atlasInt h κ χ (fun p => F p + G p) = atlasInt h κ χ F + atlasInt h κ χ G ∧
    (∀ c : ℝ, atlasInt h κ χ (fun p => c * F p) = c * atlasInt h κ χ F) ∧
    ((∀ p, F p ≤ G p) → atlasInt h κ χ F ≤ atlasInt h κ χ G) ∧
    ((∀ p, 0 ≤ F p) → 0 ≤ atlasInt h κ χ F) :=
by
  obtain ⟨-, hχs, hχ0, -, hχt, -⟩ := hA
  have hint : ∀ (i : Fin n) (f : M → ℝ), ContinuousOn (fun y => f (κ i y)) (κ i).source →
      ∀ T : Set M, IsCompact T → (∀ p, p ∉ T → f p = 0) →
      IntegrableOn (fun y => χ i (κ i y) * f (κ i y) * Real.sqrt (h.coeff (κ i) y).det)
        (κ i).source := by
    intro i f hf T hT hfT
    have := cls_chart_integrable h (κ i) (χ i) (hχs i) (hχt i) Set.univ isClosed_univ f hf
      T hT (fun p hp => by rw [Set.indicator_univ]; exact hfT p hp)
    simpa only [Set.indicator_univ] using this
  have hIF : ∀ i, IntegrableOn
      (fun y => χ i (κ i y) * F (κ i y) * Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
    fun i => hint i F (hF i) KF hKF hFK
  have hIG : ∀ i, IntegrableOn
      (fun y => χ i (κ i y) * G (κ i y) * Real.sqrt (h.coeff (κ i) y).det) (κ i).source :=
    fun i => hint i G (hG i) KG hKG hGK
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold atlasInt
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← integral_add (hIF i) (hIG i)]
    congr 1
    funext y
    ring
  · intro c
    unfold atlasInt
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← integral_const_mul]
    congr 1
    funext y
    ring
  · intro hle
    unfold atlasInt
    apply Finset.sum_le_sum
    intro i _
    refine setIntegral_mono (hIF i) (hIG i) ?_
    intro y
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hle _) (hχ0 i _))
      (Real.sqrt_nonneg _)
  · intro h0
    unfold atlasInt
    apply Finset.sum_nonneg
    intro i _
    apply integral_nonneg
    intro y
    exact mul_nonneg (mul_nonneg (hχ0 i _) (h0 _)) (Real.sqrt_nonneg _)

theorem divergence_setIntegral_eq_zero (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K)
    (hKU : K ⊆ U) (Y : Fin 3 → E3 → ℝ) (hY : ∀ i : Fin 3, ContDiffOn ℝ 1 (Y i) U)
    (hY0 : ∀ i : Fin 3, ∀ y ∈ U, y ∉ K → Y i y = 0) :
    ∫ y in K, ∑ i : Fin 3, partialDeriv i (Y i) y = 0 :=
by
  classical
  set Z : Fin 3 → E3 → ℝ := fun i y => if y ∈ K then Y i y else 0 with hZdef
  have hKc : IsOpen Kᶜ := hK.isClosed.isOpen_compl
  have s1a : ∀ i, ∀ y ∈ U, Z i y = Y i y := by
    intro i y hy
    by_cases hyK : y ∈ K
    · simp [hZdef, hyK]
    · simp [hZdef, hyK, hY0 i y hy hyK]
  have s1b : ∀ i, ∀ y, y ∉ K → Z i y = 0 := by
    intro i y hy
    simp [hZdef, hy]
  have s2a : ∀ i, ∀ y ∈ U, Z i =ᶠ[nhds y] Y i := fun i y hy =>
    Filter.eventuallyEq_of_mem (hU.mem_nhds hy) (fun z hz => s1a i z hz)
  have s2b : ∀ i, ∀ y, y ∉ K → Z i =ᶠ[nhds y] (fun _ => (0 : ℝ)) := fun i y hy =>
    Filter.eventuallyEq_of_mem (hKc.mem_nhds hy) (fun z hz => s1b i z hz)
  have s3 : ∀ i, ContDiff ℝ 1 (Z i) := by
    intro i
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ U
    · exact ((hY i).contDiffAt (hU.mem_nhds hy)).congr_of_eventuallyEq (s2a i y hy)
    · have hyK : y ∉ K := fun h => hy (hKU h)
      exact contDiffAt_const.congr_of_eventuallyEq (s2b i y hyK)
  have s4a : ∀ i, ∀ y ∈ K, partialDeriv i (Y i) y = partialDeriv i (Z i) y := by
    intro i y hy
    show fderiv ℝ (Y i) y (e i) = fderiv ℝ (Z i) y (e i)
    rw [(s2a i y (hKU hy)).symm.fderiv_eq]
  have s4b : ∀ i, ∀ y, y ∉ K → partialDeriv i (Z i) y = 0 := by
    intro i y hy
    show fderiv ℝ (Z i) y (e i) = 0
    rw [(s2b i y hy).fderiv_eq]
    simp
  have hKm : MeasurableSet K := hK.measurableSet
  have s5 : ∫ y in K, ∑ i : Fin 3, partialDeriv i (Y i) y =
      ∫ y in K, ∑ i : Fin 3, partialDeriv i (Z i) y := by
    refine MeasureTheory.setIntegral_congr_fun hKm fun y hy => ?_
    exact Finset.sum_congr rfl fun i _ => s4a i y hy
  have s6 : ∫ y in K, ∑ i : Fin 3, partialDeriv i (Z i) y =
      ∫ y, ∑ i : Fin 3, partialDeriv i (Z i) y := by
    refine MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero fun y hy => ?_
    exact Finset.sum_eq_zero fun i _ => s4b i y hy
  have hZc : ∀ i, HasCompactSupport (Z i) := fun i => HasCompactSupport.intro hK (s1b i)
  have hdZcont : ∀ i, Continuous (fun y => fderiv ℝ (Z i) y (e i)) := fun i =>
    ((s3 i).continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hdZint : ∀ i, MeasureTheory.Integrable (fun y => fderiv ℝ (Z i) y (e i)) := fun i =>
    (hdZcont i).integrable_of_hasCompactSupport ((hZc i).fderiv_apply ℝ (e i))
  have hZint : ∀ i, MeasureTheory.Integrable (Z i) := fun i =>
    (s3 i).continuous.integrable_of_hasCompactSupport (hZc i)
  have s8 : ∫ y, ∑ i : Fin 3, partialDeriv i (Z i) y =
      ∑ i : Fin 3, ∫ y, partialDeriv i (Z i) y :=
    MeasureTheory.integral_finset_sum _ fun i _ => hdZint i
  have s9 : ∀ i, ∫ y, partialDeriv i (Z i) y = 0 := by
    intro i
    have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable
      (μ := MeasureTheory.volume) (f := fun _ : E3 => (1 : ℝ)) (g := Z i) (v := e i)
      (by simp) (by simpa using hdZint i) (by simpa using hZint i)
      (differentiable_const _) ((s3 i).differentiable one_ne_zero)
    simp only [one_mul, fderiv_const_apply, ContinuousLinearMap.zero_apply, zero_mul,
      MeasureTheory.integral_zero, neg_zero] at h
    exact h
  rw [s5, s6, s8]
  exact Finset.sum_eq_zero fun i _ => s9 i

theorem clsp_green_atlas [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (h : RiemannianMetric3 M) (φ w : M → ℝ)
    (hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ) (hφc : HasCompactSupport φ)
    (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w) :
    atlasInt h κ χ (h.gradInner φ w) = -atlasInt h κ χ (fun p => φ p * h.lapM w p) :=
by
  classical
  obtain ⟨-, hχs, -, hχ1, hχt, -⟩ := hA
  
  obtain ⟨u, hudef⟩ : ∃ u : Fin n → M → ℝ, u = fun i p => χ i p * φ p := ⟨_, rfl⟩
  have hup : ∀ i p, u i p = χ i p * φ p := by intro i p; rw [hudef]
  have hu : ∀ i, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u i) := by
    intro i; rw [hudef]; exact (hχs i).mul hφ
  have hφsum : ∀ q, φ q = ∑ i, u i q := by
    intro q; simp only [hup]; rw [← Finset.sum_mul, hχ1 q, one_mul]
  obtain ⟨K, hKdef⟩ : ∃ K : Fin n → Set M, K = fun i => tsupport (χ i) ∩ tsupport φ :=
    ⟨_, rfl⟩
  have hKa : ∀ i, K i = tsupport (χ i) ∩ tsupport φ := by intro i; rw [hKdef]
  have hKc : ∀ i, IsCompact (K i) := by
    intro i; rw [hKa]; exact hφc.isCompact.inter_left (isClosed_tsupport _)
  have hKt : ∀ i, K i ⊆ (κ i).target := by
    intro i p hp; rw [hKa] at hp; exact hχt i hp.1
  have htsK : ∀ i, tsupport (u i) ⊆ K i := by
    intro i
    rw [hKa]
    apply closure_minimal _ ((isClosed_tsupport _).inter (isClosed_tsupport _))
    intro p hp
    rw [Function.mem_support, hup] at hp
    exact ⟨subset_tsupport _ (left_ne_zero_of_mul hp), subset_tsupport _ (right_ne_zero_of_mul hp)⟩
  obtain ⟨L, hLdef⟩ : ∃ L : Fin n → Set E3, L = fun i => (κ i).toPartialEquiv.symm '' K i :=
    ⟨_, rfl⟩
  have hLa : ∀ i, L i = (κ i).toPartialEquiv.symm '' K i := by intro i; rw [hLdef]
  have hLs : ∀ i, L i ⊆ (κ i).source := by
    intro i; rw [hLa]; rintro _ ⟨x, hx, rfl⟩; exact (κ i).toPartialEquiv.map_target (hKt i hx)
  have hLc : ∀ i, IsCompact (L i) := by
    intro i; rw [hLa]
    exact (hKc i).image_of_continuousOn ((κ i).contMDiffOn_invFun.continuousOn.mono (hKt i))
  have hKL : ∀ i, ∀ y ∈ (κ i).source, y ∉ L i → κ i y ∉ K i := by
    intro i y hy hyL hK
    rw [hLa] at hyL
    exact hyL ⟨κ i y, hK, (κ i).toPartialEquiv.left_inv hy⟩
  
  have hgv : ∀ (v : M → ℝ) (p : M), p ∉ tsupport v → h.gradInner v w p = 0 := by
    intro v p hp
    have hc : ContinuousAt (chartAt E3 p).symm (chartAt E3 p p) :=
      (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
    have hsymm : (chartAt E3 p).symm (chartAt E3 p p) = p :=
      (chartAt E3 p).left_inv (mem_chart_source E3 p)
    have hnhds : (chartAt E3 p).symm ⁻¹' (tsupport v)ᶜ ∈ 𝓝 (chartAt E3 p p) := by
      apply hc.preimage_mem_nhds
      rw [hsymm]
      exact (isClosed_tsupport v).isOpen_compl.mem_nhds hp
    have hev : (fun y => v ((chartAt E3 p).symm y)) =ᶠ[𝓝 (chartAt E3 p p)]
        fun _ => (0 : ℝ) := by
      filter_upwards [hnhds] with y hy
      exact image_eq_zero_of_notMem_tsupport hy
    have hpd : ∀ j : Fin 3,
        partialDeriv j (fun y => v ((chartAt E3 p).symm y)) (chartAt E3 p p) = 0 := by
      intro j
      unfold partialDeriv
      rw [hev.fderiv_eq]
      simp
    simp [RiemannianMetric3.gradInner, hpd]
  
  have hsplitG : h.gradInner φ w = fun p => ∑ i, h.gradInner (u i) w p := by
    funext p
    have hdiff : ∀ i, DifferentiableAt ℝ (fun y => u i ((chartAt E3 p).symm y))
        (chartAt E3 p p) := by
      intro i
      have h1 : ContDiffOn ℝ ∞ (fun y => u i ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
        contMDiffOn_iff_contDiffOn.mp ((hu i).comp_contMDiffOn (contMDiffOn_chart_symm (x := p)))
      exact (h1.differentiableOn (by simp) _ (mem_chart_target E3 p)).differentiableAt
        ((chartAt E3 p).open_target.mem_nhds (mem_chart_target E3 p))
    have hfun : (fun y => φ ((chartAt E3 p).symm y)) =
        fun y => ∑ i, u i ((chartAt E3 p).symm y) := by
      funext y; exact hφsum _
    have hpd : ∀ a : Fin 3, partialDeriv a (fun y => φ ((chartAt E3 p).symm y)) (chartAt E3 p p) =
        ∑ i, partialDeriv a (fun y => u i ((chartAt E3 p).symm y)) (chartAt E3 p p) := by
      intro a
      rw [hfun]
      simp only [partialDeriv]
      rw [fderiv_fun_sum (fun i _ => hdiff i), ContinuousLinearMap.sum_apply]
    simp only [RiemannianMetric3.gradInner, hpd, Finset.mul_sum, Finset.sum_mul]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.sum_comm]
  
  have htransfer : ∀ (ψ κ0 : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (G : M → ℝ),
      (∀ p, p ∉ κ0.target ∩ ψ.target → G p = 0) →
      ∫ z in κ0.source, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det =
        ∫ y in ψ.source, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
    intro ψ κ0 G hG
    have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
    obtain ⟨Ω, hΩ⟩ : ∃ Ω : Set E3, Ω = ψ.source ∩ ψ ⁻¹' κ0.target := ⟨_, rfl⟩
    have hmΩ : ∀ y, y ∈ Ω ↔ y ∈ ψ.source ∧ ψ y ∈ κ0.target := by
      intro y; rw [hΩ]; rfl
    have hΩo : IsOpen Ω := by
      rw [hΩ]; exact hψc.isOpen_inter_preimage ψ.open_source κ0.open_target
    obtain ⟨τ, hτ⟩ : ∃ τ : E3 → E3, τ = fun y => κ0.toPartialEquiv.symm (ψ y) := ⟨_, rfl⟩
    have hτa : ∀ y, τ y = κ0.toPartialEquiv.symm (ψ y) := by intro y; rw [hτ]
    have hτinv : ∀ y ∈ Ω, κ0 (τ y) = ψ y := by
      intro y hy; rw [hτa]; exact κ0.toPartialEquiv.right_inv ((hmΩ y).1 hy).2
    have hτsrc : ∀ y ∈ Ω, τ y ∈ κ0.source := by
      intro y hy; rw [hτa]; exact κ0.toPartialEquiv.map_target ((hmΩ y).1 hy).2
    have hτsm : ContDiffOn ℝ ∞ τ Ω := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (fun y => κ0.toPartialEquiv.symm (ψ y)) Ω :=
        κ0.contMDiffOn_invFun.comp (ψ.contMDiffOn_toFun.mono (fun y hy => ((hmΩ y).1 hy).1))
          (fun y hy => ((hmΩ y).1 hy).2)
      rw [hτ]; exact contMDiffOn_iff_contDiffOn.mp h1
    have hτd : ∀ y ∈ Ω, DifferentiableAt ℝ τ y := fun y hy =>
      ((hτsm.differentiableOn (by simp)) y hy).differentiableAt (hΩo.mem_nhds hy)
    have hτinj : Set.InjOn τ Ω := by
      intro y₁ h₁ y₂ h₂ heq
      have h3 : κ0 (τ y₁) = κ0 (τ y₂) := by rw [heq]
      rw [hτinv y₁ h₁, hτinv y₂ h₂] at h3
      exact ψ.toPartialEquiv.injOn ((hmΩ y₁).1 h₁).1 ((hmΩ y₂).1 h₂).1 h3
    have hcov := integral_image_eq_integral_abs_det_fderiv_smul volume hΩo.measurableSet
      (fun y hy => (hτd y hy).hasFDerivAt.hasFDerivWithinAt) hτinj
      (fun z => G (κ0 z) * Real.sqrt (h.coeff κ0 z).det)
    simp only [smul_eq_mul] at hcov
    have himg : τ '' Ω ⊆ κ0.source := by
      rintro _ ⟨y, hy, rfl⟩; exact hτsrc y hy
    have hcc : ∫ z in κ0.source, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det =
        ∫ z in τ '' Ω, G (κ0 z) * Real.sqrt (h.coeff κ0 z).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero κ0.open_source.measurableSet
        himg ?_
      intro z hz
      have hG0 : G (κ0 z) = 0 := by
        apply hG
        rintro ⟨hz1, hz2⟩
        apply hz.2
        have hr : ψ (ψ.toPartialEquiv.symm (κ0 z)) = κ0 z := ψ.toPartialEquiv.right_inv hz2
        refine ⟨ψ.toPartialEquiv.symm (κ0 z),
          (hmΩ _).2 ⟨ψ.toPartialEquiv.map_target hz2, ?_⟩, ?_⟩
        · rw [hr]; exact hz1
        · rw [hτa, hr]; exact κ0.toPartialEquiv.left_inv hz.1
      rw [hG0, zero_mul]
    have hdd : ∫ y in ψ.source, G (ψ y) * Real.sqrt (h.coeff ψ y).det =
        ∫ y in Ω, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero ψ.open_source.measurableSet
        (fun y hy => ((hmΩ y).1 hy).1) ?_
      intro y hy
      have hG0 : G (ψ y) = 0 := by
        apply hG
        rintro ⟨h1, -⟩
        exact hy.2 ((hmΩ y).2 ⟨hy.1, h1⟩)
      rw [hG0, zero_mul]
    have hvol : ∀ y ∈ Ω, Real.sqrt (h.coeff ψ y).det =
        |(fderiv ℝ τ y).det| * Real.sqrt (h.coeff κ0 (τ y)).det := by
      intro y hy
      have hev : (⇑κ0 ∘ τ) =ᶠ[𝓝 y] ⇑ψ := by
        filter_upwards [hΩo.mem_nhds hy] with z hz
        exact hτinv z hz
      have hcoeq : h.coeff ψ y = h.coeff (⇑κ0 ∘ τ) y := by
        have hmf : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (⇑κ0 ∘ τ) y = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) ψ y :=
          hev.mfderiv_eq
        have hpt : (⇑κ0 ∘ τ) y = ψ y := hτinv y hy
        ext i j
        simp only [RiemannianMetric3.coeff, coeffMatrix]
        rw [hmf, hpt]
      have hκmd : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) κ0 (τ y) :=
        ((κ0.contMDiffOn_toFun (τ y) (hτsrc y hy)).contMDiffAt
          (κ0.open_source.mem_nhds (hτsrc y hy))).mdifferentiableAt (by simp)
      obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin 3) (Fin 3) ℝ,
          J = Matrix.of fun a i => fderiv ℝ τ y (e i) a := ⟨_, rfl⟩
      have hmat : h.coeff ψ y = J.transpose * h.coeff κ0 (τ y) * J := by
        rw [hcoeq]
        ext i j
        rw [coeff_comp_apply h κ0 τ y (hτd y hy) hκmd i j, hJ]
        simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Fin.sum_univ_three]
        ring
      have hdetJ : (fderiv ℝ τ y).det = J.det := by
        rw [hJ]
        show LinearMap.det ((fderiv ℝ τ y : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = _
        rw [← LinearMap.det_toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
        congr 1
      have hdet : (h.coeff ψ y).det = J.det ^ 2 * (h.coeff κ0 (τ y)).det := by
        rw [hmat, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]; ring
      rw [hdet, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq_eq_abs, hdetJ]
    have hff : ∫ y in Ω, |(fderiv ℝ τ y).det| *
          (G (κ0 (τ y)) * Real.sqrt (h.coeff κ0 (τ y)).det) =
        ∫ y in Ω, G (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_congr_fun hΩo.measurableSet fun y hy => ?_
      simp only
      rw [hτinv y hy, hvol y hy]; ring
    rw [hcc, hcov, hff, hdd]
  
  have hloc : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (K0 : Set M) (L0 : Set E3),
      IsCompact L0 → L0 ⊆ ψ.source → K0 ⊆ ψ.target →
      (∀ y ∈ ψ.source, y ∉ L0 → ψ y ∉ K0) → ∀ F : M → ℝ, (∀ p, p ∉ K0 → F p = 0) →
      ContinuousOn (fun y => F (ψ y)) ψ.source →
      atlasInt h κ χ F = ∫ y in ψ.source, F (ψ y) * Real.sqrt (h.coeff ψ y).det := by
    intro ψ K0 L0 hL0 hL0s hK0t hK0L F hF hFc
    have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
    have hsq : ContinuousOn (fun y => Real.sqrt (h.coeff ψ y).det) ψ.source :=
      (nds_chart_cont h ψ 0 0 contMDiff_const contMDiff_const).2.2.2.1
    have hint : ∀ c : M → ℝ, Continuous c →
        IntegrableOn (fun y => c (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source := by
      intro c hc
      have h1 : ContinuousOn (fun y => c (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det)
          ψ.source := ((hc.comp_continuousOn hψc).mul hFc).mul hsq
      refine ((h1.mono hL0s).integrableOn_compact hL0).of_forall_diff_eq_zero
        ψ.open_source.measurableSet ?_
      intro y hy
      rw [hF _ (hK0L y hy.1 hy.2)]; ring
    unfold atlasInt
    have hi : ∀ i, ∫ y in (κ i).source, χ i (κ i y) * F (κ i y) *
          Real.sqrt (h.coeff (κ i) y).det =
        ∫ y in ψ.source, χ i (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      intro i
      exact htransfer ψ (κ i) (fun p => χ i p * F p) (by
        intro p hp
        by_cases h1 : p ∈ (κ i).target
        · have h2 : p ∉ ψ.target := fun h2 => hp ⟨h1, h2⟩
          have h3 : p ∉ K0 := fun h3 => h2 (hK0t h3)
          simp only [hF p h3, mul_zero]
        · have h2 : p ∉ tsupport (χ i) := fun h2 => h1 (hχt i h2)
          simp only [image_eq_zero_of_notMem_tsupport h2, zero_mul])
    rw [Finset.sum_congr rfl (fun i _ => hi i)]
    rw [← integral_finset_sum _ (fun i _ => hint (χ i) (hχs i).continuous)]
    refine setIntegral_congr_fun ψ.open_source.measurableSet fun y hy => ?_
    show ∑ i, χ i (ψ y) * F (ψ y) * Real.sqrt (h.coeff ψ y).det =
      F (ψ y) * Real.sqrt (h.coeff ψ y).det
    rw [← Finset.sum_mul, ← Finset.sum_mul, hχ1 (ψ y), one_mul]
  
  have hgreen : ∀ (ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (L0 : Set E3),
      IsCompact L0 → L0 ⊆ ψ.source → ∀ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v →
      (∀ y ∈ ψ.source, y ∉ L0 → ψ y ∉ tsupport v) →
      ∫ y in ψ.source, h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det =
        -∫ y in ψ.source, v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det := by
    intro ψ L0 hL0 hL0s v hv hvK
    have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
    have hG := coeff_contDiffOn_source h ψ
    have hGinv := (flat_coeff_regular h ψ).1
    have hsymm : ∀ (x : E3) (i j : Fin 3), h.coeff ψ x i j = h.coeff ψ x j i :=
      fun x i j => h.symm _ _ _
    have hpos := coeff_posDef h ψ
    have hsq : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h.coeff ψ y).det) ψ.source :=
      ccs_sqrtdet_smooth _ _ hG (fun y hy => (hpos y hy).det_pos)
    have hζ : ContDiffOn ℝ ∞ (fun y => v (ψ y)) ψ.source := (nds_chart_cont h ψ v w hv hw).1
    have hV : ContDiffOn ℝ ∞ (fun y => w (ψ y)) ψ.source := (nds_chart_cont h ψ w w hw hw).1
    have hpd : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f ψ.source → ∀ b : Fin 3,
        ContDiffOn ℝ ∞ (partialDeriv b f) ψ.source := by
      intro f hf b
      have h1 : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) ψ.source :=
        hf.fderiv_of_isOpen ψ.open_source (by simp)
      exact h1.clm_apply contDiffOn_const
    have hdA : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f ψ.source → ∀ y ∈ ψ.source,
        DifferentiableAt ℝ f y := fun f hf y hy =>
      ((hf.differentiableOn (by simp)) y hy).differentiableAt (ψ.open_source.mem_nhds hy)
    have hv0 : ∀ y ∈ ψ.source, y ∉ L0 → v (ψ y) = 0 := fun y hy hyL =>
      image_eq_zero_of_notMem_tsupport (hvK y hy hyL)
    obtain ⟨W, hWdef⟩ : ∃ W : Fin 3 → E3 → ℝ, W = fun a y => ∑ b : Fin 3,
        Real.sqrt (h.coeff ψ y).det * (h.coeff ψ y)⁻¹ a b *
          partialDeriv b (fun z => w (ψ z)) y := ⟨_, rfl⟩
    have hWa : ∀ a, W a = fun y => ∑ b : Fin 3,
        Real.sqrt (h.coeff ψ y).det * (h.coeff ψ y)⁻¹ a b *
          partialDeriv b (fun z => w (ψ z)) y := by intro a; rw [hWdef]
    have hW : ∀ a, ContDiffOn ℝ ∞ (W a) ψ.source := by
      intro a; rw [hWa]
      exact ContDiffOn.sum fun b _ => (hsq.mul (hGinv a b)).mul (hpd _ hV b)
    obtain ⟨Y, hYdef⟩ : ∃ Y : Fin 3 → E3 → ℝ, Y = fun a y => v (ψ y) * W a y := ⟨_, rfl⟩
    have hYa : ∀ a, Y a = fun y => v (ψ y) * W a y := by intro a; rw [hYdef]
    have hY : ∀ a, ContDiffOn ℝ 1 (Y a) ψ.source := by
      intro a; rw [hYa]
      exact (hζ.mul (hW a)).of_le (by exact_mod_cast le_top)
    have hY0 : ∀ a, ∀ y ∈ ψ.source, y ∉ L0 → Y a y = 0 := by
      intro a y hy hyL
      rw [hYa]
      show v (ψ y) * W a y = 0
      rw [hv0 y hy hyL, zero_mul]
    have hdivL := divergence_setIntegral_eq_zero ψ.source L0 ψ.open_source hL0 hL0s Y hY hY0
    have hpt : ∀ y ∈ ψ.source, ∑ a : Fin 3, partialDeriv a (Y a) y =
        h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det +
          v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      intro y hy
      have hprod : ∀ a, partialDeriv a (Y a) y =
          partialDeriv a (fun z => v (ψ z)) y * W a y +
            v (ψ y) * partialDeriv a (W a) y := by
        intro a
        rw [hYa a]
        simp only [partialDeriv]
        rw [fderiv_fun_mul (hdA _ hζ y hy) (hdA _ (hW a) y hy)]
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      have hdiv : ∑ a : Fin 3, partialDeriv a (W a) y =
          Real.sqrt (h.coeff ψ y).det * lapLoc (h.coeff ψ) (fun z => w (ψ z)) y := by
        rw [hWdef]
        exact lapLoc_div_form ψ.source ψ.open_source (h.coeff ψ) hG hsymm hpos _ hV y hy
      have hlap : h.lapM w (ψ y) = lapLoc (h.coeff ψ) (fun z => w (ψ z)) y := by
        rw [show h.lapM w (ψ y) = lapM h w (ψ y) from rfl,
          ← lapLocal_chart_invariant h ψ w Set.univ isOpen_univ hw.contMDiffOn y hy
            (Set.mem_univ _)]
        rfl
      have e1 : ∑ a : Fin 3, partialDeriv a (fun z => v (ψ z)) y * W a y =
          (∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
            partialDeriv i (fun z => v (ψ z)) y * partialDeriv j (fun z => w (ψ z)) y) *
            Real.sqrt (h.coeff ψ y).det := by
        rw [hWdef]
        simp only [Finset.mul_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
        ring
      rw [Finset.sum_congr rfl fun a _ => hprod a, Finset.sum_add_distrib, ← Finset.mul_sum,
        hdiv, e1, gradInner_pdiffeo_formula h ψ v w hv hw y hy, hlap]
      ring
    have hsqc := (nds_chart_cont h ψ v w hv hw).2.2.2.1
    have hc1 : ContinuousOn (fun y => h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det)
        ψ.source := (nds_chart_cont h ψ v w hv hw).2.2.1.mul hsqc
    have hc2 : ContinuousOn
        (fun y => v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det) ψ.source :=
      ((hv.continuous.comp_continuousOn hψc).mul
        ((lapM_contMDiff h w hw).continuous.comp_continuousOn hψc)).mul hsqc
    have hi1 : IntegrableOn (fun y => h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det) L0 :=
      (hc1.mono hL0s).integrableOn_compact hL0
    have hi2 : IntegrableOn
        (fun y => v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det) L0 :=
      (hc2.mono hL0s).integrableOn_compact hL0
    have hsumL : ∫ y in L0, (h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det +
          v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det) = 0 :=
      (setIntegral_congr_fun hL0.isClosed.measurableSet
        fun y hy => (hpt y (hL0s hy)).symm).trans hdivL
    have hadd := integral_add hi1 hi2
    have e1 : ∫ y in ψ.source, h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det =
        ∫ y in L0, h.gradInner v w (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero ψ.open_source.measurableSet hL0s ?_
      intro y hy
      rw [hgv v (ψ y) (hvK y hy.1 hy.2), zero_mul]
    have e2 : ∫ y in ψ.source, v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det =
        ∫ y in L0, v (ψ y) * h.lapM w (ψ y) * Real.sqrt (h.coeff ψ y).det := by
      refine setIntegral_eq_of_subset_of_forall_diff_eq_zero ψ.open_source.measurableSet hL0s ?_
      intro y hy
      rw [hv0 y hy.1 hy.2, zero_mul, zero_mul]
    rw [e1, e2]
    linarith
  
  have hintg : ∀ i j, IntegrableOn (fun y => χ j (κ j y) * h.gradInner (u i) w (κ j y) *
      Real.sqrt (h.coeff (κ j) y).det) (κ j).source := by
    intro i j
    have := cls_chart_integrable h (κ j) (χ j) (hχs j) (hχt j) Set.univ isClosed_univ
      (h.gradInner (u i) w) (nds_chart_cont h (κ j) (u i) w (hu i) hw).2.2.1 (K i) (hKc i)
      (fun p hp => by rw [Set.indicator_univ]; exact hgv _ p (fun h' => hp (htsK i h')))
    simpa only [Set.indicator_univ] using this
  have hsum : atlasInt h κ χ (fun p => ∑ i, h.gradInner (u i) w p) =
      ∑ i, ∫ y in (κ i).source, h.gradInner (u i) w (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det := by
    have hlocI : ∀ i, atlasInt h κ χ (h.gradInner (u i) w) =
        ∫ y in (κ i).source, h.gradInner (u i) w (κ i y) * Real.sqrt (h.coeff (κ i) y).det :=
      fun i => hloc (κ i) (K i) (L i) (hLc i) (hLs i) (hKt i) (hKL i) _
        (fun p hp => hgv _ p (fun h' => hp (htsK i h')))
        (nds_chart_cont h (κ i) (u i) w (hu i) hw).2.2.1
    rw [Finset.sum_congr rfl fun i _ => (hlocI i).symm]
    simp only [atlasInt]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← integral_finset_sum _ (fun i _ => hintg i j)]
    refine setIntegral_congr_fun (κ j).open_source.measurableSet fun y _ => ?_
    simp only
    rw [Finset.mul_sum, Finset.sum_mul]
  have hstep : ∀ i, ∫ y in (κ i).source, h.gradInner (u i) w (κ i y) *
        Real.sqrt (h.coeff (κ i) y).det =
      -∫ y in (κ i).source, χ i (κ i y) * (φ (κ i y) * h.lapM w (κ i y)) *
        Real.sqrt (h.coeff (κ i) y).det := by
    intro i
    rw [hgreen (κ i) (L i) (hLc i) (hLs i) (u i) (hu i)
      (fun y hy hyL h' => hKL i y hy hyL (htsK i h'))]
    congr 1
    refine setIntegral_congr_fun (κ i).open_source.measurableSet fun y _ => ?_
    simp only
    rw [hup]
    ring
  rw [hsplitG, hsum, Finset.sum_congr rfl fun i _ => hstep i, Finset.sum_neg_distrib]
  rfl

theorem clsp_local_lower [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (f : M → ℝ) (hf : Continuous f) (p₀ : M) (a : ℝ)
    (ha : f p₀ < a) :
    ∃ (T : Set M) (c : ℝ), IsCompact T ∧ 0 < c ∧ (∀ p ∈ T, f p ≤ a) ∧
      ∀ (G : M → ℝ) (b : ℝ),
        (∀ ψ' : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
          ContinuousOn (fun y => G (ψ' y)) ψ'.source) →
        (∀ p, 0 ≤ G p) → (∃ K : Set M, IsCompact K ∧ ∀ p, p ∉ K → G p = 0) →
        (∀ p ∈ T, b ≤ G p) → c * b ≤ atlasInt g κ χ (T.indicator G) :=
by
  classical
  
  have hsum : ∑ i, χ i p₀ ≠ 0 := by rw [hA.2.2.2.1 p₀]; exact one_ne_zero
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
  obtain ⟨ψ, hψ⟩ : ∃ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞, ψ = κ i := ⟨_, rfl⟩
  have hp₀t : p₀ ∈ ψ.target := by
    rw [hψ]; exact hA.2.2.2.2.1 i (subset_tsupport _ (Function.mem_support.2 hi))
  have hy₀ : ψ.toPartialEquiv.symm p₀ ∈ ψ.source := ψ.toPartialEquiv.map_target hp₀t
  have hψy₀ : ψ (ψ.toPartialEquiv.symm p₀) = p₀ := ψ.toPartialEquiv.right_inv hp₀t
  have hψc : ContinuousOn ψ ψ.source := ψ.contMDiffOn_toFun.continuousOn
  have hfψ : ContinuousOn (fun y => f (ψ y)) ψ.source := hf.comp_continuousOn hψc
  
  obtain ⟨O, hOdef⟩ : ∃ O : Set E3, O = ψ.source ∩ (fun y => f (ψ y)) ⁻¹' Set.Iio a :=
    ⟨_, rfl⟩
  have hO : IsOpen O := by
    rw [hOdef]; exact hfψ.isOpen_inter_preimage ψ.open_source isOpen_Iio
  have hy₀O : ψ.toPartialEquiv.symm p₀ ∈ O := by
    rw [hOdef]
    refine ⟨hy₀, ?_⟩
    show f (ψ (ψ.toPartialEquiv.symm p₀)) < a
    rw [hψy₀]; exact ha
  obtain ⟨r₁, hr₁, hball⟩ := Metric.isOpen_iff.1 hO _ hy₀O
  obtain ⟨L, hLdef⟩ : ∃ L : Set E3,
      L = Metric.closedBall (ψ.toPartialEquiv.symm p₀) (r₁ / 2) := ⟨_, rfl⟩
  have hLO : L ⊆ O := by
    rw [hLdef]; exact (Metric.closedBall_subset_ball (half_lt_self hr₁)).trans hball
  have hLψ : L ⊆ ψ.source := fun y hy => by
    have h1 := hLO hy; rw [hOdef] at h1; exact h1.1
  have hLf : ∀ y ∈ L, f (ψ y) < a := fun y hy => by
    have h1 := hLO hy; rw [hOdef] at h1; exact h1.2
  have hLc : IsCompact L := by rw [hLdef]; exact isCompact_closedBall _ _
  have hLm : MeasurableSet L := by rw [hLdef]; exact measurableSet_closedBall
  have hLn : L ∈ 𝓝 (ψ.toPartialEquiv.symm p₀) := by
    rw [hLdef]; exact Metric.closedBall_mem_nhds _ (half_pos hr₁)
  
  obtain ⟨T, hTdef⟩ : ∃ T : Set M, T = ψ '' L := ⟨_, rfl⟩
  have hT : IsCompact T := by rw [hTdef]; exact hLc.image_of_continuousOn (hψc.mono hLψ)
  have hTcl : IsClosed T := hT.isClosed
  have hψT : ∀ y ∈ L, ψ y ∈ T := fun y hy => by rw [hTdef]; exact Set.mem_image_of_mem _ hy
  have hTf : ∀ p ∈ T, f p ≤ a := by
    intro p hp
    rw [hTdef] at hp
    obtain ⟨y, hy, rfl⟩ := hp
    exact (hLf y hy).le
  
  have hsd : ContinuousOn (fun y => Real.sqrt (g.coeff ψ y).det) ψ.source :=
    (nds_chart_cont g ψ (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ)) contMDiff_const
      contMDiff_const).2.2.2.1
  have hsdL := hsd.mono hLψ
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = ∫ y in L, Real.sqrt (g.coeff ψ y).det := ⟨_, rfl⟩
  have hc : 0 < c := by
    rw [hcdef, setIntegral_pos_iff_support_of_nonneg_ae
      (Filter.Eventually.of_forall fun y => Real.sqrt_nonneg _) (hsdL.integrableOn_compact hLc)]
    refine lt_of_lt_of_le (Measure.measure_pos_of_mem_nhds _ hLn) (measure_mono ?_)
    intro y hy
    exact ⟨(Real.sqrt_pos.2 (coeff_posDef g ψ y (hLψ hy)).det_pos).ne', hy⟩
  refine ⟨T, c, hT, hc, hTf, ?_⟩
  rintro G b hG hG0 ⟨K, hK, hGK⟩ hb
  have I₁ : IntegrableOn (fun y => b * Real.sqrt (g.coeff ψ y).det) L :=
    (continuousOn_const.mul hsdL).integrableOn_compact hLc
  have I₂ : IntegrableOn (fun y => T.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det) L := by
    refine ((((hG ψ).mono hLψ).mul hsdL).integrableOn_compact hLc).congr_fun ?_ hLm
    intro y hy
    simp only [Set.indicator_of_mem (hψT y hy)]
  have hmono : ∫ y in L, b * Real.sqrt (g.coeff ψ y).det ≤
      ∫ y in L, T.indicator G (ψ y) * Real.sqrt (g.coeff ψ y).det := by
    refine setIntegral_mono_on I₁ I₂ hLm fun y hy => ?_
    rw [Set.indicator_of_mem (hψT y hy)]
    exact mul_le_mul_of_nonneg_right (hb _ (hψT y hy)) (Real.sqrt_nonneg _)
  have hloc := cceb_localize_lower_ind g hAF ρA κ χ hA ψ L hLc hLψ G hG hG0 K hK hGK T hTcl
  calc c * b = ∫ y in L, b * Real.sqrt (g.coeff ψ y).det := by
        rw [integral_const_mul, hcdef, mul_comm]
    _ ≤ _ := hmono
    _ ≤ _ := hloc

theorem clsp_weak_min [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g h : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (S : Set M) (ε₀ cS : ℝ) (hε₀ : 0 < ε₀) (hcS : 0 ≤ cS)
    (hcoer : ∀ u : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → HasCompactSupport u →
      (∀ V : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → (∀ p, p ∉ S → V p = 0) →
        (∀ p, |V p| ≤ ε₀) →
        |atlasInt h κ χ (fun p => V p * u p * u p)| ≤
          (1 / 2) * atlasInt h κ χ (h.gradInner u u)) ∧
      (∀ (F : M → ℝ) (B : ℝ), ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F → (∀ p, p ∉ S → F p = 0) →
        (∀ p, |F p| ≤ B) →
        |atlasInt h κ χ (fun p => F p * u p)| ≤
          cS * B * Real.sqrt (atlasInt h κ χ (h.gradInner u u))) ∧
      atlasInt g κ χ (g.gradInner u u) ≤ 4 * Real.sqrt 2 * atlasInt h κ χ (h.gradInner u u))
    (V w : M → ℝ) (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w)
    (hVS : ∀ p, p ∉ S → V p = 0) (hVb : ∀ p, |V p| ≤ ε₀)
    (heq : ∀ p, -8 * h.lapM w p + V p * w p = 0)
    (K : Set M) (hK : IsCompact K) (hKw : ∀ p, p ∉ K → 0 < w p) :
    ∀ p, 0 ≤ w p :=
by
  classical
  
  obtain ⟨C₀, hC₀⟩ := hK.exists_bound_of_continuousOn hw.continuous.continuousOn
  obtain ⟨A, hAdef⟩ : ∃ A : ℝ, A = max C₀ 0 := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hAdef]; exact le_max_right _ _
  have hAC : C₀ ≤ A := by rw [hAdef]; exact le_max_left _ _
  have hAw : ∀ p, -A ≤ w p := by
    intro p
    by_cases hp : p ∈ K
    · have h1 := hC₀ p hp
      rw [Real.norm_eq_abs] at h1
      have h2 := neg_abs_le (w p)
      linarith
    · have := hKw p hp
      linarith
  
  by_contra hneg
  push_neg at hneg
  obtain ⟨p₀, hp₀⟩ := hneg
  obtain ⟨a, hadef⟩ : ∃ a : ℝ, a = -w p₀ := ⟨_, rfl⟩
  have ha : 0 < a := by rw [hadef]; linarith
  obtain ⟨T, c, hT, hc, hTw, hlow⟩ :=
    clsp_local_lower g hAF ρA κ χ hA w hw.continuous p₀ (-a / 2) (by rw [hadef]; linarith)
  obtain ⟨CT, hCT, hPT⟩ := cls_poincare_compact g hAF k ρA κ χ hA T hT
  obtain ⟨K₁, hK₁def⟩ : ∃ K₁ : ℝ, K₁ = cS * ε₀ * (A + 1) := ⟨_, rfl⟩
  have hK₁0 : 0 ≤ K₁ := by
    rw [hK₁def]; exact mul_nonneg (mul_nonneg hcS hε₀.le) (by linarith)
  obtain ⟨Cst, hCstdef⟩ : ∃ Cst : ℝ, Cst = CT * (4 * Real.sqrt 2) * ((2 / 11) * K₁) ^ 2 :=
    ⟨_, rfl⟩
  have hCst0 : 0 ≤ Cst := by
    rw [hCstdef]
    exact mul_nonneg (mul_nonneg hCT (by positivity)) (sq_nonneg _)
  obtain ⟨X, hXdef⟩ : ∃ X : ℝ, X = c * (a / 4) ^ 4 := ⟨_, rfl⟩
  have hX0 : 0 < X := by rw [hXdef]; exact mul_pos hc (pow_pos (by linarith) 4)
  obtain ⟨δ, hδdef⟩ : ∃ δ : ℝ, δ = min (a / 4) (min 1 (X / (2 * (Cst + 1)))) := ⟨_, rfl⟩
  have hδ : 0 < δ := by
    rw [hδdef]
    exact lt_min (by linarith) (lt_min one_pos (div_pos hX0 (by linarith)))
  have hδa : δ ≤ a / 4 := by rw [hδdef]; exact min_le_left _ _
  have hδ1 : δ ≤ 1 := by rw [hδdef]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hδX : δ ≤ X / (2 * (Cst + 1)) := by
    rw [hδdef]; exact (min_le_right _ _).trans (min_le_right _ _)
  
  obtain ⟨m, hm1, hm2, hm3, hm4, hm5, hm7⟩ : ∃ m : ℝ → ℝ, ContDiff ℝ ∞ m ∧
      (∀ t, 0 ≤ t → m t = 0) ∧ (∀ t, 0 ≤ m t) ∧ (∀ t, -t - δ ≤ m t) ∧
      (∀ t, m t ≤ max (-t) 0 + δ) ∧ (∀ t, -1 ≤ deriv m t ∧ deriv m t ≤ 0) := by
    obtain ⟨h1, h2, h3, h4, h5, _, h7⟩ := clsp_profile δ hδ
    exact ⟨fun t => δ * smax1 (-t / δ - 1), h1, h2, h3, h4, h5, h7⟩
  have hzK : ∀ p, p ∉ K → m (w p) = 0 := fun p hp => hm2 _ (hKw p hp).le
  have hmw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun q => m (w q)) := hm1.comp_contMDiff hw
  obtain ⟨U, hUdef⟩ : ∃ U : M → ℝ, U = fun q => m (w q) ^ 2 := ⟨_, rfl⟩
  obtain ⟨φ, hφdef⟩ : ∃ φ : M → ℝ, φ = fun q => m (w q) ^ 3 := ⟨_, rfl⟩
  obtain ⟨F, hFdef⟩ : ∃ F : M → ℝ, F = fun q => V q * (w q + m (w q)) * m (w q) := ⟨_, rfl⟩
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = ε₀ * δ * (A + 1) := ⟨_, rfl⟩
  have hB0 : 0 ≤ B := by rw [hBdef]; exact mul_nonneg (mul_nonneg hε₀.le hδ.le) (by linarith)
  have hUp : ∀ q, U q = m (w q) ^ 2 := fun q => by rw [hUdef]
  have hφp : ∀ q, φ q = m (w q) ^ 3 := fun q => by rw [hφdef]
  have hFp : ∀ q, F q = V q * (w q + m (w q)) * m (w q) := fun q => by rw [hFdef]
  have hU : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ U := by rw [hUdef]; exact hmw.pow 2
  have hφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ φ := by rw [hφdef]; exact hmw.pow 3
  have hF : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    rw [hFdef]; exact (hV.mul (hw.add hmw)).mul hmw
  have hU0 : ∀ p, p ∉ K → U p = 0 := fun p hp => by rw [hUp, hzK p hp]; ring
  have hφ0 : ∀ p, p ∉ K → φ p = 0 := fun p hp => by rw [hφp, hzK p hp]; ring
  have hUc : HasCompactSupport U := HasCompactSupport.intro hK hU0
  have hφc : HasCompactSupport φ := HasCompactSupport.intro hK hφ0
  have hFS : ∀ p, p ∉ S → F p = 0 := fun p hp => by rw [hFp, hVS p hp]; ring
  have hFb : ∀ p, |F p| ≤ B := by
    intro p
    rw [hFp, hBdef]
    by_cases hwp : 0 ≤ w p
    · rw [hm2 _ hwp, mul_zero, abs_zero]
      exact mul_nonneg (mul_nonneg hε₀.le hδ.le) (by linarith)
    · push_neg at hwp
      have h4 := hm4 (w p)
      have h5 := hm5 (w p)
      rw [max_eq_left (by linarith)] at h5
      have h3 := hm3 (w p)
      have hA' := hAw p
      rw [abs_mul, abs_mul]
      have e1 : |w p + m (w p)| ≤ δ := abs_le.2 ⟨by linarith, by linarith⟩
      have e2 : |m (w p)| ≤ A + 1 := by rw [abs_of_nonneg h3]; linarith
      exact mul_le_mul (mul_le_mul (hVb p) e1 (abs_nonneg _) hε₀.le) e2 (abs_nonneg _)
        (mul_nonneg hε₀.le hδ.le)
  
  have hcc : ∀ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
      ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
        ContinuousOn (fun y => f (ψ y)) ψ.source :=
    fun f hf ψ => (nds_chart_cont h ψ f f hf hf).1.continuousOn
  have hgc : ∀ u v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v →
      ∀ ψ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
        ContinuousOn (fun y => h.gradInner u v (ψ y)) ψ.source :=
    fun u v hu hv ψ => (nds_chart_cont h ψ u v hu hv).2.2.1
  have alg : ∀ F₁ G₁ : M → ℝ, (∀ i, ContinuousOn (fun y => F₁ (κ i y)) (κ i).source) →
      (∀ i, ContinuousOn (fun y => G₁ (κ i y)) (κ i).source) →
      (∀ p, p ∉ K → F₁ p = 0) → (∀ p, p ∉ K → G₁ p = 0) →
      atlasInt h κ χ (fun p => F₁ p + G₁ p) = atlasInt h κ χ F₁ + atlasInt h κ χ G₁ ∧
      (∀ c : ℝ, atlasInt h κ χ (fun p => c * F₁ p) = c * atlasInt h κ χ F₁) ∧
      ((∀ p, F₁ p ≤ G₁ p) → atlasInt h κ χ F₁ ≤ atlasInt h κ χ G₁) ∧
      ((∀ p, 0 ≤ F₁ p) → 0 ≤ atlasInt h κ χ F₁) :=
    fun F₁ G₁ hF₁ hG₁ hF₁K hG₁K =>
      clsp_atlasInt_algebra g hAF ρA κ χ hA h F₁ G₁ hF₁ hG₁ K K hK hK hF₁K hG₁K
  
  have hmd : ∀ t, HasDerivAt m (deriv m t) t :=
    fun t => ((hm1.differentiable (by simp)) t).hasDerivAt
  have hd2 : ∀ t, deriv (fun s => m s ^ 2) t = 2 * m t * deriv m t := by
    intro t
    have h2 : HasDerivAt (fun s => m s ^ 2) _ t := (hmd t).pow 2
    rw [h2.deriv]; norm_num
  have hd3 : ∀ t, deriv (fun s => m s ^ 3) t = 3 * m t ^ 2 * deriv m t := by
    intro t
    have h3 : HasDerivAt (fun s => m s ^ 3) _ t := (hmd t).pow 3
    rw [h3.deriv]; norm_num
  have hGw : ∀ p, 0 ≤ h.gradInner w w p := (cceb_gradInner_self_facts h w hw).1
  have hgφw : ∀ p, h.gradInner φ w p = 3 * m (w p) ^ 2 * deriv m (w p) * h.gradInner w w p := by
    intro p
    have h1 := (clsp_gradInner_comp h w hw (fun s => m s ^ 3) (hm1.pow 3) p).1
    rw [hd3] at h1
    rw [hφdef]
    exact h1
  have hgUU : ∀ p, h.gradInner U U p = (2 * m (w p) * deriv m (w p)) ^ 2 * h.gradInner w w p := by
    intro p
    have h1 := (clsp_gradInner_comp h w hw (fun s => m s ^ 2) (hm1.pow 2) p).2
    rw [hd2] at h1
    rw [hUdef]
    exact h1
  have hP : ∀ p, (3 / 4 : ℝ) * h.gradInner U U p ≤ (-1) * h.gradInner φ w p := by
    intro p
    rw [hgUU, hgφw]
    have hm7p := hm7 (w p)
    have key : 0 ≤ m (w p) ^ 2 * h.gradInner w w p *
        ((-deriv m (w p)) * (1 + deriv m (w p))) :=
      mul_nonneg (mul_nonneg (sq_nonneg _) (hGw p))
        (mul_nonneg (by linarith [hm7p.2]) (by linarith [hm7p.1]))
    nlinarith [key]
  have hgUU0 : ∀ p, p ∉ K → h.gradInner U U p = 0 := fun p hp => by
    rw [hgUU, hzK p hp]; ring
  have hgφw0 : ∀ p, p ∉ K → h.gradInner φ w p = 0 := fun p hp => by
    rw [hgφw, hzK p hp]; ring
  
  have hlap : ∀ p, h.lapM w p = V p * w p / 8 := fun p => by have := heq p; linarith
  have hgreen := clsp_green_atlas g hAF ρA κ χ hA h φ w hφ hφc hw
  have hfun1 : (fun p => φ p * h.lapM w p) = (fun p => (1 / 8 : ℝ) * (V p * w p * φ p)) := by
    funext p; rw [hlap]; ring
  rw [hfun1] at hgreen
  have hVwφ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => V p * w p * φ p) := (hV.mul hw).mul hφ
  have hVwφ0 : ∀ p, p ∉ K → V p * w p * φ p = 0 := fun p hp => by rw [hφ0 p hp, mul_zero]
  have hE1 : atlasInt h κ χ (fun p => (1 / 8 : ℝ) * (V p * w p * φ p)) =
      (1 / 8) * atlasInt h κ χ (fun p => V p * w p * φ p) :=
    (alg (fun p => V p * w p * φ p) (fun p => V p * w p * φ p) (fun i => hcc _ hVwφ (κ i))
      (fun i => hcc _ hVwφ (κ i)) hVwφ0 hVwφ0).2.1 (1 / 8)
  
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = atlasInt h κ χ (h.gradInner U U) := ⟨_, rfl⟩
  have hD0 : 0 ≤ D := by
    rw [hDdef]
    exact (alg (h.gradInner U U) (h.gradInner U U) (fun i => hgc U U hU hU (κ i))
      (fun i => hgc U U hU hU (κ i)) hgUU0 hgUU0).2.2.2 (cceb_gradInner_self_facts h U hU).1
  have hmono : atlasInt h κ χ (fun p => (3 / 4 : ℝ) * h.gradInner U U p) ≤
      atlasInt h κ χ (fun p => (-1) * h.gradInner φ w p) :=
    (alg (fun p => (3 / 4 : ℝ) * h.gradInner U U p) (fun p => (-1) * h.gradInner φ w p)
      (fun i => continuousOn_const.mul (hgc U U hU hU (κ i)))
      (fun i => continuousOn_const.mul (hgc φ w hφ hw (κ i)))
      (fun p hp => by simp [hgUU0 p hp])
      (fun p hp => by simp [hgφw0 p hp])).2.2.1
      hP
  have hh1 : atlasInt h κ χ (fun p => (3 / 4 : ℝ) * h.gradInner U U p) =
      (3 / 4) * atlasInt h κ χ (h.gradInner U U) :=
    (alg (h.gradInner U U) (h.gradInner U U) (fun i => hgc U U hU hU (κ i))
      (fun i => hgc U U hU hU (κ i)) hgUU0 hgUU0).2.1 (3 / 4)
  have hh2 : atlasInt h κ χ (fun p => (-1) * h.gradInner φ w p) =
      (-1) * atlasInt h κ χ (h.gradInner φ w) :=
    (alg (h.gradInner φ w) (h.gradInner φ w) (fun i => hgc φ w hφ hw (κ i))
      (fun i => hgc φ w hφ hw (κ i)) hgφw0 hgφw0).2.1 (-1)
  have hsplit : (fun p => V p * w p * φ p) =
      (fun p => (-1) * (V p * U p * U p) + F p * U p) := by
    funext p; rw [hφp, hUp, hFp]; ring
  have hVUU : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => V p * U p * U p) := (hV.mul hU).mul hU
  have hnVUU : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => (-1) * (V p * U p * U p)) :=
    contMDiff_const.mul hVUU
  have hFU : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => F p * U p) := hF.mul hU
  have hI : atlasInt h κ χ (fun p => V p * w p * φ p) =
      -atlasInt h κ χ (fun p => V p * U p * U p) + atlasInt h κ χ (fun p => F p * U p) := by
    rw [hsplit]
    have e1 : atlasInt h κ χ (fun p => (-1) * (V p * U p * U p) + F p * U p) =
        atlasInt h κ χ (fun p => (-1) * (V p * U p * U p)) +
          atlasInt h κ χ (fun p => F p * U p) :=
      (alg (fun p => (-1) * (V p * U p * U p)) (fun p => F p * U p)
        (fun i => hcc _ hnVUU (κ i)) (fun i => hcc _ hFU (κ i))
        (fun p hp => by simp [hU0 p hp]) (fun p hp => by simp [hU0 p hp])).1
    have e2 : atlasInt h κ χ (fun p => (-1) * (V p * U p * U p)) =
        (-1) * atlasInt h κ χ (fun p => V p * U p * U p) :=
      (alg (fun p => V p * U p * U p) (fun p => V p * U p * U p)
        (fun i => hcc _ hVUU (κ i)) (fun i => hcc _ hVUU (κ i))
        (fun p hp => by simp [hU0 p hp]) (fun p hp => by simp [hU0 p hp])).2.1 (-1)
    rw [e1, e2]; ring
  obtain ⟨hC1, hC2, hC3⟩ := hcoer U hU hUc
  have i1 := hC1 V hV hVS hVb
  have i2 := hC2 F B hF hFS hFb
  rw [← hDdef] at i1 i2 hC3 hh1
  have j1 := neg_abs_le (atlasInt h κ χ (fun p => V p * U p * U p))
  have j2 := le_abs_self (atlasInt h κ χ (fun p => F p * U p))
  have hen : (11 / 2 : ℝ) * D ≤ cS * B * Real.sqrt D := by
    rw [hh1, hh2] at hmono
    linarith
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Real.sqrt D := ⟨_, rfl⟩
  have hs0 : 0 ≤ s := by rw [hsdef]; exact Real.sqrt_nonneg _
  have hsD : s ^ 2 = D := by rw [hsdef]; exact Real.sq_sqrt hD0
  rw [← hsdef, ← hsD] at hen
  have hsle : s ≤ 2 / 11 * (cS * B) := by
    rcases eq_or_lt_of_le hs0 with h0 | hpos
    · rw [← h0]; exact mul_nonneg (by norm_num) (mul_nonneg hcS hB0)
    · nlinarith
  have hDle : D ≤ ((2 / 11) * K₁) ^ 2 * δ ^ 2 := by
    have h1 : s ^ 2 ≤ (2 / 11 * (cS * B)) ^ 2 := pow_le_pow_left₀ hs0 hsle 2
    calc D = s ^ 2 := hsD.symm
      _ ≤ (2 / 11 * (cS * B)) ^ 2 := h1
      _ = ((2 / 11) * K₁) ^ 2 * δ ^ 2 := by rw [hBdef, hK₁def]; ring
  
  have hU2 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun p => U p ^ 2) := hU.pow 2
  have hlowU := hlow (fun p => U p ^ 2) ((a / 4) ^ 4) (fun ψ => hcc _ hU2 ψ)
    (fun p => sq_nonneg _) ⟨K, hK, fun p hp => by simp [hU0 p hp]⟩ (by
      intro p hp
      have hwT := hTw p hp
      have h4 := hm4 (w p)
      have hx : a / 4 ≤ m (w p) := by linarith
      show (a / 4) ^ 4 ≤ U p ^ 2
      rw [hUp]
      have h1 : (a / 4) ^ 2 ≤ m (w p) ^ 2 := pow_le_pow_left₀ (by linarith) hx 2
      have h2 : ((a / 4) ^ 2) ^ 2 ≤ (m (w p) ^ 2) ^ 2 := pow_le_pow_left₀ (by positivity) h1 2
      calc (a / 4) ^ 4 = ((a / 4) ^ 2) ^ 2 := by ring
        _ ≤ (m (w p) ^ 2) ^ 2 := h2)
  have hPU := hPT U hU hUc
  have h4 : CT * atlasInt g κ χ (g.gradInner U U) ≤ CT * (4 * Real.sqrt 2 * D) :=
    mul_le_mul_of_nonneg_left hC3 hCT
  have h5 : CT * (4 * Real.sqrt 2 * D) ≤
      CT * (4 * Real.sqrt 2 * (((2 / 11) * K₁) ^ 2 * δ ^ 2)) :=
    mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hDle (by positivity)) hCT
  have hXle : X ≤ Cst * δ ^ 2 := by
    have e : CT * (4 * Real.sqrt 2 * (((2 / 11) * K₁) ^ 2 * δ ^ 2)) = Cst * δ ^ 2 := by
      rw [hCstdef]; ring
    rw [hXdef]
    linarith
  
  have hδ2 : δ ^ 2 ≤ δ := by nlinarith
  have e1 : Cst * δ ^ 2 ≤ Cst * δ := mul_le_mul_of_nonneg_left hδ2 hCst0
  have e2 : Cst * δ ≤ Cst * (X / (2 * (Cst + 1))) := mul_le_mul_of_nonneg_left hδX hCst0
  have e3 : Cst * (X / (2 * (Cst + 1))) < X := by
    have hpos : 0 < 2 * (Cst + 1) := by linarith
    rw [mul_div_assoc', div_lt_iff₀ hpos]
    nlinarith
  linarith

theorem clsp_local_zero_open [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (ρA : ℝ)
    {n : ℕ} (κ : Fin n → PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (χ : Fin n → M → ℝ)
    (hA : IsCLSAtlas g hAF ρA κ χ) (h : RiemannianMetric3 M) (V w : M → ℝ)
    (hV : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V) (hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w)
    (heq : ∀ p, -8 * h.lapM w p + V p * w p = 0) (hnn : ∀ p, 0 ≤ w p)
    (p₁ : M) (hp₁ : w p₁ = 0) :
    ∃ N ∈ 𝓝 p₁, ∀ p ∈ N, w p = 0 :=
by
  
  unfold IsCLSAtlas at hA
  obtain ⟨-, -, -, hsum, hts, -⟩ := hA
  have hne : ∑ i, χ i p₁ ≠ 0 := by rw [hsum p₁]; exact one_ne_zero
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
  have hpt : p₁ ∈ (κ i).target := hts i (subset_tsupport (χ i) (Function.mem_support.2 hi))
  generalize κ i = ψ at hpt
  obtain ⟨y₁, hy₁def⟩ : ∃ y₁ : E3, y₁ = ψ.symm p₁ := ⟨_, rfl⟩
  have hy₁ : y₁ ∈ ψ.source := by rw [hy₁def]; exact ψ.toPartialEquiv.map_target hpt
  have hψy₁ : ψ y₁ = p₁ := by rw [hy₁def]; exact ψ.toPartialEquiv.right_inv hpt
  
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 ψ.open_source y₁ hy₁
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = ε / 3 := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hRdef]; positivity
  have hball2 : Metric.closedBall y₁ (2 * R) ⊆ ψ.source :=
    (Metric.closedBall_subset_ball (by rw [hRdef]; linarith)).trans hball
  have hball1 : Metric.closedBall y₁ R ⊆ ψ.source :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball2
  have hΩK : Metric.ball y₁ R ⊆ Metric.closedBall y₁ R := Metric.ball_subset_closedBall
  have hΩs : Metric.ball y₁ R ⊆ ψ.source := hΩK.trans hball1
  
  have hf : ContDiffOn ℝ ∞ (fun z => w (ψ z)) ψ.source :=
    contMDiffOn_iff_contDiffOn.mp (hw.comp_contMDiffOn ψ.contMDiffOn_toFun)
  let ζ : ContDiffBump y₁ := ⟨R, 2 * R, hR, by linarith⟩
  obtain ⟨W, hWdef⟩ : ∃ W : E3 → ℝ, W = fun y => ζ y * w (ψ y) := ⟨_, rfl⟩
  have hWy : ∀ y, W y = ζ y * w (ψ y) := fun y => by rw [hWdef]
  have hζ1 : ∀ y ∈ Metric.closedBall y₁ R, ζ y = 1 := fun y hy => ζ.one_of_mem_closedBall hy
  have hWc : ContDiff ℝ 2 W := by
    have hinf : ContDiff ℝ ∞ W := by
      rw [contDiff_iff_contDiffAt]
      intro y
      by_cases hy : y ∈ ψ.source
      · rw [hWdef]
        exact (ζ.contDiff.contDiffOn.mul hf).contDiffAt (ψ.open_source.mem_nhds hy)
      · have hyt : y ∉ tsupport (ζ : E3 → ℝ) := by
          rw [ζ.tsupport_eq]
          exact fun hc => hy (hball2 hc)
        have hev := notMem_tsupport_iff_eventuallyEq.1 hyt
        have hev' : W =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
          filter_upwards [hev] with z hz
          have hz' : ζ z = 0 := hz
          rw [hWy z, hz', zero_mul]
        exact contDiffAt_const.congr_of_eventuallyEq hev'
    exact hinf.of_le (WithTop.coe_le_coe.2 le_top)
  have hW0 : ∀ y, 0 ≤ W y := fun y => by rw [hWy y]; exact mul_nonneg ζ.nonneg (hnn _)
  have hWv : ∀ y ∈ Metric.ball y₁ R, W y = w (ψ y) := by
    intro y hy
    rw [hWy y, hζ1 y (hΩK hy), one_mul]
  have hWev : ∀ y ∈ Metric.ball y₁ R, W =ᶠ[𝓝 y] (fun z => w (ψ z)) := by
    intro y hy
    filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
    exact hWv z hz
  have hW1 : ∀ y ∈ Metric.ball y₁ R, ∀ k : Fin 3,
      partialDeriv k W y = partialDeriv k (fun z => w (ψ z)) y := by
    intro y hy k
    exact congrArg (fun L : E3 →L[ℝ] ℝ => L (e k)) (hWev y hy).fderiv_eq
  have hW2 : ∀ y ∈ Metric.ball y₁ R, ∀ i j : Fin 3,
      partialDeriv i (partialDeriv j W) y =
        partialDeriv i (partialDeriv j (fun z => w (ψ z))) y := by
    intro y hy i j
    have hev : partialDeriv j W =ᶠ[𝓝 y] partialDeriv j (fun z => w (ψ z)) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
      exact hW1 z hz j
    exact congrArg (fun L : E3 →L[ℝ] ℝ => L (e i)) hev.fderiv_eq
  
  have hGsm : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => h.coeff ψ y a b) ψ.source :=
    fun a b => coeff_contDiffOn_source h ψ a b
  have hpos : ∀ y ∈ ψ.source, (h.coeff ψ y).PosDef := fun y hy => coeff_posDef h ψ y hy
  obtain ⟨m, Mx, Gam, hm, hMx, hGam, hCB⟩ :=
    coeff_compact_bounds (h.coeff ψ) ψ.source y₁ R ψ.open_source hball1 hGsm hpos
  have hscont : ContinuousOn (fun y => ∑ a : Fin 3, ∑ b : Fin 3, |h.coeff ψ y a b|) ψ.source :=
    continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
      (hGsm a b).continuousOn.abs
  have hinvc := (nds_chart_cont h ψ (fun _ => (0 : ℝ)) (fun _ => (0 : ℝ))
    contMDiff_const contMDiff_const).2.2.2.2
  have hicont : ContinuousOn
      (fun y => ∑ a : Fin 3, ∑ b : Fin 3, |(h.coeff ψ y)⁻¹ a b|) ψ.source :=
    continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ => (hinvc a b).abs
  have hVc : ContinuousOn (fun y => V (ψ y)) ψ.source :=
    hV.continuous.comp_continuousOn ψ.contMDiffOn_toFun.continuousOn
  obtain ⟨C₁, hC₁⟩ := (isCompact_closedBall y₁ R).exists_bound_of_continuousOn (hscont.mono hball1)
  obtain ⟨C₂, hC₂⟩ := (isCompact_closedBall y₁ R).exists_bound_of_continuousOn (hicont.mono hball1)
  obtain ⟨C₃, hC₃⟩ := (isCompact_closedBall y₁ R).exists_bound_of_continuousOn (hVc.mono hball1)
  have hB : 0 < max C₁ 1 := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hell : ∀ y ∈ Metric.closedBall y₁ R, ∀ v : Fin 3 → ℝ,
      (1 / max C₁ 1) * ∑ i, v i ^ 2 ≤ ∑ i, ∑ j, (h.coeff ψ y)⁻¹ i j * v i * v j := by
    intro y hy v
    have hq := cceb_inv_quad_lower (h.coeff ψ y) (hpos y (hball1 hy)) v
    have hs0 : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, |h.coeff ψ y i j| :=
      Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _
    have hsB : ∑ i : Fin 3, ∑ j : Fin 3, |h.coeff ψ y i j| ≤ max C₁ 1 := by
      have h1 : ‖∑ i : Fin 3, ∑ j : Fin 3, |h.coeff ψ y i j|‖ ≤ C₁ := hC₁ y hy
      rw [Real.norm_eq_abs, abs_of_nonneg hs0] at h1
      exact h1.trans (le_max_left _ _)
    have hv0 : 0 ≤ ∑ i : Fin 3, v i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hQ : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * v i * v j := by
      by_contra hneg
      push_neg at hneg
      have h1 : (∑ i : Fin 3, ∑ j : Fin 3, |h.coeff ψ y i j|) *
          (∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * v i * v j) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hs0 hneg.le
      have h2 : ∑ i : Fin 3, v i ^ 2 = 0 := le_antisymm (hq.trans h1) hv0
      have hv : ∀ i, v i = 0 := by
        intro i
        have h3 := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => sq_nonneg (v i))).1 h2 i
          (Finset.mem_univ _)
        exact (pow_eq_zero_iff two_ne_zero).1 h3
      have h4 : ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * v i * v j = 0 := by
        simp [hv]
      linarith
    calc (1 / max C₁ 1) * ∑ i, v i ^ 2
        ≤ (1 / max C₁ 1) * (max C₁ 1 * ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * v i * v j) :=
          mul_le_mul_of_nonneg_left (hq.trans (mul_le_mul_of_nonneg_right hsB hQ))
            (one_div_pos.2 hB).le
      _ = ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * v i * v j := by
          rw [← mul_assoc, one_div_mul_cancel hB.ne', one_mul]
  obtain ⟨Lam, hLamdef⟩ : ∃ L : ℝ, L = max C₂ 0 := ⟨_, rfl⟩
  have hLam0 : 0 ≤ Lam := by rw [hLamdef]; exact le_max_right _ _
  have hLamB : ∀ y ∈ Metric.closedBall y₁ R, ∀ a b : Fin 3, |(h.coeff ψ y)⁻¹ a b| ≤ Lam := by
    intro y hy a b
    have hs0 : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, |(h.coeff ψ y)⁻¹ i j| :=
      Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _
    have h1 : ‖∑ i : Fin 3, ∑ j : Fin 3, |(h.coeff ψ y)⁻¹ i j|‖ ≤ C₂ := hC₂ y hy
    rw [Real.norm_eq_abs, abs_of_nonneg hs0] at h1
    rw [hLamdef]
    calc |(h.coeff ψ y)⁻¹ a b| ≤ ∑ j : Fin 3, |(h.coeff ψ y)⁻¹ a j| :=
          Finset.single_le_sum (f := fun j => |(h.coeff ψ y)⁻¹ a j|)
            (fun j _ => abs_nonneg _) (Finset.mem_univ b)
      _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, |(h.coeff ψ y)⁻¹ i j| :=
          Finset.single_le_sum (f := fun i => ∑ j : Fin 3, |(h.coeff ψ y)⁻¹ i j|)
            (fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _) (Finset.mem_univ a)
      _ ≤ C₂ := h1
      _ ≤ max C₂ 0 := le_max_left _ _
  obtain ⟨BV, hBVdef⟩ : ∃ B : ℝ, B = max C₃ 0 := ⟨_, rfl⟩
  have hBV0 : 0 ≤ BV := by rw [hBVdef]; exact le_max_right _ _
  have hBVB : ∀ y ∈ Metric.closedBall y₁ R, |V (ψ y)| ≤ BV := by
    intro y hy
    have h1 : ‖V (ψ y)‖ ≤ C₃ := hC₃ y hy
    rw [Real.norm_eq_abs] at h1
    rw [hBVdef]
    exact h1.trans (le_max_left _ _)
  
  have hceq : ∀ y ∈ ψ.source,
      ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          partialDeriv i (partialDeriv j (fun z => w (ψ z))) y =
        ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          ∑ k : Fin 3, christoffel (h.coeff ψ) k i j y * partialDeriv k (fun z => w (ψ z)) y
        + V (ψ y) * w (ψ y) / 8 := by
    intro y hy
    have hinv := lapLocal_chart_invariant h ψ w Set.univ isOpen_univ hw.contMDiffOn y hy
      (Set.mem_univ _)
    have e2 : lapM h w (ψ y) = h.lapM w (ψ y) := rfl
    have e3 := heq (ψ y)
    have hL : lapLocal (h.coeff ψ) (w ∘ ψ) y =
        ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          partialDeriv i (partialDeriv j (fun z => w (ψ z))) y -
        ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          ∑ k : Fin 3, christoffel (h.coeff ψ) k i j y * partialDeriv k (fun z => w (ψ z)) y := by
      unfold lapLocal
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => ?_
      exact mul_sub _ _ _
    linarith
  
  have hpb : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (C : Fin 3 → Fin 3 → Fin 3 → ℝ) (d : Fin 3 → ℝ)
      (L G : ℝ), 0 ≤ L → 0 ≤ G → (∀ i j, |A i j| ≤ L) → (∀ k i j, |C k i j| ≤ G) →
      ∑ i : Fin 3, ∑ j : Fin 3, A i j * ∑ k : Fin 3, C k i j * d k ≤
        9 * L * G * ∑ k : Fin 3, |d k| := by
    intro A C d L G hL hG hAb hCb
    have hterm : ∀ i j, A i j * ∑ k : Fin 3, C k i j * d k ≤ L * G * ∑ k : Fin 3, |d k| := by
      intro i j
      have h1 : |∑ k : Fin 3, C k i j * d k| ≤ G * ∑ k : Fin 3, |d k| := by
        calc |∑ k : Fin 3, C k i j * d k| ≤ ∑ k : Fin 3, |C k i j * d k| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ k : Fin 3, G * |d k| := Finset.sum_le_sum fun k _ => by
              rw [abs_mul]; exact mul_le_mul_of_nonneg_right (hCb k i j) (abs_nonneg _)
          _ = G * ∑ k : Fin 3, |d k| := by rw [Finset.mul_sum]
      calc A i j * ∑ k : Fin 3, C k i j * d k ≤ |A i j * ∑ k : Fin 3, C k i j * d k| :=
            le_abs_self _
        _ = |A i j| * |∑ k : Fin 3, C k i j * d k| := abs_mul _ _
        _ ≤ L * (G * ∑ k : Fin 3, |d k|) := mul_le_mul (hAb i j) h1 (abs_nonneg _) hL
        _ = L * G * ∑ k : Fin 3, |d k| := by ring
    calc ∑ i : Fin 3, ∑ j : Fin 3, A i j * ∑ k : Fin 3, C k i j * d k
        ≤ ∑ i : Fin 3, ∑ j : Fin 3, L * G * ∑ k : Fin 3, |d k| :=
          Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hterm i j
      _ = 9 * L * G * ∑ k : Fin 3, |d k| := by simp only [Fin.sum_univ_three]; ring
  
  obtain ⟨K₀, hK₀⟩ : ∃ K : ℝ, K = 9 * Lam * Gam + BV / 8 := ⟨_, rfl⟩
  have hkey : ∀ y ∈ Metric.ball y₁ R,
      ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * partialDeriv i (partialDeriv j W) y ≤
        K₀ * (W y + ∑ i : Fin 3, |partialDeriv i W y|) := by
    intro y hy
    have hyK : y ∈ Metric.closedBall y₁ R := hΩK hy
    have hys : y ∈ ψ.source := hball1 hyK
    have e1 : ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j * partialDeriv i (partialDeriv j W) y =
        ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          partialDeriv i (partialDeriv j (fun z => w (ψ z))) y :=
      Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by rw [hW2 y hy i j]
    have e2 := hceq y hys
    have hb : ∑ i : Fin 3, ∑ j : Fin 3, (h.coeff ψ y)⁻¹ i j *
          ∑ k : Fin 3, christoffel (h.coeff ψ) k i j y * partialDeriv k (fun z => w (ψ z)) y ≤
        9 * Lam * Gam * ∑ k : Fin 3, |partialDeriv k (fun z => w (ψ z)) y| :=
      hpb _ (fun k i j => christoffel (h.coeff ψ) k i j y)
        (fun k => partialDeriv k (fun z => w (ψ z)) y)
        Lam Gam hLam0 hGam (hLamB y hyK) (fun k i j => (hCB y hyK).2.2.2 k i j)
    have hS : ∑ k : Fin 3, |partialDeriv k W y| =
        ∑ k : Fin 3, |partialDeriv k (fun z => w (ψ z)) y| :=
      Finset.sum_congr rfl fun k _ => by rw [hW1 y hy k]
    have hWy' : W y = w (ψ y) := hWv y hy
    have hVW : V (ψ y) * w (ψ y) ≤ BV * w (ψ y) :=
      (mul_le_mul_of_nonneg_right (le_abs_self _) (hnn _)).trans
        (mul_le_mul_of_nonneg_right (hBVB y hyK) (hnn _))
    have hS0 : 0 ≤ ∑ k : Fin 3, |partialDeriv k (fun z => w (ψ z)) y| :=
      Finset.sum_nonneg fun k _ => abs_nonneg _
    have p1 : 0 ≤ 9 * Lam * Gam * w (ψ y) :=
      mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hLam0) hGam) (hnn _)
    have p2 : 0 ≤ BV / 8 * ∑ k : Fin 3, |partialDeriv k (fun z => w (ψ z)) y| :=
      mul_nonneg (div_nonneg hBV0 (by norm_num)) hS0
    have hexp : K₀ * (W y + ∑ k : Fin 3, |partialDeriv k W y|) =
        (9 * Lam * Gam * ∑ k : Fin 3, |partialDeriv k W y| + BV * W y / 8) +
        (9 * Lam * Gam * W y + BV / 8 * ∑ k : Fin 3, |partialDeriv k W y|) := by
      rw [hK₀]; ring
    rw [e1, e2, hexp, hS, hWy']
    linarith
  have h0 : W y₁ = 0 := by rw [hWv y₁ (Metric.mem_ball_self hR), hψy₁, hp₁]
  have hWz : ∀ y ∈ Metric.ball y₁ R, W y = 0 := by
    refine hopf_strong_min_principle (Metric.ball y₁ R) Metric.isOpen_ball
      (convex_ball y₁ R).isPreconnected W hWc (fun y _ => hW0 y) ?_ y₁
      (Metric.mem_ball_self hR) h0
    intro y' hy' _
    refine ⟨fun y => (h.coeff ψ y)⁻¹, R - dist y' y₁, 1 / max C₁ 1, Lam, K₀, ?_, ?_, ?_⟩
    · have := Metric.mem_ball.1 hy'
      linarith
    · exact one_div_pos.2 hB
    · intro y hy
      have hyΩ : y ∈ Metric.ball y₁ R := by
        rw [Metric.mem_ball] at hy ⊢
        have := dist_triangle y y' y₁
        linarith
      exact ⟨hyΩ, hell y (hΩK hyΩ), hLamB y (hΩK hyΩ), hkey y hyΩ⟩
  
  have himgo : IsOpen (ψ '' Metric.ball y₁ R) :=
    ψ.toOpenPartialHomeomorph.isOpen_image_of_subset_source Metric.isOpen_ball hΩs
  refine ⟨ψ '' Metric.ball y₁ R, himgo.mem_nhds ⟨y₁, Metric.mem_ball_self hR, hψy₁⟩, ?_⟩
  rintro p ⟨y, hy, rfl⟩
  rw [← hWv y hy]
  exact hWz y hy

theorem cls_positivity [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (k : Fin hAF.numEnds)
    (S : Set M) (hS : IsCompact S) :
    ∃ ε₁ : ℝ, 0 < ε₁ ∧
      ∀ h : RiemannianMetric3 M, (∀ p : M, p ∉ S → h.g p = g.g p) →
        (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) →
        ∀ V v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v →
          (∀ p : M, p ∉ S → V p = 0) → (∀ p : M, |V p| ≤ ε₁) →
          (∀ p : M, -8 * h.lapM v p + V p * v p = -V p) →
          (∀ (j : Fin hAF.numEnds) (ε : ℝ), 0 < ε → ∃ R : ℝ, ∀ x : E3, R < ‖x‖ →
            |v ((hAF.ends j).Φ x)| ≤ ε) →
          ∀ p : M, 0 < 1 + v p :=
by
  obtain ⟨ρA, n, κ, χ, hA⟩ := cls_atlas_exists g hAF
  obtain ⟨CS, hCS, hP⟩ := cls_poincare_compact g hAF k ρA κ χ hA S hS
  obtain ⟨ε₀, cS, hε₀, hcS, hcoerAll⟩ := cls_coercive g hAF ρA κ χ hA S hS CS hCS hP
  refine ⟨ε₀, hε₀, ?_⟩
  intro h _hhS hgh V v hV hv hVS hVb heq hdec
  
  obtain ⟨w, hwdef⟩ : ∃ w : M → ℝ, w = fun q => 1 + v q := ⟨_, rfl⟩
  have hw : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w := by
    rw [hwdef]; exact contMDiff_const.add hv
  have hwp : ∀ q, w q = 1 + v q := fun q => by rw [hwdef]
  have hpd : ∀ (f : E3 → ℝ) (j : Fin 3),
      partialDeriv j (fun y => 1 + f y) = partialDeriv j f := by
    intro f j; funext y; simp only [partialDeriv, fderiv_const_add]
  have heqw : ∀ p, -8 * h.lapM w p + V p * w p = 0 := by
    intro p
    have hl : h.lapM w p = h.lapM v p := by
      rw [hwdef]; simp only [RiemannianMetric3.lapM, lapLoc, hessLoc, hpd]
    rw [hl, hwp p]
    have := heq p
    linarith
  
  have hR : ∀ j : Fin hAF.numEnds, ∃ R : ℝ, ∀ x : E3, R < ‖x‖ →
      |v ((hAF.ends j).Φ x)| ≤ 1 / 2 := fun j => hdec j (1 / 2) (by norm_num)
  choose R hR using hR
  obtain ⟨A, hAdef⟩ : ∃ A : Fin hAF.numEnds → Set E3,
      A = fun j => Metric.closedBall (0 : E3) (max (R j) 2) ∩ {x : E3 | 2 ≤ ‖x‖} := ⟨_, rfl⟩
  have hAc : ∀ j, IsCompact (A j) := by
    intro j; rw [hAdef]
    exact (isCompact_closedBall _ _).inter_right (isClosed_le continuous_const continuous_norm)
  have hAs : ∀ j, A j ⊆ (hAF.ends j).Φ.source := by
    intro j x hx
    rw [hAdef] at hx
    rw [(hAF.ends j).source_eq]
    show (1 : ℝ) < ‖x‖
    have : (2 : ℝ) ≤ ‖x‖ := hx.2
    linarith
  obtain ⟨K, hKdef⟩ : ∃ K : Set M,
      K = (⋃ j, (hAF.ends j).Φ '' {x : E3 | 2 < ‖x‖})ᶜ ∪ ⋃ j, (hAF.ends j).Φ '' A j :=
    ⟨_, rfl⟩
  have hK : IsCompact K := by
    rw [hKdef]
    refine hAF.isCompact_core.union (isCompact_iUnion fun j => ?_)
    exact (hAc j).image_of_continuousOn
      ((hAF.ends j).Φ.contMDiffOn_toFun.continuousOn.mono (hAs j))
  have hKv : ∀ p, p ∉ K → |v p| ≤ 1 / 2 := by
    intro p hp
    rw [hKdef, Set.mem_union, not_or, Set.mem_compl_iff, not_not] at hp
    obtain ⟨h1, h2⟩ := hp
    obtain ⟨j, hj⟩ := Set.mem_iUnion.1 h1
    obtain ⟨x, hx, rfl⟩ := hj
    have hxA : x ∉ A j := by
      intro hxA
      exact h2 (Set.mem_iUnion.2 ⟨j, x, hxA, rfl⟩)
    have hx2 : (2 : ℝ) < ‖x‖ := hx
    have hxR : R j < ‖x‖ := by
      by_contra hcon
      push_neg at hcon
      apply hxA
      rw [hAdef]
      refine ⟨?_, hx2.le⟩
      rw [mem_closedBall_zero_iff]
      exact hcon.trans (le_max_left _ _)
    exact hR j x hxR
  have hKw : ∀ p, p ∉ K → 0 < w p := by
    intro p hp
    have h1 := hKv p hp
    rw [hwp p]
    have h2 := (abs_le.1 h1).1
    linarith
  
  have hnn : ∀ p, 0 ≤ w p :=
    clsp_weak_min g h hAF k ρA κ χ hA S ε₀ cS hε₀ hcS (hcoerAll h hgh) V w hV hw hVS hVb heqw
      K hK hKw
  
  have hZc : IsClosed {q : M | w q = 0} := isClosed_eq hw.continuous continuous_const
  have hZo : IsOpen {q : M | w q = 0} := by
    rw [isOpen_iff_mem_nhds]
    intro q hq
    obtain ⟨N, hN, hN0⟩ := clsp_local_zero_open g hAF ρA κ χ hA h V w hV hw heqw hnn q hq
    exact Filter.mem_of_superset hN fun p hp => hN0 p hp
  obtain ⟨R0, hR0⟩ := hdec k (1 / 2) (by norm_num)
  have hfar : w ((hAF.ends k).Φ ((max R0 1 + 1) • e 0)) ≠ 0 := by
    have hpos : (0 : ℝ) < max R0 1 + 1 := by
      have := le_max_right R0 1
      linarith
    have hnorm : ‖(max R0 1 + 1) • e 0‖ = max R0 1 + 1 := by
      rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
        abs_of_pos hpos]
    have hlt : R0 < ‖(max R0 1 + 1) • e 0‖ := by
      rw [hnorm]
      have := le_max_left R0 1
      linarith
    have h1 := hR0 _ hlt
    rw [hwp]
    have h2 := (abs_le.1 h1).1
    intro h0
    linarith
  intro p
  rcases (isClopen_iff.1 ⟨hZc, hZo⟩) with hempty | huniv
  · have hne : w p ≠ 0 := by
      intro h0
      have : p ∈ {q : M | w q = 0} := h0
      rw [hempty] at this
      exact this
    have := lt_of_le_of_ne (hnn p) (Ne.symm hne)
    rw [hwp p] at this
    exact this
  · exfalso
    apply hfar
    have : (hAF.ends k).Φ ((max R0 1 + 1) • e 0) ∈ {q : M | w q = 0} := by
      rw [huniv]; exact Set.mem_univ _
    exact this

theorem cls_far_harmonic [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g h : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (S : Set M) (hS : IsCompact S)
    (hh : ∀ p : M, p ∉ S → h.g p = g.g p) (V f v : M → ℝ)
    (hv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v)
    (hVf : ∀ p : M, p ∉ S → V p = 0 ∧ f p = 0)
    (heq : ∀ p : M, -8 * h.lapM v p + V p * v p = f p) (j : Fin hAF.numEnds) :
    ∃ R : ℝ, 1 ≤ R ∧ ∀ x : E3, R < ‖x‖ →
      lapLoc (g.coeff (hAF.ends j).Φ) (fun y => v ((hAF.ends j).Φ y)) x = 0 :=
by
  classical
  
  have hlapcongr : ∀ (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (y : E3),
      G₁ =ᶠ[𝓝 y] G₂ → lapLoc G₁ u y = lapLoc G₂ u y := by
    intro G₁ G₂ u y hG
    have h0 : G₁ y = G₂ y := hG.eq_of_nhds
    have hd : ∀ (l a b : Fin 3),
        partialDeriv l (fun z => G₁ z a b) y = partialDeriv l (fun z => G₂ z a b) y := by
      intro l a b
      unfold partialDeriv
      have hab : (fun z => G₁ z a b) =ᶠ[𝓝 y] (fun z => G₂ z a b) :=
        hG.mono fun z hz => by
          show G₁ z a b = G₂ z a b
          rw [hz]
      rw [hab.fderiv_eq]
    have hc : ∀ k a b : Fin 3, christoffel G₁ k a b y = christoffel G₂ k a b y := by
      intro k a b
      simp only [christoffel, h0, hd]
    simp only [lapLoc, hessLoc, h0, hc]
  
  have hesc := end_chart_escape g hAF j
  choose ρ N hN hρ using hesc
  obtain ⟨t, -, hcover⟩ := hS.elim_nhds_subcover N (fun p _ => hN p)
  have hsum : 0 ≤ ∑ p ∈ t, |ρ p| := Finset.sum_nonneg fun p _ => abs_nonneg _
  refine ⟨1 + ∑ p ∈ t, |ρ p|, by linarith, ?_⟩
  intro x hx
  have hfar : (hAF.ends j).Φ x ∉ S := by
    intro hxS
    obtain ⟨q, hq, hxq⟩ := Set.mem_iUnion₂.1 (hcover hxS)
    have h1 : ρ q ≤ ∑ p ∈ t, |ρ p| :=
      (le_abs_self _).trans
        (Finset.single_le_sum (f := fun p => |ρ p|) (fun p _ => abs_nonneg _) hq)
    exact hρ q x (by linarith) hxq
  have hx1 : x ∈ (hAF.ends j).Φ.source := by
    rw [(hAF.ends j).source_eq]
    show (1 : ℝ) < ‖x‖
    linarith
  set p := (hAF.ends j).Φ x with hpdef
  
  have hzero : h.lapM v p = 0 := by
    obtain ⟨hV0, hf0⟩ := hVf p hfar
    have := heq p
    rw [hV0, hf0] at this
    linarith
  
  have hSc : IsClosed S := hS.isClosed
  have hcont : ContinuousAt (chartAt E3 p).symm (chartAt E3 p p) :=
    (chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)
  have hmem : (chartAt E3 p).symm ⁻¹' Sᶜ ∈ 𝓝 (chartAt E3 p p) := by
    apply hcont.preimage_mem_nhds
    rw [(chartAt E3 p).left_inv (mem_chart_source E3 p)]
    exact hSc.isOpen_compl.mem_nhds hfar
  have hG : h.coeff (chartAt E3 p).symm =ᶠ[𝓝 (chartAt E3 p p)] g.coeff (chartAt E3 p).symm := by
    filter_upwards [hmem] with y hy
    show coeffMatrix h.g (chartAt E3 p).symm y = coeffMatrix g.g (chartAt E3 p).symm y
    unfold coeffMatrix
    rw [hh _ hy]
  have hhg : h.lapM v p = g.lapM v p := by
    unfold RiemannianMetric3.lapM
    exact hlapcongr _ _ _ _ hG
  
  have hinv := lapLocal_chart_invariant g (hAF.ends j).Φ v Set.univ isOpen_univ
    hv.contMDiffOn x hx1 (Set.mem_univ _)
  have e1 : lapLoc (g.coeff (hAF.ends j).Φ) (fun y => v ((hAF.ends j).Φ y)) x
      = lapM g v p := hinv
  have e2 : lapM g v p = g.lapM v p := rfl
  rw [e1, e2, ← hhg, hzero]

theorem cls_energy_solve [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (k : Fin hAF.numEnds)
    (S : Set M) (hS : IsCompact S) (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) :
    ∃ ε₀ C : ℝ, 0 < ε₀ ∧ 0 ≤ C ∧
      ∀ h : RiemannianMetric3 M, (∀ p : M, p ∉ S → h.g p = g.g p) →
        (∀ (p : M) (ξ : E3), (1 / 2 : ℝ) * g.g p ξ ξ ≤ h.g p ξ ξ ∧ h.g p ξ ξ ≤ 2 * g.g p ξ ξ) →
        ∀ V f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ V → ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f →
          (∀ p : M, p ∉ S → V p = 0 ∧ f p = 0) → (∀ p : M, |V p| ≤ ε₀) →
          ∃ v : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v ∧
            (∀ p : M, -8 * h.lapM v p + V p * v p = f p) ∧
            (∀ (j : Fin hAF.numEnds) (ε : ℝ), 0 < ε → ∃ R : ℝ, ∀ x : E3, R < ‖x‖ →
              |v ((hAF.ends j).Φ x)| ≤ ε) ∧
            (∀ B : ℝ, (∀ p : M, |f p| ≤ B) →
              ∫ y in K, (|v (φ y)| + ‖fderiv ℝ (fun z => v (φ z)) y‖) ≤ C * B) ∧
            ((∀ p : M, f p = -V p) → ∀ p : M, 0 < 1 + v p) :=
by
  obtain ⟨ε₂, Λ, ρ, hε₂, hΛ, hρ, hA⟩ := cls_approx_solutions g hComplete hAF k S hS φ K hK hKφ
  obtain ⟨C₃, hC₃, hCB⟩ := cls_limit_chart_bound φ K hK hKφ
  obtain ⟨ε₁, hε₁, hP⟩ := cls_positivity g hAF k S hS
  refine ⟨min ε₂ ε₁, C₃ * Real.sqrt Λ, lt_min hε₂ hε₁, mul_nonneg hC₃ (Real.sqrt_nonneg _), ?_⟩
  intro h hh hequiv V f hV hf hVf hVb
  obtain ⟨u, hu, hC, hEL, hKb, hHb⟩ :=
    hA h hh hequiv V f hV hf hVf (fun p => (hVb p).trans (min_le_left _ _))
  obtain ⟨v, hv, heq, hconv⟩ :=
    cls_weak_limit_regular h V f hV hf u (fun n => (hu n).1) hC hEL
  obtain ⟨B₀, hB₀⟩ : ∃ B₀ : ℝ, ∀ p : M, |f p| ≤ B₀ := by
    obtain ⟨C, hC'⟩ := hS.exists_bound_of_continuousOn hf.continuous.continuousOn
    refine ⟨max C 0, fun p => ?_⟩
    by_cases hp : p ∈ S
    · have h1 := hC' p hp
      rw [Real.norm_eq_abs] at h1
      exact h1.trans (le_max_left _ _)
    · rw [(hVf p hp).2, abs_zero]
      exact le_max_right _ _
  have hdec : ∀ (j : Fin hAF.numEnds) (ε : ℝ), 0 < ε → ∃ R : ℝ, ∀ x : E3, R < ‖x‖ →
      |v ((hAF.ends j).Φ x)| ≤ ε := by
    intro j
    obtain ⟨R₀, hR₀, hlap⟩ := cls_far_harmonic g h hAF S hS hh V f v hv hVf heq j
    exact cls_limit_decay g hAF j (ρ j) (hρ j) (Λ * B₀ ^ 2) u v hv (fun n => (hu n).1)
      (fun n R => hHb B₀ hB₀ j n R) (fun L hL hLs => hconv (hAF.ends j).Φ L hL hLs) R₀ hR₀ hlap
  refine ⟨v, hv, heq, hdec, ?_, ?_⟩
  · intro B hB
    have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB (Classical.arbitrary M))
    have h1 := hCB u v (Λ * B ^ 2) hv (fun n => (hu n).1) (hKb B hB) (hconv φ K hK hKφ)
    rw [Real.sqrt_mul hΛ, Real.sqrt_sq hB0] at h1
    calc ∫ y in K, (|v (φ y)| + ‖fderiv ℝ (fun z => v (φ z)) y‖)
        ≤ C₃ * (Real.sqrt Λ * B) := h1
      _ = C₃ * Real.sqrt Λ * B := by ring
  · intro hfV p
    exact hP h hh hequiv V v hV hv (fun p hp => (hVf p hp).1)
      (fun p => (hVb p).trans (min_le_right _ _))
      (fun p => by rw [← hfV p]; exact heq p) hdec p

theorem cfd_barrier (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q p : ℝ) (hq : 0 < q)
    (hp0 : 0 < p) (hp1 : p < 1) (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2)) :
    ∃ R₁ : ℝ, R ≤ R₁ ∧ ∀ y : E3, R₁ < ‖y‖ →
      lapLoc G (fun z : E3 => (1 + ‖z‖ ^ 2) ^ (-p / 2)) y < 0 :=
by
  
  
  have hrad : ∃ K : ℝ, 0 ≤ K ∧ ∀ (P : ℝ → ℝ), ContDiff ℝ ∞ P → ∀ y : E3, R < ‖y‖ →
      lapLoc G (fun z => P ‖z‖) y ≤
        (deriv (deriv P) ‖y‖ + 2 * deriv P ‖y‖ / ‖y‖) +
          K * ‖y‖ ^ (-q) * (|deriv (deriv P) ‖y‖| + |deriv P ‖y‖| / ‖y‖) := by
    have hpert : ∃ K₂ : ℝ, 0 ≤ K₂ ∧ ∀ (w : E3 → ℝ) (x : E3), R < ‖x‖ →
        |lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x| ≤
          K₂ * (‖x‖ ^ (-q) * ∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x|
            + ‖x‖ ^ (-q - 1) * ∑ k : Fin 3, |partialDeriv k w x|) := by
      obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 1 + C := ⟨_, rfl⟩
      obtain ⟨b, hbdef⟩ : ∃ b : ℝ, b = 4 * B ^ 2 := ⟨_, rfl⟩
      have hB1 : 1 ≤ B := by rw [hBdef]; linarith
      have hB0 : 0 ≤ B := by linarith
      have hb0 : 0 ≤ b := by rw [hbdef]; positivity
      have hK0 : 0 ≤ 3 * b * C + 81 / 2 * b ^ 2 * C := by
        have h1 : 0 ≤ 3 * b * C := by positivity
        have h2 : 0 ≤ 81 / 2 * b ^ 2 * C := by positivity
        linarith
      refine ⟨3 * b * C + 81 / 2 * b ^ 2 * C, hK0, ?_⟩
      intro w x hx
      have hr1 : 1 < ‖x‖ := lt_of_le_of_lt hR hx
      have hr0 : 0 < ‖x‖ := by linarith
      obtain ⟨hdet, hbx⟩ := hb x hx
      obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = ‖x‖ ^ (-q) := ⟨_, rfl⟩
      obtain ⟨u, hu⟩ : ∃ u : ℝ, u = ‖x‖ ^ (-q - 1) := ⟨_, rfl⟩
      have hρ0 : 0 ≤ ρ := by rw [hρ]; exact Real.rpow_nonneg hr0.le _
      have hu0 : 0 ≤ u := by rw [hu]; exact Real.rpow_nonneg hr0.le _
      have hρ1 : ρ ≤ 1 := by
        rw [hρ]; exact Real.rpow_le_one_of_one_le_of_nonpos hr1.le (by linarith)
      rw [← hρ, ← hu]
      have hPD : ∀ (c : Fin 3) (f : E3 → ℝ), |partialDeriv c f x| ≤ ‖fderiv ℝ f x‖ := by
        intro c f
        have hn : ‖e c‖ = 1 := by simp [e]
        calc |partialDeriv c f x| = ‖fderiv ℝ f x (e c)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ f x‖ * ‖e c‖ := (fderiv ℝ f x).le_opNorm _
          _ = ‖fderiv ℝ f x‖ := by rw [hn, mul_one]
      have hd1 : ∀ c a b' : Fin 3, |partialDeriv c (fun z => G z a b') x| ≤ C * u := by
        intro c a b'
        rw [hu]; exact (hPD c _).trans (hbx a b' 0).2.1
      have hGε : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ρ := by
        intro i j; rw [hρ]; exact (hbx i j 0).1
      have hGB : ∀ i j : Fin 3, |G x i j| ≤ B := by
        intro i j
        have h1 := hGε i j
        have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
        have h3 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
        have h4 : C * ρ ≤ C := by nlinarith
        rw [hBdef]; linarith
      have hdetpos : 0 < (G x).det := by linarith
      have hm : ∀ a1 a2 a3 a4 : ℝ, |a1| ≤ B → |a2| ≤ B → |a3| ≤ B → |a4| ≤ B →
