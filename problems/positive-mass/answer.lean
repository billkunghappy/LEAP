          (Ψ x • fderiv ℝ G x + G x • fderiv ℝ Ψ x) x :=
        hΨd.hasFDerivAt.mul hGd.hasFDerivAt
      unfold pd2
      rw [(hin x hx').fderiv_eq, hmul.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    · intro x hx i
      unfold pd2
      rw [(hout x (by linarith)).fderiv_eq]
      simp
  
  have pd2_compact_integral : ∀ (r : ℝ) (F : E2 → ℝ) (i : Fin 2) (hF : ContDiff ℝ 1 F) (hFr : ∀ x : E2, r ≤ ‖x‖ → F x = 0), MeasureTheory.Integrable (fun x => pd2 i F x) ∧ ∫ x, pd2 i F x = 0 := by
