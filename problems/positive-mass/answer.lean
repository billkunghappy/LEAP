      ((hφ i).mono Set.inter_subset_left) (hcrNormalField G (φ i))
      (fun z _ a => by simp [hcrNormalField])
    exact ⟨hsm.mono fun z hz => ⟨hz, hposT z hz⟩, fun z hz w hw => hcs z hz (hposT z hz) w hw⟩
  have hNat : ∀ i : Fin r, ∀ z ∈ V i ∩ U,
      ContDiffAt ℝ ∞ (fun y => -(hcrNormalField G (φ i) y)) z := fun i z hz =>
    ((hNfacts i).1.contDiffAt (((hV i).inter hU).mem_nhds hz)).neg
  have hRP : ∀ i : Fin r, ∃ R P : ℝ, 0 ≤ R ∧ 0 ≤ P ∧
