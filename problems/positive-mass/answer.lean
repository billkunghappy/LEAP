  apply hshift j φ j
  rw [htail]
  exact hsub j _ σ hσm (hB j)

theorem jet2_partition_glue [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] [SigmaCompactSpace M]
    (E : Set M) (hE : IsClosed E) (u : ℕ → M → ℝ)
