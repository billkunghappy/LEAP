        pd2 k f x = f' (e2 k) := by
      intro f f' k hf
      unfold pd2
      rw [hf.fderiv]
    have hpd : ∀ i : Fin 2,
        pd2 i (fun y => Real.sqrt (h y).det * ∑ j : Fin 2, (h y)⁻¹ i j * pd2 j φ y) x
          = (Real.sqrt (h x).det * (h x)⁻¹ i 0) * pd2 i (pd2 0 φ) x
            + pd2 0 φ x * pd2 i (fun y => Real.sqrt (h y).det * (h y)⁻¹ i 0) x
            + ((Real.sqrt (h x).det * (h x)⁻¹ i 1) * pd2 i (pd2 1 φ) x
            + pd2 1 φ x * pd2 i (fun y => Real.sqrt (h y).det * (h y)⁻¹ i 1) x) := by
      intro i
      have hfun : (fun y => Real.sqrt (h y).det * ∑ j : Fin 2, (h y)⁻¹ i j * pd2 j φ y)
