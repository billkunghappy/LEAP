          have h1 := step _ _ _ h0 (n1 _ hM₁) (bX a)
          have h2 := step _ _ _ h1 (n1 _ (n1 _ hM₁)) (bY b)
          have h3 := step _ _ _ h2 (n1 _ (n1 _ (n1 _ hM₁))) (bZ c)
          exact step _ _ _ h3 (n1 _ (n1 _ (n1 _ (n1 _ hM₁)))) (bW m)
      _ = 243 * M₁ * κ ^ 5 := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          push_cast
          ring

theorem gsr_frame_estimate (Gm : Matrix (Fin 3) (Fin 3) ℝ) (Fv : Fin 2 → Fin 3 → ℝ) (ν : Fin 3 → ℝ) (L hi : Matrix (Fin 2) (Fin 2) ℝ) (R : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (DR : Fin 3 → Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (II : Fin 2 → Fin 2 → ℝ) (A₀ A₁ : ℝ) (hA₀ : 0 ≤ A₀) (hA₁ : 0 ≤ A₁) (hhi : ∀ i j : Fin 2, hi i j = ∑ t : Fin 2, L i t * L j t) (hunit : ∀ c : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, (∑ i : Fin 2, L i c * Fv i a) * Gm a b * (∑ i : Fin 2, L i c * Fv i b) ≤ 1) (hνν : ∑ a : Fin 3, ∑ b : Fin 3, ν a * Gm a b * ν b ≤ 1) (hR : ∀ X Y Z W : Fin 3 → ℝ, ∑ a : Fin 3, ∑ b : Fin 3, X a * Gm a b * X b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Y a * Gm a b * Y b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Z a * Gm a b * Z b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, W a * Gm a b * W b ≤ 1 → |gsrF4 R X Y Z W| ≤ A₀) (hDR : ∀ V X Y Z W : Fin 3 → ℝ, ∑ a : Fin 3, ∑ b : Fin 3, V a * Gm a b * V b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, X a * Gm a b * X b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Y a * Gm a b * Y b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, Z a * Gm a b * Z b ≤ 1 → ∑ a : Fin 3, ∑ b : Fin 3, W a * Gm a b * W b ≤ 1 → |gsrF5 DR V X Y Z W| ≤ A₁) : |∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, hi i a * hi j b * II i j * gsrE R DR Fv ν hi II a b| ≤ 16 * A₁ * Real.sqrt (∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, hi i a * hi j b * II i j * II a b) + 80 * A₀ * ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, hi i a * hi j b * II i j * II a b :=
by
  
  have s3 : ∀ p q r s : Fin 2, ∑ l : Fin 2, ∑ k : Fin 2, ∑ i : Fin 2, ∑ j : Fin 2, L l p * L k q * L i r * L j s * gsrDT R DR Fv ν hi II l k i j = gsrDT R DR (fun c a => ∑ i : Fin 2, L i c * Fv i a) ν (1 : Matrix (Fin 2) (Fin 2) ℝ) (fun t u => ∑ i : Fin 2, ∑ j : Fin 2, L i t * L j u * II i j) p q r s := by
    have h41 : ∀ (c : Fin 2) (Y Z W : Fin 3 → ℝ), gsrF4 R (fun a => ∑ i : Fin 2, L i c * Fv i a) Y Z W = ∑ i : Fin 2, L i c * gsrF4 R (Fv i) Y Z W := by
      intro c Y Z W
      simp only [gsrF4, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h42 : ∀ (c : Fin 2) (X Z W : Fin 3 → ℝ), gsrF4 R X (fun a => ∑ i : Fin 2, L i c * Fv i a) Z W = ∑ i : Fin 2, L i c * gsrF4 R X (Fv i) Z W := by
      intro c X Z W
      simp only [gsrF4, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h43 : ∀ (c : Fin 2) (X Y W : Fin 3 → ℝ), gsrF4 R X Y (fun a => ∑ i : Fin 2, L i c * Fv i a) W = ∑ i : Fin 2, L i c * gsrF4 R X Y (Fv i) W := by
      intro c X Y W
      simp only [gsrF4, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h44 : ∀ (c : Fin 2) (X Y Z : Fin 3 → ℝ), gsrF4 R X Y Z (fun a => ∑ i : Fin 2, L i c * Fv i a) = ∑ i : Fin 2, L i c * gsrF4 R X Y Z (Fv i) := by
      intro c X Y Z
      simp only [gsrF4, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h51 : ∀ (c : Fin 2) (X Y Z W : Fin 3 → ℝ), gsrF5 DR (fun a => ∑ i : Fin 2, L i c * Fv i a) X Y Z W = ∑ i : Fin 2, L i c * gsrF5 DR (Fv i) X Y Z W := by
      intro c X Y Z W
      simp only [gsrF5, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h52 : ∀ (c : Fin 2) (V Y Z W : Fin 3 → ℝ), gsrF5 DR V (fun a => ∑ i : Fin 2, L i c * Fv i a) Y Z W = ∑ i : Fin 2, L i c * gsrF5 DR V (Fv i) Y Z W := by
      intro c V Y Z W
      simp only [gsrF5, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h53 : ∀ (c : Fin 2) (V X Z W : Fin 3 → ℝ), gsrF5 DR V X (fun a => ∑ i : Fin 2, L i c * Fv i a) Z W = ∑ i : Fin 2, L i c * gsrF5 DR V X (Fv i) Z W := by
      intro c V X Z W
      simp only [gsrF5, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    have h54 : ∀ (c : Fin 2) (V X Y W : Fin 3 → ℝ), gsrF5 DR V X Y (fun a => ∑ i : Fin 2, L i c * Fv i a) W = ∑ i : Fin 2, L i c * gsrF5 DR V X Y (Fv i) W := by
      intro c V X Y W
      simp only [gsrF5, Fin.sum_univ_two, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => ?_
      ring
    intro p q r s
    simp only [gsrDT]
    simp only [h41, h42, h43, h44, h51, h52, h53, h54]
    simp only [Fin.sum_univ_two, hhi, Matrix.one_apply_eq, Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide),
      Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)]
    ring
  
  have s5 : ∀ P : Fin 2 → Fin 2 → ℝ, ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, hi i a * hi j b * II i j * P a b = ∑ t : Fin 2, ∑ u : Fin 2, (∑ i : Fin 2, ∑ j : Fin 2, L i t * L j u * II i j) * (∑ a : Fin 2, ∑ b : Fin 2, L a t * L b u * P a b) := by
    intro P
    simp only [hhi, Fin.sum_univ_two]
    ring
  
  have s4 : ∀ DT DT' : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ, (∀ p q r s : Fin 2, ∑ l : Fin 2, ∑ k : Fin 2, ∑ i : Fin 2, ∑ j : Fin 2, L l p * L k q * L i r * L j s * DT l k i j = DT' p q r s) → ∀ t u : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, L a t * L b u * (∑ k : Fin 2, ∑ l : Fin 2, hi k l * (DT a k b l + DT l k a b)) = ∑ k : Fin 2, ∑ l : Fin 2, (1 : Matrix (Fin 2) (Fin 2) ℝ) k l * (DT' t k u l + DT' l k t u) := by
    intro DT DT' hDT t u
    simp only [← hDT]
    simp only [Fin.sum_univ_two, hhi, Matrix.one_apply_eq, Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide),
      Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)]
    ring
  
  have s6 : ∀ (Ev : Fin 2 → Fin 3 → ℝ) (K : Fin 2 → Fin 2 → ℝ) (σ : ℝ), 0 ≤ σ → (∀ t u : Fin 2, |K t u| ≤ σ) → (∀ c : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, Ev c a * Gm a b * Ev c b ≤ 1) → ∀ t u : Fin 2, |gsrE R DR Ev ν (1 : Matrix (Fin 2) (Fin 2) ℝ) K t u| ≤ 4 * A₁ + 20 * A₀ * σ := by
    intro Ev K σ hσ hK hEv
    have hprod : ∀ x y : Fin 2, ∀ g : ℝ, |g| ≤ A₀ → |K x y * g| ≤ A₀ * σ := by
      intro x y g hg
      rw [abs_mul, mul_comm A₀ σ]
      exact mul_le_mul (hK x y) hg (abs_nonneg _) hσ
    have hD : ∀ p q r s : Fin 2, |gsrDT R DR Ev ν (1 : Matrix (Fin 2) (Fin 2) ℝ) K p q r s| ≤ A₁ + 5 * (A₀ * σ) := by
      intro p q r s
      have hsum : ∑ a : Fin 2, ∑ b : Fin 2, (1 : Matrix (Fin 2) (Fin 2) ℝ) a b * K p b * gsrF4 R (Ev q) (Ev r) (Ev s) (Ev a) = K p 0 * gsrF4 R (Ev q) (Ev r) (Ev s) (Ev 0) + K p 1 * gsrF4 R (Ev q) (Ev r) (Ev s) (Ev 1) := by
        simp only [Fin.sum_univ_two, Matrix.one_apply_eq, Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide),
          Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)]
        ring
      unfold gsrDT
      rw [hsum]
      have f1 := abs_le.mp (hDR _ _ _ _ _ (hEv p) (hEv q) (hEv r) (hEv s) hνν)
      have g1 := abs_le.mp (hprod p q _ (hR _ _ _ _ hνν (hEv r) (hEv s) hνν))
      have g2 := abs_le.mp (hprod p r _ (hR _ _ _ _ (hEv q) hνν (hEv s) hνν))
      have g3 := abs_le.mp (hprod p s _ (hR _ _ _ _ (hEv q) (hEv r) hνν hνν))
      have g4 := abs_le.mp (hprod p 0 _ (hR _ _ _ _ (hEv q) (hEv r) (hEv s) (hEv 0)))
      have g5 := abs_le.mp (hprod p 1 _ (hR _ _ _ _ (hEv q) (hEv r) (hEv s) (hEv 1)))
      rw [abs_le]
      constructor <;> linarith [f1.1, f1.2, g1.1, g1.2, g2.1, g2.2, g3.1, g3.2, g4.1, g4.2, g5.1, g5.2]
    intro t u
    have hE : gsrE R DR Ev ν (1 : Matrix (Fin 2) (Fin 2) ℝ) K t u = (gsrDT R DR Ev ν 1 K t 0 u 0 + gsrDT R DR Ev ν 1 K 0 0 t u) + (gsrDT R DR Ev ν 1 K t 1 u 1 + gsrDT R DR Ev ν 1 K 1 1 t u) := by
      simp only [gsrE, Fin.sum_univ_two, Matrix.one_apply_eq, Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide),
        Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)]
      ring
    rw [hE]
    have d1 := abs_le.mp (hD t 0 u 0)
    have d2 := abs_le.mp (hD 0 0 t u)
    have d3 := abs_le.mp (hD t 1 u 1)
    have d4 := abs_le.mp (hD 1 1 t u)
    rw [abs_le]
    constructor <;> linarith [d1.1, d1.2, d2.1, d2.2, d3.1, d3.2, d4.1, d4.2]
  
  have final : ∀ (K Ef : Fin 2 → Fin 2 → ℝ) (aa Q : ℝ), aa = ∑ t : Fin 2, ∑ u : Fin 2, K t u * K t u → Q = ∑ t : Fin 2, ∑ u : Fin 2, K t u * Ef t u → (∀ σ : ℝ, 0 ≤ σ → (∀ t u : Fin 2, |K t u| ≤ σ) → ∀ t u : Fin 2, |Ef t u| ≤ 4 * A₁ + 20 * A₀ * σ) → |Q| ≤ 16 * A₁ * Real.sqrt aa + 80 * A₀ * aa := by
    intro K Ef aa Q haa hQ hb
    have ha0 : 0 ≤ aa := by
      rw [haa]
      exact Finset.sum_nonneg fun t _ => Finset.sum_nonneg fun u _ => mul_self_nonneg _
    have hKb : ∀ t u : Fin 2, |K t u| ≤ Real.sqrt aa := by
      intro t u
      apply Real.abs_le_sqrt
      have h1 : K t u * K t u ≤ ∑ u' : Fin 2, K t u' * K t u' :=
        Finset.single_le_sum (f := fun u' => K t u' * K t u') (fun i _ => mul_self_nonneg _) (Finset.mem_univ u)
      have h2 : ∑ u' : Fin 2, K t u' * K t u' ≤ ∑ t' : Fin 2, ∑ u' : Fin 2, K t' u' * K t' u' :=
        Finset.single_le_sum (f := fun t' => ∑ u' : Fin 2, K t' u' * K t' u')
          (fun i _ => Finset.sum_nonneg fun j _ => mul_self_nonneg _) (Finset.mem_univ t)
      rw [haa, sq]
      linarith
    have hE := hb (Real.sqrt aa) (Real.sqrt_nonneg _) hKb
    have hterm : ∀ t u : Fin 2, |K t u * Ef t u| ≤ Real.sqrt aa * (4 * A₁ + 20 * A₀ * Real.sqrt aa) := by
      intro t u
      rw [abs_mul]
      exact mul_le_mul (hKb t u) (hE t u) (abs_nonneg _) (Real.sqrt_nonneg _)
    have hs := Real.mul_self_sqrt ha0
    have hid : 4 * (Real.sqrt aa * (4 * A₁ + 20 * A₀ * Real.sqrt aa)) = 16 * A₁ * Real.sqrt aa + 80 * A₀ * (Real.sqrt aa * Real.sqrt aa) := by ring
    rw [hs] at hid
    rw [hQ]
    simp only [Fin.sum_univ_two]
    have e1 := abs_le.mp (hterm 0 0)
    have e2 := abs_le.mp (hterm 0 1)
    have e3 := abs_le.mp (hterm 1 0)
    have e4 := abs_le.mp (hterm 1 1)
    rw [abs_le]
    constructor <;> linarith [e1.1, e1.2, e2.1, e2.2, e3.1, e3.2, e4.1, e4.2]
  
  have hEt : ∀ t u : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2, L a t * L b u * gsrE R DR Fv ν hi II a b = gsrE R DR (fun c a => ∑ i : Fin 2, L i c * Fv i a) ν (1 : Matrix (Fin 2) (Fin 2) ℝ) (fun t u => ∑ i : Fin 2, ∑ j : Fin 2, L i t * L j u * II i j) t u := by
    intro t u
    simp only [gsrE]
    exact s4 _ _ s3 t u
  have hQ := s5 (fun a b => gsrE R DR Fv ν hi II a b)
  simp only [hEt] at hQ
  refine final (fun t u => ∑ i : Fin 2, ∑ j : Fin 2, L i t * L j u * II i j)
    (gsrE R DR (fun c a => ∑ i : Fin 2, L i c * Fv i a) ν (1 : Matrix (Fin 2) (Fin 2) ℝ) (fun t u => ∑ i : Fin 2, ∑ j : Fin 2, L i t * L j u * II i j))
    _ _ (s5 II) hQ ?_
  intro σ hσ hK
  exact s6 _ _ σ hσ hK hunit

theorem gsr_simonsE_contract (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (s : Set E2) (hs : IsOpen s) (hh : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => h x i j) s) (hhsymm : ∀ x ∈ s, ∀ i j : Fin 2, h x i j = h x j i) (hhpos : ∀ x ∈ s, (h x).PosDef) (C : Fin 2 → Fin 2 → Fin 2 → E2 → ℝ) (x : E2) (hx : x ∈ s) (hC : ∀ k i j : Fin 2, DifferentiableAt ℝ (C k i j) x) : ∀ i j : Fin 2, gsSimonsE h C i j x = ∑ k : Fin 2, ∑ l : Fin 2, (h x)⁻¹ k l * (gsCovD3 h C i k j l x + gsCovD3 h C l k i j x) :=
by
  intro i j
  have hdetpos : 0 < (h x).det := (hhpos x hx).det_pos
  have hu : IsUnit (h x).det := isUnit_iff_ne_zero.mpr hdetpos.ne'
  have hmul : h x * (h x)⁻¹ = 1 := Matrix.mul_nonsing_inv _ hu
  have hsx : h x 1 0 = h x 0 1 := hhsymm x hx 1 0
  
  have dA : ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x := fun a b =>
    ((hh a b).contDiffAt (hs.mem_nhds hx)).differentiableAt (by simp)
  
  have hcf : ∀ (z : E2) (k l : Fin 2), (h z)⁻¹ k l = ((h z).det)⁻¹ * (h z).adjugate k l := by
    intro z k l
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    simp only [Matrix.smul_apply, smul_eq_mul]
  have hadj : ∀ z : E2, (h z).adjugate = !![h z 1 1, -h z 0 1; -h z 1 0, h z 0 0] :=
    fun z => Matrix.adjugate_fin_two _
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z
    exact Matrix.det_fin_two _
  have dDet : DifferentiableAt ℝ (fun z => ((h z).det)⁻¹) x := by
    have h1 : DifferentiableAt ℝ (fun z => (h z).det) x := by
      rw [hdetfun]
      exact ((dA 0 0).mul (dA 1 1)).sub ((dA 0 1).mul (dA 1 0))
    exact h1.inv hdetpos.ne'
  have dAdj : ∀ k l : Fin 2, DifferentiableAt ℝ (fun z => (h z).adjugate k l) x := by
    intro k l
    simp only [hadj]
    fin_cases k <;> fin_cases l
    · exact dA 1 1
    · exact (dA 0 1).neg
    · exact (dA 1 0).neg
    · exact dA 0 0
  have dInv : ∀ k l : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ k l) x := by
    intro k l
    have e1 : (fun z => (h z)⁻¹ k l) = fun z => ((h z).det)⁻¹ * (h z).adjugate k l :=
      funext fun z => hcf z k l
    rw [e1]
    exact dDet.mul (dAdj k l)
  
  have hisym : ∀ a b : Fin 2, (h x)⁻¹ a b = (h x)⁻¹ b a := by
    intro a b
    rw [hcf x a b, hcf x b a, hadj x]
    fin_cases a <;> fin_cases b <;> simp [hsx]
  have hsymd : ∀ d : Fin 2, pd2 d (fun z => h z 1 0) x = pd2 d (fun z => h z 0 1) x := by
    have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
      Filter.eventually_of_mem (hs.mem_nhds hx) (fun z hz => hhsymm z hz 1 0)
    intro d
    simp only [pd2]
    rw [hev.fderiv_eq]
  
  have pdmul : ∀ f g : E2 → ℝ, DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 i (fun z => f z * g z) x = pd2 i f x * g x + f x * pd2 i g x := by
    intro f g hf hg
    simp only [pd2]
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pdadd : ∀ f g : E2 → ℝ, DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 i (fun z => f z + g z) x = pd2 i f x + pd2 i g x := by
    intro f g hf hg
    simp only [pd2]
    show fderiv ℝ (f + g) x (e2 i) = _
    rw [(hf.hasFDerivAt.add hg.hasFDerivAt).fderiv]
    rfl
  
  have E : ∀ k b : Fin 2,
      pd2 i (fun z => (h z)⁻¹ k 0) x * h x 0 b + (h x)⁻¹ k 0 * pd2 i (fun z => h z 0 b) x +
      (pd2 i (fun z => (h z)⁻¹ k 1) x * h x 1 b + (h x)⁻¹ k 1 * pd2 i (fun z => h z 1 b) x)
        = 0 := by
    intro k b
    have hev : (fun z => (h z)⁻¹ k 0 * h z 0 b + (h z)⁻¹ k 1 * h z 1 b) =ᶠ[𝓝 x]
        fun _ => (1 : Matrix (Fin 2) (Fin 2) ℝ) k b := by
      filter_upwards [hs.mem_nhds hx] with z hz
      have hu' : IsUnit (h z).det := isUnit_iff_ne_zero.mpr (hhpos z hz).det_pos.ne'
      rw [← Matrix.nonsing_inv_mul (h z) hu', Matrix.mul_apply, Fin.sum_univ_two]
    have h0 : pd2 i (fun z => (h z)⁻¹ k 0 * h z 0 b + (h z)⁻¹ k 1 * h z 1 b) x = 0 := by
      simp only [pd2]
      rw [hev.fderiv_eq]
      simp
    have d0 : DifferentiableAt ℝ (fun z => (h z)⁻¹ k 0 * h z 0 b) x := (dInv k 0).mul (dA 0 b)
    have d1 : DifferentiableAt ℝ (fun z => (h z)⁻¹ k 1 * h z 1 b) x := (dInv k 1).mul (dA 1 b)
    have s1 : pd2 i (fun z => (h z)⁻¹ k 0 * h z 0 b + (h z)⁻¹ k 1 * h z 1 b) x =
        pd2 i (fun z => (h z)⁻¹ k 0 * h z 0 b) x + pd2 i (fun z => (h z)⁻¹ k 1 * h z 1 b) x :=
      pdadd _ _ d0 d1
    have s2 : pd2 i (fun z => (h z)⁻¹ k 0 * h z 0 b) x =
        pd2 i (fun z => (h z)⁻¹ k 0) x * h x 0 b + (h x)⁻¹ k 0 * pd2 i (fun z => h z 0 b) x :=
      pdmul _ _ (dInv k 0) (dA 0 b)
    have s3 : pd2 i (fun z => (h z)⁻¹ k 1 * h z 1 b) x =
        pd2 i (fun z => (h z)⁻¹ k 1) x * h x 1 b + (h x)⁻¹ k 1 * pd2 i (fun z => h z 1 b) x :=
      pdmul _ _ (dInv k 1) (dA 1 b)
    rw [s1, s2, s3] at h0
    exact h0
  have F00 : h x 0 0 * (h x)⁻¹ 0 0 + h x 0 1 * (h x)⁻¹ 1 0 = 1 := by
    have := congrFun (congrFun hmul 0) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have F01 : h x 0 0 * (h x)⁻¹ 0 1 + h x 0 1 * (h x)⁻¹ 1 1 = 0 := by
    have := congrFun (congrFun hmul 0) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have F10 : h x 1 0 * (h x)⁻¹ 0 0 + h x 1 1 * (h x)⁻¹ 1 0 = 0 := by
    have := congrFun (congrFun hmul 1) 0
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  have F11 : h x 1 0 * (h x)⁻¹ 0 1 + h x 1 1 * (h x)⁻¹ 1 1 = 1 := by
    have := congrFun (congrFun hmul 1) 1
    simpa [Matrix.mul_apply, Fin.sum_univ_two] using this
  
  have hinvd : ∀ k l : Fin 2, pd2 i (fun z => (h z)⁻¹ k l) x =
      -∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ k a * pd2 i (fun z => h z a b) x * (h x)⁻¹ b l := by
    intro k
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · simp only [Fin.sum_univ_two]
      linear_combination (h x)⁻¹ 0 0 * E k 0 + (h x)⁻¹ 1 0 * E k 1
        - pd2 i (fun z => (h z)⁻¹ k 0) x * F00 - pd2 i (fun z => (h z)⁻¹ k 1) x * F10
    · simp only [Fin.sum_univ_two]
      linear_combination (h x)⁻¹ 0 1 * E k 0 + (h x)⁻¹ 1 1 * E k 1
        - pd2 i (fun z => (h z)⁻¹ k 0) x * F01 - pd2 i (fun z => (h z)⁻¹ k 1) x * F11
  
  have hcol : ∀ k l : Fin 2, pd2 i (fun z => (h z)⁻¹ k l) x =
      -∑ a : Fin 2, (h x)⁻¹ k a * christoffel2 h l i a x -
        ∑ b : Fin 2, christoffel2 h k i b x * (h x)⁻¹ b l := by
    intro k l
    rw [hinvd k l]
    simp only [christoffel2, Fin.sum_univ_two]
    simp only [hisym l 0, hisym l 1, hsymd i]
    ring
  
  have hsum2 : ∀ F G : Fin 2 → Fin 2 → E2 → ℝ, (∀ k l, DifferentiableAt ℝ (F k l) x) →
      (∀ k l, DifferentiableAt ℝ (G k l) x) →
      pd2 i (fun y => ∑ k : Fin 2, ∑ l : Fin 2, F k l y * G k l y) x =
        ∑ k : Fin 2, ∑ l : Fin 2, (pd2 i (F k l) x * G k l x + F k l x * pd2 i (G k l) x) := by
    intro F G hF hG
    have m : ∀ k l, pd2 i (fun y => F k l y * G k l y) x =
        pd2 i (F k l) x * G k l x + F k l x * pd2 i (G k l) x :=
      fun k l => pdmul _ _ (hF k l) (hG k l)
    have dm : ∀ k l, DifferentiableAt ℝ (fun y => F k l y * G k l y) x :=
      fun k l => (hF k l).mul (hG k l)
    have a1 : ∀ k, pd2 i (fun y => F k 0 y * G k 0 y + F k 1 y * G k 1 y) x =
        pd2 i (fun y => F k 0 y * G k 0 y) x + pd2 i (fun y => F k 1 y * G k 1 y) x :=
      fun k => pdadd _ _ (dm k 0) (dm k 1)
    have da : ∀ k, DifferentiableAt ℝ (fun y => F k 0 y * G k 0 y + F k 1 y * G k 1 y) x :=
      fun k => (dm k 0).add (dm k 1)
    have a2 : pd2 i (fun y => F 0 0 y * G 0 0 y + F 0 1 y * G 0 1 y +
          (F 1 0 y * G 1 0 y + F 1 1 y * G 1 1 y)) x =
        pd2 i (fun y => F 0 0 y * G 0 0 y + F 0 1 y * G 0 1 y) x +
          pd2 i (fun y => F 1 0 y * G 1 0 y + F 1 1 y * G 1 1 y) x :=
      pdadd _ _ (da 0) (da 1)
    simp only [Fin.sum_univ_two]
    rw [a2, a1, a1, m, m, m, m]
  have hw : pd2 i (fun y => ∑ k : Fin 2, ∑ l : Fin 2, (h y)⁻¹ k l * C k j l y) x =
      ∑ k : Fin 2, ∑ l : Fin 2,
        (pd2 i (fun z => (h z)⁻¹ k l) x * C k j l x + (h x)⁻¹ k l * pd2 i (C k j l) x) :=
    hsum2 (fun k l z => (h z)⁻¹ k l) (fun k l => C k j l) dInv (fun k l => hC k j l)
  simp only [gsSimonsE, gsCovD1]
  rw [hw]
  simp only [hcol, gsCovD3, Fin.sum_univ_two]
  ring

theorem gsr_nu_alg (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (y : E2) (hGs : ∀ a b : Fin 3, G (F y) a b = G (F y) b a) (hGpos : (G (F y)).PosDef) (hinj : Function.Injective (fderiv ℝ F y)) : 0 < gsNormLen G F y ∧ (∀ i : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * gsTan F i y b = 0) ∧ (∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * gsrNu G F y b = 1) ∧ (∀ (P : Fin 3 → ℝ) (e : Fin 3), P e = ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F y)⁻¹ a b * (∑ c : Fin 3, ∑ d : Fin 3, gsTan F b y c * G (F y) c d * P d) * gsTan F a y e + (∑ c : Fin 3, ∑ d : Fin 3, gsrNu G F y c * G (F y) c d * P d) * gsrNu G F y e) ∧ (∀ l k : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, gsrNu G F y c * G (F y) c d * gsCovHess G F l k y d = gsSff G F l k y) ∧ ∀ k i j : Fin 2, gsAmbCod G F k i j y = gsrF4 (fun a b c m => gsrRm G a b c m (F y)) (fun a => gsTan F k y a) (fun a => gsTan F i y a) (fun a => gsTan F j y a) (gsrNu G F y) :=
by
  
  have core : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (D : Fin 2 → Fin 3 → ℝ) (N : Fin 3 → ℝ)
      (h : Matrix (Fin 2) (Fin 2) ℝ) (P Q : Fin 3 → ℝ),
      (∀ i j, A i j = A j i) →
      N = ![D 0 1 * D 1 2 - D 0 2 * D 1 1, D 0 2 * D 1 0 - D 0 0 * D 1 2,
        D 0 0 * D 1 1 - D 0 1 * D 1 0] →
      (∀ i j, h i j = ∑ k : Fin 3, ∑ l : Fin 3, D i k * A k l * D j l) →
      (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) ≠ 0 →
      ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d =
        ∑ a : Fin 2, ∑ b : Fin 2, h⁻¹ a b *
            (∑ c : Fin 3, ∑ d : Fin 3, D a c * A c d * P d) *
            (∑ c : Fin 3, ∑ d : Fin 3, D b c * A c d * Q d) +
          (∑ c : Fin 3, N c * P c) * (∑ c : Fin 3, N c * Q c) /
            (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) := by
    intro A D N h P Q hsym hN hh hS
    have n0 : N 0 = D 0 1 * D 1 2 - D 0 2 * D 1 1 := by rw [hN]; rfl
    have n1 : N 1 = D 0 2 * D 1 0 - D 0 0 * D 1 2 := by rw [hN]; rfl
    have n2 : N 2 = D 0 0 * D 1 1 - D 0 1 * D 1 0 := by rw [hN]; rfl
    have k00 : A.adjugate 0 0 = A 1 1 * A 2 2 - A 1 2 * A 2 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k01 : A.adjugate 0 1 = -(A 0 1 * A 2 2) + A 0 2 * A 2 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k02 : A.adjugate 0 2 = A 0 1 * A 1 2 - A 0 2 * A 1 1 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k10 : A.adjugate 1 0 = -(A 1 0 * A 2 2) + A 1 2 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k11 : A.adjugate 1 1 = A 0 0 * A 2 2 - A 0 2 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k12 : A.adjugate 1 2 = -(A 0 0 * A 1 2) + A 0 2 * A 1 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k20 : A.adjugate 2 0 = A 1 0 * A 2 1 - A 1 1 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k21 : A.adjugate 2 1 = -(A 0 0 * A 2 1) + A 0 1 * A 2 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have k22 : A.adjugate 2 2 = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
      rw [Matrix.adjugate_fin_three]; rfl
    have a00 : h.adjugate 0 0 = h 1 1 := by rw [Matrix.adjugate_fin_two]; rfl
    have a01 : h.adjugate 0 1 = -h 0 1 := by rw [Matrix.adjugate_fin_two]; rfl
    have a10 : h.adjugate 1 0 = -h 1 0 := by rw [Matrix.adjugate_fin_two]; rfl
    have a11 : h.adjugate 1 1 = h 0 0 := by rw [Matrix.adjugate_fin_two]; rfl
    have hAi : A⁻¹ = A.det⁻¹ • A.adjugate := by rw [Matrix.inv_def, Ring.inverse_eq_inv']
    have hSs : (∑ k : Fin 3, ∑ l : Fin 3, A⁻¹ k l * N k * N l) =
        A.det⁻¹ * ∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l := by
      rw [hAi]
      simp only [Matrix.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      ring
    have hCB : h.det = ∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l := by
      rw [Matrix.det_fin_two]
      simp only [hh, Fin.sum_univ_three, k00, k01, k02, k10, k11, k12, k20, k21, k22, n0, n1, n2]
      rw [hsym 1 0, hsym 2 0, hsym 2 1]
      ring
    have key : (∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l) *
          (∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d) =
        ∑ a : Fin 2, ∑ b : Fin 2, h.adjugate a b *
            (∑ c : Fin 3, ∑ d : Fin 3, D a c * A c d * P d) *
            (∑ c : Fin 3, ∑ d : Fin 3, D b c * A c d * Q d) +
          A.det * ((∑ c : Fin 3, N c * P c) * (∑ c : Fin 3, N c * Q c)) := by
      rw [Matrix.det_fin_three]
      simp only [Fin.sum_univ_two, a00, a01, a10, a11, hh, Fin.sum_univ_three,
        k00, k01, k02, k10, k11, k12, k20, k21, k22, n0, n1, n2]
      rw [hsym 1 0, hsym 2 0, hsym 2 1]
      ring
    generalize hs : (∑ k : Fin 3, ∑ l : Fin 3, A.adjugate k l * N k * N l) = s at hSs hCB key
    have hs0 : s ≠ 0 := by
      intro h0; apply hS; rw [hSs, h0, mul_zero]
    have hinv : h⁻¹ = s⁻¹ • h.adjugate := by rw [Matrix.inv_def, Ring.inverse_eq_inv', hCB]
    have hL : ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d =
        s⁻¹ * (s * ∑ c : Fin 3, ∑ d : Fin 3, A c d * P c * Q d) := by
      rw [← mul_assoc, inv_mul_cancel₀ hs0, one_mul]
    rw [hL, key, hSs, hinv]
    simp only [Matrix.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    field_simp
  
  have hN : gsCrossN F y ≠ 0 := by
    intro hN0
    have n0 : gsTan F 0 y 1 * gsTan F 1 y 2 - gsTan F 0 y 2 * gsTan F 1 y 1 = 0 := by
      have := congrFun hN0 0; exact this
    have n1 : gsTan F 0 y 2 * gsTan F 1 y 0 - gsTan F 0 y 0 * gsTan F 1 y 2 = 0 := by
      have := congrFun hN0 1; exact this
    have n2 : gsTan F 0 y 0 * gsTan F 1 y 1 - gsTan F 0 y 1 * gsTan F 1 y 0 = 0 := by
      have := congrFun hN0 2; exact this
    have hLa : fderiv ℝ F y (e2 0) = gsTan F 0 y := rfl
    have hLb : fderiv ℝ F y (e2 1) = gsTan F 1 y := rfl
    set a := gsTan F 0 y with ha
    set b := gsTan F 1 y with hb
    have hv : fderiv ℝ F y ((b 0 ^ 2 + b 1 ^ 2 + b 2 ^ 2) • e2 0 -
        (a 0 * b 0 + a 1 * b 1 + a 2 * b 2) • e2 1) = 0 := by
      rw [map_sub, map_smul, map_smul, hLa, hLb]
      ext m
      fin_cases m
      · simp
        linear_combination b 1 * n2 - b 2 * n1
      · simp
        linear_combination b 2 * n0 - b 0 * n2
      · simp
        linear_combination b 0 * n1 - b 1 * n0
    have hv0 := hinj (hv.trans (map_zero _).symm)
    have hβ : b 0 ^ 2 + b 1 ^ 2 + b 2 ^ 2 = 0 := by
      have := congrArg (fun v : E2 => v 0) hv0
      simpa using this
    have hb0 : b 0 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb1 : b 1 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb2 : b 2 = 0 := by nlinarith [sq_nonneg (b 0), sq_nonneg (b 1), sq_nonneg (b 2)]
    have hb' : fderiv ℝ F y (e2 1) = 0 := by
      rw [hLb]
      ext m
      fin_cases m <;> simp [hb0, hb1, hb2]
    have h1 := hinj (hb'.trans (map_zero _).symm)
    have h2 := congrArg (fun v : E2 => v 1) h1
    simp at h2
  
  have hSpos : 0 < ∑ k : Fin 3, ∑ l : Fin 3,
      (G (F y))⁻¹ k l * gsCrossN F y k * gsCrossN F y l := by
    have h1 := hGpos.inv.dotProduct_mulVec_pos hN
    have e : dotProduct (star (gsCrossN F y)) ((G (F y))⁻¹.mulVec (gsCrossN F y)) =
        ∑ k : Fin 3, ∑ l : Fin 3, (G (F y))⁻¹ k l * gsCrossN F y k * gsCrossN F y l := by
      simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      ring
    rw [← e]; exact h1
  have hpos : 0 < gsNormLen G F y := Real.sqrt_pos.mpr hSpos
  have hlam : gsNormLen G F y ≠ 0 := hpos.ne'
  have hlen : gsNormLen G F y ^ 2 = ∑ k : Fin 3, ∑ l : Fin 3,
      (G (F y))⁻¹ k l * gsCrossN F y k * gsCrossN F y l := Real.sq_sqrt hSpos.le
  
  have hdet : IsUnit (G (F y)).det := (Matrix.isUnit_iff_isUnit_det _).mp hGpos.isUnit
  have hm : G (F y) * (G (F y))⁻¹ = 1 := Matrix.mul_nonsing_inv _ hdet
  have hm' : (G (F y))⁻¹ * G (F y) = 1 := Matrix.nonsing_inv_mul _ hdet
  have E : ∀ b c : Fin 3, ∑ a : Fin 3, G (F y) b a * (G (F y))⁻¹ a c =
      if b = c then 1 else 0 := by
    intro b c; rw [← Matrix.mul_apply, hm, Matrix.one_apply]
  have E' : ∀ b c : Fin 3, ∑ a : Fin 3, (G (F y))⁻¹ b a * G (F y) a c =
      if b = c then 1 else 0 := by
    intro b c; rw [← Matrix.mul_apply, hm', Matrix.one_apply]
  
  have hlow : ∀ b : Fin 3, ∑ a : Fin 3, gsrNu G F y a * G (F y) a b =
      gsCrossN F y b / gsNormLen G F y := by
    intro b
    simp only [gsrNu, div_mul_eq_mul_div]
    rw [← Finset.sum_div]
    congr 1
    calc ∑ a : Fin 3, (∑ c : Fin 3, (G (F y))⁻¹ a c * gsCrossN F y c) * G (F y) a b
        = ∑ c : Fin 3, (∑ a : Fin 3, G (F y) b a * (G (F y))⁻¹ a c) * gsCrossN F y c := by
          simp only [Finset.sum_mul]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun a _ => ?_
          rw [hGs a b]; ring
      _ = gsCrossN F y b := by
          simp only [E, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  
  have W : ∀ X : Fin 3 → ℝ, ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * X b =
      (∑ b : Fin 3, gsCrossN F y b * X b) / gsNormLen G F y := by
    intro X
    calc ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * X b
        = ∑ b : Fin 3, (∑ a : Fin 3, gsrNu G F y a * G (F y) a b) * X b := by
          rw [Finset.sum_comm]; simp only [Finset.sum_mul]
      _ = ∑ b : Fin 3, gsCrossN F y b / gsNormLen G F y * X b := by simp only [hlow]
      _ = _ := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl fun b _ => ?_
          ring
  refine ⟨hpos, ?_, ?_, ?_, ?_, ?_⟩
  · 
    intro i
    have h0 : ∑ b : Fin 3, gsCrossN F y b * gsTan F i y b = 0 := by
      fin_cases i <;> simp [Fin.sum_univ_three, gsCrossN] <;> ring
    rw [W, h0, zero_div]
  · 
    rw [W]
    have h1 : ∑ b : Fin 3, gsCrossN F y b * gsrNu G F y b =
        (∑ k : Fin 3, ∑ l : Fin 3, (G (F y))⁻¹ k l * gsCrossN F y k * gsCrossN F y l) /
          gsNormLen G F y := by
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl fun k _ => ?_
      simp only [gsrNu]
      rw [mul_div_assoc', Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun l _ => ?_
      ring
    rw [h1, div_div, ← pow_two, hlen, div_self hSpos.ne']
  · 
    intro P e
    have hs := core (G (F y)) (fun i c => gsTan F i y c) (gsCrossN F y) (pullMetric2 G F y)
      (fun d => (G (F y))⁻¹ e d) P hGs rfl (fun i j => rfl) hSpos.ne'
    have F2 : ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * (G (F y))⁻¹ e c * P d = P e := by
      calc ∑ c : Fin 3, ∑ d : Fin 3, G (F y) c d * (G (F y))⁻¹ e c * P d
          = ∑ d : Fin 3, (∑ c : Fin 3, (G (F y))⁻¹ e c * G (F y) c d) * P d := by
            rw [Finset.sum_comm]
            simp only [Finset.sum_mul]
            refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun c _ => ?_
            ring
        _ = P e := by
            simp only [E', ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ,
              if_true]
    have F3 : ∀ a : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3,
        gsTan F a y c * G (F y) c d * (G (F y))⁻¹ e d = gsTan F a y e := by
      intro a
      calc ∑ c : Fin 3, ∑ d : Fin 3, gsTan F a y c * G (F y) c d * (G (F y))⁻¹ e d
          = ∑ c : Fin 3, gsTan F a y c * (∑ d : Fin 3, (G (F y))⁻¹ e d * G (F y) d c) := by
            refine Finset.sum_congr rfl fun c _ => ?_
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun d _ => ?_
            rw [hGs c d]; ring
        _ = gsTan F a y e := by
            simp only [E', mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
              if_true]
    have F4 : ∑ c : Fin 3, gsCrossN F y c * (G (F y))⁻¹ e c =
        ∑ b : Fin 3, (G (F y))⁻¹ e b * gsCrossN F y b :=
      Finset.sum_congr rfl fun c _ => mul_comm _ _
    simp only [F2, F3, F4] at hs
    rw [W P]
    rw [show gsrNu G F y e = (∑ b : Fin 3, (G (F y))⁻¹ e b * gsCrossN F y b) / gsNormLen G F y
      from rfl]
    rw [hs, ← hlen]
    congr 1
    · refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      ring
    · field_simp
  · 
    intro l k
    rw [W]
    rfl
  · 
    intro k i j
    have hw : ∀ l : Fin 3, gsCrossN F y l / gsNormLen G F y =
        ∑ m : Fin 3, gsrNu G F y m * G (F y) m l := fun l => (hlow l).symm
    have h1 : gsAmbCod G F k i j y = ∑ l : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3,
        gsCrossN F y l / gsNormLen G F y * riemannLocal G l a b c (F y) *
          gsTan F k y a * gsTan F i y b * gsTan F j y c := by
      unfold gsAmbCod
      simp only [Finset.sum_div]
      refine Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun a _ =>
        Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => ?_
      ring
    rw [h1]
    simp only [hw]
    simp only [gsrF4, gsrRm, Fin.sum_univ_three]
    ring

theorem gsr_nu_deriv_relations (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hcompat : ∀ y ∈ U, ∀ r a b : Fin 3, partialDeriv r (fun z => G z a b) y = ∑ e : Fin 3, (G y a e * christoffel G e r b y + G y b e * christoffel G e r a y)) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (htan : ∀ (i : Fin 2) (c : Fin 3), ContDiffOn ℝ ∞ (fun y => gsTan F i y c) s) (htanD : ∀ y ∈ s, ∀ (k i : Fin 2) (c : Fin 3), pd2 k (fun y' => gsTan F i y' c) y = gsHessF F k i y c) (hν : ∀ e : Fin 3, ContDiffOn ℝ ∞ (fun y => gsrNu G F y e) s) (horth : ∀ y ∈ s, ∀ i : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * gsTan F i y b = 0) (hunit : ∀ y ∈ s, ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F y a * G (F y) a b * gsrNu G F y b = 1) : ∀ x ∈ s, ∀ l : Fin 2, (∀ i : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, (pd2 l (fun y => gsrNu G F y a) x + ∑ r : Fin 3, ∑ q : Fin 3, christoffel G a r q (F x) * gsTan F l x r * gsrNu G F x q) * G (F x) a b * gsTan F i x b = -∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F x a * G (F x) a b * gsCovHess G F l i x b) ∧ ∑ a : Fin 3, ∑ b : Fin 3, (pd2 l (fun y => gsrNu G F y a) x + ∑ r : Fin 3, ∑ q : Fin 3, christoffel G a r q (F x) * gsTan F l x r * gsrNu G F x q) * G (F x) a b * gsrNu G F x b = 0 :=
by
  classical
  intro x hx l
  have hx' : s ∈ 𝓝 x := hs.mem_nhds hx
  have hdiff : ∀ φ : E2 → ℝ, ContDiffOn ℝ ∞ φ s → DifferentiableAt ℝ φ x :=
    fun φ h => (h.differentiableOn (by simp)).differentiableAt hx'
  have hνd : ∀ c : Fin 3, DifferentiableAt ℝ (fun y => gsrNu G F y c) x :=
    fun c => hdiff _ (hν c)
  have htd : ∀ (m : Fin 2) (c : Fin 3), DifferentiableAt ℝ (fun y => gsTan F m y c) x :=
    fun m c => hdiff _ (htan m c)
  have hFd : DifferentiableAt ℝ F x := (hF.contDiffAt hx').differentiableAt (by simp)
  have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) (F x) := fun a b =>
    ((hG a b).contDiffAt (hU.mem_nhds (hFU x hx))).differentiableAt (by simp)
  have hAd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G (F y) a b) x := fun a b =>
    (hGd a b).comp x hFd
  
  have hchain : ∀ a b : Fin 3, pd2 l (fun y => G (F y) a b) x =
      ∑ r : Fin 3, partialDeriv r (fun z => G z a b) (F x) * gsTan F l x r := by
    intro a b
    show fderiv ℝ (fun y => G (F y) a b) x (e2 l) = _
    rw [show (fun y => G (F y) a b) = (fun z => G z a b) ∘ F from rfl,
      fderiv_comp x (hGd a b) hFd, ContinuousLinearMap.comp_apply]
    have hv : fderiv ℝ F x (e2 l) = ∑ r : Fin 3, (fderiv ℝ F x (e2 l)) r • e r := by
      ext m
      simp [EuclideanSpace.single_apply, Pi.single_apply]
    rw [hv, map_sum]
    refine Finset.sum_congr rfl fun r _ => ?_
    rw [map_smul, smul_eq_mul, mul_comm]
    simp [partialDeriv, gsTan, EuclideanSpace.single_apply]
  
  have hbil : ∀ V W : E2 → Fin 3 → ℝ, (∀ c : Fin 3, DifferentiableAt ℝ (fun y => V y c) x) →
      (∀ c : Fin 3, DifferentiableAt ℝ (fun y => W y c) x) →
      pd2 l (fun y => ∑ a : Fin 3, ∑ b : Fin 3, V y a * G (F y) a b * W y b) x =
        ∑ a : Fin 3, ∑ b : Fin 3, (pd2 l (fun y => V y a) x * G (F x) a b * W x b +
          V x a * pd2 l (fun y => G (F y) a b) x * W x b +
          V x a * G (F x) a b * pd2 l (fun y => W y b) x) := by
    intro V W hV hW
    have dP : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => V y a * G (F y) a b * W y b) x :=
      fun a b => ((hV a).mul (hAd a b)).mul (hW b)
    have dS : ∀ a : Fin 3,
        DifferentiableAt ℝ (fun y => ∑ b : Fin 3, V y a * G (F y) a b * W y b) x :=
      fun a => (DifferentiableAt.sum (u := Finset.univ) fun b _ => dP a b).congr_of_eventuallyEq
        (Filter.Eventually.of_forall fun y => by simp [Finset.sum_apply])
    unfold pd2
    rw [fderiv_fun_sum (fun a _ => dS a), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [fderiv_fun_sum (fun b _ => dP a b), ContinuousLinearMap.sum_apply]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [fderiv_fun_mul (show DifferentiableAt ℝ (fun y => V y a * G (F y) a b) x from
        (hV a).mul (hAd a b)) (hW b), fderiv_fun_mul (hV a) (hAd a b)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have alg : ∀ (Gm : Matrix (Fin 3) (Fin 3) ℝ), (∀ a b : Fin 3, Gm a b = Gm b a) →
      ∀ (Γ P : Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ r a b : Fin 3, P r a b = ∑ e : Fin 3, (Gm a e * Γ e r b + Gm b e * Γ e r a)) →
      ∀ (T v w dv dw : Fin 3 → ℝ),
      ∑ a : Fin 3, ∑ b : Fin 3, (dv a * Gm a b * w b + v a * (∑ r : Fin 3, P r a b * T r) * w b +
          v a * Gm a b * dw b) =
        ∑ a : Fin 3, ∑ b : Fin 3, (dv a + ∑ r : Fin 3, ∑ q : Fin 3, Γ a r q * T r * v q) *
            Gm a b * w b +
          ∑ a : Fin 3, ∑ b : Fin 3, v a * Gm a b *
            (dw b + ∑ r : Fin 3, ∑ q : Fin 3, Γ b r q * T r * w q) := by
    intro Gm hGs Γ P hP T v w dv dw
    simp only [hP, Fin.sum_univ_three]
    simp only [hGs 1 0, hGs 2 0, hGs 2 1]
    ring
  have hP : ∀ r a b : Fin 3, partialDeriv r (fun z => G z a b) (F x) =
      ∑ e : Fin 3, (G (F x) a e * christoffel G e r b (F x) +
        G (F x) b e * christoffel G e r a (F x)) := hcompat (F x) (hFU x hx)
  have key : ∀ V W : E2 → Fin 3 → ℝ, (∀ c : Fin 3, DifferentiableAt ℝ (fun y => V y c) x) →
      (∀ c : Fin 3, DifferentiableAt ℝ (fun y => W y c) x) →
      pd2 l (fun y => ∑ a : Fin 3, ∑ b : Fin 3, V y a * G (F y) a b * W y b) x =
        ∑ a : Fin 3, ∑ b : Fin 3, (pd2 l (fun y => V y a) x + ∑ r : Fin 3, ∑ q : Fin 3,
            christoffel G a r q (F x) * gsTan F l x r * V x q) * G (F x) a b * W x b +
          ∑ a : Fin 3, ∑ b : Fin 3, V x a * G (F x) a b *
            (pd2 l (fun y => W y b) x + ∑ r : Fin 3, ∑ q : Fin 3,
              christoffel G b r q (F x) * gsTan F l x r * W x q) := by
    intro V W hV hW
    rw [hbil V W hV hW]
    simp only [hchain]
    exact alg (G (F x)) (hGsymm (F x)) (fun e r b => christoffel G e r b (F x))
      (fun r a b => partialDeriv r (fun z => G z a b) (F x)) hP
      (fun r => gsTan F l x r) (fun a => V x a) (fun b => W x b)
      (fun a => pd2 l (fun y => V y a) x) (fun b => pd2 l (fun y => W y b) x)
  refine ⟨fun i => ?_, ?_⟩
  · have h0 : pd2 l (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
        gsrNu G F y a * G (F y) a b * gsTan F i y b) x = 0 := by
      have hev : (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
          gsrNu G F y a * G (F y) a b * gsTan F i y b) =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
        Filter.eventually_of_mem hx' (fun y hy => horth y hy i)
      unfold pd2
      rw [hev.fderiv_eq]
      simp
    have hk := key (fun y a => gsrNu G F y a) (fun y b => gsTan F i y b) hνd (htd i)
    beta_reduce at hk
    rw [h0] at hk
    have hcov : ∀ b : Fin 3, pd2 l (fun y => gsTan F i y b) x + ∑ r : Fin 3, ∑ q : Fin 3,
        christoffel G b r q (F x) * gsTan F l x r * gsTan F i x q = gsCovHess G F l i x b := by
      intro b
      unfold gsCovHess
      rw [htanD x hx l i b]
    simp only [hcov] at hk
    linarith
  · have h1 : pd2 l (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
        gsrNu G F y a * G (F y) a b * gsrNu G F y b) x = 0 := by
      have hev : (fun y => ∑ a : Fin 3, ∑ b : Fin 3,
          gsrNu G F y a * G (F y) a b * gsrNu G F y b) =ᶠ[𝓝 x] (fun _ => (1 : ℝ)) :=
        Filter.eventually_of_mem hx' (fun y hy => hunit y hy)
      unfold pd2
      rw [hev.fderiv_eq]
      simp
    have hk := key (fun y a => gsrNu G F y a) (fun y b => gsrNu G F y b) hνd hνd
    beta_reduce at hk
    rw [h1] at hk
    have hswap : ∑ a : Fin 3, ∑ b : Fin 3, gsrNu G F x a * G (F x) a b *
        (pd2 l (fun y => gsrNu G F y b) x + ∑ r : Fin 3, ∑ q : Fin 3,
          christoffel G b r q (F x) * gsTan F l x r * gsrNu G F x q) =
        ∑ a : Fin 3, ∑ b : Fin 3, (pd2 l (fun y => gsrNu G F y a) x + ∑ r : Fin 3, ∑ q : Fin 3,
          christoffel G a r q (F x) * gsTan F l x r * gsrNu G F x q) * G (F x) a b *
          gsrNu G F x b := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => ?_
      rw [hGsymm (F x) a b]
      ring
    linarith

theorem gsr_cod_deriv (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hRm : ∀ a b c m : Fin 3, ContDiffOn ℝ ∞ (gsrRm G a b c m) U) (htan : ∀ (i : Fin 2) (c : Fin 3), ContDiffOn ℝ ∞ (fun y => gsTan F i y c) s) (htanD : ∀ y ∈ s, ∀ (k i : Fin 2) (c : Fin 3), pd2 k (fun y' => gsTan F i y' c) y = gsHessF F k i y c) (hν : ∀ e : Fin 3, ContDiffOn ℝ ∞ (fun y => gsrNu G F y e) s) (hrep : ∀ y ∈ s, ∀ k i j : Fin 2, gsAmbCod G F k i j y = gsrF4 (fun a b c m => gsrRm G a b c m (F y)) (fun a => gsTan F k y a) (fun a => gsTan F i y a) (fun a => gsTan F j y a) (gsrNu G F y)) : ∀ x ∈ s, (∀ k i j : Fin 2, DifferentiableAt ℝ (gsAmbCod G F k i j) x) ∧ ∀ l k i j : Fin 2, pd2 l (gsAmbCod G F k i j) x = gsrF5 (fun r a b c m => partialDeriv r (gsrRm G a b c m) (F x)) (fun r => gsTan F l x r) (fun a => gsTan F k x a) (fun a => gsTan F i x a) (fun a => gsTan F j x a) (gsrNu G F x) + gsrF4 (fun a b c m => gsrRm G a b c m (F x)) (fun a => gsHessF F l k x a) (fun a => gsTan F i x a) (fun a => gsTan F j x a) (gsrNu G F x) + gsrF4 (fun a b c m => gsrRm G a b c m (F x)) (fun a => gsTan F k x a) (fun a => gsHessF F l i x a) (fun a => gsTan F j x a) (gsrNu G F x) + gsrF4 (fun a b c m => gsrRm G a b c m (F x)) (fun a => gsTan F k x a) (fun a => gsTan F i x a) (fun a => gsHessF F l j x a) (gsrNu G F x) + gsrF4 (fun a b c m => gsrRm G a b c m (F x)) (fun a => gsTan F k x a) (fun a => gsTan F i x a) (fun a => gsTan F j x a) (fun m => pd2 l (fun y => gsrNu G F y m) x) :=
by
  intro x hx
  have hxn : s ∈ 𝓝 x := hs.mem_nhds hx
  
  have H1 : ∀ (l : Fin 2) (f g : E2 → ℝ), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 l (fun y => f y * g y) x = pd2 l f x * g x + f x * pd2 l g x := by
    intro l f g hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have H2 : ∀ (l : Fin 2) (A : Fin 3 → E2 → ℝ), (∀ a, DifferentiableAt ℝ (A a) x) →
      pd2 l (fun y => ∑ a, A a y) x = ∑ a, pd2 l (A a) x := by
    intro l A hA
    unfold pd2
    rw [fderiv_fun_sum (fun a _ => hA a), ContinuousLinearMap.sum_apply]
  
  have hSum4 : ∀ (P : Fin 3 → Fin 3 → Fin 3 → Fin 3 → E2 → ℝ),
      (∀ a b c m, DifferentiableAt ℝ (P a b c m) x) →
      DifferentiableAt ℝ (fun y => ∑ a, ∑ b, ∑ c, ∑ m, P a b c m y) x ∧
      ∀ l : Fin 2, pd2 l (fun y => ∑ a, ∑ b, ∑ c, ∑ m, P a b c m y) x =
        ∑ a, ∑ b, ∑ c, ∑ m, pd2 l (P a b c m) x := by
    intro P hP
    have h1 : ∀ a b c, DifferentiableAt ℝ (fun y => ∑ m, P a b c m y) x :=
      fun a b c => DifferentiableAt.fun_sum (fun m _ => hP a b c m)
    have h2 : ∀ a b, DifferentiableAt ℝ (fun y => ∑ c, ∑ m, P a b c m y) x :=
      fun a b => DifferentiableAt.fun_sum (fun c _ => h1 a b c)
    have h3 : ∀ a, DifferentiableAt ℝ (fun y => ∑ b, ∑ c, ∑ m, P a b c m y) x :=
      fun a => DifferentiableAt.fun_sum (fun b _ => h2 a b)
    refine ⟨DifferentiableAt.fun_sum (fun a _ => h3 a), fun l => ?_⟩
    rw [H2 l (fun a y => ∑ b, ∑ c, ∑ m, P a b c m y) h3]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [H2 l (fun b y => ∑ c, ∑ m, P a b c m y) (h2 a)]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    rw [H2 l (fun c y => ∑ m, P a b c m y) (h1 a b)]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    exact H2 l (P a b c) (hP a b c)
  
  have hLeib : ∀ (ρ : Fin 3 → Fin 3 → Fin 3 → Fin 3 → E2 → ℝ) (X Y Z W : Fin 3 → E2 → ℝ),
      (∀ a b c m, DifferentiableAt ℝ (ρ a b c m) x) → (∀ a, DifferentiableAt ℝ (X a) x) →
      (∀ a, DifferentiableAt ℝ (Y a) x) → (∀ a, DifferentiableAt ℝ (Z a) x) →
      (∀ a, DifferentiableAt ℝ (W a) x) →
      DifferentiableAt ℝ (fun y => gsrF4 (fun a b c m => ρ a b c m y) (fun a => X a y)
        (fun a => Y a y) (fun a => Z a y) (fun a => W a y)) x ∧
      ∀ l : Fin 2, pd2 l (fun y => gsrF4 (fun a b c m => ρ a b c m y) (fun a => X a y)
        (fun a => Y a y) (fun a => Z a y) (fun a => W a y)) x =
        gsrF4 (fun a b c m => pd2 l (ρ a b c m) x) (fun a => X a x) (fun a => Y a x)
            (fun a => Z a x) (fun a => W a x) +
          gsrF4 (fun a b c m => ρ a b c m x) (fun a => pd2 l (X a) x) (fun a => Y a x)
            (fun a => Z a x) (fun a => W a x) +
          gsrF4 (fun a b c m => ρ a b c m x) (fun a => X a x) (fun a => pd2 l (Y a) x)
            (fun a => Z a x) (fun a => W a x) +
          gsrF4 (fun a b c m => ρ a b c m x) (fun a => X a x) (fun a => Y a x)
            (fun a => pd2 l (Z a) x) (fun a => W a x) +
          gsrF4 (fun a b c m => ρ a b c m x) (fun a => X a x) (fun a => Y a x)
            (fun a => Z a x) (fun a => pd2 l (W a) x) := by
    intro ρ X Y Z W hρ hX hY hZ hW
    have hP := hSum4 (fun a b c m y => ρ a b c m y * X a y * Y b y * Z c y * W m y)
      (fun a b c m => ((((hρ a b c m).fun_mul (hX a)).fun_mul (hY b)).fun_mul (hZ c)).fun_mul (hW m))
    refine ⟨hP.1, fun l => ?_⟩
    have hPd : ∀ a b c m, pd2 l (fun y => ρ a b c m y * X a y * Y b y * Z c y * W m y) x =
        pd2 l (ρ a b c m) x * X a x * Y b x * Z c x * W m x +
        ρ a b c m x * pd2 l (X a) x * Y b x * Z c x * W m x +
        ρ a b c m x * X a x * pd2 l (Y b) x * Z c x * W m x +
        ρ a b c m x * X a x * Y b x * pd2 l (Z c) x * W m x +
        ρ a b c m x * X a x * Y b x * Z c x * pd2 l (W m) x := by
      intro a b c m
      rw [H1 l _ _ ((((hρ a b c m).fun_mul (hX a)).fun_mul (hY b)).fun_mul (hZ c)) (hW m),
        H1 l _ _ (((hρ a b c m).fun_mul (hX a)).fun_mul (hY b)) (hZ c),
        H1 l _ _ ((hρ a b c m).fun_mul (hX a)) (hY b),
        H1 l _ _ (hρ a b c m) (hX a)]
      ring
    have e1 := hP.2 l
    simp only [gsrF4]
    simp only [gsrF4] at e1
    rw [e1]
    simp only [hPd, Finset.sum_add_distrib]
  
  have hFd : DifferentiableAt ℝ F x := (hF.differentiableOn (by simp)).differentiableAt hxn
  have hwd : ∀ a b c m, DifferentiableAt ℝ (gsrRm G a b c m) (F x) := fun a b c m =>
    ((hRm a b c m).differentiableOn (by simp)).differentiableAt (hU.mem_nhds (hFU x hx))
  have hlin : ∀ (L : E3 →L[ℝ] ℝ) (v : E3), L v = ∑ r : Fin 3, L (e r) * v r := by
    intro L v
    have hv : v = ∑ r : Fin 3, v r • e r := by
      ext i
      simp [e, EuclideanSpace.single_apply, Pi.single_apply]
    conv_lhs => rw [hv]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [map_smul, smul_eq_mul, mul_comm]
  have hch : ∀ (l : Fin 2) (a b c m : Fin 3), pd2 l (fun y => gsrRm G a b c m (F y)) x =
      ∑ r : Fin 3, partialDeriv r (gsrRm G a b c m) (F x) * gsTan F l x r := by
    intro l a b c m
    unfold pd2
    rw [show (fun y => gsrRm G a b c m (F y)) = gsrRm G a b c m ∘ F from rfl,
      fderiv_comp x (hwd a b c m) hFd, ContinuousLinearMap.comp_apply, hlin]
    rfl
  
  have hcontract : ∀ (D : Fin 3 → Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (V X Y Z W : Fin 3 → ℝ),
      gsrF4 (fun a b c m => ∑ r : Fin 3, D r a b c m * V r) X Y Z W = gsrF5 D V X Y Z W := by
    intro D V X Y Z W
    simp only [gsrF4, gsrF5, Fin.sum_univ_three]
    ring
  
  have hρd : ∀ a b c m, DifferentiableAt ℝ (fun y => gsrRm G a b c m (F y)) x :=
    fun a b c m => (hwd a b c m).comp x hFd
  have hTd : ∀ (q : Fin 2) (a : Fin 3), DifferentiableAt ℝ (fun y => gsTan F q y a) x :=
    fun q a => ((htan q a).differentiableOn (by simp)).differentiableAt hxn
  have hNd : ∀ a, DifferentiableAt ℝ (fun y => gsrNu G F y a) x :=
    fun a => ((hν a).differentiableOn (by simp)).differentiableAt hxn
  have hL := fun k i j : Fin 2 => hLeib (fun a b c m y => gsrRm G a b c m (F y))
    (fun a y => gsTan F k y a) (fun a y => gsTan F i y a) (fun a y => gsTan F j y a)
    (fun a y => gsrNu G F y a) hρd (hTd k) (hTd i) (hTd j) hNd
  have hev : ∀ k i j : Fin 2, gsAmbCod G F k i j =ᶠ[𝓝 x] (fun y => gsrF4
      (fun a b c m => gsrRm G a b c m (F y)) (fun a => gsTan F k y a) (fun a => gsTan F i y a)
      (fun a => gsTan F j y a) (fun a => gsrNu G F y a)) :=
    fun k i j => Filter.eventually_of_mem hxn (fun y hy => hrep y hy k i j)
  refine ⟨fun k i j => (hL k i j).1.congr_of_eventuallyEq (hev k i j), fun l k i j => ?_⟩
  have h5a : pd2 l (gsAmbCod G F k i j) x = pd2 l (fun y => gsrF4
      (fun a b c m => gsrRm G a b c m (F y)) (fun a => gsTan F k y a) (fun a => gsTan F i y a)
      (fun a => gsTan F j y a) (fun a => gsrNu G F y a)) x := by
    unfold pd2
    rw [(hev k i j).fderiv_eq]
  rw [h5a, (hL k i j).2 l]
  simp only [hch l, htanD x hx, hcontract]

theorem gsr_cod_tensorial_alg (Γ : Fin 3 → Fin 3 → Fin 3 → ℝ) (RmA : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (dRmA DR : Fin 3 → Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (hDR : ∀ r a b c m : Fin 3, DR r a b c m = dRmA r a b c m - ∑ q : Fin 3, (Γ q r a * RmA q b c m + Γ q r b * RmA a q c m + Γ q r c * RmA a b q m + Γ q r m * RmA a b c q)) (D : Fin 2 → Fin 3 → ℝ) (A : Fin 2 → Fin 2 → Fin 3 → ℝ) (ν : Fin 3 → ℝ) (dν : Fin 2 → Fin 3 → ℝ) (Γ2 : Fin 2 → Fin 2 → Fin 2 → ℝ) (II : Fin 2 → Fin 2 → ℝ) (hi : Matrix (Fin 2) (Fin 2) ℝ) (hGauss : ∀ (l k : Fin 2) (e : Fin 3), A l k e + ∑ m : Fin 3, ∑ n : Fin 3, Γ e m n * D l m * D k n = ∑ m : Fin 2, Γ2 m l k * D m e + II l k * ν e) (hWein : ∀ (l : Fin 2) (e : Fin 3), dν l e = -(∑ r : Fin 3, ∑ q : Fin 3, Γ e r q * D l r * ν q) - ∑ a : Fin 2, ∑ b : Fin 2, hi a b * II l b * D a e) (T : Fin 2 → Fin 2 → Fin 2 → ℝ) (hT : ∀ k i j : Fin 2, T k i j = gsrF4 RmA (D k) (D i) (D j) ν) (dT : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) (hdT : ∀ l k i j : Fin 2, dT l k i j = gsrF5 dRmA (D l) (D k) (D i) (D j) ν + gsrF4 RmA (A l k) (D i) (D j) ν + gsrF4 RmA (D k) (A l i) (D j) ν + gsrF4 RmA (D k) (D i) (A l j) ν + gsrF4 RmA (D k) (D i) (D j) (dν l)) : ∀ l k i j : Fin 2, dT l k i j - ∑ m : Fin 2, Γ2 m l k * T m i j - ∑ m : Fin 2, Γ2 m l i * T k m j - ∑ m : Fin 2, Γ2 m l j * T k i m = gsrDT RmA DR D ν hi II l k i j :=
by
  
  have key : ∀ r a b c m : Fin 3, dRmA r a b c m = DR r a b c m +
      ((∑ q : Fin 3, Γ q r a * RmA q b c m) + (∑ q : Fin 3, Γ q r b * RmA a q c m) +
        (∑ q : Fin 3, Γ q r c * RmA a b q m) + (∑ q : Fin 3, Γ q r m * RmA a b c q)) := by
    intro r a b c m
    rw [hDR]
    simp only [Finset.sum_add_distrib]
    ring
  have s1 : ∀ V X Y Z W : Fin 3 → ℝ, gsrF5 dRmA V X Y Z W = gsrF5 DR V X Y Z W
      + gsrF4 RmA (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * X a) Y Z W
      + gsrF4 RmA X (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * Y a) Z W
      + gsrF4 RmA X Y (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * Z a) W
      + gsrF4 RmA X Y Z (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * W a) := by
    intro V X Y Z W
    have c1 : ∑ r : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ m : Fin 3,
        (∑ q : Fin 3, Γ q r a * RmA q b c m) * V r * X a * Y b * Z c * W m
        = gsrF4 RmA (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * X a) Y Z W := by
      simp only [gsrF4, Fin.sum_univ_three]
      ring
    have c2 : ∑ r : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ m : Fin 3,
        (∑ q : Fin 3, Γ q r b * RmA a q c m) * V r * X a * Y b * Z c * W m
        = gsrF4 RmA X (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * Y a) Z W := by
      simp only [gsrF4, Fin.sum_univ_three]
      ring
    have c3 : ∑ r : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ m : Fin 3,
        (∑ q : Fin 3, Γ q r c * RmA a b q m) * V r * X a * Y b * Z c * W m
        = gsrF4 RmA X Y (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * Z a) W := by
      simp only [gsrF4, Fin.sum_univ_three]
      ring
    have c4 : ∑ r : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ m : Fin 3,
        (∑ q : Fin 3, Γ q r m * RmA a b c q) * V r * X a * Y b * Z c * W m
        = gsrF4 RmA X Y Z (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * V r * W a) := by
      simp only [gsrF4, Fin.sum_univ_three]
      ring
    rw [← c1, ← c2, ← c3, ← c4]
    simp only [gsrF5, key, add_mul, Finset.sum_add_distrib, add_assoc]
  
  have g1 : ∀ (W' Q P X Y Z : Fin 3 → ℝ) (c : Fin 2 → ℝ) (t : ℝ),
      (∀ e : Fin 3, W' e + Q e = ∑ m : Fin 2, c m * D m e + t * P e) →
      gsrF4 RmA W' X Y Z = ∑ m : Fin 2, c m * gsrF4 RmA (D m) X Y Z + t * gsrF4 RmA P X Y Z
        - gsrF4 RmA Q X Y Z := by
    intro W' Q P X Y Z c t h
    have hW : W' = fun e => (∑ m : Fin 2, c m * D m e + t * P e) - Q e :=
      funext fun e => eq_sub_of_add_eq (h e)
    subst hW
    simp only [gsrF4, Fin.sum_univ_two, Fin.sum_univ_three]
    ring
  have g2 : ∀ (W' Q P X Y Z : Fin 3 → ℝ) (c : Fin 2 → ℝ) (t : ℝ),
      (∀ e : Fin 3, W' e + Q e = ∑ m : Fin 2, c m * D m e + t * P e) →
      gsrF4 RmA X W' Y Z = ∑ m : Fin 2, c m * gsrF4 RmA X (D m) Y Z + t * gsrF4 RmA X P Y Z
        - gsrF4 RmA X Q Y Z := by
    intro W' Q P X Y Z c t h
    have hW : W' = fun e => (∑ m : Fin 2, c m * D m e + t * P e) - Q e :=
      funext fun e => eq_sub_of_add_eq (h e)
    subst hW
    simp only [gsrF4, Fin.sum_univ_two, Fin.sum_univ_three]
    ring
  have g3 : ∀ (W' Q P X Y Z : Fin 3 → ℝ) (c : Fin 2 → ℝ) (t : ℝ),
      (∀ e : Fin 3, W' e + Q e = ∑ m : Fin 2, c m * D m e + t * P e) →
      gsrF4 RmA X Y W' Z = ∑ m : Fin 2, c m * gsrF4 RmA X Y (D m) Z + t * gsrF4 RmA X Y P Z
        - gsrF4 RmA X Y Q Z := by
    intro W' Q P X Y Z c t h
    have hW : W' = fun e => (∑ m : Fin 2, c m * D m e + t * P e) - Q e :=
      funext fun e => eq_sub_of_add_eq (h e)
    subst hW
    simp only [gsrF4, Fin.sum_univ_two, Fin.sum_univ_three]
    ring
  
  have g4 : ∀ (W' Q X Y Z : Fin 3 → ℝ) (h : Fin 2 → Fin 2 → ℝ),
      (∀ e : Fin 3, W' e = -Q e - ∑ a : Fin 2, ∑ b : Fin 2, h a b * D a e) →
      gsrF4 RmA X Y Z W' = -gsrF4 RmA X Y Z Q
        - ∑ a : Fin 2, ∑ b : Fin 2, h a b * gsrF4 RmA X Y Z (D a) := by
    intro W' Q X Y Z h hW'
    have hW : W' = fun e => -Q e - ∑ a : Fin 2, ∑ b : Fin 2, h a b * D a e := funext hW'
    subst hW
    simp only [gsrF4, Fin.sum_univ_two, Fin.sum_univ_three]
    ring
  
  intro l k i j
  have e1 := s1 (D l) (D k) (D i) (D j) ν
  have e2 := g1 (A l k) (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * D l r * D k a) ν
    (D i) (D j) ν (fun m => Γ2 m l k) (II l k) (fun e => hGauss l k e)
  have e3 := g2 (A l i) (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * D l r * D i a) ν
    (D k) (D j) ν (fun m => Γ2 m l i) (II l i) (fun e => hGauss l i e)
  have e4 := g3 (A l j) (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * D l r * D j a) ν
    (D k) (D i) ν (fun m => Γ2 m l j) (II l j) (fun e => hGauss l j e)
  have e5 := g4 (dν l) (fun q => ∑ r : Fin 3, ∑ a : Fin 3, Γ q r a * D l r * ν a)
    (D k) (D i) (D j) (fun a b => hi a b * II l b) (fun e => hWein l e)
  beta_reduce at e1 e2 e3 e4 e5
  rw [hdT l k i j]
  simp only [hT, gsrDT]
  linear_combination e1 + e2 + e3 + e4 + e5

theorem gsr_covD3_cod (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (F : E2 → E3) (s : Set E2) (hs : IsOpen s) (hF : ContDiffOn ℝ ∞ F s) (hFU : ∀ x ∈ s, F x ∈ U) (hinj : ∀ x ∈ s, Function.Injective (fderiv ℝ F x)) : ∀ x ∈ s, (∀ k i j : Fin 2, DifferentiableAt ℝ (gsAmbCod G F k i j) x) ∧ ∀ l k i j : Fin 2, gsCovD3 (pullMetric2 G F) (gsAmbCod G F) l k i j x = gsrDT (fun a b c m => gsrRm G a b c m (F x)) (fun r a b c m => gsrDRm G r a b c m (F x)) (fun p a => gsTan F p x a) (gsrNu G F x) (pullMetric2 G F x)⁻¹ (fun p q => gsSff G F p q x) l k i j :=
by
  intro x hx
  
  have hcompat : ∀ y ∈ U, ∀ r a b : Fin 3, partialDeriv r (fun z => G z a b) y =
      ∑ e : Fin 3, (G y a e * christoffel G e r b y + G y b e * christoffel G e r a y) := by
    intro y hy r a b
    have hinv : G y * (G y)⁻¹ = 1 :=
      Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr (hGpos y hy).det_pos.ne')
    have hX : ∀ (X : Fin 3 → ℝ) (a : Fin 3),
        ∑ e : Fin 3, G y a e * ∑ l : Fin 3, (G y)⁻¹ e l * X l = X a := by
      intro X a
      have h1 : (G y).mulVec ((G y)⁻¹.mulVec X) = X := by
        rw [Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]
      have h2 := congrFun h1 a
      simpa only [Matrix.mulVec, dotProduct] using h2
    have hA : ∀ a r b : Fin 3, ∑ e : Fin 3, G y a e * christoffel G e r b y =
        (1 / 2 : ℝ) * (partialDeriv r (fun z => G z b a) y + partialDeriv b (fun z => G z r a) y
          - partialDeriv a (fun z => G z r b) y) := by
      intro a r b
      have h := hX (fun l => partialDeriv r (fun z => G z b l) y +
        partialDeriv b (fun z => G z r l) y - partialDeriv l (fun z => G z r b) y) a
      rw [← h, Finset.mul_sum]
      refine Finset.sum_congr rfl fun e _ => ?_
      unfold christoffel
      ring
    rw [Finset.sum_add_distrib, hA a r b, hA b r a,
      show (fun z => G z b a) = (fun z => G z a b) from funext fun z => hGsymm z b a]
    ring
  
  have hGWalg : ∀ (Gm : Matrix (Fin 3) (Fin 3) ℝ) (_hGs : ∀ a b : Fin 3, Gm a b = Gm b a)
      (D : Fin 2 → Fin 3 → ℝ) (ν : Fin 3 → ℝ) (hi : Matrix (Fin 2) (Fin 2) ℝ)
      (_hdec : ∀ (P : Fin 3 → ℝ) (e : Fin 3), P e = ∑ a : Fin 2, ∑ b : Fin 2, hi a b *
        (∑ c : Fin 3, ∑ d : Fin 3, D b c * Gm c d * P d) * D a e +
        (∑ c : Fin 3, ∑ d : Fin 3, ν c * Gm c d * P d) * ν e)
      (V : Fin 2 → Fin 2 → Fin 3 → ℝ) (Γ1 : Fin 2 → Fin 2 → Fin 2 → ℝ) (II : Fin 2 → Fin 2 → ℝ)
      (_hKos : ∀ m l k : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, D m c * Gm c d * V l k d = Γ1 m l k)
      (_hnor : ∀ l k : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, ν c * Gm c d * V l k d = II l k)
      (W : Fin 2 → Fin 3 → ℝ)
      (_hW1 : ∀ l i : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, W l a * Gm a b * D i b =
        -∑ a : Fin 3, ∑ b : Fin 3, ν a * Gm a b * V l i b)
      (_hW2 : ∀ l : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3, W l a * Gm a b * ν b = 0),
      (∀ (l k : Fin 2) (e : Fin 3), V l k e =
        ∑ m : Fin 2, (∑ b : Fin 2, hi m b * Γ1 b l k) * D m e + II l k * ν e) ∧
      ∀ (l : Fin 2) (e : Fin 3), W l e = -∑ a : Fin 2, ∑ b : Fin 2, hi a b * II l b * D a e := by
    intro Gm hGs D ν hi hdec V Γ1 II hKos hnor W hW1 hW2
    constructor
    · intro l k e
      rw [hdec (V l k) e]
      simp only [hKos, hnor]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [Finset.sum_mul]
    · intro l e
      have h1 : ∀ b : Fin 2, ∑ c : Fin 3, ∑ d : Fin 3, D b c * Gm c d * W l d = -II l b := by
        intro b
        rw [← hnor l b, ← hW1 l b, Finset.sum_comm]
        refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun c _ => ?_
        rw [hGs c d]
        ring
      have h2 : ∑ c : Fin 3, ∑ d : Fin 3, ν c * Gm c d * W l d = 0 := by
        rw [← hW2 l, Finset.sum_comm]
        refine Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun c _ => ?_
        rw [hGs c d]
        ring
      rw [hdec (W l) e]
      simp only [h1, h2, mul_neg, neg_mul, Finset.sum_neg_distrib, zero_mul, add_zero]
  
  have hGinv := ginv_contDiffOn G U hG hGpos
  have hRm := (gsr_curv_contDiffOn G U hU hG hGinv).2
  obtain ⟨J1, J2, -, -, J5, -⟩ := gc_jets G U hU hG hGsymm hGpos F s hs hF hFU hinj
  have hν : ∀ e : Fin 3, ContDiffOn ℝ ∞ (fun y => gsrNu G F y e) s := fun e => J5 e
  have halg := fun y (hy : y ∈ s) =>
    gsr_nu_alg G F y (hGsymm (F y)) (hGpos _ (hFU y hy)) (hinj y hy)
  obtain ⟨hdiff, hder⟩ := gsr_cod_deriv G U hU F s hs hF hFU hRm J1 J2 hν
    (fun y hy => (halg y hy).2.2.2.2.2) x hx
  refine ⟨hdiff, fun l k i j => ?_⟩
  have hrel := gsr_nu_deriv_relations G U hU hG hGsymm hcompat F s hs hF hFU J1 J2 hν
    (fun y hy => (halg y hy).2.1) (fun y hy => (halg y hy).2.2.1) x hx
  have hkos := gge_koszul_tangent G U hU hG hGsymm hGpos F s hs hF hFU x hx
  have hGW := hGWalg (G (F x)) (hGsymm (F x)) (fun p a => gsTan F p x a) (gsrNu G F x)
    (pullMetric2 G F x)⁻¹ (halg x hx).2.2.2.1 (fun l k e => gsCovHess G F l k x e)
    (fun m l k => ggeGam1 (pullMetric2 G F) m l k x) (fun p q => gsSff G F p q x)
    (fun m l k => (hkos m l k).symm) (halg x hx).2.2.2.2.1
    (fun l e => pd2 l (fun y => gsrNu G F y e) x + ∑ r : Fin 3, ∑ q : Fin 3,
      christoffel G e r q (F x) * gsTan F l x r * gsrNu G F x q)
    (fun l i => (hrel l).1 i) (fun l => (hrel l).2)
  have hΓ2 : ∀ m l k : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ m b *
      ggeGam1 (pullMetric2 G F) b l k x = christoffel2 (pullMetric2 G F) m l k x := by
    intro m l k
    rw [christoffel2, Finset.mul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [ggeGam1]
    ring
  have hGauss : ∀ (l k : Fin 2) (e : Fin 3), gsHessF F l k x e +
      ∑ m : Fin 3, ∑ n : Fin 3, christoffel G e m n (F x) * gsTan F l x m * gsTan F k x n =
      ∑ m : Fin 2, christoffel2 (pullMetric2 G F) m l k x * gsTan F m x e +
        gsSff G F l k x * gsrNu G F x e := by
    intro l k e
    have h : gsCovHess G F l k x e = ∑ m : Fin 2, (∑ b : Fin 2, (pullMetric2 G F x)⁻¹ m b *
        ggeGam1 (pullMetric2 G F) b l k x) * gsTan F m x e + gsSff G F l k x * gsrNu G F x e :=
      hGW.1 l k e
    have h' : gsHessF F l k x e + ∑ m : Fin 3, ∑ n : Fin 3,
        christoffel G e m n (F x) * gsTan F l x m * gsTan F k x n = gsCovHess G F l k x e := rfl
    rw [h', h]
    simp only [hΓ2]
  have hWein : ∀ (l : Fin 2) (e : Fin 3), pd2 l (fun y => gsrNu G F y e) x =
      -(∑ r : Fin 3, ∑ q : Fin 3, christoffel G e r q (F x) * gsTan F l x r * gsrNu G F x q) -
        ∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b * gsSff G F l b x * gsTan F a x e := by
    intro l e
    have h : pd2 l (fun y => gsrNu G F y e) x + ∑ r : Fin 3, ∑ q : Fin 3,
        christoffel G e r q (F x) * gsTan F l x r * gsrNu G F x q =
        -∑ a : Fin 2, ∑ b : Fin 2, (pullMetric2 G F x)⁻¹ a b * gsSff G F l b x * gsTan F a x e :=
      hGW.2 l e
    linear_combination h
  have hDR : ∀ r a b c m : Fin 3, gsrDRm G r a b c m (F x) =
      partialDeriv r (gsrRm G a b c m) (F x) - ∑ q : Fin 3,
        (christoffel G q r a (F x) * gsrRm G q b c m (F x) +
          christoffel G q r b (F x) * gsrRm G a q c m (F x) +
          christoffel G q r c (F x) * gsrRm G a b q m (F x) +
          christoffel G q r m (F x) * gsrRm G a b c q (F x)) := by
    intro r a b c m
    rw [gsrDRm]
  have key := gsr_cod_tensorial_alg (fun q a b => christoffel G q a b (F x))
    (fun a b c m => gsrRm G a b c m (F x)) (fun r a b c m => partialDeriv r (gsrRm G a b c m) (F x))
    (fun r a b c m => gsrDRm G r a b c m (F x)) hDR
    (fun p a => gsTan F p x a) (fun l k a => gsHessF F l k x a) (gsrNu G F x)
    (fun l m => pd2 l (fun y => gsrNu G F y m) x)
    (fun m l k => christoffel2 (pullMetric2 G F) m l k x) (fun p q => gsSff G F p q x)
    (pullMetric2 G F x)⁻¹ hGauss hWein (fun k i j => gsAmbCod G F k i j x)
    (halg x hx).2.2.2.2.2 (fun l k i j => pd2 l (gsAmbCod G F k i j) x) hder l k i j
  rw [gsCovD3]
  exact key

theorem gs_simons_remainder_bound (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hGsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hGpos : ∀ y ∈ U, (G y).PosDef) (B : Set E3) (hB : IsCompact B) (hBU : B ⊆ U) : ∃ c₁ c₂ : ℝ, 0 ≤ c₁ ∧ 0 ≤ c₂ ∧ ∀ (F : E2 → E3) (s : Set E2), IsOpen s → ContDiffOn ℝ ∞ F s → (∀ x ∈ s, F x ∈ U) → (∀ x ∈ s, Function.Injective (fderiv ℝ F x)) → ∀ x ∈ s, F x ∈ B → |gsInner (pullMetric2 G F) (gsSff G F) (gsSimonsE (pullMetric2 G F) (gsAmbCod G F)) x| ≤ c₁ * Real.sqrt (gsSffSq G F x) + c₂ * gsSffSq G F x :=
by
  have hGinv := ginv_contDiffOn G U hG hGpos
  obtain ⟨hΓ, hRm⟩ := gsr_curv_contDiffOn G U hU hG hGinv
  obtain ⟨A₀, A₁, hA₀, hA₁, hbd⟩ := gsr_curv_bounds G U hU hG hGpos hΓ hRm B hB hBU
  refine ⟨16 * A₁, 80 * A₀, by positivity, by positivity, ?_⟩
  intro F s hs hF hFU hinj x hx hxB
  obtain ⟨hh, hhsymm, hhpos, -, -, -, -⟩ :=
    gs_regularity G U hU hG hGsymm hGpos F s hs hF hFU hinj
  obtain ⟨hdiff, hcov⟩ := gsr_covD3_cod G U hU hG hGsymm hGpos F s hs hF hFU hinj x hx
  have hE : ∀ a b : Fin 2, gsSimonsE (pullMetric2 G F) (gsAmbCod G F) a b x =
      gsrE (fun a b c m => gsrRm G a b c m (F x)) (fun r a b c m => gsrDRm G r a b c m (F x))
        (fun p a => gsTan F p x a) (gsrNu G F x) (pullMetric2 G F x)⁻¹
        (fun p q => gsSff G F p q x) a b := by
    intro a b
    rw [gsr_simonsE_contract (pullMetric2 G F) s hs hh hhsymm hhpos (gsAmbCod G F) x hx hdiff a b]
    simp only [hcov, gsrE]
  have hI : gsInner (pullMetric2 G F) (gsSff G F) (gsSimonsE (pullMetric2 G F) (gsAmbCod G F)) x =
      ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
        (pullMetric2 G F x)⁻¹ i a * (pullMetric2 G F x)⁻¹ j b * gsSff G F i j x *
          gsrE (fun a b c m => gsrRm G a b c m (F x)) (fun r a b c m => gsrDRm G r a b c m (F x))
            (fun p a => gsTan F p x a) (gsrNu G F x) (pullMetric2 G F x)⁻¹
            (fun p q => gsSff G F p q x) a b := by
    unfold gsInner
    simp only [hE]
  have hS : gsSffSq G F x =
      ∑ i : Fin 2, ∑ j : Fin 2, ∑ a : Fin 2, ∑ b : Fin 2,
        (pullMetric2 G F x)⁻¹ i a * (pullMetric2 G F x)⁻¹ j b * gsSff G F i j x *
          gsSff G F a b x := rfl
  have hframe : ∀ (hm : Matrix (Fin 2) (Fin 2) ℝ), (∀ i j : Fin 2, hm i j = hm j i) → hm.PosDef →
      ∃ L : Matrix (Fin 2) (Fin 2) ℝ, (∀ i j : Fin 2, hm⁻¹ i j = ∑ t : Fin 2, L i t * L j t) ∧
        ∀ c d : Fin 2, ∑ i : Fin 2, ∑ j : Fin 2, L i c * hm i j * L j d =
          if c = d then 1 else 0 := by
    intro hm hsymm hpos
    obtain ⟨p, q, r, rfl⟩ : ∃ p q r : ℝ, hm = !![p, q; q, r] :=
      ⟨hm 0 0, hm 0 1, hm 1 1, by
        ext i j; fin_cases i <;> fin_cases j <;> simp [hsymm 1 0]⟩
    have hp : 0 < p := by simpa using hpos.diag_pos (i := 0)
    have hdet : 0 < p * r - q * q := by
      have := hpos.det_pos
      rwa [Matrix.det_fin_two_of] at this
    set δ := p * r - q * q with hδ
    have hinv : (!![p, q; q, r] : Matrix (Fin 2) (Fin 2) ℝ)⁻¹ = δ⁻¹ • !![r, -q; -q, p] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two_of, Matrix.det_fin_two_of, Ring.inverse_eq_inv']
    have hsp := Real.sq_sqrt hp.le
    have hsd := Real.sq_sqrt hdet.le
    have hsp0 : 0 < Real.sqrt p := Real.sqrt_pos.mpr hp
    have hsd0 : 0 < Real.sqrt δ := Real.sqrt_pos.mpr hdet
    set a := Real.sqrt p with ha
    set d := Real.sqrt δ with hd
    refine ⟨!![1 / a, -q / (a * d); 0, a / d], ?_, ?_⟩
    · intro i j
      rw [hinv]
      fin_cases i <;> fin_cases j <;>
        simp [Fin.sum_univ_two] <;> field_simp <;> (try simp only [hsp, hsd, hδ]) <;> ring_nf
    · intro c e
      fin_cases c <;> fin_cases e <;>
        simp [Fin.sum_univ_two] <;> field_simp <;> (try simp only [hsp, hsd, hδ]) <;> ring_nf
  obtain ⟨L, hL1, hL2⟩ := hframe (pullMetric2 G F x) (hhsymm x hx) (hhpos x hx)
  have halg := gsr_nu_alg G F x (hGsymm (F x)) (hGpos _ (hFU x hx)) (hinj x hx)
  have hunit : ∀ c : Fin 2, ∑ a : Fin 3, ∑ b : Fin 3,
      (∑ i : Fin 2, L i c * gsTan F i x a) * G (F x) a b * (∑ i : Fin 2, L i c * gsTan F i x b)
        ≤ 1 := by
    intro c
    have h1 : ∑ a : Fin 3, ∑ b : Fin 3,
        (∑ i : Fin 2, L i c * gsTan F i x a) * G (F x) a b * (∑ i : Fin 2, L i c * gsTan F i x b)
          = ∑ i : Fin 2, ∑ j : Fin 2, L i c * pullMetric2 G F x i j * L j c := by
      simp only [pullMetric2, gsTan, Fin.sum_univ_two, Fin.sum_univ_three]
      ring
    rw [h1, hL2 c c, if_pos rfl]
  rw [hI, hS]
  exact gsr_frame_estimate (G (F x)) (fun p a => gsTan F p x a) (gsrNu G F x) L
    (pullMetric2 G F x)⁻¹ (fun a b c m => gsrRm G a b c m (F x))
    (fun r a b c m => gsrDRm G r a b c m (F x)) (fun p q => gsSff G F p q x) A₀ A₁ hA₀ hA₁
    hL1 hunit (le_of_eq halg.2.2.1) (hbd (F x) hxB).1 (hbd (F x) hxB).2

theorem pullback_gauss_simons [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (z : M) (r : ℝ) (hr : 0 < r) (hball : Metric.closedBall (chartAt E3 z z) (4 * r) ⊆ (chartAt E3 z).target) : ∃ k₀ C₁ C₂ : ℝ, 0 ≤ k₀ ∧ 0 ≤ C₁ ∧ 0 ≤ C₂ ∧ ∀ Sig : Set M, IsMinimalSurfaceSet g Sig → ∀ (ρ : ℝ) (F : E2 → E3), ContDiffOn ℝ ∞ F (Metric.ball 0 ρ) → (∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.ball (chartAt E3 z z) (2 * r) ∧ (chartAt E3 z).symm (F x) ∈ Sig ∧ Function.Injective (fderiv ℝ F x)) → ∃ a : E2 → ℝ, ContDiffOn ℝ 2 a (Metric.ball 0 ρ) ∧ ∀ x ∈ Metric.ball (0 : E2) ρ, IsSurfA2At g Sig (chartAt E3 z) ((chartAt E3 z).symm (F x)) (a x) ∧ 0 ≤ a x ∧ -(a x) / 2 - k₀ ≤ gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) x ∧ gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) x ≤ k₀ ∧ -2 * (a x) ^ 2 - C₁ * a x - C₂ * Real.sqrt (a x) ≤ lap2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F) a x :=
by
  classical
  
  have hU : IsOpen (chartAt E3 z).target := (chartAt E3 z).open_target
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 z).symm y i j)
      (chartAt E3 z).target := fun i j => g.smooth z i j
  have hGsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 z).symm y i j = g.coeff (chartAt E3 z).symm y j i :=
    fun y i j => g.symm _ _ _
  have hGpos : ∀ y ∈ (chartAt E3 z).target, (g.coeff (chartAt E3 z).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y hy
  have hB : IsCompact (Metric.closedBall (chartAt E3 z z) (2 * r)) := isCompact_closedBall _ _
  have hBU : Metric.closedBall (chartAt E3 z z) (2 * r) ⊆ (chartAt E3 z).target :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hball
  obtain ⟨K₀, hK₀, hamb⟩ := gs_amb_plane_bound _ _ hU hGs hGsymm hGpos _ hB hBU
  obtain ⟨c₁, c₂, hc₁, hc₂, hrem⟩ :=
    gs_simons_remainder_bound _ _ hU hGs hGsymm hGpos _ hB hBU
  refine ⟨K₀, 4 * K₀ + 2 * c₂, 2 * c₁, hK₀, by positivity, by positivity, ?_⟩
  
  intro Sig hSig ρ F hF hFx
  have hs : IsOpen (Metric.ball (0 : E2) ρ) := Metric.isOpen_ball
  have hFB : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ Metric.closedBall (chartAt E3 z z) (2 * r) :=
    fun x hx => Metric.ball_subset_closedBall (hFx x hx).1
  have hFU : ∀ x ∈ Metric.ball (0 : E2) ρ, F x ∈ (chartAt E3 z).target :=
    fun x hx => hBU (hFB x hx)
  have hinj : ∀ x ∈ Metric.ball (0 : E2) ρ, Function.Injective (fderiv ℝ F x) :=
    fun x hx => (hFx x hx).2.2
  obtain ⟨hh, hhsymm, hhpos, hS, hSsymm, ha, ha0⟩ :=
    gs_regularity _ _ hU hGs hGsymm hGpos F _ hs hF hFU hinj
  
  have hkey : ∀ x ∈ Metric.ball (0 : E2) ρ, ∀ (V : Set M) (f : M → ℝ), IsOpen V →
      (chartAt E3 z).symm (F x) ∈ V → V ⊆ (chartAt E3 z).source →
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f → (∀ y ∈ V, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) f y ≠ 0) →
      V ∩ Sig = V ∩ f ⁻¹' {0} →
      secondFundSq (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y)) (F x) =
          gsSffSq (g.coeff (chartAt E3 z).symm) F x ∧
        (levelMeanCurvCoord (g.coeff (chartAt E3 z).symm) (fun y => f ((chartAt E3 z).symm y))
            (F x) = 0 ↔ gsMeanCurv (g.coeff (chartAt E3 z).symm) F x = 0) := by
    intro x hx V f hV hpV hVs hf hdf hVS
    have hpsrc : (chartAt E3 z).symm (F x) ∈ (chartAt E3 z).source :=
      (chartAt E3 z).map_target (hFU x hx)
    have hκp : chartAt E3 z ((chartAt E3 z).symm (F x)) = F x :=
      (chartAt E3 z).right_inv (hFU x hx)
    have hcm : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ (chartAt E3 z).symm) (chartAt E3 z).target :=
      hf.comp_contMDiffOn contMDiffOn_chart_symm
    have hcd : ContDiffOn ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (chartAt E3 z).target :=
      contMDiffOn_iff_contDiffOn.mp hcm
    have hcda : ContDiffAt ℝ ∞ (fun y => f ((chartAt E3 z).symm y)) (F x) :=
