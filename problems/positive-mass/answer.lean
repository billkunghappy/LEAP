      · rw [hw0 _ (by linarith), mul_zero]
      · rw [hw1 _ (by linarith), mul_zero]
    have hcs : HasCompactSupport (fun y : E3 => Φ y * deriv Real.smoothTransition (‖y‖ - c)) := by
