              + (Real.sqrt (h y).det * (h y)⁻¹ i 1) * pd2 1 φ y := by
        funext y; rw [Fin.sum_univ_two]; ring
      have hD : HasFDerivAt (fun y => (Real.sqrt (h y).det * (h y)⁻¹ i 0) * pd2 0 φ y
              + (Real.sqrt (h y).det * (h y)⁻¹ i 1) * pd2 1 φ y)
          ((Real.sqrt (h x).det * (h x)⁻¹ i 0) • fderiv ℝ (pd2 0 φ) x
            + pd2 0 φ x • fderiv ℝ (fun y => Real.sqrt (h y).det * (h y)⁻¹ i 0) x
            + ((Real.sqrt (h x).det * (h x)⁻¹ i 1) • fderiv ℝ (pd2 1 φ) x
            + pd2 1 φ x • fderiv ℝ (fun y => Real.sqrt (h y).det * (h y)⁻¹ i 1) x)) x :=
        ((hmd i 0).mul (hg 0)).add ((hmd i 1).mul (hg 1))
      rw [hfun, pd2_of _ _ i hD]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rfl
    have hc0 := hcc x hx 0
    have hc1 := hcc x hx 1
    simp only [Fin.sum_univ_two] at hc0 hc1
    rw [Fin.sum_univ_two, hpd 0, hpd 1]
    simp only [lap2, Fin.sum_univ_two]
    linear_combination (-(pd2 0 φ x)) * hc0 + (-(pd2 1 φ x)) * hc1
  
  have cutoff_mul_contDiff : ∀ (ρ r : ℝ) (Ψ G : E2 → ℝ) (hr : r < ρ) (hΨ : ContDiff ℝ 1 Ψ) (hΨr : ∀ x : E2, r ≤ ‖x‖ → Ψ x = 0) (hG : ContDiffOn ℝ 1 G (Metric.ball 0 ρ)), ∃ F : E2 → ℝ, ContDiff ℝ 1 F ∧ (∀ x : E2, r ≤ ‖x‖ → F x = 0) ∧ (∀ x ∈ Metric.ball (0 : E2) ρ, ∀ i : Fin 2, pd2 i F x = pd2 i Ψ x * G x + Ψ x * pd2 i G x) ∧ (∀ x : E2, ρ ≤ ‖x‖ → ∀ i : Fin 2, pd2 i F x = 0) := by
    intro ρ r Ψ G hr hΨ hΨr hG
