    have hr2 : r ^ 2 = q := Real.sq_sqrt hq.le
    have hw : ∀ i, ∑ j : Fin 3, A i j * (∑ k : Fin 3, A⁻¹ j k * ζ k) = ζ i := by
      intro i
      have h := congrFun (show Matrix.mulVec A (Matrix.mulVec A⁻¹ ζ) = ζ by
        rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.2 hA.det_pos.ne'),
          Matrix.one_mulVec]) i
      exact h
    have hsum : ∑ i : Fin 3, ∑ j : Fin 3, A i j * (t * ((∑ k : Fin 3, A⁻¹ i k * ζ k) / r)) *
        (t * ((∑ k : Fin 3, A⁻¹ j k * ζ k) / r)) =
        (t / r) ^ 2 * ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * ζ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← hw i, Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    have hq' : ∑ i : Fin 3, (∑ k : Fin 3, A⁻¹ i k * ζ k) * ζ i = q := by
      rw [hqdef]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      ring
    rw [hsum, hq', div_pow, hr2, div_mul_cancel₀ _ hq.ne']
    nlinarith
  have hXB : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1 := by
    intro y
    by_cases hy : y ∈ U
    · simp only [hXi]
      exact hunit (G y) (hpd y hy) (ζ y) (hζ0 y) (χ y) (hχ01 y).1 (hχ01 y).2
    · have h0 : χ y = 0 := image_eq_zero_of_notMem_tsupport (fun hm => hy (hχU hm))
      simp [hXi, h0]
  
  have hstar : ∀ x, s x ≤ ρ ^ 2 →
      χ (smthLift a x (v x)) * smthLag G a (x, v x, smthGrad v x) - η ≤
        ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det * X (smthLift a x (v x)) i *
          smthCovec a (smthGrad v x) i := by
    intro x hx
    have hxU := hzU x hx
    have hd : ∀ i, |ζ (smthLift a x (v x)) i - smthCovec a (smthGrad v x) i| ≤ δ := by
      intro i
      rw [hζz]
      rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
      · simp [smthCovec, hδ.le]
      · simp only [smthCovec, Fin.insertNth_apply_succAbove, Pi.neg_apply]
        rw [neg_sub_neg, abs_sub_comm]
        exact hPk x k
    have hlow := smth_conormal_lower (G (smthLift a x (v x))) (hpd _ hxU)
      (ζ (smthLift a x (v x))) (smthCovec a (smthGrad v x)) (hζ0 _) δ CA
      (G (smthLift a x (v x))).det Cg η (χ (smthLift a x (v x))) hδ.le (hCAb x hx) hd
      (hCgb x hx) hδη (hχ01 _).1 (hχ01 _).2
    simp only [hXi]
    exact hlow
  
  have hr2 : r₁ ^ 2 < ρ ^ 2 := by nlinarith
  refine ⟨X, ⟨hXs, hXc, hXV, hXB⟩, ?_, ?_⟩
  · intro x hx
    have hxs : s x < r₁ ^ 2 := by rw [hs]; exact hx
    have hxK : s x ≤ ρ ^ 2 := by linarith
    have h1 := hstar x hxK
    have hχ1' : χ (smthLift a x (v x)) = 1 := by
      apply hχ1
      · simp only [hLs]
        exact le_of_lt hx
      · rw [hLa]
        exact hbound x hxK
    rw [hχ1', one_mul] at h1
    exact h1
  · intro x hx
    have hxK : s x ≤ ρ ^ 2 := le_of_lt (by rw [hs]; exact hx)
    have h1 := hstar x hxK
    have hL : 0 ≤ smthLag G a (x, v x, smthGrad v x) :=
      mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
    have h2 := mul_nonneg (hχ01 (smthLift a x (v x))).1 hL
    linarith

theorem smth_subgraph_perimeter (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (a : Fin 3) (c : E3) (ρ h : ℝ) (hρ : 0 < ρ) (hh : 0 < h)
    (hcl : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ≤ ρ → |z a - c a| ≤ h → z ∈ U)
    (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v)
    (hin : ∀ x : Fin 2 → ℝ, ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 ≤ ρ ^ 2 →
      |v x - c a| < h) :
    sepPerG G {z : E3 | z a < v (smthHoriz a z)} (sepCyl a c ρ h) =
      ENNReal.ofReal (∫ x in smthDisc a c ρ, smthLag G a (x, v x, smthGrad v x)) :=
by
  classical
  
  have hLa : ∀ (x : Fin 2 → ℝ) (t : ℝ), (smthLift a x t) a = t := by
    intro x t
    simp [smthLift]
  have hLs : ∀ (x : Fin 2 → ℝ) (t : ℝ) (k : Fin 2), (smthLift a x t) (a.succAbove k) = x k := by
    intro x t k
    simp [smthLift]
  have hHL : ∀ (x : Fin 2 → ℝ) (t : ℝ), smthHoriz a (smthLift a x t) = x := by
    intro x t; funext k; exact hLs x t k
  have hPa : ∀ w : E3, (sepPlaneProj a w) a = 0 := by
    intro w; simp [sepPlaneProj]
  have hPs : ∀ (w : E3) (k : Fin 2), (sepPlaneProj a w) (a.succAbove k) = w (a.succAbove k) := by
    intro w k; simp [sepPlaneProj]
  have hnormsq : ∀ w : E3, ‖w‖ ^ 2 = w a ^ 2 + ∑ k : Fin 2, w (a.succAbove k) ^ 2 := by
    intro w
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_succAbove (fun i => ‖w i‖ ^ 2) a]
    simp [Real.norm_eq_abs, sq_abs]
  have hGc : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ^ 2 =
      ∑ k : Fin 2, (smthHoriz a z k - c (a.succAbove k)) ^ 2 := by
    intro z
    rw [hnormsq, hPa]
    simp only [hPs, smthHoriz]
    simp
  
  obtain ⟨s, hs⟩ : ∃ s : (Fin 2 → ℝ) → ℝ, ∀ x, s x = ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  have hsfun : s = fun x => ∑ k : Fin 2, (x k - c (a.succAbove k)) ^ 2 := funext hs
  have hscont : Continuous s := by
    rw [hsfun]; fun_prop
  have hsGc : ∀ z : E3, ‖sepPlaneProj a (z - c)‖ ^ 2 = s (smthHoriz a z) := by
    intro z; rw [hs]; exact hGc z
  have hDmem : ∀ (r : ℝ) (x : Fin 2 → ℝ), x ∈ smthDisc a c r ↔ s x < r ^ 2 := by
    intro r x
    rw [hs]; exact Iff.rfl
  have hDo : IsOpen (smthDisc a c ρ) := by
    have : smthDisc a c ρ = {x | s x < ρ ^ 2} := by
      ext x; exact hDmem ρ x
    rw [this]; exact isOpen_lt hscont continuous_const
  have hDm : ∀ r : ℝ, MeasurableSet (smthDisc a c r) := by
    intro r
    have : smthDisc a c r = {x | s x < r ^ 2} := by
      ext x; exact hDmem r x
    rw [this]; exact (isOpen_lt hscont continuous_const).measurableSet
  
  have hGe : ∀ x, s x ≤ ρ ^ 2 → dist x (smthHoriz a c) ≤ ρ := by
    intro x hx
    refine (dist_pi_le_iff hρ.le).2 (fun k => ?_)
    rw [Real.dist_eq]
    rw [hs] at hx
    have hk : (x k - c (a.succAbove k)) ^ 2 ≤ ρ ^ 2 :=
      le_trans (Finset.single_le_sum (f := fun k => (x k - c (a.succAbove k)) ^ 2)
        (fun _ _ => sq_nonneg _) (Finset.mem_univ k)) hx
    exact (sq_le_sq.1 hk).trans_eq (abs_of_pos hρ)
  have hKd : IsCompact {x : Fin 2 → ℝ | s x ≤ ρ ^ 2} := by
    refine Metric.isCompact_of_isClosed_isBounded (isClosed_le hscont continuous_const) ?_
    exact (Metric.isBounded_closedBall (x := smthHoriz a c) (r := ρ)).subset
      (fun x hx => Metric.mem_closedBall.2 (hGe x hx))
  have hDsub : smthDisc a c ρ ⊆ {x : Fin 2 → ℝ | s x ≤ ρ ^ 2} :=
    fun x hx => le_of_lt ((hDmem ρ x).1 hx)
  
  have hzU : ∀ x ∈ {x : Fin 2 → ℝ | s x ≤ ρ ^ 2}, smthLift a x (v x) ∈ U := by
    intro x hx
    have hx' : s x ≤ ρ ^ 2 := hx
    refine hcl _ ?_ ?_
    · have e1 := hsGc (smthLift a x (v x))
      rw [hHL] at e1
      nlinarith [norm_nonneg (sepPlaneProj a (smthLift a x (v x) - c))]
    · rw [hLa]
      have hx'' := hx'
      rw [hs] at hx''
      exact (hin x hx'').le
  
  have hVD : ∀ x, smthLift a x (v x) ∈ sepCyl a c ρ h → x ∈ smthDisc a c ρ := by
    intro x hx
    rw [hDmem]
    have e1 := hsGc (smthLift a x (v x))
    rw [hHL] at e1
    have h1 : ‖sepPlaneProj a (smthLift a x (v x) - c)‖ < ρ := hx.1
    nlinarith [norm_nonneg (sepPlaneProj a (smthLift a x (v x) - c))]
  
  have hVU : sepCyl a c ρ h ⊆ U := fun z hz => hcl z hz.1.le hz.2.le
  
  have hliftc : Continuous (fun x : Fin 2 → ℝ => smthLift a x (v x)) := by
    have hins : Continuous (fun x : Fin 2 → ℝ => (Fin.insertNth a (v x) x : Fin 3 → ℝ)) := by
      refine continuous_pi (fun i => ?_)
      rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
      · simp only [Fin.insertNth_apply_same]
        exact hv.continuous
      · simp only [Fin.insertNth_apply_succAbove]
        exact continuous_apply k
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.continuous.comp hins
  have hgc : Continuous (smthGrad v) := by
    refine continuous_pi (fun k => ?_)
    exact (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hcovc : Continuous (smthCovec a) := by
    refine continuous_pi (fun i => ?_)
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · simp only [smthCovec, Fin.insertNth_apply_same]
      exact continuous_const
    · simp only [smthCovec, Fin.insertNth_apply_succAbove]
      exact (continuous_apply k).neg
  have hξc : ∀ i : Fin 3, Continuous (fun x => smthCovec a (smthGrad v x) i) :=
    fun i => (continuous_apply i).comp (hcovc.comp hgc)
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  
  have hflux : ∀ X : E3 → E3, (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
      tsupport X ⊆ sepCyl a c ρ h ∧
      ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
      (∫ y in {z : E3 | z a < v (smthHoriz a z)}, sepDensDiv G X y) =
        (∫ x in smthDisc a c ρ, ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det *
          X (smthLift a x (v x)) i * smthCovec a (smthGrad v x) i) ∧
      IntegrableOn (fun x => ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det *
          X (smthLift a x (v x)) i * smthCovec a (smthGrad v x) i) (smthDisc a c ρ) := by
    intro X hX
    have hXU : tsupport X ⊆ U := hX.2.2.1.trans hVU
    have hZ := fun i => smth_density_contDiff G U hU hG hpd X hX.1 hX.2.1 hXU i
    have hGG := smth_gauss_green_subgraph a v hv (fun i z => Real.sqrt (G z).det * X z i)
      (fun i => (hZ i).1.of_le h1inf) (fun i => (hZ i).2)
    have hcont : Continuous (fun x => ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det *
        X (smthLift a x (v x)) i * smthCovec a (smthGrad v x) i) := by
      refine continuous_finset_sum _ (fun i _ => ?_)
      exact ((hZ i).1.continuous.comp hliftc).mul (hξc i)
    have hzero : ∀ x, x ∉ smthDisc a c ρ → (∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det *
        X (smthLift a x (v x)) i * smthCovec a (smthGrad v x) i) = 0 := by
      intro x hx
      have hnot : smthLift a x (v x) ∉ tsupport X := fun hmem => hx (hVD x (hX.2.2.1 hmem))
      have hX0 : X (smthLift a x (v x)) = 0 := image_eq_zero_of_notMem_tsupport hnot
      simp [hX0]
    refine ⟨?_, ?_⟩
    · rw [setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
      exact hGG
    · exact (ContinuousOn.integrableOn_compact hKd hcont.continuousOn).mono_set hDsub
  
  have hLc := smth_lag_graph_continuousOn G U hU hG hpd a v hv _ hzU
  have hLint : IntegrableOn (fun x => smthLag G a (x, v x, smthGrad v x)) (smthDisc a c ρ) :=
    (ContinuousOn.integrableOn_compact hKd hLc).mono_set hDsub
  apply le_antisymm
  · 
    unfold sepPerG
    refine iSup₂_le (fun X hX => ?_)
    obtain ⟨hfl, hIint⟩ := hflux X hX
    rw [hfl]
    refine ENNReal.ofReal_le_ofReal (setIntegral_mono_on hIint hLint (hDm ρ) ?_)
    intro x hx
    have hxU : smthLift a x (v x) ∈ U := hzU x (hDsub hx)
    set z := smthLift a x (v x) with hzdef
    set ξ := smthCovec a (smthGrad v x) with hξdef
    have hA := hpd z hxU
    have hCS := smth_quad_cauchySchwarz (G z) hA (fun i => X z i) ξ
    have hB := hX.2.2.2 z
    have hq : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * ξ i * ξ j := by
      have h0 := hA.inv.posSemidef.dotProduct_mulVec_nonneg ξ
      have e : dotProduct (star ξ) (Matrix.mulVec (G z)⁻¹ ξ) =
          ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * ξ i * ξ j := by
        simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
      linarith
    have hsq : (∑ i : Fin 3, X z i * ξ i) ^ 2 ≤
        ∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * ξ i * ξ j :=
      hCS.trans (mul_le_of_le_one_left hq hB)
    have hle : ∑ i : Fin 3, X z i * ξ i ≤
        Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * ξ i * ξ j) :=
      (le_abs_self _).trans (Real.abs_le_sqrt hsq)
    have hfac : ∑ i : Fin 3, Real.sqrt (G z).det * X z i * ξ i =
        Real.sqrt (G z).det * ∑ i : Fin 3, X z i * ξ i := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    show ∑ i : Fin 3, Real.sqrt (G z).det * X z i * ξ i ≤
      Real.sqrt (G z).det * Real.sqrt (∑ i : Fin 3, ∑ j : Fin 3, (G z)⁻¹ i j * ξ i * ξ j)
    rw [hfac]
    exact mul_le_mul_of_nonneg_left hle (Real.sqrt_nonneg _)
  · 
    refine ENNReal.le_of_forall_pos_le_add (fun ε hε _ => ?_)
    set e : ℝ := (ε : ℝ) with hedef
    have he : 0 < e := by rw [hedef]; exact_mod_cast hε
    set J : ℝ := ∫ x in smthDisc a c ρ, smthLag G a (x, v x, smthGrad v x) with hJdef
    obtain ⟨r₁, hr₁, hr₁ρ, hJr⟩ : ∃ r₁ : ℝ, 0 < r₁ ∧ r₁ < ρ ∧
        J - e / 2 ≤ ∫ x in smthDisc a c r₁, smthLag G a (x, v x, smthGrad v x) := by
      
      obtain ⟨r, hr⟩ : ∃ r : ℕ → ℝ, ∀ n, r n = ρ * ((n : ℝ) / ((n : ℝ) + 1)) := ⟨_, fun _ => rfl⟩
      have hrnn : ∀ n, 0 ≤ r n := fun n => by rw [hr]; positivity
      have hrρ : ∀ n, r n < ρ := fun n => by
        rw [hr]
        exact mul_lt_of_lt_one_right hρ ((div_lt_one (by positivity)).2 (by linarith))
      have hrmono : Monotone r := by
        intro n m hnm
        rw [hr, hr]
        have hnm' : (n : ℝ) ≤ m := by exact_mod_cast hnm
        refine mul_le_mul_of_nonneg_left ?_ hρ.le
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        nlinarith
      have hmono : Monotone (fun n => smthDisc a c (r n)) := by
        intro n m hnm x hx
        simp only at hx ⊢
        rw [hDmem] at hx ⊢
        have h1 := hrmono hnm
        have h0 := hrnn n
        nlinarith
      have hlim : Tendsto (fun n => r n ^ 2) atTop (𝓝 (ρ ^ 2)) := by
        have h1 := ((tendsto_natCast_div_add_atTop (1 : ℝ)).const_mul ρ).pow 2
        rw [mul_one] at h1
        refine h1.congr (fun n => ?_)
        rw [hr]
      have hUn : (⋃ n, smthDisc a c (r n)) = smthDisc a c ρ := by
        ext x
        simp only [Set.mem_iUnion]
        constructor
        · rintro ⟨n, hn⟩
          rw [hDmem] at hn ⊢
          have h1 := hrρ n
          have h0 := hrnn n
          nlinarith
        · intro hx
          rw [hDmem] at hx
          obtain ⟨n, hn⟩ := (hlim.eventually (lt_mem_nhds hx)).exists
          exact ⟨n, (hDmem _ _).2 hn⟩
      have hT := tendsto_setIntegral_of_monotone (μ := volume)
        (f := fun x => smthLag G a (x, v x, smthGrad v x)) (fun n => hDm (r n)) hmono
        (by rw [hUn]; exact hLint)
      rw [hUn] at hT
      have hev := hT.eventually (lt_mem_nhds (show J - e / 2 < J by linarith))
      obtain ⟨n, hn, hn1⟩ := (hev.and (eventually_ge_atTop 1)).exists
      have hnpos : (0 : ℝ) < n := by exact_mod_cast hn1
      refine ⟨r n, ?_, hrρ n, hn.le⟩
      rw [hr]
      positivity
    set m : ℝ := volume.real (smthDisc a c ρ) with hmdef
    have hm0 : 0 ≤ m := by rw [hmdef]; exact ENNReal.toReal_nonneg
    set η : ℝ := e / (2 * (m + 1)) with hηdef
    have hη : 0 < η := by rw [hηdef]; positivity
    have hmη : m * η ≤ e / 2 := by
      have hm1 : 0 < m + 1 := by linarith
      have e1 : m * η = e / 2 * (m / (m + 1)) := by
        rw [hηdef]; field_simp
      rw [e1]
      exact mul_le_of_le_one_right (by linarith) ((div_le_one hm1).2 (by linarith))
    obtain ⟨X, hX, hXA, hXB⟩ := smth_good_field G U hU hG hsymm hpd a c ρ h hρ hh hcl v hv hin
      r₁ η hr₁ hr₁ρ hη
    obtain ⟨hfl, hIint⟩ := hflux X hX
    have hD1D : smthDisc a c r₁ ⊆ smthDisc a c ρ := by
      intro x hx
      rw [hDmem] at hx ⊢
      have : r₁ ^ 2 < ρ ^ 2 := by nlinarith
      linarith
    have hconst : IntegrableOn (fun _ : Fin 2 → ℝ => η) (smthDisc a c ρ) :=
      (ContinuousOn.integrableOn_compact hKd continuousOn_const).mono_set hDsub
    have hind : IntegrableOn ((smthDisc a c r₁).indicator
        (fun x => smthLag G a (x, v x, smthGrad v x))) (smthDisc a c ρ) :=
      hLint.indicator (hDm r₁)
    have hmono : (∫ x in smthDisc a c ρ, ((smthDisc a c r₁).indicator
        (fun x => smthLag G a (x, v x, smthGrad v x)) x - η)) ≤
        ∫ x in smthDisc a c ρ, ∑ i : Fin 3, Real.sqrt (G (smthLift a x (v x))).det *
          X (smthLift a x (v x)) i * smthCovec a (smthGrad v x) i := by
      refine setIntegral_mono_on (hind.sub hconst) hIint (hDm ρ) ?_
      intro x hx
      by_cases hx1 : x ∈ smthDisc a c r₁
      · rw [Set.indicator_of_mem hx1]
        exact hXA x hx1
      · rw [Set.indicator_of_notMem hx1, zero_sub]
        exact hXB x hx
    have hcomp : (∫ x in smthDisc a c ρ, ((smthDisc a c r₁).indicator
        (fun x => smthLag G a (x, v x, smthGrad v x)) x - η)) =
        (∫ x in smthDisc a c r₁, smthLag G a (x, v x, smthGrad v x)) - m * η := by
      rw [integral_sub hind hconst, setIntegral_indicator (hDm r₁),
        Set.inter_eq_right.2 hD1D, setIntegral_const, smul_eq_mul]
    have hlow : J - e ≤ ∫ y in {z : E3 | z a < v (smthHoriz a z)}, sepDensDiv G X y := by
      rw [hfl]
      linarith
    have hsup : ENNReal.ofReal (J - e) ≤ sepPerG G {z : E3 | z a < v (smthHoriz a z)}
        (sepCyl a c ρ h) := by
      unfold sepPerG
      exact le_iSup₂_of_le X hX (ENNReal.ofReal_le_ofReal hlow)
    calc ENNReal.ofReal J = ENNReal.ofReal ((J - e) + e) := by ring_nf
      _ ≤ ENNReal.ofReal (J - e) + ENNReal.ofReal e := ENNReal.ofReal_add_le
      _ = ENNReal.ofReal (J - e) + (ε : ENNReal) := by rw [hedef, ENNReal.ofReal_coe_nnreal]
      _ ≤ sepPerG G {z : E3 | z a < v (smthHoriz a z)} (sepCyl a c ρ h) + (ε : ENNReal) := by
        gcongr

theorem smth_firstVariation (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ)
    (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ 1 Λ O)
    (D K : Set (Fin 2 → ℝ)) (hD : MeasurableSet D) (hK : IsCompact K) (hDK : D ⊆ K)
    (v φ : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (hφ : ContDiff ℝ 1 φ)
    (hvO : ∀ x ∈ K, (x, v x, smthGrad v x) ∈ O) :
    HasDerivAt (fun t : ℝ => ∫ x in D, Λ (x, v x + t * φ x, smthGrad (fun y => v y + t * φ y) x))
      (∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)) 0 :=
by
  have hvd : Differentiable ℝ v := hv.differentiable one_ne_zero
  have hφd : Differentiable ℝ φ := hφ.differentiable one_ne_zero
  
  have hgrad : ∀ (t : ℝ) (x : Fin 2 → ℝ),
      smthGrad (fun y => v y + t * φ y) x = smthGrad v x + t • smthGrad φ x := by
    intro t x
    have h1 : HasFDerivAt (fun y => v y + t * φ y) (fderiv ℝ v x + t • fderiv ℝ φ x) x :=
      (hvd x).hasFDerivAt.add ((hφd x).hasFDerivAt.const_mul t)
    unfold smthGrad
    rw [h1.fderiv]
    funext k
    simp
  have hgc : ∀ w : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 w → Continuous (smthGrad w) := by
    intro w hw
    unfold smthGrad
    exact continuous_pi fun k => (hw.continuous_fderiv one_ne_zero).clm_apply continuous_const
  obtain ⟨γ, hγ⟩ : ∃ γ : (Fin 2 → ℝ) → (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      γ = fun x => (x, v x, smthGrad v x) := ⟨_, rfl⟩
  obtain ⟨η, hη⟩ : ∃ η : (Fin 2 → ℝ) → (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      η = fun x => (0, φ x, smthGrad φ x) := ⟨_, rfl⟩
  
  have hfun : (fun t : ℝ => ∫ x in D, Λ (x, v x + t * φ x, smthGrad (fun y => v y + t * φ y) x))
      = fun t : ℝ => ∫ x in D, Λ (γ x + t • η x) := by
    funext t
    congr 1
    funext x
    rw [hgrad, hγ, hη]
    simp only [Prod.smul_mk, Prod.mk_add_mk, smul_zero, add_zero, smul_eq_mul]
  have hval : (∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x))
      = ∫ x in D, fderiv ℝ Λ (γ x + (0 : ℝ) • η x) (η x) := by
    rw [hγ, hη]
    simp only [zero_smul, add_zero]
  rw [hfun, hval]
  have hγc : Continuous γ := by
    rw [hγ]; exact continuous_id.prodMk (hv.continuous.prodMk (hgc v hv))
  have hηc : Continuous η := by
    rw [hη]; exact continuous_const.prodMk (hφ.continuous.prodMk (hgc φ hφ))
  have hγO : ∀ x ∈ K, γ x ∈ O := by
    intro x hx; rw [hγ]; exact hvO x hx
  
  have hS : IsCompact (γ '' K) := hK.image hγc
  have hSO : γ '' K ⊆ O := by
    rintro _ ⟨x, hx, rfl⟩; exact hγO x hx
  obtain ⟨ε, hε, hCO⟩ := hS.exists_cthickening_subset_open hO hSO
  have hCc : IsCompact (cthickening ε (γ '' K)) := hS.cthickening
  obtain ⟨N, hN⟩ := hK.exists_bound_of_continuousOn hηc.continuousOn
  have hdcont : ContinuousOn (fderiv ℝ Λ) O := hΛ.continuousOn_fderiv_of_isOpen hO le_rfl
  obtain ⟨B, hB⟩ := hCc.exists_bound_of_continuousOn (hdcont.mono hCO)
  have hN₁ : 0 < |N| + 1 := by positivity
  have hηN : ∀ x ∈ K, ‖η x‖ ≤ |N| + 1 := fun x hx =>
    (hN x hx).trans (by linarith [le_abs_self N])
  have hδ : 0 < ε / (|N| + 1) := div_pos hε hN₁
  have hmemC : ∀ x ∈ K, ∀ t : ℝ, |t| < ε / (|N| + 1) →
      γ x + t • η x ∈ cthickening ε (γ '' K) := by
    intro x hx t ht
    refine Metric.mem_cthickening_of_dist_le _ (γ x) ε _ ⟨x, hx, rfl⟩ ?_
    rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs]
    calc |t| * ‖η x‖ ≤ |t| * (|N| + 1) := mul_le_mul_of_nonneg_left (hηN x hx) (abs_nonneg t)
      _ ≤ ε / (|N| + 1) * (|N| + 1) := mul_le_mul_of_nonneg_right ht.le hN₁.le
      _ = ε := div_mul_cancel₀ ε hN₁.ne'
  have hmemO : ∀ x ∈ K, ∀ t : ℝ, |t| < ε / (|N| + 1) → γ x + t • η x ∈ O :=
    fun x hx t ht => hCO (hmemC x hx t ht)
  have hbd : ∀ x ∈ K, ∀ t : ℝ, |t| < ε / (|N| + 1) →
      ‖fderiv ℝ Λ (γ x + t • η x) (η x)‖ ≤ |B| * (|N| + 1) := by
    intro x hx t ht
    calc ‖fderiv ℝ Λ (γ x + t • η x) (η x)‖
        ≤ ‖fderiv ℝ Λ (γ x + t • η x)‖ * ‖η x‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ |B| * (|N| + 1) := mul_le_mul ((hB _ (hmemC x hx t ht)).trans (le_abs_self B))
          (hηN x hx) (norm_nonneg _) (abs_nonneg _)
  
  have hball : ∀ t ∈ ball (0 : ℝ) (ε / (|N| + 1)), |t| < ε / (|N| + 1) := fun t ht => by
    rwa [mem_ball, Real.dist_eq, sub_zero] at ht
  have h0 : |(0 : ℝ)| < ε / (|N| + 1) := by rw [abs_zero]; exact hδ
  have hpathc : ∀ t : ℝ, Continuous (fun x => γ x + t • η x) := fun t =>
    hγc.add (continuous_const.smul hηc)
  have hFcont : ∀ t : ℝ, |t| < ε / (|N| + 1) → ContinuousOn (fun x => Λ (γ x + t • η x)) K :=
    fun t ht => hΛ.continuousOn.comp (hpathc t).continuousOn (fun x hx => hmemO x hx t ht)
  have hF'cont : ContinuousOn (fun x => fderiv ℝ Λ (γ x + (0 : ℝ) • η x) (η x)) K :=
    (hdcont.comp (hpathc 0).continuousOn (fun x hx => hmemO x hx 0 h0)).clm_apply
      hηc.continuousOn
  have hμD : volume D < ⊤ := (measure_mono hDK).trans_lt hK.measure_lt_top
  haveI : IsFiniteMeasure (volume.restrict D) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hμD⟩
  have i2 : ∀ᶠ t in 𝓝 (0 : ℝ),
      AEStronglyMeasurable (fun x => Λ (γ x + t • η x)) (volume.restrict D) :=
    Filter.eventually_of_mem (ball_mem_nhds 0 hδ) fun t ht =>
      ((hFcont t (hball t ht)).mono hDK).aestronglyMeasurable hD
  have i3 : Integrable (fun x => Λ (γ x + (0 : ℝ) • η x)) (volume.restrict D) :=
    ((hFcont 0 h0).integrableOn_compact hK).mono_set hDK
  have i4 : AEStronglyMeasurable (fun x => fderiv ℝ Λ (γ x + (0 : ℝ) • η x) (η x))
      (volume.restrict D) :=
    (hF'cont.mono hDK).aestronglyMeasurable hD
  have i5 : ∀ᵐ x ∂(volume.restrict D), ∀ t ∈ ball (0 : ℝ) (ε / (|N| + 1)),
      ‖fderiv ℝ Λ (γ x + t • η x) (η x)‖ ≤ |B| * (|N| + 1) :=
    ae_restrict_of_forall_mem hD fun x hx t ht => hbd x (hDK hx) t (hball t ht)
  have i6 : Integrable (fun _ : Fin 2 → ℝ => |B| * (|N| + 1)) (volume.restrict D) :=
    integrable_const _
  have i7 : ∀ᵐ x ∂(volume.restrict D), ∀ t ∈ ball (0 : ℝ) (ε / (|N| + 1)),
      HasDerivAt (fun s : ℝ => Λ (γ x + s • η x)) (fderiv ℝ Λ (γ x + t • η x) (η x)) t := by
    refine ae_restrict_of_forall_mem hD fun x hx t ht => ?_
    have hw := hmemO x (hDK hx) t (hball t ht)
    have hpath : HasDerivAt (fun s : ℝ => γ x + s • η x) (η x) t := by
      simpa using ((hasDerivAt_id t).smul_const (η x)).const_add (γ x)
    exact ((hΛ.differentiableOn one_ne_zero).differentiableAt
      (hO.mem_nhds hw)).hasFDerivAt.comp_hasDerivAt t hpath
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le (ball_mem_nhds 0 hδ) i2 i3 i4 i5 i6
    i7).2

theorem smth_lag_props (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (a : Fin 3) :
    IsOpen {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | smthLift a w.1 w.2.1 ∈ U} ∧
    ContDiffOn ℝ ∞ (smthLag G a) {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | smthLift a w.1 w.2.1 ∈ U} ∧
    ∀ w ∈ {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | smthLift a w.1 w.2.1 ∈ U},
      ∀ q : Fin 2 → ℝ, q ≠ 0 →
        0 < fderiv ℝ (fun w' => fderiv ℝ (smthLag G a) w' (0, 0, q)) w (0, 0, q) :=
by
  classical
  
  have hinv3 : ∀ {X : Type} [NormedAddCommGroup X] [NormedSpace ℝ X]
      (H : X → Matrix (Fin 3) (Fin 3) ℝ) (s : Set X),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => H y i j) s) → (∀ y ∈ s, (H y).det ≠ 0) →
      ContDiffOn ℝ ∞ (fun y => (H y).det) s ∧
        ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (H y)⁻¹ i j) s := by
    intro X _ _ H s hH hdet
    have h00 := hH 0 0; have h01 := hH 0 1; have h02 := hH 0 2
    have h10 := hH 1 0; have h11 := hH 1 1; have h12 := hH 1 2
    have h20 := hH 2 0; have h21 := hH 2 1; have h22 := hH 2 2
    have hd : ContDiffOn ℝ ∞ (fun y => (H y).det) s := by
      simp only [Matrix.det_fin_three]
      fun_prop
    refine ⟨hd, fun i j => ?_⟩
    have hinv : ContDiffOn ℝ ∞ (fun y => ((H y).det)⁻¹) s := hd.inv hdet
    have hadj : ContDiffOn ℝ ∞ (fun y => (H y).adjugate i j) s := by
      fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
    have heq : (fun y => (H y)⁻¹ i j) = fun y => ((H y).det)⁻¹ * (H y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact hinv.mul hadj
  
  have hquadpos : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ), A.PosDef → ∀ ζ : Fin 3 → ℝ, ζ ≠ 0 →
      0 < ∑ i : Fin 3, ∑ j : Fin 3, A i j * ζ i * ζ j := by
    intro A hA ζ hζ
    have h := hA.dotProduct_mulVec_pos hζ
    have e : star ζ ⬝ᵥ A.mulVec ζ = ∑ i : Fin 3, ∑ j : Fin 3, A i j * ζ i * ζ j := by
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
    linarith
  
  have h1d : ∀ c α β γ : ℝ, 0 < c → 0 < γ → (∀ s : ℝ, 0 < α - 2 * β * s + γ * s ^ 2) →
      0 < deriv (deriv (fun s : ℝ => c * Real.sqrt (α - 2 * β * s + γ * s ^ 2))) 0 := by
    intro c α β γ hc hγ hQ
    have hQd : ∀ s : ℝ, HasDerivAt (fun s : ℝ => α - 2 * β * s + γ * s ^ 2)
        (2 * γ * s - 2 * β) s := by
      intro s
      have h := (((hasDerivAt_id' s).const_mul (2 * β)).const_sub α).add
        ((hasDerivAt_pow 2 s).const_mul γ)
      exact h.congr_deriv (by norm_num <;> ring)
    have hf' : ∀ s : ℝ, HasDerivAt (fun s : ℝ => c * Real.sqrt (α - 2 * β * s + γ * s ^ 2))
        (c * ((2 * γ * s - 2 * β) / (2 * Real.sqrt (α - 2 * β * s + γ * s ^ 2)))) s :=
      fun s => ((hQd s).sqrt (hQ s).ne').const_mul c
    have hdf : deriv (fun s : ℝ => c * Real.sqrt (α - 2 * β * s + γ * s ^ 2)) =
        fun s => c * ((2 * γ * s - 2 * β) / (2 * Real.sqrt (α - 2 * β * s + γ * s ^ 2))) :=
      funext (fun s => (hf' s).deriv)
    have hN : HasDerivAt (fun s : ℝ => 2 * γ * s - 2 * β) (2 * γ * 1) 0 :=
      ((hasDerivAt_id' (0 : ℝ)).const_mul (2 * γ)).sub_const (2 * β)
    have hD : HasDerivAt (fun s : ℝ => 2 * Real.sqrt (α - 2 * β * s + γ * s ^ 2))
        (2 * ((2 * γ * 0 - 2 * β) / (2 * Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2)))) 0 :=
      ((hQd 0).sqrt (hQ 0).ne').const_mul 2
    have hα0 : 0 < α := by have := hQ 0; simpa using this
    have hsq0 : Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2) = Real.sqrt α := by
      congr 1; ring
    have hr : 0 < Real.sqrt α := Real.sqrt_pos.2 hα0
    have hD0 : (2 * Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2)) ≠ 0 := by
      rw [hsq0]; positivity
    have hg : HasDerivAt
        (fun s : ℝ => c * ((2 * γ * s - 2 * β) / (2 * Real.sqrt (α - 2 * β * s + γ * s ^ 2))))
        (c * ((2 * γ * 1 * (2 * Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2)) -
          (2 * γ * 0 - 2 * β) *
            (2 * ((2 * γ * 0 - 2 * β) / (2 * Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2))))) /
          (2 * Real.sqrt (α - 2 * β * 0 + γ * 0 ^ 2)) ^ 2)) 0 :=
      (hN.div hD hD0).const_mul c
    rw [hdf, hg.deriv, hsq0]
    have hr2 : Real.sqrt α ^ 2 = α := Real.sq_sqrt hα0.le
    have hdisc : 0 < α * γ - β ^ 2 := by
      have h := mul_pos hγ (hQ (β / γ))
      have e : γ * (α - 2 * β * (β / γ) + γ * (β / γ) ^ 2) = α * γ - β ^ 2 := by
        field_simp; ring
      linarith
    set r := Real.sqrt α with hrdef
    have e2 : (2 * γ * 1 * (2 * r) - (2 * γ * 0 - 2 * β) * (2 * ((2 * γ * 0 - 2 * β) / (2 * r)))) /
        (2 * r) ^ 2 = (γ * r ^ 2 - β ^ 2) / r ^ 3 := by
      field_simp; ring
    rw [e2, hr2]
    have : 0 < γ * α - β ^ 2 := by linarith
    exact mul_pos hc (div_pos this (pow_pos hr 3))
  
  set O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) :=
    {w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) | smthLift a w.1 w.2.1 ∈ U} with hOdef
  have hLc : ContDiff ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => smthLift a w.1 w.2.1) := by
    have hins : ContDiff ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) =>
        (Fin.insertNth a w.2.1 w.1 : Fin 3 → ℝ)) := by
      refine contDiff_pi.2 (fun i => ?_)
      rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
      · simp only [Fin.insertNth_apply_same]
        exact contDiff_fst.comp contDiff_snd
      · simp only [Fin.insertNth_apply_succAbove]
        exact (contDiff_apply ℝ ℝ k).comp contDiff_fst
    exact (EuclideanSpace.equiv (Fin 3) ℝ).symm.contDiff.comp hins
  have hO : IsOpen O := hU.preimage hLc.continuous
  
  have hcovc : ∀ i : Fin 3,
      ContDiff ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => smthCovec a w.2.2 i) := by
    intro i
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · simp only [smthCovec, Fin.insertNth_apply_same]
      exact contDiff_const
    · simp only [smthCovec, Fin.insertNth_apply_succAbove, Pi.neg_apply]
      exact ((contDiff_apply ℝ ℝ k).comp (contDiff_snd.comp contDiff_snd)).neg
  have hcova : ∀ p : Fin 2 → ℝ, smthCovec a p a = 1 := by
    intro p; simp [smthCovec]
  have hcovne : ∀ p : Fin 2 → ℝ, smthCovec a p ≠ 0 := by
    intro p h
    have := congrFun h a
    rw [hcova] at this
    simp at this
  
  have hHij : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) => G (smthLift a w.1 w.2.1) i j) O :=
    fun i j => (hG i j).comp hLc.contDiffOn (fun w hw => hw)
  obtain ⟨hdetS, hinvS⟩ := hinv3 (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) =>
    G (smthLift a w.1 w.2.1)) O hHij (fun w hw => (hpd _ hw).det_pos.ne')
  have hQs : ContDiffOn ℝ ∞ (fun w : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) =>
      ∑ i : Fin 3, ∑ j : Fin 3, (G (smthLift a w.1 w.2.1))⁻¹ i j *
        smthCovec a w.2.2 i * smthCovec a w.2.2 j) O :=
    ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ =>
      ((hinvS i j).mul (hcovc i).contDiffOn).mul (hcovc j).contDiffOn))
  have hQpos : ∀ w ∈ O, 0 < ∑ i : Fin 3, ∑ j : Fin 3, (G (smthLift a w.1 w.2.1))⁻¹ i j *
        smthCovec a w.2.2 i * smthCovec a w.2.2 j :=
    fun w hw => hquadpos _ (hpd _ hw).inv _ (hcovne _)
  have hΛ : ContDiffOn ℝ ∞ (smthLag G a) O :=
    (hdetS.sqrt (fun w hw => (hpd _ hw).det_pos.ne')).mul
      (hQs.sqrt (fun w hw => (hQpos w hw).ne'))
  refine ⟨hO, hΛ, ?_⟩
  
  intro w hw q hq
  set v : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) := ((0 : Fin 2 → ℝ), (0 : ℝ), q) with hvdef
  have hpt : ∀ s : ℝ, w + s • v = (w.1, w.2.1, w.2.2 + s • q) := by
    intro s
    refine Prod.ext (by simp [v]) (Prod.ext (by simp [v]) (by simp [v]))
  have hline : ∀ s : ℝ, w + s • v ∈ O := by
    intro s
    rw [hpt s]
    exact hw
  
  have h11 : (1 : WithTop ℕ∞) + 1 ≤ ∞ := by
    have : ((2 : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := WithTop.coe_le_coe.2 le_top
    exact le_of_eq_of_le (by norm_num) this
  have hd1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ (smthLag G a) y v) O :=
    (hΛ.fderiv_of_isOpen hO h11).clm_apply contDiffOn_const
  have hΛdiff : ∀ y ∈ O, DifferentiableAt ℝ (smthLag G a) y := fun y hy =>
    (hΛ.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hy)
  have hhdiff : ∀ y ∈ O, DifferentiableAt ℝ (fun y => fderiv ℝ (smthLag G a) y v) y :=
    fun y hy => (hd1.differentiableOn one_ne_zero).differentiableAt (hO.mem_nhds hy)
  have hℓ : ∀ s : ℝ, HasDerivAt (fun s : ℝ => w + s • v) v s := by
    intro s
    simpa using ((hasDerivAt_id s).smul_const v).const_add w
  have hinner : deriv (fun s : ℝ => smthLag G a (w + s • v)) =
      fun s => fderiv ℝ (smthLag G a) (w + s • v) v := by
    funext s
    exact ((hΛdiff _ (hline s)).hasFDerivAt.comp_hasDerivAt s (hℓ s)).deriv
  have houter : HasDerivAt (fun s : ℝ => fderiv ℝ (smthLag G a) (w + s • v) v)
      (fderiv ℝ (fun y => fderiv ℝ (smthLag G a) y v) (w + (0 : ℝ) • v) v) 0 := by
    have h := (hhdiff _ (hline 0)).hasFDerivAt.comp_hasDerivAt (0 : ℝ) (hℓ 0)
    exact h
  have hw0 : w + (0 : ℝ) • v = w := by simp
  rw [hw0] at houter
  have hdd : fderiv ℝ (fun w' => fderiv ℝ (smthLag G a) w' v) w v =
      deriv (deriv (fun s : ℝ => smthLag G a (w + s • v))) 0 := by
    rw [hinner, houter.deriv]
  rw [hdd]
  
  set z : E3 := smthLift a w.1 w.2.1 with hzdef
  have hz : z ∈ U := hw
  set A : Matrix (Fin 3) (Fin 3) ℝ := (G z)⁻¹ with hAdef
  set ξ₀ : Fin 3 → ℝ := smthCovec a w.2.2 with hξ₀def
  set η : Fin 3 → ℝ := (Fin.insertNth a (0 : ℝ) q : Fin 3 → ℝ) with hηdef
  have hηa : η a = 0 := by simp [η]
  have hηs : ∀ k : Fin 2, η (a.succAbove k) = q k := by
    intro k; simp [η]
  have hcovline : ∀ s : ℝ, smthCovec a (w.2.2 + s • q) = fun i => ξ₀ i - s * η i := by
    intro s
    funext i
    rcases Fin.eq_self_or_eq_succAbove a i with rfl | ⟨k, rfl⟩
    · rw [hcova, hηa, hξ₀def, hcova]; ring
    · simp only [smthCovec, Fin.insertNth_apply_succAbove, Pi.neg_apply, Pi.add_apply,
        Pi.smul_apply, smul_eq_mul, hξ₀def, hηs]
      ring
  set α : ℝ := ∑ i : Fin 3, ∑ j : Fin 3, A i j * ξ₀ i * ξ₀ j with hαdef
  set β : ℝ := ((∑ i : Fin 3, ∑ j : Fin 3, A i j * ξ₀ i * η j) +
    (∑ i : Fin 3, ∑ j : Fin 3, A i j * η i * ξ₀ j)) / 2 with hβdef
  set γ : ℝ := ∑ i : Fin 3, ∑ j : Fin 3, A i j * η i * η j with hγdef
  have hquad : ∀ s : ℝ, ∑ i : Fin 3, ∑ j : Fin 3, A i j * (ξ₀ i - s * η i) * (ξ₀ j - s * η j) =
      α - 2 * β * s + γ * s ^ 2 := by
    intro s
    simp only [hαdef, hβdef, hγdef, Fin.sum_univ_three]
    ring
  have hApd : A.PosDef := (hpd z hz).inv
  have hQ : ∀ s : ℝ, 0 < α - 2 * β * s + γ * s ^ 2 := by
    intro s
    rw [← hquad s]
    refine hquadpos A hApd _ ?_
    intro h
    have := congrFun h a
    simp only [hξ₀def, hcova, hηa, Pi.zero_apply] at this
    norm_num at this
  have hηne : η ≠ 0 := by
    intro h
    obtain ⟨k, hk⟩ := Function.ne_iff.mp hq
    have := congrFun h (a.succAbove k)
    rw [hηs] at this
    exact hk this
  have hγ : 0 < γ := hquadpos A hApd η hηne
  have hc : 0 < Real.sqrt (G z).det := Real.sqrt_pos.2 (hpd z hz).det_pos
  have hfun : (fun s : ℝ => smthLag G a (w + s • v)) =
      fun s => Real.sqrt (G z).det * Real.sqrt (α - 2 * β * s + γ * s ^ 2) := by
    funext s
    rw [hpt s, ← hquad s]
    simp only [smthLag, hcovline s]
    rfl
  rw [hfun]
  exact h1d _ α β γ hc hγ hQ

theorem smth_EL_C1_test (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (hvO : ∀ x ∈ D, (x, v x, smthGrad v x) ∈ O) (hEL : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0) : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0 :=
by
  intro φ hφ hφc hφD
  
  obtain ⟨δ, hδ, hδD⟩ := hφc.exists_cthickening_subset_open hD hφD
  have hK'c : IsCompact (Metric.cthickening δ (tsupport φ)) := hφc.cthickening
  
  have hgradc : ∀ f : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 f → Continuous (smthGrad f) := by
    intro f hf
    exact continuous_pi fun k => (hf.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hAc : ContinuousOn (fun x => fderiv ℝ Λ (x, v x, smthGrad v x)) D := by
    have h1 : ContinuousOn (fderiv ℝ Λ) O := hΛ.continuousOn_fderiv_of_isOpen hO (by simp)
    have h2 : Continuous (fun x : Fin 2 → ℝ => (x, v x, smthGrad v x)) :=
      continuous_id.prodMk (hv.continuous.prodMk (hgradc v hv))
    exact h1.comp h2.continuousOn (fun x hx => hvO x hx)
  obtain ⟨C, hC⟩ := hK'c.exists_bound_of_continuousOn (hAc.mono hδD)
  
  have hred : ∀ f : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 f → tsupport f ⊆ Metric.cthickening δ (tsupport φ) →
      (∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, f x, smthGrad f x)) =
        ∫ x in Metric.cthickening δ (tsupport φ),
          fderiv ℝ Λ (x, v x, smthGrad v x) (0, f x, smthGrad f x) := by
    intro f hf hfK
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hD.measurableSet hδD ?_
    intro x hx
    have hxs : x ∉ tsupport f := fun h => hx.2 (hfK h)
    have h0 : f x = 0 := image_eq_zero_of_notMem_tsupport hxs
    have h1 : fderiv ℝ f x = 0 := by
      have : x ∉ Function.support (fderiv ℝ f) := fun h => hxs (support_fderiv_subset ℝ h)
      exact Function.notMem_support.mp this
    have h2 : smthGrad f x = 0 := by
      funext k
      simp [smthGrad, h1]
    rw [h0, h2]
    have : ((0 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) = 0 := rfl
    rw [this, map_zero]
  have hint : ∀ f : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 f →
      IntegrableOn (fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, f x, smthGrad f x))
        (Metric.cthickening δ (tsupport φ)) := by
    intro f hf
    exact ((hAc.mono hδD).clm_apply
      (continuous_const.prodMk (hf.continuous.prodMk (hgradc f hf))).continuousOn).integrableOn_compact
      hK'c
  
  have hstab : ∀ (ψ : (Fin 2 → ℝ) → ℝ) (η : ℝ), 0 < η → ContDiff ℝ 1 ψ →
      tsupport ψ ⊆ Metric.cthickening δ (tsupport φ) →
      (∀ x, |φ x - ψ x| ≤ η) → (∀ x (k : Fin 2), |smthGrad φ x k - smthGrad ψ x k| ≤ η) →
      |(∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)) -
        ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, ψ x, smthGrad ψ x)| ≤
        max C 0 * volume.real (Metric.cthickening δ (tsupport φ)) * η := by
    intro ψ η hη hψ hψK h0 h1
    rw [hred φ hφ (Metric.self_subset_cthickening _), hred ψ hψ hψK,
      ← integral_sub (hint φ hφ) (hint ψ hψ)]
    have hpt : ∀ x ∈ Metric.cthickening δ (tsupport φ),
        ‖fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) -
          fderiv ℝ Λ (x, v x, smthGrad v x) (0, ψ x, smthGrad ψ x)‖ ≤ max C 0 * η := by
      intro x hx
      rw [← map_sub, Prod.mk_sub_mk, Prod.mk_sub_mk, sub_zero]
      refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
      have hn : ‖((0 : Fin 2 → ℝ), φ x - ψ x, smthGrad φ x - smthGrad ψ x)‖ ≤ η := by
        rw [Prod.norm_def, Prod.norm_def]
        simp only [norm_zero]
        refine max_le hη.le (max_le ?_ ?_)
        · rw [Real.norm_eq_abs]; exact h0 x
        · refine (pi_norm_le_iff_of_nonneg hη.le).mpr fun k => ?_
          rw [Real.norm_eq_abs, Pi.sub_apply]
          exact h1 x k
      exact mul_le_mul ((hC x hx).trans (le_max_left _ _)) hn (norm_nonneg _) (le_max_right _ _)
    have := norm_setIntegral_le_of_norm_le_const (hK'c.measure_lt_top (μ := volume)) hpt
    rw [Real.norm_eq_abs] at this
    calc _ ≤ _ := this
      _ = _ := by ring
  
  have hmol : ∀ η : ℝ, 0 < η → ∃ ψ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ ∞ ψ ∧ HasCompactSupport ψ ∧
      tsupport ψ ⊆ Metric.cthickening δ (tsupport φ) ∧ (∀ x, |φ x - ψ x| ≤ η) ∧
      (∀ x (k : Fin 2), |smthGrad φ x k - smthGrad ψ x k| ≤ η) := by
    intro η hη
    obtain ⟨r₀, hr₀, h₀⟩ := Metric.uniformContinuous_iff.mp
      (hφc.uniformContinuous_of_continuous hφ.continuous) η hη
    have hφ' : Continuous (fderiv ℝ φ) := hφ.continuous_fderiv one_ne_zero
    have hφ'c : HasCompactSupport (fderiv ℝ φ) := hφc.fderiv (𝕜 := ℝ)
    obtain ⟨r₁, hr₁, h₁⟩ := Metric.uniformContinuous_iff.mp
      (hφ'c.uniformContinuous_of_continuous hφ') η hη
    have hrpos : 0 < min (min r₀ r₁) δ := lt_min (lt_min hr₀ hr₁) hδ
    have hrr₀ : min (min r₀ r₁) δ ≤ r₀ := (min_le_left _ _).trans (min_le_left _ _)
    have hrr₁ : min (min r₀ r₁) δ ≤ r₁ := (min_le_left _ _).trans (min_le_right _ _)
    have hrδ : min (min r₀ r₁) δ ≤ δ := min_le_right _ _
    let b : ContDiffBump (0 : Fin 2 → ℝ) :=
      ⟨min (min r₀ r₁) δ / 2, min (min r₀ r₁) δ, half_pos hrpos, half_lt_self hrpos⟩
    have hbr : b.rOut = min (min r₀ r₁) δ := rfl
    have hbint : LocallyIntegrable (b.normed volume) volume :=
      (b.contDiff_normed (n := 0)).continuous.locallyIntegrable
    refine ⟨convolution (b.normed volume) φ (ContinuousLinearMap.lsmul ℝ ℝ) volume, ?_, ?_, ?_, ?_, ?_⟩
    · exact b.hasCompactSupport_normed.contDiff_convolution_left _ b.contDiff_normed
        hφ.continuous.locallyIntegrable
    · exact b.hasCompactSupport_normed.convolution _ hφc
    · refine closure_minimal ?_ Metric.isClosed_cthickening
      intro z hz
      have hz' := support_convolution_subset (ContinuousLinearMap.lsmul ℝ ℝ) hz
      rw [b.support_normed_eq] at hz'
      obtain ⟨t, ht, y, hy, rfl⟩ := Set.mem_add.mp hz'
      refine Metric.mem_cthickening_of_dist_le _ y δ _ (subset_tsupport _ hy) ?_
      rw [dist_eq_norm, add_sub_cancel_right]
      have : ‖t‖ < b.rOut := by simpa using ht
      linarith
    · intro x
      have := b.dist_normed_convolution_le (μ := volume) (x₀ := x) (ε := η)
        hφ.continuous.aestronglyMeasurable (fun y hy => ?_)
      · rw [Real.dist_eq] at this
        rw [abs_sub_comm]; exact this
      · have hy' : dist y x < r₀ := lt_of_lt_of_le (Metric.mem_ball.mp hy) (hbr ▸ hrr₀)
        exact (h₀ hy').le
    · intro x k
      have hfd := (hφc.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) hbint hφ x).fderiv
      have hgk : smthGrad (convolution (b.normed volume) φ (ContinuousLinearMap.lsmul ℝ ℝ) volume) x k =
          convolution (b.normed volume) (fun a => fderiv ℝ φ a (Pi.single k 1))
            (ContinuousLinearMap.lsmul ℝ ℝ) volume x := by
        show fderiv ℝ _ x (Pi.single k 1) = _
        rw [hfd]
        exact convolution_precompR_apply (ContinuousLinearMap.lsmul ℝ ℝ) hbint hφ'c hφ' x _
      rw [hgk]
      have := b.dist_normed_convolution_le (μ := volume) (x₀ := x) (ε := η)
        (g := fun a => fderiv ℝ φ a (Pi.single k 1))
        (hφ'.clm_apply continuous_const).aestronglyMeasurable (fun y hy => ?_)
      · rw [Real.dist_eq] at this
        rw [abs_sub_comm]; exact this
      · have hy' : dist y x < r₁ := lt_of_lt_of_le (Metric.mem_ball.mp hy) (hbr ▸ hrr₁)
        have h2 := h₁ hy'
        rw [Real.dist_eq, ← ContinuousLinearMap.sub_apply, ← Real.norm_eq_abs]
        refine ((ContinuousLinearMap.le_opNorm _ _).trans ?_)
        rw [Pi.norm_single, norm_one, mul_one, ← dist_eq_norm]
        exact h2.le
  
  have hM0 : 0 ≤ max C 0 * volume.real (Metric.cthickening δ (tsupport φ)) :=
    mul_nonneg (le_max_right _ _) measureReal_nonneg
  have hbound : ∀ η : ℝ, 0 < η →
      |∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)| ≤
        max C 0 * volume.real (Metric.cthickening δ (tsupport φ)) * η := by
    intro η hη
    obtain ⟨ψ, hψ, hψc, hψK, h0, h1⟩ := hmol η hη
    have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
    have hz := hEL ψ hψ hψc (hψK.trans hδD)
    have := hstab ψ η hη hψ1 hψK h0 h1
    rwa [hz, sub_zero] at this
  by_contra hI
  have hIpos := abs_pos.mpr hI
  set I := ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)
  set Mc := max C 0 * volume.real (Metric.cthickening δ (tsupport φ))
  have hpos : 0 < |I| / (Mc + 1) := div_pos hIpos (by linarith)
  have h1 := hbound _ hpos
  have h2 : Mc * (|I| / (Mc + 1)) < |I| := by
    rw [← mul_div_assoc, div_lt_iff₀ (by linarith)]
    nlinarith
  linarith

theorem smth_dq_compact_constants (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (hell : ∀ w ∈ O, ∀ q : Fin 2 → ℝ, q ≠ 0 → 0 < fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, q)) w (0, 0, q)) (Γ : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hΓ : IsCompact Γ) (hΓne : Γ.Nonempty) (hΓO : Γ ⊆ O) : ∃ κ Λ₂ lam₀ : ℝ, 0 < κ ∧ 0 ≤ Λ₂ ∧ 0 < lam₀ ∧ Metric.cthickening κ Γ ⊆ O ∧ (∀ w ∈ Metric.cthickening κ Γ, ‖fderiv ℝ (fderiv ℝ Λ) w‖ ≤ Λ₂) ∧ (∀ w ∈ Metric.cthickening κ Γ, ∀ q : Fin 2 → ℝ, lam₀ * ∑ k, q k ^ 2 ≤ fderiv ℝ (fderiv ℝ Λ) w (0, 0, q) (0, 0, q)) :=
by
  obtain ⟨κ, hκ, hQO⟩ := hΓ.exists_cthickening_subset_open hO hΓO
  have hQc : IsCompact (Metric.cthickening κ Γ) := hΓ.cthickening
  have hQne : (Metric.cthickening κ Γ).Nonempty :=
    hΓne.mono (Metric.self_subset_cthickening Γ)
  have hΛ1 : ContDiffOn ℝ ∞ (fderiv ℝ Λ) O := hΛ.fderiv_of_isOpen hO (by simp)
  have hHc : ContinuousOn (fderiv ℝ (fderiv ℝ Λ)) O :=
    hΛ1.continuousOn_fderiv_of_isOpen hO (by simp)
  have hHcQ : ContinuousOn (fderiv ℝ (fderiv ℝ Λ)) (Metric.cthickening κ Γ) := hHc.mono hQO
  have hdiag : ∀ w ∈ O, ∀ ξ ζ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      fderiv ℝ (fun w' => fderiv ℝ Λ w' ζ) w ξ = fderiv ℝ (fderiv ℝ Λ) w ξ ζ := by
    intro w hw ξ ζ
    have hd : DifferentiableAt ℝ (fderiv ℝ Λ) w :=
      (hΛ1.differentiableOn (by simp)).differentiableAt (hO.mem_nhds hw)
    rw [fderiv_clm_apply hd (differentiableAt_const ζ)]
    simp
  obtain ⟨C, hC⟩ := hQc.exists_bound_of_continuousOn (f := fderiv ℝ (fderiv ℝ Λ)) hHcQ
  have hS : IsCompact (Metric.sphere (0 : Fin 2 → ℝ) 1) := isCompact_sphere 0 1
  have hSne : (Metric.sphere (0 : Fin 2 → ℝ) 1).Nonempty :=
    ⟨Pi.single 0 1, by rw [mem_sphere_zero_iff_norm, Pi.norm_single, norm_one]⟩
  have hK : IsCompact (Metric.cthickening κ Γ ×ˢ Metric.sphere (0 : Fin 2 → ℝ) 1) := hQc.prod hS
  have hKne := hQne.prod hSne
  have hf : ContinuousOn (fun z : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) =>
      fderiv ℝ (fderiv ℝ Λ) z.1 ((0 : Fin 2 → ℝ), (0 : ℝ), z.2) ((0 : Fin 2 → ℝ), (0 : ℝ), z.2))
      (Metric.cthickening κ Γ ×ˢ Metric.sphere (0 : Fin 2 → ℝ) 1) := by
    have h1 : ContinuousOn (fun z : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) =>
        fderiv ℝ (fderiv ℝ Λ) z.1)
        (Metric.cthickening κ Γ ×ˢ Metric.sphere (0 : Fin 2 → ℝ) 1) :=
      hHcQ.comp continuousOn_fst (fun z hz => hz.1)
    have h2 : Continuous (fun z : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) × (Fin 2 → ℝ) =>
        ((0 : Fin 2 → ℝ), (0 : ℝ), z.2)) :=
      continuous_const.prodMk (continuous_const.prodMk continuous_snd)
    exact (h1.clm_apply h2.continuousOn).clm_apply h2.continuousOn
  obtain ⟨z, hz, hmin⟩ := hK.exists_isMinOn hKne hf
  have hmpos : 0 < fderiv ℝ (fderiv ℝ Λ) z.1 ((0 : Fin 2 → ℝ), (0 : ℝ), z.2)
      ((0 : Fin 2 → ℝ), (0 : ℝ), z.2) := by
    have hz2 : z.2 ≠ 0 := by
      intro h0
      have h3 := hz.2
      rw [mem_sphere_zero_iff_norm, h0, norm_zero] at h3
      exact zero_ne_one h3
    have h4 := hell z.1 (hQO hz.1) z.2 hz2
    rw [hdiag z.1 (hQO hz.1)] at h4
    exact h4
  have hmle : ∀ w ∈ Metric.cthickening κ Γ, ∀ q : Fin 2 → ℝ, ‖q‖ = 1 →
      fderiv ℝ (fderiv ℝ Λ) z.1 ((0 : Fin 2 → ℝ), (0 : ℝ), z.2) ((0 : Fin 2 → ℝ), (0 : ℝ), z.2)
        ≤ fderiv ℝ (fderiv ℝ Λ) w (0, 0, q) (0, 0, q) := by
    intro w hw q hq
    exact (isMinOn_iff.mp hmin) (w, q) ⟨hw, by rw [mem_sphere_zero_iff_norm]; exact hq⟩
  obtain ⟨m, hmdef⟩ : ∃ m : ℝ, m = fderiv ℝ (fderiv ℝ Λ) z.1 ((0 : Fin 2 → ℝ), (0 : ℝ), z.2)
      ((0 : Fin 2 → ℝ), (0 : ℝ), z.2) := ⟨_, rfl⟩
  rw [← hmdef] at hmpos hmle
  refine ⟨κ, max C 0, m / 2, hκ, le_max_right _ _, half_pos hmpos, hQO,
    fun w hw => (hC w hw).trans (le_max_left _ _), ?_⟩
  intro w hw q
  by_cases hq : q = 0
  · subst hq
    have e0 : ((0 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) = 0 := rfl
    simp [e0]
  · have hρ : 0 < ‖q‖ := norm_pos_iff.mpr hq
    have hqh : ‖‖q‖⁻¹ • q‖ = 1 := by
      rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hρ.ne']
    have hvec : ((0 : Fin 2 → ℝ), (0 : ℝ), q) =
        ‖q‖ • ((0 : Fin 2 → ℝ), (0 : ℝ), ‖q‖⁻¹ • q) := by
      simp [Prod.smul_mk, smul_smul, mul_inv_cancel₀ hρ.ne']
    have hBq : fderiv ℝ (fderiv ℝ Λ) w (0, 0, q) (0, 0, q) =
        ‖q‖ ^ 2 * fderiv ℝ (fderiv ℝ Λ) w (0, 0, ‖q‖⁻¹ • q) (0, 0, ‖q‖⁻¹ • q) := by
      rw [hvec]
      simp only [map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hb := hmle w hw _ hqh
    have hsum : ∑ k, q k ^ 2 ≤ 2 * ‖q‖ ^ 2 := by
      rw [Fin.sum_univ_two]
      have h0 : |q 0| ≤ ‖q‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm q 0
      have h1 : |q 1| ≤ ‖q‖ := by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm q 1
      have e0 : q 0 ^ 2 ≤ ‖q‖ ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h0 2
      have e1 : q 1 ^ 2 ≤ ‖q‖ ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      linarith
    rw [hBq]
    have h5 := mul_le_mul_of_nonneg_left hsum (by positivity : (0 : ℝ) ≤ m / 2)
    have h6 := mul_le_mul_of_nonneg_left hb (sq_nonneg ‖q‖)
    nlinarith

theorem smth_dq_segment_estimates (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (Q : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hQO : Q ⊆ O) (Λ₂ lam₀ : ℝ) (hΛ₂ : ∀ w ∈ Q, ‖fderiv ℝ (fderiv ℝ Λ) w‖ ≤ Λ₂) (hlam : ∀ w ∈ Q, ∀ q : Fin 2 → ℝ, lam₀ * ∑ k, q k ^ 2 ≤ fderiv ℝ (fderiv ℝ Λ) w (0, 0, q) (0, 0, q)) (Y₀ Y₁ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) (hseg : ∀ t ∈ Set.Icc (0 : ℝ) 1, Y₀ + t • (Y₁ - Y₀) ∈ Q) (h : ℝ) (hh : 0 < h) (e : Fin 2 → ℝ) (s : ℝ) (q : Fin 2 → ℝ) (hY : Y₁ - Y₀ = h • ((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) : (∀ ζ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ), |fderiv ℝ Λ Y₁ ζ - fderiv ℝ Λ Y₀ ζ| ≤ h * (Λ₂ * ‖((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖ζ‖)) ∧ lam₀ * ∑ k, q k ^ 2 - Λ₂ * ‖((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖q‖ ≤ (fderiv ℝ Λ Y₁ (0, 0, q) - fderiv ℝ Λ Y₀ (0, 0, q)) / h :=
by
  have hsegO : ∀ t ∈ Set.Icc (0 : ℝ) 1, Y₀ + t • (Y₁ - Y₀) ∈ O := fun t ht => hQO (hseg t ht)
  have hdiff : ∀ w ∈ O, HasFDerivAt (fderiv ℝ Λ) (fderiv ℝ (fderiv ℝ Λ) w) w := by
    intro w hw
    have h1 : ContDiffAt ℝ ∞ Λ w := hΛ.contDiffAt (hO.mem_nhds hw)
    have h2 : ContDiffAt ℝ 1 (fderiv ℝ Λ) w := h1.fderiv_right (m := 1) (by norm_cast)
    exact (h2.differentiableAt one_ne_zero).hasFDerivAt
  have mvt : ∀ ζ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ), ∃ t ∈ Set.Icc (0 : ℝ) 1,
      fderiv ℝ Λ Y₁ ζ - fderiv ℝ Λ Y₀ ζ =
        fderiv ℝ (fderiv ℝ Λ) (Y₀ + t • (Y₁ - Y₀)) (Y₁ - Y₀) ζ := by
    intro ζ
    have hder : ∀ t ∈ Set.Icc (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => fderiv ℝ Λ (Y₀ + t • (Y₁ - Y₀)) ζ)
          (fderiv ℝ (fderiv ℝ Λ) (Y₀ + t • (Y₁ - Y₀)) (Y₁ - Y₀) ζ) t := by
      intro t ht
      have hγ : HasDerivAt (fun t : ℝ => Y₀ + t • (Y₁ - Y₀)) (Y₁ - Y₀) t :=
        (((hasDerivAt_id t).smul_const (Y₁ - Y₀)).const_add Y₀).congr_deriv (one_smul ℝ _)
      have hc := (hdiff _ (hsegO t ht)).comp_hasDerivAt t hγ
      have hc2 := hc.clm_apply (hasDerivAt_const t ζ)
      exact hc2.congr_deriv (by simp)
    obtain ⟨c, hc, hceq⟩ := exists_hasDerivAt_eq_slope
      (fun t : ℝ => fderiv ℝ Λ (Y₀ + t • (Y₁ - Y₀)) ζ)
      (fun t => fderiv ℝ (fderiv ℝ Λ) (Y₀ + t • (Y₁ - Y₀)) (Y₁ - Y₀) ζ) zero_lt_one
      (fun t ht => (hder t ht).continuousAt.continuousWithinAt)
      (fun t ht => hder t (Set.Ioo_subset_Icc_self ht))
    refine ⟨c, Set.Ioo_subset_Icc_self hc, ?_⟩
    rw [hceq]
    simp
  refine ⟨fun ζ => ?_, ?_⟩
  · obtain ⟨t, ht, hid⟩ := mvt ζ
    obtain ⟨w, hw, hwdef⟩ : ∃ w, w ∈ Q ∧ Y₀ + t • (Y₁ - Y₀) = w := ⟨_, hseg t ht, rfl⟩
    rw [hwdef, hY] at hid
    rw [hid, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul, abs_mul, abs_of_pos hh]
    apply mul_le_mul_of_nonneg_left _ hh.le
    calc |fderiv ℝ (fderiv ℝ Λ) w ((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) ζ|
        = ‖fderiv ℝ (fderiv ℝ Λ) w ((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) ζ‖ :=
          (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ (fderiv ℝ Λ) w‖ * ‖((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖ζ‖ :=
          ContinuousLinearMap.le_opNorm₂ _ _ _
      _ ≤ Λ₂ * ‖((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖ζ‖ :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (hΛ₂ w hw) (norm_nonneg _))
            (norm_nonneg _)
  · obtain ⟨t, ht, hid⟩ := mvt ((0 : Fin 2 → ℝ), (0 : ℝ), q)
    obtain ⟨w, hw, hwdef⟩ : ∃ w, w ∈ Q ∧ Y₀ + t • (Y₁ - Y₀) = w := ⟨_, hseg t ht, rfl⟩
    rw [hwdef, hY] at hid
    rw [hid, le_div_iff₀ hh, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hsplit : ((e, s, q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) =
        ((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) + ((0 : Fin 2 → ℝ), (0 : ℝ), q) := by
      simp
    rw [hsplit, map_add, ContinuousLinearMap.add_apply]
    have hz : ‖(((0 : Fin 2 → ℝ), (0 : ℝ), q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ = ‖q‖ := by
      simp [Prod.norm_def]
    have h1 : |fderiv ℝ (fderiv ℝ Λ) w ((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        ((0 : Fin 2 → ℝ), (0 : ℝ), q)| ≤
        Λ₂ * ‖((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖q‖ := by
      rw [← Real.norm_eq_abs, ← hz]
      calc _ ≤ ‖fderiv ℝ (fderiv ℝ Λ) w‖ * ‖((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ *
            ‖(((0 : Fin 2 → ℝ), (0 : ℝ), q) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ :=
            ContinuousLinearMap.le_opNorm₂ _ _ _
        _ ≤ _ := mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (hΛ₂ w hw) (norm_nonneg _)) (norm_nonneg _)
    have h2 := hlam w hw q
    have h3 := neg_abs_le (fderiv ℝ (fderiv ℝ Λ) w ((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
        ((0 : Fin 2 → ℝ), (0 : ℝ), q))
    have h4 : lam₀ * ∑ k, q k ^ 2 - Λ₂ * ‖((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖q‖ ≤
        fderiv ℝ (fderiv ℝ Λ) w ((e, s, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))
          ((0 : Fin 2 → ℝ), (0 : ℝ), q) +
        fderiv ℝ (fderiv ℝ Λ) w ((0 : Fin 2 → ℝ), (0 : ℝ), q) ((0 : Fin 2 → ℝ), (0 : ℝ), q) := by
      linarith
    rw [mul_comm]
    exact mul_le_mul_of_nonneg_left h4 hh.le

theorem smth_dq_shift_weak_eq (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hcont : ContinuousOn (fun x => fderiv ℝ Λ (x, v x, smthGrad v x)) D) (hEL1 : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0) (a : Fin 2 → ℝ) (φ : (Fin 2 → ℝ) → ℝ) (hφ : ContDiff ℝ 1 φ) (hφc : HasCompactSupport φ) (hφD : tsupport φ ⊆ D) (hφa : ∀ x ∈ tsupport φ, x + a ∈ D) : ∫ x, (fderiv ℝ Λ (x + a, v (x + a), smthGrad v (x + a)) (0, φ x, smthGrad φ x) - fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)) = 0 :=
by
  
  have pairing : ∀ (L : (Fin 2 → ℝ) → ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) →L[ℝ] ℝ))
      (χ : (Fin 2 → ℝ) → ℝ), ContDiff ℝ 1 χ → HasCompactSupport χ →
      ContinuousOn L (tsupport χ) →
      MeasureTheory.Integrable (fun x => L x (0, χ x, smthGrad χ x)) ∧
      ∀ x, x ∉ tsupport χ → L x (0, χ x, smthGrad χ x) = 0 := by
    intro L χ hχ hχc hL
    have hvan : ∀ x, x ∉ tsupport χ → L x (0, χ x, smthGrad χ x) = 0 := by
      intro x hx
      have h1 : χ x = 0 := image_eq_zero_of_notMem_tsupport hx
      have h2 : fderiv ℝ χ x = 0 := by
        by_contra hne
        exact hx (support_fderiv_subset ℝ hne)
      have h3 : smthGrad χ x = 0 := by
        funext k
        simp [smthGrad, h2]
      rw [h1, h3]
      have h4 : (((0 : Fin 2 → ℝ), (0 : ℝ), (0 : Fin 2 → ℝ)) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) = 0 :=
        rfl
      rw [h4, map_zero]
    refine ⟨?_, hvan⟩
    have hgrad : Continuous (smthGrad χ) :=
      continuous_pi fun k => (hχ.continuous_fderiv one_ne_zero).clm_apply continuous_const
    have hg : Continuous (fun x => ((0 : Fin 2 → ℝ), χ x, smthGrad χ x)) :=
      continuous_const.prodMk (hχ.continuous.prodMk hgrad)
    have hcon : ContinuousOn (fun x => L x (0, χ x, smthGrad χ x)) (tsupport χ) :=
      hL.clm_apply hg.continuousOn
    exact (hcon.integrableOn_compact hχc.isCompact).integrable_of_forall_notMem_eq_zero hvan
  
  have hψ : ContDiff ℝ 1 (fun y => φ (y - a)) := hφ.comp (contDiff_id.sub contDiff_const)
  have hψc : HasCompactSupport (fun y => φ (y - a)) :=
    hφc.comp_homeomorph (Homeomorph.subRight a)
  have hψt : ∀ y ∈ tsupport (fun y => φ (y - a)), y - a ∈ tsupport φ := by
    intro y hy
    have e : tsupport (fun y => φ (y - a)) = (Homeomorph.subRight a) ⁻¹' tsupport φ :=
      tsupport_comp_eq_preimage φ (Homeomorph.subRight a)
    rw [e] at hy
    exact hy
  have hψD : tsupport (fun y => φ (y - a)) ⊆ D := by
    intro y hy
    have h := hφa _ (hψt y hy)
    rwa [sub_add_cancel] at h
  have hψgrad : ∀ x, smthGrad (fun y => φ (y - a)) (x + a) = smthGrad φ x := by
    intro x
    funext k
    simp only [smthGrad]
    rw [fderiv_comp_sub, add_sub_cancel_right]
  
  have hFψ := pairing (fun x => fderiv ℝ Λ (x, v x, smthGrad v x)) (fun y => φ (y - a)) hψ hψc
    (hcont.mono hψD)
  have hIψ : ∫ y, fderiv ℝ Λ (y, v y, smthGrad v y)
      (0, φ (y - a), smthGrad (fun z => φ (z - a)) y) = 0 := by
    have h0 : ∀ y, y ∉ D → fderiv ℝ Λ (y, v y, smthGrad v y)
        (0, φ (y - a), smthGrad (fun z => φ (z - a)) y) = 0 :=
      fun y hy => hFψ.2 y (fun h => hy (hψD h))
    rw [← MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero h0]
    exact hEL1 _ hψ hψc hψD
  have hI1 : ∫ x, fderiv ℝ Λ (x + a, v (x + a), smthGrad v (x + a)) (0, φ x, smthGrad φ x) = 0 := by
    have h := MeasureTheory.integral_add_right_eq_self (μ := MeasureTheory.volume)
      (fun y => fderiv ℝ Λ (y, v y, smthGrad v y)
        (0, φ (y - a), smthGrad (fun z => φ (z - a)) y)) a
    simp only [add_sub_cancel_right, hψgrad] at h
    rw [h]
    exact hIψ
  
  have hFφ := pairing (fun x => fderiv ℝ Λ (x, v x, smthGrad v x)) φ hφ hφc (hcont.mono hφD)
  have hI2 : ∫ x, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0 := by
    have h0 : ∀ y, y ∉ D → fderiv ℝ Λ (y, v y, smthGrad v y) (0, φ y, smthGrad φ y) = 0 :=
      fun y hy => hFφ.2 y (fun h => hy (hφD h))
    rw [← MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero h0]
    exact hEL1 _ hφ hφc hφD
  
  have hint1 : MeasureTheory.Integrable
      (fun x => fderiv ℝ Λ (x + a, v (x + a), smthGrad v (x + a)) (0, φ x, smthGrad φ x)) :=
    (pairing (fun x => fderiv ℝ Λ (x + a, v (x + a), smthGrad v (x + a))) φ hφ hφc
      (hcont.comp (continuous_add_right a).continuousOn (fun x hx => hφa x hx))).1
  have hint2 : MeasureTheory.Integrable
      (fun x => fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)) := hFφ.1
  rw [MeasureTheory.integral_sub hint1 hint2, hI1, hI2, sub_zero]

theorem smth_diffquot_structure (Λ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ) → ℝ) (O : Set ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))) (hO : IsOpen O) (hΛ : ContDiffOn ℝ ∞ Λ O) (hell : ∀ w ∈ O, ∀ q : Fin 2 → ℝ, q ≠ 0 → 0 < fderiv ℝ (fun w' => fderiv ℝ Λ w' (0, 0, q)) w (0, 0, q)) (D : Set (Fin 2 → ℝ)) (hD : IsOpen D) (v : (Fin 2 → ℝ) → ℝ) (hv : ContDiff ℝ 1 v) (hvO : ∀ x ∈ D, (x, v x, smthGrad v x) ∈ O) (hEL1 : ∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ D → ∫ x in D, fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x) = 0) (x₀ : Fin 2 → ℝ) (hx₀ : x₀ ∈ D) : ∃ R h₀ lam Lam K M₀ : ℝ, 0 < R ∧ 0 < h₀ ∧ 0 < lam ∧ 0 ≤ Lam ∧ 0 ≤ K ∧ 0 ≤ M₀ ∧ Metric.closedBall x₀ R ⊆ D ∧ ∀ (m : Fin 2) (h : ℝ), 0 < h → h ≤ h₀ → ∃ (P : (Fin 2 → ℝ) → (Fin 2 → ℝ)) (p : (Fin 2 → ℝ) → ℝ), ContinuousOn P (Metric.closedBall x₀ R) ∧ ContinuousOn p (Metric.closedBall x₀ R) ∧ (∀ x ∈ Metric.closedBall x₀ R, |(v (x + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v x) / h| ≤ M₀) ∧ (∀ x ∈ Metric.closedBall x₀ R, lam * ∑ k, (smthGrad (fun y => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h) x k) ^ 2 - K ≤ ∑ k, P x k * smthGrad (fun y => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h) x k) ∧ (∀ x ∈ Metric.closedBall x₀ R, ∀ k, |P x k| ≤ Lam * (1 + ∑ j, |smthGrad (fun y => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h) x j|)) ∧ (∀ x ∈ Metric.closedBall x₀ R, |p x| ≤ Lam * (1 + ∑ j, |smthGrad (fun y => (v (y + h • (Pi.single m (1 : ℝ) : Fin 2 → ℝ)) - v y) / h) x j|)) ∧ (∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Metric.ball x₀ R → ∫ x, (∑ k, P x k * smthGrad φ x k + p x * φ x) = 0) :=
by
  classical
  
  obtain ⟨W, hW⟩ : ∃ W : (Fin 2 → ℝ) → (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
      ∀ x, W x = (x, v x, smthGrad v x) := ⟨fun x => (x, v x, smthGrad v x), fun x => rfl⟩
  
  have hgradc : Continuous (smthGrad v) :=
    continuous_pi fun k => (hv.continuous_fderiv one_ne_zero).clm_apply continuous_const
  have hWc : Continuous W := by
    have e1 : W = fun x => (x, v x, smthGrad v x) := funext hW
    rw [e1]
    exact continuous_id.prodMk (hv.continuous.prodMk hgradc)
  have hLc' : ContinuousOn (fun x => fderiv ℝ Λ (x, v x, smthGrad v x)) D := by
    have h1 : ContinuousOn (fderiv ℝ Λ) O := hΛ.continuousOn_fderiv_of_isOpen hO (by simp)
    have h2 : Continuous (fun x => (x, v x, smthGrad v x)) :=
      continuous_id.prodMk (hv.continuous.prodMk hgradc)
    exact h1.comp h2.continuousOn (fun x hx => hvO x hx)
  have hLc : ContinuousOn (fun x => fderiv ℝ Λ (W x)) D := by
    have e1 : (fun x => fderiv ℝ Λ (W x)) = fun x => fderiv ℝ Λ (x, v x, smthGrad v x) :=
      funext fun x => by rw [hW]
    rw [e1]; exact hLc'
  
  have hs6 : ∀ (L : ((Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) →L[ℝ] ℝ) (c' : ℝ) (q : Fin 2 → ℝ),
      L (0, c', q) = c' * L (0, 1, 0) + ∑ k, q k * L (0, 0, Pi.single k 1) := by
    intro L c' q
    rw [Fin.sum_univ_two]
    have key : ((0 : Fin 2 → ℝ), c', q) = c' • ((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) +
        (q 0 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 0 1 : Fin 2 → ℝ)) +
          q 1 • ((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single 1 1 : Fin 2 → ℝ))) := by
      refine Prod.ext ?_ (Prod.ext ?_ ?_)
      · simp
      · simp
      · funext i; fin_cases i <;> simp
    rw [key, map_add, map_add, map_smul, map_smul, map_smul, smul_eq_mul, smul_eq_mul,
      smul_eq_mul]
  
  obtain ⟨r, hr, hrD⟩ := Metric.isOpen_iff.1 hD x₀ hx₀
  obtain ⟨R, hRdef⟩ : ∃ R : ℝ, R = r / 4 := ⟨_, rfl⟩
  have hR : 0 < R := by rw [hRdef]; positivity
  have hB₂D : Metric.closedBall x₀ (2 * R) ⊆ D := fun y hy =>
    hrD (Metric.closedBall_subset_ball (by rw [hRdef]; linarith) hy)
  have hBR : Metric.closedBall x₀ R ⊆ Metric.closedBall x₀ (2 * R) :=
    Metric.closedBall_subset_closedBall (by linarith)
  have hB₂c : IsCompact (Metric.closedBall x₀ (2 * R)) := isCompact_closedBall _ _
  obtain ⟨κ, Λ₂, lam₀, hκ, hΛ₂, hlam₀, hQO, hHb, hHe⟩ :=
    smth_dq_compact_constants Λ O hO hΛ hell (W '' Metric.closedBall x₀ (2 * R))
      (hB₂c.image hWc) ⟨W x₀, x₀, Metric.mem_closedBall_self (by linarith), rfl⟩
      (by rintro _ ⟨y, hy, rfl⟩; rw [hW]; exact hvO y (hB₂D hy))
  obtain ⟨Cv, hCv⟩ :=
    hB₂c.exists_bound_of_continuousOn (hv.continuous_fderiv one_ne_zero).continuousOn
  obtain ⟨M₀, hM₀def⟩ : ∃ M₀ : ℝ, M₀ = max Cv 0 := ⟨_, rfl⟩
  have hM₀ : 0 ≤ M₀ := by rw [hM₀def]; exact le_max_right _ _
  have hDv : ∀ y ∈ Metric.closedBall x₀ (2 * R), ‖fderiv ℝ v y‖ ≤ M₀ := fun y hy =>
    (hCv y hy).trans (by rw [hM₀def]; exact le_max_left _ _)
  obtain ⟨η, hη, hWu⟩ := Metric.uniformContinuousOn_iff.1
    (hB₂c.uniformContinuousOn_of_continuous hWc.continuousOn) κ hκ
  obtain ⟨h₀, hh₀def⟩ : ∃ h₀ : ℝ, h₀ = min R (η / 2) := ⟨_, rfl⟩
  have hh₀ : 0 < h₀ := by rw [hh₀def]; exact lt_min hR (by positivity)
  have hh₀R : h₀ ≤ R := by rw [hh₀def]; exact min_le_left _ _
  have hh₀η : h₀ < η := by rw [hh₀def]; exact lt_of_le_of_lt (min_le_right _ _) (by linarith)
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Λ₂ * (1 + M₀) := ⟨_, rfl⟩
  have hc : 0 ≤ c := by rw [hcdef]; exact mul_nonneg hΛ₂ (by linarith)
  
  have hσ : ∀ q : Fin 2 → ℝ, ‖q‖ ≤ ∑ j, |q j| := by
    intro q
    refine (pi_norm_le_iff_of_nonneg (Finset.sum_nonneg fun j _ => abs_nonneg _)).2 fun i => ?_
    rw [Real.norm_eq_abs]
    exact Finset.single_le_sum (f := fun j => |q j|) (fun j _ => abs_nonneg _)
      (Finset.mem_univ i)
  have young : ∀ t : ℝ, c * |t| ≤ lam₀ / 2 * t ^ 2 + c ^ 2 / (2 * lam₀) := by
    intro t
    have key : lam₀ / 2 * t ^ 2 + c ^ 2 / (2 * lam₀) - c * |t| =
        (lam₀ * |t| - c) ^ 2 / (2 * lam₀) := by
      rw [← sq_abs t]
      field_simp
      ring
    have : 0 ≤ (lam₀ * |t| - c) ^ 2 / (2 * lam₀) := by positivity
    linarith
  refine ⟨R, h₀, lam₀ / 2, c, c ^ 2 / lam₀, M₀, hR, hh₀, by positivity, hc, by positivity, hM₀,
    hBR.trans hB₂D, ?_⟩
  
  intro m h hh hhh
  have hh0 : h ≠ 0 := hh.ne'
  obtain ⟨ev, hevdef⟩ : ∃ ev : Fin 2 → ℝ, ev = (Pi.single m (1 : ℝ) : Fin 2 → ℝ) := ⟨_, rfl⟩
  rw [← hevdef]
  have hev : ‖ev‖ = 1 := by rw [hevdef, Pi.norm_single, norm_one]
  have hnorm_a : ‖h • ev‖ = h := by
    rw [norm_smul, hev, mul_one, Real.norm_eq_abs, abs_of_pos hh]
  have hmem : ∀ x ∈ Metric.closedBall x₀ R, x ∈ Metric.closedBall x₀ (2 * R) ∧
      x + h • ev ∈ Metric.closedBall x₀ (2 * R) := by
    intro x hx
    refine ⟨hBR hx, ?_⟩
    rw [Metric.mem_closedBall] at hx ⊢
    calc dist (x + h • ev) x₀ ≤ dist (x + h • ev) x + dist x x₀ := dist_triangle _ _ _
      _ = h + dist x x₀ := by rw [dist_eq_norm, add_sub_cancel_left, hnorm_a]
      _ ≤ 2 * R := by linarith
  
  have hdv : ∀ y, DifferentiableAt ℝ v y := fun y => hv.differentiable one_ne_zero y
  have hs5 : ∀ x, smthGrad (fun y => (v (y + h • ev) - v y) / h) x =
      fun k => (smthGrad v (x + h • ev) k - smthGrad v x k) / h := by
    intro x
    have hd1 : DifferentiableAt ℝ (fun y => v (y + h • ev)) x :=
      (hdv _).comp x (differentiableAt_id.add_const _)
    have hfd : fderiv ℝ (fun y => (v (y + h • ev) - v y) / h) x =
        h⁻¹ • (fderiv ℝ v (x + h • ev) - fderiv ℝ v x) := by
      have e1 : (fun y => (v (y + h • ev) - v y) / h) = fun y => h⁻¹ * (v (y + h • ev) - v y) := by
        funext y; rw [div_eq_inv_mul]
      have hd2 : DifferentiableAt ℝ (fun y => v (y + h • ev) - v y) x := hd1.sub (hdv x)
      rw [e1, fderiv_const_mul hd2]
      congr 1
      rw [show (fun y => v (y + h • ev) - v y) = (fun y => v (y + h • ev)) - v from rfl,
        fderiv_sub hd1 (hdv x), fderiv_comp_add_right]
    funext k
    simp only [smthGrad, hfd, ContinuousLinearMap.smul_apply, ContinuousLinearMap.sub_apply,
      smul_eq_mul]
    rw [div_eq_inv_mul]
  
  obtain ⟨P, hP⟩ : ∃ P : (Fin 2 → ℝ) → (Fin 2 → ℝ), ∀ x k, P x k =
      (fderiv ℝ Λ (W (x + h • ev)) (0, 0, Pi.single k 1) -
        fderiv ℝ Λ (W x) (0, 0, Pi.single k 1)) / h := ⟨_, fun _ _ => rfl⟩
  obtain ⟨p, hp⟩ : ∃ p : (Fin 2 → ℝ) → ℝ, ∀ x, p x =
      (fderiv ℝ Λ (W (x + h • ev)) (0, 1, 0) - fderiv ℝ Λ (W x) (0, 1, 0)) / h :=
    ⟨_, fun _ => rfl⟩
  have hL1 : ContinuousOn (fun x => fderiv ℝ Λ (W (x + h • ev))) (Metric.closedBall x₀ R) :=
    hLc.comp (continuous_add_right _).continuousOn (fun x hx => hB₂D (hmem x hx).2)
  have hL0 : ContinuousOn (fun x => fderiv ℝ Λ (W x)) (Metric.closedBall x₀ R) :=
    hLc.mono (hBR.trans hB₂D)
  
  have hwb : ∀ x ∈ Metric.closedBall x₀ R, |(v (x + h • ev) - v x) / h| ≤ M₀ := by
    intro x hx
    have hmv := (convex_closedBall x₀ (2 * R)).norm_image_sub_le_of_norm_fderiv_le
      (fun y _ => hdv y) hDv (hmem x hx).1 (hmem x hx).2
    rw [add_sub_cancel_left, hnorm_a, Real.norm_eq_abs] at hmv
    rw [abs_div, abs_of_pos hh, div_le_iff₀ hh]
    exact hmv
  
  have hstruct : ∀ x ∈ Metric.closedBall x₀ R,
      (∀ ζ : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ),
        |fderiv ℝ Λ (W (x + h • ev)) ζ - fderiv ℝ Λ (W x) ζ| ≤
          h * (Λ₂ * ‖((ev, (v (x + h • ev) - v x) / h,
            smthGrad (fun y => (v (y + h • ev) - v y) / h) x) :
              (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ * ‖ζ‖)) ∧
      lam₀ * ∑ k, (smthGrad (fun y => (v (y + h • ev) - v y) / h) x k) ^ 2 -
          Λ₂ * ‖((ev, (v (x + h • ev) - v x) / h, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ *
            ‖smthGrad (fun y => (v (y + h • ev) - v y) / h) x‖ ≤
        (fderiv ℝ Λ (W (x + h • ev)) (0, 0, smthGrad (fun y => (v (y + h • ev) - v y) / h) x) -
          fderiv ℝ Λ (W x) (0, 0, smthGrad (fun y => (v (y + h • ev) - v y) / h) x)) / h := by
    intro x hx
    have hY : W (x + h • ev) - W x = h • ((ev, (v (x + h • ev) - v x) / h,
        smthGrad (fun y => (v (y + h • ev) - v y) / h) x) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ)) := by
      rw [hW, hW, hs5 x]
      refine Prod.ext ?_ (Prod.ext ?_ ?_)
      · simp
      · simp only [Prod.snd_sub, Prod.smul_snd, Prod.smul_fst, Prod.fst_sub, smul_eq_mul]
        field_simp
      · funext k
        simp only [Prod.snd_sub, Prod.smul_snd, Prod.fst_sub, Prod.smul_fst, Pi.sub_apply,
          Pi.smul_apply, smul_eq_mul]
        field_simp
    have hseg : ∀ t ∈ Set.Icc (0 : ℝ) 1, W x + t • (W (x + h • ev) - W x) ∈
        Metric.cthickening κ (W '' Metric.closedBall x₀ (2 * R)) := by
      intro t ht
      have hd : dist (W (x + h • ev)) (W x) < κ := by
        apply hWu _ (hmem x hx).2 _ (hmem x hx).1
        rw [dist_eq_norm, add_sub_cancel_left, hnorm_a]
        linarith
      refine Metric.mem_cthickening_of_dist_le _ (W x) κ _ ⟨x, (hmem x hx).1, rfl⟩ ?_
      rw [dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1,
        ← dist_eq_norm]
      calc t * dist (W (x + h • ev)) (W x) ≤ 1 * dist (W (x + h • ev)) (W x) :=
            mul_le_mul_of_nonneg_right ht.2 dist_nonneg
        _ ≤ κ := by rw [one_mul]; exact hd.le
    exact smth_dq_segment_estimates Λ O hO hΛ _ hQO Λ₂ lam₀ hHb hHe (W x) (W (x + h • ev)) hseg
      h hh ev _ _ hY
  refine ⟨P, p, ?_, ?_, hwb, ?_, ?_, ?_, ?_⟩
  · 
    have e1 : P = fun x k => (fderiv ℝ Λ (W (x + h • ev)) (0, 0, Pi.single k 1) -
        fderiv ℝ Λ (W x) (0, 0, Pi.single k 1)) / h := funext fun x => funext fun k => hP x k
    rw [e1]
    exact continuousOn_pi.2 fun k =>
      ((hL1.clm_apply continuousOn_const).sub (hL0.clm_apply continuousOn_const)).div_const _
  · 
    have e1 : p = fun x => (fderiv ℝ Λ (W (x + h • ev)) (0, 1, 0) -
        fderiv ℝ Λ (W x) (0, 1, 0)) / h := funext hp
    rw [e1]
    exact ((hL1.clm_apply continuousOn_const).sub (hL0.clm_apply continuousOn_const)).div_const _
  · 
    intro x hx
    obtain ⟨-, hB⟩ := hstruct x hx
    have hsum : ∑ k, P x k * smthGrad (fun y => (v (y + h • ev) - v y) / h) x k =
        (fderiv ℝ Λ (W (x + h • ev)) (0, 0, smthGrad (fun y => (v (y + h • ev) - v y) / h) x) -
          fderiv ℝ Λ (W x) (0, 0, smthGrad (fun y => (v (y + h • ev) - v y) / h) x)) / h := by
      rw [hs6 (fderiv ℝ Λ (W (x + h • ev))) 0 (smthGrad (fun y => (v (y + h • ev) - v y) / h) x),
        hs6 (fderiv ℝ Λ (W x)) 0 (smthGrad (fun y => (v (y + h • ev) - v y) / h) x)]
      simp only [hP, zero_mul, zero_add, Fin.sum_univ_two]
      ring
    rw [hsum]
    have hn : ‖((ev, (v (x + h • ev) - v x) / h, 0) : (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ ≤
        1 + M₀ := by
      have hw := hwb x hx
      simp only [Prod.norm_def, hev, Real.norm_eq_abs, norm_zero]
      exact max_le (by linarith) (max_le (by linarith) (by linarith))
    have hq := hσ (smthGrad (fun y => (v (y + h • ev) - v y) / h) x)
    have hprod := mul_le_mul_of_nonneg_left (mul_le_mul hn hq (norm_nonneg _) (by linarith)) hΛ₂
    have y0 := young (smthGrad (fun y => (v (y + h • ev) - v y) / h) x 0)
    have y1 := young (smthGrad (fun y => (v (y + h • ev) - v y) / h) x 1)
    have hcc : c ^ 2 / lam₀ = c ^ 2 / (2 * lam₀) + c ^ 2 / (2 * lam₀) := by
      field_simp; ring
    simp only [Fin.sum_univ_two] at hprod hB ⊢
    rw [hcc]
    rw [hcdef] at y0 y1 ⊢
    nlinarith
  · 
    intro x hx k
    obtain ⟨hA, -⟩ := hstruct x hx
    have h1 := hA (0, 0, Pi.single k 1)
    have hk : ‖(((0 : Fin 2 → ℝ), (0 : ℝ), (Pi.single k 1 : Fin 2 → ℝ)) :
        (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ = 1 := by
      simp [Prod.norm_def, Pi.norm_single]
    rw [hk, mul_one] at h1
    have hw := hwb x hx
    have hq := hσ (smthGrad (fun y => (v (y + h • ev) - v y) / h) x)
    have h2 : ‖((ev, (v (x + h • ev) - v x) / h, smthGrad (fun y => (v (y + h • ev) - v y) / h) x) :
        (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ ≤
        (1 + M₀) * (1 + ∑ j, |smthGrad (fun y => (v (y + h • ev) - v y) / h) x j|) := by
      have hs0 : 0 ≤ ∑ j, |smthGrad (fun y => (v (y + h • ev) - v y) / h) x j| :=
        Finset.sum_nonneg fun j _ => abs_nonneg _
      simp only [Prod.norm_def, hev, Real.norm_eq_abs]
      refine max_le ?_ (max_le ?_ ?_) <;> nlinarith
    have h3 := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h2 hΛ₂) hh.le
    rw [hP, abs_div, abs_of_pos hh, div_le_iff₀ hh, hcdef]
    nlinarith
  · 
    intro x hx
    obtain ⟨hA, -⟩ := hstruct x hx
    have h1 := hA (0, 1, 0)
    have hk : ‖(((0 : Fin 2 → ℝ), (1 : ℝ), (0 : Fin 2 → ℝ)) :
        (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ = 1 := by
      simp [Prod.norm_def]
    rw [hk, mul_one] at h1
    have hw := hwb x hx
    have hq := hσ (smthGrad (fun y => (v (y + h • ev) - v y) / h) x)
    have h2 : ‖((ev, (v (x + h • ev) - v x) / h, smthGrad (fun y => (v (y + h • ev) - v y) / h) x) :
        (Fin 2 → ℝ) × ℝ × (Fin 2 → ℝ))‖ ≤
        (1 + M₀) * (1 + ∑ j, |smthGrad (fun y => (v (y + h • ev) - v y) / h) x j|) := by
      have hs0 : 0 ≤ ∑ j, |smthGrad (fun y => (v (y + h • ev) - v y) / h) x j| :=
        Finset.sum_nonneg fun j _ => abs_nonneg _
      simp only [Prod.norm_def, hev, Real.norm_eq_abs]
      refine max_le ?_ (max_le ?_ ?_) <;> nlinarith
    have h3 := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h2 hΛ₂) hh.le
    rw [hp, abs_div, abs_of_pos hh, div_le_iff₀ hh, hcdef]
    nlinarith
  · 
    intro φ hφ hφc hφB
    have hφD : tsupport φ ⊆ D :=
      hφB.trans (Metric.ball_subset_closedBall.trans (hBR.trans hB₂D))
    have hφa : ∀ x ∈ tsupport φ, x + h • ev ∈ D := fun x hx =>
      hB₂D (hmem x (Metric.ball_subset_closedBall (hφB hx))).2
    have h4 := smth_dq_shift_weak_eq Λ D hD v hLc' hEL1 (h • ev) φ hφ hφc hφD hφa
    have hfun : ∀ x, (∑ k, P x k * smthGrad φ x k + p x * φ x) =
        (fderiv ℝ Λ (x + h • ev, v (x + h • ev), smthGrad v (x + h • ev)) (0, φ x, smthGrad φ x) -
          fderiv ℝ Λ (x, v x, smthGrad v x) (0, φ x, smthGrad φ x)) / h := by
      intro x
      rw [← hW, ← hW, hs6 (fderiv ℝ Λ (W (x + h • ev))) (φ x) (smthGrad φ x),
        hs6 (fderiv ℝ Λ (W x)) (φ x) (smthGrad φ x)]
      simp only [hP, hp, Fin.sum_univ_two]
      ring
    simp only [hfun]
    rw [MeasureTheory.integral_div, h4, zero_div]

theorem slh_caccioppoli (x₀ : Fin 2 → ℝ) (R lam Lam K M₀ : ℝ) (hR : 0 < R) (hlam : 0 < lam) (hLam : 0 ≤ Lam) (hK : 0 ≤ K) (hM₀ : 0 ≤ M₀) : ∃ C₁ C₂ : ℝ, 0 ≤ C₁ ∧ 0 ≤ C₂ ∧ ∀ (w : (Fin 2 → ℝ) → ℝ) (P : (Fin 2 → ℝ) → (Fin 2 → ℝ)) (p : (Fin 2 → ℝ) → ℝ), ContDiff ℝ 1 w → ContinuousOn P (Metric.closedBall x₀ R) → ContinuousOn p (Metric.closedBall x₀ R) → (∀ x ∈ Metric.closedBall x₀ R, |w x| ≤ M₀) → (∀ x ∈ Metric.closedBall x₀ R, lam * ∑ k, (smthGrad w x k) ^ 2 - K ≤ ∑ k, P x k * smthGrad w x k) → (∀ x ∈ Metric.closedBall x₀ R, ∀ k, |P x k| ≤ Lam * (1 + ∑ j, |smthGrad w x j|)) → (∀ x ∈ Metric.closedBall x₀ R, |p x| ≤ Lam * (1 + ∑ j, |smthGrad w x j|)) → (∀ φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 φ → HasCompactSupport φ → tsupport φ ⊆ Metric.ball x₀ R → ∫ x, (∑ k, P x k * smthGrad φ x k + p x * φ x) = 0) → ∀ (η : (Fin 2 → ℝ) → ℝ) (c : ℝ), ContDiff ℝ 1 η → HasCompactSupport η → tsupport η ⊆ Metric.ball x₀ R → |c| ≤ M₀ → ∫ x, η x ^ 2 * ∑ k, (smthGrad w x k) ^ 2 ≤ C₁ * (∫ x, (w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2) + C₂ * ∫ x, η x ^ 2 :=
by
  
  have hscalar : ∀ (a₁ a₂ b₁ b₂ e d P₁ P₂ q : ℝ), |d| ≤ 2 * M₀ →
      lam * (a₁ ^ 2 + a₂ ^ 2) - K ≤ P₁ * a₁ + P₂ * a₂ →
      |P₁| ≤ Lam * (1 + (|a₁| + |a₂|)) → |P₂| ≤ Lam * (1 + (|a₁| + |a₂|)) →
      |q| ≤ Lam * (1 + (|a₁| + |a₂|)) →
      lam ^ 2 * (e ^ 2 * (a₁ ^ 2 + a₂ ^ 2)) ≤
        2 * lam * (P₁ * (e ^ 2 * a₁ + 2 * e * d * b₁) + P₂ * (e ^ 2 * a₂ + 2 * e * d * b₂)
          + q * (e ^ 2 * d))
        + (4 * lam + 32 * Lam ^ 2) * (d ^ 2 * (b₁ ^ 2 + b₂ ^ 2))
        + 2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) * e ^ 2 := by
    intro a₁ a₂ b₁ b₂ e d P₁ P₂ q hd hco hP₁ hP₂ hq
    have h1 : (|a₁| + |a₂|) ^ 2 ≤ 2 * (a₁ ^ 2 + a₂ ^ 2) := by
      rw [← sq_abs a₁, ← sq_abs a₂]; nlinarith [sq_nonneg (|a₁| - |a₂|)]
    have h2 : (|b₁| + |b₂|) ^ 2 ≤ 2 * (b₁ ^ 2 + b₂ ^ 2) := by
      rw [← sq_abs b₁, ← sq_abs b₂]; nlinarith [sq_nonneg (|b₁| - |b₂|)]
    have hs0 : 0 ≤ |a₁| + |a₂| := by positivity
    have hβ0 : 0 ≤ |b₁| + |b₂| := by positivity
    generalize |a₁| + |a₂| = s at h1 hs0 hP₁ hP₂ hq
    have hL : 0 ≤ Lam * (1 + s) := mul_nonneg hLam (by linarith)
    have h3 : |P₁ * b₁ + P₂ * b₂| ≤ Lam * (1 + s) * (|b₁| + |b₂|) := by
      calc |P₁ * b₁ + P₂ * b₂| ≤ |P₁ * b₁| + |P₂ * b₂| := abs_add_le _ _
        _ = |P₁| * |b₁| + |P₂| * |b₂| := by rw [abs_mul, abs_mul]
        _ ≤ Lam * (1 + s) * |b₁| + Lam * (1 + s) * |b₂| :=
            add_le_add (mul_le_mul_of_nonneg_right hP₁ (abs_nonneg _))
              (mul_le_mul_of_nonneg_right hP₂ (abs_nonneg _))
        _ = Lam * (1 + s) * (|b₁| + |b₂|) := by ring
    generalize |b₁| + |b₂| = β at h2 hβ0 h3
    have h6 : -(2 * |e| * |d| * (Lam * (1 + s) * β)) ≤ 2 * e * d * (P₁ * b₁ + P₂ * b₂) := by
      have habs : |2 * e * d * (P₁ * b₁ + P₂ * b₂)| ≤ 2 * |e| * |d| * (Lam * (1 + s) * β) := by
        rw [abs_mul, abs_mul, abs_mul, abs_two]
        exact mul_le_mul_of_nonneg_left h3 (by positivity)
      linarith [neg_abs_le (2 * e * d * (P₁ * b₁ + P₂ * b₂))]
    have h9 : -(Lam * (1 + s) * (e ^ 2 * (2 * M₀))) ≤ q * (e ^ 2 * d) := by
      have habs : |q * (e ^ 2 * d)| ≤ Lam * (1 + s) * (e ^ 2 * (2 * M₀)) := by
        rw [abs_mul, abs_mul, abs_of_nonneg (sq_nonneg e)]
        exact mul_le_mul hq (mul_le_mul_of_nonneg_left hd (sq_nonneg e)) (by positivity) hL
      linarith [neg_abs_le (q * (e ^ 2 * d))]
    have hlam2 : 0 ≤ 2 * lam := by linarith
    have h4 : 2 * lam * (e ^ 2 * (lam * (a₁ ^ 2 + a₂ ^ 2) - K)) ≤
        2 * lam * (e ^ 2 * (P₁ * a₁ + P₂ * a₂)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hco (sq_nonneg e)) hlam2
    have h6' := mul_le_mul_of_nonneg_left h6 hlam2
    have h9' := mul_le_mul_of_nonneg_left h9 hlam2
    have h7 : 16 * lam * Lam * |e| * s * |d| * β ≤
        lam ^ 2 * e ^ 2 * s ^ 2 + 64 * Lam ^ 2 * d ^ 2 * β ^ 2 := by
      rw [← sq_abs e, ← sq_abs d]
      nlinarith [sq_nonneg (lam * |e| * s - 8 * Lam * |d| * β)]
    have h8 : 2 * lam * (2 * Lam * |e| * |d| * β) ≤ 2 * lam * (Lam ^ 2 * e ^ 2 + d ^ 2 * β ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ hlam2
      rw [← sq_abs e, ← sq_abs d]
      nlinarith [sq_nonneg (Lam * |e| - |d| * β)]
    have h10 : 16 * lam * M₀ * Lam * e ^ 2 * s ≤
        lam ^ 2 * e ^ 2 * s ^ 2 + 64 * M₀ ^ 2 * Lam ^ 2 * e ^ 2 := by
      nlinarith [mul_nonneg (sq_nonneg e) (sq_nonneg (lam * s - 8 * M₀ * Lam))]
    have h1' : lam ^ 2 * e ^ 2 * s ^ 2 ≤ lam ^ 2 * e ^ 2 * (2 * (a₁ ^ 2 + a₂ ^ 2)) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    have h2' : (2 * lam + 16 * Lam ^ 2) * d ^ 2 * β ^ 2 ≤
        (2 * lam + 16 * Lam ^ 2) * d ^ 2 * (2 * (b₁ ^ 2 + b₂ ^ 2)) :=
      mul_le_mul_of_nonneg_left h2 (by positivity)
    linarith [h4, h6', h9', h7, h8, h10, h1', h2']
  
  have hgradφ : ∀ (η w : (Fin 2 → ℝ) → ℝ) (c : ℝ), ContDiff ℝ 1 η → ContDiff ℝ 1 w →
      ∀ (x : Fin 2 → ℝ) (k : Fin 2),
      smthGrad (fun y => η y * (η y * (w y - c))) x k =
        η x ^ 2 * smthGrad w x k + 2 * η x * (w x - c) * smthGrad η x k := by
    intro η w c hη hw x k
    have hdη : DifferentiableAt ℝ η x := hη.differentiable (by norm_num) x
    have hdw : DifferentiableAt ℝ w x := hw.differentiable (by norm_num) x
    have hdwc : DifferentiableAt ℝ (fun y => w y - c) x := hdw.sub_const c
    have hdi : DifferentiableAt ℝ (fun y => η y * (w y - c)) x := hdη.mul hdwc
    unfold smthGrad
    rw [fderiv_fun_mul hdη hdi, fderiv_fun_mul hdη hdwc, fderiv_sub_const]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have e1 : ∀ X : ℝ, lam ^ 2 * (2 / lam * X) = 2 * lam * X := fun X => by
    field_simp
  have e2 : ∀ X : ℝ, lam ^ 2 * ((4 * lam + 32 * Lam ^ 2) / lam ^ 2 * X) =
      (4 * lam + 32 * Lam ^ 2) * X := fun X => by
    field_simp
  have e3 : ∀ X : ℝ, lam ^ 2 *
      (2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) / lam ^ 2 * X) =
      2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) * X := fun X => by
    field_simp
  refine ⟨(4 * lam + 32 * Lam ^ 2) / lam ^ 2,
    2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) / lam ^ 2,
    by positivity, by positivity, ?_⟩
  intro w P p hw hP hp hwb hcoer hPb hpb hweak η c hη hηc hηB hc
  have hgφ := hgradφ η w c hη hw
  
  have hη0 : ∀ x, x ∉ tsupport η → η x = 0 := fun x hx => image_eq_zero_of_notMem_tsupport hx
  have hgη0 : ∀ x, x ∉ tsupport η → ∀ k, smthGrad η x k = 0 := by
    intro x hx k
    unfold smthGrad
    rw [fderiv_of_notMem_tsupport ℝ hx]
    rfl
  have hcl : ∀ x, x ∉ Metric.closedBall x₀ R → x ∉ tsupport η := fun x hx hxη =>
    hx (Metric.ball_subset_closedBall (hηB hxη))
  
  have hφ : ContDiff ℝ 1 (fun y => η y * (η y * (w y - c))) :=
    hη.mul (hη.mul (hw.sub contDiff_const))
  have hφc : HasCompactSupport (fun y => η y * (η y * (w y - c))) :=
    HasCompactSupport.intro hηc.isCompact (fun x hx => by simp [hη0 x hx])
  have hφB : tsupport (fun y => η y * (η y * (w y - c))) ⊆ Metric.ball x₀ R :=
    (tsupport_mul_subset_left).trans hηB
  have hF0 := hweak _ hφ hφc hφB
  
  have hgw : ∀ k, Continuous (fun x => smthGrad w x k) := fun k => by
    show Continuous (fun x => fderiv ℝ w x (Pi.single k 1))
    exact (hw.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hgη : ∀ k, Continuous (fun x => smthGrad η x k) := fun k => by
    show Continuous (fun x => fderiv ℝ η x (Pi.single k 1))
    exact (hη.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hgφc : ∀ k, Continuous (fun x => smthGrad (fun y => η y * (η y * (w y - c))) x k) :=
    fun k => by
      show Continuous (fun x => fderiv ℝ (fun y => η y * (η y * (w y - c))) x (Pi.single k 1))
      exact (hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const
  
  have hFint : MeasureTheory.Integrable (fun x => ∑ k, P x k *
      smthGrad (fun y => η y * (η y * (w y - c))) x k +
      p x * (η x * (η x * (w x - c)))) := by
    have hFc : ContinuousOn (fun x => ∑ k, P x k *
        smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c)))) (Metric.closedBall x₀ R) := by
      refine ContinuousOn.add (continuousOn_finset_sum _ (fun k _ => ?_)) ?_
      · exact (continuousOn_pi.mp hP k).mul (hgφc k).continuousOn
      · exact hp.mul hφ.continuous.continuousOn
    have hsupp : Function.support (fun x => ∑ k, P x k *
        smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c)))) ⊆ Metric.closedBall x₀ R := by
      intro x hx
      by_contra hxc
      apply hx
      have h1 := hcl x hxc
      simp [hgφ, hη0 x h1, hgη0 x h1]
    exact (MeasureTheory.integrableOn_iff_integrable_of_support_subset hsupp).mp
      (hFc.integrableOn_compact (isCompact_closedBall x₀ R))
  have hGint : MeasureTheory.Integrable (fun x => η x ^ 2 * ∑ k, (smthGrad w x k) ^ 2) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (hη.continuous.pow 2).mul
        (continuous_finset_sum _ (fun k _ => (hgw k).pow 2))
    · exact HasCompactSupport.intro hηc.isCompact (fun x hx => by simp [hη0 x hx])
  have hHint : MeasureTheory.Integrable
      (fun x => (w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2) := by
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact ((hw.continuous.sub continuous_const).pow 2).mul
        (continuous_finset_sum _ (fun k _ => (hgη k).pow 2))
    · exact HasCompactSupport.intro hηc.isCompact (fun x hx => by simp [hgη0 x hx])
  have hEint : MeasureTheory.Integrable (fun x => η x ^ 2) := by
    refine Continuous.integrable_of_hasCompactSupport (hη.continuous.pow 2) ?_
    exact HasCompactSupport.intro hηc.isCompact (fun x hx => by simp [hη0 x hx])
  
  have hpt : ∀ x, η x ^ 2 * ∑ k, (smthGrad w x k) ^ 2 ≤
      2 / lam * (∑ k, P x k * smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c)))) +
      (4 * lam + 32 * Lam ^ 2) / lam ^ 2 * ((w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2) +
      2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) / lam ^ 2 *
        η x ^ 2 := by
    intro x
    refine le_of_mul_le_mul_left ?_ (pow_pos hlam 2)
    rw [mul_add, mul_add, e1, e2, e3]
    simp only [Fin.sum_univ_two, hgφ]
    by_cases hx : x ∈ tsupport η
    · have hxc : x ∈ Metric.closedBall x₀ R := Metric.ball_subset_closedBall (hηB hx)
      have hco := hcoer x hxc
      have hP0 := hPb x hxc 0
      have hP1 := hPb x hxc 1
      have hq := hpb x hxc
      simp only [Fin.sum_univ_two] at hco hP0 hP1 hq
      have hd : |w x - c| ≤ 2 * M₀ := by
        have h1 := abs_le.mp (hwb x hxc)
        have h2 := abs_le.mp hc
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      have key := hscalar (smthGrad w x 0) (smthGrad w x 1) (smthGrad η x 0) (smthGrad η x 1)
        (η x) (w x - c) (P x 0) (P x 1) (p x) hd hco hP0 hP1 hq
      linarith [key]
    · simp [hη0 x hx, hgη0 x hx]
  
  have hRint : MeasureTheory.Integrable (fun x =>
      2 / lam * (∑ k, P x k * smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c)))) +
      (4 * lam + 32 * Lam ^ 2) / lam ^ 2 * ((w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2) +
      2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) / lam ^ 2 *
        η x ^ 2) :=
    ((hFint.const_mul _).add (hHint.const_mul _)).add (hEint.const_mul _)
  have hmono := MeasureTheory.integral_mono hGint hRint hpt
  have hA : MeasureTheory.Integrable (fun x =>
      2 / lam * (∑ k, P x k * smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c))))) := hFint.const_mul _
  have hB : MeasureTheory.Integrable (fun x =>
      (4 * lam + 32 * Lam ^ 2) / lam ^ 2 * ((w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2)) :=
    hHint.const_mul _
  have hAB : MeasureTheory.Integrable (fun x =>
      2 / lam * (∑ k, P x k * smthGrad (fun y => η y * (η y * (w y - c))) x k +
        p x * (η x * (η x * (w x - c)))) +
      (4 * lam + 32 * Lam ^ 2) / lam ^ 2 * ((w x - c) ^ 2 * ∑ k, (smthGrad η x k) ^ 2)) :=
    hA.add hB
  have hC : MeasureTheory.Integrable (fun x =>
      2 * (lam * K + lam * Lam ^ 2 + 2 * lam * M₀ * Lam + 8 * M₀ ^ 2 * Lam ^ 2) / lam ^ 2 *
        η x ^ 2) := hEint.const_mul _
  rw [MeasureTheory.integral_add hAB hC, MeasureTheory.integral_add hA hB,
    MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
    MeasureTheory.integral_const_mul] at hmono
  have hF0' : ∫ x, (∑ k, P x k * smthGrad (fun y => η y * (η y * (w y - c))) x k +
      p x * (η x * (η x * (w x - c)))) = 0 := hF0
  rw [hF0', mul_zero, zero_add] at hmono
  exact hmono

theorem slh_cutoff : ∃ Cη : ℝ, 0 ≤ Cη ∧ ∀ (y : Fin 2 → ℝ) (r : ℝ), 0 < r → ∃ η : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 η ∧ HasCompactSupport η ∧ tsupport η ⊆ Metric.closedBall y (7 * r / 4) ∧ (∀ x, 0 ≤ η x ∧ η x ≤ 1) ∧ (∀ x ∈ Metric.closedBall y r, η x = 1 ∧ smthGrad η x = 0) ∧ (∀ x, ∑ k, (smthGrad η x k) ^ 2 ≤ Cη / r ^ 2) :=
by
  have hS1 : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff
  obtain ⟨φ, hφc, hφ01, hφ1, hφ0⟩ : ∃ φ : ℝ → ℝ, ContDiff ℝ 1 φ ∧ (∀ t, 0 ≤ φ t ∧ φ t ≤ 1) ∧
      (∀ t, |t| ≤ 5 / 4 → φ t = 1) ∧ (∀ t, 3 / 2 ≤ |t| → φ t = 0) := by
    refine ⟨fun t => Real.smoothTransition (6 - 4 * t) * Real.smoothTransition (6 + 4 * t),
      (hS1.comp (contDiff_const.sub (contDiff_const.mul contDiff_id))).mul
        (hS1.comp (contDiff_const.add (contDiff_const.mul contDiff_id))), ?_, ?_, ?_⟩
    · intro t
      have a1 := Real.smoothTransition.nonneg (6 - 4 * t)
      have a2 := Real.smoothTransition.le_one (6 - 4 * t)
      have b1 := Real.smoothTransition.nonneg (6 + 4 * t)
      have b2 := Real.smoothTransition.le_one (6 + 4 * t)
      exact ⟨mul_nonneg a1 b1, mul_le_one₀ a2 b1 b2⟩
    · intro t ht
      obtain ⟨h1, h2⟩ := abs_le.mp ht
      show Real.smoothTransition (6 - 4 * t) * Real.smoothTransition (6 + 4 * t) = 1
      rw [Real.smoothTransition.one_of_one_le (by linarith),
        Real.smoothTransition.one_of_one_le (by linarith), mul_one]
    · intro t ht
      show Real.smoothTransition (6 - 4 * t) * Real.smoothTransition (6 + 4 * t) = 0
      rcases le_or_gt 0 t with h | h
      · rw [abs_of_nonneg h] at ht
        rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
      · rw [abs_of_neg h] at ht
        rw [Real.smoothTransition.zero_of_nonpos (by linarith : 6 + 4 * t ≤ 0), mul_zero]
  obtain ⟨Φ, hΦc, hΦ01, hΦ1, hΦsupp⟩ : ∃ Φ : (Fin 2 → ℝ) → ℝ, ContDiff ℝ 1 Φ ∧
      (∀ w, 0 ≤ Φ w ∧ Φ w ≤ 1) ∧ (∀ w : Fin 2 → ℝ, (∀ k, |w k| ≤ 5 / 4) → Φ w = 1) ∧
      (∀ w : Fin 2 → ℝ, Φ w ≠ 0 → ∀ k, |w k| < 3 / 2) := by
    refine ⟨fun w => φ (w 0) * φ (w 1),
      (hφc.comp (contDiff_apply ℝ ℝ (0 : Fin 2))).mul (hφc.comp (contDiff_apply ℝ ℝ (1 : Fin 2))),
      fun w => ⟨mul_nonneg (hφ01 _).1 (hφ01 _).1, mul_le_one₀ (hφ01 _).2 (hφ01 _).1 (hφ01 _).2⟩,
      ?_, ?_⟩
    · intro w hw
      show φ (w 0) * φ (w 1) = 1
      rw [hφ1 _ (hw 0), hφ1 _ (hw 1), mul_one]
    · intro w hw
      have h0' : |w 0| < 3 / 2 := by
        by_contra hk
        push_neg at hk
        exact hw (by show φ (w 0) * φ (w 1) = 0; rw [hφ0 _ hk, zero_mul])
      have h1' : |w 1| < 3 / 2 := by
        by_contra hk
        push_neg at hk
        exact hw (by show φ (w 0) * φ (w 1) = 0; rw [hφ0 _ hk, mul_zero])
      exact Fin.forall_fin_two.mpr ⟨h0', h1'⟩
  have hΦd0 : ∀ w : Fin 2 → ℝ, (∀ k, |w k| < 5 / 4) → fderiv ℝ Φ w = 0 := by
    intro w hw
    have hopen : IsOpen {v : Fin 2 → ℝ | ∀ k, |v k| < 5 / 4} := by
      have he : {v : Fin 2 → ℝ | ∀ k, |v k| < 5 / 4} = ⋂ k, {v : Fin 2 → ℝ | |v k| < 5 / 4} := by
        ext v; simp
      rw [he]
      exact isOpen_iInter_of_finite
        (fun k => isOpen_lt ((continuous_apply k).abs) continuous_const)
    have hev : Φ =ᶠ[nhds w] fun _ => (1 : ℝ) :=
      Filter.eventuallyEq_of_mem (hopen.mem_nhds hw) (fun v hv => hΦ1 v (fun k => (hv k).le))
    rw [hev.fderiv_eq]
    exact fderiv_const_apply 1
  have hΦcpt : HasCompactSupport Φ := by
    apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Fin 2 → ℝ) (3 / 2))
    intro w hw
    rw [mem_closedBall_zero_iff, pi_norm_le_iff_of_nonneg (by norm_num)]
    intro k
    rw [Real.norm_eq_abs]
    exact (hΦsupp w hw k).le
  have hfc : Continuous (fderiv ℝ Φ) := hΦc.continuous_fderiv (by norm_num)
  obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support (hΦcpt.fderiv (𝕜 := ℝ))
  have hΦd : Differentiable ℝ Φ := hΦc.differentiable (by norm_num)
  refine ⟨2 * (max C 0) ^ 2, by positivity, ?_⟩
  intro y r hr
  have hchain : ∀ x, HasFDerivAt (fun x => Φ (r⁻¹ • (x - y)))
      ((fderiv ℝ Φ (r⁻¹ • (x - y))).comp (r⁻¹ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ))) x := by
    intro x
    have hA : HasFDerivAt (fun x : Fin 2 → ℝ => r⁻¹ • (x - y))
        (r⁻¹ • ContinuousLinearMap.id ℝ (Fin 2 → ℝ)) x :=
      ((hasFDerivAt_id x).sub_const y).const_smul r⁻¹
    exact (hΦd _).hasFDerivAt.comp x hA
  have hgrad : ∀ x k, smthGrad (fun x => Φ (r⁻¹ • (x - y))) x k =
      r⁻¹ * fderiv ℝ Φ (r⁻¹ • (x - y)) (Pi.single k 1) := by
    intro x k
    unfold smthGrad
    rw [(hchain x).fderiv]
    simp
  have hsupp : Function.support (fun x => Φ (r⁻¹ • (x - y))) ⊆ Metric.closedBall y (3 * r / 2) := by
    intro x hx
    have h := hΦsupp _ hx
    rw [Metric.mem_closedBall, dist_pi_le_iff (by positivity)]
    intro k
    have hk := h k
    simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hr] at hk
    rw [Real.dist_eq]
    have := (inv_mul_lt_iff₀ hr).1 hk
    linarith
  refine ⟨fun x => Φ (r⁻¹ • (x - y)), hΦc.comp ((contDiff_id.sub contDiff_const).const_smul r⁻¹),
    HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall y (3 * r / 2)) hsupp,
    ?_, fun x => hΦ01 _, ?_, ?_⟩
  · refine (closure_minimal hsupp Metric.isClosed_closedBall).trans ?_
    exact Metric.closedBall_subset_closedBall (by linarith)
  · intro x hx
    have hz : ∀ k, |(r⁻¹ • (x - y)) k| ≤ 1 := by
      intro k
      rw [Metric.mem_closedBall, dist_pi_le_iff hr.le] at hx
      have hk := hx k
      rw [Real.dist_eq] at hk
      simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul, abs_mul, abs_inv, abs_of_pos hr]
      rw [inv_mul_le_iff₀ hr]
      linarith
    refine ⟨hΦ1 _ (fun k => (hz k).trans (by norm_num)), ?_⟩
    funext k
    rw [hgrad, hΦd0 _ (fun k => (hz k).trans_lt (by norm_num))]
    simp
  · intro x
    have hb : ∀ k, (smthGrad (fun x => Φ (r⁻¹ • (x - y))) x k) ^ 2 ≤ (max C 0) ^ 2 / r ^ 2 := by
      intro k
      rw [hgrad]
      have ha : |fderiv ℝ Φ (r⁻¹ • (x - y)) (Pi.single k 1)| ≤ max C 0 := by
        calc |fderiv ℝ Φ (r⁻¹ • (x - y)) (Pi.single k 1)|
            = ‖fderiv ℝ Φ (r⁻¹ • (x - y)) (Pi.single k 1)‖ := (Real.norm_eq_abs _).symm
          _ ≤ ‖fderiv ℝ Φ (r⁻¹ • (x - y))‖ * ‖(Pi.single k (1 : ℝ) : Fin 2 → ℝ)‖ :=
              ContinuousLinearMap.le_opNorm _ _
          _ = ‖fderiv ℝ Φ (r⁻¹ • (x - y))‖ := by rw [Pi.norm_single, norm_one, mul_one]
          _ ≤ C := hC _
          _ ≤ max C 0 := le_max_left _ _
      have ha2 : (fderiv ℝ Φ (r⁻¹ • (x - y)) (Pi.single k 1)) ^ 2 ≤ (max C 0) ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) ha 2
      rw [mul_pow, inv_pow, inv_mul_eq_div]
      gcongr
    rw [Fin.sum_univ_two]
    calc _ ≤ (max C 0) ^ 2 / r ^ 2 + (max C 0) ^ 2 / r ^ 2 := add_le_add (hb 0) (hb 1)
      _ = 2 * (max C 0) ^ 2 / r ^ 2 := by ring

theorem slh_box_poincare (w : (Fin 2 → ℝ) → ℝ) (hw : ContDiff ℝ 1 w) (a b : Fin 2 → ℝ) (L : ℝ) (hab : ∀ k, a k < b k) (hL : ∀ k, b k - a k ≤ L) : ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), (w x - ⨍ z in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), w z) ^ 2 ≤ L ^ 2 * ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), ∑ k, (smthGrad w x k) ^ 2 :=
by
  
  have h1d : ∀ (φ φ' : ℝ → ℝ), (∀ t, HasDerivAt φ (φ' t) t) → Continuous φ' →
      ∀ (α β s t : ℝ), s ∈ Set.Icc α β → t ∈ Set.Icc α β →
        (φ s - φ t) ^ 2 ≤ (β - α) * ∫ u in α..β, φ' u ^ 2 := by
    intro φ φ' hφ hφ' α β s t hs ht
    have hJ : 0 ≤ ∫ u in α..β, φ' u ^ 2 :=
      intervalIntegral.integral_nonneg (hs.1.trans hs.2) (fun u _ => sq_nonneg _)
    have key : ∀ s t : ℝ, α ≤ t → t ≤ s → s ≤ β →
        (φ s - φ t) ^ 2 ≤ (β - α) * ∫ u in α..β, φ' u ^ 2 := by
      intro s t hαt hts hsβ
      have hint1 : IntervalIntegrable φ' volume t s := hφ'.intervalIntegrable t s
      have hint2 : IntervalIntegrable (fun u => φ' u ^ 2) volume t s :=
        (hφ'.pow 2).intervalIntegrable t s
      have hI1 : ∫ u in t..s, φ' u = φ s - φ t :=
        intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hφ u) hint1
      have hmono : ∫ u in t..s, φ' u ^ 2 ≤ ∫ u in α..β, φ' u ^ 2 :=
        intervalIntegral.integral_mono_interval hαt hts hsβ
          (Filter.Eventually.of_forall (fun u => sq_nonneg _))
          ((hφ'.pow 2).intervalIntegrable α β)
      have hnn : 0 ≤ ∫ u in t..s, ((s - t) * φ' u - (φ s - φ t)) ^ 2 :=
        intervalIntegral.integral_nonneg hts (fun u _ => sq_nonneg _)
      have hexp : ∫ u in t..s, ((s - t) * φ' u - (φ s - φ t)) ^ 2 =
          (s - t) ^ 2 * (∫ u in t..s, φ' u ^ 2) - 2 * (s - t) * (φ s - φ t) * (∫ u in t..s, φ' u)
            + (s - t) * (φ s - φ t) ^ 2 := by
        have hfun : (fun u => ((s - t) * φ' u - (φ s - φ t)) ^ 2) =
            fun u => ((s - t) ^ 2 * φ' u ^ 2 - (2 * (s - t) * (φ s - φ t)) * φ' u)
              + (φ s - φ t) ^ 2 := by
          funext u; ring
        rw [hfun, intervalIntegral.integral_add ((hint2.const_mul _).sub (hint1.const_mul _))
            intervalIntegrable_const,
          intervalIntegral.integral_sub (hint2.const_mul _) (hint1.const_mul _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
          intervalIntegral.integral_const, smul_eq_mul]
      rw [hexp, hI1] at hnn
      have hCS : (φ s - φ t) ^ 2 ≤ (s - t) * ∫ u in t..s, φ' u ^ 2 := by
        rcases eq_or_lt_of_le hts with h | h
        · subst h
          simp
        · have hδ : 0 < s - t := sub_pos.2 h
          have h2 : 0 ≤ (s - t) * ((s - t) * (∫ u in t..s, φ' u ^ 2) - (φ s - φ t) ^ 2) := by
            nlinarith
          have h3 := (mul_nonneg_iff_of_pos_left hδ).1 h2
          linarith
      calc (φ s - φ t) ^ 2 ≤ (s - t) * ∫ u in t..s, φ' u ^ 2 := hCS
        _ ≤ (s - t) * ∫ u in α..β, φ' u ^ 2 := mul_le_mul_of_nonneg_left hmono (by linarith)
        _ ≤ (β - α) * ∫ u in α..β, φ' u ^ 2 := mul_le_mul_of_nonneg_right (by linarith) hJ
    rcases le_total t s with h | h
    · exact key s t ht.1 h hs.2
    · have := key t s hs.1 h ht.2
      calc (φ s - φ t) ^ 2 = (φ t - φ s) ^ 2 := by ring
        _ ≤ _ := this
  
  have two_leg : ∀ x y : Fin 2 → ℝ, (∀ k, x k ∈ Set.Icc (a k) (b k)) →
      (∀ k, y k ∈ Set.Icc (a k) (b k)) →
      (w x - w y) ^ 2 ≤ 2 * (b 0 - a 0) * (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2)
        + 2 * (b 1 - a 1) * ∫ s in a 1..b 1, (smthGrad w ![y 0, s] 1) ^ 2 := by
    intro x y hx hy
    have hdiff : Differentiable ℝ w := hw.differentiable (by norm_num)
    have hfd : Continuous (fun z => fderiv ℝ w z) := hw.continuous_fderiv (by norm_num)
    have leg : ∀ (p v : Fin 2 → ℝ), (∀ t, HasDerivAt (fun t : ℝ => w (p + t • v))
        (fderiv ℝ w (p + t • v) v) t) ∧
        Continuous (fun t : ℝ => fderiv ℝ w (p + t • v) v) := by
      intro p v
      have hpath : ∀ t : ℝ, HasDerivAt (fun t : ℝ => p + t • v) v t := by
        intro t
        simpa using ((hasDerivAt_id t).smul_const v).const_add p
      refine ⟨fun t => ?_, ?_⟩
      · exact (hdiff (p + t • v)).hasFDerivAt.comp_hasDerivAt t (hpath t)
      · exact (hfd.comp (continuous_const.add (continuous_id.smul continuous_const))).clm_apply
          continuous_const
    have e0 : ∀ t : ℝ, (![0, x 1] : Fin 2 → ℝ) + t • (Pi.single 0 1 : Fin 2 → ℝ) = ![t, x 1] := by
      intro t; funext i; fin_cases i <;> simp
    have e1 : ∀ s : ℝ, (![y 0, 0] : Fin 2 → ℝ) + s • (Pi.single 1 1 : Fin 2 → ℝ) = ![y 0, s] := by
      intro s; funext i; fin_cases i <;> simp
    obtain ⟨hd0, hc0⟩ := leg ![0, x 1] (Pi.single 0 1)
    obtain ⟨hd1, hc1⟩ := leg ![y 0, 0] (Pi.single 1 1)
    simp only [e0] at hd0 hc0
    simp only [e1] at hd1 hc1
    have hU := h1d (fun t => w ![t, x 1]) (fun t => smthGrad w ![t, x 1] 0) hd0 hc0
      (a 0) (b 0) (x 0) (y 0) (hx 0) (hy 0)
    have hW := h1d (fun s => w ![y 0, s]) (fun s => smthGrad w ![y 0, s] 1) hd1 hc1
      (a 1) (b 1) (x 1) (y 1) (hx 1) (hy 1)
    have hxe : x = ![x 0, x 1] := by funext i; fin_cases i <;> rfl
    have hye : y = ![y 0, y 1] := by funext i; fin_cases i <;> rfl
    have hsplit : w x - w y =
        (w ![x 0, x 1] - w ![y 0, x 1]) + (w ![y 0, x 1] - w ![y 0, y 1]) := by
      rw [← hxe, ← hye]; ring
    rw [hsplit]
    nlinarith [sq_nonneg ((w ![x 0, x 1] - w ![y 0, x 1]) - (w ![y 0, x 1] - w ![y 0, y 1]))]
  
  have hvarG : ∀ (S : Set (Fin 2 → ℝ)), volume S ≠ 0 → volume S ≠ ⊤ →
      ∀ (f : (Fin 2 → ℝ) → ℝ), IntegrableOn f S → IntegrableOn (fun x => f x ^ 2) S →
      2 * (volume S).toReal * ∫ x in S, (f x - ⨍ z in S, f z) ^ 2 =
        ∫ x in S, (∫ y in S, (f x - f y) ^ 2) := by
    intro S hS0 hSt f hf hf2
    have hVpos : 0 < (volume S).toReal := ENNReal.toReal_pos hS0 hSt
    have hc : ∀ c : ℝ, IntegrableOn (fun _ : Fin 2 → ℝ => c) S := fun c =>
      integrableOn_const (by simpa [lt_top_iff_ne_top] using hSt)
    have hcI : ∀ c : ℝ, ∫ _ in S, c = (volume S).toReal * c := by
      intro c; rw [setIntegral_const, smul_eq_mul, measureReal_def]
    have hm : ⨍ z in S, f z = (volume S).toReal⁻¹ * ∫ z in S, f z := by
      rw [setAverage_eq, smul_eq_mul, measureReal_def]
    set V := (volume S).toReal
    set I1 := ∫ z in S, f z
    set I2 := ∫ z in S, f z ^ 2
    set m := ⨍ z in S, f z
    have hinner : ∀ x, ∫ y in S, (f x - f y) ^ 2 = V * f x ^ 2 - 2 * f x * I1 + I2 := by
      intro x
      have hfun : (fun y => (f x - f y) ^ 2) =
          fun y => (f x ^ 2 - (2 * f x) * f y) + f y ^ 2 := by
        funext y; ring
      have hi1 : IntegrableOn (fun y => f x ^ 2 - (2 * f x) * f y) S :=
        (hc _).sub (hf.const_mul _)
      have hi2 : IntegrableOn (fun y => (2 * f x) * f y) S := hf.const_mul _
      rw [hfun, integral_add hi1 hf2, integral_sub (hc _) hi2, hcI, integral_const_mul]
    have hrhs : ∫ x in S, (∫ y in S, (f x - f y) ^ 2) = 2 * V * I2 - 2 * I1 ^ 2 := by
      simp_rw [hinner]
      have hfun : (fun x => V * f x ^ 2 - 2 * f x * I1 + I2) =
          fun x => (V * f x ^ 2 - (2 * I1) * f x) + I2 := by
        funext x; ring
      have hi1 : IntegrableOn (fun x => V * f x ^ 2 - (2 * I1) * f x) S :=
        (hf2.const_mul _).sub (hf.const_mul _)
      have hi2 : IntegrableOn (fun x => V * f x ^ 2) S := hf2.const_mul _
      have hi3 : IntegrableOn (fun x => (2 * I1) * f x) S := hf.const_mul _
      rw [hfun, integral_add hi1 (hc _), integral_sub hi2 hi3, integral_const_mul,
        integral_const_mul, hcI]
      ring
    have hlhs : ∫ x in S, (f x - m) ^ 2 = I2 - 2 * m * I1 + V * m ^ 2 := by
      have hfun : (fun x => (f x - m) ^ 2) = fun x => (f x ^ 2 - (2 * m) * f x) + m ^ 2 := by
        funext x; ring
      have hi1 : IntegrableOn (fun x => f x ^ 2 - (2 * m) * f x) S := hf2.sub (hf.const_mul _)
      have hi3 : IntegrableOn (fun x => (2 * m) * f x) S := hf.const_mul _
      rw [hfun, integral_add hi1 (hc _), integral_sub hf2 hi3, integral_const_mul, hcI]
    rw [hrhs, hlhs, hm]
    have hV0 : V ≠ 0 := hVpos.ne'
    field_simp
    ring
  
  have hBF : ∀ H : (Fin 2 → ℝ) → ℝ, Continuous H →
      (∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), H x) =
          ∫ s in a 1..b 1, ∫ t in a 0..b 0, H ![t, s] ∧
      (∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), H x) =
          ∫ t in a 0..b 0, ∫ s in a 1..b 1, H ![t, s] := by
    intro H hH
    have hvc : Continuous (fun p : ℝ × ℝ => (![p.1, p.2] : Fin 2 → ℝ)) :=
      continuous_fst.matrixVecCons (continuous_snd.matrixVecCons continuous_const)
    have hGc : Continuous (fun p : ℝ × ℝ => H ![p.1, p.2]) := hH.comp hvc
    have hmp : MeasurePreserving (MeasurableEquiv.finTwoArrow : (Fin 2 → ℝ) ≃ᵐ ℝ × ℝ)
        volume volume :=
      volume_preserving_finTwoArrow ℝ
    have hpre : Set.univ.pi (fun k => Set.Ioo (a k) (b k)) =
        (MeasurableEquiv.finTwoArrow : (Fin 2 → ℝ) ≃ᵐ ℝ × ℝ) ⁻¹'
          (Set.Ioo (a 0) (b 0) ×ˢ Set.Ioo (a 1) (b 1)) := by
      ext x
      simp [Fin.forall_fin_two, MeasurableEquiv.finTwoArrow_apply]
    have key := hmp.setIntegral_preimage_emb MeasurableEquiv.finTwoArrow.measurableEmbedding
      (fun p : ℝ × ℝ => H ![p.1, p.2]) (Set.Ioo (a 0) (b 0) ×ˢ Set.Ioo (a 1) (b 1))
    have h1 : (∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), H x) =
        ∫ p in Set.Ioo (a 0) (b 0) ×ˢ Set.Ioo (a 1) (b 1), H ![p.1, p.2] := by
      rw [hpre]
      refine Eq.trans ?_ key
      congr 1
      funext x
      congr 1
      funext i
      fin_cases i <;> simp [MeasurableEquiv.finTwoArrow_apply]
    have hint : IntegrableOn (fun p : ℝ × ℝ => H ![p.1, p.2])
        (Set.Ioo (a 0) (b 0) ×ˢ Set.Ioo (a 1) (b 1)) (volume.prod volume) := by
      rw [← Measure.volume_eq_prod]
      exact (hGc.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
        (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
    have hIoo : ∀ (α β : ℝ), α ≤ β → ∀ g : ℝ → ℝ,
        ∫ u in Set.Ioo α β, g u = ∫ u in α..β, g u := by
      intro α β h g
      rw [intervalIntegral.integral_of_le h, integral_Ioc_eq_integral_Ioo]
    have h0le := (hab 0).le
    have h1le := (hab 1).le
    constructor
    · rw [h1, Measure.volume_eq_prod, ← Measure.prod_restrict, integral_prod_symm _ (by
        rw [Measure.prod_restrict]; exact hint)]
      rw [hIoo _ _ h1le]
      congr 1
      funext s
      rw [hIoo _ _ h0le]
    · rw [h1, Measure.volume_eq_prod, setIntegral_prod _ hint, hIoo _ _ h0le]
      congr 1
      funext t
      rw [hIoo _ _ h1le]
  
  have hslice : ∀ F : (Fin 2 → ℝ) → ℝ, Continuous F →
      Continuous (fun x : Fin 2 → ℝ => ∫ t in a 0..b 0, F ![t, x 1]) ∧
      Continuous (fun x : Fin 2 → ℝ => ∫ s in a 1..b 1, F ![x 0, s]) ∧
      (∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), (∫ t in a 0..b 0, F ![t, x 1])) =
        (b 0 - a 0) * ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), F x ∧
      (∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), (∫ s in a 1..b 1, F ![x 0, s])) =
        (b 1 - a 1) * ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), F x := by
    intro F hF
    have hAc : Continuous (fun x : Fin 2 → ℝ => ∫ t in a 0..b 0, F ![t, x 1]) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun (x : Fin 2 → ℝ) (t : ℝ) => F ![t, x 1])
        (hF.comp (continuous_snd.matrixVecCons
          (((continuous_apply 1).comp continuous_fst).matrixVecCons continuous_const))) _ _
    have hBc : Continuous (fun x : Fin 2 → ℝ => ∫ s in a 1..b 1, F ![x 0, s]) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun (x : Fin 2 → ℝ) (s : ℝ) => F ![x 0, s])
        (hF.comp (((continuous_apply 0).comp continuous_fst).matrixVecCons
          (continuous_snd.matrixVecCons continuous_const))) _ _
    refine ⟨hAc, hBc, ?_, ?_⟩
    · rw [(hBF _ hAc).1, (hBF F hF).1, ← intervalIntegral.integral_const_mul]
      congr 1
      funext s
      simp only [Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_zero]
      rw [intervalIntegral.integral_const, smul_eq_mul]
    · rw [(hBF _ hBc).2, (hBF F hF).2, ← intervalIntegral.integral_const_mul]
      congr 1
      funext t
      simp only [Matrix.cons_val_zero]
      rw [intervalIntegral.integral_const, smul_eq_mul]
  
  have hwc : Continuous w := hw.continuous
  have hdc : ∀ k : Fin 2, Continuous (fun x => smthGrad w x k) := fun k =>
    (hw.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hg0c : Continuous (fun x => (smthGrad w x 0) ^ 2) := (hdc 0).pow 2
  have hg1c : Continuous (fun x => (smthGrad w x 1) ^ 2) := (hdc 1).pow 2
  obtain ⟨hA0c, -, hA0int, -⟩ := hslice (fun x => (smthGrad w x 0) ^ 2) hg0c
  obtain ⟨-, hB1c, -, hB1int⟩ := hslice (fun x => (smthGrad w x 1) ^ 2) hg1c
  have hvar := hvarG (Set.univ.pi (fun k => Set.Ioo (a k) (b k)))
  set Q : Set (Fin 2 → ℝ) := Set.univ.pi (fun k => Set.Ioo (a k) (b k)) with hQdef
  have hQm : MeasurableSet Q := MeasurableSet.univ_pi (fun k => measurableSet_Ioo)
  have hK : IsCompact (Set.univ.pi (fun k : Fin 2 => Set.Icc (a k) (b k))) :=
    isCompact_univ_pi (fun k => isCompact_Icc)
  have hQK : Q ⊆ Set.univ.pi (fun k : Fin 2 => Set.Icc (a k) (b k)) :=
    Set.pi_mono (fun k _ => Set.Ioo_subset_Icc_self)
  have IntQ : ∀ H : (Fin 2 → ℝ) → ℝ, Continuous H → IntegrableOn H Q := fun H hH =>
    (hH.continuousOn.integrableOn_compact hK).mono_set hQK
  have hl0 : 0 < b 0 - a 0 := sub_pos.2 (hab 0)
  have hl1 : 0 < b 1 - a 1 := sub_pos.2 (hab 1)
  have hV : (volume Q).toReal = (b 0 - a 0) * (b 1 - a 1) := by
    rw [hQdef, Real.volume_pi_Ioo_toReal (fun k => (hab k).le), Fin.prod_univ_two]
  have hVpos : 0 < (volume Q).toReal := by rw [hV]; positivity
  have hQ0 : volume Q ≠ 0 := (ENNReal.toReal_pos_iff.1 hVpos).1.ne'
  have hQt : volume Q ≠ ⊤ := (ENNReal.toReal_pos_iff.1 hVpos).2.ne
  have hconst : ∀ c : ℝ, IntegrableOn (fun _ : Fin 2 → ℝ => c) Q := fun c =>
    IntQ _ continuous_const
  have hcI : ∀ c : ℝ, ∫ _ in Q, c = (volume Q).toReal * c := by
    intro c
    rw [setIntegral_const, smul_eq_mul, measureReal_def]
  
  have s6 : ∀ x ∈ Q, ∫ y in Q, (w x - w y) ^ 2 ≤
      (volume Q).toReal * (2 * (b 0 - a 0) * (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2))
        + 2 * (b 1 - a 1) * ((b 1 - a 1) * ∫ x in Q, (smthGrad w x 1) ^ 2) := by
    intro x hx
    have hxI : ∀ k, x k ∈ Set.Icc (a k) (b k) := fun k =>
      Set.Ioo_subset_Icc_self (hx k (Set.mem_univ k))
    calc ∫ y in Q, (w x - w y) ^ 2
        ≤ ∫ y in Q, (2 * (b 0 - a 0) * (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2)
            + 2 * (b 1 - a 1) * ∫ s in a 1..b 1, (smthGrad w ![y 0, s] 1) ^ 2) := by
          refine setIntegral_mono_on (IntQ _ ((continuous_const.sub hwc).pow 2))
            (IntQ _ (continuous_const.add (continuous_const.mul hB1c))) hQm ?_
          intro y hy
          have hyI : ∀ k, y k ∈ Set.Icc (a k) (b k) := fun k =>
            Set.Ioo_subset_Icc_self (hy k (Set.mem_univ k))
          exact two_leg x y hxI hyI
      _ = (volume Q).toReal * (2 * (b 0 - a 0) * (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2))
            + 2 * (b 1 - a 1) * ((b 1 - a 1) * ∫ x in Q, (smthGrad w x 1) ^ 2) := by
          rw [integral_add (hconst _) ((IntQ _ hB1c).const_mul _), hcI, integral_const_mul,
            hB1int]
  
  have s7 : ∫ x in Q, (∫ y in Q, (w x - w y) ^ 2) ≤
      ∫ x in Q, ((volume Q).toReal * (2 * (b 0 - a 0) *
          (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2))
        + 2 * (b 1 - a 1) * ((b 1 - a 1) * ∫ x in Q, (smthGrad w x 1) ^ 2)) := by
    refine integral_mono_of_nonneg ?_ ?_ ?_
    · exact Filter.Eventually.of_forall (fun x => integral_nonneg (fun y => sq_nonneg _))
    · exact IntQ _ ((continuous_const.mul (continuous_const.mul hA0c)).add continuous_const)
    · exact (ae_restrict_iff' hQm).2 (Filter.Eventually.of_forall s6)
  have s7eq : ∫ x in Q, ((volume Q).toReal * (2 * (b 0 - a 0) *
          (∫ t in a 0..b 0, (smthGrad w ![t, x 1] 0) ^ 2))
        + 2 * (b 1 - a 1) * ((b 1 - a 1) * ∫ x in Q, (smthGrad w x 1) ^ 2)) =
      (volume Q).toReal * (2 * (b 0 - a 0) * ((b 0 - a 0) * ∫ x in Q, (smthGrad w x 0) ^ 2))
        + (volume Q).toReal * (2 * (b 1 - a 1) * ((b 1 - a 1) * ∫ x in Q, (smthGrad w x 1) ^ 2)) := by
    rw [integral_add (((IntQ _ hA0c).const_mul _).const_mul _) (hconst _), hcI,
      integral_const_mul, integral_const_mul, hA0int]
  
  have hvar' := hvar hQ0 hQt w (IntQ w hwc) (IntQ _ (hwc.pow 2))
  have hsum : ∫ x in Q, ∑ k, (smthGrad w x k) ^ 2 =
      (∫ x in Q, (smthGrad w x 0) ^ 2) + ∫ x in Q, (smthGrad w x 1) ^ 2 := by
    simp only [Fin.sum_univ_two]
    exact integral_add (IntQ _ hg0c) (IntQ _ hg1c)
  have hG0 : 0 ≤ ∫ x in Q, (smthGrad w x 0) ^ 2 :=
    setIntegral_nonneg hQm (fun _ _ => sq_nonneg _)
  have hG1 : 0 ≤ ∫ x in Q, (smthGrad w x 1) ^ 2 :=
    setIntegral_nonneg hQm (fun _ _ => sq_nonneg _)
  have hL0 : (b 0 - a 0) ^ 2 ≤ L ^ 2 := pow_le_pow_left₀ hl0.le (hL 0) 2
  have hL1 : (b 1 - a 1) ^ 2 ≤ L ^ 2 := pow_le_pow_left₀ hl1.le (hL 1) 2
  rw [hsum]
  set I := ∫ x in Q, (w x - ⨍ z in Q, w z) ^ 2 with hI
  set G0 := ∫ x in Q, (smthGrad w x 0) ^ 2 with hG0def
  set G1 := ∫ x in Q, (smthGrad w x 1) ^ 2 with hG1def
  set V := (volume Q).toReal with hVdef
  have hmain : 2 * V * I ≤ 2 * V * ((b 0 - a 0) ^ 2 * G0 + (b 1 - a 1) ^ 2 * G1) := by
    rw [hvar']
    calc _ ≤ _ := s7
      _ = _ := s7eq
      _ = 2 * V * ((b 0 - a 0) ^ 2 * G0 + (b 1 - a 1) ^ 2 * G1) := by ring
  have hI' : I ≤ (b 0 - a 0) ^ 2 * G0 + (b 1 - a 1) ^ 2 * G1 :=
    le_of_mul_le_mul_left hmain (by positivity)
  have h0 : (b 0 - a 0) ^ 2 * G0 ≤ L ^ 2 * G0 := mul_le_mul_of_nonneg_right hL0 hG0
  have h1 : (b 1 - a 1) ^ 2 * G1 ≤ L ^ 2 * G1 := mul_le_mul_of_nonneg_right hL1 hG1
  calc I ≤ (b 0 - a 0) ^ 2 * G0 + (b 1 - a 1) ^ 2 * G1 := hI'
    _ ≤ L ^ 2 * G0 + L ^ 2 * G1 := add_le_add h0 h1
    _ = L ^ 2 * (G0 + G1) := by ring

theorem slh_annulus_poincare (w : (Fin 2 → ℝ) → ℝ) (hw : ContDiff ℝ 1 w) (hbox : ∀ (a b : Fin 2 → ℝ) (L : ℝ), (∀ k, a k < b k) → (∀ k, b k - a k ≤ L) → ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), (w x - ⨍ z in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), w z) ^ 2 ≤ L ^ 2 * ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), ∑ k, (smthGrad w x k) ^ 2) (y : Fin 2 → ℝ) (r : ℝ) (hr : 0 < r) : ∃ c : ℝ, (∀ M : ℝ, (∀ x ∈ Metric.ball y (2 * r) \ Metric.closedBall y r, |w x| ≤ M) → |c| ≤ M) ∧ ∫ x in Metric.ball y (2 * r) \ Metric.closedBall y r, (w x - c) ^ 2 ≤ 8320 * r ^ 2 * ∫ x in Metric.ball y (2 * r) \ Metric.closedBall y r, ∑ k, (smthGrad w x k) ^ 2 :=
by
  
  have hwc : Continuous w := hw.continuous
  have hGc : Continuous (fun x => ∑ k, (smthGrad w x k) ^ 2) := by
    have hfd : Continuous (fun x => fderiv ℝ w x) := hw.continuous_fderiv (by norm_num)
    refine continuous_finset_sum _ (fun k _ => ?_)
    have : Continuous (fun x => smthGrad w x k) := by
      show Continuous (fun x => fderiv ℝ w x (Pi.single k 1))
      exact hfd.clm_apply continuous_const
    exact this.pow 2
  have hGnn : ∀ x, 0 ≤ ∑ k, (smthGrad w x k) ^ 2 :=
    fun x => Finset.sum_nonneg (fun k _ => sq_nonneg _)
  have hint : ∀ h : (Fin 2 → ℝ) → ℝ, Continuous h → ∀ X ⊆ Metric.closedBall y (2 * r),
      MeasureTheory.IntegrableOn h X :=
    fun h hh X hX =>
      (hh.continuousOn.integrableOn_compact (isCompact_closedBall y (2 * r))).mono_set hX
  have hsqc : ∀ a : ℝ, Continuous (fun x => (w x - a) ^ 2) :=
    fun a => (hwc.sub continuous_const).pow 2
  
  obtain ⟨A, hA⟩ : ∃ A : Set (Fin 2 → ℝ), A = Metric.ball y (2 * r) \ Metric.closedBall y r :=
    ⟨_, rfl⟩
  rw [← hA]
  obtain ⟨E, hE⟩ : ∃ E : ℝ, E = ∫ x in A, ∑ k, (smthGrad w x k) ^ 2 := ⟨_, rfl⟩
  rw [← hE]
  have hAK : A ⊆ Metric.closedBall y (2 * r) := by
    rw [hA]; exact Set.diff_subset.trans Metric.ball_subset_closedBall
  have hAm : MeasurableSet A := by
    rw [hA]; exact measurableSet_ball.diff measurableSet_closedBall
  have hE0 : 0 ≤ E := by
    rw [hE]; exact MeasureTheory.setIntegral_nonneg hAm (fun x _ => hGnn x)
  
  have hvol : ∀ a b : Fin 2 → ℝ, (∀ k, a k < b k) →
      MeasureTheory.volume (Set.univ.pi (fun k => Set.Ioo (a k) (b k))) < ⊤ ∧
      (MeasureTheory.volume (Set.univ.pi (fun k => Set.Ioo (a k) (b k)))).toReal =
        (b 0 - a 0) * (b 1 - a 1) := by
    intro a b hab
    refine ⟨?_, ?_⟩
    · rw [Real.volume_pi_Ioo]
      exact ENNReal.prod_lt_top (fun i _ => ENNReal.ofReal_lt_top)
    · rw [Real.volume_pi_Ioo_toReal (fun k => (hab k).le), Fin.prod_univ_two]
  
  have hboxA : ∀ a b : Fin 2 → ℝ, (∀ k, a k < b k) → (∀ k, b k - a k ≤ 4 * r) →
      Set.univ.pi (fun k => Set.Ioo (a k) (b k)) ⊆ A →
      ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)),
        (w x - ⨍ z in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), w z) ^ 2 ≤ 16 * r ^ 2 * E := by
    intro a b hab hside hsub
    have h1 := hbox a b (4 * r) hab hside
    have h2 : ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)), ∑ k, (smthGrad w x k) ^ 2 ≤ E := by
      rw [hE]
      exact MeasureTheory.setIntegral_mono_set (hint _ hGc _ hAK)
        (Filter.Eventually.of_forall hGnn) hsub.eventuallyLE
    calc _ ≤ (4 * r) ^ 2 * ∫ x in Set.univ.pi (fun k => Set.Ioo (a k) (b k)),
          ∑ k, (smthGrad w x k) ^ 2 := h1
      _ ≤ (4 * r) ^ 2 * E := mul_le_mul_of_nonneg_left h2 (sq_nonneg _)
      _ = 16 * r ^ 2 * E := by ring
  
  have hov : ∀ (S Q Q' : Set (Fin 2 → ℝ)) (a a' : ℝ), MeasurableSet S →
      MeasureTheory.volume S < ⊤ → S ⊆ Q → S ⊆ Q' →
      Q ⊆ Metric.closedBall y (2 * r) → Q' ⊆ Metric.closedBall y (2 * r) →
      (a - a') ^ 2 * (MeasureTheory.volume S).toReal ≤
        2 * (∫ x in Q, (w x - a) ^ 2) + 2 * ∫ x in Q', (w x - a') ^ 2 := by
    intro S Q Q' a a' hS hSf hSQ hSQ' hQ hQ'
    have iQ : MeasureTheory.IntegrableOn (fun x => (w x - a) ^ 2) Q := hint _ (hsqc a) Q hQ
    have iQ' : MeasureTheory.IntegrableOn (fun x => (w x - a') ^ 2) Q' := hint _ (hsqc a') Q' hQ'
    have i1 : MeasureTheory.IntegrableOn (fun x => (w x - a) ^ 2) S := iQ.mono_set hSQ
    have i2 : MeasureTheory.IntegrableOn (fun x => (w x - a') ^ 2) S := iQ'.mono_set hSQ'
    have ic : MeasureTheory.IntegrableOn (fun _ : Fin 2 → ℝ => (a - a') ^ 2) S :=
      MeasureTheory.integrableOn_const hSf.ne
    have hmono : ∫ x in S, (a - a') ^ 2 ≤ ∫ x in S, (2 * (w x - a) ^ 2 + 2 * (w x - a') ^ 2) := by
      refine MeasureTheory.setIntegral_mono_on ic ((i1.const_mul 2).add (i2.const_mul 2)) hS ?_
      intro x _
      nlinarith [sq_nonneg ((w x - a) + (w x - a'))]
    rw [MeasureTheory.setIntegral_const, MeasureTheory.integral_add (i1.const_mul 2) (i2.const_mul 2),
      MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul, smul_eq_mul,
      MeasureTheory.measureReal_def] at hmono
    have h1 : ∫ x in S, (w x - a) ^ 2 ≤ ∫ x in Q, (w x - a) ^ 2 :=
      MeasureTheory.setIntegral_mono_set iQ (Filter.Eventually.of_forall (fun x => sq_nonneg _))
        hSQ.eventuallyLE
    have h2 : ∫ x in S, (w x - a') ^ 2 ≤ ∫ x in Q', (w x - a') ^ 2 :=
      MeasureTheory.setIntegral_mono_set iQ' (Filter.Eventually.of_forall (fun x => sq_nonneg _))
        hSQ'.eventuallyLE
    linarith
  
  have hsh : ∀ (Q : Set (Fin 2 → ℝ)) (a c : ℝ), Q ⊆ Metric.closedBall y (2 * r) →
      MeasureTheory.volume Q < ⊤ →
      ∫ x in Q, (w x - c) ^ 2 ≤
        2 * (∫ x in Q, (w x - a) ^ 2) + 2 * (a - c) ^ 2 * (MeasureTheory.volume Q).toReal := by
    intro Q a c hQ hQf
    have iQ : MeasureTheory.IntegrableOn (fun x => (w x - a) ^ 2) Q := hint _ (hsqc a) Q hQ
    have iQc : MeasureTheory.IntegrableOn (fun x => (w x - c) ^ 2) Q := hint _ (hsqc c) Q hQ
    have ic : MeasureTheory.IntegrableOn (fun _ : Fin 2 → ℝ => 2 * (a - c) ^ 2) Q :=
      MeasureTheory.integrableOn_const hQf.ne
    have hmono : ∫ x in Q, (w x - c) ^ 2 ≤ ∫ x in Q, (2 * (w x - a) ^ 2 + 2 * (a - c) ^ 2) := by
      refine MeasureTheory.setIntegral_mono iQc ((iQ.const_mul 2).add ic) ?_
      intro x
      nlinarith [sq_nonneg ((w x - a) - (a - c))]
    rw [MeasureTheory.integral_add (iQ.const_mul 2) ic, MeasureTheory.integral_const_mul,
      MeasureTheory.setIntegral_const, smul_eq_mul, MeasureTheory.measureReal_def] at hmono
    linarith
  
  have hcov2 : ∀ (f : (Fin 2 → ℝ) → ℝ) (X Y : Set (Fin 2 → ℝ)), (∀ x, 0 ≤ f x) →
      MeasurableSet X → MeasurableSet Y →
      MeasureTheory.IntegrableOn f X → MeasureTheory.IntegrableOn f Y →
      ∫ x in X ∪ Y, f x ≤ (∫ x in X, f x) + ∫ x in Y, f x := by
    intro f X Y hf hX hY iX iY
    rw [← Set.union_diff_self, MeasureTheory.setIntegral_union Set.disjoint_sdiff_right
      (hY.diff hX) iX (iY.mono_set Set.diff_subset)]
    have := MeasureTheory.setIntegral_mono_set iY (Filter.Eventually.of_forall hf)
      (Set.diff_subset (s := Y) (t := X)).eventuallyLE
    linarith
  
  have havg : ∀ (X : Set (Fin 2 → ℝ)) (M : ℝ), MeasureTheory.volume X ≠ 0 →
      MeasureTheory.volume X < ⊤ → (∀ x ∈ X, |w x| ≤ M) → |⨍ z in X, w z| ≤ M := by
    intro X M h0 hf hb
    rw [MeasureTheory.setAverage_eq, smul_eq_mul, MeasureTheory.measureReal_def]
    have hv : 0 < (MeasureTheory.volume X).toReal := ENNReal.toReal_pos h0 hf.ne
    have h1 : ‖∫ x in X, w x‖ ≤ M * (MeasureTheory.volume X).toReal := by
      have := MeasureTheory.norm_setIntegral_le_of_norm_le_const (f := w) (C := M) hf
        (fun x hx => by rw [Real.norm_eq_abs]; exact hb x hx)
      rwa [MeasureTheory.measureReal_def] at this
    rw [Real.norm_eq_abs] at h1
    rw [abs_mul, abs_inv, abs_of_pos hv, inv_mul_le_iff₀ hv]
    linarith
  
  have core : ∀ (T B L R S1 S2 S3 : Set (Fin 2 → ℝ)) (mT mB mL mR : ℝ),
      MeasurableSet T → MeasurableSet B → MeasurableSet L → MeasurableSet R →
      MeasurableSet S1 → MeasurableSet S2 → MeasurableSet S3 →
      T ⊆ Metric.closedBall y (2 * r) → B ⊆ Metric.closedBall y (2 * r) →
      L ⊆ Metric.closedBall y (2 * r) → R ⊆ Metric.closedBall y (2 * r) →
      MeasureTheory.volume B < ⊤ → MeasureTheory.volume L < ⊤ → MeasureTheory.volume R < ⊤ →
      MeasureTheory.volume S1 < ⊤ → MeasureTheory.volume S2 < ⊤ → MeasureTheory.volume S3 < ⊤ →
      (MeasureTheory.volume B).toReal = 4 * r ^ 2 →
      (MeasureTheory.volume L).toReal = 4 * r ^ 2 →
      (MeasureTheory.volume R).toReal = 4 * r ^ 2 →
      (MeasureTheory.volume S1).toReal = r ^ 2 →
      (MeasureTheory.volume S2).toReal = r ^ 2 →
      (MeasureTheory.volume S3).toReal = r ^ 2 →
      S1 ⊆ T → S1 ⊆ L → S2 ⊆ T → S2 ⊆ R → S3 ⊆ L → S3 ⊆ B →
      A ⊆ T ∪ B ∪ L ∪ R →
      ∫ x in T, (w x - mT) ^ 2 ≤ 16 * r ^ 2 * E →
      ∫ x in B, (w x - mB) ^ 2 ≤ 16 * r ^ 2 * E →
      ∫ x in L, (w x - mL) ^ 2 ≤ 16 * r ^ 2 * E →
      ∫ x in R, (w x - mR) ^ 2 ≤ 16 * r ^ 2 * E →
      ∫ x in A, (w x - mT) ^ 2 ≤ 8320 * r ^ 2 * E := by
    intro T B L R S1 S2 S3 mT mB mL mR hTm hBm hLm hRm hS1m hS2m hS3m hTK hBK hLK hRK
      hBf hLf hRf hS1f hS2f hS3f vB vL vR vS1 vS2 vS3 h1T h1L h2T h2R h3L h3B hAc VT VB VL VR
    have hr2 : 0 < r ^ 2 := by positivity
    have o1 := hov S1 T L mT mL hS1m hS1f h1T h1L hTK hLK
    have o2 := hov S2 T R mT mR hS2m hS2f h2T h2R hTK hRK
    have o3 := hov S3 L B mL mB hS3m hS3f h3L h3B hLK hBK
    rw [vS1] at o1
    rw [vS2] at o2
    rw [vS3] at o3
    have d1 : (mT - mL) ^ 2 ≤ 64 * E := by
      have : (mT - mL) ^ 2 * r ^ 2 ≤ 64 * E * r ^ 2 := by linarith
      exact le_of_mul_le_mul_right this hr2
    have d2 : (mT - mR) ^ 2 ≤ 64 * E := by
      have : (mT - mR) ^ 2 * r ^ 2 ≤ 64 * E * r ^ 2 := by linarith
      exact le_of_mul_le_mul_right this hr2
    have d3 : (mL - mB) ^ 2 ≤ 64 * E := by
      have : (mL - mB) ^ 2 * r ^ 2 ≤ 64 * E * r ^ 2 := by linarith
      exact le_of_mul_le_mul_right this hr2
    have d4 : (mB - mT) ^ 2 ≤ 256 * E := by
      nlinarith [sq_nonneg ((mB - mL) - (mL - mT))]
    have sB := hsh B mB mT hBK hBf
    have sL := hsh L mL mT hLK hLf
    have sR := hsh R mR mT hRK hRf
    rw [vB] at sB
    rw [vL] at sL
    rw [vR] at sR
    have h8 : 0 ≤ 8 * r ^ 2 := by positivity
    have p1 := mul_le_mul_of_nonneg_left d1 h8
    have p2 := mul_le_mul_of_nonneg_left d2 h8
    have p4 := mul_le_mul_of_nonneg_left d4 h8
    have hfnn : ∀ x, 0 ≤ (w x - mT) ^ 2 := fun x => sq_nonneg _
    have iT := hint _ (hsqc mT) T hTK
    have iB := hint _ (hsqc mT) B hBK
    have iL := hint _ (hsqc mT) L hLK
    have iR := hint _ (hsqc mT) R hRK
    have u1 := hcov2 _ T B hfnn hTm hBm iT iB
    have u2 := hcov2 _ (T ∪ B) L hfnn (hTm.union hBm) hLm (iT.union iB) iL
    have u3 := hcov2 _ (T ∪ B ∪ L) R hfnn ((hTm.union hBm).union hLm) hRm
      ((iT.union iB).union iL) iR
    have u0 : ∫ x in A, (w x - mT) ^ 2 ≤ ∫ x in T ∪ B ∪ L ∪ R, (w x - mT) ^ 2 :=
      MeasureTheory.setIntegral_mono_set (((iT.union iB).union iL).union iR)
        (Filter.Eventually.of_forall hfnn) hAc.eventuallyLE
    have hrE : 0 ≤ r ^ 2 * E := mul_nonneg hr2.le hE0
    linarith
  
  have hmemA : ∀ x : Fin 2 → ℝ, x ∈ A ↔
      (|x 0 - y 0| < 2 * r ∧ |x 1 - y 1| < 2 * r) ∧ (r < |x 0 - y 0| ∨ r < |x 1 - y 1|) := by
    intro x
    rw [hA, Set.mem_diff, Metric.mem_ball, Metric.mem_closedBall, dist_pi_lt_iff (by linarith),
      dist_pi_le_iff hr.le, Fin.forall_fin_two, Fin.forall_fin_two]
    simp only [Real.dist_eq]
    constructor
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      by_contra hc
      push_neg at hc
      exact h2 hc
    · rintro ⟨h1, h2⟩
      refine ⟨h1, ?_⟩
      rintro ⟨h3, h4⟩
      rcases h2 with h | h <;> linarith
  have hmemB : ∀ (a b x : Fin 2 → ℝ), x ∈ Set.univ.pi (fun k => Set.Ioo (a k) (b k)) ↔
      (a 0 < x 0 ∧ x 0 < b 0) ∧ (a 1 < x 1 ∧ x 1 < b 1) := by
    intro a b x
    simp only [Set.mem_univ_pi, Set.mem_Ioo, Fin.forall_fin_two]
