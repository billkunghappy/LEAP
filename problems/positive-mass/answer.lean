      rw [hev.fderiv_eq]
      exact fderiv_fun_add hDd2 hvd2
    refine ⟨?_, ?_, ?_⟩
    · rw [hEq x hx]
      calc |D x + v (P.param j₀ x)| ≤ |D x| + |v (P.param j₀ x)| := abs_add_le _ _
        _ ≤ C := by
          rw [hCdef]
          have := abs_nonneg B₁
          have := mul_nonneg (abs_nonneg B₂) (abs_nonneg m)
          linarith
    · rw [hF1 x hxΩ]
      calc ‖fderiv ℝ D x + fderiv ℝ (fun y => v (P.param j₀ y)) x‖
          ≤ ‖fderiv ℝ D x‖ + ‖fderiv ℝ (fun y => v (P.param j₀ y)) x‖ := norm_add_le _ _
        _ ≤ C := by
          rw [hCdef]
          have := abs_nonneg B₀
          have := mul_nonneg (abs_nonneg B₂) (abs_nonneg m)
          linarith
    · rw [hF2]
      have hr := hr0pos x hxne
      have hrm : pcgbPoleRad P j₀ x₀ x ≤ |m| := by
        have := hm x hxcb
        rw [Real.norm_eq_abs, abs_of_pos hr] at this
        exact this.trans (le_abs_self m)
      have hkey : C₂ / pcgbPoleRad P j₀ x₀ x + |B₂| ≤ C / pcgbPoleRad P j₀ x₀ x := by
        rw [div_add' _ _ _ hr.ne']
        apply div_le_div_of_nonneg_right _ hr.le
        have : |B₂| * pcgbPoleRad P j₀ x₀ x ≤ |B₂| * |m| :=
          mul_le_mul_of_nonneg_left hrm (abs_nonneg _)
        rw [hCdef]
        have := abs_nonneg B₀
        have := abs_nonneg B₁
        linarith
      calc ‖fderiv ℝ (fderiv ℝ D) x + fderiv ℝ (fderiv ℝ (fun y => v (P.param j₀ y))) x‖
          ≤ ‖fderiv ℝ (fderiv ℝ D) x‖ + ‖fderiv ℝ (fderiv ℝ (fun y => v (P.param j₀ y))) x‖ :=
            norm_add_le (fderiv ℝ (fderiv ℝ D) x)
              (fderiv ℝ (fderiv ℝ (fun y => v (P.param j₀ y))) x)
        _ ≤ C₂ / pcgbPoleRad P j₀ x₀ x + |B₂| := add_le_add e2' hd2vx
        _ ≤ C / pcgbPoleRad P j₀ x₀ x := hkey
  
  have hw4 : ∃ N : Set X, IsOpen N ∧ P.param j₀ x₀ ∈ N ∧
      (∀ q ∈ N ∩ S, q ≠ P.param j₀ x₀ → w q < -1) ∧
      ∃ q ∈ N ∩ S, 0 < b q ∧ q ≠ P.param j₀ x₀ := by
    obtain ⟨δ, hδ, hδr⟩ := Metric.continuousAt_iff.mp hr0c.continuousAt
