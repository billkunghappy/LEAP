    fun b r δ r' δ' h1 h2 z hz => ⟨lt_of_lt_of_le hz.1 h1, lt_of_lt_of_le hz.2 h2⟩
  have hcylmem : ∀ (b : Fin 3) (r δ : ℝ), 0 < r → 0 < δ → y₀ ∈ sepCyl b y₀ r δ := by
    intro b r δ hr hδ
    simp [sepCyl, sepPlaneProj, hr, hδ]
  have hcylopen : ∀ (b : Fin 3) (r δ : ℝ), IsOpen (sepCyl b y₀ r δ) := by
