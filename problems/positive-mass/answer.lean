      have := abs_add_le (∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * p i * p j)
        (∑ i, (p i - ν i) * (p i + ν i))
      nlinarith
    
    have ha1id : (∑ i, ∑ j, H i j * (-(2 * τ * M i j) - ∑ k, Γ k i j * p k)) +
        2 * τ * ∑ i, M i i
        = -(2 * τ) * ∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * M i j -
          ∑ i, ∑ j, H i j * ∑ k, Γ k i j * p k := by
      simp only [Fin.sum_univ_three]
      simp only [Fin.isValue, Fin.reduceEq, if_true, if_false]
      ring
    have ha1 : |(∑ i, ∑ j, H i j * (-(2 * τ * M i j) - ∑ k, Γ k i j * p k)) +
        2 * τ * ∑ i, M i i| ≤ 1008 * ((1 + A) * t) * τ := by
      rw [ha1id]
      have e1 : |∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * M i j| ≤
          3 * (3 * (2 * t * A)) :=
        hs3 _ _ fun i => hs3 _ _ fun j => hm _ _ _ _ (hH i j) (hMA i j)
      have e2 : |∑ i, ∑ j, H i j * ∑ k, Γ k i j * p k| ≤
          3 * (3 * (2 * (3 * (9 * t * τ * 2)))) :=
        hs3 _ _ fun i => hs3 _ _ fun j => hm _ _ _ _ (hH2 i j)
          (hs3 _ _ fun k => hm _ _ _ _ (hΓ k i j) (hp2 k))
      have e3 := hsub (-(2 * τ) * ∑ i, ∑ j, (H i j - (if i = j then (1:ℝ) else 0)) * M i j)
        (∑ i, ∑ j, H i j * ∑ k, Γ k i j * p k)
      rw [abs_mul, abs_neg, abs_of_pos (by linarith : (0:ℝ) < 2 * τ)] at e3
      have e4 := mul_le_mul_of_nonneg_left e1 (by linarith : (0:ℝ) ≤ 2 * τ)
      nlinarith
    
    have ha2id : (∑ i, ∑ j, ∑ a, ∑ b, H i a * p a * (H j b * p b) *
          (-(2 * τ * M i j) - ∑ k, Γ k i j * p k)) =
        -(2 * τ) * (∑ i, ∑ j, M i j * (∑ a, H i a * p a) * (∑ b, H j b * p b)) -
          ∑ i, ∑ j, (∑ a, H i a * p a) * (∑ b, H j b * p b) * ∑ k, Γ k i j * p k := by
      simp only [Fin.sum_univ_three]
      ring
    have hcanc : ∀ u : Fin 3 → ℝ, ∑ i, ∑ j, M i j * u i * u j =
        ∑ i, ∑ j, M i j * (u i - ν i) * (u j - ν j) := by
      intro u
      have h0 := hMν 0
      have h1 := hMν 1
      have h2 := hMν 2
      simp only [Fin.sum_univ_three] at h0 h1 h2 ⊢
      simp only [hMs 1 0, hMs 2 0, hMs 2 1] at h0 h1 h2 ⊢
      linear_combination (2 * u 0 - ν 0) * h0 + (2 * u 1 - ν 1) * h1 + (2 * u 2 - ν 2) * h2
    have he : ∀ i, |(∑ a, H i a * p a) - ν i| ≤ 19 * ((1 + A) * t) := by
      intro i
      have hid : (∑ a, H i a * p a) - ν i =
          ∑ a, (H i a - (if i = a then (1:ℝ) else 0)) * p a + (p i - ν i) := by
        have h2 : ∑ a, (if i = a then (1:ℝ) else 0) * p a = p i := by simp
        simp only [sub_mul, Finset.sum_sub_distrib, h2]
        ring
      rw [hid]
      have e1 : |∑ a, (H i a - (if i = a then (1:ℝ) else 0)) * p a| ≤ 3 * (2 * t * 2) :=
        hs3 _ _ fun a => hm _ _ _ _ (hH i a) (hp2 a)
      have e2 := abs_add_le (∑ a, (H i a - (if i = a then (1:ℝ) else 0)) * p a) (p i - ν i)
      have e3 := hd' i
      nlinarith
    have hq2 : ∀ i, |∑ a, H i a * p a| ≤ 2 := by
      intro i
      have h1 := he i
      have h2 := hν1 i
      have h3 := htri (∑ a, H i a * p a) (ν i)
      nlinarith
    have ha2 : |(∑ i, ∑ j, ∑ a, ∑ b, H i a * p a * (H j b * p b) *
          (-(2 * τ * M i j) - ∑ k, Γ k i j * p k))| ≤ 2000 * (1 + A) ^ 2 * t * τ := by
      rw [ha2id, hcanc (fun i => ∑ a, H i a * p a)]
      have f1 : |∑ i, ∑ j, M i j * ((∑ a, H i a * p a) - ν i) * ((∑ b, H j b * p b) - ν j)| ≤
          3 * (3 * (A * (19 * ((1 + A) * t)) * (19 * ((1 + A) * t)))) :=
        hs3 _ _ fun i => hs3 _ _ fun j => hm _ _ _ _ (hm _ _ _ _ (hMA i j) (he i)) (he j)
      have f2 : |∑ i, ∑ j, (∑ a, H i a * p a) * (∑ b, H j b * p b) * ∑ k, Γ k i j * p k| ≤
