      partialDeriv k (fun z => U (coordPlaneProj a z)) y₁ := by
    intro k
    have h1 := hD1 k y₁
    have h2 : partialDeriv k (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y')) y₁
        = 0 := by
      simp only [partialDeriv, hfd, ContinuousLinearMap.zero_apply]
    linarith
  obtain ⟨zU, hzU⟩ : ∃ zU : E3 → E3, ∀ y, zU y = coordPlaneProj a y + U (coordPlaneProj a y) • e a :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨zV, hzV⟩ : ∃ zV : E3 → E3, ∀ y, zV y = coordPlaneProj a y + V (coordPlaneProj a y) • e a :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨ξU, hξU⟩ : ∃ ξU : E3 → Fin 3 → ℝ, ∀ y, ξU y = fun k =>
      (if k = a then (1 : ℝ) else 0) - partialDeriv k (fun z => U (coordPlaneProj a z)) y :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨ξV, hξV⟩ : ∃ ξV : E3 → Fin 3 → ℝ, ∀ y, ξV y = fun k =>
      (if k = a then (1 : ℝ) else 0) - partialDeriv k (fun z => V (coordPlaneProj a z)) y :=
    ⟨_, fun _ => rfl⟩
  
  have hMSEU : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      ∑ i : Fin 3, ∑ j : Fin 3, mcP G (zU y) (ξU y) i j *
        partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y =
        -mcR G (zU y) (ξU y) := by
    intro y hy
    have h := hMU y hy
    rw [s1] at h
    have hcov : (fun k => partialDeriv k (fun z => z a - U (coordPlaneProj a z))
        (coordPlaneProj a y + U (coordPlaneProj a y) • e a)) = ξU y := by
      rw [hξU]; funext k; exact huD1 y _ k
    rw [hcov] at h
    simp only [huD2] at h
    rw [← hzU y] at h
    simp only [mul_neg, Finset.sum_neg_distrib] at h
    linarith
  have hMSEV : ∀ y : E3, ‖coordPlaneProj a (y - chartAt E3 p p)‖ < 2 * ρ →
      ∑ i : Fin 3, ∑ j : Fin 3, mcP G (zV y) (ξV y) i j *
        partialDeriv i (partialDeriv j (fun z => V (coordPlaneProj a z))) y =
        -mcR G (zV y) (ξV y) := by
    intro y hy
    have h := hMV y hy
    rw [s1] at h
    have hcov : (fun k => partialDeriv k (fun z => z a - V (coordPlaneProj a z))
        (coordPlaneProj a y + V (coordPlaneProj a y) • e a)) = ξV y := by
      rw [hξV]; funext k; exact hvD1 y _ k
    rw [hcov] at h
    simp only [hvD2] at h
    rw [← hzV y] at h
    simp only [mul_neg, Finset.sum_neg_distrib] at h
    linarith
  have hVU1 : V (coordPlaneProj a y₁) = U (coordPlaneProj a y₁) := sub_eq_zero.mp h0
  have hz1 : zV y₁ = zU y₁ := by rw [hzV, hzU, hVU1]
  have hξ1 : ξV y₁ = ξU y₁ := by
    rw [hξV, hξU]; funext k; rw [hgrad0 k]
  have hξa : ξU y₁ a = 1 := by rw [hξU]; simp [hua]
  have hzUc : Continuous zU := by
    have : zU = fun y => coordPlaneProj a y + U (coordPlaneProj a y) • e a := funext hzU
    rw [this]; exact hπc.add ((hU.continuous.comp hπc).smul continuous_const)
  have hzVc : Continuous zV := by
    have : zV = fun y => coordPlaneProj a y + V (coordPlaneProj a y) • e a := funext hzV
    rw [this]; exact hπc.add ((hV.continuous.comp hπc).smul continuous_const)
  have hξUc : Continuous ξU := by
    have : ξU = fun y k => (if k = a then (1 : ℝ) else 0) -
        partialDeriv k (fun z => U (coordPlaneProj a z)) y := funext hξU
    rw [this]; exact continuous_pi fun k => continuous_const.sub (hu1 k).continuous
  have hξVc : Continuous ξV := by
    have : ξV = fun y k => (if k = a then (1 : ℝ) else 0) -
        partialDeriv k (fun z => V (coordPlaneProj a z)) y := funext hξV
    rw [this]; exact continuous_pi fun k => continuous_const.sub (hv1 k).continuous
  
  have hz1T : zU y₁ ∈ (chartAt E3 p).target := by
    rw [hzU]; exact hball (hgraph _ _ hy₁ (hslabU y₁ hy₁))
  have hpd : (G (zU y₁)).PosDef := coeff_chart_symm_posDef _ hz1T
  have hdet : (G (zU y₁)).det ≠ 0 := hpd.det_pos.ne'
  obtain ⟨hS, hA₀pd⟩ := mcP_padded_posDef G (zU y₁) hpd a (ξU y₁) hξa
  
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) (chartAt E3 p).target :=
    fun i j => g.smooth p i j
  obtain ⟨hPcd, hRcd⟩ := mcP_mcR_contDiffAt G _ (chartAt E3 p).open_target hGs (zU y₁) hz1T
    hdet (ξU y₁) hS
  have hαUc : Continuous (fun y => (zU y, ξU y)) := hzUc.prodMk hξUc
  have hαVc : Continuous (fun y => (zV y, ξV y)) := hzVc.prodMk hξVc
  have hαV1 : (fun y => (zV y, ξV y)) y₁ = (zU y₁, ξU y₁) := by
    show (zV y₁, ξV y₁) = (zU y₁, ξU y₁)
    rw [hz1, hξ1]
  obtain ⟨KP, hKP, hPlip⟩ := s7
    (fun (ij : Fin 3 × Fin 3) (q : E3 × (Fin 3 → ℝ)) => mcP G q.1 q.2 ij.1 ij.2) (zU y₁, ξU y₁)
    (fun ij => hPcd ij.1 ij.2) (fun y => (zV y, ξV y)) (fun y => (zU y, ξU y)) y₁
    hαVc.continuousAt hαUc.continuousAt hαV1 rfl
  obtain ⟨KR, hKR, hRlip⟩ := s7
    (fun (_ : Unit) (q : E3 × (Fin 3 → ℝ)) => mcR G q.1 q.2) (zU y₁, ξU y₁)
    (fun _ => hRcd) (fun y => (zV y, ξV y)) (fun y => (zU y, ξU y)) y₁
    hαVc.continuousAt hαUc.continuousAt hαV1 rfl
  
  obtain ⟨A₀, hA₀⟩ : ∃ A₀ : Matrix (Fin 3) (Fin 3) ℝ, ∀ i j,
      A₀ i j = mcP G (zU y₁) (ξU y₁) i j + if i = a ∧ j = a then 1 else 0 :=
    ⟨Matrix.of fun i j => mcP G (zU y₁) (ξU y₁) i j + if i = a ∧ j = a then 1 else 0,
      fun _ _ => rfl⟩
  have hA₀pos : ∀ v : Fin 3 → ℝ, v ≠ 0 → 0 < ∑ i : Fin 3, ∑ j : Fin 3, A₀ i j * v i * v j := by
    intro v hv
    simp only [hA₀]
    exact hA₀pd v hv
  obtain ⟨lam, δ, hlam, hδ, hell⟩ := quadForm_pos_perturb A₀ hA₀pos
  have hAev : ∀ᶠ y in 𝓝 y₁, ∀ i j,
      |mcP G (zV y) (ξV y) i j - mcP G (zU y₁) (ξU y₁) i j| < δ := by
    refine Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => ?_
    have hc1 : ContinuousAt (fun q : E3 × (Fin 3 → ℝ) => mcP G q.1 q.2 i j)
        ((fun y => (zV y, ξV y)) y₁) := by
      rw [hαV1]; exact (hPcd i j).continuousAt
    have hc2 : ContinuousAt ((fun q : E3 × (Fin 3 → ℝ) => mcP G q.1 q.2 i j) ∘
        (fun y => (zV y, ξV y))) y₁ := ContinuousAt.comp hc1 hαVc.continuousAt
    filter_upwards [Metric.tendsto_nhds.mp hc2.tendsto δ hδ] with y hy
    dsimp only [Function.comp_apply] at hy
    rw [Real.dist_eq, hz1, hξ1] at hy
    exact hy
  obtain ⟨CH, hCHdef⟩ : ∃ CH : ℝ, CH = ∑ i : Fin 3, ∑ j : Fin 3,
      |partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y₁| + 1 := ⟨_, rfl⟩
  have hCH : 0 ≤ CH := by
    rw [hCHdef]
    have := Finset.sum_nonneg (s := (Finset.univ : Finset (Fin 3)))
      (f := fun i => ∑ j : Fin 3,
        |partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y₁|)
      (fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _)
    linarith
  
  have hHev : ∀ᶠ y in 𝓝 y₁, ∀ i j,
      |partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y -
        partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y₁| < 1 := by
    refine Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => ?_
    filter_upwards [Metric.tendsto_nhds.mp ((hu2 i j).tendsto y₁) 1 one_pos] with y hy
    exact hy
  
  obtain ⟨r, hr, hrball⟩ :=
    Metric.eventually_nhds_iff.mp (hΩ.and (hPlip.and (hRlip.and (hAev.and hHev))))
  have hK0 : 0 ≤ KR + 9 * KP * CH := by
    have := mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 9) hKP) hCH
    linarith
  refine ⟨fun y i j => mcP G (zV y) (ξV y) i j + if i = a ∧ j = a then 1 else 0, r, lam,
    ∑ i : Fin 3, ∑ j : Fin 3, |A₀ i j| + δ, KR + 9 * KP * CH, hr, hlam, fun y hy => ?_⟩
  obtain ⟨hyΩ, hyP, hyR, hyA, hyH⟩ := hrball (Metric.mem_ball.mp hy)
  have hAclose : ∀ i j,
      |(mcP G (zV y) (ξV y) i j + if i = a ∧ j = a then 1 else 0) - A₀ i j| ≤ δ := by
    intro i j
    rw [hA₀, add_sub_add_right_eq_sub]
    exact (hyA i j).le
  refine ⟨hyΩ, fun v => hell _ hAclose v, fun i j => ?_, ?_⟩
  · have h1 := hAclose i j
    have h2 := hsum_le A₀ i j
    have h3 := abs_sub_abs_le_abs_sub
      (mcP G (zV y) (ξV y) i j + if i = a ∧ j = a then 1 else 0) (A₀ i j)
    show |mcP G (zV y) (ξV y) i j + if i = a ∧ j = a then 1 else 0| ≤ _
    linarith
  · 
    have hw0 : 0 ≤ V (coordPlaneProj a y) - U (coordPlaneProj a y) := sub_nonneg.mpr (hle y hyΩ)
    have hPy : ∀ i j, |mcP G (zV y) (ξV y) i j - mcP G (zU y) (ξU y) i j| ≤
        KP * ‖(zV y, ξV y) - (zU y, ξU y)‖ := fun i j => hyP (i, j)
    have hRy : |mcR G (zV y) (ξV y) - mcR G (zU y) (ξU y)| ≤
        KR * ‖(zV y, ξV y) - (zU y, ξU y)‖ := hyR ()
    have hHy : ∀ i j,
        |partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y| ≤ CH := by
      intro i j
      have h1 := hyH i j
      have h2 := hsum_le (fun i j =>
        partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y₁) i j
      have h3 := abs_sub_abs_le_abs_sub
        (partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y)
        (partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y₁)
      rw [hCHdef]
      linarith
    have hgap := s9 (mcP G (zV y) (ξV y)) (mcP G (zU y) (ξU y))
      (fun i j => partialDeriv i (partialDeriv j (fun z => V (coordPlaneProj a z))) y)
      (fun i j => partialDeriv i (partialDeriv j (fun z => U (coordPlaneProj a z))) y)
      (mcR G (zV y) (ξV y)) (mcR G (zU y) (ξU y)) KP KR CH
      ‖(zV y, ξV y) - (zU y, ξU y)‖ hKP hCH (hMSEV y hyΩ) (hMSEU y hyΩ) hRy hPy hHy
    have hwa' : partialDeriv a
        (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y')) = fun _ => (0 : ℝ) :=
      funext fun y' => hwa y'
    have haa : partialDeriv a (partialDeriv a
        (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y'))) y = 0 := by
      rw [hwa']
      simp [partialDeriv]
    have hdiff : (zV y, ξV y) - (zU y, ξU y) =
        ((V (coordPlaneProj a y) - U (coordPlaneProj a y)) • e a,
          fun k => -partialDeriv k
            (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y')) y) := by
      rw [Prod.mk_sub_mk, hzV, hzU, hξV, hξU]
      congr 1
      · rw [sub_smul]; abel
      · funext k
        simp only [Pi.sub_apply]
        rw [hD1 k y]
        ring
    have hd := hprod (V (coordPlaneProj a y) - U (coordPlaneProj a y))
      (fun k => -partialDeriv k
        (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y')) y)
    rw [← hdiff] at hd
    simp only [abs_neg, abs_of_nonneg hw0] at hd
    show ∑ i : Fin 3, ∑ j : Fin 3,
        (mcP G (zV y) (ξV y) i j + if i = a ∧ j = a then 1 else 0) *
          partialDeriv i (partialDeriv j
            (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y'))) y ≤ _
    rw [hpad a (mcP G (zV y) (ξV y)) (fun i j => partialDeriv i (partialDeriv j
      (fun y' => V (coordPlaneProj a y') - U (coordPlaneProj a y'))) y), haa, add_zero]
    simp only [hD2]
    calc _ ≤ (KR + 9 * KP * CH) * ‖(zV y, ξV y) - (zU y, ξU y)‖ := hgap
      _ ≤ _ := mul_le_mul_of_nonneg_left hd hK0

theorem hopf_strong_min_principle (Ω : Set E3) (hΩ : IsOpen Ω) (hΩc : IsPreconnected Ω)
    (w : E3 → ℝ) (hw : ContDiff ℝ 2 w) (hnn : ∀ y ∈ Ω, 0 ≤ w y)
    (hloc : ∀ y₁ ∈ Ω, w y₁ = 0 → ∃ (A : E3 → Matrix (Fin 3) (Fin 3) ℝ) (r lam Lam K : ℝ),
      0 < r ∧ 0 < lam ∧ ∀ y ∈ Metric.ball y₁ r, y ∈ Ω ∧
        (∀ v : Fin 3 → ℝ, lam * ∑ i, v i ^ 2 ≤ ∑ i, ∑ j, A y i j * v i * v j) ∧
        (∀ i j, |A y i j| ≤ Lam) ∧
        ∑ i, ∑ j, A y i j * partialDeriv i (partialDeriv j w) y ≤
          K * (w y + ∑ i, |partialDeriv i w y|))
    (y₀ : E3) (hy₀ : y₀ ∈ Ω) (h0 : w y₀ = 0) : ∀ y ∈ Ω, w y = 0 :=
by
  have hwC : Continuous w := hw.continuous
  
  have H2 : ∀ (f : E3 → ℝ), ContDiff ℝ 2 f → ∀ (y : E3) (i j : Fin 3),
      partialDeriv i (partialDeriv j f) y = fderiv ℝ (fderiv ℝ f) y (e i) (e j) := by
    intro f hf y i j
    have hd : Differentiable ℝ (fderiv ℝ f) :=
      (hf.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
    have h1 := (hd y).hasFDerivAt.clm_apply (hasFDerivAt_const (e j) y)
    show fderiv ℝ (fun z => fderiv ℝ f z (e j)) y (e i) = _
    rw [h1.fderiv]
    simp
  
  have s1 : ∀ (A H : Matrix (Fin 3) (Fin 3) ℝ),
      (∀ v : Fin 3 → ℝ, 0 ≤ ∑ i, ∑ j, A i j * v i * v j) →
      (∀ i j, H i j = H j i) →
      (∀ v : Fin 3 → ℝ, 0 ≤ ∑ i, ∑ j, v i * v j * H i j) →
      0 ≤ ∑ i, ∑ j, A i j * H i j := by
    intro A H hA hHs hH
    have hherm : H.IsHermitian := by
      ext i j
      simp [Matrix.conjTranspose_apply, hHs]
    have hpsd : H.PosSemidef := by
      rw [Matrix.posSemidef_iff_dotProduct_mulVec]
      refine ⟨hherm, fun x => ?_⟩
      have := hH x
      simp only [star_trivial, dotProduct, Matrix.mulVec, Finset.mul_sum]
      convert this using 2
      exact Finset.sum_congr rfl (fun j _ => by ring)
    obtain ⟨B, hB⟩ := Matrix.posSemidef_iff_eq_conjTranspose_mul_self.mp hpsd
    have hHB : ∀ i j, H i j = ∑ k, B k i * B k j := by
      intro i j
      rw [hB, Matrix.mul_apply]
      simp [Matrix.conjTranspose_apply]
    have : ∑ i, ∑ j, A i j * H i j = ∑ k, ∑ i, ∑ j, A i j * B k i * B k j := by
      simp only [hHB, Fin.sum_univ_three]
      ring
    rw [this]
    exact Finset.sum_nonneg (fun k _ => hA (fun i => B k i))
  
  have s2 : ∀ (f : E3 → ℝ), ContDiff ℝ 2 f → ∀ (y : E3) (i j : Fin 3),
      partialDeriv i (partialDeriv j f) y = partialDeriv j (partialDeriv i f) y := by
    intro f hf y i j
    rw [H2 f hf, H2 f hf]
    have hs : IsSymmSndFDerivAt ℝ f y :=
      hf.contDiffAt.isSymmSndFDerivAt (by simp [minSmoothness_of_isRCLikeNormedField])
    exact hs (e i) (e j)
  
  have s3 : ∀ (h : E3 → ℝ), ContDiff ℝ 2 h → ∀ (z : E3), IsLocalMin h z →
      ∀ (v : Fin 3 → ℝ), 0 ≤ ∑ i, ∑ j, v i * v j * partialDeriv i (partialDeriv j h) z := by
    intro h hh z hmin v
    have hQ : ∑ i, ∑ j, v i * v j * partialDeriv i (partialDeriv j h) z =
        fderiv ℝ (fderiv ℝ h) z (∑ k, v k • e k) (∑ k, v k • e k) := by
      simp only [H2 h hh, map_smul, map_add,
        ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
        Fin.sum_univ_three]
      ring
    rw [hQ]
    set u : E3 := ∑ k, v k • e k with hu
    have hd1 : Differentiable ℝ h := hh.differentiable (by norm_num)
    have hd2 : Differentiable ℝ (fderiv ℝ h) :=
      (hh.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
    have hline : ∀ t : ℝ, HasDerivAt (fun t : ℝ => z + t • u) u t := by
      intro t
      simpa using ((hasDerivAt_id t).smul_const u).const_add z
    have hφ : ∀ t : ℝ, HasDerivAt (fun t : ℝ => h (z + t • u)) (fderiv ℝ h (z + t • u) u) t :=
      fun t => (hd1 _).hasFDerivAt.comp_hasDerivAt t (hline t)
    have hψ : HasDerivAt (fun t : ℝ => fderiv ℝ h (z + t • u) u)
        (fderiv ℝ (fderiv ℝ h) z u u) 0 := by
      have h1 : HasDerivAt (fun t : ℝ => fderiv ℝ h (z + t • u))
          (fderiv ℝ (fderiv ℝ h) z u) 0 :=
        (hd2 z).hasFDerivAt.comp_hasDerivAt_of_eq 0 (hline 0) (by simp)
      have h2 := h1.clm_apply (hasDerivAt_const 0 u)
      simpa using h2
    have hψ0 : fderiv ℝ h z u = 0 := by simp [hmin.fderiv_eq_zero]
    by_contra hneg
    push_neg at hneg
    rw [hasDerivAt_iff_tendsto_slope] at hψ
    have hsl : ∀ᶠ t in 𝓝[>] (0:ℝ), slope (fun t : ℝ => fderiv ℝ h (z + t • u) u) 0 t < 0 :=
      (hψ.mono_left (nhdsWithin_mono _ (fun t ht => ne_of_gt ht))).eventually
        (gt_mem_nhds hneg)
    have hc : Tendsto (fun t : ℝ => z + t • u) (𝓝 0) (𝓝 z) := by
      have := (hline 0).continuousAt.tendsto
      simpa using this
    have hloc : ∀ᶠ t in 𝓝 (0:ℝ), h z ≤ h (z + t • u) := hc.eventually hmin
    have hboth : ∀ᶠ t in 𝓝[>] (0:ℝ),
        slope (fun t : ℝ => fderiv ℝ h (z + t • u) u) 0 t < 0 ∧ h z ≤ h (z + t • u) :=
      hsl.and (nhdsWithin_le_nhds hloc)
    obtain ⟨δ, hδ, hδsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hboth
    have hδ0 : (0:ℝ) < δ := hδ
    have ht0 : (0:ℝ) < δ / 2 := by linarith
    obtain ⟨s, hs, hseq⟩ := exists_hasDerivAt_eq_slope (fun t : ℝ => h (z + t • u))
      (fun t : ℝ => fderiv ℝ h (z + t • u) u) ht0
      (fun t _ => (hφ t).continuousAt.continuousWithinAt)
      (fun t _ => hφ t)
    have hsδ : s ∈ Set.Ioo (0:ℝ) δ := ⟨hs.1, by linarith [hs.2]⟩
    have hsneg := (hδsub hsδ).1
    have htδ : δ / 2 ∈ Set.Ioo (0:ℝ) δ := ⟨ht0, by linarith⟩
    have htmin := (hδsub htδ).2
    rw [slope_def_field] at hsneg
    simp only [zero_smul, add_zero, hψ0, sub_zero] at hsneg hseq
    have hψs : fderiv ℝ h (z + s • u) u < 0 := by
      by_contra hc'
      push_neg at hc'
      have := div_nonneg hc' hs.1.le
      linarith
    rw [hseq] at hψs
    have := div_nonneg (sub_nonneg.mpr htmin) ht0.le
    linarith
  
  have s4 : ∀ (c : E3) (α R : ℝ),
      ContDiff ℝ 2 (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) ∧
      (∀ x u : E3,
        fderiv ℝ (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) x u
          = -2 * α * Real.exp (-α * ‖x - c‖ ^ 2) * inner ℝ (x - c) u) ∧
      (∀ (i : Fin 3) (x : E3),
        partialDeriv i (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) x
          = -2 * α * (x i - c i) * Real.exp (-α * ‖x - c‖ ^ 2)) ∧
      (∀ (i j : Fin 3) (x : E3),
        partialDeriv i (partialDeriv j
          (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2))) x
          = (4 * α ^ 2 * (x i - c i) * (x j - c j) - 2 * α * (if i = j then 1 else 0))
              * Real.exp (-α * ‖x - c‖ ^ 2)) := by
    intro c α R
    have hsm : ContDiff ℝ 2
        (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) := by
      apply ContDiff.sub _ contDiff_const
      apply Real.contDiff_exp.comp
      apply contDiff_const.mul
      exact (contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)
    have hE : ∀ x : E3, HasFDerivAt (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2))
        (Real.exp (-α * ‖x - c‖ ^ 2) •
          (-α • (2 • (innerSL ℝ (x - c)).comp (ContinuousLinearMap.id ℝ E3)))) x := by
      intro x
      exact ((((hasFDerivAt_id x).sub_const c).norm_sq).const_mul (-α)).exp
    have h1 : ∀ x u : E3,
        fderiv ℝ (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) x u
          = -2 * α * Real.exp (-α * ‖x - c‖ ^ 2) * inner ℝ (x - c) u := by
      intro x u
      rw [((hE x).sub_const (Real.exp (-α * R ^ 2))).fderiv]
      simp [inner_sub_left]
      ring
    have h2 : ∀ (i : Fin 3) (x : E3),
        partialDeriv i (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2)) x
          = -2 * α * (x i - c i) * Real.exp (-α * ‖x - c‖ ^ 2) := by
      intro i x
      simp only [partialDeriv]
      rw [h1]
      simp [EuclideanSpace.inner_single_right]
      ring
    refine ⟨hsm, h1, h2, fun i j x => ?_⟩
    have hfun : partialDeriv j
        (fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2))
        = fun x => -2 * α * (x j - c j) * Real.exp (-α * ‖x - c‖ ^ 2) := funext (h2 j)
    rw [hfun]
    have hcoord : HasFDerivAt (fun x : E3 => -2 * α * (x j - c j))
        ((-2 * α) • (EuclideanSpace.proj j : E3 →L[ℝ] ℝ)) x := by
      have := ((EuclideanSpace.proj j : E3 →L[ℝ] ℝ).hasFDerivAt (x := x)).sub_const (c j)
      exact this.const_mul (-2 * α)
    have h3 : HasFDerivAt (fun x : E3 => -2 * α * (x j - c j) * Real.exp (-α * ‖x - c‖ ^ 2))
        ((-2 * α * (x j - c j)) • (Real.exp (-α * ‖x - c‖ ^ 2) •
          (-α • (2 • (innerSL ℝ (x - c)).comp (ContinuousLinearMap.id ℝ E3)))) +
          Real.exp (-α * ‖x - c‖ ^ 2) • ((-2 * α) • (EuclideanSpace.proj j : E3 →L[ℝ] ℝ))) x :=
      hcoord.mul (hE x)
    simp only [partialDeriv]
    rw [h3.fderiv]
    by_cases hij : i = j
    · subst hij
      simp [EuclideanSpace.inner_single_right]
      ring
    · simp [EuclideanSpace.inner_single_right, EuclideanSpace.single_apply, hij, Ne.symm hij]
      ring
  
  have s5 : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (d : Fin 3 → ℝ)
      (lam Lam K R α E E' : ℝ), 0 < lam → 0 ≤ K → 0 < R → 1 ≤ α →
      6 * |Lam| + 6 * K * R + K < α * (lam * R ^ 2) → 0 < E → 0 < E' →
      (∀ v : Fin 3 → ℝ, lam * ∑ i, v i ^ 2 ≤ ∑ i, ∑ j, A i j * v i * v j) →
      (∀ i j, |A i j| ≤ Lam) →
      R ^ 2 ≤ 4 * ∑ i, d i ^ 2 → (∀ i, |d i| ≤ R) →
      K * ((E - E') + ∑ i, |-2 * α * d i * E|) <
        ∑ i, ∑ j, A i j * ((4 * α ^ 2 * d i * d j - 2 * α * (if i = j then 1 else 0)) * E) := by
    intro A d lam Lam K R α E E' hlam hK _hR hα1 hα hE hE' hell hbd hs1 hs2
    have hα0 : 0 < α := by linarith
    have hT : ∑ i, A i i ≤ 3 * |Lam| := by
      simp only [Fin.sum_univ_three]
      have := fun i => (le_abs_self (A i i)).trans ((hbd i i).trans (le_abs_self Lam))
      linarith [this 0, this 1, this 2]
    have hRHS : ∑ i, ∑ j, A i j *
        ((4 * α ^ 2 * d i * d j - 2 * α * (if i = j then 1 else 0)) * E)
        = E * (4 * α ^ 2 * (∑ i, ∑ j, A i j * d i * d j) - 2 * α * ∑ i, A i i) := by
      simp [Fin.sum_univ_three]
      ring
    have habs : ∀ i, |-2 * α * d i * E| ≤ 2 * α * R * E := by
      intro i
      rw [show -2 * α * d i * E = -(2 * α * E * d i) by ring, abs_neg, abs_mul,
        abs_of_pos (by positivity : 0 < 2 * α * E)]
      have := mul_le_mul_of_nonneg_left (hs2 i) (by positivity : (0:ℝ) ≤ 2 * α * E)
      linarith
    have hsumabs : ∑ i, |-2 * α * d i * E| ≤ 6 * α * R * E := by
      simp only [Fin.sum_univ_three]
      linarith [habs 0, habs 1, habs 2]
    have hLHS : K * ((E - E') + ∑ i, |-2 * α * d i * E|) ≤ K * (E + 6 * α * R * E) := by
      apply mul_le_mul_of_nonneg_left _ hK
      linarith
    rw [hRHS]
    have hQ' : lam * R ^ 2 / 4 ≤ ∑ i, ∑ j, A i j * d i * d j := by
      have := mul_le_mul_of_nonneg_left hs1 hlam.le
      linarith [hell d]
    have h1 := mul_le_mul_of_nonneg_left hQ' (sq_nonneg α)
    have h2 := mul_le_mul_of_nonneg_left hT hα0.le
    have key : α * (6 * |Lam| + 6 * K * R + K) < α * (α * (lam * R ^ 2)) :=
      mul_lt_mul_of_pos_left hα hα0
    have hKα : K ≤ α * K := by nlinarith [mul_nonneg (sub_nonneg.mpr hα1) hK]
    have hfinal : K + 6 * α * K * R <
        4 * α ^ 2 * (∑ i, ∑ j, A i j * d i * d j) - 2 * α * ∑ i, A i i := by
      nlinarith
    have := mul_lt_mul_of_pos_left hfinal hE
    nlinarith
  
  have s6 : ∀ (c : E3) (R : ℝ) (h : E3 → ℝ), Continuous h →
      (∀ x : E3, ‖x - c‖ = R / 2 → 0 ≤ h x) →
      (∀ x : E3, ‖x - c‖ = R → 0 ≤ h x) →
      (∀ z : E3, R / 2 < ‖z - c‖ → ‖z - c‖ < R →
        (∀ y : E3, R / 2 ≤ ‖y - c‖ → ‖y - c‖ ≤ R → h z ≤ h y) → 0 ≤ h z) →
      ∀ x : E3, R / 2 ≤ ‖x - c‖ → ‖x - c‖ ≤ R → 0 ≤ h x := by
    intro c R h hc hin hout hint x hx1 hx2
    have hDc : IsCompact {y : E3 | R / 2 ≤ ‖y - c‖ ∧ ‖y - c‖ ≤ R} := by
      refine (isCompact_closedBall c R).of_isClosed_subset ?_ ?_
      · exact (isClosed_le continuous_const (continuous_id.sub continuous_const).norm).inter
          (isClosed_le (continuous_id.sub continuous_const).norm continuous_const)
      · intro y hy
        rw [Metric.mem_closedBall, dist_eq_norm]
        exact hy.2
    obtain ⟨z, hzD, hzmin⟩ := hDc.exists_isMinOn ⟨x, hx1, hx2⟩ hc.continuousOn
    have hz0 : 0 ≤ h z := by
      rcases eq_or_lt_of_le hzD.1 with h1 | h1
      · exact hin z h1.symm
      rcases eq_or_lt_of_le hzD.2 with h2 | h2
      · exact hout z h2
      exact hint z h1 h2 (fun y hy1 hy2 => isMinOn_iff.mp hzmin y ⟨hy1, hy2⟩)
    exact hz0.trans (isMinOn_iff.mp hzmin x ⟨hx1, hx2⟩)
  
  have s7 : ∀ (y₁ : E3) (r : ℝ), 0 < r → Metric.ball y₁ r ⊆ Ω → w y₁ = 0 →
      ∀ (p : E3), p ∈ Metric.ball y₁ (r / 4) → w p ≠ 0 →
      ∃ (c x₀ : E3) (R : ℝ), 0 < R ∧ ‖x₀ - c‖ = R ∧ w x₀ = 0 ∧
        (∀ x : E3, ‖x - c‖ < R → 0 < w x) ∧
        (∀ x : E3, ‖x - c‖ ≤ R → x ∈ Metric.ball y₁ (r / 2)) := by
    intro y₁ r _hr hball hw1 p hp hwp
    have hZc : IsClosed (w ⁻¹' {0}) := isClosed_singleton.preimage hwC
    have hy₁Z : y₁ ∈ w ⁻¹' {0} := hw1
    have hpZ : p ∉ w ⁻¹' {0} := hwp
    have hRpos : 0 < Metric.infDist p (w ⁻¹' {0}) :=
      (hZc.notMem_iff_infDist_pos ⟨y₁, hy₁Z⟩).mp hpZ
    have hRle : Metric.infDist p (w ⁻¹' {0}) ≤ dist p y₁ := Metric.infDist_le_dist_of_mem hy₁Z
    obtain ⟨x₀, hx₀Z, hx₀d⟩ := hZc.exists_infDist_eq_dist ⟨y₁, hy₁Z⟩ p
    have hpd : dist p y₁ < r / 4 := hp
    refine ⟨p, x₀, Metric.infDist p (w ⁻¹' {0}), hRpos, ?_, hx₀Z, ?_, ?_⟩
    · rw [hx₀d, dist_comm, dist_eq_norm]
    · intro x hx
      have hxZ : w x ≠ 0 := by
        intro hxZ
        have := Metric.infDist_le_dist_of_mem (x := p) (show x ∈ w ⁻¹' {0} from hxZ)
        rw [dist_comm, dist_eq_norm] at this
        linarith
      have hxb : x ∈ Metric.ball y₁ r := by
        rw [Metric.mem_ball]
        calc dist x y₁ ≤ dist x p + dist p y₁ := dist_triangle _ _ _
          _ < r := by rw [dist_eq_norm]; linarith
      exact lt_of_le_of_ne (hnn x (hball hxb)) (Ne.symm hxZ)
    · intro x hx
      rw [Metric.mem_ball]
      calc dist x y₁ ≤ dist x p + dist p y₁ := dist_triangle _ _ _
        _ < r / 2 := by rw [dist_eq_norm]; linarith
  
  have s8 : ∀ (h : E3 → ℝ) (x₀ u : E3), DifferentiableAt ℝ h x₀ →
      ∀ (δ : ℝ), 0 < δ → (∀ t : ℝ, 0 < t → t < δ → h x₀ ≤ h (x₀ + t • u)) →
      0 ≤ fderiv ℝ h x₀ u := by
    intro h x₀ u hd δ hδ hmin
    have hline : HasDerivAt (fun t : ℝ => x₀ + t • u) u 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).smul_const u).const_add x₀
    have hφ : HasDerivAt (fun t : ℝ => h (x₀ + t • u)) (fderiv ℝ h x₀ u) 0 :=
      hd.hasFDerivAt.comp_hasDerivAt_of_eq 0 hline (by simp)
    rw [hasDerivAt_iff_tendsto_slope] at hφ
    have ht : Tendsto (slope (fun t : ℝ => h (x₀ + t • u)) 0) (𝓝[>] 0)
        (𝓝 (fderiv ℝ h x₀ u)) :=
      hφ.mono_left (nhdsWithin_mono _ (fun t ht => ne_of_gt ht))
    refine ge_of_tendsto ht ?_
    filter_upwards [Ioo_mem_nhdsGT hδ] with t ht
    rw [slope_def_field]
    have := hmin t ht.1 ht.2
    simp only [zero_smul, add_zero, sub_zero]
    exact div_nonneg (by linarith) ht.1.le
  
  have s9 : ∀ (f g : E3 → ℝ), ContDiff ℝ 2 f → ContDiff ℝ 2 g → ∀ (ε : ℝ),
      (∀ y u : E3, fderiv ℝ (fun x => f x - ε * g x) y u
        = fderiv ℝ f y u - ε * fderiv ℝ g y u) ∧
      (∀ (i : Fin 3) (y : E3), partialDeriv i (fun x => f x - ε * g x) y
          = partialDeriv i f y - ε * partialDeriv i g y) ∧
      (∀ (i j : Fin 3) (y : E3), partialDeriv i (partialDeriv j (fun x => f x - ε * g x)) y
          = partialDeriv i (partialDeriv j f) y - ε * partialDeriv i (partialDeriv j g) y) := by
    intro f g hf hg ε
    have hfd : Differentiable ℝ f := hf.differentiable (by norm_num)
    have hgd : Differentiable ℝ g := hg.differentiable (by norm_num)
    have hF : ∀ y, fderiv ℝ (fun x => f x - ε * g x) y = fderiv ℝ f y - ε • fderiv ℝ g y := by
      intro y
      exact ((hfd y).hasFDerivAt.sub ((hgd y).hasFDerivAt.const_mul ε)).fderiv
    have h1 : ∀ y u : E3, fderiv ℝ (fun x => f x - ε * g x) y u
        = fderiv ℝ f y u - ε * fderiv ℝ g y u := by
      intro y u
      rw [hF]
      simp
    refine ⟨h1, fun i y => h1 y (e i), fun i j y => ?_⟩
    have hsm : ContDiff ℝ 2 (fun x => f x - ε * g x) := hf.sub (contDiff_const.mul hg)
    rw [H2 _ hsm, H2 _ hf, H2 _ hg]
    have hF' : fderiv ℝ (fun x => f x - ε * g x) = fun y => fderiv ℝ f y - ε • fderiv ℝ g y :=
      funext hF
    rw [hF']
    have hdf : Differentiable ℝ (fderiv ℝ f) :=
      (hf.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
    have hdg : Differentiable ℝ (fderiv ℝ g) :=
      (hg.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
    have h3 : HasFDerivAt (fun y => fderiv ℝ f y - ε • fderiv ℝ g y)
        (fderiv ℝ (fderiv ℝ f) y - ε • fderiv ℝ (fderiv ℝ g) y) y :=
      (hdf y).hasFDerivAt.sub ((hdg y).hasFDerivAt.const_smul ε)
    rw [h3.fderiv]
    simp
  
  have hopen : ∀ y₁ ∈ Ω, w y₁ = 0 → ∃ ρ > 0, Metric.ball y₁ ρ ⊆ {y | y ∈ Ω ∧ w y = 0} := by
    intro y₁ hy₁ hw₁
    obtain ⟨A, r, lam, Lam, K, hr, hlam, H⟩ := hloc y₁ hy₁ hw₁
    have hballΩ : Metric.ball y₁ r ⊆ Ω := fun y hy => (H y hy).1
    obtain ⟨K', hK'def⟩ : ∃ K' : ℝ, K' = max K 0 := ⟨_, rfl⟩
    have hK'0 : 0 ≤ K' := hK'def ▸ le_max_right _ _
    have hiv : ∀ y ∈ Metric.ball y₁ r,
        ∑ i, ∑ j, A y i j * partialDeriv i (partialDeriv j w) y ≤
          K' * (w y + ∑ i, |partialDeriv i w y|) := by
      intro y hy
      have hb : 0 ≤ w y + ∑ i, |partialDeriv i w y| :=
        add_nonneg (hnn y (hballΩ hy)) (Finset.sum_nonneg (fun i _ => abs_nonneg _))
      exact (H y hy).2.2.2.trans
        (mul_le_mul_of_nonneg_right (hK'def ▸ le_max_left _ _) hb)
    refine ⟨r / 4, by linarith, fun p hp =>
      ⟨hballΩ (Metric.ball_subset_ball (by linarith) hp), ?_⟩⟩
    by_contra hwp
    obtain ⟨c, x₀, R, hR, hx₀R, hwx₀, hpos, hcb⟩ := s7 y₁ r hr hballΩ hw₁ p hp hwp
    have hcbr : ∀ x : E3, ‖x - c‖ ≤ R → x ∈ Metric.ball y₁ r :=
      fun x hx => Metric.ball_subset_ball (by linarith) (hcb x hx)
    
    have hsne : (Metric.sphere c (R / 2)).Nonempty :=
      NormedSpace.sphere_nonempty.mpr (by linarith)
    obtain ⟨q, hq, hqmin⟩ := (isCompact_sphere c (R / 2)).exists_isMinOn hsne hwC.continuousOn
    have hqn : ‖q - c‖ = R / 2 := by rw [← dist_eq_norm]; exact hq
    obtain ⟨ε, hεdef⟩ : ∃ ε : ℝ, ε = w q := ⟨_, rfl⟩
    have hε0 : 0 < ε := hεdef ▸ hpos q (by rw [hqn]; linarith)
    have hεmin : ∀ x : E3, ‖x - c‖ = R / 2 → ε ≤ w x := by
      intro x hx
      rw [hεdef]
      exact isMinOn_iff.mp hqmin x (by rw [mem_sphere, dist_eq_norm]; exact hx)
    
    have hlR : 0 < lam * R ^ 2 := by positivity
    have hnum : 0 ≤ 6 * |Lam| + 6 * K' * R + K' := by positivity
    obtain ⟨α, hαdef⟩ : ∃ α : ℝ, α = 1 + (6 * |Lam| + 6 * K' * R + K') / (lam * R ^ 2) :=
      ⟨_, rfl⟩
    have hα1 : 1 ≤ α := by
      have := div_nonneg hnum hlR.le
      linarith
    have hα : 6 * |Lam| + 6 * K' * R + K' < α * (lam * R ^ 2) := by
      rw [hαdef, add_mul, one_mul, div_mul_cancel₀ _ hlR.ne']
      linarith
    have hα0 : 0 < α := by linarith
    
    obtain ⟨hvC0, hvD0, hvP0, hvH0⟩ := s4 c α R
    obtain ⟨v, hvdef⟩ : ∃ v : E3 → ℝ,
        v = fun x : E3 => Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2) := ⟨_, rfl⟩
    have hvC : ContDiff ℝ 2 v := hvdef ▸ hvC0
    have hvD : ∀ x u : E3, fderiv ℝ v x u
        = -2 * α * Real.exp (-α * ‖x - c‖ ^ 2) * inner ℝ (x - c) u := hvdef ▸ hvD0
    have hvP : ∀ (i : Fin 3) (x : E3), partialDeriv i v x
        = -2 * α * (x i - c i) * Real.exp (-α * ‖x - c‖ ^ 2) := hvdef ▸ hvP0
    have hvH : ∀ (i j : Fin 3) (x : E3), partialDeriv i (partialDeriv j v) x
        = (4 * α ^ 2 * (x i - c i) * (x j - c j) - 2 * α * (if i = j then 1 else 0))
            * Real.exp (-α * ‖x - c‖ ^ 2) := hvdef ▸ hvH0
    have hvx : ∀ x, v x = Real.exp (-α * ‖x - c‖ ^ 2) - Real.exp (-α * R ^ 2) := by
      intro x; rw [hvdef]
    have hE'0 : 0 < Real.exp (-α * R ^ 2) := Real.exp_pos _
    
    obtain ⟨hlinD0, hlinP0, hlinH0⟩ := s9 w v hw hvC ε
    obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun x => w x - ε * v x := ⟨_, rfl⟩
    have hhC : ContDiff ℝ 2 h := by rw [hhdef]; exact hw.sub (contDiff_const.mul hvC)
    have hlinD : ∀ y u : E3, fderiv ℝ h y u = fderiv ℝ w y u - ε * fderiv ℝ v y u :=
      hhdef ▸ hlinD0
    have hlinP : ∀ (i : Fin 3) (y : E3), partialDeriv i h y
        = partialDeriv i w y - ε * partialDeriv i v y := hhdef ▸ hlinP0
    have hlinH : ∀ (i j : Fin 3) (y : E3), partialDeriv i (partialDeriv j h) y
        = partialDeriv i (partialDeriv j w) y - ε * partialDeriv i (partialDeriv j v) y :=
      hhdef ▸ hlinH0
    have hhx : ∀ x, h x = w x - ε * v x := by intro x; rw [hhdef]
    
    have hint : ∀ z : E3, R / 2 < ‖z - c‖ → ‖z - c‖ < R →
        (∀ y : E3, R / 2 ≤ ‖y - c‖ → ‖y - c‖ ≤ R → h z ≤ h y) → 0 ≤ h z := by
      intro z hz1 hz2 hzmin
      by_contra hneg
      push_neg at hneg
      have hzloc : IsLocalMin h z := by
        have hU : IsOpen {y : E3 | R / 2 < ‖y - c‖ ∧ ‖y - c‖ < R} :=
          (isOpen_lt continuous_const (continuous_id.sub continuous_const).norm).inter
            (isOpen_lt (continuous_id.sub continuous_const).norm continuous_const)
        filter_upwards [hU.mem_nhds ⟨hz1, hz2⟩] with y hy
        exact hzmin y hy.1.le hy.2.le
      have hD0 : fderiv ℝ h z = 0 := hzloc.fderiv_eq_zero
      have hPw : ∀ i, partialDeriv i w z = ε * partialDeriv i v z := by
        intro i
        have h1 := hlinP i z
