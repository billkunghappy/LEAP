        + C_G * ((2702 + 2502 * Λ) * M / (ν ^ 4 * δ ^ 6)) := by ring
  intro x hx y hy i j
  have hxt : ‖x‖ < t := mem_ball_zero_iff.mp hx
  have hyt : ‖y‖ < t := mem_ball_zero_iff.mp hy
  have h1 := hGψ i j x y
  rw [hψw x hxt i j, hψw y hyt i j] at h1
  refine le_trans h1 ?_
  refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg (norm_nonneg _) _)
  linarith

theorem perturbed_ball_estimate (C_G : ℝ) (hCG : 0 ≤ C_G)
    (hG : ∀ (ψ : E3 → ℝ), ContDiff ℝ ∞ ψ → HasCompactSupport ψ → ∀ K : ℝ,
      (∀ x y : E3, |∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) x
          - ∑ k : Fin 3, partialDeriv k (fun z => partialDeriv k ψ z) y| ≤ K * ‖x - y‖ ^ (1 / 2 : ℝ)) →
      ∀ (i j : Fin 3) (x y : E3), |partialDeriv i (fun z => partialDeriv j ψ z) x
