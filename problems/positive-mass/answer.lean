  have hv := fun j => l2_cauchy_limit _ (hHb j).1 (fun m x => (U m : M → ℝ) (A.κ j x))
    (fun m => ((hHb j).2.2 _ (huc (U m) j)).1) (hcv j)
  choose v hvL2 hvconv hvpair using hv
  have hG := fun (j : Fin A.n) (a : Fin 3) => l2_cauchy_limit _ (hHb j).1
    (fun m x => partialDeriv a (fun z => (U m : M → ℝ) (A.κ j z)) x)
    (fun m => ((hHb j).2.2 _ ((hcc j _ _ (hsm (U m)).1 (hsm (U m)).1).2.1 a)).1) (hcd j a)
