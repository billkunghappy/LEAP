        linarith) x hx y hy i j
      have h2 : δ / (‖x - y‖ ^ (1 / 2 : ℝ) + 1) * ‖x - y‖ ^ (1 / 2 : ℝ) < δ := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ hq1]
        nlinarith
