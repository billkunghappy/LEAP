    have hgi : Integrable ((Metric.closedBall (0:E3) (c + 1) \ Metric.ball 0 c).indicator
        fun _ : E3 => K) := (integrableOn_const hSfin).integrable_indicator hSm
    have hle : ∀ y, ‖h y‖ ≤ (Metric.closedBall (0:E3) (c + 1) \ Metric.ball 0 c).indicator
