        exact hV₁K x hx.2 (by rw [← hxx]; exact hx'.1)
    
    have h8 : ∀ k, hullPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))
          (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source)) =
        hullPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))
          (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source)) := by
      intro k
      refine hcongr _ _ _ _ _ (hF₂ (pf k)) (hF₁ (pf k)) (Set.Subset.antisymm ?_ ?_)
      · exact chartLoc _ _ _ _ (hBs k) fun x hx hxF => (hR5 x hx.2).2 hxF
      · exact chartLoc _ _ _ _ (hBs k) fun x hx hxF => (hR5 x hx.2).1 hxF
    
    have h9 : ∀ k, sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k ∩ (chartAt E3 p).symm '' V₁)) ≤
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          (chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) :=
      fun k => sepPerG_chart_le g p (pf k) F₂ _ hF₂ (hAo k) (hAp k) (hAs k)
    
    have h9b : ∑ k, sepPerG (g.coeff (chartAt E3 p).symm)
          (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          (chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) ≤
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          V₁ := by
      refine (sepPerG_sum_le _ _ (hF₂ p) n
        (fun k => chartAt E3 p '' (W k ∩ (chartAt E3 p).symm '' V₁)) ?_).trans
        (mono _ _ _ _ ?_)
      · intro k l hkl
        rw [Set.disjoint_left]
        rintro _ ⟨x, hx, rfl⟩ ⟨x', hx', hxx'⟩
        have hxx : x' = x := (chartAt E3 p).injOn (hAp l hx') (hAp k hx) hxx'
        subst hxx
        exact Set.disjoint_left.1 (hW.2 hkl) hx.1 hx'.1
      · refine Set.iUnion_subset fun k => ?_
        exact (Set.image_mono Set.inter_subset_right).trans himV₁.le
    
    have h10 : ∑ k, hullPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))
          (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source)) +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
          V₂ ≤ hullRiemPer g F₁ Ω K := by
      obtain ⟨W', hW'c, hW'l⟩ : ∃ W' : Fin (n + 1) → Set M,
          (∀ k, W' (Fin.castSucc k) = W k \ (chartAt E3 p).symm '' closure V₂) ∧
          W' (Fin.last n) = (chartAt E3 p).symm '' V₂ :=
        ⟨Fin.snoc (α := fun _ => Set M) (fun k => W k \ (chartAt E3 p).symm '' closure V₂)
          ((chartAt E3 p).symm '' V₂), fun k => by simp, by simp⟩
      obtain ⟨pf', hpc, hpl⟩ : ∃ pf' : Fin (n + 1) → M,
          (∀ k, pf' (Fin.castSucc k) = pf k) ∧ pf' (Fin.last n) = p :=
        ⟨Fin.snoc (α := fun _ => M) pf p, fun k => by simp, by simp⟩
      have dl : ∀ k, Disjoint (W k \ (chartAt E3 p).symm '' closure V₂)
          ((chartAt E3 p).symm '' V₂) := by
        intro k
        rw [Set.disjoint_left]
        intro x hx hx'
        exact hx.2 (hV₂'C₂ hx')
      have hadm : (∀ i, IsOpen (W' i) ∧ W' i ⊆ Ω ∩ (chartAt E3 (pf' i)).source) ∧
          Pairwise (fun i j => Disjoint (W' i) (W' j)) := by
        refine ⟨fun i => ?_, fun i j hij => ?_⟩
        · rcases Fin.eq_castSucc_or_eq_last i with ⟨k, rfl⟩ | rfl
          · rw [hW'c, hpc]
            exact ⟨hBo k, fun x hx => ⟨hWΩ k hx.1, hWs k hx.1⟩⟩
          · rw [hW'l, hpl]
            exact ⟨hV₂'o, hV₂'src⟩
        · rcases Fin.eq_castSucc_or_eq_last i with ⟨k, rfl⟩ | rfl
          · rcases Fin.eq_castSucc_or_eq_last j with ⟨l, rfl⟩ | rfl
            · rw [hW'c, hW'c]
              have hkl : k ≠ l := fun h => hij (by rw [h])
              exact (hW.2 hkl).mono Set.diff_subset Set.diff_subset
            · rw [hW'c, hW'l]
              exact dl k
          · rcases Fin.eq_castSucc_or_eq_last j with ⟨l, rfl⟩ | rfl
            · rw [hW'c, hW'l]
              exact (dl l).symm
            · exact absurd rfl hij
      have hsum : ∑ i, hullPerG (g.coeff (chartAt E3 (pf' i)).symm)
          (chartAt E3 (pf' i) '' (F₁ ∩ (chartAt E3 (pf' i)).source))
          (chartAt E3 (pf' i) '' W' i)
          (chartAt E3 (pf' i) '' (K ∩ (chartAt E3 (pf' i)).source)) =
          ∑ k, hullPerG (g.coeff (chartAt E3 (pf k)).symm)
            (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
            (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))
            (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source)) +
          hullPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
            V₂ (chartAt E3 p '' (K ∩ (chartAt E3 p).source)) := by
        rw [Fin.sum_univ_castSucc]
        simp only [hW'c, hW'l, hpc, hpl, himV₂]
      have hdom : sepPerG (g.coeff (chartAt E3 p).symm)
          (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source)) V₂ ≤
          hullPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
            V₂ (chartAt E3 p '' (K ∩ (chartAt E3 p).source)) :=
        sepPerG_le_hullPerG _ _ _ _ _ (chartAt E3 p).open_target (hGsm p) (posDefC p)
          (hV₂1.trans hV₁t)
      refine (add_le_add le_rfl hdom).trans ?_
      rw [← hsum]
      unfold hullRiemPer
      exact le_iSup_of_le (n + 1) (le_iSup_of_le pf' (le_iSup_of_le W'
        (le_iSup_of_le hadm le_rfl)))
    
    have step1 : ∑ k, hullPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source)) (chartAt E3 (pf k) '' W k)
          (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source)) ≤
        ∑ k, (sepPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₂ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k ∩ (chartAt E3 p).symm '' V₁)) +
        hullPerG (g.coeff (chartAt E3 (pf k)).symm)
          (chartAt E3 (pf k) '' (F₁ ∩ (chartAt E3 (pf k)).source))
          (chartAt E3 (pf k) '' (W k \ (chartAt E3 p).symm '' closure V₂))
          (chartAt E3 (pf k) '' (K ∩ (chartAt E3 (pf k)).source))) :=
      Finset.sum_le_sum fun k _ => (h7 k).trans_eq (by rw [h8 k])
    rw [Finset.sum_add_distrib] at step1
    refine (add_le_add step1 le_rfl).trans ?_
    rw [add_assoc, add_comm (hullRiemPer g F₁ Ω K)]
    exact add_le_add ((Finset.sum_le_sum fun k _ => h9 k).trans h9b) h10
  
  have c0 : sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₁ ∩ (chartAt E3 p).source))
      V₂ ≤ hullRiemPer g F₁ Ω K +
        sepPerG (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F₂ ∩ (chartAt E3 p).source))
          V₁ := by
    have h := key 0 Fin.elim0 Fin.elim0 ⟨fun k => k.elim0, fun k => k.elim0⟩
    simpa using h
  refine le_trans ?_ le_self_add
  generalize hullRiemPer g F₁ Ω K = S₁ at key c0 ⊢
  unfold hullRiemPer
  rw [ENNReal.iSup_add]
  refine iSup_le fun n => ?_
  rw [ENNReal.iSup_add]
  refine iSup_le fun pf => ?_
  rw [ENNReal.iSup_add]
  refine iSup_le fun W => ?_
  by_cases h : (∀ k, IsOpen (W k) ∧ W k ⊆ Ω ∩ (chartAt E3 (pf k)).source) ∧
      Pairwise (fun k l => Disjoint (W k) (W l))
  · rw [iSup_pos h]
    exact key n pf W h
  · rw [iSup_neg h, bot_eq_zero, zero_add]
    exact c0

theorem hullMinimizer_chart_local [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (K Ω Kv O A₀ F : Set M) (hK : IsClosed K) (hΩ : IsOpen Ω) (hKvΩ : Kv ⊆ Ω) (hO : IsOpen O) (hOKv : O ⊆ Kv) (hOK : Disjoint O K) (hF : sepChartMeas F) (hFA : symmDiff F A₀ ⊆ Kv) (hfin : hullRiemPer g F Ω K < ⊤) (hmin : ∀ F' : Set M, sepChartMeas F' → symmDiff F' A₀ ⊆ Kv → hullRiemPer g F Ω K ≤ hullRiemPer g F' Ω K) (p : M) : sepIsPerMin (g.coeff (chartAt E3 p).symm) (chartAt E3 p '' (F ∩ (chartAt E3 p).source)) (chartAt E3 p '' (O ∩ (chartAt E3 p).source)) :=
by
  classical
  set κ := chartAt E3 p with hκ
  set G := g.coeff κ.symm with hGdef
  set Φ := κ '' (F ∩ κ.source) with hΦdef
  set U := κ '' (O ∩ κ.source) with hUdef
  have hOΩ : O ⊆ Ω := hOKv.trans hKvΩ
  
  have hUt : U ⊆ κ.target := by
    rintro _ ⟨x, hx, rfl⟩
    exact κ.map_source hx.2
  
  have hB2 : ∀ Z : Set E3, Z ⊆ U → κ.symm '' Z ⊆ O ∩ κ.source := by
    rintro Z hZ _ ⟨z, hz, rfl⟩
    obtain ⟨x, hx, rfl⟩ := hZ hz
    rw [κ.left_inv hx.2]
    exact hx
  
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) κ.target :=
    fun i j => g.smooth p i j
  have hpd : ∀ y ∈ κ.target, (G y).PosDef := fun y hy => coeff_chart_symm_posDef g p y hy
  have hdet : ∀ y ∈ κ.target, 0 < (G y).det := fun y hy => (hpd y hy).det_pos
  
  have hloc_le : ∀ V : Set E3, IsOpen V → V ⊆ U → sepPerG G Φ V ≤ hullRiemPer g F Ω K := by
    intro V hV hVU
    have hVt : V ⊆ κ.target := hVU.trans hUt
    have hWo : IsOpen (κ.symm '' V) := κ.isOpen_image_symm_of_subset_target hV hVt
    have hWsub : κ.symm '' V ⊆ Ω ∩ κ.source := fun x hx =>
      ⟨hOΩ (hB2 V hVU hx).1, (hB2 V hVU hx).2⟩
    have himg : κ '' (κ.symm '' V) = V := κ.toPartialEquiv.image_symm_image_of_subset_target hVt
    have hdom : sepPerG G Φ V ≤ hullPerG G Φ V (κ '' (K ∩ κ.source)) :=
      sepPerG_le_hullPerG G κ.target Φ V (κ '' (K ∩ κ.source)) κ.open_target hGs hpd hVt
    refine hdom.trans ?_
    rw [← himg]
    unfold hullRiemPer
    refine le_iSup_of_le 1 (le_iSup_of_le (fun _ => p) (le_iSup_of_le (fun _ => κ.symm '' V)
      (le_iSup_of_le ⟨fun _ => ⟨hWo, hWsub⟩, fun k l hkl => (hkl (Subsingleton.elim k l)).elim⟩
        ?_)))
    rw [Fin.sum_univ_one]
  unfold sepIsPerMin
  refine ⟨hF p, fun V hV _ hVU => lt_of_le_of_lt (hloc_le V hV (subset_closure.trans hVU)) hfin,
    ?_⟩
  
  intro F' V K' hF' hV _ hVU hK'c hK'V hsd
  have hVU' : V ⊆ U := subset_closure.trans hVU
  have hVt : V ⊆ κ.target := hVU'.trans hUt
  have hK't : K' ⊆ κ.target := hK'V.trans hVt
  set L := κ.symm '' K' with hLdef
  set F'' := (F \ L) ∪ κ.symm '' (F' ∩ K') with hF''def
  have hLO : L ⊆ O := fun x hx => (hB2 K' (hK'V.trans hVU') hx).1
  
  have hP1 : symmDiff F F'' ⊆ L := by
    intro x hx
    rcases Set.mem_symmDiff.1 hx with ⟨hxF, hxF''⟩ | ⟨hxF'', hxF⟩
    · by_contra hxL
      exact hxF'' (Or.inl ⟨hxF, hxL⟩)
    · rcases hxF'' with ⟨hxF', _⟩ | ⟨z, hz, rfl⟩
      · exact absurd hxF' hxF
      · exact ⟨z, hz.2, rfl⟩
  
  have hP2 : symmDiff F'' A₀ ⊆ Kv := by
    intro x hx
    by_cases hxF : x ∈ F
    · by_cases hxF'' : x ∈ F''
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨_, hA⟩ | ⟨_, hn⟩
        · exact Set.mem_symmDiff.2 (Or.inl ⟨hxF, hA⟩)
        · exact absurd hxF'' hn
      · exact hOKv (hLO (hP1 (Set.mem_symmDiff.2 (Or.inl ⟨hxF, hxF''⟩))))
    · by_cases hxF'' : x ∈ F''
      · exact hOKv (hLO (hP1 (Set.mem_symmDiff.2 (Or.inr ⟨hxF'', hxF⟩))))
      · apply hFA
        rcases Set.mem_symmDiff.1 hx with ⟨h, _⟩ | ⟨hA, _⟩
        · exact absurd h hxF''
        · exact Set.mem_symmDiff.2 (Or.inr ⟨hA, hxF⟩)
  
  have hF'sub : F' \ Φ ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inr hz))
  have hΦsub : Φ \ F' ⊆ K' := fun z hz => hsd (Set.mem_symmDiff.2 (Or.inl hz))
  have hP3 : κ '' (F'' ∩ κ.source) = F' := by
    ext z
    constructor
    · rintro ⟨x, ⟨hxF'', hxs⟩, rfl⟩
      rcases hxF'' with ⟨hxF, hxL⟩ | ⟨w, hw, rfl⟩
      · by_contra hz
        have hK : κ x ∈ K' := hΦsub ⟨⟨x, ⟨hxF, hxs⟩, rfl⟩, hz⟩
        exact hxL ⟨κ x, hK, κ.left_inv hxs⟩
      · rw [κ.right_inv (hK't hw.2)]
        exact hw.1
    · intro hz
      by_cases hzK : z ∈ K'
      · exact ⟨κ.symm z, ⟨Or.inr ⟨z, ⟨hz, hzK⟩, rfl⟩, κ.map_target (hK't hzK)⟩,
          κ.right_inv (hK't hzK)⟩
      · have hzΦ : z ∈ Φ := by
          by_contra h
          exact hzK (hF'sub ⟨hz, h⟩)
        obtain ⟨x, ⟨hxF, hxs⟩, rfl⟩ := hzΦ
        refine ⟨x, ⟨Or.inl ⟨hxF, ?_⟩, hxs⟩, rfl⟩
        rintro ⟨w, hw, hwx⟩
        apply hzK
        rw [← hwx, κ.right_inv (hK't hw)]
        exact hw
  
  have hP4 : sepChartMeas F'' := by
    intro q
    set κq := chartAt E3 q with hκq
    have hI : ∀ S : Set M, κq '' (S ∩ κq.source) = κq.target ∩ κq.symm ⁻¹' S := by
      intro S
      rw [Set.inter_comm S]
      exact κq.image_source_inter_eq' S
    have hLc : IsCompact L := hK'c.image_of_continuousOn (κ.continuousOn_symm.mono hK't)
    have hIL : MeasurableSet (κq.target ∩ κq.symm ⁻¹' L) := by
      have ho : IsOpen (κq.target ∩ κq.symm ⁻¹' Lᶜ) :=
        κq.continuousOn_symm.isOpen_inter_preimage κq.open_target hLc.isClosed.isOpen_compl
      have heq : κq.target ∩ κq.symm ⁻¹' L = κq.target \ (κq.target ∩ κq.symm ⁻¹' Lᶜ) := by
        ext z
        simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_diff, Set.mem_compl_iff]
        tauto
      rw [heq]
      exact κq.open_target.measurableSet.diff ho.measurableSet
    have hIF : MeasurableSet (κq.target ∩ κq.symm ⁻¹' F) := by
      rw [← hI]
      exact hF q
    have hBt : F' ∩ K' ⊆ κ.target := fun z hz => hK't hz.2
    have hBm : MeasurableSet (F' ∩ K') := hF'.inter hK'c.isClosed.measurableSet
    have hsymmB : κ.symm '' (F' ∩ K') = κ.source ∩ κ ⁻¹' (F' ∩ K') :=
      κ.symm_image_eq_source_inter_preimage hBt
    have hDo : IsOpen (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κq.continuousOn_symm.isOpen_inter_preimage κq.open_target κ.open_source
    have hτc : ContinuousOn (fun z => κ (κq.symm z)) (κq.target ∩ κq.symm ⁻¹' κ.source) :=
      κ.continuousOn.comp (κq.continuousOn_symm.mono Set.inter_subset_left) (fun z hz => hz.2)
    have hIB : MeasurableSet ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩
        (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K')) := by
      have hpw : Measurable ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
          (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) :=
        hτc.measurable_piecewise continuousOn_const hDo.measurableSet
      have heq : (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K') =
          (κq.target ∩ κq.symm ⁻¹' κ.source) ∩ ((κq.target ∩ κq.symm ⁻¹' κ.source).piecewise
            (fun z => κ (κq.symm z)) (fun _ => (0 : E3))) ⁻¹' (F' ∩ K') := by
        ext z
        constructor
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD]
          exact hzB
        · rintro ⟨hzD, hzB⟩
          refine ⟨hzD, ?_⟩
          simp only [Set.mem_preimage, Set.piecewise_eq_of_mem _ _ _ hzD] at hzB
          exact hzB
      rw [heq]
      exact hDo.measurableSet.inter (hpw hBm)
    have hmain : κq.target ∩ κq.symm ⁻¹' F'' =
        ((κq.target ∩ κq.symm ⁻¹' F) \ (κq.target ∩ κq.symm ⁻¹' L)) ∪
          ((κq.target ∩ κq.symm ⁻¹' κ.source) ∩ (fun z => κ (κq.symm z)) ⁻¹' (F' ∩ K')) := by
      rw [hF''def, hsymmB]
      ext z
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_union, Set.mem_diff]
      tauto
    show MeasurableSet (κq '' (F'' ∩ κq.source))
    rw [hI, hmain]
    exact (hIF.diff hIL).union hIB
  
  have hP5 : hullRiemPer g F Ω K ≤ hullRiemPer g F'' Ω K := hmin F'' hP4 hP2
  have hfinV : sepPerG G Φ V < ⊤ := lt_of_le_of_lt (hloc_le V hV hVU') hfin
  have hne : hullRiemPer g F Ω K ≠ ⊤ := hfin.ne
  
  have hUΩK : U ⊆ κ '' ((Ω \ K) ∩ κ.source) :=
    Set.image_mono (fun x hx => ⟨⟨hOΩ hx.1, Set.disjoint_left.1 hOK hx.1⟩, hx.2⟩)
  
  refine sepPerG_le_of_local_compare G κ.target Φ F' V K' κ.open_target hGs hdet (hF p) hF' hV
    hVt hK'c hK'V hsd hfinV ?_
  intro V₁ V₂ hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ hV₁V
  have hV₁Ω : V₁ ⊆ κ '' ((Ω \ K) ∩ κ.source) := hV₁V.trans (hVU'.trans hUΩK)
  have h3 : hullRiemPer g F'' Ω K + sepPerG G Φ V₂ ≤
      hullRiemPer g F Ω K + sepPerG G (κ '' (F'' ∩ κ.source)) V₁ + sepPerG G Φ (V₁ \ K') :=
    hullRiemPer_add_chart_le g F F'' Ω K p K' V₁ V₂ hF hP4 hK'c hV₁ hV₂ hK'V₂ hV₂c hV₂V₁ hV₁Ω
      hP1
  rw [hP3] at h3
  have h4 : hullRiemPer g F Ω K + sepPerG G Φ V₂ ≤
      hullRiemPer g F Ω K + (sepPerG G F' V₁ + sepPerG G Φ (V₁ \ K')) := by
    calc hullRiemPer g F Ω K + sepPerG G Φ V₂ ≤ hullRiemPer g F'' Ω K + sepPerG G Φ V₂ :=
          add_le_add hP5 le_rfl
      _ ≤ _ := h3
      _ = _ := add_assoc _ _ _
  exact (ENNReal.add_le_add_iff_left hne).1 h4

theorem sepPosDef_normalizer (P : Matrix (Fin 3) (Fin 3) ℝ) (hP : P.PosDef) :
    ∃ L : E3 ≃L[ℝ] E3, ∀ i j : Fin 3, ∑ k : Fin 3, ∑ l : Fin 3,
      (L (e i)) k * P k l * (L (e j)) l = if i = j then (1 : ℝ) else 0 :=
by
  classical
  obtain ⟨B, hB⟩ := Matrix.posSemidef_iff_eq_conjTranspose_mul_self.mp hP.posSemidef
  rw [Matrix.conjTranspose_eq_transpose_of_trivial] at hB
  have hdetB : IsUnit B.det := by
    have h1 := hP.det_pos
    rw [hB, Matrix.det_mul, Matrix.det_transpose] at h1
    refine isUnit_iff_ne_zero.mpr ?_
    intro h0
    rw [h0, mul_zero] at h1
    exact lt_irrefl _ h1
  have hBA : B * B⁻¹ = 1 := Matrix.mul_nonsing_inv B hdetB
  have hAB : B⁻¹ * B = 1 := Matrix.nonsing_inv_mul B hdetB
  have hAPA : (B⁻¹).transpose * P * B⁻¹ = 1 := by
    rw [hB]
    calc (B⁻¹).transpose * (B.transpose * B) * B⁻¹
        = (B * B⁻¹).transpose * (B * B⁻¹) := by
          rw [Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
      _ = 1 := by rw [hBA, Matrix.transpose_one, one_mul]
  have hleft : Function.LeftInverse (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B)
      (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B⁻¹) := by
    intro v
    show (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B *
      Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B⁻¹) v = v
    rw [← map_mul, hBA, map_one]
    rfl
  have hright : Function.RightInverse (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B)
      (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B⁻¹) := by
    intro v
    show (Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B⁻¹ *
      Matrix.toEuclideanCLM (𝕜 := ℝ) (n := Fin 3) B) v = v
    rw [← map_mul, hAB, map_one]
    rfl
  refine ⟨ContinuousLinearEquiv.equivOfInverse _ _ hleft hright, fun i j => ?_⟩
  have hcol : ∀ m k : Fin 3,
      (ContinuousLinearEquiv.equivOfInverse _ _ hleft hright (e m)) k = B⁻¹ k m := by
    intro m k
    rw [ContinuousLinearEquiv.equivOfInverse_apply]
    have hem : e m = WithLp.toLp 2 ((e m).ofLp) := (WithLp.toLp_ofLp _ (e m)).symm
    rw [hem, Matrix.toEuclideanCLM_toLp]
    simp [Matrix.mulVec, dotProduct, EuclideanSpace.single_apply]
  simp only [hcol]
  have h := congrFun (congrFun hAPA i) j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul] at h
  rw [Finset.sum_comm] at h
  rw [h, Matrix.one_apply]

theorem sepAffinePullback (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (hU : IsOpen U)
    (hF : MeasurableSet F) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ U, (G y).PosDef)
    (y₀ : E3) (L : E3 ≃L[ℝ] E3) (c : ℝ) (hc : 0 < c) :
    (∀ V : Set E3, V ⊆ U →
      sepPerG (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
          ((fun w => y₀ + L w) ⁻¹' F) ((fun w => y₀ + L w) ⁻¹' V) =
        ENNReal.ofReal c * sepPerG G F V) ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun z => (c • pullbackMetric G (fun w => y₀ + L w) z) i j)
      ((fun w => y₀ + L w) ⁻¹' U)) ∧
    (∀ (z : E3) (i j : Fin 3), (c • pullbackMetric G (fun w => y₀ + L w) z) i j =
      (c • pullbackMetric G (fun w => y₀ + L w) z) j i) ∧
    (∀ z ∈ (fun w => y₀ + L w) ⁻¹' U, (c • pullbackMetric G (fun w => y₀ + L w) z).PosDef) ∧
    (sepIsPerMin G F U → sepIsPerMin (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
      ((fun w => y₀ + L w) ⁻¹' F) ((fun w => y₀ + L w) ⁻¹' U)) :=
by
  have hfd : ∀ z : E3, fderiv ℝ (fun w : E3 => y₀ + L w) z = (L : E3 →L[ℝ] E3) := by
    intro z
    rw [fderiv_const_add]
    exact L.fderiv
  have hs : 0 < Real.sqrt c := Real.sqrt_pos.2 hc
  have hss : Real.sqrt c * Real.sqrt c = c := Real.mul_self_sqrt hc.le
  have hφc : Continuous (fun w : E3 => y₀ + L w) := continuous_const.add L.continuous
  
  have s2 : ∀ z v : E3, ∑ i : Fin 3, ∑ j : Fin 3,
      (c • pullbackMetric G (fun w => y₀ + L w) z) i j * v i * v j =
      c * ∑ k : Fin 3, ∑ l : Fin 3, G (y₀ + L z) k l * (L v) k * (L v) l := by
    intro z v
    have hv : v = v 0 • e 0 + v 1 • e 1 + v 2 • e 2 := by
      ext k; fin_cases k <;> simp [e, EuclideanSpace.single_apply]
    have hLv : ∀ k, (L v) k = v 0 * (L (e 0)) k + v 1 * (L (e 1)) k + v 2 * (L (e 2)) k := by
      intro k
      conv_lhs => rw [hv]
      simp [map_add, map_smul]
    simp only [pullbackMetric, hfd, Matrix.smul_apply, smul_eq_mul, Fin.sum_univ_three, hLv,
      ContinuousLinearEquiv.coe_coe]
    ring
  
  have s1 : (∀ i j : Fin 3, ContDiffOn ℝ ∞
        (fun z => (c • pullbackMetric G (fun w => y₀ + L w) z) i j)
        ((fun w => y₀ + L w) ⁻¹' U)) ∧
      (∀ (z : E3) (i j : Fin 3), (c • pullbackMetric G (fun w => y₀ + L w) z) i j =
        (c • pullbackMetric G (fun w => y₀ + L w) z) j i) ∧
      (∀ z ∈ (fun w => y₀ + L w) ⁻¹' U, (c • pullbackMetric G (fun w => y₀ + L w) z).PosDef) := by
    have hent : ∀ z a b, (c • pullbackMetric G (fun w => y₀ + L w) z) a b =
        c * ∑ i : Fin 3, ∑ j : Fin 3, (L (e a)) i * G (y₀ + L z) i j * (L (e b)) j := by
      intro z a b
      simp only [pullbackMetric, hfd, Matrix.smul_apply, smul_eq_mul,
        ContinuousLinearEquiv.coe_coe]
    refine ⟨?_, ?_, ?_⟩
    · intro a b
      simp_rw [hent]
      have hφ : ContDiff ℝ ∞ (fun w : E3 => y₀ + L w) := contDiff_const.add L.contDiff
      apply contDiffOn_const.mul
      apply ContDiffOn.sum; intro i _
      apply ContDiffOn.sum; intro j _
      refine ContDiffOn.mul (contDiffOn_const.mul ?_) contDiffOn_const
      exact (hG i j).comp hφ.contDiffOn (fun z hz => hz)
    · intro z a b
      rw [hent, hent]
      congr 1
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      rw [hsymm]; ring
    · intro z hz
      set B : Matrix (Fin 3) (Fin 3) ℝ := Matrix.of fun k a => (L (e a)) k with hB
      have hmat : c • pullbackMetric G (fun w => y₀ + L w) z =
          c • (B.conjTranspose * G (y₀ + L z) * B) := by
        ext a b
        rw [hent]
        simp only [Matrix.smul_apply, smul_eq_mul, Matrix.mul_apply, Matrix.conjTranspose_apply,
          star_trivial, hB, Matrix.of_apply, Fin.sum_univ_three]
        ring
      have hinj : Function.Injective B.mulVec := by
        intro v w hvw
        have key : ∀ u : Fin 3 → ℝ, ∀ k,
            B.mulVec u k = (L (u 0 • e 0 + u 1 • e 1 + u 2 • e 2)) k := by
          intro u k
          simp [Matrix.mulVec, dotProduct, hB, Fin.sum_univ_three, map_add, map_smul]
          ring
        have h2 : (v 0 • e 0 + v 1 • e 1 + v 2 • e 2 : E3) =
            (w 0 • e 0 + w 1 • e 1 + w 2 • e 2 : E3) := by
          apply L.injective
          ext k
          rw [← key v k, ← key w k, hvw]
        funext k
        have := congrArg (fun x : E3 => x k) h2
        fin_cases k <;> simpa [e, EuclideanSpace.single_apply] using this
      rw [hmat]
      exact ((hpd _ hz).conjTranspose_mul_mul_same hinj).smul hc
  
  have s3 : ∀ (X : E3 → E3) (z : E3),
      DifferentiableAt ℝ (fun y => Real.sqrt (G y).det • X y) (y₀ + L z) →
      sepDensDiv (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
        (fun z => (Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z))) z =
        c * |(L : E3 →L[ℝ] E3).det| * sepDensDiv G X (y₀ + L z) := by
    intro X z hY
    set D := (L : E3 →L[ℝ] E3).det with hD
    set A : Matrix (Fin 3) (Fin 3) ℝ := Matrix.of fun k a => (L (e a)) k with hA
    have hAD : A.det = D := by
      have : LinearMap.toMatrix (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
          (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis ((L : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = A := by
        ext k a
        simp [LinearMap.toMatrix_apply, hA]
      rw [← this, LinearMap.det_toMatrix]
    have hmat : ∀ z', c • pullbackMetric G (fun w => y₀ + L w) z' =
        c • (A.transpose * G (y₀ + L z') * A) := by
      intro z'
      ext a b
      simp only [pullbackMetric, hfd, Matrix.smul_apply, smul_eq_mul,
        ContinuousLinearEquiv.coe_coe, Matrix.mul_apply, Matrix.transpose_apply, hA,
        Matrix.of_apply, Fin.sum_univ_three]
      ring
    have hsqrt : ∀ z', Real.sqrt (c • pullbackMetric G (fun w => y₀ + L w) z').det =
        c * |D| * Real.sqrt c * Real.sqrt (G (y₀ + L z')).det := by
      intro z'
      rw [hmat, Matrix.det_smul, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hAD]
      simp only [Fintype.card_fin]
      have h1 : |D| ^ 2 = D ^ 2 := sq_abs D
      have : c ^ 3 * (D * (G (y₀ + L z')).det * D) =
          (c * |D| * Real.sqrt c) ^ 2 * (G (y₀ + L z')).det := by
        calc c ^ 3 * (D * (G (y₀ + L z')).det * D)
            = c * c * c * D ^ 2 * (G (y₀ + L z')).det := by ring
          _ = c * c * (Real.sqrt c * Real.sqrt c) * |D| ^ 2 * (G (y₀ + L z')).det := by
            rw [hss, h1]
          _ = _ := by ring
      rw [this, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity)]
    have hfun : ∀ i : Fin 3,
        (fun z' => Real.sqrt (c • pullbackMetric G (fun w => y₀ + L w) z').det *
          ((Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z'))) i) =
        fun z' => (c * |D|) * (L.symm (Real.sqrt (G (y₀ + L z')).det • X (y₀ + L z'))) i := by
      intro i; funext z'
      rw [hsqrt]
      simp only [map_smul, PiLp.smul_apply, smul_eq_mul]
      field_simp
    have hφd : HasFDerivAt (fun w : E3 => y₀ + L w) (L : E3 →L[ℝ] E3) z :=
      (L : E3 →L[ℝ] E3).hasFDerivAt.const_add y₀
    set DY := fderiv ℝ (fun y => Real.sqrt (G y).det • X y) (y₀ + L z) with hDY
    have hYd : HasFDerivAt (fun y => Real.sqrt (G y).det • X y) DY (y₀ + L z) :=
      hY.hasFDerivAt
    have hcomp : HasFDerivAt (fun z' => Real.sqrt (G (y₀ + L z')).det • X (y₀ + L z'))
        (DY.comp (L : E3 →L[ℝ] E3)) z :=
      HasFDerivAt.comp (f := fun w : E3 => y₀ + L w) z hYd hφd
    have hcomp2 : ∀ i : Fin 3, HasFDerivAt
        (fun z' => (L.symm (Real.sqrt (G (y₀ + L z')).det • X (y₀ + L z'))) i)
        ((EuclideanSpace.proj i).comp
          ((L.symm : E3 →L[ℝ] E3).comp (DY.comp (L : E3 →L[ℝ] E3)))) z := by
      intro i
      exact (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).hasFDerivAt.comp z
        ((L.symm : E3 →L[ℝ] E3).hasFDerivAt.comp z hcomp)
    have hterm : ∀ i : Fin 3,
        fderiv ℝ (fun z' => Real.sqrt (c • pullbackMetric G (fun w => y₀ + L w) z').det *
          ((Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z'))) i) z (e i) =
        (c * |D|) * (L.symm (DY (L (e i)))) i := by
      intro i
      rw [hfun i, ((hcomp2 i).const_mul (c * |D|)).fderiv]
      simp
    have hterm2 : ∀ k : Fin 3,
        fderiv ℝ (fun y => Real.sqrt (G y).det * X y k) (y₀ + L z) (e k) = (DY (e k)) k := by
      intro k
      have h : HasFDerivAt (fun y => Real.sqrt (G y).det * X y k)
          ((EuclideanSpace.proj k : E3 →L[ℝ] ℝ).comp DY) (y₀ + L z) := by
        have := (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt.comp (y₀ + L z) hYd
        convert this using 1
      rw [h.fderiv]; simp
    have htr : ∀ f : E3 →ₗ[ℝ] E3, LinearMap.trace ℝ E3 f = ∑ i : Fin 3, (f (e i)) i := by
      intro f
      rw [LinearMap.trace_eq_matrix_trace ℝ (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis]
      simp [Matrix.trace, LinearMap.toMatrix_apply]
    have htrace : ∑ i : Fin 3, (L.symm (DY (L (e i)))) i = ∑ k : Fin 3, (DY (e k)) k := by
      have h1 := htr (((L.symm : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) ∘ₗ ((DY : E3 →ₗ[ℝ] E3) ∘ₗ
        ((L : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3)))
      have h2 := htr (DY : E3 →ₗ[ℝ] E3)
      have h3 : LinearMap.trace ℝ E3 (((L.symm : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) ∘ₗ
          ((DY : E3 →ₗ[ℝ] E3) ∘ₗ ((L : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3))) =
          LinearMap.trace ℝ E3 (DY : E3 →ₗ[ℝ] E3) := by
        rw [LinearMap.trace_comp_comm', LinearMap.comp_assoc]
        have hid : ((L : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) ∘ₗ
            ((L.symm : E3 →L[ℝ] E3) : E3 →ₗ[ℝ] E3) = LinearMap.id := by
          ext x; simp
        rw [hid, LinearMap.comp_id]
      rw [h3] at h1
      rw [h1] at h2
      simpa using h2
    simp only [sepDensDiv, partialDeriv]
    rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_congr rfl (fun k _ => hterm2 k),
      ← htrace, Finset.mul_sum]
  
  have s4 : ∀ F' : Set E3, MeasurableSet F' → ∀ f : E3 → ℝ,
      ∫ z in (fun w => y₀ + L w) ⁻¹' F', |(L : E3 →L[ℝ] E3).det| * f (y₀ + L z) =
        ∫ y in F', f y := by
    intro F' hF' f
    have hm : MeasurableSet ((fun w => y₀ + L w) ⁻¹' F') := hF'.preimage hφc.measurable
    have h := MeasureTheory.integral_image_eq_integral_abs_det_fderiv_smul volume hm
      (f := fun w => y₀ + L w) (f' := fun _ => (L : E3 →L[ℝ] E3))
      (fun x _ => ((L : E3 →L[ℝ] E3).hasFDerivAt.const_add y₀).hasFDerivWithinAt)
      (fun a _ b _ hab => L.injective (add_left_cancel hab)) f
    have himg : (fun w => y₀ + L w) '' ((fun w => y₀ + L w) ⁻¹' F') = F' := by
      apply Set.image_preimage_eq
      intro y
      exact ⟨L.symm (y - y₀), by simp⟩
    rw [himg] at h
    rw [h]
    simp only [smul_eq_mul]
  
  have s5 : ∀ X : E3 → E3, ContDiff ℝ ∞ X → tsupport X ⊆ U →
      ContDiff ℝ ∞ (fun y => Real.sqrt (G y).det • X y) := by
    intro X hX hXU
    have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) U := by
      have : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
          - G y 0 0 * G y 1 2 * G y 2 1 - G y 0 1 * G y 1 0 * G y 2 2
          + G y 0 1 * G y 1 2 * G y 2 0 + G y 0 2 * G y 1 0 * G y 2 1
          - G y 0 2 * G y 1 1 * G y 2 0 := by
        funext y; exact Matrix.det_fin_three _
      rw [this]
      have h := hG
      fun_prop (disch := assumption)
    rw [contDiff_iff_contDiffAt]
    intro y
    by_cases hy : y ∈ tsupport X
    · have hyU := hXU hy
      have h1 : ContDiffAt ℝ ∞ (fun y => (G y).det) y := hdet.contDiffAt (hU.mem_nhds hyU)
      have h2 : ContDiffAt ℝ ∞ (fun y => Real.sqrt (G y).det) y :=
        h1.sqrt (hpd y hyU).det_pos.ne'
      exact h2.smul hX.contDiffAt
    · have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
      have hev' : (fun y => Real.sqrt (G y).det • X y) =ᶠ[𝓝 y] fun _ => (0 : E3) := by
        filter_upwards [hev] with w hw
        simp [hw]
      exact contDiffAt_const.congr_of_eventuallyEq hev'
  
  have fwd : ∀ (g : E3 → E3), ContDiff ℝ ∞ g → g 0 = 0 → ∀ (a : E3) (M : E3 ≃L[ℝ] E3)
      (X : E3 → E3) (V : Set E3), ContDiff ℝ ∞ X → HasCompactSupport X → tsupport X ⊆ V →
      ContDiff ℝ ∞ (fun z => g (X (a + M z))) ∧ HasCompactSupport (fun z => g (X (a + M z))) ∧
        tsupport (fun z => g (X (a + M z))) ⊆ (fun w => a + M w) ⁻¹' V := by
    intro g hg hg0 a M X V hX hXc hXV
    let Φ : E3 ≃ₜ E3 := M.toHomeomorph.trans (Homeomorph.addLeft a)
    have hΦ : (fun z => g (X (a + M z))) = (g ∘ X) ∘ Φ := by
      funext z; rfl
    refine ⟨hg.comp (hX.comp (contDiff_const.add M.contDiff)), ?_, ?_⟩
    · rw [hΦ]
      exact (hXc.comp_left hg0).comp_homeomorph Φ
    · rw [hΦ, tsupport_comp_eq_preimage]
      intro z hz
      exact hXV (tsupport_comp_subset hg0 X hz)
  
  have s7 : ∀ (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F V F' V' : Set E3) (k : ℝ), 0 ≤ k →
      ∀ (T S : (E3 → E3) → (E3 → E3)),
      (∀ X : E3 → E3, (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ V ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j ≤ 1) →
        (ContDiff ℝ ∞ (T X) ∧ HasCompactSupport (T X) ∧ tsupport (T X) ⊆ V' ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, H y i j * T X y i * T X y j ≤ 1) ∧
        ∫ y in F', sepDensDiv H (T X) y = k * ∫ y in F, sepDensDiv G X y) →
      (∀ X' : E3 → E3, (ContDiff ℝ ∞ X' ∧ HasCompactSupport X' ∧ tsupport X' ⊆ V' ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, H y i j * X' y i * X' y j ≤ 1) →
        (ContDiff ℝ ∞ (S X') ∧ HasCompactSupport (S X') ∧ tsupport (S X') ⊆ V ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G y i j * S X' y i * S X' y j ≤ 1) ∧ T (S X') = X') →
      sepPerG H F' V' = ENNReal.ofReal k * sepPerG G F V := by
    intro G H F V F' V' k hk T S hT hS
    unfold sepPerG
    rw [ENNReal.mul_iSup]
    simp_rw [ENNReal.mul_iSup]
    apply le_antisymm
    · refine iSup₂_le fun X' hX' => ?_
      obtain ⟨hSX, hTS⟩ := hS X' hX'
      have e1 := (hT (S X') hSX).2
      rw [hTS] at e1
      rw [e1, ENNReal.ofReal_mul hk]
      exact le_iSup₂ (f := fun X _ =>
        ENNReal.ofReal k * ENNReal.ofReal (∫ y in F, sepDensDiv G X y)) (S X') hSX
    · refine iSup₂_le fun X hX => ?_
      rw [← ENNReal.ofReal_mul hk, ← (hT X hX).2]
      exact le_iSup₂ (f := fun X' _ => ENNReal.ofReal (∫ y in F', sepDensDiv H X' y))
        (T X) (hT X hX).1
  
  have P1 : ∀ F' : Set E3, MeasurableSet F' → ∀ V : Set E3, V ⊆ U →
      sepPerG (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
          ((fun w => y₀ + L w) ⁻¹' F') ((fun w => y₀ + L w) ⁻¹' V) =
        ENNReal.ofReal c * sepPerG G F' V := by
    intro F' hF' V hVU
    apply s7 G (fun z => c • pullbackMetric G (fun w => y₀ + L w) z) F' V _ _ c hc.le
      (fun X z => (Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z)))
      (fun X' y => Real.sqrt c • L (X' (L.symm (y - y₀))))
    · rintro X ⟨hX, hXc, hXV, hXn⟩
      obtain ⟨h1, h2, h3⟩ := fwd (fun v => (Real.sqrt c)⁻¹ • L.symm v)
        (L.symm.contDiff.const_smul _) (by simp) y₀ L X V hX hXc hXV
      refine ⟨⟨h1, h2, h3, ?_⟩, ?_⟩
      · intro z
        rw [s2 z]
        have hLT : L ((Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z))) =
            (Real.sqrt c)⁻¹ • X (y₀ + L z) := by simp
        rw [hLT]
        have hcs : c * ((Real.sqrt c)⁻¹ * (Real.sqrt c)⁻¹) = 1 := by
          rw [← mul_inv, hss, mul_inv_cancel₀ hc.ne']
        have key : c * ∑ k : Fin 3, ∑ l : Fin 3, G (y₀ + L z) k l *
            ((Real.sqrt c)⁻¹ • X (y₀ + L z)) k * ((Real.sqrt c)⁻¹ • X (y₀ + L z)) l =
            (c * ((Real.sqrt c)⁻¹ * (Real.sqrt c)⁻¹)) * ∑ k : Fin 3, ∑ l : Fin 3,
              G (y₀ + L z) k l * X (y₀ + L z) k * X (y₀ + L z) l := by
          simp only [PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
          ring
        rw [key, hcs, one_mul]
        exact hXn _
      · have hYd : ∀ y, DifferentiableAt ℝ (fun y => Real.sqrt (G y).det • X y) y :=
          fun y => (s5 X hX (hXV.trans hVU)).differentiable (by simp) y
        have hpt : ∀ z, sepDensDiv (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
            (fun z => (Real.sqrt c)⁻¹ • L.symm (X (y₀ + L z))) z =
            c * (|(L : E3 →L[ℝ] E3).det| * sepDensDiv G X (y₀ + L z)) := by
          intro z
          rw [s3 X z (hYd _)]
          ring
        simp_rw [hpt]
        rw [integral_const_mul, s4 F' hF' (sepDensDiv G X)]
    · rintro X' ⟨hX', hX'c, hX'V, hX'n⟩
      have hTS : (fun z => (Real.sqrt c)⁻¹ • L.symm
          ((fun y => Real.sqrt c • L (X' (L.symm (y - y₀)))) (y₀ + L z))) = X' := by
        funext z
        simp [smul_smul, inv_mul_cancel₀ hs.ne']
      have hSeq : (fun y => Real.sqrt c • L (X' (L.symm (y - y₀)))) =
          fun y => (fun v => Real.sqrt c • L v) (X' (-(L.symm y₀) + L.symm y)) := by
        funext y
        simp only [map_sub, neg_add_eq_sub]
      obtain ⟨h1, h2, h3⟩ := fwd (fun v => Real.sqrt c • L v)
        (L.contDiff.const_smul _) (by simp) (-(L.symm y₀)) L.symm X'
        ((fun w => y₀ + L w) ⁻¹' V) hX' hX'c hX'V
      refine ⟨⟨?_, ?_, ?_, ?_⟩, hTS⟩
      · rw [hSeq]; exact h1
      · rw [hSeq]; exact h2
      · rw [hSeq]
        intro y hy
        have := h3 hy
        simpa using this
      · intro y
        have hy : y₀ + L (L.symm (y - y₀)) = y := by simp
        have h := hX'n (L.symm (y - y₀))
        rw [s2, hy] at h
        have key : ∑ i : Fin 3, ∑ j : Fin 3, G y i j *
            (Real.sqrt c • L (X' (L.symm (y - y₀)))) i *
            (Real.sqrt c • L (X' (L.symm (y - y₀)))) j =
            (Real.sqrt c * Real.sqrt c) * ∑ k : Fin 3, ∑ l : Fin 3, G y k l *
              (L (X' (L.symm (y - y₀)))) k * (L (X' (L.symm (y - y₀)))) l := by
          simp only [PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_three]
          ring
        show ∑ i : Fin 3, ∑ j : Fin 3, G y i j *
            (Real.sqrt c • L (X' (L.symm (y - y₀)))) i *
            (Real.sqrt c • L (X' (L.symm (y - y₀)))) j ≤ 1
        rw [key, hss]
        exact h
  
  have s8 : sepIsPerMin G F U → sepIsPerMin (fun z => c • pullbackMetric G (fun w => y₀ + L w) z)
      ((fun w => y₀ + L w) ⁻¹' F) ((fun w => y₀ + L w) ⁻¹' U) := by
    rintro ⟨hFm, hfin, hloc⟩
    let Φ : E3 ≃ₜ E3 := L.toHomeomorph.trans (Homeomorph.addLeft y₀)
    have hΦs : ∀ y, y₀ + L (Φ.symm y) = y := fun y => Φ.apply_symm_apply y
    have hΦs' : ∀ z, Φ.symm (y₀ + L z) = z := fun z => Φ.symm_apply_apply z
    have hpre : ∀ S : Set E3, (fun w => y₀ + L w) ⁻¹' (Φ.symm ⁻¹' S) = S := by
      intro S; ext z
      simp only [Set.mem_preimage, hΦs']
    have key : ∀ V' : Set E3, IsOpen V' → IsCompact (closure V') →
        closure V' ⊆ (fun w => y₀ + L w) ⁻¹' U →
        IsOpen (Φ.symm ⁻¹' V') ∧ IsCompact (closure (Φ.symm ⁻¹' V')) ∧
          closure (Φ.symm ⁻¹' V') ⊆ U := by
      intro V' hV' hcpt hsub
      have hcl : closure (Φ.symm ⁻¹' V') = Φ.symm ⁻¹' closure V' :=
        (Φ.symm.preimage_closure V').symm
      refine ⟨hV'.preimage Φ.symm.continuous, ?_, ?_⟩
      · rw [hcl]; exact Φ.symm.isCompact_preimage.mpr hcpt
      · rw [hcl]
        intro y hy
        have := hsub hy
        simp only [Set.mem_preimage, hΦs] at this
        exact this
    refine ⟨hFm.preimage hφc.measurable, ?_, ?_⟩
    · intro V' hV' hcpt hsub
      obtain ⟨hVo, hVc, hVU⟩ := key V' hV' hcpt hsub
      rw [← hpre V', P1 F hFm _ (subset_closure.trans hVU)]
      exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hfin _ hVo hVc hVU)
    · intro F'' V' K' hF'' hV' hcpt hsub hK' hKV hsd
      obtain ⟨hVo, hVc, hVU⟩ := key V' hV' hcpt hsub
      have hF'm : MeasurableSet (Φ.symm ⁻¹' F'') :=
        hF''.preimage Φ.symm.continuous.measurable
      have hFF : Φ.symm ⁻¹' ((fun w => y₀ + L w) ⁻¹' F) = F := by
        ext y
        simp only [Set.mem_preimage, hΦs]
      have hsd' : symmDiff F (Φ.symm ⁻¹' F'') ⊆ Φ.symm ⁻¹' K' := by
        rw [← hFF, ← Set.preimage_symmDiff]
        exact Set.preimage_mono hsd
      have hle := hloc (Φ.symm ⁻¹' F'') _ (Φ.symm ⁻¹' K') hF'm hVo hVc hVU
        (Φ.symm.isCompact_preimage.mpr hK') (Set.preimage_mono hKV) hsd'
      have e1 := P1 F hFm _ (subset_closure.trans hVU)
      have e2 := P1 _ hF'm _ (subset_closure.trans hVU)
      rw [hpre V'] at e1 e2
      rw [hpre F''] at e2
      rw [e1, e2]
      exact mul_le_mul_left' hle _
  exact ⟨fun V hV => P1 F hF V hV, s1.1, s1.2.1, s1.2.2, s8⟩

theorem sepPerG_one_compare (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) (hclose : ∀ y ∈ U, ∀ i j : Fin 3, |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) (S V : Set E3) (hV : V ⊆ U) : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤ 2 * sepPerG G S V ∧ sepPerG G S V ≤ 2 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V :=
by
  classical
  
  have htrip : ∀ a b c A B C : ℝ, |a| ≤ A → |b| ≤ B → |c| ≤ C → |a * b * c| ≤ A * B * C := by
    intro a b c A B C ha hb hc
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul ha hb (abs_nonneg _) ((abs_nonneg _).trans ha)) hc
      (abs_nonneg _) (mul_nonneg ((abs_nonneg _).trans ha) ((abs_nonneg _).trans hb))
  
  have hdetB : ∀ M : Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, |M i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) →
      9 / 10 ≤ M.det ∧ M.det ≤ 11 / 10 := by
    intro M hM
    have d0 : |M 0 0 - 1| ≤ 1 / 100 := by simpa using hM 0 0
    have d1 : |M 1 1 - 1| ≤ 1 / 100 := by simpa using hM 1 1
    have d2 : |M 2 2 - 1| ≤ 1 / 100 := by simpa using hM 2 2
    have o01 : |M 0 1| ≤ 1 / 100 := by simpa using hM 0 1
    have o02 : |M 0 2| ≤ 1 / 100 := by simpa using hM 0 2
    have o10 : |M 1 0| ≤ 1 / 100 := by simpa using hM 1 0
    have o12 : |M 1 2| ≤ 1 / 100 := by simpa using hM 1 2
    have o20 : |M 2 0| ≤ 1 / 100 := by simpa using hM 2 0
    have o21 : |M 2 1| ≤ 1 / 100 := by simpa using hM 2 1
    obtain ⟨d0l, d0u⟩ := abs_le.mp d0
    obtain ⟨d1l, d1u⟩ := abs_le.mp d1
    obtain ⟨d2l, d2u⟩ := abs_le.mp d2
    have a0 : |M 0 0| ≤ 101 / 100 := abs_le.mpr ⟨by linarith, by linarith⟩
    have a1 : |M 1 1| ≤ 101 / 100 := abs_le.mpr ⟨by linarith, by linarith⟩
    have a2 : |M 2 2| ≤ 101 / 100 := abs_le.mpr ⟨by linarith, by linarith⟩
    have p1 : (99 / 100 : ℝ) * (99 / 100) ≤ M 0 0 * M 1 1 :=
      mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    have p2 : (99 / 100 : ℝ) * (99 / 100) * (99 / 100) ≤ M 0 0 * M 1 1 * M 2 2 :=
      mul_le_mul p1 (by linarith) (by norm_num) (by linarith)
    have pu := abs_le.mp (htrip _ _ _ _ _ _ a0 a1 a2)
    have t1 := abs_le.mp (htrip _ _ _ _ _ _ a0 o12 o21)
    have t2 := abs_le.mp (htrip _ _ _ _ _ _ o01 o10 a2)
    have t3 := abs_le.mp (htrip _ _ _ _ _ _ o01 o12 o20)
    have t4 := abs_le.mp (htrip _ _ _ _ _ _ o02 o10 o21)
    have t5 := abs_le.mp (htrip _ _ _ _ _ _ o02 a1 o20)
    rw [Matrix.det_fin_three]
    constructor
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
    · linarith [pu.1, pu.2, t1.1, t1.2, t2.1, t2.2, t3.1, t3.2, t4.1, t4.2, t5.1, t5.2]
  
  have hpair : ∀ a x y : ℝ, |a| ≤ 1 / 100 → |a * x * y| ≤ 1 / 100 * ((x ^ 2 + y ^ 2) / 2) := by
    intro a x y ha
    rw [abs_mul, abs_mul, mul_assoc]
    have h1 : |x| * |y| ≤ (x ^ 2 + y ^ 2) / 2 := by
      nlinarith [sq_nonneg (|x| - |y|), sq_abs x, sq_abs y]
    exact mul_le_mul ha h1 (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by norm_num)
  have hquad : ∀ M : Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, |M i j - (if i = j then (1 : ℝ) else 0)| ≤ 1 / 100) → ∀ v : Fin 3 → ℝ,
      97 / 100 * ∑ i : Fin 3, v i ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, M i j * v i * v j ∧
      ∑ i : Fin 3, ∑ j : Fin 3, M i j * v i * v j ≤ 103 / 100 * ∑ i : Fin 3, v i ^ 2 := by
    intro M hM v
    have d0 : |M 0 0 - 1| ≤ 1 / 100 := by simpa using hM 0 0
    have d1 : |M 1 1 - 1| ≤ 1 / 100 := by simpa using hM 1 1
    have d2 : |M 2 2 - 1| ≤ 1 / 100 := by simpa using hM 2 2
    have o01 : |M 0 1| ≤ 1 / 100 := by simpa using hM 0 1
    have o02 : |M 0 2| ≤ 1 / 100 := by simpa using hM 0 2
    have o10 : |M 1 0| ≤ 1 / 100 := by simpa using hM 1 0
    have o12 : |M 1 2| ≤ 1 / 100 := by simpa using hM 1 2
    have o20 : |M 2 0| ≤ 1 / 100 := by simpa using hM 2 0
    have o21 : |M 2 1| ≤ 1 / 100 := by simpa using hM 2 1
    have q00 := abs_le.mp (hpair _ (v 0) (v 0) d0)
    have q11 := abs_le.mp (hpair _ (v 1) (v 1) d1)
    have q22 := abs_le.mp (hpair _ (v 2) (v 2) d2)
    have q01 := abs_le.mp (hpair _ (v 0) (v 1) o01)
    have q02 := abs_le.mp (hpair _ (v 0) (v 2) o02)
    have q10 := abs_le.mp (hpair _ (v 1) (v 0) o10)
    have q12 := abs_le.mp (hpair _ (v 1) (v 2) o12)
    have q20 := abs_le.mp (hpair _ (v 2) (v 0) o20)
    have q21 := abs_le.mp (hpair _ (v 2) (v 1) o21)
    simp only [Fin.sum_univ_three]
    constructor
    · linarith [q00.1, q11.1, q22.1, q01.1, q02.1, q10.1, q12.1, q20.1, q21.1]
    · linarith [q00.2, q11.2, q22.2, q01.2, q02.2, q10.2, q12.2, q20.2, q21.2]
  
  have hsmul : ∀ (h : E3 → ℝ), ContDiffOn ℝ ∞ h U → ∀ X : E3 → E3, ContDiff ℝ ∞ X →
      tsupport X ⊆ U → ContDiff ℝ ∞ (fun z => h z • X z) := by
    intro h hh X hX hXU
    rw [contDiff_iff_contDiffAt]
    intro z
    by_cases hz : z ∈ U
    · exact (hh.contDiffAt (hU.mem_nhds hz)).smul hX.contDiffAt
    · have hz' : z ∉ tsupport X := fun h' => hz (hXU h')
      have hev : X =ᶠ[𝓝 z] 0 := (notMem_tsupport_iff_eventuallyEq).mp hz'
      have hev' : (fun w => h w • X w) =ᶠ[𝓝 z] (fun _ => (0 : E3)) := by
        filter_upwards [hev] with w hw
        rw [hw, Pi.zero_apply, smul_zero]
      exact contDiffAt_const.congr_of_eventuallyEq hev'
  
  have hdetC : ContDiffOn ℝ ∞ (fun y => (G y).det) U := by
    have hfun : (fun y => (G y).det) = fun y => G y 0 0 * G y 1 1 * G y 2 2
        - G y 0 0 * G y 1 2 * G y 2 1 - G y 0 1 * G y 1 0 * G y 2 2
        + G y 0 1 * G y 1 2 * G y 2 0 + G y 0 2 * G y 1 0 * G y 2 1
        - G y 0 2 * G y 1 1 * G y 2 0 := by
      funext y
      exact Matrix.det_fin_three _
    rw [hfun]
    have e1 := ((hG 0 0).mul (hG 1 1)).mul (hG 2 2)
    have e2 := ((hG 0 0).mul (hG 1 2)).mul (hG 2 1)
    have e3 := ((hG 0 1).mul (hG 1 0)).mul (hG 2 2)
    have e4 := ((hG 0 1).mul (hG 1 2)).mul (hG 2 0)
    have e5 := ((hG 0 2).mul (hG 1 0)).mul (hG 2 1)
    have e6 := ((hG 0 2).mul (hG 1 1)).mul (hG 2 0)
    exact ((((e1.sub e2).sub e3).add e4).add e5).sub e6
  have hpos : ∀ y ∈ U, 0 < (G y).det := fun y hy => by
    linarith [(hdetB _ (hclose y hy)).1]
  have hsqrtC : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U :=
    hdetC.sqrt (fun y hy => (hpos y hy).ne')
  have hinvC : ContDiffOn ℝ ∞ (fun y => (Real.sqrt (G y).det)⁻¹) U :=
    hsqrtC.inv (fun y hy => (Real.sqrt_pos.2 (hpos y hy)).ne')
  
  have hsq1 : ∀ y v : E3, ∑ i : Fin 3, ∑ j : Fin 3,
      (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j * v i * v j = ∑ i : Fin 3, v i ^ 2 := by
    intro y v
    simp [Fin.sum_univ_three, Matrix.one_apply]
    ring
  
  have hK : ∀ G1 G2 : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ X : E3 → E3, (ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧ tsupport X ⊆ V ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G1 y i j * X y i * X y j ≤ 1) →
        ∃ Y : E3 → E3, (ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧ tsupport Y ⊆ V ∧
          ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, G2 y i j * Y y i * Y y j ≤ 1) ∧
          ∀ y, sepDensDiv G2 Y y = 1 / 2 * sepDensDiv G1 X y) →
      sepPerG G1 S V ≤ 2 * sepPerG G2 S V := by
    intro G1 G2 hT
    unfold sepPerG
    refine iSup₂_le fun X hX => ?_
    obtain ⟨Y, hY, hd⟩ := hT X hX
    have hint : ∫ y in S, sepDensDiv G1 X y = 2 * ∫ y in S, sepDensDiv G2 Y y := by
      simp_rw [hd]
      rw [integral_const_mul]
      ring
    rw [hint, ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat]
    refine mul_le_mul_left' ?_ 2
    exact le_iSup_of_le Y (le_iSup_of_le hY le_rfl)
  
  have hD : ∀ (G1 G2 : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X1 X2 : E3 → E3),
      (∀ z (i : Fin 3), Real.sqrt (G2 z).det * X2 z i = 1 / 2 * (Real.sqrt (G1 z).det * X1 z i)) →
      ∀ y, sepDensDiv G2 X2 y = 1 / 2 * sepDensDiv G1 X1 y := by
    intro G1 G2 X1 X2 h y
    unfold sepDensDiv
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hf : (fun z => Real.sqrt (G2 z).det * X2 z i) =
        (1 / 2 : ℝ) • (fun z => Real.sqrt (G1 z).det * X1 z i) := by
      funext z
      rw [Pi.smul_apply, smul_eq_mul, h z i]
    unfold partialDeriv
    rw [hf, fderiv_const_smul_of_field]
    simp only [Pi.smul_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have dir1 : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V ≤ 2 * sepPerG G S V := by
    refine hK (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) G fun X hX => ?_
    obtain ⟨hXs, hXc, hXV, hXb⟩ := hX
    have hX0 : ∀ z, z ∉ U → X z = 0 := fun z hz =>
      image_eq_zero_of_notMem_tsupport (fun h' => hz (hV (hXV h')))
    obtain ⟨a, ha⟩ : ∃ a : E3 → ℝ, a = fun z => 1 / 2 * (Real.sqrt (G z).det)⁻¹ := ⟨_, rfl⟩
    have haz : ∀ z, a z = 1 / 2 * (Real.sqrt (G z).det)⁻¹ := fun z => by rw [ha]
    have haC : ContDiffOn ℝ ∞ a U := by
      rw [ha]
      exact contDiffOn_const.mul hinvC
    refine ⟨fun z => a z • X z, ⟨?_, ?_, ?_, ?_⟩, hD _ _ _ _ ?_⟩
    · exact hsmul a haC X hXs (hXV.trans hV)
    · refine hXc.mono ?_
      intro z hz h0
      apply hz
      show a z • X z = 0
      rw [h0, smul_zero]
    · exact (tsupport_smul_subset_right _ _).trans hXV
    · intro y
      show ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a y • X y) i * (a y • X y) j ≤ 1
      have hYi : ∀ i : Fin 3, (a y • X y) i = a y * X y i := fun i => by simp
      simp only [hYi]
      have hexp : ∑ i : Fin 3, ∑ j : Fin 3, G y i j * (a y * X y i) * (a y * X y j) =
          a y ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
        simp only [Fin.sum_univ_three]
        ring
      rw [hexp]
      by_cases hy : y ∈ U
      · have hX1 : ∑ i : Fin 3, X y i ^ 2 ≤ 1 := by
          have h := hXb y
          rwa [hsq1 y (X y)] at h
        have hQ := hquad (G y) (hclose y hy) (fun i => X y i)
        have hs0 : 0 ≤ ∑ i : Fin 3, X y i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
        have hQ0 : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, G y i j * X y i * X y j := by
          nlinarith [hQ.1]
        have hdy := hdetB (G y) (hclose y hy)
        have hdpos : 0 < (G y).det := hpos y hy
        have hinv : (G y).det⁻¹ ≤ 10 / 9 := by
          rw [inv_le_comm₀ hdpos (by norm_num)]
          calc (10 / 9 : ℝ)⁻¹ = 9 / 10 := by norm_num
            _ ≤ _ := hdy.1
        have ha2 : a y ^ 2 ≤ 5 / 18 := by
          rw [haz y, mul_pow, inv_pow, Real.sq_sqrt hdpos.le]
          nlinarith [hinv]
        nlinarith [mul_nonneg (sub_nonneg.2 ha2) hQ0, hQ.2, hX1]
      · simp [hX0 y hy]
    · intro z i
      show Real.sqrt (G z).det * (a z • X z) i =
        1 / 2 * (Real.sqrt ((1 : Matrix (Fin 3) (Fin 3) ℝ)).det * X z i)
      by_cases hz : z ∈ U
      · have hr : Real.sqrt (G z).det ≠ 0 := (Real.sqrt_pos.2 (hpos z hz)).ne'
        simp only [PiLp.smul_apply, smul_eq_mul, Matrix.det_one, Real.sqrt_one, haz z]
        rw [show Real.sqrt (G z).det * (1 / 2 * (Real.sqrt (G z).det)⁻¹ * X z i) =
          1 / 2 * (Real.sqrt (G z).det * (Real.sqrt (G z).det)⁻¹) * X z i by ring,
          mul_inv_cancel₀ hr]
        ring
      · simp [hX0 z hz]
  
  have dir2 : sepPerG G S V ≤ 2 * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V := by
    refine hK G (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) fun Y hY => ?_
    obtain ⟨hYs, hYc, hYV, hYb⟩ := hY
    have hY0 : ∀ z, z ∉ U → Y z = 0 := fun z hz =>
      image_eq_zero_of_notMem_tsupport (fun h' => hz (hV (hYV h')))
    obtain ⟨b, hb⟩ : ∃ b : E3 → ℝ, b = fun z => 1 / 2 * Real.sqrt (G z).det := ⟨_, rfl⟩
    have hbz : ∀ z, b z = 1 / 2 * Real.sqrt (G z).det := fun z => by rw [hb]
    have hbC : ContDiffOn ℝ ∞ b U := by
      rw [hb]
      exact contDiffOn_const.mul hsqrtC
    refine ⟨fun z => b z • Y z, ⟨?_, ?_, ?_, ?_⟩, hD _ _ _ _ ?_⟩
    · exact hsmul b hbC Y hYs (hYV.trans hV)
    · refine hYc.mono ?_
      intro z hz h0
      apply hz
      show b z • Y z = 0
      rw [h0, smul_zero]
    · exact (tsupport_smul_subset_right _ _).trans hYV
    · intro y
      show ∑ i : Fin 3, ∑ j : Fin 3, (fun _ : E3 => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j *
        (b y • Y y) i * (b y • Y y) j ≤ 1
      rw [hsq1 y (b y • Y y)]
      have hYi : ∀ i : Fin 3, (b y • Y y) i = b y * Y y i := fun i => by simp
      simp only [hYi]
      have hexp : ∑ i : Fin 3, (b y * Y y i) ^ 2 = b y ^ 2 * ∑ i : Fin 3, Y y i ^ 2 := by
        simp only [Fin.sum_univ_three]
        ring
      rw [hexp]
      by_cases hy : y ∈ U
      · have hQ := hquad (G y) (hclose y hy) (fun i => Y y i)
        have hs0 : 0 ≤ ∑ i : Fin 3, Y y i ^ 2 := Finset.sum_nonneg (fun i _ => sq_nonneg _)
        have hdy := hdetB (G y) (hclose y hy)
        have hdpos : 0 < (G y).det := hpos y hy
        have hb2 : b y ^ 2 ≤ 11 / 40 := by
          rw [hbz y, mul_pow, Real.sq_sqrt hdpos.le]
          nlinarith [hdy.2]
        nlinarith [mul_nonneg (sub_nonneg.2 hb2) hs0, hQ.1, hYb y]
      · simp [hY0 y hy]
    · intro z i
      show Real.sqrt ((1 : Matrix (Fin 3) (Fin 3) ℝ)).det * (b z • Y z) i =
        1 / 2 * (Real.sqrt (G z).det * Y z i)
      simp only [PiLp.smul_apply, smul_eq_mul, Matrix.det_one, Real.sqrt_one, hbz z]
      ring
  exact ⟨dir1, dir2⟩

theorem sepPerG_one_compl (S V : Set E3) (hS : MeasurableSet S) : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Sᶜ V = sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S V :=
by
  
  have hD : ∀ (X : E3 → E3) (y : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y
        = ∑ i : Fin 3, fderiv ℝ (fun z => X z i) y (e i) := by
    intro X y
    simp [sepDensDiv, partialDeriv]
  
  have hneg : ∀ (X : E3 → E3) (y : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (-X) y
        = -sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y := by
    intro X y
    rw [hD, hD, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have h1 : (fun z => (-X) z i) = -(fun z => X z i) := by
      funext z
      simp
    rw [h1, fderiv_neg, ContinuousLinearMap.neg_apply]
  
  have hint : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X →
      Integrable (sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X) ∧
      ∫ y, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y = 0 := by
    intro X hX hc
    have hpi : ∀ i : Fin 3, Integrable (fun y => fderiv ℝ (fun z => X z i) y (e i)) ∧
        ∫ y, fderiv ℝ (fun z => X z i) y (e i) = 0 := by
      intro i
      have h1 : ContDiff ℝ ∞ (fun z => X z i) :=
        (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hX
      have h2 : HasCompactSupport (fun z => X z i) :=
        hc.comp_left (g := fun v : E3 => v i) (by simp)
      have hdiff : Differentiable ℝ (fun z => X z i) := h1.differentiable (by simp)
      have hcont : Continuous (fun y => fderiv ℝ (fun z => X z i) y (e i)) :=
        (h1.continuous_fderiv (by simp)).clm_apply continuous_const
      have hcs : HasCompactSupport (fun y => fderiv ℝ (fun z => X z i) y (e i)) :=
        h2.fderiv_apply ℝ (e i)
      have hI : Integrable (fun y => fderiv ℝ (fun z => X z i) y (e i)) :=
        hcont.integrable_of_hasCompactSupport hcs
      have hIg : Integrable (fun z => X z i) :=
        h1.continuous.integrable_of_hasCompactSupport h2
      refine ⟨hI, ?_⟩
      have key := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume)
        (f := fun _ : E3 => (1 : ℝ)) (g := fun z => X z i) (v := e i)
        (by simp) (by simpa using hI) (by simpa using hIg) (differentiable_const _) hdiff
      simpa using key
    have hfun : sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X
        = fun y => ∑ i : Fin 3, fderiv ℝ (fun z => X z i) y (e i) := funext (hD X)
    rw [hfun]
    refine ⟨integrable_finset_sum _ (fun i _ => (hpi i).1), ?_⟩
    rw [integral_finset_sum _ (fun i _ => (hpi i).1)]
    exact Finset.sum_eq_zero (fun i _ => (hpi i).2)
  
  have hle : ∀ T : Set E3, MeasurableSet T →
      sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Tᶜ V
        ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) T V := by
    intro T hT
    unfold sepPerG
    refine iSup₂_le (fun X hX => ?_)
    obtain ⟨hXs, hXc, hXV, hXq⟩ := hX
    have hadm : ContDiff ℝ ∞ (-X) ∧ HasCompactSupport (-X) ∧ tsupport (-X) ⊆ V ∧
        ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) y i j * (-X) y i * (-X) y j ≤ 1 := by
      refine ⟨hXs.neg, hXc.neg, (tsupport_neg X).symm ▸ hXV, fun y => ?_⟩
      have hq := hXq y
      simpa [neg_mul, mul_neg, neg_neg] using hq
    obtain ⟨hI, h0⟩ := hint X hXs hXc
    have hsplit := integral_add_compl hT hI
    have hval : ∫ y in Tᶜ, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y
        = ∫ y in T, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (-X) y := by
      simp only [hneg]
      rw [integral_neg]
      linarith
    refine le_iSup₂_of_le (-X) hadm ?_
    rw [hval]
  
  refine le_antisymm (hle S hS) ?_
  have h2 := hle Sᶜ hS.compl
  rwa [compl_compl] at h2

theorem sepIso_grad_dual (v : E3 → ℝ) (p : ℝ) (hv : ContDiff ℝ ∞ v) (hvc : HasCompactSupport v) (hdual : ∀ X : E3 → E3, ContDiff ℝ ∞ X → HasCompactSupport X → (∀ y, ‖X y‖ ≤ 1) → ∫ y, v y * ∑ i : Fin 3, partialDeriv i (fun w => X w i) y ≤ p) : ∫⁻ y, ‖fderiv ℝ v y‖ₑ ≤ ENNReal.ofReal p :=
by
  set D : E3 → (E3 →L[ℝ] ℝ) := fderiv ℝ v with hD
  have hDs : ContDiff ℝ ∞ D := hv.fderiv_right le_rfl
  have hDc : Continuous D := hDs.continuous
  have hDcs : HasCompactSupport D := hvc.fderiv ℝ
  have hD0 : ∀ y, y ∉ tsupport v → D y = 0 := fun y hy =>
    Function.notMem_support.mp (fun h => hy (support_fderiv_subset ℝ h))
  set G : E3 → E3 := fun y => (InnerProductSpace.toDual ℝ E3).symm (D y) with hG
  have hGs : ContDiff ℝ ∞ G := (InnerProductSpace.toDual ℝ E3).symm.contDiff.comp hDs
  have hGn : ∀ y, ‖G y‖ = ‖D y‖ := fun y => (InnerProductSpace.toDual ℝ E3).symm.norm_map _
  have hGi : ∀ y (i : Fin 3), partialDeriv i v y = G y i := by
    intro y i
    show D y (e i) = G y i
    have h := InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (E := E3) (x := e i) (y := D y)
    rw [← h, EuclideanSpace.inner_single_right]
    simp [hG]
  have hDsq : (fun y => ‖D y‖ ^ 2) = fun y => ‖G y‖ ^ 2 := by
    funext y; rw [hGn]
  
  have hkey : ∀ ε : ℝ, 0 < ε → ∫ y, ‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2) ≤ p := by
    intro ε hε
    set s : E3 → ℝ := fun y => Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2) with hs
    have hspos : ∀ y, 0 < s y := fun y => Real.sqrt_pos.2 (by positivity)
    have hss : ContDiff ℝ ∞ s := by
      have h1 : ContDiff ℝ ∞ (fun y => ‖D y‖ ^ 2) := by rw [hDsq]; exact hGs.norm_sq ℝ
      exact (contDiff_const.add h1).sqrt
        (fun y => (by positivity : (0 : ℝ) < ε ^ 2 + ‖D y‖ ^ 2).ne')
    set X : E3 → E3 := fun y => -((s y)⁻¹ • G y) with hX
    have hXs : ContDiff ℝ ∞ X := ((hss.inv fun y => (hspos y).ne').smul hGs).neg
    have hXcs : HasCompactSupport X := by
      refine hDcs.mono' ?_
      intro y hy
      apply subset_tsupport
      intro h0
      apply hy
      have h0' : D y = 0 := h0
      have : G y = 0 := by simp [hG, h0']
      simp [hX, this]
    have hX1 : ∀ y, ‖X y‖ ≤ 1 := by
      intro y
      rw [hX]
      simp only
      rw [norm_neg, norm_smul, norm_inv, Real.norm_of_nonneg (hspos y).le,
        inv_mul_le_iff₀ (hspos y), mul_one, hGn]
      calc ‖D y‖ = Real.sqrt (‖D y‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
        _ ≤ s y := Real.sqrt_le_sqrt (by nlinarith)
    have hXi : ∀ y (i : Fin 3), X y i = -((s y)⁻¹ * G y i) := by
      intro y i; simp [hX]
    have hdualX := hdual X hXs hXcs hX1
    have hXis : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w => X w i) := fun i =>
      (EuclideanSpace.proj (ι := Fin 3) (𝕜 := ℝ) i).contDiff.comp hXs
    have hint1 : ∀ i : Fin 3, Integrable (fun y => partialDeriv i v y * X y i) := by
      intro i
      unfold partialDeriv
      exact ((hDc.clm_apply continuous_const).mul (hXis i).continuous).integrable_of_hasCompactSupport
        ((hvc.fderiv_apply ℝ (e i)).mul_right)
    have hint2 : ∀ i : Fin 3, Integrable (fun y => v y * partialDeriv i (fun w => X w i) y) := by
      intro i
      unfold partialDeriv
      exact (hv.continuous.mul (((hXis i).continuous_fderiv (by simp)).clm_apply
        continuous_const)).integrable_of_hasCompactSupport hvc.mul_right
    have hint3 : ∀ i : Fin 3, Integrable (fun y => v y * X y i) := fun i =>
      (hv.continuous.mul (hXis i).continuous).integrable_of_hasCompactSupport hvc.mul_right
    have hibp : ∀ i : Fin 3, ∫ y, v y * partialDeriv i (fun w => X w i) y =
        -∫ y, partialDeriv i v y * X y i := by
      intro i
      have h := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable (μ := volume) (v := e i)
        (hint1 i) (hint2 i) (hint3 i) (hv.differentiable (by simp)) ((hXis i).differentiable (by simp))
      exact h
    have hsum : ∫ y, v y * ∑ i : Fin 3, partialDeriv i (fun w => X w i) y =
        -∫ y, ∑ i : Fin 3, partialDeriv i v y * X y i := by
      simp_rw [Finset.mul_sum]
      rw [integral_finset_sum _ (fun i _ => hint2 i), integral_finset_sum _ (fun i _ => hint1 i),
        ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun i _ => hibp i)
    have hpt : ∀ y, ∑ i : Fin 3, partialDeriv i v y * X y i = -(‖D y‖ ^ 2 / s y) := by
      intro y
      simp only [hGi, hXi]
      rw [← hGn, EuclideanSpace.norm_sq_eq]
      simp only [Real.norm_eq_abs, sq_abs]
      rw [div_eq_inv_mul, Finset.mul_sum, ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    have heq : ∫ y, ‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2) =
        ∫ y, v y * ∑ i : Fin 3, partialDeriv i (fun w => X w i) y := by
      rw [hsum, ← integral_neg]
      congr 1
      funext y
      rw [hpt y, neg_neg]
    linarith
  
  have hDint : Integrable D := hDc.integrable_of_hasCompactSupport hDcs
  rw [← ofReal_integral_norm_eq_lintegral_enorm hDint]
  apply ENNReal.ofReal_le_ofReal
  set K := tsupport v with hK
  have hKc : IsCompact K := hvc
  have hKm : MeasurableSet K := (isClosed_tsupport v).measurableSet
  set μK := (volume K).toReal with hμKdef
  have hμK : 0 ≤ μK := ENNReal.toReal_nonneg
  have hbound : ∀ ε : ℝ, 0 < ε → ∫ y, ‖D y‖ ≤ p + ε * μK := by
    intro ε hε
    have hint1 : Integrable (fun y => ‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2)) := by
      refine Continuous.integrable_of_hasCompactSupport ?_ ?_
      · exact (hDc.norm.pow 2).div (continuous_const.add (hDc.norm.pow 2)).sqrt
          (fun y => (Real.sqrt_pos.2 (by positivity)).ne')
      · refine hDcs.mono' ?_
        intro y hy
        apply subset_tsupport
        intro h0
        apply hy
        have h0' : D y = 0 := h0
        simp [h0']
    have hint2 : Integrable (K.indicator fun _ => ε) :=
      (ContinuousOn.integrableOn_compact hKc continuous_const.continuousOn).integrable_indicator hKm
    have hint2i : ∫ y, K.indicator (fun _ => ε) y = ε * μK := by
      rw [integral_indicator hKm, setIntegral_const, smul_eq_mul, mul_comm]
      rfl
    have hpt : ∀ y, ‖D y‖ ≤ ‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2) +
        K.indicator (fun _ => ε) y := by
      intro y
      by_cases hy : y ∈ K
      · rw [Set.indicator_of_mem hy]
        have ha : 0 ≤ ‖D y‖ := norm_nonneg _
        set a := ‖D y‖
        have hS0 : 0 ≤ Real.sqrt (ε ^ 2 + a ^ 2) := Real.sqrt_nonneg _
        have hS2 : Real.sqrt (ε ^ 2 + a ^ 2) ^ 2 = ε ^ 2 + a ^ 2 := Real.sq_sqrt (by positivity)
        have hSpos : 0 < Real.sqrt (ε ^ 2 + a ^ 2) := Real.sqrt_pos.2 (by positivity)
        set S := Real.sqrt (ε ^ 2 + a ^ 2)
        have hSa : a ≤ S := by nlinarith
        have hSe : S - a ≤ ε := by nlinarith [mul_nonneg (sub_nonneg.2 hSa) ha]
        rw [div_add' _ _ _ hSpos.ne', le_div_iff₀ hSpos]
        nlinarith [mul_le_mul_of_nonneg_left hSe ha, mul_le_mul_of_nonneg_right hSa hε.le]
      · have h0 : D y = 0 := hD0 y hy
        rw [Set.indicator_of_notMem hy, h0]
        simp
    calc ∫ y, ‖D y‖ ≤ ∫ y, (‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2) +
          K.indicator (fun _ => ε) y) :=
          integral_mono hDint.norm (hint1.add hint2) hpt
      _ = (∫ y, ‖D y‖ ^ 2 / Real.sqrt (ε ^ 2 + ‖D y‖ ^ 2)) + ε * μK := by
          rw [integral_add hint1 hint2, hint2i]
      _ ≤ p + ε * μK := by linarith [hkey ε hε]
  apply le_of_forall_pos_lt_add
  intro δ hδ
  have hε : 0 < δ / (μK + 1) := by positivity
  have h1 := hbound _ hε
  have h2 : δ / (μK + 1) * μK < δ := by
    rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith
  linarith

theorem sepIso_mollify_field (φ : ContDiffBump (0 : E3)) (X : E3 → E3) (hX : ContDiff ℝ ∞ X) (hXc : HasCompactSupport X) (hX1 : ∀ y, ‖X y‖ ≤ 1) : Continuous (fun y => ∑ i : Fin 3, partialDeriv i (fun w => X w i) y) ∧ HasCompactSupport (fun y => ∑ i : Fin 3, partialDeriv i (fun w => X w i) y) ∧ ∃ Y : E3 → E3, ContDiff ℝ ∞ Y ∧ HasCompactSupport Y ∧ (∀ y, ‖Y y‖ ≤ 1) ∧ ∀ z, ∑ i : Fin 3, partialDeriv i (fun w => Y w i) z = MeasureTheory.convolution (φ.normed volume) (fun y => ∑ i : Fin 3, partialDeriv i (fun w => X w i) y) (ContinuousLinearMap.lsmul ℝ ℝ) volume z :=
by
  have hψ : Continuous (φ.normed volume) := φ.continuous_normed
  have hψc : HasCompactSupport (φ.normed volume) := φ.hasCompactSupport_normed
  have hψl : LocallyIntegrable (φ.normed volume) volume := hψ.locallyIntegrable
  have hXl : LocallyIntegrable X volume := hX.continuous.locallyIntegrable
  have hcoord : ∀ i : Fin 3, ContDiff ℝ ∞ (fun w => X w i) ∧
      HasCompactSupport (fun w => X w i) := by
    intro i
    refine ⟨(contDiff_piLp_apply (p := 2)).comp hX, ?_⟩
    exact hXc.comp_left (g := fun v : E3 => v i) (by simp)
  have hpart : ∀ (f : E3 → ℝ), ContDiff ℝ ∞ f → HasCompactSupport f → ∀ i : Fin 3,
      Continuous (fun y => partialDeriv i f y) ∧
        HasCompactSupport (fun y => partialDeriv i f y) := by
    intro f hf hfc i
    unfold partialDeriv
    exact ⟨(hf.continuous_fderiv (by simp)).clm_apply continuous_const, hfc.fderiv_apply ℝ (e i)⟩
  have hD : ∀ i : Fin 3, Continuous (fun y => partialDeriv i (fun w => X w i) y) ∧
      HasCompactSupport (fun y => partialDeriv i (fun w => X w i) y) :=
    fun i => hpart _ (hcoord i).1 (hcoord i).2 i
  refine ⟨continuous_finset_sum _ (fun i _ => (hD i).1), ?_, ?_⟩
  · simp only [Fin.sum_univ_three]
    exact ((hD 0).2.add (hD 1).2).add (hD 2).2
  · let L : ℝ →L[ℝ] E3 →L[ℝ] E3 := ContinuousLinearMap.lsmul ℝ ℝ
    refine ⟨convolution (φ.normed volume) X L volume, ?_, ?_, ?_, ?_⟩
    · exact hψc.contDiff_convolution_left L (n := ⊤) φ.contDiff_normed hXl
    · exact hψc.convolution L hXc
    · intro z
      rw [convolution_def]
      calc ‖∫ t, L (φ.normed volume t) (X (z - t))‖ ≤ ∫ t, φ.normed volume t := by
            refine norm_integral_le_of_norm_le φ.integrable_normed
              (Filter.Eventually.of_forall fun t => ?_)
            simp only [L, ContinuousLinearMap.lsmul_apply, norm_smul,
              Real.norm_of_nonneg (φ.nonneg_normed t)]
            exact mul_le_of_le_one_right (φ.nonneg_normed t) (hX1 _)
        _ = 1 := φ.integral_normed
    · intro z
      have hcc : ∀ i : Fin 3, (fun w => convolution (φ.normed volume) X L volume w i) =
          convolution (φ.normed volume) (fun w => X w i) (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
        intro i
        funext w
        rw [convolution_def, convolution_def]
        have hint : Integrable (fun t => L (φ.normed volume t) (X (w - t))) volume :=
          (hψc.convolutionExists_left L hψ hXl w).integrable
        let P : E3 →L[ℝ] ℝ := EuclideanSpace.proj i
        have h2 := P.integral_comp_comm hint
        show P (∫ t, L (φ.normed volume t) (X (w - t))) = _
        rw [← h2]
        congr 1
      have hcp : ∀ i : Fin 3, partialDeriv i
          (convolution (φ.normed volume) (fun w => X w i) (ContinuousLinearMap.lsmul ℝ ℝ) volume) z =
          convolution (φ.normed volume) (fun y => partialDeriv i (fun w => X w i) y)
            (ContinuousLinearMap.lsmul ℝ ℝ) volume z := by
        intro i
        unfold partialDeriv
        have hf1 : ContDiff ℝ 1 (fun w => X w i) := (hcoord i).1.of_le (by exact_mod_cast le_top)
        rw [((hcoord i).2.hasFDerivAt_convolution_right (ContinuousLinearMap.lsmul ℝ ℝ) hψl hf1
          z).fderiv]
        exact convolution_precompR_apply _ hψl ((hcoord i).2.fderiv ℝ)
          ((hcoord i).1.continuous_fderiv (by simp)) z (e i)
      have hsum : convolution (φ.normed volume)
          (fun y => ∑ i : Fin 3, partialDeriv i (fun w => X w i) y)
          (ContinuousLinearMap.lsmul ℝ ℝ) volume z =
          ∑ i : Fin 3, convolution (φ.normed volume) (fun y => partialDeriv i (fun w => X w i) y)
            (ContinuousLinearMap.lsmul ℝ ℝ) volume z := by
        simp only [convolution_def, ContinuousLinearMap.lsmul_apply, smul_eq_mul, Finset.mul_sum]
        rw [integral_finset_sum]
        intro i _
        simpa using (hψc.convolutionExists_left (ContinuousLinearMap.lsmul ℝ ℝ) hψ
          (hD i).1.locallyIntegrable z).integrable
      rw [hsum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hcc i, hcp i]

theorem sepIso_conv_adjoint (φ : ContDiffBump (0 : E3)) (S : Set E3) (D : E3 → ℝ) (hS : MeasurableSet S) (hD : Continuous D) (hDc : HasCompactSupport D) : ∫ z in S, MeasureTheory.convolution (φ.normed volume) D (ContinuousLinearMap.lsmul ℝ ℝ) volume z = ∫ y, MeasureTheory.convolution (φ.normed volume) (S.indicator fun _ => (1 : ℝ)) (ContinuousLinearMap.lsmul ℝ ℝ) volume y * D y :=
by
  have hDi : Integrable D volume := hD.integrable_of_hasCompactSupport hDc
  have hρi : Integrable (φ.normed volume) volume := φ.integrable_normed
  have hH := hDi.convolution_integrand (ContinuousLinearMap.lsmul ℝ ℝ) hρi
  have hF : Integrable (Function.uncurry fun z y =>
      S.indicator (fun _ => (1 : ℝ)) z * (φ.normed volume (z - y) * D y))
      (volume.prod volume) := by
    refine (hH.indicator (hS.prod MeasurableSet.univ)).congr (Filter.Eventually.of_forall ?_)
    rintro ⟨z, y⟩
    by_cases hz : z ∈ S
    · have hp : (z, y) ∈ S ×ˢ (Set.univ : Set E3) := ⟨hz, Set.mem_univ _⟩
      simp only [Set.indicator_of_mem hp, Set.indicator_of_mem hz, Function.uncurry_apply_pair,
        ContinuousLinearMap.lsmul_apply, smul_eq_mul]
      ring
    · have hp : (z, y) ∉ S ×ˢ (Set.univ : Set E3) := fun h => hz h.1
      simp only [Set.indicator_of_notMem hp, Set.indicator_of_notMem hz,
        Function.uncurry_apply_pair, zero_mul]
  have h3 : ∫ z in S, MeasureTheory.convolution (φ.normed volume) D
      (ContinuousLinearMap.lsmul ℝ ℝ) volume z =
      ∫ z, ∫ y, S.indicator (fun _ => (1 : ℝ)) z * (φ.normed volume (z - y) * D y) := by
    rw [← integral_indicator hS]
    congr 1
    funext z
    rw [integral_const_mul]
    by_cases hz : z ∈ S
    · rw [Set.indicator_of_mem hz, Set.indicator_of_mem hz, one_mul,
        MeasureTheory.convolution_eq_swap]
      simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    · rw [Set.indicator_of_notMem hz, Set.indicator_of_notMem hz, zero_mul]
  have h4 : ∫ y, MeasureTheory.convolution (φ.normed volume) (S.indicator fun _ => (1 : ℝ))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume y * D y =
      ∫ y, ∫ z, S.indicator (fun _ => (1 : ℝ)) z * (φ.normed volume (z - y) * D y) := by
    congr 1
    funext y
    rw [MeasureTheory.convolution_eq_swap, ← integral_mul_const]
    congr 1
    funext z
    simp only [ContinuousLinearMap.lsmul_apply, smul_eq_mul]
    rw [show y - z = -(z - y) by abel, φ.normed_neg]
    ring
  rw [h3, h4]
  exact integral_integral_swap hF

theorem sepPerE_isoperimetric : ∃ C : ℝ, 0 < C ∧ ∀ S : Set E3, MeasurableSet S → Bornology.IsBounded S → volume S ^ ((2 : ℝ) / 3) ≤ ENNReal.ofReal C * sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S Set.univ :=
by
  
  have hs6 : ∀ (S : Set E3) (Y : E3 → E3), ContDiff ℝ ∞ Y → HasCompactSupport Y →
      (∀ y, ‖Y y‖ ≤ 1) →
      ENNReal.ofReal (∫ y in S, ∑ i : Fin 3, partialDeriv i (fun w => Y w i) y) ≤
        sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S Set.univ := by
    intro S Y hY hYc hY1
    have hq : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
        (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * Y y i * Y y j ≤ 1 := by
      intro y
      have h1 : ∑ i : Fin 3, ∑ j : Fin 3,
          (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * Y y i * Y y j = ‖Y y‖ ^ 2 := by
        rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity))]
        simp [Matrix.one_apply, Real.norm_eq_abs, sq]
      rw [h1]
      exact pow_le_one₀ (norm_nonneg _) (hY1 y)
    have heq : (fun y => sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y y) =
        fun y => ∑ i : Fin 3, partialDeriv i (fun w => Y w i) y := by
      funext y
      simp [sepDensDiv]
    have hle := le_iSup₂ (f := fun (X : E3 → E3) (_ : ContDiff ℝ ∞ X ∧ HasCompactSupport X ∧
        tsupport X ⊆ Set.univ ∧ ∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * X y i * X y j ≤ 1) =>
        ENNReal.ofReal (∫ y in S, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y))
      Y ⟨hY, hYc, Set.subset_univ _, hq⟩
    simp only [heq] at hle
    exact hle
  
  have hs4 : ∀ S : Set E3, MeasurableSet S → Bornology.IsBounded S →
      (∀ φ : ContDiffBump (0 : E3),
        ContDiff ℝ ∞ (convolution (φ.normed volume) (S.indicator fun _ => (1 : ℝ))
          (ContinuousLinearMap.lsmul ℝ ℝ) volume) ∧
        HasCompactSupport (convolution (φ.normed volume) (S.indicator fun _ => (1 : ℝ))
          (ContinuousLinearMap.lsmul ℝ ℝ) volume)) ∧
      ∃ φ : ℕ → ContDiffBump (0 : E3), ∀ᵐ y ∂volume,
        Tendsto (fun k => convolution ((φ k).normed volume) (S.indicator fun _ => (1 : ℝ))
          (ContinuousLinearMap.lsmul ℝ ℝ) volume y) atTop
          (𝓝 (S.indicator (fun _ => (1 : ℝ)) y)) := by
    intro S hS hSb
    have hloc : LocallyIntegrable (S.indicator fun _ => (1 : ℝ)) volume :=
      (locallyIntegrable_const 1).indicator hS
    have hcs : HasCompactSupport (S.indicator fun _ => (1 : ℝ)) :=
      HasCompactSupport.intro hSb.isCompact_closure
        (fun x hx => Set.indicator_of_notMem (fun h => hx (subset_closure h)) _)
    refine ⟨fun φ => ⟨?_, ?_⟩, ?_⟩
    · exact φ.hasCompactSupport_normed.contDiff_convolution_left
        (ContinuousLinearMap.lsmul ℝ ℝ) (n := ⊤) φ.contDiff_normed hloc
    · exact φ.hasCompactSupport_normed.convolution (ContinuousLinearMap.lsmul ℝ ℝ) hcs
    · let φ : ℕ → ContDiffBump (0 : E3) := fun k =>
        ⟨1 / ((k : ℝ) + 1), 2 / ((k : ℝ) + 1), by positivity,
          div_lt_div_of_pos_right (by norm_num) (by positivity)⟩
      refine ⟨φ, ?_⟩
      have hrOut : Tendsto (fun k => (φ k).rOut) atTop (𝓝 0) := by
        have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).const_mul 2
        rw [mul_zero] at h1
        refine h1.congr (fun k => ?_)
        show 2 * (1 / ((k : ℝ) + 1)) = 2 / ((k : ℝ) + 1)
        ring
      exact ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable (K := 2) hrOut
        (Filter.Eventually.of_forall (fun k => by
          show 2 / ((k : ℝ) + 1) ≤ 2 * (1 / ((k : ℝ) + 1))
          rw [mul_one_div])) hloc
  
  obtain ⟨C, hC, hD⟩ : ∃ C : ℝ, 0 < C ∧ ∀ (S : Set E3) (u : ℕ → E3 → ℝ) (P : ENNReal),
      MeasurableSet S → (∀ k, ContDiff ℝ ∞ (u k)) → (∀ k, HasCompactSupport (u k)) →
      (∀ᵐ y ∂volume, Tendsto (fun k => u k y) atTop (𝓝 (S.indicator (fun _ => (1 : ℝ)) y))) →
      (∀ k, ∫⁻ y, ‖fderiv ℝ (u k) y‖ₑ ≤ P) →
      volume S ^ ((2 : ℝ) / 3) ≤ ENNReal.ofReal C * P := by
    set CG : NNReal := lintegralPowLePowLIntegralFDerivConst (volume : Measure E3) (3 / 2 : ℝ)
      with hCG
    refine ⟨(CG : ℝ) ^ ((2 : ℝ) / 3) + 1, by positivity, ?_⟩
    intro S u P hS hu hc hae hgrad
    have hp : ((Module.finrank ℝ E3 : ℕ) : ℝ).HolderConjugate (3 / 2 : ℝ) := by
      rw [finrank_euclideanSpace_fin, Real.holderConjugate_iff]
      norm_num
    have hGNS : ∀ k, ∫⁻ y, ‖u k y‖ₑ ^ (3 / 2 : ℝ) ≤ (CG : ENNReal) * P ^ (3 / 2 : ℝ) := by
      intro k
      refine (lintegral_pow_le_pow_lintegral_fderiv volume ((hu k).of_le (by simp)) (hc k)
        hp).trans ?_
      gcongr
      exact hgrad k
    have hmeas : ∀ k, Measurable (fun y => ‖u k y‖ₑ ^ (3 / 2 : ℝ)) := fun k =>
      ((ENNReal.continuous_rpow_const.comp continuous_enorm).comp (hu k).continuous).measurable
    have hlim : (fun y => liminf (fun k => ‖u k y‖ₑ ^ (3 / 2 : ℝ)) atTop) =ᵐ[volume]
        S.indicator 1 := by
      filter_upwards [hae] with y hy
      have h2 : Tendsto (fun k => ‖u k y‖ₑ ^ (3 / 2 : ℝ)) atTop
          (𝓝 (‖S.indicator (fun _ => (1 : ℝ)) y‖ₑ ^ (3 / 2 : ℝ))) :=
        ((ENNReal.continuous_rpow_const.comp continuous_enorm).tendsto _).comp hy
      rw [h2.liminf_eq]
      by_cases hyS : y ∈ S
      · simp [hyS]
      · simp [hyS]
    have hvol : volume S ≤ (CG : ENNReal) * P ^ (3 / 2 : ℝ) := by
      calc volume S = ∫⁻ y, S.indicator 1 y := (lintegral_indicator_one hS).symm
        _ = ∫⁻ y, liminf (fun k => ‖u k y‖ₑ ^ (3 / 2 : ℝ)) atTop := lintegral_congr_ae hlim.symm
        _ ≤ liminf (fun k => ∫⁻ y, ‖u k y‖ₑ ^ (3 / 2 : ℝ)) atTop := lintegral_liminf_le hmeas
        _ ≤ (CG : ENNReal) * P ^ (3 / 2 : ℝ) :=
            Filter.liminf_le_of_frequently_le' (Filter.Eventually.of_forall hGNS).frequently
    calc volume S ^ ((2 : ℝ) / 3) ≤ ((CG : ENNReal) * P ^ (3 / 2 : ℝ)) ^ ((2 : ℝ) / 3) :=
          ENNReal.rpow_le_rpow hvol (by norm_num)
      _ = (CG : ENNReal) ^ ((2 : ℝ) / 3) * P := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
          norm_num
      _ ≤ ENNReal.ofReal ((CG : ℝ) ^ ((2 : ℝ) / 3) + 1) * P := by
          gcongr
          rw [← ENNReal.coe_rpow_of_nonneg _ (by norm_num), ← ENNReal.ofReal_coe_nnreal,
            NNReal.coe_rpow]
          exact ENNReal.ofReal_le_ofReal (by linarith)
  
  refine ⟨C, hC, ?_⟩
  intro S hS hSb
  by_cases hPtop : sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) S Set.univ = ⊤
  · rw [hPtop, ENNReal.mul_top (ENNReal.ofReal_pos.2 hC).ne']
    exact le_top
  obtain ⟨hsm, φ, hae⟩ := hs4 S hS hSb
  refine hD S (fun k => convolution ((φ k).normed volume) (S.indicator fun _ => (1 : ℝ))
      (ContinuousLinearMap.lsmul ℝ ℝ) volume) _ hS (fun k => (hsm (φ k)).1)
      (fun k => (hsm (φ k)).2) hae ?_
  intro k
  rw [← ENNReal.ofReal_toReal hPtop]
  apply sepIso_grad_dual _ _ (hsm (φ k)).1 (hsm (φ k)).2
  intro X hX hXc hX1
  obtain ⟨hDc, hDcs, Y, hY, hYc, hY1, hdiv⟩ := sepIso_mollify_field (φ k) X hX hXc hX1
  rw [← sepIso_conv_adjoint (φ k) S _ hS hDc hDcs]
  have h1 : ∫ z in S, convolution ((φ k).normed volume)
      (fun y => ∑ i : Fin 3, partialDeriv i (fun w => X w i) y)
      (ContinuousLinearMap.lsmul ℝ ℝ) volume z =
      ∫ z in S, ∑ i : Fin 3, partialDeriv i (fun w => Y w i) z := by
    congr 1
    funext z
    exact (hdiv z).symm
  rw [h1]
  exact (ENNReal.ofReal_le_iff_le_toReal hPtop).1 (hs6 S Y hY hYc hY1)

theorem sepPerE_radial_cut : ∃ C : ℝ, 0 ≤ C ∧ ∀ (F V : Set E3) (x : E3) (t L : ℝ) (h : ℕ → ℝ), MeasurableSet F → 0 < t → 0 ≤ L → (∀ n, 0 < h n) → Filter.Tendsto h Filter.atTop (𝓝 0) → (∀ n, volume (F ∩ Metric.closedBall x (t + h n)) ≤ volume (F ∩ Metric.ball x t) + ENNReal.ofReal (L * h n)) → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F \ Metric.ball x t) V ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (V \ Metric.closedBall x t) + ENNReal.ofReal (C * L) ∧ ∀ t' : ℝ, t < t' → sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (F ∩ Metric.ball x t) Set.univ ≤ sepPerG (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) F (Metric.ball x t') + ENNReal.ofReal (C * L) :=
by
  
  have cutoff : ∃ M : ℝ, 0 ≤ M ∧ ∀ (x : E3) (a b : ℝ), 0 ≤ a → a < b → ∃ R : E3 → ℝ,
      ContDiff ℝ ∞ R ∧ (∀ y, 0 ≤ R y ∧ R y ≤ 1) ∧ (∀ y, dist y x ≤ a → R y = 0) ∧
      (∀ y, b ≤ dist y x → R y = 1) ∧
      (∀ y, ‖fderiv ℝ R y‖ ≤
        (Metric.closedBall x b \ Metric.ball x a).indicator (fun _ => M / (b - a)) y) := by
    have st_deriv_bound : ∃ M : ℝ, 0 ≤ M ∧ (∀ r, |deriv Real.smoothTransition r| ≤ M) ∧
        ∀ r, r < 0 ∨ 1 < r → deriv Real.smoothTransition r = 0 := by
      have hc : Continuous (deriv Real.smoothTransition) :=
        (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
      have hz : ∀ r, r < 0 ∨ 1 < r → deriv Real.smoothTransition r = 0 := by
        intro r hr
        rcases hr with hr | hr1
        · have : Real.smoothTransition =ᶠ[𝓝 r] fun _ => 0 := by
            filter_upwards [Iio_mem_nhds hr] with s hs
            exact Real.smoothTransition.zero_of_nonpos (le_of_lt hs)
          rw [this.deriv_eq, deriv_const]
        · have : Real.smoothTransition =ᶠ[𝓝 r] fun _ => 1 := by
            filter_upwards [Ioi_mem_nhds hr1] with s hs
            exact Real.smoothTransition.one_of_one_le (le_of_lt hs)
          rw [this.deriv_eq, deriv_const]
      obtain ⟨M, hM⟩ := (isCompact_Icc (a := (0:ℝ)) (b := 1)).exists_bound_of_continuousOn
        hc.continuousOn
      refine ⟨max M 0, le_max_right _ _, fun r => ?_, hz⟩
      rcases lt_or_ge r 0 with hr | hr
      · rw [hz r (Or.inl hr)]; simp
      rcases le_or_gt r 1 with hr1 | hr1
      · have := hM r ⟨hr, hr1⟩
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _)
      · rw [hz r (Or.inr hr1)]; simp
    obtain ⟨MS, hMS0, hMS, hz⟩ := st_deriv_bound
    refine ⟨2 * MS, by positivity, fun x a b ha hab => ?_⟩
    have hκpos : 0 < b ^ 2 - a ^ 2 := by nlinarith
    set κ := b ^ 2 - a ^ 2 with hκ
    set u : E3 → ℝ := fun y => κ⁻¹ * (‖y - x‖ ^ 2 - a ^ 2) with hu
    have hucd : ContDiff ℝ ∞ u :=
      contDiff_const.mul (((contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)).sub
        contDiff_const)
    have hud : ∀ y, HasFDerivAt u
        (κ⁻¹ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E3))) y := by
      intro y
      have h1 : HasFDerivAt (fun z : E3 => z - x) (ContinuousLinearMap.id ℝ E3) y :=
        (hasFDerivAt_id y).sub_const x
      exact (h1.norm_sq.sub_const (a ^ 2)).const_mul κ⁻¹
    have hunorm : ∀ y, ‖κ⁻¹ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E3))‖
        ≤ κ⁻¹ * (2 * ‖y - x‖) := by
      intro y
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
      have h1 : (κ⁻¹ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E3))) v =
          κ⁻¹ * (2 * @inner ℝ E3 _ (y - x) v) := by simp [inner_sub_left]
      rw [h1, Real.norm_eq_abs, abs_mul, abs_of_pos (inv_pos.2 hκpos), abs_mul]
      have h2 := abs_real_inner_le_norm (y - x) v
      have h3 : 0 ≤ κ⁻¹ := inv_nonneg.2 hκpos.le
      calc κ⁻¹ * (|2| * |@inner ℝ E3 _ (y - x) v|) ≤ κ⁻¹ * (2 * (‖y - x‖ * ‖v‖)) := by
            rw [abs_two]; gcongr
        _ = κ⁻¹ * (2 * ‖y - x‖) * ‖v‖ := by ring
    have hS := fun r => (Real.smoothTransition.contDiff (n := 1)).differentiable (by norm_num) r
    have hRd : ∀ y, HasFDerivAt (fun z => Real.smoothTransition (u z))
        (deriv Real.smoothTransition (u y) •
          (κ⁻¹ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E3)))) y :=
      fun y => (hS (u y)).hasDerivAt.comp_hasFDerivAt y (hud y)
    have hdist : ∀ y, dist y x = ‖y - x‖ := fun y => dist_eq_norm y x
    refine ⟨fun z => Real.smoothTransition (u z), Real.smoothTransition.contDiff.comp hucd,
      fun y => ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩, ?_, ?_, ?_⟩
    · intro y hy
      apply Real.smoothTransition.zero_of_nonpos
      rw [hdist] at hy
      have h0 : ‖y - x‖ ^ 2 ≤ a ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hy 2
      have : ‖y - x‖ ^ 2 - a ^ 2 ≤ 0 := by linarith
      exact mul_nonpos_of_nonneg_of_nonpos (inv_nonneg.2 hκpos.le) this
    · intro y hy
      apply Real.smoothTransition.one_of_one_le
      rw [hdist] at hy
      have h0 : b ^ 2 ≤ ‖y - x‖ ^ 2 := pow_le_pow_left₀ (by linarith) hy 2
      show 1 ≤ κ⁻¹ * (‖y - x‖ ^ 2 - a ^ 2)
      rw [inv_mul_eq_div, le_div_iff₀ hκpos]
      linarith
    · intro y
      rw [(hRd y).fderiv, norm_smul]
      by_cases hA : y ∈ Metric.closedBall x b \ Metric.ball x a
      · rw [Set.indicator_of_mem hA]
        obtain ⟨hyb, hya⟩ := hA
        rw [Metric.mem_closedBall, hdist] at hyb
        have hb0 : 0 < b := by linarith
        have h1 := hunorm y
        have h2 : ‖deriv Real.smoothTransition (u y)‖ ≤ MS := by
          rw [Real.norm_eq_abs]; exact hMS _
        have h3 : κ⁻¹ * (2 * ‖y - x‖) ≤ 2 / (b - a) := by
          rw [inv_mul_eq_div, div_le_div_iff₀ hκpos (by linarith)]
          have : ‖y - x‖ * (b - a) ≤ b * (b - a) :=
            mul_le_mul_of_nonneg_right hyb (by linarith)
          nlinarith
        calc ‖deriv Real.smoothTransition (u y)‖ *
              ‖κ⁻¹ • (2 • (innerSL ℝ (y - x)).comp (ContinuousLinearMap.id ℝ E3))‖
            ≤ MS * (2 / (b - a)) :=
              mul_le_mul h2 (h1.trans h3) (norm_nonneg _) hMS0
          _ = 2 * MS / (b - a) := by ring
      · rw [Set.indicator_of_notMem hA]
        have hu0 : u y < 0 ∨ 1 < u y := by
          rw [Set.mem_diff, Metric.mem_closedBall, Metric.mem_ball, hdist] at hA
          push_neg at hA
          by_cases hyb : ‖y - x‖ ≤ b
          · left
            have hya := hA hyb
            have h0 : ‖y - x‖ ^ 2 < a ^ 2 := pow_lt_pow_left₀ hya (norm_nonneg _) (by norm_num)
            show κ⁻¹ * (‖y - x‖ ^ 2 - a ^ 2) < 0
            exact mul_neg_of_pos_of_neg (inv_pos.2 hκpos) (by linarith)
          · right
            push_neg at hyb
            have h0 : b ^ 2 < ‖y - x‖ ^ 2 := pow_lt_pow_left₀ hyb (by linarith) (by norm_num)
            show 1 < κ⁻¹ * (‖y - x‖ ^ 2 - a ^ 2)
            rw [inv_mul_eq_div, lt_div_iff₀ hκpos]
            linarith
        rw [hz _ hu0]; simp
  
  have divOne_eq : ∀ (X : E3 → E3) (y : E3),
      sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y =
        ∑ i : Fin 3, fderiv ℝ (fun z => X z i) y (e i) := by
    intro X y
    simp [sepDensDiv, partialDeriv]
  have divOne_integrable : ∀ (Y : E3 → E3), ContDiff ℝ ∞ Y → HasCompactSupport Y →
      Integrable (sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y) := by
    intro Y hY hYc
    have hfun : sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) Y =
        fun y => ∑ i : Fin 3, fderiv ℝ (fun z => Y z i) y (e i) := funext (divOne_eq Y)
    rw [hfun]
    refine integrable_finset_sum _ (fun i _ => ?_)
    have hYi : ContDiff ℝ ∞ (fun z => Y z i) :=
      (EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hY
    have hYic : HasCompactSupport (fun z => Y z i) :=
      hYc.comp_left (g := fun v : E3 => v i) (by simp)
    have hcont : Continuous (fun y => fderiv ℝ (fun z => Y z i) y (e i)) :=
      (hYi.continuous_fderiv (by simp)).clm_apply continuous_const
    have hsupp : HasCompactSupport (fun y => fderiv ℝ (fun z => Y z i) y (e i)) :=
      (hYic.fderiv (𝕜 := ℝ)).comp_left (g := fun L : E3 →L[ℝ] ℝ => L (e i)) (by simp)
    exact hcont.integrable_of_hasCompactSupport hsupp
  
  have divOne_smul : ∀ (X : E3 → E3) (ψ : E3 → ℝ), ContDiff ℝ ∞ X → ContDiff ℝ ∞ ψ →
      ∀ y : E3, sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) (fun z => ψ z • X z) y =
        ψ y * sepDensDiv (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ)) X y +
          fderiv ℝ ψ y (X y) := by
    intro X ψ hX hψ y
    have hXi : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => X z i) y := fun i =>
      (((EuclideanSpace.proj i : E3 →L[ℝ] ℝ).contDiff.comp hX).differentiable (by simp)) y
    have hψd : DifferentiableAt ℝ ψ y := hψ.differentiable (by simp) y
    have hsum : X y = ∑ i : Fin 3, X y i • e i := by
      have := (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr (X y)
      simpa [EuclideanSpace.basisFun_apply] using this.symm
    have hrhs : fderiv ℝ ψ y (X y) = ∑ i : Fin 3, X y i * fderiv ℝ ψ y (e i) := by
      conv_lhs => rw [hsum]
      simp [map_sum, map_smul]
    have hcomp : ∀ i : Fin 3, (fun z => (ψ z • X z) i) = fun z => ψ z * X z i := by
      intro i; funext z; simp
    rw [divOne_eq, divOne_eq, hrhs, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hcomp i]
    have hfe : (fun z => ψ z * X z i) = ψ * (fun z => X z i) := rfl
    rw [hfe, fderiv_mul hψd (hXi i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
  have norm_le_one_of_adm : ∀ (X : E3 → E3),
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, (1 : Matrix (Fin 3) (Fin 3) ℝ) i j * X y i * X y j ≤ 1) →
      ∀ y, ‖X y‖ ≤ 1 := by
    intro X hXn y
