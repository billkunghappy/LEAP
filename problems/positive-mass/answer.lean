    fun n a b => ((hHb j).2.2 _
      (((hcc j _ _ (hsm (U n)).1 (hsm (U n)).1).2.1 b).mul (hwc a b))).2
  have hBsum : ∀ n, B (U n) ⟨φ, hφV⟩ = ∑ a : Fin 3, ∑ b : Fin 3,
      ∫ x in ndsHalf (A.c j) (A.r j),
        partialDeriv b (fun z => (U n : M → ℝ) (A.κ j z)) x * w a b x := by
    intro n
    rw [hBφ n, setIntegral_congr_fun (hHb j).1 (hint n)]
    rw [integral_finset_sum _ (fun a _ => integrable_finset_sum _ (fun b _ => hintg n a b))]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [integral_finset_sum _ (fun b _ => hintg n a b)]
  have hlimB : Tendsto (fun n => B (U n) ⟨φ, hφV⟩) atTop
      (𝓝 (∑ a : Fin 3, ∑ b : Fin 3, ∫ x in ndsHalf (A.c j) (A.r j), Gr j b x * w a b x)) := by
    have e : (fun n => B (U n) ⟨φ, hφV⟩) = fun n => ∑ a : Fin 3, ∑ b : Fin 3,
