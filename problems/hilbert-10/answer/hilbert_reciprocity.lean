    have hd_inv : d * d⁻¹ = 1 := mul_inv_cancel₀ hd
    have hs_inv : sF * sF⁻¹ = 1 := mul_inv_cancel₀ hsF
    have ht_inv : tF * tF⁻¹ = 1 := mul_inv_cancel₀ htF
    have h_iff : (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) ↔
        (∃ X' Y' : F, X' ^ 2 - b * Y' ^ 2 = a') := by
      constructor
      · rintro ⟨X, Y, hXY⟩
        refine ⟨(X * xF + b * Y * yF) * sF * tF⁻¹, (X * yF + Y * xF) * sF * tF⁻¹, ?_⟩
        linear_combination
          d * sF ^ 2 * (tF⁻¹) ^ 2 * hXY + (tF⁻¹) ^ 2 * h_eqF +
          a' * (tF * tF⁻¹ + 1) * ht_inv
      · rintro ⟨X', Y', hXY'⟩
        refine ⟨(X' * xF - b * Y' * yF) * tF * d⁻¹ * sF⁻¹,
          (xF * Y' - yF * X') * tF * d⁻¹ * sF⁻¹, ?_⟩
        linear_combination
          d * tF ^ 2 * (d⁻¹) ^ 2 * (sF⁻¹) ^ 2 * hXY' -
          d * (d⁻¹) ^ 2 * (sF⁻¹) ^ 2 * h_eqF +
          a * sF ^ 2 * (sF⁻¹) ^ 2 * (d * d⁻¹ + 1) * hd_inv +
          a * (sF * sF⁻¹ + 1) * hs_inv
    dsimp only [normSym]
    change (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1) =
      (if ∃ X' Y' : F, X' ^ 2 - b * Y' ^ 2 = a' then (1 : ℤˣ) else -1)
    rw [h_iff]
  have h_dyad_eq : dyadicProd α β = dyadicProd α' β := by
    letI := Classical.propDecidable
    dsimp only [dyadicProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, h_norm v]
    · rw [if_neg h2v, if_neg h2v]
  have h_dyad : resDyadicProd α β = resDyadicProd α' β :=
    (dyadicProd_eq_resDyadicProd_loc α hα h_sqfree).symm.trans
      (h_dyad_eq.trans (dyadicProd_eq_resDyadicProd_loc α' hα' h_sqfree'))
  have h_odd₁ : oddResQuadProd α β = oddResQuadProd α' β := by
    letI := Classical.propDecidable
    dsimp only [oddResQuadProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · have hL : ¬ ((2 : R) ∉ v.asIdeal ∧ valNat v α % 2 = 1) := fun h => h.1 h2v
      have hR : ¬ ((2 : R) ∉ v.asIdeal ∧ valNat v α' % 2 = 1) := fun h => h.1 h2v
      rw [if_neg hL, if_neg hR]
    · by_cases h_par : valNat v α % 2 = valNat v α' % 2
      · rw [h_par]
      · rw [resQuadSym_beta_eq_one_of_odd_ne v h2v h_par, ite_self, ite_self]
  have h_odd₂ : oddResQuadProd β α = oddResQuadProd β α' := by
    letI := Classical.propDecidable
    dsimp only [oddResQuadProd]
    refine finprod_congr (fun v => ?_)
    by_cases h : (2 : R) ∉ v.asIdeal ∧ valNat v β % 2 = 1
    · rw [if_pos h, if_pos h, resQuadSym_alpha_eq_of_beta_odd v h.1 h.2]
    · rw [if_neg h, if_neg h]
  have h_odd : oddPowResQuadProd α β * oddPowResQuadProd β α =
      oddPowResQuadProd α' β * oddPowResQuadProd β α' := by
    rw [← oddResQuadProd_eq_oddPowResQuadProd_loc α β,
      ← oddResQuadProd_eq_oddPowResQuadProd_loc β α,
      ← oddResQuadProd_eq_oddPowResQuadProd_loc α' β,
      ← oddResQuadProd_eq_oddPowResQuadProd_loc β α',
      h_odd₁, h_odd₂]
  have h_real : realSignProd α β = realSignProd α' β := by
    letI := Classical.propDecidable
    dsimp only [realSignProd]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ c : K, (w.embedding c).re = ρ c := by
        intro c
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw c, Complex.ofReal_re]
      by_cases hb_neg : (w.embedding (algebraMap R K β)).re < 0
      · have hb_rho : ρ (algebraMap R K β) < 0 := by rwa [← h_re]
        have h_inj : Function.Injective (ρ.comp (algebraMap R K)) :=
          (RingHom.injective ρ).comp (IsFractionRing.injective R K)
        have hd_ne : ρ (algebraMap R K δ) ≠ 0 :=
          (map_ne_zero_iff (ρ.comp (algebraMap R K)) h_inj).mpr hδ
        have hs_ne : ρ (algebraMap R K s) ≠ 0 :=
          (map_ne_zero_iff (ρ.comp (algebraMap R K)) h_inj).mpr hs
        have ht_ne : ρ (algebraMap R K t) ≠ 0 :=
          (map_ne_zero_iff (ρ.comp (algebraMap R K)) h_inj).mpr ht
        have hd_eq : ρ (algebraMap R K δ) =
            (ρ (algebraMap R K x)) ^ 2 - ρ (algebraMap R K β) * (ρ (algebraMap R K y)) ^ 2 := by
          dsimp [δ]
          simp [map_sub, map_mul, map_pow]
        have hd_nonneg : 0 ≤ ρ (algebraMap R K δ) := by
          rw [hd_eq]
          have hx_sq : 0 ≤ (ρ (algebraMap R K x)) ^ 2 := sq_nonneg _
          have hy_sq : 0 ≤ (ρ (algebraMap R K y)) ^ 2 := sq_nonneg _
          nlinarith
        have hd_pos : 0 < ρ (algebraMap R K δ) := lt_of_le_of_ne hd_nonneg hd_ne.symm
        have hs_sq_pos : 0 < (ρ (algebraMap R K s)) ^ 2 := sq_pos_of_ne_zero hs_ne
        have ht_sq_pos : 0 < (ρ (algebraMap R K t)) ^ 2 := sq_pos_of_ne_zero ht_ne
        have hds_pos : 0 < ρ (algebraMap R K δ) * (ρ (algebraMap R K s)) ^ 2 :=
          mul_pos hd_pos hs_sq_pos
        have h_eq_R : ρ (algebraMap R K α) * (ρ (algebraMap R K δ) * (ρ (algebraMap R K s)) ^ 2) =
            ρ (algebraMap R K α') * (ρ (algebraMap R K t)) ^ 2 := by
          have h := congr_arg (fun z => ρ (algebraMap R K z)) h_eq
          change ρ (algebraMap R K (α * δ * s ^ 2)) = ρ (algebraMap R K (α' * t ^ 2)) at h
          simp only [map_mul, map_pow] at h
          linarith
        have h_sign_iff :
            (w.embedding (algebraMap R K α)).re < 0 ↔
              (w.embedding (algebraMap R K α')).re < 0 := by
          rw [h_re, h_re]
          constructor <;> intro h_neg <;> nlinarith
        rw [h_sign_iff]
      · have hL : ¬ (w.IsReal ∧
            (w.embedding (algebraMap R K α)).re < 0 ∧
            (w.embedding (algebraMap R K β)).re < 0) := fun h => hb_neg h.2.2
        have hR : ¬ (w.IsReal ∧
            (w.embedding (algebraMap R K α')).re < 0 ∧
            (w.embedding (algebraMap R K β)).re < 0) := fun h => hb_neg h.2.2
        rw [if_neg hL, if_neg hR]
    · have hL : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α)).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      have hR : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α')).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      rw [if_neg hL, if_neg hR]
  exact ⟨h_dyad, h_odd, h_real⟩

theorem exists_norm_mul_sq_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_strict_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    ∃ α' x y s t : NumberField.RingOfIntegers K,
      α' ≠ 0 ∧ x ^ 2 - β * y ^ 2 ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
      α * (x ^ 2 - β * y ^ 2) * s ^ 2 = α' * t ^ 2 ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ¬ (α' ∈ v.asIdeal ∧ β ∈ v.asIdeal)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
          valNat v α' ≤ 1 ∧ valNat v β ≤ 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have finite_mem_asIdeal :
      ∀ (γ : R), γ ≠ 0 →
        {v : IsDedekindDomain.HeightOneSpectrum R | γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hI : (Ideal.span {γ} : Ideal R) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-((valNat v γ : ℕ) : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have h_toNat : ((valNat v γ : ℕ) : ℤ) = -WithZero.log (v.intValuation γ) := by
      dsimp [valNat]
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [h_toNat, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ δ : R), γ ≠ 0 → δ ≠ 0 →
        valNat v (γ * δ) = valNat v γ + valNat v δ := by
    intro v γ δ hγ hδ
    have hval_mul : v.intValuation (γ * δ) =
        WithZero.exp (-((valNat v γ + valNat v δ : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v δ hδ, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * δ))).toNat = valNat v γ + valNat v δ
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_mod_two_eq_of_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ γ' s t : R),
        γ ≠ 0 → γ' ≠ 0 → s ≠ 0 → t ≠ 0 → γ * s ^ 2 = γ' * t ^ 2 →
          valNat v γ' % 2 = valNat v γ % 2 := by
    intro v γ γ' s t hγ hγ' hs ht h_eq
    have hs2 : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    have h1 : valNat v (γ * s ^ 2) = valNat v γ + (valNat v s + valNat v s) := by
      rw [valNat_mul v γ (s ^ 2) hγ hs2, sq s, valNat_mul v s s hs hs]
    have h2 : valNat v (γ' * t ^ 2) = valNat v γ' + (valNat v t + valNat v t) := by
      rw [valNat_mul v γ' (t ^ 2) hγ' ht2, sq t, valNat_mul v t t ht ht]
    have h3 : valNat v (γ * s ^ 2) = valNat v (γ' * t ^ 2) := congr_arg (valNat v) h_eq
    omega
  have valNat_eq_zero_of_not_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ∉ v.asIdeal → valNat v γ = 0 := by
    intro v γ hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    dsimp [valNat]
    rw [hv1, WithZero.log_one]
    rfl
  have not_mem_asIdeal_of_valNat_eq_zero :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ≠ 0 → valNat v γ = 0 → γ ∉ v.asIdeal := by
    intro v γ hγ h0
    have hv1 : v.intValuation γ = 1 := by
      rw [intValuation_eq_exp_neg_valNat v γ hγ, h0]
      simp
    exact v.intValuation_eq_one_iff.mp hv1
  have exists_step_clear :
      ∀ (T : Finset (IsDedekindDomain.HeightOneSpectrum R))
        (w : IsDedekindDomain.HeightOneSpectrum R), w ∉ T →
        ∀ (γ₁ : R), γ₁ ≠ 0 →
          ∃ γ' s₀ t₀ : R,
            γ' ≠ 0 ∧ s₀ ≠ 0 ∧ t₀ ≠ 0 ∧
            γ₁ * s₀ ^ 2 = γ' * t₀ ^ 2 ∧
            valNat w γ' ≤ 1 ∧
            (∀ u ∈ T, s₀ ∉ u.asIdeal ∧ t₀ ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁) := by
    intro T w hwT γ₁ hγ₁
    let k : ℕ := valNat w γ₁ / 2
    have hγ₁_val : w.intValuation γ₁ ≤ WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [intValuation_eq_exp_neg_valNat w γ₁ hγ₁, WithZero.exp_le_exp]
      omega
    have hγ₁_mem : γ₁ ∈ w.asIdeal ^ (2 * k) :=
      (w.intValuation_le_pow_iff_mem γ₁ (2 * k)).mp hγ₁_val
    have h_cop : IsCoprime (w.asIdeal ^ 2) (∏ u ∈ T, u.asIdeal) := by
      refine IsCoprime.prod_right (fun u huT => ?_)
      have hne : w ≠ u := fun h => hwT (h ▸ huT)
      have h_id_ne : w.asIdeal ≠ u.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hne
      haveI := w.isMaximal
      haveI := u.isMaximal
      exact (Ideal.isCoprime_of_isMaximal h_id_ne).pow_left
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_cop
    have hx_val : w.intValuation x ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
      (w.intValuation_le_pow_iff_mem x 2).mpr hx
    have hx_w : x ∈ w.asIdeal :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hx
    have hy_w : y ∉ w.asIdeal := by
      intro hy_m
      have h1_m : (1 : R) ∈ w.asIdeal := hxy ▸ w.asIdeal.add_mem hx_w hy_m
      exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_m)
    have hy_val : w.intValuation y = 1 := w.intValuation_eq_one_iff.mpr hy_w
    have hy_T : ∀ u ∈ T, y ∈ u.asIdeal :=
      fun u huT => (Ideal.prod_le_inf.trans (Finset.inf_le huT)) hy
    have hx_T : ∀ u ∈ T, x ∉ u.asIdeal := by
      intro u huT hx_m
      have h1_m : (1 : R) ∈ u.asIdeal := hxy ▸ u.asIdeal.add_mem hx_m (hy_T u huT)
      exact u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1_m)
    obtain ⟨π, hπ⟩ := w.intValuation_exists_uniformizer
    let π' : R := π * y + x
    have hπy_val : w.intValuation (π * y) = WithZero.exp (-1 : ℤ) := by
      rw [map_mul, hπ, hy_val, mul_one]
    have hlt_exp : WithZero.exp (-((2 : ℕ) : ℤ)) < WithZero.exp (-1 : ℤ) :=
      WithZero.exp_lt_exp.mpr (by omega)
    have hlt_val : w.intValuation x < w.intValuation (π * y) := by
      rw [hπy_val]
      exact lt_of_le_of_lt hx_val hlt_exp
    have hπ'_val : w.intValuation π' = WithZero.exp (-1 : ℤ) := by
      change w.intValuation (π * y + x) = WithZero.exp (-1 : ℤ)
      rw [add_comm, Valuation.map_add_of_distinct_val w.intValuation (ne_of_lt hlt_val),
        max_eq_right (le_of_lt hlt_val), hπy_val]
    have hπ'_w : π' ∈ w.asIdeal := by
      have hle1 : w.intValuation π' ≤ WithZero.exp (-((1 : ℕ) : ℤ)) := by
        rw [hπ'_val]
        exact le_rfl
      simpa [pow_one] using (w.intValuation_le_pow_iff_mem π' 1).mp hle1
    have hπ'_T : ∀ u ∈ T, π' ∉ u.asIdeal := by
      intro u huT hπ'_m
      have hπy_m : π * y ∈ u.asIdeal := u.asIdeal.mul_mem_left π (hy_T u huT)
      have hx_m : x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hπ'_m hπy_m
        have hid : π' - π * y = x := by dsimp [π']; ring
        rwa [hid] at hsub
      exact hx_T u huT hx_m
    have hπ'_dvd : w.asIdeal ^ 1 ∣ Ideal.span {π'} := by
      apply (w.intValuation_le_pow_iff_dvd π' 1).mp
      rw [hπ'_val]
      exact le_rfl
    rw [pow_one] at hπ'_dvd
    obtain ⟨J, hJ⟩ := hπ'_dvd
    have hJ_not_le : ¬ (J ≤ w.asIdeal) := by
      intro hle
      have hπ'_mem2 : π' ∈ w.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ'_le2 : w.intValuation π' ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (w.intValuation_le_pow_iff_mem π' 2).mpr hπ'_mem2
      rw [hπ'_val, WithZero.exp_le_exp] at hπ'_le2
      omega
    obtain ⟨a, haJ, haw⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hπ'J : π' ∈ J := by
      rw [← Ideal.span_singleton_le_iff_mem, hJ]
      exact Ideal.mul_le_left
    let s₀ : R := a * y + π' * x
    have hs₀J : s₀ ∈ J :=
      J.add_mem (J.mul_mem_right y haJ) (J.mul_mem_right x hπ'J)
    have hs₀w : s₀ ∉ w.asIdeal := by
      intro hs₀_m
      have hπ'x_w : π' * x ∈ w.asIdeal := w.asIdeal.mul_mem_right x hπ'_w
      have hay_w : a * y ∈ w.asIdeal := by
        have hsub := w.asIdeal.sub_mem hs₀_m hπ'x_w
        have hid : s₀ - π' * x = a * y := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases w.isPrime.mem_or_mem hay_w with ha_m | hy_m
      · exact haw ha_m
      · exact hy_w hy_m
    have hs₀_T : ∀ u ∈ T, s₀ ∉ u.asIdeal := by
      intro u huT hs₀_m
      have hay_u : a * y ∈ u.asIdeal := u.asIdeal.mul_mem_left a (hy_T u huT)
      have hπ'x_u : π' * x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hs₀_m hay_u
        have hid : s₀ - a * y = π' * x := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases u.isPrime.mem_or_mem hπ'x_u with hπ'_m | hx_m
      · exact hπ'_T u huT hπ'_m
      · exact hx_T u huT hx_m
    have hspan_γ₁ : Ideal.span {γ₁} ≤ w.asIdeal ^ (2 * k) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hγ₁_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_mul : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π' ^ k) ^ 2} := by
      have h1 : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} = Ideal.span {γ₁} * (Ideal.span {s₀}) ^ (2 * k) := by
        rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
          ← Ideal.span_singleton_pow]
      have h2 : Ideal.span {(π' ^ k) ^ 2} = w.asIdeal ^ (2 * k) * J ^ (2 * k) := by
        rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
      rw [h1, h2]
      exact Ideal.mul_mono hspan_γ₁ (Ideal.pow_right_mono hspan_s₀ (2 * k))
    obtain ⟨γ', hγ'_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
    have hπ'_pow_val : w.intValuation ((π' ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ'_val, exp_neg_one_pow (2 * k)]
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀w (h0 ▸ w.asIdeal.zero_mem)
    have hπ'_ne : π' ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hπ'_val
      exact WithZero.exp_ne_zero hπ'_val.symm
    have hs₀k2_ne : (s₀ ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hs₀_ne)
    have hπ'k2_ne : (π' ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hπ'_ne)
    have hγ'_ne : γ' ≠ 0 := by
      intro h0
      apply mul_ne_zero hγ₁ hs₀k2_ne
      rw [hγ'_eq, h0, mul_zero]
    have hs₀k2_not_w : (s₀ ^ k) ^ 2 ∉ w.asIdeal :=
      fun hm => hs₀w (w.isPrime.mem_of_pow_mem k (w.isPrime.mem_of_pow_mem 2 hm))
    have hval_s₀k2_w : valNat w ((s₀ ^ k) ^ 2) = 0 :=
      valNat_eq_zero_of_not_mem w ((s₀ ^ k) ^ 2) hs₀k2_not_w
    have hval_π'k2_w : valNat w ((π' ^ k) ^ 2) = 2 * k := by
      change (-WithZero.log (w.intValuation ((π' ^ k) ^ 2))).toNat = 2 * k
      rw [hπ'_pow_val, WithZero.log_exp]
      omega
    have hval_eq_w : valNat w γ₁ + valNat w ((s₀ ^ k) ^ 2) =
        valNat w ((π' ^ k) ^ 2) + valNat w γ' := by
      rw [← valNat_mul w γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
        valNat_mul w ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
    have hγ'_le_one : valNat w γ' ≤ 1 := by omega
    have hT_props : ∀ u ∈ T,
        s₀ ^ k ∉ u.asIdeal ∧ π' ^ k ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁ := by
      intro u huT
      have hs₀k_not_u : s₀ ^ k ∉ u.asIdeal :=
        fun hm => hs₀_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hπ'k_not_u : π' ^ k ∉ u.asIdeal :=
        fun hm => hπ'_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hs₀k2_not_u : (s₀ ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hs₀k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hπ'k2_not_u : (π' ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hπ'k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hval_s₀k2_u : valNat u ((s₀ ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((s₀ ^ k) ^ 2) hs₀k2_not_u
      have hval_π'k2_u : valNat u ((π' ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((π' ^ k) ^ 2) hπ'k2_not_u
      have hval_eq_u : valNat u γ₁ + valNat u ((s₀ ^ k) ^ 2) =
          valNat u ((π' ^ k) ^ 2) + valNat u γ' := by
        rw [← valNat_mul u γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
          valNat_mul u ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
      refine ⟨hs₀k_not_u, hπ'k_not_u, by omega⟩
    refine ⟨γ', s₀ ^ k, π' ^ k, hγ'_ne, pow_ne_zero k hs₀_ne, pow_ne_zero k hπ'_ne,
      hγ'_eq.trans (mul_comm _ _), hγ'_le_one, hT_props⟩
  have exists_clear_finset :
      ∀ (P S : Finset (IsDedekindDomain.HeightOneSpectrum R)),
        (∀ v ∈ S, v ∉ P) →
        ∀ (γ : R), γ ≠ 0 →
          ∃ γ' s t : R,
            γ' ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
            γ * s ^ 2 = γ' * t ^ 2 ∧
            (∀ u ∈ P, s ∉ u.asIdeal ∧ t ∉ u.asIdeal) ∧
            (∀ v ∈ S, valNat v γ' ≤ 1) := by
    intro P S
    induction S using Finset.induction_on with
    | empty =>
      intro _ γ hγ
      refine ⟨γ, 1, 1, hγ, one_ne_zero, one_ne_zero, rfl, ?_, ?_⟩
      · intro u _
        have h1_not : (1 : R) ∉ u.asIdeal :=
          fun h1 => u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1)
        exact ⟨h1_not, h1_not⟩
      · intro v hv
        exact False.elim (Finset.notMem_empty v hv)
    | insert w S hwS ih =>
      intro hSP γ hγ
      have hwP : w ∉ P := hSP w (Finset.mem_insert_self w S)
      have hSP' : ∀ v ∈ S, v ∉ P := fun v hv => hSP v (Finset.mem_insert_of_mem hv)
      obtain ⟨γ₁, s₁, t₁, hγ₁, hs₁, ht₁, h_eq₁, hP₁, hS₁⟩ := ih hSP' γ hγ
      have hwSP : w ∉ S ∪ P := fun hm => (Finset.mem_union.mp hm).elim hwS hwP
      obtain ⟨γ', s₀, t₀, hγ', hs₀, ht₀, h_eq₀, hw', hSP₀⟩ :=
        exists_step_clear (S ∪ P) w hwSP γ₁ hγ₁
      refine ⟨γ', s₁ * s₀, t₁ * t₀, hγ', mul_ne_zero hs₁ hs₀, mul_ne_zero ht₁ ht₀, ?_, ?_, ?_⟩
      · linear_combination s₀ ^ 2 * h_eq₁ + t₁ ^ 2 * h_eq₀
      · intro u huP
        have huSP : u ∈ S ∪ P := Finset.mem_union.mpr (Or.inr huP)
        obtain ⟨hs₁_u, ht₁_u⟩ := hP₁ u huP
        obtain ⟨hs₀_u, ht₀_u, _⟩ := hSP₀ u huSP
        refine ⟨fun hm => (u.isPrime.mem_or_mem hm).elim hs₁_u hs₀_u,
          fun hm => (u.isPrime.mem_or_mem hm).elim ht₁_u ht₀_u⟩
      · intro v hv
        rcases Finset.mem_insert.mp hv with rfl | hvS
        · exact hw'
        · have hvSP : v ∈ S ∪ P := Finset.mem_union.mpr (Or.inl hvS)
          rw [(hSP₀ v hvSP).2.2]
          exact hS₁ v hvS
  have h2 : (2 : R) ≠ 0 := two_ne_zero
  have hfin_2 := finite_mem_asIdeal (2 : R) h2
  let F_2 : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_2.toFinset
  have hfin_β := finite_mem_asIdeal β hβ
  let F_β : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_β.toFinset
  let B_2 : Finset (IsDedekindDomain.HeightOneSpectrum R) :=
    F_2.filter (fun v => α ∈ v.asIdeal ∧ β ∈ v.asIdeal)
  let P : Finset (IsDedekindDomain.HeightOneSpectrum R) := (F_2 ∪ F_β) \ B_2
  have hB2_P : ∀ v ∈ B_2, v ∉ P := fun v hvB hvP => (Finset.mem_sdiff.mp hvP).2 hvB
  by_cases hB₂ : B_2.Nonempty
  · let I_B2 : Ideal R := ∏ v ∈ B_2, v.asIdeal
    let I_P : Ideal R := ∏ w ∈ P, w.asIdeal
    have h_cop_BP : IsCoprime I_B2 I_P := by
      refine IsCoprime.prod_left (fun v hvB => IsCoprime.prod_right (fun w hwP => ?_))
      have hvw : v ≠ w := fun h => hB2_P v hvB (h ▸ hwP)
      have h_id_ne : v.asIdeal ≠ w.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hvw
      haveI := v.isMaximal
      haveI := w.isMaximal
      exact Ideal.isCoprime_of_isMaximal h_id_ne
    obtain ⟨x, hxB, y, hyP, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_cop_BP
    have hB₂_val : ∀ v ∈ B_2,
        v.intValuation (x ^ 2 - β * y ^ 2) = WithZero.exp (-1 : ℤ) ∧
        valNat v (x ^ 2 - β * y ^ 2) = 1 ∧
        valNat v α = 1 := by
      intro v hvB
      obtain ⟨hvF2, hα_mem, hβ_mem⟩ := Finset.mem_filter.mp hvB
      have h2v : (2 : R) ∈ v.asIdeal := hfin_2.mem_toFinset.mp hvF2
      have hα_le1 : valNat v α ≤ 1 := (h_sqfree v h2v).1
      have hβ_le1 : valNat v β ≤ 1 := (h_sqfree v h2v).2
      have hα_ne0 : valNat v α ≠ 0 :=
        fun h0 => not_mem_asIdeal_of_valNat_eq_zero v α hα h0 hα_mem
      have hβ_ne0 : valNat v β ≠ 0 :=
        fun h0 => not_mem_asIdeal_of_valNat_eq_zero v β hβ h0 hβ_mem
      have hα_eq1 : valNat v α = 1 := by omega
      have hβ_eq1 : valNat v β = 1 := by omega
      have hx_mem : x ∈ v.asIdeal :=
        (Ideal.prod_le_inf.trans (Finset.inf_le hvB)) hxB
      have hx_val : v.intValuation x ≤ WithZero.exp (-1 : ℤ) := by
        simpa [pow_one] using
          (v.intValuation_le_pow_iff_mem x 1).mpr (by simpa [pow_one] using hx_mem)
      have hy_not_mem : y ∉ v.asIdeal := by
        intro hy_mem
        have h1_mem : (1 : R) ∈ v.asIdeal := hxy ▸ v.asIdeal.add_mem hx_mem hy_mem
        exact v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_mem)
      have hy_val : v.intValuation y = 1 := v.intValuation_eq_one_iff.mpr hy_not_mem
      have hβy_val : v.intValuation (-(β * y ^ 2)) = WithZero.exp (-1 : ℤ) := by
        rw [Valuation.map_neg, map_mul, map_pow, hy_val, one_pow, mul_one,
          intValuation_eq_exp_neg_valNat v β hβ, hβ_eq1]
        simp
      have hx2_val : v.intValuation (x ^ 2) ≤ WithZero.exp ((-1 : ℤ) + -1) := by
        rw [sq, map_mul, WithZero.exp_add]
        exact mul_le_mul' hx_val hx_val
      have hlt_exp : WithZero.exp ((-1 : ℤ) + -1) < WithZero.exp (-1 : ℤ) :=
        WithZero.exp_lt_exp.mpr (by omega)
      have hlt : v.intValuation (x ^ 2) < v.intValuation (-(β * y ^ 2)) := by
        rw [hβy_val]
        exact lt_of_le_of_lt hx2_val hlt_exp
      have hδ_val : v.intValuation (x ^ 2 - β * y ^ 2) = WithZero.exp (-1 : ℤ) := by
        rw [sub_eq_add_neg, Valuation.map_add_of_distinct_val v.intValuation (ne_of_lt hlt),
          max_eq_right (le_of_lt hlt), hβy_val]
      refine ⟨hδ_val, ?_, hα_eq1⟩
      change (-WithZero.log (v.intValuation (x ^ 2 - β * y ^ 2))).toNat = 1
      rw [hδ_val, WithZero.log_exp]
      omega
    have hδ_ne : x ^ 2 - β * y ^ 2 ≠ 0 := by
      obtain ⟨v₀, hv₀⟩ := hB₂
      intro h0
      have hval0 := (hB₂_val v₀ hv₀).1
      rw [h0, map_zero] at hval0
      exact WithZero.exp_ne_zero hval0.symm
    have hP_δ : ∀ w ∈ P, x ^ 2 - β * y ^ 2 ∉ w.asIdeal := by
      intro w hwP hδ_mem
      have hy_mem : y ∈ w.asIdeal :=
        (Ideal.prod_le_inf.trans (Finset.inf_le hwP)) hyP
      have h_id : (1 : R) = (x ^ 2 - β * y ^ 2) + y * (2 * x + y + β * y) := by
        calc (1 : R) = (x + y) ^ 2 := by rw [hxy, one_pow]
        _ = (x ^ 2 - β * y ^ 2) + y * (2 * x + y + β * y) := by ring
      have h1_mem : (1 : R) ∈ w.asIdeal := by
        rw [h_id]
        exact w.asIdeal.add_mem hδ_mem (w.asIdeal.mul_mem_right (2 * x + y + β * y) hy_mem)
      exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_mem)
    let γ₀ : R := α * (x ^ 2 - β * y ^ 2)
    have hγ₀ : γ₀ ≠ 0 := mul_ne_zero hα hδ_ne
    obtain ⟨α', s, t, hα', hs, ht, h_eq, hP_st, hB₂_α'⟩ :=
      exists_clear_finset P B_2 hB2_P γ₀ hγ₀
    refine ⟨α', x, y, s, t, hα', hδ_ne, hs, ht, h_eq, ?_, ?_⟩
    · intro v ⟨hα'_mem, hβ_mem⟩
      by_cases hvB : v ∈ B_2
      · have hval_γ₀ : valNat v γ₀ = 2 := by
          dsimp [γ₀]
          rw [valNat_mul v α (x ^ 2 - β * y ^ 2) hα hδ_ne,
            (hB₂_val v hvB).2.2, (hB₂_val v hvB).2.1]
        have hpar : valNat v α' % 2 = valNat v γ₀ % 2 :=
          valNat_mod_two_eq_of_mul_sq v γ₀ α' s t hγ₀ hα' hs ht h_eq
        have hle1 : valNat v α' ≤ 1 := hB₂_α' v hvB
        have h0 : valNat v α' = 0 := by omega
        exact not_mem_asIdeal_of_valNat_eq_zero v α' hα' h0 hα'_mem
      · have hvFβ : v ∈ F_β := hfin_β.mem_toFinset.mpr hβ_mem
        have hvP : v ∈ P :=
          Finset.mem_sdiff.mpr ⟨Finset.mem_union.mpr (Or.inr hvFβ), hvB⟩
        have hα_not : α ∉ v.asIdeal := by
          intro hα_mem
          by_cases h2v : (2 : R) ∈ v.asIdeal
          · exact hvB (Finset.mem_filter.mpr
              ⟨hfin_2.mem_toFinset.mpr h2v, hα_mem, hβ_mem⟩)
          · exact h_strict_coprime v h2v ⟨hα_mem, hβ_mem⟩
        have hδ_not : x ^ 2 - β * y ^ 2 ∉ v.asIdeal := hP_δ v hvP
        have hs_not : s ∉ v.asIdeal := (hP_st v hvP).1
        have h_lhs_mem : α * (x ^ 2 - β * y ^ 2) * s ^ 2 ∈ v.asIdeal := by
          change γ₀ * s ^ 2 ∈ v.asIdeal
          rw [h_eq]
          exact v.asIdeal.mul_mem_right (t ^ 2) hα'_mem
        rcases v.isPrime.mem_or_mem h_lhs_mem with hγ₀_m | hs2_m
        · rcases v.isPrime.mem_or_mem hγ₀_m with hα_m | hδ_m
          · exact hα_not hα_m
          · exact hδ_not hδ_m
        · exact hs_not (v.isPrime.mem_of_pow_mem 2 hs2_m)
    · intro v h2v
      refine ⟨?_, (h_sqfree v h2v).2⟩
      by_cases hvB : v ∈ B_2
      · exact hB₂_α' v hvB
      · have hvF2 : v ∈ F_2 := hfin_2.mem_toFinset.mpr h2v
        have hvP : v ∈ P :=
          Finset.mem_sdiff.mpr ⟨Finset.mem_union.mpr (Or.inl hvF2), hvB⟩
        obtain ⟨hs_not, ht_not⟩ := hP_st v hvP
        have hs2_not : s ^ 2 ∉ v.asIdeal :=
          fun hm => hs_not (v.isPrime.mem_of_pow_mem 2 hm)
        have ht2_not : t ^ 2 ∉ v.asIdeal :=
          fun hm => ht_not (v.isPrime.mem_of_pow_mem 2 hm)
        have hval_δ : valNat v (x ^ 2 - β * y ^ 2) = 0 :=
          valNat_eq_zero_of_not_mem v (x ^ 2 - β * y ^ 2) (hP_δ v hvP)
        have hval_s2 : valNat v (s ^ 2) = 0 :=
          valNat_eq_zero_of_not_mem v (s ^ 2) hs2_not
        have hval_t2 : valNat v (t ^ 2) = 0 :=
          valNat_eq_zero_of_not_mem v (t ^ 2) ht2_not
        have hs2_ne : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
        have ht2_ne : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
        have hval_eq : valNat v α + valNat v (x ^ 2 - β * y ^ 2) + valNat v (s ^ 2) =
            valNat v α' + valNat v (t ^ 2) := by
          rw [← valNat_mul v α (x ^ 2 - β * y ^ 2) hα hδ_ne,
            ← valNat_mul v γ₀ (s ^ 2) hγ₀ hs2_ne, h_eq,
            valNat_mul v α' (t ^ 2) hα' ht2_ne]
        have hα_le1 : valNat v α ≤ 1 := (h_sqfree v h2v).1
        omega
  · refine ⟨α, 1, 0, 1, 1, hα, ?_, one_ne_zero, one_ne_zero, by ring, ?_, h_sqfree⟩
    · have h1 : (1 : R) ^ 2 - β * 0 ^ 2 = 1 := by ring
      rw [h1]
      exact one_ne_zero
    · intro v ⟨hα_mem, hβ_mem⟩
      by_cases h2v : (2 : R) ∈ v.asIdeal
      · have hvB : v ∈ B_2 := Finset.mem_filter.mpr
          ⟨hfin_2.mem_toFinset.mpr h2v, hα_mem, hβ_mem⟩
        exact hB₂ ⟨v, hvB⟩
      · exact h_strict_coprime v h2v ⟨hα_mem, hβ_mem⟩

theorem resDyadicProd_eq_unitDyadicProd_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    resDyadicProd α β = unitDyadicProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-(valNat v γ : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v γ : ℤ) = -WithZero.log (v.intValuation γ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have valNat_pos_of_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ≠ 0 → γ ∈ v.asIdeal → 1 ≤ valNat v γ := by
    intro v γ hγ hγ_mem
    have h_lt : v.intValuation γ < 1 := (v.intValuation_lt_one_iff_mem γ).mpr hγ_mem
    rw [intValuation_eq_exp_neg_valNat v γ hγ, ← WithZero.exp_zero, WithZero.exp_lt_exp] at h_lt
    omega
  have mem_of_mul_sq_mem_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ w : R),
        γ ≠ 0 → valNat v γ ≤ 1 → γ * w ^ 2 ∈ v.asIdeal ^ 2 → w ∈ v.asIdeal := by
    intro v γ w hγ hγ_le h_mem
    by_contra hw
    have hw_val : v.intValuation w = 1 := v.intValuation_eq_one_iff.mpr hw
    have h_le2 : v.intValuation (γ * w ^ 2) ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
      (v.intValuation_le_pow_iff_mem (γ * w ^ 2) 2).mpr h_mem
    rw [map_mul, map_pow, hw_val, one_pow, mul_one,
      intValuation_eq_exp_neg_valNat v γ hγ, WithZero.exp_le_exp] at h_le2
    omega
  have unit_dichotomy :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (x y z : R),
        (2 : R) ∈ v.asIdeal →
        ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) →
        x ^ 2 - β * y ^ 2 - α * z ^ 2 ∈ v.asIdeal ^ (2 * valNat v (2 : R) + 1) →
        x ∉ v.asIdeal ∨ β * y ∉ v.asIdeal := by
    intro v x y z h2v h_prim hr
    by_contra h_not
    push_neg at h_not
    rcases h_not with ⟨hx, hβy⟩
    let e : ℕ := valNat v (2 : R)
    have he_pos : 1 ≤ e := valNat_pos_of_mem v (2 : R) two_ne_zero h2v
    let r : R := x ^ 2 - β * y ^ 2 - α * z ^ 2
    have hr2 : r ∈ v.asIdeal ^ 2 :=
      Ideal.pow_le_pow_right (by omega : 2 ≤ 2 * e + 1) hr
    have hx2 : x ^ 2 ∈ v.asIdeal ^ 2 := by
      rw [sq, sq]; exact Ideal.mul_mem_mul hx hx
    have h_sum2 : β * y ^ 2 + α * z ^ 2 ∈ v.asIdeal ^ 2 := by
      have hid : β * y ^ 2 + α * z ^ 2 = x ^ 2 - r := by dsimp [r]; ring
      rw [hid]
      exact (v.asIdeal ^ 2).sub_mem hx2 hr2
    have h_sum1 : β * y ^ 2 + α * z ^ 2 ∈ v.asIdeal :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) h_sum2
    have hβy1 : β * y ^ 2 ∈ v.asIdeal := by
      have hid : β * y ^ 2 = (β * y) * y := by ring
      rw [hid]
      exact (v.asIdeal).mul_mem_right y hβy
    have hαz1 : α * z ^ 2 ∈ v.asIdeal := by
      have hid : α * z ^ 2 = (β * y ^ 2 + α * z ^ 2) - β * y ^ 2 := by ring
      rw [hid]
      exact (v.asIdeal).sub_mem h_sum1 hβy1
    obtain ⟨hα_le, hβ_le⟩ := h_sqfree v h2v
    rcases not_and_or.mp (h_all_coprime v) with hα_not | hβ_not
    · have hz2_mem : z ^ 2 ∈ v.asIdeal :=
        (v.isPrime.mem_or_mem hαz1).resolve_left hα_not
      have hz : z ∈ v.asIdeal := by
        rw [sq] at hz2_mem
        exact (v.isPrime.mem_or_mem hz2_mem).elim id id
      have hαz2 : α * z ^ 2 ∈ v.asIdeal ^ 2 := by
        have hz2 : z ^ 2 ∈ v.asIdeal ^ 2 := by rw [sq, sq]; exact Ideal.mul_mem_mul hz hz
        exact (v.asIdeal ^ 2).mul_mem_left α hz2
      have hβy2 : β * y ^ 2 ∈ v.asIdeal ^ 2 := by
        have hid : β * y ^ 2 = (β * y ^ 2 + α * z ^ 2) - α * z ^ 2 := by ring
        rw [hid]
        exact (v.asIdeal ^ 2).sub_mem h_sum2 hαz2
      have hy : y ∈ v.asIdeal := mem_of_mul_sq_mem_sq v β y hβ hβ_le hβy2
      exact h_prim ⟨hx, hy, hz⟩
    · have hy : y ∈ v.asIdeal :=
        (v.isPrime.mem_or_mem hβy).resolve_left hβ_not
      have hβy2 : β * y ^ 2 ∈ v.asIdeal ^ 2 := by
        have hy2 : y ^ 2 ∈ v.asIdeal ^ 2 := by rw [sq, sq]; exact Ideal.mul_mem_mul hy hy
        exact (v.asIdeal ^ 2).mul_mem_left β hy2
      have hαz2 : α * z ^ 2 ∈ v.asIdeal ^ 2 := by
        have hid : α * z ^ 2 = (β * y ^ 2 + α * z ^ 2) - β * y ^ 2 := by ring
        rw [hid]
        exact (v.asIdeal ^ 2).sub_mem h_sum2 hβy2
      have hz : z ∈ v.asIdeal := mem_of_mul_sq_mem_sq v α z hα hα_le hαz2
      exact h_prim ⟨hx, hy, hz⟩
  have exists_cofactor_div_two :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (r : R),
        r ∈ v.asIdeal ^ (2 * valNat v (2 : R) + 1) →
        ∃ s₀ m : R,
          s₀ ∉ v.asIdeal ∧
          r * s₀ = 2 * m ∧
          m ∈ v.asIdeal ∧
          m ^ 2 ∈ v.asIdeal ^ (2 * valNat v (2 : R) + 2) := by
    intro v r hr
    let e : ℕ := valNat v (2 : R)
    have h2_val : v.intValuation (2 : R) = WithZero.exp (-(e : ℤ)) :=
      intValuation_eq_exp_neg_valNat v (2 : R) two_ne_zero
    have h2_dvd : v.asIdeal ^ e ∣ Ideal.span {(2 : R)} :=
      (v.intValuation_le_pow_iff_dvd (2 : R) e).mp (le_of_eq h2_val)
    obtain ⟨J, hJ⟩ := h2_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have h2_mem : (2 : R) ∈ v.asIdeal ^ (e + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have h2_le : v.intValuation (2 : R) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem (2 : R) (e + 1)).mpr h2_mem
      rw [h2_val, WithZero.exp_le_exp] at h2_le
      omega
    obtain ⟨s₀, hs₀J, hs₀v⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hr_e : r ∈ v.asIdeal ^ e :=
      Ideal.pow_le_pow_right (by omega : e ≤ 2 * e + 1) hr
    have hrs₀_span : r * s₀ ∈ Ideal.span {(2 : R)} := by
      rw [hJ]
      exact Ideal.mul_mem_mul hr_e hs₀J
    obtain ⟨m, hm_eq⟩ := Ideal.mem_span_singleton.mp hrs₀_span
    have hs₀_val : v.intValuation s₀ = 1 := v.intValuation_eq_one_iff.mpr hs₀v
    have hr_val : v.intValuation r ≤ WithZero.exp (-((2 * e + 1 : ℕ) : ℤ)) :=
      (v.intValuation_le_pow_iff_mem r (2 * e + 1)).mpr hr
    have hm_val_eq : v.intValuation m = WithZero.exp (e : ℤ) * v.intValuation r := by
      have h_congr := congr_arg v.intValuation hm_eq
      rw [map_mul, map_mul, hs₀_val, mul_one, h2_val] at h_congr
      calc
        v.intValuation m = 1 * v.intValuation m := (one_mul _).symm
        _ = (WithZero.exp (e : ℤ) * WithZero.exp (-(e : ℤ))) * v.intValuation m := by
          rw [← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
        _ = WithZero.exp (e : ℤ) * (WithZero.exp (-(e : ℤ)) * v.intValuation m) := by
          rw [mul_assoc]
        _ = WithZero.exp (e : ℤ) * v.intValuation r := by rw [← h_congr]
    have hm_val_le : v.intValuation m ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) := by
      rw [hm_val_eq]
      refine (mul_le_mul' le_rfl hr_val).trans ?_
      rw [← WithZero.exp_add, WithZero.exp_le_exp]
      omega
    have hm_mem_e1 : m ∈ v.asIdeal ^ (e + 1) :=
      (v.intValuation_le_pow_iff_mem m (e + 1)).mp hm_val_le
    have hm_mem : m ∈ v.asIdeal :=
      Ideal.pow_le_self (by omega : e + 1 ≠ 0) hm_mem_e1
    have hm2_val_le : v.intValuation (m ^ 2) ≤ WithZero.exp (-((2 * e + 2 : ℕ) : ℤ)) := by
      rw [sq, map_mul]
      refine (mul_le_mul' hm_val_le hm_val_le).trans ?_
      rw [← WithZero.exp_add, WithZero.exp_le_exp]
      omega
    have hm2_mem : m ^ 2 ∈ v.asIdeal ^ (2 * e + 2) :=
      (v.intValuation_le_pow_iff_mem (m ^ 2) (2 * e + 2)).mp hm2_val_le
    exact ⟨s₀, m, hs₀v, hm_eq, hm_mem, hm2_mem⟩
  have resDyadic_iff_unitDyadic :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R),
        (2 : R) ∈ v.asIdeal →
        ((∃ x y z : R,
            ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
            x ^ 2 - β * y ^ 2 - α * z ^ 2 ∈
              v.asIdeal ^ (2 * valNat v (2 : R) + 2)) ↔
         (∃ x y z : R,
            ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
            x ^ 2 - β * y ^ 2 - α * z ^ 2 ∈
              v.asIdeal ^ (2 * valNat v (2 : R) + 1))) := by
    intro v h2v
    let e : ℕ := valNat v (2 : R)
    constructor
    · rintro ⟨x, y, z, h_prim, hr⟩
      exact ⟨x, y, z, h_prim, Ideal.pow_le_pow_right (by omega : 2 * e + 1 ≤ 2 * e + 2) hr⟩
    · rintro ⟨x, y, z, h_prim, hr⟩
      let r : R := x ^ 2 - β * y ^ 2 - α * z ^ 2
      obtain ⟨s₀, m, hs₀v, hm_eq, hm_mem, hm2_mem⟩ := exists_cofactor_div_two v r hr
      rcases unit_dichotomy v x y z h2v h_prim hr with hx | hβy
      · let u : R := x * s₀
        refine ⟨u * x - m, u * y, u * z, ?_, ?_⟩
        · rintro ⟨hX, _, _⟩
          have hux : x * (s₀ * x) ∈ v.asIdeal := by
            have hid : x * (s₀ * x) = (u * x - m) + m := by dsimp [u]; ring
            rw [hid]
            exact (v.asIdeal).add_mem hX hm_mem
          have hs₀x : s₀ * x ∈ v.asIdeal := (v.isPrime.mem_or_mem hux).resolve_left hx
          have hx_mem : x ∈ v.asIdeal := (v.isPrime.mem_or_mem hs₀x).resolve_left hs₀v
          exact hx hx_mem
        · have h_id : (u * x - m) ^ 2 - β * (u * y) ^ 2 - α * (u * z) ^ 2 = m ^ 2 := by
            dsimp [u, r] at hm_eq ⊢
            linear_combination x ^ 2 * s₀ * hm_eq
          rw [h_id]
          exact hm2_mem
      · let u : R := β * y * s₀
        refine ⟨u * x, u * y + m, u * z, ?_, ?_⟩
        · rintro ⟨_, hY, _⟩
          have huy : (β * y) * (s₀ * y) ∈ v.asIdeal := by
            have hid : (β * y) * (s₀ * y) = (u * y + m) - m := by dsimp [u]; ring
            rw [hid]
            exact (v.asIdeal).sub_mem hY hm_mem
          have hs₀y : s₀ * y ∈ v.asIdeal := (v.isPrime.mem_or_mem huy).resolve_left hβy
          have hy_mem : y ∈ v.asIdeal := (v.isPrime.mem_or_mem hs₀y).resolve_left hs₀v
          exact hβy ((v.asIdeal).mul_mem_left β hy_mem)
        · have h_id : (u * x) ^ 2 - β * (u * y + m) ^ 2 - α * (u * z) ^ 2 = -(β * m ^ 2) := by
            dsimp [u, r] at hm_eq ⊢
            linear_combination (β * y) ^ 2 * s₀ * hm_eq
          rw [h_id]
          exact (v.asIdeal ^ (2 * e + 2)).neg_mem
            ((v.asIdeal ^ (2 * e + 2)).mul_mem_left β hm2_mem)
  letI := Classical.propDecidable
  dsimp only [resDyadicProd, unitDyadicProd]
  refine finprod_congr (fun v => ?_)
  by_cases h2v : (2 : R) ∈ v.asIdeal
  · rw [if_pos h2v, if_pos h2v]
    dsimp only [resDyadicSym, unitDyadicSym]
    exact if_congr (resDyadic_iff_unitDyadic v h2v) rfl rfl
  · rw [if_neg h2v, if_neg h2v]

theorem oddPowResQuadProd_eq_oddPowGaussProd_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal)) :
    oddPowResQuadProd α β = oddPowGaussProd α β :=
by
  letI := Classical.propDecidable
  dsimp [oddPowResQuadProd, oddPowGaussProd]
  refine finprod_congr (fun v => ?_)
  by_cases hv : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal
  · rw [if_pos hv, if_pos hv]
    congr 1
    dsimp [resQuadSym, oddGaussSym]
    refine if_congr ?_ rfl rfl
    letI := Classical.decEq (NumberField.RingOfIntegers K ⧸ v.asIdeal)
    letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    letI : Fintype (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ v.asIdeal)
    let χ : MulChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ℂ :=
      (quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal)).ringHomComp (Int.castRingHom ℂ)
    let ψ : AddChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ℂ :=
      AddChar.FiniteField.primitiveChar_to_Complex (NumberField.RingOfIntegers K ⧸ v.asIdeal)
    have hβ_not : β ∉ v.asIdeal := fun hβ => h_all_coprime v ⟨hv.2, hβ⟩
    have hb_ne : Ideal.Quotient.mk v.asIdeal β ≠ 0 :=
      (Ideal.Quotient.eq_zero_iff_mem).not.mpr hβ_not
    let u : (NumberField.RingOfIntegers K ⧸ v.asIdeal)ˣ :=
      Units.mk0 (Ideal.Quotient.mk v.asIdeal β) hb_ne
    have h_shift : χ (u : NumberField.RingOfIntegers K ⧸ v.asIdeal) * oddLocalGaussSum v β =
        oddLocalGaussSum v 1 := by
      dsimp [oddLocalGaussSum]
      rw [map_one, AddChar.mulShift_one]
      exact gaussSum_mulShift χ ψ u
    have h_char : ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ≠ 2 := by
      intro h2
      apply hv.1
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have hcast := CharP.cast_eq_zero (NumberField.RingOfIntegers K ⧸ v.asIdeal)
        (ringChar (NumberField.RingOfIntegers K ⧸ v.asIdeal))
      rw [h2] at hcast
      exact_mod_cast hcast
    have hχ_ne : χ ≠ 1 := by
      intro h1
      have hq : quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ≠ 1 :=
        quadraticChar_ne_one h_char
      apply hq
      ext x
      have hx : χ x = (1 : MulChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ℂ) x := by
        rw [h1]
      dsimp [χ] at hx
      rw [MulChar.one_apply x.isUnit] at hx ⊢
      exact_mod_cast hx
    have hχ_quad : χ.IsQuadratic :=
      (quadraticChar_isQuadratic (NumberField.RingOfIntegers K ⧸ v.asIdeal)).comp
        (Int.castRingHom ℂ)
    have hψ_prim : ψ.IsPrimitive :=
      AddChar.FiniteField.primitiveChar_to_Complex_isPrimitive
        (NumberField.RingOfIntegers K ⧸ v.asIdeal)
    have h_sq := gaussSum_sq hχ_ne hχ_quad hψ_prim
    have hg_ne : oddLocalGaussSum v 1 ≠ 0 := by
      dsimp [oddLocalGaussSum]
      rw [map_one, AddChar.mulShift_one]
      intro hg0
      rw [hg0, sq, zero_mul] at h_sq
      have hcard : (Fintype.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr Fintype.card_ne_zero
      have hχ_neg1 : χ (-1) ≠ 0 := by
        dsimp [χ]
        have hq_neg1 : quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) (-1) ≠ 0 := by
          intro h0
          rw [quadraticChar_eq_zero_iff] at h0
          exact neg_ne_zero.mpr one_ne_zero h0
        exact_mod_cast hq_neg1
      exact mul_ne_zero hχ_neg1 hcard h_sq.symm
    have h_iff1 : IsSquare (Ideal.Quotient.mk v.asIdeal β) ↔
        quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) (Ideal.Quotient.mk v.asIdeal β) = 1 :=
      (quadraticChar_one_iff_isSquare hb_ne).symm
    have h_iff2 : quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) (Ideal.Quotient.mk v.asIdeal β) = 1 ↔
        χ (u : NumberField.RingOfIntegers K ⧸ v.asIdeal) = 1 := by
      dsimp [χ, u]
      exact ⟨fun h => by exact_mod_cast h, fun h => by exact_mod_cast h⟩
    have h_iff3 : χ (u : NumberField.RingOfIntegers K ⧸ v.asIdeal) = 1 ↔
        oddLocalGaussSum v β = oddLocalGaussSum v 1 := by
      constructor
      · intro h1
        rw [← h_shift, h1, one_mul]
      · intro heq
        rw [heq] at h_shift
        exact mul_right_cancel₀ hg_ne (h_shift.trans (one_mul _).symm)
    exact h_iff1.trans (h_iff2.trans h_iff3)
  · rw [if_neg hv, if_neg hv]

theorem localDyadicPfisterProd_eq_localDyadicBinaryGaussSum {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) :
    localDyadicPfisterProd v α β =
      localDyadicBinaryGaussSum v 1 β * starRingEnd ℂ (localDyadicBinaryGaussSum v α β) ∧
    localDyadicPfisterProd v α β = localDyadicPfisterProd v β α ∧
    unitDyadicSym v α β = unitDyadicSym v β α :=
by
  letI := Classical.propDecidable
  have h_neg : ∀ γ : NumberField.RingOfIntegers K,
      localDyadicTraceGaussSum v (-γ) = starRingEnd ℂ (localDyadicTraceGaussSum v γ) := by
    intro γ
    dsimp only [localDyadicTraceGaussSum]
    by_cases hIv : v.asIdeal ^ valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K) ≠ ⊥
    · rw [dif_pos hIv, dif_pos hIv, map_sum]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      rw [← Complex.exp_conj]
      congr 1
      have h_tr : Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localDyadicIdempotent v * -γ * (Quotient.out x) ^ 2) =
        -Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localDyadicIdempotent v * γ * (Quotient.out x) ^ 2) := by
        rw [← map_neg]
        congr 1
        ring
      rw [h_tr, Int.cast_neg]
      simp only [map_div₀, map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I,
        map_intCast, map_natCast]
      ring
    · rw [dif_neg hIv, dif_neg hIv, map_zero]
  refine ⟨?_, ?_, ?_⟩
  · dsimp only [localDyadicPfisterProd, localDyadicBinaryGaussSum]
    have h1 : (-1 : NumberField.RingOfIntegers K) * β = -β := neg_one_mul β
    have h2 : -(-α * β) = α * β := by ring
    rw [h1, map_mul, ← h_neg α, ← h_neg (-α * β), h2]
    ring
  · dsimp only [localDyadicPfisterProd]
    rw [mul_comm α β]
    ring
  · dsimp only [unitDyadicSym]
    refine if_congr ?_ rfl rfl
    constructor
    · rintro ⟨x, y, z, hnot, hmem⟩
      refine ⟨x, z, y, ?_, ?_⟩
      · intro ⟨hx, hz, hy⟩
        exact hnot ⟨hx, hy, hz⟩
      · convert hmem using 1
        ring
    · rintro ⟨x, y, z, hnot, hmem⟩
      refine ⟨x, z, y, ?_, ?_⟩
      · intro ⟨hx, hz, hy⟩
        exact hnot ⟨hx, hy, hz⟩
      · convert hmem using 1
        ring

theorem dyadicPfisterGaussSum_eq_re_finprod_local {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) :
    haveI := Classical.propDecidable
    dyadicPfisterGaussSum α β =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          localDyadicPfisterProd v α β
        else 1).re :=
by
  letI := Classical.propDecidable
  let R := NumberField.RingOfIntegers K
  let M : ℕ := dyadicGaussModulus K
  let I : Ideal R := Ideal.span {((M : ℕ) : R)}
  let Iv : IsDedekindDomain.HeightOneSpectrum R → Ideal R :=
    fun v => v.asIdeal ^ (valNat v ((M : ℕ) : R))
  
  let b := Module.Free.chooseBasis ℤ R
  let n := Fintype.card (Module.Free.ChooseBasisIndex ℤ R)
  have h_norm : Algebra.norm ℤ (2 : R) = (2 : ℤ) ^ n := by
    have h2 : (2 : R) = algebraMap ℤ R (2 : ℤ) := by simp
    rw [h2, Algebra.norm_algebraMap_of_basis b (2 : ℤ)]
  have h_abs : (Algebra.norm ℤ (2 : R)).natAbs = 2 ^ n := by
    rw [h_norm, Int.natAbs_pow]
    rfl
  have hM_eq : dyadicGaussModulus K = 2 ^ (2 * n + 3) := by
    dsimp [dyadicGaussModulus]
    rw [h_abs]
    calc 8 * (2 ^ n) ^ 2 = 2 ^ 3 * 2 ^ (n * 2) := by rw [← pow_mul]; rfl
      _ = 2 ^ (2 * n + 3) := by rw [← pow_add]; ring_nf
  have hM_ne : M ≠ 0 := by
    change dyadicGaussModulus K ≠ 0
    rw [hM_eq]
    exact pow_ne_zero (2 * n + 3) two_ne_zero
  have h2R_ne : (2 : R) ≠ 0 := two_ne_zero
  have hMR_eq : ((M : ℕ) : R) = (2 : R) ^ (2 * n + 3) := by
    change ((dyadicGaussModulus K : ℕ) : R) = (2 : R) ^ (2 * n + 3)
    rw [hM_eq, Nat.cast_pow, Nat.cast_ofNat]
  have hMR_ne : ((M : ℕ) : R) ≠ 0 := by
    rw [hMR_eq]
    exact pow_ne_zero (2 * n + 3) h2R_ne
  have hval0 : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      (2 : R) ∉ v.asIdeal → valNat v ((M : ℕ) : R) = 0 := by
    intro v h2v
    have hMv : ((M : ℕ) : R) ∉ v.asIdeal := by
      rw [hMR_eq]
      exact fun hm => h2v (v.isPrime.mem_of_pow_mem (2 * n + 3) hm)
    have hval1 : v.intValuation ((M : ℕ) : R) = 1 :=
      v.intValuation_eq_one_iff.mpr hMv
    dsimp [valNat]
    rw [hval1, WithZero.log_one]
    rfl
  
  have hI2 : (Ideal.span {(2 : R)} : Ideal R) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact h2R_ne
  have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum R | (2 : R) ∈ v.asIdeal}.Finite := by
    refine (Ideal.finite_factors hI2).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  let S : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin2.toFinset
  have hS : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      v ∉ S → valNat v ((M : ℕ) : R) = 0 := by
    intro v hvS
    have h2v : (2 : R) ∉ v.asIdeal := fun h2 => hvS (hfin2.mem_toFinset.mpr h2)
    exact hval0 v h2v
  
  have hI0 : I ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hMR_ne
  have hI : I ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact hMR_ne
  have h_maxPow : ∀ v : IsDedekindDomain.HeightOneSpectrum R, v.maxPowDividing I = Iv v := by
    intro v
    dsimp [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, Iv, valNat]
    rw [v.intValuation_def, if_neg hMR_ne, WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have h_supp : Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum R => v.maxPowDividing I) ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport, h_maxPow] at hv
    by_contra hvS
    have h0 : valNat v ((M : ℕ) : R) = 0 := hS v hvS
    apply hv
    dsimp [Iv]
    rw [h0, pow_zero]
  have hI_prod : I = ∏ v ∈ S, Iv v := by
    calc I = ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R, v.maxPowDividing I :=
          (Ideal.finprod_heightOneSpectrum_factorization hI0).symm
      _ = ∏ v ∈ S, v.maxPowDividing I :=
          finprod_eq_prod_of_mulSupport_subset _ h_supp
      _ = ∏ v ∈ S, Iv v := Finset.prod_congr rfl (fun v _ => h_maxPow v)
  have hI_inf : I = S.inf Iv := by
    rw [hI_prod]
    symm
    refine IsDedekindDomain.inf_prime_pow_eq_prod S (fun v => v.asIdeal)
      (fun v => valNat v ((M : ℕ) : R)) (fun v _ => v.prime) ?_
    intro u _ v _ huv h_eq
    exact huv (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
  have h_inf : I = ⨅ i : S, Iv i.1 := by
    rw [hI_inf, Finset.inf_eq_iInf, iInf_subtype]
  have h_cop_pair : ∀ u v : IsDedekindDomain.HeightOneSpectrum R, u ≠ v → IsCoprime (Iv u) (Iv v) := by
    intro u v huv
    have h_ne : u.asIdeal ≠ v.asIdeal := fun h_eq => huv (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
    exact (Ideal.isCoprime_of_isMaximal h_ne).pow
  have h_cop : Pairwise (Function.onFun IsCoprime (fun i : S => Iv i.1)) := by
    intro i j hij
    exact h_cop_pair i.1 j.1 (Subtype.ext_iff.not.mp hij)
  have h_idem : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      IsLocalDyadicIdempotent v (localDyadicIdempotent v) := by
    intro v
    have h_ex : ∃ e : R, IsLocalDyadicIdempotent v e := by
      by_cases hvS : v ∈ S
      · have hI_split : I = Iv v * ∏ u ∈ S.erase v, Iv u := by
          rw [hI_prod, ← Finset.mul_prod_erase S Iv hvS]
        have h_cop_prod : IsCoprime (Iv v) (∏ u ∈ S.erase v, Iv u) := by
          refine IsCoprime.prod_right (fun u hu => ?_)
          exact h_cop_pair v u (Finset.ne_of_mem_erase hu).symm
        obtain ⟨a, ha, e, he, hae⟩ := Ideal.isCoprime_iff_exists.mp h_cop_prod
        refine ⟨e, ?_, ?_⟩
        · have h1e : 1 - e = a := by linear_combination hae.symm
          rw [h1e]
          exact ha
        · intro y hy
          change e * y ∈ I
          rw [hI_split, mul_comm e y]
          exact Ideal.mul_mem_mul hy he
      · refine ⟨0, ?_, ?_⟩
        · have h0 : valNat v ((M : ℕ) : R) = 0 := hS v hvS
          change 1 - (0 : R) ∈ v.asIdeal ^ (valNat v ((M : ℕ) : R))
          rw [h0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · intro y _
          rw [zero_mul]
          exact I.zero_mem
    dsimp [localDyadicIdempotent]
    rw [dif_pos h_ex]
    exact Classical.choose_spec h_ex
  have h_sum : (1 : R) - (∑ v ∈ S, localDyadicIdempotent v) ∈ I := by
    rw [hI_inf, Submodule.mem_finsetInf]
    intro v hv
    rw [← Finset.add_sum_erase S (fun u => localDyadicIdempotent u) hv]
    have h_eq : (1 : R) - (localDyadicIdempotent v + ∑ u ∈ S.erase v, localDyadicIdempotent u) =
        (1 - localDyadicIdempotent v) - ∑ u ∈ S.erase v, localDyadicIdempotent u := by ring
    rw [h_eq]
    refine (Iv v).sub_mem (h_idem v).1 ((Iv v).sum_mem (fun u hu => ?_))
    have huv : u ≠ v := Finset.ne_of_mem_erase hu
    obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.mp (h_cop_pair u v huv)
    have heu : localDyadicIdempotent u = localDyadicIdempotent u * a + localDyadicIdempotent u * b := by
      calc localDyadicIdempotent u = localDyadicIdempotent u * 1 := (mul_one _).symm
        _ = localDyadicIdempotent u * (a + b) := by rw [hab]
        _ = localDyadicIdempotent u * a + localDyadicIdempotent u * b := mul_add _ _ _
    rw [heu]
    have hea : localDyadicIdempotent u * a ∈ Iv v := by
      have h_in_I : localDyadicIdempotent u * a ∈ I := (h_idem u).2 a ha
      rw [hI_inf, Submodule.mem_finsetInf] at h_in_I
      exact h_in_I v hv
    have heb : localDyadicIdempotent u * b ∈ Iv v := (Iv v).mul_mem_left _ hb
    exact (Iv v).add_mem hea heb
  
  have h_exp : ∀ (γ x : R) (y : IsDedekindDomain.HeightOneSpectrum R → R),
      (∀ v ∈ S, x - y v ∈ Iv v) →
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (γ * x ^ 2) : ℤ) : ℂ) / (M : ℂ)) =
      ∏ v ∈ S, Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (localDyadicIdempotent v * γ * (y v) ^ 2) : ℤ) : ℂ) / (M : ℂ)) := by
    intro γ x y hy
    have h_mem : γ * x ^ 2 - ∑ v ∈ S, localDyadicIdempotent v * γ * (y v) ^ 2 ∈ I := by
      have h_alg : γ * x ^ 2 - ∑ v ∈ S, localDyadicIdempotent v * γ * (y v) ^ 2 =
          ((1 : R) - ∑ v ∈ S, localDyadicIdempotent v) * (γ * x ^ 2) +
          ∑ v ∈ S, localDyadicIdempotent v * (γ * (x + y v) * (x - y v)) := by
        have h1 : ((1 : R) - ∑ v ∈ S, localDyadicIdempotent v) * (γ * x ^ 2) =
            γ * x ^ 2 - ∑ v ∈ S, localDyadicIdempotent v * (γ * x ^ 2) := by
          rw [sub_mul, one_mul, Finset.sum_mul]
        have h2 : ∑ v ∈ S, localDyadicIdempotent v * (γ * (x + y v) * (x - y v)) =
            (∑ v ∈ S, localDyadicIdempotent v * (γ * x ^ 2)) -
            ∑ v ∈ S, localDyadicIdempotent v * γ * (y v) ^ 2 := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun v _ => ?_)
          ring
        rw [h1, h2]
        ring
      rw [h_alg]
      refine I.add_mem (I.mul_mem_right (γ * x ^ 2) h_sum) (I.sum_mem (fun v hv => ?_))
      have h_diff_in : γ * (x + y v) * (x - y v) ∈ Iv v :=
        (Iv v).mul_mem_left (γ * (x + y v)) (hy v hv)
      exact (h_idem v).2 _ h_diff_in
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp h_mem
    have h_tr : Algebra.trace ℤ R (γ * x ^ 2) =
        (∑ v ∈ S, Algebra.trace ℤ R (localDyadicIdempotent v * γ * (y v) ^ 2)) +
        (M : ℤ) * Algebra.trace ℤ R q := by
      have hq' : γ * x ^ 2 = (∑ v ∈ S, localDyadicIdempotent v * γ * (y v) ^ 2) + M • q := by
        rw [nsmul_eq_mul]
        linear_combination hq
      calc Algebra.trace ℤ R (γ * x ^ 2)
        _ = Algebra.trace ℤ R ((∑ v ∈ S, localDyadicIdempotent v * γ * (y v) ^ 2) + M • q) := by
            rw [hq']
        _ = (∑ v ∈ S, Algebra.trace ℤ R (localDyadicIdempotent v * γ * (y v) ^ 2)) +
            (M : ℤ) * Algebra.trace ℤ R q := by
            rw [map_add, map_sum, map_nsmul, nsmul_eq_mul]
    let T0 : ℤ := ∑ v ∈ S, Algebra.trace ℤ R (localDyadicIdempotent v * γ * (y v) ^ 2)
    let k : ℤ := Algebra.trace ℤ R q
    have hMC : (M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hM_ne
    have h_arg : 2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (γ * x ^ 2) : ℤ) : ℂ) / (M : ℂ) =
        2 * Real.pi * Complex.I * (T0 : ℂ) / (M : ℂ) +
        (k : ℂ) * (2 * Real.pi * Complex.I) := by
      rw [h_tr]
      change 2 * Real.pi * Complex.I * (((T0 + (M : ℤ) * k : ℤ) : ℂ)) / (M : ℂ) = _
      push_cast
      field_simp [hMC]
    rw [h_arg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I k, mul_one]
    have h_sum_arg : 2 * Real.pi * Complex.I * (T0 : ℂ) / (M : ℂ) =
        ∑ v ∈ S, 2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (localDyadicIdempotent v * γ * (y v) ^ 2) : ℤ) : ℂ) / (M : ℂ) := by
      dsimp [T0]
      rw [Int.cast_sum, Finset.mul_sum, Finset.sum_div]
    rw [h_sum_arg, Complex.exp_sum]
  
  have h_trace : ∀ γ : R, dyadicTraceGaussSum γ = ∏ v ∈ S, localDyadicTraceGaussSum v γ := by
    intro γ
    have hIv : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Iv v ≠ ⊥ :=
      fun v => pow_ne_zero _ v.ne_bot
    haveI : Finite (R ⧸ I) := Ideal.finiteQuotientOfFreeOfNeBot I hI
    letI : Fintype (R ⧸ I) := Fintype.ofFinite (R ⧸ I)
    haveI : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Finite (R ⧸ Iv v) :=
      fun v => Ideal.finiteQuotientOfFreeOfNeBot (Iv v) (hIv v)
    letI : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Fintype (R ⧸ Iv v) :=
      fun v => Fintype.ofFinite (R ⧸ Iv v)
    let f : S → Ideal R := fun i => Iv i.1
    let e_crt : (R ⧸ I) ≃ ((i : S) → R ⧸ f i) :=
      (Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf).toEquiv.trans
        (Ideal.quotientInfRingEquivPiQuotient f h_cop).toEquiv
    have h_out : ∀ (x : R ⧸ I) (i : S),
        Quotient.out x - Quotient.out (e_crt x i) ∈ f i := by
      intro x i
      have h_eval : e_crt x i = Ideal.Quotient.mk (f i) (Quotient.out x) := by
        change (Ideal.quotientInfRingEquivPiQuotient f h_cop)
          ((Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf) x) i = _
        have h_sub : (Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf) x =
            Ideal.Quotient.mk (⨅ i : S, f i) (Quotient.out x) := by
          conv_lhs => rw [← Ideal.Quotient.mk_out x, ← Ideal.Quotient.mk_eq_mk]
          rw [Submodule.quotEquivOfEq_mk, Ideal.Quotient.mk_eq_mk]
        rw [h_sub]
        exact Ideal.quotientInfToPiQuotient_mk' f (Quotient.out x) i
      have h_mk : Ideal.Quotient.mk (f i) (Quotient.out x) =
          Ideal.Quotient.mk (f i) (Quotient.out (e_crt x i)) := by
        rw [← h_eval, Ideal.Quotient.mk_out]
      exact Ideal.Quotient.eq.mp h_mk
    let ψ : ∀ v : IsDedekindDomain.HeightOneSpectrum R, (R ⧸ Iv v) → ℂ :=
      fun v w => Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (localDyadicIdempotent v * γ * (Quotient.out w) ^ 2) : ℤ) : ℂ) /
        (M : ℂ))
    have h_global : dyadicTraceGaussSum γ =
        ∑ x : R ⧸ I, ∏ i : S, ψ i.1 (e_crt x i) := by
      dsimp [dyadicTraceGaussSum]
      rw [dif_pos hI]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      let y : IsDedekindDomain.HeightOneSpectrum R → R :=
        fun v => if hv : v ∈ S then Quotient.out (e_crt x ⟨v, hv⟩) else 0
      have hy : ∀ v ∈ S, Quotient.out x - y v ∈ Iv v := by
        intro v hv
        dsimp [y]
        rw [dif_pos hv]
        exact h_out x ⟨v, hv⟩
      rw [h_exp γ (Quotient.out x) y hy]
      rw [← Finset.prod_coe_sort S]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      dsimp [ψ, y]
      rw [if_pos i.2]
    have h_local : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
        localDyadicTraceGaussSum v γ = ∑ w : R ⧸ Iv v, ψ v w := by
      intro v
      dsimp [localDyadicTraceGaussSum]
      rw [dif_pos (hIv v)]
    have h_reidx : (∑ x : R ⧸ I, ∏ i : S, ψ i.1 (e_crt x i)) =
        ∑ z : (i : S) → R ⧸ f i, ∏ i : S, ψ i.1 (z i) :=
      Equiv.sum_comp e_crt (fun z : (i : S) → R ⧸ f i => ∏ i : S, ψ i.1 (z i))
    rw [h_global, h_reidx, ← Fintype.prod_sum (fun (i : S) (w : R ⧸ f i) => ψ i.1 w)]
    rw [← Finset.prod_coe_sort S]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    exact (h_local i.1).symm
  
  have h_pfister_prod :
      dyadicTraceGaussSum (1 : R) * dyadicTraceGaussSum (-α) *
        dyadicTraceGaussSum (-β) * dyadicTraceGaussSum (α * β) =
      ∏ v ∈ S, localDyadicPfisterProd v α β := by
    rw [h_trace (1 : R), h_trace (-α), h_trace (-β), h_trace (α * β)]
    rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    rfl
  let g : IsDedekindDomain.HeightOneSpectrum R → ℂ :=
    fun v => if (2 : R) ∈ v.asIdeal then localDyadicPfisterProd v α β else 1
  have h_supp_g : Function.mulSupport g ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Finset.mem_coe, hfin2.mem_toFinset, Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg hnot)
  have h_finprod_eq : (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R, g v) =
      ∏ v ∈ S, localDyadicPfisterProd v α β := by
    rw [finprod_eq_prod_of_mulSupport_subset g h_supp_g]
    refine Finset.prod_congr rfl (fun v hv => ?_)
    have h2v : (2 : R) ∈ v.asIdeal := hfin2.mem_toFinset.mp hv
    exact if_pos h2v
  dsimp only [dyadicPfisterGaussSum]
  rw [h_pfister_prod, ← h_finprod_eq]

theorem isLocalDyadicIdempotent_and_exists_trace_not_dvd {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal) :
    IsLocalDyadicIdempotent v (localDyadicIdempotent v) ∧
    ∃ w : NumberField.RingOfIntegers K,
      ¬ (((Algebra.norm ℤ (2 : NumberField.RingOfIntegers K)).natAbs ^ 2 : ℤ) ∣
        Algebra.trace ℤ (NumberField.RingOfIntegers K) (localDyadicIdempotent v * w)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let N2 : ℕ := (Algebra.norm ℤ (2 : R)).natAbs
  let L : ℕ := N2 ^ 2
  let M : ℕ := dyadicGaussModulus K
  let I : Ideal R := Ideal.span {(M : R)}
  let kv : ℕ := valNat v (M : R)
  let Iv : Ideal R := v.asIdeal ^ kv
  have h2_ne : (2 : R) ≠ 0 := two_ne_zero
  have hN2_ne : Algebra.norm ℤ (2 : R) ≠ 0 := Algebra.norm_ne_zero_iff.mpr h2_ne
  have hN2_pos : 0 < N2 := Int.natAbs_pos.mpr hN2_ne
  have hM_pos : 0 < M := by
    dsimp [M, dyadicGaussModulus]
    positivity
  have hM_ne : (M : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hM_pos)
  have hM_val : v.intValuation (M : R) = WithZero.exp (-(kv : ℤ)) := by
    have hv_ne : v.intValuation (M : R) ≠ 0 :=
      v.intValuation_ne_zero' ⟨(M : R), mem_nonZeroDivisors_of_ne_zero hM_ne⟩
    have hv_le : v.intValuation (M : R) ≤ 1 := v.intValuation_le_one (M : R)
    have hlog_le : WithZero.log (v.intValuation (M : R)) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (kv : ℤ) = -WithZero.log (v.intValuation (M : R)) := by
      dsimp [kv]
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have h_dvd : Iv ∣ I :=
    (v.intValuation_le_pow_iff_dvd (M : R) kv).mp (le_of_eq hM_val)
  obtain ⟨J, hJ⟩ := h_dvd
  have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
    intro hle
    have hM_mem : (M : R) ∈ v.asIdeal ^ (kv + 1) := by
      rw [pow_succ, ← Ideal.span_singleton_le_iff_mem]
      dsimp [I, Iv] at hJ
      rw [hJ]
      exact Ideal.mul_mono_right hle
    have hM_le : v.intValuation (M : R) ≤ WithZero.exp (-((kv + 1 : ℕ) : ℤ)) :=
      (v.intValuation_le_pow_iff_mem (M : R) (kv + 1)).mpr hM_mem
    rw [hM_val, WithZero.exp_le_exp] at hM_le
    omega
  have h_coprime : IsCoprime Iv J := by
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra h_ne_top
    obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ := Ideal.exists_le_maximal (Iv ⊔ J) h_ne_top
    have hIv_le_𝔪 : v.asIdeal ^ kv ≤ 𝔪 := le_trans le_sup_left h_le_𝔪
    have hJ_le_𝔪 : J ≤ 𝔪 := le_trans le_sup_right h_le_𝔪
    have hv_le_𝔪 : v.asIdeal ≤ 𝔪 := by
      intro z hz
      by_cases hkv : kv = 0
      · exfalso
        rw [hkv, pow_zero, Ideal.one_eq_top, top_le_iff] at hIv_le_𝔪
        exact h𝔪_max.ne_top hIv_le_𝔪
      · exact h𝔪_max.isPrime.mem_of_pow_mem kv (hIv_le_𝔪 (Ideal.pow_mem_pow hz kv))
    have hv_eq_𝔪 : v.asIdeal = 𝔪 := v.isMaximal.eq_of_le h𝔪_max.ne_top hv_le_𝔪
    rw [← hv_eq_𝔪] at hJ_le_𝔪
    exact hJ_not_le hJ_le_𝔪
  obtain ⟨a, haIv, e₀, heJ, hae⟩ := Ideal.isCoprime_iff_exists.mp h_coprime
  have he_ex : ∃ e : R, IsLocalDyadicIdempotent v e := by
    refine ⟨e₀, ?_, ?_⟩
    · have hid : 1 - e₀ = a := by linear_combination -hae
      rw [hid]
      exact haIv
    · intro y hy
      have hey : e₀ * y ∈ Iv * J := by
        rw [mul_comm e₀ y]
        exact Ideal.mul_mem_mul hy heJ
      rw [← hJ] at hey
      exact hey
  have h_idem : IsLocalDyadicIdempotent v (localDyadicIdempotent v) := by
    dsimp only [localDyadicIdempotent]
    rw [dif_pos he_ex]
    exact Classical.choose_spec he_ex
  let e := localDyadicIdempotent v
  have he_not_two : e ∉ Ideal.span {(2 : R)} := by
    intro he2
    have hM_eq : (M : R) = (2 : R) * ((4 * L : ℕ) : R) := by
      dsimp [M, L, N2, dyadicGaussModulus]
      push_cast
      ring
    have hM_in_v : (M : R) ∈ v.asIdeal := by
      rw [hM_eq]
      exact v.asIdeal.mul_mem_right _ h2v
    have hM_lt_one : v.intValuation (M : R) < 1 :=
      (v.intValuation_lt_one_iff_mem (M : R)).mpr hM_in_v
    have hkv_ne : kv ≠ 0 := by
      intro h0
      rw [h0, Nat.cast_zero, neg_zero, WithZero.exp_zero] at hM_val
      exact ne_of_lt hM_lt_one hM_val
    have hIv_le : Iv ≤ v.asIdeal := Ideal.pow_le_self hkv_ne
    have h1_sub_in : 1 - e ∈ v.asIdeal := hIv_le h_idem.1
    have he_in : e ∈ v.asIdeal :=
      ((Ideal.span_singleton_le_iff_mem v.asIdeal).mpr h2v) he2
    have h1_in : (1 : R) ∈ v.asIdeal := by
      have h_add := v.asIdeal.add_mem h1_sub_in he_in
      rwa [sub_add_cancel] at h_add
    exact v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_in)
  have he_sq : e ^ 2 - e ∈ Ideal.span {((L : ℕ) : R)} := by
    have h_mem_I : e * (1 - e) ∈ I := h_idem.2 (1 - e) h_idem.1
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp h_mem_I
    rw [Ideal.mem_span_singleton]
    refine ⟨-8 * q, ?_⟩
    have hM_eq : (M : R) = 8 * ((L : ℕ) : R) := by
      dsimp [M, L, N2, dyadicGaussModulus]
      push_cast
      ring
    rw [hM_eq] at hq
    linear_combination -hq
  refine ⟨h_idem, ⟨1, ?_⟩⟩
  rw [mul_one]
  let b := NumberField.RingOfIntegers.basis K
  let ι := Module.Free.ChooseBasisIndex ℤ R
  let n : ℕ := Fintype.card ι
  haveI : Nonempty ι := b.index_nonempty
  have hn_pos : 0 < n := Fintype.card_pos
  have h2_alg : (2 : R) = algebraMap ℤ R (2 : ℤ) := by simp
  have h_norm2 : Algebra.norm ℤ (2 : R) = (2 : ℤ) ^ n := by
    rw [h2_alg, Algebra.norm_algebraMap_of_basis b (2 : ℤ)]
  have hN2_eq : N2 = 2 ^ n := by
    dsimp [N2]
    rw [h_norm2]
    simp
  have hL_eq : L = 2 ^ (2 * n) := by
    dsimp [L]
    rw [hN2_eq, ← pow_mul, mul_comm]
  have hL_pos : 0 < L := by
    rw [hL_eq]
    positivity
  haveI : NeZero L := ⟨ne_of_gt hL_pos⟩
  have h2_dvd_L : 2 ∣ L := by
    rw [hL_eq]
    exact dvd_pow_self 2 (by omega)
  let A : Matrix ι ι ℤ := Algebra.leftMulMatrix b e
  let πL : Matrix ι ι ℤ →+* Matrix ι ι (ZMod L) := (Int.castRingHom (ZMod L)).mapMatrix
  let A_bar : Matrix ι ι (ZMod L) := πL A
  let ρ : ZMod L →+* ZMod 2 := ZMod.castHom h2_dvd_L (ZMod 2)
  let A₂ : Matrix ι ι (ZMod 2) := ρ.mapMatrix A_bar
  have hA_bar_idem : A_bar * A_bar = A_bar := by
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp he_sq
    have h_mat : A * A - A = (L : ℕ) • Algebra.leftMulMatrix b q := by
      dsimp [A]
      rw [← map_mul, ← sq, ← map_sub, hq, ← nsmul_eq_mul, map_nsmul]
    have h_sub : A_bar * A_bar - A_bar = 0 := by
      change πL A * πL A - πL A = 0
      rw [← map_mul, ← map_sub]
      ext i j
      have h_ij : (A * A - A) i j = ((L : ℕ) • Algebra.leftMulMatrix b q) i j :=
        congr_arg (fun M : Matrix ι ι ℤ => M i j) h_mat
      change (((A * A - A) i j : ℤ) : ZMod L) = 0
      rw [h_ij, Matrix.smul_apply, nsmul_eq_mul]
      push_cast
      simp
    exact sub_eq_zero.mp h_sub
  have hA₂_idem : A₂ * A₂ = A₂ := by
    change ρ.mapMatrix A_bar * ρ.mapMatrix A_bar = ρ.mapMatrix A_bar
    rw [← map_mul, hA_bar_idem]
  have hA₂_ne : A₂ ≠ 0 := by
    intro hA₂_zero
    have hA_even : ∀ i j : ι, (2 : ℤ) ∣ A i j := by
      intro i j
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by rfl, ← ZMod.intCast_zmod_eq_zero_iff_dvd]
      have h_entry : A₂ i j = 0 := by rw [hA₂_zero]; rfl
      simpa [A₂, A_bar, πL, ρ] using h_entry
    have h_repr_e : ∀ i : ι, (2 : ℤ) ∣ b.repr e i := by
      intro i
      have h_mul := congr_arg (fun v => v i) (Algebra.leftMulMatrix_mulVec_repr b e 1)
      rw [mul_one] at h_mul
      dsimp only at h_mul
      rw [← h_mul]
      dsimp [Matrix.mulVec, dotProduct]
      refine Finset.dvd_sum (fun j _ => dvd_mul_of_dvd_left (hA_even i j) _)
    have he_in_two : e ∈ Ideal.span {(2 : R)} := by
      rw [← b.sum_repr e]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      obtain ⟨c, hc⟩ := h_repr_e i
      rw [hc, mul_smul]
      rw [Ideal.mem_span_singleton]
      refine ⟨c • b i, ?_⟩
      simp [two_smul, two_mul]
    exact he_not_two he_in_two
  have h_diag : ∃ (V₂ : Matrix ι ι (ZMod 2)) (d : ι → ℕ),
      IsUnit V₂.det ∧
      (∀ j : ι, d j = 0 ∨ d j = 1) ∧
      1 ≤ ∑ j : ι, d j ∧
      A₂ * V₂ = V₂ * Matrix.diagonal (fun j => (d j : ZMod 2)) := by
    haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    let f : (ι → ZMod 2) →ₗ[ZMod 2] (ι → ZMod 2) := Matrix.toLin' A₂
    have h_ff : ∀ x : ι → ZMod 2, f (f x) = f x := by
      intro x
      change (f.comp f) x = f x
      rw [← Matrix.toLin'_mul, hA₂_idem]
    have h_proj : LinearMap.IsProj f.range f := by
      refine ⟨fun x => LinearMap.mem_range_self f x, ?_⟩
      rintro y ⟨x, rfl⟩
      exact h_ff x
    have h_compl : IsCompl f.range f.ker := h_proj.isCompl
    let e_prod : (f.range × f.ker) ≃ₗ[ZMod 2] (ι → ZMod 2) :=
      f.range.prodEquivOfIsCompl f.ker h_compl
    let bP := Module.Free.chooseBasis (ZMod 2) f.range
    let bK := Module.Free.chooseBasis (ZMod 2) f.ker
    let bPK := (bP.prod bK).map e_prod
    let b_std := Pi.basisFun (ZMod 2) ι
    let σ := b_std.indexEquiv bPK
    let b₂ := bPK.reindex σ.symm
    let V₂ : Matrix ι ι (ZMod 2) := b_std.toMatrix b₂
    let d : ι → ℕ := fun j => Sum.elim (fun _ => 1) (fun _ => 0) (σ j)
    have hV₂_apply : ∀ i j : ι, V₂ i j = b₂ j i := by
      intro i j
      dsimp [V₂, b_std]
      rw [Module.Basis.toMatrix_apply, Pi.basisFun_repr]
    have hV₂_inv : V₂ * b₂.toMatrix b_std = 1 :=
      Module.Basis.toMatrix_mul_toMatrix_flip b_std b₂
    have hV₂_det : IsUnit V₂.det := by
      refine IsUnit.of_mul_eq_one (b₂.toMatrix b_std).det ?_
      rw [← Matrix.det_mul, hV₂_inv, Matrix.det_one]
    have hd_01 : ∀ j : ι, d j = 0 ∨ d j = 1 := by
      intro j
      dsimp [d]
      cases σ j <;> simp
    have h_fb : ∀ j : ι, f (b₂ j) = (d j : ZMod 2) • b₂ j := by
      intro j
      have hbj : b₂ j = bPK (σ j) := by
        dsimp [b₂]
        rw [Module.Basis.reindex_apply, Equiv.symm_symm]
      rw [hbj]
      dsimp [bPK, e_prod, d]
      rcases σ j with p | q
      · simp only [Module.Basis.prod_apply, Sum.elim_inl,
          Function.comp_apply, LinearMap.inl_apply,
          ZeroMemClass.coe_zero, add_zero, Nat.cast_one, one_smul]
        exact h_proj.map_id (bP p) (bP p).2
      · simp only [Module.Basis.prod_apply, Sum.elim_inr,
          Function.comp_apply, LinearMap.inr_apply,
          ZeroMemClass.coe_zero, zero_add, Nat.cast_zero, zero_smul]
        exact LinearMap.mem_ker.mp (bK q).2
    have h_AV₂ : A₂ * V₂ = V₂ * Matrix.diagonal (fun j => (d j : ZMod 2)) := by
      ext i j
      rw [Matrix.mul_diagonal, hV₂_apply]
      have h_col : (fun k => V₂ k j) = b₂ j := funext (fun k => hV₂_apply k j)
      have h_lhs : (A₂ * V₂) i j = f (b₂ j) i := by
        dsimp [f]
        rw [← h_col]
        rfl
      rw [h_lhs, h_fb j, Pi.smul_apply, smul_eq_mul, mul_comm]
    have hd_pos : 1 ≤ ∑ j : ι, d j := by
      by_contra h_lt
      have h_sum_zero : ∑ j : ι, d j = 0 := by omega
      have hd_zero : ∀ j : ι, d j = 0 :=
        fun j => (Finset.sum_eq_zero_iff.mp h_sum_zero) j (Finset.mem_univ j)
      have hD_zero : Matrix.diagonal (fun j => (d j : ZMod 2)) = 0 := by
        ext i j
        by_cases hij : i = j
        · subst hij
          simp [hd_zero i]
        · simp [Matrix.diagonal_apply_ne _ hij]
      rw [hD_zero, mul_zero] at h_AV₂
      have hA₂_zero : A₂ = 0 := by
        calc A₂ = A₂ * 1 := (Matrix.mul_one A₂).symm
          _ = A₂ * (V₂ * b₂.toMatrix b_std) := by rw [hV₂_inv]
          _ = (A₂ * V₂) * b₂.toMatrix b_std := (Matrix.mul_assoc _ _ _).symm
          _ = 0 * b₂.toMatrix b_std := by rw [h_AV₂]
          _ = 0 := Matrix.zero_mul _
      exact hA₂_ne hA₂_zero
    exact ⟨V₂, d, hV₂_det, hd_01, hd_pos, h_AV₂⟩
  obtain ⟨V₂, d, hV₂_det, hd_01, hd_pos, h_AV₂⟩ := h_diag
  let D₂ : Matrix ι ι (ZMod 2) := Matrix.diagonal (fun j => (d j : ZMod 2))
  change A₂ * V₂ = V₂ * D₂ at h_AV₂
  let V : Matrix ι ι (ZMod L) := Matrix.of (fun i j => ((V₂ i j).val : ZMod L))
  let D : Matrix ι ι (ZMod L) := Matrix.diagonal (fun j => (d j : ZMod L))
  let W : Matrix ι ι (ZMod L) := A_bar * V * D + (1 - A_bar) * V * (1 - D)
  have hD_idem : D * D = D := by
    dsimp [D]
    rw [Matrix.diagonal_mul_diagonal]
    congr 1
    ext j
    rcases hd_01 j with h0 | h1
    · simp [h0]
    · simp [h1]
  have hD₂_idem : D₂ * D₂ = D₂ := by
    dsimp [D₂]
    rw [Matrix.diagonal_mul_diagonal]
    congr 1
    ext j
    rcases hd_01 j with h0 | h1
    · simp [h0]
    · simp [h1]
  have hA_one_sub : A_bar * (1 - A_bar) = 0 := by
    rw [mul_sub, mul_one, hA_bar_idem, sub_self]
  have h_one_sub_D : (1 - D) * D = 0 := by
    rw [sub_mul, one_mul, hD_idem, sub_self]
  have h_AW₁ : A_bar * W = A_bar * V * D := by
    dsimp [W]
    rw [mul_add, ← mul_assoc A_bar (A_bar * V) D, ← mul_assoc A_bar A_bar V, hA_bar_idem]
    rw [← mul_assoc A_bar ((1 - A_bar) * V) (1 - D), ← mul_assoc A_bar (1 - A_bar) V,
      hA_one_sub, zero_mul, zero_mul, add_zero]
  have h_WD : W * D = A_bar * V * D := by
    dsimp [W]
    rw [add_mul, mul_assoc (A_bar * V) D D, hD_idem]
    rw [mul_assoc ((1 - A_bar) * V) (1 - D) D, h_one_sub_D, mul_zero, add_zero]
  have h_AW : A_bar * W = W * D := h_AW₁.trans h_WD.symm
  have hρ_V : ρ.mapMatrix V = V₂ := by
    ext i j
    simp [V, ρ]
  have hρ_D : ρ.mapMatrix D = D₂ := by
    ext i j
    by_cases hij : i = j
    · subst hij
      simp [D, D₂]
    · simp [D, D₂, Matrix.diagonal_apply_ne _ hij]
  have hρ_W : ρ.mapMatrix W = V₂ := by
    have h_map : ρ.mapMatrix W = A₂ * V₂ * D₂ + (1 - A₂) * V₂ * (1 - D₂) := by
      change ρ.mapMatrix (A_bar * V * D + (1 - A_bar) * V * (1 - D)) = _
      simp only [map_add, map_mul, map_sub, map_one, hρ_V, hρ_D]
      rfl
    rw [h_map, sub_mul, one_mul, h_AV₂, mul_assoc V₂ D₂ D₂, hD₂_idem]
    rw [mul_sub (V₂ - V₂ * D₂) 1 D₂, mul_one, sub_mul V₂ (V₂ * D₂) D₂,
      mul_assoc V₂ D₂ D₂, hD₂_idem, sub_self, sub_zero, add_sub_cancel]
  have hW_det : IsUnit W.det := by
    let m : ℕ := W.det.val
    have hρ_det : IsUnit (ρ W.det) := by
      rw [RingHom.map_det, hρ_W]
      exact hV₂_det
    have h_val_eq : ρ W.det = (m : ZMod 2) := by
      dsimp [m]
      conv_lhs => rw [← ZMod.natCast_zmod_val W.det]
      exact map_natCast ρ W.det.val
    rw [h_val_eq, ZMod.isUnit_iff_coprime] at hρ_det
    have h_cop_L : m.Coprime L := by
      change m.Coprime (N2 ^ 2)
      rw [hN2_eq, ← pow_mul, mul_comm]
      exact hρ_det.pow_right (2 * n)
    rw [← ZMod.natCast_zmod_val W.det, ZMod.isUnit_iff_coprime]
    exact h_cop_L
  have hW_inv : W * W⁻¹ = 1 := Matrix.mul_nonsing_inv W hW_det
  have hW_inv' : W⁻¹ * W = 1 := Matrix.nonsing_inv_mul W hW_det
  have h_A_bar_eq : A_bar = W * D * W⁻¹ := by
    calc A_bar = A_bar * 1 := (Matrix.mul_one A_bar).symm
      _ = A_bar * (W * W⁻¹) := by rw [hW_inv]
      _ = A_bar * W * W⁻¹ := (Matrix.mul_assoc _ _ _).symm
      _ = W * D * W⁻¹ := by rw [h_AW]
  let k : ℕ := ∑ j : ι, d j
  have h_tr_A_bar : A_bar.trace = (k : ZMod L) := by
    calc A_bar.trace = ((W * D) * W⁻¹).trace := by rw [h_A_bar_eq]
      _ = (W⁻¹ * (W * D)).trace := Matrix.trace_mul_comm (W * D) W⁻¹
      _ = ((W⁻¹ * W) * D).trace := by rw [← Matrix.mul_assoc]
      _ = (1 * D).trace := by rw [hW_inv']
      _ = D.trace := by rw [Matrix.one_mul]
      _ = ∑ j : ι, (d j : ZMod L) := Matrix.trace_diagonal _
      _ = (k : ZMod L) := (Nat.cast_sum _ _).symm
  have hk_le_n : k ≤ n := by
    calc k = ∑ j : ι, d j := rfl
      _ ≤ ∑ _ : ι, 1 := Finset.sum_le_sum (fun j _ => by rcases hd_01 j with h0 | h1 <;> omega)
      _ = n := by simp [n]
  have hn_lt_L : n < L := by
    have h1 : n < 2 ^ n := Nat.lt_two_pow_self
    have h2 : 2 ^ n ≤ 2 ^ (2 * n) := Nat.pow_le_pow_right (by omega) (by omega)
    omega
  have hk_not_dvd : ¬ (L ∣ k) :=
    Nat.not_dvd_of_pos_of_lt hd_pos (lt_of_le_of_lt hk_le_n hn_lt_L)
  have hk_ne_zero : (k : ZMod L) ≠ 0 := by
    rwa [ne_eq, ZMod.natCast_eq_zero_iff]
  have h_tr_eq : ((Algebra.trace ℤ R e : ℤ) : ZMod L) = A_bar.trace := by
    rw [Algebra.trace_eq_matrix_trace b e]
    simp [A_bar, πL, A, Matrix.trace]
    rfl
  intro h_dvd
  have h_cast_zero : ((Algebra.trace ℤ R e : ℤ) : ZMod L) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (Algebra.trace ℤ R e) L).mpr h_dvd
  rw [h_tr_eq, h_tr_A_bar] at h_cast_zero
  exact hk_ne_zero h_cast_zero

theorem exists_sub_two_mul_mem_or_eight_mem_sup {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (γ a : NumberField.RingOfIntegers K) (hγ : γ ≠ 0) (hγ_sqfree : valNat v γ ≤ 1) :
    (∃ y₀ : NumberField.RingOfIntegers K,
      a - 2 * y₀ ∈ v.asIdeal ^ (valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K))) ∨
    (8 : NumberField.RingOfIntegers K) ∈
      Ideal.span {2 * γ * a} ⊔
        v.asIdeal ^ (valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K)) :=
by
  let R := NumberField.RingOfIntegers K
  let Iv : Ideal R := v.asIdeal ^ (valNat v (dyadicGaussModulus K : R))
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 →
        v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have pow_valNat_le_span_sup_Iv :
      ∀ (x : R), x ≠ 0 →
        v.asIdeal ^ (valNat v x) ≤ Ideal.span {x} ⊔ Iv := by
    intro x hx w hw
    let m : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(m : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ m ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x m).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (m + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le : v.intValuation x ≤ WithZero.exp (-((m + 1 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem x (m + 1)).mpr hx_mem
      rw [hx_val, WithZero.exp_le_exp] at hx_le
      omega
    have h_coprime_1 : IsCoprime J v.asIdeal := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      have h_eq : v.asIdeal = J ⊔ v.asIdeal :=
        v.isMaximal.eq_of_le h_ne_top le_sup_right
      have h_le : J ≤ v.asIdeal := h_eq.symm ▸ le_sup_left
      exact hJ_not_le h_le
    have h_coprime_k : IsCoprime J Iv := h_coprime_1.pow_right
    obtain ⟨j, hj, i, hi, hji⟩ := Ideal.isCoprime_iff_exists.mp h_coprime_k
    rw [Submodule.mem_sup]
    refine ⟨w * j, ?_, w * i, Iv.mul_mem_left w hi, ?_⟩
    · rw [hJ]
      exact Ideal.mul_mem_mul hw hj
    · calc
        w * j + w * i = w * (j + i) := (mul_add w j i).symm
        _ = w * 1 := by rw [hji]
        _ = w := mul_one w
  let e2 : ℕ := valNat v (2 : R)
  by_cases ha_mem : a ∈ v.asIdeal ^ e2
  · have ha_sup : a ∈ Ideal.span {(2 : R)} ⊔ Iv :=
      pow_valNat_le_span_sup_Iv (2 : R) two_ne_zero ha_mem
    obtain ⟨u, hu, r, hr, hur⟩ := Submodule.mem_sup.mp ha_sup
    obtain ⟨y₀, hy₀⟩ := Ideal.mem_span_singleton.mp hu
    refine Or.inl ⟨y₀, ?_⟩
    have h_eq : a - 2 * y₀ = r := by linear_combination -hur + hy₀
    rw [h_eq]
    exact hr
  · have ha_ne : a ≠ 0 := by
      intro ha0
      apply ha_mem
      rw [ha0]
      exact (v.asIdeal ^ e2).zero_mem
    have ha_lt : valNat v a < e2 := by
      by_contra h_ge
      have ha_le : v.intValuation a ≤ WithZero.exp (-(e2 : ℤ)) := by
        rw [intValuation_eq_exp_neg_valNat a ha_ne, WithZero.exp_le_exp]
        omega
      exact ha_mem ((v.intValuation_le_pow_iff_mem a e2).mp ha_le)
    let b : R := 2 * γ * a
    have hb_ne : b ≠ 0 := mul_ne_zero (mul_ne_zero two_ne_zero hγ) ha_ne
    have hb_val_eq :
        WithZero.exp (-(valNat v b : ℤ)) =
          WithZero.exp (-(e2 : ℤ) + -(valNat v γ : ℤ) + -(valNat v a : ℤ)) := by
      rw [← intValuation_eq_exp_neg_valNat b hb_ne, WithZero.exp_add, WithZero.exp_add,
        ← intValuation_eq_exp_neg_valNat (2 : R) two_ne_zero,
        ← intValuation_eq_exp_neg_valNat γ hγ,
        ← intValuation_eq_exp_neg_valNat a ha_ne]
      dsimp [b]
      rw [map_mul, map_mul]
    have hb_val_le :
        WithZero.exp (-(e2 : ℤ) + -(valNat v γ : ℤ) + -(valNat v a : ℤ)) ≤
          WithZero.exp (-(valNat v b : ℤ)) :=
      le_of_eq hb_val_eq.symm
    rw [WithZero.exp_le_exp] at hb_val_le
    have hb_le_3e : valNat v b ≤ e2 + e2 + e2 := by omega
    have h2_mem_e : (2 : R) ∈ v.asIdeal ^ e2 :=
      (v.intValuation_le_pow_iff_mem (2 : R) e2).mp
        (le_of_eq (intValuation_eq_exp_neg_valNat (2 : R) two_ne_zero))
    have h4_mem : (2 : R) * (2 : R) ∈ v.asIdeal ^ (e2 + e2) := by
      rw [pow_add]
      exact Ideal.mul_mem_mul h2_mem_e h2_mem_e
    have h8_mem_3e : (8 : R) ∈ v.asIdeal ^ (e2 + e2 + e2) := by
      have h8_eq : (8 : R) = ((2 : R) * (2 : R)) * (2 : R) := by norm_num
      rw [h8_eq, pow_add (v.asIdeal) (e2 + e2) e2]
      exact Ideal.mul_mem_mul h4_mem h2_mem_e
    have h8_mem_b : (8 : R) ∈ v.asIdeal ^ (valNat v b) :=
      Ideal.pow_le_pow_right hb_le_3e h8_mem_3e
    exact Or.inr (pow_valNat_le_span_sup_Iv b hb_ne h8_mem_b)

theorem localDyadicTraceGaussSum_ne_zero_of_idempotent_and_dichotomy {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K)
    (h_idem : IsLocalDyadicIdempotent v (localDyadicIdempotent v))
    (h_tr_not_dvd : ∃ w : NumberField.RingOfIntegers K,
      ¬ (((Algebra.norm ℤ (2 : NumberField.RingOfIntegers K)).natAbs ^ 2 : ℤ) ∣
        Algebra.trace ℤ (NumberField.RingOfIntegers K) (localDyadicIdempotent v * w)))
    (h_dichot : ∀ a : NumberField.RingOfIntegers K,
      (∃ y₀ : NumberField.RingOfIntegers K,
        a - 2 * y₀ ∈ v.asIdeal ^ (valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K))) ∨
      (8 : NumberField.RingOfIntegers K) ∈
        Ideal.span {2 * γ * a} ⊔
          v.asIdeal ^ (valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K))) :
    localDyadicTraceGaussSum v γ ≠ 0 :=
by
  let R := NumberField.RingOfIntegers K
  let b := Module.Free.chooseBasis ℤ R
  let n := Fintype.card (Module.Free.ChooseBasisIndex ℤ R)
  have h_norm : Algebra.norm ℤ (2 : R) = (2 : ℤ) ^ n := by
    have h2 : (2 : R) = algebraMap ℤ R (2 : ℤ) := by simp
    rw [h2, Algebra.norm_algebraMap_of_basis b (2 : ℤ)]
  have h_abs : (Algebra.norm ℤ (2 : R)).natAbs = 2 ^ n := by
    rw [h_norm, Int.natAbs_pow]
    rfl
  let L : ℕ := (Algebra.norm ℤ (2 : R)).natAbs ^ 2
  let M : ℕ := dyadicGaussModulus K
  have hL_pos : 0 < L := by
    dsimp only [L]
    rw [h_abs]
    positivity
  have hM_eq : M = 8 * L := rfl
  have hM_pos : 0 < M := by
    rw [hM_eq]
    positivity
  have hLc_ne : (L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hL_pos)
  have hMc_ne : (M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hM_pos)
  let I_M : Ideal R := Ideal.span {((M : ℕ) : R)}
  let Iv : Ideal R := v.asIdeal ^ (valNat v ((M : ℕ) : R))
  have hIv : Iv ≠ ⊥ := pow_ne_zero _ v.ne_bot
  let A_v := R ⧸ Iv
  haveI : Finite A_v := Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
  letI : Fintype A_v := Fintype.ofFinite A_v
  let e_v : R := localDyadicIdempotent v
  have he_mul_mem : ∀ y ∈ Iv, e_v * y ∈ I_M := h_idem.2
  let f : R → ℂ := fun r =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R (e_v * r) : ℤ) : ℂ) / (M : ℂ))
  let ψ : A_v → ℂ := fun x => f (Quotient.out x)
  have hf_add : ∀ r₁ r₂ : R, f (r₁ + r₂) = f r₁ * f r₂ := by
    intro r₁ r₂
    dsimp only [f]
    rw [mul_add, map_add, Int.cast_add, ← Complex.exp_add]
    congr 1
    ring
  have hf_zero : f 0 = 1 := by
    dsimp only [f]
    rw [mul_zero, map_zero, Int.cast_zero, mul_zero, zero_div, Complex.exp_zero]
  have hf_neg : ∀ r : R, f (-r) = starRingEnd ℂ (f r) := by
    intro r
    dsimp only [f]
    rw [mul_neg, map_neg, Int.cast_neg, ← Complex.exp_conj]
    congr 1
    simp [Complex.conj_ofReal, Complex.conj_I, map_ofNat]
  have hf_per : ∀ r₁ r₂ : R, r₁ - r₂ ∈ Iv → f r₁ = f r₂ := by
    intro r₁ r₂ hmem
    have he_mem : e_v * (r₁ - r₂) ∈ I_M := he_mul_mem (r₁ - r₂) hmem
    rw [Ideal.mem_span_singleton] at he_mem
    rcases he_mem with ⟨q, hq⟩
    have hr₁ : e_v * r₁ = e_v * r₂ + M • q := by
      rw [nsmul_eq_mul, ← hq, mul_sub, add_sub_cancel]
    have hf_eq : f r₁ =
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (e_v * r₂ + M • q) : ℤ) : ℂ) / (M : ℂ)) := by
      dsimp only [f]
      rw [hr₁]
    rw [hf_eq, map_add, Int.cast_add]
    have h_split :
        2 * (Real.pi : ℂ) * Complex.I *
          (((Algebra.trace ℤ R (e_v * r₂) : ℤ) : ℂ) +
            ((Algebra.trace ℤ R (M • q) : ℤ) : ℂ)) / (M : ℂ) =
        2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (e_v * r₂) : ℤ) : ℂ) / (M : ℂ) +
        2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (M • q) : ℤ) : ℂ) / (M : ℂ) := by
      ring
    rw [h_split, Complex.exp_add]
    have hfMq :
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (M • q) : ℤ) : ℂ) / (M : ℂ)) = 1 := by
      rw [map_nsmul, nsmul_eq_mul]
      have hexp :
          2 * (Real.pi : ℂ) * Complex.I *
            ((((M : ℤ) * Algebra.trace ℤ R q : ℤ) : ℂ)) / (M : ℂ) =
          ((Algebra.trace ℤ R q : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast
        field_simp [hMc_ne]
      rw [hexp]
      exact Complex.exp_int_mul_two_pi_mul_I (Algebra.trace ℤ R q)
    rw [hfMq, mul_one]
  have hψ_mk : ∀ r : R, ψ (Ideal.Quotient.mk Iv r) = f r := by
    intro r
    apply hf_per
    rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Ideal.Quotient.mk_out (Ideal.Quotient.mk Iv r)
  have hψ_add : ∀ a b : A_v, ψ (a + b) = ψ a * ψ b := by
    intro a b
    refine Quotient.inductionOn₂ a b (fun r₁ r₂ => ?_)
    change ψ (Ideal.Quotient.mk Iv r₁ + Ideal.Quotient.mk Iv r₂) =
      ψ (Ideal.Quotient.mk Iv r₁) * ψ (Ideal.Quotient.mk Iv r₂)
    rw [← (Ideal.Quotient.mk Iv).map_add r₁ r₂, hψ_mk, hψ_mk, hψ_mk, hf_add]
  have hψ_zero : ψ 0 = 1 := by
    change ψ (Ideal.Quotient.mk Iv 0) = 1
    rw [hψ_mk, hf_zero]
  have hψ_neg : ∀ a : A_v, ψ (-a) = starRingEnd ℂ (ψ a) := by
    intro a
    refine Quotient.inductionOn a (fun r => ?_)
    change ψ (-Ideal.Quotient.mk Iv r) = starRingEnd ℂ (ψ (Ideal.Quotient.mk Iv r))
    rw [← (Ideal.Quotient.mk Iv).map_neg r, hψ_mk, hψ_mk, hf_neg]
  let γbar : A_v := Ideal.Quotient.mk Iv γ
  have h_sum : localDyadicTraceGaussSum v γ = ∑ x : A_v, ψ (γbar * x ^ 2) := by
    dsimp only [localDyadicTraceGaussSum]
    rw [dif_pos hIv]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    have hx : γbar * x ^ 2 = Ideal.Quotient.mk Iv (γ * (Quotient.out x) ^ 2) := by
      rw [map_mul, map_pow, Ideal.Quotient.mk_out]
    rw [hx, hψ_mk]
    dsimp only [f, e_v]
    rw [mul_assoc (localDyadicIdempotent v) γ ((Quotient.out x) ^ 2)]
  let S : ℂ := localDyadicTraceGaussSum v γ
  have h_orth : (Complex.normSq S : ℂ) =
      ∑ h : A_v, ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) := by
    calc (Complex.normSq S : ℂ)
      _ = S * starRingEnd ℂ S := (Complex.mul_conj S).symm
      _ = (∑ x : A_v, ψ (γbar * x ^ 2)) * (∑ y : A_v, starRingEnd ℂ (ψ (γbar * y ^ 2))) := by
          rw [show S = localDyadicTraceGaussSum v γ from rfl, h_sum, map_sum]
      _ = (∑ x : A_v, ψ (γbar * x ^ 2)) * (∑ y : A_v, ψ (-(γbar * y ^ 2))) := by
          congr 1
          refine Finset.sum_congr rfl (fun y _ => (hψ_neg (γbar * y ^ 2)).symm)
      _ = ∑ x : A_v, ∑ y : A_v, ψ (γbar * x ^ 2) * ψ (-(γbar * y ^ 2)) :=
          Finset.sum_mul_sum _ _ _ _
      _ = ∑ y : A_v, ∑ x : A_v, ψ (γbar * x ^ 2 + -(γbar * y ^ 2)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun y _ => Finset.sum_congr rfl (fun x _ => ?_))
          rw [hψ_add]
      _ = ∑ y : A_v, ∑ h : A_v, ψ (γbar * h ^ 2 + 2 * γbar * h * y) := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          rw [← Equiv.sum_comp (Equiv.addLeft y)]
          refine Finset.sum_congr rfl (fun h _ => ?_)
          congr 1
          change γbar * (y + h) ^ 2 + -(γbar * y ^ 2) = γbar * h ^ 2 + 2 * γbar * h * y
          ring
      _ = ∑ h : A_v, ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun h _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun y _ => hψ_add _ _)
  letI : DecidablePred (fun h : A_v => ∀ y : A_v, ψ (2 * γbar * h * y) = 1) :=
    Classical.decPred _
  have h_term : ∀ h : A_v,
      ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) =
        if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℂ) else 0 := by
    intro h
    by_cases hh : ∀ y : A_v, ψ (2 * γbar * h * y) = 1
    · rw [if_pos hh]
      have h_inner : (∑ y : A_v, ψ (2 * γbar * h * y)) = (Fintype.card A_v : ℂ) := by
        calc (∑ y : A_v, ψ (2 * γbar * h * y))
          _ = ∑ _y : A_v, (1 : ℂ) := Finset.sum_congr rfl (fun y _ => hh y)
          _ = (Fintype.card A_v : ℂ) := by simp
      have h_outer : ψ (γbar * h ^ 2) = 1 := by
        let a : R := Quotient.out h
        have ha_mk : Ideal.Quotient.mk Iv a = h := Ideal.Quotient.mk_out h
        have h_qa : γbar * h ^ 2 = Ideal.Quotient.mk Iv (γ * a ^ 2) := by
          rw [← ha_mk]
          rfl
        have hf_all : ∀ y : R, f (2 * γ * a * y) = 1 := by
          intro y
          rw [← hψ_mk (2 * γ * a * y)]
          have h_lin_mk : 2 * γbar * h * Ideal.Quotient.mk Iv y =
              Ideal.Quotient.mk Iv (2 * γ * a * y) := by
            rw [← ha_mk]
            rfl
          rw [← h_lin_mk]
          exact hh (Ideal.Quotient.mk Iv y)
        rw [h_qa, hψ_mk]
        rcases h_dichot a with ⟨y₀, hy₀⟩ | h8_mem
        · have h_diff_mem : γ * a ^ 2 - 2 * γ * a * y₀ ∈ Iv := by
            have h_eq : γ * a ^ 2 - 2 * γ * a * y₀ = (γ * a) * (a - 2 * y₀) := by ring
            rw [h_eq]
            exact Ideal.mul_mem_left Iv (γ * a) hy₀
          rw [hf_per (γ * a ^ 2) (2 * γ * a * y₀) h_diff_mem]
          exact hf_all y₀
        · exfalso
          rcases Submodule.mem_sup.mp h8_mem with ⟨u, hu, r, hr, hur⟩
          rcases Ideal.mem_span_singleton.mp hu with ⟨c, rfl⟩
          rcases h_tr_not_dvd with ⟨w, hw⟩
          have h_diff_mem : 8 * w - 2 * γ * a * (c * w) ∈ Iv := by
            have h_eq : 8 * w - 2 * γ * a * (c * w) = r * w := by linear_combination -w * hur
            rw [h_eq]
            exact Ideal.mul_mem_right w Iv hr
          have hf8w : f (8 * w) = 1 := by
            rw [hf_per (8 * w) (2 * γ * a * (c * w)) h_diff_mem]
            exact hf_all (c * w)
          dsimp only [f] at hf8w
          have he8w : e_v * (8 * w) = (8 : ℕ) • (e_v * w) := by
            rw [nsmul_eq_mul]
            push_cast
            ring
          rw [he8w, map_nsmul, nsmul_eq_mul] at hf8w
          let t : ℤ := Algebra.trace ℤ R (e_v * w)
          have hexp :
              2 * (Real.pi : ℂ) * Complex.I *
                ((((8 : ℕ) : ℤ) * t : ℤ) : ℂ) / (M : ℂ) =
              ((t : ℂ) / (L : ℂ)) * (2 * Real.pi * Complex.I) := by
            rw [hM_eq]
            push_cast
            field_simp [hLc_ne]
          rw [hexp, Complex.exp_eq_one_iff] at hf8w
          rcases hf8w with ⟨m, hm⟩
          have h2piI_ne : (2 : ℂ) * (Real.pi : ℂ) * Complex.I ≠ 0 :=
            mul_ne_zero
              (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
              Complex.I_ne_zero
          have h_div_eq : (t : ℂ) / (L : ℂ) = (m : ℂ) :=
            mul_right_cancel₀ h2piI_ne hm
          have ht_eq_c : (t : ℂ) = (((L : ℤ) * m : ℤ) : ℂ) := by
            rw [(div_eq_iff hLc_ne).mp h_div_eq]
            push_cast
            ring
          have ht_eq : t = (L : ℤ) * m := Int.cast_inj.mp ht_eq_c
          exact hw ⟨m, ht_eq⟩
      rw [h_outer, h_inner, one_mul]
    · rw [if_neg hh]
      push_neg at hh
      rcases hh with ⟨y₀, hy₀⟩
      have h_shift : (∑ y : A_v, ψ (2 * γbar * h * y)) =
          (∑ y : A_v, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) := by
        calc (∑ y : A_v, ψ (2 * γbar * h * y))
          _ = ∑ y : A_v, ψ (2 * γbar * h * (y + y₀)) := by
              rw [← Equiv.sum_comp (Equiv.addRight y₀)]
              rfl
          _ = ∑ y : A_v, ψ (2 * γbar * h * y) * ψ (2 * γbar * h * y₀) := by
              refine Finset.sum_congr rfl (fun y _ => ?_)
              have h_lin : 2 * γbar * h * (y + y₀) = 2 * γbar * h * y + 2 * γbar * h * y₀ := by ring
              rw [h_lin, hψ_add]
          _ = (∑ y : A_v, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) :=
              (Finset.sum_mul _ _ _).symm
      have h_mul_zero : (∑ y : A_v, ψ (2 * γbar * h * y)) * (ψ (2 * γbar * h * y₀) - 1) = 0 := by
        linear_combination -h_shift
      have h_inner_zero : (∑ y : A_v, ψ (2 * γbar * h * y)) = 0 := by
        rcases mul_eq_zero.mp h_mul_zero with h0 | h1
        · exact h0
        · exact absurd (sub_eq_zero.mp h1) hy₀
      rw [h_inner_zero, mul_zero]
  have h_re : Complex.normSq S =
      ∑ h : A_v, (if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℝ) else 0) := by
    have h1 := congr_arg Complex.re h_orth
    rw [Complex.ofReal_re, Complex.re_sum] at h1
    rw [h1]
    refine Finset.sum_congr rfl (fun h _ => ?_)
    rw [h_term h]
    split_ifs <;> simp
  have h_nonneg : ∀ h ∈ (Finset.univ : Finset A_v),
      (0 : ℝ) ≤ (if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℝ) else 0) := by
    intro h _
    split_ifs
    · exact Nat.cast_nonneg _
    · exact le_rfl
  have h0_cond : ∀ y : A_v, ψ (2 * γbar * (0 : A_v) * y) = 1 := by
    intro y
    have h0_eq : 2 * γbar * (0 : A_v) * y = 0 := by ring
    rw [h0_eq, hψ_zero]
  have h_le : (Fintype.card A_v : ℝ) ≤ Complex.normSq S := by
    rw [h_re]
    have h_single := Finset.single_le_sum h_nonneg (Finset.mem_univ (0 : A_v))
    rw [if_pos h0_cond] at h_single
    exact h_single
  have h_card_pos : (0 : ℝ) < (Fintype.card A_v : ℝ) := by
    exact Nat.cast_pos.mpr Fintype.card_pos
  have h_normSq_pos : 0 < Complex.normSq S := lt_of_lt_of_le h_card_pos h_le
  exact Complex.normSq_pos.mp h_normSq_pos

theorem localDyadicBinaryGaussSum_one_ne_zero {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (β : NumberField.RingOfIntegers K) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1) :
    localDyadicBinaryGaussSum v 1 β ≠ 0 :=
by
  let R := NumberField.RingOfIntegers K
  obtain ⟨h_idem, h_tr_not_dvd⟩ := isLocalDyadicIdempotent_and_exists_trace_not_dvd v h2v
  have h1_ne : (1 : R) ≠ 0 := one_ne_zero
  have h1_sqfree : valNat v (1 : R) ≤ 1 := by
    unfold valNat
    rw [map_one, WithZero.log_one, neg_zero, Int.toNat_zero]
    exact Nat.zero_le 1
  have h_dichot_1 : ∀ a : R,
      (∃ y₀ : R, a - 2 * y₀ ∈ v.asIdeal ^ (valNat v (dyadicGaussModulus K : R))) ∨
      (8 : R) ∈ Ideal.span {2 * (1 : R) * a} ⊔ v.asIdeal ^ (valNat v (dyadicGaussModulus K : R)) :=
    fun a => exists_sub_two_mul_mem_or_eight_mem_sup v h2v (1 : R) a h1_ne h1_sqfree
  have hG1 : localDyadicTraceGaussSum v (1 : R) ≠ 0 :=
    localDyadicTraceGaussSum_ne_zero_of_idempotent_and_dichotomy v (1 : R)
      h_idem h_tr_not_dvd h_dichot_1
  have hγ2_ne : (-1 : R) * β ≠ 0 := by
    rw [neg_one_mul, neg_ne_zero]
    exact hβ
  have hγ2_sqfree : valNat v ((-1 : R) * β) ≤ 1 := by
    have h_val_eq : valNat v ((-1 : R) * β) = valNat v β := by
      unfold valNat
      rw [neg_one_mul, v.intValuation.map_neg]
    rw [h_val_eq]
    exact hβ_sqfree
  have h_dichot_2 : ∀ a : R,
      (∃ y₀ : R, a - 2 * y₀ ∈ v.asIdeal ^ (valNat v (dyadicGaussModulus K : R))) ∨
      (8 : R) ∈ Ideal.span {2 * ((-1 : R) * β) * a} ⊔ v.asIdeal ^ (valNat v (dyadicGaussModulus K : R)) :=
    fun a => exists_sub_two_mul_mem_or_eight_mem_sup v h2v ((-1 : R) * β) a hγ2_ne hγ2_sqfree
  have hG2 : localDyadicTraceGaussSum v ((-1 : R) * β) ≠ 0 :=
    localDyadicTraceGaussSum_ne_zero_of_idempotent_and_dichotomy v ((-1 : R) * β)
      h_idem h_tr_not_dvd h_dichot_2
  unfold localDyadicBinaryGaussSum
  exact mul_ne_zero hG1 hG2

theorem exists_add_shift_of_not_mem_pow_crit {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (γ β x₀ : NumberField.RingOfIntegers K) (k₀ : ℕ)
    (hγ : γ ∉ v.asIdeal) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1)
    (hk₀ : k₀ < valNat v (2 : NumberField.RingOfIntegers K))
    (hd₀_ne : x₀ ^ 2 - β ≠ 0)
    (hd₀_val : valNat v (x₀ ^ 2 - β) = 2 * k₀ + 1)
    (hx₀_mem : β ∈ v.asIdeal → x₀ = 0 ∧ k₀ = 0)
    (hx₀_unit : β ∉ v.asIdeal → x₀ ∉ v.asIdeal)
    (h_qdiag : ∀ (u y : NumberField.RingOfIntegers K) (m : ℕ),
      (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ m ↔
        u ^ 2 ∈ v.asIdeal ^ m ∧ (x₀ ^ 2 - β) * y ^ 2 ∈ v.asIdeal ^ m)
    (n l_crit : ℕ) (hn_low : 2 * valNat v (2 : NumberField.RingOfIntegers K) + 1 ≤ n)
    (hl_crit_in : β ∈ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K))
    (hl_crit_out : β ∉ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K) + (2 * k₀ + 1))
    (c δ : NumberField.RingOfIntegers K)
    (hc : c ∉ v.asIdeal ^ l_crit)
    (hδ : δ ∈ v.asIdeal ^ (n - 1)) :
    ∃ a b : NumberField.RingOfIntegers K,
      ∀ x y : NumberField.RingOfIntegers K,
        (γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) ∨
         γ * ((1 * x + a) ^ 2 - β * (1 * y + b) ^ 2) - c ∈ v.asIdeal ^ (n - 1)) →
        γ * ((1 * x + a) ^ 2 - β * (1 * y + b) ^ 2) - γ * (x ^ 2 - β * y ^ 2) - δ ∈ v.asIdeal ^ n :=
by
  let R := NumberField.RingOfIntegers K
  let e : ℕ := valNat v (2 : R)
  let d₀ : R := x₀ ^ 2 - β
  have h2_ne : (2 : R) ≠ 0 := two_ne_zero
  have hn_pos : 1 ≤ n := by omega
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have mem_pow_iff_le_valNat :
      ∀ (x : R) (m : ℕ), x ≠ 0 → (x ∈ v.asIdeal ^ m ↔ m ≤ valNat v x) := by
    intro x m hx
    rw [← v.intValuation_le_pow_iff_mem x m, intValuation_eq_exp_neg_valNat x hx,
      WithZero.exp_le_exp]
    omega
  have valNat_mul :
      ∀ (x y : R), x ≠ 0 → y ≠ 0 → valNat v (x * y) = valNat v x + valNat v y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h1 := intValuation_eq_exp_neg_valNat (x * y) hxy
    rw [map_mul, intValuation_eq_exp_neg_valNat x hx, intValuation_eq_exp_neg_valNat y hy,
      ← WithZero.exp_add] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have valNat_pow :
      ∀ (x : R) (k : ℕ), x ≠ 0 → valNat v (x ^ k) = k * valNat v x := by
    intro x k hx
    induction' k with k ih
    · have h1 : v.intValuation (1 : R) = WithZero.exp (0 : ℤ) := by simp
      have h2 := intValuation_eq_exp_neg_valNat (1 : R) one_ne_zero
      rw [h1] at h2
      have hinj := WithZero.exp_injective h2
      simp only [pow_zero, zero_mul]
      omega
    · rw [pow_succ', valNat_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
      ring
  have he_pos : 1 ≤ e :=
    (mem_pow_iff_le_valNat (2 : R) 1 h2_ne).mp (by simpa using h2v)
  have h2_mem_e : (2 : R) ∈ v.asIdeal ^ e :=
    (mem_pow_iff_le_valNat (2 : R) e h2_ne).mpr le_rfl
  have hd₀_mem : d₀ ∈ v.asIdeal ^ (2 * k₀ + 1) :=
    (mem_pow_iff_le_valNat d₀ (2 * k₀ + 1) hd₀_ne).mpr (le_of_eq hd₀_val.symm)
  have valNat_eq_zero_of_not_mem : ∀ (u : R), u ∉ v.asIdeal → u ≠ 0 ∧ valNat v u = 0 := by
    intro u hu
    have hu_ne : u ≠ 0 := fun h0 => hu (h0 ▸ v.asIdeal.zero_mem)
    have h_not : ¬ (1 ≤ valNat v u) := by
      rw [← mem_pow_iff_le_valNat u 1 hu_ne, pow_one]
      exact hu
