theorem localModulusBinaryGaussSum_step_of_hasLocalModulusConductor_ge_two {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (γ β : NumberField.RingOfIntegers K) (hβ_unit : β ∉ v.asIdeal)
    (c : ℕ) (hc : 2 ≤ c) (h_cond : HasLocalModulusConductor m v γ c) :
    ∃ γ' : NumberField.RingOfIntegers K,
      HasLocalModulusConductor m v γ' (c - 2) ∧
      localModulusBinaryGaussSum m v γ' β =
        ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ 2 : ℂ) *
        localModulusBinaryGaussSum m v γ β :=
by
  have _ := hm
  let R := NumberField.RingOfIntegers K
  let kv := valNat v (m : R)
  let Iv : Ideal R := v.asIdeal ^ kv
  have hIv : Iv ≠ ⊥ := pow_ne_zero kv v.ne_bot
  have hc_le : c ≤ kv := h_cond.1
  have hkv : 1 ≤ kv := by omega
  have hkv_ne : kv ≠ 0 := by omega
  have hc1_le_c : c - 1 ≤ c := by omega
  have hc1_ne_zero : c - 1 ≠ 0 := by omega
  have hc_le_2c1 : c ≤ (c - 1) + (c - 1) := by omega
  have hc1 : 1 ≤ c := by omega
  have hIv_le_c : Iv ≤ v.asIdeal ^ c := Ideal.pow_le_pow_right hc_le
  have hc_le_c1 : v.asIdeal ^ c ≤ v.asIdeal ^ (c - 1) := Ideal.pow_le_pow_right hc1_le_c
  have hc1_le_v : v.asIdeal ^ (c - 1) ≤ v.asIdeal := Ideal.pow_le_self hc1_ne_zero
  have hIv_le_v : Iv ≤ v.asIdeal := Ideal.pow_le_self hkv_ne
  have h_out_add : ∀ a b : R ⧸ Iv,
      Quotient.out (a + b) - (Quotient.out a + Quotient.out b) ∈ Iv := by
    intro a b
    apply Ideal.Quotient.eq.mp
    rw [Ideal.Quotient.mk_out, RingHom.map_add, Ideal.Quotient.mk_out, Ideal.Quotient.mk_out]
  obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
  have hπ2_val : v.intValuation (π ^ 2) = WithZero.exp (-((2 : ℕ) : ℤ)) := by
    rw [map_pow, hπ, sq, ← WithZero.exp_add]
    rfl
  have hπ2_mem : π ^ 2 ∈ v.asIdeal ^ 2 :=
    (v.intValuation_le_pow_iff_mem (π ^ 2) 2).mp (le_of_eq hπ2_val)
  have h_s1 : HasLocalModulusConductor m v (-γ * β) c := by
    refine ⟨h_cond.1, ?_, ?_⟩
    · intro z hz
      have hβz : -β * z ∈ v.asIdeal ^ c := (v.asIdeal ^ c).mul_mem_left (-β) hz
      have h_eq : localModulusIdempotent m v * (-γ * β) * z =
          localModulusIdempotent m v * γ * (-β * z) := by ring
      rw [h_eq]
      exact h_cond.2.1 (-β * z) hβz
    · intro hc1' h_triv
      apply h_cond.2.2 hc1'
      obtain ⟨u₀, i₀, hi₀, hu₀⟩ := v.isMaximal.exists_inv hβ_unit
      have h_cop0 : IsCoprime (Ideal.span {β}) v.asIdeal := by
        rw [Ideal.isCoprime_iff_exists]
        exact ⟨u₀ * β, Ideal.mem_span_singleton.mpr ⟨u₀, by ring⟩, i₀, hi₀, hu₀⟩
