      dsimp [resSum]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      have hx : x ^ 2 = Ideal.Quotient.mk v.asIdeal ((Quotient.out x) ^ 2) := by
        rw [map_pow, Ideal.Quotient.mk_out]
      rw [hx, hψ1_mk, neg_one_mul]
    have hG_negb : resSum (-β) = ∑ x : Fv, ψ1 (bbar * x ^ 2) := by
