        rw [Finset.mem_inter] at hw
        rcases Finset.mem_image.mp hw.1 with ⟨z₁, hz₁, rfl⟩
        rcases Finset.mem_image.mp hz₁ with ⟨x, _, rfl⟩
        rcases Finset.mem_image.mp hw.2 with ⟨z₂, hz₂, hw₂⟩
        rcases Finset.mem_image.mp hz₂ with ⟨y, _, rfl⟩
        refine ⟨x, y, ?_⟩
        dsimp [f] at hw₂ ⊢
        linear_combination -hw₂
      haveI : v.asIdeal.IsMaximal := v.isMaximal
      haveI : v.asIdeal.IsPrime := v.isPrime
      have lift_unit : ∀ (α' β' x₀ y₀ : NumberField.RingOfIntegers K),
          α' ∉ v.asIdeal → x₀ ∉ v.asIdeal → α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1 ∈ v.asIdeal →
          ∃ x y : v.adicCompletion K, ι α' * x ^ 2 + ι β' * y ^ 2 = 1 := by
        intro α' β' x₀ y₀ hα' hx₀ hconic
        let d : NumberField.RingOfIntegers K := α' * x₀ ^ 2
        let r : NumberField.RingOfIntegers K := α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1
        have hd_not_mem : d ∉ v.asIdeal := by
          intro hd
          rcases v.isPrime.mem_or_mem hd with h1 | h2
          · exact hα' h1
          · exact hx₀ (v.isPrime.mem_of_pow_mem 2 h2)
        have hd_val : Valued.v (ι d) = 1 :=
          ((IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
            (algebraMap (NumberField.RingOfIntegers K) K d)).trans
            (v.valuation_of_algebraMap d)).trans (v.intValuation_eq_one_iff.mpr hd_not_mem)
        have hd_ne : ι d ≠ 0 := by
          intro h0
          rw [h0, Valuation.map_zero] at hd_val
          exact zero_ne_one hd_val
        have hd_inv : ι d * (ι d)⁻¹ = 1 := mul_inv_cancel₀ hd_ne
        have hr_val : Valued.v (ι r) ≤ WithZero.exp (-1 : ℤ) := by
          have hr_val_eq : Valued.v (ι r) = v.intValuation r :=
            (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
              (algebraMap (NumberField.RingOfIntegers K) K r)).trans
              (v.valuation_of_algebraMap r)
          rw [hr_val_eq]
          exact (v.intValuation_le_pow_iff_mem r 1).mpr (by rw [pow_one]; exact hconic)
        let u : v.adicCompletion K := 1 - ι r * (ι d)⁻¹
        have hu_lt : Valued.v (u - 1) < 1 := by
          have hu_sub : u - 1 = -(ι r * (ι d)⁻¹) := by dsimp [u]; ring
          rw [hu_sub, Valuation.map_neg, map_mul, map_inv₀, hd_val, inv_one, mul_one]
          refine lt_of_le_of_lt hr_val ?_
          rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
          omega
        obtain ⟨w, hw⟩ := isSquare_of_val_sub_one_lt_one u hu_lt
        refine ⟨ι x₀ * w, ι y₀, ?_⟩
        have hd_map : ι d = ι α' * (ι x₀) ^ 2 := by dsimp [d]; simp [map_mul, map_pow]
        have hr_map : ι r = ι α' * (ι x₀) ^ 2 + ι β' * (ι y₀) ^ 2 - 1 := by
          dsimp [r]; simp [map_sub, map_add, map_mul, map_pow, map_one]
        calc
          ι α' * (ι x₀ * w) ^ 2 + ι β' * (ι y₀) ^ 2
            = (ι α' * (ι x₀) ^ 2) * (w * w) + ι β' * (ι y₀) ^ 2 := by ring
          _ = ι d * u + ι β' * (ι y₀) ^ 2 := by rw [← hd_map, ← hw]
          _ = ι d - ι r * (ι d * (ι d)⁻¹) + ι β' * (ι y₀) ^ 2 := by dsimp [u]; ring
          _ = 1 := by rw [hd_inv, mul_one, hd_map, hr_map]; ring
      letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
      have hα₀_bar : Ideal.Quotient.mk v.asIdeal α₀ ≠ 0 :=
        Ideal.Quotient.eq_zero_iff_mem.not.mpr hα₀
      have hβ₀_bar : Ideal.Quotient.mk v.asIdeal β₀ ≠ 0 :=
        Ideal.Quotient.eq_zero_iff_mem.not.mpr hβ₀
      obtain ⟨x_bar, y_bar, hxy_bar⟩ := hs1_ff hα₀_bar hβ₀_bar
      obtain ⟨x₀, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
      obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
      have hconic : α₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1 ∈ v.asIdeal := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        simp only [map_sub, map_add, map_mul, map_pow, map_one, hxy_bar, sub_self]
      have h_sol : ∃ x y : v.adicCompletion K, ι α₀ * x ^ 2 + ι β₀ * y ^ 2 = 1 := by
        by_cases hx₀ : x₀ ∈ v.asIdeal
        · have hy₀ : y₀ ∉ v.asIdeal := by
            intro hy₀
            have hsum : α₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 ∈ v.asIdeal := by
              refine v.asIdeal.add_mem ?_ ?_
              · have : α₀ * x₀ ^ 2 = (α₀ * x₀) * x₀ := by ring
                rw [this]; exact v.asIdeal.mul_mem_left _ hx₀
              · have : β₀ * y₀ ^ 2 = (β₀ * y₀) * y₀ := by ring
                rw [this]; exact v.asIdeal.mul_mem_left _ hy₀
            have h1 : (1 : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
              have hid : (1 : NumberField.RingOfIntegers K) =
                  (α₀ * x₀ ^ 2 + β₀ * y₀ ^ 2) - (α₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1) := by ring
              rw [hid]; exact v.asIdeal.sub_mem hsum hconic
            exact v.isMaximal.ne_top (v.asIdeal.eq_top_iff_one.mpr h1)
          have hconic' : β₀ * y₀ ^ 2 + α₀ * x₀ ^ 2 - 1 ∈ v.asIdeal := by
            have hid : β₀ * y₀ ^ 2 + α₀ * x₀ ^ 2 - 1 = α₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1 := by ring
            rw [hid]; exact hconic
          obtain ⟨y, x, hyx⟩ := lift_unit β₀ α₀ y₀ x₀ hβ₀ hy₀ hconic'
          refine ⟨x, y, ?_⟩
          rw [add_comm]
          exact hyx
        · exact lift_unit α₀ β₀ x₀ y₀ hα₀ hx₀ hconic
      rw [h_mul_sq, hs5.1 heα heβ]
      dsimp only [hilbFin, hilbLoc]
      exact if_pos h_sol
    · rw [h_comm, h_odd_even β α hβ hα hoβ heα, hs5.2.2.1 heα hoβ]
  · rcases Nat.even_or_odd (valNat v β) with heβ | hoβ
    · rw [h_odd_even α β hα hβ hoα heβ, hs5.2.1 hoα heβ]
    · have ha : algebraMap (NumberField.RingOfIntegers K) K α ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hα
      have hγ : -(α * β) ≠ 0 := neg_ne_zero.mpr (mul_ne_zero hα hβ)
      have h_map_neg_mul :
          -(algebraMap (NumberField.RingOfIntegers K) K α *
              algebraMap (NumberField.RingOfIntegers K) K β) =
          algebraMap (NumberField.RingOfIntegers K) K (-(α * β)) := by
        rw [map_neg, map_mul]
      rw [hilbFin_neg_mul_self_right
        (algebraMap (NumberField.RingOfIntegers K) K α)
        (algebraMap (NumberField.RingOfIntegers K) K β) ha,
        h_map_neg_mul,
        h_odd_even α (-(α * β)) hα hγ hoα (hs5.2.2.2 hoα hoβ).1,
        (hs5.2.2.2 hoα hoβ).2]

theorem tameSym_eq_one_of_not_mem_asIdeal {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) (h : α * β ∉ v.asIdeal) :
    tameSym v α β = 1 :=
by
  have hα : α ∉ v.asIdeal := fun hα => h (v.asIdeal.mul_mem_right β hα)
  have hβ : β ∉ v.asIdeal := fun hβ => h (v.asIdeal.mul_mem_left α hβ)
  have hvα : v.intValuation α = 1 := v.intValuation_eq_one_iff.mpr hα
  have hvβ : v.intValuation β = 1 := v.intValuation_eq_one_iff.mpr hβ
  have he1 : valNat v α = 0 := by simp [valNat, hvα]
  have he2 : valNat v β = 0 := by simp [valNat, hvβ]
  simp [tameSym, he1, he2]

theorem norm_mul_invariance {K : Type u} [Field K] [NumberField K]
    (α β x y : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (hδ : x ^ 2 - β * y ^ 2 ≠ 0) :
    dyadicProd (α * (x ^ 2 - β * y ^ 2)) β = dyadicProd α β ∧
    oddTameProd (α * (x ^ 2 - β * y ^ 2)) β = oddTameProd α β ∧
    realSignProd (α * (x ^ 2 - β * y ^ 2)) β = realSignProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have h_norm : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      normSym v (α * (x ^ 2 - β * y ^ 2)) β = normSym v α β := by
    classical
    intro v
    let F := v.adicCompletion K
    let a : F := algebraMap K F (algebraMap R K α)
    let b : F := algebraMap K F (algebraMap R K β)
    let xF : F := algebraMap K F (algebraMap R K x)
    let yF : F := algebraMap K F (algebraMap R K y)
    let d : F := xF ^ 2 - b * yF ^ 2
    have hd_map : algebraMap K F (algebraMap R K (x ^ 2 - β * y ^ 2)) = d := by
      simp [d, xF, yF, b, map_sub, map_pow, map_mul]
    have had_map : algebraMap K F (algebraMap R K (α * (x ^ 2 - β * y ^ 2))) = a * d := by
      rw [map_mul, map_mul, hd_map]
    have hd_K : algebraMap R K (x ^ 2 - β * y ^ 2) ≠ 0 := by
      simpa only [map_zero] using (IsFractionRing.injective R K).ne hδ
    have hd : d ≠ 0 := by
      rw [← hd_map]
      simpa only [map_zero] using (algebraMap K F).injective.ne hd_K
    have hd_inv : d * d⁻¹ = 1 := mul_inv_cancel₀ hd
    have h_iff : (∃ X' Y' : F, X' ^ 2 - b * Y' ^ 2 = a * d) ↔
        (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) := by
      constructor
      · rintro ⟨X', Y', hXY'⟩
        refine ⟨(X' * xF - b * Y' * yF) * d⁻¹, (xF * Y' - yF * X') * d⁻¹, ?_⟩
        linear_combination d * (d⁻¹) ^ 2 * hXY' + a * (d * d⁻¹ + 1) * hd_inv
      · rintro ⟨X, Y, hXY⟩
        refine ⟨X * xF + b * Y * yF, X * yF + Y * xF, ?_⟩
        linear_combination d * hXY
    dsimp only [normSym]
    change (if ∃ X' Y' : F,
        X' ^ 2 - b * Y' ^ 2 = algebraMap K F (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))
      then (1 : ℤˣ) else -1) =
      (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1)
    rw [had_map, h_iff]
  have h_dyad : dyadicProd (α * (x ^ 2 - β * y ^ 2)) β = dyadicProd α β := by
    letI := Classical.propDecidable
    dsimp only [dyadicProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, h_norm v]
    · rw [if_neg h2v, if_neg h2v]
  have hilbFin_eq_normSym_loc : ∀ (v : IsDedekindDomain.HeightOneSpectrum R)
      (γ : R), γ ≠ 0 →
      hilbFin v (algebraMap R K γ) (algebraMap R K β) = normSym v γ β := by
    classical
    intro v γ hγ
    let F := v.adicCompletion K
    let a_K : K := algebraMap R K γ
    let b_K : K := algebraMap R K β
    let a : F := algebraMap K F a_K
    let b : F := algebraMap K F b_K
    have ha_K : a_K ≠ 0 := by
      simpa only [a_K, map_zero] using (IsFractionRing.injective R K).ne hγ
    have ha : a ≠ 0 := by
      simpa only [a, map_zero] using (algebraMap K F).injective.ne ha_K
    have h2_K : (2 : K) ≠ 0 := two_ne_zero
    have h2 : (2 : F) ≠ 0 := by
      simpa only [map_ofNat, map_zero] using (algebraMap K F).injective.ne h2_K
    have h2inv : (2 : F) * 2⁻¹ = 1 := mul_inv_cancel₀ h2
    have h2ainv : (2 * a) * (2 * a)⁻¹ = 1 := mul_inv_cancel₀ (mul_ne_zero h2 ha)
    have h_iff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) := by
      constructor
      · rintro ⟨x, y, hxy⟩
        by_cases hx : x = 0
        · refine ⟨(a + 1) * 2⁻¹, y * (a - 1) * 2⁻¹, ?_⟩
          linear_combination - (a - 1) ^ 2 * (2⁻¹) ^ 2 * hxy +
            a * x * (a - 1) ^ 2 * (2⁻¹) ^ 2 * hx + a * (2 * 2⁻¹ + 1) * h2inv
        · have hxx : x * x⁻¹ = 1 := mul_inv_cancel₀ hx
          refine ⟨x⁻¹, y * x⁻¹, ?_⟩
          linear_combination - (x⁻¹) ^ 2 * hxy + a * (x * x⁻¹ + 1) * hxx
      · rintro ⟨X, Y, hXY⟩
        by_cases hX : X = 0
        · refine ⟨(a + 1) * (2 * a)⁻¹, Y * (a - 1) * (2 * a)⁻¹, ?_⟩
          linear_combination - (a - 1) ^ 2 * ((2 * a)⁻¹) ^ 2 * hXY +
            X * (a - 1) ^ 2 * ((2 * a)⁻¹) ^ 2 * hX + ((2 * a) * (2 * a)⁻¹ + 1) * h2ainv
        · have hXX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
          refine ⟨X⁻¹, Y * X⁻¹, ?_⟩
          linear_combination - (X⁻¹) ^ 2 * hXY + (X * X⁻¹ + 1) * hXX
    dsimp only [hilbFin, hilbLoc, normSym]
    change (if ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 then (1 : ℤˣ) else -1) =
      (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1)
    rw [h_iff]
  have tameSym_eq_one_of_not_mem_asIdeal_loc : ∀ (v : IsDedekindDomain.HeightOneSpectrum R)
      (γ : R), γ * β ∉ v.asIdeal → tameSym v γ β = 1 := by
    intro v γ h
    have hγ : γ ∉ v.asIdeal := fun hγ => h (v.asIdeal.mul_mem_right β hγ)
    have hβ_mem : β ∉ v.asIdeal := fun hβ' => h (v.asIdeal.mul_mem_left γ hβ')
    have hvγ : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hγ
    have hvβ : v.intValuation β = 1 := v.intValuation_eq_one_iff.mpr hβ_mem
    have he1 : valNat v γ = 0 := by
      unfold valNat
      rw [hvγ, WithZero.log_one]
      rfl
    have he2 : valNat v β = 0 := by
      unfold valNat
      rw [hvβ, WithZero.log_one]
      rfl
    simp [tameSym, he1, he2]
  have hilbFin_eq_tameSym_of_two_not_mem_loc : ∀ (v : IsDedekindDomain.HeightOneSpectrum R),
      (2 : R) ∉ v.asIdeal → ∀ (γ : R), γ ≠ 0 →
      hilbFin v (algebraMap R K γ) (algebraMap R K β) = tameSym v γ β := by
    intro v h2 γ hγ
    have intValuation_eq_exp_neg_valNat :
        ∀ (ξ : R), ξ ≠ 0 → v.intValuation ξ = WithZero.exp (-(valNat v ξ : ℤ)) := by
      intro ξ hξ
      have hv_ne : v.intValuation ξ ≠ 0 :=
        v.intValuation_ne_zero' ⟨ξ, mem_nonZeroDivisors_of_ne_zero hξ⟩
      have hv_le : v.intValuation ξ ≤ 1 := v.intValuation_le_one ξ
      have hlog_le : WithZero.log (v.intValuation ξ) ≤ 0 := by
        rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
        exact hv_le
      have hval : (valNat v ξ : ℤ) = -WithZero.log (v.intValuation ξ) := by
        unfold valNat
        exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
      rw [hval, neg_neg, WithZero.exp_log hv_ne]
    have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, ih, ← WithZero.exp_add]
        congr 1
        omega
    have exists_mul_sq_eq_of_even_valNat :
        ∀ (ξ : R), ξ ≠ 0 → Even (valNat v ξ) →
          ∃ (s : Kˣ) (ξ₀ : R),
            ξ₀ ∉ v.asIdeal ∧
            algebraMap R K ξ * (s : K) ^ 2 = algebraMap R K ξ₀ := by
      intro ξ hξ he
      rcases he with ⟨k, hk⟩
      have hk2 : valNat v ξ = 2 * k := by omega
      have hξ_val : v.intValuation ξ = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
        rw [intValuation_eq_exp_neg_valNat ξ hξ, hk2]
      have hξ_mem : ξ ∈ v.asIdeal ^ (2 * k) :=
        (v.intValuation_le_pow_iff_mem ξ (2 * k)).mp (le_of_eq hξ_val)
      obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
      have hπ_dvd : v.asIdeal ^ 1 ∣ Ideal.span {π} := by
        apply (v.intValuation_le_pow_iff_dvd π 1).mp
        rw [hπ]
        exact le_rfl
      rw [pow_one] at hπ_dvd
      obtain ⟨J, hJ⟩ := hπ_dvd
      have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
        intro hle
        have hπ_mem2 : π ∈ v.asIdeal ^ 2 := by
          rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
          exact Ideal.mul_mono_right hle
        have hπ_le2 : v.intValuation π ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
          (v.intValuation_le_pow_iff_mem π 2).mpr hπ_mem2
        rw [hπ, WithZero.exp_le_exp] at hπ_le2
        omega
      obtain ⟨s₀, hs₀J, hs₀v⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
      have hspan_ξ : Ideal.span {ξ} ≤ v.asIdeal ^ (2 * k) :=
        (Ideal.span_singleton_le_iff_mem _).mpr hξ_mem
      have hspan_s₀ : Ideal.span {s₀} ≤ J :=
        (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
      have hspan_mul : Ideal.span {ξ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π ^ k) ^ 2} := by
        have h1 : Ideal.span {ξ * (s₀ ^ k) ^ 2} = Ideal.span {ξ} * (Ideal.span {s₀}) ^ (2 * k) := by
          rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
            ← Ideal.span_singleton_pow]
        have h2 : Ideal.span {(π ^ k) ^ 2} = v.asIdeal ^ (2 * k) * J ^ (2 * k) := by
          rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
        rw [h1, h2]
        exact Ideal.mul_mono hspan_ξ (Ideal.pow_right_mono hspan_s₀ (2 * k))
      obtain ⟨ξ₀, hξ₀_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
      have hs₀_val : v.intValuation s₀ = 1 := v.intValuation_eq_one_iff.mpr hs₀v
      have hπ_pow_val : v.intValuation ((π ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
        rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ, exp_neg_one_pow (2 * k)]
      have hval_eq : WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1 =
          WithZero.exp (-((2 * k : ℕ) : ℤ)) * v.intValuation ξ₀ := by
        calc
          WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1
            = v.intValuation ξ * (v.intValuation s₀ ^ k) ^ 2 := by
              rw [hξ_val, hs₀_val, one_pow, one_pow]
          _ = v.intValuation (ξ * (s₀ ^ k) ^ 2) := by simp [map_mul, map_pow]
          _ = v.intValuation ((π ^ k) ^ 2 * ξ₀) := by rw [hξ₀_eq]
          _ = WithZero.exp (-((2 * k : ℕ) : ℤ)) * v.intValuation ξ₀ := by
            rw [map_mul, hπ_pow_val]
      have hξ₀_val : v.intValuation ξ₀ = 1 :=
        (mul_left_cancel₀ WithZero.exp_ne_zero hval_eq).symm
      have hξ₀_not_mem : ξ₀ ∉ v.asIdeal := v.intValuation_eq_one_iff.mp hξ₀_val
      have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀v (h0 ▸ v.asIdeal.zero_mem)
      have hπ_ne : π ≠ 0 := by
        intro h0
        rw [h0, map_zero] at hπ
        exact WithZero.exp_ne_zero hπ.symm
      have hs₀K_ne : algebraMap R K (s₀ ^ k) ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr (pow_ne_zero k hs₀_ne)
      have hπK_ne : algebraMap R K (π ^ k) ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr (pow_ne_zero k hπ_ne)
      let s : Kˣ := Units.mk0
        (algebraMap R K (s₀ ^ k) / algebraMap R K (π ^ k))
        (div_ne_zero hs₀K_ne hπK_ne)
      refine ⟨s, ξ₀, hξ₀_not_mem, ?_⟩
      have hmap := congr_arg (algebraMap R K) hξ₀_eq
      simp only [map_mul, map_pow] at hmap
      have hπK_ne' : algebraMap R K π ^ k ≠ 0 := by
        simpa only [map_pow] using hπK_ne
      change algebraMap R K ξ * (algebraMap R K (s₀ ^ k) / algebraMap R K (π ^ k)) ^ 2 =
        algebraMap R K ξ₀
      simp only [map_pow]
      field_simp [hπK_ne']
      linear_combination hmap
    have isSquare_of_val_sub_one_lt_one :
        ∀ (u : v.adicCompletion K), Valued.v (u - 1) < 1 → IsSquare u := by
      intro u hu
