        obtain ⟨y', hy'⟩ := (hw z).1
        have h_sub : Φ (z + w) - Φ z = (c_lat : ℤ) • y' := by
          rw [zsmul_eq_mul, Int.cast_natCast]
          exact hy'
        have h_repr : b.repr (Φ (z + w)) k - b.repr (Φ z) k = (c_lat : ℤ) * (b.repr y' k) := by
          have h_arg := congr_arg (fun x : R => b.repr x k) h_sub
          dsimp at h_arg
          rw [map_sub, Finsupp.sub_apply, map_zsmul, Finsupp.smul_apply, smul_eq_mul] at h_arg
