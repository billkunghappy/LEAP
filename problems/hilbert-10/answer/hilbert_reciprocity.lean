      have hL_lt_one : v.intValuation ((L : ℕ) : R) < 1 :=
        (v.intValuation_lt_one_iff_mem ((L : ℕ) : R)).mpr hL_in_v
      have hkv_ne : kv ≠ 0 := by
        intro h0
        rw [h0, Nat.cast_zero, neg_zero, WithZero.exp_zero] at hL_val
