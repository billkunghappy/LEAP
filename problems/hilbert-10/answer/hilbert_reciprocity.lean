        dsimp [a, a₁, b₁, N, k]
        push_cast
        field_simp [hK_c, hT_c]
        ring
      rw [h_exp, Complex.exp_add, Complex.exp_add, Complex.exp_add,
        Complex.exp_int_mul_two_pi_mul_I, mul_one]
    simp_rw [h_term]
    rw [tsum_mul_left, tsum_mul_left]
    rw [Complex.tsum_exp_neg_quadratic ha₁_re b₁]
    have h_combine_m : ∀ m : ℤ,
        Complex.exp (-Real.pi * ((z : ℕ) : ℂ) ^ 2 / (64 * (K : ℂ) ^ 2 * (T : ℂ))) *
          Complex.exp (-Real.pi / a₁ * ((m : ℂ) + Complex.I * b₁) ^ 2) =
        Complex.exp (-Real.pi * (T : ℂ) * (m : ℂ) ^ 2 +
          Complex.I * ((2 * Real.pi * ((z : ℕ) : ℝ) * (m : ℝ) / ((8 * K : ℕ) : ℝ) : ℝ) : ℂ)) := by
      intro m
      rw [← Complex.exp_add]
      congr 1
      dsimp [a₁, b₁]
      push_cast
      field_simp [hK_c, hT_c]
      ring_nf
      rw [Complex.I_sq]
      ring
    have h_pull_in :
        Complex.exp (-Real.pi * ((z : ℕ) : ℂ) ^ 2 / (64 * (K : ℂ) ^ 2 * (T : ℂ))) *
          (1 / a₁ ^ (1 / 2 : ℂ) *
            ∑' m : ℤ, Complex.exp (-Real.pi / a₁ * ((m : ℂ) + Complex.I * b₁) ^ 2)) =
        1 / a₁ ^ (1 / 2 : ℂ) *
          ∑' m : ℤ,
            Complex.exp (-Real.pi * (T : ℂ) * (m : ℂ) ^ 2 +
              Complex.I * ((2 * Real.pi * ((z : ℕ) : ℝ) * (m : ℝ) / ((8 * K : ℕ) : ℝ) : ℝ) : ℂ)) := by
      rw [← mul_assoc, mul_comm (Complex.exp _), mul_assoc, ← tsum_mul_left]
      simp_rw [h_combine_m]
    rw [h_pull_in]
    change a₁ ^ (1 / 2 : ℂ) *
      (Complex.exp (2 * Real.pi * Complex.I * ((z : ℕ) : ℂ) ^ 2 / ((8 * K : ℕ) : ℂ)) *
        (1 / a₁ ^ (1 / 2 : ℂ) * _)) = _
    rw [← mul_assoc, mul_comm (a₁ ^ (1 / 2 : ℂ)), mul_assoc, ← mul_assoc (a₁ ^ (1 / 2 : ℂ)),
      mul_one_div_cancel ha₁_cpow_ne, one_mul]
  have tsum_cexp_gauss_rhs_eq :
      ∀ (K : ℕ) (T : ℝ), 0 < K → 0 < T →
        ((1 / T : ℝ) : ℂ) ^ (1 / 2 : ℂ) *
          (∑' n : ℤ,
            Complex.exp (-Real.pi * (((1 / (64 * (K : ℝ) ^ 2 * T) : ℝ) : ℂ) - Complex.I / (4 * (K : ℂ))) * (n : ℂ) ^ 2)) =
        (((16 * (K : ℝ)) ^ (1 / 2 : ℝ) : ℝ) : ℂ) * Complex.exp (Real.pi * Complex.I / 4) *
          (∑' m : ℤ,
            Complex.exp (-Real.pi * ((4 * T : ℝ) : ℂ) * (m : ℂ) ^ 2 +
              Complex.I * ((-Real.pi * (m : ℝ) ^ 2 / (4 * (K : ℝ)) : ℝ) : ℂ))) := by
    intro K T hK hT
    have hK_r : (K : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hK)
    have hK_c : (K : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hK)
    have hT_r : T ≠ 0 := ne_of_gt hT
    have hT_c : (T : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hT_r
    let a : ℂ := ((1 / (64 * (K : ℝ) ^ 2 * T) : ℝ) : ℂ) - Complex.I / (4 * (K : ℂ))
    let d : ℂ := ((4 * T : ℝ) : ℂ) + Complex.I / (4 * (K : ℂ))
    have ha_re : 0 < a.re := by
      have h_eq : a = ((1 / (64 * (K : ℝ) ^ 2 * T) : ℝ) : ℂ) + ((-1 / (4 * (K : ℝ)) : ℝ) : ℂ) * Complex.I := by
        dsimp [a]
        push_cast
        ring
      rw [h_eq, Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im]
      positivity
    have hd_re : 0 < d.re := by
      have h_eq : d = ((4 * T : ℝ) : ℂ) + ((1 / (4 * (K : ℝ)) : ℝ) : ℂ) * Complex.I := by
        dsimp [d]
        push_cast
        ring
      rw [h_eq, Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im]
      positivity
    have ha_ne : a ≠ 0 := by
      intro h0; rw [h0, Complex.zero_re] at ha_re; exact lt_irrefl 0 ha_re
    have hd_ne : d ≠ 0 := by
      intro h0; rw [h0, Complex.zero_re] at hd_re; exact lt_irrefl 0 hd_re
    have ha_cpow_ne : a ^ (1 / 2 : ℂ) ≠ 0 := by
      rw [Complex.cpow_def_of_ne_zero ha_ne]
      exact Complex.exp_ne_zero _
    have hd_cpow_ne : d ^ (1 / 2 : ℂ) ≠ 0 := by
      rw [Complex.cpow_def_of_ne_zero hd_ne]
      exact Complex.exp_ne_zero _
    have h_quad_a :
        (∑' n : ℤ, Complex.exp (-Real.pi * a * (n : ℂ) ^ 2)) =
