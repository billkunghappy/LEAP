        (∑ z : A, ψ z) =
        ∑ r : ι → ZMod c_lat, ∑ z ∈ Finset.univ.filter (fun z : A => ρ z = r), ψ z := by
      rw [← Finset.sum_fiberwise_of_maps_to (g := ρ) (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
