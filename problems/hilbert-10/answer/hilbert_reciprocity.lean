      intro k t hδu2 hδy2 ht1 ht2
      have hδu : δu ∈ v.asIdeal ^ ((k + 1) / 2) :=
        mem_of_sq_mem_pow δu ((k + 1) / 2) k (by omega) hδu2
      have hδy : δy ∈ v.asIdeal ^ ((k - 2 * k₀) / 2) :=
        mem_of_d0_mul_sq_mem_pow δy ((k - 2 * k₀) / 2) k (by omega) hδy2
