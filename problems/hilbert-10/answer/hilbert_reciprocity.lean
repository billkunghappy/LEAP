theorem dyadicProd_eq_oddQuadProd_mul_realSignProd_of_disjoint {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
