      rw [hval, neg_neg, WithZero.exp_log hv_ne]
    have h_dvd : Iv ∣ I :=
      (v.intValuation_le_pow_iff_dvd ((L : ℕ) : R) kv).mp (le_of_eq hL_val)
    obtain ⟨J, hJ⟩ := h_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
