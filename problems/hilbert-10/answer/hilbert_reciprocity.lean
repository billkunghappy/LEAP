      let ψ : R → A → ℂ := fun γ z =>
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (γ * (Quotient.out z) ^ 2) : ℤ) : ℂ) / (m : ℂ))
      have h_two_sum : ∀ {α₁ α₂ : Type u} [Fintype α₁] [Fintype α₂] (g₁ : α₁ → ℂ) (g₂ : α₂ → ℂ),
          (∑ x₁ : α₁, g₁ x₁) * (∑ x₂ : α₂, g₂ x₂) = ∑ p : α₁ × α₂, g₁ p.1 * g₂ p.2 := by
        intro α₁ α₂ _ _ g₁ g₂
        rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
      have h_four_sum : ∀ f₀ f₁ f₂ f₃ : A → ℂ,
          (∑ x₀ : A, f₀ x₀) * (∑ x₁ : A, f₁ x₁) * (∑ x₂ : A, f₂ x₂) * (∑ x₃ : A, f₃ x₃) =
            ∑ x : (A × A) × (A × A), f₀ x.1.1 * f₁ x.1.2 * f₂ x.2.1 * f₃ x.2.2 := by
        intro f₀ f₁ f₂ f₃
        rw [mul_assoc (_ * _), h_two_sum f₀ f₁, h_two_sum f₂ f₃, h_two_sum]
        refine Finset.sum_congr rfl (fun x _ => by ring)
      have h_term : ∀ x : (A × A) × (A × A),
          ψ (c * 1) x.1.1 * ψ (c * (-α)) x.1.2 * ψ (c * (-β)) x.2.1 * ψ (c * (α * β)) x.2.2 =
            ψ 1 (Φ x).1.1 * ψ (-α) (Φ x).1.2 * ψ (-β) (Φ x).2.1 * ψ (α * β) (Φ x).2.2 := by
        intro x
        let X : R :=
          (c * 1) * (Quotient.out x.1.1) ^ 2 +
          (c * (-α)) * (Quotient.out x.1.2) ^ 2 +
          (c * (-β)) * (Quotient.out x.2.1) ^ 2 +
          (c * (α * β)) * (Quotient.out x.2.2) ^ 2
        let Y : R :=
          (1 : R) * (Quotient.out (Φ x).1.1) ^ 2 +
          (-α) * (Quotient.out (Φ x).1.2) ^ 2 +
          (-β) * (Quotient.out (Φ x).2.1) ^ 2 +
          (α * β) * (Quotient.out (Φ x).2.2) ^ 2
        have h_diff_mem : Y - X ∈ I := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          change q (Y - X) = 0
          dsimp only [X, Y]
          simp only [map_sub, map_add, map_mul, map_pow, map_one, map_neg]
          have hx0 : q (Quotient.out x.1.1) = x.1.1 := Ideal.Quotient.mk_out x.1.1
          have hx1 : q (Quotient.out x.1.2) = x.1.2 := Ideal.Quotient.mk_out x.1.2
          have hx2 : q (Quotient.out x.2.1) = x.2.1 := Ideal.Quotient.mk_out x.2.1
          have hx3 : q (Quotient.out x.2.2) = x.2.2 := Ideal.Quotient.mk_out x.2.2
          have hy0 : q (Quotient.out (Φ x).1.1) = (Φ x).1.1 := Ideal.Quotient.mk_out (Φ x).1.1
          have hy1 : q (Quotient.out (Φ x).1.2) = (Φ x).1.2 := Ideal.Quotient.mk_out (Φ x).1.2
          have hy2 : q (Quotient.out (Φ x).2.1) = (Φ x).2.1 := Ideal.Quotient.mk_out (Φ x).2.1
          have hy3 : q (Quotient.out (Φ x).2.2) = (Φ x).2.2 := Ideal.Quotient.mk_out (Φ x).2.2
          rw [hx0, hx1, hx2, hx3, hy0, hy1, hy2, hy3]
          change (1 * (toFun x).1.1 ^ 2 + (-a) * (toFun x).1.2 ^ 2 +
              (-b) * (toFun x).2.1 ^ 2 + (a * b) * (toFun x).2.2 ^ 2) -
            (c_bar * 1 * x.1.1 ^ 2 + c_bar * (-a) * x.1.2 ^ 2 +
              c_bar * (-b) * x.2.1 ^ 2 + c_bar * (a * b) * x.2.2 ^ 2) = 0
          dsimp only [toFun]
          linear_combination
            (x.1.1 ^ 2 - a * x.1.2 ^ 2 - b * x.2.1 ^ 2 + a * b * x.2.2 ^ 2) * h_norm'
        obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp h_diff_mem
        have h_tr_Y : Algebra.trace ℤ R Y =
            Algebra.trace ℤ R X + (m : ℤ) * Algebra.trace ℤ R r := by
          have hY : Y = X + m • r := by
            rw [nsmul_eq_mul, ← hr]
            ring
          rw [hY, map_add, map_nsmul, nsmul_eq_mul]
        have h_tr_X : (Algebra.trace ℤ R X : ℂ) =
            (Algebra.trace ℤ R ((c * 1) * (Quotient.out x.1.1) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((c * (-α)) * (Quotient.out x.1.2) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((c * (-β)) * (Quotient.out x.2.1) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((c * (α * β)) * (Quotient.out x.2.2) ^ 2) : ℂ) := by
          dsimp only [X]
          push_cast [map_add]
          ring
        have h_tr_Y_exp : (Algebra.trace ℤ R Y : ℂ) =
            (Algebra.trace ℤ R ((1 : R) * (Quotient.out (Φ x).1.1) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((-α) * (Quotient.out (Φ x).1.2) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((-β) * (Quotient.out (Φ x).2.1) ^ 2) : ℂ) +
            (Algebra.trace ℤ R ((α * β) * (Quotient.out (Φ x).2.2) ^ 2) : ℂ) := by
          dsimp only [Y]
          push_cast [map_add]
          ring
        have h_exp_Y :
            2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((1 : R) * (Quotient.out (Φ x).1.1) ^ 2) : ℂ) / (m : ℂ) +
            2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((-α) * (Quotient.out (Φ x).1.2) ^ 2) : ℂ) / (m : ℂ) +
            2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((-β) * (Quotient.out (Φ x).2.1) ^ 2) : ℂ) / (m : ℂ) +
            2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((α * β) * (Quotient.out (Φ x).2.2) ^ 2) : ℂ) / (m : ℂ) =
            (2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * 1) * (Quotient.out x.1.1) ^ 2) : ℂ) / (m : ℂ) +
             2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (-α)) * (Quotient.out x.1.2) ^ 2) : ℂ) / (m : ℂ) +
             2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (-β)) * (Quotient.out x.2.1) ^ 2) : ℂ) / (m : ℂ) +
             2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (α * β)) * (Quotient.out x.2.2) ^ 2) : ℂ) / (m : ℂ)) +
            ((Algebra.trace ℤ R r : ℤ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
          have h_cast : (Algebra.trace ℤ R Y : ℂ) =
              (Algebra.trace ℤ R X : ℂ) + (m : ℂ) * (Algebra.trace ℤ R r : ℂ) := by
            exact_mod_cast h_tr_Y
          rw [h_tr_Y_exp, h_tr_X] at h_cast
          linear_combination (2 * (Real.pi : ℂ) * Complex.I / (m : ℂ)) * h_cast +
            (2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R r : ℂ)) * hm_inv
        calc ψ (c * 1) x.1.1 * ψ (c * (-α)) x.1.2 * ψ (c * (-β)) x.2.1 * ψ (c * (α * β)) x.2.2
          _ = Complex.exp (
                (2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * 1) * (Quotient.out x.1.1) ^ 2) : ℂ) / (m : ℂ) +
                 2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (-α)) * (Quotient.out x.1.2) ^ 2) : ℂ) / (m : ℂ) +
                 2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (-β)) * (Quotient.out x.2.1) ^ 2) : ℂ) / (m : ℂ) +
                 2 * (Real.pi : ℂ) * Complex.I * (Algebra.trace ℤ R ((c * (α * β)) * (Quotient.out x.2.2) ^ 2) : ℂ) / (m : ℂ)) +
                ((Algebra.trace ℤ R r : ℤ) : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)) := by
              dsimp only [ψ]
              simp only [Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I]
              ring
          _ = ψ 1 (Φ x).1.1 * ψ (-α) (Φ x).1.2 * ψ (-β) (Φ x).2.1 * ψ (α * β) (Φ x).2.2 := by
              rw [← h_exp_Y]
              dsimp only [ψ]
              rw [Complex.exp_add, Complex.exp_add, Complex.exp_add]
      dsimp only [traceGaussSum]
      rw [dif_pos hI, dif_pos hI, dif_pos hI, dif_pos hI,
          dif_pos hI, dif_pos hI, dif_pos hI, dif_pos hI]
      change (∑ x₀ : A, ψ (c * 1) x₀) * (∑ x₁ : A, ψ (c * (-α)) x₁) *
          (∑ x₂ : A, ψ (c * (-β)) x₂) * (∑ x₃ : A, ψ (c * (α * β)) x₃) =
        (∑ y₀ : A, ψ 1 y₀) * (∑ y₁ : A, ψ (-α) y₁) *
          (∑ y₂ : A, ψ (-β) y₂) * (∑ y₃ : A, ψ (α * β) y₃)
      rw [h_four_sum, h_four_sum]
      rw [Finset.sum_congr rfl (fun x _ => h_term x)]
      exact Equiv.sum_comp Φ (fun y => ψ 1 y.1.1 * ψ (-α) y.1.2 * ψ (-β) y.2.1 * ψ (α * β) y.2.2)
    · simp only [traceGaussSum, dif_neg hI, mul_zero]
  have h_s4 :
      ∀ (m : ℕ),
        traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * 1) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (-α)) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (-β)) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (α * β)) =
        traceGaussSum m (1 : NumberField.RingOfIntegers K) *
          traceGaussSum m (-α) *
          traceGaussSum m (-β) *
          traceGaussSum m (α * β) →
        traceGaussSum m (1 : NumberField.RingOfIntegers K) *
          traceGaussSum m (-α) *
          traceGaussSum m (-β) *
          traceGaussSum m (α * β) =
        (pfisterGaussSum m α β : ℂ) := by
    intro m h_neg_one
    letI := Classical.propDecidable
    have h_conj : ∀ γ : NumberField.RingOfIntegers K,
        traceGaussSum m (-γ) = starRingEnd ℂ (traceGaussSum m γ) := by
      intro γ
      dsimp only [traceGaussSum]
      by_cases hI : Ideal.span {(m : NumberField.RingOfIntegers K)} ≠ ⊥
      · rw [dif_pos hI, dif_pos hI, map_sum]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        rw [← Complex.exp_conj]
        congr 1
        have h_neg : (-γ) * (Quotient.out x) ^ 2 = -(γ * (Quotient.out x) ^ 2) := by ring
        rw [h_neg, map_neg, Int.cast_neg]
        simp only [map_div₀, map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I,
          map_intCast, map_natCast]
        ring
      · rw [dif_neg hI, dif_neg hI, map_zero]
    have h1 : (-1 : NumberField.RingOfIntegers K) * 1 = -(1 : NumberField.RingOfIntegers K) := by ring
    have h2 : (-1 : NumberField.RingOfIntegers K) * (-α) = -(-α) := by ring
    have h3 : (-1 : NumberField.RingOfIntegers K) * (-β) = -(-β) := by ring
    have h4 : (-1 : NumberField.RingOfIntegers K) * (α * β) = -(α * β) := by ring
    have h_lhs :
        traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * 1) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (-α)) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (-β)) *
          traceGaussSum m ((-1 : NumberField.RingOfIntegers K) * (α * β)) =
        starRingEnd ℂ (
          traceGaussSum m (1 : NumberField.RingOfIntegers K) *
            traceGaussSum m (-α) *
            traceGaussSum m (-β) *
            traceGaussSum m (α * β)) := by
      rw [h1, h2, h3, h4, h_conj 1, h_conj (-α), h_conj (-β), h_conj (α * β),
        ← map_mul, ← map_mul, ← map_mul]
    rw [h_lhs] at h_neg_one
    exact (Complex.conj_eq_iff_re.mp h_neg_one).symm
  obtain ⟨⟨s_M, hs_M⟩, h_rep⟩ := h_s2
  obtain ⟨u₀, u₁, u₂, u₃, hu_M⟩ :=
    h_rep (dyadicGaussModulus K : NumberField.RingOfIntegers K) s_M hs_M
  have hs_neg1 :
      (-1 : NumberField.RingOfIntegers K) * (-1 : NumberField.RingOfIntegers K) - 1 ∈
        Ideal.span {((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K)} := by
    have h0 : (-1 : NumberField.RingOfIntegers K) * (-1 : NumberField.RingOfIntegers K) - 1 = 0 := by
      ring
    rw [h0]
    exact Submodule.zero_mem _
  obtain ⟨v₀, v₁, v₂, v₃, hv_neg1⟩ :=
    h_rep (-1 : NumberField.RingOfIntegers K) (-1 : NumberField.RingOfIntegers K) hs_neg1
  have h_M_eq :=
    h_s3 (oddPfisterModulus α β) (dyadicGaussModulus K : NumberField.RingOfIntegers K) s_M
      u₀ u₁ u₂ u₃ hs_M hu_M
  have h_neg1_eq :=
    h_s3 (oddPfisterModulus α β) (-1 : NumberField.RingOfIntegers K)
      (-1 : NumberField.RingOfIntegers K) v₀ v₁ v₂ v₃ hs_neg1 hv_neg1
  have h_re_eq := h_s4 (oddPfisterModulus α β) h_neg1_eq
  exact h_M_eq.trans h_re_eq

theorem traceGaussSum_oddPfisterModulus_ne_zero {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (γ : NumberField.RingOfIntegers K) :
    traceGaussSum (oddPfisterModulus α β) γ ≠ 0 :=
by
  let R := NumberField.RingOfIntegers K
  let n : ℕ := (Algebra.norm ℤ (α * β)).natAbs
  let D : ℕ := oddPfisterModulus α β
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : n ≠ 0 := by
    change (Algebra.norm ℤ (α * β)).natAbs ≠ 0
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat n := Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos (2 * Module.finrank ℚ K + 2)
  have h_not_dvd_odd : ¬ 2 ∣ oddPartNat n := Nat.not_dvd_ordCompl Nat.prime_two hn_ne
  have h_cop_odd : Nat.Coprime 2 (oddPartNat n) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h_not_dvd_odd
  have h_cop : Nat.Coprime 2 D := h_cop_odd.pow_right (2 * Module.finrank ℚ K + 2)
  have h_not_dvd_D : ¬ 2 ∣ D :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp h_cop
  let u : ℕ := (D + 1) / 2
  have hu : 2 * u = D + 1 := by omega
  have hD_ne : ((D : ℕ) : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  let I_D : Ideal R := Ideal.span {((D : ℕ) : R)}
  have hI_D : I_D ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hD_ne
  let A_D := R ⧸ I_D
  haveI : Finite A_D := Ideal.finiteQuotientOfFreeOfNeBot I_D hI_D
  letI : Fintype A_D := Fintype.ofFinite A_D
  have hD_zero : ((D : ℕ) : A_D) = 0 := by
    change Ideal.Quotient.mk I_D ((D : ℕ) : R) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have h2u : (2 : A_D) * (u : A_D) = 1 := by
    calc (2 : A_D) * (u : A_D)
      _ = ((2 * u : ℕ) : A_D) := by push_cast; rfl
      _ = ((D + 1 : ℕ) : A_D) := by rw [hu]
      _ = ((D : ℕ) : A_D) + 1 := by push_cast; rfl
      _ = 1 := by rw [hD_zero, zero_add]
  let f : R → ℂ := fun r =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R r : ℤ) : ℂ) / (D : ℂ))
  let ψ : A_D → ℂ := fun x => f (Quotient.out x)
  have hf_add : ∀ r₁ r₂ : R, f (r₁ + r₂) = f r₁ * f r₂ := by
    intro r₁ r₂
    dsimp only [f]
    rw [map_add, Int.cast_add, ← Complex.exp_add]
    congr 1
    ring
  have hf_zero : f 0 = 1 := by
    dsimp only [f]
    rw [map_zero, Int.cast_zero, mul_zero, zero_div, Complex.exp_zero]
  have hf_neg : ∀ r : R, f (-r) = starRingEnd ℂ (f r) := by
    intro r
    dsimp only [f]
    rw [map_neg, Int.cast_neg, ← Complex.exp_conj]
    congr 1
    simp [Complex.conj_ofReal, Complex.conj_I, map_ofNat]
  have hDc_ne : (D : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  have hf_per : ∀ r₁ r₂ : R, r₁ - r₂ ∈ I_D → f r₁ = f r₂ := by
    intro r₁ r₂ hmem
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨q, hq⟩
    have hr₁ : r₁ = r₂ + D • q := by
      rw [nsmul_eq_mul, ← hq, add_sub_cancel]
    rw [hr₁, hf_add]
    have hfDq : f (D • q) = 1 := by
      dsimp only [f]
      rw [map_nsmul, nsmul_eq_mul]
      have hexp :
          2 * (Real.pi : ℂ) * Complex.I *
            ((((D : ℤ) * Algebra.trace ℤ R q : ℤ) : ℂ)) / (D : ℂ) =
          ((Algebra.trace ℤ R q : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast
        field_simp [hDc_ne]
      rw [hexp]
      exact Complex.exp_int_mul_two_pi_mul_I (Algebra.trace ℤ R q)
    rw [hfDq, mul_one]
  have hψ_mk : ∀ r : R, ψ (Ideal.Quotient.mk I_D r) = f r := by
    intro r
    apply hf_per
    rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Ideal.Quotient.mk_out (Ideal.Quotient.mk I_D r)
  have hψ_add : ∀ a b : A_D, ψ (a + b) = ψ a * ψ b := by
    intro a b
    refine Quotient.inductionOn₂ a b (fun r₁ r₂ => ?_)
    change ψ (Ideal.Quotient.mk I_D r₁ + Ideal.Quotient.mk I_D r₂) =
      ψ (Ideal.Quotient.mk I_D r₁) * ψ (Ideal.Quotient.mk I_D r₂)
    rw [← map_add, hψ_mk, hψ_mk, hψ_mk, hf_add]
  have hψ_zero : ψ 0 = 1 := by
    change ψ (Ideal.Quotient.mk I_D 0) = 1
    rw [hψ_mk, hf_zero]
  have hψ_neg : ∀ a : A_D, ψ (-a) = starRingEnd ℂ (ψ a) := by
    intro a
    refine Quotient.inductionOn a (fun r => ?_)
    change ψ (-Ideal.Quotient.mk I_D r) = starRingEnd ℂ (ψ (Ideal.Quotient.mk I_D r))
    rw [← map_neg, hψ_mk, hψ_mk, hf_neg]
  let γbar : A_D := Ideal.Quotient.mk I_D γ
  have h_sum : traceGaussSum D γ = ∑ x : A_D, ψ (γbar * x ^ 2) := by
    dsimp only [traceGaussSum]
    rw [dif_pos hI_D]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    have hx : γbar * x ^ 2 = Ideal.Quotient.mk I_D (γ * (Quotient.out x) ^ 2) := by
      rw [map_mul, map_pow, Ideal.Quotient.mk_out]
    rw [hx, hψ_mk]
  let S : ℂ := traceGaussSum D γ
  have h_orth : (Complex.normSq S : ℂ) =
      ∑ h : A_D, ψ (γbar * h ^ 2) * (∑ y : A_D, ψ (2 * γbar * h * y)) := by
    calc (Complex.normSq S : ℂ)
      _ = S * starRingEnd ℂ S := (Complex.mul_conj S).symm
      _ = (∑ x : A_D, ψ (γbar * x ^ 2)) * (∑ y : A_D, starRingEnd ℂ (ψ (γbar * y ^ 2))) := by
          rw [show S = traceGaussSum D γ from rfl, h_sum, map_sum]
      _ = (∑ x : A_D, ψ (γbar * x ^ 2)) * (∑ y : A_D, ψ (-(γbar * y ^ 2))) := by
          congr 1
          refine Finset.sum_congr rfl (fun y _ => (hψ_neg (γbar * y ^ 2)).symm)
      _ = ∑ x : A_D, ∑ y : A_D, ψ (γbar * x ^ 2) * ψ (-(γbar * y ^ 2)) :=
          Finset.sum_mul_sum _ _ _ _
      _ = ∑ y : A_D, ∑ x : A_D, ψ (γbar * x ^ 2 + -(γbar * y ^ 2)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun y _ => Finset.sum_congr rfl (fun x _ => ?_))
          rw [hψ_add]
      _ = ∑ y : A_D, ∑ h : A_D, ψ (γbar * h ^ 2 + 2 * γbar * h * y) := by
          refine Finset.sum_congr rfl (fun y _ => ?_)
          rw [← Equiv.sum_comp (Equiv.addLeft y)]
          refine Finset.sum_congr rfl (fun h _ => ?_)
          congr 1
          change γbar * (y + h) ^ 2 + -(γbar * y ^ 2) = γbar * h ^ 2 + 2 * γbar * h * y
          ring
      _ = ∑ h : A_D, ψ (γbar * h ^ 2) * (∑ y : A_D, ψ (2 * γbar * h * y)) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun h _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun y _ => hψ_add _ _)
  letI : DecidablePred (fun h : A_D => ∀ y : A_D, ψ (2 * γbar * h * y) = 1) :=
    Classical.decPred _
  have h_term : ∀ h : A_D,
      ψ (γbar * h ^ 2) * (∑ y : A_D, ψ (2 * γbar * h * y)) =
        if (∀ y : A_D, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_D : ℂ) else 0 := by
    intro h
    by_cases hh : ∀ y : A_D, ψ (2 * γbar * h * y) = 1
    · rw [if_pos hh]
      have h_inner : (∑ y : A_D, ψ (2 * γbar * h * y)) = (Fintype.card A_D : ℂ) := by
        calc (∑ y : A_D, ψ (2 * γbar * h * y))
          _ = ∑ _y : A_D, (1 : ℂ) := Finset.sum_congr rfl (fun y _ => hh y)
          _ = (Fintype.card A_D : ℂ) := by simp
      have h_quad : γbar * h ^ 2 = 2 * γbar * h * ((u : A_D) * h) := by
        calc γbar * h ^ 2
          _ = 1 * (γbar * h ^ 2) := (one_mul _).symm
          _ = ((2 : A_D) * (u : A_D)) * (γbar * h ^ 2) := by rw [h2u]
          _ = 2 * γbar * h * ((u : A_D) * h) := by ring
      have h_outer : ψ (γbar * h ^ 2) = 1 := by
        rw [h_quad]
        exact hh ((u : A_D) * h)
      rw [h_outer, h_inner, one_mul]
    · rw [if_neg hh]
      push_neg at hh
      rcases hh with ⟨y₀, hy₀⟩
      have h_shift : (∑ y : A_D, ψ (2 * γbar * h * y)) =
          (∑ y : A_D, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) := by
        calc (∑ y : A_D, ψ (2 * γbar * h * y))
          _ = ∑ y : A_D, ψ (2 * γbar * h * (y + y₀)) := by
              rw [← Equiv.sum_comp (Equiv.addRight y₀)]
              rfl
          _ = ∑ y : A_D, ψ (2 * γbar * h * y) * ψ (2 * γbar * h * y₀) := by
              refine Finset.sum_congr rfl (fun y _ => ?_)
              have h_lin : 2 * γbar * h * (y + y₀) = 2 * γbar * h * y + 2 * γbar * h * y₀ := by ring
              rw [h_lin, hψ_add]
          _ = (∑ y : A_D, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) :=
              (Finset.sum_mul _ _ _).symm
      have h_mul_zero : (∑ y : A_D, ψ (2 * γbar * h * y)) * (ψ (2 * γbar * h * y₀) - 1) = 0 := by
        linear_combination -h_shift
      have h_inner_zero : (∑ y : A_D, ψ (2 * γbar * h * y)) = 0 := by
        rcases mul_eq_zero.mp h_mul_zero with h0 | h1
        · exact h0
        · exact absurd (sub_eq_zero.mp h1) hy₀
      rw [h_inner_zero, mul_zero]
  have h_re : Complex.normSq S =
      ∑ h : A_D, (if (∀ y : A_D, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_D : ℝ) else 0) := by
    have h1 := congr_arg Complex.re h_orth
    rw [Complex.ofReal_re, Complex.re_sum] at h1
    rw [h1]
    refine Finset.sum_congr rfl (fun h _ => ?_)
    rw [h_term h]
    split_ifs <;> simp
  have h_nonneg : ∀ h ∈ (Finset.univ : Finset A_D),
      (0 : ℝ) ≤ (if (∀ y : A_D, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_D : ℝ) else 0) := by
    intro h _
    split_ifs
    · exact Nat.cast_nonneg _
    · exact le_rfl
  have h0_cond : ∀ y : A_D, ψ (2 * γbar * (0 : A_D) * y) = 1 := by
    intro y
    have h0_eq : 2 * γbar * (0 : A_D) * y = 0 := by ring
    rw [h0_eq, hψ_zero]
  have h_le : (Fintype.card A_D : ℝ) ≤ Complex.normSq S := by
    rw [h_re]
    have h_single := Finset.single_le_sum h_nonneg (Finset.mem_univ (0 : A_D))
    rw [if_pos h0_cond] at h_single
    exact h_single
  have h_card_pos : (0 : ℝ) < (Fintype.card A_D : ℝ) := by
    exact Nat.cast_pos.mpr Fintype.card_pos
  have h_normSq_pos : 0 < Complex.normSq S := lt_of_lt_of_le h_card_pos h_le
  exact Complex.normSq_pos.mp h_normSq_pos

theorem pfisterGaussSum_dyadicGaussModulus_ne_zero {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    pfisterGaussSum (dyadicGaussModulus K) α β ≠ 0 :=
by
  letI := Classical.propDecidable
  have h_pf_bin :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (α' β' : NumberField.RingOfIntegers K),
        localDyadicPfisterProd v α' β' =
          localDyadicBinaryGaussSum v 1 β' * starRingEnd ℂ (localDyadicBinaryGaussSum v α' β') ∧
        localDyadicPfisterProd v α' β' = localDyadicPfisterProd v β' α' ∧
        unitDyadicSym v α' β' = unitDyadicSym v β' α' := by
    intro v α' β'
    have h_neg : ∀ γ : NumberField.RingOfIntegers K,
        localDyadicTraceGaussSum v (-γ) = starRingEnd ℂ (localDyadicTraceGaussSum v γ) := by
      intro γ
      dsimp only [localDyadicTraceGaussSum]
      by_cases hIv : v.asIdeal ^ valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K) ≠ ⊥
      · rw [dif_pos hIv, dif_pos hIv, map_sum]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        rw [← Complex.exp_conj]
        congr 1
        have h_tr : Algebra.trace ℤ (NumberField.RingOfIntegers K)
            (localDyadicIdempotent v * -γ * (Quotient.out x) ^ 2) =
          -Algebra.trace ℤ (NumberField.RingOfIntegers K)
            (localDyadicIdempotent v * γ * (Quotient.out x) ^ 2) := by
          rw [← map_neg]
          congr 1
          ring
        rw [h_tr, Int.cast_neg]
        simp only [map_div₀, map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I,
          map_intCast, map_natCast]
        ring
      · rw [dif_neg hIv, dif_neg hIv, map_zero]
    refine ⟨?_, ?_, ?_⟩
    · dsimp only [localDyadicPfisterProd, localDyadicBinaryGaussSum]
      have h1 : (-1 : NumberField.RingOfIntegers K) * β' = -β' := neg_one_mul β'
      have h2 : -(-α' * β') = α' * β' := by ring
      rw [h1, map_mul, ← h_neg α', ← h_neg (-α' * β'), h2]
      ring
    · dsimp only [localDyadicPfisterProd]
      rw [mul_comm α' β']
      ring
    · dsimp only [unitDyadicSym]
      refine if_congr ?_ rfl rfl
      constructor
      · rintro ⟨x, y, z, hnot, hmem⟩
        refine ⟨x, z, y, ?_, ?_⟩
        · intro ⟨hx, hz, hy⟩
          exact hnot ⟨hx, hy, hz⟩
        · convert hmem using 1
          ring
      · rintro ⟨x, y, z, hnot, hmem⟩
        refine ⟨x, z, y, ?_, ?_⟩
        · intro ⟨hx, hz, hy⟩
          exact hnot ⟨hx, hy, hz⟩
        · convert hmem using 1
          ring
  have h_loc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        localDyadicPfisterProd v α β =
          ((unitDyadicSym v α β : ℤ) : ℂ) * (localDyadicPosWeight v α β : ℂ) ∧
        0 < localDyadicPosWeight v α β := by
    intro v h2v
    dsimp only [localDyadicPosWeight]
    by_cases hαv : α ∉ v.asIdeal
    · rw [if_pos hαv]
      have h_ne := localDyadicBinaryGaussSum_one_ne_zero v h2v β hβ (h_sqfree v h2v).2
      have h_pos : 0 < Complex.normSq (localDyadicBinaryGaussSum v 1 β) :=
        Complex.normSq_pos.mpr h_ne
      have h_pf := (h_pf_bin v α β).1
      have h_bin := localDyadicBinaryGaussSum_eq_unitDyadicSym_mul v h2v α β hαv hβ (h_sqfree v h2v).2
      refine ⟨?_, h_pos⟩
      rw [h_pf, h_bin, map_mul, map_intCast]
      calc localDyadicBinaryGaussSum v 1 β *
            (((unitDyadicSym v α β : ℤ) : ℂ) * starRingEnd ℂ (localDyadicBinaryGaussSum v 1 β))
        _ = ((unitDyadicSym v α β : ℤ) : ℂ) *
              (localDyadicBinaryGaussSum v 1 β * starRingEnd ℂ (localDyadicBinaryGaussSum v 1 β)) := by ring
        _ = ((unitDyadicSym v α β : ℤ) : ℂ) *
              (Complex.normSq (localDyadicBinaryGaussSum v 1 β) : ℂ) := by rw [Complex.mul_conj]
    · rw [if_neg hαv]
      have hα_in : α ∈ v.asIdeal := not_not.mp hαv
      have hβv : β ∉ v.asIdeal := fun hβ_in => h_all_coprime v ⟨hα_in, hβ_in⟩
      have h_ne := localDyadicBinaryGaussSum_one_ne_zero v h2v α hα (h_sqfree v h2v).1
      have h_pos : 0 < Complex.normSq (localDyadicBinaryGaussSum v 1 α) :=
        Complex.normSq_pos.mpr h_ne
      have h_sym_pf := (h_pf_bin v α β).2.1
      have h_sym_sym := (h_pf_bin v α β).2.2
      have h_pf := (h_pf_bin v β α).1
      have h_bin := localDyadicBinaryGaussSum_eq_unitDyadicSym_mul v h2v β α hβv hα (h_sqfree v h2v).1
      refine ⟨?_, h_pos⟩
      rw [h_sym_pf, h_pf, h_bin, ← h_sym_sym, map_mul, map_intCast]
      calc localDyadicBinaryGaussSum v 1 α *
            (((unitDyadicSym v α β : ℤ) : ℂ) * starRingEnd ℂ (localDyadicBinaryGaussSum v 1 α))
        _ = ((unitDyadicSym v α β : ℤ) : ℂ) *
              (localDyadicBinaryGaussSum v 1 α * starRingEnd ℂ (localDyadicBinaryGaussSum v 1 α)) := by ring
        _ = ((unitDyadicSym v α β : ℤ) : ℂ) *
              (Complex.normSq (localDyadicBinaryGaussSum v 1 α) : ℂ) := by rw [Complex.mul_conj]
  have hI2 : (Ideal.span {(2 : NumberField.RingOfIntegers K)} :
      Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact two_ne_zero
  have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal}.Finite := by
    refine (Ideal.finite_factors hI2).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  let f_u : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℤˣ :=
    fun v => if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then unitDyadicSym v α β else 1
  let f_w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℝ :=
    fun v => if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then localDyadicPosWeight v α β else 1
  let f_uC : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℂ :=
    fun v => ((f_u v : ℤ) : ℂ)
  let f_wC : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℂ :=
    fun v => (f_w v : ℂ)
  have h_supp_u : Function.mulSupport f_u ⊆
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal} := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg hnot)
  have h_supp_w : Function.mulSupport f_w ⊆
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal} := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg hnot)
  have h_supp_uC : (Function.mulSupport f_uC).Finite := by
    refine hfin2.subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    apply hv
    dsimp [f_uC, f_u]
    rw [if_neg hnot]
    simp
  have h_supp_wC : (Function.mulSupport f_wC).Finite := by
    refine hfin2.subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    apply hv
    dsimp [f_wC, f_w]
    rw [if_neg hnot]
    simp
  have h_prod_congr :
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          localDyadicPfisterProd v α β
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        f_uC v * f_wC v) := by
    refine finprod_congr (fun v => ?_)
    dsimp [f_uC, f_wC, f_u, f_w]
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, if_pos h2v]
      exact (h_loc v h2v).1
    · rw [if_neg h2v, if_neg h2v, if_neg h2v]
      simp
  let uToC : ℤˣ →* ℂ := (Int.castRingHom ℂ).toMonoidHom.comp (Units.coeHom ℤ)
  let rToC : ℝ →* ℂ := Complex.ofRealHom.toMonoidHom
  have h_map_u : (∏ᶠ v, f_uC v) = ((unitDyadicProd α β : ℤ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod uToC (hfin2.subset h_supp_u)).symm
    exact h1
  have h_map_w : (∏ᶠ v, f_wC v) = ((∏ᶠ v, f_w v : ℝ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod rToC (hfin2.subset h_supp_w)).symm
    exact h1
  have hW_pos : 0 < (∏ᶠ v, f_w v) := by
    rw [finprod_eq_prod f_w (hfin2.subset h_supp_w)]
    refine Finset.prod_pos (fun v _ => ?_)
    dsimp [f_w]
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos h2v]
      exact (h_loc v h2v).2
    · rw [if_neg h2v]
      exact zero_lt_one
  have h_pf_eq : dyadicPfisterGaussSum α β =
      ((unitDyadicProd α β : ℤ) : ℝ) * (∏ᶠ v, f_w v) := by
    rw [dyadicPfisterGaussSum_eq_re_finprod_local α β, h_prod_congr,
      finprod_mul_distrib h_supp_uC h_supp_wC, h_map_u, h_map_w]
    rw [← Complex.ofReal_intCast (unitDyadicProd α β : ℤ), ← Complex.ofReal_mul, Complex.ofReal_re]
  change dyadicPfisterGaussSum α β ≠ 0
  rw [h_pf_eq]
  refine mul_ne_zero ?_ (ne_of_gt hW_pos)
  rcases Int.units_eq_one_or (unitDyadicProd α β) with hu | hu
  · rw [hu]
    norm_num
  · rw [hu]
    norm_num

theorem pfisterGaussSign_mul_oddPfisterModulus_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    pfisterGaussSign (dyadicGaussModulus K * oddPfisterModulus α β) α β =
      dyadicGaussSign α β * pfisterGaussSign (oddPfisterModulus α β) α β :=
by
  letI := Classical.propDecidable
  have h1 := traceGaussSum_mul_oddPfisterModulus α β hα hβ (1 : NumberField.RingOfIntegers K)
  have h2 := traceGaussSum_mul_oddPfisterModulus α β hα hβ (-α)
  have h3 := traceGaussSum_mul_oddPfisterModulus α β hα hβ (-β)
  have h4 := traceGaussSum_mul_oddPfisterModulus α β hα hβ (α * β)
  have h_prod :
      traceGaussSum (dyadicGaussModulus K * oddPfisterModulus α β)
          (1 : NumberField.RingOfIntegers K) *
        traceGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) (-α) *
        traceGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) (-β) *
        traceGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) (α * β) =
      (traceGaussSum (dyadicGaussModulus K) (1 : NumberField.RingOfIntegers K) *
        traceGaussSum (dyadicGaussModulus K) (-α) *
        traceGaussSum (dyadicGaussModulus K) (-β) *
        traceGaussSum (dyadicGaussModulus K) (α * β)) *
      (traceGaussSum (oddPfisterModulus α β)
          ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * 1) *
        traceGaussSum (oddPfisterModulus α β)
          ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (-α)) *
        traceGaussSum (oddPfisterModulus α β)
          ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (-β)) *
        traceGaussSum (oddPfisterModulus α β)
          ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (α * β))) := by
    rw [h1, h2, h3, h4]
    ring
  have h_scale :=
    traceGaussSum_oddPfisterModulus_mul_dyadicGaussModulus_eq_pfisterGaussSum
      α β hα hβ h_all_coprime
  have h_re_mul :
      pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β =
        pfisterGaussSum (dyadicGaussModulus K) α β *
          pfisterGaussSum (oddPfisterModulus α β) α β := by
    dsimp only [pfisterGaussSum]
    rw [h_prod, h_scale, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      mul_zero, sub_zero]
    rfl
  have hD_ne : pfisterGaussSum (oddPfisterModulus α β) α β ≠ 0 := by
    rw [← Complex.ofReal_ne_zero, ← h_scale]
    exact mul_ne_zero
      (mul_ne_zero
        (mul_ne_zero
          (traceGaussSum_oddPfisterModulus_ne_zero α β hα hβ _)
          (traceGaussSum_oddPfisterModulus_ne_zero α β hα hβ _))
        (traceGaussSum_oddPfisterModulus_ne_zero α β hα hβ _))
      (traceGaussSum_oddPfisterModulus_ne_zero α β hα hβ _)
  have hM_ne : pfisterGaussSum (dyadicGaussModulus K) α β ≠ 0 :=
    pfisterGaussSum_dyadicGaussModulus_ne_zero α β hα hβ h_all_coprime h_sqfree
  change (if 0 < pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β
      then (1 : ℤˣ) else -1) =
    (if 0 < pfisterGaussSum (dyadicGaussModulus K) α β then (1 : ℤˣ) else -1) *
      (if 0 < pfisterGaussSum (oddPfisterModulus α β) α β then (1 : ℤˣ) else -1)
  rw [h_re_mul]
  rcases lt_trichotomy 0 (pfisterGaussSum (dyadicGaussModulus K) α β) with hM_pos | hM_eq | hM_neg
  · rcases lt_trichotomy 0 (pfisterGaussSum (oddPfisterModulus α β) α β) with hD_pos | hD_eq | hD_neg
    · rw [if_pos (mul_pos hM_pos hD_pos), if_pos hM_pos, if_pos hD_pos, mul_one]
    · exact absurd hD_eq.symm hD_ne
    · have hMD_neg : pfisterGaussSum (dyadicGaussModulus K) α β *
          pfisterGaussSum (oddPfisterModulus α β) α β < 0 :=
        mul_neg_of_pos_of_neg hM_pos hD_neg
      rw [if_neg (not_lt_of_gt hMD_neg), if_pos hM_pos, if_neg (not_lt_of_gt hD_neg), one_mul]
  · exact absurd hM_eq.symm hM_ne
  · rcases lt_trichotomy 0 (pfisterGaussSum (oddPfisterModulus α β) α β) with hD_pos | hD_eq | hD_neg
    · have hMD_neg : pfisterGaussSum (dyadicGaussModulus K) α β *
          pfisterGaussSum (oddPfisterModulus α β) α β < 0 :=
        mul_neg_of_neg_of_pos hM_neg hD_pos
      rw [if_neg (not_lt_of_gt hMD_neg), if_neg (not_lt_of_gt hM_neg), if_pos hD_pos, mul_one]
    · exact absurd hD_eq.symm hD_ne
    · have hMD_pos : 0 < pfisterGaussSum (dyadicGaussModulus K) α β *
          pfisterGaussSum (oddPfisterModulus α β) α β :=
        mul_pos_of_neg_of_neg hM_neg hD_neg
      rw [if_pos hMD_pos, if_neg (not_lt_of_gt hM_neg), if_neg (not_lt_of_gt hD_neg)]
      rfl

theorem localModulusPfisterProd_eq_localModulusBinaryGaussSum {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    localModulusPfisterProd (oddPfisterModulus α β) v α β =
      localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β *
        starRingEnd ℂ (localModulusBinaryGaussSum (oddPfisterModulus α β) v α β) ∧
    localModulusPfisterProd (oddPfisterModulus α β) v α β =
      localModulusPfisterProd (oddPfisterModulus β α) v β α ∧
    oddPfisterModulus α β = oddPfisterModulus β α ∧
    ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ≠ 0 ∧
    (((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal →
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal) ∧
    ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
      (α ∈ v.asIdeal ∨ β ∈ v.asIdeal) →
      ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal) :=
by
  letI := Classical.propDecidable
  have h_neg : ∀ (m : ℕ) (γ : NumberField.RingOfIntegers K),
      localModulusTraceGaussSum m v (-γ) = starRingEnd ℂ (localModulusTraceGaussSum m v γ) := by
    intro m γ
    dsimp only [localModulusTraceGaussSum]
    by_cases hIv : v.asIdeal ^ valNat v (m : NumberField.RingOfIntegers K) ≠ ⊥
    · rw [dif_pos hIv, dif_pos hIv, map_sum]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      rw [← Complex.exp_conj]
      congr 1
      have h_tr : Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localModulusIdempotent m v * -γ * (Quotient.out x) ^ 2) =
        -Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localModulusIdempotent m v * γ * (Quotient.out x) ^ 2) := by
        rw [← map_neg]
        congr 1
        ring
      rw [h_tr, Int.cast_neg]
      simp only [map_div₀, map_mul, map_ofNat, Complex.conj_ofReal, Complex.conj_I,
        map_intCast, map_natCast]
      ring
    · rw [dif_neg hIv, dif_neg hIv, map_zero]
  have hD_symm : oddPfisterModulus α β = oddPfisterModulus β α := by
    dsimp only [oddPfisterModulus]
    rw [mul_comm α β]
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ne : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : (Algebra.norm ℤ (α * β)).natAbs ≠ 0 := by
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ne
  have h_odd_pos : 0 < oddPartNat (Algebra.norm ℤ (α * β)).natAbs :=
    Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < oddPfisterModulus α β := pow_pos h_odd_pos _
  have hD_ne : ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
    Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  refine ⟨?_, ?_, hD_symm, hD_ne, ?_, ?_⟩
  · dsimp only [localModulusPfisterProd, localModulusBinaryGaussSum]
    have h1 : (-1 : NumberField.RingOfIntegers K) * β = -β := neg_one_mul β
    have h2 : -(-α * β) = α * β := by ring
    rw [h1, map_mul, ← h_neg (oddPfisterModulus α β) α, ← h_neg (oddPfisterModulus α β) (-α * β), h2]
    ring
  · rw [hD_symm]
    dsimp only [localModulusPfisterProd]
    rw [mul_comm α β]
    ring
  · intro hDv h2v
    have h_not_dvd : ¬ 2 ∣ oddPartNat (Algebra.norm ℤ (α * β)).natAbs :=
      Nat.not_dvd_ordCompl Nat.prime_two hn_ne
    have h_cop_base : Nat.Coprime 2 (oddPartNat (Algebra.norm ℤ (α * β)).natAbs) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h_not_dvd
    have h_cop : Nat.Coprime 2 (oddPfisterModulus α β) :=
      h_cop_base.pow_right (2 * Module.finrank ℚ K + 2)
    have h_bez := Nat.gcd_eq_gcd_ab 2 (oddPfisterModulus α β)
    rw [h_cop.gcd_eq_one] at h_bez
    have h_bez_R : (1 : NumberField.RingOfIntegers K) =
        (2 : NumberField.RingOfIntegers K) * (Nat.gcdA 2 (oddPfisterModulus α β) : NumberField.RingOfIntegers K) +
        ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) *
          (Nat.gcdB 2 (oddPfisterModulus α β) : NumberField.RingOfIntegers K) := by
      have h := congr_arg (Int.cast : ℤ → NumberField.RingOfIntegers K) h_bez
      push_cast at h
      exact h
    have h1_mem : (1 : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
      rw [h_bez_R]
      exact Ideal.add_mem v.asIdeal (Ideal.mul_mem_right _ v.asIdeal h2v)
        (Ideal.mul_mem_right _ v.asIdeal hDv)
    exact v.isPrime.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_mem)
  · intro h2v hab_or
    have hab_mem : α * β ∈ v.asIdeal := by
      rcases hab_or with hαv | hβv
      · exact Ideal.mul_mem_right β v.asIdeal hαv
      · exact Ideal.mul_mem_left v.asIdeal α hβv
    have hn_mem : (((Algebra.norm ℤ (α * β)).natAbs : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
      rw [← Ideal.absNorm_span_singleton (α * β)]
      exact ((Ideal.span_singleton_le_iff_mem v.asIdeal).mpr hab_mem)
        (Ideal.absNorm_mem (Ideal.span {α * β}))
    have h_mul_eq : 2 ^ ((Algebra.norm ℤ (α * β)).natAbs.factorization 2) *
        oddPartNat (Algebra.norm ℤ (α * β)).natAbs = (Algebra.norm ℤ (α * β)).natAbs :=
      Nat.ordProj_mul_ordCompl_eq_self (Algebra.norm ℤ (α * β)).natAbs 2
    have h_prod_mem : ((2 : NumberField.RingOfIntegers K) ^ ((Algebra.norm ℤ (α * β)).natAbs.factorization 2)) *
        ((oddPartNat (Algebra.norm ℤ (α * β)).natAbs : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
      have h_cast := congr_arg (Nat.cast : ℕ → NumberField.RingOfIntegers K) h_mul_eq
      push_cast at h_cast
      rw [h_cast]
      exact hn_mem
    have h_odd_mem : ((oddPartNat (Algebra.norm ℤ (α * β)).natAbs : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
      rcases v.isPrime.mem_or_mem h_prod_mem with h2pow | hodd
      · exfalso
        exact h2v (v.isPrime.mem_of_pow_mem _ h2pow)
      · exact hodd
    dsimp only [oddPfisterModulus]
    rw [Nat.cast_pow]
    exact Ideal.pow_mem_of_mem v.asIdeal h_odd_mem (2 * Module.finrank ℚ K + 2)
      (Nat.succ_pos (2 * Module.finrank ℚ K + 1))

theorem pfisterGaussSum_oddPfisterModulus_eq_re_finprod_local {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    haveI := Classical.propDecidable
    pfisterGaussSum (oddPfisterModulus α β) α β =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          localModulusPfisterProd (oddPfisterModulus α β) v α β
        else 1).re :=
by
  letI := Classical.propDecidable
  let R := NumberField.RingOfIntegers K
  let D : ℕ := oddPfisterModulus α β
  let I : Ideal R := Ideal.span {((D : ℕ) : R)}
  let Iv : IsDedekindDomain.HeightOneSpectrum R → Ideal R :=
    fun v => v.asIdeal ^ (valNat v ((D : ℕ) : R))
  
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : (Algebra.norm ℤ (α * β)).natAbs ≠ 0 := by
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat (Algebra.norm ℤ (α * β)).natAbs :=
    Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos (2 * Module.finrank ℚ K + 2)
  have hD_ne : D ≠ 0 := ne_of_gt hD_pos
  have hDR_ne : ((D : ℕ) : R) ≠ 0 := Nat.cast_ne_zero.mpr hD_ne
  have hval0 : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      ((D : ℕ) : R) ∉ v.asIdeal → valNat v ((D : ℕ) : R) = 0 := by
    intro v hDv
    have hval1 : v.intValuation ((D : ℕ) : R) = 1 :=
      v.intValuation_eq_one_iff.mpr hDv
    dsimp [valNat]
    rw [hval1, WithZero.log_one]
    rfl
  have hI0 : I ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hDR_ne
  have hfinD : {v : IsDedekindDomain.HeightOneSpectrum R | ((D : ℕ) : R) ∈ v.asIdeal}.Finite := by
    refine (Ideal.finite_factors hI0).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  let S : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfinD.toFinset
  have hS : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      v ∉ S → valNat v ((D : ℕ) : R) = 0 := by
    intro v hvS
    have hDv : ((D : ℕ) : R) ∉ v.asIdeal := fun hD => hvS (hfinD.mem_toFinset.mpr hD)
    exact hval0 v hDv
  
  have hI : I ≠ ⊥ := by
    rw [ne_eq, Ideal.span_singleton_eq_bot]
    exact hDR_ne
  have h_maxPow : ∀ v : IsDedekindDomain.HeightOneSpectrum R, v.maxPowDividing I = Iv v := by
    intro v
    dsimp [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, Iv, valNat]
    rw [v.intValuation_def, if_neg hDR_ne, WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have h_supp : Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum R => v.maxPowDividing I) ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport, h_maxPow] at hv
    by_contra hvS
    have h0 : valNat v ((D : ℕ) : R) = 0 := hS v hvS
    apply hv
    dsimp [Iv]
    rw [h0, pow_zero]
  have hI_prod : I = ∏ v ∈ S, Iv v := by
    calc I = ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R, v.maxPowDividing I :=
          (Ideal.finprod_heightOneSpectrum_factorization hI0).symm
      _ = ∏ v ∈ S, v.maxPowDividing I :=
          finprod_eq_prod_of_mulSupport_subset _ h_supp
      _ = ∏ v ∈ S, Iv v := Finset.prod_congr rfl (fun v _ => h_maxPow v)
  have hI_inf : I = S.inf Iv := by
    rw [hI_prod]
    symm
    refine IsDedekindDomain.inf_prime_pow_eq_prod S (fun v => v.asIdeal)
      (fun v => valNat v ((D : ℕ) : R)) (fun v _ => v.prime) ?_
    intro u _ v _ huv h_eq
    exact huv (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
  have h_inf : I = ⨅ i : S, Iv i.1 := by
    rw [hI_inf, Finset.inf_eq_iInf, iInf_subtype]
  have h_cop_pair : ∀ u v : IsDedekindDomain.HeightOneSpectrum R, u ≠ v → IsCoprime (Iv u) (Iv v) := by
    intro u v huv
    have h_ne : u.asIdeal ≠ v.asIdeal := fun h_eq => huv (IsDedekindDomain.HeightOneSpectrum.ext h_eq)
    exact (Ideal.isCoprime_of_isMaximal h_ne).pow
  have h_cop : Pairwise (Function.onFun IsCoprime (fun i : S => Iv i.1)) := by
    intro i j hij
    exact h_cop_pair i.1 j.1 (Subtype.ext_iff.not.mp hij)
  have h_idem : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      IsLocalModulusIdempotent D v (localModulusIdempotent D v) := by
    intro v
    have h_ex : ∃ e : R, IsLocalModulusIdempotent D v e := by
      by_cases hvS : v ∈ S
      · have hI_split : I = Iv v * ∏ u ∈ S.erase v, Iv u := by
          rw [hI_prod, ← Finset.mul_prod_erase S Iv hvS]
        have h_cop_prod : IsCoprime (Iv v) (∏ u ∈ S.erase v, Iv u) := by
          refine IsCoprime.prod_right (fun u hu => ?_)
          exact h_cop_pair v u (Finset.ne_of_mem_erase hu).symm
        obtain ⟨a, ha, e, he, hae⟩ := Ideal.isCoprime_iff_exists.mp h_cop_prod
        refine ⟨e, ?_, ?_⟩
        · have h1e : 1 - e = a := by linear_combination hae.symm
          rw [h1e]
          exact ha
        · intro y hy
          change e * y ∈ I
          rw [hI_split, mul_comm e y]
          exact Ideal.mul_mem_mul hy he
      · refine ⟨0, ?_, ?_⟩
        · have h0 : valNat v ((D : ℕ) : R) = 0 := hS v hvS
          change 1 - (0 : R) ∈ v.asIdeal ^ (valNat v ((D : ℕ) : R))
          rw [h0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · intro y _
          rw [zero_mul]
          exact I.zero_mem
    dsimp [localModulusIdempotent]
    rw [dif_pos h_ex]
    exact Classical.choose_spec h_ex
  have h_sum : (1 : R) - (∑ v ∈ S, localModulusIdempotent D v) ∈ I := by
    rw [hI_inf, Submodule.mem_finsetInf]
    intro v hv
    rw [← Finset.add_sum_erase S (fun u => localModulusIdempotent D u) hv]
    have h_eq : (1 : R) - (localModulusIdempotent D v + ∑ u ∈ S.erase v, localModulusIdempotent D u) =
        (1 - localModulusIdempotent D v) - ∑ u ∈ S.erase v, localModulusIdempotent D u := by ring
    rw [h_eq]
    refine (Iv v).sub_mem (h_idem v).1 ((Iv v).sum_mem (fun u hu => ?_))
    have huv : u ≠ v := Finset.ne_of_mem_erase hu
    obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.mp (h_cop_pair u v huv)
    have heu : localModulusIdempotent D u = localModulusIdempotent D u * a + localModulusIdempotent D u * b := by
      calc localModulusIdempotent D u = localModulusIdempotent D u * 1 := (mul_one _).symm
        _ = localModulusIdempotent D u * (a + b) := by rw [hab]
        _ = localModulusIdempotent D u * a + localModulusIdempotent D u * b := mul_add _ _ _
    rw [heu]
    have hea : localModulusIdempotent D u * a ∈ Iv v := by
      have h_in_I : localModulusIdempotent D u * a ∈ I := (h_idem u).2 a ha
      rw [hI_inf, Submodule.mem_finsetInf] at h_in_I
      exact h_in_I v hv
    have heb : localModulusIdempotent D u * b ∈ Iv v := (Iv v).mul_mem_left _ hb
    exact (Iv v).add_mem hea heb
  
  have h_exp : ∀ (γ x : R) (y : IsDedekindDomain.HeightOneSpectrum R → R),
      (∀ v ∈ S, x - y v ∈ Iv v) →
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (γ * x ^ 2) : ℤ) : ℂ) / (D : ℂ)) =
      ∏ v ∈ S, Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (localModulusIdempotent D v * γ * (y v) ^ 2) : ℤ) : ℂ) / (D : ℂ)) := by
    intro γ x y hy
    have h_mem : γ * x ^ 2 - ∑ v ∈ S, localModulusIdempotent D v * γ * (y v) ^ 2 ∈ I := by
      have h_alg : γ * x ^ 2 - ∑ v ∈ S, localModulusIdempotent D v * γ * (y v) ^ 2 =
          ((1 : R) - ∑ v ∈ S, localModulusIdempotent D v) * (γ * x ^ 2) +
          ∑ v ∈ S, localModulusIdempotent D v * (γ * (x + y v) * (x - y v)) := by
        have h1 : ((1 : R) - ∑ v ∈ S, localModulusIdempotent D v) * (γ * x ^ 2) =
            γ * x ^ 2 - ∑ v ∈ S, localModulusIdempotent D v * (γ * x ^ 2) := by
          rw [sub_mul, one_mul, Finset.sum_mul]
        have h2 : ∑ v ∈ S, localModulusIdempotent D v * (γ * (x + y v) * (x - y v)) =
            (∑ v ∈ S, localModulusIdempotent D v * (γ * x ^ 2)) -
            ∑ v ∈ S, localModulusIdempotent D v * γ * (y v) ^ 2 := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun v _ => ?_)
          ring
        rw [h1, h2]
        ring
      rw [h_alg]
      refine I.add_mem (I.mul_mem_right (γ * x ^ 2) h_sum) (I.sum_mem (fun v hv => ?_))
      have h_diff_in : γ * (x + y v) * (x - y v) ∈ Iv v :=
        (Iv v).mul_mem_left (γ * (x + y v)) (hy v hv)
      exact (h_idem v).2 _ h_diff_in
    obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp h_mem
    have h_tr : Algebra.trace ℤ R (γ * x ^ 2) =
        (∑ v ∈ S, Algebra.trace ℤ R (localModulusIdempotent D v * γ * (y v) ^ 2)) +
        (D : ℤ) * Algebra.trace ℤ R q := by
      have hq' : γ * x ^ 2 = (∑ v ∈ S, localModulusIdempotent D v * γ * (y v) ^ 2) + D • q := by
        rw [nsmul_eq_mul]
        linear_combination hq
      calc Algebra.trace ℤ R (γ * x ^ 2)
        _ = Algebra.trace ℤ R ((∑ v ∈ S, localModulusIdempotent D v * γ * (y v) ^ 2) + D • q) := by
            rw [hq']
        _ = (∑ v ∈ S, Algebra.trace ℤ R (localModulusIdempotent D v * γ * (y v) ^ 2)) +
            (D : ℤ) * Algebra.trace ℤ R q := by
            rw [map_add, map_sum, map_nsmul, nsmul_eq_mul]
    let T0 : ℤ := ∑ v ∈ S, Algebra.trace ℤ R (localModulusIdempotent D v * γ * (y v) ^ 2)
    let k : ℤ := Algebra.trace ℤ R q
    have hDC : (D : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hD_ne
    have h_arg : 2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (γ * x ^ 2) : ℤ) : ℂ) / (D : ℂ) =
        2 * Real.pi * Complex.I * (T0 : ℂ) / (D : ℂ) +
        (k : ℂ) * (2 * Real.pi * Complex.I) := by
      rw [h_tr]
      change 2 * Real.pi * Complex.I * (((T0 + (D : ℤ) * k : ℤ) : ℂ)) / (D : ℂ) = _
      push_cast
      field_simp [hDC]
    rw [h_arg, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I k, mul_one]
    have h_sum_arg : 2 * Real.pi * Complex.I * (T0 : ℂ) / (D : ℂ) =
        ∑ v ∈ S, 2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (localModulusIdempotent D v * γ * (y v) ^ 2) : ℤ) : ℂ) / (D : ℂ) := by
      dsimp [T0]
      rw [Int.cast_sum, Finset.mul_sum, Finset.sum_div]
    rw [h_sum_arg, Complex.exp_sum]
  
  have h_trace : ∀ γ : R, traceGaussSum D γ = ∏ v ∈ S, localModulusTraceGaussSum D v γ := by
    intro γ
    have hIv : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Iv v ≠ ⊥ :=
      fun v => pow_ne_zero _ v.ne_bot
    haveI : Finite (R ⧸ I) := Ideal.finiteQuotientOfFreeOfNeBot I hI
    letI : Fintype (R ⧸ I) := Fintype.ofFinite (R ⧸ I)
    haveI : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Finite (R ⧸ Iv v) :=
      fun v => Ideal.finiteQuotientOfFreeOfNeBot (Iv v) (hIv v)
    letI : ∀ v : IsDedekindDomain.HeightOneSpectrum R, Fintype (R ⧸ Iv v) :=
      fun v => Fintype.ofFinite (R ⧸ Iv v)
    let f : S → Ideal R := fun i => Iv i.1
    let e_crt : (R ⧸ I) ≃ ((i : S) → R ⧸ f i) :=
      (Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf).toEquiv.trans
        (Ideal.quotientInfRingEquivPiQuotient f h_cop).toEquiv
    have h_out : ∀ (x : R ⧸ I) (i : S),
        Quotient.out x - Quotient.out (e_crt x i) ∈ f i := by
      intro x i
      have h_eval : e_crt x i = Ideal.Quotient.mk (f i) (Quotient.out x) := by
        change (Ideal.quotientInfRingEquivPiQuotient f h_cop)
          ((Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf) x) i = _
        have h_sub : (Submodule.quotEquivOfEq I (⨅ i : S, f i) h_inf) x =
            Ideal.Quotient.mk (⨅ i : S, f i) (Quotient.out x) := by
          conv_lhs => rw [← Ideal.Quotient.mk_out x, ← Ideal.Quotient.mk_eq_mk]
          rw [Submodule.quotEquivOfEq_mk, Ideal.Quotient.mk_eq_mk]
        rw [h_sub]
        exact Ideal.quotientInfToPiQuotient_mk' f (Quotient.out x) i
      have h_mk : Ideal.Quotient.mk (f i) (Quotient.out x) =
          Ideal.Quotient.mk (f i) (Quotient.out (e_crt x i)) := by
        rw [← h_eval, Ideal.Quotient.mk_out]
      exact Ideal.Quotient.eq.mp h_mk
    let ψ : ∀ v : IsDedekindDomain.HeightOneSpectrum R, (R ⧸ Iv v) → ℂ :=
      fun v w => Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (localModulusIdempotent D v * γ * (Quotient.out w) ^ 2) : ℤ) : ℂ) /
        (D : ℂ))
    have h_global : traceGaussSum D γ =
        ∑ x : R ⧸ I, ∏ i : S, ψ i.1 (e_crt x i) := by
      dsimp [traceGaussSum]
      rw [dif_pos hI]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      let y : IsDedekindDomain.HeightOneSpectrum R → R :=
        fun v => if hv : v ∈ S then Quotient.out (e_crt x ⟨v, hv⟩) else 0
      have hy : ∀ v ∈ S, Quotient.out x - y v ∈ Iv v := by
        intro v hv
        dsimp [y]
        rw [dif_pos hv]
        exact h_out x ⟨v, hv⟩
      rw [h_exp γ (Quotient.out x) y hy]
      rw [← Finset.prod_coe_sort S]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      dsimp [ψ, y]
      rw [if_pos i.2]
    have h_local : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
        localModulusTraceGaussSum D v γ = ∑ w : R ⧸ Iv v, ψ v w := by
      intro v
      dsimp [localModulusTraceGaussSum]
      rw [dif_pos (hIv v)]
    have h_reidx : (∑ x : R ⧸ I, ∏ i : S, ψ i.1 (e_crt x i)) =
        ∑ z : (i : S) → R ⧸ f i, ∏ i : S, ψ i.1 (z i) :=
      Equiv.sum_comp e_crt (fun z : (i : S) → R ⧸ f i => ∏ i : S, ψ i.1 (z i))
    rw [h_global, h_reidx, ← Fintype.prod_sum (fun (i : S) (w : R ⧸ f i) => ψ i.1 w)]
    rw [← Finset.prod_coe_sort S]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    exact (h_local i.1).symm
  
  have h_pfister_prod :
      traceGaussSum D (1 : R) * traceGaussSum D (-α) *
        traceGaussSum D (-β) * traceGaussSum D (α * β) =
      ∏ v ∈ S, localModulusPfisterProd D v α β := by
    rw [h_trace (1 : R), h_trace (-α), h_trace (-β), h_trace (α * β)]
    rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    rfl
  let g : IsDedekindDomain.HeightOneSpectrum R → ℂ :=
    fun v => if ((D : ℕ) : R) ∈ v.asIdeal then localModulusPfisterProd D v α β else 1
  have h_supp_g : Function.mulSupport g ⊆ ↑S := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Finset.mem_coe, hfinD.mem_toFinset, Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg hnot)
  have h_finprod_eq : (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R, g v) =
      ∏ v ∈ S, localModulusPfisterProd D v α β := by
    rw [finprod_eq_prod_of_mulSupport_subset g h_supp_g]
    refine Finset.prod_congr rfl (fun v hv => ?_)
    have hDv : ((D : ℕ) : R) ∈ v.asIdeal := hfinD.mem_toFinset.mp hv
    exact if_pos hDv
  dsimp only [pfisterGaussSum]
  rw [h_pfister_prod, ← h_finprod_eq]

theorem localModulusBinaryGaussSum_one_ne_zero {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal) :
    localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β ≠ 0 ∧
      0 < (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) :=
by
  let R := NumberField.RingOfIntegers K
  haveI : Finite (R ⧸ v.asIdeal) := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  have h_q_pos : 0 < (Nat.card (R ⧸ v.asIdeal) : ℝ) := Nat.cast_pos.mpr Nat.card_pos
  let n : ℕ := (Algebra.norm ℤ (α * β)).natAbs
  let D : ℕ := oddPfisterModulus α β
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : n ≠ 0 := by
    change (Algebra.norm ℤ (α * β)).natAbs ≠ 0
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat n := Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos (2 * Module.finrank ℚ K + 2)
  have h_not_dvd_odd : ¬ 2 ∣ oddPartNat n := Nat.not_dvd_ordCompl Nat.prime_two hn_ne
  have h_cop_odd : Nat.Coprime 2 (oddPartNat n) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h_not_dvd_odd
  have h_cop : Nat.Coprime 2 D := h_cop_odd.pow_right (2 * Module.finrank ℚ K + 2)
  have h_not_dvd_D : ¬ 2 ∣ D :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mp h_cop
  let u : ℕ := (D + 1) / 2
  have hu : 2 * u = D + 1 := by omega
  have hD_ne : ((D : ℕ) : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  have hDc_ne : (D : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  let I_D : Ideal R := Ideal.span {((D : ℕ) : R)}
  let Iv : Ideal R := v.asIdeal ^ (valNat v ((D : ℕ) : R))
  have hIv : Iv ≠ ⊥ := pow_ne_zero _ v.ne_bot
  let A_v := R ⧸ Iv
  haveI : Finite A_v := Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
  letI : Fintype A_v := Fintype.ofFinite A_v
  have hD_mem_Iv : ((D : ℕ) : R) ∈ Iv := by
    rw [← Ideal.span_singleton_le_iff_mem, ← Ideal.dvd_iff_le,
      ← v.intValuation_le_pow_iff_dvd ((D : ℕ) : R) (valNat v ((D : ℕ) : R))]
    dsimp only [valNat]
    rw [v.intValuation_def, if_neg hD_ne, WithZero.log_exp, neg_neg, Int.toNat_natCast]
  have hD_zero : ((D : ℕ) : A_v) = 0 := by
    change Ideal.Quotient.mk Iv ((D : ℕ) : R) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hD_mem_Iv
  have h2u : (2 : A_v) * (u : A_v) = 1 := by
    calc (2 : A_v) * (u : A_v)
      _ = ((2 * u : ℕ) : A_v) := by push_cast; rfl
      _ = ((D + 1 : ℕ) : A_v) := by rw [hu]
      _ = ((D : ℕ) : A_v) + 1 := by push_cast; rfl
      _ = 1 := by rw [hD_zero, zero_add]
  let e_v : R := localModulusIdempotent D v
  have he_mul_mem : ∀ y ∈ Iv, e_v * y ∈ I_D := by
    intro y hy
    dsimp only [e_v, localModulusIdempotent]
    by_cases hex : ∃ e : R, IsLocalModulusIdempotent D v e
    · rw [dif_pos hex]
      exact (Classical.choose_spec hex).2 y hy
    · rw [dif_neg hex, zero_mul]
      exact I_D.zero_mem
  let f : R → ℂ := fun r =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R (e_v * r) : ℤ) : ℂ) / (D : ℂ))
  let ψ : A_v → ℂ := fun x => f (Quotient.out x)
  have hf_add : ∀ r₁ r₂ : R, f (r₁ + r₂) = f r₁ * f r₂ := by
    intro r₁ r₂
    dsimp only [f]
    rw [mul_add, map_add, Int.cast_add, ← Complex.exp_add]
    congr 1
    ring
  have hf_zero : f 0 = 1 := by
    dsimp only [f]
    rw [mul_zero, map_zero, Int.cast_zero, mul_zero, zero_div, Complex.exp_zero]
  have hf_neg : ∀ r : R, f (-r) = starRingEnd ℂ (f r) := by
    intro r
    dsimp only [f]
    rw [mul_neg, map_neg, Int.cast_neg, ← Complex.exp_conj]
    congr 1
    simp [Complex.conj_ofReal, Complex.conj_I, map_ofNat]
  have hf_per : ∀ r₁ r₂ : R, r₁ - r₂ ∈ Iv → f r₁ = f r₂ := by
    intro r₁ r₂ hmem
    have he_mem : e_v * (r₁ - r₂) ∈ I_D := he_mul_mem (r₁ - r₂) hmem
    rw [Ideal.mem_span_singleton] at he_mem
    rcases he_mem with ⟨q, hq⟩
    have hr₁ : e_v * r₁ = e_v * r₂ + D • q := by
      rw [nsmul_eq_mul, ← hq, mul_sub, add_sub_cancel]
    have hf_eq : f r₁ =
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (e_v * r₂ + D • q) : ℤ) : ℂ) / (D : ℂ)) := by
      dsimp only [f]
      rw [hr₁]
    rw [hf_eq, map_add, Int.cast_add]
    have h_split :
        2 * (Real.pi : ℂ) * Complex.I *
          (((Algebra.trace ℤ R (e_v * r₂) : ℤ) : ℂ) +
            ((Algebra.trace ℤ R (D • q) : ℤ) : ℂ)) / (D : ℂ) =
        2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (e_v * r₂) : ℤ) : ℂ) / (D : ℂ) +
        2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (D • q) : ℤ) : ℂ) / (D : ℂ) := by
      ring
    rw [h_split, Complex.exp_add]
    have hfDq :
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R (D • q) : ℤ) : ℂ) / (D : ℂ)) = 1 := by
      rw [map_nsmul, nsmul_eq_mul]
      have hexp :
          2 * (Real.pi : ℂ) * Complex.I *
            ((((D : ℤ) * Algebra.trace ℤ R q : ℤ) : ℂ)) / (D : ℂ) =
          ((Algebra.trace ℤ R q : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast
        field_simp [hDc_ne]
      rw [hexp]
      exact Complex.exp_int_mul_two_pi_mul_I (Algebra.trace ℤ R q)
    rw [hfDq, mul_one]
  have hψ_mk : ∀ r : R, ψ (Ideal.Quotient.mk Iv r) = f r := by
    intro r
    apply hf_per
    rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
    exact Ideal.Quotient.mk_out (Ideal.Quotient.mk Iv r)
  have hψ_add : ∀ a b : A_v, ψ (a + b) = ψ a * ψ b := by
    intro a b
    refine Quotient.inductionOn₂ a b (fun r₁ r₂ => ?_)
    change ψ (Ideal.Quotient.mk Iv r₁ + Ideal.Quotient.mk Iv r₂) =
      ψ (Ideal.Quotient.mk Iv r₁) * ψ (Ideal.Quotient.mk Iv r₂)
    rw [← (Ideal.Quotient.mk Iv).map_add r₁ r₂, hψ_mk, hψ_mk, hψ_mk, hf_add]
  have hψ_zero : ψ 0 = 1 := by
    change ψ (Ideal.Quotient.mk Iv 0) = 1
    rw [hψ_mk, hf_zero]
  have hψ_neg : ∀ a : A_v, ψ (-a) = starRingEnd ℂ (ψ a) := by
    intro a
    refine Quotient.inductionOn a (fun r => ?_)
    change ψ (-Ideal.Quotient.mk Iv r) = starRingEnd ℂ (ψ (Ideal.Quotient.mk Iv r))
    rw [← (Ideal.Quotient.mk Iv).map_neg r, hψ_mk, hψ_mk, hf_neg]
  have h_trace_ne_zero : ∀ γ : R, localModulusTraceGaussSum D v γ ≠ 0 := by
    intro γ
    let γbar : A_v := Ideal.Quotient.mk Iv γ
    have h_sum : localModulusTraceGaussSum D v γ = ∑ x : A_v, ψ (γbar * x ^ 2) := by
      dsimp only [localModulusTraceGaussSum]
      rw [dif_pos hIv]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      have hx : γbar * x ^ 2 = Ideal.Quotient.mk Iv (γ * (Quotient.out x) ^ 2) := by
        rw [map_mul, map_pow, Ideal.Quotient.mk_out]
      rw [hx, hψ_mk]
      dsimp only [f, e_v]
      rw [mul_assoc (localModulusIdempotent D v) γ ((Quotient.out x) ^ 2)]
    let S : ℂ := localModulusTraceGaussSum D v γ
    have h_orth : (Complex.normSq S : ℂ) =
        ∑ h : A_v, ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) := by
      calc (Complex.normSq S : ℂ)
        _ = S * starRingEnd ℂ S := (Complex.mul_conj S).symm
        _ = (∑ x : A_v, ψ (γbar * x ^ 2)) * (∑ y : A_v, starRingEnd ℂ (ψ (γbar * y ^ 2))) := by
            rw [show S = localModulusTraceGaussSum D v γ from rfl, h_sum, map_sum]
        _ = (∑ x : A_v, ψ (γbar * x ^ 2)) * (∑ y : A_v, ψ (-(γbar * y ^ 2))) := by
            congr 1
            refine Finset.sum_congr rfl (fun y _ => (hψ_neg (γbar * y ^ 2)).symm)
        _ = ∑ x : A_v, ∑ y : A_v, ψ (γbar * x ^ 2) * ψ (-(γbar * y ^ 2)) :=
            Finset.sum_mul_sum _ _ _ _
        _ = ∑ y : A_v, ∑ x : A_v, ψ (γbar * x ^ 2 + -(γbar * y ^ 2)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun y _ => Finset.sum_congr rfl (fun x _ => ?_))
            rw [hψ_add]
        _ = ∑ y : A_v, ∑ h : A_v, ψ (γbar * h ^ 2 + 2 * γbar * h * y) := by
            refine Finset.sum_congr rfl (fun y _ => ?_)
            rw [← Equiv.sum_comp (Equiv.addLeft y)]
            refine Finset.sum_congr rfl (fun h _ => ?_)
            congr 1
            change γbar * (y + h) ^ 2 + -(γbar * y ^ 2) = γbar * h ^ 2 + 2 * γbar * h * y
            ring
        _ = ∑ h : A_v, ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun h _ => ?_)
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun y _ => hψ_add _ _)
    letI : DecidablePred (fun h : A_v => ∀ y : A_v, ψ (2 * γbar * h * y) = 1) :=
      Classical.decPred _
    have h_term : ∀ h : A_v,
        ψ (γbar * h ^ 2) * (∑ y : A_v, ψ (2 * γbar * h * y)) =
          if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℂ) else 0 := by
      intro h
      by_cases hh : ∀ y : A_v, ψ (2 * γbar * h * y) = 1
      · rw [if_pos hh]
        have h_inner : (∑ y : A_v, ψ (2 * γbar * h * y)) = (Fintype.card A_v : ℂ) := by
          calc (∑ y : A_v, ψ (2 * γbar * h * y))
            _ = ∑ _y : A_v, (1 : ℂ) := Finset.sum_congr rfl (fun y _ => hh y)
            _ = (Fintype.card A_v : ℂ) := by simp
        have h_quad : γbar * h ^ 2 = 2 * γbar * h * ((u : A_v) * h) := by
          calc γbar * h ^ 2
            _ = 1 * (γbar * h ^ 2) := (one_mul _).symm
            _ = ((2 : A_v) * (u : A_v)) * (γbar * h ^ 2) := by rw [h2u]
            _ = 2 * γbar * h * ((u : A_v) * h) := by ring
        have h_outer : ψ (γbar * h ^ 2) = 1 := by
          rw [h_quad]
          exact hh ((u : A_v) * h)
        rw [h_outer, h_inner, one_mul]
      · rw [if_neg hh]
        push_neg at hh
        rcases hh with ⟨y₀, hy₀⟩
        have h_shift : (∑ y : A_v, ψ (2 * γbar * h * y)) =
            (∑ y : A_v, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) := by
          calc (∑ y : A_v, ψ (2 * γbar * h * y))
            _ = ∑ y : A_v, ψ (2 * γbar * h * (y + y₀)) := by
                rw [← Equiv.sum_comp (Equiv.addRight y₀)]
                rfl
            _ = ∑ y : A_v, ψ (2 * γbar * h * y) * ψ (2 * γbar * h * y₀) := by
                refine Finset.sum_congr rfl (fun y _ => ?_)
                have h_lin : 2 * γbar * h * (y + y₀) = 2 * γbar * h * y + 2 * γbar * h * y₀ := by ring
                rw [h_lin, hψ_add]
            _ = (∑ y : A_v, ψ (2 * γbar * h * y)) * ψ (2 * γbar * h * y₀) :=
                (Finset.sum_mul _ _ _).symm
        have h_mul_zero : (∑ y : A_v, ψ (2 * γbar * h * y)) * (ψ (2 * γbar * h * y₀) - 1) = 0 := by
          linear_combination -h_shift
        have h_inner_zero : (∑ y : A_v, ψ (2 * γbar * h * y)) = 0 := by
          rcases mul_eq_zero.mp h_mul_zero with h0 | h1
          · exact h0
          · exact absurd (sub_eq_zero.mp h1) hy₀
        rw [h_inner_zero, mul_zero]
    have h_re : Complex.normSq S =
        ∑ h : A_v, (if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℝ) else 0) := by
      have h1 := congr_arg Complex.re h_orth
      rw [Complex.ofReal_re, Complex.re_sum] at h1
      rw [h1]
      refine Finset.sum_congr rfl (fun h _ => ?_)
      rw [h_term h]
      split_ifs <;> simp
    have h_nonneg : ∀ h ∈ (Finset.univ : Finset A_v),
        (0 : ℝ) ≤ (if (∀ y : A_v, ψ (2 * γbar * h * y) = 1) then (Fintype.card A_v : ℝ) else 0) := by
      intro h _
      split_ifs
      · exact Nat.cast_nonneg _
      · exact le_rfl
    have h0_cond : ∀ y : A_v, ψ (2 * γbar * (0 : A_v) * y) = 1 := by
      intro y
      have h0_eq : 2 * γbar * (0 : A_v) * y = 0 := by ring
      rw [h0_eq, hψ_zero]
    have h_le : (Fintype.card A_v : ℝ) ≤ Complex.normSq S := by
      rw [h_re]
      have h_single := Finset.single_le_sum h_nonneg (Finset.mem_univ (0 : A_v))
      rw [if_pos h0_cond] at h_single
      exact h_single
    have h_card_pos : (0 : ℝ) < (Fintype.card A_v : ℝ) := by
      exact Nat.cast_pos.mpr Fintype.card_pos
    have h_normSq_pos : 0 < Complex.normSq S := lt_of_lt_of_le h_card_pos h_le
    exact Complex.normSq_pos.mp h_normSq_pos
  exact ⟨mul_ne_zero (h_trace_ne_zero 1) (h_trace_ne_zero (-1 * β)), h_q_pos⟩

theorem not_isLocalModulusCharTrivialOnPow_pred_valNat {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (ha : 1 ≤ valNat v α) :
    ¬ IsLocalModulusCharTrivialOnPow (oddPfisterModulus α β) v 1 (valNat v α - 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let a : ℕ := valNat v α
  let q_v : ℕ := Ideal.absNorm v.asIdeal
  let M : ℕ := 2 * Module.finrank ℚ K + 2
  let N_ab : ℕ := (Algebra.norm ℤ (α * β)).natAbs
  let d₀ : ℕ := oddPartNat N_ab
  let D : ℕ := oddPfisterModulus α β
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hNab_ne : N_ab ≠ 0 := by
    dsimp [N_ab]
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have hd0_pos : 0 < d₀ := Nat.ordCompl_pos 2 hNab_ne
  have hD_pos : 0 < D := pow_pos hd0_pos M
  have hD_ne : (D : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  have h_val_eq : ∀ (x : R), x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have hq_ne : q_v ≠ 0 := mt Ideal.absNorm_eq_zero_iff.mp v.ne_bot
  have hq_mem : ((q_v : ℕ) : R) ∈ v.asIdeal := Ideal.absNorm_mem v.asIdeal
  have h_ex_prime : ∀ m : ℕ, m ≠ 0 → ((m : ℕ) : R) ∈ v.asIdeal →
      ∃ p : ℕ, p.Prime ∧ p ∣ m ∧ (p : R) ∈ v.asIdeal := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro hm0 hm_mem
    by_cases hm1 : m = 1
    · exfalso
      rw [hm1, Nat.cast_one] at hm_mem
      exact v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr hm_mem)
    · let p₀ := m.minFac
      have hp₀ : p₀.Prime := Nat.minFac_prime hm1
      have hdvd : p₀ ∣ m := Nat.minFac_dvd m
      have hm_eq : m = p₀ * (m / p₀) := (Nat.mul_div_cancel' hdvd).symm
      have h_mul_mem : (p₀ : R) * ((m / p₀ : ℕ) : R) ∈ v.asIdeal := by
        rw [← Nat.cast_mul, ← hm_eq]
        exact hm_mem
      rcases v.isPrime.mem_or_mem h_mul_mem with hp₀_mem | hdiv_mem
      · exact ⟨p₀, hp₀, hdvd, hp₀_mem⟩
      · have hm_pos : 0 < m := Nat.pos_of_ne_zero hm0
        have hdiv_lt : m / p₀ < m := Nat.div_lt_self hm_pos hp₀.one_lt
        have hdiv_ne : m / p₀ ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hm_eq
          exact hm0 hm_eq
        obtain ⟨p, hp, hp_dvd, hp_mem⟩ := ih (m / p₀) hdiv_lt hdiv_ne hdiv_mem
