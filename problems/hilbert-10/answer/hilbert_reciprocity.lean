      have hd0y : d₀ * y ∈ v.asIdeal ^ (m + 2 - e + k₀) := by
        have hd₀_mem : d₀ ∈ v.asIdeal ^ (2 * k₀ + 1) :=
          (mem_pow_iff_le_valNat d₀ (2 * k₀ + 1) hd₀_ne).mpr (le_of_eq hd₀_val.symm)
        have hd0y_mem : d₀ * y ∈ v.asIdeal ^ ((2 * k₀ + 1) + (m + 1 - e)) := by
          rw [pow_add]
          exact Ideal.mul_mem_mul hd₀_mem h_u_and_y.2
        exact Ideal.pow_le_pow_right (by omega : m + 2 - e + k₀ ≤ (2 * k₀ + 1) + (m + 1 - e)) hd0y_mem
      have h_lin_mem : 2 * γ * (x₀ * u + d₀ * y) * Δy ∈ v.asIdeal ^ n := by
        have h_sum_exp : e + (m + 2 - e + k₀) + (m - k₀) = n := by omega
        rw [← h_sum_exp, pow_add, pow_add]
        have h_sum_uy : x₀ * u + d₀ * y ∈ v.asIdeal ^ (m + 2 - e + k₀) :=
          (v.asIdeal ^ (m + 2 - e + k₀)).add_mem hx0u hd0y
        have h2_uy : 2 * (x₀ * u + d₀ * y) ∈ v.asIdeal ^ e * v.asIdeal ^ (m + 2 - e + k₀) :=
          Ideal.mul_mem_mul h2_mem_e h_sum_uy
        have h2_uy_Δ : (2 * (x₀ * u + d₀ * y)) * Δy ∈
            v.asIdeal ^ e * v.asIdeal ^ (m + 2 - e + k₀) * v.asIdeal ^ (m - k₀) :=
          Ideal.mul_mem_mul h2_uy hΔy_mem
        have hid : 2 * γ * (x₀ * u + d₀ * y) * Δy = γ * ((2 * (x₀ * u + d₀ * y)) * Δy) := by ring
        rw [hid]
        exact (v.asIdeal ^ e * v.asIdeal ^ (m + 2 - e + k₀) * v.asIdeal ^ (m - k₀)).mul_mem_left
          γ h2_uy_Δ
      have hid : γ * ((1 * x + x₀ * Δy) ^ 2 - β * (1 * y + Δy) ^ 2) - γ * (x ^ 2 - β * y ^ 2) - δ =
          (γ * d₀ * Δy ^ 2 - δ) + 2 * γ * (x₀ * u + d₀ * y) * Δy := by
        dsimp [u, d₀]
        ring
      rw [hid]
      exact (v.asIdeal ^ n).add_mem hΔy2_sub h_lin_mem
  have dyadicNormFiberCard_eq_of_affine_shift :
      ∀ (γ₁ γ₂ r a b : R), r ∉ v.asIdeal →
      (∀ x y : R,
        (γ₁ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) ∨
         γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) - c ∈ v.asIdeal ^ (n - 1)) →
        γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) - γ₁ * (x ^ 2 - β * y ^ 2) - δ ∈ v.asIdeal ^ n) →
      dyadicNormFiberCard v n γ₁ β c = dyadicNormFiberCard v n γ₂ β (c + δ) ∧
      dyadicNormFiberCard v n γ₁ β (c + δ) = dyadicNormFiberCard v n γ₂ β c := by
    intro γ₁ γ₂ r a b hr h_shift
    letI := Classical.propDecidable
    let M : ℕ := dyadicGaussModulus K
    let kv : ℕ := valNat v (M : NumberField.RingOfIntegers K)
    let Iv : Ideal (NumberField.RingOfIntegers K) := v.asIdeal ^ kv
    have hIv : Iv ≠ ⊥ := pow_ne_zero kv v.ne_bot
    haveI : Finite (NumberField.RingOfIntegers K ⧸ Iv) :=
      Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
    letI : Fintype (NumberField.RingOfIntegers K ⧸ Iv) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ Iv)
    obtain ⟨y₀, i₀, hi₀, hyi⟩ := v.isMaximal.exists_inv hr
    have h_cop : IsCoprime (Ideal.span {r}) v.asIdeal :=
      Ideal.isCoprime_iff_exists.mpr
        ⟨y₀ * r, Ideal.mem_span_singleton.mpr ⟨y₀, mul_comm y₀ r⟩, i₀, hi₀, hyi⟩
    have h_cop_pow : IsCoprime (Ideal.span {r}) Iv := h_cop.pow_right
    obtain ⟨u₀, hu₀, b₀, hb₀, hub⟩ := Ideal.isCoprime_iff_exists.mp h_cop_pow
    obtain ⟨r', rfl⟩ := Ideal.mem_span_singleton.mp hu₀
    have hr'_sub : r * r' - 1 ∈ Iv := by
      have hid : r * r' - 1 = -b₀ := by linear_combination hub
      rw [hid]
      exact Iv.neg_mem hb₀
    have h_mul_r : Ideal.Quotient.mk Iv r * Ideal.Quotient.mk Iv r' = 1 := by
      rw [← map_mul, ← map_one (Ideal.Quotient.mk Iv)]
      exact Ideal.Quotient.eq.mpr hr'_sub
    let E : (NumberField.RingOfIntegers K ⧸ Iv) × (NumberField.RingOfIntegers K ⧸ Iv) ≃
        (NumberField.RingOfIntegers K ⧸ Iv) × (NumberField.RingOfIntegers K ⧸ Iv) :=
      { toFun := fun p =>
          (Ideal.Quotient.mk Iv r * p.1 + Ideal.Quotient.mk Iv a,
           Ideal.Quotient.mk Iv r * p.2 + Ideal.Quotient.mk Iv b)
        invFun := fun q =>
          (Ideal.Quotient.mk Iv r' * (q.1 - Ideal.Quotient.mk Iv a),
           Ideal.Quotient.mk Iv r' * (q.2 - Ideal.Quotient.mk Iv b))
        left_inv := fun p => by
          ext <;> dsimp
          · linear_combination p.1 * h_mul_r
          · linear_combination p.2 * h_mul_r
        right_inv := fun q => by
          ext <;> dsimp
          · linear_combination (q.1 - Ideal.Quotient.mk Iv a) * h_mul_r
          · linear_combination (q.2 - Ideal.Quotient.mk Iv b) * h_mul_r }
    have h_out_aff : ∀ (x_q : NumberField.RingOfIntegers K ⧸ Iv) (z : R),
        Quotient.out (Ideal.Quotient.mk Iv r * x_q + Ideal.Quotient.mk Iv z) -
          (r * Quotient.out x_q + z) ∈ v.asIdeal ^ n := by
      intro x_q z
      refine Ideal.pow_le_pow_right hn_high ?_
      apply Ideal.Quotient.eq.mp
      rw [Ideal.Quotient.mk_out, map_add, map_mul, Ideal.Quotient.mk_out]
    have h_quad_congr : ∀ p : (NumberField.RingOfIntegers K ⧸ Iv) × (NumberField.RingOfIntegers K ⧸ Iv),
        γ₂ * ((Quotient.out (E p).1) ^ 2 - β * (Quotient.out (E p).2) ^ 2) -
          γ₂ * ((r * Quotient.out p.1 + a) ^ 2 - β * (r * Quotient.out p.2 + b) ^ 2) ∈
            v.asIdeal ^ n := by
      intro p
      let X : R := Quotient.out (E p).1
      let Y : R := Quotient.out (E p).2
      let x : R := Quotient.out p.1
      let y : R := Quotient.out p.2
      have hX : X - (r * x + a) ∈ v.asIdeal ^ n := h_out_aff p.1 a
      have hY : Y - (r * y + b) ∈ v.asIdeal ^ n := h_out_aff p.2 b
      change γ₂ * (X ^ 2 - β * Y ^ 2) - γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) ∈ v.asIdeal ^ n
      have hid : γ₂ * (X ^ 2 - β * Y ^ 2) - γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) =
          γ₂ * (X + (r * x + a)) * (X - (r * x + a)) -
          γ₂ * β * (Y + (r * y + b)) * (Y - (r * y + b)) := by ring
      rw [hid]
      exact (v.asIdeal ^ n).sub_mem
        ((v.asIdeal ^ n).mul_mem_left (γ₂ * (X + (r * x + a))) hX)
        ((v.asIdeal ^ n).mul_mem_left (γ₂ * β * (Y + (r * y + b))) hY)
    have h2δ : 2 * δ ∈ v.asIdeal ^ n := by
      have hn_eq : (n - 1) + 1 = n := Nat.sub_add_cancel hn_pos
      rw [← hn_eq, pow_succ']
      exact Ideal.mul_mem_mul h2v hδ
    have hn_le_sub : v.asIdeal ^ n ≤ v.asIdeal ^ (n - 1) :=
      Ideal.pow_le_pow_right (Nat.sub_le n 1)
    dsimp [dyadicNormFiberCard]
    rw [dif_pos hIv, dif_pos hIv, dif_pos hIv, dif_pos hIv]
    constructor
    · refine Finset.card_equiv E (fun p => ?_)
      rw [Finset.mem_filter, Finset.mem_filter]
      simp only [Finset.mem_univ, true_and]
      let x : R := Quotient.out p.1
      let y : R := Quotient.out p.2
      let Q₁ : R := γ₁ * (x ^ 2 - β * y ^ 2)
      let Q₂ : R := γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2)
      let Q₂' : R := γ₂ * ((Quotient.out (E p).1) ^ 2 - β * (Quotient.out (E p).2) ^ 2)
      have hQ : Q₂' - Q₂ ∈ v.asIdeal ^ n := h_quad_congr p
      change Q₁ - c ∈ v.asIdeal ^ n ↔ Q₂' - (c + δ) ∈ v.asIdeal ^ n
      constructor
      · intro h1
        have hD : Q₂ - Q₁ - δ ∈ v.asIdeal ^ n :=
          h_shift x y (Or.inl (hn_le_sub h1))
        have hid : Q₂' - (c + δ) = (Q₂' - Q₂) + (Q₂ - Q₁ - δ) + (Q₁ - c) := by ring
        rw [hid]
        exact (v.asIdeal ^ n).add_mem ((v.asIdeal ^ n).add_mem hQ hD) h1
      · intro h2
        have hQ₂_sub : Q₂ - (c + δ) ∈ v.asIdeal ^ n := by
          have hid : Q₂ - (c + δ) = (Q₂' - (c + δ)) - (Q₂' - Q₂) := by ring
          rw [hid]
          exact (v.asIdeal ^ n).sub_mem h2 hQ
        have hQ₂_c : Q₂ - c ∈ v.asIdeal ^ (n - 1) := by
          have hid : Q₂ - c = (Q₂ - (c + δ)) + δ := by ring
          rw [hid]
          exact (v.asIdeal ^ (n - 1)).add_mem (hn_le_sub hQ₂_sub) hδ
        have hD : Q₂ - Q₁ - δ ∈ v.asIdeal ^ n := h_shift x y (Or.inr hQ₂_c)
        have hid : Q₁ - c = (Q₂ - (c + δ)) - (Q₂ - Q₁ - δ) := by ring
        rw [hid]
        exact (v.asIdeal ^ n).sub_mem hQ₂_sub hD
    · refine Finset.card_equiv E (fun p => ?_)
      rw [Finset.mem_filter, Finset.mem_filter]
      simp only [Finset.mem_univ, true_and]
      let x : R := Quotient.out p.1
      let y : R := Quotient.out p.2
      let Q₁ : R := γ₁ * (x ^ 2 - β * y ^ 2)
      let Q₂ : R := γ₂ * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2)
      let Q₂' : R := γ₂ * ((Quotient.out (E p).1) ^ 2 - β * (Quotient.out (E p).2) ^ 2)
      have hQ : Q₂' - Q₂ ∈ v.asIdeal ^ n := h_quad_congr p
      change Q₁ - (c + δ) ∈ v.asIdeal ^ n ↔ Q₂' - c ∈ v.asIdeal ^ n
      constructor
      · intro h1
        have hQ₁_c : Q₁ - c ∈ v.asIdeal ^ (n - 1) := by
          have hid : Q₁ - c = (Q₁ - (c + δ)) + δ := by ring
          rw [hid]
          exact (v.asIdeal ^ (n - 1)).add_mem (hn_le_sub h1) hδ
        have hD : Q₂ - Q₁ - δ ∈ v.asIdeal ^ n := h_shift x y (Or.inl hQ₁_c)
        have hid : Q₂' - c = (Q₂' - Q₂) + (Q₂ - Q₁ - δ) + (Q₁ - (c + δ)) + 2 * δ := by ring
        rw [hid]
        exact (v.asIdeal ^ n).add_mem
          ((v.asIdeal ^ n).add_mem ((v.asIdeal ^ n).add_mem hQ hD) h1) h2δ
      · intro h2
        have hQ₂_c : Q₂ - c ∈ v.asIdeal ^ n := by
          have hid : Q₂ - c = (Q₂' - c) - (Q₂' - Q₂) := by ring
          rw [hid]
          exact (v.asIdeal ^ n).sub_mem h2 hQ
        have hD : Q₂ - Q₁ - δ ∈ v.asIdeal ^ n :=
          h_shift x y (Or.inr (hn_le_sub hQ₂_c))
        have hid : Q₁ - (c + δ) = (Q₂ - c) - (Q₂ - Q₁ - δ) - 2 * δ := by ring
        rw [hid]
        exact (v.asIdeal ^ n).sub_mem ((v.asIdeal ^ n).sub_mem hQ₂_c hD) h2δ
  by_cases hc_gt : c ∈ v.asIdeal ^ (l_crit + 1)
  · obtain ⟨a₁, b₁, h_shift₁⟩ := exists_add_shift_of_mem_pow_gt_crit hc_gt 1 h1_unit
    obtain ⟨a₂, b₂, h_shift₂⟩ := exists_add_shift_of_mem_pow_gt_crit hc_gt α hα_unit
    have h_eq₁ := (dyadicNormFiberCard_eq_of_affine_shift 1 1 1 a₁ b₁ h1_unit h_shift₁).1
    have h_eq₂ := (dyadicNormFiberCard_eq_of_affine_shift α α 1 a₂ b₂ h1_unit h_shift₂).1
    omega
  · by_cases hc_lt : c ∉ v.asIdeal ^ l_crit
    · obtain ⟨a₁, b₁, h_shift₁⟩ :=
        exists_add_shift_of_not_mem_pow_crit v h2v 1 β x₀ k₀ h1_unit hβ hβ_sqfree hk₀ hd₀_ne hd₀_val
          hx₀_mem hx₀_unit h_qdiag n l_crit hn_low hl_crit_in hl_crit_out c δ hc_lt hδ
      obtain ⟨a₂, b₂, h_shift₂⟩ :=
        exists_add_shift_of_not_mem_pow_crit v h2v α β x₀ k₀ hα_unit hβ hβ_sqfree hk₀ hd₀_ne hd₀_val
          hx₀_mem hx₀_unit h_qdiag n l_crit hn_low hl_crit_in hl_crit_out c δ hc_lt hδ
      have h_eq₁ := (dyadicNormFiberCard_eq_of_affine_shift 1 1 1 a₁ b₁ h1_unit h_shift₁).1
      have h_eq₂ := (dyadicNormFiberCard_eq_of_affine_shift α α 1 a₂ b₂ h1_unit h_shift₂).1
      omega
    · push_neg at hc_lt
      have h_disj : ∀ c' : R,
          c' - c ∈ v.asIdeal ^ (n - 1) →
          ∀ x₁ y₁ x₂ y₂ : R,
            ¬ ((x₁ ^ 2 - β * y₁ ^ 2) - c' ∈ v.asIdeal ^ n ∧
               α * (x₂ ^ 2 - β * y₂ ^ 2) - c' ∈ v.asIdeal ^ n) := by
        intro c' hc'
        have hc'_diff_l1 : c' - c ∈ v.asIdeal ^ (l_crit + 1) :=
          Ideal.pow_le_pow_right hl_le hc'
        have hc'_diff_l : c' - c ∈ v.asIdeal ^ l_crit :=
          Ideal.pow_le_pow_right (Nat.le_succ l_crit) hc'_diff_l1
        have hc'_mem : c' ∈ v.asIdeal ^ l_crit := by
          have hid : c' = c + (c' - c) := by ring
          rw [hid]
          exact (v.asIdeal ^ l_crit).add_mem hc_lt hc'_diff_l
        have hc'_not_mem : c' ∉ v.asIdeal ^ (l_crit + 1) := by
          intro h_in
          apply hc_gt
          have hid : c = c' - (c' - c) := by ring
          rw [hid]
          exact (v.asIdeal ^ (l_crit + 1)).sub_mem h_in hc'_diff_l1
        exact not_both_mem_crit_fiber_of_unitDyadicSym_eq_neg_one v h2v α β x₀ k₀
          hα_unit hβ hβ_sqfree h_sym hk₀ hd₀_ne hd₀_val hx₀_mem hx₀_unit h_qdiag
          n l_crit hn_low hl_crit_in hl_crit_out c' hc'_mem hc'_not_mem
      rcases exists_affine_shift_preserve_or_swap_of_crit_shell v h2v α β x₀ k₀
          hα_unit hβ hβ_sqfree hk₀ hd₀_ne hd₀_val hx₀_mem hx₀_unit h_qdiag
          n l_crit hn_low hl_crit_in hl_crit_out c δ hc_lt hc_gt h_disj hδ with
        ⟨a₁, b₁, a₂, b₂, h_shift₁, h_shift₂⟩ | ⟨r, a, b, hr, h_swap⟩
      · have h_eq₁ := (dyadicNormFiberCard_eq_of_affine_shift 1 1 1 a₁ b₁ h1_unit h_shift₁).1
        have h_eq₂ := (dyadicNormFiberCard_eq_of_affine_shift α α 1 a₂ b₂ h1_unit h_shift₂).1
        omega
      · obtain ⟨h_swap₁, h_swap₂⟩ :=
          dyadicNormFiberCard_eq_of_affine_shift α 1 r a b hr h_swap
        omega

theorem localDyadicBinaryGaussSum_eq_unitDyadicSym_mul {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (α β : NumberField.RingOfIntegers K)
    (hα_unit : α ∉ v.asIdeal) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1) :
    localDyadicBinaryGaussSum v α β =
      ((unitDyadicSym v α β : ℤ) : ℂ) * localDyadicBinaryGaussSum v 1 β :=
by
  obtain ⟨h_idem, w₀, hw₀_tr_ndvd⟩ := isLocalDyadicIdempotent_and_exists_trace_not_dvd v h2v
  let M : ℕ := dyadicGaussModulus K
  let I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(M : NumberField.RingOfIntegers K)}
  let kv : ℕ := valNat v (M : NumberField.RingOfIntegers K)
  let Iv : Ideal (NumberField.RingOfIntegers K) := v.asIdeal ^ kv
  have hIv : Iv ≠ ⊥ := pow_ne_zero kv v.ne_bot
  let b := Module.Free.chooseBasis ℤ (NumberField.RingOfIntegers K)
  let d := Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K))
  have h_norm : Algebra.norm ℤ (2 : NumberField.RingOfIntegers K) = (2 : ℤ) ^ d := by
    have h2 : (2 : NumberField.RingOfIntegers K) =
        algebraMap ℤ (NumberField.RingOfIntegers K) (2 : ℤ) := by simp
    rw [h2, Algebra.norm_algebraMap_of_basis b (2 : ℤ)]
  have h_abs : (Algebra.norm ℤ (2 : NumberField.RingOfIntegers K)).natAbs = 2 ^ d := by
    rw [h_norm, Int.natAbs_pow]
    rfl
  have hM_eq : dyadicGaussModulus K = 2 ^ (2 * d + 3) := by
    dsimp [dyadicGaussModulus]
    rw [h_abs]
    calc 8 * (2 ^ d) ^ 2 = 2 ^ 3 * 2 ^ (d * 2) := by rw [← pow_mul]; rfl
      _ = 2 ^ (2 * d + 3) := by rw [← pow_add]; ring_nf
  have hM_ne : M ≠ 0 := by
    change dyadicGaussModulus K ≠ 0
    rw [hM_eq]
    exact pow_ne_zero (2 * d + 3) two_ne_zero
  have hMR_eq : (M : NumberField.RingOfIntegers K) =
      (2 : NumberField.RingOfIntegers K) ^ (2 * d + 3) := by
    change ((dyadicGaussModulus K : ℕ) : NumberField.RingOfIntegers K) =
      (2 : NumberField.RingOfIntegers K) ^ (2 * d + 3)
    rw [hM_eq, Nat.cast_pow, Nat.cast_ofNat]
  have hMR_ne : (M : NumberField.RingOfIntegers K) ≠ 0 := by
    rw [hMR_eq]
    exact pow_ne_zero (2 * d + 3) two_ne_zero
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : NumberField.RingOfIntegers K),
        x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have pow_valNat_le_span_sup_Iv :
      ∀ (x : NumberField.RingOfIntegers K),
        x ≠ 0 → v.asIdeal ^ (valNat v x) ≤ Ideal.span {x} ⊔ Iv := by
    intro x hx
    let m : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(m : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ m ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x m).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (m + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le : v.intValuation x ≤ WithZero.exp (-((m + 1 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem x (m + 1)).mpr hx_mem
      rw [hx_val, WithZero.exp_le_exp] at hx_le
      omega
    have h_coprime : IsCoprime J Iv := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ := Ideal.exists_le_maximal (J ⊔ Iv) h_ne_top
      have hJ_le_𝔪 : J ≤ 𝔪 := le_trans le_sup_left h_le_𝔪
      have hIv_le_𝔪 : v.asIdeal ^ kv ≤ 𝔪 := le_trans le_sup_right h_le_𝔪
      have hv_le_𝔪 : v.asIdeal ≤ 𝔪 := by
        intro z hz
        by_cases hkv : kv = 0
        · exfalso
          rw [hkv, pow_zero, Ideal.one_eq_top, top_le_iff] at hIv_le_𝔪
          exact h𝔪_max.ne_top hIv_le_𝔪
        · exact h𝔪_max.isPrime.mem_of_pow_mem kv (hIv_le_𝔪 (Ideal.pow_mem_pow hz kv))
      have hv_eq_𝔪 : v.asIdeal = 𝔪 := v.isMaximal.eq_of_le h𝔪_max.ne_top hv_le_𝔪
      rw [← hv_eq_𝔪] at hJ_le_𝔪
      exact hJ_not_le hJ_le_𝔪
    obtain ⟨j, hjJ, i, hiIv, hji⟩ := Ideal.isCoprime_iff_exists.mp h_coprime
