        algebraMap K (v.adicCompletion K) (algebraMap R K b) * cF
      rw [hab_K, map_mul]
    have hab_val : v.intValuation a ≤ v.intValuation b := by
      rw [← valued_algebraMap_eq_intValuation v a, ← valued_algebraMap_eq_intValuation v b]
      change Valued.v (ι a) ≤ Valued.v (ι b)
      rw [hab_F, map_mul]
      exact mul_le_of_le_one_right' hcF_le
    obtain ⟨k, π, s₀, a₀, b₀, hπk_val, hs₀v, hb₀v, ha₀_eq, hb₀_eq⟩ :=
      exists_coprime_denom_of_intValuation_le v a b hb hab_val
    have hs₀_val : Valued.v (ι s₀) = 1 :=
      (valued_algebraMap_eq_intValuation v s₀).trans (v.intValuation_eq_one_iff.mpr hs₀v)
    have hπk_F_val : Valued.v (ι (π ^ k)) = v.intValuation b :=
      (valued_algebraMap_eq_intValuation v (π ^ k)).trans hπk_val
    have hb_F_val : Valued.v (ι b) = v.intValuation b :=
      valued_algebraMap_eq_intValuation v b
    have hb_val_ne : v.intValuation b ≠ 0 :=
      v.intValuation_ne_zero' ⟨b, hb_mem⟩
    have h_id_F : ι (π ^ k) * (ι a₀ - ι b₀ * W) = (ι s₀) ^ k * ι b * (cF - W) := by
      have ha₀_F : ι (a * s₀ ^ k) = ι (π ^ k * a₀) := congr_arg ι ha₀_eq
      have hb₀_F : ι (b * s₀ ^ k) = ι (π ^ k * b₀) := congr_arg ι hb₀_eq
