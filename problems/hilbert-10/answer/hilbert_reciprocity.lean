        · have : k * (c_lat : ℤ) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hk0 (Nat.cast_nonneg c_lat)
          linarith
        · have hk1 : 1 ≤ k := hk0
          have : (c_lat : ℤ) ≤ k * (c_lat : ℤ) := le_mul_of_one_le_left (Nat.cast_nonneg c_lat) hk1
          linarith
      have h_sub_zero : (∑ z ∈ S_r, ψ z) * (1 - ζ) = 0 := by
        calc (∑ z ∈ S_r, ψ z) * (1 - ζ)
          _ = (∑ z ∈ S_r, ψ z) - (∑ z ∈ S_r, ψ z) * ζ := by ring
          _ = 0 := sub_eq_zero.mpr h_eq_mul
      rcases mul_eq_zero.mp h_sub_zero with h_zero | h_zeta
      · exact h_zero
      · exact False.elim (hζ_ne (sub_eq_zero.mp h_zeta).symm)
    · intro h0
      exact False.elim (h0 (Finset.mem_univ _))
  let F_fib : R → Finset A := fun x₀ =>
    Finset.univ.filter (fun z : A => ∃ r : R, Φ z - (c_lat : R) * x₀ = ((N * c_lat : ℕ) : R) * r)
  let K_fib : ℕ := (F_fib 0).card
  have h0_mem : (0 : A) ∈ F_fib 0 := by
    simp only [F_fib, Finset.mem_filter, Finset.mem_univ, true_and, mul_zero, sub_zero]
    refine ⟨0, ?_⟩
    rw [mul_zero]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    change (((0 : ZMod m).val : R) * e j = 0)
    rw [ZMod.val_zero, Nat.cast_zero, zero_mul]
  have hK_pos : 0 < K_fib := Finset.card_pos.mpr ⟨0, h0_mem⟩
  have h_card : ∀ x₀ : R, (F_fib x₀).card = K_fib := by
    intro x₀
    obtain ⟨u, hu⟩ := h_sublat_c x₀
    let z₀ : A := fun j => (u j : ZMod m)
    have hΦ_z₀ : ∀ z : A, ∃ r₀ : R, Φ (z + z₀) = Φ z + (c_lat : R) * x₀ + (m : R) * r₀ := by
      intro z
      have h_dvd : ∀ j : Fin (Module.finrank ℚ K),
          (m : ℤ) ∣ (((z + z₀) j).val : ℤ) - (((z j).val : ℤ) + u j) := by
        intro j
        rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
        push_cast
        change (((z j + z₀ j).val : ZMod m) - (((z j).val : ZMod m) + (u j : ZMod m))) = 0
        rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        exact sub_self (z j + z₀ j)
      choose q hq using h_dvd
      refine ⟨∑ j : Fin (Module.finrank ℚ K), (q j : R) * e j, ?_⟩
      have h_term : ∀ j : Fin (Module.finrank ℚ K),
          (((z + z₀) j).val : R) * e j =
            ((z j).val : R) * e j + (u j : R) * e j + (m : R) * ((q j : R) * e j) := by
        intro j
        have hqj : (((z + z₀) j).val : ℤ) = ((z j).val : ℤ) + u j + (m : ℤ) * q j := by
          linarith [hq j]
        have hqj_R : (((z + z₀) j).val : R) =
            ((z j).val : R) + (u j : R) + (m : R) * (q j : R) := by
          exact_mod_cast hqj
        rw [hqj_R]
        ring
      dsimp [Φ]
      rw [Finset.mul_sum, hu, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => h_term j)
    have h_map : Finset.map (Equiv.addRight z₀).toEmbedding (F_fib 0) = F_fib x₀ := by
      ext z
      simp only [Finset.mem_map_equiv, F_fib, Finset.mem_filter, Finset.mem_univ, true_and,
        Equiv.addRight_symm, mul_zero, sub_zero]
      change (∃ r : R, Φ (z + -z₀) = ((N * c_lat : ℕ) : R) * r) ↔
        ∃ r : R, Φ z - (c_lat : R) * x₀ = ((N * c_lat : ℕ) : R) * r
      obtain ⟨r₀, hr₀⟩ := hΦ_z₀ (z + -z₀)
      have hr₀' : Φ z = Φ (z + -z₀) + (c_lat : R) * x₀ + (m : R) * r₀ :=
        (congr_arg Φ (neg_add_cancel_right z z₀)).symm.trans hr₀
      constructor
      · rintro ⟨r, hr⟩
        refine ⟨r + (c_lat : R) * r₀, ?_⟩
        rw [hr₀', hr]
        dsimp [m]
        push_cast
        ring
      · rintro ⟨r, hr⟩
        refine ⟨r - (c_lat : R) * r₀, ?_⟩
        have h_sub : Φ (z + -z₀) = (Φ z - (c_lat : R) * x₀) - (m : R) * r₀ := by
          rw [hr₀']
          ring
        rw [h_sub, hr]
        dsimp [m]
        push_cast
        ring
