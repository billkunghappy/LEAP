            Complex.exp (-Real.pi * (T : ℂ) * (m : ℂ) ^ 2 +
              Complex.I * ((2 * Real.pi * ((z : ℕ) : ℝ) * (m : ℝ) / ((8 * K : ℕ) : ℝ) : ℝ) : ℂ)))
    let f_rhs : ℝ → ℂ := fun T =>
      (r₀ : ℂ) * Complex.exp (Real.pi * Complex.I / 4) *
        (∑' m : ℤ,
          Complex.exp (-Real.pi * ((4 * T : ℝ) : ℂ) * (m : ℂ) ^ 2 +
            Complex.I * ((-Real.pi * (m : ℝ) ^ 2 / (4 * (K : ℝ)) : ℝ) : ℂ)))
    have h_ev_eq : f_lhs =ᶠ[Filter.atTop] f_rhs := by
      filter_upwards [Filter.eventually_gt_atTop (0 : ℝ)] with T hT
      exact (tsum_cexp_gauss_lhs_eq K T hK_pos hT).symm.trans (tsum_cexp_gauss_rhs_eq K T hK_pos hT)
    have h_tendsto_lhs : Filter.Tendsto f_lhs Filter.atTop (nhds (ratIntGaussSum (8 * K) 1)) := by
      have h_sum_eq :
          ratIntGaussSum (8 * K) 1 =
            ∑ z : Fin (8 * K),
              Complex.exp (2 * Real.pi * Complex.I * ((z : ℕ) : ℂ) ^ 2 / ((8 * K : ℕ) : ℂ)) * 1 := by
        unfold ratIntGaussSum
        refine Finset.sum_congr rfl (fun z _ => ?_)
        rw [mul_one]
        congr 1
        push_cast
        ring
      rw [h_sum_eq]
      refine tendsto_finset_sum Finset.univ (fun z _ => ?_)
      refine Filter.Tendsto.const_mul _ ?_
      have hθ0 : (2 * Real.pi * ((z : ℕ) : ℝ) * ((0 : ℤ) : ℝ) / ((8 * K : ℕ) : ℝ) : ℝ) = 0 := by
        push_cast
        ring
      exact tsum_cexp_neg_pi_mul_int_sq_tendsto_one
        (fun m : ℤ => 2 * Real.pi * ((z : ℕ) : ℝ) * (m : ℝ) / ((8 * K : ℕ) : ℝ)) hθ0
    have h_tendsto_rhs :
        Filter.Tendsto f_rhs Filter.atTop (nhds ((r₀ : ℂ) * Complex.exp (Real.pi * Complex.I / 4))) := by
      have h_one :
          (r₀ : ℂ) * Complex.exp (Real.pi * Complex.I / 4) =
            (r₀ : ℂ) * Complex.exp (Real.pi * Complex.I / 4) * 1 := (mul_one _).symm
      rw [h_one]
