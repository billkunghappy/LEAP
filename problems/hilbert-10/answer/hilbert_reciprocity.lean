  have h_val : ∀ (x₀ : R) (z : A), z ∈ F_fib x₀ →
      ψ z = Complex.exp (2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (γ * x₀ ^ 2) : ℤ) : ℂ) / (N : ℂ)) := by
    intro x₀ z hz
    simp only [F_fib, Finset.mem_filter, Finset.mem_univ, true_and] at hz
    obtain ⟨r, hr⟩ := hz
    have hΦz : Φ z = (c_lat : R) * x₀ + ((N * c_lat : ℕ) : R) * r := by
      rw [← sub_add_cancel (Φ z) ((c_lat : R) * x₀), hr]
      ring
    let s₁ := γ * (2 * x₀ * r + (N : R) * r ^ 2)
    have h_sq : γ * (Φ z) ^ 2 =
        ((c_lat ^ 2 : ℕ) : R) * (γ * x₀ ^ 2) + (m : R) * s₁ := by
      rw [hΦz]
      dsimp [s₁, m]
      push_cast
      ring
    have h_tr : Algebra.trace ℤ R (γ * (Φ z) ^ 2) =
        ((c_lat ^ 2 : ℕ) : ℤ) * Algebra.trace ℤ R (γ * x₀ ^ 2) +
        (m : ℤ) * Algebra.trace ℤ R s₁ := by
      rw [h_sq, map_add, h_tr_nat (c_lat ^ 2) (γ * x₀ ^ 2), h_tr_nat m s₁]
    dsimp [ψ]
    rw [h_tr]
    have hN_c : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hN_pos)
    have hc_c : (c_lat : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hc_pos)
    have h_div :
        2 * Real.pi * Complex.I *
          ((((c_lat ^ 2 : ℕ) : ℤ) * Algebra.trace ℤ R (γ * x₀ ^ 2) +
            (m : ℤ) * Algebra.trace ℤ R s₁ : ℤ) : ℂ) /
          (m : ℂ) =
        2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (γ * x₀ ^ 2) : ℤ) : ℂ) / (N : ℂ) +
        ((Algebra.trace ℤ R s₁ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
      dsimp [m]
      push_cast
      field_simp [hN_c, hc_c]
    rw [h_div, Complex.exp_add, Complex.exp_int_mul, Complex.exp_two_pi_mul_I, one_zpow, mul_one]
  let I : Ideal R := Ideal.span {(N : R)}
  have hN_R_ne : (N : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hN_pos)
  have hI : I ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hN_R_ne
  haveI : Finite (R ⧸ I) := Ideal.finiteQuotientOfFreeOfNeBot I hI
  letI : Fintype (R ⧸ I) := Fintype.ofFinite (R ⧸ I)
  let π : A → R ⧸ I := fun z =>
    if hz : ∃ x : R, Φ z = (c_lat : R) * x then Ideal.Quotient.mk I (Classical.choose hz) else 0
  have h_fiber_G :
      (∑ z ∈ G, ψ z) = ∑ xbar : R ⧸ I, ∑ z ∈ G.filter (fun z : A => π z = xbar), ψ z := by
    rw [← Finset.sum_fiberwise_of_maps_to (g := π) (t := Finset.univ) (fun _ _ => Finset.mem_univ _)]
  have hc_R_ne : (c_lat : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hc_pos)
  have h_filter_eq : ∀ xbar : R ⧸ I,
      G.filter (fun z : A => π z = xbar) = F_fib (Quotient.out xbar) := by
    intro xbar
    ext z
    simp only [G, F_fib, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨hz, hπ⟩
      dsimp [π] at hπ
      rw [dif_pos hz] at hπ
      let x := Classical.choose hz
      have hx : Φ z = (c_lat : R) * x := Classical.choose_spec hz
      have h_mk : Ideal.Quotient.mk I x = Ideal.Quotient.mk I (Quotient.out xbar) := by
        rw [hπ]
        exact (Quotient.out_eq xbar).symm
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton] at h_mk
      obtain ⟨r, hr⟩ := h_mk
      refine ⟨r, ?_⟩
      calc Φ z - (c_lat : R) * Quotient.out xbar
        _ = (c_lat : R) * (x - Quotient.out xbar) := by rw [hx]; ring
        _ = (c_lat : R) * ((N : R) * r) := by rw [hr]
        _ = ((N * c_lat : ℕ) : R) * r := by push_cast; ring
    · rintro ⟨r, hr⟩
      have hz : ∃ x : R, Φ z = (c_lat : R) * x := by
        refine ⟨Quotient.out xbar + (N : R) * r, ?_⟩
        rw [← sub_add_cancel (Φ z) ((c_lat : R) * Quotient.out xbar), hr]
        push_cast
        ring
      refine ⟨hz, ?_⟩
      dsimp [π]
      rw [dif_pos hz]
      have hx_eq : Classical.choose hz = Quotient.out xbar + (N : R) * r := by
        apply mul_left_cancel₀ hc_R_ne
        rw [← Classical.choose_spec hz, ← sub_add_cancel (Φ z) ((c_lat : R) * Quotient.out xbar), hr]
        push_cast
        ring
      rw [hx_eq]
      have h_mem : (Quotient.out xbar + (N : R) * r) - Quotient.out xbar ∈ I := by
        rw [add_sub_cancel_left, Ideal.mem_span_singleton]
        exact ⟨r, rfl⟩
      have h_mk : Ideal.Quotient.mk I (Quotient.out xbar + (N : R) * r) =
          Ideal.Quotient.mk I (Quotient.out xbar) := Ideal.Quotient.eq.mpr h_mem
      rw [h_mk]
      exact Quotient.out_eq xbar
  have h4 : (∑ z ∈ G, ψ z) = (K_fib : ℂ) * traceGaussSum N γ := by
    rw [h_fiber_G]
    unfold traceGaussSum
    rw [dif_pos hI, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun xbar _ => ?_)
    rw [h_filter_eq xbar]
    rw [Finset.sum_congr rfl (fun z hz => h_val (Quotient.out xbar) z hz)]
    rw [Finset.sum_const, h_card (Quotient.out xbar), nsmul_eq_mul]
  have h_prod_eq :
      (∏ j : Fin (Module.finrank ℚ K), ratIntGaussSum m (d j)) =
      (K_fib : ℂ) * traceGaussSum N γ :=
    (h1.trans h3).trans h4
  refine ⟨m, (K_fib : ℝ)⁻¹, hm_pos, inv_pos.mpr (Nat.cast_pos.mpr hK_pos), hdvd_m, ?_⟩
  have hK_c_ne : (K_fib : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hK_pos)
  rw [h_prod_eq]
  push_cast
  rw [← mul_assoc, inv_mul_cancel₀ hK_c_ne, one_mul]

theorem traceGaussSum_fullPfisterModulus_eq_prod_ratIntGaussSum {K : Type u} [Field K] [NumberField K]
    (α β γ : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1)
    (hγ : ∃ δ : NumberField.RingOfIntegers K, α * β = γ * δ) :
    ∃ (m : ℕ) (d : Fin (Module.finrank ℚ K) → ℤ) (c : ℝ),
      0 < m ∧ 0 < c ∧
      (∀ j : Fin (Module.finrank ℚ K), d j ≠ 0 ∧ 8 * (d j).natAbs ∣ m) ∧
      (∑ j : Fin (Module.finrank ℚ K), if d j < 0 then (-1 : ℤ) else 1) = traceSignature γ ∧
      traceGaussSum (fullPfisterModulus α β) γ =
        (c : ℂ) * ∏ j : Fin (Module.finrank ℚ K), ratIntGaussSum m (d j) :=
by
  obtain ⟨δ, h_ab_eq⟩ := hγ
  have hab_ne : α * β ≠ 0 := mul_ne_zero hα hβ
  have hγ_ne : γ ≠ 0 := by
    intro h0
    apply hab_ne
    rw [h_ab_eq, h0, zero_mul]
  have h2_ne : (2 : NumberField.RingOfIntegers K) ≠ 0 := two_ne_zero
  have hM_pos : 0 < dyadicGaussModulus K := by
    unfold dyadicGaussModulus
    have hnorm2 : Algebra.norm ℤ (2 : NumberField.RingOfIntegers K) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr h2_ne
    positivity
  have hD_pos : 0 < oddPfisterModulus α β := by
    unfold oddPfisterModulus oddPartNat
    have hnorm_ab : Algebra.norm ℤ (α * β) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr hab_ne
    have hn_pos : 0 < (Algebra.norm ℤ (α * β)).natAbs :=
      Int.natAbs_pos.mpr hnorm_ab
    exact pow_pos (Nat.div_pos (Nat.le_of_dvd hn_pos (Nat.ordProj_dvd _ 2)) (by positivity)) _
  have hC_pos : 0 < coprimeDiscrModulus α β := by
    unfold coprimeDiscrModulus coprimePartNat
    have hd_pos : 0 < (NumberField.discr K).natAbs :=
      Int.natAbs_pos.mpr (NumberField.discr_ne_zero K)
    exact pow_pos (Nat.div_pos (Nat.le_of_dvd hd_pos (Nat.gcd_dvd_left _ _))
      (Nat.gcd_pos_of_pos_left _ hd_pos)) _
  have hN_pos : 0 < fullPfisterModulus α β := mul_pos (mul_pos hM_pos hD_pos) hC_pos
  have h8_dvd : 8 ∣ fullPfisterModulus α β := by
    unfold fullPfisterModulus dyadicGaussModulus
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_right 8 _) _) _
  obtain ⟨e, c₀, hc₀_pos, h_ortho, h_ne, h_sublat⟩ :=
    exists_orthogonal_trace_sublattice γ hγ_ne
  have h_sig := sum_sign_orthogonal_trace_eq_traceSignature γ hγ_ne e h_ortho h_ne
  have h_dual := exists_dual_trace_elem_fullPfisterModulus α β γ hα hβ h_all_coprime h_sqfree ⟨δ, h_ab_eq⟩
  obtain ⟨m, c, hm_pos, hc_pos, hdvd, h_prod⟩ :=
    traceGaussSum_eq_mul_prod_ratIntGaussSum_of_orthogonal_dual
      (fullPfisterModulus α β) γ hN_pos h8_dvd e c₀ hc₀_pos h_ortho h_ne h_sublat h_dual
  exact ⟨m, fun j => Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2),
    c, hm_pos, hc_pos, fun j => ⟨h_ne j, hdvd j⟩, h_sig, h_prod⟩

theorem pfisterGaussSign_mul_oddPfisterModulus_eq_archPfisterSign_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    pfisterGaussSign (dyadicGaussModulus K * oddPfisterModulus α β) α β =
      archPfisterSign α β :=
by
  have h_1var : ∀ γ : NumberField.RingOfIntegers K,
      (∃ δ : NumberField.RingOfIntegers K, α * β = γ * δ) →
      ∃ r : ℝ, 0 < r ∧
        traceGaussSum (fullPfisterModulus α β) γ =
          (r : ℂ) * Complex.exp (Real.pi * Complex.I * (traceSignature γ : ℂ) / 4) := by
    intro γ hγ
    obtain ⟨m, d, c, hm_pos, hc_pos, hd, h_sig, h_prod⟩ :=
      traceGaussSum_fullPfisterModulus_eq_prod_ratIntGaussSum α β γ hα hβ h_all_coprime h_sqfree hγ
    choose r hr_pos hr_eq using fun j : Fin (Module.finrank ℚ K) =>
      ratIntGaussSum_eq_pos_mul_exp_sign m (d j) hm_pos (hd j).1 (hd j).2
    refine ⟨c * ∏ j : Fin (Module.finrank ℚ K), r j,
      mul_pos hc_pos (Finset.prod_pos (fun j _ => hr_pos j)), ?_⟩
    rw [h_prod]
    have h_prod_eq :
        (∏ j : Fin (Module.finrank ℚ K), ratIntGaussSum m (d j)) =
          (∏ j : Fin (Module.finrank ℚ K), (r j : ℂ)) *
            ∏ j : Fin (Module.finrank ℚ K),
              Complex.exp (Real.pi * Complex.I * (if d j < 0 then (-1 : ℂ) else 1) / 4) := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl (fun j _ => hr_eq j)
    rw [h_prod_eq, ← Complex.exp_sum]
    have h_cast_r :
        ((c * ∏ j : Fin (Module.finrank ℚ K), r j : ℝ) : ℂ) =
          (c : ℂ) * ∏ j : Fin (Module.finrank ℚ K), (r j : ℂ) := by
      push_cast
      rfl
    rw [h_cast_r, mul_assoc]
    congr 2
    congr 1
    have h_sum_exp :
        (∑ j : Fin (Module.finrank ℚ K),
          Real.pi * Complex.I * (if d j < 0 then (-1 : ℂ) else 1) / 4) =
          Real.pi * Complex.I *
            (∑ j : Fin (Module.finrank ℚ K), (if d j < 0 then (-1 : ℂ) else 1)) / 4 := by
      rw [← Finset.sum_div, ← Finset.mul_sum]
    rw [h_sum_exp, ← h_sig]
    have h_cast_sig :
        (((∑ j : Fin (Module.finrank ℚ K), if d j < 0 then (-1 : ℤ) else 1) : ℤ) : ℂ) =
          ∑ j : Fin (Module.finrank ℚ K), (if d j < 0 then (-1 : ℂ) else 1) := by
      push_cast
      refine Finset.sum_congr rfl (fun j _ => ?_)
      split_ifs <;> simp
    rw [h_cast_sig]
  obtain ⟨R₁, hR₁_pos, hR₁_eq⟩ := h_1var 1 ⟨α * β, (one_mul (α * β)).symm⟩
  obtain ⟨R₂, hR₂_pos, hR₂_eq⟩ := h_1var (-α) ⟨-β, (neg_mul_neg α β).symm⟩
  obtain ⟨R₃, hR₃_pos, hR₃_eq⟩ := h_1var (-β) ⟨-α, by ring⟩
  obtain ⟨R₄, hR₄_pos, hR₄_eq⟩ := h_1var (α * β) ⟨1, (mul_one (α * β)).symm⟩
  obtain ⟨h_sig_sum, h_sig_dvd⟩ := pfisterSignature_eq_sum_traceSignature α β hα hβ
  let k : ℕ := pfisterSignature α β / 4
  have hk : pfisterSignature α β = 4 * k := (Nat.mul_div_cancel' h_sig_dvd).symm
  have h_exp_prod :
      Complex.exp (Real.pi * Complex.I * (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) / 4) *
        Complex.exp (Real.pi * Complex.I * (traceSignature (-α) : ℂ) / 4) *
        Complex.exp (Real.pi * Complex.I * (traceSignature (-β) : ℂ) / 4) *
        Complex.exp (Real.pi * Complex.I * (traceSignature (α * β) : ℂ) / 4) =
        ((-1 : ℂ) ^ k) := by
    rw [← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]
    have h_arg :
        Real.pi * Complex.I * (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) / 4 +
          Real.pi * Complex.I * (traceSignature (-α) : ℂ) / 4 +
          Real.pi * Complex.I * (traceSignature (-β) : ℂ) / 4 +
          Real.pi * Complex.I * (traceSignature (α * β) : ℂ) / 4 =
        ((k : ℕ) : ℂ) * (Real.pi * Complex.I) := by
      have h_sum_c :
          (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) +
            (traceSignature (-α) : ℂ) +
            (traceSignature (-β) : ℂ) +
            (traceSignature (α * β) : ℂ) =
          4 * ((k : ℕ) : ℂ) := by
        have h1 :
            ((pfisterSignature α β : ℤ) : ℂ) =
              (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) +
                (traceSignature (-α) : ℂ) +
                (traceSignature (-β) : ℂ) +
                (traceSignature (α * β) : ℂ) := by
          exact_mod_cast h_sig_sum
        rw [← h1, hk]
        push_cast
        ring
      calc
        Real.pi * Complex.I * (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) / 4 +
            Real.pi * Complex.I * (traceSignature (-α) : ℂ) / 4 +
            Real.pi * Complex.I * (traceSignature (-β) : ℂ) / 4 +
            Real.pi * Complex.I * (traceSignature (α * β) : ℂ) / 4
          = Real.pi * Complex.I *
              ((traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) +
                (traceSignature (-α) : ℂ) +
                (traceSignature (-β) : ℂ) +
                (traceSignature (α * β) : ℂ)) / 4 := by ring
        _ = Real.pi * Complex.I * (4 * ((k : ℕ) : ℂ)) / 4 := by rw [h_sum_c]
        _ = ((k : ℕ) : ℂ) * (Real.pi * Complex.I) := by ring
    rw [h_arg, Complex.exp_nat_mul, Complex.exp_pi_mul_I]
  have h_pfister_full :
      pfisterGaussSum (fullPfisterModulus α β) α β =
        ((R₁ * R₂ * R₃ * R₄ : ℝ) * ((archPfisterSign α β : ℤ) : ℝ)) := by
    unfold pfisterGaussSum
    rw [hR₁_eq, hR₂_eq, hR₃_eq, hR₄_eq]
    have h_rearrange :
        (R₁ : ℂ) * Complex.exp (Real.pi * Complex.I * (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) / 4) *
          ((R₂ : ℂ) * Complex.exp (Real.pi * Complex.I * (traceSignature (-α) : ℂ) / 4)) *
          ((R₃ : ℂ) * Complex.exp (Real.pi * Complex.I * (traceSignature (-β) : ℂ) / 4)) *
          ((R₄ : ℂ) * Complex.exp (Real.pi * Complex.I * (traceSignature (α * β) : ℂ) / 4)) =
        ((R₁ * R₂ * R₃ * R₄ : ℝ) : ℂ) *
          (Complex.exp (Real.pi * Complex.I * (traceSignature (1 : NumberField.RingOfIntegers K) : ℂ) / 4) *
            Complex.exp (Real.pi * Complex.I * (traceSignature (-α) : ℂ) / 4) *
            Complex.exp (Real.pi * Complex.I * (traceSignature (-β) : ℂ) / 4) *
            Complex.exp (Real.pi * Complex.I * (traceSignature (α * β) : ℂ) / 4)) := by
      push_cast
      ring
    rw [h_rearrange, h_exp_prod]
    have h_neg_one_pow : ((-1 : ℂ) ^ k) = (((archPfisterSign α β : ℤ) : ℝ) : ℂ) := by
      change ((-1 : ℂ) ^ k) = (((((-1 : ℤˣ) ^ k : ℤˣ) : ℤ) : ℝ) : ℂ)
      push_cast
      rfl
    rw [h_neg_one_pow, ← Complex.ofReal_mul, Complex.ofReal_re]
  obtain ⟨w, hw_pos, hw_eq⟩ := pfisterGaussSum_fullPfisterModulus_eq_mul_pos α β hα hβ
  have hR_tot_pos : 0 < R₁ * R₂ * R₃ * R₄ :=
    mul_pos (mul_pos (mul_pos hR₁_pos hR₂_pos) hR₃_pos) hR₄_pos
  rw [h_pfister_full] at hw_eq
  unfold pfisterGaussSign
  rcases Int.units_eq_one_or (archPfisterSign α β) with h_sign | h_sign
  · rw [h_sign] at hw_eq ⊢
    have hw_eq' :
        pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w =
          R₁ * R₂ * R₃ * R₄ := by
      simpa using hw_eq.symm
    have h_pos_prod :
        0 < pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w := by
      rw [hw_eq']
      exact hR_tot_pos
    have h_pos : 0 < pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β :=
      pos_of_mul_pos_left h_pos_prod (le_of_lt hw_pos)
    exact if_pos h_pos
  · rw [h_sign] at hw_eq ⊢
    have hw_eq' :
        pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w =
          -(R₁ * R₂ * R₃ * R₄) := by
      calc
        pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w
          = R₁ * R₂ * R₃ * R₄ * (((-1 : ℤˣ) : ℤ) : ℝ) := hw_eq.symm
        _ = -(R₁ * R₂ * R₃ * R₄) := by norm_num
    have h_not_pos : ¬ (0 < pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β) := by
      intro h_pos
      have h_prod_pos :
          0 < pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w :=
        mul_pos h_pos hw_pos
      linarith
    exact if_neg h_not_pos

theorem dyadicGaussSign_eq_oddPowGaussProd_mul_archPfisterSign_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    dyadicGaussSign α β = oddPowGaussProd α β * oddPowGaussProd β α * archPfisterSign α β :=
by
  have h_crt :
      pfisterGaussSign (dyadicGaussModulus K * oddPfisterModulus α β) α β =
        dyadicGaussSign α β * pfisterGaussSign (oddPfisterModulus α β) α β :=
    pfisterGaussSign_mul_oddPfisterModulus_of_all_coprime α β hα hβ h_all_coprime h_sqfree
  have h_odd :
      pfisterGaussSign (oddPfisterModulus α β) α β =
        oddPowGaussProd α β * oddPowGaussProd β α :=
    pfisterGaussSign_oddPfisterModulus_eq_oddPowGaussProd_of_all_coprime α β hα hβ h_all_coprime
  have h_arch :
      pfisterGaussSign (dyadicGaussModulus K * oddPfisterModulus α β) α β =
        archPfisterSign α β :=
    pfisterGaussSign_mul_oddPfisterModulus_eq_archPfisterSign_of_all_coprime
      α β hα hβ h_all_coprime h_sqfree
  have h_eq :
      archPfisterSign α β =
        dyadicGaussSign α β * (oddPowGaussProd α β * oddPowGaussProd β α) := by
    rw [← h_arch, h_crt, h_odd]
  calc dyadicGaussSign α β
    _ = dyadicGaussSign α β *
          ((oddPowGaussProd α β * oddPowGaussProd β α) *
            (oddPowGaussProd α β * oddPowGaussProd β α)) := by
        rw [Int.units_mul_self, mul_one]
    _ = (dyadicGaussSign α β * (oddPowGaussProd α β * oddPowGaussProd β α)) *
          (oddPowGaussProd α β * oddPowGaussProd β α) := by
        ac_rfl
    _ = archPfisterSign α β * (oddPowGaussProd α β * oddPowGaussProd β α) := by
        rw [← h_eq]
    _ = oddPowGaussProd α β * oddPowGaussProd β α * archPfisterSign α β := by
        ac_rfl

theorem unitDyadicProd_eq_oddPowResQuadProd_mul_realSignProd_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
