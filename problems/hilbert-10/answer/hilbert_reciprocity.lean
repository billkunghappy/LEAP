  have hr_pos : 0 < r := mul_pos (Nat.cast_pos.mpr hc_pos) hr₀_pos
  refine ⟨r, hr_pos, ?_⟩
  have hm_eq' : m = c * (8 * K) := by
    change m = d.natAbs * (8 * K)
    rw [hm_eq]
    ring
  have h8K_pos : 0 < 8 * K := by omega
  by_cases hd_neg : d < 0
