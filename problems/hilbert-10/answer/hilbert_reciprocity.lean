      have h_lin_s : 2 * x_b * δu + 2 * w_b * δy ∈ v.asIdeal ^ s :=
        h_lin_mem s s hδu2_s hδy2_s (by omega) (by omega)
      rw [h_expand]
      exact (v.asIdeal ^ s).add_mem hq_s h_lin_s
  have h_deriv_diff_bounds : ∀ (γ x_b y_b x y : R),
      γ ∉ v.asIdeal →
      γ * (x_b ^ 2 - β * y_b ^ 2) - c ∈ v.asIdeal ^ (n - 1) →
      (x ^ 2 - β * y ^ 2) - (x_b ^ 2 - β * y_b ^ 2) ∈ v.asIdeal ^ (l_crit + 1) →
      2 * (x - x_b) ∈ v.asIdeal ^ (m + 1) ∧
