      have h0 := Complex.tsum_exp_neg_quadratic ha_re 0
      simpa using h0
    have hd_eq_mul : d = ((16 * (K : ℝ) * T : ℝ) : ℂ) * (Complex.I * a) := by
      dsimp [a, d]
      push_cast
      field_simp [hK_c, hT_c]
      ring_nf
      rw [Complex.I_sq]
      ring
    have h_one_div_a : 1 / a = 4 * (K : ℂ) * Complex.I + 1 / d := by
      field_simp [ha_ne, hd_ne]
      dsimp [a, d]
      push_cast
      field_simp [hK_c, hT_c]
      ring_nf
      have hI3 : Complex.I ^ 3 = -Complex.I := by
        calc Complex.I ^ 3 = Complex.I ^ 2 * Complex.I := by ring
          _ = -Complex.I := by rw [Complex.I_sq]; ring
      rw [hI3, Complex.I_sq]
      ring
    have h_inv_eq : ∀ n : ℤ,
        Complex.exp (-Real.pi / a * (n : ℂ) ^ 2) =
          Complex.exp (-Real.pi / d * (n : ℂ) ^ 2) := by
      intro n
      let k : ℤ := -2 * (K : ℤ) * n ^ 2
      have h_exp :
          -Real.pi / a * (n : ℂ) ^ 2 =
            -Real.pi / d * (n : ℂ) ^ 2 + (k : ℂ) * (2 * Real.pi * Complex.I) := by
        dsimp [k]
        push_cast
