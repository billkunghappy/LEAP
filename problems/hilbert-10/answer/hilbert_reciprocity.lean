        dsimp [ρ]
        rw [← sub_eq_zero]
        have h_cast : (((b.repr (Φ (z + w)) k : ℤ) : ZMod c_lat) - ((b.repr (Φ z) k : ℤ) : ZMod c_lat)) =
            (((b.repr (Φ (z + w)) k - b.repr (Φ z) k : ℤ) : ZMod c_lat)) := by push_cast; ring
        rw [h_cast, h_repr]
        push_cast
        rw [ZMod.natCast_self, zero_mul]
      let S_r : Finset A := Finset.univ.filter (fun z : A => ρ z = r)
      change ∑ z ∈ S_r, ψ z = 0
      have h_sum_shift : (∑ z ∈ S_r, ψ z) = ∑ z ∈ S_r, ψ (z + w) := by
        symm
        refine Finset.sum_equiv (Equiv.addRight w) (fun z => ?_) (fun z _ => rfl)
        simp only [S_r, Finset.mem_filter, Finset.mem_univ, true_and]
        change ρ z = r ↔ ρ (z + w) = r
        rw [hρ_shift z]
      let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I * (((r i).val : ℕ) : ℂ) / (c_lat : ℂ))
