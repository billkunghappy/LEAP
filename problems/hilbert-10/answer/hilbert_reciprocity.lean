  have exists_rat_approx_of_val_le_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (N : ℕ) (W : v.adicCompletion K),
        Valued.v W ≤ 1 →
        ∃ a₀ b₀ : R,
          b₀ ∉ v.asIdeal ∧
          Valued.v (algebraMap K (v.adicCompletion K) (algebraMap R K a₀) -
            algebraMap K (v.adicCompletion K) (algebraMap R K b₀) * W) ≤
              WithZero.exp (-(N : ℤ)) := by
    intro v N W hW_le
    let ι : R →+* v.adicCompletion K := (algebraMap K (v.adicCompletion K)).comp (algebraMap R K)
    let γ : (WithZero (Multiplicative ℤ))ˣ :=
      Units.mk0 (WithZero.exp (-(N : ℤ))) WithZero.exp_ne_zero
    have h_nhds : {y : v.adicCompletion K | Valued.v (y - W) < (γ : WithZero (Multiplicative ℤ))} ∈
        nhds W := by
      rw [Valued.mem_nhds]
      exact ⟨γ, Set.Subset.rfl⟩
    obtain ⟨c₀, hc₀⟩ :=
      (@UniformSpace.Completion.denseRange_coe (WithVal (v.valuation K)) _).mem_nhds h_nhds
    let c : K := (WithVal.equiv (v.valuation K)) c₀
    let cF : v.adicCompletion K := algebraMap K (v.adicCompletion K) c
    have hc_le : Valued.v (cF - W) ≤ WithZero.exp (-(N : ℤ)) := le_of_lt hc₀
    have hexp_le_one : WithZero.exp (-(N : ℤ)) ≤ 1 := by
      rw [← WithZero.exp_zero, WithZero.exp_le_exp]; omega
    have hcF_le : Valued.v cF ≤ 1 := by
      have h_eq_c : cF = (cF - W) + W := by ring
      rw [h_eq_c]
