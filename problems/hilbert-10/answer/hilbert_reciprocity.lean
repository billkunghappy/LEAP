      have h16KT_c_ne : ((16 * (K : ℝ) * T : ℝ) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt h16KT_pos)
      rw [Complex.cpow_def_of_ne_zero hd_ne,
        Complex.cpow_def_of_ne_zero h16KT_c_ne,
        Complex.cpow_def_of_ne_zero ha_ne,
        h_log_d, h_log_I, ← Complex.ofReal_log (le_of_lt h16KT_pos),
