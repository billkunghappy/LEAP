    have hρ_V : ρ.mapMatrix V = Vp := by
      ext i j
      simp [V, ρ]
    have hρ_D : ρ.mapMatrix D = Dp := by
      ext i j
      by_cases hij : i = j
      · subst hij
        simp [D, Dp]
      · simp [D, Dp, Matrix.diagonal_apply_ne _ hij]
