            α * (x ^ 2 - β * y ^ 2) - δ =
          (α * ((1 * x + a₀ * Δ₂) ^ 2 - β * (1 * y + b₀ * Δ₂) ^ 2) -
            α * (x ^ 2 - β * y ^ 2) - α * (Q₀ * Δ₂ ^ 2 + g₂ * Δ₂)) +
          (α * (Q₀ * Δ₂ ^ 2 + g₂ * Δ₂) - δ) := by dsimp [g₂]; ring
      rw [hid]
      exact (v.asIdeal ^ n).add_mem h_st h_wp₂_δ
  · right
    let Δ : R := z * Δ₀
    have hΔ_mem : Δ ∈ v.asIdeal ^ k :=
      (v.asIdeal ^ k).mul_mem_left z hΔ₀_mem
    have h_wp_coset : (δ_star + (Q₀ * Δ ^ 2 + g₁ * Δ)) - δ ∈ v.asIdeal ^ n := by
      have h1 := h_wp_norm z
      have h2 := hs₀_mul_mem (t₀ + (z ^ 2 + z) - t) hz
      have hid : (δ_star + (Q₀ * Δ ^ 2 + g₁ * Δ)) - δ =
          (δ_star - s₀ * t₀) +
          ((Q₀ * (z * Δ₀) ^ 2 + g₁ * (z * Δ₀)) - s₀ * (z ^ 2 + z)) +
          s₀ * (t₀ + (z ^ 2 + z) - t) - (δ - s₀ * t) := by dsimp [Δ]; ring
      rw [hid]
      exact (v.asIdeal ^ n).sub_mem
        ((v.asIdeal ^ n).add_mem ((v.asIdeal ^ n).add_mem ht₀ h1) h2) ht
    refine ⟨r, x₁ - r * x₂ + a₀ * Δ, y₁ - r * y₂ + b₀ * Δ, hr_unit, ?_⟩
    intro x y h_or
    have h_sw := h_swap_aff Δ hΔ_mem x y h_or
    have hid : 1 * ((r * x + (x₁ - r * x₂ + a₀ * Δ)) ^ 2 -
          β * (r * y + (y₁ - r * y₂ + b₀ * Δ)) ^ 2) -
          α * (x ^ 2 - β * y ^ 2) - δ =
        (1 * ((r * x + (x₁ - r * x₂ + a₀ * Δ)) ^ 2 -
          β * (r * y + (y₁ - r * y₂ + b₀ * Δ)) ^ 2) -
          α * (x ^ 2 - β * y ^ 2) -
          (δ_star + (Q₀ * Δ ^ 2 + g₁ * Δ))) +
        ((δ_star + (Q₀ * Δ ^ 2 + g₁ * Δ)) - δ) := by ring
    rw [hid]
    exact (v.asIdeal ^ n).add_mem h_sw h_wp_coset

theorem dyadicNormFiberCard_add_eq_of_unitDyadicSym_eq_neg_one {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (α β : NumberField.RingOfIntegers K)
    (hα_unit : α ∉ v.asIdeal) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1)
    (h_sym : unitDyadicSym v α β = -1)
    (n : ℕ) (hn_low : 2 * valNat v (2 : NumberField.RingOfIntegers K) + 1 ≤ n)
    (hn_high : n ≤ valNat v (dyadicGaussModulus K : NumberField.RingOfIntegers K))
    (c δ : NumberField.RingOfIntegers K) (hδ : δ ∈ v.asIdeal ^ (n - 1)) :
    dyadicNormFiberCard v n 1 β (c + δ) + dyadicNormFiberCard v n α β (c + δ) =
      dyadicNormFiberCard v n 1 β c + dyadicNormFiberCard v n α β c :=
by
  let R := NumberField.RingOfIntegers K
  let e : ℕ := valNat v (2 : R)
  have h2_ne : (2 : R) ≠ 0 := two_ne_zero
  have hn_pos : 1 ≤ n := by omega
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have mem_pow_iff_le_valNat :
      ∀ (x : R) (m : ℕ), x ≠ 0 → (x ∈ v.asIdeal ^ m ↔ m ≤ valNat v x) := by
    intro x m hx
    rw [← v.intValuation_le_pow_iff_mem x m, intValuation_eq_exp_neg_valNat x hx,
      WithZero.exp_le_exp]
    omega
  have valNat_mul :
      ∀ (x y : R), x ≠ 0 → y ≠ 0 → valNat v (x * y) = valNat v x + valNat v y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h1 := intValuation_eq_exp_neg_valNat (x * y) hxy
    rw [map_mul, intValuation_eq_exp_neg_valNat x hx, intValuation_eq_exp_neg_valNat y hy,
      ← WithZero.exp_add] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have valNat_pow :
      ∀ (x : R) (k : ℕ), x ≠ 0 → valNat v (x ^ k) = k * valNat v x := by
    intro x k hx
    induction' k with k ih
    · have h1 : v.intValuation (1 : R) = WithZero.exp (0 : ℤ) := by simp
      have h2 := intValuation_eq_exp_neg_valNat (1 : R) one_ne_zero
      rw [h1] at h2
      have hinj := WithZero.exp_injective h2
      simp only [pow_zero, zero_mul]
      omega
    · rw [pow_succ', valNat_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
      ring
  have he_pos : 1 ≤ e :=
    (mem_pow_iff_le_valNat (2 : R) 1 h2_ne).mp (by simpa using h2v)
  have h_no_prim : ∀ x y z : R,
      ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) →
      x ^ 2 - β * y ^ 2 - α * z ^ 2 ∉ v.asIdeal ^ (2 * e + 1) := by
    intro x y z h_prim h_mem
    have h_pos : unitDyadicSym v α β = 1 := by
      dsimp [unitDyadicSym]
      exact if_pos ⟨x, y, z, h_prim, h_mem⟩
    rw [h_sym] at h_pos
    exact (by decide : (-1 : ℤˣ) ≠ 1) h_pos
  have pow_valNat_le_span_sup :
      ∀ (x : R) (m : ℕ),
        x ≠ 0 → 1 ≤ m → v.asIdeal ^ (valNat v x) ≤ Ideal.span {x} ⊔ v.asIdeal ^ m := by
    intro x m hx hm
    let k : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(k : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ k ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x k).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (k + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le := (mem_pow_iff_le_valNat x (k + 1) hx).mp hx_mem
      omega
    have h_coprime : IsCoprime J (v.asIdeal ^ m) := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ := Ideal.exists_le_maximal (J ⊔ v.asIdeal ^ m) h_ne_top
      have hJ_le_𝔪 : J ≤ 𝔪 := le_trans le_sup_left h_le_𝔪
      have hIm_le_𝔪 : v.asIdeal ^ m ≤ 𝔪 := le_trans le_sup_right h_le_𝔪
      have hv_le_𝔪 : v.asIdeal ≤ 𝔪 := by
        intro z hz
        exact h𝔪_max.isPrime.mem_of_pow_mem m (hIm_le_𝔪 (Ideal.pow_mem_pow hz m))
      have hv_eq_𝔪 : v.asIdeal = 𝔪 := v.isMaximal.eq_of_le h𝔪_max.ne_top hv_le_𝔪
      rw [← hv_eq_𝔪] at hJ_le_𝔪
      exact hJ_not_le hJ_le_𝔪
    obtain ⟨j, hjJ, i, hiIm, hji⟩ := Ideal.isCoprime_iff_exists.mp h_coprime
    intro w hw
    have hw_eq : w = w * j + w * i := by
      calc w = w * 1 := (mul_one w).symm
        _ = w * (j + i) := by rw [hji]
        _ = w * j + w * i := mul_add w j i
    rw [hw_eq]
    refine Submodule.add_mem_sup ?_ ((v.asIdeal ^ m).mul_mem_left w hiIm)
    rw [hJ]
    exact Ideal.mul_mem_mul hw hjJ
  have exists_sq_mod_v : ∀ (γ u₀ : R), γ ∉ v.asIdeal → ∃ t₀ : R, γ * t₀ ^ 2 - u₀ ∈ v.asIdeal := by
    intro γ u₀ hγ
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    let f : (NumberField.RingOfIntegers K ⧸ v.asIdeal) → (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      fun t => Ideal.Quotient.mk v.asIdeal γ * t ^ 2
    have hf_inj : Function.Injective f := by
      intro t₁ t₂ h_eq
      let x₁ : R := Quotient.out t₁
      let x₂ : R := Quotient.out t₂
      have h_sub : γ * x₁ ^ 2 - γ * x₂ ^ 2 ∈ v.asIdeal := by
        apply Ideal.Quotient.eq.mp
        rw [map_mul, map_pow, map_mul, map_pow, Ideal.Quotient.mk_out, Ideal.Quotient.mk_out]
        exact h_eq
      have h2_mem : 2 * γ * x₂ * (x₁ - x₂) ∈ v.asIdeal := by
        have hid : 2 * γ * x₂ * (x₁ - x₂) = 2 * (γ * x₂ * (x₁ - x₂)) := by ring
        rw [hid]
        exact v.asIdeal.mul_mem_right (γ * x₂ * (x₁ - x₂)) h2v
      have h_sq_mem : γ * (x₁ - x₂) ^ 2 ∈ v.asIdeal := by
        have hid : γ * (x₁ - x₂) ^ 2 = (γ * x₁ ^ 2 - γ * x₂ ^ 2) - 2 * γ * x₂ * (x₁ - x₂) := by
          ring
        rw [hid]
        exact v.asIdeal.sub_mem h_sub h2_mem
      have h_pow_mem : (x₁ - x₂) ^ 2 ∈ v.asIdeal :=
        (v.isPrime.mem_or_mem h_sq_mem).resolve_left hγ
      have h_diff_mem : x₁ - x₂ ∈ v.asIdeal := v.isPrime.mem_of_pow_mem 2 h_pow_mem
      rw [← Ideal.Quotient.mk_out t₁, ← Ideal.Quotient.mk_out t₂]
      exact Ideal.Quotient.eq.mpr h_diff_mem
    have hf_surj : Function.Surjective f := Finite.surjective_of_injective hf_inj
    obtain ⟨t, ht⟩ := hf_surj (Ideal.Quotient.mk v.asIdeal u₀)
    refine ⟨Quotient.out t, ?_⟩
    apply Ideal.Quotient.eq.mp
    rw [map_mul, map_pow, Ideal.Quotient.mk_out]
    exact ht
  obtain ⟨π, hπ_val⟩ := v.intValuation_exists_uniformizer
  have hπ_ne : π ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hπ_val
    exact WithZero.exp_ne_zero hπ_val.symm
  have hπ_valNat : valNat v π = 1 := by
    have h1 := intValuation_eq_exp_neg_valNat π hπ_ne
    rw [hπ_val] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have hπ_mem : π ∈ v.asIdeal := by
    rw [← pow_one v.asIdeal, mem_pow_iff_le_valNat π 1 hπ_ne, hπ_valNat]
  have exists_sq_step : ∀ (k : ℕ) (γ r : R),
      γ ∉ v.asIdeal → r ∈ v.asIdeal ^ (2 * k) →
      ∃ z : R, z ∈ v.asIdeal ^ k ∧ r - γ * z ^ 2 ∈ v.asIdeal ^ (2 * k + 1) := by
    intro k γ r hγ hr
    have hπ2k_ne : π ^ (2 * k) ≠ 0 := pow_ne_zero (2 * k) hπ_ne
    have hπ2k_val : valNat v (π ^ (2 * k)) = 2 * k := by
      rw [valNat_pow π (2 * k) hπ_ne, hπ_valNat, mul_one]
    have h_sup : r ∈ Ideal.span {π ^ (2 * k)} ⊔ v.asIdeal ^ (2 * k + 1) := by
      have hr' : r ∈ v.asIdeal ^ (valNat v (π ^ (2 * k))) := by
        rw [hπ2k_val]
        exact hr
      exact pow_valNat_le_span_sup (π ^ (2 * k)) (2 * k + 1) hπ2k_ne (by omega) hr'
    rw [Submodule.mem_sup] at h_sup
    obtain ⟨u, hu, r₁, hr₁, hur⟩ := h_sup
    obtain ⟨u₀, rfl⟩ := Ideal.mem_span_singleton.mp hu
    obtain ⟨t₀, ht₀⟩ := exists_sq_mod_v γ u₀ hγ
    refine ⟨t₀ * π ^ k, ?_, ?_⟩
    · exact (v.asIdeal ^ k).mul_mem_left t₀ (Ideal.pow_mem_pow hπ_mem k)
    · have hπ2k_mem : π ^ (2 * k) ∈ v.asIdeal ^ (2 * k) := by
        rw [mem_pow_iff_le_valNat (π ^ (2 * k)) (2 * k) hπ2k_ne, hπ2k_val]
      have h_prod_mem : π ^ (2 * k) * (γ * t₀ ^ 2 - u₀) ∈ v.asIdeal ^ (2 * k + 1) := by
        rw [pow_succ]
        exact Ideal.mul_mem_mul hπ2k_mem ht₀
      have hid : r - γ * (t₀ * π ^ k) ^ 2 = r₁ - π ^ (2 * k) * (γ * t₀ ^ 2 - u₀) := by
        have h_pow : (π ^ k) ^ 2 = π ^ (2 * k) := by rw [← pow_mul, mul_comm k 2]
        linear_combination -hur - γ * t₀ ^ 2 * h_pow
      rw [hid]
      exact (v.asIdeal ^ (2 * k + 1)).sub_mem hr₁ h_prod_mem
  have h1_unit : (1 : R) ∉ v.asIdeal :=
    fun h1 => v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1)
  have h_not_mem_2e : ∀ x : R, x ^ 2 - β ∉ v.asIdeal ^ (2 * e) := by
    intro x hx
    obtain ⟨z, _, hz_sub⟩ := exists_sq_step e α (x ^ 2 - β) hα_unit hx
    apply h_no_prim x 1 z (fun h => h1_unit h.2.1)
    simpa using hz_sub
  have h_ex_x₀_k₀ : ∃ (x₀ : R) (k₀ : ℕ),
      k₀ < e ∧ x₀ ^ 2 - β ≠ 0 ∧ valNat v (x₀ ^ 2 - β) = 2 * k₀ + 1 ∧
      (β ∈ v.asIdeal → x₀ = 0 ∧ k₀ = 0) ∧
      (β ∉ v.asIdeal → x₀ ∉ v.asIdeal) := by
    by_cases hβ_in : β ∈ v.asIdeal
    · refine ⟨0, 0, he_pos, ?_, ?_, fun _ => ⟨rfl, rfl⟩, fun h => False.elim (h hβ_in)⟩
      · intro h0
        apply hβ
        linear_combination -h0
      · have hβ_ge : 1 ≤ valNat v β :=
          (mem_pow_iff_le_valNat β 1 hβ).mp (by simpa using hβ_in)
        have hβ_val : valNat v β = 1 := by omega
        have h_neg : (0 : R) ^ 2 - β = (-1 : R) * β := by ring
        have h_neg1_ne : (-1 : R) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have h_neg1_unit : (-1 : R) ∉ v.asIdeal := by
          intro h_in
          exact h1_unit (by simpa using v.asIdeal.neg_mem h_in)
        have h_neg1_val : valNat v (-1 : R) = 0 := by
          have h_le : ¬ (1 ≤ valNat v (-1 : R)) := by
            rw [← mem_pow_iff_le_valNat (-1 : R) 1 h_neg1_ne, pow_one]
            exact h_neg1_unit
          omega
        rw [h_neg, valNat_mul (-1 : R) β h_neg1_ne hβ, h_neg1_val, hβ_val]
    · have h_neg1_unit : (-1 : R) ∉ v.asIdeal := by
        intro h_in
        exact h1_unit (by simpa using v.asIdeal.neg_mem h_in)
      have h_ind : ∀ k : ℕ, ∃ x : R,
          x ^ 2 - β ∈ v.asIdeal ^ (2 * k) ∨
          ∃ k₀ < k, valNat v (x ^ 2 - β) = 2 * k₀ + 1 := by
        intro k
        induction' k with k ih
        · refine ⟨0, Or.inl ?_⟩
          rw [mul_zero, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · rcases ih with ⟨x, hx_even | ⟨k₀, hk₀_lt, hk₀_val⟩⟩
          · obtain ⟨z, hz_mem, hz_sub⟩ := exists_sq_step k (-1 : R) (x ^ 2 - β) h_neg1_unit hx_even
            by_cases hk_ge : e ≤ k
            · exfalso
              exact h_not_mem_2e x (Ideal.pow_le_pow_right (by omega : 2 * e ≤ 2 * k) hx_even)
            · have h2z_mem : 2 * x * z ∈ v.asIdeal ^ (2 * k + 1) := by
                have h2z : 2 * z ∈ v.asIdeal ^ (e + k) := by
                  rw [pow_add]
                  exact Ideal.mul_mem_mul
                    ((mem_pow_iff_le_valNat (2 : R) e h2_ne).mpr le_rfl) hz_mem
                have h2xz : x * (2 * z) ∈ v.asIdeal ^ (2 * k + 1) :=
                  (v.asIdeal ^ (2 * k + 1)).mul_mem_left x
                    (Ideal.pow_le_pow_right (by omega : 2 * k + 1 ≤ e + k) h2z)
                have hid : 2 * x * z = x * (2 * z) := by ring
                rw [hid]
                exact h2xz
              have hx'_odd : (x + z) ^ 2 - β ∈ v.asIdeal ^ (2 * k + 1) := by
                have hid : (x + z) ^ 2 - β = ((x ^ 2 - β) - (-1 : R) * z ^ 2) + 2 * x * z := by
                  ring
                rw [hid]
                exact (v.asIdeal ^ (2 * k + 1)).add_mem hz_sub h2z_mem
              by_cases hx'_even : (x + z) ^ 2 - β ∈ v.asIdeal ^ (2 * (k + 1))
              · exact ⟨x + z, Or.inl hx'_even⟩
              · refine ⟨x + z, Or.inr ⟨k, Nat.lt_succ_self k, ?_⟩⟩
                have h_ne : (x + z) ^ 2 - β ≠ 0 := by
                  intro h0
                  exact h_not_mem_2e (x + z) (h0 ▸ (v.asIdeal ^ (2 * e)).zero_mem)
                have h_ge := (mem_pow_iff_le_valNat ((x + z) ^ 2 - β) (2 * k + 1) h_ne).mp hx'_odd
                have h_not_ge : ¬ (2 * (k + 1) ≤ valNat v ((x + z) ^ 2 - β)) := by
                  rw [← mem_pow_iff_le_valNat ((x + z) ^ 2 - β) (2 * (k + 1)) h_ne]
                  exact hx'_even
                omega
          · exact ⟨x, Or.inr ⟨k₀, Nat.lt_succ_of_lt hk₀_lt, hk₀_val⟩⟩
      rcases h_ind e with ⟨x₀, hx_2e | ⟨k₀, hk₀_lt, hk₀_val⟩⟩
      · exfalso
        exact h_not_mem_2e x₀ hx_2e
      · have hd₀_ne : x₀ ^ 2 - β ≠ 0 := by
          intro h0
          exact h_not_mem_2e x₀ (h0 ▸ (v.asIdeal ^ (2 * e)).zero_mem)
        refine ⟨x₀, k₀, hk₀_lt, hd₀_ne, hk₀_val, fun h => False.elim (hβ_in h), fun _ hx₀_in => ?_⟩
        have hd₀_in : x₀ ^ 2 - β ∈ v.asIdeal := by
          rw [← pow_one v.asIdeal, mem_pow_iff_le_valNat (x₀ ^ 2 - β) 1 hd₀_ne]
          omega
        have hx₀2_in : x₀ ^ 2 ∈ v.asIdeal := by
          rw [sq]
          exact v.asIdeal.mul_mem_left x₀ hx₀_in
        apply hβ_in
        have hid : β = x₀ ^ 2 - (x₀ ^ 2 - β) := by ring
        rw [hid]
        exact v.asIdeal.sub_mem hx₀2_in hd₀_in
  obtain ⟨x₀, k₀, hk₀, hd₀_ne, hd₀_val, hx₀_mem, hx₀_unit⟩ := h_ex_x₀_k₀
  let d₀ : R := x₀ ^ 2 - β
  have h_qdiag : ∀ (u y : R) (m : ℕ),
      (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ m ↔
        u ^ 2 ∈ v.asIdeal ^ m ∧ d₀ * y ^ 2 ∈ v.asIdeal ^ m := by
    intro u y m
    have h_expand : (u + x₀ * y) ^ 2 - β * y ^ 2 = u ^ 2 + d₀ * y ^ 2 + 2 * x₀ * u * y := by
      dsimp [d₀]
      ring
    have h_val_u2 : ∀ u : R, u ≠ 0 → u ^ 2 ≠ 0 ∧ valNat v (u ^ 2) = 2 * valNat v u := by
      intro u hu
      exact ⟨pow_ne_zero 2 hu, valNat_pow u 2 hu⟩
    have h_val_d0y2 : ∀ y : R, y ≠ 0 →
        d₀ * y ^ 2 ≠ 0 ∧ valNat v (d₀ * y ^ 2) = 2 * k₀ + 1 + 2 * valNat v y := by
      intro y hy
      have hy2 : y ^ 2 ≠ 0 := pow_ne_zero 2 hy
      refine ⟨mul_ne_zero hd₀_ne hy2, ?_⟩
      rw [valNat_mul d₀ (y ^ 2) hd₀_ne hy2, hd₀_val, valNat_pow y 2 hy]
    have h_2x0uy_mem : ∀ (u y : R) (s : ℕ),
        u ≠ 0 → y ≠ 0 → s ≤ e + valNat v u + valNat v y →
        2 * x₀ * u * y ∈ v.asIdeal ^ s := by
      intro u y s hu hy hs
      have h2uy_ne : 2 * (u * y) ≠ 0 := mul_ne_zero h2_ne (mul_ne_zero hu hy)
      have h2uy_val : valNat v (2 * (u * y)) = e + valNat v u + valNat v y := by
        rw [valNat_mul (2 : R) (u * y) h2_ne (mul_ne_zero hu hy),
          valNat_mul u y hu hy, add_assoc]
      have h2uy_mem : 2 * (u * y) ∈ v.asIdeal ^ s := by
        rw [mem_pow_iff_le_valNat (2 * (u * y)) s h2uy_ne, h2uy_val]
        exact hs
      have hid : 2 * x₀ * u * y = x₀ * (2 * (u * y)) := by ring
      rw [hid]
      exact (v.asIdeal ^ s).mul_mem_left x₀ h2uy_mem
    constructor
    · intro h_sum
      by_cases hu0 : u = 0
