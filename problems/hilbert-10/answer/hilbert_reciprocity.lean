        rw [hqj_R]
        ring
      dsimp [Φ, r₀]
      rw [Finset.mul_sum, hu, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => h_term j)
    constructor
    · refine ⟨v + ((N * c_lat : ℕ) : R) * r₀, ?_⟩
      rw [hΦ]
      dsimp [m]
      push_cast
      ring
    · let y := Φ z
      let y₁ := y + (c_lat : R) * v
      let s₀ := γ * (2 * y₁ * r₀ + (m : R) * r₀ ^ 2)
      have h_sq : γ * (Φ (z + w)) ^ 2 =
          γ * y ^ 2 +
          (c_lat : R) * (2 * (γ * y * v)) +
          ((c_lat ^ 2 : ℕ) : R) * (γ * v ^ 2) +
          (m : R) * s₀ := by
        rw [hΦ]
        dsimp [y, y₁, s₀]
        push_cast
        ring
      have h_tr_eq :
          Algebra.trace ℤ R (γ * (Φ (z + w)) ^ 2) =
          Algebra.trace ℤ R (γ * y ^ 2) +
          (c_lat : ℤ) * (N : ℤ) * (b.repr y i) +
          (m : ℤ) * (k_v + Algebra.trace ℤ R s₀) := by
        rw [h_sq, map_add, map_add, map_add]
        rw [h_tr_nat c_lat (2 * (γ * y * v)), h_tr_two (γ * y * v), hv_lin y]
        rw [h_tr_nat (c_lat ^ 2) (γ * v ^ 2), hv_quad]
        rw [h_tr_nat m s₀]
        dsimp [m]
        push_cast
        ring
      dsimp [ψ]
      rw [h_tr_eq]
      have hN_c : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hN_pos)
      have hc_c : (c_lat : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hc_pos)
      have h_div :
          2 * Real.pi * Complex.I *
            (((Algebra.trace ℤ R (γ * y ^ 2) +
              (c_lat : ℤ) * (N : ℤ) * (b.repr y i) +
              (m : ℤ) * (k_v + Algebra.trace ℤ R s₀) : ℤ) : ℂ)) /
            (m : ℂ) =
          (2 * Real.pi * Complex.I * ((Algebra.trace ℤ R (γ * y ^ 2) : ℤ) : ℂ) / (m : ℂ) +
          2 * Real.pi * Complex.I * ((b.repr y i : ℤ) : ℂ) / (c_lat : ℂ)) +
          ((k_v + Algebra.trace ℤ R s₀ : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        dsimp [m]
        push_cast
        field_simp [hN_c, hc_c]
      rw [h_div, Complex.exp_add, Complex.exp_add, Complex.exp_int_mul, Complex.exp_two_pi_mul_I, one_zpow, mul_one]
  let G : Finset A := Finset.univ.filter (fun z : A => ∃ x : R, Φ z = (c_lat : R) * x)
  have h3 : (∑ z : A, ψ z) = ∑ z ∈ G, ψ z := by
