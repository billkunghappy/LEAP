        have hc_c : (c_lat : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hc_pos)
        have h_div :
            2 * Real.pi * Complex.I * ((b.repr (Φ z) i : ℤ) : ℂ) / (c_lat : ℂ) =
            2 * Real.pi * Complex.I * (((r i).val : ℕ) : ℂ) / (c_lat : ℂ) +
            (q : ℂ) * (2 * Real.pi * Complex.I) := by
          rw [hq']
          push_cast
          field_simp [hc_c]
        dsimp [ζ]
        rw [h_div, Complex.exp_add, Complex.exp_int_mul, Complex.exp_two_pi_mul_I, one_zpow, mul_one]
      have h_eq_mul : (∑ z ∈ S_r, ψ z) = (∑ z ∈ S_r, ψ z) * ζ := by
        calc ∑ z ∈ S_r, ψ z
          _ = ∑ z ∈ S_r, ψ (z + w) := h_sum_shift
          _ = ∑ z ∈ S_r, (ψ z * ζ) := Finset.sum_congr rfl h_term_r
