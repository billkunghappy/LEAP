    have hb : b ≠ 0 := nonZeroDivisors.ne_zero hb_mem
    have hbK : algebraMap R K b ≠ 0 := (IsFractionRing.injective R K).ne hb
    have hab_K : algebraMap R K a = algebraMap R K b * c := by
      rw [← hab_div, mul_div_cancel₀ _ hbK]
    have hab_F : ι a = ι b * cF := by
