        have hww : w * w⁻¹ = 1 := mul_inv_cancel₀ hw_ne
        linear_combination (w * w⁻¹ + 1) * hww
    have h_comm : ∀ (a b : K), hilbFin v a b = hilbFin v b a := by
      intro a b
      dsimp only [hilbFin, hilbLoc]
      apply if_congr _ rfl rfl
      constructor <;> (rintro ⟨x', y', hxy⟩; refine ⟨y', x', ?_⟩; rw [add_comm]; exact hxy)
    rcases Nat.even_or_odd (valNat v γ) with heγ | hoγ
    · rcases Nat.even_or_odd (valNat v β) with heβ | hoβ
      · obtain ⟨s, γ₀, hγ₀, hsγ⟩ := exists_mul_sq_eq_of_even_valNat γ hγ heγ
        obtain ⟨t, β₀, hβ₀, htβ⟩ := exists_mul_sq_eq_of_even_valNat β hβ heβ
        have h_mul_sq :
            hilbFin v (algebraMap R K γ) (algebraMap R K β) =
            hilbFin v (algebraMap R K γ₀) (algebraMap R K β₀) := by
          rw [← hsγ, ← htβ]
          dsimp only [hilbFin, hilbLoc]
          apply if_congr _ rfl rfl
          constructor
          · rintro ⟨x', y', hxy'⟩
            refine ⟨algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) * x',
              algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) * y', ?_⟩
            have hs_inv : algebraMap K (v.adicCompletion K) (s : K) *
                algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) = 1 := by
              rw [← map_mul, Units.mul_inv, map_one]
            have ht_inv : algebraMap K (v.adicCompletion K) (t : K) *
                algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) = 1 := by
              rw [← map_mul, Units.mul_inv, map_one]
            simp only [map_mul, map_pow]
            linear_combination hxy' +
              algebraMap K (v.adicCompletion K) (algebraMap R K γ) *
                x' ^ 2 * (algebraMap K (v.adicCompletion K) (s : K) *
                  algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) + 1) * hs_inv +
              algebraMap K (v.adicCompletion K) (algebraMap R K β) *
                y' ^ 2 * (algebraMap K (v.adicCompletion K) (t : K) *
                  algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) + 1) * ht_inv
          · rintro ⟨x', y', hxy⟩
            refine ⟨algebraMap K (v.adicCompletion K) (s : K) * x',
              algebraMap K (v.adicCompletion K) (t : K) * y', ?_⟩
            simp only [map_mul, map_pow] at hxy
            linear_combination hxy
        have hs1_ff : ∀ {F : Type u} [Field F] [Finite F] {a b : F},
            a ≠ 0 → b ≠ 0 → ∃ x' y' : F, a * x' ^ 2 + b * y' ^ 2 = 1 := by
          intro F _ _ a b ha hb
          letI : Fintype F := Fintype.ofFinite F
          let f : F → F := fun x' => x' ^ 2
          let Sq : Finset F := Finset.univ.image f
          let U : Finset F := Finset.univ.erase 0
          have hU_card : U.card ≤ 2 * (U.image f).card := by
            apply Finset.card_le_mul_card_image U 2
            intro w hw
            rcases Finset.mem_image.mp hw with ⟨x₀, _, rfl⟩
            have hsub : U.filter (fun x' => f x' = f x₀) ⊆ {x₀, -x₀} := by
              intro x' hx
              rw [Finset.mem_filter] at hx
              have hsq : x' ^ 2 = x₀ ^ 2 := hx.2
              rw [sq_eq_sq_iff_eq_or_eq_neg] at hsq
              rw [Finset.mem_insert, Finset.mem_singleton]
              exact hsq
            exact (Finset.card_le_card hsub).trans Finset.card_le_two
          have h0_not_mem : (0 : F) ∉ U.image f := by
            intro h0
            rcases Finset.mem_image.mp h0 with ⟨x', hx, hx0⟩
            exact (Finset.mem_erase.mp hx).1 (pow_eq_zero hx0)
          have hSq_eq : Sq = insert (0 : F) (U.image f) := by
            change Finset.univ.image f = insert (0 : F) (U.image f)
            rw [← Finset.insert_erase (Finset.mem_univ (0 : F)), Finset.image_insert]
            simp [f, U]
          have hSq_card : Sq.card = (U.image f).card + 1 := by
            rw [hSq_eq, Finset.card_insert_of_notMem h0_not_mem]
          have hF_card : Fintype.card F = U.card + 1 := by
            rw [← Finset.card_univ, ← Finset.card_erase_add_one (Finset.mem_univ (0 : F))]
          have h2Sq : Fintype.card F + 1 ≤ 2 * Sq.card := by omega
          let s₁ : Finset F := Sq.image (fun z => a * z)
          let s₂ : Finset F := Sq.image (fun z => 1 - b * z)
          have hs₁_card : s₁.card = Sq.card :=
            Finset.card_image_of_injective _ (mul_right_injective₀ ha)
          have hs₂_card : s₂.card = Sq.card :=
            Finset.card_image_of_injective _ (fun _ _ hz => mul_right_injective₀ hb (sub_right_inj.mp hz))
          have hinter_pos : 0 < (s₁ ∩ s₂).card := by
            have hunion := Finset.card_union_add_card_inter s₁ s₂
            have huniv : (s₁ ∪ s₂).card ≤ Fintype.card F := Finset.card_le_univ (s₁ ∪ s₂)
            omega
          rcases Finset.card_pos.mp hinter_pos with ⟨w, hw⟩
          rw [Finset.mem_inter] at hw
          rcases Finset.mem_image.mp hw.1 with ⟨z₁, hz₁, rfl⟩
          rcases Finset.mem_image.mp hz₁ with ⟨x', _, rfl⟩
          rcases Finset.mem_image.mp hw.2 with ⟨z₂, hz₂, hw₂⟩
          rcases Finset.mem_image.mp hz₂ with ⟨y', _, rfl⟩
          refine ⟨x', y', ?_⟩
          dsimp [f] at hw₂ ⊢
          linear_combination -hw₂
        haveI : v.asIdeal.IsMaximal := v.isMaximal
        haveI : v.asIdeal.IsPrime := v.isPrime
        have lift_unit : ∀ (α' β' x₀ y₀ : R),
            α' ∉ v.asIdeal → x₀ ∉ v.asIdeal → α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1 ∈ v.asIdeal →
            ∃ x' y' : v.adicCompletion K, ι α' * x' ^ 2 + ι β' * y' ^ 2 = 1 := by
          intro α' β' x₀ y₀ hα' hx₀ hconic
          let d : R := α' * x₀ ^ 2
          let r : R := α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1
          have hd_not_mem : d ∉ v.asIdeal := by
            intro hd
            rcases v.isPrime.mem_or_mem hd with h1 | h2
            · exact hα' h1
            · exact hx₀ (v.isPrime.mem_of_pow_mem 2 h2)
          have hd_val : Valued.v (ι d) = 1 :=
            ((IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
              (algebraMap R K d)).trans
              (v.valuation_of_algebraMap d)).trans (v.intValuation_eq_one_iff.mpr hd_not_mem)
          have hd_ne : ι d ≠ 0 := by
            intro h0
            rw [h0, Valuation.map_zero] at hd_val
            exact zero_ne_one hd_val
          have hd_inv : ι d * (ι d)⁻¹ = 1 := mul_inv_cancel₀ hd_ne
          have hr_val : Valued.v (ι r) ≤ WithZero.exp (-1 : ℤ) := by
            have hr_val_eq : Valued.v (ι r) = v.intValuation r :=
              (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
                (algebraMap R K r)).trans
                (v.valuation_of_algebraMap r)
            rw [hr_val_eq]
            exact (v.intValuation_le_pow_iff_mem r 1).mpr (by rw [pow_one]; exact hconic)
          let u : v.adicCompletion K := 1 - ι r * (ι d)⁻¹
          have hu_lt : Valued.v (u - 1) < 1 := by
            have hu_sub : u - 1 = -(ι r * (ι d)⁻¹) := by dsimp [u]; ring
            rw [hu_sub, Valuation.map_neg, map_mul, map_inv₀, hd_val, inv_one, mul_one]
            refine lt_of_le_of_lt hr_val ?_
            rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
            omega
          obtain ⟨w, hw⟩ := isSquare_of_val_sub_one_lt_one u hu_lt
          refine ⟨ι x₀ * w, ι y₀, ?_⟩
          have hd_map : ι d = ι α' * (ι x₀) ^ 2 := by dsimp [d]; simp [map_mul, map_pow]
          have hr_map : ι r = ι α' * (ι x₀) ^ 2 + ι β' * (ι y₀) ^ 2 - 1 := by
            dsimp [r]; simp [map_sub, map_add, map_mul, map_pow, map_one]
          calc
            ι α' * (ι x₀ * w) ^ 2 + ι β' * (ι y₀) ^ 2
              = (ι α' * (ι x₀) ^ 2) * (w * w) + ι β' * (ι y₀) ^ 2 := by ring
            _ = ι d * u + ι β' * (ι y₀) ^ 2 := by rw [← hd_map, ← hw]
            _ = ι d - ι r * (ι d * (ι d)⁻¹) + ι β' * (ι y₀) ^ 2 := by dsimp [u]; ring
            _ = 1 := by rw [hd_inv, mul_one, hd_map, hr_map]; ring
        letI : Field (R ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
        have hγ₀_bar : Ideal.Quotient.mk v.asIdeal γ₀ ≠ 0 :=
          Ideal.Quotient.eq_zero_iff_mem.not.mpr hγ₀
        have hβ₀_bar : Ideal.Quotient.mk v.asIdeal β₀ ≠ 0 :=
          Ideal.Quotient.eq_zero_iff_mem.not.mpr hβ₀
        obtain ⟨x_bar, y_bar, hxy_bar⟩ := hs1_ff hγ₀_bar hβ₀_bar
        obtain ⟨x₀, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
        obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
        have hconic : γ₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1 ∈ v.asIdeal := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          simp only [map_sub, map_add, map_mul, map_pow, map_one, hxy_bar, sub_self]
        have h_sol : ∃ x' y' : v.adicCompletion K, ι γ₀ * x' ^ 2 + ι β₀ * y' ^ 2 = 1 := by
          by_cases hx₀ : x₀ ∈ v.asIdeal
          · have hy₀ : y₀ ∉ v.asIdeal := by
              intro hy₀
              have hsum : γ₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 ∈ v.asIdeal := by
                refine v.asIdeal.add_mem ?_ ?_
                · have : γ₀ * x₀ ^ 2 = (γ₀ * x₀) * x₀ := by ring
                  rw [this]; exact v.asIdeal.mul_mem_left _ hx₀
                · have : β₀ * y₀ ^ 2 = (β₀ * y₀) * y₀ := by ring
                  rw [this]; exact v.asIdeal.mul_mem_left _ hy₀
              have h1 : (1 : R) ∈ v.asIdeal := by
                have hid : (1 : R) =
                    (γ₀ * x₀ ^ 2 + β₀ * y₀ ^ 2) - (γ₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1) := by ring
                rw [hid]; exact v.asIdeal.sub_mem hsum hconic
              exact v.isMaximal.ne_top (v.asIdeal.eq_top_iff_one.mpr h1)
            have hconic' : β₀ * y₀ ^ 2 + γ₀ * x₀ ^ 2 - 1 ∈ v.asIdeal := by
              have hid : β₀ * y₀ ^ 2 + γ₀ * x₀ ^ 2 - 1 = γ₀ * x₀ ^ 2 + β₀ * y₀ ^ 2 - 1 := by ring
              rw [hid]; exact hconic
            obtain ⟨y', x', hyx⟩ := lift_unit β₀ γ₀ y₀ x₀ hβ₀ hy₀ hconic'
            refine ⟨x', y', ?_⟩
            rw [add_comm]
            exact hyx
          · exact lift_unit γ₀ β₀ x₀ y₀ hγ₀ hx₀ hconic
        rw [h_mul_sq, hs5.1 heγ heβ]
        dsimp only [hilbFin, hilbLoc]
        exact if_pos h_sol
      · rw [h_comm, h_odd_even β γ hβ hγ hoβ heγ, hs5.2.2.1 heγ hoβ]
    · rcases Nat.even_or_odd (valNat v β) with heβ | hoβ
      · rw [h_odd_even γ β hγ hβ hoγ heβ, hs5.2.1 hoγ heβ]
      · have ha : algebraMap R K γ ≠ 0 :=
          (map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hγ
        have hξ : -(γ * β) ≠ 0 := neg_ne_zero.mpr (mul_ne_zero hγ hβ)
        have h_map_neg_mul :
            -(algebraMap R K γ * algebraMap R K β) =
            algebraMap R K (-(γ * β)) := by
          rw [map_neg, map_mul]
        rw [hilbFin_neg_mul_self_right (algebraMap R K γ) (algebraMap R K β) ha,
          h_map_neg_mul,
          h_odd_even γ (-(γ * β)) hγ hξ hoγ (hs5.2.2.2 hoγ hoβ).1,
          (hs5.2.2.2 hoγ hoβ).2]
  have h_tame_eq_norm : ∀ [DecidablePred (fun p : Prop => p)] (γ : R), γ ≠ 0 →
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R), (2 : R) ∉ v.asIdeal →
      (if (2 : R) ∉ v.asIdeal ∧ γ * β ∈ v.asIdeal then tameSym v γ β else 1) =
        normSym v γ β := by
    intro _ γ hγ v h2v
    have h_lhs : (if (2 : R) ∉ v.asIdeal ∧ γ * β ∈ v.asIdeal then tameSym v γ β else 1) =
        tameSym v γ β := by
      by_cases hgb : γ * β ∈ v.asIdeal
      · exact if_pos ⟨h2v, hgb⟩
      · have h_cond : ¬ ((2 : R) ∉ v.asIdeal ∧ γ * β ∈ v.asIdeal) := fun h => hgb h.2
        rw [if_neg h_cond, tameSym_eq_one_of_not_mem_asIdeal_loc v γ hgb]
    rw [h_lhs, ← hilbFin_eq_tameSym_of_two_not_mem_loc v h2v γ hγ,
      hilbFin_eq_normSym_loc v γ hγ]
  have h_odd : oddTameProd (α * (x ^ 2 - β * y ^ 2)) β = oddTameProd α β := by
    letI := Classical.propDecidable
    dsimp only [oddTameProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · have h1 : ¬ ((2 : R) ∉ v.asIdeal ∧ (α * (x ^ 2 - β * y ^ 2)) * β ∈ v.asIdeal) :=
        fun h => h.1 h2v
      have h2 : ¬ ((2 : R) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal) :=
        fun h => h.1 h2v
      rw [if_neg h1, if_neg h2]
    · have hα' : α * (x ^ 2 - β * y ^ 2) ≠ 0 := mul_ne_zero hα hδ
      rw [h_tame_eq_norm (α * (x ^ 2 - β * y ^ 2)) hα' v h2v,
        h_tame_eq_norm α hα v h2v, h_norm v]
  have h_real : realSignProd (α * (x ^ 2 - β * y ^ 2)) β = realSignProd α β := by
    letI := Classical.propDecidable
    dsimp only [realSignProd]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ c : K, (w.embedding c).re = ρ c := by
        intro c
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw c, Complex.ofReal_re]
      by_cases hb_neg : (w.embedding (algebraMap R K β)).re < 0
      · have hb_rho : ρ (algebraMap R K β) < 0 := by rwa [← h_re]
        let dR : ℝ := ρ (algebraMap R K (x ^ 2 - β * y ^ 2))
        have hdR_eq : dR = (ρ (algebraMap R K x)) ^ 2 -
            ρ (algebraMap R K β) * (ρ (algebraMap R K y)) ^ 2 := by
          simp [dR, map_sub, map_pow, map_mul]
        have hdR_nonneg : 0 ≤ dR := by
          rw [hdR_eq]
          have hx2 : 0 ≤ (ρ (algebraMap R K x)) ^ 2 := sq_nonneg _
          have hy2 : 0 ≤ (ρ (algebraMap R K y)) ^ 2 := sq_nonneg _
          nlinarith
        have hd_K : algebraMap R K (x ^ 2 - β * y ^ 2) ≠ 0 :=
          (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hδ
        have hdR_ne : dR ≠ 0 :=
          (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hd_K
        have hdR_pos : 0 < dR := lt_of_le_of_ne hdR_nonneg hdR_ne.symm
        have ha'_re : (w.embedding (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))).re =
            ρ (algebraMap R K α) * dR := by
          rw [h_re]
          simp [dR, map_mul]
        have ha_re : (w.embedding (algebraMap R K α)).re = ρ (algebraMap R K α) :=
          h_re (algebraMap R K α)
        have h_sign_iff :
            (w.embedding (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))).re < 0 ↔
            (w.embedding (algebraMap R K α)).re < 0 := by
          rw [ha'_re, ha_re]
          constructor <;> intro h <;> nlinarith
        have h_cond_iff :
            (w.IsReal ∧
              (w.embedding (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))).re < 0 ∧
              (w.embedding (algebraMap R K β)).re < 0) ↔
            (w.IsReal ∧
              (w.embedding (algebraMap R K α)).re < 0 ∧
              (w.embedding (algebraMap R K β)).re < 0) := by
          rw [h_sign_iff]
        by_cases hc : w.IsReal ∧
            (w.embedding (algebraMap R K α)).re < 0 ∧
            (w.embedding (algebraMap R K β)).re < 0
        · rw [if_pos (h_cond_iff.mpr hc), if_pos hc]
        · rw [if_neg (mt h_cond_iff.mp hc), if_neg hc]
      · have h1 : ¬ (w.IsReal ∧
            (w.embedding (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))).re < 0 ∧
            (w.embedding (algebraMap R K β)).re < 0) := fun h => hb_neg h.2.2
        have h2 : ¬ (w.IsReal ∧
            (w.embedding (algebraMap R K α)).re < 0 ∧
            (w.embedding (algebraMap R K β)).re < 0) := fun h => hb_neg h.2.2
        rw [if_neg h1, if_neg h2]
    · have h1 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K (α * (x ^ 2 - β * y ^ 2)))).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      have h2 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α)).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      rw [if_neg h1, if_neg h2]
  exact ⟨h_dyad, h_odd, h_real⟩

theorem exists_norm_mul_disjoint_odd_valNat {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    ∃ x y : NumberField.RingOfIntegers K,
      x ^ 2 - β * y ^ 2 ≠ 0 ∧
      ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          ¬ (valNat v (α * (x ^ 2 - β * y ^ 2)) % 2 = 1 ∧ valNat v β % 2 = 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have hI : (Ideal.span {β} : Ideal R) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hβ
  have hfin_β : {v : IsDedekindDomain.HeightOneSpectrum R | β ∈ v.asIdeal}.Finite := by
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  let F_β : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_β.toFinset
  let B : Finset (IsDedekindDomain.HeightOneSpectrum R) :=
    F_β.filter (fun v => (2 : R) ∉ v.asIdeal ∧ valNat v α % 2 = 1 ∧ valNat v β % 2 = 1)
  let C : Finset (IsDedekindDomain.HeightOneSpectrum R) := F_β \ B
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-((valNat v γ : ℕ) : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have h_toNat : ((valNat v γ : ℕ) : ℤ) = -WithZero.log (v.intValuation γ) := by
      dsimp [valNat]
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [h_toNat, neg_neg, WithZero.exp_log hv_ne]
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ δ : R), γ ≠ 0 → δ ≠ 0 →
        valNat v (γ * δ) = valNat v γ + valNat v δ := by
    intro v γ δ hγ hδ
    have hval_mul : v.intValuation (γ * δ) =
        WithZero.exp (-((valNat v γ + valNat v δ : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v δ hδ, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * δ))).toNat = valNat v γ + valNat v δ
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_eq_zero_of_not_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ∉ v.asIdeal →
        valNat v γ = 0 := by
    intro v γ hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    dsimp [valNat]
    rw [hv1, WithZero.log_one]
    rfl
  have mem_asIdeal_of_valNat_ne_zero :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), valNat v γ ≠ 0 →
        γ ∈ v.asIdeal := by
    intro v γ hne
    by_contra hnot
    exact hne (valNat_eq_zero_of_not_mem v γ hnot)
  by_cases hB : B.Nonempty
  · let I_B : Ideal R := ∏ v ∈ B, v.asIdeal ^ valNat v β
    let I_C : Ideal R := ∏ w ∈ C, w.asIdeal
    have h_coprime : IsCoprime I_B I_C := by
      refine IsCoprime.prod_left (fun v hvB => IsCoprime.prod_right (fun w hwC => ?_))
      have hvw : v ≠ w := by
        intro h_eq
        exact (Finset.mem_sdiff.mp hwC).2 (h_eq ▸ hvB)
      have h_ideal_ne : v.asIdeal ≠ w.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hvw
      haveI : v.asIdeal.IsMaximal := v.isMaximal
      haveI : w.asIdeal.IsMaximal := w.isMaximal
      exact (Ideal.isCoprime_of_isMaximal h_ideal_ne).pow_left
    obtain ⟨x, hxB, y, hyC, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_coprime
    have hB_val : ∀ v ∈ B,
        v.intValuation (x ^ 2 - β * y ^ 2) = WithZero.exp (-((valNat v β : ℕ) : ℤ)) ∧
        valNat v (x ^ 2 - β * y ^ 2) = valNat v β := by
      intro v hvB
      have hv_filt := (Finset.mem_filter.mp hvB).2
      have he_odd : valNat v β % 2 = 1 := hv_filt.2.2
      have he_pos : 1 ≤ valNat v β := by omega
      have hx_pow : x ∈ v.asIdeal ^ valNat v β :=
        (Ideal.prod_le_inf.trans (Finset.inf_le hvB)) hxB
      have hx_val : v.intValuation x ≤ WithZero.exp (-((valNat v β : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem x (valNat v β)).mpr hx_pow
      have hx_val1 : v.intValuation x ≤ WithZero.exp (-((1 : ℕ) : ℤ)) :=
        hx_val.trans (WithZero.exp_le_exp.mpr (by omega))
      have hx_mem : x ∈ v.asIdeal := by
        simpa [pow_one] using (v.intValuation_le_pow_iff_mem x 1).mp hx_val1
      have hy_not_mem : y ∉ v.asIdeal := by
        intro hy_mem
        have h1_mem : (1 : R) ∈ v.asIdeal := hxy ▸ v.asIdeal.add_mem hx_mem hy_mem
        exact v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_mem)
      have hy_val : v.intValuation y = 1 := v.intValuation_eq_one_iff.mpr hy_not_mem
      have hβy_val : v.intValuation (-(β * y ^ 2)) = WithZero.exp (-((valNat v β : ℕ) : ℤ)) := by
        rw [Valuation.map_neg, map_mul, map_pow, hy_val, one_pow, mul_one,
          intValuation_eq_exp_neg_valNat v β hβ]
      have hx2_val : v.intValuation (x ^ 2) ≤
          WithZero.exp (-((valNat v β : ℕ) : ℤ) + -((valNat v β : ℕ) : ℤ)) := by
        rw [sq, map_mul, WithZero.exp_add]
        exact mul_le_mul' hx_val hx_val
      have hlt_exp :
          WithZero.exp (-((valNat v β : ℕ) : ℤ) + -((valNat v β : ℕ) : ℤ)) <
            WithZero.exp (-((valNat v β : ℕ) : ℤ)) :=
        WithZero.exp_lt_exp.mpr (by omega)
      have hlt : v.intValuation (x ^ 2) < v.intValuation (-(β * y ^ 2)) := by
        rw [hβy_val]
        exact lt_of_le_of_lt hx2_val hlt_exp
      have hδ_val : v.intValuation (x ^ 2 - β * y ^ 2) =
          WithZero.exp (-((valNat v β : ℕ) : ℤ)) := by
        rw [sub_eq_add_neg, Valuation.map_add_of_distinct_val v.intValuation (ne_of_lt hlt),
          max_eq_right (le_of_lt hlt), hβy_val]
      refine ⟨hδ_val, ?_⟩
      change (-WithZero.log (v.intValuation (x ^ 2 - β * y ^ 2))).toNat = valNat v β
      rw [hδ_val, WithZero.log_exp]
      omega
    have hδ_ne : x ^ 2 - β * y ^ 2 ≠ 0 := by
      obtain ⟨v₀, hv₀⟩ := hB
      intro h0
      have hval0 := (hB_val v₀ hv₀).1
      rw [h0, map_zero] at hval0
      exact WithZero.exp_ne_zero hval0.symm
    have hC_val : ∀ w ∈ C, valNat w (x ^ 2 - β * y ^ 2) = 0 := by
      intro w hwC
      have hy_mem : y ∈ w.asIdeal :=
        (Ideal.prod_le_inf.trans (Finset.inf_le hwC)) hyC
      have h_id : (1 : R) = (x ^ 2 - β * y ^ 2) + y * (2 * x + y + β * y) := by
        calc (1 : R) = (x + y) ^ 2 := by rw [hxy, one_pow]
        _ = (x ^ 2 - β * y ^ 2) + y * (2 * x + y + β * y) := by ring
      have hδ_not_mem : x ^ 2 - β * y ^ 2 ∉ w.asIdeal := by
        intro hδ_mem
        have h1_mem : (1 : R) ∈ w.asIdeal := by
          rw [h_id]
          exact w.asIdeal.add_mem hδ_mem (w.asIdeal.mul_mem_right (2 * x + y + β * y) hy_mem)
        exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_mem)
      exact valNat_eq_zero_of_not_mem w (x ^ 2 - β * y ^ 2) hδ_not_mem
    refine ⟨x, y, hδ_ne, ?_⟩
    intro v h2 ⟨h1, h2_odd⟩
    have hβ_ne : valNat v β ≠ 0 := by omega
    have hvF : v ∈ F_β := hfin_β.mem_toFinset.mpr (mem_asIdeal_of_valNat_ne_zero v β hβ_ne)
    rw [valNat_mul v α (x ^ 2 - β * y ^ 2) hα hδ_ne] at h1
    by_cases hvB : v ∈ B
    · have hα_odd : valNat v α % 2 = 1 := (Finset.mem_filter.mp hvB).2.2.1
      have hδ_eq : valNat v (x ^ 2 - β * y ^ 2) = valNat v β := (hB_val v hvB).2
      omega
    · have hvC : v ∈ C := Finset.mem_sdiff.mpr ⟨hvF, hvB⟩
      have hδ_zero : valNat v (x ^ 2 - β * y ^ 2) = 0 := hC_val v hvC
      have hα_odd : valNat v α % 2 = 1 := by omega
      exact hvB (Finset.mem_filter.mpr ⟨hvF, h2, hα_odd, h2_odd⟩)
  · refine ⟨1, 0, ?_, ?_⟩
    · have h1 : (1 : R) ^ 2 - β * 0 ^ 2 = 1 := by ring
      rw [h1]
      exact one_ne_zero
    · intro v h2 ⟨h1, h2_odd⟩
      have h_eq : α * ((1 : R) ^ 2 - β * 0 ^ 2) = α := by ring
      rw [h_eq] at h1
      have hβ_ne : valNat v β ≠ 0 := by omega
      have hvF : v ∈ F_β := hfin_β.mem_toFinset.mpr (mem_asIdeal_of_valNat_ne_zero v β hβ_ne)
      have hvB : v ∈ B := Finset.mem_filter.mpr ⟨hvF, h2, h1, h2_odd⟩
      exact hB ⟨v, hvB⟩

theorem oddTameProd_of_disjoint_odd_valNat {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_disj : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ¬ (valNat v α % 2 = 1 ∧ valNat v β % 2 = 1)) :
    oddTameProd α β = oddQuadProd α β * oddQuadProd β α :=
by
  have h_finite_mem : ∀ (γ : NumberField.RingOfIntegers K), γ ≠ 0 →
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hI : (Ideal.span {γ} : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have h_mem_of_odd : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (γ : NumberField.RingOfIntegers K),
      valNat v γ % 2 = 1 → γ ∈ v.asIdeal := by
    intro v γ hodd
    by_contra hnot
    have hv : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    have he : valNat v γ = 0 := by
      unfold valNat
      rw [hv, WithZero.log_one]
      rfl
    omega
  have h_isSquare_mul_sq : ∀ {F : Type u} [Field F] (x u : F),
      u ≠ 0 → (IsSquare (x * u ^ 2) ↔ IsSquare x) := by
    intro F _ x u hu
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨s / u, ?_⟩
      have hu2 : u ^ 2 ≠ 0 := pow_ne_zero 2 hu
      apply mul_right_cancel₀ hu2
      calc x * u ^ 2
        _ = s * s := hs
        _ = (s / u) * (s / u) * u ^ 2 := by
            field_simp [hu]
    · rintro ⟨r, hr⟩
      exact ⟨r * u, by rw [hr]; ring⟩
  have h_parity : ∀ e₁ e₂ : ℕ, ¬ (e₁ % 2 = 1 ∧ e₂ % 2 = 1) →
      (e₁ % 2 = 1 ∧ e₂ % 2 = 0 ∧ e₁ = 2 * (e₁ / 2) + 1 ∧ e₂ = 2 * (e₂ / 2)) ∨
      (e₁ % 2 = 0 ∧ e₂ % 2 = 1 ∧ e₁ = 2 * (e₁ / 2) ∧ e₂ = 2 * (e₂ / 2) + 1) ∨
      (e₁ % 2 = 0 ∧ e₂ % 2 = 0 ∧ e₁ = 2 * (e₁ / 2) ∧ e₂ = 2 * (e₂ / 2)) := by
    intro e₁ e₂ h
    omega
  have h_zero_ne_one : (0 : ℕ) ≠ 1 := by decide
  letI := Classical.propDecidable
  have h_quadSym_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (γ u : NumberField.RingOfIntegers K),
      u ≠ 0 →
      (if IsSquare (algebraMap K (v.adicCompletion K)
          (algebraMap (NumberField.RingOfIntegers K) K (γ * u ^ 2))) then (1 : ℤˣ) else -1) =
        quadSym v γ := by
    intro v γ u hu
    dsimp [quadSym]
    apply if_congr _ rfl rfl
    have huK : algebraMap (NumberField.RingOfIntegers K) K u ≠ 0 :=
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K).ne hu
    have huF : algebraMap K (v.adicCompletion K)
        (algebraMap (NumberField.RingOfIntegers K) K u) ≠ 0 :=
      (algebraMap K (v.adicCompletion K)).injective.ne huK
    simp only [map_mul, map_pow]
    exact h_isSquare_mul_sq _ _ huF
  have hsplit_v : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal then
          tameSym v α β else 1) =
        (if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1 then
          quadSym v β else 1) *
        (if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v β % 2 = 1 then
          quadSym v α else 1) := by
    intro v
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · simp [h2v]
    · let q₁ := valNat v α / 2
      let q₂ := valNat v β / 2
      let u : NumberField.RingOfIntegers K := α ^ q₂ * β ^ q₁
      have hu : u ≠ 0 := mul_ne_zero (pow_ne_zero q₂ hα) (pow_ne_zero q₁ hβ)
      rcases h_parity (valNat v α) (valNat v β) (h_disj v h2v) with
        ⟨hr1, hr2, he1, he2⟩ | ⟨hr1, hr2, he1, he2⟩ | ⟨hr1, hr2, he1, he2⟩
      · have he12 : valNat v α * valNat v β = 2 * (valNat v α * q₂) := by
          rw [he2]
          ring
        have h_alg :
            (-1 : NumberField.RingOfIntegers K) ^ (valNat v α * valNat v β) *
              α ^ valNat v β * β ^ valNat v α =
            β * u ^ 2 := by
          dsimp [u]
          rw [he12, he2, he1, pow_mul (-1 : NumberField.RingOfIntegers K),
              neg_one_sq, one_pow, one_mul, pow_mul' α, pow_add β, pow_mul' β, pow_one]
          ring
        have hab : α * β ∈ v.asIdeal :=
          v.asIdeal.mul_mem_right β (h_mem_of_odd v α hr1)
        have hnot2 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v β % 2 = 1) := by
          rintro ⟨_, h⟩
          rw [hr2] at h
          exact h_zero_ne_one h
        rw [if_pos ⟨h2v, hab⟩, if_pos ⟨h2v, hr1⟩, if_neg hnot2, mul_one]
        dsimp [tameSym]
        rw [h_alg]
        exact h_quadSym_mul_sq v β u hu
      · have he12 : valNat v α * valNat v β = 2 * (q₁ * valNat v β) := by
          rw [he1]
          ring
        have hnot1 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1) := by
          rintro ⟨_, h⟩
          rw [hr1] at h
          exact h_zero_ne_one h
        have h_alg :
            (-1 : NumberField.RingOfIntegers K) ^ (valNat v α * valNat v β) *
              α ^ valNat v β * β ^ valNat v α =
            α * u ^ 2 := by
          dsimp [u]
          rw [he12, he2, he1, pow_mul (-1 : NumberField.RingOfIntegers K),
              neg_one_sq, one_pow, one_mul, pow_add α, pow_mul' α, pow_one, pow_mul' β]
          ring
        have hab : α * β ∈ v.asIdeal :=
          v.asIdeal.mul_mem_left α (h_mem_of_odd v β hr2)
        rw [if_pos ⟨h2v, hab⟩, if_neg hnot1, if_pos ⟨h2v, hr2⟩, one_mul]
        dsimp [tameSym]
        rw [h_alg]
        exact h_quadSym_mul_sq v α u hu
      · have he12 : valNat v α * valNat v β = 2 * (q₁ * valNat v β) := by
          rw [he1]
          ring
        have hnot1 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1) := by
          rintro ⟨_, h⟩
          rw [hr1] at h
          exact h_zero_ne_one h
        have hnot2 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v β % 2 = 1) := by
          rintro ⟨_, h⟩
          rw [hr2] at h
          exact h_zero_ne_one h
        have h_alg :
            (-1 : NumberField.RingOfIntegers K) ^ (valNat v α * valNat v β) *
              α ^ valNat v β * β ^ valNat v α =
            u ^ 2 := by
          dsimp [u]
          rw [he12, he2, he1, pow_mul (-1 : NumberField.RingOfIntegers K),
              neg_one_sq, one_pow, one_mul, pow_mul' α, pow_mul' β]
          ring
        have htame1 : tameSym v α β = 1 := by
          dsimp [tameSym]
          rw [h_alg]
          simp only [map_pow]
          exact if_pos (IsSquare.sq _)
        rw [if_neg hnot1, if_neg hnot2, mul_one]
        by_cases hab : α * β ∈ v.asIdeal
        · rw [if_pos ⟨h2v, hab⟩, htame1]
        · have hnot_ab : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal) :=
            fun h => hab h.2
          rw [if_neg hnot_ab]
  have hfin1 : (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K) =>
      if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1 then
        quadSym v β else 1)).Finite := by
    refine (h_finite_mem α hα).subset ?_
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    apply hv
    have hnot_odd : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1) :=
      fun h => hnot (h_mem_of_odd v α h.2)
    exact if_neg hnot_odd
  have hfin2 : (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K) =>
      if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v β % 2 = 1 then
        quadSym v α else 1)).Finite := by
    refine (h_finite_mem β hβ).subset ?_
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    apply hv
    have hnot_odd : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v β % 2 = 1) :=
      fun h => hnot (h_mem_of_odd v β h.2)
    exact if_neg hnot_odd
  dsimp [oddTameProd, oddQuadProd]
  rw [finprod_congr hsplit_v, finprod_mul_distrib hfin1 hfin2]

theorem mul_sq_invariance {K : Type u} [Field K] [NumberField K]
    (α β s t : NumberField.RingOfIntegers K)
    (hα : α ≠ 0) (hβ : β ≠ 0) (hs : s ≠ 0) (ht : t ≠ 0) :
    dyadicProd (α * s ^ 2) (β * t ^ 2) = dyadicProd α β ∧
    oddQuadProd (α * s ^ 2) (β * t ^ 2) = oddQuadProd α β ∧
    oddQuadProd (β * t ^ 2) (α * s ^ 2) = oddQuadProd β α ∧
    realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (ξ : R),
        ξ ≠ 0 → v.intValuation ξ = WithZero.exp (-(valNat v ξ : ℤ)) := by
    intro v ξ hξ
    have hv_ne : v.intValuation ξ ≠ 0 :=
      v.intValuation_ne_zero' ⟨ξ, mem_nonZeroDivisors_of_ne_zero hξ⟩
    have hv_le : v.intValuation ξ ≤ 1 := v.intValuation_le_one ξ
    have hlog_le : WithZero.log (v.intValuation ξ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v ξ : ℤ) = -WithZero.log (v.intValuation ξ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have valNat_mul_sq_mod_two :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        γ ≠ 0 → c ≠ 0 → valNat v (γ * c ^ 2) % 2 = valNat v γ % 2 := by
    intro v γ c hγ hc
    have hval_mul : v.intValuation (γ * c ^ 2) =
        WithZero.exp (-((valNat v γ + 2 * valNat v c : ℕ) : ℤ)) := by
      rw [map_mul, map_pow, sq, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v c hc, ← WithZero.exp_add, ← WithZero.exp_add]
      congr 1
      omega
    have hvalNat_eq : valNat v (γ * c ^ 2) = valNat v γ + 2 * valNat v c := by
      change (-WithZero.log (v.intValuation (γ * c ^ 2))).toNat = valNat v γ + 2 * valNat v c
      rw [hval_mul, WithZero.log_exp]
      omega
    rw [hvalNat_eq]
    omega
  letI := Classical.propDecidable
  have h_norm : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      normSym v (α * s ^ 2) (β * t ^ 2) = normSym v α β := by
    classical
    intro v
    let F := v.adicCompletion K
    let a : F := algebraMap K F (algebraMap R K α)
    let b : F := algebraMap K F (algebraMap R K β)
    let sF : F := algebraMap K F (algebraMap R K s)
    let tF : F := algebraMap K F (algebraMap R K t)
    have ha_map : algebraMap K F (algebraMap R K (α * s ^ 2)) = a * sF ^ 2 := by
      simp [a, sF, map_mul, map_pow]
    have hb_map : algebraMap K F (algebraMap R K (β * t ^ 2)) = b * tF ^ 2 := by
      simp [b, tF, map_mul, map_pow]
    have hs_K : algebraMap R K s ≠ 0 :=
      (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hs
    have ht_K : algebraMap R K t ≠ 0 :=
      (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr ht
    have hsF : sF ≠ 0 :=
      (map_ne_zero_iff (algebraMap K F) (RingHom.injective _)).mpr hs_K
    have htF : tF ≠ 0 :=
      (map_ne_zero_iff (algebraMap K F) (RingHom.injective _)).mpr ht_K
    have hs_inv : sF * sF⁻¹ = 1 := mul_inv_cancel₀ hsF
    have ht_inv : tF * tF⁻¹ = 1 := mul_inv_cancel₀ htF
    have h_iff : (∃ X' Y' : F, X' ^ 2 - (b * tF ^ 2) * Y' ^ 2 = a * sF ^ 2) ↔
        (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) := by
      constructor
      · rintro ⟨X', Y', hXY'⟩
        refine ⟨X' * sF⁻¹, Y' * tF * sF⁻¹, ?_⟩
        linear_combination (sF⁻¹) ^ 2 * hXY' + a * (sF * sF⁻¹ + 1) * hs_inv
      · rintro ⟨X, Y, hXY⟩
        refine ⟨X * sF, Y * sF * tF⁻¹, ?_⟩
        linear_combination sF ^ 2 * hXY - b * Y ^ 2 * sF ^ 2 * (tF * tF⁻¹ + 1) * ht_inv
    dsimp only [normSym]
    change (if ∃ X' Y' : F,
        X' ^ 2 - algebraMap K F (algebraMap R K (β * t ^ 2)) * Y' ^ 2 =
          algebraMap K F (algebraMap R K (α * s ^ 2))
      then (1 : ℤˣ) else -1) =
      (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1)
    rw [ha_map, hb_map, h_iff]
  have h_dyad : dyadicProd (α * s ^ 2) (β * t ^ 2) = dyadicProd α β := by
    dsimp only [dyadicProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, h_norm v]
    · rw [if_neg h2v, if_neg h2v]
  have quadSym_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        c ≠ 0 → quadSym v (γ * c ^ 2) = quadSym v γ := by
    intro v γ c hc
    let F := v.adicCompletion K
    let x : F := algebraMap K F (algebraMap R K γ)
    let u : F := algebraMap K F (algebraMap R K c)
    have hc_K : algebraMap R K c ≠ 0 :=
      (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hc
    have hu : u ≠ 0 :=
      (map_ne_zero_iff (algebraMap K F) (RingHom.injective _)).mpr hc_K
    have h_iff : IsSquare (x * u ^ 2) ↔ IsSquare x := by
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨w / u, ?_⟩
        rw [div_mul_div_comm, ← hw, sq, mul_div_cancel_right₀ _ (mul_ne_zero hu hu)]
      · rintro ⟨r, hr⟩
        refine ⟨r * u, ?_⟩
        rw [hr]
        ring
    dsimp only [quadSym]
    change (if IsSquare (algebraMap K F (algebraMap R K (γ * c ^ 2))) then (1 : ℤˣ) else -1) =
      (if IsSquare x then (1 : ℤˣ) else -1)
    have h_map : algebraMap K F (algebraMap R K (γ * c ^ 2)) = x * u ^ 2 := by
      simp [x, u, map_mul, map_pow]
    rw [h_map, h_iff]
  have oddQuadProd_mul_sq :
      ∀ (γ₁ γ₂ c₁ c₂ : R), γ₁ ≠ 0 → c₁ ≠ 0 → c₂ ≠ 0 →
        oddQuadProd (γ₁ * c₁ ^ 2) (γ₂ * c₂ ^ 2) = oddQuadProd γ₁ γ₂ := by
    intro γ₁ γ₂ c₁ c₂ hγ₁ hc₁ hc₂
    dsimp only [oddQuadProd]
    refine finprod_congr (fun v => ?_)
    rw [valNat_mul_sq_mod_two v γ₁ c₁ hγ₁ hc₁, quadSym_mul_sq v γ₂ c₂ hc₂]
  have h_real : realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β := by
    dsimp only [realSignProd]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ c : K, (w.embedding c).re = ρ c := by
        intro c
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw c, Complex.ofReal_re]
      have h_sign_mul_sq : ∀ (γ c : R), c ≠ 0 →
          ((w.embedding (algebraMap R K (γ * c ^ 2))).re < 0 ↔
            (w.embedding (algebraMap R K γ)).re < 0) := by
        intro γ c hc
        rw [h_re, h_re]
        simp only [map_mul, map_pow]
        have hc_K : algebraMap R K c ≠ 0 :=
          (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hc
        have hc_R : ρ (algebraMap R K c) ≠ 0 :=
          (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hc_K
        have hc_sq : 0 < (ρ (algebraMap R K c)) ^ 2 := sq_pos_of_ne_zero hc_R
        constructor <;> intro h <;> nlinarith
      rw [h_sign_mul_sq α s hs, h_sign_mul_sq β t ht]
    · have h1 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K (α * s ^ 2))).re < 0 ∧
          (w.embedding (algebraMap R K (β * t ^ 2))).re < 0) := fun h => hw h.1
      have h2 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α)).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      rw [if_neg h1, if_neg h2]
  exact ⟨h_dyad, oddQuadProd_mul_sq α β s t hα hs ht,
    oddQuadProd_mul_sq β α t s hβ ht hs, h_real⟩

theorem exists_mul_sq_coprime_odd_valNat {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_disj : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ¬ (valNat v α % 2 = 1 ∧ valNat v β % 2 = 1)) :
    ∃ α' β' s₁ t₁ s₂ t₂ : NumberField.RingOfIntegers K,
      α' ≠ 0 ∧ β' ≠ 0 ∧ s₁ ≠ 0 ∧ t₁ ≠ 0 ∧ s₂ ≠ 0 ∧ t₂ ≠ 0 ∧
      α * s₁ ^ 2 = α' * t₁ ^ 2 ∧
      β * s₂ ^ 2 = β' * t₂ ^ 2 ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          (valNat v α' % 2 = 1 → β' ∉ v.asIdeal) ∧
          (valNat v β' % 2 = 1 → α' ∉ v.asIdeal)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have finite_mem_asIdeal :
      ∀ (γ : R), γ ≠ 0 →
        {v : IsDedekindDomain.HeightOneSpectrum R | γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hI : (Ideal.span {γ} : Ideal R) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-((valNat v γ : ℕ) : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have h_toNat : ((valNat v γ : ℕ) : ℤ) = -WithZero.log (v.intValuation γ) := by
      dsimp [valNat]
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [h_toNat, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ δ : R), γ ≠ 0 → δ ≠ 0 →
        valNat v (γ * δ) = valNat v γ + valNat v δ := by
    intro v γ δ hγ hδ
    have hval_mul : v.intValuation (γ * δ) =
        WithZero.exp (-((valNat v γ + valNat v δ : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v δ hδ, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * δ))).toNat = valNat v γ + valNat v δ
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_mod_two_eq_of_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ γ' s t : R),
        γ ≠ 0 → γ' ≠ 0 → s ≠ 0 → t ≠ 0 → γ * s ^ 2 = γ' * t ^ 2 →
          valNat v γ' % 2 = valNat v γ % 2 := by
    intro v γ γ' s t hγ hγ' hs ht h_eq
    have hs2 : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    have h1 : valNat v (γ * s ^ 2) = valNat v γ + (valNat v s + valNat v s) := by
      rw [valNat_mul v γ (s ^ 2) hγ hs2, sq s, valNat_mul v s s hs hs]
    have h2 : valNat v (γ' * t ^ 2) = valNat v γ' + (valNat v t + valNat v t) := by
      rw [valNat_mul v γ' (t ^ 2) hγ' ht2, sq t, valNat_mul v t t ht ht]
    have h3 : valNat v (γ * s ^ 2) = valNat v (γ' * t ^ 2) := congr_arg (valNat v) h_eq
    omega
  have mem_asIdeal_of_valNat_mod_two_eq_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        valNat v γ % 2 = 1 → γ ∈ v.asIdeal := by
    intro v γ hodd
    by_contra hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    have h0 : valNat v γ = 0 := by
      dsimp [valNat]
      rw [hv1, WithZero.log_one]
      rfl
    omega
  have exists_step_clear :
      ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum R))
        (w : IsDedekindDomain.HeightOneSpectrum R), w ∉ S →
        ∀ (γ₁ : R), γ₁ ≠ 0 → valNat w γ₁ % 2 = 0 →
          (∀ v ∈ S, γ₁ ∉ v.asIdeal) →
          ∃ γ' s₀ t₀ : R,
            γ' ≠ 0 ∧ s₀ ≠ 0 ∧ t₀ ≠ 0 ∧
            γ₁ * s₀ ^ 2 = γ' * t₀ ^ 2 ∧
            γ' ∉ w.asIdeal ∧
            (∀ v ∈ S, γ' ∉ v.asIdeal) := by
    intro S w hwS γ₁ hγ₁ he hS
    let k : ℕ := valNat w γ₁ / 2
    have hk2 : valNat w γ₁ = 2 * k := by omega
    have hγ₁_val : w.intValuation γ₁ = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [intValuation_eq_exp_neg_valNat w γ₁ hγ₁, hk2]
    have hγ₁_mem : γ₁ ∈ w.asIdeal ^ (2 * k) :=
      (w.intValuation_le_pow_iff_mem γ₁ (2 * k)).mp (le_of_eq hγ₁_val)
    have h_cop : IsCoprime (w.asIdeal ^ 2) (∏ v ∈ S, v.asIdeal) := by
      refine IsCoprime.prod_right (fun v hvS => ?_)
      have hne : w ≠ v := fun h => hwS (h ▸ hvS)
      have h_id_ne : w.asIdeal ≠ v.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hne
      haveI := w.isMaximal
      haveI := v.isMaximal
      exact (Ideal.isCoprime_of_isMaximal h_id_ne).pow_left
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_cop
    have hx_val : w.intValuation x ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
      (w.intValuation_le_pow_iff_mem x 2).mpr hx
    have hx_w : x ∈ w.asIdeal :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hx
    have hy_w : y ∉ w.asIdeal := by
      intro hy_m
      have h1_m : (1 : R) ∈ w.asIdeal := hxy ▸ w.asIdeal.add_mem hx_w hy_m
      exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_m)
    have hy_val : w.intValuation y = 1 := w.intValuation_eq_one_iff.mpr hy_w
    have hy_S : ∀ v ∈ S, y ∈ v.asIdeal :=
      fun v hvS => (Ideal.prod_le_inf.trans (Finset.inf_le hvS)) hy
    have hx_S : ∀ v ∈ S, x ∉ v.asIdeal := by
      intro v hvS hx_m
      have h1_m : (1 : R) ∈ v.asIdeal := hxy ▸ v.asIdeal.add_mem hx_m (hy_S v hvS)
      exact v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1_m)
    obtain ⟨π, hπ⟩ := w.intValuation_exists_uniformizer
    let π' : R := π * y + x
    have hπy_val : w.intValuation (π * y) = WithZero.exp (-1 : ℤ) := by
      rw [map_mul, hπ, hy_val, mul_one]
    have hlt_exp : WithZero.exp (-((2 : ℕ) : ℤ)) < WithZero.exp (-1 : ℤ) :=
      WithZero.exp_lt_exp.mpr (by omega)
    have hlt_val : w.intValuation x < w.intValuation (π * y) := by
      rw [hπy_val]
      exact lt_of_le_of_lt hx_val hlt_exp
    have hπ'_val : w.intValuation π' = WithZero.exp (-1 : ℤ) := by
      change w.intValuation (π * y + x) = WithZero.exp (-1 : ℤ)
      rw [add_comm, Valuation.map_add_of_distinct_val w.intValuation (ne_of_lt hlt_val),
        max_eq_right (le_of_lt hlt_val), hπy_val]
    have hπ'_w : π' ∈ w.asIdeal := by
      have hle1 : w.intValuation π' ≤ WithZero.exp (-((1 : ℕ) : ℤ)) := by
        rw [hπ'_val]
        exact le_rfl
      simpa [pow_one] using (w.intValuation_le_pow_iff_mem π' 1).mp hle1
    have hπ'_S : ∀ v ∈ S, π' ∉ v.asIdeal := by
      intro v hvS hπ'_m
      have hπy_m : π * y ∈ v.asIdeal := v.asIdeal.mul_mem_left π (hy_S v hvS)
      have hx_m : x ∈ v.asIdeal := by
        have hsub := v.asIdeal.sub_mem hπ'_m hπy_m
        have hid : π' - π * y = x := by dsimp [π']; ring
        rwa [hid] at hsub
      exact hx_S v hvS hx_m
    have hπ'_dvd : w.asIdeal ^ 1 ∣ Ideal.span {π'} := by
      apply (w.intValuation_le_pow_iff_dvd π' 1).mp
      rw [hπ'_val]
      exact le_rfl
    rw [pow_one] at hπ'_dvd
    obtain ⟨J, hJ⟩ := hπ'_dvd
    have hJ_not_le : ¬ (J ≤ w.asIdeal) := by
      intro hle
      have hπ'_mem2 : π' ∈ w.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ'_le2 : w.intValuation π' ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (w.intValuation_le_pow_iff_mem π' 2).mpr hπ'_mem2
      rw [hπ'_val, WithZero.exp_le_exp] at hπ'_le2
      omega
    obtain ⟨a, haJ, haw⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hπ'J : π' ∈ J := by
      rw [← Ideal.span_singleton_le_iff_mem, hJ]
      exact Ideal.mul_le_left
    let s₀ : R := a * y + π' * x
    have hs₀J : s₀ ∈ J :=
      J.add_mem (J.mul_mem_right y haJ) (J.mul_mem_right x hπ'J)
    have hs₀w : s₀ ∉ w.asIdeal := by
      intro hs₀_m
      have hπ'x_w : π' * x ∈ w.asIdeal := w.asIdeal.mul_mem_right x hπ'_w
      have hay_w : a * y ∈ w.asIdeal := by
        have hsub := w.asIdeal.sub_mem hs₀_m hπ'x_w
        have hid : s₀ - π' * x = a * y := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases w.isPrime.mem_or_mem hay_w with ha_m | hy_m
      · exact haw ha_m
      · exact hy_w hy_m
    have hs₀_S : ∀ v ∈ S, s₀ ∉ v.asIdeal := by
      intro v hvS hs₀_m
      have hay_v : a * y ∈ v.asIdeal := v.asIdeal.mul_mem_left a (hy_S v hvS)
      have hπ'x_v : π' * x ∈ v.asIdeal := by
        have hsub := v.asIdeal.sub_mem hs₀_m hay_v
        have hid : s₀ - a * y = π' * x := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases v.isPrime.mem_or_mem hπ'x_v with hπ'_m | hx_m
      · exact hπ'_S v hvS hπ'_m
      · exact hx_S v hvS hx_m
    have hspan_γ₁ : Ideal.span {γ₁} ≤ w.asIdeal ^ (2 * k) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hγ₁_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_mul : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π' ^ k) ^ 2} := by
      have h1 : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} = Ideal.span {γ₁} * (Ideal.span {s₀}) ^ (2 * k) := by
        rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
          ← Ideal.span_singleton_pow]
      have h2 : Ideal.span {(π' ^ k) ^ 2} = w.asIdeal ^ (2 * k) * J ^ (2 * k) := by
        rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
      rw [h1, h2]
      exact Ideal.mul_mono hspan_γ₁ (Ideal.pow_right_mono hspan_s₀ (2 * k))
    obtain ⟨γ', hγ'_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
    have hs₀_val : w.intValuation s₀ = 1 := w.intValuation_eq_one_iff.mpr hs₀w
    have hπ'_pow_val : w.intValuation ((π' ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ'_val, exp_neg_one_pow (2 * k)]
    have hval_eq : WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1 =
        WithZero.exp (-((2 * k : ℕ) : ℤ)) * w.intValuation γ' := by
      calc
        WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1
          = w.intValuation γ₁ * (w.intValuation s₀ ^ k) ^ 2 := by
            rw [hγ₁_val, hs₀_val, one_pow, one_pow]
        _ = w.intValuation (γ₁ * (s₀ ^ k) ^ 2) := by simp [map_mul, map_pow]
        _ = w.intValuation ((π' ^ k) ^ 2 * γ') := by rw [hγ'_eq]
        _ = WithZero.exp (-((2 * k : ℕ) : ℤ)) * w.intValuation γ' := by
          rw [map_mul, hπ'_pow_val]
    have hγ'_val : w.intValuation γ' = 1 :=
      (mul_left_cancel₀ WithZero.exp_ne_zero hval_eq).symm
    have hγ'_not_w : γ' ∉ w.asIdeal := w.intValuation_eq_one_iff.mp hγ'_val
    have hγ'_not_S : ∀ v ∈ S, γ' ∉ v.asIdeal := by
      intro v hvS hγ'_m
      have h_lhs_m : γ₁ * (s₀ ^ k) ^ 2 ∈ v.asIdeal := by
        rw [hγ'_eq]
        exact v.asIdeal.mul_mem_left ((π' ^ k) ^ 2) hγ'_m
      rcases v.isPrime.mem_or_mem h_lhs_m with hγ₁_m | hs₀_pow_m
      · exact hS v hvS hγ₁_m
      · exact hs₀_S v hvS (v.isPrime.mem_of_pow_mem k (v.isPrime.mem_of_pow_mem 2 hs₀_pow_m))
    have hγ'_ne : γ' ≠ 0 := fun h0 => hγ'_not_w (h0 ▸ w.asIdeal.zero_mem)
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀w (h0 ▸ w.asIdeal.zero_mem)
    have hπ'_ne : π' ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hπ'_val
      exact WithZero.exp_ne_zero hπ'_val.symm
    refine ⟨γ', s₀ ^ k, π' ^ k, hγ'_ne, pow_ne_zero k hs₀_ne, pow_ne_zero k hπ'_ne,
      hγ'_eq.trans (mul_comm _ _), hγ'_not_w, hγ'_not_S⟩
  have exists_clear_finset :
      ∀ (S : Finset (IsDedekindDomain.HeightOneSpectrum R)) (γ : R), γ ≠ 0 →
        (∀ v ∈ S, valNat v γ % 2 = 0) →
        ∃ γ' s t : R,
          γ' ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
          γ * s ^ 2 = γ' * t ^ 2 ∧
          (∀ v ∈ S, γ' ∉ v.asIdeal) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro γ hγ _
      exact ⟨γ, 1, 1, hγ, one_ne_zero, one_ne_zero, rfl,
        fun v hv => False.elim (Finset.notMem_empty v hv)⟩
    | insert w S hwS ih =>
      intro γ hγ h_even
      have h_even_w : valNat w γ % 2 = 0 := h_even w (Finset.mem_insert_self w S)
      have h_even_S : ∀ v ∈ S, valNat v γ % 2 = 0 :=
        fun v hv => h_even v (Finset.mem_insert_of_mem hv)
      obtain ⟨γ₁, s₁, t₁, hγ₁, hs₁, ht₁, h_eq₁, hS₁⟩ := ih γ hγ h_even_S
      have h_even_w₁ : valNat w γ₁ % 2 = 0 := by
        rw [valNat_mod_two_eq_of_mul_sq w γ γ₁ s₁ t₁ hγ hγ₁ hs₁ ht₁ h_eq₁]
        exact h_even_w
      obtain ⟨γ', s₀, t₀, hγ', hs₀, ht₀, h_eq₀, hw', hS'⟩ :=
        exists_step_clear S w hwS γ₁ hγ₁ h_even_w₁ hS₁
      refine ⟨γ', s₁ * s₀, t₁ * t₀, hγ', mul_ne_zero hs₁ hs₀, mul_ne_zero ht₁ ht₀, ?_, ?_⟩
      · linear_combination s₀ ^ 2 * h_eq₁ + t₁ ^ 2 * h_eq₀
      · intro v hv
        rcases Finset.mem_insert.mp hv with rfl | hvS
        · exact hw'
        · exact hS' v hvS
  have hfin_β := finite_mem_asIdeal β hβ
  let F_β : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_β.toFinset
  let S_β : Finset (IsDedekindDomain.HeightOneSpectrum R) :=
    F_β.filter (fun v => (2 : R) ∉ v.asIdeal ∧ valNat v β % 2 = 1)
  have hα_even_on_Sβ : ∀ v ∈ S_β, valNat v α % 2 = 0 := by
    intro v hv
    have hf := (Finset.mem_filter.mp hv).2
    have hd := h_disj v hf.1
    omega
  obtain ⟨α', s₁, t₁, hα', hs₁, ht₁, h_eqα, hα'_clear⟩ :=
    exists_clear_finset S_β α hα hα_even_on_Sβ
  have hfin_α' := finite_mem_asIdeal α' hα'
  let F_α' : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_α'.toFinset
  let S_α' : Finset (IsDedekindDomain.HeightOneSpectrum R) :=
    F_α'.filter (fun v => (2 : R) ∉ v.asIdeal ∧ valNat v α' % 2 = 1)
  have hβ_even_on_Sα' : ∀ v ∈ S_α', valNat v β % 2 = 0 := by
    intro v hv
    have hf := (Finset.mem_filter.mp hv).2
    have h_par := valNat_mod_two_eq_of_mul_sq v α α' s₁ t₁ hα hα' hs₁ ht₁ h_eqα
    have hd := h_disj v hf.1
    omega
  obtain ⟨β', s₂, t₂, hβ', hs₂, ht₂, h_eqβ, hβ'_clear⟩ :=
    exists_clear_finset S_α' β hβ hβ_even_on_Sα'
  refine ⟨α', β', s₁, t₁, s₂, t₂, hα', hβ', hs₁, ht₁, hs₂, ht₂, h_eqα, h_eqβ, ?_⟩
  intro v h2
  refine ⟨?_, ?_⟩
  · intro hα'_odd
    have hα'_mem : α' ∈ v.asIdeal := mem_asIdeal_of_valNat_mod_two_eq_one v α' hα'_odd
    have hvF : v ∈ F_α' := hfin_α'.mem_toFinset.mpr hα'_mem
    have hvS : v ∈ S_α' := Finset.mem_filter.mpr ⟨hvF, h2, hα'_odd⟩
    exact hβ'_clear v hvS
  · intro hβ'_odd
    have h_par := valNat_mod_two_eq_of_mul_sq v β β' s₂ t₂ hβ hβ' hs₂ ht₂ h_eqβ
    have hβ_odd : valNat v β % 2 = 1 := by omega
    have hβ_mem : β ∈ v.asIdeal := mem_asIdeal_of_valNat_mod_two_eq_one v β hβ_odd
    have hvF : v ∈ F_β := hfin_β.mem_toFinset.mpr hβ_mem
    have hvS : v ∈ S_β := Finset.mem_filter.mpr ⟨hvF, h2, hβ_odd⟩
    exact hα'_clear v hvS

theorem oddQuadProd_eq_oddResQuadProd_of_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K)
    (h_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        valNat v α % 2 = 1 → β ∉ v.asIdeal) :
    oddQuadProd α β = oddResQuadProd α β :=
by
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (γ : NumberField.RingOfIntegers K), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-(valNat v γ : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v γ : ℤ) = -WithZero.log (v.intValuation γ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have isSquare_of_val_sub_one_lt_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ∀ (u : v.adicCompletion K), Valued.v (u - 1) < 1 → IsSquare u := by
    intro v h2 u hu
    by_cases hu0 : u - 1 = 0
    · rw [sub_eq_zero.mp hu0]
      exact IsSquare.one
    have hu_ne : Valued.v (u - 1) ≠ 0 := (Valuation.zero_iff Valued.v).not.mpr hu0
    have hu_le : Valued.v (u - 1) ≤ WithZero.exp (-1 : ℤ) := by
      rw [← WithZero.exp_log hu_ne] at hu ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hu
      rw [WithZero.exp_le_exp]
      omega
    let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
      (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
    have h2_val : Valued.v (2 : v.adicCompletion K) = 1 := by
      have h2_eq : (2 : v.adicCompletion K) = ι (2 : NumberField.RingOfIntegers K) :=
        (map_ofNat ι 2).symm
      rw [h2_eq]
      exact ((IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
        (algebraMap (NumberField.RingOfIntegers K) K 2)).trans
        (v.valuation_of_algebraMap 2)).trans (v.intValuation_eq_one_iff.mpr h2)
    have h2_ne : (2 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at h2_val
      exact zero_ne_one h2_val
    have h2inv_val : Valued.v ((2 : v.adicCompletion K)⁻¹) = 1 := by
      rw [map_inv₀, h2_val, inv_one]
    have h2_mul_inv : (2 : v.adicCompletion K) * 2⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    let z : ℕ → v.adicCompletion K := fun n =>
      Nat.recOn n 1 (fun _ zn => zn - 2⁻¹ * (zn ^ 2 - u))
    have h_ind : ∀ n : ℕ,
        Valued.v (z n - 1) ≤ WithZero.exp (-1 : ℤ) ∧
        Valued.v (z n ^ 2 - u) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ)) := by
      intro n
      induction n with
      | zero =>
        refine ⟨?_, ?_⟩
        · change Valued.v ((1 : v.adicCompletion K) - 1) ≤ WithZero.exp (-1 : ℤ)
          rw [sub_self, Valuation.map_zero]
          exact zero_le'
        · change Valued.v ((1 : v.adicCompletion K) ^ 2 - u) ≤ WithZero.exp (-((0 + 1 : ℕ) : ℤ))
          have hid : (1 : v.adicCompletion K) ^ 2 - u = -(u - 1) := by ring
          rw [hid, Valuation.map_neg]
          exact hu_le
      | succ n ih =>
        have h_step : z (n + 1) = z n - 2⁻¹ * (z n ^ 2 - u) := rfl
        have h_le1 : WithZero.exp (-((n + 1 : ℕ) : ℤ)) ≤ WithZero.exp (-1 : ℤ) := by
          rw [WithZero.exp_le_exp]
          omega
        have h_term : Valued.v (2⁻¹ * (z n ^ 2 - u)) ≤ WithZero.exp (-1 : ℤ) := by
          rw [map_mul, h2inv_val, one_mul]
          exact ih.2.trans h_le1
        refine ⟨?_, ?_⟩
        · have h_diff : z (n + 1) - 1 = (z n - 1) - 2⁻¹ * (z n ^ 2 - u) := by
            rw [h_step]; ring
          rw [h_diff]
          exact (Valuation.map_sub Valued.v _ _).trans (max_le ih.1 h_term)
        · have h_id : z (n + 1) ^ 2 - u =
              (z n ^ 2 - u) * (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) := by
            rw [h_step]
            linear_combination - z n * (z n ^ 2 - u) * h2_mul_inv
          have h_fac2 : Valued.v (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) ≤
              WithZero.exp (-1 : ℤ) := by
            refine (Valuation.map_add Valued.v _ _).trans (max_le ?_ ?_)
            · rw [Valuation.map_neg]; exact ih.1
            · rw [map_mul, map_pow, h2inv_val, one_pow, one_mul]
              exact ih.2.trans h_le1
          have h_exp : WithZero.exp (-((n + 1 : ℕ) : ℤ)) * WithZero.exp (-1 : ℤ) =
              WithZero.exp (-((n + 1 + 1 : ℕ) : ℤ)) := by
            rw [← WithZero.exp_add]
            congr 1
          rw [h_id, map_mul, ← h_exp]
          exact mul_le_mul' ih.2 h_fac2
    have h_tendsto_zero : ∀ g : ℕ → v.adicCompletion K,
        (∀ n : ℕ, Valued.v (g n) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ))) →
        Filter.Tendsto g Filter.atTop (nhds 0) := by
      intro g hg
      rw [(Valued.hasBasis_nhds_zero (v.adicCompletion K)
        (WithZero (Multiplicative ℤ))).tendsto_right_iff]
      intro γ _
      rw [Filter.eventually_atTop]
      let m : ℤ := WithZero.log (γ : WithZero (Multiplicative ℤ))
      refine ⟨(-m).toNat, fun n hn => ?_⟩
      have h_lt : WithZero.exp (-((n + 1 : ℕ) : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← WithZero.exp_log γ.ne_zero, WithZero.exp_lt_exp]
        change -((n + 1 : ℕ) : ℤ) < m
        omega
      exact lt_of_le_of_lt (hg n) h_lt
    have hz_sub : Filter.Tendsto (fun n => z (n + 1) - z n) Filter.atTop (nhds 0) := by
      apply h_tendsto_zero
      intro n
      have h_step_sub : z (n + 1) - z n = -(2⁻¹ * (z n ^ 2 - u)) := by
        change (z n - 2⁻¹ * (z n ^ 2 - u)) - z n = -(2⁻¹ * (z n ^ 2 - u))
        ring
      rw [h_step_sub, Valuation.map_neg, map_mul, h2inv_val, one_mul]
      exact (h_ind n).2
    have hz_cauchy : CauchySeq z :=
      NonarchimedeanAddGroup.cauchySeq_of_tendsto_sub_nhds_zero hz_sub
    obtain ⟨w, hw⟩ := cauchySeq_tendsto_of_complete hz_cauchy
    have h_sq_zero : Filter.Tendsto (fun n => z n ^ 2 - u) Filter.atTop (nhds 0) :=
      h_tendsto_zero (fun n => z n ^ 2 - u) (fun n => (h_ind n).2)
    have h_sq_w : Filter.Tendsto (fun n => z n ^ 2 - u) Filter.atTop (nhds (w ^ 2 - u)) :=
      (hw.pow 2).sub_const u
    have hw_eq : w ^ 2 - u = 0 := tendsto_nhds_unique h_sq_w h_sq_zero
    exact ⟨w, by linear_combination -hw_eq⟩
  have isSquare_of_isSquare_quotient :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ∀ (β : NumberField.RingOfIntegers K), β ∉ v.asIdeal →
          IsSquare (Ideal.Quotient.mk v.asIdeal β) →
          IsSquare (algebraMap K (v.adicCompletion K)
            (algebraMap (NumberField.RingOfIntegers K) K β)) := by
    intro v h2 β hβ ⟨x_bar, hx_bar⟩
    obtain ⟨x₀, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
    let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
      (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
    let d : NumberField.RingOfIntegers K := x₀ ^ 2
    let r : NumberField.RingOfIntegers K := β - x₀ ^ 2
    have hr_mem : r ∈ v.asIdeal := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      dsimp [r]
      rw [map_sub, map_pow, sq, ← hx_bar, sub_self]
    have hd_not_mem : d ∉ v.asIdeal := by
      intro hd
      apply hβ
      have h_eq : β = r + d := by dsimp [r, d]; ring
      rw [h_eq]
      exact v.asIdeal.add_mem hr_mem hd
    have hd_val : Valued.v (ι d) = 1 :=
      ((IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
        (algebraMap (NumberField.RingOfIntegers K) K d)).trans
        (v.valuation_of_algebraMap d)).trans (v.intValuation_eq_one_iff.mpr hd_not_mem)
    have hd_ne : ι d ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at hd_val
      exact zero_ne_one hd_val
    have hd_inv : ι d * (ι d)⁻¹ = 1 := mul_inv_cancel₀ hd_ne
    have hr_lt : Valued.v (ι r) < 1 := by
      have hr_val_eq : Valued.v (ι r) = v.intValuation r :=
        (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
          (algebraMap (NumberField.RingOfIntegers K) K r)).trans
          (v.valuation_of_algebraMap r)
      rw [hr_val_eq]
      exact (v.intValuation_lt_one_iff_mem r).mpr hr_mem
    let u : v.adicCompletion K := 1 + ι r * (ι d)⁻¹
    have hu_lt : Valued.v (u - 1) < 1 := by
      have hu_sub : u - 1 = ι r * (ι d)⁻¹ := by dsimp [u]; ring
      rw [hu_sub, map_mul, map_inv₀, hd_val, inv_one, mul_one]
      exact hr_lt
    obtain ⟨w, hw⟩ := isSquare_of_val_sub_one_lt_one v h2 u hu_lt
    refine ⟨ι x₀ * w, ?_⟩
    have hd_map : ι d = (ι x₀) ^ 2 := by dsimp [d]; simp [map_pow]
    have hr_map : ι r = ι β - (ι x₀) ^ 2 := by dsimp [r]; simp [map_sub, map_pow]
    change ι β = (ι x₀ * w) * (ι x₀ * w)
    calc
      ι β = ι d + ι r * (ι d * (ι d)⁻¹) := by
        rw [hd_inv, mul_one, hd_map, hr_map]; ring
      _ = ι d * u := by dsimp [u]; ring
      _ = (ι x₀) ^ 2 * (w * w) := by rw [hd_map, ← hw]
      _ = (ι x₀ * w) * (ι x₀ * w) := by ring
  have exists_approx_lt_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (w : v.adicCompletion K),
        ∃ c : K, Valued.v (algebraMap K (v.adicCompletion K) c - w) < 1 := by
    intro v w
    have h_nhds : {y : v.adicCompletion K | Valued.v (y - w) < 1} ∈ nhds w := by
      rw [Valued.mem_nhds]
      exact ⟨1, Set.Subset.rfl⟩
    obtain ⟨c₀, hc₀⟩ :=
      (@UniformSpace.Completion.denseRange_coe (WithVal (v.valuation K)) _).mem_nhds h_nhds
    exact ⟨(WithVal.equiv (v.valuation K)) c₀, hc₀⟩
  have exists_coprime_denom_of_intValuation_le :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (a b : NumberField.RingOfIntegers K),
        b ≠ 0 → v.intValuation a ≤ v.intValuation b →
        ∃ (k : ℕ) (π s₀ a₀ b₀ : NumberField.RingOfIntegers K),
          v.intValuation (π ^ k) = v.intValuation b ∧
          s₀ ∉ v.asIdeal ∧ b₀ ∉ v.asIdeal ∧
          a * s₀ ^ k = π ^ k * a₀ ∧ b * s₀ ^ k = π ^ k * b₀ := by
    intro v a b hb hab
    let k : ℕ := valNat v b
    have hb_val : v.intValuation b = WithZero.exp (-(k : ℤ)) :=
      intValuation_eq_exp_neg_valNat v b hb
    have hb_mem : b ∈ v.asIdeal ^ k :=
      (v.intValuation_le_pow_iff_mem b k).mp (le_of_eq hb_val)
    have ha_mem : a ∈ v.asIdeal ^ k :=
      (v.intValuation_le_pow_iff_mem a k).mp (hab.trans (le_of_eq hb_val))
    obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
    have hπ_dvd : v.asIdeal ^ 1 ∣ Ideal.span {π} := by
      apply (v.intValuation_le_pow_iff_dvd π 1).mp
      rw [hπ]
      exact le_rfl
    rw [pow_one] at hπ_dvd
    obtain ⟨J, hJ⟩ := hπ_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hπ_mem2 : π ∈ v.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ_le2 : v.intValuation π ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem π 2).mpr hπ_mem2
      rw [hπ, WithZero.exp_le_exp] at hπ_le2
      omega
    obtain ⟨s₀, hs₀J, hs₀v⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hspan_a : Ideal.span {a} ≤ v.asIdeal ^ k :=
      (Ideal.span_singleton_le_iff_mem _).mpr ha_mem
    have hspan_b : Ideal.span {b} ≤ v.asIdeal ^ k :=
      (Ideal.span_singleton_le_iff_mem _).mpr hb_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_πk : Ideal.span {π ^ k} = v.asIdeal ^ k * J ^ k := by
      rw [← Ideal.span_singleton_pow, hJ, mul_pow]
    have hspan_a_mul : Ideal.span {a * s₀ ^ k} ≤ Ideal.span {π ^ k} := by
      rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow, hspan_πk]
      exact Ideal.mul_mono hspan_a (Ideal.pow_right_mono hspan_s₀ k)
    have hspan_b_mul : Ideal.span {b * s₀ ^ k} ≤ Ideal.span {π ^ k} := by
      rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow, hspan_πk]
      exact Ideal.mul_mono hspan_b (Ideal.pow_right_mono hspan_s₀ k)
    obtain ⟨a₀, ha₀_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_a_mul
    obtain ⟨b₀, hb₀_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_b_mul
    have hs₀_val : v.intValuation s₀ = 1 := v.intValuation_eq_one_iff.mpr hs₀v
    have hπk_val : v.intValuation (π ^ k) = v.intValuation b := by
      rw [map_pow, hπ, exp_neg_one_pow k, hb_val]
    have hb_ne_val : v.intValuation b ≠ 0 := by
      rw [hb_val]; exact WithZero.exp_ne_zero
    have hb₀_val_eq : v.intValuation b * 1 = v.intValuation b * v.intValuation b₀ := by
      calc
        v.intValuation b * 1 = v.intValuation (b * s₀ ^ k) := by
          simp [map_mul, map_pow, hs₀_val]
        _ = v.intValuation (π ^ k * b₀) := by rw [hb₀_eq]
        _ = v.intValuation b * v.intValuation b₀ := by rw [map_mul, hπk_val]
    have hb₀_val : v.intValuation b₀ = 1 :=
      (mul_left_cancel₀ hb_ne_val hb₀_val_eq).symm
    have hb₀v : b₀ ∉ v.asIdeal := v.intValuation_eq_one_iff.mp hb₀_val
    exact ⟨k, π, s₀, a₀, b₀, hπk_val, hs₀v, hb₀v, ha₀_eq, hb₀_eq⟩
  have isSquare_quotient_of_isSquare :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
        (β : NumberField.RingOfIntegers K), β ∉ v.asIdeal →
          IsSquare (algebraMap K (v.adicCompletion K)
            (algebraMap (NumberField.RingOfIntegers K) K β)) →
          IsSquare (Ideal.Quotient.mk v.asIdeal β) := by
    intro v β hβ ⟨w, hw⟩
    let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
      (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
    have hw_ι : ι β = w * w := hw
    have h_val_ι : ∀ r : NumberField.RingOfIntegers K, Valued.v (ι r) = v.intValuation r :=
      fun r => (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
        (algebraMap (NumberField.RingOfIntegers K) K r)).trans (v.valuation_of_algebraMap r)
    have hβ_val : Valued.v (ι β) = 1 :=
      (h_val_ι β).trans (v.intValuation_eq_one_iff.mpr hβ)
    have hw_le : Valued.v w ≤ 1 := by
      by_contra! hw_gt
      have h_gt : (1 : WithZero (Multiplicative ℤ)) < Valued.v (ι β) := by
        rw [hw_ι, map_mul]
        exact one_lt_mul'' hw_gt hw_gt
      rw [hβ_val] at h_gt
      exact lt_irrefl 1 h_gt
    obtain ⟨c, hcw⟩ := exists_approx_lt_one v w
    let cF : v.adicCompletion K := algebraMap K (v.adicCompletion K) c
    have hcF_le : Valued.v cF ≤ 1 := by
      have h_eq : cF = (cF - w) + w := by ring
      rw [h_eq]
      exact (Valuation.map_add Valued.v (cF - w) w).trans (max_le (le_of_lt hcw) hw_le)
    have hcFw_le : Valued.v (cF + w) ≤ 1 :=
      (Valuation.map_add Valued.v cF w).trans (max_le hcF_le hw_le)
    have h_diff_lt : Valued.v (cF ^ 2 - ι β) < 1 := by
      have h_fac : cF ^ 2 - ι β = (cF - w) * (cF + w) := by
        rw [hw_ι]
        ring
      rw [h_fac, map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' hcFw_le) hcw
    obtain ⟨a, b, hb_mem, hab_div⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) c
    have hb : b ≠ 0 := nonZeroDivisors.ne_zero hb_mem
    have hbK : algebraMap (NumberField.RingOfIntegers K) K b ≠ 0 :=
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K).ne hb
    have hab_K : algebraMap (NumberField.RingOfIntegers K) K a =
        algebraMap (NumberField.RingOfIntegers K) K b * c := by
      rw [← hab_div, mul_div_cancel₀ _ hbK]
    have hab_F : ι a = ι b * cF := by
      change algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K a) =
        algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K b) * cF
      rw [hab_K, map_mul]
    have hab_val : v.intValuation a ≤ v.intValuation b := by
      rw [← h_val_ι a, ← h_val_ι b, hab_F, map_mul]
      exact mul_le_of_le_one_right' hcF_le
    obtain ⟨k, π, s₀, a₀, b₀, hπk_val, hs₀v, hb₀v, ha₀_eq, hb₀_eq⟩ :=
      exists_coprime_denom_of_intValuation_le v a b hb hab_val
    have hs₀_val : v.intValuation s₀ = 1 := v.intValuation_eq_one_iff.mpr hs₀v
    have h_alg_R : (a ^ 2 - β * b ^ 2) * (s₀ ^ k) ^ 2 = (π ^ k) ^ 2 * (a₀ ^ 2 - β * b₀ ^ 2) := by
      linear_combination (a * s₀ ^ k + π ^ k * a₀) * ha₀_eq - β * (b * s₀ ^ k + π ^ k * b₀) * hb₀_eq
    have h_alg_F : ι (a ^ 2 - β * b ^ 2) = (ι b) ^ 2 * (cF ^ 2 - ι β) := by
      simp only [map_sub, map_mul, map_pow]
      rw [hab_F]
      ring
    have hb2_ne : v.intValuation b ^ 2 ≠ 0 :=
      pow_ne_zero 2 (v.intValuation_ne_zero' ⟨b, hb_mem⟩)
    have h_val_eq : v.intValuation b ^ 2 * v.intValuation (a₀ ^ 2 - β * b₀ ^ 2) =
        v.intValuation b ^ 2 * Valued.v (cF ^ 2 - ι β) := by
      calc
        v.intValuation b ^ 2 * v.intValuation (a₀ ^ 2 - β * b₀ ^ 2)
          = v.intValuation ((π ^ k) ^ 2 * (a₀ ^ 2 - β * b₀ ^ 2)) := by
            rw [map_mul, map_pow, hπk_val]
        _ = v.intValuation ((a ^ 2 - β * b ^ 2) * (s₀ ^ k) ^ 2) := by rw [← h_alg_R]
        _ = v.intValuation (a ^ 2 - β * b ^ 2) := by
            simp [map_mul, map_pow, hs₀_val]
        _ = Valued.v (ι (a ^ 2 - β * b ^ 2)) := (h_val_ι _).symm
        _ = v.intValuation b ^ 2 * Valued.v (cF ^ 2 - ι β) := by
            rw [h_alg_F, map_mul, map_pow, h_val_ι b]
    have h_a₀b₀_lt : v.intValuation (a₀ ^ 2 - β * b₀ ^ 2) < 1 := by
      rw [mul_left_cancel₀ hb2_ne h_val_eq]
      exact h_diff_lt
    have h_a₀b₀_mem : a₀ ^ 2 - β * b₀ ^ 2 ∈ v.asIdeal :=
      (v.intValuation_lt_one_iff_mem (a₀ ^ 2 - β * b₀ ^ 2)).mp h_a₀b₀_lt
    haveI : v.asIdeal.IsMaximal := v.isMaximal
    letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    have hb₀_bar : Ideal.Quotient.mk v.asIdeal b₀ ≠ 0 :=
      Ideal.Quotient.eq_zero_iff_mem.not.mpr hb₀v
    have h_bar : (Ideal.Quotient.mk v.asIdeal a₀) ^ 2 -
        Ideal.Quotient.mk v.asIdeal β * (Ideal.Quotient.mk v.asIdeal b₀) ^ 2 = 0 := by
      rw [← map_pow, ← map_pow, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact h_a₀b₀_mem
    refine ⟨Ideal.Quotient.mk v.asIdeal a₀ / Ideal.Quotient.mk v.asIdeal b₀, ?_⟩
    have hb₀_bar2 : (Ideal.Quotient.mk v.asIdeal b₀) ^ 2 ≠ 0 := pow_ne_zero 2 hb₀_bar
    apply mul_right_cancel₀ hb₀_bar2
    calc
      Ideal.Quotient.mk v.asIdeal β * (Ideal.Quotient.mk v.asIdeal b₀) ^ 2
        = (Ideal.Quotient.mk v.asIdeal a₀) ^ 2 := by linear_combination -h_bar
      _ = (Ideal.Quotient.mk v.asIdeal a₀ / Ideal.Quotient.mk v.asIdeal b₀) *
          (Ideal.Quotient.mk v.asIdeal a₀ / Ideal.Quotient.mk v.asIdeal b₀) *
          (Ideal.Quotient.mk v.asIdeal b₀) ^ 2 := by
        field_simp [hb₀_bar]
  letI := Classical.propDecidable
  dsimp [oddQuadProd, oddResQuadProd]
  refine finprod_congr (fun v => ?_)
  by_cases h : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1
  · rw [if_pos h, if_pos h]
    dsimp [quadSym, resQuadSym]
    apply if_congr _ rfl rfl
    exact ⟨isSquare_quotient_of_isSquare v β (h_coprime v h.1 h.2),
      isSquare_of_isSquare_quotient v h.1 β (h_coprime v h.1 h.2)⟩
  · rw [if_neg h, if_neg h]

theorem oddResQuadProd_mul_sq_invariance {K : Type u} [Field K] [NumberField K]
    (α β s t : NumberField.RingOfIntegers K)
    (hα : α ≠ 0) (hβ : β ≠ 0) (hs : s ≠ 0) (ht : t ≠ 0)
    (h_unit : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        (valNat v α % 2 = 1 → t ∉ v.asIdeal) ∧
        (valNat v β % 2 = 1 → s ∉ v.asIdeal)) :
    dyadicProd (α * s ^ 2) (β * t ^ 2) = dyadicProd α β ∧
    oddResQuadProd (α * s ^ 2) (β * t ^ 2) = oddResQuadProd α β ∧
    oddResQuadProd (β * t ^ 2) (α * s ^ 2) = oddResQuadProd β α ∧
    realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (ξ : R),
        ξ ≠ 0 → v.intValuation ξ = WithZero.exp (-(valNat v ξ : ℤ)) := by
    intro v ξ hξ
    have hv_ne : v.intValuation ξ ≠ 0 :=
      v.intValuation_ne_zero' ⟨ξ, mem_nonZeroDivisors_of_ne_zero hξ⟩
    have hv_le : v.intValuation ξ ≤ 1 := v.intValuation_le_one ξ
    have hlog_le : WithZero.log (v.intValuation ξ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v ξ : ℤ) = -WithZero.log (v.intValuation ξ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have valNat_mul_sq_mod_two :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        γ ≠ 0 → c ≠ 0 → valNat v (γ * c ^ 2) % 2 = valNat v γ % 2 := by
    intro v γ c hγ hc
    have hval_mul : v.intValuation (γ * c ^ 2) =
        WithZero.exp (-((valNat v γ + 2 * valNat v c : ℕ) : ℤ)) := by
      rw [map_mul, map_pow, sq, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v c hc, ← WithZero.exp_add, ← WithZero.exp_add]
      congr 1
      omega
    have hvalNat_eq : valNat v (γ * c ^ 2) = valNat v γ + 2 * valNat v c := by
      change (-WithZero.log (v.intValuation (γ * c ^ 2))).toNat = valNat v γ + 2 * valNat v c
      rw [hval_mul, WithZero.log_exp]
      omega
    rw [hvalNat_eq]
    omega
  letI := Classical.propDecidable
  have h_norm : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      normSym v (α * s ^ 2) (β * t ^ 2) = normSym v α β := by
    classical
    intro v
    let F := v.adicCompletion K
    let a : F := algebraMap K F (algebraMap R K α)
    let b : F := algebraMap K F (algebraMap R K β)
    let sF : F := algebraMap K F (algebraMap R K s)
    let tF : F := algebraMap K F (algebraMap R K t)
    have ha_map : algebraMap K F (algebraMap R K (α * s ^ 2)) = a * sF ^ 2 := by
      simp [a, sF, map_mul, map_pow]
    have hb_map : algebraMap K F (algebraMap R K (β * t ^ 2)) = b * tF ^ 2 := by
      simp [b, tF, map_mul, map_pow]
    have hs_K : algebraMap R K s ≠ 0 :=
      (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hs
    have ht_K : algebraMap R K t ≠ 0 :=
      (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr ht
    have hsF : sF ≠ 0 :=
      (map_ne_zero_iff (algebraMap K F) (RingHom.injective _)).mpr hs_K
    have htF : tF ≠ 0 :=
      (map_ne_zero_iff (algebraMap K F) (RingHom.injective _)).mpr ht_K
    have hs_inv : sF * sF⁻¹ = 1 := mul_inv_cancel₀ hsF
    have ht_inv : tF * tF⁻¹ = 1 := mul_inv_cancel₀ htF
    have h_iff : (∃ X' Y' : F, X' ^ 2 - (b * tF ^ 2) * Y' ^ 2 = a * sF ^ 2) ↔
        (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) := by
      constructor
      · rintro ⟨X', Y', hXY'⟩
        refine ⟨X' * sF⁻¹, Y' * tF * sF⁻¹, ?_⟩
        linear_combination (sF⁻¹) ^ 2 * hXY' + a * (sF * sF⁻¹ + 1) * hs_inv
      · rintro ⟨X, Y, hXY⟩
        refine ⟨X * sF, Y * sF * tF⁻¹, ?_⟩
        linear_combination sF ^ 2 * hXY - b * Y ^ 2 * sF ^ 2 * (tF * tF⁻¹ + 1) * ht_inv
    dsimp only [normSym]
    change (if ∃ X' Y' : F,
        X' ^ 2 - algebraMap K F (algebraMap R K (β * t ^ 2)) * Y' ^ 2 =
          algebraMap K F (algebraMap R K (α * s ^ 2))
      then (1 : ℤˣ) else -1) =
      (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1)
    rw [ha_map, hb_map, h_iff]
  have h_dyad : dyadicProd (α * s ^ 2) (β * t ^ 2) = dyadicProd α β := by
    dsimp only [dyadicProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, h_norm v]
    · rw [if_neg h2v, if_neg h2v]
  have resQuadSym_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        c ∉ v.asIdeal → resQuadSym v (γ * c ^ 2) = resQuadSym v γ := by
    intro v γ c hc
    haveI : v.asIdeal.IsMaximal := v.isMaximal
    letI : Field (R ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    let x : R ⧸ v.asIdeal := Ideal.Quotient.mk v.asIdeal γ
    let u : R ⧸ v.asIdeal := Ideal.Quotient.mk v.asIdeal c
    have hu : u ≠ 0 := Ideal.Quotient.eq_zero_iff_mem.not.mpr hc
    have h_iff : IsSquare (x * u ^ 2) ↔ IsSquare x := by
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨w / u, ?_⟩
        rw [div_mul_div_comm, ← hw, sq, mul_div_cancel_right₀ _ (mul_ne_zero hu hu)]
      · rintro ⟨r, hr⟩
        refine ⟨r * u, ?_⟩
        rw [hr]
        ring
    dsimp only [resQuadSym]
    change (if IsSquare (Ideal.Quotient.mk v.asIdeal (γ * c ^ 2)) then (1 : ℤˣ) else -1) =
      (if IsSquare x then (1 : ℤˣ) else -1)
    have h_map : Ideal.Quotient.mk v.asIdeal (γ * c ^ 2) = x * u ^ 2 := by
      simp [x, u, map_mul, map_pow]
    rw [h_map, h_iff]
  have oddResQuadProd_mul_sq :
      ∀ (γ₁ γ₂ c₁ c₂ : R), γ₁ ≠ 0 → c₁ ≠ 0 →
        (∀ v : IsDedekindDomain.HeightOneSpectrum R,
          (2 : R) ∉ v.asIdeal → valNat v γ₁ % 2 = 1 → c₂ ∉ v.asIdeal) →
        oddResQuadProd (γ₁ * c₁ ^ 2) (γ₂ * c₂ ^ 2) = oddResQuadProd γ₁ γ₂ := by
    intro γ₁ γ₂ c₁ c₂ hγ₁ hc₁ h_u
    dsimp only [oddResQuadProd]
    refine finprod_congr (fun v => ?_)
    rw [valNat_mul_sq_mod_two v γ₁ c₁ hγ₁ hc₁]
    by_cases h : (2 : R) ∉ v.asIdeal ∧ valNat v γ₁ % 2 = 1
    · rw [if_pos h, if_pos h, resQuadSym_mul_sq v γ₂ c₂ (h_u v h.1 h.2)]
    · rw [if_neg h, if_neg h]
  have h_real : realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β := by
    dsimp only [realSignProd]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ c : K, (w.embedding c).re = ρ c := by
        intro c
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw c, Complex.ofReal_re]
      have h_sign_mul_sq : ∀ (γ c : R), c ≠ 0 →
          ((w.embedding (algebraMap R K (γ * c ^ 2))).re < 0 ↔
            (w.embedding (algebraMap R K γ)).re < 0) := by
        intro γ c hc
        rw [h_re, h_re]
        simp only [map_mul, map_pow]
        have hc_K : algebraMap R K c ≠ 0 :=
          (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hc
        have hc_R : ρ (algebraMap R K c) ≠ 0 :=
          (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hc_K
        have hc_sq : 0 < (ρ (algebraMap R K c)) ^ 2 := sq_pos_of_ne_zero hc_R
        constructor <;> intro h <;> nlinarith
      rw [h_sign_mul_sq α s hs, h_sign_mul_sq β t ht]
    · have h1 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K (α * s ^ 2))).re < 0 ∧
          (w.embedding (algebraMap R K (β * t ^ 2))).re < 0) := fun h => hw h.1
      have h2 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α)).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      rw [if_neg h1, if_neg h2]
  exact ⟨h_dyad,
    oddResQuadProd_mul_sq α β s t hα hs (fun v h2 => (h_unit v h2).1),
    oddResQuadProd_mul_sq β α t s hβ ht (fun v h2 => (h_unit v h2).2),
    h_real⟩

theorem exists_mul_sq_dyadic_sqfree {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        (valNat v α % 2 = 1 → β ∉ v.asIdeal) ∧
        (valNat v β % 2 = 1 → α ∉ v.asIdeal)) :
    ∃ α' β' s₁ t₁ s₂ t₂ : NumberField.RingOfIntegers K,
      α' ≠ 0 ∧ β' ≠ 0 ∧ s₁ ≠ 0 ∧ t₁ ≠ 0 ∧ s₂ ≠ 0 ∧ t₂ ≠ 0 ∧
      α * s₁ ^ 2 = α' * t₁ ^ 2 ∧
      β * s₂ ^ 2 = β' * t₂ ^ 2 ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          (valNat v α % 2 = 1 → s₂ ∉ v.asIdeal) ∧
          (valNat v β % 2 = 1 → s₁ ∉ v.asIdeal)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          (valNat v α' % 2 = 1 → t₂ ∉ v.asIdeal) ∧
          (valNat v β' % 2 = 1 → t₁ ∉ v.asIdeal)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          (valNat v α' % 2 = 1 → β' ∉ v.asIdeal) ∧
          (valNat v β' % 2 = 1 → α' ∉ v.asIdeal)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
          valNat v α' ≤ 1 ∧ valNat v β' ≤ 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have finite_mem_asIdeal :
      ∀ (γ : R), γ ≠ 0 →
        {v : IsDedekindDomain.HeightOneSpectrum R | γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hI : (Ideal.span {γ} : Ideal R) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-((valNat v γ : ℕ) : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have h_toNat : ((valNat v γ : ℕ) : ℤ) = -WithZero.log (v.intValuation γ) := by
      dsimp [valNat]
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [h_toNat, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ δ : R), γ ≠ 0 → δ ≠ 0 →
        valNat v (γ * δ) = valNat v γ + valNat v δ := by
    intro v γ δ hγ hδ
    have hval_mul : v.intValuation (γ * δ) =
        WithZero.exp (-((valNat v γ + valNat v δ : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v δ hδ, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * δ))).toNat = valNat v γ + valNat v δ
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_mod_two_eq_of_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ γ' s t : R),
        γ ≠ 0 → γ' ≠ 0 → s ≠ 0 → t ≠ 0 → γ * s ^ 2 = γ' * t ^ 2 →
          valNat v γ' % 2 = valNat v γ % 2 := by
    intro v γ γ' s t hγ hγ' hs ht h_eq
    have hs2 : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    have h1 : valNat v (γ * s ^ 2) = valNat v γ + (valNat v s + valNat v s) := by
      rw [valNat_mul v γ (s ^ 2) hγ hs2, sq s, valNat_mul v s s hs hs]
    have h2 : valNat v (γ' * t ^ 2) = valNat v γ' + (valNat v t + valNat v t) := by
      rw [valNat_mul v γ' (t ^ 2) hγ' ht2, sq t, valNat_mul v t t ht ht]
    have h3 : valNat v (γ * s ^ 2) = valNat v (γ' * t ^ 2) := congr_arg (valNat v) h_eq
    omega
  have valNat_eq_zero_of_not_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ∉ v.asIdeal → valNat v γ = 0 := by
    intro v γ hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    dsimp [valNat]
    rw [hv1, WithZero.log_one]
    rfl
  have mem_asIdeal_of_valNat_mod_two_eq_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        valNat v γ % 2 = 1 → γ ∈ v.asIdeal := by
    intro v γ hodd
    by_contra hnot
    have h0 : valNat v γ = 0 := valNat_eq_zero_of_not_mem v γ hnot
    omega
  have exists_step_clear :
      ∀ (T : Finset (IsDedekindDomain.HeightOneSpectrum R))
        (w : IsDedekindDomain.HeightOneSpectrum R), w ∉ T →
        ∀ (γ₁ : R), γ₁ ≠ 0 →
          ∃ γ' s₀ t₀ : R,
            γ' ≠ 0 ∧ s₀ ≠ 0 ∧ t₀ ≠ 0 ∧
            γ₁ * s₀ ^ 2 = γ' * t₀ ^ 2 ∧
            valNat w γ' ≤ 1 ∧
            (∀ u ∈ T, s₀ ∉ u.asIdeal ∧ t₀ ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁) := by
    intro T w hwT γ₁ hγ₁
    let k : ℕ := valNat w γ₁ / 2
    have hγ₁_val : w.intValuation γ₁ ≤ WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [intValuation_eq_exp_neg_valNat w γ₁ hγ₁, WithZero.exp_le_exp]
      omega
    have hγ₁_mem : γ₁ ∈ w.asIdeal ^ (2 * k) :=
      (w.intValuation_le_pow_iff_mem γ₁ (2 * k)).mp hγ₁_val
    have h_cop : IsCoprime (w.asIdeal ^ 2) (∏ u ∈ T, u.asIdeal) := by
      refine IsCoprime.prod_right (fun u huT => ?_)
      have hne : w ≠ u := fun h => hwT (h ▸ huT)
      have h_id_ne : w.asIdeal ≠ u.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hne
      haveI := w.isMaximal
      haveI := u.isMaximal
      exact (Ideal.isCoprime_of_isMaximal h_id_ne).pow_left
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_cop
    have hx_val : w.intValuation x ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
      (w.intValuation_le_pow_iff_mem x 2).mpr hx
    have hx_w : x ∈ w.asIdeal :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hx
    have hy_w : y ∉ w.asIdeal := by
      intro hy_m
      have h1_m : (1 : R) ∈ w.asIdeal := hxy ▸ w.asIdeal.add_mem hx_w hy_m
      exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_m)
    have hy_val : w.intValuation y = 1 := w.intValuation_eq_one_iff.mpr hy_w
    have hy_T : ∀ u ∈ T, y ∈ u.asIdeal :=
      fun u huT => (Ideal.prod_le_inf.trans (Finset.inf_le huT)) hy
    have hx_T : ∀ u ∈ T, x ∉ u.asIdeal := by
      intro u huT hx_m
      have h1_m : (1 : R) ∈ u.asIdeal := hxy ▸ u.asIdeal.add_mem hx_m (hy_T u huT)
      exact u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1_m)
    obtain ⟨π, hπ⟩ := w.intValuation_exists_uniformizer
    let π' : R := π * y + x
    have hπy_val : w.intValuation (π * y) = WithZero.exp (-1 : ℤ) := by
      rw [map_mul, hπ, hy_val, mul_one]
    have hlt_exp : WithZero.exp (-((2 : ℕ) : ℤ)) < WithZero.exp (-1 : ℤ) :=
      WithZero.exp_lt_exp.mpr (by omega)
    have hlt_val : w.intValuation x < w.intValuation (π * y) := by
      rw [hπy_val]
      exact lt_of_le_of_lt hx_val hlt_exp
    have hπ'_val : w.intValuation π' = WithZero.exp (-1 : ℤ) := by
      change w.intValuation (π * y + x) = WithZero.exp (-1 : ℤ)
      rw [add_comm, Valuation.map_add_of_distinct_val w.intValuation (ne_of_lt hlt_val),
        max_eq_right (le_of_lt hlt_val), hπy_val]
    have hπ'_w : π' ∈ w.asIdeal := by
      have hle1 : w.intValuation π' ≤ WithZero.exp (-((1 : ℕ) : ℤ)) := by
        rw [hπ'_val]
        exact le_rfl
      simpa [pow_one] using (w.intValuation_le_pow_iff_mem π' 1).mp hle1
    have hπ'_T : ∀ u ∈ T, π' ∉ u.asIdeal := by
      intro u huT hπ'_m
      have hπy_m : π * y ∈ u.asIdeal := u.asIdeal.mul_mem_left π (hy_T u huT)
      have hx_m : x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hπ'_m hπy_m
        have hid : π' - π * y = x := by dsimp [π']; ring
        rwa [hid] at hsub
      exact hx_T u huT hx_m
    have hπ'_dvd : w.asIdeal ^ 1 ∣ Ideal.span {π'} := by
      apply (w.intValuation_le_pow_iff_dvd π' 1).mp
      rw [hπ'_val]
      exact le_rfl
    rw [pow_one] at hπ'_dvd
    obtain ⟨J, hJ⟩ := hπ'_dvd
    have hJ_not_le : ¬ (J ≤ w.asIdeal) := by
      intro hle
      have hπ'_mem2 : π' ∈ w.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ'_le2 : w.intValuation π' ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (w.intValuation_le_pow_iff_mem π' 2).mpr hπ'_mem2
      rw [hπ'_val, WithZero.exp_le_exp] at hπ'_le2
      omega
    obtain ⟨a, haJ, haw⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hπ'J : π' ∈ J := by
      rw [← Ideal.span_singleton_le_iff_mem, hJ]
      exact Ideal.mul_le_left
    let s₀ : R := a * y + π' * x
    have hs₀J : s₀ ∈ J :=
      J.add_mem (J.mul_mem_right y haJ) (J.mul_mem_right x hπ'J)
    have hs₀w : s₀ ∉ w.asIdeal := by
      intro hs₀_m
      have hπ'x_w : π' * x ∈ w.asIdeal := w.asIdeal.mul_mem_right x hπ'_w
      have hay_w : a * y ∈ w.asIdeal := by
        have hsub := w.asIdeal.sub_mem hs₀_m hπ'x_w
        have hid : s₀ - π' * x = a * y := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases w.isPrime.mem_or_mem hay_w with ha_m | hy_m
      · exact haw ha_m
      · exact hy_w hy_m
    have hs₀_T : ∀ u ∈ T, s₀ ∉ u.asIdeal := by
      intro u huT hs₀_m
      have hay_u : a * y ∈ u.asIdeal := u.asIdeal.mul_mem_left a (hy_T u huT)
      have hπ'x_u : π' * x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hs₀_m hay_u
        have hid : s₀ - a * y = π' * x := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases u.isPrime.mem_or_mem hπ'x_u with hπ'_m | hx_m
      · exact hπ'_T u huT hπ'_m
      · exact hx_T u huT hx_m
    have hspan_γ₁ : Ideal.span {γ₁} ≤ w.asIdeal ^ (2 * k) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hγ₁_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_mul : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π' ^ k) ^ 2} := by
      have h1 : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} = Ideal.span {γ₁} * (Ideal.span {s₀}) ^ (2 * k) := by
        rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
          ← Ideal.span_singleton_pow]
      have h2 : Ideal.span {(π' ^ k) ^ 2} = w.asIdeal ^ (2 * k) * J ^ (2 * k) := by
        rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
      rw [h1, h2]
      exact Ideal.mul_mono hspan_γ₁ (Ideal.pow_right_mono hspan_s₀ (2 * k))
    obtain ⟨γ', hγ'_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
    have hπ'_pow_val : w.intValuation ((π' ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ'_val, exp_neg_one_pow (2 * k)]
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀w (h0 ▸ w.asIdeal.zero_mem)
    have hπ'_ne : π' ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hπ'_val
      exact WithZero.exp_ne_zero hπ'_val.symm
    have hs₀k2_ne : (s₀ ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hs₀_ne)
    have hπ'k2_ne : (π' ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hπ'_ne)
    have hγ'_ne : γ' ≠ 0 := by
      intro h0
      apply mul_ne_zero hγ₁ hs₀k2_ne
      rw [hγ'_eq, h0, mul_zero]
    have hs₀k2_not_w : (s₀ ^ k) ^ 2 ∉ w.asIdeal :=
      fun hm => hs₀w (w.isPrime.mem_of_pow_mem k (w.isPrime.mem_of_pow_mem 2 hm))
    have hval_s₀k2_w : valNat w ((s₀ ^ k) ^ 2) = 0 :=
      valNat_eq_zero_of_not_mem w ((s₀ ^ k) ^ 2) hs₀k2_not_w
    have hval_π'k2_w : valNat w ((π' ^ k) ^ 2) = 2 * k := by
      change (-WithZero.log (w.intValuation ((π' ^ k) ^ 2))).toNat = 2 * k
      rw [hπ'_pow_val, WithZero.log_exp]
      omega
    have hval_eq_w : valNat w γ₁ + valNat w ((s₀ ^ k) ^ 2) =
        valNat w ((π' ^ k) ^ 2) + valNat w γ' := by
      rw [← valNat_mul w γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
        valNat_mul w ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
    have hγ'_le_one : valNat w γ' ≤ 1 := by omega
    have hT_props : ∀ u ∈ T,
        s₀ ^ k ∉ u.asIdeal ∧ π' ^ k ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁ := by
      intro u huT
      have hs₀k_not_u : s₀ ^ k ∉ u.asIdeal :=
        fun hm => hs₀_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hπ'k_not_u : π' ^ k ∉ u.asIdeal :=
        fun hm => hπ'_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hs₀k2_not_u : (s₀ ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hs₀k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hπ'k2_not_u : (π' ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hπ'k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hval_s₀k2_u : valNat u ((s₀ ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((s₀ ^ k) ^ 2) hs₀k2_not_u
      have hval_π'k2_u : valNat u ((π' ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((π' ^ k) ^ 2) hπ'k2_not_u
      have hval_eq_u : valNat u γ₁ + valNat u ((s₀ ^ k) ^ 2) =
          valNat u ((π' ^ k) ^ 2) + valNat u γ' := by
        rw [← valNat_mul u γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
          valNat_mul u ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
      refine ⟨hs₀k_not_u, hπ'k_not_u, by omega⟩
    refine ⟨γ', s₀ ^ k, π' ^ k, hγ'_ne, pow_ne_zero k hs₀_ne, pow_ne_zero k hπ'_ne,
      hγ'_eq.trans (mul_comm _ _), hγ'_le_one, hT_props⟩
  have exists_clear_finset :
      ∀ (P S : Finset (IsDedekindDomain.HeightOneSpectrum R)),
        (∀ v ∈ S, v ∉ P) →
        ∀ (γ : R), γ ≠ 0 →
          ∃ γ' s t : R,
            γ' ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
            γ * s ^ 2 = γ' * t ^ 2 ∧
            (∀ u ∈ P, s ∉ u.asIdeal ∧ t ∉ u.asIdeal) ∧
            (∀ v ∈ S, valNat v γ' ≤ 1) := by
    intro P S
    induction S using Finset.induction_on with
    | empty =>
      intro _ γ hγ
      refine ⟨γ, 1, 1, hγ, one_ne_zero, one_ne_zero, rfl, ?_, ?_⟩
      · intro u _
        have h1_not : (1 : R) ∉ u.asIdeal :=
          fun h1 => u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1)
        exact ⟨h1_not, h1_not⟩
      · intro v hv
        exact False.elim (Finset.notMem_empty v hv)
    | insert w S hwS ih =>
      intro hSP γ hγ
      have hwP : w ∉ P := hSP w (Finset.mem_insert_self w S)
      have hSP' : ∀ v ∈ S, v ∉ P := fun v hv => hSP v (Finset.mem_insert_of_mem hv)
      obtain ⟨γ₁, s₁, t₁, hγ₁, hs₁, ht₁, h_eq₁, hP₁, hS₁⟩ := ih hSP' γ hγ
      have hwSP : w ∉ S ∪ P := fun hm => (Finset.mem_union.mp hm).elim hwS hwP
      obtain ⟨γ', s₀, t₀, hγ', hs₀, ht₀, h_eq₀, hw', hSP₀⟩ :=
        exists_step_clear (S ∪ P) w hwSP γ₁ hγ₁
      refine ⟨γ', s₁ * s₀, t₁ * t₀, hγ', mul_ne_zero hs₁ hs₀, mul_ne_zero ht₁ ht₀, ?_, ?_, ?_⟩
      · linear_combination s₀ ^ 2 * h_eq₁ + t₁ ^ 2 * h_eq₀
      · intro u huP
        have huSP : u ∈ S ∪ P := Finset.mem_union.mpr (Or.inr huP)
        obtain ⟨hs₁_u, ht₁_u⟩ := hP₁ u huP
        obtain ⟨hs₀_u, ht₀_u, _⟩ := hSP₀ u huSP
        refine ⟨fun hm => (u.isPrime.mem_or_mem hm).elim hs₁_u hs₀_u,
          fun hm => (u.isPrime.mem_or_mem hm).elim ht₁_u ht₀_u⟩
      · intro v hv
        rcases Finset.mem_insert.mp hv with rfl | hvS
        · exact hw'
        · have hvSP : v ∈ S ∪ P := Finset.mem_union.mpr (Or.inl hvS)
          rw [(hSP₀ v hvSP).2.2]
          exact hS₁ v hvS
  have h2 : (2 : R) ≠ 0 := two_ne_zero
  have hfin_2 := finite_mem_asIdeal (2 : R) h2
  let F_2 : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_2.toFinset
  have hfin_αβ := finite_mem_asIdeal (α * β) (mul_ne_zero hα hβ)
  let F_αβ : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_αβ.toFinset
  let P : Finset (IsDedekindDomain.HeightOneSpectrum R) := F_αβ \ F_2
  have hF2_P : ∀ v ∈ F_2, v ∉ P := fun v hv hm => (Finset.mem_sdiff.mp hm).2 hv
  have mem_P_of_mem_left : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      (2 : R) ∉ v.asIdeal → α ∈ v.asIdeal → v ∈ P := by
    intro v h2v hαv
    refine Finset.mem_sdiff.mpr ⟨?_, ?_⟩
    · exact hfin_αβ.mem_toFinset.mpr (v.asIdeal.mul_mem_right β hαv)
    · exact fun hv2 => h2v (hfin_2.mem_toFinset.mp hv2)
  have mem_P_of_mem_right : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      (2 : R) ∉ v.asIdeal → β ∈ v.asIdeal → v ∈ P := by
    intro v h2v hβv
    refine Finset.mem_sdiff.mpr ⟨?_, ?_⟩
    · exact hfin_αβ.mem_toFinset.mpr (v.asIdeal.mul_mem_left α hβv)
    · exact fun hv2 => h2v (hfin_2.mem_toFinset.mp hv2)
  obtain ⟨α', s₁, t₁, hα', hs₁, ht₁, h_eqα, hP_α, hF2_α⟩ :=
    exists_clear_finset P F_2 hF2_P α hα
  obtain ⟨β', s₂, t₂, hβ', hs₂, ht₂, h_eqβ, hP_β, hF2_β⟩ :=
    exists_clear_finset P F_2 hF2_P β hβ
  refine ⟨α', β', s₁, t₁, s₂, t₂, hα', hβ', hs₁, ht₁, hs₂, ht₂, h_eqα, h_eqβ, ?_, ?_, ?_, ?_⟩
  · intro v h2v
    refine ⟨fun hα_odd => ?_, fun hβ_odd => ?_⟩
    · have hvP : v ∈ P :=
        mem_P_of_mem_left v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v α hα_odd)
      exact (hP_β v hvP).1
    · have hvP : v ∈ P :=
        mem_P_of_mem_right v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v β hβ_odd)
      exact (hP_α v hvP).1
  · intro v h2v
    have hpar_α := valNat_mod_two_eq_of_mul_sq v α α' s₁ t₁ hα hα' hs₁ ht₁ h_eqα
    have hpar_β := valNat_mod_two_eq_of_mul_sq v β β' s₂ t₂ hβ hβ' hs₂ ht₂ h_eqβ
    refine ⟨fun hα'_odd => ?_, fun hβ'_odd => ?_⟩
    · have hα_odd : valNat v α % 2 = 1 := hpar_α ▸ hα'_odd
      have hvP : v ∈ P :=
        mem_P_of_mem_left v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v α hα_odd)
      exact (hP_β v hvP).2
    · have hβ_odd : valNat v β % 2 = 1 := hpar_β ▸ hβ'_odd
      have hvP : v ∈ P :=
        mem_P_of_mem_right v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v β hβ_odd)
      exact (hP_α v hvP).2
  · intro v h2v
    have hpar_α := valNat_mod_two_eq_of_mul_sq v α α' s₁ t₁ hα hα' hs₁ ht₁ h_eqα
    have hpar_β := valNat_mod_two_eq_of_mul_sq v β β' s₂ t₂ hβ hβ' hs₂ ht₂ h_eqβ
    refine ⟨fun hα'_odd => ?_, fun hβ'_odd => ?_⟩
    · have hα_odd : valNat v α % 2 = 1 := hpar_α ▸ hα'_odd
      have hvP : v ∈ P :=
        mem_P_of_mem_left v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v α hα_odd)
      have hβ_not : β ∉ v.asIdeal := (h_coprime v h2v).1 hα_odd
      have hs₂_not : s₂ ∉ v.asIdeal := (hP_β v hvP).1
      intro hβ'_mem
      have h_lhs_mem : β * s₂ ^ 2 ∈ v.asIdeal := by
        rw [h_eqβ]
        exact v.asIdeal.mul_mem_right (t₂ ^ 2) hβ'_mem
      rcases v.isPrime.mem_or_mem h_lhs_mem with hβ_m | hs₂_m
      · exact hβ_not hβ_m
      · exact hs₂_not (v.isPrime.mem_of_pow_mem 2 hs₂_m)
    · have hβ_odd : valNat v β % 2 = 1 := hpar_β ▸ hβ'_odd
      have hvP : v ∈ P :=
        mem_P_of_mem_right v h2v (mem_asIdeal_of_valNat_mod_two_eq_one v β hβ_odd)
      have hα_not : α ∉ v.asIdeal := (h_coprime v h2v).2 hβ_odd
      have hs₁_not : s₁ ∉ v.asIdeal := (hP_α v hvP).1
      intro hα'_mem
      have h_lhs_mem : α * s₁ ^ 2 ∈ v.asIdeal := by
        rw [h_eqα]
        exact v.asIdeal.mul_mem_right (t₁ ^ 2) hα'_mem
      rcases v.isPrime.mem_or_mem h_lhs_mem with hα_m | hs₁_m
      · exact hα_not hα_m
      · exact hs₁_not (v.isPrime.mem_of_pow_mem 2 hs₁_m)
  · intro v h2v
    have hv2 : v ∈ F_2 := hfin_2.mem_toFinset.mpr h2v
    exact ⟨hF2_α v hv2, hF2_β v hv2⟩

theorem dyadicProd_eq_resDyadicProd_of_sqfree {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    dyadicProd α β = resDyadicProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-(valNat v γ : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v γ : ℤ) = -WithZero.log (v.intValuation γ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valued_algebraMap_eq_intValuation :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (r : R),
        Valued.v (algebraMap K (v.adicCompletion K) (algebraMap R K r)) = v.intValuation r :=
    fun v r => (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
      (algebraMap R K r)).trans (v.valuation_of_algebraMap r)
  have isSquare_of_val_sub_one_le :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (u : v.adicCompletion K),
        Valued.v (u - 1) ≤ WithZero.exp (-((2 * valNat v (2 : R) + 1 : ℕ) : ℤ)) →
        IsSquare u := by
    intro v u hu_le
    let e : ℕ := valNat v (2 : R)
    let ι : R →+* v.adicCompletion K := (algebraMap K (v.adicCompletion K)).comp (algebraMap R K)
    have h2R : (2 : R) ≠ 0 := two_ne_zero
    have h2_val : Valued.v (2 : v.adicCompletion K) = WithZero.exp (-(e : ℤ)) := by
      have h2_eq : (2 : v.adicCompletion K) = ι (2 : R) := (map_ofNat ι 2).symm
      rw [h2_eq]
      exact (valued_algebraMap_eq_intValuation v (2 : R)).trans
        (intValuation_eq_exp_neg_valNat v (2 : R) h2R)
    have h2_ne : (2 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at h2_val
      exact WithZero.exp_ne_zero h2_val.symm
    have h2inv_val : Valued.v ((2 : v.adicCompletion K)⁻¹) = WithZero.exp (e : ℤ) := by
      rw [map_inv₀, h2_val, ← WithZero.exp_neg, neg_neg]
    have h2_mul_inv : (2 : v.adicCompletion K) * 2⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    let z : ℕ → v.adicCompletion K := fun n =>
      Nat.recOn n 1 (fun _ zn => zn - 2⁻¹ * (zn ^ 2 - u))
    have h_ind : ∀ n : ℕ,
        Valued.v (z n - 1) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) ∧
        Valued.v (z n ^ 2 - u) ≤ WithZero.exp (-((2 * e + n + 1 : ℕ) : ℤ)) := by
      intro n
      induction n with
      | zero =>
        refine ⟨?_, ?_⟩
        · change Valued.v ((1 : v.adicCompletion K) - 1) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ))
          rw [sub_self, Valuation.map_zero]
          exact zero_le'
        · change Valued.v ((1 : v.adicCompletion K) ^ 2 - u) ≤
            WithZero.exp (-((2 * e + 0 + 1 : ℕ) : ℤ))
          have hid : (1 : v.adicCompletion K) ^ 2 - u = -(u - 1) := by ring
          rw [hid, Valuation.map_neg, Nat.add_zero]
          exact hu_le
      | succ n ih =>
        have h_step : z (n + 1) = z n - 2⁻¹ * (z n ^ 2 - u) := rfl
        have h_term : Valued.v (2⁻¹ * (z n ^ 2 - u)) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) := by
          rw [map_mul, h2inv_val]
          refine (mul_le_mul' le_rfl ih.2).trans ?_
          rw [← WithZero.exp_add, WithZero.exp_le_exp]
          omega
        refine ⟨?_, ?_⟩
        · have h_diff : z (n + 1) - 1 = (z n - 1) - 2⁻¹ * (z n ^ 2 - u) := by
            rw [h_step]; ring
          rw [h_diff]
          exact (Valuation.map_sub Valued.v _ _).trans (max_le ih.1 h_term)
        · have h_id : z (n + 1) ^ 2 - u =
              (z n ^ 2 - u) * (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) := by
            rw [h_step]
            linear_combination - z n * (z n ^ 2 - u) * h2_mul_inv
          have h_fac2 : Valued.v (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) ≤
              WithZero.exp (-1 : ℤ) := by
            refine (Valuation.map_add Valued.v _ _).trans (max_le ?_ ?_)
            · rw [Valuation.map_neg]
              refine ih.1.trans ?_
              rw [WithZero.exp_le_exp]
              omega
            · rw [map_mul, sq (2⁻¹ : v.adicCompletion K), map_mul, h2inv_val]
              refine (mul_le_mul' le_rfl ih.2).trans ?_
              rw [← WithZero.exp_add, ← WithZero.exp_add, WithZero.exp_le_exp]
              omega
