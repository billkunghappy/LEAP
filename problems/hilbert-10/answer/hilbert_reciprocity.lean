      rw [mul_comm X, ← mul_assoc, one_div_mul_cancel ha_cpow_ne, one_mul]
    have h_prefactor :
        ((1 / T : ℝ) : ℂ) ^ (1 / 2 : ℂ) * (1 / a ^ (1 / 2 : ℂ) * d ^ (1 / 2 : ℂ)) =
          (((16 * (K : ℝ)) ^ (1 / 2 : ℝ) : ℝ) : ℂ) * Complex.exp (Real.pi * Complex.I / 4) := by
      rw [hd_cpow, h_cancel_a, ← mul_assoc]
      congr 1
      have h1_nonneg : 0 ≤ (1 / T : ℝ) := by positivity
      have h2_nonneg : 0 ≤ 16 * (K : ℝ) * T := by positivity
      have h3_nonneg : 0 ≤ 16 * (K : ℝ) := by positivity
      have h_half : (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [← Complex.mul_cpow_ofReal_nonneg h1_nonneg h2_nonneg, h_half,
        Complex.ofReal_cpow h3_nonneg (1 / 2 : ℝ)]
      congr 1
      push_cast
      field_simp [hT_r]
    change ((1 / T : ℝ) : ℂ) ^ (1 / 2 : ℂ) * (∑' n : ℤ, Complex.exp (-Real.pi * a * (n : ℂ) ^ 2)) = _
    rw [h_quad_a]
    simp_rw [h_inv_eq]
    rw [h_quad_d']
    simp_rw [h_d_term]
    rw [← mul_assoc (1 / a ^ (1 / 2 : ℂ)), ← mul_assoc, h_prefactor]
  obtain ⟨K, hm_eq⟩ := hdvd
  let c : ℕ := d.natAbs
  have hc_pos : 0 < c := Int.natAbs_pos.mpr hd
  have hK_pos : 0 < K := by
    by_contra hK0
    have : K = 0 := by omega
    subst this
    omega
  let r₀ : ℝ := (16 * (K : ℝ)) ^ (1 / 2 : ℝ)
  have hr₀_pos : 0 < r₀ := Real.rpow_pos_of_pos (by positivity) (1 / 2 : ℝ)
  have h_base :
      ratIntGaussSum (8 * K) 1 = (r₀ : ℂ) * Complex.exp (Real.pi * Complex.I / 4) := by
    let f_lhs : ℝ → ℂ := fun T =>
      ∑ z : Fin (8 * K),
        Complex.exp (2 * Real.pi * Complex.I * ((z : ℕ) : ℂ) ^ 2 / ((8 * K : ℕ) : ℂ)) *
