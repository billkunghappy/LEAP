    have h_term : ∀ q : ℤ,
        F (e (z, q)) =
          Complex.exp (2 * Real.pi * Complex.I * ((z : ℕ) : ℂ) ^ 2 / ((8 * K : ℕ) : ℂ)) *
            (Complex.exp (-Real.pi * ((z : ℕ) : ℂ) ^ 2 / (64 * (K : ℂ) ^ 2 * (T : ℂ))) *
              Complex.exp (-Real.pi * a₁ * (q : ℂ) ^ 2 + 2 * Real.pi * b₁ * (q : ℂ))) := by
      intro q
      have he : e (z, q) = q * (N : ℤ) + ((z : ℕ) : ℤ) := by
        dsimp [e]
      dsimp [F]
      rw [he]
      let k : ℤ := 2 * ((z : ℕ) : ℤ) * q + 8 * (K : ℤ) * q ^ 2
      have h_exp :
          -Real.pi * a * ((q * (N : ℤ) + ((z : ℕ) : ℤ) : ℤ) : ℂ) ^ 2 =
            2 * Real.pi * Complex.I * ((z : ℕ) : ℂ) ^ 2 / ((8 * K : ℕ) : ℂ) +
