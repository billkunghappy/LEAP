    have ha₁_re : 0 < a₁.re := by
      change 0 < (1 / T : ℝ)
      positivity
    have ha₁_ne : a₁ ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at ha₁_re
      exact lt_irrefl 0 ha₁_re
    have ha₁_cpow_ne : a₁ ^ (1 / 2 : ℂ) ≠ 0 := by
      rw [Complex.cpow_def_of_ne_zero ha₁_ne]
