    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v, if_pos h2v]
      exact (h_loc v h2v).1
    · rw [if_neg h2v, if_neg h2v, if_neg h2v]
      simp
  let uToC : ℤˣ →* ℂ := (Int.castRingHom ℂ).toMonoidHom.comp (Units.coeHom ℤ)
  let rToC : ℝ →* ℂ := Complex.ofRealHom.toMonoidHom
  have h_map_u : (∏ᶠ v, f_uC v) = ((unitDyadicProd α β : ℤ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod uToC (hfin2.subset h_supp_u)).symm
    exact h1
  have h_map_w : (∏ᶠ v, f_wC v) = ((∏ᶠ v, f_w v : ℝ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod rToC (hfin2.subset h_supp_w)).symm
    exact h1
  have hW_pos : 0 < (∏ᶠ v, f_w v) := by
    rw [finprod_eq_prod f_w (hfin2.subset h_supp_w)]
    refine Finset.prod_pos (fun v _ => ?_)
    dsimp [f_w]
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos h2v]
      exact (h_loc v h2v).2
    · rw [if_neg h2v]
      exact zero_lt_one
  have h_pf_eq : dyadicPfisterGaussSum α β =
      ((unitDyadicProd α β : ℤ) : ℝ) * (∏ᶠ v, f_w v) := by
    rw [dyadicPfisterGaussSum_eq_re_finprod_local α β, h_prod_congr,
      finprod_mul_distrib h_supp_uC h_supp_wC, h_map_u, h_map_w]
    rw [← Complex.ofReal_intCast (unitDyadicProd α β : ℤ), ← Complex.ofReal_mul, Complex.ofReal_re]
  dsimp only [dyadicGaussSign]
  rw [h_pf_eq]
  rcases Int.units_eq_one_or (unitDyadicProd α β) with hu | hu
  · rw [hu]
    have hpos : 0 < (((1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v) := by
      simpa using hW_pos
    rw [if_pos hpos]
  · rw [hu]
    have hnotpos : ¬ (0 < (((-1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v)) := by
      have hneg : (((-1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v) = -(∏ᶠ v, f_w v) := by simp
      rw [hneg]
      linarith
    rw [if_neg hnotpos]

theorem realSignProd_eq_archPfisterSign {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) :
    realSignProd α β = archPfisterSign α β :=
by
  letI := Classical.propDecidable
  let e : NumberField.InfinitePlace K → ℕ := fun w =>
    if w.IsReal ∧
        (w.embedding (algebraMap (NumberField.RingOfIntegers K) K α)).re < 0 ∧
        (w.embedding (algebraMap (NumberField.RingOfIntegers K) K β)).re < 0 then 1 else 0
  have h_sum : pfisterSignature α β = 4 * ∑ w : NumberField.InfinitePlace K, e w := by
    dsimp [pfisterSignature, realEmbedSign, e]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · by_cases hα : (w.embedding (algebraMap (NumberField.RingOfIntegers K) K α)).re < 0
      · by_cases hβ : (w.embedding (algebraMap (NumberField.RingOfIntegers K) K β)).re < 0
        · simp [hw, hα, hβ]
        · simp [hw, hα, hβ]
      · simp [hw, hα]
    · simp [hw]
  have h_div : pfisterSignature α β / 4 = ∑ w : NumberField.InfinitePlace K, e w := by
    rw [h_sum, Nat.mul_div_right _ (Nat.succ_pos 3)]
  dsimp [archPfisterSign, realSignProd]
  rw [h_div, ← Finset.prod_pow_eq_pow_sum]
  refine Finset.prod_congr rfl (fun w _ => ?_)
  dsimp [e]
  split_ifs <;> rfl

theorem traceGaussSum_mul_oddPfisterModulus {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (γ : NumberField.RingOfIntegers K) :
    traceGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) γ =
      traceGaussSum (dyadicGaussModulus K) γ *
        traceGaussSum (oddPfisterModulus α β)
          ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * γ) :=
by
  let R := NumberField.RingOfIntegers K
  let M : ℕ := dyadicGaussModulus K
  let n : ℕ := (Algebra.norm ℤ (α * β)).natAbs
  let D₀ : ℕ := (oddPartNat n) ^ (Module.finrank ℚ K + 1)
  let D : ℕ := oddPfisterModulus α β
  have hD_sq : D = D₀ ^ 2 := by
    dsimp [D, D₀, oddPfisterModulus, n]
    have h_exp : 2 * Module.finrank ℚ K + 2 = (Module.finrank ℚ K + 1) * 2 := by ring
    rw [h_exp, pow_mul]
  have h2_norm_eq : (Algebra.norm ℤ (2 : R)).natAbs =
      2 ^ Fintype.card (Module.Free.ChooseBasisIndex ℤ R) := by
    have h_alg : (2 : R) = algebraMap ℤ R (2 : ℤ) := by simp
    have h_norm := Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K) (2 : ℤ)
    rw [← h_alg] at h_norm
    have h_abs := congr_arg Int.natAbs h_norm
    rw [Int.natAbs_pow] at h_abs
    exact h_abs
  have h2_norm_pos : 0 < (Algebra.norm ℤ (2 : R)).natAbs := by
    rw [h2_norm_eq]
    exact pow_pos Nat.zero_lt_two _
  have hM_pos : 0 < M := Nat.mul_pos (Nat.succ_pos 7) (pow_pos h2_norm_pos 2)
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : n ≠ 0 := by
    dsimp [n]
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat n := Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos _
  have hMD_pos : 0 < M * D := Nat.mul_pos hM_pos hD_pos
  have h_not_dvd : ¬ 2 ∣ oddPartNat n := Nat.not_dvd_ordCompl Nat.prime_two hn_ne
  have h_cop2 : Nat.Coprime 2 (oddPartNat n) :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr h_not_dvd
  have h_cop_M_odd : Nat.Coprime M (oddPartNat n) := by
    dsimp [M, dyadicGaussModulus]
    rw [h2_norm_eq]
    have h8 : (8 : ℕ) = 2 ^ 3 := rfl
    rw [h8]
    exact Nat.Coprime.mul_left (h_cop2.pow_left 3) ((h_cop2.pow_left _).pow_left 2)
  have h_cop : Nat.Coprime M D₀ := h_cop_M_odd.pow_right (Module.finrank ℚ K + 1)
  let IM : Ideal R := Ideal.span {(M : R)}
  let ID : Ideal R := Ideal.span {(D : R)}
  let IMD : Ideal R := Ideal.span {((M * D : ℕ) : R)}
  have hIM : IM ≠ ⊥ :=
    mt Ideal.span_singleton_eq_bot.mp (Nat.cast_ne_zero.mpr (ne_of_gt hM_pos))
  have hID : ID ≠ ⊥ :=
    mt Ideal.span_singleton_eq_bot.mp (Nat.cast_ne_zero.mpr (ne_of_gt hD_pos))
  have hIMD : IMD ≠ ⊥ :=
    mt Ideal.span_singleton_eq_bot.mp (Nat.cast_ne_zero.mpr (ne_of_gt hMD_pos))
  haveI : Finite (R ⧸ IM) := Ideal.finiteQuotientOfFreeOfNeBot IM hIM
  letI : Fintype (R ⧸ IM) := Fintype.ofFinite (R ⧸ IM)
  haveI : Finite (R ⧸ ID) := Ideal.finiteQuotientOfFreeOfNeBot ID hID
  letI : Fintype (R ⧸ ID) := Fintype.ofFinite (R ⧸ ID)
  haveI : Finite (R ⧸ IMD) := Ideal.finiteQuotientOfFreeOfNeBot IMD hIMD
  letI : Fintype (R ⧸ IMD) := Fintype.ofFinite (R ⧸ IMD)
  let a : ℤ := M.gcdA D₀
  let b : ℤ := M.gcdB D₀
  have h_bez_Z : (1 : ℤ) = (M : ℤ) * a + (D₀ : ℤ) * b := by
    have h := Nat.gcd_eq_gcd_ab M D₀
    rw [h_cop.gcd_eq_one] at h
    exact h
  have h_bez : (M : R) * (a : R) + (D₀ : R) * (b : R) = 1 := by
    have h := congr_arg (Int.cast : ℤ → R) h_bez_Z.symm
    push_cast at h
    exact h
  have h_Db : (D₀ : R) * (b : R) = 1 - (M : R) * (a : R) := by
    linear_combination h_bez
  have hD_R : (D : R) = (D₀ : R) ^ 2 := by exact_mod_cast hD_sq
  have hMD_R : ((M * D : ℕ) : R) = (M : R) * (D : R) := Nat.cast_mul M D
  let u₁ : R := (D₀ : R) * (b : R) ^ 2
  let a' : R := 3 * (a : R) - 3 * (M : R) * (a : R) ^ 2 + (M : R) ^ 2 * (a : R) ^ 3
  have h_bez3 : (D : R) * (b : R) * u₁ + (M : R) * a' = 1 := by
    dsimp [u₁, a']
    calc (D : R) * (b : R) * ((D₀ : R) * (b : R) ^ 2) +
            (M : R) * (3 * (a : R) - 3 * (M : R) * (a : R) ^ 2 + (M : R) ^ 2 * (a : R) ^ 3)
      _ = ((D₀ : R) * (b : R)) ^ 3 +
            (M : R) * (3 * (a : R) - 3 * (M : R) * (a : R) ^ 2 + (M : R) ^ 2 * (a : R) ^ 3) := by
          rw [hD_R]; ring
      _ = (1 - (M : R) * (a : R)) ^ 3 +
            (M : R) * (3 * (a : R) - 3 * (M : R) * (a : R) ^ 2 + (M : R) ^ 2 * (a : R) ^ 3) := by
          rw [h_Db]
      _ = 1 := by ring
  have h_bez2 : (D : R) ^ 2 * (b : R) ^ 2 =
      (D : R) + (M : R) * (D : R) * ((M : R) * (a : R) ^ 2 - 2 * (a : R)) := by
    calc (D : R) ^ 2 * (b : R) ^ 2
      _ = (D : R) * ((D₀ : R) * (b : R)) ^ 2 := by rw [hD_R]; ring
      _ = (D : R) * (1 - (M : R) * (a : R)) ^ 2 := by rw [h_Db]
      _ = (D : R) + (M : R) * (D : R) * ((M : R) * (a : R) ^ 2 - 2 * (a : R)) := by ring
  let Φ : (R ⧸ IM) × (R ⧸ ID) ≃ (R ⧸ IMD) :=
    { toFun := fun p =>
        Ideal.Quotient.mk IMD ((D : R) * (b : R) * Quotient.out p.1 + (M : R) * Quotient.out p.2)
      invFun := fun z =>
        (Ideal.Quotient.mk IM (u₁ * Quotient.out z),
         Ideal.Quotient.mk ID (a' * Quotient.out z))
      left_inv := by
        rintro ⟨x₁, x₂⟩
        dsimp only
        have h_mk : Ideal.Quotient.mk IMD
            (Quotient.out (Ideal.Quotient.mk IMD
              ((D : R) * (b : R) * Quotient.out x₁ + (M : R) * Quotient.out x₂))) =
            Ideal.Quotient.mk IMD
              ((D : R) * (b : R) * Quotient.out x₁ + (M : R) * Quotient.out x₂) :=
          Ideal.Quotient.mk_out _
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp
          ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h_mk)
        rw [hMD_R] at hc
        refine Prod.ext ?_ ?_
        · refine Eq.trans ?_ (Ideal.Quotient.mk_out x₁)
          apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
          refine Ideal.mem_span_singleton.mpr ⟨-a' * Quotient.out x₁ +
            u₁ * (Quotient.out x₂ + (D : R) * c), ?_⟩
          linear_combination u₁ * hc + (Quotient.out x₁) * h_bez3
        · refine Eq.trans ?_ (Ideal.Quotient.mk_out x₂)
          apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
          refine Ideal.mem_span_singleton.mpr ⟨a' * (b : R) * Quotient.out x₁ -
            (b : R) * u₁ * Quotient.out x₂ + a' * (M : R) * c, ?_⟩
          linear_combination a' * hc + (Quotient.out x₂) * h_bez3
      right_inv := by
        intro z
        dsimp only
        have h_mk1 : Ideal.Quotient.mk IM
            (Quotient.out (Ideal.Quotient.mk IM (u₁ * Quotient.out z))) =
            Ideal.Quotient.mk IM (u₁ * Quotient.out z) :=
          Ideal.Quotient.mk_out _
        have h_mk2 : Ideal.Quotient.mk ID
            (Quotient.out (Ideal.Quotient.mk ID (a' * Quotient.out z))) =
            Ideal.Quotient.mk ID (a' * Quotient.out z) :=
          Ideal.Quotient.mk_out _
        obtain ⟨c₁, hc₁⟩ := Ideal.mem_span_singleton.mp
          ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h_mk1)
        obtain ⟨c₂, hc₂⟩ := Ideal.mem_span_singleton.mp
          ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h_mk2)
        refine Eq.trans ?_ (Ideal.Quotient.mk_out z)
        apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
        refine Ideal.mem_span_singleton.mpr ⟨(b : R) * c₁ + c₂, ?_⟩
        rw [hMD_R]
        linear_combination (D : R) * (b : R) * hc₁ + (M : R) * hc₂ + (Quotient.out z) * h_bez3 }
  have h_tr_nat : ∀ (m : ℕ) (x : R),
      Algebra.trace ℤ R ((m : R) * x) = (m : ℤ) * Algebra.trace ℤ R x := by
    intro m x
    rw [← nsmul_eq_mul, map_nsmul, nsmul_eq_mul]
  have hM_C : (M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hM_pos)
  have hD_C : (D : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  dsimp only [traceGaussSum]
  rw [dif_pos hIMD, dif_pos hIM, dif_pos hID]
  rw [← Equiv.sum_comp Φ, Fintype.sum_prod_type, Finset.sum_mul_sum]
  refine Finset.sum_congr rfl (fun x₁ _ => Finset.sum_congr rfl (fun x₂ _ => ?_))
  let r₁ : R := Quotient.out x₁
  let r₂ : R := Quotient.out x₂
  let r : R := Quotient.out (Φ (x₁, x₂))
  have h_mk : Ideal.Quotient.mk IMD r =
      Ideal.Quotient.mk IMD ((D : R) * (b : R) * r₁ + (M : R) * r₂) :=
    Ideal.Quotient.mk_out (Φ (x₁, x₂))
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp
    ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h_mk)
  have hr : r = (D : R) * (b : R) * r₁ + (M : R) * r₂ + (M : R) * (D : R) * c := by
    rw [hMD_R] at hc
    linear_combination hc
  let w : R := ((M : R) * (a : R) ^ 2 - 2 * (a : R)) * (γ * r₁ ^ 2) +
    2 * (b : R) * γ * r₁ * r₂ +
    γ * c * (2 * ((D : R) * (b : R) * r₁ + (M : R) * r₂) + (M : R) * (D : R) * c)
  have h_quad : γ * r ^ 2 =
      (D : R) * (γ * r₁ ^ 2) + (M : R) * ((M : R) * γ * r₂ ^ 2) + ((M * D : ℕ) : R) * w := by
    dsimp [w]
    rw [hr, hMD_R]
    linear_combination (γ * r₁ ^ 2) * h_bez2
  have h_tr : Algebra.trace ℤ R (γ * r ^ 2) =
      (D : ℤ) * Algebra.trace ℤ R (γ * r₁ ^ 2) +
      (M : ℤ) * Algebra.trace ℤ R ((M : R) * γ * r₂ ^ 2) +
      ((M * D : ℕ) : ℤ) * Algebra.trace ℤ R w := by
    rw [h_quad, map_add, map_add, h_tr_nat, h_tr_nat, h_tr_nat]
  let T₁ : ℤ := Algebra.trace ℤ R (γ * r₁ ^ 2)
  let T₂ : ℤ := Algebra.trace ℤ R ((M : R) * γ * r₂ ^ 2)
  let Tw : ℤ := Algebra.trace ℤ R w
  have h_exp_eq :
      2 * (Real.pi : ℂ) * Complex.I * ((Algebra.trace ℤ R (γ * r ^ 2) : ℤ) : ℂ) / ((M * D : ℕ) : ℂ) =
      (2 * (Real.pi : ℂ) * Complex.I * (T₁ : ℂ) / (M : ℂ) +
       2 * (Real.pi : ℂ) * Complex.I * (T₂ : ℂ) / (D : ℂ)) +
      (Tw : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    change 2 * (Real.pi : ℂ) * Complex.I * ((Algebra.trace ℤ R (γ * r ^ 2) : ℤ) : ℂ) / ((M * D : ℕ) : ℂ) =
      (2 * (Real.pi : ℂ) * Complex.I * (T₁ : ℂ) / (M : ℂ) +
       2 * (Real.pi : ℂ) * Complex.I * (T₂ : ℂ) / (D : ℂ)) +
      (Tw : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)
    rw [h_tr]
    dsimp [T₁, T₂, Tw]
    push_cast
    field_simp [hM_C, hD_C]
  change Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
      ((Algebra.trace ℤ R (γ * r ^ 2) : ℤ) : ℂ) / ((M * D : ℕ) : ℂ)) =
    Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (T₁ : ℂ) / (M : ℂ)) *
    Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (T₂ : ℂ) / (D : ℂ))
  rw [h_exp_eq, Complex.exp_add, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

theorem traceGaussSum_oddPfisterModulus_mul_dyadicGaussModulus_eq_pfisterGaussSum {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal)) :
    traceGaussSum (oddPfisterModulus α β)
        ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * 1) *
      traceGaussSum (oddPfisterModulus α β)
        ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (-α)) *
      traceGaussSum (oddPfisterModulus α β)
        ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (-β)) *
      traceGaussSum (oddPfisterModulus α β)
        ((dyadicGaussModulus K : NumberField.RingOfIntegers K) * (α * β)) =
      (pfisterGaussSum (oddPfisterModulus α β) α β : ℂ) :=
by
  have h_s1 :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ∀ (γ c : NumberField.RingOfIntegers K),
          γ ∉ v.asIdeal → c ∉ v.asIdeal →
          ∀ (k : ℕ), ∃ x y : NumberField.RingOfIntegers K,
            x ^ 2 - γ * y ^ 2 - c ∈ v.asIdeal ^ k := by
    intro v h2v γ c hγ hc k
    let R := NumberField.RingOfIntegers K
    haveI : v.asIdeal.IsMaximal := v.isMaximal
    haveI : v.asIdeal.IsPrime := v.isPrime
    let F := R ⧸ v.asIdeal
    letI := Classical.decEq F
    letI : Field F := Ideal.Quotient.field v.asIdeal
    haveI : Finite F := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    letI : Fintype F := Fintype.ofFinite F
    let q : R →+* F := Ideal.Quotient.mk v.asIdeal
    have hγ_bar : q γ ≠ 0 := Ideal.Quotient.eq_zero_iff_mem.not.mpr hγ
    have h_mod1 : ∃ x₀ y₀ : R, x₀ ^ 2 - γ * y₀ ^ 2 - c ∈ v.asIdeal := by
      let f : F → F := fun x => x ^ 2
      let Sq : Finset F := Finset.univ.image f
      let U : Finset F := Finset.univ.erase 0
      have hU_card : U.card ≤ 2 * (U.image f).card := by
        refine Finset.card_le_mul_card_image U 2 (fun w hw => ?_)
        obtain ⟨x₀, _, rfl⟩ := Finset.mem_image.mp hw
        refine le_trans (Finset.card_le_card (s := {a ∈ U | f a = f x₀})
          (t := {x₀, -x₀}) ?_) (Finset.card_le_two)
        intro x hx
        rw [Finset.mem_filter] at hx
        rw [Finset.mem_insert, Finset.mem_singleton]
        exact sq_eq_sq_iff_eq_or_eq_neg.mp hx.2
      have h0_not_mem : (0 : F) ∉ U.image f := by
        intro h0
        obtain ⟨x, hxU, hx0⟩ := Finset.mem_image.mp h0
        exact (Finset.mem_erase.mp hxU).1 (eq_zero_of_pow_eq_zero hx0)
      have hSq_eq : Sq = insert (0 : F) (U.image f) := by
        change Finset.univ.image f = insert (0 : F) (U.image f)
        have huniv : (Finset.univ : Finset F) = insert 0 U :=
          (Finset.insert_erase (Finset.mem_univ (0 : F))).symm
        rw [huniv, Finset.image_insert]
        simp [f]
      have hSq_card : Sq.card = (U.image f).card + 1 := by
        rw [hSq_eq, Finset.card_insert_of_notMem h0_not_mem]
      have huniv_card : Fintype.card F = U.card + 1 :=
        (Finset.card_erase_add_one (Finset.mem_univ (0 : F))).symm
      let g : F → F := fun z => q c + q γ * z
      have hg_inj : Function.Injective g := by
        intro z₁ z₂ hz
        exact mul_right_injective₀ hγ_bar (add_left_cancel hz)
      let s₂ : Finset F := Sq.image g
      have hs₂_card : s₂.card = Sq.card := Finset.card_image_of_injective Sq hg_inj
      have h_union : (Sq ∪ s₂).card ≤ Fintype.card F := Finset.card_le_univ (Sq ∪ s₂)
