      _ = n := by simp [n]
  have hn_lt_L : n < L := by
    have h1 : n < 2 ^ n := Nat.lt_two_pow_self
    have h2 : 2 ^ n ≤ 2 ^ M := Nat.pow_le_pow_right (by omega) (by omega)
    have h3 : 2 ^ M ≤ p ^ M := Nat.pow_le_pow_left hp.two_le M
    exact lt_of_lt_of_le h1 (le_trans h2 h3)
  have hk_not_dvd : ¬ (L ∣ k) :=
    Nat.not_dvd_of_pos_of_lt hd_pos (lt_of_le_of_lt hk_le_n hn_lt_L)
  have hk_ne_zero : (k : ZMod L) ≠ 0 := by
    rwa [ne_eq, ZMod.natCast_eq_zero_iff]
  have h_tr_eq : ((Algebra.trace ℤ R e : ℤ) : ZMod L) = A_bar.trace := by
    rw [Algebra.trace_eq_matrix_trace b e]
    simp [A_bar, πL, A, Matrix.trace]
    rfl
  have h_not_dvd_tr : ¬ (((L : ℕ) : ℤ) ∣ Algebra.trace ℤ R e) := by
    intro h_dvd
    have h_cast_zero : ((Algebra.trace ℤ R e : ℤ) : ZMod L) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (Algebra.trace ℤ R e) L).mpr h_dvd
    rw [h_tr_eq, h_tr_A_bar] at h_cast_zero
    exact hk_ne_zero h_cast_zero
  intro h_triv
  have h_exp := h_triv ((p ^ (a - 1) : ℕ) : R) hx0_mem
  obtain ⟨m_int, hm_int⟩ := Complex.exp_eq_one_iff.mp h_exp
  have hD_C_ne : (D : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hD_pos)
  have h2piI_ne : (2 : ℂ) * Real.pi * Complex.I ≠ 0 :=
    mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
      Complex.I_ne_zero
  have hm_mul : 2 * (Real.pi : ℂ) * Complex.I *
      ((Algebra.trace ℤ R (e * 1 * ((p ^ (a - 1) : ℕ) : R)) : ℤ) : ℂ) =
      (2 * (Real.pi : ℂ) * Complex.I) * ((m_int * (D : ℤ) : ℤ) : ℂ) := by
    rw [div_eq_iff hD_C_ne] at hm_int
    calc 2 * (Real.pi : ℂ) * Complex.I *
          ((Algebra.trace ℤ R (e * 1 * ((p ^ (a - 1) : ℕ) : R)) : ℤ) : ℂ)
      _ = ↑m_int * (2 * ↑Real.pi * Complex.I) * ↑D := hm_int
      _ = (2 * (Real.pi : ℂ) * Complex.I) * ((m_int * (D : ℤ) : ℤ) : ℂ) := by
          push_cast; ring
  have hm_cast := mul_left_cancel₀ h2piI_ne hm_mul
  have hm_eq : Algebra.trace ℤ R (e * 1 * ((p ^ (a - 1) : ℕ) : R)) = (D : ℤ) * m_int := by
    have h_inj := Int.cast_injective hm_cast
    rw [h_inj, mul_comm]
  have hD_dvd_tr : (D : ℤ) ∣ Algebra.trace ℤ R (e * 1 * ((p ^ (a - 1) : ℕ) : R)) :=
    ⟨m_int, hm_eq⟩
  have h_tr_smul : Algebra.trace ℤ R (e * 1 * ((p ^ (a - 1) : ℕ) : R)) =
      ((p ^ (a - 1) : ℕ) : ℤ) * Algebra.trace ℤ R e := by
    have h_arg : e * 1 * ((p ^ (a - 1) : ℕ) : R) = (p ^ (a - 1) : ℕ) • e := by
      rw [mul_one, mul_comm, nsmul_eq_mul]
    rw [h_arg, map_nsmul, nsmul_eq_mul]
  rw [h_tr_smul] at hD_dvd_tr
  have h_pL_dvd_D : (((p ^ (a - 1) : ℕ) : ℤ) * ((L : ℕ) : ℤ)) ∣ (D : ℤ) := by
    rw [← Nat.cast_mul]
    exact Int.ofNat_dvd.mpr hdvd_D
  have h_pL_dvd_tr : (((p ^ (a - 1) : ℕ) : ℤ) * ((L : ℕ) : ℤ)) ∣
      ((p ^ (a - 1) : ℕ) : ℤ) * Algebra.trace ℤ R e :=
    dvd_trans h_pL_dvd_D hD_dvd_tr
  have hp_pow_ne : ((p ^ (a - 1) : ℕ) : ℤ) ≠ 0 := by
    have hp_pos : 0 < p := hp.pos
    positivity
  have hL_dvd_tr : ((L : ℕ) : ℤ) ∣ Algebra.trace ℤ R e :=
    (mul_dvd_mul_iff_left hp_pow_ne).mp h_pL_dvd_tr
  exact h_not_dvd_tr hL_dvd_tr

theorem exists_hasLocalModulusConductor_one_and_sub {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α : NumberField.RingOfIntegers K) (hα : α ≠ 0)
    (h_nontriv : 1 ≤ valNat v α → ¬ IsLocalModulusCharTrivialOnPow m v 1 (valNat v α - 1)) :
    ∃ c₀ : ℕ,
      valNat v α ≤ c₀ ∧
      HasLocalModulusConductor m v 1 c₀ ∧
      HasLocalModulusConductor m v α (c₀ - valNat v α) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let kv : ℕ := valNat v (m : R)
  let a : ℕ := valNat v α
  let I : Ideal R := Ideal.span {(m : R)}
  let Iv : Ideal R := v.asIdeal ^ kv
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 →
        v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have exists_factor_coprime :
      ∀ (x : R), x ≠ 0 →
        ∃ J : Ideal R,
          Ideal.span {x} = v.asIdeal ^ (valNat v x) * J ∧
          IsCoprime J v.asIdeal := by
    intro x hx
    let nx : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(nx : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ nx ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x nx).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (nx + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le : v.intValuation x ≤ WithZero.exp (-((nx + 1 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem x (nx + 1)).mpr hx_mem
      rw [hx_val, WithZero.exp_le_exp] at hx_le
      omega
    have h_coprime_1 : IsCoprime J v.asIdeal := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      have h_eq : v.asIdeal = J ⊔ v.asIdeal :=
        v.isMaximal.eq_of_le h_ne_top le_sup_right
      have h_le : J ≤ v.asIdeal := h_eq.symm ▸ le_sup_left
      exact hJ_not_le h_le
    exact ⟨J, hJ, h_coprime_1⟩
  have hm_ne : (m : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hm)
  obtain ⟨Jm, hJm, hJm_cop⟩ := exists_factor_coprime (m : R) hm_ne
  obtain ⟨e₀, he₀Jm, a₀, ha₀Iv, he₀a₀⟩ :=
    Ideal.isCoprime_iff_exists.mp (hJm_cop.pow_right : IsCoprime Jm Iv)
  have he_ex : ∃ e : R, IsLocalModulusIdempotent m v e := by
    refine ⟨e₀, ?_, ?_⟩
    · have hid : 1 - e₀ = a₀ := by linear_combination -he₀a₀
      rw [hid]
      exact ha₀Iv
    · intro y hy
      have hey : e₀ * y ∈ Iv * Jm := by
        rw [mul_comm e₀ y]
        exact Ideal.mul_mem_mul hy he₀Jm
      rw [← hJm] at hey
      exact hey
  have h_idem : IsLocalModulusIdempotent m v (localModulusIdempotent m v) := by
    dsimp only [localModulusIdempotent]
    rw [dif_pos he_ex]
    exact Classical.choose_spec he_ex
  let e : R := localModulusIdempotent m v
  let f : R → ℂ := fun r =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R r : ℤ) : ℂ) / (m : ℂ))
  have hf_add : ∀ r₁ r₂ : R, f (r₁ + r₂) = f r₁ * f r₂ := by
    intro r₁ r₂
    dsimp only [f]
    rw [map_add, Int.cast_add, ← Complex.exp_add]
    congr 1
    ring
  have hf_zero : f 0 = 1 := by
    dsimp only [f]
    rw [map_zero, Int.cast_zero, mul_zero, zero_div, Complex.exp_zero]
  have hmc_ne : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hm)
  have hf_per : ∀ r₁ r₂ : R, r₁ - r₂ ∈ I → f r₁ = f r₂ := by
    intro r₁ r₂ hmem
    rw [Ideal.mem_span_singleton] at hmem
    rcases hmem with ⟨q, hq⟩
    have hr₁ : r₁ = r₂ + m • q := by
      rw [nsmul_eq_mul, ← hq, add_sub_cancel]
    rw [hr₁, hf_add]
    have hfmq : f (m • q) = 1 := by
      dsimp only [f]
      rw [map_nsmul, nsmul_eq_mul]
      have hexp :
          2 * (Real.pi : ℂ) * Complex.I *
            ((((m : ℤ) * Algebra.trace ℤ R q : ℤ) : ℂ)) / (m : ℂ) =
          ((Algebra.trace ℤ R q : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast
        field_simp [hmc_ne]
      rw [hexp]
      exact Complex.exp_int_mul_two_pi_mul_I (Algebra.trace ℤ R q)
    rw [hfmq, mul_one]
  have h_triv_kv : IsLocalModulusCharTrivialOnPow m v 1 kv := by
    intro z hz
    change f (e * 1 * z) = 1
    rw [← hf_zero]
    apply hf_per (e * 1 * z) 0
    have h_eq : e * 1 * z - 0 = e * z := by ring
    rw [h_eq]
    exact h_idem.2 z hz
  have hα_mem : α ∈ v.asIdeal ^ a :=
    (v.intValuation_le_pow_iff_mem α a).mp
      (le_of_eq (intValuation_eq_exp_neg_valNat α hα))
  obtain ⟨Jα, hJα, hJα_cop⟩ := exists_factor_coprime α hα
  obtain ⟨j, hjJα, i, hiIv, hji⟩ :=
    Ideal.isCoprime_iff_exists.mp (hJα_cop.pow_right : IsCoprime Jα Iv)
  have h_shift : ∀ c : ℕ,
      IsLocalModulusCharTrivialOnPow m v 1 (c + a) ↔
        IsLocalModulusCharTrivialOnPow m v α c := by
    intro c
    constructor
    · intro h1 z hz
      change f (e * α * z) = 1
      have hαz_mem : α * z ∈ v.asIdeal ^ (c + a) := by
        rw [mul_comm α z, pow_add]
        exact Ideal.mul_mem_mul hz hα_mem
      have h_eq : e * α * z = e * 1 * (α * z) := by ring
      rw [h_eq]
      exact h1 (α * z) hαz_mem
    · intro hα_triv x hx
      change f (e * 1 * x) = 1
      have hx_a : x ∈ v.asIdeal ^ a := Ideal.pow_le_pow_right (by omega) hx
      have hxj_span : x * j ∈ Ideal.span {α} := by
        rw [hJα]
        exact Ideal.mul_mem_mul hx_a hjJα
      obtain ⟨z, hz_eq⟩ := Ideal.mem_span_singleton.mp hxj_span
      have hz_mem : z ∈ v.asIdeal ^ c := by
        by_cases hz0 : z = 0
        · rw [hz0]
          exact (v.asIdeal ^ c).zero_mem
        · have hx_val : v.intValuation x ≤ WithZero.exp (-((c + a : ℕ) : ℤ)) :=
            (v.intValuation_le_pow_iff_mem x (c + a)).mpr hx
          have hj_val : v.intValuation j ≤ 1 := v.intValuation_le_one j
          have h_mul_val :
              WithZero.exp (-(a : ℤ) + -(valNat v z : ℤ)) ≤
                WithZero.exp (-((c + a : ℕ) : ℤ)) := by
            calc WithZero.exp (-(a : ℤ) + -(valNat v z : ℤ))
              _ = WithZero.exp (-(a : ℤ)) * WithZero.exp (-(valNat v z : ℤ)) :=
                  WithZero.exp_add (-(a : ℤ)) (-(valNat v z : ℤ))
              _ = v.intValuation α * v.intValuation z := by
                  rw [← intValuation_eq_exp_neg_valNat α hα,
                    ← intValuation_eq_exp_neg_valNat z hz0]
              _ = v.intValuation (α * z) := (map_mul v.intValuation α z).symm
              _ = v.intValuation (x * j) := by rw [hz_eq]
              _ = v.intValuation x * v.intValuation j := map_mul v.intValuation x j
              _ ≤ WithZero.exp (-((c + a : ℕ) : ℤ)) * 1 :=
                  mul_le_mul' hx_val hj_val
              _ = WithZero.exp (-((c + a : ℕ) : ℤ)) := mul_one _
          have h_exp_le : -(a : ℤ) + -(valNat v z : ℤ) ≤ -((c + a : ℕ) : ℤ) :=
            WithZero.exp_le_exp.mp h_mul_val
          have hz_val_le : v.intValuation z ≤ WithZero.exp (-(c : ℤ)) := by
            rw [intValuation_eq_exp_neg_valNat z hz0, WithZero.exp_le_exp]
            omega
          exact (v.intValuation_le_pow_iff_mem z c).mp hz_val_le
      have h_diff : (e * 1 * x) - (e * α * z) ∈ I := by
        have h_id : (e * 1 * x) - (e * α * z) = e * (x * i) := by
          linear_combination -(e * x) * hji + e * hz_eq
        rw [h_id]
        exact h_idem.2 (x * i) (Iv.mul_mem_left x hiIv)
      rw [hf_per (e * 1 * x) (e * α * z) h_diff]
      exact hα_triv z hz_mem
  have h_ex : ∃ c : ℕ, IsLocalModulusCharTrivialOnPow m v 1 c := ⟨kv, h_triv_kv⟩
  let c₀ : ℕ := Nat.find h_ex
  have hc0_le : c₀ ≤ kv := Nat.find_le h_triv_kv
  have hc0_triv : IsLocalModulusCharTrivialOnPow m v 1 c₀ := Nat.find_spec h_ex
  have hc0_min : ∀ c < c₀, ¬ IsLocalModulusCharTrivialOnPow m v 1 c :=
    fun c hc => Nat.find_min h_ex hc
  have ha_le_c0 : a ≤ c₀ := by
    by_contra h_not_le
    have ha1 : 1 ≤ a := by omega
    have hc0_le_pred : c₀ ≤ a - 1 := by omega
    have h_triv_pred : IsLocalModulusCharTrivialOnPow m v 1 (a - 1) := by
      intro z hz
      exact hc0_triv z (Ideal.pow_le_pow_right hc0_le_pred hz)
    exact h_nontriv ha1 h_triv_pred
  refine ⟨c₀, ha_le_c0, ?_, ?_⟩
  · refine ⟨hc0_le, hc0_triv, ?_⟩
    intro hc1
    exact hc0_min (c₀ - 1) (by omega)
  · refine ⟨by omega, ?_, ?_⟩
    · rw [← h_shift (c₀ - a), Nat.sub_add_cancel ha_le_c0]
      exact hc0_triv
    · intro hc_sub
      rw [← h_shift (c₀ - a - 1), show c₀ - a - 1 + a = c₀ - 1 by omega]
      exact hc0_min (c₀ - 1) (by omega)

theorem localModulusBinaryGaussSum_of_hasLocalModulusConductor_one {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (γ β : NumberField.RingOfIntegers K) (hβ_unit : β ∉ v.asIdeal)
    (h_cond : HasLocalModulusConductor m v γ 1) :
    localModulusBinaryGaussSum m v γ β =
      ((resQuadSym v β : ℤ) : ℂ) *
      ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^
        (2 * valNat v (m : NumberField.RingOfIntegers K) - 1) : ℂ) :=
by
  let R := NumberField.RingOfIntegers K
  let kv := valNat v (m : R)
  let Iv : Ideal R := v.asIdeal ^ kv
  let Av := R ⧸ Iv
  let Fv := R ⧸ v.asIdeal
  have hkv : 1 ≤ kv := h_cond.1
  have h_triv1 : IsLocalModulusCharTrivialOnPow m v γ 1 := h_cond.2.1
  have h_nontriv0 : ¬ IsLocalModulusCharTrivialOnPow m v γ 0 := h_cond.2.2 le_rfl
  have hIv : Iv ≠ ⊥ := pow_ne_zero kv v.ne_bot
  haveI : Finite Av := Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
  letI : Fintype Av := Fintype.ofFinite Av
  haveI : Finite Fv := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  letI : Fintype Fv := Fintype.ofFinite Fv
  letI : DecidableEq Av := Classical.decEq Av
  letI : DecidableEq Fv := Classical.decEq Fv
  let resSum : R → ℂ := fun δ =>
    ∑ x : Fv,
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R
          (localModulusIdempotent m v * γ * (δ * (Quotient.out x) ^ 2)) : ℤ) : ℂ) /
        (m : ℂ))
  let f : R → ℂ := fun r =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R (localModulusIdempotent m v * γ * r) : ℤ) : ℂ) / (m : ℂ))
  have hf_add : ∀ r1 r2 : R, f (r1 + r2) = f r1 * f r2 := by
    intro r1 r2
    dsimp only [f]
    rw [mul_add, map_add, Int.cast_add, ← Complex.exp_add]
    congr 1
    ring
  have hf_zero : f 0 = 1 := by
    dsimp only [f]
    simp
  have hf_congr : ∀ r1 r2 : R, r1 - r2 ∈ v.asIdeal → f r1 = f r2 := by
    intro r1 r2 hmem
    have hmem1 : r1 - r2 ∈ v.asIdeal ^ 1 := by
      rw [pow_one]
      exact hmem
    have h1 : f (r1 - r2) = 1 := h_triv1 (r1 - r2) hmem1
    have h_eq : r1 = r2 + (r1 - r2) := by ring
    calc f r1 = f (r2 + (r1 - r2)) := by rw [← h_eq]
      _ = f r2 * f (r1 - r2) := hf_add r2 (r1 - r2)
      _ = f r2 * 1 := by rw [h1]
      _ = f r2 := mul_one _
  have h_s1 : ∀ δ : R,
      localModulusTraceGaussSum m v (γ * δ) =
        ((Nat.card Fv : ℝ) ^ (kv - 1) : ℂ) * resSum δ := by
    intro δ
    have hle : Iv ≤ v.asIdeal := by
      calc Iv = v.asIdeal ^ kv := rfl
        _ ≤ v.asIdeal ^ 1 := Ideal.pow_le_pow_right hkv
        _ = v.asIdeal := pow_one v.asIdeal
    let π : Av →+* Fv := Ideal.Quotient.factor hle
    let V1 : Finset Av := Finset.univ.filter (fun x : Av => π x = 0)
    have h_fiber_card : ∀ b : Fv,
        (Finset.univ.filter (fun a : Av => π a = b)).card = V1.card := by
      intro b
      let xb : Av := Ideal.Quotient.mk Iv (Quotient.out b)
      have hπ_xb : π xb = b := by
        change Ideal.Quotient.factor hle (Ideal.Quotient.mk Iv (Quotient.out b)) = b
        rw [Ideal.Quotient.factor_mk hle, Ideal.Quotient.mk_out]
      symm
      refine Finset.card_bijective (Equiv.addRight xb) (Equiv.bijective _) (fun z => ?_)
      simp only [V1, Finset.mem_filter, Finset.mem_univ, true_and]
      change π z = 0 ↔ π (z + xb) = b
      rw [π.map_add, hπ_xb]
      exact ⟨fun h => by rw [h, zero_add], fun h => by linear_combination h⟩
    have h_card_Av_sum : Fintype.card Av = Nat.card Fv * V1.card := by
      have h1 : (Finset.univ : Finset Av).card =
          ∑ b ∈ (Finset.univ : Finset Fv),
            (Finset.univ.filter (fun a : Av => π a = b)).card :=
        Finset.card_eq_sum_card_fiberwise (fun a _ => Finset.mem_univ (π a))
      rw [← Finset.card_univ, h1]
      have h2 : ∑ b ∈ (Finset.univ : Finset Fv),
          (Finset.univ.filter (fun a : Av => π a = b)).card =
          ∑ _b ∈ (Finset.univ : Finset Fv), V1.card :=
        Finset.sum_congr rfl (fun b _ => h_fiber_card b)
      rw [h2, Finset.sum_const, Finset.card_univ, smul_eq_mul, ← Nat.card_eq_fintype_card]
    have h_card_Av_pow : Fintype.card Av = Nat.card Fv * (Nat.card Fv) ^ (kv - 1) := by
      have h1 : Fintype.card Av = (Nat.card Fv) ^ kv := by
        rw [← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply,
          map_pow, Ideal.absNorm_apply, Submodule.cardQuot_apply]
      have h2 : (Nat.card Fv) ^ kv = (Nat.card Fv) ^ (1 + (kv - 1)) := by
        congr 1
        omega
      rw [h1, h2, pow_add, pow_one]
    have hV1_card : V1.card = (Nat.card Fv) ^ (kv - 1) := by
      have hq_pos : 0 < Nat.card Fv := Nat.card_pos
      exact Nat.mul_left_cancel hq_pos (h_card_Av_sum.symm.trans h_card_Av_pow)
    have h_summand : ∀ b : Fv, ∀ x ∈ Finset.univ.filter (fun a : Av => π a = b),
        f (δ * (Quotient.out x) ^ 2) = f (δ * (Quotient.out b) ^ 2) := by
      intro b x hx
      rw [Finset.mem_filter] at hx
      have hπx : Ideal.Quotient.mk v.asIdeal (Quotient.out x) =
          Ideal.Quotient.mk v.asIdeal (Quotient.out b) := by
