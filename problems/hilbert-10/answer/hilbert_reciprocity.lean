    let N : ℕ := 2 * valNat v (2 : R) + 2
    have h_scaled : ∃ (X₁ Y₁ : v.adicCompletion K) (z₁ : R),
        Valued.v X₁ ≤ 1 ∧ Valued.v Y₁ ≤ 1 ∧ v.intValuation z₁ ≤ 1 ∧
        (Valued.v X₁ = 1 ∨ Valued.v Y₁ = 1 ∨ v.intValuation z₁ = 1) ∧
        X₁ ^ 2 - ι β * Y₁ ^ 2 - ι α * (ι z₁) ^ 2 = 0 := by
      by_cases h_le : Valued.v X ≤ 1 ∧ Valued.v Y ≤ 1
      · refine ⟨X, Y, 1, h_le.1, h_le.2, le_of_eq (map_one _), Or.inr (Or.inr (map_one _)), ?_⟩
        rw [map_one]
        linear_combination hXY
      · have h_gt : (1 : WithZero (Multiplicative ℤ)) < max (Valued.v X) (Valued.v Y) := by
          rcases not_and_or.mp h_le with hX | hY
          · exact lt_of_lt_of_le (not_le.mp hX) (le_max_left _ _)
          · exact lt_of_lt_of_le (not_le.mp hY) (le_max_right _ _)
        let M : WithZero (Multiplicative ℤ) := max (Valued.v X) (Valued.v Y)
        have hM_ne : M ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le' h_gt)
        have hlog_pos : 0 < WithZero.log M := by
          rw [← WithZero.exp_lt_exp, WithZero.exp_zero, WithZero.exp_log hM_ne]
          exact h_gt
        let n : ℕ := (WithZero.log M).toNat
        have hn_eq : (n : ℤ) = WithZero.log M := Int.toNat_of_nonneg (le_of_lt hlog_pos)
        have hM_exp : M = WithZero.exp (n : ℤ) := by
          rw [hn_eq, WithZero.exp_log hM_ne]
        obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
        have hπn_val : v.intValuation (π ^ n) = WithZero.exp (-(n : ℤ)) := by
          rw [map_pow, hπ, exp_neg_one_pow n]
        have hπn_F : Valued.v (ι (π ^ n)) = WithZero.exp (-(n : ℤ)) :=
          (valued_algebraMap_eq_intValuation v (π ^ n)).trans hπn_val
        have hM_mul : M * Valued.v (ι (π ^ n)) = 1 := by
          rw [hM_exp, hπn_F, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
        refine ⟨X * ι (π ^ n), Y * ι (π ^ n), π ^ n, ?_, ?_, ?_, ?_, ?_⟩
        · rw [map_mul, ← hM_mul]
          exact mul_le_mul' (le_max_left _ _) le_rfl
        · rw [map_mul, ← hM_mul]
          exact mul_le_mul' (le_max_right _ _) le_rfl
        · rw [hπn_val, ← WithZero.exp_zero, WithZero.exp_le_exp]
          omega
        · rcases max_choice (Valued.v X) (Valued.v Y) with hMX | hMY
          · left
            rw [map_mul, ← hMX, hM_mul]
          · right; left
            rw [map_mul, ← hMY, hM_mul]
        · change (X * ι (π ^ n)) ^ 2 - ι β * (Y * ι (π ^ n)) ^ 2 - ι α * (ι (π ^ n)) ^ 2 = 0
          linear_combination (ι (π ^ n)) ^ 2 * hXY
    obtain ⟨X₁, Y₁, z₁, hX₁_le, hY₁_le, hz₁_le, h_prim₁, h_eq₁⟩ := h_scaled
    obtain ⟨aX, bX, hbXv, haX_approx⟩ := exists_rat_approx_of_val_le_one v N X₁ hX₁_le
    obtain ⟨aY, bY, hbYv, haY_approx⟩ := exists_rat_approx_of_val_le_one v N Y₁ hY₁_le
    let x₀ : R := aX * bY
    let y₀ : R := aY * bX
    let z₀ : R := z₁ * bX * bY
    let B : v.adicCompletion K := ι bX * ι bY
    have hbX_val : Valued.v (ι bX) = 1 :=
      (valued_algebraMap_eq_intValuation v bX).trans (v.intValuation_eq_one_iff.mpr hbXv)
    have hbY_val : Valued.v (ι bY) = 1 :=
      (valued_algebraMap_eq_intValuation v bY).trans (v.intValuation_eq_one_iff.mpr hbYv)
    have hB_val : Valued.v B = 1 := by
      dsimp [B]; rw [map_mul, hbX_val, hbY_val, mul_one]
    have hexp_lt_one : WithZero.exp (-(N : ℤ)) < 1 := by
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
      dsimp [N]; omega
    have hx₀_diff : Valued.v (ι x₀ - B * X₁) ≤ WithZero.exp (-(N : ℤ)) := by
      have hid : ι x₀ - B * X₁ = (ι aX - ι bX * X₁) * ι bY := by
        dsimp [x₀, B]; simp only [map_mul]; ring
      rw [hid, map_mul, hbY_val, mul_one]
      exact haX_approx
    have hy₀_diff : Valued.v (ι y₀ - B * Y₁) ≤ WithZero.exp (-(N : ℤ)) := by
      have hid : ι y₀ - B * Y₁ = (ι aY - ι bY * Y₁) * ι bX := by
        dsimp [y₀, B]; simp only [map_mul]; ring
      rw [hid, map_mul, hbX_val, mul_one]
      exact haY_approx
    have hx₀_le : Valued.v (ι x₀) ≤ 1 := by
      have hid : ι x₀ = (ι x₀ - B * X₁) + B * X₁ := by ring
      rw [hid]
      refine (Valuation.map_add Valued.v _ _).trans (max_le (hx₀_diff.trans (le_of_lt hexp_lt_one)) ?_)
      rw [map_mul, hB_val, one_mul]
      exact hX₁_le
    have hy₀_le : Valued.v (ι y₀) ≤ 1 := by
      have hid : ι y₀ = (ι y₀ - B * Y₁) + B * Y₁ := by ring
      rw [hid]
      refine (Valuation.map_add Valued.v _ _).trans (max_le (hy₀_diff.trans (le_of_lt hexp_lt_one)) ?_)
      rw [map_mul, hB_val, one_mul]
      exact hY₁_le
    refine ⟨x₀, y₀, z₀, ?_, ?_⟩
    · rintro ⟨hx₀_m, hy₀_m, hz₀_m⟩
      have hx₀_lt : Valued.v (ι x₀) < 1 :=
        (valued_algebraMap_eq_intValuation v x₀).trans_lt
          ((v.intValuation_lt_one_iff_mem x₀).mpr hx₀_m)
      have hy₀_lt : Valued.v (ι y₀) < 1 :=
        (valued_algebraMap_eq_intValuation v y₀).trans_lt
          ((v.intValuation_lt_one_iff_mem y₀).mpr hy₀_m)
      have hz₀_lt : v.intValuation z₀ < 1 :=
        (v.intValuation_lt_one_iff_mem z₀).mpr hz₀_m
      have hX₁_lt : Valued.v X₁ < 1 := by
        have hBX : Valued.v (B * X₁) = Valued.v X₁ := by rw [map_mul, hB_val, one_mul]
        rw [← hBX]
        have hid : B * X₁ = ι x₀ - (ι x₀ - B * X₁) := by ring
        rw [hid]
        exact lt_of_le_of_lt (Valuation.map_sub Valued.v _ _) (max_lt hx₀_lt (lt_of_le_of_lt hx₀_diff hexp_lt_one))
      have hY₁_lt : Valued.v Y₁ < 1 := by
        have hBY : Valued.v (B * Y₁) = Valued.v Y₁ := by rw [map_mul, hB_val, one_mul]
        rw [← hBY]
        have hid : B * Y₁ = ι y₀ - (ι y₀ - B * Y₁) := by ring
        rw [hid]
        exact lt_of_le_of_lt (Valuation.map_sub Valued.v _ _) (max_lt hy₀_lt (lt_of_le_of_lt hy₀_diff hexp_lt_one))
      have hz₁_lt : v.intValuation z₁ < 1 := by
        have hz₀_val : v.intValuation z₀ = v.intValuation z₁ := by
          dsimp [z₀]
          rw [map_mul, map_mul, v.intValuation_eq_one_iff.mpr hbXv,
            v.intValuation_eq_one_iff.mpr hbYv, mul_one, mul_one]
        rwa [← hz₀_val]
      rcases h_prim₁ with h1 | h1 | h1
      · exact (ne_of_lt hX₁_lt) h1
      · exact (ne_of_lt hY₁_lt) h1
      · exact (ne_of_lt hz₁_lt) h1
    · apply (v.intValuation_le_pow_iff_mem (x₀ ^ 2 - β * y₀ ^ 2 - α * z₀ ^ 2) N).mp
      rw [← valued_algebraMap_eq_intValuation v (x₀ ^ 2 - β * y₀ ^ 2 - α * z₀ ^ 2)]
      change Valued.v (ι (x₀ ^ 2 - β * y₀ ^ 2 - α * z₀ ^ 2)) ≤ WithZero.exp (-(N : ℤ))
      have h_alg : ι (x₀ ^ 2 - β * y₀ ^ 2 - α * z₀ ^ 2) =
          (ι x₀ - B * X₁) * (ι x₀ + B * X₁) -
          ι β * (ι y₀ - B * Y₁) * (ι y₀ + B * Y₁) := by
        have hz₀_map : ι z₀ = B * ι z₁ := by dsimp [z₀, B]; simp only [map_mul]; ring
        simp only [map_sub, map_mul, map_pow]
        rw [hz₀_map]
        linear_combination B ^ 2 * h_eq₁
      rw [h_alg]
      refine (Valuation.map_sub Valued.v _ _).trans (max_le ?_ ?_)
      · have h_sumX : Valued.v (ι x₀ + B * X₁) ≤ 1 := by
          refine (Valuation.map_add Valued.v _ _).trans (max_le hx₀_le ?_)
          rw [map_mul, hB_val, one_mul]; exact hX₁_le
        rw [map_mul]
        exact (mul_le_of_le_one_right' h_sumX).trans hx₀_diff
      · have h_sumY : Valued.v (ι y₀ + B * Y₁) ≤ 1 := by
          refine (Valuation.map_add Valued.v _ _).trans (max_le hy₀_le ?_)
          rw [map_mul, hB_val, one_mul]; exact hY₁_le
        have hβ_le_one : Valued.v (ι β) ≤ 1 :=
          (valued_algebraMap_eq_intValuation v β).trans_le (v.intValuation_le_one β)
        rw [map_mul, map_mul]
        exact (mul_le_of_le_one_right' h_sumY).trans
          ((mul_le_of_le_one_left' hβ_le_one).trans hy₀_diff)
  letI := Classical.propDecidable
  dsimp [dyadicProd, resDyadicProd]
  refine finprod_congr (fun v => ?_)
  by_cases h2v : (2 : R) ∈ v.asIdeal
  · rw [if_pos h2v, if_pos h2v]
    obtain ⟨hα_le, hβ_le⟩ := h_sqfree v h2v
    dsimp [normSym, resDyadicSym]
    apply if_congr _ rfl rfl
    exact ⟨exists_resDyadic_of_normSym v, exists_normSym_of_resDyadic v hα_le hβ_le⟩
  · rw [if_neg h2v, if_neg h2v]

theorem resDyadicProd_mul_sq_invariance {K : Type u} [Field K] [NumberField K]
    (α β s t : NumberField.RingOfIntegers K)
    (hα : α ≠ 0) (hβ : β ≠ 0) (hs : s ≠ 0) (ht : t ≠ 0)
    (h_dyad_unit : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        s ∉ v.asIdeal ∧ t ∉ v.asIdeal)
    (h_odd_unit : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        (valNat v α % 2 = 1 → t ∉ v.asIdeal) ∧
        (valNat v β % 2 = 1 → s ∉ v.asIdeal)) :
    resDyadicProd (α * s ^ 2) (β * t ^ 2) = resDyadicProd α β ∧
    oddResQuadProd (α * s ^ 2) (β * t ^ 2) = oddResQuadProd α β ∧
    oddResQuadProd (β * t ^ 2) (α * s ^ 2) = oddResQuadProd β α ∧
    realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β :=
by
  let R := NumberField.RingOfIntegers K
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (ξ : R),
        ξ ≠ 0 → v.intValuation ξ = WithZero.exp (-(valNat v ξ : ℤ)) := by
    intro v ξ hξ
    have hv_ne : v.intValuation ξ ≠ 0 :=
      v.intValuation_ne_zero' ⟨ξ, mem_nonZeroDivisors_of_ne_zero hξ⟩
    have hv_le : v.intValuation ξ ≤ 1 := v.intValuation_le_one ξ
    have hlog_le : WithZero.log (v.intValuation ξ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v ξ : ℤ) = -WithZero.log (v.intValuation ξ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have valNat_mul_sq_mod_two :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        γ ≠ 0 → c ≠ 0 → valNat v (γ * c ^ 2) % 2 = valNat v γ % 2 := by
    intro v γ c hγ hc
    have hval_mul : v.intValuation (γ * c ^ 2) =
        WithZero.exp (-((valNat v γ + 2 * valNat v c : ℕ) : ℤ)) := by
      rw [map_mul, map_pow, sq, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v c hc, ← WithZero.exp_add, ← WithZero.exp_add]
      congr 1
      omega
    have hvalNat_eq : valNat v (γ * c ^ 2) = valNat v γ + 2 * valNat v c := by
      change (-WithZero.log (v.intValuation (γ * c ^ 2))).toNat = valNat v γ + 2 * valNat v c
      rw [hval_mul, WithZero.log_exp]
      omega
    rw [hvalNat_eq]
    omega
  letI := Classical.propDecidable
  have h_dyad : resDyadicProd (α * s ^ 2) (β * t ^ 2) = resDyadicProd α β := by
    dsimp only [resDyadicProd]
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : R) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v]
      obtain ⟨hs_v, ht_v⟩ := h_dyad_unit v h2v
      let I : Ideal R := v.asIdeal ^ (2 * valNat v (2 : R) + 2)
      have h_iff :
          (∃ x y z : R,
            ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
            x ^ 2 - (β * t ^ 2) * y ^ 2 - (α * s ^ 2) * z ^ 2 ∈ I) ↔
          (∃ X Y Z : R,
            ¬ (X ∈ v.asIdeal ∧ Y ∈ v.asIdeal ∧ Z ∈ v.asIdeal) ∧
            X ^ 2 - β * Y ^ 2 - α * Z ^ 2 ∈ I) := by
        constructor
        · rintro ⟨x, y, z, h_prim, h_mem⟩
          refine ⟨x, t * y, s * z, ?_, ?_⟩
          · rintro ⟨hx, hty, hsz⟩
            have hy : y ∈ v.asIdeal := (v.isPrime.mem_or_mem hty).resolve_left ht_v
            have hz : z ∈ v.asIdeal := (v.isPrime.mem_or_mem hsz).resolve_left hs_v
            exact h_prim ⟨hx, hy, hz⟩
          · have h_ring : x ^ 2 - β * (t * y) ^ 2 - α * (s * z) ^ 2 =
                x ^ 2 - (β * t ^ 2) * y ^ 2 - (α * s ^ 2) * z ^ 2 := by ring
            rw [h_ring]
            exact h_mem
        · rintro ⟨X, Y, Z, h_prim, h_mem⟩
          refine ⟨s * t * X, s * Y, t * Z, ?_, ?_⟩
          · rintro ⟨hstX, hsY, htZ⟩
            have hst : s * t ∉ v.asIdeal := fun hst_mem =>
              (v.isPrime.mem_or_mem hst_mem).elim hs_v ht_v
            have hX : X ∈ v.asIdeal := (v.isPrime.mem_or_mem hstX).resolve_left hst
            have hY : Y ∈ v.asIdeal := (v.isPrime.mem_or_mem hsY).resolve_left hs_v
            have hZ : Z ∈ v.asIdeal := (v.isPrime.mem_or_mem htZ).resolve_left ht_v
            exact h_prim ⟨hX, hY, hZ⟩
          · have h_ring : (s * t * X) ^ 2 - (β * t ^ 2) * (s * Y) ^ 2 - (α * s ^ 2) * (t * Z) ^ 2 =
                (s * t) ^ 2 * (X ^ 2 - β * Y ^ 2 - α * Z ^ 2) := by ring
            rw [h_ring]
            exact Ideal.mul_mem_left I ((s * t) ^ 2) h_mem
      dsimp only [resDyadicSym]
      change (if ∃ x y z : R,
          ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
          x ^ 2 - (β * t ^ 2) * y ^ 2 - (α * s ^ 2) * z ^ 2 ∈ I then (1 : ℤˣ) else -1) =
        (if ∃ X Y Z : R,
          ¬ (X ∈ v.asIdeal ∧ Y ∈ v.asIdeal ∧ Z ∈ v.asIdeal) ∧
          X ^ 2 - β * Y ^ 2 - α * Z ^ 2 ∈ I then (1 : ℤˣ) else -1)
      rw [h_iff]
    · rw [if_neg h2v, if_neg h2v]
  have resQuadSym_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ c : R),
        c ∉ v.asIdeal → resQuadSym v (γ * c ^ 2) = resQuadSym v γ := by
    intro v γ c hc
    haveI : v.asIdeal.IsMaximal := v.isMaximal
    letI : Field (R ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    let x : R ⧸ v.asIdeal := Ideal.Quotient.mk v.asIdeal γ
    let u : R ⧸ v.asIdeal := Ideal.Quotient.mk v.asIdeal c
    have hu : u ≠ 0 := Ideal.Quotient.eq_zero_iff_mem.not.mpr hc
    have h_iff : IsSquare (x * u ^ 2) ↔ IsSquare x := by
      constructor
      · rintro ⟨w, hw⟩
        refine ⟨w / u, ?_⟩
        rw [div_mul_div_comm, ← hw, sq, mul_div_cancel_right₀ _ (mul_ne_zero hu hu)]
      · rintro ⟨r, hr⟩
        refine ⟨r * u, ?_⟩
        rw [hr]
        ring
    dsimp only [resQuadSym]
    change (if IsSquare (Ideal.Quotient.mk v.asIdeal (γ * c ^ 2)) then (1 : ℤˣ) else -1) =
      (if IsSquare x then (1 : ℤˣ) else -1)
    have h_map : Ideal.Quotient.mk v.asIdeal (γ * c ^ 2) = x * u ^ 2 := by
      simp [x, u, map_mul, map_pow]
    rw [h_map, h_iff]
  have oddResQuadProd_mul_sq :
      ∀ (γ₁ γ₂ c₁ c₂ : R), γ₁ ≠ 0 → c₁ ≠ 0 →
        (∀ v : IsDedekindDomain.HeightOneSpectrum R,
          (2 : R) ∉ v.asIdeal → valNat v γ₁ % 2 = 1 → c₂ ∉ v.asIdeal) →
        oddResQuadProd (γ₁ * c₁ ^ 2) (γ₂ * c₂ ^ 2) = oddResQuadProd γ₁ γ₂ := by
    intro γ₁ γ₂ c₁ c₂ hγ₁ hc₁ h_u
    dsimp only [oddResQuadProd]
    refine finprod_congr (fun v => ?_)
    rw [valNat_mul_sq_mod_two v γ₁ c₁ hγ₁ hc₁]
    by_cases h : (2 : R) ∉ v.asIdeal ∧ valNat v γ₁ % 2 = 1
    · rw [if_pos h, if_pos h, resQuadSym_mul_sq v γ₂ c₂ (h_u v h.1 h.2)]
    · rw [if_neg h, if_neg h]
  have h_real : realSignProd (α * s ^ 2) (β * t ^ 2) = realSignProd α β := by
    dsimp only [realSignProd]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    by_cases hw : w.IsReal
    · let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ c : K, (w.embedding c).re = ρ c := by
        intro c
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw c, Complex.ofReal_re]
      have h_sign_mul_sq : ∀ (γ c : R), c ≠ 0 →
          ((w.embedding (algebraMap R K (γ * c ^ 2))).re < 0 ↔
            (w.embedding (algebraMap R K γ)).re < 0) := by
        intro γ c hc
        rw [h_re, h_re]
        simp only [map_mul, map_pow]
        have hc_K : algebraMap R K c ≠ 0 :=
          (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hc
        have hc_R : ρ (algebraMap R K c) ≠ 0 :=
          (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hc_K
        have hc_sq : 0 < (ρ (algebraMap R K c)) ^ 2 := sq_pos_of_ne_zero hc_R
        constructor <;> intro h <;> nlinarith
      rw [h_sign_mul_sq α s hs, h_sign_mul_sq β t ht]
    · have h1 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K (α * s ^ 2))).re < 0 ∧
          (w.embedding (algebraMap R K (β * t ^ 2))).re < 0) := fun h => hw h.1
      have h2 : ¬ (w.IsReal ∧
          (w.embedding (algebraMap R K α)).re < 0 ∧
          (w.embedding (algebraMap R K β)).re < 0) := fun h => hw h.1
      rw [if_neg h1, if_neg h2]
  exact ⟨h_dyad,
    oddResQuadProd_mul_sq α β s t hα hs (fun v h2 => (h_odd_unit v h2).1),
    oddResQuadProd_mul_sq β α t s hβ ht (fun v h2 => (h_odd_unit v h2).2),
    h_real⟩

theorem exists_mul_sq_strict_odd_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        (valNat v α % 2 = 1 → β ∉ v.asIdeal) ∧
        (valNat v β % 2 = 1 → α ∉ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    ∃ β' s t : NumberField.RingOfIntegers K,
      β' ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
      β * s ^ 2 = β' * t ^ 2 ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
          s ∉ v.asIdeal ∧ t ∉ v.asIdeal) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          valNat v α % 2 = 1 → s ∉ v.asIdeal ∧ t ∉ v.asIdeal) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
          ¬ (α ∈ v.asIdeal ∧ β' ∈ v.asIdeal)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
          valNat v α ≤ 1 ∧ valNat v β' ≤ 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have finite_mem_asIdeal :
      ∀ (γ : R), γ ≠ 0 →
        {v : IsDedekindDomain.HeightOneSpectrum R | γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hI : (Ideal.span {γ} : Ideal R) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-((valNat v γ : ℕ) : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have h_toNat : ((valNat v γ : ℕ) : ℤ) = -WithZero.log (v.intValuation γ) := by
      dsimp [valNat]
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [h_toNat, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ δ : R), γ ≠ 0 → δ ≠ 0 →
        valNat v (γ * δ) = valNat v γ + valNat v δ := by
    intro v γ δ hγ hδ
    have hval_mul : v.intValuation (γ * δ) =
        WithZero.exp (-((valNat v γ + valNat v δ : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v δ hδ, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * δ))).toNat = valNat v γ + valNat v δ
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_mod_two_eq_of_mul_sq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ γ' s t : R),
        γ ≠ 0 → γ' ≠ 0 → s ≠ 0 → t ≠ 0 → γ * s ^ 2 = γ' * t ^ 2 →
          valNat v γ' % 2 = valNat v γ % 2 := by
    intro v γ γ' s t hγ hγ' hs ht h_eq
    have hs2 : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    have ht2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    have h1 : valNat v (γ * s ^ 2) = valNat v γ + (valNat v s + valNat v s) := by
      rw [valNat_mul v γ (s ^ 2) hγ hs2, sq s, valNat_mul v s s hs hs]
    have h2 : valNat v (γ' * t ^ 2) = valNat v γ' + (valNat v t + valNat v t) := by
      rw [valNat_mul v γ' (t ^ 2) hγ' ht2, sq t, valNat_mul v t t ht ht]
    have h3 : valNat v (γ * s ^ 2) = valNat v (γ' * t ^ 2) := congr_arg (valNat v) h_eq
    omega
  have valNat_eq_zero_of_not_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ∉ v.asIdeal → valNat v γ = 0 := by
    intro v γ hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    dsimp [valNat]
    rw [hv1, WithZero.log_one]
    rfl
  have not_mem_asIdeal_of_valNat_eq_zero :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ≠ 0 → valNat v γ = 0 → γ ∉ v.asIdeal := by
    intro v γ hγ h0
    have hv1 : v.intValuation γ = 1 := by
      rw [intValuation_eq_exp_neg_valNat v γ hγ, h0]
      simp
    exact v.intValuation_eq_one_iff.mp hv1
  have mem_asIdeal_of_valNat_mod_two_eq_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        valNat v γ % 2 = 1 → γ ∈ v.asIdeal := by
    intro v γ hodd
    by_contra hnot
    have h0 : valNat v γ = 0 := valNat_eq_zero_of_not_mem v γ hnot
    omega
  have exists_step_clear :
      ∀ (T : Finset (IsDedekindDomain.HeightOneSpectrum R))
        (w : IsDedekindDomain.HeightOneSpectrum R), w ∉ T →
        ∀ (γ₁ : R), γ₁ ≠ 0 →
          ∃ γ' s₀ t₀ : R,
            γ' ≠ 0 ∧ s₀ ≠ 0 ∧ t₀ ≠ 0 ∧
            γ₁ * s₀ ^ 2 = γ' * t₀ ^ 2 ∧
            valNat w γ' ≤ 1 ∧
            (∀ u ∈ T, s₀ ∉ u.asIdeal ∧ t₀ ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁) := by
    intro T w hwT γ₁ hγ₁
    let k : ℕ := valNat w γ₁ / 2
    have hγ₁_val : w.intValuation γ₁ ≤ WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [intValuation_eq_exp_neg_valNat w γ₁ hγ₁, WithZero.exp_le_exp]
      omega
    have hγ₁_mem : γ₁ ∈ w.asIdeal ^ (2 * k) :=
      (w.intValuation_le_pow_iff_mem γ₁ (2 * k)).mp hγ₁_val
    have h_cop : IsCoprime (w.asIdeal ^ 2) (∏ u ∈ T, u.asIdeal) := by
      refine IsCoprime.prod_right (fun u huT => ?_)
      have hne : w ≠ u := fun h => hwT (h ▸ huT)
      have h_id_ne : w.asIdeal ≠ u.asIdeal :=
        IsDedekindDomain.HeightOneSpectrum.ext_iff.not.mp hne
      haveI := w.isMaximal
      haveI := u.isMaximal
      exact (Ideal.isCoprime_of_isMaximal h_id_ne).pow_left
    obtain ⟨x, hx, y, hy, hxy⟩ := Ideal.isCoprime_iff_exists.mp h_cop
    have hx_val : w.intValuation x ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
      (w.intValuation_le_pow_iff_mem x 2).mpr hx
    have hx_w : x ∈ w.asIdeal :=
      Ideal.pow_le_self (by decide : 2 ≠ 0) hx
    have hy_w : y ∉ w.asIdeal := by
      intro hy_m
      have h1_m : (1 : R) ∈ w.asIdeal := hxy ▸ w.asIdeal.add_mem hx_w hy_m
      exact w.isMaximal.ne_top ((Ideal.eq_top_iff_one w.asIdeal).mpr h1_m)
    have hy_val : w.intValuation y = 1 := w.intValuation_eq_one_iff.mpr hy_w
    have hy_T : ∀ u ∈ T, y ∈ u.asIdeal :=
      fun u huT => (Ideal.prod_le_inf.trans (Finset.inf_le huT)) hy
    have hx_T : ∀ u ∈ T, x ∉ u.asIdeal := by
      intro u huT hx_m
      have h1_m : (1 : R) ∈ u.asIdeal := hxy ▸ u.asIdeal.add_mem hx_m (hy_T u huT)
      exact u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1_m)
    obtain ⟨π, hπ⟩ := w.intValuation_exists_uniformizer
    let π' : R := π * y + x
    have hπy_val : w.intValuation (π * y) = WithZero.exp (-1 : ℤ) := by
      rw [map_mul, hπ, hy_val, mul_one]
    have hlt_exp : WithZero.exp (-((2 : ℕ) : ℤ)) < WithZero.exp (-1 : ℤ) :=
      WithZero.exp_lt_exp.mpr (by omega)
    have hlt_val : w.intValuation x < w.intValuation (π * y) := by
      rw [hπy_val]
      exact lt_of_le_of_lt hx_val hlt_exp
    have hπ'_val : w.intValuation π' = WithZero.exp (-1 : ℤ) := by
      change w.intValuation (π * y + x) = WithZero.exp (-1 : ℤ)
      rw [add_comm, Valuation.map_add_of_distinct_val w.intValuation (ne_of_lt hlt_val),
        max_eq_right (le_of_lt hlt_val), hπy_val]
    have hπ'_w : π' ∈ w.asIdeal := by
      have hle1 : w.intValuation π' ≤ WithZero.exp (-((1 : ℕ) : ℤ)) := by
        rw [hπ'_val]
        exact le_rfl
      simpa [pow_one] using (w.intValuation_le_pow_iff_mem π' 1).mp hle1
    have hπ'_T : ∀ u ∈ T, π' ∉ u.asIdeal := by
      intro u huT hπ'_m
      have hπy_m : π * y ∈ u.asIdeal := u.asIdeal.mul_mem_left π (hy_T u huT)
      have hx_m : x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hπ'_m hπy_m
        have hid : π' - π * y = x := by dsimp [π']; ring
        rwa [hid] at hsub
      exact hx_T u huT hx_m
    have hπ'_dvd : w.asIdeal ^ 1 ∣ Ideal.span {π'} := by
      apply (w.intValuation_le_pow_iff_dvd π' 1).mp
      rw [hπ'_val]
      exact le_rfl
    rw [pow_one] at hπ'_dvd
    obtain ⟨J, hJ⟩ := hπ'_dvd
    have hJ_not_le : ¬ (J ≤ w.asIdeal) := by
      intro hle
      have hπ'_mem2 : π' ∈ w.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ'_le2 : w.intValuation π' ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (w.intValuation_le_pow_iff_mem π' 2).mpr hπ'_mem2
      rw [hπ'_val, WithZero.exp_le_exp] at hπ'_le2
      omega
    obtain ⟨a, haJ, haw⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hπ'J : π' ∈ J := by
      rw [← Ideal.span_singleton_le_iff_mem, hJ]
      exact Ideal.mul_le_left
    let s₀ : R := a * y + π' * x
    have hs₀J : s₀ ∈ J :=
      J.add_mem (J.mul_mem_right y haJ) (J.mul_mem_right x hπ'J)
    have hs₀w : s₀ ∉ w.asIdeal := by
      intro hs₀_m
      have hπ'x_w : π' * x ∈ w.asIdeal := w.asIdeal.mul_mem_right x hπ'_w
      have hay_w : a * y ∈ w.asIdeal := by
        have hsub := w.asIdeal.sub_mem hs₀_m hπ'x_w
        have hid : s₀ - π' * x = a * y := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases w.isPrime.mem_or_mem hay_w with ha_m | hy_m
      · exact haw ha_m
      · exact hy_w hy_m
    have hs₀_T : ∀ u ∈ T, s₀ ∉ u.asIdeal := by
      intro u huT hs₀_m
      have hay_u : a * y ∈ u.asIdeal := u.asIdeal.mul_mem_left a (hy_T u huT)
      have hπ'x_u : π' * x ∈ u.asIdeal := by
        have hsub := u.asIdeal.sub_mem hs₀_m hay_u
        have hid : s₀ - a * y = π' * x := by dsimp [s₀]; ring
        rwa [hid] at hsub
      rcases u.isPrime.mem_or_mem hπ'x_u with hπ'_m | hx_m
      · exact hπ'_T u huT hπ'_m
      · exact hx_T u huT hx_m
    have hspan_γ₁ : Ideal.span {γ₁} ≤ w.asIdeal ^ (2 * k) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hγ₁_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_mul : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π' ^ k) ^ 2} := by
      have h1 : Ideal.span {γ₁ * (s₀ ^ k) ^ 2} = Ideal.span {γ₁} * (Ideal.span {s₀}) ^ (2 * k) := by
        rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
          ← Ideal.span_singleton_pow]
      have h2 : Ideal.span {(π' ^ k) ^ 2} = w.asIdeal ^ (2 * k) * J ^ (2 * k) := by
        rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
      rw [h1, h2]
      exact Ideal.mul_mono hspan_γ₁ (Ideal.pow_right_mono hspan_s₀ (2 * k))
    obtain ⟨γ', hγ'_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
    have hπ'_pow_val : w.intValuation ((π' ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ'_val, exp_neg_one_pow (2 * k)]
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀w (h0 ▸ w.asIdeal.zero_mem)
    have hπ'_ne : π' ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hπ'_val
      exact WithZero.exp_ne_zero hπ'_val.symm
    have hs₀k2_ne : (s₀ ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hs₀_ne)
    have hπ'k2_ne : (π' ^ k) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero k hπ'_ne)
    have hγ'_ne : γ' ≠ 0 := by
      intro h0
      apply mul_ne_zero hγ₁ hs₀k2_ne
      rw [hγ'_eq, h0, mul_zero]
    have hs₀k2_not_w : (s₀ ^ k) ^ 2 ∉ w.asIdeal :=
      fun hm => hs₀w (w.isPrime.mem_of_pow_mem k (w.isPrime.mem_of_pow_mem 2 hm))
    have hval_s₀k2_w : valNat w ((s₀ ^ k) ^ 2) = 0 :=
      valNat_eq_zero_of_not_mem w ((s₀ ^ k) ^ 2) hs₀k2_not_w
    have hval_π'k2_w : valNat w ((π' ^ k) ^ 2) = 2 * k := by
      change (-WithZero.log (w.intValuation ((π' ^ k) ^ 2))).toNat = 2 * k
      rw [hπ'_pow_val, WithZero.log_exp]
      omega
    have hval_eq_w : valNat w γ₁ + valNat w ((s₀ ^ k) ^ 2) =
        valNat w ((π' ^ k) ^ 2) + valNat w γ' := by
      rw [← valNat_mul w γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
        valNat_mul w ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
    have hγ'_le_one : valNat w γ' ≤ 1 := by omega
    have hT_props : ∀ u ∈ T,
        s₀ ^ k ∉ u.asIdeal ∧ π' ^ k ∉ u.asIdeal ∧ valNat u γ' = valNat u γ₁ := by
      intro u huT
      have hs₀k_not_u : s₀ ^ k ∉ u.asIdeal :=
        fun hm => hs₀_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hπ'k_not_u : π' ^ k ∉ u.asIdeal :=
        fun hm => hπ'_T u huT (u.isPrime.mem_of_pow_mem k hm)
      have hs₀k2_not_u : (s₀ ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hs₀k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hπ'k2_not_u : (π' ^ k) ^ 2 ∉ u.asIdeal :=
        fun hm => hπ'k_not_u (u.isPrime.mem_of_pow_mem 2 hm)
      have hval_s₀k2_u : valNat u ((s₀ ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((s₀ ^ k) ^ 2) hs₀k2_not_u
      have hval_π'k2_u : valNat u ((π' ^ k) ^ 2) = 0 :=
        valNat_eq_zero_of_not_mem u ((π' ^ k) ^ 2) hπ'k2_not_u
      have hval_eq_u : valNat u γ₁ + valNat u ((s₀ ^ k) ^ 2) =
          valNat u ((π' ^ k) ^ 2) + valNat u γ' := by
        rw [← valNat_mul u γ₁ ((s₀ ^ k) ^ 2) hγ₁ hs₀k2_ne, hγ'_eq,
          valNat_mul u ((π' ^ k) ^ 2) γ' hπ'k2_ne hγ'_ne]
      refine ⟨hs₀k_not_u, hπ'k_not_u, by omega⟩
    refine ⟨γ', s₀ ^ k, π' ^ k, hγ'_ne, pow_ne_zero k hs₀_ne, pow_ne_zero k hπ'_ne,
      hγ'_eq.trans (mul_comm _ _), hγ'_le_one, hT_props⟩
  have exists_clear_finset :
      ∀ (P S : Finset (IsDedekindDomain.HeightOneSpectrum R)),
        (∀ v ∈ S, v ∉ P) →
        ∀ (γ : R), γ ≠ 0 →
          ∃ γ' s t : R,
            γ' ≠ 0 ∧ s ≠ 0 ∧ t ≠ 0 ∧
            γ * s ^ 2 = γ' * t ^ 2 ∧
            (∀ u ∈ P, s ∉ u.asIdeal ∧ t ∉ u.asIdeal) ∧
            (∀ v ∈ S, valNat v γ' ≤ 1) := by
    intro P S
    induction S using Finset.induction_on with
    | empty =>
      intro _ γ hγ
      refine ⟨γ, 1, 1, hγ, one_ne_zero, one_ne_zero, rfl, ?_, ?_⟩
      · intro u _
        have h1_not : (1 : R) ∉ u.asIdeal :=
          fun h1 => u.isMaximal.ne_top ((Ideal.eq_top_iff_one u.asIdeal).mpr h1)
        exact ⟨h1_not, h1_not⟩
      · intro v hv
        exact False.elim (Finset.notMem_empty v hv)
    | insert w S hwS ih =>
      intro hSP γ hγ
      have hwP : w ∉ P := hSP w (Finset.mem_insert_self w S)
      have hSP' : ∀ v ∈ S, v ∉ P := fun v hv => hSP v (Finset.mem_insert_of_mem hv)
      obtain ⟨γ₁, s₁, t₁, hγ₁, hs₁, ht₁, h_eq₁, hP₁, hS₁⟩ := ih hSP' γ hγ
      have hwSP : w ∉ S ∪ P := fun hm => (Finset.mem_union.mp hm).elim hwS hwP
      obtain ⟨γ', s₀, t₀, hγ', hs₀, ht₀, h_eq₀, hw', hSP₀⟩ :=
        exists_step_clear (S ∪ P) w hwSP γ₁ hγ₁
      refine ⟨γ', s₁ * s₀, t₁ * t₀, hγ', mul_ne_zero hs₁ hs₀, mul_ne_zero ht₁ ht₀, ?_, ?_, ?_⟩
      · linear_combination s₀ ^ 2 * h_eq₁ + t₁ ^ 2 * h_eq₀
      · intro u huP
        have huSP : u ∈ S ∪ P := Finset.mem_union.mpr (Or.inr huP)
        obtain ⟨hs₁_u, ht₁_u⟩ := hP₁ u huP
        obtain ⟨hs₀_u, ht₀_u, _⟩ := hSP₀ u huSP
        refine ⟨fun hm => (u.isPrime.mem_or_mem hm).elim hs₁_u hs₀_u,
          fun hm => (u.isPrime.mem_or_mem hm).elim ht₁_u ht₀_u⟩
      · intro v hv
        rcases Finset.mem_insert.mp hv with rfl | hvS
        · exact hw'
        · have hvSP : v ∈ S ∪ P := Finset.mem_union.mpr (Or.inl hvS)
          rw [(hSP₀ v hvSP).2.2]
          exact hS₁ v hvS
  have h2 : (2 : R) ≠ 0 := two_ne_zero
  have hfin_2 := finite_mem_asIdeal (2 : R) h2
  let F_2 : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_2.toFinset
  have hfin_α := finite_mem_asIdeal α hα
  let F_α : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_α.toFinset
  have hfin_β := finite_mem_asIdeal β hβ
  let F_β : Finset (IsDedekindDomain.HeightOneSpectrum R) := hfin_β.toFinset
  let S : Finset (IsDedekindDomain.HeightOneSpectrum R) := (F_α ∩ F_β) \ F_2
  let P : Finset (IsDedekindDomain.HeightOneSpectrum R) := F_2 ∪ (F_α \ F_β)
  have hSP : ∀ v ∈ S, v ∉ P := by
    intro v hvS hvP
    obtain ⟨hv_ab, hv_not2⟩ := Finset.mem_sdiff.mp hvS
    obtain ⟨_, hv_b⟩ := Finset.mem_inter.mp hv_ab
    rcases Finset.mem_union.mp hvP with hv_2 | hv_diff
    · exact hv_not2 hv_2
    · exact (Finset.mem_sdiff.mp hv_diff).2 hv_b
  obtain ⟨β', s, t, hβ', hs, ht, h_eqβ, hP_β, hS_β⟩ :=
    exists_clear_finset P S hSP β hβ
  refine ⟨β', s, t, hβ', hs, ht, h_eqβ, ?_, ?_, ?_, ?_⟩
  · intro v h2v
    have hvP : v ∈ P := Finset.mem_union.mpr (Or.inl (hfin_2.mem_toFinset.mpr h2v))
    exact hP_β v hvP
  · intro v h2v hα_odd
    have hα_mem : α ∈ v.asIdeal := mem_asIdeal_of_valNat_mod_two_eq_one v α hα_odd
    have hβ_not : β ∉ v.asIdeal := (h_coprime v h2v).1 hα_odd
    have hvα : v ∈ F_α := hfin_α.mem_toFinset.mpr hα_mem
    have hvβ : v ∉ F_β := fun hm => hβ_not (hfin_β.mem_toFinset.mp hm)
    have hvP : v ∈ P := Finset.mem_union.mpr (Or.inr (Finset.mem_sdiff.mpr ⟨hvα, hvβ⟩))
    exact hP_β v hvP
  · intro v h2v ⟨hα_mem, hβ'_mem⟩
    have hvα : v ∈ F_α := hfin_α.mem_toFinset.mpr hα_mem
    by_cases hβ_mem : β ∈ v.asIdeal
    · have hvβ : v ∈ F_β := hfin_β.mem_toFinset.mpr hβ_mem
      have hv2 : v ∉ F_2 := fun hm => h2v (hfin_2.mem_toFinset.mp hm)
      have hvS : v ∈ S := Finset.mem_sdiff.mpr ⟨Finset.mem_inter.mpr ⟨hvα, hvβ⟩, hv2⟩
      have hle1 : valNat v β' ≤ 1 := hS_β v hvS
      have hβ_not_odd : valNat v β % 2 ≠ 1 :=
        fun hodd => (h_coprime v h2v).2 hodd hα_mem
      have hpar : valNat v β' % 2 = valNat v β % 2 :=
        valNat_mod_two_eq_of_mul_sq v β β' s t hβ hβ' hs ht h_eqβ
      have h0 : valNat v β' = 0 := by omega
      exact not_mem_asIdeal_of_valNat_eq_zero v β' hβ' h0 hβ'_mem
    · have hvβ : v ∉ F_β := fun hm => hβ_mem (hfin_β.mem_toFinset.mp hm)
      have hvP : v ∈ P := Finset.mem_union.mpr (Or.inr (Finset.mem_sdiff.mpr ⟨hvα, hvβ⟩))
      have hs_not : s ∉ v.asIdeal := (hP_β v hvP).1
      have h_lhs_mem : β * s ^ 2 ∈ v.asIdeal := by
        rw [h_eqβ]
        exact v.asIdeal.mul_mem_right (t ^ 2) hβ'_mem
      rcases v.isPrime.mem_or_mem h_lhs_mem with hβ_m | hs_m
      · exact hβ_mem hβ_m
      · exact hs_not (v.isPrime.mem_of_pow_mem 2 hs_m)
  · intro v h2v
    have hvP : v ∈ P := Finset.mem_union.mpr (Or.inl (hfin_2.mem_toFinset.mpr h2v))
    obtain ⟨hs_not, ht_not⟩ := hP_β v hvP
    have hs2_not : s ^ 2 ∉ v.asIdeal :=
      fun hm => hs_not (v.isPrime.mem_of_pow_mem 2 hm)
    have ht2_not : t ^ 2 ∉ v.asIdeal :=
      fun hm => ht_not (v.isPrime.mem_of_pow_mem 2 hm)
    have hval_s2 : valNat v (s ^ 2) = 0 := valNat_eq_zero_of_not_mem v (s ^ 2) hs2_not
    have hval_t2 : valNat v (t ^ 2) = 0 := valNat_eq_zero_of_not_mem v (t ^ 2) ht2_not
    have hs2_ne : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
    have ht2_ne : t ^ 2 ≠ 0 := pow_ne_zero 2 ht
    have hval_eq : valNat v β + valNat v (s ^ 2) = valNat v β' + valNat v (t ^ 2) := by
      rw [← valNat_mul v β (s ^ 2) hβ hs2_ne, h_eqβ, valNat_mul v β' (t ^ 2) hβ' ht2_ne]
    have hsq := h_sqfree v h2v
    refine ⟨hsq.1, by omega⟩

theorem oddResQuadProd_eq_oddPowResQuadProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) :
    oddResQuadProd α β = oddPowResQuadProd α β :=
by
  let R := NumberField.RingOfIntegers K
  letI := Classical.propDecidable
  have units_pow_eq_pow_mod_two : ∀ (u : ℤˣ) (n : ℕ), u ^ n = u ^ (n % 2) := by
    intro u n
    conv_lhs => rw [← Nat.div_add_mod n 2]
    rw [pow_add, pow_mul, Int.units_sq u, one_pow, one_mul]
  have mem_asIdeal_of_valNat_mod_two_eq_one :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R),
        valNat v α % 2 = 1 → α ∈ v.asIdeal := by
    intro v hn
    by_contra h_not_mem
    have hval1 : v.intValuation α = 1 := v.intValuation_eq_one_iff.mpr h_not_mem
    have hval0 : valNat v α = 0 := by
      unfold valNat
      rw [hval1, WithZero.log_one]
      rfl
    rw [hval0] at hn
    contradiction
  dsimp only [oddResQuadProd, oddPowResQuadProd]
  refine finprod_congr (fun v => ?_)
  by_cases h2v : (2 : R) ∈ v.asIdeal
  · have hL : ¬ ((2 : R) ∉ v.asIdeal ∧ valNat v α % 2 = 1) := fun h => h.1 h2v
    have hR : ¬ ((2 : R) ∉ v.asIdeal ∧ α ∈ v.asIdeal) := fun h => h.1 h2v
    rw [if_neg hL, if_neg hR]
  · by_cases hn : valNat v α % 2 = 1
    · have hα_mem : α ∈ v.asIdeal := mem_asIdeal_of_valNat_mod_two_eq_one v hn
      rw [if_pos ⟨h2v, hn⟩, if_pos ⟨h2v, hα_mem⟩,
        units_pow_eq_pow_mod_two (resQuadSym v β) (valNat v α), hn, pow_one]
    · have hL : ¬ ((2 : R) ∉ v.asIdeal ∧ valNat v α % 2 = 1) := fun h => hn h.2
      rw [if_neg hL]
      have hn0 : valNat v α % 2 = 0 := by
        rcases Nat.mod_two_eq_zero_or_one (valNat v α) with h0 | h1
        · exact h0
        · exact False.elim (hn h1)
      by_cases hα_mem : α ∈ v.asIdeal
      · rw [if_pos ⟨h2v, hα_mem⟩,
          units_pow_eq_pow_mod_two (resQuadSym v β) (valNat v α), hn0, pow_zero]
      · have hR : ¬ ((2 : R) ∉ v.asIdeal ∧ α ∈ v.asIdeal) := fun h => hα_mem h.2
        rw [if_neg hR]

theorem resDyadicProd_oddPowResQuadProd_norm_mul_sq_invariance {K : Type u} [Field K] [NumberField K]
    (α β α' x y s t : NumberField.RingOfIntegers K)
    (hα : α ≠ 0) (hβ : β ≠ 0) (hα' : α' ≠ 0)
    (hδ : x ^ 2 - β * y ^ 2 ≠ 0) (hs : s ≠ 0) (ht : t ≠ 0)
    (h_eq : α * (x ^ 2 - β * y ^ 2) * s ^ 2 = α' * t ^ 2)
    (h_strict_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1)
    (h_strict_coprime' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        ¬ (α' ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α' ≤ 1 ∧ valNat v β ≤ 1) :
    resDyadicProd α β = resDyadicProd α' β ∧
    oddPowResQuadProd α β * oddPowResQuadProd β α =
      oddPowResQuadProd α' β * oddPowResQuadProd β α' ∧
    realSignProd α β = realSignProd α' β :=
by
  let R := NumberField.RingOfIntegers K
  let δ : R := x ^ 2 - β * y ^ 2
  have intValuation_eq_exp_neg_valNat :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-(valNat v γ : ℤ)) := by
    intro v γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v γ : ℤ) = -WithZero.log (v.intValuation γ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have valNat_mul :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ η : R), γ ≠ 0 → η ≠ 0 →
        valNat v (γ * η) = valNat v γ + valNat v η := by
    intro v γ η hγ hη
    have hval_mul : v.intValuation (γ * η) =
        WithZero.exp (-((valNat v γ + valNat v η : ℕ) : ℤ)) := by
      rw [map_mul, intValuation_eq_exp_neg_valNat v γ hγ,
        intValuation_eq_exp_neg_valNat v η hη, ← WithZero.exp_add]
      push_cast
      ring_nf
    change (-WithZero.log (v.intValuation (γ * η))).toNat = valNat v γ + valNat v η
    rw [hval_mul, WithZero.log_exp]
    omega
  have valNat_eq_of_intValuation_eq :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ η : R),
        v.intValuation γ = v.intValuation η → valNat v γ = valNat v η := by
    intro v γ η h
    unfold valNat
    rw [h]
  have valNat_eq_zero_of_not_mem :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        γ ∉ v.asIdeal → valNat v γ = 0 := by
    intro v γ hnot
    have hv1 : v.intValuation γ = 1 := v.intValuation_eq_one_iff.mpr hnot
    unfold valNat
    rw [hv1, WithZero.log_one]
    rfl
  have mem_asIdeal_of_valNat_ne_zero :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (γ : R),
        valNat v γ ≠ 0 → γ ∈ v.asIdeal := by
    intro v γ hne
    by_contra hnot
    exact hne (valNat_eq_zero_of_not_mem v γ hnot)
  have valued_algebraMap_eq_intValuation :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (r : R),
        Valued.v (algebraMap K (v.adicCompletion K) (algebraMap R K r)) = v.intValuation r :=
    fun v r => (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
      (algebraMap R K r)).trans (v.valuation_of_algebraMap r)
  have isSquare_of_val_sub_one_le :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (u : v.adicCompletion K),
        Valued.v (u - 1) ≤ WithZero.exp (-((2 * valNat v (2 : R) + 1 : ℕ) : ℤ)) →
        IsSquare u := by
    intro v u hu_le
    let e : ℕ := valNat v (2 : R)
    let ι : R →+* v.adicCompletion K := (algebraMap K (v.adicCompletion K)).comp (algebraMap R K)
    have h2R : (2 : R) ≠ 0 := two_ne_zero
    have h2_val : Valued.v (2 : v.adicCompletion K) = WithZero.exp (-(e : ℤ)) := by
      have h2_eq : (2 : v.adicCompletion K) = ι (2 : R) := (map_ofNat ι 2).symm
      rw [h2_eq]
      exact (valued_algebraMap_eq_intValuation v (2 : R)).trans
        (intValuation_eq_exp_neg_valNat v (2 : R) h2R)
    have h2_ne : (2 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at h2_val
      exact WithZero.exp_ne_zero h2_val.symm
    have h2inv_val : Valued.v ((2 : v.adicCompletion K)⁻¹) = WithZero.exp (e : ℤ) := by
      rw [map_inv₀, h2_val, ← WithZero.exp_neg, neg_neg]
    have h2_mul_inv : (2 : v.adicCompletion K) * 2⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    let z : ℕ → v.adicCompletion K := fun n =>
      Nat.recOn n 1 (fun _ zn => zn - 2⁻¹ * (zn ^ 2 - u))
    have h_ind : ∀ n : ℕ,
        Valued.v (z n - 1) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) ∧
        Valued.v (z n ^ 2 - u) ≤ WithZero.exp (-((2 * e + n + 1 : ℕ) : ℤ)) := by
      intro n
      induction n with
      | zero =>
        refine ⟨?_, ?_⟩
        · change Valued.v ((1 : v.adicCompletion K) - 1) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ))
          rw [sub_self, Valuation.map_zero]
          exact zero_le'
        · change Valued.v ((1 : v.adicCompletion K) ^ 2 - u) ≤
            WithZero.exp (-((2 * e + 0 + 1 : ℕ) : ℤ))
          have hid : (1 : v.adicCompletion K) ^ 2 - u = -(u - 1) := by ring
          rw [hid, Valuation.map_neg, Nat.add_zero]
          exact hu_le
      | succ n ih =>
        have h_step : z (n + 1) = z n - 2⁻¹ * (z n ^ 2 - u) := rfl
        have h_term : Valued.v (2⁻¹ * (z n ^ 2 - u)) ≤ WithZero.exp (-((e + 1 : ℕ) : ℤ)) := by
          rw [map_mul, h2inv_val]
          refine (mul_le_mul' le_rfl ih.2).trans ?_
          rw [← WithZero.exp_add, WithZero.exp_le_exp]
          omega
        refine ⟨?_, ?_⟩
        · have h_diff : z (n + 1) - 1 = (z n - 1) - 2⁻¹ * (z n ^ 2 - u) := by
            rw [h_step]; ring
          rw [h_diff]
          exact (Valuation.map_sub Valued.v _ _).trans (max_le ih.1 h_term)
        · have h_id : z (n + 1) ^ 2 - u =
              (z n ^ 2 - u) * (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) := by
            rw [h_step]
            linear_combination - z n * (z n ^ 2 - u) * h2_mul_inv
          have h_fac2 : Valued.v (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) ≤
              WithZero.exp (-1 : ℤ) := by
            refine (Valuation.map_add Valued.v _ _).trans (max_le ?_ ?_)
            · rw [Valuation.map_neg]
              refine ih.1.trans ?_
              rw [WithZero.exp_le_exp]
              omega
            · rw [map_mul, sq (2⁻¹ : v.adicCompletion K), map_mul, h2inv_val]
              refine (mul_le_mul' le_rfl ih.2).trans ?_
              rw [← WithZero.exp_add, ← WithZero.exp_add, WithZero.exp_le_exp]
              omega
          have h_exp : WithZero.exp (-((2 * e + n + 1 : ℕ) : ℤ)) * WithZero.exp (-1 : ℤ) =
              WithZero.exp (-((2 * e + (n + 1) + 1 : ℕ) : ℤ)) := by
            rw [← WithZero.exp_add]
            congr 1
          rw [h_id, map_mul, ← h_exp]
          exact mul_le_mul' ih.2 h_fac2
    have h_tendsto_zero : ∀ g : ℕ → v.adicCompletion K,
        (∀ n : ℕ, Valued.v (g n) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ))) →
        Filter.Tendsto g Filter.atTop (nhds 0) := by
      intro g hg
      rw [(Valued.hasBasis_nhds_zero (v.adicCompletion K)
        (WithZero (Multiplicative ℤ))).tendsto_right_iff]
      intro γ _
      rw [Filter.eventually_atTop]
      let m : ℤ := WithZero.log (γ : WithZero (Multiplicative ℤ))
      refine ⟨(-m).toNat, fun n hn => ?_⟩
      have h_lt : WithZero.exp (-((n + 1 : ℕ) : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← WithZero.exp_log γ.ne_zero, WithZero.exp_lt_exp]
        change -((n + 1 : ℕ) : ℤ) < m
        omega
      exact lt_of_le_of_lt (hg n) h_lt
    have hz_sub : Filter.Tendsto (fun n => z (n + 1) - z n) Filter.atTop (nhds 0) := by
      apply h_tendsto_zero
      intro n
      have h_step_sub : z (n + 1) - z n = -(2⁻¹ * (z n ^ 2 - u)) := by
        change (z n - 2⁻¹ * (z n ^ 2 - u)) - z n = -(2⁻¹ * (z n ^ 2 - u))
        ring
      rw [h_step_sub, Valuation.map_neg, map_mul, h2inv_val]
      refine (mul_le_mul' le_rfl (h_ind n).2).trans ?_
      rw [← WithZero.exp_add, WithZero.exp_le_exp]
      omega
    have hz_cauchy : CauchySeq z :=
      NonarchimedeanAddGroup.cauchySeq_of_tendsto_sub_nhds_zero hz_sub
    obtain ⟨w, hw⟩ := cauchySeq_tendsto_of_complete hz_cauchy
    have h_sq_zero : Filter.Tendsto (fun n => z n ^ 2 - u) Filter.atTop (nhds 0) := by
      apply h_tendsto_zero
      intro n
      refine ((h_ind n).2).trans ?_
      rw [WithZero.exp_le_exp]
      omega
    have h_sq_w : Filter.Tendsto (fun n => z n ^ 2 - u) Filter.atTop (nhds (w ^ 2 - u)) :=
      (hw.pow 2).sub_const u
    have hw_eq : w ^ 2 - u = 0 := tendsto_nhds_unique h_sq_w h_sq_zero
    exact ⟨w, by linear_combination -hw_eq⟩
  have exists_sq_mul_eq_add_of_mem_pow :
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R) (c x₀ r : R),
        c ≠ 0 → valNat v c ≤ 1 → x₀ ∉ v.asIdeal →
        r ∈ v.asIdeal ^ (2 * valNat v (2 : R) + 2) →
        ∃ W : v.adicCompletion K,
          W ≠ 0 ∧
          algebraMap K (v.adicCompletion K) (algebraMap R K c) * W ^ 2 =
            algebraMap K (v.adicCompletion K) (algebraMap R K c) *
              (algebraMap K (v.adicCompletion K) (algebraMap R K x₀)) ^ 2 +
            algebraMap K (v.adicCompletion K) (algebraMap R K r) := by
    intro v c x₀ r hc hc_le hx₀ hr
    let e : ℕ := valNat v (2 : R)
    let ι : R →+* v.adicCompletion K := (algebraMap K (v.adicCompletion K)).comp (algebraMap R K)
    let d : R := c * x₀ ^ 2
    have hx₀_val : v.intValuation x₀ = 1 := v.intValuation_eq_one_iff.mpr hx₀
    have hc_val : v.intValuation c = WithZero.exp (-(valNat v c : ℤ)) :=
      intValuation_eq_exp_neg_valNat v c hc
    have hd_val : Valued.v (ι d) = WithZero.exp (-(valNat v c : ℤ)) := by
      change Valued.v (algebraMap K (v.adicCompletion K) (algebraMap R K (c * x₀ ^ 2))) = _
      rw [valued_algebraMap_eq_intValuation v (c * x₀ ^ 2), map_mul, map_pow, hx₀_val, hc_val,
        one_pow, mul_one]
    have hd_ne : ι d ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at hd_val
      exact WithZero.exp_ne_zero hd_val.symm
    have hd_inv : ι d * (ι d)⁻¹ = 1 := mul_inv_cancel₀ hd_ne
    have hr_val : Valued.v (ι r) ≤ WithZero.exp (-((2 * e + 2 : ℕ) : ℤ)) := by
      change Valued.v (algebraMap K (v.adicCompletion K) (algebraMap R K r)) ≤ _
      rw [valued_algebraMap_eq_intValuation v r]
      exact (v.intValuation_le_pow_iff_mem r (2 * e + 2)).mpr hr
    let u : v.adicCompletion K := 1 + ι r * (ι d)⁻¹
    have hu_sub : u - 1 = ι r * (ι d)⁻¹ := by dsimp [u]; ring
    have hu_le : Valued.v (u - 1) ≤ WithZero.exp (-((2 * e + 1 : ℕ) : ℤ)) := by
      rw [hu_sub, map_mul, map_inv₀, hd_val, ← WithZero.exp_neg, neg_neg]
      refine (mul_le_mul' hr_val le_rfl).trans ?_
      rw [← WithZero.exp_add, WithZero.exp_le_exp]
      omega
    obtain ⟨w, hw⟩ := isSquare_of_val_sub_one_le v u hu_le
    have hu_ne : u ≠ 0 := by
      intro hu0
      have h1 : Valued.v (u - 1) = 1 := by
        rw [hu0, zero_sub, Valuation.map_neg, Valuation.map_one]
      rw [h1, ← WithZero.exp_zero, WithZero.exp_le_exp] at hu_le
      omega
    have hw_ne : w ≠ 0 := by
      intro hw0
      rw [hw0, mul_zero] at hw
      exact hu_ne hw
    refine ⟨ι x₀ * w, ?_, ?_⟩
    · apply mul_ne_zero _ hw_ne
      intro hx0
      have hx_v : Valued.v (ι x₀) = 1 :=
        (valued_algebraMap_eq_intValuation v x₀).trans hx₀_val
      rw [hx0, Valuation.map_zero] at hx_v
      exact zero_ne_one hx_v
    · have hd_map : ι d = ι c * (ι x₀) ^ 2 := by dsimp [d]; simp [map_mul, map_pow]
      change ι c * (ι x₀ * w) ^ 2 = ι c * (ι x₀) ^ 2 + ι r
      calc
        ι c * (ι x₀ * w) ^ 2 = (ι c * (ι x₀) ^ 2) * (w * w) := by ring
        _ = ι d * u := by rw [← hd_map, ← hw]
        _ = ι d + ι r * (ι d * (ι d)⁻¹) := by dsimp [u]; ring
        _ = ι c * (ι x₀) ^ 2 + ι r := by rw [hd_inv, mul_one, hd_map]
  have exists_normSym_of_resDyadic :
      ∀ (γ : R), γ ≠ 0 →
      ∀ (v : IsDedekindDomain.HeightOneSpectrum R),
        valNat v γ ≤ 1 → valNat v β ≤ 1 →
        (∃ x₀ y₀ z₀ : R,
          ¬ (x₀ ∈ v.asIdeal ∧ y₀ ∈ v.asIdeal ∧ z₀ ∈ v.asIdeal) ∧
          x₀ ^ 2 - β * y₀ ^ 2 - γ * z₀ ^ 2 ∈
            v.asIdeal ^ (2 * valNat v (2 : R) + 2)) →
        ∃ X Y : v.adicCompletion K,
          X ^ 2 - algebraMap K (v.adicCompletion K) (algebraMap R K β) * Y ^ 2 =
            algebraMap K (v.adicCompletion K) (algebraMap R K γ) := by
    intro γ hγ v hγ_le hβ_le ⟨x₀, y₀, z₀, h_prim, hr⟩
    let ι : R →+* v.adicCompletion K := (algebraMap K (v.adicCompletion K)).comp (algebraMap R K)
    let r : R := x₀ ^ 2 - β * y₀ ^ 2 - γ * z₀ ^ 2
    have hr_map : ι r = (ι x₀) ^ 2 - ι β * (ι y₀) ^ 2 - ι γ * (ι z₀) ^ 2 := by
      dsimp [r]; simp [map_sub, map_mul, map_pow]
    have h_homog : ∃ X₀ Y₀ Z₀ : v.adicCompletion K,
        ¬ (X₀ = 0 ∧ Y₀ = 0 ∧ Z₀ = 0) ∧
        X₀ ^ 2 - ι β * Y₀ ^ 2 - ι γ * Z₀ ^ 2 = 0 := by
      by_cases hx : x₀ ∉ v.asIdeal
      · have h1_ne : (1 : R) ≠ 0 := one_ne_zero
        have h1_le : valNat v (1 : R) ≤ 1 := by
          have h1_val : v.intValuation (1 : R) = 1 := map_one _
          have h0 : valNat v (1 : R) = 0 := by unfold valNat; rw [h1_val, WithZero.log_one]; rfl
          omega
        have h_neg_r : -r ∈ v.asIdeal ^ (2 * valNat v (2 : R) + 2) :=
          (v.asIdeal ^ (2 * valNat v (2 : R) + 2)).neg_mem hr
        obtain ⟨W, hW_ne, hW_eq⟩ :=
          exists_sq_mul_eq_add_of_mem_pow v 1 x₀ (-r) h1_ne h1_le hx h_neg_r
        change ι 1 * W ^ 2 = ι 1 * (ι x₀) ^ 2 + ι (-r) at hW_eq
        rw [map_one, one_mul, one_mul, map_neg, hr_map] at hW_eq
