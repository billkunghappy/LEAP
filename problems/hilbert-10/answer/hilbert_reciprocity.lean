  rw [h_dyad, h_odd₁, h_odd₂, h_real, h_res₁, h_res₂, h_rec]

theorem normSym_dyadic_eq_tameSym_odd_mul_real_sign {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    haveI := Classical.propDecidable
    (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          normSym v α β
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal then
          tameSym v α β
        else 1) *
      (∏ w : NumberField.InfinitePlace K,
        if w.IsReal ∧
            (w.embedding (algebraMap (NumberField.RingOfIntegers K) K α)).re < 0 ∧
            (w.embedding (algebraMap (NumberField.RingOfIntegers K) K β)).re < 0 then
          (-1 : ℤˣ)
        else 1) :=
by
  obtain ⟨x, y, hδ, h_disj⟩ := exists_norm_mul_disjoint_odd_valNat α β hα hβ
  have hα' : α * (x ^ 2 - β * y ^ 2) ≠ 0 := mul_ne_zero hα hδ
  obtain ⟨h_dyad, h_odd, h_real⟩ := norm_mul_invariance α β x y hα hβ hδ
  have h_split := oddTameProd_of_disjoint_odd_valNat (α * (x ^ 2 - β * y ^ 2)) β hα' hβ h_disj
  have h_rec := dyadicProd_eq_oddQuadProd_mul_realSignProd_of_disjoint
    (α * (x ^ 2 - β * y ^ 2)) β hα' hβ h_disj
  have h_goal : dyadicProd α β = oddTameProd α β * realSignProd α β := by
    calc dyadicProd α β
      _ = dyadicProd (α * (x ^ 2 - β * y ^ 2)) β := h_dyad.symm
      _ = oddQuadProd (α * (x ^ 2 - β * y ^ 2)) β *
            oddQuadProd β (α * (x ^ 2 - β * y ^ 2)) *
            realSignProd (α * (x ^ 2 - β * y ^ 2)) β := h_rec
      _ = oddTameProd (α * (x ^ 2 - β * y ^ 2)) β *
            realSignProd (α * (x ^ 2 - β * y ^ 2)) β := by rw [← h_split]
      _ = oddTameProd α β * realSignProd α β := by rw [h_odd, h_real]
  exact h_goal

theorem hilbFin_dyadic_eq_odd_mul_real_sign {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    haveI := Classical.propDecidable
    (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
            (algebraMap (NumberField.RingOfIntegers K) K β)
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal then
          hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
            (algebraMap (NumberField.RingOfIntegers K) K β)
        else 1) *
      (∏ w : NumberField.InfinitePlace K,
        if w.IsReal ∧
            (w.embedding (algebraMap (NumberField.RingOfIntegers K) K α)).re < 0 ∧
            (w.embedding (algebraMap (NumberField.RingOfIntegers K) K β)).re < 0 then
          (-1 : ℤˣ)
        else 1) :=
by
  letI := Classical.propDecidable
  have h_dyadic :
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
            (algebraMap (NumberField.RingOfIntegers K) K β)
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then normSym v α β else 1) := by
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos h2v, if_pos h2v]
      exact hilbFin_eq_normSym v α β hα hβ
    · rw [if_neg h2v, if_neg h2v]
  have h_odd :
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal then
          hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
            (algebraMap (NumberField.RingOfIntegers K) K β)
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal then
          tameSym v α β
        else 1) := by
    refine finprod_congr (fun v => ?_)
    by_cases h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · have h1 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal) := not_not.mpr h2v
      have h2 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal) :=
        fun h => h.1 h2v
      rw [if_neg h1, if_neg h2]
    · rw [if_pos h2v, hilbFin_eq_tameSym_of_two_not_mem v h2v α β hα hβ]
      by_cases hab : α * β ∈ v.asIdeal
      · rw [if_pos ⟨h2v, hab⟩]
      · have h2 : ¬ ((2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal) :=
          fun h => hab h.2
        rw [if_neg h2, tameSym_eq_one_of_not_mem_asIdeal v α β hab]
  rw [h_dyadic]
  refine Eq.trans (normSym_dyadic_eq_tameSym_odd_mul_real_sign α β hα hβ) ?_
  congr 1
  convert h_odd.symm

theorem hilbert_reciprocity_ringOfIntegers {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
          (algebraMap (NumberField.RingOfIntegers K) K β)) *
      (∏ w : NumberField.InfinitePlace K,
        hilbInf w (algebraMap (NumberField.RingOfIntegers K) K α)
          (algebraMap (NumberField.RingOfIntegers K) K β)) = 1 :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let a : K := algebraMap R K α
  let b : K := algebraMap R K β
  have ha : a ≠ 0 := (IsFractionRing.injective R K).ne hα
  have hb : b ≠ 0 := (IsFractionRing.injective R K).ne hβ
  have h2 : (2 : R) ≠ 0 := two_ne_zero
  have hγ : 2 * α * β ≠ 0 := mul_ne_zero (mul_ne_zero h2 hα) hβ
  have hfin : (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum R =>
      hilbFin v a b)).Finite := by
    refine (finite_mem_asIdeal_of_ne_zero (2 * α * β) hγ).subset ?_
    intro v hv
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (hilbFin_eq_one_of_not_mem_asIdeal α β v hnot)
  have hfin_dyadic : (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum R =>
      if (2 : R) ∈ v.asIdeal then hilbFin v a b else 1)).Finite := by
    refine hfin.subset ?_
    intro v hv
    rw [Function.mem_mulSupport] at hv ⊢
    intro h1
    apply hv
    rw [h1, ite_self]
  have hfin_odd : (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum R =>
      if (2 : R) ∉ v.asIdeal then hilbFin v a b else 1)).Finite := by
    refine hfin.subset ?_
    intro v hv
    rw [Function.mem_mulSupport] at hv ⊢
    intro h1
    apply hv
    rw [h1, ite_self]
  have hsplit_v : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
      hilbFin v a b =
        (if (2 : R) ∈ v.asIdeal then hilbFin v a b else 1) *
        (if (2 : R) ∉ v.asIdeal then hilbFin v a b else 1) := by
    intro v
    by_cases h2v : (2 : R) ∈ v.asIdeal <;> simp [h2v]
  have hprod_fin :
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R, hilbFin v a b) =
        (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R,
          if (2 : R) ∈ v.asIdeal then hilbFin v a b else 1) *
        (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R,
          if (2 : R) ∉ v.asIdeal then hilbFin v a b else 1) := by
    rw [finprod_congr hsplit_v, finprod_mul_distrib hfin_dyadic hfin_odd]
  have hprod_inf :
      (∏ w : NumberField.InfinitePlace K, hilbInf w a b) =
        (∏ w : NumberField.InfinitePlace K,
          if w.IsReal ∧ (w.embedding a).re < 0 ∧ (w.embedding b).re < 0 then (-1 : ℤˣ) else 1) := by
    refine Finset.prod_congr rfl ?_
    intro w _
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [hilbInf_of_isReal w hw a b ha hb]
      by_cases hneg : (w.embedding a).re < 0 ∧ (w.embedding b).re < 0 <;> simp [hw, hneg]
    · have hnotR : ¬w.IsReal := fun hR =>
        (NumberField.InfinitePlace.not_isComplex_iff_isReal.mpr hR) hw
      rw [hilbInf_eq_one_of_isComplex w hw a b ha]
      simp [hnotR]
  rw [hprod_fin, hprod_inf, hilbFin_dyadic_eq_odd_mul_real_sign α β hα hβ]
  have hcancel : ∀ x y : ℤˣ, x * y * x * y = 1 := fun x y => by
    calc
      x * y * x * y = (x * x) * (y * y) := by ac_rfl
      _ = 1 * 1 := by rw [Int.units_mul_self x, Int.units_mul_self y]
      _ = 1 := mul_one 1
  convert hcancel
    (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum R,
      if (2 : R) ∉ v.asIdeal then hilbFin v a b else 1)
    (∏ w : NumberField.InfinitePlace K,
      if w.IsReal ∧ (w.embedding a).re < 0 ∧ (w.embedding b).re < 0 then (-1 : ℤˣ) else 1)

theorem hilbert_reciprocity {K : Type u} [Field K] [NumberField K] (a b : Kˣ) :
    (Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers K) => hilbFin v (a : K) (b : K))).Finite ∧
    (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        hilbFin v (a : K) (b : K)) *
      (∏ w : NumberField.InfinitePlace K, hilbInf w (a : K) (b : K)) = 1 :=
by
  obtain ⟨s, α, hα, ha⟩ := exists_mul_sq_eq_algebraMap a
  obtain ⟨t, β, hβ, hb⟩ := exists_mul_sq_eq_algebraMap b
  have hFin : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      hilbFin v (a : K) (b : K) =
        hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
          (algebraMap (NumberField.RingOfIntegers K) K β) := by
    intro v
    rw [← hilbFin_mul_sq v (a : K) (b : K) s t, ha, hb]
  have hInf : ∀ w : NumberField.InfinitePlace K,
      hilbInf w (a : K) (b : K) =
        hilbInf w (algebraMap (NumberField.RingOfIntegers K) K α)
          (algebraMap (NumberField.RingOfIntegers K) K β) := by
    intro w
    rw [← hilbInf_mul_sq w (a : K) (b : K) s t, ha, hb]
  constructor
  · have h2 : (2 : NumberField.RingOfIntegers K) ≠ 0 := two_ne_zero
    have hγ : 2 * α * β ≠ 0 := mul_ne_zero (mul_ne_zero h2 hα) hβ
    apply (finite_mem_asIdeal_of_ne_zero (2 * α * β) hγ).subset
    intro v hv
    rw [Function.mem_mulSupport, hFin v] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (hilbFin_eq_one_of_not_mem_asIdeal α β v hnot)
  · simp_rw [hFin, hInf]
    exact hilbert_reciprocity_ringOfIntegers α β hα hβ
