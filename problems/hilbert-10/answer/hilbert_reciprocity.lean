        have h_pos_val : 0 < (r i).val := Nat.pos_of_ne_zero (fun h0 => hri ((ZMod.val_eq_zero (r i)).mp h0))
        have h_lt_val : (r i).val < c_lat := ZMod.val_lt (r i)
        have h_pos_z : (0 : ℤ) < ((r i).val : ℤ) := Nat.cast_pos.mpr h_pos_val
        have h_lt_z : ((r i).val : ℤ) < (c_lat : ℤ) := Nat.cast_lt.mpr h_lt_val
