        by_cases hβ_in : β ∈ v.asIdeal
        · rw [(hx₀_mem hβ_in).1, zero_mul]
          exact (v.asIdeal ^ (m + 1 - e)).zero_mem
        · have h_bound : m + 1 - e = 0 ∨ 2 * k₀ + 2 * (m + 1 - e) ≤ l_crit + 1 := by
            have := hl_crit_out hβ_in
            omega
