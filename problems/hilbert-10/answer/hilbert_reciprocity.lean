  have hM_pos : 0 < dyadicGaussModulus K := by
    unfold dyadicGaussModulus
    have hnorm2 : Algebra.norm ℤ (2 : NumberField.RingOfIntegers K) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr h2_ne
    positivity
  have hD_pos : 0 < oddPfisterModulus α β := by
    unfold oddPfisterModulus oddPartNat
    have hnorm_ab : Algebra.norm ℤ (α * β) ≠ 0 :=
      Algebra.norm_ne_zero_iff.mpr hab_ne
    have hn_pos : 0 < (Algebra.norm ℤ (α * β)).natAbs :=
      Int.natAbs_pos.mpr hnorm_ab
    exact pow_pos (Nat.div_pos (Nat.le_of_dvd hn_pos (Nat.ordProj_dvd _ 2)) (by positivity)) _
  have hC_pos : 0 < coprimeDiscrModulus α β := by
    unfold coprimeDiscrModulus coprimePartNat
    have hd_pos : 0 < (NumberField.discr K).natAbs :=
      Int.natAbs_pos.mpr (NumberField.discr_ne_zero K)
    exact pow_pos (Nat.div_pos (Nat.le_of_dvd hd_pos (Nat.gcd_dvd_left _ _))
      (Nat.gcd_pos_of_pos_left _ hd_pos)) _
  have hN_pos : 0 < fullPfisterModulus α β := mul_pos (mul_pos hM_pos hD_pos) hC_pos
  have hN4_pos : 0 < fullPfisterModulus α β / 4 := by
    have h_eq := Nat.mul_div_cancel' h4_dvd
    omega
  have hN4_ne : ((fullPfisterModulus α β / 4 : ℕ) : NumberField.RingOfIntegers K) ≠ 0 :=
    Nat.cast_ne_zero.mpr (ne_of_gt hN4_pos)
  have h_mem := s2 γ ((fullPfisterModulus α β / 4 : ℕ) : NumberField.RingOfIntegers K)
    hγ_ne hN4_ne s4
  exact s1 (fullPfisterModulus α β) h4_dvd γ hγ_ne h_mem i

theorem traceGaussSum_eq_mul_prod_ratIntGaussSum_of_orthogonal_dual {K : Type u} [Field K] [NumberField K]
    (N : ℕ) (γ : NumberField.RingOfIntegers K) (hN_pos : 0 < N) (h8_dvd : 8 ∣ N)
    (e : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K) (c₀ : ℕ) (hc₀_pos : 0 < c₀)
    (h_ortho : ∀ i j : Fin (Module.finrank ℚ K), i ≠ j →
      Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * e i * e j) = 0)
    (h_ne : ∀ j : Fin (Module.finrank ℚ K),
      Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2) ≠ 0)
    (h_sublat : ∀ x : NumberField.RingOfIntegers K,
      ∃ z : Fin (Module.finrank ℚ K) → ℤ,
        (c₀ : NumberField.RingOfIntegers K) * x =
          ∑ j : Fin (Module.finrank ℚ K), (z j : NumberField.RingOfIntegers K) * e j)
    (h_dual : ∀ i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K),
      ∃ v : NumberField.RingOfIntegers K,
        ((N : ℤ) ∣ Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * v ^ 2)) ∧
        (∀ x : NumberField.RingOfIntegers K,
          2 * Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * x * v) =
            (N : ℤ) * ((NumberField.RingOfIntegers.basis K).repr x i))) :
    ∃ (m : ℕ) (c : ℝ),
      0 < m ∧ 0 < c ∧
      (∀ j : Fin (Module.finrank ℚ K),
        8 * (Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2)).natAbs ∣ m) ∧
      traceGaussSum N γ =
        (c : ℂ) * ∏ j : Fin (Module.finrank ℚ K),
          ratIntGaussSum m (Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let ι := Module.Free.ChooseBasisIndex ℤ R
  let b := NumberField.RingOfIntegers.basis K
  let d : Fin (Module.finrank ℚ K) → ℤ :=
    fun j => Algebra.trace ℤ R (γ * (e j) ^ 2)
  let P : ℕ := ∏ j : Fin (Module.finrank ℚ K), (d j).natAbs
  let c_lat : ℕ := c₀ * P
  let m : ℕ := N * c_lat ^ 2
  have hP_pos : 0 < P :=
    Finset.prod_pos (fun j _ => Int.natAbs_pos.mpr (h_ne j))
  have hc_pos : 0 < c_lat := mul_pos hc₀_pos hP_pos
  have hm_pos : 0 < m := mul_pos hN_pos (pow_pos hc_pos 2)
  have hdvd_m : ∀ j : Fin (Module.finrank ℚ K), 8 * (d j).natAbs ∣ m := by
    intro j
    have hd_P : (d j).natAbs ∣ P :=
      Finset.dvd_prod_of_mem (fun k => (d k).natAbs) (Finset.mem_univ j)
    have hd_c : (d j).natAbs ∣ c_lat := dvd_mul_of_dvd_right hd_P c₀
    have hd_c2 : (d j).natAbs ∣ c_lat ^ 2 := by
      rw [sq]
      exact dvd_mul_of_dvd_left hd_c c_lat
    exact mul_dvd_mul h8_dvd hd_c2
  have h_sublat_c : ∀ x : R,
      ∃ u : Fin (Module.finrank ℚ K) → ℤ,
        (c_lat : R) * x = ∑ j : Fin (Module.finrank ℚ K), (u j : R) * e j := by
    intro x
    obtain ⟨z₀, hz₀⟩ := h_sublat x
    let u : Fin (Module.finrank ℚ K) → ℤ := fun j => (P : ℤ) * z₀ j
    refine ⟨u, ?_⟩
    calc (c_lat : R) * x
      _ = (P : R) * ((c₀ : R) * x) := by dsimp [c_lat]; push_cast; ring
      _ = (P : R) * ∑ j : Fin (Module.finrank ℚ K), (z₀ j : R) * e j := by rw [hz₀]
      _ = ∑ j : Fin (Module.finrank ℚ K), (u j : R) * e j := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          dsimp [u]
          push_cast
          ring
  letI : NeZero m := ⟨ne_of_gt hm_pos⟩
  letI : NeZero c_lat := ⟨ne_of_gt hc_pos⟩
  let A := Fin (Module.finrank ℚ K) → ZMod m
  let Φ : A → R := fun z => ∑ j : Fin (Module.finrank ℚ K), ((z j).val : R) * e j
  let ψ : A → ℂ := fun z =>
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ R (γ * (Φ z) ^ 2) : ℤ) : ℂ) / (m : ℂ))
  have h_tr_nat : ∀ (k : ℕ) (x : R),
      Algebra.trace ℤ R ((k : R) * x) = (k : ℤ) * Algebra.trace ℤ R x := by
    intro k x
    rw [← nsmul_eq_mul, map_nsmul, nsmul_eq_mul]
  have h_tr_two : ∀ (x : R),
      Algebra.trace ℤ R (2 * x) = 2 * Algebra.trace ℤ R x := by
    intro x
    exact_mod_cast h_tr_nat 2 x
  have h1 : (∏ j : Fin (Module.finrank ℚ K), ratIntGaussSum m (d j)) = ∑ z : A, ψ z := by
    let e_fin : ZMod m ≃ Fin m :=
      { toFun := fun a => ⟨a.val, ZMod.val_lt a⟩
        invFun := fun z => (z.val : ZMod m)
        left_inv := fun a => ZMod.natCast_zmod_val a
        right_inv := fun z => Fin.ext (ZMod.val_cast_of_lt z.isLt) }
    have h_reindex : ∀ d₀ : ℤ,
        ratIntGaussSum m d₀ =
          ∑ a : ZMod m, Complex.exp (2 * Real.pi * Complex.I * (d₀ : ℂ) * ((a.val : ℕ) : ℂ) ^ 2 / (m : ℂ)) := by
      intro d₀
      unfold ratIntGaussSum
      exact (Equiv.sum_comp e_fin (fun z : Fin m =>
        Complex.exp (2 * Real.pi * Complex.I * (d₀ : ℂ) * ((z : ℕ) : ℂ) ^ 2 / (m : ℂ)))).symm
    simp_rw [h_reindex]
    rw [Fintype.prod_sum]
    refine Finset.sum_congr rfl (fun z _ => ?_)
    dsimp [ψ]
    rw [← Complex.exp_sum]
    congr 1
    have h_trace :
        Algebra.trace ℤ R (γ * (Φ z) ^ 2) =
        ∑ j : Fin (Module.finrank ℚ K), d j * ((z j).val : ℤ) ^ 2 := by
      have h_expand :
          γ * (Φ z) ^ 2 =
          ∑ i : Fin (Module.finrank ℚ K), ∑ j : Fin (Module.finrank ℚ K),
            (((z i).val * (z j).val : ℕ) : R) * (γ * e i * e j) := by
        dsimp [Φ]
        rw [sq, Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        push_cast
        ring
      rw [h_expand, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_sum]
      rw [Finset.sum_eq_single i]
      · have h_ei : γ * e i * e i = γ * (e i) ^ 2 := by ring
        rw [h_tr_nat ((z i).val * (z i).val) (γ * e i * e i), h_ei]
        dsimp [d]
        push_cast
        ring
      · intro j _ hji
        rw [h_tr_nat ((z i).val * (z j).val) (γ * e i * e j), h_ortho i j (Ne.symm hji), mul_zero]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    rw [h_trace]
    push_cast
    rw [← Finset.sum_div]
    congr 1
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring
  have h2 : ∀ i : ι, ∃ w : A, ∀ z : A,
      (∃ y' : R, Φ (z + w) - Φ z = (c_lat : R) * y') ∧
      ψ (z + w) = ψ z *
        Complex.exp (2 * Real.pi * Complex.I * ((b.repr (Φ z) i : ℤ) : ℂ) / (c_lat : ℂ)) := by
    intro i
    obtain ⟨v, ⟨k_v, hv_quad⟩, hv_lin⟩ := h_dual i
    obtain ⟨u, hu⟩ := h_sublat_c v
    let w : A := fun j => (u j : ZMod m)
    refine ⟨w, fun z => ?_⟩
    have h_dvd : ∀ j : Fin (Module.finrank ℚ K),
        (m : ℤ) ∣ (((z + w) j).val : ℤ) - (((z j).val : ℤ) + u j) := by
      intro j
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast
      change (((z j + w j).val : ZMod m) - (((z j).val : ZMod m) + (u j : ZMod m))) = 0
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
