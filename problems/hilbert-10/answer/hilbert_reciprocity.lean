        mem_of_d0_mul_sq_mem_pow y_star (m₀ - k₀) (2 * m₀) (by omega) hd0y_star2_2m0
      have hd0y_star2_odd : d₀ * y_star ^ 2 ∈ v.asIdeal ^ (2 * m₀ + 1) :=
        d0_mul_sq_mem_odd_of_mem_even y_star m₀ hd0y_star2_2m0
      have h2x0uy_star : 2 * x₀ * u_star * y_star ∈ v.asIdeal ^ (2 * m₀ + 1) :=
        two_mul_mem_pow x₀ u_star y_star m₀ (m₀ - k₀) (2 * m₀ + 1) hu_star_m0 hy_star_mk0 (by omega)
      have hu_conc : ∀ x y : R,
          γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) →
          (x - x₀ * y) - u_star ∈ v.asIdeal ^ (m₀ + 1) ∧ y ∈ v.asIdeal ^ (m₀ - k₀) := by
        intro x y hxy
        let u : R := x - x₀ * y
        have hq_2m0 : (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ (2 * m₀) := by
          have hid : (u + x₀ * y) ^ 2 - β * y ^ 2 = x ^ 2 - β * y ^ 2 := by dsimp [u]; ring
          rw [hid, ← hl_eq]
          exact h_fiber_mem_l x y hxy
        obtain ⟨hu2_2m0, hd0y2_2m0⟩ := (h_qdiag u y (2 * m₀)).mp hq_2m0
        have hu_m0 : u ∈ v.asIdeal ^ m₀ := mem_of_sq_mem_pow u m₀ (2 * m₀) (by omega) hu2_2m0
        have hy_mk0 : y ∈ v.asIdeal ^ (m₀ - k₀) :=
          mem_of_d0_mul_sq_mem_pow y (m₀ - k₀) (2 * m₀) (by omega) hd0y2_2m0
        have hd0y2_odd : d₀ * y ^ 2 ∈ v.asIdeal ^ (2 * m₀ + 1) :=
          d0_mul_sq_mem_odd_of_mem_even y m₀ hd0y2_2m0
        have h2x0uy : 2 * x₀ * u * y ∈ v.asIdeal ^ (2 * m₀ + 1) :=
          two_mul_mem_pow x₀ u y m₀ (m₀ - k₀) (2 * m₀ + 1) hu_m0 hy_mk0 (by omega)
        have h_q_diff : (x ^ 2 - β * y ^ 2) - (x_star ^ 2 - β * y_star ^ 2) ∈ v.asIdeal ^ (2 * m₀ + 1) :=
          hl_eq ▸ h_fiber_diff_l1 x y hxy
        have hu2_sub : u ^ 2 - u_star ^ 2 ∈ v.asIdeal ^ (2 * m₀ + 1) := by
          have hid : u ^ 2 - u_star ^ 2 =
              (((x ^ 2 - β * y ^ 2) - (x_star ^ 2 - β * y_star ^ 2)) - d₀ * y ^ 2 + d₀ * y_star ^ 2) -
              2 * x₀ * u * y + 2 * x₀ * u_star * y_star := by dsimp [u, u_star, d₀]; ring
          rw [hid]
          exact (v.asIdeal ^ (2 * m₀ + 1)).add_mem
            ((v.asIdeal ^ (2 * m₀ + 1)).sub_mem
              ((v.asIdeal ^ (2 * m₀ + 1)).add_mem
                ((v.asIdeal ^ (2 * m₀ + 1)).sub_mem h_q_diff hd0y2_odd)
                hd0y_star2_odd)
              h2x0uy)
            h2x0uy_star
        exact ⟨sub_mem_succ_of_sq_sub_mem u u_star m₀ hu_m0 hu_star_m0 hu2_sub, hy_mk0⟩
      by_cases hβ_in : β ∈ v.asIdeal
      · obtain ⟨hx₀_0, _⟩ := hx₀_mem hβ_in
        have h1_mem0 : (1 : R) ^ 2 - β * 0 ^ 2 ∈ v.asIdeal ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
        have h_ineq : 2 * m₀ + 2 * e + 2 ≤ n + 0 := by
          have := hl_crit_in hβ_in
          omega
        refine h_shift_of_conc 1 0 u_star m₀ 0 h1_mem0 hu_star_ne rfl (by omega) h_ineq (fun x y hxy => ?_)
        have hu_diff := (hu_conc x y hxy).1
        have hid : (1 * x - β * 0 * y) - u_star = (x - x₀ * y) - u_star := by rw [hx₀_0]; ring
        rw [hid]
        exact hu_diff
      · obtain ⟨hx₀_ne, hx₀_val⟩ := valNat_eq_zero_of_not_mem x₀ (hx₀_unit hβ_in)
        have hd0_mul_mk0 : ∀ z : R, z ∈ v.asIdeal ^ (m₀ - k₀) → d₀ * z ∈ v.asIdeal ^ (m₀ + 1) := by
          intro z hz
          have h1 : d₀ * z ∈ v.asIdeal ^ ((2 * k₀ + 1) + (m₀ - k₀)) := by
            rw [pow_add]
            exact Ideal.mul_mem_mul hd₀_mem hz
          exact Ideal.pow_le_pow_right (by omega : m₀ + 1 ≤ (2 * k₀ + 1) + (m₀ - k₀)) h1
        let w₀ : R := x₀ * x_star - β * y_star
        have hx0u_ne : x₀ * u_star ≠ 0 := mul_ne_zero hx₀_ne hu_star_ne
        have hx0u_val : valNat v (x₀ * u_star) = m₀ := by
          rw [valNat_mul x₀ u_star hx₀_ne hu_star_ne, hx₀_val, zero_add]
        have hw₀_sub : w₀ - x₀ * u_star ∈ v.asIdeal ^ (m₀ + 1) := by
          have hid : w₀ - x₀ * u_star = d₀ * y_star := by dsimp [w₀, u_star, d₀]; ring
          rw [hid]
          exact hd0_mul_mk0 y_star hy_star_mk0
        obtain ⟨hw₀_ne, hw₀_val⟩ := valNat_of_sub_mem_succ (x₀ * u_star) w₀ m₀ hx0u_ne hx0u_val hw₀_sub
        have hD_mem : x₀ ^ 2 - β * 1 ^ 2 ∈ v.asIdeal ^ (2 * k₀ + 1) := by
          simpa [d₀] using hd₀_mem
        have h_ineq : 2 * m₀ + 2 * e + 2 ≤ n + (2 * k₀ + 1) := by
          have := hl_crit_out hβ_in
          omega
        refine h_shift_of_conc x₀ 1 w₀ m₀ (2 * k₀ + 1) hD_mem hw₀_ne hw₀_val (by omega) h_ineq
          (fun x y hxy => ?_)
        obtain ⟨hu_diff, hy_mk0⟩ := hu_conc x y hxy
        have hid : (x₀ * x - β * 1 * y) - w₀ =
            x₀ * ((x - x₀ * y) - u_star) + d₀ * y - d₀ * y_star := by
          dsimp [w₀, u_star, d₀]; ring
        rw [hid]
        exact (v.asIdeal ^ (m₀ + 1)).sub_mem
          ((v.asIdeal ^ (m₀ + 1)).add_mem
            ((v.asIdeal ^ (m₀ + 1)).mul_mem_left x₀ hu_diff)
            (hd0_mul_mk0 y hy_mk0))
          (hd0_mul_mk0 y_star hy_star_mk0)
    · push_neg at h_even
      have hd0y_star2_not_l1 : d₀ * y_star ^ 2 ∉ v.asIdeal ^ (l + 1) :=
        fun h_in => h_not_both_l1 ⟨h_even, h_in⟩
      have hy_star_ne : y_star ≠ 0 := fun h0 => hd0y_star2_not_l1 (by simp [h0])
      let m₀ : ℕ := valNat v y_star
      have hy_star2_ne : y_star ^ 2 ≠ 0 := pow_ne_zero 2 hy_star_ne
      have hd0y_star2_ne : d₀ * y_star ^ 2 ≠ 0 := mul_ne_zero hd₀_ne hy_star2_ne
      have hd0y_star2_val : valNat v (d₀ * y_star ^ 2) = 2 * k₀ + 1 + 2 * m₀ := by
        rw [valNat_mul d₀ (y_star ^ 2) hd₀_ne hy_star2_ne, hd₀_val, valNat_pow y_star 2 hy_star_ne]
      have hl_eq : l = 2 * k₀ + 1 + 2 * m₀ := by
        have h_ge := (mem_pow_iff_le_valNat (d₀ * y_star ^ 2) l hd0y_star2_ne).mp hd0y_star2_l
        have h_not_ge : ¬ (l + 1 ≤ valNat v (d₀ * y_star ^ 2)) := by
          rw [← mem_pow_iff_le_valNat (d₀ * y_star ^ 2) (l + 1) hd0y_star2_ne]
          exact hd0y_star2_not_l1
        omega
      have hy_star_m0 : y_star ∈ v.asIdeal ^ m₀ :=
        (mem_pow_iff_le_valNat y_star m₀ hy_star_ne).mpr le_rfl
      have hu_star_mk1 : u_star ∈ v.asIdeal ^ (m₀ + k₀ + 1) :=
        mem_of_sq_mem_pow u_star (m₀ + k₀ + 1) (l + 1) (by omega) h_even
      have h2x0uy_star : 2 * x₀ * u_star * y_star ∈ v.asIdeal ^ (l + 1) :=
        two_mul_mem_pow x₀ u_star y_star (m₀ + k₀ + 1) m₀ (l + 1) hu_star_mk1 hy_star_m0 (by omega)
      have hy_conc : ∀ x y : R,
          γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) →
          y - y_star ∈ v.asIdeal ^ (m₀ + 1) ∧ x - x₀ * y ∈ v.asIdeal ^ (m₀ + k₀ + 1) := by
        intro x y hxy
        let u : R := x - x₀ * y
        have hq_l : (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ l := by
          have hid : (u + x₀ * y) ^ 2 - β * y ^ 2 = x ^ 2 - β * y ^ 2 := by dsimp [u]; ring
          rw [hid]
          exact h_fiber_mem_l x y hxy
        obtain ⟨hu2_l, hd0y2_l⟩ := (h_qdiag u y l).mp hq_l
        have hu_mk1 : u ∈ v.asIdeal ^ (m₀ + k₀ + 1) :=
          mem_of_sq_mem_pow u (m₀ + k₀ + 1) l (by omega) hu2_l
        have hu2_l1 : u ^ 2 ∈ v.asIdeal ^ (l + 1) := by
          have h1 : u ^ 2 ∈ v.asIdeal ^ ((m₀ + k₀ + 1) + (m₀ + k₀ + 1)) := by
            rw [sq, pow_add]
            exact Ideal.mul_mem_mul hu_mk1 hu_mk1
          exact Ideal.pow_le_pow_right (by omega : l + 1 ≤ (m₀ + k₀ + 1) + (m₀ + k₀ + 1)) h1
        have hy_m0 : y ∈ v.asIdeal ^ m₀ :=
          mem_of_d0_mul_sq_mem_pow y m₀ l (by omega) hd0y2_l
        have h2x0uy : 2 * x₀ * u * y ∈ v.asIdeal ^ (l + 1) :=
          two_mul_mem_pow x₀ u y (m₀ + k₀ + 1) m₀ (l + 1) hu_mk1 hy_m0 (by omega)
        have hd0_y2_sub : d₀ * (y ^ 2 - y_star ^ 2) ∈ v.asIdeal ^ (2 * k₀ + 1 + (2 * m₀ + 1)) := by
          have h_exp : 2 * k₀ + 1 + (2 * m₀ + 1) = l + 1 := by omega
          rw [h_exp]
          have hid : d₀ * (y ^ 2 - y_star ^ 2) =
              (((x ^ 2 - β * y ^ 2) - (x_star ^ 2 - β * y_star ^ 2)) - u ^ 2 + u_star ^ 2) -
              2 * x₀ * u * y + 2 * x₀ * u_star * y_star := by dsimp [u, u_star, d₀]; ring
          rw [hid]
          exact (v.asIdeal ^ (l + 1)).add_mem
            ((v.asIdeal ^ (l + 1)).sub_mem
              ((v.asIdeal ^ (l + 1)).add_mem
                ((v.asIdeal ^ (l + 1)).sub_mem (h_fiber_diff_l1 x y hxy) hu2_l1)
                h_even)
              h2x0uy)
            h2x0uy_star
        have hy2_sub : y ^ 2 - y_star ^ 2 ∈ v.asIdeal ^ (2 * m₀ + 1) :=
          mem_of_d0_mul_mem_pow (y ^ 2 - y_star ^ 2) (2 * m₀ + 1) hd0_y2_sub
        exact ⟨sub_mem_succ_of_sq_sub_mem y y_star m₀ hy_m0 hy_star_m0 hy2_sub, hu_mk1⟩
      by_cases hβ_in : β ∈ v.asIdeal
      · obtain ⟨hx₀_0, hk₀_0⟩ := hx₀_mem hβ_in
        let w₀ : R := x₀ * x_star - β * y_star
        have hw₀_eq : w₀ = d₀ * y_star := by dsimp [w₀, d₀]; rw [hx₀_0]; ring
        have hw₀_ne : w₀ ≠ 0 := by
          rw [hw₀_eq]
          exact mul_ne_zero hd₀_ne hy_star_ne
        have hw₀_val : valNat v w₀ = m₀ + 1 := by
          rw [hw₀_eq, valNat_mul d₀ y_star hd₀_ne hy_star_ne, hd₀_val]
          omega
        have hD_mem : x₀ ^ 2 - β * 1 ^ 2 ∈ v.asIdeal ^ (2 * k₀ + 1) := by
          simpa [d₀] using hd₀_mem
        have h_ineq : 2 * (m₀ + 1) + 2 * e + 2 ≤ n + (2 * k₀ + 1) := by
          have := hl_crit_in hβ_in
          omega
        refine h_shift_of_conc x₀ 1 w₀ (m₀ + 1) (2 * k₀ + 1) hD_mem hw₀_ne hw₀_val (by omega) h_ineq
          (fun x y hxy => ?_)
        have hy_diff := (hy_conc x y hxy).1
        have hd0_diff : d₀ * (y - y_star) ∈ v.asIdeal ^ ((2 * k₀ + 1) + (m₀ + 1)) := by
          rw [pow_add]
          exact Ideal.mul_mem_mul hd₀_mem hy_diff
        have hd0_le : d₀ * (y - y_star) ∈ v.asIdeal ^ ((m₀ + 1) + 1) :=
          Ideal.pow_le_pow_right (by omega : (m₀ + 1) + 1 ≤ (2 * k₀ + 1) + (m₀ + 1)) hd0_diff
        have hid : (x₀ * x - β * 1 * y) - w₀ = d₀ * (y - y_star) := by
          dsimp [w₀, d₀]; rw [hx₀_0]; ring
        rw [hid]
        exact hd0_le
      · obtain ⟨hx₀_ne, hx₀_val⟩ := valNat_eq_zero_of_not_mem x₀ (hx₀_unit hβ_in)
        have hu_star_m1 : u_star ∈ v.asIdeal ^ (m₀ + 1) :=
          Ideal.pow_le_pow_right (by omega : m₀ + 1 ≤ m₀ + k₀ + 1) hu_star_mk1
        have hx0y_ne : x₀ * y_star ≠ 0 := mul_ne_zero hx₀_ne hy_star_ne
        have hx0y_val : valNat v (x₀ * y_star) = m₀ := by
          rw [valNat_mul x₀ y_star hx₀_ne hy_star_ne, hx₀_val, zero_add]
        obtain ⟨hx_star_ne, hx_star_val⟩ :=
          valNat_of_sub_mem_succ (x₀ * y_star) x_star m₀ hx0y_ne hx0y_val hu_star_m1
        have h1_mem0 : (1 : R) ^ 2 - β * 0 ^ 2 ∈ v.asIdeal ^ 0 := by
          rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
        have h_ineq : 2 * m₀ + 2 * e + 2 ≤ n + 0 := by
          have := hl_crit_out hβ_in
          omega
        refine h_shift_of_conc 1 0 x_star m₀ 0 h1_mem0 hx_star_ne hx_star_val (by omega) h_ineq
          (fun x y hxy => ?_)
        obtain ⟨hy_diff, hu_mk1⟩ := hy_conc x y hxy
        have hu_m1 : x - x₀ * y ∈ v.asIdeal ^ (m₀ + 1) :=
          Ideal.pow_le_pow_right (by omega : m₀ + 1 ≤ m₀ + k₀ + 1) hu_mk1
        have hid : (1 * x - β * 0 * y) - x_star =
            (x - x₀ * y) - u_star + x₀ * (y - y_star) := by
          dsimp [u_star]; ring
        rw [hid]
        exact (v.asIdeal ^ (m₀ + 1)).add_mem
          ((v.asIdeal ^ (m₀ + 1)).sub_mem hu_m1 hu_star_m1)
          ((v.asIdeal ^ (m₀ + 1)).mul_mem_left x₀ hy_diff)
  · refine ⟨0, 0, fun x y h_or => False.elim ?_⟩
    rcases h_or with h1 | h2
    · exact h_ex ⟨x, y, h1⟩
    · rw [one_mul, add_zero, one_mul, add_zero] at h2
      exact h_ex ⟨x, y, h2⟩

theorem not_both_mem_crit_fiber_of_unitDyadicSym_eq_neg_one {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (α β x₀ : NumberField.RingOfIntegers K) (k₀ : ℕ)
    (hα_unit : α ∉ v.asIdeal) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1)
    (h_sym : unitDyadicSym v α β = -1)
    (hk₀ : k₀ < valNat v (2 : NumberField.RingOfIntegers K))
    (hd₀_ne : x₀ ^ 2 - β ≠ 0)
    (hd₀_val : valNat v (x₀ ^ 2 - β) = 2 * k₀ + 1)
    (hx₀_mem : β ∈ v.asIdeal → x₀ = 0 ∧ k₀ = 0)
    (hx₀_unit : β ∉ v.asIdeal → x₀ ∉ v.asIdeal)
    (h_qdiag : ∀ (u y : NumberField.RingOfIntegers K) (m : ℕ),
      (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ m ↔
        u ^ 2 ∈ v.asIdeal ^ m ∧ (x₀ ^ 2 - β) * y ^ 2 ∈ v.asIdeal ^ m)
    (n l_crit : ℕ) (hn_low : 2 * valNat v (2 : NumberField.RingOfIntegers K) + 1 ≤ n)
    (hl_crit_in : β ∈ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K))
    (hl_crit_out : β ∉ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K) + (2 * k₀ + 1))
    (c : NumberField.RingOfIntegers K)
    (hc_mem : c ∈ v.asIdeal ^ l_crit)
    (hc_not_mem : c ∉ v.asIdeal ^ (l_crit + 1))
    (x₁ y₁ x₂ y₂ : NumberField.RingOfIntegers K) :
    ¬ ((x₁ ^ 2 - β * y₁ ^ 2) - c ∈ v.asIdeal ^ n ∧
       α * (x₂ ^ 2 - β * y₂ ^ 2) - c ∈ v.asIdeal ^ n) :=
by
  rintro ⟨h₁, h₂⟩
  let R := NumberField.RingOfIntegers K
  let e : ℕ := valNat v (2 : R)
  let d₀ : R := x₀ ^ 2 - β
  have h2_ne : (2 : R) ≠ 0 := two_ne_zero
  have h1_unit : (1 : R) ∉ v.asIdeal :=
    fun h1 => v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1)
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have mem_pow_iff_le_valNat :
      ∀ (x : R) (m : ℕ), x ≠ 0 → (x ∈ v.asIdeal ^ m ↔ m ≤ valNat v x) := by
    intro x m hx
    rw [← v.intValuation_le_pow_iff_mem x m, intValuation_eq_exp_neg_valNat x hx,
      WithZero.exp_le_exp]
    omega
  have valNat_mul :
      ∀ (x y : R), x ≠ 0 → y ≠ 0 → valNat v (x * y) = valNat v x + valNat v y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h1 := intValuation_eq_exp_neg_valNat (x * y) hxy
    rw [map_mul, intValuation_eq_exp_neg_valNat x hx, intValuation_eq_exp_neg_valNat y hy,
      ← WithZero.exp_add] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have valNat_pow :
      ∀ (x : R) (k : ℕ), x ≠ 0 → valNat v (x ^ k) = k * valNat v x := by
    intro x k hx
    induction' k with k ih
    · have h1 : v.intValuation (1 : R) = WithZero.exp (0 : ℤ) := by simp
      have h2 := intValuation_eq_exp_neg_valNat (1 : R) one_ne_zero
      rw [h1] at h2
      have hinj := WithZero.exp_injective h2
      simp only [pow_zero, zero_mul]
      omega
    · rw [pow_succ', valNat_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
      ring
  have he_pos : 1 ≤ e :=
    (mem_pow_iff_le_valNat (2 : R) 1 h2_ne).mp (by simpa using h2v)
  have h_no_prim : ∀ x y z : R,
      ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) →
      x ^ 2 - β * y ^ 2 - α * z ^ 2 ∉ v.asIdeal ^ (2 * e + 1) := by
    intro x y z h_prim h_mem
    have h_pos : unitDyadicSym v α β = 1 := by
      dsimp [unitDyadicSym]
      exact if_pos ⟨x, y, z, h_prim, h_mem⟩
    rw [h_sym] at h_pos
    exact (by decide : (-1 : ℤˣ) ≠ 1) h_pos
  have pow_valNat_le_span_sup :
      ∀ (x : R) (m : ℕ),
        x ≠ 0 → 1 ≤ m → v.asIdeal ^ (valNat v x) ≤ Ideal.span {x} ⊔ v.asIdeal ^ m := by
    intro x m hx hm
    let k : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(k : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ k ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x k).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (k + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le := (mem_pow_iff_le_valNat x (k + 1) hx).mp hx_mem
      omega
    have h_coprime : IsCoprime J (v.asIdeal ^ m) := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ := Ideal.exists_le_maximal (J ⊔ v.asIdeal ^ m) h_ne_top
      have hJ_le_𝔪 : J ≤ 𝔪 := le_trans le_sup_left h_le_𝔪
