    let r₀ : R := ∑ j : Fin (Module.finrank ℚ K), (q j : R) * e j
    have hΦ : Φ (z + w) = Φ z + (c_lat : R) * v + (m : R) * r₀ := by
      have h_term : ∀ j : Fin (Module.finrank ℚ K),
          (((z + w) j).val : R) * e j =
            ((z j).val : R) * e j + (u j : R) * e j + (m : R) * ((q j : R) * e j) := by
        intro j
        have hqj : (((z + w) j).val : ℤ) = ((z j).val : ℤ) + u j + (m : ℤ) * q j := by
          linarith [hq j]
        have hqj_R : (((z + w) j).val : R) =
            ((z j).val : R) + (u j : R) + (m : R) * (q j : R) := by
