          _ = -Real.pi * (1 / a) * (n : ℂ) ^ 2 := by ring
          _ = -Real.pi * (4 * (K : ℂ) * Complex.I + 1 / d) * (n : ℂ) ^ 2 := by rw [h_one_div_a]
          _ = -Real.pi / d * (n : ℂ) ^ 2 + (-2 * (K : ℂ) * (n : ℂ) ^ 2) * (2 * Real.pi * Complex.I) := by ring
      rw [h_exp, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]
    have h_quad_d :
        (∑' m : ℤ, Complex.exp (-Real.pi * d * (m : ℂ) ^ 2)) =
