      rw [hd_eq_mul, Complex.log_ofReal_mul h16KT_pos hIa_ne,
        Complex.log_mul Complex.I_ne_zero ha_ne hI_arg]
    have h_log_I : Complex.log Complex.I = Real.pi * Complex.I / 2 := by
      rw [← Complex.re_add_im (Complex.log Complex.I), Complex.log_re, Complex.norm_I,
        Real.log_one, Complex.log_im, Complex.arg_I]
      push_cast
      ring
    have hd_cpow :
