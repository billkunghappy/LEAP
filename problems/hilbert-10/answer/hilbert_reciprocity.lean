  have h_s2 : resSum 1 * resSum (-1) = (Nat.card Fv : ℂ) := by
    let ψ0 : Fv → ℂ := fun z => f (Quotient.out z)
    have hψ0_mk : ∀ r : R, ψ0 (Ideal.Quotient.mk v.asIdeal r) = f r := by
      intro r
      apply hf_congr
      rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem, Ideal.Quotient.mk_out]
    have hψ0_add : ∀ a b : Fv, ψ0 (a + b) = ψ0 a * ψ0 b := by
      intro a b
      have h1 : a + b = Ideal.Quotient.mk v.asIdeal (Quotient.out a + Quotient.out b) := by
        rw [map_add, Ideal.Quotient.mk_out, Ideal.Quotient.mk_out]
      rw [h1, hψ0_mk, hf_add]
    have hψ0_zero : ψ0 0 = 1 := by
      have h0 : (0 : Fv) = Ideal.Quotient.mk v.asIdeal 0 := rfl
