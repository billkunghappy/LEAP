  have h_odd₁ : oddResQuadProd α β = oddResQuadProd α' β' := h_inv₁.2.1.symm.trans h_inv₂.2.1
  have h_odd₂ : oddResQuadProd β α = oddResQuadProd β' α' := h_inv₁.2.2.1.symm.trans h_inv₂.2.2.1
  have h_real : realSignProd α β = realSignProd α' β' := h_inv₁.2.2.2.symm.trans h_inv₂.2.2.2
