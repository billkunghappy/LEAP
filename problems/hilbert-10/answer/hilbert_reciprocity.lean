      have h0 := Complex.tsum_exp_neg_quadratic hd_re 0
      simpa using h0
    have h_quad_d' :
        (∑' n : ℤ, Complex.exp (-Real.pi / d * (n : ℂ) ^ 2)) =
          d ^ (1 / 2 : ℂ) * ∑' m : ℤ, Complex.exp (-Real.pi * d * (m : ℂ) ^ 2) := by
      rw [h_quad_d, ← mul_assoc, mul_one_div_cancel hd_cpow_ne, one_mul]
    have h_d_term : ∀ m : ℤ,
        Complex.exp (-Real.pi * d * (m : ℂ) ^ 2) =
          Complex.exp (-Real.pi * ((4 * T : ℝ) : ℂ) * (m : ℂ) ^ 2 +
            Complex.I * ((-Real.pi * (m : ℝ) ^ 2 / (4 * (K : ℝ)) : ℝ) : ℂ)) := by
      intro m
      congr 1
      dsimp [d]
      push_cast
      ring
    have ha_arg_abs : |a.arg| < Real.pi / 2 :=
      Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl ha_re)
    have ha_arg_bounds := abs_lt.mp ha_arg_abs
    have hI_arg : Complex.I.arg + a.arg ∈ Set.Ioc (-Real.pi) Real.pi := by
      rw [Complex.arg_I, Set.mem_Ioc]
      constructor <;> linarith [Real.pi_pos, ha_arg_bounds.1, ha_arg_bounds.2]
    have h16KT_pos : 0 < 16 * (K : ℝ) * T := by positivity
