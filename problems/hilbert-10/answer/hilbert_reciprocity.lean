      have h2_inv : (2 : v.adicCompletion K) * 2⁻¹ = 1 := mul_inv_cancel₀ h2F_ne
      refine ⟨(ι α + 1) * 2⁻¹, Y₀ * (ι α - 1) * X₀⁻¹ * 2⁻¹, ?_⟩
