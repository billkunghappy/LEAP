import Mathlib
import Hilbert10Defs
set_option maxHeartbeats 4000000

/-! ### Statement (originally `hilbert_reciprocity.lean`) -/

/--
**Hilbert reciprocity.** Let `K` be a number field and `a, b ∈ Kˣ`. Then
`(a, b)_v = 1` for all but finitely many finite places `v`, and
`∏_{v ∈ M_K} (a, b)_v = 1`, the product running over all places of `K`.
-/
noncomputable def normSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ := by
  classical
  exact if (∃ X Y : v.adicCompletion K,
      X ^ 2 - algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K β) * Y ^ 2 =
        algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K α))
    then 1 else -1

noncomputable def valNat {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α : NumberField.RingOfIntegers K) : ℕ :=
  (-WithZero.log (v.intValuation α)).toNat

noncomputable def tameSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ := by
  classical
  exact if IsSquare (algebraMap K (v.adicCompletion K)
    (algebraMap (NumberField.RingOfIntegers K) K
      ((-1) ^ (valNat v α * valNat v β) * α ^ valNat v β * β ^ valNat v α))) then 1 else -1
noncomputable def intNormSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ := by
  classical
  exact if (∃ (X Y : v.adicCompletionIntegers K) (d : NumberField.RingOfIntegers K),
      d ≠ 0 ∧
      (X : v.adicCompletion K) ^ 2 -
        algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K β) *
          (Y : v.adicCompletion K) ^ 2 =
        algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K (α * d ^ 2)))
    then 1 else -1

noncomputable def parityTameSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ := by
  classical
  exact if IsSquare (algebraMap K (v.adicCompletion K)
    (algebraMap (NumberField.RingOfIntegers K) K
      ((-1) ^ ((valNat v α % 2) * (valNat v β % 2)) *
        α ^ (valNat v β % 2) * β ^ (valNat v α % 2)))) then 1 else -1
noncomputable def dyadicProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then normSym v α β else 1

noncomputable def oddTameProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α * β ∈ v.asIdeal then
      tameSym v α β
    else 1

noncomputable def realSignProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ w : NumberField.InfinitePlace K,
    if w.IsReal ∧
        (w.embedding (algebraMap (NumberField.RingOfIntegers K) K α)).re < 0 ∧
        (w.embedding (algebraMap (NumberField.RingOfIntegers K) K β)).re < 0 then
      (-1 : ℤˣ)
    else 1

noncomputable def quadSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if IsSquare (algebraMap K (v.adicCompletion K)
    (algebraMap (NumberField.RingOfIntegers K) K γ)) then 1 else -1

noncomputable def oddQuadProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1 then
      quadSym v β
    else 1
noncomputable def resQuadSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if IsSquare (Ideal.Quotient.mk v.asIdeal γ) then 1 else -1

noncomputable def oddResQuadProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ valNat v α % 2 = 1 then
      resQuadSym v β
    else 1
noncomputable def resDyadicSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if (∃ x y z : NumberField.RingOfIntegers K,
      ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
      x ^ 2 - β * y ^ 2 - α * z ^ 2 ∈
        v.asIdeal ^ (2 * valNat v (2 : NumberField.RingOfIntegers K) + 2))
    then 1 else -1

noncomputable def resDyadicProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then resDyadicSym v α β else 1
noncomputable def oddPowResQuadProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
      (resQuadSym v β) ^ (valNat v α)
    else 1
noncomputable def unitDyadicSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if (∃ x y z : NumberField.RingOfIntegers K,
      ¬ (x ∈ v.asIdeal ∧ y ∈ v.asIdeal ∧ z ∈ v.asIdeal) ∧
      x ^ 2 - β * y ^ 2 - α * z ^ 2 ∈
        v.asIdeal ^ (2 * valNat v (2 : NumberField.RingOfIntegers K) + 1))
    then 1 else -1

noncomputable def unitDyadicProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal then unitDyadicSym v α β else 1
noncomputable def eulerQuadSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if γ ^ (Ideal.absNorm v.asIdeal / 2) - 1 ∈ v.asIdeal then 1 else -1

noncomputable def oddPowEulerQuadProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
      (eulerQuadSym v β) ^ (valNat v α)
    else 1
noncomputable def oddLocalGaussSum {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℂ :=
  letI := Classical.decEq (NumberField.RingOfIntegers K ⧸ v.asIdeal)
  letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
    Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  letI : Fintype (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
    Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ v.asIdeal)
  let χ : MulChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ℂ :=
    (quadraticChar (NumberField.RingOfIntegers K ⧸ v.asIdeal)).ringHomComp (Int.castRingHom ℂ)
  let ψ : AddChar (NumberField.RingOfIntegers K ⧸ v.asIdeal) ℂ :=
    AddChar.FiniteField.primitiveChar_to_Complex (NumberField.RingOfIntegers K ⧸ v.asIdeal)
  gaussSum χ (ψ.mulShift (Ideal.Quotient.mk v.asIdeal γ))

noncomputable def oddGaussSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if oddLocalGaussSum v γ = oddLocalGaussSum v 1 then 1 else -1

noncomputable def oddPowGaussProd {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
    if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
      (oddGaussSym v β) ^ (valNat v α)
    else 1

noncomputable def dyadicGaussModulus (K : Type u) [Field K] [NumberField K] : ℕ :=
  8 * (Algebra.norm ℤ (2 : NumberField.RingOfIntegers K)).natAbs ^ 2

noncomputable def dyadicTraceGaussSum {K : Type u} [Field K] [NumberField K]
    (γ : NumberField.RingOfIntegers K) : ℂ :=
  haveI := Classical.propDecidable
  let M : ℕ := dyadicGaussModulus K
  let I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(M : NumberField.RingOfIntegers K)}
  if hI : I ≠ ⊥ then
    haveI : Finite (NumberField.RingOfIntegers K ⧸ I) :=
      Ideal.finiteQuotientOfFreeOfNeBot I hI
    letI : Fintype (NumberField.RingOfIntegers K ⧸ I) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ I)
    ∑ x : NumberField.RingOfIntegers K ⧸ I,
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
        (M : ℂ))
  else 0

noncomputable def dyadicPfisterGaussSum {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℝ :=
  (dyadicTraceGaussSum (1 : NumberField.RingOfIntegers K) *
    dyadicTraceGaussSum (-α) *
    dyadicTraceGaussSum (-β) *
    dyadicTraceGaussSum (α * β)).re

noncomputable def dyadicGaussSign {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if 0 < dyadicPfisterGaussSum α β then 1 else -1

noncomputable def realEmbedSign {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) (γ : NumberField.RingOfIntegers K) : ℤ :=
  haveI := Classical.propDecidable
  if (w.embedding (algebraMap (NumberField.RingOfIntegers K) K γ)).re < 0 then -1 else 1

noncomputable def pfisterSignature {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℕ :=
  haveI := Classical.propDecidable
  ∑ w : NumberField.InfinitePlace K,
    if w.IsReal then
      ((1 - realEmbedSign w α) * (1 - realEmbedSign w β)).natAbs
    else 0

noncomputable def archPfisterSign {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  (-1 : ℤˣ) ^ (pfisterSignature α β / 4)
noncomputable def oddPartNat (n : ℕ) : ℕ :=
  n / 2 ^ n.factorization 2

noncomputable def oddPfisterModulus {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℕ :=
  (oddPartNat (Algebra.norm ℤ (α * β)).natAbs) ^ (2 * Module.finrank ℚ K + 2)

noncomputable def traceGaussSum {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (γ : NumberField.RingOfIntegers K) : ℂ :=
  haveI := Classical.propDecidable
  let I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(m : NumberField.RingOfIntegers K)}
  if hI : I ≠ ⊥ then
    haveI : Finite (NumberField.RingOfIntegers K ⧸ I) :=
      Ideal.finiteQuotientOfFreeOfNeBot I hI
    letI : Fintype (NumberField.RingOfIntegers K ⧸ I) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ I)
    ∑ x : NumberField.RingOfIntegers K ⧸ I,
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
        (m : ℂ))
  else 0

noncomputable def pfisterGaussSum {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (α β : NumberField.RingOfIntegers K) : ℝ :=
  (traceGaussSum m (1 : NumberField.RingOfIntegers K) *
    traceGaussSum m (-α) *
    traceGaussSum m (-β) *
    traceGaussSum m (α * β)).re

noncomputable def pfisterGaussSign {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (α β : NumberField.RingOfIntegers K) : ℤˣ :=
  haveI := Classical.propDecidable
  if 0 < pfisterGaussSum m α β then 1 else -1
def IsLocalDyadicIdempotent {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (e : NumberField.RingOfIntegers K) : Prop :=
  let M : ℕ := dyadicGaussModulus K
  let I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(M : NumberField.RingOfIntegers K)}
  let Iv : Ideal (NumberField.RingOfIntegers K) :=
    v.asIdeal ^ (valNat v (M : NumberField.RingOfIntegers K))
  1 - e ∈ Iv ∧ ∀ y ∈ Iv, e * y ∈ I

noncomputable def localDyadicIdempotent {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    NumberField.RingOfIntegers K :=
  haveI := Classical.propDecidable
  if h : ∃ e : NumberField.RingOfIntegers K, IsLocalDyadicIdempotent v e then
    Classical.choose h
  else 0

noncomputable def localDyadicTraceGaussSum {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℂ :=
  haveI := Classical.propDecidable
  let M : ℕ := dyadicGaussModulus K
  let Iv : Ideal (NumberField.RingOfIntegers K) :=
    v.asIdeal ^ (valNat v (M : NumberField.RingOfIntegers K))
  if hIv : Iv ≠ ⊥ then
    haveI : Finite (NumberField.RingOfIntegers K ⧸ Iv) :=
      Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
    letI : Fintype (NumberField.RingOfIntegers K ⧸ Iv) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ Iv)
    ∑ x : NumberField.RingOfIntegers K ⧸ Iv,
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localDyadicIdempotent v * γ * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
        (M : ℂ))
  else 0

noncomputable def localDyadicBinaryGaussSum {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ β : NumberField.RingOfIntegers K) : ℂ :=
  localDyadicTraceGaussSum v γ * localDyadicTraceGaussSum v (-γ * β)

noncomputable def localDyadicPfisterProd {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℂ :=
  localDyadicTraceGaussSum v (1 : NumberField.RingOfIntegers K) *
    localDyadicTraceGaussSum v (-α) *
    localDyadicTraceGaussSum v (-β) *
    localDyadicTraceGaussSum v (α * β)

noncomputable def localDyadicPosWeight {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℝ :=
  haveI := Classical.propDecidable
  if α ∉ v.asIdeal then
    Complex.normSq (localDyadicBinaryGaussSum v 1 β)
  else
    Complex.normSq (localDyadicBinaryGaussSum v 1 α)
def IsLocalModulusIdempotent {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (e : NumberField.RingOfIntegers K) : Prop :=
  let I : Ideal (NumberField.RingOfIntegers K) :=
    Ideal.span {(m : NumberField.RingOfIntegers K)}
  let Iv : Ideal (NumberField.RingOfIntegers K) :=
    v.asIdeal ^ (valNat v (m : NumberField.RingOfIntegers K))
  1 - e ∈ Iv ∧ ∀ y ∈ Iv, e * y ∈ I

noncomputable def localModulusIdempotent {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    NumberField.RingOfIntegers K :=
  haveI := Classical.propDecidable
  if h : ∃ e : NumberField.RingOfIntegers K, IsLocalModulusIdempotent m v e then
    Classical.choose h
  else 0

noncomputable def localModulusTraceGaussSum {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) : ℂ :=
  haveI := Classical.propDecidable
  let Iv : Ideal (NumberField.RingOfIntegers K) :=
    v.asIdeal ^ (valNat v (m : NumberField.RingOfIntegers K))
  if hIv : Iv ≠ ⊥ then
    haveI : Finite (NumberField.RingOfIntegers K ⧸ Iv) :=
      Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
    letI : Fintype (NumberField.RingOfIntegers K ⧸ Iv) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ Iv)
    ∑ x : NumberField.RingOfIntegers K ⧸ Iv,
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ (NumberField.RingOfIntegers K)
          (localModulusIdempotent m v * γ * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
        (m : ℂ))
  else 0

noncomputable def localModulusBinaryGaussSum {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ β : NumberField.RingOfIntegers K) : ℂ :=
  localModulusTraceGaussSum m v γ * localModulusTraceGaussSum m v (-γ * β)

noncomputable def localModulusPfisterProd {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℂ :=
  localModulusTraceGaussSum m v (1 : NumberField.RingOfIntegers K) *
    localModulusTraceGaussSum m v (-α) *
    localModulusTraceGaussSum m v (-β) *
    localModulusTraceGaussSum m v (α * β)

noncomputable def localOddPosWeight {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) : ℝ :=
  haveI := Classical.propDecidable
  let D : ℕ := oddPfisterModulus α β
  if β ∉ v.asIdeal then
    (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (valNat v α) *
      Complex.normSq (localModulusBinaryGaussSum D v 1 β)
  else
    (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (valNat v β) *
      Complex.normSq (localModulusBinaryGaussSum D v 1 α)
def coprimePartNat (d m : ℕ) : ℕ :=
  d / d.gcd (m ^ d)

noncomputable def coprimeDiscrModulus {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℕ :=
  (coprimePartNat (NumberField.discr K).natAbs
    (dyadicGaussModulus K * oddPfisterModulus α β)) ^ (2 * Module.finrank ℚ K + 2)

noncomputable def fullPfisterModulus {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) : ℕ :=
  dyadicGaussModulus K * oddPfisterModulus α β * coprimeDiscrModulus α β

noncomputable def traceSignature {K : Type u} [Field K] [NumberField K]
    (γ : NumberField.RingOfIntegers K) : ℤ :=
  haveI := Classical.propDecidable
  ∑ w : NumberField.InfinitePlace K,
    if w.IsReal then realEmbedSign w γ else 0

noncomputable def ratIntGaussSum (m : ℕ) (d : ℤ) : ℂ :=
  ∑ z : Fin m,
    Complex.exp (2 * Real.pi * Complex.I * (d : ℂ) * ((z : ℕ) : ℂ) ^ 2 / (m : ℂ))
noncomputable def dyadicNormFiberCard {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (n : ℕ) (γ β c : NumberField.RingOfIntegers K) : ℕ :=
  haveI := Classical.propDecidable
  let M : ℕ := dyadicGaussModulus K
  let Iv : Ideal (NumberField.RingOfIntegers K) :=
    v.asIdeal ^ (valNat v (M : NumberField.RingOfIntegers K))
  if hIv : Iv ≠ ⊥ then
    haveI : Finite (NumberField.RingOfIntegers K ⧸ Iv) :=
      Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
    letI : Fintype (NumberField.RingOfIntegers K ⧸ Iv) :=
      Fintype.ofFinite (NumberField.RingOfIntegers K ⧸ Iv)
    (Finset.univ.filter (fun p : (NumberField.RingOfIntegers K ⧸ Iv) ×
        (NumberField.RingOfIntegers K ⧸ Iv) =>
      γ * ((Quotient.out p.1) ^ 2 - β * (Quotient.out p.2) ^ 2) - c ∈
        v.asIdeal ^ n)).card
  else 0
def IsLocalModulusCharTrivialOnPow {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) (c : ℕ) : Prop :=
  ∀ z ∈ v.asIdeal ^ c,
    Complex.exp (2 * Real.pi * Complex.I *
      ((Algebra.trace ℤ (NumberField.RingOfIntegers K)
        (localModulusIdempotent m v * γ * z) : ℤ) : ℂ) / (m : ℂ)) = 1

def HasLocalModulusConductor {K : Type u} [Field K] [NumberField K]
    (m : ℕ) (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) (c : ℕ) : Prop :=
  c ≤ valNat v (m : NumberField.RingOfIntegers K) ∧
  IsLocalModulusCharTrivialOnPow m v γ c ∧
  (1 ≤ c → ¬ IsLocalModulusCharTrivialOnPow m v γ (c - 1))

theorem exists_mul_sq_eq_algebraMap {K : Type u} [Field K] [NumberField K] (a : Kˣ) :
    ∃ (s : Kˣ) (α : NumberField.RingOfIntegers K),
      α ≠ 0 ∧ (a : K) * (s : K) ^ 2 = algebraMap (NumberField.RingOfIntegers K) K α :=
by
  obtain ⟨⟨n, d⟩, hnd⟩ := IsLocalization.surj (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K)
  dsimp only at hnd
  have hd_ne : (d : NumberField.RingOfIntegers K) ≠ 0 := nonZeroDivisors.ne_zero d.prop
  have hdK_ne : algebraMap (NumberField.RingOfIntegers K) K (d : NumberField.RingOfIntegers K) ≠ 0 :=
    (map_ne_zero_iff (algebraMap (NumberField.RingOfIntegers K) K)
      (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hd_ne
  let s : Kˣ := Units.mk0 (algebraMap (NumberField.RingOfIntegers K) K (d : NumberField.RingOfIntegers K)) hdK_ne
  have hnK_ne : algebraMap (NumberField.RingOfIntegers K) K n ≠ 0 := by
    rw [← hnd]
    exact mul_ne_zero a.ne_zero hdK_ne
  have hn_ne : n ≠ 0 := by
    intro hn0
    apply hnK_ne
    rw [hn0, map_zero]
  refine ⟨s, n * (d : NumberField.RingOfIntegers K), mul_ne_zero hn_ne hd_ne, ?_⟩
  change (a : K) * (algebraMap (NumberField.RingOfIntegers K) K (d : NumberField.RingOfIntegers K)) ^ 2 =
    algebraMap (NumberField.RingOfIntegers K) K (n * (d : NumberField.RingOfIntegers K))
  rw [sq, ← mul_assoc, hnd, map_mul]

theorem hilbFin_mul_sq {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (a b : K) (s t : Kˣ) :
    hilbFin v (a * (s : K) ^ 2) (b * (t : K) ^ 2) = hilbFin v a b :=
by
  classical
  dsimp [hilbFin, hilbLoc]
  apply if_congr _ rfl rfl
  constructor
  · rintro ⟨x, y, hxy⟩
    refine ⟨algebraMap K (v.adicCompletion K) (s : K) * x,
      algebraMap K (v.adicCompletion K) (t : K) * y, ?_⟩
    simp only [map_mul, map_pow] at hxy
    linear_combination hxy
  · rintro ⟨x', y', hxy'⟩
    refine ⟨algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) * x',
      algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) * y', ?_⟩
    have hs : algebraMap K (v.adicCompletion K) (s : K) *
        algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    have ht : algebraMap K (v.adicCompletion K) (t : K) *
        algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    simp only [map_mul, map_pow]
    calc
      algebraMap K (v.adicCompletion K) a * algebraMap K (v.adicCompletion K) (s : K) ^ 2 *
          (algebraMap K (v.adicCompletion K) (↑s⁻¹ : K) * x') ^ 2 +
        algebraMap K (v.adicCompletion K) b * algebraMap K (v.adicCompletion K) (t : K) ^ 2 *
          (algebraMap K (v.adicCompletion K) (↑t⁻¹ : K) * y') ^ 2
      _ = algebraMap K (v.adicCompletion K) a *
            (algebraMap K (v.adicCompletion K) (s : K) *
              algebraMap K (v.adicCompletion K) (↑s⁻¹ : K)) ^ 2 * x' ^ 2 +
          algebraMap K (v.adicCompletion K) b *
            (algebraMap K (v.adicCompletion K) (t : K) *
              algebraMap K (v.adicCompletion K) (↑t⁻¹ : K)) ^ 2 * y' ^ 2 := by ring
      _ = algebraMap K (v.adicCompletion K) a * 1 ^ 2 * x' ^ 2 +
          algebraMap K (v.adicCompletion K) b * 1 ^ 2 * y' ^ 2 := by rw [hs, ht]
      _ = algebraMap K (v.adicCompletion K) a * x' ^ 2 +
          algebraMap K (v.adicCompletion K) b * y' ^ 2 := by ring
      _ = 1 := hxy'

theorem hilbInf_mul_sq {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) (a b : K) (s t : Kˣ) :
    hilbInf w (a * (s : K) ^ 2) (b * (t : K) ^ 2) = hilbInf w a b :=
by
  classical
  dsimp [hilbInf, hilbInfLoc]
  apply if_congr _ rfl rfl
  constructor
  · rintro ⟨x, y, h⟩
    refine ⟨algebraMap K w.Completion (s : K) * x, algebraMap K w.Completion (t : K) * y, ?_⟩
    rw [map_mul, map_pow, map_mul, map_pow] at h
    linear_combination h
  · rintro ⟨x, y, h⟩
    refine ⟨algebraMap K w.Completion ((s⁻¹ : Kˣ) : K) * x,
      algebraMap K w.Completion ((t⁻¹ : Kˣ) : K) * y, ?_⟩
    have hs : algebraMap K w.Completion (s : K) * algebraMap K w.Completion ((s⁻¹ : Kˣ) : K) = 1 := by
      rw [← map_mul, s.mul_inv, map_one]
    have ht : algebraMap K w.Completion (t : K) * algebraMap K w.Completion ((t⁻¹ : Kˣ) : K) = 1 := by
      rw [← map_mul, t.mul_inv, map_one]
    rw [map_mul, map_pow, map_mul, map_pow]
    calc
      algebraMap K w.Completion a * algebraMap K w.Completion (s : K) ^ 2 *
          (algebraMap K w.Completion ((s⁻¹ : Kˣ) : K) * x) ^ 2 +
        algebraMap K w.Completion b * algebraMap K w.Completion (t : K) ^ 2 *
          (algebraMap K w.Completion ((t⁻¹ : Kˣ) : K) * y) ^ 2
      _ = algebraMap K w.Completion a *
            (algebraMap K w.Completion (s : K) * algebraMap K w.Completion ((s⁻¹ : Kˣ) : K)) ^ 2 * x ^ 2 +
          algebraMap K w.Completion b *
            (algebraMap K w.Completion (t : K) * algebraMap K w.Completion ((t⁻¹ : Kˣ) : K)) ^ 2 * y ^ 2 := by
        ring
      _ = algebraMap K w.Completion a * x ^ 2 + algebraMap K w.Completion b * y ^ 2 := by
        rw [hs, ht]
        ring
      _ = 1 := h

theorem hilbFin_eq_one_of_not_mem_asIdeal {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h : 2 * α * β ∉ v.asIdeal) :
    hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
      (algebraMap (NumberField.RingOfIntegers K) K β) = 1 :=
by
  have hs1 : ∀ {F : Type u} [Field F] [Finite F] {a b : F},
      a ≠ 0 → b ≠ 0 → ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 := by
    intro F _ _ a b ha hb
    classical
    letI : Fintype F := Fintype.ofFinite F
    let f : F → F := fun x => x ^ 2
    let Sq : Finset F := Finset.univ.image f
    let U : Finset F := Finset.univ.erase 0
    have hU_card : U.card ≤ 2 * (U.image f).card := by
      apply Finset.card_le_mul_card_image U 2
      intro w hw
      rcases Finset.mem_image.mp hw with ⟨x₀, hx₀, rfl⟩
      have hsub : U.filter (fun x => f x = f x₀) ⊆ {x₀, -x₀} := by
        intro x hx
        rw [Finset.mem_filter] at hx
        have hsq : x ^ 2 = x₀ ^ 2 := hx.2
        rw [sq_eq_sq_iff_eq_or_eq_neg] at hsq
        rw [Finset.mem_insert, Finset.mem_singleton]
        exact hsq
      exact (Finset.card_le_card hsub).trans Finset.card_le_two
    have h0_not_mem : (0 : F) ∉ U.image f := by
      intro h0
      rcases Finset.mem_image.mp h0 with ⟨x, hx, hx0⟩
      have hx_ne : x ≠ 0 := (Finset.mem_erase.mp hx).1
      exact hx_ne (pow_eq_zero hx0)
    have hSq_eq : Sq = insert (0 : F) (U.image f) := by
      change Finset.univ.image f = insert (0 : F) (U.image f)
      rw [← Finset.insert_erase (Finset.mem_univ (0 : F)), Finset.image_insert]
      simp [f, U]
    have hSq_card : Sq.card = (U.image f).card + 1 := by
      rw [hSq_eq, Finset.card_insert_of_notMem h0_not_mem]
    have hF_card : Fintype.card F = U.card + 1 := by
      rw [← Finset.card_univ, ← Finset.card_erase_add_one (Finset.mem_univ (0 : F))]
    have h2Sq : Fintype.card F + 1 ≤ 2 * Sq.card := by
      omega
    let s₁ : Finset F := Sq.image (fun z => a * z)
    let s₂ : Finset F := Sq.image (fun z => 1 - b * z)
    have hs₁_card : s₁.card = Sq.card := by
      apply Finset.card_image_of_injective
      exact mul_right_injective₀ ha
    have hs₂_card : s₂.card = Sq.card := by
      apply Finset.card_image_of_injective
      intro z₁ z₂ hz
      exact mul_right_injective₀ hb (sub_right_inj.mp hz)
    have hinter_pos : 0 < (s₁ ∩ s₂).card := by
      have hunion := Finset.card_union_add_card_inter s₁ s₂
      have huniv : (s₁ ∪ s₂).card ≤ Fintype.card F := Finset.card_le_univ (s₁ ∪ s₂)
      omega
    rcases Finset.card_pos.mp hinter_pos with ⟨w, hw⟩
    rw [Finset.mem_inter] at hw
    rcases Finset.mem_image.mp hw.1 with ⟨z₁, hz₁, rfl⟩
    rcases Finset.mem_image.mp hz₁ with ⟨x, _, rfl⟩
    rcases Finset.mem_image.mp hw.2 with ⟨z₂, hz₂, hw₂⟩
    rcases Finset.mem_image.mp hz₂ with ⟨y, _, rfl⟩
    refine ⟨x, y, ?_⟩
    dsimp [f] at hw₂ ⊢
    linear_combination -hw₂
  have hs2 : ∀ {R : Type u} [CommRing R] (I : Ideal R) [I.IsMaximal] (c z₀ : R),
      z₀ ^ 2 - c ∈ I → 2 * z₀ ∉ I →
      ∃ z : ℕ → R, ∀ n : ℕ, z n ^ 2 - c ∈ I ^ (n + 1) ∧ z (n + 1) - z n ∈ I ^ (n + 1) := by
    intro R _ I _ c z₀ hc hz₀
    letI : Field (R ⧸ I) := Ideal.Quotient.field I
    have h2z₀ : (Ideal.Quotient.mk I (2 * z₀)) ≠ 0 :=
      Ideal.Quotient.eq_zero_iff_mem.not.mpr hz₀
    obtain ⟨t, ht_eq⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk I (2 * z₀))⁻¹
    have ht : 1 - 2 * z₀ * t ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, ht_eq,
        mul_inv_cancel₀ h2z₀, sub_self]
    let z : ℕ → R := fun n => Nat.recOn n z₀ (fun _ zn => zn - t * (zn ^ 2 - c))
    have h_ind : ∀ n : ℕ, z n - z₀ ∈ I ∧ z n ^ 2 - c ∈ I ^ (n + 1) := by
      intro n
      induction n with
      | zero =>
        refine ⟨?_, ?_⟩
        · change z₀ - z₀ ∈ I
          rw [sub_self]
          exact I.zero_mem
        · change z₀ ^ 2 - c ∈ I ^ 1
          rw [pow_one]
          exact hc
      | succ n ih =>
        have hzn_I : z n ^ 2 - c ∈ I := Ideal.pow_le_self (Nat.succ_ne_zero n) ih.2
        have h_step : z (n + 1) = z n - t * (z n ^ 2 - c) := rfl
        refine ⟨?_, ?_⟩
        · have h_diff : z (n + 1) - z₀ = (z n - z₀) - t * (z n ^ 2 - c) := by
            rw [h_step]; ring
          rw [h_diff]
          exact I.sub_mem ih.1 (I.mul_mem_left t hzn_I)
        · have hq : (1 - 2 * z₀ * t) - 2 * t * (z n - z₀) + t ^ 2 * (z n ^ 2 - c) ∈ I := by
            refine I.add_mem (I.sub_mem ht (I.mul_mem_left (2 * t) ih.1))
              (I.mul_mem_left (t ^ 2) hzn_I)
          have h_id : z (n + 1) ^ 2 - c =
              (z n ^ 2 - c) * ((1 - 2 * z₀ * t) - 2 * t * (z n - z₀) + t ^ 2 * (z n ^ 2 - c)) := by
            rw [h_step]; ring
          rw [h_id, pow_succ]
          exact Ideal.mul_mem_mul ih.2 hq
    refine ⟨z, fun n => ⟨(h_ind n).2, ?_⟩⟩
    have h_step_sub : z (n + 1) - z n = -t * (z n ^ 2 - c) := by
      change (z n - t * (z n ^ 2 - c)) - z n = -t * (z n ^ 2 - c)
      ring
    rw [h_step_sub]
    exact (I ^ (n + 1)).mul_mem_left (-t) (h_ind n).2
  have hs3 : ∀ (c : NumberField.RingOfIntegers K) (z : ℕ → NumberField.RingOfIntegers K),
      (∀ n : ℕ, z n ^ 2 - c ∈ v.asIdeal ^ (n + 1) ∧ z (n + 1) - z n ∈ v.asIdeal ^ (n + 1)) →
      ∃ w : v.adicCompletion K,
        w ^ 2 = algebraMap K (v.adicCompletion K)
          (algebraMap (NumberField.RingOfIntegers K) K c) := by
    intro c z hz
    let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
      (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
    have h_tendsto_zero : ∀ r : ℕ → NumberField.RingOfIntegers K,
        (∀ n : ℕ, r n ∈ v.asIdeal ^ (n + 1)) →
        Filter.Tendsto (fun n => ι (r n)) Filter.atTop (nhds 0) := by
      intro r hr
      rw [(Valued.hasBasis_nhds_zero (v.adicCompletion K)
        (WithZero (Multiplicative ℤ))).tendsto_right_iff]
      intro γ _
      rw [Filter.eventually_atTop]
      let m : ℤ := WithZero.log (γ : WithZero (Multiplicative ℤ))
      refine ⟨(-m).toNat, fun n hn => ?_⟩
      have h_val_eq : Valued.v (ι (r n)) = v.intValuation (r n) :=
        (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
          (algebraMap (NumberField.RingOfIntegers K) K (r n))).trans
          (v.valuation_of_algebraMap (r n))
      have h_le : Valued.v (ι (r n)) ≤ WithZero.exp (-(n + 1 : ℤ)) := by
        rw [h_val_eq]
        exact (v.intValuation_le_pow_iff_mem (r n) (n + 1)).mpr (hr n)
      have h_lt : WithZero.exp (-(n + 1 : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← WithZero.exp_log γ.ne_zero, WithZero.exp_lt_exp]
        change -(n + 1 : ℤ) < m
        omega
      exact lt_of_le_of_lt h_le h_lt
    let f : ℕ → v.adicCompletion K := fun n => ι (z n)
    have hf_sub : Filter.Tendsto (fun n => f (n + 1) - f n) Filter.atTop (nhds 0) := by
      have h_eq : (fun n => f (n + 1) - f n) = (fun n => ι (z (n + 1) - z n)) := by
        ext n
        exact (map_sub ι (z (n + 1)) (z n)).symm
      rw [h_eq]
      exact h_tendsto_zero (fun n => z (n + 1) - z n) (fun n => (hz n).2)
    have hf_cauchy : CauchySeq f :=
      NonarchimedeanAddGroup.cauchySeq_of_tendsto_sub_nhds_zero hf_sub
    obtain ⟨w, hw⟩ := cauchySeq_tendsto_of_complete hf_cauchy
    have h_sq_zero : Filter.Tendsto (fun n => f n ^ 2 - ι c) Filter.atTop (nhds 0) := by
      have h_eq : (fun n => f n ^ 2 - ι c) = (fun n => ι (z n ^ 2 - c)) := by
        ext n
        simp [f]
      rw [h_eq]
      exact h_tendsto_zero (fun n => z n ^ 2 - c) (fun n => (hz n).1)
    have h_sq_w : Filter.Tendsto (fun n => f n ^ 2 - ι c) Filter.atTop (nhds (w ^ 2 - ι c)) :=
      (hw.pow 2).sub_const (ι c)
    have hw_eq : w ^ 2 - ι c = 0 := tendsto_nhds_unique h_sq_w h_sq_zero
    exact ⟨w, sub_eq_zero.mp hw_eq⟩
  let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
    (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
  haveI : v.asIdeal.IsMaximal := v.isMaximal
  haveI : v.asIdeal.IsPrime := v.isPrime
  have lift_one_var : ∀ (α' β' x₀ y₀ : NumberField.RingOfIntegers K),
      α' ∉ v.asIdeal → 2 * α' * x₀ ∉ v.asIdeal → α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1 ∈ v.asIdeal →
      ∃ x y : v.adicCompletion K, ι α' * x ^ 2 + ι β' * y ^ 2 = 1 := by
    intro α' β' x₀ y₀ hα' h2x hconic
    let c : NumberField.RingOfIntegers K := α' * (1 - β' * y₀ ^ 2)
    let z₀ : NumberField.RingOfIntegers K := α' * x₀
    have hc : z₀ ^ 2 - c ∈ v.asIdeal := by
      have hid : z₀ ^ 2 - c = α' * (α' * x₀ ^ 2 + β' * y₀ ^ 2 - 1) := by
        dsimp [c, z₀]; ring
      rw [hid]
      exact v.asIdeal.mul_mem_left α' hconic
    have hz₀ : 2 * z₀ ∉ v.asIdeal := by
      have hid : 2 * z₀ = 2 * α' * x₀ := by dsimp [z₀]; ring
      rw [hid]
      exact h2x
    obtain ⟨z, hz⟩ := hs2 v.asIdeal c z₀ hc hz₀
    obtain ⟨w, hw⟩ := hs3 c z hz
    have hα'_ne : α' ≠ 0 := by
      intro h0
      rw [h0] at hα'
      exact hα' v.asIdeal.zero_mem
    have hια'_ne : ι α' ≠ 0 := by
      change algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K α') ≠ 0
      rw [map_ne_zero_iff _ (RingHom.injective _)]
      exact (map_ne_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr hα'_ne
    have hw_eq : w ^ 2 = ι α' * (1 - ι β' * (ι y₀) ^ 2) := by
      change w ^ 2 = ι α' * (1 - ι β' * (ι y₀) ^ 2)
      have hc_map : ι c = ι α' * (1 - ι β' * (ι y₀) ^ 2) := by
        dsimp [c]
        simp [map_mul, map_sub, map_one, map_pow]
      exact hw.trans hc_map
    refine ⟨w / ι α', ι y₀, ?_⟩
    have hcalc : ι α' * (w / ι α') ^ 2 + ι β' * (ι y₀) ^ 2 =
        w ^ 2 / ι α' + ι β' * (ι y₀) ^ 2 := by
      field_simp [hια'_ne]
    rw [hcalc, hw_eq, mul_div_cancel_left₀ _ hια'_ne, sub_add_cancel]
  have h2α : 2 * α ∉ v.asIdeal := fun hmem => h (v.asIdeal.mul_mem_right β hmem)
  have h2β : 2 * β ∉ v.asIdeal := by
    intro hmem
    have hmem' : 2 * α * β ∈ v.asIdeal := by
      have hid : 2 * α * β = (2 * β) * α := by ring
      rw [hid]
      exact v.asIdeal.mul_mem_right α hmem
    exact h hmem'
  have hα : α ∉ v.asIdeal := fun hmem => h2α (v.asIdeal.mul_mem_left 2 hmem)
  have hβ : β ∉ v.asIdeal := fun hmem => h2β (v.asIdeal.mul_mem_left 2 hmem)
  letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  have hα_bar : Ideal.Quotient.mk v.asIdeal α ≠ 0 :=
    Ideal.Quotient.eq_zero_iff_mem.not.mpr hα
  have hβ_bar : Ideal.Quotient.mk v.asIdeal β ≠ 0 :=
    Ideal.Quotient.eq_zero_iff_mem.not.mpr hβ
  obtain ⟨x_bar, y_bar, hxy_bar⟩ := hs1 hα_bar hβ_bar
  obtain ⟨x₀, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
  obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
  have hconic : α * x₀ ^ 2 + β * y₀ ^ 2 - 1 ∈ v.asIdeal := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [map_sub, map_add, map_mul, map_pow, map_one, hxy_bar, sub_self]
  have h_sol : ∃ x y : v.adicCompletion K, ι α * x ^ 2 + ι β * y ^ 2 = 1 := by
    by_cases hx₀ : x₀ ∈ v.asIdeal
    · have hy₀ : y₀ ∉ v.asIdeal := by
        intro hy₀
        have hsum : α * x₀ ^ 2 + β * y₀ ^ 2 ∈ v.asIdeal := by
          refine v.asIdeal.add_mem ?_ ?_
          · have : α * x₀ ^ 2 = (α * x₀) * x₀ := by ring
            rw [this]
            exact v.asIdeal.mul_mem_left (α * x₀) hx₀
          · have : β * y₀ ^ 2 = (β * y₀) * y₀ := by ring
            rw [this]
            exact v.asIdeal.mul_mem_left (β * y₀) hy₀
        have h1 : (1 : NumberField.RingOfIntegers K) ∈ v.asIdeal := by
          have hid : (1 : NumberField.RingOfIntegers K) =
              (α * x₀ ^ 2 + β * y₀ ^ 2) - (α * x₀ ^ 2 + β * y₀ ^ 2 - 1) := by ring
          rw [hid]
          exact v.asIdeal.sub_mem hsum hconic
        exact v.isMaximal.ne_top (v.asIdeal.eq_top_iff_one.mpr h1)
      have h2y : 2 * β * y₀ ∉ v.asIdeal :=
        fun hmem => (v.isPrime.mem_or_mem hmem).elim h2β hy₀
      have hconic' : β * y₀ ^ 2 + α * x₀ ^ 2 - 1 ∈ v.asIdeal := by
        have hid : β * y₀ ^ 2 + α * x₀ ^ 2 - 1 = α * x₀ ^ 2 + β * y₀ ^ 2 - 1 := by ring
        rw [hid]
        exact hconic
      obtain ⟨y, x, hyx⟩ := lift_one_var β α y₀ x₀ hβ h2y hconic'
      refine ⟨x, y, ?_⟩
      rw [add_comm]
      exact hyx
    · have h2x : 2 * α * x₀ ∉ v.asIdeal :=
        fun hmem => (v.isPrime.mem_or_mem hmem).elim h2α hx₀
      exact lift_one_var α β x₀ y₀ hα h2x hconic
  unfold hilbFin hilbLoc
  exact if_pos h_sol

theorem finite_mem_asIdeal_of_ne_zero {K : Type u} [Field K] [NumberField K]
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0) :
    {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
      γ ∈ v.asIdeal}.Finite :=
by
  have hI : (Ideal.span {γ} : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
    rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
    exact hγ
  refine (Ideal.finite_factors hI).subset (fun v hv => ?_)
  rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
  exact hv

theorem hilbInf_eq_one_of_isComplex {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) (hw : w.IsComplex) (a b : K) (ha : a ≠ 0) :
    hilbInf w a b = 1 :=
by
  dsimp [hilbInf, hilbInfLoc]
  rw [if_pos]
  let ϕ := NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hw
  let A : ℂ := ϕ (algebraMap K w.Completion a)
  have hA : A ≠ 0 := by
    intro h0
    apply ha
    apply (algebraMap K w.Completion).injective
    apply ϕ.injective
    simpa [A] using h0
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self A⁻¹
  refine ⟨ϕ.symm z, 0, ?_⟩
  apply ϕ.injective
  simp only [map_mul, sq, RingEquiv.apply_symm_apply, mul_zero, add_zero, map_one]
  rw [← hz, mul_inv_cancel₀ hA]

theorem hilbInf_of_isReal {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) (hw : w.IsReal) (a b : K) (ha : a ≠ 0) (hb : b ≠ 0) :
    hilbInf w a b = if (w.embedding a).re < 0 ∧ (w.embedding b).re < 0 then -1 else 1 :=
by
  classical
  dsimp [hilbInf, hilbInfLoc]
  let φ : w.Completion ≃+* ℝ :=
    NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw
  have hφ : ∀ c : K, φ (algebraMap K w.Completion c) = (w.embedding c).re := by
    intro c
    change (RingEquiv.ofBijective
      (NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal hw)
      (NumberField.InfinitePlace.Completion.bijective_extensionEmbeddingOfIsReal hw))
      (c : w.Completion) = (w.embedding c).re
    rw [RingEquiv.ofBijective_apply,
      NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe]
    have h1 := congr_arg Complex.re (NumberField.InfinitePlace.embedding_of_isReal_apply hw c)
    rw [Complex.ofReal_re] at h1
    exact h1
  have h_emb_re : ∀ c : K, (w.embedding c).re = NumberField.InfinitePlace.embedding_of_isReal hw c := by
    intro c
    have h1 := congr_arg Complex.re (NumberField.InfinitePlace.embedding_of_isReal_apply hw c)
    rw [Complex.ofReal_re] at h1
    exact h1.symm
  have hA : (w.embedding a).re ≠ 0 := by
    rw [h_emb_re]
    intro h
    apply ha
    apply RingHom.injective (NumberField.InfinitePlace.embedding_of_isReal hw)
    rw [h, map_zero]
  have hB : (w.embedding b).re ≠ 0 := by
    rw [h_emb_re]
    intro h
    apply hb
    apply RingHom.injective (NumberField.InfinitePlace.embedding_of_isReal hw)
    rw [h, map_zero]
  have heq : (∃ x y : w.Completion,
      algebraMap K w.Completion a * x ^ 2 + algebraMap K w.Completion b * y ^ 2 = 1) ↔
      (∃ u v : ℝ, (w.embedding a).re * u ^ 2 + (w.embedding b).re * v ^ 2 = 1) := by
    constructor
    · rintro ⟨x, y, hxy⟩
      refine ⟨φ x, φ y, ?_⟩
      have h := congr_arg φ hxy
      simpa [map_add, map_mul, map_pow, map_one, hφ] using h
    · rintro ⟨u, v, huv⟩
      refine ⟨φ.symm u, φ.symm v, ?_⟩
      apply φ.injective
      simpa [map_add, map_mul, map_pow, map_one, hφ] using huv
  by_cases hneg : (w.embedding a).re < 0 ∧ (w.embedding b).re < 0
  · rw [if_pos hneg, if_neg]
    rw [heq]
    rintro ⟨u, v, huv⟩
    have hu2 : 0 ≤ u ^ 2 := sq_nonneg u
    have hv2 : 0 ≤ v ^ 2 := sq_nonneg v
    nlinarith [hneg.1, hneg.2]
  · rw [if_neg hneg, if_pos]
    rw [heq]
    have hpos : 0 < (w.embedding a).re ∨ 0 < (w.embedding b).re := by
      rcases lt_trichotomy (w.embedding a).re 0 with ha_lt | ha_eq | ha_gt
      · rcases lt_trichotomy (w.embedding b).re 0 with hb_lt | hb_eq | hb_gt
        · exact False.elim (hneg ⟨ha_lt, hb_lt⟩)
        · exact False.elim (hB hb_eq)
        · exact Or.inr hb_gt
      · exact False.elim (hA ha_eq)
      · exact Or.inl ha_gt
    rcases hpos with ha_gt | hb_gt
    · refine ⟨Real.sqrt ((w.embedding a).re)⁻¹, 0, ?_⟩
      have hinv : 0 ≤ ((w.embedding a).re)⁻¹ := inv_nonneg.mpr (le_of_lt ha_gt)
      rw [Real.sq_sqrt hinv, mul_inv_cancel₀ hA]
      ring
    · refine ⟨0, Real.sqrt ((w.embedding b).re)⁻¹, ?_⟩
      have hinv : 0 ≤ ((w.embedding b).re)⁻¹ := inv_nonneg.mpr (le_of_lt hb_gt)
      rw [Real.sq_sqrt hinv, mul_inv_cancel₀ hB]
      ring

theorem hilbFin_eq_normSym {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
      (algebraMap (NumberField.RingOfIntegers K) K β) = normSym v α β :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let F := v.adicCompletion K
  let a_K : K := algebraMap R K α
  let b_K : K := algebraMap R K β
  let a : F := algebraMap K F a_K
  let b : F := algebraMap K F b_K
  have ha_K : a_K ≠ 0 := by
    simpa only [a_K, map_zero] using (IsFractionRing.injective R K).ne hα
  have ha : a ≠ 0 := by
    simpa only [a, map_zero] using (algebraMap K F).injective.ne ha_K
  have h2_K : (2 : K) ≠ 0 := two_ne_zero
  have h2 : (2 : F) ≠ 0 := by
    simpa only [map_ofNat, map_zero] using (algebraMap K F).injective.ne h2_K
  have h2inv : (2 : F) * 2⁻¹ = 1 := mul_inv_cancel₀ h2
  have h2ainv : (2 * a) * (2 * a)⁻¹ = 1 := mul_inv_cancel₀ (mul_ne_zero h2 ha)
  have h_iff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔
      (∃ X Y : F, X ^ 2 - b * Y ^ 2 = a) := by
    constructor
    · rintro ⟨x, y, hxy⟩
      by_cases hx : x = 0
      · refine ⟨(a + 1) * 2⁻¹, y * (a - 1) * 2⁻¹, ?_⟩
        linear_combination - (a - 1) ^ 2 * (2⁻¹) ^ 2 * hxy +
          a * x * (a - 1) ^ 2 * (2⁻¹) ^ 2 * hx + a * (2 * 2⁻¹ + 1) * h2inv
      · have hxx : x * x⁻¹ = 1 := mul_inv_cancel₀ hx
        refine ⟨x⁻¹, y * x⁻¹, ?_⟩
        linear_combination - (x⁻¹) ^ 2 * hxy + a * (x * x⁻¹ + 1) * hxx
    · rintro ⟨X, Y, hXY⟩
      by_cases hX : X = 0
      · refine ⟨(a + 1) * (2 * a)⁻¹, Y * (a - 1) * (2 * a)⁻¹, ?_⟩
        linear_combination - (a - 1) ^ 2 * ((2 * a)⁻¹) ^ 2 * hXY +
          X * (a - 1) ^ 2 * ((2 * a)⁻¹) ^ 2 * hX + ((2 * a) * (2 * a)⁻¹ + 1) * h2ainv
      · have hXX : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
        refine ⟨X⁻¹, Y * X⁻¹, ?_⟩
        linear_combination - (X⁻¹) ^ 2 * hXY + (X * X⁻¹ + 1) * hXX
  dsimp only [hilbFin, hilbLoc, normSym]
  change (if ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 then (1 : ℤˣ) else -1) =
    (if ∃ X Y : F, X ^ 2 - b * Y ^ 2 = a then (1 : ℤˣ) else -1)
  rw [h_iff]

theorem hilbFin_eq_tameSym_of_two_not_mem {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    hilbFin v (algebraMap (NumberField.RingOfIntegers K) K α)
      (algebraMap (NumberField.RingOfIntegers K) K β) = tameSym v α β :=
by
  have intValuation_eq_exp_neg_valNat :
      ∀ (γ : NumberField.RingOfIntegers K), γ ≠ 0 →
        v.intValuation γ = WithZero.exp (-(valNat v γ : ℤ)) := by
    intro γ hγ
    have hv_ne : v.intValuation γ ≠ 0 :=
      v.intValuation_ne_zero' ⟨γ, mem_nonZeroDivisors_of_ne_zero hγ⟩
    have hv_le : v.intValuation γ ≤ 1 := v.intValuation_le_one γ
    have hlog_le : WithZero.log (v.intValuation γ) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v γ : ℤ) = -WithZero.log (v.intValuation γ) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have exp_neg_one_pow : ∀ n : ℕ, (WithZero.exp (-1 : ℤ)) ^ n = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, ih, ← WithZero.exp_add]
      congr 1
      omega
  have exists_mul_sq_eq_of_even_valNat :
      ∀ (γ : NumberField.RingOfIntegers K), γ ≠ 0 → Even (valNat v γ) →
        ∃ (s : Kˣ) (γ₀ : NumberField.RingOfIntegers K),
          γ₀ ∉ v.asIdeal ∧
          algebraMap (NumberField.RingOfIntegers K) K γ * (s : K) ^ 2 =
            algebraMap (NumberField.RingOfIntegers K) K γ₀ := by
    intro γ hγ he
    rcases he with ⟨k, hk⟩
    have hk2 : valNat v γ = 2 * k := by omega
    have hγ_val : v.intValuation γ = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [intValuation_eq_exp_neg_valNat γ hγ, hk2]
    have hγ_mem : γ ∈ v.asIdeal ^ (2 * k) :=
      (v.intValuation_le_pow_iff_mem γ (2 * k)).mp (le_of_eq hγ_val)
    obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
    have hπ_dvd : v.asIdeal ^ 1 ∣ Ideal.span {π} := by
      apply (v.intValuation_le_pow_iff_dvd π 1).mp
      rw [hπ]
      exact le_rfl
    rw [pow_one] at hπ_dvd
    obtain ⟨J, hJ⟩ := hπ_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hπ_mem2 : π ∈ v.asIdeal ^ 2 := by
        rw [sq, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hπ_le2 : v.intValuation π ≤ WithZero.exp (-((2 : ℕ) : ℤ)) :=
        (v.intValuation_le_pow_iff_mem π 2).mpr hπ_mem2
      rw [hπ, WithZero.exp_le_exp] at hπ_le2
      omega
    obtain ⟨s₀, hs₀J, hs₀v⟩ := SetLike.not_le_iff_exists.mp hJ_not_le
    have hspan_γ : Ideal.span {γ} ≤ v.asIdeal ^ (2 * k) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hγ_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
      (Ideal.span_singleton_le_iff_mem _).mpr hs₀J
    have hspan_mul : Ideal.span {γ * (s₀ ^ k) ^ 2} ≤ Ideal.span {(π ^ k) ^ 2} := by
      have h1 : Ideal.span {γ * (s₀ ^ k) ^ 2} = Ideal.span {γ} * (Ideal.span {s₀}) ^ (2 * k) := by
        rw [← Ideal.span_singleton_mul_span_singleton, ← pow_mul, Nat.mul_comm k 2,
          ← Ideal.span_singleton_pow]
      have h2 : Ideal.span {(π ^ k) ^ 2} = v.asIdeal ^ (2 * k) * J ^ (2 * k) := by
        rw [← pow_mul, Nat.mul_comm k 2, ← Ideal.span_singleton_pow, hJ, mul_pow]
      rw [h1, h2]
      exact Ideal.mul_mono hspan_γ (Ideal.pow_right_mono hspan_s₀ (2 * k))
    obtain ⟨γ₀, hγ₀_eq⟩ := Ideal.span_singleton_le_span_singleton.mp hspan_mul
    have hs₀_val : v.intValuation s₀ = 1 := v.intValuation_eq_one_iff.mpr hs₀v
    have hπ_pow_val : v.intValuation ((π ^ k) ^ 2) = WithZero.exp (-((2 * k : ℕ) : ℤ)) := by
      rw [← pow_mul, Nat.mul_comm k 2, map_pow, hπ, exp_neg_one_pow (2 * k)]
    have hval_eq : WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1 =
        WithZero.exp (-((2 * k : ℕ) : ℤ)) * v.intValuation γ₀ := by
      calc
        WithZero.exp (-((2 * k : ℕ) : ℤ)) * 1
          = v.intValuation γ * (v.intValuation s₀ ^ k) ^ 2 := by
            rw [hγ_val, hs₀_val, one_pow, one_pow]
        _ = v.intValuation (γ * (s₀ ^ k) ^ 2) := by simp [map_mul, map_pow]
        _ = v.intValuation ((π ^ k) ^ 2 * γ₀) := by rw [hγ₀_eq]
        _ = WithZero.exp (-((2 * k : ℕ) : ℤ)) * v.intValuation γ₀ := by
          rw [map_mul, hπ_pow_val]
    have hγ₀_val : v.intValuation γ₀ = 1 :=
      (mul_left_cancel₀ WithZero.exp_ne_zero hval_eq).symm
    have hγ₀_not_mem : γ₀ ∉ v.asIdeal := v.intValuation_eq_one_iff.mp hγ₀_val
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀v (h0 ▸ v.asIdeal.zero_mem)
    have hπ_ne : π ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hπ
      exact WithZero.exp_ne_zero hπ.symm
    have hs₀K_ne : algebraMap (NumberField.RingOfIntegers K) K (s₀ ^ k) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr
        (pow_ne_zero k hs₀_ne)
    have hπK_ne : algebraMap (NumberField.RingOfIntegers K) K (π ^ k) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)).mpr
        (pow_ne_zero k hπ_ne)
    let s : Kˣ := Units.mk0
      (algebraMap (NumberField.RingOfIntegers K) K (s₀ ^ k) /
        algebraMap (NumberField.RingOfIntegers K) K (π ^ k))
      (div_ne_zero hs₀K_ne hπK_ne)
    refine ⟨s, γ₀, hγ₀_not_mem, ?_⟩
    have hmap := congr_arg (algebraMap (NumberField.RingOfIntegers K) K) hγ₀_eq
    simp only [map_mul, map_pow] at hmap
    have hπK_ne' : algebraMap (NumberField.RingOfIntegers K) K π ^ k ≠ 0 := by
      simpa only [map_pow] using hπK_ne
    change algebraMap (NumberField.RingOfIntegers K) K γ *
      (algebraMap (NumberField.RingOfIntegers K) K (s₀ ^ k) /
        algebraMap (NumberField.RingOfIntegers K) K (π ^ k)) ^ 2 =
      algebraMap (NumberField.RingOfIntegers K) K γ₀
    simp only [map_pow]
    field_simp [hπK_ne']
    linear_combination hmap
  have isSquare_of_val_sub_one_lt_one :
      ∀ (u : v.adicCompletion K), Valued.v (u - 1) < 1 → IsSquare u := by
    intro u hu
    by_cases hu0 : u - 1 = 0
    · rw [sub_eq_zero.mp hu0]
      exact IsSquare.one
    have hu_ne : Valued.v (u - 1) ≠ 0 := (Valuation.zero_iff Valued.v).not.mpr hu0
    have hu_le : Valued.v (u - 1) ≤ WithZero.exp (-1 : ℤ) := by
      rw [← WithZero.exp_log hu_ne] at hu ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hu
      rw [WithZero.exp_le_exp]
      omega
    let ι : NumberField.RingOfIntegers K →+* v.adicCompletion K :=
      (algebraMap K (v.adicCompletion K)).comp (algebraMap (NumberField.RingOfIntegers K) K)
    have h2_val : Valued.v (2 : v.adicCompletion K) = 1 := by
      have h2_eq : (2 : v.adicCompletion K) = ι (2 : NumberField.RingOfIntegers K) :=
        (map_ofNat ι 2).symm
      rw [h2_eq]
      exact ((IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
        (algebraMap (NumberField.RingOfIntegers K) K 2)).trans
        (v.valuation_of_algebraMap 2)).trans (v.intValuation_eq_one_iff.mpr h2)
    have h2_ne : (2 : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, Valuation.map_zero] at h2_val
      exact zero_ne_one h2_val
    have h2inv_val : Valued.v ((2 : v.adicCompletion K)⁻¹) = 1 := by
      rw [map_inv₀, h2_val, inv_one]
    have h2_mul_inv : (2 : v.adicCompletion K) * 2⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    let z : ℕ → v.adicCompletion K := fun n =>
      Nat.recOn n 1 (fun _ zn => zn - 2⁻¹ * (zn ^ 2 - u))
    have h_ind : ∀ n : ℕ,
        Valued.v (z n - 1) ≤ WithZero.exp (-1 : ℤ) ∧
        Valued.v (z n ^ 2 - u) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ)) := by
      intro n
      induction n with
      | zero =>
        refine ⟨?_, ?_⟩
        · change Valued.v ((1 : v.adicCompletion K) - 1) ≤ WithZero.exp (-1 : ℤ)
          rw [sub_self, Valuation.map_zero]
          exact zero_le'
        · change Valued.v ((1 : v.adicCompletion K) ^ 2 - u) ≤ WithZero.exp (-((0 + 1 : ℕ) : ℤ))
          have hid : (1 : v.adicCompletion K) ^ 2 - u = -(u - 1) := by ring
          rw [hid, Valuation.map_neg]
          exact hu_le
      | succ n ih =>
        have h_step : z (n + 1) = z n - 2⁻¹ * (z n ^ 2 - u) := rfl
        have h_le1 : WithZero.exp (-((n + 1 : ℕ) : ℤ)) ≤ WithZero.exp (-1 : ℤ) := by
          rw [WithZero.exp_le_exp]
          omega
        have h_term : Valued.v (2⁻¹ * (z n ^ 2 - u)) ≤ WithZero.exp (-1 : ℤ) := by
          rw [map_mul, h2inv_val, one_mul]
          exact ih.2.trans h_le1
        refine ⟨?_, ?_⟩
        · have h_diff : z (n + 1) - 1 = (z n - 1) - 2⁻¹ * (z n ^ 2 - u) := by
            rw [h_step]; ring
          rw [h_diff]
          exact (Valuation.map_sub Valued.v _ _).trans (max_le ih.1 h_term)
        · have h_id : z (n + 1) ^ 2 - u =
              (z n ^ 2 - u) * (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) := by
            rw [h_step]
            linear_combination - z n * (z n ^ 2 - u) * h2_mul_inv
          have h_fac2 : Valued.v (-(z n - 1) + (2⁻¹) ^ 2 * (z n ^ 2 - u)) ≤
              WithZero.exp (-1 : ℤ) := by
            refine (Valuation.map_add Valued.v _ _).trans (max_le ?_ ?_)
            · rw [Valuation.map_neg]; exact ih.1
            · rw [map_mul, map_pow, h2inv_val, one_pow, one_mul]
              exact ih.2.trans h_le1
          have h_exp : WithZero.exp (-((n + 1 : ℕ) : ℤ)) * WithZero.exp (-1 : ℤ) =
              WithZero.exp (-((n + 1 + 1 : ℕ) : ℤ)) := by
            rw [← WithZero.exp_add]
            congr 1
          rw [h_id, map_mul, ← h_exp]
          exact mul_le_mul' ih.2 h_fac2
    have h_tendsto_zero : ∀ g : ℕ → v.adicCompletion K,
        (∀ n : ℕ, Valued.v (g n) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ))) →
        Filter.Tendsto g Filter.atTop (nhds 0) := by
      intro g hg
      rw [(Valued.hasBasis_nhds_zero (v.adicCompletion K)
        (WithZero (Multiplicative ℤ))).tendsto_right_iff]
      intro γ _
      rw [Filter.eventually_atTop]
      let m : ℤ := WithZero.log (γ : WithZero (Multiplicative ℤ))
      refine ⟨(-m).toNat, fun n hn => ?_⟩
      have h_lt : WithZero.exp (-((n + 1 : ℕ) : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
        rw [← WithZero.exp_log γ.ne_zero, WithZero.exp_lt_exp]
        change -((n + 1 : ℕ) : ℤ) < m
        omega
      exact lt_of_le_of_lt (hg n) h_lt
    have hz_sub : Filter.Tendsto (fun n => z (n + 1) - z n) Filter.atTop (nhds 0) := by
      apply h_tendsto_zero
      intro n
      have h_step_sub : z (n + 1) - z n = -(2⁻¹ * (z n ^ 2 - u)) := by
        change (z n - 2⁻¹ * (z n ^ 2 - u)) - z n = -(2⁻¹ * (z n ^ 2 - u))
        ring
      rw [h_step_sub, Valuation.map_neg, map_mul, h2inv_val, one_mul]
      exact (h_ind n).2
    have hz_cauchy : CauchySeq z :=
      NonarchimedeanAddGroup.cauchySeq_of_tendsto_sub_nhds_zero hz_sub
    obtain ⟨w, hw⟩ := cauchySeq_tendsto_of_complete hz_cauchy
    have h_sq_zero : Filter.Tendsto (fun n => z n ^ 2 - u) Filter.atTop (nhds 0) :=
      h_tendsto_zero (fun n => z n ^ 2 - u) (fun n => (h_ind n).2)
