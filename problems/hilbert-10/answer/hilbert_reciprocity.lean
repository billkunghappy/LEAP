theorem resDyadicProd_eq_oddResQuadProd_mul_realSignProd_of_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
        (valNat v α % 2 = 1 → β ∉ v.asIdeal) ∧
        (valNat v β % 2 = 1 → α ∉ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1) :
    resDyadicProd α β = oddResQuadProd α β * oddResQuadProd β α * realSignProd α β :=
by
  obtain ⟨β', s, t, hβ', hs, ht, h_eqβ, h_dyad_unit, h_odd_unit, h_strict_coprime, h_sqfree'⟩ :=
    exists_mul_sq_strict_odd_coprime α β hα hβ h_coprime h_sqfree
  have h1_not_mem : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (1 : NumberField.RingOfIntegers K) ∉ v.asIdeal :=
    fun v h1 => v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1)
  have h_inv₁ := resDyadicProd_mul_sq_invariance α β 1 s hα hβ one_ne_zero hs
    (fun v h2v => ⟨h1_not_mem v, (h_dyad_unit v h2v).1⟩)
    (fun v h2v => ⟨fun hα_odd => (h_odd_unit v h2v hα_odd).1, fun _ => h1_not_mem v⟩)
  have h_inv₂ := resDyadicProd_mul_sq_invariance α β' 1 t hα hβ' one_ne_zero ht
    (fun v h2v => ⟨h1_not_mem v, (h_dyad_unit v h2v).2⟩)
    (fun v h2v => ⟨fun hα_odd => (h_odd_unit v h2v hα_odd).2, fun _ => h1_not_mem v⟩)
  rw [h_eqβ] at h_inv₁
  have h_dyad : resDyadicProd α β = resDyadicProd α β' := h_inv₁.1.symm.trans h_inv₂.1
  have h_odd₁ : oddResQuadProd α β = oddResQuadProd α β' := h_inv₁.2.1.symm.trans h_inv₂.2.1
  have h_odd₂ : oddResQuadProd β α = oddResQuadProd β' α := h_inv₁.2.2.1.symm.trans h_inv₂.2.2.1
  have h_real : realSignProd α β = realSignProd α β' := h_inv₁.2.2.2.symm.trans h_inv₂.2.2.2
  have h_pow₁ : oddResQuadProd α β' = oddPowResQuadProd α β' :=
    oddResQuadProd_eq_oddPowResQuadProd α β'
  have h_pow₂ : oddResQuadProd β' α = oddPowResQuadProd β' α :=
    oddResQuadProd_eq_oddPowResQuadProd β' α
  have h_rec := resDyadicProd_eq_oddPowResQuadProd_mul_realSignProd_of_strict_coprime
    α β' hα hβ' h_strict_coprime h_sqfree'
  rw [h_dyad, h_odd₁, h_odd₂, h_real, h_pow₁, h_pow₂, h_rec]

theorem dyadicProd_eq_oddResQuadProd_mul_realSignProd_of_coprime {K : Type u} [Field K] [NumberField K]
