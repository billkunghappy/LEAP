    have h_WD : W * D = A_bar * V * D := by
      dsimp [W]
      rw [add_mul, mul_assoc (A_bar * V) D D, hD_idem]
      rw [mul_assoc ((1 - A_bar) * V) (1 - D) D, h_one_sub_D, mul_zero, add_zero]
