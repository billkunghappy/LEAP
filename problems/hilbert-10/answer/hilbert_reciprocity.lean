      · simp [h0]
      · simp [h1]
    have hDp_idem : Dp * Dp = Dp := by
      dsimp [Dp]
      rw [Matrix.diagonal_mul_diagonal]
      congr 1
      ext j
      rcases hd_01 j with h0 | h1
      · simp [h0]
      · simp [h1]
