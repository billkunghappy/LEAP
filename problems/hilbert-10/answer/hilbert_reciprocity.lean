        starRingEnd ℂ (Real.pi * Complex.I / 4) = Real.pi * Complex.I * (-1 : ℂ) / 4 := by
      simp only [map_div₀, map_mul, Complex.conj_ofReal, Complex.conj_I, map_ofNat]
      ring
    rw [h_conj_arg]
    dsimp [r]
    push_cast
    ring
  · rw [if_neg hd_neg]
    have hd_eq : d = (c : ℤ) * 1 := by
      change d = (d.natAbs : ℤ) * 1
      have h0 := Int.eq_natAbs_of_nonneg (not_lt.mp hd_neg)
      linarith
    rw [hm_eq', hd_eq,
      ratIntGaussSum_mul_left_and_neg.1 c (8 * K) 1 hc_pos h8K_pos,
      h_base, mul_one]
    dsimp [r]
    push_cast
    ring

theorem exists_orthogonal_trace_sublattice {K : Type u} [Field K] [NumberField K]
    (γ : NumberField.RingOfIntegers K) (hγ_ne : γ ≠ 0) :
    ∃ (e : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K) (c₀ : ℕ),
      0 < c₀ ∧
      (∀ i j : Fin (Module.finrank ℚ K), i ≠ j →
        Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * e i * e j) = 0) ∧
      (∀ j : Fin (Module.finrank ℚ K),
        Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2) ≠ 0) ∧
      (∀ x : NumberField.RingOfIntegers K,
        ∃ z : Fin (Module.finrank ℚ K) → ℤ,
          (c₀ : NumberField.RingOfIntegers K) * x =
            ∑ j : Fin (Module.finrank ℚ K), (z j : NumberField.RingOfIntegers K) * e j) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let n := Module.finrank ℚ K
  let γK : K := algebraMap R K γ
  have hγK_ne : γK ≠ 0 := (IsFractionRing.injective R K).ne hγ_ne
  let B : LinearMap.BilinForm ℚ K :=
    LinearMap.comp (Algebra.traceForm ℚ K) (LinearMap.mulLeft ℚ γK)
  have hB_apply : ∀ x y : K, B x y = Algebra.trace ℚ K (γK * x * y) := by
    intro x y
    simp [B, Algebra.traceForm_apply, mul_assoc]
  have hB_symm : LinearMap.IsSymm B := by
    rw [← LinearMap.BilinForm.isSymm_iff, LinearMap.BilinForm.isSymm_def]
    intro x y
    rw [hB_apply, hB_apply, mul_right_comm]
  have hB_nondeg : B.Nondegenerate := by
    intro x hx
    have htr : ∀ y : K, Algebra.traceForm ℚ K (γK * x) y = 0 := hx
    have hγx : γK * x = 0 := traceForm_nondegenerate ℚ K (γK * x) htr
    exact (mul_eq_zero.mp hγx).resolve_left hγK_ne
  obtain ⟨v₀, hv₀_ortho⟩ := LinearMap.BilinForm.exists_orthogonal_basis hB_symm
  have hv₀_diag : ∀ j : Fin n, B (v₀ j) (v₀ j) ≠ 0 := by
    intro j
    exact LinearMap.BilinForm.iIsOrtho.not_isOrtho_basis_self_of_nondegenerate
      hv₀_ortho hB_nondeg j
  let M_sub := Algebra.algebraMapSubmonoid R (nonZeroDivisors ℤ)
  obtain ⟨⟨bR, hbR⟩, hb_int⟩ :=
    IsLocalization.exist_integer_multiples M_sub (Finset.univ : Finset (Fin n)) v₀
  rcases Submonoid.mem_map.mp hbR with ⟨m, hm_mem, hm_eq⟩
  have hm_ne : m ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hm_mem
  have hmQ_ne : (m : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hm_ne
  choose e he using fun j : Fin n => hb_int j (Finset.mem_univ j)
  have he_eq : ∀ j : Fin n, algebraMap R K (e j) = (m : ℚ) • v₀ j := by
    intro j
    rw [he j]
    change (bR : R) • v₀ j = (m : ℚ) • v₀ j
    rw [← hm_eq]
    have h1 : (algebraMap ℤ R m) • v₀ j = m • v₀ j :=
      IsScalarTower.algebraMap_smul R m (v₀ j)
    have h2 : (m : ℚ) • v₀ j = m • v₀ j :=
      IsScalarTower.algebraMap_smul ℚ m (v₀ j)
    rw [h1, h2]
  let u : ℚˣ := Units.mk0 (m : ℚ) hmQ_ne
  let v₁ : Module.Basis (Fin n) ℚ K := v₀.unitsSMul (fun _ => u)
  have hv₁_eq : ∀ j : Fin n, v₁ j = algebraMap R K (e j) := by
    intro j
    rw [v₀.unitsSMul_apply, he_eq j]
    rfl
  have h_trace_eq : ∀ i j : Fin n,
      ((Algebra.trace ℤ R (γ * e i * e j) : ℤ) : ℚ) = (m : ℚ) ^ 2 * B (v₀ i) (v₀ j) := by
    intro i j
    have hloc := Algebra.trace_localization ℤ (nonZeroDivisors ℤ) (Rₘ := ℚ) (Sₘ := K) (γ * e i * e j)
    change (algebraMap ℤ ℚ) (Algebra.trace ℤ R (γ * e i * e j)) = (m : ℚ) ^ 2 * B (v₀ i) (v₀ j)
    rw [← hloc]
    change Algebra.trace ℚ K (algebraMap R K (γ * e i * e j)) = (m : ℚ) ^ 2 * B (v₀ i) (v₀ j)
    simp only [map_mul, ← hv₁_eq]
    change Algebra.trace ℚ K (γK * v₁ i * v₁ j) = (m : ℚ) ^ 2 * B (v₀ i) (v₀ j)
    rw [← hB_apply]
    simp only [v₁, Module.Basis.unitsSMul_apply, u, Units.smul_def, Units.val_mk0,
      LinearMap.map_smul, LinearMap.smul_apply, smul_eq_mul]
    ring
  have h_ortho : ∀ i j : Fin n, i ≠ j → Algebra.trace ℤ R (γ * e i * e j) = 0 := by
    intro i j hij
    have h0 : B (v₀ i) (v₀ j) = 0 := hv₀_ortho hij
    have htrQ : ((Algebra.trace ℤ R (γ * e i * e j) : ℤ) : ℚ) = 0 := by
      rw [h_trace_eq i j, h0, mul_zero]
    exact Int.cast_eq_zero.mp htrQ
  have h_ne : ∀ j : Fin n, Algebra.trace ℤ R (γ * (e j) ^ 2) ≠ 0 := by
    intro j h0
    have h_sq : γ * (e j) ^ 2 = γ * e j * e j := by ring
    rw [h_sq] at h0
    have htrQ : ((Algebra.trace ℤ R (γ * e j * e j) : ℤ) : ℚ) = 0 := by
      rw [h0, Int.cast_zero]
    rw [h_trace_eq j j] at htrQ
    exact mul_ne_zero (pow_ne_zero 2 hmQ_ne) (hv₀_diag j) htrQ
  let ω := NumberField.RingOfIntegers.basis K
  let ι := Module.Free.ChooseBasisIndex ℤ R
  let r : ι × Fin n → ℚ := fun p => v₁.repr (algebraMap R K (ω p.1)) p.2
  obtain ⟨⟨bZ, hbZ⟩, hbZ_int⟩ :=
    IsLocalization.exist_integer_multiples (nonZeroDivisors ℤ) (Finset.univ : Finset (ι × Fin n)) r
  have hbZ_ne : bZ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hbZ
  let c₀ : ℕ := bZ.natAbs
  have hc₀_pos : 0 < c₀ := Int.natAbs_pos.mpr hbZ_ne
  choose M₀ hM₀ using fun (i : ι) (j : Fin n) => hbZ_int (i, j) (Finset.mem_univ (i, j))
  have hM₀_eq : ∀ (i : ι) (j : Fin n), (M₀ i j : ℚ) = (bZ : ℚ) * r (i, j) := by
    intro i j
    have h := hM₀ i j
    change (algebraMap ℤ ℚ) (M₀ i j) = bZ • r (i, j) at h
    rw [zsmul_eq_mul] at h
    exact h
  have hc₀_M : ∃ M : ι → Fin n → ℤ,
      ∀ (i : ι) (j : Fin n), (M i j : ℚ) = (c₀ : ℚ) * r (i, j) := by
    rcases Int.natAbs_eq bZ with h_eq | h_eq
    · refine ⟨M₀, fun i j => ?_⟩
      have hcast : (bZ : ℚ) = (c₀ : ℚ) := by
        rw [h_eq, Int.cast_natCast]
      rw [hM₀_eq i j, hcast]
    · refine ⟨fun i j => -M₀ i j, fun i j => ?_⟩
      have hcast : (bZ : ℚ) = -(c₀ : ℚ) := by
        rw [h_eq, Int.cast_neg, Int.cast_natCast]
      push_cast
      rw [hM₀_eq i j, hcast, neg_mul, neg_neg]
  obtain ⟨M, hM⟩ := hc₀_M
  have hω_span : ∀ i : ι, (c₀ : R) * ω i = ∑ j : Fin n, (M i j : R) * e j := by
    intro i
    apply IsFractionRing.injective R K
    simp only [map_mul, map_natCast, map_sum, map_intCast]
    have hrepr := v₁.sum_repr (algebraMap R K (ω i))
    conv_lhs => rw [← hrepr]
    have h_c0_smul : (c₀ : K) * ∑ j : Fin n, v₁.repr (algebraMap R K (ω i)) j • v₁ j =
        ∑ j : Fin n, ((c₀ : ℚ) * r (i, j)) • v₁ j := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← map_natCast (algebraMap ℚ K) c₀, ← Algebra.smul_def, smul_smul]
    rw [h_c0_smul]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hM i j, hv₁_eq j, Algebra.smul_def]
    simp
  refine ⟨e, c₀, hc₀_pos, h_ortho, h_ne, fun x => ?_⟩
  refine ⟨fun j => ∑ i : ι, (ω.repr x i) * M i j, ?_⟩
  have hx := ω.sum_repr x
  conv_lhs => rw [← hx]
  have h_x_eq : ∑ i : ι, (ω.repr x i) • ω i = ∑ i : ι, (ω.repr x i : R) * ω i := by
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [zsmul_eq_mul]
  rw [h_x_eq, Finset.mul_sum]
  have h_step1 : ∑ i : ι, (c₀ : R) * ((ω.repr x i : R) * ω i) =
      ∑ i : ι, ∑ j : Fin n, ((ω.repr x i : R) * (M i j : R)) * e j := by
    refine Finset.sum_congr rfl (fun i _ => ?_)
    calc
      (c₀ : R) * ((ω.repr x i : R) * ω i) = (ω.repr x i : R) * ((c₀ : R) * ω i) := by ring
      _ = (ω.repr x i : R) * ∑ j : Fin n, (M i j : R) * e j := by rw [hω_span i]
      _ = ∑ j : Fin n, ((ω.repr x i : R) * (M i j : R)) * e j := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => by ring)
  rw [h_step1, Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [← Finset.sum_mul]
  push_cast
  rfl

theorem sum_sign_orthogonal_trace_eq_traceSignature {K : Type u} [Field K] [NumberField K]
    (γ : NumberField.RingOfIntegers K) (hγ_ne : γ ≠ 0)
    (e : Fin (Module.finrank ℚ K) → NumberField.RingOfIntegers K)
    (h_ortho : ∀ i j : Fin (Module.finrank ℚ K), i ≠ j →
      Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * e i * e j) = 0)
    (h_ne : ∀ j : Fin (Module.finrank ℚ K),
      Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2) ≠ 0) :
    (∑ j : Fin (Module.finrank ℚ K),
      if Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * (e j) ^ 2) < 0 then (-1 : ℤ) else 1) =
    traceSignature γ :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let n := Module.finrank ℚ K
  have h_s1 : ∀ z : Fin n → ℝ,
      ∑ j : Fin n,
        (Algebra.trace ℤ R (γ * (e j) ^ 2) : ℝ) * (z j) ^ 2 =
      ∑ σ : K →+* ℂ,
        (σ (algebraMap R K γ) *
          (∑ j : Fin n, (z j : ℂ) * σ (algebraMap R K (e j))) ^ 2).re := by
    intro z
    have h_tr_emb : ∀ r : R,
        ((Algebra.trace ℤ R r : ℤ) : ℂ) =
          ∑ σ : K →+* ℂ, σ (algebraMap R K r) := by
      intro r
      have h1 : Algebra.trace ℚ K (algebraMap R K r) = algebraMap ℤ ℚ (Algebra.trace ℤ R r) :=
        Algebra.trace_localization ℤ (nonZeroDivisors ℤ) r
      have h2 := congrArg (algebraMap ℚ ℂ) h1
      rw [trace_eq_sum_embeddings ℂ] at h2
      have h3 : (algebraMap ℚ ℂ) ((algebraMap ℤ ℚ) ((Algebra.trace ℤ R) r)) =
          ((Algebra.trace ℤ R r : ℤ) : ℂ) := by
        simp
      rw [← h3, ← h2]
      exact (Fintype.sum_equiv RingHom.equivRatAlgHom
        (fun σ : K →+* ℂ => σ (algebraMap R K r))
        (fun σ : K →ₐ[ℚ] ℂ => σ (algebraMap R K r))
        (fun _ => rfl)).symm
    have h_complex :
        (∑ j : Fin n,
          ((Algebra.trace ℤ R (γ * (e j) ^ 2) : ℤ) : ℂ) * (z j : ℂ) ^ 2) =
        ∑ σ : K →+* ℂ,
          σ (algebraMap R K γ) *
            (∑ j : Fin n, (z j : ℂ) * σ (algebraMap R K (e j))) ^ 2 := by
      have h_diag :
          (∑ j : Fin n,
            ((Algebra.trace ℤ R (γ * (e j) ^ 2) : ℤ) : ℂ) * (z j : ℂ) ^ 2) =
          ∑ i : Fin n, ∑ j : Fin n,
            ((Algebra.trace ℤ R (γ * e i * e j) : ℤ) : ℂ) * (z i : ℂ) * (z j : ℂ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.sum_eq_single i]
        · have h_sq : γ * (e i) ^ 2 = γ * e i * e i := by ring
          rw [h_sq]
          ring
        · intro j _ hji
          rw [h_ortho i j hji.symm]
          simp
        · intro hi
          exact absurd (Finset.mem_univ i) hi
      have h_step1 :
          (∑ i : Fin n, ∑ j : Fin n,
            ((Algebra.trace ℤ R (γ * e i * e j) : ℤ) : ℂ) * (z i : ℂ) * (z j : ℂ)) =
          ∑ i : Fin n, ∑ j : Fin n, ∑ σ : K →+* ℂ,
            (σ (algebraMap R K γ) *
              ((z i : ℂ) * σ (algebraMap R K (e i))) *
              ((z j : ℂ) * σ (algebraMap R K (e j)))) := by
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
        rw [h_tr_emb (γ * e i * e j), Finset.sum_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun σ _ => ?_)
        simp only [map_mul]
        ring
      have h_rhs :
          (∑ σ : K →+* ℂ,
            σ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ (algebraMap R K (e j))) ^ 2) =
          ∑ i : Fin n, ∑ j : Fin n, ∑ σ : K →+* ℂ,
            (σ (algebraMap R K γ) *
              ((z i : ℂ) * σ (algebraMap R K (e i))) *
              ((z j : ℂ) * σ (algebraMap R K (e j)))) := by
        have h_inner : ∀ σ : K →+* ℂ,
            σ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ (algebraMap R K (e j))) ^ 2 =
            ∑ i : Fin n, ∑ j : Fin n,
              (σ (algebraMap R K γ) *
                ((z i : ℂ) * σ (algebraMap R K (e i))) *
                ((z j : ℂ) * σ (algebraMap R K (e j)))) := by
          intro σ
          rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => by ring)
        simp_rw [h_inner]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
      rw [h_diag, h_step1, h_rhs]
    have h_re := congrArg Complex.re h_complex
    rw [Complex.re_sum, Complex.re_sum] at h_re
    rw [← h_re]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have h_cast :
        ((Algebra.trace ℤ R (γ * (e j) ^ 2) : ℤ) : ℂ) * (z j : ℂ) ^ 2 =
          (((Algebra.trace ℤ R (γ * (e j) ^ 2) : ℝ) * (z j) ^ 2 : ℝ) : ℂ) := by
      push_cast
      rfl
    rw [h_cast, Complex.ofReal_re]
  have h_s2 :
      ∃ (s : (K →+* ℂ) → ℤ) (C : (K →+* ℂ) → Fin n → ℝ),
        (∀ σ : K →+* ℂ, s σ = 1 ∨ s σ = -1) ∧
        (∑ σ : K →+* ℂ, s σ) = traceSignature γ ∧
        (∀ z : Fin n → ℝ,
          ∑ σ : K →+* ℂ,
            (σ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ (algebraMap R K (e j))) ^ 2).re =
          ∑ σ : K →+* ℂ,
            (s σ : ℝ) * (∑ j : Fin n, C σ j * z j) ^ 2) := by
    have h_mk_iff : ∀ (w : NumberField.InfinitePlace K) (σ : K →+* ℂ),
        NumberField.InfinitePlace.mk σ = w ↔
          σ = w.embedding ∨ σ = NumberField.ComplexEmbedding.conjugate w.embedding := by
      intro w σ
      have hw : w = NumberField.InfinitePlace.mk w.embedding :=
        (NumberField.InfinitePlace.mk_embedding w).symm
      rw [eq_comm]
      conv_lhs => rw [hw, NumberField.InfinitePlace.mk_eq_iff]
      exact or_congr eq_comm eq_comm
    have h_fiber_sum : ∀ {M : Type} [AddCommMonoid M] (F : (K →+* ℂ) → M),
        ∑ σ : K →+* ℂ, F σ =
          ∑ w : NumberField.InfinitePlace K,
            if w.IsReal then F w.embedding
            else F w.embedding + F (NumberField.ComplexEmbedding.conjugate w.embedding) := by
      intro M _ F
      rw [← Finset.sum_fiberwise Finset.univ (NumberField.InfinitePlace.mk : (K →+* ℂ) → NumberField.InfinitePlace K) F]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have h_filter :
          Finset.univ.filter (fun σ : K →+* ℂ => NumberField.InfinitePlace.mk σ = w) =
            {w.embedding, NumberField.ComplexEmbedding.conjugate w.embedding} := by
        ext σ
        simp [h_mk_iff w σ]
      rw [h_filter]
      by_cases hw : w.IsReal
      · rw [if_pos hw]
        have h_eq : NumberField.ComplexEmbedding.conjugate w.embedding = w.embedding :=
          NumberField.ComplexEmbedding.isReal_iff.mp (NumberField.InfinitePlace.isReal_iff.mp hw)
        rw [h_eq, Finset.pair_eq_singleton, Finset.sum_singleton]
      · rw [if_neg hw]
        have h_ne : w.embedding ≠ NumberField.ComplexEmbedding.conjugate w.embedding := by
          intro h_eq
          apply hw
          rw [NumberField.InfinitePlace.isReal_iff, NumberField.ComplexEmbedding.isReal_iff]
          exact h_eq.symm
        exact Finset.sum_pair h_ne
    let α : NumberField.InfinitePlace K → ℂ := fun w =>
      Classical.choose (IsAlgClosed.exists_eq_mul_self (2 * w.embedding (algebraMap R K γ)))
    have hα : ∀ w : NumberField.InfinitePlace K,
        2 * w.embedding (algebraMap R K γ) = α w * α w :=
      fun w => Classical.choose_spec (IsAlgClosed.exists_eq_mul_self (2 * w.embedding (algebraMap R K γ)))
    let s : (K →+* ℂ) → ℤ := fun σ =>
      let w := NumberField.InfinitePlace.mk σ
      if w.IsReal then realEmbedSign w γ
      else if σ = w.embedding then 1 else -1
    let C : (K →+* ℂ) → Fin n → ℝ := fun σ j =>
      let w := NumberField.InfinitePlace.mk σ
      if w.IsReal then
        Real.sqrt |(w.embedding (algebraMap R K γ)).re| * (w.embedding (algebraMap R K (e j))).re
      else if σ = w.embedding then
        (α w * w.embedding (algebraMap R K (e j))).re
      else
        (α w * w.embedding (algebraMap R K (e j))).im
    refine ⟨s, C, ?_, ?_, ?_⟩
    · intro σ
      dsimp [s, realEmbedSign]
      split_ifs <;> simp
    · rw [h_fiber_sum s]
      unfold traceSignature
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have h_mk_emb : NumberField.InfinitePlace.mk w.embedding = w :=
        NumberField.InfinitePlace.mk_embedding w
      have h_mk_conj : NumberField.InfinitePlace.mk (NumberField.ComplexEmbedding.conjugate w.embedding) = w := by
        rw [NumberField.InfinitePlace.mk_conjugate_eq, NumberField.InfinitePlace.mk_embedding]
      by_cases hw : w.IsReal
      · rw [if_pos hw, if_pos hw]
        dsimp [s]
        rw [h_mk_emb, if_pos hw]
      · rw [if_neg hw, if_neg hw]
        have h_ne : NumberField.ComplexEmbedding.conjugate w.embedding ≠ w.embedding := by
          intro h_eq
          apply hw
          rw [NumberField.InfinitePlace.isReal_iff, NumberField.ComplexEmbedding.isReal_iff]
          exact h_eq
        dsimp [s]
        rw [h_mk_emb, h_mk_conj, if_neg hw, if_neg hw, if_pos rfl, if_neg h_ne]
        ring
    · intro z
      rw [h_fiber_sum, h_fiber_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have h_mk_emb : NumberField.InfinitePlace.mk w.embedding = w :=
        NumberField.InfinitePlace.mk_embedding w
      have h_mk_conj : NumberField.InfinitePlace.mk (NumberField.ComplexEmbedding.conjugate w.embedding) = w := by
        rw [NumberField.InfinitePlace.mk_conjugate_eq, NumberField.InfinitePlace.mk_embedding]
      by_cases hw : w.IsReal
      · rw [if_pos hw, if_pos hw]
        let ρ := NumberField.InfinitePlace.embedding_of_isReal hw
        have hρ : ∀ x : K, w.embedding x = (ρ x : ℂ) :=
          fun x => (NumberField.InfinitePlace.embedding_of_isReal_apply hw x).symm
        have h_re_x : ∀ x : K, (w.embedding x).re = ρ x := by
          intro x
          rw [hρ x, Complex.ofReal_re]
        have h_lhs :
            (w.embedding (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * w.embedding (algebraMap R K (e j))) ^ 2).re =
            ρ (algebraMap R K γ) * (∑ j : Fin n, ρ (algebraMap R K (e j)) * z j) ^ 2 := by
          have h_inside :
              w.embedding (algebraMap R K γ) *
                (∑ j : Fin n, (z j : ℂ) * w.embedding (algebraMap R K (e j))) ^ 2 =
              ((ρ (algebraMap R K γ) * (∑ j : Fin n, ρ (algebraMap R K (e j)) * z j) ^ 2 : ℝ) : ℂ) := by
            simp_rw [hρ]
            push_cast
            congr 1
            congr 1
            refine Finset.sum_congr rfl (fun j _ => by ring)
          rw [h_inside, Complex.ofReal_re]
        have h_s : s w.embedding = realEmbedSign w γ := by
          dsimp [s]
          rw [h_mk_emb, if_pos hw]
        have h_C : ∀ j : Fin n,
            C w.embedding j =
              Real.sqrt |ρ (algebraMap R K γ)| * ρ (algebraMap R K (e j)) := by
          intro j
          dsimp [C]
          rw [h_mk_emb, if_pos hw, h_re_x, h_re_x]
        rw [h_lhs, h_s]
        simp_rw [h_C, mul_assoc, ← Finset.mul_sum]
        have h_sq_mul :
            (Real.sqrt |ρ (algebraMap R K γ)| * ∑ j : Fin n, ρ (algebraMap R K (e j)) * z j) ^ 2 =
              |ρ (algebraMap R K γ)| * (∑ j : Fin n, ρ (algebraMap R K (e j)) * z j) ^ 2 := by
          rw [mul_pow, Real.sq_sqrt (abs_nonneg _)]
        rw [h_sq_mul, ← mul_assoc]
        congr 1
        unfold realEmbedSign
        rw [h_re_x]
        by_cases hneg : ρ (algebraMap R K γ) < 0
        · rw [if_pos hneg, abs_of_neg hneg]
          push_cast
          ring
        · rw [if_neg hneg, abs_of_nonneg (not_lt.mp hneg)]
          push_cast
          ring
      · rw [if_neg hw, if_neg hw]
        have h_ne : NumberField.ComplexEmbedding.conjugate w.embedding ≠ w.embedding := by
          intro h_eq
          apply hw
          rw [NumberField.InfinitePlace.isReal_iff, NumberField.ComplexEmbedding.isReal_iff]
          exact h_eq
        let σ₁ := w.embedding
        let σ₂ := NumberField.ComplexEmbedding.conjugate w.embedding
        have h_conj_val :
            σ₂ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ₂ (algebraMap R K (e j))) ^ 2 =
            starRingEnd ℂ
              (σ₁ (algebraMap R K γ) *
                (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2) := by
          simp only [σ₂, σ₁, NumberField.ComplexEmbedding.conjugate_coe_eq,
            map_mul, map_pow, map_sum, Complex.conj_ofReal]
        have h_re_eq :
            (σ₂ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ₂ (algebraMap R K (e j))) ^ 2).re =
            (σ₁ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2).re := by
          rw [h_conj_val, Complex.conj_re]
        let Ξ : ℂ := ∑ j : Fin n, (z j : ℂ) * (α w * σ₁ (algebraMap R K (e j)))
        have h_Xi_factor :
            Ξ = α w * ∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j)) := by
          dsimp [Ξ]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => by ring)
        have h_Xi_sq :
            Ξ * Ξ =
              2 * (σ₁ (algebraMap R K γ) *
                (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2) := by
          rw [h_Xi_factor]
          calc
            (α w * ∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) *
                (α w * ∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j)))
              = (α w * α w) * (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2 := by ring
            _ = (2 * σ₁ (algebraMap R K γ)) *
                  (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2 := by rw [← hα w]
            _ = 2 * (σ₁ (algebraMap R K γ) *
                  (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2) := by ring
        have h_lhs_complex :
            (σ₁ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2).re +
            (σ₂ (algebraMap R K γ) *
              (∑ j : Fin n, (z j : ℂ) * σ₂ (algebraMap R K (e j))) ^ 2).re =
            Ξ.re ^ 2 - Ξ.im ^ 2 := by
          rw [h_re_eq]
          have h_mul_re := congrArg Complex.re h_Xi_sq
          rw [Complex.mul_re] at h_mul_re
          have h_two_re :
              (2 * (σ₁ (algebraMap R K γ) *
                (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2)).re =
              2 * (σ₁ (algebraMap R K γ) *
                (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2).re := by
            have h2 : (2 : ℂ) = ((2 : ℝ) : ℂ) := by norm_num
            rw [h2, Complex.re_ofReal_mul]
          rw [h_two_re] at h_mul_re
          linarith
        have h_s1_val : s σ₁ = 1 := by
          dsimp [s, σ₁]
          rw [h_mk_emb, if_neg hw, if_pos rfl]
        have h_s2_val : s σ₂ = -1 := by
          dsimp [s, σ₂]
          rw [h_mk_conj, if_neg hw, if_neg h_ne]
        have h_C1 : ∀ j : Fin n, C σ₁ j = (α w * σ₁ (algebraMap R K (e j))).re := by
          intro j
          dsimp [C, σ₁]
          rw [h_mk_emb, if_neg hw, if_pos rfl]
        have h_C2 : ∀ j : Fin n, C σ₂ j = (α w * σ₁ (algebraMap R K (e j))).im := by
          intro j
          dsimp [C, σ₂, σ₁]
          rw [h_mk_conj, if_neg hw, if_neg h_ne]
        have h_Xi_re : Ξ.re = ∑ j : Fin n, C σ₁ j * z j := by
          dsimp [Ξ]
          rw [Complex.re_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [Complex.re_ofReal_mul, h_C1 j, mul_comm]
        have h_Xi_im : Ξ.im = ∑ j : Fin n, C σ₂ j * z j := by
          dsimp [Ξ]
          rw [Complex.im_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [Complex.im_ofReal_mul, h_C2 j, mul_comm]
        change (σ₁ (algebraMap R K γ) *
            (∑ j : Fin n, (z j : ℂ) * σ₁ (algebraMap R K (e j))) ^ 2).re +
          (σ₂ (algebraMap R K γ) *
            (∑ j : Fin n, (z j : ℂ) * σ₂ (algebraMap R K (e j))) ^ 2).re =
          (s σ₁ : ℝ) * (∑ j : Fin n, C σ₁ j * z j) ^ 2 +
          (s σ₂ : ℝ) * (∑ j : Fin n, C σ₂ j * z j) ^ 2
        rw [h_lhs_complex, h_s1_val, h_s2_val, ← h_Xi_re, ← h_Xi_im]
        push_cast
        ring
  obtain ⟨s, C, hs, h_sum_s, h_emb_eq⟩ := h_s2
  let d : Fin n → ℤ := fun j => Algebra.trace ℤ R (γ * (e j) ^ 2)
  have h_quad : ∀ z : Fin n → ℝ,
      ∑ j : Fin n, (d j : ℝ) * (z j) ^ 2 =
        ∑ σ : K →+* ℂ, (s σ : ℝ) * (∑ j : Fin n, C σ j * z j) ^ 2 :=
    fun z => (h_s1 z).trans (h_emb_eq z)
  have h_card : Fintype.card (K →+* ℂ) = n := NumberField.Embeddings.card K ℂ
  let N₁ := {j : Fin n // d j < 0}
  let P₁ := {j : Fin n // ¬ d j < 0}
  let P₂ := {σ : K →+* ℂ // s σ = 1}
  let N₂ := {σ : K →+* ℂ // ¬ s σ = 1}
  have h_card₁ : Fintype.card N₁ + Fintype.card P₁ = n := by
    dsimp [N₁, P₁]
    have hle : Fintype.card {j : Fin n // d j < 0} ≤ Fintype.card (Fin n) :=
      Fintype.card_subtype_le _
    rw [Fintype.card_fin] at hle
    rw [Fintype.card_subtype_compl, Fintype.card_fin]
    omega
  have h_card₂ : Fintype.card P₂ + Fintype.card N₂ = n := by
    dsimp [P₂, N₂]
    have hle : Fintype.card {σ : K →+* ℂ // s σ = 1} ≤ Fintype.card (K →+* ℂ) :=
      Fintype.card_subtype_le _
    rw [h_card] at hle
    rw [Fintype.card_subtype_compl, h_card]
    omega
  have h_sum₁ :
      (∑ j : Fin n, if d j < 0 then (-1 : ℤ) else 1) =
        (Fintype.card P₁ : ℤ) - (Fintype.card N₁ : ℤ) := by
    rw [Finset.sum_ite, Finset.sum_const, Finset.sum_const]
    have hc1 : (Finset.univ.filter (fun j : Fin n => d j < 0)).card = Fintype.card N₁ :=
      (Fintype.card_subtype (fun j : Fin n => d j < 0)).symm
    have hc2 : (Finset.univ.filter (fun j : Fin n => ¬ d j < 0)).card = Fintype.card P₁ :=
      (Fintype.card_subtype (fun j : Fin n => ¬ d j < 0)).symm
    rw [hc1, hc2]
    simp only [nsmul_eq_mul, mul_neg, mul_one]
    ring
  have h_sum₂ :
      (∑ σ : K →+* ℂ, s σ) = (Fintype.card P₂ : ℤ) - (Fintype.card N₂ : ℤ) := by
    have hs_ite : ∀ σ : K →+* ℂ, s σ = if s σ = 1 then (1 : ℤ) else -1 := by
      intro σ
      rcases hs σ with h1 | h2
      · rw [if_pos h1, h1]
      · have hne : s σ ≠ 1 := by omega
        rw [if_neg hne, h2]
    rw [Finset.sum_congr rfl (fun σ _ => hs_ite σ)]
    rw [Finset.sum_ite, Finset.sum_const, Finset.sum_const]
    have hc1 : (Finset.univ.filter (fun σ : K →+* ℂ => s σ = 1)).card = Fintype.card P₂ :=
      (Fintype.card_subtype (fun σ : K →+* ℂ => s σ = 1)).symm
    have hc2 : (Finset.univ.filter (fun σ : K →+* ℂ => ¬ s σ = 1)).card = Fintype.card N₂ :=
      (Fintype.card_subtype (fun σ : K →+* ℂ => ¬ s σ = 1)).symm
    rw [hc1, hc2]
    simp only [nsmul_eq_mul, mul_neg, mul_one]
    ring
  let Φ_pos : (Fin n → ℝ) →ₗ[ℝ] (N₁ → ℝ) × (P₂ → ℝ) :=
    { toFun := fun z => (fun j => z j.1, fun σ => ∑ j : Fin n, C σ.1 j * z j)
      map_add' := by
        intro x y
        ext j
        · rfl
        · simp [mul_add, Finset.sum_add_distrib]
      map_smul' := by
        intro r x
        ext j
        · rfl
        · simp [mul_left_comm, ← Finset.mul_sum] }
  have h_inj_pos : Function.Injective Φ_pos := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro z hz
    rw [LinearMap.mem_ker] at hz
    have hz1 : ∀ j : N₁, z j.1 = 0 := fun j => congrFun (congrArg Prod.fst hz) j
    have hz2 : ∀ σ : P₂, ∑ j : Fin n, C σ.1 j * z j = 0 :=
      fun σ => congrFun (congrArg Prod.snd hz) σ
    have h_term_nonneg : ∀ j : Fin n, 0 ≤ (d j : ℝ) * (z j) ^ 2 := by
      intro j
      by_cases hj : d j < 0
      · have h0 : z j = 0 := hz1 ⟨j, hj⟩
        rw [h0]
        simp
      · have hd_nonneg : (0 : ℝ) ≤ (d j : ℝ) := by exact_mod_cast not_lt.mp hj
        exact mul_nonneg hd_nonneg (sq_nonneg (z j))
    have h_rhs_nonpos : ∑ σ : K →+* ℂ, (s σ : ℝ) * (∑ j : Fin n, C σ j * z j) ^ 2 ≤ 0 := by
      refine Finset.sum_nonpos (fun σ _ => ?_)
      by_cases hσ : s σ = 1
      · have h0 : ∑ j : Fin n, C σ j * z j = 0 := hz2 ⟨σ, hσ⟩
        rw [h0]
        simp
      · rcases hs σ with h1 | h2
        · exact absurd h1 hσ
        · rw [h2]
          push_cast
          linarith [sq_nonneg (∑ j : Fin n, C σ j * z j)]
    have h_lhs_zero : ∑ j : Fin n, (d j : ℝ) * (z j) ^ 2 = 0 := by
      apply le_antisymm
      · rw [h_quad z]
        exact h_rhs_nonpos
      · exact Finset.sum_nonneg (fun j _ => h_term_nonneg j)
    have h_all_zero : ∀ j ∈ (Finset.univ : Finset (Fin n)), (d j : ℝ) * (z j) ^ 2 = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => h_term_nonneg j)).mp h_lhs_zero
    ext j
    have h_prod_zero := h_all_zero j (Finset.mem_univ j)
    have hd_ne : (d j : ℝ) ≠ 0 := Int.cast_ne_zero.mpr (h_ne j)
    rcases mul_eq_zero.mp h_prod_zero with h1 | h2
    · exact absurd h1 hd_ne
    · exact eq_zero_of_pow_eq_zero h2
  have h_le_pos : n ≤ Fintype.card N₁ + Fintype.card P₂ := by
    have h := LinearMap.finrank_le_finrank_of_injective h_inj_pos
    rw [Module.finrank_pi, Fintype.card_fin, Module.finrank_prod,
      Module.finrank_pi, Module.finrank_pi] at h
    exact h
  let Φ_neg : (Fin n → ℝ) →ₗ[ℝ] (P₁ → ℝ) × (N₂ → ℝ) :=
    { toFun := fun z => (fun j => z j.1, fun σ => ∑ j : Fin n, C σ.1 j * z j)
      map_add' := by
        intro x y
        ext j
        · rfl
        · simp [mul_add, Finset.sum_add_distrib]
      map_smul' := by
        intro r x
        ext j
        · rfl
        · simp [mul_left_comm, ← Finset.mul_sum] }
  have h_inj_neg : Function.Injective Φ_neg := by
    rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro z hz
    rw [LinearMap.mem_ker] at hz
    have hz1 : ∀ j : P₁, z j.1 = 0 := fun j => congrFun (congrArg Prod.fst hz) j
    have hz2 : ∀ σ : N₂, ∑ j : Fin n, C σ.1 j * z j = 0 :=
      fun σ => congrFun (congrArg Prod.snd hz) σ
    have h_term_nonneg : ∀ j : Fin n, 0 ≤ -((d j : ℝ) * (z j) ^ 2) := by
      intro j
      by_cases hj : d j < 0
      · have hd_neg : (d j : ℝ) ≤ 0 := by exact_mod_cast le_of_lt hj
        have h_nonpos : (d j : ℝ) * (z j) ^ 2 ≤ 0 :=
          mul_nonpos_of_nonpos_of_nonneg hd_neg (sq_nonneg (z j))
        linarith
      · have h0 : z j = 0 := hz1 ⟨j, hj⟩
        rw [h0]
        simp
    have h_rhs_nonneg : 0 ≤ ∑ σ : K →+* ℂ, (s σ : ℝ) * (∑ j : Fin n, C σ j * z j) ^ 2 := by
      refine Finset.sum_nonneg (fun σ _ => ?_)
      by_cases hσ : s σ = 1
      · rw [hσ]
        push_cast
        linarith [sq_nonneg (∑ j : Fin n, C σ j * z j)]
      · have h0 : ∑ j : Fin n, C σ j * z j = 0 := hz2 ⟨σ, hσ⟩
        rw [h0]
        simp
    have h_lhs_zero : ∑ j : Fin n, -((d j : ℝ) * (z j) ^ 2) = 0 := by
      apply le_antisymm
      · rw [Finset.sum_neg_distrib, h_quad z]
        linarith
      · exact Finset.sum_nonneg (fun j _ => h_term_nonneg j)
    have h_all_zero : ∀ j ∈ (Finset.univ : Finset (Fin n)), -((d j : ℝ) * (z j) ^ 2) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => h_term_nonneg j)).mp h_lhs_zero
    ext j
    have h_prod_zero : (d j : ℝ) * (z j) ^ 2 = 0 := neg_eq_zero.mp (h_all_zero j (Finset.mem_univ j))
    have hd_ne : (d j : ℝ) ≠ 0 := Int.cast_ne_zero.mpr (h_ne j)
    rcases mul_eq_zero.mp h_prod_zero with h1 | h2
    · exact absurd h1 hd_ne
    · exact eq_zero_of_pow_eq_zero h2
  have h_le_neg : n ≤ Fintype.card P₁ + Fintype.card N₂ := by
    have h := LinearMap.finrank_le_finrank_of_injective h_inj_neg
    rw [Module.finrank_pi, Fintype.card_fin, Module.finrank_prod,
      Module.finrank_pi, Module.finrank_pi] at h
    exact h
  have h_inert : (∑ j : Fin n, if d j < 0 then (-1 : ℤ) else 1) = ∑ σ : K →+* ℂ, s σ := by
    rw [h_sum₁, h_sum₂]
    omega
  exact h_inert.trans h_sum_s

theorem exists_dual_trace_elem_fullPfisterModulus {K : Type u} [Field K] [NumberField K]
    (α β γ : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal))
    (h_sqfree : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        valNat v α ≤ 1 ∧ valNat v β ≤ 1)
    (hγ : ∃ δ : NumberField.RingOfIntegers K, α * β = γ * δ)
    (i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) :
    ∃ v : NumberField.RingOfIntegers K,
      ((fullPfisterModulus α β : ℤ) ∣ Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * v ^ 2)) ∧
      (∀ x : NumberField.RingOfIntegers K,
        2 * Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * x * v) =
          (fullPfisterModulus α β : ℤ) * ((NumberField.RingOfIntegers.basis K).repr x i)) :=
by
  have s1 : ∀ (N : ℕ), 4 ∣ N → ∀ (γ : NumberField.RingOfIntegers K), γ ≠ 0 →
      ((N / 4 : ℕ) : NumberField.RingOfIntegers K) ∈
        Ideal.span {γ} * differentIdeal ℤ (NumberField.RingOfIntegers K) →
      ∀ (i : Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)),
      ∃ v : NumberField.RingOfIntegers K,
        ((N : ℤ) ∣ Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * v ^ 2)) ∧
        (∀ x : NumberField.RingOfIntegers K,
          2 * Algebra.trace ℤ (NumberField.RingOfIntegers K) (γ * x * v) =
            (N : ℤ) * ((NumberField.RingOfIntegers.basis K).repr x i)) := by
    intro N h4_dvd γ hγ_ne h_mem i
    let R := NumberField.RingOfIntegers K
    let ι := Module.Free.ChooseBasisIndex ℤ R
    let b := NumberField.RingOfIntegers.basis K
    obtain ⟨a, ha_diff, hγa_eq⟩ := Ideal.mem_span_singleton_mul.mp h_mem
    let b_Q : Module.Basis ι ℚ K := b.localizationLocalization ℚ (nonZeroDivisors ℤ) K
    have h_tr_dual : ∀ x : R,
        (Algebra.trace ℚ K) (b_Q.traceDual i * algebraMap R K x) =
          algebraMap ℤ ℚ (b.repr x i) := by
      intro x
      conv_lhs => rw [← b_Q.sum_repr (algebraMap R K x)]
      rw [Finset.mul_sum, map_sum]
      have h_term : ∀ j : ι,
          (Algebra.trace ℚ K) (b_Q.traceDual i * (b_Q.repr (algebraMap R K x) j • b_Q j)) =
            if j = i then algebraMap ℤ ℚ (b.repr x i) else 0 := by
        intro j
        rw [mul_smul_comm, map_smul, b_Q.trace_traceDual_mul i j]
        have h_repr : b_Q.repr (algebraMap R K x) j = algebraMap ℤ ℚ (b.repr x j) :=
          b.localizationLocalization_repr_algebraMap ℚ (nonZeroDivisors ℤ) K x j
        rw [h_repr]
        split_ifs with hji
        · subst hji; simp
        · simp
      simp_rw [h_term]
      simp
    have h_mem_dual : b_Q.traceDual i ∈
        FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K) := by
      rw [← FractionalIdeal.mem_coe, FractionalIdeal.coe_dual_one ℤ ℚ K R, Submodule.mem_traceDual]
      intro y hy
      obtain ⟨x, rfl⟩ := Submodule.mem_one.mp hy
      exact ⟨b.repr x i, (h_tr_dual x).symm⟩
    have ha_inv : algebraMap R K a ∈
        (FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K))⁻¹ := by
      rw [← coeIdeal_differentIdeal ℤ ℚ K R]
      exact FractionalIdeal.mem_coeIdeal_of_mem (nonZeroDivisors R) ha_diff
    have h_dual_ne : FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K) ≠ 0 :=
      FractionalIdeal.dual_ne_zero ℤ ℚ one_ne_zero
    have hau_mem : algebraMap R K a * b_Q.traceDual i ∈
        (1 : FractionalIdeal (nonZeroDivisors R) K) :=
      (FractionalIdeal.mem_inv_iff h_dual_ne).mp ha_inv (b_Q.traceDual i) h_mem_dual
    rw [FractionalIdeal.mem_one_iff] at hau_mem
    obtain ⟨u, hu_eq⟩ := hau_mem
    have h_tr_u : ∀ x : R,
        Algebra.trace ℤ R (γ * x * u) = ((N / 4 : ℕ) : ℤ) * (b.repr x i) := by
      intro x
      apply IsFractionRing.injective ℤ ℚ
      have h_tr_loc := Algebra.trace_localization ℤ (nonZeroDivisors ℤ) (Rₘ := ℚ) (Sₘ := K) (γ * x * u)
      rw [← h_tr_loc]
      have h_alg : algebraMap R K (γ * x * u) =
          algebraMap ℤ ℚ ((N / 4 : ℕ) : ℤ) • (b_Q.traceDual i * algebraMap R K x) := by
        calc algebraMap R K (γ * x * u)
          _ = algebraMap R K γ * algebraMap R K x * algebraMap R K u := by
              simp [map_mul]
          _ = algebraMap R K γ * algebraMap R K x * (algebraMap R K a * b_Q.traceDual i) := by
              rw [← hu_eq]
          _ = algebraMap R K (γ * a) * (b_Q.traceDual i * algebraMap R K x) := by
              rw [map_mul]; ring
          _ = algebraMap R K ((N / 4 : ℕ) : R) * (b_Q.traceDual i * algebraMap R K x) := by
              rw [hγa_eq]
          _ = algebraMap ℤ ℚ ((N / 4 : ℕ) : ℤ) • (b_Q.traceDual i * algebraMap R K x) := by
              rw [Algebra.smul_def]
              congr 1
              simp only [map_natCast]
      rw [h_alg, map_smul, h_tr_dual x, smul_eq_mul, map_mul]
    refine ⟨2 * u, ?_, ?_⟩
    · have h_sq : γ * (2 * u) ^ 2 = (4 : ℕ) • (γ * u * u) := by
        rw [nsmul_eq_mul]; push_cast; ring
      rw [h_sq, map_nsmul, h_tr_u u, nsmul_eq_mul]
      have hN_eq : ((4 : ℕ) : ℤ) * ((N / 4 : ℕ) : ℤ) = (N : ℤ) := by
        exact_mod_cast Nat.mul_div_cancel' h4_dvd
      rw [← mul_assoc, hN_eq]
      exact dvd_mul_right (N : ℤ) (b.repr u i)
    · intro x
      have h_lin : γ * x * (2 * u) = (2 : ℕ) • (γ * x * u) := by
        rw [nsmul_eq_mul]; push_cast; ring
      rw [h_lin, map_nsmul, h_tr_u x, nsmul_eq_mul]
      have hN_eq : (4 : ℤ) * ((N / 4 : ℕ) : ℤ) = (N : ℤ) := by
        exact_mod_cast Nat.mul_div_cancel' h4_dvd
      calc 2 * (((2 : ℕ) : ℤ) * (((N / 4 : ℕ) : ℤ) * (b.repr x i)))
        _ = ((4 : ℤ) * ((N / 4 : ℕ) : ℤ)) * (b.repr x i) := by push_cast; ring
        _ = (N : ℤ) * (b.repr x i) := by rw [hN_eq]
  have s2 : ∀ (γ x : NumberField.RingOfIntegers K), γ ≠ 0 → x ≠ 0 →
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ k : ℕ, ¬ (differentIdeal ℤ (NumberField.RingOfIntegers K) ≤ v.asIdeal ^ (k + 1)) ∧
          valNat v γ + k ≤ valNat v x) →
      x ∈ Ideal.span {γ} * differentIdeal ℤ (NumberField.RingOfIntegers K) := by
    intro γ x hγ_ne hx_ne h_loc
    classical
    let R := NumberField.RingOfIntegers K
    let Ix : Ideal R := Ideal.span {x}
    let Iγ : Ideal R := Ideal.span {γ}
    let Idiff : Ideal R := differentIdeal ℤ R
    have hIx_ne : Ix ≠ 0 := Ideal.span_singleton_eq_bot.not.mpr hx_ne
    have hIγ_ne : Iγ ≠ 0 := Ideal.span_singleton_eq_bot.not.mpr hγ_ne
    have hIdiff_ne : Idiff ≠ 0 := differentIdeal_ne_bot
    let Sx := (Associates.finite_factors hIx_ne).toFinset
    let Sγ := (Associates.finite_factors hIγ_ne).toFinset
    let Sdiff := (Associates.finite_factors hIdiff_ne).toFinset
    let S : Finset (IsDedekindDomain.HeightOneSpectrum R) := Sx ∪ Sγ ∪ Sdiff
    have h_prod_eq : ∀ (I : Ideal R) (hI : I ≠ 0),
        (Associates.finite_factors hI).toFinset ⊆ S →
        ∏ v ∈ S, v.maxPowDividing I = I := by
      intro I hI hsub
      refine Eq.trans ?_ (Ideal.finprod_heightOneSpectrum_factorization hI)
      symm
      refine finprod_eq_prod_of_mulSupport_subset _ ?_
      intro v hv
      apply hsub
      rw [Set.Finite.mem_toFinset]
      intro h_zero
      apply hv
