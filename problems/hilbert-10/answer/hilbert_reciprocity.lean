    haveI : NeZero p := ⟨ne_of_gt hp_pos⟩
    have hL_pos : 0 < L := pow_pos hp_pos (2 * n)
    have hL_ne : ((L : ℕ) : R) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hL_pos)
    have hL_val : v.intValuation ((L : ℕ) : R) = WithZero.exp (-(kv : ℤ)) := by
      have hv_ne : v.intValuation ((L : ℕ) : R) ≠ 0 :=
        v.intValuation_ne_zero' ⟨((L : ℕ) : R), mem_nonZeroDivisors_of_ne_zero hL_ne⟩
      have hv_le : v.intValuation ((L : ℕ) : R) ≤ 1 := v.intValuation_le_one ((L : ℕ) : R)
      have hlog_le : WithZero.log (v.intValuation ((L : ℕ) : R)) ≤ 0 := by
        rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
