      (Ideal.span_singleton_le_iff_mem _).mpr ha_mem
    have hspan_b : Ideal.span {b} ≤ v.asIdeal ^ k :=
      (Ideal.span_singleton_le_iff_mem _).mpr hb_mem
    have hspan_s₀ : Ideal.span {s₀} ≤ J :=
