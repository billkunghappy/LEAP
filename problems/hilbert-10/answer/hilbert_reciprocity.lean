          _ = 0 := sub_eq_zero.mpr hT_eq
        rcases mul_eq_zero.mp h_sub with hT0 | h1z
        · exact hT0
        · exact False.elim (hz₀_ne (sub_eq_zero.mp h1z).symm)
      · exact if_neg hx
    rw [Finset.sum_congr rfl (fun x _ => h_inner_zero x), Finset.sum_const_zero] at h_avg
    exact (mul_eq_zero.mp h_avg).resolve_left hS_c1_ne
  have h0_V₁ : (0 : R ⧸ Iv) ∈ V₁ := by
    rw [Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    have h0_Iv : Quotient.out (0 : R ⧸ Iv) - 0 ∈ Iv := by
      apply Ideal.Quotient.eq.mp
      rw [Ideal.Quotient.mk_out, map_zero]
    rw [sub_zero] at h0_Iv
    exact hIv_le_v h0_Iv
  have hV₁_pos : 0 < V₁.card := Finset.card_pos.mpr ⟨0, h0_V₁⟩
  let π₁ : R ⧸ Iv → R ⧸ v.asIdeal := fun x => Ideal.Quotient.mk v.asIdeal (Quotient.out x)
  have h_fib_π₁ : ∀ r : R ⧸ v.asIdeal,
      (Finset.univ.filter (fun y : R ⧸ Iv => π₁ y = r)).card = V₁.card := by
    intro r
    let x_r : R ⧸ Iv := Ideal.Quotient.mk Iv (Quotient.out r)
    have hxr_diff : Quotient.out x_r - Quotient.out r ∈ v.asIdeal :=
      hIv_le_v (Ideal.Quotient.eq.mp (Ideal.Quotient.mk_out x_r))
    symm
    refine Finset.card_bijective (Equiv.addRight x_r) (Equiv.addRight x_r).bijective (fun z => ?_)
    rw [Finset.mem_filter, Finset.mem_filter]
    dsimp [Equiv.addRight, π₁, V₁]
    simp only [Finset.mem_univ, true_and]
    rw [← Ideal.Quotient.mk_out r, Ideal.Quotient.eq]
    have h_diff : (Quotient.out (z + x_r) - Quotient.out r) - Quotient.out z ∈ v.asIdeal := by
      have h1 : Quotient.out (z + x_r) - (Quotient.out z + Quotient.out x_r) ∈ v.asIdeal :=
        hIv_le_v (h_out_add z x_r)
      convert v.asIdeal.add_mem h1 hxr_diff using 1
      ring
    constructor
    · intro hz
      convert v.asIdeal.add_mem h_diff hz using 1
      ring
    · intro hzr
      convert v.asIdeal.sub_mem hzr h_diff using 1
      ring
  have h_card_A1 : Fintype.card (R ⧸ Iv) = V₁.card * Nat.card (R ⧸ v.asIdeal) := by
    calc Fintype.card (R ⧸ Iv)
      _ = (Finset.univ : Finset (R ⧸ Iv)).card := Finset.card_univ.symm
      _ = ∑ r ∈ (Finset.univ : Finset (R ⧸ v.asIdeal)),
            (Finset.univ.filter (fun y : R ⧸ Iv => π₁ y = r)).card :=
          Finset.card_eq_sum_card_fiberwise (fun y _ => Finset.mem_univ (π₁ y))
      _ = ∑ _r ∈ (Finset.univ : Finset (R ⧸ v.asIdeal)), V₁.card :=
          Finset.sum_congr rfl (fun r _ => h_fib_π₁ r)
      _ = Fintype.card (R ⧸ v.asIdeal) * V₁.card := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
      _ = V₁.card * Nat.card (R ⧸ v.asIdeal) := by
          rw [Nat.card_eq_fintype_card, mul_comm]
  let f_π : R ⧸ Iv → R ⧸ Iv := fun y => Ideal.Quotient.mk Iv π * y
  let K_π : Finset (R ⧸ Iv) := Finset.univ.filter (fun z : R ⧸ Iv => f_π z = 0)
  have hπ_mem : π ∈ v.asIdeal := by
    have h1 := (v.intValuation_le_pow_iff_mem π 1).mp (le_of_eq hπ)
    simpa using h1
  have hf_maps : ∀ y ∈ (Finset.univ : Finset (R ⧸ Iv)), f_π y ∈ V₁ := by
    intro y _
    rw [Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    have h_diff : Quotient.out (f_π y) - π * Quotient.out y ∈ Iv := by
      apply Ideal.Quotient.eq.mp
      dsimp [f_π]
      rw [Ideal.Quotient.mk_out, map_mul, Ideal.Quotient.mk_out]
    have h1 : Quotient.out (f_π y) - π * Quotient.out y ∈ v.asIdeal := hIv_le_v h_diff
    have h2 : π * Quotient.out y ∈ v.asIdeal := v.asIdeal.mul_mem_right (Quotient.out y) hπ_mem
    convert v.asIdeal.add_mem h1 h2 using 1
    ring
  obtain ⟨s₁, hs₁J, hs₁v⟩ := SetLike.not_le_iff_exists.mp hJ₁_not_le
  obtain ⟨u₀, i₀, hi₀, hu₀⟩ := v.isMaximal.exists_inv hs₁v
  have h_cop0 : IsCoprime (Ideal.span {s₁}) v.asIdeal := by
    rw [Ideal.isCoprime_iff_exists]
    exact ⟨u₀ * s₁, Ideal.mem_span_singleton.mpr ⟨u₀, by ring⟩, i₀, hi₀, hu₀⟩
  have h_cop : IsCoprime (Ideal.span {s₁}) Iv := h_cop0.pow_right
  obtain ⟨a₁, ha₁, r₁, hr₁, har₁⟩ := Ideal.isCoprime_iff_exists.mp h_cop
  obtain ⟨s₁', rfl⟩ := Ideal.mem_span_singleton.mp ha₁
  have h_fib_fπ : ∀ x ∈ V₁,
      (Finset.univ.filter (fun y : R ⧸ Iv => f_π y = x)).card = K_π.card := by
    intro x hx
    have hx_mem : Quotient.out x ∈ v.asIdeal := (Finset.mem_filter.mp hx).2
    have hxs₁ : Quotient.out x * s₁ ∈ Ideal.span {π} := by
      rw [hJ₁]
      exact Ideal.mul_mem_mul hx_mem hs₁J
    obtain ⟨u_x, hu_x⟩ := Ideal.mem_span_singleton.mp hxs₁
    let y_x : R ⧸ Iv := Ideal.Quotient.mk Iv (u_x * s₁')
    have hy_x : f_π y_x = x := by
      dsimp [f_π, y_x]
      rw [← map_mul, ← Ideal.Quotient.mk_out x, Ideal.Quotient.eq]
      have h_id : π * (u_x * s₁') - Quotient.out x =
          (π * u_x - Quotient.out x * s₁) * s₁' +
          Quotient.out x * (s₁ * s₁' + r₁ - 1) -
          Quotient.out x * r₁ := by ring
      rw [h_id, hu_x, har₁, sub_self, zero_mul, sub_self, mul_zero, add_zero, zero_sub]
      exact Iv.neg_mem (Iv.mul_mem_left (Quotient.out x) hr₁)
    symm
    refine Finset.card_bijective (Equiv.addRight y_x) (Equiv.addRight y_x).bijective (fun z => ?_)
    rw [Finset.mem_filter, Finset.mem_filter]
    dsimp [Equiv.addRight, K_π]
    simp only [Finset.mem_univ, true_and]
    have h_add_f : f_π (z + y_x) = f_π z + x := by
      change Ideal.Quotient.mk Iv π * (z + y_x) = f_π z + x
      rw [mul_add]
      exact congrArg (f_π z + ·) hy_x
    rw [h_add_f]
    exact ⟨fun hz0 => by rw [hz0, zero_add], fun hzx => by
      calc f_π z = (f_π z + x) - x := by ring
      _ = x - x := by rw [hzx]
      _ = 0 := sub_self x⟩
  have h_card_A2 : Fintype.card (R ⧸ Iv) = V₁.card * K_π.card := by
    calc Fintype.card (R ⧸ Iv)
      _ = (Finset.univ : Finset (R ⧸ Iv)).card := Finset.card_univ.symm
      _ = ∑ x ∈ V₁, (Finset.univ.filter (fun y : R ⧸ Iv => f_π y = x)).card :=
          Finset.card_eq_sum_card_fiberwise hf_maps
      _ = ∑ _x ∈ V₁, K_π.card := Finset.sum_congr rfl h_fib_fπ
      _ = V₁.card * K_π.card := by rw [Finset.sum_const, smul_eq_mul]
  have hK_card : K_π.card = Nat.card (R ⧸ v.asIdeal) :=
    Nat.eq_of_mul_eq_mul_left hV₁_pos (h_card_A2.symm.trans h_card_A1)
  have h_s4 : ∀ (δ : R), IsLocalModulusCharTrivialOnPow m v δ kv →
      localModulusTraceGaussSum m v (δ * π ^ 2) =
        (Nat.card (R ⧸ v.asIdeal) : ℂ) * subSum δ := by
    intro δ h_triv
    dsimp [localModulusTraceGaussSum, subSum]
    rw [dif_pos hIv]
    let ψ : R → ℂ := fun z =>
      Complex.exp (2 * Real.pi * Complex.I *
        ((Algebra.trace ℤ R (localModulusIdempotent m v * δ * z) : ℤ) : ℂ) / (m : ℂ))
    have hψ_add : ∀ z₁ z₂ : R, ψ (z₁ + z₂) = ψ z₁ * ψ z₂ := by
      intro z₁ z₂
      dsimp [ψ]
      rw [mul_add, map_add, Int.cast_add, mul_add, add_div, Complex.exp_add]
    have hψ_congr_Iv : ∀ {z₁ z₂ : R}, z₁ - z₂ ∈ Iv → ψ z₁ = ψ z₂ := by
      intro z₁ z₂ h_diff
      have h_eq : z₁ = z₂ + (z₁ - z₂) := by ring
      have h_triv1 : ψ (z₁ - z₂) = 1 := h_triv (z₁ - z₂) h_diff
      rw [h_eq, hψ_add, h_triv1, mul_one]
    have h_term : ∀ y ∈ (Finset.univ : Finset (R ⧸ Iv)),
        Complex.exp (2 * Real.pi * Complex.I *
          ((Algebra.trace ℤ R
            (localModulusIdempotent m v * (δ * π ^ 2) * (Quotient.out y) ^ 2) : ℤ) : ℂ) /
          (m : ℂ)) =
        ψ ((Quotient.out (f_π y)) ^ 2) := by
      intro y _
      have h_eq : localModulusIdempotent m v * (δ * π ^ 2) * (Quotient.out y) ^ 2 =
          localModulusIdempotent m v * δ * (π ^ 2 * (Quotient.out y) ^ 2) := by ring
      rw [h_eq]
      change ψ (π ^ 2 * (Quotient.out y) ^ 2) = ψ ((Quotient.out (f_π y)) ^ 2)
      symm
      apply hψ_congr_Iv
      have h_diff : Quotient.out (f_π y) - π * Quotient.out y ∈ Iv := by
        apply Ideal.Quotient.eq.mp
        dsimp [f_π]
        rw [Ideal.Quotient.mk_out, map_mul, Ideal.Quotient.mk_out]
      have h_id : (Quotient.out (f_π y)) ^ 2 - π ^ 2 * (Quotient.out y) ^ 2 =
          (Quotient.out (f_π y) - π * Quotient.out y) *
            (Quotient.out (f_π y) + π * Quotient.out y) := by ring
      rw [h_id]
      exact Iv.mul_mem_right _ h_diff
    rw [Finset.sum_congr rfl h_term, ← Finset.sum_fiberwise_of_maps_to hf_maps]
    have h_inner : ∀ x ∈ V₁,
        (∑ y ∈ Finset.univ.filter (fun y : R ⧸ Iv => f_π y = x),
          ψ ((Quotient.out (f_π y)) ^ 2)) =
        (Nat.card (R ⧸ v.asIdeal) : ℂ) * ψ ((Quotient.out x) ^ 2) := by
      intro x hx
      have h_congr : ∀ y ∈ Finset.univ.filter (fun y : R ⧸ Iv => f_π y = x),
          ψ ((Quotient.out (f_π y)) ^ 2) = ψ ((Quotient.out x) ^ 2) := by
        intro y hy
        rw [(Finset.mem_filter.mp hy).2]
      rw [Finset.sum_congr rfl h_congr, Finset.sum_const, nsmul_eq_mul, h_fib_fπ x hx, hK_card]
    rw [Finset.sum_congr rfl h_inner, ← Finset.mul_sum]
  refine ⟨γ * π ^ 2, h_s2, ?_⟩
  have h_triv_γ : IsLocalModulusCharTrivialOnPow m v γ kv :=
    fun z hz => h_cond.2.1 z (hIv_le_c hz)
  have h_triv_β : IsLocalModulusCharTrivialOnPow m v (-γ * β) kv :=
    fun z hz => h_s1.2.1 z (hIv_le_c hz)
  have h_sub_γ := h_s3 γ h_cond
  have h_sub_β := h_s3 (-γ * β) h_s1
  have h_step_γ := h_s4 γ h_triv_γ
  have h_step_β := h_s4 (-γ * β) h_triv_β
  have h_neg_eq : -(γ * π ^ 2) * β = (-γ * β) * π ^ 2 := by ring
  dsimp [localModulusBinaryGaussSum]
  rw [h_neg_eq, h_step_γ, h_step_β, ← h_sub_γ, ← h_sub_β]
  ring

theorem localModulusBinaryGaussSum_eq_resQuadSym_pow_mul {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal)
    (hβ_unit : β ∉ v.asIdeal) :
    haveI := Classical.propDecidable
    localModulusBinaryGaussSum (oddPfisterModulus α β) v α β =
      (((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
        (resQuadSym v β) ^ (valNat v α) else 1 : ℤˣ) : ℤ) : ℂ) *
      ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (valNat v α) : ℂ) *
      localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β :=
by
  let R := NumberField.RingOfIntegers K
  let D := oddPfisterModulus α β
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : (Algebra.norm ℤ (α * β)).natAbs ≠ 0 := by
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat (Algebra.norm ℤ (α * β)).natAbs :=
    Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos (2 * Module.finrank ℚ K + 2)
  haveI : Finite (R ⧸ v.asIdeal) := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  have hq_pos : 0 < (Nat.card (R ⧸ v.asIdeal) : ℝ) := Nat.cast_pos.mpr Nat.card_pos
  have hq_ne : ((Nat.card (R ⧸ v.asIdeal) : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt hq_pos)
  have h_c0 : ∀ (γ : R),
      HasLocalModulusConductor D v γ 0 →
      localModulusBinaryGaussSum D v γ β =
        ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ (2 * valNat v (D : R)) : ℂ) := by
    intro γ h_cond
    let kv := valNat v (D : R)
    let Iv : Ideal R := v.asIdeal ^ kv
    have hIv : Iv ≠ ⊥ := pow_ne_zero kv v.ne_bot
    have h_triv := h_cond.2.1
    have h_sum1 : localModulusTraceGaussSum D v γ =
        ((Nat.card (R ⧸ v.asIdeal)) ^ kv : ℂ) := by
      dsimp [localModulusTraceGaussSum]
      rw [dif_pos hIv]
      haveI : Finite (R ⧸ Iv) := Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
      letI : Fintype (R ⧸ Iv) := Fintype.ofFinite (R ⧸ Iv)
      have h_term : ∀ x ∈ (Finset.univ : Finset (R ⧸ Iv)),
          Complex.exp (2 * Real.pi * Complex.I *
            ((Algebra.trace ℤ R (localModulusIdempotent D v * γ * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
            (D : ℂ)) = 1 := by
        intro x _
        apply h_triv ((Quotient.out x) ^ 2)
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      rw [Finset.sum_congr rfl h_term, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
      have h_card : Fintype.card (R ⧸ Iv) = (Nat.card (R ⧸ v.asIdeal)) ^ kv := by
        rw [← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply,
          map_pow, Ideal.absNorm_apply, Submodule.cardQuot_apply]
      rw [h_card, Nat.cast_pow]
    have h_sum2 : localModulusTraceGaussSum D v (-γ * β) =
        ((Nat.card (R ⧸ v.asIdeal)) ^ kv : ℂ) := by
      dsimp [localModulusTraceGaussSum]
      rw [dif_pos hIv]
      haveI : Finite (R ⧸ Iv) := Ideal.finiteQuotientOfFreeOfNeBot Iv hIv
      letI : Fintype (R ⧸ Iv) := Fintype.ofFinite (R ⧸ Iv)
      have h_term : ∀ x ∈ (Finset.univ : Finset (R ⧸ Iv)),
          Complex.exp (2 * Real.pi * Complex.I *
            ((Algebra.trace ℤ R (localModulusIdempotent D v * (-γ * β) * (Quotient.out x) ^ 2) : ℤ) : ℂ) /
            (D : ℂ)) = 1 := by
        intro x _
        have h_eq : localModulusIdempotent D v * (-γ * β) * (Quotient.out x) ^ 2 =
            localModulusIdempotent D v * γ * (-β * (Quotient.out x) ^ 2) := by ring
        rw [h_eq]
        apply h_triv (-β * (Quotient.out x) ^ 2)
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      rw [Finset.sum_congr rfl h_term, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
      have h_card : Fintype.card (R ⧸ Iv) = (Nat.card (R ⧸ v.asIdeal)) ^ kv := by
        rw [← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply,
          map_pow, Ideal.absNorm_apply, Submodule.cardQuot_apply]
      rw [h_card, Nat.cast_pow]
    dsimp [localModulusBinaryGaussSum]
    rw [h_sum1, h_sum2, pow_mul]
    ring
  have h_eval : ∀ (c : ℕ) (γ : R),
      HasLocalModulusConductor D v γ c →
      localModulusBinaryGaussSum D v γ β =
        (((resQuadSym v β ^ c : ℤˣ) : ℤ) : ℂ) *
        ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ (2 * valNat v (D : R) - c) : ℂ) := by
    intro c
    induction' c using Nat.strong_induction_on with c ih
    intro γ h_cond
    rcases c with _ | _ | c
    · rw [pow_zero, Nat.sub_zero, Units.val_one, Int.cast_one, one_mul]
      exact h_c0 γ h_cond
    · rw [pow_one]
      exact localModulusBinaryGaussSum_of_hasLocalModulusConductor_one D hD_pos v h2v γ β hβ_unit h_cond
    · obtain ⟨γ', h_cond', h_step⟩ :=
        localModulusBinaryGaussSum_step_of_hasLocalModulusConductor_ge_two
          D hD_pos v h2v γ β hβ_unit (c + 2) (by omega) h_cond
      have h_ih := ih c (by omega) γ' h_cond'
      have hc_le : c + 2 ≤ valNat v (D : R) := h_cond.1
      have h_exp : 2 * valNat v (D : R) - c = (2 * valNat v (D : R) - (c + 2)) + 2 := by omega
      have h_unit_sq : resQuadSym v β ^ (c + 2) = resQuadSym v β ^ c := by
        rw [pow_add, Int.units_sq, mul_one]
      have h_rhs :
          ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ 2 : ℂ) * localModulusBinaryGaussSum D v γ β =
          ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ 2 : ℂ) *
            ((((resQuadSym v β ^ (c + 2) : ℤˣ) : ℤ) : ℂ) *
              ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ (2 * valNat v (D : R) - (c + 2)) : ℂ)) := by
        rw [← h_step, h_ih, h_unit_sq, h_exp, pow_add]
        push_cast
        ring
      have hq2_ne : ((Nat.card (R ⧸ v.asIdeal) : ℝ) ^ 2 : ℂ) ≠ 0 := pow_ne_zero 2 hq_ne
      exact mul_left_cancel₀ hq2_ne h_rhs
  obtain ⟨c₀, ha_le, h_cond1, h_condα⟩ :=
    exists_hasLocalModulusConductor_one_and_sub D hD_pos v α hα
      (not_isLocalModulusCharTrivialOnPow_pred_valNat α β hα hβ v h2v)
  have h1 := h_eval c₀ 1 h_cond1
  have h2 := h_eval (c₀ - valNat v α) α h_condα
  have hc0_le : c₀ ≤ valNat v (D : R) := h_cond1.1
  have h_exp_split :
      2 * valNat v (D : R) - (c₀ - valNat v α) =
        valNat v α + (2 * valNat v (D : R) - c₀) := by omega
  have h_unit_split :
      resQuadSym v β ^ (c₀ - valNat v α) =
        resQuadSym v β ^ (valNat v α) * resQuadSym v β ^ c₀ := by
    have h_add : c₀ = (c₀ - valNat v α) + valNat v α := (Nat.sub_add_cancel ha_le).symm
    conv_rhs => rw [h_add, pow_add]
    calc resQuadSym v β ^ (c₀ - valNat v α)
      _ = resQuadSym v β ^ (c₀ - valNat v α) *
            (resQuadSym v β ^ (valNat v α) * resQuadSym v β ^ (valNat v α)) := by
          rw [← sq, Int.units_sq, mul_one]
      _ = resQuadSym v β ^ (valNat v α) *
            (resQuadSym v β ^ (c₀ - valNat v α) * resQuadSym v β ^ (valNat v α)) := by
          ac_rfl
  letI := Classical.propDecidable
  have h_if_eq :
      (if (2 : R) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
        (resQuadSym v β) ^ (valNat v α) else 1 : ℤˣ) =
      (resQuadSym v β) ^ (valNat v α) := by
    by_cases hα_in : α ∈ v.asIdeal
    · exact if_pos ⟨h2v, hα_in⟩
    · rw [if_neg (fun h => hα_in h.2)]
      have h_val1 : v.intValuation α = 1 := v.intValuation_eq_one_iff.mpr hα_in
      have h_val0 : valNat v α = 0 := by
        dsimp [valNat]
        rw [h_val1, WithZero.log_one, neg_zero, Int.toNat_zero]
      rw [h_val0, pow_zero]
  rw [h1, h2, h_if_eq, h_unit_split, h_exp_split, pow_add, Units.val_mul, Int.cast_mul]
  push_cast
  ring

theorem pfisterGaussSign_oddPfisterModulus_eq_oddPowGaussProd_of_all_coprime {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0)
    (h_all_coprime : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ¬ (α ∈ v.asIdeal ∧ β ∈ v.asIdeal)) :
    pfisterGaussSign (oddPfisterModulus α β) α β =
      oddPowGaussProd α β * oddPowGaussProd β α :=
by
  letI := Classical.propDecidable
  have hfin_mem : ∀ (γ : NumberField.RingOfIntegers K), γ ≠ 0 →
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        γ ∈ v.asIdeal}.Finite := by
    intro γ hγ
    have hIγ : (Ideal.span {γ} : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := by
      rw [Ideal.zero_eq_bot, ne_eq, Ideal.span_singleton_eq_bot]
      exact hγ
    refine (Ideal.finite_factors hIγ).subset (fun v hv => ?_)
    rw [Set.mem_setOf_eq, Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact hv
  have h_res₁ : oddPowResQuadProd α β = oddPowGaussProd α β :=
    oddPowResQuadProd_eq_oddPowGaussProd_of_all_coprime α β h_all_coprime
  have h_res₂ : oddPowResQuadProd β α = oddPowGaussProd β α :=
    oddPowResQuadProd_eq_oddPowGaussProd_of_all_coprime β α
      (fun v h => h_all_coprime v ⟨h.2, h.1⟩)
  rw [← h_res₁, ← h_res₂]
  let f_u1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℤˣ :=
    fun v => if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
      (resQuadSym v β) ^ (valNat v α)
    else 1
  let f_u2 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℤˣ :=
    fun v => if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ β ∈ v.asIdeal then
      (resQuadSym v α) ^ (valNat v β)
    else 1
  let f_w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℝ :=
    fun v => if ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal then
      localOddPosWeight v α β
    else 1
  have h_loc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal →
        localModulusPfisterProd (oddPfisterModulus α β) v α β =
          (((f_u1 v * f_u2 v : ℤˣ) : ℤ) : ℂ) * (localOddPosWeight v α β : ℂ) ∧
        0 < localOddPosWeight v α β := by
    intro v hDv
    have h_s1 := localModulusPfisterProd_eq_localModulusBinaryGaussSum α β hα hβ v
    have h2v : (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal := h_s1.2.2.2.2.1 hDv
    dsimp only [localOddPosWeight]
    by_cases hβv : β ∉ v.asIdeal
    · rw [if_pos hβv]
      have h_u2 : f_u2 v = 1 := if_neg (fun h => hβv h.2)
      have h_s3 := localModulusBinaryGaussSum_one_ne_zero α β hα hβ v h2v
      have h_pos : 0 < (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (valNat v α) *
          Complex.normSq (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β) :=
        mul_pos (pow_pos h_s3.2 (valNat v α)) (Complex.normSq_pos.mpr h_s3.1)
      have h_bin := localModulusBinaryGaussSum_eq_resQuadSym_pow_mul α β hα hβ v h2v hβv
      refine ⟨?_, h_pos⟩
      rw [h_u2, mul_one, h_s1.1, h_bin, map_mul, map_mul, map_intCast, map_pow, Complex.conj_ofReal]
      dsimp only [f_u1]
      rw [Complex.ofReal_mul, Complex.ofReal_pow]
      calc localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β *
            ((((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
              resQuadSym v β ^ valNat v α else 1 : ℤˣ) : ℤ) : ℂ) *
              ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v α *
              starRingEnd ℂ (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β))
        _ = (((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
              resQuadSym v β ^ valNat v α else 1 : ℤˣ) : ℤ) : ℂ) *
              (((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v α *
              (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β *
                starRingEnd ℂ (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β))) := by ring
        _ = (((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ α ∈ v.asIdeal then
              resQuadSym v β ^ valNat v α else 1 : ℤˣ) : ℤ) : ℂ) *
              (((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v α *
              (Complex.normSq (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 β) : ℂ)) := by
            rw [Complex.mul_conj]
    · rw [if_neg hβv]
      have hβ_in : β ∈ v.asIdeal := not_not.mp hβv
      have hαv : α ∉ v.asIdeal := fun hα_in => h_all_coprime v ⟨hα_in, hβ_in⟩
      have h_u1 : f_u1 v = 1 := if_neg (fun h => hαv h.2)
      have h_s1_sym := localModulusPfisterProd_eq_localModulusBinaryGaussSum β α hβ hα v
      have h_s3 := localModulusBinaryGaussSum_one_ne_zero β α hβ hα v h2v
      have h_pos : 0 < (Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) ^ (valNat v β) *
          Complex.normSq (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α) := by
        rw [h_s1.2.2.1]
        exact mul_pos (pow_pos h_s3.2 (valNat v β)) (Complex.normSq_pos.mpr h_s3.1)
      have h_bin := localModulusBinaryGaussSum_eq_resQuadSym_pow_mul β α hβ hα v h2v hαv
      refine ⟨?_, h_pos⟩
      rw [h_u1, one_mul, h_s1.2.1, h_s1_sym.1, h_bin, ← h_s1.2.2.1,
        map_mul, map_mul, map_intCast, map_pow, Complex.conj_ofReal]
      dsimp only [f_u2]
      rw [Complex.ofReal_mul, Complex.ofReal_pow]
      calc localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α *
            ((((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ β ∈ v.asIdeal then
              resQuadSym v α ^ valNat v β else 1 : ℤˣ) : ℤ) : ℂ) *
              ((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v β *
              starRingEnd ℂ (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α))
        _ = (((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ β ∈ v.asIdeal then
              resQuadSym v α ^ valNat v β else 1 : ℤˣ) : ℤ) : ℂ) *
              (((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v β *
              (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α *
                starRingEnd ℂ (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α))) := by ring
        _ = (((if (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal ∧ β ∈ v.asIdeal then
              resQuadSym v α ^ valNat v β else 1 : ℤˣ) : ℤ) : ℂ) *
              (((Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal) : ℝ) : ℂ) ^ valNat v β *
              (Complex.normSq (localModulusBinaryGaussSum (oddPfisterModulus α β) v 1 α) : ℂ)) := by
            rw [Complex.mul_conj]
  have hfin_α : (Function.mulSupport f_u1).Finite := by
    refine (hfin_mem α hα).subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg (fun h => hnot h.2))
  have hfin_β : (Function.mulSupport f_u2).Finite := by
    refine (hfin_mem β hβ).subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv
    rw [Set.mem_setOf_eq]
    by_contra hnot
    exact hv (if_neg (fun h => hnot h.2))
  have hfin_u : (Function.mulSupport (fun v => f_u1 v * f_u2 v)).Finite :=
    (hfin_α.union hfin_β).subset (Function.mulSupport_mul f_u1 f_u2)
  let f_uC : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℂ :=
    fun v => (((f_u1 v * f_u2 v : ℤˣ) : ℤ) : ℂ)
  let f_wC : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℂ :=
    fun v => (f_w v : ℂ)
  have h_supp_uC : (Function.mulSupport f_uC).Finite := by
    refine hfin_u.subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv ⊢
    intro h1
    apply hv
    dsimp only [f_uC]
    rw [h1]
    simp
  have hfin_w : (Function.mulSupport f_w).Finite := by
    by_cases hemp : Nonempty (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    · obtain ⟨v₀⟩ := hemp
      have hD_ne := (localModulusPfisterProd_eq_localModulusBinaryGaussSum α β hα hβ v₀).2.2.2.1
      refine (hfin_mem ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) hD_ne).subset
        (fun v hv => ?_)
      rw [Function.mem_mulSupport] at hv
      rw [Set.mem_setOf_eq]
      by_contra hnot
      exact hv (if_neg hnot)
    · haveI : IsEmpty (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
        not_nonempty_iff.mp hemp
      exact Set.toFinite _
  have h_supp_wC : (Function.mulSupport f_wC).Finite := by
    refine hfin_w.subset (fun v hv => ?_)
    rw [Function.mem_mulSupport] at hv ⊢
    intro h1
    apply hv
    dsimp only [f_wC]
    rw [h1]
    simp
  have h_prod_congr :
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        if ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal then
          localModulusPfisterProd (oddPfisterModulus α β) v α β
        else 1) =
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        f_uC v * f_wC v) := by
    refine finprod_congr (fun v => ?_)
    dsimp only [f_uC, f_wC, f_w]
    by_cases hDv : ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos hDv, if_pos hDv]
      exact (h_loc v hDv).1
    · rw [if_neg hDv, if_neg hDv]
      have h_s1 := localModulusPfisterProd_eq_localModulusBinaryGaussSum α β hα hβ v
      have hu1 : f_u1 v = 1 :=
        if_neg (fun h => hDv (h_s1.2.2.2.2.2 h.1 (Or.inl h.2)))
      have hu2 : f_u2 v = 1 :=
        if_neg (fun h => hDv (h_s1.2.2.2.2.2 h.1 (Or.inr h.2)))
      rw [hu1, hu2]
      simp
  let uToC : ℤˣ →* ℂ := (Int.castRingHom ℂ).toMonoidHom.comp (Units.coeHom ℤ)
  let rToC : ℝ →* ℂ := Complex.ofRealHom.toMonoidHom
  have h_map_u : (∏ᶠ v, f_uC v) =
      (((oddPowResQuadProd α β * oddPowResQuadProd β α : ℤˣ) : ℤ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod uToC hfin_u).symm
    have h2 : (∏ᶠ v, f_u1 v * f_u2 v) = oddPowResQuadProd α β * oddPowResQuadProd β α :=
      finprod_mul_distrib hfin_α hfin_β
    change (∏ᶠ i, uToC (f_u1 i * f_u2 i)) = uToC (oddPowResQuadProd α β * oddPowResQuadProd β α)
    rw [h1, h2]
  have h_map_w : (∏ᶠ v, f_wC v) = ((∏ᶠ v, f_w v : ℝ) : ℂ) := by
    have h1 := (MonoidHom.map_finprod rToC hfin_w).symm
    exact h1
  have hW_pos : 0 < (∏ᶠ v, f_w v) := by
    rw [finprod_eq_prod f_w hfin_w]
    refine Finset.prod_pos (fun v _ => ?_)
    dsimp only [f_w]
    by_cases hDv : ((oddPfisterModulus α β : ℕ) : NumberField.RingOfIntegers K) ∈ v.asIdeal
    · rw [if_pos hDv]
      exact (h_loc v hDv).2
    · rw [if_neg hDv]
      exact zero_lt_one
  have h_pf_eq : pfisterGaussSum (oddPfisterModulus α β) α β =
      (((oddPowResQuadProd α β * oddPowResQuadProd β α : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v) := by
    rw [pfisterGaussSum_oddPfisterModulus_eq_re_finprod_local α β hα hβ, h_prod_congr,
      finprod_mul_distrib h_supp_uC h_supp_wC, h_map_u, h_map_w]
    rw [← Complex.ofReal_intCast ((oddPowResQuadProd α β * oddPowResQuadProd β α : ℤˣ) : ℤ),
      ← Complex.ofReal_mul, Complex.ofReal_re]
  dsimp only [pfisterGaussSign]
  rw [h_pf_eq]
  rcases Int.units_eq_one_or (oddPowResQuadProd α β * oddPowResQuadProd β α) with hu | hu
  · rw [hu]
    have hpos : 0 < (((1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v) := by
      simpa using hW_pos
    rw [if_pos hpos]
  · rw [hu]
    have hnotpos : ¬ (0 < (((-1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v)) := by
      have hneg : (((-1 : ℤˣ) : ℤ) : ℝ) * (∏ᶠ v, f_w v) = -(∏ᶠ v, f_w v) := by simp
      rw [hneg]
      linarith
    rw [if_neg hnotpos]

theorem pfisterSignature_eq_sum_traceSignature {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    (pfisterSignature α β : ℤ) =
      traceSignature (1 : NumberField.RingOfIntegers K) +
      traceSignature (-α) +
      traceSignature (-β) +
      traceSignature (α * β) ∧
    4 ∣ pfisterSignature α β :=
by
  letI := Classical.propDecidable
  let R := NumberField.RingOfIntegers K
  have hα_K : algebraMap R K α ≠ 0 :=
    (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hα
  have hβ_K : algebraMap R K β ≠ 0 :=
    (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr hβ
  have h_pt : ∀ w : NumberField.InfinitePlace K,
      ((if w.IsReal then ((1 - realEmbedSign w α) * (1 - realEmbedSign w β)).natAbs else 0 : ℕ) : ℤ) =
        (if w.IsReal then realEmbedSign w (1 : R) else 0) +
        (if w.IsReal then realEmbedSign w (-α) else 0) +
        (if w.IsReal then realEmbedSign w (-β) else 0) +
        (if w.IsReal then realEmbedSign w (α * β) else 0) ∧
      4 ∣ (if w.IsReal then ((1 - realEmbedSign w α) * (1 - realEmbedSign w β)).natAbs else 0) := by
    intro w
    by_cases hw : w.IsReal
    · rw [if_pos hw, if_pos hw, if_pos hw, if_pos hw, if_pos hw]
      let ρ : K →+* ℝ := NumberField.InfinitePlace.embedding_of_isReal hw
      have h_re : ∀ γ : R, (w.embedding (algebraMap R K γ)).re = ρ (algebraMap R K γ) := by
        intro γ
        rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw (algebraMap R K γ),
          Complex.ofReal_re]
      have h_sign : ∀ γ : R,
          realEmbedSign w γ = if ρ (algebraMap R K γ) < 0 then -1 else 1 := by
        intro γ
        unfold realEmbedSign
        rw [h_re γ]
      rw [h_sign α, h_sign β, h_sign 1, h_sign (-α), h_sign (-β), h_sign (α * β)]
      simp only [map_one, map_neg, map_mul]
      set x : ℝ := ρ (algebraMap R K α)
      set y : ℝ := ρ (algebraMap R K β)
      have hx_ne : x ≠ 0 := (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hα_K
      have hy_ne : y ≠ 0 := (map_ne_zero_iff ρ (RingHom.injective ρ)).mpr hβ_K
      have h1_not_neg : ¬ ((1 : ℝ) < 0) := by norm_num
      rw [if_neg h1_not_neg]
      by_cases hx : x < 0 <;> by_cases hy : y < 0
      · have hnx : ¬ (-x < 0) := by linarith
        have hny : ¬ (-y < 0) := by linarith
        have hxy : ¬ (x * y < 0) := not_lt_of_gt (mul_pos_of_neg_of_neg hx hy)
        rw [if_pos hx, if_pos hy, if_neg hnx, if_neg hny, if_neg hxy]
        norm_num
      · have hy_pos : 0 < y := lt_of_le_of_ne (not_lt.mp hy) hy_ne.symm
        have hnx : ¬ (-x < 0) := by linarith
        have hny : -y < 0 := by linarith
        have hxy : x * y < 0 := mul_neg_of_neg_of_pos hx hy_pos
        rw [if_pos hx, if_neg hy, if_neg hnx, if_pos hny, if_pos hxy]
        norm_num
      · have hx_pos : 0 < x := lt_of_le_of_ne (not_lt.mp hx) hx_ne.symm
        have hnx : -x < 0 := by linarith
        have hny : ¬ (-y < 0) := by linarith
        have hxy : x * y < 0 := mul_neg_of_pos_of_neg hx_pos hy
        rw [if_neg hx, if_pos hy, if_pos hnx, if_neg hny, if_pos hxy]
        norm_num
      · have hx_pos : 0 < x := lt_of_le_of_ne (not_lt.mp hx) hx_ne.symm
        have hy_pos : 0 < y := lt_of_le_of_ne (not_lt.mp hy) hy_ne.symm
        have hnx : -x < 0 := by linarith
        have hny : -y < 0 := by linarith
        have hxy : ¬ (x * y < 0) := not_lt_of_gt (mul_pos hx_pos hy_pos)
        rw [if_neg hx, if_neg hy, if_pos hnx, if_pos hny, if_neg hxy]
        norm_num
    · rw [if_neg hw, if_neg hw, if_neg hw, if_neg hw, if_neg hw]
      norm_num
  constructor
  · unfold pfisterSignature traceSignature
    rw [Nat.cast_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun w _ => (h_pt w).1)
  · unfold pfisterSignature
    exact Finset.dvd_sum (fun w _ => (h_pt w).2)

theorem pfisterGaussSum_fullPfisterModulus_eq_mul_pos {K : Type u} [Field K] [NumberField K]
    (α β : NumberField.RingOfIntegers K) (hα : α ≠ 0) (hβ : β ≠ 0) :
    ∃ w : ℝ, 0 < w ∧
      pfisterGaussSum (fullPfisterModulus α β) α β =
        pfisterGaussSum (dyadicGaussModulus K * oddPfisterModulus α β) α β * w :=
by
  let R := NumberField.RingOfIntegers K
  let M : ℕ := dyadicGaussModulus K
  let n : ℕ := (Algebra.norm ℤ (α * β)).natAbs
  let D : ℕ := oddPfisterModulus α β
  let N : ℕ := M * D
  let d_K : ℕ := (NumberField.discr K).natAbs
  let c₀ : ℕ := coprimePartNat d_K N
  let C₀ : ℕ := c₀ ^ (Module.finrank ℚ K + 1)
  let C : ℕ := coprimeDiscrModulus α β
  have hC_sq : C = C₀ ^ 2 := by
    dsimp [C, C₀, c₀, coprimeDiscrModulus, N, M, D]
    have h_exp : 2 * Module.finrank ℚ K + 2 = (Module.finrank ℚ K + 1) * 2 := by ring
    rw [h_exp, pow_mul]
  have h2_norm_eq : (Algebra.norm ℤ (2 : R)).natAbs =
      2 ^ Fintype.card (Module.Free.ChooseBasisIndex ℤ R) := by
    have h_alg : (2 : R) = algebraMap ℤ R (2 : ℤ) := by simp
    have h_norm := Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K) (2 : ℤ)
    rw [← h_alg] at h_norm
    have h_abs := congr_arg Int.natAbs h_norm
    rw [Int.natAbs_pow] at h_abs
    exact h_abs
  have h2_norm_pos : 0 < (Algebra.norm ℤ (2 : R)).natAbs := by
    rw [h2_norm_eq]
    exact pow_pos Nat.zero_lt_two _
  have hM_pos : 0 < M := Nat.mul_pos (Nat.succ_pos 7) (pow_pos h2_norm_pos 2)
  have hab : α * β ≠ 0 := mul_ne_zero hα hβ
  have hI_ab : Ideal.span {α * β} ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hab
  have hn_ne : n ≠ 0 := by
    dsimp [n]
    rw [← Ideal.absNorm_span_singleton (α * β)]
    exact mt Ideal.absNorm_eq_zero_iff.mp hI_ab
  have h_odd_pos : 0 < oddPartNat n := Nat.ordCompl_pos 2 hn_ne
  have hD_pos : 0 < D := pow_pos h_odd_pos _
  have hN_pos : 0 < N := Nat.mul_pos hM_pos hD_pos
  have hd_K : 0 < d_K := Int.natAbs_pos.mpr (NumberField.discr_ne_zero K)
  have hc₀_pos : 0 < c₀ := by
    dsimp [c₀, coprimePartNat]
    exact Nat.div_pos (Nat.le_of_dvd hd_K (Nat.gcd_dvd_left d_K (N ^ d_K)))
      (Nat.gcd_pos_of_pos_left (N ^ d_K) hd_K)
  have hC_pos : 0 < C := pow_pos hc₀_pos _
  have hNC_pos : 0 < N * C := Nat.mul_pos hN_pos hC_pos
  have h_cop_Nc₀ : Nat.Coprime N c₀ := by
    refine Nat.coprime_of_dvd (fun p hp hp_N hp_c₀ => ?_)
    let k : ℕ := d_K.factorization p
    have hk_lt : k < d_K :=
      lt_of_lt_of_le (Nat.lt_pow_self hp.one_lt) (Nat.ordProj_le p (ne_of_gt hd_K))
