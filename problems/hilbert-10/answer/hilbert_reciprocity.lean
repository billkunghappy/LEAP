      have hh_val : valNat v h = n + s := by
        dsimp [h]
        rw [valNat_mul g (π ^ k) hg_ne (pow_ne_zero k hπ_ne), hg_val,
          valNat_pow π k hπ_ne, hπ_valNat, mul_one]
        omega
      have hr_sup : (x₁' ^ 2 - β * y₁' ^ 2) - α * (x₂ ^ 2 - β * y₂ ^ 2) ∈
          Ideal.span {h} ⊔ v.asIdeal ^ (n + s + 1) := by
        have hr_in' : (x₁' ^ 2 - β * y₁' ^ 2) - α * (x₂ ^ 2 - β * y₂ ^ 2) ∈
            v.asIdeal ^ (valNat v h) := hh_val.symm ▸ hr_in
        exact pow_valNat_le_span_sup h (n + s + 1) hh_ne (by omega) hr_in'
      rw [Submodule.mem_sup] at hr_sup
      obtain ⟨u_h, hu_h, r₁, hr₁, hur⟩ := hr_sup
      obtain ⟨t₀, rfl⟩ := Ideal.mem_span_singleton.mp hu_h
      let w₀ : R := -t₀ * π ^ k
      have hw₀_mem : w₀ ∈ v.asIdeal ^ k :=
        (v.asIdeal ^ k).mul_mem_left (-t₀) (Ideal.pow_mem_pow hπ_mem k)
      have hw₀2_mem : w₀ ^ 2 ∈ v.asIdeal ^ (2 * k) := by
        rw [sq, two_mul, pow_add]
        exact Ideal.mul_mem_mul hw₀_mem hw₀_mem
      have h2Q₀w₀_raw : 2 * Q₀ * w₀ ∈ v.asIdeal ^ (e + q₀ + k) := by
        rw [pow_add, pow_add]
        exact Ideal.mul_mem_mul (Ideal.mul_mem_mul h2_mem_e hQ₀_mem) hw₀_mem
      have h2Q₀w₀_in1 : 2 * Q₀ * w₀ ∈ v.asIdeal ^ (μ + 1) :=
        Ideal.pow_le_pow_right (by omega : μ + 1 ≤ e + q₀ + k) h2Q₀w₀_raw
      have h2Q₀w₀_in0 : 2 * Q₀ * w₀ ∈ v.asIdeal ^ μ :=
        Ideal.pow_le_pow_right (Nat.le_succ μ) h2Q₀w₀_in1
      have hg'_id : 2 * (a₀ * (x₁' + a₀ * w₀) - β * b₀ * (y₁' + b₀ * w₀)) =
          g + 2 * Q₀ * w₀ := by
        dsimp [g, Q₀]; ring
      refine ⟨x₁' + a₀ * w₀, y₁' + b₀ * w₀, ?_, ?_, ?_⟩
      · rw [hg'_id]
        exact (v.asIdeal ^ μ).add_mem hg_in h2Q₀w₀_in0
      · rw [hg'_id]
        intro hg'_in1
        apply hg_out
        change g ∈ v.asIdeal ^ (μ + 1)
        have hid : g = (g + 2 * Q₀ * w₀) - 2 * Q₀ * w₀ := by ring
        rw [hid]
        exact (v.asIdeal ^ (μ + 1)).sub_mem hg'_in1 h2Q₀w₀_in1
      · have hQ₀w₀2_raw : Q₀ * w₀ ^ 2 ∈ v.asIdeal ^ (q₀ + 2 * k) := by
          rw [pow_add]
          exact Ideal.mul_mem_mul hQ₀_mem hw₀2_mem
        have hQ₀w₀2_in : Q₀ * w₀ ^ 2 ∈ v.asIdeal ^ (n + s + 1) :=
          Ideal.pow_le_pow_right (by omega : n + s + 1 ≤ q₀ + 2 * k) hQ₀w₀2_raw
        have hr'_id : ((x₁' + a₀ * w₀) ^ 2 - β * (y₁' + b₀ * w₀) ^ 2) -
            α * (x₂ ^ 2 - β * y₂ ^ 2) = r₁ + Q₀ * w₀ ^ 2 := by
          dsimp [g, Q₀, h, w₀] at hur ⊢
          linear_combination -hur
        rw [hr'_id]
        exact (v.asIdeal ^ (n + s + 1)).add_mem hr₁ hQ₀w₀2_in
  have exists_pi_div_mod : ∀ (M : ℕ) (w : R), 1 ≤ M → w ∈ v.asIdeal →
      ∃ w' : R, w - π * w' ∈ v.asIdeal ^ M := by
    intro M w hM hw
    have h_sup : w ∈ Ideal.span {π} ⊔ v.asIdeal ^ M := by
      have hw' : w ∈ v.asIdeal ^ (valNat v π) := by
        rw [hπ_valNat, pow_one]
        exact hw
      exact pow_valNat_le_span_sup π M hπ_ne hM hw'
    rw [Submodule.mem_sup] at h_sup
    obtain ⟨u, hu, r, hr, hur⟩ := h_sup
    obtain ⟨w', rfl⟩ := Ideal.mem_span_singleton.mp hu
    refine ⟨w', ?_⟩
    have hid : w - π * w' = r := by linear_combination -hur
    rw [hid]
    exact hr
  have h_descent : ∀ (k : ℕ) (X Y Z : R),
      Z ∉ v.asIdeal ^ (k + 1) →
      X ^ 2 - β * Y ^ 2 - α * Z ^ 2 ∉ v.asIdeal ^ (2 * e + 1 + 2 * k) := by
    intro k
    induction' k with k ih
    · intro X Y Z hZ h_mem
      rw [pow_one] at hZ
      exact h_no_prim X Y Z (fun h => hZ h.2.2) (by simpa using h_mem)
    · intro X Y Z hZ h_mem
      by_cases h_prim : ¬ (X ∈ v.asIdeal ∧ Y ∈ v.asIdeal ∧ Z ∈ v.asIdeal)
      · exact h_no_prim X Y Z h_prim (Ideal.pow_le_pow_right (by omega) h_mem)
      · push_neg at h_prim
        rcases h_prim with ⟨hX_in, hY_in, hZ_in⟩
        let M : ℕ := 2 * e + 1 + 2 * (k + 1)
        have hM_pos : 1 ≤ M := by omega
        obtain ⟨X', hX'⟩ := exists_pi_div_mod M X hM_pos hX_in
        obtain ⟨Y', hY'⟩ := exists_pi_div_mod M Y hM_pos hY_in
        obtain ⟨Z', hZ'⟩ := exists_pi_div_mod M Z hM_pos hZ_in
        have hZ'_not_mem : Z' ∉ v.asIdeal ^ (k + 1) := by
          intro hZ'_in
          apply hZ
          have hπZ' : π * Z' ∈ v.asIdeal ^ (k + 2) := by
            rw [pow_succ']
            exact Ideal.mul_mem_mul hπ_mem hZ'_in
          have hZ_sub : Z - π * Z' ∈ v.asIdeal ^ (k + 2) :=
            Ideal.pow_le_pow_right (by omega : k + 2 ≤ M) hZ'
          have hid : Z = (Z - π * Z') + π * Z' := by ring
          rw [hid]
          exact (v.asIdeal ^ (k + 2)).add_mem hZ_sub hπZ'
        have hπ2_Q : π ^ 2 * (X' ^ 2 - β * Y' ^ 2 - α * Z' ^ 2) ∈
            v.asIdeal ^ (2 + (2 * e + 1 + 2 * k)) := by
          have hM_eq : 2 + (2 * e + 1 + 2 * k) = M := by omega
          rw [hM_eq]
          have hid : π ^ 2 * (X' ^ 2 - β * Y' ^ 2 - α * Z' ^ 2) =
              (X ^ 2 - β * Y ^ 2 - α * Z ^ 2) -
              (X + π * X') * (X - π * X') +
              β * (Y + π * Y') * (Y - π * Y') +
              α * (Z + π * Z') * (Z - π * Z') := by ring
          rw [hid]
          exact (v.asIdeal ^ M).add_mem
            ((v.asIdeal ^ M).add_mem
              ((v.asIdeal ^ M).sub_mem h_mem ((v.asIdeal ^ M).mul_mem_left (X + π * X') hX'))
              ((v.asIdeal ^ M).mul_mem_left (β * (Y + π * Y')) hY'))
            ((v.asIdeal ^ M).mul_mem_left (α * (Z + π * Z')) hZ')
        have hπ2_ne : π ^ 2 ≠ 0 := pow_ne_zero 2 hπ_ne
        have hπ2_val : valNat v (π ^ 2) = 2 := by
          rw [valNat_pow π 2 hπ_ne, hπ_valNat, mul_one]
        have hQ'_mem : X' ^ 2 - β * Y' ^ 2 - α * Z' ^ 2 ∈ v.asIdeal ^ (2 * e + 1 + 2 * k) :=
          (mul_mem_pow_iff (π ^ 2) (X' ^ 2 - β * Y' ^ 2 - α * Z' ^ 2) 2 (2 * e + 1 + 2 * k)
            hπ2_ne hπ2_val).mp hπ2_Q
        exact ih X' Y' Z' hZ'_not_mem hQ'_mem
  obtain ⟨x₁', y₁', _, _, hr_lift⟩ := h_hensel (2 * l_crit)
  let X : R := x₁' * x₂ - β * y₁' * y₂
  let Y : R := x₁' * y₂ - y₁' * x₂
  let Z : R := x₂ ^ 2 - β * y₂ ^ 2
  have h_bf : X ^ 2 - β * Y ^ 2 - α * Z ^ 2 =
      ((x₁' ^ 2 - β * y₁' ^ 2) - α * (x₂ ^ 2 - β * y₂ ^ 2)) * Z := by
    dsimp [X, Y, Z]
    ring
  have h_mem_n : X ^ 2 - β * Y ^ 2 - α * Z ^ 2 ∈ v.asIdeal ^ (n + 2 * l_crit) := by
    rw [h_bf]
    exact (v.asIdeal ^ (n + 2 * l_crit)).mul_mem_right Z hr_lift
  exact h_descent l_crit X Y Z hZ_not_mem (Ideal.pow_le_pow_right (by omega) h_mem_n)

theorem exists_affine_shift_preserve_or_swap_of_crit_shell {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2v : (2 : NumberField.RingOfIntegers K) ∈ v.asIdeal)
    (α β x₀ : NumberField.RingOfIntegers K) (k₀ : ℕ)
    (hα_unit : α ∉ v.asIdeal) (hβ : β ≠ 0) (hβ_sqfree : valNat v β ≤ 1)
    (hk₀ : k₀ < valNat v (2 : NumberField.RingOfIntegers K))
    (hd₀_ne : x₀ ^ 2 - β ≠ 0)
    (hd₀_val : valNat v (x₀ ^ 2 - β) = 2 * k₀ + 1)
    (hx₀_mem : β ∈ v.asIdeal → x₀ = 0 ∧ k₀ = 0)
    (hx₀_unit : β ∉ v.asIdeal → x₀ ∉ v.asIdeal)
    (h_qdiag : ∀ (u y : NumberField.RingOfIntegers K) (m : ℕ),
      (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ m ↔
        u ^ 2 ∈ v.asIdeal ^ m ∧ (x₀ ^ 2 - β) * y ^ 2 ∈ v.asIdeal ^ m)
    (n l_crit : ℕ) (hn_low : 2 * valNat v (2 : NumberField.RingOfIntegers K) + 1 ≤ n)
    (hl_crit_in : β ∈ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K))
    (hl_crit_out : β ∉ v.asIdeal →
      l_crit = n - 1 - 2 * valNat v (2 : NumberField.RingOfIntegers K) + (2 * k₀ + 1))
    (c δ : NumberField.RingOfIntegers K)
    (hc_mem : c ∈ v.asIdeal ^ l_crit)
    (hc_not_mem : c ∉ v.asIdeal ^ (l_crit + 1))
    (h_disj : ∀ c' : NumberField.RingOfIntegers K, c' - c ∈ v.asIdeal ^ (n - 1) →
      ∀ x₁ y₁ x₂ y₂ : NumberField.RingOfIntegers K,
        ¬ ((x₁ ^ 2 - β * y₁ ^ 2) - c' ∈ v.asIdeal ^ n ∧
           α * (x₂ ^ 2 - β * y₂ ^ 2) - c' ∈ v.asIdeal ^ n))
    (hδ : δ ∈ v.asIdeal ^ (n - 1)) :
    (∃ a₁ b₁ a₂ b₂ : NumberField.RingOfIntegers K,
      (∀ x y : NumberField.RingOfIntegers K,
        (1 * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) ∨
         1 * ((1 * x + a₁) ^ 2 - β * (1 * y + b₁) ^ 2) - c ∈ v.asIdeal ^ (n - 1)) →
        1 * ((1 * x + a₁) ^ 2 - β * (1 * y + b₁) ^ 2) - 1 * (x ^ 2 - β * y ^ 2) - δ ∈ v.asIdeal ^ n) ∧
      (∀ x y : NumberField.RingOfIntegers K,
        (α * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) ∨
         α * ((1 * x + a₂) ^ 2 - β * (1 * y + b₂) ^ 2) - c ∈ v.asIdeal ^ (n - 1)) →
        α * ((1 * x + a₂) ^ 2 - β * (1 * y + b₂) ^ 2) - α * (x ^ 2 - β * y ^ 2) - δ ∈ v.asIdeal ^ n)) ∨
    (∃ r a b : NumberField.RingOfIntegers K,
      r ∉ v.asIdeal ∧
      ∀ x y : NumberField.RingOfIntegers K,
        (α * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) ∨
         1 * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) - c ∈ v.asIdeal ^ (n - 1)) →
        1 * ((r * x + a) ^ 2 - β * (r * y + b) ^ 2) - α * (x ^ 2 - β * y ^ 2) - δ ∈ v.asIdeal ^ n) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let e : ℕ := valNat v (2 : R)
  let d₀ : R := x₀ ^ 2 - β
  have h2_ne : (2 : R) ≠ 0 := two_ne_zero
  have hn_pos : 1 ≤ n := by omega
  have hn_eq : (n - 1) + 1 = n := Nat.sub_add_cancel hn_pos
  have h1_unit : (1 : R) ∉ v.asIdeal :=
    fun h1 => v.isMaximal.ne_top ((Ideal.eq_top_iff_one v.asIdeal).mpr h1)
  have intValuation_eq_exp_neg_valNat :
      ∀ (x : R), x ≠ 0 → v.intValuation x = WithZero.exp (-(valNat v x : ℤ)) := by
    intro x hx
    have hv_ne : v.intValuation x ≠ 0 :=
      v.intValuation_ne_zero' ⟨x, mem_nonZeroDivisors_of_ne_zero hx⟩
    have hv_le : v.intValuation x ≤ 1 := v.intValuation_le_one x
    have hlog_le : WithZero.log (v.intValuation x) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hv_ne, WithZero.exp_zero]
      exact hv_le
    have hval : (valNat v x : ℤ) = -WithZero.log (v.intValuation x) := by
      unfold valNat
      exact Int.toNat_of_nonneg (neg_nonneg.mpr hlog_le)
    rw [hval, neg_neg, WithZero.exp_log hv_ne]
  have mem_pow_iff_le_valNat :
      ∀ (x : R) (m : ℕ), x ≠ 0 → (x ∈ v.asIdeal ^ m ↔ m ≤ valNat v x) := by
    intro x m hx
    rw [← v.intValuation_le_pow_iff_mem x m, intValuation_eq_exp_neg_valNat x hx,
      WithZero.exp_le_exp]
    omega
  have valNat_mul :
      ∀ (x y : R), x ≠ 0 → y ≠ 0 → valNat v (x * y) = valNat v x + valNat v y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h1 := intValuation_eq_exp_neg_valNat (x * y) hxy
    rw [map_mul, intValuation_eq_exp_neg_valNat x hx, intValuation_eq_exp_neg_valNat y hy,
      ← WithZero.exp_add] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have valNat_pow :
      ∀ (x : R) (k : ℕ), x ≠ 0 → valNat v (x ^ k) = k * valNat v x := by
    intro x k hx
    induction' k with k ih
    · have h1 : v.intValuation (1 : R) = WithZero.exp (0 : ℤ) := by simp
      have h2 := intValuation_eq_exp_neg_valNat (1 : R) one_ne_zero
      rw [h1] at h2
      have hinj := WithZero.exp_injective h2
      simp only [pow_zero, zero_mul]
      omega
    · rw [pow_succ', valNat_mul x (x ^ k) hx (pow_ne_zero k hx), ih]
      ring
  have he_pos : 1 ≤ e :=
    (mem_pow_iff_le_valNat (2 : R) 1 h2_ne).mp (by simpa using h2v)
  have h2_mem_e : (2 : R) ∈ v.asIdeal ^ e :=
    (mem_pow_iff_le_valNat (2 : R) e h2_ne).mpr le_rfl
  have hd₀_mem : d₀ ∈ v.asIdeal ^ (2 * k₀ + 1) :=
    (mem_pow_iff_le_valNat d₀ (2 * k₀ + 1) hd₀_ne).mpr (le_of_eq hd₀_val.symm)
  have pow_valNat_le_span_sup :
      ∀ (x : R) (m : ℕ),
        x ≠ 0 → 1 ≤ m → v.asIdeal ^ (valNat v x) ≤ Ideal.span {x} ⊔ v.asIdeal ^ m := by
    intro x m hx hm
    let k : ℕ := valNat v x
    have hx_val : v.intValuation x = WithZero.exp (-(k : ℤ)) :=
      intValuation_eq_exp_neg_valNat x hx
    have hx_dvd : v.asIdeal ^ k ∣ Ideal.span {x} :=
      (v.intValuation_le_pow_iff_dvd x k).mp (le_of_eq hx_val)
    obtain ⟨J, hJ⟩ := hx_dvd
    have hJ_not_le : ¬ (J ≤ v.asIdeal) := by
      intro hle
      have hx_mem : x ∈ v.asIdeal ^ (k + 1) := by
        rw [pow_succ, ← Ideal.span_singleton_le_iff_mem, hJ]
        exact Ideal.mul_mono_right hle
      have hx_le := (mem_pow_iff_le_valNat x (k + 1) hx).mp hx_mem
      omega
    have h_coprime : IsCoprime J (v.asIdeal ^ m) := by
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra h_ne_top
      obtain ⟨𝔪, h𝔪_max, h_le_𝔪⟩ := Ideal.exists_le_maximal (J ⊔ v.asIdeal ^ m) h_ne_top
      have hJ_le_𝔪 : J ≤ 𝔪 := le_trans le_sup_left h_le_𝔪
      have hIm_le_𝔪 : v.asIdeal ^ m ≤ 𝔪 := le_trans le_sup_right h_le_𝔪
      have hv_le_𝔪 : v.asIdeal ≤ 𝔪 := by
        intro z hz
        exact h𝔪_max.isPrime.mem_of_pow_mem m (hIm_le_𝔪 (Ideal.pow_mem_pow hz m))
      have hv_eq_𝔪 : v.asIdeal = 𝔪 := v.isMaximal.eq_of_le h𝔪_max.ne_top hv_le_𝔪
      rw [← hv_eq_𝔪] at hJ_le_𝔪
      exact hJ_not_le hJ_le_𝔪
    obtain ⟨j, hjJ, i, hiIm, hji⟩ := Ideal.isCoprime_iff_exists.mp h_coprime
    intro w hw
    have hw_eq : w = w * j + w * i := by
      calc w = w * 1 := (mul_one w).symm
        _ = w * (j + i) := by rw [hji]
        _ = w * j + w * i := mul_add w j i
    rw [hw_eq]
    refine Submodule.add_mem_sup ?_ ((v.asIdeal ^ m).mul_mem_left w hiIm)
    rw [hJ]
    exact Ideal.mul_mem_mul hw hjJ
  have exists_sq_mod_v : ∀ (γ u₀ : R), γ ∉ v.asIdeal → ∃ t₀ : R, γ * t₀ ^ 2 - u₀ ∈ v.asIdeal := by
    intro γ u₀ hγ
    haveI : Finite (R ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    let f : (R ⧸ v.asIdeal) → (R ⧸ v.asIdeal) :=
      fun t => Ideal.Quotient.mk v.asIdeal γ * t ^ 2
    have hf_inj : Function.Injective f := by
      intro t₁ t₂ h_eq
      let x₁ : R := Quotient.out t₁
      let x₂ : R := Quotient.out t₂
      have h_sub : γ * x₁ ^ 2 - γ * x₂ ^ 2 ∈ v.asIdeal := by
        apply Ideal.Quotient.eq.mp
        rw [map_mul, map_pow, map_mul, map_pow, Ideal.Quotient.mk_out, Ideal.Quotient.mk_out]
        exact h_eq
      have h2_mem : 2 * γ * x₂ * (x₁ - x₂) ∈ v.asIdeal := by
        have hid : 2 * γ * x₂ * (x₁ - x₂) = 2 * (γ * x₂ * (x₁ - x₂)) := by ring
        rw [hid]
        exact v.asIdeal.mul_mem_right (γ * x₂ * (x₁ - x₂)) h2v
      have h_sq_mem : γ * (x₁ - x₂) ^ 2 ∈ v.asIdeal := by
        have hid : γ * (x₁ - x₂) ^ 2 = (γ * x₁ ^ 2 - γ * x₂ ^ 2) - 2 * γ * x₂ * (x₁ - x₂) := by
          ring
        rw [hid]
        exact v.asIdeal.sub_mem h_sub h2_mem
      have h_pow_mem : (x₁ - x₂) ^ 2 ∈ v.asIdeal :=
        (v.isPrime.mem_or_mem h_sq_mem).resolve_left hγ
      have h_diff_mem : x₁ - x₂ ∈ v.asIdeal := v.isPrime.mem_of_pow_mem 2 h_pow_mem
      rw [← Ideal.Quotient.mk_out t₁, ← Ideal.Quotient.mk_out t₂]
      exact Ideal.Quotient.eq.mpr h_diff_mem
    have hf_surj : Function.Surjective f := Finite.surjective_of_injective hf_inj
    obtain ⟨t, ht⟩ := hf_surj (Ideal.Quotient.mk v.asIdeal u₀)
    refine ⟨Quotient.out t, ?_⟩
    apply Ideal.Quotient.eq.mp
    rw [map_mul, map_pow, Ideal.Quotient.mk_out]
    exact ht
  obtain ⟨π, hπ_val⟩ := v.intValuation_exists_uniformizer
  have hπ_ne : π ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hπ_val
    exact WithZero.exp_ne_zero hπ_val.symm
  have hπ_valNat : valNat v π = 1 := by
    have h1 := intValuation_eq_exp_neg_valNat π hπ_ne
    rw [hπ_val] at h1
    have hinj := WithZero.exp_injective h1
    omega
  have hπ_mem : π ∈ v.asIdeal := by
    rw [← pow_one v.asIdeal, mem_pow_iff_le_valNat π 1 hπ_ne, hπ_valNat]
  have mul_mem_pow_iff :
      ∀ (s z : R) (vs k : ℕ), s ≠ 0 → valNat v s = vs →
        (s * z ∈ v.asIdeal ^ (vs + k) ↔ z ∈ v.asIdeal ^ k) := by
    intro s z vs k hs_ne hs_val
    by_cases hz : z = 0
    · subst hz
      simp only [mul_zero, Submodule.zero_mem]
    · have hsz_ne : s * z ≠ 0 := mul_ne_zero hs_ne hz
      rw [mem_pow_iff_le_valNat (s * z) (vs + k) hsz_ne,
        mem_pow_iff_le_valNat z k hz,
        valNat_mul s z hs_ne hz, hs_val]
      omega
  have unit_mul_mem_pow_iff :
      ∀ (s z : R) (k : ℕ), s ∉ v.asIdeal →
        (s * z ∈ v.asIdeal ^ k ↔ z ∈ v.asIdeal ^ k) := by
    intro s z k hs
    have hs_ne : s ≠ 0 := fun h0 => hs (h0 ▸ v.asIdeal.zero_mem)
    have hs_val : valNat v s = 0 := by
      have h_not : ¬ (1 ≤ valNat v s) := by
        rw [← mem_pow_iff_le_valNat s 1 hs_ne, pow_one]
        exact hs
      omega
    simpa using mul_mem_pow_iff s z 0 k hs_ne hs_val
  have sq_mem_pow_iff :
      ∀ (u : R) (m k : ℕ), (m = 2 * k ∨ m + 1 = 2 * k) →
        (u ^ 2 ∈ v.asIdeal ^ m ↔ u ∈ v.asIdeal ^ k) := by
    intro u m k hmk
    by_cases hu : u = 0
    · subst hu
      have h0 : (0 : R) ^ 2 = 0 := by ring
      rw [h0]
      simp only [Submodule.zero_mem]
    · have hu2_ne : u ^ 2 ≠ 0 := pow_ne_zero 2 hu
      rw [mem_pow_iff_le_valNat (u ^ 2) m hu2_ne,
        mem_pow_iff_le_valNat u k hu,
        valNat_pow u 2 hu]
      omega
  have d0_mul_sq_mem_pow_iff :
      ∀ (y : R) (m k : ℕ), (m = 2 * k₀ + 1 + 2 * k ∨ m = 2 * k₀ + 2 * k) →
        (d₀ * y ^ 2 ∈ v.asIdeal ^ m ↔ y ∈ v.asIdeal ^ k) := by
    intro y m k hmk
    by_cases hy : y = 0
    · subst hy
      have h0 : d₀ * (0 : R) ^ 2 = 0 := by ring
      rw [h0]
      simp only [Submodule.zero_mem]
    · have hy2_ne : y ^ 2 ≠ 0 := pow_ne_zero 2 hy
      have hd0y2_ne : d₀ * y ^ 2 ≠ 0 := mul_ne_zero hd₀_ne hy2_ne
      rw [mem_pow_iff_le_valNat (d₀ * y ^ 2) m hd0y2_ne,
        mem_pow_iff_le_valNat y k hy,
        valNat_mul d₀ (y ^ 2) hd₀_ne hy2_ne, hd₀_val, valNat_pow y 2 hy]
      omega
  have mem_of_sq_mem_pow : ∀ (u : R) (k m : ℕ),
      2 * k ≤ m + 1 → u ^ 2 ∈ v.asIdeal ^ m → u ∈ v.asIdeal ^ k := by
    intro u k m hkm hu2
    by_cases hu : u = 0
    · subst hu; exact (v.asIdeal ^ k).zero_mem
    · have hu2_ne : u ^ 2 ≠ 0 := pow_ne_zero 2 hu
      have h_le := (mem_pow_iff_le_valNat (u ^ 2) m hu2_ne).mp hu2
      rw [valNat_pow u 2 hu] at h_le
      exact (mem_pow_iff_le_valNat u k hu).mpr (by omega)
  have mem_of_d0_mul_sq_mem_pow : ∀ (y : R) (k m : ℕ),
      (k = 0 ∨ 2 * k₀ + 2 * k ≤ m) → d₀ * y ^ 2 ∈ v.asIdeal ^ m → y ∈ v.asIdeal ^ k := by
    intro y k m hkm hy2
    rcases hkm with rfl | hkm
    · rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    · by_cases hy : y = 0
      · subst hy; exact (v.asIdeal ^ k).zero_mem
      · have hy2_ne : y ^ 2 ≠ 0 := pow_ne_zero 2 hy
        have hd0y2_ne : d₀ * y ^ 2 ≠ 0 := mul_ne_zero hd₀_ne hy2_ne
        have h_le := (mem_pow_iff_le_valNat (d₀ * y ^ 2) m hd0y2_ne).mp hy2
        rw [valNat_mul d₀ (y ^ 2) hd₀_ne hy2_ne, hd₀_val, valNat_pow y 2 hy] at h_le
        exact (mem_pow_iff_le_valNat y k hy).mpr (by omega)
  have ne_zero_and_valNat_eq_of_mem_and_not_mem :
      ∀ (z : R) (k : ℕ), z ∈ v.asIdeal ^ k → z ∉ v.asIdeal ^ (k + 1) →
        z ≠ 0 ∧ valNat v z = k := by
    intro z k hz_in hz_out
    have hz_ne : z ≠ 0 := fun h0 => hz_out (h0 ▸ (v.asIdeal ^ (k + 1)).zero_mem)
    have h_ge : k ≤ valNat v z := (mem_pow_iff_le_valNat z k hz_ne).mp hz_in
    have h_not_ge : ¬ (k + 1 ≤ valNat v z) := by
      rw [← mem_pow_iff_le_valNat z (k + 1) hz_ne]
      exact hz_out
    exact ⟨hz_ne, by omega⟩
  have two_mul_mem_pow : ∀ (r u y : R) (a b s : ℕ),
      u ∈ v.asIdeal ^ a → y ∈ v.asIdeal ^ b → s ≤ e + a + b →
      2 * r * u * y ∈ v.asIdeal ^ s := by
    intro r u y a b s hu hy hs
    have h2u : 2 * u ∈ v.asIdeal ^ (e + a) := by
      rw [pow_add]
      exact Ideal.mul_mem_mul h2_mem_e hu
    have h2uy : (2 * u) * y ∈ v.asIdeal ^ (e + a + b) := by
      rw [pow_add]
      exact Ideal.mul_mem_mul h2u hy
    have h_le : (2 * u) * y ∈ v.asIdeal ^ s :=
      Ideal.pow_le_pow_right hs h2uy
    have hid : 2 * r * u * y = r * ((2 * u) * y) := by ring
    rw [hid]
    exact (v.asIdeal ^ s).mul_mem_left r h_le
  have hl_bounds : (l_crit = n - 1 - 2 * e ∧ k₀ = 0) ∨
      l_crit = n - 1 - 2 * e + (2 * k₀ + 1) := by
    by_cases hβ_in : β ∈ v.asIdeal
    · exact Or.inl ⟨hl_crit_in hβ_in, (hx₀_mem hβ_in).2⟩
    · exact Or.inr (hl_crit_out hβ_in)
  have hl_le : l_crit + 1 ≤ n - 1 := by omega
  have h_s1 : ∀ (γ : R), γ ∉ v.asIdeal →
      ∃ x y r r' : R, r ∉ v.asIdeal ∧ r ^ 2 - γ ∈ v.asIdeal ∧ r * r' - 1 ∈ v.asIdeal ∧
        γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (n - 1) := by
    intro γ hγ
    obtain ⟨r, hr_sq1⟩ := exists_sq_mod_v 1 γ h1_unit
    have hr_sq : r ^ 2 - γ ∈ v.asIdeal := by simpa using hr_sq1
    have hr_unit : r ∉ v.asIdeal := by
      intro hr_in
      apply hγ
      have hr2_in : r ^ 2 ∈ v.asIdeal := by rw [sq]; exact v.asIdeal.mul_mem_left r hr_in
      have hid : γ = r ^ 2 - (r ^ 2 - γ) := by ring
      rw [hid]
      exact v.asIdeal.sub_mem hr2_in hr_sq
    obtain ⟨r', i₀, hi₀, hyi⟩ := v.isMaximal.exists_inv hr_unit
    have hrr' : r * r' - 1 ∈ v.asIdeal := by
      have hid : r * r' - 1 = -i₀ := by linear_combination hyi
      rw [hid]
      exact v.asIdeal.neg_mem hi₀
    have exists_quad_approx_m : ∀ (δ_r s : R) (m : ℕ),
        δ_r ∈ v.asIdeal ^ m → s ≠ 0 → valNat v s = m →
        ∃ t₀ : R, γ * s * t₀ ^ 2 - δ_r ∈ v.asIdeal ^ (m + 1) := by
      intro δ_r s m hδ_r hs_ne hs_val
      have h_sup : δ_r ∈ Ideal.span {s} ⊔ v.asIdeal ^ (m + 1) := by
        have hδ_r' : δ_r ∈ v.asIdeal ^ (valNat v s) := hs_val.symm ▸ hδ_r
        exact pow_valNat_le_span_sup s (m + 1) hs_ne (by omega) hδ_r'
      rw [Submodule.mem_sup] at h_sup
      obtain ⟨u, hu, r₁, hr₁, hur⟩ := h_sup
      obtain ⟨u₀, rfl⟩ := Ideal.mem_span_singleton.mp hu
      obtain ⟨t₀, ht₀⟩ := exists_sq_mod_v γ u₀ hγ
      refine ⟨t₀, ?_⟩
      have hs_mem : s ∈ v.asIdeal ^ m :=
        (mem_pow_iff_le_valNat s m hs_ne).mpr (le_of_eq hs_val.symm)
      have h_prod : s * (γ * t₀ ^ 2 - u₀) ∈ v.asIdeal ^ (m + 1) := by
        rw [pow_succ]
        exact Ideal.mul_mem_mul hs_mem ht₀
      have hid : γ * s * t₀ ^ 2 - δ_r = s * (γ * t₀ ^ 2 - u₀) - r₁ := by
        linear_combination hur
      rw [hid]
      exact (v.asIdeal ^ (m + 1)).sub_mem h_prod hr₁
    have h_ind : ∀ d : ℕ, d ≤ (n - 1) - l_crit →
        ∃ x y : R, γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ (l_crit + d) := by
      intro d
      induction' d with d ih
      · intro _
        refine ⟨0, 0, ?_⟩
        rw [add_zero]
        have hid : γ * ((0 : R) ^ 2 - β * (0 : R) ^ 2) - c = -c := by ring
        rw [hid]
        exact (v.asIdeal ^ l_crit).neg_mem hc_mem
      · intro hd
        let m_step : ℕ := l_crit + d
        have hm_eq_d : l_crit + (d + 1) = m_step + 1 := by omega
        rw [hm_eq_d]
        obtain ⟨x, y, hxy_m⟩ := ih (by omega)
        change γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ m_step at hxy_m
        let δ_r : R := c - γ * (x ^ 2 - β * y ^ 2)
        have hδ_r_m : δ_r ∈ v.asIdeal ^ m_step := by
          have hid : δ_r = -(γ * (x ^ 2 - β * y ^ 2) - c) := by dsimp [δ_r]; ring
          rw [hid]
          exact (v.asIdeal ^ m_step).neg_mem hxy_m
        let u : R := x - x₀ * y
        have hq_l : (u + x₀ * y) ^ 2 - β * y ^ 2 ∈ v.asIdeal ^ l_crit := by
          have hxy_l : γ * (x ^ 2 - β * y ^ 2) - c ∈ v.asIdeal ^ l_crit :=
            Ideal.pow_le_pow_right (by omega : l_crit ≤ m_step) hxy_m
          have hγq : γ * (x ^ 2 - β * y ^ 2) ∈ v.asIdeal ^ l_crit := by
            have hid : γ * (x ^ 2 - β * y ^ 2) = (γ * (x ^ 2 - β * y ^ 2) - c) + c := by ring
            rw [hid]
            exact (v.asIdeal ^ l_crit).add_mem hxy_l hc_mem
          have hq := (unit_mul_mem_pow_iff γ (x ^ 2 - β * y ^ 2) l_crit hγ).mp hγq
          have hid : (u + x₀ * y) ^ 2 - β * y ^ 2 = x ^ 2 - β * y ^ 2 := by dsimp [u]; ring
          rw [hid]
          exact hq
        obtain ⟨hu2_l, hy2_l⟩ := (h_qdiag u y l_crit).mp hq_l
        let a : ℕ := m_step / 2
        have hm_cases : m_step = 2 * a ∨ m_step = 2 * a + 1 := by omega
        rcases hm_cases with hm_even | hm_odd
        · let s : R := (π ^ a) ^ 2
          have hs_ne : s ≠ 0 := pow_ne_zero 2 (pow_ne_zero a hπ_ne)
          have hs_val : valNat v s = m_step := by
            dsimp [s]
            rw [valNat_pow (π ^ a) 2 (pow_ne_zero a hπ_ne), valNat_pow π a hπ_ne, hπ_valNat, mul_one,
              ← hm_even]
          obtain ⟨t₀, ht₀⟩ := exists_quad_approx_m δ_r s m_step hδ_r_m hs_ne hs_val
          let Δu : R := t₀ * π ^ a
          have hΔu_mem : Δu ∈ v.asIdeal ^ a :=
            (v.asIdeal ^ a).mul_mem_left t₀ (Ideal.pow_mem_pow hπ_mem a)
          have hΔu2_sub : γ * Δu ^ 2 - δ_r ∈ v.asIdeal ^ (m_step + 1) := by
            have hid : γ * Δu ^ 2 - δ_r = γ * s * t₀ ^ 2 - δ_r := by dsimp [Δu, s]; ring
            rw [hid]
            exact ht₀
          have hu_mem : u ∈ v.asIdeal ^ (a + 1 - e) :=
            mem_of_sq_mem_pow u (a + 1 - e) l_crit (by omega) hu2_l
          have hx0y_mem : x₀ * y ∈ v.asIdeal ^ (a + 1 - e) := by
            by_cases hβ_in : β ∈ v.asIdeal
            · rw [(hx₀_mem hβ_in).1, zero_mul]
              exact (v.asIdeal ^ (a + 1 - e)).zero_mem
            · have h_bound : a + 1 - e = 0 ∨ 2 * k₀ + 2 * (a + 1 - e) ≤ l_crit := by
                have := hl_crit_out hβ_in
                omega
              have hy_mem := mem_of_d0_mul_sq_mem_pow y (a + 1 - e) l_crit h_bound hy2_l
              exact (v.asIdeal ^ (a + 1 - e)).mul_mem_left x₀ hy_mem
          have hx_mem : x ∈ v.asIdeal ^ (a + 1 - e) := by
            have hid : x = u + x₀ * y := by dsimp [u]; ring
            rw [hid]
            exact (v.asIdeal ^ (a + 1 - e)).add_mem hu_mem hx0y_mem
          have h2x_mem : 2 * γ * x * Δu ∈ v.asIdeal ^ (m_step + 1) :=
            two_mul_mem_pow γ x Δu (a + 1 - e) a (m_step + 1) hx_mem hΔu_mem (by omega)
          refine ⟨x + Δu, y, ?_⟩
          have hid : γ * ((x + Δu) ^ 2 - β * y ^ 2) - c =
              (γ * Δu ^ 2 - δ_r) + 2 * γ * x * Δu := by dsimp [δ_r]; ring
          rw [hid]
          exact (v.asIdeal ^ (m_step + 1)).add_mem hΔu2_sub h2x_mem
        · let s : R := d₀ * (π ^ (a - k₀)) ^ 2
          have hs_ne : s ≠ 0 := mul_ne_zero hd₀_ne (pow_ne_zero 2 (pow_ne_zero (a - k₀) hπ_ne))
          have hs_val : valNat v s = m_step := by
            dsimp [s]
            rw [valNat_mul d₀ ((π ^ (a - k₀)) ^ 2) hd₀_ne (pow_ne_zero 2 (pow_ne_zero (a - k₀) hπ_ne)),
              hd₀_val, valNat_pow (π ^ (a - k₀)) 2 (pow_ne_zero (a - k₀) hπ_ne),
              valNat_pow π (a - k₀) hπ_ne, hπ_valNat, mul_one]
            omega
          obtain ⟨t₀, ht₀⟩ := exists_quad_approx_m δ_r s m_step hδ_r_m hs_ne hs_val
          let Δy : R := t₀ * π ^ (a - k₀)
          have hΔy_mem : Δy ∈ v.asIdeal ^ (a - k₀) :=
            (v.asIdeal ^ (a - k₀)).mul_mem_left t₀ (Ideal.pow_mem_pow hπ_mem (a - k₀))
          have hΔy2_sub : γ * d₀ * Δy ^ 2 - δ_r ∈ v.asIdeal ^ (m_step + 1) := by
            have hid : γ * d₀ * Δy ^ 2 - δ_r = γ * s * t₀ ^ 2 - δ_r := by dsimp [Δy, s]; ring
            rw [hid]
            exact ht₀
          have hy_mem : y ∈ v.asIdeal ^ (a + 1 - e) :=
            mem_of_d0_mul_sq_mem_pow y (a + 1 - e) l_crit (by omega) hy2_l
          have hd0y_mem : d₀ * y ∈ v.asIdeal ^ (a + 2 - e + k₀) := by
            have hd0y_raw : d₀ * y ∈ v.asIdeal ^ ((2 * k₀ + 1) + (a + 1 - e)) := by
              rw [pow_add]
              exact Ideal.mul_mem_mul hd₀_mem hy_mem
            exact Ideal.pow_le_pow_right (by omega) hd0y_raw
          have hx0u_mem : x₀ * u ∈ v.asIdeal ^ (a + 2 - e + k₀) := by
            by_cases hβ_in : β ∈ v.asIdeal
            · rw [(hx₀_mem hβ_in).1, zero_mul]
              exact (v.asIdeal ^ (a + 2 - e + k₀)).zero_mem
            · have h_bound : 2 * (a + 2 - e + k₀) ≤ l_crit + 1 := by
                have := hl_crit_out hβ_in
                omega
              have hu_mem := mem_of_sq_mem_pow u (a + 2 - e + k₀) l_crit h_bound hu2_l
              exact (v.asIdeal ^ (a + 2 - e + k₀)).mul_mem_left x₀ hu_mem
          have hw_mem : x₀ * u + d₀ * y ∈ v.asIdeal ^ (a + 2 - e + k₀) :=
            (v.asIdeal ^ (a + 2 - e + k₀)).add_mem hx0u_mem hd0y_mem
          have h2w_mem : 2 * γ * (x₀ * u + d₀ * y) * Δy ∈ v.asIdeal ^ (m_step + 1) :=
            two_mul_mem_pow γ (x₀ * u + d₀ * y) Δy (a + 2 - e + k₀) (a - k₀) (m_step + 1)
              hw_mem hΔy_mem (by omega)
          refine ⟨x + x₀ * Δy, y + Δy, ?_⟩
          have hid : γ * ((x + x₀ * Δy) ^ 2 - β * (y + Δy) ^ 2) - c =
              (γ * d₀ * Δy ^ 2 - δ_r) + 2 * γ * (x₀ * u + d₀ * y) * Δy := by
            dsimp [u, d₀, δ_r]; ring
          rw [hid]
          exact (v.asIdeal ^ (m_step + 1)).add_mem hΔy2_sub h2w_mem
    obtain ⟨x, y, hxy⟩ := h_ind ((n - 1) - l_crit) le_rfl
    have hn1_eq : l_crit + ((n - 1) - l_crit) = n - 1 := by omega
    rw [hn1_eq] at hxy
    exact ⟨x, y, r, r', hr_unit, hr_sq, hrr', hxy⟩
  let m : ℕ := (n - 1) / 2
  have h_base_shell : ∀ (γ x_b y_b : R),
      γ ∉ v.asIdeal →
      γ * (x_b ^ 2 - β * y_b ^ 2) - c ∈ v.asIdeal ^ (n - 1) →
      x_b ^ 2 - β * y_b ^ 2 ∈ v.asIdeal ^ l_crit ∧
      x_b ^ 2 - β * y_b ^ 2 ∉ v.asIdeal ^ (l_crit + 1) ∧
      x_b ∈ v.asIdeal ^ (n / 2 - e) ∧
      x₀ * x_b - β * y_b ∈ v.asIdeal ^ ((n + 1) / 2 - e + k₀) := by
    intro γ x_b y_b hγ hxb_mem
    have h_l : γ * (x_b ^ 2 - β * y_b ^ 2) - c ∈ v.asIdeal ^ l_crit :=
      Ideal.pow_le_pow_right (by omega : l_crit ≤ n - 1) hxb_mem
    have h_l1 : γ * (x_b ^ 2 - β * y_b ^ 2) - c ∈ v.asIdeal ^ (l_crit + 1) :=
      Ideal.pow_le_pow_right hl_le hxb_mem
    have hq_l : x_b ^ 2 - β * y_b ^ 2 ∈ v.asIdeal ^ l_crit := by
      have hγq : γ * (x_b ^ 2 - β * y_b ^ 2) ∈ v.asIdeal ^ l_crit := by
        have hid : γ * (x_b ^ 2 - β * y_b ^ 2) =
            (γ * (x_b ^ 2 - β * y_b ^ 2) - c) + c := by ring
        rw [hid]
        exact (v.asIdeal ^ l_crit).add_mem h_l hc_mem
      exact (unit_mul_mem_pow_iff γ (x_b ^ 2 - β * y_b ^ 2) l_crit hγ).mp hγq
    have hq_not_l1 : x_b ^ 2 - β * y_b ^ 2 ∉ v.asIdeal ^ (l_crit + 1) := by
      intro h_in
      apply hc_not_mem
      have hγq : γ * (x_b ^ 2 - β * y_b ^ 2) ∈ v.asIdeal ^ (l_crit + 1) :=
        (v.asIdeal ^ (l_crit + 1)).mul_mem_left γ h_in
      have hid : c = γ * (x_b ^ 2 - β * y_b ^ 2) -
          (γ * (x_b ^ 2 - β * y_b ^ 2) - c) := by ring
      rw [hid]
      exact (v.asIdeal ^ (l_crit + 1)).sub_mem hγq h_l1
    let u_b : R := x_b - x₀ * y_b
    have hq_ub : (u_b + x₀ * y_b) ^ 2 - β * y_b ^ 2 ∈ v.asIdeal ^ l_crit := by
      have hid : (u_b + x₀ * y_b) ^ 2 - β * y_b ^ 2 = x_b ^ 2 - β * y_b ^ 2 := by
        dsimp [u_b]; ring
      rw [hid]
      exact hq_l
    obtain ⟨hu_b2_l, hy_b2_l⟩ := (h_qdiag u_b y_b l_crit).mp hq_ub
    have hx_b_mem : x_b ∈ v.asIdeal ^ (n / 2 - e) := by
      have hu_b : u_b ∈ v.asIdeal ^ (n / 2 - e) :=
        mem_of_sq_mem_pow u_b (n / 2 - e) l_crit (by omega) hu_b2_l
      have hx0y_b : x₀ * y_b ∈ v.asIdeal ^ (n / 2 - e) := by
        by_cases hβ_in : β ∈ v.asIdeal
        · rw [(hx₀_mem hβ_in).1, zero_mul]
          exact (v.asIdeal ^ (n / 2 - e)).zero_mem
        · have h_bound : n / 2 - e = 0 ∨ 2 * k₀ + 2 * (n / 2 - e) ≤ l_crit := by
            have := hl_crit_out hβ_in
            omega
          have hy_b := mem_of_d0_mul_sq_mem_pow y_b (n / 2 - e) l_crit h_bound hy_b2_l
          exact (v.asIdeal ^ (n / 2 - e)).mul_mem_left x₀ hy_b
      have hid : x_b = u_b + x₀ * y_b := by dsimp [u_b]; ring
      rw [hid]
      exact (v.asIdeal ^ (n / 2 - e)).add_mem hu_b hx0y_b
    have hw_b_mem : x₀ * x_b - β * y_b ∈ v.asIdeal ^ ((n + 1) / 2 - e + k₀) := by
      have hy_b : y_b ∈ v.asIdeal ^ (m - e) :=
        mem_of_d0_mul_sq_mem_pow y_b (m - e) l_crit (by omega) hy_b2_l
      have hd0y_b : d₀ * y_b ∈ v.asIdeal ^ ((n + 1) / 2 - e + k₀) := by
        have h_raw : d₀ * y_b ∈ v.asIdeal ^ ((2 * k₀ + 1) + (m - e)) := by
          rw [pow_add]
          exact Ideal.mul_mem_mul hd₀_mem hy_b
        exact Ideal.pow_le_pow_right (by omega) h_raw
      have hx0u_b : x₀ * u_b ∈ v.asIdeal ^ ((n + 1) / 2 - e + k₀) := by
        by_cases hβ_in : β ∈ v.asIdeal
        · rw [(hx₀_mem hβ_in).1, zero_mul]
          exact (v.asIdeal ^ ((n + 1) / 2 - e + k₀)).zero_mem
        · have h_bound : 2 * ((n + 1) / 2 - e + k₀) ≤ l_crit + 1 := by
            have := hl_crit_out hβ_in
            omega
          have hu_b := mem_of_sq_mem_pow u_b ((n + 1) / 2 - e + k₀) l_crit h_bound hu_b2_l
          exact (v.asIdeal ^ ((n + 1) / 2 - e + k₀)).mul_mem_left x₀ hu_b
      have hid : x₀ * x_b - β * y_b = x₀ * u_b + d₀ * y_b := by dsimp [u_b, d₀]; ring
      rw [hid]
      exact (v.asIdeal ^ ((n + 1) / 2 - e + k₀)).add_mem hx0u_b hd0y_b
    exact ⟨hq_l, hq_not_l1, hx_b_mem, hw_b_mem⟩
  have h_diff_qdiag : ∀ (γ x_b y_b : R),
      γ ∉ v.asIdeal →
      γ * (x_b ^ 2 - β * y_b ^ 2) - c ∈ v.asIdeal ^ (n - 1) →
      ∀ (s : ℕ), s ≤ n - 1 → ∀ (x y : R),
        (x ^ 2 - β * y ^ 2) - (x_b ^ 2 - β * y_b ^ 2) ∈ v.asIdeal ^ s ↔
          ((x - x_b) - x₀ * (y - y_b)) ^ 2 ∈ v.asIdeal ^ s ∧
          d₀ * (y - y_b) ^ 2 ∈ v.asIdeal ^ s := by
    intro γ x_b y_b hγ hxb_mem s hs x y
    obtain ⟨_, _, hx_b_mem, hw_b_mem⟩ := h_base_shell γ x_b y_b hγ hxb_mem
    let δu : R := (x - x_b) - x₀ * (y - y_b)
    let δy : R := y - y_b
    let w_b : R := x₀ * x_b - β * y_b
    have h_lin_mem : ∀ (k t : ℕ),
        δu ^ 2 ∈ v.asIdeal ^ k → d₀ * δy ^ 2 ∈ v.asIdeal ^ k →
        t ≤ e + (n / 2 - e) + (k + 1) / 2 →
        t ≤ e + ((n + 1) / 2 - e + k₀) + (k - 2 * k₀) / 2 →
