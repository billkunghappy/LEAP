            (((∑ w : NumberField.InfinitePlace K,
                β w * Real.log (w (xpm.1.1 : K) / w₀ (xpm.1.1 : K))) : ℝ) * Complex.I) *
          ((χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 *
            ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
              Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)) := by
        dsimp only [F_cond]
        rw [hχ₀_unit xpm.1.1 hx_ne xpm.2.2.2.2.2, h_χ₀_pow]
        ring
      _ = G (e_sub xpm).1 := by
        dsimp only [G, e_sub]
        rw [h_tors_sum xpm.1.1]
        rfl
  have h_supp : Function.support G ⊆ s_unit := by
    intro xpm hxpm
    have hG_ne : G xpm ≠ 0 := Function.mem_support.mp hxpm
    change IsUnit (Ideal.Quotient.mk q xpm.1.1)
    by_contra h_not_unit
    have h_span_ne : Ideal.span ({xpm.1.1} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      xpm.2.2.1.symm ▸ pow_ne_zero xpm.1.2.2 xpm.1.2.1.ne_bot
    have hx_ne : xpm.1.1 ≠ 0 := Ideal.span_singleton_eq_bot.not.mp h_span_ne
    have h_ideal_eq :
        (⟨Ideal.span ({xpm.1.1} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ :
            nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) =
        ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩ ^ xpm.1.2.2 := by
      apply Subtype.ext
