      (∫ u in Set.Ioo (0 : ℝ) 1, (u : ℂ) ^ s * (Ψ_K u : ℂ)) +
        (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ_K u : ℂ)) :=
    h_mellin s hs
  have h2 : (∫ u in Set.Ioo (0 : ℝ) 1, (u : ℂ) ^ s * (Ψ_K u : ℂ)) =
      ∫ u in Set.Ioi (1 : ℝ),
        ((u : ℂ) ^ (1 - s) * (Ψ_K u : ℂ) +
          (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s))) :=
    mitsui_mellin_Ioo_zero_one_eq_Ioi_one_of_theta_inversion R_K Ψ_K hΨ_inv s
  have h3 : s * (s - 1) *
      ((∫ u in Set.Ioi (1 : ℝ),
          ((u : ℂ) ^ (1 - s) * (Ψ_K u : ℂ) +
            (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)))) +
        (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ_K u : ℂ))) =
      (R_K : ℂ) +
        s * (s - 1) *
          ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ) :=
    mitsui_hecke_folded_mellin_polar_integral_identity R_K Ψ_K hΨ_nn hΨ_int s hs
  calc s * γ_s * ((s - 1) * NumberField.dedekindZeta K s)
      = s * (s - 1) * (γ_s * NumberField.dedekindZeta K s) := by ring
    _ = s * (s - 1) *
          ((∫ u in Set.Ioo (0 : ℝ) 1, (u : ℂ) ^ s * (Ψ_K u : ℂ)) +
