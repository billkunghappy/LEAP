    have h_card_pos : 1 ≤ Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) :=
      Fintype.card_pos
    have h_norm : Ideal.absNorm I₂ =
        2 ^ Fintype.card (Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)) := by
      dsimp [I₂]
      rw [Ideal.absNorm_span_singleton]
      have h2_map : (2 : NumberField.RingOfIntegers K) =
          algebraMap ℤ (NumberField.RingOfIntegers K) (2 : ℤ) := by
        simp
      rw [h2_map, Algebra.norm_algebraMap_of_basis b_K (2 : ℤ), Int.natAbs_pow]
