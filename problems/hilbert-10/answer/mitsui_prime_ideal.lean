      Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le m (by norm_num : (0 : ℝ) < 3 / 2)
        hH_diff.diffContOnCl hH_sphere
    have h_div_eq : (m.factorial : ℝ) * M / (3 / 2 : ℝ) ^ m = (m.factorial : ℝ) * (M * (2 / 3 : ℝ) ^ m) := by
      rw [div_eq_mul_inv, ← inv_pow, show (3 / 2 : ℝ)⁻¹ = 2 / 3 by norm_num, mul_assoc]
    rw [h_div_eq] at h_cauchy
    have h_norm_taylor : ‖(b m : ℂ) - ρ‖ = (m.factorial : ℝ)⁻¹ * ‖iteratedDeriv m H 2‖ := by
      rw [← hH_taylor m, norm_mul, norm_mul, norm_inv, Complex.norm_natCast,
        norm_pow, norm_neg, norm_one, one_pow, mul_one]
    have hfact_pos : (0 : ℝ) < (m.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos m)
