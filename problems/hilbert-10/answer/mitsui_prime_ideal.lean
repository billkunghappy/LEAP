      intro a
      have h_exp : e_K ((β a : K) * ((x * y : R) : K) / (γ₀ : K)) =
          e_K ((β (a * u) : K) * (y : K) / (γ₀ : K)) := by
        have h1 : (β a : K) * ((x * y : R) : K) = ((β a * (x * y) : R) : K) := by push_cast; rfl
        have h2 : (β (a * u) : K) * (y : K) = ((β (a * u) * y : R) : K) := by push_cast; rfl
        rw [h1, h2]
        refine he_B₀_congr (β a * (x * y)) (β (a * u) * y) ?_ ?_
        · exact sub_mem (Ideal.mul_mem_right _ (B₀ : Ideal R) (hβ a).1)
            (Ideal.mul_mem_right _ (B₀ : Ideal R) (hβ (a * u)).1)
        · rw [map_mul, map_mul, map_mul, (hβ a).2, (hβ (a * u)).2]
