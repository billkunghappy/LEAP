          refine Finset.sum_congr rfl (fun w _ => Finset.sum_congr rfl (fun j _ => by ring))
      _ = ∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K) / w₀ (x : K)) := by
          refine Finset.sum_congr rfl (fun w _ => by rw [← hy w])
      _ = (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) -
            (∑ w : NumberField.InfinitePlace K, v_place w) * Real.log (w₀ (x : K)) := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          have hwx_ne : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK_ne)
          rw [Real.log_div hwx_ne hw₀x_ne, mul_sub]
      _ = ∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K)) := by
          rw [hv_sum, zero_mul, sub_zero]
  have h_lhs_eq : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0) (y : Fin r → ℝ),
      (∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) =
          ∑ j : Fin r,
            y j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
      ∀ z₀ : ℂ,
        z₀ * (((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
          Complex.exp (((∑ j : Fin r, y j * Ω₀ j) : ℝ) * Complex.I)) ^ 2) =
        (z₀ * Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)) *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀) ^ 2 := by
    intro x hx_ne y hy z₀
    have h_exp_sq : (Complex.exp (((∑ j : Fin r, y j * Ω₀ j) : ℝ) * Complex.I)) ^ 2 =
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) := by
      rw [sq, ← Complex.exp_add, ← h_lin x hx_ne y hy]
      congr 1
      push_cast
      ring
    rw [mul_pow, h_exp_sq]
    ring
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
    fun x w => Real.log (w (x : K)) -
      (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (x : K))) / (n : ℝ)
  let L_vec : NumberField.RingOfIntegers K → NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun x w => (w.1.mult : ℝ) * ℓ x w.1
  let W₀ : NumberField.RingOfIntegers K → Fin r → ℝ :=
    fun x j => B_R.repr (L_vec x) j
  have hW₀_log : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) =
          ∑ j : Fin r,
            W₀ x j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
    intro x hx w
    let r_x : NumberField.InfinitePlace K → ℝ :=
      fun v => ∑ j : Fin r, W₀ x j *
        Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))
    let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v hv
      let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
      have h_basis := congr_fun (Module.Basis.sum_repr B_R (L_vec x)).symm v_sub
      change (v.mult : ℝ) * ℓ x v = (∑ j : Fin r, (W₀ x j) • B_R j) v_sub at h_basis
      rw [h_basis]
      have h_eval : (∑ j : Fin r, (W₀ x j) • B_R j) v_sub =
          ∑ j : Fin r, W₀ x j * (B_R j v_sub) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      dsimp [r_x]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hB_j : B_R j v_sub =
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hB_j]
      ring
    have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ x v) = 0 := by
      dsimp [ℓ]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
    have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_x v) = 0 := by
      dsimp [r_x]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h_comm : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (W₀ x j *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
          W₀ x j * (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_comm]
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, mul_zero]
    have h_all_mult : ∀ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v
      by_cases hv : v = w_dir
      · subst hv
        have h1 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ x v) (Finset.mem_univ w_dir)).symm
        have h2 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_x v) (Finset.mem_univ w_dir)).symm
        have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ x v) =
            (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_x v) :=
          Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
        linarith
      · exact h_ne_dir v hv
    have h_all : ∀ v : NumberField.InfinitePlace K, ℓ x v = r_x v := by
      intro v
      have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
      exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
    have hw₀x : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK)
    calc Real.log (w (x : K) / w₀ (x : K))
      _ = Real.log (w (x : K)) - Real.log (w₀ (x : K)) := Real.log_div hwx hw₀x
      _ = ℓ x w - ℓ x w₀ := by dsimp [ℓ]; ring
      _ = r_x w - r_x w₀ := by rw [h_all w, h_all w₀]
      _ = ∑ j : Fin r, W₀ x j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [r_x]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
        have hη_ne : η_j ≠ 0 :=
          NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
        have hwη : w η_j ≠ 0 := ne_of_gt (w.pos_iff.mpr hη_ne)
        have hw₀η : w₀ η_j ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hη_ne)
        rw [← mul_sub, ← Real.log_div hwη hw₀η]
  refine ⟨?_, ?_⟩
  · intro x hx_ne hx_mem
    obtain ⟨y, hy, h_eq⟩ := hχ₀_prin x hx_ne hx_mem
    rw [← h_lhs_eq x hx_ne y hy]
    exact h_eq
  · intro f' hff' hf'ne
    obtain ⟨x, hx_ne, h_cop, hx_mem, h_ne⟩ := hχ₀_prim f' hff' hf'ne
    refine ⟨x, hx_ne, h_cop, hx_mem, ?_⟩
    rw [← h_lhs_eq x hx_ne (W₀ x) (hW₀_log x hx_ne)]
    exact h_ne (W₀ x) (hW₀_log x hx_ne)

theorem mitsui_exists_complex_eff_ang_of_sq_grossenchar_params {K : Type u} [Field K] [NumberField K]
    (w₀ : NumberField.InfinitePlace K)
    (a₀ : ℕ) (ha₀_lt : a₀ < NumberField.Units.torsionOrder K)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (M : ℝ) (hM : 1 ≤ M)
    (hl_M : ∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) :
    ∃ l_eff : NumberField.InfinitePlace K → ℤ,
      (∀ w : NumberField.InfinitePlace K, w.IsReal → l_eff w = 0) ∧
      (∀ w : NumberField.InfinitePlace K, w.IsComplex →
        ((l_eff w).natAbs : ℝ) ≤ (2 + 2 * (NumberField.Units.torsionOrder K : ℝ)) * Real.exp M) ∧
      (∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ z : ℂ,
          (z * ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀) ^ 2 =
            (∏ w : NumberField.InfinitePlace K,
              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ^ 2 ↔
          z = ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w))) :=
by
  classical
  let l_eff : NumberField.InfinitePlace K → ℤ := fun w =>
    if w.IsReal then 0 else 2 * l_ang w - (if w = w₀ then 2 * (a₀ : ℤ) else 0)
  refine ⟨l_eff, ?_, ?_, ?_⟩
  · intro w hw
    dsimp [l_eff]
    rw [if_pos hw]
  · intro w hw
    have hnot_real : ¬ w.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hw
    have hl_eq : l_eff w = 2 * l_ang w - (if w = w₀ then 2 * (a₀ : ℤ) else 0) := by
      dsimp [l_eff]
      rw [if_neg hnot_real]
    have h_abs : ((l_eff w).natAbs : ℝ) = |(l_eff w : ℝ)| := by
      exact_mod_cast Nat.cast_natAbs (l_eff w)
    rw [h_abs, hl_eq]
    push_cast
    have hexp_ge_one : 1 ≤ Real.exp M := Real.one_le_exp (by linarith)
    have ha₀_le : (a₀ : ℝ) ≤ (NumberField.Units.torsionOrder K : ℝ) :=
      le_of_lt (by exact_mod_cast ha₀_lt)
    have hl_w : |(l_ang w : ℝ)| ≤ Real.exp M := hl_M w
    have h_ite_abs : |(if w = w₀ then (2 : ℝ) * (a₀ : ℝ) else 0)| ≤
        2 * (NumberField.Units.torsionOrder K : ℝ) * Real.exp M := by
      split_ifs
      · have ha₀_nn : (0 : ℝ) ≤ 2 * (a₀ : ℝ) := by positivity
        rw [abs_of_nonneg ha₀_nn]
        calc 2 * (a₀ : ℝ)
          _ ≤ 2 * (NumberField.Units.torsionOrder K : ℝ) := by linarith
          _ = 2 * (NumberField.Units.torsionOrder K : ℝ) * 1 := by ring
          _ ≤ 2 * (NumberField.Units.torsionOrder K : ℝ) * Real.exp M := by
              exact mul_le_mul_of_nonneg_left hexp_ge_one (by positivity)
      · rw [abs_zero]
        positivity
    have h_tri := abs_sub (2 * (l_ang w : ℝ)) (if w = w₀ then 2 * (a₀ : ℝ) else 0)
    have h_abs_two : |2 * (l_ang w : ℝ)| = 2 * |(l_ang w : ℝ)| := by
      rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    linarith
  · intro x hx_ne z
    let u_w : NumberField.InfinitePlace K → ℂ := fun w => w.embedding (x : K) / (w (x : K) : ℂ)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hu_ne : ∀ w : NumberField.InfinitePlace K, u_w w ≠ 0 := by
      intro w
      dsimp [u_w]
      have hw_ne : (w (x : K) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (w.pos_iff.mpr hxK))
      have hemb_ne : w.embedding (x : K) ≠ 0 := map_ne_zero_iff _ (RingHom.injective _) |>.mpr hxK
      exact div_ne_zero hemb_ne hw_ne
    have hu_real_sq : ∀ w : NumberField.InfinitePlace K, w.IsReal → (u_w w) ^ 2 = 1 := by
      intro w hw
      dsimp [u_w]
      have h_emb : w.embedding (x : K) = ((NumberField.InfinitePlace.embedding_of_isReal hw (x : K) : ℝ) : ℂ) :=
        (NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)).symm
      have h_norm : w (x : K) = |NumberField.InfinitePlace.embedding_of_isReal hw (x : K)| := by
        rw [← NumberField.InfinitePlace.norm_embedding_of_isReal hw, Real.norm_eq_abs]
      have hw_ne : (w (x : K) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (w.pos_iff.mpr hxK))
      rw [div_pow, div_eq_one_iff_eq (pow_ne_zero 2 hw_ne), h_emb, h_norm]
      norm_cast
      exact (sq_abs _).symm
    have h_factor : ∀ w : NumberField.InfinitePlace K,
        (u_w w) ^ (l_eff w) * (if w = w₀ then ((u_w w₀) ^ a₀) ^ 2 else 1) =
          ((u_w w) ^ (l_ang w)) ^ 2 := by
      intro w
      by_cases hw : w.IsReal
      · have hl0 : l_eff w = 0 := by dsimp [l_eff]; rw [if_pos hw]
        rw [hl0, zpow_zero, one_mul]
        have hrhs : ((u_w w) ^ (l_ang w)) ^ 2 = 1 := by
          rw [← zpow_natCast, ← zpow_mul, mul_comm (l_ang w), zpow_mul, zpow_natCast, hu_real_sq w hw, one_zpow]
        rw [hrhs]
        split_ifs with hww₀
        · subst hww₀
          rw [← pow_mul, mul_comm a₀ 2, pow_mul, hu_real_sq w hw, one_pow]
        · rfl
      · have hl_c : l_eff w = 2 * l_ang w - (if w = w₀ then 2 * (a₀ : ℤ) else 0) := by
          dsimp [l_eff]; rw [if_neg hw]
        rw [hl_c]
        have hrhs : ((u_w w) ^ (l_ang w)) ^ 2 = (u_w w) ^ (2 * l_ang w) := by
          rw [← zpow_natCast, ← zpow_mul, mul_comm]
          rfl
        rw [hrhs]
        split_ifs with hww₀
        · subst hww₀
          have ha₀_pow : ((u_w w) ^ a₀) ^ 2 = (u_w w) ^ (2 * (a₀ : ℤ)) := by
            rw [← pow_mul, mul_comm a₀ 2, ← zpow_natCast]
            push_cast
            rfl
          rw [ha₀_pow, ← zpow_add₀ (hu_ne w), sub_add_cancel]
        · rw [sub_zero, mul_one]
    have h_prod : (∏ w : NumberField.InfinitePlace K, (u_w w) ^ (l_eff w)) * ((u_w w₀) ^ a₀) ^ 2 =
        (∏ w : NumberField.InfinitePlace K, (u_w w) ^ (l_ang w)) ^ 2 := by
      have h1 : (∏ w : NumberField.InfinitePlace K,
          ((u_w w) ^ (l_eff w) * (if w = w₀ then ((u_w w₀) ^ a₀) ^ 2 else 1))) =
          ∏ w : NumberField.InfinitePlace K, ((u_w w) ^ (l_ang w)) ^ 2 :=
        Finset.prod_congr rfl (fun w _ => h_factor w)
      rw [Finset.prod_mul_distrib, Finset.prod_ite_eq' Finset.univ w₀ (fun _ => ((u_w w₀) ^ a₀) ^ 2),
        if_pos (Finset.mem_univ w₀), Finset.prod_pow] at h1
      exact h1
    have hw₀_pow_ne : ((u_w w₀) ^ a₀) ^ 2 ≠ 0 := pow_ne_zero 2 (pow_ne_zero a₀ (hu_ne w₀))
    change z * ((u_w w₀) ^ a₀) ^ 2 = (∏ w : NumberField.InfinitePlace K, (u_w w) ^ (l_ang w)) ^ 2 ↔
      z = ∏ w : NumberField.InfinitePlace K, (u_w w) ^ (l_eff w)
    rw [← h_prod, mul_left_inj' hw₀_pow_ne]

theorem mitsui_primitive_grossenchar_sq_exists_quotient_char_and_zero_mode {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_prin_eff : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w))
    (hχ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1)
    (hχ₀_prim_eff : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) ≠
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)) :
    let R := NumberField.RingOfIntegers K
    ∃ ψ_f : (R ⧸ f) → ℂ,
      ψ_f 1 = 1 ∧
      (∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b) ∧
      (∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0)) ∧
      (∀ (x : R) (hx_ne : x ≠ 0),
        χ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
        ψ_f (Ideal.Quotient.mk f x) *
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)) ∧
      (∀ f' : Ideal R, f ≤ f' → f' ≠ f →
        ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1) ∧
      ((f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
