          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        (χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 := by
      rw [h_ideal_eq, map_pow]
