            q.1 ∈ Set.Ioc (-Real.log X) 0 ∧
            ((∃ hw : w.IsReal,
                (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                  R₁ * Real.exp q.1 ∈
                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                  -(R₁ * Real.exp q.1) ∈
                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
              (∃ hc : w.IsComplex,
                q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                (R₁ * Real.exp q.1) * Real.cos q.2 ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                (R₁ * Real.exp q.1) * Real.sin q.2 ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))}.indicator
            (fun q => ENNReal.ofReal ((R₁ * Real.exp q.1) ^ w.mult)) q).toReal ∧
        (∫⁻ q : ℝ × ℝ,
          {q : ℝ × ℝ |
            q.1 ∈ Set.Ioc (-Real.log X) 0 ∧
            ((∃ hw : w.IsReal,
                (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                  R₁ * Real.exp q.1 ∈
                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                  -(R₁ * Real.exp q.1) ∈
                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
              (∃ hc : w.IsComplex,
                q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                (R₁ * Real.exp q.1) * Real.cos q.2 ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
