        rw [dif_pos hIf', norm_mul, norm_inv]
        set M₀ := (h_ex I hIf').choose
        set c₀ := (h_ex I hIf').choose_spec.choose
        obtain ⟨hc₀_ne, hM₀_cop, _, _⟩ := (h_ex I hIf').choose_spec.choose_spec
        rw [hlam_norm c₀ hc₀_ne, (hχ_norm_supp₁ M₀).1 hM₀_cop, inv_one, mul_one]
      · intro hIf'
        change g I = 0
        dsimp [g]
        exact dif_neg hIf'
    · intro x hx_ne hx_sub
      let X : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
        ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
      have hX_cop : (X : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ := by
        change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f' = ⊤
        rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
        refine ⟨x * 1, Ideal.mem_span_singleton.mpr ⟨1, rfl⟩, -(x - 1), f'.neg_mem hx_sub, ?_⟩
        ring
      have h1_cop : ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ := by
        rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
      have hX_mul : (X : Ideal (NumberField.RingOfIntegers K)) *
          ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) =
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) := by
        change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) *
          ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) = _
        rw [Submonoid.coe_one, Ideal.one_eq_top, Ideal.mul_top]
      change g X = lam_inf x
      rw [h_eval X hX_cop 1 x hx_ne h1_cop hX_mul hx_sub, map_one, inv_one, mul_one]
  
  have h_norm_lt_of_ne : ∀ (q₁ f' : Ideal (NumberField.RingOfIntegers K)),
      q₁ ≠ 0 → q₁ ≤ f' → f' ≠ q₁ → f' ≠ 0 ∧ Ideal.absNorm f' < Ideal.absNorm q₁ := by
    intro q₁ f' hq₁ hq₁f' hne
    obtain ⟨c', hc'⟩ := Ideal.dvd_iff_le.mpr hq₁f'
    have hf'_ne : f' ≠ 0 := left_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne : c' ≠ 0 := right_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne_top : c' ≠ ⊤ := by
      intro htop
      rw [htop, Ideal.mul_top] at hc'
      exact hne hc'.symm
    have hf'_norm_ne_zero : Ideal.absNorm f' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf'_ne
    have hc'_norm_ne_zero : Ideal.absNorm c' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hc'_ne
    have hc'_norm_ne_one : Ideal.absNorm c' ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr hc'_ne_top
    refine ⟨hf'_ne, ?_⟩
    rw [hc', map_mul]
    exact lt_mul_of_one_lt_right (Nat.pos_of_ne_zero hf'_norm_ne_zero) (by omega)
  
  have h_ind : ∀ (m : ℕ) (q₁ : Ideal (NumberField.RingOfIntegers K)) (hq₁ : q₁ ≠ 0),
      Ideal.absNorm q₁ = m →
      ∀ (χ₁ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ‖χ₁ I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤) → χ₁ I = 0)) →
        (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ q₁ →
          χ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = lam_inf x) →
        ∃ (f : Ideal (NumberField.RingOfIntegers K))
          (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
          q₁ ≤ f ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0)) ∧
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ f →
            χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = lam_inf x) ∧
          (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
            ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
              Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
              x - 1 ∈ f' ∧
              χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ lam_inf x) ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → χ₁ I = χ₀ I) := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro q₁ hq₁ hm χ₁ hχ₁_norm_supp hχ₁_lam
    by_cases h_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), q₁ ≤ f' → f' ≠ q₁ →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧
          x - 1 ∈ f' ∧
          χ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ lam_inf x
    · exact ⟨q₁, χ₁, le_rfl, hχ₁_norm_supp, hχ₁_lam, h_prim, fun _ _ => rfl⟩
    · push_neg at h_prim
      rcases h_prim with ⟨f', hq₁f', hf'_ne, h_triv⟩
      obtain ⟨hf'_ne_zero, h_norm_lt⟩ := h_norm_lt_of_ne q₁ f' hq₁ hq₁f' hf'_ne
      obtain ⟨χ', hχ'_norm_supp, hχ'_lam, hχ'_eq⟩ :=
        h_extend q₁ f' hq₁ hq₁f' χ₁ hχ₁_norm_supp h_triv
      rw [hm] at h_norm_lt
      obtain ⟨f, χ₀, hf'f, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim, hχ₀_eq⟩ :=
        ih (Ideal.absNorm f') h_norm_lt f' hf'_ne_zero rfl χ' hχ'_norm_supp hχ'_lam
      refine ⟨f, χ₀, le_trans hq₁f' hf'f, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim, ?_⟩
      intro I hIq₁
      have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hIq₁) (sup_le_sup_left hq₁f' _))
      rw [← hχ'_eq I hIq₁, hχ₀_eq I hIf']
  have hχ_lam : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = lam_inf x :=
    fun x hx_ne hxq => (hlam_iff x hx_ne _).mpr (hχ_prin x hx_ne hxq)
  obtain ⟨f, χ₀, hqf, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim_lam, hχ_eq⟩ :=
    h_ind (Ideal.absNorm q) q hq rfl χ_gr hχ_norm_supp hχ_lam
  refine ⟨f, χ₀, hqf, hχ₀_norm_supp, ?_, ?_, hχ_eq⟩
  · intro x hx_ne hxf
    exact (hlam_iff x hx_ne _).mp (hχ₀_lam x hx_ne hxf)
  · intro f' hff' hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_ne_lam⟩ := hχ₀_prim_lam f' hff' hf'_ne
    refine ⟨x, hx_ne, hx_cop, hx_sub, ?_⟩
    intro y hy_log hy_eq
    exact hx_ne_lam ((hlam_iff x hx_ne _).mpr ⟨y, hy_log, hy_eq⟩)

theorem mitsui_ideal_coprime_restriction_euler_factor_LSeries {K : Type u} [Field K] [NumberField K]
    (c : Ideal (NumberField.RingOfIntegers K)) (hc : c ≠ 0)
    (χ χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ₀ I‖ ≤ 1)
    (h_coprime_eq : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ c = ⊤ → χ I = χ₀ I)
    (h_not_coprime_zero : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ c = ⊤) → χ I = 0) :
    ∃ E : ℂ → ℂ,
      Differentiable ℂ E ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖E s‖ ≤ (Ideal.absNorm c : ℝ) ^ 2) ∧
      (∀ s : ℂ, 1 < s.re →
        E s * LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
        LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let S' : ℕ → Type u := fun e => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = e}
  let c_K : ℕ → ℕ := fun n => Nat.card (S n)
  let a_K : (nonZeroDivisors (Ideal R) →* ℂ) → ℕ → ℂ :=
    fun ψ n => ∑' I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  have hS'_fin : ∀ e : ℕ, Finite (S' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2)
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  letI : ∀ e, Fintype (S' e) := fun e => Fintype.ofFinite (S' e)
  have hc_nonneg : ∀ n : ℕ, 0 ≤ (c_K n : ℝ) := fun _ => Nat.cast_nonneg _

  
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have hc_summable_all : ∀ w : ℂ, 1 < w.re → LSeriesSummable (fun n => (c_K n : ℂ)) w := by
    intro w hw
    have hc_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (c_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, (c_K k : ℝ)) = (Nat.card S_pos : ℝ) := by
        have h1 : (∑ _J : S_pos, (1 : ℝ)) = (Nat.card S_pos : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        rw [← h1, ← Finset.sum_fiberwise_of_maps_to hg (fun _ => (1 : ℝ))]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_Icc] at hk
        let e_k : S k ≃ {J : S_pos // g J = k} :=
          { toFun := fun I => ⟨⟨I.1, ⟨by rw [I.2]; exact hk.1, by rw [I.2]; exact hk.2⟩⟩, I.2⟩
            invFun := fun J => ⟨J.1.1, J.2⟩
            left_inv := fun _ => by apply Subtype.ext; rfl
            right_inv := fun _ => by apply Subtype.ext; apply Subtype.ext; rfl }
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]
        have h_card : ((Finset.univ.filter (fun J : S_pos => g J = k)).card : ℝ) =
            (Fintype.card {J : S_pos // g J = k} : ℝ) := by
          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (c_K k : ℝ)) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ (1 : ℝ)) := by
      refine Asymptotics.IsBigO.of_bound C₁ ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, (c_K k : ℝ) :=
        Finset.sum_nonneg (fun k _ => hc_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ (1 : ℝ) := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact hc_sum_bound N hN
    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO hc_nonneg zero_le_one hw
    simpa [c_K, S] using h_sum_real

  have h_s1 : ∀ (ψ : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R), ‖ψ I‖ ≤ 1) →
      ∀ s : ℂ, 1 < s.re → LSeriesSummable (a_K ψ) s := by
    intro ψ hψ_norm s hs
    have ha_ψ_bound : ∀ n : ℕ, ‖a_K ψ n‖ ≤ (c_K n : ℝ) := by
      intro n
      dsimp [a_K, c_K]
      rw [tsum_fintype]
      have h_inj : Function.Injective (fun I : S' n => (⟨I.1, I.2.2⟩ : S n)) :=
        fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
      have h_card : (Nat.card (S' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective _ h_inj
      calc ‖∑ I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
          ≤ ∑ I : S' n, ‖ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
        _ ≤ ∑ _I : S' n, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hψ_norm _)
        _ = (Nat.card (S' n) : ℝ) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        _ ≤ (Nat.card (S n) : ℝ) := h_card
    have h_sum_c : Summable (LSeries.term (fun n => (c_K n : ℂ)) s) := hc_summable_all s hs
    refine Summable.of_norm_bounded h_sum_c.norm (fun n => ?_)
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact ha_ψ_bound n

  
  have h_s2 : ∀ (ψ : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R), ‖ψ I‖ ≤ 1) →
      ∀ (p : IsDedekindDomain.HeightOneSpectrum R),
        Differentiable ℂ (fun s : ℂ =>
          1 - ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
            ((Ideal.absNorm p.asIdeal : ℝ) : ℂ) ^ (-s)) ∧
        (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
          ‖1 - ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
            ((Ideal.absNorm p.asIdeal : ℝ) : ℂ) ^ (-s)‖ ≤
            (Ideal.absNorm p.asIdeal : ℝ) ^ 2) ∧
        (∀ s : ℂ,
          LSeriesSummable (fun k : ℕ =>
            if k = Ideal.absNorm p.asIdeal then
              ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
            else 0) s ∧
          LSeries (fun k : ℕ =>
            if k = Ideal.absNorm p.asIdeal then
              ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
            else 0) s =
            ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
              ((Ideal.absNorm p.asIdeal : ℝ) : ℂ) ^ (-s)) := by
    intro ψ hψ_norm p
    set Np : ℕ := Ideal.absNorm p.asIdeal
    set α_p : ℂ := ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
    have hNp_ne_zero : Np ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have hNp_ne_one : Np ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    have hNp_ge_two_nat : 2 ≤ Np := by omega
    have hNp_ge_two : (2 : ℝ) ≤ (Np : ℝ) := by exact_mod_cast hNp_ge_two_nat
    have hNp_ge_one : (1 : ℝ) ≤ (Np : ℝ) := by linarith
    have hNp_pos : 0 < (Np : ℝ) := by linarith
    have hNp_c_ne : ((Np : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNp_pos)
    refine ⟨?_, ?_, ?_⟩
    · refine (differentiable_const (1 : ℂ)).sub ?_
      refine (differentiable_const α_p).mul ?_
      exact Differentiable.const_cpow differentiable_id.neg (Or.inl hNp_c_ne)
    · intro s hs1 _
      have h_tri : ‖(1 : ℂ) - α_p * ((Np : ℝ) : ℂ) ^ (-s)‖ ≤
          1 + ‖α_p‖ * ‖((Np : ℝ) : ℂ) ^ (-s)‖ := by
        calc ‖(1 : ℂ) - α_p * ((Np : ℝ) : ℂ) ^ (-s)‖
            ≤ ‖(1 : ℂ)‖ + ‖α_p * ((Np : ℝ) : ℂ) ^ (-s)‖ := norm_sub_le _ _
          _ = 1 + ‖α_p‖ * ‖((Np : ℝ) : ℂ) ^ (-s)‖ := by rw [norm_one, norm_mul]
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hNp_pos, Complex.neg_re] at h_tri
      have h_exp_le : -s.re ≤ (1 : ℝ) := by linarith
      have h_rpow_le : (Np : ℝ) ^ (-s.re) ≤ (Np : ℝ) := by
        have h1 := Real.rpow_le_rpow_of_exponent_le hNp_ge_one h_exp_le
        rwa [Real.rpow_one] at h1
      have h_prod_le : ‖α_p‖ * (Np : ℝ) ^ (-s.re) ≤ (Np : ℝ) := by
        calc ‖α_p‖ * (Np : ℝ) ^ (-s.re)
            ≤ 1 * (Np : ℝ) := mul_le_mul (hψ_norm _) h_rpow_le (by positivity) zero_le_one
          _ = (Np : ℝ) := one_mul _
      have h_sq : 1 + (Np : ℝ) ≤ (Np : ℝ) ^ 2 := by nlinarith
      exact le_trans h_tri (by linarith)
    · intro s
      let f_p : ℕ → ℂ := fun k => if k = Np then α_p else 0
      have hfp_term : ∀ k : ℕ, k ≠ Np → LSeries.term f_p s k = 0 := by
        intro k hk
        rw [LSeries.term_def]
        split_ifs with h0
        · rfl
        · dsimp [f_p]
          rw [if_neg hk, zero_div]
      refine ⟨summable_of_ne_finset_zero (s := {Np})
        (fun k hk => hfp_term k (Finset.mem_singleton.not.mp hk)), ?_⟩
      change ∑' k : ℕ, LSeries.term f_p s k = _
      rw [tsum_eq_single Np (fun k hk => hfp_term k hk)]
      rw [LSeries.term_def, if_neg hNp_ne_zero]
      dsimp [f_p]
      rw [if_pos rfl, div_eq_mul_inv, ← Complex.cpow_neg]

  
  have h_s3 : ∀ (p : IsDedekindDomain.HeightOneSpectrum R)
      (ψ ψ₁ : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ p.asIdeal = ⊤ → ψ₁ I = ψ I) →
      (∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ p.asIdeal = ⊤) → ψ₁ I = 0) →
      LSeries.convolution
        (fun k : ℕ =>
          if k = Ideal.absNorm p.asIdeal then
            ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
          else 0)
        (a_K ψ) + a_K ψ₁ = a_K ψ := by
    intro p ψ ψ₁ h_coprime h_not_coprime
    set Np : ℕ := Ideal.absNorm p.asIdeal
    set α_p : ℂ := ψ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
    let f_p : ℕ → ℂ := fun k => if k = Np then α_p else 0
    have hNp_ne_zero : Np ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have hNp_pos : 0 < Np := Nat.pos_of_ne_zero hNp_ne_zero
    have h_not_coprime_iff_dvd : ∀ J : Ideal R, ¬ (J ⊔ p.asIdeal = ⊤) ↔ p.asIdeal ∣ J := by
      intro J
      constructor
      · intro h_not_top
        have h_eq : p.asIdeal = J ⊔ p.asIdeal := p.isMaximal.eq_of_le h_not_top le_sup_right
        have h_le : J ≤ p.asIdeal := le_sup_left.trans_eq h_eq.symm
        exact Ideal.dvd_iff_le.mpr h_le
      · intro hdvd h_top
        have h_le : J ≤ p.asIdeal := Ideal.dvd_iff_le.mp hdvd
        rw [sup_eq_right.mpr h_le] at h_top
        exact p.isPrime.ne_top h_top
    funext n
    rw [Pi.add_apply, LSeries.convolution_def]
    dsimp only
    by_cases hn : n = 0
    · subst hn
      haveI h_empty : IsEmpty (S' 0) := ⟨fun I => I.2.1 (Ideal.absNorm_eq_zero_iff.mp I.2.2)⟩
      dsimp [a_K]
      rw [Nat.divisorsAntidiagonal_zero, Finset.sum_empty, zero_add, tsum_empty, tsum_empty]
    · have h_a_ψ : a_K ψ n =
          (∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) +
          (∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) := by
        dsimp [a_K]
        rw [tsum_fintype, ← Finset.sum_filter_add_sum_filter_not (Finset.univ : Finset (S' n))
          (fun I : S' n => ¬ (I.1 ⊔ p.asIdeal = ⊤))]
      have h_a_ψ₁ : a_K ψ₁ n =
          ∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ := by
        dsimp [a_K]
        rw [tsum_fintype, ← Finset.sum_filter_add_sum_filter_not (Finset.univ : Finset (S' n))
          (fun I : S' n => ¬ (I.1 ⊔ p.asIdeal = ⊤))]
        have h_zero : (∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ₁ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) = 0 := by
          refine Finset.sum_eq_zero (fun I hI => ?_)
          rw [Finset.mem_filter] at hI
          exact h_not_coprime ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ hI.2
        have h_eq : (∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ₁ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) =
          ∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ := by
          refine Finset.sum_congr rfl (fun I hI => ?_)
          rw [Finset.mem_filter] at hI
          exact h_coprime ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ (not_not.mp hI.2)
        rw [h_zero, zero_add, h_eq]
      rw [h_a_ψ, h_a_ψ₁]
      refine congrArg (· + ∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬¬ (I.1 ⊔ p.asIdeal = ⊤)),
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) ?_
      change (∑ uv ∈ n.divisorsAntidiagonal, f_p uv.1 * a_K ψ uv.2) = _
      by_cases hdvd : Np ∣ n
      · set m : ℕ := n / Np
        have hNpm : Np * m = n := Nat.mul_div_cancel' hdvd
        have h_lhs : (∑ uv ∈ n.divisorsAntidiagonal, f_p uv.1 * a_K ψ uv.2) =
            ∑ J ∈ (Finset.univ : Finset (S' m)),
              α_p * ψ ⟨J.1, mem_nonZeroDivisors_of_ne_zero J.2.1⟩ := by
          rw [Finset.sum_eq_single (Np, m)]
          · dsimp [f_p, a_K]
            rw [if_pos rfl, tsum_fintype, Finset.mul_sum]
          · intro uv huv huv_ne
            rw [Nat.mem_divisorsAntidiagonal] at huv
            have huv1_ne : uv.1 ≠ Np := by
              intro h1
              apply huv_ne
              ext
              · exact h1
              · rw [h1, ← hNpm] at huv
                exact Nat.eq_of_mul_eq_mul_left hNp_pos huv.1
            dsimp [f_p]
            rw [if_neg huv1_ne, zero_mul]
          · intro h_not_mem
            exfalso
            exact h_not_mem (Nat.mem_divisorsAntidiagonal.mpr ⟨hNpm, hn⟩)
        rw [h_lhs]
        refine Finset.sum_bij
          (fun (J : S' m) _ => (⟨p.asIdeal * J.1,
            ⟨mul_ne_zero p.ne_bot J.2.1, by rw [map_mul, J.2.2]; exact hNpm⟩⟩ : S' n))
          ?_ ?_ ?_ ?_
        · intro J _
          rw [Finset.mem_filter]
          refine ⟨Finset.mem_univ _, (h_not_coprime_iff_dvd (p.asIdeal * J.1)).mpr (dvd_mul_right _ _)⟩
        · intro J₁ _ J₂ _ h_eq
          apply Subtype.ext
          have h_mul : p.asIdeal * J₁.1 = p.asIdeal * J₂.1 := congrArg Subtype.val h_eq
          exact mul_left_cancel₀ p.ne_bot h_mul
        · intro I hI
          rw [Finset.mem_filter] at hI
          obtain ⟨J₀, hJ₀⟩ := (h_not_coprime_iff_dvd I.1).mp hI.2
          have hJ₀_ne : J₀ ≠ ⊥ := right_ne_zero_of_mul (hJ₀ ▸ I.2.1)
          have hJ₀_norm : Ideal.absNorm J₀ = m := by
            have h1 : Np * Ideal.absNorm J₀ = Np * m := by
              calc Np * Ideal.absNorm J₀ = Ideal.absNorm (p.asIdeal * J₀) := (map_mul _ _ _).symm
                _ = Ideal.absNorm I.1 := by rw [← hJ₀]
                _ = n := I.2.2
                _ = Np * m := hNpm.symm
            exact Nat.eq_of_mul_eq_mul_left hNp_pos h1
          refine ⟨⟨J₀, ⟨hJ₀_ne, hJ₀_norm⟩⟩, Finset.mem_univ _, ?_⟩
          apply Subtype.ext
          exact hJ₀.symm
        · intro J _
          dsimp [α_p]
          rw [← map_mul ψ]
          exact congrArg ψ (Subtype.ext rfl)
      · have h_lhs : (∑ uv ∈ n.divisorsAntidiagonal, f_p uv.1 * a_K ψ uv.2) = 0 := by
          refine Finset.sum_eq_zero (fun uv huv => ?_)
          rw [Nat.mem_divisorsAntidiagonal] at huv
          have huv1_ne : uv.1 ≠ Np := by
            intro h1
            apply hdvd
            exact ⟨uv.2, by rw [← h1, huv.1]⟩
          dsimp [f_p]
          rw [if_neg huv1_ne, zero_mul]
        have h_rhs : (∑ I ∈ (Finset.univ : Finset (S' n)).filter (fun I : S' n => ¬ (I.1 ⊔ p.asIdeal = ⊤)),
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) = 0 := by
          refine Finset.sum_eq_zero (fun I hI => ?_)
          exfalso
          rw [Finset.mem_filter] at hI
          obtain ⟨J₀, hJ₀⟩ := (h_not_coprime_iff_dvd I.1).mp hI.2
          apply hdvd
          refine ⟨Ideal.absNorm J₀, ?_⟩
          calc n = Ideal.absNorm I.1 := I.2.2.symm
            _ = Ideal.absNorm (p.asIdeal * J₀) := by rw [hJ₀]
            _ = Np * Ideal.absNorm J₀ := map_mul _ _ _
        rw [h_lhs, h_rhs]

  
  have h_s4 : ∀ (c₁ : Ideal R) (hc₁ : c₁ ≠ 0) (hc₁_top : c₁ ≠ ⊤)
      (χ' χ₀' : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R), ‖χ₀' I‖ ≤ 1) →
      (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ c₁ = ⊤ → χ' I = χ₀' I) →
      (∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ c₁ = ⊤) → χ' I = 0) →
      ∃ (p : IsDedekindDomain.HeightOneSpectrum R)
        (c' : Ideal R)
        (χ₁ : nonZeroDivisors (Ideal R) →* ℂ),
        c₁ = p.asIdeal * c' ∧
        c' ≠ 0 ∧
        Ideal.absNorm c' < Ideal.absNorm c₁ ∧
        (∀ I : nonZeroDivisors (Ideal R), ‖χ₁ I‖ ≤ 1) ∧
        (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ p.asIdeal = ⊤ → χ₁ I = χ₀' I) ∧
        (∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ p.asIdeal = ⊤) → χ₁ I = 0) ∧
        (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ c' = ⊤ → χ' I = χ₁ I) ∧
        (∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ c' = ⊤) → χ' I = 0) := by
    intro c₁ hc₁ hc₁_top χ' χ₀' hχ₀'_norm h_coprime_eq' h_not_coprime_zero'
    obtain ⟨P, hP_max, hc₁P⟩ := Ideal.exists_le_maximal c₁ hc₁_top
    have hP_ne_bot : P ≠ ⊥ := by
      intro hbot
      rw [hbot, le_bot_iff] at hc₁P
      exact hc₁ hc₁P
    let p : IsDedekindDomain.HeightOneSpectrum R := ⟨P, hP_max.isPrime, hP_ne_bot⟩
    have hc₁p : c₁ ≤ p.asIdeal := hc₁P
    obtain ⟨c', hc_mul⟩ := Ideal.dvd_iff_le.mpr hc₁p
    have hc'_ne : c' ≠ 0 := right_ne_zero_of_mul (hc_mul ▸ hc₁)
    have hNp_ne_zero : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have hNp_ne_one : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    have hc'_norm_ne_zero : Ideal.absNorm c' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hc'_ne
    have h_norm_lt : Ideal.absNorm c' < Ideal.absNorm c₁ := by
      rw [hc_mul, map_mul]
      exact lt_mul_of_one_lt_left (Nat.pos_of_ne_zero hc'_norm_ne_zero) (by omega)
    let χ₁ : nonZeroDivisors (Ideal R) →* ℂ :=
      { toFun := fun I => if (I : Ideal R) ⊔ p.asIdeal = ⊤ then χ₀' I else 0
        map_one' := by
          have h1 : ((1 : nonZeroDivisors (Ideal R)) : Ideal R) ⊔ p.asIdeal = ⊤ := by
            rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
          rw [if_pos h1, map_one]
        map_mul' := by
          intro I J
          have h_mul_iff : ((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ⊔ p.asIdeal = ⊤ ↔
              ((I : Ideal R) ⊔ p.asIdeal = ⊤ ∧ (J : Ideal R) ⊔ p.asIdeal = ⊤) := by
            rw [Submonoid.coe_mul, ← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq,
              ← Ideal.isCoprime_iff_sup_eq]
            exact IsCoprime.mul_left_iff
          by_cases hI : (I : Ideal R) ⊔ p.asIdeal = ⊤
          · by_cases hJ : (J : Ideal R) ⊔ p.asIdeal = ⊤
            · rw [if_pos (h_mul_iff.mpr ⟨hI, hJ⟩), if_pos hI, if_pos hJ, map_mul]
            · have hIJ : ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ⊔ p.asIdeal = ⊤) :=
                fun h => hJ (h_mul_iff.mp h).2
              rw [if_neg hIJ, if_neg hJ, mul_zero]
          · have hIJ : ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ⊔ p.asIdeal = ⊤) :=
              fun h => hI (h_mul_iff.mp h).1
            rw [if_neg hIJ, if_neg hI, zero_mul] }
    have hχ₁_norm : ∀ I : nonZeroDivisors (Ideal R), ‖χ₁ I‖ ≤ 1 := by
      intro I
      change ‖if (I : Ideal R) ⊔ p.asIdeal = ⊤ then χ₀' I else 0‖ ≤ 1
      split_ifs
      · exact hχ₀'_norm I
      · rw [norm_zero]; exact zero_le_one
    have hχ₁_p_eq : ∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ p.asIdeal = ⊤ → χ₁ I = χ₀' I := by
      intro I hI
      change (if (I : Ideal R) ⊔ p.asIdeal = ⊤ then χ₀' I else 0) = χ₀' I
      exact if_pos hI
    have hχ₁_p_zero : ∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ p.asIdeal = ⊤) → χ₁ I = 0 := by
      intro I hI
      change (if (I : Ideal R) ⊔ p.asIdeal = ⊤ then χ₀' I else 0) = 0
      exact if_neg hI
    have h_c_iff : ∀ J : Ideal R, J ⊔ c₁ = ⊤ ↔ (J ⊔ p.asIdeal = ⊤ ∧ J ⊔ c' = ⊤) := by
      intro J
      rw [hc_mul, ← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq,
        ← Ideal.isCoprime_iff_sup_eq]
      exact IsCoprime.mul_right_iff
    have hχ_c'_eq : ∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ c' = ⊤ → χ' I = χ₁ I := by
      intro I hIc'
      by_cases hIp : (I : Ideal R) ⊔ p.asIdeal = ⊤
      · rw [h_coprime_eq' I ((h_c_iff I).mpr ⟨hIp, hIc'⟩), hχ₁_p_eq I hIp]
      · have hnIc : ¬ ((I : Ideal R) ⊔ c₁ = ⊤) := fun h => hIp ((h_c_iff I).mp h).1
        rw [h_not_coprime_zero' I hnIc, hχ₁_p_zero I hIp]
    have hχ_c'_zero : ∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ c' = ⊤) → χ' I = 0 := by
      intro I hnIc'
      have hnIc : ¬ ((I : Ideal R) ⊔ c₁ = ⊤) := fun h => hnIc' ((h_c_iff I).mp h).2
      exact h_not_coprime_zero' I hnIc
    exact ⟨p, c', χ₁, hc_mul, hc'_ne, h_norm_lt, hχ₁_norm,
      hχ₁_p_eq, hχ₁_p_zero, hχ_c'_eq, hχ_c'_zero⟩

  
  have h_ind : ∀ (m : ℕ) (c₁ : Ideal R) (hc₁ : c₁ ≠ 0),
      Ideal.absNorm c₁ = m →
      ∀ (χ' χ₀' : nonZeroDivisors (Ideal R) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal R), ‖χ₀' I‖ ≤ 1) →
        (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ c₁ = ⊤ → χ' I = χ₀' I) →
        (∀ I : nonZeroDivisors (Ideal R), ¬ ((I : Ideal R) ⊔ c₁ = ⊤) → χ' I = 0) →
        ∃ E : ℂ → ℂ,
          Differentiable ℂ E ∧
          (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖E s‖ ≤ (Ideal.absNorm c₁ : ℝ) ^ 2) ∧
          (∀ s : ℂ, 1 < s.re → E s * LSeries (a_K χ₀') s = LSeries (a_K χ') s) := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro c₁ hc₁ hm χ' χ₀' hχ₀'_norm h_coprime_eq' h_not_coprime_zero'
    by_cases hc₁_top : c₁ = ⊤
    · refine ⟨fun _ => 1, differentiable_const (1 : ℂ), ?_, ?_⟩
      · intro s _ _
        rw [hc₁_top, Ideal.absNorm_eq_one_iff.mpr rfl, Nat.cast_one, one_pow, norm_one]
      · intro s _
        rw [one_mul]
        have h_eq : a_K χ₀' = a_K χ' := by
          funext n
          dsimp [a_K]
          congr 1
          ext I
          exact (h_coprime_eq' ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
            (by rw [hc₁_top, sup_top_eq])).symm
        rw [h_eq]
    · obtain ⟨p, c', χ₁, hc_mul, hc'_ne, h_norm_lt, hχ₁_norm,
          hχ₁_p_eq, hχ₁_p_zero, hχ_c'_eq, hχ_c'_zero⟩ :=
        h_s4 c₁ hc₁ hc₁_top χ' χ₀' hχ₀'_norm h_coprime_eq' h_not_coprime_zero'
      rw [hm] at h_norm_lt
      obtain ⟨E', hE'_diff, hE'_bound, hE'_LSeries⟩ :=
        ih (Ideal.absNorm c') h_norm_lt c' hc'_ne rfl χ' χ₁ hχ₁_norm hχ_c'_eq hχ_c'_zero
      obtain ⟨hep_diff, hep_bound, hfp_LSeries⟩ := h_s2 χ₀' hχ₀'_norm p
      have h_conv := h_s3 p χ₀' χ₁ hχ₁_p_eq hχ₁_p_zero
      let e_p : ℂ → ℂ := fun s =>
        1 - χ₀' ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
          ((Ideal.absNorm p.asIdeal : ℝ) : ℂ) ^ (-s)
      refine ⟨fun s => E' s * e_p s, hE'_diff.mul hep_diff, ?_, ?_⟩
      · intro s hs1 hs2
        rw [norm_mul, hc_mul, map_mul, Nat.cast_mul, mul_pow, mul_comm ((Ideal.absNorm p.asIdeal : ℝ) ^ 2)]
        exact mul_le_mul (hE'_bound s hs1 hs2) (hep_bound s hs1 hs2) (norm_nonneg _) (by positivity)
      · intro s hs
        have ha_χ₀'_sum : LSeriesSummable (a_K χ₀') s := h_s1 χ₀' hχ₀'_norm s hs
        have ha_χ₁_sum : LSeriesSummable (a_K χ₁) s := h_s1 χ₁ hχ₁_norm s hs
        obtain ⟨hfp_sum, hfp_eq⟩ := hfp_LSeries s
        let f_p : ℕ → ℂ := fun k =>
          if k = Ideal.absNorm p.asIdeal then
            χ₀' ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
          else 0
        have h_conv_sum : LSeriesSummable (LSeries.convolution f_p (a_K χ₀')) s :=
          hfp_sum.convolution ha_χ₀'_sum
        have h_add := LSeries_add h_conv_sum ha_χ₁_sum
        rw [h_conv, LSeries_convolution' hfp_sum ha_χ₀'_sum, hfp_eq] at h_add
        have hep_LSeries : e_p s * LSeries (a_K χ₀') s = LSeries (a_K χ₁) s := by
          change (1 - χ₀' ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
              ((Ideal.absNorm p.asIdeal : ℝ) : ℂ) ^ (-s)) * LSeries (a_K χ₀') s = LSeries (a_K χ₁) s
          rw [sub_mul, one_mul, sub_eq_iff_eq_add]
          exact h_add.trans (add_comm _ _)
        rw [mul_assoc, hep_LSeries, hE'_LSeries s hs]
  exact h_ind (Ideal.absNorm c) c hc rfl χ χ₀ hχ₀_norm h_coprime_eq h_not_coprime_zero

theorem mitsui_shifted_unitRank_kernels_measurable_cont_and_exp_bound {K : Type u} [Field K] [NumberField K]
    (a_place : NumberField.InfinitePlace K → ℕ)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0) :
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    let U_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (y i)) ^ (a_place w)
    let J_maj : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ, U_K y * Real.exp (-a * Q_K y)
    let J_c : (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun ν_place a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        ((U_K y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin (NumberField.Units.rank K),
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) : ℝ) *
              Complex.I)
    let W₀_maj : ℝ → ℝ := fun τ =>
      if 0 < τ then
        (2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
          NumberField.Units.regulator K * τ⁻¹ *
          (τ ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          J_maj (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ)))
      else 0
    let W₀_c : (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun ν_place τ =>
      if 0 < τ then
        (((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
          NumberField.Units.regulator K * τ⁻¹ *
          (τ ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
          J_c ν_place (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ)))
      else 0
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let P_f : ℝ := (Ideal.absNorm f : ℝ) ^ (-3 / 4 : ℝ) * S_f
    let W_maj : ℝ → ℝ := fun t => P_f * W₀_maj (S_f * t)
    let W₁ : ℝ → ℂ := fun t => (P_f : ℂ) * W₀_c (-v_place) (S_f * t)
    let W₂ : ℝ → ℂ := fun t => (P_f : ℂ) * W₀_c v_place (S_f * t)
    ∃ C₀ c α : ℝ,
      0 < C₀ ∧ 0 < c ∧ 0 < α ∧
      Measurable W_maj ∧
      (∀ t : ℝ, 0 ≤ W_maj t) ∧
      MeasureTheory.AEStronglyMeasurable W₁ (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) ∧
      MeasureTheory.AEStronglyMeasurable W₂ (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) ∧
      ContinuousOn W₁ (Set.Ioi (1 : ℝ)) ∧
      ContinuousOn W₂ (Set.Ioi (1 : ℝ)) ∧
      (∀ t ∈ Set.Ioi (0 : ℝ), ‖W₁ t‖ ≤ W_maj t ∧ ‖W₂ t‖ ≤ W_maj t) ∧
      (∀ t ∈ Set.Ioi (1 : ℝ), W_maj t ≤ C₀ * Real.exp (-2 * c * t ^ α)) :=
by
  intro Q_K U_K J_maj J_c W₀_maj W₀_c S_f P_f W_maj W₁ W₂
  let r : ℕ := NumberField.Units.rank K
  let n : ℕ := Module.finrank ℚ K
  let r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  let r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  let D : ℝ := |(NumberField.discr K : ℝ)|
  let N_f : ℝ := (Ideal.absNorm f : ℝ)
  let Reg_K : ℝ := NumberField.Units.regulator K
  let P_K : ℝ := (2 : ℝ) ^ (r₁ + r₂) * Reg_K
  let A : ℕ := ∑ w : NumberField.InfinitePlace K, a_place w
  have hn_pos : 0 < (n : ℝ) := by exact_mod_cast Module.finrank_pos
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf
  have hNf_pos : 0 < N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hReg_pos : 0 < Reg_K := NumberField.Units.regulator_pos K
  have hPK_pos : 0 < P_K := by dsimp [P_K]; positivity
  have hSf_pos : 0 < S_f := by dsimp [S_f, D, N_f]; positivity
  have hPf_pos : 0 < P_f := by dsimp [P_f, N_f]; positivity
  let α : ℝ := 2 / (n : ℝ)
  have hα_pos : 0 < α := by dsimp [α]; positivity
  have hQ_meas : Measurable Q_K := by
    refine Finset.measurable_sum Finset.univ (fun w _ => ?_)
    refine measurable_const.mul (Finset.measurable_prod Finset.univ (fun i _ => ?_))
    exact Measurable.const_pow (measurable_const.mul (measurable_pi_apply i)) _
  have hU_meas : Measurable U_K := by
    refine Finset.measurable_prod Finset.univ (fun w _ => ?_)
    refine (Finset.measurable_prod Finset.univ (fun i _ => ?_)).pow_const (a_place w)
    exact Measurable.const_pow (measurable_pi_apply i) _
  have h_1d_exp_int : ∀ c_1d : ℝ, 0 < c_1d →
      MeasureTheory.Integrable (fun x : ℝ => Real.exp (-c_1d * |x|)) MeasureTheory.volume := by
    intro c_1d hc_1d
    have h_ioi : MeasureTheory.IntegrableOn (fun x : ℝ => Real.exp (-c_1d * x)) (Set.Ioi (-1 : ℝ)) MeasureTheory.volume :=
      integrableOn_exp_mul_Ioi (neg_lt_zero.mpr hc_1d) (-1)
    let g : ℝ → ℝ := (Set.Ioi (-1 : ℝ)).indicator (fun x => Real.exp (-c_1d * x))
    have hg : MeasureTheory.Integrable g MeasureTheory.volume :=
      (MeasureTheory.integrable_indicator_iff measurableSet_Ioi).mpr h_ioi
    have hg_sum : MeasureTheory.Integrable (fun x => g x + g (-x)) MeasureTheory.volume :=
      hg.add hg.comp_neg
    have h_meas : Measurable (fun x : ℝ => Real.exp (-c_1d * |x|)) :=
      Real.measurable_exp.comp (measurable_const.mul measurable_id.abs)
    refine hg_sum.mono' h_meas.aestronglyMeasurable (Filter.Eventually.of_forall (fun x => ?_))
    rw [Real.norm_of_nonneg (Real.exp_nonneg _)]
    have hg_nn : ∀ t : ℝ, 0 ≤ g t := fun t => Set.indicator_nonneg (fun _ _ => Real.exp_nonneg _) t
    rcases le_or_gt 0 x with hx | hx
    · have hgx : g x = Real.exp (-c_1d * |x|) := by
        dsimp [g]
        have hx1 : -1 < x := by linarith
        rw [Set.indicator_of_mem (Set.mem_Ioi.mpr hx1), abs_of_nonneg hx]
      linarith [hg_nn (-x)]
    · have hgnx : g (-x) = Real.exp (-c_1d * |x|) := by
        dsimp [g]
        have hnx1 : -1 < -x := by linarith
        rw [Set.indicator_of_mem (Set.mem_Ioi.mpr hnx1), abs_of_neg hx]
      linarith [hg_nn x]
  obtain ⟨C_norm, hC_pos, h_sum_y⟩ : ∃ C_norm : ℝ, 0 < C_norm ∧
      ∀ y : Fin (NumberField.Units.rank K) → ℝ,
        (∑ i : Fin (NumberField.Units.rank K), |y i|) ≤ C_norm * Q_K y := by
    classical
    let B_R := NumberField.Units.basisOfIsMaxRank (NumberField.Units.isMaxRank_fundSystem K)
    let SubW := {w : NumberField.InfinitePlace K // w ≠ NumberField.Units.dirichletUnitTheorem.w₀}
    let e_single : SubW → NumberField.Units.dirichletUnitTheorem.logSpace K :=
      fun w => Pi.single w (1 : ℝ)
    let M_inv : ℝ := ∑ i : Fin (NumberField.Units.rank K), ∑ w : SubW, |B_R.equivFun (e_single w) i|
    have hM_nn : 0 ≤ M_inv :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
    let N_w : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
    have hNw_pos : 0 < N_w := Nat.cast_pos.mpr Fintype.card_pos
    let C_norm : ℝ := (M_inv + 1) * (N_w / 2)
    have hC_pos : 0 < C_norm := by dsimp [C_norm]; positivity
    refine ⟨C_norm, hC_pos, fun y => ?_⟩
    set L : NumberField.InfinitePlace K → ℝ := fun w =>
      ∑ i : Fin (NumberField.Units.rank K),
        y i * ((w.mult : ℝ) * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)))
    have hQ_nn : 0 ≤ Q_K y := by
      dsimp [Q_K]
      refine Finset.sum_nonneg (fun w _ => mul_nonneg (Nat.cast_nonneg _) ?_)
      exact Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (apply_nonneg w _) _)
    have hL_le : ∀ w : NumberField.InfinitePlace K,
        2 * L w ≤ (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) := by
      intro w
      have hw_mult_pos : 0 < (w.mult : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero w.mult_ne_zero)
      have hw_mult_ne : (w.mult : ℝ) ≠ 0 := ne_of_gt hw_mult_pos
      have h_prod_exp : (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)) =
          Real.exp ((2 / (w.mult : ℝ)) * L w) := by
        have h_each : ∀ i : Fin (NumberField.Units.rank K),
            (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) =
            Real.exp (2 * y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) := by
          intro i
          have hw_pos : 0 < w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K) :=
            w.pos_iff.mpr (by exact_mod_cast (NumberField.Units.fundSystem K i).ne_zero)
          rw [Real.rpow_def_of_pos hw_pos]
          ring_nf
        simp_rw [h_each, ← Real.exp_sum]
        congr 1
        dsimp [L]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        field_simp [hw_mult_ne]
      rw [h_prod_exp]
      have h_exp := Real.add_one_le_exp ((2 / (w.mult : ℝ)) * L w)
      have h_mul := mul_le_mul_of_nonneg_left h_exp (le_of_lt hw_mult_pos)
      have h_lhs : (w.mult : ℝ) * ((2 / (w.mult : ℝ)) * L w + 1) = (w.mult : ℝ) + 2 * L w := by
        field_simp [hw_mult_ne]
        ring
      linarith
    have h2L_le_Q : ∀ w : NumberField.InfinitePlace K, 2 * L w ≤ Q_K y := by
      intro w
      calc 2 * L w
          ≤ (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) := hL_le w
        _ ≤ Q_K y := by
            dsimp only [Q_K]
            exact Finset.single_le_sum
              (f := fun v : NumberField.InfinitePlace K =>
                (v.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
                  (v ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i))
              (fun v _ => mul_nonneg (Nat.cast_nonneg _)
                (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (apply_nonneg v _) _)))
              (Finset.mem_univ w)
    have hL_sum_zero : (∑ w : NumberField.InfinitePlace K, L w) = 0 := by
      dsimp [L]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [← Finset.mul_sum]
      have h_unit_sum : (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) = 0 := by
        have h_prod : ∏ w : NumberField.InfinitePlace K,
            (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ w.mult = 1 := by
          rw [NumberField.InfinitePlace.prod_eq_abs_norm]
          exact_mod_cast NumberField.Units.norm K (NumberField.Units.fundSystem K i)
        have h_log := congrArg Real.log h_prod
        rw [Real.log_one, Real.log_prod (fun w _ => pow_ne_zero _ (ne_of_gt (w.pos_iff.mpr
          (by exact_mod_cast (NumberField.Units.fundSystem K i).ne_zero))))] at h_log
        simpa [Real.log_pow] using h_log
      rw [h_unit_sum, mul_zero]
    have h_abs_L : ∀ w : NumberField.InfinitePlace K, |L w| ≤ (N_w / 2) * Q_K y := by
      intro w
      rw [abs_le]
      have hNw_ge_one : 1 ≤ N_w := by
        dsimp [N_w]
        exact_mod_cast Fintype.card_pos (α := NumberField.InfinitePlace K)
      have h_upper : L w ≤ (N_w / 2) * Q_K y := by
        have := h2L_le_Q w
        have : Q_K y ≤ N_w * Q_K y := le_mul_of_one_le_left hQ_nn hNw_ge_one
        linarith
      have h_lower : -(N_w / 2) * Q_K y ≤ L w := by
        have h_erase : L w + ∑ v ∈ Finset.univ.erase w, L v = 0 := by
          rw [Finset.add_sum_erase _ _ (Finset.mem_univ w), hL_sum_zero]
        have h_sum_le : ∑ v ∈ Finset.univ.erase w, (2 * L v) ≤ ∑ v ∈ Finset.univ.erase w, Q_K y :=
          Finset.sum_le_sum (fun v _ => h2L_le_Q v)
        rw [← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul] at h_sum_le
        have h_card_le : ((Finset.univ.erase w).card : ℝ) ≤ N_w := by
          dsimp [N_w]
          exact_mod_cast Finset.card_le_univ _
        have h_rhs_le : ((Finset.univ.erase w).card : ℝ) * Q_K y ≤ N_w * Q_K y :=
          mul_le_mul_of_nonneg_right h_card_le hQ_nn
        linarith
      exact ⟨by linarith, h_upper⟩
    have h_symm_eq : ∀ w : SubW, (B_R.equivFun.symm y) w = L w.1 := by
      intro w
      rw [Module.Basis.equivFun_symm_apply]
      simp only [Pi.smul_apply, Finset.sum_apply, smul_eq_mul]
      dsimp [B_R, L]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [NumberField.Units.basisOfIsMaxRank_apply, NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    have h_decomp : B_R.equivFun.symm y = ∑ w : SubW, L w.1 • e_single w := by
      ext w
      rw [Finset.sum_apply, Finset.sum_eq_single w]
      · simp [e_single, h_symm_eq w]
      · intro v _ hvw
        simp [e_single, Pi.single_eq_of_ne (Ne.symm hvw)]
      · intro hw
        exact False.elim (hw (Finset.mem_univ w))
    have hy_eq : ∀ i : Fin (NumberField.Units.rank K),
        y i = ∑ w : SubW, L w.1 * (B_R.equivFun (e_single w) i) := by
      intro i
      have h1 : B_R.equivFun (B_R.equivFun.symm y) = y := B_R.equivFun.apply_symm_apply y
      conv_lhs => rw [← h1, h_decomp]
      rw [map_sum]
      simp only [Finset.sum_apply, map_smul, Pi.smul_apply, smul_eq_mul]
    have hy_abs : ∀ i : Fin (NumberField.Units.rank K),
        |y i| ≤ (∑ w : SubW, |B_R.equivFun (e_single w) i|) * ((N_w / 2) * Q_K y) := by
      intro i
      rw [hy_eq i, Finset.sum_mul]
      refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum (fun w _ => ?_))
      rw [abs_mul, mul_comm |L w.1|]
      exact mul_le_mul_of_nonneg_left (h_abs_L w.1) (abs_nonneg _)
    calc (∑ i : Fin (NumberField.Units.rank K), |y i|)
        ≤ ∑ i : Fin (NumberField.Units.rank K),
            (∑ w : SubW, |B_R.equivFun (e_single w) i|) * ((N_w / 2) * Q_K y) :=
          Finset.sum_le_sum (fun i _ => hy_abs i)
      _ = M_inv * ((N_w / 2) * Q_K y) := by
          dsimp [M_inv]
          rw [← Finset.sum_mul]
      _ ≤ (M_inv + 1) * ((N_w / 2) * Q_K y) :=
          mul_le_mul_of_nonneg_right (by linarith) (mul_nonneg (by positivity) hQ_nn)
      _ = C_norm * Q_K y := by dsimp [C_norm]; ring
  have h_int_gauss : ∀ b : ℝ, 0 < b →
      MeasureTheory.Integrable (fun y : Fin (NumberField.Units.rank K) → ℝ => Real.exp (-b * Q_K y)) MeasureTheory.volume := by
    intro b hb
    let c_1d : ℝ := b / C_norm
    have hc_1d_pos : 0 < c_1d := div_pos hb hC_pos
    have h_prod_int : MeasureTheory.Integrable
        (fun y : Fin (NumberField.Units.rank K) → ℝ =>
          ∏ i : Fin (NumberField.Units.rank K), Real.exp (-c_1d * |y i|)) MeasureTheory.volume := by
      rw [MeasureTheory.volume_pi]
      exact MeasureTheory.Integrable.fintype_prod (f := fun _ x => Real.exp (-c_1d * |x|))
        (fun _ => h_1d_exp_int c_1d hc_1d_pos)
    refine h_prod_int.mono' (Real.measurable_exp.comp (measurable_const.mul hQ_meas)).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.norm_of_nonneg (Real.exp_nonneg _), ← Real.exp_sum, Real.exp_le_exp]
    have h_sum_neg : (∑ i : Fin (NumberField.Units.rank K), -c_1d * |y i|) =
        -c_1d * ∑ i : Fin (NumberField.Units.rank K), |y i| := by
      simp [Finset.mul_sum]
    rw [h_sum_neg]
    have h_mul := mul_le_mul_of_nonneg_left (h_sum_y y) (le_of_lt hc_1d_pos)
    have h_cC : c_1d * (C_norm * Q_K y) = b * Q_K y := by
      dsimp [c_1d]
      have hC_ne : C_norm ≠ 0 := ne_of_gt hC_pos
      field_simp [hC_ne]
    linarith
  have hQ_amgm : ∀ y : Fin r → ℝ, (n : ℝ) ≤ Q_K y := by
    intro y
    set ω : NumberField.InfinitePlace K → ℝ := fun w => (w.mult : ℝ) / (n : ℝ)
    set z : NumberField.InfinitePlace K → ℝ := fun w =>
      ∏ i : Fin r,
        (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
