    have hNf_c_ne : (N_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNf_pos)
    have hNf_comb : (N_f : ℂ) ^ (z / 2) * (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ) = (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) := by
