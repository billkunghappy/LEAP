  have hexp_neg_taylor : Real.exp (-δ) - 1 + δ ≤ δ ^ 2 := by
    have habs : |-δ| ≤ 1 := by rw [abs_neg, abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    have h2 : Real.exp (-δ) - 1 - (-δ) ≤ (-δ) ^ 2 := le_trans (le_abs_self _) h1
    linarith
  have h_taylor_pos_Y : W * ((Real.exp δ - 1 - δ) * Y) ≤ W * Y * δ ^ 2 := by
    have h1 : (Real.exp δ - 1 - δ) * Y ≤ δ ^ 2 * Y :=
