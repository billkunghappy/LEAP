      dsimp only [Φ_emb]
      rcases le_or_gt 0 (l_eff w) with h_nn | h_lt
      · rw [if_pos h_nn]
        have hl_eq : l_eff w = (a_place w : ℤ) := by dsimp [a_place]; omega
        have h_zpow : (w.embedding z / (w z : ℂ)) ^ (l_eff w) =
            (w.embedding z / (w z : ℂ)) ^ (a_place w) := by
          rw [hl_eq, zpow_natCast]
        rw [h_zpow, ← mul_pow, div_mul_cancel₀ _ hw_ne]
