            mul_le_mul_of_nonneg_right h_card_le (by positivity)
        _ = (∏ w : ι, ((I_full w).card : ℝ)) * (∏ _w : ι, h) := by rw [hh_pow]
        _ = ∏ w : ι, (((I_full w).card : ℝ) * h) := (Finset.prod_mul_distrib).symm
        _ ≤ ∏ _w : ι, (C_2 * (B + 1)) := by
            refine Finset.prod_le_prod (fun w _ => by positivity) (fun w _ => h_card_full w)
        _ = (C_2 * (B + 1)) ^ r := by rw [Finset.prod_const, hcard_ι]
        _ = C_2 ^ r * (B + 1) ^ r := mul_pow C_2 (B + 1) r
    let Slab : ι → Finset (ι → ℤ) := fun w₁ =>
      Fintype.piFinset (fun w : ι => if w = w₁ then I_end w₁ else I_full w)
    have h_collar_bound : (S_collar.card : ℝ) * h ^ r ≤
        (r : ℝ) * K_end * C_2 ^ r * h * (B + 1) ^ r := by
      have h_maps : Set.MapsTo Ψ (S_collar : Set (Fin r → ℤ))
          (Finset.univ.biUnion Slab : Set (ι → ℤ)) := by
        intro p hp
        rw [Finset.mem_coe, Finset.mem_biUnion]
        obtain ⟨h_all, w₁, hw₁_ne, hw₁_not⟩ := hS_collar_prop p hp
        refine ⟨⟨w₁, hw₁_ne⟩, Finset.mem_univ _, ?_⟩
        dsimp [Slab]
        rw [Fintype.mem_piFinset]
        intro w
        split_ifs with hww₁
        · subst hww₁
          exact h_mem_end p ⟨w₁, hw₁_ne⟩ (h_all w₁ hw₁_ne) hw₁_not
        · exact h_mem_full p w (h_all w.1 w.2)
      have h_card_le_nat : S_collar.card ≤ ∑ w₁ : ι, (Slab w₁).card := by
        calc S_collar.card ≤ (Finset.univ.biUnion Slab).card :=
              Finset.card_le_card_of_injOn Ψ h_maps hΨ_inj.injOn
          _ ≤ ∑ w₁ : ι, (Slab w₁).card := Finset.card_biUnion_le
      have h_card_le : (S_collar.card : ℝ) ≤ ∑ w₁ : ι, ((Slab w₁).card : ℝ) := by
        exact_mod_cast h_card_le_nat
      have h_slab_bound : ∀ w₁ : ι, ((Slab w₁).card : ℝ) * h ^ r ≤ K_end * C_2 ^ r * h * (B + 1) ^ r := by
        intro w₁
        let f : ι → ℝ := fun w => (((if w = w₁ then I_end w₁ else I_full w).card : ℕ) : ℝ) * h
        have h_slab_card : ((Slab w₁).card : ℝ) =
            ∏ w : ι, (((if w = w₁ then I_end w₁ else I_full w).card : ℕ) : ℝ) := by
          dsimp [Slab]
          rw [Fintype.card_piFinset]
          push_cast
          rfl
        have hh_pow : (∏ _w : ι, h) = h ^ r := by
          rw [Finset.prod_const, hcard_ι]
        have h_prod_eq : ((Slab w₁).card : ℝ) * h ^ r = ∏ w : ι, f w := by
          rw [h_slab_card, ← hh_pow, ← Finset.prod_mul_distrib]
        have h_erase : (∏ w : ι, f w) = f w₁ * ∏ w ∈ Finset.univ.erase w₁, f w := by
          exact (Finset.mul_prod_erase Finset.univ f (Finset.mem_univ w₁)).symm
        have hfw₁ : f w₁ ≤ K_end * h := by
          dsimp [f]
          rw [if_pos rfl]
          exact mul_le_mul_of_nonneg_right (h_card_end w₁) hh_nonneg
        have h_erase_prod : (∏ w ∈ Finset.univ.erase w₁, f w) ≤ C_2 ^ r * (B + 1) ^ r := by
          have h_le1 : (∏ w ∈ Finset.univ.erase w₁, f w) ≤
              ∏ _w ∈ Finset.univ.erase w₁, (C_2 * (B + 1)) := by
            refine Finset.prod_le_prod (fun w _ => by dsimp [f]; positivity) (fun w hw => ?_)
            have hw_ne : w ≠ w₁ := Finset.ne_of_mem_erase hw
            dsimp [f]
            rw [if_neg hw_ne]
            exact h_card_full w
          rw [Finset.prod_const] at h_le1
          have h_one_le : 1 ≤ C_2 * (B + 1) := by
            have : 1 ≤ C_2 := by dsimp [C_2]; linarith [hM_K_pos, mul_pos hM_K_pos hC_L_pos]
            have : 1 ≤ B + 1 := by linarith [hB_pos]
            nlinarith
          have h_card_erase : (Finset.univ.erase w₁).card ≤ r := by
            calc (Finset.univ.erase w₁).card ≤ (Finset.univ : Finset ι).card := Finset.card_erase_le
              _ = r := hcard_ι
          have h_pow_le : (C_2 * (B + 1)) ^ (Finset.univ.erase w₁).card ≤ (C_2 * (B + 1)) ^ r :=
            pow_le_pow_right₀ h_one_le h_card_erase
          calc (∏ w ∈ Finset.univ.erase w₁, f w)
            _ ≤ (C_2 * (B + 1)) ^ (Finset.univ.erase w₁).card := h_le1
            _ ≤ (C_2 * (B + 1)) ^ r := h_pow_le
            _ = C_2 ^ r * (B + 1) ^ r := mul_pow C_2 (B + 1) r
        have h_erased_nonneg : 0 ≤ ∏ w ∈ Finset.univ.erase w₁, f w := by
          refine Finset.prod_nonneg (fun w _ => by dsimp [f]; positivity)
        calc ((Slab w₁).card : ℝ) * h ^ r
          _ = f w₁ * ∏ w ∈ Finset.univ.erase w₁, f w := by rw [h_prod_eq, h_erase]
          _ ≤ (K_end * h) * (C_2 ^ r * (B + 1) ^ r) :=
              mul_le_mul hfw₁ h_erase_prod h_erased_nonneg (by positivity)
          _ = K_end * C_2 ^ r * h * (B + 1) ^ r := by ring
      calc (S_collar.card : ℝ) * h ^ r
        _ ≤ (∑ w₁ : ι, ((Slab w₁).card : ℝ)) * h ^ r :=
            mul_le_mul_of_nonneg_right h_card_le (by positivity)
        _ = ∑ w₁ : ι, (((Slab w₁).card : ℝ) * h ^ r) := Finset.sum_mul _ _ _
        _ ≤ ∑ _w₁ : ι, (K_end * C_2 ^ r * h * (B + 1) ^ r) :=
            Finset.sum_le_sum (fun w₁ _ => h_slab_bound w₁)
        _ = (r : ℝ) * (K_end * C_2 ^ r * h * (B + 1) ^ r) := by
            rw [Finset.sum_const, hcard_ι, nsmul_eq_mul]
        _ = (r : ℝ) * K_end * C_2 ^ r * h * (B + 1) ^ r := by ring
    exact ⟨h_main_bound, h_collar_bound⟩
  refine ⟨S_main, S_collar, w_main, A_phase, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · dsimp [A_phase]
    positivity
  · have h_A_eq : A_phase = C_phase * δ * (B + 1) ^ r := by
      dsimp [A_phase, C_phase, h]
      ring
    have hC_phase_le : C_phase ≤ C_grid := by
      dsimp [C_grid]
      have : 0 ≤ C_2 ^ r + (r : ℝ) * K_end * C_2 ^ r := by positivity
      linarith
    rw [h_A_eq]
    have h1 : C_phase * δ ≤ C_grid * δ :=
      mul_le_mul_of_nonneg_right hC_phase_le (le_of_lt hδ_pos)
    exact mul_le_mul_of_nonneg_right h1 (by positivity)
  · intro p
    dsimp [w_main]
    have h_exp :
        2 * Real.pi * Complex.I * ∑ j : Fin r, (θ₀ j : ℂ) * (((p j : ℝ) * h : ℝ) : ℂ) =
        (((2 * Real.pi * ∑ j : Fin r, θ₀ j * ((p j : ℝ) * h)) : ℝ) : ℂ) * Complex.I := by
      push_cast
      ring
    rw [h_exp, Complex.norm_exp_ofReal_mul_I]
  · intro v
    let R₀ : ℝ := M_K * B
    have hR₀_nonneg : 0 ≤ R₀ := mul_nonneg hM_K_nonneg hB_nonneg
    let P_cell : (Fin r → ℤ) → Prop :=
      fun e => ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (v j + (e j : ℝ)) * L w j ∈ Set.Ioc (a w) (b w)
    have h_cell_bdd : ∀ e : Fin r → ℤ, P_cell e → ∀ j : Fin r, |v j + (e j : ℝ)| ≤ R₀ := by
      intro e he j
      have h_abs_le : ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          |∑ j₁ : Fin r, (v j₁ + (e j₁ : ℝ)) * L w j₁| ≤ B := by
        intro w hw
        rcases he w hw with ⟨h_gt_a, h_le_b⟩
        rcases hab_bounds w with ⟨ha_lo, _, hb_hi, _⟩
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      exact hM_K w₀ (fun j₁ => v j₁ + (e j₁ : ℝ)) B hB_nonneg h_abs_le j
    let I_shift : Fin r → Finset ℤ :=
      fun j => Finset.Icc (Int.floor (-v j - R₀)) (Int.floor (-v j + R₀))
    let E_box : Finset (Fin r → ℤ) := Fintype.piFinset I_shift
    let E_fin : Finset (Fin r → ℤ) := E_box.filter P_cell
    have hE_iff : ∀ e : Fin r → ℤ, e ∈ E_fin ↔ P_cell e := by
      intro e
      dsimp [E_fin]
      rw [Finset.mem_filter]
      refine ⟨fun h => h.2, fun he => ⟨?_, he⟩⟩
      dsimp [E_box, I_shift]
      rw [Fintype.mem_piFinset]
      intro j
      rw [Finset.mem_Icc]
      have h_abs := abs_le.mp (h_cell_bdd e he j)
      have h_lo : -v j - R₀ ≤ (e j : ℝ) := by linarith [h_abs.1]
      have h_hi : (e j : ℝ) ≤ -v j + R₀ := by linarith [h_abs.2]
      refine ⟨?_, Int.le_floor.mpr h_hi⟩
      exact Int.cast_le.mp (le_trans (Int.floor_le (-v j - R₀)) h_lo)
    have hE_card : (E_fin.card : ℝ) ≤ (2 * M_K + 2) ^ r * (B + 1) ^ r := by
      have h_sub : (E_fin.card : ℝ) ≤ (E_box.card : ℝ) := by
        exact_mod_cast Finset.card_le_card (Finset.filter_subset P_cell E_box)
      have h_box_card : (E_box.card : ℝ) = ∏ j : Fin r, ((I_shift j).card : ℝ) := by
        dsimp [E_box]
        rw [Fintype.card_piFinset, Nat.cast_prod]
      have h_I_le : ∀ j : Fin r, ((I_shift j).card : ℝ) ≤ (2 * M_K + 2) * (B + 1) := by
        intro j
        dsimp [I_shift]
        set a_j : ℤ := Int.floor (-v j - R₀)
        set b_j : ℤ := Int.floor (-v j + R₀)
        have hab : a_j ≤ b_j + 1 := by
          have h1 : a_j ≤ b_j := Int.floor_mono (by linarith)
          omega
        have h_card_int : ((Finset.Icc a_j b_j).card : ℤ) = b_j + 1 - a_j :=
          Int.card_Icc_of_le a_j b_j hab
        have h_card_real : ((Finset.Icc a_j b_j).card : ℝ) = (b_j : ℝ) + 1 - (a_j : ℝ) := by
          exact_mod_cast h_card_int
        have hb_le : (b_j : ℝ) ≤ -v j + R₀ := Int.floor_le (-v j + R₀)
        have ha_gt : -v j - R₀ < (a_j : ℝ) + 1 := Int.lt_floor_add_one (-v j - R₀)
        have h_prod_ge : 2 * R₀ + 2 ≤ (2 * M_K + 2) * (B + 1) := by
          dsimp [R₀]
          nlinarith
        linarith
      calc (E_fin.card : ℝ)
        _ ≤ (E_box.card : ℝ) := h_sub
        _ = ∏ j : Fin r, ((I_shift j).card : ℝ) := h_box_card
        _ ≤ ∏ _j : Fin r, ((2 * M_K + 2) * (B + 1)) := by
          refine Finset.prod_le_prod (fun j _ => Nat.cast_nonneg _) (fun j _ => h_I_le j)
        _ = ((2 * M_K + 2) * (B + 1)) ^ r := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        _ = (2 * M_K + 2) ^ r * (B + 1) ^ r := mul_pow _ _ _
    let ψ : (Fin r → ℤ) → ℂ := fun e =>
      Complex.exp
        (2 * Real.pi * Complex.I *
          ∑ j : Fin r, (θ₀ j : ℂ) * ((v j + (e j : ℝ) : ℝ) : ℂ))
    have hψ_norm : ∀ e : Fin r → ℤ, ‖ψ e‖ = 1 := by
      intro e
      dsimp [ψ]
      have h_exp :
          2 * Real.pi * Complex.I * ∑ j : Fin r, (θ₀ j : ℂ) * ((v j + (e j : ℝ) : ℝ) : ℂ) =
          (((2 * Real.pi * ∑ j : Fin r, θ₀ j * (v j + (e j : ℝ))) : ℝ) : ℂ) * Complex.I := by
        push_cast
        ring
      rw [h_exp, Complex.norm_exp_ofReal_mul_I]
    have h_tsum_eq :
        (∑' e : {e : Fin r → ℤ // P_cell e}, ψ e.1) = ∑ e ∈ E_fin, ψ e := by
      letI : Fintype {e : Fin r → ℤ // P_cell e} := Fintype.ofFinset E_fin hE_iff
      rw [tsum_fintype]
      exact (Finset.sum_subtype E_fin hE_iff ψ).symm
    have h_lip : ∀ (y y' : Fin r → ℝ), (∀ j : Fin r, |y j - y' j| ≤ h) →
        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          |(∑ j : Fin r, y j * L w j) - (∑ j : Fin r, y' j * L w j)| ≤ C_L * h := by
      intro y y' hy w hw
      have h_diff : (∑ j : Fin r, y j * L w j) - (∑ j : Fin r, y' j * L w j) =
          ∑ j : Fin r, (y j - y' j) * L w j := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
      rw [h_diff]
      calc |∑ j : Fin r, (y j - y' j) * L w j|
        _ ≤ ∑ j : Fin r, |(y j - y' j) * L w j| := Finset.abs_sum_le_sum_abs _ _
        _ = ∑ j : Fin r, |y j - y' j| * |L w j| :=
            Finset.sum_congr rfl (fun j _ => abs_mul _ _)
        _ ≤ ∑ j : Fin r, h * |L w j| :=
            Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_right (hy j) (abs_nonneg _))
        _ = h * ∑ j : Fin r, |L w j| := (Finset.mul_sum _ _ _).symm
        _ ≤ h * C_L := mul_le_mul_of_nonneg_left (hC_L w hw) hh_nonneg
        _ = C_L * h := mul_comm _ _
    let Phi : (Fin r → ℤ) → (Fin r → ℤ) → ℝ :=
      fun e p => ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h)
    let tildePhi : (Fin r → ℤ) → ℝ :=
      fun p => ∏ j : Fin r,
        max (0 : ℝ) (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)
    let e_star : (Fin r → ℤ) → (Fin r → ℤ) :=
      fun p j => -Int.floor (v j - (p j : ℝ) * h + 1 / 2)
    have hPhi_nonneg : ∀ e p : Fin r → ℤ, 0 ≤ Phi e p :=
      fun _ _ => Finset.prod_nonneg (fun _ _ => le_max_left 0 _)
    have htildePhi_nonneg : ∀ p : Fin r → ℤ, 0 ≤ tildePhi p :=
      fun _ => Finset.prod_nonneg (fun _ _ => le_max_left 0 _)
    have h_sum_E_le : ∀ p : Fin r → ℤ, ∑ e ∈ E_fin, Phi e p ≤ tildePhi p := by
      intro p
      have h_shift_eq : Phi (e_star p) p = tildePhi p := (h_shift_all v p).1
      by_cases he : e_star p ∈ E_fin
      · have h_eq : ∑ e ∈ E_fin, Phi e p = Phi (e_star p) p :=
          Finset.sum_eq_single (e_star p)
            (fun e _ hne => (h_shift_all v p).2.1 e hne)
            (fun hnot => False.elim (hnot he))
        rw [h_eq, h_shift_eq]
      · have h_zero : ∑ e ∈ E_fin, Phi e p = 0 := by
          refine Finset.sum_eq_zero (fun e he_mem => (h_shift_all v p).2.1 e (fun h_eq => ?_))
          change e = e_star p at h_eq
          rw [h_eq] at he_mem
          exact he he_mem
        rw [h_zero]
        exact htildePhi_nonneg p
    have h_main_eq : ∀ p ∈ S_main, tildePhi p = ∑ e ∈ E_fin, Phi e p := by
      intro p hp
      have h_shift_eq : Phi (e_star p) p = tildePhi p := (h_shift_all v p).1
      rw [← h_shift_eq]
      refine (Finset.sum_eq_single (e_star p)
        (fun e _ hne => (h_shift_all v p).2.1 e hne)
        (fun he_not => ?_)).symm
      by_contra h_ne
      have h_pos : 0 < Phi (e_star p) p :=
        lt_of_le_of_ne (hPhi_nonneg (e_star p) p) (Ne.symm h_ne)
      have h_dist : ∀ j : Fin r, |v j + (e_star p j : ℝ) - (p j : ℝ) * h| ≤ h :=
        (h_shift_all v p).2.2 (e_star p) h_pos
      have h_in_cell : P_cell (e_star p) := by
        intro w hw
        have hp_w := ((hS_main_iff p).mp hp).2 w hw
        rw [Set.mem_Ioc] at hp_w ⊢
        have h_w_lip := h_lip (fun j => v j + (e_star p j : ℝ)) (fun j => (p j : ℝ) * h) h_dist w hw
        have h_w_bounds := abs_le.mp h_w_lip
        constructor
        · linarith [hp_w.1, h_w_bounds.1]
        · linarith [hp_w.2, h_w_bounds.2]
      exact he_not ((hE_iff (e_star p)).mpr h_in_cell)
    have hS_main_sub : S_main ⊆ B_N := fun p hp => ((hS_main_iff p).mp hp).1
    have hS_outer_sub : S_outer ⊆ B_N := fun p hp => ((hS_outer_iff p).mp hp).1
    have h_e_outer : ∀ e ∈ E_fin, ∑ p ∈ S_outer, Phi e p = 1 := by
      intro e he
      have he_cell : P_cell e := (hE_iff e).mp he
      have he_bdd : ∀ j : Fin r, |v j + (e j : ℝ)| ≤ ((N : ℝ) - 1) * h :=
        fun j => le_trans (h_cell_bdd e he_cell j) hN_bound
      have h_pou_eq : ∑ p ∈ B_N, Phi e p = 1 :=
        (h_pou (fun j => v j + (e j : ℝ))).2 he_bdd
      rw [← h_pou_eq]
      refine Finset.sum_subset hS_outer_sub (fun p hp_box hp_not => ?_)
      by_contra h_ne
      have h_pos : 0 < Phi e p :=
        lt_of_le_of_ne (hPhi_nonneg e p) (Ne.symm h_ne)
      have h_dist : ∀ j : Fin r, |v j + (e j : ℝ) - (p j : ℝ) * h| ≤ h :=
        (h_shift_all v p).2.2 e h_pos
      have hp_outer : p ∈ S_outer := by
        refine (hS_outer_iff p).mpr ⟨hp_box, fun w hw => ?_⟩
        have he_w := he_cell w hw
        rw [Set.mem_Ioc] at he_w ⊢
        have h_w_lip := h_lip (fun j => v j + (e j : ℝ)) (fun j => (p j : ℝ) * h) h_dist w hw
        have h_w_bounds := abs_le.mp h_w_lip
        constructor
        · linarith [he_w.1, h_w_bounds.2]
        · linarith [he_w.2, h_w_bounds.1]
      exact hp_not hp_outer
    let T₁ : ℂ := ∑ e ∈ E_fin, ψ e
    let T₂ : ℂ := ∑ e ∈ E_fin, ∑ p ∈ S_main, (Phi e p : ℂ) * ψ e
    let T₃ : ℂ := ∑ e ∈ E_fin, ∑ p ∈ S_main, (Phi e p : ℂ) * w_main p
    let F_main : ℂ := ∑ p ∈ S_main, w_main p * (tildePhi p : ℂ)
    have h_stage1 : ‖T₁ - T₂‖ ≤ ∑ p ∈ S_collar, tildePhi p := by
      have h_e_diff : ∀ e ∈ E_fin,
          ψ e - (∑ p ∈ S_main, (Phi e p : ℂ) * ψ e) =
          ((∑ p ∈ S_collar, Phi e p : ℝ) : ℂ) * ψ e := by
        intro e he
        rw [← Finset.sum_mul, ← Complex.ofReal_sum]
        have h_col : (∑ p ∈ S_collar, Phi e p) = 1 - ∑ p ∈ S_main, Phi e p := by
          linarith [hS_collar_sum (Phi e), h_e_outer e he]
        rw [h_col, Complex.ofReal_sub, Complex.ofReal_one, sub_mul, one_mul]
      have h_e_diff_norm : ∀ e ∈ E_fin,
          ‖ψ e - (∑ p ∈ S_main, (Phi e p : ℂ) * ψ e)‖ = ∑ p ∈ S_collar, Phi e p := by
        intro e he
        rw [h_e_diff e he, norm_mul, hψ_norm e, mul_one, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (Finset.sum_nonneg (fun p _ => hPhi_nonneg e p))]
      dsimp [T₁, T₂]
      rw [← Finset.sum_sub_distrib]
      calc ‖∑ e ∈ E_fin, (ψ e - ∑ p ∈ S_main, (Phi e p : ℂ) * ψ e)‖
        _ ≤ ∑ e ∈ E_fin, ‖ψ e - ∑ p ∈ S_main, (Phi e p : ℂ) * ψ e‖ := norm_sum_le _ _
        _ = ∑ e ∈ E_fin, ∑ p ∈ S_collar, Phi e p :=
          Finset.sum_congr rfl (fun e he => h_e_diff_norm e he)
        _ = ∑ p ∈ S_collar, ∑ e ∈ E_fin, Phi e p := Finset.sum_comm
        _ ≤ ∑ p ∈ S_collar, tildePhi p :=
          Finset.sum_le_sum (fun p _ => h_sum_E_le p)
    have h_exp_diff : ∀ (e p : Fin r → ℤ),
        (∀ j : Fin r, |v j + (e j : ℝ) - (p j : ℝ) * h| ≤ h) →
        ‖ψ e - w_main p‖ ≤ 2 * Real.pi * (r : ℝ) * h := by
      intro e p h_dist
      set θ₁ : ℝ := 2 * Real.pi * ∑ j : Fin r, θ₀ j * (v j + (e j : ℝ))
      set θ₂ : ℝ := 2 * Real.pi * ∑ j : Fin r, θ₀ j * ((p j : ℝ) * h)
      have hψ_eq : ψ e = Complex.exp ((θ₁ : ℂ) * Complex.I) := by
        dsimp [ψ, θ₁]
        congr 1
        push_cast
        ring
      have hw_eq : w_main p = Complex.exp ((θ₂ : ℂ) * Complex.I) := by
        dsimp [w_main, θ₂]
        congr 1
        push_cast
        ring
      have h_factor :
          Complex.exp ((θ₁ : ℂ) * Complex.I) - Complex.exp ((θ₂ : ℂ) * Complex.I) =
          Complex.exp ((θ₂ : ℂ) * Complex.I) *
            (Complex.exp (Complex.I * ((θ₁ - θ₂ : ℝ) : ℂ)) - 1) := by
        rw [mul_sub, mul_one, ← Complex.exp_add]
        congr 1
        push_cast
        ring
      rw [hψ_eq, hw_eq, h_factor, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
      have h_exp_le : ‖Complex.exp (Complex.I * ((θ₁ - θ₂ : ℝ) : ℂ)) - 1‖ ≤ |θ₁ - θ₂| := by
        have h1 := @Real.norm_exp_I_mul_ofReal_sub_one_le (θ₁ - θ₂)
        rwa [Real.norm_eq_abs] at h1
      have h_θ_sub : θ₁ - θ₂ = 2 * Real.pi * ∑ j : Fin r, θ₀ j * (v j + (e j : ℝ) - (p j : ℝ) * h) := by
        dsimp [θ₁, θ₂]
        rw [← mul_sub, ← Finset.sum_sub_distrib]
        refine congrArg (2 * Real.pi * ·) (Finset.sum_congr rfl (fun j _ => by ring))
      have h2pi_nonneg : 0 ≤ 2 * Real.pi := by positivity
      have h_θ_le : |θ₁ - θ₂| ≤ 2 * Real.pi * (r : ℝ) * h := by
        rw [h_θ_sub, abs_mul, abs_of_nonneg h2pi_nonneg]
        have h_sum_le : |∑ j : Fin r, θ₀ j * (v j + (e j : ℝ) - (p j : ℝ) * h)| ≤ (r : ℝ) * h := by
          calc |∑ j : Fin r, θ₀ j * (v j + (e j : ℝ) - (p j : ℝ) * h)|
            _ ≤ ∑ j : Fin r, |θ₀ j * (v j + (e j : ℝ) - (p j : ℝ) * h)| :=
              Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ _j : Fin r, h := by
              refine Finset.sum_le_sum (fun j _ => ?_)
              rw [abs_mul, abs_of_nonneg (hθ₀ j).1]
              calc θ₀ j * |v j + (e j : ℝ) - (p j : ℝ) * h|
                _ ≤ 1 * h := mul_le_mul (hθ₀ j).2 (h_dist j) (abs_nonneg _) zero_le_one
                _ = h := one_mul h
            _ = (r : ℝ) * h := by
              rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        calc 2 * Real.pi * |∑ j : Fin r, θ₀ j * (v j + (e j : ℝ) - (p j : ℝ) * h)|
          _ ≤ 2 * Real.pi * ((r : ℝ) * h) := mul_le_mul_of_nonneg_left h_sum_le h2pi_nonneg
          _ = 2 * Real.pi * (r : ℝ) * h := by ring
      exact le_trans h_exp_le h_θ_le
    have h_stage2 : ‖T₂ - T₃‖ ≤ A_phase := by
      dsimp [T₂, T₃]
      rw [← Finset.sum_sub_distrib]
      simp_rw [← Finset.sum_sub_distrib, ← mul_sub]
      have h_2pirh_nonneg : 0 ≤ 2 * Real.pi * (r : ℝ) * h := by positivity
      calc ‖∑ e ∈ E_fin, ∑ p ∈ S_main, (Phi e p : ℂ) * (ψ e - w_main p)‖
        _ ≤ ∑ e ∈ E_fin, ‖∑ p ∈ S_main, (Phi e p : ℂ) * (ψ e - w_main p)‖ := norm_sum_le _ _
        _ ≤ ∑ _e ∈ E_fin, (2 * Real.pi * (r : ℝ) * h) := by
          refine Finset.sum_le_sum (fun e _he => ?_)
          calc ‖∑ p ∈ S_main, (Phi e p : ℂ) * (ψ e - w_main p)‖
            _ ≤ ∑ p ∈ S_main, ‖(Phi e p : ℂ) * (ψ e - w_main p)‖ := norm_sum_le _ _
            _ ≤ ∑ p ∈ S_main, Phi e p * (2 * Real.pi * (r : ℝ) * h) := by
              refine Finset.sum_le_sum (fun p _hp => ?_)
              by_cases hPhi_zero : Phi e p = 0
              · rw [hPhi_zero, Complex.ofReal_zero, zero_mul, norm_zero, zero_mul]
              · have hPhi_pos : 0 < Phi e p :=
                  lt_of_le_of_ne (hPhi_nonneg e p) (Ne.symm hPhi_zero)
                rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hPhi_nonneg e p)]
                exact mul_le_mul_of_nonneg_left
                  (h_exp_diff e p ((h_shift_all v p).2.2 e hPhi_pos))
                  (hPhi_nonneg e p)
            _ = (∑ p ∈ S_main, Phi e p) * (2 * Real.pi * (r : ℝ) * h) :=
              (Finset.sum_mul _ _ _).symm
            _ ≤ 1 * (2 * Real.pi * (r : ℝ) * h) := by
              have h_sub_le : ∑ p ∈ S_main, Phi e p ≤ 1 := by
                calc ∑ p ∈ S_main, Phi e p
                  _ ≤ ∑ p ∈ B_N, Phi e p :=
                    Finset.sum_le_sum_of_subset_of_nonneg hS_main_sub (fun p _ _ => hPhi_nonneg e p)
                  _ ≤ 1 := (h_pou (fun j => v j + (e j : ℝ))).1
              exact mul_le_mul_of_nonneg_right h_sub_le h_2pirh_nonneg
            _ = 2 * Real.pi * (r : ℝ) * h := one_mul _
        _ = (E_fin.card : ℝ) * (2 * Real.pi * (r : ℝ) * h) := by
          rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ((2 * M_K + 2) ^ r * (B + 1) ^ r) * (2 * Real.pi * (r : ℝ) * h) :=
          mul_le_mul_of_nonneg_right hE_card h_2pirh_nonneg
        _ = A_phase := by dsimp [A_phase]; ring
    have h_stage3 : T₃ = F_main := by
      dsimp [T₃, F_main]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun p hp => ?_)
      rw [← Finset.sum_mul, ← Complex.ofReal_sum, ← h_main_eq p hp, mul_comm]
    change ‖(∑' e : {e : Fin r → ℤ // P_cell e}, ψ e.1) - F_main‖ ≤
      A_phase + ∑ p ∈ S_collar, tildePhi p
    rw [h_tsum_eq]
    change ‖T₁ - F_main‖ ≤ A_phase + ∑ p ∈ S_collar, tildePhi p
    have h_ident : T₁ - F_main = (T₁ - T₂) + (T₂ - T₃) := by
      rw [h_stage3]
      ring
    rw [h_ident]
    have h_tri := norm_add_le (T₁ - T₂) (T₂ - T₃)
    linarith
  · have hC_2_le : C_2 ^ r ≤ C_grid := by
      dsimp [C_grid]
      have : 0 ≤ (r : ℝ) * K_end * C_2 ^ r + C_phase := by positivity
      linarith
    calc (S_main.card : ℝ) * h ^ r
      _ ≤ C_2 ^ r * (B + 1) ^ r := h_cards.1
      _ ≤ C_grid * (B + 1) ^ r :=
        mul_le_mul_of_nonneg_right hC_2_le (by positivity)
  · have h_coeff_le : (r : ℝ) * K_end * C_2 ^ r ≤ C_grid := by
      dsimp [C_grid]
      have : 0 ≤ C_2 ^ r + C_phase := by positivity
      linarith
    calc (S_collar.card : ℝ) * h ^ r
      _ ≤ (r : ℝ) * K_end * C_2 ^ r * h * (B + 1) ^ r := h_cards.2
      _ ≤ C_grid * δ * (B + 1) ^ r := by
        have h1 : (r : ℝ) * K_end * C_2 ^ r * h ≤ C_grid * δ :=
          mul_le_mul h_coeff_le hh_le_δ hh_nonneg (le_of_lt hC_grid_pos)
        exact mul_le_mul_of_nonneg_right h1 (by positivity)

theorem mitsui_unitLogCoord_phase_cell_trigPoly_approx {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ C_trig : ℝ, 0 < C_trig ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
                (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j ≤ 1) →
                ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
                  ∀ M : ℕ, 1 ≤ M →
                    ∃ (c_main c_collar : (Fin (NumberField.Units.rank K) → ℤ) → ℂ),
                      (∀ v : Fin (NumberField.Units.rank K) → ℝ,
                        ‖(∑' e : {e : Fin (NumberField.Units.rank K) → ℤ //
                            ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                              ∑ j : Fin (NumberField.Units.rank K),
                                (v j + (e j : ℝ)) *
                                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))},
                          Complex.exp
                            (2 * Real.pi * Complex.I *
                              ∑ j : Fin (NumberField.Units.rank K),
                                (θ₀ j : ℂ) * ((v j + (e.1 j : ℝ) : ℝ) : ℂ))) -
                          ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
                            c_main m_freq *
                              Complex.exp (2 * Real.pi * Complex.I *
                                ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)‖ ≤
                        (∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
                          c_collar m_freq *
                            Complex.exp (2 * Real.pi * Complex.I *
                              ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)).re +
                        C_trig * (Real.log X + 1) ^ (NumberField.Units.rank K) *
                          (δ ^ (2 * NumberField.Units.rank K))⁻¹ * (M : ℝ)⁻¹) ∧
                      ‖c_collar 0‖ ≤ C_trig * δ * (Real.log X + 1) ^ (NumberField.Units.rank K) ∧
