  have h_fiber_sum_le : ∀ pm ∈ (Finset.univ : Finset D_all),
      (∑ xpm ∈ Fiber pm, term_all (proj xpm)) ≤ B * term_all pm := by
    intro pm _
    have h_congr : (∑ xpm ∈ Fiber pm, term_all (proj xpm)) =
        ∑ _xpm ∈ Fiber pm, term_all pm := by
      refine Finset.sum_congr rfl (fun xpm hxpm => ?_)
      rw [(Finset.mem_filter.mp hxpm).2]
    rw [h_congr, Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right (h_fiber_card_le pm) (h_term_all_nonneg pm)
  change ‖∑' xpm : D_cell_ne, term_cell xpm‖ ≤ B * (∑' pm : D_all, term_all pm)
  rw [tsum_fintype, tsum_fintype]
  calc ‖∑ xpm : D_cell_ne, term_cell xpm‖
    _ ≤ ∑ xpm : D_cell_ne, ‖term_cell xpm‖ :=
      norm_sum_le _ _
    _ = ∑ xpm : D_cell_ne, term_all (proj xpm) :=
      Finset.sum_congr rfl (fun xpm _ => h_term_cell_norm xpm)
    _ = ∑ pm : D_all, ∑ xpm ∈ Fiber pm, term_all (proj xpm) :=
      (Finset.sum_fiberwise_of_maps_to (fun _ _ => Finset.mem_univ _)
        (fun xpm => term_all (proj xpm))).symm
    _ ≤ ∑ pm : D_all, (B * term_all pm) :=
      Finset.sum_le_sum h_fiber_sum_le
    _ = B * ∑ pm : D_all, term_all pm :=
      (Finset.mul_sum Finset.univ term_all B).symm

theorem mitsui_riesz_primePower_char_decoupled_log_cell_eq_zero_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (w₀ : NumberField.InfinitePlace K)
    (l : ℕ)
    (p : NumberField.InfinitePlace K → Fin l)
    (Z : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors : (∑' u : NumberField.Units.torsion K,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
          (u : (NumberField.RingOfIntegers K)ˣ)))) = 0 ∧
      ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
        w ((u : NumberField.RingOfIntegers K) : K) = 1) :
    (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
          (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
              Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q xpm.1)},
        ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
          ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
            Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)) = 0 :=
by
  have h_place (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K)
      (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K) :
      w (((v : NumberField.RingOfIntegers K) * x : NumberField.RingOfIntegers K) : K) = w (x : K) := by
    change w ((algebraMap (NumberField.RingOfIntegers K) K) ((v : NumberField.RingOfIntegers K) * x)) =
      w ((algebraMap (NumberField.RingOfIntegers K) K) x)
    rw [map_mul, map_mul, hψ_tors.2 v hv w, one_mul]
  let D := {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
        (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
            Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
              (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)}
  have h_mem (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K) (xpm : D) :
      1 ≤ xpm.1.2.2 ∧
      Ideal.span ({(v : NumberField.RingOfIntegers K) * xpm.1.1} : Set (NumberField.RingOfIntegers K)) =
        xpm.1.2.1.asIdeal ^ xpm.1.2.2 ∧
      (Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2 ≤ Z ∧
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w (((v : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K) /
            w₀ (((v : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
      IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * xpm.1.1)) := by
    refine ⟨xpm.2.1, ?_, xpm.2.2.2.1, ?_, ?_⟩
    · rw [Ideal.span_singleton_mul_left_unit v.isUnit xpm.1.1]
      exact xpm.2.2.1
    · intro w hw
      rw [h_place v hv xpm.1.1 w, h_place v hv xpm.1.1 w₀]
      exact xpm.2.2.2.2.1 w hw
    · rw [map_mul]
      exact IsUnit.mul (v.isUnit.map (Ideal.Quotient.mk q)) xpm.2.2.2.2.2
  let e (u : NumberField.Units.torsion K) : D ≃ D :=
    { toFun := fun xpm => ⟨((u.1 : NumberField.RingOfIntegers K) * xpm.1.1, xpm.1.2), h_mem u.1 u.2 xpm⟩
      invFun := fun xpm =>
        ⟨(((u.1⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1, xpm.1.2),
          h_mem u.1⁻¹ (Subgroup.inv_mem (NumberField.Units.torsion K) u.2) xpm⟩
      left_inv := fun xpm => Subtype.ext (Prod.ext (Units.inv_mul_cancel_left u.1 xpm.1.1) rfl)
      right_inv := fun xpm => Subtype.ext (Prod.ext (Units.mul_inv_cancel_left u.1 xpm.1.1) rfl) }
  let Φ : NumberField.Units.torsion K → ℂ := fun u =>
    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
      (u : (NumberField.RingOfIntegers K)ˣ)))
  let F : D → ℂ := fun xpm =>
    ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
      ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)
  have hF_eq (u : NumberField.Units.torsion K) (xpm : D) : F (e u xpm) = Φ u * F xpm := by
    have h_unit : (e u xpm).2.2.2.2.2.unit =
        Units.map (Ideal.Quotient.mk q).toMonoidHom (u : (NumberField.RingOfIntegers K)ˣ) *
          xpm.2.2.2.2.2.unit := by
      apply Units.ext
      change ((e u xpm).2.2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q) =
        (Units.map (Ideal.Quotient.mk q).toMonoidHom (u : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K ⧸ q) *
        (xpm.2.2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      change Ideal.Quotient.mk q (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1) =
        Ideal.Quotient.mk q ((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) *
          Ideal.Quotient.mk q xpm.1.1
      exact map_mul (Ideal.Quotient.mk q) ((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) xpm.1.1
    change ψ (Additive.ofMul (e u xpm).2.2.2.2.2.unit) *
        ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ) =
      Φ u * (ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
        ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ))
    rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, mul_assoc]
  set S : ℂ := ∑' xpm : D, F xpm
  have hS_eq (u : NumberField.Units.torsion K) : Φ u * S = S := by
    calc Φ u * S
      _ = ∑' xpm : D, Φ u * F xpm := (tsum_mul_left).symm
      _ = ∑' xpm : D, F (e u xpm) := by simp_rw [← hF_eq u]
      _ = S := Equiv.tsum_eq (e u) F
  have h_sum : (∑' u : NumberField.Units.torsion K, Φ u * S) =
      ∑' _u : NumberField.Units.torsion K, S :=
    tsum_congr hS_eq
  rw [tsum_mul_right, hψ_tors.1, zero_mul, tsum_const, nsmul_eq_mul] at h_sum
  have h_card_pos : 0 < Nat.card (NumberField.Units.torsion K) := Nat.card_pos
  have h_card_ne : (Nat.card (NumberField.Units.torsion K) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (ne_of_gt h_card_pos)
  rcases mul_eq_zero.mp h_sum.symm with h_abs | hS_zero
  · exact False.elim (h_card_ne h_abs)
  · exact hS_zero

theorem mitsui_riesz_primePower_char_decoupled_norm_dir_log_cell_torsion_avg_eq {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
