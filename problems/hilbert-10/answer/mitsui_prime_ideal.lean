        rw [h_split]
        have hw₀_mult_le : w₀.mult ≤ 2 := by
          rcases NumberField.InfinitePlace.isReal_or_isComplex w₀ with hw | hw
          · have h1 := NumberField.InfinitePlace.mult_isReal ⟨w₀, hw⟩
            change w₀.mult = 1 at h1
            omega
          · have h1 := NumberField.InfinitePlace.mult_isComplex ⟨w₀, hw⟩
            change w₀.mult = 2 at h1
            omega
        have hw₀_mult_ge : 1 ≤ w₀.mult := NumberField.InfinitePlace.mult_pos
        have h_w0_term : ((f w₀ ^ w₀.mult : NNReal) : ℝ) ≤ (1 + D) ^ 2 * Y ^ 2 := by
          rw [NNReal.coe_pow]
          have hfw0 : (f w₀ : ℝ) = Y + D := by simp [f]
          rw [hfw0]
          have hYD : Y + D ≤ (1 + D) * Y := by nlinarith
          have h1 : (Y + D) ^ w₀.mult ≤ ((1 + D) * Y) ^ w₀.mult :=
            pow_le_pow_left₀ (by positivity) hYD w₀.mult
          have h2 : ((1 + D) * Y) ^ w₀.mult ≤ ((1 + D) * Y) ^ 2 :=
            pow_le_pow_right₀ (by nlinarith) hw₀_mult_le
          calc (Y + D) ^ w₀.mult
