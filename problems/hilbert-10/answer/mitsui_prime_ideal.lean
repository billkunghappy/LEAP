            dsimp [g_exp]
            have h_z : (((j_max : ℕ) : ℝ) + 1 - (m : ℝ)) = 0 := by
              have h1 : ((j_max : ℕ) : ℝ) + 1 = (m : ℝ) := by exact_mod_cast h_jm
