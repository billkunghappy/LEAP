    dsimp [c_cone]; linarith
  have hc_sub_le : c_sub ≤ c_cone := by
    have : 0 ≤ c₁ + 2 * c_sub + A_cell + 1 / c' + 2 * c_cell := by positivity
    dsimp [c_cone]; linarith
