  linarith

theorem mitsui_prime_char_fundamentalCone_bound_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            ‖∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  NumberField.mixedEmbedding K (π : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                    X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
              ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_principalPrimePower_char_bound_of_units_eq_one (K := K) A hA
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K :=
    NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  have hW_ge_one : 1 ≤ W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  let c₁ : ℝ := W * (c₀ + c₂)
  have hc₁_pos : 0 < c₁ := by
    dsimp [c₁]
    positivity
  have hc₀_le : c₀ ≤ c₁ := by
    dsimp [c₁]
    nlinarith
  have hc₂_le : c₂ ≤ c₁ := by
    dsimp [c₁]
    nlinarith
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ hψ_units
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hexp₀ : Real.exp (-Real.sqrt (Real.log X) / c₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₀_pos hc₀_le
  have hexp₂ : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  rw [mitsui_prime_char_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals Y q ψ hψ_units,
    norm_mul, Complex.norm_natCast]
  set S₁ : ℂ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        ∃ h : p.asIdeal.IsPrincipal,
        (Ideal.absNorm p.asIdeal : ℝ) ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
      ψ (Additive.ofMul p.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)
  set S₂ : ℂ := ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧
        ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
        (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
      ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_tri : ‖S₁‖ ≤ ‖S₁ - S₂‖ + ‖S₂‖ := norm_le_norm_sub_add S₁ S₂
  have h_sub : ‖S₁ - S₂‖ ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀) :=
    le_trans (mitsui_principalPrimeIdeals_char_sub_primePower_le Y q hq ψ) (hc₀ X hX)
  have h_main : ‖S₂‖ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
    hc₂ X hX q hq hq_norm ψ hψ hψ_units
  have hterm₀ : c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀) ≤
      c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
    mul_le_mul_of_nonneg_left hexp₀ (by positivity)
  have hterm₂ : c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
    mul_le_mul_of_nonneg_left hexp₂ (by positivity)
  have hS₁_le : ‖S₁‖ ≤ (c₀ + c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    linarith
  calc W * ‖S₁‖
    _ ≤ W * ((c₀ + c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) :=
      mul_le_mul_of_nonneg_left hS₁_le (le_of_lt hW_pos)
    _ = c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
      dsimp [c₁]
      ring

theorem mitsui_archimedeanCoord_cell_trigPoly_approx_of_a0_lt {K : Type u} [Field K] [NumberField K] [DecidableEq (NumberField.InfinitePlace K)] :
    ∃ C_trig : ℝ, 0 < C_trig ∧
