          polarCoord.target.indicator (fun q => ENNReal.ofReal q.1 * D_col.indicator 1 (polarCoord.symm q)) q
        by_cases hr : 0 < q.1
        · by_cases he : q ∈ A_exact
          · by_cases hc : q ∈ A_cyl
