    rw [h_norm]
    exact le_trans (by norm_num : 2 ≤ 2 ^ 1) (Nat.pow_le_pow_right (by norm_num) h_card_pos)
  have hNI₂_ge_two : (2 : ℝ) ≤ (Ideal.absNorm I₂ : ℝ) := by
    exact_mod_cast hNI₂_ge_two_nat
  have hNI₂_gt_one : (1 : ℝ) < (Ideal.absNorm I₂ : ℝ) := by linarith
  have hlog_NI₂_pos : 0 < Real.log (Ideal.absNorm I₂ : ℝ) := Real.log_pos hNI₂_gt_one
  have hA_pos : (0 : ℝ) < (A : ℝ) := by
