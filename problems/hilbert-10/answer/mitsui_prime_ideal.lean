        dsimp [G, f_I] at hx
        rw [Finset.mem_sigma, Finset.mem_sigma] at hx
        rcases hx with ⟨_, hP_mem, hm_mem⟩
        rw [Multiset.mem_toFinset] at hP_mem
        rw [Finset.mem_Icc] at hm_mem
        have hI_ne : I.1 ≠ ⊥ := Ideal.absNorm_eq_zero_iff.not.mp (by rw [I.2]; exact hn)
        have hP_info := (Ideal.mem_normalizedFactors_iff hI_ne).mp hP_mem
        have hP_ne : P ≠ ⊥ := by
          intro hbot
          rw [hbot, le_bot_iff] at hP_info
          exact hI_ne hP_info.2
        let p : IsDedekindDomain.HeightOneSpectrum R := ⟨P, hP_info.1, hP_ne⟩
        have hp_as : p.asIdeal = P := rfl
        have hdvd : p.asIdeal ^ m ∣ I.1 :=
          (h_pow_dvd_iff I.1 hI_ne p m).mpr hm_mem.2
        rcases hdvd with ⟨J_val, hJ_mul⟩
        let d : ℕ := Ideal.absNorm p.asIdeal ^ m
        let e : ℕ := Ideal.absNorm J_val
        have hde : d * e = n := by
          dsimp [d, e]
          rw [← map_pow, ← map_mul, ← hJ_mul, I.2]
        let uv : ℕ × ℕ := (d, e)
        let pm : F d := ⟨(p, m), ⟨hm_mem.1, rfl⟩⟩
        let J : S e := ⟨J_val, rfl⟩
        refine ⟨⟨uv, (pm, J)⟩, ?_, ?_⟩
        · dsimp [H]
          rw [Finset.mem_sigma]
          refine ⟨Nat.mem_divisorsAntidiagonal.mpr ⟨hde, hn⟩, Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩⟩
        · refine Sigma.ext (Subtype.ext hJ_mul.symm) ?_
          exact heq_of_eq rfl
      · intro y _
        rfl
  have hm_sum : LSeriesSummable (fun n => (m_K n : ℂ)) s := by
    refine Summable.of_norm_bounded ha_sum.norm (fun n => ?_)
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_real, Real.norm_eq_abs, Complex.norm_natCast]
      exact hm_bound n
  have hζ_def : NumberField.dedekindZeta K = LSeries (fun n => (a_K n : ℂ)) := rfl
  have hζ_mul_one : NumberField.dedekindZeta K s * LSeries (fun n => (m_K n : ℂ)) s = 1 := by
    rw [hζ_def, ← LSeries_convolution' ha_sum hm_sum, hm_conv, LSeries_delta, Pi.one_apply]
  have hζ_ne : NumberField.dedekindZeta K s ≠ 0 := left_ne_zero_of_mul_eq_one hζ_mul_one
  refine ⟨hζ_ne, ?_⟩
  have h_abscissa : LSeries.abscissaOfAbsConv (fun n => (a_K n : ℂ)) ≤ ((1 : ℝ) : EReal) := by
    refine LSeries.abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun y hy => ?_)
    exact ha_summable_all (y : ℂ) (by simpa using hy)
  have hs_abs : LSeries.abscissaOfAbsConv (fun n => (a_K n : ℂ)) < (s.re : EReal) :=
    lt_of_le_of_lt h_abscissa (EReal.coe_lt_coe_iff.mpr hs)
  have h_deriv : deriv (NumberField.dedekindZeta K) s = -LSeries (LSeries.logMul (fun n => (a_K n : ℂ))) s := by
    rw [hζ_def, LSeries_deriv hs_abs]
  have h_mul : LSeries (fun n => (Λ_K n : ℂ)) s * NumberField.dedekindZeta K s =
      -deriv (NumberField.dedekindZeta K) s := by
    rw [h_deriv, hζ_def, ← LSeries_convolution' hΛ_sum ha_sum, h_conv_eq, neg_neg]
  exact (eq_div_iff hζ_ne).mpr h_mul

theorem mitsui_LSeries_primePowers_trig_nonneg_and_norm_le {K : Type u} [Field K] [NumberField K] :
    (∀ s : ℂ, 5 / 4 ≤ s.re →
      ‖LSeries (fun n =>
        ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) s‖ ≤
      ‖LSeries (fun n =>
        ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) (5 / 4 : ℂ)‖) ∧
    (∀ σ γ : ℝ, 1 < σ →
      0 ≤ 3 * (LSeries (fun n =>
          ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) (σ : ℂ)).re +
        4 * (LSeries (fun n =>
          ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) ((σ : ℂ) + (γ : ℂ) * Complex.I)).re +
        (LSeries (fun n =>
          ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) ((σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I)).re) :=
by
  classical
  let Λ_K : ℕ → ℝ := fun n =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have hΛ_nonneg : ∀ n : ℕ, 0 ≤ Λ_K n := by
    intro n
    dsimp [Λ_K]
    refine tsum_nonneg (fun pm => Real.log_nonneg ?_)
    have h2 := h_norm_ge_two pm.1.1
    exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal)
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤
        C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have hΛ_summable : ∀ s : ℂ, 1 < s.re → LSeriesSummable (fun n => (Λ_K n : ℂ)) s := by
    intro s hs
    let r : ℝ := (1 + s.re) / 2
    let δ : ℝ := (s.re - 1) / 4
    have hδ_pos : 0 < δ := by dsimp [δ]; linarith
    have hr_nonneg : 0 ≤ r := by dsimp [r]; linarith
    have hr_lt : r < s.re := by dsimp [r]; linarith
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
    have h_log_le_rpow : ∀ x : ℝ, 0 < x → Real.log x ≤ (1 / δ) * x ^ δ := by
      intro x hx
      have h1 : Real.log (x ^ δ) ≤ x ^ δ - 1 :=
        Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx δ)
      rw [Real.log_rpow hx] at h1
      have h2 : δ * Real.log x ≤ x ^ δ := by linarith
      rw [← le_div_iff₀' hδ_pos] at h2
      linarith [show x ^ δ / δ = (1 / δ) * x ^ δ by ring]
    have h_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, Λ_K k) ≤
          (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) * (N : ℝ) ^ r := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      have hN_pos : (0 : ℝ) < (N : ℝ) := lt_of_lt_of_le zero_lt_one hN_real
      let D_N := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 ≤ N}
      let F (k : ℕ) := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = k}
      let M : ℕ := ⌊Real.log (N : ℝ) / Real.log 2⌋₊
      let S_J := {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      have h_pm_bounds : ∀ pm : D_N,
          (Ideal.absNorm pm.1.1.asIdeal : ℝ) ≤ (N : ℝ) ∧
          pm.1.2 < M + 1 ∧
          Real.log (Ideal.absNorm pm.1.1.asIdeal) ≤ Real.log (N : ℝ) ∧
          1 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := by
        intro pm
        set k : ℕ := Ideal.absNorm pm.1.1.asIdeal
        set m : ℕ := pm.1.2
        have hm : 1 ≤ m := pm.2.1
        have h_pow : k ^ m ≤ N := pm.2.2
        have hk2 : 2 ≤ k := h_norm_ge_two pm.1.1
        have hm_ne : m ≠ 0 := by omega
        have hk_le_km : k ≤ k ^ m := Nat.le_self_pow hm_ne k
        have hk_le_N : k ≤ N := le_trans hk_le_km h_pow
        have hk_real : (k : ℝ) ≤ (N : ℝ) := by exact_mod_cast hk_le_N
        have h2m_le_km : 2 ^ m ≤ k ^ m := Nat.pow_le_pow_left hk2 m
        have h2m_real : (2 : ℝ) ^ m ≤ (N : ℝ) := by exact_mod_cast (le_trans h2m_le_km h_pow)
        have h_log_2m : Real.log ((2 : ℝ) ^ m) ≤ Real.log (N : ℝ) :=
          Real.log_le_log (by positivity) h2m_real
        rw [Real.log_pow] at h_log_2m
        have hm_le_div : (m : ℝ) ≤ Real.log (N : ℝ) / Real.log 2 :=
          (le_div_iff₀ hlog2_pos).mpr h_log_2m
        have hm_lt : m < M + 1 := Nat.lt_add_one_of_le (Nat.le_floor hm_le_div)
        have hk_pos : (0 : ℝ) < (k : ℝ) := by exact_mod_cast (by omega : 0 < k)
        have h_log_k : Real.log (k : ℝ) ≤ Real.log (N : ℝ) := Real.log_le_log hk_pos hk_real
        have h1_le_km : 1 ≤ k ^ m := le_trans (by omega : 1 ≤ k) hk_le_km
        exact ⟨hk_real, hm_lt, h_log_k, h1_le_km⟩
      let ψ : D_N → S_J × Fin (M + 1) := fun pm =>
        (⟨pm.1.1.asIdeal, (h_pm_bounds pm).1⟩, ⟨pm.1.2, (h_pm_bounds pm).2.1⟩)
      have hψ_inj : Function.Injective ψ := by
        intro a b hab
        have h1 : a.1.1.asIdeal = b.1.1.asIdeal := congrArg Subtype.val (Prod.ext_iff.mp hab).1
        have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
        exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
      haveI : Finite D_N := Finite.of_injective ψ hψ_inj
      letI : Fintype D_N := Fintype.ofFinite D_N
      let g : D_N → ℕ := fun pm => Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2
      let term : D_N → ℝ := fun pm => Real.log (Ideal.absNorm pm.1.1.asIdeal)
      have hg : ∀ pm ∈ (Finset.univ : Finset D_N), g pm ∈ Finset.Icc 1 N := by
        intro pm _
        rw [Finset.mem_Icc]
        exact ⟨(h_pm_bounds pm).2.2.2, pm.2.2⟩
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, Λ_K k) = ∑ pm : D_N, term pm := by
        rw [← Finset.sum_fiberwise_of_maps_to hg term]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        have hk_le_N : k ≤ N := (Finset.mem_Icc.mp hk).2
        let e_k : F k ≃ {pm : D_N // g pm = k} :=
          { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, by rw [pm.2.2]; exact hk_le_N⟩⟩, pm.2.2⟩
            invFun := fun q => ⟨q.1.1, ⟨q.1.2.1, q.2⟩⟩
            left_inv := fun pm => by apply Subtype.ext; rfl
            right_inv := fun q => by apply Subtype.ext; apply Subtype.ext; rfl }
        have h_sub : (∑ pm ∈ Finset.univ with g pm = k, term pm) =
            ∑' q : {pm : D_N // g pm = k}, term q.1 := by
          rw [tsum_fintype]
          exact Finset.sum_subtype (Finset.univ.filter (fun pm : D_N => g pm = k))
            (fun _ => by simp) term
        rw [h_sub]
        exact Equiv.tsum_eq e_k (fun q : {pm : D_N // g pm = k} => term q.1)
      have hcard_le : Nat.card D_N ≤ Nat.card S_J * (M + 1) := by
        calc Nat.card D_N
            ≤ Nat.card (S_J × Fin (M + 1)) := Nat.card_le_card_of_injective ψ hψ_inj
          _ = Nat.card S_J * Nat.card (Fin (M + 1)) := Nat.card_prod S_J (Fin (M + 1))
          _ = Nat.card S_J * (M + 1) := by rw [Nat.card_fin]
      have hcard_real : (Nat.card D_N : ℝ) ≤ (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) := by
        exact_mod_cast hcard_le
      have hlogN_nonneg : 0 ≤ Real.log (N : ℝ) := Real.log_nonneg hN_real
      have h_M_le : ((M + 1 : ℕ) : ℝ) ≤ ((1 / δ) / Real.log 2 + 1) * (N : ℝ) ^ δ := by
        have hM_floor : (M : ℝ) ≤ Real.log (N : ℝ) / Real.log 2 :=
          Nat.floor_le (div_nonneg hlogN_nonneg (le_of_lt hlog2_pos))
        have hlogδ := h_log_le_rpow (N : ℝ) hN_pos
        have h_div : Real.log (N : ℝ) / Real.log 2 ≤ ((1 / δ) / Real.log 2) * (N : ℝ) ^ δ := by
          calc Real.log (N : ℝ) / Real.log 2
              ≤ ((1 / δ) * (N : ℝ) ^ δ) / Real.log 2 :=
                div_le_div_of_nonneg_right hlogδ (le_of_lt hlog2_pos)
            _ = ((1 / δ) / Real.log 2) * (N : ℝ) ^ δ := by ring
        have h1_le : (1 : ℝ) ≤ (N : ℝ) ^ δ := Real.one_le_rpow hN_real (le_of_lt hδ_pos)
        push_cast
        linarith
      have hlogN_le : Real.log (N : ℝ) ≤ (1 / δ) * (N : ℝ) ^ δ := h_log_le_rpow (N : ℝ) hN_pos
      have hSJ_le : (Nat.card S_J : ℝ) ≤ C₁ * (N : ℝ) := hC₁ (N : ℝ) hN_real
      have h_rpow_combine : (N : ℝ) * (N : ℝ) ^ δ * (N : ℝ) ^ δ = (N : ℝ) ^ r := by
        have h1 : (N : ℝ) ^ δ * (N : ℝ) ^ δ = (N : ℝ) ^ (2 * δ) := by
          rw [← Real.rpow_add hN_pos]
          congr 1; ring
        have h2 : (N : ℝ) * (N : ℝ) ^ (2 * δ) = (N : ℝ) ^ (1 : ℝ) * (N : ℝ) ^ (2 * δ) := by
          rw [Real.rpow_one]
        rw [mul_assoc, h1, h2, ← Real.rpow_add hN_pos]
        congr 1
        dsimp [r, δ]; ring
      calc (∑ k ∈ Finset.Icc 1 N, Λ_K k)
          = ∑ pm : D_N, term pm := h_sum_eq
        _ ≤ ∑ _pm : D_N, Real.log (N : ℝ) :=
            Finset.sum_le_sum (fun pm _ => (h_pm_bounds pm).2.2.1)
        _ = (Nat.card D_N : ℝ) * Real.log (N : ℝ) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
        _ ≤ ((Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ)) * Real.log (N : ℝ) :=
            mul_le_mul_of_nonneg_right hcard_real hlogN_nonneg
        _ ≤ ((C₁ * (N : ℝ)) * (((1 / δ) / Real.log 2 + 1) * (N : ℝ) ^ δ)) *
              ((1 / δ) * (N : ℝ) ^ δ) := by
            refine mul_le_mul (mul_le_mul hSJ_le h_M_le (by positivity) (by positivity))
              hlogN_le hlogN_nonneg (by positivity)
        _ = (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) *
              ((N : ℝ) * (N : ℝ) ^ δ * (N : ℝ) ^ δ) := by ring
        _ = (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) * (N : ℝ) ^ r := by rw [h_rpow_combine]
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, Λ_K k) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ r) := by
      refine Asymptotics.IsBigO.of_bound (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, Λ_K k :=
        Finset.sum_nonneg (fun k _ => hΛ_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ r := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact h_sum_bound N hN
    exact LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO hΛ_nonneg hr_nonneg hr_lt
  have h_s2 : ∀ (s : ℂ) (σ₀ : ℝ), 1 < σ₀ → σ₀ ≤ s.re →
      ‖LSeries (fun n => (Λ_K n : ℂ)) s‖ ≤ ‖LSeries (fun n => (Λ_K n : ℂ)) (σ₀ : ℂ)‖ := by
    intro s σ₀ hσ₀ hs
    have hs_re : 1 < s.re := lt_of_lt_of_le hσ₀ hs
    have hσ₀_re : 1 < (σ₀ : ℂ).re := by simpa using hσ₀
    have h_sum_s : Summable (LSeries.term (fun n => (Λ_K n : ℂ)) s) := hΛ_summable s hs_re
    have h_sum_σ₀ : Summable (LSeries.term (fun n => (Λ_K n : ℂ)) (σ₀ : ℂ)) :=
      hΛ_summable (σ₀ : ℂ) hσ₀_re
    have h_term_le : ∀ n : ℕ,
        ‖LSeries.term (fun k => (Λ_K k : ℂ)) s n‖ ≤
          ‖LSeries.term (fun k => (Λ_K k : ℂ)) (σ₀ : ℂ) n‖ :=
      LSeries.norm_term_le_of_re_le_re (fun k => (Λ_K k : ℂ)) (by simpa using hs)
    have h_term_re : ∀ n : ℕ,
        ‖LSeries.term (fun k => (Λ_K k : ℂ)) (σ₀ : ℂ) n‖ =
          (LSeries.term (fun k => (Λ_K k : ℂ)) (σ₀ : ℂ) n).re := by
      intro n
      by_cases hn : n = 0
      · subst hn; simp [LSeries.term]
      · rw [LSeries.norm_term_eq, if_neg hn, LSeries.term_of_ne_zero hn]
        have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
        have h_cpow : (n : ℂ) ^ (σ₀ : ℂ) = (((n : ℝ) ^ σ₀ : ℝ) : ℂ) := by
          rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg]
        rw [h_cpow, ← Complex.ofReal_div, Complex.ofReal_re, Complex.norm_of_nonneg (hΛ_nonneg n),
          Complex.ofReal_re]
    calc ‖LSeries (fun n => (Λ_K n : ℂ)) s‖
        ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (Λ_K k : ℂ)) s n‖ :=
          norm_tsum_le_tsum_norm h_sum_s.norm
      _ ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (Λ_K k : ℂ)) (σ₀ : ℂ) n‖ :=
          h_sum_s.norm.tsum_le_tsum h_term_le h_sum_σ₀.norm
      _ = ∑' n : ℕ, (LSeries.term (fun k => (Λ_K k : ℂ)) (σ₀ : ℂ) n).re := by
          congr 1; ext n; exact h_term_re n
      _ = (LSeries (fun n => (Λ_K n : ℂ)) (σ₀ : ℂ)).re :=
          (Complex.re_tsum h_sum_σ₀).symm
      _ ≤ ‖LSeries (fun n => (Λ_K n : ℂ)) (σ₀ : ℂ)‖ :=
          le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
  refine ⟨?_, ?_⟩
  · intro s hs
    have h_cast : ((5 / 4 : ℝ) : ℂ) = (5 / 4 : ℂ) := by push_cast; ring
    rw [← h_cast]
    exact h_s2 s (5 / 4) (by norm_num) hs
  · intro σ γ hσ
    let f : ℕ → ℂ := fun n => (Λ_K n : ℂ)
    let s₀ : ℂ := (σ : ℂ)
    let s₁ : ℂ := (σ : ℂ) + (γ : ℂ) * Complex.I
    let s₂ : ℂ := (σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I
    have hs₀_re : s₀.re = σ := by simp [s₀]
    have hs₀_im : s₀.im = 0 := by simp [s₀]
    have hs₁_re : s₁.re = σ := by simp [s₁]
    have hs₁_im : s₁.im = γ := by simp [s₁]
    have hs₂_re : s₂.re = σ := by simp [s₂]
    have hs₂_im : s₂.im = 2 * γ := by simp [s₂]
    have hs₀ : 1 < s₀.re := by rw [hs₀_re]; exact hσ
    have hs₁ : 1 < s₁.re := by rw [hs₁_re]; exact hσ
    have hs₂ : 1 < s₂.re := by rw [hs₂_re]; exact hσ
    have h_sum₀ : Summable (LSeries.term f s₀) := hΛ_summable s₀ hs₀
    have h_sum₁ : Summable (LSeries.term f s₁) := hΛ_summable s₁ hs₁
    have h_sum₂ : Summable (LSeries.term f s₂) := hΛ_summable s₂ hs₂
    have h_re₀ : Summable (fun n => (LSeries.term f s₀ n).re) :=
      Complex.reCLM.summable h_sum₀
    have h_re₁ : Summable (fun n => (LSeries.term f s₁ n).re) :=
      Complex.reCLM.summable h_sum₁
    have h_re₂ : Summable (fun n => (LSeries.term f s₂ n).re) :=
      Complex.reCLM.summable h_sum₂
    have h_eq₀ : (LSeries f s₀).re = ∑' n : ℕ, (LSeries.term f s₀ n).re := by
      rw [LSeries, Complex.re_tsum h_sum₀]
    have h_eq₁ : (LSeries f s₁).re = ∑' n : ℕ, (LSeries.term f s₁ n).re := by
      rw [LSeries, Complex.re_tsum h_sum₁]
    have h_eq₂ : (LSeries f s₂).re = ∑' n : ℕ, (LSeries.term f s₂ n).re := by
      rw [LSeries, Complex.re_tsum h_sum₂]
    change 0 ≤ 3 * (LSeries f s₀).re + 4 * (LSeries f s₁).re + (LSeries f s₂).re
    rw [h_eq₀, h_eq₁, h_eq₂, ← tsum_mul_left, ← tsum_mul_left,
      ← Summable.tsum_add (h_re₀.mul_left 3) (h_re₁.mul_left 4),
      ← Summable.tsum_add ((h_re₀.mul_left 3).add (h_re₁.mul_left 4)) h_re₂]
    apply tsum_nonneg
    intro n
    rcases eq_or_ne n 0 with rfl | hn
    · simp [LSeries.term_zero]
    · have h_term_re : ∀ s : ℂ, (LSeries.term f s n).re =
          Λ_K n *
            (Real.exp (Real.log (n : ℝ) * (-s.re)) *
              Real.cos (Real.log (n : ℝ) * (-s.im))) := by
        intro s
        have hn_c : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
        dsimp [f]
        rw [LSeries.term_of_ne_zero hn, div_eq_mul_inv, ← Complex.cpow_neg,
          Complex.cpow_def_of_ne_zero hn_c, ← Complex.natCast_log,
          Complex.re_ofReal_mul, Complex.exp_re, Complex.re_ofReal_mul,
          Complex.im_ofReal_mul, Complex.neg_re, Complex.neg_im]
      rw [h_term_re s₀, h_term_re s₁, h_term_re s₂,
        hs₀_re, hs₀_im, hs₁_re, hs₁_im, hs₂_re, hs₂_im]
      set θ : ℝ := Real.log (n : ℝ) * (-γ)
      have hθ₀ : Real.log (n : ℝ) * (-0 : ℝ) = 0 := by ring
      have hθ₂ : Real.log (n : ℝ) * (-(2 * γ)) = 2 * θ := by dsimp [θ]; ring
      rw [hθ₀, hθ₂, Real.cos_zero, Real.cos_two_mul θ]
      have h_alg :
          3 * (Λ_K n * (Real.exp (Real.log (n : ℝ) * (-σ)) * 1)) +
          4 * (Λ_K n * (Real.exp (Real.log (n : ℝ) * (-σ)) * Real.cos θ)) +
          Λ_K n * (Real.exp (Real.log (n : ℝ) * (-σ)) * (2 * Real.cos θ ^ 2 - 1)) =
          Λ_K n * Real.exp (Real.log (n : ℝ) * (-σ)) *
            (2 * (1 + Real.cos θ) ^ 2) := by ring
      rw [h_alg]
      have hΛ : 0 ≤ Λ_K n := hΛ_nonneg n
      positivity

theorem mitsui_dedekindZeta_norm_le_of_re_ge {K : Type u} [Field K] [NumberField K]
    (s : ℂ) (σ₀ : ℝ) (hσ₀ : 1 < σ₀) (hs : σ₀ ≤ s.re) :
    ‖NumberField.dedekindZeta K s‖ ≤ ‖NumberField.dedekindZeta K (σ₀ : ℂ)‖ :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_summable_all : ∀ w : ℂ, 1 < w.re → LSeriesSummable (fun n => (a_K n : ℂ)) w := by
    intro w hw
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) = (Nat.card S_pos : ℝ) := by
        have h1 : (∑ _J : S_pos, (1 : ℝ)) = (Nat.card S_pos : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        rw [← h1, ← Finset.sum_fiberwise_of_maps_to hg (fun _ => (1 : ℝ))]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_Icc] at hk
        let e_k : S k ≃ {J : S_pos // g J = k} :=
          { toFun := fun I => ⟨⟨I.1, ⟨by rw [I.2]; exact hk.1, by rw [I.2]; exact hk.2⟩⟩, I.2⟩
            invFun := fun J => ⟨J.1.1, J.2⟩
            left_inv := fun _ => by apply Subtype.ext; rfl
            right_inv := fun _ => by apply Subtype.ext; apply Subtype.ext; rfl }
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]
        have h_card : ((Finset.univ.filter (fun J : S_pos => g J = k)).card : ℝ) =
            (Fintype.card {J : S_pos // g J = k} : ℝ) := by
          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ (1 : ℝ)) := by
      refine Asymptotics.IsBigO.of_bound C₁ ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ) :=
        Finset.sum_nonneg (fun k _ => ha_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ (1 : ℝ) := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact ha_sum_bound N hN
    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hw
    simpa [a_K, S] using h_sum_real
  have hζ_def : NumberField.dedekindZeta K = LSeries (fun n => (a_K n : ℂ)) := rfl
  rw [hζ_def]
  have hs_re : 1 < s.re := lt_of_lt_of_le hσ₀ hs
  have hσ₀_re : 1 < (σ₀ : ℂ).re := by simpa using hσ₀
  have h_sum_s : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := ha_summable_all s hs_re
  have h_sum_σ₀ : Summable (LSeries.term (fun n => (a_K n : ℂ)) (σ₀ : ℂ)) :=
    ha_summable_all (σ₀ : ℂ) hσ₀_re
  have h_term_le : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ ≤
        ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
    LSeries.norm_term_le_of_re_le_re (fun k => (a_K k : ℂ)) (by simpa using hs)
  have h_term_re : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ =
        (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, if_neg hn, LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : (n : ℂ) ^ (σ₀ : ℂ) = (((n : ℝ) ^ σ₀ : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg]
      have ha_cast : (a_K n : ℂ) = ((a_K n : ℝ) : ℂ) := (Complex.ofReal_natCast (a_K n)).symm
      rw [Complex.norm_natCast, ha_cast, h_cpow, ← Complex.ofReal_div, Complex.ofReal_re,
        Complex.ofReal_re]
  calc ‖LSeries (fun n => (a_K n : ℂ)) s‖
      ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ :=
        norm_tsum_le_tsum_norm h_sum_s.norm
    _ ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
        h_sum_s.norm.tsum_le_tsum h_term_le h_sum_σ₀.norm
    _ = ∑' n : ℕ, (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
        congr 1; ext n; exact h_term_re n
    _ = (LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)).re :=
        (Complex.re_tsum h_sum_σ₀).symm
    _ ≤ ‖LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)‖ :=
        le_trans (le_abs_self _) (Complex.abs_re_le_norm _)

theorem mitsui_archimedean_gamma_norm_eq_on_neg_half_re (r₁ r₂ : ℕ) (s : ℂ) (hs : s.re = -1 / 2) :
    0 < ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ ∧
    ‖(Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂‖ =
      (‖s‖ / (2 * Real.pi)) ^ (r₁ + 2 * r₂) *
        ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ :=
by
  have h_conj : starRingEnd ℂ s = -1 - s := by
    apply Complex.ext
    · simp [hs]; ring
    · simp
  have h_conj_half : starRingEnd ℂ (s / 2) = -1 / 2 - s / 2 := by
    rw [map_div₀, map_ofNat, h_conj]; ring
  have hs_norm_pos : 0 < ‖s‖ := by
    have h1 : |s.re| ≤ ‖s‖ := Complex.abs_re_le_norm s
    rw [hs, abs_of_neg (by norm_num)] at h1
    linarith
  have hs_ne : s ≠ 0 := norm_pos_iff.mp hs_norm_pos
  have h_conj_s_ne : starRingEnd ℂ s ≠ 0 := by
    rw [map_ne_zero]
    exact hs_ne
  have h_conj_half_ne : starRingEnd ℂ (s / 2) ≠ 0 := by
    rw [map_ne_zero]
    exact div_ne_zero hs_ne two_ne_zero
  
  have h_shift_half : (1 - s) / 2 = starRingEnd ℂ (s / 2) + 1 := by
    rw [h_conj_half]; ring
  have h_gamma_half : Complex.Gamma ((1 - s) / 2) =
      starRingEnd ℂ (s / 2) * starRingEnd ℂ (Complex.Gamma (s / 2)) := by
    rw [h_shift_half, Complex.Gamma_add_one _ h_conj_half_ne, Complex.Gamma_conj]
  have h_norm_gamma_half : ‖Complex.Gamma ((1 - s) / 2)‖ = (‖s‖ / 2) * ‖Complex.Gamma (s / 2)‖ := by
    rw [h_gamma_half, norm_mul, RingHomIsometric.norm_map, RingHomIsometric.norm_map,
      norm_div, Complex.norm_ofNat]
  have h_re_1s_half : 0 < ((1 - s) / 2).re := by
    rw [Complex.div_ofNat_re, Complex.sub_re, Complex.one_re, hs]; norm_num
  have h_gamma_1s_half_pos : 0 < ‖Complex.Gamma ((1 - s) / 2)‖ :=
    norm_pos_iff.mpr (Complex.Gamma_ne_zero_of_re_pos h_re_1s_half)
  have h_gamma_s_half_pos : 0 < ‖Complex.Gamma (s / 2)‖ := by
    by_contra h_le
    push_neg at h_le
    have h_zero : ‖Complex.Gamma (s / 2)‖ = 0 := le_antisymm h_le (norm_nonneg _)
    rw [h_zero, mul_zero] at h_norm_gamma_half
    linarith
  
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_norm_GammaR_s : ‖Complex.Gammaℝ s‖ = Real.pi ^ (1 / 4 : ℝ) * ‖Complex.Gamma (s / 2)‖ := by
    rw [Complex.Gammaℝ_def, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos]
    have h_re : (-s / 2).re = 1 / 4 := by
      rw [Complex.div_ofNat_re, Complex.neg_re, hs]; ring
    rw [h_re]
  have h_GammaR_s_pos : 0 < ‖Complex.Gammaℝ s‖ := by
    rw [h_norm_GammaR_s]
    positivity
  have h_norm_GammaR_1s : ‖Complex.Gammaℝ (1 - s)‖ = (‖s‖ / (2 * Real.pi)) * ‖Complex.Gammaℝ s‖ := by
    rw [Complex.Gammaℝ_def, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos]
    have h_re : (-(1 - s) / 2).re = -3 / 4 := by
      rw [Complex.div_ofNat_re, Complex.neg_re, Complex.sub_re, Complex.one_re, hs]; ring
    have h_rpow : Real.pi ^ (-3 / 4 : ℝ) = Real.pi⁻¹ * Real.pi ^ (1 / 4 : ℝ) := by
      have h_add : (-3 / 4 : ℝ) = -1 + 1 / 4 := by ring
      rw [h_add, Real.rpow_add h_pi_pos, Real.rpow_neg_one]
    rw [h_re, h_rpow, h_norm_gamma_half, h_norm_GammaR_s]
    ring
  
  have h_shift_one : starRingEnd ℂ s + 1 = -s := by
    rw [h_conj]; ring
  have h_shift_two : 1 - s = (starRingEnd ℂ s + 1) + 1 := by
    rw [h_conj]; ring
  have h_neg_s_ne : starRingEnd ℂ s + 1 ≠ 0 := by
    rw [h_shift_one, neg_ne_zero]; exact hs_ne
  have h_gamma_full : Complex.Gamma (1 - s) =
      (-s) * (starRingEnd ℂ s * starRingEnd ℂ (Complex.Gamma s)) := by
    rw [h_shift_two, Complex.Gamma_add_one _ h_neg_s_ne, Complex.Gamma_add_one _ h_conj_s_ne,
      Complex.Gamma_conj, h_shift_one]
  have h_norm_gamma_full : ‖Complex.Gamma (1 - s)‖ = ‖s‖ ^ 2 * ‖Complex.Gamma s‖ := by
    rw [h_gamma_full, norm_mul, norm_mul, norm_neg, RingHomIsometric.norm_map,
      RingHomIsometric.norm_map]
    ring
  have h_re_1s : 0 < (1 - s).re := by
    rw [Complex.sub_re, Complex.one_re, hs]; norm_num
  have h_gamma_1s_pos : 0 < ‖Complex.Gamma (1 - s)‖ :=
    norm_pos_iff.mpr (Complex.Gamma_ne_zero_of_re_pos h_re_1s)
  have h_gamma_s_pos : 0 < ‖Complex.Gamma s‖ := by
    by_contra h_le
    push_neg at h_le
    have h_zero : ‖Complex.Gamma s‖ = 0 := le_antisymm h_le (norm_nonneg _)
    rw [h_zero, mul_zero] at h_norm_gamma_full
    linarith
  
  have h_2pi_pos : 0 < 2 * Real.pi := by positivity
  have h_2pi_cast : (2 : ℂ) * (Real.pi : ℂ) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
  have h_norm_GammaC_s : ‖Complex.Gammaℂ s‖ = 2 * (2 * Real.pi) ^ (1 / 2 : ℝ) * ‖Complex.Gamma s‖ := by
    rw [Complex.Gammaℂ_def, h_2pi_cast, norm_mul, norm_mul, Complex.norm_ofNat,
      Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos]
    have h_re : (-s).re = 1 / 2 := by rw [Complex.neg_re, hs]; ring
    rw [h_re]
  have h_GammaC_s_pos : 0 < ‖Complex.Gammaℂ s‖ := by
    rw [h_norm_GammaC_s]
    positivity
  have h_norm_GammaC_1s : ‖Complex.Gammaℂ (1 - s)‖ = (‖s‖ / (2 * Real.pi)) ^ 2 * ‖Complex.Gammaℂ s‖ := by
    rw [Complex.Gammaℂ_def, h_2pi_cast, norm_mul, norm_mul, Complex.norm_ofNat,
      Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos]
    have h_re : (-(1 - s)).re = -3 / 2 := by
      rw [Complex.neg_re, Complex.sub_re, Complex.one_re, hs]; ring
    have h_rpow : (2 * Real.pi) ^ (-3 / 2 : ℝ) = (2 * Real.pi) ^ (-2 : ℤ) * (2 * Real.pi) ^ (1 / 2 : ℝ) := by
      have h_add : (-3 / 2 : ℝ) = (-2 : ℝ) + 1 / 2 := by ring
      rw [h_add, Real.rpow_add h_2pi_pos]
      norm_cast
    rw [h_re, h_rpow, zpow_neg, zpow_two, h_norm_gamma_full, h_norm_GammaC_s]
    ring
  refine ⟨?_, ?_⟩
  · rw [norm_mul, norm_pow, norm_pow]
    positivity
  · rw [norm_mul, norm_pow, norm_pow, h_norm_GammaR_1s, h_norm_GammaC_1s,
      norm_mul, norm_pow, norm_pow]
    rw [mul_pow, mul_pow, pow_add, pow_mul]
    ring

theorem mitsui_unitRank_gaussian_integrable {K : Type u} [Field K] [NumberField K]
    (b : ℝ) (hb : 0 < b) :
    MeasureTheory.Integrable
      (fun y : Fin (NumberField.Units.rank K) → ℝ =>
        Real.exp (-b *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)))
      MeasureTheory.volume :=
by
  classical
  let r : ℕ := NumberField.Units.rank K
  let ε : Fin r → (NumberField.RingOfIntegers K)ˣ := NumberField.Units.fundSystem K
  let w₀ : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  let S := {w : NumberField.InfinitePlace K // w ≠ w₀}
  let e : Fin r ≃ S := NumberField.Units.equivFinRank K
  let Q_K : (Fin r → ℝ) → ℝ := fun y =>
    ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ∏ i : Fin r,
        (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
  let L : NumberField.InfinitePlace K → (Fin r → ℝ) → ℝ := fun w y =>
    ∑ i : Fin r, y i * ((w.mult : ℝ) * Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)))
  have hw_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : NumberField.RingOfIntegers K) : K) := by
    intro w i
    exact w.pos_iff.mpr (ZeroMemClass.coe_eq_zero.not.mpr (Units.ne_zero (ε i)))
  have hQ_nn : ∀ y : Fin r → ℝ, 0 ≤ Q_K y := by
    intro y
    refine Finset.sum_nonneg (fun w _ => ?_)
    exact mul_nonneg (Nat.cast_nonneg _)
      (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_pos w i)) _))
  have hL_le : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      L w y ≤ (1 / 2 : ℝ) * Q_K y := by
    intro w y
    have h_single : (w.mult : ℝ) * ∏ i : Fin r,
        (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) ≤ Q_K y := by
      refine Finset.single_le_sum (f := fun w' : NumberField.InfinitePlace K =>
        (w'.mult : ℝ) * ∏ i : Fin r, (w' ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i))
        (fun w' _ => ?_) (Finset.mem_univ w)
      exact mul_nonneg (Nat.cast_nonneg _)
        (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_pos w' i)) _))
    have h_prod_eq : (∏ i : Fin r, (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)) =
        Real.exp (∑ i : Fin r, Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) * (2 * y i)) := by
      rw [Real.exp_sum]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      exact Real.rpow_def_of_pos (hw_pos w i) (2 * y i)
    have h_exp : ∑ i : Fin r, Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) * (2 * y i) ≤
        ∏ i : Fin r, (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) := by
      rw [h_prod_eq]
      linarith [Real.add_one_le_exp (∑ i : Fin r, Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) * (2 * y i))]
    have h_mul : (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) * (2 * y i)) ≤
        (w.mult : ℝ) * ∏ i : Fin r, (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i) :=
      mul_le_mul_of_nonneg_left h_exp (Nat.cast_nonneg _)
    have h_2L : 2 * L w y = (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) * (2 * y i)) := by
      dsimp [L]
      rw [Finset.mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      ring
    linarith
  have hL_sum_zero : ∀ y : Fin r → ℝ, ∑ w : NumberField.InfinitePlace K, L w y = 0 := by
    intro y
    dsimp [L]
    rw [Finset.sum_comm]
    have h_inner : ∀ i : Fin r,
        ∑ w : NumberField.InfinitePlace K, y i * ((w.mult : ℝ) * Real.log (w ((ε i : NumberField.RingOfIntegers K) : K))) = 0 := by
      intro i
      rw [← Finset.mul_sum]
      have h_log_sum : ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) = 0 := by
        have h_eq : ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * Real.log (w ((ε i : NumberField.RingOfIntegers K) : K)) =
            Real.log (∏ w : NumberField.InfinitePlace K, (w ((ε i : NumberField.RingOfIntegers K) : K)) ^ w.mult) := by
          rw [Real.log_prod (fun w _ => pow_ne_zero w.mult (ne_of_gt (hw_pos w i)))]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          rw [Real.log_pow]
        rw [h_eq, NumberField.InfinitePlace.prod_eq_abs_norm]
        have h_norm := NumberField.Units.norm K (ε i)
        have h_cast : |(Algebra.norm ℚ (((ε i : NumberField.RingOfIntegers K) : K)))| = 1 := h_norm
        rw [h_cast, Rat.cast_one, Real.log_one]
      rw [h_log_sum, mul_zero]
    simp [h_inner]
  have hL_abs_le : ∀ (w' : S) (y : Fin r → ℝ),
      |L w'.1 y| ≤ ((r : ℝ) + 1) / 2 * Q_K y := by
    intro w' y
    have h_split := Fintype.sum_eq_add_sum_subtype_ne (fun w => L w y) w₀
    rw [hL_sum_zero y] at h_split
    have h_w0 := hL_le w₀ y
    have h_neg_sum : - ∑ w : S, L w.1 y ≤ (1 / 2 : ℝ) * Q_K y := by linarith
    have h_erase := Finset.add_sum_erase Finset.univ (fun w : S => L w.1 y) (Finset.mem_univ w')
    have h_erase_le : ∑ w ∈ Finset.univ.erase w', L w.1 y ≤ (r : ℝ) * ((1 / 2 : ℝ) * Q_K y) := by
      have h1 : ∑ w ∈ Finset.univ.erase w', L w.1 y ≤
          (Finset.univ.erase w').card • ((1 / 2 : ℝ) * Q_K y) :=
        Finset.sum_le_card_nsmul (Finset.univ.erase w') (fun w : S => L w.1 y) ((1 / 2 : ℝ) * Q_K y)
          (fun w _ => hL_le w.1 y)
      rw [nsmul_eq_mul] at h1
      have h_card : (Finset.univ.erase w').card ≤ r := by
        have h2 : (Finset.univ.erase w').card ≤ (Finset.univ : Finset S).card := Finset.card_erase_le
        have h3 : (Finset.univ : Finset S).card = r := by
          rw [Finset.card_univ, Fintype.card_congr e.symm, Fintype.card_fin]
        omega
      have h_card_r : ((Finset.univ.erase w').card : ℝ) ≤ (r : ℝ) := by exact_mod_cast h_card
      exact le_trans h1 (mul_le_mul_of_nonneg_right h_card_r (by linarith [hQ_nn y]))
    have h_upper : L w'.1 y ≤ ((r : ℝ) + 1) / 2 * Q_K y := by
      have h1 := hL_le w'.1 y
      have hr : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
      have hQ := hQ_nn y
      nlinarith
    have h_lower : -(((r : ℝ) + 1) / 2 * Q_K y) ≤ L w'.1 y := by
      change L w'.1 y + ∑ w ∈ Finset.univ.erase w', L w.1 y = ∑ w : S, L w.1 y at h_erase
      linarith
    exact abs_le.mpr ⟨h_lower, h_upper⟩
  let A : Matrix S S ℝ := Matrix.of fun w₁ w₂ =>
    (w₂.1.mult : ℝ) * Real.log (w₂.1 ((ε (e.symm w₁) : NumberField.RingOfIntegers K) : K))
  have hA_det : |A.det| = NumberField.Units.regulator K :=
    (NumberField.Units.regulator_eq_det K w₀ e.symm).symm
  have hA_pos : 0 < |A.det| := by
    rw [hA_det]
    exact NumberField.Units.regulator_pos K
  have hA_unit : IsUnit A.det := isUnit_iff_ne_zero.mpr (abs_pos.mp hA_pos)
  have hy_eq : ∀ (y : Fin r → ℝ) (i : Fin r),
      y i = ∑ w : S, L w.1 y * A⁻¹ w (e i) := by
    intro y i
    let x : S → ℝ := fun w₁ => y (e.symm w₁)
    have hxA : Matrix.vecMul x A = fun w₂ : S => L w₂.1 y := by
      ext w₂
      dsimp [Matrix.vecMul, dotProduct, x, A, L]
      exact e.symm.sum_comp (fun j => y j * ((w₂.1.mult : ℝ) * Real.log (w₂.1 ((ε j : NumberField.RingOfIntegers K) : K))))
    have hx_inv : Matrix.vecMul (Matrix.vecMul x A) A⁻¹ = x := by
      rw [Matrix.vecMul_vecMul, Matrix.mul_nonsing_inv A hA_unit, Matrix.vecMul_one]
    have h_eval := congr_fun hx_inv (e i)
    rw [hxA] at h_eval
    dsimp [Matrix.vecMul, dotProduct, x] at h_eval
    rw [e.symm_apply_apply] at h_eval
    exact h_eval.symm
  let B_K : ℝ := 1 + ∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)|
  have hBK_pos : 0 < B_K := by
    have : 0 ≤ ∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)| :=
      Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun w _ => abs_nonneg _))
    dsimp [B_K]
    linarith
  have hr1_pos : 0 < ((r : ℝ) + 1) / 2 := by positivity
  let c₀ : ℝ := (B_K * (((r : ℝ) + 1) / 2))⁻¹
  have hc₀_pos : 0 < c₀ := by dsimp [c₀]; positivity
  have hQ_ge : ∀ y : Fin r → ℝ, c₀ * (∑ i : Fin r, |y i|) ≤ Q_K y := by
    intro y
    have hy_abs : ∀ i : Fin r, |y i| ≤ (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
      intro i
      rw [hy_eq y i]
      calc |∑ w : S, L w.1 y * A⁻¹ w (e i)|
          ≤ ∑ w : S, |L w.1 y * A⁻¹ w (e i)| := Finset.abs_sum_le_sum_abs _ _
        _ = ∑ w : S, |L w.1 y| * |A⁻¹ w (e i)| := by
            refine Finset.sum_congr rfl (fun w _ => abs_mul _ _)
        _ ≤ ∑ w : S, (((r : ℝ) + 1) / 2 * Q_K y) * |A⁻¹ w (e i)| := by
            refine Finset.sum_le_sum (fun w _ => ?_)
            exact mul_le_mul_of_nonneg_right (hL_abs_le w y) (abs_nonneg _)
        _ = (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun w _ => mul_comm _ _)
    have h_sum_y : ∑ i : Fin r, |y i| ≤ (B_K * (((r : ℝ) + 1) / 2)) * Q_K y := by
      calc ∑ i : Fin r, |y i|
          ≤ ∑ i : Fin r, (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) :=
            Finset.sum_le_sum (fun i _ => hy_abs i)
        _ = (∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
            rw [← Finset.sum_mul]
        _ ≤ B_K * (((r : ℝ) + 1) / 2 * Q_K y) := by
            refine mul_le_mul_of_nonneg_right ?_ (by positivity [hQ_nn y])
            dsimp [B_K]
            linarith
        _ = (B_K * (((r : ℝ) + 1) / 2)) * Q_K y := by ring
    dsimp [c₀]
    rw [inv_mul_le_iff₀ (mul_pos hBK_pos hr1_pos)]
    exact h_sum_y
  let c : ℝ := b * c₀
  have hc_pos : 0 < c := mul_pos hb hc₀_pos
  have h_iic : MeasureTheory.IntegrableOn (fun t : ℝ => Real.exp (-c * |t|)) (Set.Iic 0) MeasureTheory.volume := by
    refine (integrableOn_exp_mul_Iic hc_pos 0).congr_fun (fun t ht => ?_) measurableSet_Iic
    rw [abs_of_nonpos (Set.mem_Iic.mp ht)]
    ring_nf
  have h_ioi : MeasureTheory.IntegrableOn (fun t : ℝ => Real.exp (-c * |t|)) (Set.Ioi 0) MeasureTheory.volume := by
    refine (integrableOn_exp_mul_Ioi (neg_lt_zero.mpr hc_pos) 0).congr_fun (fun t ht => ?_) measurableSet_Ioi
    rw [abs_of_pos (Set.mem_Ioi.mp ht)]
  have h_1d : MeasureTheory.Integrable (fun t : ℝ => Real.exp (-c * |t|)) MeasureTheory.volume := by
    rw [← MeasureTheory.integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact h_iic.union h_ioi
  have h_prod : MeasureTheory.Integrable (fun y : Fin r → ℝ => ∏ i : Fin r, Real.exp (-c * |y i|)) MeasureTheory.volume :=
    MeasureTheory.Integrable.fintype_prod (f := fun (_ : Fin r) (t : ℝ) => Real.exp (-c * |t|))
      (μ := fun _ => MeasureTheory.volume) (fun _ => h_1d)
  have h_dom : MeasureTheory.Integrable
      (fun y : Fin r → ℝ => Real.exp (-c * ∑ i : Fin r, |y i|))
      MeasureTheory.volume := by
    refine h_prod.congr (Filter.Eventually.of_forall (fun y => ?_))
    dsimp
    rw [← Real.exp_sum, ← Finset.mul_sum]
  have h_meas : Measurable (fun y : Fin r → ℝ => Real.exp (-b * Q_K y)) := by
    refine Real.measurable_exp.comp (measurable_const.mul ?_)
    refine Finset.measurable_sum Finset.univ (fun w _ => ?_)
    refine measurable_const.mul (Finset.measurable_prod Finset.univ (fun i _ => ?_))
    exact measurable_const.pow (measurable_const.mul (measurable_pi_apply i))
  refine h_dom.mono' h_meas.aestronglyMeasurable (Filter.Eventually.of_forall (fun y => ?_))
  rw [Real.norm_of_nonneg (Real.exp_nonneg _), Real.exp_le_exp]
  have h1 : b * (c₀ * ∑ i : Fin r, |y i|) ≤ b * Q_K y :=
    mul_le_mul_of_nonneg_left (hQ_ge y) (le_of_lt hb)
  dsimp [c]
  linarith

theorem mitsui_unitRank_archimedean_mellin_eq_prod_places {K : Type u} [Field K] [NumberField K] :
    let J_K : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        Real.exp (-a *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i))
    ∀ s : ℂ, 1 < s.re →
      MeasureTheory.IntegrableOn
        (fun τ : ℝ => τ ^ s.re *
          ((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
            NumberField.Units.regulator K * τ⁻¹ *
            J_K (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ)))))
        (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
      (∫ τ in Set.Ioi (0 : ℝ),
        (τ : ℂ) ^ s *
          (((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
            NumberField.Units.regulator K * τ⁻¹ *
            J_K (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ))) : ℝ) : ℂ)) =
        ∏ w : NumberField.InfinitePlace K,
          (∫ v in Set.Ioi (0 : ℝ),
            (v : ℂ) ^ s *
              ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) :=
by
  classical
  intro J_K s hs
  have h_s1 : ∀ (c : ℝ), 0 < c → ∀ (f_re : ℝ → ℝ) (f_c : ℝ → ℂ),
      (MeasureTheory.IntegrableOn (fun τ : ℝ => τ⁻¹ * f_re τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ↔
        MeasureTheory.Integrable (fun u : ℝ => c * f_re (Real.exp (c * u))) MeasureTheory.volume) ∧
      (∫ τ in Set.Ioi (0 : ℝ), ((τ⁻¹ : ℝ) : ℂ) * f_c τ) =
        ∫ u : ℝ, (c : ℂ) * f_c (Real.exp (c * u)) := by
    intro c hc f_re f_c
    let ϕ : ℝ → ℝ := fun u => Real.exp (c * u)
    let ϕ' : ℝ → ℝ := fun u => c * Real.exp (c * u)
    have h_deriv : ∀ u ∈ (Set.univ : Set ℝ), HasDerivWithinAt ϕ (ϕ' u) Set.univ u := by
      intro u _
      have h1 : HasDerivAt (fun x : ℝ => c * x) (c * 1) u := (hasDerivAt_id u).const_mul c
      rw [mul_one] at h1
      have h2 : HasDerivAt ϕ (Real.exp (c * u) * c) u := (Real.hasDerivAt_exp (c * u)).comp u h1
      rw [mul_comm] at h2
      exact h2.hasDerivWithinAt
    have h_inj : Set.InjOn ϕ Set.univ :=
      fun u₁ _ u₂ _ h => mul_left_cancel₀ (ne_of_gt hc) (Real.exp_injective h)
    have h_surj : Function.Surjective (fun u : ℝ => c * u) := mul_left_surjective₀ (ne_of_gt hc)
    have h_img : ϕ '' Set.univ = Set.Ioi (0 : ℝ) := by
      rw [Set.image_univ]
      change Set.range (Real.exp ∘ fun u : ℝ => c * u) = Set.Ioi (0 : ℝ)
      rw [h_surj.range_comp, Real.range_exp]
    have h_abs : ∀ u : ℝ, |ϕ' u| = c * Real.exp (c * u) := by
      intro u
      dsimp [ϕ']
      exact abs_of_pos (mul_pos hc (Real.exp_pos _))
    refine ⟨?_, ?_⟩
    · rw [← h_img]
      rw [MeasureTheory.integrableOn_image_iff_integrableOn_abs_deriv_smul MeasurableSet.univ h_deriv h_inj]
      rw [MeasureTheory.integrableOn_univ]
      refine MeasureTheory.integrable_congr (Filter.Eventually.of_forall (fun u => ?_))
      dsimp [ϕ]
      rw [h_abs u]
      have hexp_ne : Real.exp (c * u) ≠ 0 := Real.exp_ne_zero (c * u)
      calc (c * Real.exp (c * u)) * ((Real.exp (c * u))⁻¹ * f_re (Real.exp (c * u)))
          = c * (Real.exp (c * u) * (Real.exp (c * u))⁻¹) * f_re (Real.exp (c * u)) := by ring
        _ = c * 1 * f_re (Real.exp (c * u)) := by rw [mul_inv_cancel₀ hexp_ne]
        _ = c * f_re (Real.exp (c * u)) := by ring
    · rw [← h_img]
      rw [MeasureTheory.integral_image_eq_integral_abs_deriv_smul MeasurableSet.univ h_deriv h_inj]
      rw [MeasureTheory.setIntegral_univ]
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun u => ?_))
      dsimp [ϕ]
      rw [h_abs u, Complex.ofReal_mul, Complex.ofReal_inv]
      have hexp_ne : (Real.exp (c * u) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero (c * u))
      calc ((c : ℂ) * (Real.exp (c * u) : ℂ)) * (((Real.exp (c * u) : ℂ))⁻¹ * f_c (Real.exp (c * u)))
          = (c : ℂ) * ((Real.exp (c * u) : ℂ) * ((Real.exp (c * u) : ℂ))⁻¹) * f_c (Real.exp (c * u)) := by ring
        _ = (c : ℂ) * 1 * f_c (Real.exp (c * u)) := by rw [mul_inv_cancel₀ hexp_ne]
        _ = (c : ℂ) * f_c (Real.exp (c * u)) := by ring
  let g_maj : NumberField.InfinitePlace K → ℝ → ℝ := fun w t =>
    2 * Real.exp (t * s.re) *
      Real.exp (-Real.pi * (w.mult : ℝ) * Real.exp (t * (2 / (w.mult : ℝ))))
  let g_c : NumberField.InfinitePlace K → ℝ → ℂ := fun w t =>
    Complex.exp ((t : ℂ) * s) *
      ((2 * Real.exp (-Real.pi * (w.mult : ℝ) * Real.exp (t * (2 / (w.mult : ℝ)))) : ℝ) : ℂ)
  have hw_mult : ∀ w : NumberField.InfinitePlace K, 1 ≤ w.mult ∧ w.mult ≤ 2 := by
    intro w
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · have hm : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
      omega
    · have hm : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hw⟩
      omega
  have h_place : ∀ w : NumberField.InfinitePlace K,
      MeasureTheory.Integrable (g_maj w) MeasureTheory.volume ∧
      MeasureTheory.Integrable (g_c w) MeasureTheory.volume ∧
      (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ s *
          ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) =
        ∫ t : ℝ, g_c w t := by
    intro w
    have hm1 : 1 ≤ w.mult := (hw_mult w).1
    have hm2 : w.mult ≤ 2 := (hw_mult w).2
    have hm_pos : (0 : ℝ) < (w.mult : ℝ) := by exact_mod_cast (lt_of_lt_of_le zero_lt_one hm1)
    have hm_le2 : (w.mult : ℝ) ≤ 2 := by exact_mod_cast hm2
    set p : ℝ := 2 / (w.mult : ℝ)
    set b : ℝ := Real.pi * (w.mult : ℝ)
    have hb_neg : -b = -Real.pi * (w.mult : ℝ) := by dsimp [b]; ring
    have hσ_gt : -1 < s.re - 1 := by linarith
    have hp_ge : 1 ≤ p := by
      dsimp [p]
      rw [one_le_div hm_pos]
      exact hm_le2
    have hb_pos : 0 < b := by dsimp [b]; positivity
    let f_re : ℝ → ℝ := fun v => 2 * v ^ s.re * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ p)
    let f_c : ℝ → ℂ := fun v => (v : ℂ) ^ s * ((2 * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ p) : ℝ) : ℂ)
    have h_s1_w := h_s1 1 zero_lt_one f_re f_c
    have h_int_v0 : MeasureTheory.IntegrableOn
        (fun v : ℝ => 2 * (v ^ (s.re - 1) * Real.exp (-b * v ^ p)))
        (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      (integrableOn_rpow_mul_exp_neg_mul_rpow hσ_gt hp_ge hb_pos).const_mul 2
    have h_int_v : MeasureTheory.IntegrableOn
        (fun v : ℝ => v⁻¹ * f_re v) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
      refine h_int_v0.congr_fun (fun v hv => ?_) measurableSet_Ioi
      have hv_pos : 0 < v := Set.mem_Ioi.mp hv
      dsimp [f_re]
      rw [← hb_neg, Real.rpow_sub hv_pos, Real.rpow_one, div_eq_mul_inv]
      ring
    have h_gmaj_int : MeasureTheory.Integrable (g_maj w) MeasureTheory.volume := by
      have h1 := h_s1_w.1.mp h_int_v
      refine h1.congr (Filter.Eventually.of_forall (fun t => ?_))
      dsimp [f_re, g_maj, p]
      rw [one_mul, one_mul, ← Real.exp_mul, ← Real.exp_mul]
    have h_re_s : ∀ t : ℝ, ((t : ℂ) * s).re = t * s.re := by
      intro t
      simp [Complex.mul_re]
    have h_gc_cont : Continuous (g_c w) := by
      dsimp [g_c]
      fun_prop
    have h_gc_int : MeasureTheory.Integrable (g_c w) MeasureTheory.volume := by
      refine h_gmaj_int.mono' h_gc_cont.aestronglyMeasurable (Filter.Eventually.of_forall (fun t => ?_))
      dsimp [g_c, g_maj]
      rw [norm_mul, Complex.norm_exp, h_re_s t, Complex.norm_real,
        Real.norm_of_nonneg (by positivity)]
      linarith
    refine ⟨h_gmaj_int, h_gc_int, ?_⟩
    have h_lhs_eq : (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) =
        ∫ v in Set.Ioi (0 : ℝ), ((v⁻¹ : ℝ) : ℂ) * f_c v := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun v _ => ?_)
      dsimp [f_c, p]
      push_cast
      ring
    rw [h_lhs_eq, h_s1_w.2]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun t => ?_))
    dsimp [f_c, g_c, p]
    rw [one_mul, one_mul, ← Real.exp_mul]
    have hexp_c_ne : ((Real.exp t : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero t)
    have h_cpow : ((Real.exp t : ℝ) : ℂ) ^ s = Complex.exp ((t : ℂ) * s) := by
      rw [Complex.cpow_def_of_ne_zero hexp_c_ne, ← Complex.ofReal_log (Real.exp_nonneg t), Real.log_exp]
    rw [h_cpow]
  let G_maj : (NumberField.InfinitePlace K → ℝ) → ℝ := fun t => ∏ w : NumberField.InfinitePlace K, g_maj w (t w)
  let G_c : (NumberField.InfinitePlace K → ℝ) → ℂ := fun t => ∏ w : NumberField.InfinitePlace K, g_c w (t w)
  have hG_maj_int : MeasureTheory.Integrable G_maj MeasureTheory.volume :=
    MeasureTheory.Integrable.fintype_prod_dep (fun w => (h_place w).1)
  have hG_c_int : MeasureTheory.Integrable G_c MeasureTheory.volume :=
    MeasureTheory.Integrable.fintype_prod_dep (fun w => (h_place w).2.1)
  have h_prod_places :
      (∏ w : NumberField.InfinitePlace K,
        (∫ v in Set.Ioi (0 : ℝ),
          (v : ℂ) ^ s *
            ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ))) =
        ∫ t : NumberField.InfinitePlace K → ℝ, G_c t := by
    simp_rw [fun w => (h_place w).2.2]
    exact (MeasureTheory.integral_fintype_prod_volume_eq_prod g_c).symm
  let Ψ_K : ℝ → (Fin (NumberField.Units.rank K) → ℝ) → (NumberField.InfinitePlace K → ℝ) :=
    fun u y w =>
      (w.mult : ℝ) *
        (u + ∑ i : Fin (NumberField.Units.rank K),
          y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)))
  have h_s3 :
      MeasureTheory.Integrable
        (fun u : ℝ =>
          (Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K *
            ∫ y : Fin (NumberField.Units.rank K) → ℝ, G_maj (Ψ_K u y))
        MeasureTheory.volume ∧
      (∫ t : NumberField.InfinitePlace K → ℝ, G_c t) =
        ∫ u : ℝ,
          (((Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K : ℝ) : ℂ) *
            ∫ y : Fin (NumberField.Units.rank K) → ℝ, G_c (Ψ_K u y) := by
