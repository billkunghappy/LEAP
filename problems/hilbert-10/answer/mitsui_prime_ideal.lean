    push_cast
    ring
  rw [h_rearrange, hΨ_inv u hu]
  have h_u1 : ((u ^ (1 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (1 : ℂ) := by
    rw [Complex.ofReal_cpow hu_nn]; simp
  have h_um1 : ((u ^ (-1 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (-1 : ℂ) := by
    rw [Complex.ofReal_cpow hu_nn]; push_cast; rfl
  have h_um2 : ((u ^ (-2 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (-2 : ℂ) := by
    rw [Complex.ofReal_cpow hu_nn]; push_cast; rfl
  have h_cast_rhs : ((Ψ u + R_K * (u ^ (-1 : ℝ) - u ^ (-2 : ℝ)) : ℝ) : ℂ) =
      (Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (-2 : ℂ)) := by
    push_cast
    rw [h_um1, h_um2]
  rw [h_u1, h_cast_rhs]
  have h_exp1 : (u : ℂ) ^ (-s) * (u : ℂ) ^ (1 : ℂ) = (u : ℂ) ^ (1 - s) := by
    rw [← Complex.cpow_add _ _ hu_c_ne]
    congr 1; ring
  rw [h_exp1]
  have h_exp2 : (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-1 : ℂ) = (u : ℂ) ^ (-s) := by
    rw [← Complex.cpow_add _ _ hu_c_ne]
    congr 1; ring
  have h_exp3 : (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-2 : ℂ) = (u : ℂ) ^ (-1 - s) := by
    rw [← Complex.cpow_add _ _ hu_c_ne]
    congr 1; ring
  calc (u : ℂ) ^ (1 - s) * ((Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (-2 : ℂ)))
      = (u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
          (R_K : ℂ) * ((u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-2 : ℂ)) := by ring
    _ = (u : ℂ) ^ (1 - s) * (Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)) := by
        rw [h_exp2, h_exp3]

theorem mitsui_hecke_folded_mellin_polar_integral_identity (R_K : ℝ) (Ψ : ℝ → ℝ)
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume)
    (s : ℂ) (hs : 1 < s.re) :
    s * (s - 1) *
      ((∫ u in Set.Ioi (1 : ℝ),
          ((u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
            (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)))) +
        (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ u : ℂ))) =
    (R_K : ℂ) +
      s * (s - 1) *
        ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ) :=
by
  set μ : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))
  have hΨ_int0 : MeasureTheory.Integrable Ψ μ := by
    have h0 : MeasureTheory.Integrable (fun u : ℝ => u ^ (0 : ℝ) * Ψ u) μ := hΨ_int 0
    have h_eq : (fun u : ℝ => u ^ (0 : ℝ) * Ψ u) = Ψ := by
      ext u
      rw [Real.rpow_zero, one_mul]
    rwa [h_eq] at h0
  have hΨ_c_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => (Ψ u : ℂ)) μ :=
    Complex.continuous_ofReal.comp_aestronglyMeasurable hΨ_int0.aestronglyMeasurable
  have h_cpow_meas : ∀ z : ℂ, MeasureTheory.AEStronglyMeasurable (fun u : ℝ => (u : ℂ) ^ z) μ := by
    intro z
    refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Ioi
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    exact (Complex.continuous_ofReal.continuousAt.cpow continuousAt_const
      (Complex.ofReal_mem_slitPlane.mpr hu_pos)).continuousWithinAt
  have h_int_z : ∀ z : ℂ, MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ z * (Ψ u : ℂ)) μ := by
    intro z
    refine (hΨ_int z.re).mono' ((h_cpow_meas z).mul hΨ_c_meas) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hu_pos z, Complex.norm_of_nonneg hΨ_u]
  have h_int_s : MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ s * (Ψ u : ℂ)) μ := h_int_z s
  have h_int_1s : MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ (1 - s) * (Ψ u : ℂ)) μ := h_int_z (1 - s)
  have h_re_neg_s : (-s).re < -1 := by
    rw [Complex.neg_re]
    linarith
  have h_re_neg_1s : (-1 - s).re < -1 := by
    rw [Complex.sub_re, Complex.neg_re, Complex.one_re]
    linarith
  have h_int_neg_s : MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ (-s)) μ :=
    integrableOn_Ioi_cpow_of_lt h_re_neg_s zero_lt_one
  have h_int_neg_1s : MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ (-1 - s)) μ :=
    integrableOn_Ioi_cpow_of_lt h_re_neg_1s zero_lt_one
  have h_int_sub : MeasureTheory.Integrable (fun u : ℝ => (u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)) μ :=
    h_int_neg_s.sub h_int_neg_1s
  have h_int_polar : MeasureTheory.Integrable (fun u : ℝ => (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s))) μ :=
    h_int_sub.const_mul (R_K : ℂ)
  have h_eval_neg_s : (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ (-s)) = -1 / (-s + 1) := by
    rw [integral_Ioi_cpow_of_lt h_re_neg_s zero_lt_one, Complex.ofReal_one, Complex.one_cpow]
  have h_eval_neg_1s : (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ (-1 - s)) = -1 / (-1 - s + 1) := by
    rw [integral_Ioi_cpow_of_lt h_re_neg_1s zero_lt_one, Complex.ofReal_one, Complex.one_cpow]
  have h_split :
      (∫ u in Set.Ioi (1 : ℝ),
        ((u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
          (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)))) =
      (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ (1 - s) * (Ψ u : ℂ)) +
        (R_K : ℂ) * (-1 / (-s + 1) - -1 / (-1 - s + 1)) := by
    rw [MeasureTheory.integral_add h_int_1s h_int_polar,
      MeasureTheory.integral_const_mul,
      MeasureTheory.integral_sub h_int_neg_s h_int_neg_1s,
      h_eval_neg_s, h_eval_neg_1s]
  have h_fold :
      (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)) =
      (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ u : ℂ)) +
        (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ (1 - s) * (Ψ u : ℂ)) := by
    have h_fn :
        (fun u : ℝ => ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)) =
        (fun u : ℝ => (u : ℂ) ^ s * (Ψ u : ℂ) + (u : ℂ) ^ (1 - s) * (Ψ u : ℂ)) := by
      ext u
      exact add_mul _ _ _
    rw [h_fn, MeasureTheory.integral_add h_int_s h_int_1s]
  have hne1 : -s + 1 ≠ 0 := by
    intro h0
    have h_re : (-s + 1).re = 0 := by rw [h0, Complex.zero_re]
    rw [Complex.add_re, Complex.neg_re, Complex.one_re] at h_re
    linarith
  have hne2 : -1 - s + 1 ≠ 0 := by
    intro h0
    have h_re : (-1 - s + 1).re = 0 := by rw [h0, Complex.zero_re]
    rw [Complex.add_re, Complex.sub_re, Complex.neg_re, Complex.one_re] at h_re
    linarith
  rw [h_split, h_fold]
  field_simp [hne1, hne2]
  ring

theorem mitsui_dedekindZeta_hecke_theta_rhp_identity {K : Type u} [Field K] [NumberField K] :
    ∃ (R_K : ℝ) (Ψ_K : ℝ → ℝ), 0 < R_K ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_K u) ∧
      (∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ_K u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume) ∧
      (∀ s : ℂ, 1 < s.re →
        s *
