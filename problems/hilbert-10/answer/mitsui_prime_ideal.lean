    have h4 : (4 : ℕ) = 2 ^ 2 := rfl
    rw [h4, mul_pow, ← pow_mul, ← mul_assoc, ← pow_add]
  rw [h_pow_eq] at hcard_le
  have h_exp_le : n + 2 * (n - 1) ≤ 3 * n := by omega
  have h_pow_le : 2 ^ (n + 2 * (n - 1)) * m ^ (n - 1) ≤ 2 ^ (3 * n) * m ^ (n - 1) :=
    Nat.mul_le_mul_right (m ^ (n - 1)) (Nat.pow_le_pow_right (by norm_num) h_exp_le)
  have h_nat_bound : Nat.card ℬ ≤ 2 ^ (3 * n) * m ^ (n - 1) := le_trans hcard_le h_pow_le
  change (Nat.card ℬ : ℝ) ≤ (2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1)
  exact_mod_cast h_nat_bound

theorem mitsui_prime_grid_partition_diff_le_boundary {K : Type u} [Field K] [NumberField K] :
    ∃ c_pack : ℝ, 0 < c_pack ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ X →
          ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K),
            (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
                NumberField.mixedEmbedding.normAtPlace w z < X) →
            |(∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
              - (∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
                    {z : NumberField.mixedEmbedding.mixedSpace K |
                      ∀ i : NumberField.mixedEmbedding.index K,
                        (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
