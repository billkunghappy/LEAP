    have h_ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_tendsto zero_lt_one hG_deriv hg_int hG_tendsto_zero hG_tendsto_one
    rw [sub_zero, intervalIntegral.integral_of_le zero_le_one] at h_ftc
    refine ⟨h_mc, ?_⟩
    rw [mellin, ← Set.Ioc_union_Ioi_eq_Ioi zero_le_one,
      MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi h_int_Ioc h_int_Ioi,
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioc hf_Ioc,
      MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero hf_Ioi,
