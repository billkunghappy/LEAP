    let c_sum : ℝ := 17 * c_pack + c₁ + c₂ + M_card * c_sec + c_sec
    have hc_sum_pos : 0 < c_sum := by dsimp [c_sum]; positivity
    let c_cube : ℝ := max 2 c_sum
    have h_two_le_c : 2 ≤ c_cube := le_max_left _ _
    have hc_sum_le_c : c_sum ≤ c_cube := le_max_right _ _
    have hc_cube_pos : 0 < c_cube := lt_of_lt_of_le (by norm_num) h_two_le_c
    refine ⟨c_cube, hc_cube_pos, ?_⟩
    intro X hX m hm hm_le_X k hQ_bdd q hq hq_norm ψ hψ hψ_tors hψ_units
    have hX_pos : 0 < X := by linarith
    set Y : ℝ := X ^ n
