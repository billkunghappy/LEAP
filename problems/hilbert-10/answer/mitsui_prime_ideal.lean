    fun k => geometric_hahn_banach_open_point hC_conv hC_open (hy_not_C k)
  let f : ℬ → (NumberField.mixedEmbedding.mixedSpace K →L[ℝ] ℝ) := fun k => (hf_ex k).choose
  have hf : ∀ k : ℬ, ∀ a ∈ C, f k a < f k (y k) := fun k => (hf_ex k).choose_spec
  let ε : ℬ → (ι → Bool) := fun k i => decide (0 ≤ f k (b i))
  let σ : ℬ → (ι → ℤ) := fun k i => if ε k i = true then 1 else -1
