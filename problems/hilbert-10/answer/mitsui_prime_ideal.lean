  have h_norm_lt_of_ne : ∀ (q₁ f' : Ideal (NumberField.RingOfIntegers K)),
      q₁ ≠ 0 → q₁ ≤ f' → f' ≠ q₁ → f' ≠ 0 ∧ Ideal.absNorm f' < Ideal.absNorm q₁ := by
    intro q₁ f' hq₁ hq₁f' hne
    obtain ⟨c', hc'⟩ := Ideal.dvd_iff_le.mpr hq₁f'
    have hf'_ne : f' ≠ 0 := left_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne : c' ≠ 0 := right_ne_zero_of_mul (hc' ▸ hq₁)
