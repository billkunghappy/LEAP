        _ = ((D : ℂ) ^ (z / 2) * (N_f : ℂ) ^ (z / 2)) * (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ) * ∏ w : NumberField.InfinitePlace K, F w := by
