                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))}.indicator
            (fun q => ENNReal.ofReal ((R₁ * Real.exp q.1) ^ w.mult)) q).toReal ≤
          (MeasureTheory.volume {p : ℝ × ℝ |
            (∃ hw : w.IsReal,
