      ≤ c₁₀ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁₀) :=
    le_trans (mitsui_prime_char_box_to_ge_one_le X hX q hq ψ) (hc₁₀ X hX)
  have h2 :
      ‖(∑' π : {π : NumberField.RingOfIntegers K //
