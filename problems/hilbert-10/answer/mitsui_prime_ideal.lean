  have hΨ₁_K_Z_minus : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤ C₁ * Y₀ * δ ^ 2 :=
    hΨ₁_K_bound (Real.exp (-δ) * Y) hZ_minus_pos hZ_minus_le_eY₀
  have hexp_pos_taylor : Real.exp δ - 1 - δ ≤ δ ^ 2 := by
    have habs : |δ| ≤ 1 := by rw [abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    exact le_trans (le_abs_self _) h1
  have hexp_neg_taylor : Real.exp (-δ) - 1 + δ ≤ δ ^ 2 := by
    have habs : |-δ| ≤ 1 := by rw [abs_neg, abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    have h2 : Real.exp (-δ) - 1 - (-δ) ≤ (-δ) ^ 2 := le_trans (le_abs_self _) h1
    linarith
  have h_taylor_pos_Y : (Real.exp δ - 1 - δ) * Y ≤ Y₀ * δ ^ 2 := by
    calc (Real.exp δ - 1 - δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_pos_taylor (le_of_lt hY_pos)
      _ ≤ δ ^ 2 * Y₀ := mul_le_mul_of_nonneg_left hY_le_Y₀ (by positivity)
      _ = Y₀ * δ ^ 2 := by ring
  have h_taylor_neg_Y : (Real.exp (-δ) - 1 + δ) * Y ≤ Y₀ * δ ^ 2 := by
    calc (Real.exp (-δ) - 1 + δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_neg_taylor (le_of_lt hY_pos)
      _ ≤ δ ^ 2 * Y₀ := mul_le_mul_of_nonneg_left hY_le_Y₀ (by positivity)
      _ = Y₀ * δ ^ 2 := by ring
  have h_fwd : ‖(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y‖ ≤
      B * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y) :=
    mitsui_primePower_char_decoupled_norm_dir_log_cell_riesz_forward_diff_le
      X m R₁ k w₀ l p Y δ hY_pos hδ_pos B hB₀ hB q hq ψ
  have h_bwd : Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y) ≤ δ * ψ_K Y :=
    mitsui_primePowers_ge_riesz_backward_diff Y δ hY_pos hδ_pos
  have hΨ₁_K_Y_lower : -(C₁ * Y₀ * δ ^ 2) ≤ Ψ₁_K Y - Y := (abs_le.mp hΨ₁_K_Y).1
  have hΨ₁_K_Z_plus_upper : Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y ≤ C₁ * Y₀ * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_plus).2
  have hΨ₁_K_Z_minus_upper : Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y ≤ C₁ * Y₀ * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_minus).2
  have h_second_diff : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y ≤ C_diff * Y₀ * δ ^ 2 := by
    have h_ident : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y)) =
        (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) - 2 * (Ψ₁_K Y - Y) +
        (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) +
        (Real.exp δ - 1 - δ) * Y + (Real.exp (-δ) - 1 + δ) * Y := by ring
    dsimp [C_diff]
    linarith
  have h_rem_le : ‖(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y‖ ≤
      B * C_diff * Y₀ * δ ^ 2 := by
    calc ‖(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y‖
      _ ≤ B * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y) := h_fwd
      _ ≤ B * (C_diff * Y₀ * δ ^ 2) := mul_le_mul_of_nonneg_left h_second_diff hB₀
      _ = B * C_diff * Y₀ * δ ^ 2 := by ring
  have h_norm_δ_ψ : δ * ‖ψ_cell Y‖ ≤
      ‖Ψ₁_cell (Real.exp δ * Y)‖ + ‖Ψ₁_cell Y‖ +
      ‖(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y‖ := by
    have h_eq : (δ : ℂ) * ψ_cell Y =
        (Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) -
        ((Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y) := by ring
    have h_norm_eq : δ * ‖ψ_cell Y‖ =
        ‖(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) -
          ((Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y)‖ := by
      rw [← h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
    have ht1 := norm_sub_le (Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y)
      ((Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - (δ : ℂ) * ψ_cell Y)
    have ht2 := norm_sub_le (Ψ₁_cell (Real.exp δ * Y)) (Ψ₁_cell Y)
    linarith
  have h_δ_ψ_le : δ * ‖ψ_cell Y‖ ≤ (2 * c + B * C_diff) * Y₀ * δ ^ 2 := by
    linarith
  have h_ψ_le_δ : ‖ψ_cell Y‖ ≤ 2 * c * Y₀ * δ + B * C_diff * Y₀ * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * ‖ψ_cell Y‖ ≤ (2 * c + B * C_diff) * Y₀ * δ ^ 2 := h_δ_ψ_le
      _ = δ * (2 * c * Y₀ * δ + B * C_diff * Y₀ * δ) := by ring
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀_half : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hexp_half_le : Real.exp (c' * t / 2) ≤ Real.exp (c' * t) := by
    rw [Real.exp_le_exp]
    have : 0 ≤ c' * t := by positivity
    linarith
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t) :=
    le_trans hlog1_le_K₀_half (mul_le_mul_of_nonneg_left hexp_half_le (le_of_lt hK₀_pos))
  have hexp_r_le : (r : ℝ) * (c' * t) ≤ t / (4 * c) := by
    have hr_le : (r : ℝ) ≤ (r : ℝ) + 1 := by linarith
    have h1 : (r : ℝ) * (c' * t) ≤ ((r : ℝ) + 1) * (c' * t) :=
      mul_le_mul_of_nonneg_right hr_le (by positivity)
    have h2 : ((r : ℝ) + 1) * (c' * t) = t / (4 * c) := by
      dsimp [c']
      have hr1_ne : (r : ℝ) + 1 ≠ 0 := by positivity
      have hc_ne : c ≠ 0 := ne_of_gt hc_pos
      field_simp [hr1_ne, hc_ne]
    linarith
  have hlog1_pow_le : (Real.log X + 1) ^ r ≤ K₀ ^ r * Real.exp (t / (4 * c)) := by
    calc (Real.log X + 1) ^ r
      _ ≤ (K₀ * Real.exp (c' * t)) ^ r :=
        pow_le_pow_left₀ (by positivity) hlog1_le_K₀ r
      _ = K₀ ^ r * (Real.exp (c' * t)) ^ r := mul_pow _ _ _
      _ = K₀ ^ r * Real.exp ((r : ℝ) * (c' * t)) := by rw [← Real.exp_nat_mul]
      _ ≤ K₀ ^ r * Real.exp (t / (4 * c)) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp_r_le) (by positivity)
  have hB_le : B ≤ c_gen * (K₀ ^ r * Real.exp (t / (4 * c))) :=
    mul_le_mul_of_nonneg_left hlog1_pow_le (le_of_lt hc_gen_pos)
  have hexp_combine : Real.exp (t / (4 * c)) * δ = Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [← Real.exp_add]
    congr 1
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    field_simp [hc_ne]
    ring
  have h_BC_bound : B * C_diff * Y₀ * δ ≤ A_diff * Y₀ * Real.exp (-t / (4 * c)) := by
    calc B * C_diff * Y₀ * δ
      _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by
        have : 0 ≤ C_diff * Y₀ * δ := by positivity
        calc B * C_diff * Y₀ * δ = B * (C_diff * Y₀ * δ) := by ring
          _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * (C_diff * Y₀ * δ) :=
            mul_le_mul_of_nonneg_right hB_le this
          _ = (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by ring
      _ = A_diff * Y₀ * (Real.exp (t / (4 * c)) * δ) := by
        dsimp [A_diff]; ring
      _ = A_diff * Y₀ * Real.exp (-t / (4 * c)) := by rw [hexp_combine]
  have h4c_pos : 0 < 4 * c := by positivity
  have h2c_pos : 0 < 2 * c := by positivity
  have h4c_le : 4 * c ≤ c_pp := by dsimp [c_pp]; linarith
  have h2c_le_4c : 2 * c ≤ 4 * c := by linarith
  have hδ_le_4c : δ ≤ Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h2c_pos h2c_le_4c
  have h_2c_bound : 2 * c * Y₀ * δ ≤ 2 * c * Y₀ * Real.exp (-t / (4 * c)) :=
    mul_le_mul_of_nonneg_left hδ_le_4c (by positivity)
  have h_ψ_cell_bound : ‖ψ_cell Y‖ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := by
    linarith
  have hexp_4c_le : Real.exp (-t / (4 * c)) ≤ Real.exp (-t / c_pp) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h4c_pos h4c_le
  have h_coeff : 2 * c + A_diff ≤ c_pp := by dsimp [c_pp]; linarith
  calc ‖ψ_cell Y‖
    _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := h_ψ_cell_bound
    _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / c_pp) :=
      mul_le_mul_of_nonneg_left hexp_4c_le (by positivity)
    _ = (2 * c + A_diff) * (Y₀ * Real.exp (-t / c_pp)) := by ring
    _ ≤ c_pp * (Y₀ * Real.exp (-t / c_pp)) :=
      mul_le_mul_of_nonneg_right h_coeff (by positivity)
    _ = c_pp * Y₀ * Real.exp (-t / c_pp) := by ring

theorem mitsui_prime_char_decoupled_norm_dir_log_cell_bound_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cell : ℝ, 0 < c_cell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) < Real.exp (Real.sqrt (Real.log X)) →
          ∀ R₁ : ℝ, 1 < R₁ → R₁ ≤ X →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              ∀ w₀ : NumberField.InfinitePlace K,
                ∀ l : ℕ, 1 ≤ l →
                  ∀ p : NumberField.InfinitePlace K → Fin l,
                    ∀ Y : ℝ, Y ≤ X ^ (Module.finrank ℚ K) →
                      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                        (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                        ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                          ((∑' u : NumberField.Units.torsion K,
                            ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
                              (u : (NumberField.RingOfIntegers K)ˣ)))) = 0 ∧
                            ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
                              w ((u : NumberField.RingOfIntegers K) : K) = 1) →
                          ‖∑' π : {π : NumberField.RingOfIntegers K //
                                Prime π ∧
                                ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤ Y ∧
                                (∀ i : NumberField.mixedEmbedding.index K,
                                  R₁ *
                                    ((NumberField.mixedEmbedding.stdBasis K).repr
                                        (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                                (∀ w : NumberField.InfinitePlace K,
                                  Real.log (w (π : K) / w₀ (π : K)) ∈
                                    Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                      (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
                                IsUnit (Ideal.Quotient.mk q π)},
                              ψ (Additive.ofMul π.2.2.2.2.2.unit) *
                                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                            ≤ c_cell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cell) :=
by
  obtain ⟨c_hpp, hc_hpp_pos, hc_hpp⟩ := mitsui_higher_primePower_log_sector_bound (K := K)
  obtain ⟨c_pp, hc_pp_pos, hc_pp⟩ :=
    mitsui_primePower_char_decoupled_norm_dir_log_cell_bound_of_torsion_ne_one (K := K) A hA
  let c_cell : ℝ := c_hpp + c_pp
  have hc_cell_pos : 0 < c_cell := by dsimp [c_cell]; positivity
  refine ⟨c_cell, hc_cell_pos, ?_⟩
  intro X hX m hm hm_coarse R₁ hR₁_gt hR₁_le k w₀ l hl p Y hY q hq hq_norm ψ hψ hψ_tors
  set Y₀ : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_pos : 0 < Y₀ := by dsimp [Y₀]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hl_rpos : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl
  let D_cell := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤ Y ∧
      (∀ i : NumberField.mixedEmbedding.index K,
        R₁ *
          ((NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
      (∀ w : NumberField.InfinitePlace K,
        Real.log (w (π : K) / w₀ (π : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  by_cases hp₀ : (p w₀ : ℕ) + 1 = l
  · by_cases hY_ge_one : 1 ≤ Y
    · set S_prime : ℂ := ∑' π : D_cell,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
      set S_pp : ℂ := ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ xpm.2.2 ∧
            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              R₁ *
                ((NumberField.mixedEmbedding.stdBasis K).repr
                    (NumberField.mixedEmbedding K (xpm.1 : K)) i / w₀ (xpm.1 : K)) ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            (∀ w : NumberField.InfinitePlace K,
              Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
            IsUnit (Ideal.Quotient.mk q xpm.1)},
          ψ (Additive.ofMul xpm.2.2.2.2.2.2.unit) *
            (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)
      set S_high : ℝ := ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            2 ≤ xpm.2.2 ∧
            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y₀ ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈ Set.Ioc (-Real.log X) 0},
          Real.log (Ideal.absNorm xpm.1.2.1.asIdeal)
      have h_tri : ‖S_prime‖ ≤ ‖S_prime - S_pp‖ + ‖S_pp‖ := norm_le_norm_sub_add S_prime S_pp
      have h_sub : ‖S_prime - S_pp‖ ≤ S_high :=
        mitsui_prime_char_decoupled_norm_dir_log_cell_sub_primePower_le X hX m hm R₁ k w₀ l hl p Y hY q hq ψ
      have h_high : S_high ≤ c_hpp * Y₀ * Real.exp (-Real.sqrt (Real.log X) / c_hpp) :=
        hc_hpp X hX w₀
      have h_pp : ‖S_pp‖ ≤ c_pp * Y₀ * Real.exp (-Real.sqrt (Real.log X) / c_pp) :=
        hc_pp X hX m hm hm_coarse R₁ hR₁_gt hR₁_le k w₀ l hl p hp₀ Y hY_ge_one hY q hq hq_norm ψ hψ hψ_tors
      set t : ℝ := Real.sqrt (Real.log X)
      have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
      have hc_hpp_le : c_hpp ≤ c_cell := by dsimp [c_cell]; linarith
      have hc_pp_le : c_pp ≤ c_cell := by dsimp [c_cell]; linarith
      have hexp_hpp : Real.exp (-t / c_hpp) ≤ Real.exp (-t / c_cell) := by
        rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
        exact div_le_div_of_nonneg_left ht_nonneg hc_hpp_pos hc_hpp_le
      have hexp_pp : Real.exp (-t / c_pp) ≤ Real.exp (-t / c_cell) := by
        rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
        exact div_le_div_of_nonneg_left ht_nonneg hc_pp_pos hc_pp_le
      have hterm_hpp : c_hpp * Y₀ * Real.exp (-t / c_hpp) ≤ c_hpp * Y₀ * Real.exp (-t / c_cell) :=
        mul_le_mul_of_nonneg_left hexp_hpp (by positivity)
      have hterm_pp : c_pp * Y₀ * Real.exp (-t / c_pp) ≤ c_pp * Y₀ * Real.exp (-t / c_cell) :=
        mul_le_mul_of_nonneg_left hexp_pp (by positivity)
      have h_sum_eq :
          c_hpp * Y₀ * Real.exp (-t / c_cell) + c_pp * Y₀ * Real.exp (-t / c_cell) =
          c_cell * Y₀ * Real.exp (-t / c_cell) := by
        dsimp [c_cell]; ring
      change ‖S_prime‖ ≤ c_cell * Y₀ * Real.exp (-t / c_cell)
      linarith
    · haveI : IsEmpty D_cell := by
        refine ⟨fun π => ?_⟩
        have hπ_ne : (π.1 : NumberField.RingOfIntegers K) ≠ 0 := π.2.1.ne_zero
        have hnorm_ne : Algebra.norm ℤ π.1 ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
        have hnatAbs_ne : (Algebra.norm ℤ π.1).natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hnorm_ne
        have hnatAbs_ge : 1 ≤ (Algebra.norm ℤ π.1).natAbs := Nat.one_le_iff_ne_zero.mpr hnatAbs_ne
        have hnorm_rge : (1 : ℝ) ≤ ((Algebra.norm ℤ π.1).natAbs : ℝ) := by exact_mod_cast hnatAbs_ge
        have hnorm_le_Y : ((Algebra.norm ℤ π.1).natAbs : ℝ) ≤ Y := π.2.2.1
        linarith
      have h_tsum_zero : (∑' π : D_cell,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) = 0 :=
        tsum_empty
      change ‖∑' π : D_cell,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤ _
      rw [h_tsum_zero, norm_zero]
      positivity
  · haveI : IsEmpty D_cell := by
      refine ⟨fun π => ?_⟩
      have hπ_ne : (π.1 : NumberField.RingOfIntegers K) ≠ 0 := π.2.1.ne_zero
      have hπK_ne : ((π.1 : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hπ_ne
      have hw₀_pos : 0 < w₀ (π.1 : K) := w₀.pos_iff.mpr hπK_ne
      have h_div : w₀ (π.1 : K) / w₀ (π.1 : K) = 1 := div_self (ne_of_gt hw₀_pos)
      have h_log : Real.log (w₀ (π.1 : K) / w₀ (π.1 : K)) = 0 := by
        rw [h_div, Real.log_one]
      have h_mem := (π.2.2.2.2.1 w₀).2
      rw [h_log] at h_mem
      have hpw₀_lt : (p w₀ : ℕ) < l := (p w₀).isLt
      have hpw₀_lt' : (p w₀ : ℕ) + 1 < l := by omega
      have hpw₀_rlt : ((p w₀ : ℕ) : ℝ) + 1 < (l : ℝ) := by exact_mod_cast hpw₀_lt'
      have hnum_neg : ((p w₀ : ℕ) : ℝ) + 1 - (l : ℝ) < 0 := by linarith
      have hdiv_neg : (((p w₀ : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ) < 0 :=
        div_neg_of_neg_of_pos hnum_neg hl_rpos
      have hrhs_neg : Real.log X * ((((p w₀ : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) < 0 :=
        mul_neg_of_pos_of_neg hlog_pos hdiv_neg
      linarith
    have h_tsum_zero : (∑' π : D_cell,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) = 0 :=
      tsum_empty
    change ‖∑' π : D_cell,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤ _
    rw [h_tsum_zero, norm_zero]
    positivity

theorem mitsui_prime_char_decoupled_conical_shell_bound_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_shell : ℝ, 0 < c_shell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) < Real.exp (Real.sqrt (Real.log X)) →
          ∀ L : ℕ, 1 ≤ L →
            ∀ j : Fin L,
              ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
                ∀ w₀ : NumberField.InfinitePlace K,
                  ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                    (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                    ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                      ((∑' u : NumberField.Units.torsion K,
                        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
                          (u : (NumberField.RingOfIntegers K)ˣ)))) = 0 ∧
                        ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
                          w ((u : NumberField.RingOfIntegers K) : K) = 1) →
                      ‖∑' π : {π : NumberField.RingOfIntegers K //
                            Prime π ∧
                            (∀ i : NumberField.mixedEmbedding.index K,
                              (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) *
                                ((NumberField.mixedEmbedding.stdBasis K).repr
                                    (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                            (∀ w : NumberField.InfinitePlace K,
                              1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                            w₀ (π : K) ∈
                              Set.Ico ((X / (L : ℝ)) * ((j : ℕ) : ℝ))
                                ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
                            IsUnit (Ideal.Quotient.mk q π)},
                          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
                            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                        ≤ c_shell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_shell) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c_sub, hc_sub_pos, hc_sub⟩ := mitsui_prime_sub_box_shell_diff_bound (K := K)
  obtain ⟨c_cell, hc_cell_pos, hc_cell⟩ :=
    mitsui_prime_char_decoupled_norm_dir_log_cell_bound_of_torsion_ne_one (K := K) A hA
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  set c' : ℝ := 1 / (4 * (M : ℝ) * c_cell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_cell : ℝ := K₀ ^ (2 * M) * c_cell
  have hA_cell_pos : 0 < A_cell := by dsimp [A_cell]; positivity
  let c_shell : ℝ := 2 * c₁ + 6 * c_sub + 2 * A_cell + 1 / c' + 2 * c_cell
  have hc_shell_pos : 0 < c_shell := by dsimp [c_shell]; positivity
  refine ⟨c_shell, hc_shell_pos, ?_⟩
  intro X hX m hm hm_coarse L hL j k w₀ q hq hq_norm ψ hψ hψ_tors
  set Y₀ : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_nonneg : 0 ≤ Y₀ := by dsimp [Y₀]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set R₁ : ℝ := (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
  set R₀ : ℝ := (X / (L : ℝ)) * ((j : ℕ) : ℝ)
  have hL_rpos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr hL
  have hXL_pos : 0 < X / (L : ℝ) := div_pos hX_pos hL_rpos
  have hR₀_nonneg : 0 ≤ R₀ := by dsimp [R₀]; positivity
  have hR₀₁ : R₀ ≤ R₁ := by
    dsimp [R₀, R₁]
    exact mul_le_mul_of_nonneg_left (by linarith) (le_of_lt hXL_pos)
  have hj1_le_L : ((j : ℕ) : ℝ) + 1 ≤ (L : ℝ) := by
    have hj_lt : (j : ℕ) + 1 ≤ L := j.isLt
    exact_mod_cast hj_lt
  have hR₁_le : R₁ ≤ X := by
    dsimp [R₁]
    calc (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
      _ ≤ (X / (L : ℝ)) * (L : ℝ) :=
        mul_le_mul_of_nonneg_left hj1_le_L (le_of_lt hXL_pos)
      _ = X := div_mul_cancel₀ X (ne_of_gt hL_rpos)
  have hR₀_le : R₀ ≤ X := le_trans hR₀₁ hR₁_le
  have hR₁_nonneg : 0 ≤ R₁ := le_trans hR₀_nonneg hR₀₁
  by_cases hR₁_gt : 1 < R₁
  · set z : ℝ := (Real.log X + 1) ^ 2 * Real.exp (c' * t)
    set l : ℕ := ⌊z⌋₊
    have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by positivity)
    have hlog1_le_sq : Real.log X + 1 ≤ (Real.log X + 1) ^ 2 := by nlinarith
    have hz_ge : Real.log X + 1 ≤ z := by
      dsimp [z]
      calc Real.log X + 1
        _ = (Real.log X + 1) * 1 := (mul_one _).symm
        _ ≤ (Real.log X + 1) ^ 2 * Real.exp (c' * t) :=
          mul_le_mul hlog1_le_sq hexp_ge_one zero_le_one (by positivity)
    have hz_lt : z < (l : ℝ) + 1 := Nat.lt_floor_add_one z
    have hlog_lt_l : Real.log X < (l : ℝ) := by linarith
    have hl_log : Real.log X ≤ (l : ℝ) := le_of_lt hlog_lt_l
    have hl_rpos : (0 : ℝ) < (l : ℝ) := lt_trans hlog_pos hlog_lt_l
    have hl_pos : 0 < l := Nat.cast_pos.mp hl_rpos
    have hl : 1 ≤ l := hl_pos
    have hl_ge_one : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
    have hz_le_2l : z ≤ 2 * (l : ℝ) := by linarith
    have h_ratio : (Real.log X + 1) ^ 2 / (l : ℝ) ≤ 2 * Real.exp (-c' * t) := by
      rw [div_le_iff₀ hl_rpos]
      calc (Real.log X + 1) ^ 2
        _ = z * Real.exp (-c' * t) := by
          dsimp [z]
          rw [mul_assoc, ← Real.exp_add]
          have h0 : c' * t + -c' * t = 0 := by ring
          rw [h0, Real.exp_zero, mul_one]
        _ ≤ (2 * (l : ℝ)) * Real.exp (-c' * t) :=
          mul_le_mul_of_nonneg_right hz_le_2l (by positivity)
        _ = 2 * Real.exp (-c' * t) * (l : ℝ) := by ring
    have hl_le_z : (l : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
    have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
    have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
      have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
      have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
      calc (c' * t / 4) ^ 2
        _ = (c' * t / 4) * (c' * t / 4) := sq _
        _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
          mul_le_mul h2 h2 (by positivity) (by positivity)
        _ = Real.exp (c' * t / 2) := by
          rw [← Real.exp_add]
          ring_nf
    have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
      have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
        rw [← ht_sq]
        ring
      rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
      linarith
    have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
      rw [← Real.exp_zero]
      exact Real.exp_le_exp.mpr (by positivity)
    have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
      dsimp [K₀]
      linarith
    have hlog1_sq_le : (Real.log X + 1) ^ 2 ≤ K₀ ^ 2 * Real.exp (c' * t) := by
      calc (Real.log X + 1) ^ 2
        _ = (Real.log X + 1) * (Real.log X + 1) := sq _
        _ ≤ (K₀ * Real.exp (c' * t / 2)) * (K₀ * Real.exp (c' * t / 2)) :=
          mul_le_mul hlog1_le_K₀ hlog1_le_K₀ (by positivity) (by positivity)
        _ = K₀ ^ 2 * (Real.exp (c' * t / 2) * Real.exp (c' * t / 2)) := by ring
        _ = K₀ ^ 2 * Real.exp (c' * t) := by
          rw [← Real.exp_add]
          ring_nf
    have hl_le_K₀ : (l : ℝ) ≤ K₀ ^ 2 * Real.exp (2 * c' * t) := by
      calc (l : ℝ)
        _ ≤ z := hl_le_z
        _ = (Real.log X + 1) ^ 2 * Real.exp (c' * t) := rfl
        _ ≤ (K₀ ^ 2 * Real.exp (c' * t)) * Real.exp (c' * t) :=
          mul_le_mul_of_nonneg_right hlog1_sq_le (by positivity)
        _ = K₀ ^ 2 * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
        _ = K₀ ^ 2 * Real.exp (2 * c' * t) := by
          rw [← Real.exp_add]
          ring_nf
    have hexp_M_eq : (M : ℝ) * (2 * c' * t) = t / (2 * c_cell) := by
      dsimp [c']
      have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_rpos
      have hc_ne : c_cell ≠ 0 := ne_of_gt hc_cell_pos
      field_simp [hM_ne, hc_ne]
      ring
    have hl_pow_le : (l : ℝ) ^ M ≤ K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
      calc (l : ℝ) ^ M
        _ ≤ (K₀ ^ 2 * Real.exp (2 * c' * t)) ^ M :=
          pow_le_pow_left₀ (by positivity) hl_le_K₀ M
        _ = K₀ ^ (2 * M) * (Real.exp (2 * c' * t)) ^ M := by
          rw [mul_pow, ← pow_mul]
        _ = K₀ ^ (2 * M) * Real.exp ((M : ℝ) * (2 * c' * t)) := by
          rw [← Real.exp_nat_mul]
        _ = K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
          rw [hexp_M_eq]
    let S_cone : ℝ → ℂ := fun R =>
      ∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              R₁ *
                ((NumberField.mixedEmbedding.stdBasis K).repr
                    (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            (∀ w : NumberField.InfinitePlace K,
              1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
            w₀ (π : K) < R ∧
            IsUnit (Ideal.Quotient.mk q π)},
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    have h_cone_bound : ∀ R : ℝ, 0 ≤ R → R ≤ X →
        ‖S_cone R‖ ≤
          c₁ * Y₀ * Real.exp (-t / c₁) +
          2 * c_sub * Y₀ * Real.exp (-c' * t) +
          c_sub * Y₀ * Real.exp (-t / c_sub) +
          A_cell * Y₀ * Real.exp (-t / (2 * c_cell)) := by
      intro R hR_nonneg hR_le
      let S_cell : (NumberField.InfinitePlace K → Fin l) → ℂ := fun p =>
        ∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧
              ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤
                R ^ (Module.finrank ℚ K) *
                  Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ∧
              (∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  ((NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
              (∀ w : NumberField.InfinitePlace K,
                Real.log (w (π : K) / w₀ (π : K)) ∈
                  Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                    (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
              IsUnit (Ideal.Quotient.mk q π)},
            ψ (Additive.ofMul π.2.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
      set S_sum : ℂ := ∑' p : NumberField.InfinitePlace K → Fin l, S_cell p
      have h_sub_diff :=
        mitsui_prime_char_conical_sector_sub_log_cell_diff_le X hX m hm R₁ R hR_nonneg hR_le k w₀ l hl q hq ψ
      have h_ge_one := hc₁ X hX
      have h_sub := hc_sub X hX l hl hl_log R hR_nonneg hR_le
      have h_sub_le :
          c_sub * Y₀ * ((Real.log X + 1) ^ 2 / (l : ℝ)) + c_sub * Y₀ * Real.exp (-t / c_sub) ≤
          2 * c_sub * Y₀ * Real.exp (-c' * t) + c_sub * Y₀ * Real.exp (-t / c_sub) := by
        have h1 : c_sub * Y₀ * ((Real.log X + 1) ^ 2 / (l : ℝ)) ≤
            c_sub * Y₀ * (2 * Real.exp (-c' * t)) :=
          mul_le_mul_of_nonneg_left h_ratio (by positivity)
        linarith
      have h_diff_bound : ‖S_cone R - S_sum‖ ≤
          c₁ * Y₀ * Real.exp (-t / c₁) +
          2 * c_sub * Y₀ * Real.exp (-c' * t) +
          c_sub * Y₀ * Real.exp (-t / c_sub) := by
        change ‖S_cone R - S_sum‖ ≤ _ at h_sub_diff
        linarith
      have h_cell_each : ∀ p : NumberField.InfinitePlace K → Fin l,
          ‖S_cell p‖ ≤ c_cell * Y₀ * Real.exp (-t / c_cell) := by
        intro p
        have hY_le :
            R ^ (Module.finrank ℚ K) *
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ≤ Y₀ := by
          have h_sum_nonpos :
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) ≤ 0 := by
            apply Finset.sum_nonpos
            intro w _
            have hp_lt : (p w : ℕ) + 1 ≤ l := (p w).isLt
            have hp_rle : ((p w : ℕ) : ℝ) + 1 ≤ (l : ℝ) := by exact_mod_cast hp_lt
            have hp_sub : ((p w : ℕ) : ℝ) + 1 - (l : ℝ) ≤ 0 := by linarith
            have hp_div : (((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ) ≤ 0 :=
              div_nonpos_of_nonpos_of_nonneg hp_sub (le_of_lt hl_rpos)
            exact mul_nonpos_of_nonneg_of_nonpos (Nat.cast_nonneg _) hp_div
          have h_arg_nonpos :
              Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) ≤ 0 :=
            mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlog_pos) h_sum_nonpos
          have h_exp_le_one :
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ≤ 1 :=
            Real.exp_le_one_iff.mpr h_arg_nonpos
          have hR_pow_le : R ^ (Module.finrank ℚ K) ≤ Y₀ :=
            pow_le_pow_left₀ hR_nonneg hR_le (Module.finrank ℚ K)
          calc R ^ (Module.finrank ℚ K) *
                Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))
            _ ≤ R ^ (Module.finrank ℚ K) * 1 :=
              mul_le_mul_of_nonneg_left h_exp_le_one (by positivity)
            _ = R ^ (Module.finrank ℚ K) := mul_one _
            _ ≤ Y₀ := hR_pow_le
        exact hc_cell X hX m hm hm_coarse R₁ hR₁_gt hR₁_le k w₀ l hl p _ hY_le q hq hq_norm ψ hψ hψ_tors
      have h_sum_fintype : S_sum = ∑ p : NumberField.InfinitePlace K → Fin l, S_cell p :=
        tsum_fintype S_cell
      have h_sum_norm_le : ‖S_sum‖ ≤
          (l : ℝ) ^ M * (c_cell * Y₀ * Real.exp (-t / c_cell)) := by
        rw [h_sum_fintype]
        calc ‖∑ p : NumberField.InfinitePlace K → Fin l, S_cell p‖
          _ ≤ ∑ p : NumberField.InfinitePlace K → Fin l, ‖S_cell p‖ :=
              norm_sum_le _ _
          _ ≤ ∑ _p : NumberField.InfinitePlace K → Fin l,
                (c_cell * Y₀ * Real.exp (-t / c_cell)) :=
              Finset.sum_le_sum (fun p _ => h_cell_each p)
          _ = (l : ℝ) ^ M * (c_cell * Y₀ * Real.exp (-t / c_cell)) := by
              simp [M, Finset.sum_const, nsmul_eq_mul, Fintype.card_fin]
      have h_sum_bound : ‖S_sum‖ ≤ A_cell * Y₀ * Real.exp (-t / (2 * c_cell)) := by
        calc ‖S_sum‖
          _ ≤ (l : ℝ) ^ M * (c_cell * Y₀ * Real.exp (-t / c_cell)) := h_sum_norm_le
          _ ≤ (K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell))) *
                (c_cell * Y₀ * Real.exp (-t / c_cell)) :=
              mul_le_mul_of_nonneg_right hl_pow_le (by positivity)
          _ = A_cell * Y₀ * (Real.exp (t / (2 * c_cell)) * Real.exp (-t / c_cell)) := by
              dsimp [A_cell]; ring
          _ = A_cell * Y₀ * Real.exp (-t / (2 * c_cell)) := by
              rw [← Real.exp_add]
              congr 2
              ring
      have h_ident : S_cone R = (S_cone R - S_sum) + S_sum := by ring
      have h_tri : ‖S_cone R‖ ≤ ‖S_cone R - S_sum‖ + ‖S_sum‖ := by
        rw [congrArg norm h_ident]
        exact norm_add_le (S_cone R - S_sum) S_sum
      linarith
    have h_shell_eq :=
      mitsui_prime_char_decoupled_conical_shell_eq_sub_cone X hX m hm R₁ R₀ hR₀₁ hR₁_le k w₀ q ψ
    change _ = S_cone R₁ - S_cone R₀ at h_shell_eq
    rw [h_shell_eq]
    have h_tri_shell : ‖S_cone R₁ - S_cone R₀‖ ≤ ‖S_cone R₁‖ + ‖S_cone R₀‖ :=
      norm_sub_le (S_cone R₁) (S_cone R₀)
    have h_b1 := h_cone_bound R₁ hR₁_nonneg hR₁_le
    have h_b0 := h_cone_bound R₀ hR₀_nonneg hR₀_le
    have hc₁_le : c₁ ≤ c_shell := by
      have : 0 ≤ c₁ + 6 * c_sub + 2 * A_cell + 1 / c' + 2 * c_cell := by positivity
      dsimp [c_shell]; linarith
    have hc'_inv_le : 1 / c' ≤ c_shell := by
      have : 0 ≤ 2 * c₁ + 6 * c_sub + 2 * A_cell + 2 * c_cell := by positivity
      dsimp [c_shell]; linarith
    have hc_sub_le : c_sub ≤ c_shell := by
      have : 0 ≤ 2 * c₁ + 5 * c_sub + 2 * A_cell + 1 / c' + 2 * c_cell := by positivity
      dsimp [c_shell]; linarith
    have h2c_cell_le : 2 * c_cell ≤ c_shell := by
      have : 0 ≤ 2 * c₁ + 6 * c_sub + 2 * A_cell + 1 / c' := by positivity
      dsimp [c_shell]; linarith
    have hexp₁ : Real.exp (-t / c₁) ≤ Real.exp (-t / c_shell) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg hc₁_pos hc₁_le
    have hexp_c' : Real.exp (-c' * t) ≤ Real.exp (-t / c_shell) := by
      have h_eq : -c' * t = -t / (1 / c') := by
        have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
        field_simp [hc'_ne]
      rw [h_eq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg (by positivity) hc'_inv_le
    have hexp_sub : Real.exp (-t / c_sub) ≤ Real.exp (-t / c_shell) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg hc_sub_pos hc_sub_le
    have hexp_cell : Real.exp (-t / (2 * c_cell)) ≤ Real.exp (-t / c_shell) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2c_cell_le
    have hterm₁ : 2 * (c₁ * Y₀ * Real.exp (-t / c₁)) ≤ 2 * c₁ * Y₀ * Real.exp (-t / c_shell) := by
      calc 2 * (c₁ * Y₀ * Real.exp (-t / c₁))
        _ = 2 * c₁ * Y₀ * Real.exp (-t / c₁) := by ring
        _ ≤ 2 * c₁ * Y₀ * Real.exp (-t / c_shell) :=
          mul_le_mul_of_nonneg_left hexp₁ (by positivity)
    have hterm₂ : 2 * (2 * c_sub * Y₀ * Real.exp (-c' * t)) ≤ 4 * c_sub * Y₀ * Real.exp (-t / c_shell) := by
      calc 2 * (2 * c_sub * Y₀ * Real.exp (-c' * t))
        _ = 4 * c_sub * Y₀ * Real.exp (-c' * t) := by ring
        _ ≤ 4 * c_sub * Y₀ * Real.exp (-t / c_shell) :=
          mul_le_mul_of_nonneg_left hexp_c' (by positivity)
    have hterm₃ : 2 * (c_sub * Y₀ * Real.exp (-t / c_sub)) ≤ 2 * c_sub * Y₀ * Real.exp (-t / c_shell) := by
      calc 2 * (c_sub * Y₀ * Real.exp (-t / c_sub))
        _ = 2 * c_sub * Y₀ * Real.exp (-t / c_sub) := by ring
        _ ≤ 2 * c_sub * Y₀ * Real.exp (-t / c_shell) :=
          mul_le_mul_of_nonneg_left hexp_sub (by positivity)
    have hterm₄ : 2 * (A_cell * Y₀ * Real.exp (-t / (2 * c_cell))) ≤ 2 * A_cell * Y₀ * Real.exp (-t / c_shell) := by
      calc 2 * (A_cell * Y₀ * Real.exp (-t / (2 * c_cell)))
        _ = 2 * A_cell * Y₀ * Real.exp (-t / (2 * c_cell)) := by ring
        _ ≤ 2 * A_cell * Y₀ * Real.exp (-t / c_shell) :=
          mul_le_mul_of_nonneg_left hexp_cell (by positivity)
    have h_sum_all_le :
        2 * c₁ * Y₀ * Real.exp (-t / c_shell) +
        4 * c_sub * Y₀ * Real.exp (-t / c_shell) +
        2 * c_sub * Y₀ * Real.exp (-t / c_shell) +
        2 * A_cell * Y₀ * Real.exp (-t / c_shell) ≤
        c_shell * Y₀ * Real.exp (-t / c_shell) := by
      have h_coeff : 2 * c₁ + 4 * c_sub + 2 * c_sub + 2 * A_cell ≤ c_shell := by
        have : 0 ≤ 1 / c' + 2 * c_cell := by positivity
        dsimp [c_shell]; linarith
      have hYE_nonneg : 0 ≤ Y₀ * Real.exp (-t / c_shell) := by positivity
      calc 2 * c₁ * Y₀ * Real.exp (-t / c_shell) +
          4 * c_sub * Y₀ * Real.exp (-t / c_shell) +
          2 * c_sub * Y₀ * Real.exp (-t / c_shell) +
          2 * A_cell * Y₀ * Real.exp (-t / c_shell)
        _ = (2 * c₁ + 4 * c_sub + 2 * c_sub + 2 * A_cell) * (Y₀ * Real.exp (-t / c_shell)) := by ring
        _ ≤ c_shell * (Y₀ * Real.exp (-t / c_shell)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
        _ = c_shell * Y₀ * Real.exp (-t / c_shell) := by ring
    linarith
  · have hR₁_le_one : R₁ ≤ 1 := not_lt.mp hR₁_gt
    haveI : IsEmpty {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            R₁ *
              ((NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) ∈ Set.Ico R₀ R₁ ∧
          IsUnit (Ideal.Quotient.mk q π)} := by
      refine ⟨fun π => ?_⟩
      have h1 : 1 ≤ w₀ (π.1 : K) := (π.2.2.2.1 w₀).1
      have h2 : w₀ (π.1 : K) < R₁ := π.2.2.2.2.1.2
      linarith
    rw [tsum_empty, norm_zero]
    positivity

theorem mitsui_prime_char_grid_cube_place_sector_bound_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_sec : ℝ, 0 < c_sec ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) < Real.exp (Real.sqrt (Real.log X)) →
          ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
            (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                ∀ w : NumberField.InfinitePlace K,
                  NumberField.mixedEmbedding.normAtPlace w z < X) →
            ∀ w₀ : NumberField.InfinitePlace K,
              ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                  (∃ u ∈ NumberField.Units.torsion K,
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
                  ‖∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        (∀ i : NumberField.mixedEmbedding.index K,
                          (NumberField.mixedEmbedding.stdBasis K).repr
                              (NumberField.mixedEmbedding K (π : K)) i ∈
                            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                        (∀ w : NumberField.InfinitePlace K,
                          1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤
                    c_sec * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_sec) :=
by
  obtain ⟨c_col, hc_col_pos, hc_col⟩ := mitsui_prime_grid_cube_collar_diff_bound (K := K)
  obtain ⟨c_shell, hc_shell_pos, hc_shell⟩ :=
    mitsui_prime_char_decoupled_conical_shell_bound_of_torsion_ne_one (K := K) A hA
  set c' : ℝ := 1 / (4 * c_shell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_shell : ℝ := K₀ * c_shell
  have hA_shell_pos : 0 < A_shell := by dsimp [A_shell]; positivity
  let c_sec : ℝ := 3 * c_col + A_shell + 1 / c' + 2 * c_shell
  have hc_sec_pos : 0 < c_sec := by dsimp [c_sec]; positivity
  refine ⟨c_sec, hc_sec_pos, ?_⟩
  intro X hX m hm hm_coarse k hQ_bdd w₀ q hq hq_norm ψ hψ hψ_tors
  have hψ_tors_zero := mitsui_torsion_char_tsum_eq_zero q ψ hψ_tors
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set z : ℝ := (Real.log X + 1) * Real.exp (c' * t)
  set L : ℕ := ⌊z⌋₊
  have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hz_ge : Real.log X + 1 ≤ z := by
    dsimp [z]
    calc Real.log X + 1
      _ = (Real.log X + 1) * 1 := (mul_one _).symm
      _ ≤ (Real.log X + 1) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_left hexp_ge_one (by positivity)
  have hz_lt : z < (L : ℝ) + 1 := Nat.lt_floor_add_one z
  have hlog_lt_L : Real.log X < (L : ℝ) := by linarith
  have hL_rpos : (0 : ℝ) < (L : ℝ) := lt_trans hlog_pos hlog_lt_L
  have hL_pos : 0 < L := Nat.cast_pos.mp hL_rpos
  have hL : 1 ≤ L := hL_pos
  have hL_ge_one : (1 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hz_le_2L : z ≤ 2 * (L : ℝ) := by linarith
  have h_ratio : (Real.log X + 1) / (L : ℝ) ≤ 2 * Real.exp (-c' * t) := by
    rw [div_le_iff₀ hL_rpos]
    calc Real.log X + 1
      _ = z * Real.exp (-c' * t) := by
        dsimp [z]
        rw [mul_assoc, ← Real.exp_add]
        have h0 : c' * t + -c' * t = 0 := by ring
        rw [h0, Real.exp_zero, mul_one]
      _ ≤ (2 * (L : ℝ)) * Real.exp (-c' * t) :=
        mul_le_mul_of_nonneg_right hz_le_2L (by positivity)
      _ = 2 * Real.exp (-c' * t) * (L : ℝ) := by ring
  have hL_le_z : (L : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hexp_half_le : Real.exp (c' * t / 2) ≤ Real.exp (c' * t) := by
    rw [Real.exp_le_exp]
    have : 0 ≤ c' * t := by positivity
    linarith
  have hlog1_le_K₀_full : Real.log X + 1 ≤ K₀ * Real.exp (c' * t) := by
    calc Real.log X + 1
      _ ≤ K₀ * Real.exp (c' * t / 2) := hlog1_le_K₀
      _ ≤ K₀ * Real.exp (c' * t) := mul_le_mul_of_nonneg_left hexp_half_le (by positivity)
  have hexp_2c' : 2 * c' * t = t / (2 * c_shell) := by
    dsimp [c']
    have hc_ne : c_shell ≠ 0 := ne_of_gt hc_shell_pos
    field_simp [hc_ne]
    ring
  have hL_le_K₀ : (L : ℝ) ≤ K₀ * Real.exp (t / (2 * c_shell)) := by
    calc (L : ℝ)
      _ ≤ z := hL_le_z
      _ = (Real.log X + 1) * Real.exp (c' * t) := rfl
      _ ≤ (K₀ * Real.exp (c' * t)) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_right hlog1_le_K₀_full (by positivity)
      _ = K₀ * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
      _ = K₀ * Real.exp (2 * c' * t) := by
        rw [← Real.exp_add]
        ring_nf
      _ = K₀ * Real.exp (t / (2 * c_shell)) := by
        rw [hexp_2c']
  set S_sec : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        (∀ w : NumberField.InfinitePlace K,
          1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let S_shell : Fin L → ℂ := fun j =>
    ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) *
              ((NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) ∈
            Set.Ico ((X / (L : ℝ)) * ((j : ℕ) : ℝ))
              ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_sum : ℂ := ∑ j : Fin L, S_shell j
  have h_sub_diff :=
    mitsui_prime_char_grid_cube_place_sector_radial_shell_diff_le X hX m hm L hL k hQ_bdd w₀ q hq ψ
  have h_col := hc_col X hX m hm L hL k
  have h_col_le :
      c_col * Y * ((Real.log X + 1) / (L : ℝ)) + c_col * Y * Real.exp (-t / c_col) ≤
      2 * c_col * Y * Real.exp (-c' * t) + c_col * Y * Real.exp (-t / c_col) := by
    have h1 : c_col * Y * ((Real.log X + 1) / (L : ℝ)) ≤
        c_col * Y * (2 * Real.exp (-c' * t)) :=
      mul_le_mul_of_nonneg_left h_ratio (by positivity)
    linarith
  have h_diff_bound : ‖S_sec - S_sum‖ ≤
      2 * c_col * Y * Real.exp (-c' * t) +
      c_col * Y * Real.exp (-t / c_col) := by
    change ‖S_sec - S_sum‖ ≤ _ at h_sub_diff
    linarith
  have h_shell_each : ∀ j : Fin L,
      ‖S_shell j‖ ≤ c_shell * Y * Real.exp (-t / c_shell) :=
    fun j => hc_shell X hX m hm hm_coarse L hL j k w₀ q hq hq_norm ψ hψ hψ_tors_zero
  have h_sum_norm_le : ‖S_sum‖ ≤
      (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := by
    dsimp [S_sum]
    calc ‖∑ j : Fin L, S_shell j‖
      _ ≤ ∑ j : Fin L, ‖S_shell j‖ := norm_sum_le _ _
      _ ≤ ∑ _j : Fin L, (c_shell * Y * Real.exp (-t / c_shell)) :=
          Finset.sum_le_sum (fun j _ => h_shell_each j)
      _ = (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := by
          simp [Finset.sum_const, nsmul_eq_mul, Fintype.card_fin]
  have h_sum_bound : ‖S_sum‖ ≤ A_shell * Y * Real.exp (-t / (2 * c_shell)) := by
    calc ‖S_sum‖
      _ ≤ (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := h_sum_norm_le
      _ ≤ (K₀ * Real.exp (t / (2 * c_shell))) *
            (c_shell * Y * Real.exp (-t / c_shell)) :=
          mul_le_mul_of_nonneg_right hL_le_K₀ (by positivity)
      _ = A_shell * Y * (Real.exp (t / (2 * c_shell)) * Real.exp (-t / c_shell)) := by
          dsimp [A_shell]; ring
      _ = A_shell * Y * Real.exp (-t / (2 * c_shell)) := by
          rw [← Real.exp_add]
          congr 2
          ring
  have h_ident : S_sec = (S_sec - S_sum) + S_sum := by ring
  have h_tri : ‖S_sec‖ ≤ ‖S_sec - S_sum‖ + ‖S_sum‖ := by
    rw [congrArg norm h_ident]
    exact norm_add_le (S_sec - S_sum) S_sum
  have hc'_inv_le : 1 / c' ≤ c_sec := by
    have : 0 ≤ 3 * c_col + A_shell + 2 * c_shell := by positivity
    dsimp [c_sec]; linarith
  have hc_col_le : c_col ≤ c_sec := by
    have : 0 ≤ 2 * c_col + A_shell + 1 / c' + 2 * c_shell := by positivity
    dsimp [c_sec]; linarith
  have h2c_shell_le : 2 * c_shell ≤ c_sec := by
    have : 0 ≤ 3 * c_col + A_shell + 1 / c' := by positivity
    dsimp [c_sec]; linarith
  have hexp_c' : Real.exp (-c' * t) ≤ Real.exp (-t / c_sec) := by
    have h_eq : -c' * t = -t / (1 / c') := by
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      field_simp [hc'_ne]
    rw [h_eq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) hc'_inv_le
  have hexp_col : Real.exp (-t / c_col) ≤ Real.exp (-t / c_sec) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_col_pos hc_col_le
  have hexp_shell : Real.exp (-t / (2 * c_shell)) ≤ Real.exp (-t / c_sec) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2c_shell_le
  have hterm₁ : 2 * c_col * Y * Real.exp (-c' * t) ≤ 2 * c_col * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₂ : c_col * Y * Real.exp (-t / c_col) ≤ c_col * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_col (by positivity)
  have hterm₃ : A_shell * Y * Real.exp (-t / (2 * c_shell)) ≤ A_shell * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_shell (by positivity)
  have h_sum_all_le :
      2 * c_col * Y * Real.exp (-t / c_sec) +
      c_col * Y * Real.exp (-t / c_sec) +
      A_shell * Y * Real.exp (-t / c_sec) ≤
      c_sec * Y * Real.exp (-t / c_sec) := by
    have h_coeff : 2 * c_col + c_col + A_shell ≤ c_sec := by
      have : 0 ≤ 1 / c' + 2 * c_shell := by positivity
      dsimp [c_sec]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-t / c_sec) := by positivity
    calc 2 * c_col * Y * Real.exp (-t / c_sec) +
        c_col * Y * Real.exp (-t / c_sec) +
        A_shell * Y * Real.exp (-t / c_sec)
      _ = (2 * c_col + c_col + A_shell) * (Y * Real.exp (-t / c_sec)) := by ring
      _ ≤ c_sec * (Y * Real.exp (-t / c_sec)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c_sec * Y * Real.exp (-t / c_sec) := by ring
  linarith

theorem mitsui_prime_char_grid_cube_bound_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cube : ℝ, 0 < c_cube ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ X →
          ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
            (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                ∀ w : NumberField.InfinitePlace K,
                  NumberField.mixedEmbedding.normAtPlace w z < X) →
            ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
              (Ideal.absNorm q : ℝ) < Real.log X ^ A →
              ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                (∃ u ∈ NumberField.Units.torsion K,
                  ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
                ‖∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧
                      (∀ i : NumberField.mixedEmbedding.index K,
                        (NumberField.mixedEmbedding.stdBasis K).repr
                            (NumberField.mixedEmbedding K (π : K)) i ∈
                          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    ψ (Additive.ofMul π.2.2.2.unit) *
                      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                  ≤ c_cube * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cube) :=
by
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_cube_upper_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_box_ge_one_to_place_sectors (K := K)
  obtain ⟨c_sec, hc_sec_pos, hc_sec⟩ :=
    mitsui_prime_char_grid_cube_place_sector_bound_of_torsion_ne_one (K := K) A hA
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  set M_card : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
  have hM_nonneg : 0 ≤ M_card := by dsimp [M_card]; positivity
  let c_sum : ℝ := 17 * c_pack + c₁ + c₂ + M_card * c_sec + c_sec
  have hc_sum_pos : 0 < c_sum := by dsimp [c_sum]; positivity
  let c_cube : ℝ := max 2 c_sum
  have h_two_le_c : 2 ≤ c_cube := le_max_left _ _
  have hc_sum_le_c : c_sum ≤ c_cube := le_max_right _ _
  have hc_cube_pos : 0 < c_cube := lt_of_lt_of_le (by norm_num) h_two_le_c
  refine ⟨c_cube, hc_cube_pos, ?_⟩
  intro X hX m hm hm_le_X k hQ_bdd q hq hq_norm ψ hψ hψ_tors
  have hX_pos : 0 < X := by linarith
  set Y : ℝ := X ^ n
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hY_nonneg : 0 ≤ Y := le_of_lt hY_pos
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  rcases le_or_gt (Real.exp u) (m : ℝ) with hm_fine | hm_coarse
  · have h_norm_le := mitsui_prime_char_grid_cube_norm_le_uncond (K := K) X hX m hm k hQ_bdd q hq ψ
    have h_pack_le := hc_pack X hX m hm hm_le_X k hQ_bdd
    have h_le1 := le_trans h_norm_le h_pack_le
    have hm_pow_ge : (m : ℝ) ≤ (m : ℝ) ^ n := by
      calc (m : ℝ) = (m : ℝ) ^ 1 := (pow_one _).symm
        _ ≤ (m : ℝ) ^ n := pow_le_pow_right₀ hmR_ge_one hn_ge_one
    have hexp_le_mn : Real.exp u ≤ (m : ℝ) ^ n := le_trans hm_fine hm_pow_ge
    have h_vol_le : (X / (m : ℝ)) ^ n ≤ Y * Real.exp (-u) := by
      rw [div_pow]
      have h_div : Y / (m : ℝ) ^ n ≤ Y / Real.exp u :=
        div_le_div_of_nonneg_left hY_nonneg (Real.exp_pos u) hexp_le_mn
      have h_eq : Y / Real.exp u = Y * Real.exp (-u) := by
        rw [Real.exp_neg, div_eq_mul_inv]
      exact le_of_le_of_eq h_div h_eq
    have h_log_le : Real.log X + 1 ≤ 17 * Real.exp (u / 2) := by
      have h_exp4 : u / 4 ≤ Real.exp (u / 4) := by
        have h := Real.add_one_le_exp (u / 4)
        linarith
      have h_sq4 : (u / 4) ^ 2 ≤ (Real.exp (u / 4)) ^ 2 :=
        pow_le_pow_left₀ (by positivity) h_exp4 2
      have h_exp_sq : (Real.exp (u / 4)) ^ 2 = Real.exp (u / 2) := by
        rw [sq, ← Real.exp_add]
        ring_nf
      rw [h_exp_sq] at h_sq4
      have h_u_sq : Real.log X ≤ 16 * Real.exp (u / 2) := by
        calc Real.log X = u ^ 2 := hu_sq.symm
          _ = 16 * (u / 4) ^ 2 := by ring
          _ ≤ 16 * Real.exp (u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
      have h_one_le : 1 ≤ Real.exp (u / 2) := Real.one_le_exp (by positivity)
      linarith
    have hexp_prod : Real.exp (-u) * Real.exp (u / 2) = Real.exp (-u / 2) := by
      rw [← Real.exp_add]
      ring_nf
    have hexp_c : Real.exp (-u / 2) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg (by norm_num) h_two_le_c
    have h_17_le : 17 * c_pack ≤ c_cube := by
      have : 17 * c_pack ≤ c_sum := by
        have : 0 ≤ c₁ + c₂ + M_card * c_sec + c_sec := by positivity
        dsimp [c_sum]; linarith
      exact le_trans this hc_sum_le_c
    calc ‖∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            IsUnit (Ideal.Quotient.mk q π)},
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
      _ ≤ c_pack * (X / (m : ℝ)) ^ n * (Real.log X + 1) := h_le1
      _ ≤ c_pack * (Y * Real.exp (-u)) * (17 * Real.exp (u / 2)) := by
          have h1 : c_pack * (X / (m : ℝ)) ^ n ≤ c_pack * (Y * Real.exp (-u)) :=
            mul_le_mul_of_nonneg_left h_vol_le (le_of_lt hc_pack_pos)
          exact mul_le_mul h1 h_log_le (by positivity) (by positivity)
      _ = (17 * c_pack) * Y * (Real.exp (-u) * Real.exp (u / 2)) := by ring
      _ = (17 * c_pack) * Y * Real.exp (-u / 2) := by rw [hexp_prod]
      _ ≤ (17 * c_pack) * Y * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp_c (by positivity)
      _ = (17 * c_pack) * (Y * Real.exp (-u / c_cube)) := by ring
      _ ≤ c_cube * (Y * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right h_17_le (by positivity)
      _ = c_cube * Y * Real.exp (-u / c_cube) := by ring
  · set S₁ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    set S₂ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    let S_sec : NumberField.InfinitePlace K → ℂ := fun w₀ =>
      ∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            (∀ w : NumberField.InfinitePlace K,
              1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
            IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    set S₃ : ℂ := ∑ w₀ : NumberField.InfinitePlace K, S_sec w₀
    have h1_le := mitsui_prime_char_grid_cube_to_ge_one_le (K := K) X hX m hm k hQ_bdd q hq ψ
    have h1_uncond := hc₁ X hX
    have h1 : ‖S₁ - S₂‖ ≤ c₁ * Y * Real.exp (-u / c₁) :=
      le_trans h1_le h1_uncond
    have h2_le := mitsui_prime_char_grid_cube_ge_one_to_place_sectors_le (K := K) X hX m hm k hQ_bdd q hq ψ
    have h2_uncond := hc₂ X hX
    have h2 : ‖S₂ - S₃‖ ≤ c₂ * Y * Real.exp (-u / c₂) :=
      le_trans h2_le h2_uncond
    have h3 : ∀ w₀ : NumberField.InfinitePlace K,
        ‖S_sec w₀‖ ≤ c_sec * Y * Real.exp (-u / c_sec) :=
      fun w₀ => hc_sec X hX m hm hm_coarse k hQ_bdd w₀ q hq hq_norm ψ hψ hψ_tors
    have h_norm3 : ‖S₃‖ ≤ M_card * (c_sec * Y * Real.exp (-u / c_sec)) := by
      dsimp [S₃]
      calc ‖∑ w₀ : NumberField.InfinitePlace K, S_sec w₀‖
        _ ≤ ∑ w₀ : NumberField.InfinitePlace K, ‖S_sec w₀‖ := norm_sum_le _ _
        _ ≤ ∑ _w₀ : NumberField.InfinitePlace K, (c_sec * Y * Real.exp (-u / c_sec)) :=
            Finset.sum_le_sum (fun w₀ _ => h3 w₀)
        _ = M_card * (c_sec * Y * Real.exp (-u / c_sec)) := by
            simp [M_card, Finset.sum_const, nsmul_eq_mul]
    have h_ident : S₁ = (S₁ - S₂) + (S₂ - S₃) + S₃ := by ring
    have h_tri : ‖S₁‖ ≤ ‖S₁ - S₂‖ + ‖S₂ - S₃‖ + ‖S₃‖ := by
      rw [congrArg norm h_ident]
      have ht1 := norm_add_le ((S₁ - S₂) + (S₂ - S₃)) S₃
      have ht2 := norm_add_le (S₁ - S₂) (S₂ - S₃)
      linarith
    have hc₁_le : c₁ ≤ c_cube := by
      have : c₁ ≤ c_sum := by
        have : 0 ≤ 17 * c_pack + c₂ + M_card * c_sec + c_sec := by positivity
        dsimp [c_sum]; linarith
      exact le_trans this hc_sum_le_c
    have hc₂_le : c₂ ≤ c_cube := by
      have : c₂ ≤ c_sum := by
        have : 0 ≤ 17 * c_pack + c₁ + M_card * c_sec + c_sec := by positivity
        dsimp [c_sum]; linarith
      exact le_trans this hc_sum_le_c
    have hc_sec_le : c_sec ≤ c_cube := by
      have : c_sec ≤ c_sum := by
        have : 0 ≤ 17 * c_pack + c₁ + c₂ + M_card * c_sec := by positivity
        dsimp [c_sum]; linarith
      exact le_trans this hc_sum_le_c
    have hexp1 : Real.exp (-u / c₁) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc₁_pos hc₁_le
    have hexp2 : Real.exp (-u / c₂) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc₂_pos hc₂_le
    have hexp3 : Real.exp (-u / c_sec) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc_sec_pos hc_sec_le
    have hterm1 : ‖S₁ - S₂‖ ≤ c₁ * Y * Real.exp (-u / c_cube) := by
      calc ‖S₁ - S₂‖ ≤ c₁ * Y * Real.exp (-u / c₁) := h1
        _ ≤ c₁ * Y * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp1 (by positivity)
    have hterm2 : ‖S₂ - S₃‖ ≤ c₂ * Y * Real.exp (-u / c_cube) := by
      calc ‖S₂ - S₃‖ ≤ c₂ * Y * Real.exp (-u / c₂) := h2
        _ ≤ c₂ * Y * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp2 (by positivity)
    have hterm3 : ‖S₃‖ ≤ (M_card * c_sec) * Y * Real.exp (-u / c_cube) := by
      calc ‖S₃‖ ≤ M_card * (c_sec * Y * Real.exp (-u / c_sec)) := h_norm3
        _ ≤ M_card * (c_sec * Y * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) hM_nonneg
        _ = (M_card * c_sec) * Y * Real.exp (-u / c_cube) := by ring
    have h_sum_le :
        c₁ * Y * Real.exp (-u / c_cube) +
        c₂ * Y * Real.exp (-u / c_cube) +
        (M_card * c_sec) * Y * Real.exp (-u / c_cube) ≤
        c_cube * Y * Real.exp (-u / c_cube) := by
      have h_coeff : c₁ + c₂ + M_card * c_sec ≤ c_cube := by
        have : c₁ + c₂ + M_card * c_sec ≤ c_sum := by
          have : 0 ≤ 17 * c_pack + c_sec := by positivity
          dsimp [c_sum]; linarith
        exact le_trans this hc_sum_le_c
      have hYE_nonneg : 0 ≤ Y * Real.exp (-u / c_cube) := by positivity
      calc c₁ * Y * Real.exp (-u / c_cube) +
          c₂ * Y * Real.exp (-u / c_cube) +
          (M_card * c_sec) * Y * Real.exp (-u / c_cube)
        _ = (c₁ + c₂ + M_card * c_sec) * (Y * Real.exp (-u / c_cube)) := by ring
        _ ≤ c_cube * (Y * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
        _ = c_cube * Y * Real.exp (-u / c_cube) := by ring
    linarith

theorem mitsui_prime_char_convex_bound_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∃ u ∈ NumberField.Units.torsion K,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
              ‖∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_partition_diff_le_boundary (K := K)
  obtain ⟨c_cube, hc_cube_pos, hc_cube⟩ := mitsui_prime_char_grid_cube_bound_of_torsion_ne_one (K := K) A hA
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hnR_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hnR_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  let c' : ℝ := min (1 / 2) (1 / (2 * (n : ℝ) * c_cube))
  have hc'_pos : 0 < c' := lt_min (by norm_num) (by positivity)
  have hc'_le_half : c' ≤ 1 / 2 := min_le_left _ _
  have hc'_le_cube : c' ≤ 1 / (2 * (n : ℝ) * c_cube) := min_le_right _ _
  let A_bdry : ℝ := 2 * c_pack * (2 : ℝ) ^ (3 * n) * (16 / c' ^ 2 + 1)
  have hA_bdry_pos : 0 < A_bdry := by dsimp [A_bdry]; positivity
  let A_int : ℝ := (2 : ℝ) ^ n * c_cube
  have hA_int_pos : 0 < A_int := by dsimp [A_int]; positivity
  let c₁ : ℝ := max (2 / c') (A_bdry + A_int)
  have hc₁_pos : 0 < c₁ := lt_of_lt_of_le (by positivity) (le_max_left _ _)
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ hψ_tors
  have hX_pos : 0 < X := by linarith
  have hYn_pos : 0 < X ^ n := by positivity
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  set m : ℕ := ⌊Real.exp (c' * u)⌋₊
  have hcu_pos : 0 < c' * u := mul_pos hc'_pos hu_pos
  have hexp_gt_one : 1 < Real.exp (c' * u) := Real.one_lt_exp_iff.mpr hcu_pos
  have hm_ge_one : 1 ≤ m := Nat.floor_pos.mpr (le_of_lt hexp_gt_one)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  have hmR_ne : (m : ℝ) ≠ 0 := ne_of_gt hmR_pos
  have hm_le_exp : (m : ℝ) ≤ Real.exp (c' * u) := Nat.floor_le (Real.exp_nonneg _)
  have hexp_lt_m1 : Real.exp (c' * u) < (m : ℝ) + 1 := Nat.lt_floor_add_one _
  have hexp_le_2m : Real.exp (c' * u) ≤ 2 * (m : ℝ) := by linarith
  have h_minv_le : (m : ℝ)⁻¹ ≤ 2 * Real.exp (-c' * u) := by
    rw [inv_eq_one_div, div_le_iff₀ hmR_pos]
    calc (1 : ℝ) = Real.exp (c' * u) * Real.exp (-c' * u) := by
          rw [← Real.exp_add, neg_mul, add_neg_cancel, Real.exp_zero]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * u) :=
          mul_le_mul_of_nonneg_right hexp_le_2m (Real.exp_nonneg _)
      _ = 2 * Real.exp (-c' * u) * (m : ℝ) := by ring
  have hm_le_X : (m : ℝ) ≤ X := by
    rcases lt_or_ge u 1 with hu_lt | hu_ge
    · have hcu_lt : c' * u < Real.log 2 := by
        have h1 : c' * u < (1 / 2 : ℝ) * 1 := by
          calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
            _ < (1 / 2) * 1 := mul_lt_mul_of_pos_left hu_lt (by norm_num)
        have h2 := Real.log_two_gt_d9
        linarith
      have hexp_lt_two : Real.exp (c' * u) < 2 := by
        calc Real.exp (c' * u) < Real.exp (Real.log 2) := Real.exp_lt_exp.mpr hcu_lt
          _ = 2 := Real.exp_log (by norm_num)
      have hm_lt_two : m < 2 := (Nat.floor_lt (Real.exp_nonneg _)).mpr hexp_lt_two
      have hm_eq_one : m = 1 := by omega
      rw [hm_eq_one, Nat.cast_one]
      exact le_of_lt hX
    · have hcu_le_log : c' * u ≤ Real.log X := by
        calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
          _ ≤ 1 * u := by linarith
          _ = u * 1 := by ring
          _ ≤ u * u := mul_le_mul_of_nonneg_left hu_ge hu_nonneg
          _ = u ^ 2 := by ring
          _ = Real.log X := hu_sq
      calc (m : ℝ) ≤ Real.exp (c' * u) := hm_le_exp
        _ ≤ Real.exp (Real.log X) := Real.exp_le_exp.mpr hcu_le_log
        _ = X := Real.exp_log hX_pos
  have h1 := mitsui_convex_grid_boundary_card_bound X hX m hm_ge_one C hC_conv hC_open
  have h2 := hc_pack X hX m hm_ge_one hm_le_X C hC_bdd
  have h3 := mitsui_prime_char_grid_partition_diff_le_uncond X hX m hm_ge_one C hC_bdd q hq ψ
  set Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set S_C : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℂ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_grid : ℂ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q k.1
  set S_C_uncond : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_Q_uncond : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℝ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        ∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_grid_uncond : ℝ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q_uncond k.1
  set B_card : ℝ := (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
    (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)} : ℝ)
  have h1' : B_card ≤ (2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1) := h1
  have h2' : |S_C_uncond - S_grid_uncond| ≤ c_pack * B_card * (X / (m : ℝ)) ^ n * (Real.log X + 1) := h2
  have h3' : ‖S_C - S_grid‖ ≤ |S_C_uncond - S_grid_uncond| := h3
  have h_pow_cancel : (m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n = X ^ n * (m : ℝ)⁻¹ := by
    have hm_pow : (m : ℝ) ^ n = (m : ℝ) ^ (n - 1) * (m : ℝ) := by
      rw [← pow_succ, Nat.sub_add_cancel hn_ge_one]
    rw [div_pow, hm_pow]
    field_simp [hmR_ne]
  have h_bdry_vol : B_card * (X / (m : ℝ)) ^ n ≤ (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by
    calc B_card * (X / (m : ℝ)) ^ n
      _ ≤ ((2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1)) * (X / (m : ℝ)) ^ n :=
          mul_le_mul_of_nonneg_right h1' (by positivity)
      _ = (2 : ℝ) ^ (3 * n) * ((m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n) := by ring
      _ = (2 : ℝ) ^ (3 * n) * (X ^ n * (m : ℝ)⁻¹) := by rw [h_pow_cancel]
      _ = (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by ring
  have h_bdry1 : ‖S_C - S_grid‖ ≤
      c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    calc ‖S_C - S_grid‖ ≤ |S_C_uncond - S_grid_uncond| := h3'
      _ ≤ c_pack * (B_card * (X / (m : ℝ)) ^ n) * (Real.log X + 1) := by
          linarith [h2']
      _ ≤ c_pack * ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) * (Real.log X + 1) := by
          gcongr
      _ = c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by ring
  have h_log_le : Real.log X + 1 ≤ (16 / c' ^ 2 + 1) * Real.exp (c' * u / 2) := by
    have h_exp4 : c' * u / 4 ≤ Real.exp (c' * u / 4) := by
      have h := Real.add_one_le_exp (c' * u / 4)
      linarith
    have h_sq4 : (c' * u / 4) ^ 2 ≤ (Real.exp (c' * u / 4)) ^ 2 :=
      pow_le_pow_left₀ (by positivity) h_exp4 2
    have h_exp_sq : (Real.exp (c' * u / 4)) ^ 2 = Real.exp (c' * u / 2) := by
      rw [sq, ← Real.exp_add]
      ring_nf
    rw [h_exp_sq] at h_sq4
    have hc'_sq_pos : 0 < c' ^ 2 := by positivity
    have h_u_sq_le : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * u / 2) := by
      rw [← hu_sq, div_mul_eq_mul_div, le_div_iff₀ hc'_sq_pos]
      calc u ^ 2 * c' ^ 2 = 16 * (c' * u / 4) ^ 2 := by ring
        _ ≤ 16 * Real.exp (c' * u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
    have h_one_le : 1 ≤ Real.exp (c' * u / 2) :=
      Real.one_le_exp (by positivity)
    linarith
  have h_minv_log : (m : ℝ)⁻¹ * (Real.log X + 1) ≤
      2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₁) := by
    have hexp_prod : Real.exp (-c' * u) * Real.exp (c' * u / 2) = Real.exp (-c' * u / 2) := by
      rw [← Real.exp_add]
      ring_nf
    have h_exp_c1 : Real.exp (-c' * u / 2) ≤ Real.exp (-u / c₁) := by
      rw [Real.exp_le_exp]
      have h_c1_ge : 2 / c' ≤ c₁ := le_max_left _ _
      have h_div_le : u / c₁ ≤ u / (2 / c') :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_c1_ge
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      have h_eq : u / (2 / c') = c' * u / 2 := by field_simp [hc'_ne]
      have h_neg1 : -c' * u / 2 = -(c' * u / 2) := by ring
      have h_neg2 : -u / c₁ = -(u / c₁) := by ring
      linarith
    calc (m : ℝ)⁻¹ * (Real.log X + 1)
      _ ≤ (2 * Real.exp (-c' * u)) * ((16 / c' ^ 2 + 1) * Real.exp (c' * u / 2)) :=
          mul_le_mul h_minv_le h_log_le (by positivity) (by positivity)
      _ = 2 * (16 / c' ^ 2 + 1) * (Real.exp (-c' * u) * Real.exp (c' * u / 2)) := by ring
      _ = 2 * (16 / c' ^ 2 + 1) * Real.exp (-c' * u / 2) := by rw [hexp_prod]
      _ ≤ 2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₁) :=
          mul_le_mul_of_nonneg_left h_exp_c1 (by positivity)
  have h_bdry_bound : ‖S_C - S_grid‖ ≤ A_bdry * X ^ n * Real.exp (-u / c₁) := by
    calc ‖S_C - S_grid‖
      _ ≤ c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * ((m : ℝ)⁻¹ * (Real.log X + 1)) := by
          linarith [h_bdry1]
      _ ≤ c_pack * (2 : ℝ) ^ (3 * n) * X ^ n *
            (2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₁)) :=
          mul_le_mul_of_nonneg_left h_minv_log (by positivity)
      _ = A_bdry * X ^ n * Real.exp (-u / c₁) := by
          dsimp [A_bdry]
          ring
  have h_int : ‖S_grid‖ ≤ A_int * X ^ n * Real.exp (-u / c₁) := by
    classical
    set I_sub := {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C}
    have hS_grid_eq : S_grid = ∑ k : I_sub, S_Q k.1 := tsum_fintype _
    have h_term_le : ∀ k ∈ (Finset.univ : Finset I_sub),
        ‖S_Q k.1‖ ≤ c_cube * X ^ n * Real.exp (-u / c_cube) := by
      intro k _
      exact hc_cube X hX m hm_ge_one hm_le_X k.1 (fun z hz w => hC_bdd z (k.2 hz) w)
        q hq hq_norm ψ hψ hψ_tors
    have h_norm_sum : ‖S_grid‖ ≤
        (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
      rw [hS_grid_eq]
      calc ‖∑ k : I_sub, S_Q k.1‖
        _ ≤ ∑ k : I_sub, ‖S_Q k.1‖ := norm_sum_le _ _
        _ ≤ ∑ _k : I_sub, (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
            Finset.sum_le_sum h_term_le
        _ = (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
            simp
    have hcard_idx : Fintype.card (NumberField.mixedEmbedding.index K) = n := by
      rw [← Module.finrank_eq_card_basis (NumberField.mixedEmbedding.stdBasis K),
          NumberField.mixedEmbedding.finrank K]
    have hcard_le : Fintype.card I_sub ≤ (2 * m) ^ n := by
      calc Fintype.card I_sub
        _ ≤ Fintype.card (NumberField.mixedEmbedding.index K → Fin (2 * m)) :=
            Fintype.card_subtype_le _
        _ = (2 * m) ^ n := by
            rw [Fintype.card_fun, Fintype.card_fin, hcard_idx]
    have hcardR_le : (Fintype.card I_sub : ℝ) ≤ (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
      calc (Fintype.card I_sub : ℝ)
        _ ≤ ((2 * m : ℕ) : ℝ) ^ n := by exact_mod_cast hcard_le
        _ = (2 : ℝ) ^ n * (m : ℝ) ^ n := by push_cast; rw [mul_pow]
        _ ≤ (2 : ℝ) ^ n * (Real.exp (c' * u)) ^ n :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hm_le_exp n) (by positivity)
        _ = (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
            rw [← Real.exp_nat_mul]
    have h_exp_int : Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube) ≤
        Real.exp (-u / c₁) := by
      rw [← Real.exp_add, Real.exp_le_exp]
      have h_nc' : (n : ℝ) * c' ≤ 1 / (2 * c_cube) := by
        calc (n : ℝ) * c' ≤ (n : ℝ) * (1 / (2 * (n : ℝ) * c_cube)) :=
              mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          _ = 1 / (2 * c_cube) := by
              have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
              field_simp [hn_ne]
      have h_nc'u : (n : ℝ) * (c' * u) ≤ u / (2 * c_cube) := by
        calc (n : ℝ) * (c' * u) = ((n : ℝ) * c') * u := by ring
          _ ≤ (1 / (2 * c_cube)) * u := mul_le_mul_of_nonneg_right h_nc' hu_nonneg
          _ = u / (2 * c_cube) := by ring
      have h_c1_ge : 2 * c_cube ≤ c₁ := by
        have h1 : 2 * c_cube ≤ 2 * (n : ℝ) * c_cube := by
          calc 2 * c_cube = 2 * 1 * c_cube := by ring
            _ ≤ 2 * (n : ℝ) * c_cube := by gcongr
        have h2 : 2 * (n : ℝ) * c_cube ≤ 2 / c' := by
          rw [le_div_iff₀ hc'_pos]
          have h3 : 2 * (n : ℝ) * c_cube * c' ≤ 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) :=
            mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          have h4 : 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) = 1 := by
            have h_ne : 2 * (n : ℝ) * c_cube ≠ 0 := by positivity
            field_simp [h_ne]
          linarith
        exact le_trans (le_trans h1 h2) (le_max_left _ _)
      have h_div_c1 : u / c₁ ≤ u / (2 * c_cube) :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_c1_ge
      have h_sub_eq : u / (2 * c_cube) + -u / c_cube = -(u / (2 * c_cube)) := by ring
      have h_neg_c1 : -u / c₁ = -(u / c₁) := by ring
      linarith
    calc ‖S_grid‖
      _ ≤ (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := h_norm_sum
      _ ≤ ((2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u))) *
            (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right hcardR_le (by positivity)
      _ = A_int * X ^ n * (Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube)) := by
          dsimp [A_int]; ring
      _ ≤ A_int * X ^ n * Real.exp (-u / c₁) :=
          mul_le_mul_of_nonneg_left h_exp_int (by positivity)
  have h_ident : S_C = (S_C - S_grid) + S_grid := by ring
  have h_tri : ‖S_C‖ ≤ ‖S_C - S_grid‖ + ‖S_grid‖ := by
    rw [congrArg norm h_ident]
    exact norm_add_le (S_C - S_grid) S_grid
  have h_A_le : A_bdry + A_int ≤ c₁ := le_max_right _ _
  calc ‖S_C‖
    _ ≤ ‖S_C - S_grid‖ + ‖S_grid‖ := h_tri
    _ ≤ A_bdry * X ^ n * Real.exp (-u / c₁) + A_int * X ^ n * Real.exp (-u / c₁) :=
        add_le_add h_bdry_bound h_int
    _ = (A_bdry + A_int) * (X ^ n * Real.exp (-u / c₁)) := by ring
    _ ≤ c₁ * (X ^ n * Real.exp (-u / c₁)) :=
        mul_le_mul_of_nonneg_right h_A_le (by positivity)
    _ = c₁ * X ^ n * Real.exp (-u / c₁) := by ring

theorem mitsui_prime_box_upper_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_box : ℝ, 0 < c_box ∧
      ∀ X : ℝ, 1 < X →
        |∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)| ≤
          c_box * X ^ (Module.finrank ℚ K) * (Real.log X + 1) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  have hF_bdd : Bornology.IsBounded F :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
  have hD_pos : 0 < D := by linarith
  have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w z < D := by
    intro z hz w
    have hz_norm : ‖z‖ < D := by
      have h1 := hF_ball hz
      rwa [Metric.mem_ball, dist_zero_right] at h1
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
      have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
      have h2 : ‖z.1‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_left _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
      have h1 : ‖z.2 ⟨w, hw⟩‖ ≤ ‖z.2‖ := norm_le_pi_norm z.2 ⟨w, hw⟩
      have h2 : ‖z.2‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_right _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
  have hF_fund : MeasureTheory.IsAddFundamentalDomain
      (NumberField.mixedEmbedding.integerLattice K) F MeasureTheory.volume :=
    NumberField.mixedEmbedding.fundamentalDomain_integerLattice K
  have hF_meas : MeasurableSet F :=
    ZSpan.fundamentalDomain_measurableSet (NumberField.mixedEmbedding.latticeBasis K)
  let V_K : ℝ := (MeasureTheory.volume F).toReal
  have hVK_pos : 0 < V_K := by
    dsimp [V_K, F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal]
    have hdiscr : NumberField.discr K ≠ 0 := NumberField.discr_ne_zero K
    have hsqrt_pos : (0 : NNReal) < NNReal.sqrt ‖NumberField.discr K‖₊ :=
      NNReal.sqrt_pos.mpr (nnnorm_pos.mpr hdiscr)
    have hsqrt_rpos : (0 : ℝ) < (NNReal.sqrt ‖NumberField.discr K‖₊ : ℝ) :=
      NNReal.coe_pos.mpr hsqrt_pos
    have h2 : (0 : ℝ) < ENNReal.toReal 2⁻¹ := by norm_num
    positivity
  let n : ℕ := Module.finrank ℚ K
  let C₀ : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ n / V_K
  let c_box : ℝ := max 1 ((n : ℝ) * C₀)
  have hc_box_pos : 0 < c_box := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  have hc_box_ge : (n : ℝ) * C₀ ≤ c_box := le_max_right _ _
  refine ⟨c_box, hc_box_pos, ?_⟩
  intro X hX
  have hX_pos : 0 < X := by linarith
  
  let B_X : Set (NumberField.RingOfIntegers K) :=
    {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hBX_fin : B_X.Finite := by
    have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ X
    have hsub : B_X ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X} := by
      intro x hx
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
        NumberField.InfinitePlace.apply φ (x : K)
      have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < X := hx (NumberField.InfinitePlace.mk φ)
      change ‖φ (x : K)‖ ≤ X
      linarith
    exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
  let Q : Set (NumberField.RingOfIntegers K) :=
    {π | Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
  have hQ_fin : Q.Finite := hBX_fin.subset (fun _ hx => hx.2)
  letI : Fintype Q := hQ_fin.fintype
  let g : NumberField.RingOfIntegers K → ℝ :=
    fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
  have hsumQ : (∑' π : Q, g π) = ∑ π ∈ hQ_fin.toFinset, g π := by
    rw [tsum_fintype]
    exact (Finset.sum_subtype hQ_fin.toFinset (fun _ => hQ_fin.mem_toFinset) g).symm
  change |∑' π : Q, g π| ≤ c_box * X ^ n * (Real.log X + 1)
  rw [hsumQ]
  have hg_nonneg : ∀ π ∈ hQ_fin.toFinset, 0 ≤ g π := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : 1 ≤ (Algebra.norm ℤ π).natAbs :=
      Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hnorm_ne)
    exact Real.log_nonneg (by exact_mod_cast hnat_pos)
  have hg_le : ∀ π ∈ hQ_fin.toFinset, g π ≤ (n : ℝ) * (Real.log X + 1) := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : (0 : ℝ) < (Algebra.norm ℤ π).natAbs := by
      exact_mod_cast Int.natAbs_pos.mpr hnorm_ne
    have hprod_eq : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) =
        ((Algebra.norm ℤ π).natAbs : ℝ) := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm (π : K), ← Algebra.coe_norm_int π]
      rw [Nat.cast_natAbs]
      norm_cast
    have hprod_le : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X ^ n := by
      rw [← hprod_eq]
      have h1 : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
        apply Finset.prod_le_prod
        · intro w _
          positivity
        · intro w _
          exact pow_le_pow_left₀ (by positivity) (le_of_lt (hπ.2 w)) w.mult
      rwa [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    have hlog_le : g π ≤ Real.log (X ^ n) := Real.log_le_log hnat_pos hprod_le
    rw [Real.log_pow] at hlog_le
    have h_log_add : (n : ℝ) * Real.log X ≤ (n : ℝ) * (Real.log X + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg n)
    exact le_trans hlog_le h_log_add
  rw [abs_of_nonneg (Finset.sum_nonneg hg_nonneg)]
  have h_s2_bound : ∑ π ∈ hQ_fin.toFinset, g π ≤
      (hQ_fin.toFinset.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := by
    calc ∑ π ∈ hQ_fin.toFinset, g π
        ≤ ∑ _π ∈ hQ_fin.toFinset, ((n : ℝ) * (Real.log X + 1)) := Finset.sum_le_sum hg_le
      _ = (hQ_fin.toFinset.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
  
  let j : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.integerLattice K :=
    fun x => ⟨NumberField.mixedEmbedding K (x : K), ⟨x, rfl⟩⟩
  have hj_inj : Function.Injective j := by
    intro x y hxy
    have h : NumberField.mixedEmbedding K (x : K) = NumberField.mixedEmbedding K (y : K) :=
      congrArg Subtype.val hxy
    obtain ⟨w⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
    have hsub : NumberField.mixedEmbedding K ((x : K) - (y : K)) = 0 := by
      rw [map_sub, h, sub_self]
    have hw : w ((x : K) - (y : K)) = 0 := by
      rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K) - (y : K)), hsub, map_zero]
    exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
  let T := hQ_fin.toFinset
  let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
  let f : NumberField.InfinitePlace K → NNReal :=
    fun _ => ⟨X + D, by positivity⟩
  have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
      (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F)) := by
    intro g₁ _ g₂ _ hne
    exact hF_fund.aedisjoint hne
  have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F) MeasureTheory.volume := by
    intro g _
    change MeasureTheory.NullMeasurableSet ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) MeasureTheory.volume
    exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
  have hvol_union : MeasureTheory.volume (⋃ g ∈ T_lat, g +ᵥ F) =
      (T.card : ENNReal) * MeasureTheory.volume F := by
    rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
    have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F) = MeasureTheory.volume F := by
      intro g _
      change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) = MeasureTheory.volume F
      exact MeasureTheory.measure_vadd MeasureTheory.volume (g : NumberField.mixedEmbedding.mixedSpace K) F
    rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
  have hsub_body : (⋃ g ∈ T_lat, g +ᵥ F) ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
    intro z hz
    simp only [Set.mem_iUnion] at hz
    rcases hz with ⟨g, hg, hzF⟩
    rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
    rw [Set.Finite.mem_toFinset] at hxT
    rcases hzF with ⟨u, huF, rfl⟩
    have h_all_w : ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K) + u) < f w := by
      intro w
      have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
        (NumberField.mixedEmbedding K (x : K)) u
      rw [NumberField.mixedEmbedding.normAtPlace_apply] at htri
      have huD := hF_norm u huF w
      have hfw : (f w : ℝ) = X + D := rfl
      linarith [hxT.2 w]
    refine ⟨fun w _ => ?_, fun w _ => ?_⟩
    · simp only [Metric.mem_ball, dist_zero_right]
      rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact h_all_w w.1
    · simp only [Metric.mem_ball, dist_zero_right]
      rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact h_all_w w.1
  have hvol_le : (T.card : ENNReal) * MeasureTheory.volume F ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) := by
    rw [← hvol_union]
    exact MeasureTheory.measure_mono hsub_body
  rw [NumberField.mixedEmbedding.convexBodyLT_volume K f] at hvol_le
  have h_rhs_ne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(∏ w : NumberField.InfinitePlace K, f w ^ w.mult) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have h_real_le := ENNReal.toReal_mono h_rhs_ne_top hvol_le
  rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_mul,
      ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_prod] at h_real_le
  have h_prod_bound : (∏ w : NumberField.InfinitePlace K, ((f w ^ w.mult : NNReal) : ℝ)) ≤
      (1 + D) ^ n * X ^ n := by
    have h1 : (∏ w : NumberField.InfinitePlace K, ((f w ^ w.mult : NNReal) : ℝ)) ≤
        ∏ w : NumberField.InfinitePlace K, ((1 + D) * X) ^ w.mult := by
      apply Finset.prod_le_prod
      · intro w _
        positivity
      · intro w _
        rw [NNReal.coe_pow]
        have hfw : (f w : ℝ) = X + D := rfl
        rw [hfw]
        have hXD : X + D ≤ (1 + D) * X := by nlinarith
        exact pow_le_pow_left₀ (by positivity) hXD w.mult
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    calc (∏ w : NumberField.InfinitePlace K, ((f w ^ w.mult : NNReal) : ℝ))
        ≤ ((1 + D) * X) ^ n := h1
      _ = (1 + D) ^ n * X ^ n := mul_pow (1 + D) X n
  have h_factor_nonneg : (0 : ℝ) ≤ NumberField.mixedEmbedding.convexBodyLTFactor K := by
    positivity
  have h_comb : (T.card : ℝ) * V_K ≤
      (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * ((1 + D) ^ n * X ^ n) :=
    le_trans h_real_le (mul_le_mul_of_nonneg_left h_prod_bound h_factor_nonneg)
  rw [← le_div_iff₀ hVK_pos] at h_comb
  have h_s3_bound : (T.card : ℝ) ≤ C₀ * X ^ n := by
    calc (T.card : ℝ)
        ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * ((1 + D) ^ n * X ^ n) / V_K := h_comb
      _ = C₀ * X ^ n := by dsimp [C₀]; ring
  
  have h_log_pos : 0 < Real.log X := Real.log_pos hX
  have h_rhs_nonneg : 0 ≤ (n : ℝ) * (Real.log X + 1) := by positivity
  calc ∑ π ∈ hQ_fin.toFinset, g π
      ≤ (T.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := h_s2_bound
    _ ≤ (C₀ * X ^ n) * ((n : ℝ) * (Real.log X + 1)) :=
        mul_le_mul_of_nonneg_right h_s3_bound h_rhs_nonneg
    _ = ((n : ℝ) * C₀) * (X ^ n * (Real.log X + 1)) := by ring
    _ ≤ c_box * (X ^ n * (Real.log X + 1)) :=
        mul_le_mul_of_nonneg_right hc_box_ge (by positivity)
    _ = c_box * X ^ n * (Real.log X + 1) := by ring

theorem mitsui_volume_grid_partition_diff_le_boundary {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_open : IsOpen C)
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X) :
    |(MeasureTheory.volume C).toReal
      - (∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
            {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ i : NumberField.mixedEmbedding.index K,
                (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ⊆ C},
          (X / (m : ℝ)) ^ (Module.finrank ℚ K))| ≤
    (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
      ({z : NumberField.mixedEmbedding.mixedSpace K |
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ∩ C).Nonempty ∧
      ¬ ({z : NumberField.mixedEmbedding.mixedSpace K |
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ⊆ C)} : ℝ) *
      (X / (m : ℝ)) ^ (Module.finrank ℚ K) :=
by
  rename_i inst_real inst_complex
  classical
  have h_real : inst_real = @Subtype.fintype _ _ (fun _ => Classical.propDecidable _) inferInstance :=
    Subsingleton.elim _ _
  have h_complex : inst_complex = @Subtype.fintype _ _ (fun _ => Classical.propDecidable _) inferInstance :=
    Subsingleton.elim _ _
  subst h_real h_complex
  letI : SMul ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.smulSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  set ι := NumberField.mixedEmbedding.index K
  set b := NumberField.mixedEmbedding.stdBasis K
  set n := Module.finrank ℚ K
  set δ : ℝ := X / (m : ℝ)
  set F_std : Set (NumberField.mixedEmbedding.mixedSpace K) := ZSpan.fundamentalDomain b
  have hX_pos : 0 < X := by linarith
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
  have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
  have hδ_pos : 0 < δ := div_pos hX_pos hm_pos
  have hδ_nonneg : 0 ≤ δ := le_of_lt hδ_pos
  have hδ_ne : δ ≠ 0 := ne_of_gt hδ_pos
  have hδn_nonneg : 0 ≤ δ ^ n := pow_nonneg hδ_nonneg n
  set Q : (ι → Fin (2 * m)) → Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : ι, b.repr z i ∈
        Set.Ico (δ * (((k i : ℕ) : ℝ) - (m : ℝ))) (δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set v : (ι → Fin (2 * m)) → NumberField.mixedEmbedding.mixedSpace K :=
    fun k => b.equivFun.symm (fun i : ι => ((k i : ℕ) : ℝ) - (m : ℝ))
  have hv_repr : ∀ (k : ι → Fin (2 * m)) (i : ι),
      b.repr (v k) i = ((k i : ℕ) : ℝ) - (m : ℝ) := by
    intro k i
    rw [← Module.Basis.equivFun_apply]
    exact congr_fun (b.equivFun.apply_symm_apply _) i
  have hQ_eq : ∀ k : ι → Fin (2 * m), Q k = δ • (v k +ᵥ F_std) := by
    intro k
    ext z
    rw [Set.mem_smul_set_iff_inv_smul_mem₀ hδ_ne, Set.mem_vadd_set_iff_neg_vadd_mem,
        vadd_eq_add, ZSpan.mem_fundamentalDomain]
    change (∀ i : ι, b.repr z i ∈
        Set.Ico (δ * (((k i : ℕ) : ℝ) - (m : ℝ))) (δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ↔
      ∀ i : ι, b.repr (-v k + δ⁻¹ • z) i ∈ Set.Ico (0 : ℝ) 1
    refine forall_congr' (fun i => ?_)
    have h_lin : b.repr (-v k + δ⁻¹ • z) i =
        -(((k i : ℕ) : ℝ) - (m : ℝ)) + δ⁻¹ * b.repr z i := by
      rw [map_add, map_neg, map_smul, Finsupp.add_apply, Finsupp.neg_apply,
          Finsupp.smul_apply, smul_eq_mul, hv_repr k i]
    rw [h_lin, Set.mem_Ico, Set.mem_Ico, inv_mul_eq_div]
    constructor
    · rintro ⟨h1, h2⟩
      constructor
      · have h1' : ((k i : ℕ) : ℝ) - (m : ℝ) ≤ b.repr z i / δ :=
          (le_div_iff₀ hδ_pos).mpr (by linarith)
        linarith
      · have h2' : b.repr z i / δ < ((k i : ℕ) : ℝ) - (m : ℝ) + 1 :=
          (div_lt_iff₀ hδ_pos).mpr (by linarith)
        linarith
    · rintro ⟨h1, h2⟩
      constructor
      · have h1' : ((k i : ℕ) : ℝ) - (m : ℝ) ≤ b.repr z i / δ := by linarith
        have h1'' := (le_div_iff₀ hδ_pos).mp h1'
        linarith
      · have h2' : b.repr z i / δ < ((k i : ℕ) : ℝ) - (m : ℝ) + 1 := by linarith
        have h2'' := (div_lt_iff₀ hδ_pos).mp h2'
        linarith
  have hQ_meas : ∀ k : ι → Fin (2 * m), MeasurableSet (Q k) := by
    intro k
    rw [hQ_eq k]
    exact ((ZSpan.fundamentalDomain_measurableSet b).const_vadd (v k)).const_smul_of_ne_zero hδ_ne
  have hQ_vol : ∀ k : ι → Fin (2 * m),
      MeasureTheory.volume (Q k) = ENNReal.ofReal (δ ^ n) := by
    intro k
    rw [hQ_eq k, MeasureTheory.Measure.addHaar_smul_of_nonneg MeasureTheory.volume hδ_nonneg,
        NumberField.mixedEmbedding.finrank K, MeasureTheory.measure_vadd,
        NumberField.mixedEmbedding.volume_fundamentalDomain_stdBasis K, mul_one]
  have hQ_ne_top : ∀ k : ι → Fin (2 * m), MeasureTheory.volume (Q k) ≠ ⊤ := by
    intro k
    rw [hQ_vol k]
    exact ENNReal.ofReal_ne_top
  have hQ_toReal : ∀ k : ι → Fin (2 * m), (MeasureTheory.volume (Q k)).toReal = δ ^ n := by
    intro k
    rw [hQ_vol k, ENNReal.toReal_ofReal hδn_nonneg]
  have h_disj : ((Finset.univ : Finset (ι → Fin (2 * m))) : Set (ι → Fin (2 * m))).PairwiseDisjoint
      (fun k => Q k ∩ C) := by
    intro k₁ _ k₂ _ hk
    rw [Function.onFun, Set.disjoint_left]
    intro z hz₁ hz₂
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hk
    have h_val_ne : (k₁ i : ℕ) ≠ (k₂ i : ℕ) := Fin.val_ne_of_ne hi
    have h₁ := (hz₁.1 i).1
    have h₁' := (hz₁.1 i).2
    have h₂ := (hz₂.1 i).1
    have h₂' := (hz₂.1 i).2
    rcases lt_or_gt_of_ne h_val_ne with hlt | hgt
    · have hle : (k₁ i : ℕ) + 1 ≤ (k₂ i : ℕ) := hlt
      have hleR : ((k₁ i : ℕ) : ℝ) + 1 ≤ ((k₂ i : ℕ) : ℝ) := by exact_mod_cast hle
      have h_step : δ * (((k₁ i : ℕ) : ℝ) - (m : ℝ) + 1) ≤ δ * (((k₂ i : ℕ) : ℝ) - (m : ℝ)) :=
        mul_le_mul_of_nonneg_left (by linarith) hδ_nonneg
      linarith
    · have hle : (k₂ i : ℕ) + 1 ≤ (k₁ i : ℕ) := hgt
      have hleR : ((k₂ i : ℕ) : ℝ) + 1 ≤ ((k₁ i : ℕ) : ℝ) := by exact_mod_cast hle
      have h_step : δ * (((k₂ i : ℕ) : ℝ) - (m : ℝ) + 1) ≤ δ * (((k₁ i : ℕ) : ℝ) - (m : ℝ)) :=
        mul_le_mul_of_nonneg_left (by linarith) hδ_nonneg
      linarith
  have h_coord_bdd : ∀ z ∈ C, ∀ i : ι, |b.repr z i| < X := by
    intro z hz i
    rcases i with w | ⟨w, j⟩
    · have h1 : b.repr z (Sum.inl w) = z.1 w :=
        NumberField.mixedEmbedding.stdBasis_apply_isReal z w
      have h2 : ‖z.1 w‖ = NumberField.mixedEmbedding.normAtPlace w.1 z :=
        (NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2 z).symm
      rw [h1, ← Real.norm_eq_abs, h2]
      exact hC_bdd z hz w.1
    · fin_cases j
      · have h1 : b.repr z (Sum.inr (w, 0)) = (z.2 w).re :=
          NumberField.mixedEmbedding.stdBasis_apply_isComplex_fst z w
        have h2 : ‖z.2 w‖ = NumberField.mixedEmbedding.normAtPlace w.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2 z).symm
        change |b.repr z (Sum.inr (w, 0))| < X
        rw [h1]
        exact lt_of_le_of_lt (Complex.abs_re_le_norm (z.2 w)) (h2.trans_lt (hC_bdd z hz w.1))
      · have h1 : b.repr z (Sum.inr (w, 1)) = (z.2 w).im :=
          NumberField.mixedEmbedding.stdBasis_apply_isComplex_snd z w
        have h2 : ‖z.2 w‖ = NumberField.mixedEmbedding.normAtPlace w.1 z :=
          (NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2 z).symm
        change |b.repr z (Sum.inr (w, 1))| < X
        rw [h1]
        exact lt_of_le_of_lt (Complex.abs_im_le_norm (z.2 w)) (h2.trans_lt (hC_bdd z hz w.1))
  have h_cover : (⋃ k ∈ (Finset.univ : Finset (ι → Fin (2 * m))), (Q k ∩ C)) = C := by
    apply Set.Subset.antisymm
    · intro z hz
      rcases Set.mem_iUnion₂.mp hz with ⟨k, _, hzk⟩
      exact hzk.2
    · intro z hz
      rw [Set.mem_iUnion₂]
      have hX_eq : X = δ * (m : ℝ) := (div_mul_cancel₀ X hm_ne).symm
      have ht_bounds : ∀ i : ι,
          0 < b.repr z i / δ + (m : ℝ) ∧ b.repr z i / δ + (m : ℝ) < ((2 * m : ℕ) : ℝ) := by
        intro i
        obtain ⟨h_low, h_high⟩ := abs_lt.mp (h_coord_bdd z hz i)
        rw [hX_eq] at h_low h_high
        have h_div_low : -(m : ℝ) < b.repr z i / δ :=
          (lt_div_iff₀ hδ_pos).mpr (by linarith)
        have h_div_high : b.repr z i / δ < (m : ℝ) :=
          (div_lt_iff₀ hδ_pos).mpr (by linarith)
        constructor
        · linarith
        · push_cast
          linarith
      let k_z : ι → Fin (2 * m) := fun i =>
        ⟨⌊b.repr z i / δ + (m : ℝ)⌋₊,
          (Nat.floor_lt (le_of_lt (ht_bounds i).1)).mpr (ht_bounds i).2⟩
      refine ⟨k_z, Finset.mem_univ k_z, ⟨?_, hz⟩⟩
      intro i
      rw [Set.mem_Ico]
      have h_fl_le : ((k_z i : ℕ) : ℝ) ≤ b.repr z i / δ + (m : ℝ) :=
        Nat.floor_le (le_of_lt (ht_bounds i).1)
      have h_lt_fl : b.repr z i / δ + (m : ℝ) < ((k_z i : ℕ) : ℝ) + 1 :=
        Nat.lt_floor_add_one (b.repr z i / δ + (m : ℝ))
      constructor
      · have h1 : ((k_z i : ℕ) : ℝ) - (m : ℝ) ≤ b.repr z i / δ := by linarith
        have h2 := (le_div_iff₀ hδ_pos).mp h1
        linarith
      · have h1 : b.repr z i / δ < ((k_z i : ℕ) : ℝ) - (m : ℝ) + 1 := by linarith
        have h2 := (div_lt_iff₀ hδ_pos).mp h1
        linarith
  have hQC_meas : ∀ k : ι → Fin (2 * m), MeasurableSet (Q k ∩ C) :=
    fun k => (hQ_meas k).inter hC_open.measurableSet
  have hQC_le_vol : ∀ k : ι → Fin (2 * m),
      MeasureTheory.volume (Q k ∩ C) ≤ MeasureTheory.volume (Q k) :=
    fun k => MeasureTheory.measure_mono Set.inter_subset_left
  have hQC_ne_top : ∀ k : ι → Fin (2 * m), MeasureTheory.volume (Q k ∩ C) ≠ ⊤ :=
    fun k => ne_of_lt (lt_of_le_of_lt (hQC_le_vol k) (lt_top_iff_ne_top.mpr (hQ_ne_top k)))
  have hQC_toReal_le : ∀ k : ι → Fin (2 * m),
      (MeasureTheory.volume (Q k ∩ C)).toReal ≤ δ ^ n := by
    intro k
    rw [← hQ_toReal k]
    exact ENNReal.toReal_mono (hQ_ne_top k) (hQC_le_vol k)
  have hvol_C_sum : (MeasureTheory.volume C).toReal =
      ∑ k ∈ (Finset.univ : Finset (ι → Fin (2 * m))),
        (MeasureTheory.volume (Q k ∩ C)).toReal := by
    conv_lhs => rw [← h_cover]
    rw [MeasureTheory.measure_biUnion_finset h_disj (fun k _ => hQC_meas k),
        ENNReal.toReal_sum (fun k _ => hQC_ne_top k)]
  set P : (ι → Fin (2 * m)) → Prop := fun k => Q k ⊆ C
  set B : (ι → Fin (2 * m)) → Prop := fun k => (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)
  have h_split_P :
      (∑ k ∈ (Finset.univ : Finset (ι → Fin (2 * m))),
        (MeasureTheory.volume (Q k ∩ C)).toReal) =
      (∑ k ∈ Finset.univ.filter P, (MeasureTheory.volume (Q k ∩ C)).toReal) +
      (∑ k ∈ Finset.univ.filter (fun k => ¬ P k), (MeasureTheory.volume (Q k ∩ C)).toReal) :=
    (Finset.sum_filter_add_sum_filter_not Finset.univ P _).symm
  have h_int_sum :
      (∑' k : {k : ι → Fin (2 * m) // P k}, δ ^ n) =
      ∑ k ∈ Finset.univ.filter P, (MeasureTheory.volume (Q k ∩ C)).toReal := by
    rw [tsum_fintype]
    have h_sub : (∑ k : {k : ι → Fin (2 * m) // P k}, δ ^ n) =
        ∑ k ∈ Finset.univ.filter P, δ ^ n := by
      refine (Finset.sum_subtype (Finset.univ.filter P) ?_ (fun _ => δ ^ n)).symm
      intro k
      simp
    rw [h_sub]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hkP : Q k ⊆ C := (Finset.mem_filter.mp hk).2
    rw [Set.inter_eq_left.mpr hkP, hQ_toReal k]
  have h_diff_eq :
      (MeasureTheory.volume C).toReal - (∑' k : {k : ι → Fin (2 * m) // P k}, δ ^ n) =
      ∑ k ∈ Finset.univ.filter (fun k => ¬ P k), (MeasureTheory.volume (Q k ∩ C)).toReal := by
    rw [hvol_C_sum, h_split_P, h_int_sum]
    ring
  have h_nonneg : 0 ≤ ∑ k ∈ Finset.univ.filter (fun k => ¬ P k),
      (MeasureTheory.volume (Q k ∩ C)).toReal :=
    Finset.sum_nonneg (fun k _ => ENNReal.toReal_nonneg)
  rw [h_diff_eq, abs_of_nonneg h_nonneg]
  have h_split_B :
      (∑ k ∈ Finset.univ.filter (fun k => ¬ P k), (MeasureTheory.volume (Q k ∩ C)).toReal) =
      (∑ k ∈ (Finset.univ.filter (fun k => ¬ P k)).filter (fun k => (Q k ∩ C).Nonempty),
        (MeasureTheory.volume (Q k ∩ C)).toReal) +
      (∑ k ∈ (Finset.univ.filter (fun k => ¬ P k)).filter (fun k => ¬ (Q k ∩ C).Nonempty),
        (MeasureTheory.volume (Q k ∩ C)).toReal) :=
    (Finset.sum_filter_add_sum_filter_not
      (Finset.univ.filter (fun k => ¬ P k)) (fun k => (Q k ∩ C).Nonempty) _).symm
  have h_empty_zero :
      (∑ k ∈ (Finset.univ.filter (fun k => ¬ P k)).filter (fun k => ¬ (Q k ∩ C).Nonempty),
        (MeasureTheory.volume (Q k ∩ C)).toReal) = 0 := by
    refine Finset.sum_eq_zero (fun k hk => ?_)
    have hk_empty : Q k ∩ C = ∅ :=
      Set.not_nonempty_iff_eq_empty.mp (Finset.mem_filter.mp hk).2
    rw [hk_empty, MeasureTheory.measure_empty, ENNReal.toReal_zero]
  have h_filter_B_eq :
      (Finset.univ.filter (fun k => ¬ P k)).filter (fun k => (Q k ∩ C).Nonempty) =
      Finset.univ.filter B := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, B, P, and_comm]
  rw [h_split_B, h_empty_zero, add_zero, h_filter_B_eq]
  calc (∑ k ∈ Finset.univ.filter B, (MeasureTheory.volume (Q k ∩ C)).toReal)
    _ ≤ ∑ _k ∈ Finset.univ.filter B, δ ^ n :=
        Finset.sum_le_sum (fun k _ => hQC_toReal_le k)
    _ = ((Finset.univ.filter B).card : ℝ) * δ ^ n := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (Nat.card {k : ι → Fin (2 * m) // B k} : ℝ) * δ ^ n := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]

theorem mitsui_prime_char_box_norm_le_uncond {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤
      |∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_box : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_box ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hlt : w (x : K) < X := hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_box.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ ∀ w : NumberField.InfinitePlace K, w (x : K) < X :=
    fun x => hS_fin.mem_toFinset
  let w_real : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have h_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ w_real π :=
    fun _ => Real.log_natCast_nonneg _
  let S₁ := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  have hS₁_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun _ h => h.2.1)
  letI : Fintype S₁ := hS₁_fin.fintype
  let term : S₁ → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (w_real π.1 : ℂ)
  have h_term_norm : ∀ π : S₁, ‖term π‖ = w_real π.1 := by
    intro π
    dsimp [term]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (h_nonneg π.1)]
  have h_mem_F_S₁ : ∀ π : NumberField.RingOfIntegers K,
      π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)) ↔
        Prime π ∧ (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π) := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    tauto
  have h_lhs_le :
      ‖∑' π : S₁, term π‖ ≤
        ∑ π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)), w_real π := by
    rw [tsum_fintype term]
    calc ‖∑ π ∈ Finset.univ, term π‖
      _ ≤ ∑ π ∈ Finset.univ, ‖term π‖ := norm_sum_le _ _
      _ = ∑ π : S₁, w_real π.1 := Finset.sum_congr rfl (fun π _ => h_term_norm π)
      _ = ∑ π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)), w_real π :=
        (Finset.sum_subtype (F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)))
          h_mem_F_S₁ w_real).symm
  have h_iff1 : ∀ π : NumberField.RingOfIntegers K,
      (Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X) ↔
        π ∈ F.filter Prime := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    tauto
  let e₁ : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X} ≃
      {π : NumberField.RingOfIntegers K // π ∈ F.filter Prime} :=
    Equiv.subtypeEquivRight h_iff1
  have h_tsum1 :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          w_real π.1)
      = ∑ π ∈ F.filter Prime, w_real π := by
    rw [← Equiv.tsum_eq e₁.symm (fun π => w_real π.1)]
    exact Finset.tsum_subtype (F.filter Prime) w_real
  refine le_trans h_lhs_le ?_
  refine le_trans ?_ (le_abs_self _)
  rw [h_tsum1]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun π _ _ => h_nonneg π)
  intro π hπ
  simp only [Finset.mem_filter] at hπ ⊢
  exact ⟨hπ.1, hπ.2.1⟩

theorem mitsui_prime_char_box_to_ge_one_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
            IsUnit (Ideal.Quotient.mk q π)},
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_box : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_box ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hlt : w (x : K) < X := hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_box.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ ∀ w : NumberField.InfinitePlace K, w (x : K) < X :=
    fun x => hS_fin.mem_toFinset
  let w_real : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have h_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ w_real π :=
    fun _ => Real.log_natCast_nonneg _
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  let S₁ := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  have hS₁_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun _ h => h.2.1)
  letI : Fintype S₁ := hS₁_fin.fintype
  let S₂ := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  let term : S₁ → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (w_real π.1 : ℂ)
  let e_ge : S₂ ≃ {π : S₁ // P_ge π.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => (π.2.2.1 w).2, π.2.2.2⟩, fun w => (π.2.2.1 w).1⟩
      invFun := fun π => ⟨π.1.1, π.1.2.1, fun w => ⟨π.2 w, π.1.2.2.1 w⟩, π.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun π => by ext; rfl }
  have h_lhs1 : (∑' π : S₁, term π) = ∑ π ∈ Finset.univ, term π :=
    tsum_fintype term
  have h_lhs2 :
      (∑' π : S₂,
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ π ∈ Finset.univ.filter (fun π : S₁ => P_ge π.1), term π := by
    change (∑' π : S₂, term (e_ge π).1) = _
    rw [Equiv.tsum_eq e_ge (fun y : {π : S₁ // P_ge π.1} => term y.1), tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun π : S₁ => P_ge π.1))
      (fun _ => by simp) term).symm
  have h_lhs_split :
      ∑ π ∈ Finset.univ.filter (fun π : S₁ => P_ge π.1), term π +
      ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π =
      ∑ π ∈ Finset.univ, term π :=
    Finset.sum_filter_add_sum_filter_not Finset.univ (fun π : S₁ => P_ge π.1) term
  have h_lhs_diff :
      (∑' π : S₁, term π) -
      (∑' π : S₂,
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π := by
    rw [h_lhs1, h_lhs2, ← h_lhs_split]
    ring
  have h_term_norm : ∀ π : S₁, ‖term π‖ = w_real π.1 := by
    intro π
    dsimp [term]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (h_nonneg π.1)]
  have h_mem_F_S₁ : ∀ π : NumberField.RingOfIntegers K,
      π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)) ↔
        Prime π ∧ (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π) := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    tauto
  have h_lhs_le :
      ‖(∑' π : S₁, term π) -
        (∑' π : S₂,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ π ∈ (F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π))).filter
          (fun π => ¬ P_ge π), w_real π := by
    rw [h_lhs_diff]
    calc ‖∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π‖
      _ ≤ ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), ‖term π‖ :=
        norm_sum_le _ _
      _ = ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), w_real π.1 := by
        refine Finset.sum_congr rfl (fun π _ => h_term_norm π)
      _ = ∑ π : S₁, (if ¬ P_ge π.1 then w_real π.1 else 0) := by
        rw [Finset.sum_filter]
      _ = ∑ π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)),
            (if ¬ P_ge π then w_real π else 0) := by
        exact (Finset.sum_subtype (F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)))
          h_mem_F_S₁ (fun π => if ¬ P_ge π then w_real π else 0)).symm
      _ = ∑ π ∈ (F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π))).filter
            (fun π => ¬ P_ge π), w_real π := by
        rw [← Finset.sum_filter]
  have h_rhs_diff :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          w_real π.1)
      - (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
      = ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π := by
    have h_iff1 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X) ↔
          π ∈ F.filter Prime := by
      intro π
      simp only [Finset.mem_filter, hF_mem]
      tauto
    let e₁ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ F.filter Prime} :=
      Equiv.subtypeEquivRight h_iff1
    have h_tsum1 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ F.filter Prime, w_real π := by
      rw [← Equiv.tsum_eq e₁.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype (F.filter Prime) w_real
    have h_iff2 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ↔
          π ∈ (F.filter Prime).filter P_ge := by
      intro π
      simp only [Finset.mem_filter, hF_mem, P_ge, forall_and]
      tauto
    let e₂ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ (F.filter Prime).filter P_ge} :=
      Equiv.subtypeEquivRight h_iff2
    have h_tsum2 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ (F.filter Prime).filter P_ge, w_real π := by
      rw [← Equiv.tsum_eq e₂.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype ((F.filter Prime).filter P_ge) w_real
    have h_split :
        ∑ π ∈ (F.filter Prime).filter P_ge, w_real π +
        ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π =
        ∑ π ∈ F.filter Prime, w_real π :=
      Finset.sum_filter_add_sum_filter_not (F.filter Prime) P_ge w_real
    rw [h_tsum1, h_tsum2, ← h_split]
    ring
  refine le_trans h_lhs_le ?_
  refine le_trans ?_ (le_abs_self _)
  rw [h_rhs_diff]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun π _ _ => h_nonneg π)
  intro π hπ
  simp only [Finset.mem_filter] at hπ ⊢
  exact ⟨⟨hπ.1.1, hπ.1.2.1⟩, hπ.2⟩

theorem mitsui_prime_char_box_ge_one_to_place_sectors_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) < X ∧
                IsUnit (Ideal.Quotient.mk q π)},
              ψ (Additive.ofMul π.2.2.2.2.unit) *
                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) < X},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let L : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L π :=
    fun _ => Real.log_natCast_nonneg _
  let P_box : NumberField.RingOfIntegers K → Prop :=
    fun π => Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X
  let P_max : NumberField.InfinitePlace K → NumberField.RingOfIntegers K → Prop :=
    fun w₀ π => ∀ w : NumberField.InfinitePlace K, w (π : K) ≤ w₀ (π : K)
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : {π : NumberField.RingOfIntegers K | P_box π} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hlt : w (π : K) < X := (hπ.2 w).2
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hS_fin : {π : NumberField.RingOfIntegers K | P_box π}.Finite :=
    hpre_fin.subset hS_sub
  let S_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  letI : Fintype S_uncond := hS_fin.fintype
  let S_cop := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
    IsUnit (Ideal.Quotient.mk q π)}
  have hScop_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun _ hπ => ⟨hπ.1, hπ.2.1⟩)
  letI : Fintype S_cop := hScop_fin.fintype
  let M : NumberField.RingOfIntegers K → Finset (NumberField.InfinitePlace K) :=
    fun π => Finset.univ.filter (fun w₀ : NumberField.InfinitePlace K => P_max w₀ π)
  have hM_ge_one : ∀ π : NumberField.RingOfIntegers K, 1 ≤ (M π).card := by
    intro π
    obtain ⟨w₀, _, hw₀⟩ := Finset.exists_max_image Finset.univ
      (fun w : NumberField.InfinitePlace K => w (π : K)) Finset.univ_nonempty
    have hw₀_mem : w₀ ∈ M π := by
      rw [Finset.mem_filter]
      exact ⟨Finset.mem_univ w₀, fun w => hw₀ w (Finset.mem_univ w)⟩
    exact Finset.card_pos.mpr ⟨w₀, hw₀_mem⟩
  have hM_sub_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ ((M π).card : ℝ) - 1 := by
    intro π
    have h1 : (1 : ℝ) ≤ ((M π).card : ℝ) := by exact_mod_cast hM_ge_one π
    linarith
  let term : S_cop → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (L π.1 : ℂ)
  have h_lhs1 : (∑' π : S_cop, term π) = ∑ x : S_cop, term x :=
    tsum_fintype term
  let S_sec_cop (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X ∧
      IsUnit (Ideal.Quotient.mk q π)}
  let e_sec_cop (w₀ : NumberField.InfinitePlace K) :
       S_sec_cop w₀ ≃ {x : S_cop // P_max w₀ x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => ⟨(π.2.2.1 w).1, lt_of_le_of_lt (π.2.2.1 w).2 π.2.2.2.1⟩, π.2.2.2.2⟩,
         fun w => (π.2.2.1 w).2⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, fun w => ⟨(x.1.2.2.1 w).1, x.2 w⟩, (x.1.2.2.1 w₀).2, x.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_cop w₀,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, (if P_max w₀ x.1 then term x else 0) := by
    intro w₀
    change (∑' π : S_sec_cop w₀, term (e_sec_cop w₀ π).1) = _
    rw [Equiv.tsum_eq (e_sec_cop w₀) (fun z : {x : S_cop // P_max w₀ x.1} => term z.1), tsum_fintype]
    have hsub : (∑ z : {x : S_cop // P_max w₀ x.1}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cop => P_max w₀ x.1), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => P_max w₀ x.1))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, ((M x.1).card : ℂ) * term x := by
    simp_rw [h_lhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_lhs_diff :
      (∑' π : S_cop, term π) -
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = - ∑ x : S_cop, (((M x.1).card : ℂ) - 1) * term x := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    ring
  have h_term_norm : ∀ x : S_cop,
      ‖(((M x.1).card : ℂ) - 1) * term x‖ = (((M x.1).card : ℝ) - 1) * L x.1 := by
    intro x
    dsimp [term]
    have h_cast : (((M x.1).card : ℂ) - 1) = ((((M x.1).card : ℝ) - 1 : ℝ) : ℂ) := by
      push_cast; rfl
    rw [h_cast, norm_mul, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hM_sub_nonneg x.1),
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hL_nonneg x.1)]
  let e_cop : S_cop ≃ {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1, x.2.2.1⟩, x.2.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.1.2.2, y.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_cop, term π) -
        (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : S_sec_cop w₀,
            ψ (Additive.ofMul π.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
          (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_lhs_diff, norm_neg]
    calc ‖∑ x : S_cop, (((M x.1).card : ℂ) - 1) * term x‖
      _ ≤ ∑ x : S_cop, ‖(((M x.1).card : ℂ) - 1) * term x‖ :=
        norm_sum_le _ _
      _ = ∑ x : S_cop, (((M x.1).card : ℝ) - 1) * L x.1 :=
        Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)},
            (((M z.1.1).card : ℝ) - 1) * L z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} =>
          (((M z.1.1).card : ℝ) - 1) * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
            (((M y.1).card : ℝ) - 1) * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_uncond => (((M y.1).card : ℝ) - 1) * L y.1)).symm
  have h_rhs1 : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  let S_sec_uncond (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let e_sec_uncond (w₀ : NumberField.InfinitePlace K) :
      S_sec_uncond w₀ ≃ {y : S_uncond // P_max w₀ y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => ⟨(π.2.2.1 w).1, lt_of_le_of_lt (π.2.2.1 w).2 π.2.2.2⟩⟩,
         fun w => (π.2.2.1 w).2⟩
      invFun := fun y =>
        ⟨y.1.1, y.1.2.1, fun w => ⟨(y.1.2.2 w).1, y.2 w⟩, (y.1.2.2 w₀).2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, (if P_max w₀ y.1 then L y.1 else 0) := by
    intro w₀
    change (∑' π : S_sec_uncond w₀, L (e_sec_uncond w₀ π).1.1) = _
    rw [Equiv.tsum_eq (e_sec_uncond w₀) (fun z : {y : S_uncond // P_max w₀ y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_max w₀ y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs2 :
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, ((M y.1).card : ℝ) * L y.1 := by
    simp_rw [h_rhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_rhs_diff :
      (∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)
      = - ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs1, h_rhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    ring
  have h_rhs_nonneg :
      0 ≤ ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))
  have h_rhs_abs :
      |(∑' y : S_uncond, L y.1) -
        (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
      = ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs_diff, abs_neg, abs_of_nonneg h_rhs_nonneg]
  change ‖(∑' π : S_cop, term π) -
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
  rw [h_rhs_abs]
  refine le_trans h_lhs_le ?_
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun y _ _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))

theorem mitsui_prime_char_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals {K : Type u} [Field K] [NumberField K]
    (Y : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = (NumberField.Units.torsionOrder K : ℂ) *
        (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              ∃ h : p.asIdeal.IsPrincipal,
              (Ideal.absNorm p.asIdeal : ℝ) ≤ Y ∧
              IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
            ψ (Additive.ofMul p.2.choose_spec.2.unit) *
              (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)) :=
by
  classical
  have h_gen_unit : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (h : I.IsPrincipal)
      (x : NumberField.RingOfIntegers K),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I →
      (IsUnit (Ideal.Quotient.mk q x) ↔
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ I h))) := by
    intro I h x hx_span
    letI : I.IsPrincipal := h
    let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ I h
    have h_span_eq : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) :=
      (Submodule.IsPrincipal.span_singleton_generator I).trans hx_span.symm
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span_eq
    have hu_inv : x * ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = g := by
      rw [← hu, mul_assoc, Units.mul_inv, mul_one]
    constructor
    · intro hx_unit
      change IsUnit (Ideal.Quotient.mk q g)
      rw [← hu_inv, map_mul]
      exact hx_unit.mul (u⁻¹.isUnit.map (Ideal.Quotient.mk q))
    · intro hg_unit
      rw [← hu, map_mul]
      exact hg_unit.mul (u.isUnit.map (Ideal.Quotient.mk q))
  have h_gen_psi : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (h : I.IsPrincipal)
      (x : NumberField.RingOfIntegers K),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I →
      ∀ (hx_unit : IsUnit (Ideal.Quotient.mk q x))
        (hg_unit : IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ I h))),
        ψ (Additive.ofMul hx_unit.unit) = ψ (Additive.ofMul hg_unit.unit) := by
    intro I h x hx_span hx_unit hg_unit
    letI : I.IsPrincipal := h
    let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ I h
    have h_span_eq : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) :=
      (Submodule.IsPrincipal.span_singleton_generator I).trans hx_span.symm
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span_eq
    let u_bar : (NumberField.RingOfIntegers K ⧸ q)ˣ :=
      Units.map (Ideal.Quotient.mk q).toMonoidHom u
    have h_unit_eq : hx_unit.unit = hg_unit.unit * u_bar := by
      apply Units.ext
      change (hx_unit.unit : NumberField.RingOfIntegers K ⧸ q) =
        (hg_unit.unit : NumberField.RingOfIntegers K ⧸ q) * (u_bar : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      change Ideal.Quotient.mk q x =
        Ideal.Quotient.mk q g * Ideal.Quotient.mk q (u : NumberField.RingOfIntegers K)
      rw [← map_mul, hu]
    rw [h_unit_eq, ofMul_mul, AddChar.map_add_eq_mul, hψ_units u, mul_one]
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  let D_cone := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    NumberField.mixedEmbedding K (π : K) ∈
      NumberField.mixedEmbedding.fundamentalCone K ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q π)}
  let D_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    ∃ h : p.asIdeal.IsPrincipal,
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))}
  let p₀ : D_cone → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    fun π => ⟨Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)),
      (Ideal.span_singleton_prime π.2.1.ne_zero).mpr π.2.1,
      Ideal.span_singleton_eq_bot.not.mpr π.2.1.ne_zero⟩
  have h_prin : ∀ π : D_cone, (p₀ π).asIdeal.IsPrincipal :=
    fun π => ⟨⟨π.1, rfl⟩⟩
  have h_p₀_mem : ∀ π : D_cone,
      ∃ h : (p₀ π).asIdeal.IsPrincipal,
      (Ideal.absNorm (p₀ π).asIdeal : ℝ) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (p₀ π).asIdeal h)) := by
    intro π
    refine ⟨h_prin π, ?_, ?_⟩
    · change (Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K))) : ℝ) ≤ Y
      rw [h_norm_span π.1]
      exact π.2.2.2.1
    · exact (h_gen_unit (p₀ π).asIdeal (h_prin π) π.1 rfl).mp π.2.2.2.2
  let d_prin : D_cone → D_prin := fun π => ⟨p₀ π, h_p₀_mem π⟩
  let a : D_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
    fun π => ⟨NumberField.mixedEmbedding K (π.1 : K),
      NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨π.2.2.1, π.1, rfl⟩⟩
  have ha_pre : ∀ π : D_cone,
      (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a π) :
        NumberField.RingOfIntegers K) = π.1 :=
    fun π => NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a π).2
  let u_tors : D_cone → NumberField.Units.torsion K :=
    fun π => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).2
  let b : D_prin → {I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) //
      Submodule.IsPrincipal (I : Ideal (NumberField.RingOfIntegers K))} :=
    fun p => ⟨⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩, p.2.choose⟩
  let a' : D_prin × NumberField.Units.torsion K →
      NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
    fun pz => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm (b pz.1, pz.2)
  let x' : D_prin × NumberField.Units.torsion K → NumberField.RingOfIntegers K :=
    fun pz => (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' pz) :
      NumberField.RingOfIntegers K)
  have h_span : ∀ pz : D_prin × NumberField.Units.torsion K,
      Ideal.span ({x' pz} : Set (NumberField.RingOfIntegers K)) = pz.1.1.asIdeal := by
    intro pz
    have h1 := (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a' pz)).symm
    have h2 : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' pz) = (b pz.1, pz.2) :=
      (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply (b pz.1, pz.2)
    rw [h2] at h1
    exact h1
  have h_x'_mem : ∀ pz : D_prin × NumberField.Units.torsion K,
      Prime (x' pz) ∧
      NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm
        (NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q (x' pz)) := by
    intro pz
    have hx'_ne : x' pz ≠ 0 :=
      nonZeroDivisors.ne_zero (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' pz)).2
    have h_emb : NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K) =
        (a' pz : NumberField.mixedEmbedding.mixedSpace K) :=
      NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' pz)
    refine ⟨?_, ?_, ?_, ?_⟩
    · have hI_prime : (Ideal.span ({x' pz} : Set (NumberField.RingOfIntegers K))).IsPrime := by
        rw [h_span pz]
        exact pz.1.1.isPrime
      exact (Ideal.span_singleton_prime hx'_ne).mp hI_prime
    · rw [h_emb]
      exact (NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mp (a' pz).2).1
    · rw [← h_norm_span (x' pz), h_span pz]
      exact pz.1.2.choose_spec.1
    · exact (h_gen_unit pz.1.1.asIdeal pz.1.2.choose (x' pz) (h_span pz)).mpr pz.1.2.choose_spec.2
  let E : D_cone ≃ D_prin × NumberField.Units.torsion K :=
    { toFun := fun π => (d_prin π, u_tors π)
      invFun := fun pz => ⟨x' pz, h_x'_mem pz⟩
      left_inv := by
        intro π
        apply Subtype.ext
        have h_b_eq : b (d_prin π) = (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 := by
          apply Subtype.ext
          apply Subtype.ext
          change Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) =
            (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 :
              nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
              Ideal (NumberField.RingOfIntegers K))
          rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a π), ha_pre π]
        have h_pair_eq : (b (d_prin π), u_tors π) =
            NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π) :=
          Prod.ext h_b_eq rfl
        have ha'_eq : a' (d_prin π, u_tors π) = a π := by
          dsimp [a']
          rw [h_pair_eq, (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm_apply_apply]
        change x' (d_prin π, u_tors π) = π.1
        dsimp [x']
        rw [ha'_eq, ha_pre π]
      right_inv := by
        intro pz
        let π : D_cone := ⟨x' pz, h_x'_mem pz⟩
        have hd_eq : d_prin π = pz.1 := by
          apply Subtype.ext
          apply IsDedekindDomain.HeightOneSpectrum.ext
          exact h_span pz
        have ha_eq : a π = a' pz := by
          apply Subtype.ext
          exact NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' pz)
        have hu_eq : u_tors π = pz.2 := by
          dsimp [u_tors]
          rw [ha_eq]
          have h2 : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' pz) = (b pz.1, pz.2) :=
            (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply (b pz.1, pz.2)
          rw [h2]
        exact Prod.ext hd_eq hu_eq }
  let F_cone : D_cone → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let F_prin : D_prin → ℂ := fun p =>
    ψ (Additive.ofMul p.2.choose_spec.2.unit) *
      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)
  have hF_eq : ∀ π : D_cone, F_cone π = F_prin (E π).1 := by
    intro π
    dsimp [F_cone, F_prin, E]
    have h_psi : ψ (Additive.ofMul π.2.2.2.2.unit) =
        ψ (Additive.ofMul (d_prin π).2.choose_spec.2.unit) :=
      h_gen_psi (d_prin π).1.asIdeal (d_prin π).2.choose π.1 rfl π.2.2.2.2 (d_prin π).2.choose_spec.2
    have h_norm : (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ) =
        (Real.log (Ideal.absNorm (d_prin π).1.asIdeal) : ℂ) := by
      congr 3
      change (Algebra.norm ℤ π.1).natAbs =
        Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)))
      exact (Ideal.absNorm_span_singleton π.1).symm
    exact congrArg₂ (· * ·) h_psi h_norm
  have h_tsum_reindex : (∑' π : D_cone, F_cone π) =
      ∑' pz : D_prin × NumberField.Units.torsion K, F_prin pz.1 := by
    rw [tsum_congr hF_eq]
    exact Equiv.tsum_eq E (fun pz : D_prin × NumberField.Units.torsion K => F_prin pz.1)
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let emb_id : D_prin → S_id :=
    fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.choose_spec.1⟩
  have hemb_inj : Function.Injective emb_id := by
    intro p₁ p₂ hp
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hp
  haveI : Finite D_prin := Finite.of_injective emb_id hemb_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  change (∑' π : D_cone, F_cone π) =
    (NumberField.Units.torsionOrder K : ℂ) * (∑' p : D_prin, F_prin p)
  rw [h_tsum_reindex, tsum_fintype, tsum_fintype, Fintype.sum_prod_type]
  dsimp only
  have h_inner : ∀ p : D_prin,
      (∑ _ζ : NumberField.Units.torsion K, F_prin p) =
        (NumberField.Units.torsionOrder K : ℂ) * F_prin p := by
    intro p
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    rfl
  simp_rw [h_inner]
  rw [← Finset.mul_sum]

theorem mitsui_prime_char_place_sector_eq_principalPrimeIdeals {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            ∃ h : p.asIdeal.IsPrincipal,
            (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
            IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
              (∀ w : NumberField.InfinitePlace K,
                1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
              w₀ (π : K) < X} : ℂ) *
            (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
              (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)) :=
by
  classical
  have h_gen_unit : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (h : I.IsPrincipal)
      (x : NumberField.RingOfIntegers K),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I →
      (IsUnit (Ideal.Quotient.mk q x) ↔
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ I h))) := by
    intro I h x hx_span
    letI : I.IsPrincipal := h
    let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ I h
    have h_span_eq : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) :=
      (Submodule.IsPrincipal.span_singleton_generator I).trans hx_span.symm
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span_eq
    have hu_inv : x * ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) = g := by
      rw [← hu, mul_assoc, Units.mul_inv, mul_one]
    constructor
    · intro hx_unit
      change IsUnit (Ideal.Quotient.mk q g)
      rw [← hu_inv, map_mul]
      exact hx_unit.mul (u⁻¹.isUnit.map (Ideal.Quotient.mk q))
    · intro hg_unit
      rw [← hu, map_mul]
      exact hg_unit.mul (u.isUnit.map (Ideal.Quotient.mk q))
  have h_gen_psi : ∀ (I : Ideal (NumberField.RingOfIntegers K)) (h : I.IsPrincipal)
      (x : NumberField.RingOfIntegers K),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I →
      ∀ (hx_unit : IsUnit (Ideal.Quotient.mk q x))
        (hg_unit : IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ I h))),
        ψ (Additive.ofMul hx_unit.unit) = ψ (Additive.ofMul hg_unit.unit) := by
    intro I h x hx_span hx_unit hg_unit
    letI : I.IsPrincipal := h
    let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ I h
    have h_span_eq : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) :=
      (Submodule.IsPrincipal.span_singleton_generator I).trans hx_span.symm
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp h_span_eq
    let u_bar : (NumberField.RingOfIntegers K ⧸ q)ˣ :=
      Units.map (Ideal.Quotient.mk q).toMonoidHom u
    have h_unit_eq : hx_unit.unit = hg_unit.unit * u_bar := by
      apply Units.ext
      change (hx_unit.unit : NumberField.RingOfIntegers K ⧸ q) =
        (hg_unit.unit : NumberField.RingOfIntegers K ⧸ q) * (u_bar : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      change Ideal.Quotient.mk q x =
        Ideal.Quotient.mk q g * Ideal.Quotient.mk q (u : NumberField.RingOfIntegers K)
      rw [← map_mul, hu]
    rw [h_unit_eq, ofMul_mul, AddChar.map_add_eq_mul, hψ_units u, mul_one]
  have h_norm_prod : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult := by
    intro x
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, Ideal.absNorm_span_singleton,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_norm_le : ∀ x : NumberField.RingOfIntegers K,
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (x : K) ∧ w (x : K) ≤ w₀ (x : K)) →
      w₀ (x : K) < X →
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) ≤
        X ^ (Module.finrank ℚ K) := by
    intro x hx_sec hx_lt
    rw [h_norm_prod x]
    have h_prod_le :
        (∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
      refine Finset.prod_le_prod (fun w _ => ?_) (fun w _ => ?_)
      · have hw_nonneg : 0 ≤ w (x : K) := le_trans zero_le_one (hx_sec w).1
        exact pow_nonneg hw_nonneg w.mult
      · have hw_nonneg : 0 ≤ w (x : K) := le_trans zero_le_one (hx_sec w).1
        have hw_le : w (x : K) ≤ X := le_trans (hx_sec w).2 (le_of_lt hx_lt)
        exact pow_le_pow_left₀ hw_nonneg hw_le w.mult
    have h_prod_X :
        (∏ w : NumberField.InfinitePlace K, X ^ w.mult) = X ^ (Module.finrank ℚ K) := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    exact h_prod_le.trans (le_of_eq h_prod_X)
  let D_sec := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    (∀ w : NumberField.InfinitePlace K,
      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
    w₀ (π : K) < X ∧
    IsUnit (Ideal.Quotient.mk q π)}
  let D_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    ∃ h : p.asIdeal.IsPrincipal,
    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))}
  let Fiber (p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    {π : NumberField.RingOfIntegers K //
      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p₀.asIdeal ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let p₀ : D_sec → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    fun π => ⟨Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)),
      (Ideal.span_singleton_prime π.2.1.ne_zero).mpr π.2.1,
      Ideal.span_singleton_eq_bot.not.mpr π.2.1.ne_zero⟩
  have h_prin : ∀ π : D_sec, (p₀ π).asIdeal.IsPrincipal :=
    fun π => ⟨⟨π.1, rfl⟩⟩
  have h_p₀_mem : ∀ π : D_sec,
      ∃ h : (p₀ π).asIdeal.IsPrincipal,
      (Ideal.absNorm (p₀ π).asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
      IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (p₀ π).asIdeal h)) := by
    intro π
    refine ⟨h_prin π, h_norm_le π.1 π.2.2.1 π.2.2.2.1, ?_⟩
    exact (h_gen_unit (p₀ π).asIdeal (h_prin π) π.1 rfl).mp π.2.2.2.2
  let d_prin : D_sec → D_prin := fun π => ⟨p₀ π, h_p₀_mem π⟩
  have h_y_mem : ∀ (p : D_prin) (y : Fiber p.1),
      Prime y.1 ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (y.1 : K) ∧ w (y.1 : K) ≤ w₀ (y.1 : K)) ∧
      w₀ (y.1 : K) < X ∧
      IsUnit (Ideal.Quotient.mk q y.1) := by
    intro p y
    have hy_ne : y.1 ≠ 0 := by
      intro h0
      apply p.1.ne_bot
      rw [← y.2.1, Ideal.span_singleton_eq_bot]
      exact h0
    have hI_prime : (Ideal.span ({y.1} : Set (NumberField.RingOfIntegers K))).IsPrime := by
      rw [y.2.1]
      exact p.1.isPrime
    refine ⟨(Ideal.span_singleton_prime hy_ne).mp hI_prime, y.2.2.1, y.2.2.2, ?_⟩
    exact (h_gen_unit p.1.asIdeal p.2.choose y.1 y.2.1).mpr p.2.choose_spec.2
  let e_fiber (p : D_prin) : {π : D_sec // d_prin π = p} ≃ Fiber p.1 :=
    { toFun := fun z =>
        ⟨z.1.1, congrArg (fun q : D_prin => q.1.asIdeal) z.2, z.1.2.2.1, z.1.2.2.2.1⟩
      invFun := fun y =>
        ⟨⟨y.1, h_y_mem p y⟩, by
          apply Subtype.ext
          apply IsDedekindDomain.HeightOneSpectrum.ext
          exact y.2.1⟩
      left_inv := fun z => by
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := fun y => by
        apply Subtype.ext
        rfl }
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hDsec_sub : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X ∧
      IsUnit (Ideal.Quotient.mk q π)} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hle : w (π : K) ≤ w₀ (π : K) := (hπ.2.1 w).2
    have hlt : w₀ (π : K) < X := hπ.2.2.1
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hDsec_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hpre_fin.subset hDsec_sub
  letI : Fintype D_sec := hDsec_fin.fintype
  let Y : ℝ := X ^ (Module.finrank ℚ K)
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let emb_id : D_prin → S_id :=
    fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.choose_spec.1⟩
  have hemb_inj : Function.Injective emb_id := by
    intro p₁ p₂ hp
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hp
  haveI : Finite D_prin := Finite.of_injective emb_id hemb_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  let F_sec : D_sec → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let F_prin : D_prin → ℂ := fun p =>
    ψ (Additive.ofMul p.2.choose_spec.2.unit) *
      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)
  have hF_eq : ∀ π : D_sec, F_sec π = F_prin (d_prin π) := by
    intro π
    dsimp [F_sec, F_prin]
    have h_psi : ψ (Additive.ofMul π.2.2.2.2.unit) =
        ψ (Additive.ofMul (d_prin π).2.choose_spec.2.unit) :=
      h_gen_psi (d_prin π).1.asIdeal (d_prin π).2.choose π.1 rfl π.2.2.2.2 (d_prin π).2.choose_spec.2
    have h_norm : (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ) =
        (Real.log (Ideal.absNorm (d_prin π).1.asIdeal) : ℂ) := by
      congr 3
      change (Algebra.norm ℤ π.1).natAbs =
        Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)))
      exact (Ideal.absNorm_span_singleton π.1).symm
    exact congrArg₂ (· * ·) h_psi h_norm
  have h_tsum_sigma :
      (∑' π : D_sec, F_sec π) =
        ∑ p : D_prin, ∑ z : {π : D_sec // d_prin π = p}, F_sec z.1 := by
    rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv d_prin) F_sec, tsum_fintype, Fintype.sum_sigma]
    rfl
  have h_inner : ∀ p : D_prin,
      (∑ z : {π : D_sec // d_prin π = p}, F_sec z.1) =
        (Nat.card (Fiber p.1) : ℂ) * F_prin p := by
    intro p
    have h_const : ∀ z : {π : D_sec // d_prin π = p}, F_sec z.1 = F_prin p := by
      intro z
      rw [hF_eq z.1, z.2]
    have h_sum_const :
        (∑ z : {π : D_sec // d_prin π = p}, F_sec z.1) =
          ∑ _z : {π : D_sec // d_prin π = p}, F_prin p :=
      Finset.sum_congr rfl (fun z _ => h_const z)
    rw [h_sum_const, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      ← Nat.card_eq_fintype_card, Nat.card_congr (e_fiber p)]
  change (∑' π : D_sec, F_sec π) =
    ∑' p : D_prin, (Nat.card (Fiber p.1) : ℂ) * F_prin p
  rw [h_tsum_sigma, tsum_fintype]
  exact Finset.sum_congr rfl (fun p _ => h_inner p)

theorem mitsui_principalPrimeIdeals_char_place_sector_bound_of_rank_eq_zero {K : Type u} [Field K] [NumberField K]
    (h_rank : NumberField.Units.rank K = 0) :
    ∃ c₃₀ : ℝ, 0 < c₃₀ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ,
              ‖(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                    ∃ h : p.asIdeal.IsPrincipal,
                    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
                    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
                  (Nat.card {π : NumberField.RingOfIntegers K //
                      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                      (∀ w : NumberField.InfinitePlace K,
                        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                      w₀ (π : K) < X} : ℂ) *
                    (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))
                - ((((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
                    (NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
                  ((NumberField.Units.torsionOrder K : ℂ) *
                    (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                          ∃ h : p.asIdeal.IsPrincipal,
                          (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
                          IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
                        ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                          (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))‖
                ≤ c₃₀ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃₀) :=
by
  classical
  have h_s1 : ∀ w₀ : NumberField.InfinitePlace K,
      (∀ w : NumberField.InfinitePlace K, w = w₀) ∧
      w₀.mult = Module.finrank ℚ K ∧
      NumberField.Units.regulator K = 1 ∧
      ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ = 1 := by
    intro w₀
    have h_card : Fintype.card (NumberField.InfinitePlace K) ≤ 1 := by
      have h1 : Fintype.card (NumberField.InfinitePlace K) - 1 = 0 := h_rank
      exact Nat.sub_eq_zero_iff_le.mp h1
    have h_sub : Subsingleton (NumberField.InfinitePlace K) :=
      Fintype.card_le_one_iff_subsingleton.mp h_card
    have hw_eq : ∀ w : NumberField.InfinitePlace K, w = w₀ := fun w => h_sub.elim w w₀
    have h_mult : w₀.mult = Module.finrank ℚ K := by
      letI : Unique (NumberField.InfinitePlace K) := @uniqueOfSubsingleton _ h_sub w₀
      have hsum := NumberField.InfinitePlace.sum_mult_eq (K := K)
      rw [Fintype.sum_unique] at hsum
      exact hsum
    have h_reg : NumberField.Units.regulator K = 1 := by
      rw [NumberField.Units.regulator_eq_det' K]
      haveI : IsEmpty {w : NumberField.InfinitePlace K // w ≠ NumberField.Units.dirichletUnitTheorem.w₀} :=
        ⟨fun w => w.2 (h_sub.elim _ _)⟩
      simp [Matrix.det_isEmpty]
    have h_pref : ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ = 1 := by
      have hn_pos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
        exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
      rw [h_mult, h_reg, div_self (ne_of_gt hn_pos), inv_one, mul_one]
    exact ⟨hw_eq, h_mult, h_reg, h_pref⟩
  have h_s2 : ∀ (X : ℝ), 1 < X → ∀ (w₀ : NumberField.InfinitePlace K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (h_prin : p.asIdeal.IsPrincipal),
      ((Ideal.absNorm p.asIdeal : ℝ) < X ^ (Module.finrank ℚ K) →
        Nat.card {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} = NumberField.Units.torsionOrder K) ∧
      ((Ideal.absNorm p.asIdeal : ℝ) = X ^ (Module.finrank ℚ K) →
        Nat.card {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} = 0) := by
    intro X hX w₀ p h_prin
    obtain ⟨hw_eq, h_mult, _, _⟩ := h_s1 w₀
    haveI : Subsingleton (NumberField.InfinitePlace K) := ⟨fun a b => (hw_eq a).trans (hw_eq b).symm⟩
    letI : Unique (NumberField.InfinitePlace K) := uniqueOfSubsingleton w₀
    set n := Module.finrank ℚ K
    have hn_pos : 0 < n := Module.finrank_pos (R := ℚ) (M := K)
    have hn_ne : n ≠ 0 := ne_of_gt hn_pos
    have h_gen_pow : ∀ π : NumberField.RingOfIntegers K,
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal →
        w₀ (π : K) ^ n = (Ideal.absNorm p.asIdeal : ℝ) := by
      intro π hspan
      have h1 : (Ideal.absNorm p.asIdeal : ℝ) = ((Algebra.norm ℤ π).natAbs : ℝ) := by
        rw [← hspan, Ideal.absNorm_span_singleton]
      have h2q : ((Algebra.norm ℤ π).natAbs : ℚ) = |Algebra.norm ℚ (π : K)| := by
        rw [Nat.cast_natAbs, Int.cast_abs, Algebra.coe_norm_int]
      have h2 : ((Algebra.norm ℤ π).natAbs : ℝ) = ((|Algebra.norm ℚ (π : K)| : ℚ) : ℝ) := by
        exact_mod_cast h2q
      have h3 := NumberField.InfinitePlace.prod_eq_abs_norm (π : K)
      rw [Fintype.prod_unique] at h3
      change w₀ (π : K) ^ w₀.mult = ((|Algebra.norm ℚ (π : K)| : ℚ) : ℝ) at h3
      rw [h_mult] at h3
      linarith
    have h_norm_ge_one : (1 : ℝ) ≤ (Ideal.absNorm p.asIdeal : ℝ) := by
      have hne : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
    have h_gen_sec : ∀ π : NumberField.RingOfIntegers K,
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal →
        (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        (w₀ (π : K) < X ↔ (Ideal.absNorm p.asIdeal : ℝ) < X ^ n) := by
      intro π hspan
      have hpow := h_gen_pow π hspan
      have hw0_ge_one : 1 ≤ w₀ (π : K) := by
        rw [← pow_le_pow_iff_left₀ zero_le_one (apply_nonneg w₀ (π : K)) hn_ne, one_pow, hpow]
        exact h_norm_ge_one
      refine ⟨fun w => ?_, ?_⟩
      · rw [hw_eq w]
        exact ⟨hw0_ge_one, le_rfl⟩
      · rw [← pow_lt_pow_iff_left₀ (apply_nonneg w₀ (π : K)) (by linarith) hn_ne, hpow]
    refine ⟨fun h_lt => ?_, fun h_eq => ?_⟩
    · have h_all_tors : ∀ u : (NumberField.RingOfIntegers K)ˣ, u ∈ NumberField.Units.torsion K := by
        intro u
        obtain ⟨⟨ζ, e⟩, hu_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod K u
        haveI : IsEmpty (Fin (NumberField.Units.rank K)) := h_rank ▸ Fin.isEmpty'
        rw [Fintype.prod_empty, mul_one] at hu_eq
        rw [hu_eq]
        exact ζ.2
      let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h_prin
      have hg_span : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) = p.asIdeal :=
        @Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _ p.asIdeal h_prin
      have hg_ne : g ≠ 0 := by
        intro hg0
        apply p.ne_bot
        rw [← hg_span, hg0, Ideal.span_singleton_eq_bot]
      let D_sec := {π : NumberField.RingOfIntegers K //
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
        (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        w₀ (π : K) < X}
      let to_sec : NumberField.Units.torsion K → D_sec := fun ζ =>
        ⟨g * ((ζ.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K), by
          have hspan : Ideal.span ({g * ((ζ.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)} :
              Set (NumberField.RingOfIntegers K)) = p.asIdeal := by
            rw [← hg_span, Ideal.span_singleton_eq_span_singleton]
            exact ⟨ζ.1⁻¹, by simp [mul_assoc]⟩
          exact ⟨hspan, (h_gen_sec _ hspan).1, (h_gen_sec _ hspan).2.mpr h_lt⟩⟩
      have h_bij : Function.Bijective to_sec := by
        refine ⟨fun ζ₁ ζ₂ h => ?_, fun π => ?_⟩
        · have hval : g * ((ζ₁.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) =
              g * ((ζ₂.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) :=
            congrArg Subtype.val h
          have hu := mul_left_cancel₀ hg_ne hval
          exact Subtype.ext (Units.ext hu)
        · have hspan : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
              Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) :=
            hg_span.trans π.2.1.symm
          obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
          refine ⟨⟨u, h_all_tors u⟩, Subtype.ext hu⟩
      rw [← Nat.card_congr (Equiv.ofBijective to_sec h_bij), Nat.card_eq_fintype_card]
      rfl
    · haveI : IsEmpty {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} := by
        refine ⟨fun π => ?_⟩
        have hlt := (h_gen_sec π.1 π.2.1).2.mp π.2.2.2
        linarith
      exact Nat.card_of_isEmpty
  have h_s3 : ∀ Y : ℝ,
      Nat.card {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) = Y} ≤ Module.finrank ℚ K := by
    intro Y
    let S_Y := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      (Ideal.absNorm p.asIdeal : ℝ) = Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    haveI : Finite S_id := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    let emb : S_Y → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor (le_of_eq p.2)⟩
    have hemb_inj : Function.Injective emb := by
      intro p₁ p₂ hp
      exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hp))
    haveI : Finite S_Y := Finite.of_injective emb hemb_inj
    letI : Fintype S_Y := Fintype.ofFinite S_Y
    rw [Nat.card_eq_fintype_card]
    let T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
      (Finset.univ : Finset S_Y).map ⟨Subtype.val, Subtype.val_injective⟩
    have hT_card : Fintype.card S_Y = T.card := (Finset.card_map _).symm
    rw [hT_card]
    rcases T.eq_empty_or_nonempty with hT_emp | hT_ne
    · simp [hT_emp]
    · obtain ⟨p₀, hp₀⟩ := hT_ne
      have hp₀_eq : (Ideal.absNorm p₀.asIdeal : ℝ) = Y := by
        rcases Finset.mem_map.mp hp₀ with ⟨q, _, rfl⟩
        exact q.2
      set m : ℕ := Ideal.absNorm p₀.asIdeal
      have hm_gt_one : 1 < m := by
        have h0 : m ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p₀.ne_bot
        have h1 : m ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p₀.isPrime.ne_top
        omega
      have hp_norm : ∀ p ∈ T, Ideal.absNorm p.asIdeal = m := by
        intro p hp
        rcases Finset.mem_map.mp hp with ⟨q, _, rfl⟩
        exact Nat.cast_injective (q.2.trans hp₀_eq.symm)
      have hp_dvd : ∀ p ∈ T, p.asIdeal ∣ Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K)) := by
        intro p hp
        rw [Ideal.dvd_span_singleton, ← hp_norm p hp]
        exact Ideal.absNorm_mem p.asIdeal
      have hp_coprime : (T : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))).Pairwise
          (fun p₁ p₂ => IsCoprime p₁.asIdeal p₂.asIdeal) := by
        intro p₁ _ p₂ _ hne
        rw [Ideal.isCoprime_iff_sup_eq]
        exact Ideal.IsMaximal.coprime_of_ne p₁.isMaximal p₂.isMaximal
          (fun h => hne (IsDedekindDomain.HeightOneSpectrum.ext h))
      have hprod_dvd : (∏ p ∈ T, p.asIdeal) ∣ Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K)) :=
        Finset.prod_dvd_of_coprime hp_coprime hp_dvd
      have hnorm_dvd : Ideal.absNorm (∏ p ∈ T, p.asIdeal) ∣
          Ideal.absNorm (Ideal.span ({(m : NumberField.RingOfIntegers K)} :
            Set (NumberField.RingOfIntegers K))) :=
        map_dvd Ideal.absNorm hprod_dvd
      have hprod_norm : Ideal.absNorm (∏ p ∈ T, p.asIdeal) = m ^ T.card := by
        rw [map_prod, Finset.prod_congr rfl hp_norm, Finset.prod_const]
      have hspan_norm : Ideal.absNorm (Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K))) = m ^ (Module.finrank ℚ K) := by
        rw [Ideal.absNorm_span_singleton]
        have h1 : ((Algebra.norm ℤ (m : NumberField.RingOfIntegers K)).natAbs : ℚ) =
            (m : ℚ) ^ (Module.finrank ℚ K) := by
          rw [Nat.cast_natAbs, Int.cast_abs, Algebra.coe_norm_int]
          have hcast : ((m : NumberField.RingOfIntegers K) : K) = algebraMap ℚ K (m : ℚ) := by simp
          rw [hcast, Algebra.norm_algebraMap, abs_of_nonneg (by positivity)]
        exact_mod_cast h1
      rw [hprod_norm, hspan_norm] at hnorm_dvd
      have hm_pow_pos : 0 < m ^ (Module.finrank ℚ K) := Nat.pos_of_ne_zero (by positivity)
      exact (Nat.pow_le_pow_iff_right hm_gt_one).mp (Nat.le_of_dvd hm_pow_pos hnorm_dvd)
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos (R := ℚ) (M := K)
  let w_K : ℕ := NumberField.Units.torsionOrder K
  let C₀ : ℝ := (w_K : ℝ) * (n : ℝ) ^ 2
  let c₃₀ : ℝ := max 1 (4 * Real.exp 1 * C₀)
  have hc₃₀_ge1 : 1 ≤ c₃₀ := le_max_left _ _
  have hc₃₀_ge_const : 4 * Real.exp 1 * C₀ ≤ c₃₀ := le_max_right _ _
  have hc₃₀_pos : 0 < c₃₀ := lt_of_lt_of_le zero_lt_one hc₃₀_ge1
  refine ⟨c₃₀, hc₃₀_pos, ?_⟩
  intro X hX w₀ q hq ψ
  have hX_pos : 0 < X := by linarith
  obtain ⟨_, _, _, h_pref⟩ := h_s1 w₀
  let D_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    ∃ h : p.asIdeal.IsPrincipal,
    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))}
  let M_sec : D_prin → ℕ := fun p =>
    Nat.card {π : NumberField.RingOfIntegers K //
      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let F_prin : D_prin → ℂ := fun p =>
    ψ (Additive.ofMul p.2.choose_spec.2.unit) *
      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊X ^ (Module.finrank ℚ K)⌋₊}
  haveI : Finite S_id := Ideal.finite_setOf_absNorm_le ⌊X ^ (Module.finrank ℚ K)⌋₊
  let emb_id : D_prin → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.choose_spec.1⟩
  have hemb_inj : Function.Injective emb_id := by
    intro p₁ p₂ hp
    exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hp))
  haveI : Finite D_prin := Finite.of_injective emb_id hemb_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  have h_lhs : (∑' p : D_prin, (M_sec p : ℂ) * F_prin p) = ∑ p : D_prin, (M_sec p : ℂ) * F_prin p :=
    tsum_fintype _
  have h_rhs : (∑' p : D_prin, F_prin p) = ∑ p : D_prin, F_prin p :=
    tsum_fintype _
  have h_diff_eq :
      (∑' p : D_prin, (M_sec p : ℂ) * F_prin p) -
        ((((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
          ((NumberField.Units.torsionOrder K : ℂ) * (∑' p : D_prin, F_prin p)) =
      ∑ p : D_prin, ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p) := by
    rw [h_pref, Complex.ofReal_one, one_mul, h_lhs, h_rhs, Finset.mul_sum, ← Finset.sum_sub_distrib]
  let B_eq : Finset D_prin :=
    (Finset.univ : Finset D_prin).filter (fun p : D_prin => (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n)
  have h_sum_filter :
      (∑ p : D_prin, ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p)) =
        ∑ p ∈ B_eq, (-(w_K : ℂ) * F_prin p) := by
    rw [← Finset.sum_filter_add_sum_filter_not (Finset.univ : Finset D_prin)
      (fun p : D_prin => (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n)]
    have h_not : ∑ p ∈ (Finset.univ : Finset D_prin).filter
        (fun p : D_prin => ¬ (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n),
        ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p) = 0 := by
      apply Finset.sum_eq_zero
      intro p hp
      have hne : (Ideal.absNorm p.1.asIdeal : ℝ) ≠ X ^ n := (Finset.mem_filter.mp hp).2
      have hlt : (Ideal.absNorm p.1.asIdeal : ℝ) < X ^ n :=
        lt_of_le_of_ne p.2.choose_spec.1 hne
      have hM : M_sec p = w_K := (h_s2 X hX w₀ p.1 p.2.choose).1 hlt
      rw [hM, sub_self]
    have h_eq_sum : ∑ p ∈ B_eq, ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p) =
        ∑ p ∈ B_eq, (-(w_K : ℂ) * F_prin p) := by
      apply Finset.sum_congr rfl
      intro p hp
      have heq : (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n := (Finset.mem_filter.mp hp).2
      have hM : M_sec p = 0 := (h_s2 X hX w₀ p.1 p.2.choose).2 heq
      rw [hM]
      ring
    change (∑ p ∈ B_eq, ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p)) +
      (∑ p ∈ (Finset.univ : Finset D_prin).filter
        (fun p : D_prin => ¬ (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n),
        ((M_sec p : ℂ) * F_prin p - (w_K : ℂ) * F_prin p)) = _
    rw [h_not, add_zero, h_eq_sum]
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq
  let L : ℝ := Real.log X
  have hL_pos : 0 < L := Real.log_pos hX
  have hL_nonneg : 0 ≤ L := le_of_lt hL_pos
  have h_term_norm : ∀ p ∈ B_eq,
      ‖-(w_K : ℂ) * F_prin p‖ ≤ (w_K : ℝ) * ((n : ℝ) * L) := by
    intro p hp
    have heq : (Ideal.absNorm p.1.asIdeal : ℝ) = X ^ n := (Finset.mem_filter.mp hp).2
    dsimp [F_prin]
    rw [norm_mul, norm_neg, Complex.norm_natCast, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, heq, Real.log_pow,
      abs_of_nonneg (mul_nonneg (Nat.cast_nonneg n) hL_nonneg)]
  have h_Beq_card : B_eq.card ≤ n := by
    let S_Xn := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      (Ideal.absNorm p.asIdeal : ℝ) = X ^ n}
    let S_id_Xn : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊X ^ n⌋₊}
    haveI : Finite S_id_Xn := Ideal.finite_setOf_absNorm_le ⌊X ^ n⌋₊
    let emb_Xn : S_Xn → S_id_Xn := fun p => ⟨p.1.asIdeal, Nat.le_floor (le_of_eq p.2)⟩
    have hemb_Xn_inj : Function.Injective emb_Xn := by
      intro p₁ p₂ hp
      exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hp))
    haveI : Finite S_Xn := Finite.of_injective emb_Xn hemb_Xn_inj
    let to_SXn : B_eq → S_Xn := fun p => ⟨p.1.1, (Finset.mem_filter.mp p.2).2⟩
    have h_inj : Function.Injective to_SXn := by
      intro p₁ p₂ hp
      exact Subtype.ext (Subtype.ext (congrArg (fun x : S_Xn => x.1) hp))
    have h1 : Nat.card B_eq ≤ Nat.card S_Xn := Nat.card_le_card_of_injective to_SXn h_inj
    rw [Nat.card_eq_fintype_card, Fintype.card_coe] at h1
    exact le_trans h1 (h_s3 (X ^ n))
  have h_norm_le : ‖∑ p ∈ B_eq, (-(w_K : ℂ) * F_prin p)‖ ≤ C₀ * L := by
    calc ‖∑ p ∈ B_eq, (-(w_K : ℂ) * F_prin p)‖
        ≤ ∑ p ∈ B_eq, ‖-(w_K : ℂ) * F_prin p‖ := norm_sum_le _ _
      _ ≤ ∑ _p ∈ B_eq, ((w_K : ℝ) * ((n : ℝ) * L)) := Finset.sum_le_sum h_term_norm
      _ = (B_eq.card : ℝ) * ((w_K : ℝ) * ((n : ℝ) * L)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (n : ℝ) * ((w_K : ℝ) * ((n : ℝ) * L)) := by
          apply mul_le_mul_of_nonneg_right
          · exact_mod_cast h_Beq_card
          · positivity
      _ = C₀ * L := by dsimp [C₀]; ring
  let t : ℝ := Real.sqrt L
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg L
  have ht_sq : t ^ 2 = L := Real.sq_sqrt hL_nonneg
  have hL_le_exp : L ≤ 4 * Real.exp t := by
    have h1 := Real.add_one_le_exp (t / 2)
    have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith
    have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
    have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
      calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
        _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
        _ = 4 * Real.exp t := by rw [add_halves]
    linarith
  have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
    have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
    have h2 : t ≤ (L + 1) + (-t) := by nlinarith [h1, ht_sq]
    calc Real.exp t ≤ Real.exp ((L + 1) + (-t)) := Real.exp_le_exp.mpr h2
      _ = Real.exp L * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_add, Real.exp_add]
      _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
  have hL_le_X : L ≤ 4 * X * Real.exp 1 * Real.exp (-t) := by
    calc L ≤ 4 * Real.exp t := hL_le_exp
      _ ≤ 4 * (X * Real.exp 1 * Real.exp (-t)) := by linarith [hexp_t_le]
      _ = 4 * X * Real.exp 1 * Real.exp (-t) := by ring
  have hexp_c30 : Real.exp (-t) ≤ Real.exp (-t / c₃₀) := by
    rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
    exact div_le_self ht_nonneg hc₃₀_ge1
  have hX_le_Xn : X ≤ X ^ n := by
    simpa using pow_le_pow_right₀ (le_of_lt hX) hn_pos
  have h_abs_bound : C₀ * L ≤ c₃₀ * X ^ n * Real.exp (-t / c₃₀) := by
    calc C₀ * L
        ≤ C₀ * (4 * X * Real.exp 1 * Real.exp (-t)) :=
          mul_le_mul_of_nonneg_left hL_le_X (by dsimp [C₀]; positivity)
      _ = (4 * Real.exp 1 * C₀) * X * Real.exp (-t) := by ring
      _ ≤ (4 * Real.exp 1 * C₀) * X ^ n * Real.exp (-t) := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_left hX_le_Xn (by dsimp [C₀]; positivity)
          · positivity
      _ ≤ c₃₀ * X ^ n * Real.exp (-t / c₃₀) := by
          apply mul_le_mul
          · exact mul_le_mul_of_nonneg_right hc₃₀_ge_const (by positivity)
          · exact hexp_c30
          · positivity
          · positivity
  have h_goal_eq :
      ‖(∑' p : D_prin, (M_sec p : ℂ) * F_prin p) -
        ((((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
          ((NumberField.Units.torsionOrder K : ℂ) * (∑' p : D_prin, F_prin p))‖ =
      ‖∑ p ∈ B_eq, (-(w_K : ℂ) * F_prin p)‖ :=
    congrArg norm (h_diff_eq.trans h_sum_filter)
  exact h_goal_eq.symm ▸ le_trans h_norm_le h_abs_bound

theorem mitsui_principalPrimeIdeals_char_place_sector_sub_cell_diff_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          ∃ h : p.asIdeal.IsPrincipal,
          (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
          IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
            (∀ w : NumberField.InfinitePlace K,
              1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
            w₀ (π : K) < X} : ℂ) *
          (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
            (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))
      - (∑' k : NumberField.InfinitePlace K → Fin m,
          ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                ∃ h : p.asIdeal.IsPrincipal,
                (Ideal.absNorm p.asIdeal : ℝ) ≤
                  X ^ (Module.finrank ℚ K) *
                    Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
                IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
            (Nat.card {π : NumberField.RingOfIntegers K //
                Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                ∀ w : NumberField.InfinitePlace K,
                  Real.log (w (π : K) / w₀ (π : K)) ∈
                    Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                      (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) *
              (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
    + |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ∀ w : NumberField.InfinitePlace K,
            w (π : K) < X * Real.exp (Real.log X / (m : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let L : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L π :=
    fun _ => Real.log_natCast_nonneg _
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hX_pos : 0 < X := by linarith
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hm_pos : (0 : ℝ) < (m : ℝ) := by positivity
  have hδ_pos : 0 < Real.log X / (m : ℝ) := div_pos hlog_pos hm_pos
  let X' : ℝ := X * Real.exp (Real.log X / (m : ℝ))
  have hX_lt_X' : X < X' := by
    dsimp [X']
    have hexp : 1 < Real.exp (Real.log X / (m : ℝ)) := by
      rw [← Real.exp_zero]
      exact Real.exp_lt_exp.mpr hδ_pos
    nlinarith
  have h_pos_place : ∀ (π : NumberField.RingOfIntegers K), Prime π →
      ∀ w : NumberField.InfinitePlace K, 0 < w (π : K) := by
    intro π h_prime w
    have hπ_K : (π : K) ≠ 0 := by exact_mod_cast h_prime.ne_zero
    exact w.pos_iff.mpr hπ_K
  have h_norm_pos : ∀ (π : NumberField.RingOfIntegers K), Prime π →
      0 < ((Algebra.norm ℤ π).natAbs : ℝ) := by
    intro π h_prime
    have h_nz : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr h_prime.ne_zero
    exact_mod_cast Int.natAbs_pos.mpr h_nz
  have h_prod_norm : ∀ (π : NumberField.RingOfIntegers K),
      (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) =
        ((Algebra.norm ℤ π).natAbs : ℝ) := by
    intro π
    rw [NumberField.InfinitePlace.prod_eq_abs_norm]
    have h_coe : Algebra.norm ℚ (π : K) = (Algebra.norm ℤ π : ℚ) :=
      (Algebra.coe_norm_int π).symm
    rw [h_coe]
    push_cast
    rw [← Int.cast_abs]
    exact (Int.cast_natAbs (Algebra.norm ℤ π)).symm
  have h_sec_norm_le : ∀ (π : NumberField.RingOfIntegers K),
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) →
      w₀ (π : K) < X →
      ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X ^ n := by
    intro π hx_sec hx_lt
    rw [← h_prod_norm π]
    have h_prod_le :
        (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
      refine Finset.prod_le_prod (fun w _ => ?_) (fun w _ => ?_)
      · have hw_nonneg : 0 ≤ w (π : K) := le_trans zero_le_one (hx_sec w).1
        exact pow_nonneg hw_nonneg w.mult
      · have hw_nonneg : 0 ≤ w (π : K) := le_trans zero_le_one (hx_sec w).1
        have hw_le : w (π : K) ≤ X := le_trans (hx_sec w).2 (le_of_lt hx_lt)
        exact pow_le_pow_left₀ hw_nonneg hw_le w.mult
    have h_prod_X :
        (∏ w : NumberField.InfinitePlace K, X ^ w.mult) = X ^ n := by
      dsimp [n]
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    exact h_prod_le.trans (le_of_eq h_prod_X)
  have h_log_norm : ∀ (π : NumberField.RingOfIntegers K), Prime π →
      L π = (n : ℝ) * Real.log (w₀ (π : K)) +
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * Real.log (w (π : K) / w₀ (π : K)) := by
    intro π h_prime
    have hw_ne : ∀ w : NumberField.InfinitePlace K, w (π : K) ≠ 0 :=
      fun w => ne_of_gt (h_pos_place π h_prime w)
    have h1 : L π = ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (π : K)) := by
      dsimp [L]
      rw [← h_prod_norm π, Real.log_prod (fun w _ => pow_ne_zero w.mult (hw_ne w))]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Real.log_pow]
    have h2 : ∀ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * Real.log (w (π : K)) =
          (w.mult : ℝ) * Real.log (w₀ (π : K)) +
            (w.mult : ℝ) * Real.log (w (π : K) / w₀ (π : K)) := by
      intro w
      rw [Real.log_div (hw_ne w) (hw_ne w₀)]
      ring
    have h_sum_mult : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
    rw [h1, Finset.sum_congr rfl (fun w _ => h2 w), Finset.sum_add_distrib,
      ← Finset.sum_mul, h_sum_mult]
  let P_dir : (NumberField.InfinitePlace K → Fin m) → NumberField.RingOfIntegers K → Prop :=
    fun k π =>
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (π : K) / w₀ (π : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))
  let Y_max : (NumberField.InfinitePlace K → Fin m) → ℝ :=
    fun k =>
      X ^ n * Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))
  let P_cell : (NumberField.InfinitePlace K → Fin m) → NumberField.RingOfIntegers K → Prop :=
    fun k π =>
      ((Algebra.norm ℤ π).natAbs : ℝ) ≤ Y_max k ∧ P_dir k π
  have h_cell_sub : ∀ (k : NumberField.InfinitePlace K → Fin m) (π : NumberField.RingOfIntegers K),
      Prime π → P_cell k π →
      (∀ w : NumberField.InfinitePlace K, w (π : K) ≤ w₀ (π : K)) ∧ w₀ (π : K) < X' := by
    intro k π h_prime hk
