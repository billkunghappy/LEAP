        rw [MeasureTheory.measure_diff hV_sub (hV_meas R₀).nullMeasurableSet (hV_ne_top R₀ hR₀),
            ENNReal.toReal_sub_of_le (MeasureTheory.measure_mono hV_sub) (hV_ne_top R₁ hR₁)]
      have h_rad_int : ∫⁻ r in Set.Ico R₀ R₁, ENNReal.ofReal r = ENNReal.ofReal ((R₁ ^ 2 - R₀ ^ 2) / 2) := by
        rw [MeasureTheory.restrict_Ico_eq_restrict_Ioc]
        have h_int : MeasureTheory.IntegrableOn (fun r : ℝ => r) (Set.Ioc R₀ R₁) :=
          continuous_id'.integrableOn_Ioc
        have h_ae_nonneg : 0 ≤ᵐ[MeasureTheory.volume.restrict (Set.Ioc R₀ R₁)] (fun r : ℝ => r) := by
