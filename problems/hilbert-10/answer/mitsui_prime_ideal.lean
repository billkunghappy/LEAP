      _ = W * Y * δ ^ 2 := by ring
  have h_taylor_neg_Y : W * ((Real.exp (-δ) - 1 + δ) * Y) ≤ W * Y * δ ^ 2 := by
    have h1 : (Real.exp (-δ) - 1 + δ) * Y ≤ δ ^ 2 * Y :=
