theorem mitsui_prime_char_place_sector_to_fundamentalCone_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∀ u : (NumberField.RingOfIntegers K)ˣ,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
              ‖(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    (∀ w : NumberField.InfinitePlace K,
                      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                    w₀ (π : K) < X ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                - ((((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
                    (NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
                  (∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        NumberField.mixedEmbedding K (π : K) ∈
                          NumberField.mixedEmbedding.fundamentalCone K ∧
                        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                          X ^ (Module.finrank ℚ K) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
                ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  rcases Nat.eq_zero_or_pos (NumberField.Units.rank K) with h_rank | h_rank
  · obtain ⟨c₃₀, hc₃₀_pos, hc₃₀⟩ :=
      mitsui_principalPrimeIdeals_char_place_sector_bound_of_rank_eq_zero (K := K) h_rank
    refine ⟨c₃₀, hc₃₀_pos, ?_⟩
    intro X hX w₀ q hq _hq_norm ψ _hψ hψ_units
    rw [mitsui_prime_char_place_sector_eq_principalPrimeIdeals X hX w₀ q ψ hψ_units,
      mitsui_prime_char_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals
        (X ^ (Module.finrank ℚ K)) q ψ hψ_units]
    exact hc₃₀ X hX w₀ q hq ψ
  · obtain ⟨c₃₁, hc₃₁_pos, hc₃₁⟩ :=
      mitsui_principalPrimeIdeals_char_place_sector_bound_of_rank_pos (K := K) A hA h_rank
    refine ⟨c₃₁, hc₃₁_pos, ?_⟩
    intro X hX w₀ q hq hq_norm ψ hψ hψ_units
    rw [mitsui_prime_char_place_sector_eq_principalPrimeIdeals X hX w₀ q ψ hψ_units,
      mitsui_prime_char_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals
        (X ^ (Module.finrank ℚ K)) q ψ hψ_units]
    exact hc₃₁ X hX w₀ q hq hq_norm ψ hψ hψ_units

theorem mitsui_prime_char_box_to_fundamentalCone_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            ‖(∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
              - (((NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
                (∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧
                      NumberField.mixedEmbedding K (π : K) ∈
                        NumberField.mixedEmbedding.fundamentalCone K ∧
                      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                        X ^ (Module.finrank ℚ K) ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    ψ (Additive.ofMul π.2.2.2.2.unit) *
                      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
              ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c₁₀, hc₁₀_pos, hc₁₀⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c₂₀, hc₂₀_pos, hc₂₀⟩ := mitsui_prime_box_ge_one_to_place_sectors (K := K)
  obtain ⟨c₃₀, hc₃₀_pos, hc₃₀⟩ :=
    mitsui_prime_char_place_sector_to_fundamentalCone_of_units_eq_one (K := K) A hA
  let M_card : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
  have hM_nonneg : 0 ≤ M_card := Nat.cast_nonneg _
  let c₁ : ℝ := c₁₀ + c₂₀ + M_card * c₃₀ + c₃₀
  have hc₁_pos : 0 < c₁ := by dsimp [c₁]; positivity
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ hψ_units
  have h1 :
      ‖(∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
            IsUnit (Ideal.Quotient.mk q π)},
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
        - (∑' π : {π : NumberField.RingOfIntegers K //
