                  (l_ang w : ℂ) *
                    (((∑ j : Fin r, y j * (w.embedding (η j)).arg) : ℝ) * Complex.I)) := by
            rw [h_tors ζ.1 ζ.2, one_mul]
        _ = f_τ I_x *
              Complex.exp
                (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I) := by
            congr 2
            have h_sum_real :
                (∑ w : NumberField.InfinitePlace K,
                  (l_ang w : ℝ) * ∑ j : Fin r, y j * (w.embedding (η j)).arg) =
                ∑ j : Fin r, y j * A_arg j := by
              dsimp [A_arg]
              calc (∑ w : NumberField.InfinitePlace K,
                    (l_ang w : ℝ) * ∑ j : Fin r, y j * (w.embedding (η j)).arg)
                _ = ∑ w : NumberField.InfinitePlace K,
                      ∑ j : Fin r, (l_ang w : ℝ) * (y j * (w.embedding (η j)).arg) :=
                    Finset.sum_congr rfl (fun w _ => Finset.mul_sum _ _ _)
                _ = ∑ j : Fin r,
                      ∑ w : NumberField.InfinitePlace K, y j * ((l_ang w : ℝ) * (w.embedding (η j)).arg) := by
                    rw [Finset.sum_comm]
                    refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun w _ => by ring))
                _ = ∑ j : Fin r,
                      y j * ∑ w : NumberField.InfinitePlace K, (l_ang w : ℝ) * (w.embedding (η j)).arg :=
