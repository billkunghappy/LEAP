          · rw [Set.indicator_of_mem he, h_zero]
            exact zero_le _
          · rw [Set.indicator_of_notMem he]
            exact zero_le _
      have hA_cyl_meas : MeasurableSet A_cyl := measurableSet_Ico.prod hS_meas
      have hA_exact_meas : MeasurableSet A_exact := by
        have h_eq : A_exact = (Set.Ico R₀ R₁ ×ˢ Set.Ioo (-Real.pi) Real.pi) ∩
            ((fun q : ℝ × ℝ => q.1 * Real.cos q.2) ⁻¹' Set.Ico a₀ b₀ ∩
