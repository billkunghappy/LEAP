    obtain ⟨B₀, γ₀, hγ₀_ne, hB₀_cop, h_span₀⟩ := h_comp I_Df
    have hχ₀_B₀ : ‖χ₀ B₀‖ = 1 := (hχ₀_norm_supp B₀).1 hB₀_cop
    let M_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
