    have hlog_Nb_nonneg : 0 ≤ Real.log (Ideal.absNorm b : ℝ) := Real.log_nonneg hNb_ge_one
    have hLb_ge_one : 1 ≤ Real.log (Ideal.absNorm b : ℝ) + Real.log 4 := by linarith
    have hlog_Nb_le : Real.log (Ideal.absNorm b : ℝ) ≤
