        refine Finset.sum_congr rfl (fun b _ => Finset.sum_comm)
      _ = ∑ ξ : ι_ξ, ∑ b : ι_b,
            ∑ q ∈ S_main,
              if q ∈ S_main_slice ξ then
                (Hat_q q : ℂ) * (c_ind ξ b * χ (l_emb b) * ψ₀ b q)
              else 0 := Finset.sum_comm
      _ = ∑ ξ : ι_ξ, ∑ b : ι_b,
            ∑ q ∈ S_main_slice ξ,
