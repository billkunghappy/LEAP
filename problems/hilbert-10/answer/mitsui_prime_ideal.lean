          linarith
  · let B₂ : ℝ := min (B₁ / K_A) ε₁
    have hB₂_pos : 0 < B₂ := lt_min (by positivity) hε₁_pos
    have hB₂_le_B₁ : B₂ ≤ B₁ / K_A := min_le_left _ _
    have hB₂_le_ε₁ : B₂ ≤ ε₁ := min_le_right _ _
    refine ⟨B₂, hB₂_pos, ?_⟩
    intro q hq χ hχ_ray hχ_norm_supp hχ_nonprin g_χ hg_diff hg_eq hg_growth σ hσ
    have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1 :=
      h_norm_of_supp q χ hχ_norm_supp
    rcases lt_or_ge 1 σ with hσ_gt | hσ_le
    · have hσ_re : 1 < (σ : ℂ).re := by simpa using hσ_gt
      rw [hg_eq (σ : ℂ) hσ_re]
      exact (mitsui_ray_char_LSeries_primePowers_eq_neg_logDeriv χ hχ_norm (σ : ℂ) hσ_re).1
    · by_cases h_sq : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ (χ I₀) ^ 2 ≠ 1
      · obtain ⟨_, _, hMq_ge_one, _, _, _, _⟩ := h_bridge q hq
        have hMq_pos : 0 < (Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) :=
          lt_of_lt_of_le zero_lt_one hMq_ge_one
        have h_div : B₂ / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ)))) ≤
            (B₁ / K_A) / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ)))) :=
          div_le_div_of_nonneg_right hB₂_le_B₁ (le_of_lt hMq_pos)
        exact h_cplx_branch q hq χ hχ_ray hχ_norm_supp h_sq g_χ hg_diff hg_eq hg_growth σ (by linarith)
      · have hχ_real : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → (χ I) ^ 2 = 1 := by
          intro I hI
          by_contra h_ne
          exact h_sq ⟨I, hI, h_ne⟩
        obtain ⟨_, _, hMq_ge_one, _, _, _, _⟩ := h_bridge q hq
        have h_div : B₂ / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ)))) ≤ ε₁ := by
          calc B₂ / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))))
              ≤ ε₁ / 1 := div_le_div₀ (le_of_lt hε₁_pos) hB₂_le_ε₁ zero_lt_one hMq_ge_one
            _ = ε₁ := div_one _
        intro h_zero
        exact h_exc ⟨q, hq, χ, hχ_ray, hχ_norm_supp, hχ_real, g_χ, hg_diff, hg_eq, hg_growth,
          σ, by linarith, hσ_le, h_zero⟩

theorem mitsui_ray_char_heckeL_zeroFree_and_re_logDeriv_bound {K : Type u} [Field K] [NumberField K] (A : ℕ) (hA : 1 < A) :
    ∃ (B₀ A₀ : ℝ), 0 < B₀ ∧ B₀ ≤ 1 / 2 ∧ 0 < A₀ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ q →
            χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0)) →
          (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) →
          ∃ g_χ : ℂ → ℂ,
            Differentiable ℂ g_χ ∧
            (∀ s : ℂ, 1 < s.re →
              g_χ s = LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
            (∀ s : ℂ,
              1 - B₀ / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) + Real.log (4 + |s.im|)) ≤ s.re →
              g_χ s ≠ 0 ∧
              (-deriv g_χ s / g_χ s).re ≤
                A₀ * ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) + Real.log (4 + |s.im|))) :=
by
  obtain ⟨M₀, hM₀_pos, h_rhp_LSeries⟩ := mitsui_ray_char_LSeries_norm_le_of_one_lt_re (K := K)
  obtain ⟨A₁, hA₁_pos, h_entire_growth⟩ := mitsui_ray_char_heckeL_entire_and_vertical_growth (K := K)
  obtain ⟨C₂, hC₂_pos, h_strip_re⟩ :=
    mitsui_ray_char_heckeL_re_logDeriv_bound_of_local_zeroFree_and_vertical_growth (K := K) A₁ hA₁_pos
  obtain ⟨B₁, hB₁_pos, h_nonreal_zf⟩ :=
    mitsui_ray_char_heckeL_nonreal_zeroFree_of_vertical_growth (K := K) A₁ hA₁_pos
  obtain ⟨B₂, hB₂_pos, h_real_zf⟩ :=
    mitsui_ray_char_heckeL_real_zeroFree_of_vertical_growth (K := K) A hA A₁ hA₁_pos
  have hA_pos : (0 : ℝ) < (A : ℝ) := by
    have : 0 < A := by omega
    exact_mod_cast this
  have hA_ge_one : (1 : ℝ) ≤ (A : ℝ) := by
    have : 1 ≤ A := by omega
    exact_mod_cast this
  have h2A_pos : 0 < 2 * (A : ℝ) := by positivity
  have h2A_ne : 2 * (A : ℝ) ≠ 0 := ne_of_gt h2A_pos
  let B₁' : ℝ := min (B₁ / (2 * (A : ℝ))) B₂
  have hB₁'_pos : 0 < B₁' := lt_min (by positivity) hB₂_pos
  have hB₁'_le_B₁_div : B₁' ≤ B₁ / (2 * (A : ℝ)) := min_le_left _ _
  have hB₁'_le_B₂ : B₁' ≤ B₂ := min_le_right _ _
  let B₀ : ℝ := min (B₁' / 2) (1 / 8)
  have hB₀_pos : 0 < B₀ := lt_min (half_pos hB₁'_pos) (by norm_num)
  have hB₀_le_half : B₀ ≤ 1 / 2 := le_trans (min_le_right _ _) (by norm_num)
  have hB₀_le_half_B₁' : B₀ ≤ B₁' / 2 := min_le_left _ _
  have hB₀_le_eight : B₀ ≤ 1 / 8 := min_le_right _ _
  let A₀ : ℝ := 2 * (A : ℝ) * C₂ + 4 * M₀
  have hA₀_pos : 0 < A₀ := by dsimp [A₀]; positivity
  have hlog4_gt_one : 1 < Real.log 4 := by
    rw [← Real.log_exp 1]
    exact Real.log_lt_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
  have h_log_ge_one : ∀ t : ℝ, 1 ≤ Real.log (4 + |t|) := by
    intro t
    have ht : 4 ≤ 4 + |t| := by linarith [abs_nonneg t]
    exact le_trans (le_of_lt hlog4_gt_one) (Real.log_le_log (by norm_num) ht)
  have h_log_pos : ∀ t : ℝ, 0 < Real.log (4 + |t|) :=
    fun t => lt_of_lt_of_le zero_lt_one (h_log_ge_one t)
  refine ⟨B₀, A₀, hB₀_pos, hB₀_le_half, hA₀_pos, ?_⟩
  intro q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI]
    · rw [(hχ_norm_supp I).2 hI, norm_zero]
      linarith
  obtain ⟨g_χ, hg_diff, hg_eq, hg_growth⟩ :=
    h_entire_growth q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  refine ⟨g_χ, hg_diff, hg_eq, ?_⟩
  set N_q : ℝ := (Ideal.absNorm q : ℝ)
  set M_q : ℝ := N_q ^ (1 / (2 * (A : ℝ)))
  have hq_norm_ne_zero : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hNq_ge_one : 1 ≤ N_q := by
    dsimp [N_q]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hq_norm_ne_zero
  have hNq_pos : 0 < N_q := lt_of_lt_of_le zero_lt_one hNq_ge_one
  have hMq_ge_one : 1 ≤ M_q := by
    dsimp [M_q]
    exact Real.one_le_rpow hNq_ge_one (by positivity)
  have hMq_pos : 0 < M_q := lt_of_lt_of_le zero_lt_one hMq_ge_one
  have hlog_Nq_nonneg : 0 ≤ Real.log N_q := Real.log_nonneg hNq_ge_one
  have h_log_Nq_le : Real.log N_q ≤ 2 * (A : ℝ) * M_q := by
    have h1 : Real.log M_q = (1 / (2 * (A : ℝ))) * Real.log N_q := by
      dsimp [M_q]
      exact Real.log_rpow hNq_pos (1 / (2 * (A : ℝ)))
    have h2 : Real.log M_q ≤ M_q - 1 := Real.log_le_sub_one_of_pos hMq_pos
    have h3 : (1 / (2 * (A : ℝ))) * Real.log N_q ≤ M_q := by linarith
    have h4 := mul_le_mul_of_nonneg_left h3 (le_of_lt h2A_pos)
    have h5 : (2 * (A : ℝ)) * ((1 / (2 * (A : ℝ))) * Real.log N_q) = Real.log N_q := by
      field_simp [h2A_ne]
    linarith
  have h_scale_bridge : ∀ y : ℝ,
      Real.log N_q + Real.log (4 + |y|) ≤ 2 * (A : ℝ) * (M_q + Real.log (4 + |y|)) := by
    intro y
    have hy_pos : 0 < Real.log (4 + |y|) := h_log_pos y
    have hy_le : Real.log (4 + |y|) ≤ 2 * (A : ℝ) * Real.log (4 + |y|) := by
      have : (1 : ℝ) ≤ 2 * (A : ℝ) := by linarith
      nlinarith
    linarith
  have h_zf : ∀ z : ℂ, 1 - B₁' / (M_q + Real.log (4 + |z.im|)) ≤ z.re → g_χ z ≠ 0 := by
    intro z hz_re
    set L_z : ℝ := Real.log (4 + |z.im|)
    have hLz_ge_one : 1 ≤ L_z := h_log_ge_one z.im
    have hLz_pos : 0 < L_z := h_log_pos z.im
    rcases eq_or_ne z.im 0 with hz_im_zero | hz_im_ne
    · have hz_eq : (z.re : ℂ) = z := by
        apply Complex.ext
        · simp
        · simp [hz_im_zero]
      rw [← hz_eq]
      apply h_real_zf q hq χ hχ_ray hχ_norm_supp hχ_nonprin g_χ hg_diff hg_eq hg_growth z.re
      have h_div : B₁' / (M_q + L_z) ≤ B₂ / M_q :=
        div_le_div₀ (le_of_lt hB₂_pos) hB₁'_le_B₂ hMq_pos (by linarith)
      linarith
    · apply h_nonreal_zf q hq χ hχ_ray hχ_norm_supp hχ_nonprin g_χ hg_diff hg_eq hg_growth z hz_im_ne
      have h2AB₁' : 2 * (A : ℝ) * B₁' ≤ B₁ := by
        have h1 := mul_le_mul_of_nonneg_left hB₁'_le_B₁_div (le_of_lt h2A_pos)
        have h2 : 2 * (A : ℝ) * (B₁ / (2 * (A : ℝ))) = B₁ := by field_simp [h2A_ne]
        linarith
      have h_denom_pos : 0 < Real.log N_q + L_z := by linarith
      have h_div : B₁' / (M_q + L_z) ≤ B₁ / (Real.log N_q + L_z) := by
        calc B₁' / (M_q + L_z)
            = (2 * (A : ℝ) * B₁') / (2 * (A : ℝ) * (M_q + L_z)) := by
              field_simp [h2A_ne]
          _ ≤ B₁ / (Real.log N_q + L_z) :=
              div_le_div₀ (le_of_lt hB₁_pos) h2AB₁' h_denom_pos (h_scale_bridge z.im)
      linarith
  intro s hs_re
  set t : ℝ := s.im
  set L : ℝ := Real.log (4 + |t|)
  set L_q : ℝ := M_q + L
  have hL_ge_one : 1 ≤ L := h_log_ge_one t
  have hL_pos : 0 < L := h_log_pos t
  have hLq_ge_two : 2 ≤ L_q := by dsimp [L_q]; linarith
  have hLq_pos : 0 < L_q := by linarith
  have hs_ne : g_χ s ≠ 0 := by
    apply h_zf s
    have hB₀_le_B₁' : B₀ ≤ B₁' := by linarith
    have h_div : B₀ / L_q ≤ B₁' / L_q := div_le_div_of_nonneg_right hB₀_le_B₁' (le_of_lt hLq_pos)
    linarith
  refine ⟨hs_ne, ?_⟩
  rcases le_or_gt s.re (5 / 4) with hs_le_54 | hs_gt_54
  · have hs_ge_78 : 7 / 8 ≤ s.re := by
      have h_div : B₀ / L_q ≤ 1 / 8 := by
        calc B₀ / L_q ≤ (1 / 8) / 1 := div_le_div₀ (by norm_num) hB₀_le_eight zero_lt_one (by linarith)
          _ = 1 / 8 := div_one _
      linarith
    have hs_decomp : ((s.re : ℂ) + (t : ℂ) * Complex.I) = s := by
      apply Complex.ext <;> simp [t]
    have h_local_zf : ∀ z : ℂ, s.re ≤ z.re → z.re ≤ 2 → |z.im - t| ≤ 1 / 2 → g_χ z ≠ 0 := by
      intro z hz_re1 _ hz_im
      apply h_zf z
      have hz_im_le : |z.im| ≤ |t| + 1 / 2 := by
        have h1 : |z.im| - |t| ≤ |z.im - t| := abs_sub_abs_le_abs_sub z.im t
        linarith
      have h_sq : 4 + |z.im| ≤ (4 + |t|) ^ 2 := by
        have : 0 ≤ |t| := abs_nonneg t
        nlinarith
      have h_log_z : Real.log (4 + |z.im|) ≤ 2 * L := by
        have h1 := Real.log_le_log (by positivity) h_sq
        rw [Real.log_pow] at h1
        push_cast at h1
        dsimp [L]; linarith
      have h_Lq_z_le : M_q + Real.log (4 + |z.im|) ≤ 2 * L_q := by
        dsimp [L_q]; linarith
      have h_Lq_z_pos : 0 < M_q + Real.log (4 + |z.im|) := by
        have := h_log_ge_one z.im
        linarith
      have h_div_z : B₀ / L_q ≤ B₁' / (M_q + Real.log (4 + |z.im|)) := by
        calc B₀ / L_q = (2 * B₀) / (2 * L_q) := by ring
          _ ≤ B₁' / (2 * L_q) := div_le_div_of_nonneg_right (by linarith) (by positivity)
          _ ≤ B₁' / (M_q + Real.log (4 + |z.im|)) :=
              div_le_div_of_nonneg_left (le_of_lt hB₁'_pos) h_Lq_z_pos h_Lq_z_le
      linarith
    have h_re_bound := h_strip_re q hq χ hχ_norm g_χ hg_diff hg_eq hg_growth s.re t hs_ge_78 hs_le_54 h_local_zf
    rw [hs_decomp] at h_re_bound
    have h_bridge_t := h_scale_bridge t
    have h_C₂_le : C₂ * (Real.log N_q + L) ≤ (2 * (A : ℝ) * C₂) * L_q := by
      calc C₂ * (Real.log N_q + L)
          ≤ C₂ * (2 * (A : ℝ) * L_q) := mul_le_mul_of_nonneg_left h_bridge_t (le_of_lt hC₂_pos)
        _ = (2 * (A : ℝ) * C₂) * L_q := by ring
    have h_A₀_le : (2 * (A : ℝ) * C₂) * L_q ≤ A₀ * L_q := by
      have : 2 * (A : ℝ) * C₂ ≤ A₀ := by dsimp [A₀]; linarith
      exact mul_le_mul_of_nonneg_right this (le_of_lt hLq_pos)
    linarith
  · have hs_gt_one : 1 < s.re := by linarith
    obtain ⟨_, hΛ_eq⟩ := mitsui_ray_char_LSeries_primePowers_eq_neg_logDeriv χ hχ_norm s hs_gt_one
    have hU_mem : {w : ℂ | 1 < w.re} ∈ nhds s :=
      (isOpen_lt continuous_const Complex.continuous_re).mem_nhds hs_gt_one
    have h_ev_g : g_χ =ᶠ[nhds s] LSeries (fun n =>
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
          χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) := by
      filter_upwards [hU_mem] with w hw
      exact hg_eq w hw
    have h_logDeriv_eq : -deriv g_χ s / g_χ s =
        LSeries (fun n =>
          ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
