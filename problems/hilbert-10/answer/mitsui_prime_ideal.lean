theorem mitsui_mellin_Ioi_zero_eq_folded_Ioi_one_of_polarFree_inversion (Φ₁ Φ₂ : ℝ → ℂ) (Ψ : ℝ → ℝ)
    (hΦ₁_cont : ContinuousOn Φ₁ (Set.Ioi (1 : ℝ)))
    (hΦ₂_cont : ContinuousOn Φ₂ (Set.Ioi (1 : ℝ)))
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΦ_le : ∀ u ∈ Set.Ioi (1 : ℝ), ‖Φ₁ u‖ ≤ Ψ u ∧ ‖Φ₂ u‖ ≤ Ψ u)
    (hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume)
    (h_inv : ∀ u ∈ Set.Ioi (1 : ℝ), ((u ^ (-3 : ℝ) : ℝ) : ℂ) * Φ₁ u⁻¹ = Φ₂ u)
    (s : ℂ) :
    (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u) =
      ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u) :=
by
  have _ := hΨ_nn
  set g : ℝ → ℂ := fun u => (u : ℂ) ^ s * Φ₁ u
  set h : ℝ → ℂ := fun u => (u : ℂ) ^ (1 - s) * Φ₂ u
  have h_cpow_cont : ∀ z : ℂ, ContinuousOn (fun u : ℝ => (u : ℂ) ^ z) (Set.Ioi (1 : ℝ)) := by
    intro z
    refine ContinuousOn.cpow_const Complex.continuous_ofReal.continuousOn ?_
    intro u hu
    exact Or.inl (by simpa using lt_trans zero_lt_one hu)
  have hg_meas : MeasureTheory.AEStronglyMeasurable g
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
    ((h_cpow_cont s).mul hΦ₁_cont).aestronglyMeasurable measurableSet_Ioi
  have hh_meas : MeasureTheory.AEStronglyMeasurable h
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
    ((h_cpow_cont (1 - s)).mul hΦ₂_cont).aestronglyMeasurable measurableSet_Ioi
  have hg_int_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (1 : ℝ)) MeasureTheory.volume := by
    refine (hΨ_int s.re).mono' hg_meas ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    dsimp [g]
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hu_pos]
    exact mul_le_mul_of_nonneg_left (hΦ_le u hu).1 (Real.rpow_nonneg (le_of_lt hu_pos) s.re)
  have hh_int_Ioi : MeasureTheory.IntegrableOn h (Set.Ioi (1 : ℝ)) MeasureTheory.volume := by
    refine (hΨ_int (1 - s).re).mono' hh_meas ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    dsimp [h]
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hu_pos]
    exact mul_le_mul_of_nonneg_left (hΦ_le u hu).2 (Real.rpow_nonneg (le_of_lt hu_pos) (1 - s).re)
  have h_jac : ∀ u ∈ Set.Ioi (1 : ℝ), |-(u ^ 2)⁻¹| • g u⁻¹ = h u := by
    intro u hu
    dsimp [g, h]
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    have hu_nn : 0 ≤ u := le_of_lt hu_pos
    have hu_c_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hu_pos)
    have h_abs : |-(u ^ 2)⁻¹| = u ^ (1 : ℝ) * u ^ (-3 : ℝ) := by
      rw [abs_neg, abs_of_pos (inv_pos.mpr (sq_pos_of_pos hu_pos))]
      rw [← Real.rpow_add hu_pos]
      have h13 : (1 : ℝ) + (-3 : ℝ) = -2 := by norm_num
      rw [h13]
      have h2 : (-2 : ℝ) = ((-2 : ℤ) : ℝ) := by norm_num
      rw [h2, Real.rpow_intCast, zpow_neg, zpow_two, sq]
    rw [h_abs]
    have h_inv_cpow : ((u⁻¹ : ℝ) : ℂ) ^ s = (u : ℂ) ^ (-s) := by
