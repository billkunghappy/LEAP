    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI]
    · rw [(hχ_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  obtain ⟨_, g_K, _, hg_K_diff, hg_K_eq, _⟩ :=
    mitsui_regularized_dedekindZeta_entire_and_vertical_growth (K := K)
  obtain ⟨B, C, D_K, hB_pos, _, hC_pos, hDK_eq, hDK_bound⟩ :=
    mitsui_primePowers_sub_pole_analytic_continuation_bound (K := K)
  obtain ⟨Λ₂, hΛ₂_nonneg, hΛ₂_LSeries, hΛ₂_dom⟩ :=
    mitsui_ray_char_primePowers_two_factor_domination q χ hχ_norm_supp hχ_real
  have hdslope_diff : Differentiable ℂ (dslope g_χ 1) := by
    rw [← differentiableOn_univ]
