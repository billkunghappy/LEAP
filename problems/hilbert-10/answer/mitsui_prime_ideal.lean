      exact h_s1 (J_rep C : Ideal R) (fun a => star (ψ_f a))
        (by change star (ψ_f 0) = 0; rw [hψ0, star_zero]) y
        ((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)))
  · 
    have h_term1 : ∀ (C : ClassGroup R) (x : R) (y : Fin r → ℝ),
