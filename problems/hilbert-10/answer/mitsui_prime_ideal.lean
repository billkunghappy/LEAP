  let ψ₁ : nonZeroDivisors (Ideal R) →* ℂ := 1
  have hψ₁_supp : ∀ I : nonZeroDivisors (Ideal R),
      ((I : Ideal R) ⊔ (⊤ : Ideal R) = ⊤ → ‖ψ₁ I‖ = 1) ∧
      (¬ ((I : Ideal R) ⊔ (⊤ : Ideal R) = ⊤) → ψ₁ I = 0) := by
    intro I
    refine ⟨fun _ => norm_one, fun h => False.elim (h (sup_top_eq (I : Ideal R)))⟩
  have hψ₁_norm : ∀ I : nonZeroDivisors (Ideal R), ‖ψ₁ I‖ ≤ 1 :=
    fun _ => le_of_eq norm_one
  have hψ₁_span : ∀ (x : R) (hx_ne : x ≠ 0),
