              · linarith [Int.sub_one_lt_floor ((M : ℝ) * c i)]
              · linarith [Int.floor_le ((M : ℝ) * c i)]
            have h_re_le : |(w.embedding ((b i : NumberField.RingOfIntegers K) : K)).re| ≤
                w ((b i : NumberField.RingOfIntegers K) : K) := by
              rw [← NumberField.InfinitePlace.norm_embedding_eq]
              exact Complex.abs_re_le_norm _
            have hw_le_sum : w ((b i : NumberField.RingOfIntegers K) : K) ≤
                ∑ v : NumberField.InfinitePlace K, v ((b i : NumberField.RingOfIntegers K) : K) :=
              Finset.single_le_sum (fun v _ => AbsoluteValue.nonneg v.1 _) (Finset.mem_univ w)
            calc |(m i : ℝ) - (M : ℝ) * c i| * |(w.embedding ((b i : NumberField.RingOfIntegers K) : K)).re|
              _ ≤ 1 * w ((b i : NumberField.RingOfIntegers K) : K) :=
                mul_le_mul hm_abs h_re_le (abs_nonneg _) zero_le_one
              _ = w ((b i : NumberField.RingOfIntegers K) : K) := one_mul _
              _ ≤ ∑ v : NumberField.InfinitePlace K, v ((b i : NumberField.RingOfIntegers K) : K) := hw_le_sum
      have hx₀_re_eq : ∀ w : NumberField.InfinitePlace K,
          (w.embedding (x₀ : K)).re = 1 + (N_q : ℝ) * (w.embedding (y : K)).re := by
        intro w
        dsimp [x₀]
        push_cast
        simp
      have hx₀_neg : (w₁.embedding (x₀ : K)).re < 0 := by
        have h_err := (abs_le.mp (h_re_y w₁)).2
        rw [h_sum_c w₁ hw₁_real, if_pos rfl] at h_err
        have hy_le : (w₁.embedding (y : K)).re ≤ -(M : ℝ) + E₀ := by linarith
        have h_mul_le : (N_q : ℝ) * (w₁.embedding (y : K)).re ≤ (N_q : ℝ) * (-(M : ℝ) + E₀) :=
          mul_le_mul_of_nonneg_left hy_le (le_of_lt hNq_pos)
        have h_neg_one : -(M : ℝ) + E₀ < -1 := by linarith
        have h_prod_lt : (N_q : ℝ) * (-(M : ℝ) + E₀) < -1 := by
          nlinarith
        rw [hx₀_re_eq w₁]
        linarith
      have hx₀_ne : x₀ ≠ 0 := by
        intro h0
        rw [h0] at hx₀_neg
        simp at hx₀_neg
      refine ⟨x₀, hx₀_ne, hx₀_q, hx₀_neg, ?_⟩
      intro w hw hw_ne
      have h_err := (abs_le.mp (h_re_y w)).1
      rw [h_sum_c w hw, if_neg hw_ne] at h_err
      have hy_ge : (M : ℝ) - E₀ ≤ (w.embedding (y : K)).re := by linarith
      have h_pos_y : 0 < (w.embedding (y : K)).re := by linarith
      rw [hx₀_re_eq w]
      have : 0 < (N_q : ℝ) * (w.embedding (y : K)).re := mul_pos hNq_pos h_pos_y
      linarith
    obtain ⟨x₀, hx₀_ne, hx₀_q, hx₀_neg, hx₀_pos⟩ := h_s4
    let I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      ⟨Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx₀_ne)⟩
    refine ⟨I₀, h_coprime x₀ hx₀_q, ?_⟩
    have hχ_x₀ : χ_gr I₀ = (-1 : ℂ) ^ (L w₁) := by
      rw [h_prin_simple x₀ hx₀_ne hx₀_q]
      have h_factor : ∀ w : NumberField.InfinitePlace K,
          (w.embedding (x₀ : K) / (w (x₀ : K) : ℂ)) ^ (L w) =
            if w = w₁ then (-1 : ℂ) ^ (L w₁) else 1 := by
        intro w
        by_cases hw : w = w₁
        · subst hw
          simp only [↓reduceIte]
          rw [h_real_neg x₀ w hw₁_real hx₀_neg]
        · simp only [hw, ↓reduceIte]
          rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw_real | hw_cplx
          · rw [h_real_pos x₀ w hw_real (hx₀_pos w hw_real hw), one_zpow]
          · rw [hL_cplx w hw_cplx, zpow_zero]
      calc (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x₀ : K) / (w (x₀ : K) : ℂ)) ^ (L w))
        _ = ∏ w : NumberField.InfinitePlace K,
            (if w = w₁ then (-1 : ℂ) ^ (L w₁) else 1) :=
          Finset.prod_congr rfl (fun w _ => h_factor w)
        _ = (-1 : ℂ) ^ (L w₁) := by
          rw [Finset.prod_ite_eq' Finset.univ w₁]
          simp
    rw [hχ_x₀]
    exact hw₁_odd

theorem mitsui_narrow_ray_char_primitive_conductor_reduction {K : Type u} [Field K] [NumberField K]
    (b : Ideal (NumberField.RingOfIntegers K)) (hb : b ≠ 0)
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_narrow : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ b →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
      ψ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hψ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤ → ‖ψ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤) → ψ I = 0))
    (hψ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤ ∧ ψ I₀ ≠ 1) :
    ∃ (f : Ideal (NumberField.RingOfIntegers K))
      (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
      b ≤ f ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        x - 1 ∈ f →
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
        ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0)) ∧
      (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ ψ₀ I₀ ≠ 1) ∧
      (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
          x - 1 ∈ f' ∧
          (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
          ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤ → ψ I = ψ₀ I) :=
by
  classical
  have h_re_eq : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K)
      (hw : w.IsReal),
      (w.embedding (x : K)).re = NumberField.InfinitePlace.embedding_of_isReal hw (x : K) := by
    intro x w hw
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)
    rw [← h1, Complex.ofReal_re]
  have h_norm_real : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal → w (x : K) = |(w.embedding (x : K)).re| := by
    intro x w hw
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)
    rw [h_re_eq x w hw, ← NumberField.InfinitePlace.norm_embedding_eq, ← h1,
      Complex.norm_real, Real.norm_eq_abs]
  have h_re_one : ∀ (w : NumberField.InfinitePlace K), w.IsReal →
      0 < (w.embedding ((1 : NumberField.RingOfIntegers K) : K)).re := by
    intro w hw
    rw [h_re_eq 1 w hw]
    push_cast
    rw [map_one]
    exact zero_lt_one
  have h_re_mul : ∀ (x y : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal →
      (w.embedding ((x * y : NumberField.RingOfIntegers K) : K)).re =
        (w.embedding (x : K)).re * (w.embedding (y : K)).re := by
    intro x y w hw
    rw [h_re_eq (x * y) w hw, h_re_eq x w hw, h_re_eq y w hw]
    push_cast
    exact map_mul (NumberField.InfinitePlace.embedding_of_isReal hw) (x : K) (y : K)
  have h_real_pos_of_mul_eq : ∀ (c₁ c₂ d e : NumberField.RingOfIntegers K),
      c₂ * d = c₁ * e →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (c₁ : K)).re) →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (c₂ : K)).re) →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (d : K)).re) →
      ∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (e : K)).re := by
    intro c₁ c₂ d e he_eq hc₁_pos hc₂_pos hd_pos w hw
    have h_eq : (w.embedding (c₁ : K)).re * (w.embedding (e : K)).re =
        (w.embedding (c₂ : K)).re * (w.embedding (d : K)).re := by
      rw [← h_re_mul c₁ e w hw, ← h_re_mul c₂ d w hw, he_eq]
    have h_prod_pos : 0 < (w.embedding (c₁ : K)).re * (w.embedding (e : K)).re := by
      rw [h_eq]
      exact mul_pos (hc₂_pos w hw) (hd_pos w hw)
    exact pos_of_mul_pos_right h_prod_pos (le_of_lt (hc₁_pos w hw))
  have h_mult : ∀ (q₁ : Ideal (NumberField.RingOfIntegers K)), q₁ ≠ 0 →
      ∀ (c₁ : NumberField.RingOfIntegers K), c₁ ≠ 0 →
      ∃ (d₂ : NumberField.RingOfIntegers K) (_hd₂_ne : d₂ ≠ 0),
        d₂ - 1 ∈ q₁ ∧
        Ideal.span ({d₂} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧
        ∀ w : NumberField.InfinitePlace K, w.IsReal →
          0 < (w.embedding ((c₁ * d₂ : NumberField.RingOfIntegers K) : K)).re := by
    intro q₁ hq₁ c₁ hc₁_ne
    let m_q : ℕ := Ideal.absNorm q₁
    have hm_q_ne : m_q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq₁
    have hm_q_ge : (1 : ℝ) ≤ (m_q : ℝ) := by
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hm_q_ne
    have hm_q_mem : (m_q : NumberField.RingOfIntegers K) ∈ q₁ := Ideal.absNorm_mem q₁
    let B : ℝ := (∑ v : NumberField.InfinitePlace K, (v (c₁ : K))⁻¹) + 1
    let k : ℕ := ⌊B⌋₊ + 1
    let N_mult : ℕ := k * m_q
    let d₀ : NumberField.RingOfIntegers K := 1 + (N_mult : NumberField.RingOfIntegers K) * c₁
    have hd₀_sub : d₀ - 1 ∈ q₁ := by
      have h_eq : d₀ - 1 = ((k : NumberField.RingOfIntegers K) * c₁) *
          (m_q : NumberField.RingOfIntegers K) := by
        dsimp [d₀, N_mult]
        push_cast
        ring
      rw [h_eq]
      exact q₁.mul_mem_left _ hm_q_mem
    have hd₀_cop : Ideal.span ({d₀} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ := by
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      refine ⟨d₀ * 1, Ideal.mem_span_singleton.mpr ⟨1, rfl⟩, -(d₀ - 1),
        q₁.neg_mem hd₀_sub, ?_⟩
      ring
    have hd₀_pos : ∀ w : NumberField.InfinitePlace K, w.IsReal →
        0 < (w.embedding ((c₁ * d₀ : NumberField.RingOfIntegers K) : K)).re := by
      intro w hw
      let r : ℝ := (w.embedding (c₁ : K)).re
      have hc₁K_ne : (c₁ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hc₁_ne
      have hw_pos : 0 < w (c₁ : K) := w.pos_iff.mpr hc₁K_ne
      have hr_abs : w (c₁ : K) = |r| := h_norm_real c₁ w hw
      have hr_abs_pos : 0 < |r| := hr_abs ▸ hw_pos
      have hr_abs_ne : |r| ≠ 0 := ne_of_gt hr_abs_pos
      have hr_sq_pos : 0 < |r| ^ 2 := sq_pos_of_pos hr_abs_pos
      have h_le_sum : (w (c₁ : K))⁻¹ ≤ ∑ v : NumberField.InfinitePlace K, (v (c₁ : K))⁻¹ :=
        Finset.single_le_sum (f := fun v : NumberField.InfinitePlace K => (v (c₁ : K))⁻¹)
          (fun v _ => inv_nonneg.mpr (apply_nonneg v (c₁ : K))) (Finset.mem_univ w)
      have h_lt_B : |r|⁻¹ < B := by
        rw [← hr_abs]
        dsimp [B]
        linarith
      have hB_lt_k : B < (k : ℝ) := by
        dsimp [k]
        push_cast
        exact Nat.lt_floor_add_one B
      have hk_le_N : (k : ℝ) ≤ (N_mult : ℝ) := by
        dsimp [N_mult]
        push_cast
        exact le_mul_of_one_le_right (Nat.cast_nonneg k) hm_q_ge
      have h_inv_lt : |r|⁻¹ < (N_mult : ℝ) := lt_of_lt_of_le (lt_trans h_lt_B hB_lt_k) hk_le_N
      have h_mul_lt : |r|⁻¹ * |r| ^ 2 < (N_mult : ℝ) * |r| ^ 2 :=
        mul_lt_mul_of_pos_right h_inv_lt hr_sq_pos
      have h_lhs_abs : |r|⁻¹ * |r| ^ 2 = |r| := by
        rw [sq, inv_mul_cancel_left₀ hr_abs_ne]
      rw [h_lhs_abs, sq_abs] at h_mul_lt
      have h_neg_le : -r ≤ |r| := neg_le_abs r
      have h_re_d₀ : (w.embedding (d₀ : K)).re = 1 + (N_mult : ℝ) * r := by
        rw [h_re_eq d₀ w hw]
        dsimp [r]
        rw [h_re_eq c₁ w hw]
        dsimp [d₀]
        push_cast
        rw [map_add, map_one, map_mul, map_natCast]
      rw [h_re_mul c₁ d₀ w hw]
      change 0 < r * (w.embedding (d₀ : K)).re
      rw [h_re_d₀]
      have h_expand : r * (1 + (N_mult : ℝ) * r) = r + (N_mult : ℝ) * r ^ 2 := by ring
      rw [h_expand]
      linarith
    by_cases hd₀_ne : d₀ = 0
    · refine ⟨1, one_ne_zero, ?_, ?_, ?_⟩
      · rw [sub_self]
        exact q₁.zero_mem
      · rw [Ideal.span_singleton_one, top_sup_eq]
      · intro w hw
        have h_pos := hd₀_pos w hw
        rw [hd₀_ne, mul_zero] at h_pos
        push_cast at h_pos
        rw [map_zero, Complex.zero_re] at h_pos
        exact False.elim ((lt_irrefl (0 : ℝ)) h_pos)
    · exact ⟨d₀, hd₀_ne, hd₀_sub, hd₀_cop, hd₀_pos⟩
  have h_extend : ∀ (q₁ f' : Ideal (NumberField.RingOfIntegers K)) (hq₁ : q₁ ≠ 0) (hq₁f' : q₁ ≤ f')
      (ψ₁ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ‖ψ₁ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤) → ψ₁ I = 0)) →
      (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧ ψ₁ I₀ ≠ 1) →
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ →
        x - 1 ∈ f' →
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
        ψ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
      ∃ (ψ' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ f' →
          (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
          ψ' ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ → ‖ψ' I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤) → ψ' I = 0)) ∧
        (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ ∧ ψ' I₀ ≠ 1) ∧
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ψ' I = ψ₁ I) := by
    intro q₁ f' hq₁ hq₁f' ψ₁ hψ₁_norm_supp hψ₁_nonprin h_triv
    have h_J_ind : ∀ (m : ℕ) (q₂ : Ideal (NumberField.RingOfIntegers K)),
        q₂ ≠ 0 → Ideal.absNorm q₂ = m →
        ∃ J : Ideal (NumberField.RingOfIntegers K),
          f' ⊔ J = ⊤ ∧
          ∀ A : Ideal (NumberField.RingOfIntegers K), A ⊔ f' = ⊤ → A ⊔ J = ⊤ → A ⊔ q₂ = ⊤ := by
      intro m
      induction' m using Nat.strong_induction_on with m ih
      intro q₂ hq₂ hm
      by_cases hq₂_top : q₂ = ⊤
      · refine ⟨⊤, sup_top_eq f', ?_⟩
        intro A _ _
        rw [hq₂_top, sup_top_eq]
      · obtain ⟨P, hP_max, hq₂P⟩ := Ideal.exists_le_maximal q₂ hq₂_top
        obtain ⟨q', hq₂_mul⟩ := Ideal.dvd_iff_le.mpr hq₂P
        have hP_ne : P ≠ 0 := left_ne_zero_of_mul (hq₂_mul ▸ hq₂)
        have hq'_ne : q' ≠ 0 := right_ne_zero_of_mul (hq₂_mul ▸ hq₂)
        have hP_norm_ne_zero : Ideal.absNorm P ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hP_ne
        have hP_norm_ne_one : Ideal.absNorm P ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr hP_max.ne_top
        have hq'_norm_ne_zero : Ideal.absNorm q' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq'_ne
        have h_norm_lt : Ideal.absNorm q' < m := by
          rw [← hm, hq₂_mul, map_mul]
          exact lt_mul_of_one_lt_left (Nat.pos_of_ne_zero hq'_norm_ne_zero) (by omega)
        obtain ⟨J', hJ'_cop, hJ'_prop⟩ := ih (Ideal.absNorm q') h_norm_lt q' hq'_ne rfl
        by_cases hPf' : f' ⊔ P = ⊤
        · refine ⟨P * J', ?_, ?_⟩
          · rw [← Ideal.isCoprime_iff_sup_eq]
            exact IsCoprime.mul_right (Ideal.isCoprime_iff_sup_eq.mpr hPf')
              (Ideal.isCoprime_iff_sup_eq.mpr hJ'_cop)
          · intro A hAf' hAPJ'
            rw [← Ideal.isCoprime_iff_sup_eq, IsCoprime.mul_right_iff,
              Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_iff_sup_eq] at hAPJ'
            have hAq' : A ⊔ q' = ⊤ := hJ'_prop A hAf' hAPJ'.2
            rw [hq₂_mul, ← Ideal.isCoprime_iff_sup_eq]
            exact IsCoprime.mul_right (Ideal.isCoprime_iff_sup_eq.mpr hAPJ'.1)
              (Ideal.isCoprime_iff_sup_eq.mpr hAq')
        · refine ⟨J', hJ'_cop, ?_⟩
          intro A hAf' hAJ'
          have hP_eq : P = f' ⊔ P := hP_max.eq_of_le hPf' le_sup_right
          have hf'P : f' ≤ P := le_sup_left.trans hP_eq.symm.le
          have hAP : A ⊔ P = ⊤ :=
            eq_top_iff.mpr (le_trans (ge_of_eq hAf') (sup_le_sup_left hf'P A))
          have hAq' : A ⊔ q' = ⊤ := hJ'_prop A hAf' hAJ'
          rw [hq₂_mul, ← Ideal.isCoprime_iff_sup_eq]
          exact IsCoprime.mul_right (Ideal.isCoprime_iff_sup_eq.mpr hAP)
            (Ideal.isCoprime_iff_sup_eq.mpr hAq')
    obtain ⟨J, hJ_cop, hJ_prop⟩ := h_J_ind (Ideal.absNorm q₁) q₁ hq₁ rfl
    have h_s1 : ∀ c₀ : NumberField.RingOfIntegers K,
        Ideal.span ({c₀} : Set (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ →
