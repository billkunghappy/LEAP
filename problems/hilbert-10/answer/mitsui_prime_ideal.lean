    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    exact (Complex.continuous_ofReal.continuousAt.clog
      (Complex.ofReal_mem_slitPlane.mpr hu_pos)).continuousWithinAt
  have hF_meas : ∀ s : ℂ, MeasureTheory.AEStronglyMeasurable (F s) μ := by
    intro s
    exact ((h_cpow_meas s).add (h_cpow_meas (1 - s))).mul hΨ_c_meas
  have hF'_meas : MeasureTheory.AEStronglyMeasurable (F' s₀) μ :=
    (((h_cpow_meas s₀).mul h_clog_meas).sub ((h_cpow_meas (1 - s₀)).mul h_clog_meas)).mul hΨ_c_meas
  set N : ℝ := |s₀.re| + 3
  let bound : ℝ → ℝ := fun u => (2 : ℝ) * (u ^ N * Ψ u)
  have h_bound_int : MeasureTheory.Integrable bound μ := (hΨ_int N).const_mul 2
  have hFs₀_int : MeasureTheory.Integrable (F s₀) μ := by
    refine h_bound_int.mono' (hF_meas s₀) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
    have hu_gt : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := by linarith
    have hu_ge : 1 ≤ u := by linarith
    have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
    have hs₀_re : s₀.re ≤ N := by
      have : s₀.re ≤ |s₀.re| := le_abs_self s₀.re
      dsimp [N]; linarith
    have h1s₀_re : (1 - s₀).re ≤ N := by
      rw [Complex.sub_re, Complex.one_re]
      have : -s₀.re ≤ |s₀.re| := neg_le_abs s₀.re
      dsimp [N]; linarith
    have h_us : ‖(u : ℂ) ^ s₀‖ ≤ u ^ N := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s₀]
      exact Real.rpow_le_rpow_of_exponent_le hu_ge hs₀_re
    have h_u1s : ‖(u : ℂ) ^ (1 - s₀)‖ ≤ u ^ N := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s₀)]
      exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s₀_re
    have h_add : ‖(u : ℂ) ^ s₀ + (u : ℂ) ^ (1 - s₀)‖ ≤ u ^ N + u ^ N := by
      calc ‖(u : ℂ) ^ s₀ + (u : ℂ) ^ (1 - s₀)‖
          ≤ ‖(u : ℂ) ^ s₀‖ + ‖(u : ℂ) ^ (1 - s₀)‖ := norm_add_le _ _
        _ ≤ u ^ N + u ^ N := add_le_add h_us h_u1s
    have h_psi_norm : ‖(Ψ u : ℂ)‖ = Ψ u := Complex.norm_of_nonneg hΨ_u
    dsimp [F, bound]
    calc ‖((u : ℂ) ^ s₀ + (u : ℂ) ^ (1 - s₀)) * (Ψ u : ℂ)‖
        = ‖(u : ℂ) ^ s₀ + (u : ℂ) ^ (1 - s₀)‖ * ‖(Ψ u : ℂ)‖ := norm_mul _ _
      _ = ‖(u : ℂ) ^ s₀ + (u : ℂ) ^ (1 - s₀)‖ * Ψ u := by rw [h_psi_norm]
      _ ≤ (u ^ N + u ^ N) * Ψ u := mul_le_mul_of_nonneg_right h_add hΨ_u
      _ = (2 : ℝ) * (u ^ N * Ψ u) := by ring
  have h_deriv : ∀ᵐ (u : ℝ) ∂μ, ∀ s ∈ Metric.ball s₀ 1, HasDerivAt (fun z => F z u) (F' s u) s := by
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu s _hs
    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    have hu_c_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hu_pos)
    have hd1 : HasDerivAt (fun z : ℂ => (u : ℂ) ^ z) ((u : ℂ) ^ s * Complex.log (u : ℂ) * 1) s :=
      (hasDerivAt_id s).const_cpow (Or.inl hu_c_ne)
    have hd2 : HasDerivAt (fun z : ℂ => (u : ℂ) ^ (1 - z))
        ((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ) * (0 - 1)) s :=
      ((hasDerivAt_const s (1 : ℂ)).sub (hasDerivAt_id s)).const_cpow (Or.inl hu_c_ne)
    have hd3 := (hd1.add hd2).mul_const (Ψ u : ℂ)
    dsimp [F, F']
    convert hd3 using 1
    ring
  have h_bound : ∀ᵐ (u : ℝ) ∂μ, ∀ s ∈ Metric.ball s₀ 1, ‖F' s u‖ ≤ bound u := by
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu s hs
    have hu_gt : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := by linarith
    have hu_ge : 1 ≤ u := by linarith
    have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
    have hs_dist : ‖s - s₀‖ < 1 := by simpa [Metric.mem_ball, dist_eq_norm] using hs
    have hs_re_diff : |(s - s₀).re| ≤ 1 :=
      le_trans (Complex.abs_re_le_norm (s - s₀)) (le_of_lt hs_dist)
    have hs_re_sub : |s.re - s₀.re| ≤ 1 := by simpa [Complex.sub_re] using hs_re_diff
    have hs_re_le : s.re ≤ N - 1 := by
      have h1 : s.re - s₀.re ≤ 1 := (abs_le.mp hs_re_sub).2
      have h2 : s₀.re ≤ |s₀.re| := le_abs_self s₀.re
      dsimp [N]; linarith
    have h1s_re_le : (1 - s).re ≤ N - 1 := by
      rw [Complex.sub_re, Complex.one_re]
      have h1 : -1 ≤ s.re - s₀.re := (abs_le.mp hs_re_sub).1
      have h2 : -s₀.re ≤ |s₀.re| := neg_le_abs s₀.re
      dsimp [N]; linarith
    have h_us : ‖(u : ℂ) ^ s‖ ≤ u ^ (N - 1) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s]
      exact Real.rpow_le_rpow_of_exponent_le hu_ge hs_re_le
    have h_u1s : ‖(u : ℂ) ^ (1 - s)‖ ≤ u ^ (N - 1) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s)]
      exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s_re_le
    have h_log_nn : 0 ≤ Real.log u := Real.log_nonneg hu_ge
    have h_clog_norm : ‖Complex.log (u : ℂ)‖ = Real.log u := by
      rw [← Complex.ofReal_log (le_of_lt hu_pos), Complex.norm_of_nonneg h_log_nn]
    have h_log_le : Real.log u ≤ u ^ (1 : ℝ) := by
      have h1 : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
      rw [Real.rpow_one]
      linarith
    have h_rpow_combine : u ^ (N - 1) * u ^ (1 : ℝ) = u ^ N := by
      rw [← Real.rpow_add hu_pos]
      congr 1; ring
    have h_term1 : ‖(u : ℂ) ^ s * Complex.log (u : ℂ)‖ ≤ u ^ N := by
      rw [norm_mul, h_clog_norm, ← h_rpow_combine]
      exact mul_le_mul h_us h_log_le h_log_nn (Real.rpow_nonneg (le_of_lt hu_pos) _)
    have h_term2 : ‖(u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ ≤ u ^ N := by
      rw [norm_mul, h_clog_norm, ← h_rpow_combine]
      exact mul_le_mul h_u1s h_log_le h_log_nn (Real.rpow_nonneg (le_of_lt hu_pos) _)
    have h_sub : ‖(u : ℂ) ^ s * Complex.log (u : ℂ) - (u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ ≤
        u ^ N + u ^ N := by
      calc ‖(u : ℂ) ^ s * Complex.log (u : ℂ) - (u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖
          ≤ ‖(u : ℂ) ^ s * Complex.log (u : ℂ)‖ + ‖(u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ :=
            norm_sub_le _ _
        _ ≤ u ^ N + u ^ N := add_le_add h_term1 h_term2
    have h_psi_norm : ‖(Ψ u : ℂ)‖ = Ψ u := Complex.norm_of_nonneg hΨ_u
    dsimp [F', bound]
    calc ‖((u : ℂ) ^ s * Complex.log (u : ℂ) - (u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)) * (Ψ u : ℂ)‖
        = ‖(u : ℂ) ^ s * Complex.log (u : ℂ) - (u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ * ‖(Ψ u : ℂ)‖ :=
          norm_mul _ _
      _ = ‖(u : ℂ) ^ s * Complex.log (u : ℂ) - (u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ * Ψ u := by
          rw [h_psi_norm]
      _ ≤ (u ^ N + u ^ N) * Ψ u := mul_le_mul_of_nonneg_right h_sub hΨ_u
      _ = (2 : ℝ) * (u ^ N * Ψ u) := by ring
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (Metric.ball_mem_nhds s₀ zero_lt_one)
    (Filter.Eventually.of_forall hF_meas)
    hFs₀_int hF'_meas h_bound h_bound_int h_deriv).2.differentiableAt

theorem mitsui_archimedean_completed_gamma_entire_inv (D : ℝ) (r₁ r₂ : ℕ) (hD_pos : 0 < D) (hr_pos : 0 < r₁ + 2 * r₂) :
    ∃ H : ℂ → ℂ, Differentiable ℂ H ∧
      ∀ s : ℂ, -1 / 2 ≤ s.re → s ≠ 0 →
        s * ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * H s = 1 :=
by
  have hD_ne : (D : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hD_pos)
  have hpi_ne : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have h2pi_ne : (2 : ℂ) * (Real.pi : ℂ) ≠ 0 := mul_ne_zero two_ne_zero hpi_ne
  let d_inv : ℂ → ℂ := fun s => (D : ℂ) ^ (-s / 2)
  let gR_inv : ℂ → ℂ := fun s => (Complex.Gammaℝ s)⁻¹
  let gC_inv : ℂ → ℂ := fun s => (1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ s * (Complex.Gamma s)⁻¹
  let gR_div_s : ℂ → ℂ := fun s => (1 / 2 : ℂ) * (Real.pi : ℂ) ^ (s / 2) * (Complex.Gamma (s / 2 + 1))⁻¹
  let gC_div_s : ℂ → ℂ := fun s => (1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ s * (Complex.Gamma (s + 1))⁻¹
  have hd_inv_diff : Differentiable ℂ d_inv :=
    ((differentiable_id.neg).div_const (2 : ℂ)).const_cpow (Or.inl hD_ne)
  have hgR_inv_diff : Differentiable ℂ gR_inv :=
    Complex.differentiable_Gammaℝ_inv
  have hgC_inv_diff : Differentiable ℂ gC_inv :=
    ((differentiable_const (1 / 2 : ℂ)).mul (differentiable_id.const_cpow (Or.inl h2pi_ne))).mul
      Complex.differentiable_one_div_Gamma
  have hgR_div_s_diff : Differentiable ℂ gR_div_s :=
    ((differentiable_const (1 / 2 : ℂ)).mul ((differentiable_id.div_const (2 : ℂ)).const_cpow (Or.inl hpi_ne))).mul
      (Complex.differentiable_one_div_Gamma.comp ((differentiable_id.div_const (2 : ℂ)).add (differentiable_const (1 : ℂ))))
  have hgC_div_s_diff : Differentiable ℂ gC_div_s :=
    ((differentiable_const (1 / 2 : ℂ)).mul (differentiable_id.const_cpow (Or.inl h2pi_ne))).mul
      (Complex.differentiable_one_div_Gamma.comp (differentiable_id.add (differentiable_const (1 : ℂ))))
  have h_factors : ∀ s : ℂ, -1 / 2 ≤ s.re → s ≠ 0 →
      (D : ℂ) ^ (s / 2) * d_inv s = 1 ∧
      Complex.Gammaℝ s * gR_inv s = 1 ∧
      Complex.Gammaℝ s * (s * gR_div_s s) = 1 ∧
      Complex.Gammaℂ s * gC_inv s = 1 ∧
      Complex.Gammaℂ s * (s * gC_div_s s) = 1 := by
    intro s hs_re hs_ne
    have hDs_ne : (D : ℂ) ^ (s / 2) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl hD_ne)
    have hd_eq : d_inv s = ((D : ℂ) ^ (s / 2))⁻¹ := by
      dsimp [d_inv]
      rw [neg_div, Complex.cpow_neg]
    have h1 : (D : ℂ) ^ (s / 2) * d_inv s = 1 := by
      rw [hd_eq]
      exact mul_inv_cancel₀ hDs_ne
    have hs2_ne : s / 2 ≠ 0 := div_ne_zero hs_ne two_ne_zero
    have hs2_re : 0 < (s / 2 + 1).re := by
      simp only [Complex.add_re, Complex.div_ofNat_re, Complex.one_re]
      linarith
    have hG_s2_1_ne : Complex.Gamma (s / 2 + 1) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos hs2_re
    rw [Complex.Gamma_add_one (s / 2) hs2_ne] at hG_s2_1_ne
    have hG_s2_ne : Complex.Gamma (s / 2) ≠ 0 := right_ne_zero_of_mul hG_s2_1_ne
    have hpi_pow_ne : (Real.pi : ℂ) ^ (-s / 2) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl hpi_ne)
    have hGR_ne : Complex.Gammaℝ s ≠ 0 := by
      rw [Complex.Gammaℝ_def]
      exact mul_ne_zero hpi_pow_ne hG_s2_ne
    have h2 : Complex.Gammaℝ s * gR_inv s = 1 := mul_inv_cancel₀ hGR_ne
    have hgR_div_eq : s * gR_div_s s = gR_inv s := by
      dsimp [gR_div_s, gR_inv]
      rw [Complex.Gammaℝ_def, neg_div, Complex.cpow_neg, mul_inv, inv_inv,
          Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one (s / 2)]
      ring
    have h3 : Complex.Gammaℝ s * (s * gR_div_s s) = 1 := by
      rw [hgR_div_eq]
      exact h2
    have hs1_re : 0 < (s + 1).re := by
      simp only [Complex.add_re, Complex.one_re]
      linarith
    have hG_s1_ne : Complex.Gamma (s + 1) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos hs1_re
    rw [Complex.Gamma_add_one s hs_ne] at hG_s1_ne
    have hG_s_ne : Complex.Gamma s ≠ 0 := right_ne_zero_of_mul hG_s1_ne
    have h2pi_pow_ne : (2 * (Real.pi : ℂ)) ^ (-s) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl h2pi_ne)
    have hGC_ne : Complex.Gammaℂ s ≠ 0 := by
      rw [Complex.Gammaℂ_def]
      exact mul_ne_zero (mul_ne_zero two_ne_zero h2pi_pow_ne) hG_s_ne
    have hgC_inv_eq : gC_inv s = (Complex.Gammaℂ s)⁻¹ := by
      dsimp [gC_inv]
      rw [Complex.Gammaℂ_def, Complex.cpow_neg, mul_inv, mul_inv, inv_inv]
      ring
    have h4 : Complex.Gammaℂ s * gC_inv s = 1 := by
      rw [hgC_inv_eq]
      exact mul_inv_cancel₀ hGC_ne
    have hgC_div_eq : s * gC_div_s s = gC_inv s := by
      dsimp [gC_div_s, gC_inv]
      rw [Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one s]
      ring
    have h5 : Complex.Gammaℂ s * (s * gC_div_s s) = 1 := by
      rw [hgC_div_eq]
      exact h4
    exact ⟨h1, h2, h3, h4, h5⟩
  rcases Nat.eq_zero_or_pos r₁ with hr₁_zero | hr₁_pos
  · have hr₂_pos : 0 < r₂ := by omega
    let H : ℂ → ℂ := fun s => d_inv s * (gC_div_s s * (gC_inv s) ^ (r₂ - 1))
    have hH_diff : Differentiable ℂ H :=
      hd_inv_diff.mul (hgC_div_s_diff.mul (hgC_inv_diff.pow (r₂ - 1)))
    refine ⟨H, hH_diff, ?_⟩
    intro s hs_re hs_ne
    obtain ⟨h1, _, _, h4, h5⟩ := h_factors s hs_re hs_ne
    have hr₂_eq : (r₂ - 1) + 1 = r₂ := Nat.sub_add_cancel hr₂_pos
    have hGC_pow : (Complex.Gammaℂ s) ^ r₂ = (Complex.Gammaℂ s) ^ (r₂ - 1) * Complex.Gammaℂ s := by
      rw [← pow_succ, hr₂_eq]
    have hGC_pair : (Complex.Gammaℂ s) ^ (r₂ - 1) * (gC_inv s) ^ (r₂ - 1) = 1 := by
      rw [← mul_pow, h4, one_pow]
    dsimp [H]
    rw [hr₁_zero, pow_zero, hGC_pow]
    calc s * ((D : ℂ) ^ (s / 2) * 1 * ((Complex.Gammaℂ s) ^ (r₂ - 1) * Complex.Gammaℂ s)) *
          (d_inv s * (gC_div_s s * (gC_inv s) ^ (r₂ - 1)))
        = ((D : ℂ) ^ (s / 2) * d_inv s) *
          (Complex.Gammaℂ s * (s * gC_div_s s)) *
          ((Complex.Gammaℂ s) ^ (r₂ - 1) * (gC_inv s) ^ (r₂ - 1)) := by ring
      _ = 1 * 1 * 1 := by rw [h1, h5, hGC_pair]
      _ = 1 := by ring
  · let H : ℂ → ℂ := fun s => d_inv s * (gR_div_s s * (gR_inv s) ^ (r₁ - 1)) * (gC_inv s) ^ r₂
    have hH_diff : Differentiable ℂ H :=
      (hd_inv_diff.mul (hgR_div_s_diff.mul (hgR_inv_diff.pow (r₁ - 1)))).mul (hgC_inv_diff.pow r₂)
    refine ⟨H, hH_diff, ?_⟩
    intro s hs_re hs_ne
    obtain ⟨h1, h2, h3, h4, _⟩ := h_factors s hs_re hs_ne
    have hr₁_eq : (r₁ - 1) + 1 = r₁ := Nat.sub_add_cancel hr₁_pos
    have hGR_pow : (Complex.Gammaℝ s) ^ r₁ = (Complex.Gammaℝ s) ^ (r₁ - 1) * Complex.Gammaℝ s := by
      rw [← pow_succ, hr₁_eq]
    have hGR_pair : (Complex.Gammaℝ s) ^ (r₁ - 1) * (gR_inv s) ^ (r₁ - 1) = 1 := by
      rw [← mul_pow, h2, one_pow]
    have hGC_pair : (Complex.Gammaℂ s) ^ r₂ * (gC_inv s) ^ r₂ = 1 := by
      rw [← mul_pow, h4, one_pow]
    dsimp [H]
    rw [hGR_pow]
    calc s * ((D : ℂ) ^ (s / 2) * ((Complex.Gammaℝ s) ^ (r₁ - 1) * Complex.Gammaℝ s) * (Complex.Gammaℂ s) ^ r₂) *
          (d_inv s * (gR_div_s s * (gR_inv s) ^ (r₁ - 1)) * (gC_inv s) ^ r₂)
        = ((D : ℂ) ^ (s / 2) * d_inv s) *
          (Complex.Gammaℝ s * (s * gR_div_s s)) *
          ((Complex.Gammaℝ s) ^ (r₁ - 1) * (gR_inv s) ^ (r₁ - 1)) *
          ((Complex.Gammaℂ s) ^ r₂ * (gC_inv s) ^ r₂) := by ring
      _ = 1 * 1 * 1 * 1 := by rw [h1, h3, hGR_pair, hGC_pair]
      _ = 1 := by ring

theorem mitsui_regularized_dedekindZeta_hecke_theta_integral_rep {K : Type u} [Field K] [NumberField K] :
    ∃ (R_K : ℝ) (Ψ_K : ℝ → ℝ) (g_K : ℂ → ℂ), 0 < R_K ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_K u) ∧
      MeasureTheory.IntegrableOn (fun u : ℝ => u ^ (2 : ℝ) * Ψ_K u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume ∧
      Differentiable ℂ g_K ∧
      (∀ s : ℂ, 1 < s.re → g_K s = (s - 1) * NumberField.dedekindZeta K s) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → s ≠ 0 →
        s *
          (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          g_K s =
        (R_K : ℂ) +
          s * (s - 1) *
            ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ)) :=
by
  obtain ⟨R_K, Ψ_K, hR_pos, hΨ_nn, hΨ_int, h_rhp⟩ :=
    mitsui_dedekindZeta_hecke_theta_rhp_identity (K := K)
  set D : ℝ := |(NumberField.discr K : ℝ)|
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hr_pos : 0 < r₁ + 2 * r₂ := by
    dsimp [r₁, r₂]
    rw [NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K]
    exact Module.finrank_pos
  obtain ⟨H, hH_diff, hH_inv⟩ :=
    mitsui_archimedean_completed_gamma_entire_inv D r₁ r₂ hD_pos hr_pos
  let J_K : ℂ → ℂ := fun s =>
    ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ)
  let Λ_K : ℂ → ℂ := fun s => (R_K : ℂ) + s * (s - 1) * J_K s
  let g_K : ℂ → ℂ := fun s => H s * Λ_K s
  have hJ_diff : Differentiable ℂ J_K :=
    mitsui_hecke_theta_integral_differentiable Ψ_K hΨ_nn hΨ_int
  have hΛ_diff : Differentiable ℂ Λ_K :=
    (differentiable_const (R_K : ℂ)).add
      ((differentiable_id.mul (differentiable_id.sub (differentiable_const (1 : ℂ)))).mul hJ_diff)
  have hg_diff : Differentiable ℂ g_K := hH_diff.mul hΛ_diff
  refine ⟨R_K, Ψ_K, g_K, hR_pos, hΨ_nn, hΨ_int (2 : ℝ), hg_diff, ?_, ?_⟩
  · intro s hs
    have hs_re : -1 / 2 ≤ s.re := by linarith
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hs
      norm_num at hs
    set γ_s : ℂ := (D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    have h_inv : s * γ_s * H s = 1 := hH_inv s hs_re hs_ne
    have h_eq : s * γ_s * ((s - 1) * NumberField.dedekindZeta K s) = Λ_K s := h_rhp s hs
    calc g_K s = H s * Λ_K s := rfl
      _ = H s * (s * γ_s * ((s - 1) * NumberField.dedekindZeta K s)) := by rw [← h_eq]
      _ = (s * γ_s * H s) * ((s - 1) * NumberField.dedekindZeta K s) := by ring
      _ = 1 * ((s - 1) * NumberField.dedekindZeta K s) := by rw [h_inv]
      _ = (s - 1) * NumberField.dedekindZeta K s := one_mul _
  · intro s hs1 _ hs_ne
    set γ_s : ℂ := (D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    have h_inv : s * γ_s * H s = 1 := hH_inv s hs1 hs_ne
    calc s * γ_s * g_K s = s * γ_s * (H s * Λ_K s) := rfl
      _ = (s * γ_s * H s) * Λ_K s := by ring
      _ = 1 * Λ_K s := by rw [h_inv]
      _ = Λ_K s := one_mul _

theorem mitsui_hecke_theta_integral_symm_and_strip_norm_le (R_K : ℝ) (Ψ : ℝ → ℝ)
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΨ_int : MeasureTheory.IntegrableOn (fun u : ℝ => u ^ (2 : ℝ) * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume) :
    (∀ s : ℂ,
      (R_K : ℂ) +
        s * (s - 1) *
          (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)) =
      (R_K : ℂ) +
        (1 - s) * ((1 - s) - 1) *
          (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ (1 - s) + (u : ℂ) ^ (1 - (1 - s))) * (Ψ u : ℂ))) ∧
    (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
      ‖∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)‖ ≤
        2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ u) :=
by
  refine ⟨?_, ?_⟩
  · intro s
    have h_int_eq :
        (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)) =
        (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ (1 - s) + (u : ℂ) ^ (1 - (1 - s))) * (Ψ u : ℂ)) := by
      congr 1
      ext u
      rw [sub_sub_cancel 1 s, add_comm ((u : ℂ) ^ s) ((u : ℂ) ^ (1 - s))]
    rw [h_int_eq]
    ring
  · intro s hs1 hs2
    have h1s_re : (1 - s).re ≤ 2 := by
      rw [Complex.sub_re, Complex.one_re]
      linarith
    have h_int_dom :
        MeasureTheory.Integrable (fun u : ℝ => (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u))
          (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
      hΨ_int.const_mul 2
    have h_ae : ∀ᵐ (u : ℝ) ∂MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ)),
        ‖((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)‖ ≤ (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) := by
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
      have hu_gt : 1 < u := Set.mem_Ioi.mp hu
      have hu_pos : 0 < u := by linarith
      have hu_ge : 1 ≤ u := by linarith
      have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
      have h_us : ‖(u : ℂ) ^ s‖ ≤ u ^ (2 : ℝ) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge hs2
      have h_u1s : ‖(u : ℂ) ^ (1 - s)‖ ≤ u ^ (2 : ℝ) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s)]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s_re
      have h_add : ‖(u : ℂ) ^ s + (u : ℂ) ^ (1 - s)‖ ≤ u ^ (2 : ℝ) + u ^ (2 : ℝ) := by
        calc ‖(u : ℂ) ^ s + (u : ℂ) ^ (1 - s)‖
            ≤ ‖(u : ℂ) ^ s‖ + ‖(u : ℂ) ^ (1 - s)‖ := norm_add_le _ _
          _ ≤ u ^ (2 : ℝ) + u ^ (2 : ℝ) := add_le_add h_us h_u1s
      have h_psi_norm : ‖(Ψ u : ℂ)‖ = Ψ u := Complex.norm_of_nonneg hΨ_u
      calc ‖((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)‖
          = ‖(u : ℂ) ^ s + (u : ℂ) ^ (1 - s)‖ * ‖(Ψ u : ℂ)‖ := norm_mul _ _
        _ = ‖(u : ℂ) ^ s + (u : ℂ) ^ (1 - s)‖ * Ψ u := by rw [h_psi_norm]
        _ ≤ (u ^ (2 : ℝ) + u ^ (2 : ℝ)) * Ψ u := mul_le_mul_of_nonneg_right h_add hΨ_u
        _ = (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) := by ring
    calc ‖∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ u : ℂ)‖
        ≤ ∫ u in Set.Ioi (1 : ℝ), (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) :=
          MeasureTheory.norm_integral_le_of_norm_le h_int_dom h_ae
      _ = 2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ u :=
          MeasureTheory.integral_const_mul (2 : ℝ) (fun u : ℝ => u ^ (2 : ℝ) * Ψ u)

theorem mitsui_completed_mellin_high_im_linear_bound (R_K I₀ : ℝ) (s W J : ℂ)
    (hR_pos : 0 < R_K) (hI₀_nn : 0 ≤ I₀)
    (hs1 : -1 / 2 ≤ s.re) (hs2 : s.re ≤ 2) (hs_im : 1 ≤ |s.im|)
    (hJ : ‖J‖ ≤ I₀)
    (h_eq : s * W = (R_K : ℂ) + s * (s - 1) * J) :
    ‖W‖ ≤ (R_K + I₀) * (4 + |s.im|) :=
by
  have hs_norm_ge_one : 1 ≤ ‖s‖ :=
    le_trans hs_im (Complex.abs_im_le_norm s)
  have hs_norm_pos : 0 < ‖s‖ := lt_of_lt_of_le zero_lt_one hs_norm_ge_one
  have h_norm_eq := congrArg norm h_eq
  rw [norm_mul] at h_norm_eq
  have h_rhs_le : ‖(R_K : ℂ) + s * (s - 1) * J‖ ≤ R_K + ‖s‖ * ‖s - 1‖ * ‖J‖ := by
    calc ‖(R_K : ℂ) + s * (s - 1) * J‖
        ≤ ‖(R_K : ℂ)‖ + ‖s * (s - 1) * J‖ := norm_add_le _ _
      _ = R_K + ‖s‖ * ‖s - 1‖ * ‖J‖ := by
          rw [Complex.norm_of_nonneg (le_of_lt hR_pos), norm_mul, norm_mul]
  have hsW_le : ‖s‖ * ‖W‖ ≤ R_K + ‖s‖ * ‖s - 1‖ * ‖J‖ := by
    linarith [h_norm_eq, h_rhs_le]
  set L : ℝ := 4 + |s.im|
  have hL_ge_one : 1 ≤ L := by dsimp [L]; linarith
  have hL_nonneg : 0 ≤ L := le_trans zero_le_one hL_ge_one
  have hR_le : R_K ≤ ‖s‖ * (R_K * L) := by
    have h1 : R_K ≤ R_K * L := le_mul_of_one_le_right (le_of_lt hR_pos) hL_ge_one
    have h2 : R_K * L ≤ ‖s‖ * (R_K * L) :=
      le_mul_of_one_le_left (by positivity) hs_norm_ge_one
    exact le_trans h1 h2
  have hs1_le_L : ‖s - 1‖ ≤ L := by
    have h1 := Complex.norm_le_abs_re_add_abs_im (s - 1)
    have h_re : (s - 1).re = s.re - 1 := by rw [Complex.sub_re, Complex.one_re]
    have h_im : (s - 1).im = s.im := by rw [Complex.sub_im, Complex.one_im, sub_zero]
    rw [h_re, h_im] at h1
    have h_abs_re : |s.re - 1| ≤ 4 := abs_le.mpr ⟨by linarith, by linarith⟩
    dsimp [L]
    linarith
  have h_prod_J : ‖s‖ * ‖s - 1‖ * ‖J‖ ≤ ‖s‖ * (I₀ * L) := by
    have h1 : ‖s - 1‖ * ‖J‖ ≤ L * I₀ :=
      mul_le_mul hs1_le_L hJ (norm_nonneg _) hL_nonneg
    calc ‖s‖ * ‖s - 1‖ * ‖J‖
        = ‖s‖ * (‖s - 1‖ * ‖J‖) := by ring
      _ ≤ ‖s‖ * (L * I₀) := mul_le_mul_of_nonneg_left h1 (le_of_lt hs_norm_pos)
      _ = ‖s‖ * (I₀ * L) := by ring
  have h_total : ‖s‖ * ‖W‖ ≤ ‖s‖ * ((R_K + I₀) * L) := by
    calc ‖s‖ * ‖W‖
        ≤ R_K + ‖s‖ * ‖s - 1‖ * ‖J‖ := hsW_le
      _ ≤ ‖s‖ * (R_K * L) + ‖s‖ * (I₀ * L) := add_le_add hR_le h_prod_J
      _ = ‖s‖ * ((R_K + I₀) * L) := by ring
  exact le_of_mul_le_mul_left h_total hs_norm_pos

theorem mitsui_regularized_dedekindZeta_completed_entire_and_mellin_bound {K : Type u} [Field K] [NumberField K] :
    ∃ (C₀ : ℝ) (g_K : ℂ → ℂ), 0 < C₀ ∧
      Differentiable ℂ g_K ∧
      (∀ s : ℂ, 1 < s.re → g_K s = (s - 1) * NumberField.dedekindZeta K s) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        s *
          (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          g_K s =
        (1 - s) *
          (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
            (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          g_K (1 - s)) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          g_K s‖ ≤ C₀ * (4 + |s.im|)) :=
by
  obtain ⟨R_K, Ψ_K, g_K, hR_pos, hΨ_nn, hΨ_int, hg_diff, hg_eq, hg_rep⟩ :=
    mitsui_regularized_dedekindZeta_hecke_theta_integral_rep (K := K)
  obtain ⟨h_symm_int, h_bound_int⟩ :=
    mitsui_hecke_theta_integral_symm_and_strip_norm_le R_K Ψ_K hΨ_nn hΨ_int
  set I₀ : ℝ := 2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_K u
  have h_int_nn : 0 ≤ ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_K u := by
    apply MeasureTheory.setIntegral_nonneg measurableSet_Ioi
    intro u hu
    have hu_nn : 0 ≤ u := by linarith [Set.mem_Ioi.mp hu]
    exact mul_nonneg (Real.rpow_nonneg hu_nn 2) (hΨ_nn u hu)
  have hI₀_nn : 0 ≤ I₀ := by dsimp [I₀]; positivity
  let C₀ : ℝ := R_K + I₀
  have hC₀_pos : 0 < C₀ := by dsimp [C₀]; linarith
  refine ⟨C₀, g_K, hC₀_pos, hg_diff, hg_eq, ?_, ?_⟩
  · intro s hs
    have hs1 : -1 / 2 ≤ s.re := by linarith
    have hs2 : s.re ≤ 2 := by linarith
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hs
      norm_num at hs
    have h1s_re1 : -1 / 2 ≤ (1 - s).re := by
      rw [Complex.sub_re, Complex.one_re, hs]
      norm_num
    have h1s_re2 : (1 - s).re ≤ 2 := by
      rw [Complex.sub_re, Complex.one_re, hs]
      norm_num
    have h1s_ne : 1 - s ≠ 0 := by
      intro h0
      have h_re : (1 - s).re = 0 := by rw [h0, Complex.zero_re]
      rw [Complex.sub_re, Complex.one_re, hs] at h_re
      norm_num at h_re
    rw [hg_rep s hs1 hs2 hs_ne, hg_rep (1 - s) h1s_re1 h1s_re2 h1s_ne]
    exact h_symm_int s
  · intro s hs1 hs2 hs_im
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_im, abs_zero] at hs_im
      norm_num at hs_im
    set W : ℂ :=
      (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
        (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
        (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
      g_K s
    set J : ℂ := ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ)
    have h_eq : s * W = (R_K : ℂ) + s * (s - 1) * J := by
      dsimp [W, J]
      rw [← mul_assoc]
      exact hg_rep s hs1 hs2 hs_ne
    exact mitsui_completed_mellin_high_im_linear_bound
      R_K I₀ s W J hR_pos hI₀_nn hs1 hs2 hs_im (h_bound_int s hs1 hs2) h_eq

theorem mitsui_archimedean_gamma_exp_lower_bound_on_strip (r₁ r₂ : ℕ) (s : ℂ) (hs_re1 : -1 / 2 ≤ s.re) (hs_re2 : s.re ≤ 2) (hs_im : 1 ≤ |s.im|) :
    Real.exp (-(8 * ((r₁ : ℝ) + (r₂ : ℝ))) * (4 + |s.im|)) ≤
      ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ :=
by
  have h_gamma_upper : ∀ u : ℂ, 1 ≤ u.re → u.re ≤ 4 → ‖Complex.Gamma u‖ ≤ 7 := by
    intro u hu1 hu4
    have hu_pos : 0 < u.re := lt_of_lt_of_le zero_lt_one hu1
    rw [Complex.Gamma_eq_integral hu_pos, Complex.GammaIntegral]
    have h_norm_int :
        ‖∫ x : ℝ in Set.Ioi 0, (Real.exp (-x) : ℂ) * (x : ℂ) ^ (u - 1)‖ ≤
          ∫ x : ℝ in Set.Ioi 0, ‖(Real.exp (-x) : ℂ) * (x : ℂ) ^ (u - 1)‖ :=
      MeasureTheory.norm_integral_le_integral_norm _
    have h_eq_on : Set.EqOn
        (fun x : ℝ => ‖(Real.exp (-x) : ℂ) * (x : ℂ) ^ (u - 1)‖)
        (fun x : ℝ => Real.exp (-x) * x ^ (u.re - 1))
        (Set.Ioi 0) := by
      intro x hx
      dsimp only
      have hx_pos : 0 < x := Set.mem_Ioi.mp hx
      rw [norm_mul, Complex.norm_of_nonneg (le_of_lt (Real.exp_pos (-x))),
        Complex.norm_cpow_eq_rpow_re_of_pos hx_pos, Complex.sub_re, Complex.one_re]
    have h_int_congr :
        (∫ x : ℝ in Set.Ioi 0, ‖(Real.exp (-x) : ℂ) * (x : ℂ) ^ (u - 1)‖) =
          ∫ x : ℝ in Set.Ioi 0, Real.exp (-x) * x ^ (u.re - 1) :=
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_eq_on
    have h_int_u : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (-x) * x ^ (u.re - 1)) (Set.Ioi 0) MeasureTheory.volume :=
      Real.GammaIntegral_convergent hu_pos
    have h_int_1 : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (-x) * x ^ ((1 : ℝ) - 1)) (Set.Ioi 0) MeasureTheory.volume :=
      Real.GammaIntegral_convergent zero_lt_one
    have h_int_4 : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (-x) * x ^ ((4 : ℝ) - 1)) (Set.Ioi 0) MeasureTheory.volume :=
      Real.GammaIntegral_convergent (by norm_num : (0 : ℝ) < 4)
    have h_int_sum : MeasureTheory.IntegrableOn
        (fun x : ℝ => Real.exp (-x) * x ^ ((1 : ℝ) - 1) + Real.exp (-x) * x ^ ((4 : ℝ) - 1))
        (Set.Ioi 0) MeasureTheory.volume :=
      h_int_1.add h_int_4
    have h_ptwise : ∀ x ∈ Set.Ioi (0 : ℝ),
        Real.exp (-x) * x ^ (u.re - 1) ≤
          Real.exp (-x) * x ^ ((1 : ℝ) - 1) + Real.exp (-x) * x ^ ((4 : ℝ) - 1) := by
      intro x hx
      have hx_pos : 0 < x := Set.mem_Ioi.mp hx
      have hexp_pos : 0 ≤ Real.exp (-x) := le_of_lt (Real.exp_pos (-x))
      rcases le_or_gt x 1 with hx_le | hx_gt
      · have hrpow_le : x ^ (u.re - 1) ≤ x ^ ((1 : ℝ) - 1) :=
          Real.rpow_le_rpow_of_exponent_ge hx_pos hx_le (by linarith)
        have h1 : Real.exp (-x) * x ^ (u.re - 1) ≤ Real.exp (-x) * x ^ ((1 : ℝ) - 1) :=
          mul_le_mul_of_nonneg_left hrpow_le hexp_pos
        have h2 : 0 ≤ Real.exp (-x) * x ^ ((4 : ℝ) - 1) := by positivity
        linarith
      · have hrpow_le : x ^ (u.re - 1) ≤ x ^ ((4 : ℝ) - 1) :=
          Real.rpow_le_rpow_of_exponent_le (le_of_lt hx_gt) (by linarith)
        have h1 : Real.exp (-x) * x ^ (u.re - 1) ≤ Real.exp (-x) * x ^ ((4 : ℝ) - 1) :=
          mul_le_mul_of_nonneg_left hrpow_le hexp_pos
        have h2 : 0 ≤ Real.exp (-x) * x ^ ((1 : ℝ) - 1) := by positivity
        linarith
    have h_mono :
        (∫ x : ℝ in Set.Ioi 0, Real.exp (-x) * x ^ (u.re - 1)) ≤
          ∫ x : ℝ in Set.Ioi 0,
            (Real.exp (-x) * x ^ ((1 : ℝ) - 1) + Real.exp (-x) * x ^ ((4 : ℝ) - 1)) :=
      MeasureTheory.setIntegral_mono_on h_int_u h_int_sum measurableSet_Ioi h_ptwise
    have h_split :
        (∫ x : ℝ in Set.Ioi 0,
          (Real.exp (-x) * x ^ ((1 : ℝ) - 1) + Real.exp (-x) * x ^ ((4 : ℝ) - 1))) =
          Real.Gamma 1 + Real.Gamma 4 := by
      rw [MeasureTheory.integral_add h_int_1 h_int_4,
        ← Real.Gamma_eq_integral zero_lt_one,
        ← Real.Gamma_eq_integral (by norm_num : (0 : ℝ) < 4)]
    have h_gamma_4 : Real.Gamma 4 = 6 := by
      have h4 : (4 : ℝ) = ((3 : ℕ) : ℝ) + 1 := by norm_num
      rw [h4, Real.Gamma_nat_eq_factorial 3]
      norm_num [Nat.factorial]
    linarith [h_norm_int, h_int_congr, h_mono, h_split, Real.Gamma_one, h_gamma_4]
  have h_sin_upper : ∀ w : ℂ, ‖Complex.sin w‖ ≤ Real.exp |w.im| := by
    intro w
    rw [Complex.sin, norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_ofNat]
    have h1 : ‖Complex.exp (-w * Complex.I) - Complex.exp (w * Complex.I)‖ ≤
        ‖Complex.exp (-w * Complex.I)‖ + ‖Complex.exp (w * Complex.I)‖ :=
      norm_sub_le _ _
    rw [Complex.norm_exp, Complex.norm_exp] at h1
    have hre1 : (-w * Complex.I).re = w.im := by simp
    have hre2 : (w * Complex.I).re = -w.im := by simp
    rw [hre1, hre2] at h1
    have hexp1 : Real.exp w.im ≤ Real.exp |w.im| := Real.exp_le_exp.mpr (le_abs_self w.im)
    have hexp2 : Real.exp (-w.im) ≤ Real.exp |w.im| := Real.exp_le_exp.mpr (neg_le_abs w.im)
    linarith
  have h_sin_ne : ∀ w : ℂ, w.im ≠ 0 → Complex.sin w ≠ 0 := by
    intro w hw h0
    rw [Complex.sin, div_eq_zero_iff, mul_eq_zero, sub_eq_zero] at h0
    rcases h0 with (h_exp | hI) | h2
    · have h_norm := congrArg norm h_exp
      rw [Complex.norm_exp, Complex.norm_exp] at h_norm
      have hre1 : (-w * Complex.I).re = w.im := by simp
      have hre2 : (w * Complex.I).re = -w.im := by simp
      rw [hre1, hre2, Real.exp_eq_exp] at h_norm
      exact hw (by linarith)
    · exact Complex.I_ne_zero hI
    · norm_num at h2
  have h_gamma_lower : ∀ z : ℂ, -1 / 2 ≤ z.re → z.re ≤ 2 → 1 / 2 ≤ |z.im| →
      Real.exp (-4 * (4 + |z.im|)) ≤ ‖Complex.Gamma z‖ := by
    intro z hz1 hz2 hz_im
    have h1z_im : |(1 - z).im| = |z.im| := by
      rw [Complex.sub_im, Complex.one_im, zero_sub, abs_neg]
    have h2z_im : |(2 - z).im| = |z.im| := by
      rw [Complex.sub_im, Complex.im_ofNat, zero_sub, abs_neg]
    have h1z_norm : 1 / 2 ≤ ‖1 - z‖ := by
      have h := Complex.abs_im_le_norm (1 - z)
      linarith [h1z_im]
    have h2z_norm : 1 / 2 ≤ ‖2 - z‖ := by
      have h := Complex.abs_im_le_norm (2 - z)
      linarith [h2z_im]
    have h1z_ne : 1 - z ≠ 0 := norm_pos_iff.mp (by linarith)
    have h2z_ne : 2 - z ≠ 0 := norm_pos_iff.mp (by linarith)
    have h_shift1 : Complex.Gamma (2 - z) = (1 - z) * Complex.Gamma (1 - z) := by
      have h_eq : (2 - z : ℂ) = (1 - z) + 1 := by ring
      rw [h_eq, Complex.Gamma_add_one (1 - z) h1z_ne]
    have h_shift2 : Complex.Gamma (3 - z) = (2 - z) * ((1 - z) * Complex.Gamma (1 - z)) := by
      have h_eq : (3 - z : ℂ) = (2 - z) + 1 := by ring
      rw [h_eq, Complex.Gamma_add_one (2 - z) h2z_ne, h_shift1]
    have h_refl : Complex.Gamma z * Complex.Gamma (3 - z) =
        (2 - z) * (1 - z) * ((Real.pi : ℂ) / Complex.sin ((Real.pi : ℂ) * z)) := by
      calc Complex.Gamma z * Complex.Gamma (3 - z)
          = (2 - z) * (1 - z) * (Complex.Gamma z * Complex.Gamma (1 - z)) := by
            rw [h_shift2]; ring
        _ = (2 - z) * (1 - z) * ((Real.pi : ℂ) / Complex.sin ((Real.pi : ℂ) * z)) := by
            rw [Complex.Gamma_mul_Gamma_one_sub z]
    have h_refl_norm := congrArg norm h_refl
    simp only [norm_mul, norm_div, Complex.norm_of_nonneg (le_of_lt Real.pi_pos)] at h_refl_norm
    have h3z_re1 : 1 ≤ (3 - z).re := by
      rw [Complex.sub_re, Complex.re_ofNat]; linarith
    have h3z_re4 : (3 - z).re ≤ 4 := by
      rw [Complex.sub_re, Complex.re_ofNat]; linarith
    have h_g3z_le : ‖Complex.Gamma (3 - z)‖ ≤ 7 := h_gamma_upper (3 - z) h3z_re1 h3z_re4
    have h_sin_pz : ‖Complex.sin ((Real.pi : ℂ) * z)‖ ≤ Real.exp (4 * |z.im|) := by
      have h1 := h_sin_upper ((Real.pi : ℂ) * z)
      have him : ((Real.pi : ℂ) * z).im = Real.pi * z.im := by simp
      rw [him, abs_mul, abs_of_pos Real.pi_pos] at h1
      have h2 : Real.pi * |z.im| ≤ 4 * |z.im| :=
        mul_le_mul_of_nonneg_right (le_of_lt Real.pi_lt_four) (abs_nonneg z.im)
      exact le_trans h1 (Real.exp_le_exp.mpr h2)
    have h_pz_im_ne : ((Real.pi : ℂ) * z).im ≠ 0 := by
      have him : ((Real.pi : ℂ) * z).im = Real.pi * z.im := by simp
      rw [him]
      have hz_im_ne : z.im ≠ 0 := by
        intro h0
        rw [h0, abs_zero] at hz_im
        linarith
      exact mul_ne_zero (ne_of_gt Real.pi_pos) hz_im_ne
    have h_sin_pos : 0 < ‖Complex.sin ((Real.pi : ℂ) * z)‖ :=
      norm_pos_iff.mpr (h_sin_ne ((Real.pi : ℂ) * z) h_pz_im_ne)
    have h_prod_ge : (1 / 4 : ℝ) ≤ ‖2 - z‖ * ‖1 - z‖ := by
      calc (1 / 4 : ℝ) = (1 / 2) * (1 / 2) := by ring
        _ ≤ ‖2 - z‖ * ‖1 - z‖ := mul_le_mul h2z_norm h1z_norm (by norm_num) (norm_nonneg _)
    have h_rhs_ge : (3 / 4 : ℝ) * Real.exp (-4 * |z.im|) ≤
        ‖2 - z‖ * ‖1 - z‖ * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) := by
      have h_pi_div : 3 * Real.exp (-4 * |z.im|) ≤ Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖ := by
        rw [le_div_iff₀ h_sin_pos]
        calc 3 * Real.exp (-4 * |z.im|) * ‖Complex.sin ((Real.pi : ℂ) * z)‖
            ≤ 3 * Real.exp (-4 * |z.im|) * Real.exp (4 * |z.im|) :=
              mul_le_mul_of_nonneg_left h_sin_pz (by positivity)
          _ = 3 * (Real.exp (-4 * |z.im|) * Real.exp (4 * |z.im|)) := by ring
          _ = 3 := by rw [← Real.exp_add]; simp
          _ ≤ Real.pi := le_of_lt Real.pi_gt_three
      calc (3 / 4 : ℝ) * Real.exp (-4 * |z.im|)
          = (1 / 4) * (3 * Real.exp (-4 * |z.im|)) := by ring
        _ ≤ (‖2 - z‖ * ‖1 - z‖) * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) :=
            mul_le_mul h_prod_ge h_pi_div (by positivity) (by positivity)
    have h_7_gz : (3 / 4 : ℝ) * Real.exp (-4 * |z.im|) ≤ 7 * ‖Complex.Gamma z‖ := by
      calc (3 / 4 : ℝ) * Real.exp (-4 * |z.im|)
          ≤ ‖2 - z‖ * ‖1 - z‖ * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) := h_rhs_ge
        _ = ‖Complex.Gamma z‖ * ‖Complex.Gamma (3 - z)‖ := h_refl_norm.symm
        _ ≤ ‖Complex.Gamma z‖ * 7 := mul_le_mul_of_nonneg_left h_g3z_le (norm_nonneg _)
        _ = 7 * ‖Complex.Gamma z‖ := by ring
    have hexp_16 : Real.exp (-16) ≤ 3 / 28 := by
      have h1 : (11 : ℝ) ≤ Real.exp 16 := by
        have h2 := Real.add_one_le_exp 10
        have h3 : Real.exp 10 ≤ Real.exp 16 := Real.exp_le_exp.mpr (by norm_num)
        linarith
      rw [Real.exp_neg, inv_le_iff_one_le_mul₀ (Real.exp_pos 16)]
      linarith
    have h_exp_split : Real.exp (-4 * (4 + |z.im|)) = Real.exp (-16) * Real.exp (-4 * |z.im|) := by
      rw [← Real.exp_add]
      congr 1; ring
    rw [h_exp_split]
    have h_le_3_28 : Real.exp (-16) * Real.exp (-4 * |z.im|) ≤ (3 / 28 : ℝ) * Real.exp (-4 * |z.im|) :=
      mul_le_mul_of_nonneg_right hexp_16 (le_of_lt (Real.exp_pos _))
    linarith
  set L : ℝ := 4 + |s.im|
  have hL_ge_four : 4 ≤ L := by dsimp [L]; linarith [abs_nonneg s.im]
  have h_gammaR : Real.exp (-8 * L) ≤ ‖Complex.Gammaℝ s‖ := by
    rw [Complex.Gammaℝ_def, norm_mul]
    have hs2_re1 : -1 / 2 ≤ (s / 2).re := by
      rw [Complex.div_ofNat_re]; linarith
    have hs2_re2 : (s / 2).re ≤ 2 := by
      rw [Complex.div_ofNat_re]; linarith
    have hs2_im : 1 / 2 ≤ |(s / 2).im| := by
      rw [Complex.div_ofNat_im, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith
    have h_g_s2 := h_gamma_lower (s / 2) hs2_re1 hs2_re2 hs2_im
    have h_g_s2_L : Real.exp (-4 * L) ≤ ‖Complex.Gamma (s / 2)‖ := by
      have h1 : -4 * L ≤ -4 * (4 + |(s / 2).im|) := by
        rw [Complex.div_ofNat_im, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
        dsimp [L]; linarith [abs_nonneg s.im]
      exact le_trans (Real.exp_le_exp.mpr h1) h_g_s2
    have h_pi_pow : Real.exp (-4 * L) ≤ ‖(Real.pi : ℂ) ^ (-s / 2)‖ := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos Real.pi_pos]
      have h_re : (-s / 2).re = -s.re / 2 := by
        rw [Complex.div_ofNat_re, Complex.neg_re]
      rw [h_re]
      have h_rpow1 : Real.pi ^ (-1 : ℝ) ≤ Real.pi ^ (-s.re / 2) :=
        Real.rpow_le_rpow_of_exponent_le (by linarith [Real.pi_gt_three]) (by linarith)
      have h_pi_inv : (1 / 4 : ℝ) ≤ Real.pi ^ (-1 : ℝ) := by
        rw [Real.rpow_neg_one, one_div]
        exact inv_anti₀ Real.pi_pos (le_of_lt Real.pi_lt_four)
      have hexp_4L : Real.exp (-4 * L) ≤ 1 / 4 := by
        have h1 : (4 : ℝ) ≤ Real.exp (4 * L) := by
          have h2 := Real.add_one_le_exp (4 * L)
          linarith
        rw [show -4 * L = -(4 * L) by ring, Real.exp_neg, one_div]
        exact inv_anti₀ (by norm_num) h1
      exact le_trans hexp_4L (le_trans h_pi_inv h_rpow1)
    calc Real.exp (-8 * L)
        = Real.exp (-4 * L) * Real.exp (-4 * L) := by
          rw [← Real.exp_add]; congr 1; ring
      _ ≤ ‖(Real.pi : ℂ) ^ (-s / 2)‖ * ‖Complex.Gamma (s / 2)‖ :=
          mul_le_mul h_pi_pow h_g_s2_L (le_of_lt (Real.exp_pos _)) (norm_nonneg _)
  have h_gammaC : Real.exp (-8 * L) ≤ ‖Complex.Gammaℂ s‖ := by
    rw [Complex.Gammaℂ_def, norm_mul, norm_mul, Complex.norm_ofNat]
    have h_g_s : Real.exp (-4 * L) ≤ ‖Complex.Gamma s‖ :=
      h_gamma_lower s hs_re1 hs_re2 (by linarith)
    have h_2pi_pos : 0 < 2 * Real.pi := by positivity
    have h_2pi_cast : (2 * (Real.pi : ℂ)) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
    have h_2pi_pow : Real.exp (-4 * L) ≤ 2 * ‖(2 * (Real.pi : ℂ)) ^ (-s)‖ := by
      rw [h_2pi_cast, Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos, Complex.neg_re]
      have h_rpow2 : (2 * Real.pi) ^ (-2 : ℝ) ≤ (2 * Real.pi) ^ (-s.re) :=
        Real.rpow_le_rpow_of_exponent_le (by linarith [Real.pi_gt_three]) (by linarith)
      have h_2pi_le_8 : 2 * Real.pi ≤ 8 := by linarith [Real.pi_lt_four]
      have h_inv_sq : (1 / 64 : ℝ) ≤ (2 * Real.pi) ^ (-2 : ℝ) := by
        have h_eq : (2 * Real.pi) ^ (-2 : ℝ) = ((2 * Real.pi) ^ 2)⁻¹ := by
          rw [show (-2 : ℝ) = -((2 : ℕ) : ℝ) by norm_num, Real.rpow_neg (le_of_lt h_2pi_pos),
            Real.rpow_natCast]
        rw [h_eq, one_div]
        have h_sq_le : (2 * Real.pi) ^ 2 ≤ 64 := by nlinarith [Real.pi_pos, Real.pi_lt_four]
        exact inv_anti₀ (by positivity) h_sq_le
      have hexp_4L : Real.exp (-4 * L) ≤ 1 / 32 := by
        have h_e2 : (3 : ℝ) ≤ Real.exp 2 := by linarith [Real.add_one_le_exp 2]
        have h_e8 : (3 : ℝ) ^ 4 ≤ (Real.exp 2) ^ 4 := pow_le_pow_left₀ (by norm_num) h_e2 4
        have h_e8_eq : (Real.exp 2) ^ 4 = Real.exp 8 := by
          rw [← Real.exp_nat_mul]; norm_num
        have h_e16 : Real.exp 8 ≤ Real.exp (4 * L) := Real.exp_le_exp.mpr (by linarith)
        have h_32 : (32 : ℝ) ≤ Real.exp (4 * L) := by linarith [show (3 : ℝ) ^ 4 = 81 by norm_num]
        rw [show -4 * L = -(4 * L) by ring, Real.exp_neg, one_div]
        exact inv_anti₀ (by norm_num) h_32
      calc Real.exp (-4 * L) ≤ 1 / 32 := hexp_4L
        _ = 2 * (1 / 64) := by ring
        _ ≤ 2 * (2 * Real.pi) ^ (-2 : ℝ) := mul_le_mul_of_nonneg_left h_inv_sq (by norm_num)
        _ ≤ 2 * (2 * Real.pi) ^ (-s.re) := mul_le_mul_of_nonneg_left h_rpow2 (by norm_num)
    calc Real.exp (-8 * L)
        = Real.exp (-4 * L) * Real.exp (-4 * L) := by
          rw [← Real.exp_add]; congr 1; ring
      _ ≤ (2 * ‖(2 * (Real.pi : ℂ)) ^ (-s)‖) * ‖Complex.Gamma s‖ :=
          mul_le_mul h_2pi_pow h_g_s (le_of_lt (Real.exp_pos _)) (by positivity)
  rw [norm_mul, norm_pow, norm_pow]
  have h_r1 : Real.exp (-(8 * (r₁ : ℝ)) * L) ≤ ‖Complex.Gammaℝ s‖ ^ r₁ := by
    have h1 : (Real.exp (-8 * L)) ^ r₁ ≤ ‖Complex.Gammaℝ s‖ ^ r₁ :=
      pow_le_pow_left₀ (le_of_lt (Real.exp_pos _)) h_gammaR r₁
    have h2 : (Real.exp (-8 * L)) ^ r₁ = Real.exp (-(8 * (r₁ : ℝ)) * L) := by
      rw [← Real.exp_nat_mul]; congr 1; ring
    rwa [h2] at h1
  have h_r2 : Real.exp (-(8 * (r₂ : ℝ)) * L) ≤ ‖Complex.Gammaℂ s‖ ^ r₂ := by
    have h1 : (Real.exp (-8 * L)) ^ r₂ ≤ ‖Complex.Gammaℂ s‖ ^ r₂ :=
      pow_le_pow_left₀ (le_of_lt (Real.exp_pos _)) h_gammaC r₂
    have h2 : (Real.exp (-8 * L)) ^ r₂ = Real.exp (-(8 * (r₂ : ℝ)) * L) := by
      rw [← Real.exp_nat_mul]; congr 1; ring
    rwa [h2] at h1
  calc Real.exp (-(8 * ((r₁ : ℝ) + (r₂ : ℝ))) * L)
      = Real.exp (-(8 * (r₁ : ℝ)) * L) * Real.exp (-(8 * (r₂ : ℝ)) * L) := by
        rw [← Real.exp_add]; congr 1; ring
    _ ≤ ‖Complex.Gammaℝ s‖ ^ r₁ * ‖Complex.Gammaℂ s‖ ^ r₂ :=
        mul_le_mul h_r1 h_r2 (le_of_lt (Real.exp_pos _)) (by positivity)

theorem mitsui_entire_strip_exp_bound_of_high_im_bound (g : ℂ → ℂ) (C₁ B₁ : ℝ) (hC₁ : 0 < C₁) (hB₁ : 0 ≤ B₁)
    (hg_diff : Differentiable ℂ g)
    (hg_high : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
      ‖g s‖ ≤ C₁ * (4 + |s.im|) * Real.exp (B₁ * (4 + |s.im|))) :
    ∃ B : ℝ, 0 < B ∧
      ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
        ‖g s‖ ≤ Real.exp (B * (4 + |s.im|)) :=
by
  let K_low : Set ℂ := Set.Icc (-1 / 2 : ℝ) 2 ×ℂ Set.Icc (-1 : ℝ) 1
  have hK_compact : IsCompact K_low := isCompact_Icc.reProdIm isCompact_Icc
  have hg_cont : ContinuousOn (fun z : ℂ => ‖g z‖) K_low :=
    hg_diff.continuous.norm.continuousOn
  obtain ⟨M₀, hM₀⟩ := hK_compact.bddAbove_image hg_cont
  let M_low : ℝ := max M₀ 1
  have hM_low_ge_one : 1 ≤ M_low := le_max_right M₀ 1
  have hM₀_le_M_low : M₀ ≤ M_low := le_max_left M₀ 1
  let B : ℝ := M_low + C₁ + B₁ + 1
  have hB_pos : 0 < B := by dsimp [B]; linarith
  refine ⟨B, hB_pos, ?_⟩
  intro s hs1 hs2
  set L : ℝ := 4 + |s.im|
  have habs_nonneg : 0 ≤ |s.im| := abs_nonneg s.im
  have hL_ge_one : 1 ≤ L := by dsimp [L]; linarith
  have hL_pos : 0 < L := by linarith
  rcases le_or_gt 1 |s.im| with hs_high | hs_low
  · have hg_s : ‖g s‖ ≤ C₁ * L * Real.exp (B₁ * L) := hg_high s hs1 hs2 hs_high
    have hC₁_le_CL : C₁ ≤ C₁ * L := le_mul_of_one_le_right (le_of_lt hC₁) hL_ge_one
    have hC₁_le_exp : C₁ ≤ Real.exp (C₁ * L) := by
      linarith [Real.add_one_le_exp (C₁ * L)]
    have hL_le_exp : L ≤ Real.exp L := by
      linarith [Real.add_one_le_exp L]
    have hCL_le : C₁ * L ≤ Real.exp (C₁ * L) * Real.exp L :=
      mul_le_mul hC₁_le_exp hL_le_exp (le_of_lt hL_pos) (le_of_lt (Real.exp_pos (C₁ * L)))
    have h_prod_le : C₁ * L * Real.exp (B₁ * L) ≤
        Real.exp (C₁ * L) * Real.exp L * Real.exp (B₁ * L) :=
      mul_le_mul_of_nonneg_right hCL_le (le_of_lt (Real.exp_pos (B₁ * L)))
    have h_exp_eq : Real.exp (C₁ * L) * Real.exp L * Real.exp (B₁ * L) =
        Real.exp ((C₁ + 1 + B₁) * L) := by
      rw [← Real.exp_add, ← Real.exp_add]
      congr 1
      ring
    have h_exp_le : Real.exp ((C₁ + 1 + B₁) * L) ≤ Real.exp (B * L) := by
      rw [Real.exp_le_exp]
      apply mul_le_mul_of_nonneg_right _ (le_of_lt hL_pos)
      dsimp [B]
      linarith
    linarith
  · have hs_im : s.im ∈ Set.Icc (-1 : ℝ) 1 := abs_le.mp (le_of_lt hs_low)
    have hs_re : s.re ∈ Set.Icc (-1 / 2 : ℝ) 2 := ⟨hs1, hs2⟩
    have hs_mem : s ∈ K_low := Complex.mem_reProdIm.mpr ⟨hs_re, hs_im⟩
    have hg_le_M₀ : ‖g s‖ ≤ M₀ :=
      hM₀ (Set.mem_image_of_mem (fun z : ℂ => ‖g z‖) hs_mem)
    have hM_low_le_B : M_low ≤ B := by dsimp [B]; linarith
    have hB_le_BL : B ≤ B * L := le_mul_of_one_le_right (le_of_lt hB_pos) hL_ge_one
    have hBL_le_exp : B * L ≤ Real.exp (B * L) := by
      linarith [Real.add_one_le_exp (B * L)]
    linarith

theorem mitsui_regularized_dedekindZeta_entire_functional_eq_and_exp_bound {K : Type u} [Field K] [NumberField K] :
    ∃ (B : ℝ) (g_K : ℂ → ℂ), 0 < B ∧
      Differentiable ℂ g_K ∧
      (∀ s : ℂ, 1 < s.re → g_K s = (s - 1) * NumberField.dedekindZeta K s) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
          (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
          (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_K s =
        -(1 - s) *
          (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
            (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          NumberField.dedekindZeta K (1 - s)) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
        ‖g_K s‖ ≤ Real.exp (B * (4 + |s.im|))) :=
by
  obtain ⟨C₀, g_K, hC₀_pos, hg_diff, hg_eq, hg_symm, hg_mellin⟩ :=
    mitsui_regularized_dedekindZeta_completed_entire_and_mellin_bound (K := K)
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_ge_one : (1 : ℝ) ≤ D := by
    dsimp [D]
    exact_mod_cast Int.one_le_abs (NumberField.discr_ne_zero K)
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  let C₁ : ℝ := C₀ * D ^ (1 / 4 : ℝ)
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
  let B₁ : ℝ := 8 * ((r₁ : ℝ) + (r₂ : ℝ))
  have hB₁_nonneg : 0 ≤ B₁ := by dsimp [B₁]; positivity
  have h_high : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
      ‖g_K s‖ ≤ C₁ * (4 + |s.im|) * Real.exp (B₁ * (4 + |s.im|)) := by
    intro s hs1 hs2 hs_im
    set L : ℝ := 4 + |s.im|
    have hD_s_lower : D ^ (-1 / 4 : ℝ) ≤ ‖(D : ℂ) ^ (s / 2)‖ := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos]
      have hs2_re : -1 / 4 ≤ (s / 2).re := by
        rw [Complex.div_ofNat_re]; linarith
      exact Real.rpow_le_rpow_of_exponent_le hD_ge_one hs2_re
    have hγ_lower : Real.exp (-B₁ * L) ≤ ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ := by
      have h1 := mitsui_archimedean_gamma_exp_lower_bound_on_strip r₁ r₂ s hs1 hs2 hs_im
      dsimp [B₁, L]
      exact h1
    have h_mellin_s := hg_mellin s hs1 hs2 hs_im
    have h_assoc :
        ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_K s =
          (D : ℂ) ^ (s / 2) * ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_K s := by
      ring
    rw [h_assoc, norm_mul, norm_mul] at h_mellin_s
    have h_pref_lower :
        D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L) ≤
          ‖(D : ℂ) ^ (s / 2)‖ * ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ :=
      mul_le_mul hD_s_lower hγ_lower (le_of_lt (Real.exp_pos _)) (norm_nonneg _)
    have h_prod_le :
        (D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) * ‖g_K s‖ ≤ C₀ * L :=
      le_trans (mul_le_mul_of_nonneg_right h_pref_lower (norm_nonneg _)) h_mellin_s
    have hD_cancel : D ^ (1 / 4 : ℝ) * D ^ (-1 / 4 : ℝ) = 1 := by
      rw [← Real.rpow_add hD_pos]
      norm_num
    have hexp_cancel : Real.exp (B₁ * L) * Real.exp (-B₁ * L) = 1 := by
      rw [← Real.exp_add]
      simp
    calc ‖g_K s‖
        = (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) *
            ((D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) * ‖g_K s‖) := by
          have h1 : (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) *
              (D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) =
              (D ^ (1 / 4 : ℝ) * D ^ (-1 / 4 : ℝ)) *
                (Real.exp (B₁ * L) * Real.exp (-B₁ * L)) := by ring
          rw [← mul_assoc, h1, hD_cancel, hexp_cancel, mul_one, one_mul]
      _ ≤ (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) * (C₀ * L) :=
          mul_le_mul_of_nonneg_left h_prod_le (by positivity)
      _ = C₁ * L * Real.exp (B₁ * L) := by dsimp [C₁]; ring
  obtain ⟨B, hB_pos, hg_exp⟩ :=
    mitsui_entire_strip_exp_bound_of_high_im_bound g_K C₁ B₁ hC₁_pos hB₁_nonneg hg_diff h_high
  refine ⟨B, g_K, hB_pos, hg_diff, hg_eq, ?_, hg_exp⟩
  intro s hs
  have hs_ne : s ≠ 0 := by
    intro h0
    rw [h0, Complex.zero_re] at hs
    norm_num at hs
  have h1s_re : 1 < (1 - s).re := by
    rw [Complex.sub_re, Complex.one_re, hs]
    norm_num
  have hg_1s := hg_eq (1 - s) h1s_re
  have h_sub_1s : (1 - s) - 1 = -s := by ring
  rw [h_sub_1s] at hg_1s
  have h_symm := hg_symm s hs
  rw [hg_1s] at h_symm
  apply mul_left_cancel₀ hs_ne
  calc s * (((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_K s)
      = s * ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_K s := by
        ring
    _ = (1 - s) * ((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) *
          (-s * NumberField.dedekindZeta K (1 - s)) := h_symm
    _ = s * (-(1 - s) *
          ((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) *
          NumberField.dedekindZeta K (1 - s)) := by
        ring

theorem mitsui_phragmenLindelof_polynomial_vertical_strip (g : ℂ → ℂ) (m : ℕ) (B M : ℝ) (hB : 0 < B) (hM : 0 ≤ M)
    (hg_diff : Differentiable ℂ g)
    (hg_exp : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖g s‖ ≤ Real.exp (B * (4 + |s.im|)))
    (hg_left : ∀ s : ℂ, s.re = -1 / 2 → ‖g s‖ ≤ M * (4 + |s.im|) ^ m)
    (hg_right : ∀ s : ℂ, s.re = 2 → ‖g s‖ ≤ M * (4 + |s.im|) ^ m) :
    ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
      ‖g s‖ ≤ 4 ^ m * M * (4 + |s.im|) ^ m :=
by
  have h_s4_bounds : ∀ z : ℂ, -1 / 2 ≤ z.re → z.re ≤ 2 →
      (1 / 2) * (4 + |z.im|) ≤ ‖z + 4‖ ∧ ‖z + 4‖ ≤ 2 * (4 + |z.im|) ∧ z + 4 ≠ 0 := by
    intro z hz1 hz2
    have h_re : (z + 4).re = z.re + 4 := by simp
    have h_im : (z + 4).im = z.im := by simp
    have h_lower_sq : ((1 / 2) * (4 + |z.im|)) ^ 2 ≤ ‖z + 4‖ ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply, h_re, h_im]
      have h_abs_sq : |z.im| ^ 2 = z.im * z.im := by rw [sq_abs, sq]
      have h_im_nn : 0 ≤ |z.im| := abs_nonneg z.im
      have h_re_ge : 7 / 2 ≤ z.re + 4 := by linarith
      have h_re_sq : (7 / 2) ^ 2 ≤ (z.re + 4) * (z.re + 4) := by nlinarith
      nlinarith
    have h_lower : (1 / 2) * (4 + |z.im|) ≤ ‖z + 4‖ := by
      have h_nn1 : 0 ≤ (1 / 2) * (4 + |z.im|) := by linarith [abs_nonneg z.im]
      exact (sq_le_sq₀ h_nn1 (norm_nonneg _)).mp h_lower_sq
    have h_upper : ‖z + 4‖ ≤ 2 * (4 + |z.im|) := by
      have h1 := Complex.norm_le_abs_re_add_abs_im (z + 4)
      rw [h_re, h_im, abs_of_pos (by linarith)] at h1
      linarith [abs_nonneg z.im]
    have h_ne : z + 4 ≠ 0 := by
      apply norm_pos_iff.mp
      have : (0 : ℝ) < (1 / 2) * (4 + |z.im|) := by linarith [abs_nonneg z.im]
      linarith
    exact ⟨h_lower, h_upper, h_ne⟩
  let f : ℂ → ℂ := fun z => g z / (z + 4) ^ m
  have hf_diffCont : DiffContOnCl ℂ f (Complex.re ⁻¹' Set.Ioo (-1 / 2 : ℝ) 2) := by
    refine DifferentiableOn.diffContOnCl ?_
    have h_closure_sub : closure (Complex.re ⁻¹' Set.Ioo (-1 / 2 : ℝ) 2) ⊆
        {z : ℂ | -1 / 2 ≤ z.re ∧ z.re ≤ 2} := by
      have h_closed : IsClosed {z : ℂ | -1 / 2 ≤ z.re ∧ z.re ≤ 2} :=
        (isClosed_le continuous_const Complex.continuous_re).inter
          (isClosed_le Complex.continuous_re continuous_const)
      refine closure_minimal (fun z hz => ⟨le_of_lt hz.1, le_of_lt hz.2⟩) h_closed
    intro z hz
    obtain ⟨hz1, hz2⟩ := h_closure_sub hz
    have hz_ne : (z + 4) ^ m ≠ 0 := pow_ne_zero m (h_s4_bounds z hz1 hz2).2.2
    refine DifferentiableAt.differentiableWithinAt ?_
    dsimp [f]
    exact (hg_diff z).div ((differentiableAt_id.add (differentiableAt_const 4)).pow m) hz_ne
  have hf_bigO : ∃ c < Real.pi / (2 - (-1 / 2 : ℝ)), ∃ B',
      f =O[Filter.comap (abs ∘ Complex.im) Filter.atTop ⊓
        Filter.principal (Complex.re ⁻¹' Set.Ioo (-1 / 2 : ℝ) 2)]
        fun z => Real.exp (B' * Real.exp (c * |z.im|)) := by
    refine ⟨1, ?_, 5 * B, ?_⟩
    · have hpi : 3 < Real.pi := Real.pi_gt_three
      have h_denom : (2 - (-1 / 2 : ℝ)) = 5 / 2 := by ring
      rw [h_denom, lt_div_iff₀ (by norm_num)]
      linarith
    · refine Asymptotics.IsBigO.of_bound 1 ?_
      rw [Filter.eventually_inf_principal]
      refine Filter.Eventually.of_forall (fun z hz => ?_)
      have hz1 : -1 / 2 ≤ z.re := le_of_lt hz.1
      have hz2 : z.re ≤ 2 := le_of_lt hz.2
      have h_lower := (h_s4_bounds z hz1 hz2).1
      have h_one_le_z4 : 1 ≤ ‖z + 4‖ := by linarith [abs_nonneg z.im]
      have h_one_le_pow : 1 ≤ ‖(z + 4) ^ m‖ := by
        rw [norm_pow]
        exact one_le_pow₀ h_one_le_z4
      have hf_le_g : ‖f z‖ ≤ ‖g z‖ := by
        dsimp [f]
        rw [norm_div]
        exact div_le_self (norm_nonneg _) h_one_le_pow
      have h_exp_im : 4 + |z.im| ≤ 5 * Real.exp (1 * |z.im|) := by
        rw [one_mul]
        have h1 : |z.im| + 1 ≤ Real.exp |z.im| := Real.add_one_le_exp |z.im|
        have h2 : 1 ≤ Real.exp |z.im| := Real.one_le_exp (abs_nonneg z.im)
        linarith
      have h_exp_le : Real.exp (B * (4 + |z.im|)) ≤ Real.exp (5 * B * Real.exp (1 * |z.im|)) := by
        rw [Real.exp_le_exp]
        calc B * (4 + |z.im|) ≤ B * (5 * Real.exp (1 * |z.im|)) :=
              mul_le_mul_of_nonneg_left h_exp_im (le_of_lt hB)
          _ = 5 * B * Real.exp (1 * |z.im|) := by ring
      rw [one_mul, Real.norm_of_nonneg (le_of_lt (Real.exp_pos _))]
      exact le_trans hf_le_g (le_trans (hg_exp z hz1 hz2) h_exp_le)
  have hf_left : ∀ z : ℂ, z.re = -1 / 2 → ‖f z‖ ≤ 2 ^ m * M := by
    intro z hz
    dsimp [f]
    rw [norm_div, norm_pow]
    have h_lower := (h_s4_bounds z (by linarith) (by linarith)).1
    have h_pow_lower : ((1 / 2) * (4 + |z.im|)) ^ m ≤ ‖z + 4‖ ^ m :=
      pow_le_pow_left₀ (by linarith [abs_nonneg z.im]) h_lower m
    have h_z4_pos : 0 < ‖z + 4‖ ^ m := by
      have : (0 : ℝ) < (1 / 2) * (4 + |z.im|) := by linarith [abs_nonneg z.im]
      exact lt_of_lt_of_le (pow_pos this m) h_pow_lower
    rw [div_le_iff₀ h_z4_pos]
    calc ‖g z‖ ≤ M * (4 + |z.im|) ^ m := hg_left z hz
      _ = 2 ^ m * M * ((1 / 2) * (4 + |z.im|)) ^ m := by
          rw [mul_pow, one_div, inv_pow]
          have h2_ne : (2 : ℝ) ^ m ≠ 0 := by positivity
          field_simp [h2_ne]
      _ ≤ 2 ^ m * M * ‖z + 4‖ ^ m :=
          mul_le_mul_of_nonneg_left h_pow_lower (by positivity)
  have hf_right : ∀ z : ℂ, z.re = 2 → ‖f z‖ ≤ 2 ^ m * M := by
    intro z hz
    dsimp [f]
    rw [norm_div, norm_pow]
    have h_lower := (h_s4_bounds z (by linarith) (by linarith)).1
    have h_pow_lower : ((1 / 2) * (4 + |z.im|)) ^ m ≤ ‖z + 4‖ ^ m :=
      pow_le_pow_left₀ (by linarith [abs_nonneg z.im]) h_lower m
    have h_z4_pos : 0 < ‖z + 4‖ ^ m := by
      have : (0 : ℝ) < (1 / 2) * (4 + |z.im|) := by linarith [abs_nonneg z.im]
      exact lt_of_lt_of_le (pow_pos this m) h_pow_lower
    rw [div_le_iff₀ h_z4_pos]
    calc ‖g z‖ ≤ M * (4 + |z.im|) ^ m := hg_right z hz
      _ = 2 ^ m * M * ((1 / 2) * (4 + |z.im|)) ^ m := by
          rw [mul_pow, one_div, inv_pow]
          have h2_ne : (2 : ℝ) ^ m ≠ 0 := by positivity
          field_simp [h2_ne]
      _ ≤ 2 ^ m * M * ‖z + 4‖ ^ m :=
          mul_le_mul_of_nonneg_left h_pow_lower (by positivity)
  intro s hs1 hs2
  have hf_le : ‖f s‖ ≤ 2 ^ m * M :=
    PhragmenLindelof.vertical_strip hf_diffCont hf_bigO hf_left hf_right hs1 hs2
  obtain ⟨_, h_upper, hs_ne⟩ := h_s4_bounds s hs1 hs2
  have hs_pow_ne : (s + 4) ^ m ≠ 0 := pow_ne_zero m hs_ne
  have hg_eq : g s = f s * (s + 4) ^ m := by
    dsimp [f]
    exact (div_mul_cancel₀ (g s) hs_pow_ne).symm
  have h_pow_upper : ‖(s + 4) ^ m‖ ≤ 2 ^ m * (4 + |s.im|) ^ m := by
    rw [norm_pow, ← mul_pow]
    exact pow_le_pow_left₀ (norm_nonneg _) h_upper m
  have h4_pow : (4 : ℝ) ^ m = (2 : ℝ) ^ m * (2 : ℝ) ^ m := by
    rw [← mul_pow]; norm_num
  rw [hg_eq, norm_mul]
  calc ‖f s‖ * ‖(s + 4) ^ m‖
      ≤ (2 ^ m * M) * (2 ^ m * (4 + |s.im|) ^ m) :=
        mul_le_mul hf_le h_pow_upper (norm_nonneg _) (by positivity)
    _ = (2 ^ m * 2 ^ m) * M * (4 + |s.im|) ^ m := by ring
    _ = 4 ^ m * M * (4 + |s.im|) ^ m := by rw [← h4_pow]

theorem mitsui_regularized_dedekindZeta_entire_and_vertical_growth {K : Type u} [Field K] [NumberField K] :
    ∃ (A₁ : ℝ) (g_K : ℂ → ℂ), 0 < A₁ ∧
      Differentiable ℂ g_K ∧
      (∀ s : ℂ, 1 < s.re → g_K s = (s - 1) * NumberField.dedekindZeta K s) ∧
      (∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 →
        ‖g_K s‖ ≤ A₁ * (4 + |s.im|) ^ (Module.finrank ℚ K + 1)) :=
by
  obtain ⟨B, g_K, hB_pos, hg_diff, hg_eq, hg_feq, hg_exp⟩ :=
    mitsui_regularized_dedekindZeta_entire_functional_eq_and_exp_bound (K := K)
  set n : ℕ := Module.finrank ℚ K
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hr_eq : r₁ + 2 * r₂ = n := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  set Z₃₂ : ℝ := ‖NumberField.dedekindZeta K ((3 / 2 : ℝ) : ℂ)‖
  have hZ₃₂_nonneg : 0 ≤ Z₃₂ := norm_nonneg _
  let M_left : ℝ := D / (2 * Real.pi) ^ n * Z₃₂
  let M_right : ℝ := Z₃₂
  let M : ℝ := M_left + M_right + 1
  have hM_left_nonneg : 0 ≤ M_left := by dsimp [M_left]; positivity
  have hM_right_nonneg : 0 ≤ M_right := hZ₃₂_nonneg
  have hM_pos : 0 < M := by dsimp [M]; positivity
  let A₁ : ℝ := 4 ^ (n + 1) * M
  have hA₁_pos : 0 < A₁ := by dsimp [A₁]; positivity
  have hg_left : ∀ s : ℂ, s.re = -1 / 2 → ‖g_K s‖ ≤ M * (4 + |s.im|) ^ (n + 1) := by
    intro s hs
    obtain ⟨hγ_pos, hγ_eq⟩ := mitsui_archimedean_gamma_norm_eq_on_neg_half_re r₁ r₂ s hs
    rw [hr_eq] at hγ_eq
    have h_feq_norm := congrArg norm (hg_feq s hs)
    set γ_s : ℂ := (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    set γ_1s : ℂ := (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂
    have h_lhs_assoc : ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_K s =
        (D : ℂ) ^ (s / 2) * γ_s * g_K s := by
      dsimp [γ_s]; ring
    have h_rhs_assoc : -(1 - s) * ((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) *
          NumberField.dedekindZeta K (1 - s) =
        -(1 - s) * ((D : ℂ) ^ ((1 - s) / 2) * γ_1s) * NumberField.dedekindZeta K (1 - s) := by
      dsimp [γ_1s]; ring
    rw [h_lhs_assoc, h_rhs_assoc] at h_feq_norm
    simp only [norm_mul, norm_neg] at h_feq_norm
    have hs_div_re : (s / 2).re = -1 / 4 := by
      rw [Complex.div_ofNat_re, hs]
      ring
    have h1s_div_re : ((1 - s) / 2).re = 3 / 4 := by
      rw [Complex.div_ofNat_re, Complex.sub_re, Complex.one_re, hs]
      ring
    have hD_s : ‖(D : ℂ) ^ (s / 2)‖ = D ^ (-1 / 4 : ℝ) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos, hs_div_re]
    have hD_1s : ‖(D : ℂ) ^ ((1 - s) / 2)‖ = D * D ^ (-1 / 4 : ℝ) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos, h1s_div_re]
      have h_exp : (3 / 4 : ℝ) = 1 + (-1 / 4 : ℝ) := by ring
      rw [h_exp, Real.rpow_add hD_pos, Real.rpow_one]
    rw [hD_s, hD_1s, hγ_eq] at h_feq_norm
    have hD_rpow_pos : 0 < D ^ (-1 / 4 : ℝ) := Real.rpow_pos_of_pos hD_pos _
    have h_pref_pos : 0 < D ^ (-1 / 4 : ℝ) * ‖γ_s‖ := mul_pos hD_rpow_pos hγ_pos
    have h_g_eq : ‖g_K s‖ = D * (‖s‖ / (2 * Real.pi)) ^ n * ‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖ := by
      apply mul_left_cancel₀ (ne_of_gt h_pref_pos)
      calc (D ^ (-1 / 4 : ℝ) * ‖γ_s‖) * ‖g_K s‖
          = ‖1 - s‖ * (D * D ^ (-1 / 4 : ℝ) * ((‖s‖ / (2 * Real.pi)) ^ n * ‖γ_s‖)) *
              ‖NumberField.dedekindZeta K (1 - s)‖ := h_feq_norm
        _ = (D ^ (-1 / 4 : ℝ) * ‖γ_s‖) *
              (D * (‖s‖ / (2 * Real.pi)) ^ n * ‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖) := by ring
    have h1s_re : (3 / 2 : ℝ) ≤ (1 - s).re := by
      rw [Complex.sub_re, Complex.one_re, hs]
      linarith
    have hζ_le : ‖NumberField.dedekindZeta K (1 - s)‖ ≤ Z₃₂ :=
      mitsui_dedekindZeta_norm_le_of_re_ge (1 - s) (3 / 2) (by norm_num) h1s_re
    have hs_norm_le : ‖s‖ ≤ 4 + |s.im| := by
      have h1 := Complex.norm_le_abs_re_add_abs_im s
      rw [hs, abs_of_neg (by norm_num)] at h1
      linarith
    have h1s_norm_le : ‖1 - s‖ ≤ 4 + |s.im| := by
      have h1 := Complex.norm_le_abs_re_add_abs_im (1 - s)
      have h_re : (1 - s).re = 3 / 2 := by rw [Complex.sub_re, Complex.one_re, hs]; ring
      have h_im : (1 - s).im = -s.im := by rw [Complex.sub_im, Complex.one_im, zero_sub]
      rw [h_re, h_im, abs_of_pos (by norm_num), abs_neg] at h1
      linarith
    have h2pi_pos : 0 < 2 * Real.pi := by positivity
    have h_div_pow_le : (‖s‖ / (2 * Real.pi)) ^ n ≤ (4 + |s.im|) ^ n / (2 * Real.pi) ^ n := by
      rw [← div_pow]
      exact pow_le_pow_left₀ (by positivity)
        (div_le_div_of_nonneg_right hs_norm_le (le_of_lt h2pi_pos)) n
    have h_prod_le : D * (‖s‖ / (2 * Real.pi)) ^ n * ‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖ ≤
        M_left * (4 + |s.im|) ^ (n + 1) := by
      calc D * (‖s‖ / (2 * Real.pi)) ^ n * ‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖
          = D * ((‖s‖ / (2 * Real.pi)) ^ n * (‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖)) := by ring
        _ ≤ D * (((4 + |s.im|) ^ n / (2 * Real.pi) ^ n) * ((4 + |s.im|) * Z₃₂)) := by
            refine mul_le_mul_of_nonneg_left ?_ (le_of_lt hD_pos)
            refine mul_le_mul h_div_pow_le (mul_le_mul h1s_norm_le hζ_le (norm_nonneg _) (by positivity))
              (by positivity) (by positivity)
        _ = M_left * (4 + |s.im|) ^ (n + 1) := by
            dsimp [M_left]
            rw [pow_succ]
            ring
    have hM_left_le : M_left ≤ M := by dsimp [M]; linarith
    rw [h_g_eq]
    calc D * (‖s‖ / (2 * Real.pi)) ^ n * ‖1 - s‖ * ‖NumberField.dedekindZeta K (1 - s)‖
        ≤ M_left * (4 + |s.im|) ^ (n + 1) := h_prod_le
      _ ≤ M * (4 + |s.im|) ^ (n + 1) :=
          mul_le_mul_of_nonneg_right hM_left_le (by positivity)
  have hg_right : ∀ s : ℂ, s.re = 2 → ‖g_K s‖ ≤ M * (4 + |s.im|) ^ (n + 1) := by
    intro s hs
    have hs_gt_one : 1 < s.re := by linarith
    rw [hg_eq s hs_gt_one, norm_mul]
    have hs_ge : (3 / 2 : ℝ) ≤ s.re := by linarith
    have hζ_le : ‖NumberField.dedekindZeta K s‖ ≤ M_right :=
      mitsui_dedekindZeta_norm_le_of_re_ge s (3 / 2) (by norm_num) hs_ge
    have hs1_norm_le : ‖s - 1‖ ≤ 4 + |s.im| := by
      have h1 := Complex.norm_le_abs_re_add_abs_im (s - 1)
      have h_re : (s - 1).re = 1 := by rw [Complex.sub_re, Complex.one_re, hs]; ring
      have h_im : (s - 1).im = s.im := by rw [Complex.sub_im, Complex.one_im, sub_zero]
      rw [h_re, h_im, abs_of_pos zero_lt_one] at h1
      linarith
    have h4_ge_one : 1 ≤ 4 + |s.im| := by linarith [abs_nonneg s.im]
    have h_pow_ge : 4 + |s.im| ≤ (4 + |s.im|) ^ (n + 1) :=
      le_self_pow₀ h4_ge_one (Nat.succ_ne_zero n)
    have hs1_pow_le : ‖s - 1‖ ≤ (4 + |s.im|) ^ (n + 1) := le_trans hs1_norm_le h_pow_ge
    have hM_right_le : M_right ≤ M := by dsimp [M]; linarith
    calc ‖s - 1‖ * ‖NumberField.dedekindZeta K s‖
        ≤ (4 + |s.im|) ^ (n + 1) * M_right :=
          mul_le_mul hs1_pow_le hζ_le (norm_nonneg _) (by positivity)
      _ = M_right * (4 + |s.im|) ^ (n + 1) := by ring
      _ ≤ M * (4 + |s.im|) ^ (n + 1) :=
          mul_le_mul_of_nonneg_right hM_right_le (by positivity)
  refine ⟨A₁, g_K, hA₁_pos, hg_diff, hg_eq, ?_⟩
  intro s hs1 hs2
  have hs_neg_half : -1 / 2 ≤ s.re := by linarith
  exact mitsui_phragmenLindelof_polynomial_vertical_strip g_K (n + 1) B M
    hB_pos (le_of_lt hM_pos) hg_diff hg_exp hg_left hg_right s hs_neg_half hs2

theorem mitsui_regularized_dedekindZeta_re_logDeriv_bounds_of_vertical_growth {K : Type u} [Field K] [NumberField K]
    (A₁ : ℝ) (g_K : ℂ → ℂ) (hA₁_pos : 0 < A₁)
    (hg_diff : Differentiable ℂ g_K)
