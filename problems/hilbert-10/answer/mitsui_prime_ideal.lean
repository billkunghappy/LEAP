        refine Summable.of_norm ?_
        rw [summable_prod_of_nonneg (fun _ => norm_nonneg _)]
        exact ⟨fun a => (h_sum_primal a).norm, (hasSum_fintype _).summable⟩
      let P_dual : J_σC → ℂ := fun x_star =>
        (∏ w : NumberField.InfinitePlace K,
          (((if 0 ≤ l_eff w then star (w.embedding ((x_star.1 : R) : K)) else w.embedding ((x_star.1 : R) : K)) /
            (w (γ_C C : K) : ℂ)) *
            (((t_y w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
        (Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (t_y w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ_C C : K)) ^ 2) : ℂ)
      have h_sum_P_dual_norm : Summable (fun x_star : J_σC => ‖P_dual x_star‖) := by
        refine (h_poiss 0).2.1.congr (fun x_star => ?_)
        dsimp only [P_dual]
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_of_lt (Real.exp_pos _)), norm_prod]
        congr 1
        refine Finset.prod_congr rfl (fun w _ => ?_)
        rw [norm_pow, norm_mul, norm_div,
          Complex.norm_real, Real.norm_of_nonneg (le_of_lt (hγC_pos w)),
          Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg (le_of_lt (ht_y_pos w)) _)]
        congr 3
