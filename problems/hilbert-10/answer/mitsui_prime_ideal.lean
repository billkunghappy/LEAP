      have h_nonneg : 0 ≤ t⁻¹ + Real.log t - 1 := by
        linarith [h_log_inv_le ht.1]
      have h_le_inv : t⁻¹ + Real.log t - 1 ≤ t⁻¹ := by
        linarith [Real.log_nonpos (le_of_lt ht.1) ht.2]
      rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1, Complex.sub_re, Complex.one_re,
        Complex.norm_real, Real.norm_of_nonneg h_nonneg]
      have h_mul := mul_le_mul_of_nonneg_left h_le_inv (Real.rpow_nonneg (le_of_lt ht.1) (s.re - 1))
      have h_rpow : t ^ (s.re - 1) * t⁻¹ = t ^ (s.re - 2) := by
        rw [← Real.rpow_neg_one t, ← Real.rpow_add ht.1]
