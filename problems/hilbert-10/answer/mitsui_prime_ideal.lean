        (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) * ((D : ℂ) ^ (z / 2) * ∏ w : NumberField.InfinitePlace K, F w) := by
      calc ((B_f : ℂ) ^ z * (P_f : ℂ)) * ((S_f : ℂ)⁻¹ * ∏ w : NumberField.InfinitePlace K, F w)
          = (B_f : ℂ) ^ z * ((P_f : ℂ) * (S_f : ℂ)⁻¹) * ∏ w : NumberField.InfinitePlace K, F w := by ring
        _ = ((D : ℂ) ^ (z / 2) * (N_f : ℂ) ^ (z / 2)) * (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ) * ∏ w : NumberField.InfinitePlace K, F w := by
            rw [hBf_cpow, hPf_div]
        _ = ((N_f : ℂ) ^ (z / 2) * (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ)) * ((D : ℂ) ^ (z / 2) * ∏ w : NumberField.InfinitePlace K, F w) := by ring
        _ = (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) * ((D : ℂ) ^ (z / 2) * ∏ w : NumberField.InfinitePlace K, F w) := by rw [hNf_comb]
    change ((B_f : ℂ) ^ z * (P_f : ℂ)) * ((S_f : ℂ)⁻¹ * ∏ w : NumberField.InfinitePlace K, F w) =
      (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) *
        (((D : ℂ) ^ (z / 2) *
          (∏ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K),
