          Complex.exp (((∑ w : NumberField.InfinitePlace K, (-v_place) w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
          (((c ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            (∏ w : NumberField.InfinitePlace K,
              (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i)) ^ (a_place w)) *
            Real.exp (-Real.pi * c ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
          Complex.exp
            (((-∑ w : NumberField.InfinitePlace K,
                (-v_place) w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I)) =
      (∑' x : {x : R // x ≠ 0 ∧ x ∈ J},
        star (ψ_f (Ideal.Quotient.mk f x.1)) *
          (∏ w : NumberField.InfinitePlace K,
            (star (Φ_emb w (x.1 : K)) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          (((c ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * c ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                v_place w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I)) := by
    intro y
    refine ⟨tsum_congr (fun x => ?_), tsum_congr (fun x => ?_)⟩
    · have hxK : (x.1 : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr x.2.1
      rw [hψ_span x.1 x.2.1]
      have hp := (h_prod (x.1 : K) hxK (fun w => ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i))).1
