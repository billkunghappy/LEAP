    intro P Q hPQ f u_fn
    have h1 : (fun xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ // P xpm} =>
        ψ₀ (u_fn xpm) * (f xpm.1 : ℂ)) =
      (fun xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ // P xpm} =>
        (f xpm.1 : ℂ)) := by
