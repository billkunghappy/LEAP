by
  obtain ⟨c₁₀, hc₁₀_pos, hc₁₀⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c₂₀, hc₂₀_pos, hc₂₀⟩ := mitsui_prime_box_ge_one_to_place_sectors (K := K)
  obtain ⟨c_sec, hc_sec_pos, hc_sec⟩ :=
    mitsui_prime_char_grid_cube_place_sector_bound_of_units_eq_one (K := K) A hA
  obtain ⟨c_cone, hc_cone_pos, hc_cone⟩ :=
    mitsui_prime_char_fundamentalCone_bound_of_units_eq_one (K := K) A hA
