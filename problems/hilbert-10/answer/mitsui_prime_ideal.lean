                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))) := by
        intro x_star
        dsimp only [P_dual]
        rw [h_poly_dual x_star, h_dual_exp_eq x_star, Complex.ofReal_mul, mul_assoc]
      have h_gauss_tsum :
          (∑' x_star : J_σC,
            (star (χ₀ (J_rep C)) *
              (κ_a *
                (((N_f ^ (-1 / 2 : ℝ) : ℝ) : ℂ) *
                  ∑' a : R ⧸ f,
                    ψ_f a *
                      Complex.exp (2 * Real.pi * Complex.I *
                        (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))))) *
              P_dual x_star) =
          ∑' x_star : J_σC,
            (ω_χ * χ₀ (J_rep (σ C))) *
              (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
                (∏ w : NumberField.InfinitePlace K,
                  ((star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) /
                    (w (γ_C C : K) : ℂ)) *
                    ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
                ((((c_C⁻¹ ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
                  Real.exp (-Real.pi * c_C⁻¹ ^ 2 *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ_C C : K)) ^ 2 *
