        have h_ki_le_R : ((k'.1 i : ℕ) : ℝ) + 1 ≤ ((k.1 i : ℕ) : ℝ) := by exact_mod_cast h_ki_le
        have h_mid : δ * (((k'.1 i : ℕ) : ℝ) - (m : ℝ) + 1) ≤
            δ * (((k.1 i : ℕ) : ℝ) - (m : ℝ)) := by
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hδ_pos)
          linarith
