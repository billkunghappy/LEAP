          _ = B_f * (S_f * t) := mul_assoc B_f S_f t
      have ht_cpow : (t : ℂ) ^ z = (B_f : ℂ) ^ z * ((S_f * t : ℝ) : ℂ) ^ z := by
        conv_lhs => rw [ht_eq]
        rw [Complex.ofReal_mul B_f (S_f * t), Complex.mul_cpow_ofReal_nonneg hBf_nn hSt_nn]
      dsimp [G]
      rw [ht_cpow]
      ring
    have h_set_int : (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ z * ((P_f : ℂ) * W₀_c ν_place (S_f * t))) =
        (∫ t in Set.Ioi (0 : ℝ), ((B_f : ℂ) ^ z * (P_f : ℂ)) * G (S_f * t)) :=
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_congr
    rw [h_set_int, MeasureTheory.integral_const_mul, MeasureTheory.integral_comp_mul_left_Ioi G (0 : ℝ) hSf_pos,
