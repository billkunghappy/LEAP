        exact IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr hIq₁)
          (Ideal.isCoprime_iff_sup_eq.mpr hM_cop)
      have hIM_eq : I * M = ⟨Ideal.span ({c} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc_ne)⟩ :=
        Subtype.ext hM_mul
      have hχIM : χ I * χ M = lam_inf c := by
        rw [← map_mul, hIM_eq]
        exact h_triv c hc_ne hc_cop hc_sub
      have hχM_ne : χ M ≠ 0 := by
        have h1 := (hχ_norm_supp₁ M).1 hM_cop
        exact norm_ne_zero_iff.mp (h1.symm ▸ one_ne_zero)
      change g I = χ I
      rw [h_eval I hIf' M c hc_ne hM_cop hM_mul hc_sub, ← hχIM, mul_inv_cancel_right₀ hχM_ne]
    refine ⟨χ', ?_, ?_, hχ'_agree⟩
    · intro I
      refine ⟨?_, ?_⟩
      · intro hIf'
