    congr 1
    have h1 : (β a : K) * (y₁ : K) = ((β a * y₁ : R) : K) := by push_cast; rfl
    have h2 : (β a : K) * (y₂ : K) = ((β a * y₂ : R) : K) := by push_cast; rfl
    rw [h1, h2]
    refine he_B₀_congr (β a * y₁) (β a * y₂) ?_ ?_
    · rw [← mul_sub]
