    have hexp_c1_le : Real.exp (-Real.sqrt u / c₁) ≤ Real.exp (1 / c) * δ ^ 2 :=
      le_trans hexp_c1_le_c hexp_le
    have hexp_negδ_le : Real.exp (-δ) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      linarith
    have hWc1_exp_le : (W * c₁) * Real.exp (-δ) ≤ c * 1 :=
      mul_le_mul hWc₁_le hexp_negδ_le (le_of_lt (Real.exp_pos (-δ))) (le_of_lt hc_pos)
    calc W * |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y|
      _ ≤ W * (c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt u / c₁)) :=
          mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
      _ = (W * c₁) * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt u / c₁) := by ring
      _ ≤ (W * c₁) * (Real.exp (-δ) * Y) * (Real.exp (1 / c) * δ ^ 2) :=
          mul_le_mul_of_nonneg_left hexp_c1_le (by positivity)
      _ = ((W * c₁) * Real.exp (-δ)) * (Real.exp (1 / c) * Y * δ ^ 2) := by ring
      _ ≤ (c * 1) * (Real.exp (1 / c) * Y * δ ^ 2) :=
          mul_le_mul_of_nonneg_right hWc1_exp_le (by positivity)
      _ = (c * Real.exp (1 / c)) * Y * δ ^ 2 := by ring
  have hexp_pos_taylor : Real.exp δ - 1 - δ ≤ δ ^ 2 := by
    have habs : |δ| ≤ 1 := by rw [abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
