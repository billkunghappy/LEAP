      (∑ xpm ∈ Finset.univ.filter (fun xpm : D_log => proj xpm = pm), term_log xpm) =
        term_all_prin pm := by
    have h_sub :
        (∑ xpm ∈ Finset.univ.filter (fun xpm : D_log => proj xpm = pm), term_log xpm) =
          ∑' xpm : {xpm : D_log // proj xpm = pm}, term_log xpm.1 := by
      rw [tsum_fintype]
