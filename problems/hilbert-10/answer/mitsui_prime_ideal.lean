          (2 * Real.pi * Complex.I) * (k : ℂ) := by
        calc (2 * Real.pi * Complex.I) * (Algebra.trace ℚ K ((v : K) * (y : K) / (γ₀ : K)) : ℂ)
          _ = (k : ℂ) * (2 * Real.pi * Complex.I) := hk
          _ = (2 * Real.pi * Complex.I) * (k : ℂ) := mul_comm _ _
      have h_tr_C : (Algebra.trace ℚ K ((v : K) * (y : K) / (γ₀ : K)) : ℂ) = (k : ℂ) :=
