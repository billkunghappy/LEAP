    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀_half : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
