            rw [mul_mul_mul_comm, hM₁_mul, hM₂_mul, Ideal.span_singleton_mul_span_singleton]
          have hc₁₂_sub : c₁ * c₂ - 1 ∈ f' := by
            have h_id : c₁ * c₂ - 1 = (c₁ - 1) * c₂ + (c₂ - 1) := by ring
            rw [h_id]
            exact f'.add_mem (f'.mul_mem_right c₂ hc₁_sub) hc₂_sub
          have hc₁₂_pos : ∀ w : NumberField.InfinitePlace K, w.IsReal →
              0 < (w.embedding ((c₁ * c₂ : NumberField.RingOfIntegers K) : K)).re := by
            intro w hw
            rw [h_re_mul c₁ c₂ w hw]
            exact mul_pos (hc₁_pos w hw) (hc₂_pos w hw)
          rw [h_eval (I₁ * I₂) h₁₂ (M₁ * M₂) (c₁ * c₂) (mul_ne_zero hc₁_ne hc₂_ne)
                hM₁₂_cop hM₁₂_mul hc₁₂_sub hc₁₂_pos,
              h_eval I₁ h₁ M₁ c₁ hc₁_ne hM₁_cop hM₁_mul hc₁_sub hc₁_pos,
              h_eval I₂ h₂ M₂ c₂ hc₂_ne hM₂_cop hM₂_mul hc₂_sub hc₂_pos,
              map_mul, mul_inv_rev, mul_comm]
        · have h₁₂ : ¬ (((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
              Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤) := by
            intro h_top
            change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
              (I₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ f' = ⊤ at h_top
            rw [← Ideal.isCoprime_iff_sup_eq, IsCoprime.mul_left_iff,
              Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_iff_sup_eq] at h_top
            exact h₂ h_top.2
          show (if h : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
              Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow (I₁ * I₂) h).choose)⁻¹ else 0) =
            (if h : (I₁ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow I₁ h).choose)⁻¹ else 0) *
            (if h : (I₂ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow I₂ h).choose)⁻¹ else 0)
          rw [dif_neg h₁₂, dif_neg h₂, mul_zero]
      · have h₁₂ : ¬ (((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤) := by
          intro h_top
          change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
            (I₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ f' = ⊤ at h_top
          rw [← Ideal.isCoprime_iff_sup_eq, IsCoprime.mul_left_iff,
            Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_iff_sup_eq] at h_top
          exact h₁ h_top.1
        show (if h : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow (I₁ * I₂) h).choose)⁻¹ else 0) =
          (if h : (I₁ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow I₁ h).choose)⁻¹ else 0) *
          (if h : (I₂ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (ψ₁ (h_ex_narrow I₂ h).choose)⁻¹ else 0)
        rw [dif_neg h₁₂, dif_neg h₁, zero_mul]
    let ψ' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
      { toFun := g
        map_one' := hg_one
        map_mul' := hg_mul }
    have hψ'_agree : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ψ' I = ψ₁ I := by
      intro I hIq₁
      have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hIq₁) (sup_le_sup_left hq₁f' _))
      obtain ⟨M, c, hc_ne, hM_cop, hM_mul, hc_sub, hc_pos⟩ := h_ex_narrow I hIf'
      have hc_cop : Ideal.span ({c} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ := by
        rw [← hM_mul, ← Ideal.isCoprime_iff_sup_eq]
        exact IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr hIq₁)
          (Ideal.isCoprime_iff_sup_eq.mpr hM_cop)
      have hIM_eq : I * M = ⟨Ideal.span ({c} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc_ne)⟩ :=
        Subtype.ext hM_mul
      have hψIM : ψ₁ I * ψ₁ M = 1 := by
        rw [← map_mul, hIM_eq]
        exact h_triv c hc_ne hc_cop hc_sub hc_pos
      change g I = ψ₁ I
      rw [h_eval I hIf' M c hc_ne hM_cop hM_mul hc_sub hc_pos]
      exact inv_eq_of_mul_eq_one_left hψIM
    refine ⟨ψ', ?_, ?_, ?_, hψ'_agree⟩
    · intro x hx_ne hx_sub hx_pos
      let X : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
        ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
      have hX_cop : (X : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ := by
        change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f' = ⊤
        rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
        refine ⟨x * 1, Ideal.mem_span_singleton.mpr ⟨1, rfl⟩, -(x - 1), f'.neg_mem hx_sub, ?_⟩
        ring
      have h1_cop : ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ := by
        rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
      have hX_mul : (X : Ideal (NumberField.RingOfIntegers K)) *
          ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) =
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) := by
        change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) *
          ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) = _
        rw [Submonoid.coe_one, Ideal.one_eq_top, Ideal.mul_top]
      change g X = 1
      rw [h_eval X hX_cop 1 x hx_ne h1_cop hX_mul hx_sub hx_pos, map_one, inv_one]
    · intro I
      refine ⟨?_, ?_⟩
      · intro hIf'
        change ‖g I‖ = 1
        dsimp [g]
        rw [dif_pos hIf', norm_inv]
        obtain ⟨_, _, hM_cop, _, _, _⟩ := (h_ex_narrow I hIf').choose_spec
        rw [(hψ₁_norm_supp (h_ex_narrow I hIf').choose).1 hM_cop, inv_one]
      · intro hIf'
        change g I = 0
        dsimp [g]
        exact dif_neg hIf'
    · obtain ⟨I₀, hI₀_cop, hI₀_ne⟩ := hψ₁_nonprin
      have hI₀_f' : (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hI₀_cop) (sup_le_sup_left hq₁f' _))
      refine ⟨I₀, hI₀_f', ?_⟩
      rw [hψ'_agree I₀ hI₀_cop]
      exact hI₀_ne
  have h_s4 : ∀ (q₁ f' : Ideal (NumberField.RingOfIntegers K)),
      q₁ ≠ 0 → q₁ ≤ f' → f' ≠ q₁ → f' ≠ 0 ∧ Ideal.absNorm f' < Ideal.absNorm q₁ := by
    intro q₁ f' hq₁ hq₁f' hne
    obtain ⟨c', hc'⟩ := Ideal.dvd_iff_le.mpr hq₁f'
    have hf'_ne : f' ≠ 0 := left_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne : c' ≠ 0 := right_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne_top : c' ≠ ⊤ := by
      intro htop
      rw [htop, Ideal.mul_top] at hc'
      exact hne hc'.symm
    have hf'_norm_ne_zero : Ideal.absNorm f' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf'_ne
    have hc'_norm_ne_zero : Ideal.absNorm c' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hc'_ne
    have hc'_norm_ne_one : Ideal.absNorm c' ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr hc'_ne_top
    refine ⟨hf'_ne, ?_⟩
    rw [hc', map_mul]
    exact lt_mul_of_one_lt_right (Nat.pos_of_ne_zero hf'_norm_ne_zero) (by omega)
  have h_ind : ∀ (m : ℕ) (q₁ : Ideal (NumberField.RingOfIntegers K)) (hq₁ : q₁ ≠ 0),
      Ideal.absNorm q₁ = m →
      ∀ (ψ₁ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ q₁ →
          (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
          ψ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ‖ψ₁ I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤) → ψ₁ I = 0)) →
        (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧ ψ₁ I₀ ≠ 1) →
        ∃ (f : Ideal (NumberField.RingOfIntegers K))
          (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
          q₁ ≤ f ∧
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ f →
            (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
            ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0)) ∧
          (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ ψ₀ I₀ ≠ 1) ∧
          (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
            ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
              Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
              x - 1 ∈ f' ∧
              (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
              ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ψ₁ I = ψ₀ I) := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro q₁ hq₁ hm ψ₁ hψ₁_narrow hψ₁_norm_supp hψ₁_nonprin
    by_cases h_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), q₁ ≤ f' → f' ≠ q₁ →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧
          x - 1 ∈ f' ∧
          (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
          ψ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1
    · exact ⟨q₁, ψ₁, le_rfl, hψ₁_narrow, hψ₁_norm_supp, hψ₁_nonprin, h_prim, fun _ _ => rfl⟩
    · push_neg at h_prim
      rcases h_prim with ⟨f', hq₁f', hf'_ne, h_triv⟩
      obtain ⟨hf'_ne_zero, h_norm_lt⟩ := h_s4 q₁ f' hq₁ hq₁f' hf'_ne
      obtain ⟨ψ', hψ'_narrow, hψ'_norm_supp, hψ'_nonprin, hψ'_eq⟩ :=
        h_extend q₁ f' hq₁ hq₁f' ψ₁ hψ₁_norm_supp hψ₁_nonprin h_triv
      rw [hm] at h_norm_lt
      obtain ⟨f, ψ₀, hf'f, hψ₀_narrow, hψ₀_norm_supp, hψ₀_nonprin, hψ₀_prim, hψ₀_eq⟩ :=
        ih (Ideal.absNorm f') h_norm_lt f' hf'_ne_zero rfl ψ' hψ'_narrow hψ'_norm_supp hψ'_nonprin
      refine ⟨f, ψ₀, le_trans hq₁f' hf'f, hψ₀_narrow, hψ₀_norm_supp, hψ₀_nonprin, hψ₀_prim, ?_⟩
      intro I hIq₁
      have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hIq₁) (sup_le_sup_left hq₁f' _))
      rw [← hψ'_eq I hIq₁, hψ₀_eq I hIf']
  exact h_ind (Ideal.absNorm b) b hb rfl ψ hψ_narrow hψ_norm_supp hψ_nonprin

theorem mitsui_narrow_stripped_tsum_eq_sum_classGroup_principal_subideals {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (a_place : NumberField.InfinitePlace K → ℕ) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)
    let U_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)
    let J_maj : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ, U_K y * Real.exp (-a * Q_K y)
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    ∃ J_rep : ClassGroup R → nonZeroDivisors (Ideal R),
      (∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹) ∧
      (∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤) ∧
      ∀ (ψ : nonZeroDivisors (Ideal R) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal R),
          ((I : Ideal R) ⊔ f = ⊤ → ‖ψ I‖ = 1) ∧
          (¬ ((I : Ideal R) ⊔ f = ⊤) → ψ I = 0)) →
        ∀ v ∈ Set.Ioi (0 : ℝ),
          (∑' m : ℕ,
            (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
              ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (((((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^
                (∑ w : NumberField.InfinitePlace K, a_place w) *
              J_maj (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ))) : ℝ) : ℂ))) =
          ∑ C : ClassGroup R,
            star (ψ (J_rep C)) *
              (∑' m : ℕ,
                (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                      Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
                  ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
                ((((((S_f * v / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
                    (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (1 / (n : ℝ))) ^
                    (∑ w : NumberField.InfinitePlace K, a_place w) *
                  J_maj (Real.pi * ((S_f * v / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
                    (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℝ) : ℂ))) :=
by
  classical
  intro R n Q_K U_K J_maj S_f
  
  have h_comp : ∀ I : nonZeroDivisors (Ideal R),
      ∃ (M₀ : nonZeroDivisors (Ideal R)) (c₀ : R),
        c₀ ≠ 0 ∧
        (M₀ : Ideal R) ⊔ f = ⊤ ∧
        (I : Ideal R) * (M₀ : Ideal R) = Ideal.span ({c₀} : Set R) := by
    intro I
    have hI : (I : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero I
    by_cases hI_top : (I : Ideal R) = ⊤
    · refine ⟨1, 1, one_ne_zero, ?_, ?_⟩
      · rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
      · rw [Submonoid.coe_one, Ideal.one_eq_top, hI_top, Ideal.mul_top, Ideal.span_singleton_one]
    · set J₀ : Ideal R := (I : Ideal R) * ((I : Ideal R) * f)
      have hJ₀_ne : J₀ ≠ 0 := mul_ne_zero hI (mul_ne_zero hI hf)
      obtain ⟨c₀, hc₀_sup⟩ := IsDedekindDomain.exists_sup_span_eq Ideal.mul_le_right hJ₀_ne
      have hc₀_ne : c₀ ≠ 0 := by
        intro hc₀_zero
        rw [hc₀_zero, Ideal.span_singleton_zero, sup_bot_eq] at hc₀_sup
        have h_eq : (I : Ideal R) * ((I : Ideal R) * f) = (I : Ideal R) * ⊤ := by
          rw [Ideal.mul_top]
          exact hc₀_sup
        have hIf_top : (I : Ideal R) * f = ⊤ := mul_left_cancel₀ hI h_eq
        have hI_ge_top : ⊤ ≤ (I : Ideal R) := hIf_top ▸ Ideal.mul_le_right
        exact hI_top (top_le_iff.mp hI_ge_top)
      have hc₀_le : Ideal.span ({c₀} : Set R) ≤ (I : Ideal R) :=
        le_sup_right.trans hc₀_sup.le
      obtain ⟨M₁, hM₁_mul⟩ := Ideal.dvd_iff_le.mpr hc₀_le
      have hspan_ne : Ideal.span ({c₀} : Set R) ≠ 0 :=
        Ideal.span_singleton_eq_bot.not.mpr hc₀_ne
      have hM₁_ne : M₁ ≠ 0 := right_ne_zero_of_mul (hM₁_mul ▸ hspan_ne)
      have h_mul_sup : (I : Ideal R) * (((I : Ideal R) * f) ⊔ M₁) = (I : Ideal R) * ⊤ := by
        rw [Ideal.mul_sup, ← hM₁_mul, Ideal.mul_top]
        exact hc₀_sup
      have hIf_sup : ((I : Ideal R) * f) ⊔ M₁ = ⊤ := mul_left_cancel₀ hI h_mul_sup
      have hM₁_cop : M₁ ⊔ f = ⊤ := by
        rw [sup_comm, eq_top_iff, ← hIf_sup]
        exact sup_le_sup_right Ideal.mul_le_left M₁
      exact ⟨⟨M₁, mem_nonZeroDivisors_of_ne_zero hM₁_ne⟩, c₀, hc₀_ne, hM₁_cop, hM₁_mul.symm⟩
  let I_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => (ClassGroup.mk0_surjective C).choose
  have hI_C : ∀ C : ClassGroup R, ClassGroup.mk0 (I_C C) = C :=
    fun C => (ClassGroup.mk0_surjective C).choose_spec
  let J_rep : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => (h_comp (I_C C)).choose
  have hJ_cls : ∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹ := by
    intro C
    obtain ⟨c₀, _, _, h_mul⟩ := (h_comp (I_C C)).choose_spec
    have h_prin : ((I_C C * J_rep C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal := by
      change ((I_C C : Ideal R) * (J_rep C : Ideal R)).IsPrincipal
      rw [h_mul]
      exact ⟨⟨c₀, rfl⟩⟩
    have h_mk0_one : ClassGroup.mk0 (I_C C * J_rep C) = 1 :=
      (ClassGroup.mk0_eq_one_iff (I_C C * J_rep C).2).mpr h_prin
    rw [map_mul, hI_C C] at h_mk0_one
    exact eq_inv_of_mul_eq_one_right h_mk0_one
  have hJ_cop : ∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤ := by
    intro C
    exact (h_comp (I_C C)).choose_spec.choose_spec.2.1
  refine ⟨J_rep, hJ_cls, hJ_cop, ?_⟩
  intro ψ hψ v hv
