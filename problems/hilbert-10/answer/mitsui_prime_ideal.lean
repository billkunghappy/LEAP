      have hz_eq_one : z = 1 := (sub_eq_zero.mp h_zero).symm
      have hz_norm_one : ‖z‖ = 1 := by rw [hz_eq_one, norm_one]
      have h_cpow_norm : ‖(Ideal.absNorm p.asIdeal : ℂ) ^ (-(τ : ℂ))‖ =
