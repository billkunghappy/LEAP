        subst huv_eq
        congr 1
        exact Prod.ext (Subtype.ext hpm_val_eq) (Subtype.ext hJ_val_eq)
      · intro x hx
        rcases x with ⟨I, P, m⟩
        dsimp [G, f_I] at hx
        rw [Finset.mem_sigma, Finset.mem_sigma] at hx
        rcases hx with ⟨_, hP_mem, hm_mem⟩
        rw [Multiset.mem_toFinset] at hP_mem
        rw [Finset.mem_Icc] at hm_mem
        have hI_ne : I.1 ≠ ⊥ := I.2.1
        have hP_info := (Ideal.mem_normalizedFactors_iff hI_ne).mp hP_mem
        have hP_ne : P ≠ ⊥ := by
          intro hbot
          rw [hbot, le_bot_iff] at hP_info
          exact hI_ne hP_info.2
        let p : IsDedekindDomain.HeightOneSpectrum R := ⟨P, hP_info.1, hP_ne⟩
        have hdvd : p.asIdeal ^ m ∣ I.1 :=
          (h_pow_dvd_iff I.1 hI_ne p m).mpr hm_mem.2
        rcases hdvd with ⟨J_val, hJ_mul⟩
        have hJ_ne : J_val ≠ ⊥ := right_ne_zero_of_mul (by rw [← hJ_mul]; exact hI_ne)
        let d : ℕ := Ideal.absNorm p.asIdeal ^ m
        let e : ℕ := Ideal.absNorm J_val
        have hde : d * e = n := by
          dsimp [d, e]
          rw [← map_pow, ← map_mul, ← hJ_mul, I.2.2]
        let uv : ℕ × ℕ := (d, e)
        let pm : F d := ⟨(p, m), ⟨hm_mem.1, rfl⟩⟩
        let J : S' e := ⟨J_val, ⟨hJ_ne, rfl⟩⟩
        refine ⟨⟨uv, (pm, J)⟩, ?_, ?_⟩
        · dsimp [H]
          rw [Finset.mem_sigma]
          refine ⟨Nat.mem_divisorsAntidiagonal.mpr ⟨hde, hn⟩,
            Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩⟩
        · refine Sigma.ext (Subtype.ext hJ_mul.symm) ?_
          exact heq_of_eq rfl
      · intro y _
        dsimp
        rw [mul_right_comm, mul_comm]
        congr 1
        rw [← map_pow, ← map_mul]
        exact congrArg χ (Subtype.ext rfl)
  have hm_χ_sum : LSeriesSummable m_χ s := by
    refine Summable.of_norm_bounded ha_sum.norm (fun n => ?_)
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact hm_χ_bound n
  have hL_mul_one : LSeries a_χ s * LSeries m_χ s = 1 := by
    rw [← LSeries_convolution' ha_χ_sum hm_χ_sum, hm_conv, LSeries_delta, Pi.one_apply]
  have hL_ne : LSeries a_χ s ≠ 0 := left_ne_zero_of_mul_eq_one hL_mul_one
  refine ⟨hL_ne, ?_⟩
  have h_abscissa : LSeries.abscissaOfAbsConv a_χ ≤ ((1 : ℝ) : EReal) := by
    refine LSeries.abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun y hy => ?_)
    exact ha_χ_summable_all (y : ℂ) (by simpa using hy)
  have hs_abs : LSeries.abscissaOfAbsConv a_χ < (s.re : EReal) :=
    lt_of_le_of_lt h_abscissa (EReal.coe_lt_coe_iff.mpr hs)
  have h_deriv : deriv (LSeries a_χ) s = -LSeries (LSeries.logMul a_χ) s :=
    LSeries_deriv hs_abs
  have h_mul : LSeries Λ_χ s * LSeries a_χ s = -deriv (LSeries a_χ) s := by
    rw [h_deriv, ← LSeries_convolution' hΛ_χ_sum ha_χ_sum, h_conv_eq, neg_neg]
  exact (eq_div_iff hL_ne).mpr h_mul

theorem mitsui_ray_char_LSeries_norm_le_of_one_lt_re {K : Type u} [Field K] [NumberField K] :
    ∃ M₀ : ℝ, 0 < M₀ ∧
      ∀ (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1) →
        ∀ (s : ℂ) (σ₀ : ℝ), 1 < σ₀ → σ₀ ≤ 2 → σ₀ ≤ s.re →
          ‖LSeries (fun n =>
            ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s‖ ≤
            M₀ / (σ₀ - 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let F : ℕ → Type _ := fun d =>
    {pm : IsDedekindDomain.HeightOneSpectrum R × ℕ //
      1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = d}
  have h_s1_s2 : ∀ (χ : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R), ‖χ I‖ ≤ 1) →
      ∀ n : ℕ,
        ‖∑' pm : F n,
            (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)‖ ≤
          (Module.finrank ℚ K : ℝ) * ArithmeticFunction.vonMangoldt n := by
    have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum R,
        2 ≤ Ideal.absNorm p.asIdeal := by
      intro p
      have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
      omega
    intro χ hχ_norm n
    have hF_fin : Finite (F n) := by
      let S_le := {J : Ideal R // Ideal.absNorm J ≤ n}
      haveI : Finite S_le := Ideal.finite_setOf_absNorm_le n
      have h_bounds : ∀ pm : F n, Ideal.absNorm pm.1.1.asIdeal ≤ n ∧ pm.1.2 < n + 1 := by
        intro pm
        have hm : 1 ≤ pm.1.2 := pm.2.1
        have hd : Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 = n := pm.2.2
        have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_norm_ge_two pm.1.1
        have hk_pow : Ideal.absNorm pm.1.1.asIdeal ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 :=
          Nat.le_self_pow (by omega) _
        have hk_le : Ideal.absNorm pm.1.1.asIdeal ≤ n := by omega
        have hm_lt : pm.1.2 < n + 1 := by
          have h1 : pm.1.2 < 2 ^ pm.1.2 := Nat.lt_two_pow_self
          have h2 : 2 ^ pm.1.2 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := Nat.pow_le_pow_left hk2 _
          omega
        exact ⟨hk_le, hm_lt⟩
      let ψ : F n → S_le × Fin (n + 1) := fun pm =>
        (⟨pm.1.1.asIdeal, (h_bounds pm).1⟩, ⟨pm.1.2, (h_bounds pm).2⟩)
      have hψ_inj : Function.Injective ψ := by
        intro a b hab
        have h1 : a.1.1.asIdeal = b.1.1.asIdeal := congrArg (fun x : S_le => x.1) (Prod.ext_iff.mp hab).1
        have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
        exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
      exact Finite.of_injective ψ hψ_inj
    letI : Fintype (F n) := Fintype.ofFinite (F n)
    have h_s1 : ‖∑' pm : F n,
        (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
          (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)‖ ≤
        ∑ pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
      rw [tsum_fintype]
      refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun pm _ => ?_))
      rw [norm_mul, norm_pow]
      have h_chi : ‖χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩‖ ^ pm.1.2 ≤ 1 :=
        pow_le_one₀ (norm_nonneg _) (hχ_norm _)
      have h_log_nn : 0 ≤ Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
        apply Real.log_nonneg
        have := h_norm_ge_two pm.1.1
        exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal)
      rw [Complex.norm_of_nonneg h_log_nn]
      exact mul_le_of_le_one_left h_log_nn h_chi
    refine le_trans h_s1 ?_
    by_cases hF : Nonempty (F n)
    · rcases hF with ⟨pm₀⟩
      let p_of : F n → ℕ := fun pm => Ideal.absNorm (Ideal.under ℤ pm.1.1.asIdeal)
      have hp_info : ∀ pm : F n,
          Nat.Prime (p_of pm) ∧
          (∃ f : ℕ, f ≠ 0 ∧ Ideal.absNorm pm.1.1.asIdeal = (p_of pm) ^ f) ∧
          ArithmeticFunction.vonMangoldt n = Real.log (p_of pm : ℝ) := by
        intro pm
        set P : Ideal R := pm.1.1.asIdeal
        haveI : P.IsPrime := pm.1.1.isPrime
        haveI : NeZero P := ⟨pm.1.1.ne_bot⟩
        have hp : Nat.Prime (p_of pm) := Nat.absNorm_under_prime P
        haveI : P.LiesOver (Ideal.span {(p_of pm : ℤ)}) := Int.liesOver_span_absNorm P
        set f : ℕ := (Ideal.span {(p_of pm : ℤ)}).inertiaDeg P
        have h_abs : Ideal.absNorm P = (p_of pm) ^ f := Ideal.absNorm_eq_pow_inertiaDeg' P hp
        have hf_ne : f ≠ 0 := by
          intro hf0
          have h1 : Ideal.absNorm P = 1 := by rw [h_abs, hf0, pow_zero]
          have h2 : 2 ≤ Ideal.absNorm P := h_norm_ge_two pm.1.1
          omega
        have hm_ne : pm.1.2 ≠ 0 := by
          have := pm.2.1
          omega
        have h_vm : ArithmeticFunction.vonMangoldt n = Real.log (p_of pm : ℝ) := by
          rw [← pm.2.2, ArithmeticFunction.vonMangoldt_apply_pow hm_ne,
            h_abs, ArithmeticFunction.vonMangoldt_apply_pow hf_ne,
            ArithmeticFunction.vonMangoldt_apply_prime hp]
        exact ⟨hp, ⟨f, hf_ne, h_abs⟩, h_vm⟩
      set p₀ : ℕ := p_of pm₀
      have hp₀ : Nat.Prime p₀ := (hp_info pm₀).1
      have h_vm_n : ArithmeticFunction.vonMangoldt n = Real.log (p₀ : ℝ) := (hp_info pm₀).2.2
      have hp_eq : ∀ pm : F n, p_of pm = p₀ := by
        intro pm
        have h_log_eq : Real.log (p_of pm : ℝ) = Real.log (p₀ : ℝ) := by
          rw [← (hp_info pm).2.2, h_vm_n]
        have h1 : (0 : ℝ) < (p_of pm : ℝ) := by exact_mod_cast (hp_info pm).1.pos
        have h2 : (0 : ℝ) < (p₀ : ℝ) := by exact_mod_cast hp₀.pos
        have h_real_eq : (p_of pm : ℝ) = (p₀ : ℝ) := Real.log_injOn_pos h1 h2 h_log_eq
        exact_mod_cast h_real_eq
      let I_p₀ : Ideal R := Ideal.span {(p₀ : R)}
      have hp₀_ne_zero_R : (p₀ : R) ≠ 0 := Nat.cast_ne_zero.mpr hp₀.ne_zero
      have hI_ne_bot : I_p₀ ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hp₀_ne_zero_R
      let M : Multiset (Ideal R) := UniqueFactorizationMonoid.normalizedFactors I_p₀
      have h_mem_M : ∀ pm : F n, pm.1.1.asIdeal ∈ M.toFinset := by
        intro pm
        rw [Multiset.mem_toFinset, Ideal.mem_normalizedFactors_iff hI_ne_bot]
        refine ⟨pm.1.1.isPrime, ?_⟩
        rw [Ideal.span_singleton_le_iff_mem]
        rcases (hp_info pm).2.1 with ⟨f, _, h_abs⟩
        rw [hp_eq pm] at h_abs
        have h_mem_abs : (Ideal.absNorm pm.1.1.asIdeal : R) ∈ pm.1.1.asIdeal :=
          Ideal.absNorm_mem pm.1.1.asIdeal
        rw [h_abs, Nat.cast_pow] at h_mem_abs
        exact pm.1.1.isPrime.mem_of_pow_mem f h_mem_abs
      let g_map : F n → Ideal R := fun pm => pm.1.1.asIdeal
      have hg_inj : Function.Injective g_map := by
        intro a b hab
        have h_id : a.1.1 = b.1.1 := IsDedekindDomain.HeightOneSpectrum.ext hab
        have hk2 : 2 ≤ Ideal.absNorm a.1.1.asIdeal := h_norm_ge_two a.1.1
        have h_pow : Ideal.absNorm a.1.1.asIdeal ^ a.1.2 = Ideal.absNorm a.1.1.asIdeal ^ b.1.2 := by
          calc Ideal.absNorm a.1.1.asIdeal ^ a.1.2
              = n := a.2.2
            _ = Ideal.absNorm b.1.1.asIdeal ^ b.1.2 := b.2.2.symm
            _ = Ideal.absNorm a.1.1.asIdeal ^ b.1.2 := by rw [show b.1.1.asIdeal = a.1.1.asIdeal from hab.symm]
        have hm_eq : a.1.2 = b.1.2 := Nat.pow_right_injective hk2 h_pow
        exact Subtype.ext (Prod.ext h_id hm_eq)
      have h_sum_image : (∑ pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal)) =
          ∑ P ∈ Finset.univ.image g_map, Real.log (Ideal.absNorm P) := by
        symm
        exact Finset.sum_image (f := fun P : Ideal R => Real.log (Ideal.absNorm P))
          (fun a _ b _ h => hg_inj h)
      have h_sub_M : Finset.univ.image g_map ⊆ M.toFinset := by
        intro P hP
        rcases Finset.mem_image.mp hP with ⟨pm, _, rfl⟩
        exact h_mem_M pm
      have h_log_P_nonneg : ∀ P ∈ M.toFinset, 0 ≤ Real.log (Ideal.absNorm P) := by
        intro P hP
        rw [Multiset.mem_toFinset] at hP
        have hP_info := (Ideal.mem_normalizedFactors_iff hI_ne_bot).mp hP
        have hP_ne : P ≠ ⊥ := by
          intro hbot
          rw [hbot, le_bot_iff] at hP_info
          exact hI_ne_bot hP_info.2
        have hP_norm : 1 ≤ Ideal.absNorm P :=
          Nat.one_le_iff_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hP_ne)
        exact Real.log_nonneg (by exact_mod_cast hP_norm)
      have h_le_toFinset : (∑ P ∈ Finset.univ.image g_map, Real.log (Ideal.absNorm P)) ≤
          ∑ P ∈ M.toFinset, Real.log (Ideal.absNorm P) :=
        Finset.sum_le_sum_of_subset_of_nonneg h_sub_M (fun P hP _ => h_log_P_nonneg P hP)
      have h_le_multiset : (∑ P ∈ M.toFinset, Real.log (Ideal.absNorm P)) ≤
          (M.map (fun P : Ideal R => Real.log (Ideal.absNorm P))).sum := by
        rw [Finset.sum_multiset_map_count]
        refine Finset.sum_le_sum (fun P hP => ?_)
        have h_cnt : 1 ≤ Multiset.count P M := Multiset.count_pos.mpr (Multiset.mem_toFinset.mp hP)
        have h_nn := h_log_P_nonneg P hP
        rw [nsmul_eq_mul]
        exact le_mul_of_one_le_left h_nn (by exact_mod_cast h_cnt)
      have h_multiset_eq : (M.map (fun P : Ideal R => Real.log (Ideal.absNorm P))).sum =
          Real.log (Ideal.absNorm I_p₀) := by
        have h_map : M.map (fun P : Ideal R => Real.log (Ideal.absNorm P)) =
            (M.map (fun P : Ideal R => (Ideal.absNorm P : ℝ))).map Real.log := by
          rw [Multiset.map_map]; rfl
        rw [h_map, ← Real.log_multiset_prod]
        · congr 1
          let φ : Ideal R →* ℝ := (Nat.castRingHom ℝ).toMonoidHom.comp Ideal.absNorm.toMonoidHom
          have h_hom : M.map (fun P : Ideal R => (Ideal.absNorm P : ℝ)) = M.map φ := rfl
          rw [h_hom, Multiset.prod_hom M φ]
          dsimp [φ, M]
          rw [prod_normalizedFactors_eq_self hI_ne_bot]
        · intro r hr
          rw [Multiset.mem_map] at hr
          rcases hr with ⟨P, hP, rfl⟩
          have hP_info := (Ideal.mem_normalizedFactors_iff hI_ne_bot).mp hP
          have hP_ne : P ≠ ⊥ := by
            intro hbot
            rw [hbot, le_bot_iff] at hP_info
            exact hI_ne_bot hP_info.2
          have hP_norm : Ideal.absNorm P ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hP_ne
          exact_mod_cast hP_norm
      have h_absNorm_Ip₀ : Ideal.absNorm I_p₀ = p₀ ^ (Module.finrank ℚ K) := by
        dsimp [I_p₀]
        rw [Ideal.absNorm_span_singleton]
        have h_alg : (p₀ : R) = algebraMap ℤ R (p₀ : ℤ) := (map_natCast (algebraMap ℤ R) p₀).symm
        rw [h_alg, Algebra.norm_algebraMap_of_basis (Module.Free.chooseBasis ℤ R),
          ← Module.finrank_eq_card_chooseBasisIndex, NumberField.RingOfIntegers.rank K,
          Int.natAbs_pow, Int.natAbs_natCast]
      have h_log_Ip₀ : Real.log (Ideal.absNorm I_p₀) =
          (Module.finrank ℚ K : ℝ) * ArithmeticFunction.vonMangoldt n := by
        rw [h_absNorm_Ip₀, Nat.cast_pow, Real.log_pow, h_vm_n]
      calc ∑ pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal)
          = ∑ P ∈ Finset.univ.image g_map, Real.log (Ideal.absNorm P) := h_sum_image
        _ ≤ ∑ P ∈ M.toFinset, Real.log (Ideal.absNorm P) := h_le_toFinset
        _ ≤ (M.map (fun P : Ideal R => Real.log (Ideal.absNorm P))).sum := h_le_multiset
        _ = Real.log (Ideal.absNorm I_p₀) := h_multiset_eq
        _ = (Module.finrank ℚ K : ℝ) * ArithmeticFunction.vonMangoldt n := h_log_Ip₀
    · haveI : IsEmpty (F n) := not_nonempty_iff.mp hF
      simp only [Finset.univ_eq_empty, Finset.sum_empty]
      exact mul_nonneg (Nat.cast_nonneg _) ArithmeticFunction.vonMangoldt_nonneg
  let d : ℝ := (Module.finrank ℚ K : ℝ)
  have hd_pos : 0 < d := by
    dsimp [d]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hd_nonneg : 0 ≤ d := le_of_lt hd_pos
  let C_Q : ℝ := 2 * (Real.log 4 + 4)
  have hlog4_pos : 0 < Real.log 4 := Real.log_pos (by norm_num : (1 : ℝ) < 4)
  have hCQ_pos : 0 < C_Q := by dsimp [C_Q]; linarith
  let M₀ : ℝ := d * C_Q
  have hM₀_pos : 0 < M₀ := mul_pos hd_pos hCQ_pos
  refine ⟨M₀, hM₀_pos, ?_⟩
  intro χ hχ_norm s σ₀ hσ₀_gt_one hσ₀_le_two hσ₀_le_re
  let f : ℕ → ℂ := fun n =>
    ∑' pm : F n,
      (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  let f_vm : ℕ → ℂ := fun n => (ArithmeticFunction.vonMangoldt n : ℂ)
  let g : ℕ → ℝ := fun n => d * ArithmeticFunction.vonMangoldt n
  have hg_nonneg : ∀ n : ℕ, 0 ≤ g n :=
    fun _ => mul_nonneg hd_nonneg ArithmeticFunction.vonMangoldt_nonneg
  have hfg_le : ∀ n : ℕ, ‖f n‖ ≤ g n := h_s1_s2 χ hχ_norm
  have hσ₀_re : 1 < (σ₀ : ℂ).re := by simpa using hσ₀_gt_one
  have h_vm_sum : LSeriesSummable f_vm (σ₀ : ℂ) :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt hσ₀_re
  have hg_eq_smul : (fun n => (g n : ℂ)) = (d : ℂ) • f_vm := by
    ext n
    simp [g, f_vm, Complex.ofReal_mul]
  have hg_sum : LSeriesSummable (fun n => (g n : ℂ)) (σ₀ : ℂ) := by
    rw [hg_eq_smul]
    exact h_vm_sum.smul (d : ℂ)
  have h_term_le : ∀ n : ℕ,
      ‖LSeries.term f s n‖ ≤ ‖LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n‖ := by
    intro n
    have h1 : ‖LSeries.term f s n‖ ≤ ‖LSeries.term (fun k => (g k : ℂ)) s n‖ := by
      by_cases hn : n = 0
      · subst hn; simp [LSeries.term]
      · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn,
          Complex.norm_of_nonneg (hg_nonneg n)]
        exact div_le_div_of_nonneg_right (hfg_le n) (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
    have h2 : ‖LSeries.term (fun k => (g k : ℂ)) s n‖ ≤
        ‖LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n‖ :=
      LSeries.norm_term_le_of_re_le_re (fun k => (g k : ℂ)) (by simpa using hσ₀_le_re) n
    exact le_trans h1 h2
  have hf_sum : Summable (LSeries.term f s) :=
    Summable.of_norm_bounded hg_sum.norm h_term_le
  have h_term_re : ∀ n : ℕ,
      ‖LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n‖ =
        (LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n).re := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, if_neg hn, LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : (n : ℂ) ^ (σ₀ : ℂ) = (((n : ℝ) ^ σ₀ : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg]
      rw [h_cpow, ← Complex.ofReal_div, Complex.ofReal_re, Complex.norm_of_nonneg (hg_nonneg n),
        Complex.ofReal_re]
  have h_s3 : ‖LSeries f s‖ ≤ d * ‖LSeries f_vm (σ₀ : ℂ)‖ := by
    have h_le : ‖LSeries f s‖ ≤ ‖LSeries (fun n => (g n : ℂ)) (σ₀ : ℂ)‖ := by
      calc ‖LSeries f s‖
          ≤ ∑' n : ℕ, ‖LSeries.term f s n‖ := norm_tsum_le_tsum_norm hf_sum.norm
        _ ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n‖ :=
            hf_sum.norm.tsum_le_tsum h_term_le hg_sum.norm
        _ = ∑' n : ℕ, (LSeries.term (fun k => (g k : ℂ)) (σ₀ : ℂ) n).re := by
            congr 1; ext n; exact h_term_re n
        _ = (LSeries (fun n => (g n : ℂ)) (σ₀ : ℂ)).re :=
            (Complex.re_tsum hg_sum).symm
        _ ≤ ‖LSeries (fun n => (g n : ℂ)) (σ₀ : ℂ)‖ :=
            le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
    rw [hg_eq_smul, LSeries_smul, norm_mul, Complex.norm_of_nonneg hd_nonneg] at h_le
    exact h_le
  have h_psi_bound : ∀ t : ℝ, 0 ≤ t →
      (∑ k ∈ Finset.Icc 1 ⌊t⌋₊, ArithmeticFunction.vonMangoldt k) ≤ (Real.log 4 + 4) * t := by
    intro t ht
    have h_sub : Finset.Icc 1 ⌊t⌋₊ ⊆ Finset.Icc 0 ⌊t⌋₊ :=
      Finset.Icc_subset_Icc_left (Nat.zero_le 1)
    have h1 : (∑ k ∈ Finset.Icc 1 ⌊t⌋₊, ArithmeticFunction.vonMangoldt k) ≤ Chebyshev.psi t := by
      rw [Chebyshev.psi_eq_sum_Icc]
      exact Finset.sum_le_sum_of_subset_of_nonneg h_sub (fun _ _ _ => ArithmeticFunction.vonMangoldt_nonneg)
    exact le_trans h1 (Chebyshev.psi_le_const_mul_self ht)
  have h_bigO : (fun n : ℕ => ∑ k ∈ Finset.Icc 1 n, ‖f_vm k‖) =O[Filter.atTop]
      (fun n : ℕ => (n : ℝ) ^ (1 : ℝ)) := by
    refine Asymptotics.IsBigO.of_bound (Real.log 4 + 4) ?_
    refine Filter.Eventually.of_forall (fun n => ?_)
    have h_eq : (∑ k ∈ Finset.Icc 1 n, ‖f_vm k‖) =
        ∑ k ∈ Finset.Icc 1 ⌊(n : ℝ)⌋₊, ArithmeticFunction.vonMangoldt k := by
      rw [Nat.floor_natCast]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      dsimp [f_vm]
      exact Complex.norm_of_nonneg ArithmeticFunction.vonMangoldt_nonneg
    have h_sum_nn : 0 ≤ ∑ k ∈ Finset.Icc 1 n, ‖f_vm k‖ :=
      Finset.sum_nonneg (fun _ _ => norm_nonneg _)
    have h_rpow_nn : 0 ≤ (n : ℝ) ^ (1 : ℝ) := by positivity
    rw [Real.norm_of_nonneg h_sum_nn, Real.norm_of_nonneg h_rpow_nn, Real.rpow_one, h_eq]
    exact h_psi_bound (n : ℝ) (Nat.cast_nonneg n)
  have h_abel := LSeries_eq_mul_integral' f_vm zero_le_one hσ₀_re h_bigO
  have hσ₀_nonneg : 0 ≤ σ₀ := by linarith
  have h_norm_abel : ‖LSeries f_vm (σ₀ : ℂ)‖ ≤
      σ₀ * ∫ t : ℝ in Set.Ioi 1,
        ‖(∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k) * (t : ℂ) ^ (-((σ₀ : ℂ) + 1))‖ := by
    rw [h_abel, norm_mul, Complex.norm_of_nonneg hσ₀_nonneg]
    exact mul_le_mul_of_nonneg_left (MeasureTheory.norm_integral_le_integral_norm _) hσ₀_nonneg
  have h_int_bound : (∫ t : ℝ in Set.Ioi 1,
      ‖(∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k) * (t : ℂ) ^ (-((σ₀ : ℂ) + 1))‖) ≤
      (Real.log 4 + 4) / (σ₀ - 1) := by
    have h_int_rpow : MeasureTheory.IntegrableOn (fun t : ℝ => (Real.log 4 + 4) * t ^ (-σ₀))
        (Set.Ioi 1) MeasureTheory.volume :=
      (integrableOn_Ioi_rpow_of_lt (by linarith : -σ₀ < -1) zero_lt_one).const_mul (Real.log 4 + 4)
    have h_ae : (fun t : ℝ => ‖(∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k) * (t : ℂ) ^ (-((σ₀ : ℂ) + 1))‖) ≤ᵐ[MeasureTheory.volume.restrict (Set.Ioi 1)]
        (fun t : ℝ => (Real.log 4 + 4) * t ^ (-σ₀)) := by
      refine MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioi (fun t ht => ?_)
      have ht_gt_one : 1 < t := ht
      have ht_pos : 0 < t := lt_trans zero_lt_one ht_gt_one
      have ht_nn : 0 ≤ t := le_of_lt ht_pos
      dsimp only
      rw [norm_mul]
      have h_sum_cast : (∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k) =
          ((∑ k ∈ Finset.Icc 1 ⌊t⌋₊, ArithmeticFunction.vonMangoldt k : ℝ) : ℂ) := by
        push_cast; rfl
      have h_sum_nn : 0 ≤ ∑ k ∈ Finset.Icc 1 ⌊t⌋₊, ArithmeticFunction.vonMangoldt k :=
        Finset.sum_nonneg (fun _ _ => ArithmeticFunction.vonMangoldt_nonneg)
      have h_norm_sum : ‖∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k‖ ≤ (Real.log 4 + 4) * t := by
        rw [h_sum_cast, Complex.norm_of_nonneg h_sum_nn]
        exact h_psi_bound t ht_nn
      have h_norm_cpow : ‖(t : ℂ) ^ (-((σ₀ : ℂ) + 1))‖ = t ^ (-(σ₀ + 1)) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos ht_pos]
        simp
      rw [h_norm_cpow]
      calc ‖∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k‖ * t ^ (-(σ₀ + 1))
          ≤ ((Real.log 4 + 4) * t) * t ^ (-(σ₀ + 1)) :=
            mul_le_mul_of_nonneg_right h_norm_sum (Real.rpow_nonneg ht_nn _)
        _ = (Real.log 4 + 4) * (t ^ (1 : ℝ) * t ^ (-(σ₀ + 1))) := by
            rw [Real.rpow_one, mul_assoc]
        _ = (Real.log 4 + 4) * t ^ (-σ₀) := by
            rw [← Real.rpow_add ht_pos]
            congr 2
            ring
    have h_mono : (∫ t : ℝ in Set.Ioi 1,
        ‖(∑ k ∈ Finset.Icc 1 ⌊t⌋₊, f_vm k) * (t : ℂ) ^ (-((σ₀ : ℂ) + 1))‖) ≤
        ∫ t : ℝ in Set.Ioi 1, (Real.log 4 + 4) * t ^ (-σ₀) :=
      MeasureTheory.integral_mono_of_nonneg
        (Filter.Eventually.of_forall (fun _ => norm_nonneg _)) h_int_rpow h_ae
    have h_eval : (∫ t : ℝ in Set.Ioi 1, (Real.log 4 + 4) * t ^ (-σ₀)) =
        (Real.log 4 + 4) / (σ₀ - 1) := by
      rw [MeasureTheory.integral_const_mul,
        integral_Ioi_rpow_of_lt (by linarith : -σ₀ < -1) zero_lt_one, Real.one_rpow]
      have h_sub_ne : σ₀ - 1 ≠ 0 := by linarith
      have h_sub_ne' : -σ₀ + 1 ≠ 0 := by linarith
      have h_inv_eq : -1 / (-σ₀ + 1) = 1 / (σ₀ - 1) := by
        rw [div_eq_div_iff h_sub_ne' h_sub_ne]
        ring
      rw [h_inv_eq, mul_one_div]
    rw [← h_eval]
    exact h_mono
  have h_s4 : ‖LSeries f_vm (σ₀ : ℂ)‖ ≤ C_Q / (σ₀ - 1) := by
    have h_pos_denom : 0 < (Real.log 4 + 4) / (σ₀ - 1) :=
      div_pos (by linarith) (by linarith)
    calc ‖LSeries f_vm (σ₀ : ℂ)‖
        ≤ σ₀ * ((Real.log 4 + 4) / (σ₀ - 1)) :=
          le_trans h_norm_abel (mul_le_mul_of_nonneg_left h_int_bound hσ₀_nonneg)
      _ ≤ 2 * ((Real.log 4 + 4) / (σ₀ - 1)) :=
          mul_le_mul_of_nonneg_right hσ₀_le_two (le_of_lt h_pos_denom)
      _ = C_Q / (σ₀ - 1) := by
          dsimp [C_Q]
          ring
  calc ‖LSeries f s‖
      ≤ d * ‖LSeries f_vm (σ₀ : ℂ)‖ := h_s3
    _ ≤ d * (C_Q / (σ₀ - 1)) := mul_le_mul_of_nonneg_left h_s4 hd_nonneg
    _ = M₀ / (σ₀ - 1) := by
        dsimp [M₀]
        ring

theorem mitsui_ray_char_LSeries_norm_le_dedekindZeta_of_re_ge {K : Type u} [Field K] [NumberField K]
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1)
    (s : ℂ) (σ₀ : ℝ) (hσ₀ : 1 < σ₀) (hs : σ₀ ≤ s.re) :
    ‖LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s‖ ≤
      ‖NumberField.dedekindZeta K (σ₀ : ℂ)‖ :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let S' : ℕ → Type u := fun e => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = e}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  let a_χ : ℕ → ℂ := fun n =>
    ∑' I : S' n, χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  have hS'_fin : ∀ e : ℕ, Finite (S' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2)
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  letI : ∀ e, Fintype (S' e) := fun e => Fintype.ofFinite (S' e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_summable_all : ∀ w : ℂ, 1 < w.re → LSeriesSummable (fun n => (a_K n : ℂ)) w := by
    intro w hw
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) = (Nat.card S_pos : ℝ) := by
        have h1 : (∑ _J : S_pos, (1 : ℝ)) = (Nat.card S_pos : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        rw [← h1, ← Finset.sum_fiberwise_of_maps_to hg (fun _ => (1 : ℝ))]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_Icc] at hk
        let e_k : S k ≃ {J : S_pos // g J = k} :=
          { toFun := fun I => ⟨⟨I.1, ⟨by rw [I.2]; exact hk.1, by rw [I.2]; exact hk.2⟩⟩, I.2⟩
            invFun := fun J => ⟨J.1.1, J.2⟩
            left_inv := fun _ => by apply Subtype.ext; rfl
            right_inv := fun _ => by apply Subtype.ext; apply Subtype.ext; rfl }
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]
        have h_card : ((Finset.univ.filter (fun J : S_pos => g J = k)).card : ℝ) =
            (Fintype.card {J : S_pos // g J = k} : ℝ) := by
          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ (1 : ℝ)) := by
      refine Asymptotics.IsBigO.of_bound C₁ ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ) :=
        Finset.sum_nonneg (fun k _ => ha_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ (1 : ℝ) := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact ha_sum_bound N hN
    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hw
    simpa [a_K, S] using h_sum_real
  have ha_χ_bound : ∀ n : ℕ, ‖a_χ n‖ ≤ (a_K n : ℝ) := by
    intro n
    dsimp [a_χ, a_K]
    rw [tsum_fintype]
    have h_inj : Function.Injective (fun I : S' n => (⟨I.1, I.2.2⟩ : S n)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
    have h_card : (Nat.card (S' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ I : S' n, χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
        ≤ ∑ I : S' n, ‖χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _I : S' n, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hχ_norm _)
      _ = (Nat.card (S' n) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S n) : ℝ) := h_card
  have hζ_def : NumberField.dedekindZeta K = LSeries (fun n => (a_K n : ℂ)) := rfl
  rw [hζ_def]
  have hs_re : 1 < s.re := lt_of_lt_of_le hσ₀ hs
  have hσ₀_re : 1 < (σ₀ : ℂ).re := by simpa using hσ₀
  have h_sum_s : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := ha_summable_all s hs_re
  have h_sum_σ₀ : Summable (LSeries.term (fun n => (a_K n : ℂ)) (σ₀ : ℂ)) :=
    ha_summable_all (σ₀ : ℂ) hσ₀_re
  have h_term_χ_le_s : ∀ n : ℕ,
      ‖LSeries.term a_χ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact ha_χ_bound n
  have h_sum_χ_s : Summable (LSeries.term a_χ s) :=
    Summable.of_norm_bounded h_sum_s.norm h_term_χ_le_s
  have h_term_le_s_σ₀ : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ ≤
        ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
    LSeries.norm_term_le_of_re_le_re (fun k => (a_K k : ℂ)) (by simpa using hs)
  have h_term_le : ∀ n : ℕ,
      ‖LSeries.term a_χ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
    fun n => le_trans (h_term_χ_le_s n) (h_term_le_s_σ₀ n)
  have h_term_re : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ =
        (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, if_neg hn, LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : (n : ℂ) ^ (σ₀ : ℂ) = (((n : ℝ) ^ σ₀ : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg]
      have ha_cast : (a_K n : ℂ) = ((a_K n : ℝ) : ℂ) := (Complex.ofReal_natCast (a_K n)).symm
      rw [Complex.norm_natCast, ha_cast, h_cpow, ← Complex.ofReal_div, Complex.ofReal_re,
        Complex.ofReal_re]
  calc ‖LSeries a_χ s‖
      ≤ ∑' n : ℕ, ‖LSeries.term a_χ s n‖ :=
        norm_tsum_le_tsum_norm h_sum_χ_s.norm
    _ ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
        h_sum_χ_s.norm.tsum_le_tsum h_term_le h_sum_σ₀.norm
    _ = ∑' n : ℕ, (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
        congr 1; ext n; exact h_term_re n
    _ = (LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)).re :=
        (Complex.re_tsum h_sum_σ₀).symm
    _ ≤ ‖LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)‖ :=
        le_trans (le_abs_self _) (Complex.abs_re_le_norm _)

theorem mitsui_grossenchar_primitive_conductor_reduction {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (w₀ : NumberField.InfinitePlace K)
    (a₀ : ℕ) (ha₀_lt : a₀ < NumberField.Units.torsionOrder K)
    (θ₀ : Fin (NumberField.Units.rank K) → ℝ)
    (hθ₀_bdd : ∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1)
    (m_freq : Fin (NumberField.Units.rank K) → ℤ)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (h_nonprin : 1 ≤ a₀ ∨
      ((∀ w : NumberField.InfinitePlace K, w.IsReal → l_ang w = 0) ∧
        (m_freq ≠ 0 ∨ ∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0)))
    (χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0))
    (hχ_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
        (∀ w : NumberField.InfinitePlace K,
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              y j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            Complex.exp
              (((∑ j : Fin (NumberField.Units.rank K),
                  y j *
                    (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                      ∑ w : NumberField.InfinitePlace K,
                        (l_ang w : ℝ) *
                          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) :
    ∃ (f : Ideal (NumberField.RingOfIntegers K))
      (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
      q ≤ f ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0)) ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        x - 1 ∈ f →
        ∃ y : Fin (NumberField.Units.rank K) → ℝ,
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) =
              ∑ j : Fin (NumberField.Units.rank K),
                y j *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
          χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
            ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    y j *
                      (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                        ∑ w : NumberField.InfinitePlace K,
                          (l_ang w : ℝ) *
                            (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
            ∏ w : NumberField.InfinitePlace K,
              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ∧
      (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
          x - 1 ∈ f' ∧
          ∀ y : Fin (NumberField.Units.rank K) → ℝ,
            (∀ w : NumberField.InfinitePlace K,
              Real.log (w (x : K) / w₀ (x : K)) =
                ∑ j : Fin (NumberField.Units.rank K),
                  y j *
                    Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                      w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
            χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
              ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                Complex.exp
                  (((∑ j : Fin (NumberField.Units.rank K),
                      y j *
                        (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                          ∑ w : NumberField.InfinitePlace K,
                            (l_ang w : ℝ) *
                              (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) ≠
              ∏ w : NumberField.InfinitePlace K,
                (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → χ_gr I = χ₀ I) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Ω : Fin r → ℝ := fun j =>
    2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
      ∑ w : NumberField.InfinitePlace K,
        (l_ang w : ℝ) *
          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  
  let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
    fun x w => Real.log (w (x : K)) -
      (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (x : K))) / (n : ℝ)
  let L_vec : NumberField.RingOfIntegers K → NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun x w => (w.1.mult : ℝ) * ℓ x w.1
  let W₀ : NumberField.RingOfIntegers K → Fin r → ℝ :=
    fun x j => B_R.repr (L_vec x) j
  have hW₀_log : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) =
          ∑ j : Fin r,
            W₀ x j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
    intro x hx w
    let r_x : NumberField.InfinitePlace K → ℝ :=
      fun v => ∑ j : Fin r, W₀ x j *
        Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))
    let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v hv
      let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
      have h_basis := congr_fun (Module.Basis.sum_repr B_R (L_vec x)).symm v_sub
      change (v.mult : ℝ) * ℓ x v = (∑ j : Fin r, (W₀ x j) • B_R j) v_sub at h_basis
      rw [h_basis]
      have h_eval : (∑ j : Fin r, (W₀ x j) • B_R j) v_sub =
          ∑ j : Fin r, W₀ x j * (B_R j v_sub) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      dsimp [r_x]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hB_j : B_R j v_sub =
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hB_j]
      ring
    have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ x v) = 0 := by
      dsimp [ℓ]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
    have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_x v) = 0 := by
      dsimp [r_x]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h_comm : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (W₀ x j *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
          W₀ x j * (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_comm]
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, mul_zero]
    have h_all_mult : ∀ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v
      by_cases hv : v = w_dir
      · subst hv
        have h1 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ x v) (Finset.mem_univ w_dir)).symm
        have h2 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_x v) (Finset.mem_univ w_dir)).symm
        have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ x v) =
            (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_x v) :=
          Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
        linarith
      · exact h_ne_dir v hv
    have h_all : ∀ v : NumberField.InfinitePlace K, ℓ x v = r_x v := by
      intro v
      have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
      exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
    have hw₀x : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK)
    calc Real.log (w (x : K) / w₀ (x : K))
      _ = Real.log (w (x : K)) - Real.log (w₀ (x : K)) := Real.log_div hwx hw₀x
      _ = ℓ x w - ℓ x w₀ := by dsimp [ℓ]; ring
      _ = r_x w - r_x w₀ := by rw [h_all w, h_all w₀]
      _ = ∑ j : Fin r, W₀ x j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [r_x]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
        have hη_ne : η_j ≠ 0 :=
          NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
        have hwη : w η_j ≠ 0 := ne_of_gt (w.pos_iff.mpr hη_ne)
        have hw₀η : w₀ η_j ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hη_ne)
        rw [← mul_sub, ← Real.log_div hwη hw₀η]
  
  have h_s1b : ∃ β : NumberField.InfinitePlace K → ℝ,
      (∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ y : Fin r → ℝ,
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) =
              ∑ j : Fin r,
                y j *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
          (∑ j : Fin r, y j * Ω j) =
            ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) := by
    let T_log : (NumberField.InfinitePlace K → ℝ) → NumberField.Units.dirichletUnitTheorem.logSpace K :=
      fun z w => (w.1.mult : ℝ) *
        (z w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z v) / (n : ℝ))
    have hT_add : ∀ z₁ z₂ : NumberField.InfinitePlace K → ℝ,
        T_log (z₁ + z₂) = T_log z₁ + T_log z₂ := by
      intro z₁ z₂
      ext w
      change (w.1.mult : ℝ) *
          ((z₁ + z₂) w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (z₁ + z₂) v) / (n : ℝ)) =
        T_log z₁ w + T_log z₂ w
      dsimp [T_log]
      simp only [mul_add, Finset.sum_add_distrib]
      ring
    have hT_smul : ∀ (c : ℝ) (z : NumberField.InfinitePlace K → ℝ),
        T_log (c • z) = c • T_log z := by
      intro c z
      ext w
      change (w.1.mult : ℝ) *
          (c * z w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * z v)) / (n : ℝ)) =
        c * T_log z w
      dsimp [T_log]
      have h_sum_smul : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * z v)) =
          c * ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z v := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_sum_smul]
      ring
    let F_lin : (NumberField.InfinitePlace K → ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun z => ∑ i : Fin r, (B_R.repr (T_log z) i) * Ω i
        map_add' := fun z₁ z₂ => by
          rw [hT_add, map_add]
          simp only [Finsupp.add_apply, add_mul, Finset.sum_add_distrib]
        map_smul' := fun c z => by
          rw [hT_smul, map_smul]
          simp only [Finsupp.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, RingHom.id_apply] }
    let β : NumberField.InfinitePlace K → ℝ :=
      fun w => F_lin (fun v => if w = v then 1 else 0)
    have hF_eq : ∀ z : NumberField.InfinitePlace K → ℝ,
        (∑ w : NumberField.InfinitePlace K, β w * z w) = F_lin z := by
      intro z
      conv_rhs => rw [pi_eq_sum_univ z]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [map_smul, smul_eq_mul, mul_comm]
    have hβ_sum : (∑ w : NumberField.InfinitePlace K, β w) = 0 := by
      have h1 : (∑ w : NumberField.InfinitePlace K, β w) =
          ∑ w : NumberField.InfinitePlace K, β w * (1 : ℝ) := by
        refine Finset.sum_congr rfl (fun w _ => by ring)
      rw [h1, hF_eq (fun _ => 1)]
      have hT_one : T_log (fun _ => 1) = 0 := by
        ext w
        change (w.1.mult : ℝ) * (1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * 1) / (n : ℝ)) = 0
        simp only [mul_one, h_sum_mult, div_self hn_ne, sub_self, mul_zero]
      change (∑ i : Fin r, (B_R.repr (T_log (fun _ => 1)) i) * Ω i) = 0
      rw [hT_one, map_zero]
      simp
    have hβ_fund : ∀ j : Fin r,
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = Ω j := by
      intro j
      let η_j : (NumberField.RingOfIntegers K)ˣ := NumberField.Units.fundSystem K j
      let z_j : NumberField.InfinitePlace K → ℝ :=
        fun w => Real.log (w ((η_j : NumberField.RingOfIntegers K) : K) /
          w₀ ((η_j : NumberField.RingOfIntegers K) : K))
      rw [hF_eq z_j]
      have hη_ne : ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero η_j)
      have hw₀_ne : w₀ ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        ne_of_gt (w₀.pos_iff.mpr hη_ne)
      have hz_j : ∀ v : NumberField.InfinitePlace K,
          z_j v = Real.log (v ((η_j : NumberField.RingOfIntegers K) : K)) -
            Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        intro v
        dsimp [z_j]
        exact Real.log_div (ne_of_gt (v.pos_iff.mpr hη_ne)) hw₀_ne
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * Real.log (v ((η_j : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log η_j
      have h_sum_zj : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z_j v) =
          -(n : ℝ) * Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        have h1 : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z_j v) =
            (∑ v : NumberField.InfinitePlace K,
