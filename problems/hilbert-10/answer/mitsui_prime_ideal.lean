theorem mitsui_principalPrimePower_freeUnit_cell_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c_free : ℝ, 0 < c_free ∧
