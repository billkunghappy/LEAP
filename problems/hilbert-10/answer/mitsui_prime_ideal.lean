    Finset.sum_nonneg (fun pm _ => hw_nonneg pm)
  have h_collar_0 : ‖c_collar 0 * (∑ pm : D_Y, (w_riesz pm : ℂ))‖ ≤ A_collar * (∑ pm : D_Y, w_riesz pm) := by
    rw [norm_mul, ← Complex.ofReal_sum, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hΨ_nonneg]
