  · intro l
    simp_rw [h_vec_N l]
    rw [hD_norm ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ),
      (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).1]
  · intro l
    simp_rw [h_vec_N l]
    rw [hD_cplx ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ),
      (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.1, ← mul_assoc]
  · intro l
    simp_rw [h_vec_N l]
    rw [← (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.2]
    exact hD_quad ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ)

theorem mitsui_matrix_shifted_harmonic_gaussian_poisson_summation (n : ℕ)
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : A.det ≠ 0)
    (u : Fin n → ℝ)
    (d : Fin n → ℕ) (hd : ∀ j : Fin n, d j ≤ 1) :
    Summable (fun k : Fin n → ℤ =>
      (∏ j : Fin n, |A.mulVec (fun i => u i + (k i : ℝ)) j| ^ (d j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2)) ∧
    Summable (fun l : Fin n → ℤ =>
      (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) ∧
    (∑' k : Fin n → ℤ,
      (((∏ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
      (Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2) : ℂ))) =
      ((-Complex.I) ^ (∑ j : Fin n, d j) *
        ((|A.det|⁻¹ : ℝ) : ℂ)) *
        ∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I *
            (∑ i : Fin n, u i * (l i : ℝ) : ℂ)) *
            (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) :=
by
  classical
  have h_det_dual : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → B.transpose⁻¹.det ≠ 0 := by
    intro N B hB
    rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv]
    exact inv_ne_zero hB
  have h_det_smul : ∀ {N : ℕ} (c : ℝ), c ≠ 0 → ∀ (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → (c • B).det ≠ 0 := by
    intro N c hc B hB
    rw [Matrix.det_smul, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero N hc) hB
  have h_1d : ∀ (z : ℝ) (m : ℕ), m ≤ 1 → |z| ^ m ≤ Real.exp (3 * Real.pi / 4 * z ^ 2) := by
    intro z m hm
    interval_cases m
    · simp only [pow_zero]
      exact Real.one_le_exp (by positivity)
    · simp only [pow_one]
      have h1 := Real.add_one_le_exp (3 * Real.pi / 4 * z ^ 2)
      have h2 : 0 ≤ (|z| - 1) ^ 2 := sq_nonneg (|z| - 1)
      have h3 : |z| ^ 2 = z ^ 2 := sq_abs z
      have h4 : 0 ≤ z ^ 2 := sq_nonneg z
      have hpi : 3 < Real.pi := Real.pi_gt_three
      nlinarith
  
  have h_s4 : ∀ (B : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ)
      (d₁ : Fin n → ℕ), (∀ j : Fin n, d₁ j ≤ 1) →
      Summable (fun k : Fin n → ℤ =>
        Real.exp (-Real.pi *
          ∑ j : Fin n, (((1 / 2 : ℝ) • B).mulVec (fun i => (k i : ℝ) + v i) j) ^ 2)) →
      Summable (fun k : Fin n → ℤ =>
        (∏ j : Fin n, |B.mulVec (fun i => v i + (k i : ℝ)) j| ^ (d₁ j)) *
        Real.exp (-Real.pi *
          ∑ j : Fin n, (B.mulVec (fun i => v i + (k i : ℝ)) j) ^ 2)) := by
    intro B v d₁ hd₁ h_gauss
    refine Summable.of_nonneg_of_le (fun k => by positivity) (fun k => ?_) h_gauss
    set y : Fin n → ℝ := B.mulVec (fun i => v i + (k i : ℝ))
    have h_prod : (∏ j : Fin n, |y j| ^ (d₁ j)) ≤ Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (y j) ^ 2) := by
      calc (∏ j : Fin n, |y j| ^ (d₁ j))
        _ ≤ ∏ j : Fin n, Real.exp (3 * Real.pi / 4 * (y j) ^ 2) :=
            Finset.prod_le_prod (fun j _ => by positivity) (fun j _ => h_1d (y j) (d₁ j) (hd₁ j))
        _ = Real.exp (∑ j : Fin n, (3 * Real.pi / 4 * (y j) ^ 2)) := (Real.exp_sum _ _).symm
        _ = Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (y j) ^ 2) := by rw [← Finset.mul_sum]
    calc (∏ j : Fin n, |y j| ^ (d₁ j)) * Real.exp (-Real.pi * ∑ j : Fin n, (y j) ^ 2)
      _ ≤ Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (y j) ^ 2) *
            Real.exp (-Real.pi * ∑ j : Fin n, (y j) ^ 2) :=
          mul_le_mul_of_nonneg_right h_prod (by positivity)
      _ = Real.exp (3 * Real.pi / 4 * (∑ j : Fin n, (y j) ^ 2) +
            (-Real.pi * ∑ j : Fin n, (y j) ^ 2)) := (Real.exp_add _ _).symm
      _ = Real.exp (-Real.pi * ∑ j : Fin n, (((1 / 2 : ℝ) • B).mulVec (fun i => (k i : ℝ) + v i) j) ^ 2) := by
          congr 1
          have h_vec : (fun i : Fin n => (k i : ℝ) + v i) = (fun i : Fin n => v i + (k i : ℝ)) := by
            ext i; exact add_comm _ _
          have h_sum_sq : (∑ j : Fin n, (((1 / 2 : ℝ) • B).mulVec (fun i => (k i : ℝ) + v i) j) ^ 2) =
              (1 / 4 : ℝ) * ∑ j : Fin n, (y j) ^ 2 := by
            rw [h_vec, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Matrix.smul_mulVec]
            dsimp [y]
            ring
          rw [h_sum_sq]
          ring
  have h_sum_hermite : ∀ (B : Matrix (Fin n) (Fin n) ℝ), B.det ≠ 0 →
      ∀ (v : Fin n → ℝ) (d₁ : Fin n → ℕ), (∀ j : Fin n, d₁ j ≤ 1) →
      Summable (fun k : Fin n → ℤ =>
        (∏ j : Fin n, |B.mulVec (fun i => v i + (k i : ℝ)) j| ^ (d₁ j)) *
        Real.exp (-Real.pi *
          ∑ j : Fin n, (B.mulVec (fun i => v i + (k i : ℝ)) j) ^ 2)) := by
    intro B hB v d₁ hd₁
    exact h_s4 B v d₁ hd₁
      (mitsui_matrix_lattice_shifted_gaussian_summable n ((1 / 2 : ℝ) • B)
        (h_det_smul (1 / 2 : ℝ) (by norm_num) B hB) v)
  have h_sum_dual_all : ∀ (d₁ : Fin n → ℕ), (∀ j : Fin n, d₁ j ≤ 1) →
      Summable (fun l : Fin n → ℤ =>
        (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d₁ j)) *
        Real.exp (-Real.pi *
          ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) := by
    intro d₁ hd₁
    have h0 := h_sum_hermite A.transpose⁻¹ (h_det_dual A hA) 0 d₁ hd₁
    refine h0.congr (fun l => ?_)
    have hl : (fun i : Fin n => (0 : Fin n → ℝ) i + (l i : ℝ)) = (fun i : Fin n => (l i : ℝ)) := by
      ext i; exact zero_add _
    rw [hl]
  refine ⟨h_sum_hermite A hA u d hd, h_sum_dual_all d hd, ?_⟩
  have h_sum_zero : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 →
      Summable (fun k : Fin N → ℤ =>
        Real.exp (-Real.pi * ∑ j : Fin N, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2)) := by
    intro N B hB
    have h0 := mitsui_matrix_lattice_shifted_gaussian_summable N B hB 0
    refine h0.congr (fun k => ?_)
    have hk : (fun i : Fin N => (k i : ℝ) + (0 : Fin N → ℝ) i) = (fun i : Fin N => (k i : ℝ)) := by
      ext i; exact add_zero _
    rw [hk]
  have h_phased : ∀ (N : ℕ) (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → ∀ y : Fin N → ℝ,
      (∑' k : Fin N → ℤ,
        Complex.exp ((-Real.pi * ∑ j : Fin N, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
          2 * Real.pi * Complex.I * ∑ l : Fin N, (y l * (k l : ℝ) : ℂ))) =
      ((|B.det|⁻¹ : ℝ) : ℂ) *
        ∑' m : Fin N → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin N,
            (B.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ) := by
    intro N
    induction' N with N ih
    · intro B _hB y
      rw [tsum_fintype, tsum_fintype]
      simp [Matrix.det_fin_zero]
    · intro B hB y
      obtain ⟨d₀, c, M', hd₀, hM', hdet, hQ_primal, hQ_dual⟩ :=
        mitsui_matrix_succ_orthogonal_column_split N B hB
      have h_sum : Summable (fun k : Fin (N + 1) → ℤ =>
          Real.exp (-Real.pi *
            (d₀ ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
              ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2))) := by
        refine (h_sum_zero B hB).congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_sum' : Summable (fun k' : Fin N → ℤ =>
          Real.exp (-Real.pi * ∑ i : Fin N, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2)) :=
        h_sum_zero M' hM'
      have h_dual' : ∀ w' : Fin N → ℝ,
          Summable (fun m' : Fin N → ℤ =>
            Real.exp (-Real.pi * ∑ i : Fin N,
              (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' l) i) ^ 2)) := by
        intro w'
        have hw := mitsui_matrix_lattice_shifted_gaussian_summable N M'.transpose⁻¹ (h_det_dual M' hM') (-w')
        refine hw.congr (fun m' => ?_)
        have hm : (fun l : Fin N => (m' l : ℝ) + (-w') l) = (fun l : Fin N => (m' l : ℝ) - w' l) := by
          ext l; exact (sub_eq_add_neg _ _).symm
        rw [hm]
      have h_lhs :
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp ((-Real.pi * ∑ j : Fin (N + 1), (B.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
              2 * Real.pi * Complex.I * ∑ l : Fin (N + 1), (y l * (k l : ℝ) : ℂ))) =
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp
              ((-Real.pi *
                  (d₀ ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
                    ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * ∑ j : Fin (N + 1), (y j * (k j : ℝ) : ℂ))) := by
        refine tsum_congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_rhs :
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp (-Real.pi * ∑ j : Fin (N + 1),
              (B.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ)) =
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp
              (-Real.pi *
                ((d₀⁻¹) ^ 2 * ((m 0 : ℝ) - y 0) ^ 2 +
                  ∑ i : Fin N,
                    (M'.transpose⁻¹.mulVec
                      (fun l => ((m l.succ : ℝ) - y l.succ) - ((m 0 : ℝ) - y 0) * c l) i) ^ 2)) : ℂ)) := by
        refine tsum_congr (fun m => ?_)
        rw [hQ_dual (fun i => (m i : ℝ) - y i)]
      rw [h_lhs, hdet, h_rhs]
      exact mitsui_block_quadratic_phased_gaussian_poisson_step N d₀ hd₀ c M' hM' h_sum h_sum' h_dual' (ih M' hM') y
  have h_base : ∀ u' : Fin n → ℝ,
      (∑' k : Fin n → ℤ,
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) =
      ((|A.det|⁻¹ : ℝ) : ℂ) *
        ∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I *
            (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ) := by
    intro u'
    have hp := h_phased n A.transpose⁻¹ (h_det_dual A hA) u'
    have h_inv_inv : (A.transpose⁻¹).transpose⁻¹ = A := by
      have hA_unit : IsUnit A.det := isUnit_iff_ne_zero.mpr hA
      rw [Matrix.transpose_nonsing_inv, Matrix.transpose_transpose, Matrix.nonsing_inv_nonsing_inv A hA_unit]
    have h_det_inv : |(A.transpose⁻¹).det|⁻¹ = |A.det| := by
      rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv, abs_inv, inv_inv]
    rw [h_inv_inv, h_det_inv] at hp
    have h_rhs_reindex :
        (∑' m : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n,
            (A.mulVec (fun i => (m i : ℝ) - u' i) j) ^ 2) : ℂ)) =
        (∑' k : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n,
            (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := by
      rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
      refine tsum_congr (fun k => ?_)
      have h_sum_eq : (∑ j : Fin n, (A.mulVec (fun i => ((Equiv.neg (Fin n → ℤ) k i : ℤ) : ℝ) - u' i) j) ^ 2) =
          ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2 := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        have h_vec : (fun i : Fin n => ((Equiv.neg (Fin n → ℤ) k i : ℤ) : ℝ) - u' i) = -(fun i : Fin n => u' i + (k i : ℝ)) := by
          ext i
          dsimp [Equiv.neg]
          push_cast
          ring
        rw [h_vec, Matrix.mulVec_neg, Pi.neg_apply, neg_sq]
      rw [h_sum_eq]
    have h_lhs_split :
        (∑' l : Fin n → ℤ,
          Complex.exp ((-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2 : ℝ) +
            2 * Real.pi * Complex.I * ∑ i : Fin n, (u' i * (l i : ℝ) : ℂ))) =
        (∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
      refine tsum_congr (fun l => ?_)
      rw [add_comm, Complex.exp_add, Complex.ofReal_exp]
    rw [h_rhs_reindex, h_lhs_split] at hp
    have h_cancel : ((|A.det|⁻¹ : ℝ) : ℂ) * ((|A.det| : ℝ) : ℂ) = 1 := by
      rw [← Complex.ofReal_mul, inv_mul_cancel₀ (abs_ne_zero.mpr hA), Complex.ofReal_one]
    calc (∑' k : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))
      _ = 1 * (∑' k : Fin n → ℤ,
            (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := (one_mul _).symm
      _ = (((|A.det|⁻¹ : ℝ) : ℂ) * ((|A.det| : ℝ) : ℂ)) *
            (∑' k : Fin n → ℤ,
              (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := by rw [h_cancel]
      _ = ((|A.det|⁻¹ : ℝ) : ℂ) *
            (((|A.det| : ℝ) : ℂ) *
              (∑' k : Fin n → ℤ,
                (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))) := by rw [mul_assoc]
      _ = ((|A.det|⁻¹ : ℝ) : ℂ) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
                (Real.exp (-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ) := by rw [← hp]
  
  have h_s5 : ∀ (d₁ : Fin n → ℕ), (∀ j : Fin n, d₁ j ≤ 1) →
      ∀ (j₀ : Fin n), d₁ j₀ = 0 →
      (∀ u' : Fin n → ℝ,
        (∑' k : Fin n → ℤ,
          (((∏ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))) =
          ((-Complex.I) ^ (∑ j : Fin n, d₁ j) *
            ((|A.det|⁻¹ : ℝ) : ℂ)) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I *
                (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
                (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
                (Real.exp (-Real.pi *
                  ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) →
      ∀ u₀ : Fin n → ℝ,
        (∑' k : Fin n → ℤ,
          (((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (Function.update d₁ j₀ 1 j) : ℝ) : ℂ) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ))) =
          ((-Complex.I) ^ (∑ j : Fin n, Function.update d₁ j₀ 1 j) *
            ((|A.det|⁻¹ : ℝ) : ℂ)) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I *
                (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
                (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (Function.update d₁ j₀ 1 j) : ℝ) : ℂ) *
                (Real.exp (-Real.pi *
                  ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
    intro d₁ hd₁ j₀ hd₀ h_IH u₀
    set d' : Fin n → ℕ := Function.update d₁ j₀ 1
    have hd'_le : ∀ j : Fin n, d' j ≤ 1 := by
      intro j
      by_cases hj : j = j₀
      · subst hj; simp [d']
      · dsimp [d']; rw [Function.update_of_ne hj]; exact hd₁ j
    have h_sum_d' : (∑ j : Fin n, d' j) = (∑ j : Fin n, d₁ j) + 1 := by
      have h1 := (Finset.add_sum_erase Finset.univ d' (Finset.mem_univ j₀)).symm
      have h2 := (Finset.add_sum_erase Finset.univ d₁ (Finset.mem_univ j₀)).symm
      have h_er : (∑ j ∈ Finset.univ.erase j₀, d' j) = ∑ j ∈ Finset.univ.erase j₀, d₁ j := by
        refine Finset.sum_congr rfl (fun j hj => ?_)
        dsimp [d']
        exact Function.update_of_ne (Finset.ne_of_mem_erase hj) 1 d₁
      have hd'0 : d' j₀ = 1 := Function.update_self j₀ 1 d₁
      rw [h1, h2, h_er, hd'0, hd₀]
      omega
    have h_prod_d' : ∀ z : Fin n → ℝ, (∏ j : Fin n, (z j) ^ (d' j)) = z j₀ * ∏ j : Fin n, (z j) ^ (d₁ j) := by
      intro z
      have h1 := (Finset.mul_prod_erase Finset.univ (fun j => (z j) ^ (d' j)) (Finset.mem_univ j₀)).symm
      have h2 := (Finset.mul_prod_erase Finset.univ (fun j => (z j) ^ (d₁ j)) (Finset.mem_univ j₀)).symm
      have h_er : (∏ j ∈ Finset.univ.erase j₀, (z j) ^ (d' j)) =
          ∏ j ∈ Finset.univ.erase j₀, (z j) ^ (d₁ j) := by
        refine Finset.prod_congr rfl (fun j hj => ?_)
        dsimp [d']
