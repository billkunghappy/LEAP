        congr 1
        refine tsum_congr (fun x_star => by ring)
      have h_summable_F : ∀ a : R ⧸ f,
          Summable (fun x_star : J_σC =>
            (ψ_f a *
              Complex.exp (2 * Real.pi * Complex.I *
                (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) *
              P_dual x_star) := by
        intro a
        refine Summable.of_norm_bounded (g := fun x_star => ‖ψ_f a‖ * ‖P_dual x_star‖)
          (h_sum_P_dual_norm.mul_left ‖ψ_f a‖) (fun x_star => ?_)
        rw [norm_mul, norm_mul]
        have h_exp_norm : ‖Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))‖ = 1 := by
          have h_eq : 2 * Real.pi * Complex.I *
              (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ) =
              ((2 * Real.pi * (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℝ) : ℝ) : ℂ) * Complex.I := by
            push_cast; ring
          rw [h_eq, Complex.norm_exp_ofReal_mul_I]
        rw [h_exp_norm, mul_one]
      have h_comm :
          (∑' a : R ⧸ f, ∑' x_star : J_σC,
            (ψ_f a *
              Complex.exp (2 * Real.pi * Complex.I *
                (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) *
              P_dual x_star) =
          ∑' x_star : J_σC,
            (∑' a : R ⧸ f,
              ψ_f a *
                Complex.exp (2 * Real.pi * Complex.I *
                  (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) *
              P_dual x_star := by
        rw [tsum_fintype (L := SummationFilter.unconditional (R ⧸ f)),
          ← Summable.tsum_finsetSum (fun a _ => h_summable_F a)]
        refine tsum_congr (fun x_star => ?_)
        rw [tsum_fintype (L := SummationFilter.unconditional (R ⧸ f)), Finset.sum_mul]
      have h_lhs_reassoc :
          star (χ₀ (J_rep C)) *
            ((κ_a * ((u * N_f ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) *
              ∑' x_star : J_σC,
                (∑' a : R ⧸ f,
                  ψ_f a *
                    Complex.exp (2 * Real.pi * Complex.I *
                      (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) *
                  P_dual x_star) =
          (u : ℂ) *
            ∑' x_star : J_σC,
              (star (χ₀ (J_rep C)) *
                (κ_a *
                  (((N_f ^ (-1 / 2 : ℝ) : ℝ) : ℂ) *
                    ∑' a : R ⧸ f,
                      ψ_f a *
                        Complex.exp (2 * Real.pi * Complex.I *
                          (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))))) *
                P_dual x_star := by
        rw [← mul_assoc, ← tsum_mul_left, ← tsum_mul_left]
        refine tsum_congr (fun x_star => ?_)
        rw [Complex.ofReal_mul]
        ring
      have h_dual_exp_eq : ∀ x_star : J_σC,
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (t_y w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ_C C : K)) ^ 2) =
          Real.exp (-Real.pi * c_C⁻¹ ^ 2 *
            ∑ w : NumberField.InfinitePlace K,
