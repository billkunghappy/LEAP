      rw [sub_self]
      exact f'.zero_mem
    rw [h_eval 1 h1_cop_f' 1 1 one_ne_zero h1_cop_q h1_mul h1_sub, map_one, inv_one]
  have hg_mul : ∀ I₁ I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      g (I₁ * I₂) = g I₁ * g I₂ := by
    intro I₁ I₂
    by_cases h₁ : (I₁ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤
    · by_cases h₂ : (I₂ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤
      · have h₁₂ : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ := by
          change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
            (I₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ f' = ⊤
          rw [← Ideal.isCoprime_iff_sup_eq]
          exact IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr h₁)
            (Ideal.isCoprime_iff_sup_eq.mpr h₂)
        obtain ⟨M₁, c₁, hc₁_ne, hM₁_cop, hM₁_mul, hc₁_sub⟩ := h_ex I₁ h₁
        obtain ⟨M₂, c₂, hc₂_ne, hM₂_cop, hM₂_mul, hc₂_sub⟩ := h_ex I₂ h₂
        have hM₁₂_cop : ((M₁ * M₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
          change ((M₁ : Ideal (NumberField.RingOfIntegers K)) *
            (M₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ q = ⊤
          rw [← Ideal.isCoprime_iff_sup_eq]
          exact IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr hM₁_cop)
            (Ideal.isCoprime_iff_sup_eq.mpr hM₂_cop)
        have hM₁₂_mul : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) *
            ((M₁ * M₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
              Ideal (NumberField.RingOfIntegers K)) =
            Ideal.span ({c₁ * c₂} : Set (NumberField.RingOfIntegers K)) := by
          change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
            (I₂ : Ideal (NumberField.RingOfIntegers K))) *
            ((M₁ : Ideal (NumberField.RingOfIntegers K)) *
              (M₂ : Ideal (NumberField.RingOfIntegers K))) = _
          rw [mul_mul_mul_comm, hM₁_mul, hM₂_mul, Ideal.span_singleton_mul_span_singleton]
        have hc₁₂_sub : c₁ * c₂ - 1 ∈ f' := by
          have h_id : c₁ * c₂ - 1 = (c₁ - 1) * c₂ + (c₂ - 1) := by ring
          rw [h_id]
          exact f'.add_mem (f'.mul_mem_right c₂ hc₁_sub) hc₂_sub
        rw [h_eval (I₁ * I₂) h₁₂ (M₁ * M₂) (c₁ * c₂) (mul_ne_zero hc₁_ne hc₂_ne)
              hM₁₂_cop hM₁₂_mul hc₁₂_sub,
            h_eval I₁ h₁ M₁ c₁ hc₁_ne hM₁_cop hM₁_mul hc₁_sub,
            h_eval I₂ h₂ M₂ c₂ hc₂_ne hM₂_cop hM₂_mul hc₂_sub,
            map_mul, mul_inv_rev, mul_comm]
      · have h₁₂ : ¬ (((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤) := by
          intro h_top
          change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
            (I₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ f' = ⊤ at h_top
          rw [← Ideal.isCoprime_iff_sup_eq, IsCoprime.mul_left_iff,
            Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_iff_sup_eq] at h_top
          exact h₂ h_top.2
        show (if h : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex (I₁ * I₂) h).choose)⁻¹ else 0) =
          (if h : (I₁ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex I₁ h).choose)⁻¹ else 0) *
          (if h : (I₂ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex I₂ h).choose)⁻¹ else 0)
        rw [dif_neg h₁₂, dif_neg h₂, mul_zero]
    · have h₁₂ : ¬ (((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤) := by
        intro h_top
        change ((I₁ : Ideal (NumberField.RingOfIntegers K)) *
          (I₂ : Ideal (NumberField.RingOfIntegers K))) ⊔ f' = ⊤ at h_top
        rw [← Ideal.isCoprime_iff_sup_eq, IsCoprime.mul_left_iff,
          Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_iff_sup_eq] at h_top
        exact h₁ h_top.1
      show (if h : ((I₁ * I₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex (I₁ * I₂) h).choose)⁻¹ else 0) =
        (if h : (I₁ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex I₁ h).choose)⁻¹ else 0) *
        (if h : (I₂ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ then (χ (h_ex I₂ h).choose)⁻¹ else 0)
      rw [dif_neg h₁₂, dif_neg h₁, zero_mul]
  let χ' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    { toFun := g
      map_one' := hg_one
      map_mul' := hg_mul }
  have hχ'_agree : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → χ' I = χ I := by
    intro I hIq
    have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
      eq_top_iff.mpr (le_trans (ge_of_eq hIq) (sup_le_sup_left hqf' _))
    obtain ⟨M, c, hc_ne, hM_cop, hM_mul, hc_sub⟩ := h_ex I hIf'
    have hc_cop : Ideal.span ({c} : Set (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
      rw [← hM_mul, ← Ideal.isCoprime_iff_sup_eq]
      exact IsCoprime.mul_left (Ideal.isCoprime_iff_sup_eq.mpr hIq)
        (Ideal.isCoprime_iff_sup_eq.mpr hM_cop)
    have hIM_eq : I * M = ⟨Ideal.span ({c} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc_ne)⟩ :=
      Subtype.ext hM_mul
    have hχIM : χ I * χ M = 1 := by
      rw [← map_mul, hIM_eq]
      exact h_triv c hc_ne hc_cop hc_sub
    change g I = χ I
    rw [h_eval I hIf' M c hc_ne hM_cop hM_mul hc_sub]
    exact inv_eq_of_mul_eq_one_left hχIM
  refine ⟨χ', ?_, ?_, ?_, hχ'_agree⟩
  · intro x hx_ne hx_sub
    let X : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
    have hX_cop : (X : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ := by
      change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f' = ⊤
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      refine ⟨x * 1, Ideal.mem_span_singleton.mpr ⟨1, rfl⟩, -(x - 1), f'.neg_mem hx_sub, ?_⟩
      ring
    have h1_cop : ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
      rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
    have hX_mul : (X : Ideal (NumberField.RingOfIntegers K)) *
        ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) := by
      change Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) *
        ((1 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) = _
      rw [Submonoid.coe_one, Ideal.one_eq_top, Ideal.mul_top]
    change g X = 1
    rw [h_eval X hX_cop 1 x hx_ne h1_cop hX_mul hx_sub, map_one, inv_one]
  · intro I
    refine ⟨?_, ?_⟩
    · intro hIf'
      change ‖g I‖ = 1
      dsimp [g]
      rw [dif_pos hIf', norm_inv]
      obtain ⟨_, _, hM_cop, _, _⟩ := (h_ex I hIf').choose_spec
      rw [(hχ_norm_supp (h_ex I hIf').choose).1 hM_cop, inv_one]
    · intro hIf'
      change g I = 0
      dsimp [g]
      exact dif_neg hIf'
  · obtain ⟨I₀, hI₀_cop, hI₀_ne⟩ := hχ_nonprin
    have hI₀_f' : (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
      eq_top_iff.mpr (le_trans (ge_of_eq hI₀_cop) (sup_le_sup_left hqf' _))
    refine ⟨I₀, hI₀_f', ?_⟩
    rw [hχ'_agree I₀ hI₀_cop]
    exact hI₀_ne

theorem mitsui_ray_char_primitive_conductor_and_euler_factorization {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :
    ∃ (f : Ideal (NumberField.RingOfIntegers K))
      (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
      (M_χ : ℂ → ℂ),
      f ≠ 0 ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        x - 1 ∈ f →
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0)) ∧
      (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1) ∧
      (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
          x - 1 ∈ f' ∧
          χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) ∧
      Differentiable ℂ M_χ ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2) ∧
      (∀ s : ℂ, 1 < s.re →
        M_χ s * ((Ideal.absNorm f : ℝ) : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
        LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) :=
by
  classical
  
  have h_s2 : ∀ (q₁ f' : Ideal (NumberField.RingOfIntegers K)),
      q₁ ≠ 0 → q₁ ≤ f' → f' ≠ q₁ → f' ≠ 0 ∧ Ideal.absNorm f' < Ideal.absNorm q₁ := by
    intro q₁ f' hq₁ hq₁f' hne
    obtain ⟨c', hc'⟩ := Ideal.dvd_iff_le.mpr hq₁f'
    have hf'_ne : f' ≠ 0 := left_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne : c' ≠ 0 := right_ne_zero_of_mul (hc' ▸ hq₁)
    have hc'_ne_top : c' ≠ ⊤ := by
      intro htop
      rw [htop, Ideal.mul_top] at hc'
      exact hne hc'.symm
    have hf'_norm_ne_zero : Ideal.absNorm f' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf'_ne
    have hc'_norm_ne_zero : Ideal.absNorm c' ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hc'_ne
    have hc'_norm_ne_one : Ideal.absNorm c' ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr hc'_ne_top
    refine ⟨hf'_ne, ?_⟩
    rw [hc', map_mul]
    exact lt_mul_of_one_lt_right (Nat.pos_of_ne_zero hf'_norm_ne_zero) (by omega)
  
  have h_ind : ∀ (m : ℕ) (q₁ : Ideal (NumberField.RingOfIntegers K)) (hq₁ : q₁ ≠ 0),
      Ideal.absNorm q₁ = m →
      ∀ (χ₁ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ q₁ →
          χ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ‖χ₁ I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤) → χ₁ I = 0)) →
        (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧ χ₁ I₀ ≠ 1) →
        ∃ (f : Ideal (NumberField.RingOfIntegers K))
          (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
          q₁ ≤ f ∧
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ f →
            χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0)) ∧
          (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1) ∧
          (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
            ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
              Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
              x - 1 ∈ f' ∧
              χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) ∧
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → χ₁ I = χ₀ I) := by
    intro m
    induction' m using Nat.strong_induction_on with m ih
    intro q₁ hq₁ hm χ₁ hχ₁_ray hχ₁_norm_supp hχ₁_nonprin
    by_cases h_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), q₁ ≤ f' → f' ≠ q₁ →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ ∧
          x - 1 ∈ f' ∧
          χ₁ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1
    · exact ⟨q₁, χ₁, le_rfl, hχ₁_ray, hχ₁_norm_supp, hχ₁_nonprin, h_prim, fun _ _ => rfl⟩
    · push_neg at h_prim
      rcases h_prim with ⟨f', hq₁f', hf'_ne, h_triv⟩
      obtain ⟨hf'_ne_zero, h_norm_lt⟩ := h_s2 q₁ f' hq₁ hq₁f' hf'_ne
      obtain ⟨χ', hχ'_ray, hχ'_norm_supp, hχ'_nonprin, hχ'_eq⟩ :=
        mitsui_ray_char_extend_of_le_of_ray_trivial q₁ f' hq₁ hq₁f' χ₁ hχ₁_ray hχ₁_norm_supp hχ₁_nonprin h_triv
      rw [hm] at h_norm_lt
      obtain ⟨f, χ₀, hf'f, hχ₀_ray, hχ₀_norm_supp, hχ₀_nonprin, hχ₀_prim, hχ₀_eq⟩ :=
        ih (Ideal.absNorm f') h_norm_lt f' hf'_ne_zero rfl χ' hχ'_ray hχ'_norm_supp hχ'_nonprin
      refine ⟨f, χ₀, le_trans hq₁f' hf'f, hχ₀_ray, hχ₀_norm_supp, hχ₀_nonprin, hχ₀_prim, ?_⟩
      intro I hIq₁
      have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hIq₁) (sup_le_sup_left hq₁f' _))
      rw [← hχ'_eq I hIq₁, hχ₀_eq I hIf']
  obtain ⟨f, χ₀, hqf, hχ₀_ray, hχ₀_norm_supp, hχ₀_nonprin, hχ₀_prim, hχ_eq⟩ :=
    h_ind (Ideal.absNorm q) q hq rfl χ hχ_ray hχ_norm_supp hχ_nonprin
  obtain ⟨c, hc_mul⟩ := Ideal.dvd_iff_le.mpr hqf
  have hf_ne : f ≠ 0 := left_ne_zero_of_mul (hc_mul ▸ hq)
  have hc_ne : c ≠ 0 := right_ne_zero_of_mul (hc_mul ▸ hq)
  
  have h_coprime_iff : ∀ J : Ideal (NumberField.RingOfIntegers K),
      J ⊔ q = ⊤ ↔ (J ⊔ f = ⊤ ∧ J ⊔ c = ⊤) := by
    intro J
    rw [hc_mul, ← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq,
      ← Ideal.isCoprime_iff_sup_eq]
    exact IsCoprime.mul_right_iff
  have hχ₀_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ₀ I‖ ≤ 1 := by
    intro I
    by_cases hIf : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤
    · rw [(hχ₀_norm_supp I).1 hIf]
    · rw [(hχ₀_norm_supp I).2 hIf, norm_zero]
      exact zero_le_one
  have h_coprime_eq : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ c = ⊤ → χ I = χ₀ I := by
    intro I hIc
    by_cases hIf : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤
    · exact hχ_eq I ((h_coprime_iff I).mpr ⟨hIf, hIc⟩)
    · have hnIq : ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) :=
        fun hIq => hIf ((h_coprime_iff I).mp hIq).1
      rw [(hχ_norm_supp I).2 hnIq, (hχ₀_norm_supp I).2 hIf]
  have h_not_coprime_zero : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ c = ⊤) → χ I = 0 := by
    intro I hnIc
    have hnIq : ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) :=
      fun hIq => hnIc ((h_coprime_iff I).mp hIq).2
    exact (hχ_norm_supp I).2 hnIq
  
  obtain ⟨E, hE_diff, hE_bound, hE_LSeries⟩ :=
    mitsui_ideal_coprime_restriction_euler_factor_LSeries c hc_ne χ χ₀ hχ₀_norm h_coprime_eq h_not_coprime_zero
  
  have hf_norm_ne_zero : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf_ne
  set N_f : ℝ := (Ideal.absNorm f : ℝ)
  have hNf_ge_one : (1 : ℝ) ≤ N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hf_norm_ne_zero
  have hNf_pos : 0 < N_f := lt_of_lt_of_le zero_lt_one hNf_ge_one
  have hNf_c_ne : (N_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNf_pos)
  let M_χ : ℂ → ℂ := fun s => E s * (N_f : ℂ) ^ ((3 / 4 : ℂ) - s / 2)
  have h_cpow_diff : Differentiable ℂ (fun s : ℂ => (N_f : ℂ) ^ ((3 / 4 : ℂ) - s / 2)) := by
    refine Differentiable.const_cpow ?_ (Or.inl hNf_c_ne)
    exact (differentiable_const (3 / 4 : ℂ)).sub (differentiable_id.div_const (2 : ℂ))
  have hM_diff : Differentiable ℂ M_χ := hE_diff.mul h_cpow_diff
  have hM_bound : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2 := by
    intro s hs1 hs2
    dsimp [M_χ]
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hNf_pos]
    have h_re_le : ((3 / 4 : ℂ) - s / 2).re ≤ (2 : ℝ) := by
      simp only [Complex.sub_re, Complex.div_ofNat_re, Complex.re_ofNat]
      linarith
    have h_rpow_le : N_f ^ (((3 / 4 : ℂ) - s / 2).re) ≤ N_f ^ (2 : ℕ) := by
      rw [← Real.rpow_natCast N_f 2]
      exact Real.rpow_le_rpow_of_exponent_le hNf_ge_one h_re_le
    have h_norm_q : (Ideal.absNorm c : ℝ) ^ 2 * N_f ^ 2 = (Ideal.absNorm q : ℝ) ^ 2 := by
      dsimp [N_f]
      rw [hc_mul, map_mul, Nat.cast_mul]
      ring
    calc ‖E s‖ * N_f ^ (((3 / 4 : ℂ) - s / 2).re)
        ≤ (Ideal.absNorm c : ℝ) ^ 2 * N_f ^ 2 :=
          mul_le_mul (hE_bound s hs1 hs2) h_rpow_le (by positivity) (by positivity)
      _ = (Ideal.absNorm q : ℝ) ^ 2 := h_norm_q
  have hM_eq : ∀ s : ℂ, M_χ s * (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) = E s := by
    intro s
    dsimp [M_χ]
    rw [mul_assoc, ← Complex.cpow_add _ _ hNf_c_ne]
    have h_exp : ((3 / 4 : ℂ) - s / 2) + (s / 2 - (3 / 4 : ℂ)) = 0 := by ring
    rw [h_exp, Complex.cpow_zero, mul_one]
  refine ⟨f, χ₀, M_χ, hf_ne, hχ₀_ray, hχ₀_norm_supp, hχ₀_nonprin, hχ₀_prim,
    hM_diff, hM_bound, ?_⟩
  intro s hs
  rw [hM_eq s, hE_LSeries s hs]

theorem mitsui_primitive_ray_char_exists_quotient_char_and_zero_mode {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1)
    (hχ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) :
    let R := NumberField.RingOfIntegers K
    ∃ ψ_f : (R ⧸ f) → ℂ,
      ψ_f 1 = 1 ∧
      (∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b) ∧
      (∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0)) ∧
      (∀ (x : R) (hx_ne : x ≠ 0),
        χ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
          ψ_f (Ideal.Quotient.mk f x)) ∧
      (∀ f' : Ideal R, f ≤ f' → f' ≠ f →
        ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1) ∧
      ((f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
          ∀ (h_fin : Fintype (R ⧸ f)), @Finset.sum (R ⧸ f) ℂ _ (@Finset.univ (R ⧸ f) h_fin) ψ_f = 0) ∨
        (f = ⊤ ∧ (∀ a : R ⧸ f, ψ_f a = 1) ∧
          ∀ J_rep : ClassGroup R → nonZeroDivisors (Ideal R),
            (∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹) →
            (∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤) →
            (∑ C : ClassGroup R, star (χ₀ (J_rep C))) = 0 ∧
            (∑ C : ClassGroup R, χ₀ (J_rep C)) = 0)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  have h_unit_iff_sup : ∀ x : R,
      IsUnit (Ideal.Quotient.mk f x) ↔
        Ideal.span ({x} : Set R) ⊔ f = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑(hx.unit⁻¹) : R ⧸ f)
      have h_mk_zero : Ideal.Quotient.mk f (1 - x * y) = 0 := by
        rw [map_sub, map_one, map_mul, ← hx.unit_spec, hy, Units.mul_inv, sub_self]
      have h_mem_f : 1 - x * y ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero
      have h_mem_span : x * y ∈ Ideal.span ({x} : Set R) :=
        Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      exact ⟨x * y, h_mem_span, 1 - x * y, h_mem_f, add_sub_cancel (x * y) 1⟩
    · intro h_top
      have h_one : (1 : R) ∈ Ideal.span ({x} : Set R) ⊔ f :=
        (Ideal.eq_top_iff_one _).mp h_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h_one
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have h_mk : Ideal.Quotient.mk f x * Ideal.Quotient.mk f y = 1 := by
        have h1 := congrArg (Ideal.Quotient.mk f) hab
        rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at h1
        exact h1
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk f y) h_mk
  have hf_bot : f ≠ ⊥ := hf
  obtain ⟨z₀, hz₀_mem, hz₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hf_bot
  have hz₀_mk : Ideal.Quotient.mk f z₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hz₀_mem
  let x₀ : (R ⧸ f) → R := fun a => (Ideal.Quotient.mk_surjective a).choose
  have hx₀ : ∀ a : R ⧸ f, Ideal.Quotient.mk f (x₀ a) = a :=
    fun a => (Ideal.Quotient.mk_surjective a).choose_spec
  let lift_nz : (R ⧸ f) → R := fun a => if x₀ a = 0 then z₀ else x₀ a
  have hlift_ne : ∀ a : R ⧸ f, lift_nz a ≠ 0 := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · exact hz₀_ne
    · exact h0
  have hlift_mk : ∀ a : R ⧸ f, Ideal.Quotient.mk f (lift_nz a) = a := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · rw [hz₀_mk, ← hx₀ a, h0, map_zero]
    · exact hx₀ a
  let P : ∀ (x : R), x ≠ 0 → nonZeroDivisors (Ideal R) :=
    fun x hx => ⟨Ideal.span ({x} : Set R),
      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx)⟩
  have hP_mul : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      P (x * y) (mul_ne_zero hx hy) = P x hx * P y hy := by
    intro x y hx hy
    exact Subtype.ext (Ideal.span_singleton_mul_span_singleton x y).symm
  have h_congr : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      Ideal.Quotient.mk f x = Ideal.Quotient.mk f y →
      χ₀ (P x hx) = χ₀ (P y hy) := by
    intro x y hx hy h_eq
    by_cases hu : IsUnit (Ideal.Quotient.mk f x)
    · let u_x : (R ⧸ f)ˣ := hu.unit
      have hu_x_eq : (u_x : R ⧸ f) = Ideal.Quotient.mk f x := hu.unit_spec
      let b : R ⧸ f := ↑(u_x⁻¹)
      let z : R := lift_nz b
      have hz : z ≠ 0 := hlift_ne b
      have hxz_mk : Ideal.Quotient.mk f (x * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, hlift_mk b]
        change Ideal.Quotient.mk f x * ↑(u_x⁻¹) = Ideal.Quotient.mk f 1
        rw [← hu_x_eq, Units.mul_inv, map_one]
      have hyz_mk : Ideal.Quotient.mk f (y * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, ← h_eq, ← map_mul, hxz_mk]
      have hxz_sub : x * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (x * z) 1).mp hxz_mk
      have hyz_sub : y * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (y * z) 1).mp hyz_mk
      have hxz_ray : χ₀ (P x hx) * χ₀ (P z hz) = 1 := by
        rw [← map_mul, ← hP_mul x z hx hz]
        exact hχ₀_ray (x * z) (mul_ne_zero hx hz) hxz_sub
      have hyz_ray : χ₀ (P y hy) * χ₀ (P z hz) = 1 := by
        rw [← map_mul, ← hP_mul y z hy hz]
        exact hχ₀_ray (y * z) (mul_ne_zero hy hz) hyz_sub
      have hz_ne_zero : χ₀ (P z hz) ≠ 0 := right_ne_zero_of_mul_eq_one hxz_ray
      exact mul_right_cancel₀ hz_ne_zero (hxz_ray.trans hyz_ray.symm)
    · have hy_u : ¬ IsUnit (Ideal.Quotient.mk f y) := h_eq ▸ hu
      have hx_not_top : ¬ ((P x hx : Ideal R) ⊔ f = ⊤) :=
        fun h_top => hu ((h_unit_iff_sup x).mpr h_top)
      have hy_not_top : ¬ ((P y hy : Ideal R) ⊔ f = ⊤) :=
        fun h_top => hy_u ((h_unit_iff_sup y).mpr h_top)
      rw [(hχ₀_norm_supp (P x hx)).2 hx_not_top, (hχ₀_norm_supp (P y hy)).2 hy_not_top]
  let ψ_f : (R ⧸ f) → ℂ := fun a => χ₀ (P (lift_nz a) (hlift_ne a))
  have hψ_span : ∀ (x : R) (hx_ne : x ≠ 0),
      χ₀ (P x hx_ne) = ψ_f (Ideal.Quotient.mk f x) := by
    intro x hx_ne
    exact h_congr x (lift_nz (Ideal.Quotient.mk f x)) hx_ne (hlift_ne _) (hlift_mk _).symm
  have hψ_one : ψ_f 1 = 1 := by
    have h1_ne : (1 : R) ≠ 0 := one_ne_zero
    have h1_mk : Ideal.Quotient.mk f 1 = 1 := map_one _
    rw [← h1_mk, ← hψ_span 1 h1_ne]
    exact hχ₀_ray 1 h1_ne (by rw [sub_self]; exact f.zero_mem)
  have hψ_mul : ∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b := by
    intro a b
    let x := lift_nz a
    let y := lift_nz b
    have hx : x ≠ 0 := hlift_ne a
    have hy : y ≠ 0 := hlift_ne b
    have hxy_mk : Ideal.Quotient.mk f (x * y) = a * b := by
      rw [map_mul, hlift_mk a, hlift_mk b]
    rw [← hxy_mk, ← hψ_span (x * y) (mul_ne_zero hx hy), hP_mul x y hx hy, map_mul]
  have hψ_unit : ∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0) := by
    intro a
    have h_iff : IsUnit a ↔ (P (lift_nz a) (hlift_ne a) : Ideal R) ⊔ f = ⊤ := by
      conv_lhs => rw [← hlift_mk a]
      exact h_unit_iff_sup (lift_nz a)
    constructor
    · intro ha
      exact (hχ₀_norm_supp (P (lift_nz a) (hlift_ne a))).1 (h_iff.mp ha)
    · intro ha
      exact (hχ₀_norm_supp (P (lift_nz a) (hlift_ne a))).2 (fun h_top => ha (h_iff.mpr h_top))
  have hψ_prim : ∀ f' : Ideal R, f ≤ f' → f' ≠ f →
      ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1 := by
    intro f' hf_le hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_ne_one⟩ := hχ₀_prim f' hf_le hf'_ne
    refine ⟨x, (h_unit_iff_sup x).mpr hx_cop, hx_sub, ?_⟩
    rw [← hψ_span x hx_ne]
    exact hx_ne_one
  refine ⟨ψ_f, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, ?_⟩
  by_cases hf_top : f = ⊤
  · right
    refine ⟨hf_top, ?_, ?_⟩
    · intro a
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
      have hx_sub : x - 1 ∈ f := hf_top ▸ Submodule.mem_top
      have hx_mk : Ideal.Quotient.mk f x = 1 := by
        have h1 := (Ideal.Quotient.mk_eq_mk_iff_sub_mem x 1).mpr hx_sub
        rwa [map_one] at h1
      rw [hx_mk, hψ_one]
    · intro J_rep hJ_cls _hJ_cop
      have hχ₀_prin : ∀ (x : R) (hx_ne : x ≠ 0), χ₀ (P x hx_ne) = 1 := by
        intro x hx_ne
        exact hχ₀_ray x hx_ne (hf_top ▸ Submodule.mem_top)
      have hχ₀_class_eq : ∀ I₁ I₂ : nonZeroDivisors (Ideal R),
          ClassGroup.mk0 I₁ = ClassGroup.mk0 I₂ → χ₀ I₁ = χ₀ I₂ := by
        intro I₁ I₂ h_mk
        obtain ⟨x, y, hx, hy, h_mul⟩ := ClassGroup.mk0_eq_mk0_iff.mp h_mk
        have h_sub_eq : P x hx * I₁ = P y hy * I₂ := Subtype.ext h_mul
        have h_ap := congrArg χ₀ h_sub_eq
        rw [map_mul, map_mul, hχ₀_prin x hx, hχ₀_prin y hy, one_mul, one_mul] at h_ap
        exact h_ap
      have hJ_mul : ∀ C₁ C₂ : ClassGroup R,
          χ₀ (J_rep (C₁ * C₂)) = χ₀ (J_rep C₁) * χ₀ (J_rep C₂) := by
        intro C₁ C₂
        have h_cls : ClassGroup.mk0 (J_rep (C₁ * C₂)) =
            ClassGroup.mk0 (J_rep C₁ * J_rep C₂) := by
          rw [hJ_cls (C₁ * C₂), mul_inv, map_mul, hJ_cls C₁, hJ_cls C₂]
        rw [hχ₀_class_eq _ _ h_cls, map_mul]
      obtain ⟨I₀, _hI₀_cop, hI₀_ne⟩ := hχ₀_nonprin
      let C₀ : ClassGroup R := (ClassGroup.mk0 I₀)⁻¹
      have hC₀_ne : χ₀ (J_rep C₀) ≠ 1 := by
        have h_cls : ClassGroup.mk0 (J_rep C₀) = ClassGroup.mk0 I₀ := by
          rw [hJ_cls C₀, inv_inv]
        rw [hχ₀_class_eq _ _ h_cls]
        exact hI₀_ne
      let S_cl : ℂ := ∑ C : ClassGroup R, χ₀ (J_rep C)
      have h_shift : ∑ C : ClassGroup R, χ₀ (J_rep (C₀ * C)) = S_cl :=
        Fintype.sum_equiv (Equiv.mulLeft C₀)
          (fun C => χ₀ (J_rep (C₀ * C))) (fun C => χ₀ (J_rep C)) (fun _ => rfl)
      have h_pull : ∑ C : ClassGroup R, χ₀ (J_rep (C₀ * C)) = χ₀ (J_rep C₀) * S_cl := by
        dsimp [S_cl]
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun C _ => hJ_mul C₀ C)
      have h_sub_zero : (χ₀ (J_rep C₀) - 1) * S_cl = 0 := by
        calc (χ₀ (J_rep C₀) - 1) * S_cl
          _ = χ₀ (J_rep C₀) * S_cl - S_cl := by ring
          _ = (∑ C : ClassGroup R, χ₀ (J_rep (C₀ * C))) - S_cl := by rw [← h_pull]
          _ = S_cl - S_cl := by rw [h_shift]
          _ = 0 := sub_self S_cl
      have hS_cl_zero : S_cl = 0 :=
        (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hC₀_ne)
      have hS_star_zero : (∑ C : ClassGroup R, star (χ₀ (J_rep C))) = 0 := by
        rw [← star_sum]
        change star S_cl = 0
        rw [hS_cl_zero, star_zero]
      exact ⟨hS_star_zero, hS_cl_zero⟩
  · left
    have h0_not_unit : ¬ IsUnit (0 : R ⧸ f) := by
      intro h0
      have h0_eq : (0 : R ⧸ f) = 1 := isUnit_zero_iff.mp h0
      have h1_mk_zero : Ideal.Quotient.mk f 1 = 0 := by
        rw [map_one, ← h0_eq]
      have h1_mem : (1 : R) ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h1_mk_zero
      exact hf_top ((Ideal.eq_top_iff_one f).mpr h1_mem)
    have hψ_zero : ψ_f 0 = 0 := (hψ_unit 0).2 h0_not_unit
    refine ⟨hf_top, hψ_zero, ?_⟩
    intro h_fin
    letI : Fintype (R ⧸ f) := h_fin
    obtain ⟨x_u, hu₀, _hx_u_mem, hψ_u₀⟩ := hψ_prim ⊤ le_top (Ne.symm hf_top)
    let u₀ : R ⧸ f := Ideal.Quotient.mk f x_u
    let u_unit : (R ⧸ f)ˣ := hu₀.unit
    have hu_unit_eq : (u_unit : R ⧸ f) = u₀ := hu₀.unit_spec
    let e : (R ⧸ f) ≃ (R ⧸ f) :=
      { toFun := fun a => u₀ * a
        invFun := fun a => ↑(u_unit⁻¹) * a
        left_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.inv_mul, one_mul]
        right_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.mul_inv, one_mul] }
    let S : ℂ := ∑ a : R ⧸ f, ψ_f a
    have h_shift : (∑ a : R ⧸ f, ψ_f (u₀ * a)) = S :=
      Fintype.sum_equiv e (fun a => ψ_f (u₀ * a)) ψ_f (fun _ => rfl)
    have h_pull : (∑ a : R ⧸ f, ψ_f (u₀ * a)) = ψ_f u₀ * S := by
      dsimp [S]
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun a _ => hψ_mul u₀ a)
    have h_sub_zero : (ψ_f u₀ - 1) * S = 0 := by
      calc (ψ_f u₀ - 1) * S
        _ = ψ_f u₀ * S - S := by ring
        _ = (∑ a : R ⧸ f, ψ_f (u₀ * a)) - S := by rw [← h_pull]
        _ = S - S := by rw [h_shift]
        _ = 0 := sub_self S
    exact (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hψ_u₀)

theorem mitsui_classGroup_cube_nonzero_lattice_sum_eq_full_ideal_sum {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), star (χ₀ (J_rep C))) = 0 ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), χ₀ (J_rep C)) = 0))
    (b : ℝ) (hb : 0 < b) (s : ℝ) (hs : s = 1 ∨ s = -1) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    (∑ C : ClassGroup R,
