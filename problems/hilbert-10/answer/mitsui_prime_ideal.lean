theorem mitsui_hat_grid_multiSlice_phase_frozen_sandwich {ι_ξ ι_b ι_complex β_real : Type*}
    [Fintype ι_ξ] [Fintype ι_b] [Fintype ι_complex] [DecidableEq ι_complex] [DecidableEq β_real]
