      have h1 := congrArg norm h_pow_mul
      rw [AddChar.norm_apply, norm_mul, norm_pow, hϕ_norm x hx_ne, mul_one] at h1
      exact h1.symm
    exact (pow_eq_one_iff_of_nonneg (norm_nonneg (χ₀ I)) hh_K_ne).mp h_norm_pow
  · intro h_not_sup
    dsimp [χ₀]
    exact if_neg h_not_sup

theorem mitsui_riesz_primePower_char_torsion_avg_log_cell_eq_uncond_of_splitting {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ)
