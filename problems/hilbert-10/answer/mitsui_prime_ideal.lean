    have h_ineq3 : Real.log (m : ℝ) * (2 : ℝ) + (-c_decay * (m : ℝ) ^ α) ≤ K₀ + Real.log (m : ℝ) * (-2 : ℝ) := by
      linarith
    have h_exp_ineq : Real.exp (Real.log (m : ℝ) * (2 : ℝ) + (-c_decay * (m : ℝ) ^ α)) ≤
        Real.exp (K₀ + Real.log (m : ℝ) * (-2 : ℝ)) :=
      Real.exp_le_exp.mpr h_ineq3
    rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hm_pos (2 : ℝ),
        ← Real.rpow_def_of_pos hm_pos (-2 : ℝ), Real.rpow_neg (le_of_lt hm_pos) (2 : ℝ)] at h_exp_ineq
    exact h_exp_ineq
  let maj : ℕ → ℝ := fun m => (M₁ * C₁ * Real.exp K₀) * ((m : ℝ) ^ (2 : ℝ))⁻¹
  have h_maj_sum : Summable maj :=
    (Real.summable_nat_rpow_inv.mpr one_lt_two).mul_left (M₁ * C₁ * Real.exp K₀)
  let K_ker : ℕ → ℝ := fun m =>
    (((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A *
      J_maj (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ))))
  have hK_ker_nn : ∀ m : ℕ, 0 ≤ K_ker m := by
    intro m
    dsimp [K_ker]
    have h_in_nn : 0 ≤ S_f * ((m : ℝ) * v) := by positivity
    have h_pow_nn : 0 ≤ ((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A :=
      pow_nonneg (Real.rpow_nonneg h_in_nn _) A
    exact mul_nonneg h_pow_nn (hJ_maj_nn _)
  let term : ClassGroup R → ℕ → ℂ := fun C m =>
    (∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (K_ker m : ℂ)
  have h_term_sum : ∀ C : ClassGroup R, Summable (fun m : ℕ => star (ψ (J_rep C)) * term C m) := by
    intro C
    refine Summable.of_norm_bounded h_maj_sum (fun m => ?_)
    rw [norm_mul, norm_star, hψ_rep C, one_mul]
    dsimp [term]
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hK_ker_nn m)]
    have h_card_step : ‖∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ * K_ker m ≤
        (Nat.card (S_m m) : ℝ) * K_ker m :=
      mul_le_mul_of_nonneg_right ((h_s2 m).2 C) (hK_ker_nn m)
    refine le_trans h_card_step ?_
    by_cases hm0 : m = 0
    · subst hm0
      haveI h_empty : IsEmpty (S_m 0) := by
        refine ⟨fun I => ?_⟩
        exact I.2.1 (Ideal.absNorm_eq_zero_iff.mp I.2.2)
      rw [Nat.card_of_isEmpty, Nat.cast_zero, zero_mul]
      dsimp [maj]
      positivity
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα_pos)
      have hmα_nn : 0 ≤ (m : ℝ) ^ α := le_trans zero_le_one hmα_ge_one
      have h_in_eq : S_f * ((m : ℝ) * v) = b_scale * (m : ℝ) := by
        dsimp [b_scale]
        ring
      have ha_eq : Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ)) = a₀ * (m : ℝ) ^ α := by
        rw [h_in_eq]
        change Real.pi * (b_scale * (m : ℝ)) ^ α = a₀ * (m : ℝ) ^ α
        rw [Real.mul_rpow (le_of_lt hb_pos) (le_of_lt hm_pos)]
        dsimp [a₀]
        ring
      have ha_ge : a₀ ≤ a₀ * (m : ℝ) ^ α :=
        le_mul_of_one_le_right (le_of_lt ha₀_pos) hmα_ge_one
      have hJ_le := hJ_maj_bound (a₀ * (m : ℝ) ^ α) ha_ge
      have h_rpow_le : (m : ℝ) ^ (1 / (n : ℝ)) ≤ (m : ℝ) ^ α := by
        refine Real.rpow_le_rpow_of_exponent_le hm_ge_one ?_
        dsimp [α]
        exact div_le_div_of_nonneg_right (by norm_num) (le_of_lt hn_pos)
      have hmα_le_exp : (m : ℝ) ^ α ≤ η⁻¹ * Real.exp (η * (m : ℝ) ^ α) := by
        have h1 := Real.add_one_le_exp (η * (m : ℝ) ^ α)
        have h2 : η * (m : ℝ) ^ α ≤ Real.exp (η * (m : ℝ) ^ α) := by linarith
        have h3 := mul_le_mul_of_nonneg_left h2 (le_of_lt (inv_pos.mpr hη_pos))
        have h_lhs : η⁻¹ * (η * (m : ℝ) ^ α) = (m : ℝ) ^ α := by
          field_simp [hη_ne]
        rwa [h_lhs] at h3
      have hAη_le : (A : ℝ) * η ≤ ((n : ℝ) / 4) * a₀ := by
        dsimp [η]
        rw [mul_div_assoc', div_le_iff₀ (by positivity)]
        have : (A : ℝ) ≤ (A : ℝ) + 1 := by linarith
        nlinarith
      have h_poly_le : ((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A ≤
          (b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) := by
        rw [h_in_eq, Real.mul_rpow (le_of_lt hb_pos) (le_of_lt hm_pos), mul_pow, mul_assoc]
        refine mul_le_mul_of_nonneg_left ?_ (pow_nonneg (Real.rpow_nonneg (le_of_lt hb_pos) _) A)
        have h_pow1 : ((m : ℝ) ^ (1 / (n : ℝ))) ^ A ≤ (η⁻¹ * Real.exp (η * (m : ℝ) ^ α)) ^ A :=
          pow_le_pow_left₀ (Real.rpow_nonneg (le_of_lt hm_pos) _) (le_trans h_rpow_le hmα_le_exp) A
        rw [mul_pow, ← Real.exp_nat_mul] at h_pow1
        have h_exp_A : Real.exp ((A : ℝ) * (η * (m : ℝ) ^ α)) ≤ Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) := by
          rw [Real.exp_le_exp]
          have h_mul := mul_le_mul_of_nonneg_right hAη_le hmα_nn
          linarith
        exact le_trans h_pow1 (mul_le_mul_of_nonneg_left h_exp_A (by positivity))
      have hK_ker_m : K_ker m ≤ M₁ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
        dsimp [K_ker]
        rw [ha_eq]
        have h_prod_le : (((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A) * J_maj (a₀ * (m : ℝ) ^ α) ≤
            ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
              (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) :=
          mul_le_mul h_poly_le hJ_le (hJ_maj_nn _) (by positivity)
        have h_rhs_eq :
            ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
              (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) =
            M₁ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
          have h_rearrange :
              ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
                (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) =
              M₁ * (Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) := by
            dsimp [M₁]
            ring
          rw [h_rearrange, ← Real.exp_add]
          congr 2
          dsimp [c_decay]
          ring
        rwa [h_rhs_eq] at h_prod_le
      have hm_le_sq : (m : ℝ) ≤ (m : ℝ) ^ (2 : ℝ) := by
        rw [Real.rpow_two]
        nlinarith
      have h_card_m : (Nat.card (S_m m) : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (Nat.card (S_m m) : ℝ)
            ≤ C₁ * (m : ℝ) := ha_K_bound m hm_ge_one_nat
          _ ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := mul_le_mul_of_nonneg_left hm_le_sq (le_of_lt hC₁_pos)
      have h_dom_m := h_dom m hm_ge_one_nat
      calc (Nat.card (S_m m) : ℝ) * K_ker m
          ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (M₁ * Real.exp (-c_decay * (m : ℝ) ^ α)) :=
            mul_le_mul h_card_m hK_ker_m (hK_ker_nn m) (by positivity)
        _ = (M₁ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c_decay * (m : ℝ) ^ α)) := by ring
        _ ≤ (M₁ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) :=
            mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = maj m := by dsimp [maj]; ring
  
  have h_lhs_eq :
      (∑' m : ℕ,
        (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (K_ker m : ℂ)) =
      ∑ C : ClassGroup R, star (ψ (J_rep C)) * (∑' m : ℕ, term C m) := by
    have h_step1 : ∀ m : ℕ,
        (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (K_ker m : ℂ) =
        ∑ C : ClassGroup R, star (ψ (J_rep C)) * term C m := by
      intro m
      rw [(h_s2 m).1, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun C _ => ?_)
      dsimp [term]
      ring
    simp_rw [h_step1]
    rw [Summable.tsum_finsetSum (fun C _ => h_term_sum C)]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    exact tsum_mul_left
  change (∑' m : ℕ,
      (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (K_ker m : ℂ)) = _
  rw [h_lhs_eq]
  refine Finset.sum_congr rfl (fun C _ => ?_)
  congr 1
  refine tsum_congr (fun m => ?_)
  dsimp [term, K_ker, A]
  congr 2
  have hJ_ne : (J_rep C : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero (J_rep C)
  have hNJ_ne : (Ideal.absNorm (J_rep C : Ideal R) : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hJ_ne)
  have h_cancel :
      (S_f * v / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
        ((Ideal.absNorm (J_rep C : Ideal R) : ℝ) * (m : ℝ)) =
      S_f * ((m : ℝ) * v) := by
    field_simp [hNJ_ne]
  rw [h_cancel]

theorem mitsui_primitive_narrow_ray_char_exists_quotient_char_and_zero_mode {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0))
    (hψ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ ψ₀ I₀ ≠ 1)
    (hψ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
        ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1)
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (hψ₀_prin_sign : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w)) :
    let R := NumberField.RingOfIntegers K
    ∃ ψ_f : (R ⧸ f) → ℂ,
      ψ_f 1 = 1 ∧
      (∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b) ∧
      (∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0)) ∧
      (∀ (x : R) (hx_ne : x ≠ 0),
        ψ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
          ψ_f (Ideal.Quotient.mk f x) *
            ∏ w : NumberField.InfinitePlace K,
              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w)) ∧
      (∀ f' : Ideal R, f ≤ f' → f' ≠ f →
        ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1) ∧
      ((f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
          ∀ (h_fin : Fintype (R ⧸ f)),
            @Finset.sum (R ⧸ f) ℂ _ (@Finset.univ (R ⧸ f) h_fin) ψ_f = 0) ∨
        (f = ⊤ ∧ (∀ a : R ⧸ f, ψ_f a = 1) ∧
          ((∃ w : NumberField.InfinitePlace K, a_place w ≠ 0) ∨
            ((∀ w : NumberField.InfinitePlace K, a_place w = 0) ∧
              ∀ J_rep : ClassGroup R → nonZeroDivisors (Ideal R),
                (∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹) →
                (∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤) →
                (∑ C : ClassGroup R, star (ψ₀ (J_rep C))) = 0 ∧
                (∑ C : ClassGroup R, ψ₀ (J_rep C)) = 0)))) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : R → ℂ := fun x =>
    ∏ w : NumberField.InfinitePlace K,
      (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w)
  have h_re_eq : ∀ (x : R) (w : NumberField.InfinitePlace K) (hw : w.IsReal),
      (w.embedding (x : K)).re = NumberField.InfinitePlace.embedding_of_isReal hw (x : K) := by
    intro x w hw
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)
    rw [← h1, Complex.ofReal_re]
  have h_emb_real : ∀ (x : R) (w : NumberField.InfinitePlace K),
      w.IsReal → w.embedding (x : K) = ((w.embedding (x : K)).re : ℂ) := by
    intro x w hw
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)
    rw [h_re_eq x w hw, h1]
  have h_norm_real : ∀ (x : R) (w : NumberField.InfinitePlace K),
      w.IsReal → w (x : K) = |(w.embedding (x : K)).re| := by
    intro x w hw
    conv_lhs =>
      rw [← NumberField.InfinitePlace.norm_embedding_eq, h_emb_real x w hw,
        Complex.norm_real, Real.norm_eq_abs]
  have h_real_pos : ∀ (x : R) (w : NumberField.InfinitePlace K),
      w.IsReal → 0 < (w.embedding (x : K)).re →
      w.embedding (x : K) / (w (x : K) : ℂ) = 1 := by
    intro x w hw hpos
    rw [h_emb_real x w hw, h_norm_real x w hw, abs_of_pos hpos]
    exact div_self (Complex.ofReal_ne_zero.mpr (ne_of_gt hpos))
  have h_real_neg : ∀ (x : R) (w : NumberField.InfinitePlace K),
      w.IsReal → (w.embedding (x : K)).re < 0 →
      w.embedding (x : K) / (w (x : K) : ℂ) = -1 := by
    intro x w hw hneg
    rw [h_emb_real x w hw, h_norm_real x w hw, abs_of_neg hneg, Complex.ofReal_neg, div_neg]
    rw [div_self (Complex.ofReal_ne_zero.mpr (ne_of_lt hneg))]
  have h_re_ne_zero : ∀ (x : R), x ≠ 0 →
      ∀ (w : NumberField.InfinitePlace K), w.IsReal → (w.embedding (x : K)).re ≠ 0 := by
    intro x hx_ne w hw
    rw [h_re_eq x w hw]
    have hxK_ne : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    exact map_ne_zero_iff _ (NumberField.InfinitePlace.embedding_of_isReal hw).injective |>.mpr hxK_ne
  have hS_tot_pos : ∀ (x : R), x ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
      S x = 1 := by
    intro x _hx_ne h_pos
    dsimp [S]
    refine Finset.prod_eq_one (fun w _ => ?_)
    by_cases hw : w.IsReal
    · rw [h_real_pos x w hw (h_pos w hw), one_pow]
    · rw [ha_cplx w (NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw), pow_zero]
  have hS_mul_self : ∀ (x : R), x ≠ 0 → S x * S x = 1 := by
    intro x hx_ne
    dsimp [S]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_eq_one (fun w _ => ?_)
    by_cases hw : w.IsReal
    · rcases lt_or_gt_of_ne (h_re_ne_zero x hx_ne w hw) with hneg | hpos
      · rw [h_real_neg x w hw hneg, ← sq, ← pow_mul, mul_comm (a_place w) 2,
          pow_mul, neg_one_sq, one_pow]
      · rw [h_real_pos x w hw hpos, one_pow, mul_one]
    · rw [ha_cplx w (NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw), pow_zero, mul_one]
  have hS_norm : ∀ (x : R), x ≠ 0 → ‖S x‖ = 1 := by
    intro x hx_ne
    have h1 : ‖S x‖ * ‖S x‖ = 1 := by
      rw [← norm_mul, hS_mul_self x hx_ne, norm_one]
    have h2 : 0 ≤ ‖S x‖ := norm_nonneg (S x)
    nlinarith
  have hS_mul : ∀ (x y : R), S (x * y) = S x * S y := by
    intro x y
    dsimp [S]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    have hxy_coe : ((x * y : R) : K) = (x : K) * (y : K) := by push_cast; rfl
    rw [hxy_coe, map_mul, map_mul, Complex.ofReal_mul, mul_div_mul_comm, mul_pow]
  have h_unit_iff_sup : ∀ x : R,
      IsUnit (Ideal.Quotient.mk f x) ↔
        Ideal.span ({x} : Set R) ⊔ f = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑(hx.unit⁻¹) : R ⧸ f)
      have h_mk_zero : Ideal.Quotient.mk f (1 - x * y) = 0 := by
        rw [map_sub, map_one, map_mul, ← hx.unit_spec, hy, Units.mul_inv, sub_self]
      have h_mem_f : 1 - x * y ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero
      have h_mem_span : x * y ∈ Ideal.span ({x} : Set R) :=
        Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      exact ⟨x * y, h_mem_span, 1 - x * y, h_mem_f, add_sub_cancel (x * y) 1⟩
    · intro h_top
      have h_one : (1 : R) ∈ Ideal.span ({x} : Set R) ⊔ f :=
        (Ideal.eq_top_iff_one _).mp h_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h_one
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have h_mk : Ideal.Quotient.mk f x * Ideal.Quotient.mk f y = 1 := by
        have h1 := congrArg (Ideal.Quotient.mk f) hab
        rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at h1
        exact h1
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk f y) h_mk
  have hf_bot : f ≠ ⊥ := hf
  obtain ⟨z₀, hz₀_mem, hz₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hf_bot
  have hz₀_mk : Ideal.Quotient.mk f z₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hz₀_mem
  let x₀ : (R ⧸ f) → R := fun a => (Ideal.Quotient.mk_surjective a).choose
  have hx₀ : ∀ a : R ⧸ f, Ideal.Quotient.mk f (x₀ a) = a :=
    fun a => (Ideal.Quotient.mk_surjective a).choose_spec
  let lift_nz : (R ⧸ f) → R := fun a => if x₀ a = 0 then z₀ else x₀ a
  have hlift_ne : ∀ a : R ⧸ f, lift_nz a ≠ 0 := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · exact hz₀_ne
    · exact h0
  have hlift_mk : ∀ a : R ⧸ f, Ideal.Quotient.mk f (lift_nz a) = a := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · rw [hz₀_mk, ← hx₀ a, h0, map_zero]
    · exact hx₀ a
  let P : ∀ (x : R), x ≠ 0 → nonZeroDivisors (Ideal R) :=
    fun x hx => ⟨Ideal.span ({x} : Set R),
      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx)⟩
  have hP_mul : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      P (x * y) (mul_ne_zero hx hy) = P x hx * P y hy := by
    intro x y hx hy
    exact Subtype.ext (Ideal.span_singleton_mul_span_singleton x y).symm
  let F : ∀ (x : R), x ≠ 0 → ℂ := fun x hx => ψ₀ (P x hx) * S x
  have hF_mul : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
       F (x * y) (mul_ne_zero hx hy) = F x hx * F y hy := by
    intro x y hx hy
    dsimp [F]
    rw [hP_mul x y hx hy, map_mul, hS_mul x y]
    ring
  have hF_ray : ∀ (x : R) (hx : x ≠ 0), x - 1 ∈ f → F x hx = 1 := by
    intro x hx hx_sub
    dsimp [F]
    rw [hψ₀_prin_sign x hx hx_sub]
    exact hS_mul_self x hx
  have hF_norm_supp : ∀ (x : R) (hx : x ≠ 0),
      ((P x hx : Ideal R) ⊔ f = ⊤ → ‖F x hx‖ = 1) ∧
      (¬ ((P x hx : Ideal R) ⊔ f = ⊤) → F x hx = 0) := by
    intro x hx
    constructor
    · intro h_top
      dsimp [F]
      rw [norm_mul, (hψ₀_norm_supp (P x hx)).1 h_top, hS_norm x hx, mul_one]
    · intro h_not_top
      dsimp [F]
      rw [(hψ₀_norm_supp (P x hx)).2 h_not_top, zero_mul]
  have h_congr : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      Ideal.Quotient.mk f x = Ideal.Quotient.mk f y →
      F x hx = F y hy := by
    intro x y hx hy h_eq
    by_cases hu : IsUnit (Ideal.Quotient.mk f x)
    · let u_x : (R ⧸ f)ˣ := hu.unit
      have hu_x_eq : (u_x : R ⧸ f) = Ideal.Quotient.mk f x := hu.unit_spec
      let b : R ⧸ f := ↑(u_x⁻¹)
      let z : R := lift_nz b
      have hz : z ≠ 0 := hlift_ne b
      have hxz_mk : Ideal.Quotient.mk f (x * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, hlift_mk b]
        change Ideal.Quotient.mk f x * ↑(u_x⁻¹) = Ideal.Quotient.mk f 1
        rw [← hu_x_eq, Units.mul_inv, map_one]
      have hyz_mk : Ideal.Quotient.mk f (y * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, ← h_eq, ← map_mul, hxz_mk]
      have hxz_sub : x * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (x * z) 1).mp hxz_mk
      have hyz_sub : y * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (y * z) 1).mp hyz_mk
      have hxz_ray : F x hx * F z hz = 1 := by
        rw [← hF_mul x z hx hz]
        exact hF_ray (x * z) (mul_ne_zero hx hz) hxz_sub
      have hyz_ray : F y hy * F z hz = 1 := by
        rw [← hF_mul y z hy hz]
        exact hF_ray (y * z) (mul_ne_zero hy hz) hyz_sub
      have hz_ne_zero : F z hz ≠ 0 := right_ne_zero_of_mul_eq_one hxz_ray
      exact mul_right_cancel₀ hz_ne_zero (hxz_ray.trans hyz_ray.symm)
    · have hy_u : ¬ IsUnit (Ideal.Quotient.mk f y) := h_eq ▸ hu
      have hx_not_top : ¬ ((P x hx : Ideal R) ⊔ f = ⊤) :=
        fun h_top => hu ((h_unit_iff_sup x).mpr h_top)
      have hy_not_top : ¬ ((P y hy : Ideal R) ⊔ f = ⊤) :=
        fun h_top => hy_u ((h_unit_iff_sup y).mpr h_top)
      rw [(hF_norm_supp x hx).2 hx_not_top, (hF_norm_supp y hy).2 hy_not_top]
  let ψ_f : (R ⧸ f) → ℂ := fun a => F (lift_nz a) (hlift_ne a)
  have hψ_span_F : ∀ (x : R) (hx_ne : x ≠ 0),
      F x hx_ne = ψ_f (Ideal.Quotient.mk f x) := by
    intro x hx_ne
    exact h_congr x (lift_nz (Ideal.Quotient.mk f x)) hx_ne (hlift_ne _) (hlift_mk _).symm
  have hψ_span : ∀ (x : R) (hx_ne : x ≠ 0),
      ψ₀ (P x hx_ne) = ψ_f (Ideal.Quotient.mk f x) * S x := by
    intro x hx_ne
    calc ψ₀ (P x hx_ne)
      _ = ψ₀ (P x hx_ne) * (S x * S x) := by rw [hS_mul_self x hx_ne, mul_one]
      _ = F x hx_ne * S x := by dsimp [F]; ring
      _ = ψ_f (Ideal.Quotient.mk f x) * S x := by rw [hψ_span_F x hx_ne]
  have hψ_one : ψ_f 1 = 1 := by
    have h1_ne : (1 : R) ≠ 0 := one_ne_zero
    have h1_mk : Ideal.Quotient.mk f 1 = 1 := map_one _
    rw [← h1_mk, ← hψ_span_F 1 h1_ne]
    exact hF_ray 1 h1_ne (by rw [sub_self]; exact f.zero_mem)
  have hψ_mul : ∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b := by
    intro a b
    let x := lift_nz a
    let y := lift_nz b
    have hx : x ≠ 0 := hlift_ne a
    have hy : y ≠ 0 := hlift_ne b
    have hxy_mk : Ideal.Quotient.mk f (x * y) = a * b := by
      rw [map_mul, hlift_mk a, hlift_mk b]
    rw [← hxy_mk, ← hψ_span_F (x * y) (mul_ne_zero hx hy), hF_mul x y hx hy]
  have hψ_unit : ∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0) := by
    intro a
    have h_iff : IsUnit a ↔ (P (lift_nz a) (hlift_ne a) : Ideal R) ⊔ f = ⊤ := by
      conv_lhs => rw [← hlift_mk a]
      exact h_unit_iff_sup (lift_nz a)
    constructor
    · intro ha
      exact (hF_norm_supp (lift_nz a) (hlift_ne a)).1 (h_iff.mp ha)
    · intro ha
      exact (hF_norm_supp (lift_nz a) (hlift_ne a)).2 (fun h_top => ha (h_iff.mpr h_top))
  have hψ_prim : ∀ f' : Ideal R, f ≤ f' → f' ≠ f →
      ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1 := by
    intro f' hf_le hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_pos, hx_ne_one⟩ := hψ₀_prim f' hf_le hf'_ne
    refine ⟨x, (h_unit_iff_sup x).mpr hx_cop, hx_sub, ?_⟩
    have h_eq : ψ₀ (P x hx_ne) = ψ_f (Ideal.Quotient.mk f x) := by
      rw [hψ_span x hx_ne, hS_tot_pos x hx_ne hx_pos, mul_one]
    rw [← h_eq]
    exact hx_ne_one
  refine ⟨ψ_f, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, ?_⟩
  by_cases hf_top : f = ⊤
  · right
    refine ⟨hf_top, ?_, ?_⟩
    · intro a
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
      have hx_sub : x - 1 ∈ f := hf_top ▸ Submodule.mem_top
      have hx_mk : Ideal.Quotient.mk f x = 1 := by
        have h1 := (Ideal.Quotient.mk_eq_mk_iff_sub_mem x 1).mpr hx_sub
        rwa [map_one] at h1
      rw [hx_mk, hψ_one]
    · by_cases h_a : ∃ w : NumberField.InfinitePlace K, a_place w ≠ 0
      · exact Or.inl h_a
      · right
        have ha0 : ∀ w : NumberField.InfinitePlace K, a_place w = 0 :=
          fun w => not_not.mp (not_exists.mp h_a w)
        refine ⟨ha0, ?_⟩
        intro J_rep hJ_cls _hJ_cop
        have hψ₀_prin : ∀ (x : R) (hx_ne : x ≠ 0), ψ₀ (P x hx_ne) = 1 := by
          intro x hx_ne
          rw [hψ₀_prin_sign x hx_ne (hf_top ▸ Submodule.mem_top)]
          exact Finset.prod_eq_one (fun w _ => by rw [ha0 w, pow_zero])
        have hψ₀_class_eq : ∀ I₁ I₂ : nonZeroDivisors (Ideal R),
            ClassGroup.mk0 I₁ = ClassGroup.mk0 I₂ → ψ₀ I₁ = ψ₀ I₂ := by
          intro I₁ I₂ h_mk
          obtain ⟨x, y, hx, hy, h_mul⟩ := ClassGroup.mk0_eq_mk0_iff.mp h_mk
          have h_sub_eq : P x hx * I₁ = P y hy * I₂ := Subtype.ext h_mul
          have h_ap := congrArg ψ₀ h_sub_eq
          rw [map_mul, map_mul, hψ₀_prin x hx, hψ₀_prin y hy, one_mul, one_mul] at h_ap
          exact h_ap
        have hJ_mul : ∀ C₁ C₂ : ClassGroup R,
            ψ₀ (J_rep (C₁ * C₂)) = ψ₀ (J_rep C₁) * ψ₀ (J_rep C₂) := by
          intro C₁ C₂
          have h_cls : ClassGroup.mk0 (J_rep (C₁ * C₂)) =
              ClassGroup.mk0 (J_rep C₁ * J_rep C₂) := by
            rw [hJ_cls (C₁ * C₂), mul_inv, map_mul, hJ_cls C₁, hJ_cls C₂]
          rw [hψ₀_class_eq _ _ h_cls, map_mul]
        obtain ⟨I₀, _hI₀_cop, hI₀_ne⟩ := hψ₀_nonprin
        let C₀ : ClassGroup R := (ClassGroup.mk0 I₀)⁻¹
        have hC₀_ne : ψ₀ (J_rep C₀) ≠ 1 := by
          have h_cls : ClassGroup.mk0 (J_rep C₀) = ClassGroup.mk0 I₀ := by
            rw [hJ_cls C₀, inv_inv]
          rw [hψ₀_class_eq _ _ h_cls]
          exact hI₀_ne
        let S_cl : ℂ := ∑ C : ClassGroup R, ψ₀ (J_rep C)
        have h_shift : ∑ C : ClassGroup R, ψ₀ (J_rep (C₀ * C)) = S_cl :=
          Fintype.sum_equiv (Equiv.mulLeft C₀)
            (fun C => ψ₀ (J_rep (C₀ * C))) (fun C => ψ₀ (J_rep C)) (fun _ => rfl)
        have h_pull : ∑ C : ClassGroup R, ψ₀ (J_rep (C₀ * C)) = ψ₀ (J_rep C₀) * S_cl := by
          dsimp [S_cl]
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun C _ => hJ_mul C₀ C)
        have h_sub_zero : (ψ₀ (J_rep C₀) - 1) * S_cl = 0 := by
          calc (ψ₀ (J_rep C₀) - 1) * S_cl
            _ = ψ₀ (J_rep C₀) * S_cl - S_cl := by ring
            _ = (∑ C : ClassGroup R, ψ₀ (J_rep (C₀ * C))) - S_cl := by rw [← h_pull]
            _ = S_cl - S_cl := by rw [h_shift]
            _ = 0 := sub_self S_cl
        have hS_cl_zero : S_cl = 0 :=
          (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hC₀_ne)
        have hS_star_zero : (∑ C : ClassGroup R, star (ψ₀ (J_rep C))) = 0 := by
          rw [← star_sum]
          change star S_cl = 0
          rw [hS_cl_zero, star_zero]
        exact ⟨hS_star_zero, hS_cl_zero⟩
  · left
    have h0_not_unit : ¬ IsUnit (0 : R ⧸ f) := by
      intro h0
      have h0_eq : (0 : R ⧸ f) = 1 := isUnit_zero_iff.mp h0
      have h1_mk_zero : Ideal.Quotient.mk f 1 = 0 := by
        rw [map_one, ← h0_eq]
      have h1_mem : (1 : R) ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h1_mk_zero
      exact hf_top ((Ideal.eq_top_iff_one f).mpr h1_mem)
    have hψ_zero : ψ_f 0 = 0 := (hψ_unit 0).2 h0_not_unit
    refine ⟨hf_top, hψ_zero, ?_⟩
    intro h_fin
    letI : Fintype (R ⧸ f) := h_fin
    obtain ⟨x_u, hu₀, _hx_u_mem, hψ_u₀⟩ := hψ_prim ⊤ le_top (Ne.symm hf_top)
    let u₀ : R ⧸ f := Ideal.Quotient.mk f x_u
    let u_unit : (R ⧸ f)ˣ := hu₀.unit
    have hu_unit_eq : (u_unit : R ⧸ f) = u₀ := hu₀.unit_spec
    let e : (R ⧸ f) ≃ (R ⧸ f) :=
      { toFun := fun a => u₀ * a
        invFun := fun a => ↑(u_unit⁻¹) * a
        left_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.inv_mul, one_mul]
        right_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.mul_inv, one_mul] }
    let S_sum : ℂ := ∑ a : R ⧸ f, ψ_f a
    have h_shift : (∑ a : R ⧸ f, ψ_f (u₀ * a)) = S_sum :=
      Fintype.sum_equiv e (fun a => ψ_f (u₀ * a)) ψ_f (fun _ => rfl)
    have h_pull : (∑ a : R ⧸ f, ψ_f (u₀ * a)) = ψ_f u₀ * S_sum := by
      dsimp [S_sum]
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun a _ => hψ_mul u₀ a)
    have h_sub_zero : (ψ_f u₀ - 1) * S_sum = 0 := by
      calc (ψ_f u₀ - 1) * S_sum
        _ = ψ_f u₀ * S_sum - S_sum := by ring
        _ = (∑ a : R ⧸ f, ψ_f (u₀ * a)) - S_sum := by rw [← h_pull]
        _ = S_sum - S_sum := by rw [h_shift]
        _ = 0 := sub_self S_sum
    exact (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hψ_u₀)

theorem mitsui_principal_subideal_narrow_tsum_eq_torsion_inv_mul_cube_integral_lattice {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K))
    (J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (ψ_res : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ψ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ_res (Ideal.Quotient.mk f x) *
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w))
    (b : ℝ) (hb : 0 < b) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let Q_K : (Fin r → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin r,
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)
    let U_K : (Fin r → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin r,
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)
    let J_maj : ℝ → ℝ := fun a =>
      ∫ y : Fin r → ℝ, U_K y * Real.exp (-a * Q_K y)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((((((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) *
        J_maj (Real.pi * ((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℝ) : ℂ))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J : Ideal R)},
            ψ_res (Ideal.Quotient.mk f x.1) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding (x.1 : K) *
                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
              (((((b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                  (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ)))) ∧
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((((((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) *
        J_maj (Real.pi * ((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℝ) : ℂ))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J : Ideal R)},
            ψ_res (Ideal.Quotient.mk f x.1) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding (x.1 : K) *
                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
              (((((b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                  (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)))) :=
by
  classical
  intro R n r Q_K U_K J_maj Cube
  haveI : Countable R :=
    Function.Injective.countable (Module.Free.chooseBasis ℤ R).repr.injective
  let A_exp : ℕ := ∑ w : NumberField.InfinitePlace K, a_place w
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  have hn_pos_nat : 0 < n := Module.finrank_pos
  have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn_pos_nat
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  
  have h_gauss_int : ∀ (a : ℝ), 0 < a →
      MeasureTheory.Integrable (fun y : Fin r → ℝ => Real.exp (-a * Q_K y)) MeasureTheory.volume := by
    intro a ha
    let w₀ : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    let S := {w : NumberField.InfinitePlace K // w ≠ w₀}
    let e : Fin r ≃ S := NumberField.Units.equivFinRank K
    let L : NumberField.InfinitePlace K → (Fin r → ℝ) → ℝ := fun w y =>
