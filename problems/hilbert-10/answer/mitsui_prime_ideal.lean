            Real.exp (-Real.pi * c ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                v_place w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
