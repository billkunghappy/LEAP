  · intro I
    refine ⟨fun hI => ?_, fun hI => ?_⟩
    · change ‖f_lam I * χ I‖ = 1
      rw [norm_mul, hf_lam_norm I, (hχ_norm I).1 hI, mul_one]
    · change f_lam I * χ I = 0
