        Complex.exp_int_mul_two_pi_mul_I (-(∑ j : Fin r, m_freq j * d j)), mul_one]
    change ((f_τ I_x * f_W I_x) * χ I_x) *
        Complex.exp
          (((∑ j : Fin r,
              y j * (-2 * Real.pi * (m_freq j : ℝ) + A_arg j)) : ℝ) * Complex.I) =
      χ I_x *
        ∏ w : NumberField.InfinitePlace K,
