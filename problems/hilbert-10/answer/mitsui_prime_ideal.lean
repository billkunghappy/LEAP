      (le_div_iff₀ hL_pos).mpr h_sq_ineq
    have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
    have hu_inv_le_c₁ : u⁻¹ ≤ c₁ := by
