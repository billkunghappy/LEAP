            g_ψ s = LSeries (fun n =>
              ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
          (∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 →
            ‖g_ψ s‖ ≤ A₃ * ((Ideal.absNorm b : ℝ) * (4 + |s.im|)) ^ (Module.finrank ℚ K + 1)) := by
    intro b hb ψ hψ_narrow hψ_norm_supp hψ_nonprin
    have hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1 := by
      intro I
      by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤
