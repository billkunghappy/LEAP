    rw [h_sum_1, h_sum_ge1]
    ring
  have h_term_norm_le : ∀ pm : D_ge1, ¬ (pm.1.2 = 1) →
      ‖term_ge1 pm‖ ≤ B * Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
    intro pm hne
    have hν2 : 2 ≤ pm.1.2 := by have := pm.2.1; omega
    have hM_le : (M_cell (pm.1.1.asIdeal ^ pm.1.2) : ℝ) ≤ B := hB pm.1.1 pm.1.2 hν2
    have hlog_nonneg : 0 ≤ Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
      Real.log_natCast_nonneg _
    dsimp [term_ge1]
    rw [norm_mul, norm_mul, Complex.norm_natCast, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hlog_nonneg]
    exact mul_le_mul_of_nonneg_right hM_le hlog_nonneg
  have h_norm_diff : ‖(∑' p : D_1, term_1 p) - (∑' pm : D_ge1, term_ge1 pm)‖ ≤
