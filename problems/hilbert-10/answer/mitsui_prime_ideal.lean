      rw [hY₀_exp, ← Real.exp_add]
    have h_arg_ge : Real.log X ≤ (n : ℝ) * Real.log X + Real.log X * S_exp := by
      have h1 : Real.log X * (1 - (n : ℝ)) ≤ Real.log X * S_exp :=
