        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le
      linarith
    have hWc1_exp_le : (W * c₁) * Real.exp δ ≤ c * Real.exp 1 :=
      mul_le_mul hWc₁_le hexpδ_le_e (le_of_lt (Real.exp_pos δ)) (le_of_lt hc_pos)
    calc W * |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y|
      _ ≤ W * (c₁ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁)) :=
          mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
      _ = (W * c₁) * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) := by ring
      _ ≤ (W * c₁) * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = ((W * c₁) * Real.exp δ) * (Y * δ ^ 2) := by ring
      _ ≤ (c * Real.exp 1) * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right hWc1_exp_le (by positivity)
      _ = (c * Real.exp 1) * Y * δ ^ 2 := by ring
  have hZ_minus_pos : 0 < Real.exp (-δ) * Y := mul_pos (Real.exp_pos (-δ)) hY_pos
  have hΨ₁_K_Z_minus : W * |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
      (c * Real.exp (1 / c)) * Y * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
        c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp (-δ) * Y)) / c₁) :=
      hc₁ (Real.exp (-δ) * Y) hZ_minus_pos
    have hlog_eq : Real.log (Real.exp (-δ) * Y) = Real.log Y - δ := by
      rw [Real.log_mul (ne_of_gt (Real.exp_pos (-δ))) (ne_of_gt hY_pos), Real.log_exp]
      ring
    set u : ℝ := Real.log (Real.exp (-δ) * Y)
    have hu_le_sq : u ≤ Real.sqrt u ^ 2 := by
      rcases le_or_gt 0 u with hu | hu
