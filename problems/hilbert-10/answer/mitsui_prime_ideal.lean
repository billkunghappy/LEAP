    Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hq_norm_ge_one_nat : 1 ≤ Ideal.absNorm q :=
    Nat.one_le_iff_ne_zero.mpr hq_norm_ne_zero
  have hq_norm_ge_one : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    exact_mod_cast hq_norm_ge_one_nat
  have hMq_ge_one : 1 ≤ M_q := by
    dsimp [M_q]
    exact Real.one_le_rpow hq_norm_ge_one (by positivity)
  have hMq_le_sqrt : M_q ≤ Real.sqrt (Real.log Y) := by
    dsimp [M_q]
    have h1 : (Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) ≤
        (Real.log Y ^ A) ^ (1 / (2 * (A : ℝ))) :=
      Real.rpow_le_rpow (by positivity) (le_of_lt hq_norm) (by positivity)
    have h2 : (Real.log Y ^ A) ^ (1 / (2 * (A : ℝ))) = Real.sqrt (Real.log Y) := by
      rw [← Real.rpow_natCast (Real.log Y) A,
        ← Real.rpow_mul (le_of_lt hlogY_pos)]
