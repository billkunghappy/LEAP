  refine ⟨l_eff, ψ_f, hl_eff_real, hl_eff_cplx, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, ?_⟩
  by_cases hf_top : f = ⊤
  · right
    have hψ_eq_top : ∀ a : R ⧸ f, ψ_f a = 1 := by
      intro a
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
      have hx_sub : x - 1 ∈ f := hf_top ▸ Submodule.mem_top
      have hx_mk : Ideal.Quotient.mk f x = 1 := by
        have h1 := (Ideal.Quotient.mk_eq_mk_iff_sub_mem x 1).mpr hx_sub
