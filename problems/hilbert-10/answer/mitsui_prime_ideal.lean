      have h_meas_cyl_ind : Measurable (A_cyl.indicator (fun q : ℝ × ℝ => ENNReal.ofReal q.1)) :=
        (ENNReal.measurable_ofReal.comp measurable_fst).indicator hA_cyl_meas
      have h_lint1 : ENNReal.ofReal ((R₁ ^ 2 - R₀ ^ 2) / 2) * MeasureTheory.volume S_cplx ≤
          MeasureTheory.volume (V_cplx R₁ \ V_cplx R₀) + MeasureTheory.volume D_col := by
        rw [← h_cyl_int, h_vol_diff_eq, h_vol_polar D_col hD_meas,
