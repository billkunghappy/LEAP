        rw [hε_i i, hε_i i₀] at hgi
        have hk0 := (k.1 i₀).isLt
        have hk'0 := (k'.1 i₀).isLt
        dsimp [d, σ]
        rw [hε_i i, hε_i i₀]
        cases h1 : ε k' i <;> cases h2 : ε k' i₀ <;> simp [h1, h2] at hgi ⊢ <;> omega
