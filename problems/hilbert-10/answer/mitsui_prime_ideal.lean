  have hNqM_pos : 0 < N_qM := lt_of_lt_of_le zero_lt_one hNqM_ge_one
  have hNqM_pow_ge_one : 1 ≤ N_qM ^ (n + 1) := one_le_pow₀ hNqM_ge_one
  have hNqM_pow_pos : 0 < N_qM ^ (n + 1) := by positivity
  let M_strip : ℝ := M₀ * N_qM ^ (n + 1)
  have hM_strip_pos : 0 < M_strip := by dsimp [M_strip]; positivity
  have hg_left : ∀ s : ℂ, s.re = -1 / 2 → ‖g_sq s‖ ≤ M_strip * (4 + |s.im|) ^ (n + 1) := by
    intro s hs
    obtain ⟨hγ_pos, hγ_eq⟩ := mitsui_archimedean_gamma_norm_eq_on_neg_half_re r₁ r₂ s hs
    rw [hr_eq] at hγ_eq
    have h_feq := hg_feq_le s hs
    set γ_s : ℂ := (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    set γ_1s : ℂ := (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂
    set L_1s : ℂ := LSeries (fun k =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = k},
        χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)
    have h_lhs_assoc : ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_sq s =
        (D : ℂ) ^ (s / 2) * γ_s * g_sq s := by
      dsimp [γ_s]; ring
    have h_rhs_assoc : ((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) * L_1s =
        (D : ℂ) ^ ((1 - s) / 2) * γ_1s * L_1s := by
      dsimp [γ_1s]; ring
    change ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_sq s‖ ≤
      C₀ * N_qM ^ (n + 1) * ‖((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) * L_1s‖ at h_feq
    rw [h_lhs_assoc, h_rhs_assoc] at h_feq
    simp only [norm_mul] at h_feq
    have hs_div_re : (s / 2).re = -1 / 4 := by
