      ∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => xpm.1.2.2 = 1), term_ge1 xpm := by
    have h1 : (∑' π : D_prime, term_prime π) = ∑' π : D_prime, term_ge1 (e_one π).1 :=
      tsum_congr h_term_e_one
    have h2 : (∑' π : D_prime, term_ge1 (e_one π).1) =
        ∑' xpm : {xpm : D_ge1 // xpm.1.2.2 = 1}, term_ge1 xpm.1 :=
      Equiv.tsum_eq e_one (fun xpm : {xpm : D_ge1 // xpm.1.2.2 = 1} => term_ge1 xpm.1)
    rw [h1, h2, tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun xpm : D_ge1 => xpm.1.2.2 = 1))
      (fun _ => by simp) term_ge1).symm
  have h_sum_ge1 : (∑' xpm : D_ge1, term_ge1 xpm) =
      (∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => xpm.1.2.2 = 1), term_ge1 xpm) +
      (∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)), term_ge1 xpm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ
      (fun xpm : D_ge1 => xpm.1.2.2 = 1) term_ge1).symm
  have h_diff : (∑' π : D_prime, term_prime π) - (∑' xpm : D_ge1, term_ge1 xpm) =
      - ∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)), term_ge1 xpm := by
    rw [h_sum_prime, h_sum_ge1]
    ring
  have h_term_norm : ∀ xpm : D_ge1,
      ‖term_ge1 xpm‖ = Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) := by
    intro xpm
    dsimp [term_ge1]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.log_natCast_nonneg _)]
  have h_norm_diff : ‖(∑' π : D_prime, term_prime π) - (∑' xpm : D_ge1, term_ge1 xpm)‖ ≤
      ∑ xpm : {xpm : D_ge1 // ¬ (xpm.1.2.2 = 1)}, Real.log (Ideal.absNorm xpm.1.1.2.1.asIdeal) := by
    rw [h_diff, norm_neg]
    calc ‖∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)), term_ge1 xpm‖
      _ ≤ ∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)), ‖term_ge1 xpm‖ :=
        norm_sum_le _ _
      _ = ∑ xpm ∈ Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)),
            Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) :=
        Finset.sum_congr rfl (fun xpm _ => h_term_norm xpm)
      _ = ∑ xpm : {xpm : D_ge1 // ¬ (xpm.1.2.2 = 1)}, Real.log (Ideal.absNorm xpm.1.1.2.1.asIdeal) :=
        Finset.sum_subtype (Finset.univ.filter (fun xpm : D_ge1 => ¬ (xpm.1.2.2 = 1)))
          (fun _ => by simp) (fun xpm : D_ge1 => Real.log (Ideal.absNorm xpm.1.2.1.asIdeal))
  let emb_ge2 : {xpm : D_ge1 // ¬ (xpm.1.2.2 = 1)} ↪ D_ge2 :=
    { toFun := fun xpm =>
        ⟨xpm.1.1, ⟨by have := xpm.1.2.1; have := xpm.2; omega,
          xpm.1.2.2.1,
          le_trans xpm.1.2.2.2.1 hY,
          fun w => h_cell_sub_sector w (xpm.1.2.2.2.2.2.1 w)⟩⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val hab
        apply Subtype.ext
        apply Subtype.ext
        exact hval }
  let F_ge2 : D_ge2 → ℝ := fun xpm => Real.log (Ideal.absNorm xpm.1.2.1.asIdeal)
  have h_le_ge2 : (∑ xpm : {xpm : D_ge1 // ¬ (xpm.1.2.2 = 1)},
      Real.log (Ideal.absNorm xpm.1.1.2.1.asIdeal)) ≤ ∑' xpm : D_ge2, F_ge2 xpm := by
    change (∑ xpm ∈ (Finset.univ : Finset {xpm : D_ge1 // ¬ (xpm.1.2.2 = 1)}),
        F_ge2 (emb_ge2 xpm)) ≤ ∑' xpm : D_ge2, F_ge2 xpm
    rw [← Finset.sum_map Finset.univ emb_ge2 F_ge2, tsum_fintype]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      (fun xpm _ _ => Real.log_natCast_nonneg _)
  exact le_trans h_norm_diff h_le_ge2

theorem mitsui_higher_primePower_log_sector_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_hpp : ℝ, 0 < c_hpp ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
                IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              2 ≤ xpm.2.2 ∧
              Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
              (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ X ^ (Module.finrank ℚ K) ∧
              ∀ w : NumberField.InfinitePlace K,
                Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈ Set.Ioc (-Real.log X) 0},
            Real.log (Ideal.absNorm xpm.1.2.1.asIdeal))
          ≤ c_hpp * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_hpp) :=
by
  classical
  have h_chebyshev : ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        Finite {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)} ∧
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
            Real.log (Ideal.absNorm pm.1.1.asIdeal))
          ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    have h_s1 : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ s : ℝ, 1 ≤ s →
        (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤
          C₁ * s := by
      set L_K : ℝ :=
        2 ^ NumberField.InfinitePlace.nrRealPlaces K *
          (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
          NumberField.Units.regulator K *
          (NumberField.classNumber K : ℝ) /
          ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
      have h_tendsto : Filter.Tendsto
          (fun s : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s)
          Filter.atTop (nhds L_K) :=
        NumberField.Ideal.tendsto_norm_le_div_atTop K
      obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
      let S₁ : ℝ := max S₀ 1
      let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
      let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
      have hC₁_pos : 0 < C₁ := by
        have h1 : 0 ≤ |L_K| := abs_nonneg L_K
        have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
        linarith
      refine ⟨C₁, hC₁_pos, ?_⟩
      intro s hs
      have hs_pos : 0 < s := lt_of_lt_of_le zero_lt_one hs
      by_cases hS : S₁ ≤ s
      · have hS₀_le : S₀ ≤ s := le_trans (le_max_left S₀ 1) hS
        have h_dist := hS₀ s hS₀_le
        rw [Real.dist_eq] at h_dist
        have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s - L_K < 1 :=
          (abs_sub_lt_iff.mp h_dist).1
        have h_abs : L_K ≤ |L_K| := le_abs_self L_K
        have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
        have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s ≤ C₁ := by linarith
        exact (div_le_iff₀ hs_pos).mp h_div_le
      · have hs_le : s ≤ S₁ := le_of_not_ge hS
        have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s} ⊆
            {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
          intro J hJ
          exact Nat.le_floor (le_trans hJ hs_le)
        have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
          Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
        have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} ≤ N₁ :=
          Nat.card_mono h_fin h_sub
        have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
        have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
        have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ := by linarith
        nlinarith
    have h_s2 : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        2 ≤ Ideal.absNorm p.asIdeal := by
      intro p
      have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
      omega
    have h_s3 : ∀ (X : ℝ), 1 < X →
        ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
          2 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ X ^ (Module.finrank ℚ K) →
          (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2) ∧
          m < ⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1 ∧
          Real.log (Ideal.absNorm p.asIdeal) ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
      intro X hX p m hm h_pow
      set n : ℕ := Module.finrank ℚ K
      set k : ℕ := Ideal.absNorm p.asIdeal
      have hk2 : 2 ≤ k := h_s2 p
      have hk_pos : 0 < k := by omega
      have hX_pos : 0 < X := by linarith
      refine ⟨?_, ?_, ?_⟩
      · have h_pow_le : k ^ 2 ≤ k ^ m := Nat.pow_le_pow_right hk_pos hm
        have h_pow_real : (k : ℝ) ^ 2 ≤ (k : ℝ) ^ m := by exact_mod_cast h_pow_le
        have h_sq_le_Xn : (k : ℝ) ^ 2 ≤ X ^ n := le_trans h_pow_real h_pow
        have h_Xn_eq : (X ^ ((n : ℝ) / 2)) ^ 2 = X ^ n := by
          rw [sq, ← Real.rpow_add hX_pos, add_halves, Real.rpow_natCast]
        have h_sq_le_sq : (k : ℝ) ^ 2 ≤ (X ^ ((n : ℝ) / 2)) ^ 2 := by linarith
        have h_rpow_nonneg : 0 ≤ X ^ ((n : ℝ) / 2) := Real.rpow_nonneg (le_of_lt hX_pos) _
        exact (abs_le_of_sq_le_sq' h_sq_le_sq h_rpow_nonneg).2
      · have h_pow2_le : 2 ^ m ≤ k ^ m := Nat.pow_le_pow_left hk2 m
        have h_pow2_real : (2 : ℝ) ^ m ≤ (k : ℝ) ^ m := by exact_mod_cast h_pow2_le
        have h_pow2_le_Xn : (2 : ℝ) ^ m ≤ X ^ n := le_trans h_pow2_real h_pow
        have h_log_le : Real.log ((2 : ℝ) ^ m) ≤ Real.log (X ^ n) :=
          Real.log_le_log (by positivity) h_pow2_le_Xn
        rw [Real.log_pow, Real.log_pow] at h_log_le
        have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
        have hm_le_div : (m : ℝ) ≤ (n : ℝ) * Real.log X / Real.log 2 :=
          (le_div_iff₀ hlog2_pos).mpr h_log_le
        have hm_le_floor : m ≤ ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊ :=
          Nat.le_floor hm_le_div
        exact Nat.lt_add_one_of_le hm_le_floor
      · have hm_ne : m ≠ 0 := by omega
        have hk_le_pow : k ≤ k ^ m := Nat.le_self_pow hm_ne k
        have hk_real : (k : ℝ) ≤ (k : ℝ) ^ m := by exact_mod_cast hk_le_pow
        have hk_le_Xn : (k : ℝ) ≤ X ^ n := le_trans hk_real h_pow
        have h_log_le : Real.log (k : ℝ) ≤ Real.log (X ^ n) :=
          Real.log_le_log (by positivity) hk_le_Xn
        rw [Real.log_pow] at h_log_le
        exact h_log_le
    have h_s4 : ∀ (X : ℝ), 1 < X →
        Finite {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)} ∧
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
            Real.log (Ideal.absNorm pm.1.1.asIdeal)) ≤
        (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2)} : ℝ) *
        ((⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1 : ℕ) : ℝ) *
        ((Module.finrank ℚ K : ℝ) * Real.log X) := by
      intro X hX
      let n : ℕ := Module.finrank ℚ K
      let s : ℝ := X ^ ((n : ℝ) / 2)
      let M : ℕ := ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊
      let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ n}
      let S_J := {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s}
      have hSJ_set_fin : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le ⌊s⌋₊)
        intro J hJ
        exact Nat.le_floor hJ
      haveI : Finite S_J := hSJ_set_fin
      let ψ : D_ge2 → S_J × Fin (M + 1) := fun pm =>
        (⟨pm.1.1.asIdeal, (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).1⟩,
         ⟨pm.1.2, (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).2.1⟩)
      have hψ_inj : Function.Injective ψ := by
        intro a b hab
        have h1 : a.1.1.asIdeal = b.1.1.asIdeal := congrArg Subtype.val (Prod.ext_iff.mp hab).1
        have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
        exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
      haveI : Finite D_ge2 := Finite.of_injective ψ hψ_inj
      letI : Fintype D_ge2 := Fintype.ofFinite D_ge2
      refine ⟨inferInstance, ?_⟩
      have hcard_le : Nat.card D_ge2 ≤ Nat.card S_J * (M + 1) := by
        calc Nat.card D_ge2
            ≤ Nat.card (S_J × Fin (M + 1)) := Nat.card_le_card_of_injective ψ hψ_inj
          _ = Nat.card S_J * Nat.card (Fin (M + 1)) := Nat.card_prod S_J (Fin (M + 1))
          _ = Nat.card S_J * (M + 1) := by rw [Nat.card_fin]
      have hcard_real : (Nat.card D_ge2 : ℝ) ≤ (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) := by
        exact_mod_cast hcard_le
      have hlogX_pos : 0 < Real.log X := Real.log_pos hX
      have hn_logX_nonneg : 0 ≤ (n : ℝ) * Real.log X := by positivity
      calc (∑' pm : D_ge2, Real.log (Ideal.absNorm pm.1.1.asIdeal))
          = ∑ pm : D_ge2, Real.log (Ideal.absNorm pm.1.1.asIdeal) := tsum_fintype _
        _ ≤ ∑ _pm : D_ge2, ((n : ℝ) * Real.log X) := by
            apply Finset.sum_le_sum
            intro pm _
            exact (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).2.2
        _ = (Fintype.card D_ge2 : ℝ) * ((n : ℝ) * Real.log X) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        _ = (Nat.card D_ge2 : ℝ) * ((n : ℝ) * Real.log X) := by
            rw [← Nat.card_eq_fintype_card]
        _ ≤ ((Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ)) * ((n : ℝ) * Real.log X) := by
            gcongr
        _ = (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) * ((n : ℝ) * Real.log X) := by
            ring
    obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_s1
    let n : ℕ := Module.finrank ℚ K
    have hn : 0 < n := Module.finrank_pos
    have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
    let c_id : ℝ := C₁ * ((n : ℝ) / Real.log 2 + 1)
    have hc_id_pos : 0 < c_id := by
      dsimp [c_id]
      positivity
    let A : ℝ := (n : ℝ) * c_id
    have hA_pos : 0 < A := by
      dsimp [A]
      positivity
    let c₁ : ℝ := max 2 (64 * A * Real.exp 1)
    have hc_ge_two : 2 ≤ c₁ := le_max_left _ _
    have hc_ge_A : 64 * A * Real.exp 1 ≤ c₁ := le_max_right _ _
    have hc₁_pos : 0 < c₁ := by linarith
    have h_s5 : ∀ X : ℝ, 1 < X →
        A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ 2 ≤
          c₁ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
      intro X hX
      have hX_pos : 0 < X := by linarith
      have hlog_pos : 0 < Real.log X := Real.log_pos hX
      set t : ℝ := Real.sqrt (Real.log X)
      have ht_pos : 0 < t := Real.sqrt_pos.mpr hlog_pos
      have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
      have hu_le : (t ^ 2 + 1) / 8 ≤ Real.exp ((t ^ 2 + 1) / 8) := by
        have h1 := Real.add_one_le_exp ((t ^ 2 + 1) / 8)
        linarith
      have hu_nonneg : 0 ≤ (t ^ 2 + 1) / 8 := by positivity
      have hpow_le : ((t ^ 2 + 1) / 8) ^ 2 ≤ Real.exp ((t ^ 2 + 1) / 4) := by
        calc ((t ^ 2 + 1) / 8) ^ 2
            ≤ (Real.exp ((t ^ 2 + 1) / 8)) ^ 2 := pow_le_pow_left₀ hu_nonneg hu_le 2
          _ = Real.exp ((2 : ℕ) * ((t ^ 2 + 1) / 8)) := (Real.exp_nat_mul _ 2).symm
          _ = Real.exp ((t ^ 2 + 1) / 4) := by
              congr 1
              push_cast
              ring
      have hpoly_bound : (Real.log X + 1) ^ 2 ≤ 64 * Real.exp ((t ^ 2 + 1) / 4) := by
        have h2 := mul_le_mul_of_nonneg_left hpow_le (by norm_num : (0 : ℝ) ≤ 64)
        have h3 : 64 * ((t ^ 2 + 1) / 8) ^ 2 = (t ^ 2 + 1) ^ 2 := by ring
        rw [← ht_sq, ← h3]
        exact h2
      have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
      have htc_le : t / c₁ ≤ t / 2 :=
        div_le_div_of_nonneg_left (le_of_lt ht_pos) (by norm_num) hc_ge_two
      have hsq_nonneg : 0 ≤ (t - 1) ^ 2 / 4 := by positivity
      have hn_half : t ^ 2 / 2 ≤ ((n : ℝ) / 2) * t ^ 2 := by
        have : (1 : ℝ) / 2 ≤ (n : ℝ) / 2 := by linarith
        nlinarith
      have hexp_arg_le2 : (t ^ 2 + 1) / 4 ≤ 1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₁) := by
        have hident : (t ^ 2 + 1) / 4 = t ^ 2 / 2 - t / 2 + 1 / 2 - (t - 1) ^ 2 / 4 := by ring
        rw [neg_div]
        linarith
      have hexp_split : Real.exp (1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₁)) =
          Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₁) := by
        rw [Real.exp_add, Real.exp_add, ht_sq, Real.rpow_def_of_pos hX_pos]
        ring_nf
      have hexp_bound : Real.exp ((t ^ 2 + 1) / 4) ≤
          Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₁) := by
        rw [← hexp_split]
        exact Real.exp_le_exp.mpr hexp_arg_le2
