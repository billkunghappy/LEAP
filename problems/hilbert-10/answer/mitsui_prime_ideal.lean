        calc (f_W I_x * χ I_x) *
              Complex.exp
                (((∑ j : Fin r,
                    y j * (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)))) : ℝ) * Complex.I)
          _ = χ I_x *
                (f_W I_x *
                  Complex.exp
                    (((∑ j : Fin r,
                        y j * (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)))) : ℝ) * Complex.I)) := by ring
