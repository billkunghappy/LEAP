      rw [← Real.inv_rpow (le_of_lt hb_ratio_pos), h_neg, Real.rpow_neg (le_of_lt hNγ_pos),
        ← Real.inv_rpow (le_of_lt hNγ_pos),
        ← Real.mul_rpow (inv_nonneg.mpr (le_of_lt hb_ratio_pos)) (inv_nonneg.mpr (le_of_lt hNγ_pos))]
      congr 1
      rw [hNγ_eq]
      have hJC_ne' : (Ideal.absNorm J_C : ℝ) ≠ 0 := ne_of_gt hNJC_pos
      have hb_inv : b_ratio⁻¹ = (Ideal.absNorm J_C : ℝ) * (D ^ (1 / 2 : ℝ) * (N_f ^ (1 / 2 : ℝ) * u)) := by
        dsimp [b_ratio, b_LHS]
        rw [inv_div, div_eq_mul_inv, mul_inv, mul_inv, inv_inv, hD_neg_inv, hNf_neg_inv]
      have h_prod_inv : (D * N_f * (Ideal.absNorm J_C : ℝ) * (Ideal.absNorm J_σC : ℝ))⁻¹ =
          D⁻¹ * N_f⁻¹ * (Ideal.absNorm J_C : ℝ)⁻¹ * (Ideal.absNorm J_σC : ℝ)⁻¹ := by
        rw [mul_inv, mul_inv, mul_inv]
      rw [hb_inv, h_prod_inv, hD_inv_sq, hNf_inv_sq]
      dsimp [b_RHS]
      calc (Ideal.absNorm J_C : ℝ) * (D ^ (1 / 2 : ℝ) * (N_f ^ (1 / 2 : ℝ) * u)) *
            ((D ^ (-1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * (N_f ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ)) *
              (Ideal.absNorm J_C : ℝ)⁻¹ * (Ideal.absNorm J_σC : ℝ)⁻¹)
        _ = ((Ideal.absNorm J_C : ℝ) * (Ideal.absNorm J_C : ℝ)⁻¹) *
            (D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * (N_f ^ (1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ)) *
            (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u) / (Ideal.absNorm J_σC : ℝ)) := by
            rw [div_eq_mul_inv]
            ring
        _ = D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u) / (Ideal.absNorm J_σC : ℝ) := by
            rw [mul_inv_cancel₀ hJC_ne', hD_prod, hNf_prod]
            ring
    rw [h_scale_rhs, mul_assoc]
  have h_sum_per_C :
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : (J_rep C : Ideal R),
              ψ_f (Ideal.Quotient.mk f x.1) *
                (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) =
      (∑ C : ClassGroup R,
        ((u : ℂ) * ω_χ) *
          (χ₀ (J_rep (σ C)) *
            (∫ y in Cube,
              (∑' x : (J_rep (σ C) : Ideal R),
                star (ψ_f (Ideal.Quotient.mk f x.1)) *
                  (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))))) :=
    Finset.sum_congr rfl (fun C _ => h_per_C C)
  rw [h_sum_per_C, ← Finset.mul_sum]
  congr 1
  exact Equiv.sum_comp σ (fun C =>
    χ₀ (J_rep C) *
      (∫ y in Cube,
        (∑' x : (J_rep C : Ideal R),
          star (ψ_f (Ideal.Quotient.mk f x.1)) *
            (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))))

theorem mitsui_primitive_ray_char_unitRank_ideal_norm_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1)
    (hχ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) :
    let J_K : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        Real.exp (-a *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i))
    ∃ ω_χ : ℂ, ‖ω_χ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (J_K (Real.pi * (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) *
              ((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹))) ^ (2 / (Module.finrank ℚ K : ℝ))) : ℂ)) =
        (u : ℂ) * ω_χ *
          (∑' m : ℕ,
            (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
              ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
              (J_K (Real.pi * (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) *
                ((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) * ((m : ℝ) * u))) ^ (2 / (Module.finrank ℚ K : ℝ))) : ℂ)) :=
by
  let R := NumberField.RingOfIntegers K
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let D : ℝ := |(NumberField.discr K : ℝ)|
  let N_f : ℝ := (Ideal.absNorm f : ℝ)
  let J_K : ℝ → ℝ := fun a =>
    ∫ y : Fin r → ℝ,
      Real.exp (-a *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * ∏ i : Fin r,
            (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i))
  let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
  obtain ⟨J_rep, hJ_cls, hJ_cop, h_s1⟩ :=
    mitsui_ideal_norm_tsum_eq_sum_classGroup_principal_subideals f hf
  obtain ⟨ψ_f, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, hψ_zero_gen⟩ :=
    mitsui_primitive_ray_char_exists_quotient_char_and_zero_mode
      f hf χ₀ hχ₀_ray hχ₀_norm_supp hχ₀_nonprin hχ₀_prim
  have hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
      ∀ (h_fin : Fintype (R ⧸ f)),
        @Finset.sum (R ⧸ f) ℂ _ (@Finset.univ (R ⧸ f) h_fin) ψ_f = 0) ∨
    (f = ⊤ ∧ (∀ a : R ⧸ f, ψ_f a = 1) ∧
      (∑ C : ClassGroup R, star (χ₀ (J_rep C))) = 0 ∧
      (∑ C : ClassGroup R, χ₀ (J_rep C)) = 0) :=
    hψ_zero_gen.imp id (fun ⟨hf_top, hψ_all, hJ⟩ => ⟨hf_top, hψ_all, hJ J_rep hJ_cls hJ_cop⟩)
  obtain ⟨ω_χ, hω_norm, h_s4⟩ :=
    mitsui_primitive_ray_char_classGroup_cube_lattice_theta_inversion
      f hf χ₀ hχ₀_norm_supp J_rep hJ_cls hJ_cop ψ_f
      hψ_one hψ_mul hψ_unit hψ_span hψ_prim hψ_zero
  let χ_dual : nonZeroDivisors (Ideal R) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp χ₀
  have hχ₀_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖χ₀ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ f = ⊤
    · rw [(hχ₀_norm_supp I).1 hI]
    · rw [(hχ₀_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  have hχ_dual_norm_supp : ∀ I : nonZeroDivisors (Ideal R),
      ((I : Ideal R) ⊔ f = ⊤ → ‖χ_dual I‖ = 1) ∧
      (¬ ((I : Ideal R) ⊔ f = ⊤) → χ_dual I = 0) := by
    intro I
    refine ⟨fun hI => ?_, fun hI => ?_⟩
    · change ‖star (χ₀ I)‖ = 1
      rw [norm_star, (hχ₀_norm_supp I).1 hI]
    · change star (χ₀ I) = 0
      rw [(hχ₀_norm_supp I).2 hI, star_zero]
  have hχ_dual_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖χ_dual I‖ ≤ 1 := by
    intro I
    change ‖star (χ₀ I)‖ ≤ 1
    rw [norm_star]
    exact hχ₀_norm_le I
  have hψ_dual_span : ∀ (x : R) (hx_ne : x ≠ 0),
      χ_dual ⟨Ideal.span ({x} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        star (ψ_f (Ideal.Quotient.mk f x)) := by
    intro x hx_ne
    change star (χ₀ ⟨Ideal.span ({x} : Set R), _⟩) = _
    rw [hψ_span x hx_ne]
  refine ⟨ω_χ, hω_norm, ?_⟩
  intro u hu
  have hu_pos : 0 < u := Set.mem_Ioi.mp hu
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf
  have hNf_pos : 0 < N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hb_inv_pos : 0 < D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹) := by positivity
  have hb_pos : 0 < D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u) := by positivity
  change (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
        χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        (J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹))) ^ (2 / (n : ℝ))) : ℂ)) =
    (u : ℂ) * ω_χ *
      (∑' m : ℕ,
        (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          (J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * u))) ^ (2 / (n : ℝ))) : ℂ))
  rw [h_s1 χ₀ hχ₀_norm_supp u⁻¹ hu_inv_pos, h_s1 χ_dual hχ_dual_norm_supp u hu_pos]
  have h_lhs_unfold : ∀ C : ClassGroup R,
      star (χ₀ (J_rep C)) *
        (∑' m : ℕ,
          (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (J_K (Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹) /
              (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
              (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ)) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
              ψ_f (Ideal.Quotient.mk f x.1) *
                (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹)) /
                    (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) := by
    intro C
    rw [(mitsui_principal_subideal_norm_tsum_eq_torsion_inv_mul_cube_integral_lattice
      f (J_rep C) χ₀ hχ₀_norm_le ψ_f hψ_span
      (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹)) hb_inv_pos).1]
    ring
  have h_rhs_unfold : ∀ C : ClassGroup R,
      star (χ_dual (J_rep C)) *
        (∑' m : ℕ,
          (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
            χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (J_K (Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u) /
              (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
              (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ)) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (χ₀ (J_rep C) *
          (∫ y in Cube,
            (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
              star (ψ_f (Ideal.Quotient.mk f x.1)) *
                (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u)) /
                    (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ)))) := by
    intro C
    have h_star : star (χ_dual (J_rep C)) = χ₀ (J_rep C) := star_star (χ₀ (J_rep C))
    rw [h_star, (mitsui_principal_subideal_norm_tsum_eq_torsion_inv_mul_cube_integral_lattice
      f (J_rep C) χ_dual hχ_dual_norm_le (fun a => star (ψ_f a)) hψ_dual_span
      (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u)) hb_pos).2]
    ring
  have h_lhs_sum :
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∑' m : ℕ,
            (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                  Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
              χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
              (J_K (Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹) /
                (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
                (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        ∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹)) /
                      (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ))) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun C _ => h_lhs_unfold C)
  have h_rhs_sum :
      (∑ C : ClassGroup R,
        star (χ_dual (J_rep C)) *
          (∑' m : ℕ,
            (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                  Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
              χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
              (J_K (Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u) /
                (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
                (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        ∑ C : ClassGroup R,
          χ₀ (J_rep C) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                star (ψ_f (Ideal.Quotient.mk f x.1)) *
                  (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u)) /
                      (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun C _ => h_rhs_unfold C)
  rw [h_lhs_sum, h_rhs_sum, h_s4 u hu]
  ring

theorem mitsui_primitive_ray_char_theta_inversion_and_unitDiscr_fubini {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ χ₀ I₀ ≠ 1)
    (hχ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) :
    ∃ (ω_χ : ℂ) (W₀ : ℝ → ℝ) (C₀ c α : ℝ),
      0 < C₀ ∧ 0 < c ∧ 0 < α ∧ ‖ω_χ‖ = 1 ∧
      Measurable W₀ ∧
      ContinuousOn W₀ (Set.Ioi (0 : ℝ)) ∧
