          J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)) ^ (2 / (n : ℝ)))) =
      (NumberField.Units.torsionOrder K : ℝ)⁻¹ *
        ∑ C : ClassGroup R, ∫ y in Cube, θ_neg C y := by
    apply Complex.ofReal_injective
    rw [Complex.ofReal_tsum]
    have h_step1 :
        (∑' m : ℕ,
          (((Nat.card {I : Ideal R // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
            J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)) ^ (2 / (n : ℝ))) : ℝ) : ℂ)) =
        ∑' m : ℕ,
