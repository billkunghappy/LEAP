      rw [hx_mk, hψ_one]
    let ι_C : NumberField.Units.torsion K →* ℂ :=
      { toFun := fun v => w₀.embedding (((v : Rˣ) : R) : K)
        map_one' := by
          change w₀.embedding ((algebraMap R K) (((1 : NumberField.Units.torsion K) : Rˣ) : R)) = 1
