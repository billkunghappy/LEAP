  have hpi_pos : 0 < Real.pi := Real.pi_pos
  have hpi_ne : Real.pi ≠ 0 := ne_of_gt hpi_pos
  have h_cos_pos : ∀ a b : ℝ, 0 ≤ a → a ≤ 1 / 2 → 0 ≤ b → b ≤ 1 / 2 →
