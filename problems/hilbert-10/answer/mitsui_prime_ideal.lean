      (T : Finset (IsDedekindDomain.HeightOneSpectrum R))
      (I : nonZeroDivisors (Ideal R)),
      resChar ψ T I = if ∀ p ∈ T, ¬ ((I : Ideal R) ≤ p.asIdeal) then ψ I else 0 :=
    fun _ _ _ => rfl
