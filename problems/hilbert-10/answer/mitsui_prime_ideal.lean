                Real.exp (-Real.pi * c ^ 2 *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
              Complex.exp
                (((∑ w : NumberField.InfinitePlace K,
                    v_place w *
                      ∑ i : Fin r,
                        y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                  Complex.I))) =
        (∫ y in Cube,
          (∑' x : J,
            star (ψ_f (Ideal.Quotient.mk f x.1)) *
              (∏ w : NumberField.InfinitePlace K,
                (star (Φ_emb w (x.1 : K)) *
                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
              (((c ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * c ^ 2 *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
              Complex.exp
                (((∑ w : NumberField.InfinitePlace K,
                    v_place w *
                      ∑ i : Fin r,
                        y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                  Complex.I)))
      simp_rw [h_term2]
      exact h_s3 hv_int (-1)

theorem mitsui_primitive_grossenchar_dual_class_and_gauss_sum {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ψ_f (Ideal.Quotient.mk f x) *
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1) :
    let R := NumberField.RingOfIntegers K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    ∃ (σ : ClassGroup R ≃ ClassGroup R)
      (γ_C : ClassGroup R → R)
      (α_C : ClassGroup R → (R ⧸ f) → R)
      (Φ_C : ∀ C : ClassGroup R, ((R ⧸ f) × ((J_rep C : Ideal R) * f : Ideal R)) ≃ (J_rep C : Ideal R))
      (ω_χ : ℂ),
      ‖ω_χ‖ = 1 ∧
      (∀ C : ClassGroup R, γ_C C ≠ 0 ∧
        differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
          Ideal.span ({γ_C C} : Set R)) ∧
      (∀ (C : ClassGroup R) (a : R ⧸ f),
        Ideal.Quotient.mk f (α_C C a) = a ∧
        ∀ m : ((J_rep C : Ideal R) * f : Ideal R),
          ((Φ_C C (a, m)).1 : R) = α_C C a + m.1) ∧
      (∀ (C : ClassGroup R) (x_star : (J_rep (σ C) : Ideal R)),
        star (χ₀ (J_rep C)) *
          ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            (∏ w : NumberField.InfinitePlace K,
              (w.embedding (γ_C C : K) / (w (γ_C C : K) : ℂ)) ^ (l_eff w)) *
            Complex.exp (-(((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (γ_C C : K))) : ℝ) * Complex.I)) *
            ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) *
              ∑' a : R ⧸ f,
                ψ_f a *
                  Complex.exp (2 * Real.pi * Complex.I *
                    (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ)))) =
        ω_χ * χ₀ (J_rep (σ C)) * star (ψ_f (Ideal.Quotient.mk f x_star.1))) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
  haveI : Finite (R ⧸ f) := Ideal.finiteQuotientOfFreeOfNeBot f hf
  letI : Fintype (R ⧸ f) := Fintype.ofFinite (R ⧸ f)
  have h_star_mul_self : ∀ z : ℂ, star z * z = (‖z‖ : ℂ) ^ 2 :=
    fun z => RCLike.conj_mul z
  have h_star_mul_eq_one : ∀ z : ℂ, ‖z‖ = 1 → star z * z = 1 := by
    intro z hz
    rw [h_star_mul_self z, hz, Complex.ofReal_one, one_pow]
  
  let S : R → ℂ := fun x =>
    ∏ w : NumberField.InfinitePlace K,
      (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)
  let E_inv : R → ℂ := fun x =>
    Complex.exp (-(((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I))
  let T : R → ℂ := fun x => S x * E_inv x
  have hw_pos : ∀ (x : R), x ≠ 0 → ∀ w : NumberField.InfinitePlace K, 0 < w (x : K) := by
    intro x hx_ne w
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne)
  have hS_norm : ∀ (x : R), x ≠ 0 → ‖S x‖ = 1 := by
    intro x hx_ne
    dsimp [S]
    rw [norm_prod]
    refine Finset.prod_eq_one (fun w _ => ?_)
    have hw : 0 < w (x : K) := hw_pos x hx_ne w
    rw [norm_zpow, norm_div, NumberField.InfinitePlace.norm_embedding_eq,
      Complex.norm_real, Real.norm_of_nonneg (le_of_lt hw), div_self (ne_of_gt hw), one_zpow]
  have hE_norm : ∀ x : R, ‖E_inv x‖ = 1 := by
    intro x
    dsimp [E_inv]
    have h_arg : -(((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
        (((-∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) : ℂ) * Complex.I := by
      push_cast
      ring
    rw [h_arg]
    exact Complex.norm_exp_ofReal_mul_I _
  have hT_norm : ∀ (x : R), x ≠ 0 → ‖T x‖ = 1 := by
    intro x hx_ne
    dsimp [T]
    rw [norm_mul, hS_norm x hx_ne, hE_norm x, mul_one]
  have hT_conj : ∀ (x : R), x ≠ 0 → star (T x) * T x = 1 :=
    fun x hx_ne => h_star_mul_eq_one (T x) (hT_norm x hx_ne)
  have hS_mul : ∀ (x y : R), S (x * y) = S x * S y := by
    intro x y
    dsimp [S]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    have hxy_coe : ((x * y : R) : K) = (x : K) * (y : K) := by push_cast; rfl
    rw [hxy_coe, map_mul, map_mul, Complex.ofReal_mul, mul_div_mul_comm, mul_zpow]
  have hE_mul : ∀ (x y : R), x ≠ 0 → y ≠ 0 → E_inv (x * y) = E_inv x * E_inv y := by
    intro x y hx_ne hy_ne
    dsimp [E_inv]
    rw [← Complex.exp_add]
    congr 1
    have h_sum : (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w ((x * y : R) : K))) =
        (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) +
          (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (y : K))) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have hxy_coe : ((x * y : R) : K) = (x : K) * (y : K) := by push_cast; rfl
      rw [hxy_coe, map_mul, Real.log_mul (ne_of_gt (hw_pos x hx_ne w)) (ne_of_gt (hw_pos y hy_ne w)), mul_add]
    rw [h_sum]
    push_cast
    ring
  have hT_mul : ∀ (x y : R), x ≠ 0 → y ≠ 0 → T (x * y) = T x * T y := by
    intro x y hx_ne hy_ne
    dsimp [T]
    rw [hS_mul x y, hE_mul x y hx_ne hy_ne]
    ring
  have hψ_span_T : ∀ (x : R) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
      ψ_f (Ideal.Quotient.mk f x) * T x := by
    intro x hx_ne
    have h1 := congrArg (fun z => z * E_inv x) (hψ_span x hx_ne)
    dsimp at h1
    have h_exp_cancel :
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) *
          E_inv x = 1 := by
      dsimp [E_inv]
      rw [← Complex.exp_add, add_neg_cancel, Complex.exp_zero]
    calc χ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
      _ = χ₀ ⟨Ideal.span ({x} : Set R),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          (Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) *
            E_inv x) := by rw [h_exp_cancel, mul_one]
      _ = (χ₀ ⟨Ideal.span ({x} : Set R),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)) *
            E_inv x := by ring
      _ = (ψ_f (Ideal.Quotient.mk f x) * S x) * E_inv x := h1
      _ = ψ_f (Ideal.Quotient.mk f x) * T x := by dsimp [T]; ring
  have h_unit_iff_sup : ∀ x : R,
      IsUnit (Ideal.Quotient.mk f x) ↔
        Ideal.span ({x} : Set R) ⊔ f = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑(hx.unit⁻¹) : R ⧸ f)
      have h_mk_zero : Ideal.Quotient.mk f (1 - x * y) = 0 := by
        rw [map_sub, map_one, map_mul, ← hx.unit_spec, hy, Units.mul_inv, sub_self]
      have h_mem_f : 1 - x * y ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero
      have h_mem_span : x * y ∈ Ideal.span ({x} : Set R) :=
        Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      exact ⟨x * y, h_mem_span, 1 - x * y, h_mem_f, add_sub_cancel (x * y) 1⟩
    · intro h_top
      have h_one : (1 : R) ∈ Ideal.span ({x} : Set R) ⊔ f :=
        (Ideal.eq_top_iff_one _).mp h_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h_one
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have h_mk : Ideal.Quotient.mk f x * Ideal.Quotient.mk f y = 1 := by
        have h1 := congrArg (Ideal.Quotient.mk f) hab
        rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at h1
        exact h1
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk f y) h_mk
  have h_cop_mul : ∀ (I₁ I₂ : Ideal R), I₁ ⊔ f = ⊤ → I₂ ⊔ f = ⊤ → (I₁ * I₂) ⊔ f = ⊤ := by
    intro I₁ I₂ h1 h2
    rw [sup_comm, Ideal.sup_mul_eq_of_coprime_left (sup_comm I₁ f ▸ h1), sup_comm]
    exact h2
  
  have hd_ne : differentIdeal ℤ R ≠ 0 := by
    intro h0
    have h_abs := Ideal.absNorm_eq_zero_iff.mpr h0
    rw [NumberField.absNorm_differentIdeal K R] at h_abs
    exact Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero K) h_abs
  let I_df : nonZeroDivisors (Ideal R) :=
    ⟨differentIdeal ℤ R * f, mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hd_ne hf)⟩
  let C₀ : ClassGroup R := ClassGroup.mk0 I_df
  let σ : ClassGroup R ≃ ClassGroup R :=
    (Equiv.inv (ClassGroup R)).trans (Equiv.mulLeft C₀)
  let P_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => I_df * J_rep C * J_rep (σ C)
  have h_mk0_P : ∀ C : ClassGroup R, ClassGroup.mk0 (P_C C) = 1 := by
    intro C
    dsimp [P_C]
    rw [map_mul, map_mul, hJ_cls C, hJ_cls (σ C)]
    change C₀ * C⁻¹ * (C₀ * C⁻¹)⁻¹ = 1
    exact mul_inv_cancel (C₀ * C⁻¹)
  have h_prin : ∀ C : ClassGroup R, ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal :=
    fun C => (ClassGroup.mk0_eq_one_iff (P_C C).2).mp (h_mk0_P C)
  let γ_C : ClassGroup R → R := fun C =>
    @Submodule.IsPrincipal.generator _ _ _ _ _ ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)
  have hγ_span : ∀ C : ClassGroup R,
      differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
        Ideal.span ({γ_C C} : Set R) := by
    intro C
    exact (@Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _
      ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)).symm
  have hγ_ne : ∀ C : ClassGroup R, γ_C C ≠ 0 := by
    intro C h0
    have hP_ne : ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) ≠ 0 :=
      nonZeroDivisors.coe_ne_zero (P_C C)
    apply hP_ne
    change differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) = ⊥
    rw [hγ_span C, h0, Ideal.span_singleton_zero]
  let x₀ : (R ⧸ f) → R := fun a => (Ideal.Quotient.mk_surjective a).choose
  have hx₀ : ∀ a : R ⧸ f, Ideal.Quotient.mk f (x₀ a) = a :=
    fun a => (Ideal.Quotient.mk_surjective a).choose_spec
  have h_coset : ∀ (J : Ideal R), J ⊔ f = ⊤ →
      ∃ (α_J : (R ⧸ f) → R) (Φ_J : ((R ⧸ f) × (J * f : Ideal R)) ≃ J),
        (∀ a : R ⧸ f, α_J a ∈ J ∧ Ideal.Quotient.mk f (α_J a) = a) ∧
        (∀ (a : R ⧸ f) (m : (J * f : Ideal R)), ((Φ_J (a, m)).1 : R) = α_J a + m.1) := by
    intro J hJ_cop_f
    have h1_mem : (1 : R) ∈ J ⊔ f := (Ideal.eq_top_iff_one _).mp hJ_cop_f
    obtain ⟨u_J, hu_J, v_f, hv_f, huv⟩ := Submodule.mem_sup.mp h1_mem
    have hu_mk : Ideal.Quotient.mk f u_J = 1 := by
      have h1 := congrArg (Ideal.Quotient.mk f) huv
      rw [map_add, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hv_f, add_zero] at h1
      exact h1
    let α_J : (R ⧸ f) → R := fun a => x₀ a * u_J
    have hα_mem : ∀ a : R ⧸ f, α_J a ∈ J := fun a => Ideal.mul_mem_left J (x₀ a) hu_J
    have hα_mk : ∀ a : R ⧸ f, Ideal.Quotient.mk f (α_J a) = a := by
      intro a
      dsimp [α_J]
      rw [map_mul, hx₀ a, hu_mk, mul_one]
    have h_inf_eq : J ⊓ f = J * f := (Ideal.mul_eq_inf_of_coprime hJ_cop_f).symm
    have h_sub_mem : ∀ x : J, x.1 - α_J (Ideal.Quotient.mk f x.1) ∈ (J * f : Ideal R) := by
      intro x
      rw [← h_inf_eq, Submodule.mem_inf]
      refine ⟨sub_mem x.2 (hα_mem _), ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hα_mk, sub_self]
    let Φ_J : ((R ⧸ f) × (J * f : Ideal R)) ≃ J :=
      { toFun := fun p => ⟨α_J p.1 + p.2.1, add_mem (hα_mem p.1) (Ideal.mul_le_right p.2.2)⟩
        invFun := fun x => (Ideal.Quotient.mk f x.1, ⟨x.1 - α_J (Ideal.Quotient.mk f x.1), h_sub_mem x⟩)
        left_inv := fun ⟨a, m⟩ => by
          have hm_f : m.1 ∈ f := Ideal.mul_le_left m.2
          have h_mk_add : Ideal.Quotient.mk f (α_J a + m.1) = a := by
            rw [map_add, hα_mk a, Ideal.Quotient.eq_zero_iff_mem.mpr hm_f, add_zero]
          apply Prod.ext
          · exact h_mk_add
          · apply Subtype.ext
            dsimp
            rw [h_mk_add, add_sub_cancel_left]
        right_inv := fun x => by
          apply Subtype.ext
          dsimp
          exact add_sub_cancel (α_J (Ideal.Quotient.mk f x.1)) x.1 }
    exact ⟨α_J, Φ_J, fun a => ⟨hα_mem a, hα_mk a⟩, fun a m => rfl⟩
  let α_C : ClassGroup R → (R ⧸ f) → R := fun C => (h_coset (J_rep C : Ideal R) (hJ_cop C)).choose
  let Φ_C : ∀ C : ClassGroup R, ((R ⧸ f) × ((J_rep C : Ideal R) * f : Ideal R)) ≃ (J_rep C : Ideal R) :=
    fun C => (h_coset (J_rep C : Ideal R) (hJ_cop C)).choose_spec.choose
  have hα_Φ : ∀ C : ClassGroup R,
      (∀ a : R ⧸ f, α_C C a ∈ (J_rep C : Ideal R) ∧ Ideal.Quotient.mk f (α_C C a) = a) ∧
      (∀ (a : R ⧸ f) (m : ((J_rep C : Ideal R) * f : Ideal R)), ((Φ_C C (a, m)).1 : R) = α_C C a + m.1) :=
    fun C => (h_coset (J_rep C : Ideal R) (hJ_cop C)).choose_spec.choose_spec
  have h_comp : ∀ I : nonZeroDivisors (Ideal R),
      ∃ (M₀ : nonZeroDivisors (Ideal R)) (c₀ : R),
        c₀ ≠ 0 ∧
        (M₀ : Ideal R) ⊔ f = ⊤ ∧
        (I : Ideal R) * (M₀ : Ideal R) = Ideal.span ({c₀} : Set R) := by
    intro I
    have hI : (I : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero I
    by_cases hI_top : (I : Ideal R) = ⊤
    · refine ⟨1, 1, one_ne_zero, ?_, ?_⟩
      · rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
      · rw [Submonoid.coe_one, Ideal.one_eq_top, hI_top, Ideal.mul_top, Ideal.span_singleton_one]
    · set J₀ : Ideal R := (I : Ideal R) * ((I : Ideal R) * f)
      have hJ₀_ne : J₀ ≠ 0 := mul_ne_zero hI (mul_ne_zero hI hf)
      obtain ⟨c₀, hc₀_sup⟩ := IsDedekindDomain.exists_sup_span_eq Ideal.mul_le_right hJ₀_ne
      have hc₀_ne : c₀ ≠ 0 := by
        intro hc₀_zero
        rw [hc₀_zero, Ideal.span_singleton_zero, sup_bot_eq] at hc₀_sup
        have h_eq : (I : Ideal R) * ((I : Ideal R) * f) = (I : Ideal R) * ⊤ := by
          rw [Ideal.mul_top]
          exact hc₀_sup
        have hIf_top : (I : Ideal R) * f = ⊤ := mul_left_cancel₀ hI h_eq
        have hI_ge_top : ⊤ ≤ (I : Ideal R) := hIf_top ▸ Ideal.mul_le_right
        exact hI_top (top_le_iff.mp hI_ge_top)
      have hc₀_le : Ideal.span ({c₀} : Set R) ≤ (I : Ideal R) :=
        le_sup_right.trans hc₀_sup.le
      obtain ⟨M₁, hM₁_mul⟩ := Ideal.dvd_iff_le.mpr hc₀_le
      have hspan_ne : Ideal.span ({c₀} : Set R) ≠ 0 :=
        Ideal.span_singleton_eq_bot.not.mpr hc₀_ne
      have hM₁_ne : M₁ ≠ 0 := right_ne_zero_of_mul (hM₁_mul ▸ hspan_ne)
      have h_mul_sup : (I : Ideal R) * (((I : Ideal R) * f) ⊔ M₁) = (I : Ideal R) * ⊤ := by
        rw [Ideal.mul_sup, ← hM₁_mul, Ideal.mul_top]
        exact hc₀_sup
      have hIf_sup : ((I : Ideal R) * f) ⊔ M₁ = ⊤ := mul_left_cancel₀ hI h_mul_sup
      have hM₁_cop : M₁ ⊔ f = ⊤ := by
        rw [sup_comm, eq_top_iff, ← hIf_sup]
        exact sup_le_sup_right Ideal.mul_le_left M₁
      exact ⟨⟨M₁, mem_nonZeroDivisors_of_ne_zero hM₁_ne⟩, c₀, hc₀_ne, hM₁_cop, hM₁_mul.symm⟩
  
  obtain ⟨B₀, γ₀, hγ₀_ne, hB₀_cop, hγ₀_span⟩ := h_comp I_df
  obtain ⟨β, _Φ_B₀, hβ, _⟩ := h_coset (B₀ : Ideal R) hB₀_cop
  let S₀ := nonZeroDivisors R
  have h_diff_inv : ((differentIdeal ℤ R : Ideal R) : FractionalIdeal S₀ K)⁻¹ =
      FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal S₀ K) := by
    rw [coeIdeal_differentIdeal ℤ ℚ K R, inv_inv]
  let e_K : K → ℂ := fun z =>
    Complex.exp (2 * Real.pi * Complex.I * (Algebra.trace ℚ K z : ℂ))
  have he_zero : e_K 0 = 1 := by
    dsimp [e_K]
    rw [map_zero, Rat.cast_zero, mul_zero, Complex.exp_zero]
  have he_add : ∀ z₁ z₂ : K, e_K (z₁ + z₂) = e_K z₁ * e_K z₂ := by
    intro z₁ z₂
    dsimp [e_K]
    rw [map_add (Algebra.trace ℚ K), Rat.cast_add, mul_add, Complex.exp_add]
  have he_eq_of_sub : ∀ z₁ z₂ : K, e_K (z₁ - z₂) = 1 → e_K z₁ = e_K z₂ := by
    intro z₁ z₂ h_sub
    calc e_K z₁ = e_K ((z₁ - z₂) + z₂) := by ring_nf
      _ = e_K (z₁ - z₂) * e_K z₂ := he_add (z₁ - z₂) z₂
      _ = 1 * e_K z₂ := by rw [h_sub]
      _ = e_K z₂ := one_mul _
  have he_star : ∀ z : K, star (e_K z) = e_K (-z) := by
    intro z
    dsimp [e_K]
    change (starRingEnd ℂ) (Complex.exp (2 * Real.pi * Complex.I * (Algebra.trace ℚ K z : ℂ))) =
      Complex.exp (2 * Real.pi * Complex.I * (Algebra.trace ℚ K (-z) : ℂ))
    rw [← Complex.exp_conj]
    congr 1
    rw [map_neg (Algebra.trace ℚ K), Rat.cast_neg, map_mul, map_mul, map_mul,
      map_ofNat, Complex.conj_ofReal, Complex.conj_I, map_ratCast]
    ring
  have h_trace_int : ∀ (g w : R), g ≠ 0 →
      (∀ d ∈ differentIdeal ℤ R, d * w ∈ Ideal.span ({g} : Set R)) →
      e_K ((w : K) / (g : K)) = 1 := by
    intro g w hg_ne h_mem_span
    have hgK_ne : (g : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hg_ne
    have h_mem_inv : (w : K) / (g : K) ∈ ((differentIdeal ℤ R : Ideal R) : FractionalIdeal S₀ K)⁻¹ := by
      rw [FractionalIdeal.mem_inv_iff (FractionalIdeal.coeIdeal_ne_zero.mpr hd_ne)]
      intro d hd
      rw [FractionalIdeal.mem_coeIdeal] at hd
      rcases hd with ⟨d₀, hd₀_mem, rfl⟩
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp (h_mem_span d₀ hd₀_mem)
      rw [FractionalIdeal.mem_one_iff]
      refine ⟨r, ?_⟩
      have hrK : (d₀ : K) * (w : K) = (g : K) * (r : K) := by exact_mod_cast hr
      calc ((r : R) : K) = ((g : K) * (r : K)) / (g : K) := (mul_div_cancel_left₀ (r : K) hgK_ne).symm
        _ = ((d₀ : K) * (w : K)) / (g : K) := by rw [hrK]
        _ = (w : K) / (g : K) * (algebraMap R K d₀) := by ring
    rw [h_diff_inv] at h_mem_inv
    have h_dual := (FractionalIdeal.mem_dual (one_ne_zero : (1 : FractionalIdeal S₀ K) ≠ 0)).mp h_mem_inv
    have h1_mem : (1 : K) ∈ (1 : FractionalIdeal S₀ K) :=
      (FractionalIdeal.mem_one_iff S₀).mpr ⟨1, map_one _⟩
    obtain ⟨k, hk⟩ := h_dual 1 h1_mem
    rw [Algebra.traceForm_apply, mul_one] at hk
    dsimp [e_K]
    rw [← hk, eq_intCast (algebraMap ℤ ℚ) k, Rat.cast_intCast]
    have h_arg : 2 * Real.pi * Complex.I * (k : ℂ) = (k : ℂ) * (2 * Real.pi * Complex.I) := by ring
    rw [h_arg]
    exact Complex.exp_int_mul_two_pi_mul_I k
  have h_mem_of_trace_one : ∀ v : R,
      (∀ y : R, e_K ((v : K) * (y : K) / (γ₀ : K)) = 1) → v ∈ f * (B₀ : Ideal R) := by
    intro v h_all
    have hγ₀K_ne : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀_ne
