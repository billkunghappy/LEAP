    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_K_bound : ∀ m : ℕ, 1 ≤ m → (Nat.card (S_m m) : ℝ) ≤ C₁ * (m : ℝ) := by
    intro m hm
    have hm_real : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have h_sub : {I : Ideal R | I ≠ ⊥ ∧ Ideal.absNorm I = m} ⊆
        {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} := by
      intro I hI
      change (Ideal.absNorm I : ℝ) ≤ (m : ℝ)
      rw [hI.2]
    have h_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)}.Finite := by
      refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le m) ?_
      intro J hJ
      exact_mod_cast hJ
    have h_card_le : Nat.card (S_m m) ≤ Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} :=
      Nat.card_mono h_fin h_sub
    have h_card_real : (Nat.card (S_m m) : ℝ) ≤
        (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} : ℝ) := by
      exact_mod_cast h_card_le
    exact le_trans h_card_real (hC₁ (m : ℝ) hm_real)
  let η : ℝ := ((n : ℝ) * a₀) / (4 * ((A : ℝ) + 1))
  have hη_pos : 0 < η := by dsimp [η]; positivity
  have hη_ne : η ≠ 0 := ne_of_gt hη_pos
  let c_decay : ℝ := ((n : ℝ) / 4) * a₀
  have hc_decay_pos : 0 < c_decay := by dsimp [c_decay]; positivity
  let M₁ : ℝ := (b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * M₀
  have hM₁_pos : 0 < M₁ := by dsimp [M₁]; positivity
  let K₀ : ℝ := (4 / α) * Real.log (4 / (c_decay * α))
  have h_dom : ∀ m : ℕ, 1 ≤ m →
      ((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c_decay * (m : ℝ) ^ α) ≤ Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹ := by
    intro m hm
    have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by omega : 0 < m)
    let y : ℝ := (c_decay * α / 4) * (m : ℝ) ^ α
    have hmα_pos : 0 < (m : ℝ) ^ α := Real.rpow_pos_of_pos hm_pos α
    have hy_pos : 0 < y := by dsimp [y]; positivity
    have h_log_y : Real.log y ≤ y := by
      have h1 := Real.log_le_sub_one_of_pos hy_pos
      linarith
    have h_mα_eq : (m : ℝ) ^ α = y * (4 / (c_decay * α)) := by
      dsimp [y]
      have hc_ne : c_decay ≠ 0 := ne_of_gt hc_decay_pos
      have hα_ne : α ≠ 0 := ne_of_gt hα_pos
      field_simp [hc_ne, hα_ne]
    have h_log_mα : α * Real.log (m : ℝ) = Real.log y + Real.log (4 / (c_decay * α)) := by
      rw [← Real.log_rpow hm_pos α, h_mα_eq, Real.log_mul (ne_of_gt hy_pos) (by positivity)]
    have h_ineq1 : α * Real.log (m : ℝ) ≤ y + Real.log (4 / (c_decay * α)) := by
      linarith
    have h_ineq2 : (4 / α) * (α * Real.log (m : ℝ)) ≤ (4 / α) * (y + Real.log (4 / (c_decay * α))) :=
      mul_le_mul_of_nonneg_left h_ineq1 (by positivity)
    have h_lhs_simp : (4 / α) * (α * Real.log (m : ℝ)) = 4 * Real.log (m : ℝ) := by
      have hα_ne : α ≠ 0 := ne_of_gt hα_pos
      field_simp [hα_ne]
    have h_rhs_simp : (4 / α) * (y + Real.log (4 / (c_decay * α))) = c_decay * (m : ℝ) ^ α + K₀ := by
      dsimp [y, K₀]
      have hα_ne : α ≠ 0 := ne_of_gt hα_pos
      field_simp [hα_ne]
    have h_ineq3 : Real.log (m : ℝ) * (2 : ℝ) + (-c_decay * (m : ℝ) ^ α) ≤ K₀ + Real.log (m : ℝ) * (-2 : ℝ) := by
      linarith
    have h_exp_ineq : Real.exp (Real.log (m : ℝ) * (2 : ℝ) + (-c_decay * (m : ℝ) ^ α)) ≤
        Real.exp (K₀ + Real.log (m : ℝ) * (-2 : ℝ)) :=
      Real.exp_le_exp.mpr h_ineq3
    rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hm_pos (2 : ℝ),
        ← Real.rpow_def_of_pos hm_pos (-2 : ℝ), Real.rpow_neg (le_of_lt hm_pos) (2 : ℝ)] at h_exp_ineq
    exact h_exp_ineq
  let maj : ℕ → ℝ := fun m => (M₁ * C₁ * Real.exp K₀) * ((m : ℝ) ^ (2 : ℝ))⁻¹
  have h_maj_sum : Summable maj :=
    (Real.summable_nat_rpow_inv.mpr one_lt_two).mul_left (M₁ * C₁ * Real.exp K₀)
  let K_ker : ℕ → ℝ := fun m =>
    (((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A *
      J_maj (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ))))
  have hK_ker_nn : ∀ m : ℕ, 0 ≤ K_ker m := by
    intro m
    dsimp [K_ker]
    have h_in_nn : 0 ≤ S_f * ((m : ℝ) * v) := by positivity
    have h_pow_nn : 0 ≤ ((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A :=
      pow_nonneg (Real.rpow_nonneg h_in_nn _) A
    exact mul_nonneg h_pow_nn (hJ_maj_nn _)
  let K_ker_c : ℕ → ℂ := fun m =>
    ((((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A : ℝ) : ℂ) *
      J_c ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ)))
  have hK_ker_c_le : ∀ m : ℕ, ‖K_ker_c m‖ ≤ K_ker m := by
    intro m
    dsimp [K_ker_c, K_ker]
    have h_in_nn : 0 ≤ S_f * ((m : ℝ) * v) := by positivity
    have h_pow_nn : 0 ≤ ((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A :=
      pow_nonneg (Real.rpow_nonneg h_in_nn _) A
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg h_pow_nn]
    exact mul_le_mul_of_nonneg_left (hJc_le _) h_pow_nn
  let term : ClassGroup R → ℕ → ℂ := fun C m =>
    (∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * K_ker_c m
  have h_term_sum : ∀ C : ClassGroup R, Summable (fun m : ℕ => star (ψ (J_rep C)) * term C m) := by
    intro C
    refine Summable.of_norm_bounded h_maj_sum (fun m => ?_)
    rw [norm_mul, norm_star, hψ_rep C, one_mul]
    dsimp [term]
    rw [norm_mul]
    have h_card_step : ‖∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ * ‖K_ker_c m‖ ≤
        (Nat.card (S_m m) : ℝ) * K_ker m :=
      mul_le_mul ((h_s2 m).2 C) (hK_ker_c_le m) (norm_nonneg _) (by positivity)
    refine le_trans h_card_step ?_
    by_cases hm0 : m = 0
    · subst hm0
      haveI h_empty : IsEmpty (S_m 0) := by
        refine ⟨fun I => ?_⟩
        exact I.2.1 (Ideal.absNorm_eq_zero_iff.mp I.2.2)
      rw [Nat.card_of_isEmpty, Nat.cast_zero, zero_mul]
      dsimp [maj]
      positivity
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα_pos)
      have hmα_nn : 0 ≤ (m : ℝ) ^ α := le_trans zero_le_one hmα_ge_one
      have h_in_eq : S_f * ((m : ℝ) * v) = b_scale * (m : ℝ) := by
        dsimp [b_scale]
        ring
      have ha_eq : Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ)) = a₀ * (m : ℝ) ^ α := by
        rw [h_in_eq]
        change Real.pi * (b_scale * (m : ℝ)) ^ α = a₀ * (m : ℝ) ^ α
        rw [Real.mul_rpow (le_of_lt hb_pos) (le_of_lt hm_pos)]
        dsimp [a₀]
        ring
      have ha_ge : a₀ ≤ a₀ * (m : ℝ) ^ α :=
        le_mul_of_one_le_right (le_of_lt ha₀_pos) hmα_ge_one
      have hJ_le := hJ_maj_bound (a₀ * (m : ℝ) ^ α) ha_ge
      have h_rpow_le : (m : ℝ) ^ (1 / (n : ℝ)) ≤ (m : ℝ) ^ α := by
        refine Real.rpow_le_rpow_of_exponent_le hm_ge_one ?_
        dsimp [α]
        exact div_le_div_of_nonneg_right (by norm_num) (le_of_lt hn_pos)
      have hmα_le_exp : (m : ℝ) ^ α ≤ η⁻¹ * Real.exp (η * (m : ℝ) ^ α) := by
        have h1 := Real.add_one_le_exp (η * (m : ℝ) ^ α)
        have h2 : η * (m : ℝ) ^ α ≤ Real.exp (η * (m : ℝ) ^ α) := by linarith
        have h3 := mul_le_mul_of_nonneg_left h2 (le_of_lt (inv_pos.mpr hη_pos))
        have h_lhs : η⁻¹ * (η * (m : ℝ) ^ α) = (m : ℝ) ^ α := by
          field_simp [hη_ne]
        rwa [h_lhs] at h3
      have hAη_le : (A : ℝ) * η ≤ ((n : ℝ) / 4) * a₀ := by
        dsimp [η]
        rw [mul_div_assoc', div_le_iff₀ (by positivity)]
        have : (A : ℝ) ≤ (A : ℝ) + 1 := by linarith
        nlinarith
      have h_poly_le : ((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A ≤
          (b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) := by
        rw [h_in_eq, Real.mul_rpow (le_of_lt hb_pos) (le_of_lt hm_pos), mul_pow, mul_assoc]
        refine mul_le_mul_of_nonneg_left ?_ (pow_nonneg (Real.rpow_nonneg (le_of_lt hb_pos) _) A)
        have h_pow1 : ((m : ℝ) ^ (1 / (n : ℝ))) ^ A ≤ (η⁻¹ * Real.exp (η * (m : ℝ) ^ α)) ^ A :=
          pow_le_pow_left₀ (Real.rpow_nonneg (le_of_lt hm_pos) _) (le_trans h_rpow_le hmα_le_exp) A
        rw [mul_pow, ← Real.exp_nat_mul] at h_pow1
        have h_exp_A : Real.exp ((A : ℝ) * (η * (m : ℝ) ^ α)) ≤ Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) := by
          rw [Real.exp_le_exp]
          have h_mul := mul_le_mul_of_nonneg_right hAη_le hmα_nn
          linarith
        exact le_trans h_pow1 (mul_le_mul_of_nonneg_left h_exp_A (by positivity))
      have hK_ker_m : K_ker m ≤ M₁ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
        dsimp [K_ker]
        rw [ha_eq]
        have h_prod_le : (((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A) * J_maj (a₀ * (m : ℝ) ^ α) ≤
            ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
              (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) :=
          mul_le_mul h_poly_le hJ_le (hJ_maj_nn _) (by positivity)
        have h_rhs_eq :
            ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
              (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) =
            M₁ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
          have h_rearrange :
              ((b_scale ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α)) *
                (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) =
              M₁ * (Real.exp (((n : ℝ) / 4) * a₀ * (m : ℝ) ^ α) * Real.exp (-((n : ℝ) / 2) * (a₀ * (m : ℝ) ^ α))) := by
            dsimp [M₁]
            ring
          rw [h_rearrange, ← Real.exp_add]
          congr 2
          dsimp [c_decay]
          ring
        rwa [h_rhs_eq] at h_prod_le
      have hm_le_sq : (m : ℝ) ≤ (m : ℝ) ^ (2 : ℝ) := by
        rw [Real.rpow_two]
        nlinarith
      have h_card_m : (Nat.card (S_m m) : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (Nat.card (S_m m) : ℝ)
            ≤ C₁ * (m : ℝ) := ha_K_bound m hm_ge_one_nat
          _ ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := mul_le_mul_of_nonneg_left hm_le_sq (le_of_lt hC₁_pos)
      have h_dom_m := h_dom m hm_ge_one_nat
      calc (Nat.card (S_m m) : ℝ) * K_ker m
          ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (M₁ * Real.exp (-c_decay * (m : ℝ) ^ α)) :=
            mul_le_mul h_card_m hK_ker_m (hK_ker_nn m) (by positivity)
        _ = (M₁ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c_decay * (m : ℝ) ^ α)) := by ring
        _ ≤ (M₁ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) :=
            mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = maj m := by dsimp [maj]; ring
  
  have h_lhs_eq :
      S_strip ν_place ψ v =
      ∑ C : ClassGroup R, star (ψ (J_rep C)) * (∑' m : ℕ, term C m) := by
    dsimp only [S_strip]
    have h_step1 : ∀ m : ℕ,
        (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ A : ℝ) : ℂ) *
          J_c ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ))) =
        ∑ C : ClassGroup R, star (ψ (J_rep C)) * term C m := by
      intro m
      rw [mul_assoc, (h_s2 m).1, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun C _ => ?_)
      dsimp [term, K_ker_c]
      ring
    rw [tsum_congr h_step1]
    rw [Summable.tsum_finsetSum (fun C _ => h_term_sum C)]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    exact tsum_mul_left
  rw [h_lhs_eq]
  refine Finset.sum_congr rfl (fun C _ => ?_)
  congr 1
  refine tsum_congr (fun m => ?_)
  dsimp [term, K_ker_c, A]
  have hJ_ne : (J_rep C : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero (J_rep C)
  have hNJ_ne : (Ideal.absNorm (J_rep C : Ideal R) : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hJ_ne)
  have h_cancel :
      (S_f * v / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
        ((Ideal.absNorm (J_rep C : Ideal R) : ℝ) * (m : ℝ)) =
      S_f * ((m : ℝ) * v) := by
    field_simp [hNJ_ne]
  rw [h_cancel]
  ring

theorem mitsui_primitive_grossenchar_exists_quotient_char_and_zero_mode {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (w₀ : NumberField.InfinitePlace K)
    (a₀ : ℕ) (ha₀_lt : a₀ < NumberField.Units.torsionOrder K)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (h_nonprin_v : 1 ≤ a₀ ∨
      ((∀ w : NumberField.InfinitePlace K, w.IsReal → l_ang w = 0) ∧
        ((∃ j : Fin (NumberField.Units.rank K),
            (∑ w : NumberField.InfinitePlace K,
              v_place w *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ≠ 0) ∨
          (∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0))))
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_prin_v : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
    (hχ₀_prim_v : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
