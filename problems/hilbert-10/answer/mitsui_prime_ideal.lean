      · refine ⟨le_refl _, le_refl _, hab_le, by linarith⟩
    · intro ξ w _hw Δ hΔ t u hu_t
      have hu_bounds : -Δ ≤ u - t ∧ u - t ≤ Δ := abs_le.mp hu_t
      refine ⟨fun ht => ?_, fun hu => ?_⟩
      · have hne : (S ξ w).Nonempty := ⟨t, ht⟩
        have ha' : a' ξ w = sInf (S ξ w) := if_pos hne
        have hb' : b' ξ w = sSup (S ξ w) := if_pos hne
        have ht_ge : a' ξ w ≤ t := by
          rw [ha']
          exact csInf_le (h_bddBelow ξ w) ht
        have ht_le : t ≤ b' ξ w := by
          rw [hb']
          exact le_csSup (h_bddAbove ξ w) ht
        refine ⟨by linarith, by linarith⟩
      · have hu_gt : a' ξ w + 2 * Δ < u := hu.1
        have hu_le : u ≤ b' ξ w - 2 * Δ := hu.2
        have ht_gt : a' ξ w < t := by linarith
        have ht_lt : t < b' ξ w := by linarith
        have hne : (S ξ w).Nonempty := by
          by_contra h_empty
          have ha' : a' ξ w = a_log w := if_neg h_empty
          have hb' : b' ξ w = a_log w := if_neg h_empty
          linarith
        have ha' : a' ξ w = sInf (S ξ w) := if_pos hne
        have hb' : b' ξ w = sSup (S ξ w) := if_pos hne
        rw [ha'] at ht_gt
        rw [hb'] at ht_lt
        obtain ⟨t₁, ht₁_mem, ht₁_lt⟩ := (csInf_lt_iff (h_bddBelow ξ w) hne).mp ht_gt
        obtain ⟨t₂, ht₂_mem, ht₂_gt⟩ := (lt_csSup_iff (h_bddAbove ξ w) hne).mp ht_lt
        have ht₁_gt_a : a_log w < t₁ := ht₁_mem.1.1
        have ht₂_le_b : t₂ ≤ b_log w := ht₂_mem.1.2
        refine ⟨⟨by linarith, by linarith⟩, ?_⟩
        intro hw_real
        have h_exp₁ : Real.exp t₁ ≤ Real.exp t := Real.exp_le_exp.mpr (le_of_lt ht₁_lt)
        have h_exp₂ : Real.exp t ≤ Real.exp t₂ := Real.exp_le_exp.mpr (le_of_lt ht₂_gt)
        have h₁_Ico := ht₁_mem.2 hw_real
        have h₂_Ico := ht₂_mem.2 hw_real
        have h₁_lo : c_lo w hw_real ≤ α_coeff ξ w hw_real * Real.exp t₁ := h₁_Ico.1
        have h₁_hi : α_coeff ξ w hw_real * Real.exp t₁ < c_hi w hw_real := h₁_Ico.2
        have h₂_lo : c_lo w hw_real ≤ α_coeff ξ w hw_real * Real.exp t₂ := h₂_Ico.1
        have h₂_hi : α_coeff ξ w hw_real * Real.exp t₂ < c_hi w hw_real := h₂_Ico.2
        rcases le_or_gt 0 (α_coeff ξ w hw_real) with hα_nonneg | hα_neg
        · have hm₁ : α_coeff ξ w hw_real * Real.exp t₁ ≤ α_coeff ξ w hw_real * Real.exp t :=
            mul_le_mul_of_nonneg_left h_exp₁ hα_nonneg
          have hm₂ : α_coeff ξ w hw_real * Real.exp t ≤ α_coeff ξ w hw_real * Real.exp t₂ :=
            mul_le_mul_of_nonneg_left h_exp₂ hα_nonneg
          exact ⟨by linarith, by linarith⟩
        · have hm₁ : α_coeff ξ w hw_real * Real.exp t ≤ α_coeff ξ w hw_real * Real.exp t₁ :=
            mul_le_mul_of_nonpos_left h_exp₁ (le_of_lt hα_neg)
          have hm₂ : α_coeff ξ w hw_real * Real.exp t₂ ≤ α_coeff ξ w hw_real * Real.exp t :=
            mul_le_mul_of_nonpos_left h_exp₂ (le_of_lt hα_neg)
          exact ⟨by linarith, by linarith⟩

theorem mitsui_complex_polar_perturbation_and_bivariate_collar_card_bound {ι_ξ : Type*} {ι_complex : Type*} [Fintype ι_ξ] [Fintype ι_complex] [DecidableEq ι_complex]
    (r K_δ : ℕ) (hK_δ : 3 ≤ K_δ)
    (R₁ C_L C_α : ℝ) (hR₁_pos : 0 < R₁) (hC_L_pos : 0 < C_L) (hC_α_nonneg : 0 ≤ C_α)
    (hC_L_h : C_L * (K_δ : ℝ)⁻¹ ≤ 1)
    (h_circle_collar : ∀ (α₀ γ ε : ℝ), 0 ≤ ε →
      ∀ S : Finset ℤ,
        (∀ p ∈ S, p ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ) ∧
          (|Real.cos (2 * Real.pi * (p : ℝ) * (K_δ : ℝ)⁻¹ + α₀) - γ| ≤ ε ∨
           |Real.sin (2 * Real.pi * (p : ℝ) * (K_δ : ℝ)⁻¹ + α₀) - γ| ≤ ε)) →
        (S.card : ℝ) * (K_δ : ℝ)⁻¹ ≤ 24 * Real.sqrt ε + 4 * (K_δ : ℝ)⁻¹) :
    (∀ (z : ℂ) (hz : ‖z‖ = 1) (u_y u_p α_y α_p c_lo_0 c_hi_0 c_lo_1 c_hi_1 : ℝ) (p_ang m : ℤ),
       |u_y - u_p| ≤ C_L * (K_δ : ℝ)⁻¹ →
       |α_y - α_p| ≤ C_α * (K_δ : ℝ)⁻¹ →
       |z.arg / (2 * Real.pi) - (p_ang : ℝ) * (K_δ : ℝ)⁻¹ - (m : ℝ)| ≤ (K_δ : ℝ)⁻¹ →
       ((R₁ * Real.exp u_p * Real.cos (2 * Real.pi * (p_ang : ℝ) * (K_δ : ℝ)⁻¹ + α_p) ∈
           Set.Ico (c_lo_0 + R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
             (c_hi_0 - R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹) ∧
         R₁ * Real.exp u_p * Real.sin (2 * Real.pi * (p_ang : ℝ) * (K_δ : ℝ)⁻¹ + α_p) ∈
           Set.Ico (c_lo_1 + R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
             (c_hi_1 - R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)) →
         R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).re ∈ Set.Ico c_lo_0 c_hi_0 ∧
         R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).im ∈ Set.Ico c_lo_1 c_hi_1) ∧
       ((R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).re ∈ Set.Ico c_lo_0 c_hi_0 ∧
         R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).im ∈ Set.Ico c_lo_1 c_hi_1) →
         R₁ * Real.exp u_p * Real.cos (2 * Real.pi * (p_ang : ℝ) * (K_δ : ℝ)⁻¹ + α_p) ∈
           Set.Ico (c_lo_0 - R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
             (c_hi_0 + R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹) ∧
         R₁ * Real.exp u_p * Real.sin (2 * Real.pi * (p_ang : ℝ) * (K_δ : ℝ)⁻¹ + α_p) ∈
           Set.Ico (c_lo_1 - R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
             (c_hi_1 + R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹))) ∧
    (∀ (B_y_out B_y_col : ℝ) (hB_y_out : 0 ≤ B_y_out) (hB_y_col : 0 ≤ B_y_col)
       (u_p α_p : (Fin r → ℤ) → ι_complex → ℝ)
       (c_lo_0 c_hi_0 c_lo_1 c_hi_1 : ι_complex → ℝ)
       (S_y_outer S_y_collar : ι_ξ → Finset (Fin r → ℤ))
       (hS_y_out : ∀ ξ : ι_ξ, ((S_y_outer ξ).card : ℝ) * ((K_δ : ℝ)⁻¹) ^ r ≤ B_y_out)
       (hS_y_col : ∀ ξ : ι_ξ, ((S_y_collar ξ).card : ℝ) * ((K_δ : ℝ)⁻¹) ^ r ≤ B_y_col)
       (S_main S_collar : Finset ((Fin r → ℤ) × (ι_complex → ℤ)))
       (hS_main : ∀ q ∈ S_main, ∃ ξ : ι_ξ,
         q.1 ∈ S_y_outer ξ ∧ ∀ w : ι_complex, q.2 w ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ))
       (hS_collar : ∀ q ∈ S_collar, ∃ ξ : ι_ξ,
         q.1 ∈ S_y_outer ξ ∧
         (∀ w : ι_complex, q.2 w ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ)) ∧
         (q.1 ∈ S_y_collar ξ ∨
           ∃ w : ι_complex,
             (¬ (R₁ * Real.exp (u_p q.1 w) *
                   Real.cos (2 * Real.pi * (q.2 w : ℝ) * (K_δ : ℝ)⁻¹ + α_p q.1 w) ∈
                 Set.Ico (c_lo_0 w + R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
                   (c_hi_0 w - R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹) ∧
                 R₁ * Real.exp (u_p q.1 w) *
                   Real.sin (2 * Real.pi * (q.2 w : ℝ) * (K_δ : ℝ)⁻¹ + α_p q.1 w) ∈
                 Set.Ico (c_lo_1 w + R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
                   (c_hi_1 w - R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹))) ∧
             (R₁ * Real.exp (u_p q.1 w) *
                 Real.cos (2 * Real.pi * (q.2 w : ℝ) * (K_δ : ℝ)⁻¹ + α_p q.1 w) ∈
               Set.Ico (c_lo_0 w - R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
                 (c_hi_0 w + R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹) ∧
               R₁ * Real.exp (u_p q.1 w) *
                 Real.sin (2 * Real.pi * (q.2 w : ℝ) * (K_δ : ℝ)⁻¹ + α_p q.1 w) ∈
               Set.Ico (c_lo_1 w - R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)
                 (c_hi_1 w + R₁ * Real.exp (u_p q.1 w) * (2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹)))),
       (S_main.card : ℝ) * ((K_δ : ℝ)⁻¹) ^ (r + Fintype.card ι_complex) ≤
         (Fintype.card ι_ξ : ℝ) * B_y_out ∧
       (S_collar.card : ℝ) * ((K_δ : ℝ)⁻¹) ^ (r + Fintype.card ι_complex) ≤
         (Fintype.card ι_ξ : ℝ) *
           (B_y_col + B_y_out * (Fintype.card ι_complex : ℝ) *
             (96 * Real.sqrt ((2 * C_L + 2 * Real.pi + C_α + 1) * (K_δ : ℝ)⁻¹) + 16 * (K_δ : ℝ)⁻¹))) :=
by
  classical
  let h : ℝ := (K_δ : ℝ)⁻¹
  have hK_pos : 0 < K_δ := by omega
  have hK_rpos : (0 : ℝ) < (K_δ : ℝ) := by exact_mod_cast hK_pos
  have hK_rne : (K_δ : ℝ) ≠ 0 := ne_of_gt hK_rpos
  have hh_pos : 0 < h := inv_pos.mpr hK_rpos
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hKh : (K_δ : ℝ) * h = 1 := mul_inv_cancel₀ hK_rne
  refine ⟨?_, ?_⟩
  · intro z hz u_y u_p α_y α_p c_lo_0 c_hi_0 c_lo_1 c_hi_1 p_ang m hu_diff hα_diff hang_diff
    let ϕ_y : ℝ := z.arg + α_y - (m : ℝ) * (2 * Real.pi)
    let ϕ_p : ℝ := 2 * Real.pi * (p_ang : ℝ) * h + α_p
    let Δ : ℝ := R₁ * Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α + 1) * h
    have hz_exp : z = Complex.exp ((z.arg : ℂ) * Complex.I) := by
      have h1 := Complex.norm_mul_exp_arg_mul_I z
      rw [hz, Complex.ofReal_one, one_mul] at h1
      exact h1.symm
    have h_z_rot : z * Complex.exp ((α_y : ℝ) * Complex.I) =
        Complex.exp (((z.arg + α_y : ℝ) : ℂ) * Complex.I) := by
      conv_lhs => rw [hz_exp]
      rw [← Complex.exp_add, ← add_mul, ← Complex.ofReal_add]
    have h_re_id : R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).re =
        R₁ * Real.exp u_y * Real.cos ϕ_y := by
      rw [h_z_rot, Complex.re_mul_ofReal, Complex.exp_ofReal_mul_I_re]
      have h_cos : Real.cos ϕ_y = Real.cos (z.arg + α_y) := by
        dsimp [ϕ_y]
        exact Real.cos_sub_int_mul_two_pi (z.arg + α_y) m
      rw [h_cos]
      ring
    have h_im_id : R₁ * (z * Complex.exp ((α_y : ℝ) * Complex.I) * (Real.exp u_y : ℂ)).im =
        R₁ * Real.exp u_y * Real.sin ϕ_y := by
      rw [h_z_rot, Complex.im_mul_ofReal, Complex.exp_ofReal_mul_I_im]
      have h_sin : Real.sin ϕ_y = Real.sin (z.arg + α_y) := by
        dsimp [ϕ_y]
        exact Real.sin_sub_int_mul_two_pi (z.arg + α_y) m
      rw [h_sin]
      ring
    have hexp_diff : |Real.exp u_y - Real.exp u_p| ≤ Real.exp u_p * (2 * C_L * h) := by
      have hu_le_one : |u_y - u_p| ≤ 1 := le_trans hu_diff hC_L_h
      have h_sub_one : |Real.exp (u_y - u_p) - 1| ≤ 2 * C_L * h := by
        calc |Real.exp (u_y - u_p) - 1| ≤ 2 * |u_y - u_p| := Real.abs_exp_sub_one_le hu_le_one
          _ ≤ 2 * (C_L * h) := mul_le_mul_of_nonneg_left hu_diff (by positivity)
          _ = 2 * C_L * h := by ring
      have h_factor : Real.exp u_y - Real.exp u_p = Real.exp u_p * (Real.exp (u_y - u_p) - 1) := by
        rw [mul_sub, mul_one, ← Real.exp_add, add_sub_cancel]
      rw [h_factor, abs_mul, abs_of_pos (Real.exp_pos u_p)]
      exact mul_le_mul_of_nonneg_left h_sub_one (le_of_lt (Real.exp_pos u_p))
    have hϕ_diff : |ϕ_y - ϕ_p| ≤ (2 * Real.pi + C_α) * h := by
      have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
      have h2pi_ne : 2 * Real.pi ≠ 0 := ne_of_gt h2pi_pos
      have h_id : ϕ_y - ϕ_p =
          (2 * Real.pi) * (z.arg / (2 * Real.pi) - (p_ang : ℝ) * h - (m : ℝ)) + (α_y - α_p) := by
        dsimp [ϕ_y, ϕ_p]
        field_simp [h2pi_ne]
        ring
      rw [h_id]
      calc |(2 * Real.pi) * (z.arg / (2 * Real.pi) - (p_ang : ℝ) * h - (m : ℝ)) + (α_y - α_p)|
        _ ≤ |(2 * Real.pi) * (z.arg / (2 * Real.pi) - (p_ang : ℝ) * h - (m : ℝ))| + |α_y - α_p| :=
            abs_add_le _ _
        _ = (2 * Real.pi) * |z.arg / (2 * Real.pi) - (p_ang : ℝ) * h - (m : ℝ)| + |α_y - α_p| := by
            rw [abs_mul, abs_of_pos h2pi_pos]
        _ ≤ (2 * Real.pi) * h + C_α * h :=
            add_le_add (mul_le_mul_of_nonneg_left hang_diff (le_of_lt h2pi_pos)) hα_diff
        _ = (2 * Real.pi + C_α) * h := by ring
    have h_cos_err : |R₁ * Real.exp u_y * Real.cos ϕ_y - R₁ * Real.exp u_p * Real.cos ϕ_p| ≤ Δ := by
      have h_id : R₁ * Real.exp u_y * Real.cos ϕ_y - R₁ * Real.exp u_p * Real.cos ϕ_p =
          R₁ * ((Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y +
            Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)) := by ring
      have h_t1 : |(Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y| ≤ Real.exp u_p * (2 * C_L * h) := by
        rw [abs_mul]
        calc |Real.exp u_y - Real.exp u_p| * |Real.cos ϕ_y|
          _ ≤ (Real.exp u_p * (2 * C_L * h)) * 1 :=
              mul_le_mul hexp_diff (Real.abs_cos_le_one ϕ_y) (abs_nonneg _) (by positivity)
          _ = Real.exp u_p * (2 * C_L * h) := mul_one _
      have h_t2 : |Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)| ≤
          Real.exp u_p * ((2 * Real.pi + C_α) * h) := by
        rw [abs_mul, abs_of_pos (Real.exp_pos u_p)]
        exact mul_le_mul_of_nonneg_left
          (le_trans (Real.abs_cos_sub_cos_le ϕ_y ϕ_p) hϕ_diff) (le_of_lt (Real.exp_pos u_p))
      have h_sum : |(Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y +
          Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)| ≤
          Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h := by
        calc |(Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y +
            Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)|
          _ ≤ |(Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y| +
              |Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)| := abs_add_le _ _
          _ ≤ Real.exp u_p * (2 * C_L * h) + Real.exp u_p * ((2 * Real.pi + C_α) * h) :=
              add_le_add h_t1 h_t2
          _ = Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h := by ring
      rw [h_id, abs_mul, abs_of_pos hR₁_pos]
      have h_pos_slack : 0 ≤ R₁ * Real.exp u_p * h := by positivity
      calc R₁ * |(Real.exp u_y - Real.exp u_p) * Real.cos ϕ_y +
          Real.exp u_p * (Real.cos ϕ_y - Real.cos ϕ_p)|
        _ ≤ R₁ * (Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h) :=
            mul_le_mul_of_nonneg_left h_sum (le_of_lt hR₁_pos)
        _ ≤ Δ := by dsimp [Δ]; linarith
    have h_sin_err : |R₁ * Real.exp u_y * Real.sin ϕ_y - R₁ * Real.exp u_p * Real.sin ϕ_p| ≤ Δ := by
      have h_id : R₁ * Real.exp u_y * Real.sin ϕ_y - R₁ * Real.exp u_p * Real.sin ϕ_p =
          R₁ * ((Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y +
            Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)) := by ring
      have h_t1 : |(Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y| ≤ Real.exp u_p * (2 * C_L * h) := by
        rw [abs_mul]
        calc |Real.exp u_y - Real.exp u_p| * |Real.sin ϕ_y|
          _ ≤ (Real.exp u_p * (2 * C_L * h)) * 1 :=
              mul_le_mul hexp_diff (Real.abs_sin_le_one ϕ_y) (abs_nonneg _) (by positivity)
          _ = Real.exp u_p * (2 * C_L * h) := mul_one _
      have h_t2 : |Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)| ≤
          Real.exp u_p * ((2 * Real.pi + C_α) * h) := by
        rw [abs_mul, abs_of_pos (Real.exp_pos u_p)]
        exact mul_le_mul_of_nonneg_left
          (le_trans (Real.abs_sin_sub_sin_le ϕ_y ϕ_p) hϕ_diff) (le_of_lt (Real.exp_pos u_p))
      have h_sum : |(Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y +
          Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)| ≤
          Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h := by
        calc |(Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y +
            Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)|
          _ ≤ |(Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y| +
              |Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)| := abs_add_le _ _
          _ ≤ Real.exp u_p * (2 * C_L * h) + Real.exp u_p * ((2 * Real.pi + C_α) * h) :=
              add_le_add h_t1 h_t2
          _ = Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h := by ring
      rw [h_id, abs_mul, abs_of_pos hR₁_pos]
      have h_pos_slack : 0 ≤ R₁ * Real.exp u_p * h := by positivity
      calc R₁ * |(Real.exp u_y - Real.exp u_p) * Real.sin ϕ_y +
          Real.exp u_p * (Real.sin ϕ_y - Real.sin ϕ_p)|
        _ ≤ R₁ * (Real.exp u_p * (2 * C_L + 2 * Real.pi + C_α) * h) :=
