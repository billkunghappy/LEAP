                        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ) : ℝ) : ℂ))) = 1 := by
    intro x hx_ne hx_q d hd
    let I_x : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
    change (χ I_x * f_ψ I_x) *
      ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
        Complex.exp
          (2 * Real.pi * Complex.I *
            ∑ j : Fin r, (θ₀ j : ℂ) * ((Φ_W I_x j + (d j : ℝ) : ℝ) : ℂ))) = 1
    have h_rearrange :
        (χ I_x * f_ψ I_x) *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            Complex.exp
              (2 * Real.pi * Complex.I *
                ∑ j : Fin r, (θ₀ j : ℂ) * ((Φ_W I_x j + (d j : ℝ) : ℝ) : ℂ))) =
        χ I_x *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            (Complex.exp
              (2 * Real.pi * Complex.I *
                ∑ j : Fin r, (θ₀ j : ℂ) * ((Φ_W I_x j + (d j : ℝ) : ℝ) : ℂ)) * f_ψ I_x)) := by ring
    rw [h_rearrange]
    dsimp [f_ψ]
    rw [← h_bilinear_exp (Φ_W I_x) d]
    have h_log_eq :
        (∑ w : NumberField.InfinitePlace K,
          β w * ∑ j : Fin r, (Φ_W I_x j + (d j : ℝ)) * Real.log (w (η j) / w₀ (η j))) =
        (∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K) / w₀ (x : K))) := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [← hd w]
    rw [h_log_eq]
    exact hχ_ray x hx_ne hx_q
  let h_K : ℕ := NumberField.classNumber K
  have h_prin_pow : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        (⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ :
            nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) = I ^ h_K := by
    intro I
    have h_mk0 : ClassGroup.mk0 (I ^ h_K) = 1 := by
      rw [map_pow]
      exact pow_card_eq_one
    have h_isPrin : (((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K))).IsPrincipal :=
      (ClassGroup.mk0_eq_one_iff (I ^ h_K).2).mp h_mk0
    obtain ⟨x, hx⟩ := Submodule.IsPrincipal.principal
      ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) : Ideal (NumberField.RingOfIntegers K))
    have hx_span : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) =
        ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) : Ideal (NumberField.RingOfIntegers K)) :=
      hx.symm
    have hI_ne : ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      nonZeroDivisors.ne_zero (I ^ h_K).2
    have hx_ne : x ≠ 0 := by
      intro hx0
      apply hI_ne
      rw [← hx_span, Ideal.span_singleton_eq_bot.mpr hx0]
    refine ⟨x, hx_ne, Subtype.ext hx_span⟩
  have h_emb_sq : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (y : K),
      (w.embedding y) ^ 2 = (w y : ℂ) ^ 2 := by
    intro w hw y
    let r_y : ℝ := NumberField.InfinitePlace.embedding_of_isReal hw y
    have h_emb : w.embedding y = (r_y : ℂ) :=
      (NumberField.InfinitePlace.embedding_of_isReal_apply hw y).symm
    have h_norm : w y = |r_y| := by
      rw [← NumberField.InfinitePlace.norm_embedding_eq w y, h_emb,
        Complex.norm_real, Real.norm_eq_abs]
    rw [h_emb, h_norm]
    norm_cast
    exact (sq_abs r_y).symm
  have h_sign_sq : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal)
      (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      (w.embedding (x : K) / (w (x : K) : ℂ)) ^ 2 = 1 := by
    intro w hw x hx_ne
    have hxK_ne : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hw_pos : 0 < w (x : K) := w.pos_iff.mpr hxK_ne
    have hw_ne : (w (x : K) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hw_pos)
    rw [div_pow, h_emb_sq w hw (x : K), div_self (pow_ne_zero 2 hw_ne)]
  have h_tors_sq : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal)
      (ζ : NumberField.Units.torsion K),
      (w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ^ 2 = 1 := by
    intro w hw ζ
    have hw_one : w (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 :=
      (NumberField.Units.mem_torsion K).mp ζ.2 w
    rw [h_emb_sq w hw, hw_one, Complex.ofReal_one, one_pow]
  have h_arg_int_pi : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal)
      (d : Fin r → ℤ),
      (Complex.exp
        (((∑ j : Fin r, (d j : ℝ) * (w.embedding (η j)).arg) : ℝ) * Complex.I)) ^ 2 = 1 := by
    intro w hw d
    have h_ex : ∀ j : Fin r, ∃ m_j : ℤ, (w.embedding (η j)).arg = (m_j : ℝ) * Real.pi := by
      intro j
      let r_j : ℝ := NumberField.InfinitePlace.embedding_of_isReal hw (η j)
      have h_emb : w.embedding (η j) = (r_j : ℂ) :=
        (NumberField.InfinitePlace.embedding_of_isReal_apply hw (η j)).symm
      rw [h_emb]
      rcases le_or_gt 0 r_j with hr_nonneg | hr_neg
      · refine ⟨0, ?_⟩
        rw [Complex.arg_ofReal_of_nonneg hr_nonneg, Int.cast_zero, zero_mul]
      · refine ⟨1, ?_⟩
        rw [Complex.arg_ofReal_of_neg hr_neg, Int.cast_one, one_mul]
    choose m hm using h_ex
    rw [← Complex.exp_nat_mul]
    have h_arg :
        ((2 : ℕ) : ℂ) * ((((∑ j : Fin r, (d j : ℝ) * (w.embedding (η j)).arg) : ℝ) : ℂ) * Complex.I) =
        ((∑ j : Fin r, d j * m j : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
      have h_sum :
          (∑ j : Fin r, (d j : ℝ) * (w.embedding (η j)).arg) =
          (∑ j : Fin r, (d j : ℝ) * (m j : ℝ)) * Real.pi := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hm j]
        ring
