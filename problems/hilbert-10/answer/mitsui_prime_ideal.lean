    have hψ_ne : ∀ u : (NumberField.RingOfIntegers K)ˣ, ψ_w u ≠ 0 := by
      intro u
      have hu_coe : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast u.ne_zero
      exact ne_of_gt (div_pos (w.pos_iff.mpr hu_coe) (w₀.pos_iff.mpr hu_coe))
    have hg_coe : (g : K) ≠ 0 := by exact_mod_cast hg_ne
    have hg_div_ne : w (g : K) / w₀ (g : K) ≠ 0 :=
      ne_of_gt (div_pos (w.pos_iff.mpr hg_coe) (w₀.pos_iff.mpr hg_coe))
    have h_mul_g :
        w (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K) /
          w₀ (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K) =
        (w (g : K) / w₀ (g : K)) * ψ_w (U_map ζe) := by
      change w (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K) /
          w₀ (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K) =
        (w (g : K) / w₀ (g : K)) *
          (w ((U_map ζe : NumberField.RingOfIntegers K) : K) / w₀ ((U_map ζe : NumberField.RingOfIntegers K) : K))
      push_cast
      rw [map_mul, map_mul, mul_div_mul_comm, mul_comm]
    have hψ_ζ : ψ_w (ζe.1 : (NumberField.RingOfIntegers K)ˣ) = 1 := by
      change w (((ζe.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
          w₀ (((ζe.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1
      rw [(NumberField.Units.mem_torsion K).mp ζe.1.2 w,
        (NumberField.Units.mem_torsion K).mp ζe.1.2 w₀, div_one]
    have hψ_U : ψ_w (U_map ζe) =
        ∏ j : Fin (NumberField.Units.rank K), (ψ_w (NumberField.Units.fundSystem K j)) ^ (ζe.2 j) := by
      dsimp [U_map]
      rw [map_mul, hψ_ζ, one_mul, map_prod]
      exact Finset.prod_congr rfl (fun j _ => map_zpow ψ_w (NumberField.Units.fundSystem K j) (ζe.2 j))
    have h_log_U : Real.log (ψ_w (U_map ζe)) =
        ∑ j : Fin (NumberField.Units.rank K),
          (ζe.2 j : ℝ) * Real.log (ψ_w (NumberField.Units.fundSystem K j)) := by
      rw [hψ_U, Real.log_prod (fun j _ => zpow_ne_zero (ζe.2 j) (hψ_ne (NumberField.Units.fundSystem K j)))]
      exact Finset.sum_congr rfl (fun j _ => Real.log_zpow (ψ_w (NumberField.Units.fundSystem K j)) (ζe.2 j))
    rw [h_mul_g, Real.log_mul hg_div_ne (hψ_ne (U_map ζe)), h_log_U]
    rfl
