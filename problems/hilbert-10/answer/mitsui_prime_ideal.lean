    (I : Ideal (NumberField.RingOfIntegers K))
    (x₀ : NumberField.RingOfIntegers K) (hx₀_ne : x₀ ≠ 0)
    (hx₀_span : Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)) = I)
    (v : Fin (NumberField.Units.rank K) → ℝ)
    (τ : NumberField.InfinitePlace K → ℂ)
    (ζ₀ : NumberField.Units.torsion K)
    (d₀ : Fin (NumberField.Units.rank K) → ℤ)
    (hd₀_log : ∀ w : NumberField.InfinitePlace K,
      Real.log (w (x₀ : K) / w₀ (x₀ : K)) =
        ∑ j : Fin (NumberField.Units.rank K),
          (v j + (d₀ j : ℝ)) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))
    (hd₀_phase : ∀ w : NumberField.InfinitePlace K,
