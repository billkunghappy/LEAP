    rw [hx_eq] at h_phase
    have h_exp_split :
        Complex.exp
          (((∑ j : Fin r, (Φ_W (I ^ h_K) j + (d₂ j : ℝ)) * (w.embedding (η j)).arg) : ℝ) * Complex.I) =
        (Complex.exp (((∑ j : Fin r, Φ_W I j * (w.embedding (η j)).arg) : ℝ) * Complex.I)) ^ h_K *
          Complex.exp (((∑ j : Fin r, ((d₁ j + d₂ j : ℤ) : ℝ) * (w.embedding (η j)).arg) : ℝ) * Complex.I) := by
      rw [← Complex.exp_nat_mul, ← Complex.exp_add]
      congr 1
      have h_sum :
          (∑ j : Fin r, (Φ_W (I ^ h_K) j + (d₂ j : ℝ)) * (w.embedding (η j)).arg) =
          (h_K : ℝ) * (∑ j : Fin r, Φ_W I j * (w.embedding (η j)).arg) +
            ∑ j : Fin r, ((d₁ j + d₂ j : ℤ) : ℝ) * (w.embedding (η j)).arg := by
        rw [Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hd₁ j, Int.cast_add]
        ring
      rw [h_sum]
      push_cast
      ring
    have h_rhs_factor :
        w.embedding (((ζ₂ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          Φ_τ (I ^ h_K) w *
          Complex.exp
            (((∑ j : Fin r, (Φ_W (I ^ h_K) j + (d₂ j : ℝ)) * (w.embedding (η j)).arg) : ℝ) * Complex.I) =
        w.embedding (((ζ₂ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          w.embedding (((ζ₁ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          z_I ^ h_K *
          Complex.exp (((∑ j : Fin r, ((d₁ j + d₂ j : ℤ) : ℝ) * (w.embedding (η j)).arg) : ℝ) * Complex.I) := by
      rw [hζ₁ w, h_exp_split]
      dsimp [z_I]
      rw [mul_pow]
      ring
    rw [h_rhs_factor] at h_phase
    have h_sq := congrArg (· ^ 2) h_phase
    dsimp only at h_sq
    rw [h_sign_sq w hw x hx_ne] at h_sq
    simp only [mul_pow] at h_sq
    rw [h_tors_sq w hw ζ₂, h_tors_sq w hw ζ₁, h_arg_int_pi w hw (fun j => d₁ j + d₂ j),
      one_mul, one_mul, mul_one, ← pow_mul, mul_comm h_K 2] at h_sq
    have h_z_2hK : z_I ^ (2 * h_K) = 1 := h_sq.symm
    have h_nu_eq :
        (Φ_τ I w) ^ ν *
          Complex.exp
            (((∑ j : Fin r, ((ν : ℝ) * Φ_W I j) * (w.embedding (η j)).arg) : ℝ) * Complex.I) =
        z_I ^ ν := by
      dsimp [z_I]
      rw [mul_pow, ← Complex.exp_nat_mul]
      congr 2
      have h_sum :
          (∑ j : Fin r, ((ν : ℝ) * Φ_W I j) * (w.embedding (η j)).arg) =
          (ν : ℝ) * (∑ j : Fin r, Φ_W I j * (w.embedding (η j)).arg) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => by ring)
      rw [h_sum]
      push_cast
      ring
    rw [h_nu_eq, ← pow_mul, mul_comm ν (2 * h_K), pow_mul, h_z_2hK, one_pow]
  have h_alg : ∀ {E : Type} (T : ℂ) (U E_L E_R : E → ℂ) (c_chi c_psi c_chi' W : ℂ) (ν : ℕ),
      c_chi' = c_chi * c_psi →
      (∀ e : E, E_L e = E_R e * c_psi ^ ν) →
      (T * ∑' e : E, U e * E_L e) * (c_chi ^ ν * W) =
        (T * ∑' e : E, U e * E_R e) * (c_chi' ^ ν * W) := by
    intro E T U E_L E_R c_chi c_psi c_chi' W ν hc hE
    have h_tsum : (∑' e : E, U e * E_L e) = (∑' e : E, U e * E_R e) * c_psi ^ ν := by
      rw [← tsum_mul_right]
      exact tsum_congr (fun e => by rw [hE e, ← mul_assoc])
    rw [h_tsum, hc, mul_pow]
    ring
  refine ⟨θ₀, χ', hθ₀_bdd, hθ₀_j₀_pos, hχ'_ray, hχ'_norm, h_real_tors, ?_⟩
  refine tsum_congr (fun pm => ?_)
  let p_nz : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
  let ν : ℕ := pm.1.2
  have h_psi_pow :
      Complex.exp
        (2 * Real.pi * Complex.I *
          ∑ j : Fin r, (k_β j : ℂ) * (((ν : ℝ) * Φ_W p_nz j : ℝ) : ℂ)) =
      (ψ_kβ p_nz) ^ ν := by
    change Complex.exp _ = (f_ψ p_nz) ^ ν
    dsimp [f_ψ]
    rw [← Complex.exp_nat_mul]
    congr 1
    have h_sum :
        (∑ j : Fin r, (k_β j : ℂ) * (((ν : ℝ) * Φ_W p_nz j : ℝ) : ℂ)) =
        (ν : ℂ) * (∑ j : Fin r, (k_β j : ℂ) * (Φ_W p_nz j : ℂ)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      push_cast
      ring
    rw [h_sum]
    ring
  refine h_alg _ _ _ _ (χ p_nz) (ψ_kβ p_nz) (χ' p_nz) _ ν rfl (fun e => ?_)
  rw [h_bilinear_exp (fun j => (ν : ℝ) * Φ_W p_nz j) e.1, h_psi_pow]

theorem mitsui_grossenchar_primitive_conductor_reduction_of_unitLog_ne_one {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (w₀ : NumberField.InfinitePlace K)
    (a₀ : ℕ) (ha₀_lt : a₀ < NumberField.Units.torsionOrder K)
    (θ₀ : Fin (NumberField.Units.rank K) → ℝ)
    (hθ₀_bdd : ∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1)
    (m_freq : Fin (NumberField.Units.rank K) → ℤ)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0))
    (hχ_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
        (∀ w : NumberField.InfinitePlace K,
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              y j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            Complex.exp
              (((∑ j : Fin (NumberField.Units.rank K),
                  y j *
                    (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                      ∑ w : NumberField.InfinitePlace K,
                        (l_ang w : ℝ) *
                          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) :
    ∃ (f : Ideal (NumberField.RingOfIntegers K))
      (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
      q ≤ f ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0)) ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        x - 1 ∈ f →
        ∃ y : Fin (NumberField.Units.rank K) → ℝ,
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) =
              ∑ j : Fin (NumberField.Units.rank K),
                y j *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
          χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
            ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    y j *
                      (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                        ∑ w : NumberField.InfinitePlace K,
                          (l_ang w : ℝ) *
                            (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
            ∏ w : NumberField.InfinitePlace K,
              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ∧
      (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
        ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
          x - 1 ∈ f' ∧
          ∀ y : Fin (NumberField.Units.rank K) → ℝ,
            (∀ w : NumberField.InfinitePlace K,
              Real.log (w (x : K) / w₀ (x : K)) =
                ∑ j : Fin (NumberField.Units.rank K),
                  y j *
                    Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                      w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
            χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
              ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                Complex.exp
                  (((∑ j : Fin (NumberField.Units.rank K),
                      y j *
                        (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                          ∑ w : NumberField.InfinitePlace K,
                            (l_ang w : ℝ) *
                              (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) ≠
              ∏ w : NumberField.InfinitePlace K,
                (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → χ_gr I = χ₀ I) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Ω : Fin r → ℝ := fun j =>
    2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
      ∑ w : NumberField.InfinitePlace K,
        (l_ang w : ℝ) *
          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  
  let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
