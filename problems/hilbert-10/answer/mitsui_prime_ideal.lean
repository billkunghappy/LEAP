    funext i
    apply Fin.ext
    have h1 := hd_step i
    rw [hd_zero, zero_mul] at h1
    omega
  have hcard_le : Nat.card ℬ ≤ Fintype.card ((ι → Bool) × ({i : ι // i ≠ i₀} → Fin (4 * m))) := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_le_of_injective Φ hΦ_inj
  have hcard_compl : Fintype.card {i : ι // i ≠ i₀} = n - 1 := by
    change Fintype.card {i : ι // ¬ (i = i₀)} = n - 1
