      have h_rhs_t : C_const * (∑' l : Fin n → ℤ, G l t) =
          C_const * ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u' t i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
        congr 1
