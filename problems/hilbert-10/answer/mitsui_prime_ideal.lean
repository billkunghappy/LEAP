      have h_sum_smul : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * y v)) =
          c * ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * y v := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
