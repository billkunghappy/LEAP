      map_one' := by simp
      map_mul' := fun I J => by simp [mul_pow] }
  have hχ_sq_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_sq I‖ ≤ 1 := by
    intro I
    change ‖(χ_gr I) ^ 2‖ ≤ 1
    rw [norm_pow]
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI, one_pow]
    · rw [(hχ_norm_supp I).2 hI, norm_zero, sq, mul_zero]
