  have hH_pos : (0 : ℝ) < (NumberField.classNumber K : ℝ) := by exact_mod_cast hH_nat_pos
  have hH_ne : (NumberField.classNumber K : ℝ) ≠ 0 := ne_of_gt hH_pos
