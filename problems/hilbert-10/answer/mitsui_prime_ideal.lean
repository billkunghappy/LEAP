  have h_R1_pow_le : R₁ ^ n ≤ Y₀ := pow_le_pow_left₀ hR₁_nonneg hR₁_le n
  have h_prod_M_le : M w₀ * (∏ w ∈ Finset.univ.erase w₀, M w) ≤ K_prod * Y₀ := by
    rw [h_prod_M_univ]
    exact mul_le_mul_of_nonneg_left h_R1_pow_le hK_prod_nonneg
  have h_card_erase_le : ((Finset.univ.erase w₀).card : ℝ) ≤ (M_card : ℝ) := by
    have h1 : (Finset.univ.erase w₀).card ≤ M_card := by
      dsimp [M_card]
      rw [← Finset.card_univ]
      exact Finset.card_erase_le
    exact Nat.cast_le.mpr h1
  have h_diff_eq :
      B₀ * (∏ w ∈ Finset.univ.erase w₀, A w) - B₀ * (∏ w ∈ Finset.univ.erase w₀, F w) =
      B₀ * ((∏ w ∈ Finset.univ.erase w₀, A w) - ∏ w ∈ Finset.univ.erase w₀, F w) := by ring
  change |(∑' p : NumberField.InfinitePlace K → Fin l, _) - _| ≤ _
  rw [h_lhs_eq, h_rhs_eq]
  change |B₀ * (∏ w ∈ Finset.univ.erase w₀, A w) - B₀ * (∏ w ∈ Finset.univ.erase w₀, F w)| ≤ _
  rw [h_diff_eq, abs_mul, abs_of_nonneg hB₀_nonneg]
  have h_main_step :
      B₀ * |(∏ w ∈ Finset.univ.erase w₀, A w) - ∏ w ∈ Finset.univ.erase w₀, F w| ≤
      2 * (M_card : ℝ) * K_prod * Y₀ * δ +
      2 * (M_card : ℝ) * K_prod * Y₀ * X⁻¹ := by
    calc B₀ * |(∏ w ∈ Finset.univ.erase w₀, A w) - ∏ w ∈ Finset.univ.erase w₀, F w|
      _ ≤ M w₀ * (((Finset.univ.erase w₀).card : ℝ) * ε * ∏ w ∈ Finset.univ.erase w₀, M w) :=
          mul_le_mul hB₀_le_M h_s4 (abs_nonneg _) (by dsimp [M]; positivity)
      _ ≤ M w₀ * ((M_card : ℝ) * ε * ∏ w ∈ Finset.univ.erase w₀, M w) := by
          gcongr
      _ = (M_card : ℝ) * ε * (M w₀ * ∏ w ∈ Finset.univ.erase w₀, M w) := by ring
      _ ≤ (M_card : ℝ) * ε * (K_prod * Y₀) :=
          mul_le_mul_of_nonneg_left h_prod_M_le (by positivity)
      _ = 2 * (M_card : ℝ) * K_prod * Y₀ * δ + 2 * (M_card : ℝ) * K_prod * Y₀ * X⁻¹ := by
          dsimp [ε]; ring
  set L_term : ℝ := (Real.log X + 1) ^ 2 / (l : ℝ)
  have hL_nonneg : 0 ≤ L_term := by dsimp [L_term]; positivity
  have hδ_le_L : δ ≤ L_term := by
    dsimp [δ, L_term]
    apply div_le_div_of_nonneg_right _ hl_nonneg
    nlinarith
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  have h_inv_le : X⁻¹ ≤ Real.exp 1 * Real.exp (-t / c_sum) := by
    have hsq : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
    have h_ineq1 : -Real.log X ≤ 1 + -t := by nlinarith [hsq, ht_sq]
    have h_div_t : t / c_sum ≤ t := div_le_self ht_nonneg hc_sum_ge_one
    have h_ineq2 : 1 + -t ≤ 1 + (-t / c_sum) := by
      rw [neg_div]
      linarith
    calc X⁻¹
      _ = Real.exp (-Real.log X) := by rw [Real.exp_neg, Real.exp_log hX_pos]
      _ ≤ Real.exp (1 + (-t / c_sum)) := Real.exp_le_exp.mpr (le_trans h_ineq1 h_ineq2)
      _ = Real.exp 1 * Real.exp (-t / c_sum) := Real.exp_add 1 (-t / c_sum)
  have h_term1_le :
      2 * (M_card : ℝ) * K_prod * Y₀ * δ ≤ c_sum * Y₀ * L_term := by
    have hc1 : 2 * (M_card : ℝ) * K_prod ≤ c_sum := by
      have hexp1_ge : 1 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
      have h_mul : 2 * (M_card : ℝ) * K_prod * 1 ≤ 2 * (M_card : ℝ) * K_prod * Real.exp 1 :=
        mul_le_mul_of_nonneg_left hexp1_ge (by positivity)
      dsimp [c_sum]
      linarith
    calc 2 * (M_card : ℝ) * K_prod * Y₀ * δ
      _ ≤ 2 * (M_card : ℝ) * K_prod * Y₀ * L_term :=
          mul_le_mul_of_nonneg_left hδ_le_L (by positivity)
      _ = (2 * (M_card : ℝ) * K_prod) * (Y₀ * L_term) := by ring
      _ ≤ c_sum * (Y₀ * L_term) :=
          mul_le_mul_of_nonneg_right hc1 (by positivity)
      _ = c_sum * Y₀ * L_term := by ring
  have h_term2_le :
      2 * (M_card : ℝ) * K_prod * Y₀ * X⁻¹ ≤ c_sum * Y₀ * Real.exp (-t / c_sum) := by
    have hc2 : 2 * (M_card : ℝ) * K_prod * Real.exp 1 ≤ c_sum := by
      dsimp [c_sum]; linarith
    calc 2 * (M_card : ℝ) * K_prod * Y₀ * X⁻¹
      _ ≤ 2 * (M_card : ℝ) * K_prod * Y₀ * (Real.exp 1 * Real.exp (-t / c_sum)) :=
          mul_le_mul_of_nonneg_left h_inv_le (by positivity)
      _ = (2 * (M_card : ℝ) * K_prod * Real.exp 1) * (Y₀ * Real.exp (-t / c_sum)) := by ring
      _ ≤ c_sum * (Y₀ * Real.exp (-t / c_sum)) :=
          mul_le_mul_of_nonneg_right hc2 (by positivity)
      _ = c_sum * Y₀ * Real.exp (-t / c_sum) := by ring
  linarith

theorem mitsui_prime_conical_sector_asymptotic {K : Type u} [Field K] [NumberField K] :
    ∃ c_cone : ℝ, 0 < c_cone ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ Real.exp (Real.sqrt (Real.log X)) →
          ∀ R₁ : ℝ, 1 < R₁ → R₁ ≤ X →
            ∀ R : ℝ, 1 < R → R ≤ R₁ →
              ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
                ∀ w₀ : NumberField.InfinitePlace K,
                  |(∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        (∀ i : NumberField.mixedEmbedding.index K,
                          R₁ *
                            ((NumberField.mixedEmbedding.stdBasis K).repr
                                (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                        (∀ w : NumberField.InfinitePlace K,
                          1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                        w₀ (π : K) < R},
                      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
                    - ((NumberField.Units.torsionOrder K : ℝ) /
                        ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                          (NumberField.classNumber K : ℝ) *
                          NumberField.Units.regulator K)) *
                      ((Module.finrank ℚ K : ℝ)⁻¹ * ((R / R₁) ^ (Module.finrank ℚ K)) *
                        ∏ w : NumberField.InfinitePlace K,
                          (MeasureTheory.volume {p : ℝ × ℝ |
                            (w = w₀ ∧
                              p.1 ∈ Set.Ioo (0 : ℝ) (R₁ ^ w.mult) ∧
                              ((∃ hw : w.IsReal,
                                  (p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                    R₁ ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                  (p.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                    -R₁ ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                (∃ hc : w.IsComplex,
                                  p.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                  R₁ * Real.cos p.2 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                  R₁ * Real.sin p.2 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
                            (w ≠ w₀ ∧
                              ((∃ hw : w.IsReal,
                                  p.1 ∈ Set.Ioo (-R₁) R₁ ∧
                                  p.1 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                  p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
                                (∃ hc : w.IsComplex,
                                  p.1 ^ 2 + p.2 ^ 2 < R₁ ^ 2 ∧
                                  p.1 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                  p.2 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}).toReal)|
                    ≤ c_cone * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cone) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c_sub, hc_sub_pos, hc_sub⟩ := mitsui_prime_sub_box_shell_diff_bound (K := K)
  obtain ⟨c_hpp, hc_hpp_pos, hc_hpp⟩ := mitsui_higher_primePower_log_sector_bound (K := K)
  obtain ⟨c_pp, hc_pp_pos, hc_pp⟩ := mitsui_primePower_decoupled_norm_dir_log_cell_asymptotic (K := K)
  obtain ⟨c_sum, hc_sum_pos, hc_sum⟩ := mitsui_conical_sector_log_cell_main_term_sum_bound (K := K)
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_pos : 0 < W := by
    change (0 : ℝ) < (NumberField.Units.torsionOrder K : ℝ)
    exact_mod_cast NumberField.Units.torsionOrder_pos K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  set H : ℝ := (NumberField.classNumber K : ℝ)
  have hH_pos : 0 < H := by
    change (0 : ℝ) < (NumberField.classNumber K : ℝ)
    exact_mod_cast NumberField.classNumber_pos K
  set R_reg : ℝ := NumberField.Units.regulator K
  have hR_reg_pos : 0 < R_reg := NumberField.Units.regulator_pos K
  set κ₀ : ℝ := W / (F * H * R_reg)
  have hκ₀_pos : 0 < κ₀ := by dsimp [κ₀]; positivity
  set c_cell : ℝ := c_hpp + c_pp
  have hc_cell_pos : 0 < c_cell := by dsimp [c_cell]; positivity
  set c' : ℝ := 1 / (4 * (M : ℝ) * c_cell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_cell : ℝ := K₀ ^ (2 * M) * c_cell
  have hA_cell_pos : 0 < A_cell := by dsimp [A_cell]; positivity
  let c_cone : ℝ :=
    c₁ + 3 * c_sub + A_cell + 3 * κ₀ * c_sum + 1 / c' + 2 * c_cell + c_sum
  have hc_cone_pos : 0 < c_cone := by dsimp [c_cone]; positivity
  refine ⟨c_cone, hc_cone_pos, ?_⟩
  intro X hX m hm hm_coarse R₁ hR₁_gt hR₁_le R hR_gt hR_le_R₁ k w₀
  set Y₀ : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_nonneg : 0 ≤ Y₀ := by dsimp [Y₀]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  have hR₁_pos : 0 < R₁ := lt_trans zero_lt_one hR₁_gt
  have hR₁_ne : R₁ ≠ 0 := ne_of_gt hR₁_pos
  have hR_pos : 0 < R := lt_trans zero_lt_one hR_gt
  have hR_nonneg : 0 ≤ R := le_of_lt hR_pos
  have hR_le : R ≤ X := le_trans hR_le_R₁ hR₁_le
  set z : ℝ := (Real.log X + 1) ^ 2 * Real.exp (c' * t)
  set l : ℕ := ⌊z⌋₊
  have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_sq : Real.log X + 1 ≤ (Real.log X + 1) ^ 2 := by nlinarith
  have hz_ge : Real.log X + 1 ≤ z := by
    dsimp [z]
    calc Real.log X + 1
      _ = (Real.log X + 1) * 1 := (mul_one _).symm
      _ ≤ (Real.log X + 1) ^ 2 * Real.exp (c' * t) :=
        mul_le_mul hlog1_le_sq hexp_ge_one zero_le_one (by positivity)
  have hz_lt : z < (l : ℝ) + 1 := Nat.lt_floor_add_one z
  have hlog_lt_l : Real.log X < (l : ℝ) := by linarith
  have hl_log : Real.log X ≤ (l : ℝ) := le_of_lt hlog_lt_l
  have hl_rpos : (0 : ℝ) < (l : ℝ) := lt_trans hlog_pos hlog_lt_l
  have hl_pos : 0 < l := Nat.cast_pos.mp hl_rpos
  have hl : 1 ≤ l := hl_pos
  have hl_ge_one : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
  have hz_le_2l : z ≤ 2 * (l : ℝ) := by linarith
  have h_ratio : (Real.log X + 1) ^ 2 / (l : ℝ) ≤ 2 * Real.exp (-c' * t) := by
    rw [div_le_iff₀ hl_rpos]
    calc (Real.log X + 1) ^ 2
      _ = z * Real.exp (-c' * t) := by
        dsimp [z]
        rw [mul_assoc, ← Real.exp_add]
        have h0 : c' * t + -c' * t = 0 := by ring
        rw [h0, Real.exp_zero, mul_one]
      _ ≤ (2 * (l : ℝ)) * Real.exp (-c' * t) :=
        mul_le_mul_of_nonneg_right hz_le_2l (by positivity)
      _ = 2 * Real.exp (-c' * t) * (l : ℝ) := by ring
  have hl_le_z : (l : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hlog1_sq_le : (Real.log X + 1) ^ 2 ≤ K₀ ^ 2 * Real.exp (c' * t) := by
    calc (Real.log X + 1) ^ 2
      _ = (Real.log X + 1) * (Real.log X + 1) := sq _
      _ ≤ (K₀ * Real.exp (c' * t / 2)) * (K₀ * Real.exp (c' * t / 2)) :=
        mul_le_mul hlog1_le_K₀ hlog1_le_K₀ (by positivity) (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t / 2) * Real.exp (c' * t / 2)) := by ring
      _ = K₀ ^ 2 * Real.exp (c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hl_le_K₀ : (l : ℝ) ≤ K₀ ^ 2 * Real.exp (2 * c' * t) := by
    calc (l : ℝ)
      _ ≤ z := hl_le_z
      _ = (Real.log X + 1) ^ 2 * Real.exp (c' * t) := rfl
      _ ≤ (K₀ ^ 2 * Real.exp (c' * t)) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_right hlog1_sq_le (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
      _ = K₀ ^ 2 * Real.exp (2 * c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hexp_M_eq : (M : ℝ) * (2 * c' * t) = t / (2 * c_cell) := by
    dsimp [c']
    have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_rpos
    have hc_ne : c_cell ≠ 0 := ne_of_gt hc_cell_pos
    field_simp [hM_ne, hc_ne]
    ring
  have hl_pow_le : (l : ℝ) ^ M ≤ K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
    calc (l : ℝ) ^ M
      _ ≤ (K₀ ^ 2 * Real.exp (2 * c' * t)) ^ M :=
        pow_le_pow_left₀ (by positivity) hl_le_K₀ M
      _ = K₀ ^ (2 * M) * (Real.exp (2 * c' * t)) ^ M := by
        rw [mul_pow, ← pow_mul]
      _ = K₀ ^ (2 * M) * Real.exp ((M : ℝ) * (2 * c' * t)) := by
        rw [← Real.exp_nat_mul]
      _ = K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
        rw [hexp_M_eq]
  let q₀ : Ideal (NumberField.RingOfIntegers K) := ⊤
  have hq₀ : q₀ ≠ 0 := top_ne_bot
  let ψ₀ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q₀)ˣ) ℂ := 0
  haveI h_sub_quot : Subsingleton (NumberField.RingOfIntegers K ⧸ q₀) :=
    Ideal.Quotient.subsingleton_iff.mpr rfl
  have h_unit : ∀ π : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q₀ π) :=
    fun _ => isUnit_of_subsingleton _
  have h_tsum_cast : ∀ (P Q : NumberField.RingOfIntegers K → Prop) (hPQ : ∀ x, P x ↔ Q x)
      (u_fn : ∀ π : {π : NumberField.RingOfIntegers K // P π},
        Additive (NumberField.RingOfIntegers K ⧸ q₀)ˣ),
      (∑' π : {π : NumberField.RingOfIntegers K // P π},
          ψ₀ (u_fn π) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
      ((∑' π : {π : NumberField.RingOfIntegers K // Q π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℝ) : ℂ) := by
    intro P Q hPQ u_fn
    have h1 : (fun π : {π : NumberField.RingOfIntegers K // P π} =>
        ψ₀ (u_fn π) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
      (fun π : {π : NumberField.RingOfIntegers K // P π} =>
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) := by
      ext π
      simp [ψ₀]
