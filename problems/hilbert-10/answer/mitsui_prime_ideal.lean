                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
              ((((c_C⁻¹ ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * c_C⁻¹ ^ 2 *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ_C C : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))) *
              (E_γ * E_cube))
      have h_reassoc : ∀ (A B S E : ℂ), A * (B * S) * E = (A * B) * (S * E) :=
        fun _ _ _ _ => by ring
      rw [tsum_mul_right, ← mul_assoc (star (χ₀ (J_rep C))),
        h_reindex_Φ, h_prod_primal.tsum_prod' h_sum_primal,
        tsum_congr h_step_poiss, tsum_mul_left, h_comm, h_lhs_reassoc, h_gauss_tsum, tsum_mul_left,
        h_reassoc, ← mul_assoc (u : ℂ) ω_χ (χ₀ (J_rep (σ C))), ← tsum_mul_right]
      congr 1
      refine tsum_congr (fun x_star => by ring)
    have h_int_eq :
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : J_C,
              ψ_f (Ideal.Quotient.mk f x.1) *
                (∏ w : NumberField.InfinitePlace K,
                  ((if 0 ≤ l_eff w then w.embedding (x.1 : K) else star (w.embedding (x.1 : K))) *
                    ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
                (((c_C ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
                  Real.exp (-Real.pi * a_C *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ)) *
                Complex.exp
                  (((∑ w : NumberField.InfinitePlace K,
                      v_place w *
                        ∑ i : Fin r,
                          y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                    Complex.I))) =
        (((u : ℂ) * ω_χ) * χ₀ (J_rep (σ C))) *
          (∫ y in Cube,
            (∑' x_star : J_σC,
              star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
                (∏ w : NumberField.InfinitePlace K,
                  ((star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) /
                    (w (γ_C C : K) : ℂ)) *
                    ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
                ((((c_C⁻¹ ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
                  Real.exp (-Real.pi * c_C⁻¹ ^ 2 *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ_C C : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))) *
                (E_γ *
                  Complex.exp
                    (((∑ w : NumberField.InfinitePlace K,
                        v_place w *
                          ∑ i : Fin r,
                            y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                      Complex.I)))) := by
      rw [← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_const_mul]
      exact MeasureTheory.setIntegral_congr_fun hCube_meas (fun y _ => h_integrand y)
    rw [h_int_eq, mitsui_grossenchar_generator_unitLog_shift_cube_integral_eq
      f J_σC (γ_C C) (hγ_C C).1 l_eff v_place hv_sum ψ_f hψ_mul hψ_units c_C⁻¹ (inv_pos.mpr hc_C_pos)]
    set N_γ : ℝ := (Ideal.absNorm (Ideal.span ({γ_C C} : Set R)) : ℝ)
    have hNγ_eq : N_γ = D * N_f * (Ideal.absNorm J_C : ℝ) * (Ideal.absNorm J_σC : ℝ) := by
      dsimp [N_γ, J_C, J_σC, N_f, D]
      rw [← (hγ_C C).2]
      simp only [map_mul, Nat.cast_mul]
      have h_discr_abs : (((NumberField.discr K).natAbs : ℕ) : ℝ) = |(NumberField.discr K : ℝ)| :=
        (Nat.cast_natAbs (α := ℝ) (NumberField.discr K)).trans (Int.cast_abs (R := ℝ))
      rw [NumberField.absNorm_differentIdeal K R, h_discr_abs]
    have h_scale_c : c_C⁻¹ * N_γ ^ (-1 / (n : ℝ)) = c_RHS := by
      have hNγ_pos : 0 < N_γ := by rw [hNγ_eq]; positivity
      dsimp [c_C, c_RHS, b_RHS_ratio]
      have h_neg : (-1 / (n : ℝ)) = -(1 / (n : ℝ)) := by ring
      rw [← Real.inv_rpow (le_of_lt hb_ratio_pos), h_neg, Real.rpow_neg (le_of_lt hNγ_pos),
        ← Real.inv_rpow (le_of_lt hNγ_pos),
        ← Real.mul_rpow (inv_nonneg.mpr (le_of_lt hb_ratio_pos)) (inv_nonneg.mpr (le_of_lt hNγ_pos))]
      congr 1
      rw [hNγ_eq]
      have hJC_ne' : (Ideal.absNorm J_C : ℝ) ≠ 0 := ne_of_gt hNJC_pos
      have hb_inv : b_ratio⁻¹ = (Ideal.absNorm J_C : ℝ) * (D ^ (1 / 2 : ℝ) * N_f ^ (1 / 2 : ℝ) * u) := by
        dsimp [b_ratio, b_LHS, S_f, D, N_f]
        rw [inv_div, div_eq_mul_inv, mul_inv, mul_inv, inv_inv, hD_neg_inv, hNf_neg_inv]
      have h_prod_inv : (D * N_f * (Ideal.absNorm J_C : ℝ) * (Ideal.absNorm J_σC : ℝ))⁻¹ =
          D⁻¹ * N_f⁻¹ * (Ideal.absNorm J_C : ℝ)⁻¹ * (Ideal.absNorm J_σC : ℝ)⁻¹ := by
        rw [mul_inv, mul_inv, mul_inv]
      rw [hb_inv, h_prod_inv, hD_inv_sq, hNf_inv_sq]
      dsimp [b_RHS, S_f, D, N_f]
      calc (Ideal.absNorm J_C : ℝ) * (D ^ (1 / 2 : ℝ) * N_f ^ (1 / 2 : ℝ) * u) *
            ((D ^ (-1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * (N_f ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ)) *
              (Ideal.absNorm J_C : ℝ)⁻¹ * (Ideal.absNorm J_σC : ℝ)⁻¹)
        _ = ((Ideal.absNorm J_C : ℝ) * (Ideal.absNorm J_C : ℝ)⁻¹) *
            (D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * (N_f ^ (1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ)) *
            (D ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) * u / (Ideal.absNorm J_σC : ℝ)) := by
            rw [div_eq_mul_inv]
            ring
        _ = D ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) * u / (Ideal.absNorm J_σC : ℝ) := by
            rw [mul_inv_cancel₀ hJC_ne', hD_prod, hNf_prod]
            ring
    rw [h_scale_c, mul_assoc]
  have h_sum_per_C :
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
              χ₀ ⟨Ideal.span ({x.1} : Set R),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
                Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
                ((((b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                    (∑ w : NumberField.InfinitePlace K, a_place w) *
                  (∏ w : NumberField.InfinitePlace K,
                    (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)) *
                  Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ) *
                Complex.exp
                  (((∑ w : NumberField.InfinitePlace K,
                      v_place w *
                        ∑ i : Fin r,
                          y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                    Complex.I)))) =
      (∑ C : ClassGroup R,
        ((u : ℂ) * ω_χ) *
          (χ₀ (J_rep (σ C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep (σ C) : Ideal R)},
                ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨Ideal.span ({x.1} : Set R),
                  mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
                  Complex.exp (((∑ w : NumberField.InfinitePlace K, (-v_place) w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
                  ((((b_RHS / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                      (∑ w : NumberField.InfinitePlace K, a_place w) *
                    (∏ w : NumberField.InfinitePlace K,
                      (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i)) ^ (a_place w)) *
                    Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                      ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                          ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ) *
                  Complex.exp
                    (((-∑ w : NumberField.InfinitePlace K,
                        (-v_place) w *
                          ∑ i : Fin r,
                            y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                      Complex.I))))) :=
    Finset.sum_congr rfl (fun C _ => h_per_C C)
  rw [h_sum_per_C, ← Finset.mul_sum]
  congr 1
  exact Equiv.sum_comp σ (fun C =>
    χ₀ (J_rep C) *
      (∫ y in Cube,
        (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
          ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨Ideal.span ({x.1} : Set R),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
            Complex.exp (((∑ w : NumberField.InfinitePlace K, (-v_place) w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
            ((((b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                (∑ w : NumberField.InfinitePlace K, a_place w) *
              (∏ w : NumberField.InfinitePlace K,
                (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i)) ^ (a_place w)) *
              Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ) *
            Complex.exp
              (((-∑ w : NumberField.InfinitePlace K,
                  (-v_place) w *
                    ∑ i : Fin r,
                      y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                Complex.I))))

theorem mitsui_primitive_grossenchar_stripped_unitRank_posNeg_theta_inversion_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (h_nonprin_v :
      (∃ j : Fin (NumberField.Units.rank K),
        (∑ w : NumberField.InfinitePlace K,
          v_place w *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsReal ∧ Odd (l_ang w)))
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_prin_v : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
    (hχ₀_prim_v : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) ≠
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) :
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    let U_K : (NumberField.InfinitePlace K → ℕ) → (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun a_place y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (y i)) ^ (a_place w)
    let J_c : (NumberField.InfinitePlace K → ℕ) → (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun a_place ν_place a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        ((U_K a_place y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin (NumberField.Units.rank K),
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) : ℝ) *
              Complex.I)
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let S_strip : (NumberField.InfinitePlace K → ℕ) → (NumberField.InfinitePlace K → ℝ) →
        (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) → ℝ → ℂ :=
      fun a_place ν_place ψ v =>
        ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((((S_f * ((m : ℝ) * v)) ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
            J_c a_place ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (Module.finrank ℚ K : ℝ)))
    ∃ (a_place : NumberField.InfinitePlace K → ℕ) (ω_χ : ℂ),
      ‖ω_χ‖ = 1 ∧
      (∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1) ∧
      (∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w ≤ (l_ang w).natAbs) ∧
      (∀ u ∈ Set.Ioi (0 : ℝ),
        S_strip a_place v_place χ₀ u⁻¹ =
          (u : ℂ) * ω_χ * S_strip a_place (-v_place) ((starRingEnd ℂ).toMonoidHom.comp χ₀) u) :=
by
  intro Q_K U_K J_c S_f S_strip
  let R := NumberField.RingOfIntegers K
  obtain ⟨l_eff, ψ_f, hl_eff_real, hl_eff_cplx, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, hψ_zero⟩ :=
    mitsui_primitive_grossenchar_exists_quotient_char_and_zero_mode_of_units_eq_one
      f hf l_ang h_tors v_place hv_sum h_nonprin_v χ₀ hχ₀_norm_supp hχ₀_prin_v hχ₀_prim_v
  let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
  have ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1 := by
    intro w hw
    rcases hl_eff_real w hw with h0 | h1
    · simp [a_place, h0]
    · simp [a_place, h1]
  have ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w ≤ (l_ang w).natAbs :=
    fun w hw => hl_eff_cplx w hw
  obtain ⟨J_rep, hJ_cls, hJ_cop, h_s1⟩ :=
    mitsui_stripped_unitRank_series_eq_sum_classGroup_principal_subideals f hf a_place
  obtain ⟨ω_χ, hω_norm, h_s4⟩ :=
    mitsui_primitive_grossenchar_classGroup_cube_lattice_posNeg_theta_inversion_of_units_eq_one
      f hf l_eff hl_eff_real v_place hv_sum χ₀ hχ₀_norm_supp J_rep hJ_cls hJ_cop ψ_f
      hψ_one hψ_mul hψ_unit hψ_span hψ_prim hψ_zero
  let χ_dual : nonZeroDivisors (Ideal R) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp χ₀
  have hχ₀_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖χ₀ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ f = ⊤
    · rw [(hχ₀_norm_supp I).1 hI]
    · rw [(hχ₀_norm_supp I).2 hI, norm_zero]; exact zero_le_one
  have hχ_dual_norm_supp : ∀ I : nonZeroDivisors (Ideal R),
      ((I : Ideal R) ⊔ f = ⊤ → ‖χ_dual I‖ = 1) ∧
      (¬ ((I : Ideal R) ⊔ f = ⊤) → χ_dual I = 0) := by
    intro I
    refine ⟨fun hI => ?_, fun hI => ?_⟩
    · change ‖star (χ₀ I)‖ = 1
      rw [norm_star, (hχ₀_norm_supp I).1 hI]
    · change star (χ₀ I) = 0
      rw [(hχ₀_norm_supp I).2 hI, star_zero]
  have hχ_dual_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖χ_dual I‖ ≤ 1 := by
    intro I
    change ‖star (χ₀ I)‖ ≤ 1
    rw [norm_star]
    exact hχ₀_norm_le I
  have h_neg_v_sum : (∑ w : NumberField.InfinitePlace K, (-v_place) w) = 0 := by
    change (∑ w : NumberField.InfinitePlace K, -v_place w) = 0
    rw [Finset.sum_neg_distrib, hv_sum, neg_zero]
  refine ⟨a_place, ω_χ, hω_norm, ha_real, ha_cplx, ?_⟩
  intro u hu
  have hu_pos : 0 < u := Set.mem_Ioi.mp hu
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  have hD_pos : 0 < |(NumberField.discr K : ℝ)| :=
    abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf
  have hNf_pos : 0 < (Ideal.absNorm f : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hSf_pos : 0 < S_f := by dsimp [S_f]; positivity
  have hb_inv_pos : 0 < S_f * u⁻¹ := mul_pos hSf_pos hu_inv_pos
  have hb_pos : 0 < S_f * u := mul_pos hSf_pos hu_pos
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
  set Sum₁ : ℂ :=
    ∑ C : ClassGroup R,
      star (χ₀ (J_rep C)) *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
            χ₀ ⟨Ideal.span ({x.1} : Set R),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
