by
  classical
  intro R n r Q_K U_K J_c Cube
  let J_maj : ℝ → ℝ := fun a =>
    ∫ y : Fin r → ℝ, U_K y * Real.exp (-a * Q_K y)
  haveI : Countable R :=
    Function.Injective.countable (Module.Free.chooseBasis ℤ R).repr.injective
  let A_exp : ℕ := ∑ w : NumberField.InfinitePlace K, a_place w
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
