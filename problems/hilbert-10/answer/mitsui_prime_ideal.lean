  obtain ⟨hβ_zero, hL_cplx⟩ := h_s2
  have hΩ_zero : ∀ j : Fin r, Ω j = 0 := by
    intro j
    rw [← hβ_fund j]
    refine Finset.sum_eq_zero (fun w _ => ?_)
    rw [hβ_zero w, zero_mul]
  have h_prin_simple : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (L w) := by
    intro x hx_ne hx_q
    have h1 := h_prin_L x hx_ne hx_q
    have h_sum_zero : (∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) = 0 := by
