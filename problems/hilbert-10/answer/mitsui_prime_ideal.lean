            (v : ℂ) ^ (z + (a_place w_sub.1 : ℂ) + (ν_place w_sub.1 : ℂ) * Complex.I) *
              ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ) := by
        refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun v _ => ?_)
