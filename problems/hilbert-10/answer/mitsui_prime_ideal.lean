    have h_τ₀_eq : τ₀ x w =
        w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          Φ_τ I_x w := by
      have h_lhs : π_S1 (Additive.toMul (F_add x hx_ne w)) = τ₀ x w := by
        have h_val : ((Additive.toMul (F_add x hx_ne w) : ℂˣ) : ℂ) = τ₀ x w := rfl
        have h_n1 : ‖((Additive.toMul (F_add x hx_ne w) : ℂˣ) : ℂ)‖ = 1 := by
          rw [h_val]
          exact hτ₀_norm x hx_ne w
        rw [hπ_of_norm_one _ h_n1, h_val]
      rw [← h_lhs]
      exact hζ w
    rw [hd_phase w, h_τ₀_eq]

theorem mitsui_torsion_phase_log_cell_sum_eq_of_archimedeanCoord {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (R₁ : ℝ)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (w₀ : NumberField.InfinitePlace K)
    (l : ℕ)
    (p : NumberField.InfinitePlace K → Fin l)
    (a₀ : ℕ)
    (β : NumberField.InfinitePlace K → ℝ)
    (h_tors_norm : ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
