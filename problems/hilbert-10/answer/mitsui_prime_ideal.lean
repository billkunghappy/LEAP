      Nat.cast_ne_zero.mpr (ne_of_gt (NumberField.Units.torsionOrder_pos K))
    rw [inv_mul_cancel₀ h_tors_ne, one_mul]
  refine ⟨?_, ?_⟩
  · have h1 := h_main 1 (Or.inl rfl)
    simp only [one_mul] at h1
    exact h1
  · have h2 := h_main (-1) (Or.inr rfl)
    have h_neg1 : ∀ (y : Fin r → ℝ) (i : Fin r), (-1 : ℝ) * y i = -y i :=
      fun y i => by ring
    have h_neg2 : ∀ (y : Fin r → ℝ) (i : Fin r), (-1 : ℝ) * (2 * y i) = -2 * y i :=
      fun y i => by ring
    simp only [h_neg1, h_neg2, neg_one_mul] at h2
    exact h2

theorem mitsui_grossenchar_cube_nonzero_lattice_sum_eq_full_ideal_sum {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
