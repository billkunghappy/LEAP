        _ = τ_sum * star (ψ_f (Ideal.Quotient.mk f y)) := by rw [h1]; ring
    · have hψ_zero : ψ_f (Ideal.Quotient.mk f y) = 0 := (hψ_unit _).2 hy
      rw [hψ_zero, star_zero, mul_zero]
      let I_y : Ideal R := Ideal.span ({y} : Set R) ⊔ f
      have hIy_ne_top : I_y ≠ ⊤ := by
        intro h_top
        have h1_mem : (1 : R) ∈ I_y := (Ideal.eq_top_iff_one _).mp h_top
        obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h1_mem
        obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp ha
