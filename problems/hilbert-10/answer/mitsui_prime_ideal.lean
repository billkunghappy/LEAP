      intro j
      dsimp [W₀]
      rw [hL_u, hlog, map_sum]
      simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
    refine ⟨ζ, fun w => ?_⟩
    let ψ_w : (NumberField.RingOfIntegers K)ˣ →* ℂ :=
      { toFun := fun v => w.embedding ((v : NumberField.RingOfIntegers K) : K) /
          (w ((v : NumberField.RingOfIntegers K) : K) : ℂ)
        map_one' := by simp
        map_mul' := by
          intro a b
          push_cast
