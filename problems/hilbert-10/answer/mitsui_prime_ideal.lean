    have hg_contOn : ContinuousOn g (Set.Ioc 0 1) := by
      intro t ht
      refine ContinuousAt.continuousWithinAt ?_
      refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul ?_
      · rw [Complex.mem_slitPlane_iff]; exact Or.inl ht.1
      · refine Complex.continuous_ofReal.continuousAt.comp ?_
        exact ((continuousAt_id.inv₀ (ne_of_gt ht.1)).add (Real.continuousAt_log (ne_of_gt ht.1))).sub continuousAt_const
    have hg_int_Ioc : MeasureTheory.IntegrableOn g (Set.Ioc 0 1) MeasureTheory.volume := by
