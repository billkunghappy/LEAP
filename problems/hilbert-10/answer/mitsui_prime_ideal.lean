            ∑ b : ι_b,
              c_ind ξ b * χ (l_emb b) *
                Complex.exp (((∑ j : Fin r, (q.1 j : ℝ) * h * Ω b j) : ℝ) * Complex.I) := by
    intro χ Hat_q
    have h_step1 : ∀ q : (Fin r → ℤ) × (ι_complex → ℤ),
        (∑ l_real ∈ B_real, χ l_real * (w_main l_real q * (Hat_q q : ℂ))) =
        ∑ b : ι_b, χ (l_emb b) * (w_b b q * (Hat_q q : ℂ)) := by
      intro q
      have h_expand : ∀ l_real : β_real,
          χ l_real * (w_main l_real q * (Hat_q q : ℂ)) =
          ∑ b : ι_b, if l_emb b = l_real then χ l_real * (w_b b q * (Hat_q q : ℂ)) else 0 := by
        intro l_real
        dsimp [w_main]
        rw [Finset.sum_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        split_ifs <;> ring
      simp_rw [h_expand]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [Finset.sum_ite_eq B_real (l_emb b), if_pos (hl_emb_mem b)]
    have h_step2 : ∀ (b : ι_b) (q : (Fin r → ℤ) × (ι_complex → ℤ)),
